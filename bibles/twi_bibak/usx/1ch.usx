<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1CH" style="id">- Biblica® Open Akuapem Twi Contemporary Bible 2020</book>
  <para style="h">1 Beresosɛm</para>
  <para style="toc1">Beresosɛm Nhoma A Edi Kan</para>
  <para style="toc2">1 Beresosɛm</para>
  <para style="toc3">1 Be</para>
  <para style="mt1">Beresosɛm</para>
  <para style="mt2">Nhoma A Edi Kan</para>
  <chapter number="1" style="c" sid="1CH 1"/>
  <para style="s1">Efi Adam So Kosi Noa Mma So</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 1:1"/>Adam asefo yɛ Set, Enos,<verse eid="1CH 1:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 1:2"/>Kenan, Mahalalel, Yared,<verse eid="1CH 1:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 1:3"/>Henok, Metusela, Lamek,<verse eid="1CH 1:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 1:4"/>Noa mma ne, Sem, Ham, ne Yafet.<verse eid="1CH 1:4"/></para>
  <para style="s1">Yafet Asefo</para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 1:5"/>Na Yafet asefo ne Gomer, Magog, Media, Yawan, Tubal, Mesek ne Tiras.<verse eid="1CH 1:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 1:6"/>Na Gomer asefo ne Askenas, Rifat ne Togarma.<verse eid="1CH 1:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 1:7"/>Na Yawan asefo ne Elisa, Tarsis, Kitim ne Rodanim.<verse eid="1CH 1:7"/></para>
  <para style="s1">Ham Asefo</para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 1:8"/>Na Ham asefo ne Kus, Misraim, Put ne Kanaan.<verse eid="1CH 1:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 1:9"/>Na Kus asefo ne Seba, Hawila, Sabta, Raama ne Sabteka. Na Raama asefo yɛ Saba ne Dedan. <verse eid="1CH 1:9"/><verse number="10" style="v" sid="1CH 1:10"/>Kus woo Nimrod. Na Nimrod bɛyɛɛ ɔkofo kɛse wɔ asase so.<verse eid="1CH 1:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 1:11"/>Na Misraim woo</para>
  <para style="li2" vid="1CH 1:11">Ludfo, Anamfo, Lehabfo, Naftuhfo, <verse eid="1CH 1:11"/><verse number="12" style="v" sid="1CH 1:12"/>Patrusfo, Kasluhfo ne Kaftorfo a wɔn ase na Filistifo fi.<verse eid="1CH 1:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 1:13"/>Na Kanaan woo nʼabakan</para>
  <para style="li2" vid="1CH 1:13">Sidon ne Het, <verse eid="1CH 1:13"/><verse number="14" style="v" sid="1CH 1:14"/>Yebusifo, Amorifo, Girgasifo, <verse eid="1CH 1:14"/><verse number="15" style="v" sid="1CH 1:15"/>Hewifo, Arkifo, Sinifo, <verse eid="1CH 1:15"/><verse number="16" style="v" sid="1CH 1:16"/>Arwadfo, Semarifo ne Hamatifo tete agya.<verse eid="1CH 1:16"/></para>
  <para style="s1">Sem Asefo</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 1:17"/>Na Sem asefo yɛ Elam, Asur, Arfaksad, Lud ne Aram.</para>
  <para style="li1" vid="1CH 1:17">Aram asefo ne Us, Hul, Geter ne Mas.<verse eid="1CH 1:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 1:18"/>Na Arfaksad woo Sela na Sela woo Eber. <verse eid="1CH 1:18"/><verse number="19" style="v" sid="1CH 1:19"/>Eber woo mmabarima baanu. Wɔtoo ɔbaako din Peleg a ase kyerɛ Nkyekyɛmu, efisɛ nʼawobere mu na kasa ahorow nti, nnipa a wɔwɔ asase so mu kyekyɛe ma wɔhwetee. Na wɔtoo ne nua a ɔka ne ho no din Yoktan.<verse eid="1CH 1:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 1:20"/>Yoktan woo Almodada, Selef, Hasarmawet, Yera, <verse eid="1CH 1:20"/><verse number="21" style="v" sid="1CH 1:21"/>Hadoram, Usal, Dikla, <verse eid="1CH 1:21"/><verse number="22" style="v" sid="1CH 1:22"/>Obal, Abimael, Seba, <verse eid="1CH 1:22"/><verse number="23" style="v" sid="1CH 1:23"/>Ofir, Hawila ne Yobab. Eyinom nyinaa yɛ Yoktan asefo.<verse eid="1CH 1:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 1:24"/>Ɛno nti, eyi ne anato a efi Sem: Arfaksad, Selah, <verse eid="1CH 1:24"/><verse number="25" style="v" sid="1CH 1:25"/>Eber, Peleg, Reu, <verse eid="1CH 1:25"/><verse number="26" style="v" sid="1CH 1:26"/>Serug, Nahor, Tera, <verse eid="1CH 1:26"/><verse number="27" style="v" sid="1CH 1:27"/>ne Abram a akyiri no, wɔfrɛɛ no Abraham no.<verse eid="1CH 1:27"/></para>
  <para style="s1">Abraham Asefo</para>
  <para style="li4">
    <verse number="28" style="v" sid="1CH 1:28"/>Abraham mmabarima yɛ Isak ne Ismael.<verse eid="1CH 1:28"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 1:29"/>Na Ismael mmabarima nso ne</para>
  <para style="li2" vid="1CH 1:29">Nebaiot a ɔyɛ nʼabakan, Kedar, Adbeel, Mibsam, <verse eid="1CH 1:29"/><verse number="30" style="v" sid="1CH 1:30"/>Misma, Duma, Masa, Hadad, Tema, <verse eid="1CH 1:30"/><verse number="31" style="v" sid="1CH 1:31"/>Yetur, Nafis ne Kedema.</para>
  <para style="li4" vid="1CH 1:31">Eyinom ne Ismael mmabarima.<verse eid="1CH 1:31"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 1:32"/>Na Abraham mpena Ketura mmabarima ne Simran, Yoksan, Medan, Midian, Yisbak ne Sua.</para>
  <para style="li1" vid="1CH 1:32">Na Yoksan asefo yɛ Seba ne Dedan.<verse eid="1CH 1:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 1:33"/>Midian woo Efa, Efer, Henok, Abida ne Eldaa.</para>
  <para style="li4" vid="1CH 1:33">Eyinom nyinaa yɛ Ketura asefo.<verse eid="1CH 1:33"/></para>
  <para style="s1">Isak Asefo</para>
  <para style="li4">
    <verse number="34" style="v" sid="1CH 1:34"/>Abraham woo Isak. Isak mmabarima yɛ Esau ne Israel.<note caller="+" style="f"><char style="fr" closed="false">1.34 </char><char style="fq" closed="false">Israel</char><char style="ft" closed="false">: Eyi ne din a Onyankopɔn de too Yakob</char></note><verse eid="1CH 1:34"/></para>
  <para style="s1">Esau Asefo</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 1:35"/>Na Esau mmabarima yɛ Elifas, Reuel, Yeus, Yalam ne Kora.<verse eid="1CH 1:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 1:36"/>Na Elifas mmabarima yɛ Teman, Omar, Sefi, Gatam, Kenas, Timna ne Amalek.<verse eid="1CH 1:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 1:37"/>Na Reuel mmabarima yɛ Nahat, Serah, Sama ne Misa.<verse eid="1CH 1:37"/></para>
  <para style="s1">Edomfo Abɔse</para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 1:38"/>Na Seir mmabarima yɛ Lotan, Sobal, Sibeon, Ana, Dison, Eser ne Disan.<verse eid="1CH 1:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 1:39"/>Na Lotan mmabarima yɛ Hori ne Homam. Na Lotan nuabea din de Timna.<verse eid="1CH 1:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 1:40"/>Na Sobal mmabarima yɛ Alian, Manahat, Ebal, Sefi ne Onam.</para>
  <para style="li1" vid="1CH 1:40">Sibeon mmabarima yɛ Aya ne Ana.<verse eid="1CH 1:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 1:41"/>Na Ana babarima yɛ Dison.</para>
  <para style="li1" vid="1CH 1:41">Na Dison mma yɛ Hemdan, Esban, Yitran ne Keran.<verse eid="1CH 1:41"/></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 1:42"/>Na Eser mmabarima yɛ Bilhan, Saawan ne Akan.</para>
  <para style="li1" vid="1CH 1:42">Na Disan mmabarima yɛ Us ne Aran.<verse eid="1CH 1:42"/></para>
  <para style="s1">Edom Sodifo</para>
  <para style="li4">
    <verse number="43" style="v" sid="1CH 1:43"/>Eyinom ne ahemfo a wodii Edom so ansa na Israelfo renya ahemfo:</para>
  <para style="li1" vid="1CH 1:43">Beor babarima Bela, a ɔtenaa kuropɔn Dinhaba so dii hene.<verse eid="1CH 1:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 1:44"/>Na Bela wui no, Serah babarima Yobab a ofi Bosra bedii nʼade sɛ ɔhene.<verse eid="1CH 1:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 1:45"/>Na Yobab wui no, Husam a ofi Teman asase so bedii nʼade sɛ ɔhene.<verse eid="1CH 1:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 1:46"/>Husam wu akyi no, Hadad a ɔyɛ Bedad babarima a okodii Midian so nkonim wɔ Moab asase so no na odii nʼade sɛ ɔhempɔn. Wɔtoo nʼahenkurow no din Hawit.<verse eid="1CH 1:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 1:47"/>Hadad wui no, Samla a ofi Masreka kuropɔn mu bɛyɛɛ ɔhene.<verse eid="1CH 1:47"/></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 1:48"/>Samla wui no, Saulo a ofi Rehobot a ɛda asu Eufrate ho no bedii hene.<verse eid="1CH 1:48"/></para>
  <para style="li1">
    <verse number="49" style="v" sid="1CH 1:49"/>Na Saulo wui no, Akbor babarima Baal-Hanan bedii hene.<verse eid="1CH 1:49"/></para>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 1:50"/>Baal-Hanan wui no, Hadad tenaa kuropɔn Pai mu dii hene. Na ne yere a wɔfrɛ no Mehetabel no yɛ Matred babea ne Me-Sahab nso nena. <verse eid="1CH 1:50"/><verse number="51" style="v" sid="1CH 1:51"/>Na Hadad nso wui.</para>
  <para style="b" vid="1CH 1:51"/>
  <para style="li4" vid="1CH 1:51">Na Edom mmusua no ntuanofo ne</para>
  <para style="li1" vid="1CH 1:51">Timna, Alia, Yetet, <verse eid="1CH 1:51"/><verse number="52" style="v" sid="1CH 1:52"/>Oholibama, Ela, Pinon, <verse eid="1CH 1:52"/><verse number="53" style="v" sid="1CH 1:53"/>Kenas, Teman, Mibsar, <verse eid="1CH 1:53"/><verse number="54" style="v" sid="1CH 1:54"/>Magdiel ne Iram.</para>
  <para style="li4" vid="1CH 1:54">Eyinom na na wɔyɛ Edom mmusua ntuanofo.<verse eid="1CH 1:54"/></para>
  <chapter eid="1CH 1"/>
  <chapter number="2" style="c" sid="1CH 2"/>
  <para style="s1">Israel Awo Ntoatoaso</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 2:1"/>Israel mmabarima yɛ Ruben, Simeon, Lewi, Yuda, Isakar, Sebulon, <verse eid="1CH 2:1"/><verse number="2" style="v" sid="1CH 2:2"/>Dan, Yosef, Benyamin, Naftali, Gad ne Aser.<verse eid="1CH 2:2"/></para>
  <para style="s1">Yuda Asefo</para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 2:3"/>Yuda ne Kanaannibea Bat-Sua woo mmabarima baasa.</para>
  <para style="li2" vid="1CH 2:3">Na wɔn din de Er, Onan ne Sela.</para>
  <para style="li2" vid="1CH 2:3">Nanso na abakan Er no yɛ omumɔyɛfo nti, <char style="nd">Awurade</char> kum no.<verse eid="1CH 2:3"/></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 2:4"/>Akyiri no, Yuda ne nʼase kunafo Tamar woo nta. Na wɔn din de Peres ne Serah.</para>
  <para style="li4" vid="1CH 2:4">Enti Yuda woo mmabarima baanum.<verse eid="1CH 2:4"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 2:5"/>Na Peres mmabarima din de</para>
  <para style="li2" vid="1CH 2:5">Hesron ne Hamul.<verse eid="1CH 2:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 2:6"/>Serah mmabarima din de</para>
  <para style="li2" vid="1CH 2:6">Simri, Etan, Heman, Kalkol ne Dara; wɔyɛ baanum.<verse eid="1CH 2:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 2:7"/>Akar a ɔyɛ Karmi babarima ne Serah asefo no mu baako nam fa a ɔfaa asade a wogyaw maa <char style="nd">Awurade</char> no so, de amanehunu baa Israelfo so.<verse eid="1CH 2:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 2:8"/>Na Etan babarima ne</para>
  <para style="li2" vid="1CH 2:8">Asaria.<verse eid="1CH 2:8"/></para>
  <para style="s1">Efi Yuda Nana Barima Hesron So Kosi Dawid So</para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 2:9"/>Hesron mmabarima din de Yerahmeel, Ram ne Kaleb.<verse eid="1CH 2:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 2:10"/>Ram yɛ Aminadab agya.</para>
  <para style="li1" vid="1CH 2:10">Aminadab yɛ Nahson a na ɔyɛ Yuda ntuanoni no agya.<verse eid="1CH 2:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 2:11"/>Nahson yɛ Salma agya.</para>
  <para style="li1" vid="1CH 2:11">Na Salma nso yɛ Boas agya.<verse eid="1CH 2:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 2:12"/>Boas yɛ Obed agya.</para>
  <para style="li1" vid="1CH 2:12">Obed yɛ Yisai agya.<verse eid="1CH 2:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 2:13"/>Yisai abakan yɛ Eliab nea ɔto so abien yɛ Abinadab na nea ɔto so abiɛsa yɛ Simea. <verse eid="1CH 2:13"/><verse number="14" style="v" sid="1CH 2:14"/>Na nea ɔto so anan yɛ Netanel na Radai to so anum. <verse eid="1CH 2:14"/><verse number="15" style="v" sid="1CH 2:15"/>Ne babarima a ɔto so asia no din de Osem na Dawid na na ɔto so ason. <verse eid="1CH 2:15"/><verse number="16" style="v" sid="1CH 2:16"/>Na wɔn nuabeanom din de Seruia ne Abigail.</para>
  <para style="li2" vid="1CH 2:16">Na Seruia woo mmabarima baasa a wɔn din yɛ Abisai, Yoab ne Asahel.<verse eid="1CH 2:16"/></para>
  <para style="li2">
    <verse number="17" style="v" sid="1CH 2:17"/>Abigail waree ɔbarima bi a ne din de Yeter a ɔyɛ Ismaelni na wɔwoo ɔbabarima a wɔtoo no din Amasa.<verse eid="1CH 2:17"/></para>
  <para style="s1">Hesron Babarima Kaleb Asefo</para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 2:18"/>Na Hesron babarima Kaleb wɔ yerenom baanu a wɔne Asuba ne Yeriot. Na Asuba mmabarima din de Yeser, Sobab ne Ardon.<verse eid="1CH 2:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 2:19"/>Asuba wu akyi no, Kaleb waree Efrata. Wɔwoo ɔbabarima too no din Hur.<verse eid="1CH 2:19"/></para>
  <para style="li2">
    <verse number="20" style="v" sid="1CH 2:20"/>Hur woo Uri. Uri nso woo Besaleel.<verse eid="1CH 2:20"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 2:21"/>Bere a Hesron dii mfe aduosia no, ɔwaree Gilead nuabea a na ɔyɛ Makir babea. Wɔwoo ɔbabarima too no din Segub.<verse eid="1CH 2:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 2:22"/>Segub woo Yair a odii nkurow aduonu abiɛsa so wɔ Gilead asase so no.<verse eid="1CH 2:22"/></para>
  <para style="li2">
    <verse number="23" style="v" sid="1CH 2:23"/>(Akyiri no, Gesur ne Aram gyee Yair nkurow, san gyee Kenat ne ne nkuraa aduosia a atwa ho ahyia no nyinaa.)</para>
  <para style="li4" vid="1CH 2:23">Na eyinom nyinaa yɛ Makir a ɔyɛ Gilead agya no asefo.<verse eid="1CH 2:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 2:24"/>Hesron wuu wɔ kurow Kaleb-Efrata mu akyi no, ne yere Abia woo ɔbabarima a wɔtoo no din Asur (Tekoa agya).<verse eid="1CH 2:24"/></para>
  <para style="s1">Hesron Ba Yerahmeel Asefo</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 2:25"/>Hesron abakan Yerahmeel mmabarima a ɔwoo wɔn no din yɛ</para>
  <para style="li2" vid="1CH 2:25">Ram (abakan), Buna, Oren, Osem ne Ahiya. <verse eid="1CH 2:25"/><verse number="26" style="v" sid="1CH 2:26"/>Na Yerahmeel wɔ ɔyere a ɔto so abien a wɔfrɛ no Atara, na ɔno na ɔwoo Onam.<verse eid="1CH 2:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 2:27"/>Ram a ɔyɛ Yerahmeel abakan no mmabarima yɛ</para>
  <para style="li2" vid="1CH 2:27">Maas, Yamin ne Eker.<verse eid="1CH 2:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 2:28"/>Onam mmabarima yɛ</para>
  <para style="li2" vid="1CH 2:28">Samai ne Yada.</para>
  <para style="li1" vid="1CH 2:28">Na Samai mmabarima yɛ</para>
  <para style="li2" vid="1CH 2:28">Nadab ne Abisur. <verse eid="1CH 2:28"/><verse number="29" style="v" sid="1CH 2:29"/>Na Abisur ne ne yere Abihail mmabarima yɛ Ahban ne Molid.<verse eid="1CH 2:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 2:30"/>Na Nadab mmabarima yɛ</para>
  <para style="li2" vid="1CH 2:30">Seled ne Apaim. Seled wui a wanwo mma;<verse eid="1CH 2:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 2:31"/>na Apaim de, ɔwoo ɔbabarima a wɔfrɛ no Yisi.</para>
  <para style="li2" vid="1CH 2:31">Na Yisi woo Sesan. Na Sesan nyaa nʼaseni bi a wɔfrɛ no Ahlai.<verse eid="1CH 2:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 2:32"/>Na Samai nuabarima Yada woo</para>
  <para style="li2" vid="1CH 2:32">Yeter ne Yonatan. Na Yeter wui a wanwo ba biara,<verse eid="1CH 2:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 2:33"/>nanso Yonatan woo mmabarima baanu a na wɔfrɛ wɔn</para>
  <para style="li2" vid="1CH 2:33">Pelet ne Sasa.</para>
  <para style="li4" vid="1CH 2:33">Na eyinom nyinaa yɛ Yerahmeel asefo.<verse eid="1CH 2:33"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 2:34"/>Na Sesan annya mmabarima, onyaa mmabea.</para>
  <para style="li2" vid="1CH 2:34">Na ɔwɔ Misraimni somfo bi a ne din de Yarha. <verse eid="1CH 2:34"/><verse number="35" style="v" sid="1CH 2:35"/>Sesan de ne mmabea no mu baako maa Yarha aware na wɔwoo ɔbabarima too no din Atai.<verse eid="1CH 2:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 2:36"/>Atai woo Natan</para>
  <para style="li1" vid="1CH 2:36">na Natan woo Sabad.<verse eid="1CH 2:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 2:37"/>Sabad woo Efial.</para>
  <para style="li1" vid="1CH 2:37">Efial woo Obed.<verse eid="1CH 2:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 2:38"/>Obed woo Yehu</para>
  <para style="li1" vid="1CH 2:38">na Yehu woo Asaria.<verse eid="1CH 2:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 2:39"/>Asaria woo Heles.</para>
  <para style="li1" vid="1CH 2:39">Heles woo Eleasa.<verse eid="1CH 2:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 2:40"/>Eleasa woo Sisemai</para>
  <para style="li1" vid="1CH 2:40">na Sisemai woo Salum.<verse eid="1CH 2:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 2:41"/>Salum woo Yekamia,</para>
  <para style="li1" vid="1CH 2:41">na Yekamia woo Elisama.<verse eid="1CH 2:41"/></para>
  <para style="s1">Hesron Babarima Kaleb Asefo</para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 2:42"/>Yerahmeel nua Kaleb</para>
  <para style="li2" vid="1CH 2:42">babarima piesie ne Mesa a ɔyɛ Sif agya.</para>
  <para style="li2" vid="1CH 2:42">Na Kaleb babarima a ɔto so abien din de Maresa a ɔyɛ Hebron agya.<verse eid="1CH 2:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 2:43"/>Na Hebron mmabarima yɛ</para>
  <para style="li2" vid="1CH 2:43">Kora, Tapua, Rekem ne Sema.<verse eid="1CH 2:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 2:44"/>Na Sema woo Raham.</para>
  <para style="li2" vid="1CH 2:44">Raham woo Yorkeam.</para>
  <para style="li1" vid="1CH 2:44">Na Rekem woo Samai.<verse eid="1CH 2:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 2:45"/>Na Samai woo Maon.</para>
  <para style="li2" vid="1CH 2:45">Maon woo Bet-Sur.<verse eid="1CH 2:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 2:46"/>Na Kaleb mpena Efa woo</para>
  <para style="li2" vid="1CH 2:46">Haran, Mosa ne Gases.</para>
  <para style="li2" vid="1CH 2:46">Na Haran woo Gases.<verse eid="1CH 2:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 2:47"/>Na Yahdai mmabarima yɛ</para>
  <para style="li2" vid="1CH 2:47">Regem, Yotam, Gesan, Pelet, Efa ne Saaf.<verse eid="1CH 2:47"/></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 2:48"/>Kaleb mpena foforo bi a wɔfrɛ no Maaka woo</para>
  <para style="li2" vid="1CH 2:48">Seber ne Tirhana.<verse eid="1CH 2:48"/></para>
  <para style="li2">
    <verse number="49" style="v" sid="1CH 2:49"/>Ɔsan woo Saaf a na ɔyɛ Madmana agya</para>
  <para style="li2" vid="1CH 2:49">ne Sewa a na ɔyɛ Makbena ne Gibea agya.</para>
  <para style="li1" vid="1CH 2:49">Na Kaleb woo ɔbabea a ne din de Aksa.<verse eid="1CH 2:49"/></para>
  <para style="li4">
    <verse number="50" style="v" sid="1CH 2:50"/>Eyinom nyinaa yɛ Kaleb asefo.</para>
  <para style="s1" vid="1CH 2:50">Kaleb Babarima Hur Asefo</para>
  <para style="li1" vid="1CH 2:50">Kaleb yere Efrata abakan Hur mmabarima yɛ</para>
  <para style="li2" vid="1CH 2:50">Sobal a ɔyɛ Kiriat-Yearim agya <verse eid="1CH 2:50"/><verse number="51" style="v" sid="1CH 2:51"/>Salma a ɔyɛ Betlehem agya ne Haref a ɔyɛ Bet-Gader agya.<verse eid="1CH 2:51"/></para>
  <para style="li1">
    <verse number="52" style="v" sid="1CH 2:52"/>Sobal a ɔyɛ Kiriat-Yearim agya no mmabarima yɛ</para>
  <para style="li2" vid="1CH 2:52">Haroe a ne fa yɛ Manahatini <verse eid="1CH 2:52"/><verse number="53" style="v" sid="1CH 2:53"/>na ne fa a aka no fi Kiriat-Yearim mmusua mu. Sobal asefo a wɔka ho ne Yitrifo, Putifo, Sumatifo ne Misraimfo, wɔn mu na Sorafo ne Estaolfo fi.<verse eid="1CH 2:53"/></para>
  <para style="li1">
    <verse number="54" style="v" sid="1CH 2:54"/>Salma asefo yɛ</para>
  <para style="li2" vid="1CH 2:54">Betlehem, Netofafo, Atrot-Bet-Yoabfo, Manahatafo fa bi, Sorifo, <verse eid="1CH 2:54"/><verse number="55" style="v" sid="1CH 2:55"/>ne akyerɛwfo mmusua a wɔte Yabes no, Tirafo, Simeafo ne Sukatfo. Eyinom nyinaa yɛ Kenifo, Hamat a ɔyɛ Rekab agya no asefo.<verse eid="1CH 2:55"/></para>
  <chapter eid="1CH 2"/>
  <chapter number="3" style="c" sid="1CH 3"/>
  <para style="s1">Dawid Asefo</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 3:1"/>Eyinom ne mmabarima a wɔwowoo wɔn maa Dawid wɔ Hebron.</para>
  <para style="b" vid="1CH 3:1"/>
  <para style="li1" vid="1CH 3:1">Na nʼabakan din de Amnon a ne na a na ofi Yesreel no din de Ahinoam.</para>
  <para style="li1" vid="1CH 3:1">Ne ba a ɔto so abien no, na ne din de Daniel. Na ne na a ofi Karmel no din de Abigail.<verse eid="1CH 3:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 3:2"/>Ne ba a ɔto so abiɛsa no, na wɔfrɛ no Absalom. Na ne na din de Maaka a na ɔyɛ Gesurhene Talmai babea.</para>
  <para style="li1" vid="1CH 3:2">Ne ba a ɔto so anan din de Adoniya a ne na din de Hagit.<verse eid="1CH 3:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 3:3"/>Ne ba a ɔto so anum no, na wɔfrɛ no Sefatia. Na wɔfrɛ ne na Abital.</para>
  <para style="li1" vid="1CH 3:3">Ne ba a ɔto so asia no din de Yitream a na wɔfrɛ ne na Egla.<verse eid="1CH 3:3"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="li4">
    <verse number="4" style="v" sid="1CH 3:4"/>Wɔwowoo mmabarima baasia yi nyinaa maa Dawid wɔ Hebron. Odii ade wɔ hɔ mfirihyia ason ne fa.</para>
  <para style="b" vid="1CH 3:4"/>
  <para style="li4" vid="1CH 3:4">Dawid yii kuropɔn no kɔɔ Yerusalem, na odii ade mfirihyia aduasa abiɛsa wɔ hɔ. <verse eid="1CH 3:4"/><verse number="5" style="v" sid="1CH 3:5"/>Mmabarima a wɔwowoo wɔn maa Dawid wɔ Yerusalem no ne:</para>
  <para style="b" vid="1CH 3:5"/>
  <para style="li1" vid="1CH 3:5">Simea, Sobab, Natan ne Salomo. Amiel babea Batseba na ɔwoo saa mmarima yi.<verse eid="1CH 3:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 3:6"/>Wɔsan wowoo mmabarima baakron bi maa Dawid. Wɔne Yibhar, Elisua, Elifelet, <verse eid="1CH 3:6"/><verse number="7" style="v" sid="1CH 3:7"/>Noga, Nefeg, Yafia, <verse eid="1CH 3:7"/><verse number="8" style="v" sid="1CH 3:8"/>Elisama, Eliada ne Elifelet.<verse eid="1CH 3:8"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="9" style="v" sid="1CH 3:9"/>Eyinom ne Dawid mmabarima a ne mpena mma nka ho. Na Dawid wɔ ɔbabea bi a wɔfrɛ no Tamar.<verse eid="1CH 3:9"/></para>
  <para style="s1">Salomo Asefo</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 3:10"/>Na Salomo asefo yɛ</para>
  <para style="li1" vid="1CH 3:10">Rehoboam, Abia, Asa, Yehosafat,<verse eid="1CH 3:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 3:11"/>Yoram, Ahasia, Yoas,<verse eid="1CH 3:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 3:12"/>Amasia, Asaria, Yotam,<verse eid="1CH 3:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 3:13"/>Ahas, Hesekia, Manase,<verse eid="1CH 3:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 3:14"/>Amon ne Yosia.<verse eid="1CH 3:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 3:15"/>Na Yosia mmabarima ne</para>
  <para style="li2" vid="1CH 3:15">Yohanan a ɔyɛ abakan,</para>
  <para style="li2" vid="1CH 3:15">Yehoiakim to so abien,</para>
  <para style="li2" vid="1CH 3:15">Sedekia to so abiɛsa,</para>
  <para style="li2" vid="1CH 3:15">na Salum to so anan.<verse eid="1CH 3:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 3:16"/>Yehoiakim babarima Yehoiakyin na odii nʼade,</para>
  <para style="li2" vid="1CH 3:16">na ɔno nso ne wɔfa Sedekia bedii nʼade.<verse eid="1CH 3:16"/></para>
  <para style="s1">Yehoiakyin Asefo</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 3:17"/>Yehoiakyin a Babiloniafo kyeree no kɔtoo afiase no</para>
  <para style="li2" vid="1CH 3:17">mmabarima ne Sealtiel, <verse eid="1CH 3:17"/><verse number="18" style="v" sid="1CH 3:18"/>Malkiram, Pedaia, Senasar, Yekamia, Hosama ne Nedabia.<verse eid="1CH 3:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 3:19"/>Na Pedaia mmabarima yɛ</para>
  <para style="li2" vid="1CH 3:19">Serubabel ne Simei.</para>
  <para style="li1" vid="1CH 3:19">Na Serubabel mmabarima yɛ</para>
  <para style="li2" vid="1CH 3:19">Mesulam ne Hanania. Na ɔwɔ ɔbabea nso a ne din de Selomit. <verse eid="1CH 3:19"/><verse number="20" style="v" sid="1CH 3:20"/>Na ne mmabarima baanum bi nso din ne Hasuba, Ohel, Berekia, Hasadia ne Yusab-Hesed.<verse eid="1CH 3:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 3:21"/>Na Hanania mmabarima din de</para>
  <para style="li2" vid="1CH 3:21">Pelatia ne Yesaia. Na Yesaia babarima din de Refaia. Na Refaia babarima din de Arnan. Na Arnan babarima din de Obadia. Na Obadia babarima din de Sekania.<verse eid="1CH 3:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 3:22"/>Na Sekania asefo yɛ</para>
  <para style="li2" vid="1CH 3:22">Semaia ne ne mmabarima Hatus, Igal, Baria, Nearia ne Safat. Na wɔn nyinaa yɛ baasia.<verse eid="1CH 3:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 3:23"/>Na Nearia mmabarima din de</para>
  <para style="li2" vid="1CH 3:23">Elioenai, Hiskia ne Asrikam. Na wɔyɛ baasa.<verse eid="1CH 3:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 3:24"/>Na Elioenai mmabarima din de</para>
  <para style="li2" vid="1CH 3:24">Hodawia, Eliasib, Pelaia, Akub, Yohanan, Delaia ne Anani. Na wɔyɛ baason.<verse eid="1CH 3:24"/></para>
  <chapter eid="1CH 3"/>
  <chapter number="4" style="c" sid="1CH 4"/>
  <para style="s1">Yuda Asefo Nkae</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 4:1"/>Yuda asefo no bi din de</para>
  <para style="li2" vid="1CH 4:1">Peres, Hesron, Karmi, Hur ne Sobal.<verse eid="1CH 4:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 4:2"/>Sobal babarima Reaia na ɔwoo Yahat. Yahat woo Ahumai ne Lahad. Eyinom na na wɔyɛ Sorafo mmusua.<verse eid="1CH 4:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 4:3"/>Na Etam asefo no ne</para>
  <para style="li2" vid="1CH 4:3">Yesreel, Yisma, Yidbas ne Haslelponi a na ɔyɛ ne babea, <verse eid="1CH 4:3"/><verse number="4" style="v" sid="1CH 4:4"/>Penuel a na ɔyɛ Gedor agya ne Eser a na ɔyɛ Husa agya. Eyinom na na wɔyɛ Hur a na ɔyɛ Efrata abakan ne Betlehem agya no asefo.<verse eid="1CH 4:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 4:5"/>Na Tekoa agya a ne din de Ashur no wɔ yerenom baanu a wɔfrɛ wɔn Hela ne Naara.<verse eid="1CH 4:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 4:6"/>Naara woo Ahusam, Hefer, Temeni ne Ahastari.<verse eid="1CH 4:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 4:7"/>Hela woo</para>
  <para style="li2" vid="1CH 4:7">Seret, Sohar, Etnan, <verse eid="1CH 4:7"/><verse number="8" style="v" sid="1CH 4:8"/>ne Kos a nʼasefo ne Anub, Hasobeba ne Harum babarima Aharhel, Harum ne ne mmusua nyinaa.<verse eid="1CH 4:8"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9"/>Na ɔbarima bi wɔ hɔ a wɔfrɛ no Yabes a ɔyɛɛ ɔkɛse sen ne nuabarimanom nyinaa. Ne na too no din Yabes, efisɛ onyaa ɔyaw wɔ nʼawo mu. <verse eid="1CH 4:9"/><verse number="10" style="v" sid="1CH 4:10"/>Yabes ne obi a ɔbɔɔ mpae kyerɛɛ Israel Nyankopɔn se, “Ao, hyira me na trɛw mʼahye mu. Mesrɛ wo, ka me ho wɔ nea mɛyɛ biara mu, na yi me fi ɔhaw ne ɔyaw nyinaa mu.” Na Onyankopɔn yɛɛ nʼabisade no maa no.<verse eid="1CH 4:10"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 4:11"/>Suba nuabarima Kelub woo Mehir. Mehir woo Eston. <verse eid="1CH 4:11"/><verse number="12" style="v" sid="1CH 4:12"/>Eston woo Bet-Rafa, Paseah ne Tehina. Tehina woo Ir-Nahas. Eyinom ne Reka asefo.<verse eid="1CH 4:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 4:13"/>Kenas mmabarima ne</para>
  <para style="li2" vid="1CH 4:13">Otniel ne Seraia.</para>
  <para style="li1" vid="1CH 4:13">Otniel mmabarima ne</para>
  <para style="li2" vid="1CH 4:13">Hatat ne Meonotai. <verse eid="1CH 4:13"/><verse number="14" style="v" sid="1CH 4:14"/>Meonotai woo Ofra.</para>
  <para style="li1" vid="1CH 4:14">Na Seraia woo Yoab</para>
  <para style="li2" vid="1CH 4:14">a ofii Adwumfo Bon ase, efisɛ na adwumfo pii tete hɔ.<verse eid="1CH 4:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 4:15"/>Na Yefune babarima Kaleb mmabarima yɛ</para>
  <para style="li2" vid="1CH 4:15">Iru, Ela ne Naam.</para>
  <para style="li1" vid="1CH 4:15">Na Ela babarima yɛ</para>
  <para style="li2" vid="1CH 4:15">Kenas.<verse eid="1CH 4:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 4:16"/>Yehalelel mmabarima ne</para>
  <para style="li2" vid="1CH 4:16">Sif ne Sifa, Tiria ne Asarel.<verse eid="1CH 4:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 4:17"/>Ɛsra mmabarima yɛ</para>
  <para style="li2" vid="1CH 4:17">Yeter, Mered, Efer ne Yalon.</para>
  <para style="li1" vid="1CH 4:17">Mered waree Misraimnibea ma ɔwoo Miriam, Samai ne Yisba a ɔbɛyɛɛ Estemoa agya no. <verse eid="1CH 4:17"/><verse number="18" style="v" sid="1CH 4:18"/>Mered nso waree ɔbea a ofi Yuda.</para>
  <para style="li1" vid="1CH 4:18">Ɔno nso woo Yered a ɔbɛyɛɛ Gedor agya, Heber a ɔyɛ Soko agya, ne Yekutiel a ɔyɛ Sanoa agya. Na wɔfrɛ Mered yere Misraimni no se Bitia a na ɔyɛ Misraimhene babea.<verse eid="1CH 4:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 4:19"/>Na Hodia yere yɛ Naham nuabea.</para>
  <para style="li2" vid="1CH 4:19">Ne mmabarima no mu baako na ɔwoo Keila a ɔyɛ Garmini na ɔbaako nso woo Estemoa a ɔyɛ Maakatni.<verse eid="1CH 4:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 4:20"/>Simon mmabarima ne</para>
  <para style="li2" vid="1CH 4:20">Amnon, Rina, Ben-Hanan ne Tilon.</para>
  <para style="li1" vid="1CH 4:20">Na Yisi asefo no ne</para>
  <para style="li2" vid="1CH 4:20">Sohet ne Ben-Sohet.<verse eid="1CH 4:20"/></para>
  <para style="s1">Yuda Babarima Sela Asefo</para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 4:21"/>Na Sela yɛ Yuda mma no mu baako.</para>
  <para style="li2" vid="1CH 4:21">Na Sela asefo no ne Er a ɔwoo Leka, Lada a ɔwoo Maresa a na wɔyɛ nweratam ho adwuma wɔ Bet-Asbea,<verse eid="1CH 4:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 4:22"/>Yokim, Kosebafo, Yoas, ne Saraf a na wodi Moab ne Yasubi-Lehem so no. Saa din yi nyinaa, wonya fii tete nkyerɛw a na wɔakyerɛw agu hɔ mu. <verse eid="1CH 4:22"/><verse number="23" style="v" sid="1CH 4:23"/>Na wɔyɛ nkukunwemfo a na wɔte Netaim ne Gedera. Na wɔn nyinaa yɛ nnwuma ma ɔhene.<verse eid="1CH 4:23"/></para>
  <para style="s1">Simeon Asefo</para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 4:24"/>Na Simeon mmabarima no din de</para>
  <para style="li2" vid="1CH 4:24">Nemuel, Yamin, Yarib, Serah ne Saulo.<verse eid="1CH 4:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 4:25"/>Na Saulo asefo yɛ Salum, Mibsam ne Misma.<verse eid="1CH 4:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 4:26"/>Na Misma asefo yɛ</para>
  <para style="li2" vid="1CH 4:26">Hamuel, Sakur ne Simei.<verse eid="1CH 4:26"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27"/>Simei woo mmabarima dunsia ne mmabea baasia. Ne nuabarimanom de, na wɔn mu biara nni abusua kɛse saa. Ɛno nti, Simeon abusua annɔ te sɛ Yuda abusua no. <verse eid="1CH 4:27"/><verse number="28" style="v" sid="1CH 4:28"/>Wɔtenaa Beer-Seba, Molada ne Hasar-Sual, <verse eid="1CH 4:28"/><verse number="29" style="v" sid="1CH 4:29"/>Bilha, Esem ne Tolad, <verse eid="1CH 4:29"/><verse number="30" style="v" sid="1CH 4:30"/>Betuel, Horma ne Siklag, <verse eid="1CH 4:30"/><verse number="31" style="v" sid="1CH 4:31"/>Bet-Markabot, Hasar-Susim, Bet-Biri ne Saaraim. Na saa nkurow yi nyinaa hyɛɛ wɔn ase kosii ɔhene Dawid bere so. <verse eid="1CH 4:31"/><verse number="32" style="v" sid="1CH 4:32"/>Wɔn asefo nso tenaa Etam, Ain, Rimon, Token ne Asan a ɛyɛ nkurow anum yi so, <verse eid="1CH 4:32"/><verse number="33" style="v" sid="1CH 4:33"/>ne ne nkuraa a atwa ho ahyia no kosii Baal.</para>
  <para style="b" vid="1CH 4:33"/>
  <para style="li4" vid="1CH 4:33">Na wɔn atenae ni, na wɔahyehyɛ saa din yi nyinaa wɔ wɔn anato nkrataa mu.<verse eid="1CH 4:33"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 4:34"/>Wɔn a wɔka Simeon asefo ho no bi nso ne Mesobab, Yamlek</para>
  <para style="li1" vid="1CH 4:34">ne Amasia babarima Yosa, <verse eid="1CH 4:34"/><verse number="35" style="v" sid="1CH 4:35"/>Yoel,</para>
  <para style="li1" vid="1CH 4:35">Yosibia babarima Yehu a ɔyɛ Seraia babarima, na ɔno nso yɛ Asiel babarima,<verse eid="1CH 4:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 4:36"/>Elioenai, Yaakoba, Yesohaia, Asaia, Adiel, Yesimiel ne Benaia, <verse eid="1CH 4:36"/><verse number="37" style="v" sid="1CH 4:37"/>Sifi babarima Sisa a nʼagya yɛ Alon babarima, na ɔno yɛ Yedaia babarima, na ɔno nso yɛ Simri babarima a nʼagya yɛ Semaia.<verse eid="1CH 4:37"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="38" style="v" sid="1CH 4:38"/>Din a yɛabobɔ yi yɛ ntuanofo a wɔdeda Simeon mmusuakuw a wɔyɛ adefo no ano no bi.<verse eid="1CH 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 4:39"/>Wɔkɔɔ Gedor fam a na ɛwɔ obon no apuei fam sɛ wɔrekɔpɛ asase pa ama wɔn mmoa adidi so. <verse eid="1CH 4:39"/><verse number="40" style="v" sid="1CH 4:40"/>Wonyaa mmoa adidibea pa wɔ hɔ. Na asase no so dwo na basabasayɛ biara nni hɔ. Na Ham asefo no bi akɔtena Gedor fa mu hɔ dedaw.<verse eid="1CH 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41"/>Yudahene Hesekia bere so no, Simeon ntuanofo no ko dii hɔ so, sɛee Ham ne Meunifo afi pasaa. Wokum obiara a na ɔte hɔ, faa asase no, efisɛ, na wɔpɛ sɛ wonya mmoa didibea pa no. <verse eid="1CH 4:41"/><verse number="42" style="v" sid="1CH 4:42"/>Akofo no mu ahannum a wofi Simeon abusuakuw mu no kɔɔ bepɔw Seir so, a na Pelatia, Nearia, Refaia ne Usiel a wɔn nyinaa yɛ Yisi mmabarima no na na wodi wɔn anim. <verse eid="1CH 4:42"/><verse number="43" style="v" sid="1CH 4:43"/>Amalekfo kakra a wɔkae no, wokunkum wɔn nyinaa, faa hɔ, na wɔtenaa hɔ.<verse eid="1CH 4:43"/></para>
  <chapter eid="1CH 4"/>
  <chapter number="5" style="c" sid="1CH 5"/>
  <para style="s1">Ruben Asefo</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 5:1"/>Na Israel babarima panyin ne Ruben. Nanso esiane sɛ wammu nʼagya, na ɔne nʼagya mpenanom no mu baako kɔdae no nti, ɔde nʼabakanyɛ maa ne nua Yosef mmabarima. Esiane saa asɛm yi nti, wɔamfa Ruben din anka anato no ho sɛ abakan. <verse eid="1CH 5:1"/><verse number="2" style="v" sid="1CH 5:2"/>Yuda asefo na wɔyɛɛ abusuakuw a wɔwɔ tumi pa ara; ne saa nti woyii ɔman no sodifo fii wɔn mu, nanso mpanyinni no de, na ɛyɛ Yosef dea. <verse eid="1CH 5:2"/><verse number="3" style="v" sid="1CH 5:3"/>Israel abakan Ruben no mmabarima ne:</para>
  <para style="b" vid="1CH 5:3"/>
  <para style="li2" vid="1CH 5:3">Hanok, Palu, Hesron ne Karmi.<verse eid="1CH 5:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 5:4"/>Yoel asefo ne</para>
  <para style="li2" vid="1CH 5:4">Semaia, Gog, Simei,<verse eid="1CH 5:4"/></para>
  <para style="li2">
    <verse number="5" style="v" sid="1CH 5:5"/>Mika, Reaia, Baal,<verse eid="1CH 5:5"/></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 5:6"/>ne Beera. Bere a Asiriahene Tilgat-Pilneser de Rubenfo kɔɔ nnommumfa mu no, Beera na na odi Rubenfo no anim.<verse eid="1CH 5:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 5:7"/>Wɔakyerɛw Beera nkurɔfo din sɛnea wɔn mmusua ne abusua no te: Yeiel ne wɔn ntuanoni, na Sakaria <verse eid="1CH 5:7"/><verse number="8" style="v" sid="1CH 5:8"/>ne Asas babarima Bela a ɔyɛ Sema babarima a ɔyɛ Yoel babarima.</para>
  <para style="b" vid="1CH 5:8"/>
  <para style="p" vid="1CH 5:8">Saa Rubenfo yi tenaa beae a efi Aroer de kosi Nebo ne Baal-Meon. <verse eid="1CH 5:8"/><verse number="9" style="v" sid="1CH 5:9"/>Esiane sɛ na wɔwɔ anantwi bebree wɔ Gilead asase so no nti, wodidi kɔɔ apuei fam wɔ nweatam a ɛtrɛw kɔ Asubɔnten Eufrate no ho.<verse eid="1CH 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 5:10"/>Ɔhene Saulo bere so, Rubenfo dii Hagarfo<note caller="+" style="f"><char style="fr" closed="false">5.10 </char><char style="ft" closed="false">Hagarfo. (<char style="xt"><ref loc="1CH 5:19-22">1 Be 5.19-22</ref></char>) Saa abusua a wɔyɛ Hagar a na ɔyɛ Ismael ne na (<char style="xt"><ref loc="GEN 16">1 Mose 16</ref></char>) asefo no, na wɔyɛ Israelfo atamfo no mu baako (<char style="xt"><ref loc="PSA 83:6">Nnw 83.6</ref></char>).</char></note> so nkonim wɔ ɔko mu. Enti wotu kɔɔ Hagarfo atenae a ɛwɔ Gilead apuei fam hɔ no.<verse eid="1CH 5:10"/></para>
  <para style="s1">Gad Asefo</para>
  <para style="li4">
    <verse number="11" style="v" sid="1CH 5:11"/>Basan asase so no, na Gad asefo na wɔtete asase a edi Rubenfo de no so. Wɔtrɛw kɔɔ apuei fam kosii Saleka.<verse eid="1CH 5:11"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 5:12"/>Na Yoel na otua wɔn ano wɔ Basan asase so. Na Safam, Yanai ne Safat yɛ nʼaboafo.<verse eid="1CH 5:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 5:13"/>Na wɔn abusuafo a wɔyɛ ntuanofo ma mmusua afoforo ason din ne:</para>
  <para style="li2" vid="1CH 5:13">Mikael, Mesulam, Seba, Yorai, Yakan, Sia ne Eber.<verse eid="1CH 5:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 5:14"/>Eyinom nyinaa yɛ Huri babarima Abihail a ɔyɛ Yaroa babarima, Gilead babarima, Mikael babarima, Yesisai babarima Yahdo babarima, Bus babarima.<verse eid="1CH 5:14"/></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 5:15"/>Abdiel babarima Ahi, Guni babarima no na na ɔyɛ wɔn mmusua no ntuano.<verse eid="1CH 5:15"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="16" style="v" sid="1CH 5:16"/>Gadfo no tenaa Gilead asase a ɛwɔ Basan ne ne nkuraa ne Saron tataw no nyinaa so.<verse eid="1CH 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 5:17"/>Yudahene Yotam ne Israelhene Yeroboam bere so na wɔkyerɛw eyinom nyinaa guu abusuadua nkrataa mu.<verse eid="1CH 5:17"/></para>
  <para style="s1">Yordan Apuei Fam Mmusuakuw</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18"/>Na akofo akɛse a wɔwɔ Ruben, Gad mmusua ne Manase abusua fa mu no ano si mpem aduanan anan ahanson ne aduosia. Wokurakura nkatabo, mfoa ne agyan, na wɔn nyinaa akwadaw wɔ akodi mu. <verse eid="1CH 5:18"/><verse number="19" style="v" sid="1CH 5:19"/>Wɔko tiaa Hagarfo, Yeturfo, Nafisfo ne Nodabfo. <verse eid="1CH 5:19"/><verse number="20" style="v" sid="1CH 5:20"/>Wosu frɛɛ Onyankopɔn wɔ ɔko no mu, na otiee wɔn mpaebɔ, efisɛ wɔde wɔn ho too ne so. Enti wodii Hagarfo no ne wɔn dɔm nyinaa so nkonim. <verse eid="1CH 5:20"/><verse number="21" style="v" sid="1CH 5:21"/>Asade a wɔfa fii Hagarfo no nkyɛn no yɛ yoma mpem aduonum, nguan mpem ahannu aduonum, mfurum mpenu ne nneduafo mpem ɔha. <verse eid="1CH 5:21"/><verse number="22" style="v" sid="1CH 5:22"/>Wokunkum Hagarfo no bebree wɔ ɔko no mu, efisɛ na Onyankopɔn reko tia wɔn. Enti wɔtenaa wɔn asase so kosii sɛ wotwaa wɔn asu.<verse eid="1CH 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23"/>Manase abusua fa no trɛw wɔ asase no so fi Basan kosii Baal-Hermon, Senir ne bepɔw Hermon ho. Na wɔdɔɔso yiye. <verse eid="1CH 5:23"/><verse number="24" style="v" sid="1CH 5:24"/>Eyinom ne wɔn mmusua no ntuanofo: Efer, Yisi, Eliel, Asriel, Yeremia, Hodawia ne Yahdiel. Na wɔn mu biara agye din sɛ ɔkofo kɛse ne ɔkannifo. <verse eid="1CH 5:24"/><verse number="25" style="v" sid="1CH 5:25"/>Nanso na wonni nokware, na wobuu wɔn agyanom ne Onyankopɔn apam no so. Wɔsom aman a Onyankopɔn sɛee wɔn no anyame. <verse eid="1CH 5:25"/><verse number="26" style="v" sid="1CH 5:26"/>Enti Israel Nyankopɔn de hyɛɛ Asiriahene Pul (a na wɔsan frɛ no Tilgat-Pilneser) koma mu sɛ ɔnko mfa asase no, na ɔnkyekyere Rubenfo, Gadfo ne Manasefo abusua fa sɛ nneduafo. Asiriafo no twaa wɔn asu kɔɔ Halah, Habor, Hara ne Asubɔnten Gosan ho a wɔda so te hɔ besi nnɛ.<verse eid="1CH 5:26"/></para>
  <chapter eid="1CH 5"/>
  <chapter number="6" style="c" sid="1CH 6"/>
  <para style="s1">Asɔfo Awo Ntoatoaso</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 6:1"/>Na Lewi mmabarima yɛ:</para>
  <para style="li2" vid="1CH 6:1">Gerson, Kohat ne Merari.<verse eid="1CH 6:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 6:2"/>Na Kohat asefo nso yɛ:</para>
  <para style="li2" vid="1CH 6:2">Amram, Ishar, Hebron ne Usiel.<verse eid="1CH 6:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 6:3"/>Na Amram mma yɛ:</para>
  <para style="li2" vid="1CH 6:3">Aaron, Mose ne Miriam.</para>
  <para style="li1" vid="1CH 6:3">Na Aaron mmabarima yɛ:</para>
  <para style="li2" vid="1CH 6:3">Nadab, Abihu, Eleasar ne Itamar.<verse eid="1CH 6:3"/></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 6:4"/>Eleasar woo Pinehas.</para>
  <para style="li2" vid="1CH 6:4">Pinehas woo Abisua.<verse eid="1CH 6:4"/></para>
  <para style="li2">
    <verse number="5" style="v" sid="1CH 6:5"/>Abisua woo Buki,</para>
  <para style="li2" vid="1CH 6:5">na Buki woo Usi.<verse eid="1CH 6:5"/></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 6:6"/>Usi woo Serahia. Serahia woo Meraiot.<verse eid="1CH 6:6"/></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 6:7"/>Meraiot woo Amaria,</para>
  <para style="li2" vid="1CH 6:7">na Amaria woo Ahitub.<verse eid="1CH 6:7"/></para>
  <para style="li2">
    <verse number="8" style="v" sid="1CH 6:8"/>Ahitub woo Sadok,</para>
  <para style="li2" vid="1CH 6:8">na Sadok woo Ahimaas.<verse eid="1CH 6:8"/></para>
  <para style="li2">
    <verse number="9" style="v" sid="1CH 6:9"/>Ahimaas woo Asaria.</para>
  <para style="li2" vid="1CH 6:9">Asaria woo Yohanan.<verse eid="1CH 6:9"/></para>
  <para style="li2">
    <verse number="10" style="v" sid="1CH 6:10"/>Yohanan woo Asaria a</para>
  <para style="li2" vid="1CH 6:10">ɔno na na ɔyɛ ɔsɔfopanyin wɔ asɔredan a Salomo sii wɔ Yerusalem no mu.<verse eid="1CH 6:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 6:11"/>Asaria woo Amaria.</para>
  <para style="li2" vid="1CH 6:11">Amaria woo Ahitub.<verse eid="1CH 6:11"/></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 6:12"/>Ahitub woo Sadok.</para>
  <para style="li2" vid="1CH 6:12">Sadok woo Salum.<verse eid="1CH 6:12"/></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 6:13"/>Salum woo Hilkia.</para>
  <para style="li2" vid="1CH 6:13">Hilkia woo Asaria.<verse eid="1CH 6:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 6:14"/>Asaria woo Seraia.</para>
  <para style="li2" vid="1CH 6:14">Seraia woo Yehosadak.<verse eid="1CH 6:14"/></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 6:15"/>Wotwaa Yehosadak asu bere a <char style="nd">Awurade</char> de Yudafo ne Yerusalemfo kɔɔ nnommum mu a na wɔhyɛ Nebukadnessar ase no.<verse eid="1CH 6:15"/></para>
  <para style="s1">Lewifo Mmusua</para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 6:16"/>Na Lewi mmabarima din de</para>
  <para style="li2" vid="1CH 6:16">Gersom, Kohat ne Merari.<verse eid="1CH 6:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 6:17"/>Na Libni ne Simei ka Gersom asefo ho.<verse eid="1CH 6:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 6:18"/>Na Amram, Ishar, Hebron ne Usiel</para>
  <para style="li2" vid="1CH 6:18">ka Kohat asefo no ho.<verse eid="1CH 6:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 6:19"/>Na Mahli ne Musi</para>
  <para style="li2" vid="1CH 6:19">ka Merari asefo no ho.</para>
  <para style="b" vid="1CH 6:19"/>
  <para style="li4" vid="1CH 6:19">Eyinom ne Lewifo mmusua sɛnea wɔn mpanyimfo nnidiso te.<verse eid="1CH 6:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 6:20"/>Na Gerson asefo yɛ:</para>
  <para style="li2" vid="1CH 6:20">Libni, Yahat,</para>
  <para style="li2" vid="1CH 6:20">Sima, <verse eid="1CH 6:20"/><verse number="21" style="v" sid="1CH 6:21"/>Yoa,</para>
  <para style="li2" vid="1CH 6:21">Ido, Serah</para>
  <para style="li2" vid="1CH 6:21">ne Yeaterai.<verse eid="1CH 6:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 6:22"/>Na Kohat asefo ne</para>
  <para style="li2" vid="1CH 6:22">Aminadab, Kora,</para>
  <para style="li2" vid="1CH 6:22">Asir, <verse eid="1CH 6:22"/><verse number="23" style="v" sid="1CH 6:23"/>Elkana,</para>
  <para style="li2" vid="1CH 6:23">Ebiasaf, Asir,<verse eid="1CH 6:23"/></para>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 6:24"/>Tahat, Uriel,</para>
  <para style="li2" vid="1CH 6:24">Usia ne Saulo.<verse eid="1CH 6:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 6:25"/>Na Elkana asefo ne:</para>
  <para style="li2" vid="1CH 6:25">Amasai, Ahimot,<verse eid="1CH 6:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 6:26"/>Sofai, Nahat,<verse eid="1CH 6:26"/></para>
  <para style="li2">
    <verse number="27" style="v" sid="1CH 6:27"/>Eliab,</para>
  <para style="li2" vid="1CH 6:27">Yeroham, Elkana ne Samuel.<verse eid="1CH 6:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 6:28"/>Na Samuel mmabarima din ne:</para>
  <para style="li2" vid="1CH 6:28">Yoel a ɔyɛ ɔpanyin</para>
  <para style="li2" vid="1CH 6:28">ne Abiya a ɔto so abien no.<verse eid="1CH 6:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 6:29"/>Na Merari mma ne:</para>
  <para style="li2" vid="1CH 6:29">Mahli, Libni,</para>
  <para style="li2" vid="1CH 6:29">Simei, Usa,<verse eid="1CH 6:29"/></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 6:30"/>Simea, Hagia</para>
  <para style="li2" vid="1CH 6:30">ne Asaia.<verse eid="1CH 6:30"/></para>
  <para style="s2">Asɔredan Mu Nnwom Ho Nimdefo</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31"/>Dawid maa saa nnipa a wɔn din didi so yi dii <char style="nd">Awurade</char> fi nnwom anim, bere a wɔde Apam Adaka no sii hɔ no. <verse eid="1CH 6:31"/><verse number="32" style="v" sid="1CH 6:32"/>Wɔde nnwom kaa wɔn som ho wɔ Ahyiae Ntamadan no mu hɔ kosii sɛ Salomo sii <char style="nd">Awurade</char> asɔredan no wɔ Yerusalem. Afei, wɔnam mmara a wɔde maa wɔn so dii wɔn dwuma wɔ hɔ.<verse eid="1CH 6:32"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="33" style="v" sid="1CH 6:33"/>Saa mmarima yi na wɔne wɔn mma som wɔ hɔ no.</para>
  <para style="b" vid="1CH 6:33"/>
  <para style="li1" vid="1CH 6:33">Heman, dwom ho nimdefo no, na ofi Kohat abusua mu.</para>
  <para style="li2" vid="1CH 6:33">Wɔto nʼabusua ana fi</para>
  <para style="li2" vid="1CH 6:33">Yoel, Samuel,<verse eid="1CH 6:33"/></para>
  <para style="li2">
    <verse number="34" style="v" sid="1CH 6:34"/>Elkana, Yeroham,</para>
  <para style="li2" vid="1CH 6:34">Eliel, Yoa,<verse eid="1CH 6:34"/></para>
  <para style="li2">
    <verse number="35" style="v" sid="1CH 6:35"/>Suf, Elkana,</para>
  <para style="li2" vid="1CH 6:35">Mahat, Amasai<verse eid="1CH 6:35"/></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 6:36"/>Elkana, Yoel,</para>
  <para style="li2" vid="1CH 6:36">Asaria, Sefania,<verse eid="1CH 6:36"/></para>
  <para style="li2">
    <verse number="37" style="v" sid="1CH 6:37"/>Tahat, Asir,</para>
  <para style="li2" vid="1CH 6:37">Ebiasaf, Kora,<verse eid="1CH 6:37"/></para>
  <para style="li2">
    <verse number="38" style="v" sid="1CH 6:38"/>Ishar, Kohat,</para>
  <para style="li2" vid="1CH 6:38">Lewi ne Israel ase.<verse eid="1CH 6:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 6:39"/>Herman abediakyiri a odi kan no din de Asaf, a na ofi Gerson abusua mu.</para>
  <para style="li2" vid="1CH 6:39">Wɔto Asaf abusua ana fi Berekia, Simea,<verse eid="1CH 6:39"/></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 6:40"/>Mikael, Baaseia,</para>
  <para style="li2" vid="1CH 6:40">Malkia, <verse eid="1CH 6:40"/><verse number="41" style="v" sid="1CH 6:41"/>Etni,</para>
  <para style="li2" vid="1CH 6:41">Serah, Adaia,<verse eid="1CH 6:41"/></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 6:42"/>Etan, Sima,</para>
  <para style="li2" vid="1CH 6:42">Simei, <verse eid="1CH 6:42"/><verse number="43" style="v" sid="1CH 6:43"/>Yahat, Gersom ne Lewi ase.<verse eid="1CH 6:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 6:44"/>Herman abediakyiri a ɔto so abien no din de Etan, a na ofi Merari abusua mu.</para>
  <para style="li2" vid="1CH 6:44">Wɔto Etan abusua ana fi Kisi, Abdi,</para>
  <para style="li2" vid="1CH 6:44">Maluk, <verse eid="1CH 6:44"/><verse number="45" style="v" sid="1CH 6:45"/>Hasabia,</para>
  <para style="li2" vid="1CH 6:45">Amasia, Hilkia,<verse eid="1CH 6:45"/></para>
  <para style="li2">
    <verse number="46" style="v" sid="1CH 6:46"/>Amsi, Bani, Semer, <verse eid="1CH 6:46"/><verse number="47" style="v" sid="1CH 6:47"/>Mahli,</para>
  <para style="li2" vid="1CH 6:47">Musi, Merari ne Lewi ase.<verse eid="1CH 6:47"/></para>
  <para style="s2">Aaron Asefo</para>
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48"/>Wɔmaa wɔn abusuafo a wɔyɛ Lewifo no nso dwuma ahorow bi dii wɔ Ahyiae Ntamadan a ɛyɛ Onyankopɔn fi no mu. <verse eid="1CH 6:48"/><verse number="49" style="v" sid="1CH 6:49"/>Aaron ne nʼasefo nko na wɔsom sɛ asɔfo. Na wɔde afɔrebɔde gu ɔhyew afɔremuka ne ohuam afɔremuka so, na wodi dwuma biara a ɛfa kronkron mu kronkron hɔ ho. Wɔnam mmara a Onyankopɔn somfo Mose de maa wɔn no so, yɛɛ mpata maa Israel.<verse eid="1CH 6:49"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 6:50"/>Na Aaron asefo yɛ:</para>
  <para style="li2" vid="1CH 6:50">Eleasar, Pinehas, Abisua, <verse eid="1CH 6:50"/><verse number="51" style="v" sid="1CH 6:51"/>Buki, Usi, Serahia,<verse eid="1CH 6:51"/></para>
  <para style="li2">
    <verse number="52" style="v" sid="1CH 6:52"/>Meraiot, Amaria, Ahitub, <verse eid="1CH 6:52"/><verse number="53" style="v" sid="1CH 6:53"/>Sadok ne Ahimaas.<verse eid="1CH 6:53"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="54" style="v" sid="1CH 6:54"/>Eyi ne abakɔsɛm a ɛfa nkurow ne asase a wɔnam ntontobɔ kronkron so de maa Aaron ne nʼasefo a wofi Kohat abusua mu no.<verse eid="1CH 6:54"/></para>
  <para style="li1">
    <verse number="55" style="v" sid="1CH 6:55"/>Na Hebron ne mmoa adidibea nsase a atwa ho ahyia wɔ Yuda no ka ho. <verse eid="1CH 6:55"/><verse number="56" style="v" sid="1CH 6:56"/>Nanso mfuw ne nkuraa a atwa ho ahyia no de, wɔde maa Yefune babarima Kaleb. <verse eid="1CH 6:56"/><verse number="57" style="v" sid="1CH 6:57"/>Enti saa nkurow yi a mmoa adidibea atwa biara ho ahyia na wɔde maa Aaron asefo: Hebron, a ɛyɛ guankɔbea kurow, Libna, Yatir, Estemoa, <verse eid="1CH 6:57"/><verse number="58" style="v" sid="1CH 6:58"/>Hilen, Debir, <verse eid="1CH 6:58"/><verse number="59" style="v" sid="1CH 6:59"/>Asan, Yuta ne Bet-Semes. <verse eid="1CH 6:59"/><verse number="60" style="v" sid="1CH 6:60"/>Na wɔmaa wɔn Gibeon, Geba, Alemet ne Anatot fii Benyamin asase mu a mmoa adidibea ka emu biara ho.</para>
  <para style="li4" vid="1CH 6:60">Enti nkurow dumiɛnsa na wɔde maa Aaron asefo.<verse eid="1CH 6:60"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="61" style="v" sid="1CH 6:61"/>Na Kohat asefo a wɔkae no nso, wonyaa nkurow du a wɔnam ntontobɔ kronkron so fii Manase abusua fa no asase so.<verse eid="1CH 6:61"/></para>
  <para style="li1">
    <verse number="62" style="v" sid="1CH 6:62"/>Gerson asefo nam ntontobɔ kronkron so nyaa nkurow dumiɛnsa fii Isakar, Aser ne Naftali nsase so. Wonyaa bi nso fii Basan pɔw mu a ɛyɛ Manase de, a ɛwɔ Yordan apuei fam no.<verse eid="1CH 6:62"/></para>
  <para style="li1">
    <verse number="63" style="v" sid="1CH 6:63"/>Merari asefo nam ntontobɔ kronkron so, nyaa nkurow dumien fii Ruben, Gad ne Sebulon nsase so.<verse eid="1CH 6:63"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="64" style="v" sid="1CH 6:64"/>Enti Israelfo de saa nkurow yi ne mmoa adidibea yi nyinaa maa Lewifo.<verse eid="1CH 6:64"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="65" style="v" sid="1CH 6:65"/>Wɔnam ntontobɔ kronkron so na wɔde nkurow a ɛwowɔ Yuda, Simeon ne Benyamin nsase so mae sɛnea wɔaka dedaw no.<verse eid="1CH 6:65"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="66" style="v" sid="1CH 6:66"/>Saa nkurow yi ne ɛho mmoa adidibea na Kohat asefo nya fii Efraim asase so:<verse eid="1CH 6:66"/></para>
  <para style="li1">
    <verse number="67" style="v" sid="1CH 6:67"/>Sekem (guankɔbea kurow) a ɛwɔ Efraim bepɔw asase no so, Geser, <verse eid="1CH 6:67"/><verse number="68" style="v" sid="1CH 6:68"/>Yokmeam, Bet-Horon, <verse eid="1CH 6:68"/><verse number="69" style="v" sid="1CH 6:69"/>Ayalon ne Gat-Rimon.<verse eid="1CH 6:69"/></para>
  <para style="li1">
    <verse number="70" style="v" sid="1CH 6:70"/>Kohat asefo nkae no, wɔde saa nkurow a efi Manase abusua fa no mu na ɛmaa wɔn: Aner ne Bileam a emu biara mmoa adidibea ka ho.<verse eid="1CH 6:70"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="71" style="v" sid="1CH 6:71"/>Gerson asefo nyaa kurow a wɔfrɛ no Golan a ɛwɔ Basan no fii Manase abusua fa asase so a Astarot ka ho, a ne nyinaa mmoa adidibea da ho.<verse eid="1CH 6:71"/></para>
  <para style="li1">
    <verse number="72" style="v" sid="1CH 6:72"/>Isakar asase so nso, wɔmaa wɔn Kedes, Daberat, <verse eid="1CH 6:72"/><verse number="73" style="v" sid="1CH 6:73"/>Ramot ne Anem a wɔn mmoa adidibea ka ho.<verse eid="1CH 6:73"/></para>
  <para style="li1">
    <verse number="74" style="v" sid="1CH 6:74"/>Aser asase so, wonyaa Masal, Abdon, <verse eid="1CH 6:74"/><verse number="75" style="v" sid="1CH 6:75"/>Hukok ne Rehob a na emu biara mmoa adidibea ka ho.<verse eid="1CH 6:75"/></para>
  <para style="li1">
    <verse number="76" style="v" sid="1CH 6:76"/>Naftali asase so, wɔde Kedes a ɛwɔ Galilea, Hamon ne Kiriataim maa wɔn, a na mmoa adidibea ka emu biara ho.<verse eid="1CH 6:76"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="77" style="v" sid="1CH 6:77"/>Merari asefo nkae no nyaa Yokneam, Karta, Rimon ne Tabor nkurow, fi Sebulon asase so, a na mmoa adidibea ka biara ho.<verse eid="1CH 6:77"/></para>
  <para style="li1">
    <verse number="78" style="v" sid="1CH 6:78"/>Ruben asase a ɛda Asubɔnten Yordan apuei fam a ɛne Yeriko di nhwɛanim no nso, wonyaa Beser a ɛyɛ nweatam kurow, Yahas, <verse eid="1CH 6:78"/><verse number="79" style="v" sid="1CH 6:79"/>Kedemot ne Mefaat a mmoa adidibea ka emu biara ho.<verse eid="1CH 6:79"/></para>
  <para style="li1">
    <verse number="80" style="v" sid="1CH 6:80"/>Na Gad asase so nso, wonyaa Ramot a ɛwɔ Gilead, Mahanaim, <verse eid="1CH 6:80"/><verse number="81" style="v" sid="1CH 6:81"/>Hesbon ne Yaser a mmoa adidibea ka biara ho.<verse eid="1CH 6:81"/></para>
  <chapter eid="1CH 6"/>
  <chapter number="7" style="c" sid="1CH 7"/>
  <para style="s1">Isakar Asefo</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 7:1"/>Na Isakar mmabarima baanan no din de</para>
  <para style="li2" vid="1CH 7:1">Tola, Pua, Yasub ne Simron.<verse eid="1CH 7:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 7:2"/>Tola mmabarima no ne:</para>
  <para style="li2" vid="1CH 7:2">Usi, Refaia, Yeriel, Yahmai, Yibsam ne Samuel. Na wɔn mu biara yɛ wɔn agyanom mmusua ntuanofo. Ɔhene Dawid bere so no, na mmarima dodow a wɔwɔ saa mmusua yi mu a wɔyɛ asraafo no dodow yɛ mpem aduonu abien ne ahansia (22,600).<verse eid="1CH 7:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 7:3"/>Na Usi babarima din de:</para>
  <para style="li2" vid="1CH 7:3">Yisrahia.</para>
  <para style="li1" vid="1CH 7:3">Na Yisrahia mmabarima din de:</para>
  <para style="li2" vid="1CH 7:3">Mikael, Obadia, Yoel ne Yisia a na wɔn baanum tuatua mmusua ano. <verse eid="1CH 7:3"/><verse number="4" style="v" sid="1CH 7:4"/>Mmarima dodow a na wɔwɔ hɔ a wɔyɛ asraafo no dodow yɛ mpem aduasa asia. Na wɔn baanum no nyinaa yerenom ne wɔn mmabarima yɛ bebree.<verse eid="1CH 7:4"/></para>
  <para style="li4">
    <verse number="5" style="v" sid="1CH 7:5"/>Mmarima a na wɔwɔ hɔ a wofi Isakar mmusua no nyinaa mu a wɔyɛ asraafo no dodow yɛ mpem aduɔwɔtwe ason (87,000). Wɔkyerɛw wɔn nyinaa din nnidiso nnidiso guu wɔn anato krataa mu.<verse eid="1CH 7:5"/></para>
  <para style="s1">Benyamin Asefo</para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 7:6"/>Na Benyamin mmabarima baasa no din de:</para>
  <para style="li2" vid="1CH 7:6">Bela. Beker ne Yediael.<verse eid="1CH 7:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 7:7"/>Na Bela mmabarima yɛ:</para>
  <para style="li2" vid="1CH 7:7">Esbon, Usi, Usiel, Yerimot ne Iri. Na saa akofo baanum yi yɛ mmusua ntuanofo. Nnipa a wofi wɔn asefo mu yɛɛ asraafo no dodow yɛ mpem aduonu abien ne aduasa anan (22,034). Wɔkyerɛw wɔn nyinaa din guu wɔn anato krataa mu.<verse eid="1CH 7:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 7:8"/>Na Beker mmabarima din de:</para>
  <para style="li2" vid="1CH 7:8">Semira, Yoas, Elieser, Elioenai, Omri, Yeremot, Abia, Anatot ne Alemet. <verse eid="1CH 7:8"/><verse number="9" style="v" sid="1CH 7:9"/>Sɛnea na wɔn anato kyerɛ no, na wɔn abusua ntuanofo akyi no, wɔn asefo mpem aduonu ne ahannu (20,200) wɔ hɔ a wotumi yɛ asraafo.<verse eid="1CH 7:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 7:10"/>Na Yediael babarima ne:</para>
  <para style="li2" vid="1CH 7:10">Bilhan.</para>
  <para style="li1" vid="1CH 7:10">Na Bilhan mmabarima ne:</para>
  <para style="li2" vid="1CH 7:10">Yeus, Benyamin, Ehud, Kenaana, Setan, Tarsis ne Ahisahar. <verse eid="1CH 7:10"/><verse number="11" style="v" sid="1CH 7:11"/>Na wɔyɛ Yediael mmusua no mu ntuanofo a wɔn asefo a na wɔka wɔn ho a wotumi yɛ asraafo no dodow yɛ mpem dunson ne ahannu (17,200).<verse eid="1CH 7:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 7:12"/>Na Ir mmabarima ne Supim, ne Hupim. Aher na ɔwoo Husim.<verse eid="1CH 7:12"/></para>
  <para style="s1">Naftali Asefo</para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 7:13"/>Na Naftali mmabarima yɛ:</para>
  <para style="li2" vid="1CH 7:13">Yahsiel, Guni, Yeser ne Silum. Na wɔn nyinaa yɛ Yakob yere Bilha asefo.<verse eid="1CH 7:13"/></para>
  <para style="s1">Manase Asefo</para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 7:14"/>Manase mmabarima a ɔne ne mpena Aramni wowoo wɔn ne Asriel ne Makir. Makir na ɔwoo Gilead. <verse eid="1CH 7:14"/><verse number="15" style="v" sid="1CH 7:15"/>Makir pɛɛ ɔyerenom maa Hupim ne Supim. Na wɔfrɛ Makir nuabea se Maaka. Na Makir asefo no mu baako a wɔfrɛ no Selofehad wowoo mmabea nko ara. <verse eid="1CH 7:15"/><verse number="16" style="v" sid="1CH 7:16"/>Makir yere Maaka woo ɔbabarima a ɔtoo no din Peres. Na ne nuabarima din de Seres. Peres mmabarima din de Ulam ne Rekem.<verse eid="1CH 7:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 7:17"/>Na Ulam babarima din de:</para>
  <para style="li2" vid="1CH 7:17">Bedan.</para>
  <para style="li1" vid="1CH 7:17">Na wɔn nyinaa yɛ Gileadfo a wɔyɛ Manase babarima Makir asefo.<verse eid="1CH 7:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 7:18"/>Makir nuabea Moleket woo Is-Hod, Abieser ne Mahla.<verse eid="1CH 7:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 7:19"/>Na Semida mmabarima yɛ:</para>
  <para style="li2" vid="1CH 7:19">Ahian, Sekem, Likhi ne Aniam.<verse eid="1CH 7:19"/></para>
  <para style="s1">Efraim Asefo</para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 7:20"/>Efraim asefo ne:</para>
  <para style="li2" vid="1CH 7:20">Sutela, Bered, Tahat, Elada,</para>
  <para style="li2" vid="1CH 7:20">Tahat, <verse eid="1CH 7:20"/><verse number="21" style="v" sid="1CH 7:21"/>Sabad ne Sutela.</para>
  <para style="li2" vid="1CH 7:21">Wokunkum Efraim mmabarima Eser ne Elad wɔ Gat, efisɛ wɔpɛe sɛ wowia nyɛmmoa fi akuafo a wɔbɛn hɔ no. <verse eid="1CH 7:21"/><verse number="22" style="v" sid="1CH 7:22"/>Wɔn agya Efraim suu wɔn kyɛe yiye, na nʼabusuafo bɛkyekyee ne werɛ. <verse eid="1CH 7:22"/><verse number="23" style="v" sid="1CH 7:23"/>Ɛno akyi no, Efraim kɔɔ ne yere ho, na onyinsɛn woo ɔbabarima. Efraim too no din Beria esiane abɛbrɛsɛ a nʼabusuafo faa mu no nti. <verse eid="1CH 7:23"/><verse number="24" style="v" sid="1CH 7:24"/>Efraim woo ɔbabea too no din Seer. Ɔno na ɔkyekyeree nkurow Bet-Horon Anafo, Atifi ne Usen-Seera.<verse eid="1CH 7:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 7:25"/>Efraim asefo nnidiso ne Refa, Resef, Tela, Tahan,<verse eid="1CH 7:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 7:26"/>Ladan, Amihud, Elisama, <verse eid="1CH 7:26"/><verse number="27" style="v" sid="1CH 7:27"/>Nun ne Yosua.<verse eid="1CH 7:27"/></para>
  <para style="li4">
    <verse number="28" style="v" sid="1CH 7:28"/>Efraim asefo no tenaa asase Bet-El ne ne nkurow a atwa afa anafo fam, Naaran a ɛda apuei fam, Geser ne ne nkuraa a ɛda atɔe fam ne Sekem ne ne nkuraa a atwa ho ahyia, kɔfa atifi fam, de kosi Aya a nkuraa ka ho no so. <verse eid="1CH 7:28"/><verse number="29" style="v" sid="1CH 7:29"/>Manase hye so no, na nkurow a ɛdeda hɔ yɛ Bet-Sean, Taanak, Megido, Dor ne wɔn nkuraa a atwa ho ahyia no. Israel ba Yosef asefo tenaa saa nkurow yi so.<verse eid="1CH 7:29"/></para>
  <para style="s1">Aser Asefo</para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 7:30"/>Na Aser mmabarima yɛ:</para>
  <para style="li2" vid="1CH 7:30">Yimna, Yiswa, Yiswi ne Beria. Na wɔwɔ onuabea a ne din de Sera.<verse eid="1CH 7:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 7:31"/>Na Beria mmabarima din de:</para>
  <para style="li2" vid="1CH 7:31">Heber ne Malkiel a ɔwoo Birsait no.<verse eid="1CH 7:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 7:32"/>Na Heber mmabarima din de Yaflet, Somer ne Hotam. Na wɔwɔ onuabea a ne din de Sua.<verse eid="1CH 7:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 7:33"/>Na Yaflet mmabarima din de:</para>
  <para style="li2" vid="1CH 7:33">Pasak, Bimhal ne Aswat.<verse eid="1CH 7:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 7:34"/>Na Semer mmabarima din de:</para>
  <para style="li2" vid="1CH 7:34">Ahi, Rohga, Hubah ne Aram.<verse eid="1CH 7:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 7:35"/>Na ne nuabarima Helem mmabarima din de:</para>
  <para style="li2" vid="1CH 7:35">Sofa, Yimna, Seles ne Amal.<verse eid="1CH 7:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 7:36"/>Na Sofa mmabarima din de:</para>
  <para style="li2" vid="1CH 7:36">Suah, Harnefer, Sual, Beri, Yimra, <verse eid="1CH 7:36"/><verse number="37" style="v" sid="1CH 7:37"/>Beser, Hod, Sama, Silsa, Yitran ne Beera.<verse eid="1CH 7:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 7:38"/>Na Yeter mmabarima din de:</para>
  <para style="li2" vid="1CH 7:38">Yefune, Pispa ne Ara.<verse eid="1CH 7:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 7:39"/>Na Ula mmabarima din de:</para>
  <para style="li2" vid="1CH 7:39">Arah, Haniel ne Risia.<verse eid="1CH 7:39"/></para>
  <para style="li4">
    <verse number="40" style="v" sid="1CH 7:40"/>Na Aser asefo no mu biara yɛ wɔn agyanom abusua panyin. Na wɔn nyinaa yɛ akofo pa ne ntuanofo a wodi mu. Na mmarima mpem aduonu asia (26,000) na wɔwɔ hɔ a wɔakyerɛw wɔn din agu wɔn anato nhoma mu a wotumi yɛ asraafo.<verse eid="1CH 7:40"/></para>
  <chapter eid="1CH 7"/>
  <chapter number="8" style="c" sid="1CH 8"/>
  <para style="s1">Benyamin Asefo</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 8:1"/>Benyamin mmabarima na wodidi so yi:</para>
  <para style="li2" vid="1CH 8:1">Bela (abakan), Asbel, Ahra,<verse eid="1CH 8:1"/></para>
  <para style="li2">
    <verse number="2" style="v" sid="1CH 8:2"/>Noha ne Rafha.<verse eid="1CH 8:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 8:3"/>Bela mmabarima yɛ:</para>
  <para style="li2" vid="1CH 8:3">Adar, Gera, Abihud, <verse eid="1CH 8:3"/><verse number="4" style="v" sid="1CH 8:4"/>Abisua, Naaman, Ahoa, <verse eid="1CH 8:4"/><verse number="5" style="v" sid="1CH 8:5"/>Gera, Sefufan ne Huram.<verse eid="1CH 8:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 8:6"/>Ehud mmabarima mmusua ntuanofo a na wɔte Geba na wɔpam wɔn fii hɔ kɔɔ Manahat:<verse eid="1CH 8:6"/></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 8:7"/>Ehud mmabarima ne Naaman, Ahiya ne Gera. Gera a na ɔyɛ Usa ne Ahihud agya no na bere a wɔretu no odii wɔn anim.<verse eid="1CH 8:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 8:8"/>Saharaim gyaee ne yerenom Husim ne Baara akyi no, ɔwoo mma wɔ Moab asase so. <verse eid="1CH 8:8"/><verse number="9" style="v" sid="1CH 8:9"/>Ne yere foforo Hodes woo Yobab, Sibia, Mesa, Malkam, <verse eid="1CH 8:9"/><verse number="10" style="v" sid="1CH 8:10"/>Yeus, Sakia ne Mirma. Saa mmabarima yi bɛyɛɛ mmusua ntuanofo. <verse eid="1CH 8:10"/><verse number="11" style="v" sid="1CH 8:11"/>Na Saharaim yere Husim awo Abitub ne Elpaal dedaw.<verse eid="1CH 8:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 8:12"/>Elpaal mmabarima yɛ:</para>
  <para style="li2" vid="1CH 8:12">Eber, Misam ne Semed a ɔkyekyeree Ono ne Lod ne wɔn nkuraa no, <verse eid="1CH 8:12"/><verse number="13" style="v" sid="1CH 8:13"/>Beria ne Sema. Na wɔyɛ mmusua ntuanofo a na wɔte Ayalon, na wɔpam ɔmanfo a wɔte Gat no.<verse eid="1CH 8:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 8:14"/>Beria mmabarima yɛ Ahio, Sasak, Yeremot, <verse eid="1CH 8:14"/><verse number="15" style="v" sid="1CH 8:15"/>Sebadia, Arad, Eder, <verse eid="1CH 8:15"/><verse number="16" style="v" sid="1CH 8:16"/>Mikael, Yispa ne Yoha.<verse eid="1CH 8:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 8:17"/>Elpaal mmabarima yɛ Sebadia, Mesulam, Hiski, Heber, <verse eid="1CH 8:17"/><verse number="18" style="v" sid="1CH 8:18"/>Ismerai, Yislia ne Yobab.<verse eid="1CH 8:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 8:19"/>Simei mmabarima yɛ Yakim, Sikri, Sabdi, <verse eid="1CH 8:19"/><verse number="20" style="v" sid="1CH 8:20"/>Elienai, Siletai, Eliel, <verse eid="1CH 8:20"/><verse number="21" style="v" sid="1CH 8:21"/>Adaia, Beraia ne Simrat.<verse eid="1CH 8:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 8:22"/>Sasak mmabarima yɛ Yispan, Eber, Eliel, <verse eid="1CH 8:22"/><verse number="23" style="v" sid="1CH 8:23"/>Abdon, Sikri, Hanan, <verse eid="1CH 8:23"/><verse number="24" style="v" sid="1CH 8:24"/>Hanania, Elam, Antotia, <verse eid="1CH 8:24"/><verse number="25" style="v" sid="1CH 8:25"/>Yifdeia ne Penuel.<verse eid="1CH 8:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 8:26"/>Yeroham mmabarima yɛ Samserai, Seharia, Atalia, <verse eid="1CH 8:26"/><verse number="27" style="v" sid="1CH 8:27"/>Yaaresia, Elia ne Sikri.<verse eid="1CH 8:27"/></para>
  <para style="li4">
    <verse number="28" style="v" sid="1CH 8:28"/>Eyinom ne agyanom mmusua ntuanofo a wɔakyerɛw wɔn din wɔ wɔn mu biara anato nkrataa mu. Na wɔn nyinaa tenaa Yerusalem.<verse eid="1CH 8:28"/></para>
  <para style="s1">Saulo Abusua</para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 8:29"/>Yeiel (Gibeon agya) tenaa Gibeon. Na ne yere din de Maaka <verse eid="1CH 8:29"/><verse number="30" style="v" sid="1CH 8:30"/>a na ne babarima abakan din de Abdon. Na Yeiel mmabarima a wɔaka no din de Sur, Kis, Baal, Ner, Nadab, <verse eid="1CH 8:30"/><verse number="31" style="v" sid="1CH 8:31"/>Gedor, Ahio, Seker, <verse eid="1CH 8:31"/><verse number="32" style="v" sid="1CH 8:32"/>ne Miklot a ɔyɛ Simea agya. Na saa abusuafo yi tete bemmɛn wɔn ho wɔn ho wɔ Yerusalem.<verse eid="1CH 8:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 8:33"/>Ner na ɔwoo Kis. Kis na ɔwoo Saulo, Saulo na ɔwoo Yonatan, Malki-Sua, Abinadab ne Esbaal.<verse eid="1CH 8:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 8:34"/>Yonatan babarima ne:</para>
  <para style="li2" vid="1CH 8:34">Merib-Baal (anaa Mefiboset) na Merib-Baal woo Mika.<verse eid="1CH 8:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 8:35"/>Mika mmabarima ne:</para>
  <para style="li2" vid="1CH 8:35">Piton, Melek, Tarea ne Ahas.<verse eid="1CH 8:35"/></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 8:36"/>Ahas woo Yehoada na Yehoada woo Alemet, Asmawet ne Simri. Na Simri woo Mosa. <verse eid="1CH 8:36"/><verse number="37" style="v" sid="1CH 8:37"/>Mosa woo Binea. Binea woo Rafha. Rafha woo Elasa. Elasa woo Asel.<verse eid="1CH 8:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 8:38"/>Asel woo mmabarima baasia a wɔne:</para>
  <para style="li2" vid="1CH 8:38">Asrikam, Bokeru, Ismael, Searia, Obadia ne Hanan. Na eyinom yɛ Asel mma.<verse eid="1CH 8:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 8:39"/>Na Asel nuabarima Esek wɔ mmabarima baasa a wɔne</para>
  <para style="li2" vid="1CH 8:39">Ulam a ɔyɛ abakan, Yeus a ɔto so abien ne Elifelet a ɔto so abiɛsa. <verse eid="1CH 8:39"/><verse number="40" style="v" sid="1CH 8:40"/>Ulam mmabarima nyinaa yɛ akofo a wɔakwadaw akodi mu, wɔyɛ agyantowfo antoamfom. Na wɔwɔ mma ne nananom bebree a na wɔn nyinaa dodow yɛ ɔha aduonum.</para>
  <para style="li1" vid="1CH 8:40">Eyinom nyinaa yɛ Benyamin asefo.<verse eid="1CH 8:40"/></para>
  <para style="b"/>
  <chapter eid="1CH 8"/>
  <chapter number="9" style="c" sid="1CH 9"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1"/>Wɔkyerɛw Israel anato biara mu nnipa din guu Israel ne Yuda Ahemfo nhoma mu. Esiane sɛ na Yudafo no nni <char style="nd">Awurade</char> nokware no nti, wotwaa wɔn asu kɔɔ Babilonia.<verse eid="1CH 9:1"/></para>
  <para style="s1">Atukɔfo A Wɔsan Bae</para>
  <para style="li4">
    <verse number="2" style="v" sid="1CH 9:2"/>Wɔn a wɔsan ba bɛfaa wɔn agyapade wɔ wɔn nkurow dedaw mu no yɛ mpapahwekwa. Wɔne asɔfo, Lewifo ne asɔredan mu aboafo no bi na wɔbae.<verse eid="1CH 9:2"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="3" style="v" sid="1CH 9:3"/>Nnipa a wofi Yuda, Benyamin, Efraim ne Manase mmusuakuw mu ba bɛtenaa Yerusalem.<verse eid="1CH 9:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 9:4"/>Abusua baako a wɔsan bae no yɛ Amihud babarima Utai a ɔyɛ Omri babarima na ɔno nso yɛ Imri babarima na ɔno nso yɛ Bani babarima a wɔyɛ Yuda babarima Peres asefo.<verse eid="1CH 9:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 9:5"/>Wɔn a wɔsan bae a na wofi Silonfo abusua mu no yɛ:</para>
  <para style="li2" vid="1CH 9:5">Asaia a ɔyɛ abakan no ne ne mmabarima.<verse eid="1CH 9:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 9:6"/>Serah abusua mu no:</para>
  <para style="li2" vid="1CH 9:6">Yeuel ne nʼabusuafo na wɔsan bae.</para>
  <para style="li4" vid="1CH 9:6">Yuda abusuakuw no mu mmusua ahansia aduɔkron (960) na wɔsan bae.<verse eid="1CH 9:6"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="7" style="v" sid="1CH 9:7"/>Wɔn a wofi Benyamin abusuakuw mu a wɔsan bae no ne:</para>
  <para style="li1" vid="1CH 9:7">Mesulam babarima Salu, a ɔyɛ Hodawia babarima na ɔno nso yɛ Hasenua babarima;<verse eid="1CH 9:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 9:8"/>Yibneia a ɔyɛ Yeroham babarima, Ela a ɔyɛ Usi babarima, Mikri babarima; Mesulam a ɔyɛ Sefatia babarima, Reuel babarima, Yibnia babarima bae.<verse eid="1CH 9:8"/></para>
  <para style="li4">
    <verse number="9" style="v" sid="1CH 9:9"/>Saa mmarima yi nyinaa, na wɔyɛ mmusua ntuanofo, na wɔakyerɛw wɔn din wɔ wɔn mmusuakuw anato nhoma mu. Benyamin abusuakuw mu mmusua ahankron ne aduonum asia na wɔsan bae.<verse eid="1CH 9:9"/></para>
  <para style="s1">Asɔfo A Wɔsan Bae</para>
  <para style="li4">
    <verse number="10" style="v" sid="1CH 9:10"/>Asɔfo a wɔsan bae no bi ne:</para>
  <para style="li1" vid="1CH 9:10">Yedaia, Yehoriarib, Yakin,<verse eid="1CH 9:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 9:11"/>Asaria a ɔyɛ Hilkia babarima a ɔno nso yɛ Mesulam babarima na ɔno nso yɛ Sadok babarima na ɔno nso yɛ Meraiot babarima na ɔno nso yɛ Ahitub babarima. Na Asaria yɛ Onyankopɔn fi ahwɛfo so panyin.<verse eid="1CH 9:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 9:12"/>Asɔfo a wɔsan bae no bi ne Adaia a ɔyɛ Yeroham babarima a na ɔno nso yɛ Pashur babarima na ɔno nso yɛ Malkia babarima ne Masai a ɔyɛ Adiel babarima na ɔno nso yɛ Yahsera babarima na ɔno nso yɛ Mesulam babarima a ɔno nso yɛ Mesilemit babarima na ɔno nso yɛ Imer babarima.<verse eid="1CH 9:12"/></para>
  <para style="li4">
    <verse number="13" style="v" sid="1CH 9:13"/>Asɔfo a wɔsan bae nyinaa dodow yɛ apem ahanson aduosia. Na wɔyɛ mmusua ntuanofo a wɔyɛ nsiyɛfo. Na wɔn adwuma ne sɛ, wɔsom wɔ Onyankopɔn fi.<verse eid="1CH 9:13"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="14" style="v" sid="1CH 9:14"/>Lewifo a wɔsan bae no yɛ:</para>
  <para style="li1" vid="1CH 9:14">Semaia a ɔyɛ Hasub babarima a na ɔyɛ Asrikam babarima a na ɔno nso yɛ Hasabia babarima a na ɔyɛ Merari aseni,<verse eid="1CH 9:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 9:15"/>Bakbakar, Heres, Galal, Mika babarima Matania a ɔyɛ Sikri babarima na ɔno nso yɛ Asaf babarima,<verse eid="1CH 9:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 9:16"/>Obadia a ɔyɛ Semaia babarima a ɔyɛ Galal babarima na ɔno nso yɛ Yedutun babarima ne Asa a ɔyɛ Elkana babarima Berekia a wɔtenaa Netofa asase so.<verse eid="1CH 9:16"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="17" style="v" sid="1CH 9:17"/>Apon ano hwɛfo a wɔsan bae no yɛ:</para>
  <para style="li1" vid="1CH 9:17">Salum, Akub, Talmon, Ahiman ne wɔn abusuafo. Salum na na ɔyɛ ɔpon ano hwɛfo panyin. <verse eid="1CH 9:17"/><verse number="18" style="v" sid="1CH 9:18"/>Kan no nso, na anka wɔn na wɔhwɛ ɔhene pon a ɛkyerɛ apuei fam no so. Na saa mmarima no som sɛ Lewifo atenae apon ano ahwɛfo.<verse eid="1CH 9:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 9:19"/>Na Salum yɛ Kore babarima a ɔyɛ Ebiasaf a ofi Kora abusua mu aseni. Na ɔne nʼabusuafo a wɔyɛ Korafo no na na wɔwɛn ɔkwan a ɛkɔ kronkronbea hɔ no, sɛnea na wɔn mpanyimfo wɛn Ahyiae Ntamadan wɔ <char style="nd">Awurade</char> atenae hɔ no.<verse eid="1CH 9:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 9:20"/>Eleasar babarima Pinehas na kan no na ɔhwɛ apon ano ahwɛfo no so, na <char style="nd">Awurade</char> ka ne ho.<verse eid="1CH 9:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 9:21"/>Akyiri no, Meselemia babarima Sakaria na na ɔwɛn ɔkwan a ɛkɔ Ahyiae Ntamadan no mu no ano.<verse eid="1CH 9:21"/></para>
  <para style="li4">
    <verse number="22" style="v" sid="1CH 9:22"/>Ne nyinaa mu, saa bere no, na apon ano ahwɛfo no dodow yɛ ahannu ne dumien (212) a na wɔakyerɛw wɔn din wɔ wɔn anato nkrataa mu wɔ wɔn nkuraa.</para>
  <para style="b" vid="1CH 9:22"/>
  <para style="p" vid="1CH 9:22">Dawid ne Samuel a na ɔyɛ ɔdehufo no ama wɔn dibea a ɛsom bo. <verse eid="1CH 9:22"/><verse number="23" style="v" sid="1CH 9:23"/>Saa apon ano ahwɛfo yi ne wɔn asefo no, na wɔkyekyɛ wɔn mu kɔwɛn ɔkwan a ɛkɔ <char style="nd">Awurade</char> fi, a kan no na ɛyɛ ntamadan no ano. <verse eid="1CH 9:23"/><verse number="24" style="v" sid="1CH 9:24"/>Wɔde apon ano ahwɛfo no gyinagyinaa afanan no nyinaa a ɛyɛ apuei, atɔe, atifi ne anafo. <verse eid="1CH 9:24"/><verse number="25" style="v" sid="1CH 9:25"/>Bere ano bere ano, na wɔn abusuafo a wɔwɔ nkuraa no bɛboa wɔn wɔ wɔn nnanson nnanson dwumadi mu. <verse eid="1CH 9:25"/><verse number="26" style="v" sid="1CH 9:26"/>Na saa Lewifo apon ano ahwɛfo mpanyimfo baanan no adwuma no yɛ nea ekura asodi kɛse, efisɛ wɔn na na wɔhwɛ adan ne sikakoradan a ɛwɔ Onyankopɔn fi hɔ no so. <verse eid="1CH 9:26"/><verse number="27" style="v" sid="1CH 9:27"/>Wɔwɛn Onyankopɔn fi hɔ anadwo, efisɛ na ɛyɛ wɔn asɛde. Afei, na ɛyɛ wɔn adwuma sɛ da biara anɔpa wobuebue apon no.<verse eid="1CH 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28"/>Na apon ano ahwɛfo no bi adwuma ne sɛ, wɔhwɛ nneɛma ahorow a wɔde yɛ ɔsom adwuma no so. Sɛ wɔrekɔfa, na wɔresan de akogu hɔ no nyinaa, wɔhwɛ sɛ bi renyera. <verse eid="1CH 9:28"/><verse number="29" style="v" sid="1CH 9:29"/>Afoforo nso hwɛ nneɛma a wɔde asiesie hɔ, nneɛma a ɛwɔ kronkronbea hɔ, nneɛma a wɔde brɛ wɔn, sɛ ebia, asikresiam a wɔayam no muhumuhu, nsa, ngo, nnuhuam ne kurobow ahorow so. <verse eid="1CH 9:29"/><verse number="30" style="v" sid="1CH 9:30"/>Nanso na asɔfo no na wodi nnuhuam no ne kurobow no ho dwuma. <verse eid="1CH 9:30"/><verse number="31" style="v" sid="1CH 9:31"/>Lewini a wɔfrɛ no Matitia a ɔyɛ Korani Salum abakan no na na ɔto brodo a wɔde bɔ afɔre no. <verse eid="1CH 9:31"/><verse number="32" style="v" sid="1CH 9:32"/>Na nnipa bi a wofi Kohat abusua mu nso na na wɔhwɛ, siesie brodo a wɔde to pon Homeda no.<verse eid="1CH 9:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33"/>Nnwom ho nimdefo a na wɔn nso yɛ Lewifo atitiriw no nyinaa, na wɔtete Asɔredan no mu. Na wɔmma wɔnnyɛ dwuma foforo biara, esiane wɔn adwuma a wɔyɛ no mmere nyinaa nti.<verse eid="1CH 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34"/>Na saa nnipa yi nyinaa tete Yerusalem. Na wɔyɛ Lewifo mmusua no nyinaa ntuanofo a wɔakyerɛw wɔn din ahyɛ wɔn anato krataa mu.<verse eid="1CH 9:34"/></para>
  <para style="s1">Ɔhene Saulo Anato</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 9:35"/>Yeiel (Gibeon agya) tenaa Gibeon.</para>
  <para style="li2" vid="1CH 9:35">Na ne yere din de Maaka, <verse eid="1CH 9:35"/><verse number="36" style="v" sid="1CH 9:36"/>a na ne babarima abakan din de Abdon. Na Yeiel mmabarima a wɔaka no din de Sur, Kis, Baal, Ner, Nadab, <verse eid="1CH 9:36"/><verse number="37" style="v" sid="1CH 9:37"/>Gedor, Ahio, Sakaria ne Miklot. <verse eid="1CH 9:37"/><verse number="38" style="v" sid="1CH 9:38"/>Miklot na ɔyɛ Simeam agya. Na saa abusuafo yi tete bemmɛn wɔn ho wɔn ho wɔ Yerusalem.<verse eid="1CH 9:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 9:39"/>Ner na ɔwoo Kis. Kis na ɔwoo Saulo, Saulo na ɔwoo Yonatan, Malki-Sua, Abinadab ne Esbaal.<verse eid="1CH 9:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 9:40"/>Yonatan babarima ne:</para>
  <para style="li2" vid="1CH 9:40">Merib-Baal (anaa Mefiboset) na Merib-Baal woo Mika.<verse eid="1CH 9:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 9:41"/>Mika mmabarima ne:</para>
  <para style="li2" vid="1CH 9:41">Piton, Melek, Tarea ne Ahas.<verse eid="1CH 9:41"/></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 9:42"/>Ahas woo Yara.</para>
  <para style="li2" vid="1CH 9:42">Yara woo Alemet, Asmawet ne Simri.</para>
  <para style="li2" vid="1CH 9:42">Na Simri woo Mosa. <verse eid="1CH 9:42"/><verse number="43" style="v" sid="1CH 9:43"/>Mosa woo Binea.</para>
  <para style="li1" vid="1CH 9:43">Binea woo Refaia.</para>
  <para style="li1" vid="1CH 9:43">Refaia woo Elasa.</para>
  <para style="li1" vid="1CH 9:43">Elasa woo Asel.<verse eid="1CH 9:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 9:44"/>Asel woo mmabarima baasia a wɔne:</para>
  <para style="li2" vid="1CH 9:44">Asrikam, Bokeru, Ismael, Searia, Obadia ne Hanan. Na eyinom yɛ Asel mma.<verse eid="1CH 9:44"/></para>
  <chapter eid="1CH 9"/>
  <chapter number="10" style="c" sid="1CH 10"/>
  <para style="s1">Ɔhene Saulo Wu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1"/>Afei, Filistifo no bɛtow hyɛɛ Israel so, maa Israelfo no guanee. Wokunkum wɔn mu pii wɔ bepɔw Gilboa so. <verse eid="1CH 10:1"/><verse number="2" style="v" sid="1CH 10:2"/>Filistifo no kaa Saulo ne ne mmabarima hyɛe. Wokunkum wɔn mu baasa a wɔne Yonatan, Abinadab ne Malki-Sua. <verse eid="1CH 10:2"/><verse number="3" style="v" sid="1CH 10:3"/>Ɔko no ano yɛɛ den twaa Saulo ho hyiae, maa Filistifo agyantowfo no nyaa Saulo piraa no yiye.<verse eid="1CH 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 10:4"/>Saulo fi apinisi mu ka kyerɛɛ nʼakodekurafo no se, “Twe wʼafoa, fa wɔ me kum me na Filistifo abosonsomfo yi ammɛto me, angu mʼanim ase.”</para>
  <para style="p" vid="1CH 10:4">Nanso na nʼakodekurafo no suro nti, wanyɛ saa. Enti Saulo twee ɔno ara nʼafoa, de kum ne ho. <verse eid="1CH 10:4"/><verse number="5" style="v" sid="1CH 10:5"/>Bere a nʼakodekurafo no huu sɛ Saulo awu no, ɔno nso de nʼafoa kum ne ho. <verse eid="1CH 10:5"/><verse number="6" style="v" sid="1CH 10:6"/>Ɛno nti, Saulo ne ne mma mmarima baasa no wuwuu hɔ ara, maa nʼahenni nnidiso no baa awiei.<verse eid="1CH 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7"/>Bere a Israelfo a wɔwɔ Yesreel bon no mu no huu sɛ wɔadi wɔn asraafo no so, na Saulo ne ne mmabarima baasa no awuwu no, woguan gyaa wɔn nkurow hɔ. Ɛno nti, Filistifo no kɔfaa wɔn nkurow no.<verse eid="1CH 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8"/>Ade kyee a Filistifo no kɔɔ sɛ wɔrekoyiyi atɔfo no ho nneɛma no, wohuu sɛ Saulo ne ne mmabarima no amu gugu bepɔw Gilboa so. <verse eid="1CH 10:8"/><verse number="9" style="v" sid="1CH 10:9"/>Enti woyiyii Saulo akode fii ne ho, twaa ne ti. Afei wɔbɔɔ Saulo wu no ho dawuru maa wɔn ahoni ne nnipa a wɔwɔ Filistia nyinaa tee. <verse eid="1CH 10:9"/><verse number="10" style="v" sid="1CH 10:10"/>Wɔde nʼakode no guu wɔn anyame no abosonnan mu, na wɔkyekyeree ne ti no fam Dagon asɔredan no fasu ho.<verse eid="1CH 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11"/>Nanso Yabes Gileadfo tee nea Filistifo ayɛ Saulo no, <verse eid="1CH 10:11"/><verse number="12" style="v" sid="1CH 10:12"/>wɔn akofo kɔfaa Saulo ne ne mmabarima baasa no amu baa Yabes. Na wosiee wɔn amu wɔ odum dua bi a ɛwɔ Yabes ase, na wodii mmuada nnanson.<verse eid="1CH 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13"/>Na Saulo wui, efisɛ wanni Awurade nokware. Wanni <char style="nd">Awurade</char> ahyɛde so, na mpo, ɔkɔɔ asamanfrɛ <verse eid="1CH 10:13"/><verse number="14" style="v" sid="1CH 10:14"/>wɔ bere a anka ɛsɛ sɛ obisa <char style="nd">Awurade</char> nkyɛn akwankyerɛ. Ɛno nti, <char style="nd">Awurade</char> kum no, de nʼahenni hyɛɛ Yisai babarima Dawid nsa.<verse eid="1CH 10:14"/></para>
  <chapter eid="1CH 10"/>
  <chapter number="11" style="c" sid="1CH 11"/>
  <para style="s1">Dawid Di Israel Nyinaa So Hene</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1"/>Na Israel nyinaa kɔɔ Dawid nkyɛn wɔ Hebron kɔka kyerɛɛ no se, “Yɛn nyinaa yɛ wʼabusuafo. <verse eid="1CH 11:1"/><verse number="2" style="v" sid="1CH 11:2"/>Mmere tenten bi a atwa mu, mpo bere a Saulo di yɛn so hene no, na wone obi a nokware na wudi Israel anim. Na <char style="nd">Awurade</char>, wo Nyankopɔn, aka kyerɛ wo se, ‘Wobɛyɛ oguanhwɛfo ama me nkurɔfo Israel. Wobɛyɛ wɔn sodifo!’ ”<verse eid="1CH 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3"/>Enti Hebron hɔ, Dawid ne Israel ntuanofo yɛɛ apam wɔ <char style="nd">Awurade</char> anim. Wɔsraa no ngo, sii no Israelhene sɛnea <char style="nd">Awurade</char> nam Samuel so hyɛɛ ho bɔ no.<verse eid="1CH 11:3"/></para>
  <para style="s1">Dawid Ko Fa Yerusalem</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4"/>Na Dawid ne Israel nyinaa kɔɔ Yerusalem anaa Yebus, sɛnea na wɔfrɛ hɔ kan no, efisɛ Yebusifo na wɔkɔtenaa asase no so kan kyekyeree. <verse eid="1CH 11:4"/><verse number="5" style="v" sid="1CH 11:5"/>Nnipa a wofi Yebus no ka kyerɛɛ Dawid se, “Worentumi mma ha da biara da.” Nanso Dawid faa aban a na ɛwɔ Sion a wɔfrɛ no Dawid Kurow no.<verse eid="1CH 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 11:6"/>Dawid ka kyerɛɛ nʼakofo no se, “Mo mu biara a obedi anim na yɛakɔtow ahyɛ Yebusifo no so no na ɔbɛyɛ mʼakofo so sahene.” Na Dawid, nuabea Seruia babarima Yoab dii ɔko no anim, nti ɔbɛyɛɛ Dawid asraafo so sahene.<verse eid="1CH 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 11:7"/>Dawid tenaa aban no mu, na ɛno nti na wɔfrɛɛ hɔ Dawid kurow no. <verse eid="1CH 11:7"/><verse number="8" style="v" sid="1CH 11:8"/>Dawid kyekyeree kurow no, trɛw mu fi Milo de twaa ho hyiae, bere a na Yoab nso rekyekyere Yerusalem nkae no. <verse eid="1CH 11:8"/><verse number="9" style="v" sid="1CH 11:9"/>Na Dawid tumi yɛɛ kɛse, efisɛ na Asafo <char style="nd">Awurade</char> ka ne ho.<verse eid="1CH 11:9"/></para>
  <para style="s1">Dawid Dɔmmarima</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10"/>Eyinom ne Dawid dɔmmarima ntuanofo. Wɔne Israel nyinaa bɔɔ mu, sii gyinae sɛ wɔde Dawid bɛyɛ wɔn so hene sɛnea <char style="nd">Awurade</char> ahyɛ bɔ afa Israel ho no. <verse eid="1CH 11:10"/><verse number="11" style="v" sid="1CH 11:11"/>Dawid dɔmmarima no ho nsɛm ni: Nea odi kan no ne Yasobeam a ɔyɛ Hakmonini a na ɔda Baasa no ano sɛ ɔsahene—Baasa no yɛ dɔmmarima akatakyi a na wɔwɔ Dawid asraafo mu. Bere bi ɔde ne peaw kunkum atamfo ahaasa wɔ akodi baako mu.<verse eid="1CH 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12"/>Nea ɔto so abien wɔ Baasa no mu no yɛ Dodo babarima Eleasar a ɔyɛ Ahoa aseni. <verse eid="1CH 11:12"/><verse number="13" style="v" sid="1CH 11:13"/>Bere a Dawid sɔre tiaa Filistifo wɔ Pas-Damim no, na ɔka ne ho. Ɔko no sii wɔ baabi a na ɛyɛ atokofuw nko, na Israel asraafo no guanee. <verse eid="1CH 11:13"/><verse number="14" style="v" sid="1CH 11:14"/>Nanso Eleasar ne Dawid gyinaa wɔn anan so wɔ afuw no mfimfini, bɔɔ Filistifo no gui. Na <char style="nd">Awurade</char> ma wodii nkonim de gyee wɔn.<verse eid="1CH 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15"/>Da bi a Dawid wɔ ɔbotan bi a ɛbɛn Adulam ɔbodan ho no, na Filistifo asraafo akyere nsraban wɔ Refaim bon mu. Baasa no a na wɔka Aduasa no a wonim de wɔ Dawid asraafo mu no sian kohyiaa no wɔ hɔ. <verse eid="1CH 11:15"/><verse number="16" style="v" sid="1CH 11:16"/>Saa bere no na Dawid te ɔko ahintawee mu hɔ a na Filistifo asraafokuw bi akɔtena Betlehem. <verse eid="1CH 11:16"/><verse number="17" style="v" sid="1CH 11:17"/>Dawid fi akɔnnɔ mu kae se, “Ao me kɔn dɔ nsu pa a ɛwɔ abura a ɛwɔ Betlehem no bi; nea ɛbɛn ɔpon ano no bi.” <verse eid="1CH 11:17"/><verse number="18" style="v" sid="1CH 11:18"/>Enti Baasa no bɔ wuraa Filistifo no mu, kɔsaw abura no mu nsu no bi de brɛɛ Dawid. Nanso Dawid annom. Mmom, ohwie guu <char style="nd">Awurade</char> anim <verse eid="1CH 11:18"/><verse number="19" style="v" sid="1CH 11:19"/>teɛɛ mu se, “Ɛmpare me sɛ mɛnom saa nsu yi. Ɛsom bo sɛ saa mmarima yi a wɔde wɔn ho bɔɔ afɔre kɔsaw brɛɛ me no mogya.” Enti Dawid annom. Eyi yɛ Baasa no mmaninsɛm no bi nhwɛso.<verse eid="1CH 11:19"/></para>
  <para style="s1">Dawid Dɔmmarima Aduasa No</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20"/>Yoab nuabarima Abisai na na otua Aduasa no ano. Ɔko baako bi mu no, ɔde ne peaw kunkum atamfo no mu ahaasa. Saa mmaninsɛm yi nti na ogyee din sɛ Baasa no. <verse eid="1CH 11:20"/><verse number="21" style="v" sid="1CH 11:21"/>Abisai na na ne din ahyeta yiye wɔ Aduasa no mu sɛ wɔn sahene, nso na ɔnka Baasa no ho.<verse eid="1CH 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22"/>Na Yehoiada babarima Benaia a ofi Kabseel no nso wɔ hɔ. Na ɔno nso di mmarimasɛm. Ɔyɛɛ bebree a emu baako ne sɛ okunkum Moab akofo akɛse baanu bi. Bere foforo bi nso, ɔtaa gyata maa aboa no kɔtɔɔ amoa mu. Na sukyerɛmma ama fam ayɛ toro nanso ɔkyeree gyata no kum no. <verse eid="1CH 11:22"/><verse number="23" style="v" sid="1CH 11:23"/>Da bi a na okura kontibaa nko ara no, okum Misraimni ɔkofo bi a na ne tenten yɛ anammɔn ason ne fa. Na ne peaw no mu pipiripi te sɛ ntamanwemfo nsadua. Benaia huam peaw no fii Misraimni no nsam, de kum no. <verse eid="1CH 11:23"/><verse number="24" style="v" sid="1CH 11:24"/>Eyinom na Yehoiada babarima Benaia yɛe, ma ogyee din te sɛ Baasa no. <verse eid="1CH 11:24"/><verse number="25" style="v" sid="1CH 11:25"/>Wɔhyɛɛ no anuonyam sen nkae a wɔka Aduasa no ho no, nso na ɔmfra Baasa no mu. Na Dawid yɛɛ no ne ho awɛmfo no so sahene.<verse eid="1CH 11:25"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="26" style="v" sid="1CH 11:26"/>Nnipa a na wɔka Dawid dɔmmarima no ho ni:</para>
  <para style="b" vid="1CH 11:26"/>
  <para style="li1" vid="1CH 11:26">Yoab nuabarima Asahel;</para>
  <para style="li1" vid="1CH 11:26">Dodo babarima Elhanan a ofi Betlehem;<verse eid="1CH 11:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 11:27"/>Samot a ofi Harori;</para>
  <para style="li1" vid="1CH 11:27">Heles a ofi Pelon;<verse eid="1CH 11:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 11:28"/>Ikes babarima Ira a ofi Tekoa;</para>
  <para style="li1" vid="1CH 11:28">Abieser a ofi Anatot;<verse eid="1CH 11:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 11:29"/>Sibekai a ofi Husa;</para>
  <para style="li1" vid="1CH 11:29">Salmon a ofi Ahoa;<verse eid="1CH 11:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 11:30"/>Maharai a ofi Netofa;</para>
  <para style="li1" vid="1CH 11:30">Baana a ofi Netofa babarima Heled;<verse eid="1CH 11:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 11:31"/>Ribai a ofi Gibea babarima Itai (wofi Benyamin abusuakuw mu); Benaia a ofi Piraton;<verse eid="1CH 11:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 11:32"/>Hurai a ofi baabi a ɛbɛn Nahale-Gaas;</para>
  <para style="li1" vid="1CH 11:32">Abiel a ofi Araba.<verse eid="1CH 11:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 11:33"/>Asmawet a ofi Baharum;</para>
  <para style="li1" vid="1CH 11:33">Eliahba a ofi Saalbon.<verse eid="1CH 11:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 11:34"/>Hasem mmabarima a wofi Gison;</para>
  <para style="li1" vid="1CH 11:34">Sage babarima Yonatan a ofi Harar.<verse eid="1CH 11:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 11:35"/>Sakar babarima Ahiam a ofi Harar;</para>
  <para style="li1" vid="1CH 11:35">Ur babarima Elifar.<verse eid="1CH 11:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 11:36"/>Hefer a ofi Mekera;</para>
  <para style="li1" vid="1CH 11:36">Ahiya a ofi Pelon.<verse eid="1CH 11:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 11:37"/>Hesro a ofi Karmel;</para>
  <para style="li1" vid="1CH 11:37">Esbai babarima Naarai.<verse eid="1CH 11:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 11:38"/>Natan nuabarima Yoel;</para>
  <para style="li1" vid="1CH 11:38">Hagri babarima Mibhar.<verse eid="1CH 11:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 11:39"/>Selek a ofi Amon;</para>
  <para style="li1" vid="1CH 11:39">Naharai a ofi Beerot (a na ɔyɛ Yoab akodekurafo);<verse eid="1CH 11:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 11:40"/>Ira a ofi Yitri;</para>
  <para style="li1" vid="1CH 11:40">Gareb a ofi Yitri;<verse eid="1CH 11:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 11:41"/>Hetini Uria;</para>
  <para style="li1" vid="1CH 11:41">Ahlai babarima Sabad;<verse eid="1CH 11:41"/></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 11:42"/>Sisa babarima Adina a na ɔda Rubenfo ano, a na mmarima aduasa ka ne ho;<verse eid="1CH 11:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 11:43"/>Maaka babarima Hanan;</para>
  <para style="li1" vid="1CH 11:43">Yosafat a ofi Mitna;<verse eid="1CH 11:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 11:44"/>Usia a ofi Astera;</para>
  <para style="li1" vid="1CH 11:44">Hotam a ofi Aroer mmabarima Sama ne Yeiel;<verse eid="1CH 11:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 11:45"/>Simri babarima Yediael;</para>
  <para style="li1" vid="1CH 11:45">Yoha ne nuabarima a ofi Tis;<verse eid="1CH 11:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 11:46"/>Eliel a ofi Mahawi;</para>
  <para style="li1" vid="1CH 11:46">Elnaam mmabarima Yeribai ne Yosawia;</para>
  <para style="li1" vid="1CH 11:46">Yitma a ofi Moab;<verse eid="1CH 11:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 11:47"/>Eliel ne Obed;</para>
  <para style="li1" vid="1CH 11:47">Yaasiel a ofi Soba.<verse eid="1CH 11:47"/></para>
  <chapter eid="1CH 11"/>
  <chapter number="12" style="c" sid="1CH 12"/>
  <para style="s1">Dɔmmarima Kɔka Dawid Asraafodɔm Ho</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 12:1"/>Bere a Dawid guan fii Kis babarima Saulo anim kohintaw wɔ Siklag no, saa mmarima yi kɔdɔm no. Na wɔka dɔmmarima a wɔboa Dawid wɔ akodi mu no ho. <verse eid="1CH 12:1"/><verse number="2" style="v" sid="1CH 12:2"/>Na wɔn nyinaa yɛ agyantowfo antoamfomfo. Na wotumi de wɔn nsa benkum ne nifa nyinaa tow agyan ne ahwimmo. Na wɔn nyinaa yɛ Saulo abusuafo a wofi Benyamin abusuakuw mu.<verse eid="1CH 12:2"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 12:3"/>Na nea otua wɔn ano yɛ Semaia a ofi Gibea no babarima Ahieser. Na ne nuabarima ne Yoas a ɔyɛ nʼabediakyiri. Eyinom ne dɔmmarima no nkae:</para>
  <para style="li1" vid="1CH 12:3">Asmawet mmabarima Yesiel ne Pelet;</para>
  <para style="li1" vid="1CH 12:3">Beraka ne Yehu a wofi Anatot; <verse eid="1CH 12:3"/><verse number="4" style="v" sid="1CH 12:4"/>Ismaia a ofi Gibeon, ɔkofo kɛse ne ntuanoni wɔ Aduasa no mu;</para>
  <para style="li1" vid="1CH 12:4">Yeremia, Yahasiel, Yohanan ne Yosabad a wofi Gedera; <verse eid="1CH 12:4"/><verse number="5" style="v" sid="1CH 12:5"/>Elusai, Yerimot, Bealia, Semaria, ne Sefatia a ofi Harif;<verse eid="1CH 12:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 12:6"/>Elkana, Yesia, Asarel, Yoeser, Yasobeam a wɔyɛ Korafo;<verse eid="1CH 12:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 12:7"/>Yoela, Sebadia, Yeroham mmabarima a wofi Gedor.<verse eid="1CH 12:7"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8"/>Gadfo akofo akokodurufo bi a wɔakwadaw akodi mu guan kɔɔ Dawid afa bere a na ɔwɔ aguaabɔ mu wɔ sare so no. Na wɔyɛ nimdefo wɔ nkatabo ne peaw akodi mu a wɔn ho yɛ hu sɛ gyata, na wɔn ho yɛ hare te sɛ mmepɔw so atwe.<verse eid="1CH 12:8"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 12:9"/>Eser na na otua wɔn ano.</para>
  <para style="li1" vid="1CH 12:9">Obadia yɛ abediakyiri.</para>
  <para style="li1" vid="1CH 12:9">Eliab na ɔto so abiɛsa.<verse eid="1CH 12:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 12:10"/>Nea ɔto so anan ne Mismana.</para>
  <para style="li1" vid="1CH 12:10">Nea ɔto so anum ne Yeremia.<verse eid="1CH 12:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 12:11"/>Atai to so asia, Eliel to so ason.<verse eid="1CH 12:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 12:12"/>Yohanan to so awotwe, Elsabad to so akron.<verse eid="1CH 12:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 12:13"/>Yeremia to so du, Makbanai to so dubaako.<verse eid="1CH 12:13"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14"/>Saa dɔmmarima a wofi Gad yi yɛ asahene. Nea ɔnyɛ den koraa no, otumi ne asraafo ɔha ko, na nea ɔyɛ den no tumi ne asraafo apem ko. <verse eid="1CH 12:14"/><verse number="15" style="v" sid="1CH 12:15"/>Afe no mfiase a Asubɔnten Yordan ayiri no, wotwa kɔpam nnipa a wɔtete tataw so wɔ nʼapuei ne nʼatɔe konkɔn so nyinaa fii hɔ.<verse eid="1CH 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16"/>Afoforo a wofi Benyamin ne Yuda no baa Dawid nkyɛn wɔ hintabea hɔ. <verse eid="1CH 12:16"/><verse number="17" style="v" sid="1CH 12:17"/>Dawid kohyiaa wɔn kae se, “Sɛ moaba asomdwoe so sɛ morebɛboa me a, yɛyɛ nnamfo. Na sɛ moaba sɛ morebeyi me ama mʼatamfo wɔ bere a menyɛɛ bɔne bi a, yɛn agyanom Nyankopɔn nhwɛ mmu mo atɛn.”<verse eid="1CH 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18"/>Na honhom no sii Amasai a akyiri no ɔbɛyɛɛ Aduasa no so panyin no so, na ɔkae se,</para>
  <para style="q1" vid="1CH 12:18">“Yɛyɛ wo dea, Dawid!</para>
  <para style="q2" vid="1CH 12:18">Yɛwɔ wʼafa, Yisai ba;</para>
  <para style="q1" vid="1CH 12:18">Asomdwoe ne nkɔso nyɛ wo kyɛfa</para>
  <para style="q2" vid="1CH 12:18">na wʼaboafo nyinaa nya nkɔso,</para>
  <para style="q3" vid="1CH 12:18">efisɛ wo Nyankopɔn ne nea ɔboa wo.”</para>
  <para style="p" vid="1CH 12:18">Enti Dawid ma wɔbɛkaa ne ho, na ɔyɛɛ wɔn mpanyimfo wɔ nʼakofo mu.<verse eid="1CH 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19"/>Manase mmarima no bi tew wɔn ho kɔdɔm Dawid, bere a na ɔne Filistifo no rekɔko atia Saulo no. Nanso asɛm no ani dan a Filistifo ntuanofo ampene so sɛ Dawid ne ne mmarima no bɛka wɔn ho akɔ. Wodwinnwen ho ara no, wɔma wɔsan wɔn akyi kae se, “Sɛ Dawid dan nʼani kɔ Saulo afa de tia yɛn a, yɛn nkwa na yɛde betwa so.” <verse eid="1CH 12:19"/><verse number="20" style="v" sid="1CH 12:20"/>Manase mmarima a wɔtew wɔn ho kɔɔ Dawid afa, bere a na ɔresan akɔ Siklag no ne Adna, Yosabad, Yediael, Mikael, Yosabad, Elihu ne Siletai. Na wɔn mu biara da asraafo apem ano. <verse eid="1CH 12:20"/><verse number="21" style="v" sid="1CH 12:21"/>Wɔboaa Dawid ma ɔtaa afowfo no, efisɛ na wɔyɛ akokodurufo ne akofo akɛse a wɔbɛyɛɛ asahene wɔ nʼakofo mu. <verse eid="1CH 12:21"/><verse number="22" style="v" sid="1CH 12:22"/>Adekyee biara, mmarima bebree kɔdɔm Dawid kosii sɛ onyaa asraafodɔm a ɛso te sɛ Onyankopɔn de.<verse eid="1CH 12:22"/></para>
  <para style="li4">
    <verse number="23" style="v" sid="1CH 12:23"/>Eyinom ne akofo akɛse dodow a wɔdɔm Dawid wɔ Hebron no. Na wɔn nyinaa pɛ sɛ Dawid si Saulo anan mu di hene, sɛnea <char style="nd">Awurade</char> ahyɛ ato hɔ no.<verse eid="1CH 12:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 12:24"/>Akofo akɛse a wofi Yuda abusuakuw mu no, na wɔn dodow yɛ mpem asia ne ahanwɔtwe a wokurakura nkatabo ne mpeaw.<verse eid="1CH 12:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 12:25"/>Akofo akɛse a wofi Simeon abusuakuw mu no, na wɔn dodow yɛ mpem ason ne ɔha.<verse eid="1CH 12:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 12:26"/>Asraafo a na wofi Lewi abusuakuw mu no, na wɔn dodow yɛ mpem anan ne ahansia. <verse eid="1CH 12:26"/><verse number="27" style="v" sid="1CH 12:27"/>Na Yehoiada a otua Aaron abusua no ano no wɔ asraafo mpem abiɛsa ne ahanson a wɔhyɛ nʼase. <verse eid="1CH 12:27"/><verse number="28" style="v" sid="1CH 12:28"/>Saa ara nso na na Sadok, ɔbabun ɔkofo kɛse ne nʼabusuafo aduonu abien a wɔn nyinaa yɛ asraafo mpanyimfo ka ho.<verse eid="1CH 12:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 12:29"/>Akofo akɛse a wofi Benyamin abusuakuw mu a wɔyɛ Saulo abusuafo no, na wɔn dodow yɛ mpem abiɛsa (3,000). Na Benyaminfo no mu fa kɛse no taa Saulo akyi ara.<verse eid="1CH 12:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 12:30"/>Akofo akɛse a wofi Efraim abusuakuw mu no, na wɔn dodow yɛ mpem aduonu ne ahanwɔtwe (20,800) a wɔn mu biara agye din wɔ nʼabusua mu.<verse eid="1CH 12:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 12:31"/>Manase abusuakuw fa a na ɛwɔ Yordan atɔe fam no nso, wotuu mmarima mpem dunwɔtwe (18,000) a wɔn botae ara ne sɛ wɔbɛboaa Dawid ma wadi hene.<verse eid="1CH 12:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 12:32"/>Ntuanofo a wofi Isakar abusuakuw mu ne wɔn abusuafo dodow yɛ ahannu. Na saa mmarima yi nyinaa te nsɛm a ɛrekɔ so saa bere no ase, na wonim ɔkwan pa a eye ma Israel nso.<verse eid="1CH 12:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 12:33"/>Akofo a wɔakwadaw akodi mu a wofi Sebulon abusuakuw mu no, na wɔn dodow yɛ mpem aduonum (50,000). Na wɔakɔ amia mu ayɛ krado ama akodi, na na wɔtaa Dawid akyi pintinn.<verse eid="1CH 12:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 12:34"/>Wɔn a wofi Naftali abusuakuw mu no yɛ asraafo mpanyimfo apem (1,000) ne akofo akɛse mpem aduasa ason (37,000) a wokurakura nkatabo ne mpeaw.<verse eid="1CH 12:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 12:35"/>Akofo a wofi Dan abusuakuw mu no, na wɔn dodow yɛ mpem aduonu awotwe ne ahansia (28,600) a wɔasiesie wɔn ho ama ɔko.<verse eid="1CH 12:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 12:36"/>Akofo akɛse a wɔatetew wɔn yiye a wofi Aser abusuakuw mu no, na wɔn dodow yɛ mpem aduanan (40,000) a wɔn nyinaa ayɛ krado ama ɔko.<verse eid="1CH 12:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 12:37"/>Ruben, Gad mmusuakuw ne Manase abusuakuw fa a na wɔtete Asubɔnten Yordan apuei fam no maa asraafo mpem ɔha ne aduonu (120,000) a wɔwɔ akode ahorow nyinaa.<verse eid="1CH 12:37"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="38" style="v" sid="1CH 12:38"/>Saa asraafo yi nyinaa kɔɔ amia mu na wɔkɔɔ Hebron a wɔn botae ara ne sɛ wɔde Dawid bɛyɛ Israelhene.</para>
  <para style="b" vid="1CH 12:38"/>
  <para style="p" vid="1CH 12:38">Nokware, Israel nyinaa adwene kɔɔ bɛnkorɔ mu sɛ, ɛsɛ sɛ Dawid na ɔyɛ wɔn hene. <verse eid="1CH 12:38"/><verse number="39" style="v" sid="1CH 12:39"/>Wɔne Dawid didi nomee nnansa, efisɛ na wɔn abusuafo no ayɛ ahoboa rehwɛ wɔn kwan. <verse eid="1CH 12:39"/><verse number="40" style="v" sid="1CH 12:40"/>Nnipa bi a wofi akyiri te sɛ Isakar, Sebulon, ne Naftali de nnuan tenaa wɔn mfurum, yoma ne anantwi so bae. Wɔde asikresiam, ɔfam, ɛhyɛ, nsa, ngo, anantwi ne nguan bebree baa afahyɛ no ase. Anigye a enni kabea baa Israel asase so.<verse eid="1CH 12:40"/></para>
  <chapter eid="1CH 12"/>
  <chapter number="13" style="c" sid="1CH 13"/>
  <para style="s1">Dawid Pɛ Sɛ Ɔkɔfa Apam Adaka No</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1"/>Dawid ne ne mpanyimfo a nʼasraafo so asahene ne mmapɔmma nyinaa ka ho, tuu agyina. <verse eid="1CH 13:1"/><verse number="2" style="v" sid="1CH 13:2"/>Na ɔkasa kyerɛɛ Israelfo a wɔahyia hɔ no nyinaa se, “Sɛ mopene so na sɛ ɛyɛ <char style="nd">Awurade</char> yɛn Nyankopɔn pɛ a, momma yɛmfa nkra nkɔma Israelfo a wɔwɔ ɔman no afanan nyinaa a asɔfo ne Lewifo a wɔwɔ nkurow so ne adidibea ka ho. Momma yɛnto nsa mfrɛ wɔn, na wɔmmɛka yɛn ho. <verse eid="1CH 13:2"/><verse number="3" style="v" sid="1CH 13:3"/>Bere adu sɛ yɛsan de yɛn Nyankopɔn Apam Adaka no ba, efisɛ Saulo ahenni bere so no, yɛampɛ anhwɛ.” <verse eid="1CH 13:3"/><verse number="4" style="v" sid="1CH 13:4"/>Bagua no penee saa asɛm yi so efisɛ wohuu sɛ, wɔyɛ saa a, eye.<verse eid="1CH 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5"/>Enti Dawid frɛɛ nnipa a wɔwɔ Israel nyinaa, efi ɔman no ti kosi ti, sɛ wɔmmɛka ne ho na wɔmfa Onyankopɔn Apam Adaka no mfi Kiriat-Yearim mmra. <verse eid="1CH 13:5"/><verse number="6" style="v" sid="1CH 13:6"/>Afei, Dawid ne Israelfo no nyinaa kɔɔ Baala a na wɔfrɛ no Kiriat-Yearim a ɛwɔ Yuda no sɛ wɔrekɔfa Onyankopɔn Apam Adaka a wɔde ahyɛ kerubim ntam na <char style="nd">Awurade</char> din da so no aba.<verse eid="1CH 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 13:7"/>Wɔde Onyankopɔn Apam Adaka no sii teaseɛnam foforo so de fii Abinadab fi a Usa ne Ahio rekyerɛ kwan. <verse eid="1CH 13:7"/><verse number="8" style="v" sid="1CH 13:8"/>Dawid ne Israelfo nyinaa fii wɔn ahoɔden mu too nnwom, bɔɔ mmɛn ahorow a bi yɛ asanku, mmɛnta, akasae, nnawuru ne ntorobɛnto dii ahurusi, Onyankopɔn anim.<verse eid="1CH 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9"/>Nanso woduu Nakon awiporowbea no, anantwi no anan toto maa Usa teɛɛ ne nsa sɛ ɔreteɛ Apam Adaka no. <verse eid="1CH 13:9"/><verse number="10" style="v" sid="1CH 13:10"/>Ɛhɔ na <char style="nd">Awurade</char> abufuw sɔre tiaa Usa ma owui, efisɛ ɔde ne nsa aka Apam Adaka no. Enti Usa wuu wɔ Onyankopɔn anim hɔ ara.<verse eid="1CH 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11"/>Dawid bo fuwii, efisɛ <char style="nd">Awurade</char> abufuw atia Usa. Ɔtoo beae hɔ din Peres-Usa a wɔda so frɛ hɔ saa de besi nnɛ.<verse eid="1CH 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 13:12"/>Afei, na Dawid suro Onyankopɔn, na obisae se, “Ɛbɛyɛ dɛn na matumi de Onyankopɔn Apam Adaka yi aba abɛhwɛ so?” <verse eid="1CH 13:12"/><verse number="13" style="v" sid="1CH 13:13"/>Enti Dawid yɛɛ nʼadwene sɛ ɔnna mmfa Apam Adaka no nkɔ Dawid kurow no mu. Mmom, ɔde kɔɔ Gatni, Obed-Edom fi wɔ Gat. <verse eid="1CH 13:13"/><verse number="14" style="v" sid="1CH 13:14"/>Onyankopɔn Apam Adaka no sii Obed-Edom abusuafo nkyɛn asram abiɛsa. Na <char style="nd">Awurade</char> hyiraa no ne ne fifo nyinaa.<verse eid="1CH 13:14"/></para>
  <chapter eid="1CH 13"/>
  <chapter number="14" style="c" sid="1CH 14"/>
  <para style="s1">Dawid Ahemfi Ne Nʼabusua</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1"/>Afei, Tirohene Huram somaa abɔfo ne abo adansifo ne nnua dwumfo kɔɔ Dawid nkyɛn sɛ, wonkosi ahemfi mma no. Afei, Huram san de sida nnua a wɔbɛpae kɔe. <verse eid="1CH 14:1"/><verse number="2" style="v" sid="1CH 14:2"/>Na Dawid huu sɛ <char style="nd">Awurade</char> de no asi Israel so hene, na esiane Israel nti, wayɛ nʼahenni kɛse.<verse eid="1CH 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3"/>Afei, Dawid waree mmea bebree wɔ Yerusalem, na ɔwowoo mmabarima ne mmabea bebree. <verse eid="1CH 14:3"/><verse number="4" style="v" sid="1CH 14:4"/>Dawid mmabarima a wɔwoo wɔn wɔ Yerusalem no ne Samua, Sobab, Natan ne Salomo, <verse eid="1CH 14:4"/><verse number="5" style="v" sid="1CH 14:5"/>Yibhar, Elisua, ne Elpelet, <verse eid="1CH 14:5"/><verse number="6" style="v" sid="1CH 14:6"/>Noga, Nefeg ne Yafia, <verse eid="1CH 14:6"/><verse number="7" style="v" sid="1CH 14:7"/>Elisama, Beeliada ne Elifelet.<verse eid="1CH 14:7"/></para>
  <para style="s1">Dawid Di Filistifo So Nkonim</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8"/>Bere a Filistifo tee sɛ wɔasra Dawid ngo ama wadi Israel nyinaa so hene no, wɔboaboaa wɔn asraafo nyinaa ano sɛ, wɔrebɛkyere no. Na wɔka kyerɛɛ Dawid se wɔreba ne so, enti ɔno nso ne ne mmarima fii kurow no mu kohyiaa wɔn. <verse eid="1CH 14:8"/><verse number="9" style="v" sid="1CH 14:9"/>Na Filistifo no abedu Refaim bon asɛe hɔ pasaa. <verse eid="1CH 14:9"/><verse number="10" style="v" sid="1CH 14:10"/>Enti Dawid bisaa Onyankopɔn se, “Mimpue na me ne Filistifo no nkɔko? Wode wɔn bɛhyɛ me nsa ana?”</para>
  <para style="p" vid="1CH 14:10">
    <char style="nd">Awurade</char> buae se, “Yiw, wo ne wɔn nkɔko, na mɛma woadi wɔn so nkonim.”<verse eid="1CH 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11"/>Enti Dawid ne nʼakofo kɔɔ Baal-Perasim kodii Filistifo no so wɔ hɔ. Dawid teɛɛ mu se, “Onyankopɔn ayɛ! Ɔnam me so ama mabɔ awura mʼatamfo mu te sɛ, nsuyiri a ano yɛ den.” Enti, wɔtoo beae hɔ din Baal-Perasim (a nkyerɛase ne sɛ “Awurade a ɔbɔ wura mu”). <verse eid="1CH 14:11"/><verse number="12" style="v" sid="1CH 14:12"/>Filistifo no gyaw wɔn ahoni nyinaa hɔ nti, Dawid hyɛ ma wɔhyew ne nyinaa.<verse eid="1CH 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13"/>Nanso ankyɛ biara, Filistifo no san baa obon no mu bio bɛsɛee hɔ. <verse eid="1CH 14:13"/><verse number="14" style="v" sid="1CH 14:14"/>Dawid bisaa Onyankopɔn nea ɔnyɛ bio. Onyankopɔn buae se, “Nkɔ tee nkɔtow nhyɛ wɔn so. Mmom, fa wɔn ho kosi wɔn akyi na montow nhyɛ wɔn so wɔ baabi a ɛbɛn baka nnua no. <verse eid="1CH 14:14"/><verse number="15" style="v" sid="1CH 14:15"/>Na sɛ mote nnyigye bi te sɛ nnipa bi a wɔrebɔ nsra anan ase wɔ baka nnua no atifi a, montow nhyɛ wɔn so. Ɛno na ɛbɛyɛ nsɛnkyerɛnne a ɛkyerɛ sɛ, Onyankopɔn adi mo anim rekɔka Filistifo no agu.” <verse eid="1CH 14:15"/><verse number="16" style="v" sid="1CH 14:16"/>Enti Dawid yɛɛ nea Onyankopɔn hyɛɛ no sɛ ɔnyɛ no, na ɔkaa Filistifo asraafo no guu fi Gibeon de kosii Geser.<verse eid="1CH 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 14:17"/>Na Dawid din hyetaa baabiara, na <char style="nd">Awurade</char> maa aman no nyinaa suroo Dawid.<verse eid="1CH 14:17"/></para>
  <chapter eid="1CH 14"/>
  <chapter number="15" style="c" sid="1CH 15"/>
  <para style="s1">Wɔde Apam Adaka No Ba Yerusalem</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1"/>Afei, Dawid sisii adan bebree wɔ Dawid kurom. Bio, osiesiee baabi, sii ntamadan wɔ hɔ a ɔde Onyankopɔn Apam Adaka no besi. <verse eid="1CH 15:1"/><verse number="2" style="v" sid="1CH 15:2"/>Afei, ɔhyɛɛ se, “Sɛ yɛma Onyankopɔn Apam Adaka no so de rekɔ a, obiara nni ho kwan sɛ ɔsoa bi gye Lewifo no nko ara. <char style="nd">Awurade</char> ayi wɔn sɛ, wɔn nko ara na ɛsɛ sɛ wɔsoa <char style="nd">Awurade</char> Apam Adaka no na wɔsom wɔ nʼanim daa daa.”<verse eid="1CH 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 15:3"/>Dawid frɛɛ Israelfo nyinaa kɔɔ Yerusalem sɛ wɔmfa Apam Adaka no nkosi faako a wɔasiesie ama no no.<verse eid="1CH 15:3"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="4" style="v" sid="1CH 15:4"/>Eyinom ne asɔfo ne Lewifo a wɔfrɛɛ wɔn no:<verse eid="1CH 15:4"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 15:5"/>Wɔn a wofi Kohat abusua mu no, na wɔn dodow yɛ ɔha aduonu a Uriel tua wɔn ano.<verse eid="1CH 15:5"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 15:6"/>Wɔn a wofi Merari abusua mu no, na wɔn dodow yɛ ahannu aduonu (220), a Asaia da wɔn ano.<verse eid="1CH 15:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 15:7"/>Wɔn a wofi Gersom abusua mu no, na wɔn dodow yɛ ɔha aduasa (130), a Yoel da wɔn ano.<verse eid="1CH 15:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 15:8"/>Na Elisafan asefo yɛ ahannu (200) a Semaia da wɔn ano.<verse eid="1CH 15:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 15:9"/>Na Hebron asefo yɛ aduɔwɔtwe (80) a Eliel tua wɔn ano.<verse eid="1CH 15:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 15:10"/>Na Usiel asefo yɛ ɔha ne dumien (112) a Aminadab tua wɔn ano.<verse eid="1CH 15:10"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11"/>Afei, Dawid frɛɛ asɔfo Sadok ne Abiatar ne saa Lewifo mpanyimfo yi: Uriel, Asaia, Yoel, Semaia, Eliel ne Aminadab. <verse eid="1CH 15:11"/><verse number="12" style="v" sid="1CH 15:12"/>Ɔka kyerɛɛ wɔn se, “Mo na moyɛ Lewifo mmusua mu ntuanofo. Mo ne Lewifo a wɔka mo ho nyinaa nnwira mo ho, sɛnea ɛbɛyɛ a mubetumi de <char style="nd">Awurade</char>, Israel Nyankopɔn, Apam Adaka no bɛba beae a masiesie ama no no. <verse eid="1CH 15:12"/><verse number="13" style="v" sid="1CH 15:13"/>Esiane sɛ kan no mo Lewifo ansoa Apam Adaka no nti, <char style="nd">Awurade</char>, yɛn Nyankopɔn, abufuw sɔre tiaa yɛn. Yɛammisa Onyankopɔn ɔkwan pa a ɛsɛ sɛ yɛfa so soa.” <verse eid="1CH 15:13"/><verse number="14" style="v" sid="1CH 15:14"/>Enti asɔfo no ne Lewifo no dwiraa wɔn ho, sɛnea ɛbɛyɛ a wobetumi de <char style="nd">Awurade</char>, Israel Nyankopɔn Apam Adaka no akɔ Yerusalem. <verse eid="1CH 15:14"/><verse number="15" style="v" sid="1CH 15:15"/>Na Lewifo no soaa Onyankopɔn Apam Adaka no wɔ wɔn mmati so a, nnua a wɔde soa no hyehyɛ ho pɛpɛɛpɛ, sɛnea Mose hyɛɛ wɔn no.<verse eid="1CH 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16"/>Dawid hyɛɛ Lewifo mpanyimfo no nso sɛ wɔntew Lewifo nnwontofo kuw, wɔn a wonim nnwonto, ne wɔn a wɔwɔ nnwonto ho nimdeɛ na wɔmfa mmɛnta, mmɛn, asankuten ne kyɛnkyɛn mmɛto anigye nnwom.<verse eid="1CH 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 15:17"/>Na Lewifo no yii Yoel babarima Heman, Berekia babarima Asaf ne Kusaia babarima Etan a wofi Merari abusua mu, ma wodii nnwontofo no anim. <verse eid="1CH 15:17"/><verse number="18" style="v" sid="1CH 15:18"/>Woyii saa mmarima yi sɛ wɔn aboafo: Sakaria, Ben, Yaasiel, Semiramot, Yehiel, Uni, Eliab, Benaia, Maaseia, Matitia, Elifelehu, Mikneia ne apon ano ahwɛfo Obed-Edom ne Yeiel.<verse eid="1CH 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19"/>Woyii Heman, Asaf ne Etan sɛ wɔmmɔ kɔbere mfrafrae kyɛnkyɛn no. <verse eid="1CH 15:19"/><verse number="20" style="v" sid="1CH 15:20"/>Woyii Sakaria, Asiel, Semiramot, Yehiel, Uni, Eliab, Maaseia ne Benaia sɛ wɔmmɔ mmɛnta no. <verse eid="1CH 15:20"/><verse number="21" style="v" sid="1CH 15:21"/>Woyii Matitia, Elifelehu, Miknela, Obed-Edom, Yeiel ne Asasia sɛ wɔmmɔ asankuten no. <verse eid="1CH 15:21"/><verse number="22" style="v" sid="1CH 15:22"/>Woyii Kenania a ɔyɛ Lewifo panyin no sɛ ɔnna nnwontokuw no ano, esiane ne nimdeɛ nti.<verse eid="1CH 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 15:23"/>Woyii Berekia ne Elkana sɛ wɔnwɛn Apam Adaka no. <verse eid="1CH 15:23"/><verse number="24" style="v" sid="1CH 15:24"/>Sebania, Yosafat, Netanel, Amasai, Sakaria, Benaia ne Elieser a wɔn nyinaa yɛ asɔfo no na wɔbɛto santen adi Onyankopɔn Apam Adaka no anim, ahyɛn ntorobɛnto no. Woyii Obed-Edom ne Yehia sɛ wɔnwɛn Apam Adaka no.<verse eid="1CH 15:24"/></para>
  <para style="s1">Wɔsoa Apam Adaka No Kɔ Yerusalem</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25"/>Enti Dawid ne Israel mpanyimfo ne asraafo so asahene no de ahokeka a ɛso bi nni kɔɔ Obed-Edom fi sɛ wɔrekɔfa <char style="nd">Awurade</char> Apam Adaka no akɔ Yerusalem. <verse eid="1CH 15:25"/><verse number="26" style="v" sid="1CH 15:26"/>Na esiane sɛ akyinnye biara nni ho sɛ <char style="nd">Awurade</char> ka Lewifo a wɔso <char style="nd">Awurade</char> Apam Adaka no ho no nti, wɔde anantwinini ason ne adwennini ason bɔɔ afɔre. <verse eid="1CH 15:26"/><verse number="27" style="v" sid="1CH 15:27"/>Wɔhyɛɛ Dawid sirikyi atade fɛfɛ bi. Saa ara na Lewifo a wɔsoaa Apam Adaka no, nnwontofo no ne Kenania a ɔyɛ nnwontofo no kwankyerɛfo no nso yɛe. Na Dawid hyɛ asɔfo nguguso bi nso. <verse eid="1CH 15:27"/><verse number="28" style="v" sid="1CH 15:28"/>Enti Israel nyinaa de ahokeka, osebɔ, mmɛnhyɛn ne ntorobɛntohyɛn, akasaewosow, mmɛnta ne asankutenbɔ de <char style="nd">Awurade</char> Apam Adaka no kɔɔ Yerusalem.<verse eid="1CH 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29"/>Na bere a <char style="nd">Awurade</char> Apam Adaka no wuraa Dawid kurow mu no, Saulo babea Mikal too nʼani hwɛɛ fam, fii ne mfɛnsere mu. Bere a ohuu sɛ ɔhene Dawid resaw na ɔde anigye rehuruhuruw no, obuu no animtiaa wɔ ne koma mu.<verse eid="1CH 15:29"/></para>
  <chapter eid="1CH 15"/>
  <chapter number="16" style="c" sid="1CH 16"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1"/>Na wɔde Onyankopɔn Apam Adaka no kosii ntamadan sononko bi a Dawid asiesie mu, na wɔbɔɔ ɔhyew afɔre ne asomdwoe afɔre wɔ Onyankopɔn anim. <verse eid="1CH 16:1"/><verse number="2" style="v" sid="1CH 16:2"/>Dawid wiee no, ohyiraa nkurɔfo no wɔ <char style="nd">Awurade</char> din mu. <verse eid="1CH 16:2"/><verse number="3" style="v" sid="1CH 16:3"/>Na ɔkyɛɛ Israelfo mmea ne mmarima nyinaa aduan. Obiara nyaa brodo mua, namkum ne bobe aba ɔfam.<verse eid="1CH 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4"/>Dawid yii saa Lewifo yi sɛ wonni nnipa no anim wɔ ɔsom mu, wɔ <char style="nd">Awurade</char> Apam Adaka no anim, na wɔmfa so nsrɛ ne nhyira, na wɔnna <char style="nd">Awurade</char>, Israel Nyankopɔn ase na wɔnkamfo no. <verse eid="1CH 16:4"/><verse number="5" style="v" sid="1CH 16:5"/>Asaf a na ɔda kuw yi ano no bɔɔ kyɛnkyɛn no. Na nʼabediakyirifo yɛ Sakaria a ɔto so abien, afei Yeiel, Semiramot, Yehiel, Matitia, Eliab, Benaia, Obed-Edom ne Yahasiel. Wɔn na wɔbɔɔ mmɛnta ne asankuten. <verse eid="1CH 16:5"/><verse number="6" style="v" sid="1CH 16:6"/>Na Asɔfo Benaia ne Yahasiel taa bɔ ntorobɛnto wɔ Onyankopɔn Apam Adaka no anim.<verse eid="1CH 16:6"/></para>
  <para style="s1">Dawid Aseda Dwom</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7"/>Saa da no, Dawid de saa aseda dwom a ɔde ma <char style="nd">Awurade</char> yi maa Asaf ne ne mfɛfo Lewifo:<verse eid="1CH 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 16:8"/>Da <char style="nd">Awurade</char> ase na da ne kɛseyɛ adi.</para>
  <para style="q2" vid="1CH 16:8">Ma wiase nyinaa nhu nea wayɛ.<verse eid="1CH 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9"/>Monto dwom mma no, monto ayeyi dwom mma no;</para>
  <para style="q2" vid="1CH 16:9">monka nʼanwonwade no nyinaa.<verse eid="1CH 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10"/>Monhoahoa mo ho wɔ ne din kronkron mu;</para>
  <para style="q2" vid="1CH 16:10">momma wɔn a wɔhwehwɛ <char style="nd">Awurade</char> no nnya koma mu anigye.<verse eid="1CH 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11"/>Momma mo ani nna <char style="nd">Awurade</char> ne nʼahoɔden so;</para>
  <para style="q2" vid="1CH 16:11">na monhwehwɛ nʼanim bere biara.<verse eid="1CH 16:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 16:12"/>Monkae anwonwade a wayɛ,</para>
  <para style="q2" vid="1CH 16:12">ne nsɛnkyerɛnne ne atɛn a obui.<verse eid="1CH 16:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 16:13"/>Mo Israelmma, Onyankopɔn somfo,</para>
  <para style="q2" vid="1CH 16:13">Yakob mma a wapaw wɔn.<verse eid="1CH 16:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14"/>Ɔyɛ <char style="nd">Awurade</char>, yɛn Nyankopɔn;</para>
  <para style="q2" vid="1CH 16:14">nʼahenni da adi wɔ asase so nyinaa.<verse eid="1CH 16:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15"/>Ɔkae nʼapam daa nyinaa,</para>
  <para style="q2" vid="1CH 16:15">asɛm a ɔhyɛ maa awo ntoantoaso apem no.<verse eid="1CH 16:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16"/>Eyi ne apam a ɔne Abraham yɛe</para>
  <para style="q2" vid="1CH 16:16">ne ntam a ɔka kyerɛɛ Isak.<verse eid="1CH 16:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 16:17"/>Ɔhyɛɛ mu den maa Yakob sɛ mmara,</para>
  <para style="q2" vid="1CH 16:17">de maa Israel sɛ apam a ɛbɛtena hɔ afebɔɔ;<verse eid="1CH 16:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18"/>“Mede Kanaan asase no bɛma wo</para>
  <para style="q1" vid="1CH 16:18">sɛ kyɛfa a ɛbɛyɛ wʼagyapade.”<verse eid="1CH 16:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19"/>Ɔkaa eyi bere a na wɔnnɔɔso,</para>
  <para style="q2" vid="1CH 16:19">ahɔhokuw ketewa bi a wɔwɔ Kanaan.<verse eid="1CH 16:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 16:20"/>Wofii aman so kɔɔ aman so,</para>
  <para style="q2" vid="1CH 16:20">fii ahemman mu kɔɔ ahemman mu.<verse eid="1CH 16:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21"/>Nanso wamma obi anhyɛ wɔn so;</para>
  <para style="q2" vid="1CH 16:21">wɔn nti, ɔkaa ahene anim se;<verse eid="1CH 16:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 16:22"/>“Mommfa mo nsa nka wɔn a masra wɔn ngo,</para>
  <para style="q1" vid="1CH 16:22">na monnyɛ mʼadiyifo bɔne bi.”<verse eid="1CH 16:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23"/>Momma asase nyinaa nto dwom mma <char style="nd">Awurade</char>!</para>
  <para style="q2" vid="1CH 16:23">Da biara, mompae mu nka asɛmpa no sɛ ogye nkwa.<verse eid="1CH 16:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24"/>Mommɔ nʼanuonyam nneyɛe ho dawuru wɔ amanaman mu.</para>
  <para style="q2" vid="1CH 16:24">Monka anwonwade a ɔyɛ nkyerɛ obiara.<verse eid="1CH 16:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25"/>
    <char style="nd">Awurade</char> yɛ ɔkɛse! Na nkamfo fata no!</para>
  <para style="q2" vid="1CH 16:25">Ɛsɛ sɛ wosuro no sen anyame nyinaa.<verse eid="1CH 16:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26"/>Aman so anyame nyinaa yɛ ahoni bi kwa,</para>
  <para style="q2" vid="1CH 16:26">nanso <char style="nd">Awurade</char> na ɔbɔɔ ɔsoro!<verse eid="1CH 16:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27"/>Anuonyam ne tumi atwa ne ho ahyia,</para>
  <para style="q1" vid="1CH 16:27">ahoɔden ne ahoɔfɛ wɔ nʼatenae.<verse eid="1CH 16:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28"/>Momfa mma <char style="nd">Awurade</char>, Amanaman mmusuakuw,</para>
  <para style="q2" vid="1CH 16:28">momfa anuonyam ne tumi mma <char style="nd">Awurade</char>.<verse eid="1CH 16:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 16:29"/>Momfa anuonyam a ɛfata mma <char style="nd">Awurade</char>!</para>
  <para style="q2" vid="1CH 16:29">Momfa mo afɔrebɔde mmra mmɛsom no.</para>
  <para style="q1" vid="1CH 16:29">Monsɔre <char style="nd">Awurade</char> wɔ ne hyerɛn kronkron nyinaa mu.<verse eid="1CH 16:29"/></para>
  <para style="q2">
    <verse number="30" style="v" sid="1CH 16:30"/>Momma asase nyinaa mpopo wɔ nʼanim.</para>
  <para style="q2" vid="1CH 16:30">Wɔatim wiase dennen a entumi nhinhim.<verse eid="1CH 16:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31"/>Momma ɔsoro ani nnye na asase nsɛpɛw ne ho!</para>
  <para style="q2" vid="1CH 16:31">Momma aman nyinaa nte sɛ, <char style="nd">Awurade</char> yɛ ɔhene.<verse eid="1CH 16:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32"/>Momma ɛpo ne nea ɛwɔ mu nyinaa nteɛ mu nkamfo no.</para>
  <para style="q2" vid="1CH 16:32">Momma mfuw ne wɔn nnɔbae mfa ahosɛpɛw mpue.<verse eid="1CH 16:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33"/>Momma kwae nnua nnyigyei</para>
  <para style="q2" vid="1CH 16:33">nyɛ ayeyi <char style="nd">Awurade</char> anim!</para>
  <para style="q2" vid="1CH 16:33">Efisɛ ɔrebebu asase atɛn.<verse eid="1CH 16:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34"/>Monna <char style="nd">Awurade</char> ase, efisɛ oye</para>
  <para style="q2" vid="1CH 16:34">na nʼadɔe wɔ hɔ daa.<verse eid="1CH 16:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35"/>Monteɛteɛ mu se, “Gye yɛn, Ao yɛn nkwagye Onyankopɔn!</para>
  <para style="q2" vid="1CH 16:35">Boa yɛn ano, na gye yɛn fi amanaman nsam,</para>
  <para style="q1" vid="1CH 16:35">na yɛatumi ada wo din kronkron ase,</para>
  <para style="q2" vid="1CH 16:35">na yɛadi ahurusi akamfo wo.”<verse eid="1CH 16:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36"/>Ayeyi nka <char style="nd">Awurade</char>, Israel Nyankopɔn,</para>
  <para style="q2" vid="1CH 16:36">emfi mmeresanten nkosi nnasanten.</para>
  <para style="m" vid="1CH 16:36">Na nnipa no nyinaa gyee so se, “Amen!” Na wɔkamfoo <char style="nd">Awurade</char>.<verse eid="1CH 16:36"/></para>
  <para style="s1">Ɔsom Wɔ Yerusalem Ne Gibeon</para>
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37"/>Dawid hyehyɛ maa Asaf ne ne mfɛfo Lewifo no sɛ wɔnsom daa wɔ <char style="nd">Awurade</char> Apam Adaka no anim, na wɔnyɛ nea ehia sɛ wɔyɛ no da biara. <verse eid="1CH 16:37"/><verse number="38" style="v" sid="1CH 16:38"/>Saa kuw yi mu nnipa ne Obed-Edom (a ɔyɛ Yedutun babarima no), Hosa ne Lewifo aduosia awotwe a wɔyɛ apon ano hwɛfo.<verse eid="1CH 16:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 16:39"/>Dawid de ɔsɔfo Sadok ne ne mfɛfo asɔfo tenaa <char style="nd">Awurade</char> Ahyiae Ntamadan a ɛwɔ bepɔw Gibeon no, sɛ wɔnsom wɔ <char style="nd">Awurade</char> anim wɔ hɔ. <verse eid="1CH 16:39"/><verse number="40" style="v" sid="1CH 16:40"/>Anɔpa ne anwummere biara, wɔbɔ ɔhyew afɔre wɔ afɔremuka a wɔayi asi hɔ ama saa dwumadi no so. Na wodii biribiara a wɔakyerɛw sɛ <char style="nd">Awurade</char> mmara a ɔde ama Israel no so. <verse eid="1CH 16:40"/><verse number="41" style="v" sid="1CH 16:41"/>Dawid san yii Heman, Yedutun ne afoforo bi a wɔbobɔɔ wɔn din, yiyii wɔn no sɛ wɔnna <char style="nd">Awurade</char> ase “Na nʼadɔe no tim hɔ daa.” <verse eid="1CH 16:41"/><verse number="42" style="v" sid="1CH 16:42"/>Heman ne Yedutun bɔɔ wɔn ntorobɛnto, kyɛnkyɛn ne nnwontode ahorow de gyigyee ayeyi nnwom a wɔto maa Onyankopɔn no ho. Na woyii Yedutun mmabarima ma wɔyɛɛ apon ano hwɛfo.<verse eid="1CH 16:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43"/>Na nnipa no nyinaa san kɔɔ wɔn afi mu. Dawid nso san kɔɔ ne fi, kohyiraa ne fifo.<verse eid="1CH 16:43"/></para>
  <chapter eid="1CH 16"/>
  <chapter number="17" style="c" sid="1CH 17"/>
  <para style="s1">
    <char style="nd">Awurade</char> Apam Bɔhyɛ A Ɔde Ma Dawid</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1"/>Dawid bɔɔ ne ho atenase wɔ nʼahemfi hɔ no, ɔka kyerɛɛ odiyifo Natan se, “Me de, manya ahemfi a wɔde sida asi no fɛfɛ mu atena, nanso <char style="nd">Awurade</char> Apam Adaka no de, ɛhyɛ ntamadan mu.”<verse eid="1CH 17:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2"/>Natan buae se, “Nea ɛwɔ wʼadwene mu a wopɛ sɛ woyɛ no, kɔ so na Onyankopɔn ka wo ho.”<verse eid="1CH 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3"/>Saa anadwo no ara, Onyankopɔn ka kyerɛɛ Natan se,<verse eid="1CH 17:3"/></para>
  <para style="pm">
    <verse number="4" style="v" sid="1CH 17:4"/>“Kɔka kyerɛ me somfo Dawid se, ‘Sɛnea <char style="nd">Awurade</char> se ni: ɛnyɛ wo na ɛsɛ sɛ wusi asɔredan ma me tena mu. <verse eid="1CH 17:4"/><verse number="5" style="v" sid="1CH 17:5"/>Efi bere a mede Israelfo fii Misraim besi nnɛ, mentenaa asɔredan mu da. Daa, mete ntamadan mu na wɔde di atutena. <verse eid="1CH 17:5"/><verse number="6" style="v" sid="1CH 17:6"/>Na mannwiinwii ankyerɛ Israel ntuanofo no a wɔyɛ me nkurɔfo nguanhwɛfo no da. Mimmisaa wɔn da sɛ: “Adɛn nti na munsii sida dua asɔredan fɛfɛ mmaa me?” ’<verse eid="1CH 17:6"/></para>
  <para style="pm">
    <verse number="7" style="v" sid="1CH 17:7"/>“Afei, kɔka kyerɛ me somfo Dawid se, ‘Sɛnea Asafo <char style="nd">Awurade</char> se ni: Miyii wo sɛ di me nkurɔfo Israelfo anim bere a na woyɛ abarimaa guanhwɛfo a worehwɛ wo nguan wɔ adidibea. <verse eid="1CH 17:7"/><verse number="8" style="v" sid="1CH 17:8"/>Baabiara a wokɔe no, mekaa wo ho. Na masɛe wʼatamfo nyinaa. Na afei, mɛma wo din ahyeta wɔ asase so baabiara. <verse eid="1CH 17:8"/><verse number="9" style="v" sid="1CH 17:9"/>Mama me nkurɔfo Israelfo no baabi a wɔbɛtena afebɔɔ. Beae bi a ɛwɔ bammɔ a obiara renhaw wɔn. Ɛhɔ bɛyɛ wɔn ankasa asase a aman amumɔyɛfo renhyɛ wɔn so, sɛnea wɔyɛɛ bere bi a atwa mu no, <verse eid="1CH 17:9"/><verse number="10" style="v" sid="1CH 17:10"/>fi bere a miyii atemmufo sɛ wonni me nkurɔfo so no. Na mɛka wʼatamfo nyinaa ahyɛ.</para>
  <para style="pm" vid="1CH 17:10">“ ‘Na merepae mu aka se, <char style="nd">Awurade</char> besi fi ama wo, ahenni nnidiso. <verse eid="1CH 17:10"/><verse number="11" style="v" sid="1CH 17:11"/>Na sɛ wuwu a, mɛma wo mmabarima no mu baako so, na mama nʼahenni ayɛ den. <verse eid="1CH 17:11"/><verse number="12" style="v" sid="1CH 17:12"/>Ɔno ne obi a obesi fi a ɛyɛ asɔredan no ama me. Na metim nʼahengua ase afebɔɔ. <verse eid="1CH 17:12"/><verse number="13" style="v" sid="1CH 17:13"/>Mɛyɛ nʼagya na ɔbɛyɛ me ba. Merenyi me dɔ a ɛnsa da no mfi ne so, sɛnea miyi fii Saulo a wudii nʼade so no. <verse eid="1CH 17:13"/><verse number="14" style="v" sid="1CH 17:14"/>Mɛma nʼase atim wɔ mʼahenni nnidiso ne mʼaheman mu bere nyinaa mu, na nʼahengua no bɛtena hɔ daa.’ ”<verse eid="1CH 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15"/>Enti Natan san kɔɔ Dawid nkyɛn kɔkaa nsɛm a <char style="nd">Awurade</char> aka no nyinaa kyerɛɛ no.<verse eid="1CH 17:15"/></para>
  <para style="s1">Dawid Aseda Mpaebɔ</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16"/>Afei, ɔhene Dawid kɔtenaa <char style="nd">Awurade</char> anim bɔɔ mpae se,</para>
  <para style="pm" vid="1CH 17:16">“Me ne hena, <char style="nd">Awurade</char> Nyankopɔn, na mʼabusua yɛ abusua bɛn a nti wode me abedu saa tebea yi mu? <verse eid="1CH 17:16"/><verse number="17" style="v" sid="1CH 17:17"/>Na mprempren, <char style="nd">Awurade</char>, eyi nyinaa akyi no, woka se wobɛma me ahenni nnidiso afebɔɔ. Wokasa me ho te sɛ obi a meyɛ ɔkɛse pa ara, <char style="nd">Awurade</char> Nyankopɔn!<verse eid="1CH 17:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="1CH 17:18"/>“Dɛn na menka bio mfa ɔkwan a woafa so ahyɛ me anuonyam yi ho? Wunim sɛnea mete ankasa. <verse eid="1CH 17:18"/><verse number="19" style="v" sid="1CH 17:19"/><char style="nd">Awurade</char>, me nti ne wo pɛ mu nti, woayɛ saa nneɛma akɛse yi nyinaa, na woada no adi.<verse eid="1CH 17:19"/></para>
  <para style="pm">
    <verse number="20" style="v" sid="1CH 17:20"/>“<char style="nd">Awurade</char>, obiara nni hɔ a ɔte sɛ wo. Onyame foforo bi nni hɔ! Yɛntee da mpo sɛ onyame foforo bi wɔ hɔ te sɛ wo! <verse eid="1CH 17:20"/><verse number="21" style="v" sid="1CH 17:21"/>Ɔman foforo bɛn na ɛwɔ asase so a, ɛte sɛ Israel? Ɔman foforo bɛn, Onyankopɔn, na woayi no afi nkoasom mu de wɔn abɛyɛ wʼankasa wo nkurɔfo? Bere a wugyee wo nkurɔfo fii Misraim no, wode gyee din. Wonam nsɛnkyerɛnne a ɛyɛ ahodwiriw so pam aman a wɔayɛ akwanside ama wɔn no. <verse eid="1CH 17:21"/><verse number="22" style="v" sid="1CH 17:22"/>Wuyii Israel sɛ wɔmmɛyɛ wo nkurɔfo afebɔɔ, na wo, <char style="nd">Awurade</char>, woabɛyɛ wɔn Nyankopɔn.<verse eid="1CH 17:22"/></para>
  <para style="pm">
    <verse number="23" style="v" sid="1CH 17:23"/>“<char style="nd">Awurade</char>, afei yɛ nea woahyɛ ho bɔ afa me ne mʼabusuafo ho no. Ma ɛnyɛ bɔhyɛ a ebetim hɔ daa. <verse eid="1CH 17:23"/><verse number="24" style="v" sid="1CH 17:24"/>Wo din ase ntim, na wɔnhyɛ no anuonyam afebɔɔ sɛnea ɛbɛyɛ a wiase nyinaa bɛka se, ‘Asafo <char style="nd">Awurade</char> yɛ Onyankopɔn wɔ Israel!’ Na ma wo somfo Dawid ahenni nnidiso no ase ntim wɔ wʼanim.<verse eid="1CH 17:24"/></para>
  <para style="pm">
    <verse number="25" style="v" sid="1CH 17:25"/>“Wo me Nyankopɔn, masi me bo abɔ saa mpae yi, efisɛ woada no adi sɛ wubesi fi ama me, mʼahenni nnidiso a ɛbɛtena hɔ daa. <verse eid="1CH 17:25"/><verse number="26" style="v" sid="1CH 17:26"/>Efisɛ woyɛ Onyankopɔn, <char style="nd">Awurade</char>. Na me, wo somfo, woahyɛ me nneɛma pa yi ho bɔ. <verse eid="1CH 17:26"/><verse number="27" style="v" sid="1CH 17:27"/>Na afei asɔ wʼani sɛ wubehyira me ne mʼabusuafo, sɛnea yɛn ahenni nnidiso bɛkɔ so afebɔɔ wɔ wʼanim. Na sɛ wuhyira a, <char style="nd">Awurade</char>, ɛyɛ nhyira a ɛtena hɔ daa nyinaa!”<verse eid="1CH 17:27"/></para>
  <chapter eid="1CH 17"/>
  <chapter number="18" style="c" sid="1CH 18"/>
  <para style="s1">Dawid Akodi Mu Nkonimdi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1"/>Eyi akyi no, Dawid ko dii Gat ne nkurow a atwa ho ahyia no so nkonim, de kaa Filistifo no hyɛe, brɛɛ wɔn ase. <verse eid="1CH 18:1"/><verse number="2" style="v" sid="1CH 18:2"/>Bio, Dawid dii Moab asase no so nkonim, maa Moabfo no bɛyɛɛ Dawid nkoa a na wotua sonkahiri ma no.<verse eid="1CH 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3"/>Afei, Dawid tɔree ɔhene Hadadeser a ofi Soba asraafo ase de kosii Hamat, bere a Hadadeser bɔɔ nsra wɔ Asubɔnten Eufrate ho sɛ anka ɔrehyɛ ne tumi mu den no. <verse eid="1CH 18:3"/><verse number="4" style="v" sid="1CH 18:4"/>Dawid ko gyee nteaseɛnam apem, nteaseɛnamkafo mpem ason ne asraafo anantefo mpem aduonu. Afei, obubuu apɔnkɔ a wɔtwe nteaseɛnam no nyinaa anan, ma ɛkaa ɔha pɛ.<verse eid="1CH 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5"/>Bere a Aramfo fi Damasko bae sɛ wɔrebɛboa Hadadeser no, Dawid kunkum wɔn mu mpem aduonu abien. <verse eid="1CH 18:5"/><verse number="6" style="v" sid="1CH 18:6"/>Afei, ɔde asraafo guu Damasko, Aram ahenkurow mu, maa Aramfo no bɛyɛɛ Dawid nkoa a na wɔbrɛ no sonkahiri. Baabiara a Dawid bɛkɔ no, <char style="nd">Awurade</char> ma no di nkonim. <verse eid="1CH 18:6"/><verse number="7" style="v" sid="1CH 18:7"/>Dawid de Hadadeser asraafo mpanyimfo sikakɔkɔɔ nkatabo no baa Yerusalem. <verse eid="1CH 18:7"/><verse number="8" style="v" sid="1CH 18:8"/>Ɔde kɔbere mfrafrae bebree a efi Hadadeser nkuropɔn Tibhat ne Kun kaa ho bae. Akyiri no, Salomo nan kɔbere mfrafrae no de yɛɛ asɔredan no ho adwuma. Ɔde yɛɛ kɔbere mfrafrae Po na ɔde bi yɛɛ afadum ne kɔbere nkuku ne nkaka a wɔde di dwuma wɔ asɔredan no mu.<verse eid="1CH 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9"/>Bere a Hamathene Tou tee sɛ Dawid atɔre Hadadeser asraafo no ase pasaa no, <verse eid="1CH 18:9"/><verse number="10" style="v" sid="1CH 18:10"/>ɔsomaa ne babarima Hadoram ma ɔkɔɔ Dawid nkyɛn kɔmaa no mo wɔ ne nkonimdi no ho. Na Hadadeser ne Tou atan wɔn ho akyɛ, a na akokoakoko aba wɔn ntam. Yoram kɔkyɛɛ Dawid sikakɔkɔɔ, dwetɛ ne kɔbere mfrafrae bebree.<verse eid="1CH 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 18:11"/>Ɔhene Dawid hyiraa saa akyɛde yi nyinaa so maa <char style="nd">Awurade</char>, a dwetɛ ne sikakɔkɔɔ a ɔfa fii aman foforo a ɔkaa wɔn hyɛe no so no nyinaa ka ho. Saa aman no ne Edom, Moab, Amon, Filisti ne Amalek.<verse eid="1CH 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12"/>Seruia babarima Abisai kunkum Edomfo mpem dunwɔtwe wɔ Nkyene Bon no mu. <verse eid="1CH 18:12"/><verse number="13" style="v" sid="1CH 18:13"/>Ɔde asraafo duaduaa Edom nyinaa, maa Edomfo nyinaa bɛyɛɛ Dawid nkoa. Eyi yɛ sɛnea <char style="nd">Awurade</char> maa Dawid dii nkonim wɔ baabiara a ɔkɔe no nhwɛso.<verse eid="1CH 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14"/>Dawid dii Israel nyinaa so hene, a wanhyɛ obiara so na wansisi obiara nso.<verse eid="1CH 18:14"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 18:15"/>Na Seruia babarima Yoab na na ɔyɛ ɔsafohene. Ahilud babarima Yehosafat na na ɔyɛ adehye abakɔsɛmkyerɛwni.<verse eid="1CH 18:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 18:16"/>Ahitub babarima Sadok ne Abiatar babarima Abimelek na na wɔyɛ asɔfo.</para>
  <para style="li1" vid="1CH 18:16">Sawsa na na ɔyɛ asennii kyerɛwfo.<verse eid="1CH 18:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 18:17"/>Yehoiada babarima Benaia na na odi Keretifo<note caller="+" style="f"><char style="fr" closed="false">18.17 </char><char style="ft" closed="false">Na Keretifo ne Peletifo yɛ ahɔho asraafo a wɔbɔ wɔn paa ma wɔko. Keretifo no ase fi Krete na Peletifo no nso ase fi Filisti. Wɔtaa bɔ saa akuw abien yi din sɛ awɛmfo a wɔwɛn adehye.</char></note> ne Peletifo so.</para>
  <para style="li1" vid="1CH 18:17">Dawid mmabarima somee sɛ ɔhene aboafo mpanyimfo.<verse eid="1CH 18:17"/></para>
  <chapter eid="1CH 18"/>
  <chapter number="19" style="c" sid="1CH 19"/>
  <para style="s1">Dawid Di Amorifo So Nkonim</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1"/>Eyinom akyi no, Amonhene Nahas wui, na ne babarima Hanun bedii ade. <verse eid="1CH 19:1"/><verse number="2" style="v" sid="1CH 19:2"/>Dawid susuw ho se, “Mɛda ayamye adi akyerɛ Nahas ba Hanun, efisɛ nʼagya daa ayamye adi kyerɛɛ me.”</para>
  <para style="p" vid="1CH 19:2">Ɛno nti, Dawid tuu abɔfo ma wɔkɔɔ Hanun nkyɛn, kɔmaa no hyɛden wɔ nʼagya wu no ho. Bere a abɔfo no duu Amon asase so no, <verse eid="1CH 19:2"/><verse number="3" style="v" sid="1CH 19:3"/>Hanun asahene bisaa no se, “Enti wugye di ampa ara sɛ, saa mmarima yi baa sɛ wɔrebɛhyɛ wʼagya anuonyam? Dabi! Dawid asoma wɔn sɛ wɔmmɛsra asase yi, na wɔnam so ako agye.” <verse eid="1CH 19:3"/><verse number="4" style="v" sid="1CH 19:4"/>Enti Hanun kyeree Dawid abɔfo no, yii wɔn abogyesɛ, twitwaa wɔn ntade ano wɔ wɔn to ase, ma wɔsan kɔe.<verse eid="1CH 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 19:5"/>Bere a Dawid tee asɛm no, otuu abɔfo kɔɔ asomafo no nkyɛn kɔkae se, “Montena Yeriko mma mo abogyesɛ no mfuw ansa na moaba.” Efisɛ na wɔn ho ayɛ fɛre yiye.<verse eid="1CH 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6"/>Afei, Amonfo huu abufuwtraso a wɔahyɛ Dawid no, Hanun ne Amonfo soma ma wɔde dwetɛ nkaribo ani tɔn aduasa awotwe kogyee nteaseɛnam ne asraafodɔm fii Aram-naharaim, Aram-maaka ne Soba. <verse eid="1CH 19:6"/><verse number="7" style="v" sid="1CH 19:7"/>Wɔsan pɛɛ nteaseɛnam mpem aduasa abien, na wonyaa akyigyina fii Maakahene ne nʼakofo nkyɛn. Saa asraafodɔm yi kyeree nsraban wɔ Medeba, ɛhɔ na Amon asraafodɔm a Hanun nya fii nʼankasa nkurow so no kɔkaa wɔn ho.<verse eid="1CH 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8"/>Bere a Dawid tee saa no, ɔsomaa Yoab ne nʼakofo sɛ wɔne wɔn nkɔko. <verse eid="1CH 19:8"/><verse number="9" style="v" sid="1CH 19:9"/>Amonfo asraafo no begyinagyinaa kuropɔn no pon ano, na ahemfo a wɔaka no nso gyinagyinaa sare no so.<verse eid="1CH 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10"/>Bere a Yoab huu sɛ ɛsɛ sɛ ɔko ha ne ha no, ɔpaw nʼakofodɔm no mu akofo a wonim ako yiye no. Ɔde wɔn hyɛɛ nʼankasa ase, dii wɔn anim kɔko tiaa Aramfo no a wogyinagyina sare so no. <verse eid="1CH 19:10"/><verse number="11" style="v" sid="1CH 19:11"/>Ogyaw asraafodɔm a wɔaka no maa ne nuabarima Abisai sɛ ɔnkɔtow nhyɛ Amonfo no so. <verse eid="1CH 19:11"/><verse number="12" style="v" sid="1CH 19:12"/>Na Yoab ka kyerɛɛ ne nuabarima no se, “Sɛ Aramfo no yɛ den ma me dodo a, bra na bɛboa me.” Yoab toaa so se, “Sɛ Amonfo no yɛ den dodo ma wo a, mɛba abɛboa wo. <verse eid="1CH 19:12"/><verse number="13" style="v" sid="1CH 19:13"/>Hyɛ wo ho den. Ma yɛmfa akokoduru nko nnye yɛn nkurɔfo ne yɛn Onyankopɔn nkurow. <char style="nd">Awurade</char> bɛyɛ nea eye wɔ nʼani so.”<verse eid="1CH 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14"/>Bere a Yoab ne nʼakofo no tow hyɛɛ Aramfo no so no, wofii ase guanee. <verse eid="1CH 19:14"/><verse number="15" style="v" sid="1CH 19:15"/>Na Amonfo huu sɛ Aramfo no reguan no, woguan fi Abisai anim kɔɔ kuropɔn no mu. Afei, Yoab san kɔɔ Yerusalem.<verse eid="1CH 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16"/>Aramfo no huu sɛ ɛnyɛ wɔn afɛ ne Israelfo no nti, wɔfrɛɛ Aram asraafodɔm foforo fii Asubɔnten Eufrate ho sɛ wɔmmɛboa. Saa asraafodɔm a wɔhyɛ Sofak a ɔyɛ Hadadeser asraafodɔm nyinaa so sahene ase no bae.<verse eid="1CH 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17"/>Bere a Dawid tee asɛm a asi no, ɔboaboaa Israel nyinaa ano, de wɔn twaa Asubɔnten Yordan, de nʼakofo no gyinagyinaa wɔn mpasua so. Afei, ɔne atamfo no de ɔko hyehyɛɛ so, ma wɔko tiaa no. <verse eid="1CH 19:17"/><verse number="18" style="v" sid="1CH 19:18"/>Ɛha nso, Aramfo no guan fii Israelfo no anim, na Dawid asraafo no kunkum nteaseɛnamkafo mpem ason ne anammɔnmufo asraafo mpem aduanan a Sofak a ɔyɛ wɔn so sahene no ka ho.<verse eid="1CH 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 19:19"/>Hadadeser asomfo huu sɛ Israel adi wɔn so nkonim no, wɔmaa wɔn nsa so, maa Dawid faa wɔn sɛ ne nkoa. Ɛno akyi no, Aramfo ampɛ sɛ wɔbɛboa Amonfo bio.<verse eid="1CH 19:19"/></para>
  <chapter eid="1CH 19"/>
  <chapter number="20" style="c" sid="1CH 20"/>
  <para style="s1">Wɔko Fa Raba</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1"/>Asusow bere, afe mu bere a ahemfo kɔ ɔko no, Yoab dii Israel asraafo anim, kɔtow hyɛɛ Amonfo nkurow ne nkuraa so, dii wɔn so nkonim. Akodi no mu no, wotuaa Raba kuropɔn no, sɛee no. Saa bere no na Dawid te akyi wɔ Yerusalem. <verse eid="1CH 20:1"/><verse number="2" style="v" sid="1CH 20:2"/>Bere a Dawid duu Raba no, otuu ɔhene no ahenkyɛw, na wɔde hyɛɛ Dawid. Sikakɔkɔɔ na wɔde yɛɛ ahenkyɛw no na wɔde aboɔdemmo abobɔ mu. Na emu duru bɛyɛ kilogram aduasa anan. Dawid faa asade bebree fii kurow no mu. <verse eid="1CH 20:2"/><verse number="3" style="v" sid="1CH 20:3"/>Ɔde Rabafo no yɛɛ nkoa, hyɛɛ wɔn ma wɔde ɔwan, famtunnade ne mmonnua yɛɛ adwuma. Saa ara nso na ɔyɛɛ nnipa a wɔwɔ Amon nkuropɔn nyinaa so. Na Dawid ne nʼakofo san kɔɔ Yerusalem.<verse eid="1CH 20:3"/></para>
  <para style="s1">Akodi A Etia Filistifo</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4"/>Eyi akyi, ɔko sii wɔne Filistifo ntam wɔ Geser. Ɔko no mu no, Sibekai a ofi Husa kum Sipai a ɔyɛ abran no aseni ma wɔkaa Filistifo no hyɛe.<verse eid="1CH 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5"/>Ɔko foforo bi a wɔne Filistifo koe no mu no, Yair babarima Elhanan kum Gatni Goliat nuabarima Lahmi. Na Lahmi peaw nsa mu pipiripi te sɛ ntamanwemfo abaa.<verse eid="1CH 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6"/>Ɔko foforo bi nso a wɔne Filistifo koe wɔ Gat no, ɔbran bi a ɔyɛ abran asefo no bi a ɔyɛ nsansia yɛ nansia wɔ ne nsa ne ne nan biara so no <verse eid="1CH 20:6"/><verse number="7" style="v" sid="1CH 20:7"/>buu Israel animtiaa, twitwaa mpoa. Na Dawid nuabarima Simea babarima Yonatan kum no.<verse eid="1CH 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 20:8"/>Na saa Filistifo yi yɛ Gat abran no asefo nanso Dawid ne nʼakofo kunkum wɔn.<verse eid="1CH 20:8"/></para>
  <chapter eid="1CH 20"/>
  <chapter number="21" style="c" sid="1CH 21"/>
  <para style="s1">Dawid Kan Nnipa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1"/>Ɔbonsam sɔre tiaa Israel, maa Dawid kan Israelfo. <verse eid="1CH 21:1"/><verse number="2" style="v" sid="1CH 21:2"/>Dawid hyɛɛ Yoab ne nʼasahene sɛ, “Monkan nnipa a wɔwɔ asase yi so nyinaa efi Beer-Seba a ɛwɔ anafo fam kosi Dan a ɛwɔ atifi fam, na momfa wɔn dodow mmrɛ me, na ɛmma minhu wɔn ano.”<verse eid="1CH 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3"/>Na Yoab kae se, “<char style="nd">Awurade</char> mmɔ ne nkurɔfo no dodow ho mpɛn ɔha ɔha! Na me wura, adɛn nti na wopɛ sɛ woyɛ saa? Wɔn nyinaa nyɛ wʼasomfo ana? Adɛn nti na ɛsɛ sɛ woyɛ ma Israel yɛ bɔne?”<verse eid="1CH 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4"/>Nanso ɔhene no kae se, nea ɛte biara ɛsɛ sɛ Yoab kan nnipa no. Enti Yoab kyinkyinii Israel nyinaa kan nnipa no. Na ɔsan baa Yerusalem <verse eid="1CH 21:4"/><verse number="5" style="v" sid="1CH 21:5"/>bɛkaa nnipa no dodow kyerɛɛ Dawid. Na wɔn dodow yɛ mmarima ɔpepem baako ne mpem ɔha a wɔaso ɔsakɔ wɔ Israel ne mpem ahannan aduɔson wɔ Yuda.<verse eid="1CH 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 21:6"/>Nanso Yoab amfa Lewi ne Benyamin mmusuakuw anka nnipakan no ho, efisɛ na nea ɔhene ahyɛ no sɛ ɔnyɛ no yɛ no ahometew.<verse eid="1CH 21:6"/></para>
  <para style="s1">Dawid Bɔne Ho Atemmu</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 21:7"/>Onyankopɔn ampɛ nnipakan no koraa, enti ɔtwee Israel aso wɔ ho. <verse eid="1CH 21:7"/><verse number="8" style="v" sid="1CH 21:8"/>Na Dawid ka kyerɛɛ Onyankopɔn se, “Mayɛ bɔne kɛse. Anka ɛnsɛ sɛ mekan nnipa no. Mesrɛ wo, fa me nkwaseade a mayɛ no kyɛ me.”<verse eid="1CH 21:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9"/>Na <char style="nd">Awurade</char> kasa kyerɛɛ Gad a ɔyɛ Dawid ɔdehufo no se, <verse eid="1CH 21:9"/><verse number="10" style="v" sid="1CH 21:10"/>“Kɔ na kɔka kyerɛ Dawid se, ‘Sɛnea <char style="nd">Awurade</char> se ni: Merema wo nsɛm ahorow abiɛsa. Paw emu baako na menyɛ ntia wo.’ ”<verse eid="1CH 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11"/>Enti Gad baa Dawid nkyɛn bɛkae se, “Sɛnea <char style="nd">Awurade</char> se ni: ‘Paw emu nea wopɛ: <verse eid="1CH 21:11"/><verse number="12" style="v" sid="1CH 21:12"/>mfe abiɛsa a ɔkɔm kɛse bɛba anaa asram abiɛsa a wʼatamfo bekunkum mo anaa nnansa a ɔyaredɔm a ano yɛ den yiye a, <char style="nd">Awurade</char> bɔfo nam so de ɔsɛe bɛba Israel asase so.’ Afei dwene eyi ho, na ma minhu mmuae ko a memfa nkɔma <char style="nd">Awurade</char>.”<verse eid="1CH 21:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13"/>Dawid buaa Gad se, “Mewɔ ahohiahia mu. Ma mentɔ <char style="nd">Awurade</char> nsam, efisɛ nʼahummɔbɔ no so. Mma me nkɔtɔ nnipa nsam.”<verse eid="1CH 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14"/>Na <char style="nd">Awurade</char> maa ɔyaredɔm baa Israel so, maa nnipa mpem aduɔson wuwui. <verse eid="1CH 21:14"/><verse number="15" style="v" sid="1CH 21:15"/>Afei, Onyankopɔn somaa ɔsoro ɔbɔfo sɛ ɔnkɔsɛe Yerusalem. Na bɔfo no reyɛ no, <char style="nd">Awurade</char> nyaa ahummɔbɔ ka kyerɛɛ owu ɔbɔfo no se, “Gyae! Ɛno ara dɔɔso!” Saa bere no na ɔbɔfo no gyina Yebusini Arauna awiporowbea hɔ.<verse eid="1CH 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16"/>Dawid pagyaw nʼani huu sɛ <char style="nd">Awurade</char> bɔfo no gyina ɔsoro ne asase ntam a, watwe nʼafoa de akyerɛ Yerusalem so. Enti Dawid ne Israel mpanyimfo furaa atweaatam de kyerɛɛ wɔn ahoyeraw, na wɔhwehwee fam de wɔn anim butubutuw hɔ.<verse eid="1CH 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 21:17"/>Na Dawid ka kyerɛɛ Onyankopɔn se, “Me na mede nnipakan no ho asɛm bae! Me ne obi a mayɛ bɔne na mafom. Saa nkurɔfo yi de, ɛso bi nna wɔn so. Dɛn na wɔayɛ? <char style="nd">Awurade</char> me Nyankopɔn, ma wʼabufuw mmra me ne me fifo so, na nsɛe wo nkurɔfo.”<verse eid="1CH 21:17"/></para>
  <para style="s1">Dawid Si Afɔremuka</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18"/>Na <char style="nd">Awurade</char> bɔfo no ka kyerɛɛ Gad se ɔnka nkyerɛ Dawid mma onsi afɔremuka mma <char style="nd">Awurade</char> wɔ Yebusini Arauna awiporowbea hɔ. <verse eid="1CH 21:18"/><verse number="19" style="v" sid="1CH 21:19"/>Na Dawid yɛɛ nea <char style="nd">Awurade</char> nam Gad so ka kyerɛɛ no no. <verse eid="1CH 21:19"/><verse number="20" style="v" sid="1CH 21:20"/>Arauna a saa bere no na nʼani abere reporow nʼatoko so no dan ne ho huu ɔbɔfo no wɔ hɔ. Ne mmabarima baanan a na wɔka ne ho wɔ hɔ no guan kohintawee. <verse eid="1CH 21:20"/><verse number="21" style="v" sid="1CH 21:21"/>Bere a Arauna huu sɛ ɔhene Dawid reba awiporowbea hɔ no, ofi hɔ kɔkotow nʼanim.<verse eid="1CH 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22"/>Na Dawid ka kyerɛɛ Arauna se, “Tɔn awiporowbea yi ma me sɛnea ne bo te. Na mesi afɔremuka ama <char style="nd">Awurade</char> wɔ hɔ sɛnea obesiw ɔyaredɔm no ano.”<verse eid="1CH 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23"/>Arauna ka kyerɛɛ Dawid se, “Fa, me wura, na fa yɛ nea wopɛ. Anantwi a wode bɛbɔ afɔre ni. Wubetumi de awiporowbea nnua yi ayɛ nnyina de asɔ gya wɔ afɔremuka no so. Fa atoko no nso bɔ atoko afɔre. Mede ne nyinaa bɛma wo.”<verse eid="1CH 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24"/>Na ɔhene no buaa Arauna se, “Dabi! Mepɛ sɛ mitua nea ɛfata ma wo. Merentumi nnye wʼagyapade mfa mma <char style="nd">Awurade</char>. Meremmɔ ɔhyew afɔre a memmɔɔ ho ka.”<verse eid="1CH 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25"/>Enti Dawid tuaa sikakɔkɔɔ kilogram ason maa Arauna, de tɔɔ awiporowbea no. <verse eid="1CH 21:25"/><verse number="26" style="v" sid="1CH 21:26"/>Dawid sii afɔremuka wɔ hɔ maa <char style="nd">Awurade</char>, bɔɔ ɔhyew afɔre ne asomdwoe afɔre wɔ so. Na Dawid bɔɔ mpae no, <char style="nd">Awurade</char> tiee no, nam so de ogya fi soro bɛhyew afɔrebɔde a ɛwɔ afɔremuka no so no.<verse eid="1CH 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27"/>Afei, <char style="nd">Awurade</char> kasa kyerɛɛ ɔbɔfo no ma ɔsan de nʼafoa no hyɛɛ ne boha mu. <verse eid="1CH 21:27"/><verse number="28" style="v" sid="1CH 21:28"/>Bere a Dawid huu sɛ <char style="nd">Awurade</char> atie ne mpaebɔ no, ɔbɔɔ afɔre pii wɔ Yebusini Arauna awiporowbea hɔ. <verse eid="1CH 21:28"/><verse number="29" style="v" sid="1CH 21:29"/>Saa bere no na <char style="nd">Awurade</char> Ahyiae Ntamadan ne afɔremuka a Mose sii wɔ sare so hɔ no sisi Gibeon sorɔnsorɔmmea hɔ. <verse eid="1CH 21:29"/><verse number="30" style="v" sid="1CH 21:30"/>Nanso Dawid antumi ankɔ hɔ ankobisa Onyankopɔn ase, efisɛ afoa a <char style="nd">Awurade</char> bɔfo no twee no bɔɔ no hu.<verse eid="1CH 21:30"/></para>
  <para style="b"/>
  <chapter eid="1CH 21"/>
  <chapter number="22" style="c" sid="1CH 22"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1"/>Afei, Dawid kae se, “Ɛha ne baabi a wobesi <char style="nd">Awurade</char> Nyankopɔn Asɔredan no ne afɔremuka a Israel bɛbɔ so ɔhyew afɔre no.”<verse eid="1CH 22:1"/></para>
  <para style="s1">Asɔredan No Si Ho Ahoboa</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2"/>Ɛno nti Dawid hyɛ ma wɔfrɛfrɛɛ ahɔho a wɔte Israel nyinaa boaa ano. Ɔma wotwaa abo a wɔde besi Onyankopɔn Asɔredan no. <verse eid="1CH 22:2"/><verse number="3" style="v" sid="1CH 22:3"/>Dawid maa nnade pii a wɔde bɛyɛ nnadewa a ɛho behia ama apon ne mpontare. Ɔmaa kɔbere mfrafrae nso bebree a na wontumi nkari mpo. <verse eid="1CH 22:3"/><verse number="4" style="v" sid="1CH 22:4"/>Ɔmaa sida nnua pii nso, efisɛ na mmarima a wofi Tiro ne Sidon de bebree abrɛ Dawid dedaw.<verse eid="1CH 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 22:5"/>Dawid kae se, “Me babarima Salomo nnyinii, na onni osuahu bi, nanso ɛsɛ sɛ saa asɔredan yi yɛ kɛse, gye din na ɛyɛ anuonyamhyɛ wɔ wiase mmaa nyinaa. Enti mefi ase nnɛ yi ara ayɛ ahoboa ama ne si.” Enti Dawid pɛɛ adansi ho nneɛma bebree guu hɔ ansa na ɔrewu.<verse eid="1CH 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6"/>Afei, Dawid soma kɔfaa ne babarima Salomo, na ɔka kyerɛɛ no sɛ onsi asɔredan mma <char style="nd">Awurade</char>, Israel Nyankopɔn. <verse eid="1CH 22:6"/><verse number="7" style="v" sid="1CH 22:7"/>Dawid ka kyerɛɛ no se, “Me ba, na anka mepɛ sɛ misi asɔredan de hyɛ <char style="nd">Awurade</char>, me Nyankopɔn, din anuonyam. <verse eid="1CH 22:7"/><verse number="8" style="v" sid="1CH 22:8"/>Nanso <char style="nd">Awurade</char> ka kyerɛɛ me se, ‘Woakunkum nnipa bebree wɔ akodi akɛse a wudii no mu. Na esiane sɛ woahwie mogya bebree agu wɔ mʼanim nti, ɛnyɛ wo na wubesi asɔredan de ahyɛ me din anuonyam. <verse eid="1CH 22:8"/><verse number="9" style="v" sid="1CH 22:9"/>Na wobɛwo ɔbabarima a ne bere so asomdwoe ne ahotɔ bɛba. Mɛma asomdwoe abɛda ɔne nʼatamfo a wɔwɔ nsase a atwa ha ahyia no nyinaa ntam. Wɔbɛfrɛ no Salomo. Nʼahenni mu no, mɛma asomdwoe ne ahotɔ aba Israel. <verse eid="1CH 22:9"/><verse number="10" style="v" sid="1CH 22:10"/>Ɔno ne obi a obesi asɔredan, de ahyɛ me din anuonyam. Ɔbɛyɛ me babarima na mayɛ nʼagya. Na mɛma nʼahenni ahengua atim wɔ Israel afebɔɔ.’<verse eid="1CH 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11"/>“Afei, me ba, <char style="nd">Awurade</char> nka wo ho na ɔmma wo nkɔso bere a wudi nʼahyɛde so, na woresi <char style="nd">Awurade</char>, wo Nyankopɔn, asɔredan yi. <verse eid="1CH 22:11"/><verse number="12" style="v" sid="1CH 22:12"/>Na <char style="nd">Awurade</char> mma wo nyansa ne ntease, na woadi <char style="nd">Awurade</char>, wo Nyankopɔn mmara so bere a wudi Israel so hene yi. <verse eid="1CH 22:12"/><verse number="13" style="v" sid="1CH 22:13"/>Sɛ wudi mmara ne ahyɛde a <char style="nd">Awurade</char> nam Mose so de maa Israel no so yiye a, ebesi wo yiye. Yɛ den na yɛ nnam. Nsuro na mma wo koma ntu.<verse eid="1CH 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 22:14"/>“Mayɛ adwumaden apɛ <char style="nd">Awurade</char> Asɔredan no si ho nneɛma, sikakɔkɔɔ bɛyɛ tɔn mpem anan (4,000), dwetɛ bɛyɛ tɔn mpem aduanan (40,000) ne nnade ne kɔbere mfrafrae pii a wontumi nkari mpo. Maboaboa nnua ne abo a wɔde bɛyɛ afasu no, nanso ebia ɛsɛ sɛ wopɛ bi ka ho. <verse eid="1CH 22:14"/><verse number="15" style="v" sid="1CH 22:15"/>Wowɔ abo adansifo, nnua adwumfo ne nnwuma ahorow mu adwumfo bebree. <verse eid="1CH 22:15"/><verse number="16" style="v" sid="1CH 22:16"/>Wɔyɛ abenfo wɔ sikakɔkɔɔ, dwetɛ adwinni mu, kɔbere mfrafrae ne nnade ho adwumayɛfo. Afei fi adwuma no ase, na <char style="nd">Awurade</char> nka wo ho.”<verse eid="1CH 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17"/>Na Dawid hyɛɛ Israel ntuanofo nyinaa sɛ wɔmmoa Salomo wɔ saa dwumadi no mu. <verse eid="1CH 22:17"/><verse number="18" style="v" sid="1CH 22:18"/>Ɔkae se, “<char style="nd">Awurade</char>, wo Nyankopɔn ka wo ho. Wama asomdwoe aba wo ne aman a atwa wo ho ahyia no ntam. Ɔde wɔn ama me, nti wɔyɛ <char style="nd">Awurade</char> ne ne nkurɔfo nkoa. <verse eid="1CH 22:18"/><verse number="19" style="v" sid="1CH 22:19"/>Afei fi wo koma nyinaa mu hwehwɛ <char style="nd">Awurade</char>, wo Nyankopɔn. Si <char style="nd">Awurade</char> Nyankopɔn kronkronbea sɛnea ɛbɛyɛ a, wubetumi de <char style="nd">Awurade</char> Apam Adaka no ne Onyankopɔn akronkronne no nyinaa akɔ asɔredan a wɔasi de rehyɛ <char style="nd">Awurade</char> din anuonyam no mu.”<verse eid="1CH 22:19"/></para>
  <chapter eid="1CH 22"/>
  <chapter number="23" style="c" sid="1CH 23"/>
  <para style="s1">Lewifo Nnwuma</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1"/>Bere a Dawid bɔɔ akwakoraa no, oyii ne babarima Salomo sɛ ɔno na obedi Israel so hene.<verse eid="1CH 23:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2"/>Dawid frɛfrɛɛ Israel amanyɛ ntuanofo nyinaa ne asɔfo, a Lewifo ka ho sɛ, wɔmmra ahensi afahyɛ no ase. <verse eid="1CH 23:2"/><verse number="3" style="v" sid="1CH 23:3"/>Wɔkan Lewifo a wɔadi mfirihyia aduasa anaa nea ɛboro saa, na wɔn nyinaa dodow yɛ mpem aduasa awotwe. <verse eid="1CH 23:3"/><verse number="4" style="v" sid="1CH 23:4"/>Na Dawid kae se, “Wɔn mu mpem aduonu anan bɛhwɛ <char style="nd">Awurade</char> Asɔredan no ho adwuma so. Mpem asia bɛsom sɛ mpanyimfo ne atemmufo. <verse eid="1CH 23:4"/><verse number="5" style="v" sid="1CH 23:5"/>Mpem anan bɛyɛ apon ano hwɛfo na mpem anan foforo de nnwontode a mayɛ no bɛkamfo <char style="nd">Awurade</char>.”<verse eid="1CH 23:5"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="6" style="v" sid="1CH 23:6"/>Na Dawid kyekyɛɛ Lewifo no mu akuwakuw de mmusuakuw a wɔyɛ Lewi mmabarima Gerson, Kohat ne Merari asefo no din totoo wɔn so.<verse eid="1CH 23:6"/></para>
  <para style="s1">Gersonfo</para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 23:7"/>Gerson mmabarima ne:</para>
  <para style="li2" vid="1CH 23:7">Libni ne Simei.<verse eid="1CH 23:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 23:8"/>Libni asefo no mu baasa yɛ</para>
  <para style="li2" vid="1CH 23:8">Yehiel (a ɔyɛ abusuapanyin), Setam ne Yoel.<verse eid="1CH 23:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 23:9"/>Eyinom na na wɔyɛ Libni abusua no mpanyimfo.</para>
  <para style="li2" vid="1CH 23:9">Na Simei asefo baasa no ne Selomot, Hasiel ne Haran.<verse eid="1CH 23:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 23:10"/>Simei asefo baanan a wɔaka no ne</para>
  <para style="li2" vid="1CH 23:10">Yahat, Sisa, Yeus ne Beria.<verse eid="1CH 23:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 23:11"/>Na Yahat yɛ ɔbeapanyin, na Sisa di Yahat akyi. Wɔfaa Yeus ne Beria sɛ abusua baako, efisɛ na wɔn mu biara nni mmabarima dodow.<verse eid="1CH 23:11"/></para>
  <para style="s1">Kohatfo</para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 23:12"/>Na Amram, Ishar, Hebron ne Usiel ka Kohat asefo no ho.<verse eid="1CH 23:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 23:13"/>Amram mmabarima yɛ:</para>
  <para style="li2" vid="1CH 23:13">Aaron ne Mose.</para>
  <para style="li2" vid="1CH 23:13">Woyii Aaron ne nʼasefo sɛ wonni nneɛma kronkron no ho dwuma, na wɔmmɔ afɔre wɔ <char style="nd">Awurade</char> anim, nsom <char style="nd">Awurade</char>, na wonhyira wɔ ne din mu daa daa. <verse eid="1CH 23:13"/><verse number="14" style="v" sid="1CH 23:14"/>Mose a ɔyɛ Onyankopɔn nipa no de, wɔde ne mmabarima kaa Lewi abusuakuw ho.<verse eid="1CH 23:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 23:15"/>Mose mmabarima no yɛ</para>
  <para style="li2" vid="1CH 23:15">Gersom ne Elieser.<verse eid="1CH 23:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 23:16"/>Na Sebuel a ɔyɛ abusuapanyin no ka Gersom asefo no ho.<verse eid="1CH 23:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 23:17"/>Na Elieser wɔ ɔbabarima baako a wɔfrɛ no Rehabia a na ɔyɛ abusuapanyin.</para>
  <para style="li2" vid="1CH 23:17">Na Rehabia asefo yɛ bebree.<verse eid="1CH 23:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 23:18"/>Na Selomit a ɔyɛ abusuapanyin no ka Ishar asefo no ho.<verse eid="1CH 23:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 23:19"/>Na Yeria a ɔyɛ abusuapanyin,</para>
  <para style="li2" vid="1CH 23:19">Amaria a odi hɔ,</para>
  <para style="li1" vid="1CH 23:19">Yahasiel a ɔto so abiɛsa</para>
  <para style="li2" vid="1CH 23:19">ne Yekameam a ɔto so anan no</para>
  <para style="li2" vid="1CH 23:19">ne Hebron asefo no.<verse eid="1CH 23:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 23:20"/>Na Mika a ɔyɛ abusuapanyin ne Yisia a odi hɔ no</para>
  <para style="li2" vid="1CH 23:20">yɛ Usiel asefo no.<verse eid="1CH 23:20"/></para>
  <para style="s1">Merarifo</para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 23:21"/>Na Mahli ne Musi yɛ</para>
  <para style="li2" vid="1CH 23:21">Merari asefo no.</para>
  <para style="li1" vid="1CH 23:21">Mahli mmabarima ne</para>
  <para style="li2" vid="1CH 23:21">Eleasar ne Kis.<verse eid="1CH 23:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 23:22"/>(Eleasar wui a wanwo mmabarima biara, na mmom mmabea nko ara. Ne mmabea no wareware wɔn nuanom a wɔyɛ Kis mmabarima.)<verse eid="1CH 23:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 23:23"/>Musi mmabarima baasa no din de</para>
  <para style="li2" vid="1CH 23:23">Mahli, Eder ne Yeremot.<verse eid="1CH 23:23"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="24" style="v" sid="1CH 23:24"/>Eyinom na na wɔn mmusua nti wɔyɛ Lewi asefo, na wɔyɛ wɔn mmusua akuw no ntuanofo a na wɔahwɛ akyerɛw wɔn din. Na ɛsɛ sɛ wɔn mu biara di mfirihyia aduonu anaa nea ɛboro saa, ansa na waso <char style="nd">Awurade</char> fi som. <verse eid="1CH 23:24"/><verse number="25" style="v" sid="1CH 23:25"/>Na Dawid kae se, “<char style="nd">Awurade</char>, Israel Nyankopɔn ama yɛn asomdwoe, na daa ɔbɛtena Yerusalem. <verse eid="1CH 23:25"/><verse number="26" style="v" sid="1CH 23:26"/>Afei, ɛho nhia sɛ Lewifo no bɛsoa Ahyiae Ntamadan no ne ne nkuku ne ne nkaka de adi atutena.” <verse eid="1CH 23:26"/><verse number="27" style="v" sid="1CH 23:27"/>Sɛnea Dawid no ara akwankyerɛ a etwa to no se no, ɛsɛ sɛ wɔkyerɛw Lewifo a wɔadi mfirihyia aduonu ne nea ɛboro saa nyinaa din ma ɔsom.<verse eid="1CH 23:27"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="28" style="v" sid="1CH 23:28"/>Na Lewifo no adwuma ne sɛ, wɔbɛboa asɔfo no a wɔyɛ Aaron asefo no wɔ ɔsom nnwuma a wɔyɛ wɔ <char style="nd">Awurade</char> fi no mu. Afei, wɔbɛhwɛ adiwo ne adan a ɛwɔ nkyɛn nkyɛn no so. Na wɔbɛboa ahodwira nnwuma mu, na wɔasom akwan ahorow so wɔ Onyankopɔn fi. <verse eid="1CH 23:28"/><verse number="29" style="v" sid="1CH 23:29"/>Na wɔhwɛ brodo kronkron a wɔkora no didipon so no, asikresiam a wɔayam no muhumuhu a wɔde bɔ aduan afɔre, tetare a mmɔkaw nni mu, ɔfam a wɔde ngo dua srade akyew ne brodo afoforo a wɔde afrafra no so. Afei, na wɔn asɛde bi nso ne sɛ, wɔhwɛ nsania ne susudua nso so. <verse eid="1CH 23:29"/><verse number="30" style="v" sid="1CH 23:30"/>Na anɔpa ne anwummere biara nso, wogyina <char style="nd">Awurade</char> anim to aseda ne nkamfo nnwom ma no. <verse eid="1CH 23:30"/><verse number="31" style="v" sid="1CH 23:31"/>Wɔboa ɔhyew afɔre a wɔbɔ ma <char style="nd">Awurade</char> homeda ahorow mu wɔ Ɔsram Foforo Afahyɛ mu ne nnapɔnna nyinaa ho dwumadi mu. Bere biara, na Lewifo dodow a wɔfata wɔ hɔ a wɔsom wɔ <char style="nd">Awurade</char> anim.<verse eid="1CH 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 23:32"/>Ɛno nti, Lewifo no a na wɔsom wɔ Ahyiae Ntamadan no mu kɔɔ so som wɔ Asɔredan no mu. Na wɔde nokwaredi yɛɛ wɔn som no nnwuma wɔ <char style="nd">Awurade</char> fi.<verse eid="1CH 23:32"/></para>
  <chapter eid="1CH 23"/>
  <chapter number="24" style="c" sid="1CH 24"/>
  <para style="s1">Asɔfo No Nnwuma</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1"/>Sɛnea wɔkyekyɛɛ Aaron asefo a wɔyɛ asɔfo no mu akuwakuw ma wɔsom no ni: Na Aaron mmabarima no yɛ Nadab, Abihu, Eleasar ne Itamar. <verse eid="1CH 24:1"/><verse number="2" style="v" sid="1CH 24:2"/>Nanso Nadab ne Abihu wui a wonni mma ansa na wɔn agya rewu. Enti ɛkaa Eleasar ne Itamar nko ara a na ɛsɛ sɛ wɔyɛ asɔfo. <verse eid="1CH 24:2"/><verse number="3" style="v" sid="1CH 24:3"/>Mmoa a Sadok a na ɔyɛ Eleasar aseni ne Ahimelek a na ɔyɛ Itamar aseni no boae no nti, Dawid kyekyɛɛ Aaron asefo mu akuwakuw sɛnea wɔn dwumadi te. <verse eid="1CH 24:3"/><verse number="4" style="v" sid="1CH 24:4"/>Wɔkyɛɛ Itamar de mu akuw awotwe, efisɛ na Eleasar asefo mu mmusua mpanyimfo no dɔɔso. <verse eid="1CH 24:4"/><verse number="5" style="v" sid="1CH 24:5"/>Wɔnam ntontobɔ kronkron so, kyekyɛɛ dwumadi ahorow nyinaa maa akuwakuw no, sɛnea ɛrenyɛ nhwɛanimsɛm biara. Efisɛ na mpanyimfo bebree a wɔfata sɛ wɔsom Onyankopɔn kronkronbea hɔ a wɔyɛ Eleasar ne Itamar asefo no nso wɔ hɔ.<verse eid="1CH 24:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 24:6"/>Netanel babarima Semaia a na ɔyɛ Lewini no yɛɛ adwuma sɛ ɔkyerɛwfo. Ɔkyerɛw din ne nnwuma ahorow wɔ ɔhene no ne ɔsɔfo Sadok ne Abiatar babarima Ahimelek ne asɔfo no ne Lewi mmusua no mpanyimfo anim. Eleasar ne Itamar asefo bobɔɔ ntonto sɛnea edidi so yi:<verse eid="1CH 24:6"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 24:7"/>Ntonto a edi kan no bɔɔ Yehoiarib.</para>
  <para style="li1" vid="1CH 24:7">Ntonto a ɛto so abien no bɔɔ Yedaia.<verse eid="1CH 24:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 24:8"/>Ntonto a ɛto so abiɛsa no bɔɔ Harim.</para>
  <para style="li1" vid="1CH 24:8">Ntonto a ɛto so anan no bɔɔ Seorim.<verse eid="1CH 24:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 24:9"/>Ntonto a ɛto so anum no bɔɔ Malkia.</para>
  <para style="li1" vid="1CH 24:9">Ntonto a ɛto so asia no bɔɔ Miyamin.<verse eid="1CH 24:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 24:10"/>Ntonto a ɛto so ason no bɔɔ Hakos.</para>
  <para style="li1" vid="1CH 24:10">Ntonto a ɛto so awotwe no bɔɔ Abia.<verse eid="1CH 24:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 24:11"/>Ntonto a ɛto so akron no bɔɔ Yesua.</para>
  <para style="li1" vid="1CH 24:11">Ntonto a ɛto so du no bɔɔ Sekania.<verse eid="1CH 24:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 24:12"/>Ntonto a ɛto so dubaako no bɔɔ Eliasib.</para>
  <para style="li1" vid="1CH 24:12">Ntonto a ɛto so dumien no bɔɔ Yakim.<verse eid="1CH 24:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 24:13"/>Ntonto a ɛto so dumiɛnsa no bɔɔ Hupa.</para>
  <para style="li1" vid="1CH 24:13">Ntonto a ɛto so dunan no bɔɔ Yesebeab.<verse eid="1CH 24:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 24:14"/>Ntonto a ɛto so dunum no bɔɔ Bilga.</para>
  <para style="li1" vid="1CH 24:14">Ntonto a ɛto so dunsia no bɔɔ Imer.<verse eid="1CH 24:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 24:15"/>Ntonto a ɛto so dunson no bɔɔ Hesir.</para>
  <para style="li1" vid="1CH 24:15">Ntonto a ɛto so dunwɔtwe no bɔɔ Hapises.<verse eid="1CH 24:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 24:16"/>Ntonto a ɛto so dunkron no bɔɔ Petahia.</para>
  <para style="li1" vid="1CH 24:16">Ntonto a ɛto so aduonu no bɔɔ Yeheskel.<verse eid="1CH 24:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 24:17"/>Ntonto a ɛto so aduonu baako no bɔɔ Yakin.</para>
  <para style="li1" vid="1CH 24:17">Ntonto a ɛto so aduonu abien no bɔɔ Gamul.<verse eid="1CH 24:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 24:18"/>Ntonto a ɛto so aduonu abiɛsa no bɔɔ Delaia.</para>
  <para style="li1" vid="1CH 24:18">Ntonto a ɛto so aduonu anan no bɔɔ Maasia.<verse eid="1CH 24:18"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19"/>Kuw biara dii ne dwuma wɔ <char style="nd">Awurade</char> fi sɛnea wɔn agya Aaron nam <char style="nd">Awurade</char>, Israel Nyankopɔn akwankyerɛ so hyehyɛ maa wɔn no.<verse eid="1CH 24:19"/></para>
  <para style="s1">Lewi Mmusua Mpanyimfo</para>
  <para style="li4">
    <verse number="20" style="v" sid="1CH 24:20"/>Eyinom ne mmusua a aka a wɔyɛ Lewi asefo no mpanyimfo:</para>
  <para style="b" vid="1CH 24:20"/>
  <para style="li1" vid="1CH 24:20">Amram asefo ntuanoni ne Subael.</para>
  <para style="li2" vid="1CH 24:20">Subael asefo ntuanoni ne Yehdeia.<verse eid="1CH 24:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 24:21"/>Rehabia asefo ntuanoni ne Yisia.<verse eid="1CH 24:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 24:22"/>Yishar asefo ntuanoni ne Selomot.</para>
  <para style="li2" vid="1CH 24:22">Selomot asefo ntuanoni ne Yahat.<verse eid="1CH 24:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 24:23"/>Hebron asefo ntuanofo ne:</para>
  <para style="li2" vid="1CH 24:23">Yeria; Amaria ne nʼabediakyiri, Yahasiel na ɔto so abiɛsa na Yekameam to so anan.<verse eid="1CH 24:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 24:24"/>Usiel asefo ntuanoni ne Mika.</para>
  <para style="li2" vid="1CH 24:24">Mika asefo ntuanoni ne Samir<verse eid="1CH 24:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 24:25"/>ne Mika nuabarima Yisia.</para>
  <para style="li2" vid="1CH 24:25">Yisia asefo ntuanoni ne Sakaria.<verse eid="1CH 24:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 24:26"/>Merari asefo ntuanofo ne Mahli ne Musi.</para>
  <para style="li2" vid="1CH 24:26">Yasia asefo ntuanoni ne Beno.<verse eid="1CH 24:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 24:27"/>Merari asefo a wofi Yasia mu no, ntuanofo no ne:</para>
  <para style="li2" vid="1CH 24:27">Beno, Soham, Sakur ne Ibri.<verse eid="1CH 24:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 24:28"/>Mahli asefo ntuanoni ne Eleasar a na onni mmabarima no.<verse eid="1CH 24:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 24:29"/>Kis asefo ntuanoni ne Yerahmeel.<verse eid="1CH 24:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 24:30"/>Musi asefo ntuanofo ne Mahli, Eder ne Yerimot.</para>
  <para style="b" vid="1CH 24:30"/>
  <para style="li4" vid="1CH 24:30">Eyinom ne Lewi asefo ne sɛnea wɔn mmusua te.<verse eid="1CH 24:30"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="31" style="v" sid="1CH 24:31"/>Wɔnam ntonto kronkron a wɔbɔɔ wɔ wɔn so na wɔde wɔn nnwuma hyɛɛ wɔn nsa te sɛ Aaron asefo de no, a wɔanhwɛ mfe a wɔadi ne wɔn dibea. Wodii dwuma no wɔ ɔhene Dawid, Sadok, Ahimelek, asɔfo ne Lewifo mmusua mpanyimfo no anim.<verse eid="1CH 24:31"/></para>
  <chapter eid="1CH 24"/>
  <chapter number="25" style="c" sid="1CH 25"/>
  <para style="s1">Nnwontofo No Nnwuma</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1"/>Dawid ne asahene no yiyii mmarima fii Asaf, Heman ne Yedutun mmusua mu sɛ wɔmfa asankuten, mmɛnta ne kyɛnkyɛn mmɔ Onyankopɔn asɛm no dawuru. Wɔn din ne wɔn nnwuma na edidi so yi:<verse eid="1CH 25:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 25:2"/>Na Asaf mmabarima no ne:</para>
  <para style="li2" vid="1CH 25:2">Sakur, Yosef, Netania ne Asarela. Na wɔhyɛ wɔn agya Asaf ase. Ɔno na ɔhene hyɛɛ no ma ɔbɔɔ Onyankopɔn asɛm no dawuru.<verse eid="1CH 25:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 25:3"/>Na Yedutun wɔ mmabarima a wɔne:</para>
  <para style="li2" vid="1CH 25:3">Gedalia, Seri, Yesaia, Simei, Hasabia ne Matitia. Wɔyɛ baasia a wɔhyɛ wɔn agya ase. Ɔno na ɔhyɛɛ nkɔm, nam sankuten so de aseda ne nkamfo maa <char style="nd">Awurade</char>.<verse eid="1CH 25:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 25:4"/>Na Heman mmabarima din ne:</para>
  <para style="li2" vid="1CH 25:4">Bukia, Matania, Usiel, Sebuel, Yerimot, Hanania, Hanani, Eliata, Gidalti, Romamti-Eser, Yosbekasa, Maloti, Hotir, ne Mahasiot. <verse eid="1CH 25:4"/><verse number="5" style="v" sid="1CH 25:5"/>Eyinom ne Heman a ɔyɛ ɔhene diyifo no mmabarima. Onyankopɔn dom no mmabarima dunan ne mmabea baasa.<verse eid="1CH 25:5"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="6" style="v" sid="1CH 25:6"/>Na saa mmarima yi nyinaa hyɛ wɔn agyanom ase, na wɔnam so too nnwom wɔ <char style="nd">Awurade</char> fi. Wɔn nnwuma ne sɛ wɔbɔ kyɛnkyɛn, mmɛnta ne asankuten wɔ Onyankopɔn fi.</para>
  <para style="p" vid="1CH 25:6">Na Asaf, Yedutun ne Heman hyɛ ɔhene no ase. <verse eid="1CH 25:6"/><verse number="7" style="v" sid="1CH 25:7"/>Na wɔatetew wɔn ne wɔn abusuafo nyinaa wɔ nnwom a wɔto wɔ <char style="nd">Awurade</char> anim no mu. Na wɔn nyinaa dodow yɛ ahannu aduɔwɔtwe awotwe na wɔn mu biara wɔ nnwonto ho nimdeɛ. <verse eid="1CH 25:7"/><verse number="8" style="v" sid="1CH 25:8"/>Wɔnam ntontobɔ kronkron so yiyii nnwontofo tuatuaa nnwuma ahorow ano a wɔanhwɛ sɛ obi yɛ abofra anaa ɔpanyin, ɔkyerɛkyerɛfo anaa osuani.<verse eid="1CH 25:8"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 25:9"/>Ntonto a edi kan no bɔɔ Yosef a ofi Asaf abusua mu, ne ne mmabarima ne nʼabusuafo (12)</para>
  <para style="li1" vid="1CH 25:9">Ntonto a ɛto so abien no bɔɔ Gedalia, ne ne mmabarima ne nʼabusuafo (12)<verse eid="1CH 25:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 25:10"/>Ntonto a ɛto so abiɛsa no bɔɔ Sakur, ne ne mmabarima ne nʼabusuafo (12)<verse eid="1CH 25:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 25:11"/>Ntonto a ɛto so anan no bɔɔ Yisri, ne ne mmabarima ne nʼabusuafo (12)<verse eid="1CH 25:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 25:12"/>Ntonto a ɛto so anum no bɔɔ Netania, ne ne mmabarima ne nʼabusuafo (12)<verse eid="1CH 25:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 25:13"/>Ntonto a ɛto so asia no bɔɔ Bukia, ne ne mmabarima ne nʼabusuafo (12)<verse eid="1CH 25:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 25:14"/>Ntonto a ɛto so ason no bɔɔ Yesarela, ne ne mmabarima ne nʼabusuafo (12)<verse eid="1CH 25:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 25:15"/>Ntonto a ɛto so awotwe no bɔɔ Yesaia, ne ne mmabarima ne nʼabusuafo (12)<verse eid="1CH 25:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 25:16"/>Ntonto a ɛto so akron no bɔɔ Matania, ne ne mmabarima ne nʼabusuafo (12)<verse eid="1CH 25:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 25:17"/>Ntonto a ɛto so du no bɔɔ Simei, ne ne mmabarima ne nʼabusuafo (12)<verse eid="1CH 25:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 25:18"/>Ntonto a ɛto so dubaako no bɔɔ Asarel, ne ne mmabarima ne nʼabusuafo (12)<verse eid="1CH 25:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 25:19"/>Ntonto a ɛto so dumien no bɔɔ Hasabia, ne ne mmabarima ne nʼabusuafo (12)<verse eid="1CH 25:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 25:20"/>Ntonto a ɛto so dumiɛnsa no bɔɔ Subael, ne ne mmabarima ne nʼabusuafo (12)<verse eid="1CH 25:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 25:21"/>Ntonto a ɛto so dunan no bɔɔ Matitia, ne ne mmabarima ne nʼabusuafo (12)<verse eid="1CH 25:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 25:22"/>Ntonto a ɛto so dunum no bɔɔ Yeremot, ne ne mmabarima ne nʼabusuafo (12)<verse eid="1CH 25:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 25:23"/>Ntonto a ɛto so dunsia no bɔɔ Hanania, ne ne mmabarima ne nʼabusuafo (12)<verse eid="1CH 25:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 25:24"/>Ntonto a ɛto so dunson no bɔɔ Yosbekasa, ne ne mmabarima ne nʼabusuafo (12)<verse eid="1CH 25:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 25:25"/>Ntonto a ɛto so dunwɔtwe no bɔɔ Hanani, ne ne mmabarima ne nʼabusuafo (12)<verse eid="1CH 25:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 25:26"/>Ntonto a ɛto so dunkron no bɔɔ Maloti, ne ne mmabarima ne nʼabusuafo (12)<verse eid="1CH 25:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 25:27"/>Ntonto a ɛto so aduonu no bɔɔ Eliata, ne ne mmabarima ne nʼabusuafo (12)<verse eid="1CH 25:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 25:28"/>Ntonto a ɛto so aduonu baako no bɔɔ Hotir, ne ne mmabarima ne nʼabusuafo (12)<verse eid="1CH 25:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 25:29"/>Ntonto a ɛto so aduonu abien no bɔɔ Gidalti, ne ne mmabarima ne nʼabusuafo (12)<verse eid="1CH 25:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 25:30"/>Ntonto a ɛto so aduonu abiɛsa no bɔɔ Mahasiot, ne ne mmabarima ne nʼabusuafo (12)<verse eid="1CH 25:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 25:31"/>Ntonto a ɛto so aduonu anan no bɔɔ Romamti-Eser ne ne mmabarima ne nʼabusuafo (12)<verse eid="1CH 25:31"/></para>
  <chapter eid="1CH 25"/>
  <chapter number="26" style="c" sid="1CH 26"/>
  <para style="s1">Apon Ano Ahwɛfo Nnwuma</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 26:1"/>Eyinom ne apon ano ahwɛfo no akuwakuw:</para>
  <para style="b" vid="1CH 26:1"/>
  <para style="li4" vid="1CH 26:1">Korafo mu no,</para>
  <para style="li1" vid="1CH 26:1">yɛwɔ Kore babarima Meselemia a ofi Asaf abusua mu. <verse eid="1CH 26:1"/><verse number="2" style="v" sid="1CH 26:2"/>Meselemia mmabarima yɛ:</para>
  <para style="li2" vid="1CH 26:2">Sakaria a ɔyɛ abakan, Yediael a ɔto so abien,</para>
  <para style="li2" vid="1CH 26:2">Sebadia a ɔto so abiɛsa, Yatniel a ɔto so anan.<verse eid="1CH 26:2"/></para>
  <para style="li2">
    <verse number="3" style="v" sid="1CH 26:3"/>Elam a ɔto so anum, Yehohanan a ɔto so asia,</para>
  <para style="li2" vid="1CH 26:3">Eliehoenai a ɔto so ason.<verse eid="1CH 26:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 26:4"/>Na Obed-Edom mmabarima nso a wɔyɛ apon ano ahwɛfo yɛ:</para>
  <para style="li2" vid="1CH 26:4">Semaia a ɔyɛ abakan, Yehosabad a ɔto so abien,</para>
  <para style="li2" vid="1CH 26:4">Yoa a ɔto so abiɛsa, Sakar a ɔto so anan,</para>
  <para style="li2" vid="1CH 26:4">Netanel a ɔto so anum, <verse eid="1CH 26:4"/><verse number="5" style="v" sid="1CH 26:5"/>Amiel a ɔto so asia,</para>
  <para style="li2" vid="1CH 26:5">Isakar a ɔto so ason, ne Peuletai a ɔto so awotwe.</para>
  <para style="li2" vid="1CH 26:5">Onyankopɔn hyiraa Obed-Edom bebree.<verse eid="1CH 26:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 26:6"/>Na Obed-Edom babarima Semaia wɔ mmabarima a wotumi ade yɛ yiye nti, wonyaa dibea a ekura tumi wɔ abusua no mu. <verse eid="1CH 26:6"/><verse number="7" style="v" sid="1CH 26:7"/>Na wɔn din ne:</para>
  <para style="li2" vid="1CH 26:7">Otni, Refael, Obed ne Elsabad;</para>
  <para style="li2" vid="1CH 26:7">na wɔn abusuafo Elihu ne Semaia nso yɛ mmɔdemmɔfo.<verse eid="1CH 26:7"/></para>
  <para style="li4">
    <verse number="8" style="v" sid="1CH 26:8"/>Obed-Edom asefo yi nyinaa a wɔn mmabarima ne wɔn nenanom a na wɔn nyinaa dodow yɛ aduosia abien (62) no yɛ nnipa a na wɔbɔ wɔn ho mmɔden yiye na wɔn nnwuma fata wɔn.<verse eid="1CH 26:8"/></para>
  <para style="li4">
    <verse number="9" style="v" sid="1CH 26:9"/>Saa ara nso na na Meselemia mmabarima dunwɔtwe (18) no ne wɔn abusuafo nso bɔ wɔn ho mmɔden yiye.<verse eid="1CH 26:9"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 26:10"/>Hosa a ofi Merari abusua mu mma ne: Simri na odi kan (na ɔnyɛ abakan de, nanso nʼagya paw no sɛ ntuanoni wɔ ne mmabarima mu).<verse eid="1CH 26:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 26:11"/>Na ne mmabarima no bi ne:</para>
  <para style="li2" vid="1CH 26:11">Hilkia a na ɔto so abien. Tebalia na ɔto so abiɛsa</para>
  <para style="li2" vid="1CH 26:11">na Sakaria to so anan.</para>
  <para style="li4" vid="1CH 26:11">Na Hosa mmabarima ne nʼabusuafo a wɔsom sɛ apon ano ahwɛfo no nyinaa dodow yɛ dumiɛnsa (13).<verse eid="1CH 26:11"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="12" style="v" sid="1CH 26:12"/>Saa apon ano hwɛfo akuw yi nam wɔn mmusua ntuanofo so som wɔ <char style="nd">Awurade</char> fi, sɛnea wɔn abusuafo yɛe no. <verse eid="1CH 26:12"/><verse number="13" style="v" sid="1CH 26:13"/>Wɔnam ntontobɔ kronkron so, de ɔwɛn adwuma wɔ apon ahorow ano hyɛɛ mmusua no nsa a wɔnhwɛ mfirihyia a obi adi, anaa ntetewee a wanya so.<verse eid="1CH 26:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 26:14"/>Wɔde apuei pon ho dwumadi no hyɛɛ Meslemia ne ne kuw nsa.</para>
  <para style="li1" vid="1CH 26:14">Atifi pon ho dwumadi nso, wɔde hyɛɛ ne babarima onyansafo Sakaria nsa.<verse eid="1CH 26:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 26:15"/>Anafo pon<note caller="+" style="f"><char style="fr" closed="false">26.15 </char><char style="ft" closed="false">Anafo pon. Dawid ne Salomo ahemfi no na ɛwɔ asɔredan no anafo fam. Saa anafo pon no mu na na ɔhene no fa. Saa ɔpon yi anohwɛ dwumadi no yɛ anuonyamhyɛ ma Obed Edom. (<char style="xt"><ref loc="1CH 26:4-6">26.4-6</ref>; <ref loc="EZK 46:1-10">Hes 46.1-10</ref></char>)</char></note> no, wɔde hyɛɛ Obed-Edom nsa, na wɔmaa ne mmabarima no hwɛɛ adekoradan no so.<verse eid="1CH 26:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 26:16"/>Wɔmaa Supim ne Hosa hwɛɛ atɔe pon no ne ɔkwan a ɛkɔ asɔredan no mu no so.</para>
  <para style="b" vid="1CH 26:16"/>
  <para style="li4" vid="1CH 26:16">Wɔkyekyɛɛ ɔwɛn nnwuma no pɛpɛɛpɛ maa wɔn.<verse eid="1CH 26:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 26:17"/>Da biara, na wɔma Lewifo baasia kɔ apuei pon no ho,</para>
  <para style="li1" vid="1CH 26:17">na wɔma baanan kɔ atifi pon no ho,</para>
  <para style="li1" vid="1CH 26:17">na baanan nso akɔ anafo pon no ho,</para>
  <para style="li1" vid="1CH 26:17">na baanu baanu akokɔ adekoradan ahorow no mu biara ho.<verse eid="1CH 26:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 26:18"/>Da biara, na wɔma baasia kɔ atɔe pon no ho. Baanan kɔ ɔkwan a ɛkɔ asɔredan no mu no so, na baanu nso akɔ adiwo hɔ.<verse eid="1CH 26:18"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="19" style="v" sid="1CH 26:19"/>Eyinom ne apon ano ahwɛfo a wofi Kora ne Merari mmusua mu no nkyekyɛmu.<verse eid="1CH 26:19"/></para>
  <para style="s1">Fotosanfo Ne Adwumayɛfo Nkae</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20"/>Lewifo a wɔaka a na Ahiya da wɔn ano no na na wɔhwɛ Onyankopɔn fi sikakorabea ne adekoradan so.<verse eid="1CH 26:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 26:21"/>Libni fi a na ɛwɔ Gerson abusua mu no, na Yehieli na na otua wɔn ano. <verse eid="1CH 26:21"/><verse number="22" style="v" sid="1CH 26:22"/>Yehieli mmabarima Setam ne ne nuabarima Yoel na na wɔhwɛ <char style="nd">Awurade</char> fi sikakorabea so.<verse eid="1CH 26:22"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="23" style="v" sid="1CH 26:23"/>Eyinom ne ntuanofo a wɔyɛ Amram, Yishar, Hebron ne Usiel asefo.<verse eid="1CH 26:23"/></para>
  <para style="b"/>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 26:24"/>Amram abusua mu, Sebuel yɛ Mose babarima Gersom aseni. Ɔno na na ɔyɛ ɔpanyin a ɔhwɛ sikakorabea no so. <verse eid="1CH 26:24"/><verse number="25" style="v" sid="1CH 26:25"/>Wɔn a wɔnam Elieser so yɛ nʼabusuafo ne Rehabia, Yesaia, Yoram, Sikri ne Selomot.<verse eid="1CH 26:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 26:26"/>Selomot ne nʼabusuafo na na wɔhwɛ sikakorabea a na wɔkora agyapade a wɔde ama <char style="nd">Awurade</char> no so. Agyapade no bi ne nea Dawid ne mmusua ntuanofo ne asahene ne asraafo mpanyimfo de maa <char style="nd">Awurade</char> no. <verse eid="1CH 26:26"/><verse number="27" style="v" sid="1CH 26:27"/>Na saa mmarima yi de wɔn asade a wonyaa wɔ akodi mu no bi bae sɛ wɔmfa nsiesie <char style="nd">Awurade</char> fi. <verse eid="1CH 26:27"/><verse number="28" style="v" sid="1CH 26:28"/>Afei, na Selomot ne nʼabusuafo na wɔhwɛ nneɛma a Samuel a ɔyɛ odiyifo, Kis babarima Saulo, Ner babarima Abner ne Seruia babarima Yoab de maa <char style="nd">Awurade</char> no so. Nneɛma nkae a wɔde maa <char style="nd">Awurade</char> no nyinaa, na ɛhyɛ wɔn nsa.<verse eid="1CH 26:28"/></para>
  <para style="li2">
    <verse number="29" style="v" sid="1CH 26:29"/>Yishar abusua mu na Kenania fi.</para>
  <para style="li2" vid="1CH 26:29">Ɔne ne mmabarima na woyii wɔn sɛ ɔman sohwɛfo ne atemmufo wɔ Israelman mu nyinaa.<verse eid="1CH 26:29"/></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 26:30"/>Hebron abusua mu na Hasabia fi. Ɔne nʼabusuafo a wɔyɛ mmɔdemmɔfo a wɔn dodow yɛ apem ahanson na wɔma wɔhwɛɛ Israel nsase a ɛdeda Asubɔnten Yordan atɔe fam no so. Nsɛm a ɛfa <char style="nd">Awurade</char> ho, ne ɔhene a ɔwɔ mpasua no so som ho nyinaa yɛ wɔn asɛde. <verse eid="1CH 26:30"/><verse number="31" style="v" sid="1CH 26:31"/>Bio, Hebron abusua mu na Yeria fi. Sɛnea awo ntoatoaso nkrataa kyerɛ no, ɔno na na ɔyɛ Hebronfo no ntuanoni.</para>
  <para style="li2" vid="1CH 26:31">(Dawid dii hene no, ne mfe aduanan so, wɔhwehwɛɛ nkrataa mu na wohuu mmarima a wɔbɔ wɔn ho mmɔden wɔ Hebron abusua no mu din wɔ kurow Yaser a ɛwɔ Gilead mu. <verse eid="1CH 26:31"/><verse number="32" style="v" sid="1CH 26:32"/>Na mmarima a wɔbɔ wɔn ho mmɔden mpem abien ne ahanson na na wɔwɔ Yeria abusua mu. Ɔhene Dawid ma wɔkɔɔ Asubɔnten Yordan apuei fam, maa wɔkɔhwɛɛ Ruben ne Gad mmusuakuw ne Manase abusuakuw fa no so. Nsɛm a ɛfa Onyankopɔn ho, ne ɔhene som ho nyinaa yɛ wɔn asɛde.)<verse eid="1CH 26:32"/></para>
  <chapter eid="1CH 26"/>
  <chapter number="27" style="c" sid="1CH 27"/>
  <para style="s1">Asahene Ne Wɔn Akuw</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 27:1"/>Israelfo akuw ahorow no ni—mmusua mpanyimfo, asahene ne asraafo mpanyimfo a na wɔhwɛ asraafo akuw ahorow so de som ɔhene, a kuw biara kɔ adwuma ɔsram baako wɔ afe mu. Na dɔm a wɔwɔ kuw biara mu nso dodow yɛ mpem aduonu anan (24,000). Wɔn din na edidi so yi.<verse eid="1CH 27:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 27:2"/>Sabdiel babarima Yasobeam na na ɔyɛ kuw a edi kan no sahene, a na wɔkɔ adwuma ɔsram a edi kan wɔ afe no mu. Na ne kuw no asraafodɔm dodow yɛ mpem aduonu anan (24,000). <verse eid="1CH 27:2"/><verse number="3" style="v" sid="1CH 27:3"/>Na ɔyɛ Peres aseni a na ɔhwɛ asraafo mpanyimfo no nyinaa so ɔsram a edi kan no mu.<verse eid="1CH 27:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 27:4"/>Dodai a na ɔyɛ Ahoa aseni na na ɔyɛ kuw a ɛto so abien a na wɔkɔ adwuma ɔsram a ɛto so abien mu no so sahene. Na ne kuw no asraafodɔm dodow yɛ mpem aduonu anan (24,000), a na Miklot yɛ nʼabediakyiri.<verse eid="1CH 27:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 27:5"/>Ɔsɔfo Yehoiada babarima Benaia na na ɔyɛ kuw a ɛto so abiɛsa a na wɔkɔ adwuma ɔsram a ɛto so abiɛsa mu no so sahene. Na ne kuw no asraafodɔm dodow yɛ mpem aduonu anan (24,000). <verse eid="1CH 27:5"/><verse number="6" style="v" sid="1CH 27:6"/>Saa Benaia yi na na ɔhwɛ Dawid asraafo akunini kuw, a na wɔfrɛ wɔn Akofo Akɛse Aduasa no so. Ne babarima Amisabad na na ɔyɛ nʼabediakyiri.<verse eid="1CH 27:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 27:7"/>Yoab nuabarima Asahel na na ɔyɛ kuw a ɛto so anan, a na wɔkɔ adwuma ɔsram a ɛto so anan mu no so sahene. Na ne kuw no asraafodɔm dodow yɛ mpem aduonu anan (24,000). Asahel babarima Sebadia na odii nʼade.<verse eid="1CH 27:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 27:8"/>Samhut a ɔyɛ Yisrahini na na ɔyɛ kuw a ɛto so anum, a na wɔkɔ adwuma ɔsram a ɛto so anum mu no so sahene. Na ne kuw no asraafodɔm dodow yɛ mpem aduonu anan (24,000).<verse eid="1CH 27:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 27:9"/>Ikes babarima Ira a ofi Tekoa no na na ɔyɛ kuw a ɛto so asia, a na wɔkɔ adwuma ɔsram a ɛto so asia mu no sahene. Na ne kuw no asraafodɔm dodow yɛ mpem aduonu anan (24,000).<verse eid="1CH 27:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 27:10"/>Heles a na ɔyɛ Efraim aseni a ofi Pelon no na na ɔyɛ kuw a ɛto so ason, a na wɔkɔ adwuma ɔsram a ɛto so ason mu no so sahene. Na ne kuw no asraafodɔm dodow yɛ mpem aduonu anan (24,000).<verse eid="1CH 27:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 27:11"/>Sibekai a na ɔyɛ Sera aseni a ofi Husa no na na ɔyɛ kuw a ɛto so awotwe, a na wɔkɔ adwuma ɔsram a ɛto so awotwe mu no so sahene. Na ne kuw no asraafodɔm dodow yɛ mpem aduonu anan (24,000).<verse eid="1CH 27:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 27:12"/>Abieser a na ofi Anatot a ɛda Benyamin asase so no na na ɔyɛ kuw a ɛto so akron, a na wɔkɔ adwuma ɔsram a ɛto so akron mu no so sahene. Na ne kuw no asraafodɔm dodow yɛ mpem aduonu anan (24,000).<verse eid="1CH 27:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 27:13"/>Maharai a ɔyɛ Serah aseni a ofi Netofa no na na ɔyɛ kuw a ɛto so du, a na wɔkɔ adwuma ɔsram a ɛto so du mu no so sahene. Na ne kuw no asraafodɔm dodow yɛ mpem aduonu anan (24,000).<verse eid="1CH 27:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 27:14"/>Benaia a ofi Piraton a ɛwɔ Efraim no na na ɔyɛ kuw a ɛto so dubaako, a na wɔkɔ adwuma ɔsram a ɛto so dubaako mu no so sahene. Na ne kuw no asraafodɔm dodow yɛ mpem aduonu anan (24,000).<verse eid="1CH 27:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 27:15"/>Heldai a ɔyɛ Otniel a ofi Netofa aseni no na na ɔyɛ kuw a ɛto so dumien, a na wɔkɔ adwuma ɔsram a ɛto so dumien mu no so sahene. Na ne kuw no asraafodɔm dodow yɛ mpem aduonu anan (24,000).<verse eid="1CH 27:15"/></para>
  <para style="s1">Mmusuakuw No Ntuanofo</para>
  <para style="li4">
    <verse number="16" style="v" sid="1CH 27:16"/>Mmusuakuw no ne wɔn ntuanofo ni:</para>
  <para style="b" vid="1CH 27:16"/>
  <para style="li1" vid="1CH 27:16">Ruben abusuakuw: Sikri babarima Elieser;</para>
  <para style="li1" vid="1CH 27:16">Simeon abusuakuw: Maaka babarima Sefatia;<verse eid="1CH 27:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 27:17"/>Lewi abusuakuw: Kemuel babarima Hasabia;</para>
  <para style="li1" vid="1CH 27:17">Aaron (asɔfo no) abusuakuw: Sadok;<verse eid="1CH 27:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 27:18"/>Yuda abusuakuw: Dawid nuabarima Elihu;</para>
  <para style="li1" vid="1CH 27:18">Isakar abusuakuw: Mikael babarima Omri;<verse eid="1CH 27:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 27:19"/>Sebulon abusuakuw: Obadia babarima Yismaia;</para>
  <para style="li1" vid="1CH 27:19">Naftali abusuakuw: Asriel babarima Yerimot;<verse eid="1CH 27:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 27:20"/>Efraim abusuakuw: Asasia babarima Hosea;</para>
  <para style="li1" vid="1CH 27:20">Manase (atɔe fam) abusuakuw: Pedaia babarima Yoel;<verse eid="1CH 27:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 27:21"/>Manase (apuei fam) abusuakuw Sakaria babarima Ido;</para>
  <para style="li1" vid="1CH 27:21">Benyamin abusuakuw: Abner babarima Yaasiel;<verse eid="1CH 27:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 27:22"/>Dan abusuakuw: Yeroham babarima Asarel.</para>
  <para style="b" vid="1CH 27:22"/>
  <para style="li4" vid="1CH 27:22">Eyinom ne Israel mmusuakuw no ne wɔn ntuanofo.<verse eid="1CH 27:22"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23"/>Bere a Dawid ma wɔkan nnipa no, wɔankan wɔn a wonnii mfe aduonu, efisɛ na <char style="nd">Awurade</char> ahyɛ bɔ sɛ ɔbɛma Israelfo no adɔɔso sɛ ɔsoro nsoromma. <verse eid="1CH 27:23"/><verse number="24" style="v" sid="1CH 27:24"/>Yoab na ofii nnipakan no ase, nanso wanwie, efisɛ Onyankopɔn bo fuw Israel. Wɔankyerɛw nnipa no nyinaa dodow angu Ɔhene Dawid nkrataa mu.<verse eid="1CH 27:24"/></para>
  <para style="s1">Dawid Ahenni Mu Mpanyimfo</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 27:25"/>Adiel babarima Asmawet na na ɔhwɛ ahemfi sikakorabea so.</para>
  <para style="li1" vid="1CH 27:25">Usia babarima Yonatan no na na ɔhwɛ ɔmantam no sikakorabea a ɛwowɔ nkurow, nkuraa ne aban a ɛwɔ Israel nyinaa so.<verse eid="1CH 27:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 27:26"/>Kelub babarima Esri na na ɔhwɛ apaafo a na wɔdɔw ɔhene mfuw so.<verse eid="1CH 27:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 27:27"/>Simei a na ofi Rama na na ɔhwɛ ɔhene bobe mfuw so.</para>
  <para style="li1" vid="1CH 27:27">Sabdi a ofi Sifim na na ɔhwɛ aba a wɔde yɛ nsa ne nsa a wɔayɛ so.<verse eid="1CH 27:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 27:28"/>Baal-Hanan a ofi Geder no na na ɔhwɛ ɔhene ngonnua ne ankye nnua a na ɛwɔ Yuda bepɔw ase no so.</para>
  <para style="li1" vid="1CH 27:28">Yoas na na ɔhwɛ ma wɔyɛ ngo.<verse eid="1CH 27:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 27:29"/>Sitrai a ofi Saron na na ɔhwɛ anantwi a na wɔwɔ Saron sare so no so.</para>
  <para style="li1" vid="1CH 27:29">Adlai babarima Safat na na ɔhwɛ anantwi a wɔwɔ abon ahorow mu no so.<verse eid="1CH 27:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 27:30"/>Ismaelni Obil na na ɔhwɛ yoma so.</para>
  <para style="li1" vid="1CH 27:30">Yehdia a ofi Meronot na na ɔhwɛ mfurum so.<verse eid="1CH 27:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 27:31"/>Yasis a ofi Hagar na na ɔhwɛ ɔhene nguan so.</para>
  <para style="li4" vid="1CH 27:31">Saa mpanyimfo yi nyinaa na na wɔhwɛ ɔhene Dawid agyapade so.<verse eid="1CH 27:31"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 27:32"/>Yonatan a na ɔyɛ Dawid wɔfa no yɛɛ ɔfotufo nyansafo maa ɔhene. Na ɔyɛ ɔkyerɛwfo a ɔwɔ nhumu.</para>
  <para style="li1" vid="1CH 27:32">Na Hakmoni babarima Yehiel na na ɔkyerɛ ɔhene mmabarima ade.<verse eid="1CH 27:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 27:33"/>Ahitofel na na ɔyɛ ɔhene fotufo.</para>
  <para style="li1" vid="1CH 27:33">Na Husai a ofi Arki yɛ ɔhene adamfo.<verse eid="1CH 27:33"/></para>
  <para style="li4">
    <verse number="34" style="v" sid="1CH 27:34"/>Benaia babarima Yehoiada na odii Ahitofel ade na Abiatar bɛtoaa adedi no so.</para>
  <para style="li1" vid="1CH 27:34">Yoab na na ɔyɛ Israel asraafodɔm no so sahene.<verse eid="1CH 27:34"/></para>
  <chapter eid="1CH 27"/>
  <chapter number="28" style="c" sid="1CH 28"/>
  <para style="s1">Dawid Akwankyerɛ A Ɔde Maa Salomo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1"/>Dawid frɛɛ ne mpanyimfo nyinaa kɔɔ Yerusalem. Saa mpanyimfo no ne mmusuakuw no ntuanofo, asahene a wɔdeda asraafodɔm akuw dumien no ano, asraafo mpanyimfo a wɔaka no, wɔn a wɔhwɛ ɔhene agyapade ne ne mmoa so, ahemfi nhenkwaa, akofo akɛse ne akofo a wɔaka wɔ ahenni no mu no.<verse eid="1CH 28:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 28:2"/>Dawid sɔre gyinaa wɔn anim, kasa kyerɛɛ wɔn se, “Me nuanom ne me nkurɔfo, anka mepɛɛ sɛ misi asɔredan a wɔde <char style="nd">Awurade</char> Apam Adaka, Onyankopɔn anan ntiaso no besi afebɔɔ. Meyɛɛ ho ahoboa nyinaa sɛ mede rebesi, <verse eid="1CH 28:2"/><verse number="3" style="v" sid="1CH 28:3"/>nanso Onyankopɔn ka kyerɛɛ me se, ‘Ɛnsɛ sɛ wusi asɔredan de hyɛ me din anuonyam, efisɛ woyɛ ɔkofo a woahwie mogya bebree agu.’<verse eid="1CH 28:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 28:4"/>“Nanso <char style="nd">Awurade</char>, Israel Nyankopɔn, ayi me wɔ mʼagya abusua mu sɛ, minni ɔhene wɔ Israel so daa. Na wayi Yuda abusuakuw sɛ wonni hene na Yuda mmusua mu nso, oyii mʼagya abusua. Na mʼagya mma mu no nso, ɛyɛɛ <char style="nd">Awurade</char> fɛ sɛ osii me Israel nyinaa so hene. <verse eid="1CH 28:4"/><verse number="5" style="v" sid="1CH 28:5"/>Na me mmabarima pii a <char style="nd">Awurade</char> de wɔn maa me no mu nso, oyii Salomo sɛ ɔntena <char style="nd">Awurade</char> ahenni agua no so nni Israel so. <verse eid="1CH 28:5"/><verse number="6" style="v" sid="1CH 28:6"/>Ɔka kyerɛɛ me se, ‘Wo babarima Salomo na obesi mʼasɔredan ne nʼadiwo nyinaa, efisɛ mayi no sɛ me babarima na mɛyɛ nʼagya. <verse eid="1CH 28:6"/><verse number="7" style="v" sid="1CH 28:7"/>Na sɛ ɔkɔ so di mʼahyɛde ne me mmara so, sɛnea ɔyɛ mprempren yi a, mɛma nʼahenni atim afebɔɔ.’<verse eid="1CH 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 28:8"/>“Enti mprempren a Onyankopɔn yɛ yɛn dansifo yi, menam wo so de saa asodi yi ma Israel nyinaa a wɔyɛ <char style="nd">Awurade</char> manfo no: Monhwɛ yiye na munni <char style="nd">Awurade</char>, mo Nyankopɔn, ahyɛde nyinaa so sɛnea mobɛfa saa asase pa yi, na moagyaw ama mo asefo sɛ wɔn agyapade daa.<verse eid="1CH 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9"/>“Afei, me ba Salomo, hu wʼagyanom Nyankopɔn. Fa wo koma ne wʼadwene nyinaa sɔre no, na som no. Efisɛ Awurade hu koma biara mu, enti ohu na onim emu nhyehyɛe ne nsusuwii biara. Sɛ wohwehwɛ no a, wubehu no. Na sɛ wopo no a, ɔbɛpo wo afebɔɔ. <verse eid="1CH 28:9"/><verse number="10" style="v" sid="1CH 28:10"/>Enti fa no asɛnhia. Awurade ayi wo sɛ si asɔredan ma no, sɛ ne kronkronbea. Yɛ den, na di dwuma no.”<verse eid="1CH 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11"/>Afei Dawid de asɔredan no ho mfoni a sikakorabea, soro adan, emu adan ne emu kronkronbea a Apam Adaka no afefare mu a ɛhɔ yɛ mpatabea, faako a wɔde Adaka no besi maa Salomo. <verse eid="1CH 28:11"/><verse number="12" style="v" sid="1CH 28:12"/>Nhyehyɛe biara a Honhom no de maa Dawid a ɛfa <char style="nd">Awurade</char> Asɔredan adiwo ho, akyi adan, Onyankopɔn Asɔredan no mu sikakorabea ne akyɛde a wɔde ama Onyankopɔn no, ɔkyerɛɛ Salomo. <verse eid="1CH 28:12"/><verse number="13" style="v" sid="1CH 28:13"/>Saa ara na ɔhene no kyerɛɛ Salomo dwuma a asɔfo ne Lewifo nkyekyɛmu ahorow no nyɛ wɔ <char style="nd">Awurade</char> Asɔredan no mu. Na ɔkyerɛkyerɛɛ nneɛma pɔtee a ɛwɔ <char style="nd">Awurade</char> Asɔredan no mu a wɔde sɔre <char style="nd">Awurade</char> ne nea wɔde bɔ afɔre. <verse eid="1CH 28:13"/><verse number="14" style="v" sid="1CH 28:14"/>Dawid kyerɛɛ sikakɔkɔɔ ne dwetɛ dodow a wɔmfa nyɛ nneɛma a ɛho behia. <verse eid="1CH 28:14"/><verse number="15" style="v" sid="1CH 28:15"/>Ɔkyerɛɛ Salomo sikakɔkɔɔ dodow a ɛho behia ama sikakɔkɔɔ akaneadua no ne akanea no, na ɔkyerɛɛ dwetɛ dodow a ɛho behia ama dwetɛ akaneadua no ne akanea no yɛ, ne ɔkwan ko a wɔbɛfa so de emu biara adi dwuma no. <verse eid="1CH 28:15"/><verse number="16" style="v" sid="1CH 28:16"/>Ɔkyerɛɛ sikakɔkɔɔ dodow a wɔmfa nyɛ ɔpon a wɔde Daa Daa Brodo no bɛto so; na ɔkyerɛɛ dwetɛ dodow a wɔmfa nyɛ apon a ɛka ho no. <verse eid="1CH 28:16"/><verse number="17" style="v" sid="1CH 28:17"/>Dawid san kyerɛɛ sikakɔkɔɔ dodow a wɔmfa nyɛ nam darewa a wɔde besuso afɔrebɔ nam mu, hweaseammɔ, sukuruwa ne nyowa ne dwetɛ dodow a wɔmfa nyɛ asanka biara. <verse eid="1CH 28:17"/><verse number="18" style="v" sid="1CH 28:18"/>Nea ɔde wiee ne sɛ, ɔkyerɛɛ sikakɔkɔɔ a wɔabere ho dodow a wɔde bɛyɛ nnuhuam afɔremuka no ne sikakɔkɔɔ kerubim a ne ntaban atrɛw wɔ <char style="nd">Awurade</char> Adaka no so.<verse eid="1CH 28:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 28:19"/>Dawid ka kyerɛɛ Salomo se, “Saa mfoni yi nyinaa, <char style="nd">Awurade</char> nsa na ɔde kyerɛw maa me.”<verse eid="1CH 28:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20"/>Afei, Dawid toaa so se, “Yɛ den na ma wo bo nyɛ duru na yɛ adwuma no. Nsuro na mma dwumadi no kɛseyɛ ntu wo bo, efisɛ <char style="nd">Awurade</char> Nyankopɔn, me Nyankopɔn, ka wo ho. Ɔrenni wo huammɔ na ɔrennya wo. Ɔbɛhwɛ sɛ dwumadi biara a ɛfa <char style="nd">Awurade</char> Asɔredan no si ho no, wobewie no pɛpɛɛpɛ. <verse eid="1CH 28:20"/><verse number="21" style="v" sid="1CH 28:21"/>Asɔfo ne Lewifo akuw no bɛsom wɔ Onyankopɔn Asɔredan no mu. Wɔn a aka a wɔwɔ nimdeɛ ahorow no nyinaa beyi wɔn yam aboa, na ntuanofo ne ɔman no nyinaa nso bɛyɛ biribiara a wobɛka.”<verse eid="1CH 28:21"/></para>
  <chapter eid="1CH 28"/>
  <chapter number="29" style="c" sid="1CH 29"/>
  <para style="s1">Asɔredan No Si Ho Akyɛde</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1"/>Afei, Ɔhene Dawid dan nʼani kyerɛɛ ɔmanfo no kae se, “Me babarima Salomo a Onyankopɔn ayi no sɛ onni Israel so sɛ ɔhene foforo no da so yɛ abofra a onni osuahu biara. Adwuma a ɛda nʼanim no so, na Asɔredan a obesi no nyɛ dan hunu bi. Ɛyɛ <char style="nd">Awurade</char> Nyankopɔn no ankasa de. <verse eid="1CH 29:1"/><verse number="2" style="v" sid="1CH 29:2"/>Mede nea mitumi yɛ biara adi dwuma, maboaboa nea matumi anya nyinaa ano ama me Nyankopɔn Asɔredan no si. Mprempren, sikakɔkɔɔ, dwetɛ, kɔbere mfrafrae, nnade ne nnua ne apopobibiri abo ne aboɔden abo, aboɔden agude ne abo pa ne abohemaa ahorow nyinaa pii wɔ hɔ. <verse eid="1CH 29:2"/><verse number="3" style="v" sid="1CH 29:3"/>Na esiane me ho a mede ama me Nyankopɔn Asɔredan no nti, mede mʼankasa sikakɔkɔɔ ne dwetɛ bɛboa ɔdan no si. Eyinom bɛka adansi no ho nneɛma a maboaboa ano ama asɔredan kronkron no ho. <verse eid="1CH 29:3"/><verse number="4" style="v" sid="1CH 29:4"/>Mama Ofir sikakɔkɔɔ a ɛboro nsania ani tɔn ɔha ne dumien ne dwetɛ a wɔahoa ho nsania ani tɔn ahannu aduosia abien a wɔde begu adan no afasu anim, <verse eid="1CH 29:4"/><verse number="5" style="v" sid="1CH 29:5"/>ne sikakɔkɔɔ ne dwetɛ nnwuma a aka a adwumfo no bɛyɛ no. Afei, hena na obeyi ne yam de nʼayɛyɛde ama <char style="nd">Awurade</char> nnɛ?”<verse eid="1CH 29:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6"/>Na abusua ntuanofo, Israel mmusuakuw ntuanofo, asahene ne asraafo mpanyimfo ne ɔhene adwumayɛfo nyinaa fii ɔpɛ pa mu mae. <verse eid="1CH 29:6"/><verse number="7" style="v" sid="1CH 29:7"/>Wɔmaa sikakɔkɔɔ bɛyɛ tɔn ɔha aduɔwɔtwe awotwe, sika ankasa mpem du, dwetɛ bɛyɛ tɔn ahaasa aduɔson anum, kɔbere mfrafrae bɛyɛ tɔn ahansia aduɔson anum ne nnade bɛyɛ tɔn mpem ahaasa ahanson ne aduonum, de boaa Asɔredan no si. <verse eid="1CH 29:7"/><verse number="8" style="v" sid="1CH 29:8"/>Wɔmaa aboɔden abo bebree a wɔkɔkoraa no wɔ sikakorabea a ɛwɔ <char style="nd">Awurade</char> fi maa Yehiel a ɔyɛ Gerson aseni hwɛɛ so. <verse eid="1CH 29:8"/><verse number="9" style="v" sid="1CH 29:9"/>Nnipa no ani gyee ɔma no ho, efisɛ wofi ɔpɛ pa ne koma pa mu na woyiyi maa <char style="nd">Awurade</char>, na Ɔhene Dawid ani gyee yiye.<verse eid="1CH 29:9"/></para>
  <para style="s1">Dawid Kamfo <char style="nd">Awurade</char></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10"/>Na ɔhene Dawid kamfoo <char style="nd">Awurade</char> wɔ nnipa no nyinaa anim se,</para>
  <para style="q1" vid="1CH 29:10">“<char style="nd">Awurade</char>,</para>
  <para style="q2" vid="1CH 29:10">yɛn agya Israel Nyankopɔn,</para>
  <para style="q2" vid="1CH 29:10">ayeyi nka wo daa nyinaa.<verse eid="1CH 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 29:11"/>Kɛseyɛ, ahoɔden, anuonyam,</para>
  <para style="q2" vid="1CH 29:11">nkonimdi ne tumi yɛ wo de, <char style="nd">Awurade</char>.</para>
  <para style="q2" vid="1CH 29:11">Biribiara a ɛwɔ ɔsoro ne asase so yɛ wo de,</para>
  <para style="q1" vid="1CH 29:11">
    <char style="nd">Awurade</char>, na ahenni yi nso yɛ wo de.</para>
  <para style="q2" vid="1CH 29:11">Yɛma wo so sɛ wone ade nyinaa so tumfo.<verse eid="1CH 29:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 29:12"/>Ahonya ne anuonyam fi wo nko ara,</para>
  <para style="q2" vid="1CH 29:12">efisɛ woyɛ ade nyinaa sodifo.</para>
  <para style="q1" vid="1CH 29:12">Tumi ne ahoɔden nyinaa wɔ wo nsam</para>
  <para style="q2" vid="1CH 29:12">na wopɛ mu na wufi ma nnipa yɛ kɛse na wonya ahoɔden.<verse eid="1CH 29:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 29:13"/>Afei, yɛn Nyankopɔn, yɛda wo ase,</para>
  <para style="q2" vid="1CH 29:13">na yɛkamfo wo din kronkron no.<verse eid="1CH 29:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14"/>“Na me ne hena na me nkurɔfo ne nnipa bɛn a yetumi kyɛ wo biribi? Biribiara a yɛwɔ no fi wo nkyɛn, na nea yɛde ma wo no yɛ nea wode ama yɛn dedaw no. <verse eid="1CH 29:14"/><verse number="15" style="v" sid="1CH 29:15"/>Yɛwɔ ha mmere tiaa bi sɛ nsrahwɛfo ne ahɔho wɔ asase a yɛn agyanom dii kan wɔ so no so. Yɛn nna wɔ asase so te sɛ sunsuma a etwa mu kɔ ntɛm so a wonhu bio. <verse eid="1CH 29:15"/><verse number="16" style="v" sid="1CH 29:16"/><char style="nd">Awurade</char>, yɛn Nyankopɔn, saa nneɛma a yɛaboaboa ano de rebesi asɔredan de ahyɛ wo din kronkron anuonyam yi mpo fi wo nkyɛn! Ne nyinaa yɛ wo dea. <verse eid="1CH 29:16"/><verse number="17" style="v" sid="1CH 29:17"/>Me Nyankopɔn, minim sɛ wohwehwɛ yɛn koma mu, na sɛ wuhu nokwaredi wɔ mu a, wʼani gye. Wunim sɛ mede adwene pa na ɛyɛɛ eyinom nyinaa, na mahwɛ ahu sɛnea wo nkurɔfo fi koma pa ne anigye mu de wɔn akyɛde aba. <verse eid="1CH 29:17"/><verse number="18" style="v" sid="1CH 29:18"/><char style="nd">Awurade</char>, yɛn agyanom Abraham, Isak ne Israel Nyankopɔn, ma wo nkurɔfo nyɛ osetie mma wo daa. Mma ɔdɔ a wɔde dɔ wo no nsesa. <verse eid="1CH 29:18"/><verse number="19" style="v" sid="1CH 29:19"/>Ma me babarima Salomo koma nyinaa mu ɔpɛ pa, na onni wʼahyɛde, wo mmara ne wo nkyerɛkyerɛ so, na onsi saa Asɔredan yi a mayɛ ho ahoboa nyinaa no.”<verse eid="1CH 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20"/>Afei, Dawid ka kyerɛɛ ɔmanfo no nyinaa se, “Monkamfo <char style="nd">Awurade</char>, mo Nyankopɔn!” Na ɔmanfo no nyinaa kamfoo <char style="nd">Awurade</char>, wɔn agyanom Nyankopɔn, na wɔkotow buu nkotodwe wɔ <char style="nd">Awurade</char> ne ɔhene no anim.<verse eid="1CH 29:20"/></para>
  <para style="s1">Wosi Salomo Ɔhene</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21"/>Ade kyee no, wɔde anantwinini apem, adwennini apem ne nguamma anini apem bɛbɔɔ ɔhyew afɔre maa <char style="nd">Awurade</char>. Wɔsan gyinaa Israel anan mu, de ɔnom afɔrebɔde pii ne afɔrebɔde ahorow bae. <verse eid="1CH 29:21"/><verse number="22" style="v" sid="1CH 29:22"/>Wɔde ahosɛpɛw didi nomee da no wɔ <char style="nd">Awurade</char> anim.</para>
  <para style="p" vid="1CH 29:22">Na bio, wɔhyɛɛ Dawid babarima Salomo ahenkyɛw sɛ wɔn hene foforo. Wɔsraa no ngo wɔ <char style="nd">Awurade</char> anim sɛ wɔn ntuanoni, na wɔsraa Sadok nso ngo sɛ wɔn sɔfo. <verse eid="1CH 29:22"/><verse number="23" style="v" sid="1CH 29:23"/>Na Salomo tenaa <char style="nd">Awurade</char> ahengua no so sɛ nʼagya Dawid nanmusini, na ɔkɔɔ so yiye, na Israel nyinaa tiee no. <verse eid="1CH 29:23"/><verse number="24" style="v" sid="1CH 29:24"/>Adehye mpanyimfo nyinaa, asahene ne Dawid mmabarima nyinaa sua kyerɛɛ ɔhene Salomo.<verse eid="1CH 29:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 29:25"/>Na <char style="nd">Awurade</char> pagyaw Salomo maa Israelman no maa no nidi nwonwaso, na ɔmaa Salomo ahonya ne anuonyam sen nʼagya.<verse eid="1CH 29:25"/></para>
  <para style="s1">Dawid Wu</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26"/>Enti Yisai babarima Dawid dii Israel nyinaa so hene. <verse eid="1CH 29:26"/><verse number="27" style="v" sid="1CH 29:27"/>Odii hene wɔ Israel mfe aduanan a ne nkyerɛmu ne sɛ, odii Hebron so mfe ason, na mfe aduasa abiɛsa nso, ɔtenaa Yerusalem. <verse eid="1CH 29:27"/><verse number="28" style="v" sid="1CH 29:28"/>Ɔtenaa ase kyɛe, nyinii yiye, nyaa ahode ne anuonyam ansa na ɔrewu. Na ne babarima Salomo dii nʼade sɛ ɔhene. <verse eid="1CH 29:28"/><verse number="29" style="v" sid="1CH 29:29"/>Efi Ɔhene Dawid adedi mfiase de kosi nʼawie mu nsɛm nyinaa, wɔakyerɛw agu ɔdehufo Samuel abakɔsɛm nhoma, odiyifo Natan abakɔsɛm nhoma ne ɔdehufo Gad abakɔsɛm nhoma mu. <verse eid="1CH 29:29"/><verse number="30" style="v" sid="1CH 29:30"/>Nʼadedi mu akokodurusɛm ne biribiara a ɛbaa ne so, Israel ne ahenni ahorow a atwa ne ho ahyia nyinaa nso yɛ nsɛm a wɔakyerɛw.<verse eid="1CH 29:30"/></para>
  <chapter eid="1CH 29"/>
</usx>
