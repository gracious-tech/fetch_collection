<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- Biblica® Open Akuapem Twi Contemporary Bible 2020</book>
  <para style="h">Nahum</para>
  <para style="toc1">Odiyifo Nahum Nhoma</para>
  <para style="toc2">Nahum</para>
  <para style="toc3">Nah</para>
  <para style="mt2">Odiyifo</para>
  <para style="mt1">Nahum</para>
  <para style="mt2">Nhoma</para>
  <chapter number="1" style="c" sid="NAM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1"/>Elkosini Nahum anisoadehu nhoma a ɛyɛ nkɔmhyɛ a ɛfa Ninewe ho.<verse eid="NAM 1:1"/></para>
  <para style="s1">Awurade Abufuw A Etia Ninewe</para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 1:2"/>
    <char style="nd">Awurade</char> yɛ ninkufo ne aweretɔ Nyankopɔn,</para>
  <para style="q2" vid="NAM 1:2">
    <char style="nd">Awurade</char> tɔ were, na abufuw ahyɛ no ma.</para>
  <para style="q1" vid="NAM 1:2">
    <char style="nd">Awurade</char> tɔ nʼatamfo so were,</para>
  <para style="q2" vid="NAM 1:2">na nʼabufuw tena wɔn so.<verse eid="NAM 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 1:3"/>
    <char style="nd">Awurade</char> bo kyɛ fuw, na ne tumi so,</para>
  <para style="q2" vid="NAM 1:3">na ɔtwe ɔfɔdifo aso.</para>
  <para style="q1" vid="NAM 1:3">Ne kwan wɔ mfɛtɛ ne ahum mu,</para>
  <para style="q2" vid="NAM 1:3">omununkum yɛ nʼanan ase mfutuma.<verse eid="NAM 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 1:4"/>Ɔteɛteɛ po na ɔma ɛyow;</para>
  <para style="q2" vid="NAM 1:4">ɔma nsubɔnten nyinaa yoyow.</para>
  <para style="q1" vid="NAM 1:4">Basan ne Karmel twintwam,</para>
  <para style="q2" vid="NAM 1:4">na Lebanon frɔmfrɔmyɛ nso kisa.<verse eid="NAM 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 1:5"/>Mmepɔw wosow biribiri nʼanim</para>
  <para style="q2" vid="NAM 1:5">na nkoko nan.</para>
  <para style="q1" vid="NAM 1:5">Asase, wiase ne wɔn a wɔwɔ mu nyinaa</para>
  <para style="q2" vid="NAM 1:5">wosow nʼanim.<verse eid="NAM 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 1:6"/>Hena na obetumi agyina nʼabufuw ano?</para>
  <para style="q2" vid="NAM 1:6">Hena na obetumi atena nʼabufuwhyew mu?</para>
  <para style="q1" vid="NAM 1:6">Nʼabufuw hwie te sɛ ogya;</para>
  <para style="q2" vid="NAM 1:6">abotan yam wɔ nʼanim.<verse eid="NAM 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 1:7"/>
    <char style="nd">Awurade</char> ye,</para>
  <para style="q2" vid="NAM 1:7">ɔyɛ ahohia mu guankɔbea.</para>
  <para style="q1" vid="NAM 1:7">Nʼani wɔ wɔn a wɔde wɔn ho to no so no so.<verse eid="NAM 1:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="NAM 1:8"/>Nanso, ɔnam nsuyiri nwonwaso so</para>
  <para style="q1" vid="NAM 1:8">bɛma Ninewe aba awiei.</para>
  <para style="q2" vid="NAM 1:8">Ɔbɛtaa nʼatamfo akodu sum kabii mu.<verse eid="NAM 1:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 1:9"/>Pɔw biara a wɔbɛbɔ atia <char style="nd">Awurade</char> no,</para>
  <para style="q2" vid="NAM 1:9">ɔbɛsɛe no;</para>
  <para style="q2" vid="NAM 1:9">ɔhaw biara remma nto so mprenu.<verse eid="NAM 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 1:10"/>Wɔde nsɔe bɛkyekyere wɔn ho,</para>
  <para style="q2" vid="NAM 1:10">na bere a wɔn nsa abow wɔn no</para>
  <para style="q2" vid="NAM 1:10">wɔbɛhyew wɔn sɛ nwuraguanee a wɔaboa ano.<verse eid="NAM 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 1:11"/>Ninewe, wo mu na</para>
  <para style="q2" vid="NAM 1:11">nea ɔbɔ pɔw bɔne tia <char style="nd">Awurade</char></para>
  <para style="q1" vid="NAM 1:11">na otu fo bɔne no fi.<verse eid="NAM 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 1:12"/>Nea <char style="nd">Awurade</char> se ni:</para>
  <para style="q2" vid="NAM 1:12">“Ɛwɔ mu sɛ wɔwɔ nnamfonom a wɔdɔɔso de,</para>
  <para style="q1" vid="NAM 1:12">nanso wɔbɛsɛe wɔn ama wɔayera.</para>
  <para style="q2" vid="NAM 1:12">Yuda, ɛwɔ mu sɛ mama ɔhaw aba wo so,</para>
  <para style="q2" vid="NAM 1:12">nanso merenyɛ saa bio.<verse eid="NAM 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 1:13"/>Afei, mebubu konnua a ɛda wo kɔn mu</para>
  <para style="q2" vid="NAM 1:13">na matetew nkɔnsɔnkɔnsɔn no mu.”<verse eid="NAM 1:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 1:14"/>Ninewe, <char style="nd">Awurade</char> aka ɔhyɛ asɛm a ɛfa wo ho:</para>
  <para style="q2" vid="NAM 1:14">“Worennya asefo a wo din bɛda wɔn so.</para>
  <para style="q1" vid="NAM 1:14">Mɛsɛe nsɛsode a wɔasen ne ahoni a wɔagu</para>
  <para style="q2" vid="NAM 1:14">a esisi wʼabosonnan mu no.</para>
  <para style="q1" vid="NAM 1:14">Mesiesie wo da</para>
  <para style="q2" vid="NAM 1:14">efisɛ woadan ayɛ atantanne.”<verse eid="NAM 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 1:15"/>Hwɛ mmepɔw no so,</para>
  <para style="q2" vid="NAM 1:15">nea ɔde asɛmpa no ba no anammɔn</para>
  <para style="q2" vid="NAM 1:15">ɔno na ɔka asomdwoesɛm!</para>
  <para style="q1" vid="NAM 1:15">Yuda di wʼafahyɛ na</para>
  <para style="q2" vid="NAM 1:15">di wɔ bɔhyɛ so.</para>
  <para style="q1" vid="NAM 1:15">Nnipabɔne rentu wo so sa bio;</para>
  <para style="q2" vid="NAM 1:15">Wɔbɛsɛe wɔn pasaa.<verse eid="NAM 1:15"/></para>
  <chapter eid="NAM 1"/>
  <chapter number="2" style="c" sid="NAM 2"/>
  <para style="s1">Ninewe Asehwe</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 2:1"/>Ɔtamfo reba wo so, Ninewe</para>
  <para style="q2" vid="NAM 2:1">bɔ aban no ho ban,</para>
  <para style="q1" vid="NAM 2:1">wɛn ɔkwan no,</para>
  <para style="q2" vid="NAM 2:1">bɔ wo ho so</para>
  <para style="q1" vid="NAM 2:1">na boa wʼahoɔden nyinaa ano!<verse eid="NAM 2:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 2:2"/>
    <char style="nd">Awurade</char> de Yakob anuonyam bɛsan ama no</para>
  <para style="q2" vid="NAM 2:2">te sɛ Israel de no,</para>
  <para style="q1" vid="NAM 2:2">ɛwɔ mu sɛ, asɛefo no ama ada mpan</para>
  <para style="q2" vid="NAM 2:2">na wɔasɛe ne bobe mfuw.<verse eid="NAM 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 2:3"/>Asraafo no nkatabo yɛ kɔkɔɔ;</para>
  <para style="q2" vid="NAM 2:3">akofo no hyehyɛ ɔkɔben akotade.</para>
  <para style="q1" vid="NAM 2:3">Nnade a wɔde yɛɛ nteaseɛnam no</para>
  <para style="q2" vid="NAM 2:3">twa yerɛw yerɛw sɛ da a wɔyɛɛ no;</para>
  <para style="q2" vid="NAM 2:3">mpeaw a wɔapema wɔ nnua so no rehim.<verse eid="NAM 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 2:4"/>Nteaseɛnam no twiw fa mmɔnten so,</para>
  <para style="q2" vid="NAM 2:4">na wodi akɔneaba.</para>
  <para style="q1" vid="NAM 2:4">Wɔte sɛ ogyatɛn a ɛredɛw;</para>
  <para style="q2" vid="NAM 2:4">wɔbɔ yerɛdɛ te sɛ anyinam.<verse eid="NAM 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 2:5"/>Ɔfrɛfrɛɛ nʼakofo a wodi mu,</para>
  <para style="q2" vid="NAM 2:5">nanso wohintihintiw wɔ ɔkwan mu.</para>
  <para style="q1" vid="NAM 2:5">Wɔde mmirika kɔ kuropɔn no afasu ho;</para>
  <para style="q2" vid="NAM 2:5">na wɔyɛ wɔn nkataanim krado.<verse eid="NAM 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 2:6"/>Wobuebue asubɔnten apon no,</para>
  <para style="q2" vid="NAM 2:6">na ahemfi no dwiriw gu fam.<verse eid="NAM 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 2:7"/>Wɔhyɛ mmaraden sɛ</para>
  <para style="q2" vid="NAM 2:7">wɔmfa kuropɔn no nnommum</para>
  <para style="q1" vid="NAM 2:7">na wɔmfa wɔn nkɔ.</para>
  <para style="q2" vid="NAM 2:7">Ne mfenaa de wɔn nsa gu wɔn koko so</para>
  <para style="q2" vid="NAM 2:7">su te sɛ mmorɔnoma.<verse eid="NAM 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 2:8"/>Ninewe te sɛ ɔtare a</para>
  <para style="q2" vid="NAM 2:8">mu nsu resen kɔ.</para>
  <para style="q1" vid="NAM 2:8">Wɔteɛ mu se, “Munnyina hɔ! Munnyina hɔ!”</para>
  <para style="q2" vid="NAM 2:8">Nanso, obiara ansan nʼakyi.<verse eid="NAM 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 2:9"/>Momfom dwetɛ no!</para>
  <para style="q2" vid="NAM 2:9">Momfom sikakɔkɔɔ no!</para>
  <para style="q1" vid="NAM 2:9">Ahonyade a ɛwɔ adekoradan mu nyinaa!</para>
  <para style="q2" vid="NAM 2:9">Na ahonyade no dɔɔso.<verse eid="NAM 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 2:10"/>Wɔabɔ Ninewe korɔn, wɔayɛ no pasaa!</para>
  <para style="q2" vid="NAM 2:10">Koma botow, na nkotodwe wosowosow,</para>
  <para style="q2" vid="NAM 2:10">nnipa ho popo na wɔn anim hoa.<verse eid="NAM 2:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 2:11"/>Mprempren he na gyata buw no wɔ,</para>
  <para style="q2" vid="NAM 2:11">faako a wɔma wɔn mma aduan no,</para>
  <para style="q1" vid="NAM 2:11">faako a gyatanini ne gyatabere kɔe</para>
  <para style="q2" vid="NAM 2:11">na wɔn mma nso kɔ a wonsuro?<verse eid="NAM 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 2:12"/>Gyata akum nea ɛbɛmee ne mma.</para>
  <para style="q2" vid="NAM 2:12">Wabobɔ hanam ama gyatabere no.</para>
  <para style="q1" vid="NAM 2:12">Ɔde nea wakum ahyɛ ne bon ma</para>
  <para style="q2" vid="NAM 2:12">na ɔde hanam ahyɛ nʼatu amaama.<verse eid="NAM 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 2:13"/>“Me ne wo nka,”</para>
  <para style="q2" vid="NAM 2:13">sɛnea Asafo <char style="nd">Awurade</char> se ni,</para>
  <para style="q1" vid="NAM 2:13">“Mɛhyew wo nteaseɛnam na adan wusiw</para>
  <para style="q2" vid="NAM 2:13">na afoa bekunkum wo gyatamma.</para>
  <para style="q1" vid="NAM 2:13">Merennyaw wo hanam biara wɔ asase so.</para>
  <para style="q2" vid="NAM 2:13">Wɔrente wʼasomafo no nne bio.”<verse eid="NAM 2:13"/></para>
  <chapter eid="NAM 2"/>
  <chapter number="3" style="c" sid="NAM 3"/>
  <para style="s1">Ninewe Nnome</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 3:1"/>Nnome nka mogya kuropɔn</para>
  <para style="q2" vid="NAM 3:1">a atoro ne korɔn ahyɛ no ma</para>
  <para style="q2" vid="NAM 3:1">na amanehunufo mpa mu da!<verse eid="NAM 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 3:2"/>Apɔnkɔkafo abaa regyigye,</para>
  <para style="q2" vid="NAM 3:2">nteaseɛnam nhankare reyɛ kirididi</para>
  <para style="q1" vid="NAM 3:2">Apɔnkɔ rehuruhuruw</para>
  <para style="q2" vid="NAM 3:2">ne nteaseɛnam redankyidankyi.<verse eid="NAM 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 3:3"/>Apɔnkɔ ne wɔn sotefo ko kɔ wɔn anim;</para>
  <para style="q2" vid="NAM 3:3">afoa twa yerɛw yerɛw,</para>
  <para style="q2" vid="NAM 3:3">na mpeaw nso pa yerɛw yerɛw.</para>
  <para style="q1" vid="NAM 3:3">Atɔfo bebree,</para>
  <para style="q2" vid="NAM 3:3">awufo a bi deda bi so,</para>
  <para style="q1" vid="NAM 3:3">afunu a wontumi nkan wɔn dodow</para>
  <para style="q2" vid="NAM 3:3">a nnipa tiatia so.<verse eid="NAM 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 3:4"/>Eyi nyinaa fi oguamanfo bi akɔnnɔ,</para>
  <para style="q2" vid="NAM 3:4">ntafowayifo no nnaadaa dodow no.</para>
  <para style="q1" vid="NAM 3:4">Ɔno na ɔde nʼaguamammɔ tɔn amanaman</para>
  <para style="q2" vid="NAM 3:4">na ɔde ne ntafowayi tɔn nnipa.<verse eid="NAM 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 3:5"/>“Me ne wo nka,” sɛnea Asafo <char style="nd">Awurade</char> se ni,</para>
  <para style="q2" vid="NAM 3:5">“Mɛpagyaw wʼatade akɔ soro.</para>
  <para style="q1" vid="NAM 3:5">Mɛma amanaman ahu wʼadagyaw</para>
  <para style="q2" vid="NAM 3:5">na ahenni ahorow nso ahu wʼanimguase.<verse eid="NAM 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 3:6"/>Mede fi bɛsra wo ho,</para>
  <para style="q2" vid="NAM 3:6">mebu wo animtiaa</para>
  <para style="q2" vid="NAM 3:6">na mama nnipa ahwɛ wo.<verse eid="NAM 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 3:7"/>Obiara a obehu wo beguan afi wo ho aka se,</para>
  <para style="q2" vid="NAM 3:7">‘Ninewe adwiriw, na hena na obesu no?’</para>
  <para style="q2" vid="NAM 3:7">Ɛhe na menya obi akyekye wo werɛ?”<verse eid="NAM 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 3:8"/>Wuye sen Tebes a</para>
  <para style="q2" vid="NAM 3:8">ɛda Asubɔnten Nil ho a</para>
  <para style="q2" vid="NAM 3:8">nsu atwa ne ho ahyia ana?</para>
  <para style="q1" vid="NAM 3:8">Asubɔnten bɔ ne ho ban</para>
  <para style="q2" vid="NAM 3:8">na nsu yɛ ne fasu.<verse eid="NAM 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 3:9"/>Kus ne Misraim yɛ ne dɔm a wontumi nkan wɔn.</para>
  <para style="q2" vid="NAM 3:9">Put ne Libia ka nʼadomfo ho.<verse eid="NAM 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 3:10"/>Nanso wɔfaa no nnommum</para>
  <para style="q2" vid="NAM 3:10">twaa no asu.</para>
  <para style="q1" vid="NAM 3:10">Wɔtow ne nkokoaa hwehwee fam</para>
  <para style="q2" vid="NAM 3:10">ma wɔtetee wɔ mmɔnten so.</para>
  <para style="q1" vid="NAM 3:10">Wɔbɔɔ nʼadehye so ntonto,</para>
  <para style="q2" vid="NAM 3:10">na nʼatitiriw nso wɔde nkɔnsɔnkɔnsɔn guguu wɔn.<verse eid="NAM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 3:11"/>Wo nso wobɛbow</para>
  <para style="q2" vid="NAM 3:11">Na wubehintaw wo ho</para>
  <para style="q2" vid="NAM 3:11">de akɔpɛ guankɔbea wɔ atamfo nkyɛn.<verse eid="NAM 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 3:12"/>Wʼaban nyinaa te sɛ borɔdɔma nnua</para>
  <para style="q2" vid="NAM 3:12">a asow aba foforo:</para>
  <para style="q1" vid="NAM 3:12">sɛ wɔwosow a</para>
  <para style="q2" vid="NAM 3:12">aba no tetew gu ma nea ɔrehwehwɛ bi adi.<verse eid="NAM 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 3:13"/>Hwɛ wʼakofo</para>
  <para style="q2" vid="NAM 3:13">wɔn nyinaa yɛ mmea!</para>
  <para style="q1" vid="NAM 3:13">Wʼasase so apon ano deda hɔ ma wʼatamfo;</para>
  <para style="q2" vid="NAM 3:13">ogya ahyew wʼapon no akyi adaban.<verse eid="NAM 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 3:14"/>Sesaw nsu sie ma bere a wɔatua mo ano no.</para>
  <para style="q2" vid="NAM 3:14">Yere wo bammɔ mu!</para>
  <para style="q1" vid="NAM 3:14">Wɔw dɔte no</para>
  <para style="q2" vid="NAM 3:14">na siesie ntayaa a wɔato no!<verse eid="NAM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 3:15"/>Ɛhɔ na ogya bɛhyew wo;</para>
  <para style="q2" vid="NAM 3:15">afoa betwa wo ahwe fam,</para>
  <para style="q1" vid="NAM 3:15">wobedi wo nam sɛ mmoadabikuw.</para>
  <para style="q2" vid="NAM 3:15">Monnɔ sɛ tɛwtɛw,</para>
  <para style="q2" vid="NAM 3:15">mo ase mfɛe sɛ mmoadabi!<verse eid="NAM 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="NAM 3:16"/>Woama wʼaguadifo adɔɔso,</para>
  <para style="q2" vid="NAM 3:16">wɔn dodow asen ɔsoro nsoromma,</para>
  <para style="q1" vid="NAM 3:16">nanso wɔte sɛ mmoadabi a wɔbɔ asase no kwaterekwa</para>
  <para style="q2" vid="NAM 3:16">na afei wotu kɔ.<verse eid="NAM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="NAM 3:17"/>Wʼawɛmfo te sɛ mmoadabi.</para>
  <para style="q2" vid="NAM 3:17">Wʼadwumayɛfo te sɛ mmoadabi akuw</para>
  <para style="q2" vid="NAM 3:17">a wɔsensam ban ho awɔw da.</para>
  <para style="q1" vid="NAM 3:17">Nanso sɛ owia pue a wotu kɔ,</para>
  <para style="q2" vid="NAM 3:17">na obi nnim faako a wɔkɔ.<verse eid="NAM 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="NAM 3:18"/>Asiriahene wo nguanhwɛfo retɔ nko.</para>
  <para style="q2" vid="NAM 3:18">Wʼanuonyamfo deda hɔ rehome.</para>
  <para style="q1" vid="NAM 3:18">Wo nkurɔfo abɔ apete wɔ mmepɔw no so</para>
  <para style="q2" vid="NAM 3:18">a wonni anoboaboafo.<verse eid="NAM 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NAM 3:19"/>Aduru biara rentumi nkum wʼapirakuru no;</para>
  <para style="q2" vid="NAM 3:19">wo kuru no bekum wo.</para>
  <para style="q1" vid="NAM 3:19">Obiara a ɔte wo nka no</para>
  <para style="q2" vid="NAM 3:19">bɔ ne nsam wɔ wʼasehwe ho,</para>
  <para style="q1" vid="NAM 3:19">Na hena koraa na wʼatirimɔdensɛm</para>
  <para style="q2" vid="NAM 3:19">no bi nkaa no da?<verse eid="NAM 3:19"/></para>
  <chapter eid="NAM 3"/>
</usx>
