  <para style="h">Hebrews</para>
  <para style="toc1">ibriṇaḥ patraṁ</para>
  <para style="toc2">ibriṇaḥ</para>
  <para style="toc3">ibriṇaḥ</para>
  <para style="mt1">ibriṇaḥ patraṁ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>purā ya īśvaro bhaviṣyadvādibhiḥ pitṛlokebhyo nānāsamaye nānāprakāraṁ kathitavān</para>
  <para style="p">
    <verse number="2" style="v"/>sa etasmin śeṣakāle nijaputreṇāsmabhyaṁ kathitavān| sa taṁ putraṁ sarvvādhikāriṇaṁ kṛtavān tenaiva ca sarvvajaganti sṛṣṭavān|</para>
  <para style="p">
    <verse number="3" style="v"/>sa putrastasya prabhāvasya pratibimbastasya tattvasya mūrttiścāsti svīyaśaktivākyena sarvvaṁ dhatte ca svaprāṇairasmākaṁ pāpamārjjanaṁ kṛtvā ūrddhvasthāne mahāmahimno dakṣiṇapārśve samupaviṣṭavān|</para>
  <para style="p">
    <verse number="4" style="v"/>divyadūtagaṇād yathā sa viśiṣṭanāmno 'dhikārī jātastathā tebhyo'pi śreṣṭho jātaḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>yato dūtānāṁ madhye kadācidīśvareṇedaṁ ka uktaḥ? yathā, "madīyatanayo 'si tvam adyaiva janito mayā|" punaśca "ahaṁ tasya pitā bhaviṣyāmi sa ca mama putro bhaviṣyati|"</para>
  <para style="p">
    <verse number="6" style="v"/>aparaṁ jagati svakīyādvitīyaputrasya punarānayanakāle tenoktaṁ, yathā, "īśvarasya sakalai rdūtaireṣa eva praṇamyatāṁ|"</para>
  <para style="p">
    <verse number="7" style="v"/>dūtān adhi tenedam uktaṁ, yathā, "sa karoti nijān dūtān gandhavāhasvarūpakān| vahniśikhāsvarūpāṁśca karoti nijasevakān||"</para>
  <para style="p">
    <verse number="8" style="v"/>kintu putramuddiśya tenoktaṁ, yathā, "he īśvara sadā sthāyi tava siṁhāsanaṁ bhavet| yāthārthyasya bhaveddaṇḍo rājadaṇḍastvadīyakaḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>puṇye prema karoṣi tvaṁ kiñcādharmmam ṛtīyase| tasmād ya īśa īśaste sa te mitragaṇādapi| adhikāhlādatailena secanaṁ kṛtavān tava||"</para>
  <para style="p">
    <verse number="10" style="v"/>punaśca, yathā, "he prabho pṛthivīmūlam ādau saṁsthāpitaṁ tvayā| tathā tvadīyahastena kṛtaṁ gaganamaṇḍalaṁ|</para>
  <para style="p">
    <verse number="11" style="v"/>ime vinaṁkṣyatastvantu nityamevāvatiṣṭhase| idantu sakalaṁ viśvaṁ saṁjariṣyati vastravat|</para>
  <para style="p">
    <verse number="12" style="v"/>saṅkocitaṁ tvayā tattu vastravat parivartsyate| tvantu nityaṁ sa evāsī rnirantāstava vatsarāḥ||"</para>
  <para style="p">
    <verse number="13" style="v"/>aparaṁ dūtānāṁ madhye kaḥ kadācidīśvareṇedamuktaḥ? yathā, "tavārīn pādapīṭhaṁ te yāvannahi karomyahaṁ| mama dakṣiṇadigbhāge tāvat tvaṁ samupāviśa||"</para>
  <para style="p">
    <verse number="14" style="v"/>ye paritrāṇasyādhikāriṇo bhaviṣyanti teṣāṁ paricaryyārthaṁ preṣyamāṇāḥ sevanakāriṇa ātmānaḥ kiṁ te sarvve dūtā nahi?</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ato vayaṁ yad bhramasrotasā nāpanīyāmahe tadarthamasmābhi ryadyad aśrāvi tasmin manāṁsi nidhātavyāni|</para>
  <para style="p">
    <verse number="2" style="v"/>yato heto dūtaiḥ kathitaṁ vākyaṁ yadyamogham abhavad yadi ca tallaṅghanakāriṇe tasyāgrāhakāya ca sarvvasmai samucitaṁ daṇḍam adīyata,</para>
  <para style="p">
    <verse number="3" style="v"/>tarhyasmābhistādṛśaṁ mahāparitrāṇam avajñāya kathaṁ rakṣā prāpsyate, yat prathamataḥ prabhunā proktaṁ tato'smān yāvat tasya śrotṛbhiḥ sthirīkṛtaṁ,</para>
  <para style="p">
    <verse number="4" style="v"/>aparaṁ lakṣaṇairadbhutakarmmabhi rvividhaśaktiprakāśena nijecchātaḥ pavitrasyātmano vibhāgena ca yad īśvareṇa pramāṇīkṛtam abhūt|</para>
  <para style="p">
    <verse number="5" style="v"/>vayaṁ tu yasya bhāvirājyasya kathāṁ kathayāmaḥ, tat ten divyadūtānām adhīnīkṛtamiti nahi|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu kutrāpi kaścit pramāṇam īdṛśaṁ dattavān, yathā, "kiṁ vastu mānavo yat sa nityaṁ saṁsmaryyate tvayā| kiṁ vā mānavasantāno yat sa ālocyate tvayā|</para>
  <para style="p">
    <verse number="7" style="v"/>divyadatagaṇebhyaḥ sa kiñcin nyūnaḥ kṛtastvayā| tejogauravarūpeṇa kirīṭena vibhūṣitaḥ| sṛṣṭaṁ yat te karābhyāṁ sa tatprabhutve niyojitaḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>caraṇādhaśca tasyaiva tvayā sarvvaṁ vaśīkṛtaṁ||" tena sarvvaṁ yasya vaśīkṛtaṁ tasyāvaśībhūtaṁ kimapi nāvaśeṣitaṁ kintvadhunāpi vayaṁ sarvvāṇi tasya vaśībhūtāni na paśyāmaḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>tathāpi divyadūtagaṇebhyo yaḥ kiñcin nyūnīkṛto'bhavat taṁ yīśuṁ mṛtyubhogahetostejogauravarūpeṇa kirīṭena vibhūṣitaṁ paśyāmaḥ, yata īśvarasyānugrahāt sa sarvveṣāṁ kṛte mṛtyum asvadata|</para>
  <para style="p">
    <verse number="10" style="v"/>aparañca yasmai yena ca kṛtsnaṁ vastu sṛṣṭaṁ vidyate bahusantānānāṁ vibhavāyānayanakāle teṣāṁ paritrāṇāgrasarasya duḥkhabhogena siddhīkaraṇamapi tasyopayuktam abhavat|</para>
  <para style="p">
    <verse number="11" style="v"/>yataḥ pāvakaḥ pūyamānāśca sarvve ekasmādevotpannā bhavanti, iti hetoḥ sa tān bhrātṛn vadituṁ na lajjate|</para>
  <para style="p">
    <verse number="12" style="v"/>tena sa uktavān, yathā, "dyotayiṣyāmi te nāma bhrātṛṇāṁ madhyato mama| parantu samite rmadhye kariṣye te praśaṁsanaṁ||"</para>
  <para style="p">
    <verse number="13" style="v"/>punarapi, yathā, "tasmin viśvasya sthātāhaṁ|" punarapi, yathā, "paśyāham apatyāni ca dattāni mahyam īśvarāt|"</para>
  <para style="p">
    <verse number="14" style="v"/>teṣām apatyānāṁ rudhirapalalaviśiṣṭatvāt so'pi tadvat tadviśiṣṭo'bhūt tasyābhiprāyo'yaṁ yat sa mṛtyubalādhikāriṇaṁ śayatānaṁ mṛtyunā balahīnaṁ kuryyāt</para>
  <para style="p">
    <verse number="15" style="v"/>ye ca mṛtyubhayād yāvajjīvanaṁ dāsatvasya nighnā āsan tān uddhārayet|</para>
  <para style="p">
    <verse number="16" style="v"/>sa dūtānām upakārī na bhavati kintvibrāhīmo vaṁśasyaivopakārī bhavatī|</para>
  <para style="p">
    <verse number="17" style="v"/>ato hetoḥ sa yathā kṛpāvān prajānāṁ pāpaśodhanārtham īśvaroddeśyaviṣaye viśvāsyo mahāyājako bhavet tadarthaṁ sarvvaviṣaye svabhrātṛṇāṁ sadṛśībhavanaṁ tasyocitam āsīt|</para>
  <para style="p">
    <verse number="18" style="v"/>yataḥ sa svayaṁ parīkṣāṁ gatvā yaṁ duḥkhabhogam avagatastena parīkṣākrāntān upakarttuṁ śaknoti|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he svargīyasyāhvānasya sahabhāginaḥ pavitrabhrātaraḥ, asmākaṁ dharmmapratijñāyā dūto'grasaraśca yo yīśustam ālocadhvaṁ|</para>
  <para style="p">
    <verse number="2" style="v"/>mūsā yadvat tasya sarvvaparivāramadhye viśvāsya āsīt, tadvat ayamapi svaniyojakasya samīpe viśvāsyo bhavati|</para>
  <para style="p">
    <verse number="3" style="v"/>parivārācca yadvat tatsthāpayituradhikaṁ gauravaṁ bhavati tadvat mūsaso'yaṁ bahutaragauravasya yogyo bhavati|</para>
  <para style="p">
    <verse number="4" style="v"/>ekaikasya niveśanasya parijanānāṁ sthāpayitā kaścid vidyate yaśca sarvvasthāpayitā sa īśvara eva|</para>
  <para style="p">
    <verse number="5" style="v"/>mūsāśca vakṣyamāṇānāṁ sākṣī bhṛtya iva tasya sarvvaparijanamadhye viśvāsyo'bhavat kintu khrīṣṭastasya parijanānāmadhyakṣa iva|</para>
  <para style="p">
    <verse number="6" style="v"/>vayaṁ tu yadi viśvāsasyotsāhaṁ ślāghanañca śeṣaṁ yāvad dhārayāmastarhi tasya parijanā bhavāmaḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>ato hetoḥ pavitreṇātmanā yadvat kathitaṁ, tadvat, "adya yūyaṁ kathāṁ tasya yadi saṁśrotumicchatha|</para>
  <para style="p">
    <verse number="8" style="v"/>tarhi purā parīkṣāyā dine prāntaramadhyataḥ| madājñānigrahasthāne yuṣmābhistu kṛtaṁ yathā| tathā mā kurutedānīṁ kaṭhināni manāṁsi vaḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>yuṣmākaṁ pitarastatra matparīkṣām akurvvata| kurvvadbhi rme'nusandhānaṁ tairadṛśyanta matkriyāḥ| catvāriṁśatsamā yāvat kruddhvāhantu tadanvaye|</para>
  <para style="p">
    <verse number="10" style="v"/>avādiṣam ime lokā bhrāntāntaḥkaraṇāḥ sadā| māmakīnāni vartmāni parijānanti no ime|</para>
  <para style="p">
    <verse number="11" style="v"/>iti hetorahaṁ kopāt śapathaṁ kṛtavān imaṁ| prevekṣyate janairetai rna viśrāmasthalaṁ mama||"</para>
  <para style="p">
    <verse number="12" style="v"/>he bhrātaraḥ sāvadhānā bhavata, amareśvarāt nivarttako yo'viśvāsastadyuktaṁ duṣṭāntaḥkaraṇaṁ yuṣmākaṁ kasyāpi na bhavatu|</para>
  <para style="p">
    <verse number="13" style="v"/>kintu yāvad adyanāmā samayo vidyate tāvad yuṣmanmadhye ko'pi pāpasya vañcanayā yat kaṭhorīkṛto na bhavet tadarthaṁ pratidinaṁ parasparam upadiśata|</para>
  <para style="p">
    <verse number="14" style="v"/>yato vayaṁ khrīṣṭasyāṁśino jātāḥ kintu prathamaviśvāsasya dṛḍhatvam asmābhiḥ śeṣaṁ yāvad amoghaṁ dhārayitavyaṁ|</para>
  <para style="p">
    <verse number="15" style="v"/>adya yūyaṁ kathāṁ tasya yadi saṁśrotumicchatha, tarhyājñālaṅghanasthāne yuṣmābhistu kṛtaṁ yathā, tathā mā kurutedānīṁ kaṭhināni manāṁsi va iti tena yaduktaṁ,</para>
  <para style="p">
    <verse number="16" style="v"/>tadanusārād ye śrutvā tasya kathāṁ na gṛhītavantaste ke? kiṁ mūsasā misaradeśād āgatāḥ sarvve lokā nahi?</para>
  <para style="p">
    <verse number="17" style="v"/>kebhyo vā sa catvāriṁśadvarṣāṇi yāvad akrudhyat? pāpaṁ kurvvatāṁ yeṣāṁ kuṇapāḥ prāntare 'patan kiṁ tebhyo nahi?</para>
  <para style="p">
    <verse number="18" style="v"/>pravekṣyate janairetai rna viśrāmasthalaṁ mameti śapathaḥ keṣāṁ viruddhaṁ tenākāri? kim aviśvāsināṁ viruddhaṁ nahi?</para>
  <para style="p">
    <verse number="19" style="v"/>ataste tat sthānaṁ praveṣṭum aviśvāsāt nāśaknuvan iti vayaṁ vīkṣāmahe|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparaṁ tadviśrāmaprāpteḥ pratijñā yadi tiṣṭhati tarhyasmākaṁ kaścit cet tasyāḥ phalena vañcito bhavet vayam etasmād bibhīmaḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>yato 'smākaṁ samīpe yadvat tadvat teṣāṁ samīpe'pi susaṁvādaḥ pracārito 'bhavat kintu taiḥ śrutaṁ vākyaṁ tān prati niṣphalam abhavat, yataste śrotāro viśvāsena sārddhaṁ tannāmiśrayan|</para>
  <para style="p">
    <verse number="3" style="v"/>tad viśrāmasthānaṁ viśvāsibhirasmābhiḥ praviśyate yatastenoktaṁ, "ahaṁ kopāt śapathaṁ kṛtavān imaṁ, pravekṣyate janairetai rna viśrāmasthalaṁ mama|" kintu tasya karmmāṇi jagataḥ sṛṣṭikālāt samāptāni santi|</para>
  <para style="p">
    <verse number="4" style="v"/>yataḥ kasmiṁścit sthāne saptamaṁ dinamadhi tenedam uktaṁ, yathā, "īśvaraḥ saptame dine svakṛtebhyaḥ sarvvakarmmabhyo viśaśrāma|"</para>
  <para style="p">
    <verse number="5" style="v"/>kintvetasmin sthāne punastenocyate, yathā, "pravekṣyate janairetai rna viśrāmasthalaṁ mama|"</para>
  <para style="p">
    <verse number="6" style="v"/>phalatastat sthānaṁ kaiścit praveṣṭavyaṁ kintu ye purā susaṁvādaṁ śrutavantastairaviśvāsāt tanna praviṣṭam,</para>
  <para style="p">
    <verse number="7" style="v"/>iti hetoḥ sa punaradyanāmakaṁ dinaṁ nirūpya dīrghakāle gate'pi pūrvvoktāṁ vācaṁ dāyūdā kathayati, yathā, "adya yūyaṁ kathāṁ tasya yadi saṁśrotumicchatha, tarhi mā kurutedānīṁ kaṭhināni manāṁsi vaḥ|"</para>
  <para style="p">
    <verse number="8" style="v"/>aparaṁ yihośūyo yadi tān vyaśrāmayiṣyat tarhi tataḥ param aparasya dinasya vāg īśvareṇa nākathayiṣyata|</para>
  <para style="p">
    <verse number="9" style="v"/>ata īśvarasya prajābhiḥ karttavya eko viśrāmastiṣṭhati|</para>
  <para style="p">
    <verse number="10" style="v"/>aparam īśvaro yadvat svakṛtakarmmabhyo viśaśrāma tadvat tasya viśrāmasthānaṁ praviṣṭo jano'pi svakṛtakarmmabhyo viśrāmyati|</para>
  <para style="p">
    <verse number="11" style="v"/>ato vayaṁ tad viśrāmasthānaṁ praveṣṭuṁ yatāmahai, tadaviśvāsodāharaṇena ko'pi na patatu|</para>
  <para style="p">
    <verse number="12" style="v"/>īśvarasya vādo'maraḥ prabhāvaviśiṣṭaśca sarvvasmād dvidhārakhaṅgādapi tīkṣṇaḥ, aparaṁ prāṇātmano rgranthimajjayośca paribhedāya vicchedakārī manasaśca saṅkalpānām abhipretānāñca vicārakaḥ|</para>
  <para style="p">
    <verse number="13" style="v"/>aparaṁ yasya samīpe svīyā svīyā kathāsmābhiḥ kathayitavyā tasyāgocaraḥ ko'pi prāṇī nāsti tasya dṛṣṭau sarvvamevānāvṛtaṁ prakāśitañcāste|</para>
  <para style="p">
    <verse number="14" style="v"/>aparaṁ ya uccatamaṁ svargaṁ praviṣṭa etādṛśa eko vyaktirarthata īśvarasya putro yīśurasmākaṁ mahāyājako'sti, ato heto rvayaṁ dharmmapratijñāṁ dṛḍham ālambāmahai|</para>
  <para style="p">
    <verse number="15" style="v"/>asmākaṁ yo mahāyājako 'sti so'smākaṁ duḥkhai rduḥkhito bhavitum aśakto nahi kintu pāpaṁ vinā sarvvaviṣaye vayamiva parīkṣitaḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>ataeva kṛpāṁ grahītuṁ prayojanīyopakārārtham anugrahaṁ prāptuñca vayam utsāhenānugrahasiṁhāsanasya samīpaṁ yāmaḥ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yaḥ kaścit mahāyājako bhavati sa mānavānāṁ madhyāt nītaḥ san mānavānāṁ kṛta īśvaroddeśyaviṣaye'rthata upahārāṇāṁ pāpārthakabalīnāñca dāna niyujyate|</para>
  <para style="p">
    <verse number="2" style="v"/>sa cājñānāṁ bhrāntānāñca lokānāṁ duḥkhena duḥkhī bhavituṁ śaknoti, yato hetoḥ sa svayamapi daurbbalyaveṣṭito bhavati|</para>
  <para style="p">
    <verse number="3" style="v"/>etasmāt kāraṇācca yadvat lokānāṁ kṛte tadvad ātmakṛte'pi pāpārthakabalidānaṁ tena karttavyaṁ|</para>
  <para style="p">
    <verse number="4" style="v"/>sa ghoccapadaḥ svecchātaḥ kenāpi na gṛhyate kintu hāroṇa iva ya īśvareṇāhūyate tenaiva gṛhyate|</para>
  <para style="p">
    <verse number="5" style="v"/>evamprakāreṇa khrīṣṭo'pi mahāyājakatvaṁ grahītuṁ svīyagauravaṁ svayaṁ na kṛtavān, kintu "madīyatanayo'si tvam adyaiva janito mayeti" vācaṁ yastaṁ bhāṣitavān sa eva tasya gauravaṁ kṛtavān|</para>
  <para style="p">
    <verse number="6" style="v"/>tadvad anyagīte'pīdamuktaṁ, tvaṁ malkīṣedakaḥ śreṇyāṁ yājako'si sadātanaḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>sa ca dehavāsakāle bahukrandanenāśrupātena ca mṛtyuta uddharaṇe samarthasya pituḥ samīpe punaḥ punarvinatiṁ prarthanāñca kṛtvā tatphalarūpiṇīṁ śaṅkāto rakṣāṁ prāpya ca</para>
  <para style="p">
    <verse number="8" style="v"/>yadyapi putro'bhavat tathāpi yairakliśyata tairājñāgrahaṇam aśikṣata|</para>
  <para style="p">
    <verse number="9" style="v"/>itthaṁ siddhībhūya nijājñāgrāhiṇāṁ sarvveṣām anantaparitrāṇasya kāraṇasvarūpo 'bhavat|</para>
  <para style="p">
    <verse number="10" style="v"/>tasmāt sa malkīṣedakaḥ śreṇībhukto mahāyājaka īśvareṇākhyātaḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>tamadhyasmākaṁ bahukathāḥ kathayitavyāḥ kintu tāḥ stabdhakarṇai ryuṣmābhi rdurgamyāḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>yato yūyaṁ yadyapi samayasya dīrghatvāt śikṣakā bhavitum aśakṣyata tathāpīśvarasya vākyānāṁ yā prathamā varṇamālā tāmadhi śikṣāprāpti ryuṣmākaṁ punarāvaśyakā bhavati, tathā kaṭhinadravye nahi kintu dugdhe yuṣmākaṁ prayojanam āste|</para>
  <para style="p">
    <verse number="13" style="v"/>yo dugdhapāyī sa śiśurevetikāraṇāt dharmmavākye tatparo nāsti|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu sadasadvicāre yeṣāṁ cetāṁsi vyavahāreṇa śikṣitāni tādṛśānāṁ siddhalokānāṁ kaṭhoradravyeṣu prayojanamasti|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>vayaṁ mṛtijanakakarmmabhyo manaḥparāvarttanam īśvare viśvāso majjanaśikṣaṇaṁ hastārpaṇaṁ mṛtalokānām utthānam</para>
  <para style="p">
    <verse number="2" style="v"/>anantakālasthāyivicārājñā caitaiḥ punarbhittimūlaṁ na sthāpayantaḥ khrīṣṭaviṣayakaṁ prathamopadeśaṁ paścātkṛtya siddhiṁ yāvad agrasarā bhavāma|</para>
  <para style="p">
    <verse number="3" style="v"/>īśvarasyānumatyā ca tad asmābhiḥ kāriṣyate|</para>
  <para style="p">
    <verse number="4" style="v"/>ya ekakṛtvo dīptimayā bhūtvā svargīyavararasam āsvaditavantaḥ pavitrasyātmano'ṁśino jātā</para>
  <para style="p">
    <verse number="5" style="v"/>īśvarasya suvākyaṁ bhāvikālasya śaktiñcāsvaditavantaśca te bhraṣṭvā yadi</para>
  <para style="p">
    <verse number="6" style="v"/>svamanobhirīśvarasya putraṁ punaḥ kruśe ghnanti lajjāspadaṁ kurvvate ca tarhi manaḥparāvarttanāya punastān navīnīkarttuṁ ko'pi na śaknoti|</para>
  <para style="p">
    <verse number="7" style="v"/>yato yā bhūmiḥ svopari bhūyaḥ patitaṁ vṛṣṭiṁ pivatī tatphalādhikāriṇāṁ nimittam iṣṭāni śākādīnyutpādayati sā īśvarād āśiṣaṁ prāptā|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu yā bhūmi rgokṣurakaṇṭakavṛkṣān utpādayati sā na grāhyā śāpārhā ca śeṣe tasyā dāho bhaviṣyati|</para>
  <para style="p">
    <verse number="9" style="v"/>he priyatamāḥ, yadyapi vayam etādṛśaṁ vākyaṁ bhāṣāmahe tathāpi yūyaṁ tata utkṛṣṭāḥ paritrāṇapathasya pathikāścādhva iti viśvasāmaḥ|</para>
  <para style="p">
    <verse number="10" style="v"/>yato yuṣmābhiḥ pavitralokānāṁ ya upakāro 'kāri kriyate ca teneśvarasya nāmne prakāśitaṁ prema śramañca vismarttum īśvaro'nyāyakārī na bhavati|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaṁ yuṣmākam ekaiko jano yat pratyāśāpūraṇārthaṁ śeṣaṁ yāvat tameva yatnaṁ prakāśayedityaham icchāmi|</para>
  <para style="p">
    <verse number="12" style="v"/>ataḥ śithilā na bhavata kintu ye viśvāsena sahiṣṇutayā ca pratijñānāṁ phalādhikāriṇo jātāsteṣām anugāmino bhavata|</para>
  <para style="p">
    <verse number="13" style="v"/>īśvaro yadā ibrāhīme pratyajānāt tadā śreṣṭhasya kasyāpyaparasya nāmnā śapathaṁ karttuṁ nāśaknot, ato hetoḥ svanāmnā śapathaṁ kṛtvā tenoktaṁ yathā,</para>
  <para style="p">
    <verse number="14" style="v"/>"satyam ahaṁ tvām āśiṣaṁ gadiṣyāmi tavānvayaṁ varddhayiṣyāmi ca|"</para>
  <para style="p">
    <verse number="15" style="v"/>anena prakāreṇa sa sahiṣṇutāṁ vidhāya tasyāḥ pratyāśāyāḥ phalaṁ labdhavān|</para>
  <para style="p">
    <verse number="16" style="v"/>atha mānavāḥ śreṣṭhasya kasyacit nāmnā śapante, śapathaśca pramāṇārthaṁ teṣāṁ sarvvavivādāntako bhavati|</para>
  <para style="p">
    <verse number="17" style="v"/>ityasmin īśvaraḥ pratijñāyāḥ phalādhikāriṇaḥ svīyamantraṇāyā amoghatāṁ bāhulyato darśayitumicchan śapathena svapratijñāṁ sthirīkṛtavān|</para>
  <para style="p">
    <verse number="18" style="v"/>ataeva yasmin anṛtakathanam īśvarasya na sādhyaṁ tādṛśenācalena viṣayadvayena sammukhastharakṣāsthalasya prāptaye palāyitānām asmākaṁ sudṛḍhā sāntvanā jāyate|</para>
  <para style="p">
    <verse number="19" style="v"/>sā pratyāśāsmākaṁ manonaukāyā acalo laṅgaro bhūtvā vicchedakavastrasyābhyantaraṁ praviṣṭā|</para>
  <para style="p">
    <verse number="20" style="v"/>tatraivāsmākam agrasaro yīśuḥ praviśya malkīṣedakaḥ śreṇyāṁ nityasthāyī yājako'bhavat|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>śālamasya rājā sarvvoparisthasyeśvarasya yājakaśca san yo nṛpatīnāṁ māraṇāt pratyāgatam ibrāhīmaṁ sākṣātkṛtyāśiṣaṁ gaditavān,</para>
  <para style="p">
    <verse number="2" style="v"/>yasmai cebrāhīm sarvvadravyāṇāṁ daśamāṁśaṁ dattavān sa malkīṣedak svanāmno'rthena prathamato dharmmarājaḥ paścāt śālamasya rājārthataḥ śāntirājo bhavati|</para>
  <para style="p">
    <verse number="3" style="v"/>aparaṁ tasya pitā mātā vaṁśasya nirṇaya āyuṣa ārambho jīvanasya śeṣaścaiteṣām abhāvo bhavati, itthaṁ sa īśvaraputrasya sadṛśīkṛtaḥ, sa tvanantakālaṁ yāvad yājakastiṣṭhati|</para>
  <para style="p">
    <verse number="4" style="v"/>ataevāsmākaṁ pūrvvapuruṣa ibrāhīm yasmai luṭhitadravyāṇāṁ daśamāṁśaṁ dattavān sa kīdṛk mahān tad ālocayata|</para>
  <para style="p">
    <verse number="5" style="v"/>yājakatvaprāptā leveḥ santānā vyavasthānusāreṇa lokebhyo'rthata ibrāhīmo jātebhyaḥ svīyabhrātṛbhyo daśamāṁśagrahaṇasyādeśaṁ labdhavantaḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>kintvasau yadyapi teṣāṁ vaṁśāt notpannastathāpībrāhīmo daśamāṁśaṁ gṛhītavān pratijñānām adhikāriṇam āśiṣaṁ gaditavāṁśca|</para>
  <para style="p">
    <verse number="7" style="v"/>aparaṁ yaḥ śreyān sa kṣudratarāyāśiṣaṁ dadātītyatra ko'pi sandeho nāsti|</para>
  <para style="p">
    <verse number="8" style="v"/>aparam idānīṁ ye daśamāṁśaṁ gṛhlanti te mṛtyoradhīnā mānavāḥ kintu tadānīṁ yo gṛhītavān sa jīvatītipramāṇaprāptaḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>aparaṁ daśamāṁśagrāhī levirapībrāhīmdvārā daśamāṁśaṁ dattavān etadapi kathayituṁ śakyate|</para>
  <para style="p">
    <verse number="10" style="v"/>yato yadā malkīṣedak tasya pitaraṁ sākṣāt kṛtavān tadānīṁ sa leviḥ pitururasyāsīt|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaṁ yasya sambandhe lokā vyavasthāṁ labdhavantastena levīyayājakavargeṇa yadi siddhiḥ samabhaviṣyat tarhi hāroṇasya śreṇyā madhyād yājakaṁ na nirūpyeśvareṇa malkīṣedakaḥ śreṇyā madhyād aparasyaikasya yājakasyotthāpanaṁ kuta āvaśyakam abhaviṣyat?</para>
  <para style="p">
    <verse number="12" style="v"/>yato yājakavargasya vinimayena sutarāṁ vyavasthāyā api vinimayo jāyate|</para>
  <para style="p">
    <verse number="13" style="v"/>aparañca tad vākyaṁ yasyoddeśyaṁ so'pareṇa vaṁśena saṁyuktā'sti tasya vaṁśasya ca ko'pi kadāpi vedyāḥ karmma na kṛtavān|</para>
  <para style="p">
    <verse number="14" style="v"/>vastutastu yaṁ vaṁśamadhi mūsā yājakatvasyaikāṁ kathāmapi na kathitavān tasmin yihūdāvaṁśe'smākaṁ prabhu rjanma gṛhītavān iti suspaṣṭaṁ|</para>
  <para style="p">
    <verse number="15" style="v"/>tasya spaṣṭataram aparaṁ pramāṇamidaṁ yat malkīṣedakaḥ sādṛśyavatāpareṇa tādṛśena yājakenodetavyaṁ,</para>
  <para style="p">
    <verse number="16" style="v"/>yasya nirūpaṇaṁ śarīrasambandhīyavidhiyuktayā vyavasthāyā na bhavati kintvakṣayajīvanayuktayā śaktyā bhavati|</para>
  <para style="p">
    <verse number="17" style="v"/>yata īśvara idaṁ sākṣyaṁ dattavān, yathā, "tvaṁ maklīṣedakaḥ śreṇyāṁ yājako'si sadātanaḥ|"</para>
  <para style="p">
    <verse number="18" style="v"/>anenāgravarttino vidhe durbbalatāyā niṣphalatāyāśca hetorarthato vyavasthayā kimapi siddhaṁ na jātamitihetostasya lopo bhavati|</para>
  <para style="p">
    <verse number="19" style="v"/>yayā ca vayam īśvarasya nikaṭavarttino bhavāma etādṛśī śreṣṭhapratyāśā saṁsthāpyate|</para>
  <para style="p">
    <verse number="20" style="v"/>aparaṁ yīśuḥ śapathaṁ vinā na niyuktastasmādapi sa śreṣṭhaniyamasya madhyastho jātaḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>yataste śapathaṁ vinā yājakā jātāḥ kintvasau śapathena jātaḥ yataḥ sa idamuktaḥ, yathā,</para>
  <para style="p">
    <verse number="22" style="v"/>"parameśa idaṁ śepe na ca tasmānnivartsyate| tvaṁ malkīṣedakaḥ śreṇyāṁ yājako'si sadātanaḥ|"</para>
  <para style="p">
    <verse number="23" style="v"/>te ca bahavo yājakā abhavan yataste mṛtyunā nityasthāyitvāt nivāritāḥ,</para>
  <para style="p">
    <verse number="24" style="v"/>kintvasāvanantakālaṁ yāvat tiṣṭhati tasmāt tasya yājakatvaṁ na parivarttanīyaṁ|</para>
  <para style="p">
    <verse number="25" style="v"/>tato heto rye mānavāsteneśvarasya sannidhiṁ gacchanti tān sa śeṣaṁ yāvat paritrātuṁ śaknoti yatasteṣāṁ kṛte prārthanāṁ karttuṁ sa satataṁ jīvati|</para>
  <para style="p">
    <verse number="26" style="v"/>aparam asmākaṁ tādṛśamahāyājakasya prayojanamāsīd yaḥ pavitro 'hiṁsako niṣkalaṅkaḥ pāpibhyo bhinnaḥ svargādapyuccīkṛtaśca syāt|</para>
  <para style="p">
    <verse number="27" style="v"/>aparaṁ mahāyājakānāṁ yathā tathā tasya pratidinaṁ prathamaṁ svapāpānāṁ kṛte tataḥ paraṁ lokānāṁ pāpānāṁ kṛte balidānasya prayojanaṁ nāsti yata ātmabalidānaṁ kṛtvā tad ekakṛtvastena sampāditaṁ|</para>
  <para style="p">
    <verse number="28" style="v"/>yato vyavasthayā ye mahāyājakā nirūpyante te daurbbalyayuktā mānavāḥ kintu vyavasthātaḥ paraṁ śapathayuktena vākyena yo mahāyājako nirūpitaḥ so 'nantakālārthaṁ siddhaḥ putra eva|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>kathyamānānāṁ vākyānāṁ sāro'yam asmākam etādṛśa eko mahāyājako'sti yaḥ svarge mahāmahimnaḥ siṁhāsanasya dakṣiṇapārśvo samupaviṣṭavān</para>
  <para style="p">
    <verse number="2" style="v"/>yacca dūṣyaṁ na manujaiḥ kintvīśvareṇa sthāpitaṁ tasya satyadūṣyasya pavitravastūnāñca sevakaḥ sa bhavati|</para>
  <para style="p">
    <verse number="3" style="v"/>yata ekaiko mahāyājako naivedyānāṁ balīnāñca dāne niyujyate, ato hetoretasyāpi kiñcid utsarjanīyaṁ vidyata ityāvaśyakaṁ|</para>
  <para style="p">
    <verse number="4" style="v"/>kiñca sa yadi pṛthivyām asthāsyat tarhi yājako nābhaviṣyat, yato ye vyavasthānusārāt naivedyāni dadatyetādṛśā yājakā vidyante|</para>
  <para style="p">
    <verse number="5" style="v"/>te tu svargīyavastūnāṁ dṛṣṭāntena chāyayā ca sevāmanutiṣṭhanti yato mūsasi dūṣyaṁ sādhayitum udyate satīśvarastadeva tamādiṣṭavān phalataḥ sa tamuktavān, yathā, "avadhehi girau tvāṁ yadyannidarśanaṁ darśitaṁ tadvat sarvvāṇi tvayā kriyantāṁ|"</para>
  <para style="p">
    <verse number="6" style="v"/>kintvidānīm asau tasmāt śreṣṭhaṁ sevakapadaṁ prāptavān yataḥ sa śreṣṭhapratijñābhiḥ sthāpitasya śreṣṭhaniyamasya madhyastho'bhavat|</para>
  <para style="p">
    <verse number="7" style="v"/>sa prathamo niyamo yadi nirddoṣo'bhaviṣyata tarhi dvitīyasya niyamasya kimapi prayojanaṁ nābhaviṣyat|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu sa doṣamāropayan tebhyaḥ kathayati, yathā, "parameśvara idaṁ bhāṣate paśya yasmin samaye'ham isrāyelavaṁśena yihūdāvaṁśena ca sārddham ekaṁ navīnaṁ niyamaṁ sthirīkariṣyāmyetādṛśaḥ samaya āyāti|</para>
  <para style="p">
    <verse number="9" style="v"/>parameśvaro'paramapi kathayati teṣāṁ pūrvvapuruṣāṇāṁ misaradeśād ānayanārthaṁ yasmin dine'haṁ teṣāṁ karaṁ dhṛtvā taiḥ saha niyamaṁ sthirīkṛtavān taddinasya niyamānusāreṇa nahi yatastai rmama niyame laṅghite'haṁ tān prati cintāṁ nākaravaṁ|</para>
  <para style="p">
    <verse number="10" style="v"/>kintu parameśvaraḥ kathayati taddināt paramahaṁ isrāyelavaṁśīyaiḥ sārddham imaṁ niyamaṁ sthirīkariṣyāmi, teṣāṁ citte mama vidhīn sthāpayiṣyāmi teṣāṁ hṛtpatre ca tān lekhiṣyāmi, aparamahaṁ teṣām īśvaro bhaviṣyāmi te ca mama lokā bhaviṣyanti|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaṁ tvaṁ parameśvaraṁ jānīhītivākyena teṣāmekaiko janaḥ svaṁ svaṁ samīpavāsinaṁ bhrātarañca puna rna śikṣayiṣyati yata ākṣudrāt mahāntaṁ yāvat sarvve māṁ jñāsyanti|</para>
  <para style="p">
    <verse number="12" style="v"/>yato hetorahaṁ teṣām adharmmān kṣamiṣye teṣāṁ pāpānyaparādhāṁśca punaḥ kadāpi na smariṣyāmi|"</para>
  <para style="p">
    <verse number="13" style="v"/>anena taṁ niyamaṁ nūtanaṁ gaditvā sa prathamaṁ niyamaṁ purātanīkṛtavān; yacca purātanaṁ jīrṇāñca jātaṁ tasya lopo nikaṭo 'bhavat|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>sa prathamo niyama ārādhanāyā vividharītibhiraihikapavitrasthānena ca viśiṣṭa āsīt|</para>
  <para style="p">
    <verse number="2" style="v"/>yato dūṣyamekaṁ niramīyata tasya prathamakoṣṭhasya nāma pavitrasthānamityāsīt tatra dīpavṛkṣo bhojanāsanaṁ darśanīyapūpānāṁ śreṇī cāsīt|</para>
  <para style="p">
    <verse number="3" style="v"/>tatpaścād dvitīyāyāstiraṣkariṇyā abhyantare 'tipavitrasthānamitināmakaṁ koṣṭhamāsīt,</para>
  <para style="p">
    <verse number="4" style="v"/>tatra ca suvarṇamayo dhūpādhāraḥ paritaḥ suvarṇamaṇḍitā niyamamañjūṣā cāsīt tanmadhye mānnāyāḥ suvarṇaghaṭo hāroṇasya mañjaritadaṇḍastakṣitau niyamaprastarau,</para>
  <para style="p">
    <verse number="5" style="v"/>tadupari ca karuṇāsane chāyākāriṇau tejomayau kirūbāvāstām, eteṣāṁ viśeṣavṛttāntakathanāya nāyaṁ samayaḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>eteṣvīdṛk nirmmiteṣu yājakā īśvarasevām anutiṣṭhanato dūṣyasya prathamakoṣṭhaṁ nityaṁ praviśanti|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu dvitīyaṁ koṣṭhaṁ prativarṣam ekakṛtva ekākinā mahāyājakena praviśyate kintvātmanimittaṁ lokānām ajñānakṛtapāpānāñca nimittam utsarjjanīyaṁ rudhiram anādāya tena na praviśyate|</para>
  <para style="p">
    <verse number="8" style="v"/>ityanena pavitra ātmā yat jñāpayati tadidaṁ tat prathamaṁ dūṣyaṁ yāvat tiṣṭhati tāvat mahāpavitrasthānagāmī panthā aprakāśitastiṣṭhati|</para>
  <para style="p">
    <verse number="9" style="v"/>tacca dūṣyaṁ varttamānasamayasya dṛṣṭāntaḥ, yato hetoḥ sāmprataṁ saṁśodhanakālaṁ yāvad yannirūpitaṁ tadanusārāt sevākāriṇo mānasikasiddhikaraṇe'samarthābhiḥ</para>
  <para style="p">
    <verse number="10" style="v"/>kevalaṁ khādyapeyeṣu vividhamajjaneṣu ca śārīrikarītibhi ryuktāni naivedyāni balidānāni ca bhavanti|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaṁ bhāvimaṅgalānāṁ mahāyājakaḥ khrīṣṭa upasthāyāhastanirmmitenārthata etatsṛṣṭe rbahirbhūtena śreṣṭhena siddhena ca dūṣyeṇa gatvā</para>
  <para style="p">
    <verse number="12" style="v"/>chāgānāṁ govatsānāṁ vā rudhiram anādāya svīyarudhiram ādāyaikakṛtva eva mahāpavitrasthānaṁ praviśyānantakālikāṁ muktiṁ prāptavān|</para>
  <para style="p">
    <verse number="13" style="v"/>vṛṣachāgānāṁ rudhireṇa gavībhasmanaḥ prakṣepeṇa ca yadyaśucilokāḥ śārīriśucitvāya pūyante,</para>
  <para style="p">
    <verse number="14" style="v"/>tarhi kiṁ manyadhve yaḥ sadātanenātmanā niṣkalaṅkabalimiva svameveśvarāya dattavān, tasya khrīṣṭasya rudhireṇa yuṣmākaṁ manāṁsyamareśvarasya sevāyai kiṁ mṛtyujanakebhyaḥ karmmabhyo na pavitrīkāriṣyante?</para>
  <para style="p">
    <verse number="15" style="v"/>sa nūtananiyamasya madhyastho'bhavat tasyābhiprāyo'yaṁ yat prathamaniyamalaṅghanarūpapāpebhyo mṛtyunā muktau jātāyām āhūtalokā anantakālīyasampadaḥ pratijñāphalaṁ labheran|</para>
  <para style="p">
    <verse number="16" style="v"/>yatra niyamo bhavati tatra niyamasādhakasya bale rmṛtyunā bhavitavyaṁ|</para>
  <para style="p">
    <verse number="17" style="v"/>yato hatena balinā niyamaḥ sthirībhavati kintu niyamasādhako bali ryāvat jīvati tāvat niyamo nirarthakastiṣṭhati|</para>
  <para style="p">
    <verse number="18" style="v"/>tasmāt sa pūrvvaniyamo'pi rudhirapātaṁ vinā na sādhitaḥ|</para>
  <para style="p">
    <verse number="19" style="v"/>phalataḥ sarvvalokān prati vyavasthānusāreṇa sarvvā ājñāḥ kathayitvā mūsā jalena sindūravarṇalomnā eṣovatṛṇena ca sārddhaṁ govatsānāṁ chāgānāñca rudhiraṁ gṛhītvā granthe sarvvalokeṣu ca prakṣipya babhāṣe,</para>
  <para style="p">
    <verse number="20" style="v"/>yuṣmān adhīśvaro yaṁ niyamaṁ nirūpitavān tasya rudhirametat|</para>
  <para style="p">
    <verse number="21" style="v"/>tadvat sa dūṣye'pi sevārthakeṣu sarvvapātreṣu ca rudhiraṁ prakṣiptavān|</para>
  <para style="p">
    <verse number="22" style="v"/>aparaṁ vyavasthānusāreṇa prāyaśaḥ sarvvāṇi rudhireṇa pariṣkriyante rudhirapātaṁ vinā pāpamocanaṁ na bhavati ca|</para>
  <para style="p">
    <verse number="23" style="v"/>aparaṁ yāni svargīyavastūnāṁ dṛṣṭāntāsteṣām etaiḥ pāvanam āvaśyakam āsīt kintu sākṣāt svargīyavastūnām etebhyaḥ śreṣṭheै rbalidānaiḥ pāvanamāvaśyakaṁ|</para>
  <para style="p">
    <verse number="24" style="v"/>yataḥ khrīṣṭaḥ satyapavitrasthānasya dṛṣṭāntarūpaṁ hastakṛtaṁ pavitrasthānaṁ na praviṣṭavān kintvasmannimittam idānīm īśvarasya sākṣād upasthātuṁ svargameva praviṣṭaḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>yathā ca mahāyājakaḥ prativarṣaṁ paraśoṇitamādāya mahāpavitrasthānaṁ praviśati tathā khrīṣṭena punaḥ punarātmotsargo na karttavyaḥ,</para>
  <para style="p">
    <verse number="26" style="v"/>karttavye sati jagataḥ sṛṣṭikālamārabhya bahuvāraṁ tasya mṛtyubhoga āvaśyako'bhavat; kintvidānīṁ sa ātmotsargeṇa pāpanāśārtham ekakṛtvo jagataḥ śeṣakāle pracakāśe|</para>
  <para style="p">
    <verse number="27" style="v"/>aparaṁ yathā mānuṣasyaikakṛtvo maraṇaṁ tat paścād vicāro nirūpito'sti,</para>
  <para style="p">
    <verse number="28" style="v"/>tadvat khrīṣṭo'pi bahūnāṁ pāpavahanārthaṁ balirūpeṇaikakṛtva utsasṛje, aparaṁ dvitīyavāraṁ pāpād bhinnaḥ san ye taṁ pratīkṣante teṣāṁ paritrāṇārthaṁ darśanaṁ dāsyati|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>vyavasthā bhaviṣyanmaṅgalānāṁ chāyāsvarūpā na ca vastūnāṁ mūrttisvarūpā tato heto rnityaṁ dīyamānairekavidhai rvārṣikabalibhiḥ śaraṇāgatalokān siddhān karttuṁ kadāpi na śaknoti|</para>
  <para style="p">
    <verse number="2" style="v"/>yadyaśakṣyat tarhi teṣāṁ balīnāṁ dānaṁ kiṁ na nyavarttiṣyata? yataḥ sevākāriṣvekakṛtvaḥ pavitrībhūteṣu teṣāṁ ko'pi pāpabodhaḥ puna rnābhaviṣyat|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu tai rbalidānaiḥ prativatsaraṁ pāpānāṁ smāraṇaṁ jāyate|</para>
  <para style="p">
    <verse number="4" style="v"/>yato vṛṣāṇāṁ chāgānāṁ vā rudhireṇa pāpamocanaṁ na sambhavati|</para>
  <para style="p">
    <verse number="5" style="v"/>etatkāraṇāt khrīṣṭena jagat praviśyedam ucyate, yathā, "neṣṭvā baliṁ na naivedyaṁ deho me nirmmitastvayā|</para>
  <para style="p">
    <verse number="6" style="v"/>na ca tvaṁ balibhi rhavyaiḥ pāpaghnai rvā pratuṣyasi|</para>
  <para style="p">
    <verse number="7" style="v"/>avādiṣaṁ tadaivāhaṁ paśya kurvve samāgamaṁ| dharmmagranthasya sarge me vidyate likhitā kathā| īśa mano'bhilāṣaste mayā sampūrayiṣyate|"</para>
  <para style="p">
    <verse number="8" style="v"/>ityasmin prathamato yeṣāṁ dānaṁ vyavasthānusārād bhavati tānyadhi tenedamuktaṁ yathā, balinaivedyahavyāni pāpaghnañcopacārakaṁ, nemāni vāñchasi tvaṁ hi na caiteṣu pratuṣyasīti|</para>
  <para style="p">
    <verse number="9" style="v"/>tataḥ paraṁ tenoktaṁ yathā, "paśya mano'bhilāṣaṁ te karttuṁ kurvve samāgamaṁ;" dvitīyam etad vākyaṁ sthirīkarttuṁ sa prathamaṁ lumpati|</para>
  <para style="p">
    <verse number="10" style="v"/>tena mano'bhilāṣeṇa ca vayaṁ yīśukhrīṣṭasyaikakṛtvaḥ svaśarīrotsargāt pavitrīkṛtā abhavāma|</para>
  <para style="p">
    <verse number="11" style="v"/>aparam ekaiko yājakaḥ pratidinam upāsanāṁ kurvvan yaiśca pāpāni nāśayituṁ kadāpi na śakyante tādṛśān ekarūpān balīn punaḥ punarutsṛjan tiṣṭhati|</para>
  <para style="p">
    <verse number="12" style="v"/>kintvasau pāpanāśakam ekaṁ baliṁ datvānantakālārtham īśvarasya dakṣiṇa upaviśya</para>
  <para style="p">
    <verse number="13" style="v"/>yāvat tasya śatravastasya pādapīṭhaṁ na bhavanti tāvat pratīkṣamāṇastiṣṭhati|</para>
  <para style="p">
    <verse number="14" style="v"/>yata ekena balidānena so'nantakālārthaṁ pūyamānān lokān sādhitavān|</para>
  <para style="p">
    <verse number="15" style="v"/>etasmin pavitra ātmāpyasmākaṁ pakṣe pramāṇayati</para>
  <para style="p">
    <verse number="16" style="v"/>"yato hetostaddināt param ahaṁ taiḥ sārddham imaṁ niyamaṁ sthirīkariṣyāmīti prathamata uktvā parameśvareṇedaṁ kathitaṁ, teṣāṁ citte mama vidhīn sthāpayiṣyāmi teṣāṁ manaḥsu ca tān lekhiṣyāmi ca,</para>
  <para style="p">
    <verse number="17" style="v"/>aparañca teṣāṁ pāpānyaparādhāṁśca punaḥ kadāpi na smāriṣyāmi|"</para>
  <para style="p">
    <verse number="18" style="v"/>kintu yatra pāpamocanaṁ bhavati tatra pāpārthakabalidānaṁ puna rna bhavati|</para>
  <para style="p">
    <verse number="19" style="v"/>ato he bhrātaraḥ, yīśo rudhireṇa pavitrasthānapraveśāyāsmākam utsāho bhavati,</para>
  <para style="p">
    <verse number="20" style="v"/>yataḥ so'smadarthaṁ tiraskariṇyārthataḥ svaśarīreṇa navīnaṁ jīvanayuktañcaikaṁ panthānaṁ nirmmitavān,</para>
  <para style="p">
    <verse number="21" style="v"/>aparañceśvarīyaparivārasyādhyakṣa eko mahāyājako'smākamasti|</para>
  <para style="p">
    <verse number="22" style="v"/>ato hetorasmābhiḥ saralāntaḥkaraṇai rdṛḍhaviśvāsaiḥ pāpabodhāt prakṣālitamanobhi rnirmmalajale snātaśarīraiśceśvaram upāgatya pratyāśāyāḥ pratijñā niścalā dhārayitavyā|</para>
  <para style="p">
    <verse number="23" style="v"/>yato yastām aṅgīkṛtavān sa viśvasanīyaḥ|</para>
  <para style="p">
    <verse number="24" style="v"/>aparaṁ premni satkriyāsu caikaikasyotsāhavṛddhyartham asmābhiḥ parasparaṁ mantrayitavyaṁ|</para>
  <para style="p">
    <verse number="25" style="v"/>aparaṁ katipayalokā yathā kurvvanti tathāsmābhiḥ sabhākaraṇaṁ na parityaktavyaṁ parasparam upadeṣṭavyañca yatastat mahādinam uttarottaraṁ nikaṭavartti bhavatīti yuṣmābhi rdṛśyate|</para>
  <para style="p">
    <verse number="26" style="v"/>satyamatasya jñānaprāpteḥ paraṁ yadi vayaṁ svaṁcchayā pāpācāraṁ kurmmastarhi pāpānāṁ kṛte 'nyat kimapi balidānaṁ nāvaśiṣyate</para>
  <para style="p">
    <verse number="27" style="v"/>kintu vicārasya bhayānakā pratīkṣā ripunāśakānalasya tāpaścāvaśiṣyate|</para>
  <para style="p">
    <verse number="28" style="v"/>yaḥ kaścit mūsaso vyavasthām avamanyate sa dayāṁ vinā dvayostisṛṇāṁ vā sākṣiṇāṁ pramāṇena hanyate,</para>
  <para style="p">
    <verse number="29" style="v"/>tasmāt kiṁ budhyadhve yo jana īśvarasya putram avajānāti yena ca pavitrīkṛto 'bhavat tat niyamasya rudhiram apavitraṁ jānāti, anugrahakaram ātmānam apamanyate ca, sa kiyanmahāghorataradaṇḍasya yogyo bhaviṣyati?</para>
  <para style="p">
    <verse number="30" style="v"/>yataḥ parameśvaraḥ kathayati, "dānaṁ phalasya matkarmma sūcitaṁ pradadāmyahaṁ|" punarapi, "tadā vicārayiṣyante pareśena nijāḥ prajāḥ|" idaṁ yaḥ kathitavān taṁ vayaṁ jānīmaḥ|</para>
  <para style="p">
    <verse number="31" style="v"/>amareśvarasya karayoḥ patanaṁ mahābhayānakaṁ|</para>
  <para style="p">
    <verse number="32" style="v"/>he bhrātaraḥ, pūrvvadināni smarata yatastadānīṁ yūyaṁ dīptiṁ prāpya bahudurgatirūpaṁ saṁgrāmaṁ sahamānā ekato nindākleśaiḥ kautukīkṛtā abhavata,</para>
  <para style="p">
    <verse number="33" style="v"/>anyataśca tadbhogināṁ samāṁśino 'bhavata|</para>
  <para style="p">
    <verse number="34" style="v"/>yūyaṁ mama bandhanasya duḥkhena duḥkhino 'bhavata, yuṣmākam uttamā nityā ca sampattiḥ svarge vidyata iti jñātvā sānandaṁ sarvvasvasyāpaharaṇam asahadhvañca|</para>
  <para style="p">
    <verse number="35" style="v"/>ataeva mahāpuraskārayuktaṁ yuṣmākam utsāhaṁ na parityajata|</para>
  <para style="p">
    <verse number="36" style="v"/>yato yūyaṁ yeneśvarasyecchāṁ pālayitvā pratijñāyāḥ phalaṁ labhadhvaṁ tadarthaṁ yuṣmābhi rdhairyyāvalambanaṁ karttavyaṁ|</para>
  <para style="p">
    <verse number="37" style="v"/>yenāgantavyaṁ sa svalpakālāt param āgamiṣyati na ca vilambiṣyate|</para>
  <para style="p">
    <verse number="38" style="v"/>"puṇyavān jano viśvāsena jīviṣyati kintu yadi nivarttate tarhi mama manastasmin na toṣaṁ yāsyati|"</para>
  <para style="p">
    <verse number="39" style="v"/>kintu vayaṁ vināśajanikāṁ dharmmāt nivṛttiṁ na kurvvāṇā ātmanaḥ paritrāṇāya viśvāsaṁ kurvvāmaheे|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>viśvāsa āśaṁsitānāṁ niścayaḥ, adṛśyānāṁ viṣayāṇāṁ darśanaṁ bhavati|</para>
  <para style="p">
    <verse number="2" style="v"/>tena viśvāsena prāñco lokāḥ prāmāṇyaṁ prāptavantaḥ|</para>
  <para style="p">
    <verse number="3" style="v"/>aparam īśvarasya vākyena jagantyasṛjyanta, dṛṣṭavastūni ca pratyakṣavastubhyo nodapadyantaitad vayaṁ viśvāsena budhyāmahe|</para>
  <para style="p">
    <verse number="4" style="v"/>viśvāsena hābil īśvaramuddiśya kābilaḥ śreṣṭhaṁ balidānaṁ kṛtavān tasmācceśvareṇa tasya dānānyadhi pramāṇe datte sa dhārmmika ityasya pramāṇaṁ labdhavān tena viśvāsena ca sa mṛtaḥ san adyāpi bhāṣate|</para>
  <para style="p">
    <verse number="5" style="v"/>viśvāsena hanok yathā mṛtyuṁ na paśyet tathā lokāntaraṁ nītaḥ, tasyoddeśaśca kenāpi na prāpi yata īśvarastaṁ lokāntaraṁ nītavān, tatpramāṇamidaṁ tasya lokāntarīkaraṇāt pūrvvaṁ sa īśvarāya rocitavān iti pramāṇaṁ prāptavān|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu viśvāsaṁ vinā ko'pīśvarāya rocituṁ na śaknoti yata īśvaro'sti svānveṣilokebhyaḥ puraskāraṁ dadāti cetikathāyām īśvaraśaraṇāgatai rviśvasitavyaṁ|</para>
  <para style="p">
    <verse number="7" style="v"/>aparaṁ tadānīṁ yānyadṛśyānyāsan tānīśvareṇādiṣṭaḥ san noho viśvāsena bhītvā svaparijanānāṁ rakṣārthaṁ potaṁ nirmmitavān tena ca jagajjanānāṁ doṣān darśitavān viśvāsāt labhyasya puṇyasyādhikārī babhūva ca|</para>
  <para style="p">
    <verse number="8" style="v"/>viśvāsenebrāhīm āhūtaḥ san ājñāṁ gṛhītvā yasya sthānasyādhikārastena prāptavyastat sthānaṁ prasthitavān kintu prasthānasamaye kka yāmīti nājānāt|</para>
  <para style="p">
    <verse number="9" style="v"/>viśvāsena sa pratijñāte deśe paradeśavat pravasan tasyāḥ pratijñāyāḥ samānāṁśibhyām ishākā yākūbā ca saha dūṣyavāsyabhavat|</para>
  <para style="p">
    <verse number="10" style="v"/>yasmāt sa īśvareṇa nirmmitaṁ sthāpitañca bhittimūlayuktaṁ nagaraṁ pratyaikṣata|</para>
  <para style="p">
    <verse number="11" style="v"/>aparañca viśvāsena sārā vayotikrāntā santyapi garbhadhāraṇāya śaktiṁ prāpya putravatyabhavat, yataḥ sā pratijñākāriṇaṁ viśvāsyam amanyata|</para>
  <para style="p">
    <verse number="12" style="v"/>tato heto rmṛtakalpād ekasmāt janād ākāśīyanakṣatrāṇīva gaṇanātītāḥ samudratīrasthasikatā iva cāsaṁkhyā lokā utpedire|</para>
  <para style="p">
    <verse number="13" style="v"/>ete sarvve pratijñāyāḥ phalānyaprāpya kevalaṁ dūrāt tāni nirīkṣya vanditvā ca, pṛthivyāṁ vayaṁ videśinaḥ pravāsinaścāsmaha iti svīkṛtya viśvāsena prāṇān tatyajuḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>ye tu janā itthaṁ kathayanti taiḥ paitṛkadeśo 'smābhiranviṣyata iti prakāśyate|</para>
  <para style="p">
    <verse number="15" style="v"/>te yasmād deśāt nirgatāstaṁ yadyasmariṣyan tarhi parāvarttanāya samayam alapsyanta|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu te sarvvotkṛṣṭam arthataḥ svargīyaṁ deśam ākāṅkṣanti tasmād īśvarastānadhi na lajjamānasteṣām īśvara iti nāma gṛhītavān yataḥ sa teṣāṁ kṛte nagaramekaṁ saṁsthāpitavān|</para>
  <para style="p">
    <verse number="17" style="v"/>aparam ibrāhīmaḥ parīkṣāyāṁ jātāyāṁ sa viśvāseneshākam utsasarja,</para>
  <para style="p">
    <verse number="18" style="v"/>vastuta ishāki tava vaṁśo vikhyāsyata iti vāg yamadhi kathitā tam advitīyaṁ putraṁ pratijñāprāptaḥ sa utsasarja|</para>
  <para style="p">
    <verse number="19" style="v"/>yata īśvaro mṛtānapyutthāpayituṁ śaknotīti sa mene tasmāt sa upamārūpaṁ taṁ lebhe|</para>
  <para style="p">
    <verse number="20" style="v"/>aparam ishāk viśvāsena yākūb eṣāve ca bhāviviṣayānadhyāśiṣaṁ dadau|</para>
  <para style="p">
    <verse number="21" style="v"/>aparaṁ yākūb maraṇakāle viśvāsena yūṣaphaḥ putrayorekaikasmai janāyāśiṣaṁ dadau yaṣṭyā agrabhāge samālambya praṇanāma ca|</para>
  <para style="p">
    <verse number="22" style="v"/>aparaṁ yūṣaph caramakāle viśvāsenesrāyelvaṁśīyānāṁ misaradeśād bahirgamanasya vācaṁ jagāda nijāsthīni cādhi samādideśa|</para>
  <para style="p">
    <verse number="23" style="v"/>navajāto mūsāśca viśvāsāt trāीn māsān svapitṛbhyām agopyata yatastau svaśiśuṁ paramasundaraṁ dṛṣṭavantau rājājñāñca na śaṅkitavantau|</para>
  <para style="p">
    <verse number="24" style="v"/>aparaṁ vayaḥprāpto mūsā viśvāsāt phirauṇo dauhitra iti nāma nāṅgīcakāra|</para>
  <para style="p">
    <verse number="25" style="v"/>yataḥ sa kṣaṇikāt pāpajasukhabhogād īśvarasya prajābhiḥ sārddhaṁ duḥkhabhogaṁ vavre|</para>
  <para style="p">
    <verse number="26" style="v"/>tathā misaradeśīyanidhibhyaḥ khrīṣṭanimittāṁ nindāṁ mahatīṁ sampattiṁ mene yato hetoḥ sa puraskāradānam apaikṣata|</para>
  <para style="p">
    <verse number="27" style="v"/>aparaṁ sa viśvāsena rājñaḥ krodhāt na bhītvā misaradeśaṁ paritatyāja, yatastenādṛśyaṁ vīkṣamāṇeneva dhairyyam ālambi|</para>
  <para style="p">
    <verse number="28" style="v"/>aparaṁ prathamajātānāṁ hantā yat svīyalokān na spṛśet tadarthaṁ sa viśvāsena nistāraparvvīyabalicchedanaṁ rudhirasecanañcānuṣṭhitāvān|</para>
  <para style="p">
    <verse number="29" style="v"/>aparaṁ te viśvāsāt sthaleneva sūphsāgareṇa jagmuḥ kintu misrīyalokāstat karttum upakramya toyeṣu mamajjuḥ|</para>
  <para style="p">
    <verse number="30" style="v"/>aparañca viśvāsāt taiḥ saptāhaṁ yāvad yirīhoḥ prācīrasya pradakṣiṇe kṛte tat nipapāta|</para>
  <para style="p">
    <verse number="31" style="v"/>viśvāsād rāhabnāmikā veśyāpi prītyā cārān anugṛhyāviśvāsibhiḥ sārddhaṁ na vinanāśa|</para>
  <para style="p">
    <verse number="32" style="v"/>adhikaṁ kiṁ kathayiṣyāmi? gidiyono bārakaḥ śimśono yiptaho dāyūd śimūyelo bhaviṣyadvādinaścaiteṣāṁ vṛttāntakathanāya mama samayābhāvo bhaviṣyati|</para>
  <para style="p">
    <verse number="33" style="v"/>viśvāsāt te rājyāni vaśīkṛtavanto dharmmakarmmāṇi sādhitavantaḥ pratijñānāṁ phalaṁ labdhavantaḥ siṁhānāṁ mukhāni ruddhavanto</para>
  <para style="p">
    <verse number="34" style="v"/>vahnerdāhaṁ nirvvāpitavantaḥ khaṅgadhārād rakṣāṁ prāptavanto daurbbalye sabalīkṛtā yuddhe parākramiṇo jātāḥ pareṣāṁ sainyāni davayitavantaśca|</para>
  <para style="p">
    <verse number="35" style="v"/>yoṣitaḥ punarutthānena mṛtān ātmajān lebhireे, apare ca śreṣṭhotthānasya prāpterāśayā rakṣām agṛhītvā tāḍanena mṛtavantaḥ|</para>
  <para style="p">
    <verse number="36" style="v"/>apare tiraskāraiḥ kaśābhi rbandhanaiḥ kārayā ca parīkṣitāḥ|</para>
  <para style="p">
    <verse number="37" style="v"/>bahavaśca prastarāghātai rhatāḥ karapatrai rvā vidīrṇā yantrai rvā kliṣṭāḥ khaṅgadhārai rvā vyāpāditāḥ| te meṣāṇāṁ chāgānāṁ vā carmmāṇi paridhāya dīnāḥ pīḍitā duḥkhārttāścābhrāmyan|</para>
  <para style="p">
    <verse number="38" style="v"/>saṁsāro yeṣām ayogyaste nirjanasthāneṣu parvvateṣu gahvareṣu pṛthivyāśchidreṣu ca paryyaṭan|</para>
  <para style="p">
    <verse number="39" style="v"/>etaiḥ sarvvai rviśvāsāt pramāṇaṁ prāpi kintu pratijñāyāḥ phalaṁ na prāpi|</para>
  <para style="p">
    <verse number="40" style="v"/>yataste yathāsmān vinā siddhā na bhaveyustathaiveśvareṇāsmākaṁ kṛte śreṣṭhataraṁ kimapi nirdidiśe|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ato hetoretāvatsākṣimeghai rveṣṭitāḥ santo vayamapi sarvvabhāram āśubādhakaṁ pāpañca nikṣipyāsmākaṁ gamanāya nirūpite mārge dhairyyeṇa dhāvāma|</para>
  <para style="p">
    <verse number="2" style="v"/>yaścāsmākaṁ viśvāsasyāgresaraḥ siddhikarttā cāsti taṁ yīśuṁ vīkṣāmahai yataḥ sa svasammukhasthitānandasya prāptyartham apamānaṁ tucchīkṛtya kruśasya yātanāṁ soḍhavān īśvarīyasiṁhāsanasya dakṣiṇapārśve samupaviṣṭavāṁśca|</para>
  <para style="p">
    <verse number="3" style="v"/>yaḥ pāpibhiḥ svaviruddham etādṛśaṁ vaiparītyaṁ soḍhavān tam ālocayata tena yūyaṁ svamanaḥsu śrāntāḥ klāntāśca na bhaviṣyatha|</para>
  <para style="p">
    <verse number="4" style="v"/>yūyaṁ pāpena saha yudhyanto'dyāpi śoṇitavyayaparyyantaṁ pratirodhaṁ nākuruta|</para>
  <para style="p">
    <verse number="5" style="v"/>tathā ca putrān pratīva yuṣmān prati ya upadeśa uktastaṁ kiṁ vismṛtavantaḥ? "pareśena kṛtāṁ śāstiṁ he matputra na tucchaya| tena saṁbhartsitaścāpi naiva klāmya kadācana|</para>
  <para style="p">
    <verse number="6" style="v"/>pareśaḥ prīyate yasmin tasmai śāstiṁ dadāti yat| yantu putraṁ sa gṛhlāti tameva praharatyapi|"</para>
  <para style="p">
    <verse number="7" style="v"/>yadi yūyaṁ śāstiṁ sahadhvaṁ tarhīśvaraḥ putrairiva yuṣmābhiḥ sārddhaṁ vyavaharati yataḥ pitā yasmai śāstiṁ na dadāti tādṛśaḥ putraḥ kaḥ?</para>
  <para style="p">
    <verse number="8" style="v"/>sarvve yasyāḥ śāsteraṁśino bhavanti sā yadi yuṣmākaṁ na bhavati tarhi yūyam ātmajā na kintu jārajā ādhve|</para>
  <para style="p">
    <verse number="9" style="v"/>aparam asmākaṁ śārīrikajanmadātāro'smākaṁ śāstikāriṇo'bhavan te cāsmābhiḥ sammānitāstasmād ya ātmanāṁ janayitā vayaṁ kiṁ tato'dhikaṁ tasya vaśībhūya na jīviṣyāmaḥ?</para>
  <para style="p">
    <verse number="10" style="v"/>te tvalpadināni yāvat svamano'matānusāreṇa śāstiṁ kṛtavantaḥ kintveṣo'smākaṁ hitāya tasya pavitratāyā aṁśitvāya cāsmān śāsti|</para>
  <para style="p">
    <verse number="11" style="v"/>śāstiśca varttamānasamaye kenāpi nānandajanikā kintu śokajanikaiva manyate tathāpi ye tayā vinīyante tebhyaḥ sā paścāt śāntiyuktaṁ dharmmaphalaṁ dadāti|</para>
  <para style="p">
    <verse number="12" style="v"/>ataeva yūyaṁ śithilān hastān durbbalāni jānūni ca sabalāni kurudhvaṁ|</para>
  <para style="p">
    <verse number="13" style="v"/>yathā ca durbbalasya sandhisthānaṁ na bhajyeta svasthaṁ tiṣṭhet tathā svacaraṇārthaṁ saralaṁ mārgaṁ nirmmāta|</para>
  <para style="p">
    <verse number="14" style="v"/>aparañca sarvvaiḥ sārtham eेkyabhāvaṁ yacca vinā parameśvarasya darśanaṁ kenāpi na lapsyate tat pavitratvaṁ ceṣṭadhvaṁ|</para>
  <para style="p">
    <verse number="15" style="v"/>yathā kaścid īśvarasyānugrahāt na patet, yathā ca tiktatāyā mūlaṁ praruhya bādhājanakaṁ na bhavet tena ca bahavo'pavitrā na bhaveyuḥ,</para>
  <para style="p">
    <verse number="16" style="v"/>yathā ca kaścit lampaṭo vā ekakṛtva āhārārthaṁ svīyajyeṣṭhādhikāravikretā ya eṣaustadvad adharmmācārī na bhavet tathā sāvadhānā bhavata|</para>
  <para style="p">
    <verse number="17" style="v"/>yataḥ sa eṣauḥ paścād āśīrvvādādhikārī bhavitum icchannapi nānugṛhīta iti yūyaṁ jānītha, sa cāśrupātena matyantaraṁ prārthayamāno'pi tadupāyaṁ na lebhe|</para>
  <para style="p">
    <verse number="18" style="v"/>aparañca spṛśyaḥ parvvataḥ prajvalito vahniḥ kṛṣṇāvarṇo megho 'ndhakāro jhañbhśa tūrīvādyaṁ vākyānāṁ śabdaśca naiteṣāṁ sannidhau yūyam āgatāḥ|</para>
  <para style="p">
    <verse number="19" style="v"/>taṁ śabdaṁ śrutvā śrotārastādṛśaṁ sambhāṣaṇaṁ yat puna rna jāyate tat prārthitavantaḥ|</para>
  <para style="p">
    <verse number="20" style="v"/>yataḥ paśurapi yadi dharādharaṁ spṛśati tarhi sa pāṣāṇāghātai rhantavya ityādeśaṁ soḍhuṁ te nāśaknuvan|</para>
  <para style="p">
    <verse number="21" style="v"/>tacca darśanam evaṁ bhayānakaṁ yat mūsasoktaṁ bhītastrāsayuktaścāsmīti|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu sīyonparvvato 'mareśvarasya nagaraṁ svargasthayirūśālamam ayutāni divyadūtāḥ</para>
  <para style="p">
    <verse number="23" style="v"/>svarge likhitānāṁ prathamajātānām utsavaḥ samitiśca sarvveṣāṁ vicārādhipatirīśvaraḥ siddhīkṛtadhārmmikānām ātmāno</para>
  <para style="p">
    <verse number="24" style="v"/>nūtananiyamasya madhyastho yīśuḥ, aparaṁ hābilo raktāt śreyaḥ pracārakaṁ prokṣaṇasya raktañcaiteṣāṁ sannidhau yūyam āgatāḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>sāvadhānā bhavata taṁ vaktāraṁ nāvajānīta yato hetoḥ pṛthivīsthitaḥ sa vaktā yairavajñātastai ryadi rakṣā nāprāpi tarhi svargīyavaktuḥ parāṅmukhībhūyāsmābhiḥ kathaṁ rakṣā prāpsyate?</para>
  <para style="p">
    <verse number="26" style="v"/>tadā tasya ravāt pṛthivī kampitā kintvidānīṁ tenedaṁ pratijñātaṁ yathā, "ahaṁ punarekakṛtvaḥ pṛthivīṁ kampayiṣyāmi kevalaṁ tannahi gaganamapi kampayiṣyāmi|"</para>
  <para style="p">
    <verse number="27" style="v"/>sa ekakṛtvaḥ śabdo niścalaviṣayāṇāṁ sthitaye nirmmitānāmiva cañcalavastūnāṁ sthānāntarīkaraṇaṁ prakāśayati|</para>
  <para style="p">
    <verse number="28" style="v"/>ataeva niścalarājyaprāptairasmābhiḥ so'nugraha ālambitavyo yena vayaṁ sādaraṁ sabhayañca tuṣṭijanakarūpeṇeśvaraṁ sevituṁ śaknuyāma|</para>
  <para style="p">
    <verse number="29" style="v"/>yato'smākam īśvaraḥ saṁhārako vahniḥ|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>bhrātṛṣu prema tiṣṭhatu| atithisevā yuṣmābhi rna vismaryyatāṁ</para>
  <para style="p">
    <verse number="2" style="v"/>yatastayā pracchannarūpeṇa divyadūtāḥ keṣāñcid atithayo'bhavan|</para>
  <para style="p">
    <verse number="3" style="v"/>bandinaḥ sahabandibhiriva duḥkhinaśca dehavāsibhiriva yuṣmābhiḥ smaryyantāṁ|</para>
  <para style="p">
    <verse number="4" style="v"/>vivāhaḥ sarvveṣāṁ samīpe sammānitavyastadīyaśayyā ca śuciḥ kintu veśyāgāminaḥ pāradārikāśceśvareṇa daṇḍayiṣyante|</para>
  <para style="p">
    <verse number="5" style="v"/>yūyam ācāre nirlobhā bhavata vidyamānaviṣaye santuṣyata ca yasmād īśvara evedaṁ kathitavān, yathā, "tvāṁ na tyakṣyāmi na tvāṁ hāsyāmi|"</para>
  <para style="p">
    <verse number="6" style="v"/>ataeva vayam utsāhenedaṁ kathayituṁ śaknumaḥ, "matpakṣe parameśo'sti na bheṣyāmi kadācana| yasmāt māṁ prati kiṁ karttuṁ mānavaḥ pārayiṣyati||"</para>
  <para style="p">
    <verse number="7" style="v"/>yuṣmākaṁ ye nāyakā yuṣmabhyam īśvarasya vākyaṁ kathitavantaste yuṣmābhiḥ smaryyantāṁ teṣām ācārasya pariṇāmam ālocya yuṣmābhisteṣāṁ viśvāso'nukriyatāṁ|</para>
  <para style="p">
    <verse number="8" style="v"/>yīśuḥ khrīṣṭaḥ śvo'dya sadā ca sa evāste|</para>
  <para style="p">
    <verse number="9" style="v"/>yūyaṁ nānāvidhanūtanaśikṣābhi rna parivarttadhvaṁ yato'nugraheṇāntaḥkaraṇasya susthirībhavanaṁ kṣemaṁ na ca khādyadravyaiḥ| yatastadācāriṇastai rnopakṛtāḥ|</para>
  <para style="p">
    <verse number="10" style="v"/>ye daṣyasya sevāṁ kurvvanti te yasyā dravyabhojanasyānadhikāriṇastādṛśī yajñavedirasmākam āste|</para>
  <para style="p">
    <verse number="11" style="v"/>yato yeṣāṁ paśūnāṁ śoṇitaṁ pāpanāśāya mahāyājakena mahāpavitrasthānasyābhyantaraṁ nīyate teṣāṁ śarīrāṇi śibirād bahi rdahyante|</para>
  <para style="p">
    <verse number="12" style="v"/>tasmād yīśurapi yat svarudhireṇa prajāḥ pavitrīkuryyāt tadarthaṁ nagaradvārasya bahi rmṛtiṁ bhuktavān|</para>
  <para style="p">
    <verse number="13" style="v"/>ato hetorasmābhirapi tasyāpamānaṁ sahamānaiḥ śibirād bahistasya samīpaṁ gantavyaṁ|</para>
  <para style="p">
    <verse number="14" style="v"/>yato 'trāsmākaṁ sthāyi nagaraṁ na vidyate kintu bhāvi nagaram asmābhiranviṣyate|</para>
  <para style="p">
    <verse number="15" style="v"/>ataeva yīśunāsmābhi rnityaṁ praśaṁsārūpo balirarthatastasya nāmāṅgīkurvvatām oṣṭhādharāṇāṁ phalam īśvarāya dātavyaṁ|</para>
  <para style="p">
    <verse number="16" style="v"/>aparañca paropakāro dānañca yuṣmābhi rna vismaryyatāṁ yatastādṛśaṁ balidānam īśvarāya rocate|</para>
  <para style="p">
    <verse number="17" style="v"/>yūyaṁ svanāyakānām ājñāgrāhiṇo vaśyāśca bhavata yato yairupanidhiḥ pratidātavyastādṛśā lokā iva te yuṣmadīyātmanāṁ rakṣaṇārthaṁ jāgrati, ataste yathā sānandāstat kuryyu rna ca sārttasvarā atra yatadhvaṁ yatasteṣām ārttasvaro yuṣmākam iṣṭajanako na bhavet|</para>
  <para style="p">
    <verse number="18" style="v"/>aparañca yūyam asmannimittiṁ prārthanāṁ kuruta yato vayam uttamamanoviśiṣṭāḥ sarvvatra sadācāraṁ karttum icchukāśca bhavāma iti niścitaṁ jānīmaḥ|</para>
  <para style="p">
    <verse number="19" style="v"/>viśeṣato'haṁ yathā tvarayā yuṣmabhyaṁ puna rdīye tadarthaṁ prārthanāyai yuṣmān adhikaṁ vinaye|</para>
  <para style="p">
    <verse number="20" style="v"/>anantaniyamasya rudhireṇa viśiṣṭo mahān meṣapālako yena mṛtagaṇamadhyāt punarānāyi sa śāntidāyaka īśvaro</para>
  <para style="p">
    <verse number="21" style="v"/>nijābhimatasādhanāya sarvvasmin satkarmmaṇi yuṣmān siddhān karotu, tasya dṛṣṭau ca yadyat tuṣṭijanakaṁ tadeva yuṣmākaṁ madhye yīśunā khrīṣṭena sādhayatu| tasmai mahimā sarvvadā bhūyāt| āmen|</para>
  <para style="p">
    <verse number="22" style="v"/>he bhrātaraḥ, vinaye'haṁ yūyam idam upadeśavākyaṁ sahadhvaṁ yato'haṁ saṁkṣepeṇa yuṣmān prati likhitavān|</para>
  <para style="p">
    <verse number="23" style="v"/>asmākaṁ bhrātā tīmathiyo mukto'bhavad iti jānīta, sa ca yadi tvarayā samāgacchati tarhi tena sārddhaṁm ahaṁ yuṣmān sākṣāt kariṣyāmi|</para>
  <para style="p">
    <verse number="24" style="v"/>yuṣmākaṁ sarvvān nāyakān pavitralokāṁśca namaskuruta| aparam itāliyādeśīyānāṁ namaskāraṁ jñāsyatha|</para>
  <para style="p">
    <verse number="25" style="v"/>anugraho yuṣmākaṁ sarvveṣāṁ sahāyo bhūyāt| āmen|</para>
</usx>
