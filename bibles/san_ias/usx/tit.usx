<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="TIT" style="id">Sanskrit Bible (NT) in IAST Script (satyavedaḥ ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Titus</para>
  <para style="toc1">tītaṁ patraṁ</para>
  <para style="toc2">tītaḥ</para>
  <para style="toc3">tītaḥ</para>
  <para style="mt1">tītaṁ patraṁ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantajīvanasyāśāto jātāyā īśvarabhakte ryogyasya satyamatasya yat tatvajñānaṁ yaśca viśvāsa īśvarasyābhirucitalokai rlabhyate tadarthaṁ</para>
  <para style="p">
    <verse number="2" style="v"/>yīśukhrīṣṭasya prerita īśvarasya dāsaḥ paulo'haṁ sādhāraṇaviśvāsāt mama prakṛtaṁ dharmmaputraṁ tītaṁ prati likhami|</para>
  <para style="p">
    <verse number="3" style="v"/>niṣkapaṭa īśvara ādikālāt pūrvvaṁ tat jīvanaṁ pratijñātavān svanirūpitasamaye ca ghoṣaṇayā tat prakāśitavān|</para>
  <para style="p">
    <verse number="4" style="v"/>mama trāturīśvarasyājñayā ca tasya ghoṣaṇaṁ mayi samarpitam abhūt| asmākaṁ tāta īśvaraḥ paritrātā prabhu ryīśukhrīṣṭaśca tubhyam anugrahaṁ dayāṁ śāntiñca vitaratu|</para>
  <para style="p">
    <verse number="5" style="v"/>tvaṁ yad asampūrṇakāryyāṇi sampūraye rmadīyādeśācca pratinagaraṁ prācīnagaṇān niyojayestadarthamahaṁ tvāṁ krītyupadvīpe sthāpayitvā gatavān|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmād yo naro 'nindita ekasyā yoṣitaḥ svāmī viśvāsinām apacayasyāvādhyatvasya vā doṣeṇāliptānāñca santānānāṁ janako bhavati sa eva yogyaḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>yato hetoradyakṣeṇeśvarasya gṛhādyakṣeṇevānindanīyena bhavitavyaṁ| tena svecchācāriṇā krodhinā pānāsaktena prahārakeṇa lobhinā vā na bhavitavyaṁ</para>
  <para style="p">
    <verse number="8" style="v"/>kintvatithisevakena sallokānurāgiṇā vinītena nyāyyena dhārmmikeṇa jitendriyeṇa ca bhavitavyaṁ,</para>
  <para style="p">
    <verse number="9" style="v"/>upadeśe ca viśvastaṁ vākyaṁ tena dhāritavyaṁ yataḥ sa yad yathārthenopadeśena lokān vinetuṁ vighnakāriṇaśca niruttarān karttuṁ śaknuyāt tad āvaśyakaṁ|</para>
  <para style="p">
    <verse number="10" style="v"/>yataste bahavo 'vādhyā anarthakavākyavādinaḥ pravañcakāśca santi viśeṣataśchinnatvacāṁ madhye kecit tādṛśā lokāḥ santi|</para>
  <para style="p">
    <verse number="11" style="v"/>teṣāñca vāgrodha āvaśyako yataste kutsitalābhasyāśayānucitāni vākyāni śikṣayanto nikhilaparivārāṇāṁ sumatiṁ nāśayanti|</para>
  <para style="p">
    <verse number="12" style="v"/>teṣāṁ svadeśīya eko bhaviṣyadvādī vacanamidamuktavān, yathā, krītīyamānavāḥ sarvve sadā kāpaṭyavādinaḥ| hiṁsrajantusamānāste 'lasāścodarabhārataḥ||</para>
  <para style="p">
    <verse number="13" style="v"/>sākṣyametat tathyaṁ, atoे hetostvaṁ tān gāḍhaṁ bhartsaya te ca yathā viśvāse svasthā bhaveyu</para>
  <para style="p">
    <verse number="14" style="v"/>ryihūdīyopākhyāneṣu satyamatabhraṣṭānāṁ mānavānām ājñāsu ca manāṁsi na niveśayeyustathādiśa|</para>
  <para style="p">
    <verse number="15" style="v"/>śucīnāṁ kṛte sarvvāṇyeva śucīni bhavanti kintu kalaṅkitānām aviśvāsināñca kṛte śuci kimapi na bhavati yatasteṣāṁ buddhayaḥ saṁvedāśca kalaṅkitāḥ santi|</para>
  <para style="p">
    <verse number="16" style="v"/>īśvarasya jñānaṁ te pratijānanti kintu karmmabhistad anaṅgīkurvvate yataste garhitā anājñāgrāhiṇaḥ sarvvasatkarmmaṇaścāyogyāḥ santi|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yathārthasyopadeśasya vākyāni tvayā kathyantāṁ</para>
  <para style="p">
    <verse number="2" style="v"/>viśeṣataḥ prācīnalokā yathā prabuddhā dhīrā vinītā viśvāse premni sahiṣṇutāyāñca svasthā bhaveyustadvat</para>
  <para style="p">
    <verse number="3" style="v"/>prācīnayoṣito'pi yathā dharmmayogyam ācāraṁ kuryyuḥ paranindakā bahumadyapānasya nighnāśca na bhaveyuḥ</para>
  <para style="p">
    <verse number="4" style="v"/>kintu suśikṣākāriṇyaḥ satya īśvarasya vākyaṁ yat na nindyeta tadarthaṁ yuvatīḥ suśīlatām arthataḥ patisneham apatyasnehaṁ</para>
  <para style="p">
    <verse number="5" style="v"/>vinītiṁ śucitvaṁ gṛhiṇītvaṁ saujanyaṁ svāminighnañcādiśeyustathā tvayā kathyatāṁ|</para>
  <para style="p">
    <verse number="6" style="v"/>tadvad yūno'pi vinītaye prabodhaya|</para>
  <para style="p">
    <verse number="7" style="v"/>tvañca sarvvaviṣaye svaṁ satkarmmaṇāṁ dṛṣṭāntaṁ darśaya śikṣāyāñcāvikṛtatvaṁ dhīratāṁ yathārthaṁ</para>
  <para style="p">
    <verse number="8" style="v"/>nirddoṣañca vākyaṁ prakāśaya tena vipakṣo yuṣmākam apavādasya kimapi chidraṁ na prāpya trapiṣyate|</para>
  <para style="p">
    <verse number="9" style="v"/>dāsāśca yat svaprabhūnāṁ nighnāḥ sarvvaviṣaye tuṣṭijanakāśca bhaveyuḥ pratyuttaraṁ na kuryyuḥ</para>
  <para style="p">
    <verse number="10" style="v"/>kimapi nāpahareyuḥ kintu pūrṇāṁ suviśvastatāṁ prakāśayeyuriti tān ādiśa| yata evamprakāreṇāsmakaṁ trāturīśvarasya śikṣā sarvvaviṣaye tai rbhūṣitavyā|</para>
  <para style="p">
    <verse number="11" style="v"/>yato hetostrāṇājanaka īśvarasyānugrahaḥ sarvvān mānavān pratyuditavān</para>
  <para style="p">
    <verse number="12" style="v"/>sa cāsmān idaṁ śikṣyati yad vayam adharmmaṁ sāṁsārikābhilāṣāṁścānaṅgīkṛtya vinītatvena nyāyeneśvarabhaktyā cehaloke āyu ryāpayāmaḥ,</para>
  <para style="p">
    <verse number="13" style="v"/>paramasukhasyāśām arthato 'smākaṁ mahata īśvarasya trāṇakarttu ryīśukhrīṣṭasya prabhāvasyodayaṁ pratīkṣāmahe|</para>
  <para style="p">
    <verse number="14" style="v"/>yataḥ sa yathāsmān sarvvasmād adharmmāt mocayitvā nijādhikārasvarūpaṁ satkarmmasūtsukam ekaṁ prajāvargaṁ pāvayet tadartham asmākaṁ kṛte ātmadānaṁ kṛtavān|</para>
  <para style="p">
    <verse number="15" style="v"/>etāni bhāṣasva pūrṇasāmarthyena cādiśa prabodhaya ca, ko'pi tvāṁ nāvamanyatāṁ|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>te yathā deśādhipānāṁ śāsakānāñca nighnā ājñāgrāhiṇśca sarvvasmai satkarmmaṇe susajjāśca bhaveyuḥ</para>
  <para style="p">
    <verse number="2" style="v"/>kamapi na nindeyu rnivvirodhinaḥ kṣāntāśca bhaveyuḥ sarvvān prati ca pūrṇaṁ mṛdutvaṁ prakāśayeyuśceti tān ādiśa|</para>
  <para style="p">
    <verse number="3" style="v"/>yataḥ pūrvvaṁ vayamapi nirbbodhā anājñāgrāhiṇo bhrāntā nānābhilāṣāṇāṁ sukhānāñca dāseyā duṣṭatverṣyācāriṇo ghṛṇitāḥ parasparaṁ dveṣiṇaścābhavāmaḥ|</para>
  <para style="p">
    <verse number="4" style="v"/>kintvasmākaṁ trāturīśvarasya yā dayā marttyānāṁ prati ca yā prītistasyāḥ prādurbhāve jāte</para>
  <para style="p">
    <verse number="5" style="v"/>vayam ātmakṛtebhyo dharmmakarmmabhyastannahi kintu tasya kṛpātaḥ punarjanmarūpeṇa prakṣālanena pravitrasyātmano nūtanīkaraṇena ca tasmāt paritrāṇāṁ prāptāḥ</para>
  <para style="p">
    <verse number="6" style="v"/>sa cāsmākaṁ trātrā yīśukhrīṣṭenāsmadupari tam ātmānaṁ pracuratvena vṛṣṭavān|</para>
  <para style="p">
    <verse number="7" style="v"/>itthaṁ vayaṁ tasyānugraheṇa sapuṇyībhūya pratyāśayānantajīvanasyādhikāriṇo jātāḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>vākyametad viśvasanīyam ato hetorīśvare ye viśvasitavantaste yathā satkarmmāṇyanutiṣṭheyustathā tān dṛḍham ājñāpayeti mamābhimataṁ|tānyevottamāni mānavebhyaḥ phaladāni ca bhavanti|</para>
  <para style="p">
    <verse number="9" style="v"/>mūḍhebhyaḥ praśnavaṁśāvalivivādebhyo vyavasthāyā vitaṇḍābhyaśca nivarttasva yatastā niṣphalā anarthakāśca bhavanti|</para>
  <para style="p">
    <verse number="10" style="v"/>yo jano bibhitsustam ekavāraṁ dvirvvā prabodhya dūrīkuru,</para>
  <para style="p">
    <verse number="11" style="v"/>yatastādṛśo jano vipathagāmī pāpiṣṭha ātmadoṣakaśca bhavatīti tvayā jñāyatāṁ|</para>
  <para style="p">
    <verse number="12" style="v"/>yadāham ārttimāṁ tukhikaṁ vā tava samīpaṁ preṣayiṣyāmi tadā tvaṁ nīkapalau mama samīpam āgantuṁ yatasva yatastatraivāhaṁ śītakālaṁ yāpayituṁ matim akārṣaṁ|</para>
  <para style="p">
    <verse number="13" style="v"/>vyavasthāpakaḥ sīnā āpalluścaitayoḥ kasyāpyabhāvo yanna bhavet tadarthaṁ tau yatnena tvayā visṛjyetāṁ|</para>
  <para style="p">
    <verse number="14" style="v"/>aparam asmadīyalokā yanniṣphalā na bhaveyustadarthaṁ prayojanīyopakārāyā satkarmmāṇyanuṣṭhātuṁ śikṣantāṁ|</para>
  <para style="p">
    <verse number="15" style="v"/>mama saṅginaḥ savve tvāṁ namaskurvvate| ye viśvāsād asmāsu prīyante tān namaskuru; sarvveṣu yuṣmāsvanugraho bhūyāt| āmen|</para>
</usx>
