<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="JHN" style="id">Sanskrit Bible (NT) in IAST Script (satyavedaḥ ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">John</para>
  <para style="toc1">yohanalikhitaḥ susaṁvādaḥ</para>
  <para style="toc2">yohanaḥ</para>
  <para style="toc3">yohanaḥ</para>
  <para style="mt1">yohanalikhitaḥ susaṁvādaḥ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ādau vāda āsīt sa ca vāda īśvareṇa sārdhamāsīt sa vādaḥ svayamīśvara eva|</para>
  <para style="p">
    <verse number="2" style="v"/>sa ādāvīśvareṇa sahāsīt|</para>
  <para style="p">
    <verse number="3" style="v"/>tena sarvvaṁ vastu sasṛje sarvveṣu sṛṣṭavastuṣu kimapi vastu tenāsṛṣṭaṁ nāsti|</para>
  <para style="p">
    <verse number="4" style="v"/>sa jīvanasyākāraḥ, tacca jīvanaṁ manuṣyāṇāṁ jyotiḥ</para>
  <para style="p">
    <verse number="5" style="v"/>tajjyotirandhakāre pracakāśe kintvandhakārastanna jagrāha|</para>
  <para style="p">
    <verse number="6" style="v"/>yohan nāmaka eko manuja īśvareṇa preṣayāñcakre|</para>
  <para style="p">
    <verse number="7" style="v"/>tadvārā yathā sarvve viśvasanti tadarthaṁ sa tajjyotiṣi pramāṇaṁ dātuṁ sākṣisvarūpo bhūtvāgamat,</para>
  <para style="p">
    <verse number="8" style="v"/>sa svayaṁ tajjyoti rna kintu tajjyotiṣi pramāṇaṁ dātumāgamat|</para>
  <para style="p">
    <verse number="9" style="v"/>jagatyāgatya yaḥ sarvvamanujebhyo dīptiṁ dadāti tadeva satyajyotiḥ|</para>
  <para style="p">
    <verse number="10" style="v"/>sa yajjagadasṛjat tanmadya eva sa āsīt kintu jagato lokāstaṁ nājānan|</para>
  <para style="p">
    <verse number="11" style="v"/>nijādhikāraṁ sa āgacchat kintu prajāstaṁ nāgṛhlan|</para>
  <para style="p">
    <verse number="12" style="v"/>tathāpi ye ye tamagṛhlan arthāt tasya nāmni vyaśvasan tebhya īśvarasya putrā bhavitum adhikāram adadāt|</para>
  <para style="p">
    <verse number="13" style="v"/>teṣāṁ janiḥ śoṇitānna śārīrikābhilāṣānna mānavānāmicchāto na kintvīśvarādabhavat|</para>
  <para style="p">
    <verse number="14" style="v"/>sa vādo manuṣyarūpeṇāvatīryya satyatānugrahābhyāṁ paripūrṇaḥ san sārdham asmābhi rnyavasat tataḥ pituradvitīyaputrasya yogyo yo mahimā taṁ mahimānaṁ tasyāpaśyāma|</para>
  <para style="p">
    <verse number="15" style="v"/>tato yohanapi pracāryya sākṣyamidaṁ dattavān yo mama paścād āgamiṣyati sa matto gurutaraḥ; yato matpūrvvaṁ sa vidyamāna āsīt; yadartham ahaṁ sākṣyamidam adāṁ sa eṣaḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>aparañca tasya pūrṇatāyā vayaṁ sarvve kramaśaḥ kramaśonugrahaṁ prāptāḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>mūsādvārā vyavasthā dattā kintvanugrahaḥ satyatvañca yīśukhrīṣṭadvārā samupātiṣṭhatāṁ|</para>
  <para style="p">
    <verse number="18" style="v"/>kopi manuja īśvaraṁ kadāpi nāpaśyat kintu pituḥ kroḍastho'dvitīyaḥ putrastaṁ prakāśayat|</para>
  <para style="p">
    <verse number="19" style="v"/>tvaṁ kaḥ? iti vākyaṁ preṣṭuṁ yadā yihūdīyalokā yājakān levilokāṁśca yirūśālamo yohanaḥ samīpe preṣayāmāsuḥ,</para>
  <para style="p">
    <verse number="20" style="v"/>tadā sa svīkṛtavān nāpahnūtavān nāham abhiṣikta ityaṅgīkṛtavān|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā te'pṛcchan tarhi ko bhavān? kiṁ eliyaḥ? sovadat na; tataste'pṛcchan tarhi bhavān sa bhaviṣyadvādī? sovadat nāhaṁ saḥ|</para>
  <para style="p">
    <verse number="22" style="v"/>tadā te'pṛcchan tarhi bhavān kaḥ? vayaṁ gatvā prerakān tvayi kiṁ vakṣyāmaḥ? svasmin kiṁ vadasi?</para>
  <para style="p">
    <verse number="23" style="v"/>tadā sovadat| parameśasya panthānaṁ pariṣkuruta sarvvataḥ| itīdaṁ prāntare vākyaṁ vadataḥ kasyacidravaḥ| kathāmimāṁ yasmin yiśayiyo bhaviṣyadvādī likhitavān soham|</para>
  <para style="p">
    <verse number="24" style="v"/>ye preṣitāste phirūśilokāḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā te'pṛcchan yadi nābhiṣiktosi eliyosi na sa bhaviṣyadvādyapi nāsi ca, tarhi lokān majjayasi kutaḥ?</para>
  <para style="p">
    <verse number="26" style="v"/>tato yohan pratyavocat, toye'haṁ majjayāmīti satyaṁ kintu yaṁ yūyaṁ na jānītha tādṛśa eko jano yuṣmākaṁ madhya upatiṣṭhati|</para>
  <para style="p">
    <verse number="27" style="v"/>sa matpaścād āgatopi matpūrvvaṁ varttamāna āsīt tasya pādukābandhanaṁ mocayitumapi nāhaṁ yogyosmi|</para>
  <para style="p">
    <verse number="28" style="v"/>yarddananadyāḥ pārasthabaithabārāyāṁ yasminsthāne yohanamajjayat tasmina sthāne sarvvametad aghaṭata|</para>
  <para style="p">
    <verse number="29" style="v"/>pare'hani yohan svanikaṭamāgacchantaṁ yiśuṁ vilokya prāvocat jagataḥ pāpamocakam īśvarasya meṣaśāvakaṁ paśyata|</para>
  <para style="p">
    <verse number="30" style="v"/>yo mama paścādāgamiṣyati sa matto gurutaraḥ, yato hetormatpūrvvaṁ so'varttata yasminnahaṁ kathāmimāṁ kathitavān sa evāyaṁ|</para>
  <para style="p">
    <verse number="31" style="v"/>aparaṁ nāhamenaṁ pratyabhijñātavān kintu isrāyellokā enaṁ yathā paricinvanti tadabhiprāyeṇāhaṁ jale majjayitumāgaccham|</para>
  <para style="p">
    <verse number="32" style="v"/>punaśca yohanaparamekaṁ pramāṇaṁ datvā kathitavān vihāyasaḥ kapotavad avatarantamātmānam asyoparyyavatiṣṭhantaṁ ca dṛṣṭavānaham|</para>
  <para style="p">
    <verse number="33" style="v"/>nāhamenaṁ pratyabhijñātavān iti satyaṁ kintu yo jale majjayituṁ māṁ prairayat sa evemāṁ kathāmakathayat yasyoparyyātmānam avatarantam avatiṣṭhantañca drakṣayasi saeva pavitre ātmani majjayiṣyati|</para>
  <para style="p">
    <verse number="34" style="v"/>avastannirīkṣyāyam īśvarasya tanaya iti pramāṇaṁ dadāmi|</para>
  <para style="p">
    <verse number="35" style="v"/>pare'hani yohan dvābhyāṁ śiṣyābhyāṁ sārddheṁ tiṣṭhan</para>
  <para style="p">
    <verse number="36" style="v"/>yiśuṁ gacchantaṁ vilokya gaditavān, īśvarasya meṣaśāvakaṁ paśyataṁ|</para>
  <para style="p">
    <verse number="37" style="v"/>imāṁ kathāṁ śrutvā dvau śiṣyau yīśoḥ paścād īyatuḥ|</para>
  <para style="p">
    <verse number="38" style="v"/>tato yīśuḥ parāvṛtya tau paścād āgacchantau dṛṣṭvā pṛṣṭavān yuvāṁ kiṁ gaveśayathaḥ? tāvapṛcchatāṁ he rabbi arthāt he guro bhavān kutra tiṣṭhati?</para>
  <para style="p">
    <verse number="39" style="v"/>tataḥ sovādit etya paśyataṁ| tato divasasya tṛtīyapraharasya gatatvāt tau taddinaṁ tasya saṅge'sthātāṁ|</para>
  <para style="p">
    <verse number="40" style="v"/>yau dvau yohano vākyaṁ śrutvā yiśoḥ paścād āgamatāṁ tayoḥ śimonpitarasya bhrātā āndriyaḥ</para>
  <para style="p">
    <verse number="41" style="v"/>sa itvā prathamaṁ nijasodaraṁ śimonaṁ sākṣātprāpya kathitavān vayaṁ khrīṣṭam arthāt abhiṣiktapuruṣaṁ sākṣātkṛtavantaḥ|</para>
  <para style="p">
    <verse number="42" style="v"/>paścāt sa taṁ yiśoḥ samīpam ānayat| tadā yīśustaṁ dṛṣṭvāvadat tvaṁ yūnasaḥ putraḥ śimon kintu tvannāmadheyaṁ kaiphāḥ vā pitaraḥ arthāt prastaro bhaviṣyati|</para>
  <para style="p">
    <verse number="43" style="v"/>pare'hani yīśau gālīlaṁ gantuṁ niścitacetasi sati philipanāmānaṁ janaṁ sākṣātprāpyāvocat mama paścād āgaccha|</para>
  <para style="p">
    <verse number="44" style="v"/>baitsaidānāmni yasmin grāme pitarāndriyayorvāsa āsīt tasmin grāme tasya philipasya vasatirāsīt|</para>
  <para style="p">
    <verse number="45" style="v"/>paścāt philipo nithanelaṁ sākṣātprāpyāvadat mūsā vyavasthā granthe bhaviṣyadvādināṁ grantheṣu ca yasyākhyānaṁ likhitamāste taṁ yūṣaphaḥ putraṁ nāsaratīyaṁ yīśuṁ sākṣād akārṣma vayaṁ|</para>
  <para style="p">
    <verse number="46" style="v"/>tadā nithanel kathitavān nāsarannagarāta kiṁ kaściduttama utpantuṁ śaknoti? tataḥ philipo 'vocat etya paśya|</para>
  <para style="p">
    <verse number="47" style="v"/>aparañca yīśuḥ svasya samīpaṁ tam āgacchantaṁ dṛṣṭvā vyāhṛtavān, paśyāyaṁ niṣkapaṭaḥ satya isrāyellokaḥ|</para>
  <para style="p">
    <verse number="48" style="v"/>tataḥ sovadad, bhavān māṁ kathaṁ pratyabhijānāti? yīśuravādīt philipasya āhvānāt pūrvvaṁ yadā tvamuḍumbarasya tarormūle'sthāstadā tvāmadarśam|</para>
  <para style="p">
    <verse number="49" style="v"/>nithanel acakathat, he guro bhavān nitāntam īśvarasya putrosi, bhavān isrāyelvaṁśasya rājā|</para>
  <para style="p">
    <verse number="50" style="v"/>tato yīśu rvyāharat, tvāmuḍumbarasya pādapasya mūle dṛṣṭavānāhaṁ mamaitasmādvākyāt kiṁ tvaṁ vyaśvasīḥ? etasmādapyāścaryyāṇi kāryyāṇi drakṣyasi|</para>
  <para style="p">
    <verse number="51" style="v"/>anyaccāvādīd yuṣmānahaṁ yathārthaṁ vadāmi, itaḥ paraṁ mocite meghadvāre tasmānmanujasūnunā īśvarasya dūtagaṇam avarohantamārohantañca drakṣyatha|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ trutīyadivase gālīl pradeśiye kānnānāmni nagare vivāha āsīt tatra ca yīśormātā tiṣṭhat|</para>
  <para style="p">
    <verse number="2" style="v"/>tasmai vivāhāya yīśustasya śiṣyāśca nimantritā āsan|</para>
  <para style="p">
    <verse number="3" style="v"/>tadanantaraṁ drākṣārasasya nyūnatvād yīśormātā tamavadat eteṣāṁ drākṣāraso nāsti|</para>
  <para style="p">
    <verse number="4" style="v"/>tadā sa tāmavocat he nāri mayā saha tava kiṁ kāryyaṁ? mama samaya idānīṁ nopatiṣṭhati|</para>
  <para style="p">
    <verse number="5" style="v"/>tatastasya mātā dāsānavocad ayaṁ yad vadati tadeva kuruta|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmin sthāne yihūdīyānāṁ śucitvakaraṇavyavahārānusāreṇāḍhakaikajaladharāṇi pāṣāṇamayāni ṣaḍvṛhatpātrāṇiāsan|</para>
  <para style="p">
    <verse number="7" style="v"/>tadā yīśustān sarvvakalaśān jalaiḥ pūrayituṁ tānājñāpayat, tataste sarvvān kumbhānākarṇaṁ jalaiḥ paryyapūrayan|</para>
  <para style="p">
    <verse number="8" style="v"/>atha tebhyaḥ kiñciduttāryya bhojyādhipāteḥsamīpaṁ netuṁ sa tānādiśat, te tadanayan|</para>
  <para style="p">
    <verse number="9" style="v"/>aparañca tajjalaṁ kathaṁ drākṣāraso'bhavat tajjalavāhakādāsā jñātuṁ śaktāḥ kintu tadbhojyādhipo jñātuṁ nāśaknot tadavalihya varaṁ saṁmbodyāvadata,</para>
  <para style="p">
    <verse number="10" style="v"/>lokāḥ prathamaṁ uttamadrākṣārasaṁ dadati taṣu yatheṣṭaṁ pitavatsu tasmā kiñcidanuttamañca dadati kintu tvamidānīṁ yāvat uttamadrākṣārasaṁ sthāpayasi|</para>
  <para style="p">
    <verse number="11" style="v"/>itthaṁ yīśurgālīlapradeśe āścaryyakārmma prārambha nijamahimānaṁ prākāśayat tataḥ śiṣyāstasmin vyaśvasan|</para>
  <para style="p">
    <verse number="12" style="v"/>tataḥ param sa nijamātrubhrātrusśiṣyaiḥ sārddhṁ kapharnāhūmam āgamat kintu tatra bahūdināni ātiṣṭhat|</para>
  <para style="p">
    <verse number="13" style="v"/>tadanantaraṁ yihūdiyānāṁ nistārotsave nikaṭamāgate yīśu ryirūśālam nagaram āgacchat|</para>
  <para style="p">
    <verse number="14" style="v"/>tato mandirasya madhye gomeṣapārāvatavikrayiṇo vāṇijakṣcopaviṣṭān vilokya</para>
  <para style="p">
    <verse number="15" style="v"/>rajjubhiḥ kaśāṁ nirmmāya sarvvagomeṣādibhiḥ sārddhaṁ tān mandirād dūrīkṛtavān|</para>
  <para style="p">
    <verse number="16" style="v"/>vaṇijāṁ mudrādi vikīryya āsanāni nyūbjīkṛtya pārāvatavikrayibhyo'kathayad asmāt sthānāt sarvāṇyetāni nayata, mama pitugṛhaṁ vāṇijyagṛhaṁ mā kārṣṭa|</para>
  <para style="p">
    <verse number="17" style="v"/>tasmāt tanmandirārtha udyogo yastu sa grasatīva mām| imāṁ śāstrīyalipiṁ śiṣyāḥsamasmaran|</para>
  <para style="p">
    <verse number="18" style="v"/>tataḥ param yihūdīyalokā yīṣimavadan tavamidṛśakarmmakaraṇāt kiṁ cihnamasmān darśayasi?</para>
  <para style="p">
    <verse number="19" style="v"/>tato yīśustānavocad yuṣmābhire tasmin mandire nāśite dinatrayamadhye'haṁ tad utthāpayiṣyāmi|</para>
  <para style="p">
    <verse number="20" style="v"/>tadā yihūdiyā vyāhārṣuḥ, etasya mandirasa nirmmāṇena ṣaṭcatvāriṁśad vatsarā gatāḥ, tvaṁ kiṁ dinatrayamadhye tad utthāpayiṣyasi?</para>
  <para style="p">
    <verse number="21" style="v"/>kintu sa nijadeharūpamandire kathāmimāṁ kathitavān|</para>
  <para style="p">
    <verse number="22" style="v"/>sa yadetādṛśaṁ gaditavān tacchiṣyāḥ śmaśānāt tadīyotthāne sati smṛtvā dharmmagranthe yīśunoktakathāyāṁ ca vyaśvasiṣuḥ|</para>
  <para style="p">
    <verse number="23" style="v"/>anantaraṁ nistārotsavasya bhojyasamaye yirūśālam nagare tatkrutāścaryyakarmmāṇi vilokya bahubhistasya nāmani viśvasitaṁ|</para>
  <para style="p">
    <verse number="24" style="v"/>kintu sa teṣāṁ kareṣu svaṁ na samarpayat, yataḥ sa sarvvānavait|</para>
  <para style="p">
    <verse number="25" style="v"/>sa mānaveṣu kasyacit pramāṇaṁ nāpekṣata yato manujānāṁ madhye yadyadasti tattat sojānāt|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>nikadimanāmā yihūdīyānām adhipatiḥ phirūśī kṣaṇadāyāṁ</para>
  <para style="p">
    <verse number="2" style="v"/>yīśaurabhyarṇam āvrajya vyāhārṣīt, he guro bhavān īśvarād āgat eka upadeṣṭā, etad asmābhirjñāyate; yato bhavatā yānyāścaryyakarmmāṇi kriyante parameśvarasya sāhāyyaṁ vinā kenāpi tattatkarmmāṇi karttuṁ na śakyante|</para>
  <para style="p">
    <verse number="3" style="v"/>tadā yīśuruttaraṁ dattavān tavāhaṁ yathārthataraṁ vyāharāmi punarjanmani na sati kopi mānava īśvarasya rājyaṁ draṣṭuṁ na śaknoti|</para>
  <para style="p">
    <verse number="4" style="v"/>tato nikadīmaḥ pratyavocat manujo vṛddho bhūtvā kathaṁ janiṣyate? sa kiṁ puna rmātṛrjaṭharaṁ praviśya janituṁ śaknoti?</para>
  <para style="p">
    <verse number="5" style="v"/>yīśuravādīd yathārthataram ahaṁ kathayāmi manuje toyātmabhyāṁ puna rna jāte sa īśvarasya rājyaṁ praveṣṭuṁ na śaknoti|</para>
  <para style="p">
    <verse number="6" style="v"/>māṁsād yat jāyate tan māṁsameva tathātmano yo jāyate sa ātmaiva|</para>
  <para style="p">
    <verse number="7" style="v"/>yuṣmābhiḥ puna rjanitavyaṁ mamaitasyāṁ kathāyām āścaryaṁ mā maṁsthāḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>sadāgatiryāṁ diśamicchati tasyāmeva diśi vāti, tvaṁ tasya svanaṁ śuṇoṣi kintu sa kuta āyāti kutra yāti vā kimapi na jānāsi tadvād ātmanaḥ sakāśāt sarvveṣāṁ manujānāṁ janma bhavati|</para>
  <para style="p">
    <verse number="9" style="v"/>tadā nikadīmaḥ pṛṣṭavān etat kathaṁ bhavituṁ śaknoti?</para>
  <para style="p">
    <verse number="10" style="v"/>yīśuḥ pratyaktavān tvamisrāyelo gururbhūtvāpi kimetāṁ kathāṁ na vetsi?</para>
  <para style="p">
    <verse number="11" style="v"/>tubhyaṁ yathārthaṁ kathayāmi, vayaṁ yad vidmastad vacmaḥ yaṁcca paśyāmastasyaiva sākṣyaṁ dadmaḥ kintu yuṣmābhirasmākaṁ sākṣitvaṁ na gṛhyate|</para>
  <para style="p">
    <verse number="12" style="v"/>etasya saṁsārasya kathāyāṁ kathitāyāṁ yadi yūyaṁ na viśvasitha tarhi svargīyāyāṁ kathāyāṁ kathaṁ viśvasiṣyatha?</para>
  <para style="p">
    <verse number="13" style="v"/>yaḥ svarge'sti yaṁ ca svargād avārohat taṁ mānavatanayaṁ vinā kopi svargaṁ nārohat|</para>
  <para style="p">
    <verse number="14" style="v"/>aparañca mūsā yathā prāntare sarpaṁ protthāpitavān manuṣyaputro'pi tathaivotthāpitavyaḥ;</para>
  <para style="p">
    <verse number="15" style="v"/>tasmād yaḥ kaścit tasmin viśvasiṣyati so'vināśyaḥ san anantāyuḥ prāpsyati|</para>
  <para style="p">
    <verse number="16" style="v"/>īśvara itthaṁ jagadadayata yat svamadvitīyaṁ tanayaṁ prādadāt tato yaḥ kaścit tasmin viśvasiṣyati so'vināśyaḥ san anantāyuḥ prāpsyati|</para>
  <para style="p">
    <verse number="17" style="v"/>īśvaro jagato lokān daṇḍayituṁ svaputraṁ na preṣya tān paritrātuṁ preṣitavān|</para>
  <para style="p">
    <verse number="18" style="v"/>ataeva yaḥ kaścit tasmin viśvasiti sa daṇḍārho na bhavati kintu yaḥ kaścit tasmin na viśvasiti sa idānīmeva daṇḍārho bhavati,yataḥ sa īśvarasyādvitīyaputrasya nāmani pratyayaṁ na karoti|</para>
  <para style="p">
    <verse number="19" style="v"/>jagato madhye jyotiḥ prākāśata kintu manuṣyāṇāṁ karmmaṇāṁ dṛṣṭatvāt te jyotiṣopi timire prīyante etadeva daṇḍasya kāraṇāṁ bhavati|</para>
  <para style="p">
    <verse number="20" style="v"/>yaḥ kukarmma karoti tasyācārasya dṛṣṭatvāt sa jyotirṝtīyitvā tannikaṭaṁ nāyāti;</para>
  <para style="p">
    <verse number="21" style="v"/>kintu yaḥ satkarmma karoti tasya sarvvāṇi karmmāṇīśvareṇa kṛtānīti sathā prakāśate tadabhiprāyeṇa sa jyotiṣaḥ sannidhim āyāti|</para>
  <para style="p">
    <verse number="22" style="v"/>tataḥ param yīśuḥ śiṣyaiḥ sārddhaṁ yihūdīyadeśaṁ gatvā tatra sthitvā majjayitum ārabhata|</para>
  <para style="p">
    <verse number="23" style="v"/>tadā śālam nagarasya samīpasthāyini ainan grāme bahutaratoyasthitestatra yohan amajjayat tathā ca lokā āgatya tena majjitā abhavan|</para>
  <para style="p">
    <verse number="24" style="v"/>tadā yohan kārāyāṁ na baddhaḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>aparañca śācakarmmaṇi yohānaḥ śiṣyaiḥ saha yihūdīyalokānāṁ vivāde jāte, te yohanaḥ saṁnnidhiṁ gatvākathayan,</para>
  <para style="p">
    <verse number="26" style="v"/>he guro yarddananadyāḥ pāre bhavatā sārddhaṁ ya āsīt yasmiṁśca bhavān sākṣyaṁ pradadāt paśyatu sopi majjayati sarvve tasya samīpaṁ yānti ca|</para>
  <para style="p">
    <verse number="27" style="v"/>tadā yohan pratyavocad īśvareṇa na datte kopi manujaḥ kimapi prāptuṁ na śaknoti|</para>
  <para style="p">
    <verse number="28" style="v"/>ahaṁ abhiṣikto na bhavāmi kintu tadagre preṣitosmi yāmimāṁ kathāṁ kathitavānāhaṁ tatra yūyaṁ sarvve sākṣiṇaḥ stha|</para>
  <para style="p">
    <verse number="29" style="v"/>yo janaḥ kanyāṁ labhate sa eva varaḥ kintu varasya sannidhau daṇḍāyamānaṁ tasya yanmitraṁ tena varasya śabde śrute'tīvāhlādyate mamāpi tadvad ānandasiddhirjātā|</para>
  <para style="p">
    <verse number="30" style="v"/>tena kramaśo varddhitavyaṁ kintu mayā hsitavyaṁ|</para>
  <para style="p">
    <verse number="31" style="v"/>ya ūrdhvādāgacchat sa sarvveṣāṁ mukhyo yaśca saṁsārād udapadyata sa sāṁsārikaḥ saṁsārīyāṁ kathāñca kathayati yastu svargādāgacchat sa sarvveṣāṁ mukhyaḥ|</para>
  <para style="p">
    <verse number="32" style="v"/>sa yadapaśyadaśṛṇocca tasminneva sākṣyaṁ dadāti tathāpi prāyaśaḥ kaścit tasya sākṣyaṁ na gṛhlāti;</para>
  <para style="p">
    <verse number="33" style="v"/>kintu yo gṛhlāti sa īśvarasya satyavāditvaṁ mudrāṅgitaṁ karoti|</para>
  <para style="p">
    <verse number="34" style="v"/>īśvareṇa yaḥ preritaḥ saeva īśvarīyakathāṁ kathayati yata īśvara ātmānaṁ tasmai aparimitam adadāt|</para>
  <para style="p">
    <verse number="35" style="v"/>pitā putre snehaṁ kṛtvā tasya haste sarvvāṇi samarpitavān|</para>
  <para style="p">
    <verse number="36" style="v"/>yaḥ kaścit putre viśvasiti sa evānantam paramāyuḥ prāpnoti kintu yaḥ kaścit putre na viśvasiti sa paramāyuṣo darśanaṁ na prāpnoti kintvīśvarasya kopabhājanaṁ bhūtvā tiṣṭhati|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yīśuḥ svayaṁ nāmajjayat kevalaṁ tasya śiṣyā amajjayat kintu yohano'dhikaśiṣyān sa karoti majjayati ca,</para>
  <para style="p">
    <verse number="2" style="v"/>phirūśina imāṁ vārttāmaśṛṇvan iti prabhuravagatya</para>
  <para style="p">
    <verse number="3" style="v"/>yihūdīyadeśaṁ vihāya puna rgālīlam āgat|</para>
  <para style="p">
    <verse number="4" style="v"/>tataḥ śomiroṇapradeśasya madyena tena gantavye sati</para>
  <para style="p">
    <verse number="5" style="v"/>yākūb nijaputrāya yūṣaphe yāṁ bhūmim adadāt tatsamīpasthāyi śomiroṇapradeśasya sukhār nāmnā vikhyātasya nagarasya sannidhāvupāsthāt|</para>
  <para style="p">
    <verse number="6" style="v"/>tatra yākūbaḥ prahirāsīt; tadā dvitīyayāmavelāyāṁ jātāyāṁ sa mārge śramāpannastasya praheḥ pārśve upāviśat|</para>
  <para style="p">
    <verse number="7" style="v"/>etarhi kācit śomiroṇīyā yoṣit toyottolanārtham tatrāgamat</para>
  <para style="p">
    <verse number="8" style="v"/>tadā śiṣyāḥ khādyadravyāṇi kretuṁ nagaram agacchan|</para>
  <para style="p">
    <verse number="9" style="v"/>yīśuḥ śomiroṇīyāṁ tāṁ yoṣitam vyāhārṣīt mahyaṁ kiñcit pānīyaṁ pātuṁ dehi| kintu śomiroṇīyaiḥ sākaṁ yihūdīyalokā na vyavāharan tasmāddhetoḥ sākathayat śomiroṇīyā yoṣitadahaṁ tvaṁ yihūdīyosi kathaṁ mattaḥ pānīyaṁ pātum icchasi?</para>
  <para style="p">
    <verse number="10" style="v"/>tato yīśuravadad īśvarasya yaddānaṁ tatkīdṛk pānīyaṁ pātuṁ mahyaṁ dehi ya itthaṁ tvāṁ yācate sa vā ka iti cedajñāsyathāstarhi tamayāciṣyathāḥ sa ca tubhyamamṛtaṁ toyamadāsyat|</para>
  <para style="p">
    <verse number="11" style="v"/>tadā sā sīmantinī bhāṣitavati, he maheccha prahirgambhīro bhavato nīrottolanapātraṁ nāstī ca tasmāt tadamṛtaṁ kīlālaṁ kutaḥ prāpsyasi?</para>
  <para style="p">
    <verse number="12" style="v"/>yosmabhyam imamandhūṁ dadau, yasya ca parijanā gomeṣādayaśca sarvve'sya praheḥ pānīyaṁ papuretādṛśo yosmākaṁ pūrvvapuruṣo yākūb tasmādapi bhavān mahān kiṁ?</para>
  <para style="p">
    <verse number="13" style="v"/>tato yīśurakathayad idaṁ pānīyaṁ saḥ pivati sa punastṛṣārtto bhaviṣyati,</para>
  <para style="p">
    <verse number="14" style="v"/>kintu mayā dattaṁ pānīyaṁ yaḥ pivati sa punaḥ kadāpi tṛṣārtto na bhaviṣyati| mayā dattam idaṁ toyaṁ tasyāntaḥ prasravaṇarūpaṁ bhūtvā anantāyuryāvat sroṣyati|</para>
  <para style="p">
    <verse number="15" style="v"/>tadā sā vanitākathayat he maheccha tarhi mama punaḥ pīpāsā yathā na jāyate toyottolanāya yathātrāgamanaṁ na bhavati ca tadarthaṁ mahyaṁ tattoyaṁ dehī|</para>
  <para style="p">
    <verse number="16" style="v"/>tato yīśūravadadyāhi tava patimāhūya sthāne'trāgaccha|</para>
  <para style="p">
    <verse number="17" style="v"/>sā vāmāvadat mama patirnāsti| yīśuravadat mama patirnāstīti vākyaṁ bhadramavocaḥ|</para>
  <para style="p">
    <verse number="18" style="v"/>yatastava pañca patayobhavan adhunā tu tvayā sārddhaṁ yastiṣṭhati sa tava bharttā na vākyamidaṁ satyamavādiḥ|</para>
  <para style="p">
    <verse number="19" style="v"/>tadā sā mahilā gaditavati he maheccha bhavān eko bhaviṣyadvādīti buddhaṁ mayā|</para>
  <para style="p">
    <verse number="20" style="v"/>asmākaṁ pitṛlokā etasmin śiloccaye'bhajanta, kintu bhavadbhirucyate yirūśālam nagare bhajanayogyaṁ sthānamāste|</para>
  <para style="p">
    <verse number="21" style="v"/>yīśuravocat he yoṣit mama vākye viśvasihi yadā yūyaṁ kevalaśaile'smin vā yirūśālam nagare piturbhajanaṁ na kariṣyadhve kāla etādṛśa āyāti|</para>
  <para style="p">
    <verse number="22" style="v"/>yūyaṁ yaṁ bhajadhve taṁ na jānītha, kintu vayaṁ yaṁ bhajāmahe taṁ jānīmahe, yato yihūdīyalokānāṁ madhyāt paritrāṇaṁ jāyate|</para>
  <para style="p">
    <verse number="23" style="v"/>kintu yadā satyabhaktā ātmanā satyarūpeṇa ca piturbhajanaṁ kariṣyante samaya etādṛśa āyāti, varam idānīmapi vidyate ; yata etādṛśo bhatkān pitā ceṣṭate|</para>
  <para style="p">
    <verse number="24" style="v"/>īśvara ātmā; tatastasya ye bhaktāstaiḥ sa ātmanā satyarūpeṇa ca bhajanīyaḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā sā mahilāvādīt khrīṣṭanāmnā vikhyāto'bhiṣiktaḥ puruṣa āgamiṣyatīti jānāmi sa ca sarvvāḥ kathā asmān jñāpayiṣyati|</para>
  <para style="p">
    <verse number="26" style="v"/>tato yīśuravadat tvayā sārddhaṁ kathanaṁ karomi yo'ham ahameva sa puruṣaḥ|</para>
  <para style="p">
    <verse number="27" style="v"/>etasmin samaye śiṣyā āgatya tathā striyā sārddhaṁ tasya kathopakathane mahāścaryyam amanyanta tathāpi bhavān kimicchati? yadvā kimartham etayā sārddhaṁ kathāṁ kathayati? iti kopi nāpṛcchat|</para>
  <para style="p">
    <verse number="28" style="v"/>tataḥ paraṁ sā nārī kalaśaṁ sthāpayitvā nagaramadhyaṁ gatvā lokebhyokathāyad</para>
  <para style="p">
    <verse number="29" style="v"/>ahaṁ yadyat karmmākaravaṁ tatsarvvaṁ mahyamakathayad etādṛśaṁ mānavamekam āgatya paśyata ru kim abhiṣikto na bhavati ?</para>
  <para style="p">
    <verse number="30" style="v"/>tataste nagarād bahirāgatya tātasya samīpam āyan|</para>
  <para style="p">
    <verse number="31" style="v"/>etarhi śiṣyāḥ sādhayitvā taṁ vyāhārṣuḥ he guro bhavān kiñcid bhūktāṁ|</para>
  <para style="p">
    <verse number="32" style="v"/>tataḥ sovadad yuṣmābhiryanna jñāyate tādṛśaṁ bhakṣyaṁ mamāste|</para>
  <para style="p">
    <verse number="33" style="v"/>tadā śiṣyāḥ parasparaṁ praṣṭum ārambhanta, kimasmai kopi kimapi bhakṣyamānīya dattavān?</para>
  <para style="p">
    <verse number="34" style="v"/>yīśuravocat matprerakasyābhimatānurūpakaraṇaṁ tasyaiva karmmasiddhikāraṇañca mama bhakṣyaṁ|</para>
  <para style="p">
    <verse number="35" style="v"/>māsacatuṣṭaye jāte śasyakarttanasamayo bhaviṣyatīti vākyaṁ yuṣmābhiḥ kiṁ nodyate? kintvahaṁ vadāmi, śira uttolya kṣetrāṇi prati nirīkṣya paśyata, idānīṁ karttanayogyāni śuklavarṇānyabhavan|</para>
  <para style="p">
    <verse number="36" style="v"/>yaśchinatti sa vetanaṁ labhate anantāyuḥsvarūpaṁ śasyaṁ sa gṛhlāti ca, tenaiva vaptā chettā ca yugapad ānandataḥ|</para>
  <para style="p">
    <verse number="37" style="v"/>itthaṁ sati vapatyekaśchinatyanya iti vacanaṁ siddhyati|</para>
  <para style="p">
    <verse number="38" style="v"/>yatra yūyaṁ na paryyaśrāmyata tādṛśaṁ śasyaṁ chettuṁ yuṣmān prairayam anye janāḥparyyaśrāmyan yūyaṁ teṣāṁ śragasya phalam alabhadhvam|</para>
  <para style="p">
    <verse number="39" style="v"/>yasmin kāle yadyat karmmākārṣaṁ tatsarvvaṁ sa mahyam akathayat tasyā vanitāyā idaṁ sākṣyavākyaṁ śrutvā tannagaranivāsino bahavaḥ śomiroṇīyalokā vyaśvasan|</para>
  <para style="p">
    <verse number="40" style="v"/>tathā ca tasyāntike samupasthāya sveṣāṁ sannidhau katicid dināni sthātuṁ tasmin vinayam akurvvāna tasmāt sa dinadvayaṁ tatsthāne nyavaṣṭat</para>
  <para style="p">
    <verse number="41" style="v"/>tatastasyopadeśena bahavo'pare viśvasya</para>
  <para style="p">
    <verse number="42" style="v"/>tāṁ yoṣāmavadan kevalaṁ tava vākyena pratīma iti na, kintu sa jagato'bhiṣiktastrāteti tasya kathāṁ śrutvā vayaṁ svayamevājñāsamahi|</para>
  <para style="p">
    <verse number="43" style="v"/>svadeśe bhaviṣyadvaktuḥ satkāro nāstīti yadyapi yīśuḥ pramāṇaṁ datvākathayat</para>
  <para style="p">
    <verse number="44" style="v"/>tathāpi divasadvayāt paraṁ sa tasmāt sthānād gālīlaṁ gatavān|</para>
  <para style="p">
    <verse number="45" style="v"/>anantaraṁ ye gālīlī liyalokā utsave gatā utsavasamaye yirūśalam nagare tasya sarvvāḥ kriyā apaśyan te gālīlam āgataṁ tam āgṛhlan|</para>
  <para style="p">
    <verse number="46" style="v"/>tataḥ param yīśu ryasmin kānnānagare jalaṁ drākṣārasam ākarot tat sthānaṁ punaragāt| tasminneva samaye kasyacid rājasabhāstārasya putraḥ kapharnāhūmapurī rogagrasta āsīt|</para>
  <para style="p">
    <verse number="47" style="v"/>sa yehūdīyadeśād yīśo rgālīlāgamanavārttāṁ niśamya tasya samīpaṁ gatvā prārthya vyāhṛtavān mama putrasya prāyeṇa kāla āsannaḥ bhavān āgatya taṁ svasthaṁ karotu|</para>
  <para style="p">
    <verse number="48" style="v"/>tadā yīśurakathayad āścaryyaṁ karmma citraṁ cihnaṁ ca na dṛṣṭā yūyaṁ na pratyeṣyatha|</para>
  <para style="p">
    <verse number="49" style="v"/>tataḥ sa sabhāsadavadat he maheccha mama putre na mṛte bhavānāgacchatu|</para>
  <para style="p">
    <verse number="50" style="v"/>yīśustamavadad gaccha tava putro'jīvīt tadā yīśunoktavākye sa viśvasya gatavān|</para>
  <para style="p">
    <verse number="51" style="v"/>gamanakāle mārgamadhye dāsāstaṁ sākṣātprāpyāvadan bhavataḥ putro'jīvīt|</para>
  <para style="p">
    <verse number="52" style="v"/>tataḥ kaṁ kālamārabhya rogapratīkārārambho jātā iti pṛṣṭe tairuktaṁ hyaḥ sārddhadaṇḍadvayādhikadvitīyayāme tasya jvaratyāgo'bhavat|</para>
  <para style="p">
    <verse number="53" style="v"/>tadā yīśustasmin kṣaṇe proktavān tava putro'jīvīt pitā tadbuddhvā saparivāro vyaśvasīt|</para>
  <para style="p">
    <verse number="54" style="v"/>yihūdīyadeśād āgatya gālīli yīśuretad dvitīyam āścaryyakarmmākarot|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ paraṁ yihūdīyānām utsava upasthite yīśu ryirūśālamaṁ gatavān|</para>
  <para style="p">
    <verse number="2" style="v"/>tasminnagare meṣanāmno dvārasya samīpe ibrīyabhāṣayā baithesdā nāmnā piṣkariṇī pañcaghaṭṭayuktāsīt|</para>
  <para style="p">
    <verse number="3" style="v"/>tasyāsteṣu ghaṭṭeṣu kilālakampanam apekṣya andhakhañcaśuṣkāṅgādayo bahavo rogiṇaḥ patantastiṣṭhanti sma|</para>
  <para style="p">
    <verse number="4" style="v"/>yato viśeṣakāle tasya saraso vāri svargīyadūta etyākampayat tatkīlālakampanāt paraṁ yaḥ kaścid rogī prathamaṁ pānīyamavārohat sa eva tatkṣaṇād rogamukto'bhavat|</para>
  <para style="p">
    <verse number="5" style="v"/>tadāṣṭātriṁśadvarṣāṇi yāvad rogagrasta ekajanastasmin sthāne sthitavān|</para>
  <para style="p">
    <verse number="6" style="v"/>yīśustaṁ śayitaṁ dṛṣṭvā bahukālikarogīti jñātvā vyāhṛtavān tvaṁ kiṁ svastho bubhūṣasi?</para>
  <para style="p">
    <verse number="7" style="v"/>tato rogī kathitavān he maheccha yadā kīlālaṁ kampate tadā māṁ puṣkariṇīm avarohayituṁ mama kopi nāsti, tasmān mama gamanakāle kaścidanyo'gro gatvā avarohati|</para>
  <para style="p">
    <verse number="8" style="v"/>tadā yīśurakathayad uttiṣṭha, tava śayyāmuttolya gṛhītvā yāhi|</para>
  <para style="p">
    <verse number="9" style="v"/>sa tatkṣaṇāt svastho bhūtvā śayyāmuttolyādāya gatavān kintu taddinaṁ viśrāmavāraḥ|</para>
  <para style="p">
    <verse number="10" style="v"/>tasmād yihūdīyāḥ svasthaṁ naraṁ vyāharan adya viśrāmavāre śayanīyamādāya na yātavyam|</para>
  <para style="p">
    <verse number="11" style="v"/>tataḥ sa pratyavocad yo māṁ svastham akārṣīt śayanīyam uttolyādāya yātuṁ māṁ sa evādiśat|</para>
  <para style="p">
    <verse number="12" style="v"/>tadā te'pṛcchan śayanīyam uttolyādāya yātuṁ ya ājñāpayat sa kaḥ?</para>
  <para style="p">
    <verse number="13" style="v"/>kintu sa ka iti svasthībhūto nājānād yatastasmin sthāne janatāsattvād yīśuḥ sthānāntaram āgamat|</para>
  <para style="p">
    <verse number="14" style="v"/>tataḥ paraṁ yeśu rmandire taṁ naraṁ sākṣātprāpyākathayat paśyedānīm anāmayo jātosi yathādhikā durdaśā na ghaṭate taddhetoḥ pāpaṁ karmma punarmākārṣīḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>tataḥ sa gatvā yihūdīyān avadad yīśu rmām arogiṇam akārṣīt|</para>
  <para style="p">
    <verse number="16" style="v"/>tato yīśu rviśrāmavāre karmmedṛśaṁ kṛtavān iti heto ryihūdīyāstaṁ tāḍayitvā hantum aceṣṭanta|</para>
  <para style="p">
    <verse number="17" style="v"/>yīśustānākhyat mama pitā yat kāryyaṁ karoti tadanurūpam ahamapi karoti|</para>
  <para style="p">
    <verse number="18" style="v"/>tato yihūdīyāstaṁ hantuṁ punarayatanta yato viśrāmavāraṁ nāmanyata tadeva kevalaṁ na adhikantu īśvaraṁ svapitaraṁ procya svamapīśvaratulyaṁ kṛtavān|</para>
  <para style="p">
    <verse number="19" style="v"/>paścād yīśuravadad yuṣmānahaṁ yathārthataraṁ vadāmi putraḥ pitaraṁ yadyat karmma kurvvantaṁ paśyati tadatiriktaṁ svecchātaḥ kimapi karmma karttuṁ na śaknoti| pitā yat karoti putropi tadeva karoti|</para>
  <para style="p">
    <verse number="20" style="v"/>pitā putre snehaṁ karoti tasmāt svayaṁ yadyat karmma karoti tatsarvvaṁ putraṁ darśayati ; yathā ca yuṣmākaṁ āścaryyajñānaṁ janiṣyate tadartham itopi mahākarmma taṁ darśayiṣyati|</para>
  <para style="p">
    <verse number="21" style="v"/>vastutastu pitā yathā pramitān utthāpya sajivān karoti tadvat putropi yaṁ yaṁ icchati taṁ taṁ sajīvaṁ karoti|</para>
  <para style="p">
    <verse number="22" style="v"/>sarvve pitaraṁ yathā satkurvvanti tathā putramapi satkārayituṁ pitā svayaṁ kasyāpi vicāramakṛtvā sarvvavicārāṇāṁ bhāraṁ putre samarpitavān|</para>
  <para style="p">
    <verse number="23" style="v"/>yaḥ putraṁ sat karoti sa tasya prerakamapi sat karoti|</para>
  <para style="p">
    <verse number="24" style="v"/>yuṣmānāhaṁ yathārthataraṁ vadāmi yo jano mama vākyaṁ śrutvā matprerake viśvasiti sonantāyuḥ prāpnoti kadāpi daṇḍabājanaṁ na bhavati nidhanādutthāya paramāyuḥ prāpnoti|</para>
  <para style="p">
    <verse number="25" style="v"/>ahaṁ yuṣmānatiyathārthaṁ vadāmi yadā mṛtā īśvaraputrasya ninādaṁ śroṣyanti ye ca śroṣyanti te sajīvā bhaviṣyanti samaya etādṛśa āyāti varam idānīmapyupatiṣṭhati|</para>
  <para style="p">
    <verse number="26" style="v"/>pitā yathā svayañjīvī tathā putrāya svayañjīvitvādhikāraṁ dattavān|</para>
  <para style="p">
    <verse number="27" style="v"/>sa manuṣyaputraḥ etasmāt kāraṇāt pitā daṇḍakaraṇādhikāramapi tasmin samarpitavān|</para>
  <para style="p">
    <verse number="28" style="v"/>etadarthe yūyam āścaryyaṁ na manyadhvaṁ yato yasmin samaye tasya ninādaṁ śrutvā śmaśānasthāḥ sarvve bahirāgamiṣyanti samaya etādṛśa upasthāsyati|</para>
  <para style="p">
    <verse number="29" style="v"/>tasmād ye satkarmmāṇi kṛtavantasta utthāya āyuḥ prāpsyanti ye ca kukarmāṇi kṛtavantasta utthāya daṇḍaṁ prāpsyanti|</para>
  <para style="p">
    <verse number="30" style="v"/>ahaṁ svayaṁ kimapi karttuṁ na śaknomi yathā śuṇomi tathā vicārayāmi mama vicārañca nyāyyaḥ yatohaṁ svīyābhīṣṭaṁ nehitvā matprerayituḥ pituriṣṭam īhe|</para>
  <para style="p">
    <verse number="31" style="v"/>yadi svasmin svayaṁ sākṣyaṁ dadāmi tarhi tatsākṣyam āgrāhyaṁ bhavati ;</para>
  <para style="p">
    <verse number="32" style="v"/>kintu madarthe'paro janaḥ sākṣyaṁ dadāti madarthe tasya yat sākṣyaṁ tat satyam etadapyahaṁ jānāmi|</para>
  <para style="p">
    <verse number="33" style="v"/>yuṣmābhi ryohanaṁ prati lokeṣu preriteṣu sa satyakathāyāṁ sākṣyamadadāt|</para>
  <para style="p">
    <verse number="34" style="v"/>mānuṣādahaṁ sākṣyaṁ nopekṣe tathāpi yūyaṁ yathā paritrayadhve tadartham idaṁ vākyaṁ vadāmi|</para>
  <para style="p">
    <verse number="35" style="v"/>yohan dedīpyamāno dīpa iva tejasvī sthitavān yūyam alpakālaṁ tasya dīptyānandituṁ samamanyadhvaṁ|</para>
  <para style="p">
    <verse number="36" style="v"/>kintu tatpramāṇādapi mama gurutaraṁ pramāṇaṁ vidyate pitā māṁ preṣya yadyat karmma samāpayituṁ śakttimadadāt mayā kṛtaṁ tattat karmma madarthe pramāṇaṁ dadāti|</para>
  <para style="p">
    <verse number="37" style="v"/>yaḥ pitā māṁ preritavān mopi madarthe pramāṇaṁ dadāti| tasya vākyaṁ yuṣmābhiḥ kadāpi na śrutaṁ tasya rūpañca na dṛṣṭaṁ</para>
  <para style="p">
    <verse number="38" style="v"/>tasya vākyañca yuṣmākam antaḥ kadāpi sthānaṁ nāpnoti yataḥ sa yaṁ preṣitavān yūyaṁ tasmin na viśvasitha|</para>
  <para style="p">
    <verse number="39" style="v"/>dharmmapustakāni yūyam ālocayadhvaṁ tai rvākyairanantāyuḥ prāpsyāma iti yūyaṁ budhyadhve taddharmmapustakāni madarthe pramāṇaṁ dadati|</para>
  <para style="p">
    <verse number="40" style="v"/>tathāpi yūyaṁ paramāyuḥprāptaye mama saṁnidhim na jigamiṣatha|</para>
  <para style="p">
    <verse number="41" style="v"/>ahaṁ mānuṣebhyaḥ satkāraṁ na gṛhlāmi|</para>
  <para style="p">
    <verse number="42" style="v"/>ahaṁ yuṣmān jānāmi; yuṣmākamantara īśvaraprema nāsti|</para>
  <para style="p">
    <verse number="43" style="v"/>ahaṁ nijapitu rnāmnāgatosmi tathāpi māṁ na gṛhlītha kintu kaścid yadi svanāmnā samāgamiṣyati tarhi taṁ grahīṣyatha|</para>
  <para style="p">
    <verse number="44" style="v"/>yūyam īśvarāt satkāraṁ na ciṣṭatvā kevalaṁ parasparaṁ satkāram ced ādadhvve tarhi kathaṁ viśvasituṁ śaknutha?</para>
  <para style="p">
    <verse number="45" style="v"/>putuḥ samīpe'haṁ yuṣmān apavadiṣyāmīti mā cintayata yasmin , yasmin yuṣmākaṁ viśvasaḥ saeva mūsā yuṣmān apavadati|</para>
  <para style="p">
    <verse number="46" style="v"/>yadi yūyaṁ tasmin vyaśvasiṣyata tarhi mayyapi vyaśvasiṣyata, yat sa mayi likhitavān|</para>
  <para style="p">
    <verse number="47" style="v"/>tato yadi tena likhitavāni na pratitha tarhi mama vākyāni kathaṁ pratyeṣyatha?</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ paraṁ yīśu rgālīl pradeśīyasya tiviriyānāmnaḥ sindhoḥ pāraṁ gatavān|</para>
  <para style="p">
    <verse number="2" style="v"/>tato vyādhimallokasvāsthyakaraṇarūpāṇi tasyāścaryyāṇi karmmāṇi dṛṣṭvā bahavo janāstatpaścād agacchan|</para>
  <para style="p">
    <verse number="3" style="v"/>tato yīśuḥ parvvatamāruhya tatra śiṣyaiḥ sākam|</para>
  <para style="p">
    <verse number="4" style="v"/>tasmin samaya nistārotsavanāmni yihūdīyānāma utsava upasthite</para>
  <para style="p">
    <verse number="5" style="v"/>yīśu rnetre uttolya bahulokān svasamīpāgatān vilokya philipaṁ pṛṣṭavān eteṣāṁ bhojanāya bhojadravyāṇi vayaṁ kutra kretuṁ śakrumaḥ?</para>
  <para style="p">
    <verse number="6" style="v"/>vākyamidaṁ tasya parīkṣārtham avādīt kintu yat kariṣyati tat svayam ajānāt|</para>
  <para style="p">
    <verse number="7" style="v"/>philipaḥ pratyavocat eteṣām ekaiko yadyalpam alpaṁ prāpnoti tarhi mudrāpādadviśatena krītapūpā api nyūnā bhaviṣyanti|</para>
  <para style="p">
    <verse number="8" style="v"/>śimon pitarasya bhrātā āndriyākhyaḥ śiṣyāṇāmeko vyāhṛtavān</para>
  <para style="p">
    <verse number="9" style="v"/>atra kasyacid bālakasya samīpe pañca yāvapūpāḥ kṣudramatsyadvayañca santi kintu lokānāṁ etāvātāṁ madhye taiḥ kiṁ bhaviṣyati?</para>
  <para style="p">
    <verse number="10" style="v"/>paścād yīśuravadat lokānupaveśayata tatra bahuyavasasattvāt pañcasahastrebhyo nyūnā adhikā vā puruṣā bhūmyām upāviśan|</para>
  <para style="p">
    <verse number="11" style="v"/>tato yīśustān pūpānādāya īśvarasya guṇān kīrttayitvā śiṣyeṣu samārpayat tataste tebhya upaviṣṭalokebhyaḥ pūpān yatheṣṭamatsyañca prāduḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>teṣu tṛpteṣu sa tānavocad eteṣāṁ kiñcidapi yathā nāpacīyate tathā sarvvāṇyavaśiṣṭāni saṁgṛhlīta|</para>
  <para style="p">
    <verse number="13" style="v"/>tataḥ sarvveṣāṁ bhojanāt paraṁ te teṣāṁ pañcānāṁ yāvapūpānāṁ avaśiṣṭānyakhilāni saṁgṛhya dvādaśaḍallakān apūrayan|</para>
  <para style="p">
    <verse number="14" style="v"/>aparaṁ yīśoretādṛśīm āścaryyakriyāṁ dṛṣṭvā lokā mitho vaktumārebhire jagati yasyāgamanaṁ bhaviṣyati sa evāyam avaśyaṁ bhaviṣyadvakttā|</para>
  <para style="p">
    <verse number="15" style="v"/>ataeva lokā āgatya tamākramya rājānaṁ kariṣyanti yīśusteṣām īdṛśaṁ mānasaṁ vijñāya punaśca parvvatam ekākī gatavān|</para>
  <para style="p">
    <verse number="16" style="v"/>sāyaṁkāla upasthite śiṣyā jaladhitaṭaṁ vrajitvā nāvamāruhya nagaradiśi sindhau vāhayitvāgaman|</para>
  <para style="p">
    <verse number="17" style="v"/>tasmin samaye timira upātiṣṭhat kintu yīṣusteṣāṁ samīpaṁ nāgacchat|</para>
  <para style="p">
    <verse number="18" style="v"/>tadā prabalapavanavahanāt sāgare mahātaraṅgo bhavitum ārebhe|</para>
  <para style="p">
    <verse number="19" style="v"/>tataste vāhayitvā dvitrān krośān gatāḥ paścād yīśuṁ jaladherupari padbhyāṁ vrajantaṁ naukāntikam āgacchantaṁ vilokya trāsayuktā abhavan</para>
  <para style="p">
    <verse number="20" style="v"/>kintu sa tānukttavān ayamahaṁ mā bhaiṣṭa|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā te taṁ svairaṁ nāvi gṛhītavantaḥ tadā tatkṣaṇād uddiṣṭasthāne naurupāsthāt|</para>
  <para style="p">
    <verse number="22" style="v"/>yayā nāvā śiṣyā agacchan tadanyā kāpi naukā tasmin sthāne nāsīt tato yīśuḥ śiṣyaiḥ sākaṁ nāgamat kevalāḥ śiṣyā agaman etat pārasthā lokā jñātavantaḥ|</para>
  <para style="p">
    <verse number="23" style="v"/>kintu tataḥ paraṁ prabhu ryatra īśvarasya guṇān anukīrttya lokān pūpān abhojayat tatsthānasya samīpasthativiriyāyā aparāstaraṇaya āgaman|</para>
  <para style="p">
    <verse number="24" style="v"/>yīśustatra nāsti śiṣyā api tatra nā santi lokā iti vijñāya yīśuṁ gaveṣayituṁ taraṇibhiḥ kapharnāhūm puraṁ gatāḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>tataste saritpateḥ pāre taṁ sākṣāt prāpya prāvocan he guro bhavān atra sthāne kadāgamat?</para>
  <para style="p">
    <verse number="26" style="v"/>tadā yīśustān pratyavādīd yuṣmānahaṁ yathārthataraṁ vadāmi āścaryyakarmmadarśanāddheto rna kintu pūpabhojanāt tena tṛptatvāñca māṁ gaveṣayatha|</para>
  <para style="p">
    <verse number="27" style="v"/>kṣayaṇīyabhakṣyārthaṁ mā śrāmiṣṭa kintvantāyurbhakṣyārthaṁ śrāmyata, tasmāt tādṛśaṁ bhakṣyaṁ manujaputro yuṣmābhyaṁ dāsyati; tasmin tāta īśvaraḥ pramāṇaṁ prādāt|</para>
  <para style="p">
    <verse number="28" style="v"/>tadā te'pṛcchan īśvarābhimataṁ karmma karttum asmābhiḥ kiṁ karttavyaṁ?</para>
  <para style="p">
    <verse number="29" style="v"/>tato yīśuravadad īśvaro yaṁ prairayat tasmin viśvasanam īśvarābhimataṁ karmma|</para>
  <para style="p">
    <verse number="30" style="v"/>tadā te vyāharan bhavatā kiṁ lakṣaṇaṁ darśitaṁ yaddṛṣṭvā bhavati viśvasiṣyāmaḥ? tvayā kiṁ karmma kṛtaṁ?</para>
  <para style="p">
    <verse number="31" style="v"/>asmākaṁ pūrvvapuruṣā mahāprāntare mānnāṁ bhokttuṁ prāpuḥ yathā lipirāste| svargīyāṇi tu bhakṣyāṇi pradadau parameśvaraḥ|</para>
  <para style="p">
    <verse number="32" style="v"/>tadā yīśuravadad ahaṁ yuṣmānatiyathārthaṁ vadāmi mūsā yuṣmābhyaṁ svargīyaṁ bhakṣyaṁ nādāt kintu mama pitā yuṣmābhyaṁ svargīyaṁ paramaṁ bhakṣyaṁ dadāti|</para>
  <para style="p">
    <verse number="33" style="v"/>yaḥ svargādavaruhya jagate jīvanaṁ dadāti sa īśvaradattabhakṣyarūpaḥ|</para>
  <para style="p">
    <verse number="34" style="v"/>tadā te prāvocan he prabho bhakṣyamidaṁ nityamasmabhyaṁ dadātu|</para>
  <para style="p">
    <verse number="35" style="v"/>yīśuravadad ahameva jīvanarūpaṁ bhakṣyaṁ yo jano mama sannidhim āgacchati sa jātu kṣudhārtto na bhaviṣyati, tathā yo jano māṁ pratyeti sa jātu tṛṣārtto na bhaviṣyati|</para>
  <para style="p">
    <verse number="36" style="v"/>māṁ dṛṣṭvāpi yūyaṁ na viśvasitha yuṣmānaham ityavocaṁ|</para>
  <para style="p">
    <verse number="37" style="v"/>pitā mahyaṁ yāvato lokānadadāt te sarvva eva mamāntikam āgamiṣyanti yaḥ kaścicca mama sannidhim āyāsyati taṁ kenāpi prakāreṇa na dūrīkariṣyāmi|</para>
  <para style="p">
    <verse number="38" style="v"/>nijābhimataṁ sādhayituṁ na hi kintu prerayiturabhimataṁ sādhayituṁ svargād āgatosmi|</para>
  <para style="p">
    <verse number="39" style="v"/>sa yān yān lokān mahyamadadāt teṣāmekamapi na hārayitvā śeṣadine sarvvānaham utthāpayāmi idaṁ matprerayituḥ piturabhimataṁ|</para>
  <para style="p">
    <verse number="40" style="v"/>yaḥ kaścin mānavasutaṁ vilokya viśvasiti sa śeṣadine mayotthāpitaḥ san anantāyuḥ prāpsyati iti matprerakasyābhimataṁ|</para>
  <para style="p">
    <verse number="41" style="v"/>tadā svargād yad bhakṣyam avārohat tad bhakṣyam ahameva yihūdīyalokāstasyaitad vākye vivadamānā vakttumārebhire</para>
  <para style="p">
    <verse number="42" style="v"/>yūṣaphaḥ putro yīśu ryasya mātāpitarau vayaṁ jānīma eṣa kiṁ saeva na? tarhi svargād avāroham iti vākyaṁ kathaṁ vaktti?</para>
  <para style="p">
    <verse number="43" style="v"/>tadā yīśustān pratyavadat parasparaṁ mā vivadadhvaṁ</para>
  <para style="p">
    <verse number="44" style="v"/>matprerakeṇa pitrā nākṛṣṭaḥ kopi jano mamāntikam āyātuṁ na śaknoti kintvāgataṁ janaṁ carame'hni protthāpayiṣyāmi|</para>
  <para style="p">
    <verse number="45" style="v"/>te sarvva īśvareṇa śikṣitā bhaviṣyanti bhaviṣyadvādināṁ grantheṣu lipiritthamāste ato yaḥ kaścit pituḥ sakāśāt śrutvā śikṣate sa eva mama samīpam āgamiṣyati|</para>
  <para style="p">
    <verse number="46" style="v"/>ya īśvarād ajāyata taṁ vinā kopi manuṣyo janakaṁ nādarśat kevalaḥ saeva tātam adrākṣīt|</para>
  <para style="p">
    <verse number="47" style="v"/>ahaṁ yuṣmān yathārthataraṁ vadāmi yo jano mayi viśvāsaṁ karoti sonantāyuḥ prāpnoti|</para>
  <para style="p">
    <verse number="48" style="v"/>ahameva tajjīvanabhakṣyaṁ|</para>
  <para style="p">
    <verse number="49" style="v"/>yuṣmākaṁ pūrvvapuruṣā mahāprāntare mannābhakṣyaṁ bhūkttāpi mṛtāḥ</para>
  <para style="p">
    <verse number="50" style="v"/>kintu yadbhakṣyaṁ svargādāgacchat tad yadi kaścid bhuṅktte tarhi sa na mriyate|</para>
  <para style="p">
    <verse number="51" style="v"/>yajjīvanabhakṣyaṁ svargādāgacchat sohameva idaṁ bhakṣyaṁ yo jano bhuṅktte sa nityajīvī bhaviṣyati| punaśca jagato jīvanārthamahaṁ yat svakīyapiśitaṁ dāsyāmi tadeva mayā vitaritaṁ bhakṣyam|</para>
  <para style="p">
    <verse number="52" style="v"/>tasmād yihūdīyāḥ parasparaṁ vivadamānā vakttumārebhire eṣa bhojanārthaṁ svīyaṁ palalaṁ katham asmabhyaṁ dāsyati?</para>
  <para style="p">
    <verse number="53" style="v"/>tadā yīśustān āvocad yuṣmānahaṁ yathārthataraṁ vadāmi manuṣyaputrasyāmiṣe yuṣmābhi rna bhuktte tasya rudhire ca na pīte jīvanena sārddhaṁ yuṣmākaṁ sambandho nāsti|</para>
  <para style="p">
    <verse number="54" style="v"/>yo mamāmiṣaṁ svādati mama sudhirañca pivati sonantāyuḥ prāpnoti tataḥ śeṣe'hni tamaham utthāpayiṣyāmi|</para>
  <para style="p">
    <verse number="55" style="v"/>yato madīyamāmiṣaṁ paramaṁ bhakṣyaṁ tathā madīyaṁ śoṇitaṁ paramaṁ peyaṁ|</para>
  <para style="p">
    <verse number="56" style="v"/>yo jano madīyaṁ palalaṁ svādati madīyaṁ rudhirañca pivati sa mayi vasati tasminnahañca vasāmi|</para>
  <para style="p">
    <verse number="57" style="v"/>matprerayitrā jīvatā tātena yathāhaṁ jīvāmi tadvad yaḥ kaścin māmatti sopi mayā jīviṣyati|</para>
  <para style="p">
    <verse number="58" style="v"/>yadbhakṣyaṁ svargādāgacchat tadidaṁ yanmānnāṁ svāditvā yuṣmākaṁ pitaro'mriyanta tādṛśam idaṁ bhakṣyaṁ na bhavati idaṁ bhakṣyaṁ yo bhakṣati sa nityaṁ jīviṣyati|</para>
  <para style="p">
    <verse number="59" style="v"/>yadā kapharnāhūm puryyāṁ bhajanagehe upādiśat tadā kathā etā akathayat|</para>
  <para style="p">
    <verse number="60" style="v"/>tadetthaṁ śrutvā tasya śiṣyāṇām aneke parasparam akathayan idaṁ gāḍhaṁ vākyaṁ vākyamīdṛśaṁ kaḥ śrotuṁ śakruyāt?</para>
  <para style="p">
    <verse number="61" style="v"/>kintu yīśuḥ śiṣyāṇām itthaṁ vivādaṁ svacitte vijñāya kathitavān idaṁ vākyaṁ kiṁ yuṣmākaṁ vighnaṁ janayati?</para>
  <para style="p">
    <verse number="62" style="v"/>yadi manujasutaṁ pūrvvavāsasthānam ūrdvvaṁ gacchantaṁ paśyatha tarhi kiṁ bhaviṣyati?</para>
  <para style="p">
    <verse number="63" style="v"/>ātmaiva jīvanadāyakaḥ vapu rniṣphalaṁ yuṣmabhyamahaṁ yāni vacāṁsi kathayāmi tānyātmā jīvanañca|</para>
  <para style="p">
    <verse number="64" style="v"/>kintu yuṣmākaṁ madhye kecana aviśvāsinaḥ santi ke ke na viśvasanti ko vā taṁ parakareṣu samarpayiṣyati tān yīśurāprathamād vetti|</para>
  <para style="p">
    <verse number="65" style="v"/>aparamapi kathitavān asmāt kāraṇād akathayaṁ pituḥ sakāśāt śakttimaprāpya kopi mamāntikam āgantuṁ na śaknoti|</para>
  <para style="p">
    <verse number="66" style="v"/>tatkāle'neke śiṣyā vyāghuṭya tena sārddhaṁ puna rnāgacchan|</para>
  <para style="p">
    <verse number="67" style="v"/>tadā yīśu rdvādaśaśiṣyān ukttavān yūyamapi kiṁ yāsyatha?</para>
  <para style="p">
    <verse number="68" style="v"/>tataḥ śimon pitaraḥ pratyavocat he prabho kasyābhyarṇaṁ gamiṣyāmaḥ?</para>
  <para style="p">
    <verse number="69" style="v"/>anantajīvanadāyinyo yāḥ kathāstāstavaiva| bhavān amareśvarasyābhiṣikttaputra iti viśvasya niścitaṁ jānīmaḥ|</para>
  <para style="p">
    <verse number="70" style="v"/>tadā yīśuravadat kimahaṁ yuṣmākaṁ dvādaśajanān manonītān na kṛtavān? kintu yuṣmākaṁ madhyepi kaścideko vighnakārī vidyate|</para>
  <para style="p">
    <verse number="71" style="v"/>imāṁ kathaṁ sa śimonaḥ putram īṣkarīyotīyaṁ yihūdām uddiśya kathitavān yato dvādaśānāṁ madhye gaṇitaḥ sa taṁ parakareṣu samarpayiṣyati|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ paraṁ yihūdīyalokāstaṁ hantuṁ samaihanta tasmād yīśu ryihūdāpradeśe paryyaṭituṁ necchan gālīl pradeśe paryyaṭituṁ prārabhata|</para>
  <para style="p">
    <verse number="2" style="v"/>kintu tasmin samaye yihūdīyānāṁ dūṣyavāsanāmotsava upasthite</para>
  <para style="p">
    <verse number="3" style="v"/>tasya bhrātarastam avadan yāni karmmāṇi tvayā kriyante tāni yathā tava śiṣyāḥ paśyanti tadarthaṁ tvamitaḥ sthānād yihūdīyadeśaṁ vraja|</para>
  <para style="p">
    <verse number="4" style="v"/>yaḥ kaścit svayaṁ pracikāśiṣati sa kadāpi guptaṁ karmma na karoti yadīdṛśaṁ karmma karoṣi tarhi jagati nijaṁ paricāyaya|</para>
  <para style="p">
    <verse number="5" style="v"/>yatastasya bhrātaropi taṁ na viśvasanti|</para>
  <para style="p">
    <verse number="6" style="v"/>tadā yīśustān avocat mama samaya idānīṁ nopatiṣṭhati kintu yuṣmākaṁ samayaḥ satatam upatiṣṭhati|</para>
  <para style="p">
    <verse number="7" style="v"/>jagato lokā yuṣmān ṛtīyituṁ na śakruvanti kintu māmeva ṛtīyante yatasteṣāṁ karmāṇi duṣṭāni tatra sākṣyamidam ahaṁ dadāmi|</para>
  <para style="p">
    <verse number="8" style="v"/>ataeva yūyam utsave'smin yāta nāham idānīm asminnutsave yāmi yato mama samaya idānīṁ na sampūrṇaḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>iti vākyam ukttvā sa gālīli sthitavān</para>
  <para style="p">
    <verse number="10" style="v"/>kintu tasya bhrātṛṣu tatra prasthiteṣu satsu so'prakaṭa utsavam agacchat|</para>
  <para style="p">
    <verse number="11" style="v"/>anantaram utsavam upasthitā yihūdīyāstaṁ mṛgayitvāpṛcchan sa kutra?</para>
  <para style="p">
    <verse number="12" style="v"/>tato lokānāṁ madhye tasmin nānāvidhā vivādā bhavitum ārabdhavantaḥ| kecid avocan sa uttamaḥ puruṣaḥ kecid avocan na tathā varaṁ lokānāṁ bhramaṁ janayati|</para>
  <para style="p">
    <verse number="13" style="v"/>kintu yihūdīyānāṁ bhayāt kopi tasya pakṣe spaṣṭaṁ nākathayat|</para>
  <para style="p">
    <verse number="14" style="v"/>tataḥ param utsavasya madhyasamaye yīśu rmandiraṁ gatvā samupadiśati sma|</para>
  <para style="p">
    <verse number="15" style="v"/>tato yihūdīyā lokā āścaryyaṁ jñātvākathayan eṣā mānuṣo nādhītyā katham etādṛśo vidvānabhūt?</para>
  <para style="p">
    <verse number="16" style="v"/>tadā yīśuḥ pratyavocad upadeśoyaṁ na mama kintu yo māṁ preṣitavān tasya|</para>
  <para style="p">
    <verse number="17" style="v"/>yo jano nideśaṁ tasya grahīṣyati mamopadeśo matto bhavati kim īśvarād bhavati sa ganastajjñātuṁ śakṣyati|</para>
  <para style="p">
    <verse number="18" style="v"/>yo janaḥ svataḥ kathayati sa svīyaṁ gauravam īhate kintu yaḥ prerayitu rgauravam īhate sa satyavādī tasmin kopyadharmmo nāsti|</para>
  <para style="p">
    <verse number="19" style="v"/>mūsā yuṣmabhyaṁ vyavasthāgranthaṁ kiṁ nādadāt? kintu yuṣmākaṁ kopi tāṁ vyavasthāṁ na samācarati| māṁ hantuṁ kuto yatadhve?</para>
  <para style="p">
    <verse number="20" style="v"/>tadā lokā avadan tvaṁ bhūtagrastastvāṁ hantuṁ ko yatate?</para>
  <para style="p">
    <verse number="21" style="v"/>tato yīśuravocad ekaṁ karmma mayākāri tasmād yūyaṁ sarvva mahāścaryyaṁ manyadhve|</para>
  <para style="p">
    <verse number="22" style="v"/>mūsā yuṣmabhyaṁ tvakchedavidhiṁ pradadau sa mūsāto na jātaḥ kintu pitṛpuruṣebhyo jātaḥ tena viśrāmavāre'pi mānuṣāṇāṁ tvakchedaṁ kurutha|</para>
  <para style="p">
    <verse number="23" style="v"/>ataeva viśrāmavāre manuṣyāṇāṁ tvakchede kṛte yadi mūsāvyavasthāmaṅganaṁ na bhavati tarhi mayā viśrāmavāre mānuṣaḥ sampūrṇarūpeṇa svastho'kāri tatkāraṇād yūyaṁ kiṁ mahyaṁ kupyatha?</para>
  <para style="p">
    <verse number="24" style="v"/>sapakṣapātaṁ vicāramakṛtvā nyāyyaṁ vicāraṁ kuruta|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā yirūśālam nivāsinaḥ katipayajanā akathayan ime yaṁ hantuṁ ceṣṭante sa evāyaṁ kiṁ na?</para>
  <para style="p">
    <verse number="26" style="v"/>kintu paśyata nirbhayaḥ san kathāṁ kathayati tathāpi kimapi a vadantyete ayamevābhiṣiktto bhavatīti niścitaṁ kimadhipatayo jānanti?</para>
  <para style="p">
    <verse number="27" style="v"/>manujoyaṁ kasmādāgamad iti vayaṁ jānomaḥ kintvabhiṣiktta āgate sa kasmādāgatavān iti kopi jñātuṁ na śakṣyati|</para>
  <para style="p">
    <verse number="28" style="v"/>tadā yīśu rmadhyemandiram upadiśan uccaiḥkāram ukttavān yūyaṁ kiṁ māṁ jānītha? kasmāccāgatosmi tadapi kiṁ jānītha? nāhaṁ svata āgatosmi kintu yaḥ satyavādī saeva māṁ preṣitavān yūyaṁ taṁ na jānītha|</para>
  <para style="p">
    <verse number="29" style="v"/>tamahaṁ jāne tenāhaṁ prerita agatosmi|</para>
  <para style="p">
    <verse number="30" style="v"/>tasmād yihūdīyāstaṁ dharttum udyatāstathāpi kopi tasya gātre hastaṁ nārpayad yato hetostadā tasya samayo nopatiṣṭhati|</para>
  <para style="p">
    <verse number="31" style="v"/>kintu bahavo lokāstasmin viśvasya kathitavānto'bhiṣikttapuruṣa āgatya mānuṣasyāsya kriyābhyaḥ kim adhikā āścaryyāḥ kriyāḥ kariṣyati?</para>
  <para style="p">
    <verse number="32" style="v"/>tataḥ paraṁ lokāstasmin itthaṁ vivadante phirūśinaḥ pradhānayājakāñceti śrutavantastaṁ dhṛtvā netuṁ padātigaṇaṁ preṣayāmāsuḥ|</para>
  <para style="p">
    <verse number="33" style="v"/>tato yīśuravadad aham alpadināni yuṣmābhiḥ sārddhaṁ sthitvā matprerayituḥ samīpaṁ yāsyāmi|</para>
  <para style="p">
    <verse number="34" style="v"/>māṁ mṛgayiṣyadhve kintūddeśaṁ na lapsyadhve ratra sthāsyāmi tatra yūyaṁ gantuṁ na śakṣyatha|</para>
  <para style="p">
    <verse number="35" style="v"/>tadā yihūdīyāḥ parasparaṁ vakttumārebhire asyoddeśaṁ na prāpsyāma etādṛśaṁ kiṁ sthānaṁ yāsyati? bhinnadeśe vikīrṇānāṁ yihūdīyānāṁ sannidhim eṣa gatvā tān upadekṣyati kiṁ?</para>
  <para style="p">
    <verse number="36" style="v"/>no cet māṁ gaveṣayiṣyatha kintūddeśaṁ na prāpsyatha eṣa kodṛśaṁ vākyamidaṁ vadati?</para>
  <para style="p">
    <verse number="37" style="v"/>anantaram utsavasya carame'hani arthāt pradhānadine yīśuruttiṣṭhan uccaiḥkāram āhvayan uditavān yadi kaścit tṛṣārtto bhavati tarhi mamāntikam āgatya pivatu|</para>
  <para style="p">
    <verse number="38" style="v"/>yaḥ kaścinmayi viśvasiti dharmmagranthasya vacanānusāreṇa tasyābhyantarato'mṛtatoyasya srotāṁsi nirgamiṣyanti|</para>
  <para style="p">
    <verse number="39" style="v"/>ye tasmin viśvasanti ta ātmānaṁ prāpsyantītyarthe sa idaṁ vākyaṁ vyāhṛtavān etatkālaṁ yāvad yīśu rvibhavaṁ na prāptastasmāt pavitra ātmā nādīyata|</para>
  <para style="p">
    <verse number="40" style="v"/>etāṁ vāṇīṁ śrutvā bahavo lokā avadan ayameva niścitaṁ sa bhaviṣyadvādī|</para>
  <para style="p">
    <verse number="41" style="v"/>kecid akathayan eṣaeva sobhiṣikttaḥ kintu kecid avadan sobhiṣikttaḥ kiṁ gālīl pradeśe janiṣyate?</para>
  <para style="p">
    <verse number="42" style="v"/>sobhiṣiktto dāyūdo vaṁśe dāyūdo janmasthāne baitlehami pattane janiṣyate dharmmagranthe kimitthaṁ likhitaṁ nāsti?</para>
  <para style="p">
    <verse number="43" style="v"/>itthaṁ tasmin lokānāṁ bhinnavākyatā jātā|</para>
  <para style="p">
    <verse number="44" style="v"/>katipayalokāstaṁ dharttum aicchan tathāpi tadvapuṣi kopi hastaṁ nārpayat|</para>
  <para style="p">
    <verse number="45" style="v"/>anantaraṁ pādātigaṇe pradhānayājakānāṁ phirūśināñca samīpamāgatavati te tān apṛcchan kuto hetostaṁ nānayata?</para>
  <para style="p">
    <verse number="46" style="v"/>tadā padātayaḥ pratyavadan sa mānava iva kopi kadāpi nopādiśat|</para>
  <para style="p">
    <verse number="47" style="v"/>tataḥ phirūśinaḥ prāvocan yūyamapi kimabhrāmiṣṭa?</para>
  <para style="p">
    <verse number="48" style="v"/>adhipatīnāṁ phirūśināñca kopi kiṁ tasmin vyaśvasīt?</para>
  <para style="p">
    <verse number="49" style="v"/>ye śāstraṁ na jānanti ta ime'dhamalokāeva śāpagrastāḥ|</para>
  <para style="p">
    <verse number="50" style="v"/>tadā nikadīmanāmā teṣāmeko yaḥ kṣaṇadāyāṁ yīśoḥ sannidhim agāt sa ukttavān</para>
  <para style="p">
    <verse number="51" style="v"/>tasya vākye na śrute karmmaṇi ca na vidite 'smākaṁ vyavasthā kiṁ kañcana manujaṁ doṣīkaroti?</para>
  <para style="p">
    <verse number="52" style="v"/>tataste vyāharan tvamapi kiṁ gālīlīyalokaḥ? vivicya paśya galīli kopi bhaviṣyadvādī notpadyate|</para>
  <para style="p">
    <verse number="53" style="v"/>tataḥ paraṁ sarvve svaṁ svaṁ gṛhaṁ gatāḥ kintu yīśu rjaitunanāmānaṁ śiloccayaṁ gatavān|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>pratyūṣe yīśuḥ panarmandiram āgacchat</para>
  <para style="p">
    <verse number="2" style="v"/>tataḥ sarvveṣu lokeṣu tasya samīpa āgateṣu sa upaviśya tān upadeṣṭum ārabhata|</para>
  <para style="p">
    <verse number="3" style="v"/>tadā adhyāpakāḥ phirūśinañca vyabhicārakarmmaṇi dhṛtaṁ striyamekām āniya sarvveṣāṁ madhye sthāpayitvā vyāharan</para>
  <para style="p">
    <verse number="4" style="v"/>he guro yoṣitam imāṁ vyabhicārakarmma kurvvāṇāṁ lokā dhṛtavantaḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>etādṛśalokāḥ pāṣāṇāghātena hantavyā iti vidhirmūsāvyavasthāgranthe likhitosti kintu bhavān kimādiśati?</para>
  <para style="p">
    <verse number="6" style="v"/>te tamapavadituṁ parīkṣābhiprāyeṇa vākyamidam apṛcchan kintu sa prahvībhūya bhūmāvaṅgalyā lekhitum ārabhata|</para>
  <para style="p">
    <verse number="7" style="v"/>tatastaiḥ punaḥ punaḥ pṛṣṭa utthāya kathitavān yuṣmākaṁ madhye yo jano niraparādhī saeva prathamam enāṁ pāṣāṇenāhantu|</para>
  <para style="p">
    <verse number="8" style="v"/>paścāt sa punaśca prahvībhūya bhūmau lekhitum ārabhata|</para>
  <para style="p">
    <verse number="9" style="v"/>tāṁ kathaṁ śrutvā te svasvamanasi prabodhaṁ prāpya jyeṣṭhānukramaṁ ekaikaśaḥ sarvve bahiragacchan tato yīśurekākī tayakttobhavat madhyasthāne daṇḍāyamānā sā yoṣā ca sthitā|</para>
  <para style="p">
    <verse number="10" style="v"/>tatpaścād yīśurutthāya tāṁ vanitāṁ vinā kamapyaparaṁ na vilokya pṛṣṭavān he vāme tavāpavādakāḥ kutra? kopi tvāṁ kiṁ na daṇḍayati?</para>
  <para style="p">
    <verse number="11" style="v"/>sāvadat he maheccha kopi na tadā yīśuravocat nāhamapi daṇḍayāmi yāhi punaḥ pāpaṁ mākārṣīḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>tato yīśuḥ punarapi lokebhya itthaṁ kathayitum ārabhata jagatohaṁ jyotiḥsvarūpo yaḥ kaścin matpaścāda gacchati sa timire na bhramitvā jīvanarūpāṁ dīptiṁ prāpsyati|</para>
  <para style="p">
    <verse number="13" style="v"/>tataḥ phirūśino'vādiṣustvaṁ svārthe svayaṁ sākṣyaṁ dadāsi tasmāt tava sākṣyaṁ grāhyaṁ na bhavati|</para>
  <para style="p">
    <verse number="14" style="v"/>tadā yīśuḥ pratyuditavān yadyapi svārthe'haṁ svayaṁ sākṣyaṁ dadāmi tathāpi mat sākṣyaṁ grāhyaṁ yasmād ahaṁ kuta āgatosmi kva yāmi ca tadahaṁ jānāmi kintu kuta āgatosmi kutra gacchāmi ca tad yūyaṁ na jānītha|</para>
  <para style="p">
    <verse number="15" style="v"/>yūyaṁ laukikaṁ vicārayatha nāhaṁ kimapi vicārayāmi|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yadi vicārayāmi tarhi mama vicāro grahītavyo yatoham ekākī nāsmi prerayitā pitā mayā saha vidyate|</para>
  <para style="p">
    <verse number="17" style="v"/>dvayo rjanayoḥ sākṣyaṁ grahaṇīyaṁ bhavatīti yuṣmākaṁ vyavasthāgranthe likhitamasti|</para>
  <para style="p">
    <verse number="18" style="v"/>ahaṁ svārthe svayaṁ sākṣitvaṁ dadāmi yaśca mama tāto māṁ preritavān sopi madarthe sākṣyaṁ dadāti|</para>
  <para style="p">
    <verse number="19" style="v"/>tadā te'pṛcchan tava tātaḥ kutra? tato yīśuḥ pratyavādīd yūyaṁ māṁ na jānītha matpitarañca na jānītha yadi mām akṣāsyata tarhi mama tātamapyakṣāsyata|</para>
  <para style="p">
    <verse number="20" style="v"/>yīśu rmandira upadiśya bhaṇḍāgāre kathā etā akathayat tathāpi taṁ prati kopi karaṁ nodatolayat|</para>
  <para style="p">
    <verse number="21" style="v"/>tataḥ paraṁ yīśuḥ punaruditavān adhunāhaṁ gacchāmi yūyaṁ māṁ gaveṣayiṣyatha kintu nijaiḥ pāpai rmariṣyatha yat sthānam ahaṁ yāsyāmi tat sthānam yūyaṁ yātuṁ na śakṣyatha|</para>
  <para style="p">
    <verse number="22" style="v"/>tadā yihūdīyāḥ prāvocan kimayam ātmaghātaṁ kariṣyati? yato yat sthānam ahaṁ yāsyāmi tat sthānam yūyaṁ yātuṁ na śakṣyatha iti vākyaṁ bravīti|</para>
  <para style="p">
    <verse number="23" style="v"/>tato yīśustebhyaḥ kathitavān yūyam adhaḥsthānīyā lokā aham ūrdvvasthānīyaḥ yūyam etajjagatsambandhīyā aham etajjagatsambandhīyo na|</para>
  <para style="p">
    <verse number="24" style="v"/>tasmāt kathitavān yūyaṁ nijaiḥ pāpai rmariṣyatha yatohaṁ sa pumān iti yadi na viśvasitha tarhi nijaiḥ pāpai rmariṣyatha|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā te 'pṛcchan kastvaṁ? tato yīśuḥ kathitavān yuṣmākaṁ sannidhau yasya prastāvam ā prathamāt karomi saeva puruṣohaṁ|</para>
  <para style="p">
    <verse number="26" style="v"/>yuṣmāsu mayā bahuvākyaṁ vakttavyaṁ vicārayitavyañca kintu matprerayitā satyavādī tasya samīpe yadahaṁ śrutavān tadeva jagate kathayāmi|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu sa janake vākyamidaṁ prokttavān iti te nābudhyanta|</para>
  <para style="p">
    <verse number="28" style="v"/>tato yīśurakathayad yadā manuṣyaputram ūrdvva utthāpayiṣyatha tadāhaṁ sa pumān kevalaḥ svayaṁ kimapi karmma na karomi kintu tāto yathā śikṣayati tadanusāreṇa vākyamidaṁ vadāmīti ca yūyaṁ jñātuṁ śakṣyatha|</para>
  <para style="p">
    <verse number="29" style="v"/>matprerayitā pitā mām ekākinaṁ na tyajati sa mayā sārddhaṁ tiṣṭhati yatohaṁ tadabhimataṁ karmma sadā karomi|</para>
  <para style="p">
    <verse number="30" style="v"/>tadā tasyaitāni vākyāni śrutvā bahuvastāsmin vyaśvasan|</para>
  <para style="p">
    <verse number="31" style="v"/>ye yihūdīyā vyaśvasan yīśustebhyo'kathayat</para>
  <para style="p">
    <verse number="32" style="v"/>mama vākye yadi yūyam āsthāṁ kurutha tarhi mama śiṣyā bhūtvā satyatvaṁ jñāsyatha tataḥ satyatayā yuṣmākaṁ mokṣo bhaviṣyati|</para>
  <para style="p">
    <verse number="33" style="v"/>tadā te pratyavādiṣuḥ vayam ibrāhīmo vaṁśaḥ kadāpi kasyāpi dāsā na jātāstarhi yuṣmākaṁ muktti rbhaviṣyatīti vākyaṁ kathaṁ bravīṣi?</para>
  <para style="p">
    <verse number="34" style="v"/>tadā yīśuḥ pratyavadad yuṣmānahaṁ yathārthataraṁ vadāmi yaḥ pāpaṁ karoti sa pāpasya dāsaḥ|</para>
  <para style="p">
    <verse number="35" style="v"/>dāsaśca nirantaraṁ niveśane na tiṣṭhati kintu putro nirantaraṁ tiṣṭhati|</para>
  <para style="p">
    <verse number="36" style="v"/>ataḥ putro yadi yuṣmān mocayati tarhi nitāntameva mukttā bhaviṣyatha|</para>
  <para style="p">
    <verse number="37" style="v"/>yuyam ibrāhīmo vaṁśa ityahaṁ jānāmi kintu mama kathā yuṣmākam antaḥkaraṇeṣu sthānaṁ na prāpnuvanti tasmāddheto rmāṁ hantum īhadhve|</para>
  <para style="p">
    <verse number="38" style="v"/>ahaṁ svapituḥ samīpe yadapaśyaṁ tadeva kathayāmi tathā yūyamapi svapituḥ samīpe yadapaśyata tadeva kurudhve|</para>
  <para style="p">
    <verse number="39" style="v"/>tadā te pratyavocan ibrāhīm asmākaṁ pitā tato yīśurakathayad yadi yūyam ibrāhīmaḥ santānā abhaviṣyata tarhi ibrāhīma ācāraṇavad ācariṣyata|</para>
  <para style="p">
    <verse number="40" style="v"/>īśvarasya mukhāt satyaṁ vākyaṁ śrutvā yuṣmān jñāpayāmi yohaṁ taṁ māṁ hantuṁ ceṣṭadhve ibrāhīm etādṛśaṁ karmma na cakāra|</para>
  <para style="p">
    <verse number="41" style="v"/>yūyaṁ svasvapituḥ karmmāṇi kurutha tadā tairukttaṁ na vayaṁ jārajātā asmākam ekaeva pitāsti sa eveśvaraḥ</para>
  <para style="p">
    <verse number="42" style="v"/>tato yīśunā kathitam īśvaro yadi yuṣmākaṁ tātobhaviṣyat tarhi yūyaṁ mayi premākariṣyata yatoham īśvarānnirgatyāgatosmi svato nāgatohaṁ sa māṁ prāhiṇot|</para>
  <para style="p">
    <verse number="43" style="v"/>yūyaṁ mama vākyamidaṁ na budhyadhve kutaḥ? yato yūyaṁ mamopadeśaṁ soḍhuṁ na śaknutha|</para>
  <para style="p">
    <verse number="44" style="v"/>yūyaṁ śaitān pituḥ santānā etasmād yuṣmākaṁ piturabhilāṣaṁ pūrayatha sa ā prathamāt naraghātī tadantaḥ satyatvasya leśopi nāsti kāraṇādataḥ sa satyatāyāṁ nātiṣṭhat sa yadā mṛṣā kathayati tadā nijasvabhāvānusāreṇaiva kathayati yato sa mṛṣābhāṣī mṛṣotpādakaśca|</para>
  <para style="p">
    <verse number="45" style="v"/>ahaṁ tathyavākyaṁ vadāmi kāraṇādasmād yūyaṁ māṁ na pratītha|</para>
  <para style="p">
    <verse number="46" style="v"/>mayi pāpamastīti pramāṇaṁ yuṣmākaṁ ko dātuṁ śaknoti? yadyahaṁ tathyavākyaṁ vadāmi tarhi kuto māṁ na pratitha?</para>
  <para style="p">
    <verse number="47" style="v"/>yaḥ kaścana īśvarīyo lokaḥ sa īśvarīyakathāyāṁ mano nidhatte yūyam īśvarīyalokā na bhavatha tannidānāt tatra na manāṁsi nidhadve|</para>
  <para style="p">
    <verse number="48" style="v"/>tadā yihūdīyāḥ pratyavādiṣuḥ tvamekaḥ śomiroṇīyo bhūtagrastaśca vayaṁ kimidaṁ bhadraṁ nāvādiṣma?</para>
  <para style="p">
    <verse number="49" style="v"/>tato yīśuḥ pratyavādīt nāhaṁ bhūtagrastaḥ kintu nijatātaṁ sammanye tasmād yūyaṁ mām apamanyadhve|</para>
  <para style="p">
    <verse number="50" style="v"/>ahaṁ svasukhyātiṁ na ceṣṭe kintu ceṣṭitā vicārayitā cāpara eka āste|</para>
  <para style="p">
    <verse number="51" style="v"/>ahaṁ yuṣmabhyam atīva yathārthaṁ kathayāmi yo naro madīyaṁ vācaṁ manyate sa kadācana nidhanaṁ na drakṣyati|</para>
  <para style="p">
    <verse number="52" style="v"/>yihūdīyāstamavadan tvaṁ bhūtagrasta itīdānīm avaiṣma| ibrāhīm bhaviṣyadvādinañca sarvve mṛtāḥ kintu tvaṁ bhāṣase yo naro mama bhāratīṁ gṛhlāti sa jātu nidhānāsvādaṁ na lapsyate|</para>
  <para style="p">
    <verse number="53" style="v"/>tarhi tvaṁ kim asmākaṁ pūrvvapuruṣād ibrāhīmopi mahān? yasmāt sopi mṛtaḥ bhaviṣyadvādinopi mṛtāḥ tvaṁ svaṁ kaṁ pumāṁsaṁ manuṣe?</para>
  <para style="p">
    <verse number="54" style="v"/>yīśuḥ pratyavocad yadyahaṁ svaṁ svayaṁ sammanye tarhi mama tat sammananaṁ kimapi na kintu mama tāto yaṁ yūyaṁ svīyam īśvaraṁ bhāṣadhve saeva māṁ sammanute|</para>
  <para style="p">
    <verse number="55" style="v"/>yūyaṁ taṁ nāvagacchatha kintvahaṁ tamavagacchāmi taṁ nāvagacchāmīti vākyaṁ yadi vadāmi tarhi yūyamiva mṛṣābhāṣī bhavāmi kintvahaṁ tamavagacchāmi tadākṣāmapi gṛhlāmi|</para>
  <para style="p">
    <verse number="56" style="v"/>yuṣmākaṁ pūrvvapuruṣa ibrāhīm mama samayaṁ draṣṭum atīvāvāñchat tannirīkṣyānandacca|</para>
  <para style="p">
    <verse number="57" style="v"/>tadā yihūdīyā apṛcchan tava vayaḥ pañcāśadvatsarā na tvaṁ kim ibrāhīmam adrākṣīḥ?</para>
  <para style="p">
    <verse number="58" style="v"/>yīśuḥ pratyavādīd yuṣmānahaṁ yathārthataraṁ vadāmi ibrāhīmo janmanaḥ pūrvvakālamārabhyāhaṁ vidye|</para>
  <para style="p">
    <verse number="59" style="v"/>tadā te pāṣāṇān uttolya tamāhantum udayacchan kintu yīśu rgupto mantirād bahirgatya teṣāṁ madhyena prasthitavān|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ paraṁ yīśurgacchan mārgamadhye janmāndhaṁ naram apaśyat|</para>
  <para style="p">
    <verse number="2" style="v"/>tataḥ śiṣyāstam apṛcchan he guro naroyaṁ svapāpena vā svapitrāḥ pāpenāndho'jāyata?</para>
  <para style="p">
    <verse number="3" style="v"/>tataḥ sa pratyuditavān etasya vāsya pitroḥ pāpād etādṛśobhūda iti nahi kintvanena yatheśvarasya karmma prakāśyate taddhetoreva|</para>
  <para style="p">
    <verse number="4" style="v"/>dine tiṣṭhati matprerayituḥ karmma mayā karttavyaṁ yadā kimapi karmma na kriyate tādṛśī niśāgacchati|</para>
  <para style="p">
    <verse number="5" style="v"/>ahaṁ yāvatkālaṁ jagati tiṣṭhāmi tāvatkālaṁ jagato jyotiḥsvarūposmi|</para>
  <para style="p">
    <verse number="6" style="v"/>ityukttā bhūmau niṣṭhīvaṁ nikṣipya tena paṅkaṁ kṛtavān</para>
  <para style="p">
    <verse number="7" style="v"/>paścāt tatpaṅkena tasyāndhasya netre pralipya tamityādiśat gatvā śilohe 'rthāt preritanāmni sarasi snāhi| tatondho gatvā tatrāsnāt tataḥ prannacakṣu rbhūtvā vyāghuṭyāgāt|</para>
  <para style="p">
    <verse number="8" style="v"/>aparañca samīpavāsino lokā ye ca taṁ pūrvvamandham apaśyan te bakttum ārabhanta yondhaloko vartmanyupaviśyābhikṣata sa evāyaṁ janaḥ kiṁ na bhavati?</para>
  <para style="p">
    <verse number="9" style="v"/>kecidavadan sa eva kecidavocan tādṛśo bhavati kintu sa svayamabravīt sa evāhaṁ bhavāmi|</para>
  <para style="p">
    <verse number="10" style="v"/>ataeva te 'pṛcchan tvaṁ kathaṁ dṛṣṭiṁ pāptavān?</para>
  <para style="p">
    <verse number="11" style="v"/>tataḥ sovadad yīśanāmaka eko jano mama nayane paṅkena pralipya ityājñāpayat śilohakāsāraṁ gatvā tatra snāhi| tatastatra gatvā mayi snāte dṛṣṭimahaṁ labdhavān|</para>
  <para style="p">
    <verse number="12" style="v"/>tadā te 'vadan sa pumān kutra? tenokttaṁ nāhaṁ jānāmi|</para>
  <para style="p">
    <verse number="13" style="v"/>aparaṁ tasmin pūrvvāndhe jane phirūśināṁ nikaṭam ānīte sati phirūśinopi tamapṛcchan kathaṁ dṛṣṭiṁ prāptosi?</para>
  <para style="p">
    <verse number="14" style="v"/>tataḥ sa kathitavān sa paṅkena mama netre 'limpat paścād snātvā dṛṣṭimalabhe|</para>
  <para style="p">
    <verse number="15" style="v"/>kintu yīśu rviśrāmavāre karddamaṁ kṛtvā tasya nayane prasanne'karod itikāraṇāt katipayaphirūśino'vadan</para>
  <para style="p">
    <verse number="16" style="v"/>sa pumān īśvarānna yataḥ sa viśrāmavāraṁ na manyate| tatonye kecit pratyavadan pāpī pumān kim etādṛśam āścaryyaṁ karmma karttuṁ śaknoti?</para>
  <para style="p">
    <verse number="17" style="v"/>itthaṁ teṣāṁ parasparaṁ bhinnavākyatvam abhavat| paścāt te punarapi taṁ pūrvvāndhaṁ mānuṣam aprākṣuḥ yo janastava cakṣuṣī prasanne kṛtavān tasmin tvaṁ kiṁ vadasi? sa ukttavān sa bhaviśadvādī|</para>
  <para style="p">
    <verse number="18" style="v"/>sa dṛṣṭim āptavān iti yihūdīyāstasya dṛṣṭiṁ prāptasya janasya pitro rmukhād aśrutvā na pratyayan|</para>
  <para style="p">
    <verse number="19" style="v"/>ataeva te tāvapṛcchan yuvayo ryaṁ putraṁ janmāndhaṁ vadathaḥ sa kimayaṁ? tarhīdānīṁ kathaṁ draṣṭuṁ śaknoti?</para>
  <para style="p">
    <verse number="20" style="v"/>tatastasya pitarau pratyavocatām ayam āvayoḥ putra ā janerandhaśca tadapyāvāṁ jānīvaḥ</para>
  <para style="p">
    <verse number="21" style="v"/>kintvadhunā kathaṁ dṛṣṭiṁ prāptavān tadāvāṁ n jānīvaḥ kosya cakṣuṣī prasanne kṛtavān tadapi na jānīva eṣa vayaḥprāpta enaṁ pṛcchata svakathāṁ svayaṁ vakṣyati|</para>
  <para style="p">
    <verse number="22" style="v"/>yihūdīyānāṁ bhayāt tasya pitarau vākyamidam avadatāṁ yataḥ kopi manuṣyo yadi yīśum abhiṣiktaṁ vadati tarhi sa bhajanagṛhād dūrīkāriṣyate yihūdīyā iti mantraṇām akurvvan</para>
  <para style="p">
    <verse number="23" style="v"/>atastasya pitarau vyāharatām eṣa vayaḥprāpta enaṁ pṛcchata|</para>
  <para style="p">
    <verse number="24" style="v"/>tadā te punaśca taṁ pūrvvāndham āhūya vyāharan īśvarasya guṇān vada eṣa manuṣyaḥ pāpīti vayaṁ jānīmaḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā sa ukttavān sa pāpī na veti nāhaṁ jāne pūrvāmandha āsamaham adhunā paśyāmīti mātraṁ jānāmi|</para>
  <para style="p">
    <verse number="26" style="v"/>te punarapṛcchan sa tvāṁ prati kimakarot? kathaṁ netre prasanne 'karot?</para>
  <para style="p">
    <verse number="27" style="v"/>tataḥ sovādīd ekakṛtvokathayaṁ yūyaṁ na śṛṇutha tarhi kutaḥ punaḥ śrotum icchatha? yūyamapi kiṁ tasya śiṣyā bhavitum icchatha?</para>
  <para style="p">
    <verse number="28" style="v"/>tadā te taṁ tiraskṛtya vyāharan tvaṁ tasya śiṣyo vayaṁ mūsāḥ śiṣyāḥ|</para>
  <para style="p">
    <verse number="29" style="v"/>mūsāvaktreṇeśvaro jagāda tajjānīmaḥ kintveṣa kutratyaloka iti na jānīmaḥ|</para>
  <para style="p">
    <verse number="30" style="v"/>sovadad eṣa mama locane prasanne 'karot tathāpi kutratyaloka iti yūyaṁ na jānītha etad āścaryyaṁ bhavati|</para>
  <para style="p">
    <verse number="31" style="v"/>īśvaraḥ pāpināṁ kathāṁ na śṛṇoti kintu yo janastasmin bhaktiṁ kṛtvā tadiṣṭakriyāṁ karoti tasyaiva kathāṁ śṛṇoti etad vayaṁ jānīmaḥ|</para>
  <para style="p">
    <verse number="32" style="v"/>kopi manuṣyo janmāndhāya cakṣuṣī adadāt jagadārambhād etādṛśīṁ kathāṁ kopi kadāpi nāśṛṇot|</para>
  <para style="p">
    <verse number="33" style="v"/>asmād eṣa manuṣyo yadīśvarānnājāyata tarhi kiñcidapīdṛśaṁ karmma karttuṁ nāśaknot|</para>
  <para style="p">
    <verse number="34" style="v"/>te vyāharan tvaṁ pāpād ajāyathāḥ kimasmān tvaṁ śikṣayasi? paścātte taṁ bahirakurvvan|</para>
  <para style="p">
    <verse number="35" style="v"/>tadanantaraṁ yihūdīyaiḥ sa bahirakriyata yīśuriti vārttāṁ śrutvā taṁ sākṣāt prāpya pṛṣṭavān īśvarasya putre tvaṁ viśvasiṣi?</para>
  <para style="p">
    <verse number="36" style="v"/>tadā sa pratyavocat he prabho sa ko yat tasminnahaṁ viśvasimi?</para>
  <para style="p">
    <verse number="37" style="v"/>tato yīśuḥ kathitavān tvaṁ taṁ dṛṣṭavān tvayā sākaṁ yaḥ kathaṁ kathayati saeva saḥ|</para>
  <para style="p">
    <verse number="38" style="v"/>tadā he prabho viśvasimītyuktvā sa taṁ praṇāmat|</para>
  <para style="p">
    <verse number="39" style="v"/>paścād yīśuḥ kathitavān nayanahīnā nayanāni prāpnuvanti nayanavantaścāndhā bhavantītyabhiprāyeṇa jagadāham āgaccham|</para>
  <para style="p">
    <verse number="40" style="v"/>etat śrutvā nikaṭasthāḥ katipayāḥ phirūśino vyāharan vayamapi kimandhāḥ?</para>
  <para style="p">
    <verse number="41" style="v"/>tadā yīśuravādīd yadyandhā abhavata tarhi pāpāni nātiṣṭhan kintu paśyāmīti vākyavadanād yuṣmākaṁ pāpāni tiṣṭhanti|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ahaṁ yuṣmānatiyathārthaṁ vadāmi, yo jano dvāreṇa na praviśya kenāpyanyena meṣagṛhaṁ praviśati sa eva steno dasyuśca|</para>
  <para style="p">
    <verse number="2" style="v"/>yo dvāreṇa praviśati sa eva meṣapālakaḥ|</para>
  <para style="p">
    <verse number="3" style="v"/>dauvārikastasmai dvāraṁ mocayati meṣagaṇaśca tasya vākyaṁ śṛṇoti sa nijān meṣān svasvanāmnāhūya bahiḥ kṛtvā nayati|</para>
  <para style="p">
    <verse number="4" style="v"/>tathā nijān meṣān bahiḥ kṛtvā svayaṁ teṣām agre gacchati, tato meṣāstasya śabdaṁ budhyante, tasmāt tasya paścād vrajanti|</para>
  <para style="p">
    <verse number="5" style="v"/>kintu parasya śabdaṁ na budhyante tasmāt tasya paścād vrajiṣyanti varaṁ tasya samīpāt palāyiṣyante|</para>
  <para style="p">
    <verse number="6" style="v"/>yīśustebhya imāṁ dṛṣṭāntakathām akathayat kintu tena kathitakathāyāstātparyyaṁ te nābudhyanta|</para>
  <para style="p">
    <verse number="7" style="v"/>ato yīśuḥ punarakathayat, yuṣmānāhaṁ yathārthataraṁ vyāharāmi, meṣagṛhasya dvāram ahameva|</para>
  <para style="p">
    <verse number="8" style="v"/>mayā na praviśya ya āgacchan te stenā dasyavaśca kintu meṣāsteṣāṁ kathā nāśṛṇvan|</para>
  <para style="p">
    <verse number="9" style="v"/>ahameva dvārasvarūpaḥ, mayā yaḥ kaścita praviśati sa rakṣāṁ prāpsyati tathā bahirantaśca gamanāgamane kṛtvā caraṇasthānaṁ prāpsyati|</para>
  <para style="p">
    <verse number="10" style="v"/>yo janastenaḥ sa kevalaṁ stainyabadhavināśān karttumeva samāyāti kintvaham āyu rdātum arthāt bāhūlyena tadeva dātum āgaccham|</para>
  <para style="p">
    <verse number="11" style="v"/>ahameva satyameṣapālako yastu satyo meṣapālakaḥ sa meṣārthaṁ prāṇatyāgaṁ karoti;</para>
  <para style="p">
    <verse number="12" style="v"/>kintu yo jano meṣapālako na, arthād yasya meṣā nijā na bhavanti, ya etādṛśo vaitanikaḥ sa vṛkam āgacchantaṁ dṛṣṭvā mejavrajaṁ vihāya palāyate, tasmād vṛkastaṁ vrajaṁ dhṛtvā vikirati|</para>
  <para style="p">
    <verse number="13" style="v"/>vaitanikaḥ palāyate yataḥ sa vetanārthī meṣārthaṁ na cintayati|</para>
  <para style="p">
    <verse number="14" style="v"/>ahameva satyo meṣapālakaḥ, pitā māṁ yathā jānāti, ahañca yathā pitaraṁ jānāmi,</para>
  <para style="p">
    <verse number="15" style="v"/>tathā nijān meṣānapi jānāmi, meṣāśca māṁ jānānti, ahañca meṣārthaṁ prāṇatyāgaṁ karomi|</para>
  <para style="p">
    <verse number="16" style="v"/>aparañca etad gṛhīya meṣebhyo bhinnā api meṣā mama santi te sakalā ānayitavyāḥ; te mama śabdaṁ śroṣyanti tata eko vraja eko rakṣako bhaviṣyati|</para>
  <para style="p">
    <verse number="17" style="v"/>prāṇānahaṁ tyaktvā punaḥ prāṇān grahīṣyāmi, tasmāt pitā mayi snehaṁ karoti|</para>
  <para style="p">
    <verse number="18" style="v"/>kaścijjano mama prāṇān hantuṁ na śaknoti kintu svayaṁ tān samarpayāmi tān samarpayituṁ punargrahītuñca mama śaktirāste bhāramimaṁ svapituḥ sakāśāt prāptoham|</para>
  <para style="p">
    <verse number="19" style="v"/>asmādupadeśāt punaśca yihūdīyānāṁ madhye bhinnavākyatā jātā|</para>
  <para style="p">
    <verse number="20" style="v"/>tato bahavo vyāharan eṣa bhūtagrasta unmattaśca, kuta etasya kathāṁ śṛṇutha?</para>
  <para style="p">
    <verse number="21" style="v"/>kecid avadan etasya kathā bhūtagrastasya kathāvanna bhavanti, bhūtaḥ kim andhāya cakṣuṣī dātuṁ śaknoti?</para>
  <para style="p">
    <verse number="22" style="v"/>śītakāle yirūśālami mandirotsargaparvvaṇyupasthite</para>
  <para style="p">
    <verse number="23" style="v"/>yīśuḥ sulemāno niḥsāreṇa gamanāgamane karoti,</para>
  <para style="p">
    <verse number="24" style="v"/>etasmin samaye yihūdīyāstaṁ veṣṭayitvā vyāharan kati kālān asmākaṁ vicikitsāṁ sthāpayiṣyāmi? yadyabhiṣikto bhavati tarhi tat spaṣṭaṁ vada|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā yīśuḥ pratyavadad aham acakathaṁ kintu yūyaṁ na pratītha, nijapitu rnāmnā yāṁ yāṁ kriyāṁ karomi sā kriyaiva mama sākṣisvarūpā|</para>
  <para style="p">
    <verse number="26" style="v"/>kintvahaṁ pūrvvamakathayaṁ yūyaṁ mama meṣā na bhavatha, kāraṇādasmān na viśvasitha|</para>
  <para style="p">
    <verse number="27" style="v"/>mama meṣā mama śabdaṁ śṛṇvanti tānahaṁ jānāmi te ca mama paścād gacchanti|</para>
  <para style="p">
    <verse number="28" style="v"/>ahaṁ tebhyo'nantāyu rdadāmi, te kadāpi na naṁkṣyanti kopi mama karāt tān harttuṁ na śakṣyati|</para>
  <para style="p">
    <verse number="29" style="v"/>yo mama pitā tān mahyaṁ dattavān sa sarvvasmāt mahān, kopi mama pituḥ karāt tān harttuṁ na śakṣyati|</para>
  <para style="p">
    <verse number="30" style="v"/>ahaṁ pitā ca dvayorekatvam|</para>
  <para style="p">
    <verse number="31" style="v"/>tato yihūdīyāḥ punarapi taṁ hantuṁ pāṣāṇān udatolayan|</para>
  <para style="p">
    <verse number="32" style="v"/>yīśuḥ kathitavān pituḥ sakāśād bahūnyuttamakarmmāṇi yuṣmākaṁ prākāśayaṁ teṣāṁ kasya karmmaṇaḥ kāraṇān māṁ pāṣāṇairāhantum udyatāḥ stha?</para>
  <para style="p">
    <verse number="33" style="v"/>yihūdīyāḥ pratyavadan praśastakarmmaheto rna kintu tvaṁ mānuṣaḥ svamīśvaram uktveśvaraṁ nindasi kāraṇādasmāt tvāṁ pāṣāṇairhanmaḥ|</para>
  <para style="p">
    <verse number="34" style="v"/>tadā yīśuḥ pratyuktavān mayā kathitaṁ yūyam īśvarā etadvacanaṁ yuṣmākaṁ śāstre likhitaṁ nāsti kiṁ?</para>
  <para style="p">
    <verse number="35" style="v"/>tasmād yeṣām uddeśe īśvarasya kathā kathitā te yadīśvaragaṇā ucyante dharmmagranthasyāpyanyathā bhavituṁ na śakyaṁ,</para>
  <para style="p">
    <verse number="36" style="v"/>tarhyāham īśvarasya putra iti vākyasya kathanāt yūyaṁ pitrābhiṣiktaṁ jagati preritañca pumāṁsaṁ katham īśvaranindakaṁ vādaya?</para>
  <para style="p">
    <verse number="37" style="v"/>yadyahaṁ pituḥ karmma na karomi tarhi māṁ na pratīta;</para>
  <para style="p">
    <verse number="38" style="v"/>kintu yadi karomi tarhi mayi yuṣmābhiḥ pratyaye na kṛte'pi kāryye pratyayaḥ kriyatāṁ, tato mayi pitāstīti pitaryyaham asmīti ca kṣātvā viśvasiṣyatha|</para>
  <para style="p">
    <verse number="39" style="v"/>tadā te punarapi taṁ dharttum aceṣṭanta kintu sa teṣāṁ karebhyo nistīryya</para>
  <para style="p">
    <verse number="40" style="v"/>puna ryarddan adyāstaṭe yatra purvvaṁ yohan amajjayat tatrāgatya nyavasat|</para>
  <para style="p">
    <verse number="41" style="v"/>tato bahavo lokāstatsamīpam āgatya vyāharan yohan kimapyāścaryyaṁ karmma nākarot kintvasmin manuṣye yā yaḥ kathā akathayat tāḥ sarvvāḥ satyāḥ;</para>
  <para style="p">
    <verse number="42" style="v"/>tatra ca bahavo lokāstasmin vyaśvasan|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ mariyam tasyā bhaginī marthā ca yasmin vaithanīyāgrāme vasatastasmin grāme iliyāsar nāmā pīḍita eka āsīt|</para>
  <para style="p">
    <verse number="2" style="v"/>yā mariyam prabhuṁ sugandhitelaina marddayitvā svakeśaistasya caraṇau samamārjat tasyā bhrātā sa iliyāsar rogī|</para>
  <para style="p">
    <verse number="3" style="v"/>aparañca he prabho bhavān yasmin prīyate sa eva pīḍitostīti kathāṁ kathayitvā tasya bhaginyau preṣitavatyau|</para>
  <para style="p">
    <verse number="4" style="v"/>tadā yīśurimāṁ vārttāṁ śrutvākathayata pīḍeyaṁ maraṇārthaṁ na kintvīśvarasya mahimārtham īśvaraputrasya mahimaprakāśārthañca jātā|</para>
  <para style="p">
    <verse number="5" style="v"/>yīśu ryadyapimarthāyāṁ tadbhaginyām iliyāsari cāprīyata,</para>
  <para style="p">
    <verse number="6" style="v"/>tathāpi iliyāsaraḥ pīḍāyāḥ kathaṁ śrutvā yatra āsīt tatraiva dinadvayamatiṣṭhat|</para>
  <para style="p">
    <verse number="7" style="v"/>tataḥ param sa śiṣyānakathayad vayaṁ puna ryihūdīyapradeśaṁ yāmaḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>tataste pratyavadan, he guro svalpadināni gatāni yihūdīyāstvāṁ pāṣāṇai rhantum udyatāstathāpi kiṁ punastatra yāsyasi?</para>
  <para style="p">
    <verse number="9" style="v"/>yīśuḥ pratyavadat, ekasmin dine kiṁ dvādaśaghaṭikā na bhavanti? kopi divā gacchan na skhalati yataḥ sa etajjagato dīptiṁ prāpnoti|</para>
  <para style="p">
    <verse number="10" style="v"/>kintu rātrau gacchan skhalati yato hetostatra dīpti rnāsti|</para>
  <para style="p">
    <verse number="11" style="v"/>imāṁ kathāṁ kathayitvā sa tānavadad, asmākaṁ bandhuḥ iliyāsar nidritobhūd idānīṁ taṁ nidrāto jāgarayituṁ gacchāmi|</para>
  <para style="p">
    <verse number="12" style="v"/>yīśu rmṛtau kathāmimāṁ kathitavān kintu viśrāmārthaṁ nidrāyāṁ kathitavān iti jñātvā śiṣyā akathayan,</para>
  <para style="p">
    <verse number="13" style="v"/>he guro sa yadi nidrāti tarhi bhadrameva|</para>
  <para style="p">
    <verse number="14" style="v"/>tadā yīśuḥ spaṣṭaṁ tān vyāharat, iliyāsar amriyata;</para>
  <para style="p">
    <verse number="15" style="v"/>kintu yūyaṁ yathā pratītha tadarthamahaṁ tatra na sthitavān ityasmād yuṣmannimittam āhlāditohaṁ, tathāpi tasya samīpe yāma|</para>
  <para style="p">
    <verse number="16" style="v"/>tadā thomā yaṁ didumaṁ vadanti sa saṅginaḥ śiṣyān avadad vayamapi gatvā tena sārddhaṁ mriyāmahai|</para>
  <para style="p">
    <verse number="17" style="v"/>yīśustatropasthāya iliyāsaraḥ śmaśāne sthāpanāt catvāri dināni gatānīti vārttāṁ śrutavān|</para>
  <para style="p">
    <verse number="18" style="v"/>vaithanīyā yirūśālamaḥ samīpasthā krośaikamātrāntaritā;</para>
  <para style="p">
    <verse number="19" style="v"/>tasmād bahavo yihūdīyā marthāṁ mariyamañca bhyātṛśokāpannāṁ sāntvayituṁ tayoḥ samīpam āgacchan|</para>
  <para style="p">
    <verse number="20" style="v"/>marthā yīśorāgamanavārtāṁ śrutvaiva taṁ sākṣād akarot kintu mariyam geha upaviśya sthitā|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā marthā yīśumavādat, he prabho yadi bhavān atrāsthāsyat tarhi mama bhrātā nāmariṣyat|</para>
  <para style="p">
    <verse number="22" style="v"/>kintvidānīmapi yad īśvare prārthayiṣyate īśvarastad dāsyatīti jāne'haṁ|</para>
  <para style="p">
    <verse number="23" style="v"/>yīśuravādīt tava bhrātā samutthāsyati|</para>
  <para style="p">
    <verse number="24" style="v"/>marthā vyāharat śeṣadivase sa utthānasamaye protthāsyatīti jāne'haṁ|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā yīśuḥ kathitavān ahameva utthāpayitā jīvayitā ca yaḥ kaścana mayi viśvasiti sa mṛtvāpi jīviṣyati;</para>
  <para style="p">
    <verse number="26" style="v"/>yaḥ kaścana ca jīvan mayi viśvasiti sa kadāpi na mariṣyati, asyāṁ kathāyāṁ kiṁ viśvasiṣi?</para>
  <para style="p">
    <verse number="27" style="v"/>sāvadat prabho yasyāvataraṇāpekṣāsti bhavān saevābhiṣiktta īśvaraputra iti viśvasimi|</para>
  <para style="p">
    <verse number="28" style="v"/>iti kathāṁ kathayitvā sā gatvā svāṁ bhaginīṁ mariyamaṁ guptamāhūya vyāharat gururupatiṣṭhati tvāmāhūyati ca|</para>
  <para style="p">
    <verse number="29" style="v"/>kathāmimāṁ śrutvā sā tūrṇam utthāya tasya samīpam agacchat|</para>
  <para style="p">
    <verse number="30" style="v"/>yīśu rgrāmamadhyaṁ na praviśya yatra marthā taṁ sākṣād akarot tatra sthitavān|</para>
  <para style="p">
    <verse number="31" style="v"/>ye yihūdīyā mariyamā sākaṁ gṛhe tiṣṭhantastām asāntvayana te tāṁ kṣipram utthāya gacchantiṁ vilokya vyāharan, sa śmaśāne rodituṁ yāti, ityuktvā te tasyāḥ paścād agacchan|</para>
  <para style="p">
    <verse number="32" style="v"/>yatra yīśuratiṣṭhat tatra mariyam upasthāya taṁ dṛṣṭvā tasya caraṇayoḥ patitvā vyāharat he prabho yadi bhavān atrāsthāsyat tarhi mama bhrātā nāmariṣyat|</para>
  <para style="p">
    <verse number="33" style="v"/>yīśustāṁ tasyāḥ saṅgino yihūdīyāṁśca rudato vilokya śokārttaḥ san dīrghaṁ niśvasya kathitavān taṁ kutrāsthāpayata?</para>
  <para style="p">
    <verse number="34" style="v"/>te vyāharan, he prabho bhavān āgatya paśyatu|</para>
  <para style="p">
    <verse number="35" style="v"/>yīśunā kranditaṁ|</para>
  <para style="p">
    <verse number="36" style="v"/>ataeva yihūdīyā avadan, paśyatāyaṁ tasmin kidṛg apriyata|</para>
  <para style="p">
    <verse number="37" style="v"/>teṣāṁ kecid avadan yondhāya cakṣuṣī dattavān sa kim asya mṛtyuṁ nivārayituṁ nāśaknot?</para>
  <para style="p">
    <verse number="38" style="v"/>tato yīśuḥ punarantardīrghaṁ niśvasya śmaśānāntikam agacchat| tat śmaśānam ekaṁ gahvaraṁ tanmukhe pāṣāṇa eka āsīt|</para>
  <para style="p">
    <verse number="39" style="v"/>tadā yīśuravadad enaṁ pāṣāṇam apasārayata, tataḥ pramītasya bhaginī marthāvadat prabho, adhunā tatra durgandho jātaḥ, yatodya catvāri dināni śmaśāne sa tiṣṭhati|</para>
  <para style="p">
    <verse number="40" style="v"/>tadā yīśuravādīt, yadi viśvasiṣi tarhīśvarasya mahimaprakāśaṁ drakṣyasi kathāmimāṁ kiṁ tubhyaṁ nākathayaṁ?</para>
  <para style="p">
    <verse number="41" style="v"/>tadā mṛtasya śmaśānāt pāṣāṇo'pasārite yīśurūrdvvaṁ paśyan akathayat, he pita rmama nevesanam aśṛṇoḥ kāraṇādasmāt tvāṁ dhanyaṁ vadāmi|</para>
  <para style="p">
    <verse number="42" style="v"/>tvaṁ satataṁ śṛṇoṣi tadapyahaṁ jānāmi, kintu tvaṁ māṁ yat prairayastad yathāsmin sthāne sthitā lokā viśvasanti tadartham idaṁ vākyaṁ vadāmi|</para>
  <para style="p">
    <verse number="43" style="v"/>imāṁ kathāṁ kathayitvā sa proccairāhvayat, he iliyāsar bahirāgaccha|</para>
  <para style="p">
    <verse number="44" style="v"/>tataḥ sa pramītaḥ śmaśānavastrai rbaddhahastapādo gātramārjanavāsasā baddhamukhaśca bahirāgacchat| yīśuruditavān bandhanāni mocayitvā tyajatainaṁ|</para>
  <para style="p">
    <verse number="45" style="v"/>mariyamaḥ samīpam āgatā ye yihūdīyalokāstadā yīśoretat karmmāpaśyan teṣāṁ bahavo vyaśvasan,</para>
  <para style="p">
    <verse number="46" style="v"/>kintu kecidanye phirūśināṁ samīpaṁ gatvā yīśoretasya karmmaṇo vārttām avadan|</para>
  <para style="p">
    <verse number="47" style="v"/>tataḥ paraṁ pradhānayājakāḥ phirūśināśca sabhāṁ kṛtvā vyāharan vayaṁ kiṁ kurmmaḥ? eṣa mānavo bahūnyāścaryyakarmmāṇi karoti|</para>
  <para style="p">
    <verse number="48" style="v"/>yadīdṛśaṁ karmma karttuṁ na vārayāmastarhi sarvve lokāstasmin viśvasiṣyanti romilokāścāgatyāsmākam anayā rājadhānyā sārddhaṁ rājyam āchetsyanti|</para>
  <para style="p">
    <verse number="49" style="v"/>tadā teṣāṁ kiyaphānāmā yastasmin vatsare mahāyājakapade nyayujyata sa pratyavadad yūyaṁ kimapi na jānītha;</para>
  <para style="p">
    <verse number="50" style="v"/>samagradeśasya vināśatopi sarvvalokārtham ekasya janasya maraṇam asmākaṁ maṅgalahetukam etasya vivecanāmapi na kurutha|</para>
  <para style="p">
    <verse number="51" style="v"/>etāṁ kathāṁ sa nijabuddhyā vyāharad iti na,</para>
  <para style="p">
    <verse number="52" style="v"/>kintu yīśūstaddeśīyānāṁ kāraṇāt prāṇān tyakṣyati, diśi diśi vikīrṇān īśvarasya santānān saṁgṛhyaikajātiṁ kariṣyati ca, tasmin vatsare kiyaphā mahāyājakatvapade niyuktaḥ san idaṁ bhaviṣyadvākyaṁ kathitavān|</para>
  <para style="p">
    <verse number="53" style="v"/>taddinamārabhya te kathaṁ taṁ hantuṁ śaknuvantīti mantraṇāṁ karttuṁ prārebhire|</para>
  <para style="p">
    <verse number="54" style="v"/>ataeva yihūdīyānāṁ madhye yīśuḥ saprakāśaṁ gamanāgamane akṛtvā tasmād gatvā prāntarasya samīpasthāyipradeśasyephrāyim nāmni nagare śiṣyaiḥ sākaṁ kālaṁ yāpayituṁ prārebhe|</para>
  <para style="p">
    <verse number="55" style="v"/>anantaraṁ yihūdīyānāṁ nistārotsave nikaṭavarttini sati tadutsavāt pūrvvaṁ svān śucīn karttuṁ bahavo janā grāmebhyo yirūśālam nagaram āgacchan,</para>
  <para style="p">
    <verse number="56" style="v"/>yīśoranveṣaṇaṁ kṛtvā mandire daṇḍāyamānāḥ santaḥ parasparaṁ vyāharan, yuṣmākaṁ kīdṛśo bodho jāyate? sa kim utsave'smin atrāgamiṣyati?</para>
  <para style="p">
    <verse number="57" style="v"/>sa ca kutrāsti yadyetat kaścid vetti tarhi darśayatu pradhānayājakāḥ phirūśinaśca taṁ dharttuṁ pūrvvam imām ājñāṁ prācārayan|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>nistārotsavāt pūrvvaṁ dinaṣaṭke sthite yīśu ryaṁ pramītam iliyāsaraṁ śmaśānād udasthāparat tasya nivāsasthānaṁ baithaniyāgrāmam āgacchat|</para>
  <para style="p">
    <verse number="2" style="v"/>tatra tadarthaṁ rajanyāṁ bhojye kṛte marthā paryyaveṣayad iliyāsar ca tasya saṅgibhiḥ sārddhaṁ bhojanāsana upāviśat|</para>
  <para style="p">
    <verse number="3" style="v"/>tadā mariyam arddhaseṭakaṁ bahumūlyaṁ jaṭāmāṁsīyaṁ tailam ānīya yīśoścaraṇayo rmarddayitvā nijakeśa rmārṣṭum ārabhata; tadā tailasya parimalena gṛham āmoditam abhavat|</para>
  <para style="p">
    <verse number="4" style="v"/>yaḥ śimonaḥ putra riṣkariyotīyo yihūdānāmā yīśuṁ parakareṣu samarpayiṣyati sa śiṣyastadā kathitavān,</para>
  <para style="p">
    <verse number="5" style="v"/>etattailaṁ tribhiḥ śatai rmudrāpadai rvikrītaṁ sad daridrebhyaḥ kuto nādīyata?</para>
  <para style="p">
    <verse number="6" style="v"/>sa daridralokārtham acintayad iti na, kintu sa caura evaṁ tannikaṭe mudrāsampuṭakasthityā tanmadhye yadatiṣṭhat tadapāharat tasmāt kāraṇād imāṁ kathāmakathayat|</para>
  <para style="p">
    <verse number="7" style="v"/>tadā yīśurakathayad enāṁ mā vāraya sā mama śmaśānasthāpanadinārthaṁ tadarakṣayat|</para>
  <para style="p">
    <verse number="8" style="v"/>daridrā yuṣmākaṁ sannidhau sarvvadā tiṣṭhanti kintvahaṁ sarvvadā yuṣmākaṁ sannidhau na tiṣṭhāmi|</para>
  <para style="p">
    <verse number="9" style="v"/>tataḥ paraṁ yīśustatrāstīti vārttāṁ śrutvā bahavo yihūdīyāstaṁ śmaśānādutthāpitam iliyāsarañca draṣṭuṁ tat sthānam āgacchana|</para>
  <para style="p">
    <verse number="10" style="v"/>tadā pradhānayājakāstam iliyāsaramapi saṁharttum amantrayan ;</para>
  <para style="p">
    <verse number="11" style="v"/>yatastena bahavo yihūdīyā gatvā yīśau vyaśvasan|</para>
  <para style="p">
    <verse number="12" style="v"/>anantaraṁ yīśu ryirūśālam nagaram āgacchatīti vārttāṁ śrutvā pare'hani utsavāgatā bahavo lokāḥ</para>
  <para style="p">
    <verse number="13" style="v"/>kharjjūrapatrādyānīya taṁ sākṣāt karttuṁ bahirāgatya jaya jayeti vācaṁ proccai rvaktum ārabhanta, isrāyelo yo rājā parameśvarasya nāmnāgacchati sa dhanyaḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>tadā "he siyonaḥ kanye mā bhaiṣīḥ paśyāyaṁ tava rājā garddabhaśāvakam āruhyāgacchati"</para>
  <para style="p">
    <verse number="15" style="v"/>iti śāstrīyavacanānusāreṇa yīśurekaṁ yuvagarddabhaṁ prāpya taduparyyārohat|</para>
  <para style="p">
    <verse number="16" style="v"/>asyāḥ ghaṭanāyāstātparyyaṁ śiṣyāḥ prathamaṁ nābudhyanta, kintu yīśau mahimānaṁ prāpte sati vākyamidaṁ tasmina akathyata lokāśca tampratīttham akurvvan iti te smṛtavantaḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>sa iliyāsaraṁ śmaśānād āgantum āhvatavān śmaśānāñca udasthāpayad ye ye lokāstatkarmya sākṣād apaśyan te pramāṇaṁ dātum ārabhanta|</para>
  <para style="p">
    <verse number="18" style="v"/>sa etādṛśam adbhutaṁ karmmakarot tasya janaśrute rlokāstaṁ sākṣāt karttum āgacchan|</para>
  <para style="p">
    <verse number="19" style="v"/>tataḥ phirūśinaḥ parasparaṁ vaktum ārabhanta yuṣmākaṁ sarvvāśceṣṭā vṛthā jātāḥ, iti kiṁ yūyaṁ na budhyadhve? paśyata sarvve lokāstasya paścādvarttinobhavan|</para>
  <para style="p">
    <verse number="20" style="v"/>bhajanaṁ karttum utsavāgatānāṁ lokānāṁ katipayā janā anyadeśīyā āsan ,</para>
  <para style="p">
    <verse number="21" style="v"/>te gālīlīyabaitsaidānivāsinaḥ philipasya samīpam āgatya vyāharan he maheccha vayaṁ yīśuṁ draṣṭum icchāmaḥ|</para>
  <para style="p">
    <verse number="22" style="v"/>tataḥ philipo gatvā āndriyam avadat paścād āndriyaphilipau yīśave vārttām akathayatāṁ|</para>
  <para style="p">
    <verse number="23" style="v"/>tadā yīśuḥ pratyuditavān mānavasutasya mahimaprāptisamaya upasthitaḥ|</para>
  <para style="p">
    <verse number="24" style="v"/>ahaṁ yuṣmānatiyathārthaṁ vadāmi, dhānyabījaṁ mṛttikāyāṁ patitvā yadi na mṛyate tarhyekākī tiṣṭhati kintu yadi mṛyate tarhi bahuguṇaṁ phalaṁ phalati|</para>
  <para style="p">
    <verse number="25" style="v"/>yo janeा nijaprāṇān priyān jānāti sa tān hārayiṣyati kintu yeा jana ihaloke nijaprāṇān apriyān jānāti seाnantāyuḥ prāptuṁ tān rakṣiṣyati|</para>
  <para style="p">
    <verse number="26" style="v"/>kaścid yadi mama sevako bhavituṁ vāñchati tarhi sa mama paścādgāmī bhavatu, tasmād ahaṁ yatra tiṣṭhāmi mama sevakeाpi tatra sthāsyati; yo jano māṁ sevate mama pitāpi taṁ sammaṁsyate|</para>
  <para style="p">
    <verse number="27" style="v"/>sāmprataṁ mama prāṇā vyākulā bhavanti, tasmād he pitara etasmāt samayān māṁ rakṣa, ityahaṁ kiṁ prārthayiṣye? kintvaham etatsamayārtham avatīrṇavān|</para>
  <para style="p">
    <verse number="28" style="v"/>he pita: svanāmno mahimānaṁ prakāśaya; tanaiva svanāmno mahimānam ahaṁ prākāśayaṁ punarapi prakāśayiṣyāmi, eṣā gagaṇīyā vāṇī tasmin samaye'jāyata|</para>
  <para style="p">
    <verse number="29" style="v"/>tacśrutvā samīpasthalokānāṁ kecid avadan megho'garjīt, kecid avadan svargīyadūto'nena saha kathāmacakathat|</para>
  <para style="p">
    <verse number="30" style="v"/>tadā yīśuḥ pratyavādīt, madarthaṁ śabdoyaṁ nābhūt yuṣmadarthamevābhūt|</para>
  <para style="p">
    <verse number="31" style="v"/>adhunā jagatosya vicāra: sampatsyate, adhunāsya jagata: patī rājyāt cyoṣyati|</para>
  <para style="p">
    <verse number="32" style="v"/>yadyaī pṛthivyā ūrdvve protthāpitosmi tarhi sarvvān mānavān svasamīpam ākarṣiṣyāmi|</para>
  <para style="p">
    <verse number="33" style="v"/>kathaṁ tasya mṛti rbhaviṣyati, etad bodhayituṁ sa imāṁ kathām akathayat|</para>
  <para style="p">
    <verse number="34" style="v"/>tadā lokā akathayan sobhiṣiktaḥ sarvvadā tiṣṭhatīti vyavasthāgranthe śrutam asmābhiḥ, tarhi manuṣyaputraḥ protthāpito bhaviṣyatīti vākyaṁ kathaṁ vadasi? manuṣyaputroyaṁ kaḥ?</para>
  <para style="p">
    <verse number="35" style="v"/>tadā yīśurakathāyad yuṣmābhiḥ sārddham alpadināni jyotirāste, yathā yuṣmān andhakāro nācchādayati tadarthaṁ yāvatkālaṁ yuṣmābhiḥ sārddhaṁ jyotistiṣṭhati tāvatkālaṁ gacchata; yo jano'ndhakāre gacchati sa kutra yātīti na jānāti|</para>
  <para style="p">
    <verse number="36" style="v"/>ataeva yāvatkālaṁ yuṣmākaṁ nikaṭe jyotirāste tāvatkālaṁ jyotīrūpasantānā bhavituṁ jyotiṣi viśvasita; imāṁ kathāṁ kathayitvā yīśuḥ prasthāya tebhyaḥ svaṁ guptavān|</para>
  <para style="p">
    <verse number="37" style="v"/>yadyapi yīśusteṣāṁ samakṣam etāvadāścaryyakarmmāṇi kṛtavān tathāpi te tasmin na vyaśvasan|</para>
  <para style="p">
    <verse number="38" style="v"/>ataeva kaḥ pratyeti susaṁvādaṁ pareśāsmat pracāritaṁ? prakāśate pareśasya hastaḥ kasya ca sannidhau? yiśayiyabhaviṣyadvādinā yadetad vākyamuktaṁ tat saphalam abhavat|</para>
  <para style="p">
    <verse number="39" style="v"/>te pratyetuṁ nāśankuvan tasmin yiśayiyabhaviṣyadvādi punaravādīd,</para>
  <para style="p">
    <verse number="40" style="v"/>yadā, "te nayanai rna paśyanti buddhibhiśca na budhyante tai rmanaḥsu parivarttiteṣu ca tānahaṁ yathā svasthān na karomi tathā sa teṣāṁ locanānyandhāni kṛtvā teṣāmantaḥkaraṇāni gāḍhāni kariṣyati|"</para>
  <para style="p">
    <verse number="41" style="v"/>yiśayiyo yadā yīśo rmahimānaṁ vilokya tasmin kathāmakathayat tadā bhaviṣyadvākyam īdṛśaṁ prakāśayat|</para>
  <para style="p">
    <verse number="42" style="v"/>tathāpyadhipatināṁ bahavastasmin pratyāyan| kintu phirūśinastān bhajanagṛhād dūrīkurvvantīti bhayāt te taṁ na svīkṛtavantaḥ|</para>
  <para style="p">
    <verse number="43" style="v"/>yata īśvarasya praśaṁsāto mānavānāṁ praśaṁsāyāṁ te'priyanta|</para>
  <para style="p">
    <verse number="44" style="v"/>tadā yīśuruccaiḥkāram akathayad yo jano mayi viśvasiti sa kevale mayi viśvasitīti na, sa matprerake'pi viśvasiti|</para>
  <para style="p">
    <verse number="45" style="v"/>yo jano māṁ paśyati sa matprerakamapi paśyati|</para>
  <para style="p">
    <verse number="46" style="v"/>yo jano māṁ pratyeti sa yathāndhakāre na tiṣṭhati tadartham ahaṁ jyotiḥsvarūpo bhūtvā jagatyasmin avatīrṇavān|</para>
  <para style="p">
    <verse number="47" style="v"/>mama kathāṁ śrutvā yadi kaścin na viśvasiti tarhi tamahaṁ doṣiṇaṁ na karomi, yato heto rjagato janānāṁ doṣān niścitān karttuṁ nāgatya tān paricātum āgatosmi|</para>
  <para style="p">
    <verse number="48" style="v"/>yaḥ kaścin māṁ na śraddhāya mama kathaṁ na gṛhlāti, anyastaṁ doṣiṇaṁ kariṣyati vastutastu yāṁ kathāmaham acakathaṁ sā kathā carame'nhi taṁ doṣiṇaṁ kariṣyati|</para>
  <para style="p">
    <verse number="49" style="v"/>yato hetorahaṁ svataḥ kimapi na kathayāmi, kiṁ kiṁ mayā kathayitavyaṁ kiṁ samupadeṣṭavyañca iti matprerayitā pitā māmājñāpayat|</para>
  <para style="p">
    <verse number="50" style="v"/>tasya sājñā anantāyurityahaṁ jānāmi, ataevāhaṁ yat kathayāmi tat pitā yathājñāpayat tathaiva kathayāmyaham|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>nistārotsavasya kiñcitkālāt pūrvvaṁ pṛthivyāḥ pituḥ samīpagamanasya samayaḥ sannikarṣobhūd iti jñātvā yīśurāprathamād yeṣu jagatpravāsiṣvātmīyalokeṣa prema karoti sma teṣu śeṣaṁ yāvat prema kṛtavān|</para>
  <para style="p">
    <verse number="2" style="v"/>pitā tasya haste sarvvaṁ samarpitavān svayam īśvarasya samīpād āgacchad īśvarasya samīpaṁ yāsyati ca, sarvvāṇyetāni jñātvā rajanyāṁ bhojane sampūrṇe sati,</para>
  <para style="p">
    <verse number="3" style="v"/>yadā śaitān taṁ parahasteṣu samarpayituṁ śimonaḥ putrasya īṣkāriyotiyasya yihūdā antaḥkaraṇe kupravṛttiṁ samārpayat,</para>
  <para style="p">
    <verse number="4" style="v"/>tadā yīśu rbhojanāsanād utthāya gātravastraṁ mocayitvā gātramārjanavastraṁ gṛhītvā tena svakaṭim abadhnāt,</para>
  <para style="p">
    <verse number="5" style="v"/>paścād ekapātre jalam abhiṣicya śiṣyāṇāṁ pādān prakṣālya tena kaṭibaddhagātramārjanavāsasā mārṣṭuṁ prārabhata|</para>
  <para style="p">
    <verse number="6" style="v"/>tataḥ śimonpitarasya samīpamāgate sa uktavān he prabho bhavān kiṁ mama pādau prakṣālayiṣyati?</para>
  <para style="p">
    <verse number="7" style="v"/>yīśuruditavān ahaṁ yat karomi tat samprati na jānāsi kintu paścāj jñāsyasi|</para>
  <para style="p">
    <verse number="8" style="v"/>tataḥ pitaraḥ kathitavān bhavān kadāpi mama pādau na prakṣālayiṣyati| yīśurakathayad yadi tvāṁ na prakṣālaye tarhi mayi tava kopyaṁśo nāsti|</para>
  <para style="p">
    <verse number="9" style="v"/>tadā śimonpitaraḥ kathitavān he prabho tarhi kevalapādau na, mama hastau śiraśca prakṣālayatu|</para>
  <para style="p">
    <verse number="10" style="v"/>tato yīśuravadad yo jano dhautastasya sarvvāṅgapariṣkṛtatvāt pādau vinānyāṅgasya prakṣālanāpekṣā nāsti| yūyaṁ pariṣkṛtā iti satyaṁ kintu na sarvve,</para>
  <para style="p">
    <verse number="11" style="v"/>yato yo janastaṁ parakareṣu samarpayiṣyati taṁ sa jñātavāna; ataeva yūyaṁ sarvve na pariṣkṛtā imāṁ kathāṁ kathitavān|</para>
  <para style="p">
    <verse number="12" style="v"/>itthaṁ yīśusteṣāṁ pādān prakṣālya vastraṁ paridhāyāsane samupaviśya kathitavān ahaṁ yuṣmān prati kiṁ karmmākārṣaṁ jānītha?</para>
  <para style="p">
    <verse number="13" style="v"/>yūyaṁ māṁ guruṁ prabhuñca vadatha tat satyameva vadatha yatohaṁ saeva bhavāmi|</para>
  <para style="p">
    <verse number="14" style="v"/>yadyahaṁ prabhu rguruśca san yuṣmākaṁ pādān prakṣālitavān tarhi yuṣmākamapi parasparaṁ pādaprakṣālanam ucitam|</para>
  <para style="p">
    <verse number="15" style="v"/>ahaṁ yuṣmān prati yathā vyavāharaṁ yuṣmān tathā vyavaharttum ekaṁ panthānaṁ darśitavān|</para>
  <para style="p">
    <verse number="16" style="v"/>ahaṁ yuṣmānatiyathārthaṁ vadāmi, prabho rdāso na mahān prerakācca prerito na mahān|</para>
  <para style="p">
    <verse number="17" style="v"/>imāṁ kathāṁ viditvā yadi tadanusārataḥ karmmāṇi kurutha tarhi yūyaṁ dhanyā bhaviṣyatha|</para>
  <para style="p">
    <verse number="18" style="v"/>sarvveṣu yuṣmāsu kathāmimāṁ kathayāmi iti na, ye mama manonītāstānahaṁ jānāmi, kintu mama bhakṣyāṇi yo bhuṅkte matprāṇaprātikūlyataḥ| utthāpayati pādasya mūlaṁ sa eṣa mānavaḥ|yadetad dharmmapustakasya vacanaṁ tadanusāreṇāvaśyaṁ ghaṭiṣyate|</para>
  <para style="p">
    <verse number="19" style="v"/>ahaṁ sa jana ityatra yathā yuṣmākaṁ viśvāso jāyate tadarthaṁ etādṛśaghaṭanāt pūrvvam ahamidānīṁ yuṣmabhyamakathayam|</para>
  <para style="p">
    <verse number="20" style="v"/>ahaṁ yuṣmānatīva yathārthaṁ vadāmi, mayā preritaṁ janaṁ yo gṛhlāti sa māmeva gṛhlāti yaśca māṁ gṛhlāti sa matprerakaṁ gṛhlāti|</para>
  <para style="p">
    <verse number="21" style="v"/>etāṁ kathāṁ kathayitvā yīśu rduḥkhī san pramāṇaṁ dattvā kathitavān ahaṁ yuṣmānatiyathārthaṁ vadāmi yuṣmākam eko jano māṁ parakareṣu samarpayiṣyati|</para>
  <para style="p">
    <verse number="22" style="v"/>tataḥ sa kamuddiśya kathāmetāṁ kathitavān ityatra sandigdhāḥ śiṣyāḥ parasparaṁ mukhamālokayituṁ prārabhanta|</para>
  <para style="p">
    <verse number="23" style="v"/>tasmin samaye yīśu ryasmin aprīyata sa śiṣyastasya vakṣaḥsthalam avālambata|</para>
  <para style="p">
    <verse number="24" style="v"/>śimonpitarastaṁ saṅketenāvadat, ayaṁ kamuddiśya kathāmetām kathayatīti pṛccha|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā sa yīśo rvakṣaḥsthalam avalambya pṛṣṭhavān, he prabho sa janaḥ kaḥ?</para>
  <para style="p">
    <verse number="26" style="v"/>tato yīśuḥ pratyavadad ekakhaṇḍaṁ pūpaṁ majjayitvā yasmai dāsyāmi saeva saḥ; paścāt pūpakhaṇḍamekaṁ majjayitvā śimonaḥ putrāya īṣkariyotīyāya yihūdai dattavān|</para>
  <para style="p">
    <verse number="27" style="v"/>tasmin datte sati śaitān tamāśrayat; tadā yīśustam avadat tvaṁ yat kariṣyasi tat kṣipraṁ kuru|</para>
  <para style="p">
    <verse number="28" style="v"/>kintu sa yenāśayena tāṁ kathāmakathāyat tam upaviṣṭalokānāṁ kopi nābudhyata;</para>
  <para style="p">
    <verse number="29" style="v"/>kintu yihūdāḥ samīpe mudrāsampuṭakasthiteḥ kecid ittham abudhyanta pārvvaṇāsādanārthaṁ kimapi dravyaṁ kretuṁ vā daridrebhyaḥ kiñcid vitarituṁ kathitavān|</para>
  <para style="p">
    <verse number="30" style="v"/>tadā pūpakhaṇḍagrahaṇāt paraṁ sa tūrṇaṁ bahiragacchat; rātriśca samupasyitā|</para>
  <para style="p">
    <verse number="31" style="v"/>yihūde bahirgate yīśurakathayad idānīṁ mānavasutasya mahimā prakāśate teneśvarasyāpi mahimā prakāśate|</para>
  <para style="p">
    <verse number="32" style="v"/>yadi teneśvarasya mahimā prakāśate tarhīśvaropi svena tasya mahimānaṁ prakāśayiṣyati tūrṇameva prakāśayiṣyati|</para>
  <para style="p">
    <verse number="33" style="v"/>he vatsā ahaṁ yuṣmābhiḥ sārddhaṁ kiñcitkālamātram āse, tataḥ paraṁ māṁ mṛgayiṣyadhve kintvahaṁ yatsthānaṁ yāmi tatsthānaṁ yūyaṁ gantuṁ na śakṣyatha, yāmimāṁ kathāṁ yihūdīyebhyaḥ kathitavān tathādhunā yuṣmabhyamapi kathayāmi|</para>
  <para style="p">
    <verse number="34" style="v"/>yūyaṁ parasparaṁ prīyadhvam ahaṁ yuṣmāsu yathā prīye yūyamapi parasparam tathaiva prīyadhvaṁ, yuṣmān imāṁ navīnām ājñām ādiśāmi|</para>
  <para style="p">
    <verse number="35" style="v"/>tenaiva yadi parasparaṁ prīyadhve tarhi lakṣaṇenānena yūyaṁ mama śiṣyā iti sarvve jñātuṁ śakṣyanti|</para>
  <para style="p">
    <verse number="36" style="v"/>śimonapitaraḥ pṛṣṭhavān he prabho bhavān kutra yāsyati? tato yīśuḥ pratyavadat, ahaṁ yatsthānaṁ yāmi tatsthānaṁ sāmprataṁ mama paścād gantuṁ na śaknoṣi kintu paścād gamiṣyasi|</para>
  <para style="p">
    <verse number="37" style="v"/>tadā pitaraḥ pratyuditavān, he prabho sāmprataṁ kuto hetostava paścād gantuṁ na śaknomi? tvadarthaṁ prāṇān dātuṁ śaknomi|</para>
  <para style="p">
    <verse number="38" style="v"/>tato yīśuḥ pratyuktavān mannimittaṁ kiṁ prāṇān dātuṁ śaknoṣi? tvāmahaṁ yathārthaṁ vadāmi, kukkuṭaravaṇāt pūrvvaṁ tvaṁ tri rmām apahnoṣyase|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>manoduḥkhino mā bhūta; īśvare viśvasita mayi ca viśvasita|</para>
  <para style="p">
    <verse number="2" style="v"/>mama pitu gṛhe bahūni vāsasthāni santi no cet pūrvvaṁ yuṣmān ajñāpayiṣyaṁ yuṣmadarthaṁ sthānaṁ sajjayituṁ gacchāmi|</para>
  <para style="p">
    <verse number="3" style="v"/>yadi gatvāhaṁ yuṣmannimittaṁ sthānaṁ sajjayāmi tarhi panarāgatya yuṣmān svasamīpaṁ neṣyāmi, tato yatrāhaṁ tiṣṭhāmi tatra yūyamapi sthāsyatha|</para>
  <para style="p">
    <verse number="4" style="v"/>ahaṁ yatsthānaṁ brajāmi tatsthānaṁ yūyaṁ jānītha tasya panthānamapi jānītha|</para>
  <para style="p">
    <verse number="5" style="v"/>tadā thomā avadat, he prabho bhavān kutra yāti tadvayaṁ na jānīmaḥ, tarhi kathaṁ panthānaṁ jñātuṁ śaknumaḥ?</para>
  <para style="p">
    <verse number="6" style="v"/>yīśurakathayad ahameva satyajīvanarūpapatho mayā na gantā kopi pituḥ samīpaṁ gantuṁ na śaknoti|</para>
  <para style="p">
    <verse number="7" style="v"/>yadi mām ajñāsyata tarhi mama pitaramapyajñāsyata kintvadhunātastaṁ jānītha paśyatha ca|</para>
  <para style="p">
    <verse number="8" style="v"/>tadā philipaḥ kathitavān, he prabho pitaraṁ darśaya tasmādasmākaṁ yatheṣṭaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="9" style="v"/>tato yīśuḥ pratyāvādīt, he philipa yuṣmābhiḥ sārddham etāvaddināni sthitamapi māṁ kiṁ na pratyabhijānāsi? yo jano mām apaśyat sa pitaramapyapaśyat tarhi pitaram asmān darśayeti kathāṁ kathaṁ kathayasi?</para>
  <para style="p">
    <verse number="10" style="v"/>ahaṁ pitari tiṣṭhāmi pitā mayi tiṣṭhatīti kiṁ tvaṁ na pratyaṣi? ahaṁ yadvākyaṁ vadāmi tat svato na vadāmi kintu yaḥ pitā mayi virājate sa eva sarvvakarmmāṇi karāti|</para>
  <para style="p">
    <verse number="11" style="v"/>ataeva pitaryyahaṁ tiṣṭhāmi pitā ca mayi tiṣṭhati mamāsyāṁ kathāyāṁ pratyayaṁ kuruta, no cet karmmahetoḥ pratyayaṁ kuruta|</para>
  <para style="p">
    <verse number="12" style="v"/>ahaṁ yuṣmānatiyathārthaṁ vadāmi, yo jano mayi viśvasiti sohamiva karmmāṇi kariṣyati varaṁ tatopi mahākarmmāṇi kariṣyati yato hetorahaṁ pituḥ samīpaṁ gacchāmi|</para>
  <para style="p">
    <verse number="13" style="v"/>yathā putreṇa pitu rmahimā prakāśate tadarthaṁ mama nāma procya yat prārthayiṣyadhve tat saphalaṁ kariṣyāmi|</para>
  <para style="p">
    <verse number="14" style="v"/>yadi mama nāmnā yat kiñcid yācadhve tarhi tadahaṁ sādhayiṣyāmi|</para>
  <para style="p">
    <verse number="15" style="v"/>yadi mayi prīyadhve tarhi mamājñāḥ samācarata|</para>
  <para style="p">
    <verse number="16" style="v"/>tato mayā pituḥ samīpe prārthite pitā nirantaraṁ yuṣmābhiḥ sārddhaṁ sthātum itaramekaṁ sahāyam arthāt satyamayam ātmānaṁ yuṣmākaṁ nikaṭaṁ preṣayiṣyati|</para>
  <para style="p">
    <verse number="17" style="v"/>etajjagato lokāstaṁ grahītuṁ na śaknuvanti yataste taṁ nāpaśyan nājanaṁśca kintu yūyaṁ jānītha yato hetoḥ sa yuṣmākamanta rnivasati yuṣmākaṁ madhye sthāsyati ca|</para>
  <para style="p">
    <verse number="18" style="v"/>ahaṁ yuṣmān anāthān kṛtvā na yāsyāmi punarapi yuṣmākaṁ samīpam āgamiṣyāmi|</para>
  <para style="p">
    <verse number="19" style="v"/>kiyatkālarat param asya jagato lokā māṁ puna rna drakṣyanti kintu yūyaṁ drakṣyatha;ahaṁ jīviṣyāmi tasmāt kāraṇād yūyamapi jīviṣyatha|</para>
  <para style="p">
    <verse number="20" style="v"/>pitaryyahamasmi mayi ca yūyaṁ stha, tathāhaṁ yuṣmāsvasmi tadapi tadā jñāsyatha|</para>
  <para style="p">
    <verse number="21" style="v"/>yo jano mamājñā gṛhītvā tā ācarati saeva mayi prīyate; yo janaśca mayi prīyate saeva mama pituḥ priyapātraṁ bhaviṣyati, tathāhamapi tasmin prītvā tasmai svaṁ prakāśayiṣyāmi|</para>
  <para style="p">
    <verse number="22" style="v"/>tadā īṣkariyotīyād anyo yihūdāstamavadat, he prabho bhavān jagato lokānāṁ sannidhau prakāśito na bhūtvāsmākaṁ sannidhau kutaḥ prakāśito bhaviṣyati?</para>
  <para style="p">
    <verse number="23" style="v"/>tato yīśuḥ pratyuditavān, yo jano mayi prīyate sa mamājñā api gṛhlāti, tena mama pitāpi tasmin preṣyate, āvāñca tannikaṭamāgatya tena saha nivatsyāvaḥ|</para>
  <para style="p">
    <verse number="24" style="v"/>yo jano mayi na prīyate sa mama kathā api na gṛhlāti punaśca yāmimāṁ kathāṁ yūyaṁ śṛṇutha sā kathā kevalasya mama na kintu mama prerako yaḥ pitā tasyāpi kathā|</para>
  <para style="p">
    <verse number="25" style="v"/>idānīṁ yuṣmākaṁ nikaṭe vidyamānoham etāḥ sakalāḥ kathāḥ kathayāmi|</para>
  <para style="p">
    <verse number="26" style="v"/>kintvitaḥ paraṁ pitrā yaḥ sahāyo'rthāt pavitra ātmā mama nāmni prerayiṣyati sa sarvvaṁ śikṣayitvā mayoktāḥ samastāḥ kathā yuṣmān smārayiṣyati|</para>
  <para style="p">
    <verse number="27" style="v"/>ahaṁ yuṣmākaṁ nikaṭe śāntiṁ sthāpayitvā yāmi, nijāṁ śāntiṁ yuṣmabhyaṁ dadāmi, jagato lokā yathā dadāti tathāhaṁ na dadāmi; yuṣmākam antaḥkaraṇāni duḥkhitāni bhītāni ca na bhavantu|</para>
  <para style="p">
    <verse number="28" style="v"/>ahaṁ gatvā punarapi yuṣmākaṁ samīpam āgamiṣyāmi mayoktaṁ vākyamidaṁ yūyam aśrauṣṭa; yadi mayyapreṣyadhvaṁ tarhyahaṁ pituḥ samīpaṁ gacchāmi mamāsyāṁ kathāyāṁ yūyam ahlādiṣyadhvaṁ yato mama pitā mattopi mahān|</para>
  <para style="p">
    <verse number="29" style="v"/>tasyā ghaṭanāyāḥ samaye yathā yuṣmākaṁ śraddhā jāyate tadartham ahaṁ tasyā ghaṭanāyāḥ pūrvvam idānīṁ yuṣmān etāṁ vārttāṁ vadāmi|</para>
  <para style="p">
    <verse number="30" style="v"/>itaḥ paraṁ yuṣmābhiḥ saha mama bahava ālāpā na bhaviṣyanti yataḥ kāraṇād etasya jagataḥ patirāgacchati kintu mayā saha tasya kopi sambandho nāsti|</para>
  <para style="p">
    <verse number="31" style="v"/>ahaṁ pitari prema karomi tathā pitu rvidhivat karmmāṇi karomīti yena jagato lokā jānanti tadartham uttiṣṭhata vayaṁ sthānādasmād gacchāma|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ahaṁ satyadrākṣālatāsvarūpo mama pitā tūdyānaparicārakasvarūpañca|</para>
  <para style="p">
    <verse number="2" style="v"/>mama yāsu śākhāsu phalāni na bhavanti tāḥ sa chinatti tathā phalavatyaḥ śākhā yathādhikaphalāni phalanti tadarthaṁ tāḥ pariṣkaroti|</para>
  <para style="p">
    <verse number="3" style="v"/>idānīṁ mayoktopadeśena yūyaṁ pariṣkṛtāḥ|</para>
  <para style="p">
    <verse number="4" style="v"/>ataḥ kāraṇāt mayi tiṣṭhata tenāhamapi yuṣmāsu tiṣṭhāmi, yato heto rdrākṣālatāyām asaṁlagnā śākhā yathā phalavatī bhavituṁ na śaknoti tathā yūyamapi mayyatiṣṭhantaḥ phalavanto bhavituṁ na śaknutha|</para>
  <para style="p">
    <verse number="5" style="v"/>ahaṁ drākṣālatāsvarūpo yūyañca śākhāsvarūpoḥ; yo jano mayi tiṣṭhati yatra cāhaṁ tiṣṭhāmi, sa pracūraphalaiḥ phalavān bhavati, kintu māṁ vinā yūyaṁ kimapi karttuṁ na śaknutha|</para>
  <para style="p">
    <verse number="6" style="v"/>yaḥ kaścin mayi na tiṣṭhati sa śuṣkaśākheva bahi rnikṣipyate lokāśca tā āhṛtya vahnau nikṣipya dāhayanti|</para>
  <para style="p">
    <verse number="7" style="v"/>yadi yūyaṁ mayi tiṣṭhatha mama kathā ca yuṣmāsu tiṣṭhati tarhi yad vāñchitvā yāciṣyadhve yuṣmākaṁ tadeva saphalaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="8" style="v"/>yadi yūyaṁ pracūraphalavanto bhavatha tarhi tadvārā mama pitu rmahimā prakāśiṣyate tathā yūyaṁ mama śiṣyā iti parikṣāyiṣyadhve|</para>
  <para style="p">
    <verse number="9" style="v"/>pitā yathā mayi prītavān ahamapi yuṣmāsu tathā prītavān ato heto ryūyaṁ nirantaraṁ mama premapātrāṇi bhūtvā tiṣṭhata|</para>
  <para style="p">
    <verse number="10" style="v"/>ahaṁ yathā piturājñā gṛhītvā tasya premabhājanaṁ tiṣṭhāmi tathaiva yūyamapi yadi mamājñā guhlītha tarhi mama premabhājanāni sthāsyatha|</para>
  <para style="p">
    <verse number="11" style="v"/>yuṣmannimittaṁ mama ya āhlādaḥ sa yathā ciraṁ tiṣṭhati yuṣmākam ānandaśca yathā pūryyate tadarthaṁ yuṣmabhyam etāḥ kathā atrakatham|</para>
  <para style="p">
    <verse number="12" style="v"/>ahaṁ yuṣmāsu yathā prīye yūyamapi parasparaṁ tathā prīyadhvam eṣā mamājñā|</para>
  <para style="p">
    <verse number="13" style="v"/>mitrāṇāṁ kāraṇāt svaprāṇadānaparyyantaṁ yat prema tasmān mahāprema kasyāpi nāsti|</para>
  <para style="p">
    <verse number="14" style="v"/>ahaṁ yadyad ādiśāmi tattadeva yadi yūyam ācarata tarhi yūyameva mama mitrāṇi|</para>
  <para style="p">
    <verse number="15" style="v"/>adyārabhya yuṣmān dāsān na vadiṣyāmi yat prabhu ryat karoti dāsastad na jānāti; kintu pituḥ samīpe yadyad aśṛṇavaṁ tat sarvvaṁ yūṣmān ajñāpayam tatkāraṇād yuṣmān mitrāṇi proktavān|</para>
  <para style="p">
    <verse number="16" style="v"/>yūyaṁ māṁ rocitavanta iti na, kintvahameva yuṣmān rocitavān yūyaṁ gatvā yathā phalānyutpādayatha tāni phalāni cākṣayāṇi bhavanti, tadarthaṁ yuṣmān nyajunajaṁ tasmān mama nāma procya pitaraṁ yat kiñcid yāciṣyadhve tadeva sa yuṣmabhyaṁ dāsyati|</para>
  <para style="p">
    <verse number="17" style="v"/>yūyaṁ parasparaṁ prīyadhvam aham ityājñāpayāmi|</para>
  <para style="p">
    <verse number="18" style="v"/>jagato lokai ryuṣmāsu ṛtīyiteṣu te pūrvvaṁ māmevārttīyanta iti yūyaṁ jānītha|</para>
  <para style="p">
    <verse number="19" style="v"/>yadi yūyaṁ jagato lokā abhaviṣyata tarhi jagato lokā yuṣmān ātmīyān buddhvāpreṣyanta; kintu yūyaṁ jagato lokā na bhavatha, ahaṁ yuṣmān asmājjagato'rocayam etasmāt kāraṇājjagato lokā yuṣmān ṛtīyante|</para>
  <para style="p">
    <verse number="20" style="v"/>dāsaḥ prabho rmahān na bhavati mamaitat pūrvvīyaṁ vākyaṁ smarata; te yadi māmevātāḍayan tarhi yuṣmānapi tāḍayiṣyanti, yadi mama vākyaṁ gṛhlanti tarhi yuṣmākamapi vākyaṁ grahīṣyanti|</para>
  <para style="p">
    <verse number="21" style="v"/>kintu te mama nāmakāraṇād yuṣmān prati tādṛśaṁ vyavahariṣyanti yato yo māṁ preritavān taṁ te na jānanti|</para>
  <para style="p">
    <verse number="22" style="v"/>teṣāṁ sannidhim āgatya yadyahaṁ nākathayiṣyaṁ tarhi teṣāṁ pāpaṁ nābhaviṣyat kintvadhunā teṣāṁ pāpamācchādayitum upāyo nāsti|</para>
  <para style="p">
    <verse number="23" style="v"/>yo jano mām ṛtīyate sa mama pitaramapi ṛtīyate|</para>
  <para style="p">
    <verse number="24" style="v"/>yādṛśāni karmmāṇi kenāpi kadāpi nākriyanta tādṛśāni karmmāṇi yadi teṣāṁ sākṣād ahaṁ nākariṣyaṁ tarhi teṣāṁ pāpaṁ nābhaviṣyat kintvadhunā te dṛṣṭvāpi māṁ mama pitarañcārttīyanta|</para>
  <para style="p">
    <verse number="25" style="v"/>tasmāt te'kāraṇaṁ mām ṛtīyante yadetad vacanaṁ teṣāṁ śāstre likhitamāste tat saphalam abhavat|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu pitu rnirgataṁ yaṁ sahāyamarthāt satyamayam ātmānaṁ pituḥ samīpād yuṣmākaṁ samīpe preṣayiṣyāmi sa āgatya mayi pramāṇaṁ dāsyati|</para>
  <para style="p">
    <verse number="27" style="v"/>yūyaṁ prathamamārabhya mayā sārddhaṁ tiṣṭhatha tasmāddheto ryūyamapi pramāṇaṁ dāsyatha|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yuṣmākaṁ yathā vādhā na jāyate tadarthaṁ yuṣmān etāni sarvvavākyāni vyāharaṁ|</para>
  <para style="p">
    <verse number="2" style="v"/>lokā yuṣmān bhajanagṛhebhyo dūrīkariṣyanti tathā yasmin samaye yuṣmān hatvā īśvarasya tuṣṭi janakaṁ karmmākurmma iti maṁsyante sa samaya āgacchanti|</para>
  <para style="p">
    <verse number="3" style="v"/>te pitaraṁ māñca na jānanti, tasmād yuṣmān pratīdṛśam ācariṣyanti|</para>
  <para style="p">
    <verse number="4" style="v"/>ato hetāḥ samaye samupasthite yathā mama kathā yuṣmākaṁ manaḥsuḥ samupatiṣṭhati tadarthaṁ yuṣmābhyam etāṁ kathāṁ kathayāmi yuṣmābhiḥ sārddham ahaṁ tiṣṭhan prathamaṁ tāṁ yuṣmabhyaṁ nākathayaṁ|</para>
  <para style="p">
    <verse number="5" style="v"/>sāmprataṁ svasya prerayituḥ samīpaṁ gacchāmi tathāpi tvaṁ kka gacchasi kathāmetāṁ yuṣmākaṁ kopi māṁ na pṛcchati|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu mayoktābhirābhiḥ kathābhi ryūṣmākam antaḥkaraṇāni duḥkhena pūrṇānyabhavan|</para>
  <para style="p">
    <verse number="7" style="v"/>tathāpyahaṁ yathārthaṁ kathayāmi mama gamanaṁ yuṣmākaṁ hitārthameva, yato heto rgamane na kṛte sahāyo yuṣmākaṁ samīpaṁ nāgamiṣyati kintu yadi gacchāmi tarhi yuṣmākaṁ samīpe taṁ preṣayiṣyāmi|</para>
  <para style="p">
    <verse number="8" style="v"/>tataḥ sa āgatya pāpapuṇyadaṇḍeṣu jagato lokānāṁ prabodhaṁ janayiṣyati|</para>
  <para style="p">
    <verse number="9" style="v"/>te mayi na viśvasanti tasmāddhetoḥ pāpaprabodhaṁ janayiṣyati|</para>
  <para style="p">
    <verse number="10" style="v"/>yuṣmākam adṛśyaḥ sannahaṁ pituḥ samīpaṁ gacchāmi tasmād puṇye prabodhaṁ janayiṣyati|</para>
  <para style="p">
    <verse number="11" style="v"/>etajjagato'dhipati rdaṇḍājñāṁ prāpnoti tasmād daṇḍe prabodhaṁ janayiṣyati|</para>
  <para style="p">
    <verse number="12" style="v"/>yuṣmabhyaṁ kathayituṁ mamānekāḥ kathā āsate, tāḥ kathā idānīṁ yūyaṁ soḍhuṁ na śaknutha;</para>
  <para style="p">
    <verse number="13" style="v"/>kintu satyamaya ātmā yadā samāgamiṣyati tadā sarvvaṁ satyaṁ yuṣmān neṣyati, sa svataḥ kimapi na vadiṣyati kintu yacchroṣyati tadeva kathayitvā bhāvikāryyaṁ yuṣmān jñāpayiṣyati|</para>
  <para style="p">
    <verse number="14" style="v"/>mama mahimānaṁ prakāśayiṣyati yato madīyāṁ kathāṁ gṛhītvā yuṣmān bodhayiṣyati|</para>
  <para style="p">
    <verse number="15" style="v"/>pitu ryadyad āste tat sarvvaṁ mama tasmād kāraṇād avādiṣaṁ sa madīyāṁ kathāṁ gṛhītvā yuṣmān bodhayiṣyati|</para>
  <para style="p">
    <verse number="16" style="v"/>kiyatkālāt paraṁ yūyaṁ māṁ draṣṭuṁ na lapsyadhve kintu kiyatkālāt paraṁ puna rdraṣṭuṁ lapsyadhve yatohaṁ pituḥ samīpaṁ gacchāmi|</para>
  <para style="p">
    <verse number="17" style="v"/>tataḥ śiṣyāṇāṁ kiyanto janāḥ parasparaṁ vaditum ārabhanta, kiyatkālāt paraṁ māṁ draṣṭuṁ na lapsyadhve kintu kiyatkālāt paraṁ puna rdraṣṭuṁ lapsyadhve yatohaṁ pituḥ samīpaṁ gacchāmi, iti yad vākyam ayaṁ vadati tat kiṁ?</para>
  <para style="p">
    <verse number="18" style="v"/>tataḥ kiyatkālāt param iti tasya vākyaṁ kiṁ? tasya vākyasyābhiprāyaṁ vayaṁ boddhuṁ na śaknumastairiti</para>
  <para style="p">
    <verse number="19" style="v"/>nigadite yīśusteṣāṁ praśnecchāṁ jñātvā tebhyo'kathayat kiyatkālāt paraṁ māṁ draṣṭuṁ na lapsyadhve, kintu kiyatkālāt paraṁ pūna rdraṣṭuṁ lapsyadhve, yāmimāṁ kathāmakathayaṁ tasyā abhiprāyaṁ kiṁ yūyaṁ parasparaṁ mṛgayadhve?</para>
  <para style="p">
    <verse number="20" style="v"/>yuṣmānaham atiyathārthaṁ vadāmi yūyaṁ krandiṣyatha vilapiṣyatha ca, kintu jagato lokā ānandiṣyanti; yūyaṁ śokākulā bhaviṣyatha kintu śokāt paraṁ ānandayuktā bhaviṣyatha|</para>
  <para style="p">
    <verse number="21" style="v"/>prasavakāla upasthite nārī yathā prasavavedanayā vyākulā bhavati kintu putre bhūmiṣṭhe sati manuṣyaiko janmanā naraloke praviṣṭa ityānandāt tasyāstatsarvvaṁ duḥkhaṁ manasi na tiṣṭhati,</para>
  <para style="p">
    <verse number="22" style="v"/>tathā yūyamapi sāmprataṁ śokākulā bhavatha kintu punarapi yuṣmabhyaṁ darśanaṁ dāsyāmi tena yuṣmākam antaḥkaraṇāni sānandāni bhaviṣyanti, yuṣmākaṁ tam ānandañca kopi harttuṁ na śakṣyati|</para>
  <para style="p">
    <verse number="23" style="v"/>tasmin divase kāmapi kathāṁ māṁ na prakṣyatha| yuṣmānaham atiyathārthaṁ vadāmi, mama nāmnā yat kiñcid pitaraṁ yāciṣyadhve tadeva sa dāsyati|</para>
  <para style="p">
    <verse number="24" style="v"/>pūrvve mama nāmnā kimapi nāyācadhvaṁ, yācadhvaṁ tataḥ prāpsyatha tasmād yuṣmākaṁ sampūrṇānando janiṣyate|</para>
  <para style="p">
    <verse number="25" style="v"/>upamākathābhiḥ sarvvāṇyetāni yuṣmān jñāpitavān kintu yasmin samaye upamayā noktvā pituḥ kathāṁ spaṣṭaṁ jñāpayiṣyāmi samaya etādṛśa āgacchati|</para>
  <para style="p">
    <verse number="26" style="v"/>tadā mama nāmnā prārthayiṣyadhve 'haṁ yuṣmannimittaṁ pitaraṁ vineṣye kathāmimāṁ na vadāmi;</para>
  <para style="p">
    <verse number="27" style="v"/>yato yūyaṁ mayi prema kurutha, tathāham īśvarasya samīpād āgatavān ityapi pratītha, tasmād kāraṇāt kāraṇāt pitā svayaṁ yuṣmāsu prīyate|</para>
  <para style="p">
    <verse number="28" style="v"/>pituḥ samīpājjajad āgatosmi jagat parityajya ca punarapi pituḥ samīpaṁ gacchāmi|</para>
  <para style="p">
    <verse number="29" style="v"/>tadā śiṣyā avadan, he prabho bhavān upamayā noktvādhunā spaṣṭaṁ vadati|</para>
  <para style="p">
    <verse number="30" style="v"/>bhavān sarvvajñaḥ kenacit pṛṣṭo bhavitumapi bhavataḥ prayojanaṁ nāstītyadhunāsmākaṁ sthirajñānaṁ jātaṁ tasmād bhavān īśvarasya samīpād āgatavān ityatra vayaṁ viśvasimaḥ|</para>
  <para style="p">
    <verse number="31" style="v"/>tato yīśuḥ pratyavādīd idānīṁ kiṁ yūyaṁ viśvasitha?</para>
  <para style="p">
    <verse number="32" style="v"/>paśyata sarvve yūyaṁ vikīrṇāḥ santo mām ekākinaṁ pīratyajya svaṁ svaṁ sthānaṁ gamiṣyatha, etādṛśaḥ samaya āgacchati varaṁ prāyeṇopasthitavān; tathāpyahaṁ naikākī bhavāmi yataḥ pitā mayā sārddham āste|</para>
  <para style="p">
    <verse number="33" style="v"/>yathā mayā yuṣmākaṁ śānti rjāyate tadartham etāḥ kathā yuṣmabhyam acakathaṁ; asmin jagati yuṣmākaṁ kleśo ghaṭiṣyate kintvakṣobhā bhavata yato mayā jagajjitaṁ|</para>
  <chapter number="17" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ paraṁ yīśuretāḥ kathāḥ kathayitvā svargaṁ vilokyaitat prārthayat, he pitaḥ samaya upasthitavān; yathā tava putrastava mahimānaṁ prakāśayati tadarthaṁ tvaṁ nijaputrasya mahimānaṁ prakāśaya|</para>
  <para style="p">
    <verse number="2" style="v"/>tvaṁ yollokān tasya haste samarpitavān sa yathā tebhyo'nantāyu rdadāti tadarthaṁ tvaṁ prāṇimātrāṇām adhipatitvabhāraṁ tasmai dattavān|</para>
  <para style="p">
    <verse number="3" style="v"/>yastvam advitīyaḥ satya īśvarastvayā preritaśca yīśuḥ khrīṣṭa etayorubhayoḥ paricaye prāpte'nantāyu rbhavati|</para>
  <para style="p">
    <verse number="4" style="v"/>tvaṁ yasya karmmaṇo bhāraṁ mahyaṁ dattavān, tat sampannaṁ kṛtvā jagatyasmin tava mahimānaṁ prākāśayaṁ|</para>
  <para style="p">
    <verse number="5" style="v"/>ataeva he pita rjagatyavidyamāne tvayā saha tiṣṭhato mama yo mahimāsīt samprati tava samīpe māṁ taṁ mahimānaṁ prāpaya|</para>
  <para style="p">
    <verse number="6" style="v"/>anyacca tvam etajjagato yāllokān mahyam adadā ahaṁ tebhyastava nāmnastattvajñānam adadāṁ, te tavaivāsan, tvaṁ tān mahyamadadāḥ, tasmātte tavopadeśam agṛhlan|</para>
  <para style="p">
    <verse number="7" style="v"/>tvaṁ mahyaṁ yat kiñcid adadāstatsarvvaṁ tvatto jāyate ityadhunājānan|</para>
  <para style="p">
    <verse number="8" style="v"/>mahyaṁ yamupadeśam adadā ahamapi tebhyastamupadeśam adadāṁ tepi tamagṛhlan tvattohaṁ nirgatya tvayā preritobhavam atra ca vyaśvasan|</para>
  <para style="p">
    <verse number="9" style="v"/>teṣāmeva nimittaṁ prārthaye'haṁ jagato lokanimittaṁ na prārthaye kintu yāllokān mahyam adadāsteṣāmeva nimittaṁ prārthaye'haṁ yataste tavaivāsate|</para>
  <para style="p">
    <verse number="10" style="v"/>ye mama te tava ye ca tava te mama tathā tai rmama mahimā prakāśyate|</para>
  <para style="p">
    <verse number="11" style="v"/>sāmpratam asmin jagati mamāvasthiteḥ śeṣam abhavat ahaṁ tava samīpaṁ gacchāmi kintu te jagati sthāsyanti; he pavitra pitarāvayo ryathaikatvamāste tathā teṣāmapyekatvaṁ bhavati tadarthaṁ yāllokān mahyam adadāstān svanāmnā rakṣa|</para>
  <para style="p">
    <verse number="12" style="v"/>yāvanti dināni jagatyasmin taiḥ sahāhamāsaṁ tāvanti dināni tān tava nāmnāhaṁ rakṣitavān; yāllokān mahyam adadāstān sarvvān ahamarakṣaṁ, teṣāṁ madhye kevalaṁ vināśapātraṁ hāritaṁ tena dharmmapustakasya vacanaṁ pratyakṣaṁ bhavati|</para>
  <para style="p">
    <verse number="13" style="v"/>kintvadhunā tava sannidhiṁ gacchāmi mayā yathā teṣāṁ sampūrṇānando bhavati tadarthamahaṁ jagati tiṣṭhan etāḥ kathā akathayam|</para>
  <para style="p">
    <verse number="14" style="v"/>tavopadeśaṁ tebhyo'dadāṁ jagatā saha yathā mama sambandho nāsti tathā jajatā saha teṣāmapi sambandhābhāvāj jagato lokāstān ṛtīyante|</para>
  <para style="p">
    <verse number="15" style="v"/>tvaṁ jagatastān gṛhāṇeti na prārthaye kintvaśubhād rakṣeti prārthayeham|</para>
  <para style="p">
    <verse number="16" style="v"/>ahaṁ yathā jagatsambandhīyo na bhavāmi tathā tepi jagatsambandhīyā na bhavanti|</para>
  <para style="p">
    <verse number="17" style="v"/>tava satyakathayā tān pavitrīkuru tava vākyameva satyaṁ|</para>
  <para style="p">
    <verse number="18" style="v"/>tvaṁ yathā māṁ jagati prairayastathāhamapi tān jagati prairayaṁ|</para>
  <para style="p">
    <verse number="19" style="v"/>teṣāṁ hitārthaṁ yathāhaṁ svaṁ pavitrīkaromi tathā satyakathayā tepi pavitrībhavantu|</para>
  <para style="p">
    <verse number="20" style="v"/>kevalaṁ eteṣāmarthe prārthaye'ham iti na kintveteṣāmupadeśena ye janā mayi viśvasiṣyanti teṣāmapyarthe prārtheye'ham|</para>
  <para style="p">
    <verse number="21" style="v"/>he pitasteṣāṁ sarvveṣām ekatvaṁ bhavatu tava yathā mayi mama ca yathā tvayyekatvaṁ tathā teṣāmapyāvayorekatvaṁ bhavatu tena tvaṁ māṁ preritavān iti jagato lokāḥ pratiyantu|</para>
  <para style="p">
    <verse number="22" style="v"/>yathāvayorekatvaṁ tathā teṣāmapyekatvaṁ bhavatu teṣvahaṁ mayi ca tvam itthaṁ teṣāṁ sampūrṇamekatvaṁ bhavatu, tvaṁ preritavān tvaṁ mayi yathā prīyase ca tathā teṣvapi prītavān etadyathā jagato lokā jānanti</para>
  <para style="p">
    <verse number="23" style="v"/>tadarthaṁ tvaṁ yaṁ mahimānaṁ mahyam adadāstaṁ mahimānam ahamapi tebhyo dattavān|</para>
  <para style="p">
    <verse number="24" style="v"/>he pita rjagato nirmmāṇāt pūrvvaṁ mayi snehaṁ kṛtvā yaṁ mahimānaṁ dattavān mama taṁ mahimānaṁ yathā te paśyanti tadarthaṁ yāllokān mahyaṁ dattavān ahaṁ yatra tiṣṭhāmi tepi yathā tatra tiṣṭhanti mamaiṣā vāñchā|</para>
  <para style="p">
    <verse number="25" style="v"/>he yathārthika pita rjagato lokaistvayyajñātepi tvāmahaṁ jāne tvaṁ māṁ preritavān itīme śiṣyā jānanti|</para>
  <para style="p">
    <verse number="26" style="v"/>yathāhaṁ teṣu tiṣṭhāmi tathā mayi yena premnā premākarostat teṣu tiṣṭhati tadarthaṁ tava nāmāhaṁ tān jñāpitavān punarapi jñāpayiṣyāmi|</para>
  <chapter number="18" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tāḥ kathāḥ kathayitvā yīśuḥ śiṣyānādāya kidronnāmakaṁ srota uttīryya śiṣyaiḥ saha tatratyodyānaṁ prāviśat|</para>
  <para style="p">
    <verse number="2" style="v"/>kintu viśvāsaghātiyihūdāstat sthānaṁ paricīyate yato yīśuḥ śiṣyaiḥ sārddhaṁ kadācit tat sthānam agacchat|</para>
  <para style="p">
    <verse number="3" style="v"/>tadā sa yihūdāḥ sainyagaṇaṁ pradhānayājakānāṁ phirūśināñca padātigaṇañca gṛhītvā pradīpān ulkān astrāṇi cādāya tasmin sthāna upasthitavān|</para>
  <para style="p">
    <verse number="4" style="v"/>svaṁ prati yad ghaṭiṣyate taj jñātvā yīśuragresaraḥ san tānapṛcchat kaṁ gaveṣayatha?</para>
  <para style="p">
    <verse number="5" style="v"/>te pratyavadan, nāsaratīyaṁ yīśuṁ; tato yīśuravādīd ahameva saḥ; taiḥ saha viśvāsaghātī yihūdāścātiṣṭhat|</para>
  <para style="p">
    <verse number="6" style="v"/>tadāhameva sa tasyaitāṁ kathāṁ śrutvaiva te paścādetya bhūmau patitāḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>tato yīśuḥ punarapi pṛṣṭhavān kaṁ gaveṣayatha? tataste pratyavadan nāsaratīyaṁ yīśuṁ|</para>
  <para style="p">
    <verse number="8" style="v"/>tadā yīśuḥ pratyuditavān ahameva sa imāṁ kathāmacakatham; yadi māmanvicchatha tarhīmān gantuṁ mā vārayata|</para>
  <para style="p">
    <verse number="9" style="v"/>itthaṁ bhūte mahyaṁ yāllokān adadāsteṣām ekamapi nāhārayam imāṁ yāṁ kathāṁ sa svayamakathayat sā kathā saphalā jātā|</para>
  <para style="p">
    <verse number="10" style="v"/>tadā śimonpitarasya nikaṭe khaṅgalsthiteḥ sa taṁ niṣkoṣaṁ kṛtvā mahāyājakasya mālkhanāmānaṁ dāsam āhatya tasya dakṣiṇakarṇaṁ chinnavān|</para>
  <para style="p">
    <verse number="11" style="v"/>tato yīśuḥ pitaram avadat, khaṅgaṁ koṣe sthāpaya mama pitā mahyaṁ pātuṁ yaṁ kaṁsam adadāt tenāhaṁ kiṁ na pāsyāmi?</para>
  <para style="p">
    <verse number="12" style="v"/>tadā sainyagaṇaḥ senāpati ryihūdīyānāṁ padātayaśca yīśuṁ ghṛtvā baddhvā hānannāmnaḥ kiyaphāḥ śvaśurasya samīpaṁ prathamam anayan|</para>
  <para style="p">
    <verse number="13" style="v"/>sa kiyaphāstasmin vatsare mahāyājatvapade niyuktaḥ</para>
  <para style="p">
    <verse number="14" style="v"/>san sādhāraṇalokānāṁ maṅgalārtham ekajanasya maraṇamucitam iti yihūdīyaiḥ sārddham amantrayat|</para>
  <para style="p">
    <verse number="15" style="v"/>tadā śimonpitaro'nyaikaśiṣyaśca yīśoḥ paścād agacchatāṁ tasyānyaśiṣyasya mahāyājakena paricitatvāt sa yīśunā saha mahāyājakasyāṭṭālikāṁ prāviśat|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu pitaro bahirdvārasya samīpe'tiṣṭhad ataeva mahāyājakena paricitaḥ sa śiṣyaḥ punarbahirgatvā dauvāyikāyai kathayitvā pitaram abhyantaram ānayat|</para>
  <para style="p">
    <verse number="17" style="v"/>tadā sa dvārarakṣikā pitaram avadat tvaṁ kiṁ na tasya mānavasya śiṣyaḥ? tataḥ sovadad ahaṁ na bhavāmi|</para>
  <para style="p">
    <verse number="18" style="v"/>tataḥ paraṁ yatsthāne dāsāḥ padātayaśca śītahetoraṅgārai rvahniṁ prajvālya tāpaṁ sevitavantastatsthāne pitarastiṣṭhan taiḥ saha vahnitāpaṁ sevitum ārabhata|</para>
  <para style="p">
    <verse number="19" style="v"/>tadā śiṣyeṣūpadeśe ca mahāyājakena yīśuḥ pṛṣṭaḥ</para>
  <para style="p">
    <verse number="20" style="v"/>san pratyuktavān sarvvalokānāṁ samakṣaṁ kathāmakathayaṁ guptaṁ kāmapi kathāṁ na kathayitvā yat sthānaṁ yihūdīyāḥ satataṁ gacchanti tatra bhajanagehe mandire cāśikṣayaṁ|</para>
  <para style="p">
    <verse number="21" style="v"/>mattaḥ kutaḥ pṛcchasi? ye janā madupadeśam aśṛṇvan tāneva pṛccha yadyad avadaṁ te tat jāninta|</para>
  <para style="p">
    <verse number="22" style="v"/>tadetthaṁ pratyuditatvāt nikaṭasthapadāti ryīśuṁ capeṭenāhatya vyāharat mahāyājakam evaṁ prativadasi?</para>
  <para style="p">
    <verse number="23" style="v"/>tato yīśuḥ pratigaditavān yadyayathārtham acakathaṁ tarhi tasyāyathārthasya pramāṇaṁ dehi, kintu yadi yathārthaṁ tarhi kuto heto rmām atāḍayaḥ?</para>
  <para style="p">
    <verse number="24" style="v"/>pūrvvaṁ hānan sabandhanaṁ taṁ kiyaphāmahāyājakasya samīpaṁ praiṣayat|</para>
  <para style="p">
    <verse number="25" style="v"/>śimonpitarastiṣṭhan vahnitāpaṁ sevate, etasmin samaye kiyantastam apṛcchan tvaṁ kim etasya janasya śiṣyo na? tataḥ sopahnutyābravīd ahaṁ na bhavāmi|</para>
  <para style="p">
    <verse number="26" style="v"/>tadā mahāyājakasya yasya dāsasya pitaraḥ karṇamacchinat tasya kuṭumbaḥ pratyuditavān udyāne tena saha tiṣṭhantaṁ tvāṁ kiṁ nāpaśyaṁ?</para>
  <para style="p">
    <verse number="27" style="v"/>kintu pitaraḥ punarapahnutya kathitavān; tadānīṁ kukkuṭo'raut|</para>
  <para style="p">
    <verse number="28" style="v"/>tadanantaraṁ pratyūṣe te kiyaphāgṛhād adhipate rgṛhaṁ yīśum anayan kintu yasmin aśucitve jāte tai rnistārotsave na bhoktavyaṁ, tasya bhayād yihūdīyāstadgṛhaṁ nāviśan|</para>
  <para style="p">
    <verse number="29" style="v"/>aparaṁ pīlāto bahirāgatya tān pṛṣṭhavān etasya manuṣyasya kaṁ doṣaṁ vadatha?</para>
  <para style="p">
    <verse number="30" style="v"/>tadā te petyavadan duṣkarmmakāriṇi na sati bhavataḥ samīpe nainaṁ samārpayiṣyāmaḥ|</para>
  <para style="p">
    <verse number="31" style="v"/>tataḥ pīlāto'vadad yūyamenaṁ gṛhītvā sveṣāṁ vyavasthayā vicārayata| tadā yihūdīyāḥ pratyavadan kasyāpi manuṣyasya prāṇadaṇḍaṁ karttuṁ nāsmākam adhikāro'sti|</para>
  <para style="p">
    <verse number="32" style="v"/>evaṁ sati yīśuḥ svasya mṛtyau yāṁ kathāṁ kathitavān sā saphalābhavat|</para>
  <para style="p">
    <verse number="33" style="v"/>tadanantaraṁ pīlātaḥ punarapi tad rājagṛhaṁ gatvā yīśumāhūya pṛṣṭavān tvaṁ kiṁ yihūdīyānāṁ rājā?</para>
  <para style="p">
    <verse number="34" style="v"/>yīśuḥ pratyavadat tvam etāṁ kathāṁ svataḥ kathayasi kimanyaḥ kaścin mayi kathitavān?</para>
  <para style="p">
    <verse number="35" style="v"/>pīlāto'vadad ahaṁ kiṁ yihūdīyaḥ? tava svadeśīyā viśeṣataḥ pradhānayājakā mama nikaṭe tvāṁ samārpayana, tvaṁ kiṁ kṛtavān?</para>
  <para style="p">
    <verse number="36" style="v"/>yīśuḥ pratyavadat mama rājyam etajjagatsambandhīyaṁ na bhavati yadi mama rājyaṁ jagatsambandhīyam abhaviṣyat tarhi yihūdīyānāṁ hasteṣu yathā samarpito nābhavaṁ tadarthaṁ mama sevakā ayotsyan kintu mama rājyam aihikaṁ na|</para>
  <para style="p">
    <verse number="37" style="v"/>tadā pīlātaḥ kathitavān, tarhi tvaṁ rājā bhavasi? yīśuḥ pratyuktavān tvaṁ satyaṁ kathayasi, rājāhaṁ bhavāmi; satyatāyāṁ sākṣyaṁ dātuṁ janiṁ gṛhītvā jagatyasmin avatīrṇavān, tasmāt satyadharmmapakṣapātino mama kathāṁ śṛṇvanti|</para>
  <para style="p">
    <verse number="38" style="v"/>tadā satyaṁ kiṁ? etāṁ kathāṁ paṣṭvā pīlātaḥ punarapi bahirgatvā yihūdīyān abhāṣata, ahaṁ tasya kamapyaparādhaṁ na prāpnomi|</para>
  <para style="p">
    <verse number="39" style="v"/>nistārotsavasamaye yuṣmābhirabhirucita eko jano mayā mocayitavya eṣā yuṣmākaṁ rītirasti, ataeva yuṣmākaṁ nikaṭe yihūdīyānāṁ rājānaṁ kiṁ mocayāmi, yuṣmākam icchā kā?</para>
  <para style="p">
    <verse number="40" style="v"/>tadā te sarvve ruvanto vyāharan enaṁ mānuṣaṁ nahi barabbāṁ mocaya| kintu sa barabbā dasyurāsīt|</para>
  <chapter number="19" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>pīlāto yīśum ānīya kaśayā prāhārayat|</para>
  <para style="p">
    <verse number="2" style="v"/>paścāt senāgaṇaḥ kaṇṭakanirmmitaṁ mukuṭaṁ tasya mastake samarpya vārttākīvarṇaṁ rājaparicchadaṁ paridhāpya,</para>
  <para style="p">
    <verse number="3" style="v"/>he yihūdīyānāṁ rājan namaskāra ityuktvā taṁ capeṭenāhantum ārabhata|</para>
  <para style="p">
    <verse number="4" style="v"/>tadā pīlātaḥ punarapi bahirgatvā lokān avadat, asya kamapyaparādhaṁ na labhe'haṁ, paśyata tad yuṣmān jñāpayituṁ yuṣmākaṁ sannidhau bahirenam ānayāmi|</para>
  <para style="p">
    <verse number="5" style="v"/>tataḥ paraṁ yīśuḥ kaṇṭakamukuṭavān vārttākīvarṇavasanavāṁśca bahirāgacchat| tataḥ pīlāta uktavān enaṁ manuṣyaṁ paśyata|</para>
  <para style="p">
    <verse number="6" style="v"/>tadā pradhānayājakāḥ padātayaśca taṁ dṛṣṭvā, enaṁ kruśe vidha, enaṁ kruśe vidha, ityuktvā ravituṁ ārabhanta| tataḥ pīlātaḥ kathitavān yūyaṁ svayam enaṁ nītvā kruśe vidhata, aham etasya kamapyaparādhaṁ na prāptavān|</para>
  <para style="p">
    <verse number="7" style="v"/>yihūdīyāḥ pratyavadan asmākaṁ yā vyavasthāste tadanusāreṇāsya prāṇahananam ucitaṁ yatoyaṁ svam īśvarasya putramavadat|</para>
  <para style="p">
    <verse number="8" style="v"/>pīlāta imāṁ kathāṁ śrutvā mahātrāsayuktaḥ</para>
  <para style="p">
    <verse number="9" style="v"/>san punarapi rājagṛha āgatya yīśuṁ pṛṣṭavān tvaṁ kutratyo lokaḥ? kintu yīśastasya kimapi pratyuttaraṁ nāvadat|</para>
  <para style="p">
    <verse number="10" style="v"/>1# tataḥ pīlāt kathitavāna tvaṁ kiṁ mayā sārddhaṁ na saṁlapiṣyasi ? tvāṁ kruśe vedhituṁ vā mocayituṁ śakti rmamāste iti kiṁ tvaṁ na jānāsi ? tadā yīśuḥ pratyavadad īśvareṇādaŸाṁ mamopari tava kimapyadhipatitvaṁ na vidyate, tathāpi yo jano māṁ tava haste samārpayat tasya mahāpātakaṁ jātam|</para>
  <para style="p">
    <verse number="11" style="v"/>tadā yīśuḥ pratyavadad īśvareṇādattaṁ mamopari tava kimapyadhipatitvaṁ na vidyate, tathāpi yo jano māṁ tava haste samārpayat tasya mahāpātakaṁ jātam|</para>
  <para style="p">
    <verse number="12" style="v"/>tadārabhya pīlātastaṁ mocayituṁ ceṣṭitavān kintu yihūdīyā ruvanto vyāharan yadīmaṁ mānavaṁ tyajasi tarhi tvaṁ kaisarasya mitraṁ na bhavasi, yo janaḥ svaṁ rājānaṁ vakti saeva kaimarasya viruddhāṁ kathāṁ kathayati|</para>
  <para style="p">
    <verse number="13" style="v"/>etāṁ kathāṁ śrutvā pīlāto yīśuṁ bahirānīya nistārotsavasya āsādanadinasya dvitīyapraharāt pūrvvaṁ prastarabandhananāmni sthāne 'rthāt ibrīyabhāṣayā yad gabbithā kathyate tasmin sthāne vicārāsana upāviśat|</para>
  <para style="p">
    <verse number="14" style="v"/>anantaraṁ pīlāto yihūdīyān avadat, yuṣmākaṁ rājānaṁ paśyata|</para>
  <para style="p">
    <verse number="15" style="v"/>kintu enaṁ dūrīkuru, enaṁ dūrīkuru, enaṁ kruśe vidha, iti kathāṁ kathayitvā te ravitum ārabhanta; tadā pīlātaḥ kathitavān yuṣmākaṁ rājānaṁ kiṁ kruśe vedhiṣyāmi? pradhānayājakā uttaram avadan kaisaraṁ vinā kopi rājāsmākaṁ nāsti|</para>
  <para style="p">
    <verse number="16" style="v"/>tataḥ pīlāto yīśuṁ kruśe vedhituṁ teṣāṁ hasteṣu samārpayat, tataste taṁ dhṛtvā nītavantaḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>tataḥ paraṁ yīśuḥ kruśaṁ vahan śiraḥkapālam arthād yad ibrīyabhāṣayā gulgaltāṁ vadanti tasmin sthāna upasthitaḥ|</para>
  <para style="p">
    <verse number="18" style="v"/>tataste madhyasthāne taṁ tasyobhayapārśve dvāvaparau kruśe'vidhan|</para>
  <para style="p">
    <verse number="19" style="v"/>aparam eṣa yihūdīyānāṁ rājā nāsaratīyayīśuḥ, iti vijñāpanaṁ likhitvā pīlātastasya kruśopari samayojayat|</para>
  <para style="p">
    <verse number="20" style="v"/>sā lipiḥ ibrīyayūnānīyaromīyabhāṣābhi rlikhitā; yīśoḥ kruśavedhanasthānaṁ nagarasya samīpaṁ, tasmād bahavo yihūdīyāstāṁ paṭhitum ārabhanta|</para>
  <para style="p">
    <verse number="21" style="v"/>yihūdīyānāṁ pradhānayājakāḥ pīlātamiti nyavedayan yihūdīyānāṁ rājeti vākyaṁ na kintu eṣa svaṁ yihūdīyānāṁ rājānam avadad itthaṁ likhatu|</para>
  <para style="p">
    <verse number="22" style="v"/>tataḥ pīlāta uttaraṁ dattavān yallekhanīyaṁ tallikhitavān|</para>
  <para style="p">
    <verse number="23" style="v"/>itthaṁ senāgaṇo yīśuṁ kruśe vidhitvā tasya paridheyavastraṁ caturo bhāgān kṛtvā ekaikasenā ekaikabhāgam agṛhlat tasyottarīyavastrañcāgṛhlat| kintūttarīyavastraṁ sūcisevanaṁ vinā sarvvam ūtaṁ|</para>
  <para style="p">
    <verse number="24" style="v"/>tasmātte vyāharan etat kaḥ prāpsyati? tanna khaṇḍayitvā tatra guṭikāpātaṁ karavāma| vibhajante'dharīyaṁ me vasanaṁ te parasparaṁ| mamottarīyavastrārthaṁ guṭikāṁ pātayanti ca| iti yadvākyaṁ dharmmapustake likhitamāste tat senāgaṇenetthaṁ vyavaharaṇāt siddhamabhavat|</para>
  <para style="p">
    <verse number="25" style="v"/>tadānīṁ yīśo rmātā mātu rbhaginī ca yā kliyapā bhāryyā mariyam magdalīnī mariyam ca etāstasya kruśasya sannidhau samatiṣṭhan|</para>
  <para style="p">
    <verse number="26" style="v"/>tato yīśuḥ svamātaraṁ priyatamaśiṣyañca samīpe daṇḍāyamānau vilokya mātaram avadat, he yoṣid enaṁ tava putraṁ paśya,</para>
  <para style="p">
    <verse number="27" style="v"/>śiṣyantvavadat, enāṁ tava mātaraṁ paśya| tataḥ sa śiṣyastadghaṭikāyāṁ tāṁ nijagṛhaṁ nītavān|</para>
  <para style="p">
    <verse number="28" style="v"/>anantaraṁ sarvvaṁ karmmādhunā sampannamabhūt yīśuriti jñātvā dharmmapustakasya vacanaṁ yathā siddhaṁ bhavati tadartham akathayat mama pipāsā jātā|</para>
  <para style="p">
    <verse number="29" style="v"/>tatastasmin sthāne amlarasena pūrṇapātrasthityā te spañjamekaṁ tadamlarasenārdrīkṛtya esobnale tad yojayitvā tasya mukhasya sannidhāvasthāpayan|</para>
  <para style="p">
    <verse number="30" style="v"/>tadā yīśuramlarasaṁ gṛhītvā sarvvaṁ siddham iti kathāṁ kathayitvā mastakaṁ namayan prāṇān paryyatyajat|</para>
  <para style="p">
    <verse number="31" style="v"/>tadvinam āsādanadinaṁ tasmāt pare'hani viśrāmavāre dehā yathā kruśopari na tiṣṭhanti, yataḥ sa viśrāmavāro mahādinamāsīt, tasmād yihūdīyāḥ pīlātanikaṭaṁ gatvā teṣāṁ pādabhañjanasya sthānāntaranayanasya cānumatiṁ prārthayanta|</para>
  <para style="p">
    <verse number="32" style="v"/>ataḥ senā āgatya yīśunā saha kruśe hatayoḥ prathamadvitīyacorayoḥ pādān abhañjan;</para>
  <para style="p">
    <verse number="33" style="v"/>kintu yīśoḥ sannidhiṁ gatvā sa mṛta iti dṛṣṭvā tasya pādau nābhañjan|</para>
  <para style="p">
    <verse number="34" style="v"/>paścād eko yoddhā śūlāghātena tasya kukṣim avidhat tatkṣaṇāt tasmād raktaṁ jalañca niragacchat|</para>
  <para style="p">
    <verse number="35" style="v"/>yo jano'sya sākṣyaṁ dadāti sa svayaṁ dṛṣṭavān tasyedaṁ sākṣyaṁ satyaṁ tasya kathā yuṣmākaṁ viśvāsaṁ janayituṁ yogyā tat sa jānāti|</para>
  <para style="p">
    <verse number="36" style="v"/>tasyaikam asdhyapi na bhaṁkṣyate,</para>
  <para style="p">
    <verse number="37" style="v"/>tadvad anyaśāstrepi likhyate, yathā, "dṛṣṭipātaṁ kariṣyanti te'vidhan yantu tamprati|"</para>
  <para style="p">
    <verse number="38" style="v"/>arimathīyanagarasya yūṣaphnāmā śiṣya eka āsīt kintu yihūdīyebhyo bhayāt prakāśito na bhavati; sa yīśo rdehaṁ netuṁ pīlātasyānumatiṁ prārthayata, tataḥ pīlātenānumate sati sa gatvā yīśo rdeham anayat|</para>
  <para style="p">
    <verse number="39" style="v"/>aparaṁ yo nikadīmo rātrau yīśoḥ samīpam agacchat sopi gandharasena miśritaṁ prāyeṇa pañcāśatseṭakamaguruṁ gṛhītvāgacchat|</para>
  <para style="p">
    <verse number="40" style="v"/>tataste yihūdīyānāṁ śmaśāne sthāpanarītyanusāreṇa tatsugandhidravyeṇa sahitaṁ tasya dehaṁ vastreṇāveṣṭayan|</para>
  <para style="p">
    <verse number="41" style="v"/>aparañca yatra sthāne taṁ kruśe'vidhan tasya nikaṭasthodyāne yatra kimapi mṛtadehaṁ kadāpi nāsthāpyata tādṛśam ekaṁ nūtanaṁ śmaśānam āsīt|</para>
  <para style="p">
    <verse number="42" style="v"/>yihūdīyānām āsādanadināgamanāt te tasmin samīpasthaśmaśāne yīśum aśāyayan|</para>
  <chapter number="20" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ saptāhasya prathamadine 'tipratyūṣe 'ndhakāre tiṣṭhati magdalīnī mariyam tasya śmaśānasya nikaṭaṁ gatvā śmaśānasya mukhāt prastaramapasāritam apaśyat|</para>
  <para style="p">
    <verse number="2" style="v"/>paścād dhāvitvā śimonpitarāya yīśoḥ priyatamaśiṣyāya cedam akathayat, lokāḥ śmaśānāt prabhuṁ nītvā kutrāsthāpayan tad vaktuṁ na śaknomi|</para>
  <para style="p">
    <verse number="3" style="v"/>ataḥ pitaraḥ sonyaśiṣyaśca barhi rbhutvā śmaśānasthānaṁ gantum ārabhetāṁ|</para>
  <para style="p">
    <verse number="4" style="v"/>ubhayordhāvatoḥ sonyaśiṣyaḥ pitaraṁ paścāt tyaktvā pūrvvaṁ śmaśānasthāna upasthitavān|</para>
  <para style="p">
    <verse number="5" style="v"/>tadā prahvībhūya sthāpitavastrāṇi dṛṣṭavān kintu na prāviśat|</para>
  <para style="p">
    <verse number="6" style="v"/>aparaṁ śimonpitara āgatya śmaśānasthānaṁ praviśya</para>
  <para style="p">
    <verse number="7" style="v"/>sthāpitavastrāṇi mastakasya vastrañca pṛthak sthānāntare sthāpitaṁ dṛṣṭavān|</para>
  <para style="p">
    <verse number="8" style="v"/>tataḥ śmaśānasthānaṁ pūrvvam āgato yonyaśiṣyaḥ sopi praviśya tādṛśaṁ dṛṣṭā vyaśvasīt|</para>
  <para style="p">
    <verse number="9" style="v"/>yataḥ śmaśānāt sa utthāpayitavya etasya dharmmapustakavacanasya bhāvaṁ te tadā voddhuṁ nāśankuvan|</para>
  <para style="p">
    <verse number="10" style="v"/>anantaraṁ tau dvau śiṣyau svaṁ svaṁ gṛhaṁ parāvṛtyāgacchatām|</para>
  <para style="p">
    <verse number="11" style="v"/>tataḥ paraṁ mariyam śmaśānadvārasya bahiḥ sthitvā roditum ārabhata tato rudatī prahvībhūya śmaśānaṁ vilokya</para>
  <para style="p">
    <verse number="12" style="v"/>yīśoḥ śayanasthānasya śiraḥsthāne padatale ca dvayo rdiśo dvau svargīyadūtāvupaviṣṭau samapaśyat|</para>
  <para style="p">
    <verse number="13" style="v"/>tau pṛṣṭavantau he nāri kuto rodiṣi? sāvadat lokā mama prabhuṁ nītvā kutrāsthāpayan iti na jānāmi|</para>
  <para style="p">
    <verse number="14" style="v"/>ityuktvā mukhaṁ parāvṛtya yīśuṁ daṇḍāyamānam apaśyat kintu sa yīśuriti sā jñātuṁ nāśaknot|</para>
  <para style="p">
    <verse number="15" style="v"/>tadā yīśustām apṛcchat he nāri kuto rodiṣi? kaṁ vā mṛgayase? tataḥ sā tam udyānasevakaṁ jñātvā vyāharat, he maheccha tvaṁ yadītaḥ sthānāt taṁ nītavān tarhi kutrāsthāpayastad vada tatsthānāt tam ānayāmi|</para>
  <para style="p">
    <verse number="16" style="v"/>tadā yīśustām avadat he mariyam| tataḥ sā parāvṛtya pratyavadat he rabbūnī arthāt he guro|</para>
  <para style="p">
    <verse number="17" style="v"/>tadā yīśuravadat māṁ mā dhara, idānīṁ pituḥ samīpe ūrddhvagamanaṁ na karomi kintu yo mama yuṣmākañca pitā mama yuṣmākañceśvarastasya nikaṭa ūrddhvagamanaṁ karttum udyatosmi, imāṁ kathāṁ tvaṁ gatvā mama bhrātṛgaṇaṁ jñāpaya|</para>
  <para style="p">
    <verse number="18" style="v"/>tato magdalīnīmariyam tatkṣaṇād gatvā prabhustasyai darśanaṁ dattvā kathā etā akathayad iti vārttāṁ śiṣyebhyo'kathayat|</para>
  <para style="p">
    <verse number="19" style="v"/>tataḥ paraṁ saptāhasya prathamadinasya sandhyāsamaye śiṣyā ekatra militvā yihūdīyebhyo bhiyā dvāraruddham akurvvan, etasmin kāle yīśusteṣāṁ madhyasthāne tiṣṭhan akathayad yuṣmākaṁ kalyāṇaṁ bhūyāt|</para>
  <para style="p">
    <verse number="20" style="v"/>ityuktvā nijahastaṁ kukṣiñca darśitavān, tataḥ śiṣyāḥ prabhuṁ dṛṣṭvā hṛṣṭā abhavan|</para>
  <para style="p">
    <verse number="21" style="v"/>yīśuḥ punaravadad yuṣmākaṁ kalyāṇaṁ bhūyāt pitā yathā māṁ praiṣayat tathāhamapi yuṣmān preṣayāmi|</para>
  <para style="p">
    <verse number="22" style="v"/>ityuktvā sa teṣāmupari dīrghapraśvāsaṁ dattvā kathitavān pavitram ātmānaṁ gṛhlīta|</para>
  <para style="p">
    <verse number="23" style="v"/>yūyaṁ yeṣāṁ pāpāni mocayiṣyatha te mocayiṣyante yeṣāñca pāpāti na mocayiṣyatha te na mocayiṣyante|</para>
  <para style="p">
    <verse number="24" style="v"/>dvādaśamadhye gaṇito yamajo thomānāmā śiṣyo yīśorāgamanakālai taiḥ sārddhaṁ nāsīt|</para>
  <para style="p">
    <verse number="25" style="v"/>ato vayaṁ prabhūm apaśyāmeti vākye'nyaśiṣyairukte sovadat, tasya hastayo rlauhakīlakānāṁ cihnaṁ na vilokya taccihnam aṅgulyā na spṛṣṭvā tasya kukṣau hastaṁ nāropya cāhaṁ na viśvasiṣyāmi|</para>
  <para style="p">
    <verse number="26" style="v"/>aparam aṣṭame'hni gate sati thomāsahitaḥ śiṣyagaṇa ekatra militvā dvāraṁ ruddhvābhyantara āsīt, etarhi yīśusteṣāṁ madhyasthāne tiṣṭhan akathayat, yuṣmākaṁ kuśalaṁ bhūyāt|</para>
  <para style="p">
    <verse number="27" style="v"/>paścāt thāmai kathitavān tvam aṅgulīm atrārpayitvā mama karau paśya karaṁ prasāryya mama kukṣāvarpaya nāviśvasya|</para>
  <para style="p">
    <verse number="28" style="v"/>tadā thomā avadat, he mama prabho he madīśvara|</para>
  <para style="p">
    <verse number="29" style="v"/>yīśurakathayat, he thomā māṁ nirīkṣya viśvasiṣi ye na dṛṣṭvā viśvasanti taeva dhanyāḥ|</para>
  <para style="p">
    <verse number="30" style="v"/>etadanyāni pustake'smin alikhitāni bahūnyāścaryyakarmmāṇi yīśuḥ śiṣyāṇāṁ purastād akarot|</para>
  <para style="p">
    <verse number="31" style="v"/>kintu yīśurīśvarasyābhiṣiktaḥ suta eveti yathā yūyaṁ viśvasitha viśvasya ca tasya nāmnā paramāyuḥ prāpnutha tadartham etāni sarvvāṇyalikhyanta|</para>
  <chapter number="21" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ paraṁ tibiriyājaladhestaṭe yīśuḥ punarapi śiṣyebhyo darśanaṁ dattavān darśanasyākhyānamidam|</para>
  <para style="p">
    <verse number="2" style="v"/>śimonpitaraḥ yamajathomā gālīlīyakānnānagaranivāsī nithanel sivadeḥ putrāvanyau dvau śiṣyau caiteṣvekatra militeṣu śimonpitaro'kathayat matsyān dhartuṁ yāmi|</para>
  <para style="p">
    <verse number="3" style="v"/>tataste vyāharan tarhi vayamapi tvayā sārddhaṁ yāmaḥ tadā te bahirgatāḥ santaḥ kṣipraṁ nāvam ārohan kintu tasyāṁ rajanyām ekamapi na prāpnuvan|</para>
  <para style="p">
    <verse number="4" style="v"/>prabhāte sati yīśustaṭe sthitavān kintu sa yīśuriti śiṣyā jñātuṁ nāśaknuvan|</para>
  <para style="p">
    <verse number="5" style="v"/>tadā yīśurapṛcchat, he vatsā sannidhau kiñcit khādyadravyam āste? te'vadan kimapi nāsti|</para>
  <para style="p">
    <verse number="6" style="v"/>tadā so'vadat naukāyā dakṣiṇapārśve jālaṁ nikṣipata tato lapsyadhve, tasmāt tai rnikṣipte jāle matsyā etāvanto'patan yena te jālamākṛṣya nottolayituṁ śaktāḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>tasmād yīśoḥ priyatamaśiṣyaḥ pitarāyākathayat eṣa prabhu rbhavet, eṣa prabhuriti vācaṁ śrutvaiva śimon nagnatāheto rmatsyadhāriṇa uttarīyavastraṁ paridhāya hradaṁ pratyudalamphayat|</para>
  <para style="p">
    <verse number="8" style="v"/>apare śiṣyā matsyaiḥ sārddhaṁ jālam ākarṣantaḥ kṣudranaukāṁ vāhayitvā kūlamānayan te kūlād atidūre nāsan dviśatahastebhyo dūra āsan ityanumīyate|</para>
  <para style="p">
    <verse number="9" style="v"/>tīraṁ prāptaistaistatra prajvalitāgnistadupari matsyāḥ pūpāśca dṛṣṭāḥ|</para>
  <para style="p">
    <verse number="10" style="v"/>tato yīśurakathayad yān matsyān adharata teṣāṁ katipayān ānayata|</para>
  <para style="p">
    <verse number="11" style="v"/>ataḥ śimonpitaraḥ parāvṛtya gatvā bṛhadbhistripañcāśadadhikaśatamatsyaiḥ paripūrṇaṁ tajjālam ākṛṣyodatolayat kintvetāvadbhi rmatsyairapi jālaṁ nāchidyata|</para>
  <para style="p">
    <verse number="12" style="v"/>anantaraṁ yīśustān avādīt yūyamāgatya bhuṁgdhvaṁ; tadā saeva prabhuriti jñātatvāt tvaṁ kaḥ? iti praṣṭuṁ śiṣyāṇāṁ kasyāpi pragalbhatā nābhavat|</para>
  <para style="p">
    <verse number="13" style="v"/>tato yīśurāgatya pūpān matsyāṁśca gṛhītvā tebhyaḥ paryyaveṣayat|</para>
  <para style="p">
    <verse number="14" style="v"/>itthaṁ śmaśānādutthānāt paraṁ yīśuḥ śiṣyebhyastṛtīyavāraṁ darśanaṁ dattavān|</para>
  <para style="p">
    <verse number="15" style="v"/>bhojane samāpte sati yīśuḥ śimonpitaraṁ pṛṣṭavān, he yūnasaḥ putra śimon tvaṁ kim etebhyodhikaṁ mayi prīyase? tataḥ sa uditavān satyaṁ prabho tvayi prīye'haṁ tad bhavān jānāti; tadā yīśurakathayat tarhi mama meṣaśāvakagaṇaṁ pālaya|</para>
  <para style="p">
    <verse number="16" style="v"/>tataḥ sa dvitīyavāraṁ pṛṣṭavān he yūnasaḥ putra śimon tvaṁ kiṁ mayi prīyase? tataḥ sa uktavān satyaṁ prabho tvayi prīye'haṁ tad bhavān jānāti; tadā yīśurakathayata tarhi mama meṣagaṇaṁ pālaya|</para>
  <para style="p">
    <verse number="17" style="v"/>paścāt sa tṛtīyavāraṁ pṛṣṭavān, he yūnasaḥ putra śimon tvaṁ kiṁ mayi prīyase? etadvākyaṁ tṛtīyavāraṁ pṛṣṭavān tasmāt pitaro duḥkhito bhūtvā'kathayat he prabho bhavataḥ kimapyagocaraṁ nāsti tvayyahaṁ prīye tad bhavān jānāti; tato yīśuravadat tarhi mama meṣagaṇaṁ pālaya|</para>
  <para style="p">
    <verse number="18" style="v"/>ahaṁ tubhyaṁ yathārthaṁ kathayāmi yauvanakāle svayaṁ baddhakaṭi ryatrecchā tatra yātavān kintvitaḥ paraṁ vṛddhe vayasi hastaṁ vistārayiṣyasi, anyajanastvāṁ baddhvā yatra gantuṁ tavecchā na bhavati tvāṁ dhṛtvā tatra neṣyati|</para>
  <para style="p">
    <verse number="19" style="v"/>phalataḥ kīdṛśena maraṇena sa īśvarasya mahimānaṁ prakāśayiṣyati tad bodhayituṁ sa iti vākyaṁ proktavān| ityukte sati sa tamavocat mama paścād āgaccha|</para>
  <para style="p">
    <verse number="20" style="v"/>yo jano rātrikāle yīśo rvakṣo'valambya, he prabho ko bhavantaṁ parakareṣu samarpayiṣyatīti vākyaṁ pṛṣṭavān, taṁ yīśoḥ priyatamaśiṣyaṁ paścād āgacchantaṁ</para>
  <para style="p">
    <verse number="21" style="v"/>pitaro mukhaṁ parāvarttya vilokya yīśuṁ pṛṣṭavān, he prabho etasya mānavasya kīdṛśī gati rbhaviṣyati?</para>
  <para style="p">
    <verse number="22" style="v"/>sa pratyavadat, mama punarāgamanaparyyantaṁ yadi taṁ sthāpayitum icchāmi tatra tava kiṁ? tvaṁ mama paścād āgaccha|</para>
  <para style="p">
    <verse number="23" style="v"/>tasmāt sa śiṣyo na mariṣyatīti bhrātṛgaṇamadhye kiṁvadantī jātā kintu sa na mariṣyatīti vākyaṁ yīśu rnāvadat kevalaṁ mama punarāgamanaparyyantaṁ yadi taṁ sthāpayitum icchāmi tatra tava kiṁ? iti vākyam uktavān|</para>
  <para style="p">
    <verse number="24" style="v"/>yo jana etāni sarvvāṇi likhitavān atra sākṣyañca dattavān saeva sa śiṣyaḥ, tasya sākṣyaṁ pramāṇamiti vayaṁ jānīmaḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>yīśuretebhyo'parāṇyapi bahūni karmmāṇi kṛtavān tāni sarvvāṇi yadyekaikaṁ kṛtvā likhyante tarhi granthā etāvanto bhavanti teṣāṁ dhāraṇe pṛthivyāṁ sthānaṁ na bhavati| iti||</para>
</usx>
