<usx version="2.6">
  <book code="MRK" style="id">Sanskrit Bible (NT) in IAST Script (satyavedaḥ ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Mark</para>
  <para style="toc1">mārkalikhitaḥ susaṁvādaḥ</para>
  <para style="toc2">mārkaḥ</para>
  <para style="toc3">mārkaḥ</para>
  <para style="mt1">mārkalikhitaḥ susaṁvādaḥ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>īśvaraputrasya yīśukhrīṣṭasya susaṁvādārambhaḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>bhaviṣyadvādināṁ grantheṣu lipiritthamāste, paśya svakīyadūtantu tavāgre preṣayāmyaham| gatvā tvadīyapanthānaṁ sa hi pariṣkariṣyati|</para>
  <para style="p">
    <verse number="3" style="v"/>"parameśasya panthānaṁ pariṣkuruta sarvvataḥ| tasya rājapathañcaiva samānaṁ kurutādhunā|" ityetat prāntare vākyaṁ vadataḥ kasyacidravaḥ||</para>
  <para style="p">
    <verse number="4" style="v"/>saeva yohan prāntare majjitavān tathā pāpamārjananimittaṁ manovyāvarttakamajjanasya kathāñca pracāritavān|</para>
  <para style="p">
    <verse number="5" style="v"/>tato yihūdādeśayirūśālamnagaranivāsinaḥ sarvve lokā bahi rbhūtvā tasya samīpamāgatya svāni svāni pāpānyaṅgīkṛtya yarddananadyāṁ tena majjitā babhūvuḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>asya yohanaḥ paridheyāni kramelakalomajāni, tasya kaṭibandhanaṁ carmmajātam, tasya bhakṣyāṇi ca śūkakīṭā vanyamadhūni cāsan|</para>
  <para style="p">
    <verse number="7" style="v"/>sa pracārayan kathayāñcakre, ahaṁ namrībhūya yasya pādukābandhanaṁ mocayitumapi na yogyosmi, tādṛśo matto gurutara ekaḥ puruṣo matpaścādāgacchati|</para>
  <para style="p">
    <verse number="8" style="v"/>ahaṁ yuṣmān jale majjitavān kintu sa pavitra ātmāni saṁmajjayiṣyati|</para>
  <para style="p">
    <verse number="9" style="v"/>aparañca tasminneva kāle gālīlpradeśasya nāsaradgrāmād yīśurāgatya yohanā yarddananadyāṁ majjito'bhūt|</para>
  <para style="p">
    <verse number="10" style="v"/>sa jalādutthitamātro meghadvāraṁ muktaṁ kapotavat svasyopari avarohantamātmānañca dṛṣṭavān|</para>
  <para style="p">
    <verse number="11" style="v"/>tvaṁ mama priyaḥ putrastvayyeva mamamahāsantoṣa iyamākāśīyā vāṇī babhūva|</para>
  <para style="p">
    <verse number="12" style="v"/>tasmin kāle ātmā taṁ prāntaramadhyaṁ nināya|</para>
  <para style="p">
    <verse number="13" style="v"/>atha sa catvāriṁśaddināni tasmin sthāne vanyapaśubhiḥ saha tiṣṭhan śaitānā parīkṣitaḥ; paścāt svargīyadūtāstaṁ siṣevire|</para>
  <para style="p">
    <verse number="14" style="v"/>anantaraṁ yohani bandhanālaye baddhe sati yīśu rgālīlpradeśamāgatya īśvararājyasya susaṁvādaṁ pracārayan kathayāmāsa,</para>
  <para style="p">
    <verse number="15" style="v"/>kālaḥ sampūrṇa īśvararājyañca samīpamāgataṁ; atoheto ryūyaṁ manāṁsi vyāvarttayadhvaṁ susaṁvāde ca viśvāsita|</para>
  <para style="p">
    <verse number="16" style="v"/>tadanantaraṁ sa gālīlīyasamudrasya tīre gacchan śimon tasya bhrātā andriyanāmā ca imau dvau janau matsyadhāriṇau sāgaramadhye jālaṁ prakṣipantau dṛṣṭvā tāvavadat,</para>
  <para style="p">
    <verse number="17" style="v"/>yuvāṁ mama paścādāgacchataṁ, yuvāmahaṁ manuṣyadhāriṇau kariṣyāmi|</para>
  <para style="p">
    <verse number="18" style="v"/>tatastau tatkṣaṇameva jālāni parityajya tasya paścāt jagmatuḥ|</para>
  <para style="p">
    <verse number="19" style="v"/>tataḥ paraṁ tatsthānāt kiñcid dūraṁ gatvā sa sivadīputrayākūb tadbhrātṛyohan ca imau naukāyāṁ jālānāṁ jīrṇamuddhārayantau dṛṣṭvā tāvāhūyat|</para>
  <para style="p">
    <verse number="20" style="v"/>tatastau naukāyāṁ vetanabhugbhiḥ sahitaṁ svapitaraṁ vihāya tatpaścādīyatuḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>tataḥ paraṁ kapharnāhūmnāmakaṁ nagaramupasthāya sa viśrāmadivase bhajanagrahaṁ praviśya samupadideśa|</para>
  <para style="p">
    <verse number="22" style="v"/>tasyopadeśāllokā āścaryyaṁ menire yataḥ sodhyāpakāiva nopadiśan prabhāvavāniva propadideśa|</para>
  <para style="p">
    <verse number="23" style="v"/>aparañca tasmin bhajanagṛhe apavitrabhūtena grasta eko mānuṣa āsīt| sa cītśabdaṁ kṛtvā kathayāñcake</para>
  <para style="p">
    <verse number="24" style="v"/>bho nāsaratīya yīśo tvamasmān tyaja, tvayā sahāsmākaṁ kaḥ sambandhaḥ? tvaṁ kimasmān nāśayituṁ samāgataḥ? tvamīśvarasya pavitraloka ityahaṁ jānāmi|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā yīśustaṁ tarjayitvā jagāda tūṣṇīṁ bhava ito bahirbhava ca|</para>
  <para style="p">
    <verse number="26" style="v"/>tataḥ so'pavitrabhūtastaṁ sampīḍya atyucaiścītkṛtya nirjagāma|</para>
  <para style="p">
    <verse number="27" style="v"/>tenaiva sarvve camatkṛtya parasparaṁ kathayāñcakrire, aho kimidaṁ? kīdṛśo'yaṁ navya upadeśaḥ? anena prabhāvenāpavitrabhūteṣvājñāpiteṣu te tadājñānuvarttino bhavanti|</para>
  <para style="p">
    <verse number="28" style="v"/>tadā tasya yaśo gālīlaścaturdiksthasarvvadeśān vyāpnot|</para>
  <para style="p">
    <verse number="29" style="v"/>aparañca te bhajanagṛhād bahi rbhūtvā yākūbyohanbhyāṁ saha śimona āndriyasya ca niveśanaṁ praviviśuḥ|</para>
  <para style="p">
    <verse number="30" style="v"/>tadā pitarasya śvaśrūrjvarapīḍitā śayyāyāmāsta iti te taṁ jhaṭiti vijñāpayāñcakruḥ|</para>
  <para style="p">
    <verse number="31" style="v"/>tataḥ sa āgatya tasyā hastaṁ dhṛtvā tāmudasthāpayat; tadaiva tāṁ jvaro'tyākṣīt tataḥ paraṁ sā tān siṣeve|</para>
  <para style="p">
    <verse number="32" style="v"/>athāstaṁ gate ravau sandhyākāle sati lokāstatsamīpaṁ sarvvān rogiṇo bhūtadhṛtāṁśca samāninyuḥ|</para>
  <para style="p">
    <verse number="33" style="v"/>sarvve nāgarikā lokā dvāri saṁmilitāśca|</para>
  <para style="p">
    <verse number="34" style="v"/>tataḥ sa nānāvidharogiṇo bahūn manujānarogiṇaścakāra tathā bahūn bhūtān tyājayāñcakāra tān bhūtān kimapi vākyaṁ vaktuṁ niṣiṣedha ca yatohetoste tamajānan|</para>
  <para style="p">
    <verse number="35" style="v"/>aparañca so'tipratyūṣe vastutastu rātriśeṣe samutthāya bahirbhūya nirjanaṁ sthānaṁ gatvā tatra prārthayāñcakre|</para>
  <para style="p">
    <verse number="36" style="v"/>anantaraṁ śimon tatsaṅginaśca tasya paścād gatavantaḥ|</para>
  <para style="p">
    <verse number="37" style="v"/>taduddeśaṁ prāpya tamavadan sarvve lokāstvāṁ mṛgayante|</para>
  <para style="p">
    <verse number="38" style="v"/>tadā so'kathayat āgacchata vayaṁ samīpasthāni nagarāṇi yāmaḥ, yato'haṁ tatra kathāṁ pracārayituṁ bahirāgamam|</para>
  <para style="p">
    <verse number="39" style="v"/>atha sa teṣāṁ gālīlpradeśasya sarvveṣu bhajanagṛheṣu kathāḥ pracārayāñcakre bhūtānatyājayañca|</para>
  <para style="p">
    <verse number="40" style="v"/>anantaramekaḥ kuṣṭhī samāgatya tatsammukhe jānupātaṁ vinayañca kṛtvā kathitavān yadi bhavān icchati tarhi māṁ pariṣkarttuṁ śaknoti|</para>
  <para style="p">
    <verse number="41" style="v"/>tataḥ kṛpālu ryīśuḥ karau prasāryya taṁ spaṣṭvā kathayāmāsa</para>
  <para style="p">
    <verse number="42" style="v"/>mamecchā vidyate tvaṁ pariṣkṛto bhava| etatkathāyāḥ kathanamātrāt sa kuṣṭhī rogānmuktaḥ pariṣkṛto'bhavat|</para>
  <para style="p">
    <verse number="43" style="v"/>tadā sa taṁ visṛjan gāḍhamādiśya jagāda</para>
  <para style="p">
    <verse number="44" style="v"/>sāvadhāno bhava kathāmimāṁ kamapi mā vada; svātmānaṁ yājakaṁ darśaya, lokebhyaḥ svapariṣkṛteḥ pramāṇadānāya mūsānirṇītaṁ yaddānaṁ tadutsṛjasva ca|</para>
  <para style="p">
    <verse number="45" style="v"/>kintu sa gatvā tat karmma itthaṁ vistāryya pracārayituṁ prārebhe tenaiva yīśuḥ punaḥ saprakāśaṁ nagaraṁ praveṣṭuṁ nāśaknot tatohetorbahiḥ kānanasthāne tasyau; tathāpi caturddigbhyo lokāstasya samīpamāyayuḥ|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadanantaraṁ yīśai katipayadināni vilambya punaḥ kapharnāhūmnagaraṁ praviṣṭe sa gṛha āsta iti kiṁvadantyā tatkṣaṇaṁ tatsamīpaṁ bahavo lokā āgatya samupatasthuḥ,</para>
  <para style="p">
    <verse number="2" style="v"/>tasmād gṛhamadhye sarvveṣāṁ kṛte sthānaṁ nābhavad dvārasya caturdikṣvapi nābhavat, tatkāle sa tān prati kathāṁ pracārayāñcakre|</para>
  <para style="p">
    <verse number="3" style="v"/>tataḥ paraṁ lokāścaturbhi rmānavairekaṁ pakṣāghātinaṁ vāhayitvā tatsamīpam āninyuḥ|</para>
  <para style="p">
    <verse number="4" style="v"/>kintu janānāṁ bahutvāt taṁ yīśoḥ sammukhamānetuṁ na śaknuvanto yasmin sthāne sa āste taduparigṛhapṛṣṭhaṁ khanitvā chidraṁ kṛtvā tena mārgeṇa saśayyaṁ pakṣāghātinam avarohayāmāsuḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>tato yīśusteṣāṁ viśvāsaṁ dṛṣṭvā taṁ pakṣāghātinaṁ babhāṣe he vatsa tava pāpānāṁ mārjanaṁ bhavatu|</para>
  <para style="p">
    <verse number="6" style="v"/>tadā kiyanto'dhyāpakāstatropaviśanto manobhi rvitarkayāñcakruḥ, eṣa manuṣya etādṛśīmīśvaranindāṁ kathāṁ kutaḥ kathayati?</para>
  <para style="p">
    <verse number="7" style="v"/>īśvaraṁ vinā pāpāni mārṣṭuṁ kasya sāmarthyam āste?</para>
  <para style="p">
    <verse number="8" style="v"/>itthaṁ te vitarkayanti yīśustatkṣaṇaṁ manasā tad budvvā tānavadad yūyamantaḥkaraṇaiḥ kuta etāni vitarkayatha?</para>
  <para style="p">
    <verse number="9" style="v"/>tadanantaraṁ yīśustatsthānāt punaḥ samudrataṭaṁ yayau; lokanivahe tatsamīpamāgate sa tān samupadideśa|</para>
  <para style="p">
    <verse number="10" style="v"/>kintu pṛthivyāṁ pāpāni mārṣṭuṁ manuṣyaputrasya sāmarthyamasti, etad yuṣmān jñāpayituṁ (sa tasmai pakṣāghātine kathayāmāsa)</para>
  <para style="p">
    <verse number="11" style="v"/>uttiṣṭha tava śayyāṁ gṛhītvā svagṛhaṁ yāhi, ahaṁ tvāmidam ājñāpayāmi|</para>
  <para style="p">
    <verse number="12" style="v"/>tataḥ sa tatkṣaṇam utthāya śayyāṁ gṛhītvā sarvveṣāṁ sākṣāt jagāma; sarvve vismitā etādṛśaṁ karmma vayam kadāpi nāpaśyāma, imāṁ kathāṁ kathayitveśvaraṁ dhanyamabruvan|</para>
  <para style="p">
    <verse number="13" style="v"/>tadanantaraṁ yīśustatsthānāt punaḥ samudrataṭaṁ yayau; lokanivahe tatsamīpamāgate sa tān samupadideśa|</para>
  <para style="p">
    <verse number="14" style="v"/>atha gacchan karasañcayagṛha upaviṣṭam ālphīyaputraṁ leviṁ dṛṣṭvā tamāhūya kathitavān matpaścāt tvāmāmaccha tataḥ sa utthāya tatpaścād yayau|</para>
  <para style="p">
    <verse number="15" style="v"/>anantaraṁ yīśau tasya gṛhe bhoktum upaviṣṭe bahavaḥ karamañcāyinaḥ pāpinaśca tena tacchiṣyaiśca sahopaviviśuḥ, yato bahavastatpaścādājagmuḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>tadā sa karamañcāyibhiḥ pāpibhiśca saha khādati, tad dṛṣṭvādhyāpakāḥ phirūśinaśca tasya śiṣyānūcuḥ karamañcāyibhiḥ pāpibhiśca sahāyaṁ kuto bhuṁkte pivati ca?</para>
  <para style="p">
    <verse number="17" style="v"/>tadvākyaṁ śrutvā yīśuḥ pratyuvāca,arogilokānāṁ cikitsakena prayojanaṁ nāsti, kintu rogiṇāmeva; ahaṁ dhārmmikānāhvātuṁ nāgataḥ kintu mano vyāvarttayituṁ pāpina eva|</para>
  <para style="p">
    <verse number="18" style="v"/>tataḥ paraṁ yohanaḥ phirūśināñcopavāsācāriśiṣyā yīśoḥ samīpam āgatya kathayāmāsuḥ, yohanaḥ phirūśināñca śiṣyā upavasanti kintu bhavataḥ śiṣyā nopavasanti kiṁ kāraṇamasya?</para>
  <para style="p">
    <verse number="19" style="v"/>tadā yīśustān babhāṣe yāvat kālaṁ sakhibhiḥ saha kanyāyā varastiṣṭhati tāvatkālaṁ te kimupavastuṁ śaknuvanti? yāvatkālaṁ varastaiḥ saha tiṣṭhati tāvatkālaṁ ta upavastuṁ na śaknuvanti|</para>
  <para style="p">
    <verse number="20" style="v"/>yasmin kāle tebhyaḥ sakāśād varo neṣyate sa kāla āgacchati, tasmin kāle te janā upavatsyanti|</para>
  <para style="p">
    <verse number="21" style="v"/>kopi janaḥ purātanavastre nūtanavastraṁ na sīvyati, yato nūtanavastreṇa saha sevane kṛte jīrṇaṁ vastraṁ chidyate tasmāt puna rmahat chidraṁ jāyate|</para>
  <para style="p">
    <verse number="22" style="v"/>kopi janaḥ purātanakutūṣu nūtanaṁ drākṣārasaṁ na sthāpayati, yato nūtanadrākṣārasasya tejasā tāḥ kutvo vidīryyante tato drākṣārasaśca patati kutvaśca naśyanti, ataeva nūtanadrākṣāraso nūtanakutūṣu sthāpanīyaḥ|</para>
  <para style="p">
    <verse number="23" style="v"/>tadanantaraṁ yīśu ryadā viśrāmavāre śasyakṣetreṇa gacchati tadā tasya śiṣyā gacchantaḥ śasyamañjarīśchettuṁ pravṛttāḥ|</para>
  <para style="p">
    <verse number="24" style="v"/>ataḥ phirūśino yīśave kathayāmāsuḥ paśyatu viśrāmavāsare yat karmma na karttavyaṁ tad ime kutaḥ kurvvanti?</para>
  <para style="p">
    <verse number="25" style="v"/>tadā sa tebhyo'kathayat dāyūd tatsaṁṅginaśca bhakṣyābhāvāt kṣudhitāḥ santo yat karmma kṛtavantastat kiṁ yuṣmābhi rna paṭhitam?</para>
  <para style="p">
    <verse number="26" style="v"/>abiyātharnāmake mahāyājakatāṁ kurvvati sa kathamīśvarasyāvāsaṁ praviśya ye darśanīyapūpā yājakān vinānyasya kasyāpi na bhakṣyāstāneva bubhuje saṅgilokebhyo'pi dadau|</para>
  <para style="p">
    <verse number="27" style="v"/>so'paramapi jagāda, viśrāmavāro manuṣyārthameva nirūpito'sti kintu manuṣyo viśrāmavārārthaṁ naiva|</para>
  <para style="p">
    <verse number="28" style="v"/>manuṣyaputro viśrāmavārasyāpi prabhurāste|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ yīśuḥ puna rbhajanagṛhaṁ praviṣṭastasmin sthāne śuṣkahasta eko mānava āsīt|</para>
  <para style="p">
    <verse number="2" style="v"/>sa viśrāmavāre tamarogiṇaṁ kariṣyati navetyatra bahavastam apavadituṁ chidramapekṣitavantaḥ|</para>
  <para style="p">
    <verse number="3" style="v"/>tadā sa taṁ śuṣkahastaṁ manuṣyaṁ jagāda madhyasthāne tvamuttiṣṭha|</para>
  <para style="p">
    <verse number="4" style="v"/>tataḥ paraṁ sa tān papraccha viśrāmavāre hitamahitaṁ tathā hi prāṇarakṣā vā prāṇanāśa eṣāṁ madhye kiṁ karaṇīyaṁ ? kintu te niḥśabdāstasthuḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>tadā sa teṣāmantaḥkaraṇānāṁ kāṭhinyāddheto rduḥkhitaḥ krodhāt cartuिdaśo dṛṣṭavān taṁ mānuṣaṁ gaditavān taṁ hastaṁ vistāraya, tatastena haste vistṛte taddhasto'nyahastavad arogo jātaḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>atha phirūśinaḥ prasthāya taṁ nāśayituṁ herodīyaiḥ saha mantrayitumārebhire|</para>
  <para style="p">
    <verse number="7" style="v"/>ataeva yīśustatsthānaṁ parityajya śiṣyaiḥ saha punaḥ sāgarasamīpaṁ gataḥ;</para>
  <para style="p">
    <verse number="8" style="v"/>tato gālīlyihūdā-yirūśālam-idom-yardannadīpārasthānebhyo lokasamūhastasya paścād gataḥ; tadanyaḥ sorasīdanoḥ samīpavāsilokasamūhaśca tasya mahākarmmaṇāṁ vārttaṁ śrutvā tasya sannidhimāgataḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>tadā lokasamūhaścet tasyopari patati ityāśaṅkya sa nāvamekāṁ nikaṭe sthāpayituṁ śiṣyānādiṣṭavān|</para>
  <para style="p">
    <verse number="10" style="v"/>yato'nekamanuṣyāṇāmārogyakaraṇād vyādhigrastāḥ sarvve taṁ spraṣṭuṁ parasparaṁ balena yatnavantaḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>aparañca apavitrabhūtāstaṁ dṛṣṭvā taccaraṇayoḥ patitvā procaiḥ procuḥ, tvamīśvarasya putraḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>kintu sa tān dṛḍham ājñāpya svaṁ paricāyituṁ niṣiddhavān|</para>
  <para style="p">
    <verse number="13" style="v"/>anantaraṁ sa parvvatamāruhya yaṁ yaṁ praticchā taṁ tamāhūtavān tataste tatsamīpamāgatāḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>tadā sa dvādaśajanān svena saha sthātuṁ susaṁvādapracārāya preritā bhavituṁ</para>
  <para style="p">
    <verse number="15" style="v"/>sarvvaprakāravyādhīnāṁ śamanakaraṇāya prabhāvaṁ prāptuṁ bhūtān tyājayituñca niyuktavān|</para>
  <para style="p">
    <verse number="16" style="v"/>teṣāṁ nāmānīmāni, śimon sivadiputro</para>
  <para style="p">
    <verse number="17" style="v"/>yākūb tasya bhrātā yohan ca āndriyaḥ philipo barthalamayaḥ,</para>
  <para style="p">
    <verse number="18" style="v"/>mathī thomā ca ālphīyaputro yākūb thaddīyaḥ kinānīyaḥ śimon yastaṁ parahasteṣvarpayiṣyati sa īṣkariyotīyayihūdāśca|</para>
  <para style="p">
    <verse number="19" style="v"/>sa śimone pitara ityupanāma dadau yākūbyohanbhyāṁ ca binerigiś arthato meghanādaputrāvityupanāma dadau|</para>
  <para style="p">
    <verse number="20" style="v"/>anantaraṁ te niveśanaṁ gatāḥ, kintu tatrāpi punarmahān janasamāgamo 'bhavat tasmātte bhoktumapyavakāśaṁ na prāptāḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>tatastasya suhṛllokā imāṁ vārttāṁ prāpya sa hatajñānobhūd iti kathāṁ kathayitvā taṁ dhṛtvānetuṁ gatāḥ|</para>
  <para style="p">
    <verse number="22" style="v"/>aparañca yirūśālama āgatā ye ye'dhyāpakāste jagadurayaṁ puruṣo bhūtapatyābiṣṭastena bhūtapatinā bhūtān tyājayati|</para>
  <para style="p">
    <verse number="23" style="v"/>tatastānāhūya yīśu rdṛṣṭāntaiḥ kathāṁ kathitavān śaitān kathaṁ śaitānaṁ tyājayituṁ śaknoti?</para>
  <para style="p">
    <verse number="24" style="v"/>kiñcana rājyaṁ yadi svavirodhena pṛthag bhavati tarhi tad rājyaṁ sthiraṁ sthātuṁ na śaknoti|</para>
  <para style="p">
    <verse number="25" style="v"/>tathā kasyāpi parivāro yadi parasparaṁ virodhī bhavati tarhi sopi parivāraḥ sthiraṁ sthātuṁ na śaknoti|</para>
  <para style="p">
    <verse number="26" style="v"/>tadvat śaitān yadi svavipakṣatayā uttiṣṭhan bhinno bhavati tarhi sopi sthiraṁ sthātuṁ na śaknoti kintūcchinno bhavati|</para>
  <para style="p">
    <verse number="27" style="v"/>aparañca prabalaṁ janaṁ prathamaṁ na baddhā kopi tasya gṛhaṁ praviśya dravyāṇi luṇṭhayituṁ na śaknoti, taṁ badvvaiva tasya gṛhasya dravyāṇi luṇṭhayituṁ śaknoti|</para>
  <para style="p">
    <verse number="28" style="v"/>atoheto ryuṣmabhyamahaṁ satyaṁ kathayāmi manuṣyāṇāṁ santānā yāni yāni pāpānīśvaranindāñca kurvvanti teṣāṁ tatsarvveṣāmaparādhānāṁ kṣamā bhavituṁ śaknoti,</para>
  <para style="p">
    <verse number="29" style="v"/>kintu yaḥ kaścit pavitramātmānaṁ nindati tasyāparādhasya kṣamā kadāpi na bhaviṣyati sonantadaṇḍasyārho bhaviṣyati|</para>
  <para style="p">
    <verse number="30" style="v"/>tasyāpavitrabhūto'sti teṣāmetatkathāhetoḥ sa itthaṁ kathitavān|</para>
  <para style="p">
    <verse number="31" style="v"/>atha tasya mātā bhrātṛgaṇaścāgatya bahistiṣṭhanato lokān preṣya tamāhūtavantaḥ|</para>
  <para style="p">
    <verse number="32" style="v"/>tatastatsannidhau samupaviṣṭā lokāstaṁ babhāṣire paśya bahistava mātā bhrātaraśca tvām anvicchanti|</para>
  <para style="p">
    <verse number="33" style="v"/>tadā sa tān pratyuvāca mama mātā kā bhrātaro vā ke? tataḥ paraṁ sa svamīpopaviṣṭān śiṣyān prati avalokanaṁ kṛtvā kathayāmāsa</para>
  <para style="p">
    <verse number="34" style="v"/>paśyataite mama mātā bhrātaraśca|</para>
  <para style="p">
    <verse number="35" style="v"/>yaḥ kaścid īśvarasyeṣṭāṁ kriyāṁ karoti sa eva mama bhrātā bhaginī mātā ca|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ sa samudrataṭe punarupadeṣṭuṁ prārebhe, tatastatra bahujanānāṁ samāgamāt sa sāgaropari naukāmāruhya samupaviṣṭaḥ; sarvve lokāḥ samudrakūle tasthuḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>tadā sa dṛṣṭāntakathābhi rbahūpadiṣṭavān upadiśaṁśca kathitavān,</para>
  <para style="p">
    <verse number="3" style="v"/>avadhānaṁ kuruta, eko bījavaptā bījāni vaptuṁ gataḥ;</para>
  <para style="p">
    <verse number="4" style="v"/>vapanakāle kiyanti bījāni mārgapāśve patitāni, tata ākāśīyapakṣiṇa etya tāni cakhāduḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>kiyanti bījāni svalpamṛttikāvatpāṣāṇabhūmau patitāni tāni mṛdolpatvāt śīghramaṅkuritāni;</para>
  <para style="p">
    <verse number="6" style="v"/>kintūdite sūryye dagdhāni tathā mūlāno nādhogatatvāt śuṣkāṇi ca|</para>
  <para style="p">
    <verse number="7" style="v"/>kiyanti bījāni kaṇṭakivanamadhye patitāni tataḥ kaṇṭakāni saṁvṛdvya tāni jagrasustāni na ca phalitāni|</para>
  <para style="p">
    <verse number="8" style="v"/>tathā kiyanti bījānyuttamabhūmau patitāni tāni saṁvṛdvya phalānyutpāditāni kiyanti bījāni triṁśadguṇāni kiyanti ṣaṣṭiguṇāni kiyanti śataguṇāni phalāni phalitavanti|</para>
  <para style="p">
    <verse number="9" style="v"/>atha sa tānavadat yasya śrotuṁ karṇau staḥ sa śṛṇotu|</para>
  <para style="p">
    <verse number="10" style="v"/>tadanantaraṁ nirjanasamaye tatsaṅgino dvādaśaśiṣyāśca taṁ taddṛṣṭāntavākyasyārthaṁ papracchuḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>tadā sa tānuditavān īśvararājyasya nigūḍhavākyaṁ boddhuṁ yuṣmākamadhikāro'sti;</para>
  <para style="p">
    <verse number="12" style="v"/>kintu ye vahirbhūtāḥ "te paśyantaḥ paśyanti kintu na jānanti, śṛṇvantaḥ śṛṇvanti kintu na budhyante, cettai rmanaḥsu kadāpi parivarttiteṣu teṣāṁ pāpānyamocayiṣyanta," atohetostān prati dṛṣṭāntaireva tāni mayā kathitāni|</para>
  <para style="p">
    <verse number="13" style="v"/>atha sa kathitavān yūyaṁ kimetad dṛṣṭāntavākyaṁ na budhyadhve? tarhi kathaṁ sarvvān dṛṣṭāntāna bhotsyadhve?</para>
  <para style="p">
    <verse number="14" style="v"/>bījavaptā vākyarūpāṇi bījāni vapati;</para>
  <para style="p">
    <verse number="15" style="v"/>tatra ye ye lokā vākyaṁ śṛṇvanti, kintu śrutamātrāt śaitān śīghramāgatya teṣāṁ manaḥsūptāni tāni vākyarūpāṇi bījānyapanayati taeva uptabījamārgapārśvesvarūpāḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>ye janā vākyaṁ śrutvā sahasā paramānandena gṛhlanti, kintu hṛdi sthairyyābhāvāt kiñcit kālamātraṁ tiṣṭhanti tatpaścāt tadvākyahetoḥ</para>
  <para style="p">
    <verse number="17" style="v"/>kutracit kleśe upadrave vā samupasthite tadaiva vighnaṁ prāpnuvanti taeva uptabījapāṣāṇabhūmisvarūpāḥ|</para>
  <para style="p">
    <verse number="18" style="v"/>ye janāḥ kathāṁ śṛṇvanti kintu sāṁsārikī cintā dhanabhrānti rviṣayalobhaśca ete sarvve upasthāya tāṁ kathāṁ grasanti tataḥ mā viphalā bhavati</para>
  <para style="p">
    <verse number="19" style="v"/>taeva uptabījasakaṇṭakabhūmisvarūpāḥ|</para>
  <para style="p">
    <verse number="20" style="v"/>ye janā vākyaṁ śrutvā gṛhlanti teṣāṁ kasya vā triṁśadguṇāni kasya vā ṣaṣṭiguṇāni kasya vā śataguṇāni phalāni bhavanti taeva uptabījorvvarabhūmisvarūpāḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā so'paramapi kathitavān kopi jano dīpādhāraṁ parityajya droṇasyādhaḥ khaṭvāyā adhe vā sthāpayituṁ dīpamānayati kiṁ?</para>
  <para style="p">
    <verse number="22" style="v"/>atoheto ryanna prakāśayiṣyate tādṛg lukkāyitaṁ kimapi vastu nāsti; yad vyaktaṁ na bhaviṣyati tādṛśaṁ guptaṁ kimapi vastu nāsti|</para>
  <para style="p">
    <verse number="23" style="v"/>yasya śrotuṁ karṇau staḥ sa śṛṇotu|</para>
  <para style="p">
    <verse number="24" style="v"/>aparamapi kathitavān yūyaṁ yad yad vākyaṁ śṛṇutha tatra sāvadhānā bhavata, yato yūyaṁ yena parimāṇena parimātha tenaiva parimāṇena yuṣmadarthamapi parimāsyate; śrotāro yūyaṁ yuṣmabhyamadhikaṁ dāsyate|</para>
  <para style="p">
    <verse number="25" style="v"/>yasyāśraye varddhate tasmai aparamapi dāsyate, kintu yasyāśraye na varddhate tasya yat kiñcidasti tadapi tasmān neṣyate|</para>
  <para style="p">
    <verse number="26" style="v"/>anantaraṁ sa kathitavān eko lokaḥ kṣetre bījānyuptvā</para>
  <para style="p">
    <verse number="27" style="v"/>jāgaraṇanidrābhyāṁ divāniśaṁ gamayati, parantu tadvījaṁ tasyājñātarūpeṇāṅkurayati varddhate ca;</para>
  <para style="p">
    <verse number="28" style="v"/>yatohetoḥ prathamataḥ patrāṇi tataḥ paraṁ kaṇiśāni tatpaścāt kaṇiśapūrṇāni śasyāni bhūmiḥ svayamutpādayati;</para>
  <para style="p">
    <verse number="29" style="v"/>kintu phaleṣu pakkeṣu śasyacchedanakālaṁ jñātvā sa tatkṣaṇaṁ śasyāni chinatti, anena tulyamīśvararājyaṁ|</para>
  <para style="p">
    <verse number="30" style="v"/>punaḥ so'kathayad īśvararājyaṁ kena samaṁ? kena vastunā saha vā tadupamāsyāmi?</para>
  <para style="p">
    <verse number="31" style="v"/>tat sarṣapaikena tulyaṁ yato mṛdi vapanakāle sarṣapabījaṁ sarvvapṛthivīsthabījāt kṣudraṁ</para>
  <para style="p">
    <verse number="32" style="v"/>kintu vapanāt param aṅkurayitvā sarvvaśākād bṛhad bhavati, tasya bṛhatyaḥ śākhāśca jāyante tatastacchāyāṁ pakṣiṇa āśrayante|</para>
  <para style="p">
    <verse number="33" style="v"/>itthaṁ teṣāṁ bodhānurūpaṁ so'nekadṛṣṭāntaistānupadiṣṭavān,</para>
  <para style="p">
    <verse number="34" style="v"/>dṛṣṭāntaṁ vinā kāmapi kathāṁ tebhyo na kathitavān paścān nirjane sa śiṣyān sarvvadṛṣṭāntārthaṁ bodhitavān|</para>
  <para style="p">
    <verse number="35" style="v"/>taddinasya sandhyāyāṁ sa tebhyo'kathayad āgacchata vayaṁ pāraṁ yāma|</para>
  <para style="p">
    <verse number="36" style="v"/>tadā te lokān visṛjya tamavilambaṁ gṛhītvā naukayā pratasthire; aparā api nāvastayā saha sthitāḥ|</para>
  <para style="p">
    <verse number="37" style="v"/>tataḥ paraṁ mahājhañbhśagamāt nau rdolāyamānā taraṅgeṇa jalaiḥ pūrṇābhavacca|</para>
  <para style="p">
    <verse number="38" style="v"/>tadā sa naukācaścādbhāge upadhāne śiro nidhāya nidrita āsīt tataste taṁ jāgarayitvā jagaduḥ, he prabho, asmākaṁ prāṇā yānti kimatra bhavataścintā nāsti?</para>
  <para style="p">
    <verse number="39" style="v"/>tadā sa utthāya vāyuṁ tarjitavān samudrañcoktavān śāntaḥ susthiraśca bhava; tato vāyau nivṛtte'bdhirnistaraṅgobhūt|</para>
  <para style="p">
    <verse number="40" style="v"/>tadā sa tānuvāca yūyaṁ kuta etādṛkśaṅkākulā bhavata? kiṁ vo viśvāso nāsti?</para>
  <para style="p">
    <verse number="41" style="v"/>tasmātte'tīvabhītāḥ parasparaṁ vaktumārebhire, aho vāyuḥ sindhuścāsya nideśagrāhiṇau kīdṛgayaṁ manujaḥ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha tū sindhupāraṁ gatvā giderīyapradeśa upatasthuḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>naukāto nirgatamātrād apavitrabhūtagrasta ekaḥ śmaśānādetya taṁ sākṣāc cakāra|</para>
  <para style="p">
    <verse number="3" style="v"/>sa śmaśāne'vātsīt kopi taṁ śṛṅkhalena badvvā sthāpayituṁ nāśaknot|</para>
  <para style="p">
    <verse number="4" style="v"/>janairvāraṁ nigaḍaiḥ śṛṅkhalaiśca sa baddhopi śṛṅkhalānyākṛṣya mocitavān nigaḍāni ca bhaṁktvā khaṇḍaṁ khaṇḍaṁ kṛtavān kopi taṁ vaśīkarttuṁ na śaśaka|</para>
  <para style="p">
    <verse number="5" style="v"/>divāniśaṁ sadā parvvataṁ śmaśānañca bhramitvā cītśabdaṁ kṛtavān grāvabhiśca svayaṁ svaṁ kṛtavān|</para>
  <para style="p">
    <verse number="6" style="v"/>sa yīśuṁ dūrāt paśyanneva dhāvan taṁ praṇanāma ucairuvaṁścovāca,</para>
  <para style="p">
    <verse number="7" style="v"/>he sarvvoparistheśvaraputra yīśo bhavatā saha me kaḥ sambandhaḥ? ahaṁ tvāmīśvareṇa śāpaye māṁ mā yātaya|</para>
  <para style="p">
    <verse number="8" style="v"/>yato yīśustaṁ kathitavān re apavitrabhūta, asmānnarād bahirnirgaccha|</para>
  <para style="p">
    <verse number="9" style="v"/>atha sa taṁ pṛṣṭavān kinte nāma? tena pratyuktaṁ vayamaneke 'smastato'smannāma bāhinī|</para>
  <para style="p">
    <verse number="10" style="v"/>tatosmān deśānna preṣayeti te taṁ prārthayanta|</para>
  <para style="p">
    <verse number="11" style="v"/>tadānīṁ parvvataṁ nikaṣā bṛhan varāhavrajaścarannāsīt|</para>
  <para style="p">
    <verse number="12" style="v"/>tasmād bhūtā vinayena jagaduḥ, amuṁ varāhavrajam āśrayitum asmān prahiṇu|</para>
  <para style="p">
    <verse number="13" style="v"/>yīśunānujñātāste'pavitrabhūtā bahirniryāya varāhavrajaṁ prāviśan tataḥ sarvve varāhā vastutastu prāyodvisahasrasaṁṅkhyakāḥ kaṭakena mahājavād dhāvantaḥ sindhau prāṇān jahuḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>tasmād varāhapālakāḥ palāyamānāḥ pure grāme ca tadvārttaṁ kathayāñcakruḥ| tadā lokā ghaṭitaṁ tatkāryyaṁ draṣṭuṁ bahirjagmuḥ</para>
  <para style="p">
    <verse number="15" style="v"/>yīśoḥ sannidhiṁ gatvā taṁ bhūtagrastam arthād bāhinībhūtagrastaṁ naraṁ savastraṁ sacetanaṁ samupaviṣṭañca dṛृṣṭvā bibhyuḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>tato dṛṣṭatatkāryyalokāstasya bhūtagrastanarasya varāhavrajasyāpi tāṁ dhaṭanāṁ varṇayāmāsuḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>tataste svasīmāto bahirgantuṁ yīśuṁ vinetumārebhire|</para>
  <para style="p">
    <verse number="18" style="v"/>atha tasya naukārohaṇakāle sa bhūtamukto nā yīśunā saha sthātuṁ prārthayate;</para>
  <para style="p">
    <verse number="19" style="v"/>kintu sa tamananumatya kathitavān tvaṁ nijātmīyānāṁ samīpaṁ gṛhañca gaccha prabhustvayi kṛpāṁ kṛtvā yāni karmmāṇi kṛtavān tāni tān jñāpaya|</para>
  <para style="p">
    <verse number="20" style="v"/>ataḥ sa prasthāya yīśunā kṛtaṁ tatsarvvāścaryyaṁ karmma dikāpalideśe pracārayituṁ prārabdhavān tataḥ sarvve lokā āścaryyaṁ menire|</para>
  <para style="p">
    <verse number="21" style="v"/>anantaraṁ yīśau nāvā punaranyapāra uttīrṇe sindhutaṭe ca tiṣṭhati sati tatsamīpe bahulokānāṁ samāgamo'bhūt|</para>
  <para style="p">
    <verse number="22" style="v"/>aparaṁ yāyīr nāmnā kaścid bhajanagṛhasyādhipa āgatya taṁ dṛṣṭvaiva caraṇayoḥ patitvā bahu nivedya kathitavān;</para>
  <para style="p">
    <verse number="23" style="v"/>mama kanyā mṛtaprāyābhūd ato bhavānetya tadārogyāya tasyā gātre hastam arpayatu tenaiva sā jīviṣyati|</para>
  <para style="p">
    <verse number="24" style="v"/>tadā yīśustena saha calitaḥ kintu tatpaścād bahulokāścalitvā tādgātre patitāḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>atha dvādaśavarṣāṇi pradararogeṇa</para>
  <para style="p">
    <verse number="26" style="v"/>śīrṇā cikitsakānāṁ nānācikitsābhiśca duḥkhaṁ bhuktavatī ca sarvvasvaṁ vyayitvāpi nārogyaṁ prāptā ca punarapi pīḍitāsīcca</para>
  <para style="p">
    <verse number="27" style="v"/>yā strī sā yīśo rvārttāṁ prāpya manasākathayat yadyahaṁ tasya vastramātra spraṣṭuṁ labheyaṁ tadā rogahīnā bhaviṣyāmi|</para>
  <para style="p">
    <verse number="28" style="v"/>atohetoḥ sā lokāraṇyamadhye tatpaścādāgatya tasya vastraṁ pasparśa|</para>
  <para style="p">
    <verse number="29" style="v"/>tenaiva tatkṣaṇaṁ tasyā raktasrotaḥ śuṣkaṁ svayaṁ tasmād rogānmuktā ityapi dehe'nubhūtā|</para>
  <para style="p">
    <verse number="30" style="v"/>atha svasmāt śakti rnirgatā yīśuretanmanasā jñātvā lokanivahaṁ prati mukhaṁ vyāvṛtya pṛṣṭavān kena madvastraṁ spṛṣṭaṁ?</para>
  <para style="p">
    <verse number="31" style="v"/>tatastasya śiṣyā ūcuḥ bhavato vapuṣi lokāḥ saṁgharṣanti tad dṛṣṭvā kena madvastraṁ spṛṣṭamiti kutaḥ kathayati?</para>
  <para style="p">
    <verse number="32" style="v"/>kintu kena tat karmma kṛtaṁ tad draṣṭuṁ yīśuścaturdiśo dṛṣṭavān|</para>
  <para style="p">
    <verse number="33" style="v"/>tataḥ sā strī bhītā kampitā ca satī svasyā rukpratikriyā jāteti jñātvāgatya tatsammukhe patitvā sarvvavṛttāntaṁ satyaṁ tasmai kathayāmāsa|</para>
  <para style="p">
    <verse number="34" style="v"/>tadānīṁ yīśustāṁ gaditavān, he kanye tava pratītistvām arogāmakarot tvaṁ kṣemeṇa vraja svarogānmuktā ca tiṣṭha|</para>
  <para style="p">
    <verse number="35" style="v"/>itivākyavadanakāle bhajanagṛhādhipasya niveśanāl lokā etyādhipaṁ babhāṣire tava kanyā mṛtā tasmād guruṁ punaḥ kutaḥ kliśnāsi?</para>
  <para style="p">
    <verse number="36" style="v"/>kintu yīśustad vākyaṁ śrutvaiva bhajanagṛhādhipaṁ gaditavān mā bhaiṣīḥ kevalaṁ viśvāsihi|</para>
  <para style="p">
    <verse number="37" style="v"/>atha pitaro yākūb tadbhrātā yohan ca etān vinā kamapi svapaścād yātuṁ nānvamanyata|</para>
  <para style="p">
    <verse number="38" style="v"/>tasya bhajanagṛhādhipasya niveśanasamīpam āgatya kalahaṁ bahurodanaṁ vilāpañca kurvvato lokān dadarśa|</para>
  <para style="p">
    <verse number="39" style="v"/>tasmān niveśanaṁ praviśya proktavān yūyaṁ kuta itthaṁ kalahaṁ rodanañca kurutha? kanyā na mṛtā nidrāti|</para>
  <para style="p">
    <verse number="40" style="v"/>tasmātte tamupajahasuḥ kintu yīśuḥ sarvvāna bahiṣkṛtya kanyāyāḥ pitarau svasaṅginaśca gṛhītvā yatra kanyāsīt tat sthānaṁ praviṣṭavān|</para>
  <para style="p">
    <verse number="41" style="v"/>atha sa tasyāḥ kanyāyā hastau dhṛtvā tāṁ babhāṣe ṭālīthā kūmī, arthato he kanye tvamuttiṣṭha ityājñāpayāmi|</para>
  <para style="p">
    <verse number="42" style="v"/>tunaiva tatkṣaṇaṁ sā dvādaśavarṣavayaskā kanyā potthāya calitumārebhe, itaḥ sarvve mahāvismayaṁ gatāḥ|</para>
  <para style="p">
    <verse number="43" style="v"/>tata etasyai kiñcit khādyaṁ datteti kathayitvā etatkarmma kamapi na jñāpayateti dṛḍhamādiṣṭavān|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ sa tatsthānāt prasthāya svapradeśamāgataḥ śiṣyāśca tatpaścād gatāḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>atha viśrāmavāre sati sa bhajanagṛhe upadeṣṭumārabdhavān tato'neke lokāstatkathāṁ śrutvā vismitya jagaduḥ, asya manujasya īdṛśī āścaryyakriyā kasmāj jātā? tathā svakarābhyām itthamadbhutaṁ karmma karttāुm etasmai kathaṁ jñānaṁ dattam?</para>
  <para style="p">
    <verse number="3" style="v"/>kimayaṁ mariyamaḥ putrastajñā no? kimayaṁ yākūb-yosi-yihudā-śimonāṁ bhrātā no? asya bhaginyaḥ kimihāsmābhiḥ saha no? itthaṁ te tadarthe pratyūhaṁ gatāḥ|</para>
  <para style="p">
    <verse number="4" style="v"/>tadā yīśustebhyo'kathayat svadeśaṁ svakuṭumbān svaparijanāṁśca vinā kutrāpi bhaviṣyadvādī asatkṛto na bhavati|</para>
  <para style="p">
    <verse number="5" style="v"/>aparañca teṣāmapratyayāt sa vismitaḥ kiyatāṁ rogiṇāṁ vapuḥṣu hastam arpayitvā kevalaṁ teṣāmārogyakaraṇād anyat kimapi citrakāryyaṁ karttāṁ na śaktaḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>atha sa caturdikstha grāmān bhramitvā upadiṣṭavān</para>
  <para style="p">
    <verse number="7" style="v"/>dvādaśaśiṣyān āhūya amedhyabhūtān vaśīkarttāṁ śaktiṁ dattvā teṣāṁ dvau dvau jano preṣitavān|</para>
  <para style="p">
    <verse number="8" style="v"/>punarityādiśad yūyam ekaikāṁ yaṣṭiṁ vinā vastrasaṁpuṭaḥ pūpaḥ kaṭibandhe tāmrakhaṇḍañca eṣāṁ kimapi mā grahlīta,</para>
  <para style="p">
    <verse number="9" style="v"/>mārgayātrāyai pādeṣūpānahau dattvā dve uttarīye mā paridhadvvaṁ|</para>
  <para style="p">
    <verse number="10" style="v"/>aparamapyuktaṁ tena yūyaṁ yasyāṁ puryyāṁ yasya niveśanaṁ pravekṣyatha tāṁ purīṁ yāvanna tyakṣyatha tāvat tanniveśane sthāsyatha|</para>
  <para style="p">
    <verse number="11" style="v"/>tatra yadi kepi yuṣmākamātithyaṁ na vidadhati yuṣmākaṁ kathāśca na śṛṇvanti tarhi tatsthānāt prasthānasamaye teṣāṁ viruddhaṁ sākṣyaṁ dātuṁ svapādānāsphālya rajaḥ sampātayata; ahaṁ yuṣmān yathārthaṁ vacmi vicāradine tannagarasyāvasthātaḥ sidomāmorayo rnagarayoravasthā sahyatarā bhaviṣyati|</para>
  <para style="p">
    <verse number="12" style="v"/>atha te gatvā lokānāṁ manaḥparāvarttanīḥ kathā pracāritavantaḥ|</para>
  <para style="p">
    <verse number="13" style="v"/>evamanekān bhūtāṁśca tyājitavantastathā tailena marddayitvā bahūn janānarogānakārṣuḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>itthaṁ tasya sukhyātiścaturdiśo vyāptā tadā herod rājā tanniśamya kathitavān, yohan majjakaḥ śmaśānād utthita atohetostena sarvvā etā adbhutakriyāḥ prakāśante|</para>
  <para style="p">
    <verse number="15" style="v"/>anye'kathayan ayam eliyaḥ, kepi kathitavanta eṣa bhaviṣyadvādī yadvā bhaviṣyadvādināṁ sadṛśa ekoyam|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu herod ityākarṇya bhāṣitavān yasyāhaṁ śiraśchinnavān sa eva yohanayaṁ sa śmaśānādudatiṣṭhat|</para>
  <para style="p">
    <verse number="17" style="v"/>pūrvvaṁ svabhrātuḥ philipasya patnyā udvāhaṁ kṛtavantaṁ herodaṁ yohanavādīt svabhātṛvadhū rna vivāhyā|</para>
  <para style="p">
    <verse number="18" style="v"/>ataḥ kāraṇāt herod lokaṁ prahitya yohanaṁ dhṛtvā bandhanālaye baddhavān|</para>
  <para style="p">
    <verse number="19" style="v"/>herodiyā tasmai yohane prakupya taṁ hantum aicchat kintu na śaktā,</para>
  <para style="p">
    <verse number="20" style="v"/>yasmād herod taṁ dhārmmikaṁ satpuruṣañca jñātvā sammanya rakṣitavān; tatkathāṁ śrutvā tadanusāreṇa bahūni karmmāṇi kṛtavān hṛṣṭamanāstadupadeśaṁ śrutavāṁśca|</para>
  <para style="p">
    <verse number="21" style="v"/>kintu herod yadā svajanmadine pradhānalokebhyaḥ senānībhyaśca gālīlpradeśīyaśreṣṭhalokebhyaśca rātrau bhojyamekaṁ kṛtavān</para>
  <para style="p">
    <verse number="22" style="v"/>tasmin śubhadine herodiyāyāḥ kanyā sametya teṣāṁ samakṣaṁ saṁnṛtya herodastena sahopaviṣṭānāñca toṣamajījanat tatā nṛpaḥ kanyāmāha sma matto yad yācase tadeva tubhyaṁ dāsye|</para>
  <para style="p">
    <verse number="23" style="v"/>śapathaṁ kṛtvākathayat ced rājyārddhamapi yācase tadapi tubhyaṁ dāsye|</para>
  <para style="p">
    <verse number="24" style="v"/>tataḥ sā bahi rgatvā svamātaraṁ papraccha kimahaṁ yāciṣye? tadā sākathayat yohano majjakasya śiraḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>atha tūrṇaṁ bhūpasamīpam etya yācamānāvadat kṣaṇesmin yohano majjakasya śiraḥ pātre nidhāya dehi, etad yāce'haṁ|</para>
  <para style="p">
    <verse number="26" style="v"/>tasmāt bhūpo'tiduḥkhitaḥ, tathāpi svaśapathasya sahabhojināñcānurodhāt tadanaṅgīkarttuṁ na śaktaḥ|</para>
  <para style="p">
    <verse number="27" style="v"/>tatkṣaṇaṁ rājā ghātakaṁ preṣya tasya śira ānetumādiṣṭavān|</para>
  <para style="p">
    <verse number="28" style="v"/>tataḥ sa kārāgāraṁ gatvā tacchiraśchitvā pātre nidhāyānīya tasyai kanyāyai dattavān kanyā ca svamātre dadau|</para>
  <para style="p">
    <verse number="29" style="v"/>ananataraṁ yohanaḥ śiṣyāstadvārttāṁ prāpyāgatya tasya kuṇapaṁ śmaśāne'sthāpayan|</para>
  <para style="p">
    <verse number="30" style="v"/>atha preṣitā yīśoḥ sannidhau militā yad yac cakruḥ śikṣayāmāsuśca tatsarvvavārttāstasmai kathitavantaḥ|</para>
  <para style="p">
    <verse number="31" style="v"/>sa tānuvāca yūyaṁ vijanasthānaṁ gatvā viśrāmyata yatastatsannidhau bahulokānāṁ samāgamāt te bhoktuṁ nāvakāśaṁ prāptāḥ|</para>
  <para style="p">
    <verse number="32" style="v"/>tataste nāvā vijanasthānaṁ guptaṁ gagmuḥ|</para>
  <para style="p">
    <verse number="33" style="v"/>tato lokanivahasteṣāṁ sthānāntarayānaṁ dadarśa, aneke taṁ paricitya nānāpurebhyaḥ padairvrajitvā javena taiṣāmagre yīśoḥ samīpa upatasthuḥ|</para>
  <para style="p">
    <verse number="34" style="v"/>tadā yīśu rnāvo bahirgatya lokāraṇyānīṁ dṛṣṭvā teṣu karuṇāṁ kṛtavān yataste'rakṣakameṣā ivāsan tadā sa tāna nānāprasaṅgān upadiṣṭavān|</para>
  <para style="p">
    <verse number="35" style="v"/>atha divānte sati śiṣyā etya yīśumūcire, idaṁ vijanasthānaṁ dinañcāvasannaṁ|</para>
  <para style="p">
    <verse number="36" style="v"/>lokānāṁ kimapi khādyaṁ nāsti, ataścaturdikṣu grāmān gantuṁ bhojyadravyāṇi kretuñca bhavān tān visṛjatu|</para>
  <para style="p">
    <verse number="37" style="v"/>tadā sa tānuvāca yūyameva tān bhojayata; tataste jagadu rvayaṁ gatvā dviśatasaṁkhyakai rmudrāpādaiḥ pūpān krītvā kiṁ tān bhojayiṣyāmaḥ?</para>
  <para style="p">
    <verse number="38" style="v"/>tadā sa tān pṛṣṭhavān yuṣmākaṁ sannidhau kati pūpā āsate? gatvā paśyata; tataste dṛṣṭvā tamavadan pañca pūpā dvau matsyau ca santi|</para>
  <para style="p">
    <verse number="39" style="v"/>tadā sa lokān śaspopari paṁktibhirupaveśayitum ādiṣṭavān,</para>
  <para style="p">
    <verse number="40" style="v"/>tataste śataṁ śataṁ janāḥ pañcāśat pañcāśajjanāśca paṁktibhi rbhuvi samupaviviśuḥ|</para>
  <para style="p">
    <verse number="41" style="v"/>atha sa tān pañcapūpān matsyadvayañca dhṛtvā svargaṁ paśyan īśvaraguṇān anvakīrttayat tān pūpān bhaṁktvā lokebhyaḥ pariveṣayituṁ śiṣyebhyo dattavān dvā matsyau ca vibhajya sarvvebhyo dattavān|</para>
  <para style="p">
    <verse number="42" style="v"/>tataḥ sarvve bhuktvātṛpyan|</para>
  <para style="p">
    <verse number="43" style="v"/>anantaraṁ śiṣyā avaśiṣṭaiḥ pūpai rmatsyaiśca pūrṇān dvadaśa ḍallakān jagṛhuḥ|</para>
  <para style="p">
    <verse number="44" style="v"/>te bhoktāraḥ prāyaḥ pañca sahasrāṇi puruṣā āsan|</para>
  <para style="p">
    <verse number="45" style="v"/>atha sa lokān visṛjanneva nāvamāroḍhuṁ svasmādagre pāre baitsaidāpuraṁ yātuñca śṣyiाn vāḍhamādiṣṭavān|</para>
  <para style="p">
    <verse number="46" style="v"/>tadā sa sarvvān visṛjya prārthayituṁ parvvataṁ gataḥ|</para>
  <para style="p">
    <verse number="47" style="v"/>tataḥ sandhyāyāṁ satyāṁ nauḥ sindhumadhya upasthitā kintu sa ekākī sthale sthitaḥ|</para>
  <para style="p">
    <verse number="48" style="v"/>atha sammukhavātavahanāt śiṣyā nāvaṁ vāhayitvā pariśrāntā iti jñātvā sa niśācaturthayāme sindhūpari padbhyāṁ vrajan teṣāṁ samīpametya teṣāmagre yātum udyataḥ|</para>
  <para style="p">
    <verse number="49" style="v"/>kintu śiṣyāḥ sindhūpari taṁ vrajantaṁ dṛṣṭvā bhūtamanumāya ruruvuḥ,</para>
  <para style="p">
    <verse number="50" style="v"/>yataḥ sarvve taṁ dṛṣṭvā vyākulitāḥ| ataeva yīśustatkṣaṇaṁ taiḥ sahālapya kathitavān, susthirā bhūta, ayamahaṁ mā bhaiṣṭa|</para>
  <para style="p">
    <verse number="51" style="v"/>atha naukāmāruhya tasmin teṣāṁ sannidhiṁ gate vāto nivṛttaḥ; tasmātte manaḥsu vismitā āścaryyaṁ menire|</para>
  <para style="p">
    <verse number="52" style="v"/>yataste manasāṁ kāṭhinyāt tat pūpīyam āścaryyaṁ karmma na viviktavantaḥ|</para>
  <para style="p">
    <verse number="53" style="v"/>atha te pāraṁ gatvā gineṣaratpradeśametya taṭa upasthitāḥ|</para>
  <para style="p">
    <verse number="54" style="v"/>teṣu naukāto bahirgateṣu tatpradeśīyā lokāstaṁ paricitya</para>
  <para style="p">
    <verse number="55" style="v"/>caturdikṣu dhāvanto yatra yatra rogiṇo narā āsan tān sarvvāna khaṭvopari nidhāya yatra kutracit tadvārttāṁ prāpuḥ tat sthānam ānetum ārebhire|</para>
  <para style="p">
    <verse number="56" style="v"/>tathā yatra yatra grāme yatra yatra pure yatra yatra pallyāñca tena praveśaḥ kṛtastadvartmamadhye lokāḥ pīḍitān sthāpayitvā tasya celagranthimātraṁ spraṣṭum teṣāmarthe tadanujñāṁ prārthayantaḥ yāvanto lokāḥ paspṛśustāvanta eva gadānmuktāḥ|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ yirūśālama āgatāḥ phirūśino'dhyāpakāśca yīśoḥ samīpam āgatāḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>te tasya kiyataḥ śiṣyān aśucikarairarthāda aprakṣālitahastai rbhuñjato dṛṣṭvā tānadūṣayan|</para>
  <para style="p">
    <verse number="3" style="v"/>yataḥ phirūśinaḥ sarvvayihūdīyāśca prācāṁ paramparāgatavākyaṁ sammanya pratalena hastān aprakṣālya na bhuñjate|</para>
  <para style="p">
    <verse number="4" style="v"/>āpanādāgatya majjanaṁ vinā na khādanti; tathā pānapātrāṇāṁ jalapātrāṇāṁ pittalapātrāṇām āsanānāñca jale majjanam ityādayonyepi bahavasteṣāmācārāḥ santi|</para>
  <para style="p">
    <verse number="5" style="v"/>te phirūśino'dhyāpakāśca yīśuṁ papracchuḥ, tava śiṣyāḥ prācāṁ paramparāgatavākyānusāreṇa nācaranto'prakṣālitakaraiḥ kuto bhujaṁte?</para>
  <para style="p">
    <verse number="6" style="v"/>tataḥ sa pratyuvāca kapaṭino yuṣmān uddiśya yiśayiyabhaviṣyadvādī yuktamavādīt| yathā svakīyairadharairete sammanyanate sadaiva māṁ| kintu matto viprakarṣe santi teṣāṁ manāṁsi ca|</para>
  <para style="p">
    <verse number="7" style="v"/>śikṣayanto bidhīn nnājñā bhajante māṁ mudhaiva te|</para>
  <para style="p">
    <verse number="8" style="v"/>yūyaṁ jalapātrapānapātrādīni majjayanto manujaparamparāgatavākyaṁ rakṣatha kintu īśvarājñāṁ laṁghadhve; aparā īdṛśyonekāḥ kriyā api kurudhve|</para>
  <para style="p">
    <verse number="9" style="v"/>anyañcākathayat yūyaṁ svaparamparāgatavākyasya rakṣārthaṁ spaṣṭarūpeṇa īśvarājñāṁ lopayatha|</para>
  <para style="p">
    <verse number="10" style="v"/>yato mūsādvārā proktamasti svapitarau sammanyadhvaṁ yastu mātaraṁ pitaraṁ vā durvvākyaṁ vakti sa nitāntaṁ hanyatāṁ|</para>
  <para style="p">
    <verse number="11" style="v"/>kintu madīyena yena dravyeṇa tavopakārobhavat tat karbbāṇamarthād īśvarāya niveditam idaṁ vākyaṁ yadi kopi pitaraṁ mātaraṁ vā vakti</para>
  <para style="p">
    <verse number="12" style="v"/>tarhi yūyaṁ mātuḥ pitu rvopakāraṁ karttāṁ taṁ vārayatha|</para>
  <para style="p">
    <verse number="13" style="v"/>itthaṁ svapracāritaparamparāgatavākyena yūyam īśvarājñāṁ mudhā vidhadvve, īdṛśānyanyānyanekāni karmmāṇi kurudhve|</para>
  <para style="p">
    <verse number="14" style="v"/>atha sa lokānāhūya babhāṣe yūyaṁ sarvve madvākyaṁ śṛṇuta budhyadhvañca|</para>
  <para style="p">
    <verse number="15" style="v"/>bāhyādantaraṁ praviśya naramamedhyaṁ karttāṁ śaknoti īdṛśaṁ kimapi vastu nāsti, varam antarād bahirgataṁ yadvastu tanmanujam amedhyaṁ karoti|</para>
  <para style="p">
    <verse number="16" style="v"/>yasya śrotuṁ śrotre staḥ sa śṛṇotu|</para>
  <para style="p">
    <verse number="17" style="v"/>tataḥ sa lokān hitvā gṛhamadhyaṁ praviṣṭastadā śiṣyāstadṛṣṭāntavākyārthaṁ papracchuḥ|</para>
  <para style="p">
    <verse number="18" style="v"/>tasmāt sa tān jagāda yūyamapi kimetādṛgabodhāḥ? kimapi dravyaṁ bāhyādantaraṁ praviśya naramamedhyaṁ karttāṁ na śaknoti kathāmimāṁ kiṁ na budhyadhve?</para>
  <para style="p">
    <verse number="19" style="v"/>tat tadantarna praviśati kintu kukṣimadhyaṁ praviśati śeṣe sarvvabhuktavastugrāhiṇi bahirdeśe niryāti|</para>
  <para style="p">
    <verse number="20" style="v"/>aparamapyavādīd yannarānnireti tadeva naramamedhyaṁ karoti|</para>
  <para style="p">
    <verse number="21" style="v"/>yato'ntarād arthān mānavānāṁ manobhyaḥ kucintā parastrīveśyāgamanaṁ</para>
  <para style="p">
    <verse number="22" style="v"/>naravadhaścauryyaṁ lobho duṣṭatā pravañcanā kāmukatā kudṛṣṭirīśvaranindā garvvastama ityādīni nirgacchanti|</para>
  <para style="p">
    <verse number="23" style="v"/>etāni sarvvāṇi duritānyantarādetya naramamedhyaṁ kurvvanti|</para>
  <para style="p">
    <verse number="24" style="v"/>atha sa utthāya tatsthānāt sorasīdonpurapradeśaṁ jagāma tatra kimapi niveśanaṁ praviśya sarvvairajñātaḥ sthātuṁ matiñcakre kintu guptaḥ sthātuṁ na śaśāka|</para>
  <para style="p">
    <verse number="25" style="v"/>yataḥ suraphainikīdeśīyayūnānīvaṁśodbhavastriyāḥ kanyā bhūtagrastāsīt| sā strī tadvārttāṁ prāpya tatsamīpamāgatya taccaraṇayoḥ patitvā</para>
  <para style="p">
    <verse number="26" style="v"/>svakanyāto bhūtaṁ nirākarttāṁ tasmin vinayaṁ kṛtavatī|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu yīśustāmavadat prathamaṁ bālakāstṛpyantu yato bālakānāṁ khādyaṁ gṛhītvā kukkurebhyo nikṣepo'nucitaḥ|</para>
  <para style="p">
    <verse number="28" style="v"/>tadā sā strī tamavādīt bhoḥ prabho tat satyaṁ tathāpi mañcādhaḥsthāḥ kukkurā bālānāṁ karapatitāni khādyakhaṇḍāni khādanti|</para>
  <para style="p">
    <verse number="29" style="v"/>tataḥ so'kathayad etatkathāhetoḥ sakuśalā yāhi tava kanyāṁ tyaktvā bhūto gataḥ|</para>
  <para style="p">
    <verse number="30" style="v"/>atha sā strī gṛhaṁ gatvā kanyāṁ bhūtatyaktāṁ śayyāsthitāṁ dadarśa|</para>
  <para style="p">
    <verse number="31" style="v"/>punaśca sa sorasīdonpurapradeśāt prasthāya dikāpalideśasya prāntarabhāgena gālīljaladheḥ samīpaṁ gatavān|</para>
  <para style="p">
    <verse number="32" style="v"/>tadā lokairekaṁ badhiraṁ kadvadañca naraṁ tannikaṭamānīya tasya gātre hastamarpayituṁ vinayaḥ kṛtaḥ|</para>
  <para style="p">
    <verse number="33" style="v"/>tato yīśu rlokāraṇyāt taṁ nirjanamānīya tasya karṇayoṅgulī rdadau niṣṭhīvaṁ dattvā ca tajjihvāṁ pasparśa|</para>
  <para style="p">
    <verse number="34" style="v"/>anantaraṁ svargaṁ nirīkṣya dīrghaṁ niśvasya tamavadat itaphataḥ arthān mukto bhūyāt|</para>
  <para style="p">
    <verse number="35" style="v"/>tatastatkṣaṇaṁ tasya karṇau muktau jihvāyāśca jāḍyāpagamāt sa suspaṣṭavākyamakathayat|</para>
  <para style="p">
    <verse number="36" style="v"/>atha sa tān vāḍhamityādideśa yūyamimāṁ kathāṁ kasmaicidapi mā kathayata, kintu sa yati nyaṣedhat te tati bāhulyena prācārayan;</para>
  <para style="p">
    <verse number="37" style="v"/>te'ticamatkṛtya parasparaṁ kathayāmāsuḥ sa badhirāya śravaṇaśaktiṁ mūkāya ca kathanaśaktiṁ dattvā sarvvaṁ karmmottamarūpeṇa cakāra|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadā tatsamīpaṁ bahavo lokā āyātā atasteṣāṁ bhojyadravyābhāvād yīśuḥ śiṣyānāhūya jagāda,|</para>
  <para style="p">
    <verse number="2" style="v"/>lokanivahe mama kṛpā jāyate te dinatrayaṁ mayā sārddhaṁ santi teṣāṁ bhojyaṁ kimapi nāsti|</para>
  <para style="p">
    <verse number="3" style="v"/>teṣāṁ madhye'neke dūrād āgatāḥ, abhukteṣu teṣu mayā svagṛhamabhiprahiteṣu te pathi klamiṣyanti|</para>
  <para style="p">
    <verse number="4" style="v"/>śiṣyā avādiṣuḥ, etāvato lokān tarpayitum atra prantare pūpān prāptuṁ kena śakyate?</para>
  <para style="p">
    <verse number="5" style="v"/>tataḥ sa tān papraccha yuṣmākaṁ kati pūpāḥ santi? te'kathayan sapta|</para>
  <para style="p">
    <verse number="6" style="v"/>tataḥ sa tāllokān bhuvi samupaveṣṭum ādiśya tān sapta pūpān dhṛtvā īśvaraguṇān anukīrttayāmāsa, bhaṁktvā pariveṣayituṁ śiṣyān prati dadau, tataste lokebhyaḥ pariveṣayāmāsuḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>tathā teṣāṁ samīpe ye kṣudramatsyā āsan tānapyādāya īśvaraguṇān saṁkīrtya pariveṣayitum ādiṣṭavān|</para>
  <para style="p">
    <verse number="8" style="v"/>tato lokā bhuktvā tṛptiṁ gatā avaśiṣṭakhādyaiḥ pūrṇāḥ saptaḍallakā gṛhītāśca|</para>
  <para style="p">
    <verse number="9" style="v"/>ete bhoktāraḥ prāyaścatuḥ sahasrapuruṣā āsan tataḥ sa tān visasarja|</para>
  <para style="p">
    <verse number="10" style="v"/>atha sa śiṣyaḥ saha nāvamāruhya dalmānūthāsīmāmāgataḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>tataḥ paraṁ phirūśina āgatya tena saha vivadamānāstasya parīkṣārtham ākāśīyacihnaṁ draṣṭuṁ yācitavantaḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>tadā so'ntardīrghaṁ niśvasyākathayat, ete vidyamānanarāḥ kutaścinhaṁ mṛgayante? yuṣmānahaṁ yathārthaṁ bravīmi lokānetān kimapi cihnaṁ na darśayiṣyate|</para>
  <para style="p">
    <verse number="13" style="v"/>atha tān hitvā puna rnāvam āruhya pāramagāt|</para>
  <para style="p">
    <verse number="14" style="v"/>etarhi śiṣyaiḥ pūpeṣu vismṛteṣu nāvi teṣāṁ sannidhau pūpa ekaeva sthitaḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>tadānīṁ yīśustān ādiṣṭavān phirūśināṁ herodaśca kiṇvaṁ prati satarkāḥ sāvadhānāśca bhavata|</para>
  <para style="p">
    <verse number="16" style="v"/>tataste'nyonyaṁ vivecanaṁ kartum ārebhire, asmākaṁ sannidhau pūpo nāstīti hetoridaṁ kathayati|</para>
  <para style="p">
    <verse number="17" style="v"/>tad budvvā yīśustebhyo'kathayat yuṣmākaṁ sthāne pūpābhāvāt kuta itthaṁ vitarkayatha? yūyaṁ kimadyāpi kimapi na jānītha? boddhuñca na śaknutha? yāvadadya kiṁ yuṣmākaṁ manāṁsi kaṭhināni santi?</para>
  <para style="p">
    <verse number="18" style="v"/>satsu netreṣu kiṁ na paśyatha? satsu karṇeṣu kiṁ na śṛṇutha? na smaratha ca?</para>
  <para style="p">
    <verse number="19" style="v"/>yadāhaṁ pañcapūpān pañcasahasrāṇāṁ puruṣāṇāṁ madhye bhaṁktvā dattavān tadānīṁ yūyam avaśiṣṭapūpaiḥ pūrṇān kati ḍallakān gṛhītavantaḥ? te'kathayan dvādaśaḍallakān|</para>
  <para style="p">
    <verse number="20" style="v"/>aparañca yadā catuḥsahasrāṇāṁ puruṣāṇāṁ madhye pūpān bhaṁktvādadāṁ tadā yūyam atiriktapūpānāṁ kati ḍallakān gṛhītavantaḥ? te kathayāmāsuḥ saptaḍallakān|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā sa kathitavān tarhi yūyam adhunāpi kuto bodvvuṁ na śaknutha?</para>
  <para style="p">
    <verse number="22" style="v"/>anantaraṁ tasmin baitsaidānagare prāpte lokā andhamekaṁ naraṁ tatsamīpamānīya taṁ spraṣṭuṁ taṁ prārthayāñcakrire|</para>
  <para style="p">
    <verse number="23" style="v"/>tadā tasyāndhasya karau gṛhītvā nagarād bahirdeśaṁ taṁ nītavān; tannetre niṣṭhīvaṁ dattvā tadgātre hastāvarpayitvā taṁ papraccha, kimapi paśyasi?</para>
  <para style="p">
    <verse number="24" style="v"/>sa netre unmīlya jagāda, vṛkṣavat manujān gacchato nirīkṣe|</para>
  <para style="p">
    <verse number="25" style="v"/>tato yīśuḥ punastasya nayanayo rhastāvarpayitvā tasya netre unmīlayāmāsa; tasmāt sa svastho bhūtvā spaṣṭarūpaṁ sarvvalokān dadarśa|</para>
  <para style="p">
    <verse number="26" style="v"/>tataḥ paraṁ tvaṁ grāmaṁ mā gaccha grāmasthaṁ kamapi ca kimapyanuktvā nijagṛhaṁ yāhītyādiśya yīśustaṁ nijagṛhaṁ prahitavān|</para>
  <para style="p">
    <verse number="27" style="v"/>anantaraṁ śiṣyaiḥ sahito yīśuḥ kaisarīyāphilipipuraṁ jagāma, pathi gacchan tānapṛcchat ko'ham atra lokāḥ kiṁ vadanti?</para>
  <para style="p">
    <verse number="28" style="v"/>te pratyūcuḥ tvāṁ yohanaṁ majjakaṁ vadanti kintu kepi kepi eliyaṁ vadanti; apare kepi kepi bhaviṣyadvādinām eko jana iti vadanti|</para>
  <para style="p">
    <verse number="29" style="v"/>atha sa tānapṛcchat kintu koham? ityatra yūyaṁ kiṁ vadatha? tadā pitaraḥ pratyavadat bhavān abhiṣiktastrātā|</para>
  <para style="p">
    <verse number="30" style="v"/>tataḥ sa tān gāḍhamādiśad yūyaṁ mama kathā kasmaicidapi mā kathayata|</para>
  <para style="p">
    <verse number="31" style="v"/>manuṣyaputreṇāvaśyaṁ bahavo yātanā bhoktavyāḥ prācīnalokaiḥ pradhānayājakairadhyāpakaiśca sa ninditaḥ san ghātayiṣyate tṛtīyadine utthāsyati ca, yīśuḥ śiṣyānupadeṣṭumārabhya kathāmimāṁ spaṣṭamācaṣṭa|</para>
  <para style="p">
    <verse number="32" style="v"/>tasmāt pitarastasya hastau dhṛtvā taṁ tarjjitavān|</para>
  <para style="p">
    <verse number="33" style="v"/>kintu sa mukhaṁ parāvartya śiṣyagaṇaṁ nirīkṣya pitaraṁ tarjayitvāvādīd dūrībhava vighnakārin īśvarīyakāryyādapi manuṣyakāryyaṁ tubhyaṁ rocatatarāṁ|</para>
  <para style="p">
    <verse number="34" style="v"/>atha sa lokān śiṣyāṁścāhūya jagāda yaḥ kaścin māmanugantum icchati sa ātmānaṁ dāmyatu, svakruśaṁ gṛhītvā matpaścād āyātu|</para>
  <para style="p">
    <verse number="35" style="v"/>yato yaḥ kaścit svaprāṇaṁ rakṣitumicchati sa taṁ hārayiṣyati, kintu yaḥ kaścin madarthaṁ susaṁvādārthañca prāṇaṁ hārayati sa taṁ rakṣiṣyati|</para>
  <para style="p">
    <verse number="36" style="v"/>aparañca manujaḥ sarvvaṁ jagat prāpya yadi svaprāṇaṁ hārayati tarhi tasya ko lābhaḥ?</para>
  <para style="p">
    <verse number="37" style="v"/>naraḥ svaprāṇavinimayena kiṁ dātuṁ śaknoti?</para>
  <para style="p">
    <verse number="38" style="v"/>eteṣāṁ vyabhicāriṇāṁ pāpināñca lokānāṁ sākṣād yadi kopi māṁ matkathāñca lajjāspadaṁ jānāti tarhi manujaputro yadā dharmmadūtaiḥ saha pituḥ prabhāveṇāgamiṣyati tadā sopi taṁ lajjāspadaṁ jñāsyati|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha sa tānavādīt yuṣmabhyamahaṁ yathārthaṁ kathayāmi, īśvararājyaṁ parākrameṇopasthitaṁ na dṛṣṭvā mṛtyuṁ nāsvādiṣyante, atra daṇḍāyamānānāṁ madhyepi tādṛśā lokāḥ santi|</para>
  <para style="p">
    <verse number="2" style="v"/>atha ṣaḍdinebhyaḥ paraṁ yīśuḥ pitaraṁ yākūbaṁ yohanañca gṛhītvā gireruccasya nirjanasthānaṁ gatvā teṣāṁ pratyakṣe mūrtyantaraṁ dadhāra|</para>
  <para style="p">
    <verse number="3" style="v"/>tatastasya paridheyam īdṛśam ujjvalahimapāṇaḍaraṁ jātaṁ yad jagati kopi rajako na tādṛk pāṇaḍaraṁ karttāṁ śaknoti|</para>
  <para style="p">
    <verse number="4" style="v"/>aparañca eliyo mūsāśca tebhyo darśanaṁ dattvā yīśunā saha kathanaṁ karttumārebhāte|</para>
  <para style="p">
    <verse number="5" style="v"/>tadā pitaro yīśumavādīt he guro'smākamatra sthitiruttamā, tataeva vayaṁ tvatkṛte ekāṁ mūsākṛte ekām eliyakṛte caikāṁ, etāstisraḥ kuṭī rnirmmāma|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu sa yaduktavān tat svayaṁ na bubudhe tataḥ sarvve bibhayāñcakruḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>etarhi payodastān chādayāmāsa, mamayāṁ priyaḥ putraḥ kathāsu tasya manāṁsi niveśayateti nabhovāṇī tanmedyānniryayau|</para>
  <para style="p">
    <verse number="8" style="v"/>atha haṭhātte caturdiśo dṛṣṭvā yīśuṁ vinā svaiḥ sahitaṁ kamapi na dadṛśuḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>tataḥ paraṁ gireravarohaṇakāle sa tān gāḍham dūtyādideśa yāvannarasūnoḥ śmaśānādutthānaṁ na bhavati, tāvat darśanasyāsya vārttā yuṣmābhiḥ kasmaicidapi na vaktavyā|</para>
  <para style="p">
    <verse number="10" style="v"/>tadā śmaśānādutthānasya kobhiprāya iti vicāryya te tadvākyaṁ sveṣu gopāyāñcakrire|</para>
  <para style="p">
    <verse number="11" style="v"/>atha te yīśuṁ papracchuḥ prathamata eliyenāgantavyam iti vākyaṁ kuta upādhyāyā āhuḥ?</para>
  <para style="p">
    <verse number="12" style="v"/>tadā sa pratyuvāca , eliyaḥ prathamametya sarvvakāryyāṇi sādhayiṣyati; naraputre ca lipi ryathāste tathaiva sopi bahuduḥkhaṁ prāpyāvajñāsyate|</para>
  <para style="p">
    <verse number="13" style="v"/>kintvahaṁ yuṣmān vadāmi , eliyārthe lipi ryathāste tathaiva sa etya yayau, lokā: svecchānurūpaṁ tamabhivyavaharanti sma|</para>
  <para style="p">
    <verse number="14" style="v"/>anantaraṁ sa śiṣyasamīpametya teṣāṁ catuḥpārśve taiḥ saha bahujanān vivadamānān adhyāpakāṁśca dṛṣṭavān;</para>
  <para style="p">
    <verse number="15" style="v"/>kintu sarvvalokāstaṁ dṛṣṭvaiva camatkṛtya tadāsannaṁ dhāvantastaṁ praṇemuḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>tadā yīśuradhyāpakānaprākṣīd etaiḥ saha yūyaṁ kiṁ vivadadhve?</para>
  <para style="p">
    <verse number="17" style="v"/>tato lokānāṁ kaścidekaḥ pratyavādīt he guro mama sūnuṁ mūkaṁ bhūtadhṛtañca bhavadāsannam ānayaṁ|</para>
  <para style="p">
    <verse number="18" style="v"/>yadāsau bhūtastamākramate tadaiva pātasati tathā sa pheṇāyate, dantairdantān gharṣati kṣīṇo bhavati ca; tato hetostaṁ bhūtaṁ tyājayituṁ bhavacchiṣyān niveditavān kintu te na śekuḥ|</para>
  <para style="p">
    <verse number="19" style="v"/>tadā sa tamavādīt, re aviśvāsinaḥ santānā yuṣmābhiḥ saha kati kālānahaṁ sthāsyāmi? aparān kati kālān vā va ācārān sahiṣye? taṁ madāsannamānayata|</para>
  <para style="p">
    <verse number="20" style="v"/>tatastatsannidhiṁ sa ānīyata kintu taṁ dṛṣṭvaiva bhūto bālakaṁ dhṛtavān; sa ca bhūmau patitvā pheṇāyamāno luloṭha|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā sa tatpitaraṁ papraccha, asyedṛśī daśā kati dināni bhūtā? tataḥ sovādīt bālyakālāt|</para>
  <para style="p">
    <verse number="22" style="v"/>bhūtoyaṁ taṁ nāśayituṁ bahuvārān vahnau jale ca nyakṣipat kintu yadi bhavāna kimapi karttāṁ śaknoti tarhi dayāṁ kṛtvāsmān upakarotu|</para>
  <para style="p">
    <verse number="23" style="v"/>tadā yīśustamavadat yadi pratyetuṁ śaknoṣi tarhi pratyayine janāya sarvvaṁ sādhyam|</para>
  <para style="p">
    <verse number="24" style="v"/>tatastatkṣaṇaṁ tadbālakasya pitā proccai rūvan sāśrunetraḥ provāca, prabho pratyemi mamāpratyayaṁ pratikuru|</para>
  <para style="p">
    <verse number="25" style="v"/>atha yīśu rlokasaṅghaṁ dhāvitvāyāntaṁ dṛṣṭvā tamapūtabhūtaṁ tarjayitvā jagāda, re badhira mūka bhūta tvametasmād bahirbhava punaḥ kadāpi māśrayainaṁ tvāmaham ityādiśāmi|</para>
  <para style="p">
    <verse number="26" style="v"/>tadā sa bhūtaścītśabdaṁ kṛtvā tamāpīḍya bahirjajāma, tato bālako mṛtakalpo babhūva tasmādayaṁ mṛta̮ityaneke kathayāmāsuḥ|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu karaṁ dhṛtvā yīśunotthāpitaḥ sa uttasthau|</para>
  <para style="p">
    <verse number="28" style="v"/>atha yīśau gṛhaṁ praviṣṭe śiṣyā guptaṁ taṁ papracchuḥ, vayamenaṁ bhūtaṁ tyājayituṁ kuto na śaktāḥ?</para>
  <para style="p">
    <verse number="29" style="v"/>sa uvāca, prārthanopavāsau vinā kenāpyanyena karmmaṇā bhūtamīdṛśaṁ tyājayituṁ na śakyaṁ|</para>
  <para style="p">
    <verse number="30" style="v"/>anantaraṁ sa tatsthānāditvā gālīlmadhyena yayau, kintu tat kopi jānīyāditi sa naicchat|</para>
  <para style="p">
    <verse number="31" style="v"/>aparañca sa śiṣyānupadiśan babhāṣe, naraputro narahasteṣu samarpayiṣyate te ca taṁ haniṣyanti taistasmin hate tṛtīyadine sa utthāsyatīti|</para>
  <para style="p">
    <verse number="32" style="v"/>kintu tatkathāṁ te nābudhyanta praṣṭuñca bibhyaḥ|</para>
  <para style="p">
    <verse number="33" style="v"/>atha yīśuḥ kapharnāhūmpuramāgatya madhyegṛhañcetya tānapṛcchad vartmamadhye yūyamanyonyaṁ kiṁ vivadadhve sma?</para>
  <para style="p">
    <verse number="34" style="v"/>kintu te niruttarāstasthu ryasmātteṣāṁ ko mukhya iti vartmāni te'nyonyaṁ vyavadanta|</para>
  <para style="p">
    <verse number="35" style="v"/>tataḥ sa upaviśya dvādaśaśiṣyān āhūya babhāṣe yaḥ kaścit mukhyo bhavitumicchati sa sarvvebhyo gauṇaḥ sarvveṣāṁ sevakaśca bhavatu|</para>
  <para style="p">
    <verse number="36" style="v"/>tadā sa bālakamekaṁ gṛhītvā madhye samupāveśayat tatastaṁ kroḍe kṛtvā tānavādāt</para>
  <para style="p">
    <verse number="37" style="v"/>yaḥ kaścidīdṛśasya kasyāpi bālasyātithyaṁ karoti sa mamātithyaṁ karoti; yaḥ kaścinmamātithyaṁ karoti sa kevalam mamātithyaṁ karoti tanna matprerakasyāpyātithyaṁ karoti|</para>
  <para style="p">
    <verse number="38" style="v"/>atha yohan tamabravīt he guro, asmākamananugāminam ekaṁ tvānnāmnā bhūtān tyājayantaṁ vayaṁ dṛṣṭavantaḥ, asmākamapaścādgāmitvācca taṁ nyaṣedhāma|</para>
  <para style="p">
    <verse number="39" style="v"/>kintu yīśuravadat taṁ mā niṣedhat, yato yaḥ kaścin mannāmnā citraṁ karmma karoti sa sahasā māṁ nindituṁ na śaknoti|</para>
  <para style="p">
    <verse number="40" style="v"/>tathā yaḥ kaścid yuṣmākaṁ vipakṣatāṁ na karoti sa yuṣmākameva sapakṣaḥ|</para>
  <para style="p">
    <verse number="41" style="v"/>yaḥ kaścid yuṣmān khrīṣṭaśiṣyān jñātvā mannāmnā kaṁsaikena pānīyaṁ pātuṁ dadāti, yuṣmānahaṁ yathārthaṁ vacmi, sa phalena vañcito na bhaviṣyati|</para>
  <para style="p">
    <verse number="42" style="v"/>kintu yadi kaścin mayi viśvāsināmeṣāṁ kṣudraprāṇinām ekasyāpi vighnaṁ janayati, tarhi tasyaitatkarmma karaṇāt kaṇṭhabaddhapeṣaṇīkasya tasya sāgarāgādhajala majjanaṁ bhadraṁ|</para>
  <para style="p">
    <verse number="43" style="v"/>ataḥ svakaro yadi tvāṁ bādhate tarhi taṁ chindhi;</para>
  <para style="p">
    <verse number="44" style="v"/>yasmāt yatra kīṭā na mriyante vahniśca na nirvvāti, tasmin anirvvāṇānalanarake karadvayavastava gamanāt karahīnasya svargapraveśastava kṣemaṁ|</para>
  <para style="p">
    <verse number="45" style="v"/>yadi tava pādo vighnaṁ janayati tarhi taṁ chindhi,</para>
  <para style="p">
    <verse number="46" style="v"/>yato yatra kīṭā na mriyante vahniśca na nirvvāti, tasmin 'nirvvāṇavahnau narake dvipādavatastava nikṣepāt pādahīnasya svargapraveśastava kṣemaṁ|</para>
  <para style="p">
    <verse number="47" style="v"/>svanetraṁ yadi tvāṁ bādhate tarhi tadapyutpāṭaya, yato yatra kīṭā na mriyante vahniśca na nirvvāti,</para>
  <para style="p">
    <verse number="48" style="v"/>tasmina 'nirvvāṇavahnau narake dvinetrasya tava nikṣepād ekanetravata īśvararājye praveśastava kṣemaṁ|</para>
  <para style="p">
    <verse number="49" style="v"/>yathā sarvvo bali rlavaṇāktaḥ kriyate tathā sarvvo jano vahnirūpeṇa lavaṇāktaḥ kāriṣyate|</para>
  <para style="p">
    <verse number="50" style="v"/>lavaṇaṁ bhadraṁ kintu yadi lavaṇe svādutā na tiṣṭhati, tarhi katham āsvādyuktaṁ kariṣyatha? yūyaṁ lavaṇayuktā bhavata parasparaṁ prema kuruta|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ sa tatsthānāt prasthāya yarddananadyāḥ pāre yihūdāpradeśa upasthitavān, tatra tadantike lokānāṁ samāgame jāte sa nijarītyanusāreṇa punastān upadideśa|</para>
  <para style="p">
    <verse number="2" style="v"/>tadā phirūśinastatsamīpam etya taṁ parīkṣituṁ papracchaḥ svajāyā manujānāṁ tyajyā na veti?</para>
  <para style="p">
    <verse number="3" style="v"/>tataḥ sa pratyavādīt, atra kāryye mūsā yuṣmān prati kimājñāpayat?</para>
  <para style="p">
    <verse number="4" style="v"/>ta ūcuḥ tyāgapatraṁ lekhituṁ svapatnīṁ tyaktuñca mūsā'numanyate|</para>
  <para style="p">
    <verse number="5" style="v"/>tadā yīśuḥ pratyuvāca, yuṣmākaṁ manasāṁ kāṭhinyāddheto rmūsā nideśamimam alikhat|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu sṛṣṭerādau īśvaro narān puṁrūpeṇa strīrūpeṇa ca sasarja|</para>
  <para style="p">
    <verse number="7" style="v"/>"tataḥ kāraṇāt pumān pitaraṁ mātarañca tyaktvā svajāyāyām āsakto bhaviṣyati,</para>
  <para style="p">
    <verse number="8" style="v"/>tau dvāv ekāṅgau bhaviṣyataḥ|" tasmāt tatkālamārabhya tau na dvāv ekāṅgau|</para>
  <para style="p">
    <verse number="9" style="v"/>ataḥ kāraṇād īśvaro yadayojayat kopi narastanna viyejayet|</para>
  <para style="p">
    <verse number="10" style="v"/>atha yīśu rgṛhaṁ praviṣṭastadā śiṣyāḥ punastatkathāṁ taṁ papracchuḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>tataḥ sovadat kaścid yadi svabhāryyāṁ tyaktavānyām udvahati tarhi sa svabhāryyāyāḥ prātikūlyena vyabhicārī bhavati|</para>
  <para style="p">
    <verse number="12" style="v"/>kācinnārī yadi svapatiṁ hitvānyapuṁsā vivāhitā bhavati tarhi sāpi vyabhicāriṇī bhavati|</para>
  <para style="p">
    <verse number="13" style="v"/>atha sa yathā śiśūn spṛśet, tadarthaṁ lokaistadantikaṁ śiśava ānīyanta, kintu śiṣyāstānānītavatastarjayāmāsuḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>yīśustad dṛṣṭvā krudhyan jagāda, mannikaṭam āgantuṁ śiśūn mā vārayata, yata etādṛśā īśvararājyādhikāriṇaḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>yuṣmānahaṁ yathārthaṁ vacmi, yaḥ kaścit śiśuvad bhūtvā rājyamīśvarasya na gṛhlīyāt sa kadāpi tadrājyaṁ praveṣṭuṁ na śaknoti|</para>
  <para style="p">
    <verse number="16" style="v"/>ananataraṁ sa śiśūnaṅke nidhāya teṣāṁ gātreṣu hastau dattvāśiṣaṁ babhāṣe|</para>
  <para style="p">
    <verse number="17" style="v"/>atha sa vartmanā yāti, etarhi jana eko dhāvan āgatya tatsammukhe jānunī pātayitvā pṛṣṭavān, bhoḥ paramaguro, anantāyuḥ prāptaye mayā kiṁ karttavyaṁ?</para>
  <para style="p">
    <verse number="18" style="v"/>tadā yīśuruvāca, māṁ paramaṁ kuto vadasi? vineśvaraṁ kopi paramo na bhavati|</para>
  <para style="p">
    <verse number="19" style="v"/>parastrīṁ nābhigaccha; naraṁ mā ghātaya; steyaṁ mā kuru; mṛṣāsākṣyaṁ mā dehi; hiṁsāñca mā kuru; pitarau sammanyasva; nideśā ete tvayā jñātāḥ|</para>
  <para style="p">
    <verse number="20" style="v"/>tatastana pratyuktaṁ, he guro bālyakālādahaṁ sarvvānetān ācarāmi|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā yīśustaṁ vilokya snehena babhāṣe, tavaikasyābhāva āste; tvaṁ gatvā sarvvasvaṁ vikrīya daridrebhyo viśrāṇaya, tataḥ svarge dhanaṁ prāpsyasi; tataḥ param etya kruśaṁ vahan madanuvarttī bhava|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu tasya bahusampadvidyamānatvāt sa imāṁ kathāmākarṇya viṣaṇo duḥkhitaśca san jagāma|</para>
  <para style="p">
    <verse number="23" style="v"/>atha yīśuścaturdiśo nirīkṣya śiṣyān avādīt, dhanilokānām īśvararājyapraveśaḥ kīdṛg duṣkaraḥ|</para>
  <para style="p">
    <verse number="24" style="v"/>tasya kathātaḥ śiṣyāścamaccakruḥ, kintu sa punaravadat, he bālakā ye dhane viśvasanti teṣām īśvararājyapraveśaḥ kīdṛg duṣkaraḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>īśvararājye dhanināṁ praveśāt sūcirandhreṇa mahāṅgasya gamanāgamanaṁ sukaraṁ|</para>
  <para style="p">
    <verse number="26" style="v"/>tadā śiṣyā atīva vismitāḥ parasparaṁ procuḥ, tarhi kaḥ paritrāṇaṁ prāptuṁ śaknoti?</para>
  <para style="p">
    <verse number="27" style="v"/>tato yīśustān vilokya babhāṣe, tan narasyāsādhyaṁ kintu neśvarasya, yato hetorīśvarasya sarvvaṁ sādhyam|</para>
  <para style="p">
    <verse number="28" style="v"/>tadā pitara uvāca, paśya vayaṁ sarvvaṁ parityajya bhavatonugāmino jātāḥ|</para>
  <para style="p">
    <verse number="29" style="v"/>tato yīśuḥ pratyavadat, yuṣmānahaṁ yathārthaṁ vadāmi, madarthaṁ susaṁvādārthaṁ vā yo janaḥ sadanaṁ bhrātaraṁ bhaginīṁ pitaraṁ mātaraṁ jāyāṁ santānān bhūmi vā tyaktvā</para>
  <para style="p">
    <verse number="30" style="v"/>gṛhabhrātṛbhaginīpitṛmātṛpatnīsantānabhūmīnāmiha śataguṇān pretyānantāyuśca na prāpnoti tādṛśaḥ kopi nāsti|</para>
  <para style="p">
    <verse number="31" style="v"/>kintvagrīyā aneke lokāḥ śeṣāḥ, śeṣīyā aneke lokāścāgrā bhaviṣyanti|</para>
  <para style="p">
    <verse number="32" style="v"/>atha yirūśālamyānakāle yīśusteṣām agragāmī babhūva, tasmātte citraṁ jñātvā paścādgāmino bhūtvā bibhyuḥ| tadā sa puna rdvādaśaśiṣyān gṛhītvā svīyaṁ yadyad ghaṭiṣyate tattat tebhyaḥ kathayituṁ prārebhe;</para>
  <para style="p">
    <verse number="33" style="v"/>paśyata vayaṁ yirūśālampuraṁ yāmaḥ, tatra manuṣyaputraḥ pradhānayājakānām upādhyāyānāñca kareṣu samarpayiṣyate; te ca vadhadaṇḍājñāṁ dāpayitvā paradeśīyānāṁ kareṣu taṁ samarpayiṣyanti|</para>
  <para style="p">
    <verse number="34" style="v"/>te tamupahasya kaśayā prahṛtya tadvapuṣi niṣṭhīvaṁ nikṣipya taṁ haniṣyanti, tataḥ sa tṛtīyadine protthāsyati|</para>
  <para style="p">
    <verse number="35" style="v"/>tataḥ sivadeḥ putrau yākūbyohanau tadantikam etya procatuḥ, he guro yad āvābhyāṁ yāciṣyate tadasmadarthaṁ bhavān karotu nivedanamidamāvayoḥ|</para>
  <para style="p">
    <verse number="36" style="v"/>tataḥ sa kathitavān, yuvāṁ kimicchathaḥ? kiṁ mayā yuṣmadarthaṁ karaṇīyaṁ?</para>
  <para style="p">
    <verse number="37" style="v"/>tadā tau procatuḥ, āvayorekaṁ dakṣiṇapārśve vāmapārśve caikaṁ tavaiśvaryyapade samupaveṣṭum ājñāpaya|</para>
  <para style="p">
    <verse number="38" style="v"/>kintu yīśuḥ pratyuvāca yuvāmajñātvedaṁ prārthayethe, yena kaṁsenāhaṁ pāsyāmi tena yuvābhyāṁ kiṁ pātuṁ śakṣyate? yasmin majjanenāhaṁ majjiṣye tanmajjane majjayituṁ kiṁ yuvābhyāṁ śakṣyate? tau pratyūcatuḥ śakṣyate|</para>
  <para style="p">
    <verse number="39" style="v"/>tadā yīśuravadat yena kaṁsenāhaṁ pāsyāmi tenāvaśyaṁ yuvāmapi pāsyathaḥ, yena majjanena cāhaṁ majjiyye tatra yuvāmapi majjiṣyethe|</para>
  <para style="p">
    <verse number="40" style="v"/>kintu yeṣāmartham idaṁ nirūpitaṁ, tān vihāyānyaṁ kamapi mama dakṣiṇapārśve vāmapārśve vā samupaveśayituṁ mamādhikāro nāsti|</para>
  <para style="p">
    <verse number="41" style="v"/>athānyadaśaśiṣyā imāṁ kathāṁ śrutvā yākūbyohanbhyāṁ cukupuḥ|</para>
  <para style="p">
    <verse number="42" style="v"/>kintu yīśustān samāhūya babhāṣe, anyadeśīyānāṁ rājatvaṁ ye kurvvanti te teṣāmeva prabhutvaṁ kurvvanti, tathā ye mahālokāste teṣām adhipatitvaṁ kurvvantīti yūyaṁ jānītha|</para>
  <para style="p">
    <verse number="43" style="v"/>kintu yuṣmākaṁ madhye na tathā bhaviṣyati, yuṣmākaṁ madhye yaḥ prādhānyaṁ vāñchati sa yuṣmākaṁ sevako bhaviṣyati,</para>
  <para style="p">
    <verse number="44" style="v"/>yuṣmākaṁ yo mahān bhavitumicchati sa sarvveṣāṁ kiṅkaro bhaviṣyati|</para>
  <para style="p">
    <verse number="45" style="v"/>yato manuṣyaputraḥ sevyo bhavituṁ nāgataḥ sevāṁ karttāṁ tathānekeṣāṁ paritrāṇasya mūlyarūpasvaprāṇaṁ dātuñcāgataḥ|</para>
  <para style="p">
    <verse number="46" style="v"/>atha te yirīhonagaraṁ prāptāstasmāt śiṣyai rlokaiśca saha yīśo rgamanakāle ṭīmayasya putro barṭīmayanāmā andhastanmārgapārśve bhikṣārtham upaviṣṭaḥ|</para>
  <para style="p">
    <verse number="47" style="v"/>sa nāsaratīyasya yīśorāgamanavārttāṁ prāpya procai rvaktumārebhe, he yīśo dāyūdaḥ santāna māṁ dayasva|</para>
  <para style="p">
    <verse number="48" style="v"/>tatoneke lokā maunībhaveti taṁ tarjayāmāsuḥ, kintu sa punaradhikamuccai rjagāda, he yīśo dāyūdaḥ santāna māṁ dayasva|</para>
  <para style="p">
    <verse number="49" style="v"/>tadā yīśuḥ sthitvā tamāhvātuṁ samādideśa, tato lokāstamandhamāhūya babhāṣire, he nara, sthiro bhava, uttiṣṭha, sa tvāmāhvayati|</para>
  <para style="p">
    <verse number="50" style="v"/>tadā sa uttarīyavastraṁ nikṣipya protthāya yīśoḥ samīpaṁ gataḥ|</para>
  <para style="p">
    <verse number="51" style="v"/>tato yīśustamavadat tvayā kiṁ prārthyate? tubhyamahaṁ kiṁ kariṣyāmī? tadā sondhastamuvāca, he guro madīyā dṛṣṭirbhavet|</para>
  <para style="p">
    <verse number="52" style="v"/>tato yīśustamuvāca yāhi tava viśvāsastvāṁ svasthamakārṣīt, tasmāt tatkṣaṇaṁ sa dṛṣṭiṁ prāpya pathā yīśoḥ paścād yayau|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ teṣu yirūśālamaḥ samīpasthayo rbaitphagībaithanīyapurayorantikasthaṁ jaitunanāmādrimāgateṣu yīśuḥ preṣaṇakāle dvau śiṣyāvidaṁ vākyaṁ jagāda,</para>
  <para style="p">
    <verse number="2" style="v"/>yuvāmamuṁ sammukhasthaṁ grāmaṁ yātaṁ, tatra praviśya yo naraṁ nāvahat taṁ garddabhaśāvakaṁ drakṣyathastaṁ mocayitvānayataṁ|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu yuvāṁ karmmedaṁ kutaḥ kuruthaḥ? kathāmimāṁ yadi kopi pṛcchati tarhi prabhoratra prayojanamastīti kathite sa śīghraṁ tamatra preṣayiṣyati|</para>
  <para style="p">
    <verse number="4" style="v"/>tatastau gatvā dvimārgamelane kasyacid dvārasya pārśve taṁ garddabhaśāvakaṁ prāpya mocayataḥ,</para>
  <para style="p">
    <verse number="5" style="v"/>etarhi tatropasthitalokānāṁ kaścid apṛcchat, garddabhaśiśuṁ kuto mocayathaḥ?</para>
  <para style="p">
    <verse number="6" style="v"/>tadā yīśorājñānusāreṇa tebhyaḥ pratyudite tatkṣaṇaṁ tamādātuṁ te'nujajñuḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>atha tau yīśoḥ sannidhiṁ garddabhaśiśum ānīya tadupari svavastrāṇi pātayāmāsatuḥ; tataḥ sa tadupari samupaviṣṭaḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>tadāneke pathi svavāsāṁsi pātayāmāsuḥ, paraiśca taruśākhāśchitavā mārge vikīrṇāḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>aparañca paścādgāmino'gragāminaśca sarvve janā ucaiḥsvareṇa vaktumārebhire, jaya jaya yaḥ parameśvarasya nāmnāgacchati sa dhanya iti|</para>
  <para style="p">
    <verse number="10" style="v"/>tathāsmākamaṁ pūrvvapuruṣasya dāyūdo yadrājyaṁ parameśvaranāmnāyāti tadapi dhanyaṁ, sarvvasmāducchrāye svarge īśvarasya jayo bhavet|</para>
  <para style="p">
    <verse number="11" style="v"/>itthaṁ yīśu ryirūśālami mandiraṁ praviśya caturdiksthāni sarvvāṇi vastūni dṛṣṭavān; atha sāyaṁkāla upasthite dvādaśaśiṣyasahito baithaniyaṁ jagāma|</para>
  <para style="p">
    <verse number="12" style="v"/>aparehani baithaniyād āgamanasamaye kṣudhārtto babhūva|</para>
  <para style="p">
    <verse number="13" style="v"/>tato dūre sapatramuḍumbarapādapaṁ vilokya tatra kiñcit phalaṁ prāptuṁ tasya sannikṛṣṭaṁ yayau, tadānīṁ phalapātanasya samayo nāgacchati| tatastatropasthitaḥ patrāṇi vinā kimapyaparaṁ na prāpya sa kathitavān,</para>
  <para style="p">
    <verse number="14" style="v"/>adyārabhya kopi mānavastvattaḥ phalaṁ na bhuñjīta; imāṁ kathāṁ tasya śiṣyāḥ śuśruvuḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>tadanantaraṁ teṣu yirūśālamamāyāteṣu yīśu rmandiraṁ gatvā tatrasthānāṁ baṇijāṁ mudrāsanāni pārāvatavikretṛṇām āsanāni ca nyubjayāñcakāra sarvvān kretṛn vikretṛṁśca bahiścakāra|</para>
  <para style="p">
    <verse number="16" style="v"/>aparaṁ mandiramadhyena kimapi pātraṁ voḍhuṁ sarvvajanaṁ nivārayāmāsa|</para>
  <para style="p">
    <verse number="17" style="v"/>lokānupadiśan jagāda, mama gṛhaṁ sarvvajātīyānāṁ prārthanāgṛham iti nāmnā prathitaṁ bhaviṣyati etat kiṁ śāstre likhitaṁ nāsti? kintu yūyaṁ tadeva corāṇāṁ gahvaraṁ kurutha|</para>
  <para style="p">
    <verse number="18" style="v"/>imāṁ vāṇīṁ śrutvādhyāpakāḥ pradhānayājakāśca taṁ yathā nāśayituṁ śaknuvanti tathoेpāyaṁ mṛgayāmāsuḥ, kintu tasyopadeśāt sarvve lokā vismayaṁ gatā ataste tasmād bibhyuḥ|</para>
  <para style="p">
    <verse number="19" style="v"/>atha sāyaṁsamaya upasthite yīśurnagarād bahirvavrāja|</para>
  <para style="p">
    <verse number="20" style="v"/>anantaraṁ prātaḥkāle te tena mārgeṇa gacchantastamuḍumbaramahīruhaṁ samūlaṁ śuṣkaṁ dadṛśuḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>tataḥ pitaraḥ pūrvvavākyaṁ smaran yīśuṁ babhāṣaṁ, he guro paśyatu ya uḍumbaraviṭapī bhavatā śaptaḥ sa śuṣko babhūva|</para>
  <para style="p">
    <verse number="22" style="v"/>tato yīśuḥ pratyavādīt, yūyamīśvare viśvasita|</para>
  <para style="p">
    <verse number="23" style="v"/>yuṣmānahaṁ yathārthaṁ vadāmi kopi yadyetadgiriṁ vadati, tvamutthāya gatvā jaladhau pata, proktamidaṁ vākyamavaśyaṁ ghaṭiṣyate, manasā kimapi na sandihya cedidaṁ viśvaset tarhi tasya vākyānusāreṇa tad ghaṭiṣyate|</para>
  <para style="p">
    <verse number="24" style="v"/>ato hetorahaṁ yuṣmān vacmi, prārthanākāle yadyadākāṁkṣiṣyadhve tattadavaśyaṁ prāpsyatha, itthaṁ viśvasita, tataḥ prāpsyatha|</para>
  <para style="p">
    <verse number="25" style="v"/>aparañca yuṣmāsu prārthayituṁ samutthiteṣu yadi kopi yuṣmākam aparādhī tiṣṭhati, tarhi taṁ kṣamadhvaṁ, tathā kṛte yuṣmākaṁ svargasthaḥ pitāpi yuṣmākamāgāṁmi kṣamiṣyate|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu yadi na kṣamadhve tarhi vaḥ svargasthaḥ pitāpi yuṣmākamāgāṁsi na kṣamiṣyate|</para>
  <para style="p">
    <verse number="27" style="v"/>anantaraṁ te puna ryirūśālamaṁ praviviśuḥ, yīśu ryadā madhyemandiram itastato gacchati, tadānīṁ pradhānayājakā upādhyāyāḥ prāñcaśca tadantikametya kathāmimāṁ papracchuḥ,</para>
  <para style="p">
    <verse number="28" style="v"/>tvaṁ kenādeśena karmmāṇyetāni karoṣi? tathaitāni karmmāṇi karttāṁ kenādiṣṭosi?</para>
  <para style="p">
    <verse number="29" style="v"/>tato yīśuḥ pratigaditavān ahamapi yuṣmān ekakathāṁ pṛcchāmi, yadi yūyaṁ tasyā uttaraṁ kurutha, tarhi kayājñayāhaṁ karmmāṇyetāni karomi tad yuṣmabhyaṁ kathayiṣyāmi|</para>
  <para style="p">
    <verse number="30" style="v"/>yohano majjanam īśvarāt jātaṁ kiṁ mānavāt? tanmahyaṁ kathayata|</para>
  <para style="p">
    <verse number="31" style="v"/>te parasparaṁ vivektuṁ prārebhire, tad īśvarād babhūveti ced vadāmastarhi kutastaṁ na pratyaita? kathametāṁ kathayiṣyati|</para>
  <para style="p">
    <verse number="32" style="v"/>mānavād abhavaditi ced vadāmastarhi lokebhyo bhayamasti yato hetoḥ sarvve yohanaṁ satyaṁ bhaviṣyadvādinaṁ manyante|</para>
  <para style="p">
    <verse number="33" style="v"/>ataeva te yīśuṁ pratyavādiṣu rvayaṁ tad vaktuṁ na śaknumaḥ| yīśuruvāca, tarhi yenādeśena karmmāṇyetāni karomi, ahamapi yuṣmabhyaṁ tanna kathayiṣyāmi|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ yīśu rdṛṣṭāntena tebhyaḥ kathayitumārebhe, kaścideko drākṣākṣetraṁ vidhāya taccaturdikṣu vāraṇīṁ kṛtvā tanmadhye drākṣāpeṣaṇakuṇḍam akhanat, tathā tasya gaḍamapi nirmmitavān tatastatkṣetraṁ kṛṣīvaleṣu samarpya dūradeśaṁ jagāma|</para>
  <para style="p">
    <verse number="2" style="v"/>tadanantaraṁ phalakāle kṛṣīvalebhyo drākṣākṣetraphalāni prāptuṁ teṣāṁ savidhe bhṛtyam ekaṁ prāhiṇot|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu kṛṣīvalāstaṁ dhṛtvā prahṛtya riktahastaṁ visasṛjuḥ|</para>
  <para style="p">
    <verse number="4" style="v"/>tataḥ sa punaranyamekaṁ bhṛtyaṁ praṣayāmāsa, kintu te kṛṣīvalāḥ pāṣāṇāghātaistasya śiro bhaṅktvā sāpamānaṁ taṁ vyasarjan|</para>
  <para style="p">
    <verse number="5" style="v"/>tataḥ paraṁ soparaṁ dāsaṁ prāhiṇot tadā te taṁ jaghnuḥ, evam anekeṣāṁ kasyacit prahāraḥ kasyacid vadhaśca taiḥ kṛtaḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>tataḥ paraṁ mayā svaputre prahite te tamavaśyaṁ sammaṁsyante, ityuktvāvaśeṣe teṣāṁ sannidhau nijapriyam advitīyaṁ putraṁ preṣayāmāsa|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu kṛṣīvalāḥ parasparaṁ jagaduḥ, eṣa uttarādhikārī, āgacchata vayamenaṁ hanmastathā kṛte 'dhikāroyam asmākaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="8" style="v"/>tatastaṁ dhṛtvā hatvā drākṣākṣetrād bahiḥ prākṣipan|</para>
  <para style="p">
    <verse number="9" style="v"/>anenāsau drākṣākṣetrapatiḥ kiṁ kariṣyati? sa etya tān kṛṣīvalān saṁhatya tatkṣetram anyeṣu kṛṣīvaleṣu samarpayiṣyati|</para>
  <para style="p">
    <verse number="10" style="v"/>aparañca, "sthapatayaḥ kariṣyanti grāvāṇaṁ yantu tucchakaṁ| prādhānaprastaraḥ koṇe sa eva saṁbhaviṣyati|</para>
  <para style="p">
    <verse number="11" style="v"/>etat karmma pareśasyāṁdbhutaṁ no dṛṣṭito bhavet||" imāṁ śāstrīyāṁ lipiṁ yūyaṁ kiṁ nāpāṭhiṣṭa?</para>
  <para style="p">
    <verse number="12" style="v"/>tadānīṁ sa tānuddiśya tāṁ dṛṣṭāntakathāṁ kathitavān, ta itthaṁ budvvā taṁ dharttāmudyatāḥ, kintu lokebhyo bibhyuḥ, tadanantaraṁ te taṁ vihāya vavrajuḥ|</para>
  <para style="p">
    <verse number="13" style="v"/>aparañca te tasya vākyadoṣaṁ dharttāṁ katipayān phirūśino herodīyāṁśca lokān tadantikaṁ preṣayāmāsuḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>ta āgatya tamavadan, he guro bhavān tathyabhāṣī kasyāpyanurodhaṁ na manyate, pakṣapātañca na karoti, yathārthata īśvarīyaṁ mārgaṁ darśayati vayametat prajānīmaḥ, kaisarāya karo deyo na vāṁ? vayaṁ dāsyāmo na vā?</para>
  <para style="p">
    <verse number="15" style="v"/>kintu sa teṣāṁ kapaṭaṁ jñātvā jagāda, kuto māṁ parīkṣadhve? ekaṁ mudrāpādaṁ samānīya māṁ darśayata|</para>
  <para style="p">
    <verse number="16" style="v"/>tadā tairekasmin mudrāpāde samānīte sa tān papraccha, atra likhitaṁ nāma mūrtti rvā kasya? te pratyūcuḥ, kaisarasya|</para>
  <para style="p">
    <verse number="17" style="v"/>tadā yīśuravadat tarhi kaisarasya dravyāṇi kaisarāya datta, īśvarasya dravyāṇi tu īśvarāya datta; tataste vismayaṁ menire|</para>
  <para style="p">
    <verse number="18" style="v"/>atha mṛtānāmutthānaṁ ye na manyante te sidūkino yīśoḥ samīpamāgatya taṁ papracchuḥ;</para>
  <para style="p">
    <verse number="19" style="v"/>he guro kaścijjano yadi niḥsantatiḥ san bhāryyāyāṁ satyāṁ mriyate tarhi tasya bhrātā tasya bhāryyāṁ gṛhītvā bhrātu rvaṁśotpattiṁ kariṣyati, vyavasthāmimāṁ mūsā asmān prati vyalikhat|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu kecit sapta bhrātara āsan, tatasteṣāṁ jyeṣṭhabhrātā vivahya niḥsantatiḥ san amriyata|</para>
  <para style="p">
    <verse number="21" style="v"/>tato dvitīyo bhrātā tāṁ striyamagṛhaṇat kintu sopi niḥsantatiḥ san amriyata; atha tṛtīyopi bhrātā tādṛśobhavat|</para>
  <para style="p">
    <verse number="22" style="v"/>itthaṁ saptaiva bhrātarastāṁ striyaṁ gṛhītvā niḥsantānāḥ santo'mriyanta, sarvvaśeṣe sāpi strī mriyate sma|</para>
  <para style="p">
    <verse number="23" style="v"/>atha mṛtānāmutthānakāle yadā ta utthāsyanti tadā teṣāṁ kasya bhāryyā sā bhaviṣyati? yataste saptaiva tāṁ vyavahan|</para>
  <para style="p">
    <verse number="24" style="v"/>tato yīśuḥ pratyuvāca śāstram īśvaraśaktiñca yūyamajñātvā kimabhrāmyata na?</para>
  <para style="p">
    <verse number="25" style="v"/>mṛtalokānāmutthānaṁ sati te na vivahanti vāgdattā api na bhavanti, kintu svargīyadūtānāṁ sadṛśā bhavanti|</para>
  <para style="p">
    <verse number="26" style="v"/>punaśca "aham ibrāhīma īśvara ishāka īśvaro yākūbaśceśvaraḥ" yāmimāṁ kathāṁ stambamadhye tiṣṭhan īśvaro mūsāmavādīt mṛtānāmutthānārthe sā kathā mūsālikhite pustake kiṁ yuṣmābhi rnāpāṭhi?</para>
  <para style="p">
    <verse number="27" style="v"/>īśvaro jīvatāṁ prabhuḥ kintu mṛtānāṁ prabhu rna bhavati, tasmāddheto ryūyaṁ mahābhrameṇa tiṣṭhatha|</para>
  <para style="p">
    <verse number="28" style="v"/>etarhi ekodhyāpaka etya teṣāmitthaṁ vicāraṁ śuśrāva; yīśusteṣāṁ vākyasya saduttaraṁ dattavān iti budvvā taṁ pṛṣṭavān sarvvāsām ājñānāṁ kā śreṣṭhā? tato yīśuḥ pratyuvāca,</para>
  <para style="p">
    <verse number="29" style="v"/>"he isrāyellokā avadhatta, asmākaṁ prabhuḥ parameśvara eka eva,</para>
  <para style="p">
    <verse number="30" style="v"/>yūyaṁ sarvvantaḥkaraṇaiḥ sarvvaprāṇaiḥ sarvvacittaiḥ sarvvaśaktibhiśca tasmin prabhau parameśvare prīyadhvaṁ," ityājñā śreṣṭhā|</para>
  <para style="p">
    <verse number="31" style="v"/>tathā "svaprativāsini svavat prema kurudhvaṁ," eṣā yā dvitīyājñā sā tādṛśī; etābhyāṁ dvābhyām ājñābhyām anyā kāpyājñā śreṣṭhā nāsti|</para>
  <para style="p">
    <verse number="32" style="v"/>tadā sodhyāpakastamavadat, he guro satyaṁ bhavān yathārthaṁ proktavān yata ekasmād īśvarād anyo dvitīya īśvaro nāsti;</para>
  <para style="p">
    <verse number="33" style="v"/>aparaṁ sarvvāntaḥkaraṇaiḥ sarvvaprāṇaiḥ sarvvacittaiḥ sarvvaśaktibhiśca īśvare premakaraṇaṁ tathā svamīpavāsini svavat premakaraṇañca sarvvebhyo homabalidānādibhyaḥ śraṣṭhaṁ bhavati|</para>
  <para style="p">
    <verse number="34" style="v"/>tato yīśuḥ subuddheriva tasyedam uttaraṁ śrutvā taṁ bhāṣitavān tvamīśvarasya rājyānna dūrosi|itaḥ paraṁ tena saha kasyāpi vākyasya vicāraṁ karttāṁ kasyāpi pragalbhatā na jātā|</para>
  <para style="p">
    <verse number="35" style="v"/>anantaraṁ madhyemandiram upadiśan yīśurimaṁ praśnaṁ cakāra, adhyāpakā abhiṣiktaṁ (tārakaṁ) kuto dāyūdaḥ santānaṁ vadanti?</para>
  <para style="p">
    <verse number="36" style="v"/>svayaṁ dāyūd pavitrasyātmana āveśenedaṁ kathayāmāsa| yathā| "mama prabhumidaṁ vākyavadat parameśvaraḥ| tava śatrūnahaṁ yāvat pādapīṭhaṁ karomi na| tāvat kālaṁ madīye tvaṁ dakṣapārśv upāviśa|"</para>
  <para style="p">
    <verse number="37" style="v"/>yadi dāyūd taṁ prabhūṁ vadati tarhi kathaṁ sa tasya santāno bhavitumarhati? itare lokāstatkathāṁ śrutvānananduḥ|</para>
  <para style="p">
    <verse number="38" style="v"/>tadānīṁ sa tānupadiśya kathitavān ye narā dīrghaparidheyāni haṭṭe vipanau ca</para>
  <para style="p">
    <verse number="39" style="v"/>lokakṛtanamaskārān bhajanagṛhe pradhānāsanāni bhojanakāle pradhānasthānāni ca kāṅkṣante;</para>
  <para style="p">
    <verse number="40" style="v"/>vidhavānāṁ sarvvasvaṁ grasitvā chalād dīrghakālaṁ prārthayante tebhya upādhyāyebhyaḥ sāvadhānā bhavata; te'dhikatarān daṇḍān prāpsyanti|</para>
  <para style="p">
    <verse number="41" style="v"/>tadanantaraṁ lokā bhāṇḍāgāre mudrā yathā nikṣipanti bhāṇḍāgārasya sammukhe samupaviśya yīśustadavaluloka; tadānīṁ bahavo dhaninastasya madhye bahūni dhanāni nirakṣipan|</para>
  <para style="p">
    <verse number="42" style="v"/>paścād ekā daridrā vidhavā samāgatya dvipaṇamūlyāṁ mudraikāṁ tatra nirakṣipat|</para>
  <para style="p">
    <verse number="43" style="v"/>tadā yīśuḥ śiṣyān āhūya kathitavān yuṣmānahaṁ yathārthaṁ vadāmi ye ye bhāṇḍāgāre'smina dhanāni niḥkṣipanti sma tebhyaḥ sarvvebhya iyaṁ vidhavā daridrādhikam niḥkṣipati sma|</para>
  <para style="p">
    <verse number="44" style="v"/>yataste prabhūtadhanasya kiñcit nirakṣipan kintu dīneyaṁ svadinayāpanayogyaṁ kiñcidapi na sthāpayitvā sarvvasvaṁ nirakṣipat|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ mandirād bahirgamanakāle tasya śiṣyāṇāmekastaṁ vyāhṛtavān he guro paśyatu kīdṛśāḥ pāṣāṇāḥ kīdṛk ca nicayanaṁ|</para>
  <para style="p">
    <verse number="2" style="v"/>tadā yīśustam avadat tvaṁ kimetad bṛhannicayanaṁ paśyasi? asyaikapāṣāṇopi dvitīyapāṣāṇopari na sthāsyati sarvve 'dhaḥkṣepsyante|</para>
  <para style="p">
    <verse number="3" style="v"/>atha yasmin kāle jaitungirau mandirasya sammukhe sa samupaviṣṭastasmin kāle pitaro yākūb yohan āndriyaścaite taṁ rahasi papracchuḥ,</para>
  <para style="p">
    <verse number="4" style="v"/>etā ghaṭanāḥ kadā bhaviṣyanti? tathaitatsarvvāsāṁ siddhyupakramasya vā kiṁ cihnaṁ? tadasmabhyaṁ kathayatu bhavān|</para>
  <para style="p">
    <verse number="5" style="v"/>tato yāśustān vaktumārebhe, kopi yathā yuṣmān na bhrāmayati tathātra yūyaṁ sāvadhānā bhavata|</para>
  <para style="p">
    <verse number="6" style="v"/>yataḥ khrīṣṭohamiti kathayitvā mama nāmnāneke samāgatya lokānāṁ bhramaṁ janayiṣyanti;</para>
  <para style="p">
    <verse number="7" style="v"/>kintu yūyaṁ raṇasya vārttāṁ raṇāḍambarañca śrutvā mā vyākulā bhavata, ghaṭanā etā avaśyammāvinyaḥ; kintvāpātato na yugānto bhaviṣyati|</para>
  <para style="p">
    <verse number="8" style="v"/>deśasya vipakṣatayā deśo rājyasya vipakṣatayā ca rājyamutthāsyati, tathā sthāne sthāne bhūmikampo durbhikṣaṁ mahākleśāśca samupasthāsyanti, sarvva ete duḥkhasyārambhāḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu yūyam ātmārthe sāvadhānāstiṣṭhata, yato lokā rājasabhāyāṁ yuṣmān samarpayiṣyanti, tathā bhajanagṛhe prahariṣyanti; yūyaṁ madarthe deśādhipān bhūpāṁśca prati sākṣyadānāya teṣāṁ sammukhe upasthāpayiṣyadhve|</para>
  <para style="p">
    <verse number="10" style="v"/>śeṣībhavanāt pūrvvaṁ sarvvān deśīyān prati susaṁvādaḥ pracārayiṣyate|</para>
  <para style="p">
    <verse number="11" style="v"/>kintu yadā te yuṣmān dhṛtvā samarpayiṣyanti tadā yūyaṁ yadyad uttaraṁ dāsyatha, tadagra tasya vivecanaṁ mā kuruta tadarthaṁ kiñcidapi mā cintayata ca, tadānīṁ yuṣmākaṁ manaḥsu yadyad vākyam upasthāpayiṣyate tadeva vadiṣyatha, yato yūyaṁ na tadvaktāraḥ kintu pavitra ātmā tasya vaktā|</para>
  <para style="p">
    <verse number="12" style="v"/>tadā bhrātā bhrātaraṁ pitā putraṁ ghātanārthaṁ parahasteṣu samarpayiṣyate, tathā patyāni mātāpitro rvipakṣatayā tau ghātayiṣyanti|</para>
  <para style="p">
    <verse number="13" style="v"/>mama nāmahetoḥ sarvveṣāṁ savidhe yūyaṁ jugupsitā bhaviṣyatha, kintu yaḥ kaścit śeṣaparyyantaṁ dhairyyam ālambiṣyate saeva paritrāsyate|</para>
  <para style="p">
    <verse number="14" style="v"/>dāniyelbhaviṣyadvādinā proktaṁ sarvvanāśi jugupsitañca vastu yadā tvayogyasthāne vidyamānaṁ drakṣatha (yo janaḥ paṭhati sa budhyatāṁ) tadā ye yihūdīyadeśe tiṣṭhanti te mahīdhraṁ prati palāyantāṁ;</para>
  <para style="p">
    <verse number="15" style="v"/>tathā yo naro gṛhopari tiṣṭhati sa gṛhamadhyaṁ nāvarohatu, tathā kimapi vastu grahītuṁ madhyegṛhaṁ na praviśatu;</para>
  <para style="p">
    <verse number="16" style="v"/>tathā ca yo naraḥ kṣetre tiṣṭhati sopi svavastraṁ grahītuṁ parāvṛtya na vrajatu|</para>
  <para style="p">
    <verse number="17" style="v"/>tadānīṁ garbbhavatīnāṁ stanyadātrīṇāñca yoṣitāṁ durgati rbhaviṣyati|</para>
  <para style="p">
    <verse number="18" style="v"/>yuṣmākaṁ palāyanaṁ śītakāle yathā na bhavati tadarthaṁ prārthayadhvaṁ|</para>
  <para style="p">
    <verse number="19" style="v"/>yatastadā yādṛśī durghaṭanā ghaṭiṣyate tādṛśī durghaṭanā īśvarasṛṣṭeḥ prathamamārabhyādya yāvat kadāpi na jātā na janiṣyate ca|</para>
  <para style="p">
    <verse number="20" style="v"/>aparañca parameśvaro yadi tasya samayasya saṁkṣepaṁ na karoti tarhi kasyāpi prāṇabhṛto rakṣā bhavituṁ na śakṣyati, kintu yān janān manonītān akarot teṣāṁ svamanonītānāṁ hetoḥ sa tadanehasaṁ saṁkṣepsyati|</para>
  <para style="p">
    <verse number="21" style="v"/>anyacca paśyata khrīṣṭotra sthāne vā tatra sthāne vidyate, tasminkāle yadi kaścid yuṣmān etādṛśaṁ vākyaṁ vyāharati, tarhi tasmin vākye bhaiva viśvasita|</para>
  <para style="p">
    <verse number="22" style="v"/>yatoneke mithyākhrīṣṭā mithyābhaviṣyadvādinaśca samupasthāya bahūni cihnānyadbhutāni karmmāṇi ca darśayiṣyanti; tathā yadi sambhavati tarhi manonītalokānāmapi mithyāmatiṁ janayiṣyanti|</para>
  <para style="p">
    <verse number="23" style="v"/>paśyata ghaṭanātaḥ pūrvvaṁ sarvvakāryyasya vārttāṁ yuṣmabhyamadām, yūyaṁ sāvadhānāstiṣṭhata|</para>
  <para style="p">
    <verse number="24" style="v"/>aparañca tasya kleśakālasyāvyavahite parakāle bhāskaraḥ sāndhakāro bhaviṣyati tathaiva candraścandrikāṁ na dāsyati|</para>
  <para style="p">
    <verse number="25" style="v"/>nabhaḥsthāni nakṣatrāṇi patiṣyanti, vyomamaṇḍalasthā grahāśca vicaliṣyanti|</para>
  <para style="p">
    <verse number="26" style="v"/>tadānīṁ mahāparākrameṇa mahaiśvaryyeṇa ca meghamāruhya samāyāntaṁ mānavasutaṁ mānavāḥ samīkṣiṣyante|</para>
  <para style="p">
    <verse number="27" style="v"/>anyacca sa nijadūtān prahitya nabhobhūmyoḥ sīmāṁ yāvad jagataścaturdigbhyaḥ svamanonītalokān saṁgrahīṣyati|</para>
  <para style="p">
    <verse number="28" style="v"/>uḍumbarataro rdṛṣṭāntaṁ śikṣadhvaṁ yadoḍumbarasya taro rnavīnāḥ śākhā jāyante pallavādīni ca rnigacchanti, tadā nidāghakālaḥ savidho bhavatīti yūyaṁ jñātuṁ śaknutha|</para>
  <para style="p">
    <verse number="29" style="v"/>tadvad etā ghaṭanā dṛṣṭvā sa kālo dvāryyupasthita iti jānīta|</para>
  <para style="p">
    <verse number="30" style="v"/>yuṣmānahaṁ yathārthaṁ vadāmi, ādhunikalokānāṁ gamanāt pūrvvaṁ tāni sarvvāṇi ghaṭiṣyante|</para>
  <para style="p">
    <verse number="31" style="v"/>dyāvāpṛthivyo rvicalitayoḥ satyo rmadīyā vāṇī na vicaliṣyati|</para>
  <para style="p">
    <verse number="32" style="v"/>aparañca svargasthadūtagaṇo vā putro vā tātādanyaḥ kopi taṁ divasaṁ taṁ daṇḍaṁ vā na jñāpayati|</para>
  <para style="p">
    <verse number="33" style="v"/>ataḥ sa samayaḥ kadā bhaviṣyati, etajjñānābhāvād yūyaṁ sāvadhānāstiṣṭhata, satarkāśca bhūtvā prārthayadhvaṁ;</para>
  <para style="p">
    <verse number="34" style="v"/>yadvat kaścit pumān svaniveśanād dūradeśaṁ prati yātrākaraṇakāle dāseṣu svakāryyasya bhāramarpayitvā sarvvān sve sve karmmaṇi niyojayati; aparaṁ dauvārikaṁ jāgarituṁ samādiśya yāti, tadvan naraputraḥ|</para>
  <para style="p">
    <verse number="35" style="v"/>gṛhapatiḥ sāyaṁkāle niśīthe vā tṛtīyayāme vā prātaḥkāle vā kadāgamiṣyati tad yūyaṁ na jānītha;</para>
  <para style="p">
    <verse number="36" style="v"/>sa haṭhādāgatya yathā yuṣmān nidritān na paśyati, tadarthaṁ jāgaritāstiṣṭhata|</para>
  <para style="p">
    <verse number="37" style="v"/>yuṣmānahaṁ yad vadāmi tadeva sarvvān vadāmi, jāgaritāstiṣṭhateti|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadā nistārotsavakiṇvahīnapūpotsavayorārambhasya dinadvaye 'vaśiṣṭe pradhānayājakā adhyāpakāśca kenāpi chalena yīśuṁ dharttāṁ hantuñca mṛgayāñcakrire;</para>
  <para style="p">
    <verse number="2" style="v"/>kintu lokānāṁ kalahabhayādūcire, nacotsavakāla ucitametaditi|</para>
  <para style="p">
    <verse number="3" style="v"/>anantaraṁ baithaniyāpuुre śimonakuṣṭhino gṛhe yośau bhotkumupaviṣṭe sati kācid yoṣit pāṇḍarapāṣāṇasya sampuṭakena mahārghyottamatailam ānīya sampuṭakaṁ bhaṁktvā tasyottamāṅge tailadhārāṁ pātayāñcakre|</para>
  <para style="p">
    <verse number="4" style="v"/>tasmāt kecit svānte kupyantaḥ kathitavaṁntaḥ kutoyaṁ tailāpavyayaḥ?</para>
  <para style="p">
    <verse number="5" style="v"/>yadyetat taila vyakreṣyata tarhi mudrāpādaśatatrayādapyadhikaṁ tasya prāptamūlyaṁ daridralokebhyo dātumaśakṣyata, kathāmetāṁ kathayitvā tayā yoṣitā sākaṁ vācāyuhyan|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu yīśuruvāca, kuta etasyai kṛcchraṁ dadāsi? mahyamiyaṁ karmmottamaṁ kṛtavatī|</para>
  <para style="p">
    <verse number="7" style="v"/>daridrāḥ sarvvadā yuṣmābhiḥ saha tiṣṭhanti, tasmād yūyaṁ yadecchatha tadaiva tānupakarttāṁ śaknutha, kintvahaṁ yubhābhiḥ saha nirantaraṁ na tiṣṭhāmi|</para>
  <para style="p">
    <verse number="8" style="v"/>asyā yathāsādhyaṁ tathaivākarodiyaṁ, śmaśānayāpanāt pūrvvaṁ sametya madvapuṣi tailam amarddayat|</para>
  <para style="p">
    <verse number="9" style="v"/>ahaṁ yuṣmabhyaṁ yathārthaṁ kathayāmi, jagatāṁ madhye yatra yatra susaṁvādoyaṁ pracārayiṣyate tatra tatra yoṣita etasyāḥ smaraṇārthaṁ tatkṛtakarmmaitat pracārayiṣyate|</para>
  <para style="p">
    <verse number="10" style="v"/>tataḥ paraṁ dvādaśānāṁ śiṣyāṇāmeka īṣkariyotīyayihūdākhyo yīśuṁ parakareṣu samarpayituṁ pradhānayājakānāṁ samīpamiyāya|</para>
  <para style="p">
    <verse number="11" style="v"/>te tasya vākyaṁ samākarṇya santuṣṭāḥ santastasmai mudrā dātuṁ pratyajānata; tasmāt sa taṁ teṣāṁ kareṣu samarpaṇāyopāyaṁ mṛgayāmāsa|</para>
  <para style="p">
    <verse number="12" style="v"/>anantaraṁ kiṇvaśūnyapūpotsavasya prathame'hani nistārotmavārthaṁ meṣamāraṇāsamaye śiṣyāstaṁ papracchaḥ kutra gatvā vayaṁ nistārotsavasya bhojyamāsādayiṣyāmaḥ? kimicchati bhavān?</para>
  <para style="p">
    <verse number="13" style="v"/>tadānīṁ sa teṣāṁ dvayaṁ prerayan babhāṣe yuvayoḥ puramadhyaṁ gatayoḥ sato ryo janaḥ sajalakumbhaṁ vahan yuvāṁ sākṣāt kariṣyati tasyaiva paścād yātaṁ;</para>
  <para style="p">
    <verse number="14" style="v"/>sa yat sadanaṁ pravekṣyati tadbhavanapatiṁ vadataṁ, gururāha yatra saśiṣyohaṁ nistārotsavīyaṁ bhojanaṁ kariṣyāmi, sā bhojanaśālā kutrāsti?</para>
  <para style="p">
    <verse number="15" style="v"/>tataḥ sa pariṣkṛtāṁ susajjitāṁ bṛhatīcañca yāṁ śālāṁ darśayiṣyati tasyāmasmadarthaṁ bhojyadravyāṇyāsādayataṁ|</para>
  <para style="p">
    <verse number="16" style="v"/>tataḥ śiṣyau prasthāya puraṁ praviśya sa yathoktavān tathaiva prāpya nistārotsavasya bhojyadravyāṇi samāsādayetām|</para>
  <para style="p">
    <verse number="17" style="v"/>anantaraṁ yīśuḥ sāyaṁkāle dvādaśabhiḥ śiṣyaiḥ sārddhaṁ jagāma;</para>
  <para style="p">
    <verse number="18" style="v"/>sarvveṣu bhojanāya propaviṣṭeṣu sa tānuditavān yuṣmānahaṁ yathārthaṁ vyāharāmi, atra yuṣmākameko jano yo mayā saha bhuṁkte māṁ parakereṣu samarpayiṣyate|</para>
  <para style="p">
    <verse number="19" style="v"/>tadānīṁ te duḥkhitāḥ santa ekaikaśastaṁ praṣṭumārabdhavantaḥ sa kimahaṁ? paścād anya ekobhidadhe sa kimahaṁ?</para>
  <para style="p">
    <verse number="20" style="v"/>tataḥ sa pratyavadad eteṣāṁ dvādaśānāṁ yo jano mayā samaṁ bhojanāpātre pāṇiṁ majjayiṣyati sa eva|</para>
  <para style="p">
    <verse number="21" style="v"/>manujatanayamadhi yādṛśaṁ likhitamāste tadanurūpā gatistasya bhaviṣyati, kintu yo jano mānavasutaṁ samarpayiṣyate hanta tasya janmābhāve sati bhadramabhaviṣyat|</para>
  <para style="p">
    <verse number="22" style="v"/>aparañca teṣāṁ bhojanasamaye yīśuḥ pūpaṁ gṛhītveśvaraguṇān anukīrtya bhaṅktvā tebhyo dattvā babhāṣe, etad gṛhītvā bhuñjīdhvam etanmama vigraharūpaṁ|</para>
  <para style="p">
    <verse number="23" style="v"/>anantaraṁ sa kaṁsaṁ gṛhītveśvarasya guṇān kīrttayitvā tebhyo dadau, tataste sarvve papuḥ|</para>
  <para style="p">
    <verse number="24" style="v"/>aparaṁ sa tānavādīd bahūnāṁ nimittaṁ pātitaṁ mama navīnaniyamarūpaṁ śoṇitametat|</para>
  <para style="p">
    <verse number="25" style="v"/>yuṣmānahaṁ yathārthaṁ vadāmi, īśvarasya rājye yāvat sadyojātaṁ drākṣārasaṁ na pāsyāmi,tāvadahaṁ drākṣāphalarasaṁ puna rna pāsyāmi|</para>
  <para style="p">
    <verse number="26" style="v"/>tadanantaraṁ te gītamekaṁ saṁgīya bahi rjaitunaṁ śikhariṇaṁ yayuḥ</para>
  <para style="p">
    <verse number="27" style="v"/>atha yīśustānuvāca niśāyāmasyāṁ mayi yuṣmākaṁ sarvveṣāṁ pratyūho bhaviṣyati yato likhitamāste yathā, meṣāṇāṁ rakṣakañcāhaṁ prahariṣyāmi vai tataḥ| meṣāṇāṁ nivaho nūnaṁ pravikīrṇo bhaviṣyati|</para>
  <para style="p">
    <verse number="28" style="v"/>kantu madutthāne jāte yuṣmākamagre'haṁ gālīlaṁ vrajiṣyāmi|</para>
  <para style="p">
    <verse number="29" style="v"/>tadā pitaraḥ pratibabhāṣe, yadyapi sarvveṣāṁ pratyūho bhavati tathāpi mama naiva bhaviṣyati|</para>
  <para style="p">
    <verse number="30" style="v"/>tato yīśuruktāvān ahaṁ tubhyaṁ tathyaṁ kathayāmi, kṣaṇādāyāmadya kukkuṭasya dvitīyavāraravaṇāt pūrvvaṁ tvaṁ vāratrayaṁ māmapahnoṣyase|</para>
  <para style="p">
    <verse number="31" style="v"/>kintu sa gāḍhaṁ vyāharad yadyapi tvayā sārddhaṁ mama prāṇo yāti tathāpi kathamapi tvāṁ nāpahnoṣye; sarvve'pītare tathaiva babhāṣire|</para>
  <para style="p">
    <verse number="32" style="v"/>aparañca teṣu getśimānīnāmakaṁ sthāna gateṣu sa śiṣyān jagāda, yāvadahaṁ prārthaye tāvadatra sthāne yūyaṁ samupaviśata|</para>
  <para style="p">
    <verse number="33" style="v"/>atha sa pitaraṁ yākūbaṁ yohanañca gṛhītvā vavrāja; atyantaṁ trāsito vyākulitaśca tebhyaḥ kathayāmāsa,</para>
  <para style="p">
    <verse number="34" style="v"/>nidhanakālavat prāṇo me'tīva daḥkhameti, yūyaṁ jāgratotra sthāne tiṣṭhata|</para>
  <para style="p">
    <verse number="35" style="v"/>tataḥ sa kiñciddūraṁ gatvā bhūmāvadhomukhaḥ patitvā prārthitavānetat, yadi bhavituṁ śakyaṁ tarhi duḥkhasamayoyaṁ matto dūrībhavatu|</para>
  <para style="p">
    <verse number="36" style="v"/>aparamuditavān he pita rhe pitaḥ sarvveṁ tvayā sādhyaṁ, tato hetorimaṁ kaṁsaṁ matto dūrīkuru, kintu tan mamecchāto na tavecchāto bhavatu|</para>
  <para style="p">
    <verse number="37" style="v"/>tataḥ paraṁ sa etya tān nidritān nirīkṣya pitaraṁ provāca, śimon tvaṁ kiṁ nidrāsi? ghaṭikāmekām api jāgarituṁ na śaknoṣi?</para>
  <para style="p">
    <verse number="38" style="v"/>parīkṣāyāṁ yathā na patatha tadarthaṁ sacetanāḥ santaḥ prārthayadhvaṁ; mana udyuktamiti satyaṁ kintu vapuraśaktikaṁ|</para>
  <para style="p">
    <verse number="39" style="v"/>atha sa punarvrajitvā pūrvvavat prārthayāñcakre|</para>
  <para style="p">
    <verse number="40" style="v"/>parāvṛtyāgatya punarapi tān nidritān dadarśa tadā teṣāṁ locanāni nidrayā pūrṇāni, tasmāttasmai kā kathā kathayitavyā ta etad boddhuṁ na śekuḥ|</para>
  <para style="p">
    <verse number="41" style="v"/>tataḥparaṁ tṛtīyavāraṁ āgatya tebhyo 'kathayad idānīmapi śayitvā viśrāmyatha? yatheṣṭaṁ jātaṁ, samayaścopasthitaḥ paśyata mānavatanayaḥ pāpilokānāṁ pāṇiṣu samarpyate|</para>
  <para style="p">
    <verse number="42" style="v"/>uttiṣṭhata, vayaṁ vrajāmo yo jano māṁ parapāṇiṣu samarpayiṣyate paśyata sa samīpamāyātaḥ|</para>
  <para style="p">
    <verse number="43" style="v"/>imāṁ kathāṁ kathayati sa, etarhidvādaśānāmeko yihūdā nāmā śiṣyaḥ pradhānayājakānām upādhyāyānāṁ prācīnalokānāñca sannidheḥ khaṅgalaguḍadhāriṇo bahulokān gṛhītvā tasya samīpa upasthitavān|</para>
  <para style="p">
    <verse number="44" style="v"/>aparañcāsau parapāṇiṣu samarpayitā pūrvvamiti saṅketaṁ kṛtavān yamahaṁ cumbiṣyāmi sa evāsau tameva dhṛtvā sāvadhānaṁ nayata|</para>
  <para style="p">
    <verse number="45" style="v"/>ato hetoḥ sa āgatyaiva yośoḥ savidhaṁ gatvā he guro he guro, ityuktvā taṁ cucumba|</para>
  <para style="p">
    <verse number="46" style="v"/>tadā te tadupari pāṇīnarpayitvā taṁ dadhnuḥ|</para>
  <para style="p">
    <verse number="47" style="v"/>tatastasya pārśvasthānāṁ lokānāmekaḥ khaṅgaṁ niṣkoṣayan mahāyājakasya dāsamekaṁ prahṛtya tasya karṇaṁ ciccheda|</para>
  <para style="p">
    <verse number="48" style="v"/>paścād yīśustān vyājahāra khaṅgān laguḍāṁśca gṛhītvā māṁ kiṁ cauraṁ dharttāṁ samāyātāḥ?</para>
  <para style="p">
    <verse number="49" style="v"/>madhyemandiraṁ samupadiśan pratyahaṁ yuṣmābhiḥ saha sthitavānatahaṁ, tasmin kāle yūyaṁ māṁ nādīdharata, kintvanena śāstrīyaṁ vacanaṁ sedhanīyaṁ|</para>
  <para style="p">
    <verse number="50" style="v"/>tadā sarvve śiṣyāstaṁ parityajya palāyāñcakrire|</para>
  <para style="p">
    <verse number="51" style="v"/>athaiko yuvā mānavo nagnakāye vastramekaṁ nidhāya tasya paścād vrajan yuvalokai rdhṛto</para>
  <para style="p">
    <verse number="52" style="v"/>vastraṁ vihāya nagnaḥ palāyāñcakre|</para>
  <para style="p">
    <verse number="53" style="v"/>aparañca yasmin sthāne pradhānayājakā upādhyāyāḥ prācīnalokāśca mahāyājakena saha sadasi sthitāstasmin sthāne mahāyājakasya samīpaṁ yīśuṁ ninyuḥ|</para>
  <para style="p">
    <verse number="54" style="v"/>pitaro dūre tatpaścād itvā mahāyājakasyāṭṭālikāṁ praviśya kiṅkaraiḥ sahopaviśya vahnitāpaṁ jagrāha|</para>
  <para style="p">
    <verse number="55" style="v"/>tadānīṁ pradhānayājakā mantriṇaśca yīśuṁ ghātayituṁ tatprātikūlyena sākṣiṇo mṛgayāñcakrire, kintu na prāptāḥ|</para>
  <para style="p">
    <verse number="56" style="v"/>anekaistadviruddhaṁ mṛṣāsākṣye dattepi teṣāṁ vākyāni na samagacchanta|</para>
  <para style="p">
    <verse number="57" style="v"/>sarvvaśeṣe kiyanta utthāya tasya prātikūlyena mṛṣāsākṣyaṁ dattvā kathayāmāsuḥ,</para>
  <para style="p">
    <verse number="58" style="v"/>idaṁ karakṛtamandiraṁ vināśya dinatrayamadhye punaraparam akarakṛtaṁ mandiraṁ nirmmāsyāmi, iti vākyam asya mukhāt śrutamasmābhiriti|</para>
  <para style="p">
    <verse number="59" style="v"/>kintu tatrāpi teṣāṁ sākṣyakathā na saṅgātāḥ|</para>
  <para style="p">
    <verse number="60" style="v"/>atha mahāyājako madhyesabham utthāya yīśuṁ vyājahāra, ete janāstvayi yat sākṣyamaduḥ tvametasya kimapyuttaraṁ kiṁ na dāsyasi?</para>
  <para style="p">
    <verse number="61" style="v"/>kintu sa kimapyuttaraṁ na datvā maunībhūya tasyau; tato mahāyājakaḥ punarapi taṁ pṛṣṭāvān tvaṁ saccidānandasya tanayo 'bhiṣiktastratā?</para>
  <para style="p">
    <verse number="62" style="v"/>tadā yīśustaṁ provāca bhavāmyaham yūyañca sarvvaśaktimato dakṣīṇapārśve samupaviśantaṁ megha māruhya samāyāntañca manuṣyaputraṁ sandrakṣyatha|</para>
  <para style="p">
    <verse number="63" style="v"/>tadā mahāyājakaḥ svaṁ vamanaṁ chitvā vyāvaharat</para>
  <para style="p">
    <verse number="64" style="v"/>kimasmākaṁ sākṣibhiḥ prayojanam? īśvaranindāvākyaṁ yuṣmābhiraśrāvi kiṁ vicārayatha? tadānīṁ sarvve jagadurayaṁ nidhanadaṇḍamarhati|</para>
  <para style="p">
    <verse number="65" style="v"/>tataḥ kaścit kaścit tadvapuṣi niṣṭhīvaṁ nicikṣepa tathā tanmukhamācchādya capeṭena hatvā gaditavān gaṇayitvā vada, anucarāśca capeṭaistamājaghnuḥ</para>
  <para style="p">
    <verse number="66" style="v"/>tataḥ paraṁ pitare'ṭṭālikādhaḥkoṣṭhe tiṣṭhati mahāyājakasyaikā dāsī sametya</para>
  <para style="p">
    <verse number="67" style="v"/>taṁ vihnitāpaṁ gṛhlantaṁ vilokya taṁ sunirīkṣya babhāṣe tvamapi nāsaratīyayīśoḥ saṅginām eko jana āsīḥ|</para>
  <para style="p">
    <verse number="68" style="v"/>kintu sopahnutya jagāda tamahaṁ na vadmi tvaṁ yat kathayami tadapyahaṁ na buddhye| tadānīṁ pitare catvaraṁ gatavati kuेkkuṭo rurāva|</para>
  <para style="p">
    <verse number="69" style="v"/>athānyā dāsī pitaraṁ dṛṣṭvā samīpasthān janān jagāda ayaṁ teṣāmeko janaḥ|</para>
  <para style="p">
    <verse number="70" style="v"/>tataḥ sa dvitīyavāram apahnutavān paścāt tatrasthā lokāḥ pitaraṁ procustvamavaśyaṁ teṣāmeko janaḥ yatastvaṁ gālīlīyo nara iti tavoccāraṇaṁ prakāśayati|</para>
  <para style="p">
    <verse number="71" style="v"/>tadā sa śapathābhiśāpau kṛtvā provāca yūyaṁ kathāṁ kathayatha taṁ naraṁ na jāne'haṁ|</para>
  <para style="p">
    <verse number="72" style="v"/>tadānīṁ dvitīyavāraṁ kukkuṭo 'rāvīt| kukkuṭasya dvitīyaravāt pūrvvaṁ tvaṁ māṁ vāratrayam apahnoṣyasi, iti yadvākyaṁ yīśunā samuditaṁ tat tadā saṁsmṛtya pitaro roditum ārabhata|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha prabhāte sati pradhānayājakāḥ prāñca upādhyāyāḥ sarvve mantriṇaśca sabhāṁ kṛtvā yīśuृṁ bandhayitva pīlātākhyasya deśādhipateḥ savidhaṁ nītvā samarpayāmāsuḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>tadā pīlātastaṁ pṛṣṭavān tvaṁ kiṁ yihūdīyalokānāṁ rājā? tataḥ sa pratyuktavān satyaṁ vadasi|</para>
  <para style="p">
    <verse number="3" style="v"/>aparaṁ pradhānayājakāstasya bahuṣu vākyeṣu doṣamāropayāñcakruḥ kintu sa kimapi na pratyuvāca|</para>
  <para style="p">
    <verse number="4" style="v"/>tadānīṁ pīlātastaṁ punaḥ papraccha tvaṁ kiṁ nottarayasi? paśyaite tvadviruddhaṁ katiṣu sādhyeṣu sākṣaṁ dadati|</para>
  <para style="p">
    <verse number="5" style="v"/>kantu yīśustadāpi nottaraṁ dadau tataḥ pīlāta āścaryyaṁ jagāma|</para>
  <para style="p">
    <verse number="6" style="v"/>aparañca kārābaddhe kastiṁścit jane tanmahotsavakāle lokai ryācite deśādhipatistaṁ mocayati|</para>
  <para style="p">
    <verse number="7" style="v"/>ye ca pūrvvamupaplavamakārṣurupaplave vadhamapi kṛtavantasteṣāṁ madhye tadānoṁ barabbānāmaka eko baddha āsīt|</para>
  <para style="p">
    <verse number="8" style="v"/>ato hetoḥ pūrvvāparīyāṁ rītikathāṁ kathayitvā lokā uccairuvantaḥ pīlātasya samakṣaṁ nivedayāmāsuḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>tadā pīlātastānācakhyau tarhi kiṁ yihūdīyānāṁ rājānaṁ mocayiṣyāmi? yuṣmābhiḥ kimiṣyate?</para>
  <para style="p">
    <verse number="10" style="v"/>yataḥ pradhānayājakā īrṣyāta eva yīśuṁ samārpayanniti sa viveda|</para>
  <para style="p">
    <verse number="11" style="v"/>kintu yathā barabbāṁ mocayati tathā prārthayituṁ pradhānayājakā lokān pravarttayāmāsuḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>atha pīlātaḥ punaḥ pṛṣṭavān tarhi yaṁ yihūdīyānāṁ rājeti vadatha tasya kiṁ kariṣyāmi yuṣmābhiḥ kimiṣyate?</para>
  <para style="p">
    <verse number="13" style="v"/>tadā te punarapi proccaiḥ procustaṁ kruśe vedhaya|</para>
  <para style="p">
    <verse number="14" style="v"/>tasmāt pīlātaḥ kathitavān kutaḥ? sa kiṁ kukarmma kṛtavān? kintu te punaśca ruvanto vyājahrustaṁ kruśe vedhaya|</para>
  <para style="p">
    <verse number="15" style="v"/>tadā pīlātaḥ sarvvāllokān toṣayitumicchan barabbāṁ mocayitvā yīśuṁ kaśābhiḥ prahṛtya kruśe veddhuṁ taṁ samarpayāmbabhūva|</para>
  <para style="p">
    <verse number="16" style="v"/>anantaraṁ sainyagaṇo'ṭṭālikām arthād adhipate rgṛhaṁ yīśuṁ nītvā senānivahaṁ samāhuyat|</para>
  <para style="p">
    <verse number="17" style="v"/>paścāt te taṁ dhūmalavarṇavastraṁ paridhāpya kaṇṭakamukuṭaṁ racayitvā śirasi samāropya</para>
  <para style="p">
    <verse number="18" style="v"/>he yihūdīyānāṁ rājan namaskāra ityuktvā taṁ namaskarttāmārebhire|</para>
  <para style="p">
    <verse number="19" style="v"/>tasyottamāṅge vetrāghātaṁ cakrustadgātre niṣṭhīvañca nicikṣipuḥ, tathā tasya sammukhe jānupātaṁ praṇomuḥ</para>
  <para style="p">
    <verse number="20" style="v"/>itthamupahasya dhūmravarṇavastram uttāryya tasya vastraṁ taṁ paryyadhāpayan kruśe veddhuṁ bahirninyuśca|</para>
  <para style="p">
    <verse number="21" style="v"/>tataḥ paraṁ sekandarasya ruphasya ca pitā śimonnāmā kurīṇīyaloka ekaḥ kutaścid grāmādetya pathi yāti taṁ te yīśoḥ kruśaṁ voḍhuṁ balād dadhnuḥ|</para>
  <para style="p">
    <verse number="22" style="v"/>atha gulgaltā arthāt śiraḥkapālanāmakaṁ sthānaṁ yīśumānīya</para>
  <para style="p">
    <verse number="23" style="v"/>te gandharasamiśritaṁ drākṣārasaṁ pātuṁ tasmai daduḥ kintu sa na jagrāha|</para>
  <para style="p">
    <verse number="24" style="v"/>tasmin kruśe viddhe sati teṣāmekaikaśaḥ kiṁ prāpsyatīti nirṇayāya</para>
  <para style="p">
    <verse number="25" style="v"/>tasya paridheyānāṁ vibhāgārthaṁ guṭikāpātaṁ cakruḥ|</para>
  <para style="p">
    <verse number="26" style="v"/>aparam eṣa yihūdīyānāṁ rājeti likhitaṁ doṣapatraṁ tasya śiraūrdvvam āropayāñcakruḥ|</para>
  <para style="p">
    <verse number="27" style="v"/>tasya vāmadakṣiṇayo rdvau caurau kruśayo rvividhāte|</para>
  <para style="p">
    <verse number="28" style="v"/>tenaiva "aparādhijanaiḥ sārddhaṁ sa gaṇito bhaviṣyati," iti śāstroktaṁ vacanaṁ siddhamabhūta|</para>
  <para style="p">
    <verse number="29" style="v"/>anantaraṁ mārge ye ye lokā gamanāgamane cakruste sarvva eva śirāṁsyāndolya nindanto jagaduḥ, re mandiranāśaka re dinatrayamadhye tannirmmāyaka,</para>
  <para style="p">
    <verse number="30" style="v"/>adhunātmānam avitvā kruśādavaroha|</para>
  <para style="p">
    <verse number="31" style="v"/>kiñca pradhānayājakā adhyāpakāśca tadvat tiraskṛtya parasparaṁ cacakṣire eṣa parānāvat kintu svamavituṁ na śaknoti|</para>
  <para style="p">
    <verse number="32" style="v"/>yadīsrāyelo rājābhiṣiktastrātā bhavati tarhyadhunaina kruśādavarohatu vayaṁ tad dṛṣṭvā viśvasiṣyāmaḥ; kiñca yau lokau tena sārddhaṁ kruśe 'vidhyetāṁ tāvapi taṁ nirbhartsayāmāsatuḥ|</para>
  <para style="p">
    <verse number="33" style="v"/>atha dvitīyayāmāt tṛtīyayāmaṁ yāvat sarvvo deśaḥ sāndhakārobhūt|</para>
  <para style="p">
    <verse number="34" style="v"/>tatastṛtīyaprahare yīśuruccairavadat elī elī lāmā śivaktanī arthād "he madīśa madīśa tvaṁ paryyatyākṣīḥ kuto hi māṁ?"</para>
  <para style="p">
    <verse number="35" style="v"/>tadā samīpasthalokānāṁ kecit tadvākyaṁ niśamyācakhyuḥ paśyaiṣa eliyam āhūyati|</para>
  <para style="p">
    <verse number="36" style="v"/>tata eko jano dhāvitvāgatya spañje 'mlarasaṁ pūrayitvā taṁ naḍāgre nidhāya pātuṁ tasmai dattvāvadat tiṣṭha eliya enamavarohayitum eti na veti paśyāmi|</para>
  <para style="p">
    <verse number="37" style="v"/>atha yīśuruccaiḥ samāhūya prāṇān jahau|</para>
  <para style="p">
    <verse number="38" style="v"/>tadā mandirasya javanikordvvādadhaḥryyantā vidīrṇā dvikhaṇḍābhūt|</para>
  <para style="p">
    <verse number="39" style="v"/>kiñca itthamuccairāhūya prāṇān tyajantaṁ taṁ dṛṣdvā tadrakṣaṇāya niyukto yaḥ senāpatirāsīt sovadat naroyam īśvaraputra iti satyam|</para>
  <para style="p">
    <verse number="40" style="v"/>tadānīṁ magdalīnī marisam kaniṣṭhayākūbo yoseśca mātānyamariyam śālomī ca yāḥ striyo</para>
  <para style="p">
    <verse number="41" style="v"/>gālīlpradeśe yīśuṁ sevitvā tadanugāminyo jātā imāstadanyāśca yā anekā nāryo yīśunā sārddhaṁ yirūśālamamāyātāstāśca dūrāt tāni dadṛśuḥ|</para>
  <para style="p">
    <verse number="42" style="v"/>athāsādanadinasyārthād viśrāmavārāt pūrvvadinasya sāyaṁkāla āgata</para>
  <para style="p">
    <verse number="43" style="v"/>īśvararājyāpekṣyarimathīyayūṣaphanāmā mānyamantrī sametya pīlātasavidhaṁ nirbhayo gatvā yīśordehaṁ yayāce|</para>
  <para style="p">
    <verse number="44" style="v"/>kintu sa idānīṁ mṛtaḥ pīlāta ityasambhavaṁ matvā śatasenāpatimāhūya sa kadā mṛta iti papraccha|</para>
  <para style="p">
    <verse number="45" style="v"/>śatasemanāpatimukhāt tajjñātvā yūṣaphe yīśordehaṁ dadau|</para>
  <para style="p">
    <verse number="46" style="v"/>paścāt sa sūkṣmaṁ vāsaḥ krītvā yīśoḥ kāyamavarohya tena vāsasā veṣṭāyitvā girau khātaśmaśāne sthāpitavān pāṣāṇaṁ loṭhayitvā dvāri nidadhe|</para>
  <para style="p">
    <verse number="47" style="v"/>kintu yatra sosthāpyata tata magdalīnī mariyam yosimātṛmariyam ca dadṛśatṛḥ|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha viśrāmavāre gate magdalīnī mariyam yākūbamātā mariyam śālomī cemāstaṁ marddayituṁ sugandhidravyāṇi krītvā</para>
  <para style="p">
    <verse number="2" style="v"/>saptāhaprathamadine'tipratyūṣe sūryyodayakāle śmaśānamupagatāḥ|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu śmaśānadvārapāṣāṇo'tibṛhan taṁ ko'pasārayiṣyatīti tāḥ parasparaṁ gadanti!</para>
  <para style="p">
    <verse number="4" style="v"/>etarhi nirīkṣya pāṣāṇo dvāro 'pasārita iti dadṛśuḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>paścāttāḥ śmaśānaṁ praviśya śuklavarṇadīrghaparicchadāvṛtamekaṁ yuvānaṁ śmaśānadakṣiṇapārśva upaviṣṭaṁ dṛṣṭvā camaccakruḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>so'vadat, mābhaiṣṭa yūyaṁ kruśe hataṁ nāsaratīyayīśuṁ gaveṣayatha sotra nāsti śmaśānādudasthāt; tai ryatra sa sthāpitaḥ sthānaṁ tadidaṁ paśyata|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu tena yathoktaṁ tathā yuṣmākamagre gālīlaṁ yāsyate tatra sa yuṣmān sākṣāt kariṣyate yūyaṁ gatvā tasya śiṣyebhyaḥ pitarāya ca vārttāmimāṁ kathayata|</para>
  <para style="p">
    <verse number="8" style="v"/>tāḥ kampitā vistitāśca tūrṇaṁ śmaśānād bahirgatvā palāyanta bhayāt kamapi kimapi nāvadaṁśca|</para>
  <para style="p">
    <verse number="9" style="v"/>aparaṁ yīśuḥ saptāhaprathamadine pratyūṣe śmaśānādutthāya yasyāḥ saptabhūtāstyājitāstasyai magdalīnīmariyame prathamaṁ darśanaṁ dadau|</para>
  <para style="p">
    <verse number="10" style="v"/>tataḥ sā gatvā śokarodanakṛdbhyo'nugatalokebhyastāṁ vārttāṁ kathayāmāsa|</para>
  <para style="p">
    <verse number="11" style="v"/>kintu yīśuḥ punarjīvan tasyai darśanaṁ dattavāniti śrutvā te na pratyayan|</para>
  <para style="p">
    <verse number="12" style="v"/>paścāt teṣāṁ dvāyo rgrāmayānakāle yīśuranyaveśaṁ dhṛtvā tābhyāṁ darśana dadau!</para>
  <para style="p">
    <verse number="13" style="v"/>tāvapi gatvānyaśiṣyebhyastāṁ kathāṁ kathayāñcakratuḥ kintu tayoḥ kathāmapi te na pratyayan|</para>
  <para style="p">
    <verse number="14" style="v"/>śeṣata ekādaśaśiṣyeṣu bhojanopaviṣṭeṣu yīśustebhyo darśanaṁ dadau tathotthānāt paraṁ taddarśanaprāptalokānāṁ kathāyāmaviśvāsakaraṇāt teṣāmaviśvāsamanaḥkāṭhinyābhyāṁ hetubhyāṁ sa tāṁstarjitavān|</para>
  <para style="p">
    <verse number="15" style="v"/>atha tānācakhyau yūyaṁ sarvvajagad gatvā sarvvajanān prati susaṁvādaṁ pracārayata|</para>
  <para style="p">
    <verse number="16" style="v"/>tatra yaḥ kaścid viśvasya majjito bhavet sa paritrāsyate kintu yo na viśvasiṣyati sa daṇḍayiṣyate|</para>
  <para style="p">
    <verse number="17" style="v"/>kiñca ye pratyeṣyanti tairīdṛg āścaryyaṁ karmma prakāśayiṣyate te mannāmnā bhūtān tyājayiṣyanti bhāṣā anyāśca vadiṣyanti|</para>
  <para style="p">
    <verse number="18" style="v"/>aparaṁ taiḥ sarpeṣu dhṛteṣu prāṇanāśakavastuni pīte ca teṣāṁ kāpi kṣati rna bhaviṣyati; rogiṇāṁ gātreṣu karārpite te'rogā bhaviṣyanti ca|</para>
  <para style="p">
    <verse number="19" style="v"/>atha prabhustānityādiśya svargaṁ nītaḥ san parameśvarasya dakṣiṇa upaviveśa|</para>
  <para style="p">
    <verse number="20" style="v"/>tataste prasthāya sarvvatra susaṁvādīyakathāṁ pracārayitumārebhire prabhustu teṣāṁ sahāyaḥ san prakāśitāścaryyakriyābhistāṁ kathāṁ pramāṇavatīṁ cakāra| iti|</para>
</usx>
