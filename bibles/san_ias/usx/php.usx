  <para style="h">Philippians</para>
  <para style="toc1">philipinaḥ patraṁ</para>
  <para style="toc2">philipinaḥ</para>
  <para style="toc3">philipinaḥ</para>
  <para style="mt1">philipinaḥ patraṁ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>paulatīmathināmānau yīśukhrīṣṭasya dāsau philipinagarasthān khrīṣṭayīśoḥ sarvvān pavitralokān samiteradhyakṣān paricārakāṁśca prati patraṁ likhataḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>asmākaṁ tāta īśvaraḥ prabhu ryīśukhrīṣṭaśca yuṣmabhyaṁ prasādasya śānteśca bhogaṁ deyāstāṁ|</para>
  <para style="p">
    <verse number="3" style="v"/>ahaṁ nirantaraṁ nijasarvvaprārthanāsu yuṣmākaṁ sarvveṣāṁ kṛte sānandaṁ prārthanāṁ kurvvan</para>
  <para style="p">
    <verse number="4" style="v"/>yati vārān yuṣmākaṁ smarāmi tati vārān ā prathamād adya yāvad</para>
  <para style="p">
    <verse number="5" style="v"/>yuṣmākaṁ susaṁvādabhāgitvakāraṇād īśvaraṁ dhanyaṁ vadāmi|</para>
  <para style="p">
    <verse number="6" style="v"/>yuṣmanmadhye yenottamaṁ karmma karttum ārambhi tenaiva yīśukhrīṣṭasya dinaṁ yāvat tat sādhayiṣyata ityasmin dṛḍhaviśvāso mamāste|</para>
  <para style="p">
    <verse number="7" style="v"/>yuṣmān sarvvān adhi mama tādṛśo bhāvo yathārtho yato'haṁ kārāvasthāyāṁ pratyuttarakaraṇe susaṁvādasya prāmāṇyakaraṇe ca yuṣmān sarvvān mayā sārddham ekānugrahasya bhāgino matvā svahṛdaye dhārayāmi|</para>
  <para style="p">
    <verse number="8" style="v"/>aparam ahaṁ khrīṣṭayīśoḥ snehavat snehena yuṣmān kīdṛśaṁ kāṅkṣāmi tadadhīśvaro mama sākṣī vidyate|</para>
  <para style="p">
    <verse number="9" style="v"/>mayā yat prārthyate tad idaṁ yuṣmākaṁ prema nityaṁ vṛddhiṁ gatvā</para>
  <para style="p">
    <verse number="10" style="v"/>jñānasya viśiṣṭānāṁ parīkṣikāyāśca sarvvavidhabuddhe rbāhulyaṁ phalatu,</para>
  <para style="p">
    <verse number="11" style="v"/>khrīṣṭasya dinaṁ yāvad yuṣmākaṁ sāralyaṁ nirvighnatvañca bhavatu, īśvarasya gauravāya praśaṁsāyai ca yīśunā khrīṣṭena puṇyaphalānāṁ pūrṇatā yuṣmabhyaṁ dīyatām iti|</para>
  <para style="p">
    <verse number="12" style="v"/>he bhrātaraḥ, māṁ prati yad yad ghaṭitaṁ tena susaṁvādapracārasya bādhā nahi kintu vṛddhireva jātā tad yuṣmān jñāpayituṁ kāmaye'haṁ|</para>
  <para style="p">
    <verse number="13" style="v"/>aparam ahaṁ khrīṣṭasya kṛte baddho'smīti rājapuryyām anyasthāneṣu ca sarvveṣāṁ nikaṭe suspaṣṭam abhavat,</para>
  <para style="p">
    <verse number="14" style="v"/>prabhusambandhīyā aneke bhrātaraśca mama bandhanād āśvāsaṁ prāpya varddhamānenotsāhena niḥkṣobhaṁ kathāṁ pracārayanti|</para>
  <para style="p">
    <verse number="15" style="v"/>kecid dveṣād virodhāccāpare kecicca sadbhāvāt khrīṣṭaṁ ghoṣayanti;</para>
  <para style="p">
    <verse number="16" style="v"/>ye virodhāt khrīṣṭaṁ ghoṣayanti te pavitrabhāvāt tanna kurvvanto mama bandhanāni bahutaraklośadāyīni karttum icchanti|</para>
  <para style="p">
    <verse number="17" style="v"/>ye ca premnā ghoṣayanti te susaṁvādasya prāmāṇyakaraṇe'haṁ niyukto'smīti jñātvā tat kurvvanti|</para>
  <para style="p">
    <verse number="18" style="v"/>kiṁ bahunā? kāpaṭyāt saralabhāvād vā bhavet, yena kenacit prakāreṇa khrīṣṭasya ghoṣaṇā bhavatītyasmin aham ānandāmyānandiṣyāmi ca|</para>
  <para style="p">
    <verse number="19" style="v"/>yuṣmākaṁ prārthanayā yīśukhrīṣṭasyātmanaścopakāreṇa tat mannistārajanakaṁ bhaviṣyatīti jānāmi|</para>
  <para style="p">
    <verse number="20" style="v"/>tatra ca mamākāṅkṣā pratyāśā ca siddhiṁ gamiṣyati phalato'haṁ kenāpi prakāreṇa na lajjiṣye kintu gate sarvvasmin kāle yadvat tadvad idānīmapi sampūrṇotsāhadvārā mama śarīreṇa khrīṣṭasya mahimā jīvane maraṇe vā prakāśiṣyate|</para>
  <para style="p">
    <verse number="21" style="v"/>yato mama jīvanaṁ khrīṣṭāya maraṇañca lābhāya|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu yadi śarīre mayā jīvitavyaṁ tarhi tat karmmaphalaṁ phaliṣyati tasmāt kiṁ varitavyaṁ tanmayā na jñāyate|</para>
  <para style="p">
    <verse number="23" style="v"/>dvābhyām ahaṁ sampīḍye, dehavāsatyajanāya khrīṣṭena sahavāsāya ca mamābhilāṣo bhavati yatastat sarvvottamaṁ|</para>
  <para style="p">
    <verse number="24" style="v"/>kintu dehe mamāvasthityā yuṣmākam adhikaprayojanaṁ|</para>
  <para style="p">
    <verse number="25" style="v"/>aham avasthāsye yuṣmābhiḥ sarvvaiḥ sārddham avasthitiṁ kariṣye ca tayā ca viśvāse yuṣmākaṁ vṛddhyānandau janiṣyete tadahaṁ niścitaṁ jānāmi|</para>
  <para style="p">
    <verse number="26" style="v"/>tena ca matto'rthato yuṣmatsamīpe mama punarupasthitatvāt yūyaṁ khrīṣṭena yīśunā bahutaram āhlādaṁ lapsyadhve|</para>
  <para style="p">
    <verse number="27" style="v"/>yūyaṁ sāvadhānā bhūtvā khrīṣṭasya susaṁvādasyopayuktam ācāraṁ kurudhvaṁ yato'haṁ yuṣmān upāgatya sākṣāt kurvvan kiṁ vā dūre tiṣṭhan yuṣmākaṁ yāṁ vārttāṁ śrotum icchāmi seyaṁ yūyam ekātmānastiṣṭhatha, ekamanasā susaṁvādasambandhīyaviśvāsasya pakṣe yatadhve, vipakṣaiśca kenāpi prakāreṇa na vyākulīkriyadhva iti|</para>
  <para style="p">
    <verse number="28" style="v"/>tat teṣāṁ vināśasya lakṣaṇaṁ yuṣmākañceśvaradattaṁ paritrāṇasya lakṣaṇaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="29" style="v"/>yato yena yuṣmābhiḥ khrīṣṭe kevalaviśvāsaḥ kriyate tannahi kintu tasya kṛte kleśo'pi sahyate tādṛśo varaḥ khrīṣṭasyānurodhād yuṣmābhiḥ prāpi,</para>
  <para style="p">
    <verse number="30" style="v"/>tasmāt mama yādṛśaṁ yuddhaṁ yuṣmābhiradarśi sāmprataṁ śrūyate ca tādṛśaṁ yuddhaṁ yuṣmākam api bhavati|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>khrīṣṭād yadi kimapi sāntvanaṁ kaścit premajāto harṣaḥ kiñcid ātmanaḥ samabhāgitvaṁ kācid anukampā kṛpā vā jāyate tarhi yūyaṁ mamāhlādaṁ pūrayanta</para>
  <para style="p">
    <verse number="2" style="v"/>ekabhāvā ekapremāṇa ekamanasa ekaceṣṭāśca bhavata|</para>
  <para style="p">
    <verse number="3" style="v"/>virodhād darpād vā kimapi mā kuruta kintu namratayā svebhyo'parān viśiṣṭān manyadhvaṁ|</para>
  <para style="p">
    <verse number="4" style="v"/>kevalam ātmahitāya na ceṣṭamānāḥ parahitāyāpi ceṣṭadhvaṁ|</para>
  <para style="p">
    <verse number="5" style="v"/>khrīṣṭasya yīśo ryādṛśaḥ svabhāvo yuṣmākam api tādṛśo bhavatu|</para>
  <para style="p">
    <verse number="6" style="v"/>sa īśvararūpī san svakīyām īśvaratulyatāṁ ślāghāspadaṁ nāmanyata,</para>
  <para style="p">
    <verse number="7" style="v"/>kintu svaṁ śūnyaṁ kṛtvā dāsarūpī babhūva narākṛtiṁ lebhe ca|</para>
  <para style="p">
    <verse number="8" style="v"/>itthaṁ naramūrttim āśritya namratāṁ svīkṛtya mṛtyorarthataḥ kruśīyamṛtyoreva bhogāyājñāgrāhī babhūva|</para>
  <para style="p">
    <verse number="9" style="v"/>tatkāraṇād īśvaro'pi taṁ sarvvonnataṁ cakāra yacca nāma sarvveṣāṁ nāmnāṁ śreṣṭhaṁ tadeva tasmai dadau,</para>
  <para style="p">
    <verse number="10" style="v"/>tatastasmai yīśunāmne svargamartyapātālasthitaiḥ sarvvai rjānupātaḥ karttavyaḥ,</para>
  <para style="p">
    <verse number="11" style="v"/>tātastheśvarasya mahimne ca yīśukhrīṣṭaḥ prabhuriti jihvābhiḥ svīkarttavyaṁ|</para>
  <para style="p">
    <verse number="12" style="v"/>ato he priyatamāḥ, yuṣmābhi ryadvat sarvvadā kriyate tadvat kevale mamopasthitikāle tannahi kintvidānīm anupasthite'pi mayi bahutarayatnenājñāṁ gṛhītvā bhayakampābhyāṁ svasvaparitrāṇaṁ sādhyatāṁ|</para>
  <para style="p">
    <verse number="13" style="v"/>yata īśvara eva svakīyānurodhād yuṣmanmadhye manaskāmanāṁ karmmasiddhiñca vidadhāti|</para>
  <para style="p">
    <verse number="14" style="v"/>yūyaṁ kalahavivādarvijatam ācāraṁ kurvvanto'nindanīyā akuṭilā</para>
  <para style="p">
    <verse number="15" style="v"/>īśvarasya niṣkalaṅkāśca santānāiva vakrabhāvānāṁ kuṭilācāriṇāñca lokānāṁ madhye tiṣṭhata,</para>
  <para style="p">
    <verse number="16" style="v"/>yatasteṣāṁ madhye yūyaṁ jīvanavākyaṁ dhārayanto jagato dīpakā iva dīpyadhve| yuṣmābhistathā kṛte mama yatnaḥ pariśramo vā na niṣphalo jāta ityahaṁ khrīṣṭasya dine ślāghāṁ karttuṁ śakṣyāmi|</para>
  <para style="p">
    <verse number="17" style="v"/>yuṣmākaṁ viśvāsārthakāya balidānāya sevanāya ca yadyapyahaṁ niveditavyo bhaveyaṁ tathāpi tenānandāmi sarvveṣāṁ yuṣmākam ānandasyāṁśī bhavāmi ca|</para>
  <para style="p">
    <verse number="18" style="v"/>tadvad yūyamapyānandata madīyānandasyāṁśino bhavata ca|</para>
  <para style="p">
    <verse number="19" style="v"/>yuṣmākam avasthām avagatyāhamapi yat sāntvanāṁ prāpnuyāṁ tadarthaṁ tīmathiyaṁ tvarayā yuṣmatsamīpaṁ preṣayiṣyāmīti prabhau pratyāśāṁ kurvve|</para>
  <para style="p">
    <verse number="20" style="v"/>yaḥ satyarūpeṇa yuṣmākaṁ hitaṁ cintayati tādṛśa ekabhāvastasmādanyaḥ ko'pi mama sannidhau nāsti|</para>
  <para style="p">
    <verse number="21" style="v"/>yato'pare sarvve yīśoḥ khrīṣṭasya viṣayān na cintayanta ātmaviṣayān cintayanti|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu tasya parīkṣitatvaṁ yuṣmābhi rjñāyate yataḥ putro yādṛk pituḥ sahakārī bhavati tathaiva susaṁvādasya paricaryyāyāṁ sa mama sahakārī jātaḥ|</para>
  <para style="p">
    <verse number="23" style="v"/>ataeva mama bhāvidaśāṁ jñātvā tatkṣaṇāt tameva preṣayituṁ pratyāśāṁ kurvve</para>
  <para style="p">
    <verse number="24" style="v"/>svayam ahamapi tūrṇaṁ yuṣmatsamīpaṁ gamiṣyāmītyāśāṁ prabhunā kurvve|</para>
  <para style="p">
    <verse number="25" style="v"/>aparaṁ ya ipāphradīto mama bhrātā karmmayuddhābhyāṁ mama sahāyaśca yuṣmākaṁ dūto madīyopakārāya pratinidhiścāsti yuṣmatsamīpe tasya preṣaṇam āvaśyakam amanye|</para>
  <para style="p">
    <verse number="26" style="v"/>yataḥ sa yuṣmān sarvvān akāṅkṣata yuṣmābhistasya rogasya vārttāśrāvīti buddhvā paryyaśocacca|</para>
  <para style="p">
    <verse number="27" style="v"/>sa pīḍayā mṛtakalpo'bhavaditi satyaṁ kintvīśvarastaṁ dayitavān mama ca duḥkhāt paraṁ punarduḥkhaṁ yanna bhavet tadarthaṁ kevalaṁ taṁ na dayitvā māmapi dayitavān|</para>
  <para style="p">
    <verse number="28" style="v"/>ataeva yūyaṁ taṁ vilokya yat punarānandeta mamāpi duḥkhasya hrāso yad bhavet tadartham ahaṁ tvarayā tam apreṣayaṁ|</para>
  <para style="p">
    <verse number="29" style="v"/>ato yūyaṁ prabhoḥ kṛte sampūrṇenānandena taṁ gṛhlīta tādṛśān lokāṁścādaraṇīyān manyadhvaṁ|</para>
  <para style="p">
    <verse number="30" style="v"/>yato mama sevane yuṣmākaṁ truṭiṁ pūrayituṁ sa prāṇān paṇīkṛtya khrīṣṭasya kāryyārthaṁ mṛtaprāye'bhavat|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he bhrātaraḥ, śeṣe vadāmi yūyaṁ prabhāvānandata| punaḥ punarekasya vaco lekhanaṁ mama kleśadaṁ nahi yuṣmadarthañca bhramanāśakaṁ bhavati|</para>
  <para style="p">
    <verse number="2" style="v"/>yūyaṁ kukkurebhyaḥ sāvadhānā bhavata duṣkarmmakāribhyaḥ sāvadhānā bhavata chinnamūlebhyo lokebhyaśca sāvadhānā bhavata|</para>
  <para style="p">
    <verse number="3" style="v"/>vayameva chinnatvaco lokā yato vayam ātmaneśvaraṁ sevāmahe khrīṣṭena yīśunā ślāghāmahe śarīreṇa ca pragalbhatāṁ na kurvvāmahe|</para>
  <para style="p">
    <verse number="4" style="v"/>kintu śarīre mama pragalbhatāyāḥ kāraṇaṁ vidyate, kaścid yadi śarīreṇa pragalbhatāṁ cikīrṣati tarhi tasmād api mama pragalbhatāyā gurutaraṁ kāraṇaṁ vidyate|</para>
  <para style="p">
    <verse number="5" style="v"/>yato'ham aṣṭamadivase tvakchedaprāpta isrāyelvaṁśīyo binyāmīnagoṣṭhīya ibrikulajāta ibriyo vyavasthācaraṇe phirūśī</para>
  <para style="p">
    <verse number="6" style="v"/>dharmmotsāhakāraṇāt samiterupadravakārī vyavasthāto labhye puṇye cānindanīyaḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu mama yadyat labhyam āsīt tat sarvvam ahaṁ khrīṣṭasyānurodhāt kṣatim amanye|</para>
  <para style="p">
    <verse number="8" style="v"/>kiñcādhunāpyahaṁ matprabhoḥ khrīṣṭasya yīśo rjñānasyotkṛṣṭatāṁ buddhvā tat sarvvaṁ kṣatiṁ manye|</para>
  <para style="p">
    <verse number="9" style="v"/>yato hetorahaṁ yat khrīṣṭaṁ labheya vyavasthāto jātaṁ svakīyapuṇyañca na dhārayan kintu khrīṣṭe viśvasanāt labhyaṁ yat puṇyam īśvareṇa viśvāsaṁ dṛṣṭvā dīyate tadeva dhārayan yat khrīṣṭe vidyeya tadarthaṁ tasyānurodhāt sarvveṣāṁ kṣatiṁ svīkṛtya tāni sarvvāṇyavakarāniva manye|</para>
  <para style="p">
    <verse number="10" style="v"/>yato hetorahaṁ khrīṣṭaṁ tasya punarutthite rguṇaṁ tasya duḥkhānāṁ bhāgitvañca jñātvā tasya mṛtyorākṛtiñca gṛhītvā</para>
  <para style="p">
    <verse number="11" style="v"/>yena kenacit prakāreṇa mṛtānāṁ punarutthitiṁ prāptuṁ yate|</para>
  <para style="p">
    <verse number="12" style="v"/>mayā tat sarvvam adhunā prāpi siddhatā vālambhi tannahi kintu yadartham ahaṁ khrīṣṭena dhāritastad dhārayituṁ dhāvāmi|</para>
  <para style="p">
    <verse number="13" style="v"/>he bhrātaraḥ, mayā tad dhāritam iti na manyate kintvetadaikamātraṁ vadāmi yāni paścāt sthitāni tāni vismṛtyāham agrasthitānyuddiśya</para>
  <para style="p">
    <verse number="14" style="v"/>pūrṇayatnena lakṣyaṁ prati dhāvan khrīṣṭayīśunorddhvāt mām āhvayata īśvarāt jetṛpaṇaṁ prāptuṁ ceṣṭe|</para>
  <para style="p">
    <verse number="15" style="v"/>asmākaṁ madhye ye siddhāstaiḥ sarvvaistadeva bhāvyatāṁ, yadi ca kañcana viṣayam adhi yuṣmākam aparo bhāvo bhavati tarhīśvarastamapi yuṣmākaṁ prati prakāśayiṣyati|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu vayaṁ yadyad avagatā āsmastatrāsmābhireko vidhirācaritavya ekabhāvai rbhavitavyañca|</para>
  <para style="p">
    <verse number="17" style="v"/>he bhrātaraḥ, yūyaṁ mamānugāmino bhavata vayañca yādṛgācaraṇasya nidarśanasvarūpā bhavāmastādṛgācāriṇo lokān ālokayadhvaṁ|</para>
  <para style="p">
    <verse number="18" style="v"/>yato'neke vipathe caranti te ca khrīṣṭasya kruśasya śatrava iti purā mayā punaḥ punaḥ kathitam adhunāpi rudatā mayā kathyate|</para>
  <para style="p">
    <verse number="19" style="v"/>teṣāṁ śeṣadaśā sarvvanāśa udaraśceśvaro lajjā ca ślāghā pṛthivyāñca lagnaṁ manaḥ|</para>
  <para style="p">
    <verse number="20" style="v"/>kintvasmākaṁ janapadaḥ svarge vidyate tasmāccāgamiṣyantaṁ trātāraṁ prabhuṁ yīśukhrīṣṭaṁ vayaṁ pratīkṣāmahe|</para>
  <para style="p">
    <verse number="21" style="v"/>sa ca yayā śaktyā sarvvāṇyeva svasya vaśīkarttuṁ pārayati tayāsmākam adhamaṁ śarīraṁ rūpāntarīkṛtya svakīyatejomayaśarīrasya samākāraṁ kariṣyati|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he madīyānandamukuṭasvarūpāḥ priyatamā abhīṣṭatamā bhrātaraḥ, he mama snehapātrāḥ, yūyam itthaṁ pabhau sthirāstiṣṭhata|</para>
  <para style="p">
    <verse number="2" style="v"/>he ivadiye he suntukhi yuvāṁ prabhau ekabhāve bhavatam etad ahaṁ prārthaye|</para>
  <para style="p">
    <verse number="3" style="v"/>he mama satya sahakārin tvāmapi vinīya vadāmi etayorupakārastvayā kriyatāṁ yataste klīminādibhiḥ sahakāribhiḥ sārddhaṁ susaṁvādapracāraṇāya mama sāhāyyārthaṁ pariśramam akurvvatāṁ teṣāṁ sarvveṣāṁ nāmāni ca jīvanapustake likhitāni vidyante|</para>
  <para style="p">
    <verse number="4" style="v"/>yūyaṁ prabhau sarvvadānandata| puna rvadāmi yūyam ānandata|</para>
  <para style="p">
    <verse number="5" style="v"/>yuṣmākaṁ vinītatvaṁ sarvvamānavai rjñāyatāṁ, prabhuḥ sannidhau vidyate|</para>
  <para style="p">
    <verse number="6" style="v"/>yūyaṁ kimapi na cintayata kintu dhanyavādayuktābhyāṁ prārthanāyāñcābhyāṁ sarvvaviṣaye svaprārthanīyam īśvarāya nivedayata|</para>
  <para style="p">
    <verse number="7" style="v"/>tathā kṛta īśvarīyā yā śāntiḥ sarvvāṁ buddhim atiśete sā yuṣmākaṁ cittāni manāṁsi ca khrīṣṭe yīśau rakṣiṣyati|</para>
  <para style="p">
    <verse number="8" style="v"/>he bhrātaraḥ, śeṣe vadāmi yadyat satyam ādaraṇīyaṁ nyāyyaṁ sādhu priyaṁ sukhyātam anyeṇa yena kenacit prakāreṇa vā guṇayuktaṁ praśaṁsanīyaṁ vā bhavati tatraiva manāṁsi nidhadhvaṁ|</para>
  <para style="p">
    <verse number="9" style="v"/>yūyaṁ māṁ dṛṣṭvā śrutvā ca yadyat śikṣitavanto gṛhītavantaśca tadevācarata tasmāt śāntidāyaka īśvaro yuṣmābhiḥ sārddhaṁ sthāsyati|</para>
  <para style="p">
    <verse number="10" style="v"/>mamopakārāya yuṣmākaṁ yā cintā pūrvvam āsīt kintu karmmadvāraṁ na prāpnot idānīṁ sā punaraphalat ityasmin prabhau mama paramāhlādo'jāyata|</para>
  <para style="p">
    <verse number="11" style="v"/>ahaṁ yad dainyakāraṇād idaṁ vadāmi tannahi yato mama yā kācid avasthā bhavet tasyāṁ santoṣṭum aśikṣayaṁ|</para>
  <para style="p">
    <verse number="12" style="v"/>daridratāṁ bhoktuṁ śaknomi dhanāḍhyatām api bhoktuṁ śaknomi sarvvathā sarvvaviṣayeṣu vinīto'haṁ pracuratāṁ kṣudhāñca dhanaṁ dainyañcāvagato'smi|</para>
  <para style="p">
    <verse number="13" style="v"/>mama śaktidāyakena khrīṣṭena sarvvameva mayā śakyaṁ bhavati|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu yuṣmābhi rdainyanivāraṇāya mām upakṛtya satkarmmākāri|</para>
  <para style="p">
    <verse number="15" style="v"/>he philipīyalokāḥ, susaṁvādasyodayakāle yadāhaṁ mākidaniyādeśāt pratiṣṭhe tadā kevalān yuṣmān vināparayā kayāpi samityā saha dānādānayo rmama ko'pi sambandho nāsīd iti yūyamapi jānītha|</para>
  <para style="p">
    <verse number="16" style="v"/>yato yuṣmābhi rmama prayojanāya thiṣalanīkīnagaramapi māṁ prati punaḥ punardānaṁ preṣitaṁ|</para>
  <para style="p">
    <verse number="17" style="v"/>ahaṁ yad dānaṁ mṛgaye tannahi kintu yuṣmākaṁ lābhavarddhakaṁ phalaṁ mṛgaye|</para>
  <para style="p">
    <verse number="18" style="v"/>kintu mama kasyāpyabhāvo nāsti sarvvaṁ pracuram āste yata īśvarasya grāhyaṁ tuṣṭijanakaṁ sugandhinaivedyasvarūpaṁ yuṣmākaṁ dānaṁ ipāphraditād gṛhītvāhaṁ paritṛpto'smi|</para>
  <para style="p">
    <verse number="19" style="v"/>mameśvaro'pi khrīṣṭena yīśunā svakīyavibhavanidhitaḥ prayojanīyaṁ sarvvaviṣayaṁ pūrṇarūpaṁ yuṣmabhyaṁ deyāt|</para>
  <para style="p">
    <verse number="20" style="v"/>asmākaṁ piturīśvarasya dhanyavādo'nantakālaṁ yāvad bhavatu| āmen|</para>
  <para style="p">
    <verse number="21" style="v"/>yūyaṁ yīśukhrīṣṭasyaikaikaṁ pavitrajanaṁ namaskuruta| mama saṅgibhrātaro yūṣmān namaskurvvate|</para>
  <para style="p">
    <verse number="22" style="v"/>sarvve pavitralokā viśeṣataḥ kaisarasya parijanā yuṣmān namaskurvvate|</para>
  <para style="p">
    <verse number="23" style="v"/>asmākaṁ prabho ryīśukhrīṣṭasya prasādaḥ sarvvān yuṣmān prati bhūyāt| āmen|</para>
</usx>
