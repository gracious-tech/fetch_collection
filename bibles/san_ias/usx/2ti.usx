  <para style="h">2 Timothy</para>
  <para style="toc1">2 tīmathiyaṁ patraṁ</para>
  <para style="toc2">2 tīmathiyaḥ</para>
  <para style="toc3">2 tīmathiyaḥ</para>
  <para style="mt1">2 tīmathiyaṁ patraṁ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>khrīṣṭena yīśunā yā jīvanasya pratijñā tāmadhīśvarasyecchayā yīśoḥ khrīṣṭasyaikaḥ preritaḥ paulo'haṁ svakīyaṁ priyaṁ dharmmaputraṁ tīmathiyaṁ prati patraṁ likhāmi|</para>
  <para style="p">
    <verse number="2" style="v"/>tāta īśvaro'smākaṁ prabhu ryīśukhrīṣṭaśca tvayi prasādaṁ dayāṁ śāntiñca kriyāstāṁ|</para>
  <para style="p">
    <verse number="3" style="v"/>aham ā pūrvvapuruṣāt yam īśvaraṁ pavitramanasā seve taṁ dhanyaṁ vadanaṁ kathayāmi, aham ahorātraṁ prārthanāsamaye tvāṁ nirantaraṁ smarāmi|</para>
  <para style="p">
    <verse number="4" style="v"/>yaśca viśvāsaḥ prathame loyīnāmikāyāṁ tava mātāmahyām unīkīnāmikāyāṁ mātari cātiṣṭhat tavāntare'pi tiṣṭhatīti manye</para>
  <para style="p">
    <verse number="5" style="v"/>tava taṁ niṣkapaṭaṁ viśvāsaṁ manasi kurvvan tavāśrupātaṁ smaran yathānandena praphallo bhaveyaṁ tadarthaṁ tava darśanam ākāṅkṣe|</para>
  <para style="p">
    <verse number="6" style="v"/>ato heto rmama hastārpaṇena labdho ya īśvarasya varastvayi vidyate tam ujjvālayituṁ tvāṁ smārayāmi|</para>
  <para style="p">
    <verse number="7" style="v"/>yata īśvaro'smabhyaṁ bhayajanakam ātmānam adattvā śaktipremasatarkatānām ākaram ātmānaṁ dattavān|</para>
  <para style="p">
    <verse number="8" style="v"/>ataevāsmākaṁ prabhumadhi tasya vandidāsaṁ māmadhi ca pramāṇaṁ dātuṁ na trapasva kintvīśvarīyaśaktyā susaṁvādasya kṛte duḥkhasya sahabhāgī bhava|</para>
  <para style="p">
    <verse number="9" style="v"/>so'smān paritrāṇapātrāṇi kṛtavān pavitreṇāhvānenāhūtavāṁśca; asmatkarmmahetuneti nahi svīyanirūpāṇasya prasādasya ca kṛte tat kṛtavān| sa prasādaḥ sṛṣṭeḥ pūrvvakāle khrīṣṭena yīśunāsmabhyam adāyi,</para>
  <para style="p">
    <verse number="10" style="v"/>kintvadhunāsmākaṁ paritrātu ryīśoḥ khrīṣṭasyāgamanena prākāśata| khrīṣṭo mṛtyuṁ parājitavān susaṁvādena ca jīvanam amaratāñca prakāśitavān|</para>
  <para style="p">
    <verse number="11" style="v"/>tasya ghoṣayitā dūtaścānyajātīyānāṁ śikṣakaścāhaṁ niyukto'smi|</para>
  <para style="p">
    <verse number="12" style="v"/>tasmāt kāraṇāt mamāyaṁ kleśo bhavati tena mama lajjā na jāyate yato'haṁ yasmin viśvasitavān tamavagato'smi mahādinaṁ yāvat mamopanidhe rgopanasya śaktistasya vidyata iti niścitaṁ jānāmi|</para>
  <para style="p">
    <verse number="13" style="v"/>hitadāyakānāṁ vākyānām ādarśarūpeṇa mattaḥ śrutāḥ khrīṣṭe yīśau viśvāsapremnoḥ kathā dhāraya|</para>
  <para style="p">
    <verse number="14" style="v"/>aparam asmadantarvāsinā pavitreṇātmanā tāmuttamām upanidhiṁ gopaya|</para>
  <para style="p">
    <verse number="15" style="v"/>āśiyādeśīyāḥ sarvve māṁ tyaktavanta iti tvaṁ jānāsi teṣāṁ madhye phūgillo harmmaginiśca vidyete|</para>
  <para style="p">
    <verse number="16" style="v"/>prabhuranīṣipharasya parivārān prati kṛpāṁ vidadhātu yataḥ sa punaḥ puna rmām āpyāyitavān</para>
  <para style="p">
    <verse number="17" style="v"/>mama śṛṅkhalena na trapitvā romānagare upasthitisamaye yatnena māṁ mṛgayitvā mamoddeśaṁ prāptavān|</para>
  <para style="p">
    <verse number="18" style="v"/>ato vicāradine sa yathā prabhoḥ kṛpābhājanaṁ bhavet tādṛśaṁ varaṁ prabhustasmai deyāt| iphiṣanagare'pi sa kati prakārai rmām upakṛtavān tat tvaṁ samyag vetsi|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he mama putra, khrīṣṭayīśuto yo'nugrahastasya balena tvaṁ balavān bhava|</para>
  <para style="p">
    <verse number="2" style="v"/>aparaṁ bahubhiḥ sākṣibhiḥ pramāṇīkṛtāṁ yāṁ śikṣāṁ śrutavānasi tāṁ viśvāsyeṣu parasmai śikṣādāne nipuṇeṣu ca lokeṣu samarpaya|</para>
  <para style="p">
    <verse number="3" style="v"/>tvaṁ yīśukhrīṣṭasyottamo yoddheva kleśaṁ sahasva|</para>
  <para style="p">
    <verse number="4" style="v"/>yo yuddhaṁ karoti sa sāṁsārike vyāpāre magno na bhavati kintu svaniyojayitre rocituṁ ceṣṭate|</para>
  <para style="p">
    <verse number="5" style="v"/>aparaṁ yo mallai ryudhyati sa yadi niyamānusāreṇa na yuddhyati tarhi kirīṭaṁ na lapsyate|</para>
  <para style="p">
    <verse number="6" style="v"/>aparaṁ yaḥ kṛṣīvalaḥ karmma karoti tena prathamena phalabhāginā bhavitavyaṁ|</para>
  <para style="p">
    <verse number="7" style="v"/>mayā yaducyate tat tvayā budhyatāṁ yataḥ prabhustubhyaṁ sarvvatra buddhiṁ dāsyati|</para>
  <para style="p">
    <verse number="8" style="v"/>mama susaṁvādasya vacanānusārād dāyūdvaṁśīyaṁ mṛtagaṇamadhyād utthāpitañca yīśuṁ khrīṣṭaṁ smara|</para>
  <para style="p">
    <verse number="9" style="v"/>tatsusaṁvādakāraṇād ahaṁ duṣkarmmeva bandhanadaśāparyyantaṁ kleśaṁ bhuñje kintvīśvarasya vākyam abaddhaṁ tiṣṭhati|</para>
  <para style="p">
    <verse number="10" style="v"/>khrīṣṭena yīśunā yad anantagauravasahitaṁ paritrāṇaṁ jāyate tadabhirucitai rlokairapi yat labhyeta tadarthamahaṁ teṣāṁ nimittaṁ sarvvāṇyetāni sahe|</para>
  <para style="p">
    <verse number="11" style="v"/>aparam eṣā bhāratī satyā yadi vayaṁ tena sārddhaṁ mriyāmahe tarhi tena sārddhaṁ jīvivyāmaḥ, yadi ca kleśaṁ sahāmahe tarhi tena sārddhaṁ rājatvamapi kariṣyāmahe|</para>
  <para style="p">
    <verse number="12" style="v"/>yadi vayaṁ tam anaṅgīkurmmastarhi so 'smānapyanaṅgīkariṣyati|</para>
  <para style="p">
    <verse number="13" style="v"/>yadi vayaṁ na viśvāsāmastarhi sa viśvāsyastiṣṭhati yataḥ svam apahnotuṁ na śaknoti|</para>
  <para style="p">
    <verse number="14" style="v"/>tvametāni smārayan te yathā niṣphalaṁ śrotṛṇāṁ bhraṁśajanakaṁ vāgyuddhaṁ na kuryyastathā prabhoḥ samakṣaṁ dṛḍhaṁ vinīyādiśa|</para>
  <para style="p">
    <verse number="15" style="v"/>aparaṁ tvam īśvarasya sākṣāt svaṁ parīkṣitam anindanīyakarmmakāriṇañca satyamatasya vākyānāṁ sadvibhajane nipuṇañca darśayituṁ yatasva|</para>
  <para style="p">
    <verse number="16" style="v"/>kintvapavitrā anarthakakathā dūrīkuru yatastadālambina uttarottaram adharmme varddhiṣyante,</para>
  <para style="p">
    <verse number="17" style="v"/>teṣāñca vākyaṁ galitakṣatavat kṣayavarddhako bhaviṣyati teṣāṁ madhye humināyaḥ philītaścetināmānau dvau janau satyamatād bhraṣṭau jātau,</para>
  <para style="p">
    <verse number="18" style="v"/>mṛtānāṁ punarutthiti rvyatīteti vadantau keṣāñcid viśvāsam utpāṭayataśca|</para>
  <para style="p">
    <verse number="19" style="v"/>tathāpīśvarasya bhittimūlam acalaṁ tiṣṭhati tasmiṁśceyaṁ lipi rmudrāṅkitā vidyate| yathā, jānāti parameśastu svakīyān sarvvamānavān| apagacched adharmmācca yaḥ kaścit khrīṣṭanāmakṛt||</para>
  <para style="p">
    <verse number="20" style="v"/>kintu bṛhanniketane kevala suvarṇamayāni raupyamayāṇi ca bhājanāni vidyanta iti tarhi kāṣṭhamayāni mṛṇmayānyapi vidyante teṣāñca kiyanti sammānāya kiyantapamānāya ca bhavanti|</para>
  <para style="p">
    <verse number="21" style="v"/>ato yadi kaścid etādṛśebhyaḥ svaṁ pariṣkaroti tarhi sa pāvitaṁ prabhoḥ kāryyayogyaṁ sarvvasatkāryyāyopayuktaṁ sammānārthakañca bhājanaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="22" style="v"/>yauvanāvasthāyā abhilāṣāstvayā parityajyantāṁ dharmmo viśvāsaḥ prema ye ca śucimanobhiḥ prabhum uddiśya prārthanāṁ kurvvate taiḥ sārddham aikyabhāvaścaiteṣu tvayā yatno vidhīyatāṁ|</para>
  <para style="p">
    <verse number="23" style="v"/>aparaṁ tvam anarthakān ajñānāṁśca praśnān vāgyuddhotpādakān jñātvā dūrīkuru|</para>
  <para style="p">
    <verse number="24" style="v"/>yataḥ prabho rdāsena yuddham akarttavyaṁ kintu sarvvān prati śāntena śikṣādānecchukena sahiṣṇunā ca bhavitavyaṁ, vipakṣāśca tena namratvena cetitavyāḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>tathā kṛte yadīśvaraḥ satyamatasya jñānārthaṁ tebhyo manaḥparivarttanarūpaṁ varaṁ dadyāt,</para>
  <para style="p">
    <verse number="26" style="v"/>tarhi te yena śayatānena nijābhilāṣasādhanāya dhṛtāstasya jālāt cetanāṁ prāpyoddhāraṁ labdhuṁ śakṣyanti|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>caramadineṣu kleśajanakāḥ samayā upasthāsyantīti jānīhi|</para>
  <para style="p">
    <verse number="2" style="v"/>yatastātkālikā lokā ātmapremiṇo 'rthapremiṇa ātmaślāghino 'bhimānino nindakāḥ pitroranājñāgrāhiṇaḥ kṛtaghnā apavitrāḥ</para>
  <para style="p">
    <verse number="3" style="v"/>prītivarjitā asandheyā mṛṣāpavādino 'jitendriyāḥ pracaṇḍā bhadradveṣiṇo</para>
  <para style="p">
    <verse number="4" style="v"/>viśvāsaghātakā duḥsāhasino darpadhmātā īśvarāpremiṇaḥ kintu sukhapremiṇo</para>
  <para style="p">
    <verse number="5" style="v"/>bhaktaveśāḥ kintvasvīkṛtabhaktiguṇā bhaviṣyanti; etādṛśānāṁ lokānāṁ saṁmargaṁ parityaja|</para>
  <para style="p">
    <verse number="6" style="v"/>yato ye janāḥ pracchannaṁ gehān praviśanti pāpai rbhāragrastā nānāvidhābhilāṣaiścālitā yāḥ kāminyo</para>
  <para style="p">
    <verse number="7" style="v"/>nityaṁ śikṣante kintu satyamatasya tattvajñānaṁ prāptuṁ kadācit na śaknuvanti tā dāsīvad vaśīkurvvate ca te tādṛśā lokāḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>yānni ryāmbriśca yathā mūsamaṁ prati vipakṣatvam akurutāṁ tathaiva bhraṣṭamanaso viśvāsaviṣaye 'grāhyāścaite lokā api satyamataṁ prati vipakṣatāṁ kurvvanti|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu te bahudūram agrasarā na bhaviṣyanti yatastayo rmūḍhatā yadvat tadvad eteṣāmapi mūḍhatā sarvvadṛśyā bhaviṣyati|</para>
  <para style="p">
    <verse number="10" style="v"/>mamopadeśaḥ śiṣṭatābhiprāyo viśvāso rdharyyaṁ prema sahiṣṇutopadravaḥ kleśā</para>
  <para style="p">
    <verse number="11" style="v"/>āntiyakhiyāyām ikaniye lūstrāyāñca māṁ prati yadyad aghaṭata yāṁścopadravān aham asahe sarvvametat tvam avagato'si kintu tatsarvvataḥ prabhu rmām uddhṛtavān|</para>
  <para style="p">
    <verse number="12" style="v"/>parantu yāvanto lokāḥ khrīṣṭena yīśuneśvarabhaktim ācaritum icchanti teṣāṁ sarvveṣām upadravo bhaviṣyati|</para>
  <para style="p">
    <verse number="13" style="v"/>aparaṁ pāpiṣṭhāḥ khalāśca lokā bhrāmyanto bhramayantaścottarottaraṁ duṣṭatvena varddhiṣyante|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu tvaṁ yad yad aśikṣathāḥ, yacca tvayi samarpitam abhūt tasmin avatiṣṭha, yataḥ kasmāt śikṣāṁ prāpto'si tad vetsi;</para>
  <para style="p">
    <verse number="15" style="v"/>yāni ca dharmmaśāstrāṇi khrīṣṭe yīśau viśvāsena paritrāṇaprāptaye tvāṁ jñāninaṁ karttuṁ śaknuvanti tāni tvaṁ śaiśavakālād avagato'si|</para>
  <para style="p">
    <verse number="16" style="v"/>tat sarvvaṁ śāstram īśvarasyātmanā dattaṁ śikṣāyai doṣabodhāya śodhanāya dharmmavinayāya ca phalayūktaṁ bhavati</para>
  <para style="p">
    <verse number="17" style="v"/>tena ceśvarasya loko nipuṇaḥ sarvvasmai satkarmmaṇe susajjaśca bhavati|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>īśvarasya gocare yaśca yīśuḥ khrīṣṭaḥ svīyāgamanakāle svarājatvena jīvatāṁ mṛtānāñca lokānāṁ vicāraṁ kariṣyati tasya gocare 'haṁ tvām idaṁ dṛḍham ājñāpayāmi|</para>
  <para style="p">
    <verse number="2" style="v"/>tvaṁ vākyaṁ ghoṣaya kāle'kāle cotsuko bhava pūrṇayā sahiṣṇutayā śikṣayā ca lokān prabodhaya bhartsaya vinayasva ca|</para>
  <para style="p">
    <verse number="3" style="v"/>yata etādṛśaḥ samaya āyāti yasmin lokā yathārtham upadeśam asahyamānāḥ karṇakaṇḍūyanaviśiṣṭā bhūtvā nijābhilāṣāt śikṣakān saṁgrahīṣyanti</para>
  <para style="p">
    <verse number="4" style="v"/>satyamatācca śrotrāṇi nivarttya vipathagāmino bhūtvopākhyāneṣu pravarttiṣyante;</para>
  <para style="p">
    <verse number="5" style="v"/>kintu tvaṁ sarvvaviṣaye prabuddho bhava duḥkhabhogaṁ svīkuru susaṁvādapracārakasya karmma sādhaya nijaparicaryyāṁ pūrṇatvena kuru ca|</para>
  <para style="p">
    <verse number="6" style="v"/>mama prāṇānām utsargo bhavati mama prasthānakālaścopātiṣṭhat|</para>
  <para style="p">
    <verse number="7" style="v"/>aham uttamayuddhaṁ kṛtavān gantavyamārgasyāntaṁ yāvad dhāvitavān viśvāsañca rakṣitavān|</para>
  <para style="p">
    <verse number="8" style="v"/>śeṣaṁ puṇyamukuṭaṁ madarthaṁ rakṣitaṁ vidyate tacca tasmin mahādine yathārthavicārakeṇa prabhunā mahyaṁ dāyiṣyate kevalaṁ mahyam iti nahi kintu yāvanto lokāstasyāgamanam ākāṅkṣante tebhyaḥ sarvvebhyo 'pi dāyiṣyate|</para>
  <para style="p">
    <verse number="9" style="v"/>tvaṁ tvarayā matsamīpam āgantuṁ yatasva,</para>
  <para style="p">
    <verse number="10" style="v"/>yato dīmā aihikasaṁsāram īhamāno māṁ parityajya thiṣalanīkīṁ gatavān tathā krīṣki rgālātiyāṁ gatavān tītaśca dālmātiyāṁ gatavān|</para>
  <para style="p">
    <verse number="11" style="v"/>kevalo lūko mayā sārddhaṁ vidyate| tvaṁ mārkaṁ saṅginaṁ kṛtvāgaccha yataḥ sa paricaryyayā mamopakārī bhaviṣyati,</para>
  <para style="p">
    <verse number="12" style="v"/>tukhikañcāham iphiṣanagaraṁ preṣitavān|</para>
  <para style="p">
    <verse number="13" style="v"/>yad ācchādanavastraṁ troyānagare kārpasya sannidhau mayā nikṣiptaṁ tvamāgamanasamaye tat pustakāni ca viśeṣataścarmmagranthān ānaya|</para>
  <para style="p">
    <verse number="14" style="v"/>kāṁsyakāraḥ sikandaro mama bahvaniṣṭaṁ kṛtavān prabhustasya karmmaṇāṁ samucitaphalaṁ dadātu|</para>
  <para style="p">
    <verse number="15" style="v"/>tvamapi tasmāt sāvadhānāstiṣṭha yataḥ so'smākaṁ vākyānām atīva vipakṣo jātaḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>mama prathamapratyuttarasamaye ko'pi mama sahāyo nābhavat sarvve māṁ paryyatyajan tān prati tasya doṣasya gaṇanā na bhūyāt;</para>
  <para style="p">
    <verse number="17" style="v"/>kintu prabhu rmama sahāyo 'bhavat yathā ca mayā ghoṣaṇā sādhyeta bhinnajātīyāśca sarvve susaṁvādaṁ śṛṇuyustathā mahyaṁ śaktim adadāt tato 'haṁ siṁhasya mukhād uddhṛtaḥ|</para>
  <para style="p">
    <verse number="18" style="v"/>aparaṁ sarvvasmād duṣkarmmataḥ prabhu rmām uddhariṣyati nijasvargīyarājyaṁ netuṁ māṁ tārayiṣyati ca| tasya dhanyavādaḥ sadākālaṁ bhūyāt| āmen|</para>
  <para style="p">
    <verse number="19" style="v"/>tvaṁ priṣkām ākkilam anīṣipharasya parijanāṁśca namaskuru|</para>
  <para style="p">
    <verse number="20" style="v"/>irāstaḥ karinthanagare 'tiṣṭhat traphimaśca pīḍitatvāt milītanagare mayā vyahīyata|</para>
  <para style="p">
    <verse number="21" style="v"/>tvaṁ hemantakālāt pūrvvam āgantuṁ yatasva| ubūlaḥ pūdi rlīnaḥ klaudiyā sarvve bhrātaraśca tvāṁ namaskurvvate|</para>
  <para style="p">
    <verse number="22" style="v"/>prabhu ryīśuḥ khrīṣṭastavātmanā saha bhūyāt| yuṣmāsvanugraho bhūyāt| āmen|</para>
</usx>
