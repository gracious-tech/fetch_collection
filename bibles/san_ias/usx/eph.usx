  <para style="h">Ephesians</para>
  <para style="toc1">iphiṣiṇaḥ patraṁ</para>
  <para style="toc2">iphiṣiṇaḥ</para>
  <para style="toc3">iphiṣiṇaḥ</para>
  <para style="mt1">iphiṣiṇaḥ patraṁ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>īśvarasyecchayā yīśukhrīṣṭasya preritaḥ paula iphiṣanagarasthān pavitrān khrīṣṭayīśau viśvāsino lokān prati patraṁ likhati|</para>
  <para style="p">
    <verse number="2" style="v"/>asmākaṁ tātasyeśvarasya prabho ryīśukhrīṣṭasya cānugrahaḥ śāntiśca yuṣmāsu varttatāṁ|</para>
  <para style="p">
    <verse number="3" style="v"/>asmākaṁ prabho ryīśoḥ khrīṣṭasya tāta īśvaro dhanyo bhavatu; yataḥ sa khrīṣṭenāsmabhyaṁ sarvvam ādhyātmikaṁ svargīyavaraṁ dattavān|</para>
  <para style="p">
    <verse number="4" style="v"/>vayaṁ yat tasya samakṣaṁ premnā pavitrā niṣkalaṅkāśca bhavāmastadarthaṁ sa jagataḥ sṛṣṭe pūrvvaṁ tenāsmān abhirocitavān, nijābhilaṣitānurodhācca</para>
  <para style="p">
    <verse number="5" style="v"/>yīśunā khrīṣṭena svasya nimittaṁ putratvapade'smān svakīyānugrahasya mahattvasya praśaṁsārthaṁ pūrvvaṁ niyuktavān|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmād anugrahāt sa yena priyatamena putreṇāsmān anugṛhītavān,</para>
  <para style="p">
    <verse number="7" style="v"/>vayaṁ tasya śoṇitena muktim arthataḥ pāpakṣamāṁ labdhavantaḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>tasya ya īdṛśo'nugrahanidhistasmāt so'smabhyaṁ sarvvavidhaṁ jñānaṁ buddhiñca bāhulyarūpeṇa vitaritavān|</para>
  <para style="p">
    <verse number="9" style="v"/>svargapṛthivyo ryadyad vidyate tatsarvvaṁ sa khrīṣṭe saṁgrahīṣyatīti hitaiṣiṇā</para>
  <para style="p">
    <verse number="10" style="v"/>tena kṛto yo manorathaḥ sampūrṇatāṁ gatavatsu samayeṣu sādhayitavyastamadhi sa svakīyābhilāṣasya nigūḍhaṁ bhāvam asmān jñāpitavān|</para>
  <para style="p">
    <verse number="11" style="v"/>pūrvvaṁ khrīṣṭe viśvāsino ye vayam asmatto yat tasya mahimnaḥ praśaṁsā jāyate,</para>
  <para style="p">
    <verse number="12" style="v"/>tadarthaṁ yaḥ svakīyecchāyāḥ mantraṇātaḥ sarvvāṇi sādhayati tasya manorathād vayaṁ khrīṣṭena pūrvvaṁ nirūpitāḥ santo'dhikāriṇo jātāḥ|</para>
  <para style="p">
    <verse number="13" style="v"/>yūyamapi satyaṁ vākyam arthato yuṣmatparitrāṇasya susaṁvādaṁ niśamya tasminneva khrīṣṭe viśvasitavantaḥ pratijñātena pavitreṇātmanā mudrayevāṅkitāśca|</para>
  <para style="p">
    <verse number="14" style="v"/>yatastasya mahimnaḥ prakāśāya tena krītānāṁ lokānāṁ mukti ryāvanna bhaviṣyati tāvat sa ātmāsmākam adhikāritvasya satyaṅkārasya paṇasvarūpo bhavati|</para>
  <para style="p">
    <verse number="15" style="v"/>prabhau yīśau yuṣmākaṁ viśvāsaḥ sarvveṣu pavitralokeṣu prema cāsta iti vārttāṁ śrutvāhamapi</para>
  <para style="p">
    <verse number="16" style="v"/>yuṣmānadhi nirantaram īśvaraṁ dhanyaṁ vadan prārthanāsamaye ca yuṣmān smaran varamimaṁ yācāmi|</para>
  <para style="p">
    <verse number="17" style="v"/>asmākaṁ prabho ryīśukhrīṣṭasya tāto yaḥ prabhāvākara īśvaraḥ sa svakīyatattvajñānāya yuṣmabhyaṁ jñānajanakam prakāśitavākyabodhakañcātmānaṁ deyāt|</para>
  <para style="p">
    <verse number="18" style="v"/>yuṣmākaṁ jñānacakṣūṁṣi ca dīptiyuktāni kṛtvā tasyāhvānaṁ kīdṛśyā pratyāśayā sambalitaṁ pavitralokānāṁ madhye tena datto'dhikāraḥ kīdṛśaḥ prabhāvanidhi rviśvāsiṣu cāsmāsu prakāśamānasya</para>
  <para style="p">
    <verse number="19" style="v"/>tadīyamahāparākramasya mahatvaṁ kīdṛg anupamaṁ tat sarvvaṁ yuṣmān jñāpayatu|</para>
  <para style="p">
    <verse number="20" style="v"/>yataḥ sa yasyāḥ śakteḥ prabalatāṁ khrīṣṭe prakāśayan mṛtagaṇamadhyāt tam utthāpitavān,</para>
  <para style="p">
    <verse number="21" style="v"/>adhipatitvapadaṁ śāsanapadaṁ parākramo rājatvañcetināmāni yāvanti padānīha loke paraloke ca vidyante teṣāṁ sarvveṣām ūrddhve svarge nijadakṣiṇapārśve tam upaveśitavān,</para>
  <para style="p">
    <verse number="22" style="v"/>sarvvāṇi tasya caraṇayoradho nihitavān yā samitistasya śarīraṁ sarvvatra sarvveṣāṁ pūrayituḥ pūrakañca bhavati taṁ tasyā mūrddhānaṁ kṛtvā</para>
  <para style="p">
    <verse number="23" style="v"/>sarvveṣām uparyyupari niyuktavāṁśca saiva śaktirasmāsvapi tena prakāśyate|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>purā yūyam aparādhaiḥ pāpaiśca mṛtāḥ santastānyācaranta ihalokasya saṁsārānusāreṇākāśarājyasyādhipatim</para>
  <para style="p">
    <verse number="2" style="v"/>arthataḥ sāmpratam ājñālaṅghivaṁśeṣu karmmakāriṇam ātmānam anvavrajata|</para>
  <para style="p">
    <verse number="3" style="v"/>teṣāṁ madhye sarvve vayamapi pūrvvaṁ śarīrasya manaskāmanāyāñcehāṁ sādhayantaḥ svaśarīrasyābhilāṣān ācarāma sarvve'nya iva ca svabhāvataḥ krodhabhajanānyabhavāma|</para>
  <para style="p">
    <verse number="4" style="v"/>kintu karuṇānidhirīśvaro yena mahāpremnāsmān dayitavān</para>
  <para style="p">
    <verse number="5" style="v"/>tasya svapremno bāhulyād aparādhai rmṛtānapyasmān khrīṣṭena saha jīvitavān yato'nugrahād yūyaṁ paritrāṇaṁ prāptāḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>sa ca khrīṣṭena yīśunāsmān tena sārddham utthāpitavān svarga upaveśitavāṁśca|</para>
  <para style="p">
    <verse number="7" style="v"/>itthaṁ sa khrīṣṭena yīśunāsmān prati svahitaiṣitayā bhāviyugeṣu svakīyānugrahasyānupamaṁ nidhiṁ prakāśayitum icchati|</para>
  <para style="p">
    <verse number="8" style="v"/>yūyam anugrahād viśvāsena paritrāṇaṁ prāptāḥ, tacca yuṣmanmūlakaṁ nahi kintvīśvarasyaiva dānaṁ,</para>
  <para style="p">
    <verse number="9" style="v"/>tat karmmaṇāṁ phalam api nahi, ataḥ kenāpi na ślāghitavyaṁ|</para>
  <para style="p">
    <verse number="10" style="v"/>yato vayaṁ tasya kāryyaṁ prāg īśvareṇa nirūpitābhiḥ satkriyābhiḥ kālayāpanāya khrīṣṭe yīśau tena mṛṣṭāśca|</para>
  <para style="p">
    <verse number="11" style="v"/>purā janmanā bhinnajātīyā hastakṛtaṁ tvakchedaṁ prāptai rlokaiścācchinnatvaca itināmnā khyātā ye yūyaṁ tai ryuṣmābhiridaṁ smarttavyaṁ</para>
  <para style="p">
    <verse number="12" style="v"/>yat tasmin samaye yūyaṁ khrīṣṭād bhinnā isrāyelalokānāṁ sahavāsād dūrasthāḥ pratijñāsambalitaniyamānāṁ bahiḥ sthitāḥ santo nirāśā nirīśvarāśca jagatyādhvam iti|</para>
  <para style="p">
    <verse number="13" style="v"/>kintvadhunā khrīṣṭe yīśāvāśrayaṁ prāpya purā dūravarttino yūyaṁ khrīṣṭasya śoṇitena nikaṭavarttino'bhavata|</para>
  <para style="p">
    <verse number="14" style="v"/>yataḥ sa evāsmākaṁ sandhiḥ sa dvayam ekīkṛtavān śatrutārūpiṇīṁ madhyavarttinīṁ prabhedakabhittiṁ bhagnavān daṇḍājñāyuktaṁ vidhiśāstraṁ svaśarīreṇa luptavāṁśca|</para>
  <para style="p">
    <verse number="15" style="v"/>yataḥ sa sandhiṁ vidhāya tau dvau svasmin ekaṁ nutanaṁ mānavaṁ karttuṁ</para>
  <para style="p">
    <verse number="16" style="v"/>svakīyakruśe śatrutāṁ nihatya tenaivaikasmin śarīre tayo rdvayorīśvareṇa sandhiṁ kārayituṁ niścatavān|</para>
  <para style="p">
    <verse number="17" style="v"/>sa cāgatya dūravarttino yuṣmān nikaṭavarttino 'smāṁśca sandhe rmaṅgalavārttāṁ jñāpitavān|</para>
  <para style="p">
    <verse number="18" style="v"/>yatastasmād ubhayapakṣīyā vayam ekenātmanā pituḥ samīpaṁ gamanāya sāmarthyaṁ prāptavantaḥ|</para>
  <para style="p">
    <verse number="19" style="v"/>ata idānīṁ yūyam asamparkīyā videśinaśca na tiṣṭhanataḥ pavitralokaiḥ sahavāsina īśvarasya veśmavāsinaścādhve|</para>
  <para style="p">
    <verse number="20" style="v"/>aparaṁ preritā bhaviṣyadvādinaśca yatra bhittimūlasvarūpāstatra yūyaṁ tasmin mūle nicīyadhve tatra ca svayaṁ yīśuḥ khrīṣṭaḥ pradhānaḥ koṇasthaprastaraḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>tena kṛtsnā nirmmitiḥ saṁgrathyamānā prabhoḥ pavitraṁ mandiraṁ bhavituṁ varddhate|</para>
  <para style="p">
    <verse number="22" style="v"/>yūyamapi tatra saṁgrathyamānā ātmaneśvarasya vāsasthānaṁ bhavatha|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ato heto rbhinnajātīyānāṁ yuṣmākaṁ nimittaṁ yīśukhrīṣṭasya bandī yaḥ so'haṁ paulo bravīmi|</para>
  <para style="p">
    <verse number="2" style="v"/>yuṣmadartham īśvareṇa mahyaṁ dattasya varasya niyamaḥ kīdṛśastad yuṣmābhiraśrāvīti manye|</para>
  <para style="p">
    <verse number="3" style="v"/>arthataḥ pūrvvaṁ mayā saṁkṣepeṇa yathā likhitaṁ tathāhaṁ prakāśitavākyeneśvarasya nigūḍhaṁ bhāvaṁ jñāpito'bhavaṁ|</para>
  <para style="p">
    <verse number="4" style="v"/>ato yuṣmābhistat paṭhitvā khrīṣṭamadhi tasminnigūḍhe bhāve mama jñānaṁ kīdṛśaṁ tad bhotsyate|</para>
  <para style="p">
    <verse number="5" style="v"/>pūrvvayugeṣu mānavasantānāstaṁ jñāpitā nāsan kintvadhunā sa bhāvastasya pavitrān preritān bhaviṣyadvādinaśca pratyātmanā prakāśito'bhavat;</para>
  <para style="p">
    <verse number="6" style="v"/>arthata īśvarasya śakteḥ prakāśāt tasyānugraheṇa yo varo mahyam adāyi tenāhaṁ yasya susaṁvādasya paricārako'bhavaṁ,</para>
  <para style="p">
    <verse number="7" style="v"/>tadvārā khrīṣṭena bhinnajātīyā anyaiḥ sārddham ekādhikārā ekaśarīrā ekasyāḥ pratijñāyā aṁśinaśca bhaviṣyantīti|</para>
  <para style="p">
    <verse number="8" style="v"/>sarvveṣāṁ pavitralokānāṁ kṣudratamāya mahyaṁ varo'yam adāyi yad bhinnajātīyānāṁ madhye bodhāgayasya guṇanidheḥ khrīṣṭasya maṅgalavārttāṁ pracārayāmi,</para>
  <para style="p">
    <verse number="9" style="v"/>kālāvasthātaḥ pūrvvasmācca yo nigūḍhabhāva īśvare gupta āsīt tadīyaniyamaṁ sarvvān jñāpayāmi|</para>
  <para style="p">
    <verse number="10" style="v"/>yata īśvarasya nānārūpaṁ jñānaṁ yat sāmprataṁ samityā svarge prādhānyaparākramayuktānāṁ dūtānāṁ nikaṭe prakāśyate tadarthaṁ sa yīśunā khrīṣṭena sarvvāṇi sṛṣṭavān|</para>
  <para style="p">
    <verse number="11" style="v"/>yato vayaṁ yasmin viśvasya dṛḍhabhaktyā nirbhayatām īśvarasya samāgame sāmarthyañca</para>
  <para style="p">
    <verse number="12" style="v"/>prāptavantastamasmākaṁ prabhuṁ yīśuṁ khrīṣṭamadhi sa kālāvasthāyāḥ pūrvvaṁ taṁ manorathaṁ kṛtavān|</para>
  <para style="p">
    <verse number="13" style="v"/>ato'haṁ yuṣmannimittaṁ duḥkhabhogena klāntiṁ yanna gacchāmīti prārthaye yatastadeva yuṣmākaṁ gauravaṁ|</para>
  <para style="p">
    <verse number="14" style="v"/>ato hetoḥ svargapṛthivyoḥ sthitaḥ kṛtsno vaṁśo yasya nāmnā vikhyātastam</para>
  <para style="p">
    <verse number="15" style="v"/>asmatprabho ryīśukhrīṣṭasya pitaramuddiśyāhaṁ jānunī pātayitvā tasya prabhāvanidhito varamimaṁ prārthaye|</para>
  <para style="p">
    <verse number="16" style="v"/>tasyātmanā yuṣmākam āntarikapuruṣasya śakte rvṛddhiḥ kriyatāṁ|</para>
  <para style="p">
    <verse number="17" style="v"/>khrīṣṭastu viśvāsena yuṣmākaṁ hṛdayeṣu nivasatu| premaṇi yuṣmākaṁ baddhamūlatvaṁ susthiratvañca bhavatu|</para>
  <para style="p">
    <verse number="18" style="v"/>itthaṁ prasthatāyā dīrghatāyā gabhīratāyā uccatāyāśca bodhāya sarvvaiḥ pavitralokaiḥ prāpyaṁ sāmarthyaṁ yuṣmābhi rlabhyatāṁ,</para>
  <para style="p">
    <verse number="19" style="v"/>jñānātiriktaṁ khrīṣṭasya prema jñāyatām īśvarasya sampūrṇavṛddhiparyyantaṁ yuṣmākaṁ vṛddhi rbhavatu ca|</para>
  <para style="p">
    <verse number="20" style="v"/>asmākam antare yā śaktiḥ prakāśate tayā sarvvātiriktaṁ karmma kurvvan asmākaṁ prārthanāṁ kalpanāñcātikramituṁ yaḥ śaknoti</para>
  <para style="p">
    <verse number="21" style="v"/>khrīṣṭayīśunā samite rmadhye sarvveṣu yugeṣu tasya dhanyavādo bhavatu| iti|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ato bandirahaṁ prabho rnāmnā yuṣmān vinaye yūyaṁ yenāhvānenāhūtāstadupayuktarūpeṇa</para>
  <para style="p">
    <verse number="2" style="v"/>sarvvathā namratāṁ mṛdutāṁ titikṣāṁ parasparaṁ pramnā sahiṣṇutāñcācarata|</para>
  <para style="p">
    <verse number="3" style="v"/>praṇayabandhanena cātmana eैkyaṁ rakṣituṁ yatadhvaṁ|</para>
  <para style="p">
    <verse number="4" style="v"/>yūyam ekaśarīrā ekātmānaśca tadvad āhvānena yūyam ekapratyāśāprāptaye samāhūtāḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>yuṣmākam ekaḥ prabhureko viśvāsa ekaṁ majjanaṁ, sarvveṣāṁ tātaḥ</para>
  <para style="p">
    <verse number="6" style="v"/>sarvvoparisthaḥ sarvvavyāpī sarvveṣāṁ yuṣmākaṁ madhyavarttī caika īśvara āste|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu khrīṣṭasya dānaparimāṇānusārād asmākam ekaikasmai viśeṣo varo'dāyi|</para>
  <para style="p">
    <verse number="8" style="v"/>yathā likhitam āste, "ūrddhvam āruhya jetṛn sa vijitya bandino'karot| tataḥ sa manujebhyo'pi svīyān vyaśrāṇayad varān||"</para>
  <para style="p">
    <verse number="9" style="v"/>ūrddhvam āruhyetivākyasyāyamarthaḥ sa pūrvvaṁ pṛthivīrūpaṁ sarvvādhaḥsthitaṁ sthānam avatīrṇavān;</para>
  <para style="p">
    <verse number="10" style="v"/>yaścāvatīrṇavān sa eva svargāṇām uparyyuparyyārūḍhavān yataḥ sarvvāṇi tena pūrayitavyāni|</para>
  <para style="p">
    <verse number="11" style="v"/>sa eva ca kāṁścana preritān aparān bhaviṣyadvādino'parān susaṁvādapracārakān aparān pālakān upadeśakāṁśca niyuktavān|</para>
  <para style="p">
    <verse number="12" style="v"/>yāvad vayaṁ sarvve viśvāsasyeśvaraputraviṣayakasya tattvajñānasya caikyaṁ sampūrṇaṁ puruṣarthañcārthataḥ khrīṣṭasya sampūrṇaparimāṇasya samaṁ parimāṇaṁ na prāpnumastāvat</para>
  <para style="p">
    <verse number="13" style="v"/>sa paricaryyākarmmasādhanāya khrīṣṭasya śarīrasya niṣṭhāyai ca pavitralokānāṁ siddhatāyāstādṛśam upāyaṁ niścitavān|</para>
  <para style="p">
    <verse number="14" style="v"/>ataeva mānuṣāṇāṁ cāturīto bhramakadhūrttatāyāśchalācca jātena sarvveṇa śikṣāvāyunā vayaṁ yad bālakā iva dolāyamānā na bhrāmyāma ityasmābhi ryatitavyaṁ,</para>
  <para style="p">
    <verse number="15" style="v"/>premnā satyatām ācaradbhiḥ sarvvaviṣaye khrīṣṭam uddiśya varddhitavyañca, yataḥ sa mūrddhā,</para>
  <para style="p">
    <verse number="16" style="v"/>tasmāccaikaikasyāṅgasya svasvaparimāṇānusāreṇa sāhāyyakaraṇād upakārakaiḥ sarvvaiḥ sandhibhiḥ kṛtsnasya śarīrasya saṁyoge sammilane ca jāte premnā niṣṭhāṁ labhamānaṁ kṛtsnaṁ śarīraṁ vṛddhiṁ prāpnoti|</para>
  <para style="p">
    <verse number="17" style="v"/>yuṣmān ahaṁ prabhunedaṁ bravīmyādiśāmi ca, anye bhinnajātīyā iva yūyaṁ pūna rmācarata|</para>
  <para style="p">
    <verse number="18" style="v"/>yataste svamanomāyām ācarantyāntarikājñānāt mānasikakāṭhinyācca timirāvṛtabuddhaya īśvarīyajīvanasya bagīrbhūtāśca bhavanti,</para>
  <para style="p">
    <verse number="19" style="v"/>svān caitanyaśūnyān kṛtvā ca lobhena sarvvavidhāśaucācaraṇāya lampaṭatāyāṁ svān samarpitavantaḥ|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu yūyaṁ khrīṣṭaṁ na tādṛśaṁ paricitavantaḥ,</para>
  <para style="p">
    <verse number="21" style="v"/>yato yūyaṁ taṁ śrutavanto yā satyā śikṣā yīśuto labhyā tadanusārāt tadīyopadeśaṁ prāptavantaśceti manye|</para>
  <para style="p">
    <verse number="22" style="v"/>tasmāt pūrvvakālikācārakārī yaḥ purātanapuruṣo māyābhilāṣai rnaśyati taṁ tyaktvā yuṣmābhi rmānasikabhāvo nūtanīkarttavyaḥ,</para>
  <para style="p">
    <verse number="23" style="v"/>yo navapuruṣa īśvarānurūpeṇa puṇyena satyatāsahitena</para>
  <para style="p">
    <verse number="24" style="v"/>dhārmmikatvena ca sṛṣṭaḥ sa eva paridhātavyaśca|</para>
  <para style="p">
    <verse number="25" style="v"/>ato yūyaṁ sarvve mithyākathanaṁ parityajya samīpavāsibhiḥ saha satyālāpaṁ kuruta yato vayaṁ parasparam aṅgapratyaṅgā bhavāmaḥ|</para>
  <para style="p">
    <verse number="26" style="v"/>aparaṁ krodhe jāte pāpaṁ mā kurudhvam, aśānte yuṣmākaṁ roṣesūryyo'staṁ na gacchatu|</para>
  <para style="p">
    <verse number="27" style="v"/>aparaṁ śayatāne sthānaṁ mā datta|</para>
  <para style="p">
    <verse number="28" style="v"/>coraḥ punaścairyyaṁ na karotu kintu dīnāya dāne sāmarthyaṁ yajjāyate tadarthaṁ svakarābhyāṁ sadvṛttyā pariśramaṁ karotu|</para>
  <para style="p">
    <verse number="29" style="v"/>aparaṁ yuṣmākaṁ vadanebhyaḥ ko'pi kadālāpo na nirgacchatu, kintu yena śroturupakāro jāyate tādṛśaḥ prayojanīyaniṣṭhāyai phaladāyaka ālāpo yuṣmākaṁ bhavatu|</para>
  <para style="p">
    <verse number="30" style="v"/>aparañca yūyaṁ muktidinaparyyantam īśvarasya yena pavitreṇātmanā mudrayāṅkitā abhavata taṁ śokānvitaṁ mā kuruta|</para>
  <para style="p">
    <verse number="31" style="v"/>aparaṁ kaṭuvākyaṁ roṣaḥ koṣaḥ kalaho nindā sarvvavidhadveṣaścaitāni yuṣmākaṁ madhyād dūrībhavantu|</para>
  <para style="p">
    <verse number="32" style="v"/>yūyaṁ parasparaṁ hitaiṣiṇaḥ komalāntaḥkaraṇāśca bhavata| aparam īśvaraḥ khrīṣṭena yadvad yuṣmākaṁ doṣān kṣamitavān tadvad yūyamapi parasparaṁ kṣamadhvaṁ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ato yūyaṁ priyabālakā iveśvarasyānukāriṇo bhavata,</para>
  <para style="p">
    <verse number="2" style="v"/>khrīṣṭa iva premācāraṁ kuruta ca, yataḥ so'smāsu prema kṛtavān asmākaṁ vinimayena cātmanivedanaṁ kṛtvā grāhyasugandhārthakam upahāraṁ baliñceśvarāca dattavān|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu veśyāgamanaṁ sarvvavidhāśaucakriyā lobhaścaiteṣām uccāraṇamapi yuṣmākaṁ madhye na bhavatu, etadeva pavitralokānām ucitaṁ|</para>
  <para style="p">
    <verse number="4" style="v"/>aparaṁ kutsitālāpaḥ pralāpaḥ śleṣoktiśca na bhavatu yata etānyanucitāni kintvīśvarasya dhanyavādo bhavatu|</para>
  <para style="p">
    <verse number="5" style="v"/>veśyāgāmyaśaucācārī devapūjaka iva gaṇyo lobhī caiteṣāṁ koṣi khrīṣṭasya rājye'rthata īśvarasya rājye kamapyadhikāraṁ na prāpsyatīti yuṣmābhiḥ samyak jñāyatāṁ|</para>
  <para style="p">
    <verse number="6" style="v"/>anarthakavākyena ko'pi yuṣmān na vañcayatu yatastādṛgācārahetoranājñāgrāhiṣu lokeṣvīśvarasya kopo varttate|</para>
  <para style="p">
    <verse number="7" style="v"/>tasmād yūyaṁ taiḥ sahabhāgino na bhavata|</para>
  <para style="p">
    <verse number="8" style="v"/>pūrvvaṁ yūyam andhakārasvarūpā ādhvaṁ kintvidānīṁ prabhunā dīptisvarūpā bhavatha tasmād dīpteḥ santānā iva samācarata|</para>
  <para style="p">
    <verse number="9" style="v"/>dīpte ryat phalaṁ tat sarvvavidhahitaiṣitāyāṁ dharmme satyālāpe ca prakāśate|</para>
  <para style="p">
    <verse number="10" style="v"/>prabhave yad rocate tat parīkṣadhvaṁ|</para>
  <para style="p">
    <verse number="11" style="v"/>yūyaṁ timirasya viphalakarmmaṇām aṁśino na bhūtvā teṣāṁ doṣitvaṁ prakāśayata|</para>
  <para style="p">
    <verse number="12" style="v"/>yataste lokā rahami yad yad ācaranti taduccāraṇam api lajjājanakaṁ|</para>
  <para style="p">
    <verse number="13" style="v"/>yato dīptyā yad yat prakāśyate tat tayā cakāsyate yacca cakāsti tad dīptisvarūpaṁ bhavati|</para>
  <para style="p">
    <verse number="14" style="v"/>etatkāraṇād uktam āste, "he nidrita prabudhyasva mṛtebhyaścotthitiṁ kuru| tatkṛte sūryyavat khrīṣṭaḥ svayaṁ tvāṁ dyotayiṣyati|"</para>
  <para style="p">
    <verse number="15" style="v"/>ataḥ sāvadhānā bhavata, ajñānā iva mācarata kintu jñānina iva satarkam ācarata|</para>
  <para style="p">
    <verse number="16" style="v"/>samayaṁ bahumūlyaṁ gaṇayadhvaṁ yataḥ kālā abhadrāḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>tasmād yūyam ajñānā na bhavata kintu prabhorabhimataṁ kiṁ tadavagatā bhavata|</para>
  <para style="p">
    <verse number="18" style="v"/>sarvvanāśajanakena surāpānena mattā mā bhavata kintvātmanā pūryyadhvaṁ|</para>
  <para style="p">
    <verse number="19" style="v"/>aparaṁ gītai rgānaiḥ pāramārthikakīrttanaiśca parasparam ālapanto manasā sārddhaṁ prabhum uddiśya gāyata vādayata ca|</para>
  <para style="p">
    <verse number="20" style="v"/>sarvvadā sarvvaviṣaye'smatprabho yīśoḥ khrīṣṭasya nāmnā tātam īśvaraṁ dhanyaṁ vadata|</para>
  <para style="p">
    <verse number="21" style="v"/>yūyam īśvarād bhītāḥ santa anye'pareṣāṁ vaśībhūtā bhavata|</para>
  <para style="p">
    <verse number="22" style="v"/>he yoṣitaḥ, yūyaṁ yathā prabhostathā svasvasvāmino vaśaṅgatā bhavata|</para>
  <para style="p">
    <verse number="23" style="v"/>yataḥ khrīṣṭo yadvat samite rmūrddhā śarīrasya trātā ca bhavati tadvat svāmī yoṣito mūrddhā|</para>
  <para style="p">
    <verse number="24" style="v"/>ataḥ samiti ryadvat khrīṣṭasya vaśībhūtā tadvad yoṣidbhirapi svasvasvāmino vaśatā svīkarttavyā|</para>
  <para style="p">
    <verse number="25" style="v"/>aparañca he puruṣāḥ, yūyaṁ khrīṣṭa iva svasvayoṣitsu prīyadhvaṁ|</para>
  <para style="p">
    <verse number="26" style="v"/>sa khrīṣṭo'pi samitau prītavān tasyāḥ kṛte ca svaprāṇān tyaktavān yataḥ sa vākye jalamajjanena tāṁ pariṣkṛtya pāvayitum</para>
  <para style="p">
    <verse number="27" style="v"/>aparaṁ tilakavalyādivihīnāṁ pavitrāṁ niṣkalaṅkāñca tāṁ samitiṁ tejasvinīṁ kṛtvā svahaste samarpayituñcābhilaṣitavān|</para>
  <para style="p">
    <verse number="28" style="v"/>tasmāt svatanuvat svayoṣiti premakaraṇaṁ puruṣasyocitaṁ, yena svayoṣiti prema kriyate tenātmaprema kriyate|</para>
  <para style="p">
    <verse number="29" style="v"/>ko'pi kadāpi na svakīyāṁ tanum ṛtīyitavān kintu sarvve tāṁ vibhrati puṣṇanti ca| khrīṣṭo'pi samitiṁ prati tadeva karoti,</para>
  <para style="p">
    <verse number="30" style="v"/>yato vayaṁ tasya śarīrasyāṅgāni māṁsāsthīni ca bhavāmaḥ|</para>
  <para style="p">
    <verse number="31" style="v"/>etadarthaṁ mānavaḥ svamātāpitaroै parityajya svabhāryyāyām āsaṁkṣyati tau dvau janāvekāṅgau bhaviṣyataḥ|</para>
  <para style="p">
    <verse number="32" style="v"/>etannigūḍhavākyaṁ gurutaraṁ mayā ca khrīṣṭasamitī adhi tad ucyate|</para>
  <para style="p">
    <verse number="33" style="v"/>ataeva yuṣmākam ekaiko jana ātmavat svayoṣiti prīyatāṁ bhāryyāpi svāminaṁ samādarttuṁ yatatāṁ|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he bālakāḥ, yūyaṁ prabhum uddiśya pitrorājñāgrāhiṇo bhavata yatastat nyāyyaṁ|</para>
  <para style="p">
    <verse number="2" style="v"/>tvaṁ nijapitaraṁ mātarañca sammanyasveti yo vidhiḥ sa pratijñāyuktaḥ prathamo vidhiḥ</para>
  <para style="p">
    <verse number="3" style="v"/>phalatastasmāt tava kalyāṇaṁ deśe ca dīrghakālam āyu rbhaviṣyatīti|</para>
  <para style="p">
    <verse number="4" style="v"/>aparaṁ he pitaraḥ, yūyaṁ svabālakān mā roṣayata kintu prabho rvinītyādeśābhyāṁ tān vinayata|</para>
  <para style="p">
    <verse number="5" style="v"/>he dāsāḥ, yūyaṁ khrīṣṭam uddiśya sabhayāḥ kampānvitāśca bhūtvā saralāntaḥkaraṇairaihikaprabhūnām ājñāgrāhiṇo bhavata|</para>
  <para style="p">
    <verse number="6" style="v"/>dṛṣṭigocarīyaparicaryyayā mānuṣebhyo rocituṁ mā yatadhvaṁ kintu khrīṣṭasya dāsā iva niviṣṭamanobhirīścarasyecchāṁ sādhayata|</para>
  <para style="p">
    <verse number="7" style="v"/>mānavān anuddiśya prabhumevoddiśya sadbhāvena dāsyakarmma kurudhvaṁ|</para>
  <para style="p">
    <verse number="8" style="v"/>dāsamuktayo ryena yat satkarmma kriyate tena tasya phalaṁ prabhuto lapsyata iti jānīta ca|</para>
  <para style="p">
    <verse number="9" style="v"/>aparaṁ he prabhavaḥ, yuṣmābhi rbhartsanaṁ vihāya tān prati nyāyyācaraṇaṁ kriyatāṁ yaśca kasyāpi pakṣapātaṁ na karoti yuṣmākamapi tādṛśa ekaḥ prabhuḥ svarge vidyata iti jñāyatāṁ|</para>
  <para style="p">
    <verse number="10" style="v"/>adhikantu he bhrātaraḥ, yūyaṁ prabhunā tasya vikramayuktaśaktyā ca balavanto bhavata|</para>
  <para style="p">
    <verse number="11" style="v"/>yūyaṁ yat śayatānaśchalāni nivārayituṁ śaknutha tadartham īśvarīyasusajjāṁ paridhaddhvaṁ|</para>
  <para style="p">
    <verse number="12" style="v"/>yataḥ kevalaṁ raktamāṁsābhyām iti nahi kintu kartṛtvaparākramayuktaistimirarājyasyehalokasyādhipatibhiḥ svargodbhavai rduṣṭātmabhireva sārddham asmābhi ryuddhaṁ kriyate|</para>
  <para style="p">
    <verse number="13" style="v"/>ato heto ryūyaṁ yayā saṁkuेle dine'vasthātuṁ sarvvāṇi parājitya dṛḍhāḥ sthātuñca śakṣyatha tām īśvarīyasusajjāṁ gṛhlīta|</para>
  <para style="p">
    <verse number="14" style="v"/>vastutastu satyatvena śṛṅkhalena kaṭiṁ baddhvā puṇyena varmmaṇā vakṣa ācchādya</para>
  <para style="p">
    <verse number="15" style="v"/>śānteḥ suvārttayā jātam utsāhaṁ pādukāyugalaṁ pade samarpya tiṣṭhata|</para>
  <para style="p">
    <verse number="16" style="v"/>yena ca duṣṭātmano'gnibāṇān sarvvān nirvvāpayituṁ śakṣyatha tādṛśaṁ sarvvācchādakaṁ phalakaṁ viśvāsaṁ dhārayata|</para>
  <para style="p">
    <verse number="17" style="v"/>śirastraṁ paritrāṇam ātmanaḥ khaṅgañceśvarasya vākyaṁ dhārayata|</para>
  <para style="p">
    <verse number="18" style="v"/>sarvvasamaye sarvvayācanena sarvvaprārthanena cātmanā prārthanāṁ kurudhvaṁ tadarthaṁ dṛḍhākāṅkṣayā jāgrataḥ sarvveṣāṁ pavitralokānāṁ kṛte sadā prārthanāṁ kurudhvaṁ|</para>
  <para style="p">
    <verse number="19" style="v"/>ahañca yasya susaṁvādasya śṛṅkhalabaddhaḥ pracārakadūto'smi tam upayuktenotsāhena pracārayituṁ yathā śaknuyāṁ</para>
  <para style="p">
    <verse number="20" style="v"/>tathā nirbhayena svareṇotsāhena ca susaṁvādasya nigūḍhavākyapracārāya vaktṛाtā yat mahyaṁ dīyate tadarthaṁ mamāpi kṛte prārthanāṁ kurudhvaṁ|</para>
  <para style="p">
    <verse number="21" style="v"/>aparaṁ mama yāvasthāsti yacca mayā kriyate tat sarvvaṁ yad yuṣmābhi rjñāyate tadarthaṁ prabhunā priyabhrātā viśvāsyaḥ paricārakaśca tukhiko yuṣmān tat jñāpayiṣyati|</para>
  <para style="p">
    <verse number="22" style="v"/>yūyaṁ yad asmākam avasthāṁ jānītha yuṣmākaṁ manāṁsi ca yat sāntvanāṁ labhante tadarthamevāhaṁ yuṣmākaṁ sannidhiṁ taṁ preṣitavāna|</para>
  <para style="p">
    <verse number="23" style="v"/>aparam īśvaraḥ prabhu ryīśukhrīṣṭaśca sarvvebhyo bhrātṛbhyaḥ śāntiṁ viśvāsasahitaṁ prema ca deyāt|</para>
  <para style="p">
    <verse number="24" style="v"/>ye kecit prabhau yīśukhrīṣṭe'kṣayaṁ prema kurvvanti tān prati prasādo bhūyāt| tathāstu|</para>
</usx>
