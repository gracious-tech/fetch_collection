  <para style="h">Galatians</para>
  <para style="toc1">gālātinaḥ patraṁ</para>
  <para style="toc2">gālātinaḥ</para>
  <para style="toc3">gālātinaḥ</para>
  <para style="mt1">gālātinaḥ patraṁ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>manuṣyebhyo nahi manuṣyairapi nahi kintu yīśukhrīṣṭena mṛtagaṇamadhyāt tasyotthāpayitrā pitreśvareṇa ca prerito yo'haṁ paulaḥ so'haṁ</para>
  <para style="p">
    <verse number="2" style="v"/>matsahavarttino bhrātaraśca vayaṁ gālātīyadeśasthāḥ samitīḥ prati patraṁ likhāmaḥ|</para>
  <para style="p">
    <verse number="3" style="v"/>pitreśvareṇāsmāṁka prabhunā yīśunā khrīṣṭena ca yuṣmabhyam anugrahaḥ śāntiśca dīyatāṁ|</para>
  <para style="p">
    <verse number="4" style="v"/>asmākaṁ tāteśvaresyecchānusāreṇa varttamānāt kutsitasaṁsārād asmān nistārayituṁ yo</para>
  <para style="p">
    <verse number="5" style="v"/>yīśurasmākaṁ pāpahetorātmotsargaṁ kṛtavān sa sarvvadā dhanyo bhūyāt| tathāstu|</para>
  <para style="p">
    <verse number="6" style="v"/>khrīṣṭasyānugraheṇa yo yuṣmān āhūtavān tasmānnivṛtya yūyam atitūrṇam anyaṁ susaṁvādam anvavarttata tatrāhaṁ vismayaṁ manye|</para>
  <para style="p">
    <verse number="7" style="v"/>so'nyasusaṁvādaḥ susaṁvādo nahi kintu kecit mānavā yuṣmān cañcalīkurvvanti khrīṣṭīyasusaṁvādasya viparyyayaṁ karttuṁ ceṣṭante ca|</para>
  <para style="p">
    <verse number="8" style="v"/>yuṣmākaṁ sannidhau yaḥ susaṁvādo'smābhi rghoṣitastasmād anyaḥ susaṁvādo'smākaṁ svargīyadūtānāṁ vā madhye kenacid yadi ghoṣyate tarhi sa śapto bhavatu|</para>
  <para style="p">
    <verse number="9" style="v"/>pūrvvaṁ yadvad akathayāma, idānīmahaṁ punastadvat kathayāmi yūyaṁ yaṁ susaṁvādaṁ gṛhītavantastasmād anyo yena kenacid yuṣmatsannidhau ghoṣyate sa śapto bhavatu|</para>
  <para style="p">
    <verse number="10" style="v"/>sāmprataṁ kamaham anunayāmi? īśvaraṁ kiṁvā mānavān? ahaṁ kiṁ mānuṣebhyo rocituṁ yate? yadyaham idānīmapi mānuṣebhyo ruruciṣeya tarhi khrīṣṭasya paricārako na bhavāmi|</para>
  <para style="p">
    <verse number="11" style="v"/>he bhrātaraḥ, mayā yaḥ susaṁvādo ghoṣitaḥ sa mānuṣānna labdhastadahaṁ yuṣmān jñāpayāmi|</para>
  <para style="p">
    <verse number="12" style="v"/>ahaṁ kasmāccit manuṣyāt taṁ na gṛhītavān na vā śikṣitavān kevalaṁ yīśoḥ khrīṣṭasya prakāśanādeva|</para>
  <para style="p">
    <verse number="13" style="v"/>purā yihūdimatācārī yadāham āsaṁ tadā yādṛśam ācaraṇam akaravam īśvarasya samitiṁ pratyatīvopadravaṁ kurvvan yādṛk tāṁ vyanāśayaṁ tadavaśyaṁ śrutaṁ yuṣmābhiḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>aparañca pūrvvapuruṣaparamparāgateṣu vākyeṣvanyāpekṣātīvāsaktaḥ san ahaṁ yihūdidharmmate mama samavayaskān bahūn svajātīyān atyaśayi|</para>
  <para style="p">
    <verse number="15" style="v"/>kiñca ya īśvaro mātṛgarbhasthaṁ māṁ pṛthak kṛtvā svīyānugraheṇāhūtavān</para>
  <para style="p">
    <verse number="16" style="v"/>sa yadā mayi svaputraṁ prakāśituṁ bhinnadeśīyānāṁ samīpe bhayā taṁ ghoṣayituñcābhyalaṣat tadāhaṁ kravyaśoṇitābhyāṁ saha na mantrayitvā</para>
  <para style="p">
    <verse number="17" style="v"/>pūrvvaniyuktānāṁ preritānāṁ samīpaṁ yirūśālamaṁ na gatvāravadeśaṁ gatavān paścāt tatsthānād dammeṣakanagaraṁ parāvṛtyāgatavān|</para>
  <para style="p">
    <verse number="18" style="v"/>tataḥ paraṁ varṣatraye vyatīte'haṁ pitaraṁ sambhāṣituṁ yirūśālamaṁ gatvā pañcadaśadināni tena sārddham atiṣṭhaṁ|</para>
  <para style="p">
    <verse number="19" style="v"/>kintu taṁ prabho rbhrātaraṁ yākūbañca vinā preritānāṁ nānyaṁ kamapyapaśyaṁ|</para>
  <para style="p">
    <verse number="20" style="v"/>yānyetāni vākyāni mayā likhyante tānyanṛtāni na santi tad īśvaro jānāti|</para>
  <para style="p">
    <verse number="21" style="v"/>tataḥ param ahaṁ suriyāṁ kilikiyāñca deśau gatavān|</para>
  <para style="p">
    <verse number="22" style="v"/>tadānīṁ yihūdādeśasthānāṁ khrīṣṭasya samitīnāṁ lokāḥ sākṣāt mama paricayamaprāpya kevalaṁ janaśrutimimāṁ labdhavantaḥ,</para>
  <para style="p">
    <verse number="23" style="v"/>yo janaḥ pūrvvam asmān pratyupadravamakarot sa tadā yaṁ dharmmamanāśayat tamevedānīṁ pracārayatīti|</para>
  <para style="p">
    <verse number="24" style="v"/>tasmāt te māmadhīśvaraṁ dhanyamavadan|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ caturdaśasu vatsareṣu gateṣvahaṁ barṇabbā saha yirūśālamanagaraṁ punaragacchaṁ, tadānoṁ tītamapi svasaṅginam akaravaṁ|</para>
  <para style="p">
    <verse number="2" style="v"/>tatkāle'ham īśvaradarśanād yātrām akaravaṁ mayā yaḥ pariśramo'kāri kāriṣyate vā sa yanniṣphalo na bhavet tadarthaṁ bhinnajātīyānāṁ madhye mayā ghoṣyamāṇaḥ susaṁvādastatratyebhyo lokebhyo viśeṣato mānyebhyo narebhyo mayā nyavedyata|</para>
  <para style="p">
    <verse number="3" style="v"/>tato mama sahacarastīto yadyapi yūnānīya āsīt tathāpi tasya tvakchedo'pyāvaśyako na babhūva|</para>
  <para style="p">
    <verse number="4" style="v"/>yataśchalenāgatā asmān dāsān karttum icchavaḥ katipayā bhāktabhrātaraḥ khrīṣṭena yīśunāsmabhyaṁ dattaṁ svātantryam anusandhātuṁ cārā iva samājaṁ prāviśan|</para>
  <para style="p">
    <verse number="5" style="v"/>ataḥ prakṛte susaṁvāde yuṣmākam adhikāro yat tiṣṭhet tadarthaṁ vayaṁ daṇḍaikamapi yāvad ājñāgrahaṇena teṣāṁ vaśyā nābhavāma|</para>
  <para style="p">
    <verse number="6" style="v"/>parantu ye lokā mānyāste ye kecid bhaveyustānahaṁ na gaṇayāmi yata īśvaraḥ kasyāpi mānavasya pakṣapātaṁ na karoti, ye ca mānyāste māṁ kimapi navīnaṁ nājñāpayan|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu chinnatvacāṁ madhye susaṁvādapracāraṇasya bhāraḥ pitari yathā samarpitastathaivācchinnatvacāṁ madhye susaṁvādapracāraṇasya bhāro mayi samarpita iti tai rbubudhe|</para>
  <para style="p">
    <verse number="8" style="v"/>yataśchinnatvacāṁ madhye preritatvakarmmaṇe yasya yā śaktiḥ pitaramāśritavatī tasyaiva sā śakti rbhinnajātīyānāṁ madhye tasmai karmmaṇe māmapyāśritavatī|</para>
  <para style="p">
    <verse number="9" style="v"/>ato mahyaṁ dattam anugrahaṁ pratijñāya stambhā iva gaṇitā ye yākūb kaiphā yohan caite sahāyatāsūcakaṁ dakṣiṇahastagrahaṁṇa vidhāya māṁ barṇabbāñca jagaduḥ, yuvāṁ bhinnajātīyānāṁ sannidhiṁ gacchataṁ vayaṁ chinnatvacā sannidhiṁ gacchāmaḥ,</para>
  <para style="p">
    <verse number="10" style="v"/>kevalaṁ daridrā yuvābhyāṁ smaraṇīyā iti| atastadeva karttum ahaṁ yate sma|</para>
  <para style="p">
    <verse number="11" style="v"/>aparam āntiyakhiyānagaraṁ pitara āgate'haṁ tasya doṣitvāt samakṣaṁ tam abhartsayaṁ|</para>
  <para style="p">
    <verse number="12" style="v"/>yataḥ sa pūrvvam anyajātīyaiḥ sārddham āhāramakarot tataḥ paraṁ yākūbaḥ samīpāt katipayajaneṣvāgateṣu sa chinnatvaṅmanuṣyebhyo bhayena nivṛtya pṛthag abhavat|</para>
  <para style="p">
    <verse number="13" style="v"/>tato'pare sarvve yihūdino'pi tena sārddhaṁ kapaṭācāram akurvvan barṇabbā api teṣāṁ kāpaṭyena vipathagāmyabhavat|</para>
  <para style="p">
    <verse number="14" style="v"/>tataste prakṛtasusaṁvādarūpe saralapathe na carantīti dṛṣṭvāhaṁ sarvveṣāṁ sākṣāt pitaram uktavān tvaṁ yihūdī san yadi yihūdimataṁ vihāya bhinnajātīya ivācarasi tarhi yihūdimatācaraṇāya bhinnajātīyān kutaḥ pravarttayasi?</para>
  <para style="p">
    <verse number="15" style="v"/>āvāṁ janmanā yihūdinau bhavāvo bhinnajātīyau pāpinau na bhavāvaḥ</para>
  <para style="p">
    <verse number="16" style="v"/>kintu vyavasthāpālanena manuṣyaḥ sapuṇyo na bhavati kevalaṁ yīśau khrīṣṭe yo viśvāsastenaiva sapuṇyo bhavatīti buddhvāvāmapi vyavasthāpālanaṁ vinā kevalaṁ khrīṣṭe viśvāsena puṇyaprāptaye khrīṣṭe yīśau vyaśvasiva yato vyavasthāpālanena ko'pi mānavaḥ puṇyaṁ prāptuṁ na śaknoti|</para>
  <para style="p">
    <verse number="17" style="v"/>parantu yīśunā puṇyaprāptaye yatamānāvapyāvāṁ yadi pāpinau bhavāvastarhi kiṁ vaktavyaṁ? khrīṣṭaḥ pāpasya paricāraka iti? tanna bhavatu|</para>
  <para style="p">
    <verse number="18" style="v"/>mayā yad bhagnaṁ tad yadi mayā punarnirmmīyate tarhi mayaivātmadoṣaḥ prakāśyate|</para>
  <para style="p">
    <verse number="19" style="v"/>ahaṁ yad īśvarāya jīvāmi tadarthaṁ vyavasthayā vyavasthāyai amriye|</para>
  <para style="p">
    <verse number="20" style="v"/>khrīṣṭena sārddhaṁ kruśe hato'smi tathāpi jīvāmi kintvahaṁ jīvāmīti nahi khrīṣṭa eva madanta rjīvati| sāmprataṁ saśarīreṇa mayā yajjīvitaṁ dhāryyate tat mama dayākāriṇi madarthaṁ svīyaprāṇatyāgini ceśvaraputre viśvasatā mayā dhāryyate|</para>
  <para style="p">
    <verse number="21" style="v"/>ahamīśvarasyānugrahaṁ nāvajānāmi yasmād vyavasthayā yadi puṇyaṁ bhavati tarhi khrīṣṭo nirarthakamamriyata|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he nirbbodhā gālātilokāḥ, yuṣmākaṁ madhye kruśe hata iva yīśuḥ khrīṣṭo yuṣmākaṁ samakṣaṁ prakāśita āsīt ato yūyaṁ yathā satyaṁ vākyaṁ na gṛhlītha tathā kenāmuhyata?</para>
  <para style="p">
    <verse number="2" style="v"/>ahaṁ yuṣmattaḥ kathāmekāṁ jijñāse yūyam ātmānaṁ kenālabhadhvaṁ? vyavasthāpālanena kiṁ vā viśvāsavākyasya śravaṇena?</para>
  <para style="p">
    <verse number="3" style="v"/>yūyaṁ kim īdṛg abodhā yad ātmanā karmmārabhya śarīreṇa tat sādhayituṁ yatadhve?</para>
  <para style="p">
    <verse number="4" style="v"/>tarhi yuṣmākaṁ gurutaro duḥkhabhogaḥ kiṁ niṣphalo bhaviṣyati? kuphalayukto vā kiṁ bhaviṣyati?</para>
  <para style="p">
    <verse number="5" style="v"/>yo yuṣmabhyam ātmānaṁ dattavān yuṣmanmadhya āścaryyāṇi karmmāṇi ca sādhitavān sa kiṁ vyavasthāpālanena viśvāsavākyasya śravaṇena vā tat kṛtavān?</para>
  <para style="p">
    <verse number="6" style="v"/>likhitamāste, ibrāhīma īśvare vyaśvasīt sa ca viśvāsastasmai puṇyārthaṁ gaṇito babhūva,</para>
  <para style="p">
    <verse number="7" style="v"/>ato ye viśvāsāśritāsta evebrāhīmaḥ santānā iti yuṣmābhi rjñāyatāṁ|</para>
  <para style="p">
    <verse number="8" style="v"/>īśvaro bhinnajātīyān viśvāsena sapuṇyīkariṣyatīti pūrvvaṁ jñātvā śāstradātā pūrvvam ibrāhīmaṁ susaṁvādaṁ śrāvayana jagāda, tvatto bhinnajātīyāḥ sarvva āśiṣaṁ prāpsyantīti|</para>
  <para style="p">
    <verse number="9" style="v"/>ato ye viśvāsāśritāste viśvāsinebrāhīmā sārddham āśiṣaṁ labhante|</para>
  <para style="p">
    <verse number="10" style="v"/>yāvanto lokā vyavasthāyāḥ karmmaṇyāśrayanti te sarvve śāpādhīnā bhavanti yato likhitamāste, yathā, "yaḥ kaścid etasya vyavasthāgranthasya sarvvavākyāni niścidraṁ na pālayati sa śapta iti|"</para>
  <para style="p">
    <verse number="11" style="v"/>īśvarasya sākṣāt ko'pi vyavasthayā sapuṇyo na bhavati tada vyaktaṁ yataḥ "puṇyavān mānavo viśvāsena jīviṣyatīti" śāstrīyaṁ vacaḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>vyavasthā tu viśvāsasambandhinī na bhavati kintvetāni yaḥ pālayiṣyati sa eva tai rjīviṣyatītiniyamasambandhinī|</para>
  <para style="p">
    <verse number="13" style="v"/>khrīṣṭo'smān parikrīya vyavasthāyāḥ śāpāt mocitavān yato'smākaṁ vinimayena sa svayaṁ śāpāspadamabhavat tadadhi likhitamāste, yathā, "yaḥ kaścit tarāvullambyate so'bhiśapta iti|"</para>
  <para style="p">
    <verse number="14" style="v"/>tasmād khrīṣṭena yīśunevrāhīma āśī rbhinnajātīyalokeṣu varttate tena vayaṁ pratijñātam ātmānaṁ viśvāsena labdhuṁ śaknumaḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>he bhrātṛgaṇa mānuṣāṇāṁ rītyanusāreṇāhaṁ kathayāmi kenacit mānavena yo niyamo niracāyi tasya vikṛti rvṛddhi rvā kenāpi na kriyate|</para>
  <para style="p">
    <verse number="16" style="v"/>parantvibrāhīme tasya santānāya ca pratijñāḥ prati śuśruvire tatra santānaśabdaṁ bahuvacanāntam abhūtvā tava santānāyetyekavacanāntaṁ babhūva sa ca santānaḥ khrīṣṭa eva|</para>
  <para style="p">
    <verse number="17" style="v"/>ataevāhaṁ vadāmi, īśvareṇa yo niyamaḥ purā khrīṣṭamadhi niracāyi tataḥ paraṁ triṁśadadhikacatuḥśatavatsareṣu gateṣu sthāpitā vyavasthā taṁ niyamaṁ nirarthakīkṛtya tadīyapratijñā loptuṁ na śaknoti|</para>
  <para style="p">
    <verse number="18" style="v"/>yasmāt sampadadhikāro yadi vyavasthayā bhavati tarhi pratijñayā na bhavati kintvīśvaraḥ pratijñayā tadadhikāritvam ibrāhīme 'dadāt|</para>
  <para style="p">
    <verse number="19" style="v"/>tarhi vyavasthā kimbhūtā? pratijñā yasmai pratiśrutā tasya santānasyāgamanaṁ yāvad vyabhicāranivāraṇārthaṁ vyavasthāpi dattā, sā ca dūtairājñāpitā madhyasthasya kare samarpitā ca|</para>
  <para style="p">
    <verse number="20" style="v"/>naikasya madhyastho vidyate kintvīśvara eka eva|</para>
  <para style="p">
    <verse number="21" style="v"/>tarhi vyavasthā kim īśvarasya pratijñānāṁ viruddhā? tanna bhavatu| yasmād yadi sā vyavasthā jīvanadānesamarthābhaviṣyat tarhi vyavasthayaiva puṇyalābho'bhaviṣyat|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu yīśukhrīṣṭe yo viśvāsastatsambandhiyāḥ pratijñāyāḥ phalaṁ yad viśvāsilokebhyo dīyate tadarthaṁ śāstradātā sarvvān pāpādhīnān gaṇayati|</para>
  <para style="p">
    <verse number="23" style="v"/>ataeva viśvāsasyānāgatasamaye vayaṁ vyavasthādhīnāḥ santo viśvāsasyodayaṁ yāvad ruddhā ivārakṣyāmahe|</para>
  <para style="p">
    <verse number="24" style="v"/>itthaṁ vayaṁ yad viśvāsena sapuṇyībhavāmastadarthaṁ khrīṣṭasya samīpam asmān netuṁ vyavasthāgratho'smākaṁ vinetā babhūva|</para>
  <para style="p">
    <verse number="25" style="v"/>kintvadhunāgate viśvāse vayaṁ tasya vineturanadhīnā abhavāma|</para>
  <para style="p">
    <verse number="26" style="v"/>khrīṣṭe yīśau viśvasanāt sarvve yūyam īśvarasya santānā jātāḥ|</para>
  <para style="p">
    <verse number="27" style="v"/>yūyaṁ yāvanto lokāḥ khrīṣṭe majjitā abhavata sarvve khrīṣṭaṁ parihitavantaḥ|</para>
  <para style="p">
    <verse number="28" style="v"/>ato yuṣmanmadhye yihūdiyūnānino rdāsasvatantrayo ryoṣāpuruṣayośca ko'pi viśeṣo nāsti; sarvve yūyaṁ khrīṣṭe yīśāveka eva|</para>
  <para style="p">
    <verse number="29" style="v"/>kiñca yūyaṁ yadi khrīṣṭasya bhavatha tarhi sutarām ibrāhīmaḥ santānāḥ pratijñayā sampadadhikāriṇaścādhve|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ahaṁ vadāmi sampadadhikārī yāvad bālastiṣṭhati tāvat sarvvasvasyādhipatiḥ sannapi sa dāsāt kenāpi viṣayeṇa na viśiṣyate</para>
  <para style="p">
    <verse number="2" style="v"/>kintu pitrā nirūpitaṁ samayaṁ yāvat pālakānāṁ dhanādhyakṣāṇāñca nighnastiṣṭhati|</para>
  <para style="p">
    <verse number="3" style="v"/>tadvad vayamapi bālyakāle dāsā iva saṁsārasyākṣaramālāyā adhīnā āsmahe|</para>
  <para style="p">
    <verse number="4" style="v"/>anantaraṁ samaye sampūrṇatāṁ gatavati vyavasthādhīnānāṁ mocanārtham</para>
  <para style="p">
    <verse number="5" style="v"/>asmākaṁ putratvaprāptyarthañceśvaraḥ striyā jātaṁ vyavasthāyā adhinībhūtañca svaputraṁ preṣitavān|</para>
  <para style="p">
    <verse number="6" style="v"/>yūyaṁ santānā abhavata tatkāraṇād īśvaraḥ svaputrasyātmānāṁ yuṣmākam antaḥkaraṇāni prahitavān sa cātmā pitaḥ pitarityāhvānaṁ kārayati|</para>
  <para style="p">
    <verse number="7" style="v"/>ata idānīṁ yūyaṁ na dāsāḥ kintuḥ santānā eva tasmāt santānatvācca khrīṣṭeneśvarīyasampadadhikāriṇo'pyādhve|</para>
  <para style="p">
    <verse number="8" style="v"/>aparañca pūrvvaṁ yūyam īśvaraṁ na jñātvā ye svabhāvato'nīśvarāsteṣāṁ dāsatve'tiṣṭhata|</para>
  <para style="p">
    <verse number="9" style="v"/>idānīm īśvaraṁ jñātvā yadi veśvareṇa jñātā yūyaṁ kathaṁ punastāni viphalāni tucchāni cākṣarāṇi prati parāvarttituṁ śaknutha? yūyaṁ kiṁ punasteṣāṁ dāsā bhavitumicchatha?</para>
  <para style="p">
    <verse number="10" style="v"/>yūyaṁ divasān māsān tithīn saṁvatsarāṁśca sammanyadhve|</para>
  <para style="p">
    <verse number="11" style="v"/>yuṣmadarthaṁ mayā yaḥ pariśramo'kāri sa viphalo jāta iti yuṣmānadhyahaṁ bibhemi|</para>
  <para style="p">
    <verse number="12" style="v"/>he bhrātaraḥ, ahaṁ yādṛśo'smi yūyamapi tādṛśā bhavateti prārthaye yato'hamapi yuṣmattulyo'bhavaṁ yuṣmābhi rmama kimapi nāparāddhaṁ|</para>
  <para style="p">
    <verse number="13" style="v"/>pūrvvamahaṁ kalevarasya daurbbalyena yuṣmān susaṁvādam ajñāpayamiti yūyaṁ jānītha|</para>
  <para style="p">
    <verse number="14" style="v"/>tadānīṁ mama parīkṣakaṁ śārīrakleśaṁ dṛṣṭvā yūyaṁ mām avajñāya ṛtīyitavantastannahi kintvīśvarasya dūtamiva sākṣāt khrīṣṭa yīśumiva vā māṁ gṛhītavantaḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>atastadānīṁ yuṣmākaṁ yā dhanyatābhavat sā kka gatā? tadānīṁ yūyaṁ yadi sveṣāṁ nayanānyutpāṭya mahyaṁ dātum aśakṣyata tarhi tadapyakariṣyateti pramāṇam ahaṁ dadāmi|</para>
  <para style="p">
    <verse number="16" style="v"/>sāmpratamahaṁ satyavāditvāt kiṁ yuṣmākaṁ ripu rjāto'smi?</para>
  <para style="p">
    <verse number="17" style="v"/>te yuṣmatkṛte sparddhante kintu sā sparddhā kutsitā yato yūyaṁ tānadhi yat sparddhadhvaṁ tadarthaṁ te yuṣmān pṛthak karttum icchanti|</para>
  <para style="p">
    <verse number="18" style="v"/>kevalaṁ yuṣmatsamīpe mamopasthitisamaye tannahi, kintu sarvvadaiva bhadramadhi sparddhanaṁ bhadraṁ|</para>
  <para style="p">
    <verse number="19" style="v"/>he mama bālakāḥ, yuṣmadanta ryāvat khrīṣṭo mūrtimān na bhavati tāvad yuṣmatkāraṇāt punaḥ prasavavedaneva mama vedanā jāyate|</para>
  <para style="p">
    <verse number="20" style="v"/>ahamidānīṁ yuṣmākaṁ sannidhiṁ gatvā svarāntareṇa yuṣmān sambhāṣituṁ kāmaye yato yuṣmānadhi vyākulo'smi|</para>
  <para style="p">
    <verse number="21" style="v"/>he vyavasthādhīnatākāṅkṣiṇaḥ yūyaṁ kiṁ vyavasthāyā vacanaṁ na gṛhlītha?</para>
  <para style="p">
    <verse number="22" style="v"/>tanmāṁ vadata| likhitamāste, ibrāhīmo dvau putrāvāsāte tayoreko dāsyāṁ dvitīyaśca patnyāṁ jātaḥ|</para>
  <para style="p">
    <verse number="23" style="v"/>tayo ryo dāsyāṁ jātaḥ sa śārīrikaniyamena jajñe yaśca patnyāṁ jātaḥ sa pratijñayā jajñe|</para>
  <para style="p">
    <verse number="24" style="v"/>idamākhyānaṁ dṛṣṭantasvarūpaṁ| te dve yoṣitāvīśvarīyasandhī tayorekā sīnayaparvvatād utpannā dāsajanayitrī ca sā tu hājirā|</para>
  <para style="p">
    <verse number="25" style="v"/>yasmād hājirāśabdenāravadeśasthasīnayaparvvato bodhyate, sā ca varttamānāyā yirūśālampuryyāḥ sadṛśī| yataḥ svabālaiḥ sahitā sā dāsatva āste|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu svargīyā yirūśālampurī patnī sarvveṣām asmākaṁ mātā cāste|</para>
  <para style="p">
    <verse number="27" style="v"/>yādṛśaṁ likhitam āste, "vandhye santānahīne tvaṁ svaraṁ jayajayaṁ kuru| aprasūte tvayollāso jayāśabdaśca gīyatāṁ| yata eva sanāthāyā yoṣitaḥ santate rgaṇāt| anāthā yā bhavennārī tadapatyāni bhūriśaḥ||"</para>
  <para style="p">
    <verse number="28" style="v"/>he bhrātṛgaṇa, imhāk iva vayaṁ pratijñayā jātāḥ santānāḥ|</para>
  <para style="p">
    <verse number="29" style="v"/>kintu tadānīṁ śārīrikaniyamena jātaḥ putro yadvad ātmikaniyamena jātaṁ putram upādravat tathādhunāpi|</para>
  <para style="p">
    <verse number="30" style="v"/>kintu śāstre kiṁ likhitaṁ? "tvam imāṁ dāsīṁ tasyāḥ putrañcāpasāraya yata eṣa dāsīputraḥ patnīputreṇa samaṁ nottarādhikārī bhaviyyatīti|"</para>
  <para style="p">
    <verse number="31" style="v"/>ataeva he bhrātaraḥ, vayaṁ dāsyāḥ santānā na bhūtvā pātnyāḥ santānā bhavāmaḥ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>khrīṣṭo'smabhyaṁ yat svātantryaṁ dattavān yūyaṁ tatra sthirāstiṣṭhata dāsatvayugena puna rna nibadhyadhvaṁ|</para>
  <para style="p">
    <verse number="2" style="v"/>paśyatāhaṁ paulo yuṣmān vadāmi yadi chinnatvaco bhavatha tarhi khrīṣṭena kimapi nopakāriṣyadhve|</para>
  <para style="p">
    <verse number="3" style="v"/>aparaṁ yaḥ kaścit chinnatvag bhavati sa kṛtsnavyavasthāyāḥ pālanam īśvarāya dhārayatīti pramāṇaṁ dadāmi|</para>
  <para style="p">
    <verse number="4" style="v"/>yuṣmākaṁ yāvanto lokā vyavasthayā sapuṇyībhavituṁ ceṣṭante te sarvve khrīṣṭād bhraṣṭā anugrahāt patitāśca|</para>
  <para style="p">
    <verse number="5" style="v"/>yato vayam ātmanā viśvāsāt puṇyalābhāśāsiddhaṁ pratīkṣāmahe|</para>
  <para style="p">
    <verse number="6" style="v"/>khrīṣṭe yīśau tvakchedātvakchedayoḥ kimapi guṇaṁ nāsti kintu premnā saphalo viśvāsa eva guṇayuktaḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>pūrvvaṁ yūyaṁ sundaram adhāvata kintvidānīṁ kena bādhāṁ prāpya satyatāṁ na gṛhlītha?</para>
  <para style="p">
    <verse number="8" style="v"/>yuṣmākaṁ sā mati ryuṣmadāhvānakāriṇa īśvarānna jātā|</para>
  <para style="p">
    <verse number="9" style="v"/>vikāraḥ kṛtsnaśaktūnāṁ svalpakiṇvena jasayate|</para>
  <para style="p">
    <verse number="10" style="v"/>yuṣmākaṁ mati rvikāraṁ na gamiṣyatītyahaṁ yuṣmānadhi prabhunāśaṁse; kintu yo yuṣmān vicāralayati sa yaḥ kaścid bhavet samucitaṁ daṇḍaṁ prāpsyati|</para>
  <para style="p">
    <verse number="11" style="v"/>parantu he bhrātaraḥ, yadyaham idānīm api tvakchedaṁ pracārayeyaṁ tarhi kuta upadravaṁ bhuñjiya? tatkṛte kruśaṁ nirbbādham abhaviṣyat|</para>
  <para style="p">
    <verse number="12" style="v"/>ye janā yuṣmākaṁ cāñcalyaṁ janayanti teṣāṁ chedanameva mayābhilaṣyate|</para>
  <para style="p">
    <verse number="13" style="v"/>he bhrātaraḥ, yūyaṁ svātantryārtham āhūtā ādhve kintu tatsvātantryadvāreṇa śārīrikabhāvo yuṣmān na praviśatu| yūyaṁ premnā parasparaṁ paricaryyāṁ kurudhvaṁ|</para>
  <para style="p">
    <verse number="14" style="v"/>yasmāt tvaṁ samīpavāsini svavat prema kuryyā ityekājñā kṛtsnāyā vyavasthāyāḥ sārasaṁgrahaḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>kintu yūyaṁ yadi parasparaṁ daṁdaśyadhve 'śāśyadhve ca tarhi yuṣmākam eko'nyena yanna grasyate tatra yuṣmābhiḥ sāvadhānai rbhavitavyaṁ|</para>
  <para style="p">
    <verse number="16" style="v"/>ahaṁ bravīmi yūyam ātmikācāraṁ kuruta śārīrikābhilāṣaṁ mā pūrayata|</para>
  <para style="p">
    <verse number="17" style="v"/>yataḥ śārīrikābhilāṣa ātmano viparītaḥ, ātmikābhilāṣaśca śarīrasya viparītaḥ, anayorubhayoḥ parasparaṁ virodho vidyate tena yuṣmābhi ryad abhilaṣyate tanna karttavyaṁ|</para>
  <para style="p">
    <verse number="18" style="v"/>yūyaṁ yadyātmanā vinīyadhve tarhi vyavasthāyā adhīnā na bhavatha|</para>
  <para style="p">
    <verse number="19" style="v"/>aparaṁ paradāragamanaṁ veśyāgamanam aśucitā kāmukatā pratimāpūjanam</para>
  <para style="p">
    <verse number="20" style="v"/>indrajālaṁ śatrutvaṁ vivādo'ntarjvalanaṁ krodhaḥ kalaho'naikyaṁ</para>
  <para style="p">
    <verse number="21" style="v"/>pārthakyam īrṣyā vadho mattatvaṁ lampaṭatvamityādīni spaṣṭatvena śārīrikabhāvasya karmmāṇi santi| pūrvvaṁ yadvat mayā kathitaṁ tadvat punarapi kathyate ye janā etādṛśāni karmmāṇyācaranti tairīśvarasya rājye'dhikāraḥ kadāca na lapsyate|</para>
  <para style="p">
    <verse number="22" style="v"/>kiñca premānandaḥ śāntiścirasahiṣṇutā hitaiṣitā bhadratvaṁ viśvāsyatā titikṣā</para>
  <para style="p">
    <verse number="23" style="v"/>parimitabhojitvamityādīnyātmanaḥ phalāni santi teṣāṁ viruddhā kāpi vyavasthā nahi|</para>
  <para style="p">
    <verse number="24" style="v"/>ye tu khrīṣṭasya lokāste ripubhirabhilāṣaiśca sahitaṁ śārīrikabhāvaṁ kruśe nihatavantaḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>yadi vayam ātmanā jīvāmastarhyātmikācāro'smābhiḥ karttavyaḥ,</para>
  <para style="p">
    <verse number="26" style="v"/>darpaḥ parasparaṁ nirbhartsanaṁ dveṣaścāsmābhi rna karttavyāni|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he bhrātaraḥ, yuṣmākaṁ kaścid yadi kasmiṁścit pāpe patati tarhyātmikabhāvayuktai ryuṣmābhistitikṣābhāvaṁ vidhāya sa punarutthāpyatāṁ yūyamapi yathā tādṛkparīkṣāyāṁ na patatha tathā sāvadhānā bhavata|</para>
  <para style="p">
    <verse number="2" style="v"/>yuṣmākam ekaiko janaḥ parasya bhāraṁ vahatvanena prakāreṇa khrīṣṭasya vidhiṁ pālayata|</para>
  <para style="p">
    <verse number="3" style="v"/>yadi kaścana kṣudraḥ san svaṁ mahāntaṁ manyate tarhi tasyātmavañcanā jāyate|</para>
  <para style="p">
    <verse number="4" style="v"/>ata ekaikena janena svakīyakarmmaṇaḥ parīkṣā kriyatāṁ tena paraṁ nālokya kevalam ātmālokanāt tasya ślaghā sambhaviṣyati|</para>
  <para style="p">
    <verse number="5" style="v"/>yata ekaikoे janaḥ svakīyaṁ bhāraṁ vakṣyati|</para>
  <para style="p">
    <verse number="6" style="v"/>yo jano dharmmopadeśaṁ labhate sa upadeṣṭāraṁ svīyasarvvasampatte rbhāginaṁ karotu|</para>
  <para style="p">
    <verse number="7" style="v"/>yuṣmākaṁ bhrānti rna bhavatu, īśvaro nopahasitavyaḥ, yena yad bījam upyate tena tajjātaṁ śasyaṁ karttiṣyate|</para>
  <para style="p">
    <verse number="8" style="v"/>svaśarīrārthaṁ yena bījam upyate tena śarīrād vināśarūpaṁ śasyaṁ lapsyate kintvātmanaḥ kṛte yena bījam upyate tenātmato'nantajīvitarūpaṁ śasyaṁ lapsyate|</para>
  <para style="p">
    <verse number="9" style="v"/>satkarmmakaraṇe'smābhiraśrāntai rbhavitavyaṁ yato'klāntaustiṣṭhadbhirasmābhirupayuktasamaye tat phalāni lapsyante|</para>
  <para style="p">
    <verse number="10" style="v"/>ato yāvat samayastiṣṭhati tāvat sarvvān prati viśeṣato viśvāsaveśmavāsinaḥ pratyasmābhi rhitācāraḥ karttavyaḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>he bhrātaraḥ, ahaṁ svahastena yuṣmān prati kiyadvṛhat patraṁ likhitavān tad yuṣmābhi rdṛśyatāṁ|</para>
  <para style="p">
    <verse number="12" style="v"/>ye śārīrikaviṣaye sudṛśyā bhavitumicchanti te yat khrīṣṭasya kruśasya kāraṇādupadravasya bhāgino na bhavanti kevalaṁ tadarthaṁ tvakchede yuṣmān pravarttayanti|</para>
  <para style="p">
    <verse number="13" style="v"/>te tvakchedagrāhiṇo'pi vyavasthāṁ na pālayanti kintu yuṣmaccharīrāt ślāghālābhārthaṁ yuṣmākaṁ tvakchedam icchanti|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu yenāhaṁ saṁsārāya hataḥ saṁsāro'pi mahyaṁ hatastadasmatprabho ryīśukhrīṣṭasya kruśaṁ vinānyatra kutrāpi mama ślāghanaṁ kadāpi na bhavatu|</para>
  <para style="p">
    <verse number="15" style="v"/>khrīṣṭe yīśau tvakchedātvakchedayoḥ kimapi guṇaṁ nāsti kintu navīnā sṛṣṭireva guṇayuktā|</para>
  <para style="p">
    <verse number="16" style="v"/>aparaṁ yāvanto lokā etasmin mārge caranti teṣām īśvarīyasya kṛtsnasyesrāyelaśca śānti rdayālābhaśca bhūyāt|</para>
  <para style="p">
    <verse number="17" style="v"/>itaḥ paraṁ ko'pi māṁ na kliśnātu yasmād ahaṁ svagātre prabho ryīśukhrīṣṭasya cihnāni dhāraye|</para>
  <para style="p">
    <verse number="18" style="v"/>he bhrātaraḥ asmākaṁ prabho ryīśukhrīṣṭasya prasādo yuṣmākam ātmani stheyāt| tathāstu|</para>
</usx>
