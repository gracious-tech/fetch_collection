<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="LUK" style="id">Sanskrit Bible (NT) in IAST Script (satyavedaḥ ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Luke</para>
  <para style="toc1">lūkalikhitaḥ susaṁvādaḥ</para>
  <para style="toc2">lūkaḥ</para>
  <para style="toc3">lūkaḥ</para>
  <para style="mt1">lūkalikhitaḥ susaṁvādaḥ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>prathamato ye sākṣiṇo vākyapracārakāścāsan te'smākaṁ madhye yadyat sapramāṇaṁ vākyamarpayanti sma</para>
  <para style="p">
    <verse number="2" style="v"/>tadanusārato'nyepi bahavastadvṛttāntaṁ racayituṁ pravṛttāḥ|</para>
  <para style="p">
    <verse number="3" style="v"/>ataeva he mahāmahimathiyaphil tvaṁ yā yāḥ kathā aśikṣyathāstāsāṁ dṛḍhapramāṇāni yathā prāpnoṣi</para>
  <para style="p">
    <verse number="4" style="v"/>tadarthaṁ prathamamārabhya tāni sarvvāṇi jñātvāhamapi anukramāt sarvvavṛttāntān tubhyaṁ lekhituṁ matimakārṣam|</para>
  <para style="p">
    <verse number="5" style="v"/>yihūdādeśīyaherodnāmake rājatvaṁ kurvvati abīyayājakasya paryyāyādhikārī sikhariyanāmaka eko yājako hāroṇavaṁśodbhavā ilīśevākhyā</para>
  <para style="p">
    <verse number="6" style="v"/>tasya jāyā dvāvimau nirdoṣau prabhoḥ sarvvājñā vyavasthāśca saṁmanya īśvaradṛṣṭau dhārmmikāvāstām|</para>
  <para style="p">
    <verse number="7" style="v"/>tayoḥ santāna ekopi nāsīt, yata ilīśevā bandhyā tau dvāveva vṛddhāvabhavatām|</para>
  <para style="p">
    <verse number="8" style="v"/>yadā svaparyyānukrameṇa sikhariya īśvāsya samakṣaṁ yājakīyaṁ karmma karoti</para>
  <para style="p">
    <verse number="9" style="v"/>tadā yajñasya dinaparipāyyā parameśvarasya mandire praveśakāle dhūpajvālanaṁ karmma tasya karaṇīyamāsīt|</para>
  <para style="p">
    <verse number="10" style="v"/>taddhūpajvālanakāle lokanivahe prārthanāṁ kartuṁ bahistiṣṭhati</para>
  <para style="p">
    <verse number="11" style="v"/>sati sikhariyo yasyāṁ vedyāṁ dhūpaṁ jvālayati taddakṣiṇapārśve parameśvarasya dūta eka upasthito darśanaṁ dadau|</para>
  <para style="p">
    <verse number="12" style="v"/>taṁ dṛṣṭvā sikhariya udvivije śaśaṅke ca|</para>
  <para style="p">
    <verse number="13" style="v"/>tadā sa dūtastaṁ babhāṣe he sikhariya mā bhaistava prārthanā grāhyā jātā tava bhāryyā ilīśevā putraṁ prasoṣyate tasya nāma yoेhan iti kariṣyasi|</para>
  <para style="p">
    <verse number="14" style="v"/>kiñca tvaṁ sānandaḥ saharṣaśca bhaviṣyasi tasya janmani bahava ānandiṣyanti ca|</para>
  <para style="p">
    <verse number="15" style="v"/>yato hetoḥ sa parameśvarasya gocare mahān bhaviṣyati tathā drākṣārasaṁ surāṁ vā kimapi na pāsyati, aparaṁ janmārabhya pavitreṇātmanā paripūrṇaḥ</para>
  <para style="p">
    <verse number="16" style="v"/>san isrāyelvaṁśīyān anekān prabhoḥ parameśvarasya mārgamāneṣyati|</para>
  <para style="p">
    <verse number="17" style="v"/>santānān prati pitṛṇāṁ manāṁsi dharmmajñānaṁ pratyanājñāgrāhiṇaśca parāvarttayituṁ, prabhoḥ parameśvarasya sevārtham ekāṁ sajjitajātiṁ vidhātuñca sa eliyarūpātmaśaktiprāptastasyāgre gamiṣyati|</para>
  <para style="p">
    <verse number="18" style="v"/>tadā sikhariyo dūtamavādīt kathametad vetsyāmi? yatohaṁ vṛddho mama bhāryyā ca vṛddhā|</para>
  <para style="p">
    <verse number="19" style="v"/>tato dūtaḥ pratyuvāca paśyeśvarasya sākṣādvarttī jibrāyelnāmā dūtohaṁ tvayā saha kathāṁ gadituṁ tubhyamimāṁ śubhavārttāṁ dātuñca preṣitaḥ|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu madīyaṁ vākyaṁ kāle phaliṣyati tat tvayā na pratītam ataḥ kāraṇād yāvadeva tāni na setsyanti tāvat tvaṁ vaktuṁmaśakto mūko bhava|</para>
  <para style="p">
    <verse number="21" style="v"/>tadānīṁ ye ye lokāḥ sikhariyamapaikṣanta te madhyemandiraṁ tasya bahuvilambād āścaryyaṁ menire|</para>
  <para style="p">
    <verse number="22" style="v"/>sa bahirāgato yadā kimapi vākyaṁ vaktumaśaktaḥ saṅketaṁ kṛtvā niḥśabdastasyau tadā madhyemandiraṁ kasyacid darśanaṁ tena prāptam iti sarvve bubudhire|</para>
  <para style="p">
    <verse number="23" style="v"/>anantaraṁ tasya sevanaparyyāye sampūrṇe sati sa nijagehaṁ jagāma|</para>
  <para style="p">
    <verse number="24" style="v"/>katipayadineṣu gateṣu tasya bhāryyā ilīśevā garbbhavatī babhūva</para>
  <para style="p">
    <verse number="25" style="v"/>paścāt sā pañcamāsān saṁgopyākathayat lokānāṁ samakṣaṁ mamāpamānaṁ khaṇḍayituṁ parameśvaro mayi dṛṣṭiṁ pātayitvā karmmedṛśaṁ kṛtavān|</para>
  <para style="p">
    <verse number="26" style="v"/>aparañca tasyā garbbhasya ṣaṣṭhe māse jāte gālīlpradeśīyanāsaratpure</para>
  <para style="p">
    <verse number="27" style="v"/>dāyūdo vaṁśīyāya yūṣaphnāmne puruṣāya yā mariyamnāmakumārī vāgdattāsīt tasyāḥ samīpaṁ jibrāyel dūta īśvareṇa prahitaḥ|</para>
  <para style="p">
    <verse number="28" style="v"/>sa gatvā jagāda he īśvarānugṛhītakanye tava śubhaṁ bhūyāt prabhuḥ parameśvarastava sahāyosti nārīṇāṁ madhye tvameva dhanyā|</para>
  <para style="p">
    <verse number="29" style="v"/>tadānīṁ sā taṁ dṛṣṭvā tasya vākyata udvijya kīdṛśaṁ bhāṣaṇamidam iti manasā cintayāmāsa|</para>
  <para style="p">
    <verse number="30" style="v"/>tato dūto'vadat he mariyam bhayaṁ mākārṣīḥ, tvayi parameśvarasyānugrahosti|</para>
  <para style="p">
    <verse number="31" style="v"/>paśya tvaṁ garbbhaṁ dhṛtvā putraṁ prasoṣyase tasya nāma yīśuriti kariṣyasi|</para>
  <para style="p">
    <verse number="32" style="v"/>sa mahān bhaviṣyati tathā sarvvebhyaḥ śreṣṭhasya putra iti khyāsyati; aparaṁ prabhuḥ parameśvarastasya piturdāyūdaḥ siṁhāsanaṁ tasmai dāsyati;</para>
  <para style="p">
    <verse number="33" style="v"/>tathā sa yākūbo vaṁśopari sarvvadā rājatvaṁ kariṣyati, tasya rājatvasyānto na bhaviṣyati|</para>
  <para style="p">
    <verse number="34" style="v"/>tadā mariyam taṁ dūtaṁ babhāṣe nāhaṁ puruṣasaṅgaṁ karomi tarhi kathametat sambhaviṣyati?</para>
  <para style="p">
    <verse number="35" style="v"/>tato dūto'kathayat pavitra ātmā tvāmāśrāyiṣyati tathā sarvvaśreṣṭhasya śaktistavopari chāyāṁ kariṣyati tato hetostava garbbhād yaḥ pavitrabālako janiṣyate sa īśvaraputra iti khyātiṁ prāpsyati|</para>
  <para style="p">
    <verse number="36" style="v"/>aparañca paśya tava jñātirilīśevā yāṁ sarvve bandhyāmavadan idānīṁ sā vārddhakye santānamekaṁ garbbhe'dhārayat tasya ṣaṣṭhamāsobhūt|</para>
  <para style="p">
    <verse number="37" style="v"/>kimapi karmma nāsādhyam īśvarasya|</para>
  <para style="p">
    <verse number="38" style="v"/>tadā mariyam jagāda, paśya prabherahaṁ dāsī mahyaṁ tava vākyānusāreṇa sarvvametad ghaṭatām; ananataraṁ dūtastasyāḥ samīpāt pratasthe|</para>
  <para style="p">
    <verse number="39" style="v"/>atha katipayadināt paraṁ mariyam tasmāt parvvatamayapradeśīyayihūdāyā nagaramekaṁ śīghraṁ gatvā</para>
  <para style="p">
    <verse number="40" style="v"/>sikhariyayājakasya gṛhaṁ praviśya tasya jāyām ilīśevāṁ sambodhyāvadat|</para>
  <para style="p">
    <verse number="41" style="v"/>tato mariyamaḥ sambodhanavākye ilīśevāyāḥ karṇayoḥ praviṣṭamātre sati tasyā garbbhasthabālako nanartta| tata ilīśevā pavitreṇātmanā paripūrṇā satī</para>
  <para style="p">
    <verse number="42" style="v"/>proccairgaditumārebhe, yoṣitāṁ madhye tvameva dhanyā, tava garbbhasthaḥ śiśuśca dhanyaḥ|</para>
  <para style="p">
    <verse number="43" style="v"/>tvaṁ prabhormātā, mama niveśane tvayā caraṇāvarpitau, mamādya saubhāgyametat|</para>
  <para style="p">
    <verse number="44" style="v"/>paśya tava vākye mama karṇayoḥ praviṣṭamātre sati mamodarasthaḥ śiśurānandān nanartta|</para>
  <para style="p">
    <verse number="45" style="v"/>yā strī vyaśvasīt sā dhanyā, yato hetostāṁ prati parameśvaroktaṁ vākyaṁ sarvvaṁ siddhaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="46" style="v"/>tadānīṁ mariyam jagāda| dhanyavādaṁ pareśasya karoti māmakaṁ manaḥ|</para>
  <para style="p">
    <verse number="47" style="v"/>mamātmā tārakeśe ca samullāsaṁ pragacchati|</para>
  <para style="p">
    <verse number="48" style="v"/>akarot sa prabhu rduṣṭiṁ svadāsyā durgatiṁ prati| paśyādyārabhya māṁ dhanyāṁ vakṣyanti puruṣāḥ sadā|</para>
  <para style="p">
    <verse number="49" style="v"/>yaḥ sarvvaśaktimān yasya nāmāpi ca pavitrakaṁ| sa eva sumahatkarmma kṛtavān mannimittakaṁ|</para>
  <para style="p">
    <verse number="50" style="v"/>ye bibhyati janāstasmāt teṣāṁ santānapaṁktiṣu| anukampā tadīyā ca sarvvadaiva sutiṣṭhati|</para>
  <para style="p">
    <verse number="51" style="v"/>svabāhubalatastena prākāśyata parākramaḥ| manaḥkumantraṇāsārddhaṁ vikīryyante'bhimāninaḥ|</para>
  <para style="p">
    <verse number="52" style="v"/>siṁhāsanagatāllokān balinaścāvarohya saḥ| padeṣūcceṣu lokāṁstu kṣudrān saṁsthāpayatyapi|</para>
  <para style="p">
    <verse number="53" style="v"/>kṣudhitān mānavān dravyairuttamaiḥ paritarpya saḥ| sakalān dhanino lokān visṛjed riktahastakān|</para>
  <para style="p">
    <verse number="54" style="v"/>ibrāhīmi ca tadvaṁśe yā dayāsti sadaiva tāṁ| smṛtvā purā pitṛṇāṁ no yathā sākṣāt pratiśrutaṁ|</para>
  <para style="p">
    <verse number="55" style="v"/>isrāyelsevakastena tathopakriyate svayaṁ||</para>
  <para style="p">
    <verse number="56" style="v"/>anantaraṁ mariyam prāyeṇa māsatrayam ilīśevayā sahoṣitvā vyāghuyya nijaniveśanaṁ yayau|</para>
  <para style="p">
    <verse number="57" style="v"/>tadanantaram ilīśevāyāḥ prasavakāla upasthite sati sā putraṁ prāsoṣṭa|</para>
  <para style="p">
    <verse number="58" style="v"/>tataḥ parameśvarastasyāṁ mahānugrahaṁ kṛtavān etat śrutvā samīpavāsinaḥ kuṭumbāścāgatya tayā saha mumudire|</para>
  <para style="p">
    <verse number="59" style="v"/>tathāṣṭame dine te bālakasya tvacaṁ chettum etya tasya pitṛnāmānurūpaṁ tannāma sikhariya iti karttumīṣuḥ|</para>
  <para style="p">
    <verse number="60" style="v"/>kintu tasya mātākathayat tanna, nāmāsya yohan iti karttavyam|</para>
  <para style="p">
    <verse number="61" style="v"/>tadā te vyāharan tava vaṁśamadhye nāmedṛśaṁ kasyāpi nāsti|</para>
  <para style="p">
    <verse number="62" style="v"/>tataḥ paraṁ tasya pitaraṁ sikhariyaṁ prati saṅketya papracchuḥ śiśoḥ kiṁ nāma kāriṣyate?</para>
  <para style="p">
    <verse number="63" style="v"/>tataḥ sa phalakamekaṁ yācitvā lilekha tasya nāma yohan bhaviṣyati| tasmāt sarvve āścaryyaṁ menire|</para>
  <para style="p">
    <verse number="64" style="v"/>tatkṣaṇaṁ sikhariyasya jihvājāḍye'pagate sa mukhaṁ vyādāya spaṣṭavarṇamuccāryya īśvarasya guṇānuvādaṁ cakāra|</para>
  <para style="p">
    <verse number="65" style="v"/>tasmāccaturdiksthāḥ samīpavāsilokā bhītā evametāḥ sarvvāḥ kathā yihūdāyāḥ parvvatamayapradeśasya sarvvatra pracāritāḥ|</para>
  <para style="p">
    <verse number="66" style="v"/>tasmāt śrotāro manaḥsu sthāpayitvā kathayāmbabhūvuḥ kīdṛśoyaṁ bālo bhaviṣyati? atha parameśvarastasya sahāyobhūt|</para>
  <para style="p">
    <verse number="67" style="v"/>tadā yohanaḥ pitā sikhariyaḥ pavitreṇātmanā paripūrṇaḥ san etādṛśaṁ bhaviṣyadvākyaṁ kathayāmāsa|</para>
  <para style="p">
    <verse number="68" style="v"/>isrāyelaḥ prabhu ryastu sa dhanyaḥ parameśvaraḥ| anugṛhya nijāllokān sa eva parimocayet|</para>
  <para style="p">
    <verse number="69" style="v"/>vipakṣajanahastebhyo yathā mocyāmahe vayaṁ| yāvajjīvañca dharmmeṇa sāralyena ca nirbhayāḥ|</para>
  <para style="p">
    <verse number="70" style="v"/>sevāmahai tamevaikam etatkāraṇameva ca| svakīyaṁ supavitrañca saṁsmṛtya niyamaṁ sadā|</para>
  <para style="p">
    <verse number="71" style="v"/>kṛpayā puruṣān pūrvvān nikaṣārthāttu naḥ pituḥ| ibrāhīmaḥ samīpe yaṁ śapathaṁ kṛtavān purā|</para>
  <para style="p">
    <verse number="72" style="v"/>tameva saphalaṁ karttaṁ tathā śatrugaṇasya ca| ṛृtīyākāriṇaścaiva karebhyo rakṣaṇāya naḥ|</para>
  <para style="p">
    <verse number="73" style="v"/>sṛṣṭeḥ prathamataḥ svīyaiḥ pavitrai rbhāvivādibhiḥ|</para>
  <para style="p">
    <verse number="74" style="v"/>yathoktavān tathā svasya dāyūdaḥ sevakasya tu|</para>
  <para style="p">
    <verse number="75" style="v"/>vaṁśe trātāramekaṁ sa samutpāditavān svayam|</para>
  <para style="p">
    <verse number="76" style="v"/>ato he bālaka tvantu sarvvebhyaḥ śreṣṭha eva yaḥ| tasyaiva bhāvivādīti pravikhyāto bhaviṣyasi| asmākaṁ caraṇān kṣeme mārge cālayituṁ sadā| evaṁ dhvānte'rthato mṛtyośchāyāyāṁ ye tu mānavāḥ|</para>
  <para style="p">
    <verse number="77" style="v"/>upaviṣṭāstu tāneva prakāśayitumeva hi| kṛtvā mahānukampāṁ hi yāmeva parameśvaraḥ|</para>
  <para style="p">
    <verse number="78" style="v"/>ūrdvvāt sūryyamudāyyaivāsmabhyaṁ prādāttu darśanaṁ| tayānukampayā svasya lokānāṁ pāpamocane|</para>
  <para style="p">
    <verse number="79" style="v"/>paritrāṇasya tebhyo hi jñānaviśrāṇanāya ca| prabho rmārgaṁ pariṣkarttuṁ tasyāgrāyī bhaviṣyasi||</para>
  <para style="p">
    <verse number="80" style="v"/>atha bālakaḥ śarīreṇa buddhyā ca varddhitumārebhe; aparañca sa isrāyelo vaṁśīyalokānāṁ samīpe yāvanna prakaṭībhūtastāstāvat prāntare nyavasat|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparañca tasmin kāle rājyasya sarvveṣāṁ lokānāṁ nāmāni lekhayitum agastakaisara ājñāpayāmāsa|</para>
  <para style="p">
    <verse number="2" style="v"/>tadanusāreṇa kurīṇiyanāmani suriyādeśasya śāsake sati nāmalekhanaṁ prārebhe|</para>
  <para style="p">
    <verse number="3" style="v"/>ato heto rnāma lekhituṁ sarvve janāḥ svīyaṁ svīyaṁ nagaraṁ jagmuḥ|</para>
  <para style="p">
    <verse number="4" style="v"/>tadānīṁ yūṣaph nāma lekhituṁ vāgdattayā svabhāryyayā garbbhavatyā mariyamā saha svayaṁ dāyūdaḥ sajātivaṁśa iti kāraṇād gālīlpradeśasya nāsaratnagarād</para>
  <para style="p">
    <verse number="5" style="v"/>yihūdāpradeśasya baitlehamākhyaṁ dāyūdnagaraṁ jagāma|</para>
  <para style="p">
    <verse number="6" style="v"/>anyacca tatra sthāne tayostiṣṭhatoḥ sato rmariyamaḥ prasūtikāla upasthite</para>
  <para style="p">
    <verse number="7" style="v"/>sā taṁ prathamasutaṁ prāsoṣṭa kintu tasmin vāsagṛhe sthānābhāvād bālakaṁ vastreṇa veṣṭayitvā gośālāyāṁ sthāpayāmāsa|</para>
  <para style="p">
    <verse number="8" style="v"/>anantaraṁ ye kiyanto meṣapālakāḥ svameṣavrajarakṣāyai tatpradeśe sthitvā rajanyāṁ prāntare prahariṇaḥ karmma kurvvanti,</para>
  <para style="p">
    <verse number="9" style="v"/>teṣāṁ samīpaṁ parameśvarasya dūta āgatyopatasthau; tadā catuṣpārśve parameśvarasya tejasaḥ prakāśitatvāt te'tiśaśaṅkire|</para>
  <para style="p">
    <verse number="10" style="v"/>tadā sa dūta uvāca mā bhaiṣṭa paśyatādya dāyūdaḥ pure yuṣmannimittaṁ trātā prabhuḥ khrīṣṭo'janiṣṭa,</para>
  <para style="p">
    <verse number="11" style="v"/>sarvveṣāṁ lokānāṁ mahānandajanakam imaṁ maṅgalavṛttāntaṁ yuṣmān jñāpayāmi|</para>
  <para style="p">
    <verse number="12" style="v"/>yūyaṁ (tatsthānaṁ gatvā) vastraveṣṭitaṁ taṁ bālakaṁ gośālāyāṁ śayanaṁ drakṣyatha yuṣmān pratīdaṁ cihnaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="13" style="v"/>dūta imāṁ kathāṁ kathitavati tatrākasmāt svargīyāḥ pṛtanā āgatya kathām imāṁ kathayitveśvarasya guṇānanvavādiṣuḥ, yathā,</para>
  <para style="p">
    <verse number="14" style="v"/>sarvvordvvasthairīśvarasya mahimā samprakāśyatāṁ| śāntirbhūyāt pṛthivyāstu santoṣaśca narān prati||</para>
  <para style="p">
    <verse number="15" style="v"/>tataḥ paraṁ teṣāṁ sannidhe rdūtagaṇe svargaṁ gate meṣapālakāḥ parasparam avecan āgacchata prabhuḥ parameśvaro yāṁ ghaṭanāṁ jñāpitavān tasyā yātharyaṁ jñātuṁ vayamadhunā baitlehampuraṁ yāmaḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>paścāt te tūrṇaṁ vrajitvā mariyamaṁ yūṣaphaṁ gośālāyāṁ śayanaṁ bālakañca dadṛśuḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>itthaṁ dṛṣṭvā bālakasyārthe proktāṁ sarvvakathāṁ te prācārayāñcakruḥ|</para>
  <para style="p">
    <verse number="18" style="v"/>tato ye lokā meṣarakṣakāṇāṁ vadanebhyastāṁ vārttāṁ śuśruvuste mahāścaryyaṁ menire|</para>
  <para style="p">
    <verse number="19" style="v"/>kintu mariyam etatsarvvaghaṭanānāṁ tātparyyaṁ vivicya manasi sthāpayāmāsa|</para>
  <para style="p">
    <verse number="20" style="v"/>tatpaścād dūtavijñaptānurūpaṁ śrutvā dṛṣṭvā ca meṣapālakā īśvarasya guṇānuvādaṁ dhanyavādañca kurvvāṇāḥ parāvṛtya yayuḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>atha bālakasya tvakchedanakāle'ṣṭamadivase samupasthite tasya garbbhasthiteḥ purvvaṁ svargīyadūto yathājñāpayat tadanurūpaṁ te tannāmadheyaṁ yīśuriti cakrire|</para>
  <para style="p">
    <verse number="22" style="v"/>tataḥ paraṁ mūsālikhitavyavasthāyā anusāreṇa mariyamaḥ śucitvakāla upasthite,</para>
  <para style="p">
    <verse number="23" style="v"/>"prathamajaḥ sarvvaḥ puruṣasantānaḥ parameśvare samarpyatāṁ," iti parameśvarasya vyavasthayā</para>
  <para style="p">
    <verse number="24" style="v"/>yīśuṁ parameśvare samarpayitum śāstrīyavidhyuktaṁ kapotadvayaṁ pārāvataśāvakadvayaṁ vā baliṁ dātuṁ te taṁ gṛhītvā yirūśālamam āyayuḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>yirūśālampuranivāsī śimiyonnāmā dhārmmika eka āsīt sa isrāyelaḥ sāntvanāmapekṣya tasthau kiñca pavitra ātmā tasminnāvirbhūtaḥ|</para>
  <para style="p">
    <verse number="26" style="v"/>aparaṁ prabhuṇā parameśvareṇābhiṣikte trātari tvayā na dṛṣṭe tvaṁ na mariṣyasīti vākyaṁ pavitreṇa ātmanā tasma prākathyata|</para>
  <para style="p">
    <verse number="27" style="v"/>aparañca yadā yīśoḥ pitā mātā ca tadarthaṁ vyavasthānurūpaṁ karmma karttuṁ taṁ mandiram āninyatustadā</para>
  <para style="p">
    <verse number="28" style="v"/>śimiyon ātmana ākarṣaṇena mandiramāgatya taṁ kroḍe nidhāya īśvarasya dhanyavādaṁ kṛtvā kathayāmāsa, yathā,</para>
  <para style="p">
    <verse number="29" style="v"/>he prabho tava dāsoyaṁ nijavākyānusārataḥ| idānīntu sakalyāṇo bhavatā saṁvisṛjyatām|</para>
  <para style="p">
    <verse number="30" style="v"/>yataḥ sakaladeśasya dīptaye dīptirūpakaṁ|</para>
  <para style="p">
    <verse number="31" style="v"/>isrāyelīyalokasya mahāgauravarūpakaṁ|</para>
  <para style="p">
    <verse number="32" style="v"/>yaṁ trāyakaṁ janānāntu sammukhe tvamajījanaḥ| saeva vidyate'smākaṁ dhravaṁ nayananagocare||</para>
  <para style="p">
    <verse number="33" style="v"/>tadānīṁ tenoktā etāḥ sakalāḥ kathāḥ śrutvā tasya mātā yūṣaph ca vismayaṁ menāte|</para>
  <para style="p">
    <verse number="34" style="v"/>tataḥ paraṁ śimiyon tebhya āśiṣaṁ dattvā tanmātaraṁ mariyamam uvāca, paśya isrāyelo vaṁśamadhye bahūnāṁ pātanāyotthāpanāya ca tathā virodhapātraṁ bhavituṁ, bahūnāṁ guptamanogatānāṁ prakaṭīkaraṇāya bālakoyaṁ niyuktosti|</para>
  <para style="p">
    <verse number="35" style="v"/>tasmāt tavāpi prāṇāḥ śūlena vyatsyante|</para>
  <para style="p">
    <verse number="36" style="v"/>aparañca āśerasya vaṁśīyaphinūyelo duhitā hannākhyā atijaratī bhaviṣyadvādinyekā yā vivāhāt paraṁ sapta vatsarān patyā saha nyavasat tato vidhavā bhūtvā caturaśītivarṣavayaḥparyyanataṁ</para>
  <para style="p">
    <verse number="37" style="v"/>mandire sthitvā prārthanopavāsairdivāniśam īśvaram asevata sāpi strī tasmin samaye mandiramāgatya</para>
  <para style="p">
    <verse number="38" style="v"/>parameśvarasya dhanyavādaṁ cakāra, yirūśālampuravāsino yāvanto lokā muktimapekṣya sthitāstān yīśorvṛttāntaṁ jñāpayāmāsa|</para>
  <para style="p">
    <verse number="39" style="v"/>itthaṁ parameśvarasya vyavasthānusāreṇa sarvveṣu karmmasu kṛteṣu tau punaśca gālīlo nāsaratnāmakaṁ nijanagaraṁ pratasthāte|</para>
  <para style="p">
    <verse number="40" style="v"/>tatpaścād bālakaḥ śarīreṇa vṛddhimetya jñānena paripūrṇa ātmanā śaktimāṁśca bhavitumārebhe tathā tasmin īśvarānugraho babhūva|</para>
  <para style="p">
    <verse number="41" style="v"/>tasya pitā mātā ca prativarṣaṁ nistārotsavasamaye yirūśālamam agacchatām|</para>
  <para style="p">
    <verse number="42" style="v"/>aparañca yīśau dvādaśavarṣavayaske sati tau parvvasamayasya rītyanusāreṇa yirūśālamaṁ gatvā</para>
  <para style="p">
    <verse number="43" style="v"/>pārvvaṇaṁ sampādya punarapi vyāghuyya yātaḥ kintu yīśurbālako yirūśālami tiṣṭhati| yūṣaph tanmātā ca tad aviditvā</para>
  <para style="p">
    <verse number="44" style="v"/>sa saṅgibhiḥ saha vidyata etacca budvvā dinaikagamyamārgaṁ jagmatuḥ| kintu śeṣe jñātibandhūnāṁ samīpe mṛgayitvā taduddeेśamaprāpya</para>
  <para style="p">
    <verse number="45" style="v"/>tau punarapi yirūśālamam parāvṛtyāgatya taṁ mṛgayāñcakratuḥ|</para>
  <para style="p">
    <verse number="46" style="v"/>atha dinatrayāt paraṁ paṇḍitānāṁ madhye teṣāṁ kathāḥ śṛṇvan tattvaṁ pṛcchaṁśca mandire samupaviṣṭaḥ sa tābhyāṁ dṛṣṭaḥ|</para>
  <para style="p">
    <verse number="47" style="v"/>tadā tasya buddhyā pratyuttaraiśca sarvve śrotāro vismayamāpadyante|</para>
  <para style="p">
    <verse number="48" style="v"/>tādṛśaṁ dṛṣṭvā tasya janako jananī ca camaccakratuḥ kiñca tasya mātā tamavadat, he putra, kathamāvāṁ pratītthaṁ samācarastvam? paśya tava pitāhañca śokākulau santau tvāmanvicchāvaḥ sma|</para>
  <para style="p">
    <verse number="49" style="v"/>tataḥ sovadat kuto mām anvaicchataṁ? piturgṛhe mayā sthātavyam etat kiṁ yuvābhyāṁ na jñāyate?</para>
  <para style="p">
    <verse number="50" style="v"/>kintu tau tasyaitadvākyasya tātparyyaṁ boddhuṁ nāśaknutāṁ|</para>
  <para style="p">
    <verse number="51" style="v"/>tataḥ paraṁ sa tābhyāṁ saha nāsarataṁ gatvā tayorvaśībhūtastasthau kintu sarvvā etāḥ kathāstasya mātā manasi sthāpayāmāsa|</para>
  <para style="p">
    <verse number="52" style="v"/>atha yīśo rbuddhiḥ śarīrañca tathā tasmin īśvarasya mānavānāñcānugraho varddhitum ārebhe|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ tibiriyakaisarasya rājatvasya pañcadaśe vatsare sati yadā pantīyapīlāto yihūdādeśādhipati rherod tu gālīlpradeśasya rājā philipanāmā tasya bhrātā tu yitūriyāyāstrākhonītiyāpradeśasya ca rājāsīt luṣānīyanāmā avilīnīdeśasya rājāsīt</para>
  <para style="p">
    <verse number="2" style="v"/>hānan kiyaphāścemau pradhānayājākāvāstāṁ tadānīṁ sikhariyasya putrāya yohane madhyeprāntaram īśvarasya vākye prakāśite sati</para>
  <para style="p">
    <verse number="3" style="v"/>sa yarddana ubhayataṭapradeśān sametya pāpamocanārthaṁ manaḥparāvarttanasya cihnarūpaṁ yanmajjanaṁ tadīyāḥ kathāḥ sarvvatra pracārayitumārebhe|</para>
  <para style="p">
    <verse number="4" style="v"/>yiśayiyabhaviṣyadvaktṛgranthe yādṛśī lipirāste yathā, parameśasya panthānaṁ pariṣkuruta sarvvataḥ| tasya rājapathañcaiva samānaṁ kurutādhunā|</para>
  <para style="p">
    <verse number="5" style="v"/>kāriṣyante samucchrāyāḥ sakalā nimnabhūmayaḥ| kāriṣyante natāḥ sarvve parvvatāścopaparvvatāḥ| kāriṣyante ca yā vakrāstāḥ sarvvāḥ saralā bhuvaḥ| kāriṣyante samānāstā yā uccanīcabhūmayaḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>īśvareṇa kṛtaṁ trāṇaṁ drakṣyanti sarvvamānavāḥ| ityetat prāntare vākyaṁ vadataḥ kasyacid ravaḥ||</para>
  <para style="p">
    <verse number="7" style="v"/>ye ye lokā majjanārthaṁ bahirāyayustān sovadat re re sarpavaṁśā āgāminaḥ kopāt palāyituṁ yuṣmān kaścetayāmāsa?</para>
  <para style="p">
    <verse number="8" style="v"/>tasmād ibrāhīm asmākaṁ pitā kathāmīdṛśīṁ manobhi rna kathayitvā yūyaṁ manaḥparivarttanayogyaṁ phalaṁ phalata; yuṣmānahaṁ yathārthaṁ vadāmi pāṣāṇebhya etebhya īśvara ibrāhīmaḥ santānotpādane samarthaḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>aparañca tarumūle'dhunāpi paraśuḥ saṁlagnosti yastaruruttamaṁ phalaṁ na phalati sa chidyate'gnau nikṣipyate ca|</para>
  <para style="p">
    <verse number="10" style="v"/>tadānīṁ lokāstaṁ papracchustarhi kiṁ karttavyamasmābhiḥ?</para>
  <para style="p">
    <verse number="11" style="v"/>tataḥ sovādīt yasya dve vasane vidyete sa vastrahīnāyaikaṁ vitaratu kiṁñca yasya khādyadravyaṁ vidyate sopi tathaiva karotu|</para>
  <para style="p">
    <verse number="12" style="v"/>tataḥ paraṁ karasañcāyino majjanārtham āgatya papracchuḥ he guro kiṁ karttavyamasmābhiḥ?</para>
  <para style="p">
    <verse number="13" style="v"/>tataḥ sokathayat nirūpitādadhikaṁ na gṛhlita|</para>
  <para style="p">
    <verse number="14" style="v"/>anantaraṁ senāgaṇa etya papraccha kimasmābhi rvā karttavyam? tataḥ sobhidadhe kasya kāmapi hāniṁ mā kārṣṭa tathā mṛṣāpavādaṁ mā kuruta nijavetanena ca santuṣya tiṣṭhata|</para>
  <para style="p">
    <verse number="15" style="v"/>aparañca lokā apekṣayā sthitvā sarvvepīti manobhi rvitarkayāñcakruḥ, yohanayam abhiṣiktastrātā na veti?</para>
  <para style="p">
    <verse number="16" style="v"/>tadā yohan sarvvān vyājahāra, jale'haṁ yuṣmān majjayāmi satyaṁ kintu yasya pādukābandhanaṁ mocayitumapi na yogyosmi tādṛśa eko matto gurutaraḥ pumān eti, sa yuṣmān vahnirūpe pavitra ātmani majjayiṣyati|</para>
  <para style="p">
    <verse number="17" style="v"/>aparañca tasya haste śūrpa āste sa svaśasyāni śuddharūpaṁ prasphoṭya godhūmān sarvvān bhāṇḍāgāre saṁgrahīṣyati kintu būṣāṇi sarvvāṇyanirvvāṇavahninā dāhayiṣyati|</para>
  <para style="p">
    <verse number="18" style="v"/>yohan upadeśenetthaṁ nānākathā lokānāṁ samakṣaṁ pracārayāmāsa|</para>
  <para style="p">
    <verse number="19" style="v"/>aparañca herod rājā philipnāmnaḥ sahodarasya bhāryyāṁ herodiyāmadhi tathānyāni yāni yāni kukarmmāṇi kṛtavān tadadhi ca</para>
  <para style="p">
    <verse number="20" style="v"/>yohanā tiraskṛto bhūtvā kārāgāre tasya bandhanād aparamapi kukarmma cakāra|</para>
  <para style="p">
    <verse number="21" style="v"/>itaḥ pūrvvaṁ yasmin samaye sarvve yohanā majjitāstadānīṁ yīśurapyāgatya majjitaḥ|</para>
  <para style="p">
    <verse number="22" style="v"/>tadanantaraṁ tena prārthite meghadvāraṁ muktaṁ tasmācca pavitra ātmā mūrttimān bhūtvā kapotavat taduparyyavaruroha; tadā tvaṁ mama priyaḥ putrastvayi mama paramaḥ santoṣa ityākāśavāṇī babhūva|</para>
  <para style="p">
    <verse number="23" style="v"/>tadānīṁ yīśuḥ prāyeṇa triṁśadvarṣavayaska āsīt| laukikajñāne tu sa yūṣaphaḥ putraḥ,</para>
  <para style="p">
    <verse number="24" style="v"/>yūṣaph eleḥ putraḥ, elirmattataḥ putraḥ, mattat leveḥ putraḥ, levi rmalkeḥ putraḥ, malkiryānnasya putraḥ; yānno yūṣaphaḥ putraḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>yūṣaph mattathiyasya putraḥ, mattathiya āmosaḥ putraḥ, āmos nahūmaḥ putraḥ, nahūm iṣleḥ putraḥ iṣlirnageḥ putraḥ|</para>
  <para style="p">
    <verse number="26" style="v"/>nagirmāṭaḥ putraḥ, māṭ mattathiyasya putraḥ, mattathiyaḥ śimiyeḥ putraḥ, śimiyiryūṣaphaḥ putraḥ, yūṣaph yihūdāḥ putraḥ|</para>
  <para style="p">
    <verse number="27" style="v"/>yihūdā yohānāḥ putraḥ, yohānā rīṣāḥ putraḥ, rīṣāḥ sirubbābilaḥ putraḥ, sirubbābil śaltīyelaḥ putraḥ, śaltīyel nereḥ putraḥ|</para>
  <para style="p">
    <verse number="28" style="v"/>nerirmalkeḥ putraḥ, malkiḥ adyaḥ putraḥ, addī koṣamaḥ putraḥ, koṣam ilmodadaḥ putraḥ, ilmodad eraḥ putraḥ|</para>
  <para style="p">
    <verse number="29" style="v"/>er yośeḥ putraḥ, yośiḥ ilīyeṣaraḥ putraḥ, ilīyeṣar yorīmaḥ putraḥ, yorīm mattataḥ putraḥ, mattata leveḥ putraḥ|</para>
  <para style="p">
    <verse number="30" style="v"/>leviḥ śimiyonaḥ putraḥ, śimiyon yihūdāḥ putraḥ, yihūdā yūṣuphaḥ putraḥ, yūṣuph yonanaḥ putraḥ, yānan ilīyākīmaḥ putraḥ|</para>
  <para style="p">
    <verse number="31" style="v"/>iliyākīmḥ mileyāḥ putraḥ, mileyā mainanaḥ putraḥ, mainan mattattasya putraḥ, mattatto nāthanaḥ putraḥ, nāthan dāyūdaḥ putraḥ|</para>
  <para style="p">
    <verse number="32" style="v"/>dāyūd yiśayaḥ putraḥ, yiśaya obedaḥ putra, obed boyasaḥ putraḥ, boyas salmonaḥ putraḥ, salmon nahaśonaḥ putraḥ|</para>
  <para style="p">
    <verse number="33" style="v"/>nahaśon ammīnādabaḥ putraḥ, ammīnādab arāmaḥ putraḥ, arām hiṣroṇaḥ putraḥ, hiṣroṇ perasaḥ putraḥ, peras yihūdāḥ putraḥ|</para>
  <para style="p">
    <verse number="34" style="v"/>yihūdā yākūbaḥ putraḥ, yākūb ishākaḥ putraḥ, ishāk ibrāhīmaḥ putraḥ, ibrāhīm terahaḥ putraḥ, terah nāhoraḥ putraḥ|</para>
  <para style="p">
    <verse number="35" style="v"/>nāhor sirugaḥ putraḥ, sirug riyvaḥ putraḥ, riyūḥ pelagaḥ putraḥ, pelag evaraḥ putraḥ, evar śelahaḥ putraḥ|</para>
  <para style="p">
    <verse number="36" style="v"/>śelah kainanaḥ putraḥ, kainan arphakṣadaḥ putraḥ, arphakṣad śāmaḥ putraḥ, śām nohaḥ putraḥ, noho lemakaḥ putraḥ|</para>
  <para style="p">
    <verse number="37" style="v"/>lemak mithūśelahaḥ putraḥ, mithūśelah hanokaḥ putraḥ, hanok yeradaḥ putraḥ, yerad mahalalelaḥ putraḥ, mahalalel kainanaḥ putraḥ|</para>
  <para style="p">
    <verse number="38" style="v"/>kainan inośaḥ putraḥ, inoś śetaḥ putraḥ, śet ādamaḥ putra, ādam īśvarasya putraḥ|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ paraṁ yīśuḥ pavitreṇātmanā pūrṇaḥ san yarddananadyāḥ parāvṛtyātmanā prāntaraṁ nītaḥ san catvāriṁśaddināni yāvat śaitānā parīkṣito'bhūt,</para>
  <para style="p">
    <verse number="2" style="v"/>kiñca tāni sarvvadināni bhojanaṁ vinā sthitatvāt kāle pūrṇe sa kṣudhitavān|</para>
  <para style="p">
    <verse number="3" style="v"/>tataḥ śaitānāgatya tamavadat tvaṁ cedīśvarasya putrastarhi prastarānetān ājñayā pūpān kuru|</para>
  <para style="p">
    <verse number="4" style="v"/>tadā yīśuruvāca, lipirīdṛśī vidyate manujaḥ kevalena pūpena na jīvati kintvīśvarasya sarvvābhirājñābhi rjīvati|</para>
  <para style="p">
    <verse number="5" style="v"/>tadā śaitān tamuccaṁ parvvataṁ nītvā nimiṣaikamadhye jagataḥ sarvvarājyāni darśitavān|</para>
  <para style="p">
    <verse number="6" style="v"/>paścāt tamavādīt sarvvam etad vibhavaṁ pratāpañca tubhyaṁ dāsyāmi tan mayi samarpitamāste yaṁ prati mamecchā jāyate tasmai dātuṁ śaknomi,</para>
  <para style="p">
    <verse number="7" style="v"/>tvaṁ cenmāṁ bhajase tarhi sarvvametat tavaiva bhaviṣyati|</para>
  <para style="p">
    <verse number="8" style="v"/>tadā yīśustaṁ pratyuktavān dūrī bhava śaitān lipirāste, nijaṁ prabhuṁ parameśvaraṁ bhajasva kevalaṁ tameva sevasva ca|</para>
  <para style="p">
    <verse number="9" style="v"/>atha śaitān taṁ yirūśālamaṁ nītvā mandirasya cūḍāyā upari samupaveśya jagāda tvaṁ cedīśvarasya putrastarhi sthānādito lamphitvādhaḥ</para>
  <para style="p">
    <verse number="10" style="v"/>pata yato lipirāste, ājñāpayiṣyati svīyān dūtān sa parameśvaraḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>rakṣituṁ sarvvamārge tvāṁ tena tvaccaraṇe yathā| na laget prastarāghātastvāṁ dhariṣyanti te tathā|</para>
  <para style="p">
    <verse number="12" style="v"/>tadā yīśunā pratyuktam idamapyuktamasti tvaṁ svaprabhuṁ pareśaṁ mā parīkṣasva|</para>
  <para style="p">
    <verse number="13" style="v"/>paścāt śaitān sarvvaparīkṣāṁ samāpya kṣaṇāttaṁ tyaktvā yayau|</para>
  <para style="p">
    <verse number="14" style="v"/>tadā yīśurātmaprabhāvāt punargālīlpradeśaṁ gatastadā tatsukhyātiścaturdiśaṁ vyānaśe|</para>
  <para style="p">
    <verse number="15" style="v"/>sa teṣāṁ bhajanagṛheṣu upadiśya sarvvaiḥ praśaṁsito babhūva|</para>
  <para style="p">
    <verse number="16" style="v"/>atha sa svapālanasthānaṁ nāsaratpurametya viśrāmavāre svācārād bhajanagehaṁ praviśya paṭhitumuttasthau|</para>
  <para style="p">
    <verse number="17" style="v"/>tato yiśayiyabhaviṣyadvādinaḥ pustake tasya karadatte sati sa tat pustakaṁ vistāryya yatra vakṣyamāṇāni vacanāni santi tat sthānaṁ prāpya papāṭha|</para>
  <para style="p">
    <verse number="18" style="v"/>ātmā tu parameśasya madīyopari vidyate| daridreṣu susaṁvādaṁ vaktuṁ māṁ sobhiṣiktavān| bhagnāntaḥ karaṇāllokān susvasthān karttumeva ca| bandīkṛteṣu lokeṣu mukte rghoṣayituṁ vacaḥ| netrāṇi dātumandhebhyastrātuṁ baddhajanānapi|</para>
  <para style="p">
    <verse number="19" style="v"/>pareśānugrahe kālaṁ pracārayitumeva ca| sarvvaitatkaraṇārthāya māmeva prahiṇoti saḥ||</para>
  <para style="p">
    <verse number="20" style="v"/>tataḥ pustakaṁ badvvā paricārakasya haste samarpya cāsane samupaviṣṭaḥ, tato bhajanagṛhe yāvanto lokā āsan te sarvve'nanyadṛṣṭyā taṁ vilulokire|</para>
  <para style="p">
    <verse number="21" style="v"/>anantaram adyaitāni sarvvāṇi likhitavacanāni yuṣmākaṁ madhye siddhāni sa imāṁ kathāṁ tebhyaḥ kathayitumārebhe|</para>
  <para style="p">
    <verse number="22" style="v"/>tataḥ sarvve tasmin anvarajyanta, kiñca tasya mukhānnirgatābhiranugrahasya kathābhiścamatkṛtya kathayāmāsuḥ kimayaṁ yūṣaphaḥ putro na?</para>
  <para style="p">
    <verse number="23" style="v"/>tadā so'vādīd he cikitsaka svameva svasthaṁ kuru kapharnāhūmi yadyat kṛtavān tadaśrauṣma tāḥ sarvāḥ kriyā atra svadeśe kuru kathāmetāṁ yūyamevāvaśyaṁ māṁ vadiṣyatha|</para>
  <para style="p">
    <verse number="24" style="v"/>punaḥ sovādīd yuṣmānahaṁ yathārthaṁ vadāmi, kopi bhaviṣyadvādī svadeśe satkāraṁ na prāpnoti|</para>
  <para style="p">
    <verse number="25" style="v"/>aparañca yathārthaṁ vacmi, eliyasya jīvanakāle yadā sārddhatritayavarṣāṇi yāvat jaladapratibandhāt sarvvasmin deśe mahādurbhikṣam ajaniṣṭa tadānīm isrāyelo deśasya madhye bahvyo vidhavā āsan,</para>
  <para style="p">
    <verse number="26" style="v"/>kintu sīdonpradeśīyasāriphatpuranivāsinīm ekāṁ vidhavāṁ vinā kasyāścidapi samīpe eliyaḥ prerito nābhūt|</para>
  <para style="p">
    <verse number="27" style="v"/>aparañca ilīśāyabhaviṣyadvādividyamānatākāle isrāyeldeśe bahavaḥ kuṣṭhina āsan kintu surīyadeśīyaṁ nāmānkuṣṭhinaṁ vinā kopyanyaḥ pariṣkṛto nābhūt|</para>
  <para style="p">
    <verse number="28" style="v"/>imāṁ kathāṁ śrutvā bhajanagehasthitā lokāḥ sakrodham utthāya</para>
  <para style="p">
    <verse number="29" style="v"/>nagarāttaṁ bahiṣkṛtya yasya śikhariṇa upari teṣāṁ nagaraṁ sthāpitamāste tasmānnikṣeptuṁ tasya śikharaṁ taṁ ninyuḥ</para>
  <para style="p">
    <verse number="30" style="v"/>kintu sa teṣāṁ madhyādapasṛtya sthānāntaraṁ jagāma|</para>
  <para style="p">
    <verse number="31" style="v"/>tataḥ paraṁ yīśurgālīlpradeśīyakapharnāhūmnagara upasthāya viśrāmavāre lokānupadeṣṭum ārabdhavān|</para>
  <para style="p">
    <verse number="32" style="v"/>tadupadeśāt sarvve camaccakru ryatastasya kathā gurutarā āsan|</para>
  <para style="p">
    <verse number="33" style="v"/>tadānīṁ tadbhajanagehasthito'medhyabhūtagrasta eko jana uccaiḥ kathayāmāsa,</para>
  <para style="p">
    <verse number="34" style="v"/>he nāsaratīyayīśo'smān tyaja, tvayā sahāsmākaṁ kaḥ sambandhaḥ? kimasmān vināśayitumāyāsi? tvamīśvarasya pavitro jana etadahaṁ jānāmi|</para>
  <para style="p">
    <verse number="35" style="v"/>tadā yīśustaṁ tarjayitvāvadat maunī bhava ito bahirbhava; tataḥ somedhyabhūtastaṁ madhyasthāne pātayitvā kiñcidapyahiṁsitvā tasmād bahirgatavān|</para>
  <para style="p">
    <verse number="36" style="v"/>tataḥ sarvve lokāścamatkṛtya parasparaṁ vaktumārebhire koyaṁ camatkāraḥ| eṣa prabhāveṇa parākrameṇa cāmedhyabhūtān ājñāpayati tenaiva te bahirgacchanti|</para>
  <para style="p">
    <verse number="37" style="v"/>anantaraṁ caturdiksthadeśān tasya sukhyātirvyāpnot|</para>
  <para style="p">
    <verse number="38" style="v"/>tadanantaraṁ sa bhajanagehād bahirāgatya śimono niveśanaṁ praviveśa tadā tasya śvaśrūrjvareṇātyantaṁ pīḍitāsīt śiṣyāstadarthaṁ tasmin vinayaṁ cakruḥ|</para>
  <para style="p">
    <verse number="39" style="v"/>tataḥ sa tasyāḥ samīpe sthitvā jvaraṁ tarjayāmāsa tenaiva tāṁ jvaro'tyākṣīt tataḥ sā tatkṣaṇam utthāya tān siṣeve|</para>
  <para style="p">
    <verse number="40" style="v"/>atha sūryyāstakāle sveṣāṁ ye ye janā nānārogaiḥ pīḍitā āsan lokāstān yīśoḥ samīpam āninyuḥ, tadā sa ekaikasya gātre karamarpayitvā tānarogān cakāra|</para>
  <para style="p">
    <verse number="41" style="v"/>tato bhūtā bahubhyo nirgatya cītśabdaṁ kṛtvā ca babhāṣire tvamīśvarasya putro'bhiṣiktatrātā; kintu sobhiṣiktatrāteti te vividuretasmāt kāraṇāt tān tarjayitvā tadvaktuṁ niṣiṣedha|</para>
  <para style="p">
    <verse number="42" style="v"/>aparañca prabhāte sati sa vijanasthānaṁ pratasthe paścāt janāstamanvicchantastannikaṭaṁ gatvā sthānāntaragamanārthaṁ tamanvarundhan|</para>
  <para style="p">
    <verse number="43" style="v"/>kintu sa tān jagāda, īśvarīyarājyasya susaṁvādaṁ pracārayitum anyāni purāṇyapi mayā yātavyāni yatastadarthameva preritohaṁ|</para>
  <para style="p">
    <verse number="44" style="v"/>atha gālīlo bhajanageheṣu sa upadideśa|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ yīśurekadā gineṣarathdasya tīra uttiṣṭhati, tadā lokā īśvarīyakathāṁ śrotuṁ tadupari prapatitāḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>tadānīṁ sa hdasya tīrasamīpe naudvayaṁ dadarśa kiñca matsyopajīvino nāvaṁ vihāya jālaṁ prakṣālayanti|</para>
  <para style="p">
    <verse number="3" style="v"/>tatastayordvayo rmadhye śimono nāvamāruhya tīrāt kiñciddūraṁ yātuṁ tasmin vinayaṁ kṛtvā naukāyāmupaviśya lokān propadiṣṭavān|</para>
  <para style="p">
    <verse number="4" style="v"/>paścāt taṁ prastāvaṁ samāpya sa śimonaṁ vyājahāra, gabhīraṁ jalaṁ gatvā matsyān dharttuṁ jālaṁ nikṣipa|</para>
  <para style="p">
    <verse number="5" style="v"/>tataḥ śimona babhāṣe, he guro yadyapi vayaṁ kṛtsnāṁ yāminīṁ pariśramya matsyaikamapi na prāptāstathāpi bhavato nideśato jālaṁ kṣipāmaḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>atha jāle kṣipte bahumatsyapatanād ānāyaḥ pracchinnaḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>tasmād upakarttum anyanausthān saṅgina āyātum iṅgitena samāhvayan tatasta āgatya matsyai rnaudvayaṁ prapūrayāmāsu ryai rnaudvayaṁ pramagnam|</para>
  <para style="p">
    <verse number="8" style="v"/>tadā śimonpitarastad vilokya yīśoścaraṇayoḥ patitvā, he prabhohaṁ pāpī naro mama nikaṭād bhavān yātu, iti kathitavān|</para>
  <para style="p">
    <verse number="9" style="v"/>yato jāle patitānāṁ matsyānāṁ yūthāt śimon tatsaṅginaśca camatkṛtavantaḥ; śimonaḥ sahakāriṇau sivadeḥ putrau yākūb yohan cemau tādṛśau babhūvatuḥ|</para>
  <para style="p">
    <verse number="10" style="v"/>tadā yīśuḥ śimonaṁ jagāda mā bhaiṣīradyārabhya tvaṁ manuṣyadharo bhaviṣyasi|</para>
  <para style="p">
    <verse number="11" style="v"/>anantaraṁ sarvvāsu nausu tīram ānītāsu te sarvvān parityajya tasya paścādgāmino babhūvuḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>tataḥ paraṁ yīśau kasmiṁścit pure tiṣṭhati jana ekaḥ sarvvāṅgakuṣṭhastaṁ vilokya tasya samīpe nyubjaḥ patitvā savinayaṁ vaktumārebhe, he prabho yadi bhavānicchati tarhi māṁ pariṣkarttuṁ śaknoti|</para>
  <para style="p">
    <verse number="13" style="v"/>tadānīṁ sa pāṇiṁ prasāryya tadaṅgaṁ spṛśan babhāṣe tvaṁ pariṣkriyasveti mamecchāsti tatastatkṣaṇaṁ sa kuṣṭhāt muktaḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>paścāt sa tamājñāpayāmāsa kathāmimāṁ kasmaicid akathayitvā yājakasya samīpañca gatvā svaṁ darśaya, lokebhyo nijapariṣkṛtatvasya pramāṇadānāya mūsājñānusāreṇa dravyamutmṛjasva ca|</para>
  <para style="p">
    <verse number="15" style="v"/>tathāpi yīśoḥ sukhyāti rbahu vyāptumārebhe kiñca tasya kathāṁ śrotuṁ svīyarogebhyo moktuñca lokā ājagmuḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>atha sa prāntaraṁ gatvā prārthayāñcakre|</para>
  <para style="p">
    <verse number="17" style="v"/>aparañca ekadā yīśurupadiśati, etarhi gālīlyihūdāpradeśayoḥ sarvvanagarebhyo yirūśālamaśca kiyantaḥ phirūśilokā vyavasthāpakāśca samāgatya tadantike samupaviviśuḥ, tasmin kāle lokānāmārogyakāraṇāt prabhoḥ prabhāvaḥ pracakāśe|</para>
  <para style="p">
    <verse number="18" style="v"/>paścāt kiyanto lokā ekaṁ pakṣāghātinaṁ khaṭvāyāṁ nidhāya yīśoḥ samīpamānetuṁ sammukhe sthāpayituñca vyāpriyanta|</para>
  <para style="p">
    <verse number="19" style="v"/>kintu bahujananivahasamvādhāt na śaknuvanto gṛhopari gatvā gṛhapṛṣṭhaṁ khanitvā taṁ pakṣāghātinaṁ sakhaṭvaṁ gṛhamadhye yīśoḥ sammukhe 'varohayāmāsuḥ|</para>
  <para style="p">
    <verse number="20" style="v"/>tadā yīśusteṣām īdṛśaṁ viśvāsaṁ vilokya taṁ pakṣāghātinaṁ vyājahāra, he mānava tava pāpamakṣamyata|</para>
  <para style="p">
    <verse number="21" style="v"/>tasmād adhyāpakāḥ phirūśinaśca cittairitthaṁ pracintitavantaḥ, eṣa jana īśvaraṁ nindati koyaṁ? kevalamīśvaraṁ vinā pāpaṁ kṣantuṁ kaḥ śaknoti?</para>
  <para style="p">
    <verse number="22" style="v"/>tadā yīśusteṣām itthaṁ cintanaṁ viditvā tebhyokathayad yūyaṁ manobhiḥ kuto vitarkayatha?</para>
  <para style="p">
    <verse number="23" style="v"/>tava pāpakṣamā jātā yadvā tvamutthāya vraja etayo rmadhye kā kathā sukathyā?</para>
  <para style="p">
    <verse number="24" style="v"/>kintu pṛthivyāṁ pāpaṁ kṣantuṁ mānavasutasya sāmarthyamastīti yathā yūyaṁ jñātuṁ śaknutha tadarthaṁ (sa taṁ pakṣāghātinaṁ jagāda) uttiṣṭha svaśayyāṁ gṛhītvā gṛhaṁ yāhīti tvāmādiśāmi|</para>
  <para style="p">
    <verse number="25" style="v"/>tasmāt sa tatkṣaṇam utthāya sarvveṣāṁ sākṣāt nijaśayanīyaṁ gṛhītvā īśvaraṁ dhanyaṁ vadan nijaniveśanaṁ yayau|</para>
  <para style="p">
    <verse number="26" style="v"/>tasmāt sarvve vismaya prāptā manaḥsu bhītāśca vayamadyāsambhavakāryyāṇyadarśāma ityuktvā parameśvaraṁ dhanyaṁ proditāḥ|</para>
  <para style="p">
    <verse number="27" style="v"/>tataḥ paraṁ bahirgacchan karasañcayasthāne levināmānaṁ karasañcāyakaṁ dṛṣṭvā yīśustamabhidadhe mama paścādehi|</para>
  <para style="p">
    <verse number="28" style="v"/>tasmāt sa tatkṣaṇāt sarvvaṁ parityajya tasya paścādiyāya|</para>
  <para style="p">
    <verse number="29" style="v"/>anantaraṁ levi rnijagṛhe tadarthaṁ mahābhojyaṁ cakāra, tadā taiḥ sahāneke karasañcāyinastadanyalokāśca bhoktumupaviviśuḥ|</para>
  <para style="p">
    <verse number="30" style="v"/>tasmāt kāraṇāt caṇḍālānāṁ pāpilokānāñca saṅge yūyaṁ kuto bhaṁgdhve pivatha ceti kathāṁ kathayitvā phirūśino'dhyāpakāśca tasya śiṣyaiḥ saha vāgyuddhaṁ karttumārebhire|</para>
  <para style="p">
    <verse number="31" style="v"/>tasmād yīśustān pratyavocad arogalokānāṁ cikitsakena prayojanaṁ nāsti kintu sarogāṇāmeva|</para>
  <para style="p">
    <verse number="32" style="v"/>ahaṁ dhārmmikān āhvātuṁ nāgatosmi kintu manaḥ parāvarttayituṁ pāpina eva|</para>
  <para style="p">
    <verse number="33" style="v"/>tataste procuḥ, yohanaḥ phirūśināñca śiṣyā vāraṁvāram upavasanti prārthayante ca kintu tava śiṣyāḥ kuto bhuñjate pivanti ca?</para>
  <para style="p">
    <verse number="34" style="v"/>tadā sa tānācakhyau vare saṅge tiṣṭhati varasya sakhigaṇaṁ kimupavāsayituṁ śaknutha?</para>
  <para style="p">
    <verse number="35" style="v"/>kintu yadā teṣāṁ nikaṭād varo neṣyate tadā te samupavatsyanti|</para>
  <para style="p">
    <verse number="36" style="v"/>soparamapi dṛṣṭāntaṁ kathayāmbabhūva purātanavastre kopi nutanavastraṁ na sīvyati yatastena sevanena jīrṇavastraṁ chidyate, nūtanapurātanavastrayo rmelañca na bhavati|</para>
  <para style="p">
    <verse number="37" style="v"/>purātanyāṁ kutvāṁ kopi nutanaṁ drākṣārasaṁ na nidadhāti, yato navīnadrākṣārasasya tejasā purātanī kutū rvidīryyate tato drākṣārasaḥ patati kutūśca naśyati|</para>
  <para style="p">
    <verse number="38" style="v"/>tato heto rnūtanyāṁ kutvāṁ navīnadrākṣārasaḥ nidhātavyastenobhayasya rakṣā bhavati|</para>
  <para style="p">
    <verse number="39" style="v"/>aparañca purātanaṁ drākṣārasaṁ pītvā kopi nūtanaṁ na vāñchati, yataḥ sa vakti nūtanāt purātanam praśastam|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>acarañca parvvaṇo dvitīyadināt paraṁ prathamaviśrāmavāre śasyakṣetreṇa yīśorgamanakāle tasya śiṣyāḥ kaṇiśaṁ chittvā kareṣu marddayitvā khāditumārebhire|</para>
  <para style="p">
    <verse number="2" style="v"/>tasmāt kiyantaḥ phirūśinastānavadan viśrāmavāre yat karmma na karttavyaṁ tat kutaḥ kurutha?</para>
  <para style="p">
    <verse number="3" style="v"/>yīśuḥ pratyuvāca dāyūd tasya saṅginaśca kṣudhārttāḥ kiṁ cakruḥ sa katham īśvarasya mandiraṁ praviśya</para>
  <para style="p">
    <verse number="4" style="v"/>ye darśanīyāḥ pūpā yājakān vinānyasya kasyāpyabhojanīyāstānānīya svayaṁ bubhaje saṅgibhyopi dadau tat kiṁ yuṣmābhiḥ kadāpi nāpāṭhi?</para>
  <para style="p">
    <verse number="5" style="v"/>paścāt sa tānavadat manujasuto viśrāmavārasyāpi prabhu rbhavati|</para>
  <para style="p">
    <verse number="6" style="v"/>anantaram anyaviśrāmavāre sa bhajanagehaṁ praviśya samupadiśati| tadā tatsthāne śuṣkadakṣiṇakara ekaḥ pumān upatasthivān|</para>
  <para style="p">
    <verse number="7" style="v"/>tasmād adhyāpakāḥ phirūśinaśca tasmin doṣamāropayituṁ sa viśrāmavāre tasya svāsthyaṁ karoti naveti pratīkṣitumārebhire|</para>
  <para style="p">
    <verse number="8" style="v"/>tadā yīśusteṣāṁ cintāṁ viditvā taṁ śuṣkakaraṁ pumāṁsaṁ provāca, tvamutthāya madhyasthāne tiṣṭha|</para>
  <para style="p">
    <verse number="9" style="v"/>tasmāt tasmin utthitavati yīśustān vyājahāra, yuṣmān imāṁ kathāṁ pṛcchāmi, viśrāmavāre hitam ahitaṁ vā, prāṇarakṣaṇaṁ prāṇanāśanaṁ vā, eteṣāṁ kiṁ karmmakaraṇīyam?</para>
  <para style="p">
    <verse number="10" style="v"/>paścāt caturdikṣu sarvvān vilokya taṁ mānavaṁ babhāṣe, nijakaraṁ prasāraya; tatastena tathā kṛta itarakaravat tasya hastaḥ svasthobhavat|</para>
  <para style="p">
    <verse number="11" style="v"/>tasmāt te pracaṇḍakopānvitā yīśuṁ kiṁ kariṣyantīti parasparaṁ pramantritāḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>tataḥ paraṁ sa parvvatamāruhyeśvaramuddiśya prārthayamānaḥ kṛtsnāṁ rātriṁ yāpitavān|</para>
  <para style="p">
    <verse number="13" style="v"/>atha dine sati sa sarvvān śiṣyān āhūtavān teṣāṁ madhye</para>
  <para style="p">
    <verse number="14" style="v"/>pitaranāmnā khyātaḥ śimon tasya bhrātā āndriyaśca yākūb yohan ca philip barthalamayaśca</para>
  <para style="p">
    <verse number="15" style="v"/>mathiḥ thomā ālphīyasya putro yākūb jvalantanāmnā khyātaḥ śimon</para>
  <para style="p">
    <verse number="16" style="v"/>ca yākūbo bhrātā yihūdāśca taṁ yaḥ parakareṣu samarpayiṣyati sa īṣkarīyotīyayihūdāścaitān dvādaśa janān manonītān kṛtvā sa jagrāha tathā prerita iti teṣāṁ nāma cakāra|</para>
  <para style="p">
    <verse number="17" style="v"/>tataḥ paraṁ sa taiḥ saha parvvatādavaruhya upatyakāyāṁ tasthau tatastasya śiṣyasaṅgho yihūdādeśād yirūśālamaśca soraḥ sīdonaśca jaladhe rodhaso jananihāśca etya tasya kathāśravaṇārthaṁ rogamuktyarthañca tasya samīpe tasthuḥ|</para>
  <para style="p">
    <verse number="18" style="v"/>amedhyabhūtagrastāśca tannikaṭamāgatya svāsthyaṁ prāpuḥ|</para>
  <para style="p">
    <verse number="19" style="v"/>sarvveṣāṁ svāsthyakaraṇaprabhāvasya prakāśitatvāt sarvve lokā etya taṁ spraṣṭuṁ yetire|</para>
  <para style="p">
    <verse number="20" style="v"/>paścāt sa śiṣyān prati dṛṣṭiṁ kutvā jagāda, he daridrā yūyaṁ dhanyā yata īśvarīye rājye vo'dhikārosti|</para>
  <para style="p">
    <verse number="21" style="v"/>he adhunā kṣudhitalokā yūyaṁ dhanyā yato yūyaṁ tarpsyatha; he iha rodino janā yūyaṁ dhanyā yato yūyaṁ hasiṣyatha|</para>
  <para style="p">
    <verse number="22" style="v"/>yadā lokā manuṣyasūno rnāmaheto ryuṣmān ṛृtīyiṣyante pṛthak kṛtvā nindiṣyanti, adhamāniva yuṣmān svasamīpād dūrīkariṣyanti ca tadā yūyaṁ dhanyāḥ|</para>
  <para style="p">
    <verse number="23" style="v"/>svarge yuṣmākaṁ yatheṣṭaṁ phalaṁ bhaviṣyati, etadarthaṁ tasmin dine prollasata ānandena nṛtyata ca, teṣāṁ pūrvvapuruṣāśca bhaviṣyadvādinaḥ prati tathaiva vyavāharan|</para>
  <para style="p">
    <verse number="24" style="v"/>kintu hā hā dhanavanto yūyaṁ sukhaṁ prāpnuta| hanta paritṛptā yūyaṁ kṣudhitā bhaviṣyatha;</para>
  <para style="p">
    <verse number="25" style="v"/>iha hasanto yūyaṁ vata yuṣmābhiḥ śocitavyaṁ roditavyañca|</para>
  <para style="p">
    <verse number="26" style="v"/>sarvvailākai ryuṣmākaṁ sukhyātau kṛtāyāṁ yuṣmākaṁ durgati rbhaviṣyati yuṣmākaṁ pūrvvapuruṣā mṛṣābhaviṣyadvādinaḥ prati tadvat kṛtavantaḥ|</para>
  <para style="p">
    <verse number="27" style="v"/>he śrotāro yuṣmabhyamahaṁ kathayāmi, yūyaṁ śatruṣu prīyadhvaṁ ye ca yuṣmān dviṣanti teṣāmapi hitaṁ kuruta|</para>
  <para style="p">
    <verse number="28" style="v"/>ye ca yuṣmān śapanti tebhya āśiṣaṁ datta ye ca yuṣmān avamanyante teṣāṁ maṅgalaṁ prārthayadhvaṁ|</para>
  <para style="p">
    <verse number="29" style="v"/>yadi kaścit tava kapole capeṭāghātaṁ karoti tarhi taṁ prati kapolam anyaṁ parāvarttya sammukhīkuru punaśca yadi kaścit tava gātrīyavastraṁ harati tarhi taṁ paridheyavastram api grahītuṁ mā vāraya|</para>
  <para style="p">
    <verse number="30" style="v"/>yastvāṁ yācate tasmai dehi, yaśca tava sampattiṁ harati taṁ mā yācasva|</para>
  <para style="p">
    <verse number="31" style="v"/>parebhyaḥ svān prati yathācaraṇam apekṣadhve parān prati yūyamapi tathācarata|</para>
  <para style="p">
    <verse number="32" style="v"/>ye janā yuṣmāsu prīyante kevalaṁ teṣu prīyamāṇeṣu yuṣmākaṁ kiṁ phalaṁ? pāpilokā api sveṣu prīyamāṇeṣu prīyante|</para>
  <para style="p">
    <verse number="33" style="v"/>yadi hitakāriṇa eva hitaṁ kurutha tarhi yuṣmākaṁ kiṁ phalaṁ? pāpilokā api tathā kurvvanti|</para>
  <para style="p">
    <verse number="34" style="v"/>yebhya ṛṇapariśodhasya prāptipratyāśāste kevalaṁ teṣu ṛṇe samarpite yuṣmākaṁ kiṁ phalaṁ? punaḥ prāptyāśayā pāpīlokā api pāpijaneṣu ṛṇam arpayanti|</para>
  <para style="p">
    <verse number="35" style="v"/>ato yūyaṁ ripuṣvapi prīyadhvaṁ, parahitaṁ kuruta ca; punaḥ prāptyāśāṁ tyaktvā ṛṇamarpayata, tathā kṛte yuṣmākaṁ mahāphalaṁ bhaviṣyati, yūyañca sarvvapradhānasya santānā iti khyātiṁ prāpsyatha, yato yuṣmākaṁ pitā kṛtaghnānāṁ durvṭattānāñca hitamācarati|</para>
  <para style="p">
    <verse number="36" style="v"/>ata eva sa yathā dayālu ryūyamapi tādṛśā dayālavo bhavata|</para>
  <para style="p">
    <verse number="37" style="v"/>aparañca parān doṣiṇo mā kuruta tasmād yūyaṁ doṣīkṛtā na bhaviṣyatha; adaṇḍyān mā daṇḍayata tasmād yūyamapi daṇḍaṁ na prāpsyatha; pareṣāṁ doṣān kṣamadhvaṁ tasmād yuṣmākamapi doṣāḥ kṣamiṣyante|</para>
  <para style="p">
    <verse number="38" style="v"/>dānānidatta tasmād yūyaṁ dānāni prāpsyatha, varañca lokāḥ parimāṇapātraṁ pradalayya sañcālya proñcālya paripūryya yuṣmākaṁ kroḍeṣu samarpayiṣyanti; yūyaṁ yena parimāṇena parimātha tenaiva parimāṇena yuṣmatkṛte parimāsyate|</para>
  <para style="p">
    <verse number="39" style="v"/>atha sa tebhyo dṛṣṭāntakathāmakathayat, andho janaḥ kimandhaṁ panthānaṁ darśayituṁ śaknoti? tasmād ubhāvapi kiṁ gartte na patiṣyataḥ?</para>
  <para style="p">
    <verse number="40" style="v"/>guroḥ śiṣyo na śreṣṭhaḥ kintu śiṣye siddhe sati sa gurutulyo bhavituṁ śaknoti|</para>
  <para style="p">
    <verse number="41" style="v"/>aparañca tvaṁ svacakṣuुṣi nāsām adṛṣṭvā tava bhrātuścakṣuṣi yattṛṇamasti tadeva kutaḥ paśyami?</para>
  <para style="p">
    <verse number="42" style="v"/>svacakṣuṣi yā nāsā vidyate tām ajñātvā, bhrātastava netrāt tṛṇaṁ bahiḥ karomīti vākyaṁ bhrātaraṁ kathaṁ vaktuṁ śaknoṣi? he kapaṭin pūrvvaṁ svanayanāt nāsāṁ bahiḥ kuru tato bhrātuścakṣuṣastṛṇaṁ bahiḥ karttuṁ sudṛṣṭiṁ prāpsyasi|</para>
  <para style="p">
    <verse number="43" style="v"/>anyañca uttamastaruḥ kadāpi phalamanuttamaṁ na phalati, anuttamataruśca phalamuttamaṁ na phalati kāraṇādataḥ phalaistaravo jñāyante|</para>
  <para style="p">
    <verse number="44" style="v"/>kaṇṭakipādapāt kopi uḍumbaraphalāni na pātayati tathā śṛgālakolivṛkṣādapi kopi drākṣāphalaṁ na pātayati|</para>
  <para style="p">
    <verse number="45" style="v"/>tadvat sādhuloko'ntaḥkaraṇarūpāt subhāṇḍāgārād uttamāni dravyāṇi bahiḥ karoti, duṣṭo lokaścāntaḥkaraṇarūpāt kubhāṇḍāgārāt kutsitāni dravyāṇi nirgamayati yato'ntaḥkaraṇānāṁ pūrṇabhāvānurūpāṇi vacāṁsi mukhānnirgacchanti|</para>
  <para style="p">
    <verse number="46" style="v"/>aparañca mamājñānurūpaṁ nācaritvā kuto māṁ prabho prabho iti vadatha?</para>
  <para style="p">
    <verse number="47" style="v"/>yaḥ kaścin mama nikaṭam āgatya mama kathā niśamya tadanurūpaṁ karmma karoti sa kasya sadṛśo bhavati tadahaṁ yuṣmān jñāाpayāmi|</para>
  <para style="p">
    <verse number="48" style="v"/>yo jano gabhīraṁ khanitvā pāṣāṇasthale bhittiṁ nirmmāya svagṛhaṁ racayati tena saha tasyopamā bhavati; yata āplāvijalametya tasya mūle vegena vahadapi tadgehaṁ lāḍayituṁ na śaknoti yatastasya bhittiḥ pāṣāṇopari tiṣṭhati|</para>
  <para style="p">
    <verse number="49" style="v"/>kintu yaḥ kaścin mama kathāḥ śrutvā tadanurūpaṁ nācarati sa bhittiṁ vinā mṛृdupari gṛhanirmmātrā samāno bhavati; yata āplāvijalamāgatya vegena yadā vahati tadā tadgṛhaṁ patati tasya mahat patanaṁ jāyate|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ paraṁ sa lokānāṁ karṇagocare tān sarvvān upadeśān samāpya yadā kapharnāhūmpuraṁ praviśati</para>
  <para style="p">
    <verse number="2" style="v"/>tadā śatasenāpateḥ priyadāsa eko mṛtakalpaḥ pīḍita āsīt|</para>
  <para style="p">
    <verse number="3" style="v"/>ataḥ senāpati ryīśo rvārttāṁ niśamya dāsasyārogyakaraṇāya tasyāgamanārthaṁ vinayakaraṇāya yihūdīyān kiyataḥ prācaḥ preṣayāmāsa|</para>
  <para style="p">
    <verse number="4" style="v"/>te yīśorantikaṁ gatvā vinayātiśayaṁ vaktumārebhire, sa senāpati rbhavatonugrahaṁ prāptum arhati|</para>
  <para style="p">
    <verse number="5" style="v"/>yataḥ sosmajjātīyeṣu lokeṣu prīyate tathāsmatkṛte bhajanagehaṁ nirmmitavān|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmād yīśustaiḥ saha gatvā niveśanasya samīpaṁ prāpa, tadā sa śatasenāpati rvakṣyamāṇavākyaṁ taṁ vaktuṁ bandhūn prāhiṇot| he prabho svayaṁ śramo na karttavyo yad bhavatā madgehamadhye pādārpaṇaṁ kriyeta tadapyahaṁ nārhāmi,</para>
  <para style="p">
    <verse number="7" style="v"/>kiñcāhaṁ bhavatsamīpaṁ yātumapi nātmānaṁ yogyaṁ buddhavān, tato bhavān vākyamātraṁ vadatu tenaiva mama dāsaḥ svastho bhaviṣyati|</para>
  <para style="p">
    <verse number="8" style="v"/>yasmād ahaṁ parādhīnopi mamādhīnā yāḥ senāḥ santi tāsām ekajanaṁ prati yāhīti mayā prokte sa yāti; tadanyaṁ prati āyāhīti prokte sa āyāti; tathā nijadāsaṁ prati etat kurvviti prokte sa tadeva karoti|</para>
  <para style="p">
    <verse number="9" style="v"/>yīśuridaṁ vākyaṁ śrutvā vismayaṁ yayau, mukhaṁ parāvartya paścādvarttino lokān babhāṣe ca, yuṣmānahaṁ vadāmi isrāyelo vaṁśamadhyepi viśvāsamīdṛśaṁ na prāpnavaṁ|</para>
  <para style="p">
    <verse number="10" style="v"/>tataste preṣitā gṛhaṁ gatvā taṁ pīḍitaṁ dāsaṁ svasthaṁ dadṛśuḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>pare'hani sa nāyīnākhyaṁ nagaraṁ jagāma tasyāneke śiṣyā anye ca lokāstena sārddhaṁ yayuḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>teṣu tannagarasya dvārasannidhiṁ prāpteṣu kiyanto lokā ekaṁ mṛtamanujaṁ vahanto nagarasya bahiryānti, sa tanmāturekaputrastanmātā ca vidhavā; tayā sārddhaṁ tannagarīyā bahavo lokā āsan|</para>
  <para style="p">
    <verse number="13" style="v"/>prabhustāṁ vilokya sānukampaḥ kathayāmāsa, mā rodīḥ| sa samīpamitvā khaṭvāṁ pasparśa tasmād vāhakāḥ sthagitāstamyuḥ;</para>
  <para style="p">
    <verse number="14" style="v"/>tadā sa uvāca he yuvamanuṣya tvamuttiṣṭha, tvāmaham ājñāpayāmi|</para>
  <para style="p">
    <verse number="15" style="v"/>tasmāt sa mṛto janastatkṣaṇamutthāya kathāṁ prakathitaḥ; tato yīśustasya mātari taṁ samarpayāmāsa|</para>
  <para style="p">
    <verse number="16" style="v"/>tasmāt sarvve lokāḥ śaśaṅkire; eko mahābhaviṣyadvādī madhye'smākam samudait, īśvaraśca svalokānanvagṛhlāt kathāmimāṁ kathayitvā īśvaraṁ dhanyaṁ jagaduḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>tataḥ paraṁ samastaṁ yihūdādeśaṁ tasya caturdiksthadeśañca tasyaitatkīrtti rvyānaśe|</para>
  <para style="p">
    <verse number="18" style="v"/>tataḥ paraṁ yohanaḥ śiṣyeṣu taṁ tadvṛttāntaṁ jñāpitavatsu</para>
  <para style="p">
    <verse number="19" style="v"/>sa svaśiṣyāṇāṁ dvau janāvāhūya yīśuṁ prati vakṣyamāṇaṁ vākyaṁ vaktuṁ preṣayāmāsa, yasyāgamanam apekṣya tiṣṭhāmo vayaṁ kiṁ sa eva janastvaṁ? kiṁ vayamanyamapekṣya sthāsyāmaḥ?</para>
  <para style="p">
    <verse number="20" style="v"/>paścāttau mānavau gatvā kathayāmāsatuḥ, yasyāgamanam apekṣya tiṣṭhāmo vayaṁ, kiṁ saeva janastvaṁ? kiṁ vayamanyamapekṣya sthāsyāmaḥ? kathāmimāṁ tubhyaṁ kathayituṁ yohan majjaka āvāṁ preṣitavān|</para>
  <para style="p">
    <verse number="21" style="v"/>tasmin daṇḍe yīśūrogiṇo mahāvyādhimato duṣṭabhūtagrastāṁśca bahūn svasthān kṛtvā, anekāndhebhyaścakṣuṁṣi dattvā pratyuvāca,</para>
  <para style="p">
    <verse number="22" style="v"/>yuvāṁ vrajatam andhā netrāṇi khañjāścaraṇāni ca prāpnuvanti, kuṣṭhinaḥ pariṣkriyante, badhirāḥ śravaṇāni mṛtāśca jīvanāni prāpnuvanti, daridrāṇāṁ samīpeṣu susaṁvādaḥ pracāryyate, yaṁ prati vighnasvarūpohaṁ na bhavāmi sa dhanyaḥ,</para>
  <para style="p">
    <verse number="23" style="v"/>etāni yāni paśyathaḥ śṛṇuthaśca tāni yohanaṁ jñāpayatam|</para>
  <para style="p">
    <verse number="24" style="v"/>tayo rdūtayo rgatayoḥ sato ryohani sa lokān vaktumupacakrame, yūyaṁ madhyeprāntaraṁ kiṁ draṣṭuṁ niragamata? kiṁ vāyunā kampitaṁ naḍaṁ?</para>
  <para style="p">
    <verse number="25" style="v"/>yūyaṁ kiṁ draṣṭuṁ niragamata? kiṁ sūkṣmavastraparidhāyinaṁ kamapi naraṁ? kintu ye sūkṣmamṛduvastrāṇi paridadhati sūttamāni dravyāṇi bhuñjate ca te rājadhānīṣu tiṣṭhanti|</para>
  <para style="p">
    <verse number="26" style="v"/>tarhi yūyaṁ kiṁ draṣṭuṁ niragamata? kimekaṁ bhaviṣyadvādinaṁ? tadeva satyaṁ kintu sa pumān bhaviṣyadvādinopi śreṣṭha ityahaṁ yuṣmān vadāmi;</para>
  <para style="p">
    <verse number="27" style="v"/>paśya svakīyadūtantu tavāgra preṣayāmyahaṁ| gatvā tvadīyamārgantu sa hi pariṣkariṣyati| yadarthe lipiriyam āste sa eva yohan|</para>
  <para style="p">
    <verse number="28" style="v"/>ato yuṣmānahaṁ vadāmi striyā garbbhajātānāṁ bhaviṣyadvādināṁ madhye yohano majjakāt śreṣṭhaḥ kopi nāsti, tatrāpi īśvarasya rājye yaḥ sarvvasmāt kṣudraḥ sa yohanopi śreṣṭhaḥ|</para>
  <para style="p">
    <verse number="29" style="v"/>aparañca sarvve lokāḥ karamañcāyinaśca tasya vākyāni śrutvā yohanā majjanena majjitāḥ parameśvaraṁ nirdoṣaṁ menire|</para>
  <para style="p">
    <verse number="30" style="v"/>kintu phirūśino vyavasthāpakāśca tena na majjitāḥ svān pratīśvarasyopadeśaṁ niṣphalam akurvvan|</para>
  <para style="p">
    <verse number="31" style="v"/>atha prabhuḥ kathayāmāsa, idānīntanajanān kenopamāmi? te kasya sadṛśāḥ?</para>
  <para style="p">
    <verse number="32" style="v"/>ye bālakā vipaṇyām upaviśya parasparam āhūya vākyamidaṁ vadanti, vayaṁ yuṣmākaṁ nikaṭe vaṁśīravādiṣma, kintu yūyaṁ nānarttiṣṭa, vayaṁ yuṣmākaṁ nikaṭa arodiṣma, kintu yuyaṁ na vyalapiṣṭa, bālakairetādṛśaisteṣām upamā bhavati|</para>
  <para style="p">
    <verse number="33" style="v"/>yato yohan majjaka āgatya pūpaṁ nākhādat drākṣārasañca nāpivat tasmād yūyaṁ vadatha, bhūtagrastoyam|</para>
  <para style="p">
    <verse number="34" style="v"/>tataḥ paraṁ mānavasuta āgatyākhādadapivañca tasmād yūyaṁ vadatha, khādakaḥ surāpaścāṇḍālapāpināṁ bandhureko jano dṛśyatām|</para>
  <para style="p">
    <verse number="35" style="v"/>kintu jñānino jñānaṁ nirdoṣaṁ viduḥ|</para>
  <para style="p">
    <verse number="36" style="v"/>paścādekaḥ phirūśī yīśuṁ bhojanāya nyamantrayat tataḥ sa tasya gṛhaṁ gatvā bhoktumupaviṣṭaḥ|</para>
  <para style="p">
    <verse number="37" style="v"/>etarhi tatphirūśino gṛhe yīśu rbhektum upāvekṣīt tacchrutvā tannagaravāsinī kāpi duṣṭā nārī pāṇḍaraprastarasya sampuṭake sugandhitailam ānīya</para>
  <para style="p">
    <verse number="38" style="v"/>tasya paścāt pādayoḥ sannidhau tasyau rudatī ca netrāmbubhistasya caraṇau prakṣālya nijakacairamārkṣīt, tatastasya caraṇau cumbitvā tena sugandhitailena mamarda|</para>
  <para style="p">
    <verse number="39" style="v"/>tasmāt sa nimantrayitā phirūśī manasā cintayāmāsa, yadyayaṁ bhaviṣyadvādī bhavet tarhi enaṁ spṛśati yā strī sā kā kīdṛśī ceti jñātuṁ śaknuyāt yataḥ sā duṣṭā|</para>
  <para style="p">
    <verse number="40" style="v"/>tadā yāśustaṁ jagāda, he śimon tvāṁ prati mama kiñcid vaktavyamasti; tasmāt sa babhāṣe, he guro tad vadatu|</para>
  <para style="p">
    <verse number="41" style="v"/>ekottamarṇasya dvāvadhamarṇāvāstāṁ, tayorekaḥ pañcaśatāni mudrāpādān aparaśca pañcāśat mudrāpādān dhārayāmāsa|</para>
  <para style="p">
    <verse number="42" style="v"/>tadanantaraṁ tayoḥ śodhyābhāvāt sa uttamarṇastayo rṛṇe cakṣame; tasmāt tayordvayoḥ kastasmin preṣyate bahu? tad brūhi|</para>
  <para style="p">
    <verse number="43" style="v"/>śimon pratyuvāca, mayā budhyate yasyādhikam ṛṇaṁ cakṣame sa iti; tato yīśustaṁ vyājahāra, tvaṁ yathārthaṁ vyacārayaḥ|</para>
  <para style="p">
    <verse number="44" style="v"/>atha tāṁ nārīṁ prati vyāghuṭhya śimonamavocat, strīmimāṁ paśyasi? tava gṛhe mayyāgate tvaṁ pādaprakṣālanārthaṁ jalaṁ nādāḥ kintu yoṣideṣā nayanajalai rmama pādau prakṣālya keśairamārkṣīt|</para>
  <para style="p">
    <verse number="45" style="v"/>tvaṁ māṁ nācumbīḥ kintu yoṣideṣā svīyāgamanādārabhya madīyapādau cumbituṁ na vyaraṁsta|</para>
  <para style="p">
    <verse number="46" style="v"/>tvañca madīyottamāṅge kiñcidapi tailaṁ nāmardīḥ kintu yoṣideṣā mama caraṇau sugandhitailenāmarddīt|</para>
  <para style="p">
    <verse number="47" style="v"/>atastvāṁ vyāharāmi, etasyā bahu pāpamakṣamyata tato bahu prīyate kintu yasyālpapāpaṁ kṣamyate solpaṁ prīyate|</para>
  <para style="p">
    <verse number="48" style="v"/>tataḥ paraṁ sa tāṁ babhāṣe, tvadīyaṁ pāpamakṣamyata|</para>
  <para style="p">
    <verse number="49" style="v"/>tadā tena sārddhaṁ ye bhoktum upaviviśuste parasparaṁ vaktumārebhire, ayaṁ pāpaṁ kṣamate ka eṣaḥ?</para>
  <para style="p">
    <verse number="50" style="v"/>kintu sa tāṁ nārīṁ jagāda, tava viśvāsastvāṁ paryyatrāsta tvaṁ kṣemeṇa vraja|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparañca yīśu rdvādaśabhiḥ śiṣyaiḥ sārddhaṁ nānānagareṣu nānāgrāmeṣu ca gacchan iśvarīyarājatvasya susaṁvādaṁ pracārayituṁ prārebhe|</para>
  <para style="p">
    <verse number="2" style="v"/>tadā yasyāḥ sapta bhūtā niragacchan sā magdalīnīti vikhyātā mariyam herodrājasya gṛhādhipateḥ hoṣe rbhāryyā yohanā śūśānā</para>
  <para style="p">
    <verse number="3" style="v"/>prabhṛtayo yā bahvyaḥ striyaḥ duṣṭabhūtebhyo rogebhyaśca muktāḥ satyo nijavibhūtī rvyayitvā tamasevanta, tāḥ sarvvāstena sārddham āsan|</para>
  <para style="p">
    <verse number="4" style="v"/>anantaraṁ nānānagarebhyo bahavo lokā āgatya tasya samīpe'milan, tadā sa tebhya ekāṁ dṛṣṭāntakathāṁ kathayāmāsa| ekaḥ kṛṣībalo bījāni vaptuṁ bahirjagāma,</para>
  <para style="p">
    <verse number="5" style="v"/>tato vapanakāle katipayāni bījāni mārgapārśve petuḥ, tatastāni padatalai rdalitāni pakṣibhi rbhakṣitāni ca|</para>
  <para style="p">
    <verse number="6" style="v"/>katipayāni bījāni pāṣāṇasthale patitāni yadyapi tānyaṅkuritāni tathāpi rasābhāvāt śuśuṣuḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>katipayāni bījāni kaṇṭakivanamadhye patitāni tataḥ kaṇṭakivanāni saṁvṛddhya tāni jagrasuḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>tadanyāni katipayabījāni ca bhūmyāmuttamāyāṁ petustatastānyaṅkurayitvā śataguṇāni phalāni pheluḥ| sa imā kathāṁ kathayitvā proccaiḥ provāca, yasya śrotuṁ śrotre staḥ sa śṛṇotu|</para>
  <para style="p">
    <verse number="9" style="v"/>tataḥ paraṁ śiṣyāstaṁ papracchurasya dṛṣṭāntasya kiṁ tātparyyaṁ?</para>
  <para style="p">
    <verse number="10" style="v"/>tataḥ sa vyājahāra, īśvarīyarājyasya guhyāni jñātuṁ yuṣmabhyamadhikāro dīyate kintvanye yathā dṛṣṭvāpi na paśyanti śrutvāpi ma budhyante ca tadarthaṁ teṣāṁ purastāt tāḥ sarvvāḥ kathā dṛṣṭāntena kathyante|</para>
  <para style="p">
    <verse number="11" style="v"/>dṛṣṭāntasyāsyābhiprāyaḥ, īśvarīyakathā bījasvarūpā|</para>
  <para style="p">
    <verse number="12" style="v"/>ye kathāmātraṁ śṛṇvanti kintu paścād viśvasya yathā paritrāṇaṁ na prāpnuvanti tadāśayena śaitānetya hṛdayātṛ tāṁ kathām apaharati ta eva mārgapārśvasthabhūmisvarūpāḥ|</para>
  <para style="p">
    <verse number="13" style="v"/>ye kathaṁ śrutvā sānandaṁ gṛhlanti kintvabaddhamūlatvāt svalpakālamātraṁ pratītya parīkṣākāle bhraśyanti taeva pāṣāṇabhūmisvarūpāḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>ye kathāṁ śrutvā yānti viṣayacintāyāṁ dhanalobhena eेhikasukhe ca majjanta upayuktaphalāni na phalanti ta evoptabījakaṇṭakibhūsvarūpāḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>kintu ye śrutvā saralaiḥ śuddhaiścāntaḥkaraṇaiḥ kathāṁ gṛhlanti dhairyyam avalambya phalānyutpādayanti ca ta evottamamṛtsvarūpāḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>aparañca pradīpaṁ prajvālya kopi pātreṇa nācchādayati tathā khaṭvādhopi na sthāpayati, kintu dīpādhāroparyyeva sthāpayati, tasmāt praveśakā dīptiṁ paśyanti|</para>
  <para style="p">
    <verse number="17" style="v"/>yanna prakāśayiṣyate tādṛg aprakāśitaṁ vastu kimapi nāsti yacca na suvyaktaṁ pracārayiṣyate tādṛg gṛptaṁ vastu kimapi nāsti|</para>
  <para style="p">
    <verse number="18" style="v"/>ato yūyaṁ kena prakāreṇa śṛṇutha tatra sāvadhānā bhavata, yasya samīpe barddhate tasmai punardāsyate kintu yasyāśraye na barddhate tasya yadyadasti tadapi tasmāt neṣyate|</para>
  <para style="p">
    <verse number="19" style="v"/>aparañca yīśo rmātā bhrātaraśca tasya samīpaṁ jigamiṣavaḥ</para>
  <para style="p">
    <verse number="20" style="v"/>kintu janatāsambādhāt tatsannidhiṁ prāptuṁ na śekuḥ| tatpaścāt tava mātā bhrātaraśca tvāṁ sākṣāt cikīrṣanto bahistiṣṭhanatīti vārttāyāṁ tasmai kathitāyāṁ</para>
  <para style="p">
    <verse number="21" style="v"/>sa pratyuvāca; ye janā īśvarasya kathāṁ śrutvā tadanurūpamācaranti taeva mama mātā bhrātaraśca|</para>
  <para style="p">
    <verse number="22" style="v"/>anantaraṁ ekadā yīśuḥ śiṣyaiḥ sārddhaṁ nāvamāruhya jagāda, āyāta vayaṁ hradasya pāraṁ yāmaḥ, tataste jagmuḥ|</para>
  <para style="p">
    <verse number="23" style="v"/>teṣu naukāṁ vāhayatsu sa nidadrau;</para>
  <para style="p">
    <verse number="24" style="v"/>athākasmāt prabalajhañbhśagamād hrade naukāyāṁ taraṅgairācchannāyāṁ vipat tān jagrāsa|tasmād yīśorantikaṁ gatvā he guro he guro prāṇā no yāntīti gaditvā taṁ jāgarayāmbabhūvuḥ|tadā sa utthāya vāyuṁ taraṅgāṁśca tarjayāmāsa tasmādubhau nivṛtya sthirau babhūvatuḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>sa tān babhāṣe yuṣmākaṁ viśvāsaḥ ka? tasmātte bhītā vismitāśca parasparaṁ jagaduḥ, aho kīdṛgayaṁ manujaḥ pavanaṁ pānīyañcādiśati tadubhayaṁ tadādeśaṁ vahati|</para>
  <para style="p">
    <verse number="26" style="v"/>tataḥ paraṁ gālīlpradeśasya sammukhasthagiderīyapradeśe naukāyāṁ lagantyāṁ taṭe'varohamāvād</para>
  <para style="p">
    <verse number="27" style="v"/>bahutithakālaṁ bhūtagrasta eko mānuṣaḥ purādāgatya taṁ sākṣāccakāra| sa manuṣo vāso na paridadhat gṛhe ca na vasan kevalaṁ śmaśānam adhyuvāsa|</para>
  <para style="p">
    <verse number="28" style="v"/>sa yīśuṁ dṛṣṭvaiva cīcchabdaṁ cakāra tasya sammukhe patitvā proccairjagāda ca, he sarvvapradhāneśvarasya putra, mayā saha tava kaḥ sambandhaḥ? tvayi vinayaṁ karomi māṁ mā yātaya|</para>
  <para style="p">
    <verse number="29" style="v"/>yataḥ sa taṁ mānuṣaṁ tyaktvā yātum amedhyabhūtam ādideśa; sa bhūtastaṁ mānuṣam asakṛd dadhāra tasmāllokāḥ śṛṅkhalena nigaḍena ca babandhuḥ; sa tad bhaṁktvā bhūtavaśatvāt madhyeprāntaraṁ yayau|</para>
  <para style="p">
    <verse number="30" style="v"/>anantaraṁ yīśustaṁ papraccha tava kinnāma? sa uvāca, mama nāma bāhino yato bahavo bhūtāstamāśiśriyuḥ|</para>
  <para style="p">
    <verse number="31" style="v"/>atha bhūtā vinayena jagaduḥ, gabhīraṁ garttaṁ gantuṁ mājñāpayāsmān|</para>
  <para style="p">
    <verse number="32" style="v"/>tadā parvvatopari varāhavrajaścarati tasmād bhūtā vinayena procuḥ, amuṁ varāhavrajam āśrayitum asmān anujānīhi; tataḥ sonujajñau|</para>
  <para style="p">
    <verse number="33" style="v"/>tataḥ paraṁ bhūtāstaṁ mānuṣaṁ vihāya varāhavrajam āśiśriyuḥ varāhavrajāśca tatkṣaṇāt kaṭakena dhāvanto hrade prāṇān vijṛhuḥ|</para>
  <para style="p">
    <verse number="34" style="v"/>tad dṛṣṭvā śūkararakṣakāḥ palāyamānā nagaraṁ grāmañca gatvā tatsarvvavṛttāntaṁ kathayāmāsuḥ|</para>
  <para style="p">
    <verse number="35" style="v"/>tataḥ kiṁ vṛttam etaddarśanārthaṁ lokā nirgatya yīśoḥ samīpaṁ yayuḥ, taṁ mānuṣaṁ tyaktabhūtaṁ parihitavastraṁ svasthamānuṣavad yīśoścaraṇasannidhau sūpaviśantaṁ vilokya bibhyuḥ|</para>
  <para style="p">
    <verse number="36" style="v"/>ye lokāstasya bhūtagrastasya svāsthyakaraṇaṁ dadṛśuste tebhyaḥ sarvvavṛttāntaṁ kathayāmāsuḥ|</para>
  <para style="p">
    <verse number="37" style="v"/>tadanantaraṁ tasya giderīyapradeśasya caturdiksthā bahavo janā atitrastā vinayena taṁ jagaduḥ, bhavān asmākaṁ nikaṭād vrajatu tasmāt sa nāvamāruhya tato vyāghuṭya jagāma|</para>
  <para style="p">
    <verse number="38" style="v"/>tadānīṁ tyaktabhūtamanujastena saha sthātuṁ prārthayāñcakre</para>
  <para style="p">
    <verse number="39" style="v"/>kintu tadartham īśvaraḥ kīdṛṅmahākarmma kṛtavān iti niveśanaṁ gatvā vijñāpaya, yīśuḥ kathāmetāṁ kathayitvā taṁ visasarja| tataḥ sa vrajitvā yīśustadarthaṁ yanmahākarmma cakāra tat purasya sarvvatra prakāśayituṁ prārebhe|</para>
  <para style="p">
    <verse number="40" style="v"/>atha yīśau parāvṛtyāgate lokāstaṁ ādareṇa jagṛhu ryasmātte sarvve tamapekṣāñcakrire|</para>
  <para style="p">
    <verse number="41" style="v"/>tadanantaraṁ yāyīrnāmno bhajanagehasyaikodhipa āgatya yīśoścaraṇayoḥ patitvā svaniveśanāgamanārthaṁ tasmin vinayaṁ cakāra,</para>
  <para style="p">
    <verse number="42" style="v"/>yatastasya dvādaśavarṣavayaskā kanyaikāsīt sā mṛtakalpābhavat| tatastasya gamanakāle mārge lokānāṁ mahān samāgamo babhūva|</para>
  <para style="p">
    <verse number="43" style="v"/>dvādaśavarṣāṇi pradararogagrastā nānā vaidyaiścikitsitā sarvvasvaṁ vyayitvāpi svāsthyaṁ na prāptā yā yoṣit sā yīśoḥ paścādāgatya tasya vastragranthiṁ pasparśa|</para>
  <para style="p">
    <verse number="44" style="v"/>tasmāt tatkṣaṇāt tasyā raktasrāvo ruddhaḥ|</para>
  <para style="p">
    <verse number="45" style="v"/>tadānīṁ yīśuravadat kenāhaṁ spṛṣṭaḥ? tato'nekairanaṅgīkṛte pitarastasya saṅginaścāvadan, he guro lokā nikaṭasthāḥ santastava dehe gharṣayanti, tathāpi kenāhaṁ spṛṣṭa̮iti bhavān kutaḥ pṛcchati?</para>
  <para style="p">
    <verse number="46" style="v"/>yīśuḥ kathayāmāsa, kenāpyahaṁ spṛṣṭo, yato mattaḥ śakti rnirgateti mayā niścitamajñāyi|</para>
  <para style="p">
    <verse number="47" style="v"/>tadā sā nārī svayaṁ na gupteti viditvā kampamānā satī tasya sammukhe papāta; yena nimittena taṁ pasparśa sparśamātrācca yena prakāreṇa svasthābhavat tat sarvvaṁ tasya sākṣādācakhyau|</para>
  <para style="p">
    <verse number="48" style="v"/>tataḥ sa tāṁ jagāda he kanye susthirā bhava, tava viśvāsastvāṁ svasthām akārṣīt tvaṁ kṣemeṇa yāhi|</para>
  <para style="p">
    <verse number="49" style="v"/>yīśoretadvākyavadanakāle tasyādhipate rniveśanāt kaścilloka āgatya taṁ babhāṣe, tava kanyā mṛtā guruṁ mā kliśāna|</para>
  <para style="p">
    <verse number="50" style="v"/>kintu yīśustadākarṇyādhipatiṁ vyājahāra, mā bhaiṣīḥ kevalaṁ viśvasihi tasmāt sā jīviṣyati|</para>
  <para style="p">
    <verse number="51" style="v"/>atha tasya niveśane prāpte sa pitaraṁ yohanaṁ yākūbañca kanyāyā mātaraṁ pitarañca vinā, anyaṁ kañcana praveṣṭuṁ vārayāmāsa|</para>
  <para style="p">
    <verse number="52" style="v"/>aparañca ye rudanti vilapanti ca tān sarvvān janān uvāca, yūyaṁ mā rodiṣṭa kanyā na mṛtā nidrāti|</para>
  <para style="p">
    <verse number="53" style="v"/>kintu sā niścitaṁ mṛteti jñātvā te tamupajahasuḥ|</para>
  <para style="p">
    <verse number="54" style="v"/>paścāt sa sarvvān bahiḥ kṛtvā kanyāyāḥ karau dhṛtvājuhuve, he kanye tvamuttiṣṭha,</para>
  <para style="p">
    <verse number="55" style="v"/>tasmāt tasyāḥ prāṇeṣu punarāgateṣu sā tatkṣaṇād uttasyau| tadānīṁ tasyai kiñcid bhakṣyaṁ dātum ādideśa|</para>
  <para style="p">
    <verse number="56" style="v"/>tatastasyāḥ pitarau vismayaṁ gatau kintu sa tāvādideśa ghaṭanāyā etasyāḥ kathāṁ kasmaicidapi mā kathayataṁ|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ paraṁ sa dvādaśaśiṣyānāhūya bhūtān tyājayituṁ rogān pratikarttuñca tebhyaḥ śaktimādhipatyañca dadau|</para>
  <para style="p">
    <verse number="2" style="v"/>aparañca īśvarīyarājyasya susaṁvādaṁ prakāśayitum rogiṇāmārogyaṁ karttuñca preraṇakāle tān jagāda|</para>
  <para style="p">
    <verse number="3" style="v"/>yātrārthaṁ yaṣṭi rvastrapuṭakaṁ bhakṣyaṁ mudrā dvitīyavastram, eṣāṁ kimapi mā gṛhlīta|</para>
  <para style="p">
    <verse number="4" style="v"/>yūyañca yanniveśanaṁ praviśatha nagaratyāgaparyyanataṁ tanniveśane tiṣṭhata|</para>
  <para style="p">
    <verse number="5" style="v"/>tatra yadi kasyacit purasya lokā yuṣmākamātithyaṁ na kurvvanti tarhi tasmānnagarād gamanakāle teṣāṁ viruddhaṁ sākṣyārthaṁ yuṣmākaṁ padadhūlīḥ sampātayata|</para>
  <para style="p">
    <verse number="6" style="v"/>atha te prasthāya sarvvatra susaṁvādaṁ pracārayituṁ pīḍitān svasthān karttuñca grāmeṣu bhramituṁ prārebhire|</para>
  <para style="p">
    <verse number="7" style="v"/>etarhi herod rājā yīśoḥ sarvvakarmmaṇāṁ vārttāṁ śrutvā bhṛśamudvivije</para>
  <para style="p">
    <verse number="8" style="v"/>yataḥ kecidūcuryohan śmaśānādudatiṣṭhat| kecidūcuḥ, eliyo darśanaṁ dattavān; evamanyalokā ūcuḥ pūrvvīyaḥ kaścid bhaviṣyadvādī samutthitaḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu heroduvāca yohanaḥ śiro'hamachinadam idānīṁ yasyedṛkkarmmaṇāṁ vārttāṁ prāpnomi sa kaḥ? atha sa taṁ draṣṭum aicchat|</para>
  <para style="p">
    <verse number="10" style="v"/>anantaraṁ preritāḥ pratyāgatya yāni yāni karmmāṇi cakrustāni yīśave kathayāmāsuḥ tataḥ sa tān baitsaidānāmakanagarasya vijanaṁ sthānaṁ nītvā guptaṁ jagāma|</para>
  <para style="p">
    <verse number="11" style="v"/>paścāl lokāstad viditvā tasya paścād yayuḥ; tataḥ sa tān nayan īśvarīyarājyasya prasaṅgamuktavān, yeṣāṁ cikitsayā prayojanam āsīt tān svasthān cakāra ca|</para>
  <para style="p">
    <verse number="12" style="v"/>aparañca divāvasanne sati dvādaśaśiṣyā yīśorantikam etya kathayāmāsuḥ, vayamatra prāntarasthāne tiṣṭhāmaḥ, tato nagarāṇi grāmāṇi gatvā vāsasthānāni prāpya bhakṣyadravyāṇi kretuṁ jananivahaṁ bhavān visṛjatu|</para>
  <para style="p">
    <verse number="13" style="v"/>tadā sa uvāca, yūyameva tān bhejayadhvaṁ; tataste procurasmākaṁ nikaṭe kevalaṁ pañca pūpā dvau matsyau ca vidyante, ataeva sthānāntaram itvā nimittameteṣāṁ bhakṣyadravyeṣu na krīteṣu na bhavati|</para>
  <para style="p">
    <verse number="14" style="v"/>tatra prāyeṇa pañcasahasrāṇi puruṣā āsan|</para>
  <para style="p">
    <verse number="15" style="v"/>tadā sa śiṣyān jagāda pañcāśat pañcāśajjanaiḥ paṁktīkṛtya tānupaveśayata, tasmāt te tadanusāreṇa sarvvalokānupaveśayāpāsuḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>tataḥ sa tān pañca pūpān mīnadvayañca gṛhītvā svargaṁ vilokyeśvaraguṇān kīrttayāñcakre bhaṅktā ca lokebhyaḥ pariveṣaṇārthaṁ śiṣyeṣu samarpayāmbabhūva|</para>
  <para style="p">
    <verse number="17" style="v"/>tataḥ sarvve bhuktvā tṛptiṁ gatā avaśiṣṭānāñca dvādaśa ḍallakān saṁjagṛhuḥ|</para>
  <para style="p">
    <verse number="18" style="v"/>athaikadā nirjane śiṣyaiḥ saha prārthanākāle tān papraccha, lokā māṁ kaṁ vadanti?</para>
  <para style="p">
    <verse number="19" style="v"/>tataste prācuḥ, tvāṁ yohanmajjakaṁ vadanti; kecit tvām eliyaṁ vadanti, pūrvvakālikaḥ kaścid bhaviṣyadvādī śmaśānād udatiṣṭhad ityapi kecid vadanti|</para>
  <para style="p">
    <verse number="20" style="v"/>tadā sa uvāca, yūyaṁ māṁ kaṁ vadatha? tataḥ pitara uktavān tvam īśvarābhiṣiktaḥ puruṣaḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā sa tān dṛḍhamādideśa, kathāmetāṁ kasmaicidapi mā kathayata|</para>
  <para style="p">
    <verse number="22" style="v"/>sa punaruvāca, manuṣyaputreṇa vahuyātanā bhoktavyāḥ prācīnalokaiḥ pradhānayājakairadhyāpakaiśca sovajñāya hantavyaḥ kintu tṛtīyadivase śmaśānāt tenotthātavyam|</para>
  <para style="p">
    <verse number="23" style="v"/>aparaṁ sa sarvvānuvāca, kaścid yadi mama paścād gantuṁ vāñchati tarhi sa svaṁ dāmyatu, dine dine kruśaṁ gṛhītvā ca mama paścādāgacchatu|</para>
  <para style="p">
    <verse number="24" style="v"/>yato yaḥ kaścit svaprāṇān rirakṣiṣati sa tān hārayiṣyati, yaḥ kaścin madarthaṁ prāṇān hārayiṣyati sa tān rakṣiṣyati|</para>
  <para style="p">
    <verse number="25" style="v"/>kaścid yadi sarvvaṁ jagat prāpnoti kintu svaprāṇān hārayati svayaṁ vinaśyati ca tarhi tasya ko lābhaḥ?</para>
  <para style="p">
    <verse number="26" style="v"/>puna ryaḥ kaścin māṁ mama vākyaṁ vā lajjāspadaṁ jānāti manuṣyaputro yadā svasya pituśca pavitrāṇāṁ dūtānāñca tejobhiḥ pariveṣṭita āgamiṣyati tadā sopi taṁ lajjāspadaṁ jñāsyati|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu yuṣmānahaṁ yathārthaṁ vadāmi, īśvarīyarājatvaṁ na dṛṣṭavā mṛtyuṁ nāsvādiṣyante, etādṛśāḥ kiyanto lokā atra sthane'pi daṇḍāyamānāḥ santi|</para>
  <para style="p">
    <verse number="28" style="v"/>etadākhyānakathanāt paraṁ prāyeṇāṣṭasu dineṣu gateṣu sa pitaraṁ yohanaṁ yākūbañca gṛhītvā prārthayituṁ parvvatamekaṁ samāruroha|</para>
  <para style="p">
    <verse number="29" style="v"/>atha tasya prārthanakāle tasya mukhākṛtiranyarūpā jātā, tadīyaṁ vastramujjvalaśuklaṁ jātaṁ|</para>
  <para style="p">
    <verse number="30" style="v"/>aparañca mūsā eliyaścobhau tejasvinau dṛṣṭau</para>
  <para style="p">
    <verse number="31" style="v"/>tau tena yirūśālampure yo mṛtyuḥ sādhiṣyate tadīyāṁ kathāṁ tena sārddhaṁ kathayitum ārebhāte|</para>
  <para style="p">
    <verse number="32" style="v"/>tadā pitarādayaḥ svasya saṅgino nidrayākṛṣṭā āsan kintu jāgaritvā tasya tejastena sārddham uttiṣṭhantau janau ca dadṛśuḥ|</para>
  <para style="p">
    <verse number="33" style="v"/>atha tayorubhayo rgamanakāle pitaro yīśuṁ babhāṣe, he guro'smākaṁ sthāne'smin sthitiḥ śubhā, tata ekā tvadarthā, ekā mūsārthā, ekā eliyārthā, iti tisraḥ kuṭyosmābhi rnirmmīyantāṁ, imāṁ kathāṁ sa na vivicya kathayāmāsa|</para>
  <para style="p">
    <verse number="34" style="v"/>aparañca tadvākyavadanakāle payoda eka āgatya teṣāmupari chāyāṁ cakāra, tatastanmadhye tayoḥ praveśāt te śaśaṅkire|</para>
  <para style="p">
    <verse number="35" style="v"/>tadā tasmāt payodād iyamākāśīyā vāṇī nirjagāma, mamāyaṁ priyaḥ putra etasya kathāyāṁ mano nidhatta|</para>
  <para style="p">
    <verse number="36" style="v"/>iti śabde jāte te yīśumekākinaṁ dadṛśuḥ kintu te tadānīṁ tasya darśanasya vācamekāmapi noktvā manaḥsu sthāpayāmāsuḥ|</para>
  <para style="p">
    <verse number="37" style="v"/>pare'hani teṣu tasmācchailād avarūḍheṣu taṁ sākṣāt karttuṁ bahavo lokā ājagmuḥ|</para>
  <para style="p">
    <verse number="38" style="v"/>teṣāṁ madhyād eko jana uccairuvāca, he guro ahaṁ vinayaṁ karomi mama putraṁ prati kṛpādṛṣṭiṁ karotu, mama sa evaikaḥ putraḥ|</para>
  <para style="p">
    <verse number="39" style="v"/>bhūtena dhṛtaḥ san saṁ prasabhaṁ cīcchabdaṁ karoti tanmukhāt pheṇā nirgacchanti ca, bhūta itthaṁ vidāryya kliṣṭvā prāyaśastaṁ na tyajati|</para>
  <para style="p">
    <verse number="40" style="v"/>tasmāt taṁ bhūtaṁ tyājayituṁ tava śiṣyasamīpe nyavedayaṁ kintu te na śekuḥ|</para>
  <para style="p">
    <verse number="41" style="v"/>tadā yīśuravādīt, re āviśvāsin vipathagāmin vaṁśa katikālān yuṣmābhiḥ saha sthāsyāmyahaṁ yuṣmākam ācaraṇāni ca sahiṣye? tava putramihānaya|</para>
  <para style="p">
    <verse number="42" style="v"/>tatastasminnāgatamātre bhūtastaṁ bhūmau pātayitvā vidadāra; tadā yīśustamamedhyaṁ bhūtaṁ tarjayitvā bālakaṁ svasthaṁ kṛtvā tasya pitari samarpayāmāsa|</para>
  <para style="p">
    <verse number="43" style="v"/>īśvarasya mahāśaktim imāṁ vilokya sarvve camaccakruḥ; itthaṁ yīśoḥ sarvvābhiḥ kriyābhiḥ sarvvairlokairāścaryye manyamāne sati sa śiṣyān babhāṣe,</para>
  <para style="p">
    <verse number="44" style="v"/>katheyaṁ yuṣmākaṁ karṇeṣu praviśatu, manuṣyaputro manuṣyāṇāṁ kareṣu samarpayiṣyate|</para>
  <para style="p">
    <verse number="45" style="v"/>kintu te tāṁ kathāṁ na bubudhire, spaṣṭatvābhāvāt tasyā abhiprāyasteṣāṁ bodhagamyo na babhūva; tasyā āśayaḥ ka ityapi te bhayāt praṣṭuṁ na śekuḥ|</para>
  <para style="p">
    <verse number="46" style="v"/>tadanantaraṁ teṣāṁ madhye kaḥ śreṣṭhaḥ kathāmetāṁ gṛhītvā te mitho vivādaṁ cakruḥ|</para>
  <para style="p">
    <verse number="47" style="v"/>tato yīśusteṣāṁ manobhiprāyaṁ viditvā bālakamekaṁ gṛhītvā svasya nikaṭe sthāpayitvā tān jagāda,</para>
  <para style="p">
    <verse number="48" style="v"/>yo jano mama nāmnāsya bālāsyātithyaṁ vidadhāti sa mamātithyaṁ vidadhāti, yaśca mamātithyaṁ vidadhāti sa mama prerakasyātithyaṁ vidadhāti, yuṣmākaṁ madhyeyaḥ svaṁ sarvvasmāt kṣudraṁ jānīte sa eva śreṣṭho bhaviṣyati|</para>
  <para style="p">
    <verse number="49" style="v"/>aparañca yohan vyājahāra he prabheा tava nāmnā bhūtān tyājayantaṁ mānuṣam ekaṁ dṛṣṭavanto vayaṁ, kintvasmākam apaścād gāmitvāt taṁ nyaṣedhām| tadānīṁ yīśuruvāca,</para>
  <para style="p">
    <verse number="50" style="v"/>taṁ mā niṣedhata, yato yo janosmākaṁ na vipakṣaḥ sa evāsmākaṁ sapakṣo bhavati|</para>
  <para style="p">
    <verse number="51" style="v"/>anantaraṁ tasyārohaṇasamaya upasthite sa sthiracetā yirūśālamaṁ prati yātrāṁ karttuṁ niścityāgre dūtān preṣayāmāsa|</para>
  <para style="p">
    <verse number="52" style="v"/>tasmāt te gatvā tasya prayojanīyadravyāṇi saṁgrahītuṁ śomiroṇīyānāṁ grāmaṁ praviviśuḥ|</para>
  <para style="p">
    <verse number="53" style="v"/>kintu sa yirūśālamaṁ nagaraṁ yāti tato heto rlokāstasyātithyaṁ na cakruḥ|</para>
  <para style="p">
    <verse number="54" style="v"/>ataeva yākūbyohanau tasya śiṣyau tad dṛṣṭvā jagadatuḥ, he prabho eliyo yathā cakāra tathā vayamapi kiṁ gagaṇād āgantum etān bhasmīkarttuñca vahnimājñāpayāmaḥ? bhavān kimicchati?</para>
  <para style="p">
    <verse number="55" style="v"/>kintu sa mukhaṁ parāvartya tān tarjayitvā gaditavān yuṣmākaṁ manobhāvaḥ kaḥ, iti yūyaṁ na jānītha|</para>
  <para style="p">
    <verse number="56" style="v"/>manujasuto manujānāṁ prāṇān nāśayituṁ nāgacchat, kintu rakṣitum āgacchat| paścād itaragrāmaṁ te yayuḥ|</para>
  <para style="p">
    <verse number="57" style="v"/>tadanantaraṁ pathi gamanakāle jana ekastaṁ babhāṣe, he prabho bhavān yatra yāti bhavatā sahāhamapi tatra yāsyāmi|</para>
  <para style="p">
    <verse number="58" style="v"/>tadānīṁ yīśustamuvāca, gomāyūnāṁ garttā āsate, vihāyasīyavihagāाnāṁ nīḍāni ca santi, kintu mānavatanayasya śiraḥ sthāpayituṁ sthānaṁ nāsti|</para>
  <para style="p">
    <verse number="59" style="v"/>tataḥ paraṁ sa itarajanaṁ jagāda, tvaṁ mama paścād ehi; tataḥ sa uvāca, he prabho pūrvvaṁ pitaraṁ śmaśāne sthāpayituṁ māmādiśatu|</para>
  <para style="p">
    <verse number="60" style="v"/>tadā yīśuruvāca, mṛtā mṛtān śmaśāne sthāpayantu kintu tvaṁ gatveśvarīyarājyasya kathāṁ pracāraya|</para>
  <para style="p">
    <verse number="61" style="v"/>tatonyaḥ kathayāmāsa, he prabho mayāpi bhavataḥ paścād gaṁsyate, kintu pūrvvaṁ mama niveśanasya parijanānām anumatiṁ grahītum ahamādiśyai bhavatā|</para>
  <para style="p">
    <verse number="62" style="v"/>tadānīṁ yīśustaṁ proktavān, yo jano lāṅgale karamarpayitvā paścāt paśyati sa īśvarīyarājyaṁ nārhati|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ paraṁ prabhuraparān saptatiśiṣyān niyujya svayaṁ yāni nagarāṇi yāni sthānāni ca gamiṣyati tāni nagarāṇi tāni sthānāni ca prati dvau dvau janau prahitavān|</para>
  <para style="p">
    <verse number="2" style="v"/>tebhyaḥ kathayāmāsa ca śasyāni bahūnīti satyaṁ kintu chedakā alpe; tasmāddhetoḥ śasyakṣetre chedakān aparānapi preṣayituṁ kṣetrasvāminaṁ prārthayadhvaṁ|</para>
  <para style="p">
    <verse number="3" style="v"/>yūyaṁ yāta, paśyata, vṛkāṇāṁ madhye meṣaśāvakāniva yuṣmān prahiṇomi|</para>
  <para style="p">
    <verse number="4" style="v"/>yūyaṁ kṣudraṁ mahad vā vasanasampuṭakaṁ pādukāśca mā gṛhlīta, mārgamadhye kamapi mā namata ca|</para>
  <para style="p">
    <verse number="5" style="v"/>aparañca yūyaṁ yad yat niveśanaṁ praviśatha tatra niveśanasyāsya maṅgalaṁ bhūyāditi vākyaṁ prathamaṁ vadata|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmāt tasmin niveśane yadi maṅgalapātraṁ sthāsyati tarhi tanmaṅgalaṁ tasya bhaviṣyati, nocet yuṣmān prati parāvarttiṣyate|</para>
  <para style="p">
    <verse number="7" style="v"/>aparañca te yatkiñcid dāsyanti tadeva bhuktvā pītvā tasminniveśane sthāsyatha; yataḥ karmmakārī jano bhṛtim arhati; gṛhād gṛhaṁ mā yāsyatha|</para>
  <para style="p">
    <verse number="8" style="v"/>anyacca yuṣmāsu kimapi nagaraṁ praviṣṭeṣu lokā yadi yuṣmākam ātithyaṁ kariṣyanti, tarhi yat khādyam upasthāsyanti tadeva khādiṣyatha|</para>
  <para style="p">
    <verse number="9" style="v"/>tannagarasthān rogiṇaḥ svasthān kariṣyatha, īśvarīyaṁ rājyaṁ yuṣmākam antikam āgamat kathāmetāñca pracārayiṣyatha|</para>
  <para style="p">
    <verse number="10" style="v"/>kintu kimapi puraṁ yuṣmāsu praviṣṭeṣu lokā yadi yuṣmākam ātithyaṁ na kariṣyanti, tarhi tasya nagarasya panthānaṁ gatvā kathāmetāṁ vadiṣyatha,</para>
  <para style="p">
    <verse number="11" style="v"/>yuṣmākaṁ nagarīyā yā dhūlyo'smāsu samalagan tā api yuṣmākaṁ prātikūlyena sākṣyārthaṁ sampātayāmaḥ; tathāpīśvararājyaṁ yuṣmākaṁ samīpam āgatam iti niścitaṁ jānīta|</para>
  <para style="p">
    <verse number="12" style="v"/>ahaṁ yuṣmabhyaṁ yathārthaṁ kathayāmi, vicāradine tasya nagarasya daśātaḥ sidomo daśā sahyā bhaviṣyati|</para>
  <para style="p">
    <verse number="13" style="v"/>hā hā korāsīn nagara, hā hā baitsaidānagara yuvayormadhye yādṛśāni āścaryyāṇi karmmāṇyakriyanta, tāni karmmāṇi yadi sorasīdono rnagarayorakāriṣyanta, tadā ito bahudinapūrvvaṁ tannivāsinaḥ śaṇavastrāṇi paridhāya gātreṣu bhasma vilipya samupaviśya samakhetsyanta|</para>
  <para style="p">
    <verse number="14" style="v"/>ato vicāradivase yuṣmākaṁ daśātaḥ sorasīdonnivāsināṁ daśā sahyā bhaviṣyati|</para>
  <para style="p">
    <verse number="15" style="v"/>he kapharnāhūm, tvaṁ svargaṁ yāvad unnatā kintu narakaṁ yāvat nyagbhaviṣyasi|</para>
  <para style="p">
    <verse number="16" style="v"/>yo jano yuṣmākaṁ vākyaṁ gṛhlāti sa mamaiva vākyaṁ gṛhlāti; kiñca yo jano yuṣmākam avajñāṁ karoti sa mamaivāvajñāṁ karoti; yo jano mamāvajñāṁ karoti ca sa matprerakasyaivāvajñāṁ karoti|</para>
  <para style="p">
    <verse number="17" style="v"/>atha te saptatiśiṣyā ānandena pratyāgatya kathayāmāsuḥ, he prabho bhavato nāmnā bhūtā apyasmākaṁ vaśībhavanti|</para>
  <para style="p">
    <verse number="18" style="v"/>tadānīṁ sa tān jagāda, vidyutamiva svargāt patantaṁ śaitānam adarśam|</para>
  <para style="p">
    <verse number="19" style="v"/>paśyata sarpān vṛścikān ripoḥ sarvvaparākramāṁśca padatalai rdalayituṁ yuṣmabhyaṁ śaktiṁ dadāmi tasmād yuṣmākaṁ kāpi hāni rna bhaviṣyati|</para>
  <para style="p">
    <verse number="20" style="v"/>bhūtā yuṣmākaṁ vaśībhavanti, etannimittat mā samullasata, svarge yuṣmākaṁ nāmāni likhitāni santīti nimittaṁ samullasata|</para>
  <para style="p">
    <verse number="21" style="v"/>tadghaṭikāyāṁ yīśu rmanasi jātāhlādaḥ kathayāmāsa he svargapṛthivyorekādhipate pitastvaṁ jñānavatāṁ viduṣāñca lokānāṁ purastāt sarvvametad aprakāśya bālakānāṁ purastāt prākāśaya etasmāddhetostvāṁ dhanyaṁ vadāmi, he pitaritthaṁ bhavatu yad etadeva tava gocara uttamam|</para>
  <para style="p">
    <verse number="22" style="v"/>pitrā sarvvāṇi mayi samarpitāni pitaraṁ vinā kopi putraṁ na jānāti kiñca putraṁ vinā yasmai janāya putrastaṁ prakāśitavān tañca vinā kopi pitaraṁ na jānāti|</para>
  <para style="p">
    <verse number="23" style="v"/>tapaḥ paraṁ sa śiṣyān prati parāvṛtya guptaṁ jagāda, yūyametāni sarvvāṇi paśyatha tato yuṣmākaṁ cakṣūṁṣi dhanyāni|</para>
  <para style="p">
    <verse number="24" style="v"/>yuṣmānahaṁ vadāmi, yūyaṁ yāni sarvvāṇi paśyatha tāni bahavo bhaviṣyadvādino bhūpatayaśca draṣṭumicchantopi draṣṭuṁ na prāpnuvan, yuṣmābhi ryā yāḥ kathāśca śrūyante tāḥ śrotumicchantopi śrotuṁ nālabhanta|</para>
  <para style="p">
    <verse number="25" style="v"/>anantaram eko vyavasthāpaka utthāya taṁ parīkṣituṁ papraccha, he upadeśaka anantāyuṣaḥ prāptaye mayā kiṁ karaṇīyaṁ?</para>
  <para style="p">
    <verse number="26" style="v"/>yīśuḥ pratyuvāca, atrārthe vyavasthāyāṁ kiṁ likhitamasti? tvaṁ kīdṛk paṭhasi?</para>
  <para style="p">
    <verse number="27" style="v"/>tataḥ sovadat, tvaṁ sarvvāntaḥkaraṇaiḥ sarvvaprāṇaiḥ sarvvaśaktibhiḥ sarvvacittaiśca prabhau parameśvare prema kuru, samīpavāsini svavat prema kuru ca|</para>
  <para style="p">
    <verse number="28" style="v"/>tadā sa kathayāmāsa, tvaṁ yathārthaṁ pratyavocaḥ, ittham ācara tenaiva jīviṣyasi|</para>
  <para style="p">
    <verse number="29" style="v"/>kintu sa janaḥ svaṁ nirddoṣaṁ jñāpayituṁ yīśuṁ papraccha, mama samīpavāsī kaḥ? tato yīśuḥ pratyuvāca,</para>
  <para style="p">
    <verse number="30" style="v"/>eko jano yirūśālampurād yirīhopuraṁ yāti, etarhi dasyūnāṁ kareṣu patite te tasya vastrādikaṁ hṛtavantaḥ tamāhatya mṛtaprāyaṁ kṛtvā tyaktvā yayuḥ|</para>
  <para style="p">
    <verse number="31" style="v"/>akasmād eko yājakastena mārgeṇa gacchan taṁ dṛṣṭvā mārgānyapārśvena jagāma|</para>
  <para style="p">
    <verse number="32" style="v"/>ittham eko levīyastatsthānaṁ prāpya tasyāntikaṁ gatvā taṁ vilokyānyena pārśvena jagāma|</para>
  <para style="p">
    <verse number="33" style="v"/>kintvekaḥ śomiroṇīyo gacchan tatsthānaṁ prāpya taṁ dṛṣṭvādayata|</para>
  <para style="p">
    <verse number="34" style="v"/>tasyāntikaṁ gatvā tasya kṣateṣu tailaṁ drākṣārasañca prakṣipya kṣatāni baddhvā nijavāhanopari tamupaveśya pravāsīyagṛham ānīya taṁ siṣeve|</para>
  <para style="p">
    <verse number="35" style="v"/>parasmin divase nijagamanakāle dvau mudrāpādau tadgṛhasvāmine dattvāvadat janamenaṁ sevasva tatra yo'dhiko vyayo bhaviṣyati tamahaṁ punarāgamanakāle pariśotsyāmi|</para>
  <para style="p">
    <verse number="36" style="v"/>eṣāṁ trayāṇāṁ madhye tasya dasyuhastapatitasya janasya samīpavāsī kaḥ? tvayā kiṁ budhyate?</para>
  <para style="p">
    <verse number="37" style="v"/>tataḥ sa vyavasthāpakaḥ kathayāmāsa yastasmin dayāṁ cakāra| tadā yīśuḥ kathayāmāsa tvamapi gatvā tathācara|</para>
  <para style="p">
    <verse number="38" style="v"/>tataḥ paraṁ te gacchanta ekaṁ grāmaṁ praviviśuḥ; tadā marthānāmā strī svagṛhe tasyātithyaṁ cakāra|</para>
  <para style="p">
    <verse number="39" style="v"/>tasmāt mariyam nāmadheyā tasyā bhaginī yīśoḥ padasamīpa uvaviśya tasyopadeśakathāṁ śrotumārebhe|</para>
  <para style="p">
    <verse number="40" style="v"/>kintu marthā nānāparicaryyāyāṁ vyagrā babhūva tasmāddhetostasya samīpamāgatya babhāṣe; he prabho mama bhaginī kevalaṁ mamopari sarvvakarmmaṇāṁ bhāram arpitavatī tatra bhavatā kiñcidapi na mano nidhīyate kim? mama sāhāyyaṁ karttuṁ bhavān tāmādiśatu|</para>
  <para style="p">
    <verse number="41" style="v"/>tato yīśuḥ pratyuvāca he marthe he marthe, tvaṁ nānākāryyeṣu cintitavatī vyagrā cāsi,</para>
  <para style="p">
    <verse number="42" style="v"/>kintu prayojanīyam ekamātram āste| aparañca yamuttamaṁ bhāgaṁ kopi harttuṁ na śaknoti saeva mariyamā vṛtaḥ|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ sa kasmiṁścit sthāne prārthayata tatsamāptau satyāṁ tasyaikaḥ śiṣyastaṁ jagāda he prabho yohan yathā svaśiṣyān prārthayitum upadiṣṭavān tathā bhavānapyasmān upadiśatu|</para>
  <para style="p">
    <verse number="2" style="v"/>tasmāt sa kathayāmāsa, prārthanakāle yūyam itthaṁ kathayadhvaṁ, he asmākaṁ svargasthapitastava nāma pūjyaṁ bhavatu; tava rājatvaṁ bhavatu; svarge yathā tathā pṛthivyāmapi tavecchayā sarvvaṁ bhavatu|</para>
  <para style="p">
    <verse number="3" style="v"/>pratyaham asmākaṁ prayojanīyaṁ bhojyaṁ dehi|</para>
  <para style="p">
    <verse number="4" style="v"/>yathā vayaṁ sarvvān aparādhinaḥ kṣamāmahe tathā tvamapi pāpānyasmākaṁ kṣamasva| asmān parīkṣāṁ mānaya kintu pāpātmano rakṣa|</para>
  <para style="p">
    <verse number="5" style="v"/>paścāt soparamapi kathitavān yadi yuṣmākaṁ kasyacid bandhustiṣṭhati niśīthe ca tasya samīpaṁ sa gatvā vadati,</para>
  <para style="p">
    <verse number="6" style="v"/>he bandho pathika eko bandhu rmama niveśanam āyātaḥ kintu tasyātithyaṁ karttuṁ mamāntike kimapi nāsti, ataeva pūpatrayaṁ mahyam ṛṇaṁ dehi;</para>
  <para style="p">
    <verse number="7" style="v"/>tadā sa yadi gṛhamadhyāt prativadati māṁ mā kliśāna, idānīṁ dvāraṁ ruddhaṁ śayane mayā saha bālakāśca tiṣṭhanti tubhyaṁ dātum utthātuṁ na śaknomi,</para>
  <para style="p">
    <verse number="8" style="v"/>tarhi yuṣmānahaṁ vadāmi, sa yadi mitratayā tasmai kimapi dātuṁ nottiṣṭhati tathāpi vāraṁ vāraṁ prārthanāta utthāpitaḥ san yasmin tasya prayojanaṁ tadeva dāsyati|</para>
  <para style="p">
    <verse number="9" style="v"/>ataḥ kāraṇāt kathayāmi, yācadhvaṁ tato yuṣmabhyaṁ dāsyate, mṛgayadhvaṁ tata uddeśaṁ prāpsyatha, dvāram āhata tato yuṣmabhyaṁ dvāraṁ mokṣyate|</para>
  <para style="p">
    <verse number="10" style="v"/>yo yācate sa prāpnoti, yo mṛgayate sa evoddeśaṁ prāpnoti, yo dvāram āhanti tadarthaṁ dvāraṁ mocyate|</para>
  <para style="p">
    <verse number="11" style="v"/>putreṇa pūpe yācite tasmai pāṣāṇaṁ dadāti vā matsye yācite tasmai sarpaṁ dadāti</para>
  <para style="p">
    <verse number="12" style="v"/>vā aṇḍe yācite tasmai vṛścikaṁ dadāti yuṣmākaṁ madhye ka etādṛśaḥ pitāste?</para>
  <para style="p">
    <verse number="13" style="v"/>tasmādeva yūyamabhadrā api yadi svasvabālakebhya uttamāni dravyāṇi dātuṁ jānītha tarhyasmākaṁ svargasthaḥ pitā nijayācakebhyaḥ kiṁ pavitram ātmānaṁ na dāsyati?</para>
  <para style="p">
    <verse number="14" style="v"/>anantaraṁ yīśunā kasmāccid ekasmin mūkabhūte tyājite sati sa bhūtatyakto mānuṣo vākyaṁ vaktum ārebhe; tato lokāḥ sakalā āścaryyaṁ menire|</para>
  <para style="p">
    <verse number="15" style="v"/>kintu teṣāṁ kecidūcu rjanoyaṁ bālasibūbā arthād bhūtarājena bhūtān tyājayati|</para>
  <para style="p">
    <verse number="16" style="v"/>taṁ parīkṣituṁ kecid ākāśīyam ekaṁ cihnaṁ darśayituṁ taṁ prārthayāñcakrire|</para>
  <para style="p">
    <verse number="17" style="v"/>tadā sa teṣāṁ manaḥkalpanāṁ jñātvā kathayāmāsa, kasyacid rājyasya lokā yadi parasparaṁ virundhanti tarhi tad rājyam naśyati; kecid gṛhasthā yadi parasparaṁ virundhanti tarhi tepi naśyanti|</para>
  <para style="p">
    <verse number="18" style="v"/>tathaiva śaitānapi svalokān yadi viruṇaddhi tadā tasya rājyaṁ kathaṁ sthāsyati? bālasibūbāhaṁ bhūtān tyājayāmi yūyamiti vadatha|</para>
  <para style="p">
    <verse number="19" style="v"/>yadyahaṁ bālasibūbā bhūtān tyājayāmi tarhi yuṣmākaṁ santānāḥ kena tyājayanti? tasmāt taeva kathāyā etasyā vicārayitāro bhaviṣyanti|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu yadyaham īśvarasya parākrameṇa bhūtān tyājayāmi tarhi yuṣmākaṁ nikaṭam īśvarasya rājyamavaśyam upatiṣṭhati|</para>
  <para style="p">
    <verse number="21" style="v"/>balavān pumān susajjamāno yatikālaṁ nijāṭṭālikāṁ rakṣati tatikālaṁ tasya dravyaṁ nirupadravaṁ tiṣṭhati|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu tasmād adhikabalaḥ kaścidāgatya yadi taṁ jayati tarhi yeṣu śastrāstreṣu tasya viśvāsa āsīt tāni sarvvāṇi hṛtvā tasya dravyāṇi gṛhlāti|</para>
  <para style="p">
    <verse number="23" style="v"/>ataḥ kāraṇād yo mama sapakṣo na sa vipakṣaḥ, yo mayā saha na saṁgṛhlāti sa vikirati|</para>
  <para style="p">
    <verse number="24" style="v"/>aparañca amedhyabhūto mānuṣasyāntarnirgatya śuṣkasthāne bhrāntvā viśrāmaṁ mṛgayate kintu na prāpya vadati mama yasmād gṛhād āgatohaṁ punastad gṛhaṁ parāvṛtya yāmi|</para>
  <para style="p">
    <verse number="25" style="v"/>tato gatvā tad gṛhaṁ mārjitaṁ śobhitañca dṛṣṭvā</para>
  <para style="p">
    <verse number="26" style="v"/>tatkṣaṇam apagatya svasmādapi durmmatīn aparān saptabhūtān sahānayati te ca tadgṛhaṁ paviśya nivasanti| tasmāt tasya manuṣyasya prathamadaśātaḥ śeṣadaśā duḥkhatarā bhavati|</para>
  <para style="p">
    <verse number="27" style="v"/>asyāḥ kathāyāḥ kathanakāle janatāmadhyasthā kācinnārī tamuccaiḥsvaraṁ provāca, yā yoṣit tvāṁ garbbhe'dhārayat stanyamapāyayacca saiva dhanyā|</para>
  <para style="p">
    <verse number="28" style="v"/>kintu sokathayat ye parameśvarasya kathāṁ śrutvā tadanurūpam ācaranti taeva dhanyāḥ|</para>
  <para style="p">
    <verse number="29" style="v"/>tataḥ paraṁ tasyāntike bahulokānāṁ samāgame jāte sa vaktumārebhe, ādhunikā duṣṭalokāścihnaṁ draṣṭumicchanti kintu yūnasbhaviṣyadvādinaścihnaṁ vinānyat kiñciccihnaṁ tān na darśayiṣyate|</para>
  <para style="p">
    <verse number="30" style="v"/>yūnas tu yathā nīnivīyalokānāṁ samīpe cihnarūpobhavat tathā vidyamānalokānām eṣāṁ samīpe manuṣyaputropi cihnarūpo bhaviṣyati|</para>
  <para style="p">
    <verse number="31" style="v"/>vicārasamaye idānīntanalokānāṁ prātikūlyena dakṣiṇadeśīyā rājñī protthāya tān doṣiṇaḥ kariṣyati, yataḥ sā rājñī sulemāna upadeśakathāṁ śrotuṁ pṛthivyāḥ sīmāta āgacchat kintu paśyata sulemānopi gurutara eko jano'smin sthāne vidyate|</para>
  <para style="p">
    <verse number="32" style="v"/>aparañca vicārasamaye nīnivīyalokā api varttamānakālikānāṁ lokānāṁ vaiparītyena protthāya tān doṣiṇaḥ kariṣyanti, yato hetoste yūnaso vākyāt cittāni parivarttayāmāsuḥ kintu paśyata yūnasotigurutara eko jano'smin sthāne vidyate|</para>
  <para style="p">
    <verse number="33" style="v"/>pradīpaṁ prajvālya droṇasyādhaḥ kutrāpi guptasthāne vā kopi na sthāpayati kintu gṛhapraveśibhyo dīptiṁ dātaṁ dīpādhāroparyyeva sthāpayati|</para>
  <para style="p">
    <verse number="34" style="v"/>dehasya pradīpaścakṣustasmādeva cakṣu ryadi prasannaṁ bhavati tarhi tava sarvvaśarīraṁ dīptimad bhaviṣyati kintu cakṣu ryadi malīmasaṁ tiṣṭhati tarhi sarvvaśarīraṁ sāndhakāraṁ sthāsyati|</para>
  <para style="p">
    <verse number="35" style="v"/>asmāt kāraṇāt tavāntaḥsthaṁ jyoti ryathāndhakāramayaṁ na bhavati tadarthe sāvadhāno bhava|</para>
  <para style="p">
    <verse number="36" style="v"/>yataḥ śarīrasya kutrāpyaṁśe sāndhakāre na jāte sarvvaṁ yadi dīptimat tiṣṭhati tarhi tubhyaṁ dīptidāyiprojjvalan pradīpa iva tava savarvaśarīraṁ dīptimad bhaviṣyati|</para>
  <para style="p">
    <verse number="37" style="v"/>etatkathāyāḥ kathanakāle phiruśyeko bhejanāya taṁ nimantrayāmāsa, tataḥ sa gatvā bhoktum upaviveśa|</para>
  <para style="p">
    <verse number="38" style="v"/>kintu bhojanāt pūrvvaṁ nāmāṅkṣīt etad dṛṣṭvā sa phiruśyāścaryyaṁ mene|</para>
  <para style="p">
    <verse number="39" style="v"/>tadā prabhustaṁ provāca yūyaṁ phirūśilokāḥ pānapātrāṇāṁ bhojanapātrāṇāñca bahiḥ pariṣkurutha kintu yuṣmākamanta rdaurātmyai rduṣkriyābhiśca paripūrṇaṁ tiṣṭhati|</para>
  <para style="p">
    <verse number="40" style="v"/>he sarvve nirbodhā yo bahiḥ sasarja sa eva kimanta rna sasarja?</para>
  <para style="p">
    <verse number="41" style="v"/>tata eva yuṣmābhirantaḥkaraṇaṁ (īśvarāya) nivedyatāṁ tasmin kṛte yuṣmākaṁ sarvvāṇi śucitāṁ yāsyanti|</para>
  <para style="p">
    <verse number="42" style="v"/>kintu hanta phirūśigaṇā yūyaṁ nyāyam īśvare prema ca parityajya podināyā arudādīnāṁ sarvveṣāṁ śākānāñca daśamāṁśān dattha kintu prathamaṁ pālayitvā śeṣasyālaṅghanaṁ yuṣmākam ucitamāsīt|</para>
  <para style="p">
    <verse number="43" style="v"/>hā hā phirūśino yūyaṁ bhajanagehe proccāsane āpaṇeṣu ca namaskāreṣu prīyadhve|</para>
  <para style="p">
    <verse number="44" style="v"/>vata kapaṭino'dhyāpakāḥ phirūśinaśca lokāyat śmaśānam anupalabhya tadupari gacchanti yūyam tādṛgaprakāśitaśmaśānavād bhavatha|</para>
  <para style="p">
    <verse number="45" style="v"/>tadānīṁ vyavasthāpakānām ekā yīśumavadat, he upadeśaka vākyenedṛśenāsmāsvapi doṣam āropayasi|</para>
  <para style="p">
    <verse number="46" style="v"/>tataḥ sa uvāca, hā hā vyavasthāpakā yūyam mānuṣāṇām upari duḥsahyān bhārān nyasyatha kintu svayam ekāṅguुlyāpi tān bhārān na spṛśatha|</para>
  <para style="p">
    <verse number="47" style="v"/>hanta yuṣmākaṁ pūrvvapuruṣā yān bhaviṣyadvādino'vadhiṣusteṣāṁ śmaśānāni yūyaṁ nirmmātha|</para>
  <para style="p">
    <verse number="48" style="v"/>tenaiva yūyaṁ svapūrvvapuruṣāṇāṁ karmmāṇi saṁmanyadhve tadeva sapramāṇaṁ kurutha ca, yataste tānavadhiṣuḥ yūyaṁ teṣāṁ śmaśānāni nirmmātha|</para>
  <para style="p">
    <verse number="49" style="v"/>ataeva īśvarasya śāstre proktamasti teṣāmantike bhaviṣyadvādinaḥ preritāṁśca preṣayiṣyāmi tataste teṣāṁ kāṁścana haniṣyanti kāṁścana tāḍaśṣyinti|</para>
  <para style="p">
    <verse number="50" style="v"/>etasmāt kāraṇāt hābilaḥ śoṇitapātamārabhya mandirayajñavedyo rmadhye hatasya sikhariyasya raktapātaparyyantaṁ</para>
  <para style="p">
    <verse number="51" style="v"/>jagataḥ sṛṣṭimārabhya pṛthivyāṁ bhaviṣyadvādināṁ yatiraktapātā jātāstatīnām aparādhadaṇḍā eṣāṁ varttamānalokānāṁ bhaviṣyanti, yuṣmānahaṁ niścitaṁ vadāmi sarvve daṇḍā vaṁśasyāsya bhaviṣyanti|</para>
  <para style="p">
    <verse number="52" style="v"/>hā hā vyavasthapakā yūyaṁ jñānasya kuñcikāṁ hṛtvā svayaṁ na praviṣṭā ye praveṣṭuñca prayāsinastānapi praveṣṭuṁ vāritavantaḥ|</para>
  <para style="p">
    <verse number="53" style="v"/>itthaṁ kathākathanād adhyāpakāḥ phirūśinaśca satarkāḥ</para>
  <para style="p">
    <verse number="54" style="v"/>santastamapavadituṁ tasya kathāyā doṣaṁ dharttamicchanto nānākhyānakathanāya taṁ pravarttayituṁ kopayituñca prārebhire|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadānīṁ lokāḥ sahasraṁ sahasram āgatya samupasthitāstata ekaiko 'nyeṣāmupari patitum upacakrame; tadā yīśuḥ śiṣyān babhāṣe, yūyaṁ phirūśināṁ kiṇvarūpakāpaṭye viśeṣeṇa sāvadhānāstiṣṭhata|</para>
  <para style="p">
    <verse number="2" style="v"/>yato yanna prakāśayiṣyate tadācchannaṁ vastu kimapi nāsti; tathā yanna jñāsyate tad guptaṁ vastu kimapi nāsti|</para>
  <para style="p">
    <verse number="3" style="v"/>andhakāre tiṣṭhanato yāḥ kathā akathayata tāḥ sarvvāḥ kathā dīptau śroṣyante nirjane karṇe ca yadakathayata gṛhapṛṣṭhāt tat pracārayiṣyate|</para>
  <para style="p">
    <verse number="4" style="v"/>he bandhavo yuṣmānahaṁ vadāmi, ye śarīrasya nāśaṁ vinā kimapyaparaṁ karttuṁ na śakruvanti tebhyo mā bhaiṣṭa|</para>
  <para style="p">
    <verse number="5" style="v"/>tarhi kasmād bhetavyam ityahaṁ vadāmi, yaḥ śarīraṁ nāśayitvā narakaṁ nikṣeptuṁ śaknoti tasmādeva bhayaṁ kuruta, punarapi vadāmi tasmādeva bhayaṁ kuruta|</para>
  <para style="p">
    <verse number="6" style="v"/>pañca caṭakapakṣiṇaḥ kiṁ dvābhyāṁ tāmrakhaṇḍābhyāṁ na vikrīyante? tathāpīśvarasteṣām ekamapi na vismarati|</para>
  <para style="p">
    <verse number="7" style="v"/>yuṣmākaṁ śiraḥkeśā api gaṇitāḥ santi tasmāt mā vibhīta bahucaṭakapakṣibhyopi yūyaṁ bahumūlyāḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>aparaṁ yuṣmabhyaṁ kathayāmi yaḥ kaścin mānuṣāṇāṁ sākṣān māṁ svīkaroti manuṣyaputra īśvaradūtānāṁ sākṣāt taṁ svīkariṣyati|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu yaḥ kaścinmānuṣāṇāṁ sākṣānmām asvīkaroti tam īśvarasya dūtānāṁ sākṣād aham asvīkariṣyāmi|</para>
  <para style="p">
    <verse number="10" style="v"/>anyacca yaḥ kaścin manujasutasya nindābhāvena kāñcit kathāṁ kathayati tasya tatpāpasya mocanaṁ bhaviṣyati kintu yadi kaścit pavitram ātmānaṁ nindati tarhi tasya tatpāpasya mocanaṁ na bhaviṣyati|</para>
  <para style="p">
    <verse number="11" style="v"/>yadā lokā yuṣmān bhajanagehaṁ vicārakartṛrājyakartṛṇāṁ sammukhañca neṣyanti tadā kena prakāreṇa kimuttaraṁ vadiṣyatha kiṁ kathayiṣyatha cetyatra mā cintayata;</para>
  <para style="p">
    <verse number="12" style="v"/>yato yuṣmābhiryad yad vaktavyaṁ tat tasmin samayaeva pavitra ātmā yuṣmān śikṣayiṣyati|</para>
  <para style="p">
    <verse number="13" style="v"/>tataḥ paraṁ janatāmadhyasthaḥ kaścijjanastaṁ jagāda he guro mayā saha paitṛkaṁ dhanaṁ vibhaktuṁ mama bhrātaramājñāpayatu bhavān|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu sa tamavadat he manuṣya yuvayo rvicāraṁ vibhāgañca karttuṁ māṁ ko niyuktavān?</para>
  <para style="p">
    <verse number="15" style="v"/>anantaraṁ sa lokānavadat lobhe sāvadhānāḥ satarkāśca tiṣṭhata, yato bahusampattiprāptyā manuṣyasyāyu rna bhavati|</para>
  <para style="p">
    <verse number="16" style="v"/>paścād dṛṣṭāntakathāmutthāpya kathayāmāsa, ekasya dhanino bhūmau bahūni śasyāni jātāni|</para>
  <para style="p">
    <verse number="17" style="v"/>tataḥ sa manasā cintayitvā kathayāmbabhūva mamaitāni samutpannāni dravyāṇi sthāpayituṁ sthānaṁ nāsti kiṁ kariṣyāmi?</para>
  <para style="p">
    <verse number="18" style="v"/>tatovadad itthaṁ kariṣyāmi, mama sarvvabhāṇḍāgārāṇi bhaṅktvā bṛhadbhāṇḍāgārāṇi nirmmāya tanmadhye sarvvaphalāni dravyāṇi ca sthāpayiṣyāmi|</para>
  <para style="p">
    <verse number="19" style="v"/>aparaṁ nijamano vadiṣyāmi, he mano bahuvatsarārthaṁ nānādravyāṇi sañcitāni santi viśrāmaṁ kuru bhuktvā pītvā kautukañca kuru| kintvīśvarastam avadat,</para>
  <para style="p">
    <verse number="20" style="v"/>re nirbodha adya rātrau tava prāṇāstvatto neṣyante tata etāni yāni dravyāṇi tvayāsāditāni tāni kasya bhaviṣyanti?</para>
  <para style="p">
    <verse number="21" style="v"/>ataeva yaḥ kaścid īśvarasya samīpe dhanasañcayamakṛtvā kevalaṁ svanikaṭe sañcayaṁ karoti sopi tādṛśaḥ|</para>
  <para style="p">
    <verse number="22" style="v"/>atha sa śiṣyebhyaḥ kathayāmāsa, yuṣmānahaṁ vadāmi, kiṁ khādiṣyāmaḥ? kiṁ paridhāsyāmaḥ? ityuktvā jīvanasya śarīrasya cārthaṁ cintāṁ mā kārṣṭa|</para>
  <para style="p">
    <verse number="23" style="v"/>bhakṣyājjīvanaṁ bhūṣaṇāccharīrañca śreṣṭhaṁ bhavati|</para>
  <para style="p">
    <verse number="24" style="v"/>kākapakṣiṇāṁ kāryyaṁ vicārayata, te na vapanti śasyāni ca na chindanti, teṣāṁ bhāṇḍāgārāṇi na santi koṣāśca na santi, tathāpīśvarastebhyo bhakṣyāṇi dadāti, yūyaṁ pakṣibhyaḥ śreṣṭhatarā na kiṁ?</para>
  <para style="p">
    <verse number="25" style="v"/>aparañca bhāvayitvā nijāyuṣaḥ kṣaṇamātraṁ varddhayituṁ śaknoti, etādṛśo lāko yuṣmākaṁ madhye kosti?</para>
  <para style="p">
    <verse number="26" style="v"/>ataeva kṣudraṁ kāryyaṁ sādhayitum asamarthā yūyam anyasmin kāryye kuto bhāvayatha?</para>
  <para style="p">
    <verse number="27" style="v"/>anyacca kāmpilapuṣpaṁ kathaṁ varddhate tadāpi vicārayata, tat kañcana śramaṁ na karoti tantūṁśca na janayati kintu yuṣmabhyaṁ yathārthaṁ kathayāmi sulemān bahvaiśvaryyānvitopi puṣpasyāsya sadṛśo vibhūṣito nāsīt|</para>
  <para style="p">
    <verse number="28" style="v"/>adya kṣetre varttamānaṁ śvaścūllyāṁ kṣepsyamānaṁ yat tṛṇaṁ, tasmai yadīśvara itthaṁ bhūṣayati tarhi he alpapratyayino yuṣmāna kiṁ na paridhāpayiṣyati?</para>
  <para style="p">
    <verse number="29" style="v"/>ataeva kiṁ khādiṣyāmaḥ? kiṁ paridhāsyāmaḥ? etadarthaṁ mā ceṣṭadhvaṁ mā saṁdigdhvañca|</para>
  <para style="p">
    <verse number="30" style="v"/>jagato devārccakā etāni sarvvāṇi ceṣṭanate; eṣu vastuṣu yuṣmākaṁ prayojanamāste iti yuṣmākaṁ pitā jānāti|</para>
  <para style="p">
    <verse number="31" style="v"/>ataeveśvarasya rājyārthaṁ saceṣṭā bhavata tathā kṛte sarvvāṇyetāni dravyāṇi yuṣmabhyaṁ pradāyiṣyante|</para>
  <para style="p">
    <verse number="32" style="v"/>he kṣudrameṣavraja yūyaṁ mā bhaiṣṭa yuṣmabhyaṁ rājyaṁ dātuṁ yuṣmākaṁ pituḥ sammatirasti|</para>
  <para style="p">
    <verse number="33" style="v"/>ataeva yuṣmākaṁ yā yā sampattirasti tāṁ tāṁ vikrīya vitarata, yat sthānaṁ caurā nāgacchanti, kīṭāśca na kṣāyayanti tādṛśe svarge nijārtham ajare sampuṭake 'kṣayaṁ dhanaṁ sañcinuta ca;</para>
  <para style="p">
    <verse number="34" style="v"/>yato yatra yuṣmākaṁ dhanaṁ varttate tatreva yuṣmākaṁ manaḥ|</para>
  <para style="p">
    <verse number="35" style="v"/>aparañca yūyaṁ pradīpaṁ jvālayitvā baddhakaṭayastiṣṭhata;</para>
  <para style="p">
    <verse number="36" style="v"/>prabhu rvivāhādāgatya yadaiva dvāramāhanti tadaiva dvāraṁ mocayituṁ yathā bhṛtyā apekṣya tiṣṭhanti tathā yūyamapi tiṣṭhata|</para>
  <para style="p">
    <verse number="37" style="v"/>yataḥ prabhurāgatya yān dāsān sacetanān tiṣṭhato drakṣyati taeva dhanyāḥ; ahaṁ yuṣmān yathārthaṁ vadāmi prabhustān bhojanārtham upaveśya svayaṁ baddhakaṭiḥ samīpametya pariveṣayiṣyati|</para>
  <para style="p">
    <verse number="38" style="v"/>yadi dvitīye tṛtīye vā prahare samāgatya tathaiva paśyati, tarhi taeva dāsā dhanyāḥ|</para>
  <para style="p">
    <verse number="39" style="v"/>aparañca kasmin kṣaṇe caurā āgamiṣyanti iti yadi gṛhapati rjñātuṁ śaknoti tadāvaśyaṁ jāgran nijagṛhe sandhiṁ karttayituṁ vārayati yūyametad vitta|</para>
  <para style="p">
    <verse number="40" style="v"/>ataeva yūyamapi sajjamānāstiṣṭhata yato yasmin kṣaṇe taṁ nāprekṣadhve tasminneva kṣaṇe manuṣyaputra āgamiṣyati|</para>
  <para style="p">
    <verse number="41" style="v"/>tadā pitaraḥ papraccha, he prabho bhavān kimasmān uddiśya kiṁ sarvvān uddiśya dṛṣṭāntakathāmimāṁ vadati?</para>
  <para style="p">
    <verse number="42" style="v"/>tataḥ prabhuḥ provāca, prabhuḥ samucitakāle nijaparivārārthaṁ bhojyapariveṣaṇāya yaṁ tatpade niyokṣyati tādṛśo viśvāsyo boddhā karmmādhīśaḥ kosti?</para>
  <para style="p">
    <verse number="43" style="v"/>prabhurāgatya yam etādṛśe karmmaṇi pravṛttaṁ drakṣyati saeva dāso dhanyaḥ|</para>
  <para style="p">
    <verse number="44" style="v"/>ahaṁ yuṣmān yathārthaṁ vadāmi sa taṁ nijasarvvasvasyādhipatiṁ kariṣyati|</para>
  <para style="p">
    <verse number="45" style="v"/>kintu prabhurvilambenāgamiṣyati, iti vicintya sa dāso yadi tadanyadāsīdāsān praharttum bhoktuṁ pātuṁ madituñca prārabhate,</para>
  <para style="p">
    <verse number="46" style="v"/>tarhi yadā prabhuṁ nāpekṣiṣyate yasmin kṣaṇe so'cetanaśca sthāsyati tasminneva kṣaṇe tasya prabhurāgatya taṁ padabhraṣṭaṁ kṛtvā viśvāsahīnaiḥ saha tasya aṁśaṁ nirūpayiṣyati|</para>
  <para style="p">
    <verse number="47" style="v"/>yo dāsaḥ prabheाrājñāṁ jñātvāpi sajjito na tiṣṭhati tadājñānusāreṇa ca kāryyaṁ na karoti sonekān prahārān prāpsyati;</para>
  <para style="p">
    <verse number="48" style="v"/>kintu yo jano'jñātvā prahārārhaṁ karmma karoti solpaprahārān prāpsyati| yato yasmai bāhulyena dattaṁ tasmādeva bāhulyena grahīṣyate, mānuṣā yasya nikaṭe bahu samarpayanti tasmād bahu yācante|</para>
  <para style="p">
    <verse number="49" style="v"/>ahaṁ pṛthivyām anaikyarūpaṁ vahni nikṣeptum āgatosmi, sa ced idānīmeva prajvalati tatra mama kā cintā?</para>
  <para style="p">
    <verse number="50" style="v"/>kintu yena majjanenāhaṁ magno bhaviṣyāmi yāvatkālaṁ tasya siddhi rna bhaviṣyati tāvadahaṁ katikaṣṭaṁ prāpsyāmi|</para>
  <para style="p">
    <verse number="51" style="v"/>melanaṁ karttuṁ jagad āgatosmi yūyaṁ kimitthaṁ bodhadhve? yuṣmān vadāmi na tathā, kintvahaṁ melanābhāvaṁ karttuṁm āgatosmi|</para>
  <para style="p">
    <verse number="52" style="v"/>yasmādetatkālamārabhya ekatrasthaparijanānāṁ madhye pañcajanāḥ pṛthag bhūtvā trayo janā dvayorjanayoḥ pratikūlā dvau janau ca trayāṇāṁ janānāṁ pratikūlau bhaviṣyanti|</para>
  <para style="p">
    <verse number="53" style="v"/>pitā putrasya vipakṣaḥ putraśca pitu rvipakṣo bhaviṣyati mātā kanyāyā vipakṣā kanyā ca mātu rvipakṣā bhaviṣyati, tathā śvaśrūrbadhvā vipakṣā badhūśca śvaśrvā vipakṣā bhaviṣyati|</para>
  <para style="p">
    <verse number="54" style="v"/>sa lokebhyoparamapi kathayāmāsa, paścimadiśi meghodgamaṁ dṛṣṭvā yūyaṁ haṭhād vadatha vṛṣṭi rbhaviṣyati tatastathaiva jāyate|</para>
  <para style="p">
    <verse number="55" style="v"/>aparaṁ dakṣiṇato vāyau vāti sati vadatha nidāgho bhaviṣyati tataḥ sopi jāyate|</para>
  <para style="p">
    <verse number="56" style="v"/>re re kapaṭina ākāśasya bhūmyāśca lakṣaṇaṁ boddhuṁ śaknutha,</para>
  <para style="p">
    <verse number="57" style="v"/>kintu kālasyāsya lakṣaṇaṁ kuto boddhuṁ na śaknutha? yūyañca svayaṁ kuto na nyāṣyaṁ vicārayatha?</para>
  <para style="p">
    <verse number="58" style="v"/>aparañca vivādinā sārddhaṁ vicārayituḥ samīpaṁ gacchan pathi tasmāduddhāraṁ prāptuṁ yatasva nocet sa tvāṁ dhṛtvā vicārayituḥ samīpaṁ nayati| vicārayitā yadi tvāṁ praharttuḥ samīpaṁ samarpayati praharttā tvāṁ kārāyāṁ badhnāti</para>
  <para style="p">
    <verse number="59" style="v"/>tarhi tvāmahaṁ vadāmi tvayā niḥśeṣaṁ kapardakeṣu na pariśodhiteṣu tvaṁ tato muktiṁ prāptuṁ na śakṣyasi|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparañca pīlāto yeṣāṁ gālīlīyānāṁ raktāni balīnāṁ raktaiḥ sahāmiśrayat teṣāṁ gālīlīyānāṁ vṛttāntaṁ katipayajanā upasthāpya yīśave kathayāmāsuḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>tataḥ sa pratyuvāca teṣāṁ lokānām etādṛśī durgati rghaṭitā tatkāraṇād yūyaṁ kimanyebhyo gālīlīyebhyopyadhikapāpinastān bodhadhve?</para>
  <para style="p">
    <verse number="3" style="v"/>yuṣmānahaṁ vadāmi tathā na kintu manaḥsu na parāvarttiteṣu yūyamapi tathā naṁkṣyatha|</para>
  <para style="p">
    <verse number="4" style="v"/>aparañca śīlohanāmna uccagṛhasya patanād ye'ṣṭādaśajanā mṛtāste yirūśālami nivāsisarvvalokebhyo'dhikāparādhinaḥ kiṁ yūyamityaṁ bodhadhve?</para>
  <para style="p">
    <verse number="5" style="v"/>yuṣmānahaṁ vadāmi tathā na kintu manaḥsu na parivarttiteṣu yūyamapi tathā naṁkṣyatha|</para>
  <para style="p">
    <verse number="6" style="v"/>anantaraṁ sa imāṁ dṛṣṭāntakathāmakathayad eko jano drākṣākṣetramadhya ekamuḍumbaravṛkṣaṁ ropitavān| paścāt sa āgatya tasmin phalāni gaveṣayāmāsa,</para>
  <para style="p">
    <verse number="7" style="v"/>kintu phalāprāpteḥ kāraṇād udyānakāraṁ bhṛtyaṁ jagāda, paśya vatsaratrayaṁ yāvadāgatya etasminnuḍumbaratarau kṣalānyanvicchāmi, kintu naikamapi prapnomi tarurayaṁ kuto vṛthā sthānaṁ vyāpya tiṣṭhati? enaṁ chindhi|</para>
  <para style="p">
    <verse number="8" style="v"/>tato bhṛtyaḥ pratyuvāca, he prabho punarvarṣamekaṁ sthātum ādiśa; etasya mūlasya caturdikṣu khanitvāham ālavālaṁ sthāpayāmi|</para>
  <para style="p">
    <verse number="9" style="v"/>tataḥ phalituṁ śaknoti yadi na phalati tarhi paścāt chetsyasi|</para>
  <para style="p">
    <verse number="10" style="v"/>atha viśrāmavāre bhajanagehe yīśurupadiśati</para>
  <para style="p">
    <verse number="11" style="v"/>tasmit samaye bhūtagrastatvāt kubjībhūyāṣṭādaśavarṣāṇi yāvat kenāpyupāyena ṛju rbhavituṁ na śaknoti yā durbbalā strī,</para>
  <para style="p">
    <verse number="12" style="v"/>tāṁ tatropasthitāṁ vilokya yīśustāmāhūya kathitavān he nāri tava daurbbalyāt tvaṁ muktā bhava|</para>
  <para style="p">
    <verse number="13" style="v"/>tataḥ paraṁ tasyā gātre hastārpaṇamātrāt sā ṛjurbhūtveśvarasya dhanyavādaṁ karttumārebhe|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu viśrāmavāre yīśunā tasyāḥ svāsthyakaraṇād bhajanagehasyādhipatiḥ prakupya lokān uvāca, ṣaṭsu dineṣu lokaiḥ karmma karttavyaṁ tasmāddhetoḥ svāsthyārthaṁ teṣu dineṣu āgacchata, viśrāmavāre māgacchata|</para>
  <para style="p">
    <verse number="15" style="v"/>tadā pabhuḥ pratyuvāca re kapaṭino yuṣmākam ekaiko jano viśrāmavāre svīyaṁ svīyaṁ vṛṣabhaṁ gardabhaṁ vā bandhanānmocayitvā jalaṁ pāyayituṁ kiṁ na nayati?</para>
  <para style="p">
    <verse number="16" style="v"/>tarhyāṣṭādaśavatsarān yāvat śaitānā baddhā ibrāhīmaḥ santatiriyaṁ nārī kiṁ viśrāmavāre na mocayitavyā?</para>
  <para style="p">
    <verse number="17" style="v"/>eṣu vākyeṣu kathiteṣu tasya vipakṣāḥ salajjā jātāḥ kintu tena kṛtasarvvamahākarmmakāraṇāt lokanivahaḥ sānando'bhavat|</para>
  <para style="p">
    <verse number="18" style="v"/>anantaraṁ sovadad īśvarasya rājyaṁ kasya sadṛśaṁ? kena tadupamāsyāmi?</para>
  <para style="p">
    <verse number="19" style="v"/>yat sarṣapabījaṁ gṛhītvā kaścijjana udyāna uptavān tad bījamaṅkuritaṁ sat mahāvṛkṣo'jāyata, tatastasya śākhāsu vihāyasīyavihagā āgatya nyūṣuḥ, tadrājyaṁ tādṛśena sarṣapabījena tulyaṁ|</para>
  <para style="p">
    <verse number="20" style="v"/>punaḥ kathayāmāsa, īśvarasya rājyaṁ kasya sadṛśaṁ vadiṣyāmi? yat kiṇvaṁ kācit strī gṛhītvā droṇatrayaparimitagodhūmacūrṇeṣu sthāpayāmāsa,</para>
  <para style="p">
    <verse number="21" style="v"/>tataḥ krameṇa tat sarvvagodhūmacūrṇaṁ vyāpnoti, tasya kiṇvasya tulyam īśvarasya rājyaṁ|</para>
  <para style="p">
    <verse number="22" style="v"/>tataḥ sa yirūśālamnagaraṁ prati yātrāṁ kṛtvā nagare nagare grāme grāme samupadiśan jagāma|</para>
  <para style="p">
    <verse number="23" style="v"/>tadā kaścijjanastaṁ papraccha, he prabho kiṁ kevalam alpe lokāḥ paritrāsyante?</para>
  <para style="p">
    <verse number="24" style="v"/>tataḥ sa lokān uvāca, saṁkīrṇadvāreṇa praveṣṭuṁ yataghvaṁ, yatohaṁ yuṣmān vadāmi, bahavaḥ praveṣṭuṁ ceṣṭiṣyante kintu na śakṣyanti|</para>
  <para style="p">
    <verse number="25" style="v"/>gṛhapatinotthāya dvāre ruddhe sati yadi yūyaṁ bahiḥ sthitvā dvāramāhatya vadatha, he prabho he prabho asmatkāraṇād dvāraṁ mocayatu, tataḥ sa iti prativakṣyati, yūyaṁ kutratyā lokā ityahaṁ na jānāmi|</para>
  <para style="p">
    <verse number="26" style="v"/>tadā yūyaṁ vadiṣyatha, tava sākṣād vayaṁ bheाjanaṁ pānañca kṛtavantaḥ, tvañcāsmākaṁ nagarasya pathi samupadiṣṭavān|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu sa vakṣyati, yuṣmānahaṁ vadāmi, yūyaṁ kutratyā lokā ityahaṁ na jānāmi; he durācāriṇo yūyaṁ matto dūrībhavata|</para>
  <para style="p">
    <verse number="28" style="v"/>tadā ibrāhīmaṁ ishākaṁ yākūbañca sarvvabhaviṣyadvādinaśca īśvarasya rājyaṁ prāptān svāṁśca bahiṣkṛtān dṛṣṭvā yūyaṁ rodanaṁ dantairdantagharṣaṇañca kariṣyatha|</para>
  <para style="p">
    <verse number="29" style="v"/>aparañca pūrvvapaścimadakṣiṇottaradigbhyo lokā āgatya īśvarasya rājye nivatsyanti|</para>
  <para style="p">
    <verse number="30" style="v"/>paśyatetthaṁ śeṣīyā lokā agrā bhaviṣyanti, agrīyā lokāśca śeṣā bhaviṣyanti|</para>
  <para style="p">
    <verse number="31" style="v"/>aparañca tasmin dine kiyantaḥ phirūśina āgatya yīśuṁ procuḥ, bahirgaccha, sthānādasmāt prasthānaṁ kuru, herod tvāṁ jighāṁsati|</para>
  <para style="p">
    <verse number="32" style="v"/>tataḥ sa pratyavocat paśyatādya śvaśca bhūtān vihāpya rogiṇo'rogiṇaḥ kṛtvā tṛtīyehni setsyāmi, kathāmetāṁ yūyamitvā taṁ bhūrimāyaṁ vadata|</para>
  <para style="p">
    <verse number="33" style="v"/>tatrāpyadya śvaḥ paraśvaśca mayā gamanāgamane karttavye, yato heto ryirūśālamo bahiḥ kutrāpi kopi bhaviṣyadvādī na ghāniṣyate|</para>
  <para style="p">
    <verse number="34" style="v"/>he yirūśālam he yirūśālam tvaṁ bhaviṣyadvādino haṁsi tavāntike preritān prastarairmārayasi ca, yathā kukkuṭī nijapakṣādhaḥ svaśāvakān saṁgṛhlāti, tathāhamapi tava śiśūn saṁgrahītuṁ kativārān aicchaṁ kintu tvaṁ naicchaḥ|</para>
  <para style="p">
    <verse number="35" style="v"/>paśyata yuṣmākaṁ vāsasthānāni procchidyamānāni parityaktāni ca bhaviṣyanti; yuṣmānahaṁ yathārthaṁ vadāmi, yaḥ prabho rnāmnāgacchati sa dhanya iti vācaṁ yāvatkālaṁ na vadiṣyatha, tāvatkālaṁ yūyaṁ māṁ na drakṣyatha|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ viśrāmavāre yīśau pradhānasya phirūśino gṛhe bhoktuṁ gatavati te taṁ vīkṣitum ārebhire|</para>
  <para style="p">
    <verse number="2" style="v"/>tadā jalodarī tasya sammukhe sthitaḥ|</para>
  <para style="p">
    <verse number="3" style="v"/>tataḥ sa vyavasthāpakān phirūśinaśca papraccha, viśrāmavāre svāsthyaṁ karttavyaṁ na vā? tataste kimapi na pratyūcuḥ|</para>
  <para style="p">
    <verse number="4" style="v"/>tadā sa taṁ rogiṇaṁ svasthaṁ kṛtvā visasarja;</para>
  <para style="p">
    <verse number="5" style="v"/>tānuvāca ca yuṣmākaṁ kasyacid garddabho vṛṣabho vā ced gartte patati tarhi viśrāmavāre tatkṣaṇaṁ sa kiṁ taṁ notthāpayiṣyati?</para>
  <para style="p">
    <verse number="6" style="v"/>tataste kathāyā etasyāḥ kimapi prativaktuṁ na śekuḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>aparañca pradhānasthānamanonītatvakaraṇaṁ vilokya sa nimantritān etadupadeśakathāṁ jagāda,</para>
  <para style="p">
    <verse number="8" style="v"/>tvaṁ vivāhādibhojyeṣu nimantritaḥ san pradhānasthāne mopāvekṣīḥ| tvatto gauravānvitanimantritajana āyāte</para>
  <para style="p">
    <verse number="9" style="v"/>nimantrayitāgatya manuṣyāyaitasmai sthānaṁ dehīti vākyaṁ ced vakṣyati tarhi tvaṁ saṅkucito bhūtvā sthāna itarasmin upaveṣṭum udyaṁsyasi|</para>
  <para style="p">
    <verse number="10" style="v"/>asmāt kāraṇādeva tvaṁ nimantrito gatvā'pradhānasthāna upaviśa, tato nimantrayitāgatya vadiṣyati, he bandho proccasthānaṁ gatvopaviśa, tathā sati bhojanopaviṣṭānāṁ sakalānāṁ sākṣāt tvaṁ mānyo bhaviṣyasi|</para>
  <para style="p">
    <verse number="11" style="v"/>yaḥ kaścit svamunnamayati sa namayiṣyate, kintu yaḥ kaścit svaṁ namayati sa unnamayiṣyate|</para>
  <para style="p">
    <verse number="12" style="v"/>tadā sa nimantrayitāraṁ janamapi jagāda, madhyāhne rātrau vā bhojye kṛte nijabandhugaṇo vā bhrātṛृgaṇo vā jñātigaṇo vā dhanigaṇo vā samīpavāsigaṇo vā etān na nimantraya, tathā kṛte cet te tvāṁ nimantrayiṣyanti, tarhi pariśodho bhaviṣyati|</para>
  <para style="p">
    <verse number="13" style="v"/>kintu yadā bhejyaṁ karoṣi tadā daridraśuṣkakarakhañjāndhān nimantraya,</para>
  <para style="p">
    <verse number="14" style="v"/>tata āśiṣaṁ lapsyase, teṣu pariśodhaṁ karttumaśaknuvatsu śmaśānāddhārmmikānāmutthānakāle tvaṁ phalāṁ lapsyase|</para>
  <para style="p">
    <verse number="15" style="v"/>anantaraṁ tāṁ kathāṁ niśamya bhojanopaviṣṭaḥ kaścit kathayāmāsa, yo jana īśvarasya rājye bhoktuṁ lapsyate saeva dhanyaḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>tataḥ sa uvāca, kaścit jano rātrau bheाjyaṁ kṛtvā bahūn nimantrayāmāsa|</para>
  <para style="p">
    <verse number="17" style="v"/>tato bhojanasamaye nimantritalokān āhvātuṁ dāsadvārā kathayāmāsa, khadyadravyāṇi sarvvāṇi samāsāditāni santi, yūyamāgacchata|</para>
  <para style="p">
    <verse number="18" style="v"/>kintu te sarvva ekaikaṁ chalaṁ kṛtvā kṣamāṁ prārthayāñcakrire| prathamo janaḥ kathayāmāsa, kṣetramekaṁ krītavānahaṁ tadeva draṣṭuṁ mayā gantavyam, ataeva māṁ kṣantuṁ taṁ nivedaya|</para>
  <para style="p">
    <verse number="19" style="v"/>anyo janaḥ kathayāmāsa, daśavṛṣānahaṁ krītavān tān parīkṣituṁ yāmi tasmādeva māṁ kṣantuṁ taṁ nivedaya|</para>
  <para style="p">
    <verse number="20" style="v"/>aparaḥ kathayāmāsa, vyūḍhavānahaṁ tasmāt kāraṇād yātuṁ na śaknomi|</para>
  <para style="p">
    <verse number="21" style="v"/>paścāt sa dāso gatvā nijaprabhoḥ sākṣāt sarvvavṛttāntaṁ nivedayāmāsa, tatosau gṛhapatiḥ kupitvā svadāsaṁ vyājahāra, tvaṁ satvaraṁ nagarasya sanniveśān mārgāṁśca gatvā daridraśuṣkakarakhañjāndhān atrānaya|</para>
  <para style="p">
    <verse number="22" style="v"/>tato dāso'vadat, he prabho bhavata ājñānusāreṇākriyata tathāpi sthānamasti|</para>
  <para style="p">
    <verse number="23" style="v"/>tadā prabhuḥ puna rdāsāyākathayat, rājapathān vṛkṣamūlāni ca yātvā madīyagṛhapūraṇārthaṁ lokānāgantuṁ pravarttaya|</para>
  <para style="p">
    <verse number="24" style="v"/>ahaṁ yuṣmabhyaṁ kathayāmi, pūrvvanimantritānamekopi mamāsya rātribhojyasyāsvādaṁ na prāpsyati|</para>
  <para style="p">
    <verse number="25" style="v"/>anantaraṁ bahuṣu lokeṣu yīśoḥ paścād vrajiteṣu satsu sa vyāghuṭya tebhyaḥ kathayāmāsa,</para>
  <para style="p">
    <verse number="26" style="v"/>yaḥ kaścin mama samīpam āgatya svasya mātā pitā patnī santānā bhrātaro bhagimyo nijaprāṇāśca, etebhyaḥ sarvvebhyo mayyadhikaṁ prema na karoti, sa mama śiṣyo bhavituṁ na śakṣyati|</para>
  <para style="p">
    <verse number="27" style="v"/>yaḥ kaścit svīyaṁ kruśaṁ vahan mama paścānna gacchati, sopi mama śiṣyo bhavituṁ na śakṣyati|</para>
  <para style="p">
    <verse number="28" style="v"/>durganirmmāṇe kativyayo bhaviṣyati, tathā tasya samāptikaraṇārthaṁ sampattirasti na vā, prathamamupaviśya etanna gaṇayati, yuṣmākaṁ madhya etādṛśaḥ kosti?</para>
  <para style="p">
    <verse number="29" style="v"/>noced bhittiṁ kṛtvā śeṣe yadi samāpayituṁ na śakṣyati,</para>
  <para style="p">
    <verse number="30" style="v"/>tarhi mānuṣoyaṁ nicetum ārabhata samāpayituṁ nāśaknot, iti vyāhṛtya sarvve tamupahasiṣyanti|</para>
  <para style="p">
    <verse number="31" style="v"/>aparañca bhinnabhūpatinā saha yuddhaṁ karttum udyamya daśasahasrāṇi sainyāni gṛhītvā viṁśatisahasreḥ sainyaiḥ sahitasya samīpavāsinaḥ sammukhaṁ yātuṁ śakṣyāmi na veti prathamaṁ upaviśya na vicārayati etādṛśo bhūmipatiḥ kaḥ?</para>
  <para style="p">
    <verse number="32" style="v"/>yadi na śaknoti tarhi ripāvatidūre tiṣṭhati sati nijadūtaṁ preṣya sandhiṁ karttuṁ prārthayeta|</para>
  <para style="p">
    <verse number="33" style="v"/>tadvad yuṣmākaṁ madhye yaḥ kaścin madarthaṁ sarvvasvaṁ hātuṁ na śaknoti sa mama śiṣyo bhavituṁ na śakṣyati|</para>
  <para style="p">
    <verse number="34" style="v"/>lavaṇam uttamam iti satyaṁ, kintu yadi lavaṇasya lavaṇatvam apagacchati tarhi tat kathaṁ svāduyuktaṁ bhaviṣyati?</para>
  <para style="p">
    <verse number="35" style="v"/>tada bhūmyartham ālavālarāśyarthamapi bhadraṁ na bhavati; lokāstad bahiḥ kṣipanti|yasya śrotuṁ śrotre staḥ sa śṛṇotu|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadā karasañcāyinaḥ pāpinaśca lokā upadeśkathāṁ śrotuṁ yīśoḥ samīpam āgacchan|</para>
  <para style="p">
    <verse number="2" style="v"/>tataḥ phirūśina upādhyāyāśca vivadamānāḥ kathayāmāsuḥ eṣa mānuṣaḥ pāpibhiḥ saha praṇayaṁ kṛtvā taiḥ sārddhaṁ bhuṁkte|</para>
  <para style="p">
    <verse number="3" style="v"/>tadā sa tebhya imāṁ dṛṣṭāntakathāṁ kathitavān,</para>
  <para style="p">
    <verse number="4" style="v"/>kasyacit śatameṣeṣu tiṣṭhatmu teṣāmekaṁ sa yadi hārayati tarhi madhyeprāntaram ekonaśatameṣān vihāya hāritameṣasya uddeśaprāptiparyyanataṁ na gaveṣayati, etādṛśo loko yuṣmākaṁ madhye ka āste?</para>
  <para style="p">
    <verse number="5" style="v"/>tasyoddeśaṁ prāpya hṛṣṭamanāstaṁ skandhe nidhāya svasthānam ānīya bandhubāndhavasamīpavāsina āhūya vakti,</para>
  <para style="p">
    <verse number="6" style="v"/>hāritaṁ meṣaṁ prāptoham ato heto rmayā sārddham ānandata|</para>
  <para style="p">
    <verse number="7" style="v"/>tadvadahaṁ yuṣmān vadāmi, yeṣāṁ manaḥparāvarttanasya prayojanaṁ nāsti, tādṛśaikonaśatadhārmmikakāraṇād ya ānandastasmād ekasya manaḥparivarttinaḥ pāpinaḥ kāraṇāt svarge 'dhikānando jāyate|</para>
  <para style="p">
    <verse number="8" style="v"/>aparañca daśānāṁ rūpyakhaṇḍānām ekakhaṇḍe hārite pradīpaṁ prajvālya gṛhaṁ sammārjya tasya prāptiṁ yāvad yatnena na gaveṣayati, etādṛśī yoṣit kāste?</para>
  <para style="p">
    <verse number="9" style="v"/>prāpte sati bandhubāndhavasamīpavāsinīrāhūya kathayati, hāritaṁ rūpyakhaṇḍaṁ prāptāhaṁ tasmādeva mayā sārddham ānandata|</para>
  <para style="p">
    <verse number="10" style="v"/>tadvadahaṁ yuṣmān vyāharāmi, ekena pāpinā manasi parivarttite, īśvarasya dūtānāṁ madhyepyānando jāyate|</para>
  <para style="p">
    <verse number="11" style="v"/>aparañca sa kathayāmāsa, kasyacid dvau putrāvāstāṁ,</para>
  <para style="p">
    <verse number="12" style="v"/>tayoḥ kaniṣṭhaḥ putraḥ pitre kathayāmāsa, he pitastava sampattyā yamaṁśaṁ prāpsyāmyahaṁ vibhajya taṁ dehi, tataḥ pitā nijāṁ sampattiṁ vibhajya tābhyāṁ dadau|</para>
  <para style="p">
    <verse number="13" style="v"/>katipayāt kālāt paraṁ sa kaniṣṭhaputraḥ samastaṁ dhanaṁ saṁgṛhya dūradeśaṁ gatvā duṣṭācaraṇena sarvvāṁ sampattiṁ nāśayāmāsa|</para>
  <para style="p">
    <verse number="14" style="v"/>tasya sarvvadhane vyayaṁ gate taddeśe mahādurbhikṣaṁ babhūva, tatastasya dainyadaśā bhavitum ārebhe|</para>
  <para style="p">
    <verse number="15" style="v"/>tataḥ paraṁ sa gatvā taddeśīyaṁ gṛhasthamekam āśrayata; tataḥ sataṁ śūkaravrajaṁ cārayituṁ prāntaraṁ preṣayāmāsa|</para>
  <para style="p">
    <verse number="16" style="v"/>kenāpi tasmai bhakṣyādānāt sa śūkaraphalavalkalena piciṇḍapūraṇāṁ vavāñcha|</para>
  <para style="p">
    <verse number="17" style="v"/>śeṣe sa manasi cetanāṁ prāpya kathayāmāsa, hā mama pituḥ samīpe kati kati vetanabhujo dāsā yatheṣṭaṁ tatodhikañca bhakṣyaṁ prāpnuvanti kintvahaṁ kṣudhā mumūrṣuḥ|</para>
  <para style="p">
    <verse number="18" style="v"/>ahamutthāya pituḥ samīpaṁ gatvā kathāmetāṁ vadiṣyāmi, he pitar īśvarasya tava ca viruddhaṁ pāpamakaravam</para>
  <para style="p">
    <verse number="19" style="v"/>tava putra̮iti vikhyāto bhavituṁ na yogyosmi ca, māṁ tava vaitanikaṁ dāsaṁ kṛtvā sthāpaya|</para>
  <para style="p">
    <verse number="20" style="v"/>paścāt sa utthāya pituḥ samīpaṁ jagāma; tatastasya pitātidūre taṁ nirīkṣya dayāñcakre, dhāvitvā tasya kaṇṭhaṁ gṛhītvā taṁ cucumba ca|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā putra uvāca, he pitar īśvarasya tava ca viruddhaṁ pāpamakaravaṁ, tava putra̮iti vikhyāto bhavituṁ na yogyosmi ca|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu tasya pitā nijadāsān ādideśa, sarvvottamavastrāṇyānīya paridhāpayatainaṁ haste cāṅgurīyakam arpayata pādayoścopānahau samarpayata;</para>
  <para style="p">
    <verse number="23" style="v"/>puṣṭaṁ govatsam ānīya mārayata ca taṁ bhuktvā vayam ānandāma|</para>
  <para style="p">
    <verse number="24" style="v"/>yato mama putroyam amriyata punarajīvīd hāritaśca labdhobhūt tatasta ānanditum ārebhire|</para>
  <para style="p">
    <verse number="25" style="v"/>tatkāle tasya jyeṣṭhaḥ putraḥ kṣetra āsīt| atha sa niveśanasya nikaṭaṁ āgacchan nṛtyānāṁ vādyānāñca śabdaṁ śrutvā</para>
  <para style="p">
    <verse number="26" style="v"/>dāsānām ekam āhūya papraccha, kiṁ kāraṇamasya?</para>
  <para style="p">
    <verse number="27" style="v"/>tataḥ sovādīt, tava bhrātāgamat, tava tātaśca taṁ suśarīraṁ prāpya puṣṭaṁ govatsaṁ māritavān|</para>
  <para style="p">
    <verse number="28" style="v"/>tataḥ sa prakupya niveśanāntaḥ praveṣṭuṁ na sammene; tatastasya pitā bahirāgatya taṁ sādhayāmāsa|</para>
  <para style="p">
    <verse number="29" style="v"/>tataḥ sa pitaraṁ pratyuvāca, paśya tava kāñcidapyājñāṁ na vilaṁghya bahūn vatsarān ahaṁ tvāṁ seve tathāpi mitraiḥ sārddham utsavaṁ karttuṁ kadāpi chāgamekamapi mahyaṁ nādadāḥ;</para>
  <para style="p">
    <verse number="30" style="v"/>kintu tava yaḥ putro veśyāgamanādibhistava sampattim apavyayitavān tasminnāgatamātre tasyaiva nimittaṁ puṣṭaṁ govatsaṁ māritavān|</para>
  <para style="p">
    <verse number="31" style="v"/>tadā tasya pitāvocat, he putra tvaṁ sarvvadā mayā sahāsi tasmān mama yadyadāste tatsarvvaṁ tava|</para>
  <para style="p">
    <verse number="32" style="v"/>kintu tavāyaṁ bhrātā mṛtaḥ punarajīvīd hāritaśca bhūtvā prāptobhūt, etasmāt kāraṇād utsavānandau karttum ucitamasmākam|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparañca yīśuḥ śiṣyebhyonyāmekāṁ kathāṁ kathayāmāsa kasyacid dhanavato manuṣyasya gṛhakāryyādhīśe sampatterapavyaye'pavādite sati</para>
  <para style="p">
    <verse number="2" style="v"/>tasya prabhustam āhūya jagāda, tvayi yāmimāṁ kathāṁ śṛṇomi sā kīdṛśī? tvaṁ gṛhakāryyādhīśakarmmaṇo gaṇanāṁ darśaya gṛhakāryyādhīśapade tvaṁ na sthāsyasi|</para>
  <para style="p">
    <verse number="3" style="v"/>tadā sa gṛhakāryyādhīśo manasā cintayāmāsa, prabhu ryadi māṁ gṛhakāryyādhīśapadād bhraṁśayati tarhi kiṁ kariṣye'haṁ? mṛdaṁ khanituṁ mama śakti rnāsti bhikṣituñca lajjiṣye'haṁ|</para>
  <para style="p">
    <verse number="4" style="v"/>ataeva mayi gṛhakāryyādhīśapadāt cyute sati yathā lokā mahyam āśrayaṁ dāsyanti tadarthaṁ yatkarmma mayā karaṇīyaṁ tan nirṇīyate|</para>
  <para style="p">
    <verse number="5" style="v"/>paścāt sa svaprabhorekaikam adhamarṇam āhūya prathamaṁ papraccha, tvatto me prabhuṇā kati prāpyam?</para>
  <para style="p">
    <verse number="6" style="v"/>tataḥ sa uvāca, ekaśatāḍhakatailāni; tadā gṛhakāryyādhīśaḥ provāca, tava patramānīya śīghramupaviśya tatra pañcāśataṁ likha|</para>
  <para style="p">
    <verse number="7" style="v"/>paścādanyamekaṁ papraccha, tvatto me prabhuṇā kati prāpyam? tataḥ sovādīd ekaśatāḍhakagodhūmāḥ; tadā sa kathayāmāsa, tava patramānīya aśītiṁ likha|</para>
  <para style="p">
    <verse number="8" style="v"/>tenaiva prabhustamayathārthakṛtam adhīśaṁ tadbuddhinaipuṇyāt praśaśaṁsa; itthaṁ dīptirūpasantānebhya etatsaṁsārasya santānā varttamānakāle'dhikabuddhimanto bhavanti|</para>
  <para style="p">
    <verse number="9" style="v"/>ato vadāmi yūyamapyayathārthena dhanena mitrāṇi labhadhvaṁ tato yuṣmāsu padabhraṣṭeṣvapi tāni cirakālam āśrayaṁ dāsyanti|</para>
  <para style="p">
    <verse number="10" style="v"/>yaḥ kaścit kṣudre kāryye viśvāsyo bhavati sa mahati kāryyepi viśvāsyo bhavati, kintu yaḥ kaścit kṣudre kāryye'viśvāsyo bhavati sa mahati kāryyepyaviśvāsyo bhavati|</para>
  <para style="p">
    <verse number="11" style="v"/>ataeva ayathārthena dhanena yadi yūyamaviśvāsyā jātāstarhi satyaṁ dhanaṁ yuṣmākaṁ kareṣu kaḥ samarpayiṣyati?</para>
  <para style="p">
    <verse number="12" style="v"/>yadi ca paradhanena yūyam aviśvāsyā bhavatha tarhi yuṣmākaṁ svakīyadhanaṁ yuṣmabhyaṁ ko dāsyati?</para>
  <para style="p">
    <verse number="13" style="v"/>kopi dāsa ubhau prabhū sevituṁ na śaknoti, yata ekasmin prīyamāṇo'nyasminnaprīyate yadvā ekaṁ janaṁ samādṛtya tadanyaṁ tucchīkaroti tadvad yūyamapi dhaneśvarau sevituṁ na śaknutha|</para>
  <para style="p">
    <verse number="14" style="v"/>tadaitāḥ sarvvāḥ kathāḥ śrutvā lobhiphirūśinastamupajahasuḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>tataḥ sa uvāca, yūyaṁ manuṣyāṇāṁ nikaṭe svān nirdoṣān darśayatha kintu yuṣmākam antaḥkaraṇānīśvaro jānāti, yat manuṣyāṇām ati praśaṁsyaṁ tad īśvarasya ghṛṇyaṁ|</para>
  <para style="p">
    <verse number="16" style="v"/>yohana āgamanaparyyanataṁ yuṣmākaṁ samīpe vyavasthābhaviṣyadvādināṁ lekhanāni cāsan tataḥ prabhṛti īśvararājyasya susaṁvādaḥ pracarati, ekaiko lokastanmadhyaṁ yatnena praviśati ca|</para>
  <para style="p">
    <verse number="17" style="v"/>varaṁ nabhasaḥ pṛthivyāśca lopo bhaviṣyati tathāpi vyavasthāyā ekabindorapi lopo na bhaviṣyati|</para>
  <para style="p">
    <verse number="18" style="v"/>yaḥ kaścit svīyāṁ bhāryyāṁ vihāya striyamanyāṁ vivahati sa paradārān gacchati, yaśca tā tyaktāṁ nārīṁ vivahati sopi paradārāna gacchati|</para>
  <para style="p">
    <verse number="19" style="v"/>eko dhanī manuṣyaḥ śuklāni sūkṣmāṇi vastrāṇi paryyadadhāt pratidinaṁ paritoṣarūpeṇābhuṁktāpivacca|</para>
  <para style="p">
    <verse number="20" style="v"/>sarvvāṅge kṣatayukta iliyāsaranāmā kaścid daridrastasya dhanavato bhojanapātrāt patitam ucchiṣṭaṁ bhoktuṁ vāñchan tasya dvāre patitvātiṣṭhat;</para>
  <para style="p">
    <verse number="21" style="v"/>atha śvāna āgatya tasya kṣatānyalihan|</para>
  <para style="p">
    <verse number="22" style="v"/>kiyatkālātparaṁ sa daridraḥ prāṇān jahau; tataḥ svargīyadūtāstaṁ nītvā ibrāhīmaḥ kroḍa upaveśayāmāsuḥ|</para>
  <para style="p">
    <verse number="23" style="v"/>paścāt sa dhanavānapi mamāra, taṁ śmaśāne sthāpayāmāsuśca; kintu paraloke sa vedanākulaḥ san ūrddhvāṁ nirīkṣya bahudūrād ibrāhīmaṁ tatkroḍa iliyāsarañca vilokya ruvannuvāca;</para>
  <para style="p">
    <verse number="24" style="v"/>he pitar ibrāhīm anugṛhya aṅgulyagrabhāgaṁ jale majjayitvā mama jihvāṁ śītalāṁ karttum iliyāsaraṁ preraya, yato vahniśikhātohaṁ vyathitosmi|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā ibrāhīm babhāṣe, he putra tvaṁ jīvan sampadaṁ prāptavān iliyāsarastu vipadaṁ prāptavān etat smara, kintu samprati tasya sukhaṁ tava ca duḥkhaṁ bhavati|</para>
  <para style="p">
    <verse number="26" style="v"/>aparamapi yuṣmākam asmākañca sthānayo rmadhye mahadvicchedo'sti tata etatsthānasya lokāstat sthānaṁ yātuṁ yadvā tatsthānasya lokā etat sthānamāyātuṁ na śaknuvanti|</para>
  <para style="p">
    <verse number="27" style="v"/>tadā sa uktavān, he pitastarhi tvāṁ nivedayāmi mama pitu rgehe ye mama pañca bhrātaraḥ santi</para>
  <para style="p">
    <verse number="28" style="v"/>te yathaitad yātanāsthānaṁ nāyāsyanti tathā mantraṇāṁ dātuṁ teṣāṁ samīpam iliyāsaraṁ preraya|</para>
  <para style="p">
    <verse number="29" style="v"/>tata ibrāhīm uvāca, mūsābhaviṣyadvādināñca pustakāni teṣāṁ nikaṭe santi te tadvacanāni manyantāṁ|</para>
  <para style="p">
    <verse number="30" style="v"/>tadā sa nivedayāmāsa, he pitar ibrāhīm na tathā, kintu yadi mṛtalokānāṁ kaścit teṣāṁ samīpaṁ yāti tarhi te manāṁsi vyāghoṭayiṣyanti|</para>
  <para style="p">
    <verse number="31" style="v"/>tata ibrāhīm jagāda, te yadi mūsābhaviṣyadvādināñca vacanāni na manyante tarhi mṛtalokānāṁ kasmiṁścid utthitepi te tasya mantraṇāṁ na maṁsyante|</para>
  <chapter number="17" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>itaḥ paraṁ yīśuḥ śiṣyān uvāca, vighnairavaśyam āgantavyaṁ kintu vighnā yena ghaṭiṣyante tasya durgati rbhaviṣyati|</para>
  <para style="p">
    <verse number="2" style="v"/>eteṣāṁ kṣudraprāṇinām ekasyāpi vighnajananāt kaṇṭhabaddhapeṣaṇīkasya tasya sāgarāgādhajale majjanaṁ bhadraṁ|</para>
  <para style="p">
    <verse number="3" style="v"/>yūyaṁ sveṣu sāvadhānāstiṣṭhata; tava bhrātā yadi tava kiñcid aparādhyati tarhi taṁ tarjaya, tena yadi manaḥ parivarttayati tarhi taṁ kṣamasva|</para>
  <para style="p">
    <verse number="4" style="v"/>punarekadinamadhye yadi sa tava saptakṛtvo'parādhyati kintu saptakṛtva āgatya manaḥ parivartya mayāparāddham iti vadati tarhi taṁ kṣamasva|</para>
  <para style="p">
    <verse number="5" style="v"/>tadā preritāḥ prabhum avadan asmākaṁ viśvāsaṁ varddhaya|</para>
  <para style="p">
    <verse number="6" style="v"/>prabhuruvāca, yadi yuṣmākaṁ sarṣapaikapramāṇo viśvāsosti tarhi tvaṁ samūlamutpāṭito bhūtvā samudre ropito bhava kathāyām etasyām etaduḍumbarāya kathitāyāṁ sa yuṣmākamājñāvaho bhaviṣyati|</para>
  <para style="p">
    <verse number="7" style="v"/>aparaṁ svadāse halaṁ vāhayitvā vā paśūn cārayitvā kṣetrād āgate sati taṁ vadati, ehi bhoktumupaviśa, yuṣmākam etādṛśaḥ kosti?</para>
  <para style="p">
    <verse number="8" style="v"/>varañca pūrvvaṁ mama khādyamāsādya yāvad bhuñje pivāmi ca tāvad baddhakaṭiḥ paricara paścāt tvamapi bhokṣyase pāsyasi ca kathāmīdṛśīṁ kiṁ na vakṣyati?</para>
  <para style="p">
    <verse number="9" style="v"/>tena dāsena prabhorājñānurūpe karmmaṇi kṛte prabhuḥ kiṁ tasmin bādhito jātaḥ? netthaṁ budhyate mayā|</para>
  <para style="p">
    <verse number="10" style="v"/>itthaṁ nirūpiteṣu sarvvakarmmasu kṛteṣu satmu yūyamapīdaṁ vākyaṁ vadatha, vayam anupakāriṇo dāsā asmābhiryadyatkarttavyaṁ tanmātrameva kṛtaṁ|</para>
  <para style="p">
    <verse number="11" style="v"/>sa yirūśālami yātrāṁ kurvvan śomiroṇgālīlpradeśamadhyena gacchati,</para>
  <para style="p">
    <verse number="12" style="v"/>etarhi kutracid grāme praveśamātre daśakuṣṭhinastaṁ sākṣāt kṛtvā</para>
  <para style="p">
    <verse number="13" style="v"/>dūre tiṣṭhanata uccai rvaktumārebhire, he prabho yīśo dayasvāsmān|</para>
  <para style="p">
    <verse number="14" style="v"/>tataḥ sa tān dṛṣṭvā jagāda, yūyaṁ yājakānāṁ samīpe svān darśayata, tataste gacchanto rogāt pariṣkṛtāḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>tadā teṣāmekaḥ svaṁ svasthaṁ dṛṣṭvā proccairīśvaraṁ dhanyaṁ vadan vyāghuṭyāyāto yīśo rguṇānanuvadan taccaraṇādhobhūmau papāta;</para>
  <para style="p">
    <verse number="16" style="v"/>sa cāsīt śomiroṇī|</para>
  <para style="p">
    <verse number="17" style="v"/>tadā yīśuravadat, daśajanāḥ kiṁ na pariṣkṛtāḥ? tahyanye navajanāḥ kutra?</para>
  <para style="p">
    <verse number="18" style="v"/>īśvaraṁ dhanyaṁ vadantam enaṁ videśinaṁ vinā kopyanyo na prāpyata|</para>
  <para style="p">
    <verse number="19" style="v"/>tadā sa tamuvāca, tvamutthāya yāhi viśvāsaste tvāṁ svasthaṁ kṛtavān|</para>
  <para style="p">
    <verse number="20" style="v"/>atha kadeśvarasya rājatvaṁ bhaviṣyatīti phirūśibhiḥ pṛṣṭe sa pratyuvāca, īśvarasya rājatvam aiśvaryyadarśanena na bhaviṣyati|</para>
  <para style="p">
    <verse number="21" style="v"/>ata etasmin paśya tasmin vā paśya, iti vākyaṁ lokā vaktuṁ na śakṣyanti, īśvarasya rājatvaṁ yuṣmākam antarevāste|</para>
  <para style="p">
    <verse number="22" style="v"/>tataḥ sa śiṣyān jagāda, yadā yuṣmābhi rmanujasutasya dinamekaṁ draṣṭum vāñchiṣyate kintu na darśiṣyate, īdṛkkāla āyāti|</para>
  <para style="p">
    <verse number="23" style="v"/>tadātra paśya vā tatra paśyeti vākyaṁ lokā vakṣyanti, kintu teṣāṁ paścāt mā yāta, mānugacchata ca|</para>
  <para style="p">
    <verse number="24" style="v"/>yatastaḍid yathākāśaikadiśyudiya tadanyāmapi diśaṁ vyāpya prakāśate tadvat nijadine manujasūnuḥ prakāśiṣyate|</para>
  <para style="p">
    <verse number="25" style="v"/>kintu tatpūrvvaṁ tenānekāni duḥkhāni bhoktavyānyetadvarttamānalokaiśca so'vajñātavyaḥ|</para>
  <para style="p">
    <verse number="26" style="v"/>nohasya vidyamānakāle yathābhavat manuṣyasūnoḥ kālepi tathā bhaviṣyati|</para>
  <para style="p">
    <verse number="27" style="v"/>yāvatkālaṁ noho mahāpotaṁ nārohad āplāvivāryyetya sarvvaṁ nānāśayacca tāvatkālaṁ yathā lokā abhuñjatāpivan vyavahan vyavāhayaṁśca;</para>
  <para style="p">
    <verse number="28" style="v"/>itthaṁ loṭo varttamānakālepi yathā lokā bhojanapānakrayavikrayaropaṇagṛhanirmmāṇakarmmasu prāvarttanta,</para>
  <para style="p">
    <verse number="29" style="v"/>kintu yadā loṭ sidomo nirjagāma tadā nabhasaḥ sagandhakāgnivṛṣṭi rbhūtvā sarvvaṁ vyanāśayat</para>
  <para style="p">
    <verse number="30" style="v"/>tadvan mānavaputraprakāśadinepi bhaviṣyati|</para>
  <para style="p">
    <verse number="31" style="v"/>tadā yadi kaścid gṛhopari tiṣṭhati tarhi sa gṛhamadhyāt kimapi dravyamānetum avaruhya naitu; yaśca kṣetre tiṣṭhati sopi vyāghuṭya nāyātu|</para>
  <para style="p">
    <verse number="32" style="v"/>loṭaḥ patnīṁ smarata|</para>
  <para style="p">
    <verse number="33" style="v"/>yaḥ prāṇān rakṣituṁ ceṣṭiṣyate sa prāṇān hārayiṣyati yastu prāṇān hārayiṣyati saeva prāṇān rakṣiṣyati|</para>
  <para style="p">
    <verse number="34" style="v"/>yuṣmānahaṁ vacmi tasyāṁ rātrau śayyaikagatayo rlokayoreko dhāriṣyate parastyakṣyate|</para>
  <para style="p">
    <verse number="35" style="v"/>striyau yugapat peṣaṇīṁ vyāvarttayiṣyatastayorekā dhāriṣyate parātyakṣyate|</para>
  <para style="p">
    <verse number="36" style="v"/>puruṣau kṣetre sthāsyatastayoreko dhāriṣyate parastyakṣyate|</para>
  <para style="p">
    <verse number="37" style="v"/>tadā te papracchuḥ, he prabho kutretthaṁ bhaviṣyati? tataḥ sa uvāca, yatra śavastiṣṭhati tatra gṛdhrā milanti|</para>
  <chapter number="18" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparañca lokairaklāntai rnirantaraṁ prārthayitavyam ityāśayena yīśunā dṛṣṭānta ekaḥ kathitaḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>kutracinnagare kaścit prāḍvivāka āsīt sa īśvarānnābibhet mānuṣāṁśca nāmanyata|</para>
  <para style="p">
    <verse number="3" style="v"/>atha tatpuravāsinī kācidvidhavā tatsamīpametya vivādinā saha mama vivādaṁ pariṣkurvviti nivedayāmāsa|</para>
  <para style="p">
    <verse number="4" style="v"/>tataḥ sa prāḍvivākaḥ kiyaddināni na tadaṅgīkṛtavān paścāccitte cintayāmāsa, yadyapīśvarānna bibhemi manuṣyānapi na manye</para>
  <para style="p">
    <verse number="5" style="v"/>tathāpyeṣā vidhavā māṁ kliśnāti tasmādasyā vivādaṁ pariṣkariṣyāmi nocet sā sadāgatya māṁ vyagraṁ kariṣyati|</para>
  <para style="p">
    <verse number="6" style="v"/>paścāt prabhuravadad asāvanyāyaprāḍvivāko yadāha tatra mano nidhadhvaṁ|</para>
  <para style="p">
    <verse number="7" style="v"/>īśvarasya ye 'bhirucitalokā divāniśaṁ prārthayante sa bahudināni vilambyāpi teṣāṁ vivādān kiṁ na pariṣkariṣyati?</para>
  <para style="p">
    <verse number="8" style="v"/>yuṣmānahaṁ vadāmi tvarayā pariṣkariṣyati, kintu yadā manuṣyaputra āgamiṣyati tadā pṛthivyāṁ kimīdṛśaṁ viśvāsaṁ prāpsyati?</para>
  <para style="p">
    <verse number="9" style="v"/>ye svān dhārmmikān jñātvā parān tucchīkurvvanti etādṛgbhyaḥ, kiyadbhya imaṁ dṛṣṭāntaṁ kathayāmāsa|</para>
  <para style="p">
    <verse number="10" style="v"/>ekaḥ phirūśyaparaḥ karasañcāyī dvāvimau prārthayituṁ mandiraṁ gatau|</para>
  <para style="p">
    <verse number="11" style="v"/>tato'sau phirūśyekapārśve tiṣṭhan he īśvara ahamanyalokavat loṭhayitānyāyī pāradārikaśca na bhavāmi asya karasañcāyinastulyaśca na, tasmāttvāṁ dhanyaṁ vadāmi|</para>
  <para style="p">
    <verse number="12" style="v"/>saptasu dineṣu dinadvayamupavasāmi sarvvasampatte rdaśamāṁśaṁ dadāmi ca, etatkathāṁ kathayan prārthayāmāsa|</para>
  <para style="p">
    <verse number="13" style="v"/>kintu sa karasañcāyi dūre tiṣṭhan svargaṁ draṣṭuṁ necchan vakṣasi karāghātaṁ kurvvan he īśvara pāpiṣṭhaṁ māṁ dayasva, itthaṁ prārthayāmāsa|</para>
  <para style="p">
    <verse number="14" style="v"/>yuṣmānahaṁ vadāmi, tayordvayo rmadhye kevalaḥ karasañcāyī puṇyavattvena gaṇito nijagṛhaṁ jagāma, yato yaḥ kaścit svamunnamayati sa nāmayiṣyate kintu yaḥ kaścit svaṁ namayati sa unnamayiṣyate|</para>
  <para style="p">
    <verse number="15" style="v"/>atha śiśūnāṁ gātrasparśārthaṁ lokāstān tasya samīpamāninyuḥ śiṣyāstad dṛṣṭvānetṛn tarjayāmāsuḥ,</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yīśustānāhūya jagāda, mannikaṭam āgantuṁ śiśūn anujānīdhvaṁ tāṁśca mā vārayata; yata īśvararājyādhikāriṇa eṣāṁ sadṛśāḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>ahaṁ yuṣmān yathārthaṁ vadāmi, yo janaḥ śiśoḥ sadṛśo bhūtvā īśvararājyaṁ na gṛhlāti sa kenāpi prakāreṇa tat praveṣṭuṁ na śaknoti|</para>
  <para style="p">
    <verse number="18" style="v"/>aparam ekodhipatistaṁ papraccha, he paramaguro, anantāyuṣaḥ prāptaye mayā kiṁ karttavyaṁ?</para>
  <para style="p">
    <verse number="19" style="v"/>yīśuruvāca, māṁ kutaḥ paramaṁ vadasi? īśvaraṁ vinā kopi paramo na bhavati|</para>
  <para style="p">
    <verse number="20" style="v"/>paradārān mā gaccha, naraṁ mā jahi, mā coraya, mithyāsākṣyaṁ mā dehi, mātaraṁ pitarañca saṁmanyasva, etā yā ājñāḥ santi tāstvaṁ jānāsi|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā sa uvāca, bālyakālāt sarvvā etā ācarāmi|</para>
  <para style="p">
    <verse number="22" style="v"/>iti kathāṁ śrutvā yīśustamavadat, tathāpi tavaikaṁ karmma nyūnamāste, nijaṁ sarvvasvaṁ vikrīya daridrebhyo vitara, tasmāt svarge dhanaṁ prāpsyasi; tata āgatya mamānugāmī bhava|</para>
  <para style="p">
    <verse number="23" style="v"/>kintvetāṁ kathāṁ śrutvā sodhipatiḥ śuśoca, yatastasya bahudhanamāsīt|</para>
  <para style="p">
    <verse number="24" style="v"/>tadā yīśustamatiśokānvitaṁ dṛṣṭvā jagāda, dhanavatām īśvararājyapraveśaḥ kīdṛg duṣkaraḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>īśvararājye dhaninaḥ praveśāt sūceśchidreṇa mahāṅgasya gamanāgamane sukare|</para>
  <para style="p">
    <verse number="26" style="v"/>śrotāraḥ papracchustarhi kena paritrāṇaṁ prāpsyate?</para>
  <para style="p">
    <verse number="27" style="v"/>sa uktavān, yan mānuṣeṇāśakyaṁ tad īśvareṇa śakyaṁ|</para>
  <para style="p">
    <verse number="28" style="v"/>tadā pitara uvāca, paśya vayaṁ sarvvasvaṁ parityajya tava paścādgāmino'bhavāma|</para>
  <para style="p">
    <verse number="29" style="v"/>tataḥ sa uvāca, yuṣmānahaṁ yathārthaṁ vadāmi, īśvararājyārthaṁ gṛhaṁ pitarau bhrātṛgaṇaṁ jāyāṁ santānāṁśca tyaktavā</para>
  <para style="p">
    <verse number="30" style="v"/>iha kāle tato'dhikaṁ parakāle 'nantāyuśca na prāpsyati loka īdṛśaḥ kopi nāsti|</para>
  <para style="p">
    <verse number="31" style="v"/>anantaraṁ sa dvādaśaśiṣyānāhūya babhāṣe, paśyata vayaṁ yirūśālamnagaraṁ yāmaḥ, tasmāt manuṣyaputre bhaviṣyadvādibhiruktaṁ yadasti tadanurūpaṁ taṁ prati ghaṭiṣyate;</para>
  <para style="p">
    <verse number="32" style="v"/>vastutastu so'nyadeśīyānāṁ hasteṣu samarpayiṣyate, te tamupahasiṣyanti, anyāyamācariṣyanti tadvapuṣi niṣṭhīvaṁ nikṣepsyanti, kaśābhiḥ prahṛtya taṁ haniṣyanti ca,</para>
  <para style="p">
    <verse number="33" style="v"/>kintu tṛtīyadine sa śmaśānād utthāsyati|</para>
  <para style="p">
    <verse number="34" style="v"/>etasyāḥ kathāyā abhiprāyaṁ kiñcidapi te boddhuṁ na śekuḥ teṣāṁ nikaṭe'spaṣṭatavāt tasyaitāsāṁ kathānām āśayaṁ te jñātuṁ na śekuśca|</para>
  <para style="p">
    <verse number="35" style="v"/>atha tasmin yirīhoḥ purasyāntikaṁ prāpte kaścidandhaḥ pathaḥ pārśva upaviśya bhikṣām akarot</para>
  <para style="p">
    <verse number="36" style="v"/>sa lokasamūhasya gamanaśabdaṁ śrutvā tatkāraṇaṁ pṛṣṭavān|</para>
  <para style="p">
    <verse number="37" style="v"/>nāsaratīyayīśuryātīti lokairukte sa uccairvaktumārebhe,</para>
  <para style="p">
    <verse number="38" style="v"/>he dāyūdaḥ santāna yīśo māṁ dayasva|</para>
  <para style="p">
    <verse number="39" style="v"/>tatogragāminastaṁ maunī tiṣṭheti tarjayāmāsuḥ kintu sa punāruvan uvāca, he dāyūdaḥ santāna māṁ dayasva|</para>
  <para style="p">
    <verse number="40" style="v"/>tadā yīśuḥ sthagito bhūtvā svāntike tamānetum ādideśa|</para>
  <para style="p">
    <verse number="41" style="v"/>tataḥ sa tasyāntikam āgamat, tadā sa taṁ papraccha, tvaṁ kimicchasi? tvadarthamahaṁ kiṁ kariṣyāmi? sa uktavān, he prabho'haṁ draṣṭuṁ labhai|</para>
  <para style="p">
    <verse number="42" style="v"/>tadā yīśuruvāca, dṛṣṭiśaktiṁ gṛhāṇa tava pratyayastvāṁ svasthaṁ kṛtavān|</para>
  <para style="p">
    <verse number="43" style="v"/>tatastatkṣaṇāt tasya cakṣuṣī prasanne; tasmāt sa īśvaraṁ dhanyaṁ vadan tatpaścād yayau, tadālokya sarvve lokā īśvaraṁ praśaṁsitum ārebhire|</para>
  <chapter number="19" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yadā yīśu ryirīhopuraṁ praviśya tanmadhyena gacchaṁstadā</para>
  <para style="p">
    <verse number="2" style="v"/>sakkeyanāmā karasañcāyināṁ pradhāno dhanavāneko</para>
  <para style="p">
    <verse number="3" style="v"/>yīśuḥ kīdṛgiti draṣṭuṁ ceṣṭitavān kintu kharvvatvāllokasaṁghamadhye taddarśanamaprāpya</para>
  <para style="p">
    <verse number="4" style="v"/>yena pathā sa yāsyati tatpathe'gre dhāvitvā taṁ draṣṭum uḍumbaratarumāruroha|</para>
  <para style="p">
    <verse number="5" style="v"/>paścād yīśustatsthānam itvā ūrddhvaṁ vilokya taṁ dṛṣṭvāvādīt, he sakkeya tvaṁ śīghramavaroha mayādya tvadgehe vastavyaṁ|</para>
  <para style="p">
    <verse number="6" style="v"/>tataḥ sa śīghramavaruhya sāhlādaṁ taṁ jagrāha|</para>
  <para style="p">
    <verse number="7" style="v"/>tad dṛṣṭvā sarvve vivadamānā vaktumārebhire, sotithitvena duṣṭalokagṛhaṁ gacchati|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu sakkeyo daṇḍāyamāno vaktumārebhe, he prabho paśya mama yā sampattirasti tadarddhaṁ daridrebhyo dade, aparam anyāyaṁ kṛtvā kasmādapi yadi kadāpi kiñcit mayā gṛhītaṁ tarhi taccaturguṇaṁ dadāmi|</para>
  <para style="p">
    <verse number="9" style="v"/>tadā yīśustamuktavān ayamapi ibrāhīmaḥ santāno'taḥ kāraṇād adyāsya gṛhe trāṇamupasthitaṁ|</para>
  <para style="p">
    <verse number="10" style="v"/>yad hāritaṁ tat mṛgayituṁ rakṣituñca manuṣyaputra āgatavān|</para>
  <para style="p">
    <verse number="11" style="v"/>atha sa yirūśālamaḥ samīpa upātiṣṭhad īśvararājatvasyānuṣṭhānaṁ tadaiva bhaviṣyatīti lokairanvabhūyata, tasmāt sa śrotṛbhyaḥ punardṛṣṭāntakathām utthāpya kathayāmāsa|</para>
  <para style="p">
    <verse number="12" style="v"/>kopi mahālloko nijārthaṁ rājatvapadaṁ gṛhītvā punarāgantuṁ dūradeśaṁ jagāma|</para>
  <para style="p">
    <verse number="13" style="v"/>yātrākāle nijān daśadāsān āhūya daśasvarṇamudrā dattvā mamāgamanaparyyantaṁ vāṇijyaṁ kurutetyādideśa|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu tasya prajāstamavajñāya manuṣyamenam asmākamupari rājatvaṁ na kārayivyāma imāṁ vārttāṁ tannikaṭe prerayāmāsuḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>atha sa rājatvapadaṁ prāpyāgatavān ekaiko jano bāṇijyena kiṁ labdhavān iti jñātuṁ yeṣu dāseṣu mudrā arpayat tān āhūyānetum ādideśa|</para>
  <para style="p">
    <verse number="16" style="v"/>tadā prathama āgatya kathitavān, he prabho tava tayaikayā mudrayā daśamudrā labdhāḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>tataḥ sa uvāca tvamuttamo dāsaḥ svalpena viśvāsyo jāta itaḥ kāraṇāt tvaṁ daśanagarāṇām adhipo bhava|</para>
  <para style="p">
    <verse number="18" style="v"/>dvitīya āgatya kathitavān, he prabho tavaikayā mudrayā pañcamudrā labdhāḥ|</para>
  <para style="p">
    <verse number="19" style="v"/>tataḥ sa uvāca, tvaṁ pañcānāṁ nagarāṇāmadhipati rbhava|</para>
  <para style="p">
    <verse number="20" style="v"/>tatonya āgatya kathayāmāsa, he prabho paśya tava yā mudrā ahaṁ vastre baddhvāsthāpayaṁ seyaṁ|</para>
  <para style="p">
    <verse number="21" style="v"/>tvaṁ kṛpaṇo yannāsthāpayastadapi gṛhlāsi, yannāvapastadeva ca chinatsi tatohaṁ tvatto bhītaḥ|</para>
  <para style="p">
    <verse number="22" style="v"/>tadā sa jagāda, re duṣṭadāsa tava vākyena tvāṁ doṣiṇaṁ kariṣyāmi, yadahaṁ nāsthāpayaṁ tadeva gṛhlāmi, yadahaṁ nāvapañca tadeva chinadmi, etādṛśaḥ kṛpaṇohamiti yadi tvaṁ jānāsi,</para>
  <para style="p">
    <verse number="23" style="v"/>tarhi mama mudrā baṇijāṁ nikaṭe kuto nāsthāpayaḥ? tayā kṛte'ham āgatya kusīdena sārddhaṁ nijamudrā aprāpsyam|</para>
  <para style="p">
    <verse number="24" style="v"/>paścāt sa samīpasthān janān ājñāpayat asmāt mudrā ānīya yasya daśamudrāḥ santi tasmai datta|</para>
  <para style="p">
    <verse number="25" style="v"/>te procuḥ prabho'sya daśamudrāḥ santi|</para>
  <para style="p">
    <verse number="26" style="v"/>yuṣmānahaṁ vadāmi yasyāśraye vaddhate 'dhikaṁ tasmai dāyiṣyate, kintu yasyāśraye na varddhate tasya yadyadasti tadapi tasmān nāyiṣyate|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu mamādhipatitvasya vaśatve sthātum asammanyamānā ye mama ripavastānānīya mama samakṣaṁ saṁharata|</para>
  <para style="p">
    <verse number="28" style="v"/>ityupadeśakathāṁ kathayitvā sogragaḥ san yirūśālamapuraṁ yayau|</para>
  <para style="p">
    <verse number="29" style="v"/>tato baitphagībaithanīyāgrāmayoḥ samīpe jaitunādrerantikam itvā śiṣyadvayam ityuktvā preṣayāmāsa,</para>
  <para style="p">
    <verse number="30" style="v"/>yuvāmamuṁ sammukhasthagrāmaṁ praviśyaiva yaṁ kopi mānuṣaḥ kadāpi nārohat taṁ garddabhaśāvakaṁ baddhaṁ drakṣyathastaṁ mocayitvānayataṁ|</para>
  <para style="p">
    <verse number="31" style="v"/>tatra kuto mocayathaḥ? iti cet kopi vakṣyati tarhi vakṣyathaḥ prabheाratra prayojanam āste|</para>
  <para style="p">
    <verse number="32" style="v"/>tadā tau praritau gatvā tatkathāाnusāreṇa sarvvaṁ prāptau|</para>
  <para style="p">
    <verse number="33" style="v"/>gardabhaśāvakamocanakāle tatvāmina ūcuḥ, gardabhaśāvakaṁ kuto mocayathaḥ?</para>
  <para style="p">
    <verse number="34" style="v"/>tāvūcatuḥ prabhoratra prayojanam āste|</para>
  <para style="p">
    <verse number="35" style="v"/>paścāt tau taṁ gardabhaśāvakaṁ yīśorantikamānīya tatpṛṣṭhe nijavasanāni pātayitvā tadupari yīśumārohayāmāsatuḥ|</para>
  <para style="p">
    <verse number="36" style="v"/>atha yātrākāle lokāḥ pathi svavastrāṇi pātayitum ārebhire|</para>
  <para style="p">
    <verse number="37" style="v"/>aparaṁ jaitunādrerupatyakām itvā śiṣyasaṁghaḥ pūrvvadṛṣṭāni mahākarmmāṇi smṛtvā,</para>
  <para style="p">
    <verse number="38" style="v"/>yo rājā prabho rnāmnāyāti sa dhanyaḥ svarge kuśalaṁ sarvvocce jayadhvani rbhavatu, kathāmetāṁ kathayitvā sānandam ucairīśvaraṁ dhanyaṁ vaktumārebhe|</para>
  <para style="p">
    <verse number="39" style="v"/>tadā lokāraṇyamadhyasthāḥ kiyantaḥ phirūśinastat śrutvā yīśuṁ procuḥ, he upadeśaka svaśiṣyān tarjaya|</para>
  <para style="p">
    <verse number="40" style="v"/>sa uvāca, yuṣmānahaṁ vadāmi yadyamī nīravāstiṣṭhanti tarhi pāṣāṇā ucaiḥ kathāḥ kathayiṣyanti|</para>
  <para style="p">
    <verse number="41" style="v"/>paścāt tatpurāntikametya tadavalokya sāśrupātaṁ jagāda,</para>
  <para style="p">
    <verse number="42" style="v"/>hā hā cet tvamagre'jñāsyathāḥ, tavāsminneva dine vā yadi svamaṅgalam upālapsyathāḥ, tarhyuttamam abhaviṣyat, kintu kṣaṇesmin tattava dṛṣṭeragocaram bhavati|</para>
  <para style="p">
    <verse number="43" style="v"/>tvaṁ svatrāṇakāle na mano nyadhatthā iti heto ryatkāle tava ripavastvāṁ caturdikṣu prācīreṇa veṣṭayitvā rotsyanti</para>
  <para style="p">
    <verse number="44" style="v"/>bālakaiḥ sārddhaṁ bhūmisāt kariṣyanti ca tvanmadhye pāṣāṇaikopi pāṣāṇopari na sthāsyati ca, kāla īdṛśa upasthāsyati|</para>
  <para style="p">
    <verse number="45" style="v"/>atha madhyemandiraṁ praviśya tatratyān krayivikrayiṇo bahiṣkurvvan</para>
  <para style="p">
    <verse number="46" style="v"/>avadat madgṛhaṁ prārthanāgṛhamiti lipirāste kintu yūyaṁ tadeva cairāṇāṁ gahvaraṁ kurutha|</para>
  <para style="p">
    <verse number="47" style="v"/>paścāt sa pratyahaṁ madhyemandiram upadideśa; tataḥ pradhānayājakā adhyāpakāḥ prācīnāśca taṁ nāśayituṁ ciceṣṭire;</para>
  <para style="p">
    <verse number="48" style="v"/>kintu tadupadeśe sarvve lokā niviṣṭacittāḥ sthitāstasmāt te tatkarttuṁ nāvakāśaṁ prāpuḥ|</para>
  <chapter number="20" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>athaikadā yīśu rmanidare susaṁvādaṁ pracārayan lokānupadiśati, etarhi pradhānayājakā adhyāpakāḥ prāñcaśca tannikaṭamāgatya papracchuḥ</para>
  <para style="p">
    <verse number="2" style="v"/>kayājñayā tvaṁ karmmāṇyetāni karoṣi? ko vā tvāmājñāpayat? tadasmān vada|</para>
  <para style="p">
    <verse number="3" style="v"/>sa pratyuvāca, tarhi yuṣmānapi kathāmekāṁ pṛcchāmi tasyottaraṁ vadata|</para>
  <para style="p">
    <verse number="4" style="v"/>yohano majjanam īśvarasya mānuṣāṇāṁ vājñāto jātaṁ?</para>
  <para style="p">
    <verse number="5" style="v"/>tataste mitho vivicya jagaduḥ, yadīśvarasya vadāmastarhi taṁ kuto na pratyaita sa iti vakṣyati|</para>
  <para style="p">
    <verse number="6" style="v"/>yadi manuṣyasyeti vadāmastarhi sarvve lokā asmān pāṣāṇai rhaniṣyanti yato yohan bhaviṣyadvādīti sarvve dṛḍhaṁ jānanti|</para>
  <para style="p">
    <verse number="7" style="v"/>ataeva te pratyūcuḥ kasyājñayā jātam iti vaktuṁ na śaknumaḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>tadā yīśuravadat tarhi kayājñayā karmmāṇyetāti karomīti ca yuṣmān na vakṣyāmi|</para>
  <para style="p">
    <verse number="9" style="v"/>atha lokānāṁ sākṣāt sa imāṁ dṛṣṭāntakathāṁ vaktumārebhe, kaścid drākṣākṣetraṁ kṛtvā tat kṣetraṁ kṛṣīvalānāṁ hasteṣu samarpya bahukālārthaṁ dūradeśaṁ jagāma|</para>
  <para style="p">
    <verse number="10" style="v"/>atha phalakāle phalāni grahītu kṛṣīvalānāṁ samīpe dāsaṁ prāhiṇot kintu kṛṣīvalāstaṁ prahṛtya riktahastaṁ visasarjuḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>tataḥ sodhipatiḥ punaranyaṁ dāsaṁ preṣayāmāsa, te tamapi prahṛtya kuvyavahṛtya riktahastaṁ visasṛjuḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>tataḥ sa tṛtīyavāram anyaṁ prāhiṇot te tamapi kṣatāṅgaṁ kṛtvā bahi rnicikṣipuḥ|</para>
  <para style="p">
    <verse number="13" style="v"/>tadā kṣetrapati rvicārayāmāsa, mamedānīṁ kiṁ karttavyaṁ? mama priye putre prahite te tamavaśyaṁ dṛṣṭvā samādariṣyante|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu kṛṣīvalāstaṁ nirīkṣya parasparaṁ vivicya procuḥ, ayamuttarādhikārī āgacchatainaṁ hanmastatodhikārosmākaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="15" style="v"/>tataste taṁ kṣetrād bahi rnipātya jaghnustasmāt sa kṣetrapatistān prati kiṁ kariṣyati?</para>
  <para style="p">
    <verse number="16" style="v"/>sa āgatya tān kṛṣīvalān hatvā pareṣāṁ hasteṣu tatkṣetraṁ samarpayiṣyati; iti kathāṁ śrutvā te 'vadan etādṛśī ghaṭanā na bhavatu|</para>
  <para style="p">
    <verse number="17" style="v"/>kintu yīśustānavalokya jagāda, tarhi, sthapatayaḥ kariṣyanti grāvāṇaṁ yantu tucchakaṁ| pradhānaprastaraḥ koṇe sa eva hi bhaviṣyati| etasya śāstrīyavacanasya kiṁ tātparyyaṁ?</para>
  <para style="p">
    <verse number="18" style="v"/>aparaṁ tatpāṣāṇopari yaḥ patiṣyati sa bhaṁkṣyate kintu yasyopari sa pāṣāṇaḥ patiṣyati sa tena dhūlivac cūrṇībhaviṣyati|</para>
  <para style="p">
    <verse number="19" style="v"/>sosmākaṁ viruddhaṁ dṛṣṭāntamimaṁ kathitavān iti jñātvā pradhānayājakā adhyāpakāśca tadaiva taṁ dhartuṁ vavāñchuḥ kintu lokebhyo bibhyuḥ|</para>
  <para style="p">
    <verse number="20" style="v"/>ataeva taṁ prati satarkāḥ santaḥ kathaṁ tadvākyadoṣaṁ dhṛtvā taṁ deśādhipasya sādhuveśadhāriṇaścarān tasya samīpe preṣayāmāsuḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā te taṁ papracchuḥ, he upadeśaka bhavān yathārthaṁ kathayan upadiśati, kamapyanapekṣya satyatvenaiśvaraṁ mārgamupadiśati, vayametajjānīmaḥ|</para>
  <para style="p">
    <verse number="22" style="v"/>kaisararājāya karosmābhi rdeyo na vā?</para>
  <para style="p">
    <verse number="23" style="v"/>sa teṣāṁ vañcanaṁ jñātvāvadat kuto māṁ parīkṣadhve? māṁ mudrāmekaṁ darśayata|</para>
  <para style="p">
    <verse number="24" style="v"/>iha likhitā mūrtiriyaṁ nāma ca kasya? te'vadan kaisarasya|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā sa uvāca, tarhi kaisarasya dravyaṁ kaisarāya datta; īśvarasya tu dravyamīśvarāya datta|</para>
  <para style="p">
    <verse number="26" style="v"/>tasmāllokānāṁ sākṣāt tatkathāyāḥ kamapi doṣaṁ dhartumaprāpya te tasyottarād āścaryyaṁ manyamānā mauninastasthuḥ|</para>
  <para style="p">
    <verse number="27" style="v"/>aparañca śmaśānādutthānānaṅgīkāriṇāṁ sidūkināṁ kiyanto janā āgatya taṁ papracchuḥ,</para>
  <para style="p">
    <verse number="28" style="v"/>he upadeśaka śāstre mūsā asmān pratīti lilekha yasya bhrātā bhāryyāyāṁ satyāṁ niḥsantāno mriyate sa tajjāyāṁ vivahya tadvaṁśam utpādayiṣyati|</para>
  <para style="p">
    <verse number="29" style="v"/>tathāca kecit sapta bhrātara āsan teṣāṁ jyeṣṭho bhrātā vivahya nirapatyaḥ prāṇān jahau|</para>
  <para style="p">
    <verse number="30" style="v"/>atha dvitīyastasya jāyāṁ vivahya nirapatyaḥ san mamāra| tṛtīyaśca tāmeva vyuvāha;</para>
  <para style="p">
    <verse number="31" style="v"/>itthaṁ sapta bhrātarastāmeva vivahya nirapatyāḥ santo mamruḥ|</para>
  <para style="p">
    <verse number="32" style="v"/>śeṣe sā strī ca mamāra|</para>
  <para style="p">
    <verse number="33" style="v"/>ataeva śmaśānādutthānakāle teṣāṁ saptajanānāṁ kasya sā bhāryyā bhaviṣyati? yataḥ sā teṣāṁ saptānāmeva bhāryyāsīt|</para>
  <para style="p">
    <verse number="34" style="v"/>tadā yīśuḥ pratyuvāca, etasya jagato lokā vivahanti vāgdattāśca bhavanti</para>
  <para style="p">
    <verse number="35" style="v"/>kintu ye tajjagatprāptiyogyatvena gaṇitāṁ bhaviṣyanti śmaśānāccotthāsyanti te na vivahanti vāgdattāśca na bhavanti,</para>
  <para style="p">
    <verse number="36" style="v"/>te puna rna mriyante kintu śmaśānādutthāpitāḥ santa īśvarasya santānāḥ svargīyadūtānāṁ sadṛśāśca bhavanti|</para>
  <para style="p">
    <verse number="37" style="v"/>adhikantu mūsāḥ stambopākhyāne parameśvara ībrāhīma īśvara ishāka īśvaro yākūbaśceśvara ityuktvā mṛtānāṁ śmaśānād utthānasya pramāṇaṁ lilekha|</para>
  <para style="p">
    <verse number="38" style="v"/>ataeva ya īśvaraḥ sa mṛtānāṁ prabhu rna kintu jīvatāmeva prabhuḥ, tannikaṭe sarvve jīvantaḥ santi|</para>
  <para style="p">
    <verse number="39" style="v"/>iti śrutvā kiyantodhyāpakā ūcuḥ, he upadeśaka bhavān bhadraṁ pratyuktavān|</para>
  <para style="p">
    <verse number="40" style="v"/>itaḥ paraṁ taṁ kimapi praṣṭaṁ teṣāṁ pragalbhatā nābhūt|</para>
  <para style="p">
    <verse number="41" style="v"/>paścāt sa tān uvāca, yaḥ khrīṣṭaḥ sa dāyūdaḥ santāna etāṁ kathāṁ lokāḥ kathaṁ kathayanti?</para>
  <para style="p">
    <verse number="42" style="v"/>yataḥ mama prabhumidaṁ vākyamavadat parameśvaraḥ| tava śatrūnahaṁ yāvat pādapīṭhaṁ karomi na| tāvat kālaṁ madīye tvaṁ dakṣapārśva upāviśa|</para>
  <para style="p">
    <verse number="43" style="v"/>iti kathāṁ dāyūd svayaṁ gītagranthe'vadat|</para>
  <para style="p">
    <verse number="44" style="v"/>ataeva yadi dāyūd taṁ prabhuṁ vadati, tarhi sa kathaṁ tasya santāno bhavati?</para>
  <para style="p">
    <verse number="45" style="v"/>paścād yīśuḥ sarvvajanānāṁ karṇagocare śiṣyānuvāca,</para>
  <para style="p">
    <verse number="46" style="v"/>ye'dhyāpakā dīrghaparicchadaṁ paridhāya bhramanti, haṭṭāpaṇayo rnamaskāre bhajanagehasya proccāsane bhojanagṛhasya pradhānasthāne ca prīyante</para>
  <para style="p">
    <verse number="47" style="v"/>vidhavānāṁ sarvvasvaṁ grasitvā chalena dīrghakālaṁ prārthayante ca teṣu sāvadhānā bhavata, teṣāmugradaṇḍo bhaviṣyati|</para>
  <chapter number="21" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha dhanilokā bhāṇḍāgāre dhanaṁ nikṣipanti sa tadeva paśyati,</para>
  <para style="p">
    <verse number="2" style="v"/>etarhi kāciddīnā vidhavā paṇadvayaṁ nikṣipati tad dadarśa|</para>
  <para style="p">
    <verse number="3" style="v"/>tato yīśuruvāca yuṣmānahaṁ yathārthaṁ vadāmi, daridreyaṁ vidhavā sarvvebhyodhikaṁ nyakṣepsīt,</para>
  <para style="p">
    <verse number="4" style="v"/>yatonye svaprājyadhanebhya īśvarāya kiñcit nyakṣepsuḥ, kintu daridreyaṁ vidhavā dinayāpanārthaṁ svasya yat kiñcit sthitaṁ tat sarvvaṁ nyakṣepsīt|</para>
  <para style="p">
    <verse number="5" style="v"/>aparañca uttamaprastarairutsṛṣṭavyaiśca mandiraṁ suśobhatetarāṁ kaiścidityukte sa pratyuvāca</para>
  <para style="p">
    <verse number="6" style="v"/>yūyaṁ yadidaṁ nicayanaṁ paśyatha, asya pāṣāṇaikopyanyapāṣāṇopari na sthāsyati, sarvve bhūsādbhaviṣyanti kāloyamāyāti|</para>
  <para style="p">
    <verse number="7" style="v"/>tadā te papracchuḥ, he guro ghaṭanedṛśī kadā bhaviṣyati? ghaṭanāyā etasyasaścihnaṁ vā kiṁ bhaviṣyati?</para>
  <para style="p">
    <verse number="8" style="v"/>tadā sa jagāda, sāvadhānā bhavata yathā yuṣmākaṁ bhramaṁ kopi na janayati, khīṣṭohamityuktvā mama nāmrā bahava upasthāsyanti sa kālaḥ prāyeṇopasthitaḥ, teṣāṁ paścānmā gacchata|</para>
  <para style="p">
    <verse number="9" style="v"/>yuddhasyopaplavasya ca vārttāṁ śrutvā mā śaṅkadhvaṁ, yataḥ prathamam etā ghaṭanā avaśyaṁ bhaviṣyanti kintu nāpāte yugānto bhaviṣyati|</para>
  <para style="p">
    <verse number="10" style="v"/>aparañca kathayāmāsa, tadā deśasya vipakṣatvena deśo rājyasya vipakṣatvena rājyam utthāsyati,</para>
  <para style="p">
    <verse number="11" style="v"/>nānāsthāneṣu mahābhūkampo durbhikṣaṁ mārī ca bhaviṣyanti, tathā vyomamaṇḍalasya bhayaṅkaradarśanānyaścaryyalakṣaṇāni ca prakāśayiṣyante|</para>
  <para style="p">
    <verse number="12" style="v"/>kintu sarvvāsāmetāsāṁ ghaṭanānāṁ pūrvvaṁ lokā yuṣmān dhṛtvā tāḍayiṣyanti, bhajanālaye kārāyāñca samarpayiṣyanti mama nāmakāraṇād yuṣmān bhūpānāṁ śāsakānāñca sammukhaṁ neṣyanti ca|</para>
  <para style="p">
    <verse number="13" style="v"/>sākṣyārtham etāni yuṣmān prati ghaṭiṣyante|</para>
  <para style="p">
    <verse number="14" style="v"/>tadā kimuttaraṁ vaktavyam etat na cintayiṣyāma iti manaḥsu niścitanuta|</para>
  <para style="p">
    <verse number="15" style="v"/>vipakṣā yasmāt kimapyuttaram āpattiñca karttuṁ na śakṣyanti tādṛśaṁ vākpaṭutvaṁ jñānañca yuṣmabhyaṁ dāsyāmi|</para>
  <para style="p">
    <verse number="16" style="v"/>kiñca yūyaṁ pitrā mātrā bhrātrā bandhunā jñātyā kuṭumbena ca parakareṣu samarpayiṣyadhve; tataste yuṣmākaṁ kañcana kañcana ghātayiṣyanti|</para>
  <para style="p">
    <verse number="17" style="v"/>mama nāmnaḥ kāraṇāt sarvvai rmanuṣyai ryūyam ṛtīyiṣyadhve|</para>
  <para style="p">
    <verse number="18" style="v"/>kintu yuṣmākaṁ śiraḥkeśaikopi na vinaṁkṣyati,</para>
  <para style="p">
    <verse number="19" style="v"/>tasmādeva dhairyyamavalambya svasvaprāṇān rakṣata|</para>
  <para style="p">
    <verse number="20" style="v"/>aparañca yirūśālampuraṁ sainyaveṣṭitaṁ vilokya tasyocchinnatāyāḥ samayaḥ samīpa ityavagamiṣyatha|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā yihūdādeśasthā lokāḥ parvvataṁ palāyantāṁ, ye ca nagare tiṣṭhanti te deśāntaraṁ palāyantā, ye ca grāme tiṣṭhanti te nagaraṁ na praviśantu,</para>
  <para style="p">
    <verse number="22" style="v"/>yatastadā samucitadaṇḍanāya dharmmapustake yāni sarvvāṇi likhitāni tāni saphalāni bhaviṣyanti|</para>
  <para style="p">
    <verse number="23" style="v"/>kintu yā yāstadā garbhavatyaḥ stanyadāvyaśca tāmāṁ durgati rbhaviṣyati, yata etāllokān prati kopo deśe ca viṣamadurgati rghaṭiṣyate|</para>
  <para style="p">
    <verse number="24" style="v"/>vastutastu te khaṅgadhāraparivvaṅgaṁ lapsyante baddhāḥ santaḥ sarvvadeśeṣu nāyiṣyante ca kiñcānyadeśīyānāṁ samayopasthitiparyyantaṁ yirūśālampuraṁ taiḥ padatalai rdalayiṣyate|</para>
  <para style="p">
    <verse number="25" style="v"/>sūryyacandranakṣatreṣu lakṣaṇādi bhaviṣyanti, bhuvi sarvvadeśīyānāṁ duḥkhaṁ cintā ca sindhau vīcīnāṁ tarjanaṁ garjanañca bhaviṣyanti|</para>
  <para style="p">
    <verse number="26" style="v"/>bhūbhau bhāvighaṭanāṁ cintayitvā manujā bhiyāmṛtakalpā bhaviṣyanti, yato vyomamaṇḍale tejasvino dolāyamānā bhaviṣyanti|</para>
  <para style="p">
    <verse number="27" style="v"/>tadā parākrameṇā mahātejasā ca meghārūḍhaṁ manuṣyaputram āyāntaṁ drakṣyanti|</para>
  <para style="p">
    <verse number="28" style="v"/>kintvetāsāṁ ghaṭanānāmārambhe sati yūyaṁ mastakānyuttolya ūrdadhvaṁ drakṣyatha, yato yuṣmākaṁ mukteḥ kālaḥ savidho bhaviṣyati|</para>
  <para style="p">
    <verse number="29" style="v"/>tatastenaitadṛṣṭāntakathā kathitā, paśyata uḍumbarādivṛkṣāṇāṁ</para>
  <para style="p">
    <verse number="30" style="v"/>navīnapatrāṇi jātānīti dṛṣṭvā nidāvakāla upasthita iti yathā yūyaṁ jñātuṁ śaknutha,</para>
  <para style="p">
    <verse number="31" style="v"/>tathā sarvvāsāmāsāṁ ghaṭanānām ārambhe dṛṣṭe satīśvarasya rājatvaṁ nikaṭam ityapi jñāsyatha|</para>
  <para style="p">
    <verse number="32" style="v"/>yuṣmānahaṁ yathārthaṁ vadāmi, vidyamānalokānāmeṣāṁ gamanāt pūrvvam etāni ghaṭiṣyante|</para>
  <para style="p">
    <verse number="33" style="v"/>nabhobhuvorlopo bhaviṣyati mama vāk tu kadāpi luptā na bhaviṣyati|</para>
  <para style="p">
    <verse number="34" style="v"/>ataeva viṣamāśanena pānena ca sāṁmārikacintābhiśca yuṣmākaṁ citteṣu matteṣu taddinam akasmād yuṣmān prati yathā nopatiṣṭhati tadarthaṁ sveṣu sāvadhānāstiṣṭhata|</para>
  <para style="p">
    <verse number="35" style="v"/>pṛthivīsthasarvvalokān prati taddinam unmātha iva upasthāsyati|</para>
  <para style="p">
    <verse number="36" style="v"/>yathā yūyam etadbhāvighaṭanā uttarttuṁ manujasutasya sammukhe saṁsthātuñca yogyā bhavatha kāraṇādasmāt sāvadhānāḥ santo nirantaraṁ prārthayadhvaṁ|</para>
  <para style="p">
    <verse number="37" style="v"/>aparañca sa divā mandira upadiśya rācai jaitunādriṁ gatvātiṣṭhat|</para>
  <para style="p">
    <verse number="38" style="v"/>tataḥ pratyūṣe lākāstatkathāṁ śrotuṁ mandire tadantikam āgacchan|</para>
  <chapter number="22" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparañca kiṇvaśūnyapūpotsavasya kāla upasthite</para>
  <para style="p">
    <verse number="2" style="v"/>pradhānayājakā adhyāyakāśca yathā taṁ hantuṁ śaknuvanti tathopāyām aceṣṭanta kintu lokebhyo bibhyuḥ|</para>
  <para style="p">
    <verse number="3" style="v"/>etastin samaye dvādaśaśiṣyeṣu gaṇita īṣkariyotīyarūḍhimān yo yihūdāstasyāntaḥkaraṇaṁ śaitānāśritatvāt</para>
  <para style="p">
    <verse number="4" style="v"/>sa gatvā yathā yīśuṁ teṣāṁ kareṣu samarpayituṁ śaknoti tathā mantraṇāṁ pradhānayājakaiḥ senāpatibhiśca saha cakāra|</para>
  <para style="p">
    <verse number="5" style="v"/>tena te tuṣṭāstasmai mudrāṁ dātuṁ paṇaṁ cakruḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>tataḥ soṅgīkṛtya yathā lokānāmagocare taṁ parakareṣu samarpayituṁ śaknoti tathāvakāśaṁ ceṣṭitumārebhe|</para>
  <para style="p">
    <verse number="7" style="v"/>atha kiṇvaśūnyapūpotmavadine, arthāt yasmin dine nistārotsavasya meṣo hantavyastasmin dine</para>
  <para style="p">
    <verse number="8" style="v"/>yīśuḥ pitaraṁ yohanañcāhūya jagāda, yuvāṁ gatvāsmākaṁ bhojanārthaṁ nistārotsavasya dravyāṇyāsādayataṁ|</para>
  <para style="p">
    <verse number="9" style="v"/>tadā tau papracchatuḥ kucāsādayāvo bhavataḥ kecchā?</para>
  <para style="p">
    <verse number="10" style="v"/>tadā sovādīt, nagare praviṣṭe kaścijjalakumbhamādāya yuvāṁ sākṣāt kariṣyati sa yanniveśanaṁ praviśati yuvāmapi tanniveśanaṁ tatpaścāditvā niveśanapatim iti vākyaṁ vadataṁ,</para>
  <para style="p">
    <verse number="11" style="v"/>yatrāhaṁ nistārotsavasya bhojyaṁ śiṣyaiḥ sārddhaṁ bhoktuṁ śaknomi sātithiśālāा kutra? kathāmimāṁ prabhustvāṁ pṛcchati|</para>
  <para style="p">
    <verse number="12" style="v"/>tataḥ sa jano dvitīyaprakoṣṭhīyam ekaṁ śastaṁ koṣṭhaṁ darśayiṣyati tatra bhojyamāsādayataṁ|</para>
  <para style="p">
    <verse number="13" style="v"/>tatastau gatvā tadvākyānusāreṇa sarvvaṁ dṛṣdvā tatra nistārotsavīyaṁ bhojyamāsādayāmāsatuḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>atha kāla upasthite yīśu rdvādaśabhiḥ preritaiḥ saha bhoktumupaviśya kathitavān</para>
  <para style="p">
    <verse number="15" style="v"/>mama duḥkhabhogāt pūrvvaṁ yubhābhiḥ saha nistārotsavasyaitasya bhojyaṁ bhoktuṁ mayātivāñchā kṛtā|</para>
  <para style="p">
    <verse number="16" style="v"/>yuṣmān vadāmi, yāvatkālam īśvararājye bhojanaṁ na kariṣye tāvatkālam idaṁ na bhokṣye|</para>
  <para style="p">
    <verse number="17" style="v"/>tadā sa pānapātramādāya īśvarasya guṇān kīrttayitvā tebhyo datvāvadat, idaṁ gṛhlīta yūyaṁ vibhajya pivata|</para>
  <para style="p">
    <verse number="18" style="v"/>yuṣmān vadāmi yāvatkālam īśvararājatvasya saṁsthāpanaṁ na bhavati tāvad drākṣāphalarasaṁ na pāsyāmi|</para>
  <para style="p">
    <verse number="19" style="v"/>tataḥ pūpaṁ gṛhītvā īśvaraguṇān kīrttayitvā bhaṅktā tebhyo datvāvadat, yuṣmadarthaṁ samarpitaṁ yanmama vapustadidaṁ, etat karmma mama smaraṇārthaṁ kurudhvaṁ|</para>
  <para style="p">
    <verse number="20" style="v"/>atha bhojanānte tādṛśaṁ pātraṁ gṛhītvāvadat, yuṣmatkṛte pātitaṁ yanmama raktaṁ tena nirṇītanavaniyamarūpaṁ pānapātramidaṁ|</para>
  <para style="p">
    <verse number="21" style="v"/>paśyata yo māṁ parakareṣu samarpayiṣyati sa mayā saha bhojanāsana upaviśati|</para>
  <para style="p">
    <verse number="22" style="v"/>yathā nirūpitamāste tadanusāreṇā manuṣyapuुtrasya gati rbhaviṣyati kintu yastaṁ parakareṣu samarpayiṣyati tasya santāpo bhaviṣyati|</para>
  <para style="p">
    <verse number="23" style="v"/>tadā teṣāṁ ko jana etat karmma kariṣyati tat te parasparaṁ praṣṭumārebhire|</para>
  <para style="p">
    <verse number="24" style="v"/>aparaṁ teṣāṁ ko janaḥ śreṣṭhatvena gaṇayiṣyate, atrārthe teṣāṁ vivādobhavat|</para>
  <para style="p">
    <verse number="25" style="v"/>asmāt kāraṇāt sovadat, anyadeśīyānāṁ rājānaḥ prajānāmupari prabhutvaṁ kurvvanti dāruṇaśāsanaṁ kṛtvāpi te bhūpatitvena vikhyātā bhavanti ca|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu yuṣmākaṁ tathā na bhaviṣyati, yo yuṣmākaṁ śreṣṭho bhaviṣyati sa kaniṣṭhavad bhavatu, yaśca mukhyo bhaviṣyati sa sevakavadbhavatu|</para>
  <para style="p">
    <verse number="27" style="v"/>bhojanopaviṣṭaparicārakayoḥ kaḥ śreṣṭhaḥ? yo bhojanāyopaviśati sa kiṁ śreṣṭho na bhavati? kintu yuṣmākaṁ madhye'haṁ paricāraka̮ivāsmi|</para>
  <para style="p">
    <verse number="28" style="v"/>aparañca yuyaṁ mama parīkṣākāle prathamamārabhya mayā saha sthitā</para>
  <para style="p">
    <verse number="29" style="v"/>etatkāraṇāt pitrā yathā madarthaṁ rājyamekaṁ nirūpitaṁ tathāhamapi yuṣmadarthaṁ rājyaṁ nirūpayāmi|</para>
  <para style="p">
    <verse number="30" style="v"/>tasmān mama rājye bhojanāsane ca bhojanapāne kariṣyadhve siṁhāsaneṣūpaviśya cesrāyelīyānāṁ dvādaśavaṁśānāṁ vicāraṁ kariṣyadhve|</para>
  <para style="p">
    <verse number="31" style="v"/>aparaṁ prabhuruvāca, he śimon paśya tita̮unā dhānyānīva yuṣmān śaitān cālayitum aicchat,</para>
  <para style="p">
    <verse number="32" style="v"/>kintu tava viśvāsasya lopo yathā na bhavati etat tvadarthaṁ prārthitaṁ mayā, tvanmanasi parivarttite ca bhrātṛṇāṁ manāṁsi sthirīkuru|</para>
  <para style="p">
    <verse number="33" style="v"/>tadā sovadat, he prabhohaṁ tvayā sārddhaṁ kārāṁ mṛtiñca yātuṁ majjitosmi|</para>
  <para style="p">
    <verse number="34" style="v"/>tataḥ sa uvāca, he pitara tvāṁ vadāmi, adya kukkuṭaravāt pūrvvaṁ tvaṁ matparicayaṁ vāratrayam apahvoṣyase|</para>
  <para style="p">
    <verse number="35" style="v"/>aparaṁ sa papraccha, yadā mudrāsampuṭaṁ khādyapātraṁ pādukāñca vinā yuṣmān prāhiṇavaṁ tadā yuṣmākaṁ kasyāpi nyūnatāsīt? te procuḥ kasyāpi na|</para>
  <para style="p">
    <verse number="36" style="v"/>tadā sovadat kintvidānīṁ mudrāsampuṭaṁ khādyapātraṁ vā yasyāsti tena tadgrahītavyaṁ, yasya ca kṛpāṇoे nāsti tena svavastraṁ vikrīya sa kretavyaḥ|</para>
  <para style="p">
    <verse number="37" style="v"/>yato yuṣmānahaṁ vadāmi, aparādhijanaiḥ sārddhaṁ gaṇitaḥ sa bhaviṣyati| idaṁ yacchāstrīyaṁ vacanaṁ likhitamasti tanmayi phaliṣyati yato mama sambandhīyaṁ sarvvaṁ setsyati|</para>
  <para style="p">
    <verse number="38" style="v"/>tadā te procuḥ prabho paśya imau kṛpāṇau| tataḥ sovadad etau yatheṣṭau|</para>
  <para style="p">
    <verse number="39" style="v"/>atha sa tasmādvahi rgatvā svācārānusāreṇa jaitunanāmādriṁ jagāma śiṣyāśca tatpaścād yayuḥ|</para>
  <para style="p">
    <verse number="40" style="v"/>tatropasthāya sa tānuvāca, yathā parīkṣāyāṁ na patatha tadarthaṁ prārthayadhvaṁ|</para>
  <para style="p">
    <verse number="41" style="v"/>paścāt sa tasmād ekaśarakṣepād bahi rgatvā jānunī pātayitvā etat prārthayāñcakre,</para>
  <para style="p">
    <verse number="42" style="v"/>he pita ryadi bhavān sammanyate tarhi kaṁsamenaṁ mamāntikād dūraya kintu madicchānurūpaṁ na tvadicchānurūpaṁ bhavatu|</para>
  <para style="p">
    <verse number="43" style="v"/>tadā tasmai śaktiṁ dātuṁ svargīyadūto darśanaṁ dadau|</para>
  <para style="p">
    <verse number="44" style="v"/>paścāt sotyantaṁ yātanayā vyākulo bhūtvā punardṛḍhaṁ prārthayāñcakre, tasmād bṛhacchoṇitabindava iva tasya svedabindavaḥ pṛthivyāṁ patitumārebhire|</para>
  <para style="p">
    <verse number="45" style="v"/>atha prārthanāta utthāya śiṣyāṇāṁ samīpametya tān manoduḥkhino nidritān dṛṣṭvāvadat</para>
  <para style="p">
    <verse number="46" style="v"/>kuto nidrātha? parīkṣāyām apatanārthaṁ prarthayadhvaṁ|</para>
  <para style="p">
    <verse number="47" style="v"/>etatkathāyāḥ kathanakāle dvādaśaśiṣyāṇāṁ madhye gaṇito yihūdānāmā janatāsahitasteṣām agre calitvā yīśoścumbanārthaṁ tadantikam āyayau|</para>
  <para style="p">
    <verse number="48" style="v"/>tadā yīśuruvāca, he yihūdā kiṁ cumbanena manuṣyaputraṁ parakareṣu samarpayasi?</para>
  <para style="p">
    <verse number="49" style="v"/>tadā yadyad ghaṭiṣyate tadanumāya saṅgibhiruktaṁ, he prabho vayaṁ ki khaṅgena ghātayiṣyāmaḥ?</para>
  <para style="p">
    <verse number="50" style="v"/>tata ekaḥ karavālenāhatya pradhānayājakasya dāsasya dakṣiṇaṁ karṇaṁ ciccheda|</para>
  <para style="p">
    <verse number="51" style="v"/>adhūnā nivarttasva ityuktvā yīśustasya śrutiṁ spṛṣṭvā svasyaṁ cakāra|</para>
  <para style="p">
    <verse number="52" style="v"/>paścād yīśuḥ samīpasthān pradhānayājakān mandirasya senāpatīn prācīnāṁśca jagāda, yūyaṁ kṛpāṇān yaṣṭīṁśca gṛhītvā māṁ kiṁ coraṁ dharttumāyātāḥ?</para>
  <para style="p">
    <verse number="53" style="v"/>yadāhaṁ yuṣmābhiḥ saha pratidinaṁ mandire'tiṣṭhaṁ tadā māṁ dharttaṁ na pravṛttāḥ, kintvidānīṁ yuṣmākaṁ samayondhakārasya cādhipatyamasti|</para>
  <para style="p">
    <verse number="54" style="v"/>atha te taṁ dhṛtvā mahāyājakasya niveśanaṁ ninyuḥ| tataḥ pitaro dūre dūre paścāditvā</para>
  <para style="p">
    <verse number="55" style="v"/>bṛhatkoṣṭhasya madhye yatrāgniṁ jvālayitvā lokāḥ sametyopaviṣṭāstatra taiḥ sārddham upaviveśa|</para>
  <para style="p">
    <verse number="56" style="v"/>atha vahnisannidhau samupaveśakāle kāciddāsī mano niviśya taṁ nirīkṣyāvadat pumānayaṁ tasya saṅge'sthāt|</para>
  <para style="p">
    <verse number="57" style="v"/>kintu sa tad apahnutyāvādīt he nāri tamahaṁ na paricinomi|</para>
  <para style="p">
    <verse number="58" style="v"/>kṣaṇāntare'nyajanastaṁ dṛṣṭvābravīt tvamapi teṣāṁ nikarasyaikajanosi| pitaraḥ pratyuvāca he nara nāhamasmi|</para>
  <para style="p">
    <verse number="59" style="v"/>tataḥ sārddhadaṇḍadvayāt paraṁ punaranyo jano niścitya babhāṣe, eṣa tasya saṅgīti satyaṁ yatoyaṁ gālīlīyo lokaḥ|</para>
  <para style="p">
    <verse number="60" style="v"/>tadā pitara uvāca he nara tvaṁ yad vadami tadahaṁ boddhuṁ na śaknomi, iti vākye kathitamātre kukkuṭo rurāva|</para>
  <para style="p">
    <verse number="61" style="v"/>tadā prabhuṇā vyādhuṭya pitare nirīkṣite kṛkavākuravāt pūrvvaṁ māṁ trirapahnoṣyase iti pūrvvoktaṁ tasya vākyaṁ pitaraḥ smṛtvā</para>
  <para style="p">
    <verse number="62" style="v"/>bahirgatvā mahākhedena cakranda|</para>
  <para style="p">
    <verse number="63" style="v"/>tadā yai ryīśurdhṛtaste tamupahasya praharttumārebhire|</para>
  <para style="p">
    <verse number="64" style="v"/>vastreṇa tasya dṛśau baddhvā kapole capeṭāghātaṁ kṛtvā papracchuḥ, kaste kapole capeṭāghātaṁ kṛtavāna? gaṇayitvā tad vada|</para>
  <para style="p">
    <verse number="65" style="v"/>tadanyat tadviruddhaṁ bahunindāvākyaṁ vaktumārebhire|</para>
  <para style="p">
    <verse number="66" style="v"/>atha prabhāte sati lokaprāñcaḥ pradhānayājakā adhyāpakāśca sabhāṁ kṛtvā madhyesabhaṁ yīśumānīya papracchuḥ, tvam abhiṣikatosi na vāsmān vada|</para>
  <para style="p">
    <verse number="67" style="v"/>sa pratyuvāca, mayā tasminnukte'pi yūyaṁ na viśvasiṣyatha|</para>
  <para style="p">
    <verse number="68" style="v"/>kasmiṁścidvākye yuṣmān pṛṣṭe'pi māṁ na taduttaraṁ vakṣyatha na māṁ tyakṣyatha ca|</para>
  <para style="p">
    <verse number="69" style="v"/>kintvitaḥ paraṁ manujasutaḥ sarvvaśaktimata īśvarasya dakṣiṇe pārśve samupavekṣyati|</para>
  <para style="p">
    <verse number="70" style="v"/>tataste papracchuḥ, rtiha tvamīśvarasya putraḥ? sa kathayāmāsa, yūyaṁ yathārthaṁ vadatha sa evāhaṁ|</para>
  <para style="p">
    <verse number="71" style="v"/>tadā te sarvve kathayāmāsuḥ, rtiha sākṣye'nsasmin asmākaṁ kiṁ prayojanaṁ? asya svamukhādeva sākṣyaṁ prāptam|</para>
  <chapter number="23" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ sabhāsthāḥ sarvvalokā utthāya taṁ pīlātasammukhaṁ nītvāprodya vaktumārebhire,</para>
  <para style="p">
    <verse number="2" style="v"/>svamabhiṣiktaṁ rājānaṁ vadantaṁ kaimararājāya karadānaṁ niṣedhantaṁ rājyaviparyyayaṁ kurttuṁ pravarttamānam ena prāptā vayaṁ|</para>
  <para style="p">
    <verse number="3" style="v"/>tadā pīlātastaṁ pṛṣṭavān tvaṁ kiṁ yihūdīyānāṁ rājā? sa pratyuvāca tvaṁ satyamuktavān|</para>
  <para style="p">
    <verse number="4" style="v"/>tadā pīlātaḥ pradhānayājakādilokān jagād, ahametasya kamapyaparādhaṁ nāptavān|</para>
  <para style="p">
    <verse number="5" style="v"/>tataste punaḥ sāhamino bhūtvāvadan, eṣa gālīla etatsthānaparyyante sarvvasmin yihūdādeśe sarvvāllokānupadiśya kupravṛttiṁ grāhītavān|</para>
  <para style="p">
    <verse number="6" style="v"/>tadā pīlāto gālīlapradeśasya nāma śrutvā papraccha, kimayaṁ gālīlīyo lokaḥ?</para>
  <para style="p">
    <verse number="7" style="v"/>tataḥ sa gālīlpradeśīyaherodrājasya tadā sthitestasya samīpe yīśuṁ preṣayāmāsa|</para>
  <para style="p">
    <verse number="8" style="v"/>tadā herod yīśuṁ vilokya santutoṣa, yataḥ sa tasya bahuvṛttāntaśravaṇāt tasya kiñi्cadāścaryyakarmma paśyati ityāśāṁ kṛtvā bahukālamārabhya taṁ draṣṭuṁ prayāsaṁ kṛtavān|</para>
  <para style="p">
    <verse number="9" style="v"/>tasmāt taṁ bahukathāḥ papraccha kintu sa tasya kasyāpi vākyasya pratyuttaraṁ novāca|</para>
  <para style="p">
    <verse number="10" style="v"/>atha pradhānayājakā adhyāpakāśca prottiṣṭhantaḥ sāhasena tamapavadituṁ prārebhire|</para>
  <para style="p">
    <verse number="11" style="v"/>herod tasya senāgaṇaśca tamavajñāya upahāsatvena rājavastraṁ paridhāpya punaḥ pīlātaṁ prati taṁ prāhiṇot|</para>
  <para style="p">
    <verse number="12" style="v"/>pūrvvaṁ herodpīlātayoḥ parasparaṁ vairabhāva āsīt kintu taddine dvayo rmelanaṁ jātam|</para>
  <para style="p">
    <verse number="13" style="v"/>paścāt pīlātaḥ pradhānayājakān śāsakān lokāṁśca yugapadāhūya babhāṣe,</para>
  <para style="p">
    <verse number="14" style="v"/>rājyaviparyyayakārakoyam ityuktvā manuṣyamenaṁ mama nikaṭamānaiṣṭa kintu paśyata yuṣmākaṁ samakṣam asya vicāraṁ kṛtvāpi proktāpavādānurūpeṇāsya kopyaparādhaḥ sapramāṇo na jātaḥ,</para>
  <para style="p">
    <verse number="15" style="v"/>yūyañca herodaḥ sannidhau preṣitā mayā tatrāsya kopyaparādhastenāpi na prāptaḥ|paśyatānena vadhaheेtukaṁ kimapi nāparāddhaṁ|</para>
  <para style="p">
    <verse number="16" style="v"/>tasmādenaṁ tāḍayitvā vihāsyāmi|</para>
  <para style="p">
    <verse number="17" style="v"/>tatrotsave teṣāmeko mocayitavyaḥ|</para>
  <para style="p">
    <verse number="18" style="v"/>iti hetoste proccairekadā procuḥ, enaṁ dūrīkṛtya barabbānāmānaṁ mocaya|</para>
  <para style="p">
    <verse number="19" style="v"/>sa barabbā nagara upaplavavadhāparādhābhyāṁ kārāyāṁ baddha āsīt|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu pīlāto yīśuṁ mocayituṁ vāñchan punastānuvāca|</para>
  <para style="p">
    <verse number="21" style="v"/>tathāpyenaṁ kruśe vyadha kruśe vyadheti vadantaste ruruvuḥ|</para>
  <para style="p">
    <verse number="22" style="v"/>tataḥ sa tṛtīyavāraṁ jagāda kutaḥ? sa kiṁ karmma kṛtavān? nāhamasya kamapi vadhāparādhaṁ prāptaḥ kevalaṁ tāḍayitvāmuṁ tyajāmi|</para>
  <para style="p">
    <verse number="23" style="v"/>tathāpi te punarenaṁ kruśe vyadha ityuktvā proccairdṛḍhaṁ prārthayāñcakrire;</para>
  <para style="p">
    <verse number="24" style="v"/>tataḥ pradhānayājakādīnāṁ kalarave prabale sati teṣāṁ prārthanārūpaṁ karttuṁ pīlāta ādideśa|</para>
  <para style="p">
    <verse number="25" style="v"/>rājadrohavadhayoraparādhena kārāsthaṁ yaṁ janaṁ te yayācire taṁ mocayitvā yīśuṁ teṣāmicchāyāṁ samārpayat|</para>
  <para style="p">
    <verse number="26" style="v"/>atha te yīśuṁ gṛhītvā yānti, etarhi grāmādāgataṁ śimonanāmānaṁ kurīṇīyaṁ janaṁ dhṛtvā yīśoḥ paścānnetuṁ tasya skandhe kruśamarpayāmāsuḥ|</para>
  <para style="p">
    <verse number="27" style="v"/>tato loाkāraṇyamadhye bahustriyo rudatyo vilapantyaśca yīśoḥ paścād yayuḥ|</para>
  <para style="p">
    <verse number="28" style="v"/>kintu sa vyāghuṭya tā uvāca, he yirūśālamo nāryyo yuyaṁ madarthaṁ na ruditvā svārthaṁ svāpatyārthañca ruditi;</para>
  <para style="p">
    <verse number="29" style="v"/>paśyata yaḥ kadāpi garbhavatyo nābhavan stanyañca nāpāyayan tādṛśī rvandhyā yadā dhanyā vakṣyanti sa kāla āyāti|</para>
  <para style="p">
    <verse number="30" style="v"/>tadā he śailā asmākamupari patata, he upaśailā asmānācchādayata kathāmīdṛśīṁ lokā vakṣyanti|</para>
  <para style="p">
    <verse number="31" style="v"/>yataḥ satejasi śākhini cedetad ghaṭate tarhi śuṣkaśākhini kiṁ na ghaṭiṣyate?</para>
  <para style="p">
    <verse number="32" style="v"/>tadā te hantuṁ dvāvaparādhinau tena sārddhaṁ ninyuḥ|</para>
  <para style="p">
    <verse number="33" style="v"/>aparaṁ śiraḥkapālanāmakasthānaṁ prāpya taṁ kruśe vividhuḥ; taddvayoraparādhinorekaṁ tasya dakṣiṇo tadanyaṁ vāme kruśe vividhuḥ|</para>
  <para style="p">
    <verse number="34" style="v"/>tadā yīśurakathayat, he pitaretān kṣamasva yata ete yat karmma kurvvanti tan na viduḥ; paścātte guṭikāpātaṁ kṛtvā tasya vastrāṇi vibhajya jagṛhuḥ|</para>
  <para style="p">
    <verse number="35" style="v"/>tatra lokasaṁghastiṣṭhan dadarśa; te teṣāṁ śāsakāśca tamupahasya jagaduḥ, eṣa itarān rakṣitavān yadīśvareṇābhirucito 'bhiṣiktastrātā bhavati tarhi svamadhunā rakṣatu|</para>
  <para style="p">
    <verse number="36" style="v"/>tadanyaḥ senāgaṇā etya tasmai amlarasaṁ datvā parihasya provāca,</para>
  <para style="p">
    <verse number="37" style="v"/>cettvaṁ yihūdīyānāṁ rājāsi tarhi svaṁ rakṣa|</para>
  <para style="p">
    <verse number="38" style="v"/>yihūdīyānāṁ rājeti vākyaṁ yūnānīyaromīyebrīyākṣarai rlikhitaṁ tacchirasa ūrddhve'sthāpyata|</para>
  <para style="p">
    <verse number="39" style="v"/>tadobhayapārśvayo rviddhau yāvaparādhinau tayorekastaṁ vinindya babhāṣe, cettvam abhiṣiktosi tarhi svamāvāñca rakṣa|</para>
  <para style="p">
    <verse number="40" style="v"/>kintvanyastaṁ tarjayitvāvadat, īśvarāttava kiñcidapi bhayaṁ nāsti kiṁ? tvamapi samānadaṇḍosi,</para>
  <para style="p">
    <verse number="41" style="v"/>yogyapātre āvāṁ svasvakarmmaṇāṁ samucitaphalaṁ prāpnuvaḥ kintvanena kimapi nāparāddhaṁ|</para>
  <para style="p">
    <verse number="42" style="v"/>atha sa yīśuṁ jagāda he prabhe bhavān svarājyapraveśakāle māṁ smaratu|</para>
  <para style="p">
    <verse number="43" style="v"/>tadā yīśuḥ kathitavān tvāṁ yathārthaṁ vadāmi tvamadyaiva mayā sārddhaṁ paralokasya sukhasthānaṁ prāpsyasi|</para>
  <para style="p">
    <verse number="44" style="v"/>aparañca dvitīyayāmāt tṛtīyayāmaparyyantaṁ ravestejasontarhitatvāt sarvvadeśo'ndhakāreṇāvṛto</para>
  <para style="p">
    <verse number="45" style="v"/>mandirasya yavanikā ca chidyamānā dvidhā babhūva|</para>
  <para style="p">
    <verse number="46" style="v"/>tato yīśuruccairuvāca, he pita rmamātmānaṁ tava kare samarpaye, ityuktvā sa prāṇān jahau|</para>
  <para style="p">
    <verse number="47" style="v"/>tadaitā ghaṭanā dṛṣṭvā śatasenāpatirīśvaraṁ dhanyamuktvā kathitavān ayaṁ nitāntaṁ sādhumanuṣya āsīt|</para>
  <para style="p">
    <verse number="48" style="v"/>atha yāvanto lokā draṣṭum āgatāste tā ghaṭanā dṛṣṭvā vakṣaḥsu karāghātaṁ kṛtvā vyācuṭya gatāḥ|</para>
  <para style="p">
    <verse number="49" style="v"/>yīśo rjñātayo yā yā yoṣitaśca gālīlastena sārddhamāyātāstā api dūre sthitvā tat sarvvaṁ dadṛśuḥ|</para>
  <para style="p">
    <verse number="50" style="v"/>tadā yihūdīyānāṁ mantraṇāṁ kriyāñcāsammanyamāna īśvarasya rājatvam apekṣamāṇo</para>
  <para style="p">
    <verse number="51" style="v"/>yihūdideśīyo 'rimathīyanagarīyo yūṣaphnāmā mantrī bhadro dhārmmikaśca pumān</para>
  <para style="p">
    <verse number="52" style="v"/>pīlātāntikaṁ gatvā yīśo rdehaṁ yayāce|</para>
  <para style="p">
    <verse number="53" style="v"/>paścād vapuravarohya vāsasā saṁveṣṭya yatra kopi mānuṣo nāsthāpyata tasmin śaile svāte śmaśāne tadasthāpayat|</para>
  <para style="p">
    <verse number="54" style="v"/>taddinamāyojanīyaṁ dinaṁ viśrāmavāraśca samīpaḥ|</para>
  <para style="p">
    <verse number="55" style="v"/>aparaṁ yīśunā sārddhaṁ gālīla āgatā yoṣitaḥ paścāditvā śmaśāne tatra yathā vapuḥ sthāpitaṁ tacca dṛṣṭvā</para>
  <para style="p">
    <verse number="56" style="v"/>vyāghuṭya sugandhidravyatailāni kṛtvā vidhivad viśrāmavāre viśrāmaṁ cakruḥ|</para>
  <chapter number="24" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha saptāhaprathamadine'tipratyūṣe tā yoṣitaḥ sampāditaṁ sugandhidravyaṁ gṛhītvā tadanyābhiḥ kiyatībhiḥ strībhiḥ saha śmaśānaṁ yayuḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>kintu śmaśānadvārāt pāṣāṇamapasāritaṁ dṛṣṭvā</para>
  <para style="p">
    <verse number="3" style="v"/>tāḥ praviśya prabho rdehamaprāpya</para>
  <para style="p">
    <verse number="4" style="v"/>vyākulā bhavanti etarhi tejomayavastrānvitau dvau puruṣau tāsāṁ samīpe samupasthitau</para>
  <para style="p">
    <verse number="5" style="v"/>tasmāttāḥ śaṅkāyuktā bhūmāvadhomukhyasyasthuḥ| tadā tau tā ūcatu rmṛtānāṁ madhye jīvantaṁ kuto mṛgayatha?</para>
  <para style="p">
    <verse number="6" style="v"/>sotra nāsti sa udasthāt|</para>
  <para style="p">
    <verse number="7" style="v"/>pāpināṁ kareṣu samarpitena kruśe hatena ca manuṣyaputreṇa tṛtīyadivase śmaśānādutthātavyam iti kathāṁ sa galīli tiṣṭhan yuṣmabhyaṁ kathitavān tāṁ smarata|</para>
  <para style="p">
    <verse number="8" style="v"/>tadā tasya sā kathā tāsāṁ manaḥsu jātā|</para>
  <para style="p">
    <verse number="9" style="v"/>anantaraṁ śmaśānād gatvā tā ekādaśaśiṣyādibhyaḥ sarvvebhyastāṁ vārttāṁ kathayāmāsuḥ|</para>
  <para style="p">
    <verse number="10" style="v"/>magdalīnīmariyam, yohanā, yākūbo mātā mariyam tadanyāḥ saṅginyo yoṣitaśca preritebhya etāḥ sarvvā vārttāḥ kathayāmāsuḥ</para>
  <para style="p">
    <verse number="11" style="v"/>kintu tāsāṁ kathām anarthakākhyānamātraṁ buddhvā kopi na pratyait|</para>
  <para style="p">
    <verse number="12" style="v"/>tadā pitara utthāya śmaśānāntikaṁ dadhāva, tatra ca prahvo bhūtvā pārśvaikasthāpitaṁ kevalaṁ vastraṁ dadarśa; tasmādāścaryyaṁ manyamāno yadaghaṭata tanmanasi vicārayan pratasthe|</para>
  <para style="p">
    <verse number="13" style="v"/>tasminneva dine dvau śiyyau yirūśālamaścatuṣkrośāntaritam immāyugrāmaṁ gacchantau</para>
  <para style="p">
    <verse number="14" style="v"/>tāsāṁ ghaṭanānāṁ kathāmakathayatāṁ</para>
  <para style="p">
    <verse number="15" style="v"/>tayorālāpavicārayoḥ kāle yīśurāgatya tābhyāṁ saha jagāma</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yathā tau taṁ na paricinutastadarthaṁ tayo rdṛṣṭiḥ saṁruddhā|</para>
  <para style="p">
    <verse number="17" style="v"/>sa tau pṛṣṭavān yuvāṁ viṣaṇṇau kiṁ vicārayantau gacchathaḥ?</para>
  <para style="p">
    <verse number="18" style="v"/>tatastayoḥ kliyapānāmā pratyuvāca yirūśālamapure'dhunā yānyaghaṭanta tvaṁ kevalavideśī kiṁ tadvṛttāntaṁ na jānāsi?</para>
  <para style="p">
    <verse number="19" style="v"/>sa papraccha kā ghaṭanāḥ? tadā tau vaktumārebhāte yīśunāmā yo nāsaratīyo bhaviṣyadvādī īśvarasya mānuṣāṇāñca sākṣāt vākye karmmaṇi ca śaktimānāsīt</para>
  <para style="p">
    <verse number="20" style="v"/>tam asmākaṁ pradhānayājakā vicārakāśca kenāpi prakāreṇa kruśe viddhvā tasya prāṇānanāśayan tadīyā ghaṭanāḥ;</para>
  <para style="p">
    <verse number="21" style="v"/>kintu ya isrāyelīyalokān uddhārayiṣyati sa evāyam ityāśāsmābhiḥ kṛtā|tadyathā tathāstu tasyā ghaṭanāyā adya dinatrayaṁ gataṁ|</para>
  <para style="p">
    <verse number="22" style="v"/>adhikantvasmākaṁ saṅginīnāṁ kiyatstrīṇāṁ mukhebhyo'sambhavavākyamidaṁ śrutaṁ;</para>
  <para style="p">
    <verse number="23" style="v"/>tāḥ pratyūṣe śmaśānaṁ gatvā tatra tasya deham aprāpya vyāghuṭyetvā proktavatyaḥ svargīsadūtau dṛṣṭāvasmābhistau cāvādiṣṭāṁ sa jīvitavān|</para>
  <para style="p">
    <verse number="24" style="v"/>tatosmākaṁ kaiścit śmaśānamagamyata te'pi strīṇāṁ vākyānurūpaṁ dṛṣṭavantaḥ kintu taṁ nāpaśyan|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā sa tāvuvāca, he abodhau he bhaviṣyadvādibhiruktavākyaṁ pratyetuṁ vilambamānau;</para>
  <para style="p">
    <verse number="26" style="v"/>etatsarvvaduḥkhaṁ bhuktvā svabhūtiprāptiḥ kiṁ khrīṣṭasya na nyāyyā?</para>
  <para style="p">
    <verse number="27" style="v"/>tataḥ sa mūsāgranthamārabhya sarvvabhaviṣyadvādināṁ sarvvaśāstre svasmin likhitākhyānābhiprāyaṁ bodhayāmāsa|</para>
  <para style="p">
    <verse number="28" style="v"/>atha gamyagrāmābhyarṇaṁ prāpya tenāgre gamanalakṣaṇe darśite</para>
  <para style="p">
    <verse number="29" style="v"/>tau sādhayitvāvadatāṁ sahāvābhyāṁ tiṣṭha dine gate sati rātrirabhūt; tataḥ sa tābhyāṁ sārddhaṁ sthātuṁ gṛhaṁ yayau|</para>
  <para style="p">
    <verse number="30" style="v"/>paścādbhojanopaveśakāle sa pūpaṁ gṛhītvā īśvaraguṇān jagāda tañca bhaṁktvā tābhyāṁ dadau|</para>
  <para style="p">
    <verse number="31" style="v"/>tadā tayo rdṛṣṭau prasannāyāṁ taṁ pratyabhijñatuḥ kintu sa tayoḥ sākṣādantardadhe|</para>
  <para style="p">
    <verse number="32" style="v"/>tatastau mithobhidhātum ārabdhavantau gamanakāle yadā kathāmakathayat śāstrārthañcabodhayat tadāvayo rbuddhiḥ kiṁ na prājvalat?</para>
  <para style="p">
    <verse number="33" style="v"/>tau tatkṣaṇādutthāya yirūśālamapuraṁ pratyāyayatuḥ, tatsthāne śiṣyāṇām ekādaśānāṁ saṅgināñca darśanaṁ jātaṁ|</para>
  <para style="p">
    <verse number="34" style="v"/>te procuḥ prabhurudatiṣṭhad iti satyaṁ śimone darśanamadācca|</para>
  <para style="p">
    <verse number="35" style="v"/>tataḥ pathaḥ sarvvaghaṭanāyāḥ pūpabhañjanena tatparicayasya ca sarvvavṛttāntaṁ tau vaktumārebhāte|</para>
  <para style="p">
    <verse number="36" style="v"/>itthaṁ te parasparaṁ vadanti tatkāle yīśuḥ svayaṁ teṣāṁ madhya protthaya yuṣmākaṁ kalyāṇaṁ bhūyād ityuvāca,</para>
  <para style="p">
    <verse number="37" style="v"/>kintu bhūtaṁ paśyāma ityanumāya te samudvivijire treṣuśca|</para>
  <para style="p">
    <verse number="38" style="v"/>sa uvāca, kuto duḥkhitā bhavatha? yuṣmākaṁ manaḥsu sandeha udeti ca kutaḥ?</para>
  <para style="p">
    <verse number="39" style="v"/>eṣohaṁ, mama karau paśyata varaṁ spṛṣṭvā paśyata, mama yādṛśāni paśyatha tādṛśāni bhūtasya māṁsāsthīni na santi|</para>
  <para style="p">
    <verse number="40" style="v"/>ityuktvā sa hastapādān darśayāmāsa|</para>
  <para style="p">
    <verse number="41" style="v"/>te'sambhavaṁ jñātvā sānandā na pratyayan| tataḥ sa tān papraccha, atra yuṣmākaṁ samīpe khādyaṁ kiñcidasti?</para>
  <para style="p">
    <verse number="42" style="v"/>tataste kiyaddagdhamatsyaṁ madhu ca daduḥ</para>
  <para style="p">
    <verse number="43" style="v"/>sa tadādāya teṣāṁ sākṣād bubhuje</para>
  <para style="p">
    <verse number="44" style="v"/>kathayāmāsa ca mūsāvyavasthāyāṁ bhaviṣyadvādināṁ grantheṣu gītapustake ca mayi yāni sarvvāṇi vacanāni likhitāni tadanurūpāṇi ghaṭiṣyante yuṣmābhiḥ sārddhaṁ sthitvāhaṁ yadetadvākyam avadaṁ tadidānīṁ pratyakṣamabhūt|</para>
  <para style="p">
    <verse number="45" style="v"/>atha tebhyaḥ śāstrabodhādhikāraṁ datvāvadat,</para>
  <para style="p">
    <verse number="46" style="v"/>khrīṣṭenetthaṁ mṛtiyātanā bhoktavyā tṛtīyadine ca śmaśānādutthātavyañceti lipirasti;</para>
  <para style="p">
    <verse number="47" style="v"/>tannāmnā yirūśālamamārabhya sarvvadeśe manaḥparāvarttanasya pāpamocanasya ca susaṁvādaḥ pracārayitavyaḥ,</para>
  <para style="p">
    <verse number="48" style="v"/>eṣu sarvveṣu yūyaṁ sākṣiṇaḥ|</para>
  <para style="p">
    <verse number="49" style="v"/>aparañca paśyata pitrā yat pratijñātaṁ tat preṣayiṣyāmi, ataeva yāvatkālaṁ yūyaṁ svargīyāṁ śaktiṁ na prāpsyatha tāvatkālaṁ yirūśālamnagare tiṣṭhata|</para>
  <para style="p">
    <verse number="50" style="v"/>atha sa tān baithanīyāparyyantaṁ nītvā hastāvuttolya āśiṣa vaktumārebhe</para>
  <para style="p">
    <verse number="51" style="v"/>āśiṣaṁ vadanneva ca tebhyaḥ pṛthag bhūtvā svargāya nīto'bhavat|</para>
  <para style="p">
    <verse number="52" style="v"/>tadā te taṁ bhajamānā mahānandena yirūśālamaṁ pratyājagmuḥ|</para>
  <para style="p">
    <verse number="53" style="v"/>tato nirantaraṁ mandire tiṣṭhanta īśvarasya praśaṁsāṁ dhanyavādañca karttam ārebhire| iti||</para>
</usx>
