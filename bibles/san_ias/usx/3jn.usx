  <para style="h">3 John</para>
  <para style="toc1">3 yohanaḥ patraṁ</para>
  <para style="toc2">3 yohanaḥ</para>
  <para style="toc3">3 yohanaḥ</para>
  <para style="mt1">3 yohanaḥ patraṁ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>prācīno 'haṁ satyamatād yasmin prīye taṁ priyatamaṁ gāyaṁ prati patraṁ likhāmi|</para>
  <para style="p">
    <verse number="2" style="v"/>he priya, tavātmā yādṛk śubhānvitastādṛk sarvvaviṣaye tava śubhaṁ svāsthyañca bhūyāt|</para>
  <para style="p">
    <verse number="3" style="v"/>bhrātṛbhirāgatya tava satyamatasyārthatastvaṁ kīdṛk satyamatamācarasyetasya sākṣye datte mama mahānando jātaḥ|</para>
  <para style="p">
    <verse number="4" style="v"/>mama santānāḥ satyamatamācarantītivārttāto mama ya ānando jāyate tato mahattaro nāsti|</para>
  <para style="p">
    <verse number="5" style="v"/>he priya, bhrātṛn prati viśeṣatastān videśino bhṛाtṛn prati tvayā yadyat kṛtaṁ tat sarvvaṁ viśvāsino yogyaṁ|</para>
  <para style="p">
    <verse number="6" style="v"/>te ca samiteḥ sākṣāt tava pramnaḥ pramāṇaṁ dattavantaḥ, aparam īśvarayogyarūpeṇa tān prasthāpayatā tvayā satkarmma kāriṣyate|</para>
  <para style="p">
    <verse number="7" style="v"/>yataste tasya nāmnā yātrāṁ vidhāya bhinnajātīyebhyaḥ kimapi na gṛhītavantaḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>tasmād vayaṁ yat satyamatasya sahāyā bhavema tadarthametādṛśā lokā asmābhiranugrahītavyāḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>samitiṁ pratyahaṁ patraṁ likhitavān kintu teṣāṁ madhye yo diyatriphiḥ pradhānāyate so 'smān na gṛhlāti|</para>
  <para style="p">
    <verse number="10" style="v"/>ato 'haṁ yadopasthāsyāmi tadā tena yadyat kriyate tat sarvvaṁ taṁ smārayiṣyāmi, yataḥ sa durvvākyairasmān apavadati, tenāpi tṛptiṁ na gatvā svayamapi bhrātṛn nānugṛhlāti ye cānugrahītumicchanti tān samitito 'pi bahiṣkaroti|</para>
  <para style="p">
    <verse number="11" style="v"/>he priya, tvayā duṣkarmma nānukriyatāṁ kintu satkarmmaiva| yaḥ satkarmmācārī sa īśvarāt jātaḥ, yo duṣkarmmācārī sa īśvaraṁ na dṛṣṭavān|</para>
  <para style="p">
    <verse number="12" style="v"/>dīmītriyasya pakṣe sarvvaiḥ sākṣyam adāyi viśeṣataḥ satyamatenāpi, vayamapi tatpakṣe sākṣyaṁ dadmaḥ, asmākañca sākṣyaṁ satyameveti yūyaṁ jānītha|</para>
  <para style="p">
    <verse number="13" style="v"/>tvāṁ prati mayā bahūni lekhitavyāni kintu masīlekhanībhyāṁ lekhituṁ necchāmi|</para>
  <para style="p">
    <verse number="14" style="v"/>acireṇa tvāṁ drakṣyāmīti mama pratyāśāste tadāvāṁ sammukhībhūya parasparaṁ sambhāṣiṣyāvahe|</para>
  <para style="p">
    <verse number="15" style="v"/>tava śānti rbhūyāt| asmākaṁ mitrāṇi tvāṁ namaskāraṁ jñāpayanti tvamapyekaikasya nāma procya mitrebhyo namaskuru| iti|</para>
</usx>
