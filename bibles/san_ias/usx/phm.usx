  <para style="h">Philemon</para>
  <para style="toc1">philomonaṁ patraṁ</para>
  <para style="toc2">philomonaḥ</para>
  <para style="toc3">philomonaḥ</para>
  <para style="mt1">philomonaṁ patraṁ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>khrīṣṭasya yīśo rbandidāsaḥ paulastīthiyanāmā bhrātā ca priyaṁ sahakāriṇaṁ philīmonaṁ</para>
  <para style="p">
    <verse number="2" style="v"/>priyām āppiyāṁ sahasenām ārkhippaṁ philīmonasya gṛhe sthitāṁ samitiñca prati patraṁ likhataḥ|</para>
  <para style="p">
    <verse number="3" style="v"/>asmākaṁ tāta īśvaraḥ prabhu ryīśukhrīṣṭaśca yuṣmān prati śāntim anugrahañca kriyāstāṁ|</para>
  <para style="p">
    <verse number="4" style="v"/>prabhuṁ yīśuṁ prati sarvvān pavitralokān prati ca tava premaviśvāsayo rvṛttāntaṁ niśamyāhaṁ</para>
  <para style="p">
    <verse number="5" style="v"/>prārthanāsamaye tava nāmoccārayan nirantaraṁ mameśvaraṁ dhanyaṁ vadāmi|</para>
  <para style="p">
    <verse number="6" style="v"/>asmāsu yadyat saujanyaṁ vidyate tat sarvvaṁ khrīṣṭaṁ yīśuṁ yat prati bhavatīti jñānāya tava viśvāsamūlikā dānaśīlatā yat saphalā bhavet tadaham icchāmi|</para>
  <para style="p">
    <verse number="7" style="v"/>he bhrātaḥ, tvayā pavitralokānāṁ prāṇa āpyāyitā abhavan etasmāt tava premnāsmākaṁ mahān ānandaḥ sāntvanā ca jātaḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>tvayā yat karttavyaṁ tat tvām ājñāpayituṁ yadyapyahaṁ khrīṣṭenātīvotsuko bhaveyaṁ tathāpi vṛddha</para>
  <para style="p">
    <verse number="9" style="v"/>idānīṁ yīśukhrīṣṭasya bandidāsaścaivambhūto yaḥ paulaḥ so'haṁ tvāṁ vinetuṁ varaṁ manye|</para>
  <para style="p">
    <verse number="10" style="v"/>ataḥ śṛṅkhalabaddho'haṁ yamajanayaṁ taṁ madīyatanayam onīṣimam adhi tvāṁ vinaye|</para>
  <para style="p">
    <verse number="11" style="v"/>sa pūrvvaṁ tavānupakāraka āsīt kintvidānīṁ tava mama copakārī bhavati|</para>
  <para style="p">
    <verse number="12" style="v"/>tamevāhaṁ tava samīpaṁ preṣayāmi, ato madīyaprāṇasvarūpaḥ sa tvayānugṛhyatāṁ|</para>
  <para style="p">
    <verse number="13" style="v"/>susaṁvādasya kṛte śṛṅkhalabaddho'haṁ paricārakamiva taṁ svasannidhau varttayitum aicchaṁ|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu tava saujanyaṁ yad balena na bhūtvā svecchāyāḥ phalaṁ bhavet tadarthaṁ tava sammatiṁ vinā kimapi karttavyaṁ nāmanye|</para>
  <para style="p">
    <verse number="15" style="v"/>ko jānāti kṣaṇakālārthaṁ tvattastasya vicchedo'bhavad etasyāyam abhiprāyo yat tvam anantakālārthaṁ taṁ lapsyase</para>
  <para style="p">
    <verse number="16" style="v"/>puna rdāsamiva lapsyase tannahi kintu dāsāt śreṣṭhaṁ mama priyaṁ tava ca śārīrikasambandhāt prabhusambandhācca tato'dhikaṁ priyaṁ bhrātaramiva|</para>
  <para style="p">
    <verse number="17" style="v"/>ato heto ryadi māṁ sahabhāginaṁ jānāsi tarhi māmiva tamanugṛhāṇa|</para>
  <para style="p">
    <verse number="18" style="v"/>tena yadi tava kimapyaparāddhaṁ tubhyaṁ kimapi dhāryyate vā tarhi tat mameti viditvā gaṇaya|</para>
  <para style="p">
    <verse number="19" style="v"/>ahaṁ tat pariśotsyāmi, etat paulo'haṁ svahastena likhāmi, yatastvaṁ svaprāṇān api mahyaṁ dhārayasi tad vaktuṁ necchāmi|</para>
  <para style="p">
    <verse number="20" style="v"/>bho bhrātaḥ, prabhoḥ kṛte mama vāñchāṁ pūraya khrīṣṭasya kṛte mama prāṇān āpyāyaya|</para>
  <para style="p">
    <verse number="21" style="v"/>tavājñāgrāhitve viśvasya mayā etat likhyate mayā yaducyate tato'dhikaṁ tvayā kāriṣyata iti jānāmi|</para>
  <para style="p">
    <verse number="22" style="v"/>tatkaraṇasamaye madarthamapi vāsagṛhaṁ tvayā sajjīkriyatāṁ yato yuṣmākaṁ prārthanānāṁ phalarūpo vara ivāhaṁ yuṣmabhyaṁ dāyiṣye mameti pratyāśā jāyate|</para>
  <para style="p">
    <verse number="23" style="v"/>khrīṣṭasya yīśāḥ kṛte mayā saha bandiripāphrā</para>
  <para style="p">
    <verse number="24" style="v"/>mama sahakāriṇo mārka āriṣṭārkho dīmā lūkaśca tvāṁ namaskāraṁ vedayanti|</para>
  <para style="p">
    <verse number="25" style="v"/>asmākaṁ prabho ryīśukhrīṣṭasyānugraho yuṣmākam ātmanā saha bhūyāt| āmen|</para>
</usx>
