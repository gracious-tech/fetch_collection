  <para style="h">Matthew</para>
  <para style="toc1">mathilikhitaḥ susaṁvādaḥ</para>
  <para style="toc2">mathiḥ</para>
  <para style="toc3">mathiḥ</para>
  <para style="mt1">mathilikhitaḥ susaṁvādaḥ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ibrāhīmaḥ santāno dāyūd tasya santāno yīśukhrīṣṭastasya pūrvvapuruṣavaṁśaśreṇī|</para>
  <para style="p">
    <verse number="2" style="v"/>ibrāhīmaḥ putra ishāk tasya putro yākūb tasya putro yihūdāstasya bhrātaraśca|</para>
  <para style="p">
    <verse number="3" style="v"/>tasmād yihūdātastāmaro garbhe perasserahau jajñāte, tasya perasaḥ putro hiṣroṇ tasya putro 'rām|</para>
  <para style="p">
    <verse number="4" style="v"/>tasya putro 'mmīnādab tasya putro nahaśon tasya putraḥ salmon|</para>
  <para style="p">
    <verse number="5" style="v"/>tasmād rāhabo garbhe boyam jajñe, tasmād rūto garbhe obed jajñe, tasya putro yiśayaḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>tasya putro dāyūd rājaḥ tasmād mṛtoriyasya jāyāyāṁ sulemān jajñe|</para>
  <para style="p">
    <verse number="7" style="v"/>tasya putro rihabiyām, tasya putro'biyaḥ, tasya putra āsā:|</para>
  <para style="p">
    <verse number="8" style="v"/>tasya suto yihośāphaṭ tasya suto yihorāma tasya suta uṣiyaḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>tasya suto yotham tasya suta āham tasya suto hiṣkiyaḥ|</para>
  <para style="p">
    <verse number="10" style="v"/>tasya suto minaśiḥ, tasya suta āmon tasya suto yośiyaḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>bābilnagare pravasanāt pūrvvaṁ sa yośiyo yikhaniyaṁ tasya bhrātṛṁśca janayāmāsa|</para>
  <para style="p">
    <verse number="12" style="v"/>tato bābili pravasanakāle yikhaniyaḥ śaltīyelaṁ janayāmāsa, tasya sutaḥ sirubbāvil|</para>
  <para style="p">
    <verse number="13" style="v"/>tasya suto 'bohud tasya suta ilīyākīm tasya suto'sor|</para>
  <para style="p">
    <verse number="14" style="v"/>asoraḥ sutaḥ sādok tasya suta ākhīm tasya suta ilīhūd|</para>
  <para style="p">
    <verse number="15" style="v"/>tasya suta iliyāsar tasya suto mattan|</para>
  <para style="p">
    <verse number="16" style="v"/>tasya suto yākūb tasya suto yūṣaph tasya jāyā mariyam; tasya garbhe yīśurajani, tameva khrīṣṭam (arthād abhiṣiktaṁ) vadanti|</para>
  <para style="p">
    <verse number="17" style="v"/>ittham ibrāhīmo dāyūdaṁ yāvat sākalyena caturdaśapuruṣāḥ; ā dāyūdaḥ kālād bābili pravasanakālaṁ yāvat caturdaśapuruṣā bhavanti| bābili pravāsanakālāt khrīṣṭasya kālaṁ yāvat caturdaśapuruṣā bhavanti|</para>
  <para style="p">
    <verse number="18" style="v"/>yīśukhrīṣṭasya janma kaththate| mariyam nāmikā kanyā yūṣaphe vāgdattāsīt, tadā tayoḥ saṅgamāt prāk sā kanyā  pavitreṇātmanā garbhavatī babhūva|</para>
  <para style="p">
    <verse number="19" style="v"/>tatra tasyāḥ pati ryūṣaph saujanyāt tasyāḥ kalaṅgaṁ prakāśayitum anicchan gopanene tāṁ pārityaktuṁ manaścakre|</para>
  <para style="p">
    <verse number="20" style="v"/>sa tathaiva bhāvayati, tadānīṁ parameśvarasya dūtaḥ svapne taṁ darśanaṁ dattvā vyājahāra, he dāyūdaḥ santāna yūṣaph tvaṁ nijāṁ jāyāṁ mariyamam ādātuṁ mā bhaiṣīḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>yatastasyā garbhaḥ pavitrādātmano'bhavat, sā ca putraṁ prasaviṣyate, tadā tvaṁ tasya nāma yīśum (arthāt trātāraṁ) karīṣyase, yasmāt sa nijamanujān teṣāṁ kaluṣebhya uddhariṣyati|</para>
  <para style="p">
    <verse number="22" style="v"/>itthaṁ sati, paśya garbhavatī kanyā tanayaṁ prasaviṣyate| immānūyel tadīyañca nāmadheyaṁ bhaviṣyati|| immānūyel asmākaṁ saṅgīśvara̮ityarthaḥ|</para>
  <para style="p">
    <verse number="23" style="v"/>iti yad vacanaṁ purvvaṁ bhaviṣyadvaktrā īśvaraḥ kathāyāmāsa, tat tadānīṁ siddhamabhavat|</para>
  <para style="p">
    <verse number="24" style="v"/>anantaraṁ yūṣaph nidrāto jāgarita utthāya parameśvarīyadūtasya nideśānusāreṇa nijāṁ jāyāṁ jagrāha,</para>
  <para style="p">
    <verse number="25" style="v"/>kintu yāvat sā nijaṁ prathamasutaṁ a suṣuve, tāvat tāṁ nopāgacchat, tataḥ sutasya nāma yīśuṁ cakre|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ herod saṁjñake rājñi rājyaṁ śāsati yihūdīyadeśasya baitlehami nagare yīśau jātavati ca, katipayā jyotirvvudaḥ pūrvvasyā diśo yirūśālamnagaraṁ sametya kathayamāsuḥ,</para>
  <para style="p">
    <verse number="2" style="v"/>yo yihūdīyānāṁ rājā jātavān, sa kutrāste? vayaṁ pūrvvasyāṁ diśi tiṣṭhantastadīyāṁ tārakām apaśyāma tasmāt taṁ praṇantum aाgamāma|</para>
  <para style="p">
    <verse number="3" style="v"/>tadā herod rājā kathāmetāṁ niśamya yirūśālamnagarasthitaiḥ sarvvamānavaiḥ sārddham udvijya</para>
  <para style="p">
    <verse number="4" style="v"/>sarvvān pradhānayājakān adhyāpakāṁśca samāhūyānīya papraccha, khrīṣṭaḥ kutra janiṣyate?</para>
  <para style="p">
    <verse number="5" style="v"/>tadā te kathayāmāsuḥ, yihūdīyadeśasya baitlehami nagare, yato bhaviṣyadvādinā itthaṁ likhitamāste,</para>
  <para style="p">
    <verse number="6" style="v"/>sarvvābhyo rājadhānībhyo yihūdīyasya nīvṛtaḥ| he yīhūdīyadeśasye baitleham tvaṁ na cāvarā|isrāyelīyalokān me yato yaḥ pālayiṣyati| tādṛgeko mahārājastvanmadhya udbhaviṣyatī||</para>
  <para style="p">
    <verse number="7" style="v"/>tadānīṁ herod rājā tān jyotirvvido gopanam āhūya sā tārakā kadā dṛṣṭābhavat , tad viniścayāmāsa|</para>
  <para style="p">
    <verse number="8" style="v"/>aparaṁ tān baitlehamaṁ prahītya gaditavān, yūyaṁ yāta, yatnāt taṁ śiśum anviṣya taduddeśe prāpte mahyaṁ vārttāṁ dāsyatha, tato mayāpi gatvā sa praṇaṁsyate|</para>
  <para style="p">
    <verse number="9" style="v"/>tadānīṁ rājña etādṛśīm ājñāṁ prāpya te pratasthire, tataḥ pūrvvarsyāṁ diśi sthitaistai ryā tārakā dṛṣṭā sā tārakā teṣāmagre gatvā yatra sthāne śiśūrāste, tasya sthānasyopari sthagitā tasyau|</para>
  <para style="p">
    <verse number="10" style="v"/>tad dṛṣṭvā te mahānanditā babhūvuḥ,</para>
  <para style="p">
    <verse number="11" style="v"/>tato gehamadhya praviśya tasya mātrā mariyamā sāddhaṁ taṁ śiśuṁ nirīkṣaya daṇḍavad bhūtvā praṇemuḥ, aparaṁ sveṣāṁ ghanasampattiṁ mocayitvā suvarṇaṁ kunduruṁ gandharamañca tasmai darśanīyaṁ dattavantaḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>paścād herod rājasya samīpaṁ punarapi gantuṁ svapna īśvareṇa niṣiddhāḥ santo 'nyena pathā te nijadeśaṁ prati pratasthire|</para>
  <para style="p">
    <verse number="13" style="v"/>anantaraṁ teṣu gatavatmu parameśvarasya dūto yūṣaphe svapne darśanaṁ datvā jagāda, tvam utthāya śiśuṁ tanmātarañca gṛhītvā misardeśaṁ palāyasva, aparaṁ yāvadahaṁ tubhyaṁ vārttāṁ na kathayiṣyāmi, tāvat tatraiva nivasa, yato rājā herod śiśuṁ nāśayituṁ mṛgayiṣyate|</para>
  <para style="p">
    <verse number="14" style="v"/>tadānīṁ yūṣaph utthāya rajanyāṁ śiśuṁ tanmātarañca gṛhītvā misardeśaṁ prati pratasthe,</para>
  <para style="p">
    <verse number="15" style="v"/>gatvā ca herodo nṛpate rmaraṇaparyyantaṁ tatra deśe nyuvāsa, tena misardeśādahaṁ putraṁ svakīyaṁ samupāhūyam| yadetadvacanam īśvareṇa bhaviṣyadvādinā kathitaṁ tat saphalamabhūt|</para>
  <para style="p">
    <verse number="16" style="v"/>anantaraṁ herod jyotirvidbhirātmānaṁ pravañcitaṁ vijñāya bhṛśaṁ cukopa; aparaṁ jyotirvvidbhyastena viniścitaṁ yad dinaṁ taddinād gaṇayitvā dvitīyavatsaraṁ praviṣṭā yāvanto bālakā asmin baitlehamnagare tatsīmamadhye cāsan, lokān prahitya tān sarvvān ghātayāmāsa|</para>
  <para style="p">
    <verse number="17" style="v"/>ataḥ anekasya vilāpasya nināda: krandanasya ca| śokena kṛtaśabdaśca rāmāyāṁ saṁniśamyate| svabālagaṇahetorvai rāhel nārī tu rodinī| na manyate prabodhantu yataste naiva manti hi||</para>
  <para style="p">
    <verse number="18" style="v"/>yadetad vacanaṁ yirīmiyanāmakabhaviṣyadvādinā kathitaṁ tat tadānīṁ saphalam abhūt|</para>
  <para style="p">
    <verse number="19" style="v"/>tadanantaraṁ heredi rājani mṛte parameśvarasya dūto misardeśe svapne darśanaṁ dattvā yūṣaphe kathitavān</para>
  <para style="p">
    <verse number="20" style="v"/>tvam utthāya śiśuṁ tanmātarañca gṛhītvā punarapīsrāyelo deśaṁ yāhī, ye janāḥ śiśuṁ nāśayitum amṛgayanta, te mṛtavantaḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>tadānīṁ sa utthāya śiśuṁ tanmātarañca gṛhlan isrāyeldeśam ājagāma|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu yihūdīyadeśe arkhilāyanāma rājakumāro nijapitu rherodaḥ padaṁ prāpya rājatvaṁ karotīti niśamya tat sthānaṁ yātuṁ śaṅkitavān, paścāt svapna īśvarāt prabodhaṁ prāpya gālīldeśasya pradeśaikaṁ prasthāya nāsarannāma nagaraṁ gatvā tatra nyuṣitavān,</para>
  <para style="p">
    <verse number="23" style="v"/>tena taṁ nāsaratīyaṁ kathayiṣyanti, yadetadvākyaṁ bhaviṣyadvādibhirukttaṁ tat saphalamabhavat|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadānoṁ yohnnāmā majjayitā yihūdīyadeśasya prāntaram upasthāya pracārayan kathayāmāsa,</para>
  <para style="p">
    <verse number="2" style="v"/>manāṁsi parāvarttayata, svargīyarājatvaṁ samīpamāgatam|</para>
  <para style="p">
    <verse number="3" style="v"/>parameśasya panthānaṁ pariṣkuruta sarvvataḥ| tasya rājapathāṁścaiva samīkuruta sarvvathā| ityetat prāntare vākyaṁ vadataḥ kasyacid ravaḥ||</para>
  <para style="p">
    <verse number="4" style="v"/>etadvacanaṁ yiśayiyabhaviṣyadvādinā yohanamuddiśya bhāṣitam| yohano vasanaṁ mahāṅgaromajaṁ tasya kaṭau carmmakaṭibandhanaṁ; sa ca śūkakīṭān madhu ca bhuktavān|</para>
  <para style="p">
    <verse number="5" style="v"/>tadānīṁ yirūśālamnagaranivāsinaḥ sarvve yihūdideśīyā yarddantaṭinyā ubhayataṭasthāśca mānavā bahirāgatya tasya samīpe</para>
  <para style="p">
    <verse number="6" style="v"/>svīyaṁ svīyaṁ duritam aṅgīkṛtya tasyāṁ yarddani tena majjitā babhūvuḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>aparaṁ bahūn phirūśinaḥ sidūkinaśca manujān maṁktuṁ svasamīpam āgacchto vilokya sa tān abhidadhau, re re bhujagavaṁśā āgāmīnaḥ kopāt palāyituṁ yuṣmān kaścetitavān?</para>
  <para style="p">
    <verse number="8" style="v"/>manaḥparāvarttanasya samucitaṁ phalaṁ phalata|</para>
  <para style="p">
    <verse number="9" style="v"/>kintvasmākaṁ tāta ibrāhīm astīti sveṣu manaḥsu cīntayanto mā vyāharata| yato yuṣmān ahaṁ vadāmi, īśvara etebhyaḥ pāṣāṇebhya ibrāhīmaḥ santānān utpādayituṁ śaknoti|</para>
  <para style="p">
    <verse number="10" style="v"/>aparaṁ pādapānāṁ mūle kuṭhāra idānīmapi lagan āste, tasmād yasmin pādape uttamaṁ phalaṁ na bhavati, sa kṛtto madhye'gniṁ nikṣepsyate|</para>
  <para style="p">
    <verse number="11" style="v"/>aparam ahaṁ manaḥparāvarttanasūcakena majjanena yuṣmān majjayāmīti satyaṁ, kintu mama paścād ya āgacchati, sa mattopi mahān, ahaṁ tadīyopānahau voḍhumapi nahi yogyosmi, sa yuṣmān vahnirūpe pavitra ātmani saṁmajjayiṣyati|</para>
  <para style="p">
    <verse number="12" style="v"/>tasya kāre sūrpa āste, sa svīyaśasyāni samyak prasphoṭya nijān sakalagodhūmān saṁgṛhya bhāṇḍāgāre sthāpayiṣyati, kiṁntu sarvvāṇi vuṣāṇyanirvvāṇavahninā dāhayiṣyati|</para>
  <para style="p">
    <verse number="13" style="v"/>anantaraṁ yīśu ryohanā majjito bhavituṁ gālīlpradeśād yarddani tasya samīpam ājagāma|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu yohan taṁ niṣidhya babhāṣe, tvaṁ kiṁ mama samīpam āgacchasi? varaṁ tvayā majjanaṁ mama prayojanam āste|</para>
  <para style="p">
    <verse number="15" style="v"/>tadānīṁ yīśuḥ pratyavocat; īdānīm anumanyasva, yata itthaṁ sarvvadharmmasādhanam asmākaṁ karttavyaṁ, tataḥ so'nvamanyata|</para>
  <para style="p">
    <verse number="16" style="v"/>anantaraṁ yīśurammasi majjituḥ san tatkṣaṇāt toyamadhyād utthāya jagāma, tadā jīmūtadvāre mukte jāte, sa īśvarasyātmānaṁ kapotavad avaruhya svoparyyāgacchantaṁ vīkṣāñcakre|</para>
  <para style="p">
    <verse number="17" style="v"/>aparam eṣa mama priyaḥ putra etasminneva mama mahāsantoṣa etādṛśī vyomajā vāg babhūva|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ paraṁ yīśuḥ pratārakeṇa parīkṣito bhavitum ātmanā prāntaram ākṛṣṭaḥ</para>
  <para style="p">
    <verse number="2" style="v"/>san catvāriṁśadahorātrān anāhārastiṣṭhan kṣudhito babhūva|</para>
  <para style="p">
    <verse number="3" style="v"/>tadānīṁ parīkṣitā tatsamīpam āgatya vyāhṛtavān, yadi tvamīśvarātmajo bhavestarhyājñayā pāṣāṇānetān pūpān vidhehi|</para>
  <para style="p">
    <verse number="4" style="v"/>tataḥ sa pratyabravīt, itthaṁ likhitamāste, "manujaḥ kevalapūpena na jīviṣyati, kintvīśvarasya vadanād yāni yāni vacāṁsi niḥsaranti taireva jīviṣyati|"</para>
  <para style="p">
    <verse number="5" style="v"/>tadā pratārakastaṁ puṇyanagaraṁ nītvā mandirasya cūḍopari nidhāya gaditavān,</para>
  <para style="p">
    <verse number="6" style="v"/>tvaṁ yadiśvarasya tanayo bhavestarhīto'dhaḥ pata, yata itthaṁ likhitamāste, ādekṣyati nijān dūtān rakṣituṁ tvāṁ parameśvaraḥ| yathā sarvveṣu mārgeṣu tvadīyacaraṇadvaye| na laget prastarāghātastvāṁ ghariṣyanti te karaiḥ||</para>
  <para style="p">
    <verse number="7" style="v"/>tadānīṁ yīśustasmai kathitavān etadapi likhitamāste, "tvaṁ nijaprabhuṁ parameśvaraṁ mā parīkṣasva|"</para>
  <para style="p">
    <verse number="8" style="v"/>anantaraṁ pratārakaḥ punarapi tam atyuñcadharādharopari nītvā jagataḥ sakalarājyāni tadaiśvaryyāṇi ca darśayāścakāra kathayāñcakāra ca,</para>
  <para style="p">
    <verse number="9" style="v"/>yadi tvaṁ daṇḍavad bhavan māṁ praṇamestarhyaham etāni tubhyaṁ pradāsyāmi|</para>
  <para style="p">
    <verse number="10" style="v"/>tadānīṁ yīśustamavocat, dūrībhava pratāraka, likhitamidam āste, "tvayā nijaḥ prabhuḥ parameśvaraḥ praṇamyaḥ kevalaḥ sa sevyaśca|"</para>
  <para style="p">
    <verse number="11" style="v"/>tataḥ pratārakeṇa sa paryyatyāji, tadā svargīyadūtairāgatya sa siṣeve|</para>
  <para style="p">
    <verse number="12" style="v"/>tadanantaraṁ yohan kārāyāṁ babandhe, tadvārttāṁ niśamya yīśunā gālīl prāsthīyata|</para>
  <para style="p">
    <verse number="13" style="v"/>tataḥ paraṁ sa nāsarannagaraṁ vihāya jalaghestaṭe sibūlūnnaptālī etayoruvabhayoḥ pradeśayoḥ sīmnormadhyavarttī ya: kapharnāhūm tannagaram itvā nyavasat|</para>
  <para style="p">
    <verse number="14" style="v"/>tasmāt, anyādeśīyagālīli yarddanpāre'bdhirodhasi| naptālisibūlūndeśau yatra sthāne sthitau purā|</para>
  <para style="p">
    <verse number="15" style="v"/>tatratyā manujā ye ye paryyabhrāmyan tamisrake| tairjanairbṛhadālokaḥ paridarśiṣyate tadā| avasan ye janā deśe mṛtyucchāyāsvarūpake| teṣāmupari lokānāmālokaḥ saṁprakāśitaḥ||</para>
  <para style="p">
    <verse number="16" style="v"/>yadetadvacanaṁ yiśayiyabhaviṣyadvādinā proktaṁ, tat tadā saphalam abhūt|</para>
  <para style="p">
    <verse number="17" style="v"/>anantaraṁ yīśuḥ susaṁvādaṁ pracārayan etāṁ kathāṁ kathayitum ārebhe, manāṁsi parāvarttayata, svargīyarājatvaṁ savidhamabhavat|</para>
  <para style="p">
    <verse number="18" style="v"/>tataḥ paraṁ yīśu rgālīlo jaladhestaṭena gacchan gacchan āndriyastasya bhrātā śimon arthato yaṁ pitaraṁ vadanti etāvubhau jalaghau jālaṁ kṣipantau dadarśa, yatastau mīnadhāriṇāvāstām|</para>
  <para style="p">
    <verse number="19" style="v"/>tadā sa tāvāhūya vyājahāra, yuvāṁ mama paścād āgacchataṁ, yuvāmahaṁ manujadhāriṇau kariṣyāmi|</para>
  <para style="p">
    <verse number="20" style="v"/>tenaiva tau jālaṁ vihāya tasya paścāt āgacchatām|</para>
  <para style="p">
    <verse number="21" style="v"/>anantaraṁ tasmāt sthānāt vrajan vrajan sivadiyasya sutau yākūb yohannāmānau dvau sahajau tātena sārddhaṁ naukopari jālasya jīrṇoddhāraṁ kurvvantau vīkṣya tāvāhūtavān|</para>
  <para style="p">
    <verse number="22" style="v"/>tatkṣaṇāt tau nāvaṁ svatātañca vihāya tasya paścādgāminau babhūvatuḥ|</para>
  <para style="p">
    <verse number="23" style="v"/>anantaraṁ bhajanabhavane samupadiśan rājyasya susaṁvādaṁ pracārayan manujānāṁ sarvvaprakārān rogān sarvvaprakārapīḍāśca śamayan yīśuḥ kṛtsnaṁ gālīldeśaṁ bhramitum ārabhata|</para>
  <para style="p">
    <verse number="24" style="v"/>tena kṛtsnasuriyādeśasya madhyaṁ tasya yaśo vyāpnot, aparaṁ bhūtagrastā apasmārargīṇaḥ pakṣādhātiprabhṛtayaśca yāvanto manujā nānāvidhavyādhibhiḥ kliṣṭā āsan, teṣu sarvveṣu tasya samīpam ānīteṣu sa tān svasthān cakāra|</para>
  <para style="p">
    <verse number="25" style="v"/>etena gālīl-dikāpani-yirūśālam-yihūdīyadeśebhyo yarddanaḥ pārāñca bahavo manujāstasya paścād āgacchan|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ sa jananivahaṁ nirīkṣya bhūdharopari vrajitvā samupaviveśa|</para>
  <para style="p">
    <verse number="2" style="v"/>tadānīṁ śiṣyeṣu tasya samīpamāgateṣu tena tebhya eṣā kathā kathyāñcakre|</para>
  <para style="p">
    <verse number="3" style="v"/>abhimānahīnā janā dhanyāḥ, yataste svargīyarājyam adhikariṣyanti|</para>
  <para style="p">
    <verse number="4" style="v"/>khidyamānā manujā dhanyāḥ, yasmāt te sāntvanāṁ prāpsanti|</para>
  <para style="p">
    <verse number="5" style="v"/>namrā mānavāśca dhanyāḥ, yasmāt te medinīm adhikariṣyanti|</para>
  <para style="p">
    <verse number="6" style="v"/>dharmmāya bubhukṣitāḥ tṛṣārttāśca manujā dhanyāḥ, yasmāt te paritarpsyanti|</para>
  <para style="p">
    <verse number="7" style="v"/>kṛpālavo mānavā dhanyāḥ, yasmāt te kṛpāṁ prāpsyanti|</para>
  <para style="p">
    <verse number="8" style="v"/>nirmmalahṛdayā manujāśca dhanyāḥ, yasmāt ta īścaraṁ drakṣyanti|</para>
  <para style="p">
    <verse number="9" style="v"/>melayitāro mānavā dhanyāḥ, yasmāt ta īścarasya santānatvena vikhyāsyanti|</para>
  <para style="p">
    <verse number="10" style="v"/>dharmmakāraṇāt tāḍitā manujā dhanyā, yasmāt svargīyarājye teṣāmadhikaro vidyate|</para>
  <para style="p">
    <verse number="11" style="v"/>yadā manujā mama nāmakṛte yuṣmān nindanti tāḍayanti mṛṣā nānādurvvākyāni vadanti ca, tadā yuyaṁ dhanyāḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>tadā ānandata, tathā bhṛśaṁ hlādadhvañca, yataḥ svarge bhūyāṁsi phalāni lapsyadhve; te yuṣmākaṁ purātanān bhaviṣyadvādino'pi tādṛg atāḍayan|</para>
  <para style="p">
    <verse number="13" style="v"/>yuyaṁ medinyāṁ lavaṇarūpāḥ, kintu yadi lavaṇasya lavaṇatvam apayāti, tarhi tat kena prakāreṇa svāduyuktaṁ bhaviṣyati? tat kasyāpi kāryyasyāyogyatvāt kevalaṁ bahiḥ prakṣeptuṁ narāṇāṁ padatalena dalayituñca yogyaṁ bhavati|</para>
  <para style="p">
    <verse number="14" style="v"/>yūyaṁ jagati dīptirūpāḥ, bhūdharopari sthitaṁ nagaraṁ guptaṁ bhavituṁ nahi śakṣyati|</para>
  <para style="p">
    <verse number="15" style="v"/>aparaṁ manujāḥ pradīpān prajvālya droṇādho na sthāpayanti, kintu dīpādhāroparyyeva sthāpayanti, tena te dīpā gehasthitān sakalān prakāśayanti|</para>
  <para style="p">
    <verse number="16" style="v"/>yena mānavā yuṣmākaṁ satkarmmāṇi vilokya yuṣmākaṁ svargasthaṁ pitaraṁ dhanyaṁ vadanti, teṣāṁ samakṣaṁ yuṣmākaṁ dīptistādṛk prakāśatām|</para>
  <para style="p">
    <verse number="17" style="v"/>ahaṁ vyavasthāṁ bhaviṣyadvākyañca loptum āgatavān, itthaṁ mānubhavata, te dve loptuṁ nāgatavān, kintu saphale karttum āgatosmi|</para>
  <para style="p">
    <verse number="18" style="v"/>aparaṁ yuṣmān ahaṁ tathyaṁ vadāmi yāvat vyomamedinyo rdhvaṁso na bhaviṣyati, tāvat sarvvasmin saphale na jāte vyavasthāyā ekā mātrā bindurekopi vā na lopsyate|</para>
  <para style="p">
    <verse number="19" style="v"/>tasmāt yo jana etāsām ājñānām atikṣudrām ekājñāmapī laṁghate manujāṁñca tathaiva śikṣayati, sa svargīyarājye sarvvebhyaḥ kṣudratvena vikhyāsyate, kintu yo janastāṁ pālayati, tathaiva śikṣayati ca, sa svargīyarājye pradhānatvena vikhyāsyate|</para>
  <para style="p">
    <verse number="20" style="v"/>aparaṁ yuṣmān ahaṁ vadāmi, adhyāpakaphirūśimānavānāṁ dharmmānuṣṭhānāt yuṣmākaṁ dharmmānuṣṭhāne nottame jāte yūyam īśvarīyarājyaṁ praveṣṭuṁ na śakṣyatha|</para>
  <para style="p">
    <verse number="21" style="v"/>aparañca tvaṁ naraṁ mā vadhīḥ, yasmāt yo naraṁ hanti, sa vicārasabhāyāṁ daṇḍārho bhaviṣyati, pūrvvakālīnajanebhya iti kathitamāsīt, yuṣmābhiraśrāvi|</para>
  <para style="p">
    <verse number="22" style="v"/>kintvahaṁ yuṣmān vadāmi, yaḥ kaścit kāraṇaṁ vinā nijabhrātre kupyati, sa vicārasabhāyāṁ daṇḍārho bhaviṣyati; yaḥ kaścicca svīyasahajaṁ nirbbodhaṁ vadati, sa mahāsabhāyāṁ daṇḍārho bhaviṣyati; punaśca tvaṁ mūḍha iti vākyaṁ yadi kaścit svīyabhrātaraṁ vakti, tarhi narakāgnau sa daṇḍārho bhaviṣyati|</para>
  <para style="p">
    <verse number="23" style="v"/>ato vedyāḥ samīpaṁ nijanaivedye samānīte'pi nijabhrātaraṁ prati kasmāccit kāraṇāt tvaṁ yadi doṣī vidyase, tadānīṁ tava tasya smṛti rjāyate ca,</para>
  <para style="p">
    <verse number="24" style="v"/>tarhi tasyā vedyāḥ samīpe nijanaivaidyaṁ nidhāya tadaiva gatvā pūrvvaṁ tena sārddhaṁ mila, paścāt āgatya nijanaivedyaṁ nivedaya|</para>
  <para style="p">
    <verse number="25" style="v"/>anyañca yāvat vivādinā sārddhaṁ vartmani tiṣṭhasi, tāvat tena sārddhaṁ melanaṁ kuru; no cet vivādī vicārayituḥ samīpe tvāṁ samarpayati vicārayitā ca rakṣiṇaḥ sannidhau samarpayati tadā tvaṁ kārāyāṁ badhyethāḥ|</para>
  <para style="p">
    <verse number="26" style="v"/>tarhi tvāmahaṁ taththaṁ bravīmi, śeṣakapardake'pi na pariśodhite tasmāt sthānāt kadāpi bahirāgantuṁ na śakṣyasi|</para>
  <para style="p">
    <verse number="27" style="v"/>aparaṁ tvaṁ mā vyabhicara, yadetad vacanaṁ pūrvvakālīnalokebhyaḥ kathitamāsīt, tad yūyaṁ śrutavantaḥ;</para>
  <para style="p">
    <verse number="28" style="v"/>kintvahaṁ yuṣmān vadāmi, yadi kaścit kāmataḥ kāñcana yoṣitaṁ paśyati, tarhi sa manasā tadaiva vyabhicaritavān|</para>
  <para style="p">
    <verse number="29" style="v"/>tasmāt tava dakṣiṇaṁ netraṁ yadi tvāṁ bādhate, tarhi tannetram utpāṭya dūre nikṣipa, yasmāt tava sarvvavapuṣo narake nikṣepāt tavaikāṅgasya nāśo varaṁ|</para>
  <para style="p">
    <verse number="30" style="v"/>yadvā tava dakṣiṇaḥ karo yadi tvāṁ bādhate, tarhi taṁ karaṁ chittvā dūre nikṣipa, yataḥ sarvvavapuṣo narake nikṣepāt ekāṅgasya nāśo varaṁ|</para>
  <para style="p">
    <verse number="31" style="v"/>uktamāste, yadi kaścin nijajāyāṁ parityakttum icchati, tarhi sa tasyai tyāgapatraṁ dadātu|</para>
  <para style="p">
    <verse number="32" style="v"/>kintvahaṁ yuṣmān vyāharāmi, vyabhicāradoṣe na jāte yadi kaścin nijajāyāṁ parityajati, tarhi sa tāṁ vyabhicārayati; yaśca tāṁ tyaktāṁ striyaṁ vivahati, sopi vyabhicarati|</para>
  <para style="p">
    <verse number="33" style="v"/>punaśca tvaṁ mṛṣā śapatham na kurvvan īścarāya nijaśapathaṁ pālaya, pūrvvakālīnalokebhyo yaiṣā kathā kathitā, tāmapi yūyaṁ śrutavantaḥ|</para>
  <para style="p">
    <verse number="34" style="v"/>kintvahaṁ yuṣmān vadāmi, kamapi śapathaṁ mā kārṣṭa, arthataḥ svarganāmnā na, yataḥ sa īśvarasya siṁhāsanaṁ;</para>
  <para style="p">
    <verse number="35" style="v"/>pṛthivyā nāmnāpi na, yataḥ sā tasya pādapīṭhaṁ; yirūśālamo nāmnāpi na, yataḥ sā mahārājasya purī;</para>
  <para style="p">
    <verse number="36" style="v"/>nijaśironāmnāpi na, yasmāt tasyaikaṁ kacamapi sitam asitaṁ vā karttuṁ tvayā na śakyate|</para>
  <para style="p">
    <verse number="37" style="v"/>aparaṁ yūyaṁ saṁlāpasamaye kevalaṁ bhavatīti na bhavatīti ca vadata yata ito'dhikaṁ yat tat pāpātmano jāyate|</para>
  <para style="p">
    <verse number="38" style="v"/>aparaṁ locanasya vinimayena locanaṁ dantasya vinimayena dantaḥ pūrvvaktamidaṁ vacanañca yuṣmābhiraśrūyata|</para>
  <para style="p">
    <verse number="39" style="v"/>kintvahaṁ yuṣmān vadāmi yūyaṁ hiṁsakaṁ naraṁ mā vyāghātayata| kintu kenacit tava dakṣiṇakapole capeṭāghāte kṛte taṁ prati vāmaṁ kapolañca vyāghoṭaya|</para>
  <para style="p">
    <verse number="40" style="v"/>aparaṁ kenacit tvayā sārdhdaṁ vivādaṁ kṛtvā tava paridheyavasane jighṛtite tasmāyuttarīyavasanamapi dehi|</para>
  <para style="p">
    <verse number="41" style="v"/>yadi kaścit tvāṁ krośamekaṁ nayanārthaṁ anyāyato dharati, tadā tena sārdhdaṁ krośadvayaṁ yāhi|</para>
  <para style="p">
    <verse number="42" style="v"/>yaśca mānavastvāṁ yācate, tasmai dehi, yadi kaścit tubhyaṁ dhārayitum icchati, tarhi taṁ prati parāṁmukho mā bhūḥ|</para>
  <para style="p">
    <verse number="43" style="v"/>nijasamīpavasini prema kuru, kintu śatruṁ prati dveṣaṁ kuru, yadetat puroktaṁ vacanaṁ etadapi yūyaṁ śrutavantaḥ|</para>
  <para style="p">
    <verse number="44" style="v"/>kintvahaṁ yuṣmān vadāmi, yūyaṁ ripuvvapi prema kuruta, ye ca yuṣmān śapante, tāna, āśiṣaṁ vadata, ye ca yuṣmān ṛृtīyante, teṣāṁ maṅgalaṁ kuruta, ye ca yuṣmān nindanti, tāḍayanti ca, teṣāṁ kṛte prārthayadhvaṁ|</para>
  <para style="p">
    <verse number="45" style="v"/>tatra yaḥ satāmasatāñcopari prabhākaram udāyayati, tathā dhārmmikānāmadhārmmikānāñcopari nīraṁ varṣayati tādṛśo yo yuṣmākaṁ svargasthaḥ pitā, yūyaṁ tasyaiva santānā bhaviṣyatha|</para>
  <para style="p">
    <verse number="46" style="v"/>ye yuṣmāsu prema kurvvanti, yūyaṁ yadi kevalaṁ tevveva prema kurutha, tarhi yuṣmākaṁ kiṁ phalaṁ bhaviṣyati? caṇḍālā api tādṛśaṁ kiṁ na kurvvanti?</para>
  <para style="p">
    <verse number="47" style="v"/>aparaṁ yūyaṁ yadi kevalaṁ svīyabhrātṛtvena namata, tarhi kiṁ mahat karmma kurutha? caṇḍālā api tādṛśaṁ kiṁ na kurvvanti?</para>
  <para style="p">
    <verse number="48" style="v"/>tasmāt yuṣmākaṁ svargasthaḥ pitā yathā pūrṇo bhavati, yūyamapi tādṛśā bhavata|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>sāvadhānā bhavata, manujān darśayituṁ teṣāṁ gocare dharmmakarmma mā kuruta, tathā kṛte yuṣmākaṁ svargasthapituḥ sakāśāt kiñcana phalaṁ na prāpsyatha|</para>
  <para style="p">
    <verse number="2" style="v"/>tvaṁ yadā dadāsi tadā kapaṭino janā yathā manujebhyaḥ praśaṁsāṁ prāptuṁ bhajanabhavane rājamārge ca tūrīṁ vādayanti, tathā mā kuriु, ahaṁ tubhyaṁ yathārthaṁ kathayāmi, te svakāyaṁ phalam alabhanta|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu tvaṁ yadā dadāsi, tadā nijadakṣiṇakaro yat karoti, tad vāmakaraṁ mā jñāpaya|</para>
  <para style="p">
    <verse number="4" style="v"/>tena tava dānaṁ guptaṁ bhaviṣyati yastu tava pitā guptadarśī, sa prakāśya tubhyaṁ phalaṁ dāsyati|</para>
  <para style="p">
    <verse number="5" style="v"/>aparaṁ yadā prārthayase, tadā kapaṭina̮iva mā kuru, yasmāt te bhajanabhavane rājamārgasya koṇe tiṣṭhanto lokān darśayantaḥ prārthayituṁ prīyante; ahaṁ yuṣmān tathyaṁ vadāmi, te svakīyaphalaṁ prāpnuvan|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmāt prārthanākāle antarāgāraṁ praviśya dvāraṁ rudvvā guptaṁ paśyatastava pituḥ samīpe prārthayasva; tena tava yaḥ pitā guptadarśī, sa prakāśya tubhyaṁ phalaṁ dāsyatil</para>
  <para style="p">
    <verse number="7" style="v"/>aparaṁ prārthanākāle devapūjakāiva mudhā punaruktiṁ mā kuru, yasmāt te bodhante, bahuvāraṁ kathāyāṁ kathitāyāṁ teṣāṁ prārthanā grāhiṣyate|</para>
  <para style="p">
    <verse number="8" style="v"/>yūyaṁ teṣāmiva mā kuruta, yasmāt yuṣmākaṁ yad yat prayojanaṁ yācanātaḥ prāgeva yuṣmākaṁ pitā tat jānāti|</para>
  <para style="p">
    <verse number="9" style="v"/>ataeva yūyama īdṛk prārthayadhvaṁ, he asmākaṁ svargasthapitaḥ, tava nāma pūjyaṁ bhavatu|</para>
  <para style="p">
    <verse number="10" style="v"/>tava rājatvaṁ bhavatu; tavecchā svarge yathā tathaiva medinyāmapi saphalā bhavatu|</para>
  <para style="p">
    <verse number="11" style="v"/>asmākaṁ prayojanīyam āhāram adya dehi|</para>
  <para style="p">
    <verse number="12" style="v"/>vayaṁ yathā nijāparādhinaḥ kṣamāmahe, tathaivāsmākam aparādhān kṣamasva|</para>
  <para style="p">
    <verse number="13" style="v"/>asmān parīkṣāṁ mānaya, kintu pāpātmano rakṣa; rājatvaṁ gauravaṁ parākramaḥ ete sarvve sarvvadā tava; tathāstu|</para>
  <para style="p">
    <verse number="14" style="v"/>yadi yūyam anyeṣām aparādhān kṣamadhve tarhi yuṣmākaṁ svargasthapitāpi yuṣmān kṣamiṣyate;</para>
  <para style="p">
    <verse number="15" style="v"/>kintu yadi yūyam anyeṣām aparādhān na kṣamadhve, tarhi yuṣmākaṁ janakopi yuṣmākam aparādhān na kṣamiṣyate|</para>
  <para style="p">
    <verse number="16" style="v"/>aparam upavāsakāle kapaṭino janā mānuṣān upavāsaṁ jñāpayituṁ sveṣāṁ vadanāni mlānāni kurvvanti, yūyaṁ ta̮iva viṣaṇavadanā mā bhavata; ahaṁ yuṣmān tathyaṁ vadāmi te svakīyaphalam alabhanta|</para>
  <para style="p">
    <verse number="17" style="v"/>yadā tvam upavasasi, tadā yathā lokaistvaṁ upavāsīva na dṛśyase, kintu tava yo'gocaraḥ pitā tenaiva dṛśyase, tatkṛte nijaśirasi tailaṁ marddaya vadanañca prakṣālaya;</para>
  <para style="p">
    <verse number="18" style="v"/>tena tava yaḥ pitā guptadarśī sa prakāśya tubhyaṁ phalaṁ dāsyati|</para>
  <para style="p">
    <verse number="19" style="v"/>aparaṁ yatra sthāne kīṭāḥ kalaṅkāśca kṣayaṁ nayanti, caurāśca sandhiṁ karttayitvā corayituṁ śaknuvanti, tādṛśyāṁ medinyāṁ svārthaṁ dhanaṁ mā saṁcinuta|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu yatra sthāne kīṭāḥ kalaṅkāśca kṣayaṁ na nayanti, caurāśca sandhiṁ karttayitvā corayituṁ na śaknuvanti, tādṛśe svarge dhanaṁ sañcinuta|</para>
  <para style="p">
    <verse number="21" style="v"/>yasmāt yatra sthāne yuṣmāṁka dhanaṁ tatraiva khāne yuṣmākaṁ manāṁsi|</para>
  <para style="p">
    <verse number="22" style="v"/>locanaṁ dehasya pradīpakaṁ, tasmāt yadi tava locanaṁ prasannaṁ bhavati, tarhi tava kṛtsnaṁ vapu rdīptiyuktaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="23" style="v"/>kintu locane'prasanne tava kṛtsnaṁ vapuḥ tamisrayuktaṁ bhaviṣyati| ataeva yā dīptistvayi vidyate, sā yadi tamisrayuktā bhavati, tarhi tat tamisraṁ kiyan mahat|</para>
  <para style="p">
    <verse number="24" style="v"/>kopi manujo dvau prabhū sevituṁ na śaknoti, yasmād ekaṁ saṁmanya tadanyaṁ na sammanyate, yadvā ekatra mano nidhāya tadanyam avamanyate; tathā yūyamapīśvaraṁ lakṣmīñcetyubhe sevituṁ na śaknutha|</para>
  <para style="p">
    <verse number="25" style="v"/>aparam ahaṁ yuṣmabhyaṁ tathyaṁ kathayāmi, kiṁ bhakṣiṣyāmaḥ? kiṁ pāsyāmaḥ? iti prāṇadhāraṇāya mā cintayata; kiṁ paridhāsyāmaḥ? iti kāyarakṣaṇāya na cintayata; bhakṣyāt prāṇā vasanāñca vapūṁṣi kiṁ śreṣṭhāṇi na hi?</para>
  <para style="p">
    <verse number="26" style="v"/>vihāyaso vihaṅgamān vilokayata; tai rnopyate na kṛtyate bhāṇḍāgāre na sañcīyate'pi; tathāpi yuṣmākaṁ svargasthaḥ pitā tebhya āhāraṁ vitarati|</para>
  <para style="p">
    <verse number="27" style="v"/>yūyaṁ tebhyaḥ kiṁ śreṣṭhā na bhavatha? yuṣmākaṁ kaścit manujaḥ cintayan nijāyuṣaḥ kṣaṇamapi varddhayituṁ śaknoti?</para>
  <para style="p">
    <verse number="28" style="v"/>aparaṁ vasanāya kutaścintayata? kṣetrotpannāni puṣpāṇi kathaṁ varddhante tadālocayata| tāni tantūn notpādayanti kimapi kāryyaṁ na kurvvanti;</para>
  <para style="p">
    <verse number="29" style="v"/>tathāpyahaṁ yuṣmān vadāmi, sulemān tādṛg aiśvaryyavānapi tatpuṣpamiva vibhūṣito nāsīt|</para>
  <para style="p">
    <verse number="30" style="v"/>tasmāt kṣadya vidyamānaṁ ścaḥ cullyāṁ nikṣepsyate tādṛśaṁ yat kṣetrasthitaṁ kusumaṁ tat yadīścara itthaṁ bibhūṣayati, tarhi he stokapratyayino yuṣmān kiṁ na paridhāpayiṣyati?</para>
  <para style="p">
    <verse number="31" style="v"/>tasmāt asmābhiḥ kimatsyate? kiñca pāyiṣyate? kiṁ vā paridhāyiṣyate, iti na cintayata|</para>
  <para style="p">
    <verse number="32" style="v"/>yasmāt devārccakā apīti ceṣṭante; eteṣu dravyeṣu prayojanamastīti yuṣmākaṁ svargasthaḥ pitā jānāti|</para>
  <para style="p">
    <verse number="33" style="v"/>ataeva prathamata īśvarīyarājyaṁ dharmmañca ceṣṭadhvaṁ, tata etāni vastūni yuṣmabhyaṁ pradāyiṣyante|</para>
  <para style="p">
    <verse number="34" style="v"/>śvaḥ kṛte mā cintayata, śvaeva svayaṁ svamuddiśya cintayiṣyati; adyatanī yā cintā sādyakṛte pracuratarā|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yathā yūyaṁ doṣīkṛtā na bhavatha, tatkṛte'nyaṁ doṣiṇaṁ mā kuruta|</para>
  <para style="p">
    <verse number="2" style="v"/>yato yādṛśena doṣeṇa yūyaṁ parān doṣiṇaḥ kurutha, tādṛśena doṣeṇa yūyamapi doṣīkṛtā bhaviṣyatha, anyañca yena parimāṇena yuṣmābhiḥ parimīyate, tenaiva parimāṇena yuṣmatkṛte parimāyiṣyate|</para>
  <para style="p">
    <verse number="3" style="v"/>aparañca nijanayane yā nāsā vidyate, tām anālocya tava sahajasya locane yat tṛṇam āste, tadeva kuto vīkṣase?</para>
  <para style="p">
    <verse number="4" style="v"/>tava nijalocane nāsāyāṁ vidyamānāyāṁ, he bhrātaḥ, tava nayanāt tṛṇaṁ bahiṣyartuṁ anujānīhi, kathāmetāṁ nijasahajāya kathaṁ kathayituṁ śaknoṣi?</para>
  <para style="p">
    <verse number="5" style="v"/>he kapaṭin, ādau nijanayanāt nāsāṁ bahiṣkuru tato nijadṛṣṭau suprasannāyāṁ tava bhrātṛ rlocanāt tṛṇaṁ bahiṣkartuṁ śakṣyasi|</para>
  <para style="p">
    <verse number="6" style="v"/>anyañca sārameyebhyaḥ pavitravastūni mā vitarata, varāhāṇāṁ samakṣañca muktā mā nikṣipata; nikṣepaṇāt te tāḥ sarvvāḥ padai rdalayiṣyanti, parāvṛtya yuṣmānapi vidārayiṣyanti|</para>
  <para style="p">
    <verse number="7" style="v"/>yācadhvaṁ tato yuṣmabhyaṁ dāyiṣyate; mṛgayadhvaṁ tata uddeśaṁ lapsyadhve; dvāram āhata, tato yuṣmatkṛte muktaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="8" style="v"/>yasmād yena yācyate, tena labhyate; yena mṛgyate tenoddeśaḥ prāpyate; yena ca dvāram āhanyate, tatkṛte dvāraṁ mocyate|</para>
  <para style="p">
    <verse number="9" style="v"/>ātmajena pūpe prārthite tasmai pāṣāṇaṁ viśrāṇayati,</para>
  <para style="p">
    <verse number="10" style="v"/>mīne yācite ca tasmai bhujagaṁ vitarati, etādṛśaḥ pitā yuṣmākaṁ madhye ka āste?</para>
  <para style="p">
    <verse number="11" style="v"/>tasmād yūyam abhadrāḥ santo'pi yadi nijabālakebhya uttamaṁ dravyaṁ dātuṁ jānītha, tarhi yuṣmākaṁ svargasthaḥ pitā svīyayācakebhyaḥ kimuttamāni vastūni na dāsyati?</para>
  <para style="p">
    <verse number="12" style="v"/>yūṣmān pratītareṣāṁ yādṛśo vyavahāro yuṣmākaṁ priyaḥ, yūyaṁ tān prati tādṛśāneva vyavahārān vidhatta; yasmād vyavasthābhaviṣyadvādināṁ vacanānām iti sāram|</para>
  <para style="p">
    <verse number="13" style="v"/>saṅkīrṇadvāreṇa praviśata; yato narakagamanāya yad dvāraṁ tad vistīrṇaṁ yacca vartma tad bṛhat tena bahavaḥ praviśanti|</para>
  <para style="p">
    <verse number="14" style="v"/>aparaṁ svargagamanāya yad dvāraṁ tat kīdṛk saṁkīrṇaṁ| yacca vartma tat kīdṛg durgamam| taduddeṣṭāraḥ kiyanto'lpāḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>aparañca ye janā meṣaveśena yuṣmākaṁ samīpam āgacchanti, kintvantardurantā vṛkā etādṛśebhyo bhaviṣyadvādibhyaḥ sāvadhānā bhavata, yūyaṁ phalena tān paricetuṁ śaknutha|</para>
  <para style="p">
    <verse number="16" style="v"/>manujāḥ kiṁ kaṇṭakino vṛkṣād drākṣāphalāni śṛgālakolitaśca uḍumbaraphalāni śātayanti?</para>
  <para style="p">
    <verse number="17" style="v"/>tadvad uttama eva pādapa uttamaphalāni janayati, adhamapādapaevādhamaphalāni janayati|</para>
  <para style="p">
    <verse number="18" style="v"/>kintūttamapādapaḥ kadāpyadhamaphalāni janayituṁ na śaknoti, tathādhamopi pādapa uttamaphalāni janayituṁ na śaknoti|</para>
  <para style="p">
    <verse number="19" style="v"/>aparaṁ ye ye pādapā adhamaphalāni janayanti, te kṛttā vahnau kṣipyante|</para>
  <para style="p">
    <verse number="20" style="v"/>ataeva yūyaṁ phalena tān pariceṣyatha|</para>
  <para style="p">
    <verse number="21" style="v"/>ye janā māṁ prabhuṁ vadanti, te sarvve svargarājyaṁ pravekṣyanti tanna, kintu yo mānavo mama svargasthasya pituriṣṭaṁ karmma karoti sa eva pravekṣyati|</para>
  <para style="p">
    <verse number="22" style="v"/>tad dine bahavo māṁ vadiṣyanti, he prabho he prabho, tava nāmnā kimasmāmi rbhaviṣyadvākyaṁ na vyāhṛtaṁ? tava nāmnā bhūtāḥ kiṁ na tyājitāḥ? tava nāmnā kiṁ nānādbhutāni karmmāṇi na kṛtāni?</para>
  <para style="p">
    <verse number="23" style="v"/>tadāhaṁ vadiṣyāmi, he kukarmmakāriṇo yuṣmān ahaṁ na vedmi, yūyaṁ matsamīpād dūrībhavata|</para>
  <para style="p">
    <verse number="24" style="v"/>yaḥ kaścit mamaitāḥ kathāḥ śrutvā pālayati, sa pāṣāṇopari gṛhanirmmātrā jñāninā saha mayopamīyate|</para>
  <para style="p">
    <verse number="25" style="v"/>yato vṛṣṭau satyām āplāva āgate vāyau vāte ca teṣu tadgehaṁ lagneṣu pāṣāṇopari tasya bhittestanna patatil</para>
  <para style="p">
    <verse number="26" style="v"/>kintu yaḥ kaścit mamaitāḥ kathāḥ śrutvā na pālayati sa saikate gehanirmmātrā 'jñāninā upamīyate|</para>
  <para style="p">
    <verse number="27" style="v"/>yato jalavṛṣṭau satyām āplāva āgate pavane vāte ca tai rgṛhe samāghāte tat patati tatpatanaṁ mahad bhavati|</para>
  <para style="p">
    <verse number="28" style="v"/>yīśunaiteṣu vākyeṣu samāpiteṣu mānavāstadīyopadeśam āścaryyaṁ menire|</para>
  <para style="p">
    <verse number="29" style="v"/>yasmāt sa upādhyāyā iva tān nopadideśa kintu samarthapuruṣa̮iva samupadideśa|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yadā sa parvvatād avārohat tadā bahavo mānavāstatpaścād vavrajuḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>ekaḥ kuṣṭhavān āgatya taṁ praṇamya babhāṣe, he prabho, yadi bhavān saṁmanyate, tarhi māṁ nirāmayaṁ karttuṁ śaknoti|</para>
  <para style="p">
    <verse number="3" style="v"/>tato yīśuḥ karaṁ prasāryya tasyāṅgaṁ spṛśan vyājahāra, sammanye'haṁ tvaṁ nirāmayo bhava; tena sa tatkṣaṇāt kuṣṭhenāmoci|</para>
  <para style="p">
    <verse number="4" style="v"/>tato yīśustaṁ jagāda, avadhehi kathāmetāṁ kaścidapi mā brūhi, kintu yājakasya sannidhiṁ gatvā svātmānaṁ darśaya manujebhyo nijanirāmayatvaṁ pramāṇayituṁ mūsānirūpitaṁ dravyam utsṛja ca|</para>
  <para style="p">
    <verse number="5" style="v"/>tadanantaraṁ yīśunā kapharnāhūmnāmani nagare praviṣṭe kaścit śatasenāpatistatsamīpam āgatya vinīya babhāṣe,</para>
  <para style="p">
    <verse number="6" style="v"/>he prabho, madīya eko dāsaḥ pakṣāghātavyādhinā bhṛśaṁ vyathitaḥ, satu śayanīya āste|</para>
  <para style="p">
    <verse number="7" style="v"/>tadānīṁ yīśustasmai kathitavān, ahaṁ gatvā taṁ nirāmayaṁ kariṣyāmi|</para>
  <para style="p">
    <verse number="8" style="v"/>tataḥ sa śatasenāpatiḥ pratyavadat, he prabho, bhavān yat mama gehamadhyaṁ yāti tadyogyabhājanaṁ nāhamasmi; vāṅmātram ādiśatu, tenaiva mama dāso nirāmayo bhaviṣyati|</para>
  <para style="p">
    <verse number="9" style="v"/>yato mayi paranidhne'pi mama nideśavaśyāḥ kati kati senāḥ santi, tata ekasmin yāhītyukte sa yāti, tadanyasmin ehītyukte sa āyāti, tathā mama nijadāse karmmaitat kurvvityukte sa tat karoti|</para>
  <para style="p">
    <verse number="10" style="v"/>tadānīṁ yīśustasyaitat vaco niśamya vismayāpanno'bhūt; nijapaścādgāmino mānavān avocca, yuṣmān tathyaṁ vacmi, isrāyelīyalokānāṁ madhye'pi naitādṛśo viśvāso mayā prāptaḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>anyaccāhaṁ yuṣmān vadāmi, bahavaḥ pūrvvasyāḥ paścimāyāśca diśa āgatya ibrāhīmā ishākā yākūbā ca sākam militvā samupavekṣyanti;</para>
  <para style="p">
    <verse number="12" style="v"/>kintu yatra sthāne rodanadantagharṣaṇe bhavatastasmin bahirbhūtatamisre rājyasya santānā nikṣesyante|</para>
  <para style="p">
    <verse number="13" style="v"/>tataḥ paraṁ yīśustaṁ śatasenāpatiṁ jagāda, yāhi, tava pratītyanusārato maṅgalaṁ bhūyāt; tadā tasminneva daṇḍe tadīyadāso nirāmayo babhūva|</para>
  <para style="p">
    <verse number="14" style="v"/>anantaraṁ yīśuḥ pitarasya gehamupasthāya jvareṇa pīḍitāṁ śayanīyasthitāṁ tasya śvaśrūṁ vīkṣāñcakre|</para>
  <para style="p">
    <verse number="15" style="v"/>tatastena tasyāḥ karasya spṛṣṭatavāt jvarastāṁ tatyāja, tadā sā samutthāya tān siṣeve|</para>
  <para style="p">
    <verse number="16" style="v"/>anantaraṁ sandhyāyāṁ satyāṁ bahuśo bhūtagrastamanujān tasya samīpam āninyuḥ sa ca vākyena bhūtān tyājayāmāsa, sarvvaprakārapīḍitajanāṁśca nirāmayān cakāra;</para>
  <para style="p">
    <verse number="17" style="v"/>tasmāt, sarvvā durbbalatāsmākaṁ tenaiva paridhāritā| asmākaṁ sakalaṁ vyādhiṁ saeva saṁgṛhītavān| yadetadvacanaṁ yiśayiyabhaviṣyadvādinoktamāsīt, tattadā saphalamabhavat|</para>
  <para style="p">
    <verse number="18" style="v"/>anantaraṁ yīśuścaturdikṣu jananivahaṁ vilokya taṭinyāḥ pāraṁ yātuṁ śiṣyān ādideśa|</para>
  <para style="p">
    <verse number="19" style="v"/>tadānīm eka upādhyāya āgatya kathitavān, he guro, bhavān yatra yāsyati tatrāhamapi bhavataḥ paścād yāsyāmi|</para>
  <para style="p">
    <verse number="20" style="v"/>tato yīśu rjagāda, kroṣṭuḥ sthātuṁ sthānaṁ vidyate, vihāyaso vihaṅgamānāṁ nīḍāni ca santi; kintu manuṣyaputrasya śiraḥ sthāpayituṁ sthānaṁ na vidyate|</para>
  <para style="p">
    <verse number="21" style="v"/>anantaram apara ekaḥ śiṣyastaṁ babhāṣe, he prabho, prathamato mama pitaraṁ śmaśāne nidhātuṁ gamanārthaṁ mām anumanyasva|</para>
  <para style="p">
    <verse number="22" style="v"/>tato yīśuruktavān mṛtā mṛtān śmaśāne nidadhatu, tvaṁ mama paścād āgaccha|</para>
  <para style="p">
    <verse number="23" style="v"/>anantaraṁ tasmin nāvamārūḍhe tasya śiṣyāstatpaścāt jagmuḥ|</para>
  <para style="p">
    <verse number="24" style="v"/>paścāt sāgarasya madhyaṁ teṣu gateṣu tādṛśaḥ prabalo jhañbhśanila udatiṣṭhat, yena mahātaraṅga utthāya taraṇiṁ chāditavān, kintu sa nidrita āsīt|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā śiṣyā āgatya tasya nidrābhaṅgaṁ kṛtvā kathayāmāsuḥ, he prabho, vayaṁ mriyāmahe, bhavān asmākaṁ prāṇān rakṣatu|</para>
  <para style="p">
    <verse number="26" style="v"/>tadā sa tān uktavān, he alpaviśvāsino yūyaṁ kuto vibhītha? tataḥ sa utthāya vātaṁ sāgarañca tarjayāmāsa, tato nirvvātamabhavat|</para>
  <para style="p">
    <verse number="27" style="v"/>aparaṁ manujā vismayaṁ vilokya kathayāmāsuḥ, aho vātasaritpatī asya kimājñāgrāhiṇau? kīdṛśo'yaṁ mānavaḥ|</para>
  <para style="p">
    <verse number="28" style="v"/>anantaraṁ sa pāraṁ gatvā giderīyadeśam upasthitavān; tadā dvau bhūtagrastamanujau śmaśānasthānād bahi rbhūtvā taṁ sākṣāt kṛtavantau, tāvetādṛśau pracaṇḍāvāstāṁ yat tena sthānena kopi yātuṁ nāśaknot|</para>
  <para style="p">
    <verse number="29" style="v"/>tāvucaiḥ kathayāmāsatuḥ, he īśvarasya sūno yīśo, tvayā sākam āvayoḥ kaḥ sambandhaḥ? nirūpitakālāt prāgeva kimāvābhyāṁ yātanāṁ dātum atrāgatosi?</para>
  <para style="p">
    <verse number="30" style="v"/>tadānīṁ tābhyāṁ kiñcid dūre varāhāṇām eko mahāvrajo'carat|</para>
  <para style="p">
    <verse number="31" style="v"/>tato bhūtau tau tasyāntike vinīya kathayāmāsatuḥ, yadyāvāṁ tyājayasi, tarhi varāhāṇāṁ madhyevrajam āvāṁ preraya|</para>
  <para style="p">
    <verse number="32" style="v"/>tadā yīśuravadat yātaṁ, anantaraṁ tau yadā manujau vihāya varāhān āśritavantau, tadā te sarvve varāhā uccasthānāt mahājavena dhāvantaḥ sāgarīyatoye majjanto mamruḥ|</para>
  <para style="p">
    <verse number="33" style="v"/>tato varāharakṣakāḥ palāyamānā madhyenagaraṁ tau bhūtagrastau prati yadyad aghaṭata, tāḥ sarvvavārttā avadan|</para>
  <para style="p">
    <verse number="34" style="v"/>tato nāgarikāḥ sarvve manujā yīśuṁ sākṣāt karttuṁ bahirāyātāḥ tañca vilokya prārthayāñcakrire bhavān asmākaṁ sīmāto yātu|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ yīśu rnaukāmāruhya punaḥ pāramāgatya nijagrāmam āyayau|</para>
  <para style="p">
    <verse number="2" style="v"/>tataḥ katipayā janā ekaṁ pakṣāghātinaṁ svaṭṭopari śāyayitvā tatsamīpam ānayan; tato yīśusteṣāṁ pratītiṁ vijñāya taṁ pakṣāghātinaṁ jagāda, he putra, susthiro bhava, tava kaluṣasya marṣaṇaṁ jātam|</para>
  <para style="p">
    <verse number="3" style="v"/>tāṁ kathāṁ niśamya kiyanta upādhyāyā manaḥsu cintitavanta eṣa manuja īśvaraṁ nindati|</para>
  <para style="p">
    <verse number="4" style="v"/>tataḥ sa teṣām etādṛśīṁ cintāṁ vijñāya kathitavān, yūyaṁ manaḥsu kṛta etādṛśīṁ kucintāṁ kurutha?</para>
  <para style="p">
    <verse number="5" style="v"/>tava pāpamarṣaṇaṁ jātaṁ, yadvā tvamutthāya gaccha, dvayoranayo rvākyayoḥ kiṁ vākyaṁ vaktuṁ sugamaṁ?</para>
  <para style="p">
    <verse number="6" style="v"/>kintu medinyāṁ kaluṣaṁ kṣamituṁ manujasutasya sāmarthyamastīti yūyaṁ yathā jānītha, tadarthaṁ sa taṁ pakṣāghātinaṁ gaditavān, uttiṣṭha, nijaśayanīyaṁ ādāya gehaṁ gaccha|</para>
  <para style="p">
    <verse number="7" style="v"/>tataḥ sa tatkṣaṇād utthāya nijagehaṁ prasthitavān|</para>
  <para style="p">
    <verse number="8" style="v"/>mānavā itthaṁ vilokya vismayaṁ menire, īśvareṇa mānavāya sāmarthyam īdṛśaṁ dattaṁ iti kāraṇāt taṁ dhanyaṁ babhāṣire ca|</para>
  <para style="p">
    <verse number="9" style="v"/>anantaraṁ yīśustatsthānād gacchan gacchan karasaṁgrahasthāne samupaviṣṭaṁ mathināmānam ekaṁ manujaṁ vilokya taṁ babhāṣe, mama paścād āgaccha, tataḥ sa utthāya tasya paścād vavrāja|</para>
  <para style="p">
    <verse number="10" style="v"/>tataḥ paraṁ yīśau gṛhe bhoktum upaviṣṭe bahavaḥ karasaṁgrāhiṇaḥ kaluṣiṇaśca mānavā āgatya tena sākaṁ tasya śiṣyaiśca sākam upaviviśuḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>phirūśinastad dṛṣṭvā tasya śiṣyān babhāṣire, yuṣmākaṁ guruḥ kiṁ nimittaṁ karasaṁgrāhibhiḥ kaluṣibhiśca sākaṁ bhuṁkte?</para>
  <para style="p">
    <verse number="12" style="v"/>yīśustat śrutvā tān pratyavadat, nirāmayalokānāṁ cikitsakena prayojanaṁ nāsti, kintu sāmayalokānāṁ prayojanamāste|</para>
  <para style="p">
    <verse number="13" style="v"/>ato yūyaṁ yātvā vacanasyāsyārthaṁ śikṣadhvam, dayāyāṁ me yathā prīti rna tathā yajñakarmmaṇi|yato'haṁ dhārmmikān āhvātuṁ nāgato'smi kintu manaḥ parivarttayituṁ pāpina āhvātum āgato'smi|</para>
  <para style="p">
    <verse number="14" style="v"/>anantaraṁ yohanaḥ śiṣyāstasya samīpam āgatya kathayāmāsuḥ, phirūśino vayañca punaḥ punarupavasāmaḥ, kintu tava śiṣyā nopavasanti, kutaḥ?</para>
  <para style="p">
    <verse number="15" style="v"/>tadā yīśustān avocat yāvat sakhīnāṁ saṁṅge kanyāyā varastiṣṭhati, tāvat kiṁ te vilāpaṁ karttuṁ śakluvanti? kintu yadā teṣāṁ saṁṅgād varaṁ nayanti, tādṛśaḥ samaya āgamiṣyati, tadā te upavatsyanti|</para>
  <para style="p">
    <verse number="16" style="v"/>purātanavasane kopi navīnavastraṁ na yojayati, yasmāt tena yojitena purātanavasanaṁ chinatti tacchidrañca bahukutsitaṁ dṛśyate|</para>
  <para style="p">
    <verse number="17" style="v"/>anyañca purātanakutvāṁ kopi navānagostanīrasaṁ na nidadhāti, yasmāt tathā kṛte kutū rvidīryyate tena gostanīrasaḥ patati kutūśca naśyati; tasmāt navīnāyāṁ kutvāṁ navīno gostanīrasaḥ sthāpyate, tena dvayoravanaṁ bhavati|</para>
  <para style="p">
    <verse number="18" style="v"/>aparaṁ tenaitatkathākathanakāle eko'dhipatistaṁ praṇamya babhāṣe, mama duhitā prāyeṇaitāvatkāle mṛtā, tasmād bhavānāgatya tasyā gātre hastamarpayatu, tena sā jīviṣyati|</para>
  <para style="p">
    <verse number="19" style="v"/>tadānīṁ yīśuḥ śiṣyaiḥ sākam utthāya tasya paścād vavrāja|</para>
  <para style="p">
    <verse number="20" style="v"/>ityanantare dvādaśavatsarān yāvat pradarāmayena śīrṇaikā nārī tasya paścād āgatya tasya vasanasya granthiṁ pasparśa;</para>
  <para style="p">
    <verse number="21" style="v"/>yasmāt mayā kevalaṁ tasya vasanaṁ spṛṣṭvā svāsthyaṁ prāpsyate, sā nārīti manasi niścitavatī|</para>
  <para style="p">
    <verse number="22" style="v"/>tato yīśurvadanaṁ parāvarttya tāṁ jagāda, he kanye, tvaṁ susthirā bhava, tava viśvāsastvāṁ svasthāmakārṣīt| etadvākye gaditaeva sā yoṣit svasthābhūt|</para>
  <para style="p">
    <verse number="23" style="v"/>aparaṁ yīśustasyādhyakṣasya gehaṁ gatvā vādakaprabhṛtīn bahūn lokān śabdāyamānān vilokya tān avadat,</para>
  <para style="p">
    <verse number="24" style="v"/>panthānaṁ tyaja, kanyeyaṁ nāmriyata nidritāste; kathāmetāṁ śrutvā te tamupajahasuḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>kintu sarvveṣu bahiṣkṛteṣu so'bhyantaraṁ gatvā kanyāyāḥ karaṁ dhṛtavān, tena sodatiṣṭhat;</para>
  <para style="p">
    <verse number="26" style="v"/>tatastatkarmmaṇo yaśaḥ kṛtsnaṁ taṁ deśaṁ vyāptavat|</para>
  <para style="p">
    <verse number="27" style="v"/>tataḥ paraṁ yīśustasmāt sthānād yātrāṁ cakāra; tadā he dāyūdaḥ santāna, asmān dayasva, iti vadantau dvau janāvandhau procairāhūyantau tatpaścād vavrajatuḥ|</para>
  <para style="p">
    <verse number="28" style="v"/>tato yīśau gehamadhyaṁ praviṣṭaṁ tāvapi tasya samīpam upasthitavantau, tadānīṁ sa tau pṛṣṭavān karmmaitat karttuṁ mama sāmarthyam āste, yuvāṁ kimiti pratīthaḥ? tadā tau pratyūcatuḥ, satyaṁ prabho|</para>
  <para style="p">
    <verse number="29" style="v"/>tadānīṁ sa tayo rlocanāni spṛśan babhāṣe, yuvayoḥ pratītyanusārād yuvayo rmaṅgalaṁ bhūyāt| tena tatkṣaṇāt tayo rnetrāṇi prasannānyabhavan,</para>
  <para style="p">
    <verse number="30" style="v"/>paścād yīśustau dṛḍhamājñāpya jagāda, avadhattam etāṁ kathāṁ kopi manujo ma jānīyāt|</para>
  <para style="p">
    <verse number="31" style="v"/>kintu tau prasthāya tasmin kṛtsne deśe tasya kīrttiṁ prakāśayāmāsatuḥ|</para>
  <para style="p">
    <verse number="32" style="v"/>aparaṁ tau bahiryāta etasminnantare manujā ekaṁ bhūtagrastamūkaṁ tasya samīpam ānītavantaḥ|</para>
  <para style="p">
    <verse number="33" style="v"/>tena bhūte tyājite sa mūkaḥ kathāṁ kathayituṁ prārabhata, tena janā vismayaṁ vijñāya kathayāmāsuḥ, isrāyelo vaṁśe kadāpi nedṛgadṛśyata;</para>
  <para style="p">
    <verse number="34" style="v"/>kintu phirūśinaḥ kathayāñcakruḥ bhūtādhipatinā sa bhūtān tyājayati|</para>
  <para style="p">
    <verse number="35" style="v"/>tataḥ paraṁ yīśusteṣāṁ bhajanabhavana upadiśan rājyasya susaṁvādaṁ pracārayan lokānāṁ yasya ya āmayo yā ca pīḍāsīt, tān śamayan śamayaṁśca sarvvāṇi nagarāṇi grāmāṁśca babhrāma|</para>
  <para style="p">
    <verse number="36" style="v"/>anyañca manujān vyākulān arakṣakameṣāniva ca tyaktān nirīkṣya teṣu kāruṇikaḥ san śiṣyān avadat,</para>
  <para style="p">
    <verse number="37" style="v"/>śasyāni pracurāṇi santi, kintu chettāraḥ stokāḥ|</para>
  <para style="p">
    <verse number="38" style="v"/>kṣetraṁ pratyaparān chedakān prahetuṁ śasyasvāminaṁ prārthayadhvam|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ yīśu rdvādaśaśiṣyān āhūyāmedhyabhūtān tyājayituṁ sarvvaprakārarogān pīḍāśca śamayituṁ tebhyaḥ sāmarthyamadāt|</para>
  <para style="p">
    <verse number="2" style="v"/>teṣāṁ dvādaśapreṣyāṇāṁ nāmānyetāni| prathamaṁ śimon yaṁ pitaraṁ vadanti, tataḥ paraṁ tasya sahaja āndriyaḥ, sivadiyasya putro yākūb</para>
  <para style="p">
    <verse number="3" style="v"/>tasya sahajo yohan; philip barthalamay thomāḥ karasaṁgrāhī mathiḥ, ālpheyaputro yākūb,</para>
  <para style="p">
    <verse number="4" style="v"/>kinānīyaḥ śimon, ya īṣkariyotīyayihūdāḥ khrīṣṭaṁ parakare'rpayat|</para>
  <para style="p">
    <verse number="5" style="v"/>etān dvādaśaśiṣyān yīśuḥ preṣayan ityājñāpayat, yūyam anyadeśīyānāṁ padavīṁ śemiroṇīyānāṁ kimapi nagarañca na praviśye</para>
  <para style="p">
    <verse number="6" style="v"/>isrāyelgotrasya hāritā ye ye meṣāsteṣāmeva samīpaṁ yāta|</para>
  <para style="p">
    <verse number="7" style="v"/>gatvā gatvā svargasya rājatvaṁ savidhamabhavat, etāṁ kathāṁ pracārayata|</para>
  <para style="p">
    <verse number="8" style="v"/>āmayagrastān svasthān kuruta, kuṣṭhinaḥ pariṣkuruta, mṛtalokān jīvayata, bhūtān tyājayata, vinā mūlyaṁ yūyam alabhadhvaṁ vinaiva mūlyaṁ viśrāṇayata|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu sveṣāṁ kaṭibandheṣu svarṇarūpyatāmrāṇāṁ kimapi na gṛhlīta|</para>
  <para style="p">
    <verse number="10" style="v"/>anyacca yātrāyai celasampuṭaṁ vā dvitīyavasanaṁ vā pāduke vā yaṣṭiḥ, etān mā gṛhlīta, yataḥ kāryyakṛt bharttuṁ yogyo bhavati|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaṁ yūyaṁ yat puraṁ yañca grāmaṁ praviśatha, tatra yo jano yogyapātraṁ tamavagatya yānakālaṁ yāvat tatra tiṣṭhata|</para>
  <para style="p">
    <verse number="12" style="v"/>yadā yūyaṁ tadgehaṁ praviśatha, tadā tamāśiṣaṁ vadata|</para>
  <para style="p">
    <verse number="13" style="v"/>yadi sa yogyapātraṁ bhavati, tarhi tatkalyāṇaṁ tasmai bhaviṣyati, nocet sāśīryuṣmabhyameva bhaviṣyati|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu ye janā yuṣmākamātithyaṁ na vidadhati yuṣmākaṁ kathāñca na śṛṇvanti teṣāṁ gehāt purādvā prasthānakāle svapadūlīḥ pātayata|</para>
  <para style="p">
    <verse number="15" style="v"/>yuṣmānahaṁ tathyaṁ vacmi vicāradine tatpurasya daśātaḥ sidomamorāpurayordaśā sahyatarā bhaviṣyati|</para>
  <para style="p">
    <verse number="16" style="v"/>paśyata, vṛkayūthamadhye meṣaḥ yathāvistathā yuṣmāna prahiṇomi, tasmād yūyam ahiriva satarkāḥ kapotāivāhiṁsakā bhavata|</para>
  <para style="p">
    <verse number="17" style="v"/>nṛbhyaḥ sāvadhānā bhavata; yatastai ryūyaṁ rājasaṁsadi samarpiṣyadhve teṣāṁ bhajanagehe prahāriṣyadhve|</para>
  <para style="p">
    <verse number="18" style="v"/>yūyaṁ mannāmahetoḥ śāstṛṇāṁ rājñāñca samakṣaṁ tānanyadeśinaścādhi sākṣitvārthamāneṣyadhve|</para>
  <para style="p">
    <verse number="19" style="v"/>kintvitthaṁ samarpitā yūyaṁ kathaṁ kimuttaraṁ vakṣyatha tatra mā cintayata, yatastadā yuṣmābhi ryad vaktavyaṁ tat taddaṇḍe yuṣmanmanaḥ su samupasthāsyati|</para>
  <para style="p">
    <verse number="20" style="v"/>yasmāt tadā yo vakṣyati sa na yūyaṁ kintu yuṣmākamantarasthaḥ pitrātmā|</para>
  <para style="p">
    <verse number="21" style="v"/>sahajaḥ sahajaṁ tātaḥ sutañca mṛtau samarpayiṣyati, apatyāgi svasvapitroे rvipakṣībhūya tau ghātayiṣyanti|</para>
  <para style="p">
    <verse number="22" style="v"/>mannamahetoḥ sarvve janā yuṣmān ṛृtīyiṣyante, kintu yaḥ śeṣaṁ yāvad dhairyyaṁ ghṛtvā sthāsyati, sa trāyiṣyate|</para>
  <para style="p">
    <verse number="23" style="v"/>tai ryadā yūyamekapure tāḍiṣyadhve, tadā yūyamanyapuraṁ palāyadhvaṁ yuṣmānahaṁ tathyaṁ vacmi yāvanmanujasuto naiti tāvad isrāyeldeśīyasarvvanagarabhramaṇaṁ samāpayituṁ na śakṣyatha|</para>
  <para style="p">
    <verse number="24" style="v"/>guroḥ śiṣyo na mahān, prabhordāso na mahān|</para>
  <para style="p">
    <verse number="25" style="v"/>yadi śiṣyo nijaguro rdāsaśca svaprabhoḥ samāno bhavati tarhi tad yatheṣṭaṁ| cettairgṛhapatirbhūtarāja ucyate, tarhi parivārāḥ kiṁ tathā na vakṣyante?</para>
  <para style="p">
    <verse number="26" style="v"/>kintu tebhyo yūyaṁ mā bibhīta, yato yanna prakāśiṣyate, tādṛk chāditaṁ kimapi nāsti, yacca na vyañciṣyate, tādṛg guptaṁ kimapi nāsti|</para>
  <para style="p">
    <verse number="27" style="v"/>yadahaṁ yuṣmān tamasi vacmi tad yuṣmābhirdīptau kathyatāṁ; karṇābhyāṁ yat śrūyate tad gehopari pracāryyatāṁ|</para>
  <para style="p">
    <verse number="28" style="v"/>ye kāyaṁ hantuṁ śaknuvanti nātmānaṁ, tebhyo mā bhaiṣṭa; yaḥ kāyātmānau niraye nāśayituṁ, śaknoti, tato bibhīta|</para>
  <para style="p">
    <verse number="29" style="v"/>dvau caṭakau kimekatāmramudrayā na vikrīyete? tathāpi yuṣmattātānumatiṁ vinā teṣāmekopi bhuvi na patati|</para>
  <para style="p">
    <verse number="30" style="v"/>yuṣmacchirasāṁ sarvvakacā gaṇitāṁḥ santi|</para>
  <para style="p">
    <verse number="31" style="v"/>ato mā bibhīta, yūyaṁ bahucaṭakebhyo bahumūlyāḥ|</para>
  <para style="p">
    <verse number="32" style="v"/>yo manujasākṣānmāmaṅgīkurute tamahaṁ svargasthatātasākṣādaṅgīkariṣye|</para>
  <para style="p">
    <verse number="33" style="v"/>pṛthvyāmahaṁ śāntiṁ dātumāgata̮iti mānubhavata, śāntiṁ dātuṁ na kintvasiṁ|</para>
  <para style="p">
    <verse number="34" style="v"/>pitṛmātṛścaśrūbhiḥ sākaṁ sutasutābadhū rvirodhayituñcāgateाsmi|</para>
  <para style="p">
    <verse number="35" style="v"/>tataḥ svasvaparivāraeva nṛśatru rbhavitā|</para>
  <para style="p">
    <verse number="36" style="v"/>yaḥ pitari mātari vā mattodhikaṁ prīyate, sa na madarhaḥ;</para>
  <para style="p">
    <verse number="37" style="v"/>yaśca sute sutāyāṁ vā mattodhikaṁ prīyate, seाpi na madarhaḥ|</para>
  <para style="p">
    <verse number="38" style="v"/>yaḥ svakruśaṁ gṛhlan matpaścānnaiti, seाpi na madarhaḥ|</para>
  <para style="p">
    <verse number="39" style="v"/>yaḥ svaprāṇānavati, sa tān hārayiṣyate, yastu matkṛte svaprāṇān hārayati, sa tānavati|</para>
  <para style="p">
    <verse number="40" style="v"/>yo yuṣmākamātithyaṁ vidadhāti, sa mamātithyaṁ vidadhāti, yaśca mamātithyaṁ vidadhāti, sa matprerakasyātithyaṁ vidadhāti|</para>
  <para style="p">
    <verse number="41" style="v"/>yo bhaviṣyadvādīti jñātvā tasyātithyaṁ vidhatte, sa bhaviṣyadvādinaḥ phalaṁ lapsyate, yaśca dhārmmika iti viditvā tasyātithyaṁ vidhatte sa dhārmmikamānavasya phalaṁ prāpsyati|</para>
  <para style="p">
    <verse number="42" style="v"/>yaśca kaścit eteṣāṁ kṣudranarāṇām yaṁ kañcanaikaṁ śiṣya iti viditvā kaṁsaikaṁ śītalasalilaṁ tasmai datte, yuṣmānahaṁ tathyaṁ vadāmi, sa kenāpi prakāreṇa phalena na vañciṣyate|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>itthaṁ yīśuḥ svadvādaśaśiṣyāṇāmājñāpanaṁ samāpya pure pura upadeṣṭuṁ susaṁvādaṁ pracārayituṁ tatsthānāt pratasthe|</para>
  <para style="p">
    <verse number="2" style="v"/>anantaraṁ yohan kārāyāṁ tiṣṭhan khriṣṭasya karmmaṇāṁ vārttaṁ prāpya yasyāgamanavārttāsīt saeva kiṁ tvaṁ? vā vayamanyam apekṣiṣyāmahe?</para>
  <para style="p">
    <verse number="3" style="v"/>etat praṣṭuṁ nijau dvau śiṣyau prāhiṇot|</para>
  <para style="p">
    <verse number="4" style="v"/>yīśuḥ pratyavocat, andhā netrāṇi labhante, khañcā gacchanti, kuṣṭhinaḥ svasthā bhavanti, badhirāḥ śṛṇvanti, mṛtā jīvanta uttiṣṭhanti, daridrāṇāṁ samīpe susaṁvādaḥ pracāryyata,</para>
  <para style="p">
    <verse number="5" style="v"/>etāni yadyad yuvāṁ śṛṇuthaḥ paśyathaśca gatvā tadvārttāṁ yohanaṁ gadataṁ|</para>
  <para style="p">
    <verse number="6" style="v"/>yasyāhaṁ na vighnībhavāmi, saeva dhanyaḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>anantaraṁ tayoḥ prasthitayo ryīśu ryohanam uddiśya janān jagāda, yūyaṁ kiṁ draṣṭuṁ vahirmadhyeprāntaram agacchata? kiṁ vātena kampitaṁ nalaṁ?</para>
  <para style="p">
    <verse number="8" style="v"/>vā kiṁ vīkṣituṁ vahirgatavantaḥ? kiṁ parihitasūkṣmavasanaṁ manujamekaṁ? paśyata, ye sūkṣmavasanāni paridadhati, te rājadhānyāṁ tiṣṭhanti|</para>
  <para style="p">
    <verse number="9" style="v"/>tarhi yūyaṁ kiṁ draṣṭuṁ bahiragamata, kimekaṁ bhaviṣyadvādinaṁ? tadeva satyaṁ| yuṣmānahaṁ vadāmi, sa bhaviṣyadvādinopi mahān;</para>
  <para style="p">
    <verse number="10" style="v"/>yataḥ, paśya svakīyadūtoyaṁ tvadagre preṣyate mayā| sa gatvā tava panthānaṁ smayak pariṣkariṣyati|| etadvacanaṁ yamadhi likhitamāste so'yaṁ yohan|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaṁ yuṣmānahaṁ tathyaṁ bravīmi, majjayitu ryohanaḥ śreṣṭhaḥ kopi nārīto nājāyata; tathāpi svargarājyamadhye sarvvebhyo yaḥ kṣudraḥ sa yohanaḥ śreṣṭhaḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>aparañca ā yohano'dya yāvat svargarājyaṁ balādākrāntaṁ bhavati ākraminaśca janā balena tadadhikurvvanti|</para>
  <para style="p">
    <verse number="13" style="v"/>yato yohanaṁ yāvat sarvvabhaviṣyadvādibhi rvyavasthayā ca upadeśaḥ prākāśyata|</para>
  <para style="p">
    <verse number="14" style="v"/>yadi yūyamidaṁ vākyaṁ grahītuṁ śaknutha, tarhi śreyaḥ, yasyāgamanasya vacanamāste so'yam eliyaḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>yasya śrotuṁ karṇau staḥ sa śṛṇotu|</para>
  <para style="p">
    <verse number="16" style="v"/>ete vidyamānajanāḥ kai rmayopamīyante? ye bālakā haṭṭa upaviśya svaṁ svaṁ bandhumāhūya vadanti,</para>
  <para style="p">
    <verse number="17" style="v"/>vayaṁ yuṣmākaṁ samīpe vaṁśīravādayāma, kintu yūyaṁ nānṛtyata; yuṣmākaṁ samīpe ca vayamarodima, kintu yūyaṁ na vyalapata, tādṛśai rbālakaista upamāyiṣyante|</para>
  <para style="p">
    <verse number="18" style="v"/>yato yohan āgatya na bhuktavān na pītavāṁśca, tena lokā vadanti, sa bhūtagrasta iti|</para>
  <para style="p">
    <verse number="19" style="v"/>manujasuta āgatya bhuktavān pītavāṁśca, tena lokā vadanti, paśyata eṣa bhoktā madyapātā caṇḍālapāpināṁ bandhaśca, kintu jñānino jñānavyavahāraṁ nirdoṣaṁ jānanti|</para>
  <para style="p">
    <verse number="20" style="v"/>sa yatra yatra pure bahvāścaryyaṁ karmma kṛtavān, tannivāsināṁ manaḥparāvṛttyabhāvāt tāni nagarāṇi prati hantetyuktā kathitavān,</para>
  <para style="p">
    <verse number="21" style="v"/>hā korāsīn, hā baitsaide, yuṣmanmadhye yadyadāścaryyaṁ karmma kṛtaṁ yadi tat sorasīdonnagara akāriṣyata, tarhi pūrvvameva tannivāsinaḥ śāṇavasane bhasmani copaviśanto manāṁsi parāvarttiṣyanta|</para>
  <para style="p">
    <verse number="22" style="v"/>tasmādahaṁ yuṣmān vadāmi, vicāradine yuṣmākaṁ daśātaḥ sorasīdono rdaśā sahyatarā bhaviṣyati|</para>
  <para style="p">
    <verse number="23" style="v"/>aparañca bata kapharnāhūm, tvaṁ svargaṁ yāvadunnatosi, kintu narake nikṣepsyase, yasmāt tvayi yānyāścaryyāṇi karmmaṇyakāriṣata, yadi tāni sidomnagara akāriṣyanta, tarhi tadadya yāvadasthāsyat|</para>
  <para style="p">
    <verse number="24" style="v"/>kintvahaṁ yuṣmān vadāmi, vicāradine tava daṇḍataḥ sidomo daṇḍo sahyataro bhaviṣyati|</para>
  <para style="p">
    <verse number="25" style="v"/>etasminneva samaye yīśuḥ punaruvāca, he svargapṛthivyorekādhipate pitastvaṁ jñānavato viduṣaśca lokān pratyetāni na prakāśya bālakān prati prakāśitavān, iti hetostvāṁ dhanyaṁ vadāmi|</para>
  <para style="p">
    <verse number="26" style="v"/>he pitaḥ, itthaṁ bhavet yata idaṁ tvadṛṣṭāvuttamaṁ|</para>
  <para style="p">
    <verse number="27" style="v"/>pitrā mayi sarvvāṇi samarpitāni, pitaraṁ vinā kopi putraṁ na jānāti, yān prati putreṇa pitā prakāśyate tān vinā putrād anyaḥ kopi pitaraṁ na jānāti|</para>
  <para style="p">
    <verse number="28" style="v"/>he pariśrāntā bhārākrāntāśca lokā yūyaṁ matsannidhim āgacchata, ahaṁ yuṣmān viśramayiṣyāmi|</para>
  <para style="p">
    <verse number="29" style="v"/>ahaṁ kṣamaṇaśīlo namramanāśca, tasmāt mama yugaṁ sveṣāmupari dhārayata mattaḥ śikṣadhvañca, tena yūyaṁ sve sve manasi viśrāmaṁ lapsyadhbe|</para>
  <para style="p">
    <verse number="30" style="v"/>yato mama yugam anāyāsaṁ mama bhāraśca laghuḥ|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ yīśu rviśrāmavāre śsyamadhyena gacchati, tadā tacchiṣyā bubhukṣitāḥ santaḥ śsyamañjarīśchatvā chitvā khāditumārabhanta|</para>
  <para style="p">
    <verse number="2" style="v"/>tad vilokya phirūśino yīśuṁ jagaduḥ, paśya viśrāmavāre yat karmmākarttavyaṁ tadeva tava śiṣyāḥ kurvvanti|</para>
  <para style="p">
    <verse number="3" style="v"/>sa tān pratyāvadata, dāyūd tatsaṅginaśca bubhukṣitāḥ santo yat karmmākurvvan tat kiṁ yuṣmābhi rnāpāṭhi?</para>
  <para style="p">
    <verse number="4" style="v"/>ye darśanīyāḥ pūpāḥ yājakān vinā tasya tatsaṅgimanujānāñcābhojanīyāsta īśvarāvāsaṁ praviṣṭena tena bhuktāḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>anyacca viśrāmavāre madhyemandiraṁ viśrāmavārīyaṁ niyamaṁ laṅvantopi yājakā nirdoṣā bhavanti, śāstramadhye kimidamapi yuṣmābhi rna paṭhitaṁ?</para>
  <para style="p">
    <verse number="6" style="v"/>yuṣmānahaṁ vadāmi, atra sthāne mandirādapi garīyān eka āste|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu dayāyāṁ me yathā prīti rna tathā yajñakarmmaṇi| etadvacanasyārthaṁ yadi yuyam ajñāsiṣṭa tarhi nirdoṣān doṣiṇo nākārṣṭa|</para>
  <para style="p">
    <verse number="8" style="v"/>anyacca manujasuto viśrāmavārasyāpi patirāste|</para>
  <para style="p">
    <verse number="9" style="v"/>anantaraṁ sa tatsthānāt prasthāya teṣāṁ bhajanabhavanaṁ praviṣṭavān, tadānīm ekaḥ śuṣkakarāmayavān upasthitavān|</para>
  <para style="p">
    <verse number="10" style="v"/>tato yīśum apavadituṁ mānuṣāḥ papracchuḥ, viśrāmavāre nirāmayatvaṁ karaṇīyaṁ na vā?</para>
  <para style="p">
    <verse number="11" style="v"/>tena sa pratyuvāca, viśrāmavāre yadi kasyacid avi rgartte patati, tarhi yastaṁ ghṛtvā na tolayati, etādṛśo manujo yuṣmākaṁ madhye ka āste?</para>
  <para style="p">
    <verse number="12" style="v"/>ave rmānavaḥ kiṁ nahi śreyān? ato viśrāmavāre hitakarmma karttavyaṁ|</para>
  <para style="p">
    <verse number="13" style="v"/>anantaraṁ sa taṁ mānavaṁ gaditavān, karaṁ prasāraya; tena kare prasārite sonyakaravat svastho'bhavat|</para>
  <para style="p">
    <verse number="14" style="v"/>tadā phirūśino bahirbhūya kathaṁ taṁ haniṣyāma iti kumantraṇāṁ tatprātikūlyena cakruḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>tato yīśustad viditvā sthanāntaraṁ gatavān; anyeṣu bahunareṣu tatpaścād gateṣu tān sa nirāmayān kṛtvā ityājñāpayat,</para>
  <para style="p">
    <verse number="16" style="v"/>yūyaṁ māṁ na paricāyayata|</para>
  <para style="p">
    <verse number="17" style="v"/>tasmāt mama prīyo manonīto manasastuṣṭikārakaḥ| madīyaḥ sevako yastu vidyate taṁ samīkṣatāṁ| tasyopari svakīyātmā mayā saṁsthāpayiṣyate| tenānyadeśajāteṣu vyavasthā saṁprakāśyate|</para>
  <para style="p">
    <verse number="18" style="v"/>kenāpi na virodhaṁ sa vivādañca kariṣyati| na ca rājapathe tena vacanaṁ śrāvayiṣyate|</para>
  <para style="p">
    <verse number="19" style="v"/>vyavasthā calitā yāvat nahi tena kariṣyate| tāvat nalo vidīrṇo'pi bhaṁkṣyate nahi tena ca| tathā sadhūmavarttiñca na sa nirvvāpayiṣyate|</para>
  <para style="p">
    <verse number="20" style="v"/>pratyāśāñca kariṣyanti tannāmni bhinnadeśajāḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>yānyetāni vacanāni yiśayiyabhaviṣyadvādinā proktānyāsan, tāni saphalānyabhavan|</para>
  <para style="p">
    <verse number="22" style="v"/>anantaraṁ lokai statsamīpam ānīto bhūtagrastāndhamūkaikamanujastena svasthīkṛtaḥ, tataḥ so'ndho mūko draṣṭuṁ vaktuñcārabdhavān|</para>
  <para style="p">
    <verse number="23" style="v"/>anena sarvve vismitāḥ kathayāñcakruḥ, eṣaḥ kiṁ dāyūdaḥ santāno nahi?</para>
  <para style="p">
    <verse number="24" style="v"/>kintu phirūśinastat śrutvā gaditavantaḥ, bālsibūbnāmno bhūtarājasya sāhāyyaṁ vinā nāyaṁ bhūtān tyājayati|</para>
  <para style="p">
    <verse number="25" style="v"/>tadānīṁ yīśusteṣām iti mānasaṁ vijñāya tān avadat kiñcana rājyaṁ yadi svavipakṣād bhidyate, tarhi tat ucchidyate; yacca kiñcana nagaraṁ vā gṛhaṁ svavipakṣād vibhidyate, tat sthātuṁ na śaknoti|</para>
  <para style="p">
    <verse number="26" style="v"/>tadvat śayatāno yadi śayatānaṁ bahiḥ kṛtvā svavipakṣāt pṛthak pṛthak bhavati, tarhi tasya rājyaṁ kena prakāreṇa sthāsyati?</para>
  <para style="p">
    <verse number="27" style="v"/>ahañca yadi bālsibūbā bhūtān tyājayāmi, tarhi yuṣmākaṁ santānāḥ kena bhūtān tyājayanti? tasmād yuṣmākam etadvicārayitārasta eva bhaviṣyanti|</para>
  <para style="p">
    <verse number="28" style="v"/>kintavahaṁ yadīśvarātmanā bhūtān tyājayāmi, tarhīśvarasya rājyaṁ yuṣmākaṁ sannidhimāgatavat|</para>
  <para style="p">
    <verse number="29" style="v"/>anyañca kopi balavanta janaṁ prathamato na badvvā kena prakāreṇa tasya gṛhaṁ praviśya taddravyādi loṭhayituṁ śaknoti? kintu tat kṛtvā tadīyagṛsya dravyādi loṭhayituṁ śaknoti|</para>
  <para style="p">
    <verse number="30" style="v"/>yaḥ kaścit mama svapakṣīyo nahi sa vipakṣīya āste, yaśca mayā sākaṁ na saṁgṛhlāti, sa vikirati|</para>
  <para style="p">
    <verse number="31" style="v"/>ataeva yuṣmānahaṁ vadāmi, manujānāṁ sarvvaprakārapāpānāṁ nindāyāśca marṣaṇaṁ bhavituṁ śaknoti, kintu pavitrasyātmano viruddhanindāyā marṣaṇaṁ bhavituṁ na śaknoti|</para>
  <para style="p">
    <verse number="32" style="v"/>yo manujasutasya viruddhāṁ kathāṁ kathayati, tasyāparādhasya kṣamā bhavituṁ śaknoti, kintu yaḥ kaścit pavitrasyātmano viruddhāṁ kathāṁ kathayati nehaloke na pretya tasyāparādhasya kṣamā bhavituṁ śaknoti|</para>
  <para style="p">
    <verse number="33" style="v"/>pādapaṁ yadi bhadraṁ vadatha, tarhi tasya phalamapi sādhu vaktavyaṁ, yadi ca pādapaṁ asādhuṁ vadatha, tarhi tasya phalamapyasādhu vaktavyaṁ; yataḥ svīyasvīyaphalena pādapaḥ paricīyate|</para>
  <para style="p">
    <verse number="34" style="v"/>re bhujagavaṁśā yūyamasādhavaḥ santaḥ kathaṁ sādhu vākyaṁ vaktuṁ śakṣyatha? yasmād antaḥkaraṇasya pūrṇabhāvānusārād vadanād vaco nirgacchati|</para>
  <para style="p">
    <verse number="35" style="v"/>tena sādhurmānavo'ntaḥkaraṇarūpāt sādhubhāṇḍāgārāt sādhu dravyaṁ nirgamayati, asādhurmānuṣastvasādhubhāṇḍāgārād asādhuvastūni nirgamayati|</para>
  <para style="p">
    <verse number="36" style="v"/>kintvahaṁ yuṣmān vadāmi, manujā yāvantyālasyavacāṁsi vadanti, vicāradine taduttaramavaśyaṁ dātavyaṁ,</para>
  <para style="p">
    <verse number="37" style="v"/>yatastvaṁ svīyavacobhi rniraparādhaḥ svīyavacobhiśca sāparādho gaṇiṣyase|</para>
  <para style="p">
    <verse number="38" style="v"/>tadānīṁ katipayā upādhyāyāḥ phirūśinaśca jagaduḥ, he guro vayaṁ bhavattaḥ kiñcana lakṣma didṛkṣāmaḥ|</para>
  <para style="p">
    <verse number="39" style="v"/>tadā sa pratyuktavān, duṣṭo vyabhicārī ca vaṁśo lakṣma mṛgayate, kintu bhaviṣyadvādino yūnaso lakṣma vihāyānyat kimapi lakṣma te na pradarśayiṣyante|</para>
  <para style="p">
    <verse number="40" style="v"/>yato yūnam yathā tryahorātraṁ bṛhanmīnasya kukṣāvāsīt, tathā manujaputropi tryahorātraṁ medinyā madhye sthāsyati|</para>
  <para style="p">
    <verse number="41" style="v"/>aparaṁ nīnivīyā mānavā vicāradina etadvaṁśīyānāṁ pratikūlam utthāya tān doṣiṇaḥ kariṣyanti, yasmātte yūnasa upadeśāt manāṁsi parāvarttayāñcakrire, kintvatra yūnasopi gurutara eka āste|</para>
  <para style="p">
    <verse number="42" style="v"/>punaśca dakṣiṇadeśīyā rājñī vicāradina etadvaṁśīyānāṁ pratikūlamutthāya tān doṣiṇaḥ kariṣyati yataḥ sā rājñī sulemano vidyāyāḥ kathāṁ śrotuṁ medinyāḥ sīmna āgacchat, kintu sulemanopi gurutara eko jano'tra āste|</para>
  <para style="p">
    <verse number="43" style="v"/>aparaṁ manujād bahirgato 'pavitrabhūtaḥ śuṣkasthānena gatvā viśrāmaṁ gaveṣayati, kintu tadalabhamānaḥ sa vakti, yasmā; niketanād āgamaṁ, tadeva veśma pakāvṛtya yāmi|</para>
  <para style="p">
    <verse number="44" style="v"/>paścāt sa tat sthānam upasthāya tat śūnyaṁ mārjjitaṁ śobhitañca vilokya vrajan svatopi duṣṭatarān anyasaptabhūtān saṅginaḥ karoti|</para>
  <para style="p">
    <verse number="45" style="v"/>tataste tat sthānaṁ praviśya nivasanti, tena tasya manujasya śeṣadaśā pūrvvadaśātotīvāśubhā bhavati, eteṣāṁ duṣṭavaṁśyānāmapi tathaiva ghaṭiṣyate|</para>
  <para style="p">
    <verse number="46" style="v"/>mānavebhya etāsāṁ kathanāṁ kathanakāle tasya mātā sahajāśca tena sākaṁ kāñcit kathāṁ kathayituṁ vāñchanto bahireva sthitavantaḥ|</para>
  <para style="p">
    <verse number="47" style="v"/>tataḥ kaścit tasmai kathitavān, paśya tava jananī sahajāśca tvayā sākaṁ kāñcana kathāṁ kathayituṁ kāmayamānā bahistiṣṭhanti|</para>
  <para style="p">
    <verse number="48" style="v"/>kintu sa taṁ pratyavadat, mama kā jananī? ke vā mama sahajāḥ?</para>
  <para style="p">
    <verse number="49" style="v"/>paścāt śiṣyān prati karaṁ prasāryya kathitavān, paśya mama jananī mama sahajāścaite;</para>
  <para style="p">
    <verse number="50" style="v"/>yaḥ kaścit mama svargasthasya pituriṣṭaṁ karmma kurute, saeva mama bhrātā bhaginī jananī ca|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparañca tasmin dine yīśuḥ sadmano gatvā saritpate rodhasi samupaviveśa|</para>
  <para style="p">
    <verse number="2" style="v"/>tatra tatsannidhau bahujanānāṁ nivahopasthiteḥ sa taraṇimāruhya samupāviśat, tena mānavā rodhasi sthitavantaḥ|</para>
  <para style="p">
    <verse number="3" style="v"/>tadānīṁ sa dṛṣṭāntaistān itthaṁ bahuśa upadiṣṭavān| paśyata, kaścit kṛṣīvalo bījāni vaptuṁ bahirjagāma,</para>
  <para style="p">
    <verse number="4" style="v"/>tasya vapanakāle katipayabījeṣu mārgapārśve patiteṣu vihagāstāni bhakṣitavantaḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>aparaṁ katipayabījeṣu stokamṛdyuktapāṣāṇe patiteṣu mṛdalpatvāt tatkṣaṇāt tānyaṅkuritāni,</para>
  <para style="p">
    <verse number="6" style="v"/>kintu ravāvudite dagdhāni teṣāṁ mūlāpraviṣṭatvāt śuṣkatāṁ gatāni ca|</para>
  <para style="p">
    <verse number="7" style="v"/>aparaṁ katipayabījeṣu kaṇṭakānāṁ madhye patiteṣu kaṇṭakānyedhitvā tāni jagrasuḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>aparañca katipayabījāni urvvarāyāṁ patitāni; teṣāṁ madhye kānicit śataguṇāni kānicit ṣaṣṭiguṇāni kānicit triṁśaguṁṇāni phalāni phalitavanti|</para>
  <para style="p">
    <verse number="9" style="v"/>śrotuṁ yasya śrutī āsāte sa śṛṇuyāt|</para>
  <para style="p">
    <verse number="10" style="v"/>anantaraṁ śiṣyairāgatya so'pṛcchyata, bhavatā tebhyaḥ kuto dṛṣṭāntakathā kathyate?</para>
  <para style="p">
    <verse number="11" style="v"/>tataḥ sa pratyavadat, svargarājyasya nigūḍhāṁ kathāṁ vedituṁ yuṣmabhyaṁ sāmarthyamadāyi, kintu tebhyo nādāyi|</para>
  <para style="p">
    <verse number="12" style="v"/>yasmād yasyāntike varddhate, tasmāyeva dāyiṣyate, tasmāt tasya bāhulyaṁ bhaviṣyati, kintu yasyāntike na varddhate, tasya yat kiñcanāste, tadapi tasmād ādāyiṣyate|</para>
  <para style="p">
    <verse number="13" style="v"/>te paśyantopi na paśyanti, śṛṇvantopi na śṛṇvanti, budhyamānā api na budhyante ca, tasmāt tebhyo dṛṣṭāntakathā kathyate|</para>
  <para style="p">
    <verse number="14" style="v"/>yathā karṇaiḥ śroṣyatha yūyaṁ vai kintu yūyaṁ na bhotsyatha| netrairdrakṣyatha yūyañca parijñātuṁ na śakṣyatha| te mānuṣā yathā naiva paripaśyanti locanaiḥ| karṇai ryathā na śṛṇvanti na budhyante ca mānasaiḥ| vyāvarttiteṣu citteṣu kāle kutrāpi tairjanaiḥ| mattaste manujāḥ svasthā yathā naiva bhavanti ca| tathā teṣāṁ manuṣyāṇāṁ kriyante sthūlabuddhayaḥ| badhirībhūtakarṇāśca jātāśca mudritā dṛśaḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>yadetāni vacanāni yiśayiyabhaviṣyadvādinā proktāni teṣu tāni phalanti|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yuṣmākaṁ nayanāni dhanyāni, yasmāt tāni vīkṣante; dhanyāśca yuṣmākaṁ śabdagrahāḥ, yasmāt tairākarṇyate|</para>
  <para style="p">
    <verse number="17" style="v"/>mayā yūyaṁ tathyaṁ vacāmi yuṣmābhi ryadyad vīkṣyate, tad bahavo bhaviṣyadvādino dhārmmikāśca mānavā didṛkṣantopi draṣṭuṁ nālabhanta, punaśca yūyaṁ yadyat śṛṇutha, tat te śuśrūṣamāṇā api śrotuṁ nālabhanta|</para>
  <para style="p">
    <verse number="18" style="v"/>kṛṣīvalīyadṛṣṭāntasyārthaṁ śṛṇuta|</para>
  <para style="p">
    <verse number="19" style="v"/>mārgapārśve bījānyuptāni tasyārtha eṣaḥ, yadā kaścit rājyasya kathāṁ niśamya na budhyate, tadā pāpātmāgatya tadīyamanasa uptāṁ kathāṁ haran nayati|</para>
  <para style="p">
    <verse number="20" style="v"/>aparaṁ pāṣāṇasthale bījānyuptāni tasyārtha eṣaḥ; kaścit kathāṁ śrutvaiva harṣacittena gṛhlāti,</para>
  <para style="p">
    <verse number="21" style="v"/>kintu tasya manasi mūlāpraviṣṭatvāt sa kiñcitkālamātraṁ sthirastiṣṭhati; paścāta tatkathākāraṇāt kopi klestāḍanā vā cet jāyate, tarhi sa tatkṣaṇād vighnameti|</para>
  <para style="p">
    <verse number="22" style="v"/>aparaṁ kaṇṭakānāṁ madhye bījānyuptāni tadartha eṣaḥ; kenacit kathāyāṁ śrutāyāṁ sāṁsārikacintābhi rbhrāntibhiśca sā grasyate, tena sā mā viphalā bhavati|</para>
  <para style="p">
    <verse number="23" style="v"/>aparam urvvarāyāṁ bījānyuptāni tadartha eṣaḥ; ye tāṁ kathāṁ śrutvā vudhyante, te phalitāḥ santaḥ kecit śataguṇāni kecita ṣaṣṭiguṇāni kecicca triṁśadguṇāni phalāni janayanti|</para>
  <para style="p">
    <verse number="24" style="v"/>anantaraṁ soparāmekāṁ dṛṣṭāntakathāmupasthāpya tebhyaḥ kathayāmāsa; svargīyarājyaṁ tādṛśena kenacid gṛhasthenopamīyate, yena svīyakṣetre praśastabījānyaupyanta|</para>
  <para style="p">
    <verse number="25" style="v"/>kintu kṣaṇadāyāṁ sakalalokeṣu supteṣu tasya ripurāgatya teṣāṁ godhūmabījānāṁ madhye vanyayavamabījānyuptvā vavrāja|</para>
  <para style="p">
    <verse number="26" style="v"/>tato yadā bījebhyo'ṅkarā jāyamānāḥ kaṇiśāni ghṛtavantaḥ; tadā vanyayavasānyapi dṛśyamānānyabhavan|</para>
  <para style="p">
    <verse number="27" style="v"/>tato gṛhasthasya dāseyā āgamya tasmai kathayāñcakruḥ, he maheccha, bhavatā kiṁ kṣetre bhadrabījāni naupyanta? tathātve vanyayavasāni kṛta āyan?</para>
  <para style="p">
    <verse number="28" style="v"/>tadānīṁ tena te pratigaditāḥ, kenacit ripuṇā karmmadamakāri| dāseyāḥ kathayāmāsuḥ, vayaṁ gatvā tānyutpāyya kṣipāmo bhavataḥ kīdṛśīcchā jāyate?</para>
  <para style="p">
    <verse number="29" style="v"/>tenāvādi, nahi, śaṅke'haṁ vanyayavasotpāṭanakāle yuṣmābhistaiḥ sākaṁ godhūmā apyutpāṭiṣyante|</para>
  <para style="p">
    <verse number="30" style="v"/>ataḥ śsyakarttanakālaṁ yāvad ubhayānyapi saha varddhantāṁ, paścāt karttanakāle karttakān vakṣyāmi, yūyamādau vanyayavasāni saṁgṛhya dāhayituṁ vīṭikā badvvā sthāpayata; kintu sarvve godhūmā yuṣmābhi rbhāṇḍāgāraṁ nītvā sthāpyantām|</para>
  <para style="p">
    <verse number="31" style="v"/>anantaraṁ soparāmekāṁ dṛṣṭāntakathāmutthāpya tebhyaḥ kathitavān kaścinmanujaḥ sarṣapabījamekaṁ nītvā svakṣetra uvāpa|</para>
  <para style="p">
    <verse number="32" style="v"/>sarṣapabījaṁ sarvvasmād bījāt kṣudramapi sadaṅkuritaṁ sarvvasmāt śākāt bṛhad bhavati; sa tādṛśastaru rbhavati, yasya śākhāsu nabhasaḥ khagā āgatya nivasanti; svargīyarājyaṁ tādṛśasya sarṣapaikasya samam|</para>
  <para style="p">
    <verse number="33" style="v"/>punarapi sa upamākathāmekāṁ tebhyaḥ kathayāñcakāra; kācana yoṣit yat kiṇvamādāya droṇatrayamitagodhūmacūrṇānāṁ madhye sarvveṣāṁ miśrībhavanaparyyantaṁ samācchādya nidhattavatī, tatkiṇvamiva svargarājyaṁ|</para>
  <para style="p">
    <verse number="34" style="v"/>itthaṁ yīśu rmanujanivahānāṁ sannidhāvupamākathābhiretānyākhyānāni kathitavān upamāṁ vinā tebhyaḥ kimapi kathāṁ nākathayat|</para>
  <para style="p">
    <verse number="35" style="v"/>etena dṛṣṭāntīyena vākyena vyādāya vadanaṁ nijaṁ| ahaṁ prakāśayiṣyāmi guptavākyaṁ purābhavaṁ| yadetadvacanaṁ bhaviṣyadvādinā proktamāsīt, tat siddhamabhavat|</para>
  <para style="p">
    <verse number="36" style="v"/>sarvvān manujān visṛjya yīśau gṛhaṁ praviṣṭe tacchiṣyā āgatya yīśave kathitavantaḥ, kṣetrasya vanyayavasīyadṛṣṭāntakathām bhavāna asmān spaṣṭīkṛtya vadatu|</para>
  <para style="p">
    <verse number="37" style="v"/>tataḥ sa pratyuvāca, yena bhadrabījānyupyante sa manujaputraḥ,</para>
  <para style="p">
    <verse number="38" style="v"/>kṣetraṁ jagat, bhadrabījānī rājyasya santānāḥ,</para>
  <para style="p">
    <verse number="39" style="v"/>vanyayavasāni pāpātmanaḥ santānāḥ| yena ripuṇā tānyuptāni sa śayatānaḥ, karttanasamayaśca jagataḥ śeṣaḥ, karttakāḥ svargīyadūtāḥ|</para>
  <para style="p">
    <verse number="40" style="v"/>yathā vanyayavasāni saṁgṛhya dāhyante, tathā jagataḥ śeṣe bhaviṣyati;</para>
  <para style="p">
    <verse number="41" style="v"/>arthāt manujasutaḥ svāṁyadūtān preṣayiṣyati, tena te ca tasya rājyāt sarvvān vighnakāriṇo'dhārmmikalokāṁśca saṁgṛhya</para>
  <para style="p">
    <verse number="42" style="v"/>yatra rodanaṁ dantagharṣaṇañca bhavati, tatrāgnikuṇḍe nikṣepsyanti|</para>
  <para style="p">
    <verse number="43" style="v"/>tadānīṁ dhārmmikalokāḥ sveṣāṁ pitū rājye bhāskara̮iva tejasvino bhaviṣyanti| śrotuṁ yasya śrutī āsāte, ma śṛṇuyāt|</para>
  <para style="p">
    <verse number="44" style="v"/>aparañca kṣetramadhye nidhiṁ paśyan yo gopayati, tataḥ paraṁ sānando gatvā svīyasarvvasvaṁ vikrīya ttakṣetraṁ krīṇāti, sa iva svargarājyaṁ|</para>
  <para style="p">
    <verse number="45" style="v"/>anyañca yo vaṇik uttamāṁ muktāṁ gaveṣayan</para>
  <para style="p">
    <verse number="46" style="v"/>mahārghāṁ muktāṁ vilokya nijasarvvasvaṁ vikrīya tāṁ krīṇāti, sa iva svargarājyaṁ|</para>
  <para style="p">
    <verse number="47" style="v"/>punaśca samudro nikṣiptaḥ sarvvaprakāramīnasaṁgrāhyānāya̮iva svargarājyaṁ|</para>
  <para style="p">
    <verse number="48" style="v"/>tasmin ānāye pūrṇe janā yathā rodhasyuttolya samupaviśya praśastamīnān saṁgrahya bhājaneṣu nidadhate, kutsitān nikṣipanti;</para>
  <para style="p">
    <verse number="49" style="v"/>tathaiva jagataḥ śeṣe bhaviṣyati, phalataḥ svargīyadūtā āgatya puṇyavajjanānāṁ madhyāt pāpinaḥ pṛthak kṛtvā vahnikuṇḍe nikṣepsyanti,</para>
  <para style="p">
    <verse number="50" style="v"/>tatra rodanaṁ dantai rdantagharṣaṇañca bhaviṣyataḥ|</para>
  <para style="p">
    <verse number="51" style="v"/>yīśunā te pṛṣṭā yuṣmābhiḥ kimetānyākhyānānyabudhyanta? tadā te pratyavadan, satyaṁ prabho|</para>
  <para style="p">
    <verse number="52" style="v"/>tadānīṁ sa kathitavān, nijabhāṇḍāgārāt navīnapurātanāni vastūni nirgamayati yo gṛhasthaḥ sa iva svargarājyamadhi śikṣitāḥ svarva upadeṣṭāraḥ|</para>
  <para style="p">
    <verse number="53" style="v"/>anantaraṁ yīśuretāḥ sarvvā dṛṣṭāntakathāḥ samāpya tasmāt sthānāt pratasthe| aparaṁ svadeśamāgatya janān bhajanabhavana upadiṣṭavān;</para>
  <para style="p">
    <verse number="54" style="v"/>te vismayaṁ gatvā kathitavanta etasyaitādṛśaṁ jñānam āścaryyaṁ karmma ca kasmād ajāyata?</para>
  <para style="p">
    <verse number="55" style="v"/>kimayaṁ sūtradhārasya putro nahi? etasya mātu rnāma ca kiṁ mariyam nahi? yākub-yūṣaph-śimon-yihūdāśca kimetasya bhrātaro nahi?</para>
  <para style="p">
    <verse number="56" style="v"/>etasya bhaginyaśca kimasmākaṁ madhye na santi? tarhi kasmādayametāni labdhavān? itthaṁ sa teṣāṁ vighnarūpo babhūva;</para>
  <para style="p">
    <verse number="57" style="v"/>tato yīśunā nigaditaṁ svadeśīyajanānāṁ madhyaṁ vinā bhaviṣyadvādī kutrāpyanyatra nāsammānyo bhavatī|</para>
  <para style="p">
    <verse number="58" style="v"/>teṣāmaviśvāsahetoḥ sa tatra sthāne bahvāścaryyakarmmāṇi na kṛtavān|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadānīṁ rājā herod yīśo ryaśaḥ śrutvā nijadāseyān jagād,</para>
  <para style="p">
    <verse number="2" style="v"/>eṣa majjayitā yohan, pramitebhayastasyotthānāt tenetthamadbhutaṁ karmma prakāśyate|</para>
  <para style="p">
    <verse number="3" style="v"/>purā herod nijabhrātu: philipo jāyāyā herodīyāyā anurodhād yohanaṁ dhārayitvā baddhā kārāyāṁ sthāpitavān|</para>
  <para style="p">
    <verse number="4" style="v"/>yato yohan uktavān, etsayāḥ saṁgraho bhavato nocitaḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>tasmāt nṛpatistaṁ hantumicchannapi lokebhyo vibhayāñcakāra; yataḥ sarvve yohanaṁ bhaviṣyadvādinaṁ menire|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu herodo janmāhīyamaha upasthite herodīyāyā duhitā teṣāṁ samakṣaṁ nṛtitvā herodamaprīṇyat|</para>
  <para style="p">
    <verse number="7" style="v"/>tasmāt bhūpatiḥ śapathaṁ kurvvan iti pratyajñāsīt, tvayā yad yācyate, tadevāhaṁ dāsyāmi|</para>
  <para style="p">
    <verse number="8" style="v"/>sā kumārī svīyamātuḥ śikṣāṁ labdhā babhāṣe, majjayituryohana uttamāṅgaṁ bhājane samānīya mahyaṁ viśrāṇaya|</para>
  <para style="p">
    <verse number="9" style="v"/>tato rājā śuśoca, kintu bhojanāyopaviśatāṁ saṅgināṁ svakṛtaśapathasya cānurodhāt tat pradātuma ādideśa|</para>
  <para style="p">
    <verse number="10" style="v"/>paścāt kārāṁ prati naraṁ prahitya yohana uttamāṅgaṁ chittvā</para>
  <para style="p">
    <verse number="11" style="v"/>tat bhājana ānāyya tasyai kumāryyai vyaśrāṇayat, tataḥ sā svajananyāḥ samīpaṁ tannināya|</para>
  <para style="p">
    <verse number="12" style="v"/>paścāt yohanaḥ śiṣyā āgatya kāyaṁ nītvā śmaśāne sthāpayāmāsustato yīśoḥ sannidhiṁ vrajitvā tadvārttāṁ babhāṣire|</para>
  <para style="p">
    <verse number="13" style="v"/>anantaraṁ yīśuriti niśabhya nāvā nirjanasthānam ekākī gatavān, paścāt mānavāstat śrutvā nānānagarebhya āgatya padaistatpaścād īyuḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>tadānīṁ yīśu rbahirāgatya mahāntaṁ jananivahaṁ nirīkṣya teṣu kāruṇikaḥ man teṣāṁ pīḍitajanān nirāmayān cakāra|</para>
  <para style="p">
    <verse number="15" style="v"/>tataḥ paraṁ sandhyāyāṁ śiṣyāstadantikamāgatya kathayāñcakruḥ, idaṁ nirjanasthānaṁ velāpyavasannā; tasmāt manujān svasvagrāmaṁ gantuṁ svārthaṁ bhakṣyāṇi kretuñca bhavān tān visṛjatu|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yīśustānavādīt, teṣāṁ gamane prayojanaṁ nāsti, yūyameva tān bhojayata|</para>
  <para style="p">
    <verse number="17" style="v"/>tadā te pratyavadan, asmākamatra pūpapañcakaṁ mīnadvayañcāste|</para>
  <para style="p">
    <verse number="18" style="v"/>tadānīṁ tenoktaṁ tāni madantikamānayata|</para>
  <para style="p">
    <verse number="19" style="v"/>anantaraṁ sa manujān yavasoparyyupaveṣṭum ājñāpayāmāsa; apara tat pūpapañcakaṁ mīnadvayañca gṛhlan svargaṁ prati nirīkṣyeśvarīyaguṇān anūdya bhaṁktvā śiṣyebhyo dattavān, śiṣyāśca lokebhyo daduḥ|</para>
  <para style="p">
    <verse number="20" style="v"/>tataḥ sarvve bhuktvā paritṛptavantaḥ, tatastadavaśiṣṭabhakṣyaiḥ pūrṇān dvādaśaḍalakān gṛhītavantaḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>te bhoktāraḥ strīrbālakāṁśca vihāya prāyeṇa pañca sahasrāṇi pumāṁsa āsan|</para>
  <para style="p">
    <verse number="22" style="v"/>tadanantaraṁ yīśu rlokānāṁ visarjanakāle śiṣyān taraṇimāroḍhuṁ svāgre pāraṁ yātuñca gāḍhamādiṣṭavān|</para>
  <para style="p">
    <verse number="23" style="v"/>tato lokeṣu visṛṣṭeṣu sa vivikte prārthayituṁ girimekaṁ gatvā sandhyāṁ yāvat tatraikākī sthitavān|</para>
  <para style="p">
    <verse number="24" style="v"/>kintu tadānīṁ sammukhavātatvāt saritpate rmadhye taraṅgaistaraṇirdolāyamānābhavat|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā sa yāminyāścaturthaprahare padbhyāṁ vrajan teṣāmantikaṁ gatavān|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu śiṣyāstaṁ sāgaropari vrajantaṁ vilokya samudvignā jagaduḥ, eṣa bhūta iti śaṅkamānā uccaiḥ śabdāyāñcakrire ca|</para>
  <para style="p">
    <verse number="27" style="v"/>tadaiva yīśustānavadat, susthirā bhavata, mā bhaiṣṭa, eṣo'ham|</para>
  <para style="p">
    <verse number="28" style="v"/>tataḥ pitara ityuktavān, he prabho, yadi bhavāneva, tarhi māṁ bhavatsamīpaṁ yātumājñāpayatu|</para>
  <para style="p">
    <verse number="29" style="v"/>tataḥ tenādiṣṭaḥ pitarastaraṇito'varuhya yīśeाrantikaṁ prāptuṁ toyopari vavrāja|</para>
  <para style="p">
    <verse number="30" style="v"/>kintu pracaṇḍaṁ pavanaṁ vilokya bhayāt toye maṁktum ārebhe, tasmād uccaiḥ śabdāyamānaḥ kathitavān, he prabho, māmavatu|</para>
  <para style="p">
    <verse number="31" style="v"/>yīśustatkṣaṇāt karaṁ prasāryya taṁ dharan uktavān, ha stokapratyayin tvaṁ kutaḥ samaśethāḥ?</para>
  <para style="p">
    <verse number="32" style="v"/>anantaraṁ tayostaraṇimārūḍhayoḥ pavano nivavṛte|</para>
  <para style="p">
    <verse number="33" style="v"/>tadānīṁ ye taraṇyāmāsan, ta āgatya taṁ praṇabhya kathitavantaḥ, yathārthastvameveśvarasutaḥ|</para>
  <para style="p">
    <verse number="34" style="v"/>anantaraṁ pāraṁ prāpya te gineṣarannāmakaṁ nagaramupatasthuḥ,</para>
  <para style="p">
    <verse number="35" style="v"/>tadā tatratyā janā yīśuṁ paricīya taddeśsya caturdiśo vārttāṁ prahitya yatra yāvantaḥ pīḍitā āsan, tāvataeva tadantikamānayāmāsuḥ|</para>
  <para style="p">
    <verse number="36" style="v"/>aparaṁ tadīyavasanasya granthimātraṁ spraṣṭuṁ vinīya yāvanto janāstat sparśaṁ cakrire, te sarvvaeva nirāmayā babhūvuḥ|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparaṁ yirūśālamnagarīyāḥ katipayā adhyāpakāḥ phirūśinaśca yīśoḥ samīpamāgatya kathayāmāsuḥ,</para>
  <para style="p">
    <verse number="2" style="v"/>tava śiṣyāḥ kimartham aprakṣālitakarai rbhakṣitvā paramparāgataṁ prācīnānāṁ vyavahāraṁ laṅvante?</para>
  <para style="p">
    <verse number="3" style="v"/>tato yīśuḥ pratyuvāca, yūyaṁ paramparāgatācāreṇa kuta īśvarājñāṁ laṅvadhve|</para>
  <para style="p">
    <verse number="4" style="v"/>īśvara ityājñāpayat, tvaṁ nijapitarau saṁmanyethāḥ, yena ca nijapitarau nindyete, sa niścitaṁ mriyeta;</para>
  <para style="p">
    <verse number="5" style="v"/>kintu yūyaṁ vadatha, yaḥ svajanakaṁ svajananīṁ vā vākyamidaṁ vadati, yuvāṁ matto yallabhethe, tat nyavidyata,</para>
  <para style="p">
    <verse number="6" style="v"/>sa nijapitarau puna rna saṁmaṁsyate| itthaṁ yūyaṁ paramparāgatena sveṣāmācāreṇeśvarīyājñāṁ lumpatha|</para>
  <para style="p">
    <verse number="7" style="v"/>re kapaṭinaḥ sarvve yiśayiyo yuṣmānadhi bhaviṣyadvacanānyetāni samyag uktavān|</para>
  <para style="p">
    <verse number="8" style="v"/>vadanai rmanujā ete samāyānti madantikaṁ| tathādharai rmadīyañca mānaṁ kurvvanti te narāḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu teṣāṁ mano matto vidūraeva tiṣṭhati| śikṣayanto vidhīn nrājñā bhajante māṁ mudhaiva te|</para>
  <para style="p">
    <verse number="10" style="v"/>tato yīśu rlokān āhūya proktavān, yūyaṁ śrutvā budhyadhbaṁ|</para>
  <para style="p">
    <verse number="11" style="v"/>yanmukhaṁ praviśati, tat manujam amedhyaṁ na karoti, kintu yadāsyāt nirgacchati, tadeva mānuṣamamedhyī karotī|</para>
  <para style="p">
    <verse number="12" style="v"/>tadānīṁ śiṣyā āgatya tasmai kathayāñcakruḥ, etāṁ kathāṁ śrutvā phirūśino vyarajyanta, tat kiṁ bhavatā jñāyate?</para>
  <para style="p">
    <verse number="13" style="v"/>sa pratyavadat, mama svargasthaḥ pitā yaṁ kañcidaṅkuraṁ nāropayat, sa utpāvdyate|</para>
  <para style="p">
    <verse number="14" style="v"/>te tiṣṭhantu, te andhamanujānām andhamārgadarśakā eva; yadyandho'ndhaṁ panthānaṁ darśayati, tarhyubhau gartte patataḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>tadā pitarastaṁ pratyavadat, dṛṣṭāntamimamasmān bodhayatu|</para>
  <para style="p">
    <verse number="16" style="v"/>yīśunā proktaṁ, yūyamadya yāvat kimabodhāḥ stha?</para>
  <para style="p">
    <verse number="17" style="v"/>kathāmimāṁ kiṁ na budhyadhbe ? yadāsyaṁ previśati, tad udare patan bahirniryāti,</para>
  <para style="p">
    <verse number="18" style="v"/>kintvāsyād yanniryāti, tad antaḥkaraṇāt niryātatvāt manujamamedhyaṁ karoti|</para>
  <para style="p">
    <verse number="19" style="v"/>yato'ntaḥkaraṇāt kucintā badhaḥ pāradārikatā veśyāgamanaṁ cairyyaṁ mithyāsākṣyam īśvaranindā caitāni sarvvāṇi niryyānti|</para>
  <para style="p">
    <verse number="20" style="v"/>etāni manuṣyamapavitrī kurvvanti kintvaprakṣālitakareṇa bhojanaṁ manujamamedhyaṁ na karoti|</para>
  <para style="p">
    <verse number="21" style="v"/>anantaraṁ yīśustasmāt sthānāt prasthāya sorasīdonnagarayoḥ sīmāmupatasyau|</para>
  <para style="p">
    <verse number="22" style="v"/>tadā tatsīmātaḥ kācit kinānīyā yoṣid āgatya tamuccairuvāca, he prabho dāyūdaḥ santāna, mamaikā duhitāste sā bhūtagrastā satī mahākleśaṁ prāpnoti mama dayasva|</para>
  <para style="p">
    <verse number="23" style="v"/>kintu yīśustāṁ kimapi noktavān, tataḥ śiṣyā āgatya taṁ nivedayāmāsuḥ, eṣā yoṣid asmākaṁ paścād uccairāhūyāgacchati, enāṁ visṛjatu|</para>
  <para style="p">
    <verse number="24" style="v"/>tadā sa pratyavadat, isrāyelgotrasya hāritameṣān vinā kasyāpyanyasya samīpaṁ nāhaṁ preṣitosmi|</para>
  <para style="p">
    <verse number="25" style="v"/>tataḥ sā nārīsamāgatya taṁ praṇamya jagāda, he prabho māmupakuru|</para>
  <para style="p">
    <verse number="26" style="v"/>sa uktavān, bālakānāṁ bhakṣyamādāya sārameyebhyo dānaṁ nocitaṁ|</para>
  <para style="p">
    <verse number="27" style="v"/>tadā sā babhāṣe, he prabho, tat satyaṁ, tathāpi prabho rbhañcād yaducchiṣṭaṁ patati, tat sārameyāḥ khādanti|</para>
  <para style="p">
    <verse number="28" style="v"/>tato yīśuḥ pratyavadat, he yoṣit, tava viśvāso mahān tasmāt tava manobhilaṣitaṁ sidyyatu, tena tasyāḥ kanyā tasminneva daṇḍe nirāmayābhavat|</para>
  <para style="p">
    <verse number="29" style="v"/>anantaraṁ yīśastasmāt sthānāt prasthāya gālīlsāgarasya sannidhimāgatya dharādharamāruhya tatropaviveśa|</para>
  <para style="p">
    <verse number="30" style="v"/>paścāt jananivaho bahūn khañcāndhamūkaśuṣkakaramānuṣān ādāya yīśoḥ samīpamāgatya taccaraṇāntike sthāpayāmāsuḥ, tataḥ sā tān nirāmayān akarot|</para>
  <para style="p">
    <verse number="31" style="v"/>itthaṁ mūkā vākyaṁ vadanti, śuṣkakarāḥ svāsthyamāyānti, paṅgavo gacchanti, andhā vīkṣante, iti vilokya lokā vismayaṁ manyamānā isrāyela īśvaraṁ dhanyaṁ babhāṣire|</para>
  <para style="p">
    <verse number="32" style="v"/>tadānīṁ yīśuḥ svaśiṣyān āhūya gaditavān, etajjananivaheṣu mama dayā jāyate, ete dinatrayaṁ mayā sākaṁ santi, eṣāṁ bhakṣyavastu ca kañcidapi nāsti, tasmādahametānakṛtāhārān na visrakṣyāmi, tathātve vartmamadhye klāmyeṣuḥ|</para>
  <para style="p">
    <verse number="33" style="v"/>tadā śiṣyā ūcuḥ, etasmin prāntaramadhya etāvato martyān tarpayituṁ vayaṁ kutra pūpān prāpsyāmaḥ?</para>
  <para style="p">
    <verse number="34" style="v"/>yīśurapṛcchat, yuṣmākaṁ nikaṭe kati pūpā āsate? ta ūcuḥ, saptapūpā alpāḥ kṣudramīnāśca santi|</para>
  <para style="p">
    <verse number="35" style="v"/>tadānīṁ sa lokanivahaṁ bhūmāvupaveṣṭum ādiśya</para>
  <para style="p">
    <verse number="36" style="v"/>tān saptapūpān mīnāṁśca gṛhlan īśvarīyaguṇān anūdya bhaṁktvā śiṣyebhyo dadau, śiṣyā lokebhyo daduḥ|</para>
  <para style="p">
    <verse number="37" style="v"/>tataḥ sarvve bhuktvā tṛptavantaḥ; tadavaśiṣṭabhakṣyeṇa saptaḍalakān paripūryya saṁjagṛhuḥ|</para>
  <para style="p">
    <verse number="38" style="v"/>te bhoktāro yoṣito bālakāṁśca vihāya prāyeṇa catuḥsahasrāṇi puruṣā āsan|</para>
  <para style="p">
    <verse number="39" style="v"/>tataḥ paraṁ sa jananivahaṁ visṛjya tarimāruhya magdalāpradeśaṁ gatavān|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadānīṁ phirūśinaḥ sidūkinaścāgatya taṁ parīkṣituṁ nabhamīyaṁ kiñcana lakṣma darśayituṁ tasmai nivedayāmāsuḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>tataḥ sa uktavān, sandhyāyāṁ nabhaso raktatvād yūyaṁ vadatha, śvo nirmmalaṁ dinaṁ bhaviṣyati;</para>
  <para style="p">
    <verse number="3" style="v"/>prātaḥkāle ca nabhaso raktatvāt malinatvāñca vadatha, jhañbhśadya bhaviṣyati| he kapaṭino yadi yūyam antarīkṣasya lakṣma boddhuṁ śaknutha, tarhi kālasyaitasya lakṣma kathaṁ boddhuṁ na śaknutha?</para>
  <para style="p">
    <verse number="4" style="v"/>etatkālasya duṣṭo vyabhicārī ca vaṁśo lakṣma gaveṣayati, kintu yūnaso bhaviṣyadvādino lakṣma vinānyat kimapi lakṣma tān na darśayiyyate| tadānīṁ sa tān vihāya pratasthe|</para>
  <para style="p">
    <verse number="5" style="v"/>anantaramanyapāragamanakāle tasya śiṣyāḥ pūpamānetuṁ vismṛtavantaḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>yīśustānavādīt, yūyaṁ phirūśināṁ sidūkināñca kiṇvaṁ prati sāvadhānāḥ satarkāśca bhavata|</para>
  <para style="p">
    <verse number="7" style="v"/>tena te parasparaṁ vivicya kathayitumārebhire, vayaṁ pūpānānetuṁ vismṛtavanta etatkāraṇād iti kathayati|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu yīśustadvijñāya tānavocat, he stokaviśvāsino yūyaṁ pūpānānayanamadhi kutaḥ parasparametad viviṁkya?</para>
  <para style="p">
    <verse number="9" style="v"/>yuṣmābhiḥ kimadyāpi na jñāyate? pañcabhiḥ pūpaiḥ pañcasahasrapuruṣeṣu bhojiteṣu bhakṣyocchiṣṭapūrṇān kati ḍalakān samagṛhlītaṁ;</para>
  <para style="p">
    <verse number="10" style="v"/>tathā saptabhiḥ pūpaiścatuḥsahasrapuruṣeṣu bhejiteṣu kati ḍalakān samagṛhlīta, tat kiṁ yuṣmābhirna smaryyate?</para>
  <para style="p">
    <verse number="11" style="v"/>tasmāt phirūśināṁ sidūkināñca kiṇvaṁ prati sāvadhānāstiṣṭhata, kathāmimām ahaṁ pūpānadhi nākathayaṁ, etad yūyaṁ kuto na budhyadhve?</para>
  <para style="p">
    <verse number="12" style="v"/>tadānīṁ pūpakiṇvaṁ prati sāvadhānāstiṣṭhateti noktvā phirūśināṁ sidūkināñca upadeśaṁ prati sāvadhānāstiṣṭhateti kathitavān, iti tairabodhi|</para>
  <para style="p">
    <verse number="13" style="v"/>aparañca yīśuḥ kaisariyā-philipipradeśamāgatya śiṣyān apṛcchat, yo'haṁ manujasutaḥ so'haṁ kaḥ? lokairahaṁ kimucye?</para>
  <para style="p">
    <verse number="14" style="v"/>tadānīṁ te kathitavantaḥ, kecid vadanti tvaṁ majjayitā yohan, kecidvadanti, tvam eliyaḥ, kecicca vadanti, tvaṁ yirimiyo vā kaścid bhaviṣyadvādīti|</para>
  <para style="p">
    <verse number="15" style="v"/>paścāt sa tān papraccha, yūyaṁ māṁ kaṁ vadatha? tataḥ śimon pitara uvāca,</para>
  <para style="p">
    <verse number="16" style="v"/>tvamamareśvarasyābhiṣiktaputraḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>tato yīśuḥ kathitavān, he yūnasaḥ putra śimon tvaṁ dhanyaḥ; yataḥ kopi anujastvayyetajjñānaṁ nodapādayat, kintu mama svargasyaḥ pitodapādayat|</para>
  <para style="p">
    <verse number="18" style="v"/>ato'haṁ tvāṁ vadāmi, tvaṁ pitaraḥ (prastaraḥ) ahañca tasya prastarasyopari svamaṇḍalīṁ nirmmāsyāmi, tena nirayo balāt tāṁ parājetuṁ na śakṣyati|</para>
  <para style="p">
    <verse number="19" style="v"/>ahaṁ tubhyaṁ svargīyarājyasya kuñjikāṁ dāsyāmi, tena yat kiñcana tvaṁ pṛthivyāṁ bhaṁtsyasi tatsvarge bhaṁtsyate, yacca kiñcana mahyāṁ mokṣyasi tat svarge mokṣyate|</para>
  <para style="p">
    <verse number="20" style="v"/>paścāt sa śiṣyānādiśat, ahamabhiṣikto yīśuriti kathāṁ kasmaicidapi yūyaṁ mā kathayata|</para>
  <para style="p">
    <verse number="21" style="v"/>anyañca yirūśālamnagaraṁ gatvā prācīnalokebhyaḥ pradhānayājakebhya upādhyāyebhyaśca bahuduḥkhabhogastai rhatatvaṁ tṛtīyadine punarutthānañca mamāvaśyakam etāḥ kathā yīśustatkālamārabhya śiṣyān jñāpayitum ārabdhavān|</para>
  <para style="p">
    <verse number="22" style="v"/>tadānīṁ pitarastasya karaṁ ghṛtvā tarjayitvā kathayitumārabdhavān, he prabho, tat tvatto dūraṁ yātu, tvāṁ prati kadāpi na ghaṭiṣyate|</para>
  <para style="p">
    <verse number="23" style="v"/>kintu sa vadanaṁ parāvartya pitaraṁ jagāda, he vighnakārin, matsammukhād dūrībhava, tvaṁ māṁ bādhase, īśvarīyakāryyāt mānuṣīyakāryyaṁ tubhyaṁ rocate|</para>
  <para style="p">
    <verse number="24" style="v"/>anantaraṁ yīśuḥ svīyaśiṣyān uktavān yaḥ kaścit mama paścādgāmī bhavitum icchati, sa svaṁ dāmyatu, tathā svakruśaṁ gṛhlan matpaścādāyātu|</para>
  <para style="p">
    <verse number="25" style="v"/>yato yaḥ prāṇān rakṣitumicchati, sa tān hārayiṣyati, kintu yo madarthaṁ nijaprāṇān hārayati, sa tān prāpsyati|</para>
  <para style="p">
    <verse number="26" style="v"/>mānuṣo yadi sarvvaṁ jagat labhate nijapraṇān hārayati, tarhi tasya ko lābhaḥ? manujo nijaprāṇānāṁ vinimayena vā kiṁ dātuṁ śaknoti?</para>
  <para style="p">
    <verse number="27" style="v"/>manujasutaḥ svadūtaiḥ sākaṁ pituḥ prabhāveṇāgamiṣyati; tadā pratimanujaṁ svasvakarmmānusārāt phalaṁ dāsyati|</para>
  <para style="p">
    <verse number="28" style="v"/>ahaṁ yuṣmān tathyaṁ vacmi, sarājyaṁ manujasutam āgataṁ na paśyanto mṛtyuṁ na svādiṣyanti, etādṛśāḥ katipayajanā atrāpi daṇḍāyamānāḥ santi|</para>
  <chapter number="17" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ ṣaḍdinebhyaḥ paraṁ yīśuḥ pitaraṁ yākūbaṁ tatsahajaṁ yohanañca gṛhlan uccādre rviviktasthānam āgatya teṣāṁ samakṣaṁ rūpamanyat dadhāra|</para>
  <para style="p">
    <verse number="2" style="v"/>tena tadāsyaṁ tejasvi, tadābharaṇam ālokavat pāṇḍaramabhavat|</para>
  <para style="p">
    <verse number="3" style="v"/>anyacca tena sākaṁ saṁlapantau mūsā eliyaśca tebhyo darśanaṁ dadatuḥ|</para>
  <para style="p">
    <verse number="4" style="v"/>tadānīṁ pitaro yīśuṁ jagāda, he prabho sthitiratrāsmākaṁ śubhā, yadi bhavatānumanyate, tarhi bhavadarthamekaṁ mūsārthamekam eliyārthañcaikam iti trīṇi dūṣyāṇi nirmmama|</para>
  <para style="p">
    <verse number="5" style="v"/>etatkathanakāla eka ujjavalaḥ payodasteṣāmupari chāyāṁ kṛtavān, vāridād eṣā nabhasīyā vāg babhūva, mamāyaṁ priyaḥ putraḥ, asmin mama mahāsantoṣa etasya vākyaṁ yūyaṁ niśāmayata|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu vācametāṁ śṛṇvantaeva śiṣyā mṛśaṁ śaṅkamānā nyubjā nyapatan|</para>
  <para style="p">
    <verse number="7" style="v"/>tadā yīśurāgatya teṣāṁ gātrāṇi spṛśan uvāca, uttiṣṭhata, mā bhaiṣṭa|</para>
  <para style="p">
    <verse number="8" style="v"/>tadānīṁ netrāṇyunmīlya yīśuṁ vinā kamapi na dadṛśuḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>tataḥ param adreravarohaṇakāle yīśustān ityādideśa, manujasutasya mṛtānāṁ madhyādutthānaṁ yāvanna jāyate, tāvat yuṣmābhiretaddarśanaṁ kasmaicidapi na kathayitavyaṁ|</para>
  <para style="p">
    <verse number="10" style="v"/>tadā śiṣyāstaṁ papracchuḥ, prathamam eliya āyāsyatīti kuta upādhyāyairucyate?</para>
  <para style="p">
    <verse number="11" style="v"/>tato yīśuḥ pratyavādīt, eliyaḥ prāgetya sarvvāṇi sādhayiṣyatīti satyaṁ,</para>
  <para style="p">
    <verse number="12" style="v"/>kintvahaṁ yuṣmān vacmi, eliya etya gataḥ, te tamaparicitya tasmin yathecchaṁ vyavajahuḥ; manujasutenāpi teṣāmantike tādṛg duḥkhaṁ bhoktavyaṁ|</para>
  <para style="p">
    <verse number="13" style="v"/>tadānīṁ sa majjayitāraṁ yohanamadhi kathāmetāṁ vyāhṛtavān, itthaṁ tacchiṣyā bubudhire|</para>
  <para style="p">
    <verse number="14" style="v"/>paścāt teṣu jananivahasyāntikamāgateṣu kaścit manujastadantikametya jānūnī pātayitvā kathitavān,</para>
  <para style="p">
    <verse number="15" style="v"/>he prabho, matputraṁ prati kṛpāṁ vidadhātu, sopasmārāmayena bhṛśaṁ vyathitaḥ san punaḥ puna rvahnau muhu rjalamadhye patati|</para>
  <para style="p">
    <verse number="16" style="v"/>tasmād bhavataḥ śiṣyāṇāṁ samīpe tamānayaṁ kintu te taṁ svāsthaṁ karttuṁ na śaktāḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>tadā yīśuḥ kathitavān re aviśvāsinaḥ, re vipathagāminaḥ, punaḥ katikālān ahaṁ yuṣmākaṁ sannidhau sthāsyāmi? katikālān vā yuṣmān sahiṣye? tamatra mamāntikamānayata|</para>
  <para style="p">
    <verse number="18" style="v"/>paścād yīśunā tarjataeva sa bhūtastaṁ vihāya gatavān, taddaṇḍaeva sa bālako nirāmayo'bhūt|</para>
  <para style="p">
    <verse number="19" style="v"/>tataḥ śiṣyā guptaṁ yīśumupāgatya babhāṣire, kuto vayaṁ taṁ bhūtaṁ tyājayituṁ na śaktāḥ?</para>
  <para style="p">
    <verse number="20" style="v"/>yīśunā te proktāḥ, yuṣmākamapratyayāt;</para>
  <para style="p">
    <verse number="21" style="v"/>yuṣmānahaṁ tathyaṁ vacmi yadi yuṣmākaṁ sarṣapaikamātropi viśvāso jāyate, tarhi yuṣmābhirasmin śaile tvamitaḥ sthānāt tat sthānaṁ yāhīti brūte sa tadaiva caliṣyati, yuṣmākaṁ kimapyasādhyañca karmma na sthāsyāti| kintu prārthanopavāsau vinaitādṛśo bhūto na tyājyeta|</para>
  <para style="p">
    <verse number="22" style="v"/>aparaṁ teṣāṁ gālīlpradeśe bhramaṇakāle yīśunā te gaditāḥ, manujasuto janānāṁ kareṣu samarpayiṣyate tai rhaniṣyate ca,</para>
  <para style="p">
    <verse number="23" style="v"/>kintu tṛtīye'hi्na ma utthāpiṣyate, tena te bhṛśaṁ duḥkhitā babhūvaḥ|</para>
  <para style="p">
    <verse number="24" style="v"/>tadanantaraṁ teṣu kapharnāhūmnagaramāgateṣu karasaṁgrāhiṇaḥ pitarāntikamāgatya papracchuḥ, yuṣmākaṁ guruḥ kiṁ mandirārthaṁ karaṁ na dadāti? tataḥ pitaraḥ kathitavān dadāti|</para>
  <para style="p">
    <verse number="25" style="v"/>tatastasmin gṛhamadhyamāgate tasya kathākathanāt pūrvvameva yīśuruvāca, he śimon, medinyā rājānaḥ svasvāpatyebhyaḥ kiṁ videśibhyaḥ kebhyaḥ karaṁ gṛhlanti? atra tvaṁ kiṁ budhyase? tataḥ pitara uktavān, videśibhyaḥ|</para>
  <para style="p">
    <verse number="26" style="v"/>tadā yīśuruktavān, tarhi santānā muktāḥ santi|</para>
  <para style="p">
    <verse number="27" style="v"/>tathāpi yathāsmābhisteṣāmantarāyo na janyate, tatkṛte jaladhestīraṁ gatvā vaḍiśaṁ kṣipa, tenādau yo mīna utthāsyati, taṁ ghṛtvā tanmukhe mocite tolakaikaṁ rūpyaṁ prāpsyasi, tad gṛhītvā tava mama ca kṛte tebhyo dehi|</para>
  <chapter number="18" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadānīṁ śiṣyā yīśoḥ samīpamāgatya pṛṣṭavantaḥ svargarājye kaḥ śreṣṭhaḥ?</para>
  <para style="p">
    <verse number="2" style="v"/>tato yīśuḥ kṣudramekaṁ bālakaṁ svasamīpamānīya teṣāṁ madhye nidhāya jagāda,</para>
  <para style="p">
    <verse number="3" style="v"/>yuṣmānahaṁ satyaṁ bravīmi, yūyaṁ manovinimayena kṣudrabālavat na santaḥ svargarājyaṁ praveṣṭuṁ na śaknutha|</para>
  <para style="p">
    <verse number="4" style="v"/>yaḥ kaścid etasya kṣudrabālakasya samamātmānaṁ namrīkaroti, saeva svargarājaye śreṣṭhaḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>yaḥ kaścid etādṛśaṁ kṣudrabālakamekaṁ mama nāmni gṛhlāti, sa māmeva gṛhlāti|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu yo jano mayi kṛtaviśvāsānāmeteṣāṁ kṣudraprāṇinām ekasyāpi vidhniṁ janayati, kaṇṭhabaddhapeṣaṇīkasya tasya sāgarāgādhajale majjanaṁ śreyaḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>vighnāt jagataḥ santāpo bhaviṣyati, vighno'vaśyaṁ janayiṣyate, kintu yena manujena vighno janiṣyate tasyaiva santāpo bhaviṣyati|</para>
  <para style="p">
    <verse number="8" style="v"/>tasmāt tava karaścaraṇo vā yadi tvāṁ bādhate, tarhi taṁ chittvā nikṣipa, dvikarasya dvipadasya vā tavānaptavahnau nikṣepāt, khañjasya vā chinnahastasya tava jīvane praveśo varaṁ|</para>
  <para style="p">
    <verse number="9" style="v"/>aparaṁ tava netraṁ yadi tvāṁ bādhate, tarhi tadapyutpāvya nikṣipa, dvinetrasya narakāgnau nikṣepāt kāṇasya tava jīvane praveśo varaṁ|</para>
  <para style="p">
    <verse number="10" style="v"/>tasmādavadhaddhaṁ, eteṣāṁ kṣudraprāṇinām ekamapi mā tucchīkuruta,</para>
  <para style="p">
    <verse number="11" style="v"/>yato yuṣmānahaṁ tathyaṁ bravīmi, svarge teṣāṁ dūtā mama svargasthasya piturāsyaṁ nityaṁ paśyanti| evaṁ ye ye hāritāstān rakṣituṁ manujaputra āgacchat|</para>
  <para style="p">
    <verse number="12" style="v"/>yūyamatra kiṁ viviṁgghve? kasyacid yadi śataṁ meṣāḥ santi, teṣāmeko hāryyate ca, tarhi sa ekonaśataṁ meṣān vihāya parvvataṁ gatvā taṁ hāritamekaṁ kiṁ na mṛgayate?</para>
  <para style="p">
    <verse number="13" style="v"/>yadi ca kadācit tanmeṣoddeśaṁ lamate, tarhi yuṣmānahaṁ satyaṁ kathayāmi, so'vipathagāmibhya ekonaśatameṣebhyopi tadekahetoradhikam āhlādate|</para>
  <para style="p">
    <verse number="14" style="v"/>tadvad eteṣāṁ kṣudraprāeिnām ekopi naśyatīti yuṣmākaṁ svargasthapitu rnābhimatam|</para>
  <para style="p">
    <verse number="15" style="v"/>yadyapi tava bhrātā tvayi kimapyaparādhyati, tarhi gatvā yuvayordvayoḥ sthitayostasyāparādhaṁ taṁ jñāpaya| tatra sa yadi tava vākyaṁ śṛṇoti, tarhi tvaṁ svabhrātaraṁ prāptavān,</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yadi na śṛṇoti, tarhi dvābhyāṁ tribhi rvā sākṣībhiḥ sarvvaṁ vākyaṁ yathā niścitaṁ jāyate, tadartham ekaṁ dvau vā sākṣiṇau gṛhītvā yāhi|</para>
  <para style="p">
    <verse number="17" style="v"/>tena sa yadi tayo rvākyaṁ na mānyate, tarhi samājaṁ tajjñāpaya, kintu yadi samājasyāpi vākyaṁ na mānyate,tarhi sa tava samīpe devapūjaka̮iva caṇḍāla̮iva ca bhaviṣyati|</para>
  <para style="p">
    <verse number="18" style="v"/>ahaṁ yuṣmān satyaṁ vadāmi, yuṣmābhiḥ pṛthivyāṁ yad badhyate tat svarge bhaṁtsyate; medinyāṁ yat bhocyate, svarge'pi tat mokṣyate|</para>
  <para style="p">
    <verse number="19" style="v"/>punarahaṁ yuṣmān vadāmi, medinyāṁ yuṣmākaṁ yadi dvāvekavākyībhūya kiñcit prārthayete, tarhi mama svargasthapitrā tat tayoḥ kṛte sampannaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="20" style="v"/>yato yatra dvau trayo vā mama nānni milanti, tatraivāhaṁ teṣāṁ madhye'smi|</para>
  <para style="p">
    <verse number="21" style="v"/>tadānīṁ pitarastatsamīpamāgatya kathitavān he prabho, mama bhrātā mama yadyaparādhyati, tarhi taṁ katikṛtvaḥ kṣamiṣye?</para>
  <para style="p">
    <verse number="22" style="v"/>kiṁ saptakṛtvaḥ? yīśustaṁ jagāda, tvāṁ kevalaṁ saptakṛtvo yāvat na vadāmi, kintu saptatyā guṇitaṁ saptakṛtvo yāvat|</para>
  <para style="p">
    <verse number="23" style="v"/>aparaṁ nijadāsaiḥ saha jigaṇayiṣuḥ kaścid rājeva svargarājayaṁ|</para>
  <para style="p">
    <verse number="24" style="v"/>ārabdhe tasmin gaṇane sārddhasahasramudrāpūritānāṁ daśasahasrapuṭakānām eko'ghamarṇastatsamakṣamānāyi|</para>
  <para style="p">
    <verse number="25" style="v"/>tasya pariśodhanāya dravyābhāvāt pariśodhanārthaṁ sa tadīyabhāryyāputrādisarvvasvañca vikrīyatāmiti tatprabhurādideśa|</para>
  <para style="p">
    <verse number="26" style="v"/>tena sa dāsastasya pādayoḥ patan praṇamya kathitavān , he prabho bhavatā ghairyye kṛte mayā sarvvaṁ pariśodhiṣyate|</para>
  <para style="p">
    <verse number="27" style="v"/>tadānīṁ dāsasya prabhuḥ sakaruṇaḥ san sakalarṇaṁ kṣamitvā taṁ tatyāja|</para>
  <para style="p">
    <verse number="28" style="v"/>kintu tasmin dāse bahi ryāte, tasya śataṁ mudrācaturthāṁśān yo dhārayati, taṁ sahadāsaṁ dṛṣdvā tasya kaṇṭhaṁ niṣpīḍya gaditavān, mama yat prāpyaṁ tat pariśodhaya|</para>
  <para style="p">
    <verse number="29" style="v"/>tadā tasya sahadāsastatpādayoḥ patitvā vinīya babhāṣe, tvayā dhairyye kṛte mayā sarvvaṁ pariśodhiṣyate|</para>
  <para style="p">
    <verse number="30" style="v"/>tathāpi sa tat nāṅagīkṛtya yāvat sarvvamṛṇaṁ na pariśodhitavān tāvat taṁ kārāyāṁ sthāpayāmāsa|</para>
  <para style="p">
    <verse number="31" style="v"/>tadā tasya sahadāsāstasyaitādṛg ācaraṇaṁ vilokya prabhoḥ samīpaṁ gatvā sarvvaṁ vṛttāntaṁ nivedayāmāsuḥ|</para>
  <para style="p">
    <verse number="32" style="v"/>tadā tasya prabhustamāhūya jagāda, re duṣṭa dāsa, tvayā matsannidhau prārthite mayā tava sarvvamṛṇaṁ tyaktaṁ;</para>
  <para style="p">
    <verse number="33" style="v"/>yathā cāhaṁ tvayi karuṇāṁ kṛtavān, tathaiva tvatsahadāse karuṇākaraṇaṁ kiṁ tava nocitaṁ?</para>
  <para style="p">
    <verse number="34" style="v"/>iti kathayitvā tasya prabhuḥ kruddhyan nijaprāpyaṁ yāvat sa na pariśodhitavān, tāvat prahārakānāṁ kareṣu taṁ samarpitavān|</para>
  <para style="p">
    <verse number="35" style="v"/>yadi yūyaṁ svāntaḥkaraṇaiḥ svasvasahajānām aparādhān na kṣamadhve, tarhi mama svargasyaḥ pitāpi yuṣmān pratītthaṁ kariṣyati|</para>
  <chapter number="19" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaram etāsu kathāsu samāptāsu yīśu rgālīlapradeśāt prasthāya yardantīrasthaṁ yihūdāpradeśaṁ prāptaḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>tadā tatpaścāt jananivahe gate sa tatra tān nirāmayān akarot|</para>
  <para style="p">
    <verse number="3" style="v"/>tadanantaraṁ phirūśinastatsamīpamāgatya pārīkṣituṁ taṁ papracchuḥ, kasmādapi kāraṇāt nareṇa svajāyā parityājyā na vā?</para>
  <para style="p">
    <verse number="4" style="v"/>sa pratyuvāca, prathamam īśvaro naratvena nārītvena ca manujān sasarja, tasmāt kathitavān,</para>
  <para style="p">
    <verse number="5" style="v"/>mānuṣaḥ svapitarau parityajya svapatnyām āsakṣyate, tau dvau janāvekāṅgau bhaviṣyataḥ, kimetad yuṣmābhi rna paṭhitam?</para>
  <para style="p">
    <verse number="6" style="v"/>atastau puna rna dvau tayorekāṅgatvaṁ jātaṁ, īśvareṇa yacca samayujyata, manujo na tad bhindyāt|</para>
  <para style="p">
    <verse number="7" style="v"/>tadānīṁ te taṁ pratyavadan, tathātve tyājyapatraṁ dattvā svāṁ svāṁ jāyāṁ tyaktuṁ vyavasthāṁ mūsāḥ kathaṁ lilekha?</para>
  <para style="p">
    <verse number="8" style="v"/>tataḥ sa kathitavān, yuṣmākaṁ manasāṁ kāṭhinyād yuṣmān svāṁ svāṁ jāyāṁ tyaktum anvamanyata kintu prathamād eṣo vidhirnāsīt|</para>
  <para style="p">
    <verse number="9" style="v"/>ato yuṣmānahaṁ vadāmi, vyabhicāraṁ vinā yo nijajāyāṁ tyajet anyāñca vivahet, sa paradārān gacchati; yaśca tyaktāṁ nārīṁ vivahati sopi paradāreṣu ramate|</para>
  <para style="p">
    <verse number="10" style="v"/>tadā tasya śiṣyāstaṁ babhāṣire, yadi svajāyayā sākaṁ puṁsa etādṛk sambandho jāyate, tarhi vivahanameva na bhadraṁ|</para>
  <para style="p">
    <verse number="11" style="v"/>tataḥ sa uktavān, yebhyastatsāmarthyaṁ ādāyi, tān vinānyaḥ kopi manuja etanmataṁ grahītuṁ na śaknoti|</para>
  <para style="p">
    <verse number="12" style="v"/>katipayā jananaklībaḥ katipayā narakṛtaklībaḥ svargarājyāya katipayāḥ svakṛtaklībāśca santi, ye grahītuṁ śaknuvanti te gṛhlantu|</para>
  <para style="p">
    <verse number="13" style="v"/>aparam yathā sa śiśūnāṁ gātreṣu hastaṁ datvā prārthayate, tadarthaṁ tatsamīṁpaṁ śiśava ānīyanta, tata ānayitṛn śiṣyāstiraskṛtavantaḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu yīśuruvāca, śiśavo madantikam āgacchantu, tān mā vārayata, etādṛśāṁ śiśūnāmeva svargarājyaṁ|</para>
  <para style="p">
    <verse number="15" style="v"/>tataḥ sa teṣāṁ gātreṣu hastaṁ datvā tasmāt sthānāt pratasthe|</para>
  <para style="p">
    <verse number="16" style="v"/>aparam eka āgatya taṁ papraccha, he paramaguro, anantāyuḥ prāptuṁ mayā kiṁ kiṁ satkarmma karttavyaṁ?</para>
  <para style="p">
    <verse number="17" style="v"/>tataḥ sa uvāca, māṁ paramaṁ kuto vadasi? vineścaraṁ na kopi paramaḥ, kintu yadyanantāyuḥ prāptuṁ vāñchasi, tarhyājñāḥ pālaya|</para>
  <para style="p">
    <verse number="18" style="v"/>tadā sa pṛṣṭavān, kāḥ kā ājñāḥ? tato yīśuḥ kathitavān, naraṁ mā hanyāḥ, paradārān mā gaccheḥ, mā corayeḥ, mṛṣāsākṣyaṁ mā dadyāḥ,</para>
  <para style="p">
    <verse number="19" style="v"/>nijapitarau saṁmanyasva, svasamīpavāsini svavat prema kuru|</para>
  <para style="p">
    <verse number="20" style="v"/>sa yuvā kathitavān, ā bālyād etāḥ pālayāmi, idānīṁ kiṁ nyūnamāste?</para>
  <para style="p">
    <verse number="21" style="v"/>tato yīśuravadat, yadi siddho bhavituṁ vāñchasi, tarhi gatvā nijasarvvasvaṁ vikrīya daridrebhyo vitara, tataḥ svarge vittaṁ lapsyase; āgaccha, matpaścādvarttī ca bhava|</para>
  <para style="p">
    <verse number="22" style="v"/>etāṁ vācaṁ śrutvā sa yuvā svīyabahusampatte rviṣaṇaḥ san calitavān|</para>
  <para style="p">
    <verse number="23" style="v"/>tadā yīśuḥ svaśiṣyān avadat, dhanināṁ svargarājyapraveśo mahāduṣkara iti yuṣmānahaṁ tathyaṁ vadāmi|</para>
  <para style="p">
    <verse number="24" style="v"/>punarapi yuṣmānahaṁ vadāmi, dhanināṁ svargarājyapraveśāt sūcīchidreṇa mahāṅgagamanaṁ sukaraṁ|</para>
  <para style="p">
    <verse number="25" style="v"/>iti vākyaṁ niśamya śiṣyā aticamatkṛtya kathayāmāsuḥ; tarhi kasya paritrāṇaṁ bhavituṁ śaknoti?</para>
  <para style="p">
    <verse number="26" style="v"/>tadā sa tān dṛṣdvā kathayāmāsa, tat mānuṣāṇāmaśakyaṁ bhavati, kintvīśvarasya sarvvaṁ śakyam|</para>
  <para style="p">
    <verse number="27" style="v"/>tadā pitarastaṁ gaditavān, paśya, vayaṁ sarvvaṁ parityajya bhavataḥ paścādvarttino 'bhavāma; vayaṁ kiṁ prāpsyāmaḥ?</para>
  <para style="p">
    <verse number="28" style="v"/>tato yīśuḥ kathitavān, yuṣmānahaṁ tathyaṁ vadāmi, yūyaṁ mama paścādvarttino jātā iti kāraṇāt navīnasṛṣṭikāle yadā manujasutaḥ svīyaiścaryyasiṁhāsana upavekṣyati, tadā yūyamapi dvādaśasiṁhāsaneṣūpaviśya isrāyelīyadvādaśavaṁśānāṁ vicāraṁ kariṣyatha|</para>
  <para style="p">
    <verse number="29" style="v"/>anyacca yaḥ kaścit mama nāmakāraṇāt gṛhaṁ vā bhrātaraṁ vā bhaginīṁ vā pitaraṁ vā mātaraṁ vā jāyāṁ vā bālakaṁ vā bhūmiṁ parityajati, sa teṣāṁ śataguṇaṁ lapsyate, anantāyumo'dhikāritvañca prāpsyati|</para>
  <para style="p">
    <verse number="30" style="v"/>kintu agrīyā aneke janāḥ paścāt, paścātīyāścāneke lokā agre bhaviṣyanti|</para>
  <chapter number="20" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>svargarājyam etādṛśā kenacid gṛhasyena samaṁ, yo'tiprabhāte nijadrākṣākṣetre kṛṣakān niyoktuṁ gatavān|</para>
  <para style="p">
    <verse number="2" style="v"/>paścāt taiḥ sākaṁ dinaikabhṛtiṁ mudrācaturthāṁśaṁ nirūpya tān drākṣākṣetraṁ prerayāmāsa|</para>
  <para style="p">
    <verse number="3" style="v"/>anantaraṁ praharaikavelāyāṁ gatvā haṭṭe katipayān niṣkarmmakān vilokya tānavadat,</para>
  <para style="p">
    <verse number="4" style="v"/>yūyamapi mama drākṣākṣetraṁ yāta, yuṣmabhyamahaṁ yogyabhṛtiṁ dāsyāmi, tataste vavrajuḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>punaśca sa dvitīyatṛtīyayoḥ praharayo rbahi rgatvā tathaiva kṛtavān|</para>
  <para style="p">
    <verse number="6" style="v"/>tato daṇḍadvayāvaśiṣṭāyāṁ velāyāṁ bahi rgatvāparān katipayajanān niṣkarmmakān vilokya pṛṣṭavān, yūyaṁ kimartham atra sarvvaṁ dinaṁ niṣkarmmāṇastiṣṭhatha?</para>
  <para style="p">
    <verse number="7" style="v"/>te pratyavadan, asmān na kopi karmamaṇi niyuṁkte| tadānīṁ sa kathitavān, yūyamapi mama drākṣākṣetraṁ yāta, tena yogyāṁ bhṛtiṁ lapsyatha|</para>
  <para style="p">
    <verse number="8" style="v"/>tadanantaraṁ sandhyāyāṁ satyāṁ saeva drākṣākṣetrapatiradhyakṣaṁ gadivān, kṛṣakān āhūya śeṣajanamārabhya prathamaṁ yāvat tebhyo bhṛtiṁ dehi|</para>
  <para style="p">
    <verse number="9" style="v"/>tena ye daṇḍadvayāvasthite samāyātāsteṣām ekaiko jano mudrācaturthāṁśaṁ prāpnot|</para>
  <para style="p">
    <verse number="10" style="v"/>tadānīṁ prathamaniyuktā janā āgatyānumitavanto vayamadhikaṁ prapsyāmaḥ, kintu tairapi mudrācaturthāṁśo'lābhi|</para>
  <para style="p">
    <verse number="11" style="v"/>tataste taṁ gṛhītvā tena kṣetrapatinā sākaṁ vāgyuddhaṁ kurvvantaḥ kathayāmāsuḥ,</para>
  <para style="p">
    <verse number="12" style="v"/>vayaṁ kṛtsnaṁ dinaṁ tāpakleśau soḍhavantaḥ, kintu paścātāyā se janā daṇḍadvayamātraṁ pariśrāntavantaste'smābhiḥ samānāṁśāḥ kṛtāḥ|</para>
  <para style="p">
    <verse number="13" style="v"/>tataḥ sa teṣāmekaṁ pratyuvāca, he vatsa, mayā tvāṁ prati kopyanyāyo na kṛtaḥ kiṁ tvayā matsamakṣaṁ mudrācaturthāṁśo nāṅgīkṛtaḥ?</para>
  <para style="p">
    <verse number="14" style="v"/>tasmāt tava yat prāpyaṁ tadādāya yāhi, tubhyaṁ yati, paścātīyaniyuktalokāyāpi tati dātumicchāmi|</para>
  <para style="p">
    <verse number="15" style="v"/>svecchayā nijadravyavyavaharaṇaṁ kiṁ mayā na karttavyaṁ? mama dātṛtvāt tvayā kim īrṣyādṛṣṭiḥ kriyate?</para>
  <para style="p">
    <verse number="16" style="v"/>ittham agrīyalokāḥ paścatīyā bhaviṣyanti, paścātīyajanāścagrīyā bhaviṣyanti, ahūtā bahavaḥ kintvalpe manobhilaṣitāḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>tadanantaraṁ yīśu ryirūśālamnagaraṁ gacchan mārgamadhye śiṣyān ekānte vabhāṣe,</para>
  <para style="p">
    <verse number="18" style="v"/>paśya vayaṁ yirūśālamnagaraṁ yāmaḥ, tatra pradhānayājakādhyāpakānāṁ kareṣu manuṣyaputraḥ samarpiṣyate;</para>
  <para style="p">
    <verse number="19" style="v"/>te ca taṁ hantumājñāpya tiraskṛtya vetreṇa praharttuṁ kruśe dhātayituñcānyadeśīyānāṁ kareṣu samarpayiṣyanti, kintu sa tṛtīyadivase śmaśānād utthāpiṣyate|</para>
  <para style="p">
    <verse number="20" style="v"/>tadānīṁ sivadīyasya nārī svaputrāvādāya yīśoḥ samīpam etya praṇamya kañcanānugrahaṁ taṁ yayāce|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā yīśustāṁ proktavān, tvaṁ kiṁ yācase? tataḥ sā babhāṣe, bhavato rājatve mamānayoḥ sutayorekaṁ bhavaddakṣiṇapārśve dvitīyaṁ vāmapārśva upaveṣṭum ājñāpayatu|</para>
  <para style="p">
    <verse number="22" style="v"/>yīśuḥ pratyuvāca, yuvābhyāṁ yad yācyate, tanna budhyate, ahaṁ yena kaṁsena pāsyāmi yuvābhyāṁ kiṁ tena pātuṁ śakyate? ahañca yena majjenena majjiṣye, yuvābhyāṁ kiṁ tena majjayituṁ śakyate? te jagaduḥ śakyate|</para>
  <para style="p">
    <verse number="23" style="v"/>tadā sa uktavān, yuvāṁ mama kaṁsenāvaśyaṁ pāsyathaḥ, mama majjanena ca yuvāmapi majjiṣyethe, kintu yeṣāṁ kṛte mattātena nirūpitam idaṁ tān vihāyānyaṁ kamapi maddakṣiṇapārśve vāmapārśve ca samupaveśayituṁ mamādhikāro nāsti|</para>
  <para style="p">
    <verse number="24" style="v"/>etāṁ kathāṁ śrutvānye daśaśiṣyāstau bhrātarau prati cukupuḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>kintu yīśuḥ svasamīpaṁ tānāhūya jagāda, anyadeśīyalokānāṁ narapatayastān adhikurvvanti, ye tu mahāntaste tān śāsati, iti yūyaṁ jānītha|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu yuṣmākaṁ madhye na tathā bhavet, yuṣmākaṁ yaḥ kaścit mahān bubhūṣati, sa yuṣmān seveta;</para>
  <para style="p">
    <verse number="27" style="v"/>yaśca yuṣmākaṁ madhye mukhyo bubhūṣati, sa yuṣmākaṁ dāso bhavet|</para>
  <para style="p">
    <verse number="28" style="v"/>itthaṁ manujaputraḥ sevyo bhavituṁ nahi, kintu sevituṁ bahūnāṁ paritrāṇamūlyārthaṁ svaprāṇān dātuñcāgataḥ|</para>
  <para style="p">
    <verse number="29" style="v"/>anantaraṁ yirīhonagarāt teṣāṁ bahirgamanasamaye tasya paścād bahavo lokā vavrajuḥ|</para>
  <para style="p">
    <verse number="30" style="v"/>aparaṁ vartmapārśva upaviśantau dvāvandhau tena mārgeṇa yīśo rgamanaṁ niśamya proccaiḥ kathayāmāsatuḥ, he prabho dāyūdaḥ santāna, āvayo rdayāṁ vidhehi|</para>
  <para style="p">
    <verse number="31" style="v"/>tato lokāḥ sarvve tuṣṇīmbhavatamityuktvā tau tarjayāmāsuḥ; tathāpi tau punaruccaiḥ kathayāmāsatuḥ he prabho dāyūdaḥ santāna, āvāṁ dayasva|</para>
  <para style="p">
    <verse number="32" style="v"/>tadānīṁ yīśuḥ sthagitaḥ san tāvāhūya bhāṣitavān, yuvayoḥ kṛte mayā kiṁ karttarvyaṁ? yuvāṁ kiṁ kāmayethe?</para>
  <para style="p">
    <verse number="33" style="v"/>tadā tāvuktavantau, prabho netrāṇi nau prasannāni bhaveyuḥ|</para>
  <para style="p">
    <verse number="34" style="v"/>tadānīṁ yīśustau prati pramannaḥ san tayo rnetrāṇi pasparśa, tenaiva tau suvīkṣāñcakrāte tatpaścāt jagmutuśca|</para>
  <chapter number="21" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ teṣu yirūśālamnagarasya samīpaverttino jaitunanāmakadharādharasya samīpasthtiṁ baitphagigrāmam āgateṣu, yīśuḥ śiṣyadvayaṁ preṣayan jagāda,</para>
  <para style="p">
    <verse number="2" style="v"/>yuvāṁ sammukhasthagrāmaṁ gatvā baddhāṁ yāṁ savatsāṁ garddabhīṁ haṭhāt prāpsyathaḥ, tāṁ mocayitvā madantikam ānayataṁ|</para>
  <para style="p">
    <verse number="3" style="v"/>tatra yadi kaścit kiñcid vakṣyati, tarhi vadiṣyathaḥ, etasyāṁ prabhoḥ prayojanamāste, tena sa tatkṣaṇāt praheṣyati|</para>
  <para style="p">
    <verse number="4" style="v"/>sīyonaḥ kanyakāṁ yūyaṁ bhāṣadhvamiti bhāratīṁ| paśya te namraśīlaḥ san nṛpa āruhya gardabhīṁ| arthādāruhya tadvatsamāyāsyati tvadantikaṁ|</para>
  <para style="p">
    <verse number="5" style="v"/>bhaviṣyadvādinoktaṁ vacanamidaṁ tadā saphalamabhūt|</para>
  <para style="p">
    <verse number="6" style="v"/>anantaraṁ tau śṣyiौ yīśo ryathānideśaṁ taṁ grāmaṁ gatvā</para>
  <para style="p">
    <verse number="7" style="v"/>gardabhīṁ tadvatsañca samānītavantau, paścāt tadupari svīyavasanānī pātayitvā tamārohayāmāsatuḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>tato bahavo lokā nijavasanāni pathi prasārayitumārebhire, katipayā janāśca pādapaparṇādikaṁ chitvā pathi vistārayāmāsuḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>agragāminaḥ paścādgāminaśca manujā uccairjaya jaya dāyūdaḥ santāneti jagaduḥ parameśvarasya nāmnā ya āyāti sa dhanyaḥ, sarvvoparisthasvargepi jayati|</para>
  <para style="p">
    <verse number="10" style="v"/>itthaṁ tasmin yirūśālamaṁ praviṣṭe ko'yamiti kathanāt kṛtsnaṁ nagaraṁ cañcalamabhavat|</para>
  <para style="p">
    <verse number="11" style="v"/>tatra lokoḥ kathayāmāsuḥ, eṣa gālīlpradeśīya-nāsaratīya-bhaviṣyadvādī yīśuḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>anantaraṁ yīśurīśvarasya mandiraṁ praviśya tanmadhyāt krayavikrayiṇo vahiścakāra; vaṇijāṁ mudrāsanānī kapotavikrayiṇāñcasanānī ca nyuvjayāmāsa|</para>
  <para style="p">
    <verse number="13" style="v"/>aparaṁ tānuvāca, eṣā lipirāste, "mama gṛhaṁ prārthanāgṛhamiti vikhyāsyati", kintu yūyaṁ tad dasyūnāṁ gahvaraṁ kṛtavantaḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>tadanantaram andhakhañcalokāstasya samīpamāgatāḥ, sa tān nirāmayān kṛtavān|</para>
  <para style="p">
    <verse number="15" style="v"/>yadā pradhānayājakā adhyāpakāśca tena kṛtānyetāni citrakarmmāṇi dadṛśuḥ, jaya jaya dāyūdaḥ santāna, mandire bālakānām etādṛśam uccadhvaniṁ śuśruvuśca, tadā mahākruddhā babhūvaḥ,</para>
  <para style="p">
    <verse number="16" style="v"/>taṁ papracchuśca, ime yad vadanti, tat kiṁ tvaṁ śṛṇoṣi? tato yīśustān avocat, satyam; stanyapāyiśiśūnāñca bālakānāñca vaktrataḥ| svakīyaṁ mahimānaṁ tvaṁ saṁprakāśayasi svayaṁ| etadvākyaṁ yūyaṁ kiṁ nāpaṭhata?</para>
  <para style="p">
    <verse number="17" style="v"/>tatastān vihāya sa nagarād baithaniyāgrāmaṁ gatvā tatra rajanīṁ yāpayāmāsa|</para>
  <para style="p">
    <verse number="18" style="v"/>anantaraṁ prabhāte sati yīśuḥ punarapi nagaramāgacchan kṣudhārtto babhūva|</para>
  <para style="p">
    <verse number="19" style="v"/>tato mārgapārśva uḍumbaravṛkṣamekaṁ vilokya tatsamīpaṁ gatvā patrāṇi vinā kimapi na prāpya taṁ pādapaṁ provāca, adyārabhya kadāpi tvayi phalaṁ na bhavatu; tena tatkṣaṇāt sa uḍumbaramāhīruhaḥ śuṣkatāṁ gataḥ|</para>
  <para style="p">
    <verse number="20" style="v"/>tad dṛṣṭvā śiṣyā āścaryyaṁ vijñāya kathayāmāsuḥ, āḥ, uḍumvarapādapo'titūrṇaṁ śuṣko'bhavat|</para>
  <para style="p">
    <verse number="21" style="v"/>tato yīśustānuvāca, yuṣmānahaṁ satyaṁ vadāmi, yadi yūyamasandigdhāḥ pratītha, tarhi yūyamapi kevaloḍumvarapādapaṁ pratītthaṁ karttuṁ śakṣyatha, tanna, tvaṁ calitvā sāgare pateti vākyaṁ yuṣmābhirasmina śaile proktepi tadaiva tad ghaṭiṣyate|</para>
  <para style="p">
    <verse number="22" style="v"/>tathā viśvasya prārthya yuṣmābhi ryad yāciṣyate, tadeva prāpsyate|</para>
  <para style="p">
    <verse number="23" style="v"/>anantaraṁ mandiraṁ praviśyopadeśanasamaye tatsamīpaṁ pradhānayājakāḥ prācīnalokāścāgatya papracchuḥ, tvayā kena sāmarthyanaitāni karmmāṇi kriyante? kena vā tubhyametāni sāmarthyāni dattāni?</para>
  <para style="p">
    <verse number="24" style="v"/>tato yīśuḥ pratyavadat, ahamapi yuṣmān vācamekāṁ pṛcchāmi, yadi yūyaṁ taduttaraṁ dātuṁ śakṣyatha, tadā kena sāmarthyena karmmāṇyetāni karomi, tadahaṁ yuṣmān vakṣyāmi|</para>
  <para style="p">
    <verse number="25" style="v"/>yohano majjanaṁ kasyājñayābhavat? kimīśvarasya manuṣyasya vā? tataste parasparaṁ vivicya kathayāmāsuḥ, yadīśvarasyeti vadāmastarhi yūyaṁ taṁ kuto na pratyaita? vācametāṁ vakṣyati|</para>
  <para style="p">
    <verse number="26" style="v"/>manuṣyasyeti vaktumapi lokebhyo bibhīmaḥ, yataḥ sarvvairapi yohan bhaviṣyadvādīti jñāyate|</para>
  <para style="p">
    <verse number="27" style="v"/>tasmāt te yīśuṁ pratyavadan, tad vayaṁ na vidmaḥ| tadā sa tānuktavān, tarhi kena sāmarathyena karmmāṇyetānyahaṁ karomi, tadapyahaṁ yuṣmān na vakṣyāmi|</para>
  <para style="p">
    <verse number="28" style="v"/>kasyacijjanasya dvau sutāvāstāṁ sa ekasya sutasya samīpaṁ gatvā jagāda, he suta, tvamadya mama drākṣākṣetre karmma kartuṁ vraja|</para>
  <para style="p">
    <verse number="29" style="v"/>tataḥ sa uktavān, na yāsyāmi, kintu śeṣe'nutapya jagāma|</para>
  <para style="p">
    <verse number="30" style="v"/>anantaraṁ sonyasutasya samīpaṁ gatvā tathaiva kathtivān; tataḥ sa pratyuvāca, maheccha yāmi, kintu na gataḥ|</para>
  <para style="p">
    <verse number="31" style="v"/>etayoḥ putrayo rmadhye piturabhimataṁ kena pālitaṁ? yuṣmābhiḥ kiṁ budhyate? tataste pratyūcuḥ, prathamena puुtreṇa| tadānīṁ yīśustānuvāca, ahaṁ yuṣmān tathyaṁ vadāmi, caṇḍālā gaṇikāśca yuṣmākamagrata īśvarasya rājyaṁ praviśanti|</para>
  <para style="p">
    <verse number="32" style="v"/>yato yuṣmākaṁ samīpaṁ yohani dharmmapathenāgate yūyaṁ taṁ na pratītha, kintu caṇḍālā gaṇikāśca taṁ pratyāyan, tad vilokyāpi yūyaṁ pratyetuṁ nākhidyadhvaṁ|</para>
  <para style="p">
    <verse number="33" style="v"/>aparamekaṁ dṛṣṭāntaṁ śṛṇuta, kaścid gṛhasthaḥ kṣetre drākṣālatā ropayitvā taccaturdikṣu vāraṇīṁ vidhāya tanmadhye drākṣāyantraṁ sthāpitavān, māñcañca nirmmitavān, tataḥ kṛṣakeṣu tat kṣetraṁ samarpya svayaṁ dūradeśaṁ jagāma|</para>
  <para style="p">
    <verse number="34" style="v"/>tadanantaraṁ phalasamaya upasthite sa phalāni prāptuṁ kṛṣīvalānāṁ samīpaṁ nijadāsān preṣayāmāsa|</para>
  <para style="p">
    <verse number="35" style="v"/>kintu kṛṣīvalāstasya tān dāseyān dhṛtvā kañcana prahṛtavantaḥ, kañcana pāṣāṇairāhatavantaḥ, kañcana ca hatavantaḥ|</para>
  <para style="p">
    <verse number="36" style="v"/>punarapi sa prabhuḥ prathamato'dhikadāseyān preṣayāmāsa, kintu te tān pratyapi tathaiva cakruḥ|</para>
  <para style="p">
    <verse number="37" style="v"/>anantaraṁ mama sute gate taṁ samādariṣyante, ityuktvā śeṣe sa nijasutaṁ teṣāṁ sannidhiṁ preṣayāmāsa|</para>
  <para style="p">
    <verse number="38" style="v"/>kintu te kṛṣīvalāḥ sutaṁ vīkṣya parasparam iti mantrayitum ārebhire, ayamuttarādhikārī vayamenaṁ nihatyāsyādhikāraṁ svavaśīkariṣyāmaḥ|</para>
  <para style="p">
    <verse number="39" style="v"/>paścāt te taṁ dhṛtvā drākṣākṣetrād bahiḥ pātayitvābadhiṣuḥ|</para>
  <para style="p">
    <verse number="40" style="v"/>yadā sa drākṣākṣetrapatirāgamiṣyati, tadā tān kṛṣīvalān kiṁ kariṣyati?</para>
  <para style="p">
    <verse number="41" style="v"/>tataste pratyavadan, tān kaluṣiṇo dāruṇayātanābhirāhaniṣyati, ye ca samayānukramāt phalāni dāsyanti, tādṛśeṣu kṛṣīvaleṣu kṣetraṁ samarpayiṣyati|</para>
  <para style="p">
    <verse number="42" style="v"/>tadā yīśunā te gaditāḥ, grahaṇaṁ na kṛtaṁ yasya pāṣāṇasya nicāyakaiḥ| pradhānaprastaraḥ koṇe saeva saṁbhaviṣyati| etat pareśituḥ karmmāsmadṛṣṭāvadbhutaṁ bhavet| dharmmagranthe likhitametadvacanaṁ yuṣmābhiḥ kiṁ nāpāṭhi?</para>
  <para style="p">
    <verse number="43" style="v"/>tasmādahaṁ yuṣmān vadāmi, yuṣmatta īśvarīyarājyamapanīya phalotpādayitranyajātaye dāyiṣyate|</para>
  <para style="p">
    <verse number="44" style="v"/>yo jana etatpāṣāṇopari patiṣyati, taṁ sa bhaṁkṣyate, kintvayaṁ pāṣāṇo yasyopari patiṣyati, taṁ sa dhūlivat cūrṇīkariṣyati|</para>
  <para style="p">
    <verse number="45" style="v"/>tadānīṁ prādhanayājakāḥ phirūśinaśca tasyemāṁ dṛṣṭāntakathāṁ śrutvā so'smānuddiśya kathitavān, iti vijñāya taṁ dharttuṁ ceṣṭitavantaḥ;</para>
  <para style="p">
    <verse number="46" style="v"/>kintu lokebhyo bibhyuḥ, yato lokaiḥ sa bhaviṣyadvādītyajñāyi|</para>
  <chapter number="22" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ yīśuḥ punarapi dṛṣṭāntena tān avādīt,</para>
  <para style="p">
    <verse number="2" style="v"/>svargīyarājyam etādṛśasya nṛpateḥ samaṁ, yo nija putraṁ vivāhayan sarvvān nimantritān ānetuṁ dāseyān prahitavān,</para>
  <para style="p">
    <verse number="3" style="v"/>kintu te samāgantuṁ neṣṭavantaḥ|</para>
  <para style="p">
    <verse number="4" style="v"/>tato rājā punarapi dāsānanyān ityuktvā preṣayāmāsa, nimantritān vadata, paśyata, mama bhejyamāsāditamāste, nijavṭaṣādipuṣṭajantūn mārayitvā sarvvaṁ khādyadravyamāsāditavān, yūyaṁ vivāhamāgacchata|</para>
  <para style="p">
    <verse number="5" style="v"/>tathapi te tucchīkṛtya kecit nijakṣetraṁ kecid vāṇijyaṁ prati svasvamārgeṇa calitavantaḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>anye lokāstasya dāseyān dhṛtvā daurātmyaṁ vyavahṛtya tānavadhiṣuḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>anantaraṁ sa nṛpatistāṁ vārttāṁ śrutvā krudhyan sainyāni prahitya tān ghātakān hatvā teṣāṁ nagaraṁ dāhayāmāsa|</para>
  <para style="p">
    <verse number="8" style="v"/>tataḥ sa nijadāseyān babhāṣe, vivāhīyaṁ bhojyamāsāditamāste, kintu nimantritā janā ayogyāḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>tasmād yūyaṁ rājamārgaṁ gatvā yāvato manujān paśyata, tāvataeva vivāhīyabhojyāya nimantrayata|</para>
  <para style="p">
    <verse number="10" style="v"/>tadā te dāseyā rājamārgaṁ gatvā bhadrān abhadrān vā yāvato janān dadṛśuḥ, tāvataeva saṁgṛhyānayan; tato'bhyāgatamanujai rvivāhagṛham apūryyata|</para>
  <para style="p">
    <verse number="11" style="v"/>tadānīṁ sa rājā sarvvānabhyāgatān draṣṭum abhyantaramāgatavān; tadā tatra vivāhīyavasanahīnamekaṁ janaṁ vīkṣya taṁ jagād,</para>
  <para style="p">
    <verse number="12" style="v"/>he mitra,tvaṁ vivāhīyavasanaṁ vinā kathamatra praviṣṭavān? tena sa niruttaro babhūva|</para>
  <para style="p">
    <verse number="13" style="v"/>tadā rājā nijānucarān avadat, etasya karacaraṇān baddhā yatra rodanaṁ dantairdantagharṣaṇañca bhavati, tatra vahirbhūtatamisre taṁ nikṣipata|</para>
  <para style="p">
    <verse number="14" style="v"/>itthaṁ bahava āhūtā alpe manobhimatāḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>anantaraṁ phirūśinaḥ pragatya yathā saṁlāpena tam unmāthe pātayeyustathā mantrayitvā</para>
  <para style="p">
    <verse number="16" style="v"/>herodīyamanujaiḥ sākaṁ nijaśiṣyagaṇena taṁ prati kathayāmāsuḥ, he guro, bhavān satyaḥ satyamīśvarīyamārgamupadiśati, kamapi mānuṣaṁ nānurudhyate, kamapi nāpekṣate ca, tad vayaṁ jānīmaḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>ataḥ kaisarabhūpāya karo'smākaṁ dātavyo na vā? atra bhavatā kiṁ budhyate? tad asmān vadatu|</para>
  <para style="p">
    <verse number="18" style="v"/>tato yīśusteṣāṁ khalatāṁ vijñāya kathitavān, re kapaṭinaḥ yuyaṁ kuto māṁ parikṣadhve?</para>
  <para style="p">
    <verse number="19" style="v"/>tatkaradānasya mudrāṁ māṁ darśayata| tadānīṁ taistasya samīpaṁ mudrācaturthabhāga ānīte</para>
  <para style="p">
    <verse number="20" style="v"/>sa tān papraccha, atra kasyeyaṁ mūrtti rnāma cāste? te jagaduḥ, kaisarabhūpasya|</para>
  <para style="p">
    <verse number="21" style="v"/>tataḥ sa uktavāna, kaisarasya yat tat kaisarāya datta, īśvarasya yat tad īśvarāya datta|</para>
  <para style="p">
    <verse number="22" style="v"/>iti vākyaṁ niśamya te vismayaṁ vijñāya taṁ vihāya calitavantaḥ|</para>
  <para style="p">
    <verse number="23" style="v"/>tasminnahani sidūkino'rthāt śmaśānāt notthāsyantīti vākyaṁ ye vadanti, te yīśeाrantikam āgatya papracchuḥ,</para>
  <para style="p">
    <verse number="24" style="v"/>he guro, kaścinmanujaścet niḥsantānaḥ san prāṇān tyajati, tarhi tasya bhrātā tasya jāyāṁ vyuhya bhrātuḥ santānam utpādayiṣyatīti mūsā ādiṣṭavān|</para>
  <para style="p">
    <verse number="25" style="v"/>kintvasmākamatra ke'pi janāḥ saptasahodarā āsan, teṣāṁ jyeṣṭha ekāṁ kanyāṁ vyavahāt, aparaṁ prāṇatyāgakāle svayaṁ niḥsantānaḥ san tāṁ striyaṁ svabhrātari samarpitavān,</para>
  <para style="p">
    <verse number="26" style="v"/>tato dvitīyādisaptamāntāśca tathaiva cakruḥ|</para>
  <para style="p">
    <verse number="27" style="v"/>śeṣe sāpī nārī mamāra|</para>
  <para style="p">
    <verse number="28" style="v"/>mṛtānām utthānasamaye teṣāṁ saptānāṁ madhye sā nārī kasya bhāryyā bhaviṣyati? yasmāt sarvvaeva tāṁ vyavahan|</para>
  <para style="p">
    <verse number="29" style="v"/>tato yīśuḥ pratyavādīt, yūyaṁ dharmmapustakam īśvarīyāṁ śaktiñca na vijñāya bhrāntimantaḥ|</para>
  <para style="p">
    <verse number="30" style="v"/>utthānaprāptā lokā na vivahanti, na ca vācā dīyante, kintvīśvarasya svargasthadūtānāṁ sadṛśā bhavanti|</para>
  <para style="p">
    <verse number="31" style="v"/>aparaṁ mṛtānāmutthānamadhi yuṣmān pratīyamīśvaroktiḥ,</para>
  <para style="p">
    <verse number="32" style="v"/>"ahamibrāhīma īśvara ishāka īśvaro yākūba īśvara" iti kiṁ yuṣmābhi rnāpāṭhi? kintvīśvaro jīvatām īśvara:, sa mṛtānāmīśvaro nahi|</para>
  <para style="p">
    <verse number="33" style="v"/>iti śrutvā sarvve lokāstasyopadeśād vismayaṁ gatāḥ|</para>
  <para style="p">
    <verse number="34" style="v"/>anantaraṁ sidūkinām niruttaratvavārtāṁ niśamya phirūśina ekatra militavantaḥ,</para>
  <para style="p">
    <verse number="35" style="v"/>teṣāmeko vyavasthāpako yīśuṁ parīkṣituṁ papaccha,</para>
  <para style="p">
    <verse number="36" style="v"/>he guro vyavasthāśāstramadhye kājñā śreṣṭhā?</para>
  <para style="p">
    <verse number="37" style="v"/>tato yīśuruvāca, tvaṁ sarvvāntaḥkaraṇaiḥ sarvvaprāṇaiḥ sarvvacittaiśca sākaṁ prabhau parameśvare prīyasva,</para>
  <para style="p">
    <verse number="38" style="v"/>eṣā prathamamahājñā| tasyāḥ sadṛśī dvitīyājñaiṣā,</para>
  <para style="p">
    <verse number="39" style="v"/>tava samīpavāsini svātmanīva prema kuru|</para>
  <para style="p">
    <verse number="40" style="v"/>anayo rdvayorājñayoḥ kṛtsnavyavasthāyā bhaviṣyadvaktṛgranthasya ca bhārastiṣṭhati|</para>
  <para style="p">
    <verse number="41" style="v"/>anantaraṁ phirūśinām ekatra sthitikāle yīśustān papraccha,</para>
  <para style="p">
    <verse number="42" style="v"/>khrīṣṭamadhi yuṣmākaṁ kīdṛgbodho jāyate? sa kasya santānaḥ? tataste pratyavadan, dāyūdaḥ santānaḥ|</para>
  <para style="p">
    <verse number="43" style="v"/>tadā sa uktavān, tarhi dāyūd katham ātmādhiṣṭhānena taṁ prabhuṁ vadati ?</para>
  <para style="p">
    <verse number="44" style="v"/>yathā mama prabhumidaṁ vākyamavadat parameśvaraḥ| tavārīn pādapīṭhaṁ te yāvannahi karomyahaṁ| tāvat kālaṁ madīye tvaṁ dakṣapārśva upāviśa| ato yadi dāyūd taṁ prabhuṁ vadati, rtiha sa kathaṁ tasya santāno bhavati?</para>
  <para style="p">
    <verse number="45" style="v"/>tadānīṁ teṣāṁ kopi tadvākyasya kimapyuttaraṁ dātuṁ nāśaknot;</para>
  <para style="p">
    <verse number="46" style="v"/>taddinamārabhya taṁ kimapi vākyaṁ praṣṭuṁ kasyāpi sāhaso nābhavat|</para>
  <chapter number="23" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ yīśu rjananivahaṁ śiṣyāṁścāvadat,</para>
  <para style="p">
    <verse number="2" style="v"/>adhyāpakāḥ phirūśinaśca mūsāsane upaviśanti,</para>
  <para style="p">
    <verse number="3" style="v"/>ataste yuṣmān yadyat mantum ājñāpayanti, tat manyadhvaṁ pālayadhvañca, kintu teṣāṁ karmmānurūpaṁ karmma na kurudhvaṁ; yatasteṣāṁ vākyamātraṁ sāraṁ kāryye kimapi nāsti|</para>
  <para style="p">
    <verse number="4" style="v"/>te durvvahān gurutarān bhārān badvvā manuṣyāṇāṁ skandhepari samarpayanti, kintu svayamaṅgulyaikayāpi na cālayanti|</para>
  <para style="p">
    <verse number="5" style="v"/>kevalaṁ lokadarśanāya sarvvakarmmāṇi kurvvanti; phalataḥ paṭṭabandhān prasāryya dhārayanti, svavastreṣu ca dīrghagranthīn dhārayanti;</para>
  <para style="p">
    <verse number="6" style="v"/>bhojanabhavana uccasthānaṁ, bhajanabhavane pradhānamāsanaṁ,</para>
  <para style="p">
    <verse number="7" style="v"/>haṭṭhe namaskāraṁ gururiti sambodhanañcaitāni sarvvāṇi vāñchanti|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu yūyaṁ gurava iti sambodhanīyā mā bhavata, yato yuṣmākam ekaḥ khrīṣṭaeva guru</para>
  <para style="p">
    <verse number="9" style="v"/>ryūyaṁ sarvve mitho bhrātaraśca| punaḥ pṛthivyāṁ kamapi piteti mā sambudhyadhvaṁ, yato yuṣmākamekaḥ svargasthaeva pitā|</para>
  <para style="p">
    <verse number="10" style="v"/>yūyaṁ nāyaketi sambhāṣitā mā bhavata, yato yuṣmākamekaḥ khrīṣṭaeva nāyakaḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaṁ yuṣmākaṁ madhye yaḥ pumān śreṣṭhaḥ sa yuṣmān seviṣyate|</para>
  <para style="p">
    <verse number="12" style="v"/>yato yaḥ svamunnamati, sa nataḥ kariṣyate; kintu yaḥ kaścit svamavanataṁ karoti, sa unnataḥ kariṣyate|</para>
  <para style="p">
    <verse number="13" style="v"/>hanta kapaṭina upādhyāyāḥ phirūśinaśca, yūyaṁ manujānāṁ samakṣaṁ svargadvāraṁ rundha, yūyaṁ svayaṁ tena na praviśatha, pravivikṣūnapi vārayatha| vata kapaṭina upādhyāyāḥ phirūśinaśca yūyaṁ chalād dīrghaṁ prārthya vidhavānāṁ sarvvasvaṁ grasatha, yuṣmākaṁ ghorataradaṇḍo bhaviṣyati|</para>
  <para style="p">
    <verse number="14" style="v"/>hanta kapaṭina upādhyāyāḥ phirūśinaśca, yūyamekaṁ svadharmmāvalambinaṁ karttuṁ sāgaraṁ bhūmaṇḍalañca pradakṣiṇīkurutha,</para>
  <para style="p">
    <verse number="15" style="v"/>kañcana prāpya svato dviguṇanarakabhājanaṁ taṁ kurutha|</para>
  <para style="p">
    <verse number="16" style="v"/>vata andhapathadarśakāḥ sarvve, yūyaṁ vadatha, mandirasya śapathakaraṇāt kimapi na deyaṁ; kintu mandirasthasuvarṇasya śapathakaraṇād deyaṁ|</para>
  <para style="p">
    <verse number="17" style="v"/>he mūḍhā he andhāḥ suvarṇaṁ tatsuvarṇapāvakamandiram etayorubhayo rmadhye kiṁ śreyaḥ?</para>
  <para style="p">
    <verse number="18" style="v"/>anyacca vadatha, yajñavedyāḥ śapathakaraṇāt kimapi na deyaṁ, kintu taduparisthitasya naivedyasya śapathakaraṇād deyaṁ|</para>
  <para style="p">
    <verse number="19" style="v"/>he mūḍhā he andhāḥ, naivedyaṁ tannaivedyapāvakavediretayorubhayo rmadhye kiṁ śreyaḥ?</para>
  <para style="p">
    <verse number="20" style="v"/>ataḥ kenacid yajñavedyāḥ śapathe kṛte taduparisthasya sarvvasya śapathaḥ kriyate|</para>
  <para style="p">
    <verse number="21" style="v"/>kenacit mandirasya śapathe kṛte mandiratannivāsinoḥ śapathaḥ kriyate|</para>
  <para style="p">
    <verse number="22" style="v"/>kenacit svargasya śapathe kṛte īśvarīyasiṁhāsanataduparyyupaviṣṭayoḥ śapathaḥ kriyate|</para>
  <para style="p">
    <verse number="23" style="v"/>hanta kapaṭina upādhyāyāḥ phirūśinaśca, yūyaṁ podināyāḥ sitacchatrāyā jīrakasya ca daśamāṁśān dattha, kintu vyavasthāyā gurutarān nyāyadayāviśvāsān parityajatha; ime yuṣmābhirācaraṇīyā amī ca na laṁghanīyāḥ|</para>
  <para style="p">
    <verse number="24" style="v"/>he andhapathadarśakā yūyaṁ maśakān apasārayatha, kintu mahāṅgān grasatha|</para>
  <para style="p">
    <verse number="25" style="v"/>hanta kapaṭina upādhyāyāḥ phirūśinaśca, yūyaṁ pānapātrāṇāṁ bhojanapātrāṇāñca bahiḥ pariṣkurutha; kintu tadabhyantaraṁ durātmatayā kaluṣeṇa ca paripūrṇamāste|</para>
  <para style="p">
    <verse number="26" style="v"/>he andhāḥ phirūśilokā ādau pānapātrāṇāṁ bhojanapātrāṇāñcābhyantaraṁ pariṣkuruta, tena teṣāṁ bahirapi pariṣkāriṣyate|</para>
  <para style="p">
    <verse number="27" style="v"/>hanta kapaṭina upādhyāyāḥ phirūśinaśca, yūyaṁ śuklīkṛtaśmaśānasvarūpā bhavatha, yathā śmaśānabhavanasya bahiścāru, kintvabhyantaraṁ mṛtalokānāṁ kīkaśaiḥ sarvvaprakāramalena ca paripūrṇam;</para>
  <para style="p">
    <verse number="28" style="v"/>tathaiva yūyamapi lokānāṁ samakṣaṁ bahirdhārmmikāḥ kintvantaḥkaraṇeṣu kevalakāpaṭyādharmmābhyāṁ paripūrṇāḥ|</para>
  <para style="p">
    <verse number="29" style="v"/>hā hā kapaṭina upādhyāyāḥ phirūśinaśca, yūyaṁ bhaviṣyadvādināṁ śmaśānagehaṁ nirmmātha, sādhūnāṁ śmaśānaniketanaṁ śobhayatha</para>
  <para style="p">
    <verse number="30" style="v"/>vadatha ca yadi vayaṁ sveṣāṁ pūrvvapuruṣāṇāṁ kāla asthāsyāma, tarhi bhaviṣyadvādināṁ śoṇitapātane teṣāṁ sahabhāgino nābhaviṣyāma|</para>
  <para style="p">
    <verse number="31" style="v"/>ato yūyaṁ bhaviṣyadvādighātakānāṁ santānā iti svayameva sveṣāṁ sākṣyaṁ dattha|</para>
  <para style="p">
    <verse number="32" style="v"/>ato yūyaṁ nijapūrvvapuruṣāṇāṁ parimāṇapātraṁ paripūrayata|</para>
  <para style="p">
    <verse number="33" style="v"/>re bhujagāḥ kṛṣṇabhujagavaṁśāḥ, yūyaṁ kathaṁ narakadaṇḍād rakṣiṣyadhve|</para>
  <para style="p">
    <verse number="34" style="v"/>paśyata, yuṣmākamantikam ahaṁ bhaviṣyadvādino buddhimata upādhyāyāṁśca preṣayiṣyāmi, kintu teṣāṁ katipayā yuṣmābhi rghāniṣyante, kruśe ca ghāniṣyante, kecid bhajanabhavane kaṣābhirāghāniṣyante, nagare nagare tāḍiṣyante ca;</para>
  <para style="p">
    <verse number="35" style="v"/>tena satpuruṣasya hābilo raktapātamārabhya berikhiyaḥ putraṁ yaṁ sikhariyaṁ yūyaṁ mandirayajñavedyo rmadhye hatavantaḥ, tadīyaśoṇitapātaṁ yāvad asmin deśe yāvatāṁ sādhupuruṣāṇāṁ śoṇitapāto 'bhavat tat sarvveṣāmāgasāṁ daṇḍā yuṣmāsu varttiṣyante|</para>
  <para style="p">
    <verse number="36" style="v"/>ahaṁ yuṣmānta tathyaṁ vadāmi, vidyamāne'smin puruṣe sarvve varttiṣyante|</para>
  <para style="p">
    <verse number="37" style="v"/>he yirūśālam he yirūśālam nagari tvaṁ bhaviṣyadvādino hatavatī, tava samīpaṁ preritāṁśca pāṣāṇairāhatavatī, yathā kukkuṭī śāvakān pakṣādhaḥ saṁgṛhlāti, tathā tava santānān saṁgrahītuṁ ahaṁ bahuvāram aicchaṁ; kintu tvaṁ na samamanyathāḥ|</para>
  <para style="p">
    <verse number="38" style="v"/>paśyata yaṣmākaṁ vāsasthānam ucchinnaṁ tyakṣyate|</para>
  <para style="p">
    <verse number="39" style="v"/>ahaṁ yuṣmān tathyaṁ vadāmi, yaḥ parameśvarasya nāmnāgacchati, sa dhanya iti vāṇīṁ yāvanna vadiṣyatha, tāvat māṁ puna rna drakṣyatha|</para>
  <chapter number="24" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ yīśu ryadā mandirād bahi rgacchati, tadānīṁ śiṣyāstaṁ mandiranirmmāṇaṁ darśayitumāgatāḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>tato yīśustānuvāca, yūyaṁ kimetāni na paśyatha? yuṣmānahaṁ satyaṁ vadāmi, etannicayanasya pāṣāṇaikamapyanyapāṣāṇeाpari na sthāsyati sarvvāṇi bhūmisāt kāriṣyante|</para>
  <para style="p">
    <verse number="3" style="v"/>anantaraṁ tasmin jaitunaparvvatopari samupaviṣṭe śiṣyāstasya samīpamāgatya guptaṁ papracchuḥ, etā ghaṭanāḥ kadā bhaviṣyanti? bhavata āgamanasya yugāntasya ca kiṁ lakṣma? tadasmān vadatu|</para>
  <para style="p">
    <verse number="4" style="v"/>tadānīṁ yīśustānavocat, avadhadvvaṁ, kopi yuṣmān na bhramayet|</para>
  <para style="p">
    <verse number="5" style="v"/>bahavo mama nāma gṛhlanta āgamiṣyanti, khrīṣṭo'hameveti vācaṁ vadanto bahūn bhramayiṣyanti|</para>
  <para style="p">
    <verse number="6" style="v"/>yūyañca saṁgrāmasya raṇasya cāḍambaraṁ śroṣyatha, avadhadvvaṁ tena cañcalā mā bhavata, etānyavaśyaṁ ghaṭiṣyante, kintu tadā yugānto nahi|</para>
  <para style="p">
    <verse number="7" style="v"/>aparaṁ deśasya vipakṣo deśo rājyasya vipakṣo rājyaṁ bhaviṣyati, sthāne sthāne ca durbhikṣaṁ mahāmārī bhūkampaśca bhaviṣyanti,</para>
  <para style="p">
    <verse number="8" style="v"/>etāni duḥkhopakramāḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>tadānīṁ lokā duḥkhaṁ bhojayituṁ yuṣmān parakareṣu samarpayiṣyanti haniṣyanti ca, tathā mama nāmakāraṇād yūyaṁ sarvvadeśīyamanujānāṁ samīpe ghṛṇārhā bhaviṣyatha|</para>
  <para style="p">
    <verse number="10" style="v"/>bahuṣu vighnaṁ prāptavatsu parasparam ṛृtīyāṁ kṛtavatsu ca eko'paraṁ parakareṣu samarpayiṣyati|</para>
  <para style="p">
    <verse number="11" style="v"/>tathā bahavo mṛṣābhaviṣyadvādina upasthāya bahūn bhramayiṣyanti|</para>
  <para style="p">
    <verse number="12" style="v"/>duṣkarmmaṇāṁ bāhulyāñca bahūnāṁ prema śītalaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="13" style="v"/>kintu yaḥ kaścit śeṣaṁ yāvad dhairyyamāśrayate, saeva paritrāyiṣyate|</para>
  <para style="p">
    <verse number="14" style="v"/>aparaṁ sarvvadeśīyalokān pratimākṣī bhavituṁ rājasya śubhasamācāraḥ sarvvajagati pracāriṣyate, etādṛśi sati yugānta upasthāsyati|</para>
  <para style="p">
    <verse number="15" style="v"/>ato yat sarvvanāśakṛdghṛṇārhaṁ vastu dāniyelbhaviṣyadvadinā proktaṁ tad yadā puṇyasthāne sthāpitaṁ drakṣyatha, (yaḥ paṭhati, sa budhyatāṁ)</para>
  <para style="p">
    <verse number="16" style="v"/>tadānīṁ ye yihūdīyadeśe tiṣṭhanti, te parvvateṣu palāyantāṁ|</para>
  <para style="p">
    <verse number="17" style="v"/>yaḥ kaścid gṛhapṛṣṭhe tiṣṭhati, sa gṛhāt kimapi vastvānetum adheा nāvarohet|</para>
  <para style="p">
    <verse number="18" style="v"/>yaśca kṣetre tiṣṭhati, sopi vastramānetuṁ parāvṛtya na yāyāt|</para>
  <para style="p">
    <verse number="19" style="v"/>tadānīṁ garbhiṇīstanyapāyayitrīṇāṁ durgati rbhaviṣyati|</para>
  <para style="p">
    <verse number="20" style="v"/>ato yaṣmākaṁ palāyanaṁ śītakāle viśrāmavāre vā yanna bhavet, tadarthaṁ prārthayadhvam|</para>
  <para style="p">
    <verse number="21" style="v"/>ā jagadārambhād etatkālaparyyanantaṁ yādṛśaḥ kadāpi nābhavat na ca bhaviṣyati tādṛśo mahākleśastadānīm upasthāsyati|</para>
  <para style="p">
    <verse number="22" style="v"/>tasya kleśasya samayo yadi hsvo na kriyeta, tarhi kasyāpi prāṇino rakṣaṇaṁ bhavituṁ na śaknuyāt, kintu manonītamanujānāṁ kṛte sa kālo hsvīkariṣyate|</para>
  <para style="p">
    <verse number="23" style="v"/>aparañca paśyata, khrīṣṭo'tra vidyate, vā tatra vidyate, tadānīṁ yadī kaścid yuṣmāna iti vākyaṁ vadati, tathāpi tat na pratīt|</para>
  <para style="p">
    <verse number="24" style="v"/>yato bhāktakhrīṣṭā bhāktabhaviṣyadvādinaśca upasthāya yāni mahanti lakṣmāṇi citrakarmmāṇi ca prakāśayiṣyanti, tai ryadi sambhavet tarhi manonītamānavā api bhrāmiṣyante|</para>
  <para style="p">
    <verse number="25" style="v"/>paśyata, ghaṭanātaḥ pūrvvaṁ yuṣmān vārttām avādiṣam|</para>
  <para style="p">
    <verse number="26" style="v"/>ataḥ paśyata, sa prāntare vidyata iti vākye kenacit kathitepi bahi rmā gacchata, vā paśyata, sontaḥpure vidyate, etadvākya uktepi mā pratīta|</para>
  <para style="p">
    <verse number="27" style="v"/>yato yathā vidyut pūrvvadiśo nirgatya paścimadiśaṁ yāvat prakāśate, tathā mānuṣaputrasyāpyāgamanaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="28" style="v"/>yatra śavastiṣṭhati, tatreva gṛdhrā milanti|</para>
  <para style="p">
    <verse number="29" style="v"/>aparaṁ tasya kleśasamayasyāvyavahitaparatra sūryyasya tejo lopsyate, candramā jyosnāṁ na kariṣyati, nabhaso nakṣatrāṇi patiṣyanti, gagaṇīyā grahāśca vicaliṣyanti|</para>
  <para style="p">
    <verse number="30" style="v"/>tadānīm ākāśamadhye manujasutasya lakṣma darśiṣyate, tato nijaparākrameṇa mahātejasā ca meghārūḍhaṁ manujasutaṁ nabhasāgacchantaṁ vilokya pṛthivyāḥ sarvvavaṁśīyā vilapiṣyanti|</para>
  <para style="p">
    <verse number="31" style="v"/>tadānīṁ sa mahāśabdāyamānatūryyā vādakān nijadūtān praheṣyati, te vyomna ekasīmāto'parasīmāṁ yāvat caturdiśastasya manonītajanān ānīya melayiṣyanti|</para>
  <para style="p">
    <verse number="32" style="v"/>uḍumbarapādapasya dṛṣṭāntaṁ śikṣadhvaṁ; yadā tasya navīnāḥ śākhā jāyante, pallavādiśca nirgacchati, tadā nidāghakālaḥ savidho bhavatīti yūyaṁ jānītha;</para>
  <para style="p">
    <verse number="33" style="v"/>tadvad etā ghaṭanā dṛṣṭvā sa samayo dvāra upāsthād iti jānīta|</para>
  <para style="p">
    <verse number="34" style="v"/>yuṣmānahaṁ tathyaṁ vadāmi, idānīntanajanānāṁ gamanāt pūrvvameva tāni sarvvāṇi ghaṭiṣyante|</para>
  <para style="p">
    <verse number="35" style="v"/>nabhomedinyo rluptayorapi mama vāk kadāpi na lopsyate|</para>
  <para style="p">
    <verse number="36" style="v"/>aparaṁ mama tātaṁ vinā mānuṣaḥ svargastho dūto vā kopi taddinaṁ taddaṇḍañca na jñāpayati|</para>
  <para style="p">
    <verse number="37" style="v"/>aparaṁ nohe vidyamāne yādṛśamabhavat tādṛśaṁ manujasutasyāgamanakālepi bhaviṣyati|</para>
  <para style="p">
    <verse number="38" style="v"/>phalato jalāplāvanāt pūrvvaṁ yaddinaṁ yāvat nohaḥ potaṁ nārohat, tāvatkālaṁ yathā manuṣyā bhojane pāne vivahane vivāhane ca pravṛttā āsan;</para>
  <para style="p">
    <verse number="39" style="v"/>aparam āplāvitoyamāgatya yāvat sakalamanujān plāvayitvā nānayat, tāvat te yathā na vidāmāsuḥ, tathā manujasutāgamanepi bhaviṣyati|</para>
  <para style="p">
    <verse number="40" style="v"/>tadā kṣetrasthitayordvayoreko dhāriṣyate, aparastyājiṣyate|</para>
  <para style="p">
    <verse number="41" style="v"/>tathā peṣaṇyā piṁṣatyorubhayo ryoṣitorekā dhāriṣyate'parā tyājiṣyate|</para>
  <para style="p">
    <verse number="42" style="v"/>yuṣmākaṁ prabhuḥ kasmin daṇḍa āgamiṣyati, tad yuṣmābhi rnāvagamyate, tasmāt jāgrataḥ santastiṣṭhata|</para>
  <para style="p">
    <verse number="43" style="v"/>kutra yāme stena āgamiṣyatīti ced gṛhastho jñātum aśakṣyat, tarhi jāgaritvā taṁ sandhiṁ karttitum avārayiṣyat tad jānīta|</para>
  <para style="p">
    <verse number="44" style="v"/>yuṣmābhiravadhīyatāṁ, yato yuṣmābhi ryatra na budhyate, tatraiva daṇḍe manujasuta āyāsyati|</para>
  <para style="p">
    <verse number="45" style="v"/>prabhu rnijaparivārān yathākālaṁ bhojayituṁ yaṁ dāsam adhyakṣīkṛtya sthāpayati, tādṛśo viśvāsyo dhīmān dāsaḥ kaḥ?</para>
  <para style="p">
    <verse number="46" style="v"/>prabhurāgatya yaṁ dāsaṁ tathācarantaṁ vīkṣate, saeva dhanyaḥ|</para>
  <para style="p">
    <verse number="47" style="v"/>yuṣmānahaṁ satyaṁ vadāmi, sa taṁ nijasarvvasvasyādhipaṁ kariṣyati|</para>
  <para style="p">
    <verse number="48" style="v"/>kintu prabhurāgantuṁ vilambata iti manasi cintayitvā yo duṣṭo dāso</para>
  <para style="p">
    <verse number="49" style="v"/>'paradāsān praharttuṁ mattānāṁ saṅge bhoktuṁ pātuñca pravarttate,</para>
  <para style="p">
    <verse number="50" style="v"/>sa dāso yadā nāpekṣate, yañca daṇḍaṁ na jānāti, tatkālaeva tatprabhurupasthāsyati|</para>
  <para style="p">
    <verse number="51" style="v"/>tadā taṁ daṇḍayitvā yatra sthāne rodanaṁ dantagharṣaṇañcāsāte, tatra kapaṭibhiḥ sākaṁ taddaśāṁ nirūpayiṣyati|</para>
  <chapter number="25" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yā daśa kanyāḥ pradīpān gṛhlatyo varaṁ sākṣāt karttuṁ bahiritāḥ, tābhistadā svargīyarājyasya sādṛśyaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="2" style="v"/>tāsāṁ kanyānāṁ madhye pañca sudhiyaḥ pañca durdhiya āsan|</para>
  <para style="p">
    <verse number="3" style="v"/>yā durdhiyastāḥ pradīpān saṅge gṛhītvā tailaṁ na jagṛhuḥ,</para>
  <para style="p">
    <verse number="4" style="v"/>kintu sudhiyaḥ pradīpān pātreṇa tailañca jagṛhuḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>anantaraṁ vare vilambite tāḥ sarvvā nidrāviṣṭā nidrāṁ jagmuḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>anantaram arddharātre paśyata vara āgacchati, taṁ sākṣāt karttuṁ bahiryāteti janaravāt</para>
  <para style="p">
    <verse number="7" style="v"/>tāḥ sarvvāḥ kanyā utthāya pradīpān āsādayituṁ ārabhanta|</para>
  <para style="p">
    <verse number="8" style="v"/>tato durdhiyaḥ sudhiya ūcuḥ, kiñcit tailaṁ datta, pradīpā asmākaṁ nirvvāṇāḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu sudhiyaḥ pratyavadan, datte yuṣmānasmāṁśca prati tailaṁ nyūnībhavet, tasmād vikretṛṇāṁ samīpaṁ gatvā svārthaṁ tailaṁ krīṇīta|</para>
  <para style="p">
    <verse number="10" style="v"/>tadā tāsu kretuṁ gatāsu vara ājagāma, tato yāḥ sajjitā āsan, tāstena sākaṁ vivāhīyaṁ veśma praviviśuḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>anantaraṁ dvāre ruddhe aparāḥ kanyā āgatya jagaduḥ, he prabho, he prabho, asmān prati dvāraṁ mocaya|</para>
  <para style="p">
    <verse number="12" style="v"/>kintu sa uktavān, tathyaṁ vadāmi, yuṣmānahaṁ na vedmi|</para>
  <para style="p">
    <verse number="13" style="v"/>ato jāgrataḥ santastiṣṭhata, manujasutaḥ kasmin dine kasmin daṇḍe vāgamiṣyati, tad yuṣmābhi rna jñāyate|</para>
  <para style="p">
    <verse number="14" style="v"/>aparaṁ sa etādṛśaḥ kasyacit puṁsastulyaḥ, yo dūradeśaṁ prati yātrākāle nijadāsān āhūya teṣāṁ svasvasāmarthyānurūpam</para>
  <para style="p">
    <verse number="15" style="v"/>ekasmin mudrāṇāṁ pañca poṭalikāḥ anyasmiṁśca dve poṭalike aparasmiṁśca poṭalikaikām itthaṁ pratijanaṁ samarpya svayaṁ pravāsaṁ gatavān|</para>
  <para style="p">
    <verse number="16" style="v"/>anantaraṁ yo dāsaḥ pañca poṭalikāḥ labdhavān, sa gatvā vāṇijyaṁ vidhāya tā dviguṇīcakāra|</para>
  <para style="p">
    <verse number="17" style="v"/>yaśca dāso dve poṭalike alabhata, sopi tā mudrā dviguṇīcakāra|</para>
  <para style="p">
    <verse number="18" style="v"/>kintu yo dāsa ekāṁ poṭalikāṁ labdhavān, sa gatvā bhūmiṁ khanitvā tanmadhye nijaprabhostā mudrā gopayāñcakāra|</para>
  <para style="p">
    <verse number="19" style="v"/>tadanantaraṁ bahutithe kāle gate teṣāṁ dāsānāṁ prabhurāgatya tairdāsaiḥ samaṁ gaṇayāñcakāra|</para>
  <para style="p">
    <verse number="20" style="v"/>tadānīṁ yaḥ pañca poṭalikāḥ prāptavān sa tā dviguṇīkṛtamudrā ānīya jagāda; he prabho, bhavatā mayi pañca poṭalikāḥ samarpitāḥ, paśyatu, tā mayā dviguṇīkṛtāḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>tadānīṁ tasya prabhustamuvāca, he uttama viśvāsya dāsa, tvaṁ dhanyosi, stokena viśvāsyo jātaḥ, tasmāt tvāṁ bahuvittādhipaṁ karomi, tvaṁ svaprabhoḥ sukhasya bhāgī bhava|</para>
  <para style="p">
    <verse number="22" style="v"/>tato yena dve poṭalike labdhe sopyāgatya jagāda, he prabho, bhavatā mayi dve poṭalike samarpite, paśyatu te mayā dviguṇīkṛte|</para>
  <para style="p">
    <verse number="23" style="v"/>tena tasya prabhustamavocat, he uttama viśvāsya dāsa, tvaṁ dhanyosi, stokena viśvāsyo jātaḥ, tasmāt tvāṁ bahudraviṇādhipaṁ karomi, tvaṁ nijaprabhoḥ sukhasya bhāgī bhava|</para>
  <para style="p">
    <verse number="24" style="v"/>anantaraṁ ya ekāṁ poṭalikāṁ labdhavān, sa etya kathitavān, he prabho, tvāṁ kaṭhinanaraṁ jñātavān, tvayā yatra noptaṁ, tatraiva kṛtyate, yatra ca na kīrṇaṁ, tatraiva saṁgṛhyate|</para>
  <para style="p">
    <verse number="25" style="v"/>atohaṁ saśaṅkaḥ san gatvā tava mudrā bhūmadhye saṁgopya sthāpitavān, paśya, tava yat tadeva gṛhāṇa|</para>
  <para style="p">
    <verse number="26" style="v"/>tadā tasya prabhuḥ pratyavadat re duṣṭālasa dāsa, yatrāhaṁ na vapāmi, tatra chinadmi, yatra ca na kirāmi, tatreva saṁgṛhlāmīti cedajānāstarhi</para>
  <para style="p">
    <verse number="27" style="v"/>vaṇikṣu mama vittārpaṇaṁ tavocitamāsīt, yenāhamāgatya vṛdvyā sākaṁ mūlamudrāḥ prāpsyam|</para>
  <para style="p">
    <verse number="28" style="v"/>atosmāt tāṁ poṭalikām ādāya yasya daśa poṭalikāḥ santi tasminnarpayata|</para>
  <para style="p">
    <verse number="29" style="v"/>yena vardvyate tasminnaivārpiṣyate, tasyaiva ca bāhulyaṁ bhaviṣyati, kintu yena na vardvyate, tasyāntike yat kiñcana tiṣṭhati, tadapi punarneṣyate|</para>
  <para style="p">
    <verse number="30" style="v"/>aparaṁ yūyaṁ tamakarmmaṇyaṁ dāsaṁ nītvā yatra sthāne krandanaṁ dantagharṣaṇañca vidyete, tasmin bahirbhūtatamasi nikṣipata|</para>
  <para style="p">
    <verse number="31" style="v"/>yadā manujasutaḥ pavitradūtān saṅginaḥ kṛtvā nijaprabhāvenāgatya nijatejomaye siṁhāsane nivekṣyati,</para>
  <para style="p">
    <verse number="32" style="v"/>tadā tatsammukhe sarvvajātīyā janā saṁmeliṣyanti| tato meṣapālako yathā chāgebhyo'vīn pṛthak karoti tathā sopyekasmādanyam itthaṁ tān pṛthaka kṛtvāvīn</para>
  <para style="p">
    <verse number="33" style="v"/>dakṣiṇe chāgāṁśca vāme sthāpayiṣyati|</para>
  <para style="p">
    <verse number="34" style="v"/>tataḥ paraṁ rājā dakṣiṇasthitān mānavān vadiṣyati, āgacchata mattātasyānugrahabhājanāni, yuṣmatkṛta ā jagadārambhat yad rājyam āsāditaṁ tadadhikuruta|</para>
  <para style="p">
    <verse number="35" style="v"/>yato bubhukṣitāya mahyaṁ bhojyam adatta, pipāsitāya peyamadatta, videśinaṁ māṁ svasthānamanayata,</para>
  <para style="p">
    <verse number="36" style="v"/>vastrahīnaṁ māṁ vasanaṁ paryyadhāpayata, pīḍītaṁ māṁ draṣṭumāgacchata, kārāsthañca māṁ vīkṣituma āgacchata|</para>
  <para style="p">
    <verse number="37" style="v"/>tadā dhārmmikāḥ prativadiṣyanti, he prabho, kadā tvāṁ kṣudhitaṁ vīkṣya vayamabhojayāma? vā pipāsitaṁ vīkṣya apāyayāma?</para>
  <para style="p">
    <verse number="38" style="v"/>kadā vā tvāṁ videśinaṁ vilokya svasthānamanayāma? kadā vā tvāṁ nagnaṁ vīkṣya vasanaṁ paryyadhāpayāma?</para>
  <para style="p">
    <verse number="39" style="v"/>kadā vā tvāṁ pīḍitaṁ kārāsthañca vīkṣya tvadantikamagacchāma?</para>
  <para style="p">
    <verse number="40" style="v"/>tadānīṁ rājā tān prativadiṣyati, yuṣmānahaṁ satyaṁ vadāmi, mamaiteṣāṁ bhrātṛṇāṁ madhye kañcanaikaṁ kṣudratamaṁ prati yad akuruta, tanmāṁ pratyakuruta|</para>
  <para style="p">
    <verse number="41" style="v"/>paścāt sa vāmasthitān janān vadiṣyati, re śāpagrastāḥ sarvve, śaitāne tasya dūtebhyaśca yo'nantavahnirāsādita āste, yūyaṁ madantikāt tamagniṁ gacchata|</para>
  <para style="p">
    <verse number="42" style="v"/>yato kṣudhitāya mahyamāhāraṁ nādatta, pipāsitāya mahyaṁ peyaṁ nādatta,</para>
  <para style="p">
    <verse number="43" style="v"/>videśinaṁ māṁ svasthānaṁ nānayata, vasanahīnaṁ māṁ vasanaṁ na paryyadhāpayata, pīḍitaṁ kārāsthañca māṁ vīkṣituṁ nāgacchata|</para>
  <para style="p">
    <verse number="44" style="v"/>tadā te prativadiṣyanti, he prabho, kadā tvāṁ kṣudhitaṁ vā pipāsitaṁ vā videśinaṁ vā nagnaṁ vā pīḍitaṁ vā kārāsthaṁ vīkṣya tvāṁ nāsevāmahi?</para>
  <para style="p">
    <verse number="45" style="v"/>tadā sa tān vadiṣyati, tathyamahaṁ yuṣmān bravīmi, yuṣmābhireṣāṁ kañcana kṣodiṣṭhaṁ prati yannākāri, tanmāṁ pratyeva nākāri|</para>
  <para style="p">
    <verse number="46" style="v"/>paścādamyanantaśāstiṁ kintu dhārmmikā anantāyuṣaṁ bhoktuṁ yāsyanti|</para>
  <chapter number="26" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yīśuretān prastāvān samāpya śiṣyānūce,</para>
  <para style="p">
    <verse number="2" style="v"/>yuṣmābhi rjñātaṁ dinadvayāt paraṁ nistāramaha upasthāsyati, tatra manujasutaḥ kruśena hantuṁ parakareṣu samarpiṣyate|</para>
  <para style="p">
    <verse number="3" style="v"/>tataḥ paraṁ pradhānayājakādhyāpakaprāñcaḥ kiyaphānāmno mahāyājakasyāṭṭālikāyāṁ militvā</para>
  <para style="p">
    <verse number="4" style="v"/>kenopāyena yīśuṁ dhṛtvā hantuṁ śaknuyuriti mantrayāñcakruḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>kintu tairuktaṁ mahakāle na dharttavyaḥ, dhṛte prajānāṁ kalahena bhavituṁ śakyate|</para>
  <para style="p">
    <verse number="6" style="v"/>tato baithaniyāpure śimonākhyasya kuṣṭhino veśmani yīśau tiṣṭhati</para>
  <para style="p">
    <verse number="7" style="v"/>kācana yoṣā śvetopalabhājanena mahārghyaṁ sugandhi tailamānīya bhojanāyopaviśatastasya śirobhyaṣecat|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu tadālokya tacchiṣyaiḥ kupitairuktaṁ, kuta itthamapavyayate?</para>
  <para style="p">
    <verse number="9" style="v"/>cedidaṁ vyakreṣyata, tarhi bhūrimūlyaṁ prāpya daridrebhyo vyatāriṣyata|</para>
  <para style="p">
    <verse number="10" style="v"/>yīśunā tadavagatya te samuditāḥ, yoṣāmenāṁ kuto duḥkhinīṁ kurutha, sā māṁ prati sādhu karmmākārṣīt|</para>
  <para style="p">
    <verse number="11" style="v"/>yuṣmākamaṁ samīpe daridrāḥ satatamevāsate, kintu yuṣmākamantikehaṁ nāse satataṁ|</para>
  <para style="p">
    <verse number="12" style="v"/>sā mama kāyopari sugandhitailaṁ siktvā mama śmaśānadānakarmmākārṣīt|</para>
  <para style="p">
    <verse number="13" style="v"/>atohaṁ yuṣmān tathyaṁ vadāmi sarvvasmin jagati yatra yatraiṣa susamācāraḥ pracāriṣyate, tatra tatraitasyā nāryyāḥ smaraṇārtham karmmedaṁ pracāriṣyate|</para>
  <para style="p">
    <verse number="14" style="v"/>tato dvādaśaśiṣyāṇām īṣkariyotīyayihūdānāmaka ekaḥ śiṣyaḥ pradhānayājakānāmantikaṁ gatvā kathitavān,</para>
  <para style="p">
    <verse number="15" style="v"/>yadi yuṣmākaṁ kareṣu yīśuṁ samarpayāmi, tarhi kiṁ dāsyatha? tadānīṁ te tasmai triṁśanmudrā dātuṁ sthirīkṛtavantaḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>sa tadārabhya taṁ parakareṣu samarpayituṁ suyogaṁ ceṣṭitavān|</para>
  <para style="p">
    <verse number="17" style="v"/>anantaraṁ kiṇvaśūnyapūpaparvvaṇaḥ prathamehni śiṣyā yīśum upagatya papracchuḥ bhavatkṛte kutra vayaṁ nistāramahabhojyam āyojayiṣyāmaḥ? bhavataḥ kecchā?</para>
  <para style="p">
    <verse number="18" style="v"/>tadā sa gaditavān, madhyenagaramamukapuṁsaḥ samīpaṁ vrajitvā vadata, guru rgaditavān, matkālaḥ savidhaḥ, saha śiṣyaistvadālaye nistāramahabhojyaṁ bhokṣye|</para>
  <para style="p">
    <verse number="19" style="v"/>tadā śiṣyā yīśostādṛśanideśānurūpakarmma vidhāya tatra nistāramahabhojyamāsādayāmāsuḥ|</para>
  <para style="p">
    <verse number="20" style="v"/>tataḥ sandhyāyāṁ satyāṁ dvādaśabhiḥ śiṣyaiḥ sākaṁ sa nyaviśat|</para>
  <para style="p">
    <verse number="21" style="v"/>aparaṁ bhuñjāna uktavān yuṣmān tathyaṁ vadāmi, yuṣmākameko māṁ parakareṣu samarpayiṣyati|</para>
  <para style="p">
    <verse number="22" style="v"/>tadā te'tīva duḥkhitā ekaikaśo vaktumārebhire, he prabho, sa kimahaṁ?</para>
  <para style="p">
    <verse number="23" style="v"/>tataḥ sa jagāda, mayā sākaṁ yo jano bhojanapātre karaṁ saṁkṣipati, sa eva māṁ parakareṣu samarpayiṣyati|</para>
  <para style="p">
    <verse number="24" style="v"/>manujasutamadhi yādṛśaṁ likhitamāste, tadanurūpā tadgati rbhaviṣyati; kintu yena puṁsā sa parakareṣu samarpayiṣyate, hā hā cet sa nājaniṣyata, tadā tasya kṣemamabhaviṣyat|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā yihūdānāmā yo janastaṁ parakareṣu samarpayiṣyati, sa uktavān, he guro, sa kimahaṁ? tataḥ sa pratyuktavān, tvayā satyaṁ gaditam|</para>
  <para style="p">
    <verse number="26" style="v"/>anantaraṁ teṣāmaśanakāle yīśuḥ pūpamādāyeśvarīyaguṇānanūdya bhaṁktvā śiṣyebhyaḥ pradāya jagāda, madvapuḥsvarūpamimaṁ gṛhītvā khādata|</para>
  <para style="p">
    <verse number="27" style="v"/>paścāt sa kaṁsaṁ gṛhlan īśvarīyaguṇānanūdya tebhyaḥ pradāya kathitavān, sarvvai ryuṣmābhiranena pātavyaṁ,</para>
  <para style="p">
    <verse number="28" style="v"/>yasmādanekeṣāṁ pāpamarṣaṇāya pātitaṁ yanmannūtnaniyamarūpaśoṇitaṁ tadetat|</para>
  <para style="p">
    <verse number="29" style="v"/>aparamahaṁ nūtnagostanīrasaṁ na pāsyāmi, tāvat gostanīphalarasaṁ punaḥ kadāpi na pāsyāmi|</para>
  <para style="p">
    <verse number="30" style="v"/>paścāt te gītamekaṁ saṁgīya jaitunākhyagiriṁ gatavantaḥ|</para>
  <para style="p">
    <verse number="31" style="v"/>tadānīṁ yīśustānavocat, asyāṁ rajanyāmahaṁ yuṣmākaṁ sarvveṣāṁ vighnarūpo bhaviṣyāmi, yato likhitamāste, "meṣāṇāṁ rakṣako yastaṁ prahariṣyāmyahaṁ tataḥ| meṣāṇāṁ nivaho nūnaṁ pravikīrṇo bhaviṣyati"||</para>
  <para style="p">
    <verse number="32" style="v"/>kintu śmaśānāt samutthāya yuṣmākamagre'haṁ gālīlaṁ gamiṣyāmi|</para>
  <para style="p">
    <verse number="33" style="v"/>pitarastaṁ provāca, bhavāṁścet sarvveṣāṁ vighnarūpo bhavati, tathāpi mama na bhaviṣyati|</para>
  <para style="p">
    <verse number="34" style="v"/>tato yīśunā sa uktaḥ, tubhyamahaṁ tathyaṁ kathayāmi, yāminyāmasyāṁ caraṇāyudhasya ravāt pūrvvaṁ tvaṁ māṁ tri rnāṅgīkariṣyasi|</para>
  <para style="p">
    <verse number="35" style="v"/>tataḥ pitara uditavān, yadyapi tvayā samaṁ marttavyaṁ, tathāpi kadāpi tvāṁ na nāṅgīkariṣyāmi; tathaiva sarvve śiṣyāścocuḥ|</para>
  <para style="p">
    <verse number="36" style="v"/>anantaraṁ yīśuḥ śiṣyaiḥ sākaṁ getśimānīnāmakaṁ sthānaṁ prasthāya tebhyaḥ kathitavān, adaḥ sthānaṁ gatvā yāvadahaṁ prārthayiṣye tāvad yūyamatropaviśata|</para>
  <para style="p">
    <verse number="37" style="v"/>paścāt sa pitaraṁ sivadiyasutau ca saṅginaḥ kṛtvā gatavān, śokākulo'tīva vyathitaśca babhūva|</para>
  <para style="p">
    <verse number="38" style="v"/>tānavādīcca mṛtiyātaneva matprāṇānāṁ yātanā jāyate, yūyamatra mayā sārddhaṁ jāgṛta|</para>
  <para style="p">
    <verse number="39" style="v"/>tataḥ sa kiñciddūraṁ gatvādhomukhaḥ patan prārthayāñcakre, he matpitaryadi bhavituṁ śaknoti, tarhi kaṁso'yaṁ matto dūraṁ yātu; kintu madicchāvat na bhavatu, tvadicchāvad bhavatu|</para>
  <para style="p">
    <verse number="40" style="v"/>tataḥ sa śiṣyānupetya tān nidrato nirīkṣya pitarāya kathayāmāsa, yūyaṁ mayā sākaṁ daṇḍamekamapi jāgarituṁ nāśankuta?</para>
  <para style="p">
    <verse number="41" style="v"/>parīkṣāyāṁ na patituṁ jāgṛta prārthayadhvañca; ātmā samudyatosti, kintu vapu rdurbbalaṁ|</para>
  <para style="p">
    <verse number="42" style="v"/>sa dvitīyavāraṁ prārthayāñcakre, he mattāta, na pīte yadi kaṁsamidaṁ matto dūraṁ yātuṁ na śaknoti, tarhi tvadicchāvad bhavatu|</para>
  <para style="p">
    <verse number="43" style="v"/>sa punaretya tān nidrato dadarśa, yatasteṣāṁ netrāṇi nidrayā pūrṇānyāsan|</para>
  <para style="p">
    <verse number="44" style="v"/>paścāt sa tān vihāya vrajitvā tṛtīyavāraṁ pūrvvavat kathayan prārthitavān|</para>
  <para style="p">
    <verse number="45" style="v"/>tataḥ śiṣyānupāgatya gaditavān, sāmprataṁ śayānāḥ kiṁ viśrāmyatha? paśyata, samaya upāsthāt, manujasutaḥ pāpināṁ kareṣu samarpyate|</para>
  <para style="p">
    <verse number="46" style="v"/>uttiṣṭhata, vayaṁ yāmaḥ, yo māṁ parakareṣu masarpayiṣyati, paśyata, sa samīpamāyāti|</para>
  <para style="p">
    <verse number="47" style="v"/>etatkathākathanakāle dvādaśaśiṣyāṇāmeko yihūdānāmako mukhyayājakalokaprācīnaiḥ prahitān asidhāriyaṣṭidhāriṇo manujān gṛhītvā tatsamīpamupatasthau|</para>
  <para style="p">
    <verse number="48" style="v"/>asau parakareṣvarpayitā pūrvvaṁ tān itthaṁ saṅketayāmāsa, yamahaṁ cumbiṣye, so'sau manujaḥ,saeva yuṣmābhi rdhāryyatāṁ|</para>
  <para style="p">
    <verse number="49" style="v"/>tadā sa sapadi yīśumupāgatya he guro, praṇamāmītyuktvā taṁ cucumbe|</para>
  <para style="p">
    <verse number="50" style="v"/>tadā yīśustamuvāca, he mitraṁ kimarthamāgatosi? tadā tairāgatya yīśurākramya daghre|</para>
  <para style="p">
    <verse number="51" style="v"/>tato yīśoḥ saṅgināmekaḥ karaṁ prasāryya koṣādasiṁ bahiṣkṛtya mahāyājakasya dāsamekamāhatya tasya karṇaṁ ciccheda|</para>
  <para style="p">
    <verse number="52" style="v"/>tato yīśustaṁ jagāda, khaḍgaṁ svasthāneे nidhehi yato ye ye janā asiṁ dhārayanti, taevāsinā vinaśyanti|</para>
  <para style="p">
    <verse number="53" style="v"/>aparaṁ pitā yathā madantikaṁ svargīyadūtānāṁ dvādaśavāhinīto'dhikaṁ prahiṇuyāt mayā tamuddiśyedānīmeva tathā prārthayituṁ na śakyate, tvayā kimitthaṁ jñāyate?</para>
  <para style="p">
    <verse number="54" style="v"/>tathā satītthaṁ ghaṭiṣyate dharmmapustakasya yadidaṁ vākyaṁ tat kathaṁ sidhyet?</para>
  <para style="p">
    <verse number="55" style="v"/>tadānīṁ yīśu rjananivahaṁ jagāda, yūyaṁ khaḍgayaṣṭīn ādāya māṁ kiṁ cauraṁ dharttumāyātāḥ? ahaṁ pratyahaṁ yuṣmābhiḥ sākamupaviśya samupādiśaṁ, tadā māṁ nādharata;</para>
  <para style="p">
    <verse number="56" style="v"/>kintu bhaviṣyadvādināṁ vākyānāṁ saṁsiddhaye sarvvametadabhūt|tadā sarvve śiṣyāstaṁ vihāya palāyanta|</para>
  <para style="p">
    <verse number="57" style="v"/>anantaraṁ te manujā yīśuṁ dhṛtvā yatrādhyāpakaprāñcaḥ pariṣadaṁ kurvvanta upāviśan tatra kiyaphānāाmakamahāyājakasyāntikaṁ ninyuḥ|</para>
  <para style="p">
    <verse number="58" style="v"/>kintu śeṣe kiṁ bhaviṣyatīti vettuṁ pitaro dūre tatpaścād vrajitvā mahāyājakasyāṭṭālikāṁ praviśya dāsaiḥ sahita upāviśat|</para>
  <para style="p">
    <verse number="59" style="v"/>tadānīṁ pradhānayājakaprācīnamantriṇaḥ sarvve yīśuṁ hantuṁ mṛṣāsākṣyam alipsanta,</para>
  <para style="p">
    <verse number="60" style="v"/>kintu na lebhire| anekeṣu mṛṣāsākṣiṣvāgateṣvapi tanna prāpuḥ|</para>
  <para style="p">
    <verse number="61" style="v"/>śeṣe dvau mṛṣāsākṣiṇāvāgatya jagadatuḥ, pumānayamakathayat, ahamīśvaramandiraṁ bhaṁktvā dinatrayamadhye tannirmmātuṁ śaknomi|</para>
  <para style="p">
    <verse number="62" style="v"/>tadā mahāyājaka utthāya yīśum avādīt| tvaṁ kimapi na prativadasi? tvāmadhi kimete sākṣyaṁ vadanti?</para>
  <para style="p">
    <verse number="63" style="v"/>kintu yīśu rmaunībhūya tasyau| tato mahāyājaka uktavān, tvām amareśvaranāmnā śapayāmi, tvamīśvarasya putro'bhiṣikto bhavasi naveti vada|</para>
  <para style="p">
    <verse number="64" style="v"/>yīśuḥ pratyavadat, tvaṁ satyamuktavān; ahaṁ yuṣmān tathyaṁ vadāmi, itaḥparaṁ manujasutaṁ sarvvaśaktimato dakṣiṇapārśve sthātuṁ gagaṇasthaṁ jaladharānāruhyāyāntaṁ vīkṣadhve|</para>
  <para style="p">
    <verse number="65" style="v"/>tadā mahāyājako nijavasanaṁ chittvā jagāda, eṣa īśvaraṁ ninditavān, asmākamaparasākṣyeṇa kiṁ prayojanaṁ? paśyata, yūyamevāsyāsyād īśvaranindāṁ śrutavantaḥ,</para>
  <para style="p">
    <verse number="66" style="v"/>yuṣmābhiḥ kiṁ vivicyate? te pratyūcuḥ, vadhārho'yaṁ|</para>
  <para style="p">
    <verse number="67" style="v"/>tato lokaistadāsye niṣṭhīvitaṁ kecit pratalamāhatya kecicca capeṭamāhatya babhāṣire,</para>
  <para style="p">
    <verse number="68" style="v"/>he khrīṣṭa tvāṁ kaścapeṭamāhatavān? iti gaṇayitvā vadāsmān|</para>
  <para style="p">
    <verse number="69" style="v"/>pitaro bahiraṅgana upaviśati, tadānīmekā dāsī tamupāgatya babhāṣe, tvaṁ gālīlīyayīśoḥ sahacaraekaḥ|</para>
  <para style="p">
    <verse number="70" style="v"/>kintu sa sarvveṣāṁ samakṣam anaṅgīkṛtyāvādīt, tvayā yaducyate, tadarthamahaṁ na vedmi|</para>
  <para style="p">
    <verse number="71" style="v"/>tadā tasmin bahirdvāraṁ gate 'nyā dāsī taṁ nirīkṣya tatratyajanānavadat, ayamapi nāsaratīyayīśunā sārddham āsīt|</para>
  <para style="p">
    <verse number="72" style="v"/>tataḥ sa śapathena punaranaṅgīkṛtya kathitavān, taṁ naraṁ na paricinomi|</para>
  <para style="p">
    <verse number="73" style="v"/>kṣaṇāt paraṁ tiṣṭhanto janā etya pitaram avadan, tvamavaśyaṁ teṣāmeka iti tvaduccāraṇameva dyotayati|</para>
  <para style="p">
    <verse number="74" style="v"/>kintu so'bhiśapya kathitavān, taṁ janaṁ nāhaṁ paricinomi, tadā sapadi kukkuṭo rurāva|</para>
  <para style="p">
    <verse number="75" style="v"/>kukkuṭaravāt prāk tvaṁ māṁ trirapāhnoṣyase, yaiṣā vāg yīśunāvādi tāṁ pitaraḥ saṁsmṛtya bahiritvā khedād bhṛśaṁ cakranda|</para>
  <chapter number="27" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>prabhāte jāte pradhānayājakalokaprācīnā yīśuṁ hantuṁ tatpratikūlaṁ mantrayitvā</para>
  <para style="p">
    <verse number="2" style="v"/>taṁ badvvā nītvā pantīyapīlātākhyādhipe samarpayāmāsuḥ|</para>
  <para style="p">
    <verse number="3" style="v"/>tato yīśoḥ parakarevvarpayitā yihūdāstatprāṇādaṇḍājñāṁ viditvā santaptamanāḥ pradhānayājakalokaprācīnānāṁ samakṣaṁ tāstrīṁśanmudrāḥ pratidāyāvādīt,</para>
  <para style="p">
    <verse number="4" style="v"/>etannirāgonaraprāṇaparakarārpaṇāt kaluṣaṁ kṛtavānahaṁ| tadā ta uditavantaḥ, tenāsmākaṁ kiṁ? tvayā tad budhyatām|</para>
  <para style="p">
    <verse number="5" style="v"/>tato yihūdā mandiramadhye tā mudrā nikṣipya prasthitavān itvā ca svayamātmānamudbabandha|</para>
  <para style="p">
    <verse number="6" style="v"/>paścāt pradhānayājakāstā mudrā ādāya kathitavantaḥ, etā mudrāḥ śoṇitamūlyaṁ tasmād bhāṇḍāgāre na nidhātavyāḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>anantaraṁ te mantrayitvā videśināṁ śmaśānasthānāya tābhiḥ kulālasya kṣetramakrīṇan|</para>
  <para style="p">
    <verse number="8" style="v"/>ato'dyāpi tatsthānaṁ raktakṣetraṁ vadanti|</para>
  <para style="p">
    <verse number="9" style="v"/>itthaṁ sati isrāyelīyasantānai ryasya mūlyaṁ nirupitaṁ, tasya triṁśanmudrāmānaṁ mūlyaṁ</para>
  <para style="p">
    <verse number="10" style="v"/>māṁ prati parameśvarasyādeśāt tebhya ādīyata, tena ca kulālasya kṣetraṁ krītamiti yadvacanaṁ yirimiyabhaviṣyadvādinā proktaṁ tat tadāsidhyat|</para>
  <para style="p">
    <verse number="11" style="v"/>anantaraṁ yīśau tadadhipateḥ sammukha upatiṣṭhati sa taṁ papraccha, tvaṁ kiṁ yihūdīyānāṁ rājā? tadā yīśustamavadat, tvaṁ satyamuktavān|</para>
  <para style="p">
    <verse number="12" style="v"/>kintu pradhānayājakaprācīnairabhiyuktena tena kimapi na pratyavādi|</para>
  <para style="p">
    <verse number="13" style="v"/>tataḥ pīlātena sa uditaḥ, ime tvatpratikūlataḥ kati kati sākṣyaṁ dadati, tat tvaṁ na śṛṇoṣi?</para>
  <para style="p">
    <verse number="14" style="v"/>tathāpi sa teṣāmekasyāpi vacasa uttaraṁ noditavān; tena so'dhipati rmahācitraṁ vidāmāsa|</para>
  <para style="p">
    <verse number="15" style="v"/>anyacca tanmahakāle'dhipateretādṛśī rātirāsīt, prajā yaṁ kañcana bandhinaṁ yācante, tameva sa mocayatīti|</para>
  <para style="p">
    <verse number="16" style="v"/>tadānīṁ barabbānāmā kaścit khyātabandhyāsīt|</para>
  <para style="p">
    <verse number="17" style="v"/>tataḥ pīlātastatra militān lokān apṛcchat, eṣa barabbā bandhī khrīṣṭavikhyāto yīśuścaitayoḥ kaṁ mocayiṣyāmi? yuṣmākaṁ kimīpsitaṁ?</para>
  <para style="p">
    <verse number="18" style="v"/>tairīrṣyayā sa samarpita iti sa jñātavān|</para>
  <para style="p">
    <verse number="19" style="v"/>aparaṁ vicārāsanopaveśanakāle pīlātasya patnī bhṛtyaṁ prahitya tasmai kathayāmāsa, taṁ dhārmmikamanujaṁ prati tvayā kimapi na karttavyaṁ; yasmāt tatkṛte'dyāhaṁ svapne prabhūtakaṣṭamalabhe|</para>
  <para style="p">
    <verse number="20" style="v"/>anantaraṁ pradhānayājakaprācīnā barabbāṁ yācitvādātuṁ yīśuñca hantuṁ sakalalokān prāvarttayan|</para>
  <para style="p">
    <verse number="21" style="v"/>tato'dhipatistān pṛṣṭavān, etayoḥ kamahaṁ mocayiṣyāmi? yuṣmākaṁ kecchā? te procu rbarabbāṁ|</para>
  <para style="p">
    <verse number="22" style="v"/>tadā pīlātaḥ papraccha, tarhi yaṁ khrīṣṭaṁ vadanti, taṁ yīśuṁ kiṁ kariṣyāmi? sarvve kathayāmāsuḥ, sa kruśena vidhyatāṁ|</para>
  <para style="p">
    <verse number="23" style="v"/>tato'dhipatiravādīt, kutaḥ? kiṁ tenāparāddhaṁ? kintu te punarucai rjagaduḥ, sa kruśena vidhyatāṁ|</para>
  <para style="p">
    <verse number="24" style="v"/>tadā nijavākyamagrāhyamabhūt, kalahaścāpyabhūt, pīlāta iti vilokya lokānāṁ samakṣaṁ toyamādāya karau prakṣālyāvocat, etasya dhārmmikamanuṣyasya śoṇitapāte nirdoṣo'haṁ, yuṣmābhireva tad budhyatāṁ|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā sarvvāḥ prajāḥ pratyavocan, tasya śoṇitapātāparādho'smākam asmatsantānānāñcopari bhavatu|</para>
  <para style="p">
    <verse number="26" style="v"/>tataḥ sa teṣāṁ samīpe barabbāṁ mocayāmāsa yīśuntu kaṣābhirāhatya kruśena vedhituṁ samarpayāmāsa|</para>
  <para style="p">
    <verse number="27" style="v"/>anantaram adhipateḥ senā adhipate rgṛhaṁ yīśumānīya tasya samīpe senāsamūhaṁ saṁjagṛhuḥ|</para>
  <para style="p">
    <verse number="28" style="v"/>tataste tasya vasanaṁ mocayitvā kṛṣṇalohitavarṇavasanaṁ paridhāpayāmāsuḥ</para>
  <para style="p">
    <verse number="29" style="v"/>kaṇṭakānāṁ mukuṭaṁ nirmmāya tacchirasi daduḥ, tasya dakṣiṇakare vetramekaṁ dattvā tasya sammukhe jānūni pātayitvā, he yihūdīyānāṁ rājan, tubhyaṁ nama ityuktvā taṁ tiraścakruḥ,</para>
  <para style="p">
    <verse number="30" style="v"/>tatastasya gātre niṣṭhīvaṁ datvā tena vetreṇa śira ājaghnuḥ|</para>
  <para style="p">
    <verse number="31" style="v"/>itthaṁ taṁ tiraskṛtya tad vasanaṁ mocayitvā punarnijavasanaṁ paridhāpayāñcakruḥ, taṁ kruśena vedhituṁ nītavantaḥ|</para>
  <para style="p">
    <verse number="32" style="v"/>paścātte bahirbhūya kurīṇīyaṁ śimonnāmakamekaṁ vilokya kruśaṁ voḍhuṁ tamādadire|</para>
  <para style="p">
    <verse number="33" style="v"/>anantaraṁ gulgaltām arthāt śiraskapālanāmakasthānamu pasthāya te yīśave pittamiśritāmlarasaṁ pātuṁ daduḥ,</para>
  <para style="p">
    <verse number="34" style="v"/>kintu sa tamāsvādya na papau|</para>
  <para style="p">
    <verse number="35" style="v"/>tadānīṁ te taṁ kruśena saṁvidhya tasya vasanāni guṭikāpātena vibhajya jagṛhuḥ, tasmāt, vibhajante'dharīyaṁ me te manuṣyāḥ parasparaṁ| maduttarīyavastrārthaṁ guṭikāṁ pātayanti ca||yadetadvacanaṁ bhaviṣyadvādibhiruktamāsīt, tadā tad asidhyat,</para>
  <para style="p">
    <verse number="36" style="v"/>paścāt te tatropaviśya tadrakṣaṇakarvvaṇi niyuktāstasthuḥ|</para>
  <para style="p">
    <verse number="37" style="v"/>aparam eṣa yihūdīyānāṁ rājā yīśurityapavādalipipatraṁ tacchirasa ūrdvve yojayāmāsuḥ|</para>
  <para style="p">
    <verse number="38" style="v"/>tatastasya vāme dakṣiṇe ca dvau cairau tena sākaṁ kruśena vividhuḥ|</para>
  <para style="p">
    <verse number="39" style="v"/>tadā pānthā nijaśiro lāḍayitvā taṁ nindanto jagaduḥ,</para>
  <para style="p">
    <verse number="40" style="v"/>he īśvaramandirabhañjaka dinatraye tannirmmātaḥ svaṁ rakṣa, cettvamīśvarasutastarhi kruśādavaroha|</para>
  <para style="p">
    <verse number="41" style="v"/>pradhānayājakādhyāpakaprācīnāśca tathā tiraskṛtya jagaduḥ,</para>
  <para style="p">
    <verse number="42" style="v"/>so'nyajanānāvat, kintu svamavituṁ na śaknoti| yadīsrāyelo rājā bhavet, tarhīdānīmeva kruśādavarohatu, tena taṁ vayaṁ pratyeṣyāmaḥ|</para>
  <para style="p">
    <verse number="43" style="v"/>sa īśvare pratyāśāmakarot, yadīśvarastasmin santuṣṭastarhīdānīmeva tamavet, yataḥ sa uktavān ahamīśvarasutaḥ|</para>
  <para style="p">
    <verse number="44" style="v"/>yau stenau sākaṁ tena kruśena viddhau tau tadvadeva taṁ ninindatuḥ|</para>
  <para style="p">
    <verse number="45" style="v"/>tadā dvitīyayāmāt tṛtīyayāmaṁ yāvat sarvvadeśe tamiraṁ babhūva,</para>
  <para style="p">
    <verse number="46" style="v"/>tṛtīyayāme "elī elī lāmā śivaktanī", arthāt madīśvara madīśvara kuto māmatyākṣīḥ? yīśuruccairiti jagāda|</para>
  <para style="p">
    <verse number="47" style="v"/>tadā tatra sthitāḥ kecit tat śrutvā babhāṣire, ayam eliyamāhūyati|</para>
  <para style="p">
    <verse number="48" style="v"/>teṣāṁ madhyād ekaḥ śīghraṁ gatvā spañjaṁ gṛhītvā tatrāmlarasaṁ dattvā nalena pātuṁ tasmai dadau|</para>
  <para style="p">
    <verse number="49" style="v"/>itare'kathayan tiṣṭhata, taṁ rakṣitum eliya āyāti naveti paśyāmaḥ|</para>
  <para style="p">
    <verse number="50" style="v"/>yīśuḥ punarucairāhūya prāṇān jahau|</para>
  <para style="p">
    <verse number="51" style="v"/>tato mandirasya vicchedavasanam ūrdvvādadho yāvat chidyamānaṁ dvidhābhavat,</para>
  <para style="p">
    <verse number="52" style="v"/>bhūmiścakampe bhūdharovyadīryyata ca| śmaśāne mukte bhūripuṇyavatāṁ suptadehā udatiṣṭhan,</para>
  <para style="p">
    <verse number="53" style="v"/>śmaśānād vahirbhūya tadutthānāt paraṁ puṇyapuraṁ gatvā bahujanān darśayāmāsuḥ|</para>
  <para style="p">
    <verse number="54" style="v"/>yīśurakṣaṇāya niyuktaḥ śatasenāpatistatsaṅginaśca tādṛśīṁ bhūkampādighaṭanāṁ dṛṣṭvā bhītā avadan, eṣa īśvaraputro bhavati|</para>
  <para style="p">
    <verse number="55" style="v"/>yā bahuyoṣito yīśuṁ sevamānā gālīlastatpaścādāgatāstāsāṁ madhye</para>
  <para style="p">
    <verse number="56" style="v"/>magdalīnī mariyam yākūbyośyo rmātā yā mariyam sibadiyaputrayo rmātā ca yoṣita etā dūre tiṣṭhantyo dadṛśuḥ|</para>
  <para style="p">
    <verse number="57" style="v"/>sandhyāyāṁ satyam arimathiyānagarasya yūṣaphnāmā dhanī manujo yīśoḥ śiṣyatvāt</para>
  <para style="p">
    <verse number="58" style="v"/>pīlātasya samīpaṁ gatvā yīśoḥ kāyaṁ yayāce, tena pīlātaḥ kāyaṁ dātum ādideśa|</para>
  <para style="p">
    <verse number="59" style="v"/>yūṣaph tatkāyaṁ nītvā śucivastreṇācchādya</para>
  <para style="p">
    <verse number="60" style="v"/>svārthaṁ śaile yat śmaśānaṁ cakhāna, tanmadhye tatkāyaṁ nidhāya tasya dvāri vṛhatpāṣāṇaṁ dadau|</para>
  <para style="p">
    <verse number="61" style="v"/>kintu magdalīnī mariyam anyamariyam ete striyau tatra śmaśānasammukha upaviviśatuḥ|</para>
  <para style="p">
    <verse number="62" style="v"/>tadanantaraṁ nistārotsavasyāyojanadināt pare'hani pradhānayājakāḥ phirūśinaśca militvā pīlātamupāgatyākathayan,</para>
  <para style="p">
    <verse number="63" style="v"/>he maheccha sa pratārako jīvana akathayat, dinatrayāt paraṁ śmaśānādutthāsyāmi tadvākyaṁ smarāmo vayaṁ;</para>
  <para style="p">
    <verse number="64" style="v"/>tasmāt tṛtīyadinaṁ yāvat tat śmaśānaṁ rakṣitumādiśatu, nocet tacchiṣyā yāminyāmāgatya taṁ hṛtvā lokān vadiṣyanti, sa śmaśānādudatiṣṭhat, tathā sati prathamabhrānteḥ śeṣīyabhrānti rmahatī bhaviṣyati|</para>
  <para style="p">
    <verse number="65" style="v"/>tadā pīlāta avādīt, yuṣmākaṁ samīpe rakṣigaṇa āste, yūyaṁ gatvā yathā sādhyaṁ rakṣayata|</para>
  <para style="p">
    <verse number="66" style="v"/>tataste gatvā taddūाrapāṣāṇaṁ mudrāṅkitaṁ kṛtvā rakṣigaṇaṁ niyojya śmaśānaṁ rakṣayāmāsuḥ|</para>
  <chapter number="28" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ paraṁ viśrāmavārasya śeṣe saptāhaprathamadinasya prabhote jāte magdalīnī mariyam anyamariyam ca śmaśānaṁ draṣṭumāgatā|</para>
  <para style="p">
    <verse number="2" style="v"/>tadā mahān bhūkampo'bhavat; parameśvarīyadūtaḥ svargādavaruhya śmaśānadvārāt pāṣāṇamapasāryya taduparyyupaviveśa|</para>
  <para style="p">
    <verse number="3" style="v"/>tadvadanaṁ vidyudvat tejomayaṁ vasanaṁ himaśubhrañca|</para>
  <para style="p">
    <verse number="4" style="v"/>tadānīṁ rakṣiṇastadbhayāt kampitā mṛtavad babhūvaḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>sa dūto yoṣito jagāda, yūyaṁ mā bhaiṣṭa, kruśahatayīśuṁ mṛgayadhve tadahaṁ vedmi|</para>
  <para style="p">
    <verse number="6" style="v"/>so'tra nāsti, yathāvadat tathotthitavān; etat prabhoḥ śayanasthānaṁ paśyata|</para>
  <para style="p">
    <verse number="7" style="v"/>tūrṇaṁ gatvā tacchiṣyān iti vadata, sa śmaśānād udatiṣṭhat, yuṣmākamagre gālīlaṁ yāsyati yūyaṁ tatra taṁ vīkṣiṣyadhve, paśyatāhaṁ vārttāmimāṁ yuṣmānavādiṣaṁ|</para>
  <para style="p">
    <verse number="8" style="v"/>tatastā bhayāt mahānandāñca śmaśānāt tūrṇaṁ bahirbhūya tacchiṣyān vārttāṁ vaktuṁ dhāvitavatyaḥ| kintu śiṣyān vārttāṁ vaktuṁ yānti, tadā yīśu rdarśanaṁ dattvā tā jagāda,</para>
  <para style="p">
    <verse number="9" style="v"/>yuṣmākaṁ kalyāṇaṁ bhūyāt, tatastā āgatya tatpādayoḥ patitvā praṇemuḥ|</para>
  <para style="p">
    <verse number="10" style="v"/>yīśustā avādīt, mā bibhīta, yūyaṁ gatvā mama bhrātṛn gālīlaṁ yātuṁ vadata, tatra te māṁ drakṣyanti|</para>
  <para style="p">
    <verse number="11" style="v"/>striyo gacchanti, tadā rakṣiṇāṁ kecit puraṁ gatvā yadyad ghaṭitaṁ tatsarvvaṁ pradhānayājakān jñāpitavantaḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>te prācīnaiḥ samaṁ saṁsadaṁ kṛtvā mantrayanto bahumudrāḥ senābhyo dattvāvadan,</para>
  <para style="p">
    <verse number="13" style="v"/>asmāsu nidriteṣu tacchiṣyā yāminyāmāgatya taṁ hṛtvānayan, iti yūyaṁ pracārayata|</para>
  <para style="p">
    <verse number="14" style="v"/>yadyetadadhipateḥ śrotragocarībhavet, tarhi taṁ bodhayitvā yuṣmānaviṣyāmaḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>tataste mudrā gṛhītvā śikṣānurūpaṁ karmma cakruḥ, yihūdīyānāṁ madhye tasyādyāpi kiṁvadantī vidyate|</para>
  <para style="p">
    <verse number="16" style="v"/>ekādaśa śiṣyā yīśunirūpitāgālīlasyādriṁ gatvā</para>
  <para style="p">
    <verse number="17" style="v"/>tatra taṁ saṁvīkṣya praṇemuḥ, kintu kecit sandigdhavantaḥ|</para>
  <para style="p">
    <verse number="18" style="v"/>yīśusteṣāṁ samīpamāgatya vyāhṛtavān, svargamedinyoḥ sarvvādhipatitvabhāro mayyarpita āste|</para>
  <para style="p">
    <verse number="19" style="v"/>ato yūyaṁ prayāya sarvvadeśīyān śiṣyān kṛtvā pituḥ putrasya pavitrasyātmanaśca nāmnā tānavagāhayata; ahaṁ yuṣmān yadyadādiśaṁ tadapi pālayituṁ tānupādiśata|</para>
  <para style="p">
    <verse number="20" style="v"/>paśyata, jagadantaṁ yāvat sadāhaṁ yuṣmābhiḥ sākaṁ tiṣṭhāmi| iti|</para>
</usx>
