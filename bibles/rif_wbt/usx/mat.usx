<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id" />
  <para style="h">Matta</para>
  <para style="toc3">Mt</para>
  <para style="toc2">Matta</para>
  <para style="toc1">Aseȓmeḏ n Siḏiṯneɣ Ƹisa Lkitab n Matta</para>
  <para style="mt1">Aseȓmeḏ n Siḏiṯneɣ Ƹisa</para>
  <para style="mt3">Lkitab n Matta</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Ȓejḏuḏ n Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Wa ḏ lkitab n ȓejḏuḏ n Ƹisa Lmasiḥ, wenni iǧan zi ddurriṯ n Dawed ḏ Brahim.<verse eid="MAT 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2" />Brahim ijja-d Isḥaq. Isḥaq ijja-d Yaƹqub. Yaƹqub ijja-d Yahuḏa ḏ ayṯmas. <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />Yahuḏa ijja-d Faris ḏ Zaraḥ ak ṯemɣarṯ nnes Ṯamra. Faris ijja-d Ḥaṣrun. Ḥaṣrun ijja-d Aram. <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />Aram ijja-d Ƹaminadab. Ƹaminadab ijja-d Nassun. Nassun ijja-d Salmun. <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />Salmun ijja-d Buƹazza ak ṯemɣarṯ nnes Riḥab. Buƹazza ijja-d Ƹubayd ak ṯemɣarṯ nnes Raƹuṯ. Ƹubayd ijja-d Yassa. <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />Yassa ijja-d Dawed azeǧiḏ. Dawed azeǧiḏ ijja-d Suliman zi ṯenni tuɣa iǧan ḏ ṯamɣarṯ n Uryaḥ.<verse eid="MAT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 1:7" />Suliman ijja-d Raḥubƹam. Raḥubƹam ijja-d Abiya. Abiya ijja-d Asa. <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />Asa ijja-d Yahucafaṭ. Yahucafaṭ ijja-d Yuram. Yuram ijja-d Ƹuzzaya. <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Ƹuzzaya ijja-d Yuṯam. Yuṯam ijja-d Aḥaz. Aḥaz ijja-d Ḥisqi. <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Ḥisqi ijja-d Manassa. Manassa ijja-d Amun. Amun ijja-d Yuciya. <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />Yuciya ijja-d Yakunya ḏ ayṯmas ḏi ȓweqṯ nni wami twasufɣen ɣar Babil.<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />Menbaƹd i ȓweqṯ nni wami twasufɣen ɣar Babil, Yakunya ijja-d Cƹaltihil. Cƹaltihil ijja-d Zarubbabil. <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />Zarubbabil ijja-d Abihud. Abihud ijja-d Lyaqim. Lyaqim ijja-d Ƹazur. <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />Ƹazur ijja-d Ṣaduq. Ṣaduq ijja-d Axim. Axim ijja-d Alyud. <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Alyud ijja-d Lƹizar. Lƹizar ijja-d Mattan. Mattan ijja-d Yaƹqub. <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />Yaƹqub ijja-d Yusef aryaz n Maryam nettaṯ iy d ijjin Ƹisa ig itwasemman s Lmasiḥ.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Ḏinni arbeƹṭac n lʼajyal zi Brahim ɣar Dawed. Zi Dawed ḥetta wami twasufɣen ɣar Babil arbeƹṭac n lʼajyal. Zeg wami twasufɣen ɣar Babil ḥetta wami d ixȓeq Lmasiḥ arbeƹṭac n lʼajyal.<verse eid="MAT 1:17" /></para>
  <para style="s">Lxuluq n Siḏiṯneɣ Ƹisa Lmasiḥ</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Fa mammec iy d ixȓeq Ƹisa Lmasiḥ. Yemmas Maryam tuɣa ṯegga lxuṭuba ak Yusef. Menbaƹd qbeȓ ma aḏ meȓcen jarasen ṯeysi aƹeddis zi Arruḥ iqeddsen. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Yusef anexḍab nnes, nican ig iǧa. War ixes ca axas iḍȓeq ddiƹaya, irezzu aḏas iǧef s ṯnufra.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />Walakin wami itfekkar ḏi ṯmesȓayṯ nni, ṯbedd-d xas ijjen n lmalaʼika ḏi ṯirjiṯ ṯenna-as: "A Yusef a mmis n Ayṯ-Dawed, war teggweḏ ca aḏ tiȓi Maryam ḏ ṯamɣarṯ nnec. Aqa zi Arruḥ iqeddsen iy zi ṯeysi aƹeddis. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Aqa aḏ d tejj ijjen n uḥenjir aṯ ṯsemmiḏ Ƹisa ȓaḥeqqac netta iy ɣa isnejmen ȓqum nnes zi ȓmuƹṣiyaṯ nsen."<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Qa ḏ manaya marra ig iweqƹen ḥima aḏ ikemmeȓ wawaȓ iy inna Siḏi Arebbi i nnabi <char style="it">Icaƹya</char> ḏeg yijjen n zman: <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />&lt;Aqa ṯaƹzriṯ aḏ teysi aƹeddis, aḏ tejj ijjen n uḥenjir aḏas semman Immanwil.&gt; (Ȓmaƹna nnes: Arebbi aqaṯ akiḏneɣ.)<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Wami d ifaq Yusef zeg yiḍeṣ igga min ḏas ṯenna lmalaʼika n Siḏi Arebbi, yuwi-d ṯamɣarṯ nnes. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Walakin war ɣares iqarreb ca aȓ wami d ṯejja mmis. Ṯumma isemma-ṯ igga-as Ƹisa.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Yinni iqqaren lƹilem n yiṯran</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Wami d ixȓeq Ƹisa ḏeg ubilaj n Bayt Laḥm ḏi ṯmurṯ n Yahuḏiya ḏi ȓweqṯ n uzeǧiḏ Hirudus, usin-d can yiwḏan zeg yinni iqqaren lƹilem n yiṯran zi ccarq ɣar ṯendint n Lquds. <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />Nnan: "Mani iǧa uḥenjir nni iy d ixeȓqen aḏ yiȓi ḏ azeǧiḏ n Ayṯ-Israʼil? Aqa neẓra iṯri nnes ḏi ccarq, qa nusa-d aḏas nsejjeḏ."<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Wami isȓa uzeǧiḏ Hirudus manaya, ixeyyeq iysi ijjen n umnus ḏ ameqqran netta ḏ imezḏaɣ n Lquds. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Ismun marra arruyas n ȓfuqaha <char style="it">n Ayṯ-Israʼil</char> ḏ imseȓmaḏen n ccariƹa isseqsa-ṯen inna-asen: "Mani d ɣa ixȓeq Lmasiḥ?"<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />Arrin xas nnan-as: "Ḏi Bayt Laḥm ḏi ṯmurṯ n Yahuḏiya, mammec yura nnabi <char style="it">Mixa</char> ḏeg yijjen n zman:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />
    <char style="it">Arebbi inna:</char> &lt;Uȓa ḏ cem,</para>
  <para style="q2" vid="MAT 2:6">a Bayt Laḥm ḏi ṯmurṯ n Yahuḏiya,</para>
  <para style="q1" vid="MAT 2:6">war ṯeǧiḏ bu ḏ ṯamezyant</para>
  <para style="q2" vid="MAT 2:6">jar ṯneddam<note caller="+" style="f"><char style="fr" closed="false">2.6 </char><char style="ft" closed="false">Ṯineddam niṯenti ḏ ṯindinin.</char></note> n Yahuḏiya.</para>
  <para style="q1" vid="MAT 2:6">Zzayem iy d ɣa iffeɣ ijjen n lḥakem</para>
  <para style="q2" vid="MAT 2:6">iy ɣa inedhen ccaƹb inu n Ayṯ-Israʼil.&gt;"<note caller="+" style="f"><char style="fr" closed="false">2.6 </char><char style="ft" closed="false">Xzar Mixa (Michée) 5:2.</char></note><verse eid="MAT 2:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Ȓexddenni iȓaɣa-yasen-d uzeǧiḏ Hirudus s ṯnufra i yinni iqqaren lƹilem n yiṯran, isseqsa-ṯen issen zzaysen meȓmi tuɣa d imeḍhar yiṯri-ya. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Ssenni issekk-iṯen ɣar Bayt Laḥm inna-asen: "Ruḥem ḏinni rzum mliḥ x uḥenjir nni. Xmi ṯ ɣa ṯafem, ƹeȓmem-ayi bac aḏ raḥeɣ uȓa ḏ nec aḏas sejjḏeɣ."<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Sȓin min inna uzeǧiḏ, kkaren ruḥen ḏinni. Iṯri nni iy ẓrin ḏi ccarq iggur ɣar zzaṯ. Wami yuweḍ yiṯri nni, ibedd ḏeg ujenna ɣar mani iǧa uḥenjir nni. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Wami ẓrin iṯri nni farḥen aṭṭas. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Uḏfen ṯaddarṯ nni, ufin aḥenjir nni ak yemmas Maryam, wḍan x ifadden nsen sejjḏen-as. Kksen-d ȓeknuz nsen, iƹni ddheb ḏ tbaxur lluban ḏ yijjen n ȓḥajeṯ ḏ tufuḥ qqaren-as murr, ucin-as-ṯen ḏ lhadiyaṯ.<verse eid="MAT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12" />Iƹȓem-asen Arebbi ḏi ṯirjiṯ inna-asen war teƹqibem ca ɣar uzeǧiḏ Hirudus. Ṣafi kkaren ḏewȓen ɣar ṯmurṯ nsen x yijjen n ubriḏ nneɣni.<verse eid="MAT 2:12" /></para>
  <para style="s">Ṯarweȓa ɣar Miṣra</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Wami uyuren <char style="it">yiwḏan nni iqqaren lƹilem n yiṯran</char>, ṯbedd-d ijjen n lmalaʼika n Siḏi Arebbi ḏi ṯirjiṯ ɣar Yusef ṯenna-as: "Kkar ysi aḥenjir ḏ yemmas arweȓ ɣar Miṣra, zeḏɣem ḏinni aȓ ḏac ɣa iniɣ ḏweȓ-d. Aqa azeǧiḏ Hirudus irezzu x uḥenjir-a bac aṯ ineɣ." <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Ikkar Yusef yuyur s ǧiȓeṯ ɣar Miṣra yuwi aḥenjir nni ḏ yemmas akiḏes. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />Iqqim ḏinni ḥetta aȓ wami immuṯ Hirudus. Qaƹ manaya iwqeƹ ḥima aḏ ikemmeȓ wawaȓ ig inna Siḏi Arebbi i nnabi umi qqaren <char style="it">Hucaƹ</char> ḏeg yijjen n zman: &lt;Qa ȓaɣiɣ-d i Mmi bac aḏ d iffeɣ zi Miṣra.&gt;<verse eid="MAT 2:15" /></para>
  <para style="s">Ȓmewṯ n iḥenjiren n Bayt Laḥm</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Wami d yarra ȓexbar Hirudus belli yinni iqqaren lƹilem n yiṯran cemṯen-ṯ, iƹeṣṣeb aṭṭas iɣḍeb. Issekk bac aḏ ineɣ iḥenjiren nni marra ḏi Bayt Laḥm ḏ nnawaḥi nnes iy ɣar ṯeǧa qell zi ƹamayen. Manaya ƹlaḥsab ȓweqṯ iy ḏasen d imeḍhar yiṯri nni i yinni iqqaren lƹilem n yiṯran. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Ȓexddenni ikemmeȓ wawaȓ nni iy inna Siḏi Arebbi i nnabi umi qqaren Irmiya ḏeg yijjen n zman:<verse eid="MAT 2:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />&lt;Ṯɣuyyiṯ tesȓan-as zi dcar n Rama, ḏ imeṭṭawen ḏ waṭṭas n lḥuzen,</para>
  <para style="q1" vid="MAT 2:18">ḏ Ayṯ-Raḥil ig itrun x ṯarwa nsen, war xsen aṯen iƹezza ḥadd x ṯarwa nsen immuṯen.&gt;<verse eid="MAT 2:18" /></para>
  <para style="s">Teƹqaben-d zi Miṣra ɣar Naṣira</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Wami immuṯ uzeǧiḏ Hirudus ṯbedd-d ijjen n lmalaʼika n Siḏi Arebbi ɣar Yusef ḏi ṯirjiṯ ḏi Miṣra. <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />Ṯenna-as: "Kkar ƹqeb, awi akiḏec aḥenjir-a ḏ yemmas ɣar ṯmurṯ n Ayṯ-Israʼil, aqa yinni ixsen aḏ nɣen aḥenjir-a qa mmuṯen." <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />Ssenni ikkar Yusef yuwi akiḏes aḥenjir nni ḏ yemmas iḏweȓ ɣar ṯmurṯ nnes n Ayṯ-Israʼil. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Walakin wami isȓa belli azeǧiḏ Arxilawus ixȓef babas Hirudus ḏi ȓeḥkam n Yahuḏiya, iggweḏ aḏ iraḥ ḏinni. <char style="it">Siḏi Arebbi</char> iƹȓem-as-d ƹaweḏ ḏeg yijjen n ṯirjiṯ, ikkar iruḥ ɣar jjiheṯ n ṯmurṯ n Ljalil. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />Izḏeɣ ḏeg yijjen n ubilaj qqaren-as Naṣira ḥima aḏ ikemmeȓ wawaȓ nni iy inna Siḏi Arebbi i lʼanbiya ḏeg yijjen n zman: &lt;Aqa aḏas semman Naṣiri.&gt;<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">Nnabi Yaḥya isewjaḏ abriḏ i Lmasiḥ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Ḏi ȓweqṯ nni imeḍhar-d Yaḥya, itṭehhar i yiwḏan s waman itbeccar-iṯen ḏi ȓexȓa n Yahuḏiya. <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />Iqqar-asen: "Tubem, aqa yuḏes-d ȓmulk n ujenna." <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />X Yaḥya ig inna nnabi umi qqaren Icaƹya ḏeg yijjen n zman:</para>
  <para style="q1" vid="MAT 3:3">&lt;Ṯmijja tȓaɣa ḏi ȓexȓa ṯeqqar:</para>
  <para style="q2" vid="MAT 3:3">Swejḏeṯ abriḏ i Siḏi Arebbi,</para>
  <para style="q1" vid="MAT 3:3">ggem ibriḏen nnes nican.&gt;<note caller="+" style="f"><char style="fr" closed="false">3.3 </char><char style="ft" closed="false">Xzar Icaƹya (Esaïe) 40:3.</char></note><verse eid="MAT 3:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Yaḥya arruḍ nnes xeḏmen-ṯ s cƹar n uȓɣem, x nneṣṣ nnes ijjen n uḥezzam n yiȓem. Itett ṯmurɣi ḏ ṯamment ṯaḥurrect. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Tasen-d ɣares imezḏaɣ n ṯendint n Lquds ḏ yinni n Yahuḏiya amen-ṯekmaȓ ḏ marra yinni iy d innḍen i yiɣzar n Lʼurdun. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Teƹtarafen s ȓmuƹṣiyaṯ nsen, Yaḥya itṭehhar-iṯen s waman ḏeg yiɣzar n Lʼurdun.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Walakin wami iẓra Yaḥya belli aṭṭas n ȓfuqaha ḏ ifarrisiyen ḏ iṣadduqiyen tasen-d ɣares ḥima aṯen iṭehhar s waman inna-asen: "Ya ṯarwa n ifiɣeran, wi ḏawem iƹeȓmen aḏ tarewȓem zi lɣaḍab <char style="it">n Siḏi Arebbi</char> iy d ɣa yasen? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Meȓa ṯtubem ḏ ṣṣaḥ, ggeṯ ȓexḏayem ṯiṣebḥanin. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Maci aḏ tinim ḏi nnefs nwem qa neccin ḏ ṯarwa n Brahim u ṣafi. Meȓa ixes Arebbi ṯarwa n Brahim, ataf aḏ iysi izra-ya aṯen yarr ḏ ṯarwa n Brahim! <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Aqa caqur iwjeḏ ḥima aḏ iqess iẓewran n ȓcejjur. Mkuȓ ṯacejjarṯ iy war itirwen ca min iǧan ḏ aṣebḥan ataf aḏ twaqess aḏ tmenḍar ḏi ṯmessi. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />Nec tṭehhareɣ-kenniw s waman bac aḏ tubem, walakin wenni iy d ɣa yasen menbaƹd i nec, netta ijheḏ xafi. War sḏihiǧeɣ ca aḏas ysiɣ uȓa ḏ ṯisiȓa nnes. Netta akenniw iṭehhar s Arruḥ iqeddsen ḏ <char style="it">yiȓesawen n</char> ṯmessi.<note caller="+" style="f"><char style="fr" closed="false">3.11 </char><char style="ft" closed="false">S ṯyunaniṯ n lʼaṣel iqqar "s Arruḥ iqeddsen ḏ ṯmessi." Imken issawaȓ ḏanita x min ɣa iweqƹen ḏi Ȓexḏayem n Arrusul 2:3.</char></note> <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Ɣares ṯazzarṯ ḏeg ufus ḥima aḏ izuzzar ṯaffa nnes qaƹ, aḏ ismun ṯiḥebba n yirḏan aṯent igg ḏi ṯesrafṯ. Min war ineffƹen ca<note caller="+" style="f"><char style="fr" closed="false">3.12 </char><char style="ft" closed="false">"Min war ineffƹen," iƹni ḏ acarfa niɣ aḵarfa.</char></note> aṯ issecmeḍ ḏi ṯmessi iy war ixessin ƹemmarṣ."<verse eid="MAT 3:12" /></para>
  <para style="s">Nnabi Yaḥya itṭehhar i Siḏiṯneɣ Ƹisa s waman</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Ssenni yusa-d Ƹisa zi ṯmurṯ n Ljalil ɣar yiɣzar n Lʼurdun bac aṯ iṭehhar Yaḥya s waman. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Walakin Yaḥya yugi inna-as: "Nec itxeṣṣa cek iy ḏayi ɣa iṭehharen, u cek ṯusiḏ-d ɣari?"<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Indeq-d Ƹisa inna-as: "Ɣir qbeȓ ȓexxu, ḏ manaya ig iǧan nican ḥima aḏ ikemmeȓ marra min ixes Siḏi Arebbi." Uca iqbeȓ Yaḥya.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Wami itwaṭehhar Ƹisa iffeɣ-d ȓexddenni zeg waman nni. Aqa inurzem-as-d ujenna iẓra Arruḥ n Arebbi ihewwa-d igga am yijjen n ṯeḏbirṯ ṯmars-d xas. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Ssenni iȓaɣa-d ijjen n ṣṣut zeg ujenna inna-d: "Wa ḏ Memmi iƹizzen, nec farrḥeɣ zzayes."<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Ibȓis itjarrab Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Ssenni Arruḥ nni <char style="it">n Arebbi</char> yuwi Ƹisa ɣar ȓexȓa ḥima aṯ ijarreb Ibȓis. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Wami iẓumm Ƹisa arbeƹin yum jar ǧiyaȓi ḏ wussan yusa-as-d jjuƹ. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Ikkar wenni itjarraben iqarreb-d ɣar Ƹisa inna-as: "Meȓa cek ḏ Mmis n Arebbi, ini-yasen i yizra-ya aḏ ḏewȓen ḏ aɣrum."<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Indeq-d Ƹisa inna-as: "Lla, Lkitab iqqar: &lt;Bnaḏem war itƹic ca s uɣrum waha, itƹic s mkuȓ awaȓ ig iqqar Arebbi.&gt;"<note caller="+" style="f"><char style="fr" closed="false">4.4 </char><char style="ft" closed="false">Xzar Afessar n Ccariƹa n Musa (Deutéronome) 8:3. S ṯayunaniṯ, iƹni bnaḏem iddar s mkuȓ awaȓ iy d iteffɣen zeg uqemmum n Arebbi.</char></note><verse eid="MAT 4:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Ssenni Ibȓis yuwi Ƹisa ɣar ṯendint n Lquds, isiȓi-ṯ x ṯqiccat n ṯemziḏa ṯameqqrant. <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />Inna-as: "Cek meȓa ḏ Mmis n Arebbi ngez ssanita ɣar ṯmurṯ. Aqa Lkitab iqqar: &lt;Qa Arebbi aḏ iweṣṣa bac ac ḥḍant lmalaʼikaṯ nnes. Ac ysint x ifassen nsent bac war ṯeȓqifeḏ uȓa ḏ ij uzru s uḍar nnec.&gt;"<note caller="+" style="f"><char style="fr" closed="false">4.6 </char><char style="ft" closed="false">Xzar Zzabur (Psaumes) 91:11-12.</char></note><verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Inna-as Ƹisa: "Lla, Lkitab iqqar: &lt;War tjarrab ca Siḏi Arebbi nnec.&gt;"<note caller="+" style="f"><char style="fr" closed="false">4.7 </char><char style="ft" closed="false">Xzar Afessar n Ccariƹa n Musa (Deutéronome) 6:16.</char></note><verse eid="MAT 4:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Ssenni Ibȓis yuwi Ƹisa ɣar ṯqiccat n yijjen n uḏrar yuƹȓa aṭṭas. Ismeḍhar-as-d marra lmemlakaṯ n ddunect-a ḏ ṯuṣubḥant nsent. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Inna-as: "Aḏac uceɣ marra ṯina meȓa ṯewḍiḏ x ifadden nnec ṯsejjḏeḏ-ayi."<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Indeq-d Ƹisa inna-as: "Ruḥ, beƹƹeḏ-ayi a Cciṭan. Aqa Lkitab iqqar: &lt;Sejjeḏ i Siḏi Arebbi nnec, ƹbeḏ-iṯ netta waḥḏes.&gt;"<note caller="+" style="f"><char style="fr" closed="false">4.10 </char><char style="ft" closed="false">Xzar Afessar n Ccariƹa n Musa (Deutéronome) 6:13.</char></note><verse eid="MAT 4:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Ssenni ibeƹƹeḏ xas Ibȓis. Usint-id lmalaʼikaṯ bḏant tsexxarent x Ƹisa.<verse eid="MAT 4:11" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa itȓaɣa-d i imeḥḍaren nnes imezwura</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Wami isȓa Ƹisa belli Yaḥya aqa itwaḥebbes, iƹqeb <char style="it">ɣar Naṣira</char> ɣar ṯmurṯ n Ljalil. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Walakin war iqqim ca ḏi Naṣira, iruḥ aḏ izḏeɣ ḏeg yijjen n ubilaj qqaren-as Kafernaḥum ig iǧan x ṭṭarf n ȓebḥar n Ljalil, jjiheṯ n ṯmurṯ n Zafulun ḏ Naftali. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Amenni ikemmeȓ wawaȓ nni iy inna Siḏi Arebbi i nnabi umi qqaren Icaƹya ḏeg yijjen n zman:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />&lt;Ṯamurṯ n Zafulun ḏ ṯmurṯ n Naftali,</para>
  <para style="q2" vid="MAT 4:15">ṯinni umi qqaren ṯamurṯ n Ljalil,</para>
  <para style="q1" vid="MAT 4:15">x ubriḏ n ȓebḥar ḏi ccarq n yiɣzar n Lʼurdun,</para>
  <para style="q2" vid="MAT 4:15">mani iy zeddɣen uȓa ḏ yinni war iǧin zi Ayṯ-Israʼil.<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Ccaƹb-a iy izeddɣen ḏi ṯaǧest,</para>
  <para style="q2" vid="MAT 4:16">aḏ iẓer ṯfawṯ ḏ ṯameqqrant.</para>
  <para style="q1" vid="MAT 4:16">Yina izeddɣen ḏi ṯaǧest n ȓmewṯ</para>
  <para style="q2" vid="MAT 4:16">aḏasen d imeḍhar nnur.&gt;<note caller="+" style="f"><char style="fr" closed="false">4.16 </char><char style="ft" closed="false">Xzar Icaƹya (Esaïe) 9:1-2.</char></note><verse eid="MAT 4:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Zi ssenni ibḏa Ƹisa itbeccar iqqar-asen: "Tubeṯ, aqa yuḏes-d ȓmulk n ujenna."<verse eid="MAT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Iggur Ƹisa x cceṭṭ n ȓebḥar n Ljalil, yufa ḏinni ṯnayen n iḥeǧaqen n iseȓman niṯni ḏ awmaṯen. Ijjen qqaren-as Simƹan tȓaɣan-as s Buṭrus, akiḏes umas qqaren-as Andrus. Neṭṭaren ṯracca ḏi ȓebḥar. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Inna-asen Ƹisa: "Ḏfarem-ayi-d, aqa ȓexxu iy kenniw ɣa arreɣ ḏ iḥeǧaqen n yiwḏan." <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Ȓexddenni semḥen ḏi ṯracciwin nsen ḏfaren-ṯ.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Iƹḏu aɣiȓin, yufa ṯnayen n wawmaṯen nneɣni, ijjen qqaren-as Yaƹqub ijjen qqaren-as Yuḥanna. Niṯni ḏ ṯarwa n yijjen n uryaz umi qqaren Zabadi. Aqaṯen ḏi ṯɣarrabut ak babaṯsen ƹeddȓen ṯiracciwin nsen. Iȓaɣa-yasen-d Ƹisa, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />ḏeg umcan semḥen ḏi ṯɣarrabut nsen ḏ babaṯsen ḏfaren Ƹisa.<verse eid="MAT 4:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Iggur Ƹisa ḏi lʼiqlim n Ljalil marra, iseȓmaḏ ḏi ṯemziḏawin n Ayṯ-Israʼil itbeccar-iṯen s Lʼinjil n ȓmulk n Arebbi isgenfa marra ȓehȓacaṯ ḏ ddiƹan n ddat ḏeg yiwḏan. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Iffeɣ ȓexbar nnes ḏi Surya amen-ṯekmaȓ. Tawin-d ɣares marra yinni iheȓcen tƹeddaben s lʼanwaƹ n ȓehȓacaṯ ḏ ȓeḥȓiqaṯ, mkuȓ imaryaḥen ḏ imejnunen ḏ inecrufen netta isgenfa-ṯen. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Ḏfaren Ƹisa aṭṭas n ȓɣaci zi Ljalil ḏ lʼiqlim umi qqaren Dikaplis ḏ ṯendint n Lquds ḏ Yahuḏiya ḏ jjiheṯ n ccarq n yiɣzar n Lʼurdun.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Siḏiṯneɣ Ƹisa ḏ useȓmeḏ nnes ḏeg uḏrar</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Wami iẓra qaƹ ȓɣaci nni, yuȓi ɣar uḏrar iqqim usin-d ɣares imeḥḍaren nnes. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Ibḏa iseȓmaḏ-iṯen inna-asen:<verse eid="MAT 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 5:3" />"Ssaƹḏ nsen i yinni iǧan ḏ ȓmusakin ḏeg arruḥ nsen, aqa ȓmulk ujenna i niṯni.<verse eid="MAT 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 5:4" />Ssaƹḏ nsen i yinni itrun, aqa aḏ twacejjƹen.<verse eid="MAT 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 5:5" />Ssaƹḏ nsen i yinni iǧan ḏ drawec, aqa aḏ warṯen ddunect.<verse eid="MAT 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 5:6" />Ssaƹḏ nsen i yinni iǧuzen iffuḏen ɣar min iǧan nican, ȓaḥeqqac niṯni aḏ jjawnen.<verse eid="MAT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 5:7" />Ssaƹḏ nsen i yinni ireḥḥmen, aqa aṯen irḥem <char style="it">Arebbi</char> uȓa ḏ niṯni.<verse eid="MAT 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 5:8" />Ssaƹḏ nsen i yinni ɣar iǧa wuȓ ḏ acemȓaȓ, aqa aḏ ẓren Arebbi.<verse eid="MAT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 5:9" />Ssaƹḏ nsen i yinni iṣeǧḥen iwḏan, aqa niṯni aṯen semman amecnaw ṯarwa n Arebbi.<verse eid="MAT 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 5:10" />Ssaƹḏ nsen i yinni itwaƹeddaben x ssabab n min iǧan nican, aqa ȓmulk n ujenna i niṯni.<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />Ssaƹḏ nwem meȓa tzawaren-kenniw, ƹeddben-kenniw, niɣ nnan ḏaywem ȓƹib s ixarriqen x ssabab inu. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Ḍeḥceṯ, farḥeṯ. Aqa ɣarwem ijjen n lʼajar ḏ ameqqran ḏeg ujenna ȓaḥeqqac amenni iy twaƹeddben lʼanbiya tuɣa iǧan qbeȓ nwem.<verse eid="MAT 5:12" /></para>
  <para style="s">Ȓemȓeḥ ḏ ṯfawṯ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />Ḏ kenniw iy iǧan ḏ ȓemȓeḥ ṯaṣebḥant n ṯmurṯ. Walakin meȓa iruḥ-as lmaḏaq nnes, mamc ḏas ɣa negg aḏas ṯiḏ narr? Ataf war ṯṣeǧaḥ i walu, ɣir at nḍaren ɣar barra waha axas ƹeffsen yiwḏan. <verse eid="MAT 5:13" /><verse number="14" style="v" sid="MAT 5:14" />Kenniw ḏ ṯfawṯ n ddunect. Ijjen n ṯendint iy iǧan x uḏrar war ṯzemmar aḏ teqqim ṯnuffar. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Iwḏan war sreqqin ca ȓqendiȓ ḥima axas qeȓben aqnuc; Lla, teggen-ṯ x ȓmarfaƹ ḥima aḏasen yuc ṯfawṯ i marra ug iǧan ḏi ṯeddarṯ. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Ammu, jjeṯ ȓqendiȓ nwem iceƹƹeȓ i yiwḏan ḥima aḏ ẓren ȓexḏayem nwem ṯiṣebḥanin aḏ ḥemḏen Babaṯwem iǧan ḏeg ujenna.<verse eid="MAT 5:16" /></para>
  <para style="s">Ccariƹa</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />War tfekkareṯ ca belli usiɣ-d bac aḏ qḍiɣ x Ccariƹa n Musa niɣ x min nnan lʼanbiya; Lla, war d usiɣ ca axasen qḍiɣ, usiɣ-d bac aḏ kemmȓeɣ x wawaȓ nsen. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Aqa tesȓam ȓḥaqq: War itekkes ijjen n ȓḥarf niɣ ḏ ijjen n ṯneqqiṭ zi ccariƹa aȓ ɣa itwakkes ujenna ḏ ṯmurṯ aȓ ɣa itwakemmeȓ kuȓci. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Marra uw ɣa iḥarfen ijjen n ȓuṣiyeṯ ḏ ṯamezyant zi ccariƹa, ssenni aḏ iseȓmeḏ i yiwḏan x min itegg netta, ataf aḏ yiȓi ḏ amezyan s waṭṭas ḏi ȓmulk ujenna. Walakin wenni ɣa iṭaƹen i ccariƹa igga zzayes, ssenni aḏ iseȓmeḏ i yiwḏan aḏ ggen am netta, ataf aḏ yiȓi ḏ ameqqran s waṭṭas ḏi ȓmulk ujenna. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Aqa qqareɣ-awem: Meȓa war ṯṭiƹim ca i min iqqar Arebbi ktar zi min teggen imseȓmaḏen n ccariƹa ḏ ȓḥizeb n ifarrisiyen, ataf ƹemmarṣ aḏ taḏfem ȓmulk ujenna.<verse eid="MAT 5:20" /></para>
  <para style="s">Aƹeṣṣeb</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />Aqa ṯesȓim <char style="it">ḏi Lkitab</char> belli itwanna-yasen i ȓejḏuḏ nwem: War neqq ca, aqa marra wenni iy ɣa inɣen ḥadd ataf aḏ itwaḥkem. <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Walakin nec qqareɣ-awem: Marra uw ɣa iƹaṣben x wumas ataf aḏ itwaḥkem. Wenni ɣa yinin i wumas: Ay aɣyuȓ, ataf aḏ itwaḥkem ḏi lmaḥkama ṯameqqrant. Ḏ wenni ɣa yinin i wumas: Ay afɣuȓ, ataf isḏaheǧ aḏ iraḥ ɣar ṯmessi n jahennama.<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />Meȓa ṯruḥeḏ aḏ tqeddmeḏ dbiḥeṯ i Arebbi uca ṯfekkareḏ ijjen n wumac ixeyyeq xac, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />ejj dbiḥeṯ nni ḏinni ɣar ȓmeḏbaḥ, ruḥ ḏ amezwaru aḏ tṣeȓḥeḏ ak wumac. Ƹaḏ iy d ɣa ṯḏewȓeḏ aḏ tqeddmeḏ dbiḥeṯ nnec i Arebbi.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />Meȓa ithem-icek ca ḥadd menbaƹd uwin-ac-d lʼistidƹa ḥima akiḏes ṯraḥeḏ ɣar lmaḥkama, ƹḏeȓ akiḏes ḏeɣya ḏeg ubriḏ bac war c isiwwiḍ ca ɣar ȓqaḍi, ȓqaḍi nni aḏ iʼamar amxazni, amxazni nni ac inḍar ḏi ȓeḥbes. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Aqa tesȓiḏ ȓḥaqq: War ssenni d teffɣeḏ ca aȓ ɣa ṯxeǧseḏ ṣuldi aneggaru.<verse eid="MAT 5:26" /></para>
  <para style="s">Azna</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />Ṯesȓim <char style="it">ḏi Lkitab</char> belli itwanna ḏeg yijjen n zman: War zenna ca. <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Walakin nec qqareɣ-awem: Marra wenni ixezzaren ɣar can ṯemɣarṯ s wuȓ nnes, ataf itwaḥsab izna. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Meȓa ṯiṭṭ nnec ṯafusiṯ tsebbab-ac ḏi can ȓefḍiḥeṯ, qȓeƹ-it zaƹma nḍar-it xak. Ḥsen i cek aḏ texsareḏ ijjen n ṭṭarf zi ddat nnec zi meȓa ṯmenḍar ddat nnec amen-ṯekmaȓ ḏi jahennama. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Meȓa fus nnec afusi itsebbab-ac ḏi can ȓefḍiḥeṯ, qess-iṯ zaƹma nḍar-iṯ xak. Ḥsen i cek aḏ texsareḏ ijjen n ṭṭarf zi ddat nnec zi meȓa ṯruḥ ddat nnec amen-ṯekmaȓ ḏi jahennama.<verse eid="MAT 5:30" /></para>
  <para style="s">Aǧaf</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />Aqa itwanna ḏeg yijjen n zman <char style="it">ḏi Lkitab</char> ƹaweḏ: Wenni ɣa iǧfen i ṯemɣarṯ nnes, ataf aḏas yuc ṯabrat nnes. <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Walakin nec qqareɣ-awem: Marra wenni ɣa iǧfen i ṯemɣarṯ nnes, nettaṯ war ṯezni ca, ataf itarra-t ṯezna <char style="it">iƹni meȓa ṯƹaweḏ ȓemȓac</char>. Wenni iy ɣa imeȓcen ak ṯenni iǧfen, ataf izna.<verse eid="MAT 5:32" /></para>
  <para style="s">Ṯijaǧiṯ</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />Aqa ṯesȓim <char style="it">ḏi Lkitab</char> ƹaweḏ belli itwanna i ȓejḏuḏ nwem: Qa war txalaf bu ṯjaǧiṯ nnec, kemmeȓ ṯjaǧiṯ nnec iy ṯejjuǧeḏ zzaṯ i Siḏi Arebbi.<note caller="+" style="f"><char style="fr" closed="false">5.33 </char><char style="ft" closed="false">Xzar Lƹadad (Nombres) 30:2.</char></note> <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Walakin nec qqareɣ-awem: War tjaǧam ca ƹemmarṣ: waxxa s ujenna ȓaḥeqqac netta ḏ lƹarc n Arebbi; <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />uȓa s ṯmurṯ ȓaḥeqqac xas itmarsen iḍaren nnes; waxxa s ṯendint n Lquds ȓaḥeqqac nettaṯ ḏ ṯandint n Uzeǧiḏ ameqqran. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />War tjaǧa bu s uzeǧif nnec, ȓaḥeqqac war ṯzemmareḏ ca aḏ tarreḏ can n uzuṭṭu ḏ acemȓaȓ niɣ ḏ abercan. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Aḏ yiȓi wawaȓ nwem wah niɣ lla. Marra min ɣa ṯinim ḏ zzyada, ataf aẓwer nnes zi Cciṭan.<verse eid="MAT 5:37" /></para>
  <para style="s">Xseṯ ȓƹaḏyan nwem</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />Aqa ṯesȓim <char style="it">ḏi Lkitab</char> min itwannan ḏeg yijjen n zman: Wenni ɣa ikksen ṯiṭṭ i can yijjen, ataf aḏas kksen ṯiṭṭ. Wenni ɣa ikksen ṯiɣmest i can yijjen, ataf aḏas kksen ṯiɣmest. <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Walakin nec qqareɣ-awem: War tƹarraḍem ca i wenni iǧan ḏ aƹeffan. Wenni c ɣa iseqqȓen ɣar uɣembub jjiheṯ ṯafusiṯ ḏewwaȓ-as jjiheṯ nneɣni. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Wenni ixsen ac yawi ɣar craƹ ḥima aḏac yawi ṯaqmijat, uc-as uȓa ḏ azeǧab nnec. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Meȓa can yijjen zi ȓmexzen igga xak bezzez aḏ teysiḏ ȓeḥmeȓ ijjen n kilumit, ysi-ṯ cek ṯnayen kilumit. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Wenni ḏac ɣa ittaren <char style="it">can ṯmesȓayṯ</char>, uc-as-t. Wenni d ɣa yasen ɣarek irezzu aḏ irḍeȓ war ṯ tarra ca ixwa.<verse eid="MAT 5:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />Aqa ṯesȓim <char style="it">ḏi Lkitab</char> min itwannan ḏeg yijjen n zman: Aḏ texseḏ ajjar nnec, aḏ tƹiffeḏ ȓaƹḏu nnec. <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Walakin qqareɣ-awem nec: Xseṯ ȓƹaḏyan nwem, ttareṯ i Arebbi x yinni kenniw itƹeddaben, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />ḥima aḏ tiȓim ḏ ṯarwa n Babaṯwem iy iǧan ḏeg ujenna. Ȓaḥeqqac itsummur-d ṯfuct x yinni iṣebḥanen ḏ yinni iƹeffanen. Iticc anẓar i yinni iteggen ȓxir ḏ yinni iteggen ccarr. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Meȓa kenniw texsem ɣir yinni iy kenniw itexsen, man lʼajar iy ɣarwem kenniw? Ma war iǧi amenni iy teggen uȓa ḏ iƹeccaren?<note caller="+" style="f"><char style="fr" closed="false">5.46 </char><char style="ft" closed="false">Iƹeccaren niṯni ḏ israʼiliyen xeddmen ak lmexzen n arrumanus jemmƹen ȓaƹcur. Israʼiliyen nneɣni qqaren iƹeccaren ƹlaḥsab min teggen ƹeṣṣan aṭṭas. Ƹaweḏ azyen ameqqran n iƹeccaren arennin ci ḥaja ḥima aṯent ysin i yixef nsen.</char></note> <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Meȓa tseǧamem ɣir x imeddukaȓ nwem, iwa min teggem ḏ zzyada? Aqa uȓa ḏ ȓkuffar teggen manaya! <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Iȓiṯ nican qaƹ, amecnaw mamc iǧa Babaṯwem ḏeg ujenna.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">Ṣṣaḏaqa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />Ɣarwem aḏ teggem ȓxir zzaṯ i yiwḏan ḥima akenniw ẓren, ataf war ɣarwem itiȓi bu lʼajar zi Babaṯwem iǧan ḏeg ujenna. <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />Ƹlaḥsab manaya, xmi ɣa ṯṣeddqeḏ i can n yijjen, war zzayes tberraḥ ca ḏi ȓbuq amecnaw mammec teggen lmunafiqin ḏi ṯemziḏawin ḏ znaqi bac azzaysen semɣaren yiwḏan. Aqa tesȓam ȓḥaqq: War ɣarsen itiȓi bu lʼajar. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Walakin cek xmi ɣa ṯṣeddqeḏ i can n yijjen, itxeṣṣa fus nnec aẓeȓmaḍ war itessen min iticc fus afusi nnec. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Ḥima ṣṣaḏaqa nnec aḏ twagg s ṯnufra. Ḏ Babac <char style="it">Arebbi</char> ig iẓerren min itwaggen s ṯnufra ataf aḏac yuc lʼajar.<verse eid="MAT 6:4" /></para>
  <para style="s">Ṯẓaǧiṯ</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />Xmi ɣa ṯeẓẓaǧem, war tiȓim ca am lmunafiqin iy texsen aḏ ẓẓaǧen amen bedden ḏi ṯemziḏawin ḏ ṯɣemmura n znaqi ḥima aṯen ẓren yiwḏan. Aqa tesȓam ȓḥaqq: War ɣarsen itiȓi bu lʼajar. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Walakin cek xmi ɣa ṯeẓẓaǧeḏ, aḏef ɣar uxxam nnec qqen xak ṯawwarṯ, ẓẓaǧ i Babac iǧan mani war ṯ itwiȓi ḥadd. Babac ig iẓerren min itwaggen s ṯnufra ataf ac ijaza.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />War tẓaǧam ca s wawaȓen war ɣarsen bu ȓmaƹna amecnaw mammec teggen ȓegnus. Ḥessben meȓa qqaren awaȓen aṭṭas, ataf Arebbi aḏasen istajeb. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Lla, war teggem ca am niṯni ȓaḥeqqac Arebbi issen min ṯeḥḏajem qbeȓ ma ḏas t ṯettarem. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />Ha mammec iy ɣa ṯeẓẓaǧem:</para>
  <para style="q1" vid="MAT 6:9">
    <char style="bd">A Babaṯneɣ iǧan ḏeg ujenna, </char></para>
  <para style="q1" vid="MAT 6:9">
    <char style="bd">ḏ ameqqran ig iǧa yisem nnec. </char><verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />
    <char style="bd">Aḏ d yas ȓmulk nnec, </char></para>
  <para style="q1" vid="MAT 6:10">
    <char style="bd">aḏ ggen ȓxaḍar nnec ḏi ṯmurṯ, </char></para>
  <para style="q1" vid="MAT 6:10">
    <char style="bd">mamc teggen ḏeg ujenna. </char><verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />
    <char style="bd">Uc-aneɣ kuȓ nhar aɣrum iy ɣa neḥḏaj. </char><verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />
    <char style="bd">Ɣfar-aneɣ ȓmuƹṣiyaṯ nneɣ i neccin, </char></para>
  <para style="q1" vid="MAT 6:12">
    <char style="bd">mammec nsemmeḥ i yinni iy kiḏneɣ ixeṭṭan. </char><verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />
    <char style="bd">War ḏaneɣ tegg ca ḏi ȓemḥayen, </char></para>
  <para style="q1" vid="MAT 6:13">
    <char style="bd">senjem-aneɣ zi ccarr. </char></para>
  <para style="q1" vid="MAT 6:13">
    <char style="bd">{Ȓaḥeqqac ȓmulk iǧan nnec, ḏ ṯizemmar, </char></para>
  <para style="q1" vid="MAT 6:13">
    <char style="bd">ḏ lƹaḍama i cek i ȓebda. Amin.} </char><verse eid="MAT 6:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />Meȓa ṯsemmḥem i yiwḏan ḏeg uxeṭṭi nni iy kiḏwem ixeṭṭan, ataf Babaṯwem iǧan ḏeg ujenna uȓa ḏ netta aḏawem iɣfar. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Meȓa war ṯsemmḥem ca i yiwḏan ḏeg uxeṭṭi nni iy kiḏwem ixeṭṭan, ataf Babaṯwem uȓa ḏ netta war ḏawem iɣeffar ca x ddnub nwem.<verse eid="MAT 6:15" /></para>
  <para style="s">Aẓummi</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />Xmi ɣa ṯẓummem, war teggem ca amecnaw mammec teggen lmunafiqin. Txeyyaqen ḥima marra iwḏan aṯen ssnen belli ẓummen. Aqa tesȓam ȓḥaqq: Ataf war ɣarsen itiȓi bu lʼajar. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Walakin cek xmi ɣa ṯẓummeḏ, sireḏ aɣembub nnec mceḍ acewwaf nnec, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />ḥima iwḏan war tessnen ca qa cek ṯẓummeḏ. Walakin Siḏi Arebbi iy iǧan mani war ṯ itwiȓi ḥadd, netta ig issnen. U Siḏi Arebbi ig iẓerren min itwaggen s ṯnufra ataf ac ijaza.<verse eid="MAT 6:18" /></para>
  <para style="s">War kessim ca amnus</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />War snuffureṯ ca ȓkenz nwem ḏi ddunect-a mani yarecca tettent-ṯ ṯkeccawin ḏ mani ǧan iceffaren ccaṯen nqabeṯ<note caller="+" style="f"><char style="fr" closed="false">6.19 </char><char style="ft" closed="false">Ccaṯen nqabeṯ, iƹni snuqquben ȓḥiḍ ḥima aḏ aḏfen aȓ ḏaxeȓ i ṯeddarṯ.</char></note> tacaren-ṯ. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Walakin snuffareṯ ȓkenz nwem ḏeg ujenna mani war yarecci ca war ṯ tettent ca ṯkeccawin ḏ mani war ǧin ca iceffaren ccaṯen nqabeṯ tacaren-ṯ. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Aqa mani iǧa ȓkenz nnec, ḏinni iy ɣa yiȓi wuȓ nnec.<verse eid="MAT 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />Ṯiṭṭawin am ṯfawṯ i ṯuḏarṯ nnec. Meȓa ɣarek ṯiṭṭawin ṣeḥḥant, ataf aɣarek ṯiȓi ṯfawṯ marra ḏi ṯuḏarṯ nnec. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Walakin meȓa ṯiṭṭawin nnec war ǧint ca mliḥ, ataf marra ṯuḏarṯ nnec aḏayes ṯiȓi ṯaǧest. Meȓa ṯfawṯ iy ḏayec ṯeḏwer ḏ ṯaǧest, cḥaȓ ḏ ṯubbarcent iy tiȓi ḏ ṯaǧest nni iy ḏayec.<verse eid="MAT 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />War izemmar can yijjen aḏ yiȓi ḏ axeddam ɣar ṯnayen n siyaḏis. Mayemmi? Ima ijjen aṯ iƹiff, ijjen aṯ ixes. Niɣ ijjen aḏayes iṭṭef, ijjen aṯ iḥeggar. Aḏ txeḏmem i Arebbi niɣ aḏ txeḏmem i ȓewsex n ddunect-a, war iǧi bu s ṯnayen.<verse eid="MAT 6:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />X manaya aḏawem iniɣ: War kessim ca s umnus i ṯuḏarṯ nwem ƹlaḥsab min ɣa ṯeccem niɣ ḏ min ɣa ṯeswem niɣ ḏ arruḍ iy ɣa ṯeḥḏajem i ddat nwem. Minzi ṯuḏarṯ-a tseggwa ktar zi macca. Ddat-a tseggwa ktar zeg warruḍ. <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Xzareṯ mliḥ ɣar yijḍaḍ ujenna. War zerrƹen, war mejjaren, war xezznen ḏi ṯesȓafin. Walakin Babaṯwem iy iǧan ḏeg ujenna iy ḏasen iticcen aḏ ccen. Kenniw, ma war tseggwim ca aṭṭas s waṭṭas x yijḍaḍ? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Ug izemmaren zzaywem aḏ yarni s umnus nnes ɣir ṯsaƹƹat waha ḏi ȓƹumur nnes?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />Mayemmi ṯkessim amnus i warruḍ? Xzareṯ ḏi nwar n ȓexȓa mammec igga, war yarebbeȓ war itxeyyiḍ. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Qqareɣ-awem nec: Uȓa ḏ azeǧiḏ Suliman mecḥaȓ ɣares ḏ agȓa war izemmar ca aḏ yareḍ ca n warruḍ igga am nwar-a wanita. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Meȓa Arebbi iticc arruḍ zaƹma i arbiƹ n ȓexȓa ig iǧan nhara aḏ iḥareq ṯiwecca ḏeg ufarran, ma war itegg akiḏwem kenniw ktar? Ḏaywem lʼiman nwem ḏ uqlil. <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />War kessiṯ bu s umnus aḏ tinim, min ɣa necc? Niɣ ḏ min ɣa nsew? Niɣ ḏ min ɣa nareḍ ḏ arruḍ? <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Marra manaya rezzun-ṯ ȓegnus. Aqa Babaṯwem iǧan ḏeg ujenna issen belli teḥḏajim ṯimesȓayin-a. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Rezzuṯ ḏ amezwaru x ȓmulk n Arebbi ḏ ṯuḏarṯ ig iǧan nican, ssenni ṯimesȓayin-a marra aḏawem marnint. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />War kessiṯ bu s umnus i min ɣa iweqƹen ṯiwecca, aqa ṯiwecca aḏ iysi nniṯ s umnus i yixef nnes. Ȓhemm iy d imeḍehharen nhar nni aḏ ikfa nhar nni.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">War tƹeyyabeṯ bu yiwḏan</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />War tƹeyyabem ḥadd ḥima war kenniw itƹeyyib ca Arebbi. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Mammec ɣa ṯƹeyybem amenni i kenniw iy ɣa iƹeyyeb Arebbi. Ȓaƹbar nni iy ṯsexḏamem ḏ wenni iy kiḏwem ɣa isexḏem Arebbi. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />Mayemmi tseḥqareḏ cwayt n uȓum ig iǧan ḏi ṯiṭṭ n wumac, cek tettuḏ akeccuḍ ig iǧan ḏi ṯiṭṭ nnec? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Mammec teggeḏ ṯzeƹƹmeḏ aḏ tiniḏ i wumac: Ejj-ayi aḏac d kkseɣ ȓum-a ig iǧan ḏi ṯiṭṭ nnec, cek <char style="it">ƹaḏ</char> tejjiḏ akeccuḍ ḏi ṯiṭṭ nnec? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />A lmunafiq, kkes ḏ amezwaru akeccuḍ zi ṯiṭṭ nnec. Ƹaḏ iy ɣa ṯetwaȓiḏ mliḥ ḥima aḏ tekkseḏ ȓum zi ṯiṭṭ n wumac. <verse eid="MAT 7:5" /><verse number="6" style="v" sid="MAT 7:6" />War ticceṯ ca min iqeddsen n Arebbi i iqzinen ḥima war ɣarwem d teƹqiben akenniw mezzqen. War neṭṭareṯ ca jjuwhar nwem zzaṯ i yiȓfan ḥima war xasen ƹeffsen ca.<verse eid="MAT 7:6" /></para>
  <para style="s">Ṯẓaǧiṯ iy ɣa istajben</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />Ttarem, ataf aḏawem immuc. Rezzum, ataf aḏ tafem. Sqerqubem, ataf aḏawem rezmen. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Minzi marra wenni ɣa ittaren aḏas immuc. Wenni ɣa irzun aḏ yaf. Wenni ɣa isqerqben aḏas ṯnurzem ṯewwarṯ. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />Meȓa can yijjen zzaywem ittar-as mmis aɣrum, ma aḏas yuc azru ḏeg umcan n uɣrum nni? Lla! <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Meȓa ittar-as asȓem, ma aḏas yuc fiɣer? Lla! <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Meȓa kenniw ḏ iƹeffanen ṯessnem aḏ tucem i ṯarwa nwem min iǧan ḏ aṣebḥan, ataf Babaṯwem ig iǧan ḏeg ujenna itegg ktar. Iticc min iǧan ḏ aṣebḥan i yinni ḏas ṯ itettaren.<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />Ggeṯ i yiwḏan min ṯexsem aḏawem ggen. Manaya ḏ ȓmaƹna n Ccariƹa n Musa ḏ ttaƹalim n lʼanbiya.<verse eid="MAT 7:12" /></para>
  <para style="s">Ṯawwarṯ n ṯuḏarṯ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />Aḏfeṯ zi ṯewwarṯ iḥṣaren minzi ṯawwarṯ nni itawin ɣar jahennama ṯiriw aṭṭas, abriḏ nnes isheȓ. Aṭṭas iy zzayes iƹeddun. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Walakin ṯawwarṯ iḥṣaren ḏ ubriḏ iqesḥen niṯni tawin ɣar ṯuḏarṯ. Ḏrus iy ɣa iƹḏun ssenni.<verse eid="MAT 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />Ḥḍam ixef nwem zeg yinni itarran ixef nsen ḏ lʼanbiya. Tasen-d ɣarwem am can n iḥuȓiyen walakin ḏeg wuȓawen nsen ḏ uccanen iwƹaren. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Aṯen ṯessnem s ȓefƹayeȓ nsen. Ma zemmaren yiwḏan aḏ ȓeqḏen ṯazarṯ zeg isennanen, niɣ aḏ kksen aḍiȓ zi ṯzeggwarṯ? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Ṯacejjarṯ ṯaṣebḥant tarew min iǧan ḏ aṣebḥan. Ṯacejjarṯ ṯaƹeffant tarew min iǧan ḏ aƹeffan. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Ṯacejjarṯ ṯaṣebḥant war tirew ca min iǧan ḏ aƹeffan. Ṯenni ṯaƹeffant war tirew ca min iǧan ḏ aṣebḥan. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Marra ṯacejjarṯ iy war itirwen ca min iǧan ḏ aṣebḥan aḏ twaqess aḏ tmenḍar ḏi ṯmessi. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Ammu s ȓefƹayeȓ nsen iy ɣa ṯessnem <char style="it">yinni itarran ixef nsen ḏ l'anbiya</char>.<verse eid="MAT 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />Maci marra yinni iy ḏayi iqqaren a Siḏi a Siḏi aḏ aḏfen ɣar ȓmulk ujenna; Lla, war ṯ tiḏfen ca illa yinni iteggen min ixes Baba ig iǧan ḏeg ujenna. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Ḏi Yum Lḥisab ḏ Lƹiqab aṭṭas iy ḏayi ɣa inin: A Siḏi a Siḏi, yak s <char style="it">lḥikma n</char> yisem nnec iy zi tuɣa nseȓmaḏ i yiwḏan? Yak s <char style="it">lḥikma n</char> yisem nnec iy zi tuɣa nsufuɣ jnun? Yak s <char style="it">lḥikma n</char> yisem nnec iy zi tuɣa ntegg ȓaƹjayeb? <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Ȓexddenni aḏasen iniɣ: Tuɣayi nec ƹemmarṣ war kenniw ssineɣ ca. Beƹƹḏeṯ xafi a yinni iteggen ccarr!<verse eid="MAT 7:23" /></para>
  <para style="s">Ȓebni n ṣṣaḥ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />Marra wenni itsȓan i wawaȓ inu ixeddem zzayes, netta am yijjen n bnaḏem ḏ amiɣis ibna ṯaddarṯ nnes x uzru. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Yuwṯa unẓar, ḥemȓen-d iɣezran, iṣuḍ-d arriḥ ijheḏ iƹḏu x ṯeddarṯ nni. Waxxa amenni war ṯewḍi ca ȓaḥeqqac ṯebna x dsas n uzru. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Marra wenni itsȓan i wawaȓ inu war zzayes ixeddem ca, netta am yijjen n ufɣuȓ ibna ṯaddarṯ nnes x yijḏi. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Yuwṯa unẓar, ḥemȓen-d iɣezran, iṣuḍ-d arriḥ ijheḏ iƹḏu x ṯeddarṯ nni. Ȓexddenni ṯewḍa, ṯeqqim ḏ ȓxirbeṯ."<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Wami ikemmeȓ Ƹisa awaȓ nnes, tƹejjben ȓɣaci zeg useȓmeḏ nnes <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />minzi ɣares ssulṭa iy zi iseȓmaḏ, war iǧi bu amecnaw imseȓmaḏen nsen n ccariƹa.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Siḏiṯneɣ Ƹisa isgenfa ij umehȓuc ihȓec s jḏam</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Wami d ihwa Ƹisa zeg uḏrar nni ḏfaren-ṯ aṭṭas n ȓɣaci. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Iqarreb-d ɣares ijjen ḏayes jḏam, isejjeḏ-as inna-as: "A Siḏi, cek meȓa ṯexseḏ ṯzemmareḏ aḏayi ṯessiṣfiḏ."<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Isers xas Ƹisa fus nnes iḥaḏa-ṯ inna-as: "Wah nec xseɣ, cek qa ṯgenfiḏ." Ṣafi ḏeg umcan igenfa umehȓuc nni zi jḏam nnes. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Inna-as Ƹisa: "Xzar, war txebbar ḥadd." Inna-as: "Ruḥ ɣar ȓefqi seḍhar-as ixef nnec. Egg ṣṣeḏqeṯ nni iy zi iweṣṣa Musa ḥima aɣarsen ṯiȓi chaḏeṯ x min iweqƹen."<verse eid="MAT 8:4" /></para>
  <para style="s">Lʼiman n yijjen n uƹaskari ḏ ameqqran n arrumanus</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Wami yuḏef Ƹisa ɣar ubilaj n Kafernaḥum, yusa-d ɣares ijjen n uƹaskari ḏ ameqqran n arrumanus. Iṭaleb-iṯ <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />inna-as: "A Siḏi, aqa ɣari axeddam inu ḏ anecruf ḏi ṯeddarṯ itnezbar aṭṭas ḏi ṯassuṯ."<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Inna-as Ƹisa: "Aḏ raḥeɣ aṯ sgenfiɣ."<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Indeq-d uƹaskari nni ameqqran inna-as: "Lla a Siḏi, nec war sḏihiǧeɣ ca aḏ taḏfeḏ ɣar ṯeddarṯ inu. Ini ɣir ijjen n wawaȓ u ṣafi ataf aḏ igenfa uxeddam inu. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Uȓa ḏ nec s yixef inu ɣari yinni xafi iḥekkmen. Ɣari ȓƹaskar x ufus inu ḥekkmeɣ xasen. Aḏ iniɣ i yijjen: Ruḥ, aḏ iraḥ. Aḏ iniɣ i yijjen: Araḥ-d, aḏ d yas. Aḏ iniɣ i uxeddam inu: Egg ṯa, at igg."<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Wami isȓa Ƹisa i manayenni itƹejjeb aṭṭas. Inna-asen i yinni ṯ iḏfaren: "Aqa tesȓam ȓḥaqq: Yinni iǧan zi Ayṯ-Israʼil war ḏaysen ufiɣ bu lʼiman imɣar aṭṭas am wanita! <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Aqa qqareɣ-awem: Aḏ d asen aṭṭas n yiwḏan zi ccarq ḏ ȓɣarb aḏ qqimen ak Brahim ḏ Isḥaq ḏ Yaƹqub ɣar missa ḏi ȓmulk ujenna. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Walakin yinni tuɣa itxeṣṣa aḏ warṯen ȓmulk n Arebbi, ataf aḏ menḍaren ɣar barra ḏi ṯaǧest mani ɣa iȓin imeṭṭawen ḏ uɣeẓẓaẓ n ṯeɣmas."<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Inna-as Ƹisa i uƹaskari nni: "Ruḥ! Aɣarec yiȓi anect min ṯumneḏ." Ȓexddenni igenfa uxeddam nni.<verse eid="MAT 8:13" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa isgenfa ṯaḏeggwaȓṯ n Buṭrus</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Wami yuḏef Ƹisa ɣar ṯeddarṯ n Buṭrus, yufa ṯaḏeggwaȓṯ n Buṭrus ḏi ṯassuṯ ḏayes ṯimessi. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Ɣir iḥaḏa-t s ufus ṯruḥ xas ṯmessi, ṯekkar ṯebḏa tsexxar xas.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Wami ṯeɣȓi ṯfuct ɣar ṯmeddiṯ, uwin-d ɣar Ƹisa aṭṭas n yinni ḏi ǧan jnun. S lʼamar nnes isufuɣ zzaysen jnun isgenfa marra yinni iheȓcen. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Manayenni ḥima aḏ ikemmeȓ wawaȓ iy inna Siḏi Arebbi i nnabi Icaƹya ḏeg yijjen n zman: "Iysi xaneɣ ȓeḥriqaṯ nneɣ, yarbu ȓehȓacaṯ nneɣ."<note caller="+" style="f"><char style="fr" closed="false">8.17 </char><char style="ft" closed="false">Xzar Icaƹya (Esaïe) 53:4.</char></note><verse eid="MAT 8:17" /></para>
  <para style="s">Yinni iḏeffaren Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Wami iẓra Ƹisa aṭṭas n yiwḏan iy ḏas d innḍen, ikkar yumar imeḥḍaren nnes inna-asen: Yallah a neẓwam ɣar ujemmaḍ-in.<verse eid="MAT 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 8:19" />Iqarreb-d ɣares ijjen n umseȓmaḏ n ccariƹa inna-as: "A Lmuƹallim, nec ac ḏfareɣ mani ma ṯruḥeḏ."<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Inna-as Ƹisa: "Uccanen ɣarsen ifran nsen, ijḍaḍ ɣarsen ȓaƹwac nsen, walakin Mmis n bnaḏem war ɣares uȓa ḏ mani ɣa isummeṯ azeǧif nnes."<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Ƹaweḏ inna-as ij umeḥḍar nnes: "A Siḏi, sameḥ-ayi ḏ amezwaru aḏ raḥeɣ aḏ neḍȓeɣ baba."<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Inna-as Ƹisa: "Ḏfar-ayi-d." Inna-as: "Yinni immuṯen ejj-iṯen aḏ neḍȓen imettinen nsen."<verse eid="MAT 8:22" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa ihedden ȓebḥar</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Inya Ƹisa ḏi ṯɣarrabut, ḏfaren-ṯ imeḥḍaren nnes. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Bȓa ȓexbar, ṯekkar-d ijjen n lƹaṣifa ṯejheḏ aṭṭas ḏi ȓebḥar ṯebḏa ṯɣarrabut tƹemmar s waman. Ƹisa netta tuɣaṯ iṭṭeṣ. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Qarrben ɣares imeḥḍaren, sfaqen-ṯ nnan-as: "A Siḏi, nejja-yaneɣ aqa neccin netmetta!"<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Inna-asen Ƹisa: "Mayemmi teggwḏem qaƹ ammu? Lʼiman nwem ḏ uqlil." Ȓexddenni ikkar isbedd arriḥ ḏ ȓemwaj, yarsa ȓḥaȓ. <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />Qqimen iryazen nni tƹejjben ḏayes nnan: "Min iƹna wanitan? Uȓa ḏ arriḥ ḏ ȓebḥar tṭaƹan-as!"<verse eid="MAT 8:27" /></para>
  <para style="s">Ṯnayen ḏaysen jnun ḏi ṯmurṯ n ijariṯiyen</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Wami yuweḍ Ƹisa ɣar ujemmaḍ-in n ȓebḥar ɣar ṯmurṯ n ijariṯiyen, ȓqan-ṯ-iḏ ṯnayen n yiwḏan ḏaysen jnun ffɣen-d zeg imeḍȓan <char style="it">mani zeddɣen</char>. Qesḥen, ccaṯen, war izemmar ḥadd axasen ikk x ubriḏ nni. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Ƹeyyḍen nnan-as: "Min ṯexseḏ zzayneɣ a Mmis n Arebbi? Ma ṯusiḏ-d aḏaneɣ ṯƹeddbeḏ qbeȓ i ȓweqṯ?"<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Ɣar ȓeggwaj cwayt, ḏinni ijjen n ṯḥimerṯ ḏ ṯameqqrant n yiȓfan ṯarwes.<note caller="+" style="f"><char style="fr" closed="false">8.30 </char><char style="ft" closed="false">Iȓfan niṯni ḏ lxanazir niɣ iḥellufen.</char></note> <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Jnun nni ttaren zi Ƹisa nnan-as: "Meȓa ṯsufɣeḏ-aneɣ, sekk-aneɣ ɣar ṯḥimerṯ-in n yiȓfan ḥima aḏaysen naḏef." <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />Inna-asen Ƹisa <char style="it">i jnun nni</char>: "Ruḥem!" Ȓexddenni ffɣen <char style="it">zi ṯnayen nni n yiwḏan</char> uḏfen ḏeg yiȓfan. Ṯehwa ṯḥimerṯ nni marra ḏi ṯeysarṯ ɣar ȓebḥar mmuṯen ḏeg waman. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Yinni yarewsen arewȓen ruḥen ɣar ubilaj, sufɣen ȓexbar ḏinni x marra min iweqƹen ḏ min iweqƹen i yiwḏan nni ḏi ǧan jnun. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Ȓexddenni ffɣen-d marra iwḏan n ubilaj bac aḏ raḥen aḏ ȓqan Ƹisa. Wami ṯ ẓrin, ḥeccmen-ṯ ḥima axasen ibeƹƹeḏ zi jjiheṯ nsen.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">Siḏiṯneɣ Ƹisa isgenfa ijjen n unecruf</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Inya Ƹisa ḏi ṯɣarrabut, iqḍeƹ ȓebḥar irewweḥ ɣar dcar nnes. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Ḏinni can yiwḏan uwin-d ɣares ijjen n uryaz mmuṯen-as iḍaren, izzeȓ ḏi ṯassuṯ nnes. Wami Ƹisa iẓra lʼiman iy ḏaysen inna-as i unecruf nni: "War teggweḏ ca a mmi, qa twaɣfarent-ac ȓmuƹṣiyaṯ nnec." <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />Ḏinni can imseȓmaḏen n ccariƹa qqaren ḏeg wuȓawen nsen: "Bnaḏem-a iqqar awaȓ war iḥȓin x Arebbi."<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Ƹisa issen min tfekkaren ḏi ȓaƹquȓaṯ nsen inna-asen: "Mayemmi tfekkarem ammu ḏi min war iḥȓin? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Min isehȓen aṭṭas aḏas iniɣ <char style="it">i unecruf-a</char>, ma aḏas iniɣ: Twaɣfarent-ac ȓmuƹṣiyaṯ nnec? Niɣ ma aḏas iniɣ: Kkar cek uyur? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Nec xseɣ aḏ tessnem belli Mmis n bnaḏem ɣares ssulṭa x ṯmurṯ ḥima aḏ iɣfar ȓmuƹṣiyaṯ." Uca inna-as i unecruf nni: "Kkar, ysi ṯassuṯ nnec, ruḥ aḏ trewwḥeḏ ɣar ṯeddarṯ nnec!" <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Ikkar uryaz nni irewweḥ. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Wami ẓrin yiwḏan manayenni, ggwḏen ḥemḏen Arebbi x ssulṭa iy ḏasen iticc i yiwḏan.<verse eid="MAT 9:8" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa itȓaɣa-d i Matta</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Wami yuyur ssenni Ƹisa, yufa ijjen n uryaz qqaren-as Matta iqqim ḏeg umcan mani jemmƹen ḍḍariba. Inna-as Ƹisa: "Ḏfar-ayi-d." Uca ikkar Matta iḏfar-iṯ.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Iqqim Ƹisa ḏi ṯeddarṯ n Matta itett netta ḏ imeḥḍaren nnes. Aṭṭas n iƹeccaren ḏ yinni iƹeṣṣan zaƹma qqimen tetten akiḏes. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Wami ẓrin ȓḥizeb n ifarrisiyen manayenni kkaren nnan-asen i imeḥḍaren nnes: "Mayemmi itett lmuƹallim nwem ak iƹeccaren ḏ yinni iƹeṣṣan?"<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Isȓa-yasen Ƹisa inna-asen: "Iwḏan iṣeḥḥan war teḥḏijin bu uḍbib, aḍbib teḥḏajan-ṯ imehȓac. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Ruḥem rzum x ȓmaƹna n lʼaya iy iqqaren: Xseɣ aḏ treḥmem iwḏan, war xseɣ bu aḏ tɣarṣem i ȓebhayem."<note caller="+" style="f"><char style="fr" closed="false">9.13 </char><char style="ft" closed="false">Xzar Hucaƹ (Osée) 6:6.</char></note> <char style="it">Inna-asen:</char> "War d usiɣ ca aḏ ȓaɣiɣ i yinni iǧan nican, usiɣ-d aḏ ȓaɣiɣ i yinni iƹeṣṣan!"<verse eid="MAT 9:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Ṯumma qarrben-d imeḥḍaren n Yaḥya ɣar Ƹisa nnan-as: "Mayemmi neccin ḏ ȓḥizeb n ifarrisiyen ȓebda netẓumma, imeḥḍaren nnec war tẓummin ca?"<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Inna-asen Ƹisa: "Imeddukaȓ n muȓay, ma zemmaren aḏ xeyyqen ḏi nhar nni n ȓfarḥ nnes? Lla, walakin aḏ d asen wussan aḏ imeysi muȓay zi ȓwesṭ nsen. Ȓexddenni aḏ ẓummen! <verse eid="MAT 9:15" /><verse number="16" style="v" sid="MAT 9:16" />War iǧi ḥadd itreqqaƹ arruḍ ḏ ȓbaȓi s yijjen n ṯreqqiƹṯ n ttub ḏ jḏiḏ, mayemmi? Ȓaḥeqqac ṯareqqiƹṯ nni n jḏiḏ aḏ tnejmeƹ uca aḏ twakkes zeg warruḍ nni n ȓbaȓi. Ȓexddenni aḏ iqqim ucarrig imɣar! <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Uȓa ḏ aman n uḍiȓ ḏ jḏiḏ war xeǧqen ca ḏeg yiȓemawen iqḏimen, ḥima war dduqquzen war tzeǧiƹen ca waman n uḍiȓ aḏ ḍeyyƹen yiȓemawen nni. Walakin aman n uḍiȓ ḏ jḏiḏ xeǧqen ḏeg yiȓemawen ḏ jḏiḏ. Amenni war tḍeyyiƹ uȓa ḏ ijjen n ȓḥajeṯ: lla aman uḍiȓ, lla iȓemawen."<verse eid="MAT 9:17" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa isgenfa yeǧis n yijjen n arrayes</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Wami tuɣa ƹaḏ iqqar Ƹisa manaya, yusa-d ɣares ijjen n arrayes isejjeḏ-as inna-as: "Yeǧi qa ȓexxu iy ṯemmuṯ. Yallah akiḏi sers xas fus nnec ḥima aḏ teddar." <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Ikkar Ƹisa iḏfar-iṯ netta ḏ imeḥḍaren nnes.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Ḏinni ijjen n ṯemɣarṯ ṯenƹac iseggwusa zeg wami iy ṯehȓec, tazzeȓ s iḏammen.<note caller="+" style="f"><char style="fr" closed="false">9.20 </char><char style="ft" closed="false">Iḏammen netta ḏ ddem.</char></note> Ṯeḏfar Ƹisa, ṯḥaḏa-yas ṭṭarf n useȓham nnes. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Ṯenna qbeȓ ḏeg wuȓ nnes: "Meȓa ḥaḏiɣ ɣir aseȓham nnes ataf aḏ genfiɣ." <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />Ineqȓeb ɣares Ƹisa iẓri-t uca inna-as: "War teggweḏ ca a yeǧi, cem lʼiman nnem isgenfa-cem." Ṯgenfa ṯemɣarṯ nni ȓexddenni.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Wami yuweḍ Ƹisa ɣar ṯeddarṯ n arrayes nni, itwaȓa ḏinni ȓebƹaḍ zi ȓɣaci itzemmaren lmusiqa umettin u ḏ yijjen n lharaj. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Inna-asen Ƹisa: "Ffɣem ssa! Aqa ṯaḥenjirṯ-a war ṯemmuṯ ca, ṯeṭṭeṣ waha!" Ȓexddenni bḏan ḍeḥḥcen xas. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Wami sufɣen iwḏan nni, yuḏef ɣar uxxam iṭṭef-as ḏeg ufus i ṯḥenjirṯ nni uca ṯekkar. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Iffeɣ ȓexbar ɣar marra ayṯbab n ṯmurṯ nni.<verse eid="MAT 9:26" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa isgenfa ṯnayen n iḍarɣaȓen ḏ ij uzeynun</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Yuyur ssenni Ƹisa, ḏfaren-ṯ ṯnayen n iḍarɣaȓen tȓaɣan qqaren: "A Mmis n Ayṯ-Dawed, rḥem-aneɣ!" <verse eid="MAT 9:27" /><verse number="28" style="v" sid="MAT 9:28" />Wami yuḏef Ƹisa ɣar ṯeddarṯ, qarrben ɣares iḍarɣaȓen nni. Inna-asen Ƹisa: "Ma ṯumnem belli nec zemmareɣ aḏ ggeɣ manaya?" Nnan-as: "Wah a Siḏi." <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />Uca iḥaḏa-yasen Ƹisa ṯiṭṭawin inna-asen: "Ƹlaḥsab lʼiman nwem iy ɣa twagenfam." <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Ȓexddenni nurzment ṯiṭṭawin nsen. Iƹȓem-asen Ƹisa inna-asen: "Ɣarwem aḏ iffeɣ ȓexbar-a ɣar ca ḥadd!" <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Walakin niṯni ruḥen sufɣen ȓexbar nni x Ƹisa ḏi ṯmurṯ nni marra.<verse eid="MAT 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Ḏi ȓweqṯ iy ḏi ruḥen, can yiwḏan uwin-as-d i Ƹisa ijjen n uryaz ḏ azeynun ḏayes jjenn. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Wami isufeɣ Ƹisa jjenn nni, ibḏa uzeynun nni issawaȓ. Qqimen tƹejjben ȓɣaci nni nnan: "Ƹemmarṣ ma iwqeƹ manaya ḏi ṯmurṯ n Ayṯ-Israʼil." <verse eid="MAT 9:33" /><verse number="34" style="v" sid="MAT 9:34" />Walakin ȓḥizeb n ifarrisiyen nnan: "Netta isufuɣ jnun ȓaḥeqqac arrayes n jnun yuca-as jjheḏ-a."<verse eid="MAT 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Yuyur Ƹisa ḏi marra ṯineddam<note caller="+" style="f"><char style="fr" closed="false">9.35 </char><char style="ft" closed="false">Ṯineddam niṯenti ḏ ṯindinin.</char></note> ḏ ȓedcur, iseȓmaḏ ḏi ṯemziḏawin n Ayṯ-Israʼil itḥeddaṯ itbeccar s ȓmulk n Arebbi. Isgenfa marra ȓehȓacaṯ ḏ ddiƹan n ddat. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Iẓerr Ƹisa ȓɣaci nni qqsen-as minzi twaƹeddaben tnehwaȓen, ggin amecnaw iḥuȓiyen war ɣarsen ca uw ṯen ɣa yarewsen. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Inna-asen i imeḥḍaren nnes: "Ṯafeǧaḥṯ aṭṭas walakin ḏrus icewwaren iy ɣa ixeḏmen. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Ttareṯ zi Bab n ṯfeǧaḥṯ aḏ yarni icewwaren ḏeg umarjeƹ nnes."<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">Siḏiṯneɣ Ƹisa ixḍar ṯenƹac n arrusul</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Iȓaɣa-d Ƹisa x ṯenƹac nni n imeḥḍaren nnes yuca-asen ssulṭa iy zi ɣa sufɣen jnun aḏ sgenfan marra ȓehȓacaṯ ḏ ȓeḥriqaṯ n yiwḏan. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Ḏ yina ḏ isemawen n ṯenƹac n arrusul: Amezwaru nsen qqaren-as Simƹan maƹruf s Buṭrus ḏ wumas qqaren-as Andrus, ḏ mmis n Zabadi qqaren-as Yaƹqub ḏ wumas qqaren-as Yuḥanna, <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />ḏ Filippas, ḏ Bartulumay, ḏ Tuma, ḏ Matta zeg iƹeccaren, ḏ Yaƹqub mmis n Ḥalfa, ḏ Taddi, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />ḏ Simƹan umi qqaren &lt;Lmunaḍil&gt;, ḏ Yahuḏa Isxaryuṭi iƹni wenni izzenzen Ƹisa.<verse eid="MAT 10:4" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa issekk arrusul aḏ ḥeddṯen</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Ṯenƹac-a n iryazen issekk-iṯen Ƹisa iweṣṣa-ṯen inna-asen: "War traḥem ca ɣar ṯmura n ȓegnus. War tiḏfem bu ṯineddam<note caller="+" style="f"><char style="fr" closed="false">10.5 </char><char style="ft" closed="false">Ṯineddam niṯenti ḏ ṯindinin.</char></note> n ṯmurṯ n Samarya. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Lla, ruḥeṯ ɣar iḥuȓiyen nni iweddaren <char style="it">iƹni iwḏan</char> n Ayṯ-Israʼil. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Xmi ɣa ṯraḥem, ḥeddṯem s ȓmulk ujenna aqa yuḏes-d. <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Sgenfam imehȓac, sfaqem-d yinni immuṯen, siṣfam yinni ig iǧa jḏam, sufɣem jnun. Manaya immuc-awem baṭeȓ, uȓa ḏ kenniw ucem-ṯ baṭeȓ! <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />War debbarem walu: lla ddheb, lla nnuqarṯ, lla nneḥḥas ḏeg uḥezzam nwem. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />War debbarem bu uqrab x ubriḏ uȓa ḏ ṯnayen ičammiren, uȓa ḏ ṯisiȓa, uȓa ḏ aƹekkaz. Minzi wenni itbeccaren ɣares ȓḥaqq aḏ itxaȓes aɣrum nnes. <verse eid="MAT 10:10" /><verse number="11" style="v" sid="MAT 10:11" />Xmi ɣa ṯaḏfem can ṯendint niɣ can dcar, rzum x wenni kenniw ɣa iqebȓen ɣar ṯeddarṯ nnes. Qqimeṯ ḏayes aȓ ɣa ṯuyurem ssenni. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Xmi ɣa ṯaḏfem ɣar can ṯeddarṯ, seǧmem x ayṯbab nnes. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Meȓa qebȓen-kenniw ayṯbab nnes, ataf akiḏsen ṯiȓi lbaraka nwem. Meȓa war kenniw qbiȓen ca, ataf war kisen tɣimi ca lbaraka nwem. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Meȓa war kenniw qbiȓen ca ḏi can ṯeddarṯ niɣ ḏi can ṯendint niɣ meȓa war xsen aɣarwem ṣennṭen, ffɣeṯ ssenni mesḥeṯ ṯaƹejjact zeg iḍaren nwem. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Aqa tesȓam ȓḥaqq: Ḏi Yum Lḥisab ḏ Lƹiqab aḏ yiȓi lƹiqab n ṯendint nni ktar zi lƹiqab n ṯendint <char style="it">ṯaƹeffant</char> n Sadum ḏ ṯendint <char style="it">ṯaƹeffant</char> n Ƹamura.<verse eid="MAT 10:15" /></para>
  <para style="s">Aƹeddeb ig itekken x imeḥḍaren</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />Nec aqa ssekkiɣ-kenniw amecnaw iḥuȓiyen jar wuccanen. Iȓim ṯfaqem amecnaw ifiɣeran, iȓim ḏ nniyyeṯ amecnaw iḏbiren. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Ḥḍam ixef nwem zeg yiwḏan. Akenniw sellmen i lmaḥkamaṯ; akenniw uwṯen ḏi ṯemziḏawin nsen. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Akenniw jarren ɣar lḥukkam ḏ izeǧiḏen ƹlaḥsab isem inu ḥima axafi ṯcehḏem ɣar niṯni ḏ yinni zi ȓegnus. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Xmi kenniw ɣa sellmen, bȓa ma aḏ teysim amnus ḏi ȓaƹquȓaṯ nwem min ɣa ṯinim niɣ ḏ mammec iy ɣa ṯessiwȓem; Lla, awaȓen nni iy ɣa ṯinim ḏ Arebbi iy ḏawem ṯen ɣa yucen ḏi ṯsaƹƹat nni. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />War iǧi bu ḏ kenniw iy ɣa issiwȓen; Lla, ḏ Arruḥ n Babaṯwem iy ɣa issiwȓen ḏeg umcan nwem. <verse eid="MAT 10:20" /><verse number="21" style="v" sid="MAT 10:21" />Umas aḏ isellem umas i ȓmewṯ. Babas aḏ isellem mmis. Ṯarwa aḏ raḥen ḍed i lwalidin nsen, aṯen sellmen i yinni iy ṯen ɣa nɣen. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Akenniw ƹiffen marra ƹlaḥsab isem inu, walakin wenni ɣa iṣbaren ɣar uneggaru ataf aḏ injem. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Meȓa ƹeddben-kenniw ḏi can ṯendint, arewȓem ɣar ṯenneɣni. Aqa tesȓam ȓḥaqq: Aḏ d yas Mmis n bnaḏem, ataf kenniw ƹaḏ war ṯkemmȓem <char style="it">x min kenniw weṣṣiɣ</char> ḏi ṯneddam n Ayṯ-Israʼil.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />Ameḥḍar war iǧi ca ḏ ameqqran x lmuƹallim nnes. Axeddam war iǧi ca ḏ ameqqran x uweqqaf nnes. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Baraka ɣir aḏ yiȓi umeḥḍar am lmuƹallim nnes, aḏ yiȓi uxeddam am uweqqaf nnes. Meȓa ȓaɣan i bab n ṯeddarṯ &lt;A Ibȓis&gt;,<note caller="+" style="f"><char style="fr" closed="false">10.25 </char><char style="ft" closed="false">Awaȓ-a s ṯayunaniṯ netta ḏ "Bƹalzabul".</char></note> iwa mammec ɣa ȓaɣan i ȓeḥbab n ṯeddarṯ nnes?<verse eid="MAT 10:25" /></para>
  <para style="s">Ṯiggwḏi zi Arebbi</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />War teggwḏem ca zzaysen. Marra min itwasnuffaren aḏ inefḍeḥ. Marra min inuffaren aḏ itwassen! <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Min ḏawem qqareɣ ḏi ṯaǧest, ƹawḏem-as ḏi ṯfawṯ n nhar. Min tesȓam s ȓḥess, ƹeyyḍeṯ zzayes x ṯzeqqa. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />War teggwḏeṯ ca zeg yinni ineqqen ddat war zemmaren aḏ nɣen uȓa ḏ ȓaƹmar; Lla, ggwḏeṯ zi Arebbi iƹni wenni izemmaren aḏ idemmar ddat ḏ ȓaƹmar ḏi jahennama. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Ma war tmenzin ṯnayen n izawjiwen<note caller="+" style="f"><char style="fr" closed="false">10.29 </char><char style="ft" closed="false">Izawjiwen niṯni ḏ ijḍaḍ.</char></note> s duru? Walakin, war zzaysen iweṭṭi uȓa ḏ ijjen ɣar ṯmurṯ meȓa war ixis ca Babaṯwem. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Uȓa ḏ izuṭṭan iy ɣarwem x uzeǧif nwem iḥseb-iṯen Arebbi marra. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />War teggwḏem ca. Kenniw ṯseggwam ktar s waṭṭas x izawjiwen.<verse eid="MAT 10:31" /></para>
  <para style="s">Wenni icehhḏen x Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />Wenni zzayi ɣa icehḏen nec zzaṯ i yiwḏan, ataf azzayes cehḏeɣ nec zzaṯ i Baba iǧan ḏeg ujenna. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Wenni ḏayi ɣa inkaren zzaṯ i yiwḏan, ataf aṯ nkareɣ nec zzaṯ i Baba iǧan ḏeg ujenna.<verse eid="MAT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />War tfekkarem ca belli usiɣ-d aḏ ggeɣ ȓehna ḏi ddunect-a. War d usiɣ ca aḏ ggeɣ ȓehna; Lla, usiɣ-d aḏ ggeɣ amenɣi. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Usiɣ-d aḏ smenɣeɣ mmis ak babas, ḏ yeǧis ak yemmas, ḏ ṯsȓiṯ ak lallas. <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />Aḏ yiȓi ȓaƹḏu n bnaḏem ḏ ȓeḥbab iy kis izeddɣen ḏi ṯeddarṯ nnes.<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />Wenni xef iƹizz babas niɣ ḏ yemmas ktar zzayi nec, ataf war ḏayi isḏiheǧ ca. Wenni xef iƹizz mmis niɣ ḏ yeǧis ktar zzayi nec, ataf war ḏayi isḏiheǧ ca. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Wenni itagin aḏ iysi ṣṣalib nnes<note caller="+" style="f"><char style="fr" closed="false">10.38 </char><char style="ft" closed="false">Ḏi ȓweqṯ nni n Siḏiṯneɣ Ƹisa arrumanus neqqen iwḏan ḏi ṣṣalib, iwḏan tƹeddaben aṭṭas ḏayes. Wenni iḏeffaren Siḏiṯneɣ Ƹisa ixeṣṣa-yas war iteggweḏ ca zi ṣṣalib nni, iƹni zi ȓmewṯ uȓa zeg uƹeddeb.</char></note> aḏayi iḏfar nec, ataf war ḏayi isḏiheǧ ca. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Wenni ɣa irebḥen ṯuḏarṯ nnes, ataf at ixsar. Wenni ɣa ixsaren ṯuḏarṯ nnes x ssabab inu, ataf at irbeḥ.<verse eid="MAT 10:39" /></para>
  <para style="s">Lʼajar</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />Wenni kenniw iqebbȓen, ataf iqbeȓ-ayi. Wenni ḏayi iqebbȓen, ataf iqbeȓ wenni ḏayi d issekken. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Wenni iqebbȓen can n nnabi ȓaḥeqqac issekk-iṯ-iḏ Arebbi, ataf aɣares yiȓi lʼajar amecnaw can n nnabi. Wenni iqebbȓen can n ȓmumen ȓaḥeqqac ḏ ȓmumen, ataf aɣares yiȓi lʼajar amecnaw can n ȓmumen. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Aqa tesȓam ȓḥaqq: Wenni ɣa yucen ɣir ȓkas n waman ḏ asemmaḍ i can yijjen zeg imezyanen-a ȓaḥeqqac ḏ ameḥḍar inu, ataf aḏ yawi lʼajar nnes war ṯ itḍeyyiƹ ca."<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Siḏiṯneɣ Ƹisa ḏ Siḏna Yaḥya</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Wami ikemmeȓ Ƹisa ȓuṣiyaṯ i ṯenƹac n imeḥḍaren nnes, yuyur ssenni iruḥ ḥima aḏ iseȓmeḏ aḏ iḥeddeṯ ḏi ṯneddam<note caller="+" style="f"><char style="fr" closed="false">11.1 </char><char style="ft" closed="false">Ṯineddam niṯenti ḏ ṯindinin.</char></note> iy d yuḏsen jjiheṯ nni.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Wami Yaḥya aqaṯ ḏi ȓeḥbes, isȓa x ȓexḏayem n Lmasiḥ. Issekk can imeḥḍaren nnes ɣar Ƹisa <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />ḥima aḏas inin: "Ma ḏ cek iy xef netsȓa aḏ d taseḏ niɣ a nraja can yijjen nneɣni?"<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Indeq-d Ƹisa inna-asen: "Ƹeqbeṯ ɣar Yaḥya ƹawḏem-as min tesȓam ḏ min twaȓam: <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />iḍarɣaȓen twaȓan, izeḥḥafen gguren, yinni iy ḏi iǧa jḏam genfan, iḏehcuren tesȓan, yinni immuṯen tnekkaren-d, ȓmusakin twabeccaren. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Ssaƹḏ n yinni war ḏayi itcekkin ca."<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Wami rewwḥen imeḥḍaren n Yaḥya, Ƹisa ibḏa issawaȓ x Yaḥya iqqar-asen i ȓɣaci nni: "Minxef ṯeffɣem aḏ teẓrem ḏi ȓexȓa? Ma ɣar yij uɣanim ithezza-ṯ arriḥ? Lla! <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Meȓa lla, minxef ṯeffɣem aḏ teẓrem? Ma ḏ ijjen n uryaz yareḍ arruḍ ḏ aṣebḥan? Lla, yinni iy ɣar iǧa warruḍ ḏ aṣebḥan tƹicen mliḥ tiȓin ḏi ȓquṣur n izeǧiḏen! <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Meȓa lla, minxef ṯeffɣem aḏ teẓrem? Ma ḏ ijjen n nnabi? Qqareɣ-awem: Wah, netta ktar zeg yijjen n nnabi. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Ḏ Yaḥya iy xef issawaȓ Lkitab:</para>
  <para style="q1" vid="MAT 11:10">Aqa tsekkiɣ-d ijjen n arrasul inu zzaṯec,</para>
  <para style="q2" vid="MAT 11:10">ḥima aḏac isewjeḏ abriḏ nnec.<note caller="+" style="f"><char style="fr" closed="false">11.10 </char><char style="ft" closed="false">Xzar Malaxi (Malachie) 3:1.</char></note><verse eid="MAT 11:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11" />Aqa tesȓam ȓḥaqq: Zi min d jjint ṯemɣarin, war iǧi ḥadd ḏ ameqqran zi Yaḥya, walakin wenni iy iǧan ḏ amezyan qaƹ ḏi ȓmulk n ujenna netta ḏ ameqqran zi Yaḥya.<verse eid="MAT 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 11:12" />Zi ȓweqṯ n Yaḥya aȓ ȓexxu iwḏan temḏeḥḥasen aḏ aḏfen ḏi ȓmulk ujenna, iryazen tmenɣan bac aɣarsen yiȓi. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Aqa Ccariƹa n Musa<note caller="+" style="f"><char style="fr" closed="false">11.13 </char><char style="ft" closed="false">Ccariƹa n Musa qqaren-as Tuwrat. Ḏayes ȓuṣiyaṯ nni iy d yuca Siḏi Arebbi i yiwḏan n Ayṯ-Israʼil x ufus n Siḏna Musa. Tuwrat n Siḏna Musa ḏayes xemsa n lkutub: ijjen qqaren-as Imezwura, ijjen qqaren-as Ufuɣ, ijjen Ȓkitab n Ayṯ-Lawi, ijjen Lƹadad, ijjen Afessar n Ccariƹa n Musa.</char></note> ḏ qaƹ lʼanbiya ssiwȓen x ȓmulk ujenna ḥetta aȓ ȓweqṯ n Yaḥya. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />U meȓa ṯexsem aḏ tfehmem, Yaḥya netta ḏ nnabi Ilyas nni iy netraja. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Ṣenneṭ mliḥ a wenni itsȓan.<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />X manaya wi ḏi ɣa cabbheɣ iwḏan n ȓweqṯ-a? Niṯni am ca n iḥenjiren iy iqqimen ḏi saḥa tȓaɣan i wayawya qqaren: <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />Netṣuḍ ḏi ṯemja,<note caller="+" style="f"><char style="fr" closed="false">11.17 </char><char style="ft" closed="false">Ṯamja nettaṯ ḏ ṯacebbabṯ.</char></note> war ṯecḍiḥem ca. Netƹezza-kenniw, war ṯetrum ca. <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />Minzi Yaḥya yusa-d itẓumma war isess <char style="it">aman n uḍiȓ</char>, nnan aqa ḏayes jnun! <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Yusa-d Mmis n bnaḏem itett isess <char style="it">war itẓummi ca</char>, nnan qa wanita itett isess aṭṭas, ƹaweḏ netta ḏ ameddukeȓ n iƹeccaren ḏ yinni iƹeṣṣan. Innama, ȓefhameṯ n Arebbi qebbȓen-teṯ marra yinni ifehhmen."<note caller="+" style="f"><char style="fr" closed="false">11.19 </char><char style="ft" closed="false">Lʼaya-ya s ṯayunaniṯ ṯusa-d ammu s ȓḥarf: Ȓexḏayem n ȓefhameṯ ticcent-as ȓḥaqq i ȓefhameṯ nni.</char></note><verse eid="MAT 11:19" /></para>
  <para style="s">Ṯineddam ikeffaren</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Ssenni ibḏa Ƹisa itƹeyyab ṯineddam nni iy ḏi igga aṭṭas n lmuƹjizaṯ nnes, war tuben ca ayṯbab nsent. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" /><char style="it">Inna Ƹisa</char>: "Ya ȓefḍiḥeṯ nnec ya abilaj n Kurazim! Ya ȓefḍiḥeṯ nnec ya abilaj n Bayt Ṣayda! Maƹlik lmuƹjizaṯ-a iy ḏaywem iweqƹen, weqƹent ḏi <char style="it">ṯneddam ṯiƹeffanin n</char> Ṣur ḏ Ṣayda, ataf ayṯbab nsent tuben mecḥaȓ zeg wami, iȓi ggin arruḍ n lḥuzen qqimen x yiɣɣeḏ<note caller="+" style="f"><char style="fr" closed="false">11.21 </char><char style="ft" closed="false">Iɣeḏ netta ḏ ṯnifesṯ.</char></note> <char style="it">ḥima aḏ d tban tuba nsen</char>. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />X manayenni aḏawem iniɣ: Aqa <char style="it">ṯineddam ṯiƹeffanin nni n</char> Ṣur ḏ Ṣayda aḏ iȓint ḥsen zzaywem ḏi Yum Lḥisab ḏ Lƹiqab. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Y cek, ay abilaj n Kafernaḥum! Ma tɣir-ac aḏ tgaƹƹḏeḏ ɣar ujenna? Lla, qa cek aḏ tehwiḏ ɣar Ljaḥim. Ȓaḥeqqac lmuƹjizaṯ nni iy ḏayec iweqƹen mȓi weqƹent ḏi <char style="it">ṯendint ṯaƹeffant nni n</char> Sadum, iȓi ƹaḏ aqat ḏ ṯandint aȓ nhara. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />X manayenni aḏawem iniɣ: Aqa <char style="it">ṯandint ṯaƹeffant nni n</char> Sadum aḏ tiȓi ḥsen zzayec ḏi Yum Lḥisab ḏ Lƹiqab!"<verse eid="MAT 11:24" /></para>
  <para style="s">Arraḥeṯ i yinni yuḥȓen</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Ȓexddenni issiweȓ Ƹisa inna: "Ḥemḏeɣ-cek a Baba a Siḏi Arebbi n ujenna ḏ ṯmurṯ ȓaḥeqqac ṯesnuffareḏ manaya x imiɣisen ḏ lƹulama, ṯseḍhareḏ-ṯ-id i iḥenjiren imezyanen. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Wah a Baba, ȓaḥeqqac ammu iy xak yarḍa.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />Immuc-ayi kuȓci zi Baba. War issin ḥadd min iƹna Mmis menɣir Babas. War issin ḥadd min iƹna Babas menɣir Mmis. Babas, aṯ ssnen ɣir yinni umi ixes Mmis aḏasen ṯiḏ ismeḍhar.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />A yinni yuḥȓen s dqeȓ iy ṯarbum, araḥem-d ɣari marra kenniw nec akenniw sreyyḥeɣ. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Arbuṯ xawem ṯzayȓut<note caller="+" style="f"><char style="fr" closed="false">11.29 </char><char style="ft" closed="false">Ṯzayȓut nettaṯ ḏ ṯzagȓut. Teggen-teṯ x yirawen n ifunasen ḏi zman cerrzen zzayes. Qqaren-as ƹaweḏ ṯaɣwawṯ.</char></note> inu, ȓemḏeṯ zzayi ȓaḥeqqac nec ḏ aṣebbar, war ḏayi bu ttakebbur. Ȓexddenni aḏ tafem arraḥeṯ i yixef nwem. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Ȓaḥeqqac meȓa ṯarbum ṯzayȓut inu nettaṯ aqa ṯehwan, dqeȓ inu ifsus.<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Min iǧan ḥalal ḏi nhar n ssebṯ n lƹibada</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Ḏeg wussan nni ḏi nhar n ssebṯ n lƹibada iƹḏu Ƹisa ḏeg ubriḏ ḏi ȓwesṭ n imendi, imeḥḍaren nnes ǧuzen gguren tekksen ṯiyḏerin tetten-ṯent. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Wami ṯen ẓrin ca n yiwḏan zi ȓḥizeb n ifarrisiyen nnan-as i Ƹisa: "Xzar! Imeḥḍaren nnec teggen min iǧan ḥram ḏi nhar n ssebṯ n lƹibada."<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Indeq-d Ƹisa inna-asen: "Ma war ṯeɣrim ca min igga Dawed wami tuɣa iǧuz netta ḏ yinni akiḏes? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Yuḏef ɣar ṯemziḏa n Arebbi yufa ḏinni aɣrum nni iy iǧan ḏ ṣṣeḏqeṯ icci-ṯ netta ḏ yinni iy kiḏes; waxxa manayenni war iǧi ca ḥalal ɣir i ȓfuqaha waha. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Niɣ war ṯeɣrim ca ḏi Ccariƹa n Musa belli ȓfuqaha txaȓafen zaƹma nhar n ssebṯ n lƹibada ḏi ṯemziḏa n Arebbi bȓa ma ṯen iḥasseb ḥadd? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Qqareɣ-awem: Ḏanita ḏinni ijjen ktar zi ṯemziḏa n Arebbi. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Mȓi ṯfehmem ȓmaƹna n wawaȓ-a iy iqqar Arebbi: &lt;Xseɣ aḏ treḥmem iwḏan, war xseɣ ca aḏ tɣarṣem i ȓebhayem&gt;, ataf war ṯḥekkmem ca x yinni war iggin minxef. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Ȓaḥeqqac Mmis n bnaḏem ig iǧan ḏ lḥakem x nhar n ssebṯ."<verse eid="MAT 12:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Yuyur ssenni Ƹisa, yuḏef ɣar yijjen n ṯemziḏa n Ayṯ-Israʼil. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Yufa ḏinni ijjen n uryaz fus nnes immuṯ. Ȓexddenni sseqsan Ƹisa rezzun aṯ tahmen nnan-as: "Ma ḥalal aḏ tesgenfiḏ can yijjen ḏi nhar n ssebṯ n lƹibada ma lla?"<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Inna-asen Ƹisa: "Meȓa can yijjen zzaywem ɣares ij uḥuȓi iwḍa-yas ḏi ṯsrafṯ ḏi nhar n lƹibada, ma ṯiḏ iṭṭef aṯiḏ isiȓi ma lla? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Iwa bnaḏem iseggwa aṭṭas s waṭṭas zeg yij uḥuȓi! Ƹlaḥsab manaya ḥalal aḏ teggeḏ ȓxir ḏi nhar n lƹibada." <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Ȓexddenni inna-as Ƹisa i lmuƹaq nni: "Sarreḥ fus nnec." Isarreḥ-iṯ uca iḏweȓ ufus nnes igenfa, mliḥ am ufus nneɣni. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Ffɣen yiwḏan n ȓḥizeb n ifarrisiyen ciṭṭnen jarasen mammec ɣa ggen aḏ nɣen Ƹisa.<verse eid="MAT 12:14" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa itwajah yinni iǧan ḍed nnes</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Issen Ƹisa manayenni yuyur ssenni. Ḏfaren-ṯ aberru n yiwḏan, isgenfa marra imehȓac nsen. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Iweṣṣa-ṯen inna-asen war txebbarem ḥadd xafi. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Manaya ḥima aḏ iffeɣ wawaȓ iy inna Siḏi Arebbi i nnabi Icaƹya ḏeg yijjen n zman:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />&lt;Ḏ wanita ḏ axeddam inu ig ixḍareɣ,</para>
  <para style="q2" vid="MAT 12:18">wenni iy xafi iƹizzen iy xef arḍiɣ.</para>
  <para style="q1" vid="MAT 12:18">Aḏayes ggeɣ Arruḥ iqeddsen,</para>
  <para style="q2" vid="MAT 12:18">aḏ ixebbar yinni zi ȓegnus s ȓḥaqq.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />War itmenɣi ak ḥadd,</para>
  <para style="q2" vid="MAT 12:19">war isnekkar bu ṯɣuyyeṯ,</para>
  <para style="q1" vid="MAT 12:19">war itsȓi ḥadd i wawaȓ nnes ḏeg ibriḏen.<verse eid="MAT 12:19" /></para>
  <para style="q2">
    <verse number="20" style="v" sid="MAT 12:20" />War itrezzi bu ɣanim imeyyȓen,</para>
  <para style="q1" vid="MAT 12:20">war isexsay ṯfawṯ n ṯefṯiȓt iteggen ddexxan,</para>
  <para style="q2" vid="MAT 12:20">aȓ ɣa irbeḥ ȓḥaqq.<verse eid="MAT 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21" />Ḏeg yisem nnes ȓegnus aḏ ggen lʼamal.&gt;<note caller="+" style="f"><char style="fr" closed="false">12.21 </char><char style="ft" closed="false">Xzar Icaƹya (Esaïe) 42:1-4.</char></note><verse eid="MAT 12:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Ssenni can yiwḏan uwin-as-d i Ƹisa ijjen n uryaz ḏ aḍarɣaȓ ḏ azeynun ḏayes jjenn. Isgenfa-ṯ Ƹisa ḥima aḏ issiweȓ aḏ itwaȓa. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Qqimen ȓɣaci nni tƹejjben marra nnan: "Maci ḏ wanita ig iǧan ḏ Mmis n Dawed niɣ?"<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Tesȓan ȓḥizeb n ifarrisiyen i wawaȓ nsen nnan-asen: "Bnaḏem-a isufuɣ jnun minzi arrayes n jnun umi qqaren Bƹalzabul yuca-as jjheḏ-a."<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Issen Ƹisa min nwan inna-asen: "Mkuȓ lmemlaka iy ḏi tmenɣan ayṯbab nnes ijjen ak unneɣni aḏ tnehḏem. Mkuȓ ṯandint niɣ ḏ ṯaddarṯ iy ḏi tmenɣan ayṯbab nnes ijjen ak unneɣni war ṯzemmar aḏ teqqim. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Meȓa Cciṭan isufuɣ Cciṭan, ataf aḏ iqḍa x yixef nnes. Mammec ɣa ṯegg aḏ teqqim lmemlaka nnes? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Nec meȓa sufuɣeɣ jnun s jjheḏ n Bƹalzabul nni zaƹma, inim-ayi kenniw mammec teggen yiwḏan nwem sufuɣen-ṯen uȓa ḏ niṯni? Niṯni s yixef nsen tbeyyanen belli kenniw war ɣarwem bu ȓḥaqq ḏi min ṯeqqarem. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Nec, meȓa sufuɣeɣ jnun s Arruḥ n Arebbi, aqa ȓmulk n Arebbi yusa-d ɣarwem. <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />Iwa mammec? War izemmar ḥadd aḏ ihjem x ṯeddarṯ n can yijjen ijheḏ bac aḏ yacar agȓa nnes illa meȓa icedd-iṯ ḏ amezwaru. Uca aḏas yawi marra min ɣares ḏi ṯeddarṯ.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />Wenni war kiḏi iǧin ca, ataf aqaṯ ḍed inu. Wenni war kiḏi ismunen, ataf netta itzeǧaƹ. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Aqa qqareɣ-awem: Aḏ twaɣfarent marra ȓmuƹṣiyaṯ iy teggen yiwḏan ḏ kuȓ awaȓ nni war iḥȓin iy qqaren x Arebbi. Walakin wenni ɣa yinin can wawaȓ war iḥȓin x Arruḥ iqeddsen, ataf war ḏas iɣeffar ca. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Wenni ɣa yinin can wawaȓ war iḥȓin x Mmis n bnaḏem, ataf axas iɣfar. Walakin wenni ɣa yinin can wawaȓ war iḥȓin x Arruḥ iqeddsen, ataf war xas iɣeffar ca lla ḏi ddunect-a u lla ḏi lʼaxira.<verse eid="MAT 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />Meȓa ṯacejjarṯ ḏ ṯaṣebḥant, ataf aḏ tarew min iǧan ḏ aṣebḥan. Meȓa ṯacejjarṯ ḏ ṯaƹeffant, ataf aḏ tarew min iǧan ḏ aƹeffan. Ṯacejjarṯ ṯḍehhar-d s min tarew. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />A ṯarwa ifiɣeran, mammec ɣa ṯeggem aḏ tinim awaȓ aṣebḥan u kenniw ḏ iƹeffanen? Ȓaḥeqqac aqemmum n bnaḏem issawaȓ min iǧan ḏeg wuȓ nnes. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Bnaḏem aṣebḥan isufuɣ-d min iǧan ḏ aṣebḥan zi ȓkenz aṣebḥan n wuȓ nnes. Bnaḏem aƹeffan isufuɣ-d min iǧan ḏ aƹeffan zi ȓkenz aƹeffan n wuȓ nnes.<verse eid="MAT 12:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 12:36" />Aḏawem iniɣ: Aqa Yum Lḥisab ḏ Lƹiqab aḏ twaḥasben yiwḏan x mkuȓ awaȓ ixwan iy ssiwȓen. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Ȓaḥeqqac ƹlaḥsab awaȓen nnec aqac bariʼ, niɣ ƹlaḥsab awaȓen nnec aḏ twaƹaqbeḏ."<verse eid="MAT 12:37" /></para>
  <para style="s">Lƹalama ṯameqqrant n Siḏna Yunes</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Ȓebƹaḍ n imseȓmaḏen n ccariƹa ḏ ȓḥizeb n ifarrisiyen nnan-as i Ƹisa: "A Lmuƹallim, nexs a nẓer ijjen n lƹalama ḏ ṯameqqrant zzayek."<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Indeq-d Ƹisa inna-asen: "Iwḏan iƹeffanen n ȓweqṯ-a ixeddƹen Arebbi rezzun lƹalama. Inna-asen: Lla, war ḏasen itmucci illa lƹalama nni n nnabi Yunes. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Amec iseƹḏu Yunes ṯeȓtiyyam jar ǧiyaȓi ḏ wussan ḏeg uƹeddis n usȓem ameqqran, amenni iy ɣa iseƹḏu Mmis n bnaḏem ṯeȓtiyyam jar ǧiyaȓi ḏ wussan ḏeg uƹeddis n ṯmurṯ. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Yum Lḥisab ḏ Lƹiqab aḏ d kkaren imezḏaɣ n ṯendint n Ninwa ak yiwḏan n ȓweqṯ-a axasen ceṯcan, ȓaḥeqqac ayṯbab n ṯendint n Ninwa tuben wami ṯen inha nnabi Yunes. U ḏanita ijjen ḏ ameqqran zi Yunes. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Yum Lḥisab ḏ Lƹiqab aḏ tekkar lmalika n ljanub ak yiwḏan n ȓweqṯ-a axasen ṯceṯca, ȓaḥeqqac ṯusa-d nettaṯ zi ṯmurṯ yugjen ḥima aḏ tṣenneṭ i ȓefhameṯ n Suliman. U ḏanita ijjen ḏ ameqqran zi Suliman.<verse eid="MAT 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />Cuf, xmi ɣa itwasufeɣ jjenn aƹeffan zi can bnaḏem, ataf aḏ iggur ḏeg imucan yuzɣen irezzu amcan mani ɣa ireyyeḥ. Meȓa war yufi ca, <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />ataf aḏ yini aqa nec aḏ raḥeɣ aḏ ḏewȓeɣ ɣar ṯeddarṯ inu manis iy ffɣeɣ. Ssenni aɣares iḏweȓ at yaf ṯexwa, ṯeƹḏeȓ, ṯenqa. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Uca aḏ iraḥ aḏ d yawi sebƹa n jnun nneɣni ḏ iƹeffanen ktar zzayes ḥima aḏ ḏewȓen kuȓci aḏayes zeḏɣen. Ataf aḏ tiȓi lḥala ṯaneggarut n bnaḏem nni ḏ ṯaƹeffant ktar zi lḥala nnes ṯamezwarut. Amenni iy ḏasen ɣa ṯewqeƹ i yiwḏan iƹeffanen n ȓweqṯ-a."<verse eid="MAT 12:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Ƹaḏ issawaȓ Ƹisa ak ȓɣaci wami ɣares d tusa yemmas ḏ ayṯmas, bedden barra <char style="it">i ṯeddarṯ</char> rezzun akiḏes ssiwȓen. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Inna-as can yijjen i Ƹisa: "Aqa yemmac ḏ ayṯmac bedden ɣar barra rezzun akiḏec ssiwȓen."<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />Indeq-d Ƹisa inna-as i wenni iy kiḏes issiwȓen: "Min ƹnan yemma ḏ ayṯma?" <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Iswiẓẓeḏ s ufus nnes ɣar imeḥḍaren nnes inna: "Aqa yemma ḏ ayṯma." <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" /><char style="it">Inna-as:</char> "Wenni iteggen s min ixes Baba iy iǧan ḏeg ujenna, ataf netta ḏ uma ḏ učma ḏ yemma."<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Ȓmaƹna n wenni izerrƹen</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Nhar nni, iffeɣ Ƹisa zi ṯeddarṯ iqqim ṭṭarf n ȓebḥar. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Munen-d xas aṭṭas n ȓɣaci. S zḥameṯ nni iruḥ inya ḏeg yijjen n ṯɣarrabut iqqim ḏayes. Iwḏan qqimen marra x cceṭṭ n ȓebḥar. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Iqqar-asen aṭṭas n ṯmesȓayin s ȓemƹani inna-asen: "<char style="it">Ṣennṭeṯ!</char> Iffeɣ ufeǧaḥ aḏ izreƹ. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Wami izerreƹ, ṯewḍa-yas can zzarriƹeṯ x ṭṭarf n ubriḏ, usin-d ijḍaḍ ccin-teṯ. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Can zzarriƹeṯ ṯewḍa-yas jar yizra war ḏinni bu caȓ aṭṭas. Ṯeɣmi-d ḏeɣya ȓaḥeqqac war ṯuǧiɣ ca ḏi ṯmurṯ aṭṭas. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Walakin wami ṯsummar ṯfuct, ṯnezȓef ȓexddenni ṯisraw ȓaḥeqqac iẓewran nnes war uwṯin ca ɣar ȓaǧeɣ n ṯmurṯ. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Can zzarriƹeṯ ṯewḍa jar isennanen. Ɣmin-d akiḏes isennanen nni jeyyfen-teṯ. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Walakin can zzarriƹeṯ ṯewḍa x ṯmurṯ ṯaṣebḥant, ṯegga ṯiyḏerin. Ȓebƹaḍ ggint miyya, ȓebƹaḍ ggint settin, ȓebƹaḍ ggint ṯȓaṯin. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Ṣenneṭ mliḥ a wenni itsȓan."<verse eid="MAT 13:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Qarrben-d ɣares imeḥḍaren nnes nnan-as: "Mayemmi iy kisen ṯessawaȓeḏ s ȓemƹani?" <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />Indeq-d Ƹisa inna-asen: "Itwasmeḥ i kenniw aḏ tessnem min inuffaren ḏi ȓmulk ujenna. Walakin niṯni lla, war ḏasen itwasmiḥ ca. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Ȓaḥeqqac wenni iǧan ɣares itmarni-yas, aɣares yiȓi aṭṭas. Walakin wenni war ɣar iǧi ca, itwaksi-yas uȓa ḏ min ɣares. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />X manaya iy kisen ssawaȓeɣ s ȓemƹani. Waxxa xezzaren, war twiȓin ca. Waxxa tesȓan, war tesȓin ca war fehhmen i ca. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />Amenni iy ḏasen itkemmaȓ wawaȓ n nnabi Icaƹya ig inna ḏeg yijjen n zman:</para>
  <para style="q1" vid="MAT 13:14">&lt;Cḥaȓ ma tesȓim war tefhimem,</para>
  <para style="q2" vid="MAT 13:14">cḥaȓ ma ṯxezzarem war twiȓim.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Ȓaḥeqqac ccaƹb-a, uȓ nnes iḏweȓ am azru,</para>
  <para style="q2" vid="MAT 13:15">ƹȓayen war tesȓin walu,</para>
  <para style="q1" vid="MAT 13:15">qqnen ṯiṭṭawin nsen.</para>
  <para style="q2" vid="MAT 13:15">Ḥima war twiȓin ca s ṯiṭṭawin nsen,</para>
  <para style="q1" vid="MAT 13:15">war tesȓin ca s imejjan nsen,</para>
  <para style="q2" vid="MAT 13:15">war fehhmen ca s wuȓawen nsen,</para>
  <para style="q1" vid="MAT 13:15">aɣari d ḏewȓen, aṯen sgenfiɣ.&gt;<note caller="+" style="f"><char style="fr" closed="false">13.15 </char><char style="ft" closed="false">Xzar Icaƹya (Esaïe) 6:9-10.</char></note><verse eid="MAT 13:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />Walakin ssaƹd nwem kenniw wami ṯiṭṭawin nwem twaȓant, ssaƹḏ nwem wami imejjan nwem tesȓan. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Aqa tesȓam ȓḥaqq: Aṭṭas n lʼanbiya ḏ ȓmuminin rzun aḏ ẓren min twaȓam, walakin war ṯ ẓrin ca. Rzun aḏ sȓen min ṯesȓam, walakin war ṯ sȓin ca.<verse eid="MAT 13:17" /></para>
  <para style="s">Asfhem n ȓmaƹna n wenni izerrƹen</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />Iwa ṣennṭeṯ ȓmaƹna n ufeǧaḥ nni izerrƹen. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Ijjen itsȓa i wawaȓ x ȓmulk ujenna war ṯ itefhim ca. Iƹni netta am zzarriƹeṯ nni ig iwḍan x ubriḏ. Itraḥ Uƹeffan nni <char style="it">n Ibȓis</char>, itekkes awaȓ nni itwazerƹen ḏayes ḏeg wuȓ. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Zzarriƹeṯ nni ig iwḍan jar yizra nettaṯ am can bnaḏem ig itesȓan i wawaȓ n Arebbi iqbeȓ-iṯ s ȓefraḥeṯ. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Wami war yuwṯi bu iẓewran mliḥ ḏeɣya tneqȓaƹen. Xmi d tasent can ȓemḥayen niɣ ḏ can uƹeddeb x ssabab n wawaȓ n Arebbi, ḏeɣya iteffeɣ abriḏ. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Zzarriƹeṯ nni ig iwḍan jar isennanen nettaṯ am yijjen n bnaḏem iy itesȓan i wawaȓ n Arebbi ḏayes amnus n ddunect, icemmeṯ-iṯ ṭṭmaƹ n wagȓa, ssenni itwajeyyef wawaȓ n Arebbi war ineffeƹ ca. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Walakin zzarriƹeṯ nni ig iwḍan ḏi ṯmurṯ ṯaṣebḥant nettaṯ am can bnaḏem ig itesȓan i wawaȓ n Arebbi, ifehhem-as itarew. Ijjen itarew miyya, ijjen settin, ijjen ṯȓaṯin."<verse eid="MAT 13:23" /></para>
  <para style="s">Ȓmaƹna n isennanen</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Issiweȓ Ƹisa s yijjen n ȓmaƹna nneɣni inna-asen: "Ȓmulk ujenna igga am yijjen n uryaz izreƹ zzarriƹeṯ ṯaṣebḥant ḏeg umarjeƹ nnes. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" /><char style="it">Ijjen n ǧiȓeṯ</char> wami ṭṭṣen marra iwḏan, yusa-d ȓaƹḏu nnes izreƹ zzarriƹeṯ n isennanen ak zzarriƹeṯ nni n yirḏan ȓexddenni yarweȓ. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Wami d gaƹƹḏen yirḏan ggin ṯiyḏerin, ȓexddenni gaƹƹḏen-d akiḏsen uȓa ḏ isennanen. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Usin-d ixeddamen nnan-as i bab n umarjeƹ: A siḏi, cek ṯzerƹeḏ zzarriƹeṯ ṯaṣebḥant ḏeg umarjeƹ nnec. Iwa manis ḏas d kkin isennanen-a? <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />Inna-asen: Can ȓaƹḏu ig iggin manaya. Nnan-as ixeddamen nnes: Ma ṯexseḏ a nraḥ a nekkes isennanen-a? <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Inna-asen: Lla, bac war kiḏsen ṯqeǧƹem ca uȓa ḏ irḏan. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Jjeṯ irḏan aḏ mɣaren ak isennanen. Axmi d ɣa yaweḍ ȓweqṯ n umjar aḏasen iniɣ i icewwaren: Kkseṯ isennanen ḏ amezwaru smunem-ṯen ceddem-ṯen ḥima aḏ ḥarqen. Walakin irḏan jemƹem-ṯen awim-ṯen ɣar ṯesrafin inu."<verse eid="MAT 13:30" /></para>
  <para style="s">Ȓemƹani n zzariƹeṯ n bugarḏaȓ ḏ untun<note caller="+" style="f"><char style="fr" closed="false">13.31 </char><char style="ft" closed="false">Antun netta ḏ amṯun.</char></note></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Inna-asen Ƹisa ijjen n ȓmaƹna nneɣni: "Ȓmulk ujenna igga am yijjen n zzarriƹeṯ n yijjen n nnuƹ n arbiƹ qqaren-as bugarḏaȓ. Iysi-t ijjen n uryaz iẓẓu-t ḏeg umarjeƹ nnes. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Tiȓi nettaṯ ḏ ṯamezyant qaƹ x marra ṯiḥebba. Walakin xmi temɣar ṯḏewweȓ ktar zi marra arbiƹ. Ṯḏewweȓ ḏ ṯacejjarṯ, tasen-d yijḍaḍ teggen ḏayes ȓaƹwac nsen."<verse eid="MAT 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Inna-asen Ƹisa ijjen n ȓmaƹna nneɣni: "Ȓmulk ujenna am untun ṯeysi-ṯ yijjen n ṯemɣarṯ ṯuggwa zzayes ȓmudd n waren, antun nni isgaƹƹeḏ-iṯ-iḏ marra."<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Qaƹ manaya inna-ṯ Ƹisa i yiwḏan s ȓemƹani. War kiḏsen issiwiȓ illa s ȓemƹani waha. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Ḥima aḏ ikemmeȓ wawaȓ iy inna Siḏi Arebbi i nnabi <char style="it">Icaƹya</char> ḏeg yijjen n zman:</para>
  <para style="q2" vid="MAT 13:35">&lt;Akisen ssiwȓeɣ s ȓemƹani,</para>
  <para style="q1" vid="MAT 13:35">aḏ sexbareɣ min innuffaren zeg wami ṯeǧa ddunect.&gt;"<note caller="+" style="f"><char style="fr" closed="false">13.35 </char><char style="ft" closed="false">Xzar Zzabur (Psaumes) 78:2.</char></note><verse eid="MAT 13:35" /></para>
  <para style="s">Asfhem n ȓmaƹna n isennanen</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Ijja Ƹisa ȓɣaci nni yuḏef ɣar ṯeddarṯ. Ȓexddenni usin-d ɣares imeḥḍaren nnes nnan-as: "Fesser-aneɣ ȓmaƹna n isennanen ḏeg umarjeƹ."<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Indeq-d Ƹisa inna-asen: "Wenni izerrƹen zzarriƹeṯ ṯaṣebḥant netta ḏ Mmis n bnaḏem. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Amarjeƹ netta ḏ ddunect. Zzarriƹeṯ ṯaṣebḥant nettaṯ ḏ ṯarwa n ȓmulk ujenna. Isennanen niṯni ḏ ṯarwa n Uƹeffan nni <char style="it">n Ibȓis</char>. <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />Ȓaƹḏu ig izerrƹen isennanen netta ḏ Ibȓis. Ȓweqṯ n umjar nettaṯ ḏ ȓefna n zman. Ixeddamen niṯni ḏ lmalaʼikaṯ. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Amecnaw mammec ismun ufeǧaḥ isennanen isḥerreq-iṯen ḏi ṯmessi, amenni iy ɣa ṯiȓi ȓefna n zman. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Aḏ d issekk Mmis n bnaḏem lmalaʼikaṯ nnes, aḏ kksent zi ȓmulk nnes marra min itsebbaben ḏi ȓmuƹṣiyaṯ ḏ yinni iteggen ccarr. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Aṯen nḍaren ḏi ȓkuceṯ n ṯmessi mani ɣa iȓin imeṭṭawen ḏ uɣeẓẓaẓ n ṯeɣmas. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Walakin ȓmuminin aḏ cƹecƹen am ṯfuct ḏi ȓmulk n Babaṯsen. Ṣenneṭ mliḥ a wenni itsȓan.<verse eid="MAT 13:43" /></para>
  <para style="s">Ȓemƹani n ȓkenz ḏ jjuwhar ḏ ṯracca</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />Ȓmulk ujenna amecnaw ijjen n ȓkenz ixzen ḏi can umarjeƹ, yufi-ṯ can ḥadd iƹaweḏ isnuffar-iṯ. Uca s ȓefraḥeṯ nni iy ḏayes, izzenz marra min ɣares isɣa amarjeƹ nni.<verse eid="MAT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />Ȓmulk ujenna amecnaw ijjen n ttajar iy irezzu x jjuwhar aṣebḥan. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Wami yufa ijjen n jjuwhar iɣȓan, izzenz marra min ɣares isɣi-ṯ.<verse eid="MAT 13:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />Ȓmulk ujenna amecnaw ṯracca inḍar-it <char style="it">ij ubeḥri</char> ḏi ȓebḥar, ṯeṭṭef mkuȓ nnuƹ n usȓem. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Wami ṯƹemmar ṯracca sufɣen-t-id <char style="it">ibeḥriyen</char> ɣar ṭṭarf n ȓebḥar. Qqimen, bḏan tixḍaren ggin iseȓman iṣebḥanen ḏi ṯsuǧaṯin, iseȓman iƹeffanen nḍaren-ṯen. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Ammu iy ɣa yiȓi nhar iy ḏi ɣa ifna zman: Aḏ d asent lmalaʼikaṯ aḏ fernent ȓkuffar zi ȓmuminin; <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />aṯen nḍarent ḏi ȓkuceṯ n ṯmessi mani ɣa iȓin imeṭṭawen ḏ uɣeẓẓaẓ n ṯeɣmas."<verse eid="MAT 13:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />
    <char style="it">Inna-asen Ƹisa i imeḥḍaren nnes:</char> "Ma ṯfehmem marra manaya?" Nnan-as: "Wah a Siḏi." <verse eid="MAT 13:51" /><verse number="52" style="v" sid="MAT 13:52" />Inna-asen: "Kuȓ amseȓmaḏ n Ccariƹa n Musa ig ifehmen ȓmulk ujenna netta am yijjen n bab n ṯeddarṯ ig isufuɣen ṯimesȓayin ṯiqḏimin niɣ ḏ jḏiḏ zi mani ixzen ȓkenz nnes."<verse eid="MAT 13:52" /></para>
  <para style="s">Tazzȓen x Siḏiṯneɣ Ƹisa zeg ubilaj nnes</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Wami ikemmeȓ Ƹisa ȓemƹani nni, yuyur ssenni. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Iḏweȓ ɣar ṯmurṯ nnes ibḏa iseȓmaḏ ḏi ṯemziḏa nsen. Tƹejjben ḏayes nnan: "Mani yufa ȓefhameṯ-a iy ḏas immucen ḏ lmuƹjizaṯ-a? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Ma war iǧi ca wanita ḏ mmis n unejjar? Ma war iǧi yemmas ḏ Maryam? Ayṯmas ijjen qqaren-as Yaƹqub, ijjen ḏ Yusef, ijjen ḏ Simƹan, ijjen ḏ Yahuḏa ma lla? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Ma war ǧint ca suyṯmas aqaṯent akiḏneɣ ḏanita? Iwa manis ḏas d ikka marra manaya?" <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />X manayenni war ṯ qbiȓen ca.</para>
  <para style="p" vid="MAT 13:57">Ikkar Ƹisa inna-asen: "Nnabi meḥtarem mani ma, walakin ḏeg ubilaj nnes ḏ ṯeddarṯ nnes lla!" <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Igga ḏinni Ƹisa ḏrus n lmuƹjizaṯ ȓaḥeqqac lʼiman nsen ḏ uqlil.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Ȓmewṯ n Siḏna Yaḥya</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Ḏi ȓweqṯ nni azeǧiḏ Hirudus yarra-d ȓexbar x Ƹisa. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />Inna-asen i ixeddamen nnes: "Wanita iƹenni ḏ Yaḥya nni,<note caller="+" style="f"><char style="fr" closed="false">14.2 </char><char style="ft" closed="false">Yaḥya iy itṭehharen s waman.</char></note> itwasekkar-d netta zi ȓmewṯ! S manaya iy ɣares jjheḏ iy zi itegg lmuƹjizaṯ-a."<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />
    <char style="it">Qbeȓ i manaya,</char> azeǧiḏ Hirudus tuɣa iṭṭef Yaḥya icedd-iṯ iggi-ṯ ḏi ȓeḥbes x ssabab n Hirudiya ṯamɣarṯ n wumas Filippas. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Ȓaḥeqqac iqqar-as Yaḥya i uzeǧiḏ Hirudus: "Ḥram cek aḏ tawiḏ ṯamɣarṯ n wumac." <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Azeǧiḏ Hirudus irezzu aḏ ineɣ Yaḥya, walakin iggweḏ zi ccaƹb ȓaḥeqqac Yaḥya twaȓan-ṯ ḏ nnabi. <verse eid="MAT 14:5" /><verse number="6" style="v" sid="MAT 14:6" />Wami igga uzeǧiḏ Hirudus ȓƹiḏ lmilad nnes, ṯekkar yeǧis n ṯemɣarṯ nnes Hirudiya ṯecḍeḥ zzaṯ i inewjiwen, iƹjeb-as ȓḥaȓ i uzeǧiḏ Hirudus. <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />X manaya ijjuǧ inna-as Ttar-ayi min ṯexseḏ, aḏam ṯ uceɣ. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Nettaṯ ƹlaḥsab min ḏas ṯweṣṣa yemmas, ṯekkar ṯenna-as i uzeǧiḏ Hirudus: "Uc-ayi-d ḏa azeǧif n Yaḥya x ssiniyyeṯ!" <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Ȓexddenni indem uzeǧiḏ, walakin iweṣṣa aḏas ṯ yuc ȓaḥeqqac tuɣa ijjuǧ zzaṯ i inewjiwen ḏi ȓfarḥ nnes. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Issekk ɣar ȓeḥbes wenni ḏas ɣa iqessen azeǧif i Yaḥya. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Yuwi-d azeǧif nnes ḏi ssiniyyeṯ yuca-as-ṯ i ṯḥenjirṯ nni, ṯruḥ ṯuwi-yas-ṯ i yemmas. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Kkaren imeḥḍaren n Yaḥya usin-d ysin ddat nnes ggin-t ḏeg unḍeȓ. Ssenni uyuren, xbaren Ƹisa s min iweqƹen.<verse eid="MAT 14:12" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa isecc xemsaȓaf n iryazen</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Wami d yarra Ƹisa ȓexbar nni, iruḥ ssenni waḥḏes ḏi ṯɣarrabut ɣar yijjen n umcan ixȓa. Arrin-d ȓexbar ȓɣaci, ḏfaren-ṯ zi ṯneddam<note caller="+" style="f"><char style="fr" closed="false">14.13 </char><char style="ft" closed="false">Ṯineddam niṯenti ḏ ṯindinin.</char></note> x iḍaren. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Wami d iḍra Ƹisa zi ṯɣarrabut yufa qaƹ anect nni n yiwḏan, qqsen-as isgenfa imehȓac nsen.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Wami iƹḏu ȓḥaȓ, qarrben ɣares imeḥḍaren nnes nnan-as: "Ȓweqṯ ṯeƹḏu, amcan-a ḏ ȓexȓa waha. Sekk iwḏan-a ɣar ȓedcuraṯ bac aḏ d sɣen min ɣa ccen."<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Inna-asen Ƹisa: "Mayemmi ɣa raḥen? Ucem-asen kenniw min ɣa ccen."<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />Nnan-as imeḥḍaren nnes: "Neccin ɣarneɣ ḏa ɣir xemsa n ṯxebbazin ḏ ṯnayen n iseȓman."<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />Inna-asen: "Awim-ayi-d manayenni ɣari nec." <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Yumar ȓɣaci nni aḏ qqimen x arbiƹ. Iṭṭef xemsa n ṯxebbazin nni ḏ ṯnayen n iseȓman nni, iysi ṯiṭṭawin nnes ɣar ujenna icekkar Arebbi. Irza ṯixebbazin nni <char style="it">x ṯnayen</char> yuca-asen-ṯent i imeḥḍaren nnes, ȓexddenni ferqen-ṯent x yiwḏan nni marra. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Marra ccin jjiwnen. Kkaren jemƹen min xasen iceṭṭen, ṯenƹac n ṯeqrabin ƹemmarent s iȓeqquzen. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Lƹadad n yinni iccin niṯni xemsaȓaf n iryazen bȓa ṯimɣarin bȓa iḥenjiren.<verse eid="MAT 14:21" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa iggur x ȓemwaj n ȓebḥar</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Ȓexddenni yumar Ƹisa imeḥḍaren nnes aḏ nyen ḏi ṯɣarrabut aḏ ẓwan ɣar ujemmaḍ-in n ȓebḥar, netta itemsafaḍ x ȓɣaci. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Wami xasen imsafaḍ x ȓɣaci nni, igaƹƹeḏ ɣar uḏrar aḏ iẓẓaǧ ḏinni waḥḏes. Ɣar ṯmeddiṯ ƹaḏ aqaṯ ḏinni waḥḏes. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Ṯaɣarrabut nni ṯeggwej aṭṭas zi ȓbarr, ȓemwaj tawin-teṯ tarran-teṯ ȓaḥeqqac arriḥ itṣuḍ-d zi jjiheṯ nneɣni. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />Ƹȓayen iqarreb-d ȓefjar, iruḥ Ƹisa ɣar imeḥḍaren nnes iggur x iḍaren x waman n ȓebḥar. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Wami ṯ ufin iggur x iḍaren x waman n ȓebḥar, nxeȓƹen nnan qa wanita ḏ ȓexyaȓ! Snekkaren ṯɣuyyeṯ s ṯiggwḏi.<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Ȓexddenni inna-asen Ƹisa: "Ahnam! Aqa ḏ nec, war teggwḏem ca!"<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Inna-as Buṭrus: "A Siḏi meȓa ḏ cek, ȓaɣa-ayi-d aɣarek d aseɣ x waman."<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />Inna-as Ƹisa: "Araḥ-d!" Ikkar ihwa-d Buṭrus zi ṯɣarrabut iggur x iḍaren x waman ɣar Ƹisa. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Walakin iggweḏ wami iẓra arriḥ itṣuḍ s jjheḏ, ibḏa iɣarreq. Isnekkar ṯɣuyyeṯ inna: "A Siḏi, ƹṯeq-ayi!" <verse eid="MAT 14:30" /><verse number="31" style="v" sid="MAT 14:31" />Ȓexddenni yuca-as Ƹisa fus nnes iṭṭef-iṯ inna-as: "Lʼiman nnec ḏ uqlil waha, mayemmi iy ḏayi ṯcekkeḏ?" <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />Ṣafi nyan ḏi ṯɣarrabut irsa arriḥ nni. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Uca sejjḏen-as yinni iǧan ḏi ṯɣarrabut nnan: "Ḏ ṣṣaḥ, cek ḏ Mmis n Arebbi!"<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Wami iẓwa Ƹisa netta ḏ imeḥḍaren nnes ȓebḥar, uwḍen ɣar ṯmurṯ n Ganisarat. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Ayṯbab n ṯmurṯ nni ẓrin Ƹisa ƹeqȓen-ṯ. Ȓexddenni sufɣen ȓexbar ḏi marra ṯamurṯ nni, uwin-as-d imehȓac marra. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Ttaren-as aṯen ijj aḏ ḥaḏan ɣir ṭṭarf n warruḍ nnes. Ṣafi marra yinni ṯ iḥaḏan genfan.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">Lƹadaṯ iy war d yusin ca zi Arebbi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Ssenni usin-d ȓḥizeb n ifarrisiyen ḏ imseȓmaḏen n ccariƹa ɣar Ƹisa zi ṯendint n Lquds nnan-as: <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />"Mayemmi imeḥḍaren nnec beṭṭȓen lƹadaṯ n ȓejḏuḏ nneɣ? Mayemmi war siriḏen ca ifassen nsen qbeȓ ma aḏ ccen aɣrum?"<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Indeq-d Ƹisa inna-asen: "Iwa mayemmi kenniw ṯbeṭṭaȓem ȓuṣiyeṯ n Arebbi ḥima aḏ tesxeḏmem lƹadaṯ nwem? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Minzi Arebbi inna: Weqqar babac ḏ yemmac.<note caller="+" style="f"><char style="fr" closed="false">15.4 </char><char style="ft" closed="false">Xzar Ufuɣ (Exode) 20:12 ḏ Afessar n Ccariƹa n Musa (Deutéronome) 5:16.</char></note> Aqa wenni ɣa yukkaren babas niɣ ḏ yemmas, ataf itxeṣṣa-yas aḏ immeṯ.<note caller="+" style="f"><char style="fr" closed="false">15.4 </char><char style="ft" closed="false">Xzar Ufuɣ (Exode) 21:17 ḏ Lkitab n Ayṯ Lawi (Lévitique) 20:9.</char></note> <verse eid="MAT 15:4" /><verse number="5-6" style="v" sid="MAT 15:5-6" />Walakin kenniw ṯeqqarem belli war iǧi bu labud i yiwḏan aḏ weqqaren niɣ aḏ ƹawnen lwalidin. Tmenyaṯ nni iy ɣa ucen i lwalidin nsen aṯent ucen i ṯemziḏa. Ammu kenniw ṯbeddȓem ȓmaƹna n wawaȓ n Arebbi ḥima aḏ teggem mammec ḏawem iƹjeb ȓḥaȓ s lƹadaṯ nwem. <verse eid="MAT 15:5-6" /><verse number="7" style="v" sid="MAT 15:7" />A lmunafiqin! Qa nnabi Icaƹya inna ȓḥaqq wami xawem issiweȓ ḏeg yijjen n zman:<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />&lt;Ccaƹb-a itweqqar-ayi s uqemmum waha,</para>
  <para style="q2" vid="MAT 15:8">maca uȓ nnes iggwej xafi.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Iwḏan-a ƹebbḏen-ayi ḏi ȓxawi,</para>
  <para style="q2" vid="MAT 15:9">ȓaḥeqqac seȓmaḏen ṯimesȓayin iǧan ḏ ȓuṣiyaṯ n bnaḏem waha.&gt;"<note caller="+" style="f"><char style="fr" closed="false">15.9 </char><char style="ft" closed="false">Xzar Icaƹya (Esaïe) 29:13.</char></note><verse eid="MAT 15:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Iȓaɣa-d Ƹisa i ȓɣaci inna-asen: "Sennṭeṯ <char style="it">mliḥ</char>, fehmeṯ: <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Ma ḏinni ca n ṯmesȓayṯ itaḏfen aqemmum tḥarram bnaḏem?" Inna-asen: "Lla, min d iteffɣen zeg uqemmum aqa manayenni ig itḥarramen bnaḏem."<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Qarrben-d ɣares imeḥḍaren nnes nnan-as: "Ma ṯessneḏ belli ifarrisiyen war ḏasen iƹjib bu ȓḥaȓ wami sȓan i wawaȓ nnec?"<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Indeq-d Ƹisa inna-asen: "Kuȓ arbiƹ war ṯ iẓẓu ca Baba iǧan ḏeg ujenna aḏ ineqȓeƹ s iẓewran nnes. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Jjem-ṯen! Niṯni ḏ iḍarɣaȓen tjarran iḍarɣaȓen. Meȓa aḍarɣaȓ ijarr aḍarɣaȓ, ataf aḏ wḍan s ṯnayen iḏsen ḏi can ṯesrafṯ."<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Inna-as Buṭrus: "Fesser-aneɣ ȓmaƹna-ya."<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />Inna-as Ƹisa: "Uȓa ḏ kenniw ƹaḏ war ṯefhimem ca? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Ma war ṯessinem belli min itaḏfen ḏeg uqemmum itraḥ ɣar uƹeddis iteffeɣ zi ddat? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Walakin min d iteffɣen zeg uqemmum itas-d zeg wuȓ, u ḏ manaya itḥarramen bnaḏem. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Ȓaḥeqqac zeg wuȓ iy zi d tekkant lʼafkar ṯiƹeffanin ḏ ṯmenɣiwṯ ḏ zzna ḏ lfasad ḏ ṯukkarḏa ḏ ẓẓur ḏ ȓbaṭeȓ. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Ḏ ṯimesȓayin-a ig itḥarramen bnaḏem. Walakin meȓa icca s ifassen bȓa ma ṯen isireḏ ataf war itḥarrim bu bnaḏem."<verse eid="MAT 15:20" /></para>
  <para style="s">Lʼiman n ṯemɣarṯ n Ayṯ-Kanƹan</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Ikkar Ƹisa yuyur ssenni iruḥ ɣar jwayeh n ṯendint n Ṣur ḏ ṯendint n Ṣayda. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Ṯusa-d ɣares ijjen n ṯemɣarṯ zi Ayṯ-Kanƹan<note caller="+" style="f"><char style="fr" closed="false">15.22 </char><char style="ft" closed="false">Iwḏan n Ayṯ-Kanƹan war ǧin ca zi Ayṯ-Israʼil.</char></note> ṯzeddeɣ ḏinni. Traɣa ṯeqqar-as i Ƹisa: "Rḥem-ayi a Siḏi, a Mmis n Ayṯ-Dawed! Qa yeǧi ḏayes ijjen n jjenn ḏ aƹeffan itƹeddab-it aṭṭas."<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />War ḏas inni Ƹisa uȓa ḏ ijjen n wawaȓ. Qarrben ɣares imeḥḍaren nnes nnan-as: "Ṯamɣarṯ-a sufeɣ-it xaneɣ, <char style="it">zi ṣbaḥ</char> nettaṯ ṯḏeffar-aneɣ ṯesɣuyiw xaneɣ."<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Inna-asen Ƹisa: "Qa nec twassekkeɣ-d ɣir ɣar iḥuȓiyen iweddaren, iƹni iwḏan n Ayṯ-Israʼil."<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Walakin ṯamɣarṯ nni ṯusa-d ɣares ṯsejjeḏ-as ṯenna-as: "A Siḏi, ƹawen-ayi!"<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Indeq-d Ƹisa inna-as: "Maci maƹqul aḏ itwakkes uɣrum n iḥenjiren aḏ imenḍar i iqzinen."<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />Ṯenna-as ṯemɣarṯ nni: "Ɣarek ȓḥaqq a Siḏi, walakin uȓa ḏ iqzinen nni tetten ifetwitten n uɣrum ig itweṭṭan zi ṭabȓa n ayṯbab nsen."<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Ikkar Ƹisa inna-as: "Cem a ṯamɣarṯ, lʼiman nnem ijheḏ s waṭṭas!" Inna-as: "Min ṯrezzuḏ aḏ tafeḏ." Ḏi ṯsaƹƹat nni ṯgenfa yeǧis.<verse eid="MAT 15:28" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa isecc arbeƹaȓaf n iryazen</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Ibeƹƹeḏ ssenni Ƹisa, yuyur x cceṭṭ n ȓebḥar n Ljalil. Igaƹƹeḏ ɣar yijjen n uḏrar iqqim ḏinni. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Usin-d ɣares aṭṭas n ȓɣaci. Uwin-d akiḏsen izeḥḥafen ḏ iḍarɣaȓen ḏ izeynunen ḏ inecrufen ḏ waṭṭas n imehȓac nneɣni. Sersen-ṯen ɣar iḍaren nnes isgenfa-ṯen. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Tƹejjben yiwḏan nni wami ẓrin izeynunen ssawaȓen, inecrufen genfan, izeḥḥafen gguren, iḍarɣaȓen twaȓan. Kkaren ḥemḏen Arebbi n Ayṯ-Israʼil.<verse eid="MAT 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Iȓaɣa-d Ƹisa i imeḥḍaren nnes inna-asen: "Nec qqsen-ayi yiwḏan-a. Ṯeȓtiyyam zeg wami aqaṯen akiḏi war ɣarsen ca min ɣa ccen. War xseɣ ca aṯen ssekkeɣ niṯni war ccin ca ḥima war tesxiffen x ubriḏ."<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Nnan-as imeḥḍaren nnes: "Ḏi ȓexȓa-ya mani ɣa naf aɣrum iy zi ɣa nsecc qaƹ lƹadad-a n yiwḏan?"<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Inna-asen Ƹisa: "Cḥaȓ ɣarwem n uɣrum?"</para>
  <para style="p" vid="MAT 15:34">Nnan-as: "Ɣarneɣ sebƹa n ṯecnifin ḏ ca n iseȓman ḏ imezyanen."<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Yumar Ƹisa ȓɣaci aḏ qqimen ḏi ṯmurṯ. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Iṭṭef sebƹa nni n ṯecnifin ḏ iseȓman nni, icekkar Arebbi. Irzi-ṯen yuci-ṯen i imeḥḍaren nnes, imeḥḍaren nnes ferqen-ṯen x ȓɣaci nni. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Marra ccin jjiwnen, ceṭṭent sebƹa n ṯeqrabin ƹemmarent s iȓeqquzen. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Marra iryazen nni ig iccin niṯni arbeƹaȓaf iḏsen bȓa ṯimɣarin bȓa iḥenjiren. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Wami imsafaḍ xasen Ƹisa x ȓɣaci nni, inya ḏeg yijjen n ṯɣarrabut iruḥ ɣar jwayeh n Magdala.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">Iwḏan war tefhimen min ƹnant lmuƹjizaṯ n Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Usin-d ɣar Ƹisa ȓḥizeb n ifarrisiyen ḏ ȓḥizeb n iṣadduqiyen, ttaren zzayes ijjen n lƹalama ḏ ṯameqqrant zeg ujenna bac aṯ jarrben. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Indeq-d Ƹisa inna-asen: "Ɣar ȓmeɣreb ṯeqqarem <char style="it">ṯiwecca</char> aḏ yiȓi ljaw ḏ aṣebḥan ȓaḥeqqac ajenna ḏ azeggwaɣ. <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Ɣar ȓefjar ṯeqqarem: Nhara aḏ yiȓi unẓar ḏ wajjaj ȓaḥeqqac ajenna ḏ azeggwaɣ ḏayes aseynu<note caller="+" style="f"><char style="fr" closed="false">16.3 </char><char style="ft" closed="false">Aseynu netta ḏ asegnu.</char></note> ḏ abercan. Lḥala n ujenna ṯessnem at tcerrḥem. Walakin lƹalamaṯ n zman-a lla, war ṯzemmarem aṯent tcerrḥem. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Iwḏan iƹeffanen n ȓweqṯ-a ixeddƹen Arebbi tettaren lƹalama ṯameqqrant, walakin war ḏasen itmuci illa lƹalama nni n nnabi Yunes." Ssenni iruḥ ijji-ṯen.<verse eid="MAT 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Wami uwḍen imeḥḍaren nnes ɣar ujemmaḍ-in <char style="it">n ȓebḥar</char> ttun war kisen uwin ca aɣrum. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Inna-asen Ƹisa: "Ɣarwem! Ḥḍam ixef nwem zeg untun<note caller="+" style="f"><char style="fr" closed="false">16.6 </char><char style="ft" closed="false">Antun netta ḏ amṯun.</char></note> n lʼaḥzab n ifarrisiyen ḏ iṣadduqiyen." <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />Ssiwȓen jarasen nnan: "<char style="it">Iqqar manaya ȓaḥeqqac</char> war d nuwi bu uɣrum."<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Issen Ƹisa minxef tuɣa ssawaȓen inna-asen: "Kenniw lʼiman nwem ḏ uqlil. Mayemmi ṯeqqarem jarawem war ɣarneɣ bu uɣrum? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Ma ƹaḏ war ṯefhimem? War ṯeƹqiȓem xemsa nni n ṯecnifin <char style="it">ig iseccen</char> xemsaȓaf <char style="it">n iryazen</char>, mecḥaȓ n ṯeqrabin iy ṯeccurem? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" /><char style="it">War ṯeƹqiȓem</char> sebƹa nni n ṯecnifin <char style="it">ig iseccen</char> arbeƹaȓaf <char style="it">n iryazen</char>, mecḥaȓ n ṯeqrabin iy ṯeccurem? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Mammec ṯeggim war ṯefhimem? Nec war ssiwiȓeɣ ca x uɣrum. Ḥḍam ixef nwem zeg untun n lʼaḥzab n iṣadduqiyen ḏ ifarrisiyen."<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />Ȓexddenni ƹaḏ iy fehmen imeḥḍaren belli war ḏasen issiwiȓ ca x untun n uɣrum; Lla, inna-asen: Ḥḍam ixef nwem zi min seȓmaḏen ifarrisiyen ḏ iṣadduqiyen.<verse eid="MAT 16:12" /></para>
  <para style="s">Buṭrus icehheḏ x Lmasiḥ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Wami yuweḍ Ƹisa ɣar jjiheṯ n ṯendint n Qayṣariya n Filippas, isseqsa imeḥḍaren nnes inna-asen: "Min qqaren yiwḏan x Mmis n bnaḏem?"<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />Nnan-as: "Ijjen iqqar cek ḏ Yaḥya,<note caller="+" style="f"><char style="fr" closed="false">16.14 </char><char style="ft" closed="false">S ṯayunaniṯ, Yaḥya ig itṭehharen s waman.</char></note> ijjen iqqar cek ḏ Ilyas, ijjen iqqar cek ḏ Irmiya niɣ ḏ can yijjen zi lʼanbiya."<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />Inna-asen Ƹisa i imeḥḍaren nnes: "Y kenniw, min ḏayi d tarram nec?"<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />Indeq-d Simƹan Buṭrus inna-as: "Cek ḏ Lmasiḥ, Mmis n Arebbi iddaren."<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Ȓexddenni inna-as Ƹisa: "Ssaƹḏ nnec a Simƹan a mmis n Yuna! War iǧi bu ḏ ca n bnaḏem iy ḏac d ismeḍharen manaya menɣir Baba iǧan ḏeg ujenna. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Nec ƹaweḏ aqa qqareɣ-ac: Cek ḏ Buṭrus, <char style="it">iƹni ḏ 'Azru.'</char> X uzru-ya aḏ bniɣ nec jmaƹṯ n ȓmuminin inu, ṯiwwura n Ljaḥim war zzayes tiwint walu! <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Aḏac uceɣ ȓemfataḥ n ȓmulk ujenna. Min ɣa ṯceddeḏ ḏi ṯmurṯ aḏ yiȓi itwacedd ḏeg ujenna. Min ɣa ṯerzmeḏ ḏi ṯmurṯ aḏ yiȓi itwarzem ḏeg ujenna." <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Ȓexddenni Ƹisa iweṣṣa imeḥḍaren nnes inna-asen war qqarem i ḥadd belli nec ḏ Lmasiḥ.<verse eid="MAT 16:20" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa issawaȓ x ȓmewṯ nnes</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Ssenni ibḏa Ƹisa isfehham i imeḥḍaren nnes belli labud aḏ iraḥ netta ɣar ṯendint n Lquds aḏ itwaƹeddeb x waṭṭas n ṯmesȓayin x ufus n imeqqranen n Ayṯ-Israʼil ḏ arruyas n ȓfuqaha ḏ imseȓmaḏen n ccariƹa. Aṯ nɣen, wis ṯeȓtiyyam aḏ d itwasekkar zi ȓmewṯ."<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Isbeƹƹeḏ-iṯ Buṭrus waḥḏes inha-ṯ inna-as: "Ac iḥfeḍ Arebbi a Siḏi! Ƹemmarṣ war ḏac itewqiƹ manaya."<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Walakin Ƹisa ineqȓeb-d ɣar Buṭrus inna-as: "Aggwej xafi ɣar ḏeffar a Cciṭan! Cek am yijjen n uzru ḏeg ubriḏ inu tneqȓaḏeɣ ḏayes. Cek war tfekkareḏ ca amecnaw Arebbi; Lla, cek tfekkareḏ amecnaw bnaḏem."<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Ssenni issiweȓ Ƹisa ak imeḥḍaren nnes inna-asen: "Wenni ixsen aḏayi iḏfar nec, labud aḏ ismeḥ ḏeg yixef nnes aḏ ikessi ṣṣalib nnes<note caller="+" style="f"><char style="fr" closed="false">16.24 </char><char style="ft" closed="false">Ḏi ȓweqṯ nni n Siḏiṯneɣ Ƹisa arrumanus neqqen iwḏan ḏi ṣṣalib, iwḏan tƹeddaben aṭṭas ḏayes. Wenni iḏeffaren Siḏiṯneɣ Ƹisa ixeṣṣa-yas war iteggweḏ ca zi ṣṣalib nni, iƹni zi ȓmewṯ uȓa zeg uƹeddeb.</char></note> aḏayi iḏfar. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Ȓaḥeqqac wenni ixsen aḏ isenjem ṯuḏarṯ nnes ataf at ixsar. Wenni ɣa ixsaren ṯuḏarṯ nnes x ssabab inu ataf at yaf. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Minzi ɣa infeƹ bnaḏem meȓa irbeḥ ddunect-a qaƹ wa ixsar ȓaƹmar nnes? Min ɣa yuc bnaḏem ḏeg umcan n ȓaƹmar nnes? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Aqa Mmis n bnaḏem aḏ d yas s lƹaḍama n Babas ak lmalaʼikaṯ nnes, uca aḏ ijaza mkuȓ ijjen ƹlaḥsab ȓxeḏmeṯ nnes. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Aqa tesȓam ȓḥaqq: Ȓebƹaḍ zeg yinni iǧan ḏa akiḏi war tmettin ca aȓ ɣa ẓren Mmis n bnaḏem yusa-d ḏi ȓmulk nnes."<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">Siḏna Musa ḏ Siḏna Ilyas meḍharen-d ak Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Ṯeƹḏu settiyyam, Ƹisa yuwi akiḏes Buṭrus ḏ Yaƹqub ḏ wumas Yuḥanna, yuwi-ṯen waḥeḏsen ɣar yijjen n uḏrar yuƹȓa. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Ḏinni zzaṯ i ṯiṭṭawin nsen iḏweȓ am yijjen n nnur, aɣembub nnes itceƹciƹ am ṯfuct. Iḏweȓ warruḍ nnes ḏ acemȓaȓ ireqq am ṯfawṯ. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Imeḍhar-asen-d ḏinni nnabi Ilyas ḏ nnabi Musa. <char style="it">Twaȓan-ṯen</char> ssawaȓen ak Ƹisa.<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />Indeq-d Buṭrus inna-as i Ƹisa: "A Siḏi, ḏ aṣebḥan akiḏec neqqim ḏanita. Meȓa ṯexseḏ, aḏ ggeɣ ṯȓaṯa n iqiḍan: ijjen i cek, ijjen i Musa, ijjen i Ilyas."<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Ƹaḏ issawaȓ Buṭrus ihwa-d xasen yijjen n useynu itseqsiq. Ṯendeq-d ijjen n ṯmijja zeg useynu nni ṯenna-asen: "Qa ḏ wanita ḏ Mmi iƹizzen, nec farḥeɣ zzayes. Ṣennṭeṯ ɣares." <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />Wami sȓin imeḥḍaren ṯmijja nni ggwḏen sejjḏen ɣar ṯmurṯ. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Iqarreb ɣarsen Ƹisa iḥaḏa-ṯen inna-asen: "Kkarem war teggwḏem ca." <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Ysin ṯiṭṭawin nsen ɣar ujenna war ufin ḥadd illa Ƹisa.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Wami d hewwan zeg uḏrar iweṣṣa-ṯen Ƹisa inna-asen: "War tƹawaḏem i ḥadd min ṯeẓrim aȓ d ɣa ikkar Mmis n bnaḏem zi ȓmewṯ."<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Sseqsan-ṯ imeḥḍaren nnes nnan-as: "Mayemmi imseȓmaḏen n ccariƹa qqaren itxeṣṣa nnabi Ilyas aḏ d yas netta ḏ amezwaru?"<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Inna-asen Ƹisa: "Ḏ ṣṣaḥ, itxeṣṣa aḏ d yas Ilyas aḏ iƹḏeȓ kuȓci. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Walakin qqareɣ-awem: Aqa Ilyas nni yusa-d niṯni war ṯ ssinen ca, xeḏmen ḏayes min xsen. Amenni iy ɣa ƹeddben Mmis n bnaḏem."<verse eid="MAT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13" />Uca fehmen imeḥḍaren belli issawaȓ-asen x Yaḥya wenni itṭehharen s waman.<verse eid="MAT 17:13" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa isgenfa ij uḥenjir ḏayes jjenn</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Wami d ḏewȓen ɣar ȓɣaci, iqarreb ijjen n uryaz ɣar Ƹisa iwḍa x ifadden zzaṯ nnes. <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />Inna-as: "A Siḏi rḥem-ayi memmi, ijjen n jjenn itƹeddab-iṯ aṭṭas. Aṭṭas n ṯwaȓaṯin itweṭṭa ḏi ṯmessi niɣ ḏeg waman. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Uwiɣ-ṯ-iḏ ɣar imeḥḍaren nnec walakin niṯni war zemmaren aṯ sgenfan."<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Indeq-d Ƹisa inna-asen: "A iwḏan n ȓweqṯ-a iy ḏi war iǧi bu lʼiman, a yinni iffɣen abriḏ! Mecḥaȓ iy kiḏwem ɣa qqimeɣ u mecḥaȓ ḏawem ɣa ṣbareɣ? Awim-ayi-ṯ-id ḏa." <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Ƹisa isbedd jjenn nni aƹeffan, iffeɣ zeg uḥenjir nni igenfa ḏi ṯsaƹƹat nni.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Qarrben-d imeḥḍaren ɣar Ƹisa waḥḏes nnan-as: "Mayemmi zaƹma neccin tuɣa war nzemmar aṯ nsufeɣ?"<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />Inna-asen Ƹisa: "Ȓaḥeqqac lʼiman nwem ḏ uqlil. Aqa tesȓam ȓḥaqq: Mȓi ḏaywem lʼiman ɣir anect ijjen n ṯḥebbuct n bugarḏaȓ,<note caller="+" style="f"><char style="fr" closed="false">17.20 </char><char style="ft" closed="false">Ṯaḥebbuct n bugarḏaȓ nettaṯ ḏ ijjen n zzariƹeṯ n arbiƹ ḏ ṯamezyant aṭṭas.</char></note> aḏ tinim i uḏrar-a: Neqȓeƹ-d cek ssanita ruḥ ɣar ḏiha ataf aḏ d ineqȓeƹ. War xawem iteqsiḥ walu. <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />{Nnuƹa-ya n jjenn aṯ tsufɣem ɣir s ṯẓaǧiṯ ḏ uẓummi.}"<verse eid="MAT 17:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />
    <char style="it">Imeḥḍaren nnes</char> wami d munen akiḏes ɣar ṯmurṯ n Ljalil ikkar Ƹisa inna-asen: "Ƹȓayen aḏ itwasellem Mmis n bnaḏem ɣar ifassen n yiwḏan. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />Aṯ nɣen, nhar wis ṯeȓtiyyam aḏ d itwasekkar." Ȓexddenni xeyyqen imeḥḍaren s waṭṭas s wawaȓ nni.<verse eid="MAT 17:23" /></para>
  <para style="s">Ḍḍariba n ṯemziḏa ṯameqqrant</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Wami yuweḍ Ƹisa ḏ imeḥḍaren nnes ɣar ubilaj n Kafernaḥum, usin-d yinni ijemmƹen ḍḍariba i ṯemziḏa ṯameqqrant. Qarrben ɣar Buṭrus nnan-as: "Ma war itxeǧis ca lmuƹallim nwem ḍḍariba n ṯemziḏa ṯameqqrant?"<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />Inna-asen Buṭrus: "Wah, itxeǧas-it."</para>
  <para style="p" vid="MAT 17:25">Wami yuḏef Buṭrus ɣar ṯeddarṯ, Ƹisa izwar-as s wawaȓ inna-as: "Min ḏac imeḍharen a Simƹan? Uw ɣa ixeǧsen ȓaƹcur niɣ ḍḍariba i izeǧiḏen n ṯmurṯ, ma ḏ ṯarwa nsen niɣ ḏ iwḏan ƹadi?"<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />Inna-as Buṭrus: "Iwḏan ƹadi."</para>
  <para style="p" vid="MAT 17:26">Inna-as Ƹisa: "Iwa ṯarwa nsen war txeǧisen ca baƹda. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Walakin itxeṣṣa war nesxeyyeq ḥadd. Ruḥ ɣar ȓebḥar nḍar ṯiṣennarṯ ḏeg waman, asȓem nni iy ɣa ṯeṭṭfeḏ ḏ amezwaru, rzem-as aqemmum aḏayes ṯafeḏ ijjen n ṯpeyyast n nnuqarṯ. Ysi-t uc-asen-t, xeǧes xac ḏ xafi."<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Lʼiman ḏ ȓmuƹṣiyeṯ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Ḏi ṯsaƹƹat nni qarrben-d imeḥḍaren ɣar Ƹisa nnan-as: "Ug iǧan qaƹ ḏ ameqqran ḏi ȓmulk ujenna?"<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />Iȓaɣa-d Ƹisa x yijjen n uḥenjir ḏ amezyan, isbedd-iṯ ḏi ȓwesṭ nsen. <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />Inna-asen: "Aqa tesȓam ȓḥaqq: Labud i kenniw aḏ tḏewȓem aḏ tiȓim amecnaw iḥenjiren imezyanen. Meȓa lla, ataf ƹemmarṣ aḏ taḏfem ḏi ȓmulk ujenna. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Wenni isemzayen ixef nnes amecnaw aḥenjir-a, ḏ netta iy ɣa yiȓin ḏ ameqqran qaƹ ḏi ȓmulk ujenna. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Wenni ɣa iqebȓen can uḥenjir am wanita ƹlaḥsab isem inu, axmi ḏ nec ig iqbeȓ.<verse eid="MAT 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />Wenni iy ɣa yawin ijjen zeg imezyanen-a iy zzayi itamnen ɣar ȓmuƹṣiyeṯ, ḥsen i netta aḏas cedden ijjen n uzru n ṯsirṯ s usɣun ɣar yiri nnes aḏ itwaɣreq ḏi ȓaǧeɣ n ȓebḥar. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />Ya tamara n yiwḏan x ssabab n ṯmesȓayin itawin ɣar ȓmuƹṣiyeṯ. Ṯimesȓayin nni aḏ d asent, walakin ya tamara n bnaḏem nni ig iteggen manayenni!<verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />Cek fus nnec niɣ ḍar nnec meȓa itsebbab-ac ḏi can ȓmuƹṣiyeṯ, qess-iṯ zaƹma nḍar-iṯ. Ḥsen i cek aḏ taḏfeḏ jjenneṯ s yijjen n ufus niɣ s yijjen n uḍar zi meȓa qqimen ɣarek ṯnayen n ifassen niɣ ṯnayen n iḍaren aḏ tmenḍareḏ ḏi ṯmessi iy war ixessin ca ƹemmarṣ. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Cek ṯiṭṭ nnec meȓa tsebbab-ac ḏi can ȓefḍiḥeṯ, qȓeƹ-it zaƹma nḍar-it. Ḥsen i cek aḏ taḏfeḏ jjenneṯ s yijjen n ṯiṭṭ zi meȓa qqiment ɣarek ṯnayen n ṯiṭṭawin aḏ tmenḍareḏ ḏi jahennama n ṯmessi.<verse eid="MAT 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />Ɣarwem aḏ tḥeggarem can ḥadd zeg imezyanen-a. Qqareɣ-awem: Lmalaʼikaṯ nsen ḏeg ujenna ȓebda xezzarent Baba iǧan ḏeg ujenna. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />{Liʼanna Mmis n bnaḏem yusa-d aḏ inejja yinni iweddaren.}<verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />Min ḏawem imeḍharen? Ijjen ɣares miyya n iḥuȓiyen. Meȓa iweddar-as ijjen zzaysen, ataf aḏ ijj tesƹa u tesƹin ḏeg uḏrar aḏ iraḥ aḏ irzu x wenni iweddaren. <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Aqa tesȓam ȓḥaqq: Meȓa yufi-ṯ, ataf azzayes ifareḥ ktar zi min ɣa ifareḥ x tesƹa u tesƹin nni war iweddaren ca! <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Amenni uȓa ḏ Babaṯwem iǧan ḏeg ujenna war ixes uȓa ḏ ijjen zeg imezyanen-a aḏ iweddar.<verse eid="MAT 18:14" /></para>
  <para style="s">Umac ixḍa akiḏec</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />Meȓa ixḍa akiḏec wumac, ruḥ ɣares nha-ṯ ɣir cek ḏ netta ɣir s ṯnayen iḏwem. Meȓa igg-ac array, ataf aḏ tiȓiḏ mliḥ ƹaweḏ ak wumac. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Walakin meȓa yugi aɣarek iṣenneṭ, awi akiḏec ijjen niɣ ṯnayen ḥima ataf lɣaleṭ nnes ssnen-ṯ ṯnayen niɣ ṯȓaṯa n ȓechuḏ.<note caller="+" style="f"><char style="fr" closed="false">18.16 </char><char style="ft" closed="false">Xzar Afessar n Ccariƹa n Musa (Deutéronome) 19:15.</char></note> <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Walakin meȓa yugi aɣarsen iṣenneṭ, ini-ṯ i jmaƹṯ n ȓmuminin. U meȓa yugi aɣarsen iṣenneṭ, ḥseb-iṯ ḏ ȓkafer niɣ ḏ axeddaƹ.<note caller="+" style="f"><char style="fr" closed="false">18.17 </char><char style="ft" closed="false">Axeddaƹ netta s ṯayunaniṯ, wenni ijemmƹen ȓaƹcur.</char></note> <verse eid="MAT 18:17" /><verse number="18" style="v" sid="MAT 18:18" />Aqa tesȓam ȓḥaqq: Marra min ɣa ṯceddem ḏi ṯmurṯ ataf aḏ yiȓi itwacedd ḏeg ujenna. Marra min ɣa ṯerzmem ḏi ṯmurṯ ataf aḏ yiȓi itwarzem ḏeg ujenna.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />Qqareɣ-awem ƹaweḏ: Meȓa ṯtafqem ṯnayen zzaywem x ṯmurṯ ṯettarem can ȓḥajeṯ i Baba iǧan ḏeg ujenna, ataf aḏawem t istajeb. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Ȓaḥeqqac mani ɣa munen ṯnayen niɣ ṯȓaṯa x ssabab inu, nec aȓ ḏin iȓiɣ ḏi ȓwesṭ nsen."<verse eid="MAT 18:20" /></para>
  <para style="s">Ȓmaƹna n uxeddam iy ḏi war iǧi arraḥmeṯ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Ȓexddenni iqarreb Buṭrus ɣar Ƹisa inna-as: "A Siḏi, cḥaȓ n ṯwaȓaṯin iy kiḏi ɣa ixḍa wuma bac aḏas semḥeɣ? Ma sebƹa n ṯwaȓaṯin?"<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Inna-as Ƹisa: "Lla, war iǧi bu sebƹa n ṯwaȓaṯin, aḏac iniɣ sebƹin uweṯ-it ḏi sebƹa n ṯwaȓaṯin! <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />Ȓaḥeqqac ȓmulk ujenna itawi-d ḏeg yijjen n uzeǧiḏ irezzu aḏ igg ȓeḥsab ak ixeddamen nnes. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Wami ibḏa ḏi ȓeḥsab, uwin-d ɣares ijjen ḏayes aṭṭas n umarwas, am ƹecra aȓaf <char style="it">milyar</char>. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />War ɣares minzi ɣa yarr amarwas-a, iweṣṣa siḏes aḏ immenz netta ḏ ṯamɣarṯ nnes ḏ ṯarwa nnes ḏ marra min ɣares ḥima aḏ ixeǧes amarwas nni. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />Yusa-d uxeddam nni isejjeḏ-as i siḏes inna-as: Ahya a siḏi, ṣbar xafi. Aḏac xeǧseɣ marra min ḏayi tarseḏ. <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Ȓexddenni iqqes-as i siḏes iḏȓeq-as, ismeḥ-as ḏeg umarwas nni.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />Iffeɣ uxeddam nni yufa ijjen nneɣni zeg ixeddamen, tuɣa itares-as cwayt waha, am yijjen n <char style="it">milyun</char>. Iṭṭef-iṯ ibḏa itjeyyaf-iṯ iqqar-as: Xeǧes-ayi min ḏac tarseɣ! <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />Iwḍa-yas umeddukeȓ nnes ɣar iḍaren inna-as: Ṣbar xafi cwayt ac xeǧseɣ. <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />Yugi, iruḥ netta inḍar-iṯ ḏi ȓeḥbes aȓ ɣa ixeǧes amarwas nnes.<verse eid="MAT 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 18:31" />Ẓrin yinni kis ixeddmen min iweqƹen, iqqes-asen ȓḥaȓ ruḥen ɣar siḏiṯsen ƹawḏen-as min iweqƹen. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Ikkar iȓaɣa-yas-d siḏes inna-as: Ay axeddam aƹeffan, mayemmi? Nec semḥeɣ-ac ḏi marra min ḏac tarseɣ ȓaḥeqqac ṯettareḏ-ayi. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Ȓa ḏ cek tuɣa itxeṣṣa-cek aḏ treḥmeḏ ameddukeȓ nnec amecnaw mammec c reḥmeɣ uȓa ḏ nec." <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Iɣḍeb siḏes s waṭṭas isellem axeddam nni ɣar yinni iy ṯ ɣa iƹeddben aȓ ɣa ixeǧes marra min ḏayes ḏ amarwas.<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />Ammu iy kiḏwem ɣa igg Baba iy iǧan ḏeg ujenna meȓa war ismiḥ mkuȓ ijjen zzaywem s wuȓ nnes i wumas.<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Ṭṭalaq ƹlaḥsab mammec iqqar Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Wami ikemmeȓ Ƹisa awaȓ nnes, iffeɣ zi ṯmurṯ n Ljalil yuweḍ ɣar jwayeh n Yahuḏiya ḏ ujemmaḍ-in n yiɣzar n Lʼurdun. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Ḏfaren-ṯ ijjen n lƹadad n yiwḏan, isgenfa imehȓac nsen ḏinni.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Qarrben-d ɣares can yiwḏan zi ȓḥizeb n ifarrisiyen ḥima aṯ jarrben. Nnan-as: "Ma ḥalal aḏ iǧef can uryaz i ṯemɣarṯ nnes ḏi ayyi ȓḥajeṯ?"<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />Indeq-d Ƹisa inna-asen: "Ma war ṯeɣrim min iqqar Lkitab? Zeg wami ṯeǧa ddunect ixȓeq Lxaliq aryaz ḏ ṯemɣarṯ.<note caller="+" style="f"><char style="fr" closed="false">19.4 </char><char style="ft" closed="false">Xzar Imezwura (Genèse) 1:27.</char></note> <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />Inna Arebbi: Aqa aryaz aḏ ijj babas ḏ yemmas aḏ imun ak ṯemɣarṯ nnes, aḏ ḏewȓen s ṯnayen iḏsen ḏ ijjen.<note caller="+" style="f"><char style="fr" closed="false">19.5 </char><char style="ft" closed="false">Xzar Imezwura (Genèse) 2:24.</char></note> <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />X manaya war tiȓin ca ḏ ṯnayen; Lla, aḏ iȓin ḏ ijjen. Iḏen, min ismun Arebbi war ṯ isfarreq ca bnaḏem."<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Nnan-as ifarrisiyen: "Iwa, mayemmi iweṣṣa Musa aryaz aḏ yuc ṯabrat n waǧaf i ṯemɣarṯ nnes aḏas iǧef?"<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Inna-asen Ƹisa: "Ijji-kenniw Musa aḏ teǧfem i ṯemɣarin nwem minzi ɣarwem uȓ iqseḥ, walakin ḏeg umezwaru war tuɣa ca ammu. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Qqareɣ-awem nec: Marra wenni ɣa iǧfen i ṯemɣarṯ nnes amen war ṯezni, yuwi can icten nneɣni, ataf izna."<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Nnan-as imeḥḍaren nnes: "Meȓa ammu lḥala n uryaz ak ṯemɣarṯ nnes, ḥsen-as ataf war imeǧec ca."<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Inna-asen Ƹisa: "Zemmaren aḏ qebȓen awaȓ-a ɣir yinni umi yuca Arebbi ṯizemmar aṯ qebȓen. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Ḏinni ȓebƹaḍ zeg wami xeȓqen war zemmaren aḏ meȓcen. Ḏinni ȓebƹaḍ nneɣni qqnen-ṯen yiwḏan. U ḏinni ȓebƹaḍ nneɣni ugin aḏ meȓcen x ssabab n ȓmulk ujenna. Wenni izemmaren aḏ iqbeȓ ṯimesȓayin-a aṯent iqbeȓ."<verse eid="MAT 19:12" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa itbarek iḥenjiren imezyanen</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Uwin-d yiwḏan can iḥenjiren ḏ imezyanen ɣar Ƹisa ḥima axasen isers ifassen axasen iẓẓaǧ, walakin ƹarrḍen-asen imeḥḍaren nnes. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Ikkar Ƹisa inna-asen: "Jjem iḥenjiren imezyanen aɣari d asen. War ḏasen tƹarraḍem ca ȓaḥeqqac ȓmulk ujenna itiȓi ɣar yinni iy iǧan am yina." <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Igga xasen ifassen nnes yuyur ssenni.<verse eid="MAT 19:15" /></para>
  <para style="s">Aḥenjir ig iǧan ḏ ttajar</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Iqarreb ijjen n uḥenjir ɣar Ƹisa inna-as: "A Lmuƹallim, min ɣa ggeɣ ḏ aṣebḥan ḥima aɣari ṯiȓi ṯuḏarṯ n ȓebda?"<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />Inna-as Ƹisa: "Mayemmi iy ḏayi tesseqsiḏ x min iṣebḥan? Ɣir ijjen ig iǧan ḏ aṣebḥan. Meȓa ṯexseḏ aḏ taḏfeḏ ṯuḏarṯ n ȓebda, egg array s ȓuṣiyaṯ."<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />Inna-as uḥenjir nni: "Man ȓuṣiyaṯ?"</para>
  <para style="p" vid="MAT 19:18">Inna-as Ƹisa: "War neqq, war zenni, war tacar, war cehheḏ bu ẓẓur, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />weqqar babac ḏ yemmac, xes ajjar nnec amecnaw ixef nnec."<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />Inna-as uḥenjir nni: "Tweqqareɣ marra manaya. Min ḏayi iqqimen aṯ ggeɣ?"<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Inna-as Ƹisa: "Meȓa ṯexseḏ aḏ teggeḏ kuȓci nican, ruḥ zenz marra min ɣarek ḏ agȓa ṣeddeq-iṯ x ȓmusakin. Ssenni aɣarek yiȓi ijjen n ȓkenz ḏeg ujenna, ȓexddenni araḥ-d cek ḏfar-ayi-d."<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />Aḥenjir nni, wami isȓa i manayenni iruḥ ixeyyeq aṭṭas ȓaḥeqqac ɣares aṭṭas n wagȓa.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Inna-asen Ƹisa i imeḥḍaren nnes: "Aqa tesȓam ȓḥaqq: Mecḥaȓ iqseḥ xas x ttajar aḏ yaḏef ȓmulk ujenna." <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Qqareɣ-awem ƹaweḏ: Aqa isheȓ aḏ iƹḏu ijjen n uȓɣem zi ṯiṭṭ n ṯseynefṯ qbeȓ ma aḏ yaḏef ijjen n ttajar ḏi ȓmulk n Arebbi."<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Imeḥḍaren setƹejjben aṭṭas wami sȓin manayenni, nnan-as: "Xyar, ug izemmaren aḏ injem!?"<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Ixzar ɣarsen Ƹisa inna-asen: "Manaya war ḏas zemmaren ca yiwḏan, walakin kuȓci izemmar-as Arebbi."<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Indeq-d Buṭrus inna-as: "Aqa neccin nesmeḥ ḏi kuȓci neḏfar-ic, min ɣarneɣ ɣa yiȓin?"<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Inna-asen Ƹisa: "Aqa tesȓam ȓḥaqq: Ḏi ṯuḏarṯ nneɣni xmi ɣa iqqim Mmis n bnaḏem x lƹarc nnes n lƹaḍama, uȓa ḏ kenniw ḏayi d iḏfaren aḏ teqqimem x ṯenƹac n lƹarcaṯ ḥima aḏ tḥekmem x ṯenƹac n ṯqebbaȓ n Ayṯ-Israʼil. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />U marra yinni isemmḥen ḏi ṯuḏrin nsen niɣ ḏi ayṯmas niɣ ḏi suyṯmas niɣ ḏi babas ḏ yemmas niɣ ḏi ṯarwa nsen niɣ ḏeg imarjeƹiwen nsen x ssabab inu nec, ataf aɣarsen ṯiȓi miyya n ṯseqqar ktar, aḏ warṯen ṯuḏarṯ n ȓebda. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Aṭṭas iy iǧan ḏ imezwura aḏ ḏewȓen ḏ ineggura, ineggura aḏ ḏewȓen ḏ imezwura."<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">Ȓmaƹna n ixeddamen n umarjeƹ uḍiȓ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />"Aqa ȓmulk ujenna amecnaw ijjen n bab n umarjeƹ uḍiȓ. Iffeɣ ɣar ṣbaḥ zic aḏ igg ixeddamen ḏeg umarjeƹ uḍiȓ nnes. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Itafeq ak ixeddamen nni x yijjen n dinar i nhar, issekk-iṯen ɣar umarjeƹ nnes. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />Iffeɣ-d ɣar jwayeh nni n tesƹa yufa ixeddamen nneɣni qqimen ḏi ȓmewqef bȓa ȓxeḏmeṯ. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Inna-asen: Ruḥem uȓa ḏ kenniw ɣar umarjeƹ inu, ataf aḏawem xeǧseɣ min ṯesḏaheǧem. <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Kkaren ruḥen. Iffeɣ-d ɣar jwayeh n ṯenƹac ƹaweḏ ɣar jwayeh n ṯȓaṯa uƹecci igga nnefs ȓxeḏmeṯ. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Uca iffeɣ-d ƹaweḏ ɣar jwayeh nni n xemsa uƹecci, yufa ixeddamen nneɣni qqimen bȓa ȓxeḏmeṯ. Inna-asen: Min kenniw yuɣin ṯeqqimem ḏa nhar amen-ikmaȓ bȓa ȓxeḏmeṯ? <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />Nnan-as: Walu, war ḏaneɣ isexḏem ḥadd. Inna-asen: Ruḥem uȓa ḏ kenniw ɣar umarjeƹ inu.<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />Wami ṯeɣȓi ṯfuct, inna-as bab n umarjeƹ i uweqqaf nnes: Ȓaɣa-d i ixeddamen xeǧes-iṯen. Bḏa zeg yinni iy d yusin ḏ ineggura ƹaḏ i imezwura. <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Yinni ibḏan ȓxeḏmeṯ ɣar xemsa uƹecci, yuca-asen dinar dinar. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Wami d usin imezwura tɣir-asen aḏasen yuc ktar walakin lla, uȓa n niṯni yuca-asen dinar dinar. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Wami ḏasen yuca dinar, mxeyyaqen ak bab n umarjeƹ. <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />Nnan-as: Ixeddamen-a iy d yusin ḏ ineggura xeḏmen ijjen n ṯsaƹƹat waha, cek ṯuciḏ-asen amecnaw neccin ig yuwṯin tamara n nhar amen-ikmaȓ ḏi ṯfuct. <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />Indeq-d bab n umarjeƹ inna-as i yijjen zzaysen: War c cmiṯeɣ ca ay ameddukeȓ. Yac cek ṯtafqeḏ akiḏi x yijjen n dinar niɣ lla? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Ysi texȓiseṯ nnec uyur. Xseɣ aḏas uceɣ i wa iy d yusin ḏ aneggaru anect nnec. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Ma war ɣari ȓḥaqq aḏ ggeɣ min xseɣ zi ṯmesȓayin inu? Niɣ ṯḥesḏeḏ-ayi wami ǧiɣ ṣaxiy?<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />Amenni yinni iǧan ḏ ineggura aḏ ḏewȓen ḏ imezwura; yinni iǧan ḏ imezwura aḏ ḏewȓen ḏ ineggura."<verse eid="MAT 20:16" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa issawaȓ ƹaweḏ x ȓmewṯ nnes</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Wami igaƹƹeḏ Ƹisa ɣar ṯendint n Lquds, ḏeg ubriḏ iruḥ yuwi ṯenƹac nni n imeḥḍaren nnes waḥeḏsen inna-asen: <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />"Aqa netgaƹƹaḏ ɣar Lquds mani ɣa itwaxḏeƹ Mmis n bnaḏem i arruyas n ȓfuqaha ḏ imseȓmaḏen n ccariƹa. Axas ḥekmen s ȓmewṯ, <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />aṯ sellmen i yinni war iǧin ca zi Ayṯ-Israʼil. Axas ḍeḥcen, aṯ uwṯen s usɣun, aṯ ṣellben. Nhar wis ṯeȓtiyyam aḏ d itwasnekkar zi ȓmewṯ."<verse eid="MAT 20:19" /></para>
  <para style="s">Ṭṭaleb n yemmaṯsen n ṯarwa n Zabadi</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Ijjen n ṯemɣarṯ, nettaṯ ḏ yemmaṯsen n ṯarwa n Zabadi, ṯqarreb ɣar Ƹisa ak ṯnayen n ṯarwa nnes ṯsejjeḏ-as ḥima azzayes ṯettar can ȓḥajeṯ. <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />Inna-as Ƹisa: "Min ṯrezzuḏ?"</para>
  <para style="p" vid="MAT 20:21">Ṯenna-as: "Ini-ayi aḏ qqimen yina ṯarwa inu s ṯnayen ḏi ȓmulk nnec ijjen x ufusi ijjen x uẓeȓmaḍ nnec."<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />Indeq-d Ƹisa <char style="it">inna-asen i Yaƹqub ḏ Yuḥanna</char>: "Kenniw war ṯessinem ca min ṯettarem. Ma ṯzemmarem aḏ teswem zi ȓkas nni iy zi ɣa sweɣ nec ƹȓayen?"</para>
  <para style="p" vid="MAT 20:22">Nnan-as: "Wah, nzemmar-as!"<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Inna-asen: "Wah, ataf aḏ teswem zi ȓkas inu. Walakin aɣimi x ufusi inu ḏ uẓeȓmaḍ inu war iǧi bu ḏ nec iy ṯ ɣa yucen, aḏ immuc i yinni umi ṯen isewjeḏ Baba."<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Ƹecra nni n imeḥḍaren wami sȓin x min rezzun ṯnayen nni n wawmaṯen war ḏasen iƹjib ca ȓḥaȓ. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Iȓaɣa-yasen-d Ƹisa marra iḏsen inna-asen: "Qa ṯessnem arruyas n ṯmura ḥekkmen x ccuƹub nsen, yinni imeqqranen zzaysen tzeyyaren xasen. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Walakin manayenni itxeṣṣa war itiȓi ca jarawem. Lla, wenni irezzun aḏ iḏweȓ ḏ ameqqran jarawem itxeṣṣa-yas aḏ yiȓi ḏ axeddam nwem. <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />Wenni irezzun aḏ iḏweȓ ḏ amezwaru jarawem itxeṣṣa-yas aḏ yiȓi ḏ ismeɣ<note caller="+" style="f"><char style="fr" closed="false">20.27 </char><char style="ft" closed="false">Ismeɣ netta ḏ lƹabid.</char></note> nwem. <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />Mmis n bnaḏem uȓa ḏ netta war d yusi ca ḥima axas xeḏmen yiwḏan. Lla, netta yusa-d ḥima axasen ixḏem, axasen iṣeddeq ṯuḏarṯ nnes ḥima aḏ isenjem aṭṭas zzaysen."<verse eid="MAT 20:28" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa isgenfa ṯnayen n iḍarɣaȓen ḏi Ariḥa</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Wami ffɣen zi ṯendint n Ariḥa, ḏfaren-d Ƹisa aṭṭas n ȓɣaci. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Ḏinni ṯnayen n iḍarɣaȓen qqimen x ṭṭarf n ubriḏ. Wami sȓin i Ƹisa iggur-d, snekkaren ṯɣuyyeṯ qqaren: "A Siḏi a Mmis n Ayṯ-Dawed, rḥem-aneɣ!" <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />Zeyyaren xasen yiwḏan nnan-asen sqarem, walakin niṯni qqimen snekkaren ṯɣuyyeṯ ƹaḏ s jjheḏ qqaren: "A Siḏi a Mmis n Ayṯ-Dawed, rḥem-aneɣ!"<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Ibedd Ƹisa, iȓaɣa-yasen-d inna-asen: "Min ṯexsem aḏawem ggeɣ?"<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />Nnan-as: "A Siḏi, qa nexs aḏ nurzment ṯiṭṭawin nneɣ!"<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Qqsen-as i Ƹisa iḥaḏa-yasen ṯiṭṭawin nsen. Ḏeg umcan ḏewȓen twaȓan uca ḏfaren-ṯ.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">Siḏiṯneɣ Ƹisa itaḏaf x usnus ɣar Lquds</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Wami qarrben ɣar ṯendint n Lquds uwḍen ɣar ubilaj n Bayt Faji zzaṯ i Uḏrar n Zzitun, ikkar Ƹisa issekk ṯnayen zeg imeḥḍaren nnes, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />inna-asen: "Ruḥem ɣar ubilaj-in iǧan zzaṯwem, aḏ tafem ḏinni ṯaɣyuȓṯ ṯeqqen akiḏes asnus. Fsim-asen awim-ṯen-d ɣari. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Meȓa issiweȓ ɣarwem can yijjen inna-awem ca, inim-as qa Iḥḏaj-iṯen Siḏiṯneɣ. Ȓexddenni akiwem-ṯen-d issekk."<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Ammu iwqeƹ ḥima aḏ ikemmeȓ wawaȓ iy inna Siḏi Arebbi i nnabi <char style="it">Zakariya</char> ḏeg yijjen n zman:<verse eid="MAT 21:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="MAT 21:5" />"Inim-as i yeǧis n Lquds:</para>
  <para style="q1" vid="MAT 21:5">Xzar, azeǧiḏ nnem yusa-d ɣarem, war ḏayes bu ttakebbur.</para>
  <para style="q1" vid="MAT 21:5">Inya x yijjen n ṯeɣyuȓṯ, ḏ usnus mmis n ṯeɣyuȓṯ."<verse eid="MAT 21:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Ruḥen ṯnayen nni imeḥḍaren, ggin mamc ḏasen inna Ƹisa. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Uwin-d ṯaɣyuȓṯ ḏ usnus, ggin xasen izeǧuba nsen ȓexddenni inya Ƹisa. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Aṭṭas n yiwḏan ssun-as abriḏ s izeǧuba nsen. Inneɣni qessen ȓefruƹ n ȓcejjur ssun zzaysen abriḏ. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Yinni igguren zzaṯes ḏ yinni iy ṯ iḏeffaren qqaren:</para>
  <para style="q2" vid="MAT 21:9">"Lƹaḍama i Mmis n Ayṯ-Dawed!</para>
  <para style="q1" vid="MAT 21:9">Ssaƹḏ n wenni iy d yusin ƹlaḥsab isem n Siḏi Arebbi.</para>
  <para style="q2" vid="MAT 21:9">Lḥamdu i Arebbi yuƹȓan."<verse eid="MAT 21:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Wami yuḏef Ƹisa ɣar ṯendint n Lquds, kkaren-d ayṯbab n ṯendint nnan: "Min iƹna wa?" <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />Nnan ȓɣaci qa wanita ḏ nnabi Ƹisa zeg ubilaj n Naṣira ḏi ṯmurṯ n Ljalil."<verse eid="MAT 21:11" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa ḏi ṯemziḏa ṯameqqrant n Ayṯ-Israʼil</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Yuḏef Ƹisa ɣar ṯemziḏa ṯameqqrant yuzzeȓ x marra x yinni issaɣen ḏ yinni iznuzan. Iqȓeb-asen missaṯ n yinni itṣarrafen tmenyaṯ ḏ ȓekrasa n yinni iznuzan iḏbiren. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Inna-asen: "Lkitab iqqar: &lt;Ṯaddarṯ inu aḏ tiȓi ḏ ṯaddarṯ n ṯẓaǧiṯ.&gt; Walakin kenniw ṯarrim-teṯ ḏ ifri n ixewwanen."<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Ḏi ṯemziḏa ṯameqqrant qarrben-d ɣar Ƹisa iḍarɣaȓen ḏ izeḥḥafen uca isgenfa-ṯen. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Ƹeṣṣben arruyas n ȓfuqaha ḏ imseȓmaḏen n ccariƹa wami ẓrin <char style="it">Ƹisa</char> lmuƹjizaṯ iy igga, ḏ iḥenjiren ṭṭarf i ṯemziḏa ṯameqqrant tȓaɣan s jjheḏ qqaren: "Lƹaḍama i Mmis n Ayṯ-Dawed!" <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Nnan-as i Ƹisa: "Ma tesȓiḏ min xak qqaren?"</para>
  <para style="p" vid="MAT 21:16">Inna-asen Ƹisa: "Wah, ma war ṯeɣrim <char style="it">min iǧan ḏi Lkitab</char>? &lt;Ṯeggiḏ, <char style="it">ay Arebbi</char>, ac ḥemḏen iḥenjiren ḏ iseyman s uqemmum nsen.&gt;"<note caller="+" style="f"><char style="fr" closed="false">21.16 </char><char style="ft" closed="false">Xzar Zzabur (Psaumes) 8:2.</char></note> <verse eid="MAT 21:16" /><verse number="17" style="v" sid="MAT 21:17" />Ssenni ismeḥ ḏaysen, iffeɣ zi ṯendint nni iruḥ ɣar ubilaj n Bayt Ƹanya isens ḏinni.<verse eid="MAT 21:17" /></para>
  <para style="s">Ṯacejjarṯ n ṯazarṯ yuzɣen</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Ɣar ṣbaḥ zic igaƹƹeḏ Ƹisa ɣar ṯendint, netta iǧuz. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Iẓra ijjen n ṯcejjarṯ n ṯazarṯ x ubriḏ iruḥ ɣares yufi-t ḏayes ṯifray waha. Inna-as: "Cem zi ssa aȓ ṯsawent ƹemmarṣ aḏ tarweḏ." Ȓexddenni ṯuzeɣ ṯcejjarṯ nni n ṯazarṯ.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Imeḥḍaren nnes wami ẓrin min iweqƹen, tƹejjben nnan-as i Ƹisa: "Mammec ṯegga ṯcejjarṯ-a ṯuzeɣ ḏeg umcan?"<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />Indeq-d Ƹisa inna-asen: "Aqa tesȓam ȓḥaqq: Mȓi ḏaywem lʼiman war ṯcekkim ca, ataf aḏ teggem ktar zi min itwaggen i ṯcejjarṯ-a. Meȓa ṯennim i uḏrar-a: Neqȓeƹ-d cek ssanita ṯmenḍareḏ ḏi ȓebḥar, ataf aḏ ineqȓeƹ. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Inna-asen: Meȓa ṯumnem, aɣarwem yiȓi marra min ɣa ṯettarem i Arebbi ḏi ṯẓaǧiṯ nwem."<verse eid="MAT 21:22" /></para>
  <para style="s">Ssulṭa n Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Yuḏef Ƹisa ḏi ṯemziḏa ṯameqqrant iseȓmaḏ ḏinni. Qarrben-d ɣares arruyas n ȓfuqaha ḏ imeqqranen zi Ayṯ-Israʼil nnan-as: "Cek manis ḏac d ṯekka ssulṭa nni iy zi teggeḏ ṯimesȓayin-a? Wi ḏac yucin ssulṭa nni?"<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Indeq-d Ƹisa inna-asen: "Uȓa ḏ nec akenniw sseqsiɣ x yijjen n ṯmesȓayṯ. Meȓa ṯjawbem-ayi-d xas, ataf aḏawem iniɣ zi manis ḏayi d ṯekka ssulṭa-ya iy zi teggeɣ ṯimesȓayin-a. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Yaḥya, man ssulṭa iy zi iṭehhar s waman, ma zi Arebbi ma zeg yiwḏan?"</para>
  <para style="p" vid="MAT 21:25">Ssiwȓen jarasen nnan: "Meȓa nenna-as zi Arebbi, ataf aḏaneɣ yini <char style="it">Ƹisa</char> mayemmi war zzayes ṯuminem ca? <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Meȓa nenna-as <char style="it">ssulṭa nni</char> ṯekka-d zeg yiwḏan, ataf neccin a neggweḏ zi ccaƹb minzi marra ccaƹb twaȓan belli Yaḥya netta ḏ nnabi." <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Kkaren nnan-as i Ƹisa: "War nessin ca."</para>
  <para style="p" vid="MAT 21:27">Indeq-d Ƹisa inna-asen: "Iwa uȓa ḏ nec war ḏawem qqareɣ ca manis ḏayi d ṯekka ssulṭa-ya iy zi teggeɣ ṯimesȓayin-a."<verse eid="MAT 21:27" /></para>
  <para style="s">Ȓmaƹna n ṯnayen n wawmaṯen</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />"Min ḏawem imeḍharen? Ijjen n bnaḏem ɣares ṯnayen n ṯarwa nnes. Iruḥ ɣar umezwaru inna-as: A mmi, ruḥ aḏ txeḏmeḏ nhara ḏeg umarjeƹ inu uḍiȓ. <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />Indeq-d mmis inna-as: Lla, war traḥeɣ ca. Walakin menbaƹd cwayt indem, iruḥ ɣar umarjeƹ. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Iruḥ ɣar mmis nneɣni inna-as min ḏas inna i mmis nni amezwaru. Yarra xas inna-as: Waxxa a Baba inu. Walakin war iruḥ ca. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />Uw iggin min ixes babaṯsen zi ṯnayen-a?"</para>
  <para style="p" vid="MAT 21:31">Nnan-as: "Amezwaru."</para>
  <para style="p" vid="MAT 21:31">Inna-asen Ƹisa: "Aqa tesȓam ȓḥaqq: Iƹeccaren ḏ ṯemɣarin iffɣen abriḏ aḏawem izwaren ɣar ȓmulk n Arebbi. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Ȓaḥeqqac yusa-d ɣarwem Yaḥya iseḍhar-awem-d abriḏ n ȓḥaqq, war zzayes ṯuminem ca. Walakin iƹeccaren ḏ ṯemɣarin iffɣen abriḏ umnen zzayes. Kenniw ṯeẓrim manayenni, walakin war tubem ca ḥima azzayes ṯamnem."<verse eid="MAT 21:32" /></para>
  <para style="s">Ȓmaƹna n ixemmasen iy ḏi iǧa ccarr</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />"Ṣennṭeṯ i yijjen n ȓmaƹna nneɣni. Ijjen n bab n ṯeddarṯ iẓẓu aḍiȓ ḏeg yijjen n umarjeƹ nnes. Inneḍ-as-d ȓḥiḍ, igga ḏayes ṯasirṯ uḍiȓ. Ibna ḏayes ijjen n ṯsumƹeṯ i ȓƹasseṯ. Igga ḏayes ixemmasen iruḥ isafar. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Wami d yuweḍ ȓweqṯ n uȓqeḍ n uḍiȓ, ikkar issekk ixeddamen nnes ɣar ixemmasen nni bac aḏas d ucen ȓḥaqq nnes n uḍiȓ. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Walakin min ggin ixemmasen nni? Ṭṭfen ixeddamen nnes, ijjen uwṯin-ṯ, ijjen nɣin-ṯ, ijjen rejmen-ṯ. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Ikkar issekk ixeddamen nneɣni ktar zeg umezwaru. Ggin-asen ixemmasen nni min ggin i imezwura. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Ɣar uneggaru ikkar issekk ɣarsen mmis. Inna aqa aḏ ggwḏen memmi. <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Wami ufin ixemmasen nni mmis yusa-d, nnan i wayawya: Aṯ nneɣ bac aḏas nawi amarjeƹ-a n uḍiȓ! <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Ṭṭfen-ṯ, nɣin-ṯ, nḍaren-ṯ-iḏ ɣar barra i umarjeƹ uḍiȓ.<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />Iwa xmi iy d ɣa iḏweȓ bab n umarjeƹ, min ḏasen ɣa igg i ixemmasen nni?"<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />Nnan-as: "Iwḏan nni iƹeffanen aṯen ineɣ, uca aḏ ijj amarjeƹ uḍiȓ i ixemmasen nneɣni iy ḏas ɣa ucen ȓḥaqq nnes uḍiȓ ḏi ȓweqṯ."<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Inna-asen Ƹisa: "Ma ƹemmarṣ war ṯeɣrim min yurin ḏi Lkitab?</para>
  <para style="q1" vid="MAT 21:42">&lt;Azru iy ƹiffen ibennayen,</para>
  <para style="q1" vid="MAT 21:42">iwqeƹ ḏeg umcan aṣebḥan ḏi ṯɣemmarṯ n dsas.</para>
  <para style="q1" vid="MAT 21:42">Ḏ Siḏi Arebbi ig iggin manaya,</para>
  <para style="q1" vid="MAT 21:42">ḏ ijjen n ȓḥajeṯ ḏ ṯameqqrant!&gt;<note caller="+" style="f"><char style="fr" closed="false">21.42 </char><char style="ft" closed="false">Xzar Zzabur (Psaumes) 118:22-23.</char></note><verse eid="MAT 21:42" /></para>
  <para style="b" />
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />S manaya qqareɣ-awem: Ȓmulk n Arebbi aḏawem itwakkes aḏ immuc i yijjen n ccaƹb ig iteggen ȓxir. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Wenni ɣa iwḍan x uzru-ya aḏ irez. Wenni xef ɣa iwḍa uzru-ya aḏ ineȓbeẓ."<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Wami sȓin arruyas n ȓfuqaha ḏ ȓḥizeb n ifarrisiyen i ȓemƹani n Ƹisa fehmen belli issawaȓ xasen. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Rezzun aṯ ṭṭfen, walakin ggwḏen zi ccaƹb minzi twaȓan Ƹisa ḏ nnabi.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Ȓmaƹna n umensi ameqqran</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Issawaȓ Ƹisa akiḏsen ƹaweḏ s ȓemƹani, indeq-d inna-asen: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />"Ȓmulk ujenna amecnaw ij uzeǧiḏ igga amensi ḏ ameqqran ḏi ȓfarḥ n mmis. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Issekk ixeddamen nnes aḏ d ȓaɣan i yinni xef iƹareḍ ɣar umensi, walakin ugin aḏ d asen. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Issekk ixeddamen nneɣni inna-asen: Inim-asen i yinni itwaƹarḍen: Aqa nec swejḏeɣ amensi inu, ɣarṣeɣ iƹejmiyen<note caller="+" style="f"><char style="fr" closed="false">22.4 </char><char style="ft" closed="false">Iƹejmiyen niṯni ḏ imwaṯen.</char></note> ḏ iyenduzen inu iṣeḥḥan. Kuȓci iwjeḏ, araḥem-d ɣar ȓfarḥ! <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Walakin yinni itwaƹarḍen war ḏayes t uwin ca: ijjen iruḥ ɣar umarjeƹ nnes, ijjen ɣar ttijara nnes. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Inneɣni ṭṭfen ixeddamen n uzeǧiḏ ƹedden xasen nɣin-ṯen. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Iɣḍeb uzeǧiḏ issekk ȓƹaskar nnes aḏ nɣen lmujrimin nni aḏ sḥerqen ṯandint nsen. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Inna-asen i ixeddamen nnes: Amensi n ȓfarḥ iwjeḏ, walakin yinni itwaƹarḍen war ṯ sḏihiǧen ca. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Effɣeṯ ɣar mani temsagaren ibriḏen ƹarḍem-d ɣar umensi marra wi ɣa ṯafem ḏinni. <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Ruḥen ixeddamen nni ɣar ibriḏen uwin-d marra ug ufin ḏinni, iṣebḥanen ḏ iƹeffanen, ṯƹemmar ssaḥa s inewjiwen.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />Yuḏef uzeǧiḏ ḥima aḏ iẓer inewjiwen, yufa ḏinni ijjen n uryaz war yareḍ bu warruḍ n ȓfarḥ. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" /><char style="it">Iruḥ ɣares</char> inna-as: Ay ameddukeȓ, mammec ṯeggiḏ ṯuḏfeḏ-d bȓa arruḍ n ȓfarḥ? Aryaz nni istuk. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />Uca inna-asen uzeǧiḏ i ixeddamen nnes: Carfem-ṯ zeg iḍaren ḏ ifassen nḍarem-ṯ barra ɣar ṯaǧest mani ɣa iȓin imeṭṭawen ḏ uɣeẓẓaẓ n ṯeɣmas."<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />Inna-asen Ƹisa: "Aqa aṭṭas ig itwaƹarḍen, ḏrus iy ɣa itwaxḍaren."<verse eid="MAT 22:14" /></para>
  <para style="s">Ifarrisiyen ḏ yiwḏan n uzeǧiḏ tjarraben Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Kkaren ifarrisiyen mcawaren jarasen ggin ijjen n lxuṭa aḏ ṭṭfen Ƹisa x min iqqar. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Ssekken ɣares can imeḥḍaren nsen ak can yiwḏan zi ȓḥizeb n uzeǧiḏ Hirudus aḏas inin: "A Lmuƹallim qa nessen belli cek nican iy ṯeǧiḏ. War teggwḏeḏ ca zeg yiwḏan ȓaḥeqqac war teggeḏ bu s wuḏemawen. Ṯseȓmaḏeḏ s ȓḥaqq mammec ixes Arebbi a nƹic. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Ini-yaneɣ, min ḏac imeḍharen? Ṯsemmeḥ ccariƹa nneɣ a nxeǧes ḍḍariba i uzeǧiḏ Qayṣar niɣ lla?"<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Issen Ƹisa ixarwiḍen nni iy ḏaysen inna-asen: "A lmunafiqin, mayemmi ḏayi ṯsewjaḏem ṯaxcebṯ? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Awim-ayi-d dinar nni <char style="it">n ḍḍariba</char> ḥima aṯ ẓreɣ." Kkaren uwin-as-d ijjen n dinar. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Inna-asen: "Wi yiȓan teṣwirṯ-a ḏ yisem-a iy ḏayes?"<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />Nnan-as: "N Qayṣar."</para>
  <para style="p" vid="MAT 22:21">Indeq-d Ƹisa inna-asen: "Min iǧan n Qayṣar ucem-as-ṯ i Qayṣar. Min iǧan n Arebbi ucem-as-ṯ i Arebbi."<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Wami sȓin i ujawab nni qqimen tƹejjben ḏayes. Ssenni semḥen ḏayes uyuren.<verse eid="MAT 22:22" /></para>
  <para style="s">Iṣadduqiyen tjarraben Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Ḏi nhar nni, qarrben-d ɣar Ƹisa can yiwḏan zi ȓḥizeb n iṣadduqiyen (niṯni qqaren belli iwḏan war d tekkaren ca zi ȓmewṯ). <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />Kkaren nnan-as: "A Lmuƹallim, iqqar-aneɣ Musa aryaz meȓa immuṯ war d ijji bu ṯarwa, ṯajjaȓṯ nnes at yawi uȓwes nnes bac akiḏes d ijj ṯarwa i wumas nni immuṯen. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Neccin tuɣa akiḏneɣ sebƹa n wawmaṯen, imȓec umezwaru immuṯ war d ijji bu ṯarwa. Ṯamɣarṯ nni yuwi-t uȓwes nnes. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Amenni ig iweqƹen i wumas wis ṯnayen ḏ wis ṯȓaṯa aȓ wis sebƹa. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Aȓ uneggaru uȓa ḏ ṯamɣarṯ nni ṯemmuṯ. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Yum Lqiyama, umi ɣa ṯiȓi ṯemɣarṯ nni? Aqa uwin-t s sebƹa iḏsen."<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Indeq-d Ƹisa inna-asen: "Kenniw ṯexḍam ȓaḥeqqac war ṯessinem ca Lkitab uȓa ḏ jjheḏ n Arebbi. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Xmi d ɣa kkaren yinni immuṯen <char style="it">iryazen ḏ ṯemɣarin</char> war meǧcen ca war twasmeǧicen ca; Lla, aḏ iȓin amecnaw lmalaʼikaṯ ig iǧan ḏeg ujenna. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Walakin cuf, yinni immuṯen aḏ d kkaren zi ȓmewṯ. Ma ƹemmarṣ war ṯeɣrim min ḏawem iqqar Arebbi? <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" /><char style="it">Iqqar</char> qa nec ḏ Arebbi n Brahim, ḏ Arebbi n Isḥaq, ḏ Arebbi n Yaƹqub."<note caller="+" style="f"><char style="fr" closed="false">22.32 </char><char style="ft" closed="false">Xzar Ufuɣ (Exode) 3:6.</char></note> <char style="it">Inna-asen Ƹisa:</char> "Netta ḏ Arebbi n yinni iddaren maci n yinni immuṯen."<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Sȓin yiwḏan i wawaȓ-a, ḏehcen ḏeg useȓmeḏ nnes.<verse eid="MAT 22:33" /></para>
  <para style="s">Ijjen zeg ifarrisiyen itjarrab Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Kkaren ȓḥizeb n ifarrisiyen wami d arrin ȓexbar belli Ƹisa ibelleƹ aqemmum n iṣadduqiyen, ȓexddenni munen jarasen. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Iruḥ yijjen zzaysen netta itcerraḥ ccariƹa, ixes aḏ ijarreb Ƹisa inna-as: <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />"A Lmuƹallim, min ṯeƹna ȓuṣiyeṯ iy iǧan ḏ ṯameqqrant qaƹ ḏi ccariƹa?"<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />Inna-as Ƹisa: "Aḏ texseḏ Siḏi Arebbi nnec s marra uȓ nnec, s marra arruḥ nnec, s marra ȓaƹqeȓ nnec.<note caller="+" style="f"><char style="fr" closed="false">22.37 </char><char style="ft" closed="false">Xzar Afessar n Ccariƹa n Musa (Deutéronome) 6:5.</char></note> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Ḏ ṯa ḏ ȓuṣiyeṯ iy iǧan ḏ ṯameqqrant ḏ ṯamezwarut. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Ȓuṣiyeṯ wis ṯnayen am ṯenni ṯamezwarut: Aḏ texseḏ ajjar nnec amecnaw ixef nnec.<note caller="+" style="f"><char style="fr" closed="false">22.39 </char><char style="ft" closed="false">Xzar Lkitab n Ayṯ Lawi (Lévitique) 19:18.</char></note> <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Ṯnayen-a n ȓuṣiyaṯ iy xef ṯebna Ccariƹa n Musa amen-ṯekmaȓ ḏ ttaƹalim n lʼanbiya."<verse eid="MAT 22:40" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa itjarrab ifarrisiyen</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Ȓḥizeb n ifarrisiyen aqaṯen munen ḏinni, ikkar Ƹisa isseqsa-ṯen <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />inna-asen: "Min ḏawem imeḍharen ḏi Lmasiḥ? Uw ṯ yiȓan?"</para>
  <para style="p" vid="MAT 22:42">Nnan-as: "Ḏ mmis n Dawed."<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Inna-asen Ƹisa: "Iwa mammec Dawed iqqar-as i mmis s Arruḥ n Arebbi: A Siḏi? Minzi Dawed inna:<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />Siḏi Arebbi inna-as i Siḏi: Qqim-d x ufusi inu,</para>
  <para style="q1" vid="MAT 22:44">aȓ d ɣa ggeɣ ȓƹaḏyan nnec swadday i iḍaren nnec.<note caller="+" style="f"><char style="fr" closed="false">22.44 </char><char style="ft" closed="false">Xzar Zzabur (Psaumes) 110:1.</char></note><verse eid="MAT 22:44" /></para>
  <para style="b" />
  <para style="p">
    <verse number="45" style="v" sid="MAT 22:45" />Mammec ɣa yiȓi <char style="it">Lmasiḥ</char> ḏ mmis n Dawed? Netta Dawed iqqar-as <char style="it">i Lmasiḥ</char>: A Siḏi."<verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />Uȓa ḏ ijjen war izemmar axas yarr ca n wawaȓ. U zi nhar nni war izƹim ḥadd aṯ isseqsa ƹaḏ ktar.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Ȓefḍiḥaṯ n imseȓmaḏen n ccariƹa ḏ ȓḥizeb n ifarrisiyen</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Issiweȓ Ƹisa ak imeḥḍaren nnes ḏ yiwḏan <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />inna-asen: "Imseȓmaḏen n ccariƹa ḏ ȓḥizeb n ifarrisiyen qqimen-as i Musa x ȓkursi nnes, <char style="it">iƹni seȓmaḏen ccariƹa nnes</char>. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />X manaya, teggeṯ marra min ḏawem qqaren, xeḏmem zzayes. Walakin war teggem ca am niṯni, mayemmi? Liʼanna niṯni war teggen ca min qqaren. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Tceddan ȓeḥmeȓ iḏeqȓen iqesḥen x yiwḏan ḥima aṯ arbun, walakin war tḥiḏin ca ȓeḥmeȓ nni uȓa s uḍaḍ nsen. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />Marra min teggen ḥima aɣarsen xzaren yiwḏan. Teggen ȓeḥruz<note caller="+" style="f"><char style="fr" closed="false">23.5 </char><char style="ft" closed="false">Ȓeḥruz-a ḏaysen can lʼayaṯ tceddan-ṯen israʼiliyen ḏeg ufus, iƹni jar n ṯɣemmarṯ ḏ uɣiȓ. Tceddan-ṯen ƹaweḏ ḏi ṯenyarṯ, iƹni ṯawarna.</char></note> ḏ imeqqranen, arennin ṯicȓuȓin <char style="it">i izeǧaben nsen</char>. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Texsen imucan imezwura ḏi ȓefruḥ ḏ ṯemziḏawin. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />Texsen axasen seǧmen ḏi ȓeswaq aḏasen ȓaɣan yiwḏan: A siḏiṯneɣ. <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Walakin kenniw, war tejjam ḥadd aḏawem iȓaɣa: A siḏiṯneɣ. Ȓaḥeqqac kenniw marra ḏ awmaṯen ɣarwem ijjen n Siḏiṯwem. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />War tȓaɣam i ḥadd ḏi ṯmurṯ: A babaṯneɣ. Ȓaḥeqqac ɣarwem ɣir ijjen n Babaṯwem aqaṯ ḏeg ujenna. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />War tejjam ḥadd aḏawem iȓaɣa: Ay amseȓmaḏ. Ȓaḥeqqac ɣarwem ɣir ijjen n Umseȓmaḏ, netta ḏ Lmasiḥ. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Ameqqran jarawem itxeṣṣa aḏ yiȓi ḏ axeddam nwem. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Wenni isemɣaren ixef nnes, ataf aḏ yiȓi ḏ amezyan. Wenni isemzayen ixef nnes, ataf aḏ yiȓi ḏ ameqqran.<verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />Ya ȓefḍiḥeṯ nwem ay imseȓmaḏen n ccariƹa ḏ ȓḥizeb n ifarrisiyen, a lmunafiqin! Teqqnem ṯawwarṯ n ȓmulk ujenna x yiwḏan. Kenniw war tiḏfem, war tejjim wi ɣa yaḏfen.<verse eid="MAT 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 23:14" />{Ya ȓefḍiḥeṯ nwem ay imseȓmaḏen n ccariƹa ḏ ȓḥizeb n ifarrisiyen, a lmunafiqin! Tettem i ṯajjaȓin marra min ɣarsent. Tesmeḍharem-d ixef nwem tẓaǧam aṭṭas ḥima aḏ tbeyynem i yiwḏan belli ṯṣebḥem aṭṭas zaƹma. X manayenni aḏ twaƹaqbem ktar.}<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />Ya ȓefḍiḥeṯ nwem ay imseȓmaḏen n ccariƹa ḏ ȓḥizeb n ifarrisiyen, a lmunafiqin! Tekkem marra ȓebḥar ḏ ȓbarr ḥima aḏ tjarrem can yijjen ɣar ddin nwem. U xmi iy kiwem ɣa yiȓi, tarrim-ṯ isḏaheǧ ṯimessi marrṯayen ktar zi min ṯesḏaheǧem kenniw.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />Ya ȓefḍiḥeṯ nwem, ay iḍarɣaȓen itjarran iwḏan! Ṯeqqarem: War ṯseggwi walu ṯjaǧiṯ<note caller="+" style="f"><char style="fr" closed="false">23.16 </char><char style="ft" closed="false">Ṯjaǧiṯ nettaṯ ḏ lḥulef.</char></note> s ṯemziḏa ṯameqqrant, walakin wenni ɣa ijjaǧen s ddheb n ṯemziḏa ṯameqqrant itxeṣṣa axas ikemmeȓ x ṯjaǧiṯ nnes. <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Ay ifɣaȓ ay iḍarɣaȓen, min iseggwan ktar? Ma ḏ ddheb ma ḏ ṯamziḏa ṯameqqrant ig yucin lqima i ddheb? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" /><char style="it">Ṯeqqarem ƹaweḏ:</char> War ṯseggwi walu ṯjaǧiṯ s ȓmeḏbaḥ, walakin wenni ɣa ijjaǧen s dbiḥaṯ iǧan x ȓmeḏbaḥ, itxeṣṣa axas ikemmeȓ x ṯjaǧiṯ nnes. <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Ay iḍarɣaȓen, min iseggwan ktar: Ḏ dbiḥaṯ niɣ d ȓmeḏbaḥ iticcen lqima i dbiḥaṯ? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />X manaya, wenni itjaǧan s ȓmeḏbaḥ, itjaǧa zzayes ḏ marra min xas. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Wenni itjaǧan s ṯemziḏa ṯameqqrant, itjaǧa zzayes ḏ Arebbi iy t izeddɣen. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Wenni itjaǧan s ujenna, itjaǧa s lƹarc n Arebbi ḏ wenni xas iqqimen.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />Ya ȓefḍiḥeṯ nwem, ay imseȓmaḏen n ccariƹa ḏ ȓḥizeb n ifarrisiyen, a lmunafiqin! Ticcem ȓaƹcur uȓa x naƹnaƹ ḏ uwram<note caller="+" style="f"><char style="fr" closed="false">23.23 </char><char style="ft" closed="false">Awram netta ḏ ijjen n ȓƹucbeṯ ḏayes ddwa.</char></note> ḏ ȓcemmun,<note caller="+" style="f"><char style="fr" closed="false">23.23 </char><char style="ft" closed="false">Ȓcemmun netta ḏ ȓkaymun.</char></note> walakin war tehtimim ca min iǧan muhim qaƹ ḏi ccariƹa iƹni ȓḥaqq ḏ arraḥmeṯ ḏ lʼiman. Lla, itxeṣṣa-awem aḏ tehtamem s manaya bȓa ma tettum ȓaƹcur. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Ay iḍarɣaȓen itjarran iwḏan! Tṣeffim izi <char style="it">zi min ṯsessem</char>, ṯesɣeǧayem aȓɣem!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />Ya ȓefḍiḥeṯ nwem ay imseȓmaḏen n ccariƹa ḏ ȓḥizeb n ifarrisiyen, a lmunafiqin! Kenniw ṯsiriḏem <char style="it">mliḥ</char> ȓkas ḏ ṭebṣi ɣar barra, walakin ɣar ḏaxeȓ aqa ccuren s ṯukkarḏa ḏ ṭṭmaƹ! <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Ay afarrisi aḍarɣaȓ, ḏ amezwaru sireḏ ȓkas ɣar ḏaxeȓ ḥima aḏ yiȓi isireḏ ɣar barra.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />Ya ȓefḍiḥeṯ nwem ay imseȓmaḏen n ccariƹa ḏ ȓḥizeb n ifarrisiyen, a lmunafiqin! Kenniw amecnaw imeḍȓan ibeyyḍen s jjir. Tmeḍharen ṣebḥan ɣar barra, walakin niṯni ccuren ɣar ḏaxeȓ s yixsan ḏ marra min yareccan. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Amenni kenniw iy tmeḍharem i yiwḏan nican iy ṯeǧam ɣar barra, walakin ɣar ḏaxeȓ ṯeccurem s nnifaq ḏ ȓmuƹṣiyaṯ.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />Ya ȓefḍiḥeṯ nwem ay imseȓmaḏen n ccariƹa ḏ ȓḥizeb n ifarrisiyen, a lmunafiqin! Kenniw ṯbennam imeḍȓan n lʼanbiya, ṯƹeddȓem imrabeḏen n ȓmuminin. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Ṯeqqarem: Maƹlik neǧa ḏi ȓweqṯ n ȓejḏuḏ nneɣ ataf war kiḏsen nsizzeȓ ca iḏammen<note caller="+" style="f"><char style="fr" closed="false">23.30 </char><char style="ft" closed="false">Iḏammen netta ḏ ddem.</char></note> n l'anbiya. <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />X manayenni ṯcehhḏem x yixef nwem belli kenniw ḏ ṯarwa n yinni inɣin lʼanbiya. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Iwa, kemmȓeṯ kenniw x min bḏan ȓejḏuḏ nwem!<verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />Ay ifiɣeran! A ṯarwa n ṯfiɣerawin! Mamc ṯfekkarem aḏ tarewȓem zi lƹiqab n jahennama? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />X manaya xzarem! Tsekkiɣ-awem-d lʼanbiya ḏ imiɣisen ḏ imseȓmaḏen. Ijjen zzaysen aṯ ṯenɣem ijjen aṯ ṯṣellbem. Ijjen zzaysen aṯ ṯuwṯem s usɣun ḏi ṯemziḏawin, ijjen axas ṯazzȓem zi ṯendint ɣar ṯendint. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />X manayenni aḏ twaƹaqbem x marra iḏammen iy yuzzȓen n ȓmuminin ḏi ddunect-a. Zeg iḏammen n Habil ȓmumen aȓ iḏammen n Zakariya mmis n Barxiya iy ṯenɣim jar ȓmeḏbaḥ ḏ ṯemziḏa ṯameqqrant. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Aqa tesȓam ȓḥaqq: Marra lƹiqab-a aḏ d ihwa x yiwḏan n ȓweqṯ-a!<verse eid="MAT 23:36" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa itxeyyaq x ṯendint n Lquds</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />Ya Lquds ya Lquds! Ḏ cem ig ineqqen lʼanbiya, ḏ cem ig irejjmen yinni ɣarem d issekk Arebbi! Nec mecḥaȓ n ṯwaȓaṯin xseɣ aḏ smuneɣ ṯarwa nnem am can ṯyaziṭ iteḥbubuḍen x ifiǧusen nnes walakin kenniw ṯugim. <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Aqa ṯaddarṯ nwem aḏawem ṯeqqim ḏ ȓxirbeṯ. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Aḏawem iniɣ belli war ḏayi ṯẓerrem ca ƹaweḏ ḥetta aȓ Nhar nni iy ɣa ṯinim: Ssaƹḏ ya wenni iy d yusin ƹlaḥsab isem n Siḏi Arebbi!"<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">Lƹalamaṯ n ȓfana n ddunect</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Iffeɣ Ƹisa zi ṯemziḏa ṯameqqrant ibeƹƹeḏ ssenni cwayt. Qarrben-d ɣares imeḥḍaren nnes ḥima aḏas seḍharen ȓebni n ṯemziḏa ṯameqqrant. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Indeq-d Ƹisa inna-asen: "Ma twaȓam qaƹ manaya? Aqa tesȓam ȓḥaqq: War ḏa itɣimi ijjen n uzru x unneɣni, marra manaya aḏ inehḏem."<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Wami iqqim Ƹisa ḏeg Uḏrar n Zzitun, qarrben-d ɣares imeḥḍaren nnes waḥeḏsen nnan-as: "Ini-yaneɣ cek, meȓmi ɣa iwqeƹ manaya? Min ṯeƹna lƹalama nni xmi d ɣa ṯaseḏ cek, ḏ ȓefna n zman?"<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Ijaweb-iṯen Ƹisa inna-asen: "Ḥḍam ixef nwem ḥima war kenniw ixeddeƹ ḥadd. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Aṭṭas iy d ɣa yasen s yisem inu zaƹma aḏ inin qa nec ḏ Lmasiḥ! Aḏ xeḏƹen aṭṭas n yiwḏan. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Xmi ɣa ṯesȓam x lḥurub ḏ ȓexbar n lḥurub war teggwḏem ca, labud zi manaya. Walakin ddunect-a ƹaḏ war ṯfenni ca. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Dduwla aḏ tehjem x dduwla, lmemlaka aḏ tehjem x lmemlaka. Aḏ yiȓi jjuƹ aḏ iwqeƹ zzinzal ḏeg waṭṭas n imucan. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Marra manaya aḏ yiȓi amecnaw ȓeḥriq amezwaru n ṯemɣarṯ itarwen.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />Ssenni akenniw sellmen yiwḏan ḥima akenniw ƹeddben, akenniw nɣen. Marra dduwal akenniw ƹiffen ƹlaḥsab isem inu. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Aṭṭas iy ɣa ikfaren zeg yinni iy yumnen. Aḏ zzenzen ayawya, aḏ ƹiffen ayawya. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Aḏ d meḍharen aṭṭas n yiwḏan aḏ arren ixef nsen ḏ lʼanbiya, aḏ xeḏƹen aṭṭas n yiwḏan. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Aḏ tenqes ȓemḥibbeṯ jar yiwḏan minzi aḏ ikṯar ccarr. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Walakin wenni ɣa iṣbaren ɣar uneggaru ataf aḏ injem. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Lʼinjil n ȓmulk n Arebbi axas ḥeddṯen yiwḏan ḏi marra ṯimura n ddunect ḥima aɣarsen ṯiȓi chaḏeṯ xafi. Ȓexddenni iy d ɣa yas ȓefna.<verse eid="MAT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />Xmi ɣa ṯeẓrem &lt;min iǧan ḏ aƹeffan aṭṭas iheddmen&gt;, netta itbedda ḏeg umcan iqeddsen, iƹni mixef issiweȓ nnabi Danyal (A fhem a wenni iɣrin manaya!), <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />ȓexddenni yinni iǧan ḏi ṯmurṯ n Yahuḏiya itxeṣṣa aḏ arewȓen ɣar iḏurar. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Wenni ɣa yiȓin x ṯzeqqa nnes itxeṣṣa-as war ihewwi ca ɣar ṯeddarṯ ḥima aḏ iysi can ȓḥajeṯ. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Wenni ɣa yiȓin ḏeg umarjeƹ itxeṣṣa-as war iteƹqib ca ɣar ṯeddarṯ aḏ iysi čammir nnes. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Ya tamara x ṯemɣarin iy ɣa yiȓin s iƹeddisen ḏeg wussan nni, ḏ ṯinni issuṭuḍen! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Ttareṯ i Arebbi bac war tarewwȓem ca ḏi ȓmecta niɣ ḏi nhar n lƹibada. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Ḏi ȓweqṯ nni ataf aḏ tewqeƹ ijjen n tamara ḏ ṯameqqrant iy war iweqiƹen ƹemmarṣ zeg wami ṯeǧa ddunect-a aȓ ȓexxu, u ƹemmarṣ aḏ tewqeƹ ƹaweḏ. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Maƹlik <char style="it">Siḏi Arebbi</char> war isenqis ca ḏi ȓiyyam nni n tamara-ya iy d ɣa yasen, ataf war inejjem uȓa ḏ ijjen. X ssabab n yinni ixḍar <char style="it">Arebbi</char>, ataf aḏ isenqes ȓiyyam nni iy d ɣa yasen.<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />Ssenni meȓa inna-awem can yijjen: Xzarem! Aqaṯ ḏanita Lmasiḥ! Niɣ, Aqaṯ ḏiha! War ṯ tamnem ca. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Aqa aṭṭas iy d ɣa imeḍharen s ixarriqen aḏ inin aqa nec ḏ Lmasiḥ niɣ nec zi lʼanbiya. Aḏ ggen lmuƹjizaṯ ḏ ṯimeqqranin ḏ ȓaƹjayeb <char style="it">zaƹma</char> ḥima aḏ xeḏƹen iwḏan. Maƹlik zemmaren iȓi xeḏƹen uȓa ḏ yinni ixḍar Arebbi. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Xzarem! Aqa nec ƹeȓmeɣ-awem x manaya qbeȓ ma aḏ iwqeƹ. <verse eid="MAT 24:25" /><verse number="26" style="v" sid="MAT 24:26" />Meȓa nnan-awem: Xzarem, aqaṯ ḏi ȓexȓa! War traḥem ca ḏinni. Niɣ meȓa nnan-awem: Xzarem, aqaṯ ɣar ḏaxeȓ ḏeg ixammen! War ṯen tamnem ca. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Aqa xmi d ɣa yas Mmis n bnaḏem ataf aḏ yiȓi amecnaw assam iy d iteffɣen zi ccarq itceƹƹaȓ ɣar lɣarb. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Mani ǧan imurḍas, ḏinni ig itmunen ibaɣeriwen.<verse eid="MAT 24:28" /></para>
  <para style="b" />
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />Menbaƹd i tamara n ȓiyyam nni, ȓexddenni ṯfuct aḏ teḏweȓ ḏ ṯaǧest, ṯaziri war ticc bu ṯfawṯ. Iṯran aḏ d wḍan zeg ujenna, yinni ijehḏen ḏeg ujenna aṯen isenhezz <char style="it">Arebbi</char>. <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />Uca aḏ tmeḍhar lƹalama n Mmis n bnaḏem ḏeg ujenna, ȓexddenni iy ɣa ḥeznent marra ṯiqebbaȓ n ṯmurṯ. Aḏ ẓrent Mmis n bnaḏem ihewwa-d ḏeg useynu n ujenna s lƹaḍama ḏ jjheḏ nnes imɣaren. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Aḏ iṣuḍ ijjen n zzammar ḏ ameqqran, aḏ d issekk lmalaʼikaṯ nnes ɣar arbeƹa n imucan n ṯmurṯ manis d itekk arriḥ: <char style="it">zi ccarq ḏ lɣarb ḏ ljanub ḏ ccamal</char>. Aḏ d ismun yinni ixḍar zi ȓaḥedd n ujenna aȓ ȓaḥedd nnes nneɣni.<verse eid="MAT 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />Ȓemḏem ijjen n ȓmaƹna zi ṯcejjarṯ n ṯazarṯ. Ɣir ȓefruƹ nnes aḏ ḥebbben aḏ ggen ṯifray, ataf aḏ tessnem yallah anebḏu iqarreb-d. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Amenni uȓa ḏ kenniw. Xmi ɣa ṯeẓrem marra ṯimesȓayin-a itewqiƹen ataf aḏ tessnem illa manaya yuḏes-d, aqaṯ zzaṯ i ṯewwarṯ. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Aqa tesȓam ȓḥaqq: War tmettin yiwḏan n ȓweqṯ-a aȓ ɣa iwqeƹ marra manaya. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Aḏ ifna ujenna ḏ ṯmurṯ, walakin awaȓen inu war fennin ca ƹemmarṣ.<verse eid="MAT 24:35" /></para>
  <para style="b" />
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />Cuf, nhar nni niɣ ṯsaƹƹat nni war t issin uȓa ḏ ijjen, lla lmalaʼikaṯ ḏeg ujenna uȓa ḏ Mmis. Issen-it ɣir Baba waḥḏes. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Amecnaw mamc iwqeƹ ḏi ȓiyyam nni n Nuḥ, amenni iy ɣa iwqeƹ xmi d ɣa iḏweȓ Mmis n bnaḏem. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Yiwḏan ḏi ȓweqṯ nni qbeȓ i ṭṭufan,<note caller="+" style="f"><char style="fr" closed="false">24.38 </char><char style="ft" closed="false">Ṭṭufan, iƹni lfayaḍan iweqƹen ḏi ȓƹaheḏ n Siḏna Nuḥ.</char></note> tuɣa tetten, sessen, meǧcen twasmeǧacen, ḥetta aȓ nhar wami yuḏef Nuḥ ḏeg uɣarrabu. <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />War fṭinen ca aȓ wami d yusa ṭṭufan isɣareq-iṯen marra. Ammu iy ɣa iwqeƹ xmi d ɣa iḏweȓ Mmis n bnaḏem. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Aḏ iȓin ṯnayen n iryazen ḏeg umarjeƹ, ijjen aḏ imeysi ijjen aḏ iqqim. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Aḏ iȓint ṯnayen n ṯemɣarin ḏi ṯsirṯ ḥerrint ṯiḥebba, icten aḏ tmeysi icten aḏ teqqim.<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />X manaya faqem baƹda, qa war ṯessinem ca meȓmi d ɣa iḏweȓ Siḏiṯwem. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Itxeṣṣa-awem aḏ tessnem manaya: Mȓi bab n ṯeddarṯ issen ṯsaƹƹat iy ḏi d ɣa yas uceffar, iȓi iqqim ifaq ḥima war ṯ itijji ca aḏ d yaḏef ṯaddarṯ nnes. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />X manaya, swejḏem ixef nwem minzi Mmis n bnaḏem aḏ d yas ḏeg yijjen n ṯsaƹƹat war ṯ trijim ca.<verse eid="MAT 24:44" /></para>
  <para style="s">Iȓim ṯewjḏem xmi d ɣa iḏweȓ Siḏiṯwem</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />Min iƹna uxeddam iy iǧan ḏ amiɣis, ḏayes ȓaman? Netta ḏ wenni ig itkellaf siḏes aḏasen yuc macca<note caller="+" style="f"><char style="fr" closed="false">24.45 </char><char style="ft" closed="false">Macca nettaṯ ḏ lmakla.</char></note> i ixeddamen nnes ḏi ȓweqṯ nican. <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Ssaƹḏ n uxeddam nni, xmi d ɣa iḏweȓ siḏes aṯ yaf ixeddem. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Aqa tesȓam ȓḥaqq: <char style="it">Axeddam nni</char> aṯ ikellef siḏes x marra agȓa nnes. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Walakin axeddam nni meȓa ḏ aƹeffan inewwa belli siḏes aḏ iƹḍeȓ war d itis ca, <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />ataf aḏ ibḏa iccaṯ ixeddamen aḏ icc aḏ isew aḏ yiȓi ak iskayriyen waha. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Uca aḏ d yas siḏes n uxeddam nni ḏeg yijjen n nhar war ṯ inwi ca, ḏeg yijjen n ṯsaƹƹat war t issin ca. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Aṯ iqess ḏ iwezwizen aṯ inḍar ḏeg umcan n lmunafiqin, ḏinni iy ɣa iȓin imeṭṭawen ḏ uɣeẓẓaẓ n ṯeɣmas.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">Ȓmaƹna n ƹecra n ṯeƹzriyin</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />Ȓmulk ujenna amecnaw can ƹecra n ṯeƹzriyin ig iysin ȓeqnaḏeȓ, ffɣent aḏ ȓeqqant muȓay. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Xemsa iḏsent ḏ ṯifɣaȓ, xemsa iḏsent ḏ ṯimiɣisin. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Ṯifɣaȓ wami ysint ȓeqnaḏeȓ, war ysint bu zzect ḏ zziyada. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Ṯimiɣisin niṯenti ysint akiḏsent zziyada n zzect ḏi ṯzeyyaṯin. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Iƹḍeȓ muȓay war d yusi ca, niṯenti uḥȓent ṭṭṣent marra iḏsent.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />Ɣar ȓwesṭ n ǧiȓeṯ, sȓint i uȓaɣi iqqar aqa muȓay yusa-d, ffɣent aṯ ṯeȓqant! <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />Kkarent ṯeƹzriyin nni serɣent ȓeqnaḏeȓ. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Ṯifɣaȓ nnant i ṯimiɣisin: Ucent-aneɣ cwayt n zzect ȓaḥeqqac ȓeqnaḏeȓ nneɣ ƹȓayen aḏ xsin. <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />Arrint xasent ṯimiɣisin nnant-asent: Lla, minzi war ḏaneɣ itqeddi ca i neccin ḏ kennint. Ruḥent ɣar ṯḥanet sɣent-id min ɣa ṯeḥḏajent. <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Wami ruḥent ṯefɣaȓ aḏ sɣent zzect, ixḍeȓ-d muȓay. Uḏfent akiḏes ṯinni iswejḏen ɣar ȓfarḥ, ṯbelleƹ ṯewwarṯ.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />Menbaƹd usint-id ṯefɣar nnant-as s jjheḏ: A siḏi a siḏi, rzem-aneɣ ṯawwarṯ! <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />Yarra xasent muȓay inna-asent: Aqa tesȓant ȓḥaqq: nec war kennint ssineɣ ca.<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />Iḏen, iȓim ƹlabal ȓaḥeqqac war ṯessinem uȓa ḏ nhar nni uȓa ḏ ṯsaƹƹat nni.<verse eid="MAT 25:13" /></para>
  <para style="s">Ȓmaƹna n ṯȓaṯa n ixeddamen</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />
    <char style="it">Nhar nni</char> aḏ yiȓi am yijjen n ssiyyed irezzu aḏ isafer. Iȓaɣa-d i ixeddamen nnes ikellef-iṯen x wagȓa nnes. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Yuca-asen ƹlaḥsab min umi zemmaren. Ijjen yuca-as xemsaȓaf n ȓuznaṯ n nnuqarṯ. Ijjen yuca-as aȓefayen. Ijjen yuca-as aȓaf. Ssenni iruḥ netta aḏ isafer. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Ȓexddenni ikkar wenni umi yuca xemsaȓaf n ȓuznaṯ igga zzaysent ttijara irbeḥ xemsaȓaf nneɣni. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Amenni igga uȓa ḏ wenni umi yuca aȓefayen, irbeḥ aȓefayen nneɣni. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Walakin wenni umi yuca aȓaf n ȓuznaṯ, iruḥ netta iɣza ḏi ṯmurṯ isnuffar tmenyaṯ n siḏes.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />Wami ṯeƹḏu xarebbi n ȓweqṯ, iḏwer-d siḏiṯsen itegg akiḏsen ȓeḥsab. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Iqarreb-d wenni umi yuca xemsaȓaf n ȓuznaṯ, yarni-yas akiḏsent xemsaȓaf nneɣni. Inna-as i siḏes: A siḏi, ṯuciḏ-ayi cek xemsaȓaf n ȓuznaṯ, nec uwiɣ-d xemsaȓaf nneɣni. <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />Inna-as siḏes: Ṯeggiḏ mliḥ ay axeddam aṣebḥan, cek ḏayek ȓaman. Ḏayek ȓaman x ḏrus, ȓexxu ac kellfeɣ x waṭṭas. Aḏef aḏ tfarḥeḏ ak siḏec.<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />Ƹaweḏ iqarreb-d uxeddam nni umi yuca aȓefayen n ȓuznaṯ inna-as i siḏes: A siḏi, ṯuciḏ-ayi cek aȓefayen n ȓuznaṯ, nec uwiɣ-d aȓefayen nneɣni. <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />Inna-as siḏes: Ṯeggiḏ mliḥ ay axeddam aṣebḥan, cek ḏayek ȓaman. Ḏayek ȓaman x ḏrus, ȓexxu ac kellfeɣ x waṭṭas. Aḏef aḏ tfarḥeḏ ak siḏec.<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />Iqarreb-d wenni umi yuca aȓaf n ȓuznaṯ inna-as i siḏes: A siḏi, nec ssneɣ cek ḏ ijjen n bnaḏem ṯeqsḥeḏ. Ṯmejjareḏ mani war ṯzerrƹeḏ ca, ṯkessiḏ min war teẓẓuḏ ca. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Ggwḏeɣ zzayek, ruḥeɣ snuffareɣ tmenyaṯ nnec ḏi ṯmurṯ, u aqac tmenyaṯ nnec.<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />Indeq-d siḏes inna-as: Ay axeddam amcum, ay afenyan! Iwa ṯessneḏ belli nec mejjareɣ mani war zerrƹeɣ, kessiɣ min war teẓẓuɣ. <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Mayemmi war ṯejjiḏ tmenyaṯ inu ɣar iṣarrafen, ataf nec aḏ d aseɣ aḏ ysiɣ tmenyaṯ inu ḏ ȓefḍeȓ akiḏsent? <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" /><char style="it">Uca inna-asen i ixeddamen nnes</char>: Kksem-as aȓaf n ȓuznaṯ nni i wanita, arnim-ṯent i wenni ɣar iǧa ƹecraȓaf. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Wah, wenni iǧan ɣares itmarni-yas, aɣares yiȓi aṭṭas. Wenni war ɣar iǧi ca, itwaksi-yas uȓa ḏ min ɣares. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Axeddam-a iy ḏi war iǧi nnfaƹ, nḍarem-ṯ barra ɣar ṯaǧest. Ḏinni iy ɣa iȓin imeṭṭawen ḏ uɣeẓẓaẓ n ṯeɣmas.<verse eid="MAT 25:30" /></para>
  <para style="s">Yum Lḥisab ḏ Lƹiqab</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />Xmi d ɣa yas Mmis n bnaḏem s lƹaḍama nnes, akiḏes marra lmalaʼikaṯ, aḏ iqqim x lƹarc nnes n lƹaḍama. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Aḏ njemƹen marra iwḏan zzaṯes, aḏ iƹzeȓ iwḏan ijjen zeg unneɣni amecnaw mammec wenni yarewwsen ȓebhayem iteƹzaȓ iḥuȓiyen zi ṯɣatin. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Iḥuȓiyen aṯen igg x ufusi, ṯiɣatin aṯent igg x uẓeȓmaḍ.<verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />Ȓexddenni yinni iǧan x ufusi aḏasen yini uzeǧiḏ-a: A yinni iy ḏi igga Baba lbaraka araḥem-d kenniw warṯem ȓmulk iy ḏawem isewjeḏ zeg wami ṯeǧa ddunect. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Ȓaḥeqqac ṯufim-ayi ǧuzeɣ ṯseccem-ayi. Ṯufim-ayi ffuḏeɣ ṯsesswem-ayi. Ṯufim-ayi ḏ aɣrib ṯsezḏɣem-ayi. <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Ṯufim-ayi ḏ aƹaryan ṯeggim-ayi arruḍ. Ṯufim-ayi heȓceɣ ṯbeddem akiḏi. Ṯufim-ayi twaḥebbseɣ ṯeggim-d ɣari zziyara.<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />Aṯ jawben iṣebḥanen nni aḏas inin: A Siḏi, neccin meȓmi c nufa ṯeǧuzeḏ, nsecc-ic? Niɣ ṯeffuḏeḏ, nsessew-ic? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Meȓmi c nufa ḏ aɣrib, nsezḏeɣ-icek? Niɣ ḏ aƹaryan, negga-ac arruḍ? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Meȓmi c nufa ṯheȓceḏ niɣ ḏ ameḥbus, nusa-d ɣarek? <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Aḏ d yas uzeǧiḏ aḏasen yini: Aqa tesȓam ȓḥaqq: Min ṯeggim i yijjen n wuma ḏ amezyan zeg ayṯma, ṯeggim-ayi-t i nec.<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />Ȓexddenni yinni iǧan x uẓeȓmaḍ aḏasen yini uzeǧiḏ: A yinni inƹeȓ Arebbi beƹƹḏem xafi! Ruḥem ɣar ṯmessi iy war ixessin ƹemmarṣ isewjḏen i Cciṭan ḏ ccayaṭin nnes! <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Ȓaḥeqqac ṯufim-ayi ǧuzeɣ, war ḏayi ṯseccem ca. Ṯufim-ayi ffuḏeɣ, war ḏayi ṯsesswem ca. <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Ṯufim-ayi ḏ aɣrib, war ḏayi ṯsezḏɣem ca. Ṯufim-ayi ḏ aƹaryan, war ḏayi ṯeggim bu warruḍ. Ṯufim-ayi heȓceɣ twaḥebbseɣ, war ɣari d ṯeggim bu zziyara!<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />Aṯ jawben uȓa ḏ yinni iǧan x uẓeȓmaḍ aḏas inin: A Siḏi, neccin meȓmi c nufa ṯeǧuzeḏ niɣ ṯeffuḏeḏ niɣ ḏ aɣrib niɣ ḏ aƹaryan niɣ ṯheȓceḏ niɣ ṯetwaḥebseḏ u neccin war c nƹiwen ca? <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />Aḏ d yas uzeǧiḏ aḏasen yini: Aqa tesȓam ȓḥaqq: Min war ṯeggim ca i yijjen n wuma ḏ amezyan zeg ayṯma, war ḏayi t ṯeggim ca i nec. <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />Aḏ raḥen yina ɣar ṯmessi iy war ixessin ƹemmarṣ. Walakin iṣebḥanen aḏ raḥen ɣar ṯuḏarṯ n ȓebda."<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">Ijjen n ṯemɣarṯ ṯegga aman n lwarḏ i Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Wami ikemmeȓ Ƹisa awaȓ nni inna-asen i imeḥḍaren nnes: <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />"Ṯessnem belli Ȓƹiḏ Ameqqran n Ayṯ-Israʼil iqqim-as yuwmayen. Ḏayes iy ɣa itwasellem Mmis n bnaḏem aḏ itwaṣelleb."<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Ssenni munen arruyas n ȓfuqaha ḏ imeqqranen n Ayṯ-Israʼil ḏi ṯeddarṯ n arrays n ȓfuqaha wenni umi qqaren Qiyafa. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Mcawaren jarasen ḥima aḏ ṭṭfen Ƹisa s ṯeḥraymiṯ aṯ nɣen. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Nnan jarasen: Itxeṣṣa war ṯ nteṭṭef ca ḏi Ȓƹiḏ ḥima ccaƹb war itegg ca lfawḍa.<verse eid="MAT 26:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Ƹisa aqaṯ ḏeg ubilaj n Bayt Ƹanya ḏi ṯeddarṯ n yijjen qqaren-as Simƹan bu-jḏam. <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />Ṯqarreb-d ɣares ijjen n ṯemɣarṯ ɣares ijjen n ṯzeyyat itwaṣenƹen s lmarmar,<note caller="+" style="f"><char style="fr" closed="false">26.7 </char><char style="ft" closed="false">Lmarmar netta ḏ ijjen n nnuƹ uzru itcabbah ḏi marmu.</char></note> ḏayes aman n lwarḏ iɣȓan s waṭṭas. Ṯferreɣ-as-ṯen x uzeǧif nnes wami iqqim ɣar missa. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />Wami t ẓrin imeḥḍaren min ṯexḏem, iqqes-asen ȓḥaȓ nnan <char style="it">jarasen</char>: "Mayemmi qaƹ aḍeyyeƹ-a? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Ataf aman nni iȓi menzen s waṭṭas n tmenyaṯ aḏ mmucent i imesƹan!"<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Issen Ƹisa minxef ssiwȓen <char style="it">jarasen</char> inna-asen: "Mayemmi ṯesxeyyaqem ṯamɣarṯ-a? Aqa min ḏayi ṯegga ḏ aṣebḥan aṭṭas. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Imesƹan aqaṯen akiḏwem i ȓebda, nec war kiḏwem tɣimiɣ ca i ȓebda. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Ṯferreɣ-ayi aman-a n lwarḏ x ddat inu ḥima aḏayi ṯsewjeḏ i ṯenḍeȓṯ inu. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Aqa tesȓam ȓḥaqq: Mani ma yuweḍ Lʼinjil ḏi ddunect-a amen-ṯekmaȓ, ataf aḏ ƹawḏen x ṯemɣarṯ-a ḏ min ḏayi ṯegga am yijjen n ḏikra xas."<verse eid="MAT 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Uca ikkar Yahuḏa Isxaryuṭi wenni zi ṯenƹac n arrusul iruḥ netta ɣar arruyas n ȓfuqaha <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />inna-asen: "Min ḏayi ɣa ṯucem meȓa uwiɣ-awem-d Ƹisa?" Ḥesben-as ṯȓaṯin n ṯpeyyasin n nnuqarṯ ucin-as-ṯent. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Ssenni irezzu Yahuḏa lfurṣa mammec iy ɣa igg aḏ izzenz Ƹisa.<verse eid="MAT 26:16" /></para>
  <para style="s">Amensi n Ȓƹiḏ Ameqqran n Ayṯ-Israʼil</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Nhar amezwaru n Ȓƹiḏ n Ṯefḍirṯ qarrben-d imeḥḍaren ɣar Ƹisa nnan-as: "Mani ṯexseḏ aḏac nsewjeḏ amensi n Ȓƹiḏ Ameqqran?"<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Inna-asen Ƹisa: "Ruḥem ɣar ṯendint inim-as i fȓan qa inna-yac Siḏiṯneɣ ṯsaƹƹat inu ṯuweḍ-d akic iy ɣa ƹeyyḏeɣ nec ḏ imeḥḍaren inu." <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Imeḥḍaren ggin minxef ṯen iweṣṣa Ƹisa ssenni swejḏen amensi n Ȓƹiḏ.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Ṯuweḍ-d ṯmeddiṯ, iqqim Ƹisa ak ṯenƹac n arrusul nnes ɣar missa. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Qqimen tetten inna-asen Ƹisa: "Aqa tesȓam ȓḥaqq: Ijjen zzaywem aḏayi izzenz."<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Uca xeyyqen aṭṭas bḏan tseqsan-ṯ ij-ij nnan-as: "War iǧi bu ḏ nec, yac a Siḏi?"<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />Indeq-d Ƹisa inna-asen: Wenni iy kiḏi issisnen ḏi ṭṭebṣi ḏ wenni iy ḏayi ɣa izzenzen. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Mmis n bnaḏem aḏas iwqeƹ ƹlaḥsab mamc xas iqqar Lkitab, walakin ya ȓefḍiḥeṯ n bnaḏem nni iy ṯ ɣa izzenzen! Ḥsen i netta mȓi war d ixȓiq ca."<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Uca inna-as Yahuḏa iƹni wenni iy ṯ ɣa izzenzen: "War iǧi bu ḏ nec, yac a Siḏi?"</para>
  <para style="p" vid="MAT 26:25">Inna-as Ƹisa: "Ḏ cek iy ṯ innan."<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Wami ƹaḏ tetten, iysi-d aɣrum icekkar Arebbi irza aɣrum nni yuca-asen-ṯ i imeḥḍaren nnes inna-asen: "Ysim-ṯ ccem-ṯ, wa ig iǧan ḏ ddat inu." <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />Iysi-d ȓkas icekkar Arebbi yuca-asen-ṯ. Inna-asen: "Swem zzayes marra iḏwem. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Ȓkas-a ḏayes iḏammen<note caller="+" style="f"><char style="fr" closed="false">26.28 </char><char style="ft" closed="false">Iḏammen netta ḏ ddem.</char></note> n ȓƹaheḏ, iƹni ḏ iḏammen inu iy ɣa yazzȓen ƹlaḥsab aṭṭas n yiwḏan ḥima aḏasen iɣfar <char style="it">Arebbi</char> ȓmuƹṣiyaṯ nsen. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Aqa qqareɣ-awem: Zi ssa aȓ ṯsawent war sesseɣ ca zeg waman-a n uḍiȓ ḥetta aȓ Nhar nni iy ṯen ɣa sweɣ akiḏwem zi jḏiḏ ḏi ȓmulk n Baba."<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Ɣennjen ijjen n yizȓi n Ȓƹiḏ, ssenni ffɣen ruḥen ɣar Uḏrar n Zzitun.<verse eid="MAT 26:30" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa issawaȓ x unkar n Buṭrus</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Inna-asen Ƹisa i imeḥḍaren nnes: "Ǧiȓeṯ-a ṯanita aḏayi ṯsemḥem marra iḏwem minzi iqqar Lkitab: Aḏ uwṯeɣ wenni irassen iḥuȓiyen, kuȓ ijjen zi ṯḥimerṯ mani ɣa yarweȓ. <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" />Walakin xmi d ɣa kkareɣ zi ȓmewṯ, aḏawem izwareɣ ɣar ṯmurṯ n Ljalil."<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Indeq-d Buṭrus inna-as: "Waxxa aḏayec ɣa semḥen marra, nec war ḏayec semḥeɣ ca ƹemmarṣ."<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Inna-as Ƹisa: "Aqa tesȓiḏ ȓḥaqq: Ṯa, ǧiȓeṯ-a qbeȓ ma aḏ idden uyaziḍ ataf aḏayi ṯenkareḏ ṯȓaṯa n ṯwaȓaṯin."<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Inna-as Buṭrus: "Nec war c nekkareɣ ca waxxa akiḏec iy ɣa mmṯeɣ." Amenni iy nnan marra imeḥḍaren.<verse eid="MAT 26:35" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa itẓaǧa ḏeg Uḏrar n Zzitun</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Yusa-d Ƹisa ak imeḥḍaren nnes ɣar yijjen n umcan qqaren-as &lt;Gatsimani.&gt; Inna-asen: "Qqimem ḏa, nec aḏ raḥeɣ ḏiha aḏ ẓẓaǧeɣ." <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Yuwi akiḏes Buṭrus ḏ ṯnayen n ṯarwa n Zabadi, ibḏa itnexȓaƹ itxeyyaq. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Inna-asen: "Ȓaƹmar inu ƹȓayen aḏ idduqqez s lḥuzen. Qqimem ḏa ṯfaqem akiḏi." <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />Ibeƹƹeḏ xasen cwayt, isejjeḏ ɣar ṯmurṯ ibḏa itettar i Arebbi inna: "A Baba, meȓa mumkin sbeƹƹeḏ-iṯ xafi ȓkas-a n ȓaƹḏab. Maci mamc xseɣ nec; Lla, mamc ixes ȓxaḍar nnec cek."<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Iḏweȓ ɣar imeḥḍaren-a yufi-ṯen ṭṭṣen, inna-as i Buṭrus: "Ma war ṯzemmarem ca akiḏi ṯfaqem waxxa ḏ ijjen n ṯsaƹƹat waha? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Iȓim ƹlabal ẓẓaǧem ḥima war tiḏfem ca ḏi ȓemḥayen. Uȓ n bnaḏem iwjeḏ walakin ddat nnes ṯeḍƹef." <verse eid="MAT 26:41" /><verse number="42" style="v" sid="MAT 26:42" />Ibeƹƹeḏ xasen ṯwaȓa wis ṯnayen, ittar i Arebbi inna: "A Baba, meȓa ȓkas-a n ȓaƹḏab war xafi ṯesbeƹƹḏeḏ ca swiɣ-ṯ, ataf aḏ yiȓi min ixes ȓxaḍar nnec."<verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />Iḏweȓ-d ƹaweḏ ɣarsen yufi-ṯen ṭṭṣen ȓaḥeqqac iɣelleb xasen yiḍeṣ. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Ibeƹƹeḏ xasen ƹaweḏ, iẓẓuǧ ṯwaȓa wis ṯȓaṯa inna mamc inna qbeȓ.<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />Iḏweȓ-d ɣar imeḥḍaren-a inna-asen: "Ƹaḏ ṯeṭṭṣem, ƹaḏ ṯreyyḥem? Ṣafi, baraka! Aqa ṯuweḍ-d ȓweqṯ nni iy ḏi ɣa itwasellem Mmis n bnaḏem ɣar ifassen n yinni iƹeṣṣan. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Kkarem a nuyurem, qa wenni iy ḏayi ɣa izzenzen aqaṯ yusa-d."<verse eid="MAT 26:46" /></para>
  <para style="s">Ayṯ-Israʼil ḏ irumaniyen teṭṭfen Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Yallah Ƹisa issawaȓ yuweḍ-d Yahuḏa, ijjen zi ṯenƹac nni n arrusul nnes. Yuwi-d akiḏes ȓɣaci aṭṭas ysin ȓesyuf ḏ idebbuzen. Ssekken-ṯen-d arruyas n ȓfuqaha ḏ imeqqranen n Ayṯ-Israʼil. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Wenni iy ṯ ɣa izzenzen <char style="it">iƹni Yahuḏa</char> qbeȓ tuɣa itafeq akiḏsen x yijjen n lƹalama inna-asen: Wenni xef ɣa seǧmeɣ ḏ wenni iy xef ṯrezzum, ṭṭfem-ṯ." <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Ȓexddenni iqarreb Yahuḏa ɣar Ƹisa inna-as: "Ssalam a Siḏi." Uca iseǧem xas.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Inna-as Ƹisa: "Ay ameddukeȓ, minɣar d ṯusiḏ egg-iṯ." Uca qarrben-d ɣar Ƹisa ḥerṯen xas, ṭṭfen-ṯ.<verse eid="MAT 26:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 26:51" />Ikkar-d yijjen zeg yinni ḏinni iǧan ak Ƹisa iswizzeḏ ijbeḏ-d ssif, yuwṯa zzayes ismeɣ n arrayes n ȓfuqaha iqess-as amezzuɣ. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Inna-as Ƹisa: "Arr ssif nnec ɣar umcan nnes, ȓaḥeqqac marra yinni ikessin ssif tmettan s ssif. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Ma tɣir-ac war zemmareɣ aḏ ttareɣ i Baba aḏayi d issekk ȓexxu ktar zi ṯenƹac n ljuyuc n lmalaʼikaṯ? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Walakin mammec iy ɣa ikemmeȓ wawaȓ iy inna Siḏi Arebbi belli manaya itxeṣṣa aḏ iwqeƹ ammu?"<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Ȓexddenni inna-asen Ƹisa i yiwḏan nni: "Ma tɣir-awem qa nec ḏ lmujrim wami d ṯeysim ȓesyuf ḏ idebbuzen ḥima aḏayi ṯeṭṭfem niɣ? Tuɣa tɣimiɣ mkuȓ nhar ḏi ṯemzida ṯameqqrant, seȓmaḏeɣ ḏinni war ḏayi ṯeṭṭifem ca. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Walakin marra manaya iwqeƹ ḥima aḏ ikemmeȓ min yurin ḏi Lkutub n lʼanbiya." Uca semḥen ḏayes marra imeḥḍaren nnes arewȓen.<verse eid="MAT 26:56" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa zzaṯ i Lḥukkam n Ayṯ-Israʼil</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Yinni iṭṭfen Ƹisa uwin-ṯ ɣar arrayes n ȓfuqaha qqaren-as Qiyafa. Munen akiḏes imeqqranen n Ayṯ-Israʼil ḏ imseȓmaḏen n ccariƹa. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Iḏfar-iṯ Buṭrus zi ȓeggwaj, yuḏef ɣar ȓemraḥ n ṯeddarṯ n arrays n ȓfuqaha. Yuḏef iqqim ḏi ȓemraḥ ak iƹessasen ḥima aḏ iẓer min ɣa iweqƹen.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />Arruyas n ȓfuqaha ḏ marra Jmaƹeṯ n lḥukkam n Ayṯ-Israʼil rezzun uw ɣa icehḏen ẓẓur x Ƹisa ḥima aṯ nɣen. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />War ufin ca minxef rezzun waxxa aṭṭas iy xas icehhḏen ẓẓur. Menbaƹd ḥḍaren-d ṯnayen <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />nnan: "Aryaz-a inna: Zemmareɣ aḏ heḏmeɣ ṯamziḏa ṯameqqrant n Arebbi, at bniɣ ḏi ṯeȓtiyyam."<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Uca ibedd arrays n ȓefuqaha inna-as i Ƹisa: "Ma war ṯeqqareḏ walu cek? Min xac cehhḏen yiwḏan-a?"<verse eid="MAT 26:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MAT 26:63" />Iqqim Ƹisa isqar war ḏas yinni walu. Uca inna-as arrays nni: "Tettareɣ zzayec aḏaneɣ ṯejjaǧeḏ s Arebbi iddaren ḥima aḏaneɣ ṯiniḏ: Ma cek ḏ Lmasiḥ ḏ Mmis n Arebbi?"<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Inna-as Ƹisa: "Aqa ṯenniḏ-ṯ cek. Innama, aqa qqareɣ-awem: Zi ssa aȓ ṯsawent aḏ teẓrem Mmis n bnaḏem iqqim x ufusi n Lqawi. Aṯ ṯeẓrem ƹaweḏ ihewwa-d ak useynu n ujenna."<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Ȓexddenni arrays nni n ȓfuqaha iɣareṣ arruḍ x yixef nnes inna-asen: "Ma ṯesȓim-as iqqar lmunkar x Siḏi Arebbi? War neḥḏij bu ȓechuḏ! <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Min ḏawem imeḍharen?"</para>
  <para style="p" vid="MAT 26:66">Nedqen-d nnan: "Wanita isḏaheǧ ȓmewṯ!"<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Ȓexddenni ssusufen xas x uɣembub ccaṯen-ṯ s ȓpunyaṯ. Ȓebƹaḍ zzaysen tseqqaȓen-ṯ <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />qqaren-as: "Iwa a nnabi Lmasiḥ, ssen uw c yuwṯin zzayneɣ!"<verse eid="MAT 26:68" /></para>
  <para style="s">Buṭrus inekkar Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Buṭrus iqqim ɣar barra ḏi ȓemraḥ. Ṯqarreb ɣares ijjen n ṯxeddant ṯenna-as: "Uȓa ḏ cek ṯeǧiḏ ak Ƹisa zi Ljalil."<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Inkar Buṭrus zzaṯ i yiwḏan nni marra inna-as: "War ssineɣ ca minxef ṯessawaȓeḏ!"<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />Iffeɣ Buṭrus iruḥ ṭṭarf n ṯewwarṯ n ȓemraḥ. Ṯeẓri-ṯ ijjen n ṯxeddant nneɣni ṯenna-asen i yinni iḥḍaren ḏinni: "Aryaz-a itiȓi ak Ƹisa zi Naṣira!"<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Inkar Buṭrus ƹaweḏ inna-asen: "Aḏawem jjaǧeɣ, aryaz-a war ṯ ssineɣ ca."<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Menbaƹd cwayt qarrben-d ɣar Buṭrus yinni iḥḍaren ḏinni nnan-as: "Cek ḏ ijjen zzaysen, war ḏayes bu ccekk. Twaƹeqȓeḏ ɣir ḏeg wawaȓ nnec."<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Ikkar Buṭrus ibḏa itḥarram ixef nnes itjaǧa iqqar-asen: "Nec aryaz-a war ṯ ssineɣ ca!" Ȓexddenni idden uyaziḍ. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Ḏinni ifekkar-d Buṭrus awaȓ nni n Ƹisa wami ḏas inna: Qbeȓ ma aḏ idden uyaziḍ ataf aḏayi ṯenkareḏ ṯȓaṯa n ṯwaȓaṯin." Iffeɣ ɣar barra iru imeṭṭawen ḏ imeǧaḥen aṭṭas.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">Ȓmewṯ n Yahuḏa Isxaryuṭi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Wami iṣbaḥ ȓḥaȓ, marra arruyas n ȓfuqaha ḏ imeqqranen n Ayṯ-Israʼil mcawaren jarasen ḥima aḏ nɣen Ƹisa. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Carfen-ṯ uwin-ṯ aṯ sellmen i lḥakem arrumani umi qqaren Bilaṭus.<verse eid="MAT 27:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Yahuḏa wenni ig izzenzen Ƹisa, wami iẓra belli Ƹisa itwaḥkem indem. Wami indem iruḥ ɣar arruyas n ȓfuqaha ḏ imeqqranen n Ayṯ-Israʼil yarra-asen ṯȓaṯin nni n ṯpeyyasin n nnuqarṯ. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />Inna-asen: "Nec ƹṣiɣ wami sellmeɣ ijjen i ȓmewṯ netta war iggi minxef!"</para>
  <para style="p" vid="MAT 27:4">Nnan-as niṯni: "Wenni ḏ ccɣeȓ nnec! Neccin, min ḏaneɣ iruḥen?"<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Ȓexddenni inḍar tmenyaṯ nni ḏi ṯemziḏa ṯameqqrant, iffeɣ ssenni iruḥ ijeyyef ixef nnes.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />Arruyas n ȓfuqaha jemƹen tmenyaṯ nni nnan: "Tmenyaṯ-a ḏ ttaman n iḏammen n bnaḏem.<note caller="+" style="f"><char style="fr" closed="false">27.6 </char><char style="ft" closed="false">Bnaḏem-a netta ḏ Siḏiṯneɣ Ƹisa.</char></note> Ccariƹa nneɣ war ḏaneɣ ṯsemmeḥ aṯent nsers ḏi ṣṣenduq n ṯemziḏa." <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Mcawaren jarasen, sɣin zzaysent ṯamurṯ nni umi qqaren &lt;Iyer n wenni itṣennaƹen ȓeqcuƹ&gt;<note caller="+" style="f"><char style="fr" closed="false">27.7 </char><char style="ft" closed="false">"Ṯamurṯ n wenni itṣennaƹen ȓeqcuƹ" ixes aḏ yini s ṯfransist "Champ-du-Potier." Xzar ƹaweḏ lʼaya 27:10.</char></note> ḥima aḏayes ggen imeḍȓan i ȓbarrani. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />S manayenni iy ḏas qqaren "Iyer iḏammen" ar ȓexxu ƹaḏ.<verse eid="MAT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9" />Amenni ikemmeȓ wawaȓ ig inna nnabi Irmiya ḏeg yijjen n zman: &lt;Jemƹen ṯȓaṯin nni n ṯpeyyasin, ttaman nni iy xef tafqen yiwḏan n Ayṯ-Israʼil iy xas ggin x netta. <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />Sɣin zzaysent ṯamurṯ n wenni itṣennaƹen ȓeqcuƹ; amenni iy ḏayi iweṣṣa Siḏi Arebbi.&gt;<verse eid="MAT 27:10" /></para>
  <para style="s">Tawin Siḏiṯneɣ Ƹisa ɣar lḥakem Bilaṭus</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Ibedd Ƹisa zzaṯ i lḥakem nni arrumani. Isseqsa-ṯ lḥakem inna-as: "Ma ḏ cek ḏ azeǧiḏ n Ayṯ-Israʼil?"</para>
  <para style="p" vid="MAT 27:11">Inna-as Ƹisa: "Aqa ṯenniḏ-t cek."<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Wami ṯ tahamen arruyas n ȓfuqaha ḏ imeqqranen n Ayṯ-Israʼil, war xasen yarri ca.<verse eid="MAT 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13" />Inna-as Bilaṭus: "Ma war tesȓiḏ ca min qqaren ḏ marra min xak tceṯcan?"<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />War xasen yarri Ƹisa bu wawaȓ. Iqqim lḥakem nni itƹejjeb aṭṭas.<verse eid="MAT 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Ḏi mkuȓ Ȓƹiḏ Ameqqran inum lḥakem iḍeǧeq-asen-d i yijjen n umeḥbus ƹlaḥsab wenni ixes ccaƹb. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Ḏi ȓweqṯ nni ɣarsen ijjen n umeḥbus maƹruf qqaren-as Barabas. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Wami munen yiwḏan, isseqsa-ṯen lḥakem Bilaṭus inna-asen: "Manwen iy ṯexsem aḏawem d rxuɣ, ma i Barabas niɣ i Ƹisa wenni umi qqaren Lmasiḥ?" <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Tuɣa issen Bilaṭus belli sellmen-as Ƹisa ȓaḥeqqac ḥesḏen-ṯ.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Wami iqqim lḥakem Bilaṭus x ȓkursi n ȓeḥkam, ṯessekk-d ɣares ṯemɣarṯ nnes ṯenna-as: "Tarek-as i uryaz-a iṣfan ȓaḥeqqac ƹeddbeɣ aṭṭas ǧiȓeṯ-a ḏi ṯirjiṯ x ssabab nnes."<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Walakin arruyas n ȓfuqaha ḏ imeqqranen n Ayṯ-Israʼil qeȓben azeǧif i ȓɣaci ḥima aḏasen d isufeɣ Barabas, Ƹisa aḏ immeṯ.<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />Isseqsa-ṯen lḥakem inna-asen: "Manwen iy ṯexsem zi ṯnayen-a aḏas rxuɣ?"</para>
  <para style="p" vid="MAT 27:21">Nnan-as: "Barabas."<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />Inna-asen Bilaṭus: "Iwa, min ḏas ɣa ggeɣ i Ƹisa wenni umi qqaren Lmasiḥ?"</para>
  <para style="p" vid="MAT 27:22">Nnan-as marra: "Ṣelleb-iṯ!"<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Inna-asen Bilaṭus: "Mayemmi? Man ljarima ig igga wanita?"</para>
  <para style="p" vid="MAT 27:23">Walakin arennin snekkaren ṯɣuyyeṯ s jjheḏ qqaren: "Ṣelleb-iṯ!"<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Wami yufa Bilaṭus belli war iqḍi walu arnin ḏi lfawḍa, iysi aman isireḏ ifassen nnes zzaṯ i ȓɣaci nni inna-asen: "Aqa nec tberriɣ azeǧif inu zeg iḏammen<note caller="+" style="f"><char style="fr" closed="false">27.24 </char><char style="ft" closed="false">Iḏammen netta ḏ ddem.</char></note> n uryaz-a! Aqaṯ x yiri nwem!"<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Arrin xas marra iḏsen nnan-as: "Iḏammen nnes x yiri nneɣ ḏ ṯarwa nneɣ!"<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Ssenni iḍȓeq-asen-d i Barabas. Ƹisa uwṯin-ṯ s usɣun, uca isellem-asen-ṯ Bilaṭus ḥima aṯ ṣellben x ṣṣalib.<verse eid="MAT 27:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Uwin-ṯ ȓƹaskar n lḥakem ɣar ȓemraḥ n ȓeqṣar n lḥakem, smunen-d ḏinni marra lfirqa n ȓƹaskar nni. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Kksen-as arruḍ nnes, ggin xas aseȓham ḏ azeggwaɣ. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Muḏen-as ijjen n ttaj n isennanen, ggin-as-ṯ x uzeǧif nnes. Ggin-as ɣanim ḏeg ufus afusi, wḍan-as ɣar ifadden bḏan tbuṣaren xas. Qqaren-as ssalam ay azeǧiḏ n Ayṯ-Israʼil! <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Ssusufen xas, ysin ɣanim nni bḏan ccaṯen-ṯ zzayes ɣar uzeǧif.<verse eid="MAT 27:30" /></para>
  <para style="s">Tawin Siḏiṯneɣ Ƹisa ḥima aṯ ṣellben</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 27:31" />Wami xas kemmȓen abuṣar, kksen-as aseȓham nni ggin-as arruḍ nnes uwin-ṯ ḥima aṯ ṣellben. <verse eid="MAT 27:31" /><verse number="32" style="v" sid="MAT 27:32" />Ffɣen ssenni ȓƹaskar ufin ijjen n uryaz qqaren-as Simƹan zi ṯendint n Lqurina, ggin xas s bezzez aḏ yarbu ṣṣalib n Ƹisa. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Uwḍen ɣar yijjen n umcan qqaren-as "Gulguṭa" (ȓmaƹna n yisem-a: Amcan n Jumjuma).<note caller="+" style="f"><char style="fr" closed="false">27.33 </char><char style="ft" closed="false">Jumjuma nettaṯ ḏ iɣes uzeǧif n wenni immuṯen.</char></note> <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Ucin-as aman uḍiȓ ixelleṭ ḏaysen ijjen n ddwa ḏ amerzag. Wami ṯen iqqas, yugi aṯen isew. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Wami ṯ ṣellben, ggin lqurƹa x warruḍ nnes ferqen-ṯ jarasen. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Qqimen ḏinni ḥḍan-ṯ. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Ɣar uzeǧif nnes ggin-as ijjen n ṯeȓwiḥet ṯura ḏayes ttuhma nni iqqaren: "Wanita ḏ Ƹisa, azeǧiḏ n Ayṯ-Israʼil." <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Ṣellben akiḏes ṯnayen n iceffaren, ijjen x ufusi ijjen x uẓeȓmaḍ nnes.<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />Iwḏan iy tekken ssenni tukkaren-ṯ thezzan azeǧif nsen, <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />qqaren-as: "Ma ḏ cek iy ɣa iheḏmen ṯamziḏa ṯameqqrant at tebniḏ ḏi ṯeȓtiyyam? Meȓa cek ḏ Mmis n Arebbi, nejja ixef nnec hwa-d zeg ujenna zi ṣṣalib-a!"<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Uȓa ḏ arruyas n ȓfuqaha akiḏsen imeqqranen n Ayṯ-Israʼil ḏ imseȓmaḏen n ccariƹa tbuṣaren xas qqaren: <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />"Isenjem inneɣni, walakin war izemmar ca <char style="it">ȓexxu</char> aḏ isenjem ixef nnes!" Nnan-as: "Hwa-d ay azeǧiḏ n Ayṯ-Israʼil ȓexxu zeg ujenna zi ṣṣalib-a ḥima azzayek namen! <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Itwekkeȓ x Arebbi; Meȓa irḍa xas Arebbi aṯ isenjem ȓexxu! Ȓaḥeqqac inna: Nec ḏ Mmis n Arebbi." <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Amenni ƹaweḏ iy ṯ zawaren iceffaren nni iy kis iṣellben.<verse eid="MAT 27:44" /></para>
  <para style="s">Ȓmewṯ n Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Ɣar ṯenƹac n uziȓ ṯehwa-d ṯaǧest x ṯmurṯ amen-ṯekmaȓ aȓ wami ƹȓayen ḏ ṯȓaṯa uƹecci. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Aȓ jwayeh nni n ṯȓaṯa uƹecci iȓaɣa Ƹisa s jjheḏ inna: "<char style="bd">Ili, Ili, lma sbaqṯani?</char>" Ȓmaƹna n wawaȓ-a: "Ya Arebbi, ya Arebbi, mayemmi ḏayi ṯsemḥeḏ?"<note caller="+" style="f"><char style="fr" closed="false">27.46 </char><char style="ft" closed="false">Xzar Zzabur (Psaumes) 22:1.</char></note> <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />Sȓin-as ȓebƹaḍ zeg yinni iḥḍaren ḏinni nnan: "Aqa itȓaɣa x nnabi Ilyas." <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Ȓexddenni iruḥ ijjen zzaysen iqȓeƹ itazzeȓ, iysi ijjen n spunxa iseɣḏeṣ-it ḏeg waman uḍiȓ ḏ isemmamen, iggi-t x yij ukeccuḍ yuca-as aḏ isew. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Nnan-as yiwḏan nneɣni ḏinni: "Ejj-iṯ, a nẓer ma aḏ d yas nnabi Ilyas ma aṯ iƹṯeq niɣ lla!" <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />Iȓaɣa Ƹisa ƹaweḏ s yijjen n ṯmijja ṯemɣar uca isellem buḥbeȓ nnes.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Ȓexddenni ig iqqars arrwaq n ṯemziḏa ṯameqqrant x ṯnayen zeg ujenna aȓ ṯmurṯ. Iwqeƹ zzinzal, nferqen yizra x ṯnayen. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Nurzmen imeḍȓan kkaren-d aṭṭas n ȓmuminin immuṯen <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />ffɣen-d zeg imeḍȓan. (Menbaƹd <char style="it">i ṯeȓtiyyam</char> aḏ d ikkar Ƹisa zi ȓmewṯ, niṯni aḏ aḏfen ɣar ṯendint n Lquds aḏ d meḍharen i waṭṭas n yiwḏan.) <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />Aƹaskari nni ameqqran n arrumanus ḏ yinni akiḏes iḥeṭṭan Ƹisa ẓrin zzinzal nni ḏ min iweqƹen, ggwḏen aṭṭas nnan: "Wanita ḏ Mmis n Arebbi ḏ ṣṣaḥ!"<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Ḏinni aṭṭas n ṯemɣarin xezzarent-id zi ȓeggwaj. Niṯenti tuɣa ḏfarent-ṯ, tsexxarent xas wami tuɣaṯ iǧa ḏi ṯmurṯ n Ljalil. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Ḏaysent Maryam ṯamagdaliṯ, ḏ Maryam yemmas n Yaƹqub amezyan ḏ Yusef, ḏ icten nneɣni nettaṯ ḏ yemmas n ṯarwa n Zabadi.<verse eid="MAT 27:56" /></para>
  <para style="s">Neṭṭȓen Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Wami d ṯuweḍ ṯmeddiṯ, yusa-d ijjen n ttajar qqaren-as Yusef zi dcar n Arimatya. Netta s yixef nnes tuɣa iḏweȓ ḏ ameḥḍar n Ƹisa. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Iruḥ ɣar lḥakem Bilaṭus ittar-as ddat n Ƹisa, ikkar Bilaṭus iweṣṣa xas aḏas t ucen. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Iruḥ Yusef sehwa-t-id <char style="it">zi ṣṣalib</char>, ikeffen-it s ȓecfen inqa. <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />Isers-it ḏeg unḍeȓ nnes ḏ jḏiḏ. Netta tuɣa iɣez-iṯ <char style="it">zi qbeȓ </char>ḏeg uzru <char style="it">igga am yifri</char>. Iseqnunni ijjen n uzru ḏ ameqqran yarri-ṯ x uqemmum n unḍeȓ nni yuyur. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Maryam ṯamagdaliṯ ḏ Maryam nni nneɣni aqaṯent ḏinni qqiment zzaṯ i unḍeȓ.<verse eid="MAT 27:61" /></para>
  <para style="s">Iƹessasen x unḍeȓ</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Ṯiwecca nnes, iƹni nhar n ssebṯ n lƹibada, ruḥen arruyas n ȓfuqaha ḏ ȓḥizeb n ifarrisiyen munen ɣar lḥakem Bilaṭus. <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />Nnan-as: "Neccin neƹqeȓ a siḏi belli wami tuɣa iddar uɣeddar nni inna-d menbaƹd i ṯeȓtiyyam nec aḏ d kkareɣ zi ȓmewṯ." <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Nnan-as: "Iwa weṣṣa aḏ ggen ȓƹasseṯ x unḍeȓ nnes ḥetta aȓ wis ṯeȓtiyyam ḥima war d tisen imeḥḍaren nnes aḏ ysin ddat nnes aḏ inin i ccaƹb belli ikkar-d zi ȓmewṯ. Ssenni aḏ iwqeƹ uɣḏar nnes aneggaru ktar zeg wenni amezwaru."<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />Inna-asen lḥakem Bilaṭus: "Ha ȓƹaskar iy ɣa iƹesssen. Ruḥeṯ ggeṯ ȓƹasseṯ x unḍeȓ mammec ṯexsem kenniw." <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Ruḥen ggin ȓƹasseṯ x unḍeȓ: cemƹen ṯawwarṯ nnes,<note caller="+" style="f"><char style="fr" closed="false">27.66 </char><char style="ft" closed="false">Cemƹen ṯawwarṯ n unḍeȓ, zaƹma ggin ijjen n ṭṭabaƹ niɣ ijjen n lƹalama x ṯewwarṯ unḍeȓ bac meȓa ṯerzem ṯewwarṯ aḏ ssnen belli ṯerzem.</char></note> jjin ḏinni iƹessasen.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Siḏiṯneɣ Ƹisa ikkar-d zi ȓmewṯ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Wami iƹḏu nhar n ssebṯ n lƹibada, ɣar ȓefjar ḏi nhar n ȓḥad ṯusa-d Maryam ṯamagdaliṯ ḏ Maryam nneɣni ḥima aḏ ẓrent anḍeȓ <char style="it">n Ƹisa</char>. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Ƹlaɣafla ṯenhezz ṯmurṯ ij unhezzi ḏ ameqqran ȓaḥeqqac ṯehwa-d ijjen n lmalaʼika n Arebbi zeg ujenna, ṯekkes azru nni <char style="it">x ṯewwarṯ</char> ṯeqqim xas. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Uḏem nnes itceƹciƹ s nnur am wassam, arruḍ nnes netta ḏ acemȓaȓ amecnaw aḏfeȓ. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Iƹessasen <char style="it">n unḍeȓ</char> ggwḏen zzayes terjijin, qqimen am imettinen.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />Ṯendeq-d lmalaʼika nni ṯenna-asent i ṯemɣarin: "War teggwḏent ca, nec ssneɣ belli ṯrezzunt x Ƹisa itwaṣellben. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Netta war ḏa iǧi ca, ikkar-d zi ȓmewṯ ƹlaḥsab mammec inna zi qbeȓ. Araḥent-id aḏ teẓrent amcan nni mani tuɣa iǧa. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Ruḥent ḏeɣya ɣar imeḥḍaren nnes inint-asen aqa ikkar-d zi ȓmewṯ. Aḏ iraḥ ɣar ṯmurṯ n Ljalil akenniw iraja ḏinni. Ḏinni iy ṯ ɣa ṯeẓrem, qa nniɣ-awem-ṯ."<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Kkarent niṯenti ruḥent ḏeɣya zeg unḍeȓ nni, ggwḏent walakin farḥent aṭṭas. Tazzȓent aḏ ssiwḍent ȓexbar-a ɣar imeḥḍaren n Ƹisa.<verse eid="MAT 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9" />Ssenni imeȓqa akiḏsent Ƹisa inna-asent: "Azul." Qarrbent ɣares ṭṭfent ḏeg iḍaren nnes sejjḏent-as.<verse eid="MAT 28:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 28:10" />Ȓexddenni inna-asent Ƹisa: "War teggwḏent ca. Ruḥent siwḍent ȓexbar inint i ayṯma: Ruḥeṯ ɣar ṯmurṯ n Ljalil ḏinni iy ḏayi ɣa ṯeẓrem."<verse eid="MAT 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Wami ruḥent niṯenti, ȓebƹaḍ n ȓƹaskar nni itƹesssen x unḍeȓ ḏewȓen ɣar ṯendint ssiwḍen-asen ȓexbar i arruyas n ȓfuqaha x marra min iweqƹen. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Munen arruyas nni n ȓfuqaha ak imeqqranen n Ayṯ-Israʼil. Wami mcawaren jarasen, ucin-asen ijjen n lƹadad n tmenyaṯ i ȓƹaskar nni. <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />Nnan-asen i ȓƹaskar: "Aḏ tinim i yiwḏan qa usin-d imeḥḍaren nnes s ǧiȓeṯ, ysin ddat nnes wami tuɣa neccin neṭṭeṣ. <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />U meȓa yarra-d lḥakem ȓexbar, a nemsefham akiḏes akenniw nesbeƹƹeḏ x lmuckila-ya." <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Kkaren ysin tmenyaṯ nni ȓƹaskar, ggin ƹlaḥsab mammec ṯen weṣṣan. Amenni intacar wawaȓ jar Ayṯ-Israʼil ɣar ȓexxu.<verse eid="MAT 28:15" /></para>
  <para style="s">Ȓuṣiyeṯ n Siḏiṯneɣ Ƹisa ṯaneggarut</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Ruḥen ḥiṭac nni n imeḥḍaren ɣar ṯmurṯ n Ljalil ɣar uḏrar nni ƹlaḥsab mammec tuɣa ṯen iweṣṣa Ƹisa zi qbeȓ. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Wami ṯ ẓrin, sejjḏen-as walakin ḏinni ȓebƹaḍ <char style="it">ƹaḏ</char> cekken. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Iqarreb-d ɣarsen Ƹisa, issiweȓ akiḏsen inna-asen:</para>
  <para style="p" vid="MAT 28:18">
    <char style="bd">"Ṯemmuc-ayi marra ssulṭa ḏeg ujenna ḏ ṯmurṯ. </char><verse eid="MAT 28:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 28:19" />
    <char style="bd">Iwa ruḥeṯ ɣar yiwḏan n marra ȓegnus, </char></para>
  <para style="p" vid="MAT 28:19">
    <char style="bd">arrem-ṯen ḏ imeḥḍaren inu. </char></para>
  <para style="p" vid="MAT 28:19">
    <char style="bd">Ṭehharem-ṯen s waman </char></para>
  <para style="p" vid="MAT 28:19">
    <char style="bd">s yisem n Baba ḏ Mmis ḏ Arruḥ iqeddsen.</char><verse eid="MAT 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 28:20" />
    <char style="bd">Sȓemḏem-asen aḏ ggen marra minzi kenniw weṣṣiɣ. </char></para>
  <para style="p" vid="MAT 28:20">
    <char style="bd">Aqa nec akiḏwem iȓiɣ ȓebda aȓ ɣa ifna zman!"</char><verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>