<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id" />
  <para style="h">Yuḥanna</para>
  <para style="toc3">Yuḥ</para>
  <para style="toc2">Yuḥanna</para>
  <para style="toc1">Aseȓmeḏ n Siḏiṯneɣ Ƹisa Lkitab n Yuḥanna</para>
  <para style="mt1">Aseȓmeḏ n Siḏiṯneɣ Ƹisa</para>
  <para style="mt3">Lkitab n Yuḥanna</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">Awaȓ n Arebbi netta ḏ nnur netta ḏ ṯuḏarṯ</para>
  <para style="q1">
    <verse number="1" style="v" sid="JHN 1:1" />
    <char style="bd">Ḏeg umezwaru iǧa wawaȓ. </char></para>
  <para style="q1" vid="JHN 1:1">
    <char style="bd">Awaȓ nni iǧa ak Arebbi. </char></para>
  <para style="q1" vid="JHN 1:1">
    <char style="bd">Awaȓ nni ḏ netta ig iǧan ḏ Arebbi. </char><verse eid="JHN 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JHN 1:2" />
    <char style="bd">Ḏeg umezwaru iǧa ak Arebbi. </char><verse eid="JHN 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JHN 1:3" />
    <char style="bd">Zzayes iy d ixȓeq Arebbi marra, </char></para>
  <para style="q1" vid="JHN 1:3">
    <char style="bd">u bȓa awaȓ nni </char></para>
  <para style="q1" vid="JHN 1:3">
    <char style="bd">war tiȓi uȓa ḏ ijjen n ṯmesȓayṯ zi min d ixȓeq. </char><verse eid="JHN 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JHN 1:4" />
    <char style="bd">Ḏayes iy ṯeǧa ṯuḏarṯ, </char></para>
  <para style="q1" vid="JHN 1:4">
    <char style="bd">u ṯuḏarṯ nni nettaṯ ḏ nnur i yiwḏan. </char><verse eid="JHN 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JHN 1:5" />
    <char style="bd">Nnur nni itceƹciƹ ḏi ṯaǧest, </char></para>
  <para style="q1" vid="JHN 1:5">
    <char style="bd">ṯaǧest nni war ḏas ṯzemmar. </char><verse eid="JHN 1:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />Yusa-d ijjen n uryaz issekk-iṯ-iḏ Arebbi qqaren-as Yaḥya. <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />Netta yusa-d ḏ ccaheḏ ḥima aḏ icheḏ i nnur, ḥima s chaḏeṯ nnes aḏ amnen marra iwḏan. <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />Netta Yaḥya war iǧi ca ḏ nnur; Lla, yusa-d aḏ icheḏ i nnur, <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />iƹni nnur nni nican tuɣa d itasen ɣar ddunect-a aḏ iceƹceƹ x kuȓ bnaḏem.<verse eid="JHN 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10" />Nnur nni tuɣa iǧa ḏi ddunect. Waxxa ḏ netta ig iggin ddunect, ayṯbab n ddunect war ṯ ssinen ca. <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />Yusa-d ɣar ṯmurṯ nnes, ayṯbab n ṯmurṯ nnes war ṯ qbiȓen ca. <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />Yinni iy ṯ iqebȓen umnen zzayes zeg yisem nnes, yuca-asen netta ṯizemmar ḥima aḏ ḏewȓen ḏ ṯarwa n Arebbi. <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />Yina war d xȓiqen ca ƹlaḥsab ddurriṯ uȓa ƹlaḥsab min texs ddat uȓa ƹlaḥsab ȓxaḍar n uryaz; Lla, ḏ Arebbi iy ṯen d ijjin.<verse eid="JHN 1:13" /></para>
  <para style="s">Awaȓ n Arebbi netta ḏ Siḏiṯneɣ Ƹisa Lmasiḥ</para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />Awaȓ-a iḏweȓ ḏ bnaḏem, izḏeɣ jaraneɣ. Neccin neẓra lƹaḍama ɣares iǧan, lƹaḍama-ya ṯeǧa ɣar Mmis waḥḏes n Babas. Netta iccur s arḍa ḏ lḥaqiqa. <verse eid="JHN 1:14" /><verse number="15" style="v" sid="JHN 1:15" />Icheḏ xas Yaḥya, itberraḥ inna: "Ḏ wa iy xef tuɣa ssiwȓeɣ nniɣ-awem aḏ d yas ijjen menbaƹd i nec, walakin netta imɣar xafi minzi tuɣaṯ qbeȓ ma aḏ iȓiɣ nec."<verse eid="JHN 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16" />S lbaraka nnes ṯameqqrant ibarek-aneɣ marra s arḍa x arḍa. <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />Ccariƹa <char style="it">n Ayṯ-Israʼil</char> ṯemmuc x ufus n Musa. Arḍa ḏ lḥaqiqa niṯenti usint-id x ufus n Ƹisa Lmasiḥ. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />Uȓa ḏ ijjen war iẓri Arebbi ƹemmarṣ. Mmis waḥḏes ig iǧan ḏeg wuȓ n Babas ḏ netta iy ḏaneɣ d ismeḍharen <char style="it">Siḏi Arebbi</char>.<verse eid="JHN 1:18" /></para>
  <para style="s">Nnabi Yaḥya isewjaḏ abriḏ i Lmasiḥ</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />Ḏ ṯa ḏ chaḏeṯ n Yaḥya wami ɣares d ssekken israʼiliyen can n ȓfuqaha ḏ can n ccurfa n Ayṯ-Lawi zi ṯendint n Lquds ḥima aṯ sseqsan nnan-as min ṯeƹniḏ cek?<verse eid="JHN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20" />Yaḥya war inkar ca ixef nnes, iƹtaref-asen inna-asen: "Nec war ǧiɣ ca ḏ Lmasiḥ."<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />Nnan-as: "Y min ṯeƹniḏ, ma ḏ nnabi Ilyas?"</para>
  <para style="p" vid="JHN 1:21">Inna-asen: "Maci ḏ nec."</para>
  <para style="p" vid="JHN 1:21">Nnan-as: "Cek, ma ḏ nnabi <char style="it">iy qqaren aḏ d yas</char>?"</para>
  <para style="p" vid="JHN 1:21">Inna-asen: "Lla."<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />Nnan-as: "Y cek, min ṯeƹniḏ? Ḥima a naf min ɣa nini i yinni iy ḏaneɣ d issekken, min ṯeqqareḏ x yixef nnec?"<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />Yarra xasen s wawaȓ n nnabi umi qqaren Icaƹya inna qbeȓ:</para>
  <para style="q1" vid="JHN 1:23">"Nec ḏ ṯmijja itȓaɣan ḏi ȓexȓa ṯeqqar:</para>
  <para style="q1" vid="JHN 1:23">Swejḏeṯ abriḏ nican i Siḏi Arebbi."<verse eid="JHN 1:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />Yinni iy ɣares d issekken niṯni zi ȓḥizeb n ifarrisiyen. <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />Nnan-as: "Meȓa cek war ṯeǧiḏ ca ḏ Lmasiḥ niɣ ḏ Ilyas niɣ ḏ nnabi <char style="it">iy d ɣa yasen</char>, mayemmi cek tṭehhareḏ i yiwḏan s waman?"<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />Indeq-d Yaḥya inna-asen: "Nec tṭehhareɣ i yiwḏan s waman, walakin ḏanita ijjen ḏi ȓwesṭ nwem war ṯ ṯessinem ca. <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />Ḏ netta iy d ɣa yasen menbaƹd i nec, war sḏihiǧeɣ aḏas fesyeɣ uȓa ḏ ifiȓan n ṯsiȓa nnes."<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />Marra manaya iwqeƹ ḏeg ubilaj n Bayt Ƹanya ajemmaḍ i yiɣzar n Lʼurdun mani ig itṭehhar Yaḥya i yiwḏan s waman.<verse eid="JHN 1:28" /></para>
  <para style="s">Nnabi Yaḥya icehheḏ x Siḏiṯneɣ Ƹisa ḏ Mmis n Arebbi</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />Ṯiwecca nnes Yaḥya itwaȓa Ƹisa iggur-d ɣares, inna: "Xzarzeṯ, ḏ win ḏ Izmar n Arebbi iy ɣa ikksen ȓmuƹṣiyeṯ x yiwḏan marra. <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />Ḏ win iy xef tuɣa ssiwȓeɣ nniɣ-awem: Aḏ d yas menbaƹd i nec ijjen n uryaz, walakin netta imɣar xafi minzi tuɣaṯ qbeȓ ma aḏ iȓiɣ nec. <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />Tuɣa nec s yixef inu war ṯ ssineɣ ca min iƹna, walakin usiɣ-d aḏ ṭehhareɣ i yiwḏan s waman ḥima aḏasen d iban netta i Ayṯ-Israʼil."<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />Yaḥya icheḏ xas inna: "Ẓriɣ Arruḥ n Arebbi ihwa-d zeg ujenna igga am yijjen n ṯeḏbirṯ ṯmars <char style="it">x Ƹisa</char>. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />Tuɣa nec war ṯ ssineɣ ca min iƹna, walakin ḏ Arebbi iy ḏayi d issekken aḏ ṭehhareɣ i yiwḏan s waman, netta inna-ayi: Wenni ɣa ṯeẓreḏ ihwa-d xas Arruḥ imars xas, ḏ netta iy ɣa iṭehharen i yiwḏan s Arruḥ iqeddsen. <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />Nec ẓriɣ manaya s yixef inu, cehhḏeɣ xas belli netta ḏ Mmis n Arebbi."<verse eid="JHN 1:34" /></para>
  <para style="s">Imeḥḍaren imezwura n Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />Ṯiwecca nnes ƹaweḏ ibedd ḏinni Yaḥya ak ṯnayen n imeḥḍaren nnes. <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />Wami yufa Ƹisa iƹḏu ssenni inna-asen: "Xzarem, ḏ win ḏ Izmar iy d issekk Arebbi." <verse eid="JHN 1:36" /><verse number="37" style="v" sid="JHN 1:37" />Kkaren ṯnayen nni n imeḥḍaren wami ḏas sȓin issawaȓ x Ƹisa, ḏfaren-ṯ.<verse eid="JHN 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 1:38" />Ineqȓeb Ƹisa ɣar ḏeffar yufi-ṯen ḏfaren-ṯ-iḏ inna-asen: "Min trezzum?"</para>
  <para style="p" vid="JHN 1:38">Nnan-as: "A Ravi, mani tiȓiḏ?" (Awaȓ-a Ravi ixes aḏ yini Lmuƹallim.)<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />Inna-asen: "Araḥem-d aḏ texzarem." Ruḥen akiḏes ẓrin mani itiȓi. Ṯsaƹƹat ƹȓayen ḏ arbeƹa n uƹecci, ssenni sensen akiḏes nhar nni.<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />Ijjen zi ṯnayen nni n imeḥḍaren qqaren-as Andrus, umas n Simƹan Buṭrus, isȓa i wawaȓ n Yaḥya iḏfar Ƹisa. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />Ȓexddenni yufa umas Simƹan inna-as nufa Lmasiya. (Awaȓ-a Lmasiya ixes aḏ yini Lmasiḥ.) <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />Issiweḍ-iṯ-iḏ ɣar Ƹisa. Wami ṯ iẓra Ƹisa inna-as: "Cek ḏ Simƹan mmis n Yuḥanna, zi ssa aȓ ṯsawent aḏac tȓaɣan Ṣifas." (Awaȓ-a Ṣifas ixes aḏ yini Buṭrus.)<verse eid="JHN 1:42" /></para>
  <para style="b" />
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />Ṯiwecca nnes Ƹisa ixes aḏ iraḥ ɣar ṯmurṯ n Ljalil. Iruḥ yufa ijjen qqaren-as Filippas inna-as: "Ḏfar-ayi-d!"<verse eid="JHN 1:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 1:44" />Filippas netta zi Bayt Ṣayda, abilaj n Andrus ḏ Buṭrus. <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />Filippas yufa ijjen qqaren-as Naṯnahil inna-as: "Nufa wenni iy xef yura Musa ḏi ccariƹa, mixef urin Lkutub n Lʼanbiya. Netta ḏ Ƹisa zeg ubilaj n Naṣira ḏ mmis n Yusef."<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />Inna-as Naṯnahil: "Min iṣebḥan zi Naṣira!?"</para>
  <para style="p" vid="JHN 1:46">Inna-as Filippas: "Araḥ-d, aḏ texzareḏ."<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />Ƹisa iẓra Naṯnahil iggur-d ɣares inna: "Wanita nican zi Ayṯ-Israʼil, war ḏayes bu ixarwiḍen."<verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />Inna-as Naṯnahil i Ƹisa: "Minzi ḏayi ṯessneḏ?"</para>
  <para style="p" vid="JHN 1:48">Inna-as Ƹisa: "Ẓriɣ-c swadday i ṯcejjarṯ n ṯazarṯ, qbeȓ ma c d iȓaɣa Filippas."<verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />Inna-as Naṯnahil i Ƹisa: "A Lmuƹallim, qa cek ḏ Mmis n Arebbi, cek ḏ azeǧiḏ n Ayṯ-Israʼil."<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />Inna-as Ƹisa: "Ma ṯumneḏ wami c nniɣ ẓriɣ-c swadday i ṯcejjarṯ n ṯazarṯ?" Inna-as: "Ƹaḏ aḏ teẓreḏ ktar zi manaya. <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />Aqa tesȓam ȓḥaqq: Aḏ teẓrem ajenna innurzem, lmalaʼikaṯ n Arebbi taȓint hewwant-id x Mmis n bnaḏem."<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">Lmuƹjiza ṯamezwarut n Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />Ḏi nhar wis ṯeȓtiyyam ḏinni ijjen n ȓfarḥ ḏeg ubilaj n Qana ḏi ṯmurṯ n Ljalil. Ḏinni yemmas n Ƹisa. <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />Uȓa ḏ Ƹisa ḏ imeḥḍaren nnes twaƹarḍen ɣar ȓfarḥ nni. <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />Wami war ɣarsen qqimen waman n uḍiȓ, ṯenna-as yemmas i Ƹisa qa aman n uḍiȓ qḍan.<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />Inna-as Ƹisa: "A ṯamɣarṯ, maci ḏ ccɣeȓ inu. Nec ȓweqṯ inu ƹaḏ war d tusi ca."<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />Ṯenna-asen yemmas i ixeddamen: "Ggem min ḏawem iqqar."<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />Ḏinni ḏi <char style="it">ṯeddarṯ</char> nni setta n iqnucen n waman ƹlaḥsab mammec nnumen teggen zzaysen israʼiliyen ȓuḍu. Iqnucen nni twaxeḏmen s uzru, kuȓ ijjen ikessi zi ṯmanin aȓ miyya u ƹicrin litru n waman. <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />Inna-asen Ƹisa i ixeddamen: "Ƹemmarem iqnucen-a s waman." Ƹemmaren-ṯen s waman aȓ uqemmum. <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />Inna-asen: "Aymem cwayt awim-ṯen i wenni itkellafen zi ȓfarḥ." Uca uwin-as ci ḥaja. <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />Ufin aman ƹadi nni ḏewȓen ḏ aman n uḍiȓ. Wenni itkellafen zi ȓfarḥ-a iqqas-iṯen walakin netta war issin ca manis d kkin waman-a n uḍiȓ. Ixeddamen nnes iy ḏas d yuymen aman-a, ḏ niṯni ig ssnen manis d ikka manaya. Ṯumma wenni ikellfen zi ȓfarḥ issiweȓ ak muȓay <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />inna-as: "Ƹadatan ḏeg umezwaru iwḏan ticcen-asen i inewjiwen aman n uḍiȓ iṣebḥanen. Xmi tiȓi swin zzaysen aṭṭas, ḏi ȓweqṯ nni iy ḏasen ticcen aman n uḍiȓ ƹadi. Cek lla, ṯxemmȓeḏ aman n uḍiȓ iṣebḥanen aȓ ȓexxu."<verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />Ṯanita ḏ lmuƹjiza ṯamezwarut ig igga Ƹisa. Iggi-t ḏeg ubilaj n Qana ḏi ṯmurṯ n Ljalil. Ismeḍhar-d lƹaḍama nnes, umnen zzayes imeḥḍaren nnes. <verse eid="JHN 2:11" /><verse number="12" style="v" sid="JHN 2:12" />Menbaƹd i manaya ihwa ɣar ubilaj n Kafernaḥum, netta ḏ yemmas ḏ ayṯmas ḏ imeḥḍaren nnes, qqimen ḏinni ḏrus n wussan.<verse eid="JHN 2:12" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa itazzeȓ x yinni iteggen ttijara ḏi ṯemziḏa ṯameqqrant</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />Wami d yuweḍ Ȓƹiḏ Ameqqran n Ayṯ-Israʼil, ikkar Ƹisa yuȓi ɣar ṯendint n Lquds. <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />Yufa ḏi ṯemziḏa ṯameqqrant znuzan ḏayes ifunasen ḏ iḥuȓiyen ḏ iḏbiren, uȓa ḏ iṣarrafen qqimen ḏinni tṣerrafen tmenyaṯ. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />Imuḏ iseɣwan, s iseɣwan nni yuzzeȓ xasen marra zi ṯemziḏa ṯameqqrant s iḥuȓiyen ḏ ifunasen. Iqȓeb-asen missaṯ n yinni itṣarrafen, izeǧeƹ-asen tmenyaṯ nni ḏi ṯmurṯ. <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />Inna-asen i yinni iznuzan iḏbiren: "Ysiṯ manaya ssanita. War tarraṯ ca ṯaddarṯ n Baba ḏ ssuq!"<verse eid="JHN 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 2:17" />Fekkaren imeḥḍaren nnes manaya yusa-d ḏi Lkitab: "Aḏ ṣeddqeɣ ṯuḏarṯ inu x ȓemḥibbeṯ n ṯemziḏa nnec."<verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />Kkaren israʼiliyen nnan-as: "Man lƹalama ṯameqqrant iy ɣa ṯeggeḏ bac aɣarec yiȓi ȓḥaqq aḏ teggeḏ manaya?"<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />Inna-asen Ƹisa: "Heḏmeṯ ṯamziḏa-ya ṯameqqrant, nec atid siȓiɣ ḏi ṯeȓtiyyam!"<verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />Nnan-as israʼiliyen: "Cek, atid ṯsiȓiḏ ḏi ṯeȓtiyyam? Ṯamziḏa-ya ṯameqqrant ṯebna ḏi setta u arbeƹin iseggwusa!" <verse eid="JHN 2:20" /><verse number="21" style="v" sid="JHN 2:21" />Walakin ṯamziḏa ṯameqqrant minxef issawaȓ Ƹisa nettaṯ ḏ ddat nnes. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />Wami d ikkar zi ȓmewṯ, fekkaren imeḥḍaren nnes min ḏasen inna, umnen zi Lkitab ḏ wawaȓ iy inna Ƹisa.<verse eid="JHN 2:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />Wami iǧa ḏi ṯendint n Lquds ḏi Ȓƹiḏ Ameqqran n Ayṯ-Israʼil, aṭṭas n yiwḏan iy zzayes yumnen zeg yisem nnes wami ẓrin lmuƹjizaṯ ig itegg. <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />Walakin netta war ḏaysen ittiqi ca minzi issen iwḏan marra min ḏaysen. <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />War iteḥḏiji bu ȓechuḏ x yiwḏan, netta iƹȓem x wuȓawen nsen.<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">Siḏiṯneɣ Ƹisa iseȓmaḏ x ubriḏ n jḏiḏ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />Tuɣa iǧa ijjen n uryaz qqaren-as Nikudim zi ȓḥizeb n ifarrisiyen. Netta ḏ ijjen zi lḥukkam n Ayṯ-Israʼil. <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />Yusa-d ɣar Ƹisa s ǧiȓeṯ inna-as: "A Lmuƹallim, neccin nessen belli cek ḏ amseȓmaḏ iy d yusin zi Arebbi. War izemmar uȓa ḏ ijjen aḏ igg can lmuƹjizaṯ zi min teggeḏ cek illa meȓa kiḏes Arebbi."<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />Indeq-d Ƹisa inna-as: "Aqa tesȓiḏ ȓḥaqq: War izemmar uȓa ḏ ijjen aḏ iẓer ȓmulk n Arebbi illa meȓa ixȓeq-d ḏ jḏiḏ."<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />Inna-as Nikudim: "Mammec ɣa igg bnaḏem aḏ d ixȓeq ḏ jḏiḏ meȓa iwsar? Ma izemmar aḏ yaḏef ƹaweḏ ḏeg uƹeddis n yemmas aḏ d ixȓeq ḏ jḏiḏ?"<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />Inna-as Ƹisa: "Aqa tesȓiḏ ȓḥaqq: Meȓa can yijjen war d ixȓiq ca s waman ḏ Arruḥ n Arebbi, war izemmar aḏ yaḏef ḏi ȓmulk n Arebbi. <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />Min itwaxeȓqen zi ddat, nettaṯ ḏ ddat. Min itwaxeȓqen zi Arruḥ n Arebbi, netta ḏ arruḥ. <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />Meȓa nniɣ-ac itxeṣṣa-kenniw aḏ d txeȓqem ḏ jḏiḏ, war tƹejjib ca. <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />Arriḥ itṣuḍ mani ixes netta. Aḏ tesȓiḏ i ṣṣut nnes, walakin war ṯessineḏ ca manis d ikka uȓa ḏ mani ɣa iraḥ. Ammu iy ggin marra yinni itwaxeȓqen s Arruḥ n Arebbi."<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />Inna-as Nikudim: "Mammec manaya?"<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />Yarra xas Ƹisa inna-as: "Iwa ṯseȓmaḏeḏ cek Ayṯ-Israʼil war ṯfehhimeḏ ca manaya? <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />Aqa tesȓiḏ ȓḥaqq: Neccin nessawaȓ zi min nessen, ncehheḏ s min neẓra, walakin kenniw war ṯeqbiȓem ca chaḏeṯ nneɣ. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />Meȓa ssiwȓeɣ ɣarwem x ṯmesȓayin n ṯmurṯ kenniw war timnem ca, mammec ɣa ṯamnem meȓa ssiwȓeɣ-awem x ṯmesȓayin n ujenna? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />Uȓa ḏ ijjen ma yuȓi ɣar ujenna illa wenni d ihwan zeg ujenna, netta ḏ Mmis n bnaḏem.<verse eid="JHN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14" />Amecnaw mammec isbedd Musa fiɣer n neḥḥas x ṯeḥnact ḏi ȓexȓa, ammu itxeṣṣa aḏ itwasbedd Mmis n bnaḏem ḏeg ujenna.<note caller="+" style="f"><char style="fr" closed="false">3.14 </char><char style="ft" closed="false">Manaya itas-d zi Lkitab n Lʼarqam 21:6-9. Iḍȓeq-d Siḏi Arebbi ifiɣeran mesmumin x ccaƹb bḏan teqqsen-asen, mmuṯen xarrebi zzaysen. Yusa-d ccaƹb ɣar Siḏna Musa nnan-as: "Nexḍa wami netceṯca u nessiweȓ ḏi Siḏi Arebbi uȓa ḏayec. Ttar-as i Arebbi ḥima axaneɣ isbaƹƹeḏ ifiɣeran-a." Ssenni Siḏna Musa ittar i Arebbi. Yarra-d Arebbi x Siḏna Musa inna-as: "Ƹḏeȓ ij ufiɣer s neḥḥas egg-iṯ x yijjen n ṯeḥnact, aɣares xzaren yinni umi qqsen ifiɣeran ḥima aḏ ddaren." Iruḥ Siḏna Musa iƹḏeȓ fiɣer nni s neḥḥas iggi-ṯ x ṯeḥnact. Tuɣa wenni umi iqqes ufiɣer ixezzar ɣar ufiɣer nni n neḥḥas iteddar. </char></note> <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />Marra wenni zzayes ɣa yamnen aɣares ṯiȓi ṯuḏarṯ i ȓebda."<verse eid="JHN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 3:16" />Wami iḥibb Arebbi ddunect-a, ihḏa-yas Mmis aweḥḏani ḥima wenni zzayes ɣa yamnen war ifenni ca aɣares ṯiȓi ṯuḏarṯ n ȓebda. <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />Arebbi war d issekk ca Mmis ɣar ddunect ḥima aḏ iḥaseb iwḏan; Lla, issekk-iṯ-iḏ ḥima azzayes isenjem iwḏan. <verse eid="JHN 3:17" /><verse number="18" style="v" sid="JHN 3:18" />Wenni zzayes itamnen ataf war itwaḥasab ca. Wenni war zzayes itimnen ca aqa itwaḥasab minzi netta war yumin ca zeg yisem n Mmis n Arebbi aweḥḏani. <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />Ḏ wa ḏ lḥukem <char style="it">iy xas ɣa yiȓin</char>: Nnur yusa-d ɣar yiwḏan, yiwḏan xsen ṯaǧest ḥsen zi nnur minzi teggen ccarr. <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />Marra wenni iteggen min iǧan ḏ aƹeffan itƹiffa nnur, war ɣares d itis ca ɣar nnur ḥima war tnefḍiḥent ca ȓefƹayeȓ nnes. <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />Wenni ixeddmen nican aḏ d yas ɣar nnur. Ammu aḏ d iban belli ȓexḏayem nnes itegg-iṯent i Arebbi.<verse eid="JHN 3:21" /></para>
  <para style="s">Nnabi Yaḥya icehheḏ belli Siḏiṯneɣ Ƹisa imɣar x kuȓci</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />Menbaƹd i manaya Ƹisa ḏ imeḥḍaren nnes usin-d ɣar ṯmurṯ n Yahuḏiya iqqim akiḏsen ḏinni, itṭehhar i yiwḏan s waman. <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />Uȓa ḏ Yaḥya itṭehhar i yiwḏan s waman ḏi Ȓƹunṣar n Nun ḏi ṭṭarf n ṯendint n Salim minzi ḏinni aman aṭṭas. Tasen-d ḏinni yiwḏan ḥima aṯen iṭehhar. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />(Iwqeƹ manaya qbeȓ ma aḏ ggen Yaḥya ḏi ȓeḥbes.) <verse eid="JHN 3:24" /><verse number="25" style="v" sid="JHN 3:25" />Iwqeƹ lxilaf jar imeḥḍaren n Yaḥya ḏ yijjen n uʼisraʼili x mammec ɣa yiȓi ȓuḍu. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />Usin-d ɣar Yaḥya nnan-as: "A Lmuƹallim, wenni tuɣa akiḏec iǧan ajemmaḍ i yiɣzar n Lʼurdun u cek ṯcehḏeḏ xas, netta itṭehhar i yiwḏan s waman gguren ɣares marra."<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />Inna-asen Yaḥya: "War izemmar bnaḏem aɣares ṯiȓi can ṯmesȓayṯ meȓa war ḏas d tusi ca zi Arebbi. <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />Kenniw s yixef nwem ṯcehḏem qa nniɣ-awem: Nec war ǧiɣ ca ḏ Lmasiḥ; Lla, twassekkeɣ-d qbeȓ i netta. <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />Wenni ɣar ṯeǧa ṯsȓiṯ, netta ḏ muȓay. Awzir n muȓay<note caller="+" style="f"><char style="fr" closed="false">3.29 </char><char style="ft" closed="false">Awzir n muȓay netta ḏ ṣaḥeb lƹaris niɣ ḏ ameddukeȓ n muȓay.</char></note> iƹni wenni itbeddan zzaṯes itsȓa-yas, netta ifarreḥ aṭṭas i wawaȓ n muȓay. Ammu uȓa ḏ nec farḥeɣ aṭṭas. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />U labud netta aḏ imɣar, nec aḏ neqṣeɣ."<verse eid="JHN 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />Wenni iy d itasen zeg ujenna, netta imɣar x kuȓci. Walakin wenni iy d itasen zi ṯmurṯ netta zi ṯmurṯ, issawaȓ amecnaw iwḏan n ṯmurṯ. Wenni iy d itasen zeg ujenna, netta imɣar x kuȓci. <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />Icehheḏ zi min iẓra ḏ min isȓa, walakin chaḏeṯ nnes war t iqebbeȓ uȓa ḏ ijjen. <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />Wenni iqebbȓen chaḏeṯ nnes, ataf itḥaqqeq belli Arebbi ḏ lḥaqiqa ig iǧa. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />Wenni iy d issekk Arebbi issawaȓ s wawaȓ n Arebbi minzi iticc-as Arruḥ nnes bȓa ȓeqyas. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />Babas iƹizz xas Mmis, igga-as kuȓci ḏeg ufus nnes. <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />Wenni itamnen zi Mmis ataf ɣares ṯuḏarṯ n ȓebda. Wenni war itṭiƹin ca i Mmis, ataf war ɣares bu ṯuḏarṯ axas iɣḍeb Arebbi."<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">Aṭṭas n yiwḏan zi Samarya tamnen zi Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />Issen Ƹisa belli ifarrisiyen arrin-d ȓexbar wami d marnin ɣares imeḥḍaren itṭehhar-iṯen s waman ktar zi Yaḥya. <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />Walakin Ƹisa s yixef nnes war itṭehhar ca i yiwḏan, ḏ imeḥḍaren nnes ig iggin manayenni. <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />Ssenni iffeɣ zi ṯmurṯ n Yahuḏiya, iruḥ ɣar ṯmurṯ n Ljalil. <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />Itxeṣṣa-yas i netta aḏ ikk x ṯmurṯ n Samarya. <verse eid="JHN 4:4" /><verse number="5" style="v" sid="JHN 4:5" />Ikka x yijjen n ṯendint zi Samarya qqaren-as Suxar, zzaṯ i umarjeƹ nni ig yuca Yaƹqub i mmis Yusef. <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />Ḏinni anu n Yaƹqub. Wami Ƹisa yuḥeȓ s ubriḏ ag uzyen n nhar, iqqim ɣar wanu nni n Yaƹqub.<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7-8" style="v" sid="JHN 4:7-8" />Ṯusa-d icten n ṯemɣarṯ zi Samarya aḏ tayem aman. Imeḥḍaren n Ƹisa niṯni tuɣa ruḥen ɣar ṯendint aḏ sɣen min ɣa ccen. Inna-as Ƹisa i ṯemɣarṯ nni: "Uc-ayi aḏ sweɣ."<verse eid="JHN 4:7-8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />Ṯenna-as ṯemɣarṯ nni: "Cek ḏ aʼisraʼili, nec ḏ ṯasamariṯ. Mammec ḏac ṯexȓeq cek ṯettareḏ-ayi aḏ tesweḏ?" (Iwa israʼiliyen qa war temṣurufen ca ak yiwḏan n Samarya.)<verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />Inna-as Ƹisa: "Maƹlik cem ṯessneḏ lhadiya n Arebbi ṯessneḏ min ƹniɣ nec iy ḏam iqqaren uc-ayi aḏ sweɣ, ataf ṯettareḏ-ayi cem aman aḏam uceɣ aman n ṯuḏarṯ."<verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />Ṯenna-as: "A Siḏi, war ɣarek ca minzi ɣa ṯaymeḏ. Anu-ya yuǧeɣ, manis d ɣa ṯawiḏ aman nni n ṯuḏarṯ? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />Jeddiṯneɣ Yaƹqub yuca-aneɣ anu-ya, iswa zzayes netta s yixef nnes ḏ ṯarwa nnes ḏ ȓebhayem nnes. Ma ṯḥessbeḏ ixef nnec ktar zzayes?"<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />Indeq-d Ƹisa inna-as: "Marra wenni ɣa iswen zeg waman-a ataf aḏ iffaḏ ƹaweḏ. <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />Walakin wenni ɣa iswen aman iy ḏas ɣa uceɣ nec ataf war itfiḏi ca ƹemmarṣ. Aman iy ḏas ɣa uceɣ nec aḏ ḏewȓen ḏayes amecnaw ijjen n ȓƹunṣar azzayes ṯesfiy ṯuḏarṯ n ȓebda."<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />Ṯenna-as ṯemɣarṯ nni: "A Siḏi, uc-ayi aman nni ḥima war tfiḏiɣ ca, war d tiseɣ ca war taymeɣ ca aman ssanita."<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />Inna-as Ƹisa: "Ruḥ ȓaɣa-d i uryaz nnem, ḏweȓ-d ḏanita."<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />Ṯenna-as ṯemɣarṯ nni: "War ɣari bu aryaz."</para>
  <para style="p" vid="JHN 4:17">Inna-as Ƹisa: "Wah, cem ṯessiwȓeḏ nican wami ṯenniḏ war ɣari bu aryaz, <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />minzi ṯuwiḏ xemsa n iryazen. Aryaz nni mikeḏ tƹiceḏ ȓexxu war iǧi bu ḏ aryaz nnem. Iwa ɣarem ṣṣaḥ ḏi min ṯenniḏ."<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />Ṯenna-as ṯemɣarṯ nni: "A Siḏi, twaȓiɣ cek ḏ nnabi. <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />Ȓejḏuḏ nneɣ ƹebbḏen Arebbi ḏeg uḏrar-a, kenniw israʼiliyen ṯeqqarem qa itxeṣṣa a neƹbeḏ ḏeg umcan n Lquds."<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />Inna-as Ƹisa: "Tiqqa-ayi a ṯamɣarṯ, aḏ d tas ijjen n ȓweqṯ ataf kenniw war ṯƹebbḏem ca Baba uȓa ḏeg uḏrar-a uȓa ḏi Lquds. <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />Kenniw ṯƹebbḏem wenni war ṯessinem ca, neccin nƹebbeḏ wenni iy nessen minzi asenjem ikka-d zeg israʼiliyen. <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />Walakin aḏ d tas ȓweqṯ aqa ȓexxu ṯusa-d, maƹlik yinni iƹebbḏen nican ataf aḏ ƹebbḏen Baba s lḥaqiqa ḏ arruḥ. Ḏ yina iy xef irezzu Baba. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />Arebbi netta ḏ Arruḥ, yinni iy ṯ iƹebbḏen itxeṣṣa-yasen aṯ ƹebḏen s lḥaqiqa ḏ arruḥ."<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />Ṯenna-as ṯemɣarṯ nni: "Nec qa ssneɣ aḏ d yas Lmasiya, qqaren-as Lmasiḥ. Xmi d ɣa yas aḏaneɣ yini kuȓci."<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />Inna-as Ƹisa: "Qa ḏ nec iy kiḏem issawaȓen."<verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />Wami d ƹeqben imeḥḍaren nnes, tƹejjben wami ṯ ufin issawaȓ ak yijjen n ṯemɣarṯ. Walakin war ḏas yinni uȓa ḏ ijjen min ɣares ṯrezzuḏ ɣar ṯa? Niɣ, mayemmi iy kiḏes ṯessawaȓeḏ?<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />Ṯejja ṯemɣarṯ nni aqḏiḥ<note caller="+" style="f"><char style="fr" closed="false">4.28 </char><char style="ft" closed="false">Aqḏiḥ netta ḏ ṯagemburṯ niɣ ḏ ṯaqeǧaȓṯ.</char></note> nnes ṯruḥ ɣar ṯendint, ṯenna-asen i yiwḏan: <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />"Araḥem-d aḏ teẓrem ijjen n uryaz inna-ayi marra min ggiɣ. Imken ḏ Lmasiḥ niɣ?" <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />Ffɣen yiwḏan nni zi ṯendint ruḥen ɣares.<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />Ḏi ȓweqṯ nni qqaren-as imeḥḍaren A Lmuƹallim, ecc!<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />Walakin netta inna-asen: "Ɣari min tetteɣ, kenniw war ṯ ṯessinem ca."<verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />Imeḥḍaren nnes sseqsan ayawya Ma yuwi-as-d ḥadd min ɣa icc?<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />Inna-asen Ƹisa: "Ȓmakla inu aḏ xeḏmeɣ min ixes wenni ḏayi d issekken aḏ kemmȓeɣ ȓxeḏmeṯ nnes. <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />Ɣarwem ijjen n lmiṯal iqqar: Menbaƹd i arbeƹa n churaṯ aḏ d tas ȓweqṯ n umjar. Nec aḏawem iniɣ: Rezmeṯ ṯiṭṭawin nwem xzareṯ imarjeƹiwen, ṯuweḍ-d ȓweqṯ n umjar. <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />Wenni imejjaren aḏ iysi texȓiseṯ nnes ijemmeƹ ṯafeǧaḥṯ i ṯuḏarṯ n ȓebda, ḥima aḏ munen ḏi ȓefraḥeṯ nsen yinni izerrƹen ḏ yinni imejjaren. <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />Iƹni ḏ ṣṣaḥ min iqqar lmiṯal: Ijjen izerreƹ, ijjen imejjar. <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />Nec ssekkeɣ-d kenniw aḏ temjarem mani war ṯzerƹem ca. Inneɣni zerƹen, kenniw ṯestenfaƹem zi ȓxeḏmeṯ nsen."<verse eid="JHN 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />Aṭṭas n yiwḏan zi jjiheṯ n Samarya umnen zi Ƹisa wami ṯecheḏ ṯemɣarṯ nni ṯenna-asen qa inna-ayi marra min ggiɣ. <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />Wami iy ɣares d usin yiwḏan zi Samarya ƹarḍen-ṯ akiḏsen iqqim. Ssenni iqqim akiḏsen yumayen ḏinni. <verse eid="JHN 4:40" /><verse number="41" style="v" sid="JHN 4:41" />Wami sȓin awaȓ n Ƹisa marnin yiwḏan iy zzayes yumnen. <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />Nnan-as i ṯemɣarṯ nni neccin war ntimen ca ȓexxu ɣir ƹlaḥsab min ḏaneɣ ṯenniḏ cem, minzi issiweȓ akiḏneɣ s yixef nneɣ u neccin nessen belli ḏ ṣṣaḥ ḏ wa ig isenjamen ddunect.<verse eid="JHN 4:42" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa isgenfa mmis n yij umxazni</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />Menbaƹd i yumayen iffeɣ ssenni Ƹisa, iruḥ ɣar ṯmurṯ n Ljalil. <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />U netta s yixef nnes iqqar uȓa ḏ ijjen n nnabi ma meḥtarem ḏi ṯmurṯ nnes. <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />Wami yuweḍ ɣar Ljalil reḥḥben zzayes yiwḏan minzi niṯni ẓrin marra ṯimesȓayin ig igga ḏi Ȓƹiḏ ḏi Lquds. Uȓa ḏ niṯni tuɣa ḥḍaren ḏinni ḏi Ȓƹiḏ.<verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />Yusa-d ƹaweḏ ɣar ubilaj n Qana ḏi ṯmurṯ n Ljalil mani tuɣa yarra aman ƹadi ḏ aman n uḍiȓ. U ḏeg ubilaj n Kafernaḥum ḏinni ijjen zeg imxazniyen n uzeǧiḏ ihȓec mmis. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />Amxazni nni wami d yarra ȓexbar Ƹisa yusa-d zi ṯmurṯ n Yahuḏiya ɣar ṯmurṯ n Ljalil, iruḥ ɣares inna-as ma kiḏi ṯehwiḏ ḥima aḏ tesgenfiḏ memmi? Qa ƹȓayen aḏ immeṯ.<verse eid="JHN 4:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 4:48" />Inna-as Ƹisa: "Kenniw, ma war timnem ca ḥetta aḏ teẓrem lmuƹjizaṯ ḏ lburhanaṯ?"<verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />Inna-as umxazni: "A Siḏi, yallah akiḏi ṯehwiḏ qbeȓ ma aḏ immeṯ uḥenjir inu."<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />Inna-as Ƹisa: "Ruḥ, aqa mmic iddar."</para>
  <para style="p" vid="JHN 4:50">Aryaz nni yumen zeg wawaȓ nni iy ḏas inna Ƹisa uca iruḥ. <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />Ihewwa-d netta, mseȓqan akiḏes ixeddamen nnes nnan-as qa aḥarmuc nnec iddar.<verse eid="JHN 4:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52" />Isseqsa-ṯen inna-asen: "Man ṯsaƹƹat nni ig igenfa?"</para>
  <para style="p" vid="JHN 4:52">Nnan-as: "Ɣar lwaḥḏa n yiḍennaṭ ag uƹecci ṯruḥ xas ṯmessi iy ḏayes."<verse eid="JHN 4:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 4:53" />Ȓexddenni yufa babas qa ḏi ȓweqṯ nni iy ḏas inna Ƹisa mmic aḏ iddar. Yumen netta ḏ marra ayṯbab n ṯeddarṯ nnes. <verse eid="JHN 4:53" /><verse number="54" style="v" sid="JHN 4:54" />Ḏ ṯanita ḏ lmuƹjiza wis ṯnayen ig igga Ƹisa zeg wami iy d iffeɣ zi ṯmurṯ n Yahuḏiya ɣar ṯmurṯ n Ljalil.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">Siḏiṯneɣ Ƹisa isgenfa ijjen n unecruf</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />Menbaƹd i manaya igaƹƹeḏ Ƹisa ɣar ṯendint n Lquds ḏeg yijjen n ȓƹiḏ n Ayṯ-Israʼil. <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />Ḏi Lquds zzaṯ i Ṯewwarṯ Uḥuȓi ḏinni ṭṭarf nnes ijjen n ṣṣarij qqaren-as s wawaȓ n Ayṯ-Israʼil Bayt Ḥisda, ɣares xemsa n iseqqifen. <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />Tɣiman ḏinni aṭṭas n imehȓac ḏ iḍarɣaȓen ḏ izeḥḥafen ḏ inecrufen,<note caller="+" style="f"><char style="fr" closed="false">5.3 </char><char style="ft" closed="false">Anecruf netta zeg yinni icarrfen zeg iḍaren niɣ zeg uƹrur war zemmaren ca aḏ uyuren.</char></note> {trajan aman n ṣṣarij aḏ nhezzen. <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />Ṯhewwa-d Ijjen n lmalaʼika n Arebbi ɣar ṣṣarij nni ṯsenhezza aman nnes. Wenni ɣa ihwan ḏ amezwaru ḏeg waman nni xmi tenhezzan ataf aṯ sgenfan zi ȓehȓec nnes mammec ma igga.}<verse eid="JHN 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 5:5" />Ḏinni ijjen n umehȓuc ṯmenya u ṯȓaṯin iseggwusa netta ihȓec. <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />Yufi-ṯ Ƹisa izzeȓ ḏinni, issen qa aṭṭas n ȓweqṯ zeg wami netta ihȓec. Inna-as: "Ma ṯexseḏ aḏ tgenfiḏ?"<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />Inna-as umehȓuc nni: "A Siḏi, war ɣari wi ḏayi ɣa isersen ḏi ṣṣarij xmi tenhezzan waman. Nec meȓmi ma rezzuɣ aḏ hwiɣ, tizwaren-ayi inneɣni."<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />Uca inna-as Ƹisa: "Kkar, ysi ṯassuṯ nnec, uyur." <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />Ȓexddenni igenfa uryaz nni, iysi ṯassuṯ nnes yuyur. Ḏi nhar n ssebṯ n lƹibada ig iwqeƹ manaya.<verse eid="JHN 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 5:10" />Kkaren israʼiliyen nnan-as i wenni igenfan: "Nhara ḏ nhar n ssebṯ n lƹibada, war ɣarek bu ȓḥaqq aḏ teysiḏ ṯassuṯ nnec."<verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />Inna-asen: "Wenni ḏayi isgenfan inna-ayi ysi ṯassuṯ nnec, uyur."<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />Nnan-as: "Wi ḏac innan ysi ṯassuṯ nnec, uyur?"<verse eid="JHN 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13" />Aryaz nni war issin ca min iƹna wenni iy ṯ isgenfan minzi Ƹisa iweddar ḏi ȓɣaci nni.<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />Menbaƹd i manayenni Ƹisa yufa wenni <char style="it">igenfan</char> aqaṯ ḏi ṯemziḏa ṯameqqrant n Ayṯ-Israʼil inna-as: "Aqac ṯgenfiḏ, war tegg bu ȓmuƹṣiyaṯ ƹaweḏ ḥima war ḏac itewqiƹ ktar zi min tuɣa ḏayec."<verse eid="JHN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15" />Iruḥ uryaz nni inna-asen i israʼiliyen qa ḏ Ƹisa iy ḏayi isgenfan. <verse eid="JHN 5:15" /><verse number="16" style="v" sid="JHN 5:16" />S manayenni rezzun israʼiliyen aḏ ƹeddben Ƹisa minzi itegg manaya ḏi nhar n ssebṯ n lƹibada.<verse eid="JHN 5:16" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa isenjam iwḏan iticc-asen ṯuḏarṯ</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 5:17" />Inna-asen Ƹisa: "Baba ixeddem ȓebda, uȓa ḏ nec xeddmeɣ am netta."<verse eid="JHN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18" />S manaya israʼiliyen rezzun ktar aṯ nɣen. War iǧi bu x ssabab n nhar n lƹibada u ṣafi, walakin ƹaweḏ xmi ḏasen iqqar belli Arebbi ḏ Babas itemsawa ixef nnes ak Arebbi.<verse eid="JHN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />Inna-asen Ƹisa: "Aqa tesȓam ȓḥaqq: Mmis war izemmar aḏ igg can ṯmesȓayṯ s yixef nnes, ɣir min iẓerr zi Babas aqa itegg-iṯ. Min ma itegg Babas aqa itegg-iṯ uȓa ḏ Mmis. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />Babas itexs Mmis, isbeyyan-as marra min itegg. Aḏas isbeyyen ȓexḏayem ṯimeqqranin x ṯmesȓayin-a ḥima aḏ tƹejjbem! <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />Mammec d isnekkar Babas yinni immuṯen iticc-asen ṯuḏarṯ, uȓa ḏ Mmis iticc-asen ṯuḏarṯ i yinni ixes. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />Babas war itḥissib ḥadd, yuca-as lḥisab marra i Mmis <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />ḥima marra aḏ karmen Mmis amec tkarramen Babas. Wenni war itkarrimen ca Mmis war itkarrim ca uȓa ḏ Babas iy ṯiḏ issekken.<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />Aqa tesȓam ȓḥaqq: Wenni itsȓan i wawaȓ inu itamen zeg wenni ḏayi d issekken, aɣares ṯiȓi ṯuḏarṯ n ȓebda war itiḏef ca ḏi lƹiqab, netta aḏ imutti zi ȓmewṯ ɣar ṯuḏarṯ. <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />Aqa tesȓam ȓḥaqq: Aḏ d tas ȓweqṯ aqa ȓexxu ṯusa-d, aḏ sȓen imettinen i ṣṣut n Mmis n Arebbi u yinni ḏas ɣa isȓen aḏ ddaren. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />Am Babas ɣares ṯuḏarṯ ḏeg yixef nnes, ammu iy ḏas yuca i Mmis aɣares ṯiȓi ṯuḏarṯ ḏeg yixef nnes. <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />Yuca-as ƹaweḏ jjheḏ ḥima aḏ iḥaseb minzi netta ḏ Mmis n bnaḏem.<verse eid="JHN 5:27" /></para>
  <para style="p">
    <verse number="28-29" style="v" sid="JHN 5:28-29" />War tƹejjibem ca x manaya, qa aḏ d tas ȓweqṯ ḏayes ɣa sȓen ṣṣut nnes marra yinni iǧan ḏeg imeḍȓan niṯni aḏ d kkaren. Yinni iggin ṯimesȓayin ṯiṣebḥanin aḏ raḥen ɣar ṯuḏarṯ. Yinni iggin ṯimesȓayin ṯiƹeffanin aḏ d kkaren aḏ raḥen ɣar lƹiqab. <verse eid="JHN 5:28-29" /><verse number="30" style="v" sid="JHN 5:30" />Nec war zemmareɣ aḏ ggeɣ walu zeg yixef inu. Mammec tesȓiɣ, ammu tḥasabeɣ. Lḥisab inu n ȓḥaqq minzi nec war rezzuɣ ca min xseɣ; Lla, rezzuɣ min ixes wenni iy ḏayi d issekken."<verse eid="JHN 5:30" /></para>
  <para style="s">Icehheḏ Arebbi x Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />"Maƹlik cehḏeɣ x yixef inu, iȓi chaḏeṯ inu war ṯeǧi bu nican. <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />Ijjen nneɣni icehheḏ xafi. Nec ssneɣ chaḏeṯ iy xafi icehheḏ nettaṯ nican iy ṯeǧa.<verse eid="JHN 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 5:33" />Kenniw tuɣa ṯessekkem-d ɣar Yaḥya, netta icheḏ x lḥaqiqa. <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />Walakin nec war ḥḏijeɣ ca chaḏeṯ n bnaḏem. Qqareɣ-awem manaya ḥima aḏ tnejmem. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />Yaḥya yusa-d ḏ ȓefnar ireqqan itecriqen, kenniw ṯexsem aḏ tfarḥem can ȓiyyam s nnur nnes. <verse eid="JHN 5:35" /><verse number="36" style="v" sid="JHN 5:36" />Walakin nec ɣari ijjen n chaḏeṯ ḏ ṯameqqrant x ṯenni n Yaḥya. Min ḏayi d yuca Baba aṯid sbaneɣ, ṯimesȓayin-a s yixef nsent cehhḏent xafi belli issekk-ayi-d Baba. <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />Baba ḏayi d issekken ḏ netta iy xafi icehḏen. Kenniw ƹemmarṣ war ṯesȓim ca ṣṣut nnes, ƹemmarṣ war ṯeẓrim ca uḏem nnes. <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />Awaȓ nnes war ḏaywem itɣimi ca minzi wenni iy ṯid issekken war zzayes timnem ca. <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />Ṯrezzum ḏi Lkutub kenniw tɣir-awem ḏaysen ṯuḏarṯ n ȓebda. Iwa uȓa ḏ yina cehhḏen xafi. <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />Waxxa amenni kenniw war ṯxisem ca aɣari d tasem ḥima aɣarwem ṯiȓi ṯuḏarṯ.<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />War ḥḏijeɣ ca aḏayi semɣaren yiwḏan. <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />Ssneɣ-kenniw belli war ḏaywem bu ȓemḥibbeṯ n Arebbi. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />Nec usiɣ-d ḏeg yisem n Baba, kenniw war ḏayi ṯeqbiȓem ca. Walakin, meȓa yusa-d can yijjen nneɣni ɣarwem ḏeg yisem nnes nniṯ waha aṯ ṯqebȓem.<verse eid="JHN 5:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 5:44" />Mammec ɣa ṯeggem aḏ tamnem? Iwa kenniw texsem lƹaḍama n wayawya, war ṯrezzum ca x lƹaḍama n Arebbi aweḥḏani. <verse eid="JHN 5:44" /><verse number="45" style="v" sid="JHN 5:45" />War tfekkarem ca azzaywem ceṯciɣ ɣar Baba; Lla, wenni iy zzaywem ɣa iceṯcan netta ḏ Musa wenni ḏi ṯeggim lʼamal nwem. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />Maƹlik kenniw ṯumnem ḏi Musa, iȓi ṯumnem ḏayi uȓa ḏ nec minzi netta yura xafi. <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />Meȓa kenniw war ṯuminem ca zi min yura, mammec ɣa ṯeggem aḏ tamnem ḏeg wawaȓ inu?"<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">Siḏiṯneɣ Ƹisa iticc i xemsaȓaf n iryazen aḏ ccen</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />Menbaƹd i manaya iruḥ Ƹisa aḏ iẓwa ȓebḥar n Ljalil (qqaren-as i ȓebḥar nni Ṭabarya). <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />Ḏfaren-ṯ aṭṭas n yiwḏan wami ẓrin lmuƹjizaṯ nni wami isgenfa imehȓac. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />Igaƹƹeḏ Ƹisa ɣar uḏrar iqqim ak imeḥḍaren nnes. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />Ȓƹiḏ Ameqqran n Ayṯ-Israʼil war ḏas iqqim ca aḏ d yaweḍ. <verse eid="JHN 6:4" /><verse number="5" style="v" sid="JHN 6:5" />Iysi Ƹisa ṯiṭṭawin nnes yufa ȓɣaci gguren-d ɣares, inna-as i Filippas: "Manis d ɣa nseɣ aɣrum bac aḏasen nuc i yina aḏ ccen?" <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />Iqqar-as ammu ḥima aṯ ijarreb ȓaḥeqqac netta issen min ɣa ixḏem.<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />Inna-as Filippas: "Meȓa nseɣ-d aɣrum s miyyatayen n ṯpiyyasin n nnuqarṯ, war itqiddi uȓa ḏ ijjen n uremmuz i yijjen."<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />Inna-as ijjen zeg imeḥḍaren nnes, netta ḏ Andrus umas n Simƹan Buṭrus: <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />"Aqa ij uḥenjir ɣares xemsa n ṯxebbazin n imendi ḏ ṯnayen n iseȓman, walakin manaya war ḏasen itqiddi ca i ȓɣaci-ya."<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />Inna-asen Ƹisa: "Sɣimeṯ iwḏan-a." Amcan nni mani qqimen ḏinni aṭṭas n arbiƹ u ḏinni can xemsaȓaf n iryazen. <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />Iysi-d Ƹisa aɣrum nni icekkar Arebbi, ifreq-iṯ i yinni iy ḏinni iqqimen. Ammu igga uȓa i iseȓman, <char style="it">ucin-asen</char> ƹlaḥsab min rezzun.<verse eid="JHN 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 6:12" />Wami jjiwnen, inna-asen i imeḥḍaren nnes: "Jemƹeṯ iȓeqquzen nni iceṭṭen ḥima war itemḍeyyiƹ walu." <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />Wami jemƹen, ufin ṯenƹac n ṯeqrabin ccurent zeg iȓeqquzen nni iceṭṭen x yinni iccin zi xemsa n ṯxebbazin n imendi nni.<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />Wami ẓrin lmuƹjiza nni iy igga, iwḏan nnan qa ḏ wanita ḏ nnabi ḏ ṣṣaḥ tuɣa d ɣa yasen aḏ yiȓi ḏi ddunect-a.<verse eid="JHN 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 6:15" />Issen Ƹisa belli rezzun aṯ arran ḏ azeǧiḏ s bessif. Ikkar yuyur ssenni, iḏweȓ ɣar iḏurar waḥḏes.<verse eid="JHN 6:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />Ag uƹecci, hwan-d imeḥḍaren nnes ɣar ȓebḥar. <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />Nyin ḏi ṯɣarrabut raḥen aḏ qeḍƹen ȓebḥar ɣar ubilaj n Kafernaḥum. Ṯuweḍ-d ǧiȓeṯ u Ƹisa netta ƹaḏ war ɣarsen d yusi. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />Ikkar-d akiḏsen ȓebḥar, itṣuḍ arriḥ aṭṭas. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />Wami niṯni tuɣa uyuren can xemsa niɣ setta kilumit, ẓrin Ƹisa iggur x iḍaren x waman n ȓebḥar iqarreb-d ɣar ṯɣarrabut, nxeȓƹen s ṯiggwḏi.<verse eid="JHN 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 6:20" />Inna-asen: "Aqa ḏ nec, war teggwḏem ca." <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />Uca qebȓen-ṯ s ȓxaḍar nsen aḏ yaȓi ḏi ṯɣarrabut. Ȓexddenni ṯaɣarrabut ṯuweḍ ɣar ȓbarr mani tuɣa ggin aḏ raḥen.<verse eid="JHN 6:21" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa netta ḏ aɣrum n ṯuḏarṯ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />Ṯiwecca nnes, ȓɣaci nni iqqimen ajemmaḍ i ȓebḥar feqḏen belli tuɣa ḏinni ijjen n ṯɣarrabut waha war t ufin ca. Niṯni ssnen Ƹisa war yuȓi ca ḏi ṯɣarrabut nni, imeḥḍaren nnes uyuren waḥeḏsen. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />Ssenni usint-id ṯɣarruba nneɣni zi ṯendint n Ṭabarya ɣar umcan nni mani ccin aɣrum nni mani icekkar Ƹisa Arebbi. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />Wami ȓɣaci nni war ẓrin ca Ƹisa ḏinni uȓa ḏ imeḥḍaren nnes, nyin uȓa ḏ niṯni ḏi ṯɣarruba uyuren ssenni ruḥen ɣar Kafernaḥum rezzun x Ƹisa.<verse eid="JHN 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />Wami ṯ ufin ɣar ujemmaḍ-in i ȓebḥar nnan-as: "A Lmuƹallim, meȓmi ḏa d tusiḏ ḏanita?"<verse eid="JHN 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26" />Indeq-d Ƹisa inna-asen: "Aqa tesȓam ȓḥaqq: Kenniw ṯrezzum xafi war iǧi bu wami ṯeẓrim lmuƹjizaṯ, kenniw ṯrezzum xafi wami ṯeccim ṯejjiwnem aɣrum. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />War xeddmeṯ ca i ȓmakla ixessaren, xeḏmeṯ i ȓmakla itɣiman i ṯuḏarṯ n ȓebda. Ḏ ṯa ḏ ȓmakla ḏawem ɣa yuc Mmis n bnaḏem minzi wanita iḍbeƹ-iṯ Arebbi Babas s ṭṭabaƹ nnes."<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />Nnan-as: "Min itxeṣṣa a negg ḥima a nzemmar a nexḏem ȓexḏayem n Arebbi?"<verse eid="JHN 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29" />Inna-asen Ƹisa: "Ḏ ṯa ḏ ȓxeḏmeṯ n Arebbi: Aḏ tamnem zi wenni iy d issekk netta."<verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />Nnan-as: "Man lƹalama ṯameqqrant iy ɣa ṯeggeḏ at nẓer ḥima azzayek namen? Min ɣa ṯeggeḏ? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />Ḏi ȓexȓa ȓejḏuḏ nneɣ ccin aɣrum nni umi qqaren lmanna mammec d yusa ḏi Lkitab: &lt;Yuca-asen-d aɣrum zeg ujenna ḥima aṯ ccen.&gt;"<verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />Inna-asen Ƹisa: "Aqa tesȓam ȓḥaqq: War iǧi bu ḏ Musa iy ḏawem yucin aɣrum zeg ujenna; Lla, ḏ Baba iy ḏawem iticcen aɣrum n ṣṣaḥ zeg ujenna. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />Minzi aɣrum n Arebbi netta ḏ wenni iy d ihewwan zeg ujenna iticc-as ṯuḏarṯ i ddunect."<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />Nnan-as: "Iwa a Siḏi, uc-aneɣ aɣrum-a i ȓebda."<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />Inna-asen Ƹisa: "Nec ḏ aɣrum n ṯuḏarṯ. Wenni iy ɣari d ɣa yasen war itȓizi ƹemmarṣ. Wenni zzayi ɣa yamnen war itfiḏi ƹemmarṣ. <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />Walakin nniɣ-awem: Waxxa ṯeẓrim-ayi kenniw, war timnem ca. <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />Marra min ḏayi d iticc Baba itas-d ɣari. Wenni iy d itasen ɣari war ṯ siggwijeɣ ca. <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />Minzi nec hwiɣ-d zeg ujenna, war iǧi ca aḏ ggeɣ min xseɣ; Lla, hwiɣ-d aḏ ggeɣ min ixes wenni iy ḏayi d issekken. <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />Min ixes wenni iy ḏayi d issekken? Ixes belli zi marra min ḏayi yuca war ḏayi itweddar uȓa ḏ ijjen, aṯen d sekkareɣ ḏi Nhar Aneggaru. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />Min ixes Baba? Ixes belli kuȓ wenni iẓrin Mmis yumen zzayes, aɣares ṯiȓi ṯuḏarṯ n ȓebda nec aṯiḏ sekkareɣ ḏi Nhar Aneggaru."<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />Bḏan israʼiliyen nni tceṯcan zzayes wami ḏasen inna qa nec ḏ aɣrum iy d ihwan zeg ujenna. <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />Nnan: "Wanita, ma war iǧi ca ḏ Ƹisa ḏ mmis n Yusef niɣ? Neccin nessen babas ḏ yemmas, mammec ɣa yini qa nec hwiɣ-d zeg ujenna?"<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />Inna-asen Ƹisa: "War tceṯcam ca jarawem. <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />War izemmar uȓa ḏ ijjen aḏ d yas ɣari illa meȓa s lʼiḏen n Baba iy ḏayi d issekken, nec aṯiḏ sekkareɣ ḏi Nhar Aneggaru. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />Ammu iy yura ijjen zi lʼanbiya: &lt;Marra aḏ ȓemḏen zi Arebbi.&gt; Marra uw iy s isȓin i Baba aḏ iȓmeḏ zzayes ataf aɣari d yas. <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />War iǧi uȓa ḏ ijjen iẓra Baba illa wenni iy d yusin zi Arebbi, ḏ netta ig iẓrin Baba. <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />Aqa tesȓam ȓḥaqq: Wenni iy ɣa yamnen aɣares ṯiȓi ṯuḏarṯ n ȓebda. <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />Nec ḏ aɣrum n ṯuḏarṯ. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />Ȓejḏuḏ nwem ccin aɣrum n ujenna ḏi ȓexȓa, waxxa amenni mmuṯen. <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />Min iƹna uɣrum iy d ihwan zeg ujenna bac wenni iy ṯ ɣa iccen war itmetti ca? <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />Aqa ḏ nec ḏ aɣrum iddaren iy d ihwan zeg ujenna. Marra wenni ɣa iccen zeg uɣrum-a aḏ iddar i ȓebda. Aɣrum-a iy ticceɣ nec ḏ ddat inu ḥima aḏ teddar ddunect-a."<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />Israʼiliyen nni menɣen jarasen nnan: "Mammec ɣa igg wanita aḏaneɣ yuc ddat nnes at necc?"<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />Inna-asen Ƹisa: "Aqa tesȓam ȓḥaqq: Meȓa war ṯeccim ca ddat n Mmis n bnaḏem war ṯsessem ca iḏammen nnes, aḏ tiȓi war ɣarwem bu ṯuḏarṯ ḏeg yixef nwem." <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" /><char style="it">Inna-asen:</char> "Wenni ɣa iccen ddat inu aḏ isew iḏammen inu, aɣares ṯiȓi ṯuḏarṯ i ȓebda nec aṯiḏ sekkareɣ ḏi Nhar Aneggaru. <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />Minzi ddat inu ḏ ȓmakla n ṣṣaḥ, iḏammen inu ḏ ṯisessi n ṣṣaḥ. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />Marra wenni ɣa iccen ddat inu aḏ isew iḏammen inu, ataf aḏ iqqim ḏayi, nec ḏayes. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />Mammec iy ḏayi d issekk Baba iddaren u nec ddareɣ zi Baba, amenni wenni ḏayi ɣa iccen azzayi iy iddar. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />Ṣafi, ḏ wanita ḏ aɣrum iy d ihwan zeg ujenna. War iǧi ca am ȓejḏuḏ nwem iy ccin aɣrum nni umi qqaren lmanna menbaƹd mmuṯen; Lla, wenni ɣa iccen zeg uɣrum-a aḏ iddar i ȓebda."<verse eid="JHN 6:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59" />Manaya inna-ṯ Ƹisa ḏi ṯemziḏa wami tuɣa iseȓmaḏ ḏeg ubilaj n Kafernaḥum.<verse eid="JHN 6:59" /></para>
  <para style="s">Awaȓen n ṯuḏarṯ n ȓebda aqaṯen ɣar Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />Aṭṭas zeg imeḥḍaren nnes wami sȓin manayenni nnan qa awaȓ-a iqseḥ war iǧi wi ṯ ɣa iqebȓen.<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />Iƹȓem Ƹisa s wuȓ nnes qa imeḥḍaren nnes tceṯcan inna-asen: "Ma s manaya iy zi ḏawem iteqqes ȓḥaȓ? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />Y meȓa ṯeẓrim Mmis n bnaḏem itwarfeƹ ɣar mani iqqim ḏ amezwaru? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />Arruḥ n Arebbi ḏ netta iseddaren. Min iǧan ḏ bnaḏem war ineffeƹ i walu. Awaȓen iy ḏawem nniɣ, ḏaysen arruḥ ḏ ṯuḏarṯ. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />Walakin ḏaywem yinni war itimnen ca." Minzi Ƹisa issen zeg umezwaru yinni ḏaysen war itimnen ca ḏ wenni iy ṯ ɣa izzenzen. <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />Inna-asen: "S manaya nniɣ-awem: War izemmar uȓa ḏ ijjen aḏ d yas ɣari illa meȓa s lʼiden n Baba." <verse eid="JHN 6:65" /><verse number="66" style="v" sid="JHN 6:66" />Zi ȓweqṯ nni semḥen ḏayes aṭṭas n imeḥḍaren nnes, war kis qqimen ca gguren akiḏes.<verse eid="JHN 6:66" /></para>
  <para style="b" />
  <para style="p">
    <verse number="67" style="v" sid="JHN 6:67" />Indeq-d Ƹisa inna-asen i ṯenƹac n arrusul iy kis iǧan: "Uȓa ḏ kenniw, ma ṯexsem aḏayi ṯsemḥem?"<verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />Inna-as Simƹan Buṭrus: "A Siḏi, min iƹna wenni mani ɣa nraḥ? Cek ɣarek awaȓen n ṯuḏarṯ n ȓebda. <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />Qa neccin numen, nessen qa cek ḏ Lƹaḍim n Arebbi."<verse eid="JHN 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70" />Inna-asen Ƹisa: "Nec iy kenniw ixḍaren s ṯenƹac iḏwem, walakin ijjen zzaywem ḏ Ibȓis."<verse eid="JHN 6:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="JHN 6:71" />Manaya iqqar-iṯ x Yahuḏa mmis n Simƹan Isxaryuṭi liʼanna ḏ wanita iy ṯ ɣa izzenzen u netta ḏ ijjen zi ṯenƹac n arrusul.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">Siḏiṯneɣ Ƹisa itgaƹƹaḏ s ṯnufra ɣar ṯendint n Lquds</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />Menbaƹd i manaya Ƹisa iggur zeg umcan ɣar umcan ḏi ṯmurṯ n Ljalil. Itbeƹƹaḏ zi ṯmurṯ n Yahuḏiya minzi israʼiliyen nni rezzun xas aṯ nɣen. <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />Iqarreb-d ijjen n ȓƹiḏ n Ayṯ-Israʼil umi qqaren &lt;Ṯinwaȓin.&gt; <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />Nnan-as ayṯmas <char style="it">zeg yemmas</char>:<note caller="+" style="f"><char style="fr" closed="false">7.3 </char><char style="ft" closed="false">S ṯyunaniṯ ṯeqqar "ayṯmas." Ȓmaƹna nnes ixes aḏ yini ayṯmas zeg yemmas waha.</char></note> "Uyur ssanita, ruḥ ɣar ṯmurṯ n Yahuḏiya ḥima uȓa ḏ imeḥḍaren nnec aḏ ẓren man ȓexḏayem iy ṯxeddmeḏ. <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />War iǧi ḥadd ixeddem can ṯmesȓayṯ s ṯnufra meȓa irezzu aṯ ssnen. Meȓa teggeḏ ṯimesȓayin-a, smeḍhar-d ixef nnec i ddunect." <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />Ayṯmas s yixef nsen war uminen ca zi Ƹisa.<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />Inna-asen Ƹisa: "Ȓweqṯ inu ƹaḏ war d tuwiḍ ca ḥima aḏ raḥeɣ, walakin kenniw aḏ traḥem ḏi ayyi ȓweqṯ. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />Ddunect war ṯzemmar ca akenniw ṯƹiff, nec tƹiffa-ayi ddunect minzi cehhḏeɣ qa ȓexḏayem n ddunect-a ḏ ṯiƹeffanin. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />Gaƹƹḏeṯ kenniw ɣar ȓƹiḏ, nec war tgaƹƹiḏeɣ ca ɣar ȓƹiḏ-a minzi ȓweqṯ inu ƹaḏ war d tuwiḍ." <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />Wami ḏasen inna awaȓ-a iqqim ḏi ṯmurṯ n Ljalil.<verse eid="JHN 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />Walakin wami gaƹƹḏen ayṯmas ɣar ȓƹiḏ, menbaƹd igaƹƹeḏ uȓa ḏ netta. Igga axmi innuffar, war d ismeḍhar ca ixef nnes.<verse eid="JHN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 7:11" />Rezzun xas israʼiliyen ḏi ȓƹiḏ nnan manis ikka uryaz nni? <verse eid="JHN 7:11" /><verse number="12" style="v" sid="JHN 7:12" />Aṭṭas ig itwecwicen zi ȓɣaci xas qqaren netta ḏ aryaz n ȓxir. Walakin inneɣni zzaysen qqaren lla, isxarriq xaneɣ waha. <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />Walakin uȓa ḏ ijjen war xas issiweȓ s jjheḏ s ṯiggwḏi zeg <char style="it">imeqqranen nni n</char> Ayṯ-Israʼil.<verse eid="JHN 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />Wami iƹḏu uzyen zi ȓƹiḏ, igaƹƹeḏ Ƹisa ɣar ṯemziḏa ṯameqqrant n Ayṯ-Israʼil iseȓmaḏ ḏinni. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />Israʼiliyen ḏehcen nnan: "Mammec igga netta issen min ḏaysen ḏi Lkutub u netta war iɣri ca?"<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />Inna-asen Ƹisa: "Min seȓmaḏeɣ war iǧi bu inu, aseȓmeḏ-a n wenni iy ḏayi d issekken. <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />Wenni ixsen aḏ igg zi min ixes Arebbi ataf aḏ issen aseȓmeḏ-a inu ma zzayi niɣ zi Arebbi. <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />Wenni issawaȓen zi ɣares irezzu lƹaḍama i yixef nnes. Wenni irezzun lƹaḍama n wenni iy ṯiḏ issekken, qa netta ḏayes lḥaqiqa war ḏayes bu ȓɣecc. <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />Ḏ Musa iy ḏawem yucin ccariƹa, niɣ? Walakin uȓa ḏ ijjen zzaywem ma itegg zi ccariƹa nni. Iwa, mayemmi ṯexsem aḏayi ṯenɣem?"<verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />Nnan-as ȓɣaci: "Ma ḏayek jnun cek niɣ? Uw irezzun ac ineɣ?"<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />Inna-asen Ƹisa: Ggiɣ lmuƹjiza, ṯḏehcem kenniw marra. <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />Cuf, ijja-awem-d Musa ṭṭahareṯ u ṭṭahareṯ-a war ṯeǧi bu zi Musa lla, zi ssalaf ṣṣaliḥin. X manaya kenniw waxxa ḏi nhar n ssebṯ n lƹibada tṭehharem i iḥarmucen. <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />Meȓa ṯsemmḥem iḥarmucen aḏ ṭehharen ḏi nhar n lƹibada ḥima war txilifem ca Ccariƹa n Musa, ma tƹaṣṣabem xafi wami sgenfiɣ ijjen n bnaḏem qaƹ ḏi nhar n lƹibada? <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />Iwa, war tḥasabeṯ ca xafi ammu waha, ḥasbeṯ s ȓḥaqq."<verse eid="JHN 7:24" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa itcerraḥ manis netta ḏ mani ɣa iraḥ</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />Ȓebƹaḍ zi ṯendint n Lquds nnan, ḏ wanita imken iy irezzun aṯ nɣen niɣ lla? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />Iwa xzareṯ, issawaȓ bȓa ma aḏ isnuffar ixef nnes war ḏas qqaren walu. Imken ssnen arruyas belli ḏ wanita iǧan ḏ Lmasiḥ? <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />Walakin xmi d ɣa yas Lmasiḥ uȓa ḏ ijjen war itessen manis netta. Wanita lla, neccin nessen manis netta.<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />Ikkar Ƹisa itxaṭab s jjheḏ ḏi ṯemziḏa ṯameqqrant n Ayṯ-Israʼil iseȓmaḏ-iṯen iqqar-asen: "Ma ḏ ṣṣaḥ ṯessnem-ayi manis nec, niɣ min ƹniɣ? War d usiɣ ca s yixef inu lla. Wenni ḏayi d issekken ɣares lḥaqiqa! Kenniw war ṯ ṯessinem ca. <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />Nec ssneɣ-ṯ minzi nec zzayes u ḏ netta iy ḏayi d issekken." <verse eid="JHN 7:29" /><verse number="30" style="v" sid="JHN 7:30" />Ȓexddenni rezzun aṯ ṭṭfen, walakin war xas isers fus ḥadd zzaysen minzi ȓweqṯ nnes ƹaḏ war d tuwiḍ.<verse eid="JHN 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 7:31" />Innama, aṭṭas zi ȓɣaci nni umnen zzayes. Nnan: "Ma aḏ d yas ƹaḏ ca n Lmasiḥ aḏ igg lmuƹjizaṯ ktar zi ṯina itegg wanita?"<verse eid="JHN 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />Arrin-d ȓexbar ifarrisiyen belli ȓɣaci twecwicen xas x ṯmesȓayin nni. Uca kkaren arruyas n ȓfuqaha ḏ ifarrisiyen ssekken iƹessasen bac aṯ ṭṭfen.<verse eid="JHN 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 7:33" />Inna Ƹisa: "Nec akiḏwem qqimeɣ ḏrust n ȓweqṯ, ssenni aḏ ƹeqbeɣ ɣar wenni ḏayi d issekken. <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />Axafi ṯerzum war ḏayi tifem ca. War ṯzemmarem aḏ d tasem mani ɣa iȓiɣ nec."<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />Mseqsan israʼiliyen jarasen nnan: "Mani ɣa iraḥ wanita war ṯ ntif ca? Ma aḏ iraḥ ɣar israʼiliyen iy itemzeǧaƹen ḏi ṯmura n iyunaniyen bac aḏ iseȓmeḏ iyunaniyen? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />Min ixes aḏ yini wawaȓ-a ig inna? Iƹni &lt;Axafi ṯerzum war ḏayi tifem ca. War ṯzemmarem aḏ d tasem mani ɣa iȓiɣ nec.&gt;"<verse eid="JHN 7:36" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa netta ḏ Lmasiḥ</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />Ḏi nhar aneggaru ameqqran zi ȓƹiḏ nni, ikkar ibedd Ƹisa itxaṭab s jjheḏ inna: "Meȓa iffuḏ ḥadd, itxeṣṣa netta aḏ d yas ɣari aḏ isew. <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />Mammec inna Lkitab x wenni zzayi ɣa yamnen: Azzayes azzȓen iɣezran n waman iseddaren." <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />Manaya inna-ṯ x Arruḥ iqeddsen iy ɣa iqebȓen yinni zzayes yumnen. Arruḥ iqeddsen ƹaḏ war ṯiḏ yuci ca minzi Ƹisa ƹaḏ war itwarfeƹ ca.<verse eid="JHN 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />Sȓin ȓebƹaḍ n ȓɣaci i wawaȓen n Ƹisa nnan: "Ḏ wanita ḏ ṣṣaḥ ḏ nnabi <char style="it">iy qqaren aḏ d yas</char>."<verse eid="JHN 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41" />Inneɣni nnan: "Netta ḏ Lmasiḥ."</para>
  <para style="p" vid="JHN 7:41">Walakin ȓebƹaḍ zzaysen nnan: "Ma aḏ d yas Lmasiḥ zi ṯmurṯ n Ljalil? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />Inna Lkitab aqa Lmasiḥ aḏ d yas zi ddurriṯ n Dawed, iƹni zi Bayt Laḥem zi dcar manis d yusa Dawed."<verse eid="JHN 7:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 7:43" />X manaya iwqeƹ lxilaf jar ȓɣaci nni ḏi ssabab nnes. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />Ȓebƹaḍ rezzun aṯ ṭṭfen, walakin war xas isers fus ḥadd zzaysen.<verse eid="JHN 7:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />Ƹeqben-d iƹessasen ɣar ifarrisiyen ḏ arruyas n ȓfuqaha. Ssiwȓen ak iƹessasen nni nnan-asen: "Mayemmi war ṯiḏ tuwim?"<verse eid="JHN 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />Nnan-asen iƹessasen: "Ƹemmarṣ war issiweȓ can n bnaḏem ammec issawaȓ uryaz-a!"<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />Nnan-asen ifarrisiyen i iƹessasen: "Ma twaxeḏƹem uȓa ḏ kenniw zzayes? <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />Ma ṯufim can yijjen zi arruyas niɣ ḏ ifarrisiyen yumen zzayes? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />Yak ȓɣaci nni war ssinen ca Ccariƹa n Musa, yinni aqaṯen menƹuȓin iy ǧan."<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />Ikkar ijjen zi arruyas-a, netta tuɣaṯ qbeȓ iruḥ ɣar Ƹisa qqaren-as Nikudim, inna-asen: <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />"Ma ccariƹa nneɣ ṯḥekkem x yij n bnaḏem qbeȓ ma ṯ nẓer niɣ a nessen min itegg?"<verse eid="JHN 7:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52" />Nnan-as: "Ma cek ƹaweḏ zi ṣḥab n Ljalil? Rzu ḏi Lkutub xzar, uȓa ḏ ijjen n nnabi war d yusi ca zi ṯmurṯ n Ljalil."<verse eid="JHN 7:52" /></para>
  <para style="s">{Siḏiṯneɣ Ƹisa ismeḥ i yijjen n ṯemɣarṯ ṯeffeɣ abriḏ}</para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 7:53" />Ssenni iruḥ kuȓ ijjen ɣar ṯeddarṯ nnes.<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="nb">
    <verse number="1" style="v" sid="JHN 8:1" />Walakin Ƹisa yuȓi ɣar Uḏrar n Zzitun. <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />Ak ṣbaḥ zic iḏweȓ-d ƹaweḏ ɣar ṯemziḏa ṯameqqrant n Ayṯ-Israʼil. Usin-d ɣares ȓɣaci marra, iqqim iseȓmaḏ-iṯen. <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />Menbaƹd imseȓmaḏen n ccariƹa uȓa ḏ ifarrisiyen uwin-as-d ijjen n ṯemɣarṯ ufin-t ṯxeddeƹ aryaz nnes, sbedden-teṯ zzaṯsen. <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />Nnan-as i Ƹisa: "A Lmuƹallim, ṯamɣarṯ-a ufin-t ṯxeddeƹ aryaz nnes. <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />Iweṣṣa-aneɣ Musa ḏi ccariƹa inna-aneɣ qa amecnaw ṯanita at nerjem s uzru. Y cek, min ɣa ṯiniḏ?" <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />Nnan-as niṯni manaya tjarraban-ṯ ḥima aṯ tahmen.</para>
  <para style="p" vid="JHN 8:6">Ikkar Ƹisa ihwa ɣar ṯmurṯ ibḏa itari ḏeg ucaȓ s ufus nnes. <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />Wami niṯni qqimen amenni tseqsan-ṯ, ibedd inna-asen: "Wenni iǧan zzaywem ƹemmarṣ war iƹṣi at yuweṯ s uzru netta ḏ amezwaru." <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />Ȓexddenni ihwa ƹaweḏ ɣar ṯmurṯ itari ḏeg ucaȓ. <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />Wami sȓin i wawaȓ-a bḏan ugguren ij-ij, iwessura ḏ imezwura. Iqqim Ƹisa waḥḏes netta ḏ ṯemɣarṯ nni ṯbedd zzaṯes. <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />Ibedd Ƹisa inna-as: "A ṯamɣarṯ, mani ǧan? Ma war xam iḥkim ḥadd?"<verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />Ṯenna-as nettaṯ: "Wah, a Siḏi."</para>
  <para style="p" vid="JHN 8:11">Inna-as Ƹisa: "Uȓa ḏ nec war xam ḥekkmeɣ ca. Ruḥ, zi ssa aȓ ṯsawent war taḏaf ca ḏi ȓmuƹṣiyeṯ."<verse eid="JHN 8:11" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa netta ḏ nnur n ddunect</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />Issiweȓ ɣarsen ƹaweḏ Ƹisa inna-asen: "Nec ḏ nnur n ddunect. Wenni ḏayi ɣa iḏfaren ƹemmarṣ aḏ yuyur ḏi ṯaǧest, aɣares yiȓi nnur n ṯuḏarṯ."<verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />Nnan-as ifarrisiyen: "Cek ṯcehhḏeḏ x yixef nnec, chaḏeṯ nnec war ṯeǧi ca ḏ ṣṣaḥ."<verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />Indeq-d Ƹisa inna-asen: "Lla, waxxa nec cehhḏeɣ x yixef inu, chaḏeṯ inu nican minzi nec ssneɣ manis iy d usiɣ ḏ mani ɣa raḥeɣ. Walakin kenniw war ṯessinem ca manis d usiɣ niɣ mani ɣa raḥeɣ. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />Kenniw tḥasabem ijjen s ȓaƹqeȓ waha, nec war tḥisibeɣ uȓa ḏ ijjen. <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />U nec meȓa ḥasbeɣ, lḥisab inu nican ȓaḥeqqac war tḥisibeɣ ca waḥḏi, netḥasab nec ḏ Baba iy ḏayi d issekken. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />Ṯura ḏi ccariƹa nwem s yixef nnes belli chaḏeṯ n ṯnayen n ȓechuḏ nican. <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />Nec cehhḏeɣ x yixef inu, u ƹaweḏ Baba iy ḏayi d issekken icehheḏ xafi."<verse eid="JHN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19" />Nnan-as: "Mani iǧa Babac?"</para>
  <para style="p" vid="JHN 8:19">Inna-asen Ƹisa: "Kenniw war ḏayi ṯessinem ca, war ṯessinem uȓa ḏ Baba. Maƹlik ḏayi ṯessnem aḏ tiȓi ṯessnem uȓa ḏ Baba." <verse eid="JHN 8:19" /><verse number="20" style="v" sid="JHN 8:20" />Inna awaȓ-a ḏi ṯemziḏa ṯameqqrant nsen mani jemmƹen ṣṣaḏaqa, iseȓmaḏ ḏinni. War ṯ iṭṭif uȓa ḏ ijjen minzi ȓweqṯ nnes ƹaḏ war d tuwiḍ.<verse eid="JHN 8:20" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa netta zeg ujenna</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />Inna-asen ƹaweḏ Ƹisa: "Nec aḏ uyureɣ kenniw axafi ṯerzum, ḏi ȓmuƹṣiyeṯ nwem aḏ temmṯem. Mani ɣa raḥeɣ nec, war ṯzemmarem ca aḏ d tasem ḏinni."<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />Nnan israʼiliyen nni: "Netta inna qa mani ɣa raḥeɣ nec, war ṯzemmarem ca aḏ d tasem ḏinni. Ma aḏ ineɣ ixef nnes niɣ?"<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />Inna-asen Ƹisa: "Kenniw zeg wadday iƹni zi ṯmurṯ, nec zeg ujenna. Kenniw zi ddunect-a, nec war ǧiɣ ca zi ddunect-a. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />Nniɣ-awem aḏ temmṯem ḏi ȓmuƹṣiyaṯ nwem. Aḏ temmṯem ḏi ȓmuƹṣiyaṯ nwem iƹni meȓa kenniw war ṯuminem ca belli ḏ nec ig iǧan."<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />Nnan-as: "Min ṯeƹniḏ?"</para>
  <para style="p" vid="JHN 8:25">Inna-asen Ƹisa: "Nec ḏ wenni mixef ḏawem ssawaȓeɣ zeg umezwaru. <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />Ɣari aṭṭas n wawaȓen zemmareɣ aḏawem ṯen iniɣ, zzaysen iy ɣa ḥekmeɣ xawem. Wenni ḏayi d issekken netta ḏayes lḥaqiqa. Min sȓiɣ zzayes qqareɣ-ṯ i ddunect." <verse eid="JHN 8:26" /><verse number="27" style="v" sid="JHN 8:27" />War fhimen ca belli netta issawaȓ-asen x Babas.<verse eid="JHN 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 8:28" />X manaya inna-asen Ƹisa: "Axmi ɣa ṯesbeddem Mmis n bnaḏem ḏeg ujenna, aḏ tessnem belli ḏ nec ig iǧan. War teggeɣ ca zi ɣari; Lla, nec ssawaȓeɣ x mammec ḏayi iseȓmaḏ Baba. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />Wenni ḏayi d issekken aqaṯ akiḏi war ḏayi ijji bu waḥḏi minzi nec xeddmeɣ ȓebda min ḏas iteƹjiben." <verse eid="JHN 8:29" /><verse number="30" style="v" sid="JHN 8:30" />Wami inna netta manaya, umnen zzayes aṭṭas n yiwḏan.<verse eid="JHN 8:30" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa imɣar x Siḏna Brahim</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />Inna-asen Ƹisa i israʼiliyen yinni zzayes yumnen: "Meȓa ṯeqqimem ḏeg wawaȓ inu, aḏ tiȓim ḏ ṣṣaḥ ḏ imeḥḍaren inu. <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />Aḏ tessnem lḥaqiqa, u lḥaqiqa aḏawem d teḍȓeq aḏ tiȓim ḥurr."<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />Nnan-as: "Neccin zi ddurriṯ n Brahim, ƹemmarṣ war neǧi ḏ isemɣan i ḥadd. Mayemmi ḏaneɣ ṯenniḏ aḏ twaḍeȓqem aḏ tiȓim ḥurr?"<verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />Inna-asen Ƹisa: "Aqa tesȓam ȓḥaqq: Marra wenni iteggen ȓmuƹṣiyeṯ netta ḏ ismeɣ, bab nnes ḏ ȓmuƹṣiyeṯ. <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />Ismeɣ war ɣares bu umcan ag lƹaʼila n ṯeddarṯ i ȓebda, walakin memmiṯsen wah ɣares amcan nnes i ȓebda. <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />Meȓa iḍȓeq-awem Mmis yuca-awem lḥurriya, aɣarwem ṯiȓi ḏ ṣṣaḥ lḥurriya. <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />Nec ssneɣ qa kenniw ḏ ddurriṯ n Brahim. Innama, kenniw ṯrezzum aḏayi ṯenɣem minzi awaȓ inu war ṯ ṯeqbiȓem ca. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />Nec ssawaȓeɣ s min ẓriɣ ɣar Baba. Ȓa ḏ kenniw teggem s min ṯesȓim zi babaṯwem."<verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />Arrin xas nnan-as: "Babaṯneɣ ḏ Brahim."</para>
  <para style="p" vid="JHN 8:39">Inna-asen Ƹisa: "Lla, maƹlik kenniw ḏ ddurriṯ n Brahim, iȓi qa ṯxeḏmem ȓexḏayem nnes. <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />Xzar, nec ḏ ijjen n bnaḏem ssiwȓeɣ akiḏwem s lḥaqiqa zi min sȓiɣ zi Arebbi. Ȓexxu kenniw ṯrezzum aḏayi ṯenɣem, mayemmi? Brahim ƹemmarṣ ma igga ammu. <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />Lla, kenniw ṯxeddmem ȓexḏayem n babaṯwem."</para>
  <para style="p" vid="JHN 8:41">Nnan-as: "Neccin war d nexȓiq ca zi lfasad. Ɣarneɣ ijjen n Babaṯneɣ netta ḏ Arebbi."<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />Inna-asen Ƹisa: "Lla, maƹlik Babaṯwem ḏ Arebbi, ataf tḥibbim-ayi minzi nec ffɣeɣ-d zi Arebbi usiɣ-d. War d usiɣ ca zeg yixef inu; Lla, ḏ Baba iy ḏayi d issekken. <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />Mayemmi war ṯefhimem ca i min ḏawem qqareɣ? Ȓaḥeqqac war ṯzemmarem ca aḏ tqebȓem awaȓ inu. <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />Babaṯwem ḏ Ibȓis, ṯrezzum aḏ teḏfarem min ixes netta. Zeg umezwaru netta ineqq iwḏan. War ɣares ca lƹalaqa ak lḥaqiqa minzi netta war ḏayes bu lḥaqiqa. Meȓmi ma isxerraq, ataf issawaȓ zi min ḏayes minzi netta ḏ bu-ixerriqen, ḏ babaṯsen n ixerriqen. <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />Nec qqareɣ ȓḥaqq s manayenni kenniw war ḏayi timnem ca. <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />Min iƹna wenni izemmaren zzaywem aḏayi iṭṭef ȓmuƹṣiyeṯ? Meȓa qqareɣ ȓḥaqq, mayemmi war ḏayi timnem ca? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />Wenni iǧan n Arebbi ataf netta itsȓa i wawaȓen n Arebbi. Kenniw war ṯesȓim ca minzi kenniw war ṯeǧim ca n Arebbi."<verse eid="JHN 8:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />Nnan-as israʼiliyen nni: "Ɣarneɣ ȓḥaqq niɣ lla meȓa nenna cek zi Samarya, ḏayek jnun?"<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />Inna-asen Ƹisa: "Nec war ḏayi bu jnun tweqqareɣ Baba, kenniw tḥeggarem-ayi. <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />Nec war rezzuɣ ca lƹaḍama i yixef inu. Ḏinni wenni ḏayi t irezzun u netta ḏ wenni iḥekkmen. <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />Aqa tesȓam ȓḥaqq: Wenni iteggen array i wawaȓ inu ataf war itwiȓi ȓmewṯ ƹemmarṣ."<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />Nnan-as israʼiliyen: "Ȓexxu nessen belli cek ḏayek jnun. <char style="it">Siḏna</char> Brahim ḏ lʼanbiya marra mmuṯen. Cek ṯeqqareḏ meȓa can yijjen aḏ igg array i wawaȓ inu ƹemmarṣ aḏ iqqas ȓmewṯ. <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />Ma cek ktar zi jeddiṯneɣ Brahim ḏ lʼanbiya nni immuṯen? Min ṯḥessbeḏ ixef nnec?"<verse eid="JHN 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54" />Inna-asen Ƹisa: "Nec meȓa semɣareɣ ixef inu, ataf lƹaḍama inu war ṯeǧi ḏ walu. Ḏ Baba iy ḏayi isemɣaren, ḏ wenni iy ṯeqqarem qa ḏ Arebbi nneɣ. <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />Kenniw war ṯ ṯessinem ca, nec ssneɣ-ṯ. Meȓa nniɣ uȓa ḏ nec war ṯ ssineɣ ca, aḏ iȓiɣ am kenniw ḏ bu-ixerriqen. Walakin nec ssneɣ-ṯ, teggeɣ array i wawaȓ nnes. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />Jeddiṯwem Brahim ifareḥ aṭṭas ƹlaḥsab xmi ɣa iẓer nhar inu, wami ṯ iẓra ifareḥ."<verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />Nnan-as israʼiliyen nni: "Ƹaḏ war ɣarek bu xemsin iseggwusa, mammec ṯeggiḏ ṯeẓriḏ Brahim nni?"<verse eid="JHN 8:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58" />Indeq-d Ƹisa inna-asen: "Aqa tesȓam ȓḥaqq: Qbeȓ ma aḏ yiȓi Brahim, nec ǧiɣ."<verse eid="JHN 8:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59" />Kkaren israʼiliyen nni ysin izra ḥima aṯ rejmen, walakin Ƹisa inesȓeṯ iffeɣ zi ṯemziḏa ṯameqqrant.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">Siḏiṯneɣ Ƹisa isgenfa ij uḍarɣaȓ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />Wami tuɣa Ƹisa iggur ḏeg ubriḏ yufa ijjen n uryaz ḏ aḍarɣaȓ ixȓeq-d amenni. <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />Nnan-as imeḥḍaren nnes: "A Lmuƹallim, ug iy iƹṣan? Ma ḏ wanita ma ḏ lwalidin nnes wami d ixȓeq ḏ aḍarɣaȓ?"<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />Inna-asen Ƹisa: "War iƹṣi wanita uȓa ḏ lwalidin nnes. Ixȓeq-d ḏ aḍarɣaȓ bac marra aḏ ẓren min izemmar Arebbi aḏayes ixḏem. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />Xmi itiȓi ḏ nhar, itxeṣṣa-yaneɣ a nexḏem ȓexḏayem n wenni iy ḏayi d issekken. Xmi d taweḍ ǧiȓeṯ, war izemmar uȓa ḏ ijjen aḏ ixḏem. <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />Madama ƹaḏ ǧiɣ ḏi ddunect, nec ḏ nnur n ddunect."<verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />Wami inna ammu, issusef ḏeg ucaȓ igga zzayes abeǧaƹ s ikuffan nni isers-iṯ x ṯiṭṭawin n uḍarɣaȓ. <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />Inna-as Ƹisa: "Ruḥ aḏ tessirḏeḏ ḏi ṣṣarij n Silwam." (Awaȓ-a Silwam ixes aḏ yini &lt;Wenni iy d itwassekken.&gt;) Iruḥ isireḏ, irewweḥ itwaȓa.<verse eid="JHN 9:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />Ssiwȓen jarasen jjiran ḏ yiwḏan iy ṯ issnen zi qbeȓ nnan, Maci ḏ wanita itɣiman itettar?<verse eid="JHN 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 9:9" />Ȓebƹaḍ zzaysen nnan: "Qa ḏ netta."</para>
  <para style="p" vid="JHN 9:9">Nnan inneɣni: "Lla, itawi-d ḏayes waha."</para>
  <para style="p" vid="JHN 9:9">Walakin netta inna: "Qa ḏ nec."<verse eid="JHN 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10" />Nnan-as: "Mammec genfant ṯiṭṭawin nnec?"<verse eid="JHN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11" />Inna-asen: "Bnaḏem nni umi qqaren Ƹisa iysi-d abeǧaƹ isers-ayi-ṯ x ṯiṭṭawin inu. Inna-ayi ruḥ ɣar Silwam aḏ tessirḏeḏ. Ruḥeɣ ssirḏeɣ, rewwḥeɣ twaȓiɣ."<verse eid="JHN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12" />Nnan-as: "Mani iǧa?"</para>
  <para style="p" vid="JHN 9:12">Inna-asen: "War ssineɣ."<verse eid="JHN 9:12" /></para>
  <para style="s">Aḍarɣaȓ nni icehheḏ x Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />Uwin aryaz nni iḏewȓen itwaȓa ɣar ifarrisiyen. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />Tuɣa nhar nni ḏ ssebṯ n lƹibada wami ḏas isers Ƹisa abeǧaƹ x ṯiṭṭawin nnes isgenfa-ṯ. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />Nnan-as uȓa ḏ ifarrisiyen, Min ḏac iweqƹen wami cek twaȓiḏ?</para>
  <para style="p" vid="JHN 9:15">Inna-asen: "Isers-ayi abeǧaƹ x ṯiṭṭawin inu, ssirḏeɣ ḏewȓeɣ twaȓiɣ."<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />Nnan ȓebƹaḍ n ifarrisiyen nni: "Bnaḏem nni war iǧi ca zi Arebbi minzi war iweqqar ca nhar n lƹibada."</para>
  <para style="p" vid="JHN 9:16">Walakin ȓebƹaḍ nneɣni nnan: "Lla, mammec bnaḏem ḏ lƹaṣi <char style="it">zaƹma</char> aḏ igg lmuƹjizaṯ-a?" X manaya iwqeƹ lxilaf jarasen.<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />Nnan-as ƹaweḏ i uḍarɣaȓ nni: "Mammec twaȓiḏ cek wenni iy c isgenfan ṯiṭṭawin nnec?"</para>
  <para style="p" vid="JHN 9:17">Inna-asen: "Netta ḏ nnabi."<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />Walakin ƹaḏ war uminen ca israʼiliyen nni belli netta tuɣaṯ ḏ aḍarɣaȓ iḏweȓ itwaȓa ḥetta wami d ȓaɣan i lwalidin nnes. <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />Nnan-asen: "Ma ḏ wanita ḏ mmiṯwem iy ṯeqqarem ixȓeq-d ḏ aḍarɣaȓ? Mammec igga ȓexxu netta itwaȓa?"<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />Nnan-asen lwalidin nnes: "Neccin nessen belli wanita ḏ mmiṯneɣ ixȓeq-d ḏ aḍarɣaȓ. <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />War nessin ca min ḏas iweqƹen ȓexxu iḏweȓ itwaȓa. War nessin ca wenni iy ṯ isgenfan zi ṯiṭṭawin nnes. Sseqsam-ṯ kenniw, netta qa imɣar aḏ issiweȓ nniṯ x yixef nnes." <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />Nnan lwalidin nnes amenni minzi ggwḏen zeg <char style="it">imeqqranen n</char> Ayṯ-Israʼil. Tuɣa <char style="it">imeqqranen</char> nni tafqen belli wenni ɣa icehḏen Ƹisa ḏ Lmasiḥ, aṯ ṭerden zi ṯemziḏa. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />X manaya nnan lwalidin nnes sseqsam-ṯ kenniw netta qa imɣar.<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />Ȓaɣan-d wis marrṯayen i uryaz nni tuɣa iǧan ḏ aḍarɣaȓ nnan-as: "Iwa ḥmeḏ Arebbi cek! Qa neccin nessen aryaz nni netta ḏ lƹaṣi."<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />Inna-asen: "Netta meȓa ḏ lƹaṣi <char style="it">zaƹma</char> nec war ssineɣ ca. Ssneɣ ijjen n ṯmesȓayṯ: tuɣayi ḏ aḍarɣaȓ ȓexxu twaȓiɣ."<verse eid="JHN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26" />Nnan-as: "Min ḏac igga? Mammec igga isgenfa-c zi ṯiṭṭawin nnec?"<verse eid="JHN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27" />Inna-asen: "Nniɣ-awem-t war ḏayi ṯṣennṭem ca. Mayemmi ṯexsem aḏ tesȓem ƹaweḏ? Ma ṯexsem uȓa ḏ kenniw aḏ tiȓim ḏ imeḥḍaren nnes?"<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />Zawaren-ṯ nnan-as: "Cek iy iǧan ḏ ameḥḍar nnes! Qa neccin ḏ imeḥḍaren n Musa. <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />Neccin nessen belli Arebbi issiweȓ ak Musa, walakin wenni war nessin ca manis iy d yusa."<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />Inna-asen uryaz nni: "Manaya ḏ ȓƹajeb! Isgenfa ṯiṭṭawin inu, kenniw war tessinem ca manis netta! <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />Neccin nessen Arebbi war itsȓi ca ɣar yinni iƹeṣṣan; Lla, itsȓa ɣar yinni iy ṯ itweqqaren ḏ yinni ixeddmen s min ixes. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />Ƹemmarṣ war nesȓi ḏi zman bnaḏem ixȓeq-d ḏ aḍarɣaȓ aḏ d yas can yijjen aḏas isgenfa ṯiṭṭawin. <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />Aryaz-a, maƹlik war iǧi ca zi Arebbi ataf war izemmar aḏ igg walu!"<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />Nnan-as: "Cek ḏ lƹaṣi zeg wami d ṯxeȓqeḏ, ma ṯrezzuḏ aḏaneɣ ṯesȓemḏeḏ neccin?" Ȓexddenni ṭerden-ṯ zi ṯemziḏa.<verse eid="JHN 9:34" /></para>
  <para style="b" />
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />Isȓa Ƹisa belli wenni ṭerden-ṯ zi ṯemziḏa. Wami ṯ yufa inna-as: "Ma tamneḏ zi Mmis n bnaḏem?"<verse eid="JHN 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36" />Inna-as: "Min iƹna wenni a Siḏi ḥima azzayes amneɣ?"<verse eid="JHN 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37" />Inna-as Ƹisa: "Aqa ṯeẓriḏ-ṯ, ḏ wenni iy kic issawaȓen."<verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />Inna-as: "Umneɣ zzayec a Siḏi." Ȓexddenni isejjeḏ-as.<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />Inna Ƹisa: "Usiɣ-d ɣar ddunect-a aḏ ḥasbeɣ ḥima yinni iǧan ḏ iḍarɣaȓen aḏ twaȓan, yinni itwaȓan aḏ ḍerɣȓen."<verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />Sȓin-as ȓebƹaḍ zeg ifarrisiyen iy iǧan ḏinni nnan-as: "Ma uȓa ḏ neccin ḏ iḍarɣaȓen niɣ?"<verse eid="JHN 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41" />Inna-asen Ƹisa: "Maƹlik ḏ iḍarɣaȓen iy ṯeǧam, ataf war ḏaywem bu ȓmuƹṣiyeṯ. Walakin kenniw ȓexxu ṯeqqarem neccin netwaȓa. X manayenni ƹaḏ ḏaywem ȓmuƹṣiyeṯ."<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">Siḏiṯneɣ Ƹisa itṣeddaq ṯuḏarṯ nnes x iḥuȓiyen nnes</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />"Aqa tesȓam ȓḥaqq: Wenni war itiḏfen ca zi ṯewwarṯ n ȓkuri n iḥuȓiyen itgaƹƹaḏ manis nneɣni, netta itwaḥsab ḏ aceffar ḏ axewwan. <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />Walakin wenni d ɣa yaḏfen zi ṯewwarṯ netta ig yarewwsen iḥuȓiyen nnes. <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />Aƹessas n ȓkuri aḏas irzem ṯawwarṯ i wenni iy yarewwsen, iḥuȓiyen nnes tesȓan i ṣṣut nnes. Itȓaɣa x iḥuȓiyen nnes s yisemawen nsen, aṯen isufeɣ. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />Aḏ isufeɣ marra iḥuȓiyen nnes iggur zzaṯsen, iḥuȓiyen nni ḏeffaren-ṯ minzi ssnen ṣṣut nnes. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />Walakin aṯarras n midden war ṯ ḏeffaren ƹemmarṣ, azzayes arewȓen minzi niṯni war ssinen ca ṣṣut n uṯarras n midden." <verse eid="JHN 10:5" /><verse number="6" style="v" sid="JHN 10:6" />Inna-asen Ƹisa ȓmiṯal-a, walakin niṯni war fhimen ca ṯimesȓayin mixef iy ḏasen issawaȓ.<verse eid="JHN 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />Inna-asen Ƹisa ƹaweḏ: "Aqa tesȓam ȓḥaqq: Nec ḏ ṯawwarṯ n ȓkuri. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />Marra yinni d yusin qbeȓ i nec niṯni twaḥasben ḏ iceffaren ḏ ixewwanen, iḥuȓiyen niṯni war ɣarsen sȓin ca. <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />Nec ḏ ṯawwarṯ, wenni zzayi ɣa yaḏfen aḏ injem. Aḏ yiȓi amecnaw ijjen n uḥuȓi itaḏef iteffeɣ itaf min ɣa icc. <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />Netta aceffar itas-d ɣir aḏ yacar aḏ ineɣ aḏ ihḏem. Nec usiɣ-d ḥima aɣarsen ṯiȓi ṯuḏarṯ nni n ṯuḏarṯ bȓa ȓeqyas.<verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />Nec ig yarewwsen ḏ ṣṣaḥ. Wenni ig yarewwsen ḏ ṣṣaḥ itṣeddaq ṯuḏarṯ nnes x iḥuȓiyen nnes. <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />Axeddam maci am wenni yarewwsen iḥuȓiyen nnes nniṯ. Axeddam, meȓa iẓra uccan yusa-d aḏ ismeḥ ḏeg iḥuȓiyen nni aḏ yarweȓ. Uccan aḏ ihjem x iḥuȓiyen aṯen iƹzeȓ x wayawya. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />Axeddam aḏ yarweȓ minzi netta ḏ axeddam waha, war ṯ thimmin ca iḥuȓiyen.<verse eid="JHN 10:13" /></para>
  <para style="p">
    <verse number="14-15" style="v" sid="JHN 10:14-15" />Nec ḏ wenni iy ṯen yarewwsen ḏ ṣṣaḥ. Ssneɣ iḥuȓiyen inu iḥuȓiyen inu ssnen-ayi, mammec ḏayi issen Baba nec ssneɣ-ṯ. Ṯuḏarṯ inu, tṣeddaqeɣ-t x iḥuȓiyen inu. <verse eid="JHN 10:14-15" /><verse number="16" style="v" sid="JHN 10:16" />Ɣari iḥuȓiyen nneɣni war ǧin ca ḏi ȓkuri-ya, itxeṣṣa-ayi aṯen d awiɣ. Aḏ sȓen i ṣṣut inu aḏ tiȓi ḏ ijjen n ṯḥimerṯ ḏ ijjen iy ṯen ɣa yarewsen. <verse eid="JHN 10:16" /><verse number="17" style="v" sid="JHN 10:17" />S manaya Baba itḥibba-ayi minzi nec tṣeddaqeɣ ṯuḏarṯ inu ḥima ƹaweḏ atid arreɣ. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />Uȓa ḏ ijjen war zzayi t itekkes ca; Lla, nec tṣeddaqeɣ ṯuḏarṯ inu s ȓxaḍar inu. Ɣari jjheḏ ḥima at ṣeddqeɣ. Ɣari jjheḏ ḥima atid arreɣ ƹaweḏ. Ammu iy ḏayi iweṣṣa Baba."<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />Iwqeƹ lxilaf ƹaweḏ jar israʼiliyen x wawaȓen-a. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />Nnan aṭṭas zzaysen: "Wanita ḏayes jnun. Netta ḏ abuhaȓi, mayemmi ɣares tesȓam?"<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />Nnan inneɣni: "Awaȓen-a war ṯen iqqar ca wenni iy ḏi ǧan jnun. Ma izemmar can yijjen zi jnun aḏ isgenfa ṯiṭṭawin n iḍarɣaȓen?"<verse eid="JHN 10:21" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa ḏ Babas niṯni ḏ ijjen</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />Yuweḍ-d Ȓƹiḏ lmilad n ṯemziḏa ṯameqqrant n Ayṯ-Israʼil ḏi Lquds. Manaya ḏi ȓmecta, <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />Ƹisa iggur ḏeg Useqqif n Suliman ḏi ṯemziḏa ṯameqqrant. <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />Munen xas israʼiliyen nnan-as: "Aȓ meȓmi c ɣa nraja? Meȓa cek ḏ Lmasiḥ, ini-yaneɣ-ṯ nican!"<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />Inna-asen Ƹisa: "Nniɣ-awem-ṯ, kenniw war timnem ca. Ȓexḏayem iy teggeɣ ƹlaḥsab isem n Baba cehhḏent xafi. <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />Walakin kenniw war timnem ca minzi war ṯeǧim ca ḏ iḥuȓiyen inu. <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />Iḥuȓiyen inu tesȓan ɣar ṣṣut inu, ssneɣ-ṯen niṯni ḏeffaren-ayi. <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />Ticceɣ-asen ṯuḏarṯ n ȓebda ƹemmarṣ war fennin ca, war ṯen ixeṭṭef uȓa ḏ ijjen zeg ufus inu. <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />Ḏ Baba iy ḏayi ṯen yucin u netta ḏ ameqqran zi kuȓci. War izemmar uȓa ḏ ijjen aṯen ixḍef zeg ufus n Baba. <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />Nec ḏ Baba ḏ ijjen."<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />Israʼiliyen nni ysin-d ƹaweḏ izra aṯ rejmen. <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />Inna-asen Ƹisa: "Sbeyyneɣ-awem-d aṭṭas n ȓexḏayem ṯiṣebḥanin zi Baba, mant ȓxeḏmeṯ iy ṯexsem aḏayi ṯrejmem xas?"<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />Nnan-as israʼiliyen: "War c nrejjem ca x ȓxeḏmeṯ iṣebḥan; Lla, ac nerjem wami ṯenniḏ lbuhtan x Arebbi. Qa cek ḏ bnaḏem, ṯarriḏ ixef nnec ḏ Arebbi."<verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />Inna-asen Ƹisa: "Ma ṯura niɣ lla ḏi ccariƹa nwem belli Arebbi inna: &lt;Nec nniɣ-awem kenniw ḏ arebbiṯen&gt;!? <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />Netta iy ḏasen iqqaren &lt;arebbiṯen&gt; i yinni umi d yusa wawaȓ n Arebbi, u Lkitab ȓebda iqqar ȓḥaqq. <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />Ma ṯeqqarem i wenni ixḍar Baba issekk-iṯ-iḏ ɣar ddunect cek ṯenniḏ lbuhtan x Arebbi minzi nniɣ nec ḏ Mmis n Arebbi? <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />Meȓa war xḏimeɣ ca ȓexḏayem n Baba, war zzayi tamneṯ ca. <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />Meȓa xeḏmeɣ-ṯent, amneṯ zi ȓexḏayem nni waxxa war zzayi ṯuminem. Ammu aḏ tessnem qa Baba aqaṯ ḏayi, nec aqayi ḏi Baba."<verse eid="JHN 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39" />Rezzun aṯ ṭṭfen walakin inufseȓ-asen jar ifassen nsen. <verse eid="JHN 10:39" /><verse number="40" style="v" sid="JHN 10:40" />Iḏweȓ ƹaweḏ ɣar ujemmaḍ-in n yiɣzar n Lʼurdun ɣar umcan mani tuɣa itṭehhar Yaḥya ḏeg umezwaru, iqqim ḏinni. <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />Usin-d ɣares aṭṭas nnan, Yaḥya war iggi uȓa ḏ ijjen n lmuƹjiza, walakin marra min inna x wanita ḏ ṣṣaḥ. <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />Umnen zzayes aṭṭas n yiwḏan ḏinni.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">Siḏiṯneɣ Ƹisa isekkar-d Liƹazar zi ȓmewṯ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />Ijjen n bnaḏem qqaren-as Liƹazar ihȓec, netta zeg ubilaj nni umi qqaren Bayt Ƹanya. Zeddɣent ḏinni suyṯmas, icten qqaren-as Maryam icten qqaren-as Marṯa. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />Maryam ḏ nettaṯ ig iḏehnen iḍaren n Ƹisa s waman n lwarḏ ṯemseḥ-as-ṯen s ucewwaf nnes. Umas n Maryam Liƹazar ihȓec. <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />Suyṯmas nni ssekkent-id ɣar Ƹisa nnant-as a Siḏi, qa wenni xak iƹizzen qa ihȓec.<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />Wami isȓa i manayenni Ƹisa inna ȓeḥȓac-a war d yusi ca ḥima aḏ immeṯ; Lla, yusa-d ḏ ssabab i lƹaḍama n Arebbi ḥima azzayes itwasemɣar Mmis n Arebbi. <verse eid="JHN 11:4" /><verse number="5" style="v" sid="JHN 11:5" />Tuɣa ƹizzen xas x Ƹisa Marṯa ḏ učmas ḏ umas Liƹazar. <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />Wami isȓa netta qa ihȓec, iqqim ḏinni yumayen mani iǧa.<verse eid="JHN 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 11:7" />Menbaƹd i manaya inna-asen i imeḥḍaren nnes: "Yallah a neḏweȓ ƹaweḏ ɣar ṯmurṯ n Yahuḏiya."<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />Nnan-as imeḥḍaren: "Mammec a Lmuƹallim? Israʼiliyen nni tuɣa rezzun ac rejmen, cek ṯexseḏ aḏ tƹeqbeḏ ḏinni?"<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />Inna-asen Ƹisa: "Ḏinni ṯenƹac n swayaƹ n ṯfawṯ ḏi nhar. Wenni igguren ḏi nhar war itneqriḍ ca minzi itwaȓa ṯfawṯ n ddunect-a. <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />Meȓa can yijjen iggur s ǧiȓeṯ itneqraḍ minzi ǧiȓeṯ war ḏayes bu ṯfawṯ." <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />Wami inna manaya, yarni inna-asen: "Ameddukeȓ nneɣ Liƹazar qa iṭṭeṣ, aḏ raḥeɣ aṯiḏ sfaqeɣ."<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />Nnan-as imeḥḍaren: "A Siḏi, meȓa netta iṭṭeṣ aḏ ikkar nniṯ."<verse eid="JHN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13" />Walakin Ƹisa issiweȓ x ȓmewṯ nnes, niṯni tɣir-asen issawaȓ x arraḥeṯ nni n yinni iṭṭṣen. <verse eid="JHN 11:13" /><verse number="14" style="v" sid="JHN 11:14" />Uca inna-asen nican: "Qa Liƹazar immuṯ. <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />Nec farḥeɣ wami war ḏinni ǧiɣ ḥima aḏ tamnem. Yallah aɣares nraḥ."<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />Tuma iƹni wenni umi qqaren Acniw<note caller="+" style="f"><char style="fr" closed="false">11.16 </char><char style="ft" closed="false">Acniw netta ḏ aḵniw.</char></note> inna-asen i imeḥḍaren iy iǧan ḏ imeddukaȓ nnes: "Akis nuyur uȓa ḏ neccin akiḏes nemmeṯ."<verse eid="JHN 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />Wami d yusa Ƹisa, yufa ṯeƹḏu arbeƹiyyam zeg wami itwanḍeȓ. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />Bayt Ƹanya ṯeggwej ṯȓaṯa kilumit x Lquds. <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />Aṭṭas n israʼiliyen usin-d ɣar Marṯa ḏ Maryam ḥima aṯent ƹezzan x umaṯsent. <verse eid="JHN 11:19" /><verse number="20" style="v" sid="JHN 11:20" />Wami ṯesȓa Marṯa qa Ƹisa iggur-d, ṯruḥ aṯ teȓqa walakin Maryam ṯeqqim ḏi ṯeddarṯ. <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />Ṯenna-as Marṯa i Ƹisa: "A Siḏi, maƹlik aqac ḏanita iȓi war immuṯ ca uma. <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />Nec ssneɣ belli ƹaḏ ȓexxu qa Arebbi aḏac yuc min ma ṯettareḏ-as."<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />Inna-as Ƹisa: "Aḏ d ikkar ƹaweḏ wumam."<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />Ṯenna-as Marṯa: "Ssneɣ aḏ d ikkar ḏi ȓweqṯ n Lqiyama ḏi Nhar Aneggaru."<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />Inna-as Ƹisa: "Nec ḏ lqiyama nec ḏ ṯuḏarṯ, wenni itamnen zzayi ataf aḏ iddar waxxa immuṯ. <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />Marra wenni iddaren u netta itamen zzayi ataf war itmetti i ȓebda. Ma ṯumneḏ zi manaya?"<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />Ṯenna-as: "Wah a Siḏi. Nec umneɣ qa cek ḏ Lmasiḥ, cek ḏ Mmis n Arebbi, cek ḏ wenni iy d itasen ɣar ddunect." <verse eid="JHN 11:27" /><verse number="28" style="v" sid="JHN 11:28" />Wami ṯenna manaya, ṯruḥ ṯȓaɣa-d i učmas s ȓḥess ṯenna-as: "Lmuƹallim yusa-d irezzu xam."<verse eid="JHN 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 11:29" />Wami ṯesȓa manaya, ṯekkar s ṯazȓa ṯraḥ ɣares. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />Ƹisa ƹaḏ war d yusi ca ɣar ubilaj, aqaṯ ḏeg umcan mani ṯ teȓqa Marṯa. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />Israʼiliyen nni aqaṯen ak Maryam ḏi ṯeddarṯ tƹezzan-t. Wami ẓrin Maryam ṯekkar s ṯazȓa ṯeffeɣ niṯni ḏfaren-t tɣir-asen aḏ traḥ ɣar unḍeȓ aḏ tru ḏinni. <verse eid="JHN 11:31" /><verse number="32" style="v" sid="JHN 11:32" />Wami d tusa Maryam mani iǧa Ƹisa, ṯeẓri-ṯ ṯewḍa-yas ɣar iḍaren nnes ṯenna-as: "A Siḏi, maƹlik aqac ḏanita iȓi war immuṯ ca uma."<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />Ƹisa wami t iẓra ṯetru ḥetta ḏ israʼiliyen nni iy kiḏes d yusin uȓa ḏ niṯni trun, netta uȓ nnes iɣȓeb-iṯ ixeyyeq ḏi nnefs nnes. <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />Inna-asen: "Mani ṯ tneḍȓem?"</para>
  <para style="p" vid="JHN 11:34">Nnan-as: "Araḥ-d a Siḏi aḏ teẓreḏ." <verse eid="JHN 11:34" /><verse number="35" style="v" sid="JHN 11:35" />Ƹisa itru. <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />Nnan israʼiliyen nni xzarem mecḥaȓ tuɣa xas iƹizz. <verse eid="JHN 11:36" /><verse number="37" style="v" sid="JHN 11:37" />Nnan ȓebƹaḍ zzaysen qa ḏ wanita iy isgenfan ṯiṭṭawin n uḍarɣaȓ, ma war izemmar ataf igga can ȓḥajeṯ bac war itmetti ca Liƹazar?<verse eid="JHN 11:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />Ƹisa iziǧez-as ƹaweḏ ḏeg wuȓ nnes, yusa-d ɣar yifri n unḍeȓ yufa xas azru. <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />Inna Ƹisa: "Sbeƹƹḏeṯ xas azru-ya."</para>
  <para style="p" vid="JHN 11:39">Ṯenna-as Marṯa učmas n wenni immuṯen: "A Siḏi, qa yurṣuḍ ȓaḥeqqac ṯeƹḏu xas arbeƹiyyam zeg wami immuṯ."<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />Inna-as Ƹisa: "Yac nniɣ-am, meȓa ṯumneḏ aḏ teẓreḏ lƹaḍama n Arebbi?" <verse eid="JHN 11:40" /><verse number="41" style="v" sid="JHN 11:41" />Uca niṯni sbeƹƹḏen azru nni. Iysi Ƹisa ṯiṭṭawin ɣar ujenna inna: "Tcekkareɣ-cek a Baba ṯestajbeḏ-ayi. <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />Nec ssneɣ qa cek ȓebda testajabeḏ-ayi, walakin nec qqareɣ manaya ƹlaḥsab x ȓɣaci-ya iy ḏayi d innḍen, ḥima aḏ amnen belli qa ḏ cek iy ḏayi d issekken." <verse eid="JHN 11:42" /><verse number="43" style="v" sid="JHN 11:43" />Wami inna manaya, iȓaɣa s jjheḏ inna: "A Liƹazar, ffeɣ-d ssenni!" <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />Iffeɣ-d wenni immuṯen, inneḍ-as ȓecfen x ifassen ḏ iḍaren x uɣembub nnes xas ȓqabb. Inna-asen Ƹisa: "Kksem xas ȓecfen nni, jjem-ṯ aḏ yuyur."<verse eid="JHN 11:44" /></para>
  <para style="s">Israʼiliyen tafqen aḏ nɣen Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />Aṭṭas n israʼiliyen iy d yusin ɣar Maryam ẓrin min igga Ƹisa umnen zzayes. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />Walakin inneɣni ruḥen ɣar ifarrisiyen nnan-asen min igga. <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />Munen arruyas n ȓfuqaha ḏ ifarrisiyen ak Jmaƹṯ n lḥukkam n Ayṯ-Israʼil nnan: "Min ɣa negg? Qa aryaz-a itegg aṭṭas n lmuƹjizaṯ. <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />Meȓa nejji-ṯ ammu, marra azzayes amnen. Aḏ d asen irumaniyen, aḏaneɣ xarben ṯamziḏa ṯameqqrant nneɣ ḏ lʼumma nneɣ."<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />Ijjen zzaysen qqaren-as Qiyafa, netta ḏ arrayes n ȓfuqaha ḏeg useggwas nni. Ikkar netta inna-asen: "Kenniw war ṯessinem walu, <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />war ṯefhimem ca. Ḥsen i kenniw aḏ immeṯ ijjen n uryaz x ccaƹb ḥima war ṯfenni ca lʼumma nneɣ marra."<verse eid="JHN 11:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 11:51" />Netta ḏeg useggwas nni tuɣaṯ ḏ arrayes n ȓfuqaha. War inni ca manayenni zeg yixef nnes; Lla, yusa-as-d manayenni zi Arebbi belli Ƹisa aḏ immeṯ x lʼumma n Ayṯ-Israʼil. <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />War iǧi bu x lʼumma n Ayṯ-Israʼil waha, uȓa ḏ ṯarwa n Arebbi itemzeǧaƹen ḏi ṯmura, aṯen ismun Arebbi ḏ ijjen. <verse eid="JHN 11:52" /><verse number="53" style="v" sid="JHN 11:53" />Zi nhar nni tafqen ḥima aṯ nɣen.<verse eid="JHN 11:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 11:54" />X manaya war iqqim ca Ƹisa itraḥ itas-d jar israʼiliyen. Iruḥ ɣar can ṯmurṯ ṯuḏes ȓexȓa, ɣar yij ubilaj qqaren-as Afrayim iqqim ḏinni ak imeḥḍaren nnes.<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />Iqarreb-d Ȓƹiḏ Ameqqran n Ayṯ-Israʼil. Usin-d aṭṭas n yiwḏan zi ȓedcur ɣar Lquds ḥima aḏ ṭehharen ixef nsen qbeȓ i Ȓƹiḏ. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />Tuɣa rezzun x Ƹisa, ssawaȓen wami bedden ḏi ṯemziḏa ṯameqqrant n Ayṯ-Israʼil qqaren jarasen, Min twaȓam? Ma war d itis ca ɣar Ȓƹiḏ? <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />Arruyas n ȓfuqaha ḏ ifarrisiyen weṣṣan wenni iy ɣa iẓren mani iǧa Ƹisa, asen t yini bac aḏ raḥen aṯ ṭṭfen.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">Maryam ṯḏehhen Siḏiṯneɣ Ƹisa s waman n lwarḏ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />Settiyyam qbeȓ i Ȓƹiḏ Ameqqran, yusa-d Ƹisa ɣar Bayt Ƹanya mani izeddeɣ Liƹazar wenni iy d isekkar Ƹisa zi ȓmewṯ. <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />Ggin-as amensi ḏinni, <char style="it">učmas</char> Marṯa tsexxar Liƹazar iqqim akiḏsen. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />Ṯeysi-d Maryam azyen n litru n waman n lwarḏ ṣfan zeg yinni iɣȓan s waṭṭas, ṯeḏhen-as i Ƹisa iḍaren nnes, ṯemseḥ-as iḍaren nnes s ucewwaf nnes. Ṯaddarṯ marra ṯeccur s arriḥeṯ n waman nni n lwarḏ. <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />Ijjen zeg imeḥḍaren nnes, wenni umi qqaren Yahuḏa Isxaryuṭi u ḏ netta iy ɣa izzenzen Ƹisa, inna-asen: <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />"Mayemmi war zzenzen ca aman nni n lwarḏ s ṯeȓṯmiyya n ṯpeyyasin n nnuqarṯ aḏ mmucent i imesƹan?" <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />Wami inna ammu maci ziǧzen-as imesƹan; Lla, netta ḏ aceffar mkellef x ucemmus n tmenyaṯ itacar zi min ḏin srusan.<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />Inna-as Ƹisa: "Ejj-it, nettaṯ ṯxemmeȓ aman-a i nhar n ṯenḍeȓṯ inu. <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />Imesƹan aqaṯen akiḏwem ȓebda, nec war kiḏwem tɣimiɣ ca i ȓebda."<verse eid="JHN 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />Usin-d aṭṭas n ȓɣaci n israʼiliyen wami d arrin ȓexbar belli netta aqaṯ ḏinni. War iǧi x Ƹisa waha, usin-d aḏ ẓren uȓa ḏ Liƹazar wenni iy d isekkar zi ȓmewṯ. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />X manayenni tafqen arruyas n ȓfuqaha aḏ nɣen uȓa ḏ Liƹazar. <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />Mayemmi? Ȓaḥeqqac netta ḏ ssabab minzi tbeƹƹaḏen xasen aṭṭas n israʼiliyen tamnen zi Ƹisa.<verse eid="JHN 12:11" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa itaḏaf x usnus ɣar Lquds</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />Ṯiwecca nnes qaƹ ȓɣaci nni iy d yusin ɣar Ȓƹiḏ sȓin belli Ƹisa iggur-d ɣar Lquds. <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />Ysin afriwen n ṯcejjura n tmar <char style="it">bac azzayes reḥben</char> ffɣen aṯ ȓqan s ȓefraḥeṯ. Tƹeyyaḍen qqaren lḥamdu i Arebbi! Ssaƹḏ n wanita iy d yusin ƹlaḥsab isem n Siḏi Arebbi, qa netta ḏ azeǧiḏ n Ayṯ-Israʼil!<verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />Yufa Ƹisa ijjen n usnus inya xas mammec iy yura ḏi Lkitab:<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />"War teggweḏ ca a yeǧis n Lquds.</para>
  <para style="q2" vid="JHN 12:15">Xzar, azeǧiḏ nnem aqa yusa-d ɣarem,</para>
  <para style="q2" vid="JHN 12:15">inya-d x usnus."<verse eid="JHN 12:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />Imeḥḍaren nnes war fhimen ca i ṯmesȓayin-a ḏeg umezwaru. Walakin wami itwarfeƹ Ƹisa ƹaḏ iy d fekkaren manaya yura xas <char style="it">ḏi Lkitab</char> belli iwqeƹ-as.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />Ȓɣaci nni kiḏes, ẓrin wami d iȓaɣa x Liƹazar zeg unḍeȓ isekkar-iṯ-iḏ zi ȓmewṯ, ȓɣaci-ya ƹaḏ qqimen cehhḏen x manayenni. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />S manaya ȓqan-ṯ-iḏ ȓɣaci nneɣni minzi ȓɣaci-ya sȓin belli tuɣa igga lmuƹjiza nni. <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />Nnan ifarrisiyen jarasen: "Aqa twaȓam war ṯuwwiḍem ɣar walu! Ddunect marra ṯḏeffar-iṯ."<verse eid="JHN 12:19" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa iseȓmaḏ x mammec iy ɣa itwarfeƹ</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />Yinni igaƹƹḏen aḏ ƹebḏen ḏi Ȓƹiḏ akiḏsen ȓebƹaḍ n iyunaniyen. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />Iyunaniyen-a usin-d ɣar Filippas, Filippas netta zeg ubilaj n Bayt Ṣayda ḏi Ljalil. Tettaren-as nnan-as, A siḏi nexs a nẓer Ƹisa. <verse eid="JHN 12:21" /><verse number="22" style="v" sid="JHN 12:22" />Iruḥ Filippas ɣar Andrus bac aḏas ṯ yini, uca ruḥen s ṯnayen iḏsen ɣar Ƹisa nnan-as-ṯ.<verse eid="JHN 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 12:23" />Indeq-d Ƹisa inna-asen: "Ṯusa-d ȓweqṯ aḏ itwarfeƹ Mmis n bnaḏem. <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />Aqa tesȓam ȓḥaqq: Ṯaḥebbuct n yirḏan meȓa war twaẓẓu ca ḏi ṯmurṯ iƹni meȓa war twanḍeȓ ca, ataf aḏ teqqim ḏ ṯaḥebbuct waha. Meȓa twanḍeȓ aḏ tuc aṭṭas n ȓḥabb. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />Wenni itexsen ṯuḏarṯ nnes, ataf at ixsar. Wenni itƹiffan ṯuḏarṯ nnes ḏi ddunect-a, ataf at yaf ḏi ṯuḏarṯ n ȓebda. <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />Wenni ixsen aḏayi ixḏem, itxeṣṣa aḏayi iḏfar. Mani ɣa iȓiɣ nec, aḏ yiȓi ƹaweḏ ḏ axeddam inu. Wenni ḏayi ɣa ixeḏmen, aṯ ikarrem Baba.<verse eid="JHN 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />Ȓexxu ȓaƹmar inu ixeyyeq. Ma aḏ iniɣ: A Baba senjem-ayi zi ȓweqṯ-a? Lla, x ssabab n ȓweqṯ-a minxef iy d usiɣ. <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />A Baba, semɣar isem nnec."</para>
  <para style="p" vid="JHN 12:28">Uca yusa-d ijjen n ṣṣut zeg ujenna inna, Semɣareɣ-ṯ, aṯ semɣareɣ ƹaweḏ. <verse eid="JHN 12:28" /><verse number="29" style="v" sid="JHN 12:29" />Ȓɣaci nni tuɣa ibedden tesȓan, nnan aqa wa ḏ ajjaj. Inneɣni nnan, aqa ṯessiweȓ ɣares ijjen n lmalaʼika.<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />Inna-asen Ƹisa: "Ṣṣut-a war iǧi bu i yixef inu lla, i kenniw. <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />Ȓexxu aḏ twaƹaqeb ddunect-a. Ȓexxu Lmufsid nni<note caller="+" style="f"><char style="fr" closed="false">12.31 </char><char style="ft" closed="false">Ḏi Lkitab n lʼaṣel Lḥakem qqaren-ṯ i Lmufsid, iƹni Ibȓis.</char></note> ameqqran n ddunect-a axas azzȓen. <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />Xmi ɣa twasbeddeɣ ḏeg ujenna i ṯmurṯ, aḏ seḏfareɣ ɣari marra iwḏan." <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />S wawaȓ-a irezzu asen d isbeyyen ȓmewṯ nni iy ɣa immeṯ.<verse eid="JHN 12:33" /></para>
  <para style="b" />
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />Nnan-as ȓɣaci nni: "Neccin nesȓa zi min iqqar Lkitab qa Lmasiḥ aḏ iqqim i ȓebda. Iwa, mammec ṯeqqareḏ cek qa Mmis n bnaḏem itxeṣṣa aḏ itwasbedd ḏeg ujenna? Min iƹna Mmis-a n bnaḏem qaƹ?"<verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />Inna-asen Ƹisa: "Ḏrust n ȓweqṯ iy kiḏwem itiȓi nnur. Uyurem madama ƹaḏ ɣarwem nnur-a ḥima war xawem d ṯḥarreṯ ṯaǧest. Wenni igguren ḏi ṯaǧest war issin mani iggur. <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />Xmi ƹaḏ ɣarwem nnur, amneṯ zi nnur-a ḥima kenniw aḏ tḏewȓem ḏ ṯarwa n nnur." Wami inna manaya Ƹisa yuyur innuffar zzaysen.<verse eid="JHN 12:36" /></para>
  <para style="s">Ayṯ-Israʼil tagin aḏ amnen</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37" />Ƹisa waxxa igga aṭṭas n lmuƹjizaṯ zzaṯsen, war zzayes uminen ca. <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />Manaya ḥima aḏ ikemmeȓ i min inna nnabi umi qqaren Icaƹya:</para>
  <para style="q1" vid="JHN 12:38">&lt;Ay Arebbi, wi yumnen s wawaȓ nneɣ?</para>
  <para style="q2" vid="JHN 12:38">I wumi d isbeyyen jjheḏ n ufus n Arebbi?&gt;<verse eid="JHN 12:38" /></para>
  <para style="b" />
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39" />S manaya war zemmaren ca aḏ amnen minzi Icaƹya inna ƹaweḏ:<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />&lt;Isḍerɣeȓ-iṯen zi ṯiṭṭawin nsen,</para>
  <para style="q1" vid="JHN 12:40">isseqseḥ-asen uȓawen nsen,</para>
  <para style="q1" vid="JHN 12:40">ḥima war twiȓin s ṯiṭṭawin nsen,</para>
  <para style="q1" vid="JHN 12:40">ḥima war fehhmen s wuȓawen nsen,</para>
  <para style="q1" vid="JHN 12:40">bac war ɣari d ḏewwiȓen nec aṯen sgenfiɣ.&gt;<verse eid="JHN 12:40" /></para>
  <para style="b" />
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41" />Nnabi Icaƹya inna manaya x Ƹisa wami iẓra lƹaḍama nnes issiweȓ xas netta.<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />Innama, iwḏan aṭṭas waxxa zi arruyas nni umnen zzayes. Walakin x ssabab n ifarrisiyen ugin yiwḏan-a at inin ḥima war ṯen ṭerden ca zi ṯemziḏa. <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />Aqa rezzun arḍa n yiwḏan ktar zi arḍa n Arebbi.<verse eid="JHN 12:43" /></para>
  <para style="s">Awaȓen n Siḏiṯneɣ Ƹisa ḏ yinni iy ɣa iḥasben iwḏan</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />Ƹisa itxaṭab s jjheḏ inna: "Wenni itamnen zzayi, maci itamen zzayi itamen zi wenni iy ḏayi d issekken. <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />Wenni iy ḏayi iẓrin, iẓra wenni iy ḏayi d issekken. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />Usiɣ-d ɣar ddunect-a ḏ nnur ḥima wenni iy zzayi yumnen war itɣimi ca ḏi ṯaǧest. <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />Wenni ɣa isȓen i wawaȓ inu war ḏas itṭiƹi ca ataf nec war ṯ tḥisibeɣ ca. Aqa nec war d usiɣ ca aḏ ḥasbeɣ ddunect; Lla, usiɣ-d ḥima aḏ senjmeɣ ddunect. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />Wenni iy ḏayi itƹeyyaben netta war iqebbeȓ ca awaȓ inu, ataf ɣares wi ṯ ɣa iḥasben. Awaȓ-a iy nniɣ ḏ wenni iy ṯ ɣa iḥasben ḏi Nhar Aneggaru. <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />Aqa war ssiwȓeɣ ca zi ɣari; Lla, nec ssawaȓeɣ nec qqareɣ zi ȓuṣiyeṯ iy ḏayi yuca Baba iƹni wenni iy ḏayi d issekken. <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />Ssneɣ ȓuṣiyeṯ nnes nettaṯ ḏ ṯuḏarṯ n ȓebda. Min ssawaȓeɣ nec, ssawaȓeɣ-ṯ ƹlaḥsab mammec iy ḏayi inna Baba."<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">Siḏiṯneɣ Ƹisa isiriḏ iḍaren n imeḥḍaren nnes</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />Qbeȓ i Ȓƹiḏ Ameqqran, netta Ƹisa issen qa ȓweqṯ nnes ṯuweḍ-d aḏ imutti zi ddunect-a ɣar Babas. Netta iḥibb yinni iǧan akiḏes ḏi ddunect, iḥibb-iṯen aȓ uneggaru. <verse eid="JHN 13:1" /><verse number="2" style="v" sid="JHN 13:2" />Qbeȓ amensi tuɣa Ibȓis iɣarr Yahuḏa mmis n Simƹan Isxaryuṭi ḥima aḏ izzenz Ƹisa. <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />Tuɣa Ƹisa issen qa Babas igga-as kuȓci ḏeg ifassen nnes, yusa-d zi Arebbi aḏ iḏweȓ ɣar Arebbi. <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />Ikkar x umensi ikkes čammir nnes, iysi ijjen n umendiȓ iṣṣar ixef nnes. <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />Ifarreɣ-d aman ḏi ṯbeqqiṯ<note caller="+" style="f"><char style="fr" closed="false">13.5 </char><char style="ft" closed="false">Ṯabeqqiṯ qqaren-t i ṯḥebbiṯ.</char></note> ibḏa isiriḏ iḍaren n imeḥḍaren nnes, imseḥ-asen s umendiȓ mizi iṣṣar ixef nnes.<verse eid="JHN 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 13:6" />Wami d yusa ɣar Simƹan Buṭrus inna-as i Ƹisa: "Ma cek a Siḏi aḏayi ṯsirḏeḏ iḍaren inu?"<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />Inna-as Ƹisa: "Cek ȓexxu war ṯefhimeḏ ca min xeddmeɣ, zi ssa aȓ ṯsawent ƹaḏ aḏ tfehmeḏ manaya."<verse eid="JHN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8" />Inna-as Buṭrus: "Iḍaren inu ƹemmarṣ aṯen ṯsirḏeḏ."</para>
  <para style="p" vid="JHN 13:8">Inna-as Ƹisa: "Meȓa war ḏac sirḏeɣ, war ṯzemmareḏ ca aḏ tiȓiḏ ḏ ameḥḍar inu."<verse eid="JHN 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9" />Inna-as Simƹan Buṭrus: "A Siḏi, war iǧi ca aḏayi ṯsiȓḏeḏ iḍaren inu waha, aḏayi tsiȓḏeḏ uȓa ḏ ifassen inu ḏ uzeǧif inu."<verse eid="JHN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10" />Inna-as Ƹisa: "Lla, wenni isiriḏen bȓa ma aḏ isireḏ ƹaweḏ. Aḏ isireḏ iḍaren nnes waha minzi netta qaƹ ḏ amenqawi. Kenniw marra ḏ imenqawiyen illa ijjen." <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />Netta issen wenni iy ṯ ɣa izzenzen. S manayenni inna kenniw war ṯeǧim ca marra ḏ imenqawiyen.<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />Wami ḏasen isireḏ iḍaren nsen, igga čammir nnes iqqim ƹaweḏ inna-asen: "Ma ṯfehmem min ḏawem ggiɣ? <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />Kenniw ṯeqqarem-ayi a Lmuƹallim niɣ a Siḏi, kenniw ɣarwem ȓḥaqq minzi nican qa ḏ nec. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />Meȓa nec ig iǧan ḏ Siḏiṯwem u ḏ Lmuƹallim nwem sirḏeɣ-awem iḍaren nwem, itxeṣṣa uȓa ḏ kenniw aḏ tsirḏem iḍaren i wayawya. <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />Ggiɣ-awem ammu ḥima aḏ teggem min ggiɣ nec. <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />Aqa tesȓam ȓḥaqq: Axeddam war iǧi ca ḏ ameqqran zeg uweqqaf nnes. Amsexxar war iǧi ca ḏ ameqqran zeg wenni iy ṯiḏ issekken. <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />Ȓexxu ṯessnem manaya, ssaƹḏ nwem meȓa ṯeggim min ḏawem nniɣ.<verse eid="JHN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />Nec war ssiwiȓeɣ ca xawem marra, nec ssneɣ ug ixḍareɣ. Ȓexxu labud aḏ ikemmeȓ min d yusin ḏi Lkitab: &lt;Wenni iccin zeg uɣrum inu, yuweṯ-ayi s unirez nnes.&gt; <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />Sxebbareɣ-kenniw s manaya qbeȓ ma aḏ iwqeƹ, xmi ɣa iwqeƹ ataf aḏ tamnem qa ḏ nec ig iǧan. <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />Aqa tesȓam ȓḥaqq: Wenni iqebbȓen wenni iy d ɣa ssekkeɣ, aqa iqbeȓ-ayi. Wenni ḏayi iqebbȓen, aqa iqebbeȓ uȓa ḏ wenni iy ḏayi d issekken."<verse eid="JHN 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />Wami inna Ƹisa manaya, ixeyyeq ḏi nnefs nnes inna-asen-t nican: "Aqa tesȓam ȓḥaqq: Ijjen zzaywem aḏayi izzenz."<verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />Imeḥḍaren nnes xzaren ḏeg wayawya war ssinen wenni mixef issawaȓ. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />Ḏinni ijjen n umeḥḍar nnes iƹizz xas x Ƹisa <char style="it">aṭṭas</char>, netta iqqim ak uɣezḏis nnes. <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />Iceyyar-as Simƹan Buṭrus inna-as: "Sseqsa-ṯ min iƹna wenni mixef issawaȓ."<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />Imeyyeȓ ɣar Ƹisa inna-as: "A Siḏi, min iƹna?"<verse eid="JHN 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26" />Inna-as Ƹisa: "Aḏ ssisneɣ areqquz-a n uɣrum, wenni umi ɣa ṯ uceɣ ḏ netta." Issisen areqquz nni n uɣrum, yuca-as-ṯ i Yahuḏa mmis n Simƹan Isxaryuṭi. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />Wami iṭṭef areqquz nni n uɣrum Yahuḏa ȓexddenni yuḏef-iṯ Cciṭan. Inna-as Ƹisa: "Ḏeɣya, egg min ɣa ṯeggeḏ."<verse eid="JHN 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 13:28" />War ifhim uȓa ḏ ijjen zeg yinni iy ḏin iḥḍaren x min ḏas inna. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />Tɣiȓ-asen i ȓebƹaḍ qa inna-as aḏ iseɣ min ḥḏajen ḏi Ȓƹiḏ niɣ aḏ iṣeddeq x imesƹan minzi Yahuḏa mkellef x ucemmus n tmenyaṯ. <verse eid="JHN 13:29" /><verse number="30" style="v" sid="JHN 13:30" />Wami iṭṭef areqquz nni n uɣrum ṣafi iffeɣ. Ȓexddenni ṯuweḍ-d ṯmeddiṯ.<verse eid="JHN 13:30" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa iseȓmaḏ ijjen n ȓuṣiyeṯ ḏ jḏiḏ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />Wami iffeɣ Yahuḏa inna Ƹisa: "Ȓexxu itwasemɣar Mmis n bnaḏem, itwasemɣar s Mmis uȓa ḏ Arebbi. <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />Meȓa Arebbi itwasemɣar s Mmis, ataf aṯ isemɣar ƹaweḏ Arebbi ḏeg yixef nnes, u ḏeɣya aṯ isemɣar. <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" />A ṯarwa inu, ṯeqqim ḏrust n ȓweqṯ bac aḏ iȓiɣ akiḏwem. Axafi ṯrezzum. Min nniɣ nec i israʼiliyen aḏawem t iniɣ ȓexxu i kenniw: Mani ɣa raḥeɣ nec, war ṯzemmarem ca aḏ d tasem ḏinni. <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" />Ȓexxu ticceɣ-awem ijjen n ȓuṣiyeṯ ḏ jḏiḏ: Ḥibbeṯ ayawya. U ḥibbeṯ ayawya mammec kenniw ḥibbeɣ nec. <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />Meȓa kenniw tḥibbim ayawya, ataf aḏ ssnen marra qa kenniw ḏ imeḥḍaren inu."<verse eid="JHN 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />Inna-as Simƹan Buṭrus: "Mani ɣa ṯraḥeḏ a Siḏi?"</para>
  <para style="p" vid="JHN 13:36">Inna-as Ƹisa: "Mani ɣa raḥeɣ nec, ȓexxu war ṯzemmareḏ ca aḏayi ṯeḏfareḏ ḏinni. Walakin ƹaḏ aḏayi d ṯeḏfareḏ."<verse eid="JHN 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37" />Inna-as Buṭrus: "A Siḏi, mayemmi war zemmareɣ ca ac ḏfareɣ ȓexxu? Nec axak ṣeddqeɣ ṯuḏarṯ inu!"<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />Indeq-d Ƹisa inna-as: "Ma ḏ ṣṣaḥ axafi ṯṣeddqeḏ ṯuḏarṯ nnec? Aqa tesȓiḏ ȓḥaqq: Aḏayi ṯenkareḏ ṯȓaṯa n ṯwaȓaṯin qbeȓ ma aḏ idden uyaziḍ."<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">Siḏiṯneɣ Ƹisa netta ḏ abriḏ ɣar Arebbi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />"Itxeṣṣa kenniw war txeyyiqen ca wuȓawen nwem. Amneṯ zi Arebbi, amneṯ ƹaweḏ zzayi. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />Ṯaddarṯ n Baba ḏayes aṭṭas n ixammen. Maƹlik war iǧi ca amenni, iȓi nniɣ-awem-t. Aḏ raḥeɣ nec aḏawem swejḏeɣ amcan. <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />Xmi ɣa raḥeɣ aḏawem swejḏeɣ amcan nni, aḏ d ḏewȓeɣ ƹaweḏ akenniw ysiɣ akiḏi ḥima aḏ tiȓim kenniw mani ɣa iȓiɣ nec. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />Mani ɣa raḥeɣ ṯessnem abriḏ."<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />Inna-as Tuma: "A Siḏi, war nessin ca mani ɣa ṯraḥeḏ, mammec ɣa nessen abriḏ?"<verse eid="JHN 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6" />Indeq-d Ƹisa inna-as: Nec ḏ abriḏ, nec ḏ lḥaqiqa, nec ḏ ṯuḏarṯ. War d itis uȓa ḏ ijjen ɣar Baba illa zzayi. <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />Meȓa ṯessnem-ayi, ataf aḏ tessnem uȓa ḏ Baba ƹaweḏ. Qa ȓexxu ṯessnem-ṯ ṯeẓrim-ṯ."<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />Inna-as Filippas: "A Siḏi, smeḍhar-aneɣ-d Babac u ṣafi ikfa-yaneɣ."<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />Inna-as Ƹisa: "Qaƹ ȓweqṯ-a iy kiwem kkiɣ ƹaḏ war ḏayi ṯessineḏ ca a Filippas? Wenni iy ḏayi iẓrin, iẓra Baba. Mayemmi ḏayi ṯettareḏ aḏawem d smeḍhareɣ Baba? <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />Ma war timneḏ ca belli nec aqayi ḏi Baba, Baba aqaṯ ḏayi? Awaȓen iy ḏawem qqareɣ war ṯen qqareɣ ca nec, ḏ Baba iy ḏayi iy ṯen iqqaren. Netta ixeddem ȓexḏayem nnes. <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />Amnem-ayi nec aqayi ḏi Baba, Baba aqaṯ ḏayi, niɣ amnem zi ȓexḏayem nni s yixef nsent. <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />Aqa tesȓam ȓḥaqq: Wenni zzayi yumnen, ataf aḏ igg ȓexḏayem iy xeddmeɣ niɣ ktar minzi nec ggureɣ ɣar Baba. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />Marra min ɣa ṯettarem ƹlaḥsab isem inu aṯ xeḏmeɣ ḥima aḏ itwasemɣar Baba s Mmis. <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />Min ḏayi ɣa ṯettarem ƹlaḥsab isem inu, aṯ xeḏmeɣ.<verse eid="JHN 14:14" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa iseȓmaḏ x Arruḥ iqeddsen</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />Meȓa tḥibbim-ayi kenniw, ggeṯ zi ȓuṣiyaṯ inu. <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />Nec aḏ ttareɣ i Baba ḥima aḏawem yuc Lmuƹawin nneɣni ḥima akiḏwem itiȓi i ȓebda. <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />Lmuƹawin netta ḏ Arruḥ n lḥaqiqa. War ṯzemmar ddunect aṯ teqbeȓ, minzi nettaṯ war ṯ twiȓi ca war ṯ ṯessin ca. Walakin kenniw ṯessnem-ṯ minzi iqqim akiḏwem u aḏ yiȓi ḏaywem. <verse eid="JHN 14:17" /><verse number="18" style="v" sid="JHN 14:18" />War kenniw tijjiɣ ca ḏ iyuwjiȓen, aɣarwem d ƹeqbeɣ. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />Cwit n ȓweqṯ ig iqqimen war ḏayi ṯẓerr ca ddunect-a, walakin kenniw aḏayi ṯeẓrem. Wami nec ddareɣ, uȓa ḏ kenniw aḏ teddarem. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />Ḏi nhar nni aḏ tessnem belli nec aqayi ḏi Baba, kenniw ḏayi, nec ḏaywem. <verse eid="JHN 14:20" /><verse number="21" style="v" sid="JHN 14:21" />Wenni ɣar ǧant ȓuṣiyaṯ inu ixeddem zzaysent, ataf itḥibba-ayi. Wenni ḏayi itḥibban, ataf aṯ iḥibb uȓa ḏ Baba. Aṯ ḥibbeɣ uȓa ḏ nec, aḏas d smeḍhareɣ ixef inu."<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />Inna-as Yahuḏa (maci Yahuḏa Isxaryuṭi): "A Siḏi, mayemmi ɣa d ṯseḍhareḏ ixef nnec i neccin, ddunect lla?"<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />Inna-as Ƹisa: "Wenni ḏayi itḥibban, ataf aḏ ixḏem zeg wawaȓ inu. Aṯ iḥibb Baba, a nraḥ ɣares nec ḏ Baba, ɣares iy ɣa nezḏeɣ. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />Wenni war ḏayi itḥibbin, ataf war ixeddem ca zeg wawaȓ inu. Awaȓen-a iy tesȓam war ǧin ca inu lla, n Baba iy ḏayi d issekken.<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />Ṯimesȓayin-a nniɣ-awem-ṯent u nec ƹaḏ aqayi akiḏwem. <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />Lmuƹawin nni netta ḏ Arruḥ iqeddsen, aṯiḏ issekk Baba ƹlaḥsab isem inu aḏawem iseȓmeḏ kuȓci akenniw isfekkar marra min ḏawem nniɣ.<verse eid="JHN 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />Tijjeɣ-awem ȓehna, ticceɣ-awem ȓehna inu. War ḏawem ṯ ticceɣ ca am ṯ ticc ddunect. Itxeṣṣa uȓawen nwem war txeyyiqen war teggwḏen ca. <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />Ṯesȓam qa nniɣ-awem: Nec aḏ uyureɣ, aḏ d ƹeqbeɣ ɣarwem. Meȓa ṯḥibbim-ayi, ataf kenniw aḏ tfarḥem belli aḏ raḥeɣ ɣar Baba minzi Baba ḏ ameqqran xafi. <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />Nec nniɣ-awem-t ȓexxu qbeȓ ma aḏ iwqeƹ, bac xmi ɣa iwqeƹ kenniw aḏ tamnem. <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />War kiḏwem ssiwiȓeɣ ca nec ƹaḏ aṭṭas minzi Lmufsid<note caller="+" style="f"><char style="fr" closed="false">14.30 </char><char style="ft" closed="false">Ḏi Lkitab n lʼaṣel Lḥakem qqaren-ṯ i Lmufsid, iƹni Ibȓis. </char></note> nni ameqqran n ddunect-a itas-d. War ɣares bu ṯzemmar xafi. <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />Lla, nec teggeɣ zi min ḏayi iweṣṣa Baba ḥima ddunect-a aḏ tessen qa nec tḥibbiɣ Baba. Kkareṯ ssanita, yallah a nraḥem."<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">Siḏiṯneɣ Ƹisa netta ḏ aẓwar n ȓefraḥeṯ nneɣ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />"Nec ḏ ṯzayarṯ uḍiȓ ḏ ṣṣaḥ. Baba ḏ bab n ṯzayarṯ uḍiȓ. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />Kuȓ akeccuḍ iy d iffɣen zzayi war itirew ca izekkunen n uḍiȓ aṯ iqess Baba. U kuȓ akeccuḍ ig itarwen izekkunen n uḍiȓ aṯ izbar ḥima aḏ d yarni izekkunen nneɣni. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />Kenniw ḏ imenqawiyen ḏeg useȓmeḏ iy ḏawem nniɣ. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />Qqimeṯ ḏayi, nec aḏ qqimeɣ ḏaywem. Amecnaw akeccuḍ nni war izemmar aḏ yarew izekkunen zeg yixef nnes illa meȓa iqqim ḏi ṯzayarṯ, uȓa ḏ kenniw war ṯzemmarem ca illa meȓa ṯeqqimem ḏayi.<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />Nec ḏ ṯzayarṯ uḍiȓ, kenniw ḏ ikeccuḍen. Wenni itɣiman ḏayi u nec tɣimiɣ ḏayes, ataf netta aḏ yarew izekkunen n uḍiȓ aṭṭas ȓaḥeqqac kenniw bȓa zzayi war ṯzemmarem aḏ teggem walu. <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />Meȓa can yijjen war iqqim ca ḏayi, ataf aḏ imenḍar ɣar barra amecnaw ikeccuḍen yuzɣen, aṯen smunen aṯen ggen ḏi ṯmessi aḏ cemḍen. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />Meȓa ṯeqqimem ḏayi ṯeggim zeg wawaȓ inu, ataf min ma ṯettarem aɣarwem yiȓi. <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />Aḏ tarwem izekkunen aṭṭas, aḏ tiȓim ḏ imeḥḍaren inu. S manaya itwasemɣar Baba.<verse eid="JHN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 15:9" />Nec tḥibbiɣ-kenniw amecnaw mamc ḏayi itḥibba Baba. Iȓiṯ ḏi ȓemḥibbeṯ inu. <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />Meȓa ṯxeddmem zi ȓuṣiyaṯ inu, ataf aḏ tiȓim ḏi ȓemḥibbeṯ inu amecnaw mamc ggiɣ nec zi ȓuṣiyaṯ n Baba aqayi ḏi ȓemḥibbeṯ nnes. <verse eid="JHN 15:10" /><verse number="11" style="v" sid="JHN 15:11" />Nniɣ-awem manaya ḥima aḏ tiȓi ḏaywem ȓefraḥeṯ inu, ḥima aḏ tiȓi ȓefraḥeṯ nwem ṯƹemmar. <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />Ȓuṣiyeṯ inu ḏ ṯanita: &lt;Ḥibbeṯ ayawya mammec kenniw tḥibbiɣ nec.&gt; <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />War ḏinni bu ȓemḥibbeṯ ktar zi ṯenni n bnaḏem aḏ iṣeddeq ṯuḏarṯ nnes ƹlaḥsab imeddukaȓ nnes. <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />Meȓa teggem ȓuṣiyaṯ inu, ataf kenniw ḏ imeddukaȓ inu. <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />War iqqim ƹaḏ aḏawem semmiɣ ixeddamen minzi axeddam war issin ca min itegg uweqqaf nnes. Kenniw aḏawem semmiɣ imeddukaȓ inu minzi nniɣ-awem marra min sȓiɣ zi Baba. <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />Maci ḏ kenniw iy ḏayi ixḍaren; Lla, ḏ nec iy kenniw ixḍaren. Kellfeɣ-kenniw ḥima aḏ traḥem aḏ tarwem izekkunen, ḥima izekkunen nwem aḏ qqimen i ȓebda. Ammu, aḏawem yuc Baba marra min ḏas ɣa ṯettarem ƹlaḥsab isem inu. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />Ḏ ṯa ḏ ȓuṣiyeṯ inu, iƹni aḏ tḥibbem ayawya.<verse eid="JHN 15:17" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa isezƹam imeḥḍaren nnes</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />Meȓa ddunect tƹiffa-kenniw, fekkareṯ qa nec ṯƹiff-ayi qbeȓ i kenniw. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />Maƹlik kenniw zi ddunect-a, iȓi kenniw ṯƹizzem x ddunect-a. Walakin kenniw war ṯeǧim ca zi ddunect. Nec ixḍareɣ-kenniw zi ddunect-a, s manayenni tƹiffa-kenniw ddunect. <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />Fekkareṯ ḏeg wawaȓ iy ḏawem nniɣ iƹni axeddam war iǧi ca ḏ ameqqran zeg uweqqaf nnes. Meȓa ƹeddben-ayi, ataf akenniw ƹeddben. Meȓa sȓin i wawaȓ inu, ataf aḏ sȓen ƹaweḏ i wawaȓ nwem. <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />Niṯni teggen-awem manaya marra x ssabab n yisem inu minzi war ssinen ca wenni iy ḏayi d issekken. <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />Maƹlik war d usiɣ ssiwȓeɣ akiḏsen, ataf war ɣarsen bu ȓmuƹṣiyeṯ. Walakin ȓexxu war ɣarsen bu lƹuder x ȓmuƹṣiyeṯ nsen. <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />Wenni iy ḏayi itƹiffan, ataf itƹiffa uȓa ḏ Baba ƹaweḏ. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />Maƹlik war xḏimeɣ akiḏsen lmuƹjizaṯ war ṯent ixḏim uȓa ḏ ijjen illa nec, ataf war ɣarsen bu ȓmuƹṣiyeṯ. Walakin ȓexxu niṯni ẓrin lmuƹjizaṯ inu ƹiffen-ayi nec uȓa ḏ Baba. <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />Manaya iwqeƹ ḥima aḏ ikemmeȓ wawaȓ ig yurin ḏi ccariƹa nsen wami inna &lt;Qa ƹiffen-ayi bȓa ssabab.&gt;<verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />Aḏ d yas Lmuƹawin iƹni Arruḥ n lḥaqiqa. Aḏawem ṯiḏ ssekkeɣ nec zi Baba u netta iffeɣ-d zi Baba. Xmi d ɣa yas, axafi icheḏ. <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />Aḏ tcehḏem uȓa ḏ kenniw ƹaweḏ minzi aqa kenniw akiḏi zeg umezwaru."<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="nb">
    <verse number="1" style="v" sid="JHN 16:1" />"Nniɣ-awem manaya ḥima war ṯsemḥem ca ḏi lʼiman nwem. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />Akenniw ṭerden zi ṯemziḏawin. Ƹaḏ aḏ d tas ȓweqṯ aḏas itɣir i wenni iy kenniw ɣa inɣen belli itegg lʼajar i Arebbi. <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />Niṯni teggen manaya minzi war ssinen ca Baba, war ḏayi ssinen uȓa ḏ nec. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />Qa nniɣ-awem ṯimesȓayin-a ȓexxu bac meȓmi d ɣa ṯas ȓweqṯ, aḏ tƹaqȓem belli nniɣ-awem-ṯent nec. Ḏeg umezwaru war ḏawem nniɣ ca ṯimesȓayin-a minzi nec aqayi akiḏwem.<verse eid="JHN 16:4" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa iseȓmaḏ x ȓxeḏmeṯ n Arruḥ iqeddsen</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5" />Ȓexxu nec aḏ raḥeɣ ɣar wenni iy ḏayi d issekken, walakin kenniw uȓa ḏ ijjen zzaywem war ḏayi isseqsi mani ɣa raḥeɣ. <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />Wami ḏawem nniɣ manaya, uȓawen nwem ḏaysen ȓeḥȓiq aṭṭas. <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />Aqa tesȓam ȓḥaqq: Ḥsen i kenniw aḏ raḥeɣ. Meȓa war ruḥeɣ ca, ataf war ɣarwem d itis ca Lmuƹawin nni. Walakin meȓa ruḥeɣ, ataf aḏawem ṯiḏ ssekkeɣ. <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />Xmi d ɣa yas, aḏ d isbeyyen i yiwḏan n ddunect ɣalṭen x ȓmuƹṣiyeṯ ḏ min iṣeȓḥan ḏ lḥisab. <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />Ɣalṭen x ȓmuƹṣiyeṯ nsen minzi niṯni war zzayi timnen ca. <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />Ɣalṭen x min iṣeȓḥan minzi ggureɣ ɣar Baba, war ḏayi ṯẓerrem ca zi ssa aȓ ṯsawent. <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />U ɣalṭen x lḥisab minzi Lmufsid<note caller="+" style="f"><char style="fr" closed="false">16.11 </char><char style="ft" closed="false">Ḏi Lkitab n lʼaṣel Lḥakem qqaren-ṯ i Lmufsid, iƹni Ibȓis.</char></note> nni ameqqran n ddunect-a itwaḥkem.<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />Ɣari aṭṭas n ṯmesȓayin aḏawem ṯent iniɣ, walakin ȓexxu qesḥent xawem. <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />Xmi d ɣa yas Arruḥ n lḥaqiqa, ataf aḏawem d isbeyyen lḥaqiqa ṯekmaȓ. Aqa netta war issiwiȓ ca zeg yixef nnes, issawaȓ illa zi min ḏas ɣa yini Arebbi. Aḏawem ixebbar ḏi ṯmesȓayin iy d ɣa yasen. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />Netta iy ḏayi ɣa isemɣaren minzi ikessi zi min ɣari, aḏawem ixebbar zzayes. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />Marra min ɣares ɣar Baba, ɣari uȓa ḏ nec. S manaya nniɣ-awem belli netta ikessi zi min ɣari, aḏawem ixebbar zzayes."<verse eid="JHN 16:15" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa isewjaḏ imeḥḍaren x wufuɣ nnes</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />
    <char style="it">Inna-asen Ƹisa:</char> "Cwit n ȓweqṯ war ḏayi ṯẓerrem ca, cwit n ȓweqṯ ƹaḏ aḏayi ṯeẓrem."<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />Nnan ȓebƹaḍ n imeḥḍaren nnes jarasen: "Min ixes aḏ yini s wawaȓ-a? Iqqar-aneɣ cwit n ȓweqṯ war ḏayi ṯẓerrem ca, cwit n ȓweqṯ ƹaḏ aḏayi ṯeẓrem. Ƹaweḏ iqqar, ȓaḥeqqac nec aḏ raḥeɣ ɣar Baba." <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />Qqaren: "Min ixes aḏ yini ȓmaƹna n &lt;cwit n ȓweqṯ&gt;? War nefhim ca min iqqar."<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />Issen Ƹisa qa rezzun aṯ sseqsan, uca inna-asen: "Mayemmi tseqsam ayawya x wawaȓ iy ḏawem nniɣ: &lt;Cwit n ȓweqṯ war ḏayi ṯẓerrem ca, cwit n ȓweqṯ ƹaḏ aḏayi ṯeẓrem&gt;? <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />Aqa tesȓam ȓḥaqq: Kenniw aḏ trum aḏ tḥeznem, walakin ddunect-a aḏ tfareḥ. Kenniw aḏaywem yiȓi ȓeḥȓiq, walakin ȓeḥȓiq nwem aḏ iḏweȓ ḏ ȓefraḥeṯ. <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />Ṯamɣarṯ xmi tarew, itiȓi ḏayes ȓeḥȓiq ȓaḥeqqac ȓweqṯ nnes ṯuweḍ-d. Walakin xmi ɣa ṯarew aseymi, war tfekkir ca ƹaḏ ḏi ȓeḥȓiq nni s ȓefraḥeṯ nnes minzi ṯurew-d ijjen n useymi ɣar ddunect-a. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />Uȓa ḏ kenniw ḏaywem ȓeḥȓiq ȓexxu, walakin akenniw ẓreɣ ƹaweḏ. Ȓexddenni aḏ tfarḥem s wuȓawen nwem, war ḏawem itekkes ȓefraḥeṯ nwem ḥadd.<verse eid="JHN 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 16:23" />Nhar nni <char style="it">iy d ɣa yasen</char> kenniw war ḏayi tseqsim x walu. Aqa tesȓam ȓḥaqq: Baba aḏawem yuc marra min ḏas ɣa ṯettarem ƹlaḥsab isem inu. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />Ḥetta aȓ ȓexxu war ṯettarem walu ƹlaḥsab isem inu. Ttareṯ aḏ tafem, ataf ȓefraḥeṯ nwem aḏ tiȓi ṯekmaȓ.<verse eid="JHN 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />Ssiwȓeɣ-awem manaya s ȓemƹani. Aḏ d tas ijjen n ȓweqṯ war kiḏwem ssiwiȓeɣ ca s ȓemƹani. Aḏawem xebbareɣ x Baba s wawaȓen nican <char style="it">bȓa ȓemƹani</char>. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />Nhar nni kenniw aḏ tettarem i Baba ƹlaḥsab isem inu. Qqareɣ-awem belli maci ḏ nec iy ɣa ittaren ḏeg umcan nwem. <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />Minzi Baba s yixef nnes itḥibba-kenniw wami ḏayi ṯḥibbem ṯumnem belli nec ffɣeɣ-d zi Arebbi. <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />Ffɣeɣ-d zi Baba wḍeɣ-d ɣar ddunect-a. Aḏ uyureɣ zi ddunect-a aḏ ƹeqbeɣ ƹaweḏ ɣar Baba."<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />Nnan-as imeḥḍaren nnes: "Ȓexxu cek ṯessawaȓeḏ nican, war iǧi ca s ȓemƹani. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />Ȓexxu neccin netwaȓa belli ṯessneḏ kuȓci war ṯeḥḏijeḏ wi c ɣa isseqsan. S manaya numen belli ṯusiḏ-d zi Arebbi."<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />Indeq-d Ƹisa inna-asen: "Ȓexxu iy ṯumnem niɣ? <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />Aḏ d tas ijjen n ȓweqṯ aqa ȓexxu ṯusa-d, aḏ temzeǧaƹem kenniw kuȓ ijjen zzaywem aḏ irewwaḥ. Aḏayi ṯsemḥem aḏ iȓiɣ waḥḏi, walakin war tiȓiɣ ca waḥḏi minzi Baba aqaṯ akiḏi. <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />Qqareɣ-awem manaya ḥima aḏ teysim zzayi ȓehna. Ḏi ddunect-a ṯanita axawem ṯekk ḏayes tamara, walakin cejjƹeṯ ixef nwem aqa nec rebḥeɣ ddunect-a."<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">Siḏiṯneɣ Ƹisa itẓaǧa ƹlaḥsab imeḥḍaren nnes aḏ iȓin ḏ ijjen</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />Wami issiweȓ Ƹisa x manaya, iysi ṯiṭṭawin nnes ɣar ujenna inna: "A Baba, ṯuweḍ-d ȓweqṯ. Semɣar Mmic ḥima ac isemɣar. <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />Minzi ṯuciḏ-as jjheḏ x kuȓ bnaḏem ḥima aḏ yuc ṯuḏarṯ n ȓebda i marra yinni iy ḏas ṯuciḏ. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />Ṯuḏarṯ n ȓebda ḏ ṯa iƹni ac ssnen belli cek ḏ Arebbi nican waḥḏec, aḏ ssnen ƹaweḏ Ƹisa Lmasiḥ iƹni wenni iy ṯessekkeḏ. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />Nec semɣareɣ-c ḏa ḏi ṯmurṯ, kemmȓeɣ ȓxeḏmeṯ iy ḏayi ṯuciḏ. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />Semɣar-ayi ȓexxu akiḏec a Baba s lƹaḍama nni tuɣa ɣari wami ǧiɣ akiḏec qbeȓ ma aḏ tiȓi ddunect.<verse eid="JHN 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />Sbeyyneɣ-d isem nnec i imeḥḍaren-a iy ḏayi ṯuciḏ zi ddunect-a. Cek ṯeǧiḏ ḏ bab nsen qbeȓ, ṯuciḏ-ayi-ṯen qa ṭaƹen i wawaȓ nnec. <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />Ȓexxu ssnen belli marra min ḏayi ṯuciḏ yusa-d zi ɣarek. <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />Minzi nec ssiwḍeɣ-asen awaȓ iy ḏayi ṯuciḏ, niṯni qebȓen-ṯ. Ssnen ḏ ṣṣaḥ belli nec zi ɣarek iy d usiɣ, umnen ƹaweḏ belli ḏ cek iy ḏayi d issekken.<verse eid="JHN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9" />Tettareɣ ƹlaḥsab i niṯni. War tettareɣ ca ƹlaḥsab i ddunect-a; Lla, tettareɣ ƹlaḥsab i yinni iy ḏayi ṯuciḏ minzi niṯni nnec. <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />Kuȓci min ɣari, ɣarek. U kuȓci min ɣarek, ɣari. Nec twasemɣareɣ zzaysen. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />War tɣimiɣ ca nec ḏi ddunect, aḏ qqimen niṯni ḏayes u nec ggureɣ-d ɣarec. A Baba Amqeddes, ḥḍa-ṯen s yisem nnec iy ḏayi ṯuciḏ ḥima aḏ iȓin ḏ ijjen am neccin. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />Wami kiḏsen ǧiɣ, ḥefḍeɣ xasen s yisem nnec iy ḏayi ṯuciḏ. Ḥḍiɣ-ṯen, uȓa ḏ ijjen ma iweddar ɣir wenni tuɣa iweddaren ḥima aḏ ikemmeȓ min iqqar Lkitab.<verse eid="JHN 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 17:13" />Ȓexxu ggureɣ-d ɣarek. Ssawaȓeɣ awaȓen-a u nec ƹaḏ aqayi ḏi ddunect ḥima aɣarsen ṯiȓi ȓefraḥeṯ inu ṯekmaȓ. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />Ssiwḍeɣ-asen awaȓ nnec i imeḥḍaren inu, niṯni ƹiffen-ṯen yiwḏan minzi war ǧin ca zi ddunect-a amecnaw nec war ǧiɣ ca zi ddunect. <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />Nec war ḏac tettareɣ ca aṯen ṯsufɣeḏ zi ddunect-a; Lla, tettareɣ-ac aṯen teḥḍiḏ zi ccarr. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />Niṯni war ǧin ca zi ddunect, amecnaw nec war ǧiɣ ca zi ddunect. <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />Ṣeffa-ṯen s lḥaqiqa, awaȓ nnec netta iy iǧan ḏ lḥaqiqa. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />Mammec ḏayi ṯessekkeḏ cek ɣar ddunect, uȓa ḏ nec ssekkeɣ-ṯen ɣar ddunect. <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />Nec ṣeffiɣ ixef inu x ssabab nsen ḥima aḏ twaṣeffan uȓa ḏ niṯni ƹaweḏ s lḥaqiqa.<verse eid="JHN 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />War tettareɣ ca ƹlaḥsab i niṯni waha, tettareɣ ƹlaḥsab i yinni iy ɣa iqebȓen awaȓ nsen ḥima aḏ amnen zzayi. <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />Ḥima aḏ iȓin marra ḏ ijjen a Baba, am cek aqac ḏayi nec aqayi ḏayek. Ḥima aḏ iȓin niṯni ƹaweḏ ḏ ijjen ḏayneɣ. Ḥima aḏ amnen yiwḏan qa ḏ cek iy ḏayi d issekken. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />Nec uciɣ-asen lƹaḍama iy ḏayi ṯuciḏ ḥima aḏ iȓin ḏ ijjen am neccin ḏ ijjen. <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />Cek aqac ḏayi nec aqayi ḏaysen, ḥima aḏ munen aḏ iȓin ḏ ijjen. Ḥima aḏ ssnen yiwḏan qa cek ṯessekkeḏ-ayi-d ɣar imeḥḍaren-a, tḥibbiḏ-ṯen amecnaw mammec ḏayi tḥibbiḏ nec.<verse eid="JHN 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24" />A Baba, yina ḏayi ṯuciḏ xseɣ aḏ iȓin akiḏi mani ma ǧiɣ nec ḥima aḏ ẓren lƹaḍama inu iy ḏayi ṯuciḏ minzi cek ṯḥibbeḏ-ayi qbeȓ ma aḏ tiȓi ddunect. <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />A Baba iǧan nican, ddunect war c ṯessin ca walakin nec qa ssneɣ-c. Yina akiḏi ssnen qa ṯessekkeḏ-ayi-d cek. <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />Nec sbeyyneɣ-asen-d isem nnec u ƹaḏ aṯ sbeyyneɣ ḥima aḏaysen ṯiȓi ȓemḥibbeṯ nni iy zi ḏayi tḥibbiḏ, aḏaysen iȓiɣ nec s yixef inu."<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">Israʼiliyen ḏ irumaniyen teṭṭfen Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />Menbaƹd i ṯẓaǧiṯ nni, iffeɣ Ƹisa ak imeḥḍaren nnes ẓwan iɣzar n Qidrun. Ḏinni ijjen n jarda, uḏfen ḏayes netta ḏ imeḥḍaren nnes. <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />Tuɣa Yahuḏa wenni iy ṯ ɣa izzenzen issen amcan nni minzi Ƹisa tuɣa itmeȓqa ḏinni aṭṭas ak imeḥḍaren nnes. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />Ṣafi, yusa-d Yahuḏa ɣar jarda nni yuwi-d akiḏes ȓƹaskar, twassekken-d akiḏes ƹaweḏ can n iƹessasen zeg ifarrisiyen u zi arruyas n ȓfuqaha. Usin-d s ȓefnaraṯ ḏ iṣfeḍawen ḏ ȓesnaḥ. <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />Issen Ƹisa marra min ḏas ɣa iweqƹen, iffeɣ-d ɣarsen inna-asen: "Minxef ṯrezzum?"<verse eid="JHN 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5" />Nnan-as: "X Ƹisa zi Naṣira."</para>
  <para style="p" vid="JHN 18:5">Inna-asen: "Aqa ḏ nec."</para>
  <para style="p" vid="JHN 18:5">Ibedd akiḏsen Yahuḏa wenni iy ṯ izzenzen. <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />Wami ḏasen inna qa ḏ nec, ḏewȓen ɣar ḏeffar wḍan ɣar ṯmurṯ.<verse eid="JHN 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 18:7" />Inna-asen ƹaweḏ: "Minxef ṯrezzum?"</para>
  <para style="p" vid="JHN 18:7">Nnan-as: "X Ƹisa zi Naṣira."<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />Inna-asen Ƹisa: "Qa nniɣ-awem-ṯ ḏ nec. Meȓa ṯrezzum xafi jjem yina aḏ uyuren." <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />S wawaȓ-a ikemmeȓ min inna Ƹisa zi qbeȓ iƹni &lt;War ḏayi iweddar ḥadd zeg yinni iy ḏayi ṯuciḏ.&gt;<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />Simƹan Buṭrus tuɣa ɣares ssif, ijbeḏ-iṯ-iḏ yuwṯa zzayes ismeɣ n arrayes n ȓfuqaha iqess-as amezzuɣ afusi. Ismeɣ nni qqaren-as Maȓxus.<verse eid="JHN 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 18:11" />Inna-as Ƹisa i Buṭrus: "Arr ssif nnec ɣar umcan nnes. Ȓkas-a n ȓaƹḏab iy ḏayi yuca Baba, ma war sesseɣ ca zzayes?"<verse eid="JHN 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />Ȓƹaskar ḏ arrayes nsen ḏ iƹessasen n israʼiliyen ṭṭfen Ƹisa carfen-ṯ. <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />Ḏ amezwaru nedhen-ṯ ɣar yijjen qqaren-as Ḥannin minzi netta ḏ babas n ṯemɣarṯ n Qiyafa. Qiyafa tuɣaṯ ḏ arrayes n ȓfuqaha ḏeg useggwas nni. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />Netta tuɣa inṣeḥ israʼiliyen inna-asen qa ḥsen aḏ immeṯ ijjen n uryaz x ccaƹb.<verse eid="JHN 18:14" /></para>
  <para style="s">Simƹan Buṭrus inekkar Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />Simƹan Buṭrus ḏ ijjen n umeḥḍar nneɣni ḏfaren Ƹisa. Ameḥḍar nni maƹruf ɣar arrayes n ȓfuqaha, yuḏef ak Ƹisa ɣar ȓemraḥ n ṯeddarṯ n arrayes nni. <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />Buṭrus ibedd itraja barra ɣar ṯewwarṯ. Iffeɣ-d umeḥḍar nni ig iǧan maƹruf ɣar arrayes n ȓfuqaha, issiweȓ ak ṯƹessast nni itiȓin ḏi ṯewwarṯ issiḏef-d Buṭrus.<verse eid="JHN 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 18:17" />Ṯaƹessast nni iḥeṭṭan ḏi ṯewwarṯ ṯenna-as i Buṭrus: "Ma war ṯeǧiḏ cek zeg imeḥḍaren n bnaḏem-a?"</para>
  <para style="p" vid="JHN 18:17">Inna-as: "Nec, lla!"<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />Ixeddamen ḏ iƹessasen bedden ḏinni, ggin ṯimessi s ȓefḥam zɣaren ɣares minzi ṯesmeḍ. Ibedd uȓa ḏ Buṭrus akiḏsen ḥima aḏ izɣar.<verse eid="JHN 18:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />Ibḏa arrayes n ȓfuqaha itseqsa Ƹisa x imeḥḍaren nnes ḏ min iseȓmaḏ. <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />Inna-as Ƹisa: "Tbeccareɣ zzaṯ i yiwḏan, seȓmaḏeɣ-ṯen ȓebda ḏi ṯemziḏawin uȓa ḏi ṯemziḏa ṯameqqrant mani tmunen israʼiliyen marra. War ssiwiȓeɣ walu s ṯnufra. <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />Nec, mayemmi ḏayi tseqsiḏ? Sseqsa yinni ḏayi isȓin min ḏasen nniɣ. Niṯni ssnen min nniɣ."<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />Inna-as Ƹisa manaya ȓexddenni ijjen zeg iƹessasen ibedden ḏinni yuca-as ijjen n useqqiȓ i Ƹisa inna-as: "Ma s wawaȓ-a iy zi ɣa ṯarreḏ x arrayes n ȓfuqaha?"<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />Inna-as Ƹisa: "Meȓa xḍiɣ ḏeg wawaȓ, in-ayi minḏi xḍiɣ. Meȓa ssiwȓeɣ nican, mayemmi ḏayi ṯuwṯiḏ?" <verse eid="JHN 18:23" /><verse number="24" style="v" sid="JHN 18:24" />Ssenni issekk-iṯ Ḥannin ḏ ameḥbus ɣar Qiyafa arrayes n ȓfuqaha.<verse eid="JHN 18:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />Buṭrus ibedd ḏinni izɣar ɣar ṯmessi. Nnan-as: "Ma war ṯeǧiḏ uȓa ḏ cek zeg imeḥḍaren nnes?"</para>
  <para style="p" vid="JHN 18:25">Netta inkar inna-asen: "Nec, lla!"<verse eid="JHN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26" />Ȓexddenni ijjen zeg ixeddamen n arrayes n ȓfuqaha, netta iteƹna-d i wenni umi iqess Buṭrus amejjun, iruḥ inna-as i Buṭrus: "Ma war ṯeǧiḏ ḏ cek iy ẓriɣ akiḏes ḏi jarda nni?"<verse eid="JHN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 18:27" />Buṭrus inkar ƹaweḏ, ȓexddenni idden uyaziḍ.<verse eid="JHN 18:27" /></para>
  <para style="s">Israʼiliyen thamen Siḏiṯneɣ Ƹisa ɣar irumaniyen</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />Uwin Ƹisa zi <char style="it">ṯeddarṯ n</char> Qiyafa ɣar ȓeqṣar n lḥakem, tuɣa zic. Israʼiliyen war uḏifen ca ɣar ȓeqṣar ḥima war sḥerrimen ca ȓƹiḏ x yixef nsen.<note caller="+" style="f"><char style="fr" closed="false">18.28 </char><char style="ft" closed="false">Ccariƹa n Musa tḥerrem i Ayṯ-Israʼil aḏ aḏfen amcan n lkuffar ḏi Ȓƹiḏ Ameqqran.</char></note> <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />Iffeɣ-d ɣarsen lḥakem ḏ arumani qqaren-as Bilaṭus, inna-asen: "Man ttuhmeṯ iy ɣarwem x bnaḏem-a?"<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />Nnan-as: "Maƹlik war iǧi ḏ lmujrim, ataf war ḏac ṯiḏ ntiwi ca ḏa."<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />Inna-asen Bilaṭus: "Iwa awim-ṯ kenniw, axas ṯḥekmem s ccariƹa nwem."</para>
  <para style="p" vid="JHN 18:31">Nnan-as israʼiliyen: "War ḏaneɣ ṯsemmḥem ca kenniw a nneɣ uȓa ḏ ijjen." <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />Iwqeƹ manaya ḥima aḏ ikemmeȓ wawaȓ iy inna Ƹisa x ȓmewṯ iy ɣa immeṯ.<verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />Ssenni yuḏef-d ƹaweḏ Bilaṭus ɣar ȓeqṣar, iȓaɣa x Ƹisa inna-as: "Ma ḏ cek ḏ azeǧiḏ n Ayṯ-Israʼil?"<verse eid="JHN 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34" />Inna-as Ƹisa: "Manaya, ma ṯeqqareḏ-t zi ɣarek niɣ nnan-ac-ṯ xafi inneɣni?"<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />Inna-as Bilaṭus: "Ma nec ḏ aʼisraʼili? Lʼumma nnec ḏ arruyas n ȓfuqaha iy c d yuwin ɣari, min ṯeggiḏ?"<verse eid="JHN 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36" />Inna-as Ƹisa: "Ȓmulk inu maci zi ddunect-a. Maƹlik ȓmulk inu zi ddunect-a, ataf imeḥḍaren inu ḥarben ḥima war weṭṭiɣ ca ḏeg ifassen n israʼiliyen; Lla, ȓmulk inu war iǧi ca ssanita."<verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />Inna-as Bilaṭus: "Zaƹma, cek ḏ azeǧiḏ?"</para>
  <para style="p" vid="JHN 18:37">Inna-as Ƹisa: "Ṯenniḏ cek nec ḏ azeǧiḏ. Nec xeȓqeɣ-d usiɣ-d ɣar ddunect-a ḥima aḏ cehḏeɣ i lḥaqiqa. Marra wenni iǧan zi lḥaqiqa aḏ iḏfar awaȓ inu."<verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />Inna-as Bilaṭus: "Iwa min ṯeƹna lḥaqiqa-ya?" Wami inna ammu, iffeɣ ƹaweḏ ɣar israʼiliyen inna-asen: "War ḏayes ufiɣ bu ttuhmeṯ. <verse eid="JHN 18:38" /><verse number="39" style="v" sid="JHN 18:39" />Walakin ṯnumem ḍeǧqeɣ-awem-d i yijjen n umeḥbus ḏi Ȓƹiḏ Ameqqran. Ȓexxu, ma ṯexsem aḏawem d ḍeȓqeɣ i uzeǧiḏ n Ayṯ-Israʼil?"<verse eid="JHN 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40" />Ƹeyyḍen s jjheḏ nnan: "War d ḍeǧeq ca i wanita, ḍȓeq-aneɣ-d i Barabas!" Tuɣa Barabas ḏ aqeṭṭaƹ ibriḏen.<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="s">Israʼiliyen rezzun aḏ ṣellben Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />Yuwi Bilaṭus Ƹisa ḥima aṯ uwṯen ȓƹaskar s usɣun. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />Muḏen-as ijjen n ttaj n isennanen ggin-as-ṯ x uzeǧif nnes. Ggin xas aseȓham ḏ azeggwaɣ.<note caller="+" style="f"><char style="fr" closed="false">19.2 </char><char style="ft" closed="false">Ḏanita u ƹaweḏ ḏi lʼaya 5 nzemmar a nini azeggwaɣ niɣ gruna.</char></note> <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />Tqerraben ɣares ccaṯen-ṯ s iseqqiȓen, qqaren-as ssalam ay azeǧiḏ n Ayṯ-Israʼil. <verse eid="JHN 19:3" /><verse number="4" style="v" sid="JHN 19:4" />Iffeɣ-d ƹaweḏ Bilaṭus inna-asen: "Xzareṯ, aḏawem ṯiḏ sufɣeɣ ḥima aḏ tessnem belli nec war ḏayes ufiɣ bu can ttuhmeṯ." <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />Ssenni iffeɣ Ƹisa ɣar barra s ttaj nni n isennanen ḏ useȓham nni azeggwaɣ. Inna-asen Bilaṭus: "Haqa bnaḏem nni."<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />Wami ṯ ẓrin arruyas n ȓfuqaha ḏ iƹessasen, tƹeyyaḍen s jjheḏ qqaren-as: "Ṣelleb-iṯ! Ṣelleb-iṯ!"</para>
  <para style="p" vid="JHN 19:6">Inna-asen Bilaṭus: "Ysim-ṯ kenniw ṣellbem-ṯ, nec war ḏayes ufiɣ bu can ttuhmeṯ."<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />Arrin xas israʼiliyen nnan-as: "Ɣarneɣ ijjen n ȓqanun. Ƹlaḥsab ȓqanun nni itxeṣṣa aḏ immeṯ minzi netta itarra ixef nnes ḏ Mmis n Arebbi."<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />Wami isȓa Bilaṭus awaȓ-a iggweḏ ktar. <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />Yuḏef ƹaweḏ ɣar ȓeqṣar nnes inna-as i Ƹisa: "Manis cek?" Ƹisa war xas yarri ca.<verse eid="JHN 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 19:10" />Inna-as Bilaṭus: "Ma war kiḏi ṯessiwiȓeḏ ca? Ma war ṯessineḏ belli ɣari jjheḏ aḏac ḍeȓqeɣ niɣ ac ṣellbeɣ?"<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />Indeq-d Ƹisa inna-as: "War ɣarek bu jjheḏ xafi illa meȓa immuc-ac zi Arebbi. Ƹlaḥsab manaya, wenni iy ḏayi d yuwin ɣarec, ɣares ddnub ktar zzayek."<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />Ssenni irezzu Bilaṭus aḏas iḍȓeq. Walakin israʼiliyen tƹeyyaḍen s jjheḏ qqaren: "Meȓa ṯḍeȓqeḏ i uryaz-a ataf war ṯeǧiḏ ca ḏ ameddukeȓ n Qayṣar.<note caller="+" style="f"><char style="fr" closed="false">19.12 </char><char style="ft" closed="false">Qayṣar netta ḏ azeǧiḏ n irumaniyen. Ḏ niṯni iy iḥekkmen x Ayṯ-Israʼil ḏi ȓweqṯ nni.</char></note> Marra wenni itarran ixef nnes ḏ azeǧiḏ netta ḍed i Qayṣar."<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />Wami isȓa Bilaṭus awaȓ-a isufeɣ Ƹisa, iqqim Bilaṭus x ȓkursi n ȓeḥkam ḏeg yijjen n umcan qqaren-as &lt;Ssaḥa n Uzru.&gt; S wawaȓ n israʼiliyen qqaren-as &lt;Gabbaṭa.&gt; <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />Nhar nni ḏ jjemƹa ɣar jwayeh n ṯenƹac, sewjaḏen i Ȓƹiḏ Ameqqran. Inna-asen Bilaṭus i israʼiliyen: "Haqawem azeǧiḏ nwem."<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />Walakin tƹeyyaḍen s jjheḏ qqaren: "Ysi-ṯ ysi-ṯ, ṣelleb-iṯ!"</para>
  <para style="p" vid="JHN 19:15">Inna-asen Bilaṭus: "Ma aḏ ṣellbeɣ azeǧiḏ nwem?"</para>
  <para style="p" vid="JHN 19:15">Arrin xas arruyas n ȓfuqaha nnan-as: "War ɣarneɣ bu uzeǧiḏ illa Qayṣar!"<verse eid="JHN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16" />Ssenni isellem-asen-ṯ ḥima aṯ ṣellben x ṣṣalib, ysin Ƹisa.<verse eid="JHN 19:16" /></para>
  <para style="s">Irumaniyen tṣellaben Siḏiṯneɣ Ƹisa x ṣṣalib</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17" />Iffeɣ Ƹisa yarbu ṣṣalib s yixef nnes iruḥ ɣar yijjen n umcan qqaren-as &lt;Amcan n Jumjuma.&gt; S wawaȓ n israʼiliyen qqaren-as &lt;Gulguṭa.&gt; <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />Mani ṯ ṣellben, ṣellben akiḏes ṯnayen nneɣni, ssa ḏ ssa, Ƹisa ḏi ȓwesṭ. <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />Yura Bilaṭus ḏeg ijjen n ṯeȓwiḥet, iggi-t ɣar uzeǧif n Ƹisa x ṣṣalib ṯura ḏayes: &lt;Ƹisa zi Naṣira, azeǧiḏ n Ayṯ-Israʼil.&gt; <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />Ṯaȓwiḥet nni ɣrin-t aṭṭas n israʼiliyen minzi amcan mani iy ṣellben Ƹisa yuḏes ṯandint. Ṯaȓwiḥet nni tuɣa ṯura s Lƹibriya ḏ Latiniya ḏ Ṯyunaniṯ.<verse eid="JHN 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 19:21" />Nnan-as arruyas n ȓfuqaha n israʼiliyen i Bilaṭus: "War tari ca, &lt;Azeǧiḏ n Ayṯ-Israʼil.&gt; Ari: &lt;Aryaz-a inna nec ḏ Azeǧiḏ n Ayṯ-Israʼil.&gt;"<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />Inna-asen Bilaṭus: "Nec min uriɣ, qa uriɣ-ṯ."<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />Wami ȓƹaskar ṣellben Ƹisa, ysin arruḍ nnes bḍan-ṯ x arbeƹa n ṯseqqar kuȓ aƹeskri iysi ṯasɣarṯ nnes. Ysin ƹaweḏ čammir, čammir nni iṣneƹ-iṯ uḏerraz.<note caller="+" style="f"><char style="fr" closed="false">19.23 </char><char style="ft" closed="false">Aḏerraz wenni izeǧgen ṯaḍufṯ ixeddem zzayes.</char></note> <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />Nnan i wayawya, War ṯ netcarrig ca, axas negg lqurƹa bac a nessen wi ṯ ɣa iysin. Ammu ikemmeȓ wawaȓ n Lkitab:</para>
  <para style="q2" vid="JHN 19:24">&lt;Bḍan arruḍ inu jarasen,</para>
  <para style="q2" vid="JHN 19:24">ggin lqurƹa x ȓeɣḍa inu.&gt;</para>
  <para style="b" vid="JHN 19:24" />
  <para style="p" vid="JHN 19:24">U ḏ manaya iy ggin ȓƹaskar.<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />Zzaṯ i ṣṣalib n Ƹisa ṯbedd yemmas ḏ xačes ḏ Maryam ṯamɣarṯ n Krifas ḏ Maryam ṯamagdaliṯ. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />Wami iẓra Ƹisa yemmas ibedd akiḏes umeḥḍar nni iy xas iƹizzen <char style="it">aṭṭas</char>, inna-as: "A yemma, aqaṯ ḏin mmim!" <verse eid="JHN 19:26" /><verse number="27" style="v" sid="JHN 19:27" />Inna-as ƹaweḏ i umeḥḍar nni: "Aqat ḏin yemmac!" Ssenni yuwi-t umeḥḍar nni ɣar ṯeddarṯ nnes.<verse eid="JHN 19:27" /></para>
  <para style="s">Ȓmewṯ n Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />Menbaƹd i manaya issen Ƹisa belli kuȓci ikemmeȓ, inna: "Aqayi ffuḏeɣ." S wawaȓ nni iffeɣ min d yusin ḏi Lkitab.<note caller="+" style="f"><char style="fr" closed="false">19.28 </char><char style="ft" closed="false">Xzar Lkitab n Zzabur, izȓi wis 69, lʼaya 22.</char></note> <verse eid="JHN 19:28" /><verse number="29" style="v" sid="JHN 19:29" />Ḏinni ijjen n uɣerraf iccur s waman uḍiȓ ḏ isemmamen. Sɣeḍṣen spunxa ḏeg waman uḍiȓ nni, ggin-t x ukeccuḍ<note caller="+" style="f"><char style="fr" closed="false">19.29 </char><char style="ft" closed="false">Akeccuḍ-a yusa-d zeg yijjen n arbiƹ igga am uzuy.</char></note> ucin-as-t ɣar uqemmum nnes. <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />Wami iqqas Ƹisa aman nni, inna: "Itwakemmeȓ!" Isaḏar azeǧif nnes, isellem buḥbeȓ nnes.<verse eid="JHN 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />Iwqeƹ manayenni iḍennaṭ n Ȓƹiḏ Ameqqran. X manaya israʼiliyen ttaren-as i Bilaṭus aḏasen rzen iḍaren i yinni itwaṣellben aḏ d sehwan ddat nsen zi ṣṣalib. Ggin-asen amenni ḥima war tɣimi ddat nsen x ṣṣalib ḏi nhar n ssebṯ n lƹibada minzi nhar n ssebṯ nni ḏ ameqqran aṭṭas. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />Usin-d ȓƹaskar rzin iḍaren i umezwaru ḏ wis ṯnayen iy kiḏes itwaṣellben. <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />Wami ruḥen ɣar Ƹisa, war ḏas rzin bu iḍaren minzi ufin-ṯ immuṯ. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />Walakin ijjen zi ȓƹaskar nni icukk-iṯ ɣar uɣezḏis nnes s yijjen n ukeccuḍ ḏayes ṯicceṭ n wuzzeȓ, uzzȓen-d zzayes ḏeɣya iḏammen ḏ waman aṭṭas. <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />Wenni iẓrin manayenni icheḏ xas, u min icheḏ nican iy iǧa. Issen belli min iqqar ḏ lḥaqiqa u icehheḏ bac azzayes ṯamnem uȓa ḏ kenniw. <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />Iwqeƹ manaya ḥima aḏ ikemmeȓ min d yusin ḏi Lkitab: &lt;War zzayes itrezzi uȓa ḏ ijjen n yiɣes.&gt; <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />Ṯusa-d ḏeg yijjen n lʼaya nneɣni: &lt;Aḏ xzaren ɣar wenni itwacukken.&gt;<verse eid="JHN 19:37" /></para>
  <para style="s">Yusef ḏ Nikudim neṭṭȓen Siḏiṯneɣ Ƹisa</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />Menbaƹd i manaya, ijjen qqaren-as Yusef zi ṯendint n Arimatya iruḥ ittar-as i Bilaṭus aḏ iysi ddat n Ƹisa. Netta Yusef ḏ ameḥḍar n Ƹisa walakin war d isbeyyen ca ixef nnes iggweḏ zeg israʼiliyen. Wami iqbeȓ Bilaṭus, iruḥ Yusef iysi ddat n Ƹisa. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />Yusa-d uȓa ḏ Nikudim, aryaz nni tuɣa ig iggin zziyara ijjen n ṯwaȓa s ǧiȓeṯ ɣar Ƹisa. Ȓexxu yuwi-d akiḏes ca n texliṭa ḏayes arbeƹa u ṯȓaṯin kilu n murr<note caller="+" style="f"><char style="fr" closed="false">19.39 </char><char style="ft" closed="false">Murr netta ḏ aman n yijjen n ṯcejjarṯ ḏaysen ȓefwaḥ.</char></note> ḏ ukeccuḍ n lƹud<note caller="+" style="f"><char style="fr" closed="false">19.39 </char><char style="ft" closed="false">Lƹud netta ḏ ijjen n ṯcejjarṯ, akeccuḍ nnes ḏayes ȓefwaḥ aṭṭas.</char></note> teggen-t israʼiliyen i yinni immuṯen. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />Ssenni ysin ddat n Ƹisa keffnen-t s ȓecfen ḏ lƹiṭar nni, mammec teggen israʼiliyen i yinni immuṯen. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />Ḏeg umcan nni mani ṣellben Ƹisa ḏinni ijjen n jarda. Ḏi jarda nni ḏayes ijjen n unḍeȓ ḏ jḏiḏ igga am yifri, war ḏayes inḍiȓ ḥadd. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />Nhar nni tuɣa ḏ jjemƹa, israʼiliyen sewjaḏen i nhar n ssebṯ n lƹibada. X manayenni neḍȓen Ƹisa ḏeg yifri nni n unḍeȓ minzi yuḏes.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">Imeḥḍaren war tifen ca Siḏiṯneɣ Ƹisa ḏeg unḍeȓ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />Ḏi nhar amezwaru n ssimana, ṯusa-d Maryam ṯamagdaliṯ<note caller="+" style="f"><char style="fr" closed="false">20.1 </char><char style="ft" closed="false">Maryam ṯamagdaliṯ nettaṯ zeg ubilaj nni umi qqaren Magdala.</char></note> ɣar yifri n unḍeȓ n Ƹisa zic. Tuɣa ƹaḏ ṯaǧest, ṯufa azru itwakkes x yifri n unḍeȓ. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />Ṯuzzeȓ-d ṯusa-d ɣar Simƹan Buṭrus ḏ umeḥḍar nneɣni wenni iƹizzen x Ƹisa <char style="it">aṭṭas</char>, ṯenna-asen qa ysin Ƹisa zeg yifri n unḍeȓ, war nessin mani ṯ ggin.<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3-4" style="v" sid="JHN 20:3-4" />Iffeɣ Buṭrus ḏ umeḥḍar nni nneɣni ruḥen s ṯazzȓa s ṯnayen iḏsen ɣar yifri n unḍeȓ. Ameḥḍar nni izwar-as i Buṭrus yuweḍ ḏ amezwaru ɣa yifri n unḍeȓ. <verse eid="JHN 20:3-4" /><verse number="5" style="v" sid="JHN 20:5" />Isijj <char style="it">x yifri</char> yufa ȓecfen imars ḏinni walakin war yuḏif ca. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />Iḏeffar-iṯ-iḏ Simƹan Buṭrus ixḍeȓ, yuḏef ḏeg yifri n unḍeȓ. Itwaȓa ȓecfen nni <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />yufa ȓqabb iy zi tuɣa iɣeṭṭa uzeǧif n Ƹisa war iǧi ca ag ȓecfen, iḍfes waḥḏes. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />Ȓexddenni yuḏef umeḥḍar nni izwaren ɣar yifri n unḍeȓ, iẓra manayenni yumen. <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />Walakin niṯni ƹaḏ war fhimen ca zi Lkitab belli labud aḏ ikkar Ƹisa zi ȓmewṯ. <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />Ssenni rewwḥen imeḥḍaren.<verse eid="JHN 20:10" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa itmeḍhar-d i Maryam ṯamagdaliṯ</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />Maryam ṯbedd ɣar ṯewwarṯ n yifri n unḍeȓ ṯeqqim ṯetru. Wami ṯetru ṯsijj x yifri n unḍeȓ <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />ṯufa ṯnayen n lmalaʼikaṯ s warruḍ ḏ acemȓaȓ icten ṯeqqim ɣar uzeǧif icten ṯeqqim ɣar iḍaren mani tuɣa ṯeǧa ddat n Ƹisa.<verse eid="JHN 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 20:13" />Nnant-as: "A ṯamɣarṯ min cem yuɣin ṯetruḏ?"</para>
  <para style="p" vid="JHN 20:13">Ṯenna-asent: "Ysin Siḏi, war ssineɣ mani ṯ sersen." <verse eid="JHN 20:13" /><verse number="14" style="v" sid="JHN 20:14" />Ṯenna manayenni ṯexzar ɣar ḏeffar ṯufa ḏinni Ƹisa, walakin nettaṯ war ṯessin ca netta ḏ Ƹisa.<verse eid="JHN 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 20:15" />Inna-as Ƹisa i Maryam: "A ṯamɣarṯ min cem yuɣin ṯetruḏ, mixef ṯrezzuḏ?"</para>
  <para style="p" vid="JHN 20:15">Maryam tɣir-as ḏ bab n jarda nni, ṯenna-as: "A Siḏi meȓa ḏ cek iy ṯ iysin, in-ayi mani ṯ ṯserseḏ ḥima aṯ ysiɣ."<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />Inna-as Ƹisa: "A Maryam!"</para>
  <para style="p" vid="JHN 20:16">Ȓexddenni ṯeƹqeȓ-iṯ ṯenna-as s wawaȓ n israʼiliyen: "A Rabuni!" (Zaƹma &lt;A Lmuƹallim.&gt;)<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />Inna-as Ƹisa: "War ḏayi teṭṭef ca,<note caller="+" style="f"><char style="fr" closed="false">20.17 </char><char style="ft" closed="false">Imken tuɣa teṭṭef-iṯ zeg iḍaren nnes. Xzar Matta 28:9.</char></note> qa nec ƹaḏ war gaƹƹḏeɣ ca ɣar Baba. Ruḥ ɣar ayṯma inu, in-asen qa nec aḏ gaƹƹḏeɣ ɣar Baba ḏ Babaṯwem, ɣar Arebbi inu ḏ Arebbi nwem."<verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />Ṯruḥ Maryam ṯamagdaliṯ ṯessiweḍ-asen ȓexbar i imeḥḍaren ṯenna-asen qa ẓriɣ Siḏiṯneɣ issiweȓ-d akiḏi aqa min ḏayi inna...<verse eid="JHN 20:18" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa itmeḍhar-d ṯȓaṯa n ṯwaȓaṯin i imeḥḍaren nnes</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />Nhar n ȓḥad munen imeḥḍaren ɣar ṯmeddiṯ, ṯiwwura qqnent ggwḏen zeg israʼiliyen. Yusa-d Ƹisa ibedd ḏi ȓwesṭ inna-asen: "Sȓam xawem." <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />Inna-asen manaya, isbeyyen-asen-d ifassen nnes ḏ uɣezḏis nnes. Farḥen imeḥḍaren wami ẓrin Siḏiṯsen. <verse eid="JHN 20:20" /><verse number="21" style="v" sid="JHN 20:21" />Inna-asen ƹaweḏ Ƹisa: "Sȓam xawem. Mammec ḏayi d issekk Baba, ammu nec akenniw ssekkeɣ." <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />Wami inna manaya iṣṣuḍ xasen inna-asen: "Qebȓeṯ Arruḥ iqeddsen. <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />Wenni umi ṯsemḥem i ddnub nnes, aḏas twasemḥent. Wenni umi war ṯesmiḥem ca, war ḏas twasmiḥent ca."<verse eid="JHN 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />Walakin ijjen zi ṯenƹac n imeḥḍaren nnes umi qqaren Tuma tȓaɣan-as Acniw,<note caller="+" style="f"><char style="fr" closed="false">20.24 </char><char style="ft" closed="false">Acniw netta ḏ aḵniw.</char></note> war kisen iǧi ca wami d yusa Ƹisa. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />Nnan-as imeḥḍaren nni nneɣni qa neẓra Siḏiṯneɣ!</para>
  <para style="p" vid="JHN 20:25">Ikkar Tuma inna-asen: "Meȓa war ẓriɣ ca lʼaṯar n imesmiȓen ḏeg ifassen nnes aḏ ggeɣ ḍaḍ inu ḏeg umcan n imesmiȓen nni, aḏ serseɣ fus inu x uɣezḏis nnes, war timneɣ ca."<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />Menbaƹd i ṯmeniyyam, munen imeḥḍaren ƹaweḏ ɣar ḏaxeȓ, ṯiwwura qqnent akiḏsen Tuma. Yusa-d Ƹisa ibedd ḏi ȓwesṭ nsen inna-asen: "Sȓam xawem!" <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />Inna-as i Tuma: "Egg ḍaḍ nnec ḏanita, xzar ifassen inu. Sers fus nnec x uɣezḏis inu. War tcekka ca; Lla, amen."<verse eid="JHN 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28" />Indeq-d Tuma inna-as: "A Siḏi inu, ay Arebbi inu!"<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />Inna-as Ƹisa: "Aȓ wami ḏayi ṯeẓriḏ, ƹaḏ iy ṯumneḏ? Ssaƹḏ n yinni war ḏayi ẓrin ca, umnen."<verse eid="JHN 20:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />Igga Ƹisa aṭṭas n lmuƹjizaṯ nneɣni zzaṯ i imeḥḍaren nnes, niṯenti war urint ca ḏi Lkitab-a. <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />Ṯimesȓayin-a urint ḥima aḏ tamnem belli Ƹisa netta ḏ Lmasiḥ Mmis n Arebbi bac meȓa ṯumnem aɣarwem ṯiȓi ṯuḏarṯ ḏeg yisem nnes.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />Menbaƹd i manaya imeḍhar-d Ƹisa ƹaweḏ i imeḥḍaren nnes x cceṭṭ n ȓebḥar n Ṭabarya. Ammu iy iwqeƹ. <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />Munen ḏinni ȓebƹaḍ n imeḥḍaren nnes: Simƹan Buṭrus ḏ Tuma wenni umi qqaren &lt;Acniw&gt;,<note caller="+" style="f"><char style="fr" closed="false">21.2 </char><char style="ft" closed="false">Acniw netta ḏ aḵniw.</char></note> ḏ Naṯnahil netta zeg ubilaj n Qana ḏi ṯmurṯ n Ljalil, ḏ ṯarwa n Zabadi, ḏ ṯnayen nneɣni. <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />Ikkar Simƹan Buṭrus inna-asen nec aḏ raḥeɣ aḏ ymareɣ.</para>
  <para style="p" vid="JHN 21:3">Nnan-as akic nraḥ uȓa ḏ neccin. Ffɣen, nyin ḏi ṯɣarrabut. Ḏi ǧiȓeṯ nni war ymaren walu.<verse eid="JHN 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 21:4" />Wami iṣbaḥ ȓḥaȓ, ufin Ƹisa ibedd x cceṭṭ n ȓebḥar walakin imeḥḍaren war ṯ ƹqiȓen ca. <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />Inna-asen: "Ay iḥenjiren, ma ṯeymarem can iseȓman?"</para>
  <para style="p" vid="JHN 21:5">Nnan-as: "Lla, walu."<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />Inna-asen Ƹisa: "Seyybeṯ ṯracca x ufusi n ṯɣarrabut aḏ tafem iseȓman." Wami t seyyben war zemmaren atid jebḏen ȓaḥeqqac ṯƹemmar s iseȓman aṭṭas.<verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />Ameḥḍar nni iƹizzen x Ƹisa <char style="it">aṭṭas</char> inna-as i Buṭrus qa win ḏ Siḏiṯneɣ. Wami isȓa Simƹan Buṭrus qa win ḏ Ƹisa, ikkar yareḍ čammir nnes ȓaḥeqqac tuɣa ikkes-iṯ, ȓexddenni inḍew ḏi ȓebḥar <char style="it">bac aḏ iraḥ ɣar Ƹisa</char>. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />Walakin imeḥḍaren nni nneɣni iy kiḏes iǧan ḏfaren-ṯ-iḏ s ṯɣarrabut, jebbḏen-d ṯracca nni ṯeccur s iseȓman. War ggwijen ca x ȓbarr ɣir can miyyat mitru waha. <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />Wami d uwḍen ɣar ȓbarr, ufin ṯimessi n ȓefḥam xas iseȓman ḏ uɣrum.<verse eid="JHN 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 21:10" />Inna-asen Ƹisa: "Awim-d cwayt n iseȓman iy d ṯeymarem ȓexxu." <verse eid="JHN 21:10" /><verse number="11" style="v" sid="JHN 21:11" />Inya Simƹan Buṭrus ijbeḏ-d ṯracca nni ɣar ȓbarr, ḏayes miyya u ṯȓaṯa u xemsin n iseȓman ḏ imeqqranen. Qaƹ manaya, war ṯeqqares ca ṯracca nni.<verse eid="JHN 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 21:12" />Inna-asen Ƹisa: "Araḥem-d aḏ teccem." War izƹim uȓa ḏ ijjen zeg imeḥḍaren aṯ isseqsa, min ṯeƹniḏ cek? Ȓaḥeqqac ssnen qa ḏ Siḏiṯsen. <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />Iruḥ Ƹisa iysi-d aɣrum nni ḏ iseȓman nni ifreq-iṯen xasen. <verse eid="JHN 21:13" /><verse number="14" style="v" sid="JHN 21:14" />Ṯanita ḏ wis ṯeȓt marraṯ iy ḏi itmeḍhar-d Ƹisa i imeḥḍaren nnes zeg wami iy d ikkar zi ȓmewṯ.<verse eid="JHN 21:14" /></para>
  <para style="s">Siḏiṯneɣ Ƹisa isezƹam Simƹan Buṭrus</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />Wami reyyqen, inna-as Ƹisa i Simƹan Buṭrus: "A Simƹan a mmis n Yuḥanna, ma tḥibbiḏ-ayi ktar zi yina?"</para>
  <para style="p" vid="JHN 21:15">Inna-as Simƹan Buṭrus: "Wah a Siḏi, cek ṯessneḏ qa nec texseɣ-c."</para>
  <para style="p" vid="JHN 21:15">Inna-as Ƹisa: "Secc izmaren inu."<verse eid="JHN 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 21:16" />Inna-as Ƹisa wis marrṯayen: "A Simƹan a mmis n Yuḥanna, ma tḥibbiḏ-ayi?"</para>
  <para style="p" vid="JHN 21:16">Yenna-as Simƹan: "Wah a Siḏi, cek ṯessneḏ qa nec texseɣ-c."</para>
  <para style="p" vid="JHN 21:16">Inna-as Ƹisa: "Arwes iḥuȓiyen inu."<verse eid="JHN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 21:17" />Inna-as Ƹisa wis ṯeȓt marraṯ: "A Simƹan a mmis n Yuḥanna, ma texseḏ-ayi?"</para>
  <para style="p" vid="JHN 21:17">Iqqes-as ȓḥaȓ i Buṭrus ȓaḥeqqac inna-as-ṯ wis ṯeȓt marraṯ, cek ma texseḏ-ayi? Inna-as: "A Siḏi, cek ṯessneḏ kuȓci. Ṯessneḏ qa nec texseɣ-c."</para>
  <para style="p" vid="JHN 21:17">Inna-as Ƹisa: "Secc iḥuȓiyen inu.<verse eid="JHN 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 21:18" />Aqa tesȓiḏ ȓḥaqq: Ḏi ṯemẓi nnec tḥezzameḏ ixef nnec traḥeḏ mani ma ṯexseḏ. Walakin xmi ɣa ṯewsareḏ, aḏ tḍeȓqeḏ ifassen nnec ataf ḥadd nneɣni ac iḥezzem ac yawi mani war texseḏ ca." <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />Inna manayenni Ƹisa ḥima aḏ isbeyyen mamc ɣa immeṯ Buṭrus ḥima aḏ tmeḍhar lƹaḍama n Arebbi. Wami iy ḏas inna manayenni, inna-as: "Ḏfar-ayi-d."<verse eid="JHN 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />Ineqȓeb Buṭrus yufa iḏeffar-iṯen-d umeḥḍar nni iƹizzen x Ƹisa <char style="it">aṭṭas</char>, iƹni wenni tuɣa iqqimen ɣar uɣezḏis n Ƹisa ḏeg umensi nni inna-as: A Siḏi, min iƹna wenni c ɣa izzenzen? <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />Wami ṯ iẓra Buṭrus inna-as i Ƹisa: "A Siḏi, y win min ḏas ɣa iweqƹen?"<verse eid="JHN 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22" />Inna-as Ƹisa i Buṭrus: "Nec meȓa xseɣ win aḏ iddar aȓ ɣa d ḏewȓeɣ, war ḏac iruḥ bu ȓḥaȓ. Cek ḏfar-ayi-d!" <verse eid="JHN 21:22" /><verse number="23" style="v" sid="JHN 21:23" />Ssenni iffeɣ ȓexbar ɣar wawmaṯen qqaren: &lt;Ameḥḍar-a war itmetti ca.&gt; Walakin ḏ ṣṣaḥ Ƹisa war yinni ca belli ameḥḍar-a war itmetti ca. Min inna? Inna-t ammu: &lt;Nec meȓa xseɣ win aḏ iddar aȓ ɣa d ḏewȓeɣ, war ḏac iruḥ bu ȓḥaȓ.&gt; <verse eid="JHN 21:23" /><verse number="24" style="v" sid="JHN 21:24" />Ameḥḍar-a, min iƹna? Ḏ netta ig icehhḏen x ṯmesȓayin-a ṯumma yuri-ṯent. Neccin nessen qa chaḏeṯ nnes n ṣṣaḥ.<verse eid="JHN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />Aṭṭas n ṯmesȓayin nneɣni iy igga Ƹisa. Maƹlik ṯura kuȓ icten zzaysent ict-ict, ḥessbeɣ belli ataf ddunect-a marra war ṯzemmar aḏ teysi lkutub nni iy ɣa yarin.<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>