<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Ẹda</book>
  <para style="h">ỌMarkus</para>
  <para style="toc3">ỌMark</para>
  <para style="toc2">ọMarkus</para>
  <para style="toc1">Ihyuu Ishishi Ọzaa Ẹgọn Markus</para>
  <para style="mt2">Ihyuu Ishishi Ọzaa Ẹgọn</para>
  <para style="mt1">ỌMarkus</para>
  <para style="imt">Ọnkyẹ shin ọMarkus kon ẹhurẹ ọrẹn kẹ ọmẹ ọzaa</para>
  <para style="im">Ihyuu Ishishi Ọzaa Ẹgọn ỌMarkus tẹkpa lẹ ẹtọprẹ shin ẹnkọ “Ihyuu ishishi kọ kẹ aprẹ ọYẹsọ uKristi, Arẹn Ọnọm.” Ihyuu lẹn nyin ọYẹsọ kawan anushin a ywa kẹ ọmẹ ọtuan tuhuan kẹ so lẹ ọdọ. E shin ọdọ ghan kẹ ọmẹ ulolo ɡhan, kẹ ọdọ ghan kẹ aprẹn ọnsha, kẹ emle shin o ywuro ilovro ada wọ. ọYẹsọ too aprẹ ẹkyuẹ ghan kawan Arẹn Enyetri, anushin a ba kya wa man ọrẹ ghan kẹ eble ada kẹ ọmẹ ilovro.</para>
  <para style="ip">ỌMarkus too ihyuu ọYẹsọ kẹ ẹtẹtẹ, kẹ ọdọdọ wọ. Òó too aprẹ ọnkyẹ shin ọYẹsọ du lẹ iwe ẹlẹlẹ kẹ asrẹ emle shin òó too ọpiya onyun ọYẹsọ kẹ ulolo ghan. Le ọhurẹ ọpiya onyun kẹ aprẹ ọYohanna ana udu ọbaftisma kẹ umle ọnwọ ọYẹsọ la hyue wọ, ana ọrẹn la kpọn aprẹ ọtuan ọYẹsọ ọnwọ umee ọtrẹ kẹ ulolo ghan kẹ ẹladran. Lẹ aywuẹ kẹn mẹ, ana ure ọYẹsọ kan lẹ awa kpẹ ghan lakẹkan, tushin amuwa ófuwó ọYẹsọ tọ kẹn mẹ. Unso ọma ọplẹ too ọnkyẹ shin ọYẹsọ du kẹ ọmẹ aywuẹ otumpua ọplẹ ọywua ghan kẹ ohun, ọsẹsra ghan kẹ ọnyuọn nga kẹ itun. Ke aprẹ amplẹ ẹgbọ-ẹpuwa ọ ma ẹnkọ ihyuu ishishi, a kpọn shin eple enyi kẹ trẹtọ nga arẹn bọ ọMarkus wan.</para>
  <para style="iot">Ọnkyẹ shin arẹn kẹ ẹfọ wan kẹ ọmẹ ọzaa lẹn</para>
  <para style="io1">Ọtẹkpa ihyuu ishishi</para>
  <para style="io1">Ọtuan shin ọYẹsọ du kẹ ọGalili</para>
  <para style="io1">Ọkpọn kẹ ọGalili kan lẹ Urushẹlima</para>
  <para style="io1">Aywuẹ otumpua ọplẹ kẹ ọmẹ kẹ ayẹ Urushẹlima</para>
  <para style="io1">Ọnyuọn nga ọYẹsọ kẹ ọmẹ Itun</para>
  <para style="io1">Unyin ẹkyuẹ kẹ ọnya kan lẹ aprẹn ọnwọ ekye abaan shin a nyẹnya kẹ Itun</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s1">ọYohanna ana udu ọbaftisma sem ọntraan</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Ọtẹkpa ihyuu ishishi kẹ aprẹ ọYẹsọ uKristi, Arẹn Ọnọm kẹn.<verse eid="MRK 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 1:2" />Kawan emle shin a rẹn kẹ ọmẹ ọza onu Ishaya, Ọnọm too shin,</para>
  <para style="q1" vid="MRK 1:2">“Imi nii ọtuan atuwan mi kẹ a kpa kẹ ekye ngọ,</para>
  <para style="q2" vid="MRK 1:2">Kẹ oson e sem ngọ ọntraan.”<verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />Iwe alọ kon ọkẹn ẹkpa kẹ ifonum lẹ i too shin,</para>
  <para style="q1" vid="MRK 1:3">Unu sem ọntraan Ekye Abaan;</para>
  <para style="q2" vid="MRK 1:3">Kẹ unu la kẹ ẹtẹtẹ.<verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />ọYohanna ana ọbaftisma ba kẹ ọmẹ ifonum kẹ afrẹ utoo ada ihyuu ishishi, shin a kpa ilovro wan tuhuan kẹ odu wan ọbaftisma sablọ Ọnọm ywuro wan ilovro wan. <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Ada la pam bikẹ arẹn ashan ama ọYaudiya, kẹ ana ẹbọn Urushẹlima lẹ otro ba ọkọọn nga. A la kpa onyun ilovro wan tuhuan ọYohanna lẹ odu wan ọbaftisma kẹ ọmẹ igoo Urdun. <verse eid="MRK 1:5" /><verse number="6" style="v" sid="MRK 1:6" />ọYohanna shẹ ọnkyẹ shin o du lẹ unfu arahuọmẹ, tuhuan uloo lo ebre ghan lẹ iwe-asẹn ẹnyọ ẹtan, orudro kẹ ẹtọn yọ iso ọnkyẹ ọya ghan. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />O la otoo ada shin, “Eple enyi shin a srẹ mi nii oba kẹ ititim mi, anushin imi sẹ ọmẹ ugrum kẹ imi ble iwe ọkpla ghan man. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Imi odu unu ọbaftisma lẹ ambrẹ, tushin ẹnga nii udu unu ọbaftisma lẹ Iri-Ẹsẹẹ.” <figure style="fig" alt="John the Baptist proclaiming the truth" file="WA03809b.tif" size="col" ref="1:8" /><verse eid="MRK 1:8" /></para>
  <para style="s">Ọbaftisma kẹ umle shin o du ọYẹsọ</para>
  <para style="r">(<ref loc="LUK 3:21-22">ULuka 3:21-22</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Kẹ ọmẹ aywuẹ lan ọYẹsọ ba bin kẹ ọNazaret kẹ ọmẹ ẹbọn ọGalili. Tuhuan ọYohanna lẹ o du ghan ọbaftisma kẹ ọmẹ igoo Urdun. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />Ẹlẹn shin ọYẹsọ so kẹ ọnhuọ utro kẹ ọmẹ ambrẹ lan, e le shin aprẹmẹn kunmi, tuhuan iri lẹ e sri kẹ aprẹn nga kawan onloo. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />Iwe lẹ otro bin kẹ aprẹmẹn shin, “Ẹngọ arẹn mi nga, ẹmbiyan mi, ẹhurẹ mi hyuo la kẹnkan lẹ ẹngọ”.<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />Tuhuan Iri la sọ ghan uson kan lẹ ọmẹ ifonum kẹ ẹladran. <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />Uloo kon aywuẹ ẹhuẹnang kẹ ọmẹ ifonum kẹ ẹnam onum, Anatuwan ywua lẹ e mle ghan, átuwan Ọnọm tọ ywua lẹ okon aklọ lẹ ghan.<verse eid="MRK 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />Lẹ shin afrẹ ọYohanna kẹ a sọ ghan kẹ unko<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">Uhurhuhu</char></note>, ọYẹsọ la kpon kan lẹ ọGalili kẹ a frẹ utoo ihyuu ishishi ẹnkọ Ọnọm <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />Kẹ afrẹ utoo shin, “Ẹlẹn kẹ aba, Ẹgọn Ọnọm kyang kẹ akaaka. Unu kpa ilovro unu, kẹ unu ngrẹn ihyuu ishishi.” <figure style="fig" alt="John the Baptist Baptised Jesus" file="DN00410b.tif" size="col" loc="1:15" copy="Dunham" ref="1:15">ọYohanna du ọYẹsọ ọbaftisma</figure><verse eid="MRK 1:15" /></para>
  <para style="s">ọYẹsọ draa Apaduwan ghan amọ inzun</para>
  <para style="r">(<ref loc="LUK 4:14-15">ULuka 4:14-15</ref>; <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />ọYẹsọ so kẹ ọnhuọ ukpoon kẹ ayẹ ẹna ọGalili, e lẹ eshin ọSaminu kẹ ewedri ghan Andrawus kẹ ọnhuọ tlẹ ẹsaa kẹ ọmẹ ẹna, kẹ ọsablọ shin ẹma ana ọfẹn arẹvọn man. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />ọYẹsọ lẹ akọ ghan lẹ ẹma shin, “Unu re mi ma, tuhuan imi nii ulolo unu emle shin unu nii ọfẹn ada wọ.” <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />A lẹ a lẹlẹ ẹsaa wan kẹ ẹladran tuhuan kẹ ere ghan kan.<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />Àá sọ nya nga uson kan lẹ ananọ man, e le shin árẹn ọZebedi, ọYakubu kẹ ewedri ghan ọYohanna kẹ ọmẹ ọkpa-ambrẹ ke ọnhuọ ọtua ẹsaa wan. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />A la dra wan, kẹ ẹladran a la laa ekye wan ọZebedi kẹ ọmẹ ọkpa-ambrẹ kẹ eple ana ọtuan kẹ ere ghan kan.<verse eid="MRK 1:20" /></para>
  <para style="s">ọYẹsọ re iri ibibi</para>
  <para style="r">(<ref loc="LUK 4:31-37">ULuka 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />A nya a la kpoon kan wan lẹ ọKafarnahum, a kẹ a ba ubon utrim aYahudawa, ọYẹsọ la nyẹran kan ghan lẹ ọmẹ unko ọpẹlọnọm kẹ ọnhuọ ulolo. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />Anushin a kọọn nga le e shin ọvrọ sablọ emle shin oso kẹ ọnhuọ ulolo wọ lẹ ẹhurẹ ẹdọ, kẹ sablọ shin o so ghan kẹ ọnhuọ ulolo kawan avua ulolo iywuro wan.<verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />Kẹ ẹladran eple enkyi shin iri ibibi nyẹran nga kẹ ọmẹ unko ọpẹlọnọm man, la shẹ ẹkpa wọ. <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />“Unse wan ẹngọ nii lẹ enyi ọYẹsọ ana ọNazaret?” Ẹngọ a ba ọpẹ enyi? Imi za ngọ, Ẹngọ Ana Ẹsẹẹ lan nga, enyi Ọnọm.<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />ọYẹsọ lẹ a gọ lẹ iri ibibi lan, kẹ a kọ ghan lẹ ẹnga shin, “Fuwa! Tro kẹ ọmẹ enekyi lẹn”. <verse eid="MRK 1:25" /><verse number="26" style="v" sid="MRK 1:26" />Iri ibibi lan na frẹ enekyi lan kẹ a nẹghẹn ghan, tuhuan kẹ ashẹ ẹkpa wọ kẹ oroo ghan kẹ ọmẹ nga.<verse eid="MRK 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 1:27" />Ada la e shin ọvrọ tuhuan kẹ afrẹ u luwe eple shin, “Unse wẹn nẹ? Uple ulolo ọprọpra wẹn nẹ kẹ ẹgẹgọn? Kẹ ididu ọnkyẹ shin òó too wan iri ibibi kẹ odu.” <verse eid="MRK 1:27" /><verse number="28" style="v" sid="MRK 1:28" />Kẹ ẹladran, ihyuu kẹ aprẹ ọnkyẹ shin òó du la hurẹ huo ulon ọnhuọ ghan wọ kẹ ọmẹ ẹbọn ọGalili.<verse eid="MRK 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Lẹ ọshin ọYẹsọ huọ utro kẹ ọmẹ unko ọpẹlọnọm kẹ Apaduwan nga, ọYakubu kẹ ọYohanna tọ uso kẹ ẹnga, a la nyẹran ọmẹ abaan ọSaminu man kẹ Andrawus.<verse eid="MRK 1:29" /></para>
  <para style="s">ọYẹsọ ma ana ọmpam ọtrẹ</para>
  <para style="r">(<ref loc="LUK 4:38-41">ULuka 4:38-41</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 1:30" />Àzẹn-anshẹ ọSaminu la nẹnẹn lẹ ushin iloo frẹ ghan, o lẹ otoo ọYẹsọ kẹ ẹladran. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />A la kan lẹ ọnhuọ ywa ghan kẹ afrẹ ghan kẹ ọnyẹ kẹ nywuọ nga. Iloo lan la laa ghan, a la nyẹnya kẹ e me wan aya.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />A kyan unii ẹbra, Ọnọm ọsan tọ huọ nyẹran wọ, a la o kon ididu oloo wan kẹ ana uloo ọnsha ba lẹ ọnhuọ ọYẹsọ. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Ẹshan lẹ ididu la klan kẹ onyun atigha abaan na. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Tuhuan ọYẹsọ la ma ana ọnpam shin o so lẹ iloo kẹ itite ọtrẹ. Tuhuan kẹ ewili ọnsha la pam kẹ ọmẹ ẹɡbẹna ma, bọ a lẹ á laa ọnsha ọpẹ wan, kẹ ọsablọ shin a za ghan.<verse eid="MRK 1:34" /></para>
  <para style="s">ọYẹsọ too ihyuu kẹ ọGalili</para>
  <para style="r">(<ref loc="LUK 4:42-44">ULuka 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />A la kẹ aba ọsha ombun, ọnhuọ tọ hyu itum, ọYẹsọ la nyẹnya kan lẹ ọnhuọ shin alọ so ghan ma, kan ọpẹlọnọm. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />ỌSaminu kẹ onuse ọtuan nga la otro kan oson enii nga. <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />A la huọ ushin nga, a la kọ wan lẹ nga shin “Ididu ada kon unii ngọ.”<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />ọYẹsọ le kye wan shin, “Enyi ma oson kan wan lẹ eple arẹn ashan akaka kẹ imi son otoo wan ihyuu ishishi. Kẹ ọnkyẹ shin ọsọ imi a ba wlan.” <verse eid="MRK 1:38" /><verse number="39" style="v" sid="MRK 1:39" />Tuhuan ọYẹsọ lẹ kle ididu ọGalili kẹ o son otoo ihyuu ishishi kẹ uson ewili ọnsha kẹ ọmẹ onkoo ọpẹlọnọm kẹ ọmẹ ashan ọGalili.<verse eid="MRK 1:39" /></para>
  <para style="s">ọYẹsọ ma ana umbli ọtrẹ</para>
  <para style="r">(<ref loc="LUK 5:12-16">ULuka 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Eple ana umbli la wa eshe ongbun kẹ a wan ọYẹsọ shin, “Inshin ẹngọ a biyan ẹngọ tọ a ma imi ọtrẹ.”<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />ọYẹsọ la nya ọkọọn ghan kẹ emremrin, à la laa ọnyẹ kẹ apiya ghan tuhuan kẹ a kọ ghan lẹ ẹnga shin, “Imi a biyan ba la dẹdẹi” <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Kẹ ẹladran, umbli lan la laa ghan, ala ba atrẹ.<verse eid="MRK 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 1:43" />ọYẹsọ la sọ ghan kẹ ọntran kẹ ẹladran tuhuan kẹ a la ghan ẹrẹnyẹ. <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />“Ngẹn atọn, kalẹ ngọ too alọ ọnlẹghẹ wan. Tushin son enyin ẹkyuẹ ngọ kẹ ọnhuọ akpẹ ọma enshin kẹ ẹngọ ma enshin emle shin iywuro uMusa too wọ, kẹ ọtrẹkyuẹ kẹ ọdẹdẹy shin ẹngọ okon sablọ ada kpẹ.” <verse eid="MRK 1:44" /><verse number="45" style="v" sid="MRK 1:45" />O lẹ okpon kẹ afrẹ uson apiya onyun lẹ otoo ihyuu. Ọ la sọ shin ọYẹsọ kẹ a tọ nyẹran nga ẹshan ọnhuọ tọ usoo ọsẹẹ wan, aa kẹ okpon kan ghan lẹ ọnhuọ shin alọ so ghan wọ ma. Tushin ada la frẹ uson ọnhuọ ywua ghan bi kẹ huo ulon ọnhuọ ghan wọ.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">ọYẹsọ ma anushin ẹgbẹna ghan hyuọm ya ọtrẹ</para>
  <para style="r">(<ref loc="LUK 5:17-26">ULuka 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Aywue la hyue kpon, ọYẹsọ la nyẹran ọKafarnahum, ada la kọn shin a ba lẹ ọmẹ abaan. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />A la klan la pam apra la laa wan kẹ ọmẹ onko kẹ atigha, a la frẹ utoo wan aprẹ Ọnọm <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Eple ekyii la ba, a tọ ukọn eple anushin ẹgbẹna nga hyuọm ya, ananang ma o tọ ukon ghan. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Lẹ ọshin emele wan ọ kpọn ghan kan lẹ ọnhuọ ọYẹsọ wan, sablọ ẹrẹn ada, a la wla usuo<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">UTRU</char></note> kẹ ọnhuọ shin ọYẹsọ so wọ, kẹ osro ghan a tọ nẹn kẹ aprẹn ọkya ghan ba lẹ ẹbọn ọnhuọ ọYẹsọ so wọ. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />ọYẹsọ shin ọdọ ẹhurẹ wan, a la kọn ghan lẹ oloo lan shin, “Arẹn mi, ó ywuro ngọ ilovro ngọ.”<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />Tuhuan eple ávuwa ulolo iywuro shin a trẹtra kẹ ọnhuọ lan la rẹn ẹhurẹ wan shin, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“Unse wan ọsọ enkyi lẹn kon ọpiya onyun kẹn? O kon utoo aprẹ Ọnọm kẹ ẹtrẹtrẹ! Ẹnga nga o so lẹ ọdọ uywurọ ilovro? Sẹ Ọnọm kẹ izun ghan”<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />Kẹ ẹladran ọYẹsọ lẹ akpẹ ọnkyẹ shin o kon ọrẹn lẹ ẹhurẹ wan, a lẹ a kọ lẹ ẹma shin, “Unse wan ọsọ ẹhurẹ unu kon rẹn ute ọnkyẹ lẹn? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />Ulon nga wọ ọsrẹ lẹ ọkọka: o too enkyi shin ẹgbẹna nga hyuọm ya lẹn shin, ‘Ó ywuro ngọ ilovro ngọ,’ huo a kọ wan shin, ‘nyẹnya, kpọn ọkya ngọ kẹ ngọ son kan ngọ?’ <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Tushin imi nii shin unu za shin Arẹn Enyetri so lẹ ọdọ uywuro ilovro kẹ ọmẹ ohun.” A la kọ ghan lẹ enkyi lan shin, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />“I mi shin lẹ ngọ shin, nyẹnya, kpọn ọkya ngọ kẹ ẹngọ son kan ngọ lẹ ọmẹ shan.” <verse eid="MRK 2:11" /><verse number="12" style="v" sid="MRK 2:12" />A la nyẹnya kẹ ẹladran, kẹ a kpọn ọkya ghan kẹ roo ghan kẹ ọmẹ man, ididu anushin o so kẹ ọnhuọ lan lẹ e shin ọvrọ tuhuan a la dọọ Ọnọm, kẹ a kọ wan shin “Enyi so ushin wan ọnlẹghẹ kẹn ma!”<verse eid="MRK 2:12" /></para>
  <para style="s">ọYẹsọ draa ọLawi</para>
  <para style="r">(<ref loc="LUK 5:27-32">ULuka 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />ọYẹsọ lẹ kpon kan lẹ ayẹ Ẹna. Ada la pam la ba lẹ ọnhuọ ywa ghan, a la frẹ ulolo wan. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Aa kyan ukpon e lẹ eshin ọLawi arẹn ọHalfa trẹtra kẹ ọnhuọ ọnga ikli egen. ọYẹsọ lẹ a kọ ghan lẹ ẹnga shin “re mi man,” ọLawi la nyẹnya kẹ re ghan kan.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />Kẹ uple ubun ọYẹsọ so kẹ ọnhuọ ọya ọnkyẹ ọya anlẹ kẹ ọmẹ abaan ọLawi, éplé ana ọngan unkli egen kẹ eple ana ilovro lanpam so kẹ ọnhuọ ọya ọnkyẹ ọya lan kẹ ẹnga kẹ Apaduwan nga, sablọ ada lanpam le oson e re ghan kan. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />Lẹ shin ávuwa ulolo iywuro amọ aFarisiyawa shin okon ọya ọnkyẹ ọya kẹ ana ilovro kẹ ana ọngan unkli egen, e le luwe Apaduwan nga shin; “Unse wan ọsọ o so kẹ ọnhuọ ọya ọnkyẹ ọya kẹ ana ọngan unkli egen kẹ ana ilovro?”<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />ọYẹsọ huọ kọn klan, a la kọ ghan lẹ ẹma shin, “Kyẹ ana atrẹ wa e kẹ enii avuwa wan, sẹ oloo. I mi a ba mi sablọ ana utighe iywuro Ọnọm ma sẹ ana ilovro.”<verse eid="MRK 2:17" /></para>
  <para style="s">E luwe ọYẹsọ aprẹ ukon ọhyuọ</para>
  <para style="r">(<ref loc="LUK 5:33-39">ULuka 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Tushin apaduwan ọYohanna kẹ aFarisiyawa so kẹ ọnhuọ ukon ọhyuọ, eple enyi ma la ba kẹ a wa luwe ọYẹsọ shin, “Unse wan ọsọ apaduwan ọYohanna kẹ ama aFarisiyawa kẹ okon ọhyuọ, Tushin ama ngọ kẹ okon wan ma?”<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />ọYẹsọ la kọ ghan lẹ ẹma shin “Osoon enkyi-apra nii ukon ọhyuọ a tọ uso kẹ ẹma? Kayi, e nii ma ukon ọhyuọ ekyi-apra tọ uso kẹ ẹma ma. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Tushin ubon nga kyan shin e nii kpọn ekye abaan anshẹ apra lan kẹ ọmẹ man kẹ a nya wan wọ, ẹladran ya wọ enii ọkpọn ọhyuọ wọ.<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />“Bọ anushin a lẹ otraa ukpo omosu akakrọ lẹ ẹtapẹ unzen ẹprẹpra wan, inshin shin uloo du klan, ẹprẹpra lan nii uwo ẹkrẹkrọ lan kẹ igre lẹ a kẹnkan. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />Tuhuan anushin eshe orun okpoo aprapra kẹ ọmẹ imbon ẹkrẹkrọ, orun okpoo lan nii ọzọn imbon lan wọ, tuhuan kẹ okon wan ọnkyẹ lan kẹ ọnpua wan, imbon lan kẹ orun okpoo lan. Orun okpoo aprapra nii imbon ẹprẹpra.”<verse eid="MRK 2:22" /></para>
  <para style="s">Aprẹẹ aywuẹ utrim</para>
  <para style="r">(<ref loc="LUK 6:1-5">ULuka 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Kẹ uple ubun aywuẹ utrim aYahudawa, ọYẹsọ kẹ apaduwan ghan kyan ukpon kẹ ọmẹ onum aya, o so kẹ ọnhuọ ukpon, apaduwan ghan lẹ afrẹ ọfọn akyuẹ aya lan. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />AFarisiyawa la kọ wan lẹ ẹnga shin, “Shin, unse wan ọsọ o so kẹ ọnhuọ udu ọnkyẹ shin iywuro re kẹ aywuẹ utrim aYahudawa?”<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />A la kọ ghan lẹ ẹma shin “Unu so ọnyan ọpua ọnkyẹ shin ọDawuda du lẹ shin ẹwọn ma ghan kẹ onuse uson ghan bọ o so lẹ ọlẹghẹ wan? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />Emle shin a nyẹran ọmẹ unko ọpẹlọnọm kẹ aywuẹ shin Abiyata so akpẹ ọma-enshin, a la nyẹran ọmẹ unko Ọnọm kẹ a ya ubredi shin iywuro re ada ọya lẹn sẹ ana ume enshin lehule, tuhuan a la huọ ma onuse uson nga ma?”<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />Tuhuan a la kọ ghan lẹ ẹma shin, “O du ubon utrim sablọ enyètri wọ, o du wan enyetri sablọ ubon utrim ma. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />Ọnwọ ọsọ Arẹn Enyètri ghan o so Ekye abaan ubon utrim.”<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">ọYẹsọ ma ọtrẹ kẹ ubon utrim</para>
  <para style="r">(<ref loc="LUK 6:6-11">ULuka 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />ọYẹsọ lẹ ywure kan lẹ ọmẹ unko ọpẹlọnọm, eple enkyi shin ọnyẹ nga hyuẹm wọ tọ uso kẹ ọnhuọ lan. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Eple enyi ma kẹ ọmẹ ma lẹ afrẹ ọkam ọYẹsọ, kẹ asọ ghan edre kyẹ ushi huo a lẹ ọma ghan ọtrẹ kẹ Aywuẹ Utrim lẹn. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />ọYẹsọ la kọ lẹ enkyi lan shin, “Nyẹnya kẹ ngọ tro ba ngọ lẹ ẹnpakye ada.”<verse eid="MRK 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 3:4" />A la kọ ghan lẹ ẹma shin, ọgbaa shin odu ọnlẹghẹ ọgyagyuwan huọ tọ ububi kẹ ubon utrim dẹn, Ofuo ọrẹ ta tọ aprẹ ọrẹ dẹn? Tushin a la ngrẹn lẹ atọ.<verse eid="MRK 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 3:5" />Lẹ shin e kyem kẹ e shii wan lẹ amuwa kẹ ọmẹ ambẹn ẹhurẹ sablọ ẹhurẹ ẹtrẹ wan, a la kọ ghan lẹ enkyi lan shin “laa ọnyẹ ngọ.” A la laa ọnyẹ ghan ọ la ba ọtrẹ kẹ ẹladran. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />Lẹ shin aFarisiyawa lan o tro, kẹ ẹladran a la klan akyuẹ kẹ ana Iridus kẹ ọtra ẹkyuẹ kẹ ọYẹsọ emle shin ẹma nii ọprẹ ghan.<verse eid="MRK 3:6" /></para>
  <para style="s">Idri ada re ọYẹsọ kan lẹ Ẹna ọGalili</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Ọnwọ ọYẹsọ kẹ apaduwan nga la nya wan kan lẹ ayẹ ẹna ọGalili, idri ada lẹ re ghan kan bi kẹ ọGalili kẹ ẹbọn ọYahudiya. <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />Ididu ekyi wanẹ re ghan kan sablọ shin a kọn ihyuu ọnkyẹ shin o so kẹ ọnhuọ udu, eple enyi ma bi kẹ Urushẹlima, kẹ ẹbọn Idomiya, kẹ use ẹbọn igoo Urdun kẹ use ọTaya kẹ ọSidon. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />Sablọ shin o ton ghan shin kalẹ ẹrẹn ada lan maa ghan la kẹnkan ma, a la kọ ghan lẹ apaduwan ghan shin e nii ghan ọkpa ambrẹ ọhyuẹ wọ <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />Àá ma ada la pam ọtrẹ ọnwọ shin ana ìloo a la frẹ uzere mi kan lẹ nga sablọ enii ọpiya ghan. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Huọ ẹlẹlẹn ya ọnsha shii ghan, u nii kple kẹ ẹnpakye ghan lẹ a ọta akpa lẹ a kọ wan shin, “Ẹngọ Arẹn Ọnọm nga.” <verse eid="MRK 3:11" /><verse number="12" style="v" sid="MRK 3:12" />Tushin a la la wan ẹrẹnyẹ shin kalẹ o too ada huọ ẹnga nga oso ẹnga ma.<verse eid="MRK 3:12" /></para>
  <para style="s">ọYẹsọ we arẹn ọtuan ọkọ lẹ apuwa</para>
  <para style="r">(<ref loc="LUK 6:12-16">ULuka 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />ọYẹsọ nyan kan lẹ aprẹn ukrun, kẹ adra anushin ẹnga nii, a la kan okon ghan. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />A la e we ana ọkọ lẹ apuwa kẹ a ywa kẹ nga kẹ ẹnga kẹ kon lẹ a tuan ma utoo ihyuu ishishi, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />tuhuan kẹ o kon ọdọ uwuli ọnsha. <verse eid="MRK 3:15" /><verse number="16" style="v" sid="MRK 3:16" />Ana ọkọ lẹ apuwa shin e we mẹn: ọSaminu (anushin ọYẹsọ ma ghan ọntua shin uBitrus), <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />kẹ ọYakubu kẹ ewedri ghan ọYohanna árẹn ọZebedi (a ma wan ọntua shin uBuwarnajis, arẹn Ẹraprẹn). <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />A la huọ uwe Andrawus kẹ uFilibus, ọBartalamawas kẹ ọMatiyu, uToma kẹ ọYakubu arẹn ọHalfa, ọTadiyọ kẹ ọSaminu ana ọKaˈana. <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />kẹ a kpọn ọYauza anushin a man ọYẹsọ.<verse eid="MRK 3:19" /></para>
  <para style="s">ọYẹsọ kẹ agọn ọnsha</para>
  <para style="r">(<ref loc="LUK 11:14-23">ULuka 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />ọYẹsọ nyẹran ọmẹ eple abaan, ada lẹ eywure kẹ a klan ọ la sọ shin o kon wan apra ọya ọnkyẹ ọya wan. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Lẹ shin ana ọmẹ abaan nga kọn kẹn, a la kan kọ ọfrẹ ghan, sablọ ẹma shin “Ẹkyuẹ ghan kye kọ.”<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />Eple ávuwa iywuro shin a ba bi kẹ Urushẹlima la kọ wan shin, ọBa'azabul<note caller="+" style="f"><char style="fr" closed="false">3:22 </char><char style="ft" closed="false">Uple ọntua agọn ọnsha wọ uso ọBa'azabul.</char></note> nga nyẹran nga, okon uwuli ọnsha le ọdọ agọn ọnsha.<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />Ọnwọ ọYẹsọ la dra wan, kẹ a ma wan ẹtọprẹ shin, “Kyẹ emle shin Anatuwan tọ ere Anatuwan wọ? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />Inshin ẹgọn plaam kẹ ọtra ẹkyuẹ kẹ ifuwo kẹ a huẹn kẹ iple i nii kọ tigha wan. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />Inshin abaan plaam kẹ ọtra ẹkyuẹ kẹ ifuwo tuhuan kẹ a huẹn kẹ eple e nii kọ ọtigha wan. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Ọklan wọ shin Anatuwan nyan ọhuẹn kẹ ẹkyuẹ ghan ke a plaam, ẹgọn nga nii kọ ọtigha wan, ọplẹ ghan wọ ọba lan. <verse eid="MRK 3:26" /><verse number="27" style="v" sid="MRK 3:27" />Lẹ ẹplẹpan, bọ anushin e tọ emle ọnyẹran ọmẹ abaan ana andọ kẹ a mẹn nga ọnkyẹ wan sẹ a zrọ frẹ ghan kẹ o loo, tuhuan kẹ a tọ anyẹran kẹ a mẹn ọnkyẹ ghan. <verse eid="MRK 3:27" /><verse number="28" style="v" sid="MRK 3:28" />Ẹplẹpan ya imi kyẹ utoon, a tọ ywuro ada huọ usọgbute ilovro shin o du, kẹ utoo aprẹ Ọnọm kẹ ẹtrẹtrẹ!<note caller="+" style="f"><char style="fr" closed="false">3:28 </char><char style="ft" closed="false">Uto aprẹ Ọnọm kẹ ẹtrẹtrẹ ọnwọ uso ọtua Ọnọm</char></note> <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />Tushin, ididu anushin o du Iri Ẹsẹẹ ilovro, e nii ma uywuro ilovro ghan ma, uvro ghan so wọ lẹ igbo wan”<verse eid="MRK 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 3:30" />ọYẹsọ too kẹn sablọ shin eple enyi ma kon utoo shin ẹnga so lẹ ọnsha kẹ ọmẹ nga.<verse eid="MRK 3:30" /></para>
  <para style="s">Ẹya ọYẹsọ kẹ éwedri ghan</para>
  <para style="r">(<ref loc="LUK 8:19-21">ULuka 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Ọklan wọ, iye ubiyon ghan kẹ éwedri ghan lẹ a ba. A la tigha kẹ ibetin, kẹ atuwan shin adra ghan ma. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Idri ada lẹ e kee ghan kan, tuhuan a lẹ a kọ wan lẹ ẹnga shin, “iye ubiyon ngọ kẹ éwedri ngọ nii ushin ngọ kẹ etin.”<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />E lẹ e kye kẹ a kọ ghan lẹ ẹma shin “Ẹnga nga o so iye ubiyon mi kẹ éwedri mi?”<verse eid="MRK 3:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 3:34" />E lẹ e kyem ke shin anushin a trẹtra kẹ e kee ghan kan, a lẹ a kọ ghan lẹ ẹma shin “Iye ubiyon mi kẹ éwedri mi mẹn! <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Anushin o du ọnkyẹ shin Ọnọm nii, a nga oso ewedri mi, a nga oso afuwọ mi, kẹ iye ubiyon mi.”<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">Ẹsẹn kẹ aprẹ ana utruwe</para>
  <para style="r">(<ref loc="LUK 8:4-8">ULuka 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />ọYẹsọ so kẹ ayẹ ẹna a lẹ afrẹ ulolo ada aprẹ Ọnọm lẹ ẹsẹn. Ẹrẹn ada la klan la pam ọnwọ ọsọ à la nyẹran kan ghan lẹ ọmẹ ọkpa ambrẹ kẹ a trẹtra, tushin ada so kẹ aprẹn ọngbavran. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />O lolo wan ọnkyẹ la pam lẹ ẹsẹn, tuhuan kẹ ọmẹ ulolo ghan a la kọ ghan shin: <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />“Unu ngẹn atọn! Ana uroo lẹ otro kan utruwe ẹywua ghan. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />O so kẹ ọnhuọ ọkaa ẹywua, iple lẹ ekple kẹ ọntran, arọnọ lẹ ba ka wa ya yọ. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Iple lẹ ekple kẹ ọmẹ apan, ọnhuọ shin uso wọ lẹ ẹbọn ma. I le ekyem kẹ atra sablọ ẹbọn so kọ la ampam ma. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />Tushin ẹlẹn ọnọm ọsaan sam kọ, a ya lan la hura yọ sablọ shin a so yọ la anaa ma. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Iple ẹywua lẹ ekplẹ kẹ ọmẹ akẹn, lẹ shin ẹ fuwọ akẹn la maa yọ, a la sọ yọ ẹrẹn ma. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Tushin iple ẹywua la kple kẹ aprẹn ẹbọn agyagyuwan, ẹ la tra, kẹ a fuwọ tuhuan kẹ sọ ẹrẹn la ampam, iple lẹ a trọ ẹrẹn ẹhuẹ ẹtẹtẹlẹ, iple ẹhuẹ ikyikyen, iple kẹ sọ ataatẹlẹ ọnkyẹ shin etruwe.”<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />Tuhuan ọYẹsọ la kọ ghan shin, “Anushin o so lẹ atọn kọn, ana kọn.” <figure style="fig" alt="Story about a sower who plant his seeds" file="DN00470b.tif" size="col" loc="4:9" copy="Dunham" ref="4:9">Ana Utruwe</figure><verse eid="MRK 4:9" /></para>
  <para style="s">Ẹkyuẹ ẹsẹn lan yẹn</para>
  <para style="r">(<ref loc="LUK 8:9-10">ULuka 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Ẹlẹn shin a ywa kẹ izun ghan, ana ọkọ lẹ apua lan kẹ eple enyi ma shin e le kee ghan lẹ luwe ghan shin otoo wan ẹkpẹkprẹ ẹ́sẹn lan. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />A la kọ ghan lẹ ẹma shin, “Ọnọm ma unu ọza ẹgọn ghan, tushin anushin o so wan kọ ọmẹ ma huọ unse wan a kẹ o too wan kẹ ọmẹ ẹ́sẹn. <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />Ọklan wọ, ‘Huọ okon u kẹ eshin e nii ma ọkpẹ ọnkyẹ shin ẹma shin ma, tuhuan a lẹ ọkọọn ba e nii okpẹ wan; sablọ kalẹ a kpa kẹ o ywuro wan ilovro wan ma!’ ”<verse eid="MRK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Tuhuan ọYẹsọ la kọ ghan lẹ ma shin, “Unu akpẹ unu ẹkyuẹ ẹsẹn lẹ ma? Kyẹ emle shin unu nii ọkpẹ eple ẹsẹn wọ? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Ana uroo kẹ e truwẹ aprẹ Ọnọm. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Ẹywua shin ikple kẹ ayẹ ọntraan lan so kuan eple enyi ma shin a kọn aprẹ Ọnọm. Tushin a huọ kọn, Ana-atuwan la ba kẹ wa akpọn aprẹ Ọnọm shin etruwe kẹ ọmẹ ma. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Eple enyi ma so ka wan ẹywua shin etruwẹ kẹ ọmẹ apan, a kẹ akọn aprẹ Ọnọm, kẹ a ngrẹn kẹladran lẹ ẹ́hurẹ ishishii. <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />Tushin o so wan lẹ anaa ma sablọ shin aprẹ lan nyẹran yọ ẹma ma. Ẹlẹn shin ebebi ba wan sablọ aprẹ lan, a la kpaa kẹladran. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Eple enyi ma so kawan ẹywua shin etruwe kẹ ọmẹ akẹn, a ma o so anushin a kọn aprẹ lan; <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />tushin anbẹn ẹhurẹ ọywua ohun, ọbiyan ukon kẹ ọbiyan uple ọnkyẹ ohun laa wan aprẹ lan ọma ẹkra wan. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />Eple enyi man so kawan ẹywua shin etruwẹ kẹ ẹbọ agyagyuwan, a kọn aprẹ lan kẹ ngrẹ yọ, tuhuan kẹ trim, iple ẹhuẹ ẹtẹtẹlẹ, iple ẹhuẹ ikyikyẹn, iple kẹ a sọ ataatẹlẹ onkyẹ shin etruwẹ.”<verse eid="MRK 4:20" /></para>
  <para style="s">Ẹsẹn kẹ aprẹ ọtrẹmọ</para>
  <para style="r">(<ref loc="LUK 8:16-18">ULuka 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />A la kọ ghan lẹ ẹma shin, “A kẹ otro ọla kẹ ọtrẹmọ kẹ afra kan lẹ ẹnzẹn huọ ọmẹ ọfọn intru? A ka tra wan kẹ ọnhuọ ọywua wọ wan? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />Bọ ọnkyẹ shin eye shin unii ma utro etiin ma, tuhuan ididu ọmprẹ-uyiye<note caller="+" style="f"><char style="fr" closed="false">4:22 </char><char style="ft" closed="false">Ọmprẹ-uyiye ma uso ọnkyẹ shin eye shin enii man alo kpẹ wan.</char></note> nii utrọ etiin. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Anushin o so lẹ atọn ọkọọn, lẹ a kọn.”<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />E lẹ ywure kẹ o too wan shin “Unu ngẹn atọn lẹ ọnkyẹ shin unu akọn.” “Ọnkyẹ shin unu mle wọ, ọma enii umle unu kẹ a sọ ẹntraa wọ. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />Ididu anushin o so lẹ ọnlẹghẹ enii ọma ghan la pam; tuhuan anushin o so ghan lẹ ọnlẹghẹ wan, unkyẹ shin oso lẹ ọma enii ọkraa lẹ ẹnga.”<verse eid="MRK 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />E lẹ eywure kẹ a ọkọ ghan shin, “Egọn Ọnọm so kawan enkyi shin a kaa ẹywua kẹ onum ghan. <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />Otu kẹ aywuẹ, ẹywua lan la tra kẹ afuwọ, bọ a za emle ghan ma. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Ẹbọn kẹ ẹkyuẹ-kyuẹ kọ la sọ aya ọma akyuẹ; ọtekpa lẹ itrin lẹn tuhuan akyuẹ lẹn, tuhuan ẹrẹn nẹ kẹ ọmẹ akyuẹ lẹn. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />Lẹ shin aya lan huọ ọba, a la afrẹ ọwaa lẹ elijom, sablọ ẹlẹn ọwaa aya huọ ọba.”<verse eid="MRK 4:29" /></para>
  <para style="s">Ẹsẹn kẹ aprẹ ẹrẹn Ọmọsta</para>
  <para style="r">(<ref loc="LUK 13:18-19">ULuka 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />E lẹ ywure kẹ o too wan shin, “Unse wan enyi tẹ ọguwan ẹgọn Ọnọm kọ, huọ ilon ẹsẹn ya enyi tẹ umle kọ? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />I so kawan ẹrẹn ọmọsta, shin ẹsrẹ lẹ ọkpahyurẹ kẹ ọmẹ ẹywua ohun. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />Tushin inshin etruwe, i nii ọfuwọ kẹ ikye ekyi shin ẹsrẹ lẹ ọlọlẹ kẹ ọmẹ upi lan, i kẹ odu angaan adradọ shin e kẹ ekye ọnhuọ shin arọnọ kẹ odu antrọn ma wọ.”<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />ọYẹsọ lolo wan aprẹ Ọnọm lẹ ẹ́sẹn lẹ ampam, tuhuan kẹ ololo wan emle shin e nii ọkpẹ wọ. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />O kẹ otoo ghan ẹma ọnlẹghẹ bọ ẹsẹn ma. Tushin ẹlẹn shin a ywa kẹ izun ghan kẹ apaduwan nga, a lẹ o too wan ẹkpẹkprẹ huọ unse wan.<verse eid="MRK 4:34" /></para>
  <para style="s">ọYẹsọ sọ esembi lẹ angrẹn lẹ atọ.</para>
  <para style="r">(<ref loc="LUK 8:22-25">ULuka 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Kẹ ublan lẹ shin ọnhuọ hurẹ ọba anlẹ, a lẹ kọ ghan lẹ apaduwan ghan shin, “enyi ma kpẹn kan wan lẹ ọnwa ọgase” <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />A laa idri ada, kẹ okpon kan wan kẹ nga, a tọ uso kẹ ọmẹ ọkpa ambrẹ iplẹ ẹkpa huọ uson kẹ ẹma. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Ure ẹvra kẹ urun ọdọ la nya kẹ eywi ambrẹ lẹ akẹn ọkpa lan, ambrẹ la nyẹran ọmẹ ọkpa, ọkpa lan la kyẹ ọkpaa ẹmrẹ. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />ọYẹsọ so kẹ ititim ọkpa lan kẹ ọnhuọ ọnọna ghan. Apaduwan la nyọn nga kẹ a kọ wan lẹ ghan shin, “Avuwa, ngọ nii shin ambrẹ ya enyi?”<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />A la nyẹnya kẹ la urun ọdọ lan ẹrẹnyẹ kẹ otoo ambrẹ lan shin “tigha lẹ atọ”, urun ọdọ lan la tigha ka ngrẹn lẹ atọ.<verse eid="MRK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 4:40" />A la kọ ghan lẹ apaduwan nga shin, “Unsẹ wan ọsọ unu kọn ibu? Unu so unu lẹ ọdọ ẹhurẹ wan ba lẹ ẹladẹn?”<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />Eji la kpa wan e le eluwẹ eple shin, “Ẹnga nghẹn? urun ọdọ kẹ ambrẹ ka ngẹn nga atọn.”<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">ọYẹsọ ma eple enkyi shin Ọnsha nyeran nga ọtrẹ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />ọYẹsọ kẹ apaduwan nga lẹ a kpẹn ẹna ọGalili kan lẹ ọga ẹbọn ọGarasa. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Lẹ shin a huọ utro kẹ ọmen Ọkpa, eple enkyi shin oso lẹ ọnsha lẹ otro bin kẹ ọmẹ itun kẹ a wa okon ghan. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />Enkyi lẹn, ọmẹ itun wọ uso ọnhuọ ywa ghan. Ba anushin emle uloo ghan, huọ ọ sọ ghan kẹ iwe ọyẹra wan. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />A hyua ọkẹ a ulolo nga lẹ iwe ọyẹra kẹ a fran kẹ anyẹn, tushin a kẹ tẹn iwe ọyẹra lan. Ba anushin oso adọ umle traa ghan ma. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Otu kẹ aywuẹ ọmẹ itun wọ uso ọnhuọ ywa ghan, kẹ aprẹn apan, tuhuan a kẹ ata ẹkpa lẹ a traa ẹgbẹna ghan lẹ ọntrẹtra.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />Lẹ shin ee shin ọYẹsọ bin kẹ ananọ, e le titon kẹ a kẹ eshe ogbun kẹ ẹnpakye ghan. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />A lẹ a shẹ ẹkpaw lẹ ọdọ kẹ akọ ghan shin, “Unse wa ẹngọ nii lẹ imi, ọYẹsọ, Arẹn Agọn Ọnọm shin amẹ Ọdọọ. Tre lẹ Ọnọm shin ẹngọ nii ngọ ma mi ẹva wan!” <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />Ẹsha lan too klan sablọ ọYẹsọ huọ kọ ghan lẹ nga shin, “Wa otro kẹ ọmẹ enkyi lẹn, ẹngọ ẹsha itritri.”<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />Tuhuan ọYẹsọ lẹ o nun nga, “Kyẹ ọntua ngọ?”</para>
  <para style="p" vid="MRK 5:9">E lẹ e kye kẹ akọ ghan shin, “Ọntua imi ma ọsọ Ihywii,” “Sablọ enyi so lẹ apam.” <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />Tuhuan a lẹ a wẹn ọYẹsọ la kẹnkan kalẹ e re wan kẹ ọfọ la ma.<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />Uree obusurum tọ lẹ oso kẹ ọnhuọ upiye kẹ ayẹ ọnkọn. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />Ọnsha lan la wan ọYẹsọ, “Sọ, enyi kpon kan wan lẹ ọmẹ obusurum; kẹ enyi ma nyẹran ọmẹ ma.” <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />ọYẹsọ lẹ a ma wan onyun, ọnsha lan lẹ otro kẹ nyẹran ọmẹ obusurum. Uree obusurum tọ ofuwan atlẹ ọkọ apuwa (2,000), a la nyan lẹ utriton kẹ osrom kẹ e kple kan lẹ ọmẹ Udrin kẹ ekyure wan.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />Lẹ shin ana upiye obusurum shin klan, e lẹ etriton kan lẹ ọmẹ iye ẹshan kẹ arẹn ashan shin o so kẹ ọfọ lan kẹ ama ihyuu. Ada lẹ otro ba ushin ọnkyẹ shin ọba. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Lẹ ọshin ada wa fuwan ọnhuọ ọYẹsọ, e le shin enkyi shin a lẹ oso lẹ ihywii ọnsha lan trẹtra kẹ ẹngbapia ghan kẹ ẹgbẹna nga, tuhuan a tọ uso kẹ ọtrẹ ghan, ọnwọ eji la kpaa wan. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Anushin o du ọnkyẹ lan kẹ aprẹn iredre wan, lẹ afrẹ utoo ihyuu ọnkyẹ shin ọba lẹ ana ọnsha lan kẹ obusurum na. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />Tuhuan ada lan, lẹ afrẹ ọwẹn ọYẹsọ kẹ a nya ghan kẹ ọga ẹbọn ma.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />Lẹ shin a kyan huọ nyẹran ọmẹ ọkpa, enkyi shin uloo so lẹ ọnsha lan lẹ a wan kẹ enga re ghan kan. <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />Tushin ọYẹsọ laa ghan ẹnga ma, tuhuan kẹ a kọ ghan lẹ nga shin, son kan ngọ lẹ ọmẹ shan ngọ kan lẹ ọnhuọ ewedri ngọ kẹ ẹngọ ma too wan ute ọnkyẹ ọndrọndọ shin Ẹkye-baan du ngọ, kẹ emle shin e shin ohuo ngọ kọ. <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />Ọnwọ enkyi lan lẹ okpon kan, kẹ a kẹ tẹkpa utoo ihyuu kẹ uDikafoli<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="ft" closed="false">UDikafoli wọ uso ọntua ashan ọkọ shin enekyi lan kẹ o son too ihyuu ọnkyẹ ọndrọndọ shin ọYẹsọ du ghan</char></note> ute ọnkyẹ ọndrọndọ shin ọYẹsọ o du ghan. Tuhuan ididu ada le eshin ọvrọ.<verse eid="MRK 5:20" /></para>
  <para style="s">Arẹn ọJarus kẹ anshẹ ushre eji</para>
  <para style="r">(<ref loc="LUK 8:40-56">ULuka 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Lẹ shin ọYẹsọ ywure kẹ a kpẹn kan lẹ ọnwa ọga ẹna kẹ ọmẹ ọkpa ambrẹ, idri ada lẹ wa klan kẹ ọnhuọ ywa ghan. A tọ lẹ hyu kẹ onyun ẹna na. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Tuhuan ana onzu kẹ omẹn ana ukon aklọ lẹ unko ọpẹlọnọm, a drọ ghan shin ọJarus, a lẹ a ba lẹ ọnhuọ lan. Lẹ shin a la edre lẹ ọYẹsọ, a lẹ akpaa kẹn ẹnpakye ghan, <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />kẹ afrẹ ọwẹn nga lakẹnkan, “Ẹngbakyuẹ arẹn mi arashẹ kyẹ ukpo ghan. Kikun ngọ ba kẹ ngọ ma piya ghan lẹ anyẹn ngọ ẹmbakyẹ shin okon ọtrẹ tuhuan kẹ aywua.” <verse eid="MRK 5:23" /><verse number="24" style="v" sid="MRK 5:24" />ọYẹsọ lẹ okpon kan kẹ ẹnga.</para>
  <para style="p" vid="MRK 5:24">Idri ada lẹ e re ghan kan tuhuan a la maa ghan huo ulon usè ghan wọ. <verse eid="MRK 5:24" /><verse number="25" style="v" sid="MRK 5:25" />Eple anshẹ lẹ oso kẹ ọmẹ ada lan shin a huọ ukon amẹ ọkọ lẹ apua kẹ ọnhuọ ushre eji. <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />A huọ hyua ẹva lakẹnkan kẹ ẹfa ana ume ẹkan lẹ apam tuhuan a hurẹ ọprẹ ididu ọnkyẹ shin oso lẹ ọma. Tushin, lẹ shin o kon ọtrẹ, uloo lan lẹ afrẹ ọkẹn mẹ. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />Lẹ shin a kọn aprẹ ọYẹsọ, e le kem kẹ ititim ada kẹ wa piya ẹngbapiya ghan, <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />a lẹ afrẹ ọrẹn lẹ ẹhurẹ ghan, shin, “Huọ lẹ ẹngbapiya ghan kẹ imi apiya lẹ hule mi nii ukon ọtrẹ.” <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />Kẹ ẹladran ushre eji ghan lẹ a tigha, tuhuan a lẹ akọn kẹ ẹgbẹna nga shin a ma ghan ọtrẹ.<verse eid="MRK 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 5:30" />Kẹ ẹladran ọYẹsọ la kọọn shin uple ọdọ tro kẹ ọmẹ nga, a lẹ ekyem kẹ ọmẹ ada kẹ luwe, “Ẹnga nga piya ẹngbapiya mi?”<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />Ọnwọ apaduwan nga lẹ a kọ wa lẹ nga shin, “Ngọ shii ada klan a okon ọmaa ngọ kan, ọnwọ ngọ kon uluwe shin ‘Ẹnga nga apiya mi?’ ”<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />Tushin ọYẹsọ lẹ afrẹ unii anushin odu klan. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />Anshẹ lan kpẹ ọnkyẹ shin ọba ghan, a lẹ a ba kẹ ọmẹ ọkọọn ibun kẹ ọkpan lẹ huọ, kẹ a kpaa kẹ ẹnpakye ghan, kẹ otoo ghan ẹgbọn ẹplẹpan. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Ọnwọ a lẹ akọ ghan lẹ nga shin, “Ẹẹna, ọdọ ẹhurẹ ngọ ma ngọ ọtrẹ. Son kan ngọ kẹ ọmẹ ọna ẹhurẹ, kẹ ngọ kon ọtrẹ uloo ngọ.”<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />O hyu kẹ ọnhuọ ọpiya onyun, eple enyi ma la ba bi kẹ abaan ọJarus, ana ukon aklọ lẹ unko ọpẹlọnọm. Kẹ awa kọ wan shin, arẹn ngọ arashẹ òó kpo ghan. Unse wa ọsọ ngọ hyu ọhyua avuwa ọnfran?<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />ọYẹsọ lẹ a ngẹn nga atọn lẹ ọnkyẹ shin o too wan a lẹ a kọ ghan lẹ ana ukon aklọ lẹ unko ọpẹlọnọm lan shin, “Ka lẹ eji kpa ngọ ma, kpọn lẹ ẹhurẹ ngọ.”<verse eid="MRK 5:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 5:37" />ọYẹsọ laa ghan a lọ kẹ e re ghan kan ma sẹ uBitrus, ọYakubu kẹ ọYohanna ewedri ọYakubu. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Lẹ shin a fuwan abaan ọJarus ọYẹsọ lẹ eshii ada so lẹ oywu, atọ uso kẹ ọnhuọ ukyue lẹ ata akpa la kẹnkan. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />A lẹ anyẹran kan lẹ ọmen, kẹ a kọ ghan lẹ ẹma shin, Unse wa ọsọ unu kon ukyue lẹ unu ta akpa kẹn? Arẹdẹn so nyan nga ukpon ghan ma, aa nọna ghan kọ. <verse eid="MRK 5:39" /><verse number="40" style="v" sid="MRK 5:40" />Tuhuan a lẹ afrẹ ọkrọọ ghan ọkrọọ ọnwọ ọlaa.</para>
  <para style="p" vid="MRK 5:40">Tushin e le we wan lẹ edidu kẹ she wan kan lẹ etin, a lẹ a kpọn ekye kẹ ẹya arẹn dran kẹ apaduwan ghan shin o son kẹ nga, tuhuan a lẹ anyẹran kan lẹ ọnhuọ shin arẹn dran so wọ. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />A lẹ afrẹ ghan kẹ ọnyẹ tuhuan kẹ a kọ ghan lẹ nga shin, “Talita kumi” ọnwọ so shin, “Arashẹ, nyẹnya” <verse eid="MRK 5:41" /><verse number="42" style="v" sid="MRK 5:42" />Kẹ ẹladran arẹn ashẹ lan lẹ a nyẹnya kẹ afrẹ usoson, uloo so amẹ ọkọ lẹ apuwa. Kẹ ọtra ẹkyuẹ kẹ anyẹn ada lẹ eshin ọvrọ lakẹnkan. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Tushin ọYẹsọ la wo wan atọn lakẹnkan kalẹ alọ kọn ihyuu lẹ ma. Tuhuan kẹ otoo wa shin a ma ghan ọnlẹghẹ kẹ aya. <figure style="fig" alt="Jesus heals Jairus' daughter" file="DN00437b.tif" size="col" loc="5:43" copy="Dunham" ref="5:43">ọYẹsọ Man Arẹn ỌLazrọs Ọtrẹ</figure><verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">A tran ma ọYẹsọ kẹ ọNazaret</para>
  <para style="r">(<ref loc="LUK 4:16-30">ULuka 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />ọYẹsọ la ọnhuọ lan wọ kẹ e ywure ghan ẹshaan ghan, apaduwan nga lẹ re ghan kan. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Lẹ shin aywuẹ utrim ba, a lẹ afrẹ ulolo kẹ ọmẹ unko ọpẹlọnọm. Ada la ampam shin o so kẹ ọnhuọ kọn nga, lẹ eshin ọvrọ, lẹ a kọ wan shin.</para>
  <para style="p" vid="MRK 6:2">“Ulon ọnhuọ ghan wọ enkyi lẹ kon ọmẹ ọnkyẹ lẹ wọ?” E le luwe, “Ulon ọza ikon ghan wọ a ma ghan kẹn shin okon udu ọnkyẹ ọvrọ?” <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />“Kyẹ ọkafinta lan wẹn ma, arẹn ọMariyamu, ewedri ọYakubu wan kẹ Isu<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false">A nga anasra drọ shin Joses.</char></note> kẹ ọYauza kẹ ọSaminu? Kyẹ afuwọ ghan mẹn kẹ enyi ma?” Tuhuan a lẹ a nyan amuwa kẹ tran ma ẹnga.<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />ọYẹsọ lẹ a kọ ghan nẹ ma shin, “Onu kẹ okon ọdọọ huọ kẹ ulon ọnhuọ ghan wọ sẹ kẹ ẹshaan ghan, kẹ ọmẹ ewedri ghan kẹ ọmẹ abaan nga.” <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />E le mle ghan udu ọnlẹghẹ ọvrọ kẹ ọnhuọ lan ma, tushin a la traa ana ọhyuẹ anyẹ kẹ a ma wan ọtrẹ. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />E le eshin ọvrọ sablọ shin o so wan lẹ ọdọ ẹhurẹ wan.</para>
  <para style="s" vid="MRK 6:6">ọYẹsọ tuwan apaduwan nga ọkọ lẹ apua</para>
  <para style="r" vid="MRK 6:6">(<ref loc="LUK 9:1-6">ULuka 9:1-6</ref>)</para>
  <para style="p" vid="MRK 6:6">Tuhuan ọYẹsọ la kee arẹn ashan ọfọ lan lẹ o son ololo ada. <verse eid="MRK 6:6" /><verse number="7" style="v" sid="MRK 6:7" />A lẹ a dra apaduwan nga kẹ atuwan ma ana apaplẹ. Tuhuan kẹ a ma wan ọdọ kẹ aprẹn ọnsha.<verse eid="MRK 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 6:8" />A lẹ ama wan iywuro shin: “Kalẹ unu kpọn ọnlẹghẹ kẹ ọsablọ uson ma, sẹ aban - bọ ọnlẹghẹ ọya, bọ ọpa, bọ ikli kẹ ọmẹ inywun. <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />Unu shẹ akpla, kalẹ unu kpọn iple ẹngbapiya wan sẹ ẹnkọ unu a shẹ kẹ ẹgbẹna unu. <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Abaan shin unu a kyuran akpọn kọ, unu tigha kẹ ọnhuọ lan sẹ unu a laa ẹshaan na kọ. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />Ididu ọnhuọ shin a ngrẹn wan inu ma kẹ tran ma ọngẹn atọn lẹ unu, ẹlẹn shin unu kyẹ ọnyan unu kẹ ọnhuọ lan, unu kpan (unywi) afran kẹ unu we anyẹn lẹ ẹma wlan.”<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />A lẹ otro tuhuan kẹ frẹ utoo shin ada kpaa ilovro wan. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />E le wuli ọnsha lẹ ampam, tuhuan kẹ ama oloo ọmpam ọtrẹ, ke otuo wan anyẹ.<verse eid="MRK 6:13" /></para>
  <para style="s">Ukpo ọYohanna ana udu ọbaftisma</para>
  <para style="r">(<ref loc="LUK 9:7-9">ULuka 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />Tushin Iridus agọn, àá huọ ọkọọn ihyuu, sablọ ọntua ọYẹsọ hurẹ ọkan ananọn ọnwọ shin alọ wan lẹ a kọọ wan shin, “ọYohanna ana udu ọbaftisma nga a nyuọ bi kẹ ọmẹ itun, ọnwọ ọsọ okon ọdọ udu ọmẹ ọnkyẹ ọvrọ lẹn kẹ ọmẹ nga.” <verse eid="MRK 6:14" /><verse number="15" style="v" sid="MRK 6:15" />Tushin eple enyi ma shin, “Onu Iliya ghan.”</para>
  <para style="p" vid="MRK 6:15">Eple enyi ma tọ ọkọọ wan shin, “Kayi, eple onu ghan kẹ ẹtrẹtọ, kẹ ọmẹ onu Ọnọm ikyikyuwo.”<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />Lẹn shin Iridus kọn anyẹn, a lẹ a kọ ghan shin, ọYohanna, anushin imi a faa ghan ẹkyuẹ nga a ngyọn bi kẹ ọmẹ itun.<verse eid="MRK 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17" />Iridus kẹ kyuẹ-kyuẹ ghan la ma onyun shin afrẹ ọYohanna, tuhuan a lẹ sọ olo ghan kẹ a sọ ké unko. Iridus du klan sablọ Irudiya ashẹ ewedri ghan uFilibus shin ẹnga kpọn. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Sablọ ọYohanna lẹ afrẹ utoo Iridus shin, “Ọgbaa wọ shin a kpọn ashẹ ewedri ghan ma.” <verse eid="MRK 6:18" /><verse number="19" style="v" sid="MRK 6:19" />Ọnwọ Irudiya kon amuwa ọYohanna kẹ ọmẹ ẹhurẹ ghan, e nii ọprẹ ghan, bọ a lẹ okon epin ma. <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />Sablọ Iridus la kẹ kọn ibun ọYohanna, a za shin ọYohanna ana ẹplẹpan ghan tuhuan a ana ẹsẹẹ ghan, ọnwọ ọsọ a la traa ghan. A ka kẹ kọn ọngẹn atọn lẹ ẹnga tushin ọnkyẹ utoo ghan ka piya ghan ẹhruẹ la kẹnkan.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />Ubon nga la ba shin Irudiya kon epin, lẹ shin Iridus so kẹ ọnhuọ kpọn ẹpan ọwan lẹ idrọnọm shin obiyon ghan kọ, a lẹ adra agọn nga kẹ ana ekye a ma osoja kẹ ọmẹ ẹbọn nga, kẹ ana adradọ ọGalili. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />Lẹ shin arẹn Irudiya arashẹ nyẹran itighe kẹ a taa kẹ ẹmpakye wan, a lẹ akọn ushi lakẹnkan.</para>
  <para style="p" vid="MRK 6:22">Ọnwọ Agọn lẹ akọ ghan lẹ orodruan na shin “Wan mi huọ unse wan, tuhuan imi nii ọma ngọ.” <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Tuhuan a lẹ etre odruwan na shin “Ididu ọnkyẹ shin ngọ a wan mi imi nii ọma ngọ, huọ lẹ ọga ẹgọn mi lẹn kọ.” <verse eid="MRK 6:23" /><verse number="24" style="v" sid="MRK 6:24" />Ọnwọ a lẹ otro kan lẹ ọnhuọ ẹya ghan kẹ a kọ ghan lẹ nga shin “Unse wan imi nii ọwan?” Ẹya ghan na kọ ghan shin “Ẹkywuẹ ọYohanna ana udu ọbaftisma.” <verse eid="MRK 6:24" /><verse number="25" style="v" sid="MRK 6:25" />Kẹ ẹladran a lẹ a nyẹran ọnhuọ agọn kẹ a kọ ghan shin, “Imi nii ngọ ma mi ẹkywuẹ ọYohanna ana udu ọbaftisma kẹ ọmẹ ẹmpẹ kẹ ẹlẹladẹn.” <verse eid="MRK 6:25" /><verse number="26" style="v" sid="MRK 6:26" />Agọn huọ kọn klan, ẹhurẹ ghan la bẹn ya la kẹnkan, sablọ a huọ utre kẹ ẹmpakye oson ghan shin ẹnga nii nga u re ghan lẹ ọnkyẹ shin a wan nga ma. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Kẹ ẹlẹn izun, agọn la tuwan onsoja kẹ a ma ghan onyun shin a sọ a faa ẹkyuẹ ọYohanna kẹ ọmẹ unko kẹ okon ghan ma. <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />Onsoja lan la a sọ ẹkyuẹ lan kẹ aprẹn ẹmpẹ, tuhuan kẹ a kẹ ma arashẹ lan, arashẹ lan lẹ huọ ma ẹya ghan. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />Lẹ shin apaduwan ọYohanna kọn ihyuu, a lẹ a ba kẹ wa kpọn ọkrọọ ghan kẹ a ka lọọ.<verse eid="MRK 6:29" /></para>
  <para style="s">ọYẹsọ ma ana atlẹ ọkọ otong ọnkyẹ ọya</para>
  <para style="r">(<ref loc="LUK 9:10-17">ULuka 9:10-17</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Apaduwan ọYẹsọ le eywure kẹ awa klan kẹ ọnhuọ ọywua ghan, kẹ otoo ghan ididu ọkyẹ shin ẹma du kẹ ololo. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Tuhuan a lẹ a kọ ghan lẹ ẹma shin “Unu ba lẹ ọnhuọ shin uso atọ kẹ unu ma etrim.” Kẹ ada lapam kon ubi lẹ eywure wan, ọnwọ shin o kon wan epin ọya ọnkyẹ ọya wan.<verse eid="MRK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 6:32" />A lẹ kpon kan wan lẹ ọnhuọ shin uso la atọ kẹ ọmẹ ọkpa. <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />Tushin lẹ shin a nya kẹ ọnhuọ lan, ada la apam le e shin wan kẹ akpẹ. Ọnwọ a la nya kẹ afrẹ utriton bi kẹ ashaan lẹ edidu kẹ afuwan ọnhuọ lan kẹ ekye wan. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />ọYẹsọ huọ usiri bi kẹ ọmẹ ọkpa e le eshin ada la apam, e le eshin ohuo wan, sablọ o so ka wa àtẹn shin a so wan lẹ ekyee wan. A lẹ afrẹ ulolo wan ọnkyẹ lẹ apam.<verse eid="MRK 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35" />Tushin ọnhuọ huọ ọhurẹ ọba anlẹ apaduwan nga la ba lẹ ọnhuọ ọywua ghan, ka kọ wan lẹ nga shin, Ọnhuẹn nẹ fa alọ so ghan ma, tuhuan ọnhuọ kẹ ọbanlẹ. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />Laa ada kẹ anyẹran kan lẹ ẹfọ lẹn kẹ ọmẹ arẹn ashaan kẹ ọhuọ ẹnga nga ma lọ ọnkyẹ shin ẹnga nii ọya.<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />Tushin a lẹ ekye wan kẹ a kọ ghan lẹ ẹma shin.</para>
  <para style="p" vid="MRK 6:37">“Unu ma wan ọnlẹghẹ ka aya.”</para>
  <para style="p" vid="MRK 6:37">E le kye ka kọ wan lẹ ẹnga shin, ẹngọ nii enyi kpọn ikli idri imon shin ẹfuwan ikli ọtuan ẹprẹn ẹnana<note caller="+" style="f"><char style="fr" closed="false">6:37 </char><char style="ft" closed="false">Ọrẹn ikyikyuwo shin ozurfa atlẹ apuwa</char></note> kẹ enyi lọ ọkyẹ ọya wọ kẹ a ma wan kẹ aya? <verse eid="MRK 6:37" /><verse number="38" style="v" sid="MRK 6:38" />Tuhuan a lẹ akọ ghan lẹ ẹma shin, “Oko Ubredi aman yọ unu so lẹ anyọ?” “Unu son son luwe” A hurẹ lẹ ukẹ okon, a la akọ wan shin “Oko Ebredi otong, kẹ arẹvọn apuwa.”<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />ọYẹsọ lẹ too apaduwan ghan shin a sọ ada kẹ atrẹtra kẹ ọgbọ-ọgba kẹ aprẹn ambọn. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />A lẹ a huọ trẹtra kẹ ọgbọ-ọgba, eple enyi ma ana ataatẹlẹ eple enyi ma ana ẹhuẹ iti-tong. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />Àá huọ kpọn oko ubredi otong na kẹ arẹvọn apuwa lan, a lẹ a sa edre kan lẹ aprẹmẹn, kẹ a sọ Ọnọm ẹja, tuhuan kẹ afọn ubredi lan, kẹ afrẹ ume apaduwan, a lẹ afrẹ ọkam lẹ eme ada, tuhuan kẹ a huọ ọkam arẹvọn na le eme ada. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Ididu ada la aya kẹ eshire. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />Tuhaun apaduwan nga lẹ otun onvrun ubredi kẹ arẹvọn na, kẹ okon ọnzẹn ọkọ lẹ ọpua. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Ekyi shin aya ubredi lan oso enyi atẹlẹ ọkọ otong (5,000).<verse eid="MRK 6:44" /></para>
  <para style="s">ọYẹsọ son oson kẹ aprẹn ambrẹ</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Kẹ ẹladran, ọYẹsọ lẹ a sọ apaduwan nga kẹ nyẹran kan wan ọmẹ ọkpa kẹ akpa kẹ ekye ghan kan lẹ ọBẹsẹda, tuhuan a la tigha kẹ ma ada anya. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />A la huọ laa wan, a la nya kan ghan lẹ aprẹn ọnkọn kẹ ọpẹlọnom.<verse eid="MRK 6:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47" />Ónhuọ ọhure ba anlẹ, ọkpa tọ uso kẹ erete ẹna, ọYẹsọ tọ uhyu kẹ aprẹn ọngbavran kẹ izun nga. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />À la laa edre kẹ shin apaduwan nga kon ọmuọm kẹ ọkpa, sablọ shin urun kon unii ọya ọdọ wan. Lẹ ọshaa ombun, a lẹ aba lẹ ọnhuọ ọywua wan o tọ uson kẹ aprẹn ambrẹ kẹ odum kawan ẹnga kyẹ ọsẹẹ wan wọ. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />Ẹlẹn shin eshin ọYẹsọ soon kẹ aprẹn ambrẹ lan, e le mle shin anushire ghan nẹ, tuhuan a la ashẹ akpa wọ, <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />sablọ ididu wan shin ghan, a lẹ ofro le mli.</para>
  <para style="p" vid="MRK 6:50">Kẹ ẹladran a lẹ apẹ lẹ ẹma kẹ a kọ ghan shin, “Kalẹ eji kpa unu ma!, Imi nga, kalẹ unu kọn ibun ma.” <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />Tuhuan a lẹ anyẹran kan lẹ ọmẹ ọkpa kẹ ẹma, tushin urun na lẹ angrẹ na atọ. E le shin ọvrọ, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />ẹhurẹ wan hrum kan sablọ shin a kpẹ wan aprẹ ọfọọn oko ebredi shin a ka ana atẹlẹ ọkọ otong na ma (5,000).<verse eid="MRK 6:52" /></para>
  <para style="s">ọYẹsọ ma olo ọtrẹ ke ọJẹnẹsẹrẹ</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Lẹ shin akpẹn ẹna a lẹ afuwan ẹbọn ọJẹnẹsẹrẹ, e le re ẹkpa wan kẹ ọnhuọ lan. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Lẹ shin o huọ utro bi kẹ ọmẹ ọkpa, ada lẹ akpẹ ọYẹsọ. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />A lẹ afrẹ utriton kẹ ididu ọfọ lan, kẹ afrẹ ukon olo kẹ aprẹn ẹkya wan ba lẹ ididu ọnhuọ shin ọYẹsọ so wọ. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Ididu ọnhuọ shin a kan, arẹn ashaan, ashaan adradọ hwo onfom - a lẹ ngẹn olo kẹ ayẹ Ize. A lẹ a wan nga kẹ a laa wan kẹ a piya huọ ẹfra ẹngbapiya ghan, tuhuan ididu anushin apiya lẹ okon ọtrẹ.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">Ululo ọnwọ akpẹ enyi</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />AFarisiyawa kẹ eple avuwa ulolo iywuro a ma ushin a ba bi kẹ Urushẹlima klan kẹ ọnhuọ ọYẹsọ. <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />E le eshin eple apaduwan nga kon ọya ọnkyẹ ọya bọ o huro anyẹn ma. <verse eid="MRK 7:2" /><verse number="3" style="v" sid="MRK 7:3" />(Sablọ aFarisiyawa kẹ ididu aYahudawa kẹ a ya wan ọnkyẹ ọya wan sẹẹ a zrọ uhulo anyẹ emle shin akpẹẹ ikyikyiwo wan lẹ a kẹ odu wọ.) <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />Tushin ẹlẹn shin eyure bi kẹ Ize, a kẹ aya wan ọnkyẹ ọya wan sẹ azrọ tram; ọnkyẹ lẹ apam soo shin a lẹ a kẹ odu ọn ma shin o lolo bi kẹ ẹfa akpẹ wan, ute uhulo ọnsẹ̀, kẹ unwoo, kẹ ọmpẹ ọyẹra kẹ ẹkya.<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />Tuhuan aFarisiyawa kẹ avuwa ulolo iyuro lẹ onun ghan shin, “Unse wan ọsọ apaduwan ngọ kẹ odu wa ọnkyẹ shin akpẹẹ ikyikyiwo kẹ odu wan, tushin a kẹ aya ọnkyẹ ọya bọ o huro anyẹ ma?”<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />A lẹ ekye wan shin, “Ẹplẹpan ya Ishaya too lẹ shin o too aprẹ unu ẹwẹn ọmẹ ọnkpẹn; kawan emle shin a rẹn kọ: ‘Amẹn enyi nẹ kẹ adọọ mi lẹ ẹtan-onyun ma lehule, Tushin ẹhurẹ wan so ẹnẹnọ kẹ imi. <verse eid="MRK 7:6" /><verse number="7" style="v" sid="MRK 7:7" />A kẹ adọọ mi kẹ ililu; Ulolo wan ọnwọ iywuro enyitri wọ.’ <verse eid="MRK 7:7" /><verse number="8" style="v" sid="MRK 7:8" />Unu a laa iywuro Ọnọm kan tuhuan ke afrẹ ukon ulolo ọnwọ enyetri.”<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />Tuhuan a lẹ a kọ ghan lẹ ẹma shin: “Unu so lẹ ọntran ọgyagyuan utighe iywuro Ọnọm ka ayẹ sablọ unu frẹ ukon ulolo ọnwọ enyetri! <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />Sablọ uMusa la kọ ghan shin, ‘Za lẹ ekye ngọ kẹ eya ngọ,’ tuhuan, ‘Anushin a tuwa ekye ghan hwo eya ghan sẹ a prẹ ghan.’ <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />Tushin unu a ulolo shin, shin enyetri so lẹ ọnkyẹ shin ẹnga tọ o du ọtuan kẹ a ta ekye ghan huọ ẹya ghan anyẹ, ‘unu shin ọKorban wọ’ (ọnkyẹ shin a ma Ọnọm). <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />Ọnwọ shin unu a tọ lan ẹma kẹ a ta ekye huọ eya wan anyẹ wọ man. <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />Ute ulolo lẹn wọ unu o kẹ o du ọtuan wọ kẹ unu bẹn aprẹ Ọnọm. Tuhuan unu kẹ odu uple ọnkyẹ lẹ apam klan.”<verse eid="MRK 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />Ọnwọ ọYẹsọ lẹ eywure kẹ adra ada ba lẹ ọnhuọ ghan kẹ akọ ghan shin “Unu ngẹn imi atọn, ididu unu, kẹ unu kpẹ lẹ a dẹdẹi. <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />Kyẹ ọnkyẹ shin ọ kẹ anyẹran enyetri bi kẹ etin wa ọ kẹ asọ ghan ‘ajajẹ’ sẹ ọnkyẹ shin ọ kẹ otro bi kẹ ọmẹ enyetri ma ọ kẹ asọ ghan ‘ajajẹ.’ ” <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />Ididu anushin oso lẹ a tọn ọkọọn, ana a kọn.<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false">Azaa la ampam anyọ rẹn ikyikyuwo so yọ lẹ abran ọkọ lẹ ikyen man(v16)</char></note><verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />Lẹ shin aa ta ititim lẹ ada kẹ anyẹran ọmẹ abaan, apaduwan nga lẹ onun nga ọnkyẹ shin ẹsẹẹn lan too. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />A la kọ lẹ ẹma shin, Unu akpẹ unu ma? Unu za unu shin, ididu ọnkyẹ shin ọnyẹran enyetri bi kẹ etin, kẹ asọ wan ẹnga ajajẹ? <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />Sablọ ọ kẹ nyẹran wọ ọmẹ ẹhurẹ wan tushin ọmẹ ọfọn ghan wọ o kẹ nyẹran, emle lan nga unii huọ utro wọ. Lẹ ọpẹ kẹn, ọYẹsọ nyin shin ididu ọnkyẹ ọya so kẹ agyagyuwan.<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />Tuhuan a lẹ a kọ ghan shin, “Ọnkyẹ shin utro bi kẹ ọmẹ ẹhurẹ enyetri wọ ọ kẹ a sọ ghan ajajẹ. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />Bi kẹ ọmẹ ẹhurẹ enyetri wọ ọrẹn-ẹhurẹ utri kẹ otro wọ, udu-ililu, utuwo kẹ ọprẹ-ọrẹ <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />udu ẹva, ọbyẹkyuẹ, ukon alọ lẹ ẹhurẹ, uwu kẹ unii ọkọọn ushi, ifuwo, ọbẹn ọntua, ọdrọm, kẹ igbon. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />Ididu ọmẹ ọnkyẹ untri lẹ tro bi kẹ ọmẹ ẹhurẹ tuhuan asọ enyi ajajẹ.”<verse eid="MRK 7:23" /></para>
  <para style="s">Ọdọ ẹhurẹ eple anshẹ etre anọ uFinishiya</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Tuhuan ọYẹsọ lẹ a laa ọnhuọ lan wọ. A lẹ kpon kan lẹ ankam ọTaya kẹ ọSidon. A la nyẹran eple abaan, bọ e nii shin alọ kpẹ wan; bọ e kẹ eyem ma. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />Lẹ ẹplẹpan, kẹ ẹladran wọ eple anshẹ shin ẹngbakyuẹ arẹn ghan so lẹ ọnsha untruntri lẹ akọn ihyuu ghan a lẹ aba kẹ a wa kpa kẹ ẹnpakye ghan. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Anshẹ lan kyẹ etre aYahudawa ghan ma. O byon ghan kẹ ọnyẹ uFinishiya wọ kẹ ọmẹ ẹbọn uSiriya. A lẹ a wan ọYẹsọ kẹ ewe ọnsha lan kẹ ọmẹ ẹgbẹna arẹn ghan.<verse eid="MRK 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27" />ọYẹsọ kọ ghan lẹ nga shin, “Tigha arẹn zrọ ọya kẹ eshre, sablọ ọgbaa wọ akpọn ọnkyẹ ọya arẹn kẹ eshe ava wan.”<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />Tushin anshẹ lan lẹ kye kẹ a kọ ghan shin “Ẹẹn, emle ghan nglan Ekye abaan, tushin ava kẹ aya onvrun ọnkyẹ ọya arẹn shin ekple kẹ ẹbọn.”<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />ọYẹsọ la kọ ghan lẹ nga shin, sablọ emle shin ngọ ekye wọ, ywure ngọ omẹn abaan, ẹsha lan ẹ laa arẹn ngọ.<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />Ọnwọ e le ywure ghan ọmẹ ẹshan a la kẹ eshii arẹn nga kẹ aprẹn ọkya, ẹsha tọ huọ laa ghan.<verse eid="MRK 7:30" /></para>
  <para style="s">ọYẹsọ ma agbatọn kẹ ibebe ọtrẹ</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />ọYẹsọ laa ọga ẹbọn ọTaya kẹ eywure kan ọSidon a la kan lẹ ẹna ọGalili kẹ use uDikafoli. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Tuhuan a lẹ o kon ghan eple enkyi shin agbatọn nga tuhuan a kẹ emle ghan ọpẹẹ wan, tuhuan a la wan nga kẹ atra ọnyẹ ghan kẹ aprẹn enkyi lan.<verse eid="MRK 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 7:33" />Tuhuan a lẹ a kpọn kan na ayẹ, a piyam kẹ ada, ọYẹsọ la shẹ ẹrẹnyẹ nga kan lẹ ọmẹ atọn nga, tuhuan a la ta ekpe tuhuan kẹ apiya inno enkyi lan wọ. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />A la sa edre ka lẹ aprẹn kẹ olo ọnfran ulom kẹ eshe tuhuan ka kọ ghan lẹ nga shin, “Iffata!” Shin u nyin shin “Kunmi!” <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />Lẹ shin apẹẹ klan ọnwọ atọn enkyi lan lẹ okunmi kẹ ẹladran, ọnkyẹ shin uloo ghan inno lẹ eble wan tuhuan a lẹ afrẹ ọpiya onyun ghan kẹ agyagyuwan.<verse eid="MRK 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 7:36" />ọYẹsọ lẹ woo ada lan atọn shin kalẹ otoo alọ wan, tushin emle shin a huọ ure wan utoo wọ, emle lan ghan a laa frẹ u huọ utoo ihyuu lan ka wan wọ. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Ada la kuwang lẹ ọvrọ, a la kọ wa shin, “Kai, odu huo unse wan kẹ agyagyuwan! Kẹ a sọ agbatọn lẹ akọn atọn, ibebe lẹ a huọ ọpiya onyun.”<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">ọYẹsọ ma ana atlẹ ọkọ anang ọnkyẹ ọya</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />Kẹ aywuẹ lan idri ada tọ uywure kẹ a klan. Bọ oso lẹ ọnkyẹ a tọ a ya wan, ọYẹsọ lẹ a dra apaduwan nga ba lẹ ọnhuọ ywa ghan kẹ a kọ ghan lẹ ma shin, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />“Imi shin ada kẹ emremrin, sablọ o kon aywuẹ a taa wẹn kẹ imi ba o so lẹ ọnkyẹ ọya wan. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />Inshin imi a laa wan kẹ o kpon kan wan ọmẹ abaan ma kẹ ẹwọn ma, e nii ọkan kpa ọyuẹ kẹ ọntran, sablọ shin eple enyi ma tro bi kẹ a nanọn.”<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />Apaduwan nga le kye ghan ka kọ wan shin, “Ulon ọnhuọ ghan wọ o tọ o kon ọnkyẹ shin ọ tọ ọmẹ ada lẹn ọya wọ kẹ ọmẹ ifọ onum kẹn?”<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />ọYẹsọ lẹ e luwe wan shin, “Oko ubredi a ma yọ unu so lẹ anyọ?”</para>
  <para style="p" vid="MRK 8:5">A la kọ wan shin, “Otumpua.”<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />A la sọ ada trẹtra kẹ ẹbọn. Lẹ shin a kpọn oko Ubredi kẹ asọ Ọnọm ẹja, a la fọn tuhuan kẹ ma apaduwan nga kẹ a kam ada, a lẹ huọ ka ada. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />A tọ lẹ o so lẹ arẹvọn lẹ a kpahyurẹ, a lẹ a sọ Ọnọm ẹja kẹ sablọ arẹvọn na tuhuan kẹ a kọ ghan lẹ ẹma shin a kaa ada. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Ada lẹ a ya, kẹ eshre, apaduwan nga lẹ otun onvrun shin atọ a la kuwan ọnzẹn utumpuwa. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />Anushin oso kẹ ọnhuọ lan tọ afuwan atẹlẹ ọkọ anang (4,000). Tuhuan a la laa wan kẹ okpon kan wan. <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />Kẹ ẹladran a lẹ a nyẹran kan lẹ ọmẹ ọkpa kẹ apaduwan nga tuhuan a lẹ okpon kan wan lẹ ọgase ọDalmanuta.<verse eid="MRK 8:10" /></para>
  <para style="s">AFarisiyawa nii ankpẹ ọvrọ</para>
  <para style="r">(<ref loc="LUK 12:54-56">ULuka 12:54-56</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />aFarisiyawa lẹ a ba lẹ ọnhuọ ywa ghan kẹ afrẹ ọyẹna kẹ nga. A le enii umle ọYẹsọ, a lẹ a wan nga shin e nyin ma ankpẹ bi kẹ aprẹn shin inii unyin ọdọ ghan. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />A lẹ o loo ọnfran ulolo m kẹ she tuhuan kẹ a kọ ghan shin, “Sablọ unse wa ọsọ ana ẹlẹn nẹ kon unii ankpẹ ọvrọ? Imi kya utoo unu ẹplẹpan, E nii ma ọma ana ẹladẹn eple ankpẹ ọvrọ wan.” <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />Tuhuan a lẹ a laa wan, kẹ eywure kẹ anyẹran kan lẹ ọmẹ ọkpa kẹ akpẹn kan nẹ unpi sa.<verse eid="MRK 8:13" /></para>
  <para style="s">Unu du ikle lẹ uyisti aFarisiyawa kẹ ọnwọ Iridus</para>
  <para style="pi">
    <verse number="14" style="v" sid="MRK 8:14" />Apaduwan ọYẹsọ lẹ jre ọkpọn ubredi la apam, sẹ iko izun kẹ ọmẹ ọkpa lan <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />ọYẹsọ lẹ wo wan atọn, kẹ akọ ghan shin, “Unu kon aklọ, kẹ unu du ikle lẹ uyisti aFarisiyawa kẹ ọnwọ Iridus.”<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />Á lẹ afrẹ ọpiya onyun ke eple wan shin, “Huo sablọ shin enyi so wan lẹ ubredi wan wọ ọsọ shin o too klan dẹn.”<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />Lẹ shin á kpẹ ọnkyẹ shin o so kẹ ọnhuọ utoo, ọYẹsọ lẹ onun ma shin, “Unse wan ọsọ unu kon son otoo shin unu so unu ne ubredi wan nẹ? Unu so ọnyan ushin kẹ a kpẹ wan? Ẹhurẹn hyu lẹ lakpẹkpua? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />Unu so lẹ edre, unu kẹ eshin man? Unu so lẹ atọn, unu ka kọn ma? Unu ka wan lẹ ọnlẹghẹ wan? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />Ẹlẹn shin imi a la afọn oko ubredi otong kẹ a ma ana atẹlẹ ọkọ otong, ọnzẹn ọma ma unu a lẹ akuwang lẹ ovrun nẹ?”</para>
  <para style="p" vid="MRK 8:19">E le kye ghan kẹ a kọ wan shin, Ọzẹn ọkọ lẹ ọmpua.<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />“Tuhuan lẹ shin imi lẹ afọn oko otumpua shin a ma ana atlẹ ọkọ ọnang na fa,” ọYẹsọ lẹ onun ma shin, “Onzẹn ọma ma unu a lẹ kuwang lẹ onvrun nẹ?”</para>
  <para style="p" vid="MRK 8:20">E le ekye ghan shin, “Untumpuwa.”<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />ọYẹsọ lẹ onun ma shin, “Unu so nyan ọkpẹ wan ba lẹ ẹladẹn?”<verse eid="MRK 8:21" /></para>
  <para style="s">ọYẹsọ ma ofuwo ọtrẹ kẹ ọBẹsẹda</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Lẹ shin afuwan ọBẹsẹda wọ, eple enyi ma lẹ o kon ghan ofuwo enkyi wan, kẹ awẹn nga kẹ piya ghan. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />ọYẹsọ lẹ frẹ ofuwo lan kẹ ọnyẹ kẹ oson kẹ nga kan lẹ ititim ẹshaan. Lẹ shin a ta ekpe kẹ edre enkyi lan, a lẹ a tra ghan anyẹ, tuhuan kẹ luwe ghan shin “Ngọ ushi ọnlẹghẹ?”<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />Enkyi lan la sa ẹkyuẹ kẹ a kọ ghan shin, “Imi shii ada kẹ uson, o so kawan ékyi.”<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />ọYẹsọ le e ywure kẹ a tra anyẹ kẹ aprẹn edre enkyi lan. Onwọ edre ghan lẹ okun mi, tuhuan e le eshin huọ unse wan lẹ akpẹkprẹ. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Ọnwọ ọYẹsọ lẹ laa ghan kẹ eywure ghan ẹshan ghan, shin, “kalẹ ngọ ywure kan ngọ lẹ ọmẹ arẹn ẹshan na ma.”<verse eid="MRK 8:26" /></para>
  <para style="s">Ọnkyẹ shin uBitrus too kẹ aprẹ ọYẹsọ</para>
  <para style="r">(<ref loc="LUK 9:18-21">ULuka 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Tuhuan ọYẹsọ kẹ apaduwan nga lẹ okpon kan lẹ ọmẹ arẹn áshan ọKaisariya uFilibi. O so kẹ ọntran e le onun apaduwan nga, shin, “Enga nga ada shin oso imi?”<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />Á lẹ a kọ wan shin “Eple enyi ma shin ọYohanna ana udu ọbaftisma, eple enyi ma shin, Iliya, eple enyi ma tọ kọ wan shin, eple onu ghan.”<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />“Tushin unu fa?” “Ẹnga nga unu shin oso imi?”</para>
  <para style="p" vid="MRK 8:29">UBitru le ekye ghan shin, “Ngọ nga uso uKristi.”<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />Ọnwọ ọYẹsọ lẹ owo wan atọn shin, “kalẹ otoo alọ ihyuu ghan ma.”<verse eid="MRK 8:30" /></para>
  <para style="s">ọYẹsọ too ute ukpo shin ẹngan nii ukpo ghan</para>
  <para style="r">(<ref loc="LUK 9:22-27">ULuka 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />A lẹ a tẹkpa ulolo apaduwan nga shin, Arẹn enyetri enii ọkọọn ọlọ kẹ itite, ana ukon ekye, akpẹ ume enshin, kẹ ana ulolo iywuro nii ọtran ma ẹnga. E nii ọprẹ ghan, tushin aywuẹ ataa kan lẹ ekye e nii ọnyuọn nga lẹ ọtrẹ. <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />O too aprẹ lẹn la kpekre. Tuhuan uBitrus lẹ wo ghan kan lẹ ayẹ, kẹ afrẹ ọprẹ lẹ ghan.<verse eid="MRK 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33" />Tushin lẹ ọYẹsọ kyem kẹ eshin apaduwan nga, a la prẹ lẹ uBitrus, shin, “Nya ngọ kẹ empakye mi, Ana-atuwan!” “Kẹ ẹngọ so ngọ kẹ ọnhuọ rẹn ẹhurẹ ngọ kẹ aprẹ ọnkyẹ Ọnọm ma, sẹ ọma enyetri.”<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />Tuhuan a lẹ a dra idri ada kẹ apaduwan nga ba lẹ ọnhuọ ywa ghan, kẹ a kọ ghan lẹ ẹma shin, anushin enii ure mi ma, ana tran nga ẹkyuẹ ghan, tuhuan kẹ akpọn ekyi ọsẹsra ghan kẹ re mi ma. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />Kẹ ididu anushin a biyan ufuwo ọrẹ ghan, e nii nga ukon ma. Tuhuan ididu anushin o kon ghan ọrẹ ghan ma sablọ imi, kẹ sablọ utoo ihyuu ishishi, e nii ufuwo kọ. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Kyẹ ọgyagyuan shin enyetri kon ohun, kẹ enshe ọrẹ ghan? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Unse wan enyetri tọ emle ọma kẹ ofuwo ọrẹ ghan? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />Ididu anushin áà kọn ọwa mi, kẹ ọwa utoo ihyuu ishishi mi kẹ ẹnyẹn ẹlẹn ililu kẹ udu ilovro la apam, Arẹn enyetri kẹ ẹkyuẹkyuẹ ghan enii ọhuọ kọn ọwa ghan, Shin a ba kẹ ọmẹ ọdọ ẹgọn ekye ghan kẹ atuwan Ọnọm a ma ẹsẹẹ.<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />ọYẹsọ la kọ ghan lẹ ẹma shin, ẹplẹpan imi kya utoo unu, eple enyi ma kyẹn kẹ ọnhuen ee nii ma ukpo wan ma, sẹ e shin ọba ẹgọn Ọnọm kẹ ọdọ ghan.<verse eid="MRK 9:1" /></para>
  <para style="s">Ukye ẹgbẹna ọYẹsọ</para>
  <para style="r">(<ref loc="LUK 9:28-36">ULuka 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />Aywuẹ ekyen la hurẹ ukpon, ọYẹsọ la kpọn uBitrus kẹ ọYohanna kẹ ọYakubu, ka kpọn wan ka lẹ aprẹn ọpan, ba alọ soo kẹ ẹma ma. e le shin ukye ẹgbẹna ọYẹsọ kẹ aprẹn iredre wan. <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />Tuhuan ọnkyẹ ghan lẹ ekye kẹ unkyukyi la trẹt, bọ ana hulo ọnkyẹ shin atọ abran uhuro wan klan ma. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Tuhuan e le eshin Iliya kẹ uMusa o tro o kon ọpiya onyun kẹ ọYẹsọ.<verse eid="MRK 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5" />UBitru la kọ ghan lẹ ọYẹsọ shin, Ekye abaan, uso kẹ agyagyuwan enyi so kẹ ọnhuẹn. Ẹnyi nii ọvran onko ataa, uzun ọnwa ngo, uzun ọnwọ uMusa tuhuan uzun ọnwọ Iliya. <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />UBitru la pẹ klan, sablọ shin eji la kpa wan bọ akpẹ ọnkyẹ utoo wan.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />Enkuwen la fraa wan kan, ala kọn iwe kẹ ọmẹ enkuwen lan shin, Arẹn imi ngẹn, ẹmbiyan mi, unu ngẹn nga atọn.<verse eid="MRK 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 9:8" />E le kyrem la yrẹ bọ e shin alọ wan sẹ ọYẹsọ ghan oso kẹ ma.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />O so kẹ ọnhuọ ushri ba wan lẹ ẹbọn, ọYẹsọ lẹ wo wan atọn shin kalẹ unu too alọ ọnkyẹ shin unu eshin ma, sẹ Arẹn Enyetri nyẹnya kẹ ọmẹ itun. <verse eid="MRK 9:9" /><verse number="10" style="v" sid="MRK 9:10" />Tushin e lẹ etighe aprẹ ọYẹsọ lan kẹ ọmẹ ẹhurẹ wan, tuhuan kẹ afrẹ uluwe eple wan shin, unse wan uso ọnyan kẹ ọmen itun.<verse eid="MRK 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11" />E le luwe ghan shin unse wan ọsọ ávuwa ulolo iywuro too shin onu Iliya nga enii ọtẹkpa ọba?<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />ọYẹsọ la kọ ghan lẹ ẹma shin, ẹplẹpan ya onu Iliya ghan lẹ ọtẹkpa ọba, kẹ sem ọnkyẹ. Tushin unse wan ọ sọ shin arẹn kẹ ọmẹ Ọzaa Ẹgọn shin “Ọnọm shin Arẹn Enyetri lẹ hyua ẹva tuhuan enii ọtran ma ẹnga?” <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Tushin imi kon utoo unu Onu Iliya ọba, ada lẹ du ghan onkye shin ẹma biyan, kawan emle shin Ọzaa Ẹgọn Ọnọm too kọ.<verse eid="MRK 9:13" /></para>
  <para style="s">ọYẹsọ ma arẹn shin o so lẹ ulo Ọnsha ọtrẹ</para>
  <para style="r">(<ref loc="LUK 9:37-43">ULuka 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Lẹ shin ọYẹsọ, uBitrus, ọYohanna kẹ ọYakubu ywure ba lẹ ọnhuọ a maa apaduwan ghan na, a lẹ okon idrii ada kee wan kan. Ávuwa ulolo iywuro tọ uso kẹ ọnhuọ ya ẹna kẹ ma. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Lẹ ushin ọYẹsọ, a la kọn ọvrọ, a lẹ kan sọ ọYẹsọ andakyẹ.<verse eid="MRK 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 9:16" />ọYẹsọ le luwe apaduwan ghan shin, “Ẹna unse ya unu kon ọya kẹ ma?”<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />Ana onzun kẹ ọmẹ idri ada lan lẹ akọ ghan lẹ ẹngan shin, Ekye Abaan, imi o kon arẹn mi ma, sablọ shin oso lẹ ọnsha shin u kẹ re ghan ọpẹ. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Ididu ẹlẹn shin ẹsha lan nya nga, ẹ kẹ la ghan kẹ ẹbọn. Ẹ ka sọ ghan uwli unfu onyun, kẹ ọnuan edriin ghan kẹ a nuwan nga. Imi otoo apaduwan ngọ kẹ we ghan ẹsha lan, tushin e mle wan ma.<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />ọYẹsọ la kọ ghan lẹ ẹma shin, unu ana ẹladẹn, unu anushin unu so unu lẹ ọdọ ẹhurẹ wan, imi nii ywua kẹ unu kan lẹ ulon ubon? Imi nii utre-ẹhurẹ<note caller="+" style="f"><char style="fr" closed="false">9:19 </char><char style="ft" closed="false">Utre-ẹhurẹ ọnwọ uso udu enhuri lẹ ọnlẹghẹ.</char></note> mi kẹ unu kan lẹ ulon ubon? Unu kon mi arẹdran ma.<verse eid="MRK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 9:20" />A lẹ okon arẹdran ba lẹ ọnhuọ ywua ghan. Lẹ ẹsha lan shin ọYẹsọ, ẹ la la ghan kẹ ẹbọn, a la nẹghẹ lẹ ẹgbẹna kẹ afrẹ uywrom kẹ ẹbọn lẹ uwli unfu kẹ onyun.<verse eid="MRK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21" />ọYẹsọ le luwe ekye arẹdran, “Kyuwo ulon ubon ghan wọ ulo lẹn ọtẹkpa kọ?”</para>
  <para style="p" vid="MRK 9:21">Ekye lẹ la kọ ghan shin, “kyuwo kẹ ẹramran nga. <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />Ọka ta ghan kẹ ọmẹ ọla kẹ ọmẹ ambrẹ kyẹ ọprẹ ghan, tushin inshin ẹngọ ta ọbran udu ọnlẹghẹ, ngọ shin ohuo enyi kẹ ngọ shẹ enyi ọnyẹ wọ.”<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />ọYẹsọ la kọ ghan lẹ nga shin, “Inshin imi ta ọbran nẹ? Huọ unse wan tọ udum kẹ ọnhuọ ana akpọn lẹ ẹhurẹ ghan.”<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />Kẹ ẹladran ekye arẹdran la shẹ ẹkpa wọ kẹ akọ ghan shin “imi akpọn lẹ ẹhurẹ mi, shẹ mi ọnyẹ kẹ ọmẹ shin imi so mi lẹ ọdọ ẹhurẹ wan.”<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />ọYẹsọ le shin idrii ada kyan ba lẹ ọnhuọ ọywua ghan, a lẹ la ẹsha lan onyun, kẹ akọ ghan lẹ ẹnkọ shin ngọ ẹsha ure ọpiya onyun kẹ ẹnkọ ure ọkọọn aprẹ, tro kẹ ọmẹ arẹndẹn, kalẹ ngọ tọ nyẹran nga ma.<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />Ẹsha lẹ ashẹ ẹkpa wọ tuhuan kẹ mra arẹndran kẹ ẹbọn, arẹdran lẹ oywurom kẹ ẹbọn tuhuan ẹsha lan lẹ oroo kọ kẹ ọmẹ arẹndran, arẹndran la naa ghan kawan ọkrọọ. Ada la pẹ shin okpo ghan. <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />ọYẹsọ la frẹ ọnyẹ arẹndran kẹ nyuọ ghan, ala tigha.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />ọYẹsọ huọ nyẹran ọmẹ abaan, apaduwan nga lẹ re ghan kan, kẹ luwẹ ghan kẹ ututuwo shin, “Unsẹ wọ ọ sọ shin ẹnyin bran wan uwẹ ẹsha lan ma?”<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />ọYẹsọ la kọ ghan lẹ ẹma shin, ute ọmẹ nẹ kẹ tro wan ma sẹ lẹ ọpẹlọnọm.<note caller="+" style="f"><char style="fr" closed="false">9:29 </char><char style="ft" closed="false">Uple ọrẹn ikyikyuwo sọ ẹnkẹn abraan nẹ shin, “ọYẹsọ la kọ ghan lẹ ẹma shin, ute ọnkyẹ lan kẹ otro wọ wan sẹ lẹ ọpẹlọnọm kẹ ukon ọhyuọ.”</char></note><verse eid="MRK 9:29" /></para>
  <para style="s">ọYẹsọ ywure kẹ too ute ukpo shin ẹnga nii ukpo ghan</para>
  <para style="r">(<ref loc="LUK 9:43-45">ULuka 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />A la nya kẹ ọnhuọ lan, kẹ kpon kẹ ọmẹ ẹbọn ọGalili, bọ ọYẹsọ nii shin alọ za wan, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />sablọ shin oso kẹ ọnhuọ ulolo apaduwan nga lẹ too wan shin, “Enii ọfrẹ Arẹn Eyetrii kẹ ma ẹyetrii. Enii ọprẹ ghan, tushin a lẹ ọnyuọn nga kẹ ọmẹ itun kẹ aywuẹ ẹntaan.” <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />A la kpẹ wan ọnkyẹ shin otoo wan, tushin a kọọn ibun uluwẹ ghan.<verse eid="MRK 9:32" /></para>
  <para style="s">Ẹnga nga o so ana alalẹ kẹ ọmẹ enyi?</para>
  <para style="r">(<ref loc="LUK 9:46-48">ULuka 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />A la fuwan ọKafarnahum. Ẹlẹn shin a nyẹran ọmẹ abaan wọ, ọYẹsọ lẹ luwe wa shin, “Ẹna unse ya unu kon ọya kẹ eple kẹ ọntraan?” <verse eid="MRK 9:33" /><verse number="34" style="v" sid="MRK 9:34" />Ala pẹ wa ma sablọ shin aya ẹna kẹ ọmẹ ma kẹ ọntraan shin, ẹnga ghan o so ana lale kẹ ọmẹ ma.<verse eid="MRK 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 9:35" />ọYẹsọ la trẹtra kẹ a draa apaduwan nga ana ọkọ lẹ apuwa lan kẹ a kọ ghan lẹ ẹma shin, “Inshin alo kẹ ọmẹ nii ukye ana ekye, sẹ ekye ana ọplẹ, kẹ kye ẹkyuẹ ghan agrẹn a nga ada.” <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />A lẹ kpọn arẹn hyuẹ kẹ tighe ghan kẹ ẹmpakye wan, kẹ hua ghan, kẹ kọ ghan lẹ ẹma shin, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />“Ididu anushin a ngrẹ arẹn ọhyuẹ kawa arẹdẹn sablọ ọntua mi, imi nga a ngrẹ. Tuhuan, ididu anushin a ngrẹ mi, kyẹ imi nga angrẹ man, anushin a tuwan mi nga angrẹ.”<verse eid="MRK 9:37" /></para>
  <para style="s">Anushin o so ghan kẹ ọnhuọ du ifuwo kẹ enyi ma, a nga enyi nga</para>
  <para style="r">(<ref loc="LUK 9:49-50">ULuka 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />ọYohanna la kọn lẹ ghan shin, “Avuwa,” “Enyi e shin eple nyi kon urẹ ọnsha lẹn ọntua ngọ, enyi lẹ to ghan shin a laa kan sablọ o so ghan kẹ ọmen enyi ma.”<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />ọYẹsọ la kọn lẹ ẹma shin, kalẹ unu re ghan ma, sablọ shin bọ anushin enii udu ọnlẹghẹ ọvrọ kẹ omẹn ọntua mi, tuhuan kẹ too aprẹ ililu kẹ aprẹn ẹkyuẹ mi kẹ ẹladran ma. <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />Kẹ ididu anushin oso ghan ofuwo enyi ma, a nga enyi nga. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />Imi otoo unu ẹplẹpan, ana shin a ma unu ambrẹ ọhyua kẹ ọmẹ ọntua mi sablọ shin unu ana uKristi wan, a lẹ ọma ghan ọka ghan.<verse eid="MRK 9:41" /></para>
  <para style="s">Ọnkyẹ ọ sọ ọkpaa</para>
  <para style="r">(<ref loc="LUK 17:1-2">ULuka 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />Anushin a sọ ana ozun kẹ ọmẹ arẹn ọrẹ shin a ngrẹ mi nẹ udu ilovro, ọlẹ ọsrẹ ghan lẹ ọkọka shin o loo ghan ẹntrẹtra ọkọọ ẹlẹlẹ kẹ ọntọn tuhuan kẹ a ta ghan kan lẹ ọmẹ udrin. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />Inshin ọnyẹ ngọ kẹ a sọ ngọ udu ilovro, ngọ fa wọ, sablọ shin unii ọ srẹ ngọ nyẹran abaan ọrẹ lẹ ọnyẹ uzun, lẹ shin ẹngọ nyẹran omẹn ọla kẹ anyẹ ngọ kẹ apuwa, bọ ọla lan nii ukpo wọ wan. <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />Ọnhuọ shin ingigun yọ kẹ ekyure yọ ghan ma, tuhuan ọla lan a kẹ prẹ wan ma. <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />Inshin ọfraan ngọ kẹ a sọ ngọ udu ilovro, ngọ fa wọ, sablọ shin unii ọ srẹ ngọ nyẹran abaan ọrẹ lẹ ọfraan uzun, lẹ shin ẹngọ nyẹran omẹn ọla kẹ afraan ngọ kẹ apuwa. <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />Ọnhuọ shin ingigun yọ kẹ ekyure yọ ghan ma, tuhuan ọla lan a kẹ prẹ wan ma. <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />Inshin iridre ngọ kẹ a sọ ngọ udu ilovro, ngọ we ya, sablọ shin unii ọ srẹ ngọ nyẹran Ẹgọn Ọnọm lẹ iridre izun, lẹ shin ẹngọ nyẹran omẹ ọla kẹ iredre ngọ kẹ apuwa. <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />Ọnhuọ shin ingigun yọ kẹ ekyure yọ ghan ma, tuhuan ọla lan a kẹ prẹ wan ma.<verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />Enii uhuro huọ ẹnga nga lẹ ọnlẹgha kẹ wa emle shin a kẹ sem ọnlẹghẹ lẹ ọla wọ.<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />Ọnligha so kẹ agyagyuwan, tushin inshin ọnligha bẹn ma, unse wọ enii ọ sọ kẹ ọba ushi kọ? Unu sọ ọnligha kẹ ọmẹ ẹhurẹ unu, kẹ unu ywa lẹ enshii kẹ eple.<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">Ululo kẹ aprẹ ọprẹ ọbra</para>
  <para style="r">(<ref loc="LUK 16:18">ULuka 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Lẹ ushin ọYẹsọ nya kẹ ọnhuọ lan a lẹ okpon kan ghan use ọYahudiya tuhuan kẹ akpẹn igoo Urdun kan lẹ use utro Ọnọm, ihyii ada la ywure kẹ a klan kẹ ọnhuọ ọywua ghan, a lẹ lolo wan emle shin ẹnga kẹ odu wọ.<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />Eple aFarisiyawa la ba kẹ a wa maa ghan, kẹ luwe ghan shin, “Iywuro laa shin enkyi kyuran ọbra kẹ ashẹ ghan?”<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />ọYẹsọ lẹ ekye kẹ kọ ghan shin, “Unsẹ wọ iywuro uMusa tọo unu ọnkyan?”<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />A la kọ wan shin, “uMusa ma onyun shin enkyi ta rẹn ọzaa ọkyuran ọbra kẹ a ma ashẹ ghan tuhuan kẹ e re ghan.”<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />ọYẹsọ la kọ ghan lẹ ẹma shin, “Uso-akatọn unu wọ ọ sọ uMusa rẹn unu iywuro lan. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />Tushin kẹ ọtẹkpa udu ohun, Ọnọm du enkyi kẹ anshẹ. <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />Sablọ klan wọ enkyi nii ọlaa ekye ghan kẹ ẹya ghan, kẹ a wa bram kẹ ashẹ ghan. <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />Tuhuan anampuwa lan nii ukye ẹgbẹna izun, o tọ uhyu wan ẹ́gbẹna ẹpuwa wan, sẹ ẹgbẹna izun. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Ọklan wọ, ọnkyẹ shin Ọnọm trẹẹ, kalẹ ẹnyi etri plan ma.”<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />Lẹ shin eywure ghan ọmen abaan, apaduwan ghan lẹ tọ uluwe ghan aprẹ lan. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />ọYẹsọ la kọ ghan lẹ ẹma shin, anushin a laa ashẹ ghan kẹ a kpọn eple anshẹ, ẹva kọ okon udu kẹ anushin a kpọn na. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />Tushin inshin anshẹ ghan laa ekyi ghan, kẹ a kan uple ọbra, ẹva kẹ okon udu kẹ enkyi ẹmpuwan lan.<verse eid="MRK 10:12" /></para>
  <para style="s">ọYẹsọ sọ arẹn ọrẹẹ onyun esheshi.</para>
  <para style="r">(<ref loc="LUK 18:15-17">ULuka 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Ada la huọ ukọn arẹn man ba lẹ ọnhuọ ọYẹsọ sablọ kẹ a tra anyẹn ghan kẹ aprẹ man, apaduwan ghan la la wan ẹrẹnyẹ. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />Lẹ shin ọYẹsọ shin klan, a lẹ nya amuwa kẹ a kọn lẹ ma shin, “Unu la arẹn kan kẹ ba lẹ ọnhuọ ọywua mi, kalẹ unu re wan ma sablọ Ẹgọn Ọnọm ẹnko ute ekyiwan nẹ wọ. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />Imi too unu ẹplẹpan, ididu anushin a ngrẹ ghan Ẹgọn Ọnọm kawan arẹn ọhyuẹ wan nii ghan ọnyẹran kọ wan.” <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />ọYẹsọ la hua arẹn kẹ a traa wan anyẹ, ka sọ wan onyun esheshii. <figure style="fig" alt="Jesus blesses little children" file="DN00413b.tif" size="col" loc="1016" copy="Dunham" ref="10:16">ọYẹsọ sọ arẹn ọrẹẹ onyun esheshi</figure><verse eid="MRK 10:16" /></para>
  <para style="s">Arọfuwọ ana ukon</para>
  <para style="r">(<ref loc="LUK 18:18-30">ULuka 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Lẹ ushin ọYẹsọ nya uson, eple arọfuwọ lẹ etiton ba lẹ ọnhuọ ọywua ghan kawa she ongbun kẹ ẹmpakye ghan, kẹ onun nga shin, “Avuwa esheshi, unse wan imi tọ mi du kẹ imi kon ọrẹ bọ igbo?”<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />ọYẹsọ lẹ kye kẹ a kọ ghan lẹ nga shin, “Unsẹ wọ ọ sọ ẹngo a dra mi shin ana esheshi? Bọ anushin oso esheshi wan sẹ Ọnọm lehule.” <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />ọYẹsọ lẹ too ghan shin, “Ẹngo za ọnkyẹ shin iywuro too, Kalẹ ẹngọ prẹ alọ kẹ ililu wan, kalẹ ẹngọ naa kẹ ashẹ alọ wan, kalẹ ẹngọ je utuwo wan, kalẹ ẹngọ ta alọ otu kẹ ililu wan, kalẹ ẹngọ ya alọ wọ wan, ngẹn atọn lẹ ekye ngọ kẹ ẹya ngọ.”<verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />Arọfuwọ lan lẹ a kọ ghan shin, “Avuwa, imi etighe ididu ọmẹ ọnkyẹ lẹn kyikyuwo imi tọ uhyu la hyuẹ.”<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />ọYẹsọ lẹ shin ghan, a lẹ a byan ghan tuhuan kẹ kọ ghan lẹ ẹnga shin “Ọnlẹghẹ uzun ọnwọ ọtọ ngọ.” “Son kan ngọ kẹ ẹngọ ma huro ididu ọnkyẹ ngọ so lẹ ọma, kẹ ẹngo ma ana emrin, tuhuan ngọ nii u kon ọka ngọ kẹ aprẹmẹn. Tuhuan kẹ ẹngọ ma ere mi ma.”<verse eid="MRK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 10:22" />Lẹ ushin enkyi la kọọn kẹn, ukpekye ghan la bẹn wọ, a lẹ nya ghan kẹ ọnhuọ lan kẹ ọmẹ ambẹn ẹhurẹ kẹ ọsablọ shin ẹnga ana ukọn nga lakẹnkan.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />ọYẹsọ lẹ ekyem kẹ eshin tuhuan kẹ a kọn ghan lẹ apaduwan ghan shin, “U nii u so ọnaa ana ukon nyẹran ọmẹ Ẹgọn Ọnọm.”<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />Apaduwan nga lẹ a kọọn ọvrọ lẹ aprẹ shin otoo. ọYẹsọ la tọ kọ ghan lẹ ẹma shin “Arẹn, ọnyẹran ọmẹ Ẹgọ Ọnọm so ọnaa lakẹnka. <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />Unii ọsrẹ lẹ ọkọka shin arahuọmẹ nyẹran ọmẹ ukpo ẹnyuran lẹ ushin ana ukon nyẹran ọmẹ Ẹgọ Ọnọm.”<verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />Apaduwan ghan lẹ kọọn ọvrọ lakẹnkan, kẹ akọ wan lẹ ẹnga shin, “Ẹnga nga enii ukon ufuwo?”<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />ọYẹsọ lẹ eshin wan tuhuan kẹ a kọ ghan shin, “Kẹ ọnhuọ enyetri unii so ọnaa tushin bọ ọnhuọ Ọnọm ma. Kẹ bọ ọnkyẹ ushin ọ tọ ọlaa udum kẹ ọhuọ Ọnọm ma.”<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />uBitrus lẹ frẹ utoo ghan shin, “Enyi a laa ididu ọnkyẹ enyi kẹ e re ngọ kan.”<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />ọYẹsọ lẹ a kọ ghan shin, “Imi kyan utoo unu ẹplẹpan, ididu anushin aa laa abaan nga, ewedri ghan huọ afuwọ ghan, ẹya huọ ekye ghan, arẹn nga huọ ente ghan kẹ ọ sablọ imi kẹ ihyuu ishishii; <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />ana nii ukon ọnkyẹ shin ẹnga laa kọ ọsrẹ atẹlẹ kẹ ọmẹ ẹlẹn nẹ, ábaan, ewedri, afuwọ, eye, arẹn kẹ ente, kẹ ọkọọn ẹva, kẹ ẹlẹn ọkyan enii ukon ọrẹ bọ igbo. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />Tushin anushin oso kẹ ekye kẹ ẹladẹn nii ukye ana ititim, anushin oso kẹ ititim kẹ ẹladẹn nii ukye ana ekye.”<verse eid="MRK 10:31" /></para>
  <para style="s">ọYẹsọ tọ uywure kẹ otoo aprẹ ukpo ghan</para>
  <para style="r">(<ref loc="LUK 18:31-34">ULuka 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />O son kẹ ọntraan kan wan lẹ Urushẹlima, ọYẹsọ tọ u son kẹ ekye wan, apaduwan nga lẹ kọn ọvrọ, anushin o tọ ure wan kan kẹ ititim tọ kọọn ibun. ọYẹsọ lẹ tọ uywure kẹ kpọn ana ọkọ lẹ apuwa lan kan lẹ ayẹ kẹ too wan ọnkyẹ shin u nii ọba ghan. <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />A lẹ kọn shin, “Unu shin, enyi kyan ọnya kan wan lẹ Urushẹlima,” ọnhuọ shin á kẹ ma Arẹn-Enyetri kẹ ọmẹ anyẹ akpẹ ume enshin kẹ ávuwa ulolo iywuro. A ma onyun shin apre ghan tuhuan e nii ọma ghan kan lẹ ọmẹ anyẹ anushin o so wan aYahudawa wan. <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />E nii ọkrọọ ghan kẹ a tlẹ ghan lẹ ekpe, kẹ taa ghan iluwe tuhuan kẹ aprẹ ghan. Tushin enii ọnyuọn nga kẹ ọmẹ itun kẹ aywuẹ ẹntaan.<verse eid="MRK 10:34" /></para>
  <para style="s">ỌYakubu kẹ ọYohanna wan ọYẹsọ shin o du wan ọnlẹghẹ</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />ỌYakubu kẹ ọYohanna, árẹn ọZebedi ba lẹ onhuọ ywua ọYẹsọ, kẹ otoo ghan shin “Avuwa, enyi abiyan shin ẹngọ du enyi uple ọnlẹghẹ, du enyi ididu ọnkyẹ shin enyi wan ngọ.”<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />ọYẹsọ lẹ eluwe wan shin “Unse wan unu abiyan shin imi udu unu?”<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />E lẹ ekye kẹ a kọ wan shin, “Laa ana ozun kẹ ọmẹ enyi kẹ atrẹtra kẹ onyẹ ẹya ngọ, kẹ anga enyi trẹtra kẹ onyẹ ipre ngọ kẹ ọmẹ Ẹgọn ngọ.”<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />ọYẹsọ la kọ ghan lẹ ẹma shin “Unu za unu ọnkyẹ shin unu kon ọwẹn ma. Unu tọ umle ọhyua lẹ ẹnsẹ ẹva shin imi nii ọhyua huọ o du unu ọbaftisma shin e nii udu mi?”<verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />A la kọ wan shin, “Enyi tọ braan,” ọYẹsọ la kọ ghan lẹ ẹma shin, “Unu nii umle ọhyua lẹ ẹnsẹ ẹva shin imi nii ọhyua tuhuan e nii udu unu ọbaftisma shin o du mi. <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />Tushin ọtrẹtra kẹ ọnyẹ ẹya mi kẹ ọnyẹ ipre mi, kyẹ imi nga a tọ ma unu ọnwọ lan ma. Ọnhuọ lan uso ọnwọ anushin Ọnọm sem kẹ sablọ ẹma.”<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />Lẹ ushin ana ọkọ lan huọ kọọn klan, a lẹ frẹ ọnyẹ amuwa lẹ ọYakubu kẹ ọYohanna. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />ọYẹsọ lẹ a dra wan ba lẹ ọnhuọ uzun, kẹ kọ ghan lẹ ẹma shin, “Unu za shin ana ukon ekye kẹ ọmẹ anushin o so wan Ayahudawa wan, a kẹ nyin ma ọdọ wan tuhuan ana adradọ wan kẹ enyin ma ọdọ. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />Kalẹ unu du klan ma, anushin e nii ukye ana alalẹ kẹ ọmẹ unu sẹ ekye agrẹn unu. <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />Tuhuan ididu anushin e nii uso ana ekye sẹ ekye agrẹn anga ada lẹ ididu. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Sablọ shin huọ Arẹn Enyetri ba ghan kẹ awan du ghan ẹgrẹn ma. Aa ba udu ẹgrẹn tuhuan kẹ a ma ọrẹ ghan kẹ enshe ufuwo ada lẹ ampam.”<verse eid="MRK 10:45" /></para>
  <para style="s">ỌBatimawus, ofuwo kon ọtrẹ</para>
  <para style="r">(<ref loc="LUK 18:35-43">ULuka 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />ọYẹsọ kẹ apaduwan nga ba lẹ ọmẹ uYeriko. Lẹ shin àá kyẹ ọ huọ laa ẹshan na, ihyii ada lẹ re wan kan. Eple ofuwo ana ọwẹn shin adrọ ghan shin ọBartimawus (arẹn Timawus) la trẹtra kẹ ọnhuọ ọwẹn kẹ ayẹ ọntraan. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />Lẹ ushin ofuwo lan kọọn shin ọYẹsọ ana ọNazaret ghan a kya ukpon, a la frẹ utri ẹkpa lẹ otoo shin “ọYẹsọ arẹn ọDawuda shin ohuo mi.”<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />Ada lẹ ampam lẹ agọ lẹ ẹnga shin a fuwa. A lẹ frẹ ọkẹn ẹkpa lakẹnkan lẹ o too shin, “Arẹn ọDawuda shii ohuo mi.”<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />ọYẹsọ lẹ tigha kẹ kọ ghan shin “Unu draa ghan ma”, a la draa ofuwo lan kẹ otoo ghan shin “Mọ! Nyẹnya ọYẹsọ drọ ngọ.” <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />A la ta ọglọ ghan wọ, tuhuan kẹ a ta ifro ba lẹ ọnhuọ ọYẹsọ.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />ọYẹsọ lẹ onun nga shin “Unse wo ẹngo nii shin imi du ngọ?” Ofuwo lan lẹ akọ ghan shin, “Avuwa, imi nii ushin ẹhuọ.”<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />ọYẹsọ la kọ ghan lẹ ẹnga shin, “Kpon kan ngọ, ọdọ ẹhurẹ ngọ ma ngọ ọtrẹ.” Kẹ ẹladran, iredre ghan lẹ okun mi. Tuhuan a lẹ ere ọYẹsọ kan, a la kpon kan wan.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">ọYẹsọ nyẹran ọmẹ Urushẹlima</para>
  <para style="r">(<ref loc="LUK 19:28-40">ULuka 19:28-40</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Lẹ shin ọYẹsọ kẹ apaduwan nga fuwan akaka Urushẹlima, kẹ ọBetafaji kẹ ọBetani ọnhuọ ọnkọn uZaitun, ọYẹsọ la tuwan apaduwan nga ana ampuwa. <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />O lẹ otoo wan shin “Unu so kan lẹ arẹn ẹshaan shin o so kẹ ẹmpakye unu. Lẹ ọnyẹran unu, unu nii ushi eple arẹn ẹnjakyẹ shin e re<note caller="+" style="f"><char style="fr" closed="false">11:2 </char><char style="ft" closed="false">O loo</char></note>, alọ so nya nga ọ nya ma, unu ble ya kẹ unu kon mi ya wan. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />Inshin alọ luwe unu shin, ‘Unsẹ wọ ọ sọ unu kẹ udu kẹn?’ Unu too ghan shin ‘Ẹkyẹ-Abaan nga enii ya tuhuan enii ywure lẹ ẹnya ba lẹ ọnhuẹn kẹ ẹladran.’ ”<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />Apaduwan apuwa lan lẹ kpon kan wan. A la kan okon ya kẹ ulilo kẹ ayẹ abaan kẹ onyun ọntraan. O huó uso kẹ ọnhuọ uble ya, <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />anushin akyẹn kẹ ọnhuọ lan lẹ kọ wan lẹ ẹma shin, “Unse wọ ọ sọ unu kon uble ẹnjakyẹ lan?” <verse eid="MRK 11:5" /><verse number="6" style="v" sid="MRK 11:6" />A la huọ ukye wan kawan emle shin ọYẹsọ too wan wọ. Ekyiwana la laa wan kẹ kpon kan wan. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Ẹlẹn shin okon ẹnjakyẹ lan ba lẹ ọnhuọ ọYẹsọ e lẹ eshre ọngbapiya wan kẹ aprẹn ẹnjakyẹ lan, ọYẹsọ lẹ nya aprẹn nẹ kẹ trẹtraa. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Ada lẹ ampam lẹ tla ọngbapiya wan kẹ enzen ma kẹ aprẹn ọntraan, alọ wan lẹ a kẹ plan azaa ekyi kẹ ọmẹ onum kẹ a huọ ushre yọ kẹ ọntraan. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Anushin o so kẹ ekye ghan kẹ anushin o so e re ghan ma lẹ frẹ taa akpa lẹ too shin, “Osana<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="ft" closed="false">Osana ẹtọprẹẹ ọ sọ oshon ya ẹnyọ a kẹ sọ osoon alalẹ kọ sablọ shin a blẹẹ ghan.</char></note>!” Onyun esheshii kẹ aprẹn anushin aa ba kẹ ọmẹ ọntua Ekye Abaan. <verse eid="MRK 11:9" /><verse number="10" style="v" sid="MRK 11:10" />Ọnọm sọ onyun esheshii kẹ aprẹn Ẹgọn ẹnkọ ẹkyenyi ọDawuda shin ẹ kyan kẹ ọmẹ ọntua Ekye abaan enyi: “Osana kẹ aprẹn ẹkyuẹ anushin amẹẹ ọdọọ.”<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />Lẹ ọshin ọYẹsọ nyẹran ọmẹ Urushẹlima, kẹ nyẹran kan lẹ ọmẹ Abaan Ọnọm, e lẹ ekyrem kẹ shin ididu ọnkyẹ tuhuan kẹ o roo ghan sablọ ọnhuọ kyan anlẹ. A lẹ ywure ghan ọBetani kẹ apaduwan nga ọkọ lẹ apuwa lan. <figure style="fig" alt="Jesus entered Jerusalem on a donkey" file="DN00487b.tif" size="col" loc="11:11" ref="11:11">ọYẹsọ nyẹran ọmẹ Urushẹlima kẹ aprẹn ẹnjakyẹ</figure><verse eid="MRK 11:11" /></para>
  <para style="s">ọYẹsọ sọ ekyi untron onyun</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Ọnwa ubun lẹ shin a laa ọBetani wọ, ọYẹsọ lẹ a kọn ẹwọn. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Lẹ ushin ekyi untron kẹ azaa ghan kẹ ananọ, a la kan lẹ ọnhuọ ekyi lan, bọ ekyi lan so lẹ ẹkraa wan sẹ azaa, sablọ shin kyẹ ẹlẹn shin ekyi lan kẹ a ma ẹkraa kọ wan. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />ọYẹsọ la kọ ghan lẹ ekyi lan shin, “ka le alọ tọ ọya ẹkraa ngọ ma kan lẹ igbo ohun.” Apaduwan nga tọ huọ kọọn ghan.<verse eid="MRK 11:14" /></para>
  <para style="s">ọYẹsọ re ana udu itrim kẹ ọmẹ Abaan Ọnọm</para>
  <para style="r">(<ref loc="LUK 19:45-48">ULuka 19:45-48</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Lẹ shin afuwan Urushẹlima, ọYẹsọ la nyẹran kan ghan lẹ ọmẹ Abaan Ọnọm kẹ a ọtẹkpa ọta igli lẹ anushin okon uri kẹ uhuro ọnkyẹ kẹ ọmẹ ọnhuọ lan. A la sigha etebur ọma ana umee enshee ikli ke ọntrẹtra anushin o kon uhuro orondon <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />A lẹ ere alọ ọkpọn ọnlẹghẹ kẹ okpon kẹ ọmẹ Abaan Ọnọm na. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Tushin o lẹ o lolo wan shin, “Arẹn wan shin e nii ọdraa abaan mi nẹ shin abaan ọpẹlọnọm ma?” Tushin unu e kye kọ kẹ asọ shin i kyee ọnhuọ dẹlẹ otuo.<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />Lẹ shin akpẹ umee-enshin kẹ ávuwa ọza iywuro kọọn klan, a lẹ frẹ unii emle shin ẹma nii ọprẹ ghan wọ, sablọ shin akọn ibun nga, sablọ ididu ada kon ushin ọvrọ ulolo ghan.<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />Lẹ shin ọnhuọ huọ ba anlẹ, ọYẹsọ kẹ apaduwan nga lẹ troo kẹ ọmẹ ẹshaan lan.<verse eid="MRK 11:19" /></para>
  <para style="s">Ululo bi kẹ ekyi untron</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />O son kẹ ọnhuọ ukpon lẹ oturombun, e le eshin ekyi lan hura kọ bi kẹ anaa nẹ. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />UBitru lẹ a wan tuhuan kẹ otoo ọYẹsọ shin, “Avuwa, shii! Ekyi untron shin ẹngọ sọ kọ onyun na hura kọ.”<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />ọYẹsọ lẹ kọ ghan lẹ ẹma shin, “Unu kon ọdọ ẹhurẹ kẹ ọmẹ Ọnọm.” <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />“Imi too unu ẹplẹpan, inshin a lọ unu kpọn lẹ ẹhurẹ ghan kẹ akọ ghan lẹ ẹfọ lẹn shin, ‘Kpon kan ngọ kẹ ngọ ma ta ẹkyuẹ ngọ kan lẹ ọmẹ udrin,’ bọ ẹhurẹ ghan wẹ ya wan, enii udu ghan ididu ọnkyẹ shin a wan. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Ọnwọ ọ sọ imi kon utoo unu, ididu ọnkyẹ shin unu wan kẹ ọmẹ ọpẹlọnọm, unu kpọn lẹ ẹhurẹ unu shin unu hurẹ ọngrẹn wọ, tuhuan unu nii ukon wọ. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />Tushin inshin ididu ẹlẹn shin unu tigha kyẹ ọpẹlọnọm, inshin unu kon alo lẹ ẹhurẹ unu, unu ywuro ghan ilovro ghan, sablọ Ekye unu kẹ aprẹmẹn huọ uywuro unu ilovro unu.”<verse eid="MRK 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 11:26" />Tushin inshin unu a tran unu uywuro ilovro ẹnyọ anushin o du unu ilovro, Ekye unu kẹ aprẹn nii ghan u huọ uywuro unu ilovro unu ma.<note caller="+" style="f"><char style="fr" closed="false">11:26 </char><char style="ft" closed="false">Ọrẹn ikyikyuwo so wọ lẹ ẹnkẹn abraan lẹ man.</char></note><verse eid="MRK 11:26" /></para>
  <para style="s">E luwe kẹ aprẹ ọdọ ọYẹsọ</para>
  <para style="r">(<ref loc="LUK 20:1-8">ULuka 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Lẹ shin o tọ uywure kẹ nyẹran ọmẹ Urushẹlima, ọYẹsọ lẹ o so kẹ ọnhuọ son eklem kẹ ọmẹ Abaan Ọnọm, ávuwa ulolo iywuro kẹ akpẹ umee enshi, kẹ onokon ẹshaan lẹ a ba lẹ ọnhuọ ọywua ghan. <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />E le eluwe ghan shin, “Ulon ọdọ ghan wọ ẹngọ kon udu ọnkyẹ lẹn? Tuhuan ẹnga nga ma ngọ ọnwọ ọdọ udu ọnkyẹ lẹn?”<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />ọYẹsọ lẹ ekye kẹ kọ ghan lẹ ẹma shin, “Imi nii ọhuọ unun unu aprẹ ozun tuhuan inshin unu ngrẹ mi ọnkyẹ shin imi eluwe unu, imi nii u huọ utoo unu ọnhuọ shin imi okon ọdọ udu ọnkyẹ len. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />Unu too mi, ọbaftisma ọYohanna bi kẹ aprẹmẹn ta huọ tọ ubi kẹ ọnhuọ enyetri dẹn?”<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />A la frẹ ọya ẹna kẹ ọmẹ ma, a lẹ a kọ wan shin, “Inshin enyi a pẹ shin ‘U bi kẹ aprẹmẹn,’ enii uluwe enyi shin, ‘Unsẹ wan ọ sọ unu kpọn unu ọYohanna lẹ ẹhurẹ unu ma?’ ” <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Inshin enyi otoo shin “ubi kẹ ọnhuọ enyetri” (a kọn ibun ada sablọ shin ididu ada lẹ a kpọn shin ọYohanna onu Ọnọm nga lẹ ẹplẹpan.)<verse eid="MRK 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 11:33" />Ọklan wọ a la kọ wan shin, “Enyi za wan man.”</para>
  <para style="p" vid="MRK 11:33">ọYẹsọ la huọ kọ ghan shin, “Imi huọ unii mi uto unu huọ ulon ọdọ ghan wọ imi kon udu ọnkyẹ lẹn wọ ma.”<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">Ẹsẹẹn kẹ aprẹ ana ọtuan kẹ ọmẹ onum enebi</para>
  <para style="r">(<ref loc="LUK 20:9-19">ULuka 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />ọYẹsọ lẹ o too wan ẹsẹẹn kẹ a kọ ghan lẹ ẹma shin, “Eple enkyi lẹ esem onum ghan, kẹ kee kan, kẹ tun ugo uton orun ẹkra ekyi lan, kẹ vran unko aprẹn ọnwọ anọzọ. A lẹ a ma anushin alọ uhuọ ukon aklọ lẹ onum na, tuhuan kẹ kan uson nga. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />E lẹn ọkrọọ ẹkra ekyi lan kẹ a ba, ana onum lan lẹ a tuwan agrẹn nga kan lẹ ọnhuọ ana ukon aklọ lẹ onum lan kẹ awa ma nga ọka ẹkra ekyi ghan. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Ana ukon aklọ lan lẹ frẹ agrẹn na kẹ kẹn nga tuhuan kẹ re ghan kẹ anyẹ ghan ahuọ <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Ana onum lan lẹ ywure kẹ atuwan eple agrẹn nga kan lẹ ọnhuọ ana ukon aklọ lẹ onum lan, a la kẹn nga kẹ zọn nga ẹkyuẹ kọ tuhuan kẹ a trọ lẹ ghan. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />E lẹ eywure kẹ tọ ọtuan eple agrẹn nga, a lẹ ka prẹ ghan. Emle lan ghan wọ, a lẹ frẹ ọtuan eple enyi ma lẹ ampam, a lẹ kẹn eple enyi ma tuhuan kẹ aprẹ eple nyi ma.”<verse eid="MRK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6" />Ana ozun nga kẹ atọ shin a atọ tuwan, erekyi ozun, a ngọ shin a biyan. A lẹ huọ tuwan ghan kan lẹ ọnhuọ ana ukon aklọ lẹ onum lan shin “Imi za shin e nii ushin arẹn mi lẹ iredre owaa.”<verse eid="MRK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7" />Ekyiwana lẹ otoo eple shin, “Ana ọzọ ẹntrẹtrọ lan ngẹn. Enyi ma prẹ ghan, tuhuan ọnkyẹ ghan nii ukye ọma enyi.” <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />A lẹ afrẹ ghan kẹ aprẹ, tuhuan kẹ ta ghan kan lẹ etitim onum lan.<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />ọYẹsọ lẹ eluwe wan shin “Unsẹ wọ ana onum lan nii udu? A lẹ ọba kẹ awa pẹẹ ana ukon aklọ lẹ onum lan, tuhuan kẹ a ma eple enyi ma onum lan. <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />Unu so nya unu opuwa ọzaa ẹgọn nẹ ma?”</para>
  <para style="q1" vid="MRK 12:10">“Ẹntrẹtra shin ana ọvlan tran ma, ẹnkọ ikye ẹntrẹtra shin ikon abaan. <verse eid="MRK 12:10" /><verse number="11" style="v" sid="MRK 12:11" />Udu Ekye Abaan wlan, tuhuan ọnlẹghẹ ọvrọ wọ kẹ iredre enyi.”<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />Akpẹ umee enshin kẹ ávuwa ulolo iywuro kẹ onokon ẹshaan lẹ enii emle shin ẹma nii udu kẹ ẹma frẹ ghan, sablọ shin akpẹ shin uloo too ẹsẹẹn na balẹ aprẹn ma. Tushin a kọn ibun ada, a lẹ laa ghan kan kẹ okpon kan wan.<verse eid="MRK 12:12" /></para>
  <para style="s">Ọkywura ikli egen kẹ ọnhuọ ọkaisar</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />A la tuwan eple aFarisiyawa kẹ ana Iridus, ba lẹ ọnhuọ ọYẹsọ huọ a tọ afrẹ ghan lẹ ẹtọ aprẹ ghan lẹn. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />A lẹ a ba lẹ ọnhuọ ọywua ghan kẹ wa kọ wan lẹ ẹnga shin, “Avuwa, enyi za shin ẹngọ a kẹ otoo ẹplẹpan, bọ ẹngọ kẹ a dan emle shin ada kẹ arẹn ẹhurẹ wan kọ wan. Bọ ẹngọ a ka ghẹn atọn na alọ wan, tushin ẹngo kẹ o lolo ada ẹplẹpan ọnkyẹ shin Ọnọm nii lẹ ẹma. Too enyi, u so kẹ agyagyuwan shin enyi kyura ọkaisar ikli egen ta?”<verse eid="MRK 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15" />“Enyi kyura, huọ kalẹ enyi kyura wan?” Tushin ọYẹsọ kpẹẹ shin oso kẹ ọnhuọ ọkam ghan, a la kọ ghan lẹ ẹma shin, “Unse wan ọsọ, unu kon ọkam mi? Unu kon mi ẹrẹn Udinari wan kẹ imi ma eshin.” <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />A lẹ okon ghan ma. ọYẹsọ lẹ eluwe wan shin, “Ukpekye lẹ kẹ ọntua lẹ ọma ẹnga ma?”</para>
  <para style="p" vid="MRK 12:16">A lẹ akọ wan lẹ ẹnga shin, “Ọnwọ ọkaisar wọ.”<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />Ọnwọ ọYẹsọ la kọ ghan lẹ ẹma shin, “Unu ma ọkaisar ọnkyẹ shin uso ọ ma ọkaisar, tuhuan unu huọ ọ ma Ọnọm ọnkyẹ shin uso ọ ma Ọnọm.”</para>
  <para style="p" vid="MRK 12:17">E le shin ọvrọ la kẹnkan.<verse eid="MRK 12:17" /></para>
  <para style="s">Uluwe kẹ aprẹ ọnya kẹ omẹ itun</para>
  <para style="r">(<ref loc="LUK 20:27-40">ULuka 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />Ọnwọ ana Ọsadusi (anushin a kpọn wan shin onya kẹ ọmẹ itun so wan) la ba lẹ ọnhuọ ywa ghan kẹ awa luwe ghan shin. <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />“Avua,” “uMusa rẹn enyi shin, Inshin ewedri enkyi kpon ghan ka a laa anshẹ bọ o so lẹ árẹn ma, ewedri ghan lan kpọn anshẹ lan kẹ eben ewedri ghan árẹn. <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Eple ewedri ekyi otunpuwa lẹ oso, onokon lẹ avọ anshẹ, a lẹ okpo ghan bọ arẹn. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Ana ẹmpuwan lẹ huọ ọkpọn anshẹ lan ẹnga lẹ huọ ukpo ghan bọ arẹn. Ana ẹntaan klan. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />Emle lan nga ididu wan ana Otumpua lan, ba anushin a laa arẹn ma. Kẹ amplẹ ghan anshẹ lan lẹ okpo ghan. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Anshẹ lan nii so anga ẹnga ke ọnya kẹ ọmẹ itun, kẹ ọsablọ shin ana otumpua lulo ẹbra lẹ nga?”<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />ọYẹsọ lẹ akọ ghan lẹ ẹma shin, sablọ unu za unu Ọzaa Ẹgo ma, bọ unu za ọdọ ọnwọ Ọnọm ma. wọ ọsọ unu ovro onum. <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />sablọ inshin a nyẹnya kẹ ọmẹ itun, ulolo ẹbra nii wọ uso wan, e nii ukye kawa atuwan Ọnọm shin aprẹmẹn kẹ oso ko. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />Kẹ aprẹ ọnya kẹ ọmẹ itun, unu so ọnya unu ọpua kẹ ọmẹ ọzaa uMusa kẹ aprẹ erekyi shin a kon ọya ọla wan? Emle shin Ọnọm too ghan shin, “Imi nga inso Ọnọm Ambram, kẹ Ishaku, kẹ ọYakubu?” <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Ẹnga kyẹ Ọnọm anushin ekyure wan ma ma, tushin a nga ana ọrẹ ghan. Unu ovro unu lẹ ẹplẹpan.<verse eid="MRK 12:27" /></para>
  <para style="s">Iywuro shin ẹsrẹ lẹ ọlọlẹ.</para>
  <para style="r">(<ref loc="LUK 10:25-28">ULuka 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Eple avuwa ulolo iywuro lẹ a ba kẹ wa o kon okon ya ẹna kẹ eple wan. A la okon ọYẹsọ kye wan aprẹ kẹ agyagyuwan, a lẹ luwe ọYẹsọ shin, “kẹ ididu ọmẹ iywuro, ilon nga ya ẹsrẹ lẹ ọlọlẹ?”<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />ọYẹsọ lẹ kye kẹ akọn ghan shin, “Ẹn ya ẹsrẹ lẹ ọlọlẹ ya i so, ‘Unu ngẹn atọn unu ana Izrẹla, Ekye abaan enyi Ọnọm, a nga o so ekye abaan enyi kẹ inzu ghan. <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />Biyan ekye abaan Ọnọm ngọ lẹ ididu ẹhurẹ ngọ, kẹ ididu ọrẹ ngọ, kẹ ididu ọna ẹhurẹ kẹ ọdọ ngọ.’ <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />Ẹnya ure kan ya i so, ‘Ngọ biyan onuse ankam ngọ kalẹ emle shin ngọ a biyan ẹkyuẹ ngọ.’ Iple iywuro shin ẹ̀é srẹ ẹnyẹn lẹ ọlọlẹ so ya kọ wan.”<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />Ọnwọ Avuwa ulolo Iywuro lan la kọ ghan lẹ ẹnga shin, “Ngọ otoo ẹplẹpan Avuwa, Ọnọm ozun nga, eple tọ uso ghan kọ wan sẹ ẹnga. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Tuhuan a biyan Ọnọm ne ididu ẹhurẹ, kẹ ididu ọna ẹhurẹ kẹ ididu ọdọ, tuhuan kẹ ngọ biyan onuse ankam ngọ ka wa emle shin enyi a biyan ẹkyue ghan kọ, ọsrẹ ididu ọma enshin ufiflo kẹ ọwẹwaa shin e kẹ emee Ọnọm.”<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />Lẹ ọYẹsọ shín shìn avuwa lan too ọnkyẹ kẹ agyagyuwan, a lẹ akọ ghan lẹ nga shin, “Ngọ so ngọ ananọ kẹ Ẹgọn Ọnọm ma.” Tuhuan alọ lẹ atọ ọbran nga uluwe ghan ọnlẹghẹ wan.<verse eid="MRK 12:34" /></para>
  <para style="s">Uluwe kẹ aprẹ ofuwo</para>
  <para style="r">(<ref loc="LUK 20:41-44">ULuka 20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />Lẹ shin ọYẹsọ so kẹ ọnhuọ ulolo kẹ ọmẹ abaan Ọnọm, e le luwe shin, “Kyẹ emle shin ávuwa ulolo Iywuro nii ọ kọ wan shin uKristi Arẹn ọDawuda ghan nẹ?. <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />ọDawuda kẹ ẹkyuẹkyuẹ ghan kẹ omẹ iri ẹsẹ wọ o too shin, ‘Ekye abaan too Ekye abaan mi shin, trẹtra kẹ ọnyẹ ẹya mi, sẹ imi asọ ofuwo ngọ kẹ ọmẹ ẹfa ngọ.’ <verse eid="MRK 12:36" /><verse number="37" style="v" sid="MRK 12:37" />ọDawuda kẹ kyuẹkyuẹ ghan lẹ a dra ghan shin Ekye abaan. kyẹ emle shin enii ukye arẹn ghan?”</para>
  <para style="p" vid="MRK 12:37">Idrii ada la ngẹn ghan atọn, kẹ akọọn ọmọ.<verse eid="MRK 12:37" /></para>
  <para style="s">ọYẹsọ ta avuwa ulolo iywuro kẹ etin</para>
  <para style="r">(<ref loc="LUK 20:45-47">ULuka 20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />Kẹ ọmẹ ulolo ghan, a lẹ otoo wan shin, unu kon aklọ lẹ avuwa ulolo iywuro, ana kẹ a kọn uson eklem lẹ ọngbapiya ọndrọndọ, e kẹ enii ada sọ wan andakyẹ la ablẹ wan kẹ ọmẹ ize. <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />E kẹ enii ọtrẹtra kẹ ọntrọtrọ agyagyuwan kẹ ọmẹ Onko Ọpẹlọnọm kẹ ọnhuọ ẹpan <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />A ma oso ana ọ kẹ aya ọnkyẹ ashẹ shin ekyi wan kywure wan, a kẹ akraa wan abaan tuhuan a kẹ odu ẹgbran ọpẹlọnọm sablọ ada kpọn wan shin ẹma ana ẹplẹpan ma. Ute enyima na, ẹva wan nii ọsrẹ lẹ ubibi.<verse eid="MRK 12:40" /></para>
  <para style="s">Ọma ọnwọ anshẹ shin ekyi ghan kpon ghan</para>
  <para style="r">(<ref loc="LUK 21:1-4">ULuka 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Lẹ shin ọYẹsọ la trẹtraa kẹ ayẹ ọnhuọ shin ada kon umẹ unkli kẹ ọmẹ Abaan Ọnọm, a lẹ huọ shin emle shin ada kon ume unkli lan, eple ana ukon lẹ eme la pẹmpam. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Tushin eple arahua shin ekyi ghan kpon ghan, la wa ta arẹn ikli ọyẹra apuwa shin ẹfuwan yọ ọkọbọ uzun ma.<verse eid="MRK 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 12:43" />ọYẹsọ la draa apaduwan nga ka kọ ghan lẹ ẹma shin, “Ẹplẹpan ya imi kya utoo unu, ọnkyẹ shin arahua ana emrin lẹn ma ọsrẹ ididu ọnkyẹ shin huọ engan ma kẹ ọnhuẹn. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />Kẹ Ididu ada mee kẹ ọmẹ ukon ọpam ma, tushin ẹnga kẹ emrin nga a ma ididu ọnkyẹ shin ẹnga ywa ọywua ghan lẹ hule.” <figure style="fig" alt="The giving (offering) of the poor widow" file="DN00431b.tif" size="col" loc="12:44" ref="12:44">Ọma ọnwọ anshẹ ana emri shin ekyi ghan kpon ghan</figure><verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">ọYẹsọ too emle shin e nii uvro Abaan Ọnọm kọ</para>
  <para style="r">(<ref loc="LUK 21:5-6">ULuka 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Ẹlẹn shin a kyan utro bi kọ ọmẹ Abaan Ọnọm kọ, ana ozun kẹ ọmẹ ápaduan ghan la kọọ lẹ ẹnga shin, “Avuwa, shii ẹvlan ẹgyagyuan lẹn kẹ ọntrẹtra ọvrọ ghan!”<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />ọYẹsọ la kọọ lẹ ẹnga shin, “Ẹẹn, ẹngọ shii ẹvlan ẹdẹdọ lẹn? Bọ ẹntrẹtra izun shin ẹ lẹ ọywua kẹ aprẹn iple shin enii ma ta kọ kẹ ẹbọ man.”<verse eid="MRK 13:2" /></para>
  <para style="s">Ankpẹẹ Ọnyaa Ohun</para>
  <para style="r">(<ref loc="LUK 21:7-19">ULuka 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Lẹ ushin ọYẹsọ trẹtra kẹ aprẹn ọnkọn ekyi ọZaitun kẹ afraan Abaan Ọnọm. UBitru, ọYakubu, ọYohanna, kẹ Andrawus lẹ eluwe ghan kẹ ututuwo shin, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“Too enyi, ẹlẹn shin ididu ọnkyẹ ngọ utoo lẹn nii ọba wọ? Tuhuan o lon ankpẹẹ ghan kẹ e nii unyin inshin ọnkyẹ lẹn kẹ a biyan ọba wọ.”<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />ọYẹsọ lẹ ekye wan shin, “Kalẹ unu laa alọ kẹ owun ma.” <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />Enyi ọnpam nii ọba lẹ ọntua mi, lẹ otoo shin, “Imi nga inso uKristi”. Tuhuan enii uwu ana ọmpam. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />Ẹlẹn shin unu akọọn aprẹ ọhuẹn ọna kẹ ihyuu ọhuẹn ọna, kalẹ ẹhurẹn kpa yọ wan. Ẹplẹpan ya imi too unu nẹ, ọnkyẹ lẹn nii ọba, tushin ọplẹ aywuẹ sọ nya ọba wan <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />Ọmbọn nii ọhuẹn ọnaa kẹ eple, tuhuan Ọngọn kẹ Ọngọn. Ẹbọn nii ọnighẹm kẹ ẹnhuọ lẹ ampam, tuhuan ẹwọn nii uso lakẹnkan. Tushin ọtẹkpa ẹva yẹn.<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />Unu frẹ akyuẹ unu: e nii ọfrẹ unu kẹ ama anaa iywuro, tuhuan enii ọken unu kẹ unkoo ọpẹlọnọm, tuhuan unu nii ọ tẹgha kẹ ekye ana ọga ẹbọn kẹ Agọn kẹ ọsablọ Imi, kẹ unu too ọnkyẹ shin unu za. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Tushin ohun kẹ balẹ ọlau, e nii utoo ididu ọmbọn ohun nẹ aprẹẹ esheshii lẹn. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />Inshin afrẹ unu kẹ kpọn unu kan lẹ ẹmpakye iywuro, kalẹ unu rẹn ẹhurẹ unu ọnkyẹ shin unu nii utoo wan, unu too ọkyẹ shin Ọnọm nii utoo unu kẹ ẹladran, kẹ ọsablọ shin kyẹ unu ma ọpiya onyun man, Iri Ẹsẹẹ ya.<verse eid="MRK 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12" />Tuhuan éwédri nii umee eple kẹ aprẹ, ekye lẹ umee arẹn, tuhuan arẹn nii ọnya ifuwo kẹ eyee wan kẹ a sọ kẹ aprẹ wan. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />Tuhuan enii ọtraan ma unu kẹ ọsablọ ọntua mi. Tushin anushin anuam kan lẹ ọplẹ nii ukon ufuwo.<verse eid="MRK 13:13" /></para>
  <para style="s">Ẹva ibibi</para>
  <para style="r">(<ref loc="LUK 21:20-24">ULuka 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />Aywuẹ kyan shin unu nii ushin ọnlẹghẹ ajajẹ<note caller="+" style="f"><char style="fr" closed="false">13:14 </char><char style="ft" closed="false">ọDaniyel 9:27;11:31;12:11</char></note> shin ọ kẹ abẹn ọnkyẹ wọ shin ọywua kẹ ọnhuọ shin ọgbaa wọ shin uso wan (Ana ọpua ẹnrẹn kpẹ), tuhuan ana osoo kẹ ọYahudiya ta etiton kan lẹ aprẹn ankọ. <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />Anushin o soo kẹ aprẹn unkoo ghan kalẹ esri wan kẹ a nyẹran ọmẹ abaan kyẹ ọkpọn ọnlẹghẹ wan, <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />tuhuan anushin aywua kẹ onum kalẹ eywure ba lẹ ọmẹ ẹshaan ba ọkpọn ẹngbapiya wan. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />Ashẹ shin oso lẹ ọnaa kẹ anushin ohyu ukọn arẹn kẹ aywuẹ lan lẹ ushin itoo. <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Unu pẹlẹnọm shin kalẹ an yẹn ba kẹ ọmẹ aywuẹ urun ma. <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />Kẹ aywuẹ lan, ishim nii uso ute shin oso udu wan bin kẹ ẹlẹn shin Agọnọm du ohun nẹ wọ ma, tuhuan e nii ma ọtọ udu ute ishim na ma. <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />Tushin awa shin Ekye Abaan faa ghan aywuẹ la ma, bọ entyetri shin enii ukon ufuwo mi ma. Tushin kẹ ọsablọ anushin ewli, anushin ẹnga wue, a faa aywuẹ lan. <verse eid="MRK 13:20" /><verse number="21" style="v" sid="MRK 13:21" />Tuhuan inshin alọ too unu shin, “Shii uKristi ngẹn!” huọ, “Shii, anglan!” kalẹ unu biyan ma. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Sablọ shin uKristi ọntẹ kẹ onu ọntẹ nii utro, kẹ odu ọnkyẹ ankpẹ kẹ ọmẹ ọvrọ, inshin o kon epin enii uwu anushin ewue. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Unu kon aklọ! Imi a hurẹ utoo unu huọ unse wan ẹlẹn tọ sọ nya ọba wan.<verse eid="MRK 13:23" /></para>
  <para style="s">Ọba Arẹn Enyetri</para>
  <para style="r">(<ref loc="LUK 21:25-28">ULuka 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />Tushin ẹlẹn shin aywuẹ ishim lan kpon kọ, Ọnọm ọsaan nẹ nii ukye itum, tuhuan ọprẹn nii wọ ma ọsẹẹ wọ wan, <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />arẹn unkin nii ukple bi kẹ aprẹmẹn, tuhuan enii ọnighẹ ọnkyẹ ọndrọndọ ọma aprẹmẹn. <verse eid="MRK 13:25" /><verse number="26" style="v" sid="MRK 13:26" />Tuhuan enii ushi Arẹn Enyetri son ba nga kẹ ọmẹ amẹn lẹ ọdọ ọlọlẹ kẹ ọsẹẹ <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Tuhuan e nii ọtuan atuwan nga kan oson o tun nga anushin ewili bi kẹ utronọm kalẹ ọkpaanọm, kẹ anshaa ohun ẹya kẹ anshaa ohun ipre. Tuhuan kẹ ubi kẹ igbo ohun kan lẹ igbo aprẹmẹn.<verse eid="MRK 13:27" /></para>
  <para style="s">ulolo kẹ aprẹẹ ekyi untron</para>
  <para style="r">(<ref loc="LUK 21:29-33">ULuka 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />Lulo bi kẹ ekyi untron: ẹlẹn shin angaan ba la righẹ tuhuan azaa lẹ otro, za shin ọkpa ẹvraa ọba ọkọka. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Ọklan wọ, inshin unu e shii ọnkyẹ lẹn ukon ba kẹn, unu huọ za shin ọba ghan kyan ọkọka, o so kẹ onyun atigha. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Ẹplẹpan ya Imi kyan utoo unu, ẹlẹn nẹ nii ya ukpon ma sẹ ọnkyẹ lẹn ọ ba. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Aprẹmẹn kẹ ẹbọn nii ukpon kan wọ, bọ aprẹ mi nẹ nii ukpon kan yọ wan.<verse eid="MRK 13:31" /></para>
  <para style="s">Alọ za ghan aywuẹ huọ ẹlẹn man</para>
  <para style="r">(<ref loc="LUK 17:26-30">ULuka 17:26-30</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />Bọ anushin a za ọnlẹghẹ kẹ aprẹ aywuẹ lan huọ ẹlẹn ma, alọ za ghan ma, huọ atuwan ghan kẹ aprẹmẹn, huọ Arẹn, sẹ Ekye lẹhulẹ. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />Unu kon aklọ, kẹ unu ywua lẹ ọnzọ! Kẹ ọsablọ shin unu za unu ẹlẹn shin e nii ọba wan. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />Ọba arẹn enyetri so kawan anushin akya kan u soon ghan, aa la laa abaan ghan kẹ ẹfa agrẹn ghan, kẹ emee huọ olo nga ọtuan udu, tuhuan kẹ otoo ana ọzọ atigha shin a ywua lẹ azọ.<verse eid="MRK 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35" />Ọklan wọ unu ywua lẹ ọnzo, kẹ ọsablọ shin unu ọza unu ẹlẹn shin Ekye Abaan nii uywure wan, a yọ uywure lẹ anlẹ, huọ erete otu, huọ ẹlẹn shin anọọ nii ọshee, huọ lẹ oturombun. <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />Kalẹ a ba lẹ akprap kẹ awa okon unu huọ na ọna ma. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />Tuhuan ọnkyẹ shin Imi otoo unu, Imi huọ otoo ada lẹ ididu: Unu ywua lẹ unu ọzọ.<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">Ana ekye a klan akyuẹ shin aprẹ ọYẹsọ</para>
  <para style="r">(<ref loc="LUK 22:1-2">ULuka 22:1-2</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Aywuẹ apua lẹ atọ kan lẹ aywuẹ ẹpan ọkpẹn kẹ ẹpan shin a kẹ ya wan lẹ ubredi uyisti wan. Tuhuan akpẹ umee enshi kẹ ávuwa iywuro la nii emle shin ẹma nii ọfrẹ ghan kẹ ututuwo kẹ aprẹ. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />Sablọ o too shin, “Bọ ẹlẹn ẹpan nẹ ma, kalẹ ada nyuọ ishim ma.”<verse eid="MRK 14:2" /></para>
  <para style="s">Asọ ọYẹsọ anyẹẹ kẹ ọBetani</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />ọYẹsọ so kẹ onhuọ ya ọnkyọya kẹ ọBetani kẹ ọmẹ abaan ọSaminu ana o so lẹ uloo unbli kẹ ikyikyuwo, eple anshẹ la ba kẹ anyẹ-isun shin o so lẹ ikli la kẹnkan shin odu lẹ ọNardi lehule kẹ ọmẹ insuo ẹgyagyuwan. A lẹ okun onyun insuo lan kẹ shee anyẹẹ na kẹ aprẹn ẹkyuẹ ọYẹsọ lẹ ididu.<verse eid="MRK 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 14:4" />Eple enyi ma kẹ ọnhuọ lan lẹ nya amuwa kẹ kọ wan shin, “Kyẹ ọnkyẹ shin ọsọ aa bẹn anyẹ nẹ wọ?” <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />Anyan ohuro wan uDinari atẹlẹ ataa (ikli lẹn mẹẹ ọkywura anọtuwan kẹ amẹ ozun) tuhuan ka ma anaa emrin. A lẹ a gọ lẹ ẹnga lẹ ọdọ.<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />Tushin ọYẹsọ la kọ ghan lẹ ẹma shin, unu laa ghan kan latọ, unse wọ ọsọ unu kon ọhyua ghan ọnfran? Uloo du mi ọnkyẹ shin uso agyagyuwan. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />Anaa emrin ywua kẹ unu huọ ẹlẹlẹn ya, unu yọ ta wan anyẹn kẹ ẹlẹn shin unu a biyan wọ tushin imi nii mi uso kẹ unu ma huọ ẹlẹlẹn ya kọ. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />Uloo du emle ọdọ ghan wlan, àá sọ mi anyẹ shin anya asọ mi ẹlẹn shin enii ọta mi wọ inshin mi okpo mi. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Ẹplẹpan ya imi too unu nẹ, huọ ulon ọnhuọ ghan shin enii utoo aprẹ ẹshẹshii lẹn kẹ ohun, enii utoo ọnkyẹ shin uloo du lẹn sablọ shin a kẹ afrẹ ọwan nẹ ẹnga. <figure style="fig" alt="Woman pours perfume on Jesus" file="DN00414b.tif" size="col" loc="14:9" copy="Dunham" ref="14:9">Eple anshẹ sọ ọYẹsọ anyẹ isun</figure><verse eid="MRK 14:9" /></para>
  <para style="s">ỌYauza Iskariyọti man ọYẹsọ</para>
  <para style="r">(<ref loc="LUK 22:3-6">ULuka 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />ọYahuza Iskariyoti, enyi ozun kẹ ọmẹ ana ọkọ lẹ ẹpuwa, a kan lẹ ọnhuọ ana ọma-enshi ẹnbakyẹ shin ẹ ẹnga ma ma wan ọYẹsọ. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Ẹlẹn shin akọọn klan a lẹ a mọ tuhuan a lẹ o too ghan shin ẹma nii ọma ghan ikli. Tuhuan a lẹ afrẹ unii epin ọma ọYẹsọ.<verse eid="MRK 14:11" /></para>
  <para style="s">Ẹpan ọkpẹn</para>
  <para style="r">(<ref loc="LUK 22:7-14">ULuka 22:7-14</ref>,<ref loc="LUK 22:21-23">21-23</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Tuhuan kẹ aywuẹ inzun lẹ ẹpan ọya ubredi shin a kẹ sọ wan uyisti wọ wan, ublan wọ a kẹ awa arẹn atẹn sablọ ẹpan ọkpẹn, apaduwan ghan la e luwe ghan shin, “Ulon ọnhuọ ghan wọ ẹngọ nii shin enyi ma e sem kẹ ẹngọ huọ ya ẹpan ọkpẹn?”<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />A la tuwan apaduwan nga apuwa, kẹ too wan shin, “Unu nyẹran ọmẹ ẹshaan, unu nii ọklan kẹ eple enyi shin okon ambrẹ kẹ ọmẹ insuwo, unu ren kan, <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />kan lẹ abaan shin ekyi lan nii ọnyẹra, kẹ unu too ana abaan na shin, ‘Avuwa shin, kyẹ unkoo shin imi nii ọya ẹpan ọkpẹn kẹ apaduwan mi?’ <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />Tuhuan enii uyin unu unko ọlọlẹ kẹ abaan aprẹn ọnwọ agyagyuwan shin esem. Ọnhuọ lan wọ unu nii usem enyi.”<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />Apaduwan ghan la kan lẹ ẹshaan na, kẹ huọ ushin emle shin otoo wan, tuhuan e lẹ esem ẹnya ẹpan ọkpẹn.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />Na anlẹ, ala aba kẹ apaduwan ghan akọ lẹ apuwa <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Lẹ shin a trẹtra kẹ ọnhuọ ọya ọnkyẹ ọya, ọYẹsọ la kọ ghan shin “Ẹplẹpan imi too unu, alọ kẹ ọmẹ unu anushin unu kon ọya ọnyẹ ọya kẹ imi nii ọkpọn mi kẹ a ma.”<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />Ẹhurẹ wan la bẹn yọ tuhuan a lẹ afrẹ uluwe ghan kẹ ozro zun shin, “Imi nga?”<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />A la kọ ghan lẹ ẹma shin, “Ana ọzun nga kẹ ọmẹ unu, anushin okon ọya ọnkyẹ ọya kẹ imi. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Arẹn Enyetri nii ukpon ghan, ka lẹ emle shin arẹn kọ. Tushin unii uso ọnlẹghẹ itoo lẹ anushin aa kpọn Arẹn Enyetri kẹ a ma! Ọ lẹ ogba ghan shin anya obiyon ẹnga ma.”<verse eid="MRK 14:21" /></para>
  <para style="s">ọYẹsọ ya ọnkyẹ ọya kẹ apaduwan ghan</para>
  <para style="r">(<ref loc="LUK 22:14-20">ULuka 22:14-20</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Ẹlẹn shin oso kẹ ọnhuọ ya aya, a la kpọn ubredi, kẹ huọ sọ ẹja tohuan kẹ afọn, kẹ emee wan, kẹ kọ ghan shin, “Ẹgbẹna mi yẹn. Ngrẹ kẹ unu ya.”<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />A la kpọn ẹnsẹ, kẹ huọ ọsọ Agọnọm ẹja, tuhuan kẹ emee wan, ala hyua le ididu wan. <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />Tuhuan a lẹ otoo wan shin, “Eji mi mẹn. Eji shin eyin okpa-onyun Ọnọm, a ma shin a nyuran wọ kẹ ọ sablọ ada la pam. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />Imi too unu ẹplẹpan, imi nii mi ọ tọ hyua orun okpoo lẹn ma sẹ kẹ aywuẹ shin imi nii ọhyua aprapa kẹ ọmẹ Egọn Agọnọm.”<verse eid="MRK 14:25" /></para>
  <para style="s">UBitru nii ọtan ghan ọYẹsọ</para>
  <para style="r">(<ref loc="LUK 22:31-34">ULuka 22:31-34</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />Lẹshin a hurẹ ọta antẹn, ala kan lẹ aprẹn ọnkọn ọZaitun.<verse eid="MRK 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />ọYẹsọ la kọ lẹ ẹma shin, “Ididu unu nii utiton kẹ unu laa mi kan,” “sablọ a rẹn shin,</para>
  <para style="q1" vid="MRK 14:27">“ ‘Ọnọm nii ọprẹ ana upiye atẹn, tuhuan atẹn nii uvro wan.’ <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" />Tushin inshin a nyuọ mi, Imi nii uson kẹ ekye unu kan le ọGalili.”<verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />uBitrus la kọọ lẹ nga shin, “Huọ ididu ada akpaa, imi nii mi ọkpa wan.”<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />ọYẹsọ la ekye ghan shin, “Ẹplẹpan ya imi too ngọ ni, otu lẹn, ahurẹ nii kọ shẹẹ ẹmpuwan ma, ẹngọ nii ọtan mi kẹ sẹ ẹtaa shin ẹngọ za imi ma.”<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />uBitrus la nuam lẹ otoo shin, “Huọ enii ọprẹ mi kẹ ẹngọ, imi nii mi ọtan ẹngọ ma.” Ididu wan lẹ huọ utoo klan.<verse eid="MRK 14:31" /></para>
  <para style="s">ọYẹsọ pẹlẹnọm ke ọGyẹsẹmẹni</para>
  <para style="r">(<ref loc="LUK 22:39-46">ULuka 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Aa kan lẹ uplẹ ọnhuọ shin a drọ ọGetsamani. A lẹ otoo apaduwan ghan shin, “Unu trẹtra kẹ ọnhuẹn lẹ imi ọpẹlọnọm.” <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Tuhuan a lẹ a dra uBitrus kẹ ọYakubu kẹ ọYohanna shin e re ghan kan, tuhuan a la tẹkpa ọhyua ẹva, ẹhurẹ ghan la bẹn ya lakẹnkan. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />A lẹ otoo wan shin “Imi kon ọhyua ẹva lakẹnka tuhuan ẹhurẹ mi bẹn ya shin imi kọn ka wan imi nii ukpo mi. Unu ywa kẹ ọnhuẹn, kẹ unu frẹ ukon aklọ.”<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />Àá huọ uzem kan lẹ ekye la hyuẹ, a la kpaa kẹ ẹbọn kẹ pẹlẹnọm shin, á wà shin ẹlẹn nẹ tọ a sẹ ghan. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />A lẹ a kọ shin “ ‘Abba, Ekye,’ huọ unse wan tọ udum kẹ ọnhuọ ywua ngọ. Sa ẹnsẹ ẹva lẹn kẹ ọnhuọ ywua mi. Tushin bọ ọbyan ẹhurẹ mi ma, sẹ ọnwa ngọ” <verse eid="MRK 14:36" /><verse number="37" style="v" sid="MRK 14:37" />Ẹlẹshin e ywure a la kẹ o kon a na ọna ma, a la kọ lẹ uBitrus shin, “ọSaminu engọọ kon ọ na ọna ngọ? Ẹngọ nii ngọ umle ọywua kẹ ẹngọ shin ehuọ kẹ ngọ fuwan ẹlẹn izun ma? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />Unu ywua lẹ unu kon aklọ tuhuan unu pẹlẹnọm ẹnbakyẹ shin kalẹ unu kple kẹ ọmẹ ọmaa wan. Iri biyan udu, tushin ẹgbẹna so la rẹrẹghẹ.”<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />E le ywure kẹ a kan apẹlọnọm, kẹ avlọ ọnkyẹ shin otoo. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Tuhuan e le ywure kẹ akon a tọ ọnọna ma, sablọ iredre wan so la ọrọmdọ, bọ a za ọnkyẹshin ẹma nii u tọ utoo ghan man.<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />E le ywure ẹntaan kẹ too wan shin, “Unu hyu kẹ ọnhuọ ọnọna lẹ unu trim? Ọ mẹ klan; ẹlẹn ẹhuọ ba. Shii, ama Arẹn Enyetri kẹ anyẹẹ ana ilovro. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />Unu yẹnyan kẹ enyi ma oson, ana enii ọma mi nga soo kẹ ọnhuẹn!”<verse eid="MRK 14:42" /></para>
  <para style="s">A ma ọYẹsọ</para>
  <para style="r">(<ref loc="LUK 22:47-53">ULuka 22:47-53</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />Lẹ shin ọYẹsọ hyuu kẹ ọnhuọ ọpiya ọnyu, ọYahuza, ana ozun kẹ ọmẹ ana akọ lẹ apuwa lan, lẹ son kẹ ẹrẹn enyetri o kon ọnhuran kẹ aban, bin kẹ akpẹ umee enshi kẹ ávuwa ulolo iywuro uMusa, kẹ ana ekye.<verse eid="MRK 14:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MRK 14:44" />Ana e nii ọma ọYẹsọ nyin ankpẹ, kẹ too wan shin, “Anushin imi a hua ghan nga o so ana. Unu frẹ ghan, kẹ unu kon ghan lẹ agyagyuwan tuhuan unu son kan kẹ ẹnga.” <verse eid="MRK 14:44" /><verse number="45" style="v" sid="MRK 14:45" />Ẹlẹn shin ọYahuza ba, a la kan lẹ ọnhuọ ọYẹsọ, kẹ kọ shin, “Avuwa!” Tuhuan a la hua ghan. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />A la frẹ ghan kẹ o okon ghan la gbẹgbọn. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Tushin ana ozun kẹ ọmẹ anushin akyẹn kẹ ọnhuọ lan lẹ hyii ẹgbran ẹnhuran kẹ kpa ọtọn agrẹn akpẹ ọma enshin, kẹ a fa.<verse eid="MRK 14:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48" />ọYẹsọ la kọ lẹ ẹma shin, “Unu ewli kẹ ọnhuran kẹ aban ba ọ frẹ mi kawan anushin a ba ọfrẹ otuo? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />Huọ olon aywuẹ nga, Imi a kẹ ywua kẹ unu kẹ Abaan Ọnọm lẹ imi lolo, bọ unu a frẹ imi ma. Tushin ọnkyẹ lẹn ba ẹmbakyẹ shin huọ unse wan ba kẹ emle shin arẹn kẹ ọmẹ ọzaa ẹgọn.” <verse eid="MRK 14:49" /><verse number="50" style="v" sid="MRK 14:50" />Tuhuan ididu apaduwan nga la laa ghan kẹ titon.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />Eple arọfuwọ so e re ghan kan bọ ẹmgbapiya, unzen wọ otu loo. Ekyi wan na, la kyan ọfrẹ ghan, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />A la kram kẹ e titon kẹ eziin, kẹ laa unzen na wọ.<verse eid="MRK 14:52" /></para>
  <para style="s">Onokon ẹshaan luwe ọYẹsọ</para>
  <para style="r">(<ref loc="LUK 22:54-71">ULuka 22:54-71</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />A la kpọn ọYẹsọ kan lẹ ọnhuọ akpẹ ọma enshin alalẹ, tuhuan akpẹ umee enshin kẹ onokon ẹshaan kẹ ana ulolo iywuro la ba kẹ wan klan kẹ ọnhuọ ywa ghan. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />uBitrus kẹ ananọ la ese re ghan kan kẹ ititim. E ren ghan kan lẹ itighe abaan akpẹ ọma enshin alalẹ kẹ trẹtra kẹ ọmẹ ana ọzọ Abaan Ọnọm kẹ ywua lẹ a wẹ ọla kẹ ẹma.<verse eid="MRK 14:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55" />Akpẹ umee enshin kẹ ana ekye e nii ọnkyẹ shin ẹma nii ukon ọYẹsọ lẹ ilovro wọ sablọ ẹma prẹ ghan, bọ o kon ọnlẹghẹ wan. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Ada lẹ ampam wa ọntẹ kẹ aprẹn ghan, bọ onyun man kpaa wan.<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />Eple enyiman lẹ nyẹnya kẹ waa ọYẹsọ ọntẹ kẹ too shin, <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />“Enyi a kọn ghan, uloo too shin, ‘Imi nii ọben Abaan Ọnọm nẹ shin a vran lẹ anyẹ, tuhuan kẹ imi vran eple kẹ ọmẹ aywuẹ ata, shin a vran man lẹ anyẹ ma.’ ” <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Huọ lẹ shin otoo kẹn, onyun ma kpaa wan ma.<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />Ọklan wọ akpẹ ọma enshin alalẹ lẹ a nyuọm kẹ ọmẹ ma kẹ luwe ọYẹsọ shin, “Ẹngọ so ngọ lẹ ọnkyẹ shin ẹngọ nii utoo wan?” “Unse wan enyi ma nẹ kon utoo kẹ aprẹ ẹngọ?” <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />Tushin ala fọ ghan wọ, bọ eyee wan ma. Akpẹ ọma enshin alalẹ lan lẹ ywure kẹ luwe ghan shin, “Engọọ nga uso uKristi, Arẹn Ọnọm anushin o so lẹ Onyun Esheshii?”<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />ọYẹsọ lẹ a ngrẹ kẹ a kọọ ghan shin, “Imi nga, tuhuan unu nii shii Arẹn Enyitri kon trẹtra kẹ ọnyẹ ẹya Ọnọm ana ọdọ kẹ ididu, tuhuan oson ba ghan kẹ ọmẹ amẹn.”<verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />Tuhuan akpẹ ọma enshin alalẹ lẹ egree ọkyẹ shin ẹnga shẹ kẹ kọọ ghan shin, “Usugbute ankpẹ ghan enyi tọ unii? <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />Unu a kọn emle shin o too aprẹ Ọnọm kẹ ẹtrẹtrẹ kọ. Unu eshin la nyẹ?”</para>
  <para style="p" vid="MRK 14:64">Ididu wan lẹ o too shin uloo du ilovro, aprẹ ghan. <verse eid="MRK 14:64" /><verse number="65" style="v" sid="MRK 14:65" />Eple enyi ma lẹ afrẹ ọtaa ghan ekpe lẹ afraa ghan ukpekye lẹ a kẹn nga, lẹ otoo ghan shin, “Too enyi ọnkyẹ ọ lẹ ọba, ẹnga nga a la ngọ?” Anushin okon ọzọ la huọ kẹn ghan.<verse eid="MRK 14:65" /></para>
  <para style="s">UBitru tan nga ọYẹsọ</para>
  <para style="r">(<ref loc="LUK 22:56-62">ULuka 22:56-62</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Lẹ shin uBitrus so kẹ ilu itighe abaan, eple orodruan agrẹn akpẹ ọma enshin alalẹ la ba. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />Le ushin uBitrus so kẹ ọnhuọ ọwẹ ọla, a la sọ ghan edre, kẹ kọ ghan shin “Ẹngọ kẹ a huọ uson kẹ ọYẹsọ, ana ọNazaret!”<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />A lẹ a taan nga, “Imi za mi ọnkyẹ ngọ utoo wan.” Tuhuan a lẹ otro kan lẹ ontraan anyatẹgha, kẹ ẹladran ahurẹ lẹ a shẹẹ.<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />Lẹ shin arashẹ agrẹn na shin ghan, a lẹ a frẹ utoo ana okon ọkyẹn kẹ ọnhuọ lan shin, “Enkyi lẹn so kẹ ọmẹ ma.” <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Tushin uBitrus lẹ ywure kẹ taan nga. Ala kẹ a ba iple ẹlẹn anushin okon ọkyẹẹn kẹ ọnhuọ lan lẹ otoo uBitrus shii, “Lẹ ẹplẹpan ẹngọ soo kẹ ọmẹ ma kẹ ẹngọ Angalili ghan.”<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />Ala frẹ ọsọ ẹkyuẹ ghan onywu ebebi le etre, “Imi za mi anushin unu too aprẹ ghan ma.”<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />Ẹladran ahurẹ lẹ a shẹẹ kẹ ọnwọ ẹmpuwan. uBitrus la wan ọnkyẹ shin ọYẹsọ otoo ghan shin, “Ẹngọ nii ọtaa ngọ mi kẹ asọ ẹta, tuhuan ahurẹ nii ọshẹ kẹ asọ ẹpuwa.” A lẹ ọfrẹ ọta ẹkpa.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">A kpọn ọYẹsọ kan lẹ ẹmpakye uBilatu</para>
  <para style="r">(<ref loc="LUK 23:1-5">ULuka 23:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Lẹ ọshaa oturombun, akpẹ umee enshin kẹ ana ekye kẹ ávuwa ulolo iywuro kẹ ididu ana utoo-ẹgọn, la klan akyuẹ, kẹ otoo emle ọnkyẹ shin ema nii udu. A lẹ oloo ọYẹsọ tuhuan kẹ kpọn ghan kan lẹ ọnhuọ uBilatus.<verse eid="MRK 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2" />UBilatus lẹ eluwe ọYẹsọ shin “Ẹngọ nga unso Agọn aYahudawa?”</para>
  <para style="p" vid="MRK 15:2">E le kye ghan shin, “Engọ nga shin klan.”<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />Akpẹ umee enshii la frẹ ta ghan otu kẹ aprẹ ọnkyẹ lẹ ampam. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />UBilatus le ywure kẹ eluwe ghan shin, “Engọ so nga nẹ ọnkyẹ utoo wan? Shii ọnkyẹ shin okon utoo ba lẹ aprẹn ẹkyuẹ ngọ!”<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />Bọ ọYẹsọ ywure kẹ ekye wan ọnlẹghẹ wan, uBilatus le shin ọvrọ.<verse eid="MRK 15:5" /></para>
  <para style="s">UBilatu ma ọYẹsọ kẹ aprẹ</para>
  <para style="r">(<ref loc="LUK 23:13-25">ULuka 23:13-25</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Ididu ẹlẹn ẹpan ọkpẹn, uBilatus ka laa ana ozun kẹ ọmẹ anushin aywua kẹ iwe anushin ada nii. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Eple enkyi lẹ o soo shin a drọ ghan ọBarabas, aywua kẹ iwe kẹ anushin a nyuọ ishim tuhuan kẹ apẹẹ ada kẹ ọmẹ ishim lan. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Tuhuan ẹrẹn ada la ba kẹ wan otoo uBilatus shin odu wan emle shin a hyua u kẹ odu wan.<verse eid="MRK 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 15:9" />UBilatus le kye kẹ kọ lẹ ẹma shin, “Unu nii i mi laa unu Agọn aYahudawa?” <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Kẹ ọsablọ shin uBilatus kpẹ shin ifuwo kẹ ẹsọ shin akpẹ umee enshii ma ghan <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />Tushin akpẹ umee enshin la sọ ada utoo shin a laa wan ọBarabas.<verse eid="MRK 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 15:12" />uBilatus lẹ ywure kẹ luwe wan shin, “Unse wọ unu nii shin imi du kẹ anushin unu drọ Agọn aYahudawa?”<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />A lẹ eshee akpa kẹ kọ wan shin, “Asra ghan!”<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />uBilatus la kọ ghan lẹ ẹma shin, “Kẹ ọsablọ unse, kyẹ ọlẹghẹ ubibi shin odu?”</para>
  <para style="p" vid="MRK 15:14">Tushin a lẹ frẹ ushre akpa lakẹnka, lẹ otoo shin, “Asra ghan!”<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />uBilatus nii uhyuo wan ẹhure, a lẹ a laa ọBarabas, a la sọ a lẹ truwa ọYẹsọ ọkẹn tuhuan kẹ sọ ghan kẹ ọmẹ anyẹn ma kẹ a wa sẹsra ghan.<verse eid="MRK 15:15" /></para>
  <para style="s">Osọja ọkrọọ ọYẹsọ</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Osoja lẹ soon kẹ ẹnga kan lẹ ọmẹ ozo (ozo agọn)<note caller="+" style="f"><char style="fr" closed="false">15:16 </char><char style="ft" closed="false">Ọntua ozo lan lẹ uGrik ma uso uFeritoriyum.</char></note>, a lẹ dra ididu osoja ba lẹ ọnhuọ lan. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />O lẹ oloo ghan unzen ususon, tuhuan kẹ o du ghan ẹndaja ẹgọn ẹnya akẹn, kẹ traa ya kẹ aprẹn ẹkyue ghan. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />Tuhuan a la frẹ blẹ ghan shin, “Enyi adọọ ngọ, Agọn aYahudawa!” <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />A la frẹ ọ kẹn nga lẹ aban kẹ aprẹn ẹkyuẹ lẹ ata ghan ekpe tuhuan kẹ frẹ ushre ghan ongbun lẹ adọọ ghan. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Lẹ shin a huọ ọhurẹ ọkrọọ ghan, e le wue ghan ọnkyẹ ususon tuhuan kẹ shẹẹ ghan ọma nga ọnkyẹ. A lẹ oson kẹ ẹnga kan lẹ ọnhuọ shin a kẹ asra ghan.<verse eid="MRK 15:20" /></para>
  <para style="s">Asra ọYẹsọ</para>
  <para style="r">(<ref loc="LUK 23:26-43">ULuka 23:26-43</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />Eple enyi shin a drọ ghan ọSaminu soson ghan bi kẹ ẹshan nga, ẹnga ana ọSẹrin ghan tuhuan ẹnga ghan o so ekye Iskandari wan kẹ uRufus. A la sọ ghan ọkpọn ekyi ọsẹsra ọYẹsọ kẹ ọdọ wọ. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />Osoja lẹ o son kẹ ọYẹsọ kan lẹ uGolgota, (ọnhuọ ẹngba<note caller="+" style="f"><char style="fr" closed="false">15:22 </char><char style="ft" closed="false">Ọnhuọ shin ikrin ywua wọ kẹ ọmẹ ẹkyuẹ</char></note> ẹkyuẹ) <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />A la ma ghan orun okpoo shin eyee kẹ umur, a lẹ tran ghan ọhyua lẹn. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />A la sra ghan tuhuan kẹ kam ẹmgbapiya ghan, a la tlẹ ẹrẹnsan kyẹ ushin ọnkyẹ shin huọ ẹnga nga nii ukon kẹ ọmẹ ma.<verse eid="MRK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 15:25" />Asra ọYẹsọ lẹ oturombun kẹ elẹn ituna. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />A la rẹn ọnkyẹ shin uloo du kẹ ada kẹ aprẹn ekyi ọsẹsra ghan, <char style="sc">AGỌN AYAHUDAWA.</char> <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />A la huọ ọsra otuo anampuwa kẹ ẹnga, enyi ozun kẹ ẹya ghan anga enyi kẹ ipre ghan. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />Ọnkyẹ shin a rẹn kẹ ọmẹ Ọzaa Ẹgọn lẹ huọ ba ẹplẹpan, “Apuwa ghan kẹ ọmẹ ana ilovro.”<note caller="+" style="f"><char style="fr" closed="false">15:28 </char><char style="ft" closed="false">Ọrẹn ikyikyuwo so wọ lẹ abraan nẹ ma.</char></note> <verse eid="MRK 15:28" /><verse number="29" style="v" sid="MRK 15:29" />Anushin oson kẹ ọnhuọ ukpon la frẹ ọkrọọ ghan, lẹ a nighẹ akyuẹ wan lẹ otoo shin, “Ẹhẹn! Ẹngọ anushin ẹngọ nii uvro Abaan Ọnọm, kẹ ẹngọ vraan kẹ aywuẹ ataa, <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />sri bi kẹ ekyi ọsẹsra lẹ mlan kẹ ngọ fuwo ẹkyuẹ ngọ!”<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />Emle lan nga akpẹ umee enshin kẹ ávuwa ulolo iywuro lẹ frẹ krọọ ghan lẹ too eple shin, “Ofuwo eple enyi ma,” “tushin bọ abraan ufowo ẹkyuẹ ghan ma. <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />Ẹngọ uKristi lẹn Agọn Israˈila, sri bi kẹ ekyi ọsẹsra lẹn kẹ ẹladẹn, kẹ enyi shii tuhuan enyi kpọn lẹ ẹhurẹ enyi!” Anushin a huọ sra wan kẹ ẹnga la huọ utoo ghan ọmprẹẹ ububi. <figure style="fig" alt="Jesus is nailed to the cross" file="DN00492b.tif" size="col" loc="15:32" copy="Dunham" ref="15:32">Asra ọYẹsọ</figure><verse eid="MRK 15:32" /></para>
  <para style="s">Ukpo ọYẹsọ</para>
  <para style="r">(<ref loc="LUK 23:44-49">ULuka 23:44-49</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Lẹ erete aywuẹ, huọ ulun ọnhuọ ghan kẹ ididu ẹbon na le kye itum kan lẹ ẹyẹra ẹta ọnwọ anlẹ. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Lẹ shin ọnkyẹ-unyin-ẹlẹn na nyin ẹyẹra ẹta kọ, ọYẹsọ la shẹẹ ẹkpa lẹ iwe ẹlẹlẹ, “Ẹloi, Ẹloi, lama sabaktani?” Onkyẹ otoo wọ usọ, “Ọnọm mi, Ọnọm mi, unse wọ ọ sọ ngọ e kyee mi ititim?”<verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />Lẹn shin eple anushin okon ọkyẹn kẹ ọnhuọ lan kọọn klan, a la kọ wan shin, “Ngẹn atọn, okon ọdrọ Iliya!”<verse eid="MRK 15:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 15:36" />Alọ la nya lẹ uton kẹ asọ ọsọsọ lẹ ambrẹ ọnkpẹnkpam tuhuan kẹ otroo kẹ aban kẹ a ma ghan kẹ a hyua, a la kọ ghan shin, “Enyi nii ushin, huọ tọ Iliya nii ọba kẹ awa sri ghan.”<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />ọYẹsọ la sa iwe lẹ ọdọ kẹ shẹẹ ẹkpa tuhuan kẹ laa ọnfraan.<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />Tuhuan unzen ọnwọ anyatigha Abaan Ọnọm lẹ egre wọ kẹ ẹrẹtẹ, bi kẹ aprẹn kan lẹ ẹbọn. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />Lẹ shin onsoja shin akyẹn kẹ ẹmpakyẹn ghan shin emle shin aa laa ọnfraan ghan, ala kọ shin, “Ẹplẹpan ya, enkyi lẹn Arẹn Ọnọm nga!”<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />Eple ashẹẹ tigha kẹ ananọ kẹ ọnhuọ ushin, ọMariya ọMadalin, kẹ ọMariya ẹya ọYakubu anga ọhyuẹ kẹ uYusuf, kẹ ọSalomi so kẹ ọmẹ ma. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />Ẹlẹn shin o so kẹ ọGalili, ama ere ghan kan, kẹ o du ghan ọtuan, eple ashẹ lan apam huọ uso kẹ ọnhuọ lan, a ba lẹ Urushẹlima kẹ ẹnga.<verse eid="MRK 15:41" /></para>
  <para style="s">A lọọ ọYẹsọ</para>
  <para style="r">(<ref loc="LUK 23:50-56">ULuka 23:50-56</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Ididu ọnkyẹ lẹn ba kẹ aywue usem, ọnwa ubun wọ u nii uso Aywuẹ Utrim aYahudawa, anlẹ tọ huọ ba. <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />uYusuf ana Arimatiya, anushin a za lẹ ẹnga kẹ ọmẹ ana ekye, a lẹ a huọ uso kẹ ọnhuọ zọ ọba Ẹgọn Ọnọm, a la kan lẹ ọnhuọọ uBilatus bọ ibun kẹ wan shin a ma nga ọkrọọ ọYẹsọ. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />UBilatus la kọn ọvrọ shin a huọ ukpo ghan. Ala dra onsoja shin o so kẹ ọnhuọ ọzọ ọYẹsọ kẹ luwe ghan huọ tọ aywua lẹ ukpo ghan nẹ. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Lẹ shin a kọn ẹplẹpan kẹ onyun onsoja lan, a la kọ ghan lẹ Yusufu shin a kpọn ọkrọọ lan. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />Yusufu lẹ alọ ahuọhuọ, e le sri lẹ ọkrọọ ọYẹsọ, kẹ kaan tuhuan kẹ tighẹ kẹ ọmẹ itun shin o otun kẹ ọmẹ ọpan. Tuhuan kẹ zee ẹntrẹtra ẹlẹlẹ kẹ fraa anyatigha itun na wọ. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />ọMariya ọMadalin kẹ ọMariya eya Yusufu shii ọnhuọ shin aa ngẹn ọkrọọ ghan wọ.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">ọYẹsọ nyẹnya bi kẹ ọmẹ itun</para>
  <para style="r">(<ref loc="LUK 24:1-12">ULuka 24:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Lẹ shin aywuẹ utrim kpon, ọMariya ọMadalin, kẹ ọMariya ẹya ọYakubu, kẹ ọSalomi la lọ anyẹ isun kyẹ tuwo kẹ ẹgbẹna ọYẹsọ. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Lẹ ọshaa oturumbu kẹ aywuẹ ọladi, a la fuwan itun na lẹ utro Ọnọm ọsan. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />O son kẹ ọntraan, a lẹ frẹ utoo eple shin, “Ẹnga nga e nii uze enyi ẹntrẹtra lẹn kẹ anyatigha itun na?”<verse eid="MRK 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 16:4" />Lẹ ọ sa edre wan, e lẹ eshin e zee ẹntrẹtra lan, sablọ shin i so kẹ ẹlẹlẹ. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />Ẹlẹn shin a nyẹran ọmẹ itun na, e le shin eple arọfuwọ trẹtra kẹ ọnyẹ ẹya, a shẹẹ ọnkyẹ unkyukyi, eji la kpaa wan.<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />A lẹ otoo wan shin, “Kalẹ ẹhurẹ unu kpayọ wan. Imi za shin ọYẹsọ ana ọNazaret ghan unu kon unii anushin asra ghan. Aa nyẹnya! O so ghan kẹ ọnhuẹn nẹ ma. Unu shin ọnhuọ shin a ngẹn nga wọ. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Unu son kan kẹ unu ma otoo apaduwan ghan kẹ uBitrus shin o so kẹ ekye kan lẹ ọGalili, ọnhuọ lan wọ unu nii ushin ghan kawa emle shin o too unu.”<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />Ashẹẹ lan lẹ otro la drẹndrọ lẹ utiton bi kẹ ọmẹ itun na, ẹgbẹna ma la frẹ ọnighẹm kẹ ọsablọ shin eji kpa wan.<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">[Orẹn ikyikyuwo kẹ eple azaa shin arẹn kyikyuwo so yọ lẹ ọMarkus 16:9-20.]</char></note><verse eid="MRK 16:8" /></para>
  <para style="s1">ọYẹsọ nyin ọMariya ọMadalin ẹkyuẹ ghan</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />Lẹ shin ọYẹsọ huọ nya bi kẹ ukpo lẹ ọsha oturombun ọLahadi, a la atẹkpa unyin ọMariyamu ọMagadaliya ẹkyuẹ ghan, anushin e wli ghan ọnsha utumpuwa. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />A lẹ kẹ otoo anushin a lẹ aywua kẹ ọYẹsọ, o kẹ okon ma kẹ ọmẹ ambẹn ẹhurẹ tuhuan o so kẹ ọnhuọ ukyue. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Lẹ shin a kọn ọMagadaliya too wan shin ẹgan shin ọYẹsọ, o sọ lẹ ọrẹ, a la kpọn wan aprẹ lan ma.<verse eid="MRK 16:11" /></para>
  <para style="s">ọYẹsọ nyin ẹkyuẹ ghan kẹ ọnhuọ apaduwan ghan apuwa</para>
  <para style="r">(<ref loc="LUK 24:13-35">ULuka 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />A lẹ huọ ọhurẹ, ọYẹsọ lẹ enyin ẹkyuẹ ghan kẹ ẹtẹrẹtọ kẹ ọnhuọ eple apaduwan ghan anampuwa o tọ uson kan wan lẹ arẹn ẹshaan. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Anampuwa lan lẹ ywure o kẹ otoo amaa apaduwan na, a lẹ kpọn ma aprẹ lan ma.<verse eid="MRK 16:13" /></para>
  <para style="s">ọYẹsọ nyin ẹkyuẹ kẹ ọnhuọ apaduwan nga akọ lẹ ozun</para>
  <para style="r">(<ref loc="LUK 24:36-49">ULuka 24:36-49</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Aba iple ẹlẹn, e le nyin ẹkyuẹ ghan kẹ ọhuọ apaduwan ghan akọ lẹ ozun na o tọ uso kẹ ọnhuọ ọya ọnkyẹ ọya. A la nighan ma sablọ ọlaa ọdọ ẹhurẹ wan kẹ ọsakatọn ma sablọ shin akpọn ma ọnkyẹ utoo anushin e shii ghan bi kẹ ẹlẹn shin ẹnga nyẹnya wọ ma.<verse eid="MRK 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15" />A la kọ lẹ ẹma shin, “Unu son kan unu lẹ ididu ohun kẹ unu mo otoo ididu ada ihyuu ishishii. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />Ididu anushin a kpọn, tuhuan a lẹ odu ghan ọbaftisma e nii ukon ufuwo, tushin ididu anushin a kpọn ghan ma, e nii ghan ukon ufuwo mi ma. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />Tuhuan e nii ọma anushin a kpọn lẹ ẹhurẹ wan ọdọ udu ọnkyẹ ọvrọ lẹn: E nii uwli ọnsha lẹ ọntua mi tuhuan e nii ọpiya ọnyun lẹ ẹda ẹprẹpa, <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />e nii ọfẹn ẹwẹn lẹ anyẹn ma, tuhuan inshin a hyua akaan, e nii ma udu wan ọnlẹghẹ wan, e nii ọtraa anyẹ ma kẹ aprẹ ana o so oloo, tuhuan e nii ukon ọtrẹ.”<verse eid="MRK 16:18" /></para>
  <para style="s">A kpọn ọYẹsọ kan lẹ aprẹn</para>
  <para style="r">(<ref loc="LUK 24:50-53">ULuka 24:50-53</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />Lẹ shin Ekye abaan ọYẹsọ hurẹ ọpiya onyun kẹ ẹma, a la kpọn ghan kan lẹ aprẹmẹn tuhuan a la trẹtra kẹ ọnyẹ ẹya Ọnọm. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Apaduwan ghan lẹ otro kan lẹ huọ ulon ọnhuọ ghan wọ kẹ afrẹ utoo ihyuu ishishii ẹnkọ Ọnọm. Ekye Abaan frẹ udu ọtuan kẹ ẹma, lẹ o so odu ankpẹẹ ọnkyẹ ọvrọ shin unyin shin ọnkyẹ utoo wan ẹplẹpan ya. <figure style="fig" alt="Jesus goes up to heaven" file="DN00497b.tif" size="col" loc="16:20" copy="Dunham" ref="16:20">A kpọn ọYẹsọ kan lẹ aprẹn</figure><verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>