<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Eda</book>
  <para style="toc2">Afis</para>
  <para style="toc1">Afisawa</para>
  <para style="mt1">Afisawa</para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />Imi uBulus, anpaduan uKristi ọYẹsọ rẹn unu ẹnrẹn lẹn, kẹ emle shin Ọnọm nii wọ,</para>
  <para style="p" vid="EPH 1:1">kan lẹ ọnhuọ anushin osoo ana ure Ọnọm kan shin o soo kẹ Afisa, anushin o so ana ọkpọn lẹ ẹhurẹ kẹ ọmẹ ọYẹsọ uKristi:<verse eid="EPH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2" />Imi uBulus kon unu esheshi kẹ ọna ẹhurẹ bikẹ ọnhuọ Ọnọm Ekye enyi kẹ Ekye Abaan ọYẹsọ uKristi.<verse eid="EPH 1:2" /></para>
  <para style="s">Onyun Esheshi Iri kẹ ọmẹ uKristi</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />Ọblẹ kan lẹ Ọnọm, Èkye Ekye Abaan enyi ọYẹsọ uKristi, anushin àá sọ enyi onyun esheshi bikẹ Aprẹmẹn lẹ huo ulon esheshi Iri ghan kẹ ọmẹ uKristi. <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />Ọnọm le we enyi kẹ ọmẹ ghan kẹ enyì ba ana ẹsẹẹ bọ uvro kẹ ẹmpakye ghan kyuwo ata ọsọ ọnya udu ohun ma. <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />Ọnọm la kpọn udu shin ẹngan nii ukye lẹ enyi arẹn ghan kẹ ọtrẹkyuẹ kẹ ọYẹsọ uKristi, ọnwẹn wọ usoo ọbyan kẹ unii ngan. <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />Enyi blẹ ọdọọ kẹ esheshi Ọnọm, sablọ agyuan ẹn kẹ ililu shin aa ma enyi kẹ ọmẹ Arẹn ghan ọYẹsọ shin aa byan. <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" />Sablọ ọbyan kẹ esheshi Ọnọm, aa lọ enyi uplem enyi lẹ eji Arẹn ghan tuhuan ka huro ilovro enyi. <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />shin àá ma enyi lapam kẹ ọza ikon kẹ ọkpẹ. <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />Ọnọm nyin enyi uyee ghan kẹ aprẹn uKristi, udu shin unii ọkuan unii ọgyagyuan ngan. <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />ọnkyẹ shin ẹnga kon ẹhurẹ udu wẹn, inshin ẹlẹn fuan ò fro ididu ọnkyẹ kan kẹ aprẹn kẹ ohun kẹ ọnhuọ uzun lẹ ọdọ uKristi, ẹkyuẹ kọ.<verse eid="EPH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11" />Kẹ ọmẹ uKristi wọ Ọnọm we enyi, lẹ ushin aa hurẹ udu enyi kẹ etighe emle unii nga shin ukon udu uhuo unsewan kẹ ọntraan unii nga, <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />Unii Ọnọm wọ uso shin enyi aYahudawa shin atẹkpa ọkpọn uKristi lẹ ẹhurẹ, nii ọdọọ ghan. <verse eid="EPH 1:12" /><verse number="13" style="v" sid="EPH 1:13" />Tuhuan unu anushin osoo wan aYahudawa wan huọ ukye arẹn Ọnọm lẹ ushin unu akọọn aprẹn Ọnọm, iywuu ishishi shin ikon unu ofuwo wan. Unu akpọn uKristi lẹ ẹhurẹ, tuhuan Ọnọm lẹ kye unu arẹn ghan lẹ ushin aa ma unu Iri ẹsẹẹ, shin aa kpa unu onyun kyikyuo. <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />Iri ẹsẹẹ lan nyin shin Ọnọm nii ọma enyi ọka shin aa kpa onyun shin aa lọ enyi kẹ enyi kye arẹn ghan. Oo du kẹn sablọ shi enyi blẹ kẹ enyi dọọ ghan.<verse eid="EPH 1:14" /></para>
  <para style="s">Ẹjaa kẹ ọpẹlọnọm</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />Sablọ kẹn, kyikyuo lẹ ushin imi akọọn aprẹ ọdọ ẹhurẹ unu kẹ ọmẹ Ekye abaan ọYẹsọ tuhuan kẹ ọbyan shin unu abyan ididu ana ọdẹdẹy, <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />imi so ọtigha mi ọsọ Ọnọm ẹja sablọ unu ma, lẹ I mi wan lẹ unu kẹ ọmẹ ọpẹlọnọm mi. <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />I mi kon wan shin Ọnọm Ekye Abaan enyi ọYẹsọ uKristi, Ekye ọdọọ, nii ọma unu Iri ọza ikon kẹ unyin kawan ala, sablọ shin unu kpẹ ghan kẹ agyagyuan. <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />Imi eywure Imi kon ọpẹlọnọm shin edre ẹhurẹ nii ukon ọkpẹ sablọ shin unu za ọsọ ẹhurẹ shin aa dra unu, unkon ọma ọka ọdọọ ghan kẹ ọmẹ ana ọdẹdẹy, <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />kẹ ọdọ ọlọlẹ ghan shin aka guan ma ma ọnwọ enyi anushin akpọn lẹ ẹhurẹ. Ọdọ lan wọ uso ọdọ ọtuan ọlọlẹ ọnwọ ọYẹsọ, <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />ọnwọ shin Ọnọm du ọtuan wọ kẹ ọmẹ uKristi lẹ ushin aa nyuọn ngan bikẹ ọmẹ itun tuhuan ka trẹn ghan kẹ ọnyẹn ẹya ghan kẹ Aprẹmẹn, <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />ọnhuọ shin uKristi kon udu ẹgọn kẹ aprẹn ididu ana udu ẹgọn kẹ ọdọ kẹ ẹgọn, uso lẹ ọntua shin ọ srẹ́ huọ ulon ọntua shin e nii ọma, bọ kẹ ohun lẹ wọ lẹhule wan,huọ ẹlẹn shin ẹ kyan. <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />Tuhuan Ọnọm sọ huọ unse wan kẹ ilu ampẹ afran uKristi, a la huọ ọsọ oso ẹkyuẹ ẹn kẹ ididu ọnkyẹ ada ana ubi. <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />Ana ure Ọnọm kan ma oso ẹgbẹna uKristi, ọkuang ọnwọ ẹnga anushin àá hua ọhuọ unse wan wọ kẹ uhuọ ulon ọnhuọ ghan wọ.<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="ms">Ọnọm ma enyi ọrẹ kẹ ọmẹ uKristi</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />Kẹ ikyikyuo unu ala huọ ukpo unu kẹ ọmẹ ilovro kẹ ọtran unu ure ọnkyẹ utoo Ọnọm kan. <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />Unu ala ywua kẹ ọmẹ ilovro, kawan ana ohun; lẹ unu re ana udu ẹgọn iri ibibi kan kẹ ọmẹ amẹn, iri ibibi shin ikon udu ọtuan kẹ ọmẹ ada anushin atran ma udu ọnkyẹ utoo Ọnọm kan. <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />Ididu enyi lẹ osoo kẹ ọmẹ ma, lẹ enyi re ushi ohun kan, lẹ enyi du ọnkyẹ shin ẹgbẹna kẹ ẹhurẹ enyi nii, kawan ama enyi ma lan, ablọ ọywua ilovro enyi lẹn, enyi a hyua ẹva sablọ amua Ọnọm kawan amaa enyi lan. <verse eid="EPH 2:3" /><verse number="4" style="v" sid="EPH 2:4" />Tushin ohuro Ọnọm so lapam, tuhuan ọbyan ghan kẹ aprẹn enyi so kẹ ọlọlẹ, <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />Kẹ ushi ikyikyuo enyi la okpo wan sablọ ọtran ma ure ọnkyẹ utoo Ọnọm kan tushin Ọnọm nyuọn enyi kẹ uKristi. Esheshi Ọnọm kẹ ofuwo enyi. <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />Ọnọm nyuọn enyi kẹ uKristi bikẹ ọmẹ itun kẹ atrẹn enyi kẹ ẹnga kẹ ọnyẹ ẹya ghan kẹ Aprẹmẹn sablọ enyi ana ozun lan ma kẹ uKristi ọYẹsọ. <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />Ọnọm du kẹn sablọ àmẹ shin akyan, ẹnga nii unyin ankpẹ unkon esheshi alalẹ kẹ agyagyuan ghan shin osoo wan lẹ ọguan ma, shin ee nyin kẹ ọmẹ ididu ọnkyẹ shin oo du enyi anushin ekye ana ozun kẹ uKristi ọYẹsọ. <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />Ọ sablọ kẹ esheshi Ọnọm wọ unu okon ofuwo lẹ ọdọ ẹhurẹ. Kyẹ ọtuan ọnwọ unu wọ ọsọ wan, agyuan Ọnọm wọ, ọnwọ ọsọ kalẹ alọ blẹ lẹ ọnwọ wan. <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />kyẹ lẹ ọtuan wọ enyi okon ufuwom ma, ọnwọ ọsọ kalẹ alọ drọm ma. <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />Sablọ enyi ọtuan ọnwọ Ọnọm wọ, shin odu kẹ ọmẹ uKristi ọYẹsọ kẹ enyi du ọtuan ọgyagyuan shin Ọnọm huọ usem ẹlẹn tẹ ọsọ ọnya ọba wan sablọ shin enyi du.<verse eid="EPH 2:10" /></para>
  <para style="s">Enyi ana ozun ma kẹ ọmẹ uKristi</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />Ọklan wọ, unu wan shin unu anushin o soo wan aYahudawa wan kyikyuo bikẹ ubyon wan ma shin adrọ shin “anushin ataa wan ẹma untun ma” lẹ anushin adrọ akyuẹ wan shin “anushin ataa wan untun” shin lẹ unu, “unu anushin ataa wan ẹma untun wan ma.” (aYahudawa lẹn kon ọblẹ lẹ ọtaa untun ma tushin unyi kẹ ẹgbẹna ma wọ lehule.) <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />Unu wan shin kẹ ọmẹ aywuẹ lan, ala plan unu kẹ uKristi, ala ewe unu kẹ ọmẹ ana Israila; osoon kẹ ọmẹ ulo kẹ etighe shin Ọnọm kpaa wan onyu ma. Unu aywua kẹ ọmẹ ohun lẹn bọ Ọnọm, bọ ọsọ ẹhurẹ. <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />Tushin kẹladẹn unu anushin o soo ananọ kẹ Ọnọm huọ ukye ana ozun kẹ uKristi ọYẹsọ tuhuan e ywure lẹ unu kẹ akaaka balẹ ọnhuọ Ọnọm lẹ eji uKristi.<verse eid="EPH 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 2:14" />Kẹ uKristi kẹ ẹkyuẹkyuẹ ghan nga oso ọna ẹhurẹ enyi, anushin àá kpọn aYahudawa kẹ ana shin o soo wan aYahudawa wan kẹ e kye wan ana ozun lan, tuhuan kẹ ovro ivre ifuwo shin ẹẹ plan ma, <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />Oo du kẹn ka ovro ididu iywuro ẹnyẹ aYahudawa lẹ ukpo ghan. ọYẹsọ kon ọna ẹhurẹ wan kẹ ọmẹ aYahudawa kẹ anushin o soo wan aYahudawa wan lẹ ushin oo du ọnyẹ uzu kẹ ọmẹ ghan bikẹ anyẹ apua lan kyẹ ukon ọna ẹhurẹ wan.<verse eid="EPH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EPH 2:16" />Kẹ ọmẹ ẹgbẹna izun lẹn ọYẹsọ sem ọywua anyẹ apua lan kan lẹ Ọnọm kẹ aprẹn ekyi ọsẹsra, lẹ ushi àá prẹ ifuwo shin isoo kẹ ọmẹ ma. <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />Àa ba kawa otoo ihyuu ishishi ẹn kẹ ọna ẹhurẹ wan balẹ ọnhuọ unu anushin o soo wan aYahudawa wan, anushin oso ananọ kẹ anushin oso akaaka kẹ Ọnọm. <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />Kẹ ọtrẹkyuẹ kẹ uKristi wọ ididu enyi ukon ọntran ọkan lẹ ọnhuọ Ekye lẹ ọdọ Iri izun.<verse eid="EPH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />Ọnwọ ọsọ kẹ ladẹn, unu hyu unu osoon huọ ana ọywua kẹ ẹbọn alọwan ma. Tushin unu e kye ẹgbẹna izun kẹ enyi Ọnọm tuhuan unu ana abaan Ọnọm kọ, <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />shin a vran kẹ aprẹn apaduan kẹ onu, kẹ uKristi ọYẹsọ kẹ ẹkyuẹkyuẹ ghan, ẹntrẹtra shin ẹn kẹ iso ọdọ ọvran. <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />Kẹ ọmẹ ghan wọ enyi ekye ana ozun lan tuhuan kẹ ekye abaan ẹsẹẹ kẹ ọme Ekye Abaan. <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />Tuhuan kẹ ọmẹ ghan, a huọ ọvran unu kẹ eple kẹ unu kye abaan shin Ọnọm ywua wọ lẹ Iri ghan.<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s">uBulus ana ulolo anushin osoo wan aYahudawa wan.</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />Sablọ anyẹn, Imi uBulus, ana uso kẹ unkoo ẹva sablọ uKristi ọYẹsọ sablọ Imi otoo anushin o soo wan aYahudawa wan ihyuu ishishi.<verse eid="EPH 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 3:2" />Lẹ ẹplẹpan, imi za shin unu a huọ ọkọọn emle shin Ọnọm ma mi esheshi ghan kẹ Imi du ọtuan wọ sablọ agyagyuan unu, <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />kawan emle shin Imi ala rẹn wọ la hyuẹ, Ọnọm ẹkyuẹkyuẹ ghan nga e nyin mi uyee lẹn. <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />Inshin unu a ọpua ẹnrẹn lẹn kan lẹ igbo, unu tẹ unu mle ulolo ọnlẹghẹ kẹ ọmẹ ọnkyẹ shin Imi a kpẹ kẹ ọmẹ uyee lẹn kẹ aprẹn Kristi, <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />ọnwọ shin alẹ enyin ma ana ikyikyuo emle shin Iri huọ u nyin apaduan kẹ onu Ẹsẹẹ Ọnọm wọ kẹladẹn ma. <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />Uye lẹn wọ uso shin, kẹ ọtrẹkyuẹ kẹ ihyuu ishishi lan, ididu anushin o soo wan aYahudawa wan nii ọngrẹn ọka ẹgọn Ọnọm uzun lan kẹ aYahudawa, ana ẹgbẹna izun laan, tuhuan ididu wan so lẹ ọka kẹ ọmẹ esheshi shin Ọnọm kpaa onyun kẹ ọmẹ uKristi ọYẹsọ.<verse eid="EPH 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7" />Lẹ esheshi Ọnọm kẹ ọdọ ọlọlẹ ghan, Imi ekye agrẹn ẹnkẹ ihyuu ishishi lẹn shin ama mi lẹ ọtuan ọdọ ghan <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />Kẹ ushin imi nga ẹn srẹ lẹ ọhyuẹ kẹ ọmẹ ana ọrẹ̀ẹ̀ kẹ ọmẹ arẹn Ọnọm, tushin àá ma mi esheshi ghan: sablọ imi too anushin a soo wan aYahudawa wan ihyuu ishishi kẹ aprẹ unkon bọ igbo shin ọ̀ywua lapam kẹ ọmẹ uKristi, <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />tuhuan kẹ imi wla uye lẹn kan lakpẹkprẹ kẹ ada kpẹ ọnkyẹ shin Ọnọm, anushin òó du ididu ọnkyẹ, shin e yee kyuo kẹ ọtẹkpa ohun. <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />Unii Ọnọm wọ uso shin, ẹnga udu ọtuan lẹ ana ure Ọnom kan kẹ enyin ididu ana udu ẹgọn kẹ ọdọ kẹ ẹnhuọ aprẹmẹn ọza ikon nga kẹ utee unkon. <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />Ọbyan Ọnọm wẹn bọ igbo, ọnwọ shin òó du kẹ ọmẹ uKristi ọYẹsọ Ekye Abaan enyi. <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />Ọtrẹkyuẹ kẹ uKristi kẹ ọkpọn lẹ ẹhurẹ enyi kẹ ọmẹ nga, ọnwọ ọsọ enyi ta ẹn kan lẹ ọnhuọ Ọnọm lẹ ọdọ ẹhurẹ bọọ ibun kẹladẹn. <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />Ọnwọ ọsọ Imi kon ọwan unu shin, kalẹ ẹhurẹ unu kyẹẹ yọ sablọ ẹ̀va shin Imi kon ọhyua sablọ kẹ unu lẹn ma, kọ ẹva mi lẹn yẹ iso ọdọọ unu.<verse eid="EPH 3:13" /></para>
  <para style="s">Ọpẹlọnọm sablọ Afisawa</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />Sablọ kẹn, Imi ata ongbun kẹ ẹmpakye Ekye, <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />bikẹ ọnhuọ ididu abaan nga wọ kẹ aprẹn kẹ ohun ngrẹn ọntua ẹplẹpan kọ. <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />Imi a pẹlọnọm ka ma unu ọdọ kẹ ọna ẹhurẹ bikẹ ọmẹ ọdọọ unkon ghan tuhuan kẹ a ma unu ọdọ kẹ ọmẹ ẹhurẹ unu lẹ ọdọ Iri ghan, <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />sablọ shin uKristi ywuà kẹ ọmẹ ẹhurẹ unu lẹ ọkpọn lẹ ẹhurẹ. Tuhuan Imi eywure ka wan shin, unu anushin a tigha lakẹnkan kẹ ọmẹ ọbyan Ọnọm, <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />nii ukon ọdọ, kẹ ididu ana ọdẹdẹy, kẹ unu kpẹ upesi kẹ ẹgbran, kẹ uruun, kẹ ulom ọbyan ọ̀nwọ̀ uKristi, <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />tuhuan kẹ unu kpẹ ọbyan lẹn shin ọsrẹ ididu ọza sablọ shin unu kuang lẹ ididu ọkuang Ọnọm.<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />Kan lẹ ẹnga, anushin èé mle udu ọnkyẹ shin atẹ amaa wan ma kẹ asrẹ ọwan kẹ ọrẹn ẹhurẹ enyi lẹ ọdọ ghan shin ukon udu ọtuan kẹ ọmẹ enyin, <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />Ọdọọ kan lẹ ẹnga kẹ ọmẹ abaan Ọnọm tuhuan kẹ uKristi ọYẹsọ kan lẹ ididu ẹlẹn, igbo ohun kan lẹ igbo ohun, Amin.<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s">Uzun kẹ ọmẹ Ẹgbẹna uKristi</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />Imi, ana ọywua kẹ unkoo ẹva sablọ Ekye abaan, Imi a wan unu shin unu ywua ọywua shin ọgbaa kẹ ọdra shin unu a ngrẹn. <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />Unu so ana usro ẹkyuẹ kan lẹ ẹbọn kẹ anushin a ka kpọn wan aprẹ lẹ ọdọ wan; ana ẹhurẹ ọrang, unu kọ lẹ eple kẹ ọmẹ ọbyan. <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />Unu ywua ọywua uzun kẹ ọmẹ Iri kẹ ọmẹ uhuọ unsewan shin unu kon udu kẹ ọmẹ ọna ẹhurẹ. <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />Ẹgbẹna izun soo kẹ Iri izun, kawan emle shin ala dra unu kan lẹ ọsọ ẹhurẹ uzun kẹ ẹlẹn shin ala dra unu wọ <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />Ekye abaan ozun, ọdọ ẹhurẹ uzun, ọbaftisma uzun; <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />Ọnọm uzun kẹ Ekye anga ididu, anushin okon udu ọtuan kẹ aprẹn ididu, tuhuan kẹ ọmẹ ididu kẹ ididu.<verse eid="EPH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7" />Tushin huọ ẹnga nga kẹ ọmẹ enyi ama ghan esheshi emle shin uKristi ma wọ. <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />Ọnwọ sọ Aprẹ Ọnọm shin:</para>
  <para style="q1" vid="EPH 4:8">“Lẹ ushin àá la nya kan lẹ aprẹmẹn,</para>
  <para style="q2" vid="EPH 4:8">ala kpọn ofuwo ghan shin ẹnga ya ẹkyuẹ lẹ ẹma,</para>
  <para style="q2" vid="EPH 4:8">tuhuan ka ma ada wan agyuan kẹ itite.”<verse eid="EPH 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9" />(Unse wan “Àá nya kan lẹ aprẹmẹn” unyin? shin uKristi huọ usri ba lẹ ilu ẹbọn? <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />(Ẹnga anushin èé sri balẹ ẹbọn nga oso ana shin àá nya kan ghan lẹ aprẹn shin o run kẹ asrẹ aprẹmẹn, sablọ shin ẹnga kuan ididu ohun lẹ ẹkyuẹ ghan.) <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />uKristi ghan ma eple enyi ma kẹ kye apaduan, eple nyi ma kẹ kye onu, eple nyi ma kẹ kye ana too aprẹ Ọnọm, tuhuan eple nyi ma kẹ kye ana utoo ihyuu ishishi kẹ avua, <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />kẹ sem enyi Ọnọm lẹ ẹtuan ẹn ya udu, sablọ ẹgbẹna uKristi vram kan <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />sẹ ididu enyi kye ozun kẹ ọmẹ ọdọ ẹhurẹ kẹ ọza ọnwọ Arẹn Ọnọm tuhuan kẹ enyi fuọ lakẹnkan, kẹ enyi kye kawan uKristi.<verse eid="EPH 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 4:14" />Tuhuan enyi nii ma ọtọ usoo unsun arẹn ma, lẹ ataa enyi lẹ ekyre kan lẹ ekye kẹ ititim, lẹ uwu kẹ ulolo ọprọpra kẹ ọntran ana uwu ada. <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />Lẹ udu klan, enyi nii utoo ẹplẹpan kẹ ọmẹ ọbyan, enyi nii ọfuọ kẹ uhuo ulon ọntran nga wọ kẹ ọmẹ uKristi, anushin àá nga oso Ẹkyuẹ. <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />Bikẹ ọnhuọ ghan ididu ẹgbẹna, shin ẹ̀ẹ́ klan kẹ afrẹ iple lẹ ididu atọ̀ ẹgbẹna, fuwọ kẹ avran ẹkyuẹ kọ kẹ ọmẹ ọbyan, kawan emle shin huọ ulon ọga ghan kẹ odu ọtuan wọ.<verse eid="EPH 4:16" /></para>
  <para style="s">Ọywua kawan Arẹn Ọsẹẹ</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />Ọnwọ ọsọ Imi o too unu an yẹn lẹ ọntua Ekye abaan, shin kalẹ unu tọ ywua kawan anushin o soo wan aYahudawa wan, kẹ ọmẹ ọrẹn ẹhurẹ ọnwọ ililu wọ. <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />O so lẹ itum kẹ ọmẹ ọza wan tuhuan kẹ a plam kẹ ọrẹ ọnwọ Ọnọm sablọ ọkpẹkpua ẹhurẹ wan. shin usoo kẹ ọmẹ ma. <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />Sablọ shin o hyu wan kẹ ọkọọn ọwa wan, ama akyuẹ wan kẹ udu ọnkyẹ ililu kẹ utri tuhuan lẹ aywua kẹ ọmẹ udu ọnkyẹ ajajẹ bọ ọkọọn ibun ma.<verse eid="EPH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20" />Tushin unu, kyẹ ọnkyẹ shin unu ololo kẹ aprẹ uKristi wlan ma. <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />Ẹplẹpan ya unu akọọn aprẹ ghan tuhuan ololo unu kẹ ọmẹ nga lẹ ẹplẹpan shin isoo kẹ ọmẹ ọYẹsọ. <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />A la ololo unu, kẹ aprẹ ọywua ọnwọ ikyikyuo unu, kẹ unu laa ọywua ọnwọ ikyikyuo unu kan, ọnwọ shin ọ bẹn ọywua unu sablọ udu ọnkyẹ utri kẹ ọbyan ọnkyẹ ohun unu; <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />kẹ unu kye ana aprapra lẹ ukye ẹhurẹ unu; <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />tuhuan kẹ unu kye ọprọpra, shin odu kẹ ekye kawan Ọnọm kẹ ọmẹ ẹsẹẹ kẹ ọdẹdẹy ọnwọ ẹplẹpan.<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />Ọnwọ ọsọ ọdọ huọ ẹnga nga kẹ ọmẹ unu laa ọywua ọntẹ kan tuhuan kẹ otoo onuse ankam nga ẹplẹpan, kẹ́ enyi ẹka ẹgbẹna izun yaa. <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />“Kẹ ọmẹ amua unu kalẹ unu du ilovro wan”: Kalẹ unu laa idre ọnọm kpa kọ unu tọ hyu kẹ ọmẹ amua wan, <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />tuhuan kalẹ unu ma ana udu ọnkyẹ ububi arẹ̀n epin ma. <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />Anushin okon ujire utuo laa kan, tushin ọdọ wọ o du ọtuan, lẹ o du ọnlighẹ agyagyuan lẹ anyẹ nga, shin ẹnga tọ ahuọ ma anushin o soo wan lẹ ọma ma.<verse eid="EPH 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EPH 4:29" />Kalẹ ẹtọprẹ ajajẹ tro bikẹ ọmẹ onyun unu ma, sẹ ẹtọprẹ agyagyuan shin inii ọma ada ọdọ ẹhurẹ kẹ emle unii ma, sablọ anushin akọọn nii ukon ọtrẹm lẹ ẹnyọ. <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />Kalẹ unu bẹn Iri Ẹsẹẹ Ọnọm ẹhurẹ wọ wan, sablọ ẹnya iso ankpẹ shin unu ama Ọnọm ma kẹ aywuẹ ufuo. <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />Unu plan akyuẹ unu kẹ ididu ambẹn ẹhurẹ, kẹ ishim, kẹ amua, ọhuẹn, kẹ ọbẹn ọntua kẹ huo ute ukon lẹ ẹhurẹ. <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />Unu byan eple kẹ unu ywua lẹ anọọn kẹ eple, lẹ unu huro eple ilovro, kawan emle Ọnọm huro ilovro unu kẹ ọmẹ uKristi wọ.<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="nb">
    <verse number="1" style="v" sid="EPH 5:1" />Unu kye ana ulolo Ọnọm, unu arẹn ọbyan nga <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />tuhuan kẹ unu ywuà ọywua ọbyan, emle shin uKristi byan enyi wọ tuhuan kẹ okpo ghan sablọ kẹ enyi ka ma ẹkyuẹ ghan kawan agyuan ọvrọng kẹ enshin òfuwo kan lẹ Ọnọm.<verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />Tushin ka lẹ okon ẹ́va kẹ ọmẹ unu huọ la hyuẹ wan, huọ utee iluwe, huọ ọbyan ẹkyuẹ sablọ ọnkyẹ lẹn soo wan kẹ agyagyuan kẹ ọmẹ arẹn ẹsẹẹ Ọnọm ma. <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />Bọ enii ukon ọnẹ ẹ́va kẹ ọpya onyun igbon huọ ọnẹ uywu shin usoo wọ kẹ agyagyuan ma, tushin sẹ ọsọ Ọnọm ẹjaa. <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />Sablọ kẹn unu kpọn lẹ ẹplẹpan shin: bọ ana udu ẹ́va kẹ ana ajajẹ huọ ana ọbyan ẹkyuẹ ghan, ana ọdọọ ọnọm ọsẹsọ shin o so lẹ ọkà kẹ ọmẹ ẹgọn uKristi huọ ẹnkẹ Ọnọm ma. <verse eid="EPH 5:5" /><verse number="6" style="v" sid="EPH 5:6" />Ka lẹ alọ wu unu lẹ ẹtọprẹ uywu wan, kẹ ọsablọ ọnkyẹ lẹn amua Ọnọm kẹ esri kẹ aprẹn ana shin atran ma ure iywuro kan. <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />Onwọ ọsọ kalẹ unu sọ ẹ̀ywuà kẹ ẹma ma.<verse eid="EPH 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EPH 5:8" />Kẹ ikyikyuo unu lẹ o soo itum, tushin ẹladẹn unu ọsẹẹ wọ kẹ ọmẹ Ekye abaan. Ọnwọ ọsọ, unu ywuà kawan arẹn ọsẹẹ. <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />Kẹ ọsablọ ankpẹ ẹnya ọsẹẹ yẹ oso uyi, kẹ ọdẹdẹy kẹ ẹplẹpan <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />unu lolo ọnkyẹ shin unii uhyuo Ọnọm ẹhurẹ. <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />Kalẹ okon unu kẹ ọnhuọ udu ọnkyẹ ililu kẹ ọma ọmẹ itum ma, tushin unu vroo wan. <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />Sablọ ọnlẹghẹ ọwa wan atẹ otoo aprẹ ọnkyẹ shin ana ọtran ma ure iywuro Ọnọm kan kon udu kẹ ọmẹ itum. <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />Tushin huọ unsewan shin ọsẹẹ lẹn saan kẹ aprẹn nẹ, aka eshin wọ. <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />sablọ shin ọsẹẹ wọ ọka sọ̀ e le shìn huọ unsewan. Ọnwọ ọsọ aprẹ Ọnọm shin:</para>
  <para style="p" vid="EPH 5:14">“Swan, ẹngọ ana ukon ọna,</para>
  <para style="q2" vid="EPH 5:14">nyẹnya bikẹ ọmẹ itun,</para>
  <para style="q1" vid="EPH 5:14">tuhuan uKristi nii saan kẹ aprẹn unu.”<verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />Ọnwọ ọsọ unu kon aklọ lẹ emle shin unu ywuà wọ. Kalẹ unu ywua kawan ogbon ma, tushin kawan anushin oso lẹ ọntran, <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />unu du ọtuan lẹ ididu huo ulon ẹ̀lẹn shin unu okon, lẹ udu ọnkyẹ agyagyuan sablọ shin àywuẹ shin enyi soo kẹ ọmẹ nga lẹn so kẹ ebebi. <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />Ọnwọ ọsọ, kalẹ unu kye ogbon ma, tushin unu kpẹ ọnkyẹ shin Ekye abaan Ọnọm nii shin unu du. <verse eid="EPH 5:17" /><verse number="18" style="v" sid="EPH 5:18" />Kalẹ unu hyua akan ka pyan unu ma sablọ shin enii blẹn ọywua unu wọ, tushin unu kuang lẹ Iri Ẹ̀sẹẹ. <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />Unu kẹ a pya onyun kẹ eple kẹ ọmẹ ọzaa àntẹn, antẹn ọnọọn, kẹ àntẹn Iri. Unu taa antẹn kẹ ọmẹ ẹhurẹ unu lẹ unu blẹ Ekye abaan Ọnọm. <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />Unu ka sọ Ọnọm Ekye ẹjaa huo ilon ẹlẹn ya wọ kẹ huọ unsewan, kẹ ọmẹ ọntua Ekye abaan enyi ọYẹsọ uKristi.<verse eid="EPH 5:20" /></para>
  <para style="s">Ashẹ kẹ Ekyi</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21" />Unu ma eple akyuẹ unu kawan ọdọọ uKristi.<verse eid="EPH 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />Ashẹ, unu ma ekyi unu akyuẹ unu kawan kan lẹ Ekye abaan. <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />Sablọ shin enkyi nga oso ẹkyuẹ anshẹ emle shin uKristi ghan oso ẹkyuẹ unu re Ọnọm kan, ẹgbẹna nga, ọnwọ shin ẹnga nga oso òfuwo. <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />Emle shin ana ure Ọnọm kan kẹ ama ẹkyuẹ wan kan lẹ uKristi wọ, emle lan nga ashẹ ma akyuẹ wan kan lẹ ekyi wan kẹ ọmẹ uhuọ unsewan.<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25" />Ekyi, unu byan ashẹ unu, emle shin uKristi byan ana ure Ọnọm kan kẹ ama ẹkyuẹ ghan sablọ ẹma <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />kẹ ekye wan ọnlẹghẹ ẹsẹẹ, kẹ o huro wan lẹ ambrẹ kẹ ẹtọprẹ Ọnọm, <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />sablọ kẹ ẹnga kpọn ma kẹ ama ẹkyuẹ ghan kawan Abaan Ọnọm ẹn kẹ Ẹsẹẹ, bọ ilue, huọ ọtrẹn wọ, tushin ẹn kẹ ọdẹdẹy bọ ilue. <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />Emle lan nga, ọgbaa ekyi ọbyan ashẹ wan kawan ẹgbẹna ma. Anushin àá byan àshẹ ghan byan ẹkyuẹ ghan wlan. <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />Bọ anushin àá huọ tran nga ẹgbẹna ghan ma, tushin enii upiye yaa kẹ okon aklọ lẹ ẹnyaa, emle shin uKristi kon ukon aklọ lẹ ana ure Ọnọm kan wọ. <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />Sablọ shin enyi ite ẹgbẹna ghan yaa. <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" />“Sablọ kẹn, enkyi nii ọlaa ekye ghan kẹ ẹya ghan tuhuan kẹ ekye ọnlẹghẹ uzun lan kẹ ashẹ ghan, tuhuan ọpua wan nii ukye ẹgbẹna izun.” <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />Ọnwẹn wọ uso uye ọlọlẹ shin ukon unyin ọywua uzun ọnwọ uKristi kẹ una ure Ọnọm kan. <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />Imi kyẹ uywure kyẹ utoo unu shin, huo olon enkyi ghan ọdọ wọ a byan ashẹ ghan emle shin àá byan ẹkyuẹ ghan wọ, tuhuan ọdọ wọ anshẹ lan re ọnkyẹ uto ekyi ghan kan.<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s">Arẹn kẹ anushin obyon ma</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />Arẹn, unu re ọnkyẹ uto anushin obyon unu kan kẹ ọmẹ Ekye Abaan, sablọ ọgba kẹn. <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />“Dọrọ ekye unu kẹ ẹya unu” kẹ ọnwẹn wọ uso iywuro ẹnyẹ ọta ẹkpa kẹ ọkpa onyun nga, <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />“sablọ shin huo unsewan ton lẹ inshin kẹ ẹngọ tuhuan ẹngọ nii ukon ẹgbran ọrẹ kẹ ohun.”<verse eid="EPH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4" />Unu ekye, kalẹ unu pya arẹn unu ẹ̀hurẹ wan; lẹ udu klan, unu lolo wan emle ọywua agyagyuan kẹ antẹghan nga kẹ ọntraan Ekye abaan Ọnọm.<verse eid="EPH 6:4" /></para>
  <para style="s">Agrẹ̀n kẹ ekyè abaan</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />Unu agrẹ̀n, unu re ọnkyẹ utoo ekye abaan unu aman ohun kan, unu dọrọ kẹ unu kọ̀n ibun ma, lẹ ẹhurẹ ẹplẹpan emle shin unu nii ure ọnkyẹ utoo uKristi kan wọ. <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />Unu re ọnkyẹ utoo wan kan bọ sẹ ẹlẹn shin unu nii ukon ọbyan ma huo inshin edre wan soo kẹ aprẹn unu ma, tushin kawan agrẹn uKristi, unu du ọnkyẹ unii Ọnọm bikẹ ọmẹ ẹhurẹ unu. <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />Unu du ọtuan lẹ ẹhurẹ izun, kawan ọtuan Ọnọm wọ unu kon udu bọ ọnwọ enyetri wan, <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />unu za shin Ọnọm nii ọma huọ ẹnga nga ọnkyẹ shin ọgbaa kẹ ọtuan shin òó du, huọ ẹnga àgrẹn nga huọ kyẹ agrẹn nga ma.<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />Tuhuan unu ekye abaan, unu nyin agrẹn unu ọbyan utee uzun lan. Kalẹ unu ta wan eji kẹ ọfọn ma, unu za shin; unu kẹ ẹma so lẹ Ekye abaan ozun lan kẹ Aprẹmẹn, tushin ẹnga ka e nyin nga ọbyan ẹkyuẹ wan.<verse eid="EPH 6:9" /></para>
  <para style="s">Ọnkyẹ ọhuẹn ọnaa Ọnọm</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />Ọplẹ lẹn, unu du ẹ̀hurẹ ẹ̀dọ kẹ ọmẹ Ekye Abaan Ọnọm kẹ ọmẹ ọdọ ghan ọlọlẹ. <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />Unu shẹẹ ididu ọnkyẹ ọhuẹn ọnaa ọma Ọnọm kẹ ọnhuọ ọhuẹn ọnaa sablọ shin unu mle ọtẹgha lẹ ọdọ kẹ unu ya ẹkyuẹ lẹ ididu ọntraan ana udu ọnkyẹ ububi. <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />Sablọ shin kyẹ ofuo ẹgbẹna kẹ eji wan enyi kon ọhuẹn kẹ ẹma ma, tushin enyi kon udu ifuo kẹ ana udu ẹgọn, kẹ ọdọ ẹgọn, kẹ ọdọ ohun itum lẹn, tuhuan kẹ ọdọ iri ibibi ohun lẹn kẹ ọmẹ amẹn. <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />Ọnwọ ọsọ unu shẹ ididu ọnkyẹ ọhuẹn ọnaa ọma Ọnọm, sablọ inshin aywuẹ èbebi ba, unu nii umle ọtigha lẹ ọdọ ẹhurẹ kẹ unu ya ẹkyuẹ lẹ òfuwo unu, tuhuan kẹ unu ywure kẹ unu tẹgha la gyẹgyẹghẹ. <verse eid="EPH 6:13" /><verse number="14" style="v" sid="EPH 6:14" />Unu tigha la gyẹgyẹghẹ, kẹ unu frẹ ẹplẹpan la kpẹkpua kawan udron shin erè kẹ ebre, tuhuan ọdẹdẹy kye ẹngbapia ọyẹra kẹ ẹgbẹna unu, <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />tuhuan ẹnuan ẹnyẹ utòó iywuu ishishi ẹnkọ ọnaa ẹhurẹ kye kawan akplà kẹ afraan unu. <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />Ọtra kẹ aprẹn ididu ọnkyẹ lẹn, unu shẹ ẹngbapya ẹn kẹ ọdọ ẹhurẹ, ẹnkọ shin unu nii udu ọtuan lẹ ẹnkọ kẹ unu pẹẹ iwu ọla átraa ẹnyẹ ana udu ebebi lan. <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />Unu kpọn ẹndaja ọyẹra ẹnya ufuwom kẹ ọhurẹ iri, ọnwọ shin ọnwọ uso aprẹ Ọnọm. <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />Tuhuan unu pẹlọnọm kẹ ọmẹ Iri huo ilon ẹlẹn yaa wọ. kẹ ididu itee ọpẹlọnọm kẹ ẹ̀wẹn. Lẹ ọnwẹn kẹ ọmẹ ẹhurẹ, unu ywua lẹ unu zọ lẹ unu ọpẹlọnọm sablọ ididu ana ọdẹdẹy.<verse eid="EPH 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 6:19" />Unu huọ pẹlọnọm sablọ Imi, sablọ huọ ẹlẹlẹn yaa shin Imi okun onyun mi, alẹ ọma mi ẹtọprẹ sablọ kẹ Imi mle utoo aprẹ uye ihyuu ishishi lẹn bọ ibun, <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />ẹn kọ shin ẹsọ Imi e atuan Ọnọm nga kẹ ọmẹ iwe ọyẹra. Unu pẹlọnọm kẹ ama mi ọdọ utoo ihyuu ishishi lẹn bọ ibun emle shin ọgbaa wọ.<verse eid="EPH 6:20" /></para>
  <para style="ms">Ọpẹ ọplẹ</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />uTikikus, ewedri mi kẹ agrẹn Ọnọm agyagyuan shin Imi a byan, nii utoo unu huo unsewan sablọ unu nii ọkpẹ emle shin Imi kon udu wọ kẹ ọnkyẹ shin Imi kon udu. <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />Sablọ kẹ ọnwẹn unii mi lẹn, Imi kyẹ ọtuan nga kan lẹ ọnhuọ ọywua unu kẹ unu kpẹ emle shin enyi soo wọ, tuhuan kẹ ama unu ẹhurẹ ẹdọ.<verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />Ọnaa ẹhurẹ ywuà kẹ unu, ewedri, tuhuan ọbyan kẹ ọdọ ẹhurẹ bikẹ ọnhuọ Ọnọm Ekye, tuhuan kẹ Ekye abaan ọYẹsọ uKristi, <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />Esheshi kan lẹ ididu anushin a byan Ekye abaan enyi ọYẹsọ uKristi lẹ ọbyan bọ igbo.<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>