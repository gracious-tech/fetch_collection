<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="COL" style="id">- Eda</book>
  <para style="toc2">uKolosiyawa</para>
  <para style="toc3">uKolosiyawa</para>
  <para style="mt1">uKolosiyawa</para>
  <chapter number="1" style="c" sid="COL 1" />
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1" />Imi uBulus, anpaduan ọYẹsọ uKristi emle shin Ọnọm nii wọ kẹ uTimoti ewedri enyi, rẹn unu ẹnrẹn lẹn, <verse eid="COL 1:1" /><verse number="2" style="v" sid="COL 1:2" />ewedri enyi ana ọdẹdẹy kẹ ana ẹplẹpan kẹ ọmẹ uKristi kẹ uKolosi: Esheshi kẹ ọnaa ẹhurẹ kan lẹ ọnhuọ unu bikẹ ọnhuọ Ọnọm Ekye enyi.<verse eid="COL 1:2" /></para>
  <para style="s1">Ọsọ ẹjaa kẹ ọpẹlọnọm</para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3" />Huọ ilon ẹlẹn yaa enyi aka sọ Ọnọm ẹjaa, Ekyé Ekyè abaan enyi ọYẹsọ uKristi, inshin enyi kyẹ ọpẹlọnọm sablọ unu, <verse eid="COL 1:3" /><verse number="4" style="v" sid="COL 1:4" />sablọ shin enyi ahuọ ọkọọn aprẹ ọdọ ẹhurẹ unu kẹ ọmẹ uKristi ọYẹsọ tuhuan kẹ ọbyan shin unu abyan ididu ana ọdẹdẹy, <verse eid="COL 1:4" /><verse number="5" style="v" sid="COL 1:5" />ọdọ ẹhurẹ kẹ ọbyan shin utro bikẹ kẹ ọmẹ ọsọ ẹhurẹ shin e tighe unu kẹ Aprẹmẹn tuhuan unu a huọ ọkọọn aprẹ lẹn kẹ ọmẹ aprẹ ẹplẹpan, ihyuu ishishi <verse eid="COL 1:5" /><verse number="6" style="v" sid="COL 1:6" />shin ẹ huọ ọba lẹ ọnhuọ unu. Ihyuu ishishi lẹn kon ọfuọ lẹ idu ẹkra kẹ ididu ohun, kawan emle shin ikon udu wọ kẹ ọmẹ unu kyikyuo ubon shin unu a kọọn aprẹ kọ tuhuan kẹ akpẹ esheshi Ọnọm kẹ ọmẹ ididu ẹplẹpan kọ. <verse eid="COL 1:6" /><verse number="7" style="v" sid="COL 1:7" />Unu ololo wọ bikẹ ọnhuọ Abafaras, agrẹn enyi shin enyi abyan, anushin àá tigha sablọ enyi tuhuan ana ẹplẹpan nga kẹ ọmẹ udu ọtuan Ọnọm, <verse eid="COL 1:7" /><verse number="8" style="v" sid="COL 1:8" />tuhuan àá nga eywure kẹ oto enyi aprẹ ọbyan ọnwọ unu kẹ ọmẹ Iri lan. <verse eid="COL 1:8" /><verse number="9" style="v" sid="COL 1:9" />Ọklan wọ, kyuo ubon shin enyi akọọn aprẹ unu, enyi so utrim ọpẹlọnọm sablọ kẹ unu lẹ enyi wan Ọnọm ka kuan unu lẹ ọza unii ghan kẹ aprẹn ididu ọza ikon ọnwọ Iri kẹ ọkpẹ. <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />Tuhuan enyi a pẹlọnọm kẹn, sablọ shin unu ywuà ọywuá shin unii ọgbaa kẹ Ekye abaan tuhuan kẹ uhyuo ghan ẹhurẹ kẹ ọhuọ ulon ọntraan nga wọ: lẹ udu ẹkra kẹ ọmẹ ọhuọ ulon ọtuan ọgyagyuan nga wọ, kẹ ọfuọ kẹ ọmẹ ọza Ọnọm, <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" />shin a ma unu ukon ọdọ lẹ ọdọọ ọlọlẹ ghan sablọ shin unu kon ọnuan ẹhurẹ kẹ ukon aklọ shin unu nii tuhuan lẹ ọkọọn ushi <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />lẹ unu sọ Ekye ẹjaa, anushin àá sọ unu amẹ ukon ọka kẹ ọmẹ unkon ọ ma ana ọdẹdẹy ọmẹ ẹgọn ọsẹẹ. <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />Kẹ òó fuó enyi bikẹ ọmẹ ẹgọn itum tuhuan kẹ okon enyi ba lẹ ọmẹ ẹgọn ẹn kẹ Arẹn lan shin àá byan, <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" />anushin ọmẹ ghan wọ enyi okon ofuo wọ kẹ uywuro ilovro.<verse eid="COL 1:14" /></para>
  <para style="s">uKristi Srẹ ledidu</para>
  <para style="p">
    <verse number="15" style="v" sid="COL 1:15" />uKristi nga oso iriri Ọnọm shin aka eshìn wan ma, ẹkyuẹ ikon ọnkyẹ shin odu ledidu. <verse eid="COL 1:15" /><verse number="16" style="v" sid="COL 1:16" />Sablọ ọtrẹkyuẹ kẹ ẹnga wọ o du ọhuọ unsewan: ọ́nkyẹ kẹ ọmẹ aprẹn kẹ ẹbọn, ọma shin e kẹ eshìn kẹ ọma shin e kẹ eshìn wan ma, huọ ọntrẹtrọ ẹgọn, huọ ọdọ, huọ ọdọ ẹgọn; odu ididu ọnkyẹ lẹ ẹnga tuhuan sablọ ẹnga. <verse eid="COL 1:16" /><verse number="17" style="v" sid="COL 1:17" />Ẹnga soo kẹ ekye ididu ọnkyẹ, tuhuan kẹ ọmẹ nga wọ ididu ọnkyẹ bram kẹ uple. <verse eid="COL 1:17" /><verse number="18" style="v" sid="COL 1:18" />Tuhuan ẹnga nga oso ẹkyuẹ ẹgbẹna, ana ure Ọnọm kan; àá nga oso ọtẹkpa kẹ ẹkyuẹ ikon bikẹ ọmẹ anushin e kyure wan, sablọ shin ẹnga kye agọn shin asrẹ lẹ ọdọọ kẹ ọmẹ uhuọ unsewan. <verse eid="COL 1:18" /><verse number="19" style="v" sid="COL 1:19" />Ẹhurẹ Ọnọm lẹ ohyuo oshin ididu ghan (ẹnga Ọnọm) ywua kẹ ọmẹ uKristi, <verse eid="COL 1:19" /><verse number="20" style="v" sid="COL 1:20" />tuhuan kẹ ọtrẹkyuẹ kẹ uKristi, Ọnọm nii sem ididu ọnkyẹ kan lẹ ẹkyuẹ ghan, huọ ọnkyẹ kẹ ohun huọ ọnkyẹ kẹ ọmẹ aprẹmẹn, lẹ ukon ọnaa ẹhurẹ wan lẹ eji ghan, shin e she kẹ aprẹn ekyi ọsẹsra. <verse eid="COL 1:20" /><verse number="21" style="v" sid="COL 1:21" />Ikyikyuwo ala plan unu kẹ Ọnọm tuhuan kẹ ekye ofuo Ọnọm kẹ ọmẹ ẹhurẹ unu sablọ udu ọnkyẹ utri. <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />Tushin kẹladẹn, Ọnọm ywure lẹ unu lẹ ẹgbẹna uKristi kẹ ọtrẹkyuẹ kẹ ukpo ghan kẹ ẹnga kpọn unu ka ma ẹkyuẹ kawan ọnlẹghẹ ẹsẹẹ kẹ ẹmpakye ghan, bọ ilue, bọ ẹtua, <verse eid="COL 1:22" /><verse number="23" style="v" sid="COL 1:23" />inshin unu a frẹ ọdọ ẹhurẹ unu kẹ okon, ka tigha lakpẹkpua, bọ unu ekye ititim lẹ ọsọ ẹhurẹ unu ihyuu ishishi wan. Ihyuu ishishi shin unu ala kọọn kẹn tuhuan ahuọ utoo ọhuọ ẹnga nga kẹ ilu Aprẹmẹn, ọnwọ shin Imi, uBulus, huọ ukye agrẹn wọ.<verse eid="COL 1:23" /></para>
  <para style="s">uBulus du ana ure Ọnọm kan ọtuan</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24" />Kẹladẹn Imi kọọn ushì kẹ ọmẹ ẹva shin a huọ́ ọhyua sablọ unu, tuhuan Imi a huọ ọhyua ẹva lapam kẹ ọmẹ ẹva uKristi, sablọ ẹgbẹna nga, ana ure Ọnọm kan. <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />Imi ahuọ ukye agrẹn ana ure Ọnọm kan lẹ ọtuan shin Ọnọm ma mi kẹ Imi too unu aprẹ ghan ledidu, <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />Uye shin e ye amẹ kẹ ẹlẹn lapam, tushin kẹladẹn, e nyin ana ọdẹdẹy. <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />Ọnọm nii udu ọtuan lẹ ana ọdẹdẹy lan kẹ enyin anushin o soo wan aYahudawa wan ọdọọ ọnwọ unkon uye lẹn, shin uso uKristi kẹ ọmẹ unu, ọsọ ẹhurẹ ọnwọ ọdọọ. <verse eid="COL 1:27" /><verse number="28" style="v" sid="COL 1:28" />Ọnwọ ọsọ enyi otoo ihyuu ghan, kẹ owo ada atọn tuhuan kẹ ulolo huo ẹnga nga lẹdidu ọza ikon, sablọ enyi sọ ọhuọ ẹnga nga bọ uvro kẹ ọmẹ ọza uKristi. <verse eid="COL 1:28" /><verse number="29" style="v" sid="COL 1:29" />Ọnwọ ọsọ Imi odu ọtuan, lẹ Imi yẹ lakẹnkan lẹ ọdọ ghan, shin ukon udu ọtuan kẹ ọmẹ mi.<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1" />Imi nii shin unu za emle shin Imi kon ọyẹ wọ sablọ unu kẹ ana ọLawudikiya, kẹ ididu anushin oso nya wan ọklan kẹ imi ma. <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />Unii mi wọ uso shin ẹma kon ọdọ ẹhurẹ tuhuan kẹ okyun akyuẹ kẹ ọmẹ ọbyan, sablọ kẹ ẹma kon ẹkpẹkprẹ ọkpẹ, tuhuan kẹ ẹma kpẹ uye Ọnọm, ọnwọ shin ọnwọ uso uKristi, <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />ọmẹ nga wọ e ye ididu unkon ọma ọza ikon kẹ ọkpẹ. <verse eid="COL 2:3" /><verse number="4" style="v" sid="COL 2:4" />Imi otoo unu ọnwẹn sablọ kalẹ alọ wu unu lẹ ọya ẹna ọdẹnduọ wan. <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />Kẹ ushin imi soo mi kẹ unu kẹ ọmẹ ẹgbẹna ma, tushin imi soo kẹ unu kẹ ọmẹ Iri tuhuan Imi nii ọmọ inshin Imi eshìn shin unu a frẹ eple lẹ unu ywua emle shìn ọgbaa wọ tuhuan ọdọ ẹhurẹ unu kẹ ọmẹ uKristi so ọdọ.<verse eid="COL 2:5" /></para>
  <para style="s">Ukon Uplem Bikẹ Ure Iywuro Enyetri Lẹ Ọywua Kẹ Ọmẹ uKristi</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />Emle shin unu a ngrẹ uKristi ọYẹsọ kawan Ekye abaan, unu frẹ ọywua kẹ ọmẹ nga, <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />unu frẹ akyuẹ unu kẹ unu vran akyuẹ unu lakẹnkan kẹ ọmẹ nga, ọdọ unu kẹmmẹ kẹ ọmẹ ọdọ ẹhurẹ emle shin ololo unu kọ, tuhuan kẹ unu kuang lẹ ẹjaa. <verse eid="COL 2:7" /><verse number="8" style="v" sid="COL 2:8" />Unu kon aklọ kalẹ alọ sọ unu udu ọnlẹɡhẹ lẹ ọdọ wan, lẹ ulolo uywu shin utro bikẹ ọrẹn ẹ̀hurẹ enyetri, shin ọywuram lẹ emle ọywua enyetri kẹ ẹgbọn ulolo ohun lẹn lẹ ọnwọ uKristi. <verse eid="COL 2:8" /><verse number="9" style="v" sid="COL 2:9" />Sablọ kẹ ọmẹ uKristi Ọnọm ywua wọ ledidu kẹ ọmẹ ẹgbẹna, <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />tuhuan unu a kuang lẹ Iri ọza kẹ ọmẹ uKristi, anushin àá nga okon udu ẹgọn kẹ aprẹn ididu ọngọn kẹ ọdọ ẹgọn. <verse eid="COL 2:10" /><verse number="11" style="v" sid="COL 2:11" />Ọmẹ nga wọ ala ataa unu untun wọ, kẹ plan ọywua ilovro unu, bọ lẹ ọta itun shin odu lẹ anyẹ enyetri wan, tushin lẹ ọta itun shin uKristi ta unu, <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" />lẹ ushin a huọ lọọ unu kẹ ẹnga kẹ ọmẹ ọbaftisma tuhuan kẹ a nyuọn unu kẹ ẹnga lẹ ọdọ ẹhurẹ unu kẹ ọmẹ ọdọ Ọnọm, anushin àá ọnyuọn nga kẹ ọmẹ itun. <verse eid="COL 2:12" /><verse number="13" style="v" sid="COL 2:13" />Lẹ ushin unu a lẹ okpo unu kẹ ọmẹ ilovro unu tuhuan sablọ kẹ ushin asọ ọnya ọtaa unu untun ma, tushin Ọnọm nyuọn unu kẹ atrẹ kẹ ọmẹ uKristi. Òó huro ididu ilovro enyi, <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" />lẹ ushin àá plan ẹnrẹn shin arẹn kẹ aprẹn enyi, kẹ antigha nga, shin ìí so kẹ ọnhuọ udu ifuo kẹ enyi, ẹ sọ ada la tran ma enyi; àá kpọn yọ ka sra kẹ aprẹn ekyi ọsẹsra. <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />Lẹ ushin àá hurẹ ọkraa ọnkyẹ ọhuẹn kẹ anyẹn ana udu ẹgọn ohun kẹ ọdọ ẹgọn ohun, ala ma wan ọwa kẹ etin lẹ ushin àá ya ẹkyuẹ lẹ ẹma kẹ aprẹn ekyi ọsẹsra. <verse eid="COL 2:15" /><verse number="16" style="v" sid="COL 2:16" />Ọnwọ ọsọ kalẹ unu laa alọ kẹ a prẹẹ ataan unu sablọ ọnkyẹ shin unu kon ọya huọ ọhyua, huọ lẹ ushin unu a tran unu udu ẹpan ure Ọnọm kan, huọ ẹpan ọprẹn ọprọpra, huọ aywuẹ utrim. <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />Ididu ọnkyẹ lẹn iriri ọnkyẹ shin unii ọba wan; tushin uKristi nga oso ẹplẹpan ọnkyẹ lan. <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />Kalẹ unu laa anushin okon ọmọ lẹ ọnaa lẹ ẹkyuẹ ghan kan lẹ ẹbọn ọnwọ ọntọntẹ kẹ ana ọdọọ atuan Ọnọm re unu ọngrẹn ọka ọtuan unu ma shin Ọnọm kpaa unu onyun, utee enyi lan lẹn ka blẹm lẹ ọnkyẹ shin ẹma shin, lẹ aywram lẹ ọrẹn ẹhurẹ wan ọnwọ uywu. <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" />Àá plam kẹ ẹkyuẹ, anushin okon ididu antẹgha ẹgbẹna lẹ àtọ, tuhuan ikon ọfuọ emle shin Ọnọm du wọ. <verse eid="COL 2:19" /><verse number="20" style="v" sid="COL 2:20" />Inshin ẹplẹpan yaa unu ala okpo unu kẹ uKristi tuhuan kẹ ẹgbọn ulolo ohun lẹn, unsewan ọsọ unu hyu ọywua kawan anushin ohyu kẹ ọmẹ ohun, unu hyu ure ọnkyẹ uto ohun kan: <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />“kalẹ unu kon ma! kalẹ unu ta ino wọ ma! kalẹ unu pya wan!”? <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />Ididu ọnkyẹ lẹn nii ọsha wan inshin a hurẹ udu ọtuan lẹ ọmaa, sablọ shin ọ̀ọ́ kaba bikẹ ọmẹ ọma onyun enyetri kẹ ulolo wan. <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />Ẹplẹpan utee antẹghan iywuro lẹn so lẹ ọza ikon, kẹ ọnaa lẹ ẹkyuẹ kẹ ẹbọn ọntọntẹ tuhuan kẹ ọtrọ lẹ ẹgbẹna ma, tushin bọ atẹ emle ọlaa udu ẹva kan ma.<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="s">Ẹntraan ọywua Ẹsẹẹ</para>
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1" />A huọ ọnyuọn unu kẹ uKristi, ọnwọ ọsọ unusọ ẹhurẹ unu kẹ ọnkyẹ ọma aprẹmẹn, ọnhuọ shin uKristi trẹtraa wọ kẹ ọnyẹ ẹya Ọnọm.<verse eid="COL 3:1" /></para>
  <para style="pi">
    <verse number="2" style="v" sid="COL 3:2" />Unu sọ ẹhurẹ unu kẹ ọnkyẹ ọma Aprẹmẹn, bọ kẹ ọnkyẹ ohun ma, <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />Kọ unu ala okpo unu, tuhuan ọrẹ unu soo kẹ uKristi kẹ ọmẹ Ọnọm. <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />Inshin uKristi, anushin o so ọrẹ unu, nyin ẹkyuẹ ghan, ẹlẹn na unu nii ọhuọ nyin akyuẹ unu kẹ ẹnga kẹ ọmẹ ọdọọ. <verse eid="COL 3:4" /><verse number="5" style="v" sid="COL 3:5" />Ọklan wọ, unu laa udu ọnkyẹ ohun kan, kawan: ẹva, ajajẹ, ọrẹn ẹhurẹ kẹ ọntraan udu ẹva, tuhuan kẹ unii lẹ ẹhurẹ ọlọla, ọdọọ ọnọm ọsẹsọ. <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />Sablọ kẹn, amua Ọnọm nii ọba. <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />Unu akyuẹ unu la kẹ odu utee ọnkyẹ lẹn, kẹ ọmẹ ọywua ikyikyuo unu. <verse eid="COL 3:7" /><verse number="8" style="v" sid="COL 3:8" />Tushin kẹladẹn ọdọ wọ lẹ unu laa ididu ọmẹn ọnkyẹ lẹn kan, kawan: amua, ishim, ukon eple lẹ ẹhurẹ, ọbẹn ọntua wọ, kẹ utoo ọnkyẹ ajajẹ bi kẹ ọmẹ onyun unu. <verse eid="COL 3:8" /><verse number="9" style="v" sid="COL 3:9" />Kalẹ unu waa eple ọntẹ wan, sablọ shin unu laa ọnkyẹ ọma ikyikyuo wọ kẹ ididu ẹntraan utri wan,<verse eid="COL 3:9" /></para>
  <para style="pi">
    <verse number="10" style="v" sid="COL 3:10" />tuhuan ka unu akpọn ọywua ọprọpra, kẹ unu kye ana aprapra kẹ ọmẹ ọza ọnwọ iriri anushin òó du wọ. <verse eid="COL 3:10" /><verse number="11" style="v" sid="COL 3:11" />Kẹ ọmẹ ọywua ọprọpra lẹn, bọ ẹtrẹtọ kẹ ọmẹ aYahudawa kẹ anushin osoo wan aYahudawa wan, anushin a taa wan untun huọ anushin oso ọnya ọtaa wan untun ma, o soon huọ arẹn ẹbọn, huọ ana ọmọmbọn, agrẹn huọ anushin a laa, tushin uKristi nga oso ididu, tuhuan kẹ ọmẹ ididu. <verse eid="COL 3:11" /><verse number="12" style="v" sid="COL 3:12" />Ọklan wọ, unu anushin Ọnọm we, ana ẹsẹẹ kẹ anushin ẹnga byan, unu so ana ọka kọọn emremri eple, udu ọnkyẹ agyagyuan, ukon ẹkyuẹ kẹ ẹbọn, kẹ ọywua lẹshin, unu ywua la nọọ kẹ eple. <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" />Unu kọn lẹ eple lẹ unu ywuro eple ilovro kẹ huo ulon uvro ghan. Unu ywuro ilovro kawan emle shin Ekye abaan huọ uywuro unu. <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />Tuhuan kẹ ididu ọmẹ ọnkyẹ lẹn, unu we ọbyan, shin ọfrẹ enyi kẹ ukyun kẹ ọnhuọ uzun. <verse eid="COL 3:14" /><verse number="15" style="v" sid="COL 3:15" />Ọna ẹhurẹ uKristi du ẹgọn kẹ ọmẹ ẹhurẹ unu, kẹ ọsablọ ọna ẹhurẹ lan wọ Ọnọm dra unu kẹ ọmẹ ẹgbẹna izun, tuhuan unu ywua lẹ unu trọ ẹjaa. <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" />Unu laa aprẹ uKristi ka ywua kẹ ọmẹ unu kawan emle shin unu ololo eple wọ, lẹ unu kyẹẹ eple lẹ ọza ikon, lẹ unu taa antẹn an yẹ ọza antẹn, antẹn ọnọọn kẹ antẹn iri, lẹ unu dọọ Ọnọm. lẹ Unu sọ Ọnọm ẹjaa kẹ ọmẹ ẹhurẹ unu. <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />Tuhuan huọ unsewan shin unu odu, huọ ọpya onyun huọ kẹ udu ọnkyẹ unu, unu du kẹ ididu kẹ ọmẹ ọntua Ekye abaan enyi ọYẹsọ, lẹ unu sọ Ọnọm ẹjaa kẹ ọmẹ nga.<verse eid="COL 3:17" /></para>
  <para style="s">Ẹntraan ọywua Abaan ana ure Ọnọm kan</para>
  <para style="pi">
    <verse number="18" style="v" sid="COL 3:18" />Unu ashẹ, unu ma akyuẹ unu kan lẹ ekyi unu, emle shin ọgbaa wọ kẹ ọmẹ Ekye abaan. <verse eid="COL 3:18" /><verse number="19" style="v" sid="COL 3:19" />Unu ekyi , unu byan ashẹ unu tuhuan kalẹ unu nya amua kẹ ẹma ma. <verse eid="COL 3:19" /><verse number="20" style="v" sid="COL 3:20" />Arẹn, unu re ọnkyẹ utoo anushin obyọn unu kan kẹ ọhuọ unsewan, kẹ ọnwẹn ka sọ Ọnọm ọkọọn ushii. <verse eid="COL 3:20" /><verse number="21" style="v" sid="COL 3:21" />Ekye, Kalẹ unu bẹn arẹn unu ẹhurẹ wọ wan, kẹ sablọ shin kalẹ ẹhurẹ wan kyẹẹ yọ wan. <verse eid="COL 3:21" /><verse number="22" style="v" sid="COL 3:22" />Agrẹn, unu re ọnkyẹ uto ekye abaan unu kan kẹ ọmẹ uhuo unsewan; tuhuan unu du kẹn bọ sẹ edre wan soo kẹ aprẹn ma huọ inshin unu abyan ukon ọbyan ma ma, tushin lẹ ẹhurẹ izun kẹ ọdọọ kan lẹ Ekye abaan. <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />Huọ unsewan shin unu odu, unu du wọ lẹ ididu ẹhurẹ unu, kawan ọtuan Ekye abaan bọ ọnwọ enyetri wan, <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />sablọ unu za shin unu nii ọngrẹn ọka bikẹ onhuọ Ekye abaan kawan ọka ọtuan. Ekye Abaan uKristi ghan unu kon udu ghan ẹgrẹn. <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" />Anushin òó vro nii ukon ọka uvro ghan, tuhuan Ọnọm kẹ e nyin nga ẹtrẹtọ wan.<verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1" />Unu ekye àbaan, unu ma agrẹn ọnkyẹ shin ọgbaa tuhuan kẹ unu kon aklọ lẹ ẹma lẹ inshin, sablọ unu za shin unu huo u so lẹ ekye abaan kẹ aprẹn.<verse eid="COL 4:1" /></para>
  <para style="s">Ọma Iywuro Kan Lẹ Ekye</para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />Unu ma akyuẹ unu lẹ ọpẹlọnọm, lẹ unu ywua lẹ unu zọ lẹ unu sọ Ọnọm ẹjaa. <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />Tuhuan unu huọ ọpẹlọnọm sablọ enyi, sablọ shin Ọnọm ma enyi epin uto uye uKristi, ọnwọ shin ọsọ Imi ywua kẹ iwe ayẹra. <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />Unu pẹlọnọm kẹ ama mi ọdọ uto kọ lakpẹkprẹ, emle shin ọgbaa wọ. <verse eid="COL 4:4" /><verse number="5" style="v" sid="COL 4:5" />Unu ywua lẹ ọntran kẹ anushin akpọn ma ọYẹsọ lẹ ẹhurẹ wan; unu du ọtuan lẹ huo ilon ẹlẹn ya wọ shin unu okon. <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />Unu laa ọpya onyun unu kẹ ọkuang lẹ esheshì huo ilon ẹlẹn ya wọ, ẹtọprẹ unu kuang lẹ ọhwẹi kẹ ushi ọkọọn, sablọ unu kpẹ emle shin unu nii ukye huo ẹnga wọ.<verse eid="COL 4:6" /></para>
  <para style="s">Ọ sọ Andakyẹ Ọplẹ</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />uTikikus nii uto unu iywuu mi ledidu. Enga ewedri shin enyi abyan nga, ana udu ọtuan Ọnọm lẹ ẹhurẹ izun tuhuan agrẹn Ọnọm kẹ ọmẹ Ekye abaan Ọnọm, nii utoo unu ididu ihyuu ọywua mi. <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />Imi kyẹ ọtuan ngan balẹ ọnhuọ ọywua unu sablọ kẹn tuhuan kẹ unu kpẹ ọnkyẹ shin enyi so kẹ ọmẹ nga tuhuan kẹ a ma unu ẹhurẹ ẹdọ. <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" />Enii ọba kẹ Ọnisimus, ewedri ẹplẹpan enyi shin enyi abyan, anushin ana ozun nga kẹ ọmẹ unu. Ẹma nii uto unu ididu ọnkyẹ shin ukon ọba enyi kẹ ọnhuẹn <verse eid="COL 4:9" /><verse number="10" style="v" sid="COL 4:10" />Aristarkus, anushin o soo kẹ unkoo ẹva kẹ Imi, ma unu ọshaa, emle lan nga ọMarkus anushin akpẹ wan ozun nga kẹ ọBarnabas huọ ma unu ọshaa wọ. (Unu a huọ ọkọọn aprẹ ghan; inshin àá ba, lẹ unu ngrẹn ghan lẹ anyẹ apua) <verse eid="COL 4:10" /><verse number="11" style="v" sid="COL 4:11" />ọYẹsọ, anushin a drọ ghan shin uYustus, huọ ma unu ọshaa wọ. Ekyi ataa lẹn ma oso aYahudawa kẹ ozun kẹ ọmẹ anushin okon udu ọtuan ọnwọ ẹgọn Ọnọm kẹ imi, tuhuan a huọ ma mi ọdọ ẹhurẹ lakẹnkan. <verse eid="COL 4:11" /><verse number="12" style="v" sid="COL 4:12" />Abafaras, anushin ana ozun nga kẹ ọmẹ unu, tuhuan agrẹn uKristi ọYẹsọ ghan, okon ọma unu ọshaa wọ. Àá ka pẹlọnọm huo ilon ẹlẹn ya wọ sablọ unu, shin unu tigha lakpẹkpua kẹ ọmẹ ididu unii ọnwọ Ọnọm, tuhuan lẹ plẹpan bọ ọdan. <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />Imi a la ẹka mi kyẹ uto unu shin Abafaras kon udu ọtuan lakẹnkan sablọ unu, tuhuan sablọ anushin o soo kẹ ọLawudikiya kẹ uHirafolis. <verse eid="COL 4:13" /><verse number="14" style="v" sid="COL 4:14" />Onuse ọbyan enyi uLuka, avua ẹkaan, kẹ uDemas kon ma unu ọshaa. <verse eid="COL 4:14" /><verse number="15" style="v" sid="COL 4:15" />Unu ma ididu ewedri shin o soo kẹ ọLawudikiya kẹ uNimfa tuhuan kẹ ana ure Ọnọm kan kẹ ọmẹ abaan nga ọshaa wọ.”<verse eid="COL 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 4:16" />Ẹlẹn shin unu a frẹ ọpua ọzaa ẹnrẹn lẹn, ọdọ wọ lẹ unu kpọn wọ kan lẹ ọnhuọ ana ure Ọnọm kan kẹ ọLawudikiya kẹ unu sa pua wọ kẹ ẹma kọn, tuhuan inshin unu a hurẹ, ọdọ lẹ unu huọ pua ẹnrẹn shin Imi a rẹn ana ọLawudikiya kẹ unu huọ ọkọ̀n.<verse eid="COL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="COL 4:17" />Unu too Arkibus shin: “Sọ ẹhurẹ kẹ ẹngọ plẹ ọtuan shin Ekye abaan Ọnọm ma ngọ.” <verse eid="COL 4:17" /><verse number="18" style="v" sid="COL 4:18" />Imi, uBulus nga arẹn ẹnrẹn ọma ọshaa lẹn lẹ anyẹn mi. Kalẹ unu jire wọ shin Imi soo kẹ ọmẹ iwe ayẹra wan. Esheshi Ọnọm ywuà kẹ unu, Amin.<verse eid="COL 4:18" /></para>
  <chapter eid="COL 4" />
</usx>