<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- Eda</book>
  <para style="toc2">A. M.</para>
  <para style="toc1">Ayyukan Manzanni</para>
  <para style="mt1">Ayyukan Manzanni</para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="s1">A kpọn ọYẹsọ kan lẹ ọmẹn Aprẹmẹn</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />uTiyofilus ana alalẹ, imi a rẹn ididu ọnkyẹ shin ọYẹsọ udu kẹ ọtẹkpa ulolo ghan bi kẹ ọtẹkpa ọtuhuan nga <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />kan lẹ aywuẹ shin á sa ghan kan lẹ Aprẹnmẹn, a ta huọ hurẹ utoo Apaduan nga ọnkyẹ lẹ ọdọ Iri Ẹsẹẹ. <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />Lẹ shi ọYẹsọ ọnyẹnyan bi kẹ ọmẹ itun, e nyin ẹkyuẹ ghan kẹ atrẹ kẹ ọnhuọ apaduan nga kẹ iblibun kya unyin ma shin ẹnga hyu atrẹ.òó kon àywẹẹ ẹhurẹ nang kẹ ọnhuọ utoo wan aprẹ ẹgọn Ọnọm. <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" />Ẹlen shin òó hyu kẹ ọnhuọ ya ọnkyẹ ọya kẹ apadun nga kẹ ọnhuọ ẹpan lan, ọYẹsọ la ma wan iywuro shin: “kalẹ unu tro kẹ Urushalima ma, tuhuan unu zọ agyuwan Iri Ẹsẹẹ shin ekye mi ọkpaa unu onyun nga. <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />ọYohanna du ọbaftisma lẹ ambrẹ, tushin aywuẹ la hyuẹ, enii udu unu ọbaftisma lẹ Iri Ọnọm.”<verse eid="ACT 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />Ẹlẹn shin apaduan lan klan kẹ ọYẹsọ, e le luwe ghan shin, “Ekye abaan, ẹladẹn ya ẹngọ ni uywure lẹ ẹgọn kan lẹ Israˈila kọ?” <verse eid="ACT 1:6" /><verse number="7" style="v" sid="ACT 1:7" />ọYẹsọ le kyee wan shin, “Bọ ambrẹ unu kẹ ọza ẹlẹn huọ aywuẹ lan shin Ekyee Abaan du kẹ eteghe lẹ ọdọ ghan. <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />Tushin unu ni ukon ọdọ ẹlẹn shin Iri Ọnọm nii usri kẹ aprẹn unu, unu nii ukye ẹrẹn edre mi kẹ Urushalima kẹ ẹbọn ọYahudiya, kẹ ọSamariya kan lẹ igbo ohun.”<verse eid="ACT 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 1:9" />Lẹ ọYẹsọ hurẹ utoo kẹn, a la kpọn ghan kan lẹ aprẹmẹn kẹ aprẹn edre wa tuhuan enkuen la fra ghan kan.<verse eid="ACT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10" />Lẹ ushin o tuo edre wan kẹ aprẹn, ẹnga tọ frẹ uson kan lẹ aprẹmẹn, kẹ ẹlẹn izun ana ampua la otro ka tigha kẹ ayẹ wan kẹ ọmẹ ọnkyẹ ukyukyi. <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />Ọnwọ a la kọ wan lẹ ẹma shin, “unu ana ọGalili, unse wan ọsọ unu a tigha lẹ unu ushìn aprẹmẹn kẹn? ọYẹsọ lan shin Ọnọm kpọn ghan kẹ ọnhuọ ọywua unu kan lẹ aprẹnmẹn, nii uywure wan emle shin unu e shìn ọkpọn ghan kan lẹ aprẹnmẹn kọ.”<verse eid="ACT 1:11" /></para>
  <para style="s">EWE ọMATIYAS KẸ AKPỌN ỌTUAN ỌNWỌ ọYAHUDA</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />Kẹladran, apaduan lan le sri kẹ aprẹn ọnkọn shin adrọ shin uZaitun ke ywure wan Urushalima, ọnọn nọn lẹn fuan ẹkafran atẹlẹ ọkọ lẹ ozun. <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />Ẹlẹn shin a nyran ẹshan lang, olo kpon kan wan lẹ ọmẹ unkoo aprẹn kẹ ọnhuọ shin a ywua wọ. Ana shin oso, ma oso uBitrus, kẹ ọYohanna, kẹ ọYakubu kẹ Andrawas. uFilibus, kẹ uToma, kẹ ọBartalomi kẹ ọMatiyu. ọYakubu arẹn ọHalfa kẹ uSiman ana ọkọọn lẹ ofuu kẹ ọYahuza arẹn ọYakubu. <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />Ididu wan la ka pẹlọnọm huọ ulon ubon nga kẹ ashẹ kẹ ọMariya eyaa ọYẹsọ kẹ éwedri ghan. <verse eid="ACT 1:14" /><verse number="15" style="v" sid="ACT 1:15" />Kẹ aywuẹ lan, uBitrus la tigha kẹ ọmẹ ada ana ubi, a fuan ana atẹlẹ lẹ ẹhuẹ pua, ka kọ ghan lẹ ẹma shin, <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />Éwedri mi, ọka ba agyagyuan shin aprẹẹ Ọnọm shin iri Ọnọm too kẹ ukpo onyunn ọDawuda kyikyuo kẹ aprẹ ọYahuza, anushin èé nyin ana ọfrẹ ọYẹsọ ọntraan <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />ọYahuza ewedri enyi nga, e le we ghan kẹ odu ọtuan kẹ enyi. <verse eid="ACT 1:17" /><verse number="18" style="v" sid="ACT 1:18" />Èé kye ikli shin òó huro ọYẹsọ wọ kẹ alọ ọnhuọ wọ bi kẹ ọtuan ububi shin òó du, ọnhuọ shin àá kpaa ọfọn nga la zọn wọ, annaa nga lẹ oroo yọ etin tuhuan a lẹ kpo ghan. <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />Ididu ada ana Urushalima za aprẹ lẹn ọnwọ ọsọ adrọ ufili lan shin akaldama lẹ Ẹda wan wọ uso ọnhuọ eji.<verse eid="ACT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20" />uBitrus lẹ afrẹ utoo shin kẹ a rẹn kẹ ọmẹ ọzaa ẹgọn ọzabura shin, “ ‘ọnhuọ ghan ba ahuọ, kalẹ alọ ywua kẹ ọmẹn nẹ ma. Eywure kẹ a rẹn shin, alọ kpọn ọtuan nga.’ <verse eid="ACT 1:20" /><verse number="21" style="v" sid="ACT 1:21" />Ọnwọ ọsọ ọgbaa e we alọ kẹ ọmẹ enyi, anushin òó soo kẹ enyi kyuo ẹlẹn shin ọYẹsọ soo kẹ enyi wọ. <verse eid="ACT 1:21" /><verse number="22" style="v" sid="ACT 1:22" />Anushin énii uwe lan so anushin òó soo kẹ enyi ọnya kẹ ọbaftisma shin ọYohanna du kan lẹ ẹlẹn shin ákpọn ọYẹsọ kẹ ọnhuọ enyi kan lẹ aprẹmẹn. Ọdọ wọ anaa soo anushin òó too ihyuu ishishii ẹn kẹ ọnyẹnyaan ọYẹsọ bi kẹ ọmẹn itun kẹ enyi.”<verse eid="ACT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />Ọnwọ a la ma ọntua anampua, uYusufu ana shin adrọ ghan shin ọBarsabas huọ uJustus kẹ ọMatiyas. <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />A la ọpẹlọnọm shin, “Ekye abaan, ngo za ẹhurẹ ọhwẹ ẹnga, nyin enyi anushin ẹngọ ewe kẹ ọmẹn ana ampuwa lẹn <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />kẹ o so ana ọtuan ngọ kẹ a kpọn ọtuan shin ọYahuza laa.” <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />Ọnwọ ọsọ ala taa ẹrẹnsan kẹ aprẹn ma, ọMatiyas nga ala ya, a la sọ ghan kẹ ọmẹn apaduan akọ lẹ ozun lan.<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s">ỌBA IRI ẸSẸẸ kẹ ọFentikos</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />Aywuẹ shin ubon ọpentekos ba wọ, ididu ana ubi klan kẹ ọnhuọ uzun. <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />Ba ọza wan ala kọn iple ishim bi kẹ aprẹn kawan uton urun ububi tuhuan kẹ akuang ọmẹn ukoo ọywua wang. <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />Ọnwọ e le shìn uple ọnlighẹ kawan inon ọla sri kẹ aprẹn ma. <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />Ala kuang Ididu wan la lẹ Iri ẹsẹẹ tuhuan ọhuọ ẹ nga la frẹ ọpya onyun lẹ ẹda kẹ tẹrẹtọ emle shin Iri ẹsẹẹ lan ma wan ọdọu. <verse eid="ACT 2:4" /><verse number="5" style="v" sid="ACT 2:5" />Kẹ lẹn na, aYahudawa ana ọkọọn ibun Ọnọm bikẹ huọ ilon ẹbọn Ohun ywua kẹ Urushalima. <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />Lẹ shin a kọọn ishim lẹn, idri ada la klan kẹ ọnhuọ uzun lẹ ushin e shìn ọvrọ sablọ ọhuọ ẹnga nga kẹ ọmẹn ma kọọ apaduan lan kon ọpya onyun lẹ ẹda ghan. <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />Lẹ ọvrọ, e le lue shin: “Imi shin kẹ yẹẹ, ididu ana ọpya onyun lẹn, kyẹ aGaliliyawa wan ma? <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />Unse wan ọsọ huọ ẹnga nga kẹ ọmẹn enyi kọọn ẹma okon ọpya onyun lẹ ẹda ghan? <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />Tushin enyi ana ọFartiya kẹ eMidiyawa, kẹ Elamiya ana uMesofotamiya, kẹ ọYahudiya kẹ ọKafadokiya, kẹ ọFantus kẹ Eshiya, <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />kẹ uFirijiya, kẹ ọFamfiliya, kẹ ọMasar kẹ ashan ayẹ ọSayirin ẹn kẹ ẹbọn uLibiya kẹ osoon bi kẹ uRoma <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />Ididu aYahudawa kẹ anushin ekyee aLarabawa kẹ ada ama ana aKiritawa wan kẹ aLarabawa tushin enyi koon oko utoo aprẹẹ ọnkyẹ ọndọrọndọ shin Ọnọm du lẹ ẹda nyin”. <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />Ididu wan shin ọvrọ ka ba le trekpe ka frẹ uluwe eple shin, “unsewan ọnkyẹ lẹ nyin?” <verse eid="ACT 2:12" /><verse number="13" style="v" sid="ACT 2:13" />Tushin alọ wan la kpaa lẹ krọ lẹ a kọ wan shin, “Ákan ma a hyua tuhuan o kon ọpyan ma.”<verse eid="ACT 2:13" /></para>
  <para style="s">UTOO UBITRUS KẸ AYWUẸ ỌPENTEKOS</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />Lẹ iwe ikon, uBitrus la nyẹnyan ka tigha kẹ ẹmpakye ana ọkọ lẹ izun lan ka kọ ghan lẹ idri aYahudawa kẹ ana utoo aYahudawa.ada shin, “Unu ewdrim aYahudawa kẹ ana ọywua kẹ Urushalima unu ngẹn atọn lẹ imi, kẹ imi toon ọnkyẹ shin ọnwẹn nyin.” <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />Ekyiwan lẹn hwa wan akan ma ba ẹpyan lọ wan emle shin unu toow wa, sablọ shin ẹlẹn nyin itunaan ẹnkọ uturombun le hwule. <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />Tushin ọnwẹn nyin ọnkyẹ shin onu uYowel too shin, <verse eid="ACT 2:16" /><verse number="17" style="v" sid="ACT 2:17" />“ ‘Ọnọm too shin, Aywuẹ ọplẹ ohun, imi nii ọma ididu enyetri Iri Ọnọm. Arẹn unu arashẹ kẹ arekyii nii utoo ọnkyẹ unii ọba. Arọfuọ unu nii ushìn unyin ọnwọ Ọnọm kẹ ọmẹ ala tuhuan arakpẹ unu nii ọlẹlẹ àla. <verse eid="ACT 2:17" /><verse number="18" style="v" sid="ACT 2:18" />Kẹ aywuẹ lan, imi nii usri lẹ Iri Ọnọm kẹ aprẹn agrẹn mi ashẹ kẹ ekyii tuhuan ẹma nii utoo ọnkyẹ shin unii ọba. <verse eid="ACT 2:18" /><verse number="19" style="v" sid="ACT 2:19" />Imi nii unyin ọnkyẹ ọvrọ kẹ aprẹn kẹ ankpẹ kẹ ilu ohun kẹ ada ni ushin eji, ọla kẹ unsoo utrutri; <verse eid="ACT 2:19" /><verse number="20" style="v" sid="ACT 2:20" />Imi nii ọsọ aywuẹ kye itum tuhuan ọprẹn nii ukye kẹ ososon kawan eji tuhuan idre Ọnọm ẹlẹlẹ kẹ ẹn kẹ ọ sa Ekye abaan ta aba. <verse eid="ACT 2:20" /><verse number="21" style="v" sid="ACT 2:21" />Tuhuan aywuẹ lan ididu ana shin àá dra ọntua Ekye abaan nii ufwom.’ ” <verse eid="ACT 2:21" /><verse number="22" style="v" sid="ACT 2:22" />“Unu ewedri mi, ana Israˈila, unu kọn aprẹẹ lẹ, ọnkyẹ ọvrọ, ankpẹ shin ọYẹsọ ana ọNazaret kon udu kẹ ọ ma shin Ọnọm kon udu kẹ ọmẹ nga nyin shin enyi nga shin Ọnọm byan tuhuan o soo kẹ nga. Unu za kẹn sablọ ọnkyẹ lẹ ba kẹ aprẹn edre unu. <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />ọYẹsọ lẹn, Ọnọm tuhuan nga ba lẹ ohun lẹ ọbyan kẹ ọza ghan, unu la sẹsra ghan tuhuan ka prẹ ghan kẹ anyẹ ana ebebi. <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />Tushin Ọnọm nyuọn nga, ka plan nga kẹ ukpo sablọ shin ukpo sa wọ lẹ umle ọfrẹ ghan ma.” <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />Kẹkyikyuo ọDawuda too kẹ aprẹn nga shin, “ ‘imi e shin Ekye abaan kẹ ayẹ mi, o so kẹ ẹya mi kẹ imi huọ ẹlẹlẹn nga ya wọ sablọ shin kalẹ ọnlighẹ ba mi ma. <verse eid="ACT 2:25" /><verse number="26" style="v" sid="ACT 2:26" />Ọnwọ ọsọ imi amọ lakẹnkan, tuhuan imi nii ọdọọ ghan kẹ imi sọ ẹhurẹ mi lẹ huọ ẹlẹlẹn nga ya wọ, mi za shin imi enyetri ghan tushin imi nii ọsọ ẹhurẹ lẹ nga. <verse eid="ACT 2:26" /><verse number="27" style="v" sid="ACT 2:27" />Sablọ ngọ nii ngọ ọta mi kan lẹ ọmẹ ọla wan bọ ngọ nii ọlaa ana ọdẹdẹy ngọ kẹ a shaa ghan kẹ ọmẹ itun ma. <verse eid="ACT 2:27" /><verse number="28" style="v" sid="ACT 2:28" />Ẹngọ enyi mi ọntraan ọrẹ tuhuan ọywua ngọ kẹ imi kuang mi lẹ ọmọ.’” <verse eid="ACT 2:28" /><verse number="29" style="v" sid="ACT 2:29" />“Unu ewdri mi, imi nii ọpẹẹ lẹ unu lẹ ọdọ ẹhurẹ kẹ aprẹẹ akpẹẹ nyin ọDawuda, ana shin òó kpo ghan a la lọọ ghan tushin itun ghan soo kẹ enyi ba lẹ ubiin. <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />ọDawuda lẹ osoo onu tuhuan ka za shin Ọnọm kpaa ghan onyun shin Ẹnga Ọnọm nii u we alọ kẹ ọmẹ ọnyẹ ọDawuda kẹ atrẹtra ka prẹn intru ẹgọn nga kawan ẹnga ọDawuda. <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />ọDawuda shin ọnkyẹ shin Ọnọm nii udu kẹ ekye, a la frẹ utoo ada aprẹ ọnyuọn nga ọYẹsọ bikẹ ọmẹ itun shi, enii wan ọlaa gha kẹ ọmẹ itun ma, tuhuan ba ẹgbẹna nga nii ya ọ shaya wan. <verse eid="ACT 2:31" /><verse number="32" style="v" sid="ACT 2:32" />Ọnọm ọnyuọn ọYẹsọ bikẹ ọmẹ itun enyi ta ọhuọ shin lẹ edre enyin. <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />Ọnọm dọọ ghan kẹ ọnyẹ ẹya ghan tuhuan kẹ ama ghan iri Ẹsẹẹ ghan emle nga àá huọ ma enyi wọ Iri Ẹsẹẹ lan kẹ ililu ọnwọ ọsọ unu shiin ọnkyẹ shin unu shin kẹ akọọn ọnkyẹ shin unu kọn.” <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />Unu za shin ọDawuda kan lẹ aprẹn ma, tushin a nga pẹẹ shin,</para>
  <para style="q1" vid="ACT 2:34">“‘Ọnọm too Ekye Abaan mi shin:</para>
  <para style="q2" vid="ACT 2:34">“trẹtraa kẹ ẹglẹgọn kẹ ọnyẹ ẹya mi,<verse eid="ACT 2:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ACT 2:35" />Sẹ imi a sọ ẹngọ kyan owo ngọ kẹ ngọ</para>
  <para style="q2" vid="ACT 2:35">tigha kẹ aprẹn ma.” ’<verse eid="ACT 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36" />“Sẹ ididu ada ana Israila za shin ọYẹsọ lẹ anushin unu a sẹsra a nga oso Ekye abaan Ọnọm kẹ uKristi.” <verse eid="ACT 2:36" /><verse number="37" style="v" sid="ACT 2:37" />Lẹ shin a kọn kẹn, ọla pya wan kẹ ẹhurẹ wan tuhuan a la kọ wan lẹ uBitrus kẹ amaa apaduan, “Ewedri mi, Unse wan enyi nii udu kẹladẹn?” <verse eid="ACT 2:37" /><verse number="38" style="v" sid="ACT 2:38" />uBitrus la kọ ghan lẹ ma shin, “Unu kpaa ilovro tuhuan kẹ udu unu ọbaftisma kẹ ọmẹ ọntua ọYẹsọ uKristi, sablọ ohuro unu ilovro unu; tuhuan unu ngrẹ agyuan iri ọdẹdẹy ẹnyẹ Ọnọm. <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />Sablọ ọkpaa onyun lan unu ma odu unu kẹ arẹn unu, kẹ ana usoo kẹ ananọ, ididu ana shin Ekye Ọnọm dra wan” <verse eid="ACT 2:39" /><verse number="40" style="v" sid="ACT 2:40" />uBitrus lẹ otoowan ọmprẹẹ lẹ ampam lẹ owoo wan atọn shin; “Unu fwo akyuẹ unu lẹ ọnyẹẹ ububi.” <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />Ada lapam ngrẹ aprẹẹ uBitrus tuhuan ala odu wan ọbaftisma. Ubon lan, ana ure Ọnọm kan lẹ akẹnmi lẹ ẹrẹn ada atẹlẹ ọkọ ẹtaa.<verse eid="ACT 2:41" /></para>
  <para style="s1">ỌYWUA ANA URE ỌNỌM KAN</para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 2:42" />A la ma akyuẹ lẹ ulolo arẹn ọtuhuan lan, lẹ aywua kẹ enshin lẹ aya lẹ apẹlọnọm kẹ eple.<verse eid="ACT 2:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43" />Eji lẹ akpaa ada la kẹnkan tuhuan e le eshin ọnkyẹ ọvrọ shin Ọnọm kon udu lẹ arẹn apaduan <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />Ididu anushin angrẹn Ọnọm lẹ ẹhurẹ la frẹ ọywua lẹ enshin lẹ ablẹ Ọnọm lẹ a kam ọnkyẹ wan kẹ eple. <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />Tuhuan a lẹ afrẹ uhuro ididu ọnkyẹ shin osoo lẹ ọma kẹ kam eple ikli lẹ kẹ ọbyan ẹhurẹ ọhuọ ẹnga. <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />Huọ ulon ubon nga a ka klan kẹ ọmẹn Abaan Ọnọm lẹ ẹhurẹ izun, lẹ aya ọnkyẹ ọya kẹ ọmẹ abaan ma kẹ eple, lẹ amọ kẹ eple lẹ ọbyan ẹhurẹ wan. <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />Lẹ ablẹ Ọnọm, o soo lẹ eji asẹẹ kẹ ọnhuọ ada. Huọ ulon ubon nga ukre wan ka kẹnmẹ lẹ ada ana shin Ọnọm fwo wan.<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s">uBitrus Nyuọn Ogun ana Ọwẹn kẹ Atigha Unkoo Ọpẹlọnọm</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />Uple ubun, uBitrus kẹ ọYohanna la kya kan lẹ abaan Ọnọm kẹ ẹlẹn ọyẹra ẹtaa ẹn kẹ aywuẹ kẹ ọpẹlọnọm. <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />E le o kon ogun nga a trẹtraa kẹ onyun abaan Ọnọm lan anushin ogun nga kyuwo kẹ aywẹ ubyon nga. Huo ulon ubon nga wọ a ka kpọn ghan kan lẹ onyun atigha abaan Ọnọm lan kẹ afrẹ ọwẹn ana ọkan lẹ ọmẹ abaan Ọnọm lan ikli. <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />Ẹlẹn shin uBitrus wan kẹ ọYohanna kya ọnyẹran abaan Ọnọm kan wan lẹ ọmẹn nẹ wọ, a la wan ma ikli. <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />É le we ghan lẹ edre tuhuan kẹ otoo ghan shin, “Shìn enyi.” <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />Ala sa edre ke shin wan lẹ ọsọ ẹhurẹ shin ẹngan ni ukon ọnlẹghẹ kẹ ọnhwọ ywua wa. <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />Tushin uBitrus la kọn lẹ nga shin, “Imi so mi lẹ ikli wan tushin ọnkyẹ shin mi soo lẹ ọma mi ni ọmang: kẹ ọmẹ ọntuwan ọYẹsọ uKristi ọBanazaret, nyẹnyan kẹ ngon son!” <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />uBitrus la frẹ gha lẹ ọnyẹ ẹya kẹ anyọn ngan. Kẹ la dran, afran nga kẹ ọntọn nga lẹ aba adọ. <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />Ala nyẹnyan kẹ ẹlẹn izun kẹ atgha tuhuan ka frẹ usoonson. Tuhuan a la e re wan kan lẹ ọmẹ abaan Ọnọm lẹ efli tuhuan lẹ ablẹ Ọnọm. <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />Ididu ada le eshin ghan o kon usoon lẹ ablẹ Ọnọm. <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />Tuhuan ididu ana ọywua kẹ ọnhuọ lan kpẹẹ shin ogun shin àá ka wẹn kẹ atigha agyagyuan abaan Ọnọm lan ngẹn, e le shìn ọvrọ lẹ ọnkyẹ shin ọba ghan.<verse eid="ACT 3:10" /></para>
  <para style="s">uBitrus pẹẹ lẹ anushin okon ushǹ ghan.</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />Lẹ shin ada shìn emle shin enkyii lan frẹ uBitrus wan kẹ ọYohanna wọ, e le shin ọvrọ tuhuan ka nyan kan lẹ utiton kan lẹ ọnhuọ wan kẹ ọnhuọ ozoo uSolomon. <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />Lẹ uBitrus shìn klan, ala pẹẹ lẹ ẹma shin, “unu ana Israila, unse wan ọsọ unu kon ushìn enyi kẹn kawa lẹ ọdọ enyi wọ enyi asọ enkyii lẹ uson? <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />Ọnọm akpẹ enyi Ambram kẹ Ishaku kẹ ọYakubu nga a sa agrẹn nga ọYẹsọ. A nga unu ohuro sablọ a prẹ ghan tuhuan kẹ a taa unu ẹnga kẹ ẹmpakye uBilatus kẹ ọshin uBilatus nii ọlaa ghan. <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" />Unu atraa unu anushin o soo ghan lẹ iluwe wan kẹ enyi esheshiin, tuhuan kẹ a wan uBilatus kẹ alaa ana ọpẹẹ ada. <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />Unu aprẹ anushin a nga oso ọntraan ọrẹ bọ igbo tushin Ọnọm nyuọn nga bi kẹ ọmẹ itun kẹ aprẹn edre enyi”. <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />Ọdọ ọntua ana shin unu aprẹ lan wọ ọma ogun lẹn ọtrẹ. Ọnkyẹ shin unu eshìn odu wan lẹ ọma ẹhwurẹ lẹ ọntua ọYẹsọ wọ ma enkyi lẹ uson emle shin unu eshìn wọ.<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />“Ẹladẹn, ewedrim, imi za shin unu kẹ akpẹ unu du ọYẹsọ ọnkyẹ lẹn lẹ itum wọ. <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />Tushin ọba klan sablọ ọnkyẹ shin Ọnọm lẹ otoo kẹ onyun onu nga ba kan shin, uKristi ni ọhyua ẹva. <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />Ọklan wọ unu kpaa onyun kẹ unu ywure unu ọnhuọ Ọnọm sablọ ohuro ilovro unu kẹ ama unu ẹhurẹ ẹprẹpra, <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />tuhuan e nii ọtuan unu lẹ uKristi shin èé we unu. <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />E ni ọywua ghan kẹ aprẹnmẹn sẹ ẹlen naa ba shin huo unse wan ukye kẹ ọmprọmpra emle shin Ọnọm lẹ otoo onu ọdẹdẹy wan wọ. <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />Kẹ uMusa too aprẹẹ ọYẹsọ shin, ‘Ekye Ọnọm nii ọtuan unu lẹ ónu kawa imi tushin enii utro bikẹ ọmẹ unu, unu nii udu huọ unse wan shin otoo unu shin unu du. <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />Anushin àá tran nga udu ọnkyẹ utoo onu lan, enii ọplan nga kẹ arẹn Ọnọm.’<verse eid="ACT 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 3:24" />“Imi kya utoo unu, ididu ónu shin otoo aprẹ Ọnọm kẹ ọtẹkpa lẹ ọSamaˈila kan lẹ anushin àá ba kẹ ititim nga, too ọnkyẹ shin u kon ọba kẹ ọmẹn aywuẹ lẹn. <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />Unu ma unso arẹn ọya ẹgọn ónu tuhuan unu soo lẹ ọka kẹ ọmẹn ọkpaa onyun shin Ọnọm du akpẹ unu emle shin òó too Ambram kọ, ‘Lẹ ọnyẹ̀ẹ̀n unu, imi ni ọsọ ana ohun lẹ edidu onyun esheshii’ <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />Ọnwọ ọsọ Ọnọm we agrẹn nga kẹ atuan nga ba lẹ ọnhuọ ọywua unu lẹ ọtẹkpa kya ọsọ unu onyun esheshii kẹ asọ unu laa ububiu.”<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s1">UBITRUS KẸ ọYOHANNA KẸ ẸMPAKYE ONOKON</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />Ana umee enshin kẹ ana ọzọ Abaan Ọnọm alalẹ kẹ aSadukiyawa ba lẹ ọnhuọ uBitrus kẹ ọYohanna atọ usoo kẹ ọnhuọ ọpẹẹ lẹ ada. <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />Amua la nyaan ma sablọ apaduan lan kon ulolo ada lẹ ọntua ọYẹsọ kẹ aprẹn ọnyẹnyaan anushin ekyure wan bikẹ ọmẹn itun. <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />Ala frẹ uBitrus wan kẹ ọYohanna, kẹ asọ wan kẹ unkoo sẹ ọnwa ubun sablọ anlẹ huọ ọba. <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />Tushin ana ọpam shin a kọọn ulolo lan kpọn lẹ ẹhurẹ, tuhuan ukree ada la kẹnmẹ kẹ enii ọfuan atẹlẹ ọkọ otong. <verse eid="ACT 4:4" /><verse number="5" style="v" sid="ACT 4:5" />Ọnwa ubun, ana ukon ekye kẹ onokon kẹ avua ọza iywuro la klan kẹ Urushalima. <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />kẹ Hanana agọn alalẹ kẹ ọKayafa kẹ ọYohanna kẹ Iskandari kẹ ididu ọnyẹ agọn alalẹ. <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />Ala okon uBulus wan kẹ ọYohanna ba lẹ ẹmpakyee wan tuhuan ka frẹ unun ma shin, “Ulon ọdọ huọ ọntua ghan wọ unu odu ọtuan?” <verse eid="ACT 4:7" /><verse number="8" style="v" sid="ACT 4:8" />Lẹ shin uBitrus kuang lẹ Iri Ẹsẹẹ a la kọ ghan lẹ ẹma shin: “Unu ana ukon ekye ada kẹ anokon! <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />Inshin unu kon ulue enyi kẹ aprẹn ọnkyẹ ọvrọ shin odu ogun lan kẹ emle shin òó kon ọtrẹu <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />Ididu unu kẹ ada ana Israila za shin, ogun lẹ shin akyẹn kẹ ẹmpakyen lẹ kon ọtrẹ lẹ ọntua ọYẹsọ uKristi, ọBanazaret ana shin unu asẹsra ka prẹn gha tushin Ọnọm nyọn nga bikẹ ọmẹ ìtun. <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />ọYẹsọ lẹn nga oso ana shin ọzaa ẹgọn Ọnọm too shin, ‘Ẹntrẹtra shin unu ana ọvran tran kọ shin i so kọ kẹ agyagyuan ma, kẹ ikyee shin ẹsrẹ lẹ ọtuan lẹ edidu.’ ọnhuọ ọywua ghan le hule wọ enyi nii ukon ufuwom kọ. <verse eid="ACT 4:11" /><verse number="12" style="v" sid="ACT 4:12" />Sablọ kẹ ididu ohun nẹ, uple ọntua soo wan shin unii ọma enyi ufuwom kawa ọntua ọYẹsọ wan.” <verse eid="ACT 4:12" /><verse number="13" style="v" sid="ACT 4:13" />Lẹ ushin eshin ẹhurẹ ẹdọ uBitrus kẹ ọYohanna tuhuan ka kpẹẹ shin ẹma kan wan lẹ ọnhuọ ọpua ẹnrẹn ma tuhuan anaa emmrin ma, ọvrọ la frẹ wan tuhuan ala kpẹẹ shin ekyii lẹn soo kẹ ọYẹsọ. <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />Tuan a la kpẹ wan ọnkyẹ udu wan sablọ shin ogun lan kyẹẹn kẹ ẹma. <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />A la otoo apaduan lan shin otro kẹ ọmẹ ozoo ẹgọn uJudiya lan ẹmbakyẹ shin ẹma pya onyun kẹ eple wan. <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />E le luwe eple shin, “Unse wan enyi nii udu lẹ ekyiwan lẹ? Sablọ shin ọhuọ ẹnga nga kẹ Urushalima hurẹ ọkọọn ọnkyẹ ọvrọ shin odu tuhuan enyi soo wan lẹ ọtaan ma <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />Ala kpọn udu shin, enyi ma owoo wan atọn shin kalẹ a tọ pẹẹ lẹ alọ kẹ ọmẹ ọntua ọYẹsọ wan.” <verse eid="ACT 4:17" /><verse number="18" style="v" sid="ACT 4:18" />Onwọ e le eywure ka dra wan ba lẹ ọmẹ ozoo lan ka ala wan ẹrẹnyẹ shin, kalẹ atọ pẹẹ huọ ulolo alọ lẹ ọntua ọYẹsọ wan. <verse eid="ACT 4:18" /><verse number="19" style="v" sid="ACT 4:19" />Tushin uBitrus kẹ Yana la ekye wan shin, “Unu too enyi lẹ akyuẹ unu, Enga nga ọgbaa enyi du ọnkyẹ utoo ghan, unu, huọ tọ Ọnọm <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />Sablọ enyi sawan lẹ utrim utoo ọnkyẹ lẹn shin enyi eshin tuhuan kẹ akọn ma.” <verse eid="ACT 4:20" /><verse number="21" style="v" sid="ACT 4:21" />E le ywure kẹ owoo wan atọn la kẹnkan tuhuan kẹ alaa wan sablọ akpẹ wan emle shin ema nii ọma wan ẹva wọ wan sablọ shin ada lẹ apam kọọn ushi tuhuan okon ọdọọ Ọnọm lẹ ọnkyẹ shin ọba lan. <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />Ogun shin ama ghan ọtrẹ lan huọ srẹ amẹ ẹhuẹnang.<verse eid="ACT 4:22" /></para>
  <para style="s">Ọpẹlọnọm ana ubii</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />Lẹ shin a laa wan, uBulus kẹ ọYohanna la eywure wan ọnhuọ enyi ma kẹ otoo wan ọnkyẹ shin akpẹẹ umee enshin kẹ ana onokon too wan. <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />Lẹ shin ididu ana ure Ọnọm kan lẹ okyun akyuẹ kẹ ọnhuọ uzun kẹ apẹlọnọm lẹ ọdọ, shin, “Ekye Abaan,” ẹngọ anushin òó du Aprẹn, ohun kẹ udrin kẹ ididu ọ̀nkyẹ shin usoo kẹ ọmẹ ma! <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />Kyiikyuo ngọ a la pẹẹ lẹ àkpẹẹ enyi ọDawuda, agrẹn ngọ, lẹ Iri Ọnọm shin,</para>
  <para style="q1" vid="ACT 4:25">“ ‘Unse wan ọsọ anushin o soo wan aYahudawa wan kẹ ọmẹ unu kon amua</para>
  <para style="q2" vid="ACT 4:25">Unse wan ọsọ ada kon udu ọnkyẹ utri?<verse eid="ACT 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26" />Ágọn ohun woo ọta ọhuẹn ma</para>
  <para style="q2" vid="ACT 4:26">tuhuan ana ukon ekye ohun klan kẹ ọnhuọ uzun</para>
  <para style="q1" vid="ACT 4:26">Kyẹ udu ifuwo kẹ Ọnọm</para>
  <para style="q2" vid="ACT 4:26">kẹ Atuan nga uKristi.’<verse eid="ACT 4:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ACT 4:27" />Sablọ shin Agọn Iridus kẹ uBilatus klan akyuẹ kẹ ọhwuọ uzun kẹ ẹshan lẹ kẹ anushin o soo wan aYahudawa wan kẹ ada ana Israila kya udu ifuwo kẹ ọYẹsọ, agrẹn ngọ a nga ọdẹdẹy shin ngọ ekye lẹ nga uKristi <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />Odu ọnkyẹ shin ọdọ kẹ unii ngọ hurẹ uloo shin ọnba. <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />Ekyee Abaan, du ọnlighẹ kẹ aprẹn ọkpaa eji shin asọ enyi lẹn tuhuan kẹ ẹngọ ma ágrẹn ngọ ọdọ utoo aprẹẹ ngọ bọ ibun. <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />Ma enyi ọdọ ngọ kẹ enyi du ọnkyẹ ọvrọ kẹ ọmẹ ọntuan agrẹn ngọ a nga ọdẹdẹy, ọYẹsọ.” <verse eid="ACT 4:30" /><verse number="31" style="v" sid="ACT 4:31" />Lẹshin ahwurẹ ọpẹẹ lẹ Ọnọm, unkoo shin ẹma ywa kẹ ọmẹ nga la frẹ ọnẹghẹn. Ala kuwan ma lẹ iri Ọnọm tuhuan ala frẹ utoo aprẹ Ọnọm ba ibun.<verse eid="ACT 4:31" /></para>
  <para style="s">ANA URE ỌNỌM KAN KAM ỌNKYẸ WAN</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />Ẹhurẹ ididu ana ure Ọnọm kan soo kẹ ọnhuọ uzun, udu ọnkyẹ wan uzun wọ tuhuan ba ana shin osoo lẹ ọnlighẹ ekyuẹ ghan ma tushin akaaka kam huọ unse wan shin o so lẹ ọma. <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />Lẹ ẹhurẹ ẹdọ, apaduan lan lẹ otoo aprẹẹ ọnyuọn nga ọYẹsọ bi kẹ ọmẹ itun tuhuan Ọnọm la sọ ididu wan onyunn esheshii. <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />Huọ ẹnga nga kẹ ọmẹ ma kon ọnkyẹ unii nga. Anushin osoo lẹ onum kẹ abaan lẹ ohurọ kẹ okon ikli lẹ <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />Kẹ ama apaduan lan tuhuan a la kam ikli lẹ kẹ ama ọhuọ ẹnga ọka ghan kẹ emle ọbyan ẹhurẹ ghan. <verse eid="ACT 4:35" /><verse number="36" style="v" sid="ACT 4:36" />O soo kẹ ọnhuọ udu klan, uYusufu ọlawi ana ọSayifurus, ana apaduan adrọ ghan shin (ọBarnaba arẹn ọma ẹhwurẹ ẹdọ) <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />Àá huọ huro onum nga kẹ okon ikli lẹn ma kẹ tighe kẹ ẹmpakye apaduan lan.<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s">HANANIYA KẸ ỌSAFIRATU</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />Eladẹn, enkyii shin a drọ ghan shin Hananiya, kẹ ashẹ ghan Ọsafiratu, hu ohuro uple ọnlẹghẹ wan. <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />Lẹ ọbyan ashẹ ghan, ala zau iple ikli kẹ eyee ẹkyuẹ ghan tuhuan kẹ okon ẹnya ẹtọ wan balẹ ẹmpakyee apaduan lan. <verse eid="ACT 5:2" /><verse number="3" style="v" sid="ACT 5:3" />uBitrus la kọ ghan lẹ ẹnga shin, “Hananiya, unsee wan ọsọ ngọ aman ọShaitan ẹhurẹng ọnwọ shin ọsọ ẹ ngọ awa Iri Ẹsẹẹ ọntẹ tuhuan kẹ eyee ẹkyuẹng iple ikli shin ẹngọ ohuroo onum kọ? <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />Olo soo kọ ẹn kẹ angọ atọ sọ ọnya uhuro kọ wan? Kẹ ushin ahurẹ uhuro kọ lẹn, ikli lẹn kyẹ ẹn ya ngọ yọ wan? Unse wan ọsọ ngọ udu ute ọnlẹghẹ lẹn? Za shin kyẹ enyi-etri wan ẹngọ awa wan ọntẹ wan tushin Ọnọm ngan.”<verse eid="ACT 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 5:5" />Lẹ ushin Hananiya kọọn klan, ala kpaa kẹ okpoon; tuhuan ididu ana shin akọọn ọnkyẹ shin ọnba, ala nyan ọkọọn ibun <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />Kẹladran, arọfuọ la pẹn ọkrọọ ghan kẹ akpọn ghan kẹ akaaka lọọ ghan. <verse eid="ACT 5:6" /><verse number="7" style="v" sid="ACT 5:7" />A huọ ukon ẹlẹn ọyẹra ẹtaa, ashẹ ghan la ba tuhuan ba aza ọnkyẹ shin ọba wan, <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />uBitrus le e luwe ghan shin, “Toom ma, ididu ikli shin unu angrẹn lẹ onum shin unu ohuro yẹn?” Ala kọ ghan shin, “Ẹẹn, ididu lẹ yaa” <verse eid="ACT 5:8" /><verse number="9" style="v" sid="ACT 5:9" />uBtrus la kọ ghan lẹ nga shin, “Unse wan ẹngọ kẹ ekyi ngọ kpọn udu kya ọmaa iri Ọnọm? Ekyii shin alọọ ekyii ngọ mẹn kẹ atigha tuhuan enii ọkpọn ngọ ka okpo kan wan wọ!.” <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />Kẹladran, ala kpaa kẹ ẹmpakye ghan ka okpo ghan. Arọfuọ lan la eywure kẹ okon shin à hurẹ ukpo ghan, a la kpọn ọkrọọ ghan kẹ a ka lọọ ghan kẹ ayẹ ekyi ghan. <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />Ididu ọshọshẹ kẹ anushin a kọọn ọnkyẹ shin ọba, ibun la frẹ wan.<verse eid="ACT 5:11" /></para>
  <para style="s">Apaduan du ọ̀nkyẹ ọvrọ kẹ ọma ọkpa Eji</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />Apaduan lan du ọnkyẹ ọvrọ kẹ ọma ọkpa eji lapam kẹ ọmẹ ada. Ididu ana ure Ọnọm kan la klan kẹ ọmẹ Ọga uSolomon. <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />Bọ ana shin emle ọnyẹran ọmẹ ma kẹ ọmẹ ididu ada lan ma tushin afrẹ ọdọọ wan. <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />Ukre ana ure Ọnọm kan la kẹnmẹ lẹ ada lapam ekyii kẹ ashẹ anushin akpọn Ọnọm lẹ ẹhurẹ. <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />Sablọ ọnkyẹ ọvrọ shin apaduan lan kon udu, ada la mẹn oloo kẹ aligha wan kẹ aprẹn ùntru kẹ ẹ̀kya kẹ ẹ̀ntraan sablọ inshin uBitrus kya ukpon, iriri ghan kpon kẹ aprẹn ma. <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />Ada lapam bi kẹ ashan ayẹ Urushalima la klan lẹ okon oloo kẹ ana ọnsha nyẹran ma tuhuan ididu wan a la ma wan ọtrẹ.<verse eid="ACT 5:16" /></para>
  <para style="s">A TRỌ LẸ APADUAN ỌYẸSỌ</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />Akpẹẹ umee enshin alalẹ la nyẹnya kẹ enyi nga aSadukiyawa ọnhuọ udu ifuo kẹ apaduan lan. <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />Ala fẹn ma kẹ asọ kẹ unkoo. <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />Kẹ otu lan, atuan Ekye abaan la ba kẹ wa okun atigha unkoo lan kẹ e we wan. <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />Tuhuan kẹ otoo wan shin “Unu son kan lẹ abaan Ọnọm kẹ unu so too ada aprẹẹ ọrẹ ọprọpra lẹ.” <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />Lẹ apaduan lan kọọn klan, a la nyẹnya lẹ otu rombun kan lẹ etìn abaan Ọnọm kẹ ololo ada. Akpẹẹ ọma enshin alalẹ kẹ enyi nga la dra apaduan nga kẹ ana ukon ekye ana Israila, ka ma onyun shin oso kon apaduan lan ma bi kẹ unkoo. <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />Tushin ana ọzọ lan la kan lẹ ọmẹ ukoo lan bọ eshin apaduan lan ma e le ywure ka kẹ otoo akpẹẹ umee enshin alalẹ lan, <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />shin “Lẹ ọfuan enyi ọnhuọ lan, enyi kon atigha onkoo lan ywua kẹ uhrihrun la kpẹkpua tuhuan ididu ana ọzọ kon ọzọ. Tushin lẹ shin enyi okun atigha unkoo lan, enyi le shìn wan alọ kẹ ọmẹ lẹ ma!.” <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />Lẹ ọkọọn klan, ekye ana ọzọ abaan Ọnọm kẹ ákpẹẹ umee enshin la ba le trekpe la rẹn ẹhurẹ wan shin, unse wan unii ọba! <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />Alọ la ba kẹ a kọ ghan lẹ ẹma shin “Unu kọn, ana shin unu asọ kẹ unkoo lan ma ywua kẹ etìn abaan Ọnọm lẹ ololo ada lan” <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />Ọnwọ arẹn ọzọ lan kẹ ada la ka oson kẹ ma bọ enyi ma ọdọ wan sablọ akọn ibun kalẹ ada taa wan lẹ ọntrẹtra wan. <verse eid="ACT 5:26" /><verse number="27" style="v" sid="ACT 5:27" />A la okon apaduan lan ma kẹ asọ wan ọtigha kẹ ẹmpakye onokon aYahudawa tuhuan akpẹẹ umee enshin alalẹ le luwe wan ọmprẹẹ. <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />Shin, “Enyi a la unu ẹrẹnyẹ shin kalẹ unu ta ulolo lẹ ọntua enkyii lẹ ma, tushin unu ahurẹ Urushalima lẹ ulolo ghan lẹ unu nii ọntraan ushe eji ghan kẹ aprẹn enyi,” <verse eid="ACT 5:28" /><verse number="29" style="v" sid="ACT 5:29" />uBitrus kẹ ama apaduan lẹ ekyee shin, “Ọdọ wọ enyi re ọnkyẹ utoo Ọnọm kan ba enyi etri wan! <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />Ọnọm akpẹ enyi nyuọn ọYẹsọ bi kẹ ọmẹ itun ana unu aprẹẹ kẹ sẹsra ghan kẹ aprẹn ekyi. <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />Ọnọm dọọ ghan kan lẹ ọnyẹ ẹya ghan, ekyee agọn kẹ ofwó sablọ kẹ okun ana Israila ọntraan ọkpaa ẹtrẹ tuhuan kẹ o kon uhuro ilovro wan. <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />Enyi ma oso edre ididu ọnkyẹ lẹ, kẹ Iri Ẹsẹẹ shin Ọnọm ma ana udu ọkyẹ utoo ghan.” <verse eid="ACT 5:32" /><verse number="33" style="v" sid="ACT 5:33" />Lẹ shin ekyiwan lan kọọn kẹn, amua la nyan ma lakẹnkan tuhuan enii ọpẹẹ wan. <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />Tushin eple ana Bafarisiye shin adrọ shin ọGamaliyel ana ulolo iywuro uMusa la pẹẹ shin azrọ uwe wan kan lẹ etin. <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />A lẹ otoo wan shin, “Unu ewedri mi ana Israila, unu kon aklọ lẹ ọnkyẹ shin unu byan udu ekyiwan lẹ. <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />Amẹ shin òkpon, eple enyi lẹ otro adrọ ghan shin uTudas, kẹ afrẹ ọdọọ ẹkyuẹ ghan shin ẹnga enyi alalẹ ghan. kẹ owoo ada lapam kan lẹ ọnhuọ ọywua ghan tushin ala prẹn tuhuan ana ure ghan kan lan le triton <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />Ọnya kẹ uTudas, ọYahuza ana ọGalili la ba kẹ aywuẹ shin a pua ada wọ, a la sọ ada lẹ ere ghan kan. Tushin a huọ ọprẹ ghan tuhuan ana ure ghan kan lẹ ovlom. <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />Imi kya utoo unu, kalẹ unu pya ekyiwan lẹ ma, unu laa wan kẹ ozun! Inshin ọtuan ma ọnwọ enyetri wọ, u nii uvro wọ. <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />Tushin inshin ọtuan Ọnọm wọ, unu nii unu umle ọya ẹkyuẹ lẹ ẹma ma. Unu laa wan kan, kalẹ okon unu kon udu ifuwo kẹ Ọnọm ma.” <verse eid="ACT 5:39" /><verse number="40" style="v" sid="ACT 5:40" />“E le re ọnkyẹ utoo ghan kan.” A la dra wan ba lẹ ọmẹ ozoo lan ka kẹn ma tuhuan kẹ owoo wan atọn kalẹ a tọ ulolo ada kẹ aprẹẹ ọYẹsọ wan tuhuan ala laa wan. <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />Apaduan la laa ozoo lan wọ lẹ ọmọ sablọ ẹma mẹẹ ọhyua ọwà sablọ ọntua ọYẹsọ. <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />Ala frẹ ulolo ada kẹ aprẹẹ ihyuu ishishi ọYẹsọ, uKristi huọ ulon ubon nga kẹ ọmẹ abaan Ọnọm kẹ ọmẹ abaan ada shin ọYẹsọ nga oso uKristi.<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s">UWLI ARẸN ỌTUAN ANA OTUMPUA</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />Aywuẹ lan, lẹ ushin ukree ana ubi frẹ ọkẹnmẹ lakẹnkan, eHelenawa lẹ enyin ọkọọn lẹ ẹm bi wan kẹ aYahudawa sablọ shin huọ ulon ubon nga wọ, aYahudawa ka ta ititim lẹ okum ama eHelenawa kẹ ọnhuọ ọka okum ọnkyẹ ọya. <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />Apaduan ọkọ lẹ apwa lan la dra ididu ana ubi kẹ ọnhuọ uzun ka kọ wan lẹ ma shin, “Ọgbaa wọ enyi laa ulolo aprẹ Ọnọm kan tuhuan kẹ enyi frẹ ọkam ọnkyẹ ọya wan. <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />Ọnwọ ọsọ unu ewedri enyi, unu wli ana otumpua kẹ ọmẹ ana ada kon ọdọọ wan ana shi akuang lẹ Iri Ọnọm tuhuan oso lẹ ọza ikon ana shin enyi nii ọsọ wan ọtuan nẹ kẹ anyẹ. <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />Enyi nii ọma akyuẹ enyi lẹ ẹhurẹ izun ọnhuọ ọpẹlọnọm kẹ ululo aprẹ Ọnọm.” <verse eid="ACT 6:4" /><verse number="5" style="v" sid="ACT 6:5" />Ididu ada la a kọọn ushi lẹ ọkpọn ọnwọ apaduan lan. Ọnwọ e le we Istifanus, enkyii shin àá kuang lẹ Iri Ọnọm kẹ ọza ikon kẹ uFilibus kẹ uBurokoras, kẹ uNikanor kẹ uTiman kẹ ọBarminas kẹ uNikolas ana Antakiya anushin ànyẹran ubi ẹYahudawa. <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />Ekyiwan nẹ ma ada le we ka ma apaduan lan a la pẹlọnọm tuhuan ka traa wan anyẹ. <verse eid="ACT 6:6" /><verse number="7" style="v" sid="ACT 6:7" />Aprẹẹ Ọnọm sẹ ọkan ekye huọ ulon ubon nga wọ tuhuan ukre ada ta huọ ukon ọkẹnmẹ lẹ ẹplẹpan kẹ ẹbọn Urushalima emle nga akpẹẹ umee enshìn ta ukon ọma ẹhurẹ wan lẹ Ọnọm.<verse eid="ACT 6:7" /></para>
  <para style="s">A FRẸ ISTIFANUS</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />Istifanus, anushin àá kuang lẹ esheshii Ọnọm kẹ ọdọ ghan, la frẹ udu ọnkyẹ ọvrọ kẹ ọma ọkọọn ibun kẹ ọmẹ ada. <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />Ifio la nyaan, bi kẹ omẹn unkoo ọpẹlọnọm ọnwọ ekyii shin ofuo wan ukuraniyawa kẹ Iskandariyawa, kẹ eKilikiya kẹ Asiya la ọfrẹ ya ẹna kẹ Istifanus <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />Tushin bọ aya ẹkyuẹ lẹ ẹnga ma sablọ shin aza ẹda ikon ka ẹhurẹ ọza ọpya onyun tuhuan Iri Ẹsẹẹ soo kẹ ẹnga. <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />Ọnwọ osọ ala ma alọ wan ikli ka wa ọntẹ shin, “Enyi akọọn ngaa okon ọtua uMusa tuhuan okon udu ifuwo kẹ Ọnọm” <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />Lẹ ọkọọn klan, ẹhurẹ ada la pya. onokon kẹ avua ulolo iywuro la frẹ Istifanus kẹ akpọn ghan kan lẹ ẹmpakye ana ukon ekye. <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />Ọnwọ a lẹ okon alọ wan ma kẹ a ma wa ọntẹ kẹ aprẹn ẹkyuẹ ghan shin, “Enkyi lẹ kon udu ifuo kẹ ọshọshẹ enyi kẹ iywuro uMusa. <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />Enyi akọọn okon utoo shin, ọYẹsọ ana Banazarẹ ni uvro ọshọshẹ lẹn tuhuan kẹ ekye iywuro uMusa shin ala sọ enyi kẹ a nyẹẹ.” <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />Ididu ana ọtrẹtra kẹ ọmẹ ozoo lan la e we Istifanus tuhuan e le shin ukpekye ghan la frẹ ọsan kawa ọnwọ atuan Ọnọm.<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s">Ọpẹẹ Instifanus kan lẹ ọklan onokon</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />Ọnwọ akpẹẹ ọmee enshin alalẹ le lue ghan shin, “Ọnkyẹ lẹn ẹplẹpan yaa?”<verse eid="ACT 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2" />Ala kọ ghan shin, “Ewedri kẹ ekye, unu ngẹn atọn lẹ imi! Ọnọm anushin àá mẹẹ ọdọọ nyin ẹkyuẹ ghan kẹ ọnhuọ akpẹẹ enyi Ibrahim kẹ ẹlẹn shin òó soo kẹ ọMesofotaniya, a tọ usoo ghan ọywua kẹ ọHaran ma. <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />Ọnọm lẹ otoo ghan shin, ‘Laa ẹshan ngọ kẹ enyi ngọ, tuhuan kẹ ẹngọ kpokan ngọ lẹ ẹbọn shin imi nii unyin ngọ.’<verse eid="ACT 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 7:4" />“Ọnwọ ala okpoon kan ghan lẹ ẹbọn aKaldiyawa ka trẹtraa ghan kẹ ọHaran.Ititim ukpo ekyee ghan, Ọnọm la tuan nga ba lẹ ẹbọn lẹn, ọnhuọ shin unu ywuau kẹ ẹladẹn. <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />Tushin Ọnọm man ghan Ibrahim ọka kẹ ọnhuẹn ma, huọ ẹka ọfraan uzun. Tushin Ọnọm kpaa ghan onyun shin, ẹ nga kẹ ọnyẹẹn ititim ghan ni ọgraam lẹ ẹbọn lẹn, kẹ ushin ẹladran, Ibrahim soo ghan lẹ arẹn ma. <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />Ọnọm pẹẹ lẹ ẹnga kẹn, ˈ ọnyẹẹ ngọ ni ukye osoon kẹ ẹbọn shin isoo kọ ẹn ka ma, tuhuan enii udu ẹgrẹn kẹ ọywua ẹva kẹ ọmẹn amẹẹ atẹlẹ ọkọ anang. <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />Tushin imi ni ọma ẹbọn shin ẹsọ wan udu ẹgrẹn lan ẹva, ọnkyẹ utoo Ọnọm, tuhuan uple ubun, enii utro kẹ ọmẹn ẹbọn lan kẹ frẹ ọdọọ mi kẹ ọnhuẹn. <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />Ọnọm man Ibrahim ọklán onyun ọta itun. Ọnwọ Ibrahim lẹ obyon Ishaku tuhuan ka ta ghan itun kẹ aywuẹ ẹnnanaan lẹ ubyon ghan. Iple ẹlẹn, Ishaku lẹ obyon ọYakub, tuhuan ọYakub lẹ ekye akpẹẹ enyi a kọ lẹ apua lan.<verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />“Sablọ ifuo uYusuf, akpẹẹ enyi lan lẹ ohuro ghan kawan agrẹn kẹ ọMasar. Tushin Ọnọm soo kẹ ẹnga <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />kẹ ofuo ghan bikẹ ọmẹn ẹva ghan tuhuan ka man uYusuf ọza ikon shin ọsọ ghan ukon ọbyan ọnhuọ uFirˈauna Agọn ọMasar; ọnwọ ala sọ uYusuf le kyee ana ukon ekyee kẹ ọMasar tuhuan kẹ ididu ozoo ghan.<verse eid="ACT 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 7:11" />“Ẹwọn la kpaa kẹ ididu ẹbọn ọMasar kẹ ọKanˈana, kẹ asọ ada lẹ ẹva lakẹnkan ọnwọ ushin akpẹẹ enyi okon wan ẹshẹẹ ọya wan. <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />Ẹlẹn shin ọYakubu kọọn shin ayá soo kẹ ọMasar, a la tuhuan akpẹẹ enyi lan kan lẹ ọMasar usòòn ọtẹkpa wan. <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />Kẹ usòòn ọnwọ ẹn puan, uYusuf lẹ otoo ewedri ghan Uson ma ọnwọ ẹmpuan Isu lẹ e nyin ewedri ghan ẹkyuẹ ghan, uFir'auna la kpẹ ghan lakpẹẹkprẹ. <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />Ọnwọ Isu la tuhuan lẹ ekye ghan ọYakubu shin a ba kẹ ididu ewedri Isu. Ididu wan ana ẹhuẹ itumpua lẹ otong ma. <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />Ọnwọ uYusuf lẹ okpon kan ghan lẹ ọMasar. Ọnhuọ ẹnga kẹ akpẹẹ enyi kpo wang. <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />A la kpọn ẹ̀krọ wan kan lẹ ọShekem ka kẹ lọọ kẹ ọmẹn itun shin Ibrahim huọ ọlọ lẹ eple onyunn ikli bi kẹ arẹn ọHamor kẹ ọShekem.<verse eid="ACT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />“Lẹ shin ẹlẹn ọhua ọkpaa onyunn shin Ọnọm kpaa Ibrahim ba akaaka, enyi la kẹmmẹ lakẹnkan kẹ ẹbọn ọMasar. <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />Tushin odu eple agọn kẹ ọMasar, anushin a za ghan huọ ẹnga nga oso Isu wan. <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />A ngẹn agọn nẹ lẹ aya ẹda enyi wọ, àá la ma ákpẹ enyi ọtrọ la sọ a laa uson arẹn wọ sablọ e kywure wan.<verse eid="ACT 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 7:20" />“Kẹ ẹlẹn náá yaa o byon uMusa wọ, arẹn kẹ agyagyuan lakẹnkan. A lẹ okon nga ẹprẹn ẹtaa kẹ ọmẹ abaan ekye ghan. <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />Lẹ shin a ta ghan wọ, arẹn uFirˈauna orodruan la kpọn ghan, àá okon aklọ lẹ ẹnga kawa arẹn nga <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />A lẹ ololo uMusa ididu ọza ikon ọnwọ aMasarawa, ọza ọpiya onyunn kẹ emle udu ọnkyẹ.<verse eid="ACT 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23" />“Lẹ ushin àá fuan amẹ ẹhuẹ ẹnang wlan, ọnwọ a lẹ arẹn ẹhurẹ ghan a la kan odruu lẹ éwedri ghan Israˈilawa. <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />Lẹ ushin èé shin eple ana ọMasar kon ọya ana onzun ma wọ, a la kan ka kẹ ere ana Israˈla lan wọ, a la hulọ kywura ghan wọ, a lẹ a la ana ọMasar, kẹ a prẹ ghan. <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />uMusa le mle shin éwedri ghan nii ọkpẹ shin Ọnọm nii udu ọtuhuan lẹ ẹnga sablọ e we wan. Tushin ẹma kpẹ wan ma <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />Kẹ ọnwaa ubon, e shin eple ana Israˈla apua okon ọhuẹn, ọklan wọ è le nii usem ma, a la kọ ghan, ‘Unu ekyi, unu éwedri wan faa, unse wan ọsọ unu kon ọya eple wọ?’<verse eid="ACT 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 7:27" />“Tushin ana uso kẹ ọnhuọ ọya èwedri ghan wọ la ta uMusa anyẹ kan lẹ ayẹ, ka kọ ghan shin, ‘Ẹnga nga ekyee lẹ ẹngọ ana ọprẹ ataan enyi? <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />Wo, ẹngọ nii ọprẹ mi kawa emle shin ngọ aprẹ ana ọMasar kẹ ọlẹ?’ <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />Lẹ shin uMusa kọn klan, e le titon ka a kẹ aywua uson kẹ ẹbọn uMidiyan, kẹ ọnhuọ lan wọ òó byon erekyii apua.<verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />“Ọshin amẹ ẹhuẹ ẹnang kpon, eple atuhuan Ọnọm la enyi ẹkyuẹ ghan kẹ ọnhuọ uMusa kawa ẹwọ ọla, kẹ ifo onum kẹ ayẹ ọnkọn uSinai. <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />Lẹ shin uMusa shin klan, a la kọn ọvrọ ọnkyẹ shin ẹnga shin. Lẹ shin àá ba akaaka sablọ ẹnga shin, ọnwọ a la kọn iwe Ekye abaan ẹ la kọ wọ shin, <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />‘Imi nga iso Ọnọm akpẹẹ ngọ, Ọnọm Ibrahim, kẹ Ishaku, kẹ ọYakubu.’ Ẹgbẹna uMusa la frẹ ọkpan, bọ émle ukon ọdọ umle shin ma.<verse eid="ACT 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 7:33" />“Ekye abaan la kọ ghan lẹ ẹnga shin, ‘We akpla ngọ , kẹ ọnhuọ shin ngọ kyẹn wọ lan ọnhuọ Ẹsẹẹ wọ. <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />Lẹ ẹplẹpan imi e shin ọtrọ shin okon ọma enyi mi shin oso kẹ ọMasar, imi a kọn ukyue wan, tuhuan imi sri ba ufuwo wan. Tọ, kẹladẹn ba tuhuan imi nii ọtuhuan ngọ kẹ ẹngọ uhwure kan lẹ ọMasar.’<verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />“uMusa lan ngẹn anushin a tran ma ẹngaan lẹ ẹnrẹn lẹn, ‘Ẹngá nga èé kyee lẹ ẹngọ ana ukon ekyee kẹ ana ọprẹ ataan enyi?’ Ọnọm ẹkyuẹ ghan nga tuan nga kẹ ekyèè ana ukon ekyee kẹ ana ufuwo unu, kẹ ọtrẹkyuẹ ka atuan Ọnọm shin òó tro kẹ ọnhuọ ghan kẹ ọmẹn onum. <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />A nga e we wan, lẹ shin òó du ọnkyẹ ọvrọ, kẹ amkpẹ kẹ ọMasar, kẹ udrin ususo, kẹ ọmẹ ifo onum amẹ ẹhuẹ ẹnang.<verse eid="ACT 7:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 7:37" />“uMusa lẹn nga òó too ana Israˈila kẹ ẹkyuẹkyuẹ ghan, ‘Ọnọm nii ọtuhuan unu lẹ eple ọnu bi kẹ ọmẹ enyi unu, kawa emle shin àá tuhuan mi wọ.’ <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />uMusa òó soo kẹ ọklan ada ana Israˈila kẹ ifonum. òó so kẹ ọnhuọ lan kẹ akpẹẹ enyi kẹ àtuhuan Ọnọm lan shin àá piya onyunn kẹ ẹnga kẹ aprẹn ọnkọn ọlọlẹ ọnwọ uSinai. Àá nga tọ ngrẹ ẹtọprẹ ẹn ya ọma ọrẹ bi kẹ ọnhuọ Ọnọm kẹ o kon enyi ma.<verse eid="ACT 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39" />“Tushin akpẹẹ enyi la tran ma ure ọnkyẹ utoo ghan kan, a la tran ma ọ ngẹn atọn lẹ ọnkyẹ utoo ghan, a la kọn uywure wan ẹbọn ọMasar. <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />Á la kọ wan lẹ oRuna, ‘Ẹngọ du enyi ẹnọm shin i nii ọkpa enyi kẹ ekye, kẹ́ uMusa shin èé we enyi bi kẹ ẹbọn ọMasar lan, enyi za wan ọnkyẹ shin ọba ghan ma.’ <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />Kẹ ẹlẹn na, ala afran Ọnọm kawan arẹn ẹlau, ka ma ghan ẹnshi, a la frẹ ọkọọn ushi lẹ ọnkyẹ shin ẹma du lẹ anyẹ ma. <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />Ọnwọ sọ Ọnọm le ta wan ititim, kẹ a laa wan kẹ afrẹ ọdọọ Ọnọm ọsaan, ọprẹn kẹ orunkyin a ma aprẹn. Ọnwẹn ba la kyẹkyọ kẹ ọnkyẹ shin usoo kẹ ọrẹrẹn kẹ ọzaa ónu shin,</para>
  <para style="q1" vid="ACT 7:42">“Unu ana Israˈila, unyin shin kyẹ imi nga unu a la mee mi enshin lẹ ọnkyẹ ẹtran,</para>
  <para style="q2" vid="ACT 7:42">amẹ ẹhuẹ ẹnang kẹ ifonum unu ana Isra'ila?<verse eid="ACT 7:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43" />Unshìn <note caller="+" style="f"><char style="fr" closed="false">7:43 </char><char style="ft" closed="false">ọMolek kẹ uRefan ọnwọ uso untua ẹnọm kẹ ẹda Ibraniyawa</char></note>ọMolek wọ unu a frẹ uklem wọ,</para>
  <para style="q2" vid="ACT 7:43">kẹ erinkyin uRefan,</para>
  <para style="q2" vid="ACT 7:43">ẹnọm shin unu a vlan sablọ unu dọọ wan.</para>
  <para style="q1" vid="ACT 7:43">Ọnwọ ọsọ imi ni u we unu kẹ imi ta unu kan lẹ ekye ananọ ọBabila.<verse eid="ACT 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />“Kyikyuo ákpẹ enyi lẹ osoo lẹ Unshìn ankpẹ Usoo kẹ Ọnọm kẹ ifonum.Odu wọ kawan emle shin Ọnọm too uMusa wọ, <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />Unshìn lẹ wọ akpẹẹ enyi kon ma balẹ ẹbọn lẹn kẹ aywuẹ shin uYoshuwa soo ana ukon ekyee wan. Ẹlẹn lan yaa á kràá ẹbọn lan kẹ anyẹ anushin Ọnọm re kẹ iredre wan. Unshìn lan soo ba lẹ ẹlẹn ẹgọn ọDawuda. <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />ọDawuda la huọ ukon eji asẹẹ kẹ ẹmpakye Ọnọm, a la wan kẹ ẹnga vran ọnhuọ ọywua sablọ Ọnọm ọwọ ekye enyi ọYakubu. <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />Tushin uSolomon nga vran Ọnọm ọnhuọ ọywua.<verse eid="ACT 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48" />“Kẹ ushin Ọnọm ka ywua ghan kẹ ọmẹn abaan shin enyetri vran wan.Emle shin onu toou shin:<verse eid="ACT 7:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49" />“ ‘Aprẹmẹn kẹ o so ẹntrẹtrọ ẹgọn mi,</para>
  <para style="q2" vid="ACT 7:49">tuhuan ohun kẹ oso ọnhuọ traa afran mi.</para>
  <para style="q1" vid="ACT 7:49">ulon ute abaan nga wọ unu nii vran mi?</para>
  <para style="q4" vid="ACT 7:49">Ọnọm nga o too klan.</para>
  <para style="q2" vid="ACT 7:49">Huọ, ulon ọnhuọ ghan wọ unii usoo ọnhuọ utrim mi?<verse eid="ACT 7:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50" />Kyẹ anyẹn mi ya odu ọnkyẹ lẹn ledidu wan?’<verse eid="ACT 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />“Unu ana ẹhurẹ kẹ atọn ọkpẹkpua! Unu so kawan akpẹẹ unu: Unu akaaka tran unu Iri Ẹsẹẹ! <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />Eple ónu soo shin akpẹẹ unu trọ wan lẹ ẹnga ma? Ala ta pẹẹ anushin ala otoo aprẹẹ ọba Anaa ọdẹdẹy lan. Tuhuan unu ohuro kẹ aprẹ ghan. <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />Unu a ngrẹ ulolo lan kẹ ọnhuọ atuan Ọnọm, tushin bọ unu odu ọtuan lẹ ọnkyẹ utoo ghan man.”<verse eid="ACT 7:53" /></para>
  <para style="s1">Á Tẹlẹ Istifanus Sẹ Lẹ Okpo Ghan</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />Lẹ shin á kọn klan, odu amua lakẹnkan, a la nuan onyun sablọ amua. <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />Tushin Istifanus kuang lẹ Iri Ẹsẹẹ, a la sa edre lẹ eshin aprẹn, èé shin uyi Ọnọm, kẹ ọYẹsọ a tọ kyẹn kẹ ọnyẹ ẹya ọnwọ Ọnọm. <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />Tuhuan Istifanus la kọ ghan shin, “ Shin, imi eshin aprẹn a tọ ukikun, kẹ Arẹn enyetri a kyẹn kẹ ọnyẹ ẹya ọnwọ Ọnọm.” <verse eid="ACT 7:56" /><verse number="57" style="v" sid="ACT 7:57" />Tushin a la frẹ utri ẹkpa lakẹnkan, ka fuọ atọn ma kan, a la nya nga kẹ ẹlẹn izun. <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />E le we ghan kan lẹ ititim ẹshan, ka frẹ ọtẹlẹ ghan lẹ ọntrẹtra. Ánushin a waa ghan ọntẹ la kpọn ọnkyẹ ghan kẹ ọnhuọ eple arọfuọ ana ọntua ọShawulu. <verse eid="ACT 7:58" /><verse number="59" style="v" sid="ACT 7:59" />Á la frẹ ọtẹlẹ Istifanus, ẹnga la pẹlọnọm ka kọ ghan shin, “Ekye abaan! ọYẹsọ, ngrẹ ọrẹ mi.” <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />A la ta ongbun, ka sa iwe lẹ ọdọ ka kọ ghan shin, “Ekye abaan, kalẹ ngọ pua ẹn yẹn ilovro le kẹ aprẹn akyuẹ wan ma.” Lẹ shin òó too klan, a lẹ o kpo ghan.<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />ọShawulu àá fraa ititim ọprẹ Istifanus.</para>
  <para style="s" vid="ACT 8:1">ọShawulu Trọ lẹ Ada Ana Ubi</para>
  <para style="p" vid="ACT 8:1">Kẹ áywuẹ́ lan, iple ọtrọ ẹlẹlẹ la kpaa ada ana ubi shin o so kẹ Urushalima. ididu ada lẹ ovlom wan kan ọga uJudiya kẹ ọSamariya sẹ apaduan ma ala tọ lehule. <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />Eple ana ọdọọ Ọnọm a la lọọ Istifanus, e le kyue okpo lakẹnkan sablọ ẹnga. <verse eid="ACT 8:2" /><verse number="3" style="v" sid="ACT 8:3" />Tushin ọShawulu la frẹ ọma ada ana ubi ọtrọ lẹplẹpan, la nyẹran àbaan-àbaan lẹ eywui ekyii kẹ ashẹ, la sọ wan kẹ unkoo.<verse eid="ACT 8:3" /></para>
  <para style="s">uFilibus kẹ ẹshan ọSamariya</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />Anushin ó vlowan lan, lẹ oson otoo ihyuu ishishi huọ ulon ọnhuọ shin a kan. <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />Emle lan ngan uFilibus lẹ osrom kan ghan lẹ ọSamariya, lẹ otoo wan aprẹ ana-ofwó. <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />Lẹ shin ada kọn, e le shin amkpẹ ọvrọ shin o kon udu, lẹ ẹhurẹ izun a la ma ẹ́hurẹ wan kẹ aprẹn ọnkyẹ shin òó too. <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />Ọnwọ Iri ibibi le wli yọ le tri ẹ̀kpau bi kẹ ọmẹ ẹgbẹ́na ada lapam. A la ma anushin ẹ́gbẹna ma hyuọm yọ ọtrẹ kẹ ógun lapam. <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />Ọklan wọ á la mọ kẹ ọmẹ ẹshan lan lakẹnkan.<verse eid="ACT 8:8" /></para>
  <para style="s">uSiman ana ọswa ẹtra</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />Eple enkyii soo shin a drọ ghan shin uSiman, anushin ikyikyuo àá la ka swa ẹtra kẹ ẹshan lan tuhuan àá kẹ odu ọnkyẹ ọvrọ kẹ ọSamariya la kọ ghan shin, ẹnga enyi alalẹ ghan. <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />Ididu ada onokon kẹ arẹn, la ngẹn atọn lẹ ẹnga tuhuan kẹ asa iwe shin, “ Enkyii lẹn nga oso ọdọ Iri shin adrọ shin, Ọdọ Ọlọlẹ.” <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />A la sọ ẹhurẹ wan kẹ aprẹn nga lakẹnkan, sablọ shin àá huọ ywuá ọnhuọ udu ọnkyẹ ọvrọ lẹ ọswa ẹtra ghan. <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />Tushin kẹladẹn, lẹ shin àá kpọn ihyuu ishishi shin uFilibus too kẹ aprẹn ẹgọn Ọnọm lẹ ẹhurẹ wan, kẹ ọntua ọYẹsọ ukristi, ididu wan a lẹ odu wan ọbaftisma, ekyii kẹ ashẹ. <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />Huọ uSiman kẹ ẹkyuẹkyuẹ ghan huọ kpọn lẹ ẹhurẹ tuhuan ala odu ghan ọbaptism. Lẹ shin a hurẹ udu ghan ọbaftisma a la bram kẹ uFilibus. Lẹ shin eshìn emle shin uFilibus kon udu amkpẹẹ kẹ ọnkyẹ ọvrọ ọndrọndọ wọ, ọnwọ a la kọn ọvrọ lakẹnkan. <verse eid="ACT 8:13" /><verse number="14" style="v" sid="ACT 8:14" />Tọ, lẹ shin apaduan shin o soo kẹ Urushẹlima kọn shin ana ọSamariya ngrẹ aprẹẹ Ọnọm, a la tuhuan uBitrus kẹ ọYohanna kan lẹ ọSamariya. <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />Lẹ shin a fuan aSamariya, a la pẹlọnọm sablọ ẹma kon Iri Ẹsẹẹ. <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />Udu klan sablọ Iri Ẹsẹẹ so nya ya u sri kẹ aprẹn alọ wan ma, tushin a lẹ odu wan ọbaftisma wọ lẹ ọntua Ekye abaan ọYẹsọ. <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />Ọnwọ uBitrus kẹ ọYohanna na a la tra wan anyẹ onyun esheshi, a la huọ ngrẹ Iri Ẹsẹẹ. <verse eid="ACT 8:17" /><verse number="18" style="v" sid="ACT 8:18" />Lẹushin uSiman shìn shin Iri Ẹsẹẹ sri lẹ ọsa anyẹẹn apaduan lan, ala man wa ikl, <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />ka kọ ghan shin, “unu huọ mam ute ọdọ lẹn sablọ shin huọ ẹngá nga shin imi a tra ghan anyẹẹn, anaa kon Iri Ẹsẹẹ” <verse eid="ACT 8:19" /><verse number="20" style="v" sid="ACT 8:20" />Tushin uBitrus la kọ ghan lẹ ẹnga shin, “Ẹngọ kẹ ikli ngọ, unu kpo unu! Ẹngọ mle shin lẹ ikli wọ ngọ nii ukon agyuan Ọnọm wọ? <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />Bọ ambrẹ ngọ kẹ anyẹn ma huọ la hyuẹ, sablọ ẹhurẹ ngọ so ya ishìì kẹ Ọnọm ma. <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />Kpaa ilovro ngọ kẹ ngọ laa udu utri ọnwọ angọ kan, kẹ ngọ wan Ekye abaan huọ a tọ aywuro ngọ onyunn ọnkyẹ shin ngọ e tighe kẹ ọmẹ ẹhurẹ ngọ. <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />Sablọ imi eshín ngọ a kuang lẹ ifuo, ẹngọ ywua kẹ uliloo kẹ ọmẹ ilovro ngọ.” <verse eid="ACT 8:23" /><verse number="24" style="v" sid="ACT 8:24" />Ọnwọ uSiman le kye ka kọ ghan shin, “Unu wan mi Ekye abaan wọ, kalẹ huọ ọnlighẹ uzun kẹ ọmẹ ọnkyẹ shin unu o too ọ ba lẹ imi ma.” <verse eid="ACT 8:24" /><verse number="25" style="v" sid="ACT 8:25" />Lẹ shin uBitrus kẹ ọYohanna hurẹ ọtigha kẹ otoo ẹplẹpan tuhuan kẹ o too ihyuu ishishi ẹn kẹ aprẹẹ Ekye abaan, e le ywure wan Urushẹlima. ushin a kyẹ uywure wan Urushẹlima, a la frẹ utoo ihyuu ishishi kẹ árẹn ashan a ma ọSamariya lapam.<verse eid="ACT 8:25" /></para>
  <para style="s">uFilibus kẹ Aná Itiyofiya</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />A ywua atuan Ekye abaan la kọ ghan lẹ uFilibus shin, “Nyẹnya kẹ ẹngọ re ọntraan ọmọmbọn shin u kpon kẹ ọmẹ Urushalima kan lẹ ọGaza,” <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />Ẹlẹn shin àá kyẹ uywure ghan, ala klan kẹ ana Itiyofiya shin awa ghan ẹmua kẹ ọntraann, ana ukon ekye alalẹ shin o kon inywu ikli ọKandis, ọSarauniya ọnwọ Itiyofiya. Àá kan lẹ Urushalima kẹ ọdọọ Ọnọm wọ. <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />Lẹ shinu okrun lan kyẹ uywure ghan ọmẹ abaan kẹ ọmẹ ukyekye ẹkau ghan, a lẹ okun ọzaa onu Ishaya ka frẹ ọpua. <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" />Ọnwọ Iri Ẹsẹẹ la kọ ya lẹ uFilibus, “Zem kan lẹ ayẹẹ ukyekye ẹ́kau lẹ.” <verse eid="ACT 8:29" /><verse number="30" style="v" sid="ACT 8:30" />uFilibus lẹ etiton kan lẹ ọnhuọ ọywua ghan, ka kọọn o kon ọpua ọzaa onu Ishaya. E le luwe ghan shin “Ẹngọ a kpẹẹ ọnkyẹ shin ngọ kon ọpua?”<verse eid="ACT 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31" />A la kọ ghan shin, “Kay, kyẹ emle shin imi nii ọkpẹ wọ, sẹ alọ too mi?” Ọnwọ a la dra uFilibus kawa trẹtraa kẹ ẹnga kẹ ọmẹ ukyekye ẹ́kau kẹ ẹnga.<verse eid="ACT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 8:32" />Okrun ana Itiyofiya lan so kẹ ọnhuọ ọpua ẹn yẹn ẹnrẹn ọzaa lẹ:</para>
  <para style="q1" vid="ACT 8:32">“O kon nga kawa atẹn kan lẹ ọnhuọ ọwaa,</para>
  <para style="q2" vid="ACT 8:32">tuhuan kawa emle shin arẹn atẹn kẹ oso la ywuẹt kẹ ẹfaa ana ukye unfu ẹgbẹna ghan wọ,</para>
  <para style="q2" vid="ACT 8:32">emle lan nga òó kun nga onyun nga ma.<verse eid="ACT 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33" />A trọ lẹ ẹnga, bọ anushin àá tigha ghan ma.</para>
  <para style="q2" vid="ACT 8:33">Ẹngá nga e tẹ èmle utoo émle ọ̀nyẹ nga?</para>
  <para style="q2" vid="ACT 8:33">Kẹ ọrẹ ghan kẹ ọmẹ ohun?”<verse eid="ACT 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34" />Ọnwọ okrun lan la kọ ghan lẹ uFilibus shin, ẹngá nga onu lẹ too aprẹẹ ghan, ẹkyuẹ ghan, tọ alọ dẹn? <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />Ọnwọ uFilibus la tẹkpa lẹ ọpua ẹnrẹn ọmẹ ọzaa lan kẹ otoo ghan ihyuu ishishi ẹn kẹ ọYẹsọ. <verse eid="ACT 8:35" /><verse number="36" style="v" sid="ACT 8:36" />Lẹ ushin a nya usoon kẹ ọntraan lan kẹ afuan ọnhuọ ambrẹ, okrun lan la pẹẹ shin, “Shìn, ambrẹ wẹn, unse wan ọsọ ngọ nii ngọ udu mi ọbaftisma ma?” <verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" />uFilibus la kọ ghan shin, “Inshin ẹngọ a kpọn lẹ ẹhurẹ ngọ kẹ izun, tọ a lẹ ọhuọ du ngọ.” Okrun lan la kọ ghan shin, “Imi a kpọn lẹ ẹhurẹ mi, ọYẹsọ ana Ofwó Arẹn Ọnọm nga.” <verse eid="ACT 8:37" /><verse number="38" style="v" sid="ACT 8:38" />Ọnwọ a la ma onyun shin a sọ ekyekye ẹ́kau lẹn tigha. Kẹ ampua wan le sri kẹ anyẹran kan lẹ ọmẹ ambrẹ lan, ọnwọ uFilibus lẹ odu enkyii lan ọbaftisma. <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />Lẹ ushin ó tro bi kẹ ọmẹ ambrẹ lan, Iri Ọnọm la kpọn ufilibus, okrun lan la tọ ushìn ghan ẹnga ma. Ọklan wọ enkyii lan la frẹ usoson nga la amọ. <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />Tushin uFilibus lẹ eshìn ẹkyuẹ ghan kẹ Azotus. Ọnwọ e le klem kẹ ididu àshan lan, la o too ihyuu ishishi, a la kan afuan ọKaisariya.<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s">Ukye Ọnwọ ọShawulu</para>
  <para style="r">(<ref loc="MAT 22:6-16">ọMatiyu 22:6-16</ref>; <ref loc="MAT 26:12-18">26:12-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />ọShawulu la frẹ ọya ekye kan ghan lẹ ọtrọ lẹ ana ubi ọtrọ lakẹnkan, lẹ o too shin ẹga nii ọpẹẹ wan. Ọnwọ a la kan lẹ ọnhuọ àkpẹẹ umee enshin alalẹ, <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />ka wan nga shin a ma ghan azaa ọkan lẹ onkoo ọpẹlọnọm an ya uDimashku, sablọ inshin òó kon alọ shin erè ọntraan Ekye abaan kan, ekyii huọ ashẹ, o kon wan ma kẹ ulilulo ẹshan ẹlẹlẹ Urushẹlima. <verse eid="ACT 9:2" /><verse number="3" style="v" sid="ACT 9:3" />Lẹushin àá kyẹ ọfuan uDimashku kẹ ọmẹn usoon ghan, ọsẹẹ la saan kẹ aprẹn ghan bikẹ aprẹn bọ iywuu. <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />Ọnwọ à la kpaa kẹ ẹbọn, à la huọ ọkọọn iple iwe shin i kon utoo ghan shin, “ọShawulu, ọShawulu, unse wan ọsọ ẹngọ kon ọtrọ lẹ imi?” <verse eid="ACT 9:4" /><verse number="5" style="v" sid="ACT 9:5" />Ẹnga la kọ ghan shin, “Ẹnga nga oso ẹngọ, ana alalẹ?” Ọnwọ iwe lan la kọ kọ́ shin, “Imi nga inso ọYẹsọ anushin ngọ so kẹ ọnhuọ ọtrọ lẹ ẹnga. <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />Ẹngọ nyẹnya kẹ ngọ nyẹran ọmẹ ẹshan, kẹ ọnhuọ lan wọ enii utoo ngọ ọnkyẹ shin ngọ nii udu.” <verse eid="ACT 9:6" /><verse number="7" style="v" sid="ACT 9:7" />Onuse uson nga le mle wan ọpẹẹ wan, akọn iwe, tushin é shiǹ wan alọ wan. <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />Ọnwọ ọShawulu la nyẹnya, tushin lẹ shin òó kun edre e le mle ghan ushìn ọnlighẹ wan. ọklan wọ ana usee usoon nga la frẹ ghan ọnyẹ kẹ okon ghan ba lẹ ọDimashku. <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />Òó kon aywuẹ ataa, bọ e kẹ eshìn ma, bọ a kẹ aya wan, tuhuan bọ a kẹ ahyua wan. <verse eid="ACT 9:9" /><verse number="10" style="v" sid="ACT 9:10" />Tọ, eple ana ubi lẹ osoo kẹ ọDimashku, ana ọntua “ọHananiya!” Ekye abaan la pẹẹ lẹ ẹnga kẹ ọmẹ u nyin kawan ala, ka kọ ghan shin, “ọHananiya!” Ẹnga la huọ ukye ka kọ ghan shin, “Imi ngẹn! Ekye abaan.” <verse eid="ACT 9:10" /><verse number="11" style="v" sid="ACT 9:11" />Ọnnwọ Ekyee abaan la kọ ghan lẹ ẹnga shin, “Nyẹnya kẹ ẹngọ kpon kan ngọ lẹ ọntraan lan shin adrọ shin Ẹtẹtẹ, ẹngọ son kan lẹ abaan ọYahuda, kẹ ngọ so elue huọ eple ana ọTarsus,anga adrọ shin ọShawulu soo lẹn. Àá nglan, oso kẹ ọnhuọ ọpẹlọnọm kẹ ọnhuọ lan. <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />Kẹ ọmẹ unyin kawan ala èé shìn eple enyi ana ọntua ọHananiya àá nyẹran, àá traa ghan anyẹ onyunn sablọ ẹnga ywure kẹ ẹnga kon ushìn ẹhuọ.” <verse eid="ACT 9:12" /><verse number="13" style="v" sid="ACT 9:13" />Tushin ọHananiya le kyee ka kọ ghan shin, “Ekye abaan, imi huọ hyua ọkọọn ihyuu enyi lan kẹ ọnhuọ ada lapam kẹ aprẹn idrii ebebi shin àá huọ udu ana ọdẹdẹy kẹ Urushẹlima. <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />Àá nglan, òó kon ọdọ bikẹ ọnhuọ ákpẹ umee enshin kyẹ ọfrẹ ididu anushin àá dra ọntua ngọ.” <verse eid="ACT 9:14" /><verse number="15" style="v" sid="ACT 9:15" />Tushin Ekye abaan la kọ ghan Hananiya shin, “Ẹngọ dẹn, son kan, sablọ ẹnga enyi nga shin imi ewe kẹ otoo ada kẹ aprẹẹ ọntua mi sablọ ò too anushin o so wan aYahudawa wan, kẹ ágọn ma, kẹ ana Isrẹˈila. <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />Imi kẹ ẹkyuẹkyuẹ mi nii unyin nga ẹva shin enii ọhyua kẹ sablọ ọntuhuan mi.” <verse eid="ACT 9:16" /><verse number="17" style="v" sid="ACT 9:17" />Ọnwọ Hananiya lẹ okpon kan ka nyẹran abaan lan, kẹ atraa ghan anyẹn, tuhuan ka kọ ghan shin, “Ewedri mi ọShawulu, Ekyee abaan mi, ọYẹsọ, nga a tua mi, anushin e nyin ẹkyuẹ ghan kẹ ọnhuọ ọywua ngọ kẹ ọntran shin ẹngọ soon kọ. Àá tuan mi sablọ ẹngọ ywure kẹ ẹngọ kon ushìn ẹhuọ, tuhuan kẹ akuan ngọ lẹ Iri Ẹsẹẹ.” <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />Kẹladran, uple ọnlighẹ kawa ọmgba arẹvọn la kpaa bi kẹ ọmẹ iredre ọShawulu, e le ywure kẹ eshìn ẹhuọ. Tuhuan a ka nyẹnya, a lẹ odu ghan ọbaftisma. <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />Ọklan wọ, lẹ shin àá hurẹ ọya ọnkyẹ ọya, a le ywure kẹ okon ọdọ.</para>
  <para style="s" vid="ACT 9:19">ọShawulu kẹ uDimashku kẹ Urushalima.</para>
  <para style="p" vid="ACT 9:19">ọShawulu kon aywuẹ lapam kẹ apaduan lan kẹ uDimashku. <verse eid="ACT 9:19" /><verse number="20" style="v" sid="ACT 9:20" />Kẹ ẹlẹn izun, ala ta ẹkpa ulolo kẹ ọmẹn onkoo ọpẹlọnọm shin ọYẹsọ nga oso arẹn Ọnọm. <verse eid="ACT 9:20" /><verse number="21" style="v" sid="ACT 9:21" />Ididu anushin a kọọn ghan lẹ eshin ọvrọ, tuhuan kẹ elue shin, “Woo! Kyẹ enkyii lẹn nga nyaan ifuo kẹ Urushalima kẹ anushin a dra ọntua lẹn ma? Àá ba ghan lẹ ọnhuẹn kya wa fẹn ma ka kpọn ma kan lẹ ọnhuọ ana umee enshin alalẹ wan? ” <verse eid="ACT 9:21" /><verse number="22" style="v" sid="ACT 9:22" />Tushin ọdọ ọShawulu la frẹ ọkẹnmẹ huo ulon ubon ngang tuhuan la sọ aYahudawa ọba le trekpe kẹ uDimashku lẹ enyin shin ọYẹsọ nga oso uKristi.<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />Lẹ shin aywuẹ kpon, aYahudawa lẹ aklan akyuẹ kyẹ ọprẹ ọShawulu. <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />Tushin ọShawulu huọ kọn ihyuu ọnkyẹ shin o loo ke tighe. Ayahudawa kẹ otuo edre kẹ atigha ẹshan huọ ulon ubon nga wọ, otu kẹ aywuẹ, kyẹ unii ọShawulu kẹ ma prẹ. <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />tushin lẹ otu árẹn ọtuan nga la kpọn ghan, e le sri lẹ ẹnga kẹ uple ukpo atigha ọhyuẹ kẹ ẹgbọn ivre lan kẹ ọmẹ ẹnzẹn.<verse eid="ACT 9:25" /></para>
  <para style="s">ọShawulu Ywure Ghan Urushẹlima</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />Lẹ shin ọShawulu ywure ghan Urushẹlima, a la muọm ka nyẹran ọmẹ árẹn ọtuan, tushin ididu wan lẹ akọn ibun ghan, sablọ ẹma kpọn wan shin ẹnga àrẹn ọtuan nga ma. <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />Tushin ọBarnaba la kpọn nga kan lẹ ọhuọ apaduan kẹ o too wan emle shiin ọShawulu shìn Ekye abaan wọ kẹ ọntran, kẹ emle shin Ekye abaan pẹẹ lẹ ẹnga wọ, kẹ emle shin ọShawulu too ihyuu ishishi lẹ ọntua ọYẹsọ wọ kẹ ọDamashku, bọ ọkọọn ibun ma. <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />Ọnya kẹ ọnhuọ lan ọShawulu la frẹ ọnyẹran kẹ utro kẹ ẹma kẹ Urushẹlima, lẹ ololo ada lẹ ọntua ọYẹsọ bọ ibun. <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />A la frẹ ọpya onyun kẹ aYahudawa ana ọkọọn iHelenanci la ya ẹna kẹ ẹma, ọnwọ e le nii ọntraan kyẹ ọprẹ ghan. <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />Lẹ shin ana ubi kọn klan, ála kpọn ghan kan lẹ ọKaisariya, ka tuan kan lẹ ọTarsus. <verse eid="ACT 9:30" /><verse number="31" style="v" sid="ACT 9:31" />Ẹladran ya ada ana ubi ama ididu ọga ẹbọn ọyahudiya, kẹ ọGalili, kẹ ọSamariya, lẹ okon ọna ẹhurẹ. Ada ana ubi lẹ okon ọdọ ẹhurẹ lakẹnkan lẹ ọdọ iri ẹsẹẹ, lẹ akẹmmẹ lakẹnkan tuan kẹ afrẹ usoon kẹ ọmẹn ibun Ọnọm.<verse eid="ACT 9:31" /></para>
  <para style="s">UHENEAS KẸ ỌTABITA</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />Tọ, lẹ shin uBitrus klem kẹ ọga ẹbọn lan ledidu, ọnwọ a la tọ ọ kan lẹ ọnhuọ ana ubi lan shin á ywua kẹ uLidda. <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />Kẹ ọnhuọ lan àá klan kẹ eple enyi ana ọntua Iniyas, anushin à ywua kẹ ọnẹnẹn amẹ ananaa sablọ ẹnga ana ọhyuẹhyuọm nga. <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />Ọklan wọ uBitrus la kọ ghan lẹ ẹnga shin, “Iniyas, nyẹnya kẹ ẹngọn kan ọnkyẹ ọnẹn ngọ, ọYẹsọ ukristi à ma ngọ ọtrẹ.” Kẹladran Iniyas la nyẹnya. <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />Ididu ada a ma ọnshan uLidda kẹ a ma ọSharon à la huọ ushin Iniyas, anushin àá ba atrẹ, tuhuan e le kyem kan lẹ ọnhuọ Ekye abaan<verse eid="ACT 9:35" /></para>
  <para style="s">uBitrus Nyuọn ọTabita</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />Kẹ uYoffa, eple ana ubi anshẹ lẹ osoo, ana ọntua ọTabita, ana adrọ ghan shin uDokas. Anshẹ lan huọ ma ẹkyuẹ ghan ledidu kẹ ọmẹ udu ọtuhuan agyagyuan, kẹ umee agyuan. <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />Kẹ aywuẹ lan uloo la frẹ ghan a lẹ okpo ghan. Lẹ shin àá tram nga, a la ngẹn ẹgbẹna nga kẹ unkoo aprẹn. <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />uLidda so akaaka kẹ uYoffa, tuan ana ubi kọn shin uBitrus so kẹ uLidda, ọnwọ a la tuhuan ana ampua kan lẹ ọnhuọ ghan, kẹ a wa wan nga kẹ a ba lẹ ọnhuọ wan ladrẹndrọ. <verse eid="ACT 9:38" /><verse number="39" style="v" sid="ACT 9:39" />Ọnwọ uBitrus la nya kẹ o kpon kan ghan kẹ ẹma. Lẹ shin àá fuan, á la kpọn ghan kan lẹ unkoo aprẹn lan. Ididu ashẹ anushin ekyi wan huọ ukyure wan, a la tigha kẹ akaaka kẹ ọTabita, kẹ afrẹ ukyue, lẹ enyin ọngbapya kẹ uple ọnkyẹ shin udokas du wan atọ uhyu kẹ ẹma. <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />uBitrus le we wan kan lẹ etiin ledidu tuan a la ta ongbun ka pẹlọnọm. E le kyeem kan lẹ use ọkrọọ lan, ka kọ ghan shin, “ọTabita, nyẹnya. ọTabita le okun edre ghan,lẹ ushin èé shin uBitrus, ala nyuọm” <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />uBitrus la laa ọnyẹ ghan kẹ anyuọn ngan. Ọnwọ à la dra ana ubi, kẹ ashẹ shin ekyi wan e kyure wan, kẹ ama wan ọTabita kẹ ọrẹ ghan. <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />Ihyuu lẹ ogboom kẹ ididu uYoffa, ada lapam la kpọn Ekye abaan lẹ ẹhurẹ wan. <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />uBitrus la ywua aywuẹ lapam kẹ uYoffa, kẹ abaan eple ana udu ọtuan ẹtan ọnkyẹ tran, ọntua ghan ma uso uSiman.<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s">ọKoneliyus Tuan lẹ uBitrus</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />Kẹ ọKaisariya, eple enkyii soo a drọ ghan shin ọKoneliyus. Onsoja alalẹ ghan ana osoja uRoma. <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />Enga kẹ ana abaan nga kon ọdọọ Ọnọm tuhuan akọọn ibun nga. Àá ka laa ọnyẹ lakẹnkan kẹ ọnhuọ ma ada agyuan lẹ ẹhurẹ izun, tuhuan àá ka pẹlọnọm huọ ulon ubon nga wọ. <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />Kẹ uple ubon nga, lẹ ẹlẹn ọyẹra ẹtaa ẹn kẹ anlẹ, lẹ shin atuan Ọnọm ba lẹ ọnhuọ ghan kẹ ọmẹ unyin kawa ala, ka kọ ghan shin,“ọKoneliyus!” <verse eid="ACT 10:3" /><verse number="4" style="v" sid="ACT 10:4" />ọKoneliyus lẹ otuo ghan lẹ edre kẹ ọmẹ ọkọọn ibun ka kọ ghan shin, “Ekye abaan, unse wan?” Àtuan Ọnọm lan la kọ ghan lẹ ẹnga shin, “Ọpẹlọnọm ngọ kẹ agyuan shin ngọ kon udu ọ̀ọ́ fuan ẹmpakye Ọnọm, ọnkyẹ ọwán ma kẹ ọnhuọ ọywua ghan. <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />Tuan ada kan lẹ uYoffa kẹladẹn kẹ awa dra uSiman anushin adrọ shin uBitrus shin à ywua kẹ abaan uSiman ana udu ọtuan ẹtan kẹ onyun udrii. <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />A la kyuran kẹ ọnhuọ uSiman ana udu ọtuan ẹ́tan, anushin abaan nga so kẹ onyun udrin.” <verse eid="ACT 10:6" /><verse number="7" style="v" sid="ACT 10:7" />Lẹ shin àtuan Ọnọm shin òó too ghan aprẹẹ lan kpon kan ghan, ọnwọ ọKoneliyus la dra ágrẹn nga apua, kẹ eple onsoja ana ure Ọnọm kan bi kẹ ọmẹ anushin okon udu ghan ọtuan huọ ulon ubon nga wọ. <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />Lẹ shin àá hurẹ utoo wan huọ unse wan shin ọ ba ledidu, à la tuhuan ma kan lẹ uYoffa.<verse eid="ACT 10:8" /></para>
  <para style="s">uBitrus shìn unyi kawa ala</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />Kẹ ọnwa ubun, a kyẹ ọlàà erete ayuẹ, ágrẹn ọKoneliyus so kẹ ọmẹ uson, a la ba akaaka kẹ ẹshan lan, ọnwọ uBitrus la nya kan lẹ aprẹn unkoo sablọ ẹnga ma pẹlọnọm. <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />Ẹwọn la nya ọ lọ ghan tuhuan e nii ọnlighẹ kẹ ẹnga ya, tushin lẹ shin oso kẹ ọnhuọ udu ọnkyẹ ọya lan, ọnwọ e le shin unyin kawa ala ọnwọ Ọnọm. <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />Ọklan wọ imi e shin uple ọnlighẹ ukon usrom kawa unzen ọlọlẹ, ọla ba lẹ ọnhuọ ọywua mi bi kẹ aprẹn kẹ̀ àtuan wọ anang <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />Kẹ ọmẹ unzen lan, imi eshìn huọ ulon ute ẹnam nga soo kẹ ọmẹ nẹ. Ẹn yọ afran anang soo, kẹ ẹn yọ ọkẹkàn, kẹ arọnọ. <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />À la kọọn iple iwe shin, “uBitrus, nyẹnya kẹ ngọ wa kẹ ngọ ya!” <verse eid="ACT 10:13" /><verse number="14" style="v" sid="ACT 10:14" />Tushin uBitrus la kọ ghan shin, “Kay! Ekye abaan, imi sò taa tẹ ya mi uple ọnlighẹ ajajẹ kẹ ililue huọ ọ ma shin iywuro re wan.” <verse eid="ACT 10:14" /><verse number="15" style="v" sid="ACT 10:15" />E le ywure ka kọọn iwe ẹlẹn ẹmpuan, ẹ kọ wọ shin, “Ọnkyẹ shin Ọnọm plàn, kalẹ ngọ kọ ngọ lẹ ọma shin ọma ajajẹ wan.” <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />Ọmẹ̀n ba ka sọ ẹtaa, ọnwọ kẹladran unzen lan lẹ eywure wọ aprẹn. <verse eid="ACT 10:16" /><verse number="17" style="v" sid="ACT 10:17" />Ọshin uBitrus so kẹ ọmẹ ambẹn ẹhurẹ lakẹnkan huọ unse wan unyin kawa ala nyin ọnkyan, ọnwọ anushin ọKoneliyus tuan, lẹ enii ọnhuọ shin abaan uSiman soo wọ tuhuan kẹ àtigha kẹ átigha. <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />Tuhuan e lẹ luwe shin uSiman, anushin adrọ ghan shin uBitrus soo kẹ ọhuẹn nẹ. <verse eid="ACT 10:18" /><verse number="19" style="v" sid="ACT 10:19" />Lẹ ushin uBitrus hyu kẹ ọnwọ ọrẹn ẹhurẹ kẹ aprẹn unyin kawa ala lan, Iri Ọnọm la kọ ya lẹ ẹnga shin, “Ana antaa wẹn, o kon unii ngọ. <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />Nyẹnya, sri kẹ ẹngọ so kon wan, kalẹ ngọ soo lẹ ẹhurẹ ẹpua wan, kẹ imi nga ẹntuan ma.” <verse eid="ACT 10:20" /><verse number="21" style="v" sid="ACT 10:21" />Ọnwọ uBitrus le sri kan lẹ ọnhuọ ekyii lan, “Imi nga unu kon unii. Unse wan ukon unu ma?” <verse eid="ACT 10:21" /><verse number="22" style="v" sid="ACT 10:22" />Ọnwọ a la kọ wan shin, “Eple enkyii shin adrọ shin uKoneliyus, ana ukon ekye ọgraa osoja atẹlẹ ama uRoma nga tuan enyin. Ẹnga ana ẹplẹpan ghan, ana ọkọọn ibun Ọnọm, anushin ididu aYahudawa kon utoo ọnkyẹ agyagyuan kẹ aprẹn nga. Ọnhuọ ọywua ghan wọ atuan Ọnọm too ghan shin a tuan kẹ adra ngọ ma ba lẹ ọmẹ abaan ghan kẹ ẹnga ma kọọn ọnkyẹ shin ẹngọ ni utoo.” <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />Ọklan wọ uBitrus la ngrẹn ma ba lẹ ọmẹ abaan shin ẹnga ywua wọ. ka ma wan ọnhuọ ọna.</para>
  <para style="s" vid="ACT 10:23">uBitrus kan lẹ abaan uKoneliyus.</para>
  <para style="p" vid="ACT 10:23">Kẹ ọnwa ubun, a la nyẹnya kẹ okpon kan ghan kẹ ẹnga, eple ana ubi bi kẹ ẹshan ẹlẹlẹ uYoffa la ka kan nga wọ. <verse eid="ACT 10:23" /><verse number="24" style="v" sid="ACT 10:24" />Kẹ ọnwa ubun wọ a la fuan ọKaisariya. ọKoneliyus la sọ ẹhurẹ shin enii ọba, àá dra ewedri ghan ledidu kẹ onuse ghan. <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />uBitrus huọ ọnyẹran ọmẹ abaan lan wlan, ọnwọ ọKoneliyus la ngrẹ nga, kẹ akpaa kẹ ẹmpakye ghan, kẹ a dọọ ghan. <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />Ọnwọ uBitrus la frẹ ghan kẹ ọnyẹ kẹ anyuọn ghan, ka kọ ghan lẹ ẹnga shin, “Nyẹnya! kẹ imi enyetri ghan kawa ẹngọ.” <verse eid="ACT 10:26" /><verse number="27" style="v" sid="ACT 10:27" />uBitrus so kẹ ọnhuọ ọpya onyun kẹ ẹnga, wọ a la nyẹran kẹ o kon ada lapam klan. <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />uBitrus la kọ ghan lẹ ẹma shin, “Unu kẹ akyuakyuẹ unu za shin ọgbaa wọ shin ana aYahudawa klan àkyuẹ huọ a kan lẹ abaan ana shin osoo wan ayahudawa wan. Tushin Ọnọm nyin mi shin kalẹ imi dra alọ shin ana ililuwe wan. <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />Ọklan wọ, lẹ shin á tuan shin imi ba, imi a tran mi nga ma. Tọ, kẹladẹn imi nii ọza ọnkyẹ shin ọsọ unu a dra mi.” <verse eid="ACT 10:29" /><verse number="30" style="v" sid="ACT 10:30" />Ọnwọ ọKoneliyus lẹ ekye shin, “Aywuẹ anang shin òó kpon, kawa ẹn yẹn ẹlẹn nẹ, ẹlẹn ọyẹra ẹtaa ẹn kẹ anlẹ, imi o so kẹ ọnhuọ ọpẹlọnọm kẹ ọmẹ abaan mi, kẹ ẹlẹ izun, imi lẹ eshìn alọ tigha kẹ ẹmpakye mi. Ọnkyẹ shin àá shẹ ọma ọsaan ma lakẹnkan. <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />Enkyii lan la kọ ghan shin, ‘ọKoneliyus, á ngrẹ ọpẹlọnọm ngọ kẹ awán lẹ agyuan shin ẹngọ kon umee ana emrin. <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />Ọklan wọ, ngọ tuan kan lẹ uYoffa kẹ awa dra uSiman, anushin a ka drọ ghan shin uBitrus, àá kyuran kẹ abaan uSiman ana udu ọtuan ẹ́tan, anushin abaan nga so kẹ ayẹ udrin.’ <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />Ọnwọ ọsọ imi a tuan shin a dra ngọ kẹladẹn, ọgbaa lẹ shin ngọ a ba. Tọ, enyi mẹn ledidu enyi a klan kẹ ẹnpakye Ọnọm, kẹ enyi ngẹn atọn lẹ ididu ọnkyẹ shin Ekye abaan tuan shin ngọ ma otoo enyi.”<verse eid="ACT 10:33" /></para>
  <para style="s">Anushin O Soo Wan aYahudawa Wan Kọn Ihyuu Ishishi</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />Ọnwọ uBitrus la tẹkpa ọpya wan onyun ka kọ ghan shin, “Lẹ ẹplẹpan, imi akpẹẹ shin Ọnọm ka srẹẹ ghan ma. <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />Tushin a ka ngrẹn ididu ana ọkọọn ibun ghan kẹ ana udu ẹplẹpan kẹ huọ ilon ẹbọn nga wọ. <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />Unu za lẹ ọtuan shin àá tuan kan lẹ Israˈila, o kon wan ihyuu ishishi ẹn kẹ ọnaa ẹhurẹ kẹ ọnhuọ ọYẹsọ Ofwó, a nga oso Ekye abaan ọhuọ ẹnga. <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />Unu za emle shin ihyuu lan gboom kẹ ididu ọga ẹbọn ọYahudiya wọ, ọnkyẹ shin ọtẹkpa kẹ ọmẹ ọGalili, kẹ ititim utoo ihyuu ishishi ọbaftisma. <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />Emle shin Ọnọm ma ghan Iri Ẹsẹẹ, kẹ ọdọ. sablọ Ọnọm soo kẹ ẹnga, àá frẹ ukee lẹ o son odu ọtuan agyagyuan, la a mee ididu anushin ọShaitan maa wan ọtrẹ, sablọ Ọnọm soo kẹ ẹnga. <verse eid="ACT 10:38" /><verse number="39" style="v" sid="ACT 10:39" />Aprẹn ẹrẹ edre enyi yọ òó du ọnkyẹ lẹn ledidu kẹ ẹshan uJudiya kẹ Urushalima. Àá nga a huọ prẹ ghan lẹ ọsẹsra ghan kẹ aprẹn ekyi ọsẹsra. <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />Tushin Ọnọm nyuọ nga kẹ aywuẹ ẹntaan, kẹ asọ e nyin ẹkyuẹ ghan kẹ ọnhuọ ada. <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />Kyẹ ididu ọhuọ ẹnga nga e shìn ghan ma. Sẹ enyi apaduan nga shin Ọnọm we, enyi ma eshin ghan lẹ edre enyi, ana shin aya kẹ ahwua kẹ ẹ ngan lẹ shin àá nyẹnya bikẹ ọmẹn itun. <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />Tuhuan àá so enyi utoo ihyuu huọ ulon ọnhuọ ghan wọ, kẹ enyi too ẹplẹpan shin ọYẹsọ nga oso anushin Ọnọm we kẹ aprẹ ataan kẹ ọmẹn ana ọrẹ kẹ anushin ekyure wan. <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />Ididu onu otoo ẹplẹpan kẹ aprẹn nga shin kẹ ọnhuọ ọntua ghan ididu anushin àá kpọn ghan lẹ ẹhurẹ nii ukon uywuro onyun ilovro ghan.”<verse eid="ACT 10:43" /></para>
  <para style="s">A Ma Anushin O So wan aYahudawa wan Iri Ẹsẹẹ</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />uBitrus so kẹ ọnhuọ ọpya onyun wlan, ọnwọ Iri Ẹsẹẹ le sri kẹ aprẹn ididu anushin o so kẹ ọnhuọ kọn ọpya onyun nga. <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />aYahudawa ana ubi, anushin a ba kẹ uBitrus, shìn ọvrọ ushìn emle shin anushin o so wan aYahudawa wan ẹma ma huọ ukon agyuan Iri Ẹsẹẹ. <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />Sablọ á kọn o kon ọpya onyun lẹ ẹda kẹ ọntrọntọ, lẹ ablẹ Ọnọm. tuhuan uBitrus la kọ ghan shin <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />“Alọ soo shin enii ure shin odu ekyiwan nẹ ọbaftisma, kẹ ẹma ma huọ ukon Iri Ẹsẹẹ kawa emle shin enyi ma enyi a huọ ukon wọ?.” <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />Ọklan wọ uBitrus la ma onyun shin odu wan ọbaftisma kẹ ọmẹ ọntua ọYẹsọ Ofwó. Tuhuan uKoneliyus la wan nga kẹ aywua kẹ ẹma aywuẹ la hyuẹ.<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s1">uBitrus too ẹkyuẹ ghan kẹ ọnhuọ ada</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />Apaduan kẹ ewedri kẹ ididu ọYahudiya la kọọn shin anushin o soo wan aYahudawa wan ngrẹ Aprẹẹ Ọnọm. <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />uBitrus la nyaan kan lẹ Urushalima, ana ubi shin atàà wan untun la nighan nga, <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />shin, “Unse wan ọsọ ngọ a kan lẹ ọnhuọ anushin o soo wan aYahudawa wan, ka ya ọya kẹ ẹma” <verse eid="ACT 11:3" /><verse number="4" style="v" sid="ACT 11:4" />Ọnwọ uBitrus la tẹkpa utoo wan ladẹdẹy shin, <verse eid="ACT 11:4" /><verse number="5" style="v" sid="ACT 11:5" />imi o so kẹ ẹshan ẹlẹlẹ uYoffa kẹ ọnhuọ ọpẹlọnọm, ọnwọ imi e shin unyin kawa ala ọnwọ Ọnọm, imi e shin uple ọnlighẹ ukon usrom kawa unzen ọlọlẹ, shin usrom bi kẹ aprẹn kẹ àtuan anang nga, ọla ba lẹ ọnhuọ shin imi soo wọ. <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />Lẹ ushin imi otuo edre wọ, imi le shìn ẹ̀nam afraan anang ẹn ya ohun, edre lẹ unzen lan lakẹnkan, imi eshìn ẹnam ẹn yẹ afran anang, kẹ ẹnam onum, kẹ ẹn yọ ọkẹkàn kẹ arọnọ kẹ ọmẹ nẹ. <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />À la kọn iple iwe shin ẹ kọ wọ lẹ ẹnga shin, “uBitrus, nyẹnya kẹ ngọ wa kẹ ngọ ya.” <verse eid="ACT 11:7" /><verse number="8" style="v" sid="ACT 11:8" />Tushin imi la kọ mi lẹ ẹnga shin, “Kay! Ekye abaan, ọnlighẹ ajajẹ so ọnya wọ ọnyẹran ọmẹ onyun mi ma huọ ọ ma shin usoo wọ lẹ ilue emle shin iywuro too wọ wan.<verse eid="ACT 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 11:9" />“Ọnwọ iwe le kye bi kẹ aprẹn ka pẹẹ ka sọ ẹpua ka kọ wọ shin, ‘Ọnkyẹ shin Ọnọm plàn, kalẹ ẹngọ kọ ngọ lẹ ọma shin ọma ajajẹ.’ <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />Ọmẹ̀n ba ka sọ ẹtaa, tuhuan a la kpọn unzen lan kan lẹ aprẹn.<verse eid="ACT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 11:11" />“Tuhuan kẹ ẹlẹn na, ana antaa la atigha kẹ onyun atigha ẹn kẹ abaan shin imi so wọ, á tuan ma ba lẹ ọnhuọ mi bi kẹ ọKaisariya. <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />Ọklan wọ Iri la kọ ya lẹ imi shin, re wan kan, kalẹ imi nyin ẹtrẹtọ ẹma kẹ enyi ma. Ewedri ekyen lan la ka kàn mi, sẹ lẹ enyi anyẹran ọmẹ abaan enkyii shin àá tuan lẹ enyii lan. <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />Ọnwọ a la otoo enyi emle shin àtuan Ọnọm àá tigha kẹ ẹmpakye ghan wọ, la kọ ghan shin, ‘Ẹngọ tuan kan lẹ uYoffa kẹ a wa dra uSiman, anushin a ka kọ wan lẹ ẹnga shin uBitrus. <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />Ẹnga nii utoo ngọ ọtuan shin ngọ nii ukon ufwó kẹ ọnhuọ ọywua ghan, ẹngọ kẹ ana ọmẹ abaan ngọ ledidu.’<verse eid="ACT 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 11:15" />“Lẹ shin imi a tẹkpa ọpya wan onyun wlan, ọnwọ Iri Ẹsẹẹ le sri kẹ aprẹn ma, kawa emle shin i sri kẹ aprẹn enyi wọ kẹ ọtẹkpa. <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />Ọnwọ imi la wan lẹ aprẹẹ Ekye abaan, emle shin àá kọ ghan, ‘ọYohanna àá lẹ odu ọbaftisma lẹ ambrẹ, tushin unu lẹ Iri Ẹsẹẹ ya e nii udu unu ọbaftisma wọ.’ <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />Kẹ ọshin Ọnọm ma wan agyuan ute shin àá ma enyi, lẹ shin enyi a kpọn lẹ ẹhurẹ lẹ Ekye abaan ọYẹsọ owo, Ẹ́nga nga o so Imi shin imi tẹ mle ure Ọnọm udu ọnkyẹ shin ẹnga nii?”<verse eid="ACT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18" />Lẹ shin aYahudawa ana ubi a kọn klan, a la kpẹẹ wan ọnkyẹ utoo wan, ọnwọ á la blẹ Ọnọm la kọ wan shin, “Wo, kẹ anushin o soo wan aYahudawa wan Ọnọm ma wan ọntraan ọkpaa onyun ilovro kẹ ukon ọrẹ.”<verse eid="ACT 11:18" /></para>
  <para style="s">Ana ubi kẹ Antakiya</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />Kẹladẹn, anushin ovlom sablọ ọtrọ kẹ ọtrẹkyuẹ kẹ Istifanus lan la nyaan ẹbran usoon kan lẹ uFinikiya kẹ ọSayifurus, kẹ Antakiya, Lẹ o too aYahudawa aprẹẹ Ọnọm kẹ inzuwan. <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />Eple enyi ma kẹ ọmẹn ma bi kẹ ọSayifurus kẹ ọSayirin, lẹ okpo kan lẹ Antakiya ka frẹ ulolo eHelenawa lẹ otoo wan aprẹẹ Ekye abaan ọYẹsọ. <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />Ọdọ Ekye abaan soo kẹ ẹma, ada lapam kpọn lẹ ẹhurẹ tuhuan kẹ ywure wan ọnhuọ Ekyee Abaan. <verse eid="ACT 11:21" /><verse number="22" style="v" sid="ACT 11:22" />Ihyuu ọnkyẹ lẹn la fuan atọn Abaan Ọnọm kẹ uJerusalem, tuhuan ala tuan ọBarnaba kan lẹ Antakiya. <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />Lẹushin ọBarnaba fuan kẹ eshin ankpẹẹ ẹn ya esheshii Ọnọm, ala mọ tuhuan ka man wan ọdọ ẹhurẹ shin a tẹgha lẹ ẹplẹpan kẹ Ekyee Abaan lẹ ẹhurẹ izun. <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />Kẹ ọBarnaba ana ẹplẹpan nga, àá kuang lẹ Iri Ẹsẹẹ kẹ ọdọ ẹhurẹ. Ọnwọ ada a mà ọpam le kyem ba kan wan lẹ ọnhuọ Ekye abaan. <verse eid="ACT 11:24" /><verse number="25" style="v" sid="ACT 11:25" />Tuhuan ọBarnaba lẹ o kpon kan lẹ ọTarsus sablọ ẹnga ma enii ọShawulu. <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />Lẹ shin òó kón nga, a lẹ eywure lẹ ẹnga ba lẹ Antakiya. Òó kon amẹ ozun kẹ ọnhuọ ukyun ada lẹ ololo wan. Kẹ ọmẹn ẹshan ẹlẹlẹ Antakiya wọ a tẹkpa ọdra ana ure ofwó kan lẹ ọntua eKirista. <verse eid="ACT 11:26" /><verse number="27" style="v" sid="ACT 11:27" />Kẹ ẹn yẹn ẹlẹn nẹ ya wọ, eple ónu la ba lẹ Antakiya bi kẹ Urushẹlima. <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />Ana onzun kẹ ọmẹ ma, ana shin adrọ shin Agabus la nyẹnya ka tigha, kẹ apya onyun lẹ ọdọ Iri Ọnọm shin enii udu iple ẹwọn kẹ ohun ledidu. Ọmẹ̀n ba kẹ ẹlẹn udu ẹgọn ọKalaudiyus. <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />Ọklan wọ ana ubi lan la klan ákyuẹ shin ẹma tuan lẹ ọta anyẹ kan lẹ ewedri shin o so kẹ ọmẹ ọga ẹ bọn ọYahudiya, huọ ẹnga nga emle ọdọ ghan. <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />Ọnkyẹ shin ó du wẹn, á tuan ọBarnaba kẹ ọShawulu lẹ agyuan ma kẹ oson ama onokon ana ubi kẹ Urushalima<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s">uBitrus kram bi kẹ unkoo</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />Ẹladran yaa Agọn Iridus fẹn eple ana ubi, kyẹ unii ọtrọ lẹ ẹma. <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />Iridus sọ a la prẹ ọYakub, ewedri ọYohanna lẹ ọfaa ẹkyuẹ ghan. <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />Lẹ shin èé shìn aYahudawa kọn ushi ọnkyẹ shin ẹnga odu, ọnwọ a la huọ frẹ uBitrus. Ọnwẹn ba kẹ aywuẹ Ẹpan uBredi ọnwọ usoo wọ lẹ uYisti wan wọ. <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />Lẹ shin Iridus frẹ uBitrus, a la sọ ghan kẹ unkoo kẹ ányẹ osoja ọkọ lẹ ekyen kẹ a zọ ghan. Èé le nii ẹnga kon ghan ba lẹ ẹmpakye ada kẹ ẹnga ma e she ghan ebebi inshin Ẹpan ọkpẹn hurẹ ukpon. <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />Ọshin uBitrus so kẹ ọmẹ unkoo, ada ana ubi la nuam kẹ ọpẹlọnọm sablọ ẹnga. <verse eid="ACT 12:5" /><verse number="6" style="v" sid="ACT 12:6" />Otu shin Iridus nii shin ẹnga we uBitrus inshin ombun sha, uBitrus so kẹ uliloo lẹ íwe ọyẹra ẹpua, òó kon ọna nga kẹ erete osoja apua. Ana ọzọ unkoo tọ uso kẹ onyun atigha o kon ọzọ. <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />Bọ ihyuu, eple atuan Ekye abaan le nyin ẹkyuẹ ghan, uple ọsẹẹ la huọ saan kẹ aprẹn unkoo lan. Tuhuan atuan Ekye abaan lan la pya uBitrus kẹ ayẹ ka nyuọn nga, ka kọ ghan shin, “Nyẹnya ladrẹndrọ!” Ọnwọ iwe ọyẹra lan lẹ otro kẹ anyẹ uBitrus. <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />Àtuan lan la kọ ghan shin, “Ẹngọ shẹ ẹmgbapya ngọ , kẹ ngọ shẹ akpla ngọ.” A la huọ udu klan. Àtuan lan la kọ ghan lẹ ẹnga shin, “Shẹ ọnkyẹ ngọ kẹ ẹngọ re mi ma.” <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />Tuhuan uBitrus lẹ otro kẹ ere ghan kan, bọ àá za shin ọnkyẹ shin àtuan lan kon udu ẹplẹpan ya wan, àá kpọn shin unyin kẹ ọmẹ ala ọnwọ Ọnọm wọ ẹnga kon u shìn. <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />Lẹ shin aa sẹ ana ọzọ ama inzun kẹ ama ẹmpuan, a la fuan onyun atigha ọyẹra ẹn kẹ ọnyẹran ẹshan, atigha lan la huọ ukun ma kẹ ẹkyuẹkyuẹ kọ. Ọnwọ a lẹ otro. Á fuan onyun uple ọntran. <verse eid="ACT 12:10" /><verse number="11" style="v" sid="ACT 12:11" />Lẹ shin ẹkyuẹ uBitrus kun mi, a la kọ ghan shin, “Ẹladẹn nẹ imi a ma ẹplẹpan shin Ekye abaan nga a tuan àtuan nga kẹ awa we mi kẹ anyẹ Iridus, kẹ ididu ebebi shin aYahudawa é sem kẹ aprẹn ẹkyuẹ mi.” <verse eid="ACT 12:11" /><verse number="12" style="v" sid="ACT 12:12" />Lẹ shin uBitrus àá kpẹ klan, wọ a lẹ okpon kan ghan lẹ abaan ọMariyamu, eya ọYohanna anushin a ka kọ wan lẹ ẹnga shin ọMarkus, ọnhuọ shin ada a klan wọ lapam kẹ afrẹ ọpẹlọnọm. <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />Lẹ ushin uBitrus fuan atigha ozo lan kẹ ala kọ, agrẹn arẹn ashẹ ọmẹ abaan lan shin adrọ ghan shin uRoda, la ba ushìn huọ ẹnga nga nẹ. <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />Lẹ shin àá kpẹẹ iwe uBitrus, ala mọ, kẹ e ywure kan lẹ ọmẹ abaan bọ òó kun kọ wan, kẹ akaaka otoo shin uBitrus nga a kyẹẹn kẹ atigha ozo lan. <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />A la kọ wan lẹ ẹnga shin, “Ẹkyuẹ ngọ kye kọ!” Ẹnga faa a tọ nuam kọ shin àá nga. A tọ kọ wan shin , “Atuan Ọnọm ọzọ uBitrus nga!” <verse eid="ACT 12:15" /><verse number="16" style="v" sid="ACT 12:16" />uBitrus tọ ọnuam kọ kẹ ọkẹn atigha. Lẹ shin ó kun e le shìn ghan, a la frẹ kọn ọvrọ. <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />Tushin e le nyin ma amkpẹ lẹ ọnyẹ shin a fua, tuhuan a lẹ o too wan emle shin Ekye abaan we ghan bi kẹ unkoo wọ. A la huọ kọ ghan lẹ ẹma shin, “Unu too ọYakubu kẹ ewedri shin atọ ọmẹ̀n ọnlighẹ.” Tuhuan a la nya kẹ okpon kan ghan lẹ uple ọnhuọ. <verse eid="ACT 12:17" /><verse number="18" style="v" sid="ACT 12:18" />Lẹ shin oturombun sha, kyẹ arẹn ishim ya ẹnya kẹ erete osoja lan ma, kẹ aprẹn ọnkyẹ shin ọba uBitrus. <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />Lẹ shin Iridus nii nga bọ o kon ghan ma, ọnwọ a lẹ ovun kẹ ọnhuọ ana ọzọ, bọ o kon ghan ma, ala ma onyun shin aprẹ wan. Lẹ anyẹran kpon, Iridus la nya kẹ ọga ẹbọn ọYahudiya, kẹ o kpon kan ghan lẹ ọKaisariya kẹ awa okon aywuẹ apua kẹ ọnhuọ lan.<verse eid="ACT 12:19" /></para>
  <para style="s">Ukpo ọnwọ Iridus</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />Kẹ ẹlẹn na, Iridus so kẹ ọmẹ amua lakẹnkan kẹ ana ọTaya kẹ uSidon. Ọnwọ ana ọTaya kẹ uSidon la kyun akyuẹ wan kan lẹ ọnhuọ Iridus sablọ unii ọna ẹhurẹ. Á la huọ unii ọfra ititim uBilastus sablọ ekye ana udu agọn ẹgrẹn ghan. Tuhuan a lẹ o kpon kan wan lẹ ọnhuọ Iridus a la kẹ enii kẹ ẹma sem ọywua wan, kẹ́ ẹma kon ọgyuram lẹ ẹbọn agọn lan sablọ ọnkyẹ ọya wan. <verse eid="ACT 12:20" /><verse number="21" style="v" sid="ACT 12:21" />Lẹ ubon shin asọ unii usem lan wọ, Iridus la shẹ ọnkyẹ ghan ọma ẹgọn, ka ma wan ẹkyẹẹ. <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />Lẹ shin ọkla lan kọọn klan a la sa iwe shin “Unu a kọọn iwe Ọnọm lẹ! ẹn kẹn kyẹ iwe enyetri kọ wan” <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />Kẹladran, ọnwọ eple àtuan Ekye abaan la ba kawa la ghan kẹ eshe kẹ ẹbọn sablọ àá blẹ ghan Ọnọm ma. tuhuan igigun la aya ghan sẹ lẹ shin òó kpo ghan. <verse eid="ACT 12:23" /><verse number="24" style="v" sid="ACT 12:24" />Aprẹẹ Ọnọm la frẹ ọya ekye, lẹ igboom. <verse eid="ACT 12:24" /><verse number="25" style="v" sid="ACT 12:25" />Ọnwọ ọBarnaba kẹ ọShawulu le ywure bi kẹ Urushalima, lẹ shin a hua ọtuan shin a ma wan shin o du, a la huọ ba kẹ ọYohanna anushin akaaka kọ wan lẹ ẹnga shin ọMarkus.<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s">Atuan ọBarnaba wan kẹ ọShawulu</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />Ọmẹn Abaan Ọnọm kẹ Antakiya, Ónu kẹ Avua soo: ọBarnaba, kẹ uSimeyon anushin adrọ shin ọBaki,(etretri) kẹ uLushiyus bi kẹ ọSayirin, kẹ ọManayen, ana nya ọfuwọ kẹ Agọn Iridus, kẹ ọShawulu. <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />Lẹushin soo kẹ ọnhuọ ọdọọ Ekye abaan lẹ okon ọhyuọ, Iri Ẹsẹẹ la kọ ya shin,“Unu we ọBarnaba kẹ ọShawulu sablọ ọtuan shin imi a dra wan kẹ o du.” <verse eid="ACT 13:2" /><verse number="3" style="v" sid="ACT 13:3" />Lẹ shin a huọ hurẹ ukon ọhyuọ kẹ ọpẹlọnọm, a la dra ọBarnaba kẹ ọShawulu kẹ atraa wan anyẹ onyun esheshi, tuhuan ka sọ wan kẹ ọntraa.<verse eid="ACT 13:3" /></para>
  <para style="s">ọBarnaba kẹ ọShawulu kẹ uSayifurus</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />Ana ampua shin Iri Ẹsẹẹ sọ kẹ ọntraan lan, kpoon kan wan lẹ ọSalukiya ka kpẹẹn kan wan lẹ ọSayifurus kẹ ọmẹn ọkpa ambrẹ. <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />Lẹ shin a fuan ọSalamis, a la otoo ihyuu Aprẹẹ Ọnọm kẹ ọmẹ onkoo ọpẹlọnọm aYahudawa. ọYohanna huọ usoo kẹ ẹma lẹ e re wan wọ. <verse eid="ACT 13:5" /><verse number="6" style="v" sid="ACT 13:6" />O kpoon kẹ aprẹn ididu ẹbọn erete ambrẹ sẹ lẹ shin a fuan ọBafos. Ọnhuọ lan, ala okon anyahudawa ana ọswa ẹtra kẹ ònu ọntẹ shin adrọ shin ọBar Yẹsọ, <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />anushin òó soo kẹ uGwamna ọSarjiyus uBulus. uGwamna ọSarjiyus uBulus ana ẹkyuẹ ẹwan, ala tuan lẹ ọBarnaba kẹ ọShawulu sablọ àá byan ọ kọọn aprẹẹ Ọnọm. <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />Tushin Alimas, ana ọswa ẹtra lan, (sablọ ọnkyẹ shin ọntua ghan nyin wẹn) la tran ghan ọlaa wan tuhuan ka yẹ kẹ uwoo ẹhurẹ uGwamna lan sablọ kalẹ akpọn lẹ ẹhurẹ wan. <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />Ọnwọ ọShawulu shin adrọ uBulus la kuang lẹ Iri Ẹsẹẹ tuhuan kẹ otuo Alimas le dre kẹ ẹtẹtẹ ka kọ ghan shin, <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />“Engọ arẹn ẹsha ghan kẹ ofuo ididu ọnkyẹ shin uso ọma ẹplẹpan! Ẹngọ akuang lẹ itee uwu kẹ ebebi. Ulon ubon nga wọ Ẹngọ nii ọlaa ọbẹn ẹntran Ekye abaan wọ? <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />Kẹladẹn, ọnyẹ Ekye abaan kon udu ifuo kẹ ẹngọ, ẹngọ nii ukye ofuo tuhuan ẹngọ ni ọkpọn ẹlẹn bọ ẹngọ nii ushi ọsẹẹ Ọnọm ma.”</para>
  <para style="p" vid="ACT 13:11">Kẹladran, eywi kẹ itum lẹ afra ghan kan, a la frẹ ọbam mẹ lẹ enii anushin enii unyin nga ọntraan. <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />Lẹ shin ugbomna shìn ọnkyẹ shin ọba, ọnwọ a la akpọn lẹ ẹhurẹ ghan, sablọ èẹ shìn ọvrọ ulolo kẹ aprẹẹ Ekye Abaan.<verse eid="ACT 13:12" /></para>
  <para style="s">uBulus kẹ ọBarnaba kẹ uSBisidiya</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />Ọnya kẹ ọBafos, uBulus kẹ ana ọkaan nga wọ la kpẹẹn kẹ ẹmẹn ọkpa ambrẹ kan lẹ use uson ghan lan kpẹẹn ambrẹ kan lẹ ọferga ọnwọ ọFamfilia ọnhuọ shin ọYohanna laa wan kẹ eywure kan ghan lẹ Urushalima. <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />Ọnyan ọFerga, alẹ okpon kan wan lẹ uBisidiya ọnwọ Antakiya. Lẹ shin aywuẹ utrim ba, ala nyran ọmẹn unkoo ọpẹlọnọm kẹ atrẹtraa. <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />Lẹ shin ahurẹ ọpua iywuro uMusa kẹ azaa ónu, ana ukon ekyee unkoo ọpẹlọnọm la tuan kan lẹ ẹma shin, “Ewedri, inshin unu soo lẹ iple ẹkyẹẹ shin unu nii ọma ada, kikunu, unu pẹ̀ẹ̀ kẹ ẹladẹn.”<verse eid="ACT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16" />Lẹ ọnyẹnyaan uBulus, ala sa anyẹẹn ka aprẹn ka kọ ghan shin: “Ekyii ana Israˈila kẹ Unu ana shin osoo wan ayahudawa wan shin okon ọdọọ Ọnọm, ngẹn atọn lẹ imi! <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />Ọnọm ana Isra'ila we ákpẹẹ nyi; kẹ asọ olo kon ọkaan ekyee ẹlẹn ọywua wan kẹ ọMasar, lẹ ọdọ ọlọlẹ èé we wan bikẹ ọmẹn ẹbọn lan. <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />Àá sọ ambrẹ ọrang kẹ ọmẹn ẹhurẹ ghan kẹ ẹma amẹẹ ẹhuẹ ẹnang kẹ ọmẹn ifonum, <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />Àá pẹẹ ọmbọn utumpua kẹ ọKanˈana tuhuan kẹ ama enyin ghan ana Isra ila ọkà lẹn. <verse eid="ACT 13:19" /><verse number="20" style="v" sid="ACT 13:20" />Ididu ọnkyẹ lẹn ọkpọn amẹẹ shin àá fuan atẹlẹ ọkọ la nang lẹ ẹhuẹ itong.</para>
  <para style="p" vid="ACT 13:20">“Ọnyan ọnwlan, Ọnọm la ma wan ana ọprẹ ataan kan lẹ ẹlẹn onu ọSamaˈila. <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />Ana Isra ila wan Ọnọm agọn, Ọnọm la ma wan ọShawulu arẹn uKish, ana ọnyẹẹn ọBenyamin, ana ushin òó du ẹgọn amẹẹ ẹhuẹ ẹnagh. <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />Lẹ shin Ọnọm uwee ọShawulu, a la sọ ọDawuda le kyee agọn ma. Ankpẹẹ shin òó too kẹ aprẹn ghan: ‘Imi okon ọDawuda arẹn uYesse, enkyii shin àá kpam kẹ ẹhurẹ; enii udu ọnkyẹ shin imi nii odu.’<verse eid="ACT 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 13:23" />“Bi kẹ ọnyẹẹn enkyii lẹn ọnwọ Ọnọm ma ana Isra'ila ofuwo wọ, ọYẹsọ, kawa emle shin àá kpaa onyun wọ. <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />ọYẹsọ ba lẹ ọba, ọYohanna huọ utoo ada shin akpaa ilovro wan tuhuan kẹ o du wan ọbaftisma. <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />Lẹ shin ọYohanna kyẹ ọhurẹ ọtuan nga, e le lue wan shin, ‘Ẹ ngá nga osọ imi? kyẹ imi nga insọ ẹnga ma, tushin alọ kyaan kẹ ititim mi, ọnwọ shin huọ iwe ọfran akpla ghan imi sọ ọnya mi ọmẹ uble lẹn ma.’<verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />“Unu ewetri mi, arẹn Ibrahim kẹ unu ana so lẹ ibu Ọnọm shin kyẹ aYahudawa wan ma, enyi ma a tuan enyi lẹ ihyuu owo lẹn. <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />Ana Urushelima kẹ ana ukon ekyee wan so nyan ma ọkpẹ shin a nga oso ana ofwó shin Ọnọm tuan kẹ awa ofwó enyi ma, ba akpẹẹ aprẹẹ shin ónu too kẹ aprẹn nga ma shin apuwa kẹ aywuẹ utrim. Tushin ala kpaa onyun shin ẹma sra ọYẹsọ. <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />Kẹ ushin o kon wan ẹ ghan lẹ uvro shin ẹ tẹ asọ aprẹ ghan ma, a wan kẹ a wan uBilatus shin a prẹẹ ghan. <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />Lẹ ushin ahurẹ udu ọYẹsọ ididu ọnkyẹ shin a rẹn arẹn kẹ aprẹn ghan wọ, e le srii lẹ ghan bi kẹ aprẹn ekyi ọsẹsra lan, kẹ a sọ ghan kẹ ọmẹ itun. <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />Tushin Ọnọm nyuọn ghan bi kẹ ọmẹ itun, <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />aywuẹ la pam, èé nyin ẹkyuẹ ghan kẹ ọnhuọ anushin osoon kẹ nga kan lẹ Urushalima bi kẹ ọGalili, anushin ama oso ankpẹẹ ghan kẹ ọnhuọ ada kẹ ẹladẹn.<verse eid="ACT 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 13:32" />“Enyi kon utoo unu ihyuu ishishi: shin Ọnọm kpaa akpẹẹ enyi onyun, <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />Àá kuan ọnkyẹ lẹn kẹ ọnhuọ ọywua enyi, arẹn ma, lẹ ushin àá nyuo ọYẹsọ emle shin arẹn kọ kẹ ọmẹn ọzabura ọnwọ ẹmpuan:</para>
  <para style="q1" vid="ACT 13:33">“ ‘Ẹngọ arẹn mi nga,</para>
  <para style="q2" vid="ACT 13:33">ubin imi ekyee ekye ngọ.’<verse eid="ACT 13:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 13:34" />Ọnọm nyuọn ọYẹsọ bi kẹ ọmẹ itun shin kalẹ asha ghan ma, arẹn kẹ ọmẹn ẹnrẹn kẹn:</para>
  <para style="q1" vid="ACT 13:34">“ ‘Imi inii ọma unu onyun esheshin ẹn kọ ẹsẹẹ shin imi a kpaa ọDawuda onyun.’<verse eid="ACT 13:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="ACT 13:35" />Tuhuan eywure kẹ arẹn kẹ uple ọnhuọ shin:</para>
  <para style="q1" vid="ACT 13:35">“ ‘Ẹngọ nii ngọ ọlaa ana ẹsẹẹ ngọ ka a sha ghan ma.’<verse eid="ACT 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 13:36" />“Lẹ shin ọDawuda huọ hurẹ udu ọtuan shin Ọnọm ma ghan kẹ ẹlẹn nga, a la okpo ghan, a la lọọ ghan kẹ ákpẹẹ ghan, ẹkpẹnaa ghan la shaa ya. <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />Tushin ọYẹsọ shin Ọnọm nyuọn ghan bi kẹ ọmẹ itun, ẹgbẹnaa ngan sha yaa wan.<verse eid="ACT 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 13:38" />“Sablọ klan unu ewetri mi, imi nii shin unu za shin kẹ ọtra ẹkyuẹ kẹ ọYẹsọ ọnwọ ọsọ enyin okon uhuro ilovro. <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />U bi kẹ ọnhuọ ọ ywua ghan ididu anushin a kpọn ghan lẹ ẹhurẹ ghan nii ukon uhuro ididu ilovro wan, ọnkyẹ shin iywuro uMusa mle wọ udu wan <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />Sablọ klan unu du lẹ inshin, kalẹ ọnkyẹ shin Ọnọm too kẹ ọmẹ azaa ónu wa ba lẹ unu ma,<verse eid="ACT 13:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41" />“ ‘Unu gnẹn atọn unu ana ọkrọọ ada!</para>
  <para style="q2" vid="ACT 13:41">unu shìn ọvrọ, unu kpo unu, ọvrọ,</para>
  <para style="q1" vid="ACT 13:41">kẹ imi nii udu ọnlighẹ ọvrọ kẹ ọmẹn ẹlẹn ẹn yẹ unu</para>
  <para style="q2" vid="ACT 13:41">ọnwọ shin huọ alọ too unu,</para>
  <para style="q2" vid="ACT 13:41">unu nii unu ọkpọn lẹ ẹhurẹ wan.’ ”<verse eid="ACT 13:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />uBulus wan kẹ ọBarnaba kyẹ utro kẹ ọmẹ unkoo ọpẹlọnọm, ada la wẹn ma shin eywure ka wan pẹẹ lẹ ẹma ika aprẹẹ ọnkyẹ lan ika aywuẹ utrim aYahudawa ẹnkẹ ẹkyan. <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />Lẹ shin ada huo vlum, aYahudawa lan pam, kẹ eple enyi ma shin a nyra ubi aYahudawa lẹ ẹplẹpan, lẹ re uBulus kẹ ọBarnaba wa kan, anushin apee lẹ ma, ka sọ wan ẹhurẹ ẹdọ kẹ afrẹ udu ọnkyẹ agyagyuan kẹ ọmẹ aprẹẹ Ọnọm.<verse eid="ACT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />Lẹ shin eple aywuẹ utrim la aba, ididu ana ẹshẹn na lawa klan kọ kọn aprẹẹ Ekye abaan. <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />Tushin aYahudawa shi idrii ada lapam,a la afrẹ udu ifuwo lakẹkan, a la frẹ ọpya onyun ifuo kẹ aprẹn uBulus shin o kon utoo aprẹẹ Ọnọm kẹtrẹtrẹ.<verse eid="ACT 13:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="ACT 13:46" />Tushin uBulus kẹ ọBarnaba lan piya onyun bọ ibun, ka kọn wan shin, “Unu aYahudawa wan enyi atẹkpa utoo unu ẹtọprẹẹ Ọnọm. Tushin unu atran unu ẹyọ, kẹ e nyin shin unu nii unu ọtrẹ wan ọnwọ ọsọ enyi nii ukpoo kan wan lẹ ọnhuọ anushin oso wan aYahudawa wan. <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />Sablọ ọnkyẹ shin Ekyee abaan too enyi onyunu shin,</para>
  <para style="q1" vid="ACT 13:47">“ ‘Imi huọ ọsọ ẹngọ ukye ọsẹẹ kẹ ọnhuọ anushin oso wan aYahudawa,</para>
  <para style="q2" vid="ACT 13:47">sablọ unu kon ufuwo kan lẹ igbo ohun.’ ”<verse eid="ACT 13:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />Lẹ shin anushin a so wan aYahudawa wan la kọn klan, a la kọn ushi lakẹkan, a la adọọ ọprẹ Ekye Abaan. Anushin e we shin o kon ọrẹ bi igbo a la ma ẹhurẹ wan.<verse eid="ACT 13:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49" />Aprẹẹ Ekye Abaan la afrẹ ọkẹmmẹ huọ ulon ọnhuọ ghan kẹ ididu ẹbọ na. <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />Tushin aYahudawa la sẹn eple ashẹ shin oso lẹ ibun Ọnọm, anushin eshìín ma la rọmdọ, kẹ aple ana adradọ ẹshan na. A la maa uBulus kẹ ọBarnaba, kẹ e re wan kẹ ẹshan ma. <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />uBulus kẹ ọBarnaba la akpan unywui afran ma kyẹ unyin ankpẹ kẹ aprẹn ana ẹshan na, tó okpon kawan lẹ Ikoniya. <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />Apaduan la kuang lẹ ọkọọn ushi tuhuan kẹ Iri Ọsẹẹ.<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s">uBulus kẹ ọBarnaba kẹ Ikoniya</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />Kẹ Ikoniya, uBulus kẹ ọBarnaba la nyẹran ọmẹ unkoo ọpẹlọnọm aYahudawa emle shin a kẹ udu wọ. A lẹ otoo aprẹ Ọnọm lakẹnkan, idri ada lapam, aYahudawa kẹ anushin oso wan aYahudawa wan, la kpọn lẹ ẹhurẹ. <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />Tushin aYahudawa shin a tran ma ọkpọn lẹ ẹhurẹ, la sẹn anushin kyẹ aYahudawa wan ma lẹ abẹn ma kẹ ewedri wan ana ubi. <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />uBulus kẹ ọBarnaba ywua kẹ ọnhuọ lan lakẹnkan, kẹ afrẹ utoo aprẹẹ Ọnọm bọ ibun lẹ ọdọ Ekye Abaan. Ekye Abaan la ma wan ọdọ udu ọnkyẹ ọma ovrọ. <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />Tushin ana ẹshan ẹlẹlẹ lan la kam mi ẹgba ẹpua, ama enyi ma la fraa aYahudawa ititim, ama enyi tọ ọfraa arẹn apaduan lan ititim. <verse eid="ACT 14:4" /><verse number="5" style="v" sid="ACT 14:5" />Ana shin oso wan aYahudawa wan kẹ aYahudawa, kẹ ana ukon ekye wan lẹ e nii emle shin ẹma nii ọtrọ lẹ apaduan lan tuhuan kẹ ma tlẹ wan lẹ ọntrẹtra. <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />Lẹshin arẹn ọtuan na la kọn kla, a la nya wan kawan lẹ uListira kẹ ọDarbe, ọnshan ọndrọndọ kẹ uLikoniya. <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />Ọnwlan ala afrẹ udu ọtuan ihyuu ishishi. uBulus du ọtuan kẹ uListira <verse eid="ACT 14:7" /><verse number="8" style="v" sid="ACT 14:8" />Kẹ uListira, eple enkyi soo ogun ghan, a so ọnya uson ma kyuwo emle shin obyọ ghan wọ. Àá trẹtra, okon ọgnẹn aton lẹ ulolo uBulus. uBulus la afrẹ ushi ghan. Lẹ shin uBulus shin kẹ oko á kpọn lẹ ẹhurẹ ghan shin a to ukon ọtrẹ, <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />òó so kẹ ọnhuọ ọngẹn atọn lẹ utoo ihyuu ishishi uBulus. Ọnwọ uBulus le she ghan edre. Lẹ shin uBulus shìn shin enyi na so lẹ ọdọ ẹhurẹ shin a ta ma ghan ọtrẹ, <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />a la kọ ghan lẹ ẹnga shin, “nyẹnya kẹ ẹngọ tigha la afran ngọ.” Kẹ ẹladẹran, enkyi lan la nyẹnyan kẹ afrẹ uson. <verse eid="ACT 14:10" /><verse number="11" style="v" sid="ACT 14:11" />Lẹ shin idri ada lan eshìn ọnkyẹ shin uBulus du, ala sa unwe kẹ ẹlẹn izun lẹ otoo lẹ ẹda uLikoniya,“ẹnọm ba la enyi kawan enyitri!” <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />Ala frẹ ọtrọ ọBarnaba shin Zeyus, atọ kawan lẹ uBulus shin Hermes, sablọ shin angọ oso ẹkyuẹ ọpya onyun. <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />Akpẹẹ ẹnọm ẹnyọ ọZeyus, ẹngọ shin unkoo ẹnọm ghan so kẹ ititim eshan, ala okon ẹlau kẹ ẹgọọ ghan bi ka anya atigha ẹshan. Agọn ẹpan kẹ ada byọ oso apaduan lan ẹpan. <verse eid="ACT 14:13" /><verse number="14" style="v" sid="ACT 14:14" />Lẹ shin uBulus kẹ ọBarnaba wan kọọn klan, e le gree ọnkyẹ wan tuhuan kẹ nyẹran kawan lẹ ọmẹ idri ada la, la sla unwe la kawan shin, <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />“ọnse wọ ọsọ unu kon udu kẹn? Enyi enyitri wan kawan inu, enyi aba utoo unu ihyuu ishishi wọ, sablọ shin unu laa ọnkyẹ ililu na kẹ unu re Ọnọm kan, anushin òó du ohun kẹ ẹbọ, kẹ ungoo kẹ ididu ọnkyẹ shin usoo kẹ ọmẹ<note caller="+" style="f"><char style="fr" closed="false">14:15 </char></note> nga <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />Kẹ ikikiwo ala laa ada la odu ọnkyẹ shin ẹma bya udu. <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />Tushin àá laa ghan ẹkyuẹ ghan bọ ankpẹẹ wan: sablọ shin àá kẹ odu ọnkyẹ agyagyuan àá ka ma unu ẹvra bi kẹ aprẹmẹn kẹ ẹkrọọ ẹnkọ onyun esheshii. a ka man unu ọnkyẹ ọya kẹ ẹlẹn ishishi, tuhuan akaaka sọ unu ọkọọn ushi.” <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />Kẹ ọmprẹẹ shin o too wan, e mle wan ure ihwii ada lan ọma enshin Lẹ didu kẹ ọmẹ ọnprẹ lẹ ula oso ọnaa lẹ shin ale ere ada sowan ẹpan. <verse eid="ACT 14:18" /><verse number="19" style="v" sid="ACT 14:19" />Tuhuan eple aYahudawa la ba bi kọ Antakiya kẹ Ikoniya ka wan owu idri ada la, tuhuan ka atle uBulus, tuhuan ka woo ghan kalẹ ititim ẹshan, le mle shin okpoon ghan. <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />Tushin ana ubi le kee ghan kan, ala nyẹnyaan kẹ ywure ghan kan lẹ ọmẹn ẹshan lan. Ala ba ọnwa ubun, ala kpọn kan ghan lẹ uDarbe ẹma kẹ ọBarnaba. UHYIRE KAN LẸ ANTAKIYA KẸ ẸBỌN USIRIYA. <verse eid="ACT 14:20" /><verse number="21" style="v" sid="ACT 14:21" />Lẹ ushin uBulus kẹ ọBarnaba kẹ odu ọtuan utoo ihyuu ishishi kẹ uDarbe, ala oko apaduan lapam, e le hyire wan uListira, kẹ Ikoniya, tuhuan ka akpọn Antakiya ẹngọ uBisidiya. <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />Ala afrẹ ọma ana ubi ẹhurẹ ẹdọ, ka afrẹ ọma wan ẹkyẹ shin atigha lẹ ọdọ kẹ ama ẹhurẹ wan. lẹ otóó shin, “Sẹn enyi ahwua ẹva lakẹnkan tuhuan ẹnta nyẹran ẹgọn ọmẹ Ẹgọn Ọnọm.” <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />uBulus kẹ ọBarnaba wli onokon kẹ uhuọ ulon unkoo ọpẹlọnọm nga wọ, a pẹẹ lẹ Ọnọm kẹ okon ọhyuọ sablọ ẹma tuhuan kẹ aso wan kẹ anyẹ Ekye Abaan anga shin ẹma kpọn lẹ ẹhurẹ wan. <verse eid="ACT 14:23" /><verse number="24" style="v" sid="ACT 14:24" />Lẹ shin o kpoon kẹ ọmẹn uBisidiya, ala ba lẹ ọmẹn ọFamfiliya. <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />Lẹ shin otoo aprẹẹ Ọnọm kẹ uFerga, ala okpon kan wan lẹ Antaliya. <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />Ọnyan kẹ Antaliya, ala nyẹran ọkpa ambrẹ kẹ ehwure wan kan lẹ Antakiya, ọnhuọ shin a wan Ọnọm sablọ ẹma kon ọsẹẹ Ọnọm kon aklọn lẹ ẹma kẹ ọmẹ ọtuhuan shin anyẹn kẹ ọ huọ ọhurẹ. <verse eid="ACT 14:26" /><verse number="27" style="v" sid="ACT 14:27" />Lẹ shin afuan, alẹ otun ada ana ubi kẹ otoo wan ididu ọnkyẹ shin Ọnọm du kẹ ọhuọ hyua wan, ka kpọn emle shin okon anushin kẹ aYahudawa wan ma kẹ ọntra ọma ẹhurẹ wan. <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />Ala pya ọywua kẹ ọnhuọ lan kẹ ana unu ubi la lakẹnkan.<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s">Ọklan Onokon UBI KẸ URUSHALIMA</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />Eple enyi ma srom ba lẹ Antakiya bi kẹ ọga ọYahudiya kẹ afrẹ ulolo ana ure Ọnọm kan, la otoo shin, “Inshin ataa wan unu untu kawan emle shin ihwuro uMusa so ọwan,unu ni unu ukon ofuwo wan.” <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />uBulus kẹ ọBarnaba la afrẹ ọnya ẹna la kẹnkan kẹ ekyiwan lan kẹ aprẹẹ lan. A la asọ uBulus kẹ ọBarnaba ka akpọn eple enyi ma kẹ oson kan lẹ Urushalima kẹ ọhuọ apaduan kẹ onokon kẹ a sa trẹtra kẹ aprẹẹ lan <verse eid="ACT 15:2" /><verse number="3" style="v" sid="ACT 15:3" />Ana ukon ekyee Abaan Ọnọm la kaan ma, ana okpon kawan, ala okpon kẹ ọga ẹbọ ọFanikiya kẹ Samariya, la ama ihyuu emle shin ana osoo wan aYahudawa wa ma ẹhurẹ wan. anyẹn la asọ ididu ana ure Ọnọm kan la okon ẹhurẹ ishishi lan kẹnka. <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />Lẹ shin afuan Urushalima, ididu ana ukon ekyee Abaan Ọnọm kẹ Apaduan kẹ onokon ana ure Ọnọm kan la sọ wan oshon. uBulus kẹ ọBarnaba la otoo ọnkyẹ shin Ọnọm du kẹ ọtra ẹkyuẹ wan.<verse eid="ACT 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 15:5" />Tushin eple ana ure Ọnọm kan kẹ eple aFarisiyawa la tigha kẹ otoo shin, “Ọdọ wọ ataa anushin asawan aYahudawa wan untu tuhuan ka sọ wan kẹ ere ihwuro uMusa kan lẹ ọdo.” <verse eid="ACT 15:5" /><verse number="6" style="v" sid="ACT 15:6" />Apaduan kẹ onokon la klan sablọ aprẹẹ lan. <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />Lẹ shin a ywua kẹ huọ ọya ẹna la kẹnkan, uBitrus la nyinyan kẹ apẹẹ lẹ ẹma shin, “Unu ewedri mi, unu za bi kẹ ikikiwo Ọnọm we mi kọn ọmẹ unu, shin ọtra ẹkyuẹ kẹ imi wọ anushin sawan aYahudawa wan nii ọkon ihyuu ishishii wọ, tuhuan ka ma ẹhurẹ wan. <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />Ọnọm, anushin aza ẹhurẹ huọ nga nyin shin ẹ nga ngrẹn ma lẹ shin àá ma wan Iri Ẹsẹẹ, e le emle shin a ma nyi. <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />Tuhuan enyi nga ẹtrẹtọ kẹ ọmẹn enyi kẹ ẹma ma, tuhuan o hwulo ẹhurẹ wan lẹ ọkpọn lẹ ẹhurẹ wan. <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />Kẹladẹn, unse wan ọsọ unu so kẹ ọnhuọ umle Ọnọm kẹ ọnhuọ uden Apaduan lẹ ọkpọn, ihwuro shin enyi kẹ akpẹẹ enyi mle wan ọkpọn ma? <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />Tushin enyi ama ẹhurẹ enyi shin bi kẹ ọhuọ eshishii Ekyee Abaan ọYẹsọ wọ enyi ko ufuwo wọ. kawan ẹma.” <verse eid="ACT 15:11" /><verse number="12" style="v" sid="ACT 15:12" />Ididu idri ada lan ngrẹn la hyẹn, ka ngẹn atọọ lẹ oBarnabas wan kẹ uBulus lẹ shin osoo kẹ uhuọ utoo ihyuu kẹ ọnkyẹ ọma ọvrọ shin Ọnọm du kẹ tra ẹkyuẹ kẹ ma kẹ ọmẹ anushin osoo wan aYahudawa ma. <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />Lẹ shin a huọ hurẹ ọpya ohyu, ọYakubu la kọn ghan shin, “Unu ewedri mi, unu gnẹn imi atọọ. <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />ọSiman la ma onyun emle shin Ọnọm ọtẹkpa unyin ọbyan kẹ ọnhuọ anushin osoo wan aYahudawa wan emle shin èé wli eple enyi ma kẹ ọmẹ anushin osoo wan aYahudawa wan kẹ ekyèè ama ngan. <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />Aprẹẹ ónu lẹn kpaa kan emle shin ala rẹn wọ kẹ ọmẹ ọzaa Ẹgọn,<verse eid="ACT 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16" />“ ‘Anyẹn ma ọhurẹ ukpon, imi nii uywure</para>
  <para style="q2" vid="ACT 15:16">kẹ imi vran unshin ọDawuda shin akpau.</para>
  <para style="q1" vid="ACT 15:16">Ukye ẹbẹn wọ imi nii uywure kẹ imi vran kọ</para>
  <para style="q2" vid="ACT 15:16">kẹ imi kye kọ aprapra.<verse eid="ACT 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17" />Tuhuan anushin atọ ni unii Ọnọm</para>
  <para style="q2" vid="ACT 15:17">kẹ ididu anushi osoo wan aYahudawa wan shin akaaka drawan lẹ ọntua mi,</para>
  <para style="q1" vid="ACT 15:17">utoo Ekye Abaan, anushin òó du ọnkyẹ lẹn’<verse eid="ACT 15:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ACT 15:18" />shin aza bi kẹ ikikyuwo.<verse eid="ACT 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />“Oprẹẹ atan mi wọ shin ka lẹ unu maa ọywua ekyiwan lẹn shin e kyeem ba wan lẹ ọnhuọ Ọnọm lẹn ma. <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />Tuhuan enyi rẹn kẹ enyi too wan shin, kalẹ aya ọnkyẹ ọya shin ama ẹnọm ma, tuhuan kalẹ odu ililu wan, ka lẹ aya ọnlẹghẹ ẹdraa shin ẹpye wọ ọntọn wan, huọ ẹnam shin ẹsa yaa lẹ eji wan tuhuan ka lẹ aya eji wan. <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />Avua ulolo iywuro uMusa kẹ ọhuọ ulon ẹshan nga wọ kon ulolo ada kẹ ọmẹn unkoo ọpẹlọnọm kẹ aywuẹ utrim.”<verse eid="ACT 15:21" /></para>
  <para style="s1">Ọzaa Shin A Rẹn Ana Shin Osoo Wan Ana Ubi Wan</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />Apaduan kẹ onoko ana bi kẹ ididu ana bi la kọn wan shin, ọgbaa enyi we alọwan kẹ ọmẹ unu, ka tuan ma kalẹ Antakiya kẹ uBulus kẹ ọBarnaba. Tuhuan e le we ọYahuda,anushin akaaka kawan lẹ ẹnga shin ọBarsaba, kẹ ọSila, ekyii apuwa anushin okon ekyee wa ko ọmẹ ana bi. <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />Ana tuan ma nẹ ọzaa shin:</para>
  <para style="pmo" vid="ACT 15:23">Enyi ewedri unu Apaduan kẹ onoko ana ure Ọnọm kan,</para>
  <para style="pmo" vid="ACT 15:23">Kalẹ ọnhuọ ana ure Ọnọm kan amushin ọnyẹ ma kyẹ aYahudawa wa ma, kẹ Antakiya kẹ ẹbọọ uSuriya ka kpọn uKilikiya.</para>
  <para style="pmo" vid="ACT 15:23">Enyii so unu ẹja.<verse eid="ACT 15:23" /></para>
  <para style="pm">
    <verse number="24" style="v" sid="ACT 15:24" />Enyii akọn ihyuu shin eple nyi ma kẹ ọmẹ nyi tro bọ lẹ ọza enyi ma lẹ osoo apiya unu ẹhurẹ kọ ọmẹ ulolo wan, la son uyiyri, tushin enyii ma wan ẹma onyun udu klan ma. <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />ọnwọn sọ enyii huọ tritra inyi na shi uso ka gyagyuan enyii we alọ wan kẹ enyi tuan unu nẹ ma, ọBarnaba kẹ uBulus anushin onusee enyi ma, <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />anushin ama ọrẹn wan sablọ ọtuan Ekyee Abaan nyi ọYẹsọ òfuwo. <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />Ọnwọ sọ enyi tuan unu ọYahuda kẹ ọSila.Ẹma nii otoo nu ọnprẹ lan shin enyi arẹ lẹ onyun ma. <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />Uso kẹ agyagyuan kẹ ọnhuọ Iri Ẹsẹẹ kẹ ọnhuọ enyi shin, kalẹ asọ unu eple akpọn kẹ asrẹ ọnkyẹ shin enyi kyẹ utoo unu lẹ man: <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />kalẹ unu ya ọnkyẹ ọya shin ama ẹnọm ma, huọ eji wan, huọ ẹnam shin epye ẹkyuẹ lẹ ma tuhuan ka lẹ unu du ililu wan. Oso kẹ agyagyuan unu ton unu ọmẹn ọnkyẹ lẹn.</para>
  <para style="pmc" vid="ACT 15:29">Sẹ iple ẹlẹn.<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />Ala tuan ma kan lẹ Antakiya ọnhuọ shin o krun ididu ana ure Ọnọm kan kẹ ọnhuọ uzun tuhuan kẹ ama wan ọzaa lan. <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />Lẹ shin ada hurẹ ọpwa ọzaa lan, ala mọ sablọ ẹhurẹ ẹdọọ shin okon. <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />ọYahuda kẹ ọSilas, anushin onu ma, ala ma ewedri ẹkyẹẹ kọn ọnprẹ la pam,tuhuan ka sọ wa ẹhurẹ ẹdọ. <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />Lẹ ushin a huọ ukon ahyuẹ kẹ ọnhuọ lan, ala ma wan anya tuhuan kẹ asọ wan onyun esheshii shin Ọnọm soo kẹ ẹma, e le ywure wan ọnhuọ anushin a tuan ma. <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />(Tushin uSilas la pya utitru ọnhuọ lan.) <verse eid="ACT 15:34" /><verse number="35" style="v" sid="ACT 15:35" />uBulus kẹ ọBarnaba la pya ukon ahwuẹ lapam kẹ Antakiya. Ẹma kẹ eple nyi ma na pam na frẹ ulolo na too ihyuu aprẹ Ekye Abaan.</para>
  <para style="pi" vid="ACT 15:35">UBULUS WAN PLAM KẸ ỌBARNABAS <verse eid="ACT 15:35" /><verse number="36" style="v" sid="ACT 15:36" />A nyaan iple ẹlẹn , uBulus lẹ utoo ọBarnaba shin, “enyi ma eywure kan kẹ enyi ma odruu lẹ ewedri enyi kẹ ididu ashan shin enyi too ihyuu aprẹ Ekye Abaan kẹ enyi shin emle shin e mle wọ.” <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />ọBarnaba nii ọkpọn ọYohanna anushin adrọ ghan shin ọMarkus kẹ ẹma. <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />Tushin uBulus shin uyiu ẹma sọ ke ọMarkus wan kọ sablọ shin ana la wan kyikyuo kẹ ẹbọọ ọFamfiliya, ka dran nga udu ọtuan kẹ ẹma. <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />Ọya ẹnan lan nyan kẹ ọmẹn ma lakẹnkan ọnwọ shin ọsọ ala plam kẹ eple. ọBarnaba la kpọn ọMarkus kẹ anyẹran ọkpa ambrẹ kẹ ẹnga kan wan lẹ ọSayifurus. <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />Tushin uBulus we ọSilas ala okpon kan wan, ana ure Ọnọm kan lẹ asọ wan onyun esheshin Ekye Abaan kẹ okon aklọ lẹ ma. <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />Ala okpon kẹ ọmẹ ẹbọ uSuriya kẹ uKilikiya, lẹ a ma ididu ana ure Ọnọm kan ẹhurẹ ẹdọ.<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s">uTimoti kẹ okon uBulus kẹ uSila</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />uBulus la ba lẹ ọDarbe kẹ uListira, ọnhuọ shin anpaduan soo wọ, adrọ ghan shin, uTimoti, anushin ẹya ghan anBayahude ghan, ana ubi, tushin ekyee ghan ọBayahudiya ghan. <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />Ewedri ghan kẹ uListira kẹ Ikoniya too aprẹ agyagyuan kẹ aprẹn ghan. <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />uBulus nii usoon kẹ ẹnga kẹ usoon lan, ọnwọ ala zrọ ta ghan itun sablọ aYahudawa shin osoon kẹ ayẹẹ onhuọ lan, sablọ shin ididu wan za shin ekyee uTimoti anBahelene ghan. <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />Osoon ọnya ẹn ka ẹshaan kan lẹ ẹn ka ẹshaan, lẹ otoo ada ọkpọn udu shin apaduan kẹ onokon urushalima kpọn sablọ ada re kan. <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />Ọnwọ Abaan Ọnọm lẹ okon ẹhurẹ ẹdọ tuhuan ka frẹ ọkẹn mẹ kẹ ọmẹn ọkpọn lẹ ẹhurẹ la kẹnkan huọ ulu bọng.<verse eid="ACT 16:5" /></para>
  <para style="s">Unyin kawan ala shin uBulus shin aprẹn enkyii ana ọMasidoniya</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />uBulus kẹ ana usee usoon ghan kpoon kẹ ọmẹn ẹbọn uFirijiya kẹ ọGalatiya lẹ ushin, sablọ shin Iri Osẹẹ re wan utoo aprẹ Ekyee Abaan kẹ Asiya. <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />Lẹ ushin a huọ fuan anka ẹbọn uMisiya, ala yẹ kọ nyẹran uBitiniya, tushin Iri ọYẹsọ la ere wan ọnyẹran kọ. <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />Ọnwọ ala okpon kẹ uMisiya kẹ srom kan wan lẹ uToruwas. <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />Lẹ otu, uBulus la eshìn ushìn kawan, enkyii ana ọMakidoniya kyẹẹn la wẹn ghan shin, “Ba lẹ ọMakidoniya kẹ ẹngọ ma shẹẹ enyi ọnyẹ wọ.” <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />Ẹlẹn shin uBulus hurẹ ushin kawan ala lang, ala kẹ ghan shin, enyi nyẹnyan kẹ ẹlẹn izun kan lẹ ọMakidoniya, Ọnọm draa enyi kẹ enyi sa otoo ihyuu ishishii kẹ ọnhuọ lan.<verse eid="ACT 16:10" /></para>
  <para style="s">uLidiya ma ẹhurẹ ghan kẹ uFilibi</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />Enyi la nya kẹ ọmẹ ọkpan ambrẹ bi kẹ uToruwas ka kpẹẹn kan lẹ ọSamotiras. Aba kẹ ọnwa ubun enyi la nyan sẹ kẹ ọNiyafolis. <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />Ọnyaa kẹ ọnhuọ lan, enyi lẹ anyaa usoo kan lẹ uFilibi, shin agọn uRoma nga okon udu ẹgọn lẹ ẹnkọ, ẹshan lẹn ẹn kọ ẹ srẹ lẹ ọlọlẹ kẹ ọMakidoniya. Enyi la ọywua kẹ ọnhuọ lan aywuẹ lapam. <verse eid="ACT 16:12" /><verse number="13" style="v" sid="ACT 16:13" />Kẹ aywuẹ utrim aYahudawa, enyi otro kan lẹ atẹgha ẹshan kan lẹ ọmẹn igoo kyẹ unii ọnhuọ ọpẹlọnọm. Enyin la trẹtraa kẹ apẹẹ lẹ ashẹẹ shin aklan kẹ ọnhuọ lan. <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />Kẹ ọmẹn anushin okon ọngẹn enyi atọn lan, eple anshẹẹ soo adrọ ghan shin uLidiya, ana uhwroo ọnkyẹ ọma ambrẹ alighẹ asa ghan bi kẹ ẹshan ẹlẹlẹ ọTayatira, òó soo ana ọdọọ Ọnọm. Ọnọm lẹ okun nga ẹhurẹ kẹ angẹn aton lẹ ọnkyẹ shin uBulus kon utoo. <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />Lẹ shin odu ghan ọbaftisma kẹ ana ọmẹ abaan nga, ala wẹn enyi shin, “Inshin unu akpọn shin imi akpon Ekye Abaan lẹ ẹhurẹ mi, lẹ unu ba lẹ ọmẹ abaan mi kẹ unu ma kyuran.” a la anuam kẹ enyi.<verse eid="ACT 16:15" /></para>
  <para style="s1">Asọ uBulus kẹ uSila Kẹ unkoo</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />Kẹ uple ubun,enyi a kya kan wan lẹ ọnhuọ pẹẹlẹọnọm enyi lan klan kẹ eple agrẹn arashẹ shin oso lẹ ọnshaa ọma utoo ombun. Ana arashẹ lan ka oko ikli lakẹnka lẹ ọswa ẹtra ghan lan. <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />Ala afrẹ ure enyi kan kẹ uBulus, la kẹn ẹkpa lẹ otoo shin, “Ekyi wan lẹn, agrẹn Ọnọm alalẹ wan, oso kẹ uhuọ utoo unu ọntran ufuwo.” <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />Ala afrẹ udu klan kẹ okon ahwuẹ lapam. uBulus la bẹn ẹhurẹ ghan lakẹnkan, e le kyem ka kọn ghan lẹ unshaa la, “Kẹ ọmẹn ọntuan ọYẹsọ uKristi, tro bi kẹ ọmẹn nga!” Kẹ ladran ọnshaa lan lẹ alaa ghan.<verse eid="ACT 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19" />Lẹ shin ana arashẹ la kon ọntra ukon ikli wan swa wọ, ala afrẹ uBulus kẹ uSila, kẹ ewli wan kalẹ ọmẹ ize kẹ ẹmpakye ana ọprẹ atan. <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />Lẹ ushin akpọn wan kalẹ ẹmpakye ana aprẹẹ atan, ala kọwan shin, “Ekyiwan lẹn, ana aYahudawa ma tuhuan ahuọ vlo enyi ẹshan. <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />A soo kẹ ọhuọ ulolo iywruro shin kyẹ ẹn ya enyi reka ma, sablọ enyi oRomawa ma.”<verse eid="ACT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 16:22" />Ada lẹ okyun akyuẹ kẹ ekyiwan lan ka frẹ wan lẹ ẹtua, tuhuan ana ọprẹ atààn lan la ma onyun shin ewli wan ọngbapya tuhuan kẹ akẹn ma. <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />Lẹ ushin ahurẹ ọkẹn ma lakẹnka, ala sọ wan kẹ unkoo ẹva tuhuan kẹ otoo ana ọzọ lan shin azọ wan la gyagyuan. <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />Lẹ ọma onyun ana ọprẹ atan lan, ala sọ wan kan lẹ ọmẹn ẹtrẹtrẹn unkoo ẹva, kẹ olulo afran ma lẹ iwe ayra tuhuan kẹ ohrun kan.<verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />Lẹ erete otu, uBulus wan kẹ ọSila so kẹ unhuọ ọpẹẹlẹọnọm la ta antẹ ẹyọ ọdọọ Ọnọm, ana ọmẹn onkoo ẹva lan tu so kẹ ọnhuọ ghẹn ẹma ato. <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />Kẹ ẹlẹn izun, ẹbọ lan ọnya ọnẹghẹ lakẹnka, ọnwọ shin ẹbọn unkoo ẹva lan nyan nẹghẹm tuhuan ididu onyun unkoo la na kunmi, ayra shin olulo anushin asọ wan kẹ unkoo lan krọ yọ. <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />Lẹ ushin ana ọzọ unkoo ẹva lan na nyẹnya kẹ ọna, ala okòón atigha so kẹ ezii, e le we ẹbran ẹnhwran kyẹ ọprẹ ẹkyuẹ ghan, sablọ emle shin ana asọ kẹ unkoo lan kram. <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />Tushin uBulus la sa iwe lẹ ọdọ ka kọ ghan lẹ ẹnga shin, “Kalẹ ẹngọ bẹn ẹhurẹ ngọ ma, enyi sọ kẹ ididu nyi!”<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />Ana ọzọ unkoo ẹva lan la kọ ghan shin oko nga ọla wan. Ala nyẹran kan ghan lẹ wip kan lẹ ọmẹ, ka kakpa kẹ empakye uBulus wan kẹ ọSila, ka afrẹ ọninyẹ lẹ ẹhuọ sablọ ibu. <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />Ala okon ma balẹ ibeti, ka kọ ghan shin, “Ekye abaan, unse wan imi nii udu kẹ ọdọ wọ kẹ imi kon ufuwo?”<verse eid="ACT 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31" />Ala kọwan lẹ ghan shin, “Ma ẹhurẹ ngọ kẹ Ekye Abaan ọYẹsọ, ẹngọ kẹ ana abaan nii ukon ufuwo.” <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />Ala otoo ghan kẹ ana abaan ghan aprẹẹ Ekye Abaan. <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />Kẹ ọmẹn otu lan, ala akpọn ma kẹ hwlo wan adẹẹn ma. Kẹladran ala odu wan ọbaftisma kẹ ididu kẹ ana ọmẹ abaan ghan. <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />Ala kpọn ma kan ghan lẹ ọmẹ abaan ngan, ka oko ma ọnkyọ ọya wan. Ẹnga kẹ ana ọmẹ abaan ghan la mọ lẹ shin ididu wan ma ẹhurẹ wan.<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />Lẹ shin oturombu shaa, ana ọprẹ ata na la tuan aná àbàn shin, “Alaa ekyiwan lan.” <verse eid="ACT 16:35" /><verse number="36" style="v" sid="ACT 16:36" />Ana ọzọ unkoo ọhyua ẹva la otoo uBulus shin, “Ana ọprẹ ataan man enyi onyun shin enyi sọ ngọ kẹ uSila kẹ unkoo ẹva. la tuan shin alaa unu. Kẹ ladẹn unu tro kẹ unu kpon kan unu kẹ ọmẹ ọnaa ẹhurẹ.”<verse eid="ACT 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37" />Tushin uBulus la kọ ghan lẹ ẹma shin: “Akẹn kẹ ẹmpakye ada , bọ odu enyi ọprẹ atan ma, kọn shin enyi oRomawa ma. Tuhuan ala sọ enyi kẹ unkoo, tuhuan okyu we enyi kẹ ututuwo? Kay, sẹ aba ka akyuẹ kyuẹ wan kawan we enyi.”<verse eid="ACT 16:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38" />Ana àbàn la ehwure kẹ oko otoo ana ọprẹ atan lan enyẹn aprẹẹ lan. Ana ọprẹ atan lan la nyan ọkọọn ibun lẹshin akọọn shin uBulus wan kẹ ọSila oRomawa wan. <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />Ala ba kawa wan uBulus kẹ uSila. Tuhuan ala ewee wan ka wan ma alaa wan ẹshan ma kan. <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />Lẹ shin uBulus wan kẹ uSila hurẹ utro bi kẹ unkoo ala okpon kan wan lẹ abaan uLidiya ọnhuọ shin aklan kẹ ana ubi kẹ ama wan ẹhurẹ ẹdọ, tuhuan kẹ okpon kan wan.<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s1">uBulus kẹ ọTasalonika</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />Lẹ ushin uBulus kẹ uSila okpon kẹ ọmẹ Amfibolis kẹ Afolloniya, ala ba lẹ ọTasalonika, ọnhuọ shin unkoo ọpẹlọnọm aYahudawa so wọ. <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />uBulus la nyẹran kan lẹ unkoo ọpẹlọnọm emle shin á kẹ odu wọ kẹ arẹn ẹhurẹ ghan kẹ ẹma kẹ ọmẹn aprẹẹ Ọnọm kẹ aywuẹ utrim ataa. <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />Ala afrẹ ọwla wan kan, lẹ otoo wan shin ọdọ wọ uKristi hyua ẹva tuhuan ka nyẹnya bi kẹ ọmẹ ituu, tuhuan ka kọn ghan shin, “ọYẹsọ na shin imi kon utoo unu na ngo o so uKristi.” <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />Ala owoo ẹhurẹ eple enyi ma kẹ ọmẹn aYahudawa kẹ eHelenawa lapam ana ọkọọn ibun Ọnọm kẹ ashẹẹ adradọ lapam ala ere uBulus kẹ uSila kan. <verse eid="ACT 17:4" /><verse number="5" style="v" sid="ACT 17:5" />Tushin aYahudawa la kọn ifuwo, ala tun arẹn uruun kẹ ọmẹ izee. Lẹ shin ididu wan klan ala so uyiyiri kọn ọmẹ ẹsha na. Ala shẹẹm kalẹ ọmẹ abaan ọYason kya ko unii uBulus wan kẹ uSila kọn ọkpọn ma balẹ ẹmpakye ada. <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />Lẹ ushin eshin wa ẹma ma, ala owoo ọYason kẹ eple ewedri ana bi, ka akpọn ma kalẹ ọnhuọ ana prẹẹ ataan, la kẹn ẹkpa la kọ wan shin, “Ekyi wani shin a huọ sọ uyiyiri huọ lọhwan kẹ ọmẹ ohun, ama ba le ọhuẹn nẹ. <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />Tuhuan ọYason la ngrẹn ma kẹ ọmẹn abaan ghan kawa osoon ghan. Ididu wan kon utoo ada shin alaa ihwuro ẹnyọ ọKaisar kan, lẹ otoo shin eple agọn soo shin adrọ ghan shin ọYẹsọ.” <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />Lẹ ushin akọọn kẹn, ada kẹ ana kon ekye ẹsha na uyiyiri la nya. <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />Ala so ọYason kẹ ewedri ghan ọkwra ikli tuhuan kẹ alaa wan.<verse eid="ACT 17:9" /></para>
  <para style="s">uBulus kẹ uSila kẹ ọBiriya</para>
  <para style="pi">
    <verse number="10" style="v" sid="ACT 17:10" />Lẹ ushin ọhuọ hurẹ ọba otu, ana ubi la tuan uBulus kẹ uSila kan lẹ ọBisiya. lẹ shin a fuwan ọnhuọ lan, ala nyẹran ọmẹn unkoo ọpẹlọnọm aYahudawa. <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />aYahudawa lẹn srẹ aTasalonika lan lẹ ọfrẹ ẹkyuẹ, sablọ shin angrẹn aprẹẹ lan lẹ anyẹn ampuwa. ka frẹ uvun aprẹẹ Ọnọm huọ ulon ubo wọ, kyẹ ushin huọ ọnkyẹ shin uBulus too ẹplẹpan yaa lẹn. <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />Sablọ klan, ana pam kọ ọmẹ aYahudawa la ma ẹhurẹ wan, kẹ eple ashe adradọ kẹ ekyii ama ana uHelenawa. <verse eid="ACT 17:12" /><verse number="13" style="v" sid="ACT 17:13" />Lẹ ushin aYahudawa shin osoo kọn ọTasalonika kọọn shin uBulus kon utoo ihyuu aprẹẹ Ọnọm kẹ ọBiriya, ala huọ kan lẹ ọnhuọ lan kẹ akaaka sẹn ada kẹ udu ifuwo kẹ ma. <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />Kẹ ladran, ana ubi la sọ uBulus kẹ ọntraan kan lẹ onyun udri, tushin a laa uSila kẹ uTimoti wan kan kẹ ọBiriya. <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />Anushin akaaka kan uBulus lan, lẹ kon nga kan lẹ Atina. Lẹ shin akyẹ uywure wan uBulus la tuan ma kan lẹ ọnhuọ uSila kẹ uTimoti shin aba kẹ awa okon ghan ladrẹndrọn, ala kpon kawan.<verse eid="ACT 17:15" /></para>
  <para style="s">KẸ ATINA</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />Lẹ ushin uBulus so ọnhuọ ọzọ uywure wan kẹ Atina, ala kon anbẹn ẹhurẹ lakẹnkan lẹ shin eshin ẹshaan lan kuwang lẹ ogunki. <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />Ọkla wọ ala rẹn ẹhurẹ ghan kẹ ọmẹn unko ọpẹlọnọm kẹ aYahudawa, kẹ eple aHelenawa ana ọkọọn ibun Ọnọm tuhuan kẹ ada lapam kẹ ọmẹn ize Huọ ulo ubon nga wọ. <verse eid="ACT 17:17" /><verse number="18" style="v" sid="ACT 17:18" />Emle lan nga eple Abikuriyawa kẹ aSitokiyawa ana so le ikrii la ywẹywa kẹ ẹnga. Eple nyi ma la kawan shin, “Unse wan imbuu lẹn kon utoo?” Eple enyi ma tọ kọ wan shin,“okon ọgaam lẹ iple ẹnọm.” O too klan sablọ shin uBulus kon too ihyuu ishishi ẹnkọn ọYẹsọ kẹ ọnya nga balẹ ọmẹ itun. <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />Ala kpọn ghan kẹ okon ghan ba lẹ ọnhuọ ọklan ma kẹ Arasa tuhuan kẹ eluwe ghan shin, “enyii ta ẹn kpẹẹ ulolo ọprọpra shin ẹngọ kon ulolo lẹn?” <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />Ẹngọ huọ ukon ulolo ọprọpra shin enyi so ọnya ọkọọn ma tuhuan enyi nii ọkpẹ ọnkyẹ shin ọnkyẹ lẹn too. <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />Ididu Atinawa kẹ osoon shin aywua kẹ ọmẹn lẹn kon ọya ẹlẹn ma kẹ ililu la pya onyun kẹ ọgnẹn atọn lẹ ulolo ọprọpra. <verse eid="ACT 17:21" /><verse number="22" style="v" sid="ACT 17:22" />uBulus la nyẹnyaan ka tẹgha kẹ ẹmpakye ọklan Arasa, ka kọ ghan shin, “Unu ana Atina, imii shiin unu ana unii ọkọọn aprẹẹ Ọnọm ma kẹ uhuọ ulon ọntraan nga wọ. <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />Ẹlẹn shin imi oso kẹ ọhuọ ukee ẹshan lẹn, imi lẹ eshin ọnkyẹ shin unu kon ọdọọ Ọnọm wọ, imi la ete shìn ọnhuọ umee enshin shin arẹn shin, <char style="sc">KAN LẸ ỌNỌM SHIN AZA WAN MA</char>. Kẹladẹn, imi kyẹ utoo unu ọnlẹɡhẹ kẹ aprẹẹ Ọnọm shin unu zan unu ma.<verse eid="ACT 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 17:24" />“Ọnọm shin odu ohun kẹ ididu kẹ ọnkyẹ shin usoo kẹ ọmẹn ghan, nga so Ekye Abaan aprẹn kẹ ohuo, bọ akaaka ywua kẹ ọmẹn abaan shin avran lẹ anyẹẹn. <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />Tuhuan ẹnga ka nii nga adọọ ghan lẹ anyẹẹn enyi etri wan bọ ẹnga nii ọlẹghẹ wan, sablọ ẹnga ẹkyuẹ ghan nga ma ididu ada ọrẹ kẹ ọnfran kẹ ọhuọ unse wan wọ. <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />Kẹ ubi kẹ ọnhuọ ana onzun wọ òó du ididu ọmbọn enyetri, sablọ a trẹtraa kẹ ukpekye ohun, tuhuan a nga àá so ẹlẹn ẹn ya uhuọ unse wan kẹ ẹnhuọ shin ẹma ni ọywua wọ. <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />Ọnọm du kẹn sablọ shin enyetri nii nga tuhuan huọ ẹlẹlẹn ya wọ inshin e nii nga, o kon nga, sablọ osoo ghan ananọ kẹ alọ enyi ma. <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />‘Kọ kẹ ọmẹn nga wọ enyi ywua lẹ enyi soon wọ tuhuan lẹ enyi du huọ unse wan shin enyi kon udu wọ.’ Emle shin eple ana ọrẹn unu too wọ shin, ‘Enyi arẹn nga ma.’<verse eid="ACT 17:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 17:29" />“Ọklan wọ, inshi enyi ọnyẹ Ọnọm wọn, kalẹ unu shin kawa Ọnọm so kawa ọnkyẹẹ shin avran lẹ anyẹẹn kawa uzinari, huọ ozurfa huọ ẹntratra shin enyetri du lẹ ọza ghan ma. <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />Tushin Ọnọm sa ukpekye ghan kọn ọnkyẹ ikikiwo shin ẹma dọọ bọ aza wa. A so ada ididu huọ ọlọn ọnhun ngan shin oywiro ilovro wan, <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />Sablọ shin a so idre Ọnọm shin ẹnga ni udu ada ọprẹ atan ẹnyọ ẹplẹpan bi kọn ọnhuọ anushin e we. Àá man ẹplẹpan ẹnyẹn kẹ ididu ada bi kọ shin anushin àá nyọn bi kọ ẹmẹ ituu.”<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />Lẹ ushin akọọn aprẹ ọnyuọn nga anushin ekywure wan bikẹ ọmẹ itun, eple enyi ma la kpaa lẹ ẹkrọ, tushin eple enyi ma la kọ wan shin, “Enyi nii uywure kẹ enyi kọ ngọ kẹ aprẹn aprẹ lẹn.” <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />Kẹ ẹlẹn lan, uBulus la laa onokon lan wọ. <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />Eple ekyi la hurẹ la ere uBulus kan tuhuan ka kpọn ghan lẹ ẹhurẹ. uDiyonisiyus, ana ọprẹ atààn shin adrọ shin,Areopagus, tuhuan kẹ anshẹẹ shin adrọ shin, ọDamaris, tuhuan kẹ eple enyi ma.<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s">uBulus kẹ uKorinti</para>
  <para style="pi">18 <verse number="1" style="v" sid="ACT 18:1" />Ọnya kẹ an yẹn, uBulus la laa Atina wọ ka okpon kan ghan lẹ uKorinti. <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />Ọnhuọ lan wọ àá klan kẹ anBayahude shin adrọ ghan shin Akila, ana ẹshan ọFantus, shin àá saa bikẹ Italiya kẹ ọmẹn aywuẹ lẹn kẹ ashẹ ghan uBiriskila, sablọ ọKalaudiyus ma ohyuun shin ididu aYahudawa laa uRoma wọ. uBulus la kan kya eshìn ma, <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />Sablọ ẹnga ana ọtaa enshìn nga kawa ẹma, ala ywua tuhuan kẹ udu ọtuan kẹ ẹma. <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />Huọ olon aywuẹ utrim nga wọ, uBulus ka pya onyun kẹ ọmẹ unkoo ọpẹlọnọm lẹ enii ọntraan uwoo ẹhurẹ aYahudawa kẹ eHelenawa. <verse eid="ACT 18:4" /><verse number="5" style="v" sid="ACT 18:5" />Lẹ ushin uSila kẹ uTimoti saa bikẹ ọMakidoniya, uBulus la ma ididu ẹlẹn ghan kẹ ọnhuọ utoo ihyuu ishishi, lẹ otoo aYahudawa shin, ọYẹsọ nga o so uKristi. <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />Tushin lẹ ushin aYahudawa ya ẹnà kẹ uBulus ka frẹ ghan lẹ ẹtua, ala kpaan ọnkyẹ ghan kẹ otoo wan shin “Eji unu lẹgha kẹ aprẹn akyuẹ unu! Imi soo mi lẹ ilovro kẹ ọmẹn an yẹn ma. Ọnya kẹ unbin, imi nii ukpo kan mi lẹ ọnhuọ ẹna-ẹhọ̀ọ́.” <verse eid="ACT 18:6" /><verse number="7" style="v" sid="ACT 18:7" />uBulus la laa unkoo ọpẹlọnọm lan wọ kan ghan lẹ atigha abaan uTitiyus uYustus ana udu ẹgrẹn Ọnọm, shin osoo kẹ ayẹẹ ọnhuọ lan. <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />uKiribus ana ukon ekye unkoo ọpẹlọnọm la kpọn aprẹẹ Ekye Abaan lẹ ehurẹ ghan kẹ ididu ana abaan nga; tuhuan oKorintiyawa lapam shin akọọn aprẹẹ uBulus, la kpọn lẹ ẹhurẹ wan tuhuan alẹ odu wan ọbaftisma. <verse eid="ACT 18:8" /><verse number="9" style="v" sid="ACT 18:9" />Eple otu, Ekye Abaan la pẹẹ lẹ uBulus kẹ ọmẹn unyin kawa ala shin, “Kalẹ ẹngọ kọọn ibun ma; frẹ utoo ihyuu ishishi kalẹ ngọ fua wan. <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />Kẹ ọsablọ shin imi soo kẹ ẹngọ, bọ anushin enii ọpya ngọ huọ odu ngọ ọnlighẹ ububi wan, sablọ shin imi so la ada lapam kẹ ọmẹ ẹshan lan.” <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />uBulus la ywua kẹ ọnhuọ lan amẹẹ ozun lẹ uglu lẹn, ka frẹ ulolo wan aprẹẹ Ọnọm.<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />Tushin ẹlẹn ọGaliyo soo ugbomna Akaya, aYahudawa la klan akyuẹ ka maa uBulus, ka kpọn ghan kalẹ ọnhuọ ana ọprẹ ataa. <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />Kẹ akọ wan shin, “Enkyi lẹn kon uwoo ẹhurẹ ada kẹ ere Ọnọm kan kẹ ukye ititim iywuro.”<verse eid="ACT 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14" />uBulus kyẹ unii ọpẹẹ wlan, ọnwọ ọGaliyo la kọ ghan lẹ aYahudawa shin, “Inshin unu aYahudawa kon utoo aprẹẹ ilovro ẹlẹlẹ, unii usoo kẹ agyagyuan imi ngẹn atọn lẹ unu. <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />Tushin inshin ọsablọ kẹ ọya ẹnà kẹ aprẹẹn ẹnrẹn kẹ ọntua tuhuan kẹ aprẹẹ iywuro ẹn yẹ unu wọ, unu sem kẹ akywa-kyuẹn, imi nim ukye ana ọprẹ atààn ute aprẹẹ lẹn ma.” <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />Ọnwọ èle re wan kẹ ọmẹn ozo ọprẹ ataàn lan. <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />Ọnwọ ididu wan lẹ ekyem lẹ ọSastanus ekye unkoo ọpẹlọnọm, ala kẹn nga kẹ ẹmpakye onkoo ọprẹ ataan lan. Bọ ọGaliyo dan ma huọ la hyuẹ.<verse eid="ACT 18:17" /></para>
  <para style="s1">uBiriskilla, Akila kẹ Afollos</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />uBulus lẹ okon aywuẹ la hyuẹ kẹ ọKorinti. Tuhuan ka laa ana ure Ọnọm kan kẹ ọnhuọ lan ka nyẹran ọkpa ambrẹ kan ghan lẹ uSuriya, uBiriskila kẹ Akila la kan ghan wọ. Àá ba lẹ ọkpẹn, ala zrọ ukye ẹkyuẹ ghan sablọ shin àá la huọ utre kẹ ọKankiriya. <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />Lẹ ushin a fuan Afisa, uBulus la laa uBiriskila kẹ Akila tuhuan kẹ a nyẹran ọmẹn unkoo ọpẹlọnọm ka ywua ẹywua kẹ aYahudawa. <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />Ala wẹn nga ka pya tẹgha kẹ ẹma na hwuẹ, tushun ala tran nga. <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />Tushin lẹ ushin a kyẹ ọlaa wan, ala kpaa wan onyun shin, “Imi ni uywure wan, inshin udu Ọnọm wọ.” Tuhuan ala laa Afisa wọ kẹ ọmẹn ọkpaa ambrẹ. <verse eid="ACT 18:21" /><verse number="22" style="v" sid="ACT 18:22" />Lẹ ushin àá fuan ọKaisariya, ala kẹ odruu la ana ubi, tuhuan kẹ kpon kan ghan lẹ Antakiya. <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />Lẹ ushin àá huọ pya ọywua kẹ Antakiya, uBulus la nyaan kẹ e kee ẹbon ọGalatiya kẹ ẹbọn uFirijiya, le re ọmbọn kan, la man ididu apaduan ẹhurẹ ẹdọ. <verse eid="ACT 18:23" /><verse number="24" style="v" sid="ACT 18:24" />Ẹlẹn lahyuẹ, eple anBayahude so shin adrọ ghan shin Apollos ana ẹshan Alezandiriya ghan áá ba lẹ Afisa, ana ọza ọnlẹghẹ ghan tuhuan aza aprẹẹ Ọnọm lakẹnkan. <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />Ololo ghan kẹ ọntran Ekye Abaan. Àá ka enyin ọ sọ ẹhure kẹ ọmẹn ọpya onyun ghan, tuhuan òó lolo aprẹ ọYẹsọ lakpẹkpẹrẹ, tuhuan ọbaftisma ọYohanna wọ àá za le hule. <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />Àá frẹ ọ pya onyun bọ ibun kẹ ọmẹ unkoo ọpẹlọnọm. Lẹ ushin uBiriskila kẹ Akila kọọn ghan, ala tuan lẹ ẹn ngaa ba lẹ abaan ma kẹ ololo ghan ọntraan Ọnọm lakpẹkpẹrẹ. <verse eid="ACT 18:26" /><verse number="27" style="v" sid="ACT 18:27" />Tuhuan lẹ shin Apollos kya kan ghan Akaya, ana ubi la ma ghan ẹhurẹ ẹdọ tuhuan ka rẹn ọzaa kan lẹ ọnhuọ apaduan lan shin a ngrẹ ghan. Lẹ shin àá fuan, ala osoo ọta anyẹ lakẹnkan kẹ ọnhuọ anushin lẹ esheshii a la kpọn lẹ ẹhurẹ. <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />Kọ sablọ shin óò kon ẹkyuẹ lẹ aYahudawa lakẹnkan kẹ ẹmpakye ada lẹ enyin ma ẹplẹpan bikẹ ọmẹn Ọzaa Ẹgọn shin, ọYẹsọ nga oso uKristi.<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s">uBulus Kẹ Ẹfisus</para>
  <para style="p">19 <verse number="1" style="v" sid="ACT 19:1" />Ẹlẹn shin Apolos ywua kẹ ọKorinti, uBulus la kpoon kẹ ọmẹ ọga ẹbọn ashan lan kan ghan lẹ Afisa. Òó kon eple apaduan kẹ ọnhuọ lan <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />kẹ lue wan shin, “Unu ala ngrẹn Iri Ẹsẹẹ ẹlẹn shin unu a kpọn lẹ ẹhurẹ wọ?” Ala kọ wan shin, “kay, enyi so ọnya ọta kọọn shin Iri Ẹsẹẹ so wan.” <verse eid="ACT 19:2" /><verse number="3" style="v" sid="ACT 19:3" />uBulus lẹ lue wan shin, usee ute ọbaftisma ọnwọ odu unu?" E le kyee ghan shin, ọbaftisma ọnwọ ọYohanna <verse eid="ACT 19:3" /><verse number="4" style="v" sid="ACT 19:4" />uBulus la kọn ghan shin, “ọbaftisma ọnwọ ọYohanna ọnwọ ọkpaa ilovro wọ. A la otoo ada lan shin a kpọn anushin akyaan kẹ ititim ghan lan, ọYẹsọ lẹ ẹhurẹ.” <verse eid="ACT 19:4" /><verse number="5" style="v" sid="ACT 19:5" />Lẹ shin akọọn kẹn, ala odu wan ọbaftisma kẹ ọmẹn ọntua Ekyee Abaan, ọYẹsọ. <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />Ẹlẹn shin uBulus traa wan anyẹn nga, Iri Ọnọm lẹ sri kẹ aprẹn ma tuhuan ala nyan ọpya onyun lẹ iple ino shin akaaka kpẹẹ wan ma tuhuan ala otoo ombun. <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />Ekyiwan lan la fuan ana ọkọ lẹ apua kẹ ididu wan. <verse eid="ACT 19:7" /><verse number="8" style="v" sid="ACT 19:8" />uBulus la nyẹran ọmẹn unkoo ọpẹlọnọm kẹ okon ẹprẹn ẹtaa kẹ ọnhuọ ọya ẹnà kyẹ uwoo ẹhurẹ ada kẹ aprẹn ẹgọn Ọnọm. <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />Tushin eple enyi mna kẹ ọmẹn ma lẹ nyin usoo akọọn atọn kẹ atran ma ọkpọn lẹ ẹhurẹ tuhuan kẹ ata ititim lẹ ọntraan Ọnọm ọnwọ ọsọ uBulus la laa wan kẹ akpọn apaduan lan kẹ ẹnga kẹ frẹ ulolo wan huọ ulon ubọn nga wọ kẹ ọmẹn unkoo ulolo ẹnrẹn ọnwọ uTiranus. <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />Ọnkyẹ lẹn ywua kẹ ẹbọn Asiya amẹẹ apua ọnwọ shin ididu aYahudawa kẹ eHelenawa shin osoo kẹ ẹbọn lan la kọọn aprẹẹ Ọnọm. <verse eid="ACT 19:10" /><verse number="11" style="v" sid="ACT 19:11" />Ọnọm du ọtuan lẹ uBulus kẹ odu ọnkyẹ ọvrọ. <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />ọnwọ shin ọntapẹẹ enzen kẹ ọngbapyà shin ọnpya ẹgbẹna uBulus, ala kpọn ka pyà oloo wọ, ala okon ọtrẹ tuhuan iri ibibi la otro kẹ ẹgbẹnaa ma. <verse eid="ACT 19:12" /><verse number="13" style="v" sid="ACT 19:13" />Eple aYahudawa shin osoo eklem lẹ ewli ada irí ibibi lan, la yẹ kẹ udu ọtuan lẹ ọntua Ekyee Abaan ọYẹsọ kẹ aprẹn anushin irí ibibi nyẹran ma. Akaaka kọ wan shin, “Kẹ ọmẹn ọntua ọYẹsọ anushin uBulus kon utoo ihyuu ishishii ghan, imi shin lẹ ẹngọ, tro ba lẹ etiin.” <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />Arẹn otumpua ama uSikeba, akpẹ umee enshin nga aYahudawa ama osoo kẹ ọnhuọ udu kẹn. <verse eid="ACT 19:14" /><verse number="15" style="v" sid="ACT 19:15" />Uple ubun, iri ibibi lan lẹ kyee wan shin, “ ọYẹsọ dẹn, imi za ghan, tuhuan imi za uBulus, tushin ẹ nga oso unu?” <verse eid="ACT 19:15" /><verse number="16" style="v" sid="ACT 19:16" />Kẹ ladran, ana iri lan lẹ a sa ọdọ wan ledidu, ka ma wan ọkẹn lakẹnkan ọnwọ shin ala shẹẹ afran lẹ utiton bi kẹ ọmẹn abaan lan kẹ ezin kẹ eji kẹ ẹgbẹnaa ma. <verse eid="ACT 19:16" /><verse number="17" style="v" sid="ACT 19:17" />Ẹlẹn shin aYahudawa kẹ aFisawa shin a ywua kẹ Afisa kọọn kẹn, ibun la frẹẹ wan ledidu tuhuan ala frẹ ọdọọ ọntua Ekyee Abaan ọYẹsọ. <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />Ana ọmpam shin akpọn lẹ ẹhurẹ lẹ otro kẹ etiin kẹ ohwro ọnkyẹ unbubi shin ẹma du. <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />Ana ọswa ọntra lapam lẹ okrun ididu ọnkyẹ ọswa ọntra wan kẹ ọnhuọ uzun tuhuan kẹ asọ alau kẹ edre ada. Lẹ shin apua ikli ọnkyẹ lan ledidu, ikli lẹn la fuan atẹlẹ ọkọ ẹhwuẹ itong <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />Ọnya kẹ ọnkyẹ lẹn, aprẹ Ọnọm la kam mẹ lẹ ogbou tuhuan ka ba adọ lakẹnkan. <verse eid="ACT 19:20" /><verse number="21" style="v" sid="ACT 19:21" />Lẹ shin ididu ọnkyẹ lẹn hurẹ ọba, uBulus la nyan kẹ okpoon kẹ ọmẹn ọMakidoniya kẹ Akaya kan ghan lẹ Urushalima. Àá pẹẹ shin, “inshin imi afuan ọnhuọ lan, ọdọ wọ lẹ imi huọ udruu lẹ uRoma.” <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />Àá tuan arẹn ọtuan nga ana pua, Utimoti kẹ Erastus, kan lẹn ọMakidoniya tuhuan ala tẹgha kẹ ọmẹn ẹbọn Asiya aywuẹ la hwuẹ.<verse eid="ACT 19:22" /></para>
  <para style="s">Ishim kẹ Afisa.</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />Kẹ ẹlẹn lan, ishim ẹlẹlẹ la nyan kẹ ọntran. <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />Kẹ aywuẹ lan, uDimitiriyas, akyuan ana ọyẹra azurfa kẹ ọmẹn ọga ohwu ọnwọ Artemis lẹ udu ikli lakẹnkan lẹ itrim ọyẹra. <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />Ala dra ididu ọnuse ọtuan nga shin okon udu itrim izun lan ka kọ ghan shin, ka kọn nẹma shin, “Ekyii, Unu za shin e nyin okon ikli lapam lẹ itrim lẹn huo. <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />Unu e shin kẹ a kọọn emle shin uBulus lẹn woo ẹhurẹ ada lapam kẹ ẹshan Afisa kẹ ididu ẹbọn Asiya tuhuan kẹ asọ wan uvro onum. Òó too wan shin, ẹnọm shin ayẹ-yẹra lẹn, kyẹ ẹnọm ẹplẹpan yaa wan. <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />Ọkọọn ibun soo lakẹkan sablọ shin, kyẹ itrim enyin kẹ ẹkpaa kẹ ambrẹ kẹ izun ma tushin ọga ohu ọnwọ Ọnọm alalẹ Artemis, alliya ni uvro wọ tuhuan Ọnọm enyin shin ada kon ọdọọ kẹ ididu ẹbọn Asiya kẹ ohun ledidu ni nga ọta ukon ọrọmdọ kẹ ọnhuọ ada wan.”<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />Le ushin a kọọn kẹn, amua la nyan ma lakẹnkan tuhuan ala sa iwe shin, “ enyin alalẹ nga oso Artemis a nga Afisawa!” <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />Kẹ ẹlẹn izun, ẹshan lan la ovro kọ. ánàá ẹshan lan la frẹ ana usee usoon uBulus bi kẹ ọMakidoniya, ọGayus kẹ Aristarkus ka kpon ma kẹ ẹlẹn izun kan lẹ ọmẹn ọga ọklan ada. <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />uBulus le nii ọ nyẹran ọmẹn idri ada lan tushin apaduan lan le re ghan. <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />Huọ Eple ana dradọn kẹ onusee uBulus bi kẹ ẹbọn Asiya la otoo uBulus shin ka lẹ a nyẹran ọmẹn idri ada lan ma. <verse eid="ACT 19:31" /><verse number="32" style="v" sid="ACT 19:32" />Anushin a klan kẹ ọnhuọ lan la ba lẹ etrekpe, alọ wan kẹ ọmẹn ma la frẹ pkẹn onyun, ana ọmpam za wan ọnkyẹ shin ọsọ ẹma so kẹ ọnhuọ lan ma. <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />Eple Ahahudawa la ta Alekzanda anyẹ kalẹ ekyee kẹ otoo ada ọnkyẹ shin usoo kẹ ọnhuọ ọba. Alezanda la sa anyẹn kan lẹ aprẹn shin ada fua. <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />Lẹ shin a kpẹ shin ẹ nga anyahudawa ghan, ala sa iwẹ kẹ kọ wan shin, “Ana alale nga oso Artemis a nga Afisawa!”<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />Ana ọrẹn ẹshan lan sọ idri ada lan la fuwa tuhuan ka kọ ghan lẹ ma shin: “Alọ soo kẹ ọmẹn ohun lẹn shin àá za ghan shin ẹshan enyi ẹlẹlẹ -Afisa ẹn kọ ikon aklọ lẹ ọga ohu ọnwọ Ọnọm ọlọlẹ enyi Artemis, Ọnọm shin iriri ghan sri bi kẹ aprẹn ma? <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />Ọnwọ ọsọ unu fua ledidu unu, kalẹ unu nẹghẹ lẹ ẹhọọ wan sablọ bọ ana ọya ẹna lẹ ọnkyẹ lẹn ma. <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />Unu shìn, ekyii shin unu okon ba lẹ ọnhuẹn lẹn so ọnyan uje ọnlẹghẹ kẹ ọmẹn Aga ohu enyi ma bọ ahuọ tua Ọnọm enyi ma. <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />Tushin inshin Ọdimitiriyus kẹ onusee itrim nga so lẹ aprẹẹ kẹ alọ, onkoo prẹẹ ataan kẹ ukikun tuhuan ana ọprẹ ataan ywua lẹ azọ. Okon aprẹẹ wan ma. <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />Inshin uple ọnlẹghẹ soo shin unu ni utoo, enii usem wọ kẹ ọmẹn unkoo ọprẹ ataan lẹ. <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />Ushìn, enyi ta ẹn sọ ishim la nyaan kẹ ẹshan lẹn sablọ ọnkyẹ shin ọba kẹ umbin inshi enyi mle wan utoo ada ọnkyẹ shin ukon ishim lẹn ma.” <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />Lẹ shin ana ọrẹn lan hurẹ utoo kẹn, ala ma ana ọprẹ ataan lan anya.<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s">Ọmẹn ọMakidoniya kẹ uHellas</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />Ẹlẹn shin ishim lan la ya wọ, uBulus la tuan lẹ apaduan lan, le ushin àá hurẹ ọma wan ẹhurẹ ẹdọ, ala laa wan ka frẹ ọntraan kan ghan lẹ ọMakidoniya. <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />Àá osoon kẹ ọmẹn ọMakidoniya la ama ada lapam ẹhurẹ ẹdọ sẹ ẹlẹn shin àá fuan uHellas wọ <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />Ọnhuọ shin àá ywua ẹprẹn ẹtaa. sablọ shin aYahudawa kyẹ uni udu ghan ebebi ẹlẹn shin àá kyẹ uni ọkpẹẹn kan lẹ uSuriya, ọnwọ ala kpọn udu ka eywure ghan ọMakidoniya. <verse eid="ACT 20:3" /><verse number="4" style="v" sid="ACT 20:4" />uSufata, arẹn ọFarus bi kẹ uBiriya nga la kaan nga wọ, kẹ Aristarkus kẹ ọSakundus bikẹ ọMakidoniya, ọGayus bikẹ ọDarbe, kẹ uTimoti, uTikikus ọTarofimus, bikẹ ẹbọn Asiya. <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />Ekyii lẹn kpoon kan wan akaaka zọ enyi kẹ ọToruwas. <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />tushin enyi a kpẹẹn bikẹ uFilibi akaaka okon ewedri enyi kẹ uToruwas a ta ọhuọ hurẹ ẹpaan ubrodi shin usoo wọ lẹ uyisti wan.<verse eid="ACT 20:6" /></para>
  <para style="s">Anyọọn uYutakus bikẹ ọmẹn itun kẹ uToruwas</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />Aywuẹ inzuun kẹ ọtẹkpa aywuẹ otumpua, enyi aklan kyẹ ọya ubrodi. uBulus la frẹ pẹẹ lẹ ada sẹ anka otu sablọ shin èé nii ọlaa ẹshaan lan wọ ọnwaa ubun. <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />Ẹla ọma ọsẹẹ soo lapam kẹ ọmẹn unkoo aprẹn lan shin enyin aklan kẹ ọmẹn lẹn. <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />Eple arọfuọ shin adrọ ghan shin uYutikus la trẹtraa kẹ aprẹn ọtaga, kẹ afrẹ ọna ọ̀na ghan lakẹnkan lẹ ushin uBulus ywua kẹ ọnhuọ ọpẹẹ lẹ ada. Lẹ ushin ọna kpọn ghan, ala osrom bikẹ aprẹn unkoo ọnyaan ẹtaa, ka kpaa ba lẹ ẹbọn ala kpẹkpon ọkrọọ ghan ata ọhuọ hurẹ ukpo ghan. <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />uBulus le sri kan lẹ ẹbọn, kẹ eshee ongbun ka hwua ghan, kẹ ekee ghan lẹ anyẹẹn ghan tuhuan kẹ akọ ghan shin, “Kalẹ unu shee àkpa wan, ohyu atrẹ ”. <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />Ala ywure ka nyaan kan gha lẹ aprẹn tuhuan ka faa ubrodi ka ya. Lẹ ushi àá pya onyun kan lẹ ọshaa ombun, ala okpo kan ghan. <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />Ada la kpọn arọfuọ lan ka trẹ kan wan lẹ ẹshaan wọ tuhuan ala okon ẹhurẹ ẹdọ.<verse eid="ACT 20:12" /></para>
  <para style="s">uBulus klan kẹ onokon ama Afisa</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />uBulus soon kẹ ẹbọn kan lẹ Asus, ọnhuọ shin èé nii enyi kẹ okon ghan wọ, enyi tọ ọhuọ kon usoon kẹ ọmẹn ọkpa ambrẹ. <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />Le ushin òó kon enyi kẹ Asus, enyi la kpọn ghan kan lẹ uMitilin. <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />Ọnwaa ubun, enyin la kpẹẹn kẹ ọkpa kẹ ẹnga kẹ esri kẹ ukiyos. Lẹ ombun shaa, enyi la eywure ka akpẹẹn kan lẹ ọSamos, tuhuan ọnwaa ubun, enyi la fuan uMitilin. <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />Tushin ubulus la kpon udu shin ẹnga ni ọkpẹẹn kẹ ẹnga sẹẹ Afisa sablọ kalẹ ẹnga tẹgha kẹ ẹbọn Asiya wan, sablọ shin ẹnga kya udiduo kẹ ẹnga fuan Urushalima edre ọnọm ọFentikos ta ọsọ ba wan inshin uni uyi.<verse eid="ACT 20:16" /></para>
  <para style="s">uBulus ma onokon ana ubii ama Afisa anya</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />Kẹ uMiletus, uBulus la tuan lẹ onokon ana ukon ekyee Abaan Ọnọm amma Afisa. <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />Lẹ ushin aba, ala kọ ghan shin: “Unu za emle shin imi la aywua wọ kẹ unu huọ ilon ẹlẹn yaau, kẹ ọnyaan kẹ idre ọnọm imi aba lẹ ẹbọn Asiya wọ. <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />Imi anaa lẹ ẹkyuẹ mi kẹ ẹbọn kẹ udu ọtuan Ọnọm lẹ edre mi, tushin ala maa mi lẹ ebebi aYahudawa. <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />Unu za shin imi traan mi ulolo ọnlẹghẹ shin usoo kẹ agyagyuan kẹ ọnhuọ ọywua unu mat ushin imi a frẹ ulolo unu kẹ aprẹn edre ada tuhuan ọnyaan ẹn ka abaan kan lẹ ẹn kaa. <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />Imi ahurẹ u too aYahudawa kẹ eHelenawa shin ọdọ wọ eywure wan ọnhuọ Ọnọm lẹ ọkpaa ẹtrẹẹ tuhuan kẹ okon ọkpọn lẹ ẹhurẹ kẹ ọmẹn Ekyee Abaan enyi ọYẹsọ.<verse eid="ACT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 20:22" />“Kaladẹn, Iri Ọnọm so mi ọkon lẹ Urushalima lẹ ọdọ, bọ ọza ọnkyẹ shin uni ọba mi kẹ ọnhuọ lan. <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />Ọnkyẹ shin imi za lehule wọ uso shin, huọ ilon ẹshan nga kọ, Iri Ẹsẹẹ ka la mi ẹn nyẹẹn shin unkoo ẹva kẹ ọhyua ẹva ywuà lẹ ọzọ mi. <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />Tushin imi akpọn mi ọrẹ mi shin ọnlighẹ wọ wan, inshin imi ta ẹn hurẹ utitọn lẹn tuhuan kẹ imi hurẹ ọtuan shin Ekyee Abaan ọYẹsọ ma mi--ọntuan unyin esheshii ihyuu ishishii Ọnọm.<verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />“Ẹladẹn, Imi za shin bọ alọ unu kẹ ọmẹn anushin imi a huọ uklem lẹ imi lolo wan aprẹẹ ẹgọn Ọnọm ni uywure kẹ eshin mi. <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />Ọnwọ ọsọ, imi kyẹ utoo unu kẹ ubin shin, eji alọ enkyii so wan kẹ aprẹn ẹkyuẹ mi ma, <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />sabọ imi otoo unu ididu ọnkyẹ shin Ọnọm nii. <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />Unu kon aklọ lẹ akyuẹ unu kẹ ididu anushin Iri Ẹsẹẹ sọ unu kẹ anyẹẹn. Unu frẹ upyee Abaan Ọnọm shin àá lọ lẹ eji ghan. <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />Imi za shin inshin imi okpo kan mi, eple áva onum ni utro kẹ ọmẹn unu tuhuan bọ àla ọlaa àtẹẹn lan ma. <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />Huọ kẹ ọnyaan kẹ ẹlẹn nẹẹ, eple ekyii unu ni ọnyaan kẹ odu ifuo kẹ ẹplẹpan sablọ kẹ ẹma woo ana ubii kẹ ere wan kan. <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />Ọnwọ ọsọ, unu ywuà lẹ unu za! Unu za shin amẹẹ ata kẹ ẹladẹn, mi so utrim ọlà unu ẹn nyẹẹn ma otun kẹ aywuẹ lẹ edre mi.<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />“Imi asọ unu kẹ anyẹẹn Ọnọm kẹ ẹnrẹn esheshii ghan, shi uni ọvra unu tuhuan kẹ ama unu ọkà kẹ ọmẹn ididu anushin ohurò wan la dẹ-dẹy. <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />Imi sọ mi ẹhurẹ lẹ ikli huọ ọnkyẹ alo wan. <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />Inu ka kyuakyuan za shin imi odu ọtuan lẹ ayẹ mi sabọ imi kon ọnkyẹ imi tẹ kyẹmu kẹ onushin oso kẹ imi. <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />Ididu ọmprẹ shi imi oton nu ni, ọgbaa shin inu du ọtuan lakanka sabọ enyi shẹ anushin asuwan lẹ ọdọ wan ayẹn kọ. kẹ unu ka wan lẹ aprẹ Ekye abaan uKristi shin, ‘Ọsẹ lẹ ọgyagyuwan shin ẹngọ ma lẹ shin ẹngo ngrẹ.’ ”<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />uBulus hurẹ ọpiya oyun la, ele she ọngbun ka pẹ lẹ Ọnọm kẹ ma lẹ diduwan. <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />Ididukawan lẹ huọ ukruẹ ka huọ kyua nga kẹ huọ nin gha oyun, <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />Ọnkyẹ shin ọlọ wan wọ sọ aprẹ shin otoo wan shin, ẹnii ma utu shii nga ma. Ala ka kaa ngan kalẹ ọnhuọ ọkpa ambrẹ.<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s">Uson uBulus Kalẹ Urushalima</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />Elẹn shin enyi huọ ọla wan, enyi la nyẹran kan wan lẹ ọmẹ ọkpa ambrẹ kẹ okpon kan wan lẹ uKos, ọnwaa ubun enyi lẹ okpon kan lẹ uRodes, ọnyan kẹ ọnhuọ lan enyi lẹ okpon kan wan lẹ ọFatara. <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />Enyi okon ọkpa ambrẹ kyẹ ọkpẹn kan lẹ uFinikiya, enyi la nyẹran kẹ akpẹn kan wan. <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />Kẹ ala edre lẹ ọSayifurus, enyi la okpon kan asha ohun ẹya, enyi la akpẹn kan wan lẹ uSuriya. Enyi la fuan oTaya, ọnhuọ shin ọkpa enyi nii uwli ọnkyẹ wọ. <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />Lẹ shin enyi kẹ okon apaduan lan kẹ ọnhuọ lan, enyi la ywua kẹ ẹma aywuẹ otumpua. Lẹ Iri a lẹ ma uBulus ẹkyẹẹ shin kalẹ a kan lẹ Urushalima ma. <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />Tushin ẹlẹn huọ ọba, enyi la laa wan kẹ afrẹ ọntraan enyi. Ididu apaduan kẹ ashẹ kẹ arẹn ma la ka laa enyi kẹ ititim ẹshan, Ọnhuọ lan enyi lẹ ata ongbun kẹ ayẹẹ udriin lan kẹ apẹẹlọnọm,<verse eid="ACT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 21:6" />Enyi huọ ma eple anya, enyi la nyẹran kan wan lẹ ọmẹ ọkpa, tuhuan e le ywure wan ẹshan. <verse eid="ACT 21:6" /><verse number="7" style="v" sid="ACT 21:7" />Enyi la frẹ uson enyi bi kẹ oTaya, enyi la kẹ afuan uTolemayis, ọnhuọ shin enyi lẹ odruu lẹ ewedri, kẹ aywua kẹ ẹma aywuẹ ozun. <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />ọnwaa ubun enyi la okpon kan wan lẹ oKaisariya, tuhuan kẹ aywua ọmẹ abaan uFilibus ana utoo aprẹẹ Ọnọm, ana ozun kẹ ọmẹ anọ otumpua. <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />Òó soo lẹ orodruan anang shin a so ọnya ma uson ẹbra wan, ana ọ kẹ otoo ombun ma. <verse eid="ACT 21:9" /><verse number="10" style="v" sid="ACT 21:10" />Lẹ ushin enyi huọ ukon aywuẹ kẹ ọnhuọ lan, èple onu shin adrọ ghan shin Agabus la ba bi kẹ ọga ẹbọn ọYahudiya. <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />Ushin Agabus ba lẹ ọnhuọ lan, ala kpọn iwẹ uloo ebre uBulus. Kẹ oloo anyẹ kẹ afran nga ka kọ shin, “Ọkyẹ shin Iri Ẹsẹẹ too wan, ‘Emle lẹ nga aYahudawa ana Urushalima nii uloo ana iwe uloo ebre tuhuan kẹ ama anushin osoo wan aYahudawa wan ẹnga.’ ” <verse eid="ACT 21:11" /><verse number="12" style="v" sid="ACT 21:12" />Lẹ shin enyi akọọn klan, enyi kẹ anushin o soo kẹ ọnhuọ lan la wẹn uBulus kalẹ a kan lẹ Urushalima ma. <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />uBulus le kye ka kọ ghan lẹ ẹma shin, “Unsẹ wan ọsọ unu kon ukyue lẹ unu sọ ẹhurẹ mi kyẹẹ ya? Imi akpọn lẹ ẹhurẹ mi shin kalẹ ọtigha lẹ uloo lehule wan, tushin kẹ imi kpo mi kẹ Urushalima lẹ ọntua Ekye abaan ọYẹsọ.” <verse eid="ACT 21:13" /><verse number="14" style="v" sid="ACT 21:14" />Lẹ shin enyi abran ma ukye ẹhurẹ ghan ma, enyi la fuwa, ka kọn wan shin, “Ọnkyẹ shin Ọnọm nii, ọba.” <verse eid="ACT 21:14" /><verse number="15" style="v" sid="ACT 21:15" />Anyẹn huọ ukpon, enyi le sem akyuẹ enyi tuhuan kẹ okpon kan wan lẹ Urushalima. <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />Eple apaduan bi kẹ ọKaisariya la kan enyin, tuhuan kẹ okon enyi ba lẹ abaan ọManason ọnhuọ enyi lẹ nii ọywua wọ, ẹnga enkyii ghan bi kẹ ọSayifurus, ana ozun kẹ ọmẹ apaduan ọtekpa.<verse eid="ACT 21:16" /></para>
  <para style="s">uBulus kẹ afuan Urushalima</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />Lẹ enyi kẹ afuan Urushalima, ewedri la ngrẹ enyi lẹ enshiin. <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />Ọnwaa ubun uBulus kẹ enyi la kan kẹ ushìn ọYakub, Ididu onokon soo kẹ ọnhuọ lan. <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />Lẹ shin àhurẹ udru lẹ ẹma, tuhuan ẹ ọnkyẹ shin Ọnọm du kẹ ọmẹ anushin oso wan aYahudawa wan kẹ ọmẹ ọtuan nga. <verse eid="ACT 21:19" /><verse number="20" style="v" sid="ACT 21:20" />Lẹ shin a kọọn an yẹn, ala ablẹ Ọnọm. Ka kọ wan lẹ uBulus shin, “Ngọ shìn ewedri, ana atlẹ ọkọ amaa ama aYahudawa ma akpọn lẹ ẹhurẹ, tuhuan ididu wan lẹ akpọn iywuro lẹ oshong. <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />A huọ utoo wan shin , unu lolo ididu aYahudawa anushin aywua kẹ ọmẹ anushin oso wan aYahudawa wan Shin ekyem kẹ alaa uMusa wọ, lẹ otoo wan shin kalẹ ataa arẹn ma utun ma huọ ọywua emle udu ọnkyẹ enyi. <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />Unse wan enyi nii udu? E nii ọkọọn ngọ aba, <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />Ọklan wọ du ọnkyẹ shin enyi otoo ngọ. Ekyii anang soo kẹ enyi shin a kpaa onyun. <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />Kpọn amẹn ekyii lẹ, froo anyẹ kẹ ọsọ ọba ladẹdẹy wan tuhuan kẹ ngọ kyura ọnkyẹ shin aprẹ, sablọ ekyèè akyuẹ wan.Tuhuan huọ ẹnga nga nii ọkpẹẹ shin ẹplẹpan so ya wọ kẹ ọmẹ ọnkyẹ shin unu otoo lẹ kẹ aprẹn unu ma, tushin unu kẹ akyuakyuẹ unu ywua udu ọnkyẹ shin iywuro too. <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" />Tushin aprẹẹ ana ubii shin osoo wan aYahudawa wan lan, enyi ahuọ rẹn kalẹ ẹma kẹ otoo wan ọkpọn udu enyi shin, oton ma ọnkyẹ ọya shin aman ugunki wan, huọ ẹnam Tushin anushin soo wan aYahudawa wan shin oso ana ubii, enyi rẹn wan ọzaa ọnkyẹ shin enyi akpọn shin, kalẹ aya ọnkyẹ ọya shin ama ẹnọm ma, kalẹ aya eji wan, kalẹ aya ẹnam shin epye ọntọn lẹ ma, kalẹ unu nẹn kẹ ekyii huọ ashẹ eple wan.”<verse eid="ACT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />Ọnwaa ubun uBulus la akpọn ekyii lan kẹ ẹnga kẹ akaaka ohulo akyuẹ wan. Tuhuan ka nyẹran ọmẹ unkoo ọpẹlọnọm kya kan utoo aywuẹ shin enii ọhurẹ uhulo akyuẹ lan kọ, tuhuan a lẹ ọma agyuan sablọ huọ olon enyi ghan wọ.<verse eid="ACT 21:26" /></para>
  <para style="s1">Afrẹ uBulus</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />Aywuẹ otumpua la huọ ọbyan ukpon, eple aYahudawa bi kẹ Asiya shìn uBulus kẹ ọmẹ abaan ọpẹlọnọm. Ala sẹn ididu ada tuhuan ka frẹ ghan, <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />Lẹ etri ẹkpa wọ, “ Ekyii ama Israˈilawa, unu ta enyi ayẹn kọ! Enkyii lẹ nga okon ulolo ididu ada huọ ulon ọnhuọ ghan wọ shin a tran ma enyi, kẹ iywuro enyi kẹ ọnhuẹn. Tuhuan kẹ ọkon eHelenawa ba lẹ ọmẹ abaan Ọnọm enyi. ka okon anọ uHelenawa kọn ọmẹ etin abaan Ọnọm kẹ asọ iluwe kẹ ọnhuọ abaan Ẹsẹẹ.” <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" />(A huọ ushìn uTurofimus, ana Asiya kẹ ọmẹ eshan lan kẹ uBulus kẹ alaa shin uBulus nga okon ghan ba lẹ ọmẹ abaan Ọnọm.) <verse eid="ACT 21:29" /><verse number="30" style="v" sid="ACT 21:30" />Ẹshan la ngrẹ lẹ yiri, ada la klan bi kẹ huọ ulon use ghan wọ. Ka frẹ uBulus, lẹ ẹywui ghan bi kẹ ọmẹ abaan Ọnọm. Tuhuan kẹladran alẹ ohrun atigha kan. <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />Lẹ shin oso kẹ ọnhuọ ọyẹ kyẹ ọprẹ ghan ihyuu la fuan ana ekye ọgraa osoja uRoma shin, ididu Urushalima so kẹ ọmẹ ishim. <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />Ẹnga kẹ ẹlẹn izun la kpọn eple ana ekye kẹ osoja kẹ otrunton kan lẹ ọnhuọ idri ada. Lẹ shin ana ishim lan shìnana ukon ekye osoja kẹ osoja ghan, ala laa ọkẹn uBulus kan. <verse eid="ACT 21:32" /><verse number="33" style="v" sid="ACT 21:33" />Ana ukon ekye osoja la frẹ uBulus, kẹ asọ oloo ghan lẹ iwe ọyẹra epua. Kẹ onun nga shin ẹnga nga so ẹnga? kẹ ọnkyẹ shin odu. <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />Eple enyi ma kẹ ọmẹ idri ada lẹ etri ẹkpa wọ kẹ ọmẹn kẹ ọnmaa ọnkyẹ, tuhuan ana ukon ekye osoja kon ghan ẹplẹpan ma sablọ ishim shin ẹ̀ẹ́ nya lan, a la ma onyun shin akpọn uBulus kan lẹ ọmẹ ọnhuọ ọywua osoja. <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />Elẹn shin uBulus fuan ẹkrafran, ishim ẹn ya ana ọtrọ ishim lan soo ẹdọ lakẹnkan shin osoja la kpọn ghan. <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />Idri ada shin e re wan kan la frẹ utri ẹkpa wọ, “Unu kpon kẹ ẹnga!”<verse eid="ACT 21:36" /></para>
  <para style="s1">uBulus Pẹẹ lẹ Idri ada</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />Lẹ shin osoja kyẹ ọkpọn uBulus kan lẹ ọnhuọ ọywua wan, e le luwe ana ukon ekye osoja , “Imi kyẹ ọpẹẹ lẹ ẹngọ?” “ Ẹngọ za utoo ẹda ẹnyẹ eHelenawa?” E le kye ka kọ ghan shin, <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />Ẹngọ kyẹ ana ọMasar lan nga shin aa okon ishim ma tuhuan kẹ o woo ana ọpẹẹ ada ana atẹlẹ ọkọ anang lan kan lẹ ọmẹ ifonum kẹ iple ẹlẹn shin i kpon ma?” <verse eid="ACT 21:38" /><verse number="39" style="v" sid="ACT 21:39" />uBulus le kye ka kọ ghan shin, “Imi anBayahude ghan bi kẹ oTarsus kẹ ọmẹ uKilikiya, imi ana ẹshan ẹlẹlẹ ghan ẹn kẹ ẹplẹpan. Imi wan, laa mi kẹ imi pẹẹ la ada.” <verse eid="ACT 21:39" /><verse number="40" style="v" sid="ACT 21:40" />Lẹ shin o kon ọma onyun ana ukon ekye osoja, uBulus la tigha kẹ aprẹn ọkpra kẹ enyin ma lẹ ọnyẹ shin a fua. Lẹ shin ididu wan ngrẹn la ywuẹt, ala kọ ghan lẹ ẹma lẹ ẹda ẹn ya Aramaya.<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />“Ewedri mi kẹ anushin e ben enyi, unu ngẹn mi atọn kẹ imi too unu ọnkyẹ shin ọba, sablọ kẹ imi yin unu shin imi sam lẹ amben ma.” <verse eid="ACT 22:1" /><verse number="2" style="v" sid="ACT 22:2" />Leshin a kọn shin apẹẹ lẹ ẹda Aramaya, ala fua la ywuẹt. A la kọ ghan shin, <verse eid="ACT 22:2" /><verse number="3" style="v" sid="ACT 22:3" />“Imi anBayahude ghan, obyon mi kẹ oTarsus, ẹn kẹ uKilikiya, tushin imi a nyan ọfuọ kẹ ẹshan lẹ. Imi apua ẹnrẹn kẹ ẹfa oGamaliyel, anushin òó lolo ulolo akpẹẹ enyi tuhuan imi so ifuo Ọnọm kawa emle shin huọ ẹnga nga kẹ ọmẹ unu soo wọ kẹ umbin, <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" />Imi atrọ lẹ ana ure ọnwẹn ọntraan lẹ kan kẹ apẹẹ wan, kẹ afẹn ekyii kẹ ashẹ imi akẹ asọ wan kẹ unkoo, <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />kawa elme shin àkpẹẹ umee enshin kẹ ọgbaa onokon ada tẹ atigha kẹ otoo wọ. Imi ala ngaan azaa bi kẹ ọnhuọ ọywua wan kan lẹ ọnhuọ ewedri wan kẹ uDimashku, tuhuan kẹ akan lẹ ọnhuọ lan kyẹ ukon ekyiwan lẹ ba lẹ Urushalima kẹ ama wan ẹva.<verse eid="ACT 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />“A kyẹ ọlaa erete aywuẹ lẹ ushin Imi aba akaaka kẹ uDimashku, kẹ ẹlẹn izun ọsẹẹ ọlọlẹ bi kẹ aprẹmẹn la asaan kẹ ekee mi kan. <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />Imi la akpaa kẹ ẹbọn tuhuan ka kọọn iwe shin lẹ imi, ‘oShawulu!, oShawulu!, unse wan ọsọ ẹngọ kon ọtrọ lẹ imi?’<verse eid="ACT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 22:8" />“‘Ẹ nga nga oso ẹngọ, Ekye Abaan?’ a la kọ ghan lẹ imi shin,</para>
  <para style="p" vid="ACT 22:8">“ ‘Imi nga oso ọYẹsọ ana ọNazaret, anushin ẹngọ kon ọma ghan ẹva.’ <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />Anushin osoo kẹ imi shin ọsẹ, bọ akọọn iwẹ anushin okon ọpia onyun kẹ imi ma.<verse eid="ACT 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 22:10" />“ ‘Unsẹ wan imi nii udu ekyee Abaan?’ Imi lẹ elue.</para>
  <para style="p" vid="ACT 22:10">“Ekyee Abaan la kọ ghan shin,” “‘Nyẹnyan’, kẹ ẹngọ nyẹran ọmẹn uDimashku. Ọnhuọ shin eni utoo ngọ ididu ọkyẹ shin ẹngọ ni udu wọ.’ <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />Anushin osoo kẹ imi ma ala frẹ mi ọnyẹn kalẹ ọmẹn uDimashku, sablọ shin ọsẹ lan ọla aprẹm edree kọ<verse eid="ACT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12" />“Epele enyi shin adrọ nga shin Hananiya la aba lẹ ọnhuọ ywua mi. Enga kẹ odu Ọnọm ọtuan kalẹ elemle shin ihyuro uMusa lulo wan, anushin ididu aYahudawa shin a ywua kọn ọnhulan kẹ shin shi atra ifu kẹ edree. <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />A kọn lẹ imi shin, ‘ewedrim ọShawulu, shii ẹhuọ!’ kẹ ẹladran ire edree mi lẹ kun mi, imi nẹ shii ghan.<verse eid="ACT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 22:14" />“Ala kọn nga shin, ‘Ọnọm arakpẹ enyi wẹn ngọ kẹ ẹngọ ọkpẹ ẹhurẹ ghan, kẹ ẹngọ shiin anọ ẹpẹlẹpan ni, kẹ ẹngọ kọn ọpẹẹ oyun ghan. <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />Sablọ ẹngọ nii ukyẹ edree ghan kẹ ididu ada ọnkyẹ shin ẹngọ shiin kẹ a kọn. <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />Kẹ ẹladẹn unse wọ ẹngọ kọn zọ? nyẹnya kẹ odu ngọ ọbaftisma kẹ ohuro ngọ ilovro ngọ, kẹ ọmẹn ọdra ọntua ekye abaan.’<verse eid="ACT 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />“Uyure mi balẹ Urushalima, imi so kẹ ọnhuọ ọpẹẹ lẹ Ọnọm kẹ ọmẹn unkoo ọpẹẹ lẹ Ọnọm, imi na la ala. <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />Kẹ eshiin Ekye abaan kẹ ọpia oyun, ‘nyẹnyan ladrẹndrọ!’ ‘kẹ ẹngọ laa Urushalima kẹladẹn, sablọ e nii ma ngrẹ ọnkyẹ shin ẹngọ nii utoo wan kẹ aprẹ mi ma.’<verse eid="ACT 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 22:19" />“ ‘Imi nẹ kye ka kọ mi lẹ ngan shin,’ ‘ekyi lẹn za shin imi kẹ se kelem kẹ abaan ọpẹẹ lẹ Ọnọm kẹ imi lolo kẹ ọkẹn kẹ so anushin akpọn lẹ ẹhurẹ wan kon onkoo. <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />Ẹlẹn shin apre Istifanus anọ shin atia ngọ, imi soo kẹ ọnhulan imi ma oyun tuhuan ka zọ ọnbapia anushin apre ghan.’<verse eid="ACT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 22:21" />“Tuhuan ekye abaan la kọn nga na mi shin, ‘Kpo kan; Imi nii ọtuwan kalẹ ananọọ kalẹ ọnhuọ anushin asawan aYahudawa ma.’ ”<verse eid="ACT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />Idri ada la ngẹn nga atọn sẹ ẹlẹn shin ahuọ utoo ọnkyẹ lan. Ala sa unwe wan shin, “Aprẹ ghan” ọgbaa wọ shin a ywua ywua kẹ ohun ma!” <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />Ala frẹ usre àkpa lẹ atlẹ ọnkyẹ utri wan kan lẹ aprẹ lẹ a sọ unywi, <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />agọn osoja lan la sọ akpọn uBulus kan lẹ ọmẹ ọBarke osoja. Tuhuan kẹ a ma onyun shin atàà ghan ìluwe kẹ luwe ghan ọnkyẹ shin ọsọ ada kon ọkẹn ghan onyun kẹn. <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />Lẹ ushin a hurẹ ulo ghan kyẹ ọkẹn ghan, uBulus la kọ ghan lẹ osoja alalẹ shin à kyẹẹn kẹ ọnhuọ lan shin, “Iywuro too shin akẹn enkyi ana uRoma bọ a nyaan ọprẹ ghan atààn tuhuan kẹ okon ghan lẹ uvro wan?” <verse eid="ACT 22:25" /><verse number="26" style="v" sid="ACT 22:26" />Lẹ ushin onsoja alalẹ lan kọọn kẹn, ala kan lẹ ọnhuọ ekye osoja lan kẹ otoo ghan shin. “Unse wan ẹ ngọ nii udu kẹladẹn?” “Enkyi lẹn ana uRoma ghan?”<verse eid="ACT 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27" />Ekye osoja lan la ba kẹ e lue uBulus shin, “too mi ma, ẹngọ ana uRoma ghan?” Ala kọ ghan shin, “ Ẹẹn, I mi ngan”<verse eid="ACT 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28" />Tushin agọn osoja na la kọn ghan shin, “Imi nii ọkrua ikili ọpam kalẹ ẹbọn mi.”</para>
  <para style="p" vid="ACT 22:28">“Olo ubio mi ana ẹbọn,” uBulus lẹ ekye ghan kalan.<verse eid="ACT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29" />Anushin ele unii uluwe ghan ọmprẹ la fuwa kẹ aladrẹn. Osoja lan lẹ huọ kọn ibun ẹlẹn shin akpẹn shin uBulus anushin ẹ ghan loo nga anọ uRoma nga.<verse eid="ACT 22:29" /></para>
  <para style="s1">uBulus ẹmpakye Onokon</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />Ọnwua ubun, agọn osoja nii ọkpẹ la kpẹkpẹrẹ ọnkyẹ shin aYahudawa shin uBulus du, ala la nga tuhuan kẹ adra akpẹn ọma ẹnshii kẹ onokon eshan a klan. Ele we uBulus kọn otoo nga shin atiya ẹnpakye ada.<verse eid="ACT 22:30" /></para>
  <para style="b" />
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />uBulus le ewee onokon lan lẹ edre tuhuan kẹ a kọ ghan shin, “Ewedrim, imi a hurẹ ọtuan mi kẹ ọnhuọ Ọnọm tuhuan ẹhurẹ mi kọọn ushi kẹ ubin.” <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />Lẹ ọkọọn kẹn, akpẹẹ ana umee enshin alalẹ Hananiya la man onyun shin anushin akyẹ̀ẹ́n kẹ ayẹẹ uBulus lan là uBulus kẹ onyun. <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />uBulus la kọ ghan lẹ ngaa shin, “ẹngọ ma Ọnọm ni ọhuọ lan ngọ, ẹngọ ivre shin ala yaa ẹzua ikyikyii! ẹngọ a trẹtraa kẹ ọhuọ lan kyẹ ọprẹm ataan emle shin iywuro toou, tushin huẹ ẹngọ ma huọ uvro lẹ ushin ẹngọ a man onyun shin alam!”<verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />Ana ushin akyẹẹn kẹ ayẹẹ uBulus lan la pẹẹ shin, “ẹ ngọ ata tua ana umee enshin alalẹ an nga Ọnọm?”<verse eid="ACT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5" />uBulus le kyee shin, “Ewedrim, imi a kpẹẹm shin ẹ nga ana umee enshin alalẹ ghan ma; sablọ a rẹn shin: ‘Ka lẹ ẹngọ too utri kẹ aprẹn ana ukon ekyee ada ngọ ma.’ ”<verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />Tuhuan lẹ ushin uBulus za shin eple enyi ma kẹ ọmẹn ma aSadukiyawa wan tuhuan amma enyi ma aFarisiyawa wan, ala sa iwe kẹ ọmẹn ọklan onokon shin, “Ewdrim, imi anBafarisiye ghan, arẹn anBafarisiye. A kyẹ ọprẹẹm ataan sablọ ọsọ ẹhurẹm lẹ ọnyẹnyaan bikẹ ọmẹn itun.” <verse eid="ACT 23:6" /><verse number="7" style="v" sid="ACT 23:7" />Lẹ ushin òó too kẹn, ọya ẹnà la nyaan kẹ ọmẹn aFarisiyawa kẹ aSadukiyawa, tuhuan ọklan lan la kam mẹn. <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />aSadukiyawa lan shin, ọnyẹnyaan bikẹ ọmẹn itun soo wọ wan, tuhuan atuan Ọnọm soo wan ma bọ Iri soo wan, tushin aFarisiyawa man ẹhurẹ lẹ ọmmaan ledidu. <verse eid="ACT 23:8" /><verse number="9" style="v" sid="ACT 23:9" />Ọnwọ ishim la nyaan, tuhuan eple ávuá ulolo iywuro shin aYahudawa wan la tẹgha ka ya ẹnà lakẹnkan shin, “Enyi okon wan enkyi lẹn lẹ uvro wan, unkyẹ utoo wan. Ẹnga nga aza huọ Iri huọ atuan Ọnọm huọ ọpẹẹ lẹ ẹngaan?” <verse eid="ACT 23:9" /><verse number="10" style="v" sid="ACT 23:10" />Ishim lan la ba kẹ ibibi lakẹnkan ọnwọ ushin àna ukon ekyee osoja lan la nyaan ọkọọn ibun kalẹ ekyi wan lan gigree uBulus man. ọnwọ ala ma ososja onyun shin esri kan lẹ ẹbọn kẹ asa kpon uBulus lẹ ọdọ kẹ anyẹẹn ma kẹ okon ghan balẹ ọmẹn ọbariki. <verse eid="ACT 23:10" /><verse number="11" style="v" sid="ACT 23:11" />Ẹnkaa otu, Ekyee Abaan la tẹgha kẹ ayẹẹ uBulus ka kọ gha shin, “Du ẹhurẹ ẹdọ! Emle shin ẹngọ enyin ọza mi kẹ Urushalima wọ lẹn, ọdọ wọ lẹ ẹngọ huọ unyin ọza mi kẹ uRoma.”<verse eid="ACT 23:11" /></para>
  <para style="ms">Otoo aprẹẹ ọprẹ uBulus</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />Lẹ ọshaa ombun, aYaudawa la kpọn udu tuhuan kẹ etre shin ẹma ni ma ọya huọ ọhwua wan sẹ ẹma prẹ uBulus. <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />Anushin akpọn udu lẹn srẹ ekyii ẹhuẹ ẹnang. <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />A kaan lẹ ọnhuọ ekyee akpẹẹ umee enshin kẹ onokon ka kọ wan shin, “Enyi a hurẹ utre shin enyi ni ma ọya ọnlẹghẹ wan sẹ enyi aprẹ uBulus. <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />Ọnwọ ọsọ kẹladẹ, unu kẹ ọklan onokon wan ana ukon ekyee osoja lan kẹ okon uBulus balẹ ọnuọ ọywuang kawan unu ni uywure kẹ unu vun aprẹẹ ghan la kpẹkpẹrẹ. Enyi ni ọprẹ ghan ata ọsọ ọonyaan ọfuan ọhuẹn ma.”<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />Tushi lẹ ushin arẹn afuọ uBulus kọọn ọnkyẹ shin akyẹ unii udu, ala kan lẹ ọmẹn ọbarki akaaka otoo uBulus. <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />Kẹladran, uBulus la dra eple onsoja ka kọ ghan shin, “kpon arọfuọ lẹn kan lẹ ọnhuọ ana ukon ekyee osoja lan; oso lẹ ọnkyẹ shin enii utoo ghan” <verse eid="ACT 23:17" /><verse number="18" style="v" sid="ACT 23:18" />Onsoja lan la kpon arọfuọ lan kan lẹ ọnhuọ ana ukon ekyee osoja lan ka kọ ghan lẹ ẹnga shin, “uBulus, shin osoo kẹ unkoo lan, tuam shin imi kpon arọfuọ lẹn balẹ ọnhuọ ywuang sablọ shin oso lẹ ọnkyẹ shin enii utoong.” <verse eid="ACT 23:18" /><verse number="19" style="v" sid="ACT 23:19" />Ana ukon ekyee osoja lan la frẹ arọfuọ lan kẹ ọnyẹẹn, kẹ owoo kan lẹ ọmẹn abaan tuhuan kẹ elue ghan shin, “Unse wan ẹ ngọ ni utoom?” <verse eid="ACT 23:19" /><verse number="20" style="v" sid="ACT 23:20" />Ala kọ ghan shin, “aYahudawa frẹ ọkpọn udu kyẹ ọwa waang kẹ ẹngọ kon uBulus wan balẹ ọnhuọ ọklan onokon lẹ oturaa ombun kawan ẹma kyẹ unii uywure kẹ ẹma vun aprẹẹ ghan lakpẹkpẹrẹ. <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />Kalẹ ẹngọ ngẹn ma atọn ma, sablọ ekyii shin a srẹ ana ẹhuẹnang kẹ ọmẹn ma kon ọzọ ghan kyẹ ọprẹ. A hurẹ utre shin ẹma ni ma ọya huọ ọhwua wan sẹ ẹma prẹ ghan. A ywuaa la zọ kẹladẹn, lẹ ọkpaa onyung.” <verse eid="ACT 23:21" /><verse number="22" style="v" sid="ACT 23:22" />Ana ukon ekyee osoja lan la là arọfuọ lan ẹn nyẹẹn shin, “Kalẹ ẹngọ too alọ shin ẹngọ otoom aprẹẹ lẹn” tuhuan ala la kẹ okpo kan ghan.<verse eid="ACT 23:22" /></para>
  <para style="ms">Akpọn uBulus kan lẹ ọnhuọ agọn uFelis</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />Kẹladran, àla dra osoja adradọ apua ka man wan onyun shin, “Unu kpọn ọgraa ososja atẹlẹ ọkọ ẹhuẹpua, kẹ osoja ẹhuẹ itumpua ana ọnyẹ ẹkau, kẹ osoja atẹlẹ ọkọ ẹhuẹpua anaa ahurẹ́, kẹ unu son kan lẹ ọKaisariya lẹ ẹlẹn itunaa ẹn kẹ otu. <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />Unu nii ẹkau unu kpọn uBulus kọ lẹ inshii kan lẹ ọnhuọ uGwamna uFelis” <verse eid="ACT 23:24" /><verse number="25" style="v" sid="ACT 23:25" />Àá rẹn ẹnrẹn kẹn: <verse eid="ACT 23:25" /><verse number="26" style="v" sid="ACT 23:26" />ọKalaudiyus uLisiyas, Kan lẹ ana alalẹ, uGwamna uFelis: Ẹngọ ashaa lẹn. <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />aYahudawa la frẹ enkyii lẹn kyẹ ọprẹ tushin imi la kan ofuo ghan kẹ ọgraa osojam, sablọ imi akpẹẹ shin ẹnga ana uRoma ghan. <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />Imi ala kon ghan balẹ ọnhuọ onokon wan sablọ shin imi enii ọkpẹ ọnkyẹ shin ọsọ okon ọtua ghan. <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />Imi la kpẹẹ shin okon ọtua ghang sablọ ulolo iywuro wan, tushin bọ ilovro ghan lan mẹẹ aprẹ ghan huọ asọ ghan kẹ unkoo ẹva wan. <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />Lẹ ushin otoom ọnkyẹ shin ẹma kyẹ unii udu ghan, imi la sọ ghan kẹ ọntraan ba lẹ ọnhuọ ọywuang kẹ ẹlẹn izun. tuhuan imi la otoo anushin oso lẹ aprẹẹ kẹ ẹnga lan shin ama otoong uvro ghan. <verse eid="ACT 23:30" /><verse number="31" style="v" sid="ACT 23:31" />Ọnwọ ọsọ osoja lan la kpọn uBulus kẹ ọmẹn otu lan emle shin otoo wang kan lẹ Antifatiris. <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />Ọnwa ubun, ala laa osoja ẹkau lan kẹ okpo kan wan kẹ ẹnga, tuhuan ẹma la eywure wan ọmẹn ọbariki. <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />Lẹ ushin osoja ẹkau lan fuan ọkaisariya, ala man uGwamna uFelis ẹnrẹn ana ukon ekyee osoja alalẹ lan tuhuan ka so g uBulus kẹ ẹfaa ghan. <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />uGwamna lan la pua ẹnrẹn lan tuhuan ka elue ghan shin ilon ẹbọn nga kẹ ẹnga trou lẹushin àá kpẹẹ shin ẹnga bikẹ uKilikiya. <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />Ala kọ ghan shin, “imi ni ọngẹn atọn lẹ uvrong ẹlẹn anushin oso lẹ aprẹẹ kẹ ẹnga lan fuan ọhuẹn non.” Tuhuan ala man onyun shin eteghe uBulus kẹ ọmẹn ozoo ẹgọn Iridus<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s1">Ọmaa uBulus kẹ ọnhuọ uFelis</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />Ititim aywuẹ otong, Hananiya, akpẹẹ umee enshin alalẹ, eple onokon kẹ èple ana ọprẹ ataan shin adrọ shin ọTartulus lẹ akpọn ẹkra uBulus kan lẹ ọnhuọ uGwamna kẹ uKaisariya. <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />Ẹlẹn shin adraa uBulus kan lẹ ọmẹn ozo lang, ọTartulus la otoo uFelis ẹkra uBulus: “Enyi a huọ ọkọọn ushi ọnaa ẹhurẹ ẹlẹn lapam kẹ ọtrẹkyuẹ kẹ ẹngọ, tuhuan ẹbọn enyi kon ọkan ekye sablọ ushin ananọ ngọ. <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />Enyi alalẹ, uFelis, huọ ulon ọnhuọ ghan wọ kẹ ọmẹn uhuọ unsewan, enyi a sọ ngọ ẹjaa lakẹnkan. <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />Tushin sablọ imi niim ọya ngọ ẹlẹn ma, imi kyẹ ọwan ngọ shin kikun ngọ, ngẹn atọn lẹ enyin la hyuẹ.<verse eid="ACT 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 24:5" />“Enkyi lẹn ana ọpya ọmprẹẹ ghan, ana ọtrọ ọhuẹn kẹ ọmẹn aYahudawa kẹ ididu ohun. Àá nga oso ana ukon ekyee anaa ọntẹ shin adrọ shin aNazarawa <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />tuhuan okon unii ọntraan ọsọ Abaan Ọnọm lẹ ilue; ọnwọ ọsọ enyi afrẹ ghan. <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />Tushin uLisiyas ma ngrẹn ghan lẹ ọdọ kẹ anyẹẹn enyi. <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />Inshin ẹngọ elue nga kẹ ẹkyuẹkyuẹ ngọ, ẹngọ nii ọkpẹ ẹplẹpan ididu ẹkra shin enyi okon ma kẹ aprẹẹ ghan.”<verse eid="ACT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 24:9" />aYahudawa la fra ghan ititim ẹkra lan le nyin shin ọnkyẹ utoo ọTartulus ẹplẹpan yaa.<verse eid="ACT 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />Ẹlẹn shin uGwamna ma uBulus epiin ọpẹẹ, ala ekye shin: “Imi za shin àmẹẹ lapam ẹngọ kon ọprẹ ataan kẹ ẹbọn lẹn; ọnwọ ọsọ lẹ ọmọ imi nii ọhuẹn ẹkyuẹ mi. <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />Inshin ẹgọn awaan lẹ inshin, ẹ ngọọ nii ukoon uso ọnya ọsrẹ aywuẹ akọ lẹ apua wan lẹ ushin imi a kaan lẹ Urushalima kyẹ odu ọtuan Ọnọm. <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />Ana ukon ẹkram lẹn kon wan imi kẹ ọnhuọ ọya ẹnà kẹ alọ huọ ọpya ada ẹhurẹ kẹ ọmẹn Abaan Ọnọm huọ uple ọnhuọ kẹ ọmẹn ẹshan ma. <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />Tuhuan osoo wan lẹ umle unyin ngọ shin, ẹplẹpan ẹkra shin ẹma du kẹ aprẹn mi ma. <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />Tushin, imi ngrẹn uvrom lẹ ushin imi adọọ Ọnọm ọnwọ akpẹẹ enyi kawan ana ure ọntraan shin ẹma drọ shin, ‘ọklan ana ọntẹ’. Imi a kpọn ẹhurẹ mi uhuọ unse wan shin arẹn kẹ ọmẹn iywuro uMusa kẹ azaa ónu, <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />Tuhuan imi so lẹ ọsọ ẹhurẹ ute uzun lan kẹ Ọnọm kawan ekyiwan lẹn, shin ididu ana ẹsẹẹ kẹ ana ebebi nii ọnyuọn nga bikẹ ọmẹ itun. <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />Ọnwọ ọsọ imi kon ọyẹ huọ ulon ubon nga wọ kẹ imi teghe ẹhurẹ mi ladẹdẹy bọ uvro kẹ ọnhuọ Ọnọm kẹ enyetri.<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />“Ọnwọ ọsọ imi balẹ Urushalima kyawa man enyi ana emrin agyuan kẹ ẹjaam. <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />Ọnkyẹ shin imi osoo kẹ ọnhuọ udu wẹn ọnwọ ala ba kawa okon mi kẹ ẹmpakyee Abaan Ọnọm. Idri ada soo ya kẹ imi ma bọ imi osoo kẹ ọnhuọ ọpya ada ẹhurẹ wan. <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />Tushin eple aYahudawa soo bikẹ ẹbọn Asiya, anushin ọgbaa osoo kẹ ọnhuẹn kẹ ekyee ngọ. <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />Kẹladẹn, imi abyan shin anushin osoo kẹ ọnhuẹn tóó ọnkyẹ shin ẹma konm kẹ ọnhuọ udu kẹ ẹlẹn shin imi ategha kẹ ẹmpakyee onokon <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />inshin kyẹ ọnkyẹ shin imi alẹ otoo wẹn kẹ ẹmpakyee wan ma shin: ‘Ọtrẹkyuẹ kẹ ọnyẹnyaan bikẹ imi itun wọ ọsọ okon ọprẹẹm ataan kẹ unbin.’ ”<verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />uFelis, anushin àá hurẹ ọkpaa ẹlẹẹ kẹ emle udu ọnkyẹ wan, ala sa ọtrẹtraan lan. Kẹ akọ ghan shin, “inshin ana ukon ekye osoja lan ba lẹ uLisiyas, imi nii ọwa aprẹ lẹn.” <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />Ala otoo onsoja alalẹ shin afrẹ ọzọ uBulus lẹ ushin lẹ aman ghan apra ẹkyuẹ ghan tuhuan kẹ aman onusee ghan epiin kẹ okon aklọ lẹ ọnkyẹ unii ghan ledidu. <verse eid="ACT 24:23" /><verse number="24" style="v" sid="ACT 24:24" />Ititim aywuẹ lapam, uFelis la ba kẹ ashẹ ghan uDurusila, ana oYahudiya. Àá tuan lẹ uBulus kẹ angẹn atọn lẹ ẹnga kẹ aprẹn ọkpọn lẹ ẹhurẹ lẹ uKristi ọYẹsọ. <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />Lẹushin uBulus too ghan aprẹẹ ọdẹdẹy ẹhurẹ kẹ ọfrẹ-ẹkyuẹ kẹ ọprẹ ataan shin ọkyaa, uFelis la nyaan ọkọọn ibun, “ọmẹ klan kẹladẹn! Ẹngọ ta unkpo kang. Inshin imi okon epiin, imi ni ọtuan lẹ ẹngọ.” <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />Aa sọ ẹhurẹ shin uBulus ni ọma ghan ikli, ọnwọ ọsọ aa ka tuan lẹ uBulus kẹ iblibun, lẹ ahwua ẹywua kẹ ngaa. <verse eid="ACT 24:26" /><verse number="27" style="v" sid="ACT 24:27" />Lẹushin àmẹ̀ẹ̀ apua kpoon, uFokiyus Festus la kpọn ọtuan uFelis, tushin uFelis ni unyin aYahudawa ọbyan, ala laa uBulus kan kẹ unkoo.<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s">Ọmaa uBulus kẹ ẹmpakyee uFestus.</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />Aywuẹ ataa le ushi a fuan ẹbọn lan, uFestus la nyaan kẹ ọKaisariya kan lẹ Urushalima, <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />Ọnhuọ shin akpẹẹ umee enshin kẹ áná ukon ekyee aYahudawa la ba lẹ ọnhuọ ọywua ghan ka otoo ghan ẹkra uBulus. <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />Ọnwọ ala wan shin ama wan uFestus la drẹndrọ sablọ ọbyan kẹ ẹma kọn ushi, ka wa kpọn uBulus kan lẹ Urushalima, sablọ shin ẹma kon unii ọntraan ọdaa kẹ ọmẹn ọmbọn kẹ ẹma prẹ ghan kẹ ọnyraan. <verse eid="ACT 25:3" /><verse number="4" style="v" sid="ACT 25:4" />ọFestus la ekyee shin, “a frẹ uBulus kẹ ọKaisariya, tuhuan imi ẹkyuẹ mi kya kan mi ọnhuọ lan bọ ọywua wan. sọ kẹ ọnhuọ zọ uBulus kẹ kaisariya, nga ma nọ la ọnhwẹn kẹ ladẹn <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />Eple ana ukon ekyee ama unu ba kẹ imi ka wa too ilovro enkyii lan kẹ ọnhuọ lan. inshi òó vro.” <verse eid="ACT 25:5" /><verse number="6" style="v" sid="ACT 25:6" />Lẹ ushin òó huọ ukon aywuẹ ananaa huọ akọ kẹ ẹma, ala kpoon kan ghan lẹ ọKaisariya, tuhuan ọnwaa ubun, àla otun ada kẹ ọmẹn ozo lan tuhuan ka ma onyun shin okon uBulus balẹ ọnhuọ ọywua ghan. <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />Lẹ ushin uBulus ba, aYahudawa shin ala huọ ba bikẹ Urushalima la tẹgha kẹ ayẹẹ ghan, lẹ otoo ilovro ẹdẹrẹdọ lapam kẹ aprẹẹn ghan, shin emle wan unyin ẹplẹpan lẹn ma. <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />uBulus la ngrẹn ẹkyuẹ ghan kẹ akọ ghan shin: “Imi sọ ọnya mi uvro huọ udu ọnlẹghẹ shin ukon udu ifuo kẹ iywuro ẹn yẹ aYahudawa huọ Abaan Ọnọm huọ kẹ ọKaisar wan.” <verse eid="ACT 25:8" /><verse number="9" style="v" sid="ACT 25:9" />Lẹ ushin uFestus nii ọnaa aYahudawa lẹ ẹhurẹ, ala kọ lẹ uBulus shin, “Ẹngọ tọ umle ọkan lẹ Urushalima kẹ ẹngọ sa tẹgha kẹ amaa ngọ kẹ ẹmpakyee mi kẹ ọnhuọ lan kẹ aprẹẹ ilovro lẹn?” <verse eid="ACT 25:9" /><verse number="10" style="v" sid="ACT 25:10" />uBulus la ekyee shin: “Imi nga ẹn kyẹ̀én kẹ ẹmpakyee ozo ọKaisar lẹn, ọnhuọ shin ọgbaa amàá mi wọ. Imi so ọnya mi udu aYahudawa ọnlẹghẹ ububi wan emle shin ẹngọ ẹkyuẹ ngọ za wọ lakpẹkpẹrẹ. <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />Tushin inshin imi ovro ọnwọ shin ọgbaa aprẹ mi, imi ni mi ọtraan mi ukpo mi ma. Tushin inshin ilovro shin aYahudawa lẹn too kẹ aprẹn mi lẹn ọntẹ wan, bọ alọ shin osoo lẹ ọdọ shin atọ asọ mi kẹ anyẹẹn ma man. Imi kon ọwan ọKaisar!”<verse eid="ACT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12" />Lẹ ushin uFestus la huọ ọtrẹtra kẹ aprẹẹ uBulus kẹ ana ọprẹ atààn lan, ala ma onyun shin: “Ẹngọ awaan ọKaisar. Ọnhuọ ọKaisar wọ ẹngọ nii ọkan!”<verse eid="ACT 25:12" /></para>
  <para style="s1">ọFestus lue agọn Agiriffa</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />Aywuẹ la hyuẹ, agọn Agiriffa kẹ uBanis kan lẹ uKaisariya kyẹ udruu lẹ uFestus. <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />A kyẹ unii ukon àywuẹ lapam kẹ ọnhuọ lan, uFestus la otoo aprẹẹ uBulus kẹ agọn lan, shin: “Eple enkyii soo kẹ ọnhuẹn shin uFelis laa ghan kẹ ọnhuẹn kẹ unkoo ẹva. <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />Ẹlẹn shin imi akan lẹ Urushalima, akpẹẹ umee enshin kẹ onokon aYahudawa lẹ okon aprẹẹ uBulus wan tuhuan kẹ wan mi kẹ imi ma ghan ilovro.<verse eid="ACT 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 25:16" />“Imi lẹ otoo wan shin kyẹ emle udu ọnkyẹ oRomawa ghan ama alọ uvro bọ anyaan ọmaa ghan kẹ ẹmpakyee anushin oso lẹ aprẹẹ kẹ ẹnga ma tushin àá huọ ukon epiin ọhuẹn ẹkyuẹ ghan kẹ aprẹn ilovro lẹn. <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />Lẹ ushi aba lẹ ọnhuẹn kẹ imii, imi la afrẹ mi aprẹẹ lan ma, tushin imi a tun ada kẹ ọmẹn ozo ọprẹ atààn kẹ ọnwaa ubun tuhuan ka ma onyun shin okon enkyii lan ma. <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />Lẹ ushin ana shin oso lẹ aprẹẹ kẹ ẹnga nyẹnyaan kẹ apẹẹ, imi lẹ okon ẹnga lẹ uvro wan. <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />Ọnkyẹ shin imi akpẹẹ wọ uso shin, ẹma soo lẹ aprẹẹ kẹ ẹnga kẹ aprẹẹ ure Ọnọm kan kẹ aprẹẹ ọYẹsọ, enkyii shin àá hurẹ ukpo ghan tushin uBulus kon utoo shin ohyu atrẹ. <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />Lẹ ushin imi arẹn ẹhurẹ mi kẹ emle shin imi nii uvun aprẹẹ lẹn wọ, utrekpe la frẹ mi imi; ọnwọ imi le lue ghan inshin atọ emle ọkan kẹ amàá ghan kẹ Urushalima kẹ aprẹẹ ilovro lẹn. <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />Lẹ ushin uBulus wan shin akpọn ghan kan lẹ ọnhuọ ọKaisar kẹ asa prẹẹ ghan atààn, imi la man onyun shin azọ̀ ghan sẹ ẹlẹn shin imi ni ọsọ ghan kẹ ọntraan balẹ ọnhuọ ọywua ngọ.”<verse eid="ACT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22" />Ọnwọ agọn Agiriffa la kọ ghan lẹ uFestus shin, “Imi ni ọkọọn enkyii lẹn kẹkyuẹ-kyuẹ mi.”</para>
  <para style="p" vid="ACT 25:22">Ala ekye ghan shin, “Ẹngọ ni ọkọọn ghan lẹ ombun.”<verse eid="ACT 25:22" /></para>
  <para style="s1">uBulus kẹ ẹmpakyee Agọn Agiriffa</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />ọnwa ubun, Agiriffa kẹ oBanis la ba lẹ ọmẹn unkoo lan kẹ ẹglẹgọn kẹ osoja adradọ kẹ ana adradọ ẹshaan lan shin ere ghan kẹ ititim. Lẹ ushin uFestus ma onyun, ala okon uBulus ma. <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />ọFestus la kọ ghan shin: “Agọn Agiriffa, kẹ ididu anushin osoo kẹ enyi, unu shín enyii lẹn! Ididu ẹbọn aYahudawa kon mi lẹ ilovro kẹ aprẹẹ ghan kẹ Urushalima tuhuan kẹ ọKaisariya lẹn, lẹ asla unwe wan shin ọgbaa wọ shin alaa uBulus kẹ atrẹ wan. <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />Imi okon mi ẹnga lẹ iple ilovro shin ẹ̀ẹ́ mẹ̀ẹ́ shin aprẹ ghan ma, tushin sablọ shin àá wan ushin ọKaisar, ọnwọ ọsọ imi la sọ akpọn ghan kan lẹ uRoma. <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />Tushin imi soo mi lẹ ọnlẹghẹ ẹkpẹkpẹrẹ shin imi ni ọrẹn kan lẹ ọnhuọ enyii alalẹ kẹ àprẹẹn ghan ma. Ọnwọ ọsọ imi okon ghan ma balẹ ọnhuọ ọywua unu ledidu, tuhuan ansrẹ lẹn, ẹngọ agọn Agiriffa, sablọ shin imi kòn ọnkyẹ shin imi ni ọrẹn kẹ aprẹẹn inshin ẹngọ ahurẹ uvun aprẹẹ ghan kẹ ubin. <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />Sablọ uyi wọ wan shin asọ alọ kẹ ọmẹn unkoo ẹva bọ a nyaan ọmaa ghan ma.”<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s">uBulus Traa Ẹkyuẹ ghan kẹ ẹmpakye Agiriffa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />Agriffa la kọ ghan lẹ uBulus shin, “Ẹngọ so lẹ epin ọngrẹn ẹkyue ngọ,” Ọnwọ uBulus la sa anyẹẹn ghan, kẹ afrẹ ọkraa ẹkyuẹ ghan: <verse eid="ACT 26:1" /><verse number="2" style="v" sid="ACT 26:2" />Agọn Agiriffa, Imi shìn ẹkyuẹ mi ana asẹẹ lẹ ọtigha kẹ ẹmpakye ngọ kẹ unbin lẹ ọtraa ẹkyuẹ mi kẹ ididu òtu shin aYahudawa taa mi,. <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />ẹngọ za emle udu ọnkyẹ kẹ ọya ẹna. Ọklan wọ imi kyẹ ọwan ngọ kẹ ẹngọ ngẹn atọn lẹ imi lẹ oshong. <verse eid="ACT 26:3" /><verse number="4" style="v" sid="ACT 26:4" />Ididu aYahudawa za emle shin imi a ywua wọ kyikyuo lẹ ushin imi ohyu arọfuọ, bi kẹ ọtẹkpa ọywua mi kẹ ẹbọn ẹn kẹ imi, tuhuan kẹ Urushalima. <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />Ema za mi kyikyuo, tuhuan a tẹ atigha kẹ otoo ẹplẹpan, inshin abyan, emle ubii shin ọsrẹẹ lẹ ọkyẹkyọ ọnwọ enyi, imi a ywua mi kawa anBafarisiye. <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />Tuhuan kẹladẹn sablọ ọsọ ẹhurẹ mi lẹ ọnkyẹ shin Ọnọm kpaa apẹẹ enyi onyun shin okon ọmaa mi kẹ unbin. <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />Ọkpaa onyun shin ẹda ẹkọ lẹ ẹpua sọ ẹhurẹ ushìn ọkuag emle shin ẹma du Ọnọm ọtuan wọ otu kẹ aywuẹ. Agọn, sablọ ọsọ ẹhurẹ lẹ wọ aYahudawa ta mi otu wọ. <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />Unse wan ọsọ huọ alọ unu shìn shin Ọnọm nii nga ọnyuọn anushin e kyure wan ma?<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />“Imi ẹkyuẹkyuẹ mi lẹ eshìn shin ọgbaa shin imi du huọ unse wan kẹ imi tran mi ọntua ọYẹsọ ana ọNazaret. <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />Tuhuan ọnkyẹ shin imi odu wlan kẹ Urushalima. Lẹ ọdọ ákpẹẹ umee enshin imi asọ ana ọdẹdẹy lapam kẹ unkoo ẹva, tuhuan lẹ shin a pẹẹ wan, imi la ma ọfraa ititim ma. <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />Imi la son ọnya kẹ unkoo ọpẹlọnọm kan lẹ ọnwaa kan ọma wan ẹva, kyẹ ọsọ wan kẹ ọdọ wọ kẹ otoo aprẹẹ Ọnọm kẹtrẹtrẹ. Kẹ imi la du amua kẹ ẹma lakẹnkan, imi la kan lẹ uple ọnbọn kan ọma wan ẹva.<verse eid="ACT 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />“Kẹ uple isoon mi imi ala kya kan lẹ Damashku lẹ ọdọ kẹ ọzaa shin ákpẹẹ umee enshin ma. <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />Lẹ erete aywuẹ, Agon, lẹ shin imi oso kẹ ọntraan, Imi lẹ eshìn ọsẹẹ bi kẹ aprẹmẹn, osẹẹ lẹ srẹ osẹẹ Ọnọm, lẹ ọkaan kẹ ekee mi kẹ onuse uson mi. <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />Enyi lẹ ekple kẹ ẹbọn ledidu enyi, tuhuan imi la kọọn iwe ẹ kọ lẹ imi lẹ ẹda Aramaya, oShawulu, oShawulu, unse wan ọsọ ẹngo kon ọtrọ lẹ imi? Uso ọnaa lẹ ẹngọ du ifuo kẹ imi<verse eid="ACT 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 26:15" />“Imi lẹ onun, ‘Ẹnga nga oso ẹngọ, Ekye abaan?’</para>
  <para style="p" vid="ACT 26:15">“ ‘Imi nga so ọYẹsọ, anushin ẹngo kon trọọ lẹ nga,’ Ekye abaan lẹ ekye ghan. <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />Nyẹnya kẹ ngọ tigha. Imi enyin ẹkyuẹ mi ke ọnhuọ ọywua ngọ kyẹ ọsọ ngọ kye ana ọtuan kẹ ana ọtigha kẹ otoo ẹplẹpan ọnkyẹ shin ngọ huọ ushìn ọnwọ emi kẹ ọnkyẹ shin imi nii unyin ngọ. <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />Imi nii uwe ngọ bi kẹ ọmẹ ényi ngọ kẹ ọmẹ anushin osoo wan aYahudawa wan. Imi nii ọtuan ngọ kan lẹ ẹma <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />kẹ ngọ ma okun ma atọn kẹ ngọ kye wan bi kẹ itum ba lẹ ọsẹẹ, tuhuan bi kẹ ọdọ ọshaidan ba lẹ ọnwọ Ọnọm, sablọ a ngrẹn uywuro onyun ilovro wan tuhuan kẹ ngọ kon epin kẹ ọmẹ anushin a plàn lẹ ọdọ ẹhurẹ kẹ ọmẹ mi.<verse eid="ACT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />“Ọklan wọ, Agọn Agiriffa, Imi a tran mi udu ọnkyẹ shin unyin kẹ ọmẹ ala bi kẹ aprẹmẹn ma. <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />Ọtẹkpa kan lẹ ana shin oso kẹ uDimashku, tuhuan kan lẹ anushin oso kẹ Urushalima kẹ ididu ọYahudiya, tuhuan kẹ anushin oso wan aYahudawa wan. Imi otoo ihyuu ishishi shin a kpaa ilovro wan tuhuan kẹ ekyem kan lẹ ọnhuọ Ọnọm tuhuan kẹ enyin ọkpaa ilovro wan lẹ emle udu ọnkyẹ wan. <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />Ọnkyẹ shin ọsọ aYahudawa frẹ mi kẹ etin abaan Ọnọm kẹ ayẹ kyẹ ọprẹ mi. <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />Tushin Imi huọ ukon ọta anyẹ Ọnọm ba lẹ unbin lẹ, ọnwọ ọsọ Imi atigha kẹ ọnhuẹ kẹ otoo aramran kẹ onokon ẹplẹpan. Imi soo mi kẹ ọnhuọ utoo ọnlighẹ ka sẹẹ ọnkyẹ shin ónu kẹ uMusa too shin unii ọba , <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />shin, uKristi lẹ hyua ẹva tuhuan, ana ọtẹkpa ọnya kẹ itun, a lẹ utoo enyi nga ihyuu ọsẹẹ tuhuan kẹ ana uso wan aYahudawa wan.”<verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />Lẹ shin ọfuan kẹn ọFestus lẹ ashẹ onyun lẹ ọtraa ọnwọ uBulus. “Ẹkyuẹ ngọ kye kọ, uBulus!” A la sa iwe. “Ọpua ẹnrẹn ngọ lakẹnkan sọ ngọ ekye ogbon.”<verse eid="ACT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25" />uBulus le kye ka kọ ghan shin, “Imi kyẹ ogbon ghan ma, ana alalẹ ọFestus,” “Ọnkyẹ shin imi so kẹ ọnhuọ utoo unu ẹplẹpan ya kẹ ọmẹ ọnaa ẹhurẹ mi. <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />Agon za lẹ ọmẹn ọnkyẹ lẹ, tuhuan imi tẹ imi pya onyun bọ ibun. Imi akpọn lẹplẹpan shin bọ ọnkyẹ shin aza ghan ma kẹ ọmẹ ọnkyẹ lẹ ma, sablọ o du wan ọnlighẹ kẹ ayẹ wan. <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />Agon Agiriffa, ngọ akpọn ónu lẹ ẹhurẹ ngọ? Imi za shin ẹngọ akpọn lẹ ẹhurẹ ngọ.”<verse eid="ACT 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28" />Ọnwọ Agiriffa la kọ ghan lẹ uBulus shin, “Ngọ mle shin kẹ ọmẹ ẹlẹn ọhyuẹ lẹ ngọ tọ umle uwoo ẹhurẹ mi kẹ imi kye ana ubii?”<verse eid="ACT 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29" />uBulus la kọ ghan shin, “Ẹlẹn ọhyuẹ huọ ẹn ya ọpam Imi kon ọpẹlọnọm shin kyẹ ẹngọ nga kẹ inzun ngọ ma tushin ididu anushin okon ọkọọn mi kẹ unbin yọ ọba kawa emle shin soo wọ, bọ iwe ayẹra lẹ ma.”<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />Agon lẹ nya, kẹ ẹnga ugbomna kẹ ọBanis kẹ anushin atrẹtraa kẹ ẹnga. <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />Ala laa unkoo lan, tuhuan oso kẹ ọnhuọ ọpya onyun kẹ eple wan, a la kọ wan shin, “Enkyi lẹ soo ghan kẹ ọnhuọ udu ọnlighẹ shin ọgbaa ukpo huọ asọ ghan kẹ unkoo ẹva wan,”<verse eid="ACT 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 26:32" />Agiriffa la kọ ghan lẹ ọFestus, “A nyaan alaa enkyii lẹn awà shin àá wan ghan ushin ọKaisar ma.”<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s">uBulus kpẹẹn kan lẹ uRoma.</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />Lẹ ushin a hurẹ ọkpọn udu shin enyi ni ọkpẹẹn kan lẹ Italiya, ọnwọ ala sọ uBulus kẹ eple ana íwe kẹ ántọn kẹ ẹfa eple onsoja alalẹ, ọntua ghan ma uso uYuliyus, shin osoo kẹ ọgraaososja lan. <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />Enyi la nyẹran ọkpa kẹ Adiramitiyum kyẹ unii ọkpẹẹn kan lẹ ẹbọn Asiya, tuhuan enyi lẹ eple ashan anyọ shin oso kẹ ayẹ Asiya, tuhuan enyi na kpon kawa lẹ ọmẹ udrin. Aristarkus, eple Tasalonika kẹ ẹbon ọMakidoniya, oso kẹn nyin<verse eid="ACT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 27:3" />Ọn waa ubun ẹnyin la ka fuan ọsidon; kẹ oYuliyus, la ma uBulus uhyuo ẹhurẹ,alaa ghan kẹ aywua kẹ onusee ghan kawa ma nga ọnkyẹ shin enii. <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />bi kẹ ọnhuọ lan enyi la nya kẹ kpon kawa lẹ ayẹ udrin tuhuan urun la nya kẹ ẹnpa ekye wan. Onwo la sọ shi enyi le kyee kẹ titim tsbirin oSayifurus ọnhwo shin uru na ọ saw ọdọ wa. <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />O shi enyi ko hwre kpẹn utekwu shin uso koka kẹ ebon okilikiya kẹ ọFamfiliya, enyi fuwan Mira kẹ ebon uLikiya. <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />Ọn klan a nà lalẹ nga a soja Roma ala kon okpa Alenkzandiriya ana kya kan lẹ ebon Italiya, ka sọ enyi kan ko men.<verse eid="ACT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 27:7" />Enyi la kpon aywuẹ la pam kọ ọnhwo soson lẹ shọng,enyi kọn eva tuhuan kẹ fuwan ka kẹ eshan ukinidus.Eleshin uruun le re nyi ukpon klan, onwọ ọsọ enyi ne ukee kọ onwọ shi uruun soo wọ wan, eleshin kẹ titim tsibirin kirit a ka kẹ Salmoni. <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />Enyi na kọn eva tuhuan ko kpon, eleshin enyi la fuwan uple ọnhuọ shin a dro shi ọnhuọ da ka kram, akaaka ka kẹ eshan elelẹ Lasiya.<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />Eyin bẹn ẹlẹng la pam. Eleshin u sọn na la ba kọ bubi, ọnwọ sọ shin ẹlẹn na lo kpọn ẹnyọ kọn ẹwọn uBulus la mawan ẹkyẹẹ. <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />Ala kọ gha lẹ ma shin, “Ọnọm ẹ gbran ọ trẹ, imi shin u son ni lọ soo kẹ ububi tuhuan ka kon okpa wan la pam, bọ okpa ọnwọ ọkpaw kẹ ọnkyẹ ma, kọ ọrai eyin.” <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />Atushin eyin lalẹ a ngha asoja la ngre gha ọkyẹnshin uBulus to wa, a tọ ngrẹn ọnkyẹnshin ano ta ọkpa kẹ no kpa la too gha. <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />Eleshin ọnhuo daa ọlasiya la sa o ka gyagyuan shin ẹkpa lan ya ẹkrọ lẹ kọ ọnhuo lan ma, eleshin eple enyi ma la kpọn lẹ ẹhurẹ wa shin ima nii frẹ soo kawan, tuhuan kẹ ẹ ma du ọdọ ẹhurẹ kẹ sa fuwan uFiniks, inshin shin ọ gba, sablọ shin kẹ ẹ ma ya ẹkrọ lẹ kọn klan. uFiniks lẹn u ple ọnhuọ kpa ọkpa wọ utsibirin Kiti ọnwọ shin ọ ta ekye kaw lẹ a shaa Ọnọm (arewa) kawo lẹ ọkpọ Ọnọm, kẹ kpọn (kudu) kawo lẹ ọkpọ Ọnọm.<verse eid="ACT 27:12" /></para>
  <para style="s">Ure Ẹvra Ọlọle Kẹ Udrin</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />U run la frẹ tọn lẹ shi shon bikọ ukudu, ada lẹ mlẹ shin ọnkyẹ shin e ma nii u kom, e lee shin ima lẹ woo ọdọ ọnwọ shin ọ frẹ ọkpa la, tuhuan a lẹ kpọn ka yẹ tsibirin kirit, a kaa ka kọ utrin. <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />A lẹn na hyẹẹ uple urun lọlẹ la ba bikọ asha ohun (arewa) kọ utro Ọnọm ka nya kawo tsibirin. <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />Ushin urun la ọkpa lan, u le milewo ọ takye kẹ urun na ma, eleshin enyi na la urun kọ kpọn lẹ enyi. <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />Lọ shin enyi kpọn kẹ wan lẹ titim uple tsibiri ọnwọ ka dra shin Kauda ọnhuo shin urun sa o ọdọ wa, ọ́ sa o kọka tuhuan enyi lẹ we ọkpa hyẹ lẹ ka tra aprẹn ọlọlẹ. <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />Ushin a huo hurẹ wòó ọkpa ọnwọ kpa hyẹrẹ bọ lẹ ọmen ọkpa ọlọlẹ, alo du ọntran kẹ loli iwe kyẹẹ ọkpa ọlolẹ lan, kọ sabloshin ọ huo zọnọ ma. Tuhuan a le shirii lẹ ezen ọkpa lan kọ sabloshin ima la urun kẹ kyen ọkpa la kọ sabọ shin ima mlẹ wan tàá wo wan. <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />Aleshin ambrẹ lan fra u ta aprẹn, ka fra nẹnghẹ ma la kẹn kan, lẹ ẹnka ayua ima la tẹkpàá mẹn ọnkyẹ wan shin ọn sòọ́ kẹ ọmẹn ọkpa la ka shire kẹ lẹ ọ mẹn ambrẹ. <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />Ayuẹn ẹntaan, ala eshee ọnkyẹ ọkpa lan kan lẹ ọmẹn ambrẹ lẹ anyẹ̀ẹ́ ma. <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />Lẹ ushin shin bọ Ọnọm ọsaan huọ orunkyin shin otro wan lẹ ayhuẹ lapam tushin ọsàá lan tẹ ọfrẹ ọkẹn mẹ, ọnwọ enyi la ewee ẹhurẹ enyi lẹ ufuwom.<verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />Lẹ ushin ekyii lan kon àywuẹ lapam bọ ọnkyẹ ọya, uBulus la tẹgha kẹ ẹmpakyee wan ka kọ ghan shin: “Ekyi, unu ada, unu nya unu ngrẹ ẹkyẹẹ mi kẹ anyẹran unu ọkpa ambrẹ bi kẹ usibirin Karista, unu traa akyuẹ unu lẹ ambẹn kẹ ọnkyẹ shin unu okon ma. <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />Tushin im mi kyu won ọ tọn kọ unu du ẹhurẹ ọdọ, sablọ shin ba a lọ shin ọtrẹ ghan nii u vroó kọ mẹn <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />Lẹ otu ọlẹ, atuan Ọnọm mi anushin imi kon udu ghan ọtuan tigha kẹ ayẹẹ mi. <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />kẹ kọ ghan lẹ nga shin, kẹ lọ ngo kyi ibun ma, uBulus. Engo nii ọ tigha kẹ empa kye agọn ọkaisar. Tushin kọ sablọ engo wọ Ọnọm kẹ ọmẹn ẹhurẹ ẹsẹsẹ gha alu wẹng kẹ unu su seng <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />Ọnwọ sọ shin unu du ehurẹ ẹdọ, unu ada, kẹ imi a sọ ọdọ ẹhure mi lẹ Ọnọm lẹ shin elẹmle shin otom kọ lan, a nga ọbawọ. <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />Tushin ọdọ wọ urun lẹ taw enyi klẹ aprẹn i shee utsibiri.”<verse eid="ACT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />Lẹ otu ẹn kẹ ọkọ lẹ ẹnaang, a la frẹ ọ ta a nyẹ lẹ enyi ka lẹ ọmẹn udrin uMeditereniya. Lẹ e rete otu ọnwọ a nọ taa ọkpa lan la mle shin enyi ba kaa ka kẹ ẹbọn <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />Ọnwọ a la maa ululom ambrẹ lan e le shi a fuan ẹ kàá fran a tẹlẹ lẹ ẹhuẹ ẹpuwa. enyi lẹ zem la hyẹ , a lẹ ka lọ maa kọ kon e ka fran ẹhuẹ itunaang. <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />Eleshin a kọn ibu shin ọkpa lan nii ọ lam kẹ ọpan, ọnwọ e le shiri lẹ eyara ẹdrẹ dọ ẹgbẹẹ naw kẹ ititim ọkpa lan kẹ sablọ shin ure ọkpa lan usosọn. ọnwọ a lẹ gbe edree ka wanang Ọnọm kẹ ọmbun sha lẹ hyuẹn hyun. <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />Tushin a nọ taa ọkpa lan lẹ nii utitong. ọnwọ e le shiri lẹ ọkpa ọ hyẹ a la frẹ du ọntraan shin ẹma nii ushiri lẹ eyara inshin yọ rọmdọ bi kọ ọmẹn ọkpa ọlọlẹ. <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />Ọnwọ uBulus la kọ ghan lẹ ansoja alalẹ uRoma kẹ a osoja, “Inshin ada lẹn atigha wa kẹ ọmẹn ọkpa lẹ ma, bọ elemlẹ shin unu nii ọ kram.” <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />Lẹ shin o kọn klan ọnwọ a soja lan lẹ tẹn iwe shin ikọn ọkpa lan tuhuan kẹ laa wo ku re ambrẹ kan.<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />Lẹ shin ombu byan ọ sha, ọnwọ uBulus la wan ma kẹ didu wa shin aya ọnkyu ya. ka kẹ ghan lẹ nga shin, “ayhuwẹ ọkọ la nang mẹn shin okpọn” “unu kon kẹ ọzọ, bọ unu a ya ọnkyu ya wa. <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />Ọnwọ sọ kẹ la dẹn imi kyuo wan unu ya ọnkyẹ ọya kẹ unu rẹ. Sablọ klan ba onu ozu shin isre kyuẹ izu ghan nii uvro wan.” <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />A la hure too klan, ọnwọ ala kpọn uburodi, tuhuan kẹ sọ Ọnọm ẹjaa kẹ pa kye wan lẹ didu. Tuhuan kẹ kam wọ kẹ tẹ kpa ọya. <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />Ọnwọ ẹma la kon ẹhurẹ ọdọ ọya ọnkyẹ ọya. <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />Lẹ edidu enyi osoo ana atẹlẹ apua lẹ ẹhuẹ itumpua lẹ ikyen (276) kẹ ọmẹ ọkpa lan. <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />Lẹ shin ẹma ya kẹ eshire emle shin ẹma nii wọ, ọnwọ a la sọ ọkpa lan ba lẹ asẹsẹghẹ lẹ ushre ẹrẹn aya lan kan lẹ ọmẹ ambrẹ <verse eid="ACT 27:38" /><verse number="39" style="v" sid="ACT 27:39" />Lẹshin ọtronbu shaa enyi lẹ shin ẹbọn, tushin ana ọta ọkpa lan la kpẹ wan ọnhuọ lan ma, tushin ema lẹ shin uple ọnhuọ idri ishee kẹ ayẹ ẹ ambrẹ, ala pẹẹ shin ẹma ni ọkpọn ọkpa wan kan lẹ aprẹn ishee lan inshin ẹma mle. <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />Ọnwọ ema la waa ididu iwe ẹyara ẹnyọ ọrọmdọ, tuhuan kẹ laa kẹ ambrẹ. tuhuan kẹ ẹlẹn izu e le ble iwe shin e kẹ kyire ọkpa lan. Tuhuan ema lẹ sa ezen ma shin oso kẹ ẹmpakye ọkpa lan kẹ emle shin urun nii uzee wọ kẹ lẹ ekye. ọnwọ ema la ta kye kla ayẹ igo <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />Tushin ọkpa lan lam lẹ idri ishee. <verse eid="ACT 27:41" /><verse number="42" style="v" sid="ACT 27:42" />Asoja lan la kawan shin ema ma pẹẹ ididu anu ọmẹn unkoo ilovrọ ke sablọ shin ọnhuọ alọ wan wóó tuhuan kẹ kram ma. <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />Tushin anu kọn ekyee asoja uRom e le nii ọfuw uBulus, ọnwọ ala tegha lẹ asoja lan tuhuan kẹ lawan ẹrẹnyẹ kọ ghan lẹ ma shin kẹ didu a nii izun shin aza ọwọ a tẹkpa fró kẹ lẹ ọmẹn ambrẹ kẹ awọ kẹ ghan lẹ unpi igo saa <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />Eple enyi ma lẹ nya aprẹn ọKatako eple enyi ma tọ nya apẹn ọnvrun ọkpa lan. Elẹ shin kẹ ididu wan la kpẹn kẹ lẹ unpin sa kẹ ọtrẹ wan.<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s">UBULUS KẸ AYẸ UDRIN ỌMALTA</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />Kẹ ẹlẹn izun enyi la huọ fuan ayẹ udrin, enyi la kọọn shin ẹbọn shin ambrẹ kye kan a drọ kọ shin ọmalta. <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />Ana ọywua kẹ ọnhuọ lan lẹ odu enyi lẹ enshin. A la wẹẹ enyi ọla tuhuan kẹ dra nyi lẹ didu kẹ sablọ ẹvra so kẹ ọnhuọ ọkpaa tuhuan ọnhuọ la oso la rang. <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />uBulus tun idri ẹkọn tuhuan, lẹ shin àá sọ yọ kẹ ọla, ingbesi, lẹ otro lẹ ofuu sablọ ọpiyẹ ọla lan, kẹ afrẹ ọnyẹ uBulus. <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />Ẹlẹn shin anushin oso kẹ ọnhuọ lan shìn ingbesi lan srom kẹ ọnyẹ nga, ala kọ wan lẹ eple wan shin, “Enkyi lẹn ana ọpẹẹ ada ghan; kẹ àá kram bi kọ ọmẹ udrin, ẹplẹpan so laa ya ẹnga ọywua wan.” <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />Tushin uBulus la nighẹ ingbesi lan kẹ ata wọ kan lẹ omẹ ọla tuhuan bọ ọnkyẹ shin ọba ghan ma. <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />Ada mle shin ọnyẹ nga nii ọmra huọ akpaa kẹ okpo ghan, tushin a huọ ọywua lakẹnkan tuhuan ba eshìn uple ọnlighẹ ba ghan ma, e le kye ẹhurẹ wan ka kọ wan shin ẹnga Ọnọm wọ<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />Eple àbaan soo kẹ ayẹẹ udrin lan ama uFubiliyus, akpẹẹ alalẹ anga ẹbọn shin ambrẹ kee kan. Àá ngrẹ enyi kẹ ọmẹ abaan nga kẹ gyagyuan aywuẹ ataa tuhuan kẹ ma enyi ọnkyẹ ọya. <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />Ekye uFubiliyus soo oloo lẹ ọnẹn kẹ aprẹn ọkya, la muọm kẹ iloo kẹ ọkẹn ibun. kpọn ulo kẹn ibun. uBulus la kan kẹ ushìn ghan tuhuan, lẹ shin àá huọ ọpẹlọnọm, a la traa ghan anyẹ kẹ ama ghan ọtrẹ. <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />Lẹ shin an yẹn huọ ọba, oloo shin atọ kẹ ẹbọn shin ambrẹ kee kan la ba tuhuan alẹ okon ọtrẹ <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />E mee enyi ọnkyẹ lapam ẹlẹn shin enyi akyẹ ọnyan usoon kẹ aprẹn ambrẹ wọ<verse eid="ACT 28:10" /></para>
  <para style="s">uBulus fuan uRoma.</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />Ọshin Ẹprẹn ẹtaa huọ ukpon enyi la nyẹran ọkpa ambrẹ kan lẹ ọmẹ ẹbọn shin ambrẹ kee kan ẹ tẹ soo la rang. Ọkpa ọnwọ Alekzandiriya kẹ amkpẹ ampọn ẹnọm ẹnpua kẹ upollus. <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />Ọshin ẹnyi aba lẹ uSirakus enyi la ywua kẹ ọnhuọ lan aywuẹ ataa. <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />Ọnya kẹ ọnhuọ lan enyi lẹ oton kẹ aprẹn ambrẹ kẹ akaaka fuan uRigiyum. Ọnwaa ubun urun asha ẹya ohun la nya, tuhuan kẹ aywuẹ ure kan enyi lẹ afuan uFutiyoli. <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />Kẹ ọnnhuọ lan enyi lẹ okon eple ewedri shin a dra enyi kẹ enyi kon ọsati uzun kẹ ẹma. Ọklan wọ enyi la ba lẹ uRoma. <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />Ewedri kẹ ọnhuọ lan huọ ọkọọn shin enyi kyan, tuhuan alẹ osoon ba ọsọ enyi ọshọn kẹ ọmẹ ize Affiyus tuhuan kẹ ẹhuọ́ ọkyuran ẹtaa ba ushǹ enyi. Lẹ ushìn ekyii lẹ uBulus lẹ asọ Ọnọm ẹjaa tuhuan kẹ okon ẹhurẹ ọdọ. <verse eid="ACT 28:15" /><verse number="16" style="v" sid="ACT 28:16" />Lẹ shin enyi a fuan uRoma, ala laa uBulus kẹ aywua ọywua ẹkyuẹ ghan, kẹ onsoja ka azọ ghan.<verse eid="ACT 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />Aywuẹ ataa huọ ukpon, uBulus la tuan lẹ ana adradọ aYahudawa. lẹ shin a klan, uBulus lẹ kọ ghan lẹ ẹma shin: “Ewedri mi, kẹ ọshin imi so nya mi udu ada enyi uple ọnlighẹ huọ emle udu ọnkyẹ akpẹ enyi wan, a la frẹ mi kẹ ọmẹ Urushalima kẹ ma oRomawa imi. <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />A lẹ vun mi tuhuan kẹ enii ọlaa mi, sablọ Imi odu mi iple uvrò shin a ta aprẹ mi ma. <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />Tushin lẹ shin aYahudawa tran ma, ọ la sọ Mi kẹ ọdọ wọ shin Imi kpọn aprẹẹ kan lẹ ẹmpakye agọn kaisar, kyẹ ọsablọ shin Imi so lẹ eple aprẹẹ kẹ aprẹn ada ama enyi ma. <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />Ọklan wọ Imi enii kẹ imi shin ngọ kẹ Imi pya onyun kẹ ẹngọ. Kẹ ọsablọ ọsọ ẹhurẹ ọnwọ Israˈilawa wọ a sọ Mi iwe ọyẹra lẹ.”<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />A le kye wan shin, “Enyi so nya wan ọngrẹn eple azaa bi kẹ ọYahudiya sablọ ẹngọ ma, tuhuan bọ ewedri anushin àá huọ ọba bi kẹ ọnhuọ lan shin òó too huọ ọpẹẹ uple ọnlighẹ antrantraan kẹ aprẹn ẹkyuẹ ngọ ma. <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />Tushin enyi nii ọkọọn ọnkyẹ ngọ shììn, kẹ enyi za shin ada huọ ulon ọnhuọ ghan wọ kon ọpya onyun kẹ aprẹn ọgbaa ana ọntẹ lẹ.”<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />A la klan akyuẹ kẹ ẹma ma okon uBulus kẹ uple ubun, tuhuan ala ba lapam lẹ ọnhuọ shin uBulus ywua wọ. Ọnya kẹ otrombun kan lẹ anlẹ òó too tuhuan kẹ kun ma ẹgọn Ọnọm tuhuan kẹ ayẹ kyẹ uwoo ẹhurẹ wan kẹ aprẹẹ ọYẹsọ bi kẹ iywuro uMusa tuhuan bi kẹ ọnhuọ ónu. <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />Eple enyi ma la kpọn lẹ ọnkyẹ shin otoo, tushin eple enyi ma nii ma ọkpọn lẹ ẹhurẹ wan. <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />Ala tran ma kẹ ọmẹ eple wan tuhuan kẹ frẹ uwlí wan lẹ shin uBulus huọ hurẹ ọpẹẹ ghan ọnwọ ọplẹ: “Iri Ẹsẹẹ too akpẹẹ ikyikyuo unu ẹplẹpan lẹ shin àá pẹẹ kẹ ọnhuọ ònu Ishaya:<verse eid="ACT 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 28:26" />“ ‘Son kan lẹ kan lẹ ọnhuọ ada lẹ kẹ ngọ ma pẹẹ shin,</para>
  <para style="q1" vid="ACT 28:26">“Unu nii ọfrẹ ọka kọn tushin unu nii unu ọkpẹ wan;</para>
  <para style="q2" vid="ACT 28:26">unu nii ọka eshìn tushin unu nii unu ọka akpẹẹ wan.”<verse eid="ACT 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27" />Kẹ ọsablọ an yẹn ẹhurẹ ada huọ ba lakpẹkpua;</para>
  <para style="q2" vid="ACT 28:27">ọ kẹ osoo ọna shin a kọọn lẹ atọn ma,</para>
  <para style="q2" vid="ACT 28:27">Tuhuan a fraa iredre wan kan.</para>
  <para style="q1" vid="ACT 28:27">Ẹn bọ klan ma a tẹ eshìn lẹ iredre wan,</para>
  <para style="q2" vid="ACT 28:27">kẹ akọn lẹ atọn wan,</para>
  <para style="q2" vid="ACT 28:27">kẹ akpọn lẹ ẹhurẹ wan,</para>
  <para style="q1" vid="ACT 28:27">tuhuan kẹ ekyem, tuhuan kẹ Imi nii ọma wan ọtrẹ.’<verse eid="ACT 28:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28" />“Ọnwọ ọsọ Imi nii shin unu za shin a huọ́ ọtuan lẹ ufwó Ọnọm kan lẹ ọnhuọ anushin oso wan aYahudawa wan, tuhuan e nii ọngẹn atọn!” <verse eid="ACT 28:28" /><verse number="29" style="v" sid="ACT 28:29" />Ọklan wọ aYahudawa la nyan wan kẹ ọnhuọ lan kẹ frẹ ọya ẹna kẹ eple wan.<verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />uBulus ywua amẹ apua kẹ ọmẹ abaan shin okon ọkywura ikli lẹ anushin aba lẹ ọnhuọ gha. <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />Ba ọkọọn ibun ala frẹ utoo ihyuu ishishi ẹn kẹ ẹgọn Ọnọm kẹ ololo aprẹ Ekye abaan ọYẹsọ uKristi.<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>