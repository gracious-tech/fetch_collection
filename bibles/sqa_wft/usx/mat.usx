<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- USHAMA</book>
  <para style="h">Matta</para>
  <para style="toc1">Matta</para>
  <para style="toc2">Matta</para>
  <para style="toc3">Mt</para>
  <para style="mt1">ALABARE A BURA̱ PA WA MATTA</para>
  <para style="imt">Chibane</para>
  <para style="ip">Bu ne bu zabage otakarda o te o alabare a bura̱ buba ne Matta, mashi Bayahude.</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s1">Ibenchi e Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Otakarda o ibenchi e Yesu Botʻbwakimga, bwa bo Dauda eb e shi bwa bo Ibrahim.<verse eid="MAT 1:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="MAT 1:2" />Ibrahim e machi Ishaku,</para>
  <para style="li2" vid="MAT 1:2">Ishaku e machi Yakubu,</para>
  <para style="li2" vid="MAT 1:2">Yakubu e machi Yahuda na ato eb.<verse eid="MAT 1:2" /></para>
  <para style="li2">
    <verse number="3" style="v" sid="MAT 1:3" />Yahuda e machi Pereza na Zera yinaba Tamar,</para>
  <para style="li2" vid="MAT 1:3">Pereza e machi Herzon,</para>
  <para style="li2" vid="MAT 1:3">Herzon e machi Aram,<verse eid="MAT 1:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="MAT 1:4" />Aram a machi Aminadab,</para>
  <para style="li2" vid="MAT 1:4">Aminadab a machi Nashon,</para>
  <para style="li2" vid="MAT 1:4">Nashon e machi Salmon.<verse eid="MAT 1:4" /></para>
  <para style="li2">
    <verse number="5" style="v" sid="MAT 1:5" />Salmon e machi Bo'aza yinna bob Rahab,</para>
  <para style="li2" vid="MAT 1:5">Bo'aza bo machi Obida. Yinna eb Ruth,</para>
  <para style="li2" vid="MAT 1:5">Obida o machi Yesse,<verse eid="MAT 1:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="MAT 1:6" />Yesse e machi bugwam Dauda.</para>
  <para style="li1" vid="MAT 1:6">Dauda o machi Sulemanu, yinna eb Barsheba bu ka sha bwaa bo Oriya,<verse eid="MAT 1:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="MAT 1:7" />Sulemanu e machi Rehobowam,</para>
  <para style="li2" vid="MAT 1:7">Rehobowam e machi Abiya,</para>
  <para style="li2" vid="MAT 1:7">Abiya a machi Asa̱,<verse eid="MAT 1:7" /></para>
  <para style="li2">
    <verse number="8" style="v" sid="MAT 1:8" />Asa̱ a machi Yehoshapat,</para>
  <para style="li2" vid="MAT 1:8">Yehoshapat e machi Yoram,</para>
  <para style="li2" vid="MAT 1:8">Yoram e machi Uziya,<verse eid="MAT 1:8" /></para>
  <para style="li2">
    <verse number="9" style="v" sid="MAT 1:9" />Uziya o machi Yotam,</para>
  <para style="li2" vid="MAT 1:9">Yotam e machi Ahaz,</para>
  <para style="li2" vid="MAT 1:9">Ahaz a machi Hezikiya,<verse eid="MAT 1:9" /></para>
  <para style="li2">
    <verse number="10" style="v" sid="MAT 1:10" />Hezikiya e machi Manase,</para>
  <para style="li2" vid="MAT 1:10">Manase ma machi Amon,</para>
  <para style="li2" vid="MAT 1:10">Amon a machi Yosiya,<verse eid="MAT 1:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="MAT 1:11" />Yosiya e machi Yekoniya na ato a eb, gagu owa ba saga ato a eb wo tugyam na tonge to Babila.<verse eid="MAT 1:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="MAT 1:12" />Taaba shibke yek Babila,</para>
  <para style="li2" vid="MAT 1:12">Yekoniya e machi Sheyaltiyel,</para>
  <para style="li2" vid="MAT 1:12">Sheyaltiyel e machi Zerobabel,<verse eid="MAT 1:12" /></para>
  <para style="li2">
    <verse number="13" style="v" sid="MAT 1:13" />Zerobabel e machi Abihud,</para>
  <para style="li2" vid="MAT 1:13">Abihud a machi Eliyakim,</para>
  <para style="li2" vid="MAT 1:13">Eliyakim e machi Azor,<verse eid="MAT 1:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="MAT 1:14" />Azor a machi Zadok,</para>
  <para style="li2" vid="MAT 1:14">Zadok o machi Akim,</para>
  <para style="li2" vid="MAT 1:14">Akim a machi Eliyud,<verse eid="MAT 1:14" /></para>
  <para style="li2">
    <verse number="15" style="v" sid="MAT 1:15" />Eliyud e machi Eleyazar,</para>
  <para style="li2" vid="MAT 1:15">Eleyazar e machi Mattan,</para>
  <para style="li2" vid="MAT 1:15">Mattan ma machi Yakubu,<verse eid="MAT 1:15" /></para>
  <para style="li2">
    <verse number="16" style="v" sid="MAT 1:16" />Yakubu e machi Yusupu bwariya bo Mariyamu, Mariyamu ma machi Yesu e ne nya ba ogage Botʻbwakimga.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Kuchi ibenchi nyaba bando Ibrahim koro Dauda, ibenchi nya ba ato rekwape na nashi. Wo Dauda a ba zhangi Isra'ilawa kuro tugyam na Babila, ibenchi nya ba ato a rekwape na nashi, daga tugyam na Babila kuro emato e Botʻbwakimga ibenchi nya ba ato rekwape na nashi.<verse eid="MAT 1:17" /></para>
  <para style="s1">Emato E Yesu Bot-bwakimga.</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Taaba machi Yesu Botʻbwakimga na gagu o Yusupu e on gembo o Mariyamu Yini Yesu, kape ab para ushiyana pa bob bu shi muka̱b bando mopyer mo bura̱. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Uragasu o bob o zhe kirki, e kudage henda e pa ek muʻe wo ato eba ba, pa eb ishi kama butarya e paso e bob eb eba.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />Henda e be shi kama butarya o nani se koro o butom bo hagamba bo Botʻbutuwaga bo kure wo eb na arabuwa, bwange na eb, &lt;&lt; Yusupu bwa bo Dauda, o ta hoga ryansa rezhangu e Mariyamu mashi bwaa na bubeya zwam muka̱b mot mo bob mu shere wo mopyer mo bura̱. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Bwa mato bwa, bwa tano boik rezhe Yesu zwam eb nya chago ato a eb wo turiya twa a ba &gt;&gt;.<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Sarai e ne paare ne, zwam a shinji iyi Botʻbutuwaga bu zwame pa yinu hatuma ne zwama <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />&lt;&lt; Ekangaza ishi muka̱b e machi bwa, tane boik rezhe Emmanuwel&gt;&gt;. Ma ana ma Emmanuwel &lt;&lt;Onhon o yo wo gatu&gt;&gt;.<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Ta Yusupu e mashinge murab. Na eb e swabe taaje o mahonre o Butom bo hagamba bo Botʻbutuwaga. Yusupu henda e zhangi Mariyamu bwaa bo eb <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Ama e remo boik ba, har ma machi bwa bo maba, pa eb e tane boik rezhe Yesu.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s1">Haringachigiya A Hato Hadaku a zaat</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Ab pab gagu owa ba machi Yesu na shepo o Baitalami o tunge to Yahudiya na mugeta mu bugwam Hiridus, na ato mai a hadakwa ringwane a zaat a kore Urushalima pa a ba kaba ange, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />&lt;&lt; Inga bugwam bu upo bo Yahudawa bo ne bwa ba machi? Zwam tu hya biringwane be bob zaat, zwam tu kore to shagiya boik sujada &gt;&gt;.<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Bugwam Hiridus bo hoge na ni na hankali a bob a mashinge, na ni henda sarai ato Urushalima. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Na eb e tarage Pristochi a tuwaga na hamarumi ai chibagano ataura, e kaba yek pa a ba mato Botʻbwakimga. <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Pa ab ange na bob, &lt;&lt;Na shepo o Baitalami ne o tonge to Yahudiya, zwamnani ne butuma bu herange bwange,&gt;&gt;<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />&lt;&lt; &lt; Gab henda Baitalami, na tonge to Yahudiya,</para>
  <para style="q2" vid="MAT 2:6">Gab shi bo nuwa na tonge to Yahudiya ba;</para>
  <para style="q1" vid="MAT 2:6">Wo gab e mai e tugwam nya shere,</para>
  <para style="q2" vid="MAT 2:6">E ne nya shi bugyam bu ato Isra'ila &gt; &gt;&gt;.<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Na Hiridus e ogage ato hadaku ha ni habʻhaba zwam e daki wo haba gagu o ne o biringwane be ne be shere. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Na eb e tuma yek koro o Baitalami nyange, &lt;&lt; Kuranji e gembagya bwa bu ni honzhe shi hya boik gahi kure e na zwama, zwam gyam kore kumba shagiyi boik sujada &gt;&gt;.<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Haba henda, taba hoge e hogo e tazhe o bugwam, naba karge. Biringwane be ne bya ba hya zaat be yo na tusha twaba a be swabe bek har be kore be yinsa wo bwa bu yo. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Taaba hya biringwane na a ba shinji na so chen dinya. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Ta a ba esh yaba henda na ba hya bwa na yini bob Mariyamu, na ba hinage a shagi boik sujada. Pa ba pashingegi hazunga hab na ba tuta boik kyauta ke Zinariya, na Lubban, na Mur. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Na haba maringe tonge twaba na yeno mai, zwam Onhon o pasa yek na harabuwa a ta kuraka wo Hiridus.<verse eid="MAT 2:12" /></para>
  <para style="s1">Yusupu Na Mariyamu A Sum Koro Masar</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Ta a ba karegya, na bo mai butom bo hagamba bo Botʻbutuwaga bo kore wo Yusupu na harabuwa, bwange, &lt;&lt;Mashingya, zhangi bwa bote na yini a bob e some koro tonge to Masar. E shani wa te ka me zwama e giya. Zwam Hiridus nya gembo bwa bu te zwam e hone boik.&gt;&gt; <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Yusupu henda e mashinge e zhangi bwa na yina bob na aget, e kore tonge to Masar, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />E shani wate har Hiridus e u. Nani o paare zwam a shinji e ne e Botʻbutuwaga bo zwame na yinu hatuma ne zwama, &lt;&lt;Bando o Masar gyam ogage bwa na bumi &gt;&gt;.<verse eid="MAT 2:15" /></para>
  <para style="s1">E Honago Nyawa No</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Ta Hiridus e gaa ne, ato edaku a ne a zhangu ek udamba na eb e hachigage so dinya. E tuma a hunage awo a no a tware a na yo na so Baitalami na ringu ob, a na yo na shekara harya koro kazhu, ta ato ai daku a zwame na eb zwam bwa buni. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Nani a ba shinji e ne nyaba zwame na yinu bu tuma Irimiya ne zwama:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />&lt;&lt; A hoge bigwaba na Rama,</para>
  <para style="q2" vid="MAT 2:18">Gwab e so shiri na tudaro to tuzum,</para>
  <para style="q1" vid="MAT 2:18">Rahila e on tudaro zwam awa eb.</para>
  <para style="q2" vid="MAT 2:18">Nya ta'azantu ba</para>
  <para style="q1" vid="MAT 2:18">Zwam a ba za &gt;&gt;.<verse eid="MAT 2:18" /></para>
  <para style="s1">E Giyaka Nazarat</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Ta Hiridus e u, na butom bo hagamba bo Botʻbutuwaga bo kore wo Yusupu na harabuwa na Masar bwange. <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />&lt;&lt; Mashingya zhangi bwa bu te na yini a bob kore tonge to Isra'ila, zwam a ne a gimbago a hone rekoko re bwa bu te a owagu &gt;&gt;.<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />Na eb e mashingye e zhangi bwa na yini bob e kore tonge to Isara'ila. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Ama ta eb e hoge Arkilayus a zhangu gado o buchi bo eb e shiu bugwam bo Yahudiya, na eb e hoge ryansa o koro wari ama Ta a ba pasa ek na harabuwa na eb e bunra koro tonge to Galili, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />Na eb e kore e shani na shepo o mai owaba ogago Nazarat. Zwam a shinji e zwamo e hatuma nezwama, &lt;&lt; A zwamo na bob Banazare &gt;&gt;.<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s1">Mupasa Mo Yohana e Baptisma</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Na mugeta mu ni Yohana e baptisma e kore, e be shi mupasa na uzanga o Yahudiya, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />E be zwammagaa, &lt;&lt;E magenjigya, zwam tugwama to turwana tu nya wuchi.&gt;&gt; <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Bu ni bu shi bot bo Ishaya bando hatuma ish tazhe nyange,</para>
  <para style="q1" vid="MAT 3:3">&lt;&lt; Bigwaba be owe ogaga na uzanga ne zwama,</para>
  <para style="q1" vid="MAT 3:3">&lt; E kimagyage Botʻbutuwaga rihuga̱,</para>
  <para style="q2" vid="MAT 3:3">E banbegyage yina ob &gt; &gt;&gt;.<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Yohana henda e tane matana ma tuhinjha tu orakumbe, e ma para utak kuryago ko eb henda Hatara na tusye. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Na ato Urushelima sarai na Yahudiya, na sarai a tonge kusa na rwaga Urdun a be korage wo eb. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />E be shagya̱ga̱ yek baptisma na rwaga o Urdun a be zwammagaa ene nya ba shi e turiya.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Ama ta Yohana e hya Parisiyawa na Sadukiyawa dinya a kore zwam a shagya̱ yek baptisma, na eb nyange na hab,&lt;&lt;Gahi shahwa! Ga bwange na gahi, e some tuzoma to te to yo kore? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Ishi ene nya chibano kamaginjigya nuhi. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />E ta zhangya ne zwama Ibrahim ishi buchi na buhinya.&gt;&gt; Zwam gyam raga ke zwammagaa, Onhon o zhe iko o shagi Ibrahim awo na te o te. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Ko nanani henda a zato akyaboto na hagungu ripitu re'o. Zwamnani, o'o one o shiu awa bura̱ ba a ba gunji oik a tane na ora.<verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />&lt;&lt; Gyam na mani gyam raga kame shagyaga baptisma e chibano e kama ginjigya nuhi. Ama bone bwana ragaga nesa, bona hyange tuwaga, bone ko otaka o bob na dama humga ba. Eb nya shegiu baptisma na mophar mo bura̱ na ora. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Ebobo e bigerya be eb eyo na wa eb, eb nya kimga erunru eb honzhe, honzhe. E zuta̱ga̱ alkama eb na uriya̱ eb, ama hashaso e be tuki hek na ora one owangiwa o usagu &gt;&gt;.<verse eid="MAT 3:12" /></para>
  <para style="s1">A shagiu Yesu Baptisma</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Na gagu uni Yesu e kore tonge to Galili, e kore rwaga o Urdun wo Yohana zwam e shagi ek Baptisma. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Yohana e kudago e nyanshe eb, nyange, &lt;&lt;Gyam bot bo gyamu kodage gab na shagi Baptisma, bo kore wo gyamu?&gt;&gt;.<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Na Yesu e chane ek nyange, &lt;&lt;Ga ushi nani yanzu, zwam nani ne o ba o sambari tu shinji adalchi &gt;&gt;. Pa Yohana e yaje.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Na ba shagi Yesu Baptisma yanzu, yanzu ne shero eb na so mani na turwana tu ma sabchi, pa Yohana e hya uhunchi Onhon obo kazhiya ta ihurugu, pa eb e kazhiya na kingi ka Yesu. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Paba hoge bigwaba be mai wariya na turwana be-be zwammagaa: &lt;&lt; Bwa na bumi a bot bone bo gyamu kudage, bo ne bo gyamu on shi so chen na bob &gt;&gt;.<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s1">Bugwam Bo Mophar Bo Makani Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Zwamnani Mophar mo bura̱ mo zhangi Yesu koro uzanga, zwam bugwam bo Mophar bo makani ek. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Yesu ishi tuʻowanre to mugeta kwape nashi ageta na onhwanho. Nani henda remyaro re kumbe ek. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Na bugwam bo Mophar bo kore bwange na eb, &lt;&lt;Shi gab shi buyu bo Onhon sa̱ te ote o maringye kapuka̱ &gt;&gt;.<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Yesu e chane nyange, &lt;&lt;O yo heryange ne zwama, ba na kapuka̱ kabkaba bot bwashi muhondo ba, ka ange na taaje o ne o shere wo Onhon &gt;&gt;.<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Pa bugwam bo Mophar bo zhangi ek shepo o bizagi, na bob bo zach ek bikwaso be Egenga. <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />Bwange na eb, &lt;&lt;Shi gab shi bwa bo Onhon, hina na tonge. Zwam oyo zabagi nezwama,</para>
  <para style="q1" vid="MAT 4:6">&lt;&lt; &lt;Owa shegyi tumana hagamba ob esapo zwama gab,</para>
  <para style="q2" vid="MAT 4:6">A bu banga,</para>
  <para style="q1" vid="MAT 4:6">Zwam bo mata udobota na te &gt; &gt;&gt;.<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Na Yesu nyange na eb, &lt;&lt;Oyo zabagi ne zwama, &lt;Ta ma̱ka̱ Botʻbutuwaga Onhon no beya &gt; &gt;&gt;.<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Na bugwam bo Mophar bu zhangaka ek zaat o shama e gyeso, bu chibane Yesu sarai tugwama to duniya na e edanduwa oba. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Nyange na eb, &lt;&lt;Sarai koya na bo pa shibu kuku bu mu shagiu sujada na bishina̱ na bimi buna shagyu sujada.&gt;&gt; <verse eid="MAT 4:9" /><verse number="10" style="v" sid="MAT 4:10" />Pa Yesu nyange na bob, &lt;&lt; Mashinge wo gyamu gab bugwam bo Mupyar. Zwam oyo zabagi ne zwama, bwa shegyu Botʻbutuwaga Onhon no be e kuku e sujada henda oba'oba gabwa shegyu tugyama &gt;&gt;.<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Nanani pa bugwam bo Mophar bu gye ek, na tumana hagamba a kore a shagyi ek hidima.<verse eid="MAT 4:11" /></para>
  <para style="s1">Yesu E Rwage Enke A Eb Na Galili</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Ta Yesu e hoge a huma Yohana, pa eb e mashinge e kore Galili. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Pa Yesu e gye Nazarat, e kore Kaparnahum e sheni, wari na gungu rwaga inyaka e tonge to Zebaluna na Naptali, <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />zwama a shinji ene e Ishaya bando hatuma ish zwame nyange,<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />&lt;&lt;Tonge to Zebaluna na tonge to Naptali,</para>
  <para style="q2" vid="MAT 4:15">Na gungu Bahar, na hiro o rwaga o Urdun, na tonge to Galili to Al'umai,<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Ane a shani bando tunshi</para>
  <para style="q2" vid="MAT 4:16">A hyan tubanga to tuwaga;</para>
  <para style="q1" vid="MAT 4:16">Ane a sheni na tonge to uʻu</para>
  <para style="q2" vid="MAT 4:16">Henda tubanga to shere wo hab &gt;&gt;.<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Kata gagu o niya, Yesu e rwage mupasa e be zwammagaa,&lt;&lt;Emagenjige zwam tugwama to Onhon to nya kore &gt;&gt;.<verse eid="MAT 4:17" /></para>
  <para style="s1">Yesu E Ogage Aswabo A Eb A Jigu</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Yesu e be shi tuhano na gungu o rwaga o Galili ba un, na eb e hya hamaye hahunwa̱ baryagya̱, Saminu ene nya ba ogagu Bitrus, na buhunwa̱ bu eb Andarawus, a be tagaga taro na rwaga, zwam a ba shi ato a e kumbagaa e mukimba. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Na Yesu nyange na ab, &lt;&lt;Ena swabya, na sa e marengye ai kumbagu nya ato.&gt;&gt; <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Kapateya ab gye taro owaba a swabe Yesu.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Ta eb e makisata pa eb e hya ato maye barya̱gya̱, haba henda a shi ahunwa, Yakubu buyu bo Zabadi, na buhunwa̱ bo eb Yohana, ab na so zhirigi taba na buchi bwaba Zabadi, a be kimga taro owaba. Na eb e ogage yek, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Kapateya paba gye zhirigi na buchi bwaba, pa ba swabe ek.<verse eid="MAT 4:22" /></para>
  <para style="s1">Yesu E Rumigyatumi Ana Rumagi</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Pa Yesu e ringachagi kuchi tonge to Galili, e be chibaga na mugyenga mwaba, e be zwammagaa tugwama to Onhon, e be rumigyatumaga ko iri hone nyana wo ato. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Nanani e be goge na tonge to Asoriya. Pa ba shibkaga ek atwa ane a rumagagi, a na a zhe hono ko iri nyana, na ne a hoge tuzuma, na ane a zhe Mophar, na ane a zhe owagiʻowagi, na ane a swage kingi, henda e be rumigyatumagaa yek. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Udubu owato dinya o swabe ek koro tonge to Galili, na bando mushepo rekwape, na Urushalima, na tonge to Yahudiya, har koro hirwa o rwaga o Urdun.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s1">Echibaga E Yesu Na Zaat o Mushama</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Ta Yesu e hyan udubu owato dinya pa eb e hyane mushama. Ta eb e sheni, aswabo a eb a kore wo eb, <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Pa Yesu e sabchi yinu e chibaga yek.<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />&lt;&lt; Iyi bura̱ eyo wo ane a daki nagu owaba uhunchi,</para>
  <para style="q2" vid="MAT 5:3">Zwam tugwama tu turwana tushi twaba.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Iyi bura̱ eyo wo ane a madame</para>
  <para style="q2" vid="MAT 5:4">Zwam a daura̱tumi yek so.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Iyi bura̱ eyo wo ana azhe uʻibu</para>
  <para style="q1" vid="MAT 5:5">A gado tonge.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Iyi bura̱ eyo wo ato ane azhi kiryane ke ene sambari,</para>
  <para style="q2" vid="MAT 5:6">A tope yek ene nyaba kudage.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Iyi bura̱ eyo wo ana azhi yama,</para>
  <para style="q2" vid="MAT 5:7">Ab ma a hoge yek yama.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Iyi bura̱ eyo wo ane azhi rekoko rebura̱,</para>
  <para style="q2" vid="MAT 5:8">Zwam ab gado Onhon.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Iyi bura̱ eyo wo ane maswabo,</para>
  <para style="q2" vid="MAT 5:9">A zwam naba awo Onhon.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Iyi bura̱ e yo wo ane a on hoge tuzom zwam e shagu e adalchi,</para>
  <para style="q2" vid="MAT 5:10">Zwam tugwama to turwana tushi twaba.<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />&lt;&lt;Iyi bura̱ eyo wo gashi ta ato hate ai zwagage, ai damage, ai hyanga na ene e sambari wa̱, zwam gyam. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Shaanji so chen dinya, zwam ketope na kihi keyo dinya na zaat, zwam nani ab damage hatuma na ane ayo na tusha na tuhi &gt;&gt;.<verse eid="MAT 5:12" /></para>
  <para style="s1">Maanje Na Tubanga</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />&lt;&lt; Gahishi maanje ma tonge. Shi maanje ma hachigago, na nya ab hogo myeka? Mazakana ene yabashi na maba, ka kwangi, ato a pundage &gt;&gt;.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />&lt;&lt;Gahishi tubanga to tonge. Zwama, shepo one oyo na zaat ore ogo. Opwa kamaswe. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Apwa tukiya̱ bichera asabta̱ bek na abora̠, ka dukane bek na rihuga̱ re beb be pa ato yaba kuchi tubanga. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Tubanga na tuhi turinga bangaratoma wo ato, zwama yek a hyan enk nahi a bura̱, henda yek a dande buchi na buhi bone bo yo zaat na turwana &gt;&gt;.<verse eid="MAT 5:16" /></para>
  <para style="s1">Echibagano e Ataura</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />&lt;&lt; Ita zwama na kore usa̱gai ataura na chibaga e hatuma. Na kore ba zwam usa̱gi yek ba, zwam na shinda̱gi yek. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Tamahinda na raga ke zwammagaa, ka̱shi onshi o torwana na tonge o hogi, ko bizabo ko indake be ataura bya hoguba, ka shindu ko nya. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Zwamnani bone bwa gyeu ene nyaba ange yinka̱ ene hyange tuchimu pa eno nyaba ange, har e chibaga ato nani, a zwam na bob enakanaka pa tugwama to zaat. Bone bo swabo yek, henda bu chibaga yek a zwam na bob bone bo henge tuwaga na tugwama to turwana. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Na raga ke zwammagaa, shi iyi bura̱ nehi e hyangewa hamarumi a hataura na Haparisiyawa, nya iso wa tugwama to turwana ko chim&gt;&gt;.<verse eid="MAT 5:20" /></para>
  <para style="s1">Echibaga E Yesu Zwam E hono Bot Riʻu</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />&lt;&lt;E hogo a zwam na shikaka na shi hi, &lt;Ota hona buto, henda bone bo hono buto, a shegyu boik hadoba.&gt; <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Gyamu riga ke zwamgaa, koga bo rwage shi pushi na buto bob, a poro boik. Koga bwange na buto bob udamba, a shibko boik na bishina̱ byato chibano. Koga henda bwange, gab shi konya ba ombe bob bwa eso ora̱ one oza usagi.<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />&lt;&lt;Zwamnani shi bwa tuta uhanchi zaat o Egenga pa gab mabutare ne zwama buhunwa na bobe buzhe bitaga na gab, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />Gab iri uhanchi nobe na nabishina̱ be genga, gab kore emakimga na buhu na bobe katum gab maringye tuta uhanchi nobe.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />&lt;&lt;Shi buto mai bushibke bando hadoba, gab mahima̱ emakimga kimga na eb ton gahi na yina kame gahi esh wo hadoba. Shinani ba nyabuhuta̱ na Anakale, Anakale henda a bu huta na buto bwaʻagungu a bu gunda na zharo. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Tamahinda na raga ka bu zwamaga, kape a bu shiryatumya, bwatopo kuchi kurubi ne yaba bu swabe &gt;&gt;.<verse eid="MAT 5:26" /></para>
  <para style="s1">Echibagano Zwam Tugari</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />E hogo taaba zwame, eta sha̱a̱ tugari. <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Na raga ke zwammagaa, shi buto bu raga yengyaga bwaa zwam tugari buhwa̱gu shi tugari na rekoko rebob ba un. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Shi rishi nebe e katuga nyasan gab shi ene zai bura̱, yachiga rek pash. Mata na̱gi biʻabo bi mai bi kingi na kabe naba tana kingi na kabe kuchi na so ora̱ one oza usagi. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Shi wa nobe okatoga nwan san gab shi ene za bura̱, gab gunji pash. mata naki bi'abo bi mai bi kingi na kabe naba tana kingi nakabe kuchi na so ora̱.<verse eid="MAT 5:30" /></para>
  <para style="s1">Echibagano Zwam E hono Ushiya̱na</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />Musa owange, &lt;&lt;Koga bupash bwaa bo bob bopa boik otakarda oye paso.&gt; <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Gem rega ke zwammagaa, ko ga bo pash bwaa bob, onba zwam tugari ba, bu tano boik yeno tugari. Bune henda bu shinya bwaa bone bwaba pash bo on tugari &gt;&gt;.<verse eid="MAT 5:32" /></para>
  <para style="s1">Echibagano e Yesu Zwam kutono</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />&lt;&lt;Har nanane, ehogo a be zwammagaa ato Jigu, &lt;Tama tuna na taka, shinji kutono ko gab shi na Botʻbutuwaga.&gt; <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Gemrega kamai zwammagaa, eta ma tuna, na turwana, zwam tob tush rihuga̱ rishiyano ye Onhon, <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />eta matuna na tunge, zwam tub tush iya̱ taga buna, ko henda na urushalima. Zwam uba ushi shepo o tuwaga o Bugwam. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Ta ma tuna na reto na rebe, zwam bupa ringyatoma ahinja̱ a shiri ko a chen. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Iyi gahya zwam, &lt;i&gt; ko henda &lt;aʻa&gt; shi hyango nani isher wo mugu &gt;&gt;.<verse eid="MAT 5:37" /></para>
  <para style="s1">Echibagano Zwam Kama Tope</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />E hogo de a zwam, ketope ke rishi na rishi, ketope ke hera na hera. <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Gem riga kamai zwammagaa, eta wunda bune bu shegi ene e za ibura̱. Sha bu supi na suga̱ nwinka̱ pa umai a supi kumba. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Shi buto mai bushipke wo hadoba zwam buche a po nabe, gagya boik kuchi na egodu nebe. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Shi buto mai botogwama bo sape ishi tuhano to mil inka, gahishi tuhano to hamil harya̱gya̱. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Shi buto mai bo ka̱ba̱ iyi mai pa boik. Bone henda gembo otashe wo gab, ta ya̱sa̱ boik.<verse eid="MAT 5:42" /></para>
  <para style="s1">Kudaga a chagiya bitaga</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />&lt;&lt;Ehogo henda a zwamo ne zwama, &lt;U kudage buhu na bobe, e ta kudaga ana on bitaga na gahi.&gt; <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Ama gemrega ka mai zwammagaa, e kudage ana a on bitaga na gahi, e raga shegya̱ ana a on bitaga na gahi menga. <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />Nana ni gahya shi awo a buchi na buhi bone bo yo na turwana, bune bwa sapo onhwaho ushi tubanga pa ato a bura̱ na ane aza bura̱, une owatumane ashira̱ wo ato a bura̱ na ne aza bura̱. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Sha ato ane a mai kudage ab gahi kodage, ketope kyana ke gahya hyun? ko ato gandu pa nani ab yo ba? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Sha ahuwa na hi ab ba gahi raga zwangaga, nya gahi o ene e hyange ato kanya? Ko ana shiwa̱ Yahudawa a shagu na ni ba? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Zwamnani ishi ta buchi na buhi bone bo yo na turwana &gt;&gt;.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s1">Echibagano e Yesu Zwam Ipanga Uhanch</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />Yesu nyange,&lt;&lt; Ishi honjhe zwam tugyam na tuhi tuta sha twaheni. Zwam shi shiu nani, ya'hiu ketope wo buchi na buhi bone boyo na turwana ba &gt;&gt;.<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />&lt;&lt;Zwamnani shi bwashi uhanchi ta yada o zwam ta uramahut a shagagu wo Egenga na yena zwam ato a kudaga yek. Tamahinda na mai zwama a hiu ketope kyaba ba'un. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Shi bwa pa uhanch ta yada wa kagurha ohya ene wa katoga owashi ba, <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />zwam ushi uhanch nobe na tuswe,buch na buhi bune bo yenge ene yo na tuswai bwa bo topeu &gt;&gt;.<verse eid="MAT 6:4" /></para>
  <para style="s1">Menyenga</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />&lt;&lt; Shi yeshi menga e ta sha ta oramahuta, zwam yek a kudage e shagu e menga yesagane na mugenga mwaba na yena zwam ato a hya yek. Tamahinda gyam mwa kame zwamaga yeka hiu ketope kyaba. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Shi bwashi menga, o esh ubana̱ nobe ogunda yinu-eso, gab shi menga wo buch nobe bone bwaba hyanagu boik ba, buch nobe bone bohyanagu ene yo na tuswai bwa bo pa kitop. <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />Shi bwashi menga ta hina ringyatomaga ba, ta alʻumai a shagagu, na ihyanu nyaba a hogo yek zwam udubu o taaje owaba. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />E tasha̱ taba, zwam buch na buhi budaki ene e gahi za kape iginbage boik &gt;&gt;.<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />&lt;&lt; Zwamnani shi meng nane.&gt;&gt;</para>
  <para style="q1" vid="MAT 6:9">&lt;&lt; &lt; Buch na buti bune bo yo na so turwana,</para>
  <para style="q1" vid="MAT 6:9">A kimga rezhe na rebe honjhe,<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Tugwama na tobe tu kurya,</para>
  <para style="q1" vid="MAT 6:10">A shi ene gab kudage na tonge</para>
  <para style="q2" vid="MAT 6:10">Ta ba owenshi na turwana.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Tu pa kuryago kuti kunare.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />Tu yapiya tugwada̱ na tuti,</para>
  <para style="q2" vid="MAT 6:12">Ta gatu owen yapya ane a tu shagi tugwada<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />Tata isa wo turiya,</para>
  <para style="q1" vid="MAT 6:13">Tu chage wo rekoko rewo.&gt;<verse eid="MAT 6:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14" />Zwam shi yapiya ato tukwada twaba buch bone bo yo na turwana bwa yapeu kumba. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Ama shi yapiya ato tugwada twaba ba, buch na buhi bwa me yapiya gahi kumba ba &gt;&gt;.<verse eid="MAT 6:15" /></para>
  <para style="s1">E chibagano Yesu Zwam Tu'oware</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />&lt;&lt;Shi owe tu'owere, e ta yada hachigage shinu ta oramahutu a shagagu. Ab de a hachigage shinu yaba zwam ato hya nezwama a owe tu'oware. Tamahinda na owen kame zwammagaa, a hiu ketope kyaba ba un. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Shi owen tu'oware, e ma sukutage manebe na reto henda e gunza̱gi shinu na hi, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />Zwam a hya gabishi tu'oware. Buch na bobe bone bwaba hyanagiwa, bone henda bu hyanagu ene yo na tuswe, bwa bu tope.<verse eid="MAT 6:18" /></para>
  <para style="s1">E chibagano zwam tu'ira̱ twa zunga na Turwana</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />Ita ma ira̱ga̱ na tonge pani pazhe na tukura̱ ane a hachigago yek, pani henda pazhe Hahi ane a eso a shi rihi. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Ama e ira̱gi hazunga na hi na turwana pani pa za abapaba ko tukura ane a hachigago ek ba, ko henda Hahi hane a eso ashi rihi. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Zwam pa tuʻira̱ na tobe tu yo, pab so nobe o yo.<verse eid="MAT 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />Rishi ishi bichera be kingi, shi rishi na rebe rejhe lapiya, kwat kingi na kabe ka shindu na tubanga. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Ama shi henda rishi na rebe reza lapiya kwat, kingi na kabe ka maringeu tunsh, nani tush twashi dinya!<verse eid="MAT 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />Aza bune bwa swab ato tuwaga barya̠gya̠ ko wonje buinka̱ swabe buinka̱ ko shagi buinka̱ Iyi bob ko kudage ko henda yage buinka̱. Ba ta gahi ya swab Onhon na kurubi kuchi.<verse eid="MAT 6:24" /></para>
  <para style="s1">Ita madama</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />Zwamnani na on kame zwamaga, eta madama ta gahi yanshi rekoko zwam iyi gahya re ko gahi yanswa ko henda ta gahi yanshi matana zwam kingi na kahi. rekoko rehenge kuryago ba? kingi ka henge matana ma gahya tano ba? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Hingyanajhi mononu nai, mu shagu tubero ba, mushagu biguba̱ ba, mu ira̱gu na a uriya̱ ba. ko nanani buch na buhi bone bo yo na turwana bob bo on ryagyatum moika. Gahi henge moika tooto ba? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Ga wo gahi zwam tudam bwa makisano berom binka̱ wo mugeta mo muhundo mo bob ba?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />Zwam ya̱ gahi madame zwam hazunga gahi ya tano? hingyana pure ozanga ta ba shagu tuwa, a shagagu enke a ko ya̱ba. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Ama konanani na on kamai zwammagaa, sulemanu sarai na tuwaga to eb, e taboshi tusambari Taaba ba. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />To, shi Onhon owa kimga mapuchpuch ma uzanga naniya ane ayo nare, abi henda a tuki yek ora, balle gashi? Gahi ana aza etano mahinda!<verse eid="MAT 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31" />Zwamnani e ta madamaga nezwama, yan gatu two re? ko, ya̱n gatu twa su? ko, ya̱n gatwa tano? <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Zwam ane a daki Onhon ba, ab ne a on gembo iri ne. Buch na buhi bune bo yo na turwana bu daki e on gembago iri te. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Iyi mahinda e Jigu e tane so ne gimbago Iyi bura̱ e tugwama to Onhon, na henda adalchi a ob, a mai kisano har iri te ma. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Zwamnani eta ma damaga zwam abiyi, zwam abiyi a kurago na tuzuma twaba, tuzuma tu nare tu me dama zwam nare.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s1">Ita pana ko ga makwa̱da̱</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />&lt;&lt;Ita shagiu koga hadoba, zwam gahi ma a mai shagiu hadoba. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Zwam na hadoba a gahi shi, na ba ab mai shagiu kumba. Neyi gahi chanagi nai ba ab mai chanagagu gahi kumba &gt;&gt;.<verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />&lt;&lt;Zwam nya gab on yingyana ebembe rishi re buhuwa na bobe, gab madamo na ugunkuri one oyo na rishi na rebe ba? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Ko zwam ya gab on zwam na buhuwa nabobe, &lt;yinsa boyachigya e hombe na rishi,&gt; gab na inʻowanʻo na rishi na rebe? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Gab ura̱mahuta, ma yachige inʻowanʻo ene oyo na rishi na rebe katomo, gab ha̱ honjhe ta gabwa yachige ebembe na rishi rebu huwa na bob.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />&lt;&lt;Ita pana shewa iyi bura̱, ita taga hende iyi bizagi bando sherwa zwam sha pundago shimaringya hend shi hendagage &gt;&gt;.<verse eid="MAT 7:6" /></para>
  <para style="s1">Etambi, E gembage, Ekwabtaga̱</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />Etambi a mai pa, e gembage e hiu, e kwabtaga̱ a mai sabchiu. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Zwam koga bu tambi a pa boik, bone bo on gembo bwa hiu, bone henda bo kwabtaga̱ a sabchiu boik.<verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />Ga wo gahi bwa bo bob bwatambiu boik kuryago, bob bwa pa boik tai? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Ko hende bo tambi boik ekemba bob bo pa boik ahwa? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Shi gahi hamugu, idaki ta gahi ya pa awo na hi iyi bura̱, inga buch na buhi bune bo yo na so turwana bone bwa pa iyi bura̱ wo ane a ka̱ba̱ boik! <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />Zwamnani, ene gahi kudage ato a mai shagi, gahishi kumba. zwam nani obu̱shi ataura ne chibagano e hatuma.<verse eid="MAT 7:12" /></para>
  <para style="s1">Yunu Eso Nuwa Na Etuwaga</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />Esanji na yinu eso e tuchimu, zwam yunu eso ituwaga ebe shi yunu uʻu. yunu eb eyo honjha ane a urga̱ pab ayo dinya. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Zwam yunu ituchim, yena ushi manaka-naka, ane a uruga pab a swabe wo muhundo, ane a swabe pab a za dinya.<verse eid="MAT 7:14" /></para>
  <para style="s1">A gano onowaʻo wo awo ob</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />Ishihonzhe na tumana tak ane a shere wo gahi na hatak hatem, ama na so muker kechi ne mu bigo. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Wo awo ab gahi ya gano yek, pa makada apwa yachige subbuga? ko henda wo itu na kingi ka makada? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Nanani ko owana on owaʻo ubura̱ owa pa awo a bura̱,on owaʻo n owa pa awo ana aza a bura̱. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Onowaʻo o bura̱ bato ob owa pa awo na aza a bura̱ ba, on owanʻo ono aza bura̱ ba, ta ob owa pa awo a bura̱. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Ko owano on owanʻo ono a zai panga awo aza bura̱ ba a sher ok a tane no ora̱ <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />wo awo ab gahi ya gano yek.<verse eid="MAT 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />&lt;&lt;Ba koga bone bo owe zwammagaa na gem &lt;Botʻbutuwaga, Botʻbutuwaga,&gt; bwa eso na so tugwama to turwana ba, ka bune bo owenshi iyi buch na bumi bone bu yo na so turwana bu kudage. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Oho oni, ato dinya a zwam na gyam, &lt;Botʻbutuwaga, gab Botʻbutuwaga, Tushiu tutom na rezhe na rebe, tu shiryatum muphar mowo na rezhe na rebe ba henda tushiu iya̱heni na rezhe na rebe ba?&gt; <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Ama nanani gemwa zwam naba, &lt;Namai dakiwa̱ gahi ba. Mashingyanji wate, gahi ane a oishi enk a mugu!&gt;.<verse eid="MAT 7:23" /></para>
  <para style="s1">Ato Ba̱ra̱ ana owen maga</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />Koga bone bo hoge taaje one bushiu enke na ob,a gagau boik na bot bo turenge bone bu ma yaba bob na zaat o nab. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Na ashira̱ a henage morab-raba mushindagi,pher uhura̱ yaba,ehenago ba zwam a tage ek zaat o nab. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />&lt;&lt;Henda ko ga bone bo hoge taaje one bu shiu enke na ob ba a gagau boik na bot bone buza turenge bone bo tage yaba bob zaat o hega <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Ta ashira̱ a henage murab-raba mu shindagi pher uhura̱ yaba ehenage emakimga chikisage dinya &gt;&gt;.<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Ta Yesu e hogi taaje, na udubu owato ushi iyaheni na ichibagano eb. <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />Zwam echibaga yek namahinda, ba ta hamarumi a hataura ba.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s1">Yesu E Rumigetumi Bot Bo Hono E Turyaha</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Na Yesu kazhiya̱ zaat mushama, ato dinya a ragaga ek. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Pa bone bozhe turyaha, bo kore wo eb bo hunka̱ na bishina̱ be eb bwangya, &lt;&lt;Bot butuwaga, shi bukudage, bopwa kana rumigya̱tum &gt;&gt;. <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />Pa Yesu e tuta wa eb pa eb nyange, &lt;&lt;Na yado na bugus, ush bot bone buza turiya.&gt;&gt; kapaba hone kingi ka eb kareki rumigya̱. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />pa Yesu nyange na eb, &lt;&lt;Yingyana o ta zwama na ko gane paare, ama kura umachi ibane reto na rebe wo pirist, pa henda uhanchi no be ta ichibaga e musa nyange. gab shi na ni zwam a daki ne zwama burimugiu &gt;&gt;.<verse eid="MAT 8:4" /></para>
  <para style="s1">Yesu E Rumigyatumi Bwabot Bo Gas</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Ta Yesu e esh kaparnahu, pa bot bo gas bo roma bo kure wo eb bobeshi gembo ne zwam, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />Nyange &lt;&lt;Bot butuwaga, bwa na bumi boyo rabche bomaringeu hwehwe bo on hogetuzuma dinya.&gt;&gt; <verse eid="MAT 8:6" /><verse number="7" style="v" sid="MAT 8:7" />Pa Yesu nyange na bob, &lt;&lt;Na kure na bu rumigya tum boik&gt;&gt; <verse eid="MAT 8:7" /><verse number="8" style="v" sid="MAT 8:8" />Pa bot butuwaga bo gas bo roma buchane bwangya, &lt;&lt;Bot Butuwaga, na dama gab kurya yab nimi ba, ama sha taze kurum, bone bona owengeu tugyam bwa rumigeu. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Zwam gem ma nayo reto rebot mai, Nazhe handa ato gas reto na remi, na shaku zwam nabone, &lt;karigya,&gt; e be karigya, botomai henda gyam zwama boik, &lt;kurya&gt; e be kurya, gem zwama bugyam na bumi, &lt;she iyi mai,&gt;ebe shi.&gt;&gt; <verse eid="MAT 8:9" /><verse number="10" style="v" sid="MAT 8:10" />Na Yesu e hoge nani pa eb ishi kadana, pa eb ezwama ana sob ek, &lt;&lt;Tamahinda na raga ke zwama, kopa isra ila na tabe hiya bot boi tano e so e mahore ta eba. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Na raga ke zwammagaa, udubu o ato owa sher bando zaat na retowa a shani re kuryago taba na Ibrahim na Ishaku na Yakubu na tugwama to turwana. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Ama ato ana a shanu na tugwama tuni a tago yek pa udubu o tunsh pab yek ashi tudaro ne hakango e hera.&gt;&gt; <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />Pa Yesu nyange na bot butuwaga bo gas bo roma &lt;&lt;kora, a bu shageu ta gab tane so nobe.&gt;&gt;Kapaba bugyam bo bob burumigi.<verse eid="MAT 8:13" /></para>
  <para style="s1">Yesu e Rumigyatumi Iniu e Bitrus</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Na Yesu e esh yaba e esh yab e Bitrus, pa e be ha̱ him e Bitrus eb rabcha, kingi keka damage ek. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Pa eb e da̱ri wa e bob,kingi ka ragi rumigya, pa bob ba mashinge bushagi ek hidim.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Na reb ush ato a shibkane Yesu ato Mophar mowo dinya, pa eb e sheratume Mophar mote wo taje kurum pa Yesu e rumigyatumi ana rumagi. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Ishi nani zwam a shinji ene yaba zwam na yinu boink bando hatuma wato Ishaya ne zwam,</para>
  <para style="q1" vid="MAT 8:17">&lt;&lt;E be jhangi mahone hone na mati,</para>
  <para style="q2" vid="MAT 8:17">E be yanshe kuchi mahone hone na mati&gt;&gt;<verse eid="MAT 8:17" /></para>
  <para style="s1">Ane a zwame a sob Yesu</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Na Yesu e hya udubu owato a ringa ek, pa eb nyangya a kachiya hiro o rwaga. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Pa Umarumi o mai oichibagano ataura e kure a zwama ek, &lt;&lt;Umarumi, nabo swab kuchi wo gabwa koro.&gt;&gt; <verse eid="MAT 8:19" /><verse number="20" style="v" sid="MAT 8:20" />Pa Yesu nyange na eb, &lt;&lt;Shawa she a hir shi za a hambi a shib, munono henda muzha a huga a murab mo mub. ama bwa bo bot bu za rihuga re bob bwa tano reto re bob ba.&gt;&gt; <verse eid="MAT 8:20" /><verse number="21" style="v" sid="MAT 8:21" />Bomai bando aswab bwange na eb, &lt;&lt;Botʻbutuwaga, ga nakure na wumba buchi na bumi ka tumo.&gt;&gt; <verse eid="MAT 8:21" /><verse number="22" style="v" sid="MAT 8:22" />Ama Yesu nyange na eb &lt;&lt;Na swabe, ga ato na owa a wumba̱ ato a ba na owa &gt;&gt;.<verse eid="MAT 8:22" /></para>
  <para style="s1">Yesu e Pasa Yiru Shira̱</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Ta Yesu e eshe ugu o mani, pa aswabo a bone eb a ragaga ek. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />pa yiru owa shira na opher umashinge na rwaga har mani maraga kamashingyage isaga na so ugu, ama Yesu e yo pab e rabuch. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Pa swabo a buna eb a kore a yinshingatume ek, &lt;&lt;Bot'butuwaga, tu chage twaʻu! &gt;&gt;.<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Pa Yesu nyange naba, &lt;&lt;Zwan nya gahi hoge ryasa nane? gashi ato gahi tani so nuhi chimu.&gt;&gt; Pa eb a mashinge apasa pher na rwaga, pa rihig rini iragashi tsit.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Ato ashi kadana angya &lt;&lt;Iri bot bwana buni, bone bu pher na rwaga a hoge boik! &gt; &gt;.<verse eid="MAT 8:27" /></para>
  <para style="s1">Yesu e Rumigyatumi Ato Baryagya̱ Muphar Mowo</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Na Yesu e kachiya hiro o ri, koro tunge to gorasinawa, ato baragya a shere bando ab wumba̱ ato pa ba ma hare na eb. e ka shiu ato a ne a ba hoge ryasa ryaba dinya har aza ma bu ne bu pwa ura yina uniya̱. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />&lt;&lt; Kapaba, kapaba paba sanga muʻogo angya, &lt;&lt;Inga ronuhi na gatu, gab bwa bo Onhon? umbu bu kore zwam tu pa maduru kape mugeta mu shinji? &gt;&gt;.<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Tusha chimu sherwa shi yo dinya shi on rihuba. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />mupyar mowo mu ka̱ba̱ Yesu mwange, &lt;&lt;Shi bu tu shiryatume, gab sape to esh udubu o sherwa shi ne&gt;&gt;. <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />Pa Yesu nyange naba, &lt;&lt;To, karegenji!&gt;&gt; Pa mob mu shere mo esh na so sherwa, pa udubu o sherwa o mashinge na somo sarai shi kazhagi, pa sheb she esh na so rwaga, pa sheb she owagi na so mani. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Ato ana on rihuba a sheb a karege, taba esh shepo paba zwama ato alabare a ne e pare na ato muphar mowo. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />kuchi ato shepo uni a sher zwam ek a sumga Yesu. Naba hya̱ ek, pa a ba ange na eb e ge tonge twaba.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s1">Yesu e Rumigyatun Bone Bo Kingi Ka Swage.</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Pa Yesu e esh u'ugu umani, ekacheu rwaga e kore shep eb . <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Pa ab shibkane ek bone bo kingi ka swage rabche na baro. Ta Yesu e hya̱ e tanoso owaba, pa eb nyange na bone bo kingi ka swage, &lt;&lt; Bwa nabumi, sha̱ so chen, a yapiya turiya na tobe.&gt;&gt; <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />Taba hoge nani, hamarumi a mai a hadoba a ma zwama, &lt;&lt;Kurene e on makwada!&gt;&gt;.<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Yesu henda idaki ene yo na so owaba pa eb nyange, &lt;&lt;Zwam nya gahishi taje na so nuhi o ene ze bura̱? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Owana o hyange sauki, a zwam, &lt;A yapiya turiya na tobe,&gt; Ko na a zwamya, &lt;mashingye karghe&gt;? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Na kodage e gane nezwam, &lt;&lt;Buyu bot bo zhe mahore bo yapiya turiya na tonge&gt;&gt; Pa eb nyange na bone bu kingi ka swage, &lt;&lt; mashinge, uzhengi tubaro na tobe karege giu &gt;&gt;.<verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />Eb hend e mashinge e kore giu. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Ta udubu owato uha̱ nani, pa ryansa rekumbe yek, na ba dande Onhon one opa ato iri tune tuwaga.<verse eid="MAT 9:8" /></para>
  <para style="s1">Yesu e Ogago Matiyu</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Na Yesu e kisata tusha, e ha̱ bot mai bwaba ogaga boik Matiyu, bushani bando e twago e gandu. nyange na mab, &lt;&lt;Na swabya,&gt;&gt; pa mab ma mashingye ma swabe ek.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Na pab, Yesu e be re kuryago na yabe Matta, pa a twago a gandu dinya na ato turiya dinya a kore a shani taba na aswabo a bone eba.<verse eid="MAT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 9:11" />Ta parisiyawa a ha̱ nani pa ab ange na aswabo a bune eb, &lt;&lt;Zwam ya̱ Umarumi uni o oire taba na ane a twage gandu na ato turiya? &gt;&gt;.<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Ta Yesu e hoge nani pa eb nyange, &lt;&lt;Ana aza hono a ma dame na bot bo byato ba, kane azhe hono. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Kuranji e gane uni katumo,&lt; Ya̱m gem kudage wo gahi, ba uhanchiba,&gt; Na kure ba zwam ugagya ato bura̱ ba, zwam ato turiya &gt;&gt;.<verse eid="MAT 9:13" /></para>
  <para style="s1">A kaba Yesu zwam tu'oware</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Ab pab aswab a bune yohana e shagu baptisma a ka̱ba̱ gatu na Aparisiyawa a shagu tuoware , ama aswab a bonne be a shagu tuoware ba? <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />Pa Yesu e chane yek nyenge, &lt;&lt;A achagiya a ango a hachigago so kate ab na ango? ai mugeta muyo kure gagu ab jhago ango a ge yek. Gagu ni ab shi tu'owore. <verse eid="MAT 9:15" /><verse number="16" style="v" sid="MAT 9:16" />&lt;&lt;Ba bone bwa yitagu a po a goshe ne zani iupo, zwam maho one owa hando a po har owa hyango o da e hando. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Ba bone bwa zuta̱gu usubuga upo pa gwara e goshe. Ko a zuta, gwara ya̱ pupusagu, usubuga henda ukwangi, gwara henda e hachigage. Usubuga upo dai, a zuta oika na gwara yepo. Nanani a nagu usubuga ko henda gwaraba &gt;&gt;.<verse eid="MAT 9:17" /></para>
  <para style="s1">Buyu Bo Yayirus Na Bwaa Bwakwangi mahya</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Yesu e be zwammagaa yek ba un, na bumai butuwaga bo egenga bu kure bo kuki na bishina̱ be eb bwange, &lt;&lt;Bwa bo twaa na bumi bu'u yanzu da̱ri boik bwa mashingeu.&gt;&gt; <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Yesu henda e mashinge ato na swabo a bune eb, a swabe bot buni. <verse eid="MAT 9:19" /><verse number="20" style="v" sid="MAT 9:20" />Na bwaa bo mai bone bushiu hashekara rekope na haragya bu boi kwangi mahya bu kore na yense eb bo da̱ri kare ka anpo eb, <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />zwam bwange na so bob, &lt;&lt;Ko nadari anpo a eb suba na remigiu.&gt;&gt; <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />Ta Yesu e magenjige e ha̱ boika, pa eb nyange &lt;&lt;Tama damaga bwa nabumi. Etano eso no be e bu rumigyatumu.&gt;&gt; Kapaba bwaa bo rumigiu. <verse eid="MAT 9:22" /><verse number="23" style="v" sid="MAT 9:23" />Na Yesu e kore yaba e butuwaga bo egenga buni, e hya̱ ato huraga sheho̱ udubu owato aba shi biraji, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Pa eb nyange.&lt;&lt;Mashigyanji pate. ekangaza ete e u ba e rabboch suba.&gt;&gt; Naba shagi ek ratoitibu. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Taba uzagi yek na re'eb, pa Yesu e esh e huma wa ekangaza pa eb e mashinge. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Kopa anabare a eso.<verse eid="MAT 9:26" /></para>
  <para style="s1">Yesu e Rumigyatumi Rub barya̠gya̠</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Yesu e be ge paba ba'un, haruba haragya a swabe ek, a be ogaga na mahore, a be ange, &lt;&lt;Hoge yama niti, buyu bo Dauda!&gt;&gt; <verse eid="MAT 9:27" /><verse number="28" style="v" sid="MAT 9:28" />Ta Yesu e esh na so yabe pa haruba ani a kore wo eb, nyange naba, &lt;&lt; Itanu suwa na mai rumigyatumu?&gt;&gt; naba ange na eb.</para>
  <para style="p" vid="MAT 9:28">&lt;&lt;I,Botʻbutuwaga,&gt;&gt; <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />Pa Yesu e da̱ri yishaba nyange, &lt;&lt;Zwam e tano e so nuhi a mai rumigyatumu.&gt;&gt; <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Na yishaba sabchi pa Yesu e pasa yek dinya nyange,&lt;&lt;Eta zwama na koga.&gt;&gt; <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Ama naba shere azwama alabare ani kuchi natonge. <verse eid="MAT 9:31" /><verse number="32" style="v" sid="MAT 9:32" />Gagu owaba karege, na ba shibke emai ene muphar mowo muyanshe ek taaje. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Ta Yesu sheratumi muphar ene e pwa taaje uni ba pa eb e kumbe taaje. udubu owato ushi ya̱ heni, &lt;&lt;A tabo ha̱ iyimai irene na israʻila ba.&gt;&gt; <verse eid="MAT 9:33" /><verse number="34" style="v" sid="MAT 9:34" />Ama parisiyawa ange, &lt;&lt;Ai eʻo na butuwaga bo egenga e muphar mowo e be on shiratumaga muphar &gt;&gt;.<verse eid="MAT 9:34" /></para>
  <para style="s1">Yesu e Hoge Ya̱ma yato.</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Yesu e swabe moshepo na shiundu na Galili, e be chibaga na mugenga e be chibaga anabare a tusungo to tugwama to Onhon, e be rumigyatum ato ko mana magom na unagu o tusongo. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Ta eb e ha̱ udubu owato dinya, na eb e hoge yama yato zwam a owe hoge tuzuma ba bone bwa chago yek ba ta tame ne za buhuba̱. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Na eb nyange na aswabo a bune eb, &lt;&lt;Biguba̱ beyo dinya ama ato enk aza dinya. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Zwam nani e tambi Botʻbutuwaga bo biguba̱ butumanya̱ ane a shagiu boika biguba̱ &gt;&gt;.<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s1">Yesu e Ogage Aswabo A bune eb</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Pa Yesu e ogage aswabo a bune eb rekwape na haragya, e pa yek mahonre e shiratume upher owo rumigyatumi ko owana unagu tusong. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Rezhe ryaba reno tumana rekwape na haryagya.</para>
  <para style="b" vid="MAT 10:2" />
  <para style="li" vid="MAT 10:2">Bu Jigu, siman ene yaba ogago Bitrus,</para>
  <para style="li" vid="MAT 10:2">Andarawus buhuwa̱ bo siman,</para>
  <para style="li" vid="MAT 10:2">Yakubu buyu bo Zabadi,</para>
  <para style="li" vid="MAT 10:2">Yohana buhuwa̱ bo Yakubu,<verse eid="MAT 10:2" /></para>
  <para style="li">
    <verse number="3" style="v" sid="MAT 10:3" />Pilibu,</para>
  <para style="li" vid="MAT 10:3">Bartalamawas,</para>
  <para style="li" vid="MAT 10:3">Toma,</para>
  <para style="li" vid="MAT 10:3">Matiyu mai zhangu e gandu,</para>
  <para style="li" vid="MAT 10:3">Yakubu bwa bo Halpa,</para>
  <para style="li" vid="MAT 10:3">Tadayus,<verse eid="MAT 10:3" /></para>
  <para style="li">
    <verse number="4" style="v" sid="MAT 10:4" />Siman bot bo kaʻana</para>
  <para style="li" vid="MAT 10:4">Yahuda iskariyoti ene e sange Yesu.<verse eid="MAT 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Yesu e tuma rekwape na haragya nyange naba, &lt;&lt;Ta kurya wo ana aza yahudawa,eta e sa shepo o Samariyawa. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Ekore wo tami ne epu e isra'ila. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Gagu gashi tuhano gahi shagyaka yek mupasa, gahi zwama &lt; tugwama to turwana to nya̱ wuchi.&gt; <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />E rumigyatumi ane aza e hoge tusongo, nyashingyatumi ane a owagi, e kimga raha, e shiryatume mupher-mowo. a mai pa suba, gahi kumba e pa suba. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Eta humaga̱ zinariya, ko azurupa, ko henda tagula na shirjahu. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />E ta huma̱ga̱ utuwa ko henda, egodu irya, ko hatak, ko agungu zwam tuhanu na tuhi, zwam bot bo enk bu sambari bu hi iyi hone tu dama.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />&lt;&lt;Kowana shepo ko shiʻundu shi gahi esh, e gembe bot bo bura̱ e shani wo bob har gagu gahya mashingeu. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Gagu o gahi esh yaba, nyenge,&lt; Gaparanji.&gt; <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />shi yaba eyo honjhe, gapara nuhi o kazhi wo ab, shi sabariyo ba, gapara nuhi umaringya wo gashi <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />buni bo maicho ba ko henda bo wonge hoge nuhi, e bizhikagi ubutur o bona nihi gagu gashi on shere yaba ko shepo <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />tamahinda na oikamai zwammagaa, a hyango hoge yam yato sodom na gomara na ato shepo oni oho hadoba. <verse eid="MAT 10:15" /><verse number="16" style="v" sid="MAT 10:16" />&lt;&lt;Gyam bot kamai tuma ta temi na so mokerkechi zwam nani iya̱ na turenge ta shahwa, ana za mugunta ta muhurgu.<verse eid="MAT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 10:17" />&lt;&lt; Ishi honjhe na ato, zwam a mai shipko wo ato hadoba a tu, a mai supagi shidub wo Egenga yaba. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Zwam gyam ab mai shibka wo ato tuwaga na bugwam, zwam e zwame anabare a tusungo na bishina̱ byaba na bishina̱ byane aza yahudawa, <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Gagu owaba mai tuta, eta madama nene gahya zwamo a mai pa ene gahya zwam na gagu uni, <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />zwam ba gahi on taaje ba, uhunchi o buchi nabuhi bo on shi taaje wo gahi.<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />&lt;&lt;Buhu bwa tuta buhu boba a hone boik, buchi henda bwatuta bwa bob, awo henda a yago a cheche ba har asa̱ ahunage yek. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Ko ga henda bwa mai wunje zwam rezhenarimi ama bune bo ma ipaga har iyaka bwa hiu muhodo. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Sha mai dame na shepo mai emashinge e some koro shepo oto sha, zwam tamahinda na on kame zwammagaa, kame gahi hwagi ringachagi hashep a isra'ila, buyu bot bwa maringe. <verse eid="MAT 10:23" /><verse number="24" style="v" sid="MAT 10:24" />&lt;&lt;A za buswab bone bo hange Umarumi oboba, ko henda bugyam bwa hyange buch buyabai bob. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Udama buswab bushi ta Umarumi bob, bugyam henda ta buchi bo yaba bob, sheka ange na buchi bo yaba Ba'alzabul to ato yaba henda a zwam na ba haya̱!<verse eid="MAT 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />&lt;&lt;Zwam nani, eta hoga ryansa ryaba, zwam ba ene yo sabtogani ene yaba za sabchiwa, henda ba ene ma swai ene yaba za ha̱ ba. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Ene gem on kame zwammagaa na tuswai ko zwame na tubanga, ene yaba mai zwama henda na tuzwam ezwamagaa yek na muyaba. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Ita hoga ryansa hane a hono buto ba, ama a pwa hone muhondo mo bob ba. e hoge ryansa bone bwa hono kingi na muhondo na yaba e ora. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Ba a sangago munono muryagya̱ kobu oink ba? Ba henda ene nya henago na tunge ba taba̱ na eyado e buchi na buhi ba. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Ko tuhinji to reto na rihi a rotago toika. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />zwama nani e ta huga ryansa ai e hanye mono daraja dinya.<verse eid="MAT 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />Bone bo chibano buchi na bumi na bishina̱ byato gem ma na chibano boik na bishina̱ be buchi nabomi bone boyo zaat na turwana. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Ama bone bo wondo gem ma na wondo boik na bishina̱ be buchi na bumi bone boyo zaat na turwana.<verse eid="MAT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />&lt;&lt;Ita zwama na shibke ashiya̱ a bura̱ ba na tunge.ba zwam na shibkanya ashinya a bura̱ gem koreba saidai bi taga. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Zwam na kore ne</para>
  <para style="q1" vid="MAT 10:35">&lt;&lt; &lt;E sep bwa bushi mushiwa na buchi bo bob,</para>
  <para style="q2" vid="MAT 10:35">Ekangaza na yina eb,<verse eid="MAT 10:35" /></para>
  <para style="q2">
    <verse number="36" style="v" sid="MAT 10:36" />Ato yabe bot ab shi ato moshiuwa mo bob &gt;.<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />&lt;&lt;Bone bo henge kudage yina bob na buchi bob piye na gyam bu dama bushi na bumi ba; henda ko ga bu henge kudaga bwa bo bob ko awo bob henge na gyam bo dama bushi na bumi ba; <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />ko ga bu jhangu aginda a boba bona swabwaba bu dama bushi na bumiba. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Ko ga bone bo guda e chago e rekoko re bob bwa nagu koga bunagu rekoko re bob bwa hiu reka &gt;&gt;.<verse eid="MAT 10:39" /></para>
  <para style="s1">Enke ai topo</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />&lt;&lt;Bone boi cheu gahi boi cheu gem, bone bona cheu gem henda bo cheu bone bo na tuma. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Bone bo che hatuma zwam bob bushi boink bando hatuma bwa hiu ketope ke hatuma, kuma hend bone bo tuwa bubura̱ zwam bob bushi bubura̱ bwa hiu ketope ke bot bura̱. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Koga bo pa ene e hange tu chim ko da ebobo enk e mani matudaru zwam bob bushi buswab tamahinda na on kamai zwammagaa bwanagu ketope ke bob ba &gt;&gt;.<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s1">Yesu Na Yohana e Chago e Baptisma</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Na Yesu e hwagi shaga a swabo a bune eb hakwape na haregya umurni, ne eb emashinge pab ekure e be chibaga e be shi mupas na shipo owaba.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Na gaguni yohana e baptisma e yo na jaro. gagu eb e hoge iyi Botʻbwakimga bo onshi, na eb e tuma aswabo eb wo eb <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />a ka̱ba̱ ek, &lt;&lt; Gembo ne bwa kore, ubu tutane rish wo bomai?&gt;&gt; <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />Yesu chane yek nyange, &lt;&lt; Kuranji zwama yohana iyi gahi ha̱ ne gahi hoge: <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Ruba un hyanagu, agugu onshi tuhano, raha a on shi enke, habebe a on hugaga taaje, a on ishigatumaga ana owagi henda a oin pa hatalakawa anabare a tusungo. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Iyi bura̱ etabachi wo bone bo shiu shak itano so ene bob bu jhe boyo na eb wo gyamba &gt;&gt;.<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Taba karege pa Yesu e pare shagi udubu owato taaje na reto re yohana nyange, &lt;&lt;Ya gashi shere iha̱nagi na ozanga? e sher e hanagi hombe ana opher zhikitaga ek ne? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Nya gahi shere e hyanagi? E kazach nya hya̱ bune bu boda shapo she bizagi? ato egenga e bugwam ab bodagage shapo she bura̱. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Zwam nya gashi shere? e hya bone bo yo ta hatuma? I, na mai zwama har ma e hyange hatuma.&gt;&gt; <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />E bane yaba zabage na reto ryaba ne zwama:</para>
  <para style="q1" vid="MAT 11:10">&lt;&lt; &lt;Gyamwa bot na tuma na boink bando hatuma bu shage tusha,&gt;</para>
  <para style="q2" vid="MAT 11:10">Bone bwa kimagyago yena kame gab kurya.&gt; &gt;&gt;<verse eid="MAT 11:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11" />Tamahinda na oikamai zwammagaa, a tabo machi bone bu hyange Yohana e Baptisma tuwaga ba; Ko nana ni, bune bu hyangetuchimu na tugwama to turwana bo henge ek. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Tuni na azamane a Yohana e Baptisma har koro nare tugwama to Onhon tu on hoge tuzum to mashinge hankali, ato ne mahima henda a kudage a che tugwam to Onhon na mahonre. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />zwam e chibagano musa na ha̱ta̱ka̱ hatuma na sarai a shiu iya̱heni kape yohana e kurya, <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />henda sha yado na tutum twaba, yohana eb yabashi taaje na reto reeb ne zwam iliya ya kure. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Bune buzhe a tube ai hogo, buhoge. <verse eid="MAT 11:15" /><verse number="16" style="v" sid="MAT 11:16" />Na ya̱ gyamwa ga̱ga̱u muget uni? ta awo ane a sha̱ni na kasuwa a be ogaga achagiya rago owoba a be zwammagaa:<verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />&lt;&lt; &lt; Tumai hura ehuri,</para>
  <para style="q2" vid="MAT 11:17">Ewonje ishi tuhebo;</para>
  <para style="q1" vid="MAT 11:17">Tushiu a zuga mawa,</para>
  <para style="q2" vid="MAT 11:17">Ewonje ishi tudaro.&gt; &gt;&gt;<verse eid="MAT 11:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18" />&lt;&lt;Ta yohana e kore e shiu ere na eswa ba, na ba ange, &lt;Ezhe mupyermowo.&gt; <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Na buyu bo bot bu kore bobe re bobe swa, naba ange, &lt;Hengyana bone bujike re na eswa, bu chagiya bwana etwago e gandu na &lt;&lt; Ato turiya &gt;&gt; &gt;. Ko nanani, a gano hikima Onhon wo enke a ob &gt;&gt;.<verse eid="MAT 11:19" /></para>
  <para style="s1">Tir hashepo Ane a Maginduguwa Ba.</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Pa Yesu e hina pasaga hashepo, wo eb ishi enke eb aiyaha̱ni, zwam ato magindugowaba. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />&lt;&lt; Tir nobe, Korasinu! Tir nobe, betsaida! Ta a shiu ya̱ba̱shi wo Taya na Sidon, aka magindugo tuntuni, ab kama budaga shizunzu ab kama zutaga muto na kingi kaba. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Na oikamai zwammagaa, oho hadoba a hyango hoge nyam ato sidon dinya na gahi. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Gab henda kaparnahum, buzach a bu edanduwa kuro turwana? ko ma, a bu kajhu bando ato owagu-owagu. Iya̱bashi ya̱ha̱ni wo gab, nai yabashi na sodom nani oba oyo har nare. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Ama na oikamai zwammagaa, oho hadoba a hyango hoke yama ato sodom dinya na gab &gt;&gt;.<verse eid="MAT 11:24" /></para>
  <para style="s1">Ekurya Wo Gem e Hinga</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Na gagu one Yesu nyange, nabo godu gab, buchi na bumi, Botʻbutuwaga bu turwana na tunge, zwam bu swoi ire te wo ato hikima na a daki, henda bu chibano awo no. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Nani hende buchi, zwam nani ne ob shagiu gab bizagi.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />&lt;&lt; Buchi na bumi bunapa sarai iyi, henda ba bone bu daki bwa sai buchi, henda ba bone bo daki buchi sai bwa, kashe ato bwa bo kudage bo chibane yek &gt;&gt;.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />&lt;&lt;Kuraji wo gem, ane a nibago, henda e oihoge na mai pa ohengo. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />E tuta reto na rihi ta bena be tuta bigwaba be beb wo tuma, henda e daki wo gem, zwam gemjhe tawali'u nazhe sauki o reto, henda yahiu ohengo o muhondo na muhi. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Zwam tugyam na tumi tujhe sauki, azunga nami aza tuchara &gt;&gt;.<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s1">Bot-butuwaga Bo Asaba̱chi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Ab pab oho hugwano o mako,Yesu na swabo a bone eb a swabe bando o sanga o alkama. Aswabo a bone eb henda a hoge remiyaro, paba hinya yacigaga awa alkama a be re. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Ta parisiyawa a ha̱ nani, paba ange na eb, &lt;&lt;Hengyana, aswabo nabeya a owenshi iyi chibagano musa eyanshe ashi oho hongwano o maka &gt;&gt;.<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Na eb nyange naba, &lt;&lt;Ashe,herange ba iyi dauda ushi gagu ub na achagiya a tuhano to ub a be hoge remyaro ba? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Ta eb e esh yabe Onhon ere kuryago kwaba iri, kone kuza honzhe ko eb na achagiya a tuhano to eb are ba, sai hapristochi mob-moba. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Unbu e zazabo bando e chibagano e musa, ta pristochi a egenga a kush hadoba a oho hungwano o mugeta mo tandare, henda ek shiu makwada ba? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Na oikamai zwammagaa, bone bo hyange igenga a buno. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Shika daki ene bizabo bine bizwame wate, e hogo yama gem on, ba uhanchi ba, yek ha̱ ane aza makwada̱ na makwada ba. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Zwam buyu bot bushi Botʻbutuwaga har na oho o henga o mugeta mo tandare &gt;&gt;.<verse eid="MAT 12:8" /></para>
  <para style="s1">Bone Bo Hwe Wa</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Pa Yesu e gye re huga pa eb e esh Egenga yaba. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Azhe bot mai pab bone bo wa hwagi pa parisiyawa ka̱ba̱ Yesu ange, &lt;&lt; E chibaga e musa eyado a rumigyatum bot oho hengano o mugeta mo tandare?&gt;&gt;A zwam nani zwam a ha̱ ek na makwada.<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Pa Yesu e chane nyange na ba, &lt;&lt; She ange bot boink bu jhe bitami boink tal, pa beb be henage na so kari oho hungwano o mako, bot bitami bini bwa shira bek ba? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Ai, bot bo hange bitami bini daraja dinya. Zwana nani a yanso ushi iyi bura̱ oho heng o mugeta mo tandare ba.&gt;&gt; <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Pa eb nyange na gwareni, &lt;&lt;Tuta wa nobe &gt;&gt;.</para>
  <para style="p" vid="MAT 12:13">Na eb e tutane wa, ka paba nawa uruma umaringe ta une umai. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Ama na parisiyawa a shere ashi shawara taba a hono Yesu.<verse eid="MAT 12:14" /></para>
  <para style="s1">Onhon Yinga̱ Mugyama</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Ta Yesu e gane nani, pa eb e ge paba. Na ato dinya a swabe ek, eb e rumigyatumi yek kuchi. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Pa eb e pasa yek ne zwam a ta zwamana ko eb ish ga. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Nani henda zwam ab shiji ene yaba zwame na yinu Ishaya ne zwam,<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />&lt;&lt;Bugyam na bumi bot bo gem yinga̱,</para>
  <para style="q2" vid="MAT 12:18">Bob gyam kudage, bone bo gem on hoge tusongo to bob dinya.</para>
  <para style="q1" vid="MAT 12:18">Na shidu boik na muhondo na mumi,</para>
  <para style="q2" vid="MAT 12:18">Nya̱ zwamagaa Al'umai hadoba tamahinda.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Ya̱ wundo ba, ko eshe taaje namahoreba,</para>
  <para style="q2" vid="MAT 12:19">A hogo begwabo be bob na yina ba.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Usanga-sanga one oya̱ kama gundu,</para>
  <para style="q2" vid="MAT 12:20">A gundu oyeka ba,</para>
  <para style="q1" vid="MAT 12:20">Ya̱ sa̱ mahinda mare nasara,<verse eid="MAT 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21" />Alʻumai henda a tano so na rezhe na rebe &gt;&gt;.<verse eid="MAT 12:21" /></para>
  <para style="s1">Yesu na Ba'alzabul</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Paba shibkani ek bebe buruba bo pher. Yesu henda e rumigyatumi boik, har kwari ishiu taaje henda e pwa ha̱. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Ato kuchi a shiu iya̱ha̱ni ange, &lt;&lt; Shin ba eb ishi buyu bo Dauda ba &gt;&gt;.<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Ta parisiyawa a hoge nani naba ange, &lt;&lt; Ai, na butuwaga bo egenga e muphar Ba'alzabul bugwam eb e on shiryatumaga muphar mowo &gt;&gt;.<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Ta Yesu e daki so owaba pa eb nyange naba, &lt;&lt; Kuchi tugwama tune tumahabsa karyagya a on bitaga, henda tugwam twa yinsa̱ ba. Shep ko yaba ene owato amahabsa̠ karyagya a be shi bitaga owe yinsa ba. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Shi bugwam bo mupyar bwa shiratum muphar bu on bitaga na reto rebob ba'un. inga, tugwama tuni twa yinsa? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Shi na mahore ma Ba'alzabul gem on shiratuma muphar aswab nahi nuwa? na mahore maga maba on shira tumago? Aswabo nahi ab mai shagi'u hadoba zwan uni. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Ama shi gem henda na mahore ma uhuchi Onhon gem on shiryatumaga muphar mowo, she, tugwama to Onhon tukurwa wo gahi ba'un.<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />&lt;&lt;Apwa esh yabe bot mahore a zhangi hazunga bob ba,saide sha pwarago boik katomo,a zhangagi azunga a yabe bob.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />&lt;&lt;Bone bo za ta̱ba̱ na gyamuba,bo on bitaga na gyam ba'un, bone bona banga̱ a tarage ba bo on gataga. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Zwamnani na on kamai zwammagaa, a yapiya ato turiya na taazhe une uza ubura̱, ama bune bushiu taaje one uza ubura̱ wo unhuchi o bura̱ Onhon owa yapiya boik ba <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />She bomai bushi taaje o tibu wo buyu bo Bot, a yapiya boik, bune bushi taaje o tibu wo uhuchi ubura̱ Onhon, owa yapiya boik ba ko nare ko azamane ana yo kore &gt;&gt;.<verse eid="MAT 12:32" /></para>
  <para style="s1">U'owaʻo Na Awa Ob</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />&lt;&lt;U'owaʻo ubura̱ upanga awa bura̱ uʻowan one oza ubura̱ owa panga awa na za a bura̱ uʻowan de na iri awa ob ab gano oika. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Gahi shahwa inga gahya shi taaje bura̱, gahi ka hamugu? sabe one o reu so,eb bot bwa zwam. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Bot bo bura̱ kam, wo ene yo na so bob bwa shira̱ tume iyi bura̱. Mugu o bot,wo tu ira̱ to mugunta mu bob bwa shira̱tume mugunta.<verse eid="MAT 12:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 12:36" />&lt;&lt; Na on kamai zwammagaa, kuchi tazhe o banza o ato oikamai zwammagaa koga bwapa koroto ko bob oho hadoba. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Na taaje nobe ne ab bushagiu hadoba,ko osa̱ shera̱ hojhe ko tashira̱ honjhe ba &gt;&gt;.<verse eid="MAT 12:37" /></para>
  <para style="s1">Ato Zamane a on Gimbaga Alama</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />A mai hamarumi ataura na parisiyawa ange na eb,&lt;&lt;Umarumi, tukudage tu hya̱ a mai alama wo gab &gt;&gt;.<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Pa eb echane yek nyange,&lt;&lt; ato zamane hamugu,ane a ryago amana,a oinginbago a hya̱ a mai alama! Aza a mai alama ka butom yunan. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Ta yunan ish mugeta mu tato, ageta na uhwanho na so muka̱ba mu ekemba nani henda buyu bot bwashi mugeta mu tato na so tunge. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Oho hadoba ato neneba amashipyau taba̱ nato zamani one,a chibano ato zamani one a shiu honjhe ba,zwam ab magindigo zwam mopas mo yunan. Bone bo hyange yunan boyo pab. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Oho hadoba, Sarauniya e sheba ya̱ mashingeu ta̱ba̱ na ato zamani oni, a chibano yek a shiu honjhe ba zwam bu sher hwenya̱ zwam buhogo a chibagano hekima e bugwam Sulemanu.bone bo hyange Sulemanu boyo pani.<verse eid="MAT 12:42" /></para>
  <para style="s1">Giyu u hunchi owo</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />&lt;&lt;Shi uhunchi owo ushero wo gingi ke bot owahina ange pani paza mani zwam uhi rihug rehinga.ama shi hiuba, <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />owa zwam, &lt;Na giya̱ka̱ wo yaba nemi e da e gyam shere.&gt; Shi bangwa koga ba henda e bangu a beshigago, a kimaga yaba, <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />sai emaringe ezhengi uhuchi owo a mai o tandara, one ohyange ek mugunta a kurya esh a shani pub daga pub ashiya bot bum a hango a Jigu nagu bizagi nani ob owayo wo ato zamani uni &gt;&gt;.<verse eid="MAT 12:45" /></para>
  <para style="s">Yini Yesu Na Ahuwa Eb</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Yesu ebe shi taaje na ato ba'un, pa yini eb na ahuwa eb a yinsa nareʻeb, a kudage ashi taaje na eb. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Pa emai nyange na eb, &lt;&lt; Yini nabe ban na hunabe a kodage ashi taaje nagab.&gt;&gt; <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />Pa eb nyange na bone bo zwama ek, &lt;&lt; Ga bushi yini nami, anba shi ahuwa nami?&gt;&gt; <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Na eb echibane aswab a bune eb nawa nyenge, &lt;&lt; Ha̱ yini nami na ahuwa nami ban. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Koga bone bushiu ene buchi na bumi bone boyo na turwana bukudage, bob bushi buhu na bumi na yini nami &gt;&gt;.<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s1">Egagau e Bot Buon Tubero</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Oho ni Yesu isher yabe ni, ekure e sheni na gungu rwaga. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />udubu owato dinya a ringa ek, sai na e be esh na so uku mani e shani, udubu owato uyinsa na gungu rwaga. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />pa e be zwama yek iyi dinya na igagau nyange, &lt;&lt; Bot mai buni bwashi tom bo kore sang zwam bushi tobero. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Bobe ansanga bero ba un, pa bero mai e raga henagage na yina pa monono mu kore mo hwagere. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Emai henda e henge bando hate ayo tunge tuza pa e be shirage ma'inta zwam tunge tuza paba dinya. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Shi onhwaho o zumuwa iregi hwe, zwam e za hagungu ripitu dinya. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Emai henda ehenage bando makada mayo, pa makada ma puch majiki mahore maibo. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Pa emai ehenage bando tunge to sambari pa e be shuwo bini-bini emai akwape tunihi-tunihi, emai henda akwape tato-tato. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Ga bone bu jhe tobe, bo hoge &gt;&gt;.<verse eid="MAT 13:9" /></para>
  <para style="s">Manupa Ta Ab Zwame</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Pa aswabo a bune Yesu a kore a zwame na eb &lt;&lt;Zwam ya gab kogu zwammagaa yek taaje na misale?&gt;&gt; <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />Pa eb e chane yek nyangya, &lt;&lt;Gahi de a yado idaki ene yo swenya na tugwama tu turwana, ab henda a pa yek ba. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Bone bu jhe iyi a kisano boik iyi dinya, ama bone boza koya, a cheu boik chimu ete obob bozhe.&gt;&gt; <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Ene sa naba raga shagi yek taaje na igagau ne zwama:</para>
  <para style="q1" vid="MAT 13:13">&lt;&lt;Ko yeka yingyane a ha̱ ba;</para>
  <para style="q2" vid="MAT 13:13">Ko yeka a kubi atube a hogo ba. Apwa henda a daki ba.&gt;&gt;<verse eid="MAT 13:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 13:14" />Tutuma to ishaya tushindo wo ab ne zwama:</para>
  <para style="q1" vid="MAT 13:14">&lt;&lt; &lt;Ya̱ rage ke hoge, Ama henda yeka daku ba;</para>
  <para style="q2" vid="MAT 13:14">Ama henda ya̱raga keya̱nagu yeka daku ba.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Zwam hakoko haba rego shiu tukanga,</para>
  <para style="q2" vid="MAT 13:15">Hatumbe haba henda a hogage ba,</para>
  <para style="q1" vid="MAT 13:15">Pa ba sabtaga̱ yishaba,</para>
  <para style="q2" vid="MAT 13:15">Zwam yeka ta hyana̱ na yishaba,</para>
  <para style="q1" vid="MAT 13:15">Henda yeka ta hoge na hatumbe haba,</para>
  <para style="q2" vid="MAT 13:15">Zwam yeka ta dake na hakoko haba,</para>
  <para style="q2" vid="MAT 13:15">Har yeka matarage wo gem, gem rumigya tumi yek.<verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />&lt;&lt;Yisha nahi a sha bura̱ zwam a ha̱nagu. Hatumbe na hi ma nani shaka hugage. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Tamahinda na raga ke zwammagaa, hatuma na ato bura̱, aka kudago ehyanu ene gahi hya̱nagu, henda a hya ba, henda a hoge ene gahi raga hugaga henda a hugo ba.&gt;&gt; <verse eid="MAT 13:17" /><verse number="18" style="v" sid="MAT 13:18" />&lt;&lt;To ebake e gagau e bot bo tubero buni. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Bone bo hoge taaje oni o tugwama henda bo gano ok ba, na mugu okurya o yachige ene nyaba beryage na so bob.Ene ebe shi bero ne henage na yina. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Ene e henage bando hate henda,bob bushi shi bo hogo taaje o Onhon, pa bob bo che na so chen. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Ama henda o za hagungu ripitu, buza mahore henda, har shi tumaye tozum to kore zwam taaje obe, kapaba bob bo hinage. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Ene e henage bando makada henda, bob ne bune bo hoge taaje, ama zwam tuzom to tonge na emaka̱nu e tonge e kubbugage taaje, har o maringe oza awa. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Ene yaba beryage wo tonge to bura̱ henda, bob bushi bone bo oin hoge taaje henda bo gano oik.Tamahinda bob ne bwa panga awa bura̱, yinka̱ bini, yinka̱ akwape tunihi, yinka̱ henda akwape tato &gt;&gt;.<verse eid="MAT 13:23" /></para>
  <para style="s1">Hombe Na So Alkama</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Yesu e nyangyaka̱ yek egagau mai,nyange,&lt;&lt;Egagau tugwama to turwana na bot bone bu ge naba ,kore tubero na bero bura̱ na sanga bob. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Gagu ato a on murab, na buchagiya bo bitaga bo eb bo kore bo beryage humbe na so alkama na eb e karge iyi eb. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Na tubero to mashinge, tush awo,pa mapuchpuch ma mashinge.<verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />Pa agyam buch bo yaba a kore ange na bob,&lt;Buchi bo yaba,ashe,ba bero e bura̱ gatu bira̱ge na sanga ba to ashi inga nane humbe a shira̱ge?&gt; <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />Pa eb nyenge naba , bune bo na wonje ne bukore bushi enke a te &lt; Agyam ange na eb, bukudage to kore to yacigage to tarage yeka?&gt; <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Ama nyange,&lt;&lt; &lt;A'a &gt; Zwam gagu o e yachigago humbe a yachige taba na alkama <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Ganjhi yek ashi tuwaga bake, har gagu o biguba̱, na gagu biguba̱ na zwam na ato biguba̱ a yacigage humbe na Jigu a tarage, a parage bitubitu a tuki ora, ama alkama henda a zuta̱ na uriya̱ &gt;&gt;.<verse eid="MAT 13:30" /></para>
  <para style="s">Egagau e Bero Mustad</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Pa eb e pa yak egagau emai nyange, tugwama to turwana to yo ta bero e mastad ene e bot mai bo kore bo berage na lambu bob. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Eba ne ishi enak naka wo bero, ama shi shiu tuwaga, sai ehyage ko owana hunbe har umaringe unowan o, har ma munono mukore mushagi tuhwa na habuba ob &gt;&gt;.<verse eid="MAT 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Pa eb e pa yek egagau e mai, nyange, tugwama to turwana to yo ta yisti, one o bwaa bo mai bone bo zagi bo hwach ek na muhu mo alkama kwano katato, har kuchi muhu mo hutarage na yisti &gt;&gt;.<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Yesu e zwama udubu kuchi iri te na egagau u. E zwamga yek koya̱ ba sai na egagau. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Nani henda zwam a shinji e zwam e Ishaya bando hatuma</para>
  <para style="q1" vid="MAT 13:35">&lt; Nashi taaje na egagau,</para>
  <para style="q2" vid="MAT 13:35">Na zwam ene maswen tuni na Jigu tonge &gt;.<verse eid="MAT 13:35" /></para>
  <para style="s">Yesu e Shiu Taje oigagau Hunbe Na So Alkama</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Pa Yesu e ge udubu e esh yaba, pa aswabo a bona eb a swabe ek, ange, tuzwama e gage ene e onshi hombe na sanga &gt;&gt;.<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Pa eb e chane yek nyange, &lt;&lt;Bone bo berage bero bura̱ bob ne bwa bo bot. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Sanga henda oba ne tonge, bero bura̱ henda awa tugwama to Onhon. hombe henda ab shi awo mugu oni, <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />Henda botogo betaga bone bo berage henda, bob ne bugwam bo mupyar. gagu o biguba̱ handa ab ne . tumana hagamba.<verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />&lt;&lt;Ta ba tarage hunbe a tuki ora, nani ab shi ne hwagu e tonge, <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />bwa bot bwa tumane na tumana hagamba bob, a tarage kuchi irine e sape ato ashi ne za e bura̱, na henda ane a onshi enk a mugu a iyi a shere wo tugwama to bob. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Ab henda, a tage yek na yaba eyora̱ otuzuma, pab ab shi tudaro na ture to hera̱. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Na gagu oni ato bura̱, ashi tubanga ta uhwanho na tugwama to buch bwaba. Ga bone bozhe a tupe ai hogo, bo hoge &gt;&gt;.<verse eid="MAT 13:43" /></para>
  <para style="s">Egagau e hiu ene yo sweye</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />Tugwama to turwana ta tuhiu ne tone twaba swe na sanga. One o emai e hi, oik, na eb e kisane swen, zwama e hogo e so chen ne eb e sange kuchi ene e be yo neba, na eb e sa sanga uni.<verse eid="MAT 13:44" /></para>
  <para style="s">Egagau ote o Luʻu-luʻu o Daraja</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />&lt;&lt;Har nare de, tugwama to turwana to yo ta bwa bo kasuwa ne, bone on gembo te o daraja wato,luʻu-luʻu. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Ta bob bo hi luʻu-luʻu oika̱ o daraja dinya na bob bo karge bo sange kuchi iyi bob bozhe bo sa̱ oik.<verse eid="MAT 13:46" /></para>
  <para style="s">E Gagau e Taro</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />&lt;&lt;Har na nare de, tugwama to turwana to yo ta taro o kumbago mukenba one owaba tage na rwaga o kumbage mukimba iri-iri. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Ta ob o shinji ugwara, naba nummi oik na gungu o rwaga. Na ba shanga a yinga̱ga̱ na ba kwangi mune muza mubura̱. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Na ni ob owaya ne hwagu e tonge hatuma hagamba a kore a yachege hamugu wo a bura̱ <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />Haba henda a tago hamugu na so yaba e ora̱ wo ab shi tudaro na ture to hera̱.<verse eid="MAT 13:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />&lt;&lt;E gano ene kuchi?&gt;&gt; Na ba chane ange,&lt;&lt;i &gt;&gt;.<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Nyange naba, &lt;&lt;Zwam nani, kuchi Umarumi one ushi bot boi swabo e tugwama to turwana ta buchi bo yabe ob boyo bone bo bozhe tuhiu tupo na to goshe wo ana a machi boik.<verse eid="MAT 13:52" /></para>
  <para style="s">A Wondo Na Nazarat.</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Ta Yesu e hogi zwammagaa oni ogagau, pa eb e ge rihuga̱ rini. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Na Yesu e kore shep owaba e paare e chibagano ya̱to na mugenga mwaba na ba shi iya̱-heni.&lt;&lt;Pa bot boni bo hi oni hikima na henda mahonre maishagu iya hyani?&gt;&gt; <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />&lt;&lt;Ene ebe shi bwa bo kapinta ba? ba yini eb ne reze ryaba mariyamu ba, ba ahuwa eb ab ne Yakubu, na Yusupu, na Siman, na Yahuda ba? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Ba a huwa̱ a eb a twaa kuchi ayo taba̱ nagatu ba? Daga pa e be hi kuchi iri? <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Pa ba hachigage so na eb.</para>
  <para style="p" vid="MAT 13:57">Ama Yesu nyange naba, &lt;&lt; Ai bone bushi bando hatuma bo pwa nagu'ayaje ba sai na shep o bob na henda so yabe bob &gt;&gt;.<verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />Henda ishiu iya hyani wate dinya ba zwam nagu'ayaje owaba.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s1">Uʻowa o Yohana e Baptisma</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Gaggu ni, bugwam hiridus antipas ehoge anabare a Yesu. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />pa eb nyange na ato ane a ongeu ek enke, &lt;&lt; Ete ebe shi yohana e baptisma. Ashingyatum ek wo ato na owa̱gu, ob osa̱ ek ezhe mahonre me shagu iya ha̱ni &gt;&gt;.<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Zwam tuni hiridus e kumbe yohana e parage ek, e ese ek na zharo zwam hiridiya, bwaa bo buhu bo eb pilibus. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Zwam tuni yohana e raga zwammagaa hiridus ne zwama hadoba ange, ushiuba o shiya hiridiya ba. <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Ko na Hiridus e kudage e hono e yohana, henda e on ryansa ryato Israila, zwam ab jhengi yohana e yo bando hatuma a Onhon.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Oho owaba machi hiridus okorakana, na bwa bo hiridiya bushi tohebo na bishina̱ byato . Busa̱ hiridus e hogo tusung dinya. <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />Har e shagiu boik kutono ya̱pa boik ko ya̱ ene bob bo ka̱ba̱.<verse eid="MAT 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 14:8" />Yini bob a pa boik taaje zwam ene bob bwazwam. pa bob bwange, &lt;&lt;Ana panya reto reyohana e baptisma yanzu na so egeto &gt;&gt;.<verse eid="MAT 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9" />Bugwam hende bo madamago, ama zwam koton ko bob bushi wo ato dinya, pa bob bu sa̱ a pa boik. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Butuma na zharo a yachigya reto reyohana <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />paba shebe ke reto na so egeto pa ba pa ekangaza, e shibkane yini eb. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />pa aswabo a bune yohana a karege, azhengi reʻu re eb a kore a wumba̱. pa ba kore a zwama Yesu.<verse eid="MAT 14:12" /></para>
  <para style="s1">Yesu e Ryagyatome ato Dubu ota</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Na Yesu e hoge nami, pa eb e mashingya e esh ugu mani ekacheu pa mai wo ko ga boza eb-eba. Na udubu owato ohoge nani, pa ba shirage na hashep a ragaga ek na buna. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Na eb e sher na so uku, pa eb e hya udub owato dinya. pa eb e hoge yek ya̱m, e rumigyatumagi ato ana rumagi.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Na rembe ush, na naswabo a bone eb a kore wo eb ange, &lt;&lt;Pate pa za ko ga, renbe ona o shiu. zwama ato a te a karegyage na shi hira̱ shaba a sangyage hato haba kuryage &gt;&gt;.<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Yesu nyange na ba, &lt;&lt;ko yek a koreu ba, e pa yek iyimai are.&gt;&gt; <verse eid="MAT 14:16" /><verse number="17" style="v" sid="MAT 14:17" />Pa ba chane ange, &lt;&lt;Tu za pani ko ya̱ sai kapuk ka ta na mukemba mura̱gya &gt;&gt;.<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />Pa eb nyange, &lt;&lt; Ena panya.&gt;&gt; <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Pa eb nyange na ato a ni a shani zaat mapuchpuch. pa eb e zhangi kapuka̱ kani ka ta na mukemba mura̱, pa eb e dande reto zaat, eshe menga wo Onhon. pa eb e undagage kapuka kani e panga aswabo a bone eb, aswabo a bune eb apanga ato. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Pa koga bu re bushigi. pa ba tarage ene ryata, e shindagi muryago rekwape na muryagya. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Ato na re a wutagi ato tware dubu ta, ban naʻa nawa.<verse eid="MAT 14:21" /></para>
  <para style="s1">Yesu ishi tuhana zaat umani</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />A bai hogu henda, pa Yesu e sape a swabo a bune eb a esh o ugu mani zwan yeka kore wari na gungu. pa eb e yinsa̱ pab zwama e sallami ato. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Ta eb e sallame ato, pa eb e hyane zaat eb-eba zwam ishi menga. har rebe ushiu dinya eyo pab eb eba.<verse eid="MAT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 14:24" />Gagu uni henda ugu oyo na unshe rwaga, harakunbe a mani a raga supaga ek, pher henda o oishi bitaga naba.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />Kusa muroma mutato mwageta pa Yesu e raga shi tuhano na zaat orwaga bando o aswabo a bune eb. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Na aswabo a bune eb a ha̱ ek ebe shi tuhano na zaat o rwaga, pa ba hoge ryasa̱ ange, &lt;&lt;Kesora keto,&gt;&gt;Pa ba sa̱ muʻogo zwam ryasa̱.<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Yanzuyanzu pa Yesu e shagi yek taaje nyange, &lt;&lt; E ta madamaga! Gyam ne, e ta huga̱ ryansa &gt;&gt;.<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Pa Bitrus e chane nyangya,&lt;&lt;Botʻbutuwaga, shi gab ne, na sape na kure wo gab na zaat umani &gt;&gt;.<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />Yesu nyange, &lt;&lt;Kurya nai,&gt;&gt; Pa Bitrus e sher na ugu, e rwage tuhano zaat umani ya̱ kuro wo Yesu. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Na eb e hya̱ phar ozhe mahonre, pa eb e hoge ryansa pa eb e rwage a hibi. pa eb e nsa muʻogo, nyangya, &lt;&lt;Bot butuwaga, na chage!&gt;&gt; <verse eid="MAT 14:30" /><verse number="31" style="v" sid="MAT 14:31" />Yanzu-yanzupa Yesu e tuta wa eb e kumbe ek, nyange na eb, &lt;&lt;Gab shi bone bozhe etano so chimu, zwam ya̱ gab shi sheku &gt;&gt;.<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />Na ba ishi ugu pa pyer o yinsa. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Ato na yo na so ugu a shagi Yesu sujada, a be zwammagaa, &lt;&lt;Tamahinda, gab shi bwa bo onho &gt;&gt;.<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Na ba kachiya rwaga, a kazhiya na tonge to janisarat. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />pa ato shepo ni a gane, tamahinda, Yesu, pa ba zwama ato ne ayo na tonge tuni, pa ba shepkani ek ato ane a rumagagi. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />pa ba ka̱ba̱ ek a da̱ri ko kare ka a po a eb. kuchi ato ne a da̱ru a rumigyagu.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">E bura̱ na Ene za bura̱</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Ab pab na parisiyawa na hamanumi hachibaga a musa a kore bando Yesu wo urshalima pa ba ange, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />&lt;&lt;zwam ya̱ aswabo a bune nebe a raga gundaga alada a ato tuwaga?zwam ab ma shitagagu waba sha re kuryago ba Yesu &gt;&gt;.<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Yesu e chane yek nyangya, &lt;&lt;Gahi no, zwam ya̱ gahi raga hachigaga hadoba a Onhon zwam alada na hi? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Ai,Onhon owange,pa buch na bobe tuwaga na machi na be,hndeʻbone bwa zwago nya̱re ko a machi a bobe. Tamahinda a hone boik. <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Ama gahi zwame,shi bot bo zwame na amachiya bob,&lt;kuchi ene gahi kakudage da nyahiu wogahi a pa Onhon,&gt; To ba mahenda edanduwa buch bo eb ba ba'un. <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Zwam nani,zwam alada nahi, e ringyatum taaje Onhon koya̱ ba. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Gahi uramahuta̱! Ushiu honjhe Ishaya ishi tutom to iya̱heni wo gahi ne zwama,<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />&lt;&lt; &lt;Ato a te no,</para>
  <para style="q2" vid="MAT 15:8">Na munu mwaba raga kana pa tuwaga</para>
  <para style="q2" vid="MAT 15:8">Henda hakoko haba a mereu na gyam.<verse eid="MAT 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 15:9" />A raga kana shegya sujada suba̱;</para>
  <para style="q2" vid="MAT 15:9">A raga chibaga hadoba ato</para>
  <para style="q2" vid="MAT 15:9">Nezwama kare ka Onhon &gt; &gt;&gt;.<verse eid="MAT 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Yesu e ogage udobu owato nyange naba,&lt;&lt;Bakanji e gane. <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Ba ene on e saga na so yunu bot ba eb ya hachigago boik ba, sai ene on shiryago na yunu bob &gt;&gt;.<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Pa aswabo a bune eb a kore wo eb ange na eb &lt;&lt; Budaki haparisiyawa a hogotuzum ta ba hoge taaje ote &gt;&gt;.<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Yesu echane nyange,&lt;&lt;kuchi tubero tone to buch na bumi bone bo yo na turwana bo berage ba, a mutagu toika. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />E ge yek .Ab sha ruba̱ ana raga kakada a ruba.Shi buruba bwakakada bomai buruba kuchi yeka a hina na so ura̱ba̱ &gt;&gt;.<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Pa Bitrus byange Yesu,&lt;&lt; Tuzwama ene egagau &gt;&gt;.<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />Pa Yesu nyange naba, &lt;&lt;Har nare egano ba?&gt;&gt; <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Na on nupi ene bot bwareu, na Jigu nya eso yunu bob, katomo e esh muka̱ba̱ mo bob, henda bwa kore bu gumane, e sher wo kingi ka boba. <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Ama ene shere na yunu e shere wo rekoko, e bane e hachigage bot. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Zwam na so rekoko ene eza bura̱ e raga shirage,ta e hono bot, tukaruwa, tugari, rihi, ezwamo ene gab daki ba, taazhe une oza bura̱. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />kuchii irine e be hachigago bot ama ba kamaguzu wa yahahigago bob ba &gt; &gt;&gt;.<verse eid="MAT 15:20" /></para>
  <para style="s">Etano'eso e Bwaa Bakan'aniya</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Yesu e go pab kore bando o tonge to taya na Sidon, <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Pa bwaa bo mai bo tonge to Kaʻaniyawa bo kore bo dande bigwaba bwange, &lt;&lt;Hoge nyami nimi, gab Botʻbutuwaga, bwa bo dauda mupyar mumai muraga pa bwa na bumi maruru &gt;&gt;.<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Yesu e zwam na bob ko ya̱ ba. Pa aswab a bone ek a kore a roki ek, ange, &lt;&lt; Gab uzangi boik! Zwam bob boraga katu swabe na moʻogo &gt;&gt;.<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Pa eb echane nyangya, &lt;&lt;A natuma zwam tami Israʻila ene yipu, ba zwam emai ba &gt;&gt;.<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Pa bwaa bo kore bo huka̱ na bishina̱ be eb, bwangya,&lt;&lt;Bot-butuwaga, na banga̱ &gt;&gt;.<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Pa eb echane nyangya,&lt;&lt; ya̱ sambaru ba azhengi kuryago kwawo ba a pa shewa ba &gt;&gt;.<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />Bwange,&lt;&lt; i, Botʻbutuwaga,ama henda shewa ma she shagu shirendage kuryago kone ko rega henaga zaat o erunru ya̱to ere kuryago &gt;&gt;.<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Pa Yesu echane boik ya̱nge,&lt;&lt;Yini yaba, e tano so nobe e zhe mahonre,ga bukata nobe otope.&gt;&gt; Yanzu-yanzu bwa bo bob bu rumige.<verse eid="MAT 15:28" /></para>
  <para style="s1">Yesu e Rumigyatum ato Dinya</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Ab pab Yesu e ura̱ na gungu o rwaga o galili. pa eb e ha̱ne zaat o shama. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Ato dinya a kore wo eb. A kore na gunu, na ruba̱, na ane azhe agunu a wa, a pwania taaje, na ato mai dinya, pa ba iri yek na bishina̱ be eb. Pa eb e rumigyatum yek kuchi. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Har ato ha̱ iya hani ane azhe a gunu a wa ebe shi enke, a ruba̱ henda a be ha̱naga̱.Pa ba dande Onhon o Israʻila.<verse eid="MAT 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Ab pab pa Yesu e ogage aswabo a bune eb nyange,&lt;&lt;Na on yam ya̱to ne̱ nare muget mo tato a un ab ta ba̱ na gem,aza henda kuryago. na kodagewa na shep yeka na remyaro, zwam yeka pwa sunduraga na yena &gt;&gt;.<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Pa Aswabo a bune eb ange na eb, &lt;&lt; Pa gatwa heu kapuka kana kadama tu ryagatume ato ne&gt;&gt;.<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Yesu e ka̱ba̱ yek nyangya, &lt;&lt;kapuka̱ kana kahijhe?&gt;&gt;pa ba ange, &lt;&lt;ka tandare na mokeba̱ mo no chimu &gt;&gt;.<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Pa eb e sape udubu owato ni shanga̱ na tonge, <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />pa eb e jhange kapuka̱ katandare na mukemba muni. pa eb e shi menga wo Onhon, pa eb e undagage, e pa aswabo a bone eb, aswabo a bune eb a pa udubu owota. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Ko ga bureu bushigu, aswabo a bune eb a tarage kuryago kone koryata, shinji na muyago mo tandare. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />A to ane are no a wotagi ato tware dubu o na̱shi, ban naʻa na wo. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Ta eb e shepeu udubu owato ni, pa eb esh u'ugu mani ekore tonge to magadan.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">Gembo Alama</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Parisiyawa na sadukiyawa a kore wo Yesu zwam amakani ek, a roke ek e chibane yek alama a mai a tuwaga ana a chibano tuwaga to eb. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Eb echane yek nyange, &lt;&lt;Sha rembe shiu,gahi zwamya, shi ha̱ turwana tu shiu shane, gahi zwamya, &lt;I hin, shepo owa sambaro biyi,&gt; <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Na bungo henda shi ha̱ turwana tuzhe shene, to hachigage shinu, gahi angya, nare ashira̱ a hen.E on daki ta turwana tu swab, ama e pwa daki alama a gagu uni ba. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Ato a zamane oni aza aminchi wo Onhon ba,ashi a mugu. A kodage iha̱ alama, a chibano ek ko owana alama ba,sai alama a yunan.&gt;&gt; Pa eb e ge ek ekarige.<verse eid="MAT 16:4" /></para>
  <para style="s1">Yisti Aparisiyawa Na Sadukiyawa</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Na aswabo a bone eb a kore na gungu, henda, a bobotago a zhangwa kapuka. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Pa Yesu nyange naba, &lt;&lt;Ashi honjhe henda,ashi hankali na yisti o Parisiyawa na Asadukiyawa &gt;&gt;.<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />Paba paare taaje na ato ab a be zwammagaa, &lt;&lt;Obu zwam gatu shibukana kapuka̱ ba &gt;&gt;.<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Na Yesu e hoge nani pa eb nyange, &lt;&lt;Gahi shi ato ai tano so chimu,zwam ya̱ gahi oizwamagaa e za kapuka̱? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Har nani gahi gano ba? ebobotago ta gem ryagyatome ato udubu na kapuka̱ ka ta? moyago mwana mo gahi tarage? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Ko henda gagu owaba ryagatome ato dubu o nashi na kapuka̱ ka tandare, moyago mwana mo gahi tarage? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Inga ta gahi imashinbage e daki bana on taaje o kapuka̱ ba? Nage ishi honjhe na ato yisti o Parisiyawa na Sadukiyawa.&gt;&gt; <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Na pab yek gane ba eʻo taaje o yisti o kapuka̱ ba ama yek ashi honjhe na e chibagano e Parisiyawa na Sadukiyawa.<verse eid="MAT 16:12" /></para>
  <para style="s1">Bitrus e Yado Yesu Ishi Bot-bwakimga</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Ta Yesu ekore tonge to Kaseriya Pilibi pa eb eka̱ba̱ aswabo a bone eb nyange, &lt;&lt;Ya̱ ato a on zwammagaa bwa bot bushi &gt;&gt;.<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />Paba ange, &lt;&lt; A mai ange Yohana e Baptisma, a mai henda Iliya, a mai Irimiya, ko henda bumai bando hatuma &gt;&gt;.<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />Pa eb nyange na ba, &lt;&lt;Gahi nuwa gemushi ga ne ha̱ nuhi?&gt;&gt; <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />Pa Siman Bitrus e chane nyange, &lt;&lt;Gab shi botʻbwakimga, bwa bo Onhon o muhondo &gt;&gt;.<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Pa Yesu e chane nyange, &lt;&lt;Iyi bura̱ e yo wo gab Siman buyu bo yunan, zwam ba bot ne bo bu zwama ba, ama bando mahya na mami na buch na bumi bone boyo na turwana. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Na on kabo zwammagaa, gab shi Bitrus, na zaat te, ote gem on mago ato nami aiswabo, Egenga nimi,ene mahore muza mahore na oba. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Na bopa iyaguje yinu eso e tugwama tu turwana henda ene ya̱ba para na tonge,a para yek na turwana.Ene ya̱ba pashingiu na tonge, a pashingiu yek na turwana.&gt;&gt; <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Na eb e pasga aswabo a bune eb dinya a ta zwamana ko ga ne zwama ebe shi botʻbwakimga.<verse eid="MAT 16:20" /></para>
  <para style="s1">Yesu e Zwam Ta Eb ya̱ u</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Tun na gagu ni Yesu e kumbe ubchaga aswabo a bone eb ne zwam dole ekore Urushalima, e su tuzuma iri-iri na wa muya̱re na pristochi a tuwaga na hamarumi ai chibagano e musa a hone ek,na mugeta mu tato anshige ek.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Pa Bitrus be numi ek gungu ui unka pa beb be pasaga ek, Onhon kimaga, Botʻbutuwaga!&gt;&gt; Nani owaparo na gab ba &gt;&gt;.<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Na Yesu e magijege nyange na Bitrus,&lt;&lt;Marabi na gyam, gab bugwam bo mupyar! Gabwa na sapo odubuta, bu on tunane ta bot, ba ta Onhon ba &gt;&gt;.<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Pa Yesu nyange na aswabo a bone eb, &lt;&lt;Bone bo kudage kana swabo, bo wonje ret rebob,bo jhengi a gendo a boba bona swabe.<verse eid="MAT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 16:25" />Bone bo kodage bo cheche rekoko rebob, bwanagu. Ama buni bunagi rekoko rebob zwama gem, bwahiu.<verse eid="MAT 16:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 16:26" />Iri ya̱ bot bwa hiu, shibu hiu tunge kuchi zwam muhondo na bobeya? Ob henda ya̱ bot bwa pa zwam rekoko re bob? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Bwa bo bot bwa kore na tumana hagamba bob na so e dande buchi bob,nanani eb nya̱ topo koga enk a bob. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Tamahinda na on kamai zwammagaa, azhe a mai pani ane a owagu ba, sai a hya̱ koro Bwa bot na tugwama to bob &gt;&gt;.<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s1">Kamasaka o Kingi Ka Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Na mugeta mutunihi Yesu e jhengi Bitrus, Yakubu,na Yohana buhu bwaba Yakubu e zhangi yek zaat o shame geso ab haba. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Wate kingi ka eb ka maginjige na bishina̱ byaba, shinu eb ishi tubanga ta onhwanho azunga eb ashi chan ta tubanga. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />kapaba pa musa na iliya a sher wo eb aba shi taaje na Yesu. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Bitrus nyange na Yesu,&lt;&lt;Botʻbutuwaga, oyo honzhe gatu ana a gatu yo pani shi bu kudage tushi mugenga mutato Inka̱ nebe Inka̱ e musa Inka̱ henda e Iliya.&gt;&gt; <verse eid="MAT 17:4" /><verse number="5" style="v" sid="MAT 17:5" />Bitrus bebe shi taaje ba'un sai umai harana utubanga ukore usabta yek pa ba hoge bigwab bi mai naso harana byange bwa na bumi a bot bogyamu kudage bone bo gem onshi so ochen na bob dinya e hoge boik. <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />Ta a swabo a bune eb a hoge nani pa ryansa rehuma yek dinya, har a hinage na tonge. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Pa Yesu e kore e da̱ra̱gi yek nyange, &lt;&lt; Mashingyanji, e ta hoga ryansa &gt;&gt;. <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Naba ashinge hato a ha̱ ko ga ba ka Yesu eb eba. <verse eid="MAT 17:8" /><verse number="9" style="v" sid="MAT 17:9" />Ta ba on kazhagi na mushama, Yesu e pasga yek nyange,&lt;&lt;Eta zwama ko ga ene gahi ha̱ni, ka ashingo bwa bo bot ane a owagi.&gt;&gt; <verse eid="MAT 17:9" /><verse number="10" style="v" sid="MAT 17:10" />Aswabo a bune eb a ka̱ba̱ ange, &lt;&lt;To, zwam ya̱ hamarumi echibagano e musa ange ne zwama dole sai butum ishaya bukurwakana &gt;&gt;.<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Yesu e chane nyange &lt;&lt;Ta mahinda iliya ya̱ kore, ya̱ kimaga koya̱. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Ama na onkamai zwammagaa, iliya eyowa e korwa̱, yeka gano ek ba, har a shage ek ene ya̱ ba kudage. Nani henda bwa bot bwahogo tuzuma na wa yaba.&gt;&gt; <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Pa aswabo a bune eb a gane e on shagi yek taaje na reto e yohana e baptisma.<verse eid="MAT 17:13" /></para>
  <para style="s">E rumigyatumu bwa bozhe muphar</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Ta ba wutagi udubu owato, pa bot bunka bu kore wo Yesu bu kuki na bishina̱ be eb bwange, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />&lt;&lt;Botʻbutuwaga, hoge yeme bwa na bumi, bu onshi owagi-owagi, e oi hoge tuzuma dinya. ko hwane e oin hinagaga na so ora̱ ko na mani. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Na shibkiu ek bando aswab a bone bo, a rumigyatumu ek ba &gt;&gt;.<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Yesu e chane nyange, &lt;&lt; Gahi ato nagu'ayaje, Ana aza ehugago a mugeta muni! Har hwane gyamwa shanu nagahi? Har hwane henda gyamwa na ipga̱ na gahi? Ena shibkanya boik wo gyam.&gt;&gt; <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Pa Yesu e pasa muphar mowo, muphar mowo henda moge bwa, kapaba bwa bo rumigi.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Na aswab a bune eb a kore wo Yesu gagu ni ko ga buza wo eba, ange na eb, &lt;&lt;zwam ya̱ gatu mashenba shira̱ tuma muphar mowo?&gt;&gt; <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" />Yesu nyange naba, &lt;&lt;zwam etano so nuhi e za dinya. Tamahinda na on kamai zwammagaa, shi jhe etano so enakanaka ta bero musta, e pwa zwam na shem uri umashinge pari karo wani henda o mashinge, a za ene gahi mashinbe. <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />Ai iri ete e shiryago ba sai na mayinga na touware &gt;&gt;.<verse eid="MAT 17:21" /></para>
  <para style="s">Yesu eshaka̱ taaje zwam uʻo eb</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Na aswabo a bune eb amatarage bando o galili, pa Yesu nyange naba, &lt;&lt;A pa bwa bot na wa yato, <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />Henda a hono ek na mogeta motato a mashingyatum ek.&gt;&gt; Aswabo a bune eb a madame dinya.<verse eid="MAT 17:23" /></para>
  <para style="s1">Ketope Ke Gandu oi Genga</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Na Yesu na aswabo a bune eb a esh kaparnahum, ato chago e gandu zwam Egenga a bangi Bitrus ange na eb, &lt;&lt;Umarumi nuhi otopagu gandu ne genga ba?<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />Bitrus nyange, &lt;&lt; I etopago mana?&gt;&gt; Na Bitrus be gi yaba, pa Yesu e shagi ek taaje ya̱ngya, &lt;&lt; ya̱ gab hya̱ Bitrus? wo anba bugwam bu chago gandu, wo awa ba, onbu wo ato mai &gt;&gt;.<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />Ta Bitrus nyange,wo ato mai, pa Yesu echane nyange na Bitrus, &lt;&lt;Unbu awo tupago ba'un. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />ko nani, zwam ato ni a ta hachigaga so na gatu, kore na rwaga tane mazubuka̱, gab ubchiya̱ yunu kemba ene gab rwage kumbe, bwa hiu azurupa ane a dama, gab jhangi azurupa ani gab tope gandu nobe na umi &gt;&gt;.<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Ga Bu Hange Tuwaga</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Gaguni aswabo a bune eb a kore wo Yesu a ka̱ba̱ ek, ange,&lt;&lt;Ga bu hyange tuwaga wo tugwama to turwana &gt;&gt;.<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />Pa Yesu e ogage bwa bo no, pa eb e tane boik na oshi owaba, <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />nyange, &lt;&lt;Tamahinda na raga ke kaizwamagaa, unba, shi maginjigeu ko maringiu ta awo no ba, nya̱ eso tugwama to turwana ba. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Bone bu zhangi reto reboba nezwama buhi iyi mai ba ta bwa bo no bote, bob ne bu hyange tuwaga wo tugwama to turwana. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Bone bu cheu bwa bono boik ta bone zwam gem, gem bob bo zhangi &gt;&gt;.<verse eid="MAT 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />Ama kuchi, bone bu sape awa no ane a tano so nagyam ashi magwada̱ owa hyango a para̱ boik te otuwaga na begwabo be bob, ab hibi boik na rwaga oto kwa̱ra̱.<verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />&lt;&lt; Tir nobe tonge zwam ene yasa̱ odubuta ato ashi makwada̱, kamahinda ene yasa̱ makwada e kurya, ama tir bone bo sa!<verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />Shi wa nobe ko buna nobe ob owa nsa gab shi ene ze bura̱, gab gunji opashe. owa hyago o hi muhondo mo dududu na wa oinka̱ ko buna oinka̱ ko bugudu, na be kabo tana na so ora̱ one o usa̱gagiwa na wa biragya ko buna biragya. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Shi henda isha nabe a sa̱ gab bi shi ene za bura̱, gab yachinge opashe. owa bo hangeu gab esh muhondo mo dududu na rishi ringa̱, naba kabo tana na so ra̱ one o usagagiwa ne isha haragya.<verse eid="MAT 18:9" /></para>
  <para style="s1">Egagau na bitami bine bepu</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />Ishi honjhe, eta yaga ko bwa bwama bo nowa̱, zwam naraga ke zwammagaa, tumana hagamba ab ko hwane yeka yenge shinu buchi na bumi bone boyo na turwama. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />Zwama bwa bot bo kore e chage ana pu. <verse eid="MAT 18:11" /><verse number="12" style="v" sid="MAT 18:12" />&lt;&lt; Nya gahi ha̱? Shi bot bozhe tami buni pa binka̱ be pu, bwa geu ene ryata̱ akwape tanasha na tanasha na moshama e be kore e gembage binka̱ bene be pu ba? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Henda shi ha̱naka̱ bek, tamahinda na on ka maizwamagaa, makoda mai eb ya̱shi zwam beb, ma ha̱go mani ma iri akwape tanasha na tanasha ene pu ba. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Nani ma buchi na buhi bone boyo na turwana bo kodagiwa boik wo awo nono bupu &gt;&gt;.<verse eid="MAT 18:14" /></para>
  <para style="s">Shi Buhu Bushi ene Zai bura̱</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />Shi buhuwa na bobe bu shagiu ene sambariwa, karegya chibane ek ne zwama e bu shagiu tukwada gahi na eb gahi gahi. shi buhuwa na bobe bo hogo, bo rengyatomo buhuwa na bobe ba un. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Ama shi bo hogo taaje nobe ba, gab kuraka wo bob na bot binka̱ ko ato baragya zwam a daki taaje bando munu mwato barya̠gya̠ ko ato tato. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Shi bu wonje hoge, gab zwamana Egenga Onhon, shi e wondo ringyatume ek ta bone bo dakiwa̱ Onhon ko bone bozhe makwada bone bo chago ga̱du honzhe ba. <verse eid="MAT 18:17" /><verse number="18" style="v" sid="MAT 18:18" />Tamahinda na oikame zwammagaa kuchi ene gahi para na tunge,eyo parage na turwana. kuchi ene gahi pashingiu na tunge, henda eyo mashingiya na turwana.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />&lt;&lt;Tamahinda na rega ke zwammagaa, shi ato baragya na so nuhi na tunge a gaje a gembage emai buchi na bumi bone boyo na turwana bwa shageu ek <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Shi ato barya̠gya̠ ko ato tato a matare wo rezhe na rimi na yo sowaba &gt;&gt;.<verse eid="MAT 18:20" /></para>
  <para style="s1">Egagau E Bugyam Bone Bo Wonje A yape</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Ab pab pa Bitrus e kore wo Yesu nyange na Yesu, &lt;&lt;Botʻbutuwaga, kana buhu na bumi bwana shagiu tukwada gem yapiya boik? Ka tandare ne &gt;&gt;.<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Yesu nyange na eb, &lt;&lt;Ba katandare ba, ama henda katadare har akwape tandare. <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />Zwamnani, a gagau tugwama to turwana na bugwam bo mai bone bo kudage rutago e tonge to bob tone to yo na wa nya̱ gyama bob. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Na bugwam bone bo rwage koroto, pa ba shib kani ek buto bo mai bone bwaba swabe boik utash o azurupa dubu rigwape. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Ta eb e mashibage etope, pa bugwam bone bo sape a sange ek a .bwaa bo eb na awo eb kuchi ene ebe zhe a sange a tope <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />Pa bugyam bo hunka na bishina̱ be bob bobe shi roko bwangya, &lt;&lt;Sha hankuri na butopo koya̱.&gt;&gt; <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Zwam e hogo e nyama e bugyam bu te pa buch bo yaba e bob bo pashe boik pa bob bo yapiya ek otash.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />&lt;&lt;Ama bugyam bu ni na bob bo sher, pa eb e bangi buchagiya bo eb bo enk bone bo eb e swabe boik otash o azurupa chimu, pa eb e huma boik bigwaba nyangya, &lt;&lt;Na topiya irine gyam bo swabe &gt;&gt;.<verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />Pa bu chagiya bo eb bo enk bu hunka̱ buginbage yapiya wo eb, &lt;&lt;Na shagi hankuri, na bo tupo &gt;&gt;.<verse eid="MAT 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30" />Ama pa bugwam bone bowonje, kore hend e ese ek najharo, sai e topo ek otashe eb. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Na achagiya eb a enke a hoge ene paare, henda yek hogo tusungo ba. pa ba kore azwama bugwam ene paare.<verse eid="MAT 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32" />Pa butuwaga bone bo ogage boik tugyam bwange na bob, &lt;&lt;Gab shi mugu o bugyam. Na bo yapiya kuchi utashe gyam na bo swabe. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Henda, okamachie gab hoge yam e buchage bo enke nebe ba ta gem hoge ya̱m nebe ba.? <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Butuwaga bo hachigago so dinya, bo sape a para ek har etope kuchi o tash uni.<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />Na ni henda buch na bumi bone bo yo na turwana bwa shagiu ko ga bone bo wonje yapiya bot bob na so inka̱ &gt;&gt;.<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s1">Echibaga e Yesu Wo e Hono Ushiyano</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Ta Yesu hwagi ezwamago e irini, e go tunge to galili e a shi tunge to yahudiya tone toyo hiro rwaga o yodan. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Ato dinya a ragaga ek, irumigyatom ato ne a rumagagi pab.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Ab pab parasiyawa a mai a kore wo eb zwam yek amakani ek, ab ek angya, &lt;&lt; Ta chebagano e musa, osu honjhe naniya bot bo pashe bwaa boba zwam ko mana makwada̱ &gt;&gt;.<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />Pa eb echane yek nyangya, &lt;&lt;Ashe, e zazabo ba ne zwama, bune bushi ko ya̱ buni bushi yek tun na Jigu bushi yek bot bo tore na bwaa,&gt; pa eb nyange henda, <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />&lt; Zwam nani pa, bot bwa go buchi bob na yina bob bo hokutae bwaa bob, ab baraje ashi boik.&gt; <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Har pani tusha a sha ato baragya ba, sai dai a nya̱ ta bot binka̱. zwam nani, ene Onhon gami, bob bo ta hab saga̱ &gt;&gt;.<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Pa ba ange na eb, &lt;&lt;To, zwam ya̱ musa opa doka a pa utakarda o hono ushiyana, henda a pas bwaa &gt;&gt;.<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Pa Yesu nyange na ba, &lt;&lt; Zwam onagu ehogo nohi oba osa musa o yaje e pasagyaʻa, nahi tun na Jigu ba nani ba. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Na on kamai zwammagaa, ko ga bo pashe bwaa bob, unba a bangi bobe shi tugariba, na bob bo shiya bomai, bushin tugari &gt;&gt;.<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Aswabo a bune eb ange na eb, &lt;&lt; Shi nani obo yo wo bot na bwaa bob, onagu ushiyana o zachema bukashiu ba &gt;&gt;.<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Ama pa Yesu nyange naba, &lt;&lt; Ba ko ga bo pwa zhangi taaje uniba, sai ane a Onhon yaje yek. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Azhe ane ab machi a za byanta ana apwa shi ushiyana ba. Azhe ana ato rengyatum yek nani. Azhe ana ayaje a shi ushiyana ba zwam e kudago e tugwama to Onhon. Bone bo pwa jhangu taaje oni buzhangi &gt;&gt;.<verse eid="MAT 19:12" /></para>
  <para style="s1">Yesu e tani awo yinu-bura</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Pa ba shib kani Yesu awo no zwam etane yek yunu-bura, Ishagi henda yek menga, pa swabo a pasa yek.<verse eid="MAT 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14" />Pa Yesu nyange na ba, &lt;&lt;Gaje awo no kure wo gem. I ta yasa̱ yeka, zwam tugwama to turwana tush twaba&gt;&gt;.<verse eid="MAT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 19:15" />Pa Yesu etane yek wa bura̱, pa eb e karge.<verse eid="MAT 19:15" /></para>
  <para style="s1">Oragasu one ozhe</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Ab pab bot mai bo kore wo Yesu bwange, &lt;&lt;Umarumi, ya̱ ne gemwashi zwam e hi tugwam to turwana to dududu &gt;&gt;.<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />Yesu nyange na eb, &lt;&lt;Ya̱ esa̱ gab na ka̱ba̱ga̱ zwam ene sambari? ai Onhon oboba obu̱sh ubura̱. Ama shibukudage e hi̱u mohod mu dududu, sai bo yeu doka te &gt;&gt;.<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />Pa eb nyange na Yesu, &lt;&lt;Hana?&gt;&gt;Pa Yesu nyange, &lt;&lt;Ta huna buto, Ta sha̱ tugari, Ta sha̱ rihi, Ta sheda taka, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />Pa tuwaga wo buchi na bobe niyini nabe. Gab kudage bone bo gahi zhe maginda na bob ta gab kudage reto na bobe &gt;&gt;.<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />Uragasu owange na eb, &lt;&lt;Na geu irini sarai ya̱ ena ryantage &gt;&gt;.<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Yesu nyenga na eb, &lt;&lt;shi bukudage bushi muhondo bot, kore sange ene gab zhe kuchi, Gab pa ana za kurbi, bwa hiu ketope gab kurya na swabe &gt;&gt;.<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />Na uragasu oni o hoge nani, pa ob o karige na rehato reso, zwam ezhe tuhiu dinya.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Pa Yesu e zwame na aswabo a bone eb, &lt;&lt; Tamahinda na on kame zwammagaa, owash maduru wo bot bo tuhiu bo esh tugwama to turwana. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Na kisane kamai zwammagaa, owazako orakume o ura̱ reuno ya̱ jimura. na bot bwa hiu bo esh tugwama to onohn &gt;&gt;.<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Na aswabo a bune a hoge nani, pa ba shiya ha̱ni dinya, pa ba ange, &lt;&lt;Shi nani, ga bwa hiu e chago &gt;&gt;.<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Yesu e yingyane yek nyange, &lt;&lt;Wo ato kam, o pwa shi ba, ama wo Onhon koya̱ opwashi &gt;&gt;.<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Pa Bitrus nyange, &lt;&lt; Gatwabona twa go koya̱ tubu swabo, to ya̱ gatu twa hiu &gt;&gt;.<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Pa Yesu nyange naba̱ &lt;&lt; Tamahinda na on kamai zwammagaa, zamani ana a on koro, gagu ni bwa bot bwa shanu na iruru e tugwam to bob ya̱ dando, Gahi ane ana swabe, Gahi henda ya̱ shanu ne iruru e tugwam to ibenchi rekwape na haryagya a Israʻila <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Henda ko ga bo ge yaba, ko shihu she tware, ko shihu she twaa, ko buch, ko yini, ko awo, ko sanga, zwam e dande reze na rimi, ya̱ hiu ene ha̱ge buini, e be gado muhundo mu dududu. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Ama ato dinya ane ashi a Jigu, a maringe ato akunda̱ga̱, akundaga a maringe ato Jigu &gt;&gt;.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s1">Ato Enke Na Sangainabi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />Tugwama to turwana turyanga̱ ta buchi bwaiyaba emai bone bo sher tuni na bongo zwam e zhangi ato ana shagi ek enke na sanga bob o inabi. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Na ba mashiri ta kuribi ya ba tupa bot bo enke na huru, pa eb e toma yek na sanga o eb. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />Na biroma be tanasha bi shi pa eb e sher, na eb e hya̱ ato mai a shagi banza suba̱ na gungu kasuwa, <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Pa Yesu nyange naba, &lt;&lt; Gahi ma koragi sanga numi, na topo ene Na eb e shiraka sembari&gt;&gt;Paba karege. <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Na eb e shiraka na onhwo, na henda biroma be tato, e jhangi ato enke. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Har nani koro biroma be ta henda e shir e bangi hamai a on yensage banza a on komiba, pa eb nyange na ba, &lt;Zwam nya gahi shanga̱ banza har huru?<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />&lt;&lt;Pa ab ange na eb, &lt;Aza bone bwa tupa enke tushi.&gt; &lt;&lt; Pa eb nyange naba, &lt;Gahi ma ekore sanga numi &gt;.<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />Na rembe ushi, pa bot bo sanga bwange na madadi ma bob hingyana enke a sanga, &lt;Ogage ato enke tope yek, gab rwage na bone bu kundaga koro bone bo Jigu &gt;.<verse eid="MAT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9" />A ne a kundage a kore ato ta, ko ga bo shiu ene samban a tope boik na huru. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Ana a rwage a ka zache a tope yek maheya ma mai, ab ma a yape yek ene sanbari na huru. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Naba che ab kama hunji na buchi bo yaba, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />A be zwammagaa, &lt;&lt;Ana kore na kunda̱ga̱, enke a biroma binka̱ ab shi, burengyatome yek ta gato, gato ato gatu hurumi gatosh enke a che ehogo e onhwon &gt;&gt;.<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />&lt;&lt;Pa eb e chane bot binka̱ bando owaba nyangya,&lt;Buchagiya nabumi, ai, na bu chutu ba. ne zwama na bo topo ta ba hurmaguba? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Bo cho ene shi nebe katomo. E ha̱ e dama nomi pa gem topa gyato ta gem otope gab. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Na za dama ishi ene gyam nakudage nenimiya? ubo gab on tushibiya nene gyam na onshi e bizagi ne?<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />Nani henda ana kunda̱ga̱ a maringeu ana yo nesa &gt;&gt;.<verse eid="MAT 20:16" /></para>
  <para style="s">Yesu Eshaka̱ Taje Zwam uʻu eb</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Na Yesu na swabo a bune eb a on dandaga kuro urshalima, pa Yesu e kajeka gungu yena nyange naba, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />&lt;&lt;Gatwabona twakoro Urushalima, a pa bwa bot na wa pristochi a tuwaga na hamarumi a e chibagano musa, a shera ek hukunchi owe hono . <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />Daga pa a tuta ek pana aza yahudawa ba, a shage ek zwamorato a supagu ek shidub, henda a genda ek muget motato ya̱ mashingeu &gt;&gt;.<verse eid="MAT 20:19" /></para>
  <para style="s1">Gembo yini yakubu na yohana</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Nanani, pa yini awo zabadi a kore bando Yesu na awa eb, a hunka na bishina̱ eb a gembago iyi mai.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />Pa eb nyage na bob, &lt;&lt;Ya̱ gab kudage.&gt;&gt; bwange na eb, &lt;&lt;Tana awa te baragya a shani, buinka̱ na katega, buinka na kagura̱, na tugwama na tobe.&gt;&gt; <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />Ama Yesu nyange na awa ni, &lt;&lt; E daki ene gahi on gembo ba, bo pwa swo na ebobo e tozoma ta gemwa swa?&gt;&gt; Pa Yakubu na ange na eb, &lt;&lt; To pwa shi &gt;&gt;.<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Yesu nyange naba, &lt;&lt;Tama hinda ya̱ swa na ebobo na bimi, Ama eshanu na katoga ko na kagura̱ gem pwa ba.Buchi na bumi na turwana bob bwa panga zwama ana bob bo zhengi.&gt;&gt; <verse eid="MAT 20:23" /><verse number="24" style="v" sid="MAT 20:24" />Ta aswab ane a ryata rekwape a hoge nani paba hachigage so na huwa ba barya̠gya̠. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Ama Yesu e ogage yek kuchi nyange, &lt;&lt;E daki ta butuwaga bo egenga na gwama ane aza yahudawa ba, a on chibaga yek mahore. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Owa ya̱ nani wo gahi ba. Zwam nani bone bo kudage bushi bot bo tuwaga wo gahi, tamahinda bwahina shagyaga̱ ato mai tugyam. <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />Nani henda bone bo kudage bushi bot bo tugwama wo gahi, tamahinda bushi bugyma na buhi. <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />Nani henda bwa bot bo kurwa zwam a shagi boik tugyama ba sai de bob bushi tugyam, henda e pa rekoko re bob zwam e chago ya̱ to dinya &gt;&gt;.<verse eid="MAT 20:28" /></para>
  <para style="s">Aruba̱ Barya̠gya̠ A hiu e Hyano Shepo</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Na Yesu na aswabo a bune eb a ge <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Pa ba ha̱ aruba a mai barya̠gya̠ na gungu yena, ta ba hage Yesu e on karegya, paba dande bigwab a be ogaga, &lt;&lt; Botʻbutuwaga bwa bo dauda hogo ya̱mi niti!&gt;&gt; <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />Ato pasga yek a zhigitagi, paba kisane dande bigwaba ange, &lt;&lt;Botʻbutuwaga bwa bo Dauda hogo ya̱ma nuti!&gt;&gt; <verse eid="MAT 20:31" /><verse number="32" style="v" sid="MAT 20:32" />Pa Yesu e yinsa̱ nyange naba, &lt;&lt;Ya̱ gahi kudage ne shagi?&gt;&gt; <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />Pa ba ange na eb, &lt;&lt;Botʻbutuwaga, ga tuha shepo <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />Zwam e hogo e ya̱m, pa Yesu e da̱ri yishaba,ka paba, paba rwage ehyanagu paba swab ek.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s1">Yesu Esh Urshalima</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Gagu Yesu na aswabo a bune eb a esh Betapaji ringu Urshalima, bando mushama mo eʻo Zaitun, na eb e tuma aswabo a bune eb barage, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />Nyange naba,&lt;&lt; Ishanji moyaba mo ri mo yo na bishina̱ bihi. Eso nuhi nya hya azhanke a mai a ura̱ na bwa bo ab. pashige ek e na jhangya. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Shi bot mai bo shagiu taja nyangya, &lt;Botʻbutuwaga bo kudage yek.&gt; A maringyatome yek yanzu &gt;&gt;.<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Ashi nani zwam a shinji ene e hatuma a zwame,<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />&lt;&lt; E zwama na shepo o Sihiyona,</para>
  <para style="q2" vid="MAT 21:5">&lt;Yingyana bugwam a bot kore wo gahi!</para>
  <para style="q1" vid="MAT 21:5">Bu za edande reto</para>
  <para style="q2" vid="MAT 21:5">Zaat na bwa bo azhanke e be on shi tuhano &gt; &gt;&gt;.<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Pa aswabo a bune eb a kore, ashi ta eb nyange ashi <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Pa ba shibkane azhanke na bwa bo ab, a baragyage shapo shaba eb henda e hyane e shani. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Ato dinya a barage shapo shaba, nayina, ato mai henda a gundagagi, huma neʻo a barage na yina. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Ato ne ayo na bishina̱ be eb na ane ayo nensa a dande be gwabo a be zwamage</para>
  <para style="q1" vid="MAT 21:9">&lt;&lt;Hosanna buyu bo dauda!</para>
  <para style="q2" vid="MAT 21:9">Iyibura̱ eyo</para>
  <para style="q1" vid="MAT 21:9">Bone bo yo kore na rezhe re Bot-butuwaga!</para>
  <para style="q2" vid="MAT 21:9">&lt;&lt;Husana pa bone bo hange a dande &gt;&gt;.<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Ta Yesu e esh urshalima, sarai shep uwa̱zhinya̱ a be zwammagaa,&lt;&lt;Ga buni &gt;&gt;.<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Pa ane a swabe Yesu ange,&lt;&lt;Ai ene esh boink bando hatuma reze re eb Yesu e sher nazarat o Galili &gt;&gt;.<verse eid="MAT 21:11" /></para>
  <para style="s">Yesu e Kimaga Egenga</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Pa Yesu esh Egenga e unzagagi ato esango e kuryago e tagage tabur o ato chanji ikurubi ne sango e muhurgu mu yaba. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Yesu nyan naba,&lt;&lt;Oyo zabagi,</para>
  <para style="q1" vid="MAT 21:13">&lt;&lt; A zwamo na yabe nimi yabe menga</para>
  <para style="q2" vid="MAT 21:13">Ama emaringyatome yek ahuga ai kama swaga rihi &gt;&gt;.<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Pa haruba na angu a kore wo eb pa Egenga pa eb e rumigyatumi yek. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Ama pristochi a tuwaga na hamarumi ai chibagano musa a hya iyahyani ebe shi, har awo a no a be shi mu'ogo a be zwamaga, &lt;&lt; Hosanna wo bwa bo Dauda!&gt;&gt; Pa ba hachigage so. <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Pa ba ange na eb,&lt;&lt; Bo hogo ene ya̱ ba a on zwammagaa nowa?&gt;&gt; Yesu nyange naba na so ataka̱ a taaje Onhon ba ne zwama,</para>
  <para style="q1" vid="MAT 21:16">&lt;&lt; &lt;Na munu mo awa no na shipwane</para>
  <para style="q2" vid="MAT 21:16">Bo sa̱ e dande nebe e shero?&gt; &gt;&gt;.<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Wari pab pa eb e sher shepo e kore Betanya e bunge pate.<verse eid="MAT 21:17" /></para>
  <para style="s">Yesu e Tane Etu Yinu Yowo</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Na bungo o bunge, e be gi remeuro re kube ek. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Ta eb e hya etu mai kusa nayina, ekore pa,ama bangu koya̱ ba sai huma. Nyange na onʻwan one.bwashaka̱ awo ba dududu!&gt;&gt; Kapaba huma itu e hwe.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Ta aswabo a bune eb a ha̱ nami ashi iya-hani dinya pa ba ange, &lt;&lt;Zwam ya̱ onʻwan one o hwe kapaba-kapaba &gt;&gt;.<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />Yesu e chane yek nyange, tamahinda na on ka maizwamagaa, she jhe etano so, henda haka ba,ya̱shi ene hange iyi gem shagi itu te, har ma sha nyange na shame tuwaga, &lt;Mashinge henage bando rwaga,&gt; owashi. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />She tano so, kuchi ene gahi kaba bando menga, ya̱ hiu &gt;&gt;.<verse eid="MAT 21:22" /></para>
  <para style="s">A onshi Shaka o Mahore Ma Yesu</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Gagu Yesu esh Egenga, e be chibaga ba un, pa pristochi a tuwaga na ato tuwaga ato a kore wo eb ange, &lt;&lt; Na mai mahore ma gab on shi irite, henda ga bo pa mate mahore &gt;&gt;.<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Yesu echane yek nyenge, &lt;&lt;Gem ma na mai ka̱ba̱.Shena chane gyam namai zwama ko na mai mahore ma gem on shi na mab. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Pa yohana e hi mahore ma baptisma ma eb e on shi, Onhon pa ek onbu de bot &gt;&gt;.</para>
  <para style="p" vid="MAT 21:25">Paba kumbe gardama ab ba ne zwam,&lt;&lt;Shi tuzwame e sher wo Onhon ya̱ zwam nagatu zwam ya̱ gahi yado na gem ba?&gt;&gt; <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Ama shi tu zwam, &lt;Isher wo ato,&gt;Twa hogo ryansa ene e ato a tu shagiu, zwam ko ga bo daki yohana ish boink bando hatuma &gt;&gt; <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Pa ba chane Yesu ange, &lt;&lt;Tu daki ba &gt;&gt;.</para>
  <para style="p" vid="MAT 21:27">Pa eb nyange na ba, &lt;&lt;Gem ma na mai zwama ko na mana mahore gem on shiba &gt;&gt;.<verse eid="MAT 21:27" /></para>
  <para style="s1">Egagau Bot Bo Awo Baragya A tware.</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />&lt;&lt; To ya̱ gahi ha̱? Azhe bot mai bozhe awo bare a tware, ekore wo bo Jigu nyange, &lt; Bwa nabumi nare kure shi enke na sanga o inabi.&gt; <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />Pa boink bwange, &lt;Na koro ba,&gt;Ama na bob bushi tamago bo kore. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Na buchi bo kore wo bu rari, bo zwama ek ene bob bo zwama bo Jigu. pa bob bo chane bwage, &lt;To nakore, buchi nabuni,&gt; Ama bo koro ba. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />Ga bando ab baragya̱ bushiu ene buchi bob bo kudage,&gt;&gt;Pa ba ange, &lt;&lt;Bo Jigu.&gt;&gt; Pa Yesu nyange naba, &lt;&lt;Tamahinda na on kamai zwammagaa, ana a chago ga̱du na mongerekwa a on rwago kamai e saga tugwama to Onhon. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Hingyana, yahaya e kore e mai chibano yine bura̱ eyado na baba, ama ana a twago gandu na mogerekwa mo yad na eb, ko na ehyanu nani ma, emakimga gindigeu e sob ek ba.<verse eid="MAT 21:32" /></para>
  <para style="s1">Egagau e Ana a Zhangu o Haya o Sanga o Inabi</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />&lt;&lt;To, umai ugagau ba on. A shiu buchi bo yaba emai eshe sanga inabi, bu sandage oika, e gabe hombe oipiragu mani ma inabi na so, na eb tuma sufuri sanga na eb e kore tonge to mai. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Ta sanga o ya̱shi, na eb e toma agyam a eb bando ato tuma a zhangi ek ene yaba hi na sanga. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Ato enke henda a huma agyam eb, a shage inka rehona, a hone inka̱ riʻu, A tagage henda inka. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Har na bot buni bu tumaka na agyam ane a hyange a mai, paba shegi yek kumba na niya̱. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Na kundaga̱, ituma bwa bo eb wo ab, e be zwammagaa, &lt;E hya tuwaga to bwa na bumi.&gt; <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Ta ato tuma a hya̱ bwa, paba mazwama, &lt;Ene ebe shi bone bware gado, kuraji tuhone ek riʻo, gado o eb omaringe na uti.&gt; <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Paba huma ek, paba tage ek nesa o sanga, paba honeʻ ek rio. <verse eid="MAT 21:39" /><verse number="40" style="v" sid="MAT 21:40" />To ga̱gu buchi bo sanga bu kore, ya̱ bob bwa̱shagiu ato tomuniya̱?&gt;&gt; <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />Paba ange na eb, &lt;&lt;Ya̱ shagiu mugaye ato a te ehonago etozuma, e pa a mai ato tuma magenre ma ob, ama hina panga iyi sanga gagu e be yeno.&gt;&gt; <verse eid="MAT 21:41" /><verse number="42" style="v" sid="MAT 21:42" />Yesu nyange naba, &lt;&lt;Ashe, e tabo zazaba na hatak ba? ne zwama,</para>
  <para style="q1" vid="MAT 21:42">&lt;Te ato emago a wonje&gt;</para>
  <para style="q2" vid="MAT 21:42">Obo shi te ubizagi o emago.</para>
  <para style="q1" vid="MAT 21:42">Botʻbutuwaga ne bushi nani</para>
  <para style="q2" vid="MAT 21:42">Wo gatu henda esh iya he̱ni na yishi nati&gt;?<verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />&lt;&lt;Zwam nani. na on kamai zwama ga a cheu tugwama to Onhon wo gahi a pa ebenchi emai ana a pa iyi bura̱. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Ko ga muhenage zaat o teye uni, bwa ma pupusagu. Ama bone bo teye uni o henage wo bob, owa namago boik ta muhu.&gt;&gt; <verse eid="MAT 21:44" /><verse number="45" style="v" sid="MAT 21:45" />Na pristochi a tuwaga na parisiyawa a hoge egagau ini eb ishi, pa ab gane, ashe, na ab eb e on. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Ta ba gembage. e huma eb, paba hoge ryansa e ato zwam yeka yado ek ish boink bando hatuma.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s1">Egagau rago ushiya</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Pa Yesu e shagya̱ka̱ yek taaje na egagau nyange, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />&lt;&lt;E gagau tugwama to turwana na bugwam bo mai bone bo shage bwa bob rago ushiyana. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Botuma agyam bob a ugagya ato a eb e tuma yek rago, ama ato a ba zwama yek a kurwaba ya.<verse eid="MAT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4" />E tumaka agyam eb a mai nyange, &lt;Ezwama ane ab zwama nezwam,&gt; &lt;&lt;Hingyana gyamagbon na shiu kuryago, a shiro na e bura̱ ene ya̱ ba panga yek kuryago honjhe. A hwagu shi koya̱. e kuragya rago oni.&gt; <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Ama yeka hogo ba a karige iyaba, Bomai bo kore sanga bob, enk ekore bando o sanga eb, <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Ama henda a huma a gyama a supagi yek, har a honage yek riʻu <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Bugwam henda bu gas a boba a honage yek riʻu, pa ba tuki shepo waba ora kuchi <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Panani e be nyange na agyam eb, &lt;A hwogo kimga rago, Ama ane ab zwammagaa yek a ma gegi ba. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Zwam nani e swabe yina-yina ezwame na kuchi bone bo gahi bangi bu korya rago .&gt; <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Agyam ni henda a swabe yina-yina a be amagane ane ab bangi, a bura̱ na ane aza a bura̱, har rihuga̱ re ushiyana re shiji na ato dinya.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />&lt;&lt;Na bugwam bo esh zwam bo hya̱ ato dinya, pa bob bo hya̱ bot mai bo bwada apo a rago ba. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Pa bob bwange na bot boni, &lt;Buchagiya inga ba shi bo esh pani gab boda apo a rago ba?&gt;Ama bot boni bo nagik ene bob bwa chano.<verse eid="MAT 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13" />Na bugwam bwange na ane a shige boik enk, &lt;E parage bone eb na wa eb etage ek na so tunshi, pab bob bwashi tudaro na tore to hera̱ &gt;.<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />&lt;&lt;Zwam,Onhon ogage ato dinya ama chimu ab yinga̱.<verse eid="MAT 22:14" /></para>
  <para style="s1">E Ka̱ba̱ Zwam Etopago e Gandu Wo Kaisar.</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Pa parisiyawa a kore ama zwama ta ba supi ek na taaje. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Pa ba a tuma aswabo ab taba̱ na ato mai a Hiridus, ange, &lt;&lt;Umarumi, ai, tudaki gab shi bot bo mahinda ke chibagano o yena Onhon gab onshi, bo za tara o koga, zwam bo zhangi koga na koga honzhe. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Tu zwama ne gab ha̱. shin oyo honzhe nezwama to tope kaisar gandu, ko henda &gt;&gt;.<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Yesu henda zwam egano mugunta mwaba, pa eb nyange naba, &lt;&lt;Zwam ya̱ gahi on kana gwadaga? gahi oramahuta! <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Ena chibanya ikurubi gandu.&gt;&gt; &lt;&lt;Pa ba zhengi ek dinare. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Pa Yesu nyange naba, &lt;&lt;Uhoto one na reze rine ishi ga̱?&gt;&gt; <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />Pa ba ange, &lt;&lt;Ishi o kaisar.&gt;&gt;Pa eb nyange naba, &lt;&lt;To, e pa kaisar ene shi e kaisar , hende a pa Onhon eni shi Onhon. <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />Ta ab hoge ene Yesu echane, pa ba shi iyaheni paba ge ek, paba shi tuhano twaba.<verse eid="MAT 22:22" /></para>
  <para style="s1">Eka̱ba̱ Zwam Emashingyago Nya̱ ne a Owagi</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Na oho ni, sadukiya a mai a kore wo Yesu. Ab ne a oin zwammagaa ne zwama e mashingiu e ana owagi eza. Na ba ka̱ba̱ ek, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />Pa ba ange, &lt;&lt;Umarumi, musa owange, &lt;Shi bot boʻu bo za bwa, buhu bo bot bo shinya bwaa zwam bo machie boik bwa.&gt; <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />A shiu a mai a huwa a tandare wo gatu. bo Jigu boshiu ushina ta bob boʻu, bo mato ba, na eb e gage buhu bo eb bwaa. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Nani henda ushi wo bo rari na bo tato, har uwutago bo tandare. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Wari pab bwaa boʻu <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />To, oho o mashingiu e ana owagi, bwaa boi shi bo ga, ab tandara? zwam kuchi a shiya boik &gt;&gt;.<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Pa Yesu e chane yek nyange, &lt;&lt;Epu ne zwam gahi dakiwa̱ ataka̱, henda e dakewo mahore ma Onhon ba. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Zwam oho e mashingiu e ana owagi u shanagi o za, u shibkano ushiyana o za, zwam ashi ta tumana hagamba a Onhon na turwana. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Henda zwam e mashingiu e ana owagi, etabo zazaba ene e Onhon zwame ba? A zabago ne zwam, <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />&lt;Gem ne Onhon o Ibrahim, Onhon Ishaku, Onhon Yakubu.&gt; obo shi Onhon owato muhundo ba owato owagu-owagu ba &gt;&gt;.<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Na udubu owato o hoge nani, pa ba shi iyaha̱ni na e chibagano eb.<verse eid="MAT 22:33" /></para>
  <para style="s1">Inyaso Ene e Henge Tuwaga.</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Ta parisiyawa a hoge Yesu e unzagi a sadukiyawa, pa ab matarage. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Umai Umarumi, oi chibagano e musa wo ab o ka̱ba̱ Yesu zwam o maka̱ ek. <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />Owange, &lt;&lt;Umarumi, imai inyanso ene e hyange tuwaga wo inyansago &gt;&gt;.<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />Yesu e chane nyange, &lt;&lt;Okudage Onhon nobe kuchi na so nobe, kuchi na muhondo na mobe, kuchi na turinge na tobe.&gt;&gt; <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Oni obo shi inyaso e Jigu, henda one o hyange tuwaga. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />O rare ma oyo ta ujigu, o kuda bot marangu namabe ta gab kudage reto na rebe. <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Bando esapo ete irya̱, kuchi e chibagano e musa na mupas mu hatuma mu nsa̱ra̱&gt;&gt;.<verse eid="MAT 22:40" /></para>
  <para style="s1">Eka̱ba̱ zwam Bot-bwakimga</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Na parisiyawa ama tatrage rihuga̱ ringa̱ pa Yesu e ka̱ba̱ yek <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />Nyange, &lt;&lt;Inga ene yo naso nuhi wo Botʻbwakimga? bwa bo ga &gt;&gt;.</para>
  <para style="p" vid="MAT 22:42">Pa ba ange na eb, &lt;&lt;Bwa bo Dauda &gt;&gt;.<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Pa Yesu nyenga naba, &lt;&lt;To, inga Dauda na mahore ma uhuchi, owange na eb &lt;Bot-butuwaga&gt;? Har owange,<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />&lt;&lt; &lt;Botʻbutuwaga bwange na Botʻbutuwaga na bumi:</para>
  <para style="q2" vid="MAT 22:44">&lt;&lt;Shanu pate na wa numi o katoga</para>
  <para style="q1" vid="MAT 22:44">Na tano a chagiya a bita na be</para>
  <para style="q2" vid="MAT 22:44">Na sapo achagiya a bitaga a be na mapunda na mabe.&gt;&gt; &gt;<verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />&lt;&lt;Shi Dauda o ogago Bot-bwakimga&lt;Bot-butuwaga, to inga Bot-bwakimga bushi bwa bo eb &gt;&gt;.<verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />Ba bone bo chane ek ba. Gagu ohoni ba bone bo shaka̱ ma hore maso bo kaba ek ba.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s1">Yesu e Tonu ene Hamarumi a Ataura Na haparisiya A swai</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Ta ato amatarage dinya na aswabo a bune eb Yesu nyange naba, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />&lt;&lt;Hamarumi ataura na parisiyawa a yinsa maimako ma musa. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Zwam nani, gahi , gahi shi kuchi ene ya̱ ba maizwa ma, ama ban na enke ab. zwa ab raga zwammagaa ama ashi ba. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Yek a shagu a para hazunga tuchan, ene ezumiya jhangi, ab tunge ato na shitutu. Ab hato haba a banga yek ko ne ebobwa ba.<verse eid="MAT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5" />Kuchi enk ab regashi zwam yish ato. Yek raga paraga rahe a tuwaga na kare ka shapo shaba henda har haru. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />A kudage rihuga rishiya̱ rituwaga bando bigenje, na ahuga ai shiya a tuwaga na egenga <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />A kudage a zwane yek na kasuwa, a raga henda zwane naba &lt;Umarumi.&gt; <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Ama gahi henda, a ta zwamana gahi &lt;Hamarumi&gt;, zwama Umarumi nuhi ushi unka, gahi kuchi ish ato inka̱ <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Eta ogaga ko ga na tonge &lt;Buchi&gt; Na tonge, zwam buchi boik bob bushi na buhi, bone bo yo na turwana. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />A te ogagiwa koga&lt;Umarumi,&gt; zwam Umarumi oinka o gahi zha, Botʻbwakimga. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Ama bone bo henge tuwaga wo gahi bob bushi bo no wogahi. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Bone bwazhangu reto rebob, a rengyatom boik nesa̱. Bone bwamaringyatomo nesa, bob bwaba edanduwa boik.<verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />Tir nuhi, Hamarumi ataura na parisiyawa, uramahuta̱! E gunda eso tugwama to turwana. Gahi hato nahi e eso ba, gahi raga yasaga ato ne a kodage a esh a eso. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />Tir nuhi hamarumi ataura na parisiyawa uramahuta! E ragare hazunga aʻa ane ari sha ugu, e shagu menga ma geso zwam e pwatumi ato mai. Zwam nani ai shagiu hadoba a tuzuma.<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />Tir nuhi, hamarumi ataura na parisiyawa, uramahuta̱! Ekachaago rwaga, e watago tunge to tomere. Zwam a hi bot boik bone bwa maginjigeu.Ama shi hiu, gahi ringyatumeka ato yabe ora tu shamagahi karyagya.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />Tir nuhi, gahi ruba ato e kakadu ya̱to, gahi ato gahi raga zwammagaa, &lt;Kuchi bone bwamaton ne genga, oza koya̱, Ama kuchi bone bwamaton na zinariya o Egenga, dole bushi ene bob bo matone ha̱ bwashi.&gt; <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Gahi hawawa aruba̱ owana o zake tuwa, azinariya, ko Egenga ene e guzhi zinariya? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />E shagu henda ezwame, &lt; Kuchi bone bwa maton nebaro, o za komi, ama henda bone bwamaton na uhanchi one owabushi ne baro, dole buchi ene bob bo matone bwashi.&gt; <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Gahi haruba! Ya̱ nai ehyange tuwaga̱ uhanchi, on ba de ebaro e uhanchi, one owa guzu uhachi? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Zwam nani kuchi bone bwa matono ne baro uhachi, bu maton kuchi nene yo na reto rebob. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Kuchi bone bo maton ne genga, bo maton na eb, henda bu maton na bone bo shani na so eb. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Koga henda bo maton naturwana, bo maton na Egenga e Onhon, na bone bo shani pa eb.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />&lt;&lt;Tir nuhi hamarumi ataura na parisiyawa, uramahuta̱! E shiratumago zaka nuhi o naʻanaʻa, na anise, na lapsur, ama e paso iyimahinda e ataura, wato, mahinda, na yam, na eyado eni ne e sambari ishi, ba taba na e paso e mai ba. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Haruba̱ ana on tuka̱ka̱du, e raga yachigaga mahenhe mano, ama e on twaraga harakumi! <verse eid="MAT 23:24" /><verse number="25" style="v" sid="MAT 23:25" />&lt;&lt;Tir nuhi hamarumi ataura na parisiyawa, uramahuta̱! E on guzagaga yisa a boba, na geto, ama na so osambariba. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Gab buruba̱ bo parasiye! Rwaga kimaga e bob na ageto na so zwam yinsa yaba ma ekimaga.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />&lt;&lt;Tir nuhi, hamarumi ataura na Parisiyawa, uramahuta̱! Ta auya ne ab sukutage yek tunge to chen ana sambari na reʻeb, na so henda haʻupa ana owagi na udamuna ko owana. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Nani henda naishato gashi ato bura̱ ama na so uramahuta na enke a mugu.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />&lt;&lt;Tir nuhi, hamarumi ataura na parisiyawa, uramahuta̱ e raga tago moyaba na uya hatuma, e on kimaga uyato bura̱ <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Gahi zwammagaa,&lt;Da̱ tuka shanu na azamane a shikaka nashiti, tu ka banga a kwangi a mahya ma hatuma ba?&gt; <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Nanani gahi chibaga gahi shi awa ana a hunago hatuma. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />To shindagi enke hane a shikaka na shihi shirwage: <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />Gahi shahwa̱, inga gahi ya̱ kachigeu hadoba a yabe ora. <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Zwamnani na tumane na hatuma a Onhon, na ato turenge, na hamarumi ai chibagano e musa e hunago yek, e gendaga yinka, e supagi yinka shiduga na mugenga na muhi, gahi swabaga yek shep-shep gahi panga yek tuzuma. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Zwam ketope ke mahya ma ato bura̱ ane ab hunago na tunge a marige wo gahi, tun mahya̱ ma Habila bot bura̱ koro ma Zakariya buyu bo Berekiya, bone bo gahi hone kusa ne huga̱i bura̱ ne baro. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Tamahinda na on kamai zwammagaa, kuchi ene ya paro na ato zamani o niya &gt;&gt;.<verse eid="MAT 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />&lt;&lt;Gahi ato Urushalima, Gahi ato Urushalima! Ato e honnago e hatuma na ato e tagago e hane ab tumane wo gahi! Kana gyam kudage na mai tarage ta aruma a tatarage awo ab na hagab ab ama e wondo! <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Bana a mai gage yaba nihi nate! <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Na on kamai zwammagaa, ya̱ na ha̱na̱ka̱ ba sai oho gahi zwam, &lt;Iyi bura̱ e yo wo bone bo on kore na reze re Botʻbutuwaga &gt;&gt;.<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s1">Yesu Ishiu Taje Zwam e Huzagu Egenga</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Ta Yesu e sher so Egenga e be shi tuhano, pa aswabo a bune eb a chibaga ek kuchi mamagi-mage ma mogenga <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Pa eb e chane yek nyange, &lt;&lt;E hya kuchi mamagi-magi mateya? Tamahinda narega ke zwammagaa, aza te ko oimka owaba gewa zaat omaya a huzhagu ek kuchi &gt;&gt;.<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Ta Yesu e shani zaat o mushama mo zaitun, pa swabo a bune eb a kore wo eb aba ba ange, &lt;&lt;Tuzwama, ene ya̱ rwago kore? nya̱ ya chibano alama a gabwa giu henda ne hwagu e a zamane &gt;&gt;.<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Yesu e chane yek nyange, &lt;&lt;Ishihonzhe, zwam koga bota maiwa̱ta̱. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Ato dinya a koro na reze narimi, a zwam, Gemshi botʻbwakimga, har ek wa̱ra̱sumi ato dinya. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Ya̱ hogo alabare a bitaga na mahogehoge maba. Itahuga ryasa, zwam nani owaparo, ama a kunda̱ga̱ a kurwa ba. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Ibenchi ya̱shi bitaga na ibenchi e mai, Tugwama twash bitaga na tumai tugwama. Henda ashi remyaro na idumta̱ e tonge ko pa. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Ama uni ushi e rwago etuzuma.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />&lt;&lt;Gagu uni a mai tuta a mai pa tuzuma, henda a mai hunago. Tonge kuchi ato mai a mai wundo zwam reze na rimi. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Na gaguni ato dinya ashi odubuta,ama ryago-amana amawunje. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Tumana tak amashinji dinya a pwatum ato dinya. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Zwam udubu o mugu enk owaba, tukudago tu ato twashi tudaʻu. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Ama bone bo ma ippaga̱ koro nesa, bwa gegiu. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Henda a pa alabare a tusungo a tugwama to turwana zwam ato kuchi a daki, wari pab agundagari a kurya.<verse eid="MAT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />&lt;&lt;Shi hya iyi damuna ene nya shibke kipwatum, ene hatuma Daniyel bo zwame, e be yesani na rihug ribura̱. Ga bone bo oin zazaba bo gane. <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />To, ane ayo bando o yahodiya a some wo hate emakimga swe. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Bone bo yo zaat che na ubana, bota kazhagiwa wai bwa zhangu ene yo na so yaba. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Bone bo yo na sanga henda bo ta giya̱ wai bwa zhangu a po a bob ba. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Tir, aʻa mukabu, na ne a zhe awo nesa na gaguni <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Shaji menga zwam somoni ota korya wo gahi na gagu tudaʻu ko oho hengano o mugeta motandare <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Zwam na gaguni ashi tuzum to mai to tuwaga iritone twaba taboshi toik ba tuni na Jigu tonge har nare, a henda shaka iri tub ba. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Ba zwama ab enbe muget muni ba, a ka za bumbotuhinja bone bwa gegiu. Ama zwam ane ab yinga a embo moget.<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />&lt;&lt;Na gaguni, ko ga bwange na gahi, &lt;Yingyana, Botʻbwakimga a bun!&gt; Ko, &lt; A bura̱! &gt; Eta yada. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Zwam Botʻbwakimga bu tak na Tumana tak a shirage, a chibane alama a iyachibane e tuwaga na iyahyani zwam yeka wanrya̱tumi ato, har na ane ab ringa taba shi owashi. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />To, ne zwama tuni maʻinta.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />&lt;&lt;Zwam nani sha zwama nagahi, ba era̱ no zanga, eta shirewa. sha zwama nagahi, &lt;Ba ira̱ na so ubana emakimga swe&gt;, Ita yada. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Zwam ta tumai-mai to oin yitaga na zaat koro reto, nani giu bwa bot owashi.<verse eid="MAT 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 24:28" />&lt;&lt;Wo riʻu reyo, ai, pab hunku ayo.<verse eid="MAT 24:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />&lt;&lt;Kapaba kate ne kore moget mo te,</para>
  <para style="q1" vid="MAT 24:29">&lt;&lt; Onhwaho owashi tushi,</para>
  <para style="q2" vid="MAT 24:29">Pyana henda owashi tubanga ba.</para>
  <para style="q1" vid="MAT 24:29">Ringwane nya henagage na turwana,</para>
  <para style="q2" vid="MAT 24:29">A dumta̱ henda mahore ma turwana &gt;.<verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />&lt;&lt; Na gagu ni ne alama a bwa Bot a chibano na zaat o turwana. kuchi kabila a tonge ashi tudaro zwam ryansa. a hya̱ bwa Bot bobe kore na so urana na mahore na e dan edanduwa dinya. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Nya̱ tuma na tumana hagamba eb a hura̱ oreba one ozhe erema dinya, henda a tarage ane ab yinga na zaat na retowa na wa-katuga na wa-kagura, wato, inyaka e tunge toni koro turiya̱ &gt;&gt;.<verse eid="MAT 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />&lt;&lt;Idaki emai bando eʻo etu. shi shebob shi hinu kama sakaga, shibe putagi huma haba, shiu oya̱ wutagi ba on. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Nani henda shi ha̱ ene gem raga ke zwammagaa, gahi daki ne zwama gagu wutagu, oyo kane eso. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Tamahinda na raga kamai zwammagaa,zamani one sai a shiu irini kuchi. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Turwana na tonge twa hwagu, ama taaje nuni owa hogu ko chino ba &gt;&gt;.<verse eid="MAT 24:35" /></para>
  <para style="s1">Aza Bone Bo Daki Oho Marigeu Bot-bwakimga</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />&lt;&lt;Ama aza bone bo daki oho ko gagu oniya̱, ko tumana hagamba ane ayo na turwana, ko bwa, sai buchi bob buba. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Ta ba shi na muget mo nuhu, nanani giu o bwa bot owashi na maringya a bwa bot. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Ta gagu uni na upopo umani utuwaga, a be re, a be su, ato tware a be shi ushiyana, a be panga ushiyana, har koro oho Nuhu o esh o ugu mani. <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />Kape yek a gane ene yo naso, opopo oni o mani utuwaga okorya usaga ato kuchi. Nani henda giu bwa bot owayaa. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Gagu uni, ato barya̠gya̠ a nya na sanga, a zhangi buinka̱, a ge buink. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Aʻa barya̠gya̠ a nya shi tunama tare a zhangi buink, a ge boik <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />&lt;&lt; Zwamnaniya ko ga bu nya na tudaku, zwam e daki oho Botʻbutuwaga na buhi bwa maringeu ba. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Ama gahi de idaki, a ka sha buchi bo yaba bwa daku gagu owana buhi bwa kore na get, buka rabto ba, henda bwa geu a eshe boik yaba ba. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Zwam nani henda sai e shani na tudaku, zwam na gagu o gahi dakiwa̱ ba obane bwa bot bwa kore &gt;&gt;.<verse eid="MAT 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />&lt;&lt;Ga bone bushi bugyam bwaba yaje na bob, bo turenge, bone buchi bo yabe bob bo sape boik bo yingyane yabe eb, henda bo on panga hagyama mai kuryago kwaba hozhe? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />&lt;Iyi bura̱ eyo wo bugyem bone bo buchi bo yabe bob bwakore bo bangya boik bobeshi enke a bob? <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Tamahinda na rega ke zwammagaa, ya̱ sa bugyam boni bo iyingyane kuchi hazunga a eb. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Ama sha bangi, bugyam bone bushi mugu, ya̱ mazwama, &lt;Buchi bo yaba nami bwa gi maintaba,&gt; <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />Na nani e be ya supaga a chagiya enke eb, e be re, e be so taba na ne a wa̱ra. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Shibu shiu nani, buchi bo yabe bob bwa kore oho e be shiu samani ba, ko henda gagu eb e dakiwa̱ ba, <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Buchi boyab bwa shagiu ek risupu etuwaga, henda bo shere ek hadoba nato uramahuta̱. Pab a shagu tudaro na tura tuhera̱ &gt;&gt;.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s1">Egagau Mukangaza Rikwape</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />&lt;&lt; Na pab ab gagau tugwama to turwana na mukangaza rikwape mune mu zhangi bichera a kore a tariya̱ bot bo wushinyana upo. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Ta wo ab aza toringe ta henda̱ azhe toringe. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Gagu hane aza turenge azhangi chere yaba azhangu manebe zwam ekesana ba. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Ane turenge a zhangu hakwalba maneb taba̱ na so chere. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Ene shi ushiyano upo e kurwa maʻinta, sarai owaba a kumbe murab har murab mo jhangi yek.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />&lt;&lt;Wari na ushe ageta paba hoge ogo, a be zwammagaa, &lt;Ini ishi ushiyana ino! Shirinji e gichi ek &gt;.<verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />Pa mokangaza muni rekwape moshirage ko ga bo kemaga bere re bob. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Pane aza turenge azwame na ato turenge,&lt;Etokashiya maneb na mahi chim-chimu naye.chere niti e nya owagi &gt;.<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />Ama ane azhe turenge ange naba, &lt;manebe matodama gatu na gahi ba. Ekore wo ato esango e senyana mahi &gt;.<verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />Ta ba kore zwam a senya̱ manebe kape a giya ene shi ushinyana e wuto. Ane a makimaga a esh wo rago na eb, pa a ba gunda eso.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />&lt;&lt; Ab pab mokangaza mone moeyata mo kore, mwange.&lt;Butuwaga,Butuwaga a,tugonjigage &gt;.<verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />Na bone bushi ushiyana bwange naba, tamahinda na oikamai zwammagaa, na mai dakiwa̱ &gt;.<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />Zwam nani Yesu nyange sai shani na tudaka̱, zwam e dakiwa̱ oho ko na morwam mwana bwa bot bwa kore ba &gt;&gt;.<verse eid="MAT 25:13" /></para>
  <para style="s1">Egagau Zwam Ihumga̱ A mana.</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />&lt;&lt;Henda tugwama to Onhon twaya̱ ta bot bone bwashi tuhano, bob bo ogagya agyam a bob, na bob bo tuta yek iyi bob. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Bo pa boik zinariya o ta,boik henda zinariya a rya, emai henda zinariya unka̱, ko ga ta mahoren mabob.Pa eb e karige. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Bone bo che zinariya dubu uta uni ka paba na eb eshe gembo na kurubi ni, na eb hi umai dubu ota. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Nani ma ene e che zinariya dubu baragya, bo hi umai dubu barya̠gya̠. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Ama bone bo che zinariya dubu u ka bo kore bo gabe hambi bo wumba kuru bi buchi bo ryabe bob.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />&lt;&lt;Taba warage, pa buchi bo yaba bwa gyamani bo gi zwam bo rotage ene ya̱bashi na kurubi ni. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Pa bone bo che zinariya ota bu re tusha bo shibkana a mai zinariya o ta bwange, buchi bo yaba, bona pa zinariya ota.Gyamwabona na shiu gembo ota &gt;.<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />Na buchi bo yaba bob bwange na eb, &lt;Ushiu honjhe, bugyam bura̱, bwa yaje! Bushiu ayaje ne iyi no, nabo pa emai ane a hyange ene. korya shi so chen taba na buchi bo yaba nebe &gt;.<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />&lt;&lt;Pa bone bo che zinariya dubu uragya henda bo kore tusha, bwange,&lt;Buchi bo yaba, bona pa zinariya dubu uragya. Gem ama wabona na shiu gem o zinariya dubu uragya &gt;&gt;.<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />Na buchi bo yabe bob bwange na bob,&lt; Ushiu honjhe, bugyam bura̱ bwa yaje; Bushiu iya yaje ne iyi no. Na bo pa enk ana henge ane kurya shi so chen taba na gyamu!&gt;.<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />&lt;&lt;Pa bone bo che zinariya unka̱ bo kore bishina̱ be eb bwange,&lt;Buchi bo yaba̱ na daku gab zhe gago shaʻane, bo shagu biguba̱ wo gab beragewa ga henda bu kudage iyi suba̱. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Obo osa na hoge ryansa na kore na gabe hombe na wumba̱ kurubi nebe. cha iyi nebe &gt;.<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />Na buchi bo yaba eb bo chane ek bwange,Gab mugu o bugyam bo renda! Ashe budaki na on biguba̱ wo gem biragiwa ba, na on henda zuranga wo gem bazhiwa bero ba? <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Ai, oyo honzhe otane kurubi nimi wo tuira̱, shi nagiwa̱ gyam che kurubi nimi na har ne kisano.<verse eid="MAT 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28" />&lt;&lt; &lt;Sai e che zinariya dubu uka ote wo eb e pa bot bwa jika kwape ta buni <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Zwam bone bo zhe iyi, a kisano boik har bu hi dinya.bone bo za iya, chimu ne bob bozhe, a cheu wo bob. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Etage henda bugyam buto bowo na so tunshi.Pa pabashi tudaro na ma haka maira &gt;.<verse eid="MAT 25:30" /></para>
  <para style="s">Hadoba a Kunda gani</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />Gagu o bwa bot bwa kore na so adandiya bob taba na a tumana hagamba kuchi, na paba eb ya̱ shanu ne runru tuwaga e tugwam to eb. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />A tarage kuchi ato tunge na bishina̱ be eb, ya habsagu yab zagu-zagu, ta bot bo rihuba bo raga habsagu temi na haro <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Ya̱ tano tami na wa katuga e be tano haro na wa kagura. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Napab bugwam bwa zwam na ane a yo na wa katuga, &lt;kuryanji, gahi ane buch na bumi bo shegi yek iyi bura̱! E che tugwama tone to Onhon o mai shagi tun na Jigu o tonge. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Zwam gagu o gyem hoge rimyano ene pa kurago.Na gem hoge touware, ena pa mani na so gem. Bot bo kanya ina cheu. <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Na za anpo, ena pa anpo na rumagi, na gahi nayingyane. Gyamushi tudaro, e korwa na zwano? <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />&lt;&lt; Gaguni ne ato bura̱ a chano ek a zwame,&lt;Botʻbutuwaga,hwane gatu bu ha̱ na gato pa mani buso,ko hoge remyaro to pa kuryago? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Henda hwane gatu ha̱ gab bot bo kanya na gato bo dinya? ko henda bo za a po na gato bo pa anpo? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Henda hwane gato bo ha̱ burumagi na gato kore wo gab ko henda gab na zharo na gato kore wo ga ba &gt;&gt;.<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />Bugwam bu chane yek bwange, &lt;Tamahinda na o kamai zwammagaa,ta gahi shagiu bot binka̱ wo ato nami bone buhunba̱, ai, enashageu gem &gt;.<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />Na pab nya zwama ane ayo na kakura ka eb,&lt; E na ge, gahi ana ab tani yinu yewo, e esh ora̱ one o usa̱gagiwa dududu, one owaba shagi bugwam muphar na tumana hagamba bob. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Gagu gyam hoge remyaro, ina pa kuryago ba.Na hoge tu'oware tumana, ina pa mani na suba. <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Gem bot bokanya,ina cheu ba.Na za a po, ina pa a po ba. Na rumagu, henda nayo na zharo, ekurwa̱ wo gem ba &gt;.<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />&lt;&lt;Ab ma a chano a zwamo,&lt;Botʻbutuwaga,hwane gato buha̱ gato hoge remyaro, ko tu'oware tumani, ko gab bot bo kanya̱, ko gab na jharo tubuyingyano ba?&gt; <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />Na bugwam bwachano yek bwangya, &lt; Tamahinda na raga ke zwammagaa, ta gahi shagiwa bot boink wo ane a humba ba, ai, ena shagiu gemba ba un.&gt; <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />Ane a eso tuzuma tone twa hwagu ba, ato bura̱ henda a esh muhundo mu dududu &gt;&gt;.<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s1">Ato Tuwaga Ashi Ashiya̱ ne Zwama a Hone Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Na Yesu e hwagi zwammagaa irini kuchi, na eb ezwame na aswabo a bune eb, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />&lt;&lt; E daki ne zwama begenje be e kachiu be ryata muget mu ryagya, a pa bwa bot a ginje boik &gt;&gt;.<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Pa pristochi a tuwaga na ato tuwaga ato a matarage na yabe prist e tuwaga, ene yaba ogage kayapa. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />A shani natuswe a huma ek a hone ek riʻu. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Paba zwame, &lt;&lt;Ba na gagu bigenje ba, zwam ato ashingatome bitaga &gt;&gt;.<verse eid="MAT 26:5" /></para>
  <para style="s1">A Sukutage Yesu Maneb Ma Washe Otusungo Na Betani</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Gagu o Yesu na Betanya na yebe siman, ene ekazhe magom maturaha, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />Pa bwaa mai bo kore wo Yesu bob ne Imagaso emai e maneb ma washe otusungo maikurbi dinya, na bob bo zuta̱ ek na reto, gagu e be rekurago.<verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />Ta aswabo a bune eb a ha̱ nani, paba hachigage so ange, &lt;&lt; Zwamya ab on hachigaga iyi?&gt;&gt; <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Sheka sango manebe mate na kurubi dinya, a pa ana a za mahonre!&gt;&gt; <verse eid="MAT 26:9" /><verse number="10" style="v" sid="MAT 26:10" />Ta Yesu e ha̱ nani, na eb nyange naba, &lt;&lt; Zwam ya̱ gahi ragashi na bwaa bote? ai, iyi bura̱ obnashagi, e tamahinda ne. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Kohwane gahi yo nane aza, ba kohone gahi yo na gyam ba. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Ezuta̱ e manebe mani ma bob bushi na kingi na kani, bushi zwam shiwunba̱ shi bob. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Tamahinda, naragake zwammagaa,kuchi babashi taaje oni na tonge kuchi, ene bwaa boni bushi a raga zwammagaa yek zwam kama butara na bob &gt;&gt;.<verse eid="MAT 26:13" /></para>
  <para style="s1">Yahuda e Yado e Pa Yesu</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Bot boink bando ato rigwape na ba̱ra̱gya̠, ene ya̱ba ogage Yahuda Iskariyoti, e kore wo pristochi a tuwaga, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />Nyange, &lt;&lt; Ya̱ e gahya napa, natuta eb wo gahi?&gt;&gt; Paba rutage ikurubi e azurupa akwape tato, paba pa ek. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Tunna gagu o niya e on ginbaga yena eb ya̱ tuta ek.<verse eid="MAT 26:16" /></para>
  <para style="s1">Kuryago Ko Agundagari</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Oho Jigu o kuryago kune koza iya shinbatome pa aswabo a bune eb a kore wo Yesu ange, &lt;&lt; Pa gab kudage tubu shagi ere bigenje be kacho?&gt;&gt; <verse eid="MAT 26:17" /><verse number="18" style="v" sid="MAT 26:18" />Pa eb nyange, &lt;&lt; E esh shepo wo botomai, e zwama boik, &lt; Umarumi o zwame moget mo bob muyawuta̱gi, nya̱re begeje be kachiu na yaba nebe na aswabo o a bune eb&gt;. <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />A swabo a bune eb ashi ta eb e zwam na ba, pa ba shi begenje be kachiu.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Ta rembe ushi, pa eb e shani ere kuryago na aswabo a bune eb rekwape na baragya. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />A be rekuryago, pa eb nyange, &lt;&lt; Tamahinda, naga ke zwammagaa, boink wo gahi bwana tuta.&gt;&gt; <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />Pa ba hachigage so dinya, a be zwammagaa ek boink-boink, &lt;&lt; Gemu ne, Botʻbutuwaga?&gt;&gt; <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />Pa eb e chane nyange, &lt;&lt; Bone bo gatu oinre egeto inka̱, eb ya̱ natuta. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Bwa bot bwakarigeu, ta alabare a eb a yo zabage, konanani kaicho o bone bwa tuta bwa bot! Sama aka mato boyekba, oka hengeu boik.&gt;&gt; <verse eid="MAT 26:24" /><verse number="25" style="v" sid="MAT 26:25" />Pa Yahuza ene e tuta ek nyange, &lt;&lt; Umarumi, onbo gem?&gt;&gt; Yesu nyange na eb, &lt;&lt; Gabwa bona bo zwam &gt;&gt;.<verse eid="MAT 26:25" /></para>
  <para style="s1">Ere jibi Botʻbutuwaga</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />A be rekuryago ba'un, Pa Yesu e zhangi iyi tore, na eb e giji Onhon, eb e bobosage, e pa aswabo a bune eb, nyange, &lt;&lt; Cha, ryangi kingi na kami kato.&gt;&gt; <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />Na e be e zhangi ebobo na eb e goji onhon, na eb e pa yek, nyange, &lt;&lt; Kuchi nuhi e swage. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Mahya na mami mato mai shidu kotono, mane maba gwangu zwam ato dinya, zwam a yapiya turiya twaba. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Na raga ke zwammagaa, na swaka mani ma sabe na gahi ba, sai oho gatwa swa mapu na gahi na tugwama to buch na bumi &gt;&gt;.<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Ta ba shi azuga makuda ma Onhon, ab shere a kore te o zaitum.<verse eid="MAT 26:30" /></para>
  <para style="s1">Bitrus ya̱ zwame e dakiwa̱ Yesu.</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Pa Yesu nyange na ba, &lt;&lt; Kuchi ashi uelobota zwam gem na ageta a me zwam oyo zabagi ne zwam, &lt; Na supu bot bo rihuba̱, temi e bangu ni ya̱ ma gatagago.&gt; <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" />Ta ab mashigatume ek, na rwago koro tunge to galili.&gt;&gt; <verse eid="MAT 26:32" /><verse number="33" style="v" sid="MAT 26:33" />Bitrus byange eb, &lt;&lt; Ko kuchi owaba amatage hadubota zwam gab, gem kam na mata odubota ba dududu.&gt;&gt; <verse eid="MAT 26:33" /><verse number="34" style="v" sid="MAT 26:34" />Yesu nyange na beb, &lt;&lt; Tamahinda, naraga ke zwammagaa, ko na ageta ani ma, kape oka̱re o sane yinu, bwashi mo wundo mo kana dakak katato.&gt;&gt; <verse eid="MAT 26:34" /><verse number="35" style="v" sid="MAT 26:35" />Bitrus byange na nabeb, &lt;&lt; Ko a tu hon gem na gab, na shi mowundu mo kabudaka̱ ba.&gt;&gt; Nani kuchi aswabo a bune azwame.<verse eid="MAT 26:35" /></para>
  <para style="s1">Yesu ishi menga na Gasimani.</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Gaguni Yesu e koro naba rihuga̱ remai yaba ugaga Gasimani. nyange na aswabo a bone eb, &lt;&lt;Shani pate, gyam henda na koro wariya̱ nashi menga.&gt;&gt; <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Pa Yesu e zhangi Bitrus na awo a zabadi barya̠gya̠ e rwage so shiri na tudama dinya. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Pa eb nyange naba muhondo na mumi mu owe hoge tuzuma dinya ta na u. E yinsa pate e shani rengeche taba̱ na gyemu.&gt;&gt; <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />Ta eb emakisata tusha chimu,pa eb e henage na tonge ishi menga nyange,&lt;&lt;Gab buch na bumi shi owashi nazhangi ebobo ene e tuzuma kuchi nanani de ba nupi numi owaba swabo ba kana obe.&gt;&gt; <verse eid="MAT 26:39" /><verse number="40" style="v" sid="MAT 26:40" />Pa eb e maringe wo aswabo a bone eb e hya a be shi murabo, pa eb nyange na Bitrus,&lt;&lt;Ashe e pwa shana rigeche taba̱ nagyam ba ko o biroma binka̱ ba? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />E shani ringeche ishi menga, zwam e henago bando emaka̱na̱. Tamahinda uhunchi o zhangu ama kingi kaza mahonre.&gt;&gt; <verse eid="MAT 26:41" /><verse number="42" style="v" sid="MAT 26:42" />Har na nare emaringyaka ka ryari pa eb ekore ish menga, nyange,gab buchi na bumi nani owashiba sai kanasowa to sha ene gab shi nupi.&gt;&gt; <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Ko yanzu de emaringe e banki a be shi murab, zwam murab mo shingi yek yish. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Pa Yesu e ge yek e kuryaka ish menga katato, e be zwamgaka taaje o da. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Pa Yesu e maringyaka wo aswabo a bune eb nyange naba har nare murab gahi o, e on hinga? To,yingyana gagu o wutagu a pa bwa bot wo ato turiya. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Emashinge tukore.e hya,bone bwanatuta a bot,boya̱ kusa &gt;&gt;.<verse eid="MAT 26:46" /></para>
  <para style="s1">A tuta Yesu, A huma ek.</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Kame e gunda yinu na Yahuda, boink na so rikwape na haryagya, na udubu owato koga na epopo na shigungu, pristochi a tuwaga na ato tuwaga ato ab swabke yek. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />To, bone bwa tuta ek a rego a ma game yinu na ba ne zwama, &lt;&lt; Bone bo gemwa shiu alama a susunba̱, boba bot e huma boik&gt;&gt;. <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Kapaba na yahoda emakimga kisata wo Yesu, nyange, &lt;&lt; Barkanji, gab umarrumi!&gt;&gt; Pa eb ehena susubaga ek. <verse eid="MAT 26:49" /><verse number="50" style="v" sid="MAT 26:50" />Yesu nyange na eb, &lt;&lt; Bo chage na bumiya, ene bo shib ke binu?&gt;&gt; Paba makisata a huma Yesu, a kumbe ek. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Pa bot boink bando ato ane ayo na Yesu e tuta wa e puchigi epopo eb, e shib kane bugyam bo pristochi a tuwaga e ga̱bi, e yachige ek tope. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Pa Yesu nyange na eb, &lt;&lt;Maringyatome epopo nebe nu put. kuchi bone bo puchigi epopo, epopo e be ya̱ hone boik. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />E on nezwama napwagembaga tamako wo buchi na bumiba, kapaba e tumana hagamba udubu o ato hagamba ana henge rikwape na baragya? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />To, inga ab shindaga hataka̱ ne zwam tamahinda irine shindu?&gt;&gt; <verse eid="MAT 26:54" /><verse number="55" style="v" sid="MAT 26:55" />Ka paba Yesu e zwame na udubu owato, &lt;&lt; E sherage na mopopo na shigungu ena huma gem ta buhi? Ko hwane na shanu ne genga geme chibaga, ama ina huma ba. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Ama one ushi ne zwama a shinji shitaka̱ she hatuma &gt;&gt; Kapapa aswabo a bune eb a ge ek, ko ga bo on reto rebob.<verse eid="MAT 26:56" /></para>
  <para style="s1">Yesu Na Bishina̱ Be Hapadawa</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Pa ane a huma Yesu a kore na eb wo kayapa, ene shi bando pristochi a tuwaga, wo hamarumi a Ataura na ato tuwaga ayo tare. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Ama Bitrus be swabe ek har koro so yaba ink bando pristochi a tuwaga.Ta beb be esh, na eb e shani bake na hadogari a egenga bugwam, zwam e hya e hwagu e ko nya. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />To, pa pristochi a tuwaga na amajalesa kuchi owaba a gembage sheda o taka one owaba shagiu Yesu zwam a hi taba hone ek riʻu. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Ama ek a heu ba, ko ne zwam ato sheda otakaa udubu a kurago. Wari paba ato baragya a makisata, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />Azwame, &lt;&lt; Ita ezwame, ne zwame e pwa rusaga̱ e genga ete Onhon, henda emage ek na muget motato.&gt;&gt; <verse eid="MAT 26:61" /><verse number="62" style="v" sid="MAT 26:62" />Pa boink bando pristochi a tuwaga bo mashinge bwange, &lt;&lt; Bu za ene gabwa chano? sheda one owato te a on panga na reto narebe no?&gt;&gt; <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Ama Yesu e zhikitage. Pa bot buni bando pristochi a tuwaga bwange na eb, &lt;&lt;Na bo hutara na Onhon o muhundo, to zwama gab shi botʻbwakimga, bwa Onhon.&gt;&gt; <verse eid="MAT 26:63" /><verse number="64" style="v" sid="MAT 26:64" />Pa Yesu nyange na eb, &lt;&lt;Ta gab zwame, na raga ke zwammagaa pani na tusha nya ha̱ bwa bot shani wakatoga ka bot mahore, bo be kore na so harana.&gt;&gt; <verse eid="MAT 26:64" /><verse number="65" style="v" sid="MAT 26:65" />Pa buni bando pristochi a tuwaga bu handagage shapo she bob, bwange, &lt;&lt; Ishiu makwada! Sheda omai gatwa ginbago? E hogo tukwada to eb ishi! <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Ya̱ gahi hya̱?&gt;&gt; Pa ba chane ek ange, &lt;&lt; O yo honjhe a hone ek riʻu!&gt;&gt; <verse eid="MAT 26:66" /><verse number="67" style="v" sid="MAT 26:67" />Pa ba zuta̱ ka̱ ek hatanbi na shinu, a supagi ek, a mai henda a marage ek, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />Ab zwammagaa, &lt;&lt; Tu shagi iya̱heni, gab Botʻbwakimga! Ga bone bo busupi &gt;&gt;.<verse eid="MAT 26:68" /></para>
  <para style="s1">Bitrus E shiu Tuwonda To Edaku E Yesu</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />To, Bitrus henda e shani na so yaba na riʻeb, na bomai bo gem bo kore bo yinsa wo ek. bwange, &lt;&lt; Gab ma, ai, boyo tare na Yesu e shepo o Bagalile!&gt;&gt; <verse eid="MAT 26:69" /><verse number="70" style="v" sid="MAT 26:70" />Ama e wunje na bishina̱ byaba kuchi nyenge, &lt;&lt; Gem dakiwa̱ ene gab on zwammagaa.&gt;&gt; <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />Ta Bitrus e sher chibano, pa bu mai bugyam bu hya ek, bo zwama ane ab shanga̱ na ba, &lt;&lt; Ai, bot bone yeka ayo na Yesu Banazare!&gt;&gt; <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />Na eb e makisata har na kuton nyange, &lt;&lt; Na dakiwa̱ ma bot bote ba.&gt;&gt; <verse eid="MAT 26:72" /><verse number="73" style="v" sid="MAT 26:73" />Ab paba ana yensanga ama kisata,azwame na Bitrus, &lt;&lt; Tamahinda gab yo wo ab, zwam taaje no be obochibano.&gt;&gt; <verse eid="MAT 26:73" /><verse number="74" style="v" sid="MAT 26:74" />Pa eb emashinge yinu yo, e be kama tunaga, e be zwammagaa, &lt;&lt; Na dakiwa̱ ma bot bote ba. Ka paba na oka̱re o uga. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Pa Bitrus be ma botare na taaje o Yesu ne zwama, &lt;&lt;Kape oka̱re o oga bwashi to wundo na tumi katato.&gt;&gt; Pa Bitrus be sher na reʻeb be shi tudaro to tuzuma.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s1">Yesu na Bishina̱ be Bilatus.</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Ta bungo bunge kuchi pristochi a tuwaga na ato tuwaga ato a shi oink zwam Yesu a hone ek riʻu. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Pa ba para ek, pa ba kore na eb paba pa ek pa wo gwamna bilatus.<verse eid="MAT 27:2" /></para>
  <para style="s1">Uʻu yahuda</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Gagu o Yahuda ene e tuta Yesu e hya̱ a shereu Yesu hadoba a hone ek, pa eb emakimga dame, e ringyatome pristochi a tuwaga na ato tuwaga ne kurubi azurupa akwape tato ane, <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />Nyange, &lt;&lt; Na shiu tukwada na gem pa mahya ma bone bo za tukwada a hone boik riʻu. &gt;&gt; Ab zwame, &lt;&lt; Ga ruwa nuti? gab hoge!&gt;&gt; <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" />Na eb e kwangi kurubi azurupa ane na Egenga e Onhon, e sher, e kore e masara reto reʻeb. <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />Ama a Pristochi a tuwaga a yingaga̱ kurubi ni ange, &lt;&lt; O za honjhe to ere kurubi te bando e higa̱ e tu'ira taigenga̱ ba, zwam e kurubi ni ishi kitop ke mahya.&gt;&gt; <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Pa ba shani, a sa rihuga ane a shagu mukimbu na kurubi zwam rihoga̱ re wumbuga̱ ato kanya. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Zwam nani, har koro nare, a ogago rihuga rini rihuga re mahya har nare. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Nanani ab shinji e zwam e boink bando hatuma Irimiya ne zwama, &lt;&lt; A zhangi kurabi azurupa akwape tato a te, kurubi ene ato isiraʻila a yaje a tope na reto reʻeb binu.<verse eid="MAT 27:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 27:10" />Pa ba sa rihuga nya̱ ne shagu mukimbu, ta Botʻbutuwaga bo zwame na gemu &gt;&gt;.<verse eid="MAT 27:10" /></para>
  <para style="s1">Bilatus be ka̱ba̱ga̱ Yesu</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Yesu eba yinsane na bishina̱ be bugwam ba un, pa bugwana o ka̱ba̱ ek owange,&lt;&lt; Gab shi bugwam bo yahudawa?&gt;&gt;Yesu nyange na boba.</para>
  <para style="p" vid="MAT 27:11">&lt;&lt; I,gyane ta zwam nani.&gt;&gt; <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />Ama na pristochi a tuwaga na to tuwaga a tuhimi ek, e zwama ko ya̱ ba.<verse eid="MAT 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13" />Pa Bilatus be zwame na eb,&lt;&lt;Bu hogo irite ya̱ ba bu tuhumi zwam eb ba?<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />Ama Yesu e chano ek ko eka̱ba̱ inka ba, har o gwamna shiu iya-hani dinya.<verse eid="MAT 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />To, na gagu bigenje be kacheu, gwamna o shagagu e pashi yato bot boink bo makwada bone bwaba kudage. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Na gagu oni azhe e mai ene yo na zharo reze re'eb Barabbas. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Na yahudawa a matarage na Bilatus byange naba,&lt;&lt;Ga bo gahi kudage a mai pashiya? Barabbas unbu de Yesu ya̱ ba ange na eb Botʻbwakimga? <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Zwam Bilatus bi daki zwam ehogo eso obo sa ab tuta Yesu. <verse eid="MAT 27:18" /><verse number="19" style="v" sid="MAT 27:19" />Na Bilatus e shani bando hadoba, na bwaa bo eb butuma azwame na eb, &lt;&lt;Yaciga reto narebe bando ete e za tukwada̱, zwam na re na hogo tuzuma dinya zwa arabuwa a eb.&gt;&gt; <verse eid="MAT 27:19" /><verse number="20" style="v" sid="MAT 27:20" />To, pa pristochi a tuwaga a huraga ato tope a zwame nezwama a pashe Barabbas, a hone Yesu reʻu. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Gwamna henda o zwamaka yek, &lt;&lt; Ga boink bando ato a te baragya bone bo gahi kodage ai pashe?</para>
  <para style="p" vid="MAT 27:21">Pa ba ange,&lt;&lt;Barabbas &gt;&gt;.<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />Pa Bilatus byange na ba, &lt;&lt;To ,ya gemwashi na Yesu ene ya̱ ba ogago ek Botʻbwakimga? &gt;&gt; kuchi paba ange,&lt;&lt;A ginda ek &gt;&gt;.<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Bilatus byange,&lt;&lt; Zwam ya̱? ya eb ushi ene sambariwo?&gt;&gt;Ama ato ni a dande bigwaba a be zwame, &lt;&lt;A ginde ek &gt;&gt;.<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Ta Bilatus e hya eza ene eba pwash, henda ato a kudage a shingatome so, pa eb e toke mani e guzhi wa eb na bishina̱ byato, ezwame,&lt;&lt; Gem de, ba mani na mamiya na alhake a mahya ma ene eza tukwada. One ushi mani na mahi &gt;&gt;.<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Na ato ani kuchi a chane ange, &lt;&lt; Alhake a mahya ma eb ma shani na reto na riti, gatu na awo nati &gt;&gt;.<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Na nani pa eb e pashe yek Barabbas kate e sa a supagi Yesu aduga̱, na eb e pa a ginda ek.<verse eid="MAT 27:26" /></para>
  <para style="s1">Ato Gasa A shagi Yesu Zwamo Rato.</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Wari paba ato gas a shebke Yesu chibano o gwamuna, pa ba ogage kuchi ato gas na reto re eb, <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Na ba bwajigyagge ek azunga, paba sa̱nra ek apo a shen a ryenga na mugwamgwam. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Pa ba shi eporu emai e tugwama na makada, paba zache ek na reto, paba sape e humga̱ agugu na wa eb o katoga, paba kukagi na bishina̱ be eb a be shagi ek zwamo rato a be zwammagaa, &lt;&lt; Muhondo na mobe mo waragi, Bugwam bo yahudawa!&gt;&gt; <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Paba tupanga ek a tanbi, paba che ek agugu ani paba supagi ek na reto <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Ta ba hwagi shagi ek zwam orato, paba yachige ek apo a shen ani, a bodaga shapo she eb, ab harge na eb zwam a ginde ek.<verse eid="MAT 27:31" /></para>
  <para style="s">A Gendage Yesu</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />A be shi tuhano ba on, pa ba maharage bo mai Bakorane, reze rebob Saminu.Eb yaba sape ezhangi a ginda Yesu.<verse eid="MAT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 27:33" />Taba eshe pamai paba ogago Golgota, wato, mubobo e reto, <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Pa ba tuta mani masambe a huta ne maye e tubada pa eb eso, ama ta eb e harupa pa eb e wonje esu <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Ta be ginje ek, naba ma undagage a po a eb pa baba a tane koreʻa. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Pa ba shani pabba absaga ek. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Bando reto re eb paba tane ene ya̱ chibane ene eb ishi ne zwam.<verse eid="MAT 27:37" /></para>
  <para style="s">ETE EBE SHI YESU, BUGWAM BWAYAHUDAWA.</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 27:38" />Na ba ginda Hahi baragya taba na eb, boik na kakura. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Ato ana karegeu a owen shagyaga ek taazhe ushiri,a be tumtaka hato, <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />A be zwammagaa, &lt;&lt;Gab bone bwa shujuga Egenga, gab bo ma ek na mugeta mu tato! Shi gab shi bwa bo Onhon, to, kajhagya zaat na aginda!&gt;&gt; <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />Nani henda pristochi a tuwaga na hamarumi Ataura na ato tuwaga a be shagyaga ek zwam o rato, a be zwammagaa, <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />&lt;&lt; E chago ato mai, e mashibago kama che reto re eb. Ai, bugwam bo Israʻila ne, e kazhagi nai zaat aginda yanzu, gatwa yado na eb. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />E yinsa bando Onhon, to, che ek yanzu, she ukodage ek, zwam ezwame e be shi bwa bo Onhon.&gt;&gt; <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Har ishi ete ab ginje ek bake ma, a zwagage ek ta ari.<verse eid="MAT 27:44" /></para>
  <para style="s1">Uʻu Yesu</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />To, onhwanho na reto, tush tu sab ta tonge kuchi, har koro berom be tato be rembe. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Na berom be tato henda pa Yesu e dande begwabo na mahore nyange, &lt;&lt;Eloyi,Eloyi lama sabaktani?&gt;&gt; wato,Onhon numi, Onhon numi zwam ya gab na pashe?&gt;&gt; <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />Na ato mai ana yinsagane a hoge nani, paba ange,&lt;&lt;Bot bo te bo on ogaga butuma Iliya,&gt;&gt; <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Ka paba bot boink wo ab bo e be somo, bo zhangi soso etope ek na mani ma sabe, e robi na agungu, etota ek e sa. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Ama a mai ange,&lt;&lt;Ganjhi tuha̱ ko butuma Iliya ya̱ kore e chage ek.&gt;&gt; <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />Pa Yesu e dandaka begwabo na mahore na paba na eb e pashe muhundo mo eb e'u.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Pa azunzu ana yo na Egenga a mahanje ka ryagya, wari zaat har reto.Tonge to ma dumta̱, hate ama bandage. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Pa Onhon o gunjage haʻuyi, ato bura̱ dinya ana rabtage na uyi amashingage na muhondo. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Paba sherage na haʻuyi, kate amashingyau bando ane owagi, na ba esh shep bura̱ ato dinya a ha̱ yek <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />Gagu zarumi na ato ane ab yo taba na eb ane a absaga Yesu a hya edumta̱ e tunge na yisha, pa ryansa rehuma yek kuchi, pa ba ange,&lt;&lt;Tamahinda ene ishi bwa bo Onhon &gt;&gt;.<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Henda azhe aʻa mai dinya , a ne a swabe Yesu wari na tunge to Galili, a be shagi ek hidima. a ba yinga hwenya a be shi mungeu mo e ne e pare <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Wo ab na Mariyamu Magdaliya, na Mariyamu yini yakubu na yusupu, na henda yini awo a zabadi.<verse eid="MAT 27:56" /></para>
  <para style="s">Shiwumba̱ Shi Yesu</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Na rembe ushi, pa bot mai bone bu jhe kurubi, bot bo Arimatiya, bone bwaba ogago yusuf bu kore, eb kuma ishi aswabo a Yesu. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />E kore wo Bilatus e genbage a pa ek riʻu ri Yesu.Bilatus henda biyado a pa ek. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Pa yusupu e jhangi riʻu ri Yesu e rigidaga ek na azunzu a tunjha̱ a bura̱. <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />E tane ek na uyi upu , one o e be e gabe na gungu te. Na eb e swabeke te ne yinu uyi, e kare ge. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Mariyamu magdaliya na minka Mariyamu ab pab shani nabishina be uyi.<verse eid="MAT 27:61" /></para>
  <para style="s">Ana a on Ape o Uyi</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Na bongo bunge, oho kama kimaga, na pristochi a tuwaga na parisiyawa na ab maharage na bishina̱ be Bilatus. <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />Pa ab ange,&lt;&lt; Gab butuwaga, tumabutareu ta bot bo tak ote, tuni eb na muhondo e zwam na muget mo tato nya mashingeu bando ana owagi. <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Zwam nani gab sape a getagage uyi mahinda har mugeta mutato, zwam aswabo a bune eb Hahi ek, ab a zwama ato wai e mashingeu wo ana owagi.Tak ene ya kundaga ya̱ hango e Jigu a hacigage ba on&gt;&gt; <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />Na Bilatus byange naba, &lt;&lt;Ushiu nani,ezhagya ato gasa ekore egitagage inyaka e mahore na mahi. <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Paba a kore a getagage uyi honzhe na te, henda naba tane ato gas a getagage uyi.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s1">Owashigya o Yesu Bando Owane Owa̱gu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Oho hengo o muget mutandare o karegeu, oho owagita a Jigu a muget mutandare, na bungo maʻinta, pa Mariyamu magala na Maryamu ma mai a kore a yingyane uyi.<verse eid="MAT 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2" />Bana shu dumta̱ tonge e tuwaga, tumana hagamba bano henda a kazhiwo na turwana, otazhege taye no owaba sabta uyi na ob pa eb e shani zaat. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Obe ryagaga ta tumaimai, shapo she eb henda shi chen ta tunzhi. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Na ato ape a ha̱ ek, pa ryansa rekumbe yek dinya, a be shi tu henbo tu kingi, pa ba henage na tunge ta ana owagu.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />Ama butom bo hagamba bwange naʻa, &lt;&lt;Eta huga ryansa, na dake e on ogembo Yesu ene ya̱ba ginda. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Wari pab emashigeu ta eb e zwame kurenji e hya bando owaba iri ek. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Henda mahimmanaji e kore e zwama aswabo a bune eb, &lt;E mashingeu wo ana owagu. Ba ena henda ya̱ rwago na gahi koro Galili wariya gahya ha̱ ek!&gt; E ma butariya na ene e gyame zwama.<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Pa ba ge uyi nasom zwam ryansa ab na so chen dinya. A be shi som zwama a kore azwama aswabo a bune Yesu ba un, <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Pa Yesu reto reeb e maharage na a, nyange naba, &lt;&lt;Barkanji;&gt;&gt; Paba shagi ek sujada. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Pa Yesu nyange naba, &lt;&lt; E ta huga ryansa e kore e zwam ato nami a kore Galili,wate ab na ha̱ &gt;&gt;.<verse eid="MAT 28:10" /></para>
  <para style="s">Ezwam ya̱to ne a o ape</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />A be shi tuhano ba'un, pa ato mai bando ato gasa ane a esh so shepo, a pa pristochi a tuwaga a alabare a ene pare. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Na pristochi a tuwaga na ato tuwaga ato a shani ashi taaje, pa ab pa ato gas ekurubi dinya. <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />Pa ba ange, &lt;&lt;Ezwame na to, &lt;aswabo a bone eb a kore na get Hahi ek gatu shi maruba.&gt; <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Pa aswabo a bone eb ane a wutagu hatop a gwamna twa shigya yek taaje,ya̱ hogo tuzuma ba &gt;&gt;.<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />Pa ato gasa ane a che kurubi ni pa mob mush ta prist etuwaga nyange. Har nare taaje oni yahudawa araga shi iri ob.<verse eid="MAT 28:15" /></para>
  <para style="s">Enke ana Yesu e etuma aswabo a bune eb.</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />To aswabo a bune Yesu ato rekwape na inka̱ a kore Galili, paba kore moshama mone mo Yesu nyange yeka maharage. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Taba ha̱ ek paba shegi ek sujada, pa ato mai ashi shaku. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Pa Yesu e kore wo ab nyangya, &lt;&lt;Ana pa mahore na turwana na tunge. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Zwama nani ekore ezwama ato ne ayo natonge ama swabe ashi aswab nami, gahi shagi yek baptisma narezhe re buch, na bwa, na uhunchi o bura̱. <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />Gahi chibaga yek ageta ene gem zwame na gahi. Nani henda, na yo nare na gahi har iyaka a̱shi a duniya &gt;&gt;.<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>