<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Projet Kiyaka</book>
  <para style="toc3">3Yo</para>
  <para style="toc2">Watatu wa Yowani</para>
  <para style="toc1">Mukanda wa tatu wa Yowani</para>
  <para style="mt2">Mukanda wa tatu wa Yowani</para>
  <para style="mt1">3Yowani</para>
  <chapter number="1" style="c" sid="3JN 1"/>
  <para style="s1">Mboti</para>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1"/>Meni, Mbuta wa dibundu, kwena muzitu Kayusi<note caller="a" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Kayusi: tala muna Mhb 19:29; Lom 16:23; 1Ko 1:14. </char></note> wuna yisi zola yi kyedika kyosu.<verse eid="3JN 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2"/>Muzitu, kilomba kyama kyenina ni moosu makala kitoku kikuma kya ngeyi amana wakala phi yi lutu lwa kitoku bwosu bwenina muna moya waku. <verse eid="3JN 1:2"/><verse number="3" style="v" sid="3JN 1:3"/>Kikuma baphangi batudiki amana batiki kimbangi kitadidini kyedika kina kyenina mwena ngeyi yi mutindu wuna wisi dyatila ngeyi mu kyedika. Kyesi kya lawu ngyukikini. <verse eid="3JN 1:3"/><verse number="4" style="v" sid="3JN 1:4"/>Heku kima kifwani kyapheka kyesi kya lawu, ho ka kuyuka ku ni bana bama babati dyatila buna dyenina kyedika.<verse eid="3JN 1:4"/></para>
  <para style="s1">Kwikama dya Kayusi</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5"/>Muzitu watondama, muna moosu mana wisi hanga kikuma kya baphangi keti kikuma kya banzenza, bwabuna bwisi songila lukwikilu lwaku. <verse eid="3JN 1:5"/><verse number="6" style="v" sid="3JN 1:6"/>Bakutidini kimbangi kya lungongu lwaku ku thwala ya Dibundu. Yihakana ni basadisa mu kulanda kitambu kya bawu buna bufwani muna mutindu wa Nzambi. <verse eid="3JN 1:6"/><verse number="7" style="v" sid="3JN 1:7"/>Kikuma, babwi mu nzila kikuma kya kisalu kya zina dya Kidisitu, konda kutambwasa kima ku moku ma batu ba hika. <verse eid="3JN 1:7"/><verse number="8" style="v" sid="3JN 1:8"/>Disongidila ni tufweti basadisa batu ba mutindu wuna, ndangu twasala ha kimosi mu kumwangisa kwa kyedika.<verse eid="3JN 1:8"/></para>
  <para style="s1">Tyotefi yi Temetidiyosi</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9"/>Kisyati kya khufi yisonikini kwena Dibundu; kaasi Thyotefi, yandi wisi zola mu kutwadisaka byosu, kisiku simbidila keti dyambu dimosi muna mamana yisi zimbula. <verse eid="3JN 1:9"/><verse number="10" style="v" sid="3JN 1:10"/>Yi hakana, tangwa yikwísa, yítungulula mbi yina babati hanga, yandi wuna wubati huna mambu yi kuzonzaka mambu ma mbi kikuma kya betu. Kaasi ka moosu ku: kisiku zola ni kayambaka baphangi, yi bana bazodi mu kubatambula, yandi kabati bakakidila mu kubanwanisaka yi kubalubulaka mu Dibundu.<verse eid="3JN 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11"/>Muzitu wama, sokululaku mambu ma mbi kaasi mana menina ma bukheti. Wuna wisi hanga mambu ma mboti kenina wa Nzambi; wuna wisi hanga mambu ma mbi kamuzayiku Nzambi.<verse eid="3JN 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12"/>Boosu babati ta kimbangi kya Temetidiyosi. Kyawu-meni kyedika kibati ta kimbangi kikuma kya yandi. Betu phi, kimbangi kya bukheti tubati ta kikuma kya yandi amana wuzayibwa ni kimbangi kyetu kyenina kya kyedika.<verse eid="3JN 1:12"/></para>
  <para style="s1">Mboti za tsuka</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13"/>Yilenda kala yi mambu ma lawu mana pfwani yikusonikina kaasi yilendamoku sonika ku kisyati yi kazasa. <verse eid="3JN 1:13"/><verse number="14" style="v" sid="3JN 1:14"/>Tsini kivuvu ni ka thama ku yikṵ́mona amana twaménasana ha munwa munwa.<verse eid="3JN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15"/>Yambula ngemba yakala ha kimosi yi ngeyi.</para>
  <para style="p" vid="3JN 1:15">Banduku baku mboti bakuhekini. Hana mboti kwena banduku, kosu mutu muna zina dyandi.<verse eid="3JN 1:15"/></para>
  <chapter eid="3JN 1"/>
</usx>
