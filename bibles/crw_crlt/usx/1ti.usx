  <book code="1TI" style="id">EN_CRLT crw_Chrau_ltr Mon Feb 17 2025 09:52:06 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">1 Timothy</para>
  <para style="toc1">Sirăq Ti-mô-thê di muôi</para>
  <para style="toc2">1 Ti-mô-thê</para>
  <para style="toc3">1Ti</para>
  <para style="mt">1 Ti-mô-thê</para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />Phao-lô, con tuyh Candranh Krit Yêsu de bây camvŭm Siđăch Trôq de, cồ Siđăch vơn, bây Siđăch de, cồ Candranh Krit Yêsu, sinlơ camvân vơn de, <verse eid="1TI 1:1" /><verse number="2" style="v" sid="1TI 1:2" />dơp an Ti-mô-thê, con nhâng ănh je sŭng sinlơ tôq camvân: Ngwân con gĕh sinlơ yăh an ngăn, sinlơ sinđach, yăh song săq a Siđăch Trôq, cồ Vap bây Candranh Krit Yêsu, Siđăch vơn.<verse eid="1TI 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />Dân ca lăm saq tât Ma-sê-đwan, ănh gĕh pân ca'hya con gŭq vlâq u Ê-phê-sô chĕq con saq rach pađau khây tamun tĭq đăng an tăm ti sipơp ndây, <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />khoi vâng chĕq nuih tât khây prau yau mvâr mviq bây khây sirăq chêr chhe njang jong lahwêq, cồ ăp sinlơ dơp tât vrŭq tăm cammlăh, dông cồ vrŭq ôp jơ sên nhi Cô Voq, cồ vrŭq ôp don a sinlơ tôq camvân. <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />Nhâng gatŭq tât sĭq camvŭm pân săng heq nŏq cồ sinlơ sinđach phŭch lŭh a nuih talaq yăh jrŏh soch bây play nuih yăh nggâm bây sinlơ tôq camvân đăng mvâr mvih, <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />en takiq ndu, mvăc chroc a gatŭq tât, en palâq tabayh chĕq tămhơch tât vrŭq tăm nhai vôt gala mvăq mvây, <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />cơnh ôp gru pađau ravwŏq, lăm đăng gưt đăng gal ayh khây camvŭm nơm nhai nŏq hôm sĭq ăp sinlơ cồ nơm tôq camvân. <verse eid="1TI 1:7" /><verse number="8" style="v" sid="1TI 1:8" />Nhâng, vơn gưt pành ravwŏq nĕh mơ yăh hê vu gưt ôp bây nĕh an di dip, <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />mvăc gưt păch heq, nŏq cồ ravwŏq đăng gĕh văt lŭh an tamun yăh sŏng, nŏq an tamun cồ đăng gĕh ravwŏq bây đăng ôp bây, tamun cồ đăng tôq nggâm bưn bap, tamun đăng yăh sŏng bây chhŭq chhau, tamun tachưt vap bây tachưt mê, tamun tachưt vu, <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />tamun cani camăn, ur cơnh ur klô cơnh klô, tăch vro con tamun, tamun nhai mvâr, candân mvâr palôm, bây an khây vu lây tăm chŏl bây sinlơ pađau dip gal, <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />dip bây Sipơp Yăh sindraq sindil Siđăch Trôq yăh vŏq âh de, cồ vrŭq nŏq ănh lĕq gĕh dơp an.<verse eid="1TI 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />Ănh may mo Candranh cồ paq prơn nhwa an ănh, nŏq cồ Candranh Krit Yêsu, Siđăch vơn, mvăc Nĕh gĕh sây ănh gĕh du nuih candưl, lăm chĕq ănh lăp sŭng vrŭq ôp, <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" />an lor aheq ănh cồ tamun mơ viêm chhâc, nhŭp tăn bây pagơq sưmmrâh, nŏq ănh nhâng wŏq gĕh sinlơ sinđach mvăc lăm đăng gưt, ănh khoi gĕh ôp păch sŭng sinlơ đăng tôq. <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />Nhâng, sinlơ yăh an ngăn Siđăch vơn de cồ măq mi lôch lam bây sinlơ tôq camvân nggâm sinlơ sinđach sŭng Candranh Krit Yêsu.<verse eid="1TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 1:15" />Sipơp heq cồ nhâng bâng bây yăh chĕq wŏq an di lĕq, nŏq cồ: “Candranh Krit Yêsu gĕh tât sŭng dưnya chĕq yơt con tamun bưn bap” — nŏq sŭng nŏq ănh cồ tamun saq a vôq lĕq. <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />Nhâng, ănh wŏq gĕh sinlơ sinđach mvăc vrŭq heq, nŏq cồ chĕq Candranh Krit Yêsu Nĕh văt lŭh lĕq nuih talaq tănjưr nơm sŭng ănh, tamun bưn bap a vôq lĕq, dân ca du dŭng an khây tamun gĕh tôq u Siđăch chĕq gĕh sinlơ rĭh wân lawân. <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />Ngwân sinlơ măq prĭh bây sinlơ sindraq sindil sĭq maq Vatau ăp nggơih, cồ Siđăch Trôq ayh muôi wân lawân, đăng gĕh nggui, an tât wân lawân. A-men.<verse eid="1TI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />Ti-mô-thê, con ănh, ănh dơp camvŭm heq an con, bây khây camvŭm tiêng tri lor heq sĭq con, chĕq don a nĕh, con nhâng mprăng lăp sŭng vrŭq tăm pâm tăm păh măq mi, <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />lăm jơ a jăp sinlơ tôq camvân bây con tamun sŭng glăm yăh, nŏq gĕh takiq ndu, mvăc đăng wŏq, lĕq ôp vông jŏch sinlơ tôq nơm, <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />sŭng nŏq gĕh Hi-mê-nê bây A-lec-san-đơ, cồ khây tamun nŏq ănh lăq dơp an Satan chĕq an khây nĕh gĕh pađau tăm ti chĕq đăng thêng nhai viêm tât Cô Voq.<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />Payh canŏq, lor lĕq, ănh pajiêq nchhuch khây camvŭm côt wĭnh, vơu ngwân, wĭnh ala, may mo nhâng cơnh gĕh pađăc hao an ăp ndu iưn, <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />an khây vatau bây lĕq săq khây tamun gĕh gŭq sŭng gatŭq ôp măq, chĕq vơn gĕh dơn rĭh du nggơih nơm iên gân bây song vong bây ăp sinlơ tôq phŭng bây rĭh rom yăh. <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />Nŏq cồ sinlơ yăh rom bây yăh dip gal u măt Siđăch Trôq, Candranh Yơt vơn, <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />cồ Candranh cơnh ăp ndu gĕh yơt bây saq tât tŭq wŏq gưt camvŭm dip gal. <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />Mvăc ayh du Siđăch Trôq bây du Candranh gŭq vlăc canđal Siđăch Trôq bây con tamun — nŏq cồ Candranh Krit Yêsu, du mvu con tamun, <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />Candranh lăq gĕh vŭh dơp nơm Nĕh chĕq trŏh se an ăp ndu, dân ca camvŭm candân lăp choh sŏng năr khay gĕh paq an, <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" />payh camvŭm candân nŏq cồ ănh gĕh iơq ôp tamun yảng sipơp yăh bây con tuyh — ănh nhai nhâng sŭng Candranh Krit, ănh đăng nhai mvâr — nŏq cồ ôp gru pađau an khây văl daq aling sĭq sinlơ tôq camvân bây camvŭm sŏng dip.<verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />Mvăc canŏq, ănh cơnh khây tamun klô rĭh u ăp gatŭq gưt vơu ngwân, iơq ti soch jrŏh hao đăng văt bây sinlơ măq nuih bây tăm cammlăh, <verse eid="1TI 2:8" /><verse number="9" style="v" sid="1TI 2:9" />dân canŏq, khây pôp ŏh ur căh ôp rom an nơm iưn sŭng sinlơ chuq sŏh yăh dip gal bây nuih talaq tănjưr nơm bây jơ nơm, đăng gal a vrŭq ta nhŭm sŏq nggâm bây mơh ha gŏch, ha ao mphla gŏq jên, <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />nŏq a sinlơ tăm dip bây tamun ur nhai tănlŭh nuih talaq phŭng candŭh Siđăch Trôq don a khây vrŭq ôp yăh.<verse eid="1TI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 2:11" />Tamun ur căh đom gưt sŭng sinlơ gŭq ra'ngăp, sŭng sinlơ iêt chăng wân lawân. <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />Sĭq măt ndây, ănh đăng an tamun ur pađau tăm ti ha văt vôq vlơ tamun klô, nŏq căh gŭq ra'ngăp. <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />Mvăc A-đam gĕh sun lŭh lor, en nŏq mơ tât Ê-va, <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />bây A-đam đăng tăm văc sinlơ tagat, nŏq cồ tamun ur, lăm vông lăp sinlơ lamvoch, lăq saq tât tŭq bưn bap. <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />Cồ canŏq, tamun ur gĕh yơt don a vrŭq dĕh con, hê khây nĕh gât gŭq sŭng sinlơ tôq camvân, sinlơ tăm sinđach bây sinlơ soch jrŏh, bây nuih tôr yăh silang.<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />Camvŭm heq cồ nhâng bâng chĕq tôq bây: “Hê vu lây nŏq cơnh ôp gru tê dive, nŏq tamun nŏq gĕh cơnh du vrŭq yăh rom.” <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" />Canŏq, tamun tê dive nhâng cồ tamun đăng tih lăh gĕh, siklô ayh du mvu si-ur, ndĕh ndăp, jơ nơm, đăp nđăp, wŏq chăm tamuôi, gĕh prơn pađau tăm ti, <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />đăng vanhưl sĕh alăc, đăng chin'hâc tăm cammlăh, gŭq saq yăh lamut lamit, yăh tăm la-êr, đăng cơnh can'hir jên caih, <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />gưt jơ di yăh caniêp nơm, gĕh ŏh con gưt iêt chăng bây lĕq nuih talaq tôq sinđach <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />(mvăc hê du mvu đăng gưt trong jơ ca'hya caniêp nơm, nŏq tamun nŏq tê ranăm Vatom Gŭn Siđăch Trôq de canŏq caheq?), <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />đăng gal nŏq cồ tamun me tôq, chĕq đăng payh ơ iơq nơm nŏq tamun nŏq vông jŏch lăp sinlơ ôp dôih dân ca chaq camhôch. <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />Palâq sĭq vlâq, tamun tê nhâng căh gĕh camvŭm candân yăh a tamun aling Vatom Gŭn, chĕq tamun nŏq đăng tarŏh lăp sinlơ viêm măt bây tăm văc dăq chaq camhôch de.<verse eid="1TI 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />Dân canŏq, khây chung kwŏng căh rĭh di yăh, đăng nhai var camvŭm, đăng vanhưl sĕh alăc, đăng cơnh can'hir păch vu de, <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />gưt jơ di yăh sinlơ jru sưt sĭq sinlơ tôq camvân don a con tamun sŭng glăm soch jrŏh. <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />Sĭq măt ndây, khây nĕh khoi căh gĕh longgăn lor, en alưr nŏq căh chĕq khây nĕh ôp vrŭq nŏq đăng vlam sinlơ chih lăh.<verse eid="1TI 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 3:11" />Khây tamun si-ur khoi canŏq, căh gŭq saq di yăh, đăng nhai viêm, gưt jơ nơm, gĕh du nuih talaq sŭng ăp vrŭq.<verse eid="1TI 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 3:12" />Khây chung kwŏng cồ tamun siklô ayh du mvu si-ur, gưt jơ di yăh ŏh con bây lĕq nhi nơm. <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />Mvăc khây tamun ôp vrŭq sŏng yăh văt sĭq an nơm tŭq tao yăq yăh rom bây gŏq sinlơ chha nuih sŭng sinlơ tôq camvân u Candranh Krit Yêsu.<verse eid="1TI 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />Ănh chêr khây camvŭm heq an con, cơnh saq tât di sô chĕq dom con, <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />nŏq hê ănh tât lĭh nggưt, nŏq con nhâng căh gưt ôp lăm lây sŭng nhi Siđăch Trôq de, nŏq cồ Vatom Gŭn Siđăch Trôq cồ hôm mrĭh de, pông jrŏng bây jâng nhi chŏl jăp sinlơ dip gal de. <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />Sinlơ jru sưt sĭq sinlơ tôq camvân nĕh cồ măq mi đăng tăm cammlăh gĕh, nŏq cồ:</para>
  <para style="q" vid="1TI 3:16">“Candranh gĕh tănlŭh sŭng rup swan con tamun,</para>
  <para style="q" vid="1TI 3:16">gĕh nhai yăh sŏng sŭng Siđăch Wênh,</para>
  <para style="q" vid="1TI 3:16">gĕh khây con gŭn sên sây,</para>
  <para style="q" vid="1TI 3:16">gĕh nhai lŭh sŭng ăp văl ganơ,</para>
  <para style="q" vid="1TI 3:16">gĕh tôq camvân vlơ dưnya,</para>
  <para style="q" vid="1TI 3:16">gĕh văt tăn'hao sŭng sinlơ sindraq sindil.”<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />Siđăch Wênh nhai dân lŭng pành sŭng dâq nggơih alưr heq, gŏq ndu paklăh hwât sinlơ tôq camvân, mprăng ndap bây khây yang ravang mvâr tagat nggâm sipơp chaq camhôch, <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />mvăc sinlơ mvâr mviq khây tamun mvâr, con tamun sŭng glăm khây nĕh nŏq nĕh lăq kranh en, <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />lăm pâh đăng an vu tăm sai, đôq krêng lĕq khây păch sa cồ Siđăch Trôq gĕh sun tatao chĕq wŏq bây nuih talaq gưt may mo don tamun tôq camvân bây đom gưt sinlơ dip gal. <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />Mvăc ăp sinlơ Siđăch Trôq sun lŭh ayh yăh ngăn, bây đăng gĕh păch lây tât daq saq hwât chĕq lăm gĕh wŏq bây nuih talaq may mo, <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />mvăc păch sa gĕh ôp jrŏh soch don a camvŭm Siđăch Trôq bây camvŭm vơu ngwân.<verse eid="1TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />Lăm chĕq ăp sinlơ nŏq u vôq măt pôp ŏh, con nhâng cồ dĭch năc yăh sŏng Candranh Krit Yêsu, gĕh tê nơm don camvŭm tôq camvân bây camvŭm pađau tăm ti yăh rom cồ con gĕh ôp bây. <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />Nŏq căh hwi vôq a khây prau yau mvâr mviq dưnya khây un cammra de. Ala nŏq, căh đom trăp an nơm sŭng sinlơ tôq camvân, <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />mvăc “sinlơ đom trăp rup swan nŏq nĕh yăh sŭng takiq năr, nŏq sinlơ đom trăp nuih talaq tôq camvân nŏq gĕh yăh an ăp vrŭq, mvăc gĕh camvŭm pănggân an nggơih heq bây nggơih alưr.” <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />Camvŭm nŏq cồ căh tôq camvân bây căh wŏq lĕq wân, <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />mvăc khananh chŏnh n'hyoq bây tăm jâl an sinlơ heq, mvăc khananh gĕh camvân u Siđăch Trôq hôm mrĭh, Siđăch cồ Candranh Yơt ăp ndu con tamun, lor lĕq cồ tamun tôq Cô Voq.<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />Căh pân ca'hya bây pađau tăm ti ăp sinlơ nŏq. <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />Vâng chĕq vu sên dêh gase mva con de, nŏq căh jêng tamun chĕq an khây con sinau Cô Voq pơch bây, sŭng camvŭm nhai, sŭng vrŭq gŭq saq, sŭng sinlơ sinđach, sŭng sinlơ tôq camvân, sŭng sinlơ jrŏh soch. <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />Căh sên tât vrŭq đŏc sirăq, pân ca'hya, pađau tăm ti an tât năr ănh tât. <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />Vâng hŭch chĕq sinăc gŭq sŭng con, cồ sinăc lăq gĕh paq an con don a camvŭm tiêng tri, nggâm bây sinlơ chĕq ti khây chung kwŏng de.<verse eid="1TI 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 4:15" />Căh đom trăp ăp vrŭq nŏq, căh chĕq măt chĕq tôr lăp nĕh, chĕq an sinlơ tao măq con de jêng lŭh di dân bây ăp ndu. <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />Căh jơ di yăh nơm con bây vrŭq pađau tăm ti. Căh mbêr nuih sŭng ăp vrŭq nŏq, mvăc ôp canŏq con nhâng gĕh yơt lĕq rup swan nơm nggâm bây khây tamun iêt con.<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />Vâng nhai canjâq mŭnh bây cô camvĭnh cammra, nŏq căh vuôi ca'hya nĕh nŏq dân ca vap, klô dlu i ca pôp ŏh klô, <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />tamun ur măq mva dân ca mê, khây ur drŭh, sên ca pôp ŏh ur, sŭng sinlơ jrŏh soch lôch lam.<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />Căh sên prĭh khây ur mrô — khây ur mrô nhâng bâng. <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />Nŏq hê ur mrô lây gĕh con ha sinau, nŏq lor lĕq con sinau nŏq căh gưt đom chĕq sên prĭh tamun nhi nơm de, bây gĕh nuih talaq trŏh vlâq an khây tamun dĕh nơm nŏq, mvăc heq cồ sinlơ dip gal u vôq măt Siđăch Trôq. <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />Cồ canŏq, tamun ur mrô nhâng bâng bây rĭh la-ơi ayh du mvu nĕh, nŏq câp nggơ u Siđăch Trôq bây mbêr nuih mŏq sŭng sinlơ cuôl wĭnh nggâm vơu ngwân măng năr. <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />Hôm tamun saq wŏng sinlơ lêng khlân nŏq lăq chưt en, an cồ nĕh hôm mo rĭh. <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />Khoi căh pân ăp camvŭm heq, chĕq khây nĕh nhâng đăng gĕh tŭq lây chĕq vu camlăh. <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />Nŏq hê vu lây nŏq đăng tê sên tât pôp ŏh nơm, nŏq vlơ lĕq cồ tamun nhi nơm, nŏq tamun nŏq nĕh cammlăh tabayh sinlơ tôq camvân bây cồ tamun viêm dông a tamun đăng tôq.<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />Du ur mrô cơnh gĕh chêr săq vôq nŏq đăng takiq dông prau jât mva, cồ si-ur du lâm siklô ngăn, <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />gĕh candân don a khây vrŭq ôp yăh: nĕh gĕh tê pađau ŏh con đăng, nĕh gĕh uĕh wŏq chăm tamuôi đăng, nĕh gĕh rao jâng an khây con sinau Siđăch đăng, nĕh gĕh sên tât tamun vlam lŏh sat đăng, nĕh gĕh lĕq nuih talaq bây ăp vrŭq yăh đăng.<verse eid="1TI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11" />Nŏq căh vâng an lăp săq khây ur mrô cồ ndŏh lôch mva, mvăc lăm sinlơ cơnh sa vĭq saq hao tăm chŏl vlâq bây Candranh Krit, nŏq khây nĕh cơnh wŏng sai vlâq nggưt, <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />wŏq sinlơ ôp dôih mvăc khây nĕh lăq hwât rabăh sinlơ tăm lăp ti lor lĕq nơm de. <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />En wŏq, khây nĕh khoi uĕh n'niêt, uĕh saq tât nhi nŏq nhi heq, nŏq đăng gal ayh uĕh n'niêt ngăn, nŏq hôm uĕh nhai lawi lawơ bây uĕh doq ti lăp vrŭq vu ndây de, nhai ăp păch cồ khây nĕh đăng uĕh nhai. <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />Canŏq, ănh cơnh khây ur mrô ndŏh camvĭnh saq wŏng sai, dĕh ŏh rŏh con, tê sên nhi nơm, vâng chĕq an khây tamun tăm chŏl gĕh trong chĕq nhai viêm. <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />Mvăc takiq ndu lăq plĕh paklăh saq bây Sa-tan en.<verse eid="1TI 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TI 5:16" />Hê ur tôq Cô Voq lây gĕh ur mrô sŭng nhi, nŏq căh nong iơq khây nĕh, en vâng chĕq Vatom Gŭn văq nong canjâq, chĕq an Vatom Gŭn saq nong iơq khây ur mrô nhâng bâng.<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />Khây chung kwŏng sên vôq yăh nŏq nhâng gĕh vu sên prĭh gŏq dông wŏq, prĭh dông cồ khây tamun sŏq chŏnh sŭng Camvŭm Siđăch bây sinlơ pađau tăm ti. <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" />Mvăc Sirăq Cô Voq gĕh pađau: “May vâng tănchăp takhơp mŭnh con vưr lăm nĕh mpên va,” bây “Tamun ôp vrŭq nhâng gĕh jên bây prơn nĕh de”. <verse eid="1TI 5:18" /><verse number="19" style="v" sid="1TI 5:19" />Vâng chăng wŏq camvŭm yăq văq tăm chŏl vlâq bây du chung kwŏng, ayh yăq hê gĕh vlơ takiq dông var ha pe ndu candân. <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />Căh chih lăh tamun ôp bưn bap u vôq măt ăp ndu chĕq khây tamun hôm sĭq vlâq khây nĕh khoi gưt phung. <verse eid="1TI 5:20" /><verse number="21" style="v" sid="1TI 5:21" />Ănh pân pađau nhâng bâng con u vôq măt Siđăch Trôq bây Candranh Krit Yêsu, nggâm bây khây con gŭn cồ gĕh cuôl săch, pành con căh jơ ăp camvŭm heq nŏq đăng ôp bây nuih talaq sên viêm, đăng ôp păch lây bây nuih talaq nkênh du maq.<verse eid="1TI 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1TI 5:22" />Vâng pĭh păh sô chĕq ti hao vlơ vu lây vầy, bây vâng doq ti lăp sŭng vrŭq bưn bap vu ndây de. Căh jơ nơm con an jrŏh soch.<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />Con căh vâng ayh huch daq, nŏq căh huch du ndêt sĕh mvăc khlơm sŏq con de bây păch ji gŏng ndây cồ con vlam.<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />Bưn bap var pe ndu nŏq dân lŭng, têch tât gatŭq ôp dôih, nŏq khoi gĕh ăp bưn bap ayh văt lŭh lăm lưr gĕh ôp dôih. <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />Dân canŏq, khoi gĕh ăp vrŭq yăh nŏq dân lŭng, hôm ăp vrŭq yăh nĕh gĕh ôp sưt nŏq nhâng đăng tăm pôn gĕh diêt.<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />Lĕq săq khây tamun cồ gŭq a tĕh yơu dĭch năc, căh sên tơm nhi nơm nhâng pành lĕq nuih talaq ta-iơq prĭh, chĕq săq Siđăch Trôq nggâm sinlơ pađau tăm ti đăng vlam vu nhai viêm. <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />Sĭq măt ndây, khây dĭch năc gĕh khây tamun sên vôq cồ tôq Cô Voq nŏq đăng gĕh pành khây nĕh cồ pôp ŏh nŏq sên đăng lŭh păch lây, en căh ôp vrŭq yăh dông wŏq, mvăc khây nĕh cồ con sinau Siđăch bây tamun gĕh sinđach, tamun tăm doq ti lăp sinlơ ôp vrŭq. Con căh pađau tăm ti bây pân ca'hya ăp sinlơ nŏq.<verse eid="1TI 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3" />Hê vu lây pađau tăm ti ca-ayh bây đăng wŏq ăp camvŭm cồ yăh, nŏq cồ camvŭm Siđăch vơn de, cồ Candranh Krit Yêsu, nggâm bây camvŭm pađau sĭq sinlơ tôq wŏq, <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />nŏq vu nŏq cồ tamun lơq săq nơm, đăng gưt păch lây, nŏq nĕh cơnh ayh păch nrui sŭng sinlơ tăm cammlăh bây tăm chih tăm măq nuih sĭq camvŭm nhai, a nŏq en ôp lŭh sinlơ tăm canănh, tăm chŏl, chih viêm, sinâng vrŭq đăng yăh, <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />tăm cammlăh, u sŭng khây tamun tih viêm sŭng chhu vôq bây pŏh pât pachĕq sinlơ dip gal, sên sinlơ tôq phŭng cồ du vrŭq chĕq wŏng sa. <note caller="+" style="f"><char style="ft" closed="false">Gĕh var pe sirăq dâm gĕh nhai </char><char style="fqa">Căh saq ngai ăp sinlơ nŏq, </char> Nŏq ăp sirăq dâm dông cồ vu tôq gŏq nŏq đăng gĕh.</note> <verse eid="1TI 6:5" /><verse number="6" style="v" sid="1TI 6:6" />Nhâng sinlơ tôq phŭng nggâm bây sinlơ vayh nuih cồ vôl tuyh twơ măq. <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />Mvăc vơn đăng văt păch lây lăp dưnya, nŏq vơn khoi đăng văt păch lây saq gĕh. <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />Măt ndây, lăm gĕh piêng sa, ao chuq, nŏq vơn nhâng gĕh vayh nuih sĭq khây sinlơ nŏq. <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />Hôm khây tamun cồ cơnh di gĕh jina nŏq vông lăp sŭng sinlơ lamvoch soch se bây tăm văc dăq, bây gŏq sinlơ cơnh can'hir vôt gala vatwŏq, rabăh rabơp, nŏq cồ khây sinlơ yâl tavŭq nĕh nŏq lăp sŭng sinlơ vông jŏch bây phơi chĕq. <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />Mvăc tơm diyĕh vưt lôch ăp sinlơ viêm chhât cồ sinlơ cơnh can'hir jên caih, gĕh takiq ndu, mvăc cơnh can'hir nĕh, mŏh vlam sinlơ têch iau lŭh ntrăch a sinlơ tôq camvân bây ôp lŏh sat an nơm nggâm gŏq sinlơ ji nuih.<verse eid="1TI 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />Nŏq ơ con, tamun Siđăch Trôq de, căh diêr di ngai a khây sinlơ nŏq, nŏq saq ndap bây sinlơ yăh sŏng, tôq phŭng, tôq camvân, sinlơ sinđach, mbêr nuih, yăh lamut lamit. <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />Căh tăm chŏl sŭng vrŭq tăm mprăng yăh rom sinlơ tôq camvân de, căh jơ di jăp sinlơ rĭh wân lawân, nŏq sinlơ cồ con gĕh cuôl tât bây gĕh raq săq camvŭm nhai lŭh yăh rom u vôq gŏq tamun candân. <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" />Ănh gĕh camvŭm pân an con u vôq măt Siđăch Trôq, Candranh ôp an ăp sinlơ gĕh hôm mrĭh, bây u vôq măt Candranh Krit Yêsu, Candranh cồ dơp lŭh camvŭm nhai yăh rom u Bôn-sơ Phi-lat, <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />pành con căh ôp bây camvŭm pađau heq an đăng sâq vơm, đăng tŭq lây chĕq vu cammlăh, di tât năr lŭh măt Siđăch vơn de, cồ Candranh Krit Yêsu, <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />nŏq Candranh cồ Siđăch Trôq Măq Mi gĕh tapơ payom bây ayh muôi, cồ Vatau vlơ khây vatau nggâm Siđăch vlơ khây siđăch, nhâng gĕh văt lŭh sŭng năr khay cồ tât, <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />ayh du mvu Siđăch cồ gĕh sinlơ đăng chưt, gŭq sŭng sinlơ silang đăng saq tât mơch gĕh, cồ Candranh đăng vu lây sên sây gĕh, khoi đăng vu lây lôch prơn sây gĕh, ngwân sinlơ tôq phŭng nggâm prơn gŭn wân lawân sĭq Siđăch. A-men.<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />Căh pân ca'hya tamun jina sŭng dưnya heq vâng iơq nơm, bây vâng camvân u păch caya đăng kram gajăp, nŏq câp camvân u Siđăch Trôq, Candranh paq an vơn ăp sinlơ vênh rămvi chĕq vui wŏq, <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />en pân ca'hya khây nĕh ôp vrŭq yăh, vênh rămvi sŭng vrŭq yăh, gĕh nuih talaq simăh, rom nuih chĕq tăm paq, <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />chĕq prăp an nơm iưn du gatŭq yăh rom an păch mơch tât, chĕq khây nĕh jơ jăp sinlơ rĭh nhâng.<verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />Ơ Ti-mô-thê, con căh jơ sên sinlơ gĕh dơp an con, diêr ngai a khây prau gala vatwŏq u dưnya, bây khây sinlơ tăm cammlăh sĭq ăp sinlơ vu sinâng pành nŏq cồ vanŏh, <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />nŏq takiq ndu, mvăc gĕh nhai caheq, lăq saq tih trong sinlơ tôq camvân.</para>
  <para style="p" vid="1TI 6:21">Ngwân păch yăh an ngăn gŭq bây khây pôp ŏh.<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>