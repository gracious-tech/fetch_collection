  <book code="MAT" style="id">EN_CRLT crw_Chrau_ltr Tue Feb 04 2025 13:53:42 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Matthew</para>
  <para style="toc1">Sipơp Yăh Ma-thi-ơ</para>
  <para style="toc2">Ma-thi-ơ</para>
  <para style="toc3">Mat</para>
  <para style="mt">Ma-thi-ơ</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Sirăq chhe njang Candranh Krit Yêsu de, con sinau Đa-vit, con sinau Ap-ra-ham: <verse eid="MAT 1:1" /><verse number="2" style="v" sid="MAT 1:2" />Ap-ra-ham dĕh I-sac, I-sac dĕh Ya-côp, Ya-côp dĕh Yu-đa bây pôp ŏh nĕh de, <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />Yu-đa gŭq saq bây Tha-ma dĕh Phê-rêt bây Sê-rach, Phê-rêt dĕh Hêt-rôn, Hêt-rôn dĕh A-ram, <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />A-ram dĕh A-mi-na-đap, A-mi-na-đap dĕh Na-ach-son, Na-ach-son dĕh Sanh-môn, <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />Sanh-môn gŭq saq bây Ra-hap dĕh Bô-ô, Bô-ô gŭq saq bây Ru-tơ dĕh Ô-bêt, Ô-bêt dĕh Ye-sê, <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />Ye-sê dĕh vatau Đa-vit, Đa-vit gŭq saq bây si-ur U-ri de dĕh Sa-lô-môn,<verse eid="MAT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 1:7" />Sa-lô-môn dĕh Rô-bô-am, Rô-bô-am dĕh A-bi-ya, A-bi-ya dĕh A-sa, <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />A-sa dĕh Yô-sa-phat, Yô-sa-phat dĕh Yô-ram, Yô-ram dĕh Ô-sia. <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Ô-sia dĕh Yô-tam, Yô-tam dĕh A-cha, A-cha dĕh Ê-sê-chia, <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Ê-sê-chia dĕh Ma-na-se, Ma-na-se dĕh A-môn, A-môn dĕh Yô-si-a, <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />Yô-si-a dĕh Yê-cô-nia bây pôp ŏh nĕh de sŭng dâq ôp dĭch u Ba-bi-lôn,<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />en alưr dâq saq ôp dĭch u Ba-bi-lôn, Yê-cô-nia dĕh Sa-la-thi-ên, Sa-la-thi-ên dĕh Sô-rô-ba-bên, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />Sô-rô-ba-bên dĕh A-bi-ut, A-bi-ut dĕh Ê-li-a-kim, Ê-li-a-kim dĕh A-sô, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />A-sô dĕh Sa-đôc, Sa-đôc dĕh A-chim, A-chim dĕh Ê-li-ut, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Ê-li-ut dĕh Ê-lê-a-sa, Ê-lê-a-sa dĕh Ma-than, Ma-than dĕh Ya-côp, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />Ya-côp dĕh Yô-sep, siklô Ma-ri de, en a nĕh, Siđăch Yêsu, Candranh gĕh cuôl pành Siđăch Yơt Dưnya, gĕh dĕh jưr. <verse eid="MAT 1:16" /><verse number="17" style="v" sid="MAT 1:17" />Canŏq, lĕq khây nggơih a Ap-ra-ham tât Đa-vit gĕh mât puôn nggơih, a Đa-vit tât dâq saq ôp dĭch u Ba-bi-lôn gĕh mât puôn nggơih, en a dâq saq ôp dĭch u Ba-bi-lôn tât Candranh Krit khoi gĕh mât puôn nggơih.<verse eid="MAT 1:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Sinlơ dĕh jưr Candranh Krit Yêsu de nĕh caheq: Lăm Ma-ri, mê Nĕh, gĕh tăm lŭp bây Yô-sep, cồ canŏq lor a lăm khây nĕh tăm gŭq saq simơ, Ma-ri gĕh rŏh vŭn a Siđăch Wênh. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Hôm Yô-sep, siklô nĕh, cồ tamun yăh sŏng, en mvăc đăng cơnh parang vrŭq nĕh de lŭh, nŏq nĕh cơnh lăq chĕq Ma-ri chŏq ramŏq. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />Cồ canŏq, sŭng lăm nĕh sinâng sĭq khây vrŭq nŏq, aheq sên tĭq, con gŭn Cô Voq de lŭh bây nĕh sŭng lăm vĭq vơq, nhai: “Ơ Yô-sep, con sinau Đa-vit, pôp vâng phŭng vrŭq sai Ma-ri ôp si-ur vầy, mvăc Con Se cồ gĕh rŏh vŭn sŭng nĕh cồ a Siđăch Wênh. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Nĕh nhâng dĕh du lâm Con klô, en pôp căh tan'hya săq an con pành Yêsu, mvăc Con nŏq yơt văl vơn lŭh ntrăch a bưn bap khây nĕh de.” <verse eid="MAT 1:21" /><verse number="22" style="v" sid="MAT 1:22" />Ăp vrŭq heq gĕh ôp lŭh chĕq dip bây camvŭm cồ gĕh Cô Voq nhai don tiêng tri, pành:<verse eid="MAT 1:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="MAT 1:23" />“Căh sên tĭq, ur drŭh palâng rŏh vŭn, en dĕh du lâm con klô, en vu cuôl săq Nĕh pành Em-ma-nu-ên” — gĕh yịch pành “Cô Voq gŭq bây vơn.”<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />En lăm gĕh pre căh a vĭq, Yô-sep ôp dân ca con gŭn Cô Voq de gĕh pân pađau en sai Ma-ri chĕq ôp si-ur nơm. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Cồ canŏq, nĕh đăng gŭq saq simơ bây Ma-ri an tât lăm Ma-ri dĕh du lâm Con klô. En nĕh cuôl săq con nŏq cồ Yêsu.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Lăm Siđăch Yêsu gĕh dĕh jưr u Bêt-lê-hem, ntĕh Yu-đê, sŭng nggơih vatau Hê-rôt, nŏq sên tĭq, khây tamun vanŏh u maq vŏh năr tât u Yê-ru-sa-lem, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />lŭp pành: “Candranh gĕh dĕh lŭh cồ Vatau văl Yo-thai u vi lây? Mvăc khananh gĕh sây simănh Nĕh de u maq vŏh năr en tât chĕq cŭh sưmvăh Nĕh.” <verse eid="MAT 2:2" /><verse number="3" style="v" sid="MAT 2:3" />Aheq lăm chăng sinlơ nŏq, vatau Hê-rôt chưl wưl vyăq lŭng, bây lĕq palây Yê-ru-sa-lem khoi dân ca nĕh. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />En alưr lăm vatom lĕq khây gru sipăm măq nggâm khây gru pađau ravwŏq sŭng con văl tât, vatau lŭp khây nĕh: “Candranh Krit gĕh dĕh lŭh u vi lây?” <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Khây nĕh âh bây vatau: “U Bêt-lê-hem, ntĕh Yu-đê, mvăc gĕh chêr canŏq don tamun nhai lor,<verse eid="MAT 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MAT 2:6" />‘Hôm may, ơ Bêt-lê-hem, ntĕh Yu-đa,</para>
  <para style="q" vid="MAT 2:6">may đăng gal cồ ken dông lĕq sŭng khây palay iau vôq Yu-đa de uy,</para>
  <para style="q" vid="MAT 2:6">mvăc a may an lŭh du Candranh sên vôq</para>
  <para style="q" vid="MAT 2:6">cồ Candranh tê văt I-sơ-ra-ên, văl Ănh de.’”<verse eid="MAT 2:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 2:7" />Lăm nŏq, alưr lăm ra'ngăp cuôl khây tamun vanŏh tât, Hê-rôt saq lŭp khây nĕh an di dân sĭq năr khay simănh gĕh lŭh. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Lăm chĕq an khây nĕh saq tât Bêt-lê-hem, nĕh pân: “Lăm saq en, khây cô căh lŭp an di dân sĭq Con se, en lăm khây cô wŏng vlam, căh nhai an ănh chĕq ănh khoi tât cŭh sưmvăh Nĕh.” <verse eid="MAT 2:8" /><verse number="9" style="v" sid="MAT 2:9" />Lăm gĕh chăng vatau en, khây nĕh gĕh lŭh saq, en sên tĭq, simănh cồ khây nĕh sây u maq vâh năr saq a vôq khây nĕh an tât lăm tât, nŏq nĕh gŭq mŏq sŏng a vlơ vi Con se gŭq. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Lăm gĕh deng sây simănh, khây nĕh vui hơn sŭng sinlơ vui măq mi. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Lăm lăp sŭng nhi en, khây nĕh sây Con se nggâm Ma-ri, mê Nĕh. En lăm chŏl nkrŭng jưr nŏq khây nĕh cŭh sưmvăh Siđăch, en lăm pơq păch caya yăh rom nơm de lŭh, khây nĕh pađăc an Siđăch khây păch pađăc nŏq cồ: mơh, n'hŭm nthôr bây jăl jrơu tăng. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />En mvăc gĕh an gưt vâng palâq sĭq vlâq bây Hê-rôt sŭng du dâq vĭq vơq, nŏq khây nĕh sĭq daq nơm de a trong ndây.<verse eid="MAT 2:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Lăm khây nĕh saq en, nŏq sên tĭq, du con gŭn Cô Voq de lŭh bây Yô-sep găn du dâq vĭq vơq, nhai pành: “Lăm căh vĭq en, căh văt Con se nggâm mê Nĕh, en iau du tu Ai-câp, en căh gŭq sĭq vlâq u nŏq an tât lăm ănh nhai bây pôp, mvăc Hê-rôt cơnh wŏng Con se chĕq tachưt Nĕh.” <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Lăm căh vĭq en, Yô-sep văt Con se nggâm mê Nĕh du tu Ai-câp sŭng dŭng măng, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />en nĕh gŭq sĭq vlâq u nŏq an tât lăm Hê-rôt chưt, nŏq cồ chĕq dip bây camvŭm gĕh nhai a Cô Voq don tamun nhai lor, pành: “Ănh gĕh cuôl Con Ănh lŭh ntrăch Ai-câp”.<verse eid="MAT 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Lăm nŏq, sây pành nơm vlam sinlơ pagơq a khây tamun vanŏh, Hê-rôt măq nuih lŭng, alưr lăm văt camvŭm saq, nĕh tachưt lĕq khây con klô a var mva saq jưr u Bêt-lê-hem bây sŭng lĕq gatŭq sŭng ntĕh nŏq, bây năr khây cồ nĕh lŭp khây tamun vanŏh an di dân. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Canŏq cồ gĕh dip bây camvŭm cồ gĕh nhai don tiêng tri Yê-rê-mi, pành:<verse eid="MAT 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="MAT 2:18" />“Du camvŭm cuôl sec gĕh chăng sŭng palây Ra-ma,</para>
  <para style="q" vid="MAT 2:18">cồ camvŭm ranđĭh bây nhim rơp vyăq van'han,</para>
  <para style="q" vid="MAT 2:18">Ra-chên nhim sĭq khây con nĕh de,</para>
  <para style="q" vid="MAT 2:18">en nĕh đăng wŏq truh sinlơ pawal nuih, mvăc khây nĕh đăng hôm wŏq”.<verse eid="MAT 2:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />En vrêq lăm Hê-rôt chưt, nŏq sên tĭq, du con gŭn Cô Voq de lŭh bây Yô-sep găn du dâq vĭq vơq u Ai-câp, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />nhai pành: “Lăm căh vĭq en, pôp căh văt Con se nggâm mê Nĕh en saq tât ntĕh I-sơ-ra-ên, mvăc khây tamun wŏng tachưt sinlơ rĭh Con se de chưt en.” <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />En lăm căh vĭq èn, Yô-sep văt con se nggâm mê Nĕh, en lăp sŭng ntĕh I-sơ-ra-ên. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Cồ canŏq, lăm chăng pành A-chê-la-u ôp vatau vlơ ntĕh Yu-đê ala an Hê-rôt, vap nơm, nŏq Yô-sep phŭng saq tât nŏq. En lăm gĕh an gưt don sinlơ vĭq vơq, nĕh sĭq vlâq u ntĕh Ga-li-lê, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />en lăm gĕh tât nŏq en, nĕh gŭq sŭng du palây gĕh cuôl pành Na-sa-ret, chĕq gĕh dip bây camvŭm gĕh nhai găn tiêng tri, pành Siđăch gĕh cuôl cồ tamun Na-sa-ret.<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Sŭng khây năr nŏq, Yăng Bap-tit tât nhai tămti sŭng tamăn singot ntĕh Yu-đê, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />pành: “Căh palâq vôq, mvăc Daq Cô Voq mơch tât en.” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Mvăc heq cồ tamun gĕh nhai tât a tiêng tri Ê-sai, pành:</para>
  <para style="q" vid="MAT 3:3">“Gĕh camvŭm tamun cuôl tayh sŭng tamăn singot:</para>
  <para style="q" vid="MAT 3:3">‘Căh pơq sưndăc trong Cô Voq de,</para>
  <para style="q" vid="MAT 3:3">căh ôp an di sŏng khây trong Siđăch de.’”<verse eid="MAT 3:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Yăng heq chuq su ao a sinoq lạc đà, tăn vưt a ntô rawênh yĕq, hôm păch sa nĕh de cồ chap puq bây huch daq sưt nggô. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />En con văl palây Yê-ru-sa-lem, lĕq ntĕh Yu-đê bây lĕq khây gatŭq rawênh phong Yô-đanh tât bây nĕh, <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />en sŭng lăm nhai lŭh bưn bap vơn de, khây nĕh gĕh Yăng Bap-tit ŭm vôq sŭng phong Yô-đanh. <verse eid="MAT 3:6" /><verse number="7" style="v" sid="MAT 3:7" />Lăm deng sây gŏq tamun Pha-ri-si bây Sa-đu-sê tât payh ơ sinlơ ŭm vôq nơm de, Yăng nhai bây khây nĕh: “Ơ con sinau vĭh panim tĭq! Vu lây nhai an khây cô chĕq lôt tăm pôn ntrăch a sinlơ măq nuih mơch tât? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Canŏq mŏh, căh an lŭh play jo yăh dip bây nuih talaq palâq vôq, <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />En khây cô khoi vâng sinâng en nhai bây ndăng ganai: ‘Khananh gĕh un cô jây Ap-ra-ham.’ Mvăc ănh nhai bây khây cô pành Cô Voq ôp lŭh gĕh con sinau an Ap-ra-ham a khây tamô heq. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Cồ canŏq, sung lĕh gĕh chĕq mơch rayĕh tơm chhơ en. Canŏq, lĕq khây chhơ hê đăng an lŭh play yăh nŏq bị păh jưr en hwât lăp ŭnh. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />Ănh ŭm vôq sĭq sinlơ palâq vôq an khây pôp ŏh a daq. Cồ canŏq, Candranh tât alưr ănh gĕh prơn gŭn vlơ ănh, sĭq Candranh nŏq ănh cồ tamun đăng yăh lôch chĕq văt sưnrôm Nĕh de. Nĕh nhâng ŭm vôq an khây pôp ŏh a Siđăch Wênh bây a ŭnh; <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />chhơ sơr Nĕh de u sŭng ti Nĕh, en Nĕh sơr lĕq va sŭng sân nơm de en vatom va Nĕh de lăp sŭng nâm. Cồ canŏq, nĕh sŏh lĕq mlo njôq a ŭnh cồ đăng lăm lây tangât gĕh.”<verse eid="MAT 3:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Lăm nŏq, Siđăch Yêsu saq a ntĕh Ga-li-lê tât phong Yô-đanh, vi Yăng gŭq, chĕq gĕh Yăng ŭm vôq an. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Cồ canŏq Yăng cơ du trong khăq Siđăch diêt, pành: “Ănh nhâng cơnh gĕh Cô ŭm vôq an, aheq lŭh Cô tât bây ănh?” <verse eid="MAT 3:14" /><verse number="15" style="v" sid="MAT 3:15" />Cồ canŏq lăm âh sĭq vlâq, Siđăch Yêsu nhai bây nĕh: “Vrêq, ôp canŏq chĕq vŏq, mvăc canŏq nĕh dip an vơn chĕq ôp jôm ăp sinlơ yăh sŏng.” En Siđăch chĕq nĕh ôp. <verse eid="MAT 3:15" /><verse number="16" style="v" sid="MAT 3:16" />Vrêq heq, lăm wŏq sinlơ ŭm vôq en, sŏng lăm nŏq Siđăch Yêsu hao ntrăch a daq, en sên tĭq, khây tăp trôq gĕh pơq lŭh an Siđăch, en Nĕh sây Siđăch Wênh Cô Voq de rŏh jưr dân ca sŭm vrăt, răp vlơ Nĕh, <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />en sên tĭq, du camvŭm nhai a khây tăp trôq pành: “Heq cồ Con Sinđach Ănh de. Ănh dip nuih u Con nŏq.”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />En Siđăch Yêsu gĕh iau lăp tamăn singot a Siđăch Wênh chĕq vlam chaq camhôch lamvoch. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Alưr nŏq, lăm ât sa sŭng puôn jât năr bây puôn jât năng en, nŏq Siđăch pangot. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Lăm tât mơch, nĕh cồ lamvoch nhai bây Siđăch: “Hê Cô cồ con Siđăch Trôq, nŏq lŭh camvŭm chĕq khây tamô heq jêng bănh chĕq vồh.” <verse eid="MAT 4:3" /><verse number="4" style="v" sid="MAT 4:4" />Aheq âh sĭq vlâq, Siđăch nhai: “Gĕh camvŭm chêr caheq: ‘Con tamun rĭh đăng gal ayh don bănh vŏq en, nŏq hôm don ăp camvŭm nhai lŭh a mŭnh Cô Voq.’” <verse eid="MAT 4:4" /><verse number="5" style="v" sid="MAT 4:5" />En chaq camhôch văt Siđăch lăp sŭng palây gŭn, chĕq Siđăch tao yăq a vlơ gatŭq prĭh dông lĕq Nhi cŭh de, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />en nhai bây Siđăch: “Hê Cô cồ con Siđăch Trôq, nŏq hwât nơm jưr chĕq vồh, mvăc gĕh camvŭm chêr, pành: ‘Nĕh nhâng lŭh camvŭm sĭq con an khây con gŭn Nĕh de,’ en: ‘Khây nĕh iơq con vlơ ti khây nĕh, mvăc phŭng jâng con tachĭh lăp tamô mbơp.’”<verse eid="MAT 4:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Siđăch Yêsu âh sĭq vlâq nĕh: “A maq ndây, khoi gĕh camvŭm chêr: ‘Con vâng longgăn Siđăch Trôq, cồ Cô Voq con de.’” <verse eid="MAT 4:7" /><verse number="8" style="v" sid="MAT 4:8" />Du dâq wŏq, chaq camhôch văt Siđăch hao vlơ du vwây gŭng prĭh lŭng en an Siđăch sên lĕq khây daq vlơ dưnya nggâm sinlơ rom sindraq khây daq nŏq de. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />En nĕh nhai bây Siđăch: “Ănh nhâng an Cô lĕq khây sinlơ heq, hê Cô cŭh khwây ănh, a vrŭq gasăp nơm jưr.” <verse eid="MAT 4:9" /><verse number="10" style="v" sid="MAT 4:10" />Lăm nŏq, Siđăch Yêsu nhai bây nĕh: “Ơ Sa-tan, saq cambet chĕq! Mvăc gĕh camvŭm chêr: ‘Con cŭh sưmvăh Siđăch Trôq, cồ Cô Voq con de, en con ôp vrŭq an ayh du mvu Nĕh.’” <verse eid="MAT 4:10" /><verse number="11" style="v" sid="MAT 4:11" />En chaq camhôch saq ntrăch a Siđăch, en sên tĭq, khây con gŭn tât en pơq vôq tachŏq Nĕh.<verse eid="MAT 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Vrêq heq, lăm chăng lơ pành Yăng vlam vu nhŭp en, nŏq Siđăch saq sĭq tu ntĕh Ga-li-lê. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Lăm saq ntrăch a Na-sa-ret, Siđăch tât rĭh u palây Ca-bê-na-um mơch daq lênh, sŭng ntĕh Sa-bu-lôn bây Nep-ta-li, <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />chĕq gĕh dip bây camvŭm cồ gĕh nhai don tiêng tri Ê-sai, pành:<verse eid="MAT 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MAT 4:15" />“Ntĕh Sa-bu-lôn bây ntĕh Nep-ta-li,</para>
  <para style="q" vid="MAT 4:15">con trong lŭh tu daq lênh, maq tŏq phong Yô-đanh,</para>
  <para style="q" vid="MAT 4:15">nŏq cồ ntĕh Ga-li-lê văl daq aling de —<verse eid="MAT 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="MAT 4:16" />văl gŭq sŭng vi jingo gĕh deng sây ŭnh silang măq,</para>
  <para style="q" vid="MAT 4:16">nggâm khây tamun gŭq sŭng ntĕh bây gui sinlơ chưt,</para>
  <para style="q" vid="MAT 4:16">nŏq ŭnh silang sol vlơ khây nĕh.”<verse eid="MAT 4:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />A lăm nŏq, Siđăch Yêsu pơq vôq pađau tămti bây nhai: “Căh palâq vôq, mvăc Daq Trôq tât mơch en.” <verse eid="MAT 4:17" /><verse number="18" style="v" sid="MAT 4:18" />Vrêq heq, sŭng lăm saq jâng vlơ vâr daq lênh Ga-li-lê, Siđăch deng sây var ndu pôp ŏh, Si-môn, gĕh cuôl pành Phi-e-rơ, bây Anh-rê, ŏh nĕh de, hwât yŭq jưr daq lênh, mvăc khây nĕh cồ tamun pâm yŭq ca. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />En Siđăch nhai bây khây nĕh: “Saq bây Ănh vôh, nŏq Ănh ôp an pôp ŏh jêng khây ti pâm yŭq con tamun.” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Sŏng lăm nŏq, lăm lăq chĕq yŭq nơm de en, khây nĕh saq bây Siđăch. <verse eid="MAT 4:20" /><verse number="21" style="v" sid="MAT 4:21" />Lăm a nŏq saq wŏq, Siđăch sây var ndu pôp ŏh ndây, cồ Ya-cơ con Sê-bê-đê de, bây Yăng, ŏh nĕh de, sŭng duq nggâm bây Sê-bê-đê, vap khây nĕh de, tavôl yŭq nơm de en Siđăch cuôl khây nĕh, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />en sŏng lăm nŏq, lăm lăq chĕq duq bây vap nơm, khây nĕh saq bây Siđăch.<verse eid="MAT 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />En Siđăch saq heq saq tĭq sŭng lĕq ntĕh Ga-li-lê, pađau tămti sŭng khây nhi vatom con văl de, nhai Sipơp Yăh sĭq Daq Trôq, nggâm jâc an yăh ăp sinlơ jicôr bây ăp sinlơ râng dŭh sŭng con văl. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Camvŭm vu nhai sĭq Siđăch nggôr lŭh ngai an tât lĕq ntĕh Si-ri, en vu văt tât an Siđăch ăp tamun gĕh ji râng, vlam gŏq sinlơ ji bây côr tăm ca-ayh, vlam chaq khlâm, ji nrui, ji tŭm en Siđăch jâc yăh an khây nĕh. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Khây mintan con văl gŏq săq saq bây Siđăch a Ga-li-lê, Đê-ca-bô-lơ, Yê-ru-sa-lem, Yu-đê en maq tĭq phong Yô-đanh.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Vrêq heq, lăm sây mintan gŏq săq, Siđăch saq hao vlơ gŭng, en lăm Nĕh gŭq jưr, khây con tuyh Siđăch de tât bây Nĕh. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Siđăch pơq mŭnh pađau tămti khây nĕh, pành:<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />“Yăh vŏq âr cồ khây tamun lŏh sat sŭng wênh nggui,</para>
  <para style="q2" vid="MAT 5:3">mvăc Daq Trôq cồ khây nĕh de.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Yăh vŏq âr cồ khây tamun nhim rơp,</para>
  <para style="q2" vid="MAT 5:4">mvăc khây nĕh gĕh rawa nuih.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Yăh vŏq âr cồ khây tamun lamut lamit,</para>
  <para style="q2" vid="MAT 5:5">mvăc khây nĕh wŏq gĕh ntĕh.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Yăh vŏq âr cồ khây tamun pangot bây can'hir sinlơ yăh sŏng,</para>
  <para style="q2" vid="MAT 5:6">mvăc khây nĕh gĕh săh talaq.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Yăh vŏq âr cồ khây tamun uĕh tăm sinđach,</para>
  <para style="q2" vid="MAT 5:7">mvăc khây nĕh gĕh sinđach.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Yăh vŏq âr cồ khây tamun soch jrŏh sŭng nuih talaq,</para>
  <para style="q2" vid="MAT 5:8">mvăc khây nĕh gĕh sây Cô Voq.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Yăh vŏq âr cồ khây tamun ôp an ganai tăm yăh sĭq vlâq,</para>
  <para style="q2" vid="MAT 5:9">mvăc khây nĕh gĕh cuôl pành khây con Cô Voq de.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Yăh vŏq âr cồ khây tamun vlam vu ôp lŏh sat payh ơ sinlơ yăh sŏng,</para>
  <para style="q2" vid="MAT 5:10">mvăc Daq Trôq cồ khây nĕh de.<verse eid="MAT 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 5:11" />Pôp ŏh ur klô gĕh yăh simăh lăm vu pagơq pôp ŏh, nggâm ôp lŏh sat bây nhai ăp camvŭm chin'hâc oan jan chŏl sĭq vlâq pôp ŏh payh ơ Ănh.<verse eid="MAT 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 5:12" />Căh vui hơn bây săh talaq, mvăc prơn yăh pôp ŏh de măq lŭng a vlơ Daq Trôq, mvăc vu khoi ôp lŏh sat khây tiêng tri lor pôp ŏh dân canŏq.<verse eid="MAT 5:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />Pôp ŏh cồ vŏh ntĕh de. Cồ canŏq hê vŏh phơi sinlơ ntiêt, nŏq nĕh gĕh ôp an ntiêt sĭq vlâq a păch lây heq? Hôm ayh chĕq hwât lŭh tu ling chĕq vlam sinlơ jot lât a vu vŏq, nŏq nĕh đăng văt tât sinlơ yăh lây wŏq. <verse eid="MAT 5:13" /><verse number="14" style="v" sid="MAT 5:14" />Pôp ŏh cồ sinlơ silang dưnya de. Du palây vĭq vlơ vwây gŭng nŏq đăng gĕh păch palây king nĕh gĕh. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Khoi đăng gĕh vu lây sŏh ŭnh en chĕq nĕh u tĕh la-i, nŏq chĕq vlơ jâng ŭnh, en nĕh sol silang an lĕq tamun sŭng nhi. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Khoi canŏq, sinlơ silang pôp ŏh de căh sol lŭh a vôq măt vu, bơh năm an khây nĕh sây gĕh khây vrŭq yăh pôp ŏh de en payom tapơ Vap pôp ŏh de vlơ Daq Trôq.<verse eid="MAT 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />Vâng sinâng pành Ănh gĕh tât chĕq hwât ravwŏq ha khây camvŭm nhai lor. Ănh gĕh tât đăng gal chĕq pâm tayaih, nŏq chĕq ôp an jôm. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Mvăc nhâng, Ănh nhai bây pôp ŏh, an tât lăm trôq bây ntĕh saq ntrăch, nŏq du jŏch ha du khwĕh sŭng ravwŏq nhâng bâng đăng saq ntrăch an tât lăm lây ăp sinlơ gĕh jêng yăh. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Payh canŏq, hê vu lây hwât chĕq muôi sŭng khây sinlơ ken dông lĕq sŭng khây ravwŏq heq en pađau vu canŏq nŏq gĕh cuôl pành ken dông lĕq sŭng Daq Trôq. Palâq sĭq vlâq vu lây ôp nggâm nhai pađau khây ravwŏq nŏq, nĕh nŏq gĕh cuôl pành măq sŭng Daq Trôq. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Mvăc Ănh nhai bây pôp ŏh pành hê sinlơ yăh sŏng pôp ŏh de đăng yăh vlơ sinlơ yăh sŏng khây gru pađau ravwŏq bây tamun Pha-ri-si de, nŏq pôp ŏh nhâng đăng gĕh lăp sŭng Daq Trôq.<verse eid="MAT 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />Pôp ŏh gĕh chăng caheq, camvŭm cồ gĕh nhai an tamun ađơm: ‘Đăng gĕh tachưt tamun,’ nŏq ‘Vu lây tachưt tamun nŏq nhâng wŏq sinlơ ôp dôih.’ <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Cồ canŏq Ănh nhai bây pôp ŏh pành lĕq vu lây cồ măq nuih bây pôp ŏh vơn sẽ vlam sinlơ ôp dôih. Hôm vu lây cuôl pôp ŏh vơn pành: ‘Păch yôch!’ nŏq gĕh vlam vatom simơ săc si. Hôm vu lây swŏq pành: ‘Gala vatwŏq!’ nŏq gĕh vlam sinlơ sŏh roq u ŭnh dưnjrang. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />Payh canŏq, hê pôp ŏh sŭng lăm pađăc păch pađăc nơm de u nra pađăc en u nŏq, pôp ŏh căh gĕh pành du mvu pôp ŏh vơn gĕh sinlơ lây nŏq chŏl bây vơn, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />nŏq căh chĕq sĭq vlâq păch pađăc vơn de u vôq nra pađăc en saq; lor lĕq căh ôp rawa nuih bây pôp ŏh vơn de nŏq, en nŏq lăm saq, căh pađăc păch pađăc vơn de. <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" />Căh sŭmmrăp sŭng sinlơ yăh talaq bây tamun yăq văq vơn an di sô sŭng lăm pôp ŏh saq vlơ trong simơ bây nĕh nŏq, phŭng pành nĕh cồ yăq văq dơp pôp ŏh an ganwâr, en ganwâr dơp an cô var, en pôp ŏh gĕh hwât lăp nhi jingo nggưt. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Nhâng, Ănh nhai bây khây pôp ŏh, pôp ŏh nhâng bâng đăng lŭh ntrăch a nŏq gĕh an tât lăm lây pôp ŏh trŏh tât păndŏh jên chôch lĕq.<verse eid="MAT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />Pôp ŏh gĕh chăng pành, camvŭm gĕh pađau: ‘Đăng gĕh ôp bưn bap cani camăn.’ <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Cồ canŏq, Ănh nhai bây pôp ŏh pành lĕq vu lây deng du mvu ur bây nuih talaq cơnh can'hir nĕh, nŏq vu nŏq ôp bap cani camăn bây ur nŏq sŭng nuih talaq nơm en. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />En hê canong măt maq ma pôp ŏh de ôp an vơn bưn bap, căh kweq nĕh lŭh en hwât ngai ntrăch a pôp ŏh. Mvăc canŏq hôm yăh vlơ an pôp ŏh lăm du ndêt sŭng khây vau swan pôp ŏh de pachĕq, en lĕq rup swan vơn đăng gĕh hwât lăp ŭnh dưnjrang. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />En hê ti ma pôp ŏh de ôp an vơn tachĭh, căh păh nĕh en hwât ngai ntrăch a pôp ŏh. Mvăc canŏq nĕh yăh vlơ an pôp ŏh lăm du ndêt sŭng khây vau swan pôp ŏh de pachĕq, en lĕq rup swan vơn đăng saq lăp ŭnh dưnjrang. <verse eid="MAT 5:30" /><verse number="31" style="v" sid="MAT 5:31" />Hôm camvŭm cồ gĕh nhai: ‘Vu lây lăq chĕq si-ur nơm, nŏq nĕh căh dơp an si-ur du păng sirăq lăq chĕq.’ <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Cồ canŏq, Ănh nhai bây pôp ŏh pành lĕq vu lây lăq chĕq si-ur vơn, sŭng lăm đăng gĕh yăq văq lây sĭq bap cani camăn, nŏq ôp an si-ur nơm văq bap cani camăn. En hê vu lây sai ur cồ vlam siklô lăq chĕq nŏq khoi lŭh cani camăn.<verse eid="MAT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />Pôp ŏh khoi gĕh chăng pành, camvŭm cồ gĕh nhai an tamun ađơm: ‘Vâng raq săq mvâr, palâq sĭq vlâq căh ôp dip camvŭm raq săq vơn de bây Cô Voq.’ <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Cồ canŏq Ănh săng pôp ŏh vâng raq săq vầy, khoi đăng pađau trôq chĕq raq săq, mvăc nŏq cồ vi gŭq Cô Voq de; <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />khoi vâng pađau ntĕh chĕq raq săq, mvăc nŏq cồ vi chĕq jâng Siđăch de; khoi vâng pađau palây Yê-ru-sa-lem chĕq raq săq, mvăc nŏq cồ palây vatau măq de. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Pôp ŏh khoi vâng pađau camvôq vơn chĕq raq săq, mvăc pôp ŏh đăng gĕh prơn lây chĕq ôp an du rawây sŏq jêng voq ha sinđôch. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Cồ canŏq camvŭm pôp ŏh de căh ‘Gĕh, nhai gĕh,’ ha ‘Đăng, nhai đăng.’ Hôm sinlơ lây saq vlơ a vrŭq heq nŏq cồ a chaq camhôch.<verse eid="MAT 5:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />Pôp ŏh gĕh chăng pành, camvŭm gĕh nhai: ‘măt song măt, en sêch song sêch.’ <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Cồ canŏq, Ănh săng pôp ŏh vâng chŏl sĭq vlâq văl chin'hâc. Ala lăp nŏq, lĕq vu lây tavăh pôp ŏh lăp tamôq maq ma, khoi căh dơp tamôq hôm sĭq vlâq an nĕh. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Hôm tamun cồ cơnh yăq pôp ŏh lŭh nhi săc si en nhŭp chĕq ao sŭng di lăm pôp ŏh de, nŏq chĕq an nĕh nhŭp lawân ao chuq aling vơn de. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />En vu lây nŏq piêt pôp ŏh saq du vau trong, nŏq căh saq bây nĕh nŏq var vau trong. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Căh an tamun lây lŭp wĭnh pôp ŏh, bây vâng pale măt ntrăch a tamun cơnh chwâl nham a vi pôp ŏh.<verse eid="MAT 5:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />Pôp ŏh gĕh chăng pành, camvŭm gĕh nhai: ‘Sinđach tamun rawênh vơn bây ncom tamun chŏl sĭq vlâq vơn.’ <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Cồ canŏq Ănh săng pôp ŏh căh sinđach tamun chŏl sĭq vlâq vơn en vơu ngwân ala an tamun ôp lŏh sat vơn, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />ôp bơh năm an pôp ŏh gĕh jêng con Vap vơn de a vlơ Daq Trôq. Nŏq cồ mvăc Siđăch ôp an măt năr Nĕh de vưt hao vlơ tamun chin'hâc nggâm tamun yăh, en Siđăch paq mi vlơ tamun yăh sŏng nggâm tamun đăng yăh sŏng. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Mvăc hê pôp ŏh sinđach khây vu lây sinđach vơn, nŏq pôp ŏh gĕh păch yăh lây? Đăng gal khây tamun nhŭp jên pâng ya khoi ôp dân canŏq uy? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />En hê pôp ŏh ayh wŏq khwây khây pôp ŏh vơn, nŏq pôp ŏh ôp vlơ gĕh păch lây? Đăng gal khây văl daq aling khoi ôp dân canŏq uy? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Canŏq, pôp ŏh căh soch jrŏh dân ca Vap gŭn gayh pôp ŏh de cồ soch jrŏh.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />Căh jơ nơm sĭq sinlơ yăh sŏng vơn de chĕq vâng ôp a vôq măt vu chĕq gĕh khây nĕh deng sây, mvăc hê đăng gal canŏq, phŭng pành pôp ŏh đăng gĕh prơn yăh sŭng sinlơ gĕh măt Vap vơn de a vlơ Daq Trôq. <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />Payh canŏq, lăm pôp ŏh dơp păch an vu iưn, vâng ŭh panŭng a vôq măt nơm dân ca khây tamun gĕh tanrong mvâr ôp sŭng nhi vatom bây u ling trong saq, chĕq khây nĕh gĕh tapơ a vu. Nhâng, Ănh nhai bây pôp ŏh, khây nĕh nŏq gĕh lôch păch yăh khây nĕh de en. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Cồ canŏq sŭng lăm pôp ŏh dơp păch an vu iưn, vâng chĕq an ti gyau pôp ŏh de gưt vrŭq ti ma nơm ôp, <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />ôp bơh năm chĕq vrŭq paq an pôp ŏh de gĕh ôp sŭng vi jru sưt, en Vap pôp ŏh de, cồ Candranh deng sây sŭng gatŭq jru sưt, gĕh paq păch yăh an pôp ŏh.<verse eid="MAT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />En lăm pôp ŏh vơu ngwân, nŏq vâng dân ca nĕh cồ gĕh tanrong mvâr, mvăc khây nĕh cơnh vơu ngwân lăm tao yăq sŭng khây nhi vatom bây u khây vrec trong, chĕq khây nĕh gĕh vu deng sây. Nhâng, Ănh nhai bây pôp ŏh, khây nĕh gĕh lôch păch yăh nơm de en. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Hôm khây pôp ŏh, lăm pôp ŏh vơu ngwân, căh lăp sŭng côt ca-ayh pôp ŏh de, en lăm păng lapông côt nơm de sĭq vlâq, căh vơu ngwân bây Vap vơn sŭng gatŭq jru sưt nŏq; en Vap pôp ŏh de, cồ Candranh deng sây gĕh sŭng gatŭq jru sưt, gĕh paq păch yăh an pôp ŏh iưn. <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />En sŭng lăm vơu ngwân, pôp ŏh vâng nhai sĭq nhai saq valay chĕq dân ca khây văl daq aling, mvăc khây nĕh sinâng pành don sinlơ nhai gŏq vơn de, khây nĕh gĕh iêt chăng. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Payh canŏq, pôp ŏh vâng jêng dân ca khây nĕh, mvăc Vap pôp ŏh gưt pôp ŏh cơnh păch lây lor a lăm pôp ŏh cuôl wĭnh Nĕh en. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />Canŏq, pôp ŏh căh vơu ngwân caheq:</para>
  <para style="q1" vid="MAT 6:9">‘Cŭh Vap ŏh con de a vlơ trôq,</para>
  <para style="q2" vid="MAT 6:9">Wĭnh Săq Siđăch gĕh ta-iơq pành gŭn.<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Wĭnh Daq Vap de gĕh tât,</para>
  <para style="q2" vid="MAT 6:10">Wĭnh nuih cơnh Siđăch de gĕh ôp lŭh u ntĕh dưnya khoi ca vlơ trôq.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Wĭnh paq an ŏh con năr heq gĕh păch sa ăp năr ŏh con de;<verse eid="MAT 6:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="MAT 6:12" />en wĭnh hwât chĕq an ŏh con sĭq khây dôih bap ŏh con de,</para>
  <para style="q2" vid="MAT 6:12">dân ca ŏh con khoi gĕh hwât chĕq dôih bap an khây tamun tăm văc bây ŏh con;<verse eid="MAT 6:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="MAT 6:13" />bây wĭnh vâng văt ŏh con lăp gatŭq lamvoch,</para>
  <para style="q2" vid="MAT 6:13">palâq sĭq vlâq wĭnh yơt ŏh con ntrăch a văl chin'hâc.’<verse eid="MAT 6:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />Mvăc hê pôp ŏh hwât chĕq an vu iưn khây sinlơ tĭh khây nĕh de, nŏq Vap gŭn gayh pôp ŏh de khoi hwât chĕq bưn bap an pôp ŏh iưn. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Hôm hê pôp ŏh đăng hwât chĕq bap an vu iưn, nŏq Vap pôp ŏh de khoi đăng hwât chĕq khây sinlơ tĭh wil pôp ŏh de.<verse eid="MAT 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />Aling nŏq, lăm pôp ŏh ât sa, vâng ôp dân ca khây tamun yưr nuih gĕh tanrong mvâr, mvăc khây nĕh ca'nhau măt mŭh vơn de chĕq an vu sây pành khây nĕh ât sa. Nhâng, Ănh nhai bây pôp ŏh, khây nĕh gĕh lôch prơn yăh vơn de en. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Hôm pôp ŏh, lăm ât sa, căh văng jrơu nthôr vlơ camvôq vơn, bây tu măt vơn de, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />ôp bơh năm đăng chĕq an vu sây pành pôp ŏh ât sa, nŏq an Vap vơn de sŭng gatŭq jru sưt; en Vap pôp ŏh de, cồ Candranh deng sây sŭng gatŭq jru sưt nŏq, gĕh paq prơn yăh an pôp ŏh iưn.<verse eid="MAT 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />Vâng prăp nchêm an nơm păch caya u ntĕh, cồ gatŭq gĕh camhŏq gatiêr bây ăch loih ôp lêch pachăh, khoi cồ gatŭq văl can'hưn chun lăp en nhŭp khưn. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Cồ canŏq, căh prăp nchêm an nơm păch caya a vlơ trôq, cồ gatŭq đăng gĕh camhŏq gatiêr ha ăch loih ôp lêch pachăh, en cồ gatŭq văl can'hưn đăng chun lăp ha nhŭp khưn. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Mvăc păch caya pôp ŏh de u vi lây, nŏq nuih talaq pôp ŏh de khoi gŭq u nŏq. <verse eid="MAT 6:21" /><verse number="22" style="v" sid="MAT 6:22" />Canong măt cồ ŭnh rup swan de. Payh canŏq, hê măt pôp ŏh de cồ yăh, nŏq lĕq rup swan pôp ŏh de gĕh răm vi sinlơ silang. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Palâq sĭq vlâq hê măt pôp ŏh de cồ viêm, nŏq lĕq rup swan pôp ŏh de gĕh rămvi sinlơ jingo. Canŏq hê sinlơ silang sŭng pôp ŏh cồ jingo, nŏq sinlơ jingo nŏq măq gưt dâng lây! <verse eid="MAT 6:23" /><verse number="24" style="v" sid="MAT 6:24" />Đăng gĕh vu lây tachŏq gĕh an var nơm nhi, mvăc nĕh nŏq ndăng ncom nơm nhi heq en sinđach nơm nhi tĭq, ndăng deng prĭh nơm nhi heq en deng dêh nơm nhi tĭq. Pôp ŏh đăng tachŏq Cô Voq nggâm jên caih gĕh. <verse eid="MAT 6:24" /><verse number="25" style="v" sid="MAT 6:25" />Payh ơ sinlơ heq, Ănh nhai bây pôp ŏh, vâng jăl wăl an sinlơ rĭh pôp ŏh de, sĭq păch lây vơn sa ha păch lây vơn huch, ha an rup swan pôp ŏh de, sĭq păch lây vơn chuq. Đăng gal sinlơ rĭh cồ yăh vlơ păch sa, en rup swan yăh vlơ păch chuq uy? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Căh deng sên u khây sŭm khlang vlơ galwang trôq, pành khây nĕh đăng tăm, khoi đăng jwŏq ha chĕq prăp sŭng nâm, cồ canŏq Vap gŭn gayh pôp ŏh de tê khây nĕh. Pôp ŏh đăng gĕh sinlơ yăh gŏq dông vlơ khây sŭm khlang nŏq uy? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Hôm wŏq, sŭng pôp ŏh gĕh vu lây lăm jăl wăl en nŏq ôp an mva rĭh nơm de jong gĕh du ndêt wŏq hẩng? <verse eid="MAT 6:27" /><verse number="28" style="v" sid="MAT 6:28" />En lŭh pôp ŏh jăl wăl sĭq su ao? Saq deng sên a măt khây ncao u tamăn, khây nĕh hon hao bơh năm. Khây nĕh đăng chŏnh n'hyoq, khoi đăng đưc chhe rui vrai. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Cồ canŏq Ănh nhai bây pôp ŏh pành sŏng cồ vatau Sa-lô-môn, sŭng lĕq khây sinlơ yăh rom nĕh de, khoi đăng chuq su ao an nơm dân ca muôi sŭng khây ncao nŏq. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Hôm hê Cô Voq chuq canŏq an canji u ling tamăn, cồ păch năr heq hôm, en ta-au gĕh hwât lăp năq, nŏq khây tamun takiq sinlơ tôq tĭq, Siđăch đăng ôp an gŏq dông gĕh uy? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />Payh canŏq, pôp ŏh vâng jăl wăl en nhai: ‘Vơn sa păch lây?’ ha pành ‘Vơn huch păch lây?’ ha pành ‘Vơn chuq păch lây?’ <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Mvăc khây văl daq aling wŏng miêng lĕq khây sinlơ heq; en mvăc Vap gŭn gayh pôp ŏh de gưt pành pôp ŏh cơnh lĕq khây sinlơ nŏq. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Canŏq lor lĕq căh wŏng daq Cô Voq bây sinlơ yăh sŏng Nĕh de en lĕq khây sinlơ nŏq gĕh dơp lăp lawân an pôp ŏh iưn. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Payh canŏq, pôp ŏh vâng jăl wăl sĭq năr ta-au, mvăc năr ta-au chĕq an ta-au. Sinlơ hyoq chŏnh năr lây lôch an năr nŏq.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />Vâng ôp dôih, chĕq pôp ŏh đăng vlam ôp dôih. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Mvăc sŭng dôih cồ pôp ŏh ôp dôih, pôp ŏh khoi vlam ôp dôih dân canŏq, en bây gatŭq cồ pôp ŏh wĕh, gatŭq wĕh nŏq khoi gĕh wĕh an pôp ŏh iưn. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />En lŭh pôp ŏh deng sây simŏq sŭng măt ganai pôp ŏh vơn, sŭng lăm pôp ŏh đăng sây vau chhơ sŭng măt vơn? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Ha ôp bơh năm nŏq pôp ŏh nhai bây ganai pôp ŏh vơn pành: ‘Chĕq ănh nhŭp simŏq lŭh ntrăch a măt pôp,’ sŭng lăm sên tĭq, vau chhơ gŭq u sŭng măt pôp ŏh de? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Ơ nĕh cồ tanrong mvâr tĭq! Lor lĕq, căh nhŭp vau chhơ lŭh ntrăch a măt nơm, en alưr nŏq, pôp ŏh sây dân chĕq nhŭp simŏq lŭh ntrăch a măt ganai pôp ŏh vơn. <verse eid="MAT 7:5" /><verse number="6" style="v" sid="MAT 7:6" />Pôp ŏh vâng an mintan so păch gŭn, khoi vâng hwât gŏch krang vơn de a vôq măt mintan sưr. Mvăc phŭng khây nĕh jot lât khây păch nŏq u tĕh jâng khây nĕh, en lăm palâq sĭq vlâq khây nĕh căp hêch pôp ŏh lŭh a vŭm mbơp.<verse eid="MAT 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />Căh wĭnh, en sinlơ nŏq gĕh paq an pôp ŏh. Căh wŏng, en pôp ŏh gĕh vlam. Căh gŏh, en lapông gĕh pơq an pôp ŏh iưn. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Mvăc lĕq khây vu lây wĭnh gĕh an; vu lây wŏng gĕh vlam; en, lapông gĕh pơq an vu lây gŏh. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />Ha gĕh vu lây sŭng ndăng pôp ŏh, cồ tamun lăm con vơn wĭnh bănh — en nĕh nŏq an con nơm đe tamô gĕh êh? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Ha lăm con khoi wĭnh ca — en nĕh nŏq an con đe vĭh gĕh êh? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Canŏq, hê pôp ŏh, cồ viêm, hôm gưt an ŏh con vơn de khây păch yăh rom, nŏq Vap pôp ŏh de a vlơ trôq nhâng paq an khây vu lây wĭnh Nĕh gŏq sinlơ yăh rom vlơ gưt dâng lây? <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />Payh canŏq, sŭng ăp vrŭq, hê pôp ŏh cơnh chĕq vu ôp an vơn lĕq khây sinlơ lây, nŏq pôp ŏh khoi căh ôp canŏq an vu, mvăc nŏq cồ ravwŏq bây khây camvŭm tiêng tri.<verse eid="MAT 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />Căh saq lăp găn lapông paga hwêt. Mvăc lapông paga hwi nggâm trong măq hwi iau tât sinlơ chưt lawăch, en gĕh gŏq tamun saq lăp găn nĕh. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Sinlơ nŏq mvăc lapông hwêt nggâm trong gĕh ôp an hwêt iau tât sinlơ rĭh, nŏq gĕh takiq tamun wŏng sây nĕh.<verse eid="MAT 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />Căh chĕq măt sĭq khây tiêng tri mvâr, cồ khây tamun ndau ntô dive tât bây pôp ŏh, cồ canŏq sŭng di lăm, khây nĕh cồ so rahô nrŏq sa. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Pôp ŏh săng găl gưt gĕh khây nĕh a play khây nĕh de. Păch gĕh vu lây bĕh play ramvu u bưl loq, ha play vả u canji hwang êh? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Khoi dân canŏq, ăp chhơ yăh nŏq an lŭh play yăh, hôm chhơ viêm nŏq an lŭh play viêm. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Chhơ yăh đăng an lŭh play viêm gĕh, en chhơ viêm khoi đăng an lŭh play yăh gĕh. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Ăp chhơ lây đăng an lŭh play yăh nŏq vu căl en hwât lăp ŭnh. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Canŏq, kiq lŭh pôp ŏh singgal lŭh khây nĕh a play khây nĕh de. <verse eid="MAT 7:20" /><verse number="21" style="v" sid="MAT 7:21" />Đăng gal ăp ndu nhai bây Ănh: ‘Cŭh Cô Voq, cŭh Cô Voq,’ en gĕh lăp sŭng Daq trôq, palâq sĭq vlâq ayh tamun ôp bây nuih cơnh Vap Ănh de vlơ Daq trôq vŏq. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Sŭng năr nŏq, gŏq tamun nhai bây Ănh: ‘Cŭh Cô Voq, cŭh Cô voq, đăng gal khananh gĕh cuôl săq Cô de chĕq nhai tiêng tri, gĕh cuôl săq Cô chĕq dăh chaq en gĕh cuôl săq Cô ôp gŏq vrŭq măq mi uy?’ <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />En lăm nŏq, Ănh nhai dân bây khây nĕh pành: ‘Ănh đăng gưt kha may nôq! Ơ văl ôp păch chin'hâc tĭq, saq cambet ntrăch a Ănh chĕq!’<verse eid="MAT 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />Payh canŏq, ăp ndu, nŏq cồ lĕq khây vu lây iêt chăng khây camvŭm heq Ănh de en ôp bây khây camvŭm nŏq, nŏq gĕh sên dân ca du mvu tamun vanŏh, cồ tamun ta tao nhi nơm vlơ vâr tamô. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />En lăm mi rŏh jưr, daq lĭch sĭq, chhal khlôm tât en padăp camhlăng lăp nhi nŏq en nĕh đăng talŭng mvăc nĕh gĕh ta tao vlơ vâr tamô. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Palâq sĭq vlâq, ăp ndu iêt chăng khây camvŭm heq Ănh de en đăng ôp bây khây camvŭm nŏq, nŏq gĕh sên dân ca du mvu tamun gala, cồ tamun tatao nhi nơm vlơ chwŏh. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />En lăm mi rŏh jưr, daq lĭch sĭq, chhal khlôm tât en padăp camhlăng lăp nhi nŏq, nŏq nĕh talŭng jưr, en sinlơ lêch pachăh nĕh de cồ măq lŭng.”<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Vrŭq gĕh ôp lŭh nŏq cồ lăm Siđăch Yêsu tămti sŏng khây camvŭm heq, mintan con văl vrưng nrat payh ơ sinlơ pađau Siđăch de, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />mvăc Siđăch pađau tămti khây nĕh gĕh prơn gŭn, en đăng dân ca khây gru pađau ravwŏq khây nĕh de.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Vrêq heq, lăm Siđăch a vlơ gŭng saq jưr, khây mintan con văl gŏq săq saq bây Nĕh. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />En deng tĭq, du mvu ji rawŏq ramanh lăm saq tât, chŏl nkrŭng avôq Siđăch, nhai: “Cŭh Cô Voq, hê Cô sưndăc nuih talaq, Cô gĕh prơn gŭn chĕq ôp an ănh gĕh jrŏh.” <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />En lăm ntŏng ti lŭh, Siđăch baq lăp nĕh, nhai: “Ănh sưndăc nuih talaq. Jrŏh chĕq vồh.” Sŏng lăm nŏq, nĕh gĕh ôp jrŏh rawŏq ramanh nơm de. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Siđăch Yêsu nhai bây nĕh: “Căh jơ mŭnh, pôp vâng nhai bây vu lây gưt, en căh saq, nơm pôp lŭh măt bây gru sipăm en pađăc păch pađăc cồ Môi-se gĕh pân pađau, dân ca du camvŭm candân an khây nĕh.”<verse eid="MAT 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Vrêq heq, lăm Siđăch saq lăp sŭng palây Ca-bê-na-ŭm, du mvu cô var tât bây Siđăch, ngwân wĭnh bây Nĕh <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />pành: “Cŭh Siđăch, dĭch ănh de ji vĭq piêm u nhi, vlam jicôr vyăq lŭng nggơi.” <verse eid="MAT 8:6" /><verse number="7" style="v" sid="MAT 8:7" />Siđăch nhai bây nĕh: “Lăm tât nŏq en, Ănh jâc an nĕh gĕh yăh.” <verse eid="MAT 8:7" /><verse number="8" style="v" sid="MAT 8:8" />Lăm âh sĭq vlâq, Cô var nhai: “Cŭh Siđăch, ănh đăng yăh lôch chĕq Siđăch lăp gĕh sŭng nhi ănh, cồ canŏq wĭnh Siđăch ayh nhai du camvŭm, nŏq dĭch ănh de gĕh jâc yăh. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Mvăc ănh heq khoi cồ tamun gĕh chĕq gŭq can'hâm vu ndây, en gĕh khây congti gŭq can'hâm a ănh. Ănh nhai bây nĕh heq: ‘Saq chĕq,’ nŏq nĕh saq, bây nĕh tĭq: ‘Tât heq,’ nŏq nĕh tât, en bây dĭch năc ănh: ‘Căh ôp vrŭq heq,’ nŏq nĕh ôp.” <verse eid="MAT 8:9" /><verse number="10" style="v" sid="MAT 8:10" />Aheq lăm chăng canŏq, Siđăch Yêsu camhŏq en nhai bây khây tamun saq bây Nĕh: “Nhâng, Ănh nhai bây pôp ŏh, Ănh đăng sây sinlơ tôq camvân măq canŏq a du mvu lây sŭng I-sơ-ra-ên. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Palâq sĭq vlâq, Ănh nhai an pôp ŏh pành gŏq tamun a maq vâh năr bây nhâp năr tât, en khây nĕh gĕh gŭq sa simơ bây Ap-ra-ham, I-sac nggâm Ya-côp sŭng Daq Trôq. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Sŭng lăm khây con Daq Trôq de vu hwât lăp gatŭq jingo u ling, cồ gatŭq gĕh sinlơ nhim rơp bây căp sêch.” <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />En Siđăch Yêsu nhai bây cô var: “Saq chĕq vồh! Dân ca cô gĕh tôq, vrŭq nŏq nhâng gĕh ôp jêng an cô.” En dĭch nŏq gĕh jâq yăh sŭng vadâq nŏq.<verse eid="MAT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Alưr nŏq, Siđăch Yêsu lăp sŭng nhi Phi-e-rơ de, Siđăch sây mê si-ur nĕh de vĭq vlơ chơnơng sŭng lăm râng dŭh. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Siđăch baq lăp ti tamun ji de, en sinlơ râng dŭh saq ntrăch a nĕh, en nĕh prŭh tao en tachŏq Siđăch. <verse eid="MAT 8:15" /><verse number="16" style="v" sid="MAT 8:16" />Vrêq heq, lăm mau jingo tât en, vu văt tât an Siđăch gŏq ndu vlam chaq khlâm, Siđăch dăh khây chaq nŏq a du camvŭm nhai en jâc yăh an lĕq khây vu lây gĕh ji, <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />ôp bơh năm chĕq vrŭq nŏq gĕh dip bây camvŭm cồ gĕh nhai a tiêng tri Ê-sai, pành: “Nơm Siđăch gĕh văq khây sinlơ jicôr vơn de, bây gĕh nong khây sinlơ râng dŭh vơn de.”<verse eid="MAT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Vrêq heq, lăm deng sây mintan con văl rawênh nơm, Siđăch Yêsu lŭh camvŭm săng hao trong saq tât vâr daq u maq tŏq. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />En du gru pađau ravwŏq, lăm tât mơch, gĕh nhai bây Siđăch: “Ơ Cô, ănh cơnh saq bây cô cồ Cô saq vi lây.” <verse eid="MAT 8:19" /><verse number="20" style="v" sid="MAT 8:20" />Siđăch Yêsu nhai bây nĕh: “Sipiq gĕh chhŭng, en sŭm khlang gĕh nsôm, sŭng lăm Con Tamun đăng gĕh gatŭq chĕq Nĕh gơih camvôq gĕh.” <verse eid="MAT 8:20" /><verse number="21" style="v" sid="MAT 8:21" />Canŏq en, du mvu ndây sŭng khây con tuyh nhai bây Siđăch: “Cŭh Siđăch, wĭnh an ănh lor lĕq lŭh saq en tâp vap ănh.” <verse eid="MAT 8:21" /><verse number="22" style="v" sid="MAT 8:22" />Cồ canŏq, Siđăch Yêsu nhai bây nĕh: “Saq bây Ănh, en căh chĕq tamun chưt tâp tamun chưt khây nĕh de.”<verse eid="MAT 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Lăm Siđăch lăp sŭng duq en, khây con tuyh Siđăch de saq bây Nĕh. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />En sên tĭq, du dŏq ramvưt măq tât vlơ daq lênh, tât daq duq vlam daq taklôn răm vi. Cồ canŏq Siđăch vĭq. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />En lăm tât mơch, khây nĕh pre Siđăch, nhai: “Cŭh Siđăch, wĭnh Cô têch yơt; vơn mơch chưt en!” <verse eid="MAT 8:25" /><verse number="26" style="v" sid="MAT 8:26" />En Siđăch nhai bây khây nĕh: “Ơ khây tamun takiq sinlơ tôq camvân tĭq, lŭh pôp ŏh phŭng candŭh?” Alưr nŏq, lăm tao yăq en, Siđăch chĭh chhal bây daq lênh, en sinlơ ra'ngăp nhâng bâng văt tât. <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />Hôm khây tamun tĭq sây camhŏq, nhai: “Nĕh heq cồ bơh năm, mvăc tât cồ chhal bây daq lênh khoi chăng camvŭm Nĕh?”<verse eid="MAT 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />En lăm Siđăch saq tât vâr daq măq tŏq, tât ntĕh văl Ga-đa-ra, var ndu vlam chaq khlâm saq tât vlam Siđăch, lăm saq lŭh a rông camhôch, khây nĕh chin'hâc nhâng bâng tât daq đăng gĕh vu lây lôch prơn chĕq saq găn con trong nŏq. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Sên tĭq, khây nĕh cuôl sec hao, pành: “Cŭh Con Cô Voq, khananh bây Cô gĕh vrŭq lây đăng? Cô tât heq chĕq ôp lŏh sat khananh lor a dâq sŭmmrăp gal hẩng?” <verse eid="MAT 8:29" /><verse number="30" style="v" sid="MAT 8:30" />Sŭng lăm nŏq, gĕh du mintan sưr gŏq săq sa ngai a khây nĕh du vau. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />En nŏq, khây chaq côt kĕh wĭnh Siđăch, pành: “Hê Cô dăh khananh lŭh, wĭnh an khananh khlâm lăp sŭng mintan sưr nŏq.” <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />Siđăch săng khây chaq: “Saq lŭh!” Canŏq en lăm lŭh ntrăch, khây chaq khlâm lăp mintan sưr; en sên tĭq, lĕq mintan tŭh nơm jưr tabôq satŏq iau jưr daq lênh, en khây nĕh chưt sŭng daq. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Lăm nŏq, khây tamun tê sưr lôt du, en lăm sĭq tât palây, khây nĕh đơm sĭq vlâq ăp vrŭq, bây đơm lawân khây vrŭq ratênh tât khây tamun cồ chaq khlâm. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />En sên tĭq, lĕq palây saq lŭh chĕq vlam Siđăch Yêsu. Lăm sây Siđăch, khây nĕh côt kĕh wĭnh ôp bơh năm chĕq Siđăch saq tât gatŭq ndây ntrăch a ntĕh khây nĕh de.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Lăm lăp sŭng duq en, Siđăch saq găn daq lênh en sĭq tât palây nơm de. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />En sên tĭq, vu văt tât an Nĕh du mvu ji tŭm vĭq vlơ vêl. Lăm Siđăch Yêsu sây sinlơ tôq camvân khây nĕh de, Nĕh săng tamun ji tŭm: “Ơ con, camhlăng hao. Khây bưn bap con de gĕh sat rao en.” <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />En sên tĭq, var pe ndu sŭng khây gru pađau ravwŏq nhai bây ndăng ganai: “Nĕh heq nhai bap bây Cô Voq.” <verse eid="MAT 9:3" /><verse number="4" style="v" sid="MAT 9:4" />Mvăc gĕh gưt khây sinlơ sinâng khây nĕh de, Siđăch Yêsu nhai: “Khây cô sinâng viêm sŭng nuih talaq vơn chĕq ôp păch lây? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Mvăc sinlơ lây cồ dê vlơ chĕq nhai: ‘Khây bưn bap con de gĕh sat rao,’ ha nhai: ‘Tao yăq en pơq jâng saq’? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Aheq, chĕq khây cô gưt gĕh pành Con Tamun gĕh prơn gŭn vlơ ntĕh chĕq sat rao bưn bap …” en sŏng lăm nŏq, Siđăch săng tamun ji tŭm: “Tao yăq vồh, taklôn vêl hao, en saq sĭq nhi nơm.” <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />En lăm tao yăq en, nĕh nŏq saq sĭq nhi nơm. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />En nŏq, lăm sây canŏq mintan con văl phŭng candŭh bây payom Cô Voq mvăc gĕh paq an con tamun prơn gŭn canŏq. <verse eid="MAT 9:8" /><verse number="9" style="v" sid="MAT 9:9" />Lăm a gatŭq nŏq lŭh saq, Siđăch Yêsu deng sây du mvu săq Ma-thi-ơ gŭq u gatŭq wŏq jên pâng ya, en siđăch săng nĕh: “Saq bây Ănh vồh.” En lăm tao yăq, nĕh saq bây Siđăch.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Vrŭq gĕh ôp lŭh lăm Siđăch gŭq sa war u sŭng nhi, nŏq sên tĭq, gŏq săq tamun ôp vrŭq wŏq jên pâng ya nggâm tamun gĕh bap saq tât, gŭq lăp nra sa bây Siđăch Yêsu nggâm khây con tuyh Nĕh. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Lăm sây canŏq, khây tamun Pha-ri-si nhai bây khây con tuyh Siđăch: “Păch tơm lây nŏq gru khây pôp de sa war simơ bây khây tamun wŏq jên pâng ya nggâm tamun gĕh bap lŏh?” <verse eid="MAT 9:11" /><verse number="12" style="v" sid="MAT 9:12" />Aheq lăm chăng canŏq, Siđăch nhai: “Tamun camhlăng đăng gĕh don tât gru jrơu, ayh cồ tamun vlam ji râng vŏq. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Nŏq lăm saq ntrăch, căh đom gưt camvŭm nhai heq cồ bơh năm: ‘Ănh cơnh nuih talaq sinđach, đăng gal păch pađăc.’ Mvăc Ănh tât đăng gal chĕq cuôl tamun yăh sŏng, nŏq cồ tamun gĕh bap.”<verse eid="MAT 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Lăm nŏq, khây con tuyh Yăng de tât mơch Siđăch, nhai: “Păch tơm lây nŏq khananh nggâm khây tamun Pha-ri-si uĕh ât sa, sŭng lăm khây con tuyh Gru de đăng ât sa?” <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />Siđăch Yêsu nhai bây khây nĕh: “Mŏq sên di gĕh lăm khây ganai tât vi tăm sai en nuih talaq đăng vui gĕh sŭng lăm sau klô hôm gŭq bây khây nĕh? Cồ canŏq an tât năr lăm sau klô gĕh văt saq ntrăch a khây nĕh, en lăm nŏq khây nĕh ât sa. <verse eid="MAT 9:15" /><verse number="16" style="v" sid="MAT 9:16" />En wŏq, đăng gĕh vu lây tavôl du păng cŭmvai me ndŏh tajŏnh lăp păng ao dâm, mvăc cŭmvai tavôl nŏq tariq tahec ntrăch ao dâm nŏq, en vi tahec lŭh viêm dông. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Khoi đăng gĕh vu lây tŭh alăc me lăp sitôq ntô dâm. En hê đăng gal canŏq, phŭng pành sitôq ntô ramuq pachăh, alăc tarung lŭh en sitôq tahec. Palâq sĭq vlâq, vu tŭh alăc me lăp sitôq ntô me, en var maq gĕh hôm yăh lĕq.”<verse eid="MAT 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Sŭng lăm Siđăch nhai khây camvŭm nŏq bây khây nĕh, nŏq aheq, du mvu văt vôq nhi vatom lăm tât mơch, chŏl nkrŭng jưr a vôq măt Siđăch, nhai pành: “Con ur ănh de me chưt, cồ canŏq lăm tât nŏq, Wĭnh chĕq ti Gru de vlơ con se ur, nŏq nĕh tao rĭh sĭq vlâq.” <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />En lăm tao yăq, Siđăch Yêsu nggâm khây con tuyh Siđăch de saq bây nĕh. <verse eid="MAT 9:19" /><verse number="20" style="v" sid="MAT 9:20" />En sên tĭq, du mvu ur văq nong sinlơ ji lŭh n'ham lĕq mât var mva, lăm saq tât a lưr Siđăch en, nŏq nĕh baq lăp tiêng ao Siđăch de, <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />mvăc nơm nĕh sinâng: “Hê nĕh ayh baq lăp tiêng ao Siđăch vŏq en, nŏq nĕh gĕh yăh.” <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />Cồ canŏq lăm pale sĭq vlâq en sây nĕh, Siđăch Yêsu nhai: “Ơ con ur, camhlăng hao; sinlơ tôq camvân con de jâc an con gĕh yăh”. En tamun ur nŏq gĕh yăh ji a lăm nŏq. <verse eid="MAT 9:22" /><verse number="23" style="v" sid="MAT 9:23" />En Siđăch Yêsu, lăm saq tât nhi tamun văt vôq nhi vatom nŏq en sây khây tamun ŭh camvuôt nggâm mintan gŏq săq minsôc minsac, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />nŏq nhai: “Saq lŭh chĕq, mvăc con ur ken đăng gal chưt, palâq sĭq vlâq nĕh vĭq nŏq.” En khây nĕh gơm pagơq Siđăch. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Canŏq en, lăm mintan gŏq săq gĕh dăh lŭh ling en, nŏq lăm lăp sŭng di lăm, Siđăch văt ti păch ken, en con se ur nŏq tao gŭq ayh nĕh. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Vrŭq heq gĕh parang lŭh sŭng lĕq ntĕh nŏq.<verse eid="MAT 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Sŭng lăm Siđăch Yêsu a gatŭq nŏq lŭh saq, nŏq var ndu jingo măt saq bây Nĕh, sec tayh bây nhai: “Cŭh Con vatau Đa-vit, wĭnh sinđach khananh!” <verse eid="MAT 9:27" /><verse number="28" style="v" sid="MAT 9:28" />Vrêq heq, lăm lăp sŭng nhi en, var ndu jingo măt tât mơch Siđăch en Cô Yêsu nhai bây khây nĕh: “Gal khây pôp tôq pành Ănh ôp gĕh vrŭq nŏq?” Khây nĕh âh bây Siđăch: “Gal, Ơ Siđăch.” <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />En nŏq, Siđăch Yêsu baq lăp măt khây nĕh, nhai: “Vrŭq nŏq nhâng gĕh ôp lŭh an khây pôp bây sinlơ tôq camvân khây pôp de.” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Măt khây nĕh gĕh pơq lŭh, en Siđăch Yêsu tacăh khây nĕh, pành: “Căh jơ mŭnh, khây pôp vâng an vu lây gưt.” <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Cồ canŏq lăm saq lŭh tu ling, khây nĕh đơm vrŭq nŏq sŭng lam ntĕh nŏq.<verse eid="MAT 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Vrêq heq, sŭng lăm khây nĕh saq lŭh, en sên tĭq, vu văt tât an Siđăch du mvu cammlo vlam chaq khlâm. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Lăm chaq gĕh dăh lŭh en, nŏq tamun cammlo nhai gĕh, en con văl camhŏq, nhai: “Du vrŭq canŏq ndŏh gĕh lăm lây gĕh sây sŭng I-sơ-ra-ên!” <verse eid="MAT 9:33" /><verse number="34" style="v" sid="MAT 9:34" />Cồ canŏq khây tamun Pha-ri-si đe nhai: “Nĕh nŏq dăh chaq don u vatau chaq.”<verse eid="MAT 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Siđăch Yêsu sĭq saq găn lĕq khây palây măq bây palây ken, pađau tămti sŭng khây nhi vatom con văl de, nhai lŭh Sipơp Yăh Daq Trôq de, bây jâc yăh ăp sinlơ jicôr nggâm ăp sinlơ râng dŭh. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Vrêq heq, lăm deng sây khây mintan con văl gŏq săq, Siđăch lêch nuih sinđach an khây nĕh, mvăc khây nĕh vlam lŏh sat bây vlam chroc voc, dân ca dive đăng gĕh tamun tê văt. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Alưr nŏq, Siđăch nhai bây khây con tuyh Nĕh: “Cồ khây va dŭm săq lŭng canŏq, sŭng lăm tamun jwŏq ayh takiq. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Payh canŏq, căh côt kĕh wĭnh bây Nơm khây jwŏq va de, chĕq Siđăch săng pađăr khây tamun jwŏq lăp sŭng khây jwŏq va nơm de.”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Lăm cuôl mât var ndu con tuyh nơm de tât, Siđăch paq an khây nĕh prơn gŭn vlơ khây chaq cavơm, chĕq dăh khây chaq lŭh bây jâc yăh ăp sinlơ jicôr nggâm khây sinlơ râng dŭh. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Săq mât var con tuyh cồ caheq: Vôq lĕq, Si-môn (gĕh cuôl pành Phi-e-rơ) bây Anh-rê, ŏh klô nĕh de; Ya-cơ con Sê-bê-đê bây Yăng, ŏh klô nĕh; <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Phi-lip bây Ba-thê-lê-mi; Thô-ma bây Ma-thi-ơ, cồ tamun ôp vrŭq wŏq jên pâng ya; Ya-cơ con A-phê de, bây Tha-đê; <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Si-môn Sê-lôt, bây Yu-đa Ich-ca-ri-ôt, nŏq cồ tamun chŏl sĭq vlâq Siđăch.<verse eid="MAT 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Siđăch Yêsu gĕh pađăr mât var ndu heq saq, lăm pân pađau khây nĕh, pành: “Vâng saq vlơ con trong khây văl daq aling, khoi vâng lăp sŭng palây tamun Sa-ma-ri de. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Cồ canŏq yăh vlơ căh saq tât bây khây con dive chroc voc nhi I-sơ-ra-ên de. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Vrêq heq, lăm saq trong, pôp ŏh căh nhai tămti, nhai pành: ‘Daq Trôq mơch tât en.’ <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Căh jâc yăh tamun jicôr, ôp an tamun chưt tao rĭh sĭq vlâq, ôp jrŏh an tamun rawŏq ramanh, bây dăh khây chaq lŭh. Pôp ŏh gĕh wŏq ngăn, nŏq căh an ngăn. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Vâng prăp jơ mơh, ha bạc ha jên păndŏh sŭng gatui ken u vưt pôp ŏh de, <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />đăng văt krŭh gasop an vrŭq saq, ha var păng ao, ha sinrôm, ha gadông, mvăc tamun ôp vrŭq gĕh wŏq păch sa nơm de. <verse eid="MAT 10:10" /><verse number="11" style="v" sid="MAT 10:11" />Hôm sŭng palây măq ha palây ken lây cồ pôp ŏh saq lăp, căh wŏng gưt du mvu lây nŏq sŭng gatŭq heq cồ tamun yăh lôch, căh gŭq u nŏq an tât lăm lây pôp ŏh lŭh saq. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Vrêq heq, lăm lăp sŭng nhi nŏq, căh ngwân sinlơ yăh iên an gatŭq nŏq. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Du maq, hê nhi nŏq cồ gatŭq yăh lôch, nŏq sinlơ yăh iên pôp ŏh de gĕh tât vlơ nĕh, maq ndây, hê nĕh đăng gal cồ gatŭq yăh lôch, nŏq sinlơ yăh iên pôp ŏh de gĕh sĭq vlâq bây pôp ŏh. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />En vu lây đăng wŏq khwây pôp ŏh, khoi đăng iêt chăng khây camvŭm pôp ŏh de, nŏq lăm saq lŭh ntrăch a nhi ha palây nŏq, căh phăt vuh u jâng pôp ŏh. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Nhâng, Ănh nhai bây pôp ŏh, gĕh dê dŭng an ntĕh Sô-đôm bây Gô-mô-rơ sŭng năr ôp dôih vlơ a an palây nŏq.<verse eid="MAT 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />Sên heq, Ănh pađăr pôp ŏh saq dân ca dive u vlăc cađar mintan so rahô, payh canŏq căh jêng vanŏh dân ca vĭh en lamut lamit dân ca sŭm vrăt. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />En căh chĕq măt sĭq con tamun, mvăc khây nĕh nhŭp dơp pôp ŏh an vatom săc si, en vu pâm pôp ŏh a rĕh sŭng nhi vatom khây nĕh de; <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />en pôp ŏh hôm gĕh têch tât avôq khây ganwâr bây khây vatau payh ơ Ănh, chĕq dân ca du camvŭm candân an khây nĕh bây an khây văl daq a ling. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Cồ canŏq, lăm vu văt dơp pôp ŏh, vâng jăl wăl sĭq vrŭq ôp bơh năm ha sinlơ lây vơn cơnh nhai, mvăc sinlơ cồ pôp ŏh cơnh nhai gĕh paq an pôp ŏh sŭng vadâq nŏq. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Mvăc đăng gal pôp ŏh cồ tamun nhai, nŏq cồ Siđăch Wênh Vap pôp ŏh de nhai sŭng pôp ŏh. <verse eid="MAT 10:20" /><verse number="21" style="v" sid="MAT 10:21" />Vrêq, pôp dơp ŏh lăp gatŭq chưt, en vap văt dơp con, en ŏh con prŭh tao chŏl sĭq vlâq mê vap en ôp an khây nĕh vlam sinlơ chưt. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />En pôp ŏh gĕh vlam ăp ndu chŏl bây ncom payh ơ săq Ănh, cồ canŏq vu lây tao yăq truh tât chôch lawăch, nĕh nŏq gĕh yơt. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Nŏq lăm lây vu ôp lŏh sat pôp ŏh sŭng palây heq, nŏq căh lôt tât palây ndây, mvăc nhâng, Ănh nhai bây pôp ŏh, nhâng bâng pôp ŏh đăng saq gĕh lĕq khây palây I-sơ-ra-ên de an tât lăm Con Tamun tât.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />Con tuyh đăng vlơ gru nơm, dĭch năc khoi đăng vlơ nơm nhi nĕh. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Bây con tuyh, ôp bơh năm an nĕh nŏh gĕh dân ca gru nơm, en dĭch năc gĕh ca nơm nhi nĕh, nŏq lôch en. Hê vu cuôl nơm nhi pành Bê-ên-sê-bun, canŏq tamun nhi nĕh de hôm viêm dông gưt dâng lây! <verse eid="MAT 10:25" /><verse number="26" style="v" sid="MAT 10:26" />Canŏq, vâng phŭng khây nĕh, mvăc đăng gĕh păch lây gĕh păng tang nŏq đăng gĕh pơq lŭh, gĕh prăp tăm pôn nŏq đăng gĕh singgal gưt. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Sinlơ cồ Ănh nhai pađau pôp ŏh u vi jingo, căh nhai lŭh u vi silang, en sinlơ pôp ŏh chăng u tôr, căh nhai lŭh vlơ vôq duôr nhi. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Vâng phŭng candŭh avôq khây tamun tachưt rup swan sŭng lăm đăng tachưt gĕh wênh nggui. Palâq sĭq vlâq, yăh vlơ căh phŭng candŭh Candranh tachưt gĕh lĕq wênh nggui nggâm rup swan sŭng ŭnh dưnjrang. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Đăng gal var lâm sŭm răch gĕh tăch ayh du păndŏh jên uy? En đăng gĕh du lâm lây sŭng khây nĕh tarŏh jưr ntĕh aling sinlơ cơnh Vap pôp ŏh de. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />En tât cồ sŏq vlơ camvôq pôp ŏh, lĕq săq gĕh cơp en. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Payh canŏq, vâng phŭng, pôp ŏh yăh prĭh vlơ gŏq con sŭm răch. <verse eid="MAT 10:31" /><verse number="32" style="v" sid="MAT 10:32" />Nŏq, ăp ndu, nŏq cồ lĕq vu lây nhai lŭh a vôq măt vu sĭq Ănh, nŏq Ănh khoi nhai lŭh a vôq măt Vap Ănh a vlơ Daq Trôq sĭq nĕh. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Palâq sĭq vlâq lĕq vu lây di mo Ănh a vôq măt vu, nŏq Ănh khoi di mo nĕh a vôq măt Vap Ănh de a vlơ trôq.<verse eid="MAT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />Vâng sinâng pành Ănh tât chĕq văt sinlơ yăh iên vlơ ntĕh, Ănh đăng tât chĕq văt sinlơ yăh iên, mà văt pĭh taq. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Mvăc Ănh tât chĕq ôp an con klô chŏl sĭq vlâq vap nơm, con ur chŏl sĭq vlâq mê nơm, sau ur chŏl sĭq vlâq bây mê siklô nơm; <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />en tamun chŏl du mvu de nŏq cồ khây tamun sŭng caniêp nĕh nŏq de. <verse eid="MAT 10:36" /><verse number="37" style="v" sid="MAT 10:37" />Vu lây sinđach vap ha mê vlơ Ănh nŏq đăng yăh lôch bây Ănh; vu lây sinđach con klô ha con ur vlơ Ănh nŏq khoi đăng yăh lôch bây Ănh. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />En vu lây đăng tung chhơ pagăn nơm de en saq bây alưr Ănh nŏq đăng yăh lôch bây Ănh. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Vu lây wŏng sinlơ rĭh nơm de nhâng ôp phơi nĕh, hôm vu lây phơi sinlơ rĭh nơm de payh ơ Ănh gĕh wŏng vlam nĕh.<verse eid="MAT 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />Vu lây wŏq pôp ŏh nŏq cồ wŏq Ănh, en vu lây wŏq Ănh nŏq cồ wŏq Candranh cồ gĕh săng pađăr Ănh. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Vu lây wŏq tamun nhai lor sŭng săq nĕh cồ tamun nhai lor nŏq wŏq gĕh prơn yăh tamun nhai lor de, en vu lây wŏq du mvu tamun yăh sŏng sŭng săq nĕh cồ tamun yăh sŏng nŏq wŏq gĕh prơn yăh tamun yăh sŏng de. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />En hê vu lây an muôi sŭng khây tamun ken heq huch du nggan daq la-iq, mvăc ayh tamun ken nŏq cồ con tuyh, nŏq nhâng, Ănh nhai bây pôp ŏh, nĕh nŏq nhâng bâng đăng phơi prơn yăh nơm de.”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Vrŭq gĕh ôp lŭh lăm Siđăch Yêsu pân pađau mât var ndu con tuyh nơm de sŏng en, nŏq Nĕh saq ntrăch a nŏq chĕq pađau tămti bây nhai camvŭm Cô Voq sŭng khây palây văl ganơ de. <verse eid="MAT 11:1" /><verse number="2" style="v" sid="MAT 11:2" />Vrêq heq, Yăng, lăm gŭq sŭng nhi jingo chăng đơm sĭq khây vrŭq ôp Candranh Yơt Dưnya de, nŏq don khây con tuyh nĕh de gĕh pađăr saq, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />nhai bây Siđăch: “Gru cồ Candranh phải tât, ha khananh câp nggơ du Candranh ndây?” <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />Chĕq âh sĭq vlâq, Cô Yêsu nhai bây khây nĕh: “Lăm saq sĭq, căh đơm sĭq vlâq an Yăng khây vrŭq lây cồ pôp ŏh sây bây chăng. <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Tamun jingo măt gĕh sây, tamun cannwe pơq jâng saq, tamun rawŏq ramanh gĕh jrŏh, tamun tanĭq gĕh chăng dân, tamun chưt gĕh cuôl tao rĭh sĭq vlâq en tamun lŏh sat gĕh chăng nhai Sipơp Yăh. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />En hê vu lây đăng vlam tachĭh payh ơ Ănh nŏq cồ tamun gĕh simăh.”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Vrêq heq, lăm khây con tuyh nŏq saq en, Siđăch Yêsu pơq camvŭm nhai bây con văl sĭq Yăng: “Pôp ŏh saq lŭh vi tamăn singot chĕq sên păch lây — gal cồ canji hwang vlam chhal rănggu hẩng? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Đăng gal canŏq nŏq pôp ŏh saq lŭh chĕq deng păch lây — du mvu gĕh chuq sŏq sŭng sinlơ lamăch lame gal hẩng? Sên tĭq, tamun chuq su ao lamăch lame gŭq sŭng nhi vatau. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Palâq sĭq vlâq, pôp ŏh saq lŭh chĕq deng păch lây — du tiêng tri gal đăng? Ănh nhai bây pôp ŏh, gal en nĕh hôm vlơ a du mvu tiêng tri wŏq. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Nŏq cồ sĭq nĕh nŏq camvŭm heq gĕh chêr:</para>
  <para style="q1" vid="MAT 11:10">‘Sên tĭq, Ănh pađăr tamun nhai Ănh de saq a vôq măt Con, nĕh nhâng gĕh pơq trong an Con a vôq măt Con.’<verse eid="MAT 11:10" /></para>
  <para style="b" />
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11" />Nhâng, Ănh nhai bây pôp ŏh, đăng gĕh du mvu lây gĕh iơq hao sŭng khây tamun cồ gĕh tamun ur dĕh lŭh gĕh yăh prĭh vlơ Yăng Bap-tit, en tamun ken dông lĕq sŭng Daq Trôq hôm măq prĭh vlơ a Yăng wŏq. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Cồ canŏq, a năr Yăng Bap-tit tămti an tât dâng vrêq, Daq Trôq lăm vôq bây sinlơ chin'hâc măq, en khây tamun chin'hâc nhŭp prơn camhlăng chĕq tăm pit Daq nŏq. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Mvăc, lĕq khây tiêng tri bây ravwŏq gĕh nhai lor an tât nggơih Yăng; <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />en hê pôp ŏh gĕh nuih talaq sưndăc chĕq wŏq, nŏq nĕh heq cồ Ê-li, cồ tamun nhâng gĕh tât. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Vu lây gĕh tôr chĕq chăng, căh câp iêt. <verse eid="MAT 11:15" /><verse number="16" style="v" sid="MAT 11:16" />Vrêq Ănh gưt prŭp chhe njang heq bây păch lây? Nĕh nŏq dân ca mintan con se gŭq u vi tăch vro, en khây nĕh tăm cuôl ndăng ganai, <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />pành: ‘Khananh khlôm camvuôt an khamay, en khamay đăng tao răm. Khananh sec ranđih en khamay đăng nhim.’ <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />Mvăc Yăng tât, đăng sa khoi đăng huch, nŏq khây nĕh nhai: ‘Nĕh nŏq vlam chaq khlâm.’ <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Con Tamun tât sa bây huch, nŏq khây nĕh nhai: ‘Deng nĕh tĭq, du mvu nroq sa, du ti lăc sĕh, ganai văl wŏq jên pâng ya de bây mintan tamun bưn bap!’ Cồ canŏq sinlơ vanŏh gĕh cŏh king payh ơ khây ŏh con nĕh de.”<verse eid="MAT 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Alưr nŏq, Siđăch pơq vôq chĭh lăh khây palây cồ mơch lĕq khây păch chin'hâu Siđăch de gĕh ôp u khây gatŭq nŏq, mvăc khây nĕh đăng palâq vôq. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />“Lŏh sat an may, palây Cô-ra-sin! Lŏh sat an may palây Bêt-sai-đa! Mvăc, hê lĕq khây vrŭq chin'hâu cồ gĕh ôp sŭng khamay, lăm gĕh ôp u palây Ti-rơ bây Si-đôn, nŏq nhâng khây nĕh lĕq palâq vôq sŭng savai viêm bây vuh ntĕh a jŏq en. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Cồ canŏq, Ănh nhai bây khamay, nhâng gĕh sinlơ yăh dông an Ti-rơ bây Si-đôn sŭng năr ôp dôih vlơ a an khamay. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Hôm may, palây Ca-bê-na-ŭm, may gĕh iơq hao prĭh tât trôq gĕh êh? May gĕh saq jưr tât dưnjrang. Mvăc hê khây vrŭq gŭn măn cồ gĕh ôp lŭh u may lăm gĕh văt ôp u palây Sô-đôm, nŏq palây nŏq nhâng hôm mo an tât năr heq. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Cồ canŏq, Ănh nhai bây khamay, sŭng năr ôp dôih, ăp sinlơ gĕh yăh dông an ntĕh Sô-đôm vlơ a an khamay.”<verse eid="MAT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Sŭng lăm nŏq, Siđăch Yêsu pơq camvŭm nhai: “Cŭh Vap, cồ Cô Voq trôq bây ntĕh de, Con payom tapơ Vap, mvăc Vap gĕh tăm pôn khây sinlơ heq ntrăch a tamun vanŏh bây tamun gưt vrŭq, en pơq khây sinlơ heq lŭh an con se. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Gal, Ơ Vap, mvăc canŏq cồ sinlơ dip nuih a vôq măt Vap. <verse eid="MAT 11:26" /><verse number="27" style="v" sid="MAT 11:27" />Ăp vrŭq gĕh Vap Ănh patăq an Ănh; Đăng gĕh vu lây gưt Con aling Vap, khoi đăng gĕh vu lây gưt Vap aling Con nggâm khây vu lây cồ hê Con cơnh an gưt. <verse eid="MAT 11:27" /><verse number="28" style="v" sid="MAT 11:28" />Căh tât bây Ănh, ơ lĕq khây vu lây hyoq chŏnh bây văq nong canjâq, en Ănh an pôp ŏh sinlơ lu lŏh. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Căh văq yơu Ănh de vlơ pôp ŏh bây đom gưt a Ănh, mvăc Ănh gĕh nuih talaq lamut lamit, en tănjưr nơm, en pôp ŏh wŏng gĕh sinlơ lu lŏh an wênh nggui vơn. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Mvăc yơu Ănh de dê văq bây njang Ănh de cồ yăh nkhơch.”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Sŭng lăm nŏq, Siđăch Yêsu saq găn khây tamăn va voq sŭng năr Sa-bat, en khây con tuyh Nĕh de pangot, mŏh khây nĕh pơq vôq pĭq khây ncao va en sa. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Aheq lăm sây khây vrŭq nŏq, khây tamun Pha-ri-si nhai bây Siđăch: “Sên tĭq, khây con tuyh Gru de ôp vrŭq đăng gĕh an ôp sŭng năr Sa-bat.” <verse eid="MAT 12:2" /><verse number="3" style="v" sid="MAT 12:3" />Cồ canŏq, Siđăch nhai bây khây nĕh: “Khây cô đăng đŏc sĭq vrŭq vatau Đa-vit gĕh ôp sŭng lăm vatau nggâm khây tamun saq bây nĕh vlam pangot uy? — <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />bơh năm vatau gĕh lăp sŭng nhi Cô Voq de en sa bănh pađăc, en nŏq cồ bănh đăng gĕh an vatau bây khây tamun saq bây vatau gĕh sa, bănh nŏq ayh chĕq an khây gru sipăm vŏq? <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Ha khây cô đăng đŏc sŭng ravwŏq pành sŭng năr Sa-bat, khây gru sipăm sŭng Nhi Cŭh ôp tĭh năr Sa-bat nŏq khây nĕh đăng văq bap uy. <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Cồ canŏq, Ănh nhai bây khây cô pành du Candranh măq vlơ Nhi Cŭh vrêq gŭq u heq. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />En hê khây cô gĕh singgal gưt tu tơm vau heq cồ păch lây: ‘Ănh cơnh nuih talaq tăm sinđach chơ đăng gal con pađăc,’ lăm nŏq nhâng khây cô đăng bĕq dôih khây tamun đăng ôp bưn bap heq pà. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Mvăc Con Tamun cồ Cô Voq năr Sa-bat de.”<verse eid="MAT 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />En lăm saq ntrăch a nŏq en, Siđăch lăp sŭng nhi vatom khây nĕh de. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Sên tĭq, du mvu gĕh ti bị nhot, en khây nĕh lŭp bĕq Siđăch Yêsu, pành: “Gal đăng gĕh an jâc ji râng sŭng năr Sa-bat?” chĕq an khây nĕh yăq văq Siđăch. <verse eid="MAT 12:10" /><verse number="11" style="v" sid="MAT 12:11" />Aheq Siđăch nhai bây khây nĕh: “Gĕh vu lây sŭng khây cô, en nĕh nŏq gĕh du lâm dive, en hê dive nŏq tarŏh jưr chhŭng sŭng năr Sa-bat, en nĕh nŏq đăng văt gât dive en đưc hao hẩng? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />En nŏq con tamun yăh prĭh vlơ con dive gưt dâng lây! Canŏq mŏh, gĕh an ôp vrŭq yăq sŭng năr Sa-bat.” <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Alưr nŏq, Siđăch nhai bây tamun nhot ti: “Dil ti pôp de lŭh vồh.” Nĕh nŏq dil ti lŭh, en ti nŏq gĕh yăh camhlăng sĭq vlâq, dân ca lapang ti tĭq. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Cồ canŏq lăm saq lŭh, khây tamun Pha-ri-si wŏng trong chŏl sĭq vlâq Siđăch ôp bơh năm chĕq khây nĕh tachưt gĕh Siđăch.<verse eid="MAT 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Aheq mvăc gưt canŏq, Siđăch Yêsu plĕq ntrăch gatŭq nŏq. Gŏq ndu gĕh saq bây Siđăch, en Siđăch jâc yăq an lĕq săq khây nĕh, <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />en Siđăch lŭh camvŭm pân khây nĕh chĕq khây nĕh vâng an vu gưt Siđăch, <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />chĕq an camvŭm cồ gĕh nhai don tiêng tri Ê-sai gĕh jêng, pành:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“Sên heq, dĭch năc Ănh, cồ Tamun Ănh gĕh săch sŏq;</para>
  <para style="q1" vid="MAT 12:18">cồ Tamun Sinđach Ănh de, en u Nĕh, wênh nggui Ănh săh nuih nhâng bâng.</para>
  <para style="q1" vid="MAT 12:18">Ănh chĕq Gŭn Ănh de vlơ Nĕh,</para>
  <para style="q1" vid="MAT 12:18">en Nĕh nhai lŭh sinlơ yăh sŏng an khây văl daq aling.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Nĕh đăng tăm cammlăh ha cuôl sec;</para>
  <para style="q1" vid="MAT 12:19">khoi đăng gĕh vu lây chăng mŭnh Nĕh vlơ trong saq.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Nĕh đăng gĭq chhơ ramvŭng cồ mơch dayh;</para>
  <para style="q1" vid="MAT 12:20">Nĕh đăng tangât vlông ŭnh cồ mơch rangat,</para>
  <para style="q1" vid="MAT 12:20">an tât lăm lây Nĕh văt sinlơ yăh sŏng tât sinlơ sa vôq,<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />en khây văl daq aling gĕh camvân u săq Nĕh.”<verse eid="MAT 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Alưr nŏq, du mvu jingo măt bây cammlo vlam chaq khlâm gĕh văt tât an Siđăch, en Siđăch jâc an tamun nŏq gĕh yăh, tât daq tamun cammlo heq nhai gĕh bây deng sây. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Lĕq mintan con văl chăng camhŏq bây nhai: “Gal đăng gưt nĕh heq cồ Con Đa-vit de?” <verse eid="MAT 12:23" /><verse number="24" style="v" sid="MAT 12:24" />Hôm khây tamun Pha-ri-si, lăm chăng vrŭq heq, gĕh nhai: “Nĕh heq đăng dăh gĕh chaq hê đăng gal don a Bê-ên-sê-bun, nŏq cồ vatau chaq.” <verse eid="MAT 12:24" /><verse number="25" style="v" sid="MAT 12:25" />Aheq, gưt sinlơ sinâng khây nĕh de en, Siđăch nhai bây khây nĕh: “Ăp daq lây cồ tăm paklăh nŏq chŏl sĭq vlâq nơm nĕh en talĭh, en ăp palây ha nhi paklăh chŏl sĭq vlâq nơm nĕh, nŏq đăng gŭq gân gĕh. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Hê Sa-tan dăh Sa-tan, nŏq nĕh paklăh chŏl sĭq vlâq nơm nĕh. Canŏq, ôp bơh năm chĕq daq nĕh de gŭq gân gĕh? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />En hê Ănh don Bê-ên-sê-bun chĕq dăh khây chaq, nŏq con khây cô de don vu lây chĕq dăh chaq? Payh ơ vrŭq heq, khây nĕh cồ tamun săc si khây cô. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Palâq sĭq vlâq, hê Ănh don Siđăch Wênh Cô Voq de chĕq dăh khây chaq, canŏq Daq Cô Voq de gĕh tât vlơ khây cô en. <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />Ha pành ôp bơh năm chĕq vu lây nŏq lăp gĕh sŭng nhi tamun camhlăng prơn en can'hưn păch caya nĕh de nŏq lor lĕq vu nŏq đăng tăn chăp tamun camhlăng prơn nŏq sĭq vlâq? En alưr nŏq, vu heq nhŭp lĕq păch nhi nĕh de. <verse eid="MAT 12:29" /><verse number="30" style="v" sid="MAT 12:30" />Vu lây đăng gŭq bây Ănh nŏq chŏl sĭq vlâq Ănh, en vu lây đăng vatom simơ bây Ănh nŏq taprăh taprăng. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Payh ơ vrŭq heq, Ănh nhai bây khây cô, ăp bưn bap nggâm camvŭm nhai bap gĕh lăq chĕq an vu, palâq sĭq vlâq, camvŭm nhai bap tât Siđăch Wênh nŏq đăng gĕh lăq chĕq. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Hê vu lây nhai camvŭm chŏl sĭq vlâq Con Tamun, nĕh nŏq hôm gĕh lăq chĕq an. Cồ canŏq vu lây nhai chŏl sĭq vlâq Siđăch Wênh, nĕh nŏq đăng gĕh lăq chĕq an, lawân sŭng nggơih heq ha sŭng nggơih mơch tât. <verse eid="MAT 12:32" /><verse number="33" style="v" sid="MAT 12:33" />Ha pành, tê chhơ yăh nŏq play nĕh yăh, ha tê chhơ viêm nŏq play nĕh viêm, mvăc chhơ gĕh singgal gưt don u play nĕh de. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Ơ chhe hwai vĭh paniêm tĭq, mvăc chin'hâc, nŏq mŏq khây cô nhai gĕh sinlơ yăh? Mvăc mŭnh nhai lŭh khây păch vênh rămvi sŭng nuih talaq. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Tamun yăh, lŭh a vrŭq vadâng sinlơ yăh rom nơm de, en dĕh lŭh sinlơ yăh, hôm tamun chin'hâc, lŭh a vrŭq vadâng sinlơ chin'hâc nơm de, en dĕh lŭh sinlơ chin'hâc. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Cồ canŏq, Ănh nhai bây khây cô pành ăp camvŭm đăng yăh cồ vu nhai, khây nĕh sẽ dơp lŭh camvŭm nhai sĭq nĕh sŭng năr săc si. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Mvăc payh ơ khây camvŭm nhai nơm de, khây cô gĕh cuôl pành yăh sŏng, en payh ơ khây camvŭm nhai nơm de, khây cô tăm văc dôih.”<verse eid="MAT 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Alưr nŏq, var pe ndu gru pađau ravwŏq bây tamun Pha-ri-si âh sĭq vlâq bây Siđăch, pành: “Ơ Cô, khananh cơnh sây u Cô du păch chin'hâu.” <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" />Aheq chĕq âh sĭq vlâq, Siđăch nhai bây khây nĕh: “Du chhe njang chin'hâc bây cani camăn wŏng miêng du păch chin'hâu, cồ canŏq đăng gĕh păch chin'hâu lây gĕh paq an nĕh, aling păch chin'hâu tiêng tri Yô-na de. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Mvăc Yô-na gĕh gŭq sŭng talaq ca măq pe năr en pe năng bơh năm, Nŏq Con Tamun khoi gŭq pe năr en pe năng sŭng ntĕh dân canŏq. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Sŭng năr săc si, văl Ni-ni-ve tao yăq nggâm bây chhe njang heq en bĕq dôih nĕh. Mvăc khây nĕh gĕh palâq vôq a camvŭm nhai tămti Yô-na de, en sên heq, Candranh măq prĭh vlơ Yô-na gŭq u heq. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Sŭng năr săc si, ur vatau u maq cang năr tao yăq nggâm bây chhe njang heq en bĕq dôih nĕh, mvăc a khây gatŭq ngai dông lĕq sŭng play ntĕh, nĕh gĕh tât chĕq chăng sinlơ vanŏh Sa-lô-môn de, en sên heq, Candranh măq prĭh vlơ Sa-lô-môn gŭq u heq. <verse eid="MAT 12:42" /><verse number="43" style="v" sid="MAT 12:43" />Vrêq, lăm chaq cavơm gĕh lŭh ntrăch a du mvu, nĕh saq găn khây gatŭq ro rănh, wŏng gatŭq gŭq lu en đăng sây. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Lăm nŏq, nĕh nhai: ‘Ănh saq sĭq vlâq u nhi ănh cồ gatŭq ănh gĕh lŭh saq.’ Alưr lăm sĭq tât, nĕh sây rot nhi ngăn hwŏng hwŏng, gĕh bôih câr yăh jrŏh, en gĕh sŭmmrăp đăp nđăp. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Alưr nŏq, nĕh saq en iau sĭq simơ bây nĕh pŏh lâm chaq ndây hôm chin'hâc vlơ nĕh wŏq, en lăm lăp sŭng di lăm en, lĕq khây nĕh rĭh u nŏq. En sinlơ chôch tamun nŏq de jêng rôch bach vlơ a lăm daq vôq. Vrŭq khoi gĕh dân canŏq an chhe njang chin'hâc heq.”<verse eid="MAT 12:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Sŭng lăm Siđăch hôm nhai păch bây con văl, sên tĭq, mê nggâm khây ŏh Nĕh de tât tao yăq u ling, wŏng trong chĕq nhai păch bây Siđăch. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Lăm vrêq, du mvu tĭq nhai bây Siđăch: “Sên tĭq, mê Gru bây khây ŏh Gru de tao yăq u maq ling, wŏng trong chĕq nhai păch bây Gru.” <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />Cồ canŏq lăm âh camvŭm, Siđăch nhai bây tamun cồ nhai bây nơm: “Vu lây cồ mê ănh, en vu lây cồ khây ŏh ănh?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />En lăm dơp ti nơm pađau sĭq khây con tuyh nơm de, Siđăch nhai: “Sên tĭq, mê Ănh en khây ŏh Ănh de heq! <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Mvăc hê vu lây ôp bây nuih cơnh Vap Ănh de a vlơ Daq Trôq, nĕh nŏq cồ ŏh klô, ŏh ur en mê Ănh je.”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Sŭng năr nŏq, lăm saq lŭh ntrăch a nhi, Siđăch Yêsu gŭq u vâr daq lênh. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Mintan con văl gŏq săq lŭng vatom sĭq vlâq rawênh Nĕh. Tât daq, lăm hao vlơ du tong duq, Siđăch gŭq jưr, en lĕq mintan con văl tao yăq a vlơ vâr daq lênh. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />En Siđăch don camvŭm prŭp nhai bây khây nĕh gŏq sinlơ, pành: “Sên heq, du mvu vrŏh sitil saq lŭh chĕq vrŏh. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Lăm vrŏh sitil, gĕh khây nggrăp tarŏh amaq trong, nŏq sŭm păr tât en sa lĕq sitil nŏq. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Khây nggrăp ndây tarŏh vlơ ntĕh tamô sarĕh, cồ vi đăng gĕh gŏq ntĕh gŏng. Sŏng lăm nggrăp ntŏh măt, mvăc ntĕh đăng gĕh jru. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />En lăm măt năr vưt hao, chhơ con vlam năr dŭh sŏh roq en ro rănh mvăc đăng gĕh rayĕh. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Hôm khây nggrăp ndây tarŏh sŭng khây bưl loq, nŏq khây bưl loq măq hao en piêt khây chhơ con nŏq. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />En khây nggrăp ndây wŏq tarŏh vlơ ntĕh yăh, en an lŭh ncao play, nggrăp heq gĕh du rayĕng palang, nggrăp tĭq gĕh prau jât, nggrăp tơq gĕh pe jât. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Vu lây gĕh tôr, căh iêt chăng.”<verse eid="MAT 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />En khây con tuyh, lăm tât mơch, nhai bây Siđăch: “Păch tơm lây nŏq Gru nhai bây con văl a khây sinlơ prŭp canŏq?” <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />Canŏq en, lăm âh camvŭm, Siđăch nhai bây khây nĕh pành: “Bây pôp ŏh nŏq gĕh paq an chĕq gưt khây sinlơ jru sưt sĭq Daq Trôq, hôm bây khây nĕh nŏq đăng gĕh paq an. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Mvăc vu lây gĕh, en sĭq maq nĕh gĕh paq an wŏq, en nĕh nŏq gĕh vênh canăh. Hôm vu lây đăng gĕh, nŏq khoi nhŭp ntrăch a nĕh lawân sinlơ cồ nĕh gĕh sŭng ti. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Payh ơ tơm tu heq, Ănh nhai bây khây nĕh a camvŭm prŭp; mvăc cồ gĕh deng, khây nĕh đăng singgal gưt; en cồ câp iêt, khây nĕh đăng chăng gĕh, khoi đăng dân gĕh. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />En camvŭm nhai lor Ê-sai de gĕh jêng u khây nĕh, pành:</para>
  <para style="q" vid="MAT 13:14">‘Sŭng vrŭq chăng, pôp ŏh gĕh iêt chăng, en nhâng bâng pôp ŏh đăng dân gĕh;</para>
  <para style="q" vid="MAT 13:14">hôm lăm deng, khây pôp ŏh deng sên, en nhâng bâng pôp ŏh đăng singgal gưt.<verse eid="MAT 13:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MAT 13:15" />Mvăc nuih talaq văl heq gĕh jêng kranh;</para>
  <para style="q" vid="MAT 13:15">tôr khây nĕh đăng dê chăng,</para>
  <para style="q" vid="MAT 13:15">en khây nĕh nhơm măt nơm,</para>
  <para style="q" vid="MAT 13:15">mvăc phŭng khây nĕh deng sây gĕh a măt,</para>
  <para style="q" vid="MAT 13:15">iêt chăng a tôr,</para>
  <para style="q" vid="MAT 13:15">dân gĕh a nuih talaq,</para>
  <para style="q" vid="MAT 13:15">en palâq vôq sĭq vlâq,</para>
  <para style="q" vid="MAT 13:15">en Ănh jâc yăh an khây nĕh.’<verse eid="MAT 13:15" /></para>
  <para style="b" />
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16" />Cồ canŏq, yăh vŏq âr an măt pôp ŏh de, mvăc sây gĕh, en tôr pôp ŏh de, mvăc chăng gĕh. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Nhâng, Ănh nhai bây pôp ŏh pành gŏq tiêng tri bây tamun yăh sŏng cơnh can'hir chĕq sây khây păch cồ pôp ŏh sây, nŏq khây nĕh đăng sây gĕh, bây chĕq chăng khây păch cồ pôp ŏh chăng, nŏq khây nĕh đăng chăng gĕh. <verse eid="MAT 13:17" /><verse number="18" style="v" sid="MAT 13:18" />Canŏq, vrêq pôp ŏh chăng camvŭm prŭp sĭq tamun vrŏh sitil. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Ăp ndu chăng con trong Daq Trôq de, en đăng dân, nŏq chaq sŭq tât en nhŭp siđŏh chĕq păch cồ gĕh tăm sŭng nuih talaq tamun nŏq. Heq cồ nggrăp sitil gĕh tăm u maq trong. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Hôm nggrăp sitil gĕh tăm lăp ntĕh tamô sarĕh nŏq cồ tamun chăng camvŭm Cô Voq en sŏng lăm nŏq wŏq camvŭm nŏq bây nuih talaq vui hơn; <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />cồ canŏq nĕh nŏq đăng gĕh rayĕh sŭng nơm, en gŭq gĕh ayh du ndêt; canŏq en lăm pŏh păt ha lŏh sat văt tât payh ơ con trong Cô Voq, nŏq nĕh vông hlŏq lawân. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Hôm nggrăp sitil gĕh tăm sŭng khây bưl loq, heq cồ tamun chăng camvŭm Cô Voq, sŭng lăm sinlơ jăl wăl sĭq dưnya heq en sinlơ gan'hăp jina palôm mvâr ôp an con trong Cô Voq nŏq đăng hao măq truh en nĕh jêng đăng jêng gayh. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Vrêq heq nggrăp sitil cồ gĕh vrŏh u vlơ ntĕh yăh, nŏq cồ tamun chăng camvŭm Cô Voq en dân gĕh, nĕh nŏq nhâng an lŭh play jo en du nggrăp dĕh lŭh du rayĕng palang, du jêng prau jât, en du jêng pe jât.”<verse eid="MAT 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Siđăch pơq lŭh a vôq khây nĕh du camvŭm prŭp ndây, pành: “Daq Trôq gĕh prŭp dân ca du mvu vrŏh sitil yăh sŭng mơ nơm de. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Cồ canŏq sŭng lăm vu vĭq, tamun chŏl sĭq vlâq nĕh tât en vrŏh canji hwang lăp sŭng mơ va en saq ntrăch. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Lăm tơm va hao măq en lŭh ncao, nŏq canji hwang khoi gĕh pri lŭh. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Lăm vrêq, khây dĭch năc nơm mơ nŏq de, lăm saq tât, gĕh nhai bây nĕh: ‘Ơ cô nơm nhi, đăng gal cô gĕh swây sitil yăh sŭng mơ nơm de uy? Canŏq canji hwang lŭh u vi lây?’ <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />A heq nơm nhi nhai bây khây nĕh: ‘Du mvu tăm chŏl gĕh ôp vrŭq heq.’ En khây dĭch năc nhai bây nĕh: ‘Canŏq, cô gĕh cơnh lăm saq lŭh nŏq, khananh rơq lĕq canji nŏq hẩng?’ <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Cồ canŏq nơm nhi âh: ‘Vâng, phŭng sŭng lăm rơq canji hwang, khamay rơq tơm va lawân bây canji hwang nggưt. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Căh chĕq an lĕq var maq gĕh tăm hao măq an tât lăm jwŏq, en sŭng lăm jwŏq, ănh săng khây tamun jwŏq: Lor lĕq, vatom canji hwang sĭq vlâq en tănchăp khây nĕh lŭh a poq chĕq sŏh khây nĕh chĕq, cồ canŏq, căh vatom va lăp sŭng nâm ănh de.’”<verse eid="MAT 13:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Siđăch pơq lŭh a vôq khây nĕh du camvŭm prŭp ndây, pành: “Daq Trôq nŏq dân ca du nggrăp pai savi cồ lăm nhŭp, du mvu gĕh swây sŭng mơ nơm de; <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />en nggrăp sitil nŏq pành cồ ken dông lĕq sŭng lĕq khây sinlơ nggrăp, cồ canŏq lăm nĕh hao măq, nĕh măq dông khây sinlơ chhơ sŭng rông en gĕh jêng du tơm chhơ, chĕq tât daq sŭm khlang păr tât bây ôp nsôm vlơ khây singging nĕh de.” <verse eid="MAT 13:32" /><verse number="33" style="v" sid="MAT 13:33" />Siđăch đơm an khây nĕh du camvŭm prŭp ndây: “Daq Trôq dân ca tape cồ lăm nhŭp, tamun ur văt valâm bây pe goq vanĭh an tât lăm lĕq vanĭh lĭq hao.”<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Siđăch Yêsu gĕh nhai ăp sinlơ nŏq bây mintan con văl a camvŭm prŭp, en Nĕh đăng nhai sinlơ lây bây khây nĕh nŏq đăng don camvŭm prŭp, <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Ôp bơh năm an camvŭm cồ gĕh nhai găn cô tiêng tri gĕh jêng, pành:</para>
  <para style="q" vid="MAT 13:35">“Ănh gĕh pơq mŭnh Ănh a khây camvŭm prŭp.</para>
  <para style="q" vid="MAT 13:35">Ănh gĕh nhai lŭh khây sinlơ cồ gĕh prăp sưt a lăm tatao dưnya.”<verse eid="MAT 13:35" /></para>
  <para style="b" />
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Alưr nŏq, lăm saq ntrăch mintan con văl gŏq săq, Siđăch saq lăp nhi. Khây con tuyh Siđăch de tât mơch Nĕh, nhai: “Wĭnh nhai dân an khananh camvŭm prŭp sĭq canji hwang sŭng mơ.” <verse eid="MAT 13:36" /><verse number="37" style="v" sid="MAT 13:37" />Vrêq heq, lăm âh camvŭm, Siđăch nhai: “Nĕh cồ vrŏh sitil yăh cồ Con Tamun, <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />en mơ nŏq cồ dưnya, hôm sitil yăh — heq cồ con sinau Daq Trôq. Palâq sĭq vlâq, canji hwang cồ con sinau văl chin'hâc de, <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />en tamun chŏl, cồ tamun gĕh vrŏh canji nŏq, cồ chaq sŭq. Hôm khây jwŏq va nŏq cồ năr chôch dưnya, en khây tamun jwŏq cồ khây con gŭn. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Canŏq, canji hwang gĕh vatom sĭq vlâq en gĕh sŏh sŭng ŭnh bơh năm, nŏq vrŭq khoi gĕh ôp lŭh canŏq sŭng dŏq chôch dưnya. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Con Tamun sẽ pađăr khây con gŭn nơm de, en khây nĕh vatom lŭh ntrăch Daq Trôq Siđăch de lĕq khây păch cồ ôp tachĭh jâng nggâm khây tamun ôp vrŭq đăng ravwŏq. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />En khây con gŭn hwât khây nĕh lăp sŭng tanlô ŭnh, cồ gatŭq gĕh sinlơ nhim rơp bây kiêr sêch. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Lăm nŏq, khây tamun yăh sŏng silang sindraq dân ca măt năr sŭng Daq Trôq Vap khây nĕh de. Vu lây gĕh tôr, căh chăng.”<verse eid="MAT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“Daq Trôq dân ca păch caya gĕh tâp sŭng du lôq mơ, en du mvu tĭq lăm wŏng sây păch caya nŏq tăm pôn chĕq. Lŭh a sinlơ vui hơn nơm de, nĕh nŏq hao trong, tăch lĕq jrŏh khây păch cồ nơm gĕh en vro lôq mơ nŏq. <verse eid="MAT 13:44" /><verse number="45" style="v" sid="MAT 13:45" />Hôm wŏq, Daq Trôq dân ca du mvu, cồ tamun tăch vro saq wŏng gŏch yăh chhât jên. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Canŏq en, lăm wŏng vlam du nggrăp gŏch yăh chhât jên, nŏq lăm lŭh saq, nĕh tăch lĕq jrŏh khây păch cồ nĕh gĕh en vro gŏch nŏq.<verse eid="MAT 13:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />Hôm wŏq, Daq Trôq dân ca du lâm yŭq gĕh hwât jưr daq lênh en đưc hao lôch khây sinlơ, <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />en lăm yŭq vênh ca en, vu đưc lăp vâr daq, en lăm gŭq jưr, khây nĕh vatom khây păch yăh chĕq lăp sŭng gasop vadâng, hôm khây păch đăng yăh, vu hwât lŭh ling. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Ăp vrŭq gĕh dân canŏq sŭng dâq chôch dưnya: Lăm nŏq khây con gŭn saq lŭh, en paklăh văl chin'hâc lŭh ntrăch a sŭng khây tamun yăh sŏng, <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />en con gŭn hwât khây nĕh nŏq lăp tanlô ŭnh, cồ gatŭq gĕh sinlơ nhim rơp bây kiêr sêch. <verse eid="MAT 13:50" /><verse number="51" style="v" sid="MAT 13:51" />Pôp ŏh gĕh dân lĕq khây sinlơ heq hôm?” Khây con tuyh âh bây Siđăch: “Gĕh dân.”<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Vrêq heq, Siđăch nhai bây khây nĕh: “Payh ơ vrŭq heq, ăp gru pađau ravwŏq gĕh pađau an gưt sĭq Daq Trôq, nŏq nĕh dân ca du mvu nơm nhi, cồ tamun nhŭp lŭh păch dâm bây păch me u sŭng nâm nơm de.” <verse eid="MAT 13:52" /><verse number="53" style="v" sid="MAT 13:53" />Vrŭq gĕh ôp lŭh nŏq cồ lăm Siđăch Yêsu nhai sŏng khây camvŭm prŭp heq, Siđăch saq ntrăch a gatŭq nŏq.<verse eid="MAT 13:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 13:54" />Lăm sĭq tât palây mê dĕh nơm de, Siđăch pađau tămti con văl sŭng nhi vatom khây nĕh de, tât daq ôp an khây nĕh chăng camhŏq bây nhai: “Sinlơ vanŏh heq nggâm khây păch chin'hâu a tamun heq lŭh u vi lây? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Đăng gal Nĕh heq cồ con klô tamun ôp mvưt mvơ chhơ uy? Đăng gal mê Nĕh gĕh cuôl pành Ma-ri, en khây ŏh klô Nĕh de cồ Ya-cơ, Yô-sep, Si-môn nggâm Yu-đe uy? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Đăng gal lĕq khây ŏh ur Nĕh de khoi gŭq bây vơn heq uy? Canŏq, ăp vrŭq heq cồ Nĕh gĕh lŭh a vi lây?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />En khây nĕh tachĭh jâng payh ơ Siđăch, cồ canŏq Siđăch Yêsu nhai bây khây nĕh: “Tiêng tri đăng gĕh vu deng dêh hôq, ayh u palây mê dĕh nơm de bây sŭng caniêp nơm de deng dêh vŏq.” <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Siđăch đăng ôp gŏq păch chin'hâu u nŏq payh ơ nuih talaq đăng tôq khây nĕh de.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Sŭng khây mva nŏq, vatau ken Hê-rôt chăng lơ sĭq Siđăch Yêsu. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />Vatau nhai bây khây dĭch năc nĕh de: “Nŏq cồ Yăng Bap-tit. Nĕh nŏq gĕh cuôl tao rĭh sĭq vlâq a gatŭq chưt, en payh canŏq, khây vrŭq gŭn măn gĕh ôp u sŭng tamun heq.” <verse eid="MAT 14:2" /><verse number="3" style="v" sid="MAT 14:3" />Mvăc Hê-rôt, lăm nhŭp Yăng en, an tănchăp nĕh en trăng lăp nhi jingo, payh ơ Hê-rô-đia, si-ur Phi-lip, ŏh klô vatau de. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Mvăc Yăng gĕh nhai bây vatau: “Sĭq maq vatau, đăng gĕh an sai ur nŏq.” <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />En cồ gĕh cơnh tachưt Yăng, vatau phŭng con văl, mvăc khây nĕh sên Yăng dân ca du tiêng tri. <verse eid="MAT 14:5" /><verse number="6" style="v" sid="MAT 14:6" />Cồ canŏq, lăm tât war sa hơn năr dĕh Hê-rôt de, con ur Hê-rô-đia nchhât tao răm u sŭng war sa en ôp săh nuih talaq Hê-rôt, <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />payh canŏq, vatau gĕh pănggân nggâm bây du camvŭm raq săq chĕq paq an con ur nŏq hê nĕh cơnh wĭnh păch lây. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Vrêq heq, lăm lor nŏq gĕh mê săng pađau nơm, con ur âh: “Wĭnh an con iưn sŏng u heq, camvôq Yăng Bap-tit de chĕq a vlơ thaih.” <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />En cồ chăng yưr nuih lŭng, cồ canŏq payh ơ camvŭm raq săq nơm de bây khây chăm tamuôi tăm gŭq sa, vatau lŭh camvŭm chĕq con ur nŏq gĕh paq an. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Lăm pađăr vu saq, vatau an păh camvôq Yăng sŭng nhi jingo. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Camvôq nĕh de gĕh văt tât chĕq vlơ thaih en gĕh dơp an con ur, en nĕh văt dơp an mê nơm. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Lăm lăp tât en, khây con tuyh Yăng de nhŭp rup swan en tâp nĕh. En lăm saq tât, khây nĕh đơm sĭq vlâq an Siđăch Yêsu.<verse eid="MAT 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Vrêq heq, lăm chăng en, Siđăch Yêsu saq ntrăch a nŏq sŭng du tong duq lăm sĭq tu vi singot gŭq ayh du mvu. Mvăc chăng gưt canŏq, khây mintan con văl a khây palây saq jâng tât bây Siđăch. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />En lăm lŭh saq, Siđăch sây du mintan tamun gŏq săq, nŏq lêch nuih sinđach khây con văl en Siđăch jâc an yăh khây tamun ji râng khây nĕh de. <verse eid="MAT 14:14" /><verse number="15" style="v" sid="MAT 14:15" />Vrêq heq, lăm tât mau jingo en, khây con tuyh tât bây Siđăch, nhai: “Gatŭq heq singot, en vrêq heq cô lĕq mau en, wĭnh Cô an con văl saq sĭq chĕq lăm tât khây palây en, khây nĕh vro gĕh an nơm păch sa.” <verse eid="MAT 14:15" /><verse number="16" style="v" sid="MAT 14:16" />Aheq Siđăch Yêsu nhai bây khây con tuyh: “Khây nĕh đăng gĕh sinlơ lây chĕq saq lĕq. Pôp ŏh căh an khây nĕh sa.” <verse eid="MAT 14:16" /><verse number="17" style="v" sid="MAT 14:17" />Lăm nŏq, khây nĕh âh bây Siđăch: “U heq khananh đăng gĕh păch lây aling prăm lâm bănh nggâm var lâm ca vŏq.” <verse eid="MAT 14:17" /><verse number="18" style="v" sid="MAT 14:18" />En Siđăch săng: “Văt khây păch nŏq tât heq an Ănh.” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />En lăm săng mintan con văl gŭq jưr a vlơ canji, lăm văt prăm lâm bănh nggâm var lâm ca, Siđăch tămhơch hao vlơ trôq, may mo, en gĭq lŭh, Nĕh dơp păch sa an khây con tuyh, hôm khây con tuyh tăm paq an mintan con văl. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Lĕq săq văl ganơ gĕh sa bây gĕh hơm talaq. En vu dônh păch canăh sĭq vlâq a khây vŭm bănh lêch — gĕh mât var goq vênh. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Lăm vrêq, tamun sa gĕh mơch prăm ravu ndu tamun klô, ndŏh cơp tamun ur bây con se.<verse eid="MAT 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Sŏng lăm nŏq, Siđăch payĕq khây con tuyh saq lăp sŭng duq en saq lor siđăch tât vâr daq maq tĭq, sŭng lăm Nĕh an con văl saq sĭq. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Lăm an con văl sĭq en, Siđăch saq hao vlơ gŭng chĕq vơu ngwân ayh Nĕh. Tât mau jingo, Siđăch gŭq u nŏq du mvu. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Hôm duq lĕq lŭh tât vlăc canđal daq lênh en nŏq vlam daq rapăn pâm păndĕh păndăp mvăc chhal khlôm palâq. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />Lăm vrêq, sŭng mơch vadâq di puôn măng nŏq, Siđăch tât bây khây nĕh, lăm saq jâng vlơ daq lênh. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Cồ canŏq, lăm sây Siđăch pơq jâng saq vlơ daq lênh, nŏq khây con tuyh phŭng nrat, nhai pành: “Nŏq cồ camhôch,” en khây nĕh sec hao sŭng sinlơ phŭng candŭh. <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />Aheq, sŏng lăm nŏq Siđăch Yêsu pơq mŭnh nhai bây khây nĕh pành: “Kram nuih vồh! Cồ Ănh heq. Vâng phŭng vầy!” <verse eid="MAT 14:27" /><verse number="28" style="v" sid="MAT 14:28" />Vrêq heq, lăm âh sĭq vlâq Siđăch, Phi-e-rơ nhai: “Cŭh Siđăch, hê cồ Gru, wĭnh lŭh camvŭm an ănh saq vlơ daq tât bây Gru.” <verse eid="MAT 14:28" /><verse number="29" style="v" sid="MAT 14:29" />En Siđăch nhai: “Saq tât heq vồh.” En lăm pơq jâng lŭh ntrăch a duq, Phi-e-rơ gĕh pơq jâng saq vlơ daq chĕq tât bây Siđăch Yêsu. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Cồ canŏq, lăm sây chhal camhlăng, nĕh phŭng candŭh, en lăm mơch nruq jưr, nĕh sec hao, pành: “Ơ Cô Voq, wĭnh yơt ănh!” <verse eid="MAT 14:30" /><verse number="31" style="v" sid="MAT 14:31" />Sŏng lăm nŏq, lăm ntŏng ti lŭh, Siđăch Yêsu văt jơ Phi-e-rơ en nhai bây nĕh: “Ơ tamun takiq sinlơ tôq camvân, păch tơm lây nŏq pôp phŭng candŭh?” <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />Lăm khây nĕh hao vlơ duq èn, chhal krap sĭq vlâq. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Hôm khây tamun sŭng duq cŭh khwây Siđăch, pành: “Nhâng, Gru cồ Con Cô Voq de.”<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Lăm saq găn tât vâr daq maq tĭq en, khây nĕh răp lăp vâr daq u Gê-nê-sa-rêt. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Lăm singgal lŭh Siđăch, con văl u gatŭq nŏq an tamun dơp camvŭm tât lam ntĕh rawênh nŏq, en vu văt tât an Siđăch ăp ndu vlam jirâng. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Khây nĕh wĭnh Siđăch ayh chĕq an nơm baq lăp tiêng ao Nĕh de, en vu lây khoi canŏq hê baq lăp nŏq gĕh jâc yăh.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Alưr nŏq, khây tamun Pha-ri-si bây khây gru pađau ravwŏq a Yê-ru-sa-lem tât bây Siđăch Yêsu, nhai pành: <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“Lŭh khây con tuyh Gru de ôp tĭh khây ravwŏq ađơm khây cô camvĭnh de? Mvăc khây nĕh đăng rao ti lăm sa bănh.” <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />Aheq lăm âh sĭq vlâq, Siđăch nhai bây khây nĕh: “Lŭh khây cô khoi ôp tĭh ravwŏq Cô Voq de payh ơ khây ravwŏq ađơm vơn de? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Mvăc Cô Voq gĕh pân pađau, pành: ‘Căh gưt deng prĭh mê vap con de,’ en ‘Vu lây raq răh vap ha mê, căh chĕq nĕh lăp gatŭq chưt.’ <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Palâq sĭq vlâq khây cô nhai: ‘Vu lây nhai bây vap ha mê nơm: “Hê vrŭq lây cồ con ôp văt tât sinlơ yăh an mê vap, nŏq cồ păch pađăc gĕh pađăc hao an Cô Voq iưn en,”’ <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />en nĕh nŏq đăng ôp du păch yăh lây an vap nơm. Canŏq, khây cô hwât chĕq camvŭm Cô Voq payh ơ ravwŏq ađơm vơn de. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Ơ khây tamun gĕh tanrong mvâr tĭq! Ê-sai gĕh nhai lor dip lŭng sĭq khây cô, pành:<verse eid="MAT 15:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MAT 15:8" />‘Văl heq tapơ Ănh u mŭnh u lapiêt,</para>
  <para style="q" vid="MAT 15:8">sŭng lăm nuih talaq khây nĕh gŭq ngai a Ănh.<verse eid="MAT 15:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MAT 15:9" />En khây nĕh cŭh sưmvăh Ănh valây chĕq,</para>
  <para style="q" vid="MAT 15:9">lăm pađau khây ganơt cồ khây ravwŏq con tamun de.’”<verse eid="MAT 15:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="MAT 15:10" />En lăm cuôl con văl tât, Siđăch nhai bây khây nĕh: “Căh chăng en gưt dân: <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Đăng gĕh păch lây saq lăp sŭng mŭnh ôp an du mvu lŭh sŭq cavơm, palâq sĭq vlâq nŏq cồ păch a mŭnh nhai lŭh, păch heq cồ ôp an tamun nŏq sŭq cavơm.” <verse eid="MAT 15:11" /><verse number="12" style="v" sid="MAT 15:12" />Alưr nŏq, lăm tât mơch en, khây con tuyh nhai bây Siđăch: “Gru gĕh gưt pành khây tamun Pha-ri-si măq nuih lăm chăng camvŭm nŏq đăng?” <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" />Aheq lăm âh camvŭm, Siđăch nhai: “Ăp chhơ lây cồ Vap Gŭn gayh Ănh de đăng tăm gĕh rơq tât tơm rayĕh. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Valay khây nĕh chĕq! Khây nĕh cồ khây tamun iau vôq jingo măt. En hê tamun jingo măt iau trong an tamun jingo măt, nŏq lĕq var ndu vông hlŏq jưr chhŭng.” <verse eid="MAT 15:14" /><verse number="15" style="v" sid="MAT 15:15" />Vrêq heq lăm âh sĭq vlâq, Phi-e-rơ nhai bây Siđăch: “Wĭnh nhai lŭh an khananh gưt camvŭm prŭp nŏq.” <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />Aheq Siđăch nhai: “An tât lăm heq pôp ŏh khoi đăng dân gĕh uy? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Pôp ŏh ndŏh dân gĕh pành ăp sinlơ saq lăp sŭng mŭnh nŏq saq jưr talaq en gĕh hwât lŭh sŭng vi saq vri uy? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Hôm khây păch lŭh ntrăch a mŭnh lŭh a sŭng nuih talaq, en nĕh ôp an sŭq cavơm con tamun. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />En a nuih talaq văt lŭh khây sinlơ sinâng viêm vôt, tachưt tamun, nhŭp vĭq sai vu, cani camăn, can'hưn can'hlĕq, candân mvâr, nggâm khây camvŭm nhai bap. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Nŏq cồ khây păch ôp sŭq cavơm vu, hôm vrŭq sa a ti ndŏh rao đăng ôp an sŭq cavơm vu.”<verse eid="MAT 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />En lăm lŭh saq ntrăch a nŏq, Siđăch Yêsu sĭq vlâq tu khây ntĕh Ti-rơ bây Si-đôn de. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />En sên tĭq, du mvu ur tamun Ca-na-an, alưr lăm a maq ntĕh nŏq tât, gĕh cuôl wĭnh, pành: “Cŭh Siđăch, Con vatau Đa-vit, wĭnh sinđach ănh! Con ur ănh de vlam chaq khlâm lŏh sat lŭng nggơi.” <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />Cồ canŏq Siđăch đăng âh sĭq vlâq nĕh du camvŭm lây. En lăm tât mơch Siđăch, khây con tuyh ngwân wĭnh Nĕh, pành: “Wĭnh Gru săng nĕh nŏq saq chĕq, mvăc nĕh côt cĕh diêt alưr vơn.” <verse eid="MAT 15:23" /><verse number="24" style="v" sid="MAT 15:24" />Aheq lăm âh camvŭm, Siđăch nhai: “Ănh đăng gĕh pađăr tât, hê đăng gal an khây dive chroc voc sŭng nhi I-sơ-ra-ên de.” <verse eid="MAT 15:24" /><verse number="25" style="v" sid="MAT 15:25" />Cồ canŏq lăm saq tât, tamun ur nŏq chŏl nkrŭng jưr a vôq Siđăch, nhai: “Cŭh Siđăch, wĭnh lŭh ti têch yơt con.” <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />Vrêq heq, lăm âh sĭq vlâq, Siđăch nhai: “Nhŭp bănh ŏh con de en hwât an so con iưn nŏq đăng yăh.” <verse eid="MAT 15:26" /><verse number="27" style="v" sid="MAT 15:27" />Aheq tamun ur nŏq âh: “Cŭh Siđăch, gal canŏq, ayh cồ var pe lâm so con ngăn khoi gĕh sa a khây bănh lêch a vlơ nra nơm khây nĕh de tarŏh jưr ằm.” <verse eid="MAT 15:27" /><verse number="28" style="v" sid="MAT 15:28" />Lăm nŏq, chĕq âh sĭq vlâq, Siđăch Yêsu nhai bây nĕh: “Heq ơ tamun ur tĭq, sinlơ tôq camvân pôp de măq nŏq! Vrŭq gĕh jêng an pôp dân ca pôp cơnh.” En con ur nĕh de gĕh jâc yăh a lăm nŏq.<verse eid="MAT 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Lăm saq ntrăch a gatŭq nŏq, Siđăch Yêsu saq poch bây vâr daq lênh Ga-li-lê, en lăm hao vlơ vuôi tabôq en, Siđăch gŭq u nŏq. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />En khây mintan con văl gŏq săq saq hao bây Siđăch, gĕh khây tamun jâng pakheq, tamun jingo măt, tamun cannwe, tamun cammlo, bây gŏq tamun ndây nggâm bây khây nĕh. Vu chĕq khây tamun nŏq u jâng Siđăch, en Siđăch jâc yăh an khây nĕh, <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />tât daq, mintan con văl camhŏq lăm sây tamun cammlo nhai gĕh, tamun cannwe gĕh yăh, tamun jâng pakheq pơq jâng saq, en tamun jingo măt deng sây, en khây nĕh tapơ Siđăch Trôq I-sơ-ra-ên de.<verse eid="MAT 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Vrêq heq, lăm cuôl khây con tuyh nơm de tât, Siđăch Yêsu nhai: “Ănh sinđach an mintan con văl, mvăc khây nĕh gĕh gŭq lawân bây Ănh pe năr èn en đăng gĕh păch lây chĕq sa. Ănh đăng cơnh an khây nĕh sĭq talaq pangot, phŭng khây nĕh siyom vlơ trong.” <verse eid="MAT 15:32" /><verse number="33" style="v" sid="MAT 15:33" />Khây con tuyh âh bây Siđăch: “Sŭng tamăn singot nŏq păch vi lây lŭh gĕh gŏq bănh canŏq chĕq khananh an mintan con văl gŏq săq canŏq sa hơm?” <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />Siđăch Yêsu nhai bây khây nĕh: “Pôp ŏh gĕh gŏq lâm bănh?” En khây nĕh âh: “Pŏh lâm, nggâm var pe lâm ca ken.” <verse eid="MAT 15:34" /><verse number="35" style="v" sid="MAT 15:35" />En lăm săng mintan con văl gŭq jưr vlơ ntĕh, <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Siđăch văt pŏh lâm bănh nggâm var pe lâm ca, en alưr lăm may mo, Siđăch gĭq lŭh dơp an khây con tuyh, en khây nĕh tăm paq an mintan con văl. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Con văl lĕq săq sa en gĕh hơm talaq. Khây nĕh vatom pŏh la-i vênh păch canăh a khây bănh lêch. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Lăm vrêq, tamun cồ sa cơp gĕh puôn ravu ndu tamun klô, đăng cơp tamun ur bây con se. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Lăm an con văl sĭq en, Siđăch lăp sŭng duq en saq tât ntĕh Ma-ga-đan.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Lăm tât mơch, khây tamun Pha-ri-si bây Sa-đu-sê — mvăc long găn Siđăch — gĕh wĭnh Siđăch pơq an khây nĕh du păch chin'hâu a vlơ trôq. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Cồ canŏq lăm âh sĭq vlâq, Siđăch nhai bây khây nĕh: [“Lăm tât mau jingo, khây cô nhai: ‘Năr yăh, mvăc galwang trôq paho.’ <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />En lăm măng rŭq nŏq nhai: ‘Năr heq trôq chhal ramvưt, mvăc galwang trôq paho, nhâm.’ Cồ khây cô gưt paklăh trôq ntĕh, sŭng lăm đăng gưt gĕh khây sinlơ an gưt khây mva de.”] <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />“Du chhe njang chin'hâc bây cani camăn wŏng păch chin'hâu, cồ canŏq păch chin'hâu đăng gĕh paq an nĕh, aling păch chin'hâu Yô-na de.” En lăm chĕq khây nĕq sĭq vlâq èn, nŏq Siđăch saq ntrăch.<verse eid="MAT 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Hôm khây con tuyh hwĭch văt bănh bây, lăm saq tât vâr daq maq tĭq. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Lăm vrêq, Siđăch Yêsu nhai bây khây nĕh: “Căh deng sên bây chĕq măt sĭq tape tamun Pha-ri-si nggâm Sa-đu-sê de.” <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />Cồ canŏq, khây nĕh tăm nhai diêt bây ndăng ganai pành: “Nŏq cồ mvăc vơn đăng văt bây bănh.” <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />Cồ canŏq, lăm gưt vrŭq heq, Siđăch Yêsu nhai: “Ơ khây tamun takiq sinlơ tôq tĭq, lŭh pôp ŏh tăm cammlăh bây ndăng ganai pành nŏq cồ vơn đăng gĕh bănh? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Pôp ŏh khoi hôm ndŏh dân gưt bây khoi đăng căh prăm lâm bănh an prăm ravu ndu en pôp ŏh gĕh dônh vatom gĕh dâng lây la-i uy? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Ha pŏh lâm bănh an puôn ravu ndu, en pôp ŏh gĕh dônh vatom gĕh dâng lây la-i uy? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Ôp bơh năm nŏq pôp ŏh đăng dân gĕh pành Ănh đăng nhai bây pôp ŏh sĭq bănh loh? Cồ canŏq, căh chĕq măt sĭq tape tamun Pha-ri-si nggâm Sa-đu-sê de.” <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Tât lăm nŏq khây nĕh gưt dân lŭh pành Siđăch đăng săng khây nĕh chĕq măt sĭq tape bănh de, nŏq sĭq khây sinlơ pađau tămti khây tamun Pha-ri-si nggâm Sa-đu-sê de.<verse eid="MAT 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Vrêq heq, lăm saq tât ntĕh Sê-sa-rê Phi-lip, Siđăch Yêsu gĕh lŭp khây con tuyh nơm de, pành: “Vu nhai, Con Tamun cồ vu lây?” <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />En khây nĕh âh: “Gĕh khây tamun nhai pành Yăng Bap-tit; en gĕh tamun nhai pành Ê-li; sŭng lăm khây tamun ndây nhai pành Yê-rê-mi, ha muôi sŭng khây cô tiêng tri.” <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />Siđăch nhai bây khây nĕh: “Hôm pôp ŏh nhai Ănh heq cồ vu lây?” <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />Canŏq en, lăm âh camvŭm, Si-môn Phi-e-rơ nhai: “Cô cồ Candranh Yơt Dưnya, Con Siđăch Trôq hôm rĭh lawân!” <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />Vrêq heq, lăm âh sĭq vlâq, Siđăch Yêsu nhai bây nĕh: “Ơ Si-môn, con Yô-na, yăh vŏq âr an pôp, mvăc đăng gal gŏng bây n'ham pơq an pôp gưt, nŏq cồ Vap Ănh de a vlơ Daq Trôq. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Hôm Ănh khoi nhai bây pôp pành pôp cồ Phi-e-rơ, en vlơ tơm tamô heq, Ănh tatao Vatom Gŭn Ănh de, en khây lapông dưnjrang đăng chŏl sĭq vlâq gĕh Vatom nŏq. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Ănh dơp an pôp iưn khây păch krêh Daq Trôq de, hê sinlơ lây pôp tănchăp u tĕh ntĕh nŏq gĕh tănchăp vlơ Daq Trôq, en hê sinlơ lây pôp pơq u tĕh ntĕh nŏq gĕh pơq a vlơ Daq Trôq.” <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Alưr nŏq, Siđăch nhai kram đăng an khây con tuyh chĕq khây nĕh đăng nhai bây vu lây pành Nĕh cồ Candranh Yơt Dưnya.<verse eid="MAT 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />A lăm nŏq, Candranh Krit Yêsu pơq vôq an khây con tuyh nơm de gưt pành Nĕh phải saq tât Yê-ru-sa-lem, en vlam gŏq lŏh sat a khây cô camvĭnh, khây gru sipăm măq nggâm khây gru pađau ravwŏq, en vlam vu tachưt en gĕh ôp an tao rĭh sĭq vlâq sŭng năr di pe. <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />A heq, lăm đưc Siđăch lŭh tu maq, Phi-e-rơ pơq mŭnh lăh Siđăch, pành: “Ơ Cô, Siđăch Trôq pơq nuih talaq yăh bây Gru. Vrŭq nŏq đăng lăm lây văt tât an Gru hôq.” <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />Aheq lăm pale nơm sĭq vlâq, Siđăch nhai bây Phi-e-rơ: “Ơ Satan, saq cambet lŭh tu lưr Ănh! Pôp cồ tamô ôp tachĭh jâng an Ănh, mvăc pôp đăng chĕq nuih talaq sĭq khây vrŭq Cô Voq de, nŏq ayh cồ khây vrŭq con tamun de.” <verse eid="MAT 16:23" /><verse number="24" style="v" sid="MAT 16:24" />Alưr nŏq, Siđăch Yêsu nhai bây khây con tuyh Nĕh de: “Hê vu lây cơnh saq bây alưr Ănh, nŏq nĕh căh lăq chĕq nơm nĕh, tăm tung chhơ pagăn nơm de en saq bây Ănh. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Mvăc hê vu lây cơnh yơt sinlơ rĭh nơm de nŏq tarui chĕq nĕh, hôm vu lây tarui sinlơ rĭh nơm payh ơ Ănh nŏq wŏng gĕh nĕh. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Mvăc du mvu wŏq gĕh păch yăh lây lăm sŏq gĕh lĕq dưnya, sŭng lăm pachĕq sinlơ rĭh nơm de? Ha du mvu an păch lây sŭng vrŭq gâl sĭq vlâq sinlơ rĭh nơm de? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Mvăc Con Tamun mơch tât sŭng sindraq sindil Vap Nĕh de nggâm bây khây con gŭn Nĕh, en sŭng lăm nŏq, Siđăch trŏh an ăp ndu bây vrŭq ôp khây nĕh de. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Nhâng, Ănh nhai bây pôp ŏh pành gĕh khây tamun tao yăq u heq, cồ khây tamun nhâng bâng đăng vlam sinlơ chưt an tât lăm lây khây nĕh sây Con Tamun tât sŭng daq Nĕh de.”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Prau năr a lưr, Siđăch Yêsu văt bây Phi-e-rơ, nggâm Ya-cơ bây Yăng, cồ ŏh nĕh, en Siđăch iau ayh khây nĕh tăm simơ hao tât du vwây gŭng prĭh. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Maq ling Siđăch de gĕh wâr nơm a vôq măt khây nĕh, en măt Nĕh sol dân ca măt năr, hôm ao Nĕh gĕh jêng sindraq dân ca silang. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />En sên tĭq, Môi-se nggâm Ê-li phưt lŭh a vôq khây nĕh, nhai păch bây Siđăch. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Vrêq heq, lăm pơq camvŭm, Phi-e-rơ nhai bây Siđăch Yêsu: “Cŭh Siđăch, yăh lŭng an vơn lăm gŭq u heq. Hê Gru cơnh, ănh tatao u heq pe lâm vadai — du lâm an Gru, du lâm an Môi-se en du lâm an Ê-li.” <verse eid="MAT 17:4" /><verse number="5" style="v" sid="MAT 17:5" />Sŭng lăm nĕh hôm nhai, en sên tĭq, du lawang tŭq silang vrưng tang khlop khây nĕh, en sên heq, du camvŭm nhai u sŭng lawang tŭq, pành: “Heq cồ Con sinđach Ănh de, cồ Ănh rom nuih talaq u Con. Căh chăng bây Con nŏq.” <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />Lăm chăng en, khây con tuyh vông gasưt măt, bây phŭng candŭh vyăq lŭng. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />En Siđăch Yêsu, lăm saq tât mơch en baq lăp khây nĕh, gĕh nhai: “Tao yăq vồh, bây vâng phŭng candŭh vầy.” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Cồ canŏq lăm pơq măt vơn de tămhơch hao, khây nĕh đăng sây vu lây aling du mvu Siđăch Yêsu.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Sŭng lăm khây nĕh a vlơ gŭng saq jưr. Siđăch Yêsu lŭh camvŭm an khây nĕh, pành: “Vâng đơm sĭq vlâq sinlơ gĕh sây heq bây vu lây an tât lăm Con Tamun gĕh tao rĭh sĭq vlâq a gatŭq chưt.” <verse eid="MAT 17:9" /><verse number="10" style="v" sid="MAT 17:10" />Khây con tuyh nŏq lŭp Siđăch, pành: “Canŏq lŭh khây gru pađau ravwŏq nhai pành Ê-li phải tât lor lŏh?” <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />Vrêq heq, lăm âh camvŭm, Siđăch nhai: “Nhâng Ê-li nhâng tât en ôp sĭq vlâq ăp vrŭq. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Cồ canŏq Ănh nhai bây pôp ŏh pành Ê-li gĕh tât èn, en khây nĕh đăng singgal lŭh nĕh. Ala lăp nŏq, khây nĕh ôp lôch sinlơ cồ khây nĕh cơnh bây Ê-li. Khoi dân canŏq, Con Tamun mơch vlam lŏh sat payh ơ khây nĕh.” <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Lăm nŏq, khây con tuyh gưt dân pành Siđăch nhai bây khây nĕh sĭq Yăng Bap-tit.<verse eid="MAT 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Lăm tât bây mintan con văl en, du mvu tamun klô tât mơch Siđăch, chŏl nkrŭng jưr a vôq Siđăch <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />bây nhai: “Ơ Siđăch, wĭnh sinđach con klô ănh de, mvăc nĕh ji nrui en ji canhjŏq lŭng nggơi, mvăc nĕh uĕh tavông lăp sŭng ŭnh, bây uĕh tarŏh jưr daq. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Ănh gĕh văt nĕh tât an khây con tuyh Cô de, cồ canŏq khây nĕh đăng lôch prơn chĕq jâc yăh an nĕh.” <verse eid="MAT 17:16" /><verse number="17" style="v" sid="MAT 17:17" />Vrêq heq, lăm âh sĭq vlâq, Siđăch Yêsu nhai: “Ơ chhe njang đăng tôq bây chroc voc tĭq, Ănh gŭq bây khamay an tât lăm lây heq? Văq nong khamay an tât dâng lây heq? Văt con se nŏq tât heq an Ănh.” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Siđăch Yêsu chĭh lăh chaq, nŏq chaq saq lŭh ntrăch a con se, en nĕh gĕh jâc yăh a lăm nŏq.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Alưr nŏq, lăm tât ayh bây Siđăch Yêsu, khây con tuyh nhai: “Păch tơm tu lây nŏq khananh đăng dăh chaq nŏq lŭh gĕh?” <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" />En Siđăch nhai bây khây nĕh: “Payh ơ sinlơ tôq takiq pôp ŏh de. Mvăc nhâng, Ănh nhai bây pôp ŏh, hê pôp ŏh gĕh sinlơ tôq dân ca nggrăp pai savi, nŏq pôp ŏh nhai bây vwây gŭng heq: ‘Nre a gatŭq heq tât gatŭq tĭq,’ nŏq nĕh nre saq, en đăng gĕh păch lây pành ôp đăng gĕh an pôp ŏh.” <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />[Cồ canŏq, sinlơ chaq heq đăng dăh gĕh hê đăng don sinlơ vơu ngwân bây ât sa.]<verse eid="MAT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Vrêq heq, sŭng lăm khây con tuyh vatom sĭq vlâq u Ga-li-lê, Siđăch Yêsu nhai bây khây nĕh: “Con Tamun mơch gĕh dơp lăp sŭng ti vu, <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />en khây nĕh tachưt Nĕh chĕq, en sŭng năr di pe, Nĕh gĕh ôp an tao rĭh sĭq vlâq.” Khây con tuyh jêng jưr nuih vyăq lŭng.<verse eid="MAT 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Lăm nŏq, lăm khây nĕh saq tât palây Ca-bê-na-ŭm, khây tamun wŏq jên pâng ya nhi Cŭh tât bây Phi-e-rơ en lŭp: “Gru pôp de đăng pâng ya an nhi cŭh uy?” <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />Phi-e-rơ âh pành: “Gĕh”. En lăm lăp sŭng nhi, Siđăch Yêsu pơq mŭnh bây nĕh lor pành: “Ơ Si-môn, pôp sinâng păch lây canŏq? Khây vatau vlơ ntĕh wŏq jên ha ya a vu lây? A ŏh con khây nĕh ha a tamun u ling?” <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />Lăm âh camvŭm: “A tamun u ling.” Siđăch Yêsu nhai bây nĕh: “Canŏq ŏh con gĕh gŭq ngăn. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Cồ canŏq chĕq khây nĕh đăng tachĭh jâng payh ơ vơn, nŏq lăm saq lŭh tu daq lênh, pôp căh trŏh candar en đưc vanông ca vôq lĕq hao. Lăm tahaq mŭnh nĕh lŭh, pôp sây gĕh du păndŏh jên. Nhŭp gĕh jên nŏq en, căh pâng an khây nĕh lôch an Ănh bây pôp.”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Sŭng vadâq nŏq, khây con tuyh tât mơch Siđăch Yêsu, nhai: “Chôch lĕq nŏq vu lây cồ măq dông lĕq sŭng Daq Trôq?” <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />En lăm cuôl du lâm con se tât bây nơm, Siđăch chĕq nĕh u vlăc canđal khây nĕh <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />en nhai: “Nhâng, Ănh nhai bây pôp ŏh, hê pôp ŏh đăng gĕh pagâl sĭq vlâq bây jêng dân ca khây con se, nŏq nhâng bâng pôp ŏh đăng lăp sŭng Daq Trôq gĕh. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Canŏq, lĕq vu lây tănjưr nơm jưr dân ca con se heq, nĕh nŏq cồ măq dông lĕq sŭng Daq Trôq. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Hê vu lây cuôl săq Ănh wŏq du lâm con se dân ca heq, nĕh nŏq wŏq roc Ănh. <verse eid="MAT 18:5" /><verse number="6" style="v" sid="MAT 18:6" />Cồ canŏq vu lây ôp tachĭh jâng an muôi sŭng khây con se heq, nŏq cồ khây tamun tôq u Ănh, nŏq vrŭq yăh dông an nĕh nŏq cồ du lâm lapăl tamô cồ chĕq an asĕh răch gĕh wân rawênh nco nĕh, en nĕh gĕh gatŏq lĭch jru jưr daq lênh.<verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />Lŏh sat âr an dưnya payh ơ khây păch ôp an tachĭh jâng! Mvăc khây păch ôp an tachĭh jâng phải tât cồ sinlơ đăng plĕh gĕh, cồ canŏq, lŏh sat âr an tamun cồ sinlơ tachĭh jâng tât a nĕh! <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />En vrêq, hê ti ha jâng pôp ŏh de ôp an pôp ŏh tachĭh, căh păh hwât nĕh en tabayh ngai ntrăch a pôp ŏh. Nŏq cồ sinlơ yăh an pôp ŏh chĕq vlam cut ti ha cannwe jâng en gĕh lăp sŭng sinlơ rĭh vlơ a lăm gĕh var ti ha var jâng chĕq bị hwât lăp sŭng ŭnh gơih nggơih. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Hê măt pôp ŏh ôp an pôp ŏh tachĭh, căh kweq nĕh lŭh en hwât ngai ntrăch a pôp ŏh. Nŏq cồ sinlơ yăh an pôp ŏh chĕq hôm ayh du lâm măt nŏq gĕh lăp sŭng sinlơ rĭh, vlơ a lăm gĕh var lâm măt mà bị hwât lăp sŭng tanlô ŭnh. <verse eid="MAT 18:9" /><verse number="10" style="v" sid="MAT 18:10" />Căh chĕq măt, pôp ŏh vâng deng dêh muôi sŭng khây tamun ken heq. Mvăc Ănh nhai bây pôp ŏh pành khây con gŭn khây nĕh de a vlơ trôq wân lawân deng sây măt Vap Ănh vlơ Daq Trôq. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />[Mvăc Con Tamun gĕh tât chĕq yơt tamun chroc voc.] <verse eid="MAT 18:11" /><verse number="12" style="v" sid="MAT 18:12" />Pôp ŏh sinâng bơh năm? Hê du mvu nŏq gĕh du rayĕng lâm dive, en muôi sŭng khây dive nŏq saq chroc, nŏq đăng gal lăm chĕq sĭq vlâq sưn jât sưn lâm vlơ tabôq en hao trong, nĕh nŏq saq wŏng miêng dive cồ chroc uy? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Hê tamun nŏq wŏng vlam gĕh dive, nŏq nhâng, Ănh nhai bây pôp ŏh pành nĕh nŏq vui hơn sĭq dive nŏq vlơ a sĭq sưn jât sưn lâm dive cồ đăng saq chroc. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Khoi dân canŏq, nuih cơnh a vôq măt Vap vlơ Daq Trôq pôp ŏh de đăng gal cồ chĕq an muôi sŭng khây tamun ken heq chưt cambet.<verse eid="MAT 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />En, Hê du mvu ganai ur klô pôp ŏh de ôp bưn bap bây pôp ŏh, nŏq căh saq, chĭh lăh nĕh lăm gĕh ayh pôp ŏh bây nĕh nŏq vŏq en. Hê nĕh nŏq chăng bây pôp ŏh, nŏq pôp ŏh gĕh sĭq vlâq ganai ur klô nơm de. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Cồ canŏq hê tamun nŏq đăng chăng bây, căh iau bây nơm muôi ha var ndu wŏq, chĕq an payh ơ mŭnh var ha pe ndu ôp candân nŏq ăp camvŭm gĕh candân. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Hôm hê nĕh nŏq hwây vôq đăng chăng bây khây nĕh, nŏq căh nhai an Vatom Gŭn gưt. En hê nĕh nŏq khoi đăng chăng bây Vatom Gŭn, nŏq bây pôp ŏh, nĕh nŏq nhâng gĕh sên dân ca văl daq aling, bây tamun nhŭp jên pâng ya. <verse eid="MAT 18:17" /><verse number="18" style="v" sid="MAT 18:18" />Nhâng, Ănh nhai bây pôp ŏh, hê pôp ŏh tănchăp ăp sinlơ lây u tĕh ntĕh, sinlơ nŏq gĕh tănchăp a vlơ trôq; en hê pôp ŏh pơq ăp sinlơ lây u tĕh ntĕh, sinlơ nŏq gĕh pơq a vlơ trôq. <verse eid="MAT 18:18" /><verse number="19" style="v" sid="MAT 18:19" />Du dâq wŏq, nhâng, Ănh nhai bây pôp ŏh pành hê var ndu sŭng pôp ŏh tăm du nuih talaq bây ndăng ganai u ntĕh sĭq ăp sinlơ lây cồ hê khây nĕh cuôl wĭnh, sinlơ nŏq gĕh ôp jêng an khây nĕh payh ơ Vap Ănh de a vlơ Daq Trôq. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Mvăc gatŭq lây gĕh var ha pe ndu gĕh vatom sĭq vlâq sŭng săq Ănh, nŏq Ănh gŭq u nŏq sŏng vlăc canđal khây nĕh.”<verse eid="MAT 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />A lưr nŏq, lăm tât mơch, Phi-e-rơ nhai bây Siđăch: “Cŭh Siđăch, du mvu sŭng pôp ŏh ănh ôp tĭh chŏl sĭq vlâq ănh en ănh hwât chĕq an nĕh gŏq dâq? Gal an di tât pŏh dâq hẩng?” <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" />Siđăch Yêsu nhai bây nĕh: “Ănh đăng nhai bây pôp tât pŏh dâq, nŏq tât pŏh jât pŏh dâq. <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />Payh ơ tu tơm heq, Daq Trôq gĕh pành ŭp dân ca du mvu ôp vatau, en nĕh cơnh sên sirăq chêr se dôih bây khây dĭch năc nĕh de. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Vrêq heq, lăm vatau pơq vôq sên sirăq, du mvu tăm văc se mât ravu talâng gĕh têch tât an vatau. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Cồ canŏq nĕh nŏq đăng lôch prơn chĕq trŏh, nŏq vatau lŭh camvŭm săng nĕh tăch nơm nĕh, nggâm si-ur, con bây lĕq sŏh prŏh ăp sinlơ cồ nơm gĕh, en trŏh se. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />Canŏq en lăm vông gasăp nơm jưr, dĭch nŏq chŏl nkrŭng a vôq vatau, nhai: ‘Ơ cô, wĭnh mbêr nuih bây ănh, en ănh nhâng trŏh sĭq vlâq an cô lĕq săq.’ <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Vrêq heq, payh ơ lêch nuih sinđach, nơm dĭch nŏq de an nĕh saq bây hwât chĕq se dôih an nĕh. <verse eid="MAT 18:27" /><verse number="28" style="v" sid="MAT 18:28" />Aheq lăm lŭh tu ling en, nĕh cồ dĭch nŏq vlam muôi sŭng khây ndăng dĭch bây nơm, cồ tamun tăm văc se nĕh du rayĕng đơ-ni-ê, en lăm nhŭp rawiq tamun nŏq, nĕh rêt nco, nhai: ‘May tăm văc se lây nŏq trŏh chĕq.’ <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />Canŏq en, lăm chŏl nkrŭng jưr, nĕh cồ ndăng dĭch bây nĕh côt cĕh nĕh, pành: ‘Wĭnh mbêr nuih bây ănh, en ănh nhâng trŏh sĭq vlâq an pôp.’ <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />Cồ canŏq nĕh đăng êq. Palâq sĭq vlâq, lăm hao trong, nĕh an trăng nĕh tĭq lăp nhi jingo an tât lăm nĕh trŏh jên tăm văc. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Canŏq, lăm sây vrŭq gĕh ôp lŭh, khây ganai ndăng dĭch nĕh de ji nuih lŭng. Lăm tât mơch en, khây nĕh đơm lĕq bây nơm khây nĕh de ăp vrŭq cồ gĕh ôp lŭh. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Alưr nŏq, lăm lŭh camvŭm văt păch cồ dĭch nŏq tât, nơm nĕh de nhai bây nĕh pành: ‘Ơ nĕh cồ dĭch năc chin'hâc tĭq, ănh gĕh hwât lĕq se dôih nŏq an may mvăc may gĕh côt cĕh wĭnh ănh. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Vrŭq khoi căh ôp an may đăng gal pành sinđach ganai ndăng dĭch bây nơm, khoi dân ca ănh gĕh sinđach may uy?’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Mvăc bị lŏq an măq nuih canŏq, nơm nĕh de dơp nĕh an tamun jơ nhi jingo, an tât lăm lây nĕh trŏh lĕq ăp sinlơ se dôih. <verse eid="MAT 18:34" /><verse number="35" style="v" sid="MAT 18:35" />Vap gŭn gayh Ănh de khoi ôp an pôp ŏh dân canŏq, hê ăp ndu sŭng pôp ŏh đăng hwât chĕq bưn bap an pôp ŏh vơn de lŭh a nuih talaq nơm.”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Vrŭq gĕh ôp lŭh cồ lăm Siđăch Yêsu nhai sŏng khây camvŭm nŏq, Siđăch lŭh ntrăch Ga-li-lê en saq tât ntĕh Yu-đê u maq tŏq phong Yô-đanh. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Khây mintan con văl gŏq săq saq bây Siđăch en Nĕh jâc ji râng an khây nĕh u nŏq.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Khây tamun Pha-ri-si saq tât mơch Siđăch, long găn Nĕh en nhai: “Gĕh ha đăng gĕh an du mvu tamun klô lăq chĕq si-ur nơm payh ơ du tu tơm lây?” <verse eid="MAT 19:3" /><verse number="4" style="v" sid="MAT 19:4" />Lăm âh camvŭm, Siđăch nhai: “Khây cô ndŏh đŏc pành Candranh sun răq a lăm daq vôq gĕh ôp jêng khây nĕh, du mvu klô bây du mvu ur, <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />bây nhai: ‘Payh ơ tu tơm nŏq, tamun klô lŭh ntrăch a mê bây vap chĕq gŭq saq tăm simơ bây si-ur nơm, en var ndu jêng ayh du rup uy’? <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Tât daq, khây nĕh đăng hôm cồ var ndu wŏq, nŏq ayh du gŏng vŏq. Payh canŏq, sinlơ cồ Cô Voq gĕh păng grop sĭq vlâq, nŏq con tamun đăng gĕh paklăh.” <verse eid="MAT 19:6" /><verse number="7" style="v" sid="MAT 19:7" />Khây nĕh nhai bây Siđăch: “Canŏq, lŭh Môi-se gĕh pân pađau dơp sirăq lăq chĕq en hwât chĕq si-ur lòh?” <verse eid="MAT 19:7" /><verse number="8" style="v" sid="MAT 19:8" />Siđăch nhai bây khây nĕh pành: “Mvăc sinlơ kranh talaq khây cô de nŏq Môi-se gĕh an khây cô lăq chĕq si-ur nơm, sŭng lăm a daq vôq, vrŭq nŏq đăng gal cồ canŏq. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Cồ canŏq Ănh nhai bây khây cô pành aling payh ơ bưn bap cani camăn, vu lây lăq chĕq si-ur nơm en sai tamun ndây nŏq văq bap cani camăn; en nĕh cồ sai ur vlam lăq chĕq nŏq khoi văq bap cani camăn.” <verse eid="MAT 19:9" /><verse number="10" style="v" sid="MAT 19:10" />Khây con tuyh nhai bây Siđăch: “Hê vrŭq gŭq saq tamun klô de bây si-ur nơm cồ canŏq, nŏq yăh vlơ đăng tăm sai.” <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" />Aheq Siđăch nhai bây khây nĕh: “Đăng gal lĕq săq wŏq gĕh camvŭm heq, cồ canŏq nĕh chĕq an khây vu lây cồ sinlơ nŏq gĕh paq an. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Mvăc gĕh khây tamun lĕh, cồ khây tamun gĕh dĕh lŭh a sŭng talaq mê gĕh canŏq en, gĕh khây tamun lĕh mvăc vlam vu ôp an lĕh; en gĕh khây tamun lĕh mvăc khây nĕh lĕh nơm vơn payh ơ Daq Trôq. Vu lây wŏq gĕh camvŭm heq, nĕh nŏq căh wŏq.”<verse eid="MAT 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Alưr nŏq, khây con se ken gĕh văt tât an Siđăch chĕq Siđăch lăq ti vlơ khây nĕh bây vơu ngwân, cồ canŏq khây con tuyh chĭh lăh khây nĕh. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Aheq, Siđăch Yêsu nhai: “Căh chĕq an khây con se tât bây Ănh, bây vâng pŏh khăq khây nĕh, mvăc Daq Trôq sĭq maq khây vu lây dân canŏq.” <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Lăm lăq ti vlơ khây nĕh en, Siđăch a nŏq lŭh saq.<verse eid="MAT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />En sên tĭq, du mvu tĭq lăm tât mơch Siđăch, gĕh nhai: “Ơ Gru, ănh phải ôp vrŭq yăh lây chĕq ănh wŏq gĕh sinlơ rĭh gơih nggơih?” <verse eid="MAT 19:16" /><verse number="17" style="v" sid="MAT 19:17" />En Siđăch nhai bây nĕh: “Lŭh pôp lŭp Ănh sĭq vrŭq ôp yăh? Gĕh ayh du Candranh cồ yăh soch, hôm hê pôp cơnh lăp sŭng sinlơ rĭh, nŏq căh jơ khây camvŭm pân.” <verse eid="MAT 19:17" /><verse number="18" style="v" sid="MAT 19:18" />Nĕh nŏq âh bây Siđăch: “Khây camvŭm pân lây?” En Siđăch Yêsu nhai: “Vâng tachưt tamun, vâng ôp bap cani, vâng sa can'hưn, vâng ôp candân mvâr. <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />Căh gŭq saq di yăh bây vap nggâm mê, bây sinđach tamun rawênh pôp de dân ca rup nơm pôp.” <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />Klô dlu nŏq âh bây Siđăch: “Ănh gĕh tôq jơ lĕq khây sinlơ nŏq en. Ănh hôm ndŏh gĕh păch lây wŏq hẩng?” <verse eid="MAT 19:20" /><verse number="21" style="v" sid="MAT 19:21" />Siđăch Yêsu nhai bây nĕh: “Hê pôp cơnh gĕh yăh soch, căh saq, en tăch khây păch lây cồ nơm gĕh en văt an tamun lŏh sat, nŏq pôp gĕh gŏq păch caya vlơ Daq Trôq; en tât saq bây Ănh.” <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />Cồ canŏq lăm chăng camvŭm nŏq sŏng, păch klô nŏq hwât saq mvăc yưr nuih, payh ơ nĕh nŏq gĕh gŏq păch caya lŭng nggơi.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Vrêq heq, Siđăch Yêsu nhai bây khây con tuyh nơm de: “Nhâng, Ănh nhai bây pôp ŏh pành: tamun gan'hăp lăp sŭng Daq Trôq đăng dê uy. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />En Ănh nhai wŏq bây pôp ŏh, chĕq con lạc đà chun lăp chhŭng jrŭm cồ vrŭq dê dŭng vlơ a tamun gan'hăp lăp sŭng Daq Cô Voq de.” <verse eid="MAT 19:24" /><verse number="25" style="v" sid="MAT 19:25" />Vrêq heq, lăm chăng canŏq, khây con tuyh camhŏq lŭng, nhai: “Canŏq, păch vu lây cồ gĕh yơt?” <verse eid="MAT 19:25" /><verse number="26" style="v" sid="MAT 19:26" />Deng lân lân lăp khây con tuyh, Siđăch Yêsu nhai bây khây nĕh: “Bây con tamun, vrŭq heq pành đăng gĕh, cồ canŏq bây Siđăch Trôq, ăp vrŭq ôp gĕh lĕq.” <verse eid="MAT 19:26" /><verse number="27" style="v" sid="MAT 19:27" />Lăm nŏq, chĕq âh sĭq vlâq, Phi-e-rơ nhai bây Siđăch: “Gru deng sên, khananh gĕh hwât lĕq ăp sinlơ en saq bây Gru. Canŏq gĕh păch lây chĕq an khananh?” <verse eid="MAT 19:27" /><verse number="28" style="v" sid="MAT 19:28" />En Siđăch Yêsu nhai bây khây nĕh: “Nhâng, Ănh nhai bây pôp ŏh, pành pôp ŏh, cồ khây tamun gĕh saq bây Ănh, sŭng dâq pagâl me, lăm Con Tamun gŭq vlơ gatŭq sindraq sindil nơm de, nŏq pôp ŏh khoi gŭq vlơ mât var gatŭq prĭh, săc si mât var chhe njang I-sơ-ra-ên. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Ăp ndu, nŏq cồ hê vu lây hwât nhi la, pôp ŏh klô, pôp ŏh ur, vap, mê, si-ur, con, ha ntĕh mơ tanŏh payh ơ săq Ănh de, nŏq gĕh wŏq tât du rayĕng dâq vlơ bây wŏq gĕh sinlơ rĭh gơih nggơih. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Cồ canŏq gŏq tamun vôq lĕq gĕh jêng chôch, en khây tamun chôch gĕh jêng vôq lĕq.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />Mvăc Daq Trôq cồ dân ca du mvu nơm ntĕh, cồ tamun saq lŭh a lăm măng rŭq chĕq chwâl tamun ôp an rông ramvu nơm de. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Vrêq heq, lăm tăm êq bây khây tamun ôp gĕh du đơ-ni-ê an du năr, nŏq nĕh pađăr khây nĕh lăp sŭng rông ramvu nơm de. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />En lăm saq lŭh a vadâq di pe, nơm ntĕh sây khây tamun ndây tao yăq ngăn sŭng vi tăch vro. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Nĕh nhai bây khây nĕh: ‘Khây pôp khoi saq lăp sŭng rông ramvu, en jên prơn lây cồ dip gal, nŏq ănh trŏh an khây pôp.’ <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />En khây nĕh saq bây. Lăm saq lŭh wŏq sŭng vadâq di prau bây di sưn, nĕh khoi ôp dân canŏq. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Canŏq en, lăm mơch vadâq di mât muôi, nĕh saq lŭh en sây khây tamun ndây tao yăq, nĕh nhai bây khây nĕh: ‘Lŭh khây pôp tao yăq ngăn rŏh năr u heq canŏq?’ <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />Khây nĕh âh bây nơm ntĕh: ‘Mvăc đăng gĕh vu lây chwâl khananh.’ Nơm ntĕh nhai bây khây nĕh: ‘Khây pôp khoi saq lăp sŭng rông ramvu vồh.’ <verse eid="MAT 20:7" /><verse number="8" style="v" sid="MAT 20:8" />En tât mau jingo, nơm rông ramvu nhai bây tamun sên vôq nơm de: ‘Saq cuôl khây tamun ôp păch tât en trŏh jên prơn an khây nĕh, pơq vôq a khây tamun alưr lĕq an tât khây tamun avôq.’ <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Lăm saq tât, khây tamun cồ gĕh chwâl lăm mơch vadâq di mât muôi, ăp ndu wŏq gĕh du đơ-ni-ê. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Hôm khây tamun ôp păch vôq lĕq, lăm saq tât, gĕh sinâng pành nơm wŏq gĕh gŏq dông, en khây nĕh khoi wŏq du đơ-ni-ê an ăp ndu. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Aheq lăm wŏq en, khây nĕh nhai măq nhai ken sĭq nơm ntĕh, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />pành: ‘Khây tamun ôp păch alưr lĕq nŏq ôp ayh du vadâq, en cô chĕq khây nĕh simơ bây khananh, cồ khây tamun vlam hyoq chŏnh rŏh năr nggâm sinlơ dŭh tanh dân ca sŏh roq.’ <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />Cồ canŏq lăm âh sĭq vlâq, nơm ntĕh nhai bây du mvu sŭng khây nĕh: ‘Heq ơ ganai, ănh đăng gŭq saq đăng yăh bây khây pôp pà. Đăng gal khây pôp gĕh tăm êq bây ănh du đơ-ni-ê uy? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Tât wŏq jên pôp de en saq chĕq, Hôm ănh cơnh dơp an khây tamun chôch heq khoi dân ca dơp an pôp. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Ha đăng gĕh an ănh chĕq ôp sinlơ cồ ănh cơnh bây khây păch ănh de? Ha măt pôp de ra-ĕh payh ơ ănh gĕh nuih talaq yăh?’ <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" />Dân canŏq, tamun chôch gĕh jêng vôq, en tamun vôq gĕh jêng chôch lĕq.”<verse eid="MAT 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Sŭng lăm saq hao palây Yê-ru-sa-lem, Siđăch Yêsu văt bây mât var con tuyh saq ayh bây nơm, en vlơ trong saq, Siđăch nhai bây khây nĕh: <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“Sên heq, vơn saq hao tât Yê-ru-sa-lem, en Con Tamun gĕh dơp an khây gru sipăm măq bây khây gru pađau ravwŏq, en khây nĕh dơp dôih chưt chĕq tachưt Nĕh. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />En dơp Nĕh an khây văl daq a ling chĕq pagơq, pâm gông, en pâng jimâng Nĕh vlơ chhơ pagăn. En sŭng năr di pe, Siđăch tao rĭh sĭq vlâq.”<verse eid="MAT 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Lăm nŏq, mê var lâm con klô Sê-bê-đê de nggâm bây khây con nĕh de saq tât mơch Siđăch, pin vôq cŭh bây ngwân wĭnh du vrŭq a Siđăch. <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />En Siđăch nhai bây nĕh: “Yông cơnh păch lây?” Nĕh âh bây Siđăch: “Wĭnh nhai bơh năm chĕq var lâm con klô ănh de heq, du mvu gŭq gĕh a maq ma, en du mvu a maq gyau Cô sŭng Daq Trôq Cô de.” <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />Aheq lăm âh sĭq vlâq, Siđăch Yêsu nhai, “Mê con yông đăng gưt vơn wĭnh păch lây pà. Var lâm pôp ŏh huch gĕh nggan cồ Ănh mơch huch đăng?” Khây nĕh âh bây Siđăch: “Khananh huch gĕh.” <verse eid="MAT 20:22" /><verse number="23" style="v" sid="MAT 20:23" />Aheq Siđăch nhai bây khây nĕh: “Nhâng pôp ŏh gĕh huch nggan Ănh de, cồ canŏq chĕq gŭq u maq ma bây u maq gyau Ănh de đăng gal cồ vrŭq Ănh de an gĕh, nŏq gĕh chĕq an khây tamun cồ gĕh sŭmmrăp a Vap Ănh de.” <verse eid="MAT 20:23" /><verse number="24" style="v" sid="MAT 20:24" />Lăm chăng vrŭq heq, mât ndu con tuyh tĭq măq nuih bây var du pôp ŏh. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Cồ canŏq lăm cuôl khây nĕh tât bây nơm, Siđăch Yêsu nhai: “Pôp ŏh gưt pành khây vatau, khây yang văl daq a ling piêt gatŏq văl, en khây tamun ôp măq plơ prơn camhlăng vlơ vu. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Sŭng pôp ŏh nĕh đăng canŏq. Palâq sĭq vlâq, hê vu lây cơnh jêng măq sŭng ndăng pôp ŏh, nĕh nŏq ôp tamun tachŏq pôp ŏh de, <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />en vu lây cơnh văt vôq sŭng pôp ŏh nŏq ôp dĭch năc pôp ŏh de. <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />Tât cồ dân ca Con Tamun đăng tât chĕq gĕh tachŏq, mà chĕq tachŏq, bây patăq sinlơ rĭh nơm de dân ca jên song ala an gŏq ndu.”<verse eid="MAT 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />En lăm khây nĕh a palây Yê-ri-cô saq lŭh, du mintan con văl gŏq săq saq bây Siđăch. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />En sên tĭq, var ndu jingo măt gŭq u vâr trong. Lăm chăng pành Siđăch Yêsu saq găn nŏq, khây nĕh sec hao, pành: “Cŭh Siđăch, Con vatau Đa-vit, wĭnh sinđach khananh.” <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />Aheq, mintan con văl chĭh lăh var ndu, chĕq khây nĕh gŭq krap, cồ canŏq đé khây nĕh cuôl tayh vlơ wŏq, pành: “Cŭh Siđăch, Con vatau Đa-vit, wĭnh sinđach khananh.” <verse eid="MAT 20:31" /><verse number="32" style="v" sid="MAT 20:32" />Lăm gŭq sĭq vlâq en, Siđăch Yêsu cuôl khây nĕh tât bây nhai: “Khây pôp cơnh Ănh ôp păch lây an khây pôp?” <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />Khây nĕh nhai bây Siđăch: “Cŭh Siđăch, nŏq cồ wĭnh an măt khananh gĕh silang.” <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />Lăm vrêq, payh ơ lêch nuih sinđach, Siđăch Yêsu baq lăp măt khây nĕh. Sŏng lăm nŏq, khây nĕh sây gĕh en saq bây Siđăch.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Lăm khây nĕh mơch tât palây Yê-ru-sa-lem, en saq tât Bê-pha-yê, sĭq tu maq gŭng Ô-liu, lăm nŏq Siđăch Yêsu pađăr var ndu con tuyh, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />săng khây nĕh: “Căh saq lăp sŭng palây a vôq măt pôp ŏh, en pôp ŏh sây sŏng u nŏq du lâm asĕh răch vang gĕh tănchăp, nggâm bây du lâm asĕh răch con gŭq bây nĕh. Lăm đŏh chhe tănchăp, căh têch tât Ănh iưn. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />En hê gĕh vu lây nŏq nhai păch lây bây pôp ŏh, nŏq pôp ŏh nhai pành: ‘Siđăch gĕh vrŭq cơnh don asĕh heq,’ en tamun nŏq sŏng lăm nŏq chĕq an khây nĕh saq.” <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />Maq ndây, vrŭq heq gĕh ôp lŭh chĕq an camvŭm cồ gĕh nhai lŭh don cô tiêng tri gĕh jêng gayh, pành:<verse eid="MAT 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MAT 21:5" />“Căh săng con ur Si-ôn de:</para>
  <para style="q" vid="MAT 21:5">Sên tĭq, vatau kha-ay de tât bây kha-ay,</para>
  <para style="q" vid="MAT 21:5">tăn jưr nơm en gŭq vlơ asĕh răch</para>
  <para style="q" vid="MAT 21:5">— nŏq cồ vlơ du lâm asĕh răch con, con asĕh răch vang.”<verse eid="MAT 21:5" /></para>
  <para style="b" />
  <para style="m">
    <verse number="6" style="v" sid="MAT 21:6" />Lăm vrêq, khây con tuyh, lăm saq en ôp dân ca Siđăch Yêsu gĕh pân pađau khây nĕh, <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />gĕh têch asĕh răch vang nggâm asĕh răch con sĭq, en lăq ao nơm de vlơ khây asĕh nŏq, en Siđăch hao gŭq vlơ nŏq. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Lăm vrêq, gŏq ndu sŭng con văl lăq ao khây nĕh de vlơ trong, hôm khây tamun ndây păh khây singging chhơ en răh vlơ trong nŏq. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Canŏq en, khây mintan gŏq săq saq avôq Siđăch nggâm saq bây alưr sec hao, pành:</para>
  <para style="q" vid="MAT 21:9">“Hô-sa-na Con vatau Đa-vit!</para>
  <para style="q" vid="MAT 21:9">Payom tapơ Candranh tât sŭng săq Siđăch Trôq!</para>
  <para style="q" vid="MAT 21:9">Hô-sa-na vlơ trôq prĭh tĭq!”<verse eid="MAT 21:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="MAT 21:10" />Lăm Siđăch lăp sŭng palây Yê-ru-sa-lem, lĕq palây minsôc minsac, tăm lŭp: “Nŏq cồ vu lây?” <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />Canŏq en mintan con văl âh: “Nŏq cồ tiêng tri Yêsu, a Na-sa-ret, ntĕh Ga-li-lê.”<verse eid="MAT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Siđăch Yêsu saq lăp sŭng Nhi Cŭh, en Nĕh dăh lĕq săq khây tamun tăch vro u sŭng Nhi Cŭh, en phlâq tarung nra tamun gâl jên, nggâm vi gŭq tamun tăch sŭm vrăt de. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Siđăch nhai bây khây nĕh: “Camvŭm lĕq gĕh chêr: ‘Nhi Ănh gĕh cuôl pành nhi vơu ngwân,’ aheq khamay ôp an nhi nŏq jêng minsôm can'hưn can'hlĕq.” <verse eid="MAT 21:13" /><verse number="14" style="v" sid="MAT 21:14" />En khây tamun jingo măt bây tamun cannwe tât mơch Siđăch sŭng Nhi cŭh, en Siđăch jâc yăh an khây nĕh. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Cồ canŏq khây gru sipăm măq nggâm khây gru pađau ravwŏq, lăm sây khây vrŭq măq mi cồ Siđăch gĕh ôp, bây sây khây con se tapơ sŭng Nhi Cŭh, pành: “Hô-sa-na Con vatau Đa-vit,” nŏq khây nĕh măq nuih. <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Khây nĕh nhai bây Siđăch: “Gru gĕh chăng khây con se nhai păch lây đăng?” Aheq Siđăch Yêsu nhai bây khây nĕh: “Gĕh vồh! Khây cô ndŏh gĕh lăm lây đŏc pành: ‘Cô Voq gĕh sŭmmrăp sưndăc sinlơ payom a mŭnh khây con se de nggâm khây con ken hôm pu,’ uy?” <verse eid="MAT 21:16" /><verse number="17" style="v" sid="MAT 21:17" />Lăm lăq chĕq khây nĕh, Siđăch saq lŭh ntrăch a palây chĕq tât Bê-tha-ni en vĭq măng u nŏq.<verse eid="MAT 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Tât silang, sŭng lăm saq sĭq vlâq lăp palây, nŏq Siđăch pangot. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Lăm deng sây du tơm chhơ vả u maq trong, Siđăch saq tât chhơ nŏq en singgal gưt đăng gĕh păch lây vlơ nĕh aling la vŏq en. Siđăch nhai bây nĕh: “Play đăng hôm gĕh u may wŏq an tât gơih nggơih,” en sŏng lăm nŏq, chhơ vả nŏq ro chĕq. <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />Sây canŏq en, khây con tuyh camhŏq, nhai: “Ôp bơh năm nŏq chhơ vả ro sŭmmrât canŏq?” <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />En lăm âh camvŭm, Siđăch Yêsu nhai bây khây nĕh: “Nhâng, Ănh nhai bây pôp ŏh, hê pôp ŏh gĕh sinlơ tôq bây đăng ngâm, nŏq pôp ŏh ôp gĕh đăng gal ayh vrŭq heq an chhơ vả, mà tât cồ hê pôp ŏh nhai bây gŭng heq: ‘Căh gĕh iơq hao, en gĕh hwât jưr daq lênh,’ en vrŭq nŏq gĕh ôp lŭh. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Ăp sinlơ, an nŏq cồ sinlơ lây pôp ŏh cuôl wĭnh sŭng camvŭm vơu ngwân, nŏq pôp ŏh wŏq gĕh lăm tôq sŏq don camvân.”<verse eid="MAT 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />En lăm Siđăch lăp sŭng Nhi Cŭh en, khây gru sipăm măq nggâm khây cô camvĭnh sŭng con văl gĕh tât vlam Siđăch sŭng lăm nĕh pađau tămti, lŭp: “Don prơn gŭn lây Gru ôp khây vrŭq heq, en vu lây gĕh an Gru prơn nŏq?” <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />Cồ canŏq chĕq âh camvŭm, Siđăch Yêsu nhai bây khây nĕh: “Ănh khoi lŭp khây cô du camvŭm, en hê khây cô âh gĕh camvŭm Ănh, nŏq Ănh khoi nhai an khây cô gưt Ănh ôp khây vrŭq heq don a prơn gŭn lây. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Chin'hâu ŭm vôq Yăng de — chin'hâu nŏq a vi lây? A vlơ trôq ha a con tamun?” Aheq, khây nĕh tăm nhai bây ndăng ganai, pành: “Hê vơn nhai: ‘A vlơ trôq,’ canŏq Nĕh nhai bây vơn: ‘Nŏq payh ơ tơm lây nŏq khây cô đăng tôq nĕh?’ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Hôm hê vơn nhai: ‘A con tamun,’ nŏq vơn phŭng con văl, mvăc lĕq săq khây nĕh sên Yăng cồ du cô tiêng tri.” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Nŏq lăm âh camvŭm Siđăch Yêsu, khây nĕh nhai: “Khananh đăng gưt.” Siđăch khoi nhai bây khây nĕh: “Ănh khoi đăng an khây cô gưt Ănh ôp khây vrŭq heq don a prơn gŭn lây. <verse eid="MAT 21:27" /><verse number="28" style="v" sid="MAT 21:28" />En heq, khây cô sinâng bơh năm? Du mvu tĭq gĕh var lâm con klô, en lăm tât bây con di muôi, nĕh nhai: ‘Ơ con klô, năr heq con saq ôp vrŭq u rông ramvu ơ.’ <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />Aheq lăm âh sĭq vlâq, nĕh nhai: ‘Con đăng saq hôq,’ cồ canŏq a lưr nŏq, lăm pagâl nuih talaq, nŏq nĕh saq. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Hôm lăm tât vlam con di var, nĕh cồ vap nhai dân canŏq. En, lăm âh camvŭm, nĕh nhai: ‘Gĕh con, ơ vap,’ en nĕh đăng saq. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />Vu lây sŭng var lâm con klô nŏq ôp bây nuih cơnh vap khây nĕh de?” Khây nĕh âh: “Con di muôi.” Siđăch Yêsu nhai bây khây nĕh: “Nhâng, Ănh nhai bây khây cô pành khây tamun wŏq jên pâng ya nggâm ur can'hat saq lăp sŭng Daq Trôq Cô Voq de lor khây cô. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Mvăc Yăng gĕh tât bây khây cô sŭng con trong yăh sŏng, nŏq khây cô đăng tôq nĕh. Hôm khây tamun wŏq jên pâng ya nggâm ur can'hat tôq nĕh. Aheq khây cô, cồ gĕh deng sây en, đăng cơnh palâq vôq alưr nŏq chĕq tôq nĕh.<verse eid="MAT 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Căh chăng du camvŭm prŭp ndây. Gĕh du mvu nơm ntĕh, cồ tamun gĕh tăm du rông ramvu, tatao paga rawênh rông nŏq, khwai chhŭng chĕq păt alăc ramvu sŭng nŏq, tatao tông prĭh en an khây tamun tăm ramvu chwâl rông nŏq, en nĕh saq ngai. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Vrêq heq, sŭng lăm khây bĕh play mơch tât, nơm ntĕh pađăr khây dĭch nơm de saq tât bây khây tamun tăm ramvu chĕq sŏq maq play jo nĕh de. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Aheq lăm nhŭp jơ vatom khây dĭch nơm ntĕh de en, khây tamun tăm ramvu pâm nĕh heq, tachưt nĕh tĭq, hwât tamô nĕh tơq. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />En wŏq, nĕh pađăr khây dĭch ndây tât, gŏq săq vlơ vatom lor, en khây nĕh khoi ôp an khây dĭch nŏq dân canŏq. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />En alưr lĕq, nĕh săng đe con klô nĕh de tât bây khây tamun tăm ramvu, pành: ‘Khây nĕh gưt phŭng con klô nơm de.’ <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Aheq văl tăm ramvu, lăm sây con klô nŏq, gĕh tăm nhai bây ndăng ganai: ‘Heq cồ con wŏq păch caya. Vrêq vơn tachưt nĕh en wŏq păch caya nĕh de.’ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Lăm nhŭp jơ con klô nŏq en, khây nĕh hwât con nŏq lŭh ntrăch a rông ramvu en tachưt chĕq. <verse eid="MAT 21:39" /><verse number="40" style="v" sid="MAT 21:40" />Canŏq, lăm nơm rông ramvu tât, nĕh ôp păch lây bây khây tamun tăm ramvu nŏq?” <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />Khây nĕh âh bây Siđăch: “Nơm ntĕh tachưt văl chin'hâc nŏq an di lŏh sat, en an khây tamun tăm ramvu ndây chwâl rông, cồ khây tamun gưt dơp an nơm ntĕh maq play jo sŭng khây bĕh play khây nĕh de.” <verse eid="MAT 21:41" /><verse number="42" style="v" sid="MAT 21:42" />Siđăch Yêsu nhai bây khây nĕh: “Gal đăng khây cô hôm ndŏh đŏc sŭng Sirăq Gŭn:</para>
  <para style="q" vid="MAT 21:42">‘Tamô cồ khây tamun ôp nhi hwât chĕq,</para>
  <para style="q" vid="MAT 21:42">nĕh gĕh jêng tamô kranh gajăp an tơm nhi.</para>
  <para style="q" vid="MAT 21:42">Vrŭq heq gĕh ôp lŭh a Cô Voq,</para>
  <para style="q" vid="MAT 21:42">en nĕh yăh rom lŭng sŭng măt vơn?’<verse eid="MAT 21:42" /></para>
  <para style="b" />
  <para style="m">
    <verse number="43" style="v" sid="MAT 21:43" />Payh ơ tu tơm heq, Ănh nhai bây khây cô pành Daq Trôq Cô Voq de gĕh nhŭp văt saq ntrăch a khây cô en gĕh paq an du văl gưt an lŭh play jo sŭng Daq Trôq nŏq. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Vu lây tavông lăp sŭng tamô heq vlam lêch pachăh, hôm tamô nŏq tarŏh vlơ vu lây, tamô nŏq gatŏq lêch tamun nŏq.” <verse eid="MAT 21:44" /><verse number="45" style="v" sid="MAT 21:45" />Lăm chăng khây camvŭm prŭp Siđăch de, khây gru sipăm măq nggâm khây tamun Pha-ri-si singgal gưt pành Siđăch nhai sĭq khây nĕh. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Lăm wŏng trong chĕq nhŭp Siđăch, en đe khây nĕh phŭng con văl, mvăc con văl sên Siđăch cồ du Cô tiêng tri.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />En âh sĭq vlâq, Siđăch Yêsu du dâq wŏq nhai bây khây nĕh a camvŭm prŭp, pành: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“Daq Trôq gĕh prŭp dân ca du mvu cồ vatau, en vatau nŏq sŭmmrăp war sa tăm sai an con klô nơm de. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Vatau săng khây dĭch năc nĕh de saq chĕq cuôl khây tamun cồ gĕh panh tât war sa tăm sai, en đe khây nĕh đăng cơnh tât. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />A heq vatau săng khây dĭch ndây, pành: ‘Căh nhai bây khây tamun gĕh panh: “Sên tĭq, ănh gĕh sŭmmrăp war sa ănh de, khây vưr nggâm khây gŏng lavau ănh de gĕh ôp gŏng, en ăp vrŭq gĕh sưndăc en. Căh tât bây war sa.”’ <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Cồ canŏq khây nĕh hwât saq mvăc đăng chĕq măt, nĕh heq saq lŭh mơ nĕh de, nĕh tĭq sinâng sĭq vrŭq ôp sa nơm de. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Sŭng lăm khây tamun hôm sĭq vlâq ndây, lăm nhŭp jơ khây dĭch năc vatau de, gĕh ôp pagơq en tachưt chĕq. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Canŏq en, vatau hao nuih, nŏq lăm săng congti nơm de saq, nĕh gĕh an tachưt văl chin'hâc nŏq bây sŏh roq palây khây nĕh de. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Alưr nŏq, vatau nhai bây khây dĭch nĕh de: ‘Cồ war sa tăm sai gĕh sưndăc en, cồ canŏq khây tamun cồ gĕh panh nŏq đăng yăh lôch. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Nŏq vrêq, căh saq tât ăp vrec trong, en hê khamay vlam dâng lây tamun, nŏq căh panh tât war sa tăm sai.’ <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />En khây dĭch năc nŏq, lăm saq lŭh u khây con trong, gĕh vatom lĕq khây vu lây cồ khây nĕh vlam, lĕq viêm nggâm yăh, en nhi sa war gĕh vênh khây chăm tamuôi. <verse eid="MAT 22:10" /><verse number="11" style="v" sid="MAT 22:11" />Aheq lăm saq lăp chĕq sên khây chăm tamuôi gŭq sa, vatau sây du mvu tĭq đăng chuq ao tăm sai. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Vatau nhai bây nĕh nŏq: ‘Ơ ganai, ôp bơh năm pôp lăp heq lăm đăng gĕh su ao tăm sai?’ Cồ canŏq nĕh nŏq kranh mŭnh. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />Alưr nŏq, vatau săng khây dĭch năc: ‘Tănchăp ti jâng nĕh heq sĭq vlâq en hwât nĕh lăp vi jingo a ling tĭq, cồ gatŭq gĕh sinlơ nhim rơp bây kiêr sêch.’ <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />Mvăc gŏq tamun gĕh cuôl, cồ canŏq takiq tamun gĕh săch sŏq.”<verse eid="MAT 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Lăm nŏq, alưr lăm hwât saq en, khây tamun Pha-ri-si tăm sinâng wŏng trong ôp bơh năm chĕq khây nĕh lăm dăq Siđăch sŭng camvŭm nhai. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Khây nĕh pađăr khây con tuyh nơm, nggâm khây tamun amaq Hê-rôt, tât bây Siđăch, nhai: “Ơ Gru, khananh gưt pành Gru cồ tamun yăh nhâng, en pađau tămti con trong Cô Voq de a sinlơ dip gal, en u Gru đăng gĕh sinlơ cŏh king nkênh sĭq du mvu lây, mvăc Gru đăng deng u maq ling vu de. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Payh canŏq, wĭnh an khananh gưt Gru sinâng bơh năm? Gĕh pâng ya an Sê-sa ha đăng?” <verse eid="MAT 22:17" /><verse number="18" style="v" sid="MAT 22:18" />Aheq mvăc gưt nuih talaq chin'hâc khây nĕh de, Siđăch Yêsu nhai: “Ơ khây tamun tanrong mvâr tĭq, lŭh khây cô long găn Ănh? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />An Ănh sên du păndŏh jên chĕq pâng ya hền.” Nŏq khây nĕh dơp an Siđăch du păndŏh đơ-ni-ê. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Siđăch nhai bây khây nĕh: “Gui nggâm săq heq cồ vu lây de?” <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />Khây nĕh âh: “Sê-sa de.” Lăm nŏq, Siđăch nhai bây khây nĕh: “Canŏq, căh trŏh an Sê-sa khây păch Sê-sa de, en an Siđăch Trôq khây păch Siđăch Trôq de.” <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />Lăm chăng camvŭm nhai nŏq, khây nĕh camhŏq lŭng, en khây nĕh saq, chĕq Siđăch sĭq vlâq.<verse eid="MAT 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Sŭng năr nŏq, khây tamun Sa-đu-sê tât mơch Siđăch, mvăc uĕh nhai pành đăng gĕh sinlơ tao rĭh sĭq vlâq, nŏq khây nĕh lŭp rasŏh Siđăch, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />pành: “Ơ Gru, Môi-se gĕh nhai: ‘Hê du mvu lây nŏq chưt en ndŏh gĕh con, canŏq ŏh klô nĕh nŏq de saq sai si-ur pôp de en dĕh con an pôp nơm de.’ <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Aheq, sŭng khananh gĕh pŏh lâm pôp ŏh klô, tamun vôq lĕq, lăm sai ur, en chưt. En nĕh chĕq sĭq vlâq si-ur nĕh an ŏh nĕh de, lăm hôm ndŏh gĕh con. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Tamun di var en tamun di pe, an tât tamun di pŏh, khoi canŏq. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />En a lưr lĕq, tamun ur nŏq khoi chưt. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Canŏq, sŭng sinlơ tao rĭh sĭq vlâq, ur nŏq cồ si-ur vu lây de sŭng pŏh ndu pôp ŏh nŏq? Mvăc lĕq săq khây nĕh gĕh sai ur nŏq.” <verse eid="MAT 22:28" /><verse number="29" style="v" sid="MAT 22:29" />Aheq lăm âh camvŭm, Siđăch Yêsu nhai bây khây nĕh: “Khây cô tĭh wil en, mvăc đăng gưt Sirăq Gŭn nggâm prơn gŭn Siđăch Trôq de. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Mvăc sŭng sinlơ tao rĭh sĭq vlâq, vu đăng sai ur khoi đăng sai klô, aheq khây nĕh rĭh dân ca khây con gŭn vlơ trôq. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Hôm sĭq sinlơ tao rĭh sĭq vlâq tamun chưt de, khây cô ndŏh đŏc camvŭm gĕh Siđăch Trôq nhai bây vơn, pành: <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘Ănh heq cồ Siđăch Trôq Ap-ra-ham de, Siđăch Trôq I-sac de en Siđăch Trôq Ya-côp de’? Siđăch Trôq đăng gal cồ tamun chưt de, nŏq cồ tamun rĭh de.” <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />Lăm chăng canŏq, con văl camhŏq sĭq sinlơ pađau tămti Siđăch de.<verse eid="MAT 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Hôm khây tamun Pha-ri-si, lăm chăng pành Siđăch ôp an khây tamun Sa-đu-sê kranh mŭnh, nŏq tăm vatom bây ndăng ganai. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Muôi sŭng khây nĕh, cồ gru pađau ravwŏq, lŭp rasŏh chĕq long găn Siđăch — <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“Ơ Cô, camvŭm pân lây cồ măq dông lĕq sŭng ravwŏq?” <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />En Siđăch nhai bây nĕh: “‘Căh sinđach Cô Voq, cồ Siđăch Trôq pôp de, bây lĕq nuih talaq pôp de, nggâm lĕq wênh nggui pôp, bây lĕq chhu vôq pôp de.’ <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Nŏq cồ camvŭm pân măq bây măq mi dông lĕq. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Hôm camvŭm pân di var dân ca camvŭm nŏq — ‘Căh sinđach tamun rawênh con de dân ca nơm vơn.’ <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Lĕq ravwŏq bây khây tiêng tri gĕh chĕq tơm vlơ var camvŭm pân heq.”<verse eid="MAT 22:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Vrêq heq, alưr lăm khây tamun Pha-ri-si gĕh tăm vatom simơ, Siđăch Yêsu lŭp khây nĕh, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />pành: “Khây cô sinâng bơh năm sĭq Candranh Krit? Nĕh cồ con vu lây?” Khây nĕh âh camvŭm Siđăch: “Vatau Đa-vit de.” <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />Siđăch nhai bây khây nĕh: “Canŏq ôp bơh năm nŏq Đa-vit, sŭng Siđăch Wênh, cuôl Nĕh pành Cô Voq, lăm nhai:<verse eid="MAT 22:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="MAT 22:44" />‘Cô Voq nhai bây Siđăch ănh:</para>
  <para style="q" vid="MAT 22:44">“Gŭq u maq ti ma Ănh de,</para>
  <para style="q" vid="MAT 22:44">an tât lăm lây Ănh chĕq khây tamun tăm chŏl Con de u tĕh jâng Con”’?<verse eid="MAT 22:44" /></para>
  <para style="b" />
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Canŏq hê Đa-vit cuôl Nĕh pành ‘Cô Voq,’ nŏq ôp bơh năm Siđăch cồ con vatau nŏq de di gĕh?” <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Đăng gĕh vu lây âh sĭq vlâq Siđăch gĕh du camvŭm lây, khoi đăng du mvu lây thêng lŭp Siđăch wŏq a năr nŏq.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Alưr nŏq, Siđăch Yêsu nhai bây mintan con văl nggâm khây con tuyh nơm de, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />pành: “Khây gru pađau ravwŏq bây khây tamun Pha-ri-si gŭq vlơ gatŭq gŭq Môi-se de. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Payh canŏq, hê khây nĕh pađau tămti pôp ŏh sinlơ lây, căh ôp bây en tôq jơ lĕq. Cồ canŏq vâng ôp bây khây vrŭq ôp khây nĕh de, mvăc khây nĕh nhai sŭng lăm đăng ôp. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Khây nĕh tănchăp khây njang canjâq canjơng bây đăng dê nong, en khây nĕh chât vlơ paniq vu, sŭng lăm nơm khây nĕh đăng cơnh baq candrayh ti nơm lăp khây păch nŏq. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />Khây nĕh ôp ăp vrŭq nơm de chĕq gĕh vu deng sây. Mvăc khây nĕh ôp khây gatui vadâng ravwŏq nơm de an di măq, en tanh khây tiêng ao nơm an di jong. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Khây nĕh vui cơnh gatŭq gŭq yăh prĭh dông lĕq sŭng lăm sa war, bây khây gatŭq gŭq prĭh dông lĕq sŭng nhi vatom <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />nggâm khây camvŭm khwây u trong bây vi tăch vro, bây gĕh con văl cuôl pành ‘Gru.’ <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Cồ canŏq pôp ŏh vâng chĕq gĕh cuôl pành ‘Ra-bi’ vầy, mvăc Gru pôp ŏh de gĕh ayh muôi, hôm lĕq săq pôp ŏh cồ ndăng ganai. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />En pôp ŏh vâng cuôl du mvu lây vlơ ntĕh heq pành ‘vap’ mvăc pôp ŏh gĕh ayh du lâm Vap gŭn gayh. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Khoi vâng chĕq vơn gĕh cuôl pành ‘gru,’ mvăc gru pôp ŏh de gĕh ayh muôi — nŏq cồ Candranh Krit. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Cồ canŏq tamun măq dông lĕq sŭng ndăng pôp ŏh cồ dĭch năc pôp ŏh de. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Hôm vu lây iơq nơm vơn hao, nŏq gĕh tănjưr; en vu lây tănjưr nơm nĕh nŏq gĕh ta-iơq hao.<verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />Cồ canŏq, lŏh sat an khây cô, cồ khây gru pađau ravwŏq bây tamun Pha-ri-si, cồ văl gĕh tanrong mvâr tĭq! Mvăc khây cô păng Daq Trôq sĭq vlâq a vôq măt vu. Mvăc khây cô đăng lăp sŭng nŏq, khoi đăng chĕq an vu lây saq lăp gĕh sŭng di lăm nŏq. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />[Lŏh sat an khây cô, cồ khây gru pađau ravwŏq bây tamun Pha-ri-si, cồ văl gĕh tanrong mvâr tĭq! Mvăc khây cô sa nđưt nhi khây tamun mrô, en vơu ngwân jong vri sŭng sinlơ mvâr.] Payh canŏq, khây cô nhâng wŏq dôih canh jŏq dông. <verse eid="MAT 23:14" /><verse number="15" style="v" sid="MAT 23:15" />Lŏh sat an khây cô, cồ khây gru pađau ravwŏq bây tamun Pha-ri-si, cồ văl gĕh tanrong mvâr tĭq! Mvăc khây cô saq khoang daq lênh khoi ca vlơ ntĕh sŏh chĕq ôp an du mvu palâq vôq, en lăm tamun nŏq gĕh jêng canŏq en, đé khây cô ôp an nĕh nŏq jêng con dưnjrang tât var dâq vlơ khây cô.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />Lŏh sat an khây cô, cồ khây tamun iau trong jingo măt, nŏq cồ khây tamun nhai: ‘Vu lây sinlau nhi cŭh chĕq raq săq nŏq đăng gĕh păch lây. Hôm vu lây sinlau mơh nhi cŭh de chĕq raq săq nŏq wŏq camvŭm raq săq.’ <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Ơ khây tamun gala bây jingo măt tĭq! Nŏq păch lây cồ yăh măq dông, mơh ha nhi cŭh ôp an mơh jêng gŭn? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />En wŏq: ‘Vu lây sinlau mvrăh chĕq raq săq, nŏq đăng gĕh păch lây. Cồ canŏq vu lây sinlau păch pađăc vlơ mvrăh chĕq raq săq nŏq căh jơ.’ <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Ơ khây tamun gala bây văl jingo măt tĭq! Nŏq sinlơ lây cồ yăh măq dông, păch pađăc ha mvrăh ôp an păch pađăc gĕh jêng gŭn? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Canŏq, vu lây gĕh sinlau mvrăh chĕq raq săq, nŏq sinlau mvrăh nggâm sinlau ăp sinlơ a vlơ nŏq chĕq raq săq. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Vu lây gĕh sinlau nhi cŭh chĕq raq săq, nŏq sinlau nhi cŭh nggâm sinlau Candranh gŭq sŭng nŏq chĕq raq săq. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />En vu lây gĕh sinlau trôq chĕq raq săq nŏq sinlau gatŭq gŭq Siđăch Trôq de nggâm sinlau Candranh cồ gŭq vlơ nŏq chĕq raq săq.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />Lŏh saq an khây cô, cồ khây gru pađau ravwŏq bây tamun Pha-ri-si, cồ văl gĕh tanrong mvâr tĭq! Mvăc khây cô dơp du phần mât pai trau, la khlôih bây pai nthôr sŭng lăm đăng chĕq măt tât khây vrŭq măq vlơ ravwŏq de — nŏq cồ sinlơ yăh sŏng, nuih talaq sinđach bây sinlơ mbêr nuih. Maq ndây, nŏq cồ sinlơ phải gĕh chĕq ôp khây vrŭq heq bây đăng hwât chĕq khây vrŭq tĭq. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Ơ văl iau trong jingo măt tĭq, nŏq cồ khây tamun wŏng sây gĕh du lâm moih ken, sŭng lăm nđưt tung du lâm lạc đà!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />Lŏh sat an khây cô, cồ khây gru pađau ravwŏq bây tamun Pha-ri-si, cồ văl gĕh tanrong mvâr tĭq! Mvăc khây cô rao jrŏh khây nggan bây thaih u maq ling, cồ canŏq sŭng di lăm nĕh vênh sinlơ can'hưn bây lêng vôt. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Ơ văl Pha-ri-si jingo măt tĭq! Lor lĕq, căh rao jrŏh sŭng di lăm khây nggan bây thaih, chĕq maq ling khây thaih, nggan nŏq khoi gĕh jrŏh.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />Lŏh sat an khây cô, cồ khây gru pađau ravwŏq bây tamun Pha-ri-si, cồ văl gĕh tanrong mvâr tĭq! Mvăc khây cô dân ca khây ganăp gĕh bôih voq, cồ khây păch cồ sây ca yăh rom u maq ling, cồ canŏq sŭng di lăm vênh nting tamun chưt bây lôch khây păch sŭq cavơm. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Khoi dân canŏq, cồ maq ling khây cô ôp sây ca yăh sŏng bây vu, cồ canŏq sŭng di lăm khây cô de nŏq vênh sinlơ mvâr bây đăng gĕh ravwŏq.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />Lŏh sat an khây cô, cồ khây gru pađau ravwŏq bây tamun Pha-ri-si, cồ văl gĕh tanrong mvâr tĭq! Mvăc khây cô tatao ganăp khây cô tiêng tri de bây ôp rom ganăp khây tamun yăh sŏng de. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Khây cô nhai: ‘Hê khananh gŭq sŭng nggơih khây un cô vơn, nŏq nhâng khananh đăng ôp tamun tăm lăp ti bây khây nĕh u n'ham khây cô tiêng tri de pà.’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Payh canŏq, đe nơm khây cô ôp candân sĭq vơn pành vơn cồ con sinau khây tamun tachưt khây cô tiêng tri, <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />en khây cô căh ôp an jôm bây vênh păch waih bưn bap un cô jây khây cô de! <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />Ơ khây vĭh panim tĭq, cồ chhe hwai vĭh pai trau, khây cô lôt du ntrăch a sinlơ ôp dôih ŭnh dưnjrang de a trong lây? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Payh ơ tu tơm heq, sên tĭq, Ănh săng pađăr khây cô tiêng tri, tamun vanŏh bây gru pađau ravwŏq tât bây khây cô. A sŭng khây nĕh, khây cô tachưt bây pâng jimâng, khoi sŭng khây nĕh, khây cô pâm rĕh sŭng khây nhi vatom vơn de en dăh rachoq a palây heq tât palây ndây, <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />ôp bơh năm chĕq n'ham yăh sŏng cồ gĕh tapinh lŭh vlơ ntĕh tât lĕq vlơ khây cô, a n'ham A-bên de, cồ tamun yăh song, an tât n'ham Sa-cha-ri, cồ con klô Ba-ra-chi de, nĕh cồ khây cô gĕh tachưt u mvrăh sŭng nhi cŭh. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Nhâng, Ănh nhai bây khây cô, ăp vrŭq nŏq gĕh văt tât vlơ chhe njang heq au klaq.<verse eid="MAT 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />Ơ Yê-ru-sa-lem, Yê-ru-sa-lem, may gĕh tachưt khây cô tiêng tri bây hwât tamô khây tamun cồ gĕh pađăr tât bây may! Gŏq dŏq en Ănh cơnh vatom ŏh con may de sĭq vlâq, dân ca sinlơ cồ iêr vang takrŏc con nơm u tĕh panăr, cồ canŏq may đăng cơnh! <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Sên heq, nhi la khây cô de gĕh hwât chĕq lŭh vi singot an khây cô. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Mvăc Ănh nhai bây khây cô, khây cô nhâng bâng đăng sây Ănh a vrêq an tât lăm lây khây cô nhai: ‘Payom Candranh tât sŭng săq Cô Voq!’”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Lăm saq lŭh ntrăch a nhi cŭh, Siđăch Yêsu saq vlơ trong. En khây con tuyh Siđăch de tât mơch chĕq pađau an Nĕh sên khây nhi la nhi cŭh de. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Aheq lăm âh sĭq vlâq, Siđăch nhai bây khây nĕh: “Pôp ŏh đăng deng sây ăp sinlơ nŏq uy? Nhâng, Ănh nhai bây pôp ŏh, u heq nhâng bâng đăng hôm sĭq vlâq côq tamô heq vlơ côq tamô tĭq nŏq đăng talĭh jưr.”<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Vrêq heq, Lăm Siđăch gŭq vlơ gŭng Ô-liu, khây con tuyh tât ayh mơch Nĕh, nhai: “Wĭnh an khananh gưt lăm lây khây vrŭq nŏq gĕh ôp lŭh, en păch panol sĭq sinlơ tât Gru de nggâm sĭq dŏq chôch lawăch cồ păch lây?” <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />Lăm âh camvŭm, Siđăch Yêsu nhai bây khây nĕh: “Căh jơ nơm chĕq đăng gĕh vu lây ôp an pôp ŏh chroc voc. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Mvăc gŏq ndu tât sŭng săq Ănh, nhai: ‘Ănh heq cồ Candranh Krit,’ en ôp an gŏq ndu chroc voc. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />En wŏq, pôp ŏh mơch chăng nhai sĭq minsŭh bây khây sinlơ ratênh tât minsŭh mintăq: Pôp ŏh căh jơ nơm, vâng vlam jăl wăl, mvăc vrŭq nŏq phải gĕh ôp lŭh, cồ canŏq khoi hôm ndŏh gal cồ năr chôch lawăch uy. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Mvăc văl heq prŭh tao chŏl sĭq vlâq bây văl ndây, daq heq pâm bây daq tĭq, en gĕh pangot bây ntĕh lănggưn u gŏq gatŭq. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Cồ canŏq lĕq khây vrŭq heq cồ gatŭq pơq vôq an dâq ji talaq dĕh. <verse eid="MAT 24:8" /><verse number="9" style="v" sid="MAT 24:9" />En nŏq, vu dơp pôp ŏh lăp sŭng sinlơ lŏh sat en tachưt pôp ŏh chĕq, en pôp ŏh vlam ăp văl ncom payh ơ săq Ănh. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />En gŏq ndu vlam tachĭh jâng, tăm chŏl bây ndăng ganai en ncom ndăng ganai. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Gŏq tiêng tri mvâr gĕh iơq hao en ôp an gŏq ndu chroc voc. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Mvăc sinlơ đăng ravwŏq gĕh hao gŏq, sinlơ sinđach sŭng gŏq ndu la-âh la-ui. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Cồ canŏq, vu lây mbêr nuih an tât chôch lawăch, nĕh nŏq gĕh yơt. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Sipơp Yăh heq sĭq Daq Trôq gĕh nhai lŭh vlơ lam dưnya chĕq ôp du camvŭm candân an ăp văl, en nŏq sinlơ chôch lawăch tât.<verse eid="MAT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />Payh canŏq, lăm pôp ŏh deng sây sinlơ sŭq cavơm âr sŭng vi talĭh talŭng, cồ sinlơ gĕh tiêng tri Đa-ni-ên nhai tât, chĕq u sŭng gatŭq gŭn” (tamun đŏc căh dân gĕh), <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />“lăm nŏq, vu lây sŭng ntĕh Yu-đê căh lôt du tăm pôn tât tu gŭng, <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />vu lây gŭq vlơ vôq duôl nhi, vâng saq jưr chĕq nhŭp păch lây lŭh a nhi nơm, <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />en vu lây gŭq u tamăn vâng saq sĭq chĕq nhŭp ao nơm de. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Aheq, lŏh sat an tamun ur gĕh vŭn nggâm khây vu lây hôm an con pu sŭng khây năr nŏq! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Cồ canŏq căh vơu ngwân chĕq vrŭq lôt du pôp ŏh de đăng gĕh ôp lŭh sŭng khây tacăt ha sŏng năr Sa-bat. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Mvăc lăm nŏq gĕh sinlơ lŏh sat măq, ndŏh gĕh ôp lŭh dâq lây dân canŏq a lăm pơq vôq dưnya an tât năr heq, en nhâng bâng khoi đăng gĕh wŏq. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Hê khây năr nŏq đăng gĕh tăq dêh, nŏq nhâng lĕq khây gŏng n'ham đăng gĕh yơt. Cồ canŏq payh ơ khây tamun gĕh săch sŏq, khây năr nŏq gĕh ôp păndĕh. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />Lăm nŏq, hê du mvu lây nŏq nhai bây pôp ŏh: ‘Sên tĭq, Candranh Krit gŭq u heq!’ ha ‘gŭq u nŏq!’ nŏq pôp ŏh vâng tôq. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Mvăc khây Krit mvâr nggâm khây tiêng tri mvâr gĕh iơq hao en an sây khây păch tayh nggâm khây păch chin'hâu măq mi tât daq ôp an chroc voc, hê gĕh lam voch lawân khây tamun gĕh săch sŏq. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Sên heq, Ănh nhai lor an pôp ŏh en nŏq. <verse eid="MAT 24:25" /><verse number="26" style="v" sid="MAT 24:26" />Canŏq, hê vu nhai bây pôp ŏh: ‘Sên tĭq, Siđăch gŭq sŭng tamăn singot,’ nŏq pôp ŏh vâng saq lŭh tu nŏq. Ha ‘Sên heq, u khây côt sưt,’ nŏq pôp ŏh căh vâng tôq. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Mvăc chhe lơp lŭh a maq vâh năr, en silang chir chhuôi tât maq nhâp năr bơh năm, nŏq sinlơ tât Con Tamun de khoi cồ canŏq. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Hê rup tamun chưt gĕh u vi lây, nŏq khlang râp vatom sĭq vlâq u vi nŏq.<verse eid="MAT 24:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />Aheq sŏng alưr dâq lŏh sat sŭng khây năr nŏq, măt năr gĕh ôp an lŭh jingo, măt khay đăng sol sinlơ silang nĕh de, khây simănh a vlơ trôq tarŏh jưr, en khây prơn camhlăng vlơ khây tăp trôq nggưn. <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />Lăm nŏq, păch panol sĭq Con Tamun gĕh pơq lŭh vlơ galwang trôq, en nŏq lĕq khây văl ganơ vlơ ntĕh nhim rơp. Khây nĕh sây Con Tamun tât vlơ khây lawang tŭq nggâm prơn chin'hâu bây sinlơ sindraq sindil măq mi. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Siđăch gĕh pađăr khây con gŭn Nĕh de nggâm bây camvŭm panŭng ŭh tayh, en khây nĕh vatom sĭq vlâq khây tamun gĕh săch sŏq Nĕh de a lam puôn vôq ntĕh, a chôch jâng trôq maq heq tât chôch jâng trôq maq tĭq.<verse eid="MAT 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />En vrêq, căh đom gưt sinlơ prŭp heq a chhơ vả. Lăm singging nĕh de jêng puh bây lŭh la en, nŏq pôp ŏh gưt pành khây si-ŭh mơch tât. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Khoi dân canŏq, lăm pôp ŏh sây ăp sinlơ heq, nŏq pôp ŏh gưt pành Siđăch gŭq mơch lŭng en, sŏng u vôq lapông. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Nhâng, Ănh nhai bây pôp ŏh, pành nggơih heq nhâng bâng đăng saq ntrăch an tât lăm lây lĕq khây sinlơ nŏq gĕh ôp lŭh. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Trôq bây ntĕh heq saq ntrăch sŭng năr tan'hui, cồ canŏq khây camvŭm Ănh de nhâng bâng đăng saq ntrăch. <verse eid="MAT 24:35" /><verse number="36" style="v" sid="MAT 24:36" />Hôm ratênh tât năr bây vadâq nŏq đăng gĕh vu lây gưt, tât lawân khây con gŭn a vlơ trôq ha Con, aling Vap vŏq en. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Mvăc sŭng nggơih Nô-ê bơh năm, nŏq sinlơ tât Con Tamun de khoi dân canŏq. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Mvăc dân ca sŭng khây năr lor a daq lĭch, vu sa huch, tăm lŭp tăm sai an tât năr Nô-ê lăp sŭng duq, <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />en khây nĕh đăng singgal lŭh an tât lăm daq lĭch tât en văt khây nĕh saq — sinlơ tât Con Tamun de khoi cồ canŏq. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Lăm nŏq, var ndu klô sŭng lăm gŭq u ling tamăn — du mvu gĕh văt saq, du mvu gĕh chĕq sĭq vlâq. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Var ndu ur vŏq vanĭh a lapăl — du mvu gĕh văt saq, du mvu gĕh chĕq sĭq vlâq. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />Payh canŏq, căh iêh lawân mvăc pôp ŏh đăng gưt sŭng năr lây Cô Voq vơn de tât. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Cồ canŏq pôp ŏh căh gưt vrŭq heq, pành hê nơm nhi gĕh gưt tamun can'hưn tât lăm vadâq lây sŭng dŭng măng, nŏq nhâng cồ nĕh gĕh iêh en bây nhâng đăng chĕq an nhi nơm gĕh vu lăp. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Payh ơ tơm tu heq, pôp ŏh khoi căh sưndăc, mvăc Con Tamun tât sŭng vadâq pôp ŏh đăng sinâng tât.<verse eid="MAT 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />Canŏq, vu lây cồ dĭch năc mbêr nuih bây vanŏh cồ nơm nhi dơp vrŭq sên groi vlơ tamun nhi nĕh de chĕq paq păch sa an khây nĕh dip vadâq? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Yăh lŭng an nĕh cồ dĭch nŏq, cồ tamun cồ nơm nhi nĕh de, lăm sĭq tât, gĕh sây pôp nhâng ôp canŏq. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Nhâng, Ănh nhai bây pôp ŏh pành nơm nhi sẽ chĕq nĕh sên groi vlơ ăp sinlơ nơm nhi de. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Palâq sĭq vlâq, hê nŏq cồ dĭch chin'hâc, nĕh nhai sŭng nuih talaq nĕh pành: ‘Nơm nhi ănh yur tât,’ <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />en pơq vôq pâm tôp khây ndăng ganai dĭch bây nơm, en huch sa bây văl vanhưl alăc, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />nŏq nơm nhi dĭch nŏq de tât sŭng năr cồ nĕh đăng câp nggơ bây sŭng vadâq cồ nĕh đăng gưt. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Nơm nhi nŏq pâm bŏh nĕh canjŏq canjơng, en chĕq gatŭq nĕh de simơ bây khây văl gĕh tanrong mvâr; u gatŭq nŏq gĕh sinlơ nhim rơp bây căp sêch.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />Canŏq, Daq Trôq gĕh prŭp dân ca mât ndu ur drŭh palâng, cồ khây tamun văt ŭnh vơn saq lŭh tât gatŭq roc sau klô. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Cồ canŏq, prăm ndu sŭng khây nĕh cồ gala, en prăm ndu vanŏh. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Mvăc prăm ndu gala, lăm văt ŭnh khây nĕh de saq, đăng gĕh văt yầu sŏh bây vơn. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Hôm khây ur vanŏh gĕh văt bây yầu sŏh sŭng pađŭng nggâm bây ŭnh vơn de. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Lăm vrêq, mvăc sau klô yur tât, lĕq khây nĕh jêng cơnh vĭq en vĭq cambet chĕq. <verse eid="MAT 25:5" /><verse number="6" style="v" sid="MAT 25:6" />Aheq lăm năc vanăng, gĕh camvŭm cuôl: ‘Sau klô tĭq! Sô saq lŭh tât gatŭq wŏq roc.’ <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />Lăm nŏq, lĕq săq khây ur drŭh palâng nŏq gĕh pre căh en sŭmmrăp ŭnh vơn de. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Vrêq heq, khây ur gala nhai bây khây ur vanŏh: ‘Wĭnh an khananh du ndêt yầu khây pôp de vồh, mvăc ŭnh khananh de mơch ngât en.’ <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />Aheq lăm âh sĭq vlâq, khây ur vanŏh nhai: ‘Phŭng pành đăng ôp bơh năm chĕq gĕh lôch an khananh bây khây pôp pà. Yăh vlơ, sô saq tât khây tamun tăch vro en vro an vơn vŏq.’ <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Aheq, sŭng lăm khây nĕh saq vro, sau klô tât, en khây vu lây sưndăc nggâm bây nĕh nŏq lăp sŭng war sa tăm sai, en lapông gĕh păng sĭq vlâq. <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" />En alưr nŏq, khây ur drŭh palâng tĭq khoi tât, nhai: ‘Ơ cô, ơ nơm nhi, wĭnh pơq lapông an khananh maq vồh.’ <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />Aheq lăm âh sĭq vlâq, nơm nhi nhai: ‘Nhâng, ănh nhai bây kha-ay, ănh đăng gưt kha-ay pà.’ <verse eid="MAT 25:12" /><verse number="13" style="v" sid="MAT 25:13" />Canŏq, căh iêh, mvăc pôp ŏh đăng gưt năr ha vadâq lây.<verse eid="MAT 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />Mvăc dân ca du mvu mơch saq vi ngai, nĕh gĕh cuôl khây dĭch nĕh de tât en dơp păch caya nơm de an khây nĕh. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Nĕh an tamun heq prăm talâng, nĕh tĭq var talâng, nĕh tơq du talâng — an ăp ndu bây prơn nơm de. En nĕh sô hao trong saq tât vi ngai. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Lăm nơm nhi saq en, nĕh cồ wŏq prăm talâng saq tăch vro don u jên nŏq en wŏng gĕh prăm talâng ndây. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Dân canŏq, nĕh cồ gĕh var talâng khoi wŏng gĕh var talâng ndây. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Cồ canŏq, nĕh cồ gĕh wŏq du talâng, lăm saq lŭh, đe khwai ntĕh en tâp jên nơm nhi nĕh de. <verse eid="MAT 25:18" /><verse number="19" style="v" sid="MAT 25:19" />Lăm vrêq, alưr nŏq gŏq năr jong, nơm nhi khây dĭch nŏq de sĭq tât en sên sirăq sibưt bây khây nĕh. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Lăm tât mơch, nĕh cồ wŏq prăm talâng gĕh văt bây prăm talâng ndây, nhai pành: ‘Ơ nơm nhi, cô gĕh dơp an ănh prăm talâng. Cồ canŏq wĭnh sên heq, ănh gĕh ôp lŭh wŏq prăm talâng.’ <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />Nơm nhi nĕh de nhai bây nĕh: ‘Gĕh lŭng nŏq, ơ dĭch yăh sŏng nggâm mbêr nuih! Pôp gĕh mbêr nuih sŭng var pe vrŭq. Ănh nhâng dơp an pôp sên groi vlơ gŏq vrŭq. Vrêq saq lăp sŭng sinlơ vui nơm nhi pôp de.’ <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />Tamun cồ gĕh var talâng, lăm tât mơch, khoi nhai: ‘Ơ nơm nhi, cô gĕh dơp ănh iưn var talâng, cồ canŏq wĭnh sên heq, ănh gĕh ôp lŭh gĕh var talâng wŏq.’ <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />Nơm nhi nĕh de nhai bây nĕh: ‘Gĕh lŭng nŏq, ơ dĭch yăh sŏng nggâm mbêr nuih! Pôp gĕh mbêr nuih vlơ var pe vrŭq. Ănh nhâng dơp an pôp sên groi vlơ gŏq vrŭq. Vrêq saq lăp sŭng sinlơ vui nơm nhi pôp de.’ <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />Hôm nĕh cồ wŏq du talâng, khoi saq tât, gĕh nhai: ‘Ơ nơm nhi, ănh gưt cô, pành cô cồ du mvu tamun đăng dê, chit u gatŭq nơm đăng swây, en jwŏq u gatŭq nơm đăng vrŏh lŭh. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Mvăc phŭng candŭh, nŏq lăm saq lŭh, ănh gĕh tăm pôn talâng cô de u tĕh ntĕh. Wĭnh sên heq, cô wŏq păch cô de vồh.’ <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />Cồ canŏq lăm âh sĭq vlâq, nơm nhi nĕh de nhai bây nĕh: ‘Ơ dĭch chin'hâc bây n'niêt tĭq! Pôp gưt pành ănh chit u gatŭq ănh đăng tăm swây bây jwŏq u gatŭq cồ ănh đăng vrŏh lŭh. <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Canŏq, dip lŭh pôp căh gưt văt jên ănh de chĕq u nhi jơ bây an nham jên, en lăm tât, nŏq nhâng ănh sŏq gĕh sĭq vlâq jên tơm ănh de nggâm jên pành dông. <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Canŏq, căh nhŭp talâng ntrăch a nĕh heq en dơp jên nŏq an tamun cồ gĕh mât talâng. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Mvăc bây tamun cồ gĕh, nŏq ăp sinlơ gĕh paq an — en hôm gĕh vênh canăh wŏq. Cồ canŏq bây tamun cồ đăng gĕh, nŏq sŏng păch cồ nĕh gĕh nŏq gĕh nhŭp saq ntrăch a nĕh. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />En căh hwât nĕh cồ dĭch đăng don gĕh nŏq lăp gatŭq jingo u maq ling, cồ gatŭq gĕh sinlơ nhim rơp bây căp sêch.’<verse eid="MAT 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />Hôm lăm Con Tamun tât sŭng sinlơ sindraq sindil Nĕh de nggâm lĕq săq khây con gŭn bây Nĕh, en lăm nŏq, Nĕh gŭq vlơ gatŭq sindraq sindil Nĕh de. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Lĕq săq khây văl ganơ gĕh vatom a vôq măt Siđăch, en Siđăch paklăh khây nĕh lŭh bây ndăng ganai, dân ca tamun tê paklăh dive lŭh ntrăch a ve ve. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Siđăch chĕq dive gŭq u maq ma nơm, hôm ve ve gŭq u maq gyau. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Alưr nŏq, Vatau nhai bây khây vu lây gŭq u maq ma nĕh de: ‘Ơ khây tamun cồ gĕh Vap Ănh paq sinlơ yăh, tât heq vồh, vrêq wŏq Daq Trôq gĕh sŭmmrăp sưndăc an vơn a lăm tatao tơm dưnya. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Mvăc lăm Ănh pangot, nŏq khây con an Ănh sa; Ănh can'hir, nŏq khây con an Ănh huch; Ănh cồ tamuôi saq trong, nŏq khây con wŏq roc Ănh; <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Ănh sirôq pôq rang, nŏq khây con tachuq an Ănh; Ănh jirâng, nŏq khây con ranô ranăm an Ănh; Ănh gŭq sŭng nhi jingo, nŏq khây con tât bây Ănh.’ <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />Lăm nŏq, khây tamun yăh sŏng âh sĭq vlâq bây Siđăch, pành: ‘Cŭh Siđăch, khananh gĕh sây Cô pangot nŏq an sa, ha pành can'hir nŏq an huch lăm lây lŏh? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />En khây con gĕh sây Cô dân ca tamuôi nŏq wŏq roc, ha sirôq pôq rang nŏq chuq an sŭng lăm lây? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />En khây con gĕh sây Cô jirâng ha gŭq sŭng nhi jingo lăm lây nŏq tât bây Cô?’ <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Lăm âh camvŭm, Vatau nhai bây khây nĕh: ‘Nhâng, Ănh nhai bây khây con, sên lăp ăp vrŭq khây con gĕh ôp an muôi sŭng khây tamun ken dông lĕq sŭng khây pôp ŏh Ănh de heq, nŏq khây con gĕh ôp an Ănh iưn en.’ <verse eid="MAT 25:40" /><verse number="41" style="v" sid="MAT 25:41" />En nŏq, Vatau khoi nhai bây khây tamun gŭq u maq gyau: ‘Saq ngai ntrăch a Ănh, ơ khamay cồ vlam raq pandai tĭq, lăp sŭng ŭnh gơih nggơih cồ gĕh sŭmmrăp sưndăc an chaq sŭq nggâm khây chaq ganrơh nĕh de chĕq. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Mvăc Ănh pangot nŏq khamay đăng an Ănh sa; Ănh can'hir nŏq khamay đăng an Ănh huch; <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Ănh cồ tamuôi nŏq khamay đăng wŏq roc Ănh; sirôq pôq rang nŏq khamay đăng chuq an Ănh; ji râng bây gŭq sŭng nhi jingo, nŏq khamay đăng ranô ranăm Ănh.’ <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />Lăm nŏq, khây nĕh khoi âh, pành: ‘Ơ Siđăch, khananh gĕh sây Cô pangot, ha can'hir, ha dân ca tamuôi, ha sirôq pôq rang, ha jirâng, ha gŭq sŭng nhi jingo lăm lây nŏq đăng tachŏq Cô lòh?’ <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />Canŏq en, Vatau âh camvŭm khây nĕh, pành: ‘Nhâng, Ănh nhai bây khamay, sên lăp ăp vrŭq cồ khamay đăng ôp an muôi sŭng khây tamun ken dông lĕq u khây nĕh heq, nŏq khamay đăng ôp an Ănh en.’ <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />Khây nĕh nŏq nhâng saq lăp sŭng sinlơ lŏh sat wân lawân, hôm khây tamun yăh song gĕh lăp sŭng sinlơ rĭh gơih nggơih.”<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Vrŭq gĕh ôp lŭh lăm Siđăch Yêsu nhai sŏng lĕq khây camvŭm nŏq, Nĕh nhai bây khây con tuyh Nĕh de: <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“Pôp ŏh gưt pành hôm var năr wŏq tât năr lễ Saq Ntrăch, en Con Tamun gĕh dơp chĕq vu pâng jimâng vlơ chhơ pagăn.” <verse eid="MAT 26:2" /><verse number="3" style="v" sid="MAT 26:3" />Lăm nŏq, khây gru sipăm măq bây khây cô camvĭnh sŭng con văl gĕh vatom sĭq vlâq u sŭng nhi gru sipăm măq, săq pành Cai-phe. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Khây nĕh tăm nhai simơ chĕq don camvŭm mvâr, khây nĕh nhŭp jơ gĕh Siđăch Yêsu en tachưt Nĕh chĕq. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Cồ canŏq khây nĕh nhai: “Đăng gal sŭng dŏq lễ, chĕq sinlơ minsôc minsac đăng gĕh ôp lŭh sŭng ndăng con văl.”<verse eid="MAT 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Vrêq heq, lăm Siđăch Yêsu gŭq u Bê-tha-ni, sŭng nhi Si-môn, cồ tamun ji rawŏq ramanh, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />du mvu tamun ur văt lâm pađŭng gŏch vadâng sinlơ jrơu nthôr chhât jên lŭng saq tât mơch Siđăch, en nĕh tŭh vlơ camvôq Siđăch, sŭng lăm gŭq sa. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />Aheq lăm sây canŏq, khây con tuyh măq nuih, nhai: “Valay chĕq caheq chĕq ôp păch lây? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Mvăc jrơu nthôr heq văt tăch wŏng gĕh gŏq jên en paq an tamun lŏh sat.” <verse eid="MAT 26:9" /><verse number="10" style="v" sid="MAT 26:10" />Cồ canŏq gưt sinlơ heq, Siđăch Yêsu nhai bây khây nĕh: “Lŭh pôp ŏh ôp pŏh păt tamun ur heq lòh? Mvăc nĕh gĕh ôp du vrŭq yăh an Ănh. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Mvăc pôp ŏh wân lawân gĕh tamun lŏh sat gŭq bây vơn, sŭng lăm đăng gal pôp ŏh wân lawân gĕh Ănh. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Mvăc lăm pôp ur tŭh jrơu heq vlơ nơm Ănh, nĕh gĕh ôp canŏq an vrŭq tâp tang Ănh nŏq. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Nhâng, Ănh nhai bây pôp ŏh, hê gatŭq lây Sipơp Yăh heq gĕh nhai lŭh vlơ lam dưnya, nŏq vrŭq pôp ur heq gĕh ôp khoi gĕh nhai tât sŭng sinlơ căh sĭq nĕh.”<verse eid="MAT 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Lăm nŏq, muôi sŭng mât var con tuyh, săq pành Yu-đa Ich-ca-ri-ôt, lăm saq tât bây khây gru sipăm măq, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />gĕh nhai: “Khây cô sưndăc nuih talaq trŏh an ănh vagŏq, en ănh dơp Nĕh nŏq an khây cô?” Aheq, khây nĕh wĕh an nĕh pe jât păndŏh jên. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />En a lăm nŏq, nĕh pơq vôq wŏng trong chĕq nhŭp dơp Siđăch.<verse eid="MAT 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Lăm vrêq, sŭng năr di muôi lễ Banh Đăng Gĕh Tape de, khây con tuyh tât mơch Siđăch Yêsu, nhai: “Gru cơnh khananh sŭmmrăp an Gru sa lễ Saq Ntrăch u vi lây?” <verse eid="MAT 26:17" /><verse number="18" style="v" sid="MAT 26:18" />En Siđăch nhai: “Saq lăp sŭng palây, tât bây du mvu nŏq en nhai bây nĕh: ‘Gru nhai: “Vadâq Ănh de cồ mơch lŭng en; Ănh ôp lễ Saq Ntrăch u nhi pôp de nggâm bây khây con tuyh Ănh de.”’” <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Khây con tuyh ôp dân ca Siđăch Yêsu pân pađau khây nĕh, en khây nĕh sŭmmrăp lễ Saq Ntrăch.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Vrêq heq, lăm vi mau tât, Siđăch gŭq sa nggâm bây mât var con tuyh. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Sŭng lăm khây nĕh sa war, Siđăch nhai: “Nhâng, Ănh nhai bây pôp ŏh pành du mvu sŭng pôp ŏh chŏl sĭq vlâq Ănh.” <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />Mvăc yưr nuih âr, ăp ndu pơq camvŭm nhai bây Siđăch: “Ơ Cô, đăng gal cồ con gal đăng?” <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />Aheq chĕq âh camvŭm, Siđăch nhai: “Tamun gĕh plŏng ti nơm lăp sŭng nggan simơ bây Ănh, nĕh nŏq cồ chŏl sĭq vlâq Ănh. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Nhâng Con Tamun gĕh lŭh saq, bây camvŭm gĕh chêr sĭq Nĕh, cồ canŏq lŏh sat an nĕh nŏq, payh ơ nĕh nŏq Con Tamun vlam vu chŏl sĭq vlâq! Hê nĕh nŏq đăng gĕh dĕh lŭh nŏq yăh dông an nĕh.” <verse eid="MAT 26:24" /><verse number="25" style="v" sid="MAT 26:25" />A heq lăm âh sĭq vlâq, Yu-đa, tamun chŏl Siđăch, nhai: “Ơ Gru, đăng gal cồ ănh uy?” Siđăch nhai bây nĕh: “Nơm pôp nhai lŭh en nŏq.”<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Vrêq heq, sŭng lăm khây nĕh sa war, lăm nhŭp bănh bây may mo en, Siđăch Yêsu gĭq bănh lŭh. En lăm dơp an khây con tuyh, Siđăch nhai: “Wŏq en sa chĕq vồh. Heq cồ rup swan Ănh de.” <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />En lăm nhŭp nggan bây may mo en, Siđăch dơp an khây nĕh, nhai: “Lĕq săq căh huch u nggan heq. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Mvăc heq cồ n'ham tăm lăp ti Ănh de gĕh tŭh lŭh an gŏq săq tamun chĕq sŭmmrăp an sinlơ sat rao bưn bap. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Cồ canŏq Ănh nhai bây pôp ŏh a lăm vrêq heq, Ănh nhâng bâng đăng huch u daq ramvu heq an tât năr nŏq, cồ lăm Ănh huch daq ramvu me simơ bây pôp ŏh sŭng Daq Trôq cồ Vap Ănh de.”<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Lăm adŏh camvŭm gŭn en, khây nĕh lŭh saq tât gŭng Ô-liu. <verse eid="MAT 26:30" /><verse number="31" style="v" sid="MAT 26:31" />Lăm nŏq, Siđăch Yêsu nhai bây khây nĕh: “Sŏng sŭng vanăng heq, lĕq săq pôp ŏh tachĭh jâng vông hlŏq payh ơ Ănh, mvăc camvŭm gĕh chêr:</para>
  <para style="q" vid="MAT 26:31">‘Ănh gĕh pâm tamun tê</para>
  <para style="q" vid="MAT 26:31">en dive sŭng mintan taprăh taprăng.’<verse eid="MAT 26:31" /></para>
  <para style="b" />
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />En alưr nŏq lăm Ănh gĕh ôp an tao rĭh sĭq vlâq, Ănh saq lor pôp ŏh tât Ga-li-lê.” <verse eid="MAT 26:32" /><verse number="33" style="v" sid="MAT 26:33" />Aheq âh sĭq vlâq, Phi-e-rơ nhai bây Siđăch: “Cồ lĕq săq gĕh vlam tachĭh jâng u Gru, ănh heq đăng lăm lây vlam tachĭh jâng vông hlŏq hôq.” <verse eid="MAT 26:33" /><verse number="34" style="v" sid="MAT 26:34" />Siđăch Yêsu nhai bây nĕh: “Nhâng, Ănh nhai bây pôp, pành sŭng sŏng vanăng heq, lor a lăm iêr nrau, pôp di mo Ănh pe dâq.” <verse eid="MAT 26:34" /><verse number="35" style="v" sid="MAT 26:35" />Phi-e-rơ nhai bây Siđăch: “Tât daq hê piêt ănh phải chưt bây Gru, ănh nhâng bâng đăng di mo Gru.” En lĕq săq khây con tuyh khoi nhai dân canŏq.<verse eid="MAT 26:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />A lưr nŏq, Siđăch Yêsu saq nggâm bây khây nĕh tât du gatŭq gĕh cuôl pành Gêt-sê-ma-nê, en Siđăch nhai bây khây con tuyh: “Căh gŭq u heq sŭng lăm Ănh tât tu tĭq vơu ngwân.” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Alưr nŏq, lăm iau Phi-e-rơ nggâm var ndu con klô Sê-bê-đê de saq bây, Siđăch pơq vôq chăng jicôr nggâm canjŏq canjơng sŭng chhu vôq. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Lăm nŏq, Siđăch nhai bây khây nĕh: “Wênh nggui Ănh jicôr lŭng an tât chưt. Căh gŭq sĭq vlâq u heq bây iêh simơ bây Ănh.” <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />Lăm saq ngai ndêt wŏq, Siđăch gasưt măt nơm jưr, vơu ngwân bây nhai: “Ơ Vap Con de, hê vrŭq heq cồ gĕh, wĭnh an nggan heq saq ntrăch a Con. Cồ canŏq, đăng dân ca Con cơnh, nŏq cồ ca Vap.” <verse eid="MAT 26:39" /><verse number="40" style="v" sid="MAT 26:40" />En Siđăch tât bây khây con tuyh en sây khây nĕh vĭq, nŏq Siđăch nhai bây Phi-e-rơ: “Canŏq pôp ŏh đăng iêh gĕh bây Ănh du vadâq uy? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Căh iêh bây vơu ngwân chĕq pôp ŏh đăng tarŏh lăp sinlơ lamvoch. Cồ nhâng nuih talaq gŭn măn sưndăc lŭng, sŭng lăm rup swan nĕh la-ui.” <verse eid="MAT 26:41" /><verse number="42" style="v" sid="MAT 26:42" />Du dâq wŏq, lăm saq ntrăch sŭng dâq di var, Siđăch vơu ngwân, pành: “Ơ Vap Con de, hê vrŭq heq đăng saq ntrăch gĕh an tât lăm Con huch nggan nŏq, wĭnh nuih cơnh Vap de gĕh jêng.” <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Alưr nŏq, lăm Siđăch tât du dâq wŏq, sây khây nĕh vĭq, mvăc măt khây nĕh khlêp lŭng èn. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />En du dâq wŏq, lăm chĕq khây nĕh sĭq vlâq en saq, Siđăch vơu ngwân sŭng dâq di pe, nhai wŏq khây camvŭm dân canŏq. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Alưr nŏq, Siđăch tât bây khây con tuyh en nhai bây khây nĕh: “Pôp ŏh hôm vĭq bây lu lŏh hà? Sên tĭq, vadâq tât mơch en, en Con Tamun gĕh dơp lăp ti khây văl bưn bap. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Tao yăq vồh, yăh vlơ vơn saq vŏq. Sên heq, tamun chŏl sĭq vlâq Ănh saq tât en.”<verse eid="MAT 26:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Sŭng lăm Siđăch hôm nhai, nŏq sên tĭq, Yu-đa, muôi sŭng mât var con tuyh, tât, en simơ bây nĕh cồ du mintan tamun gŏq săq nggâm bây pĭh bây gadông, a vi khây gru sipăm măq bây khây cô camvĭnh sŭng con văl. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Lăm vrêq, nĕh cồ chŏl sĭq vlâq Siđăch gĕh an khây nĕh du păch tayh, pành: “Vu lây cồ ănh sôc en nŏq cồ nĕh. Căh nhŭp nĕh.” <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Sŏng lăm nŏq, lăm tât mơch Siđăch Yêsu, nĕh nhai: “Wĭnh khây Gru!” En nĕh sôc Siđăch. <verse eid="MAT 26:49" /><verse number="50" style="v" sid="MAT 26:50" />Aheq Siđăch Yêsu nhai bây nĕh: “Ơ ganai, payh ơ vrŭq heq nŏq pôp tât heq yo.” Alưr nŏq, lăm tât mơch, khây nĕh lŭh ti vlơ Siđăch Yêsu en nhŭp jơ Siđăch. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />En sên tĭq, muôi sŭng khây tamun saq bây Siđăch Yêsu, lăm iơq ti lŭh, tăq pĭh nơm de en păh dĭch gru sipăm măq de, păh chăch du maq tôr nĕh de. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Lăm nŏq, Siđăch Yêsu nhai bây nĕh: “Doq sĭq vlâq pĭh pôp de sĭq gatŭq nĕh de, mvăc lĕq săq khây vu lây văt pĭh nhâng chưt a pĭh. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Ha pôp sinâng pành Ănh đăng gĕh prơn gŭn cuôl wĭnh Vap Ănh, en Nĕh pađăr tât an Ănh vlơ mât var mintan bĭnh ya con gŭn sŏng lăm vrêq ha? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Hê canŏq, ôp bơh năm khây camvŭm sŭng sirăq Gŭn gĕh jêng, pành vrŭq phải gĕh ôp lŭh dân canŏq?” <verse eid="MAT 26:54" /><verse number="55" style="v" sid="MAT 26:55" />Sŭng vadâq nŏq, Siđăch Yêsu nhai bây mintan con văl gŏq săq: “Khây cô saq lŭh nggâm bây pĭh bây gadông chĕq nhŭp Ănh dân ca chŏl sĭq vlâq du mvu sa avlăh canŏq? Ăp năr, Ănh gŭq pađau tămti sŭng Nhi Cŭh nŏq khây cô đăng nhŭp Ănh. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Cồ canŏq ăp vrŭq heq gĕh ôp lŭh chĕq khây sinlơ chêr khây cô tiêng tri de gĕh jêng.” Lăm nŏq, chĕq Siđăch sĭq vlâq en, lĕq khây con tuyh lôt du tăm pôn.<verse eid="MAT 26:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Lăm vrêq, khây tamun nhŭp Siđăch Yêsu têch Nĕh tât an gru sipăm măq Cai-phe, cồ gatŭq cồ khây gru pađau ravwŏq bây khây cô camvĭnh gĕh tăm vatom bây ndăng ganai. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Hôm Phi-e-rơ saq bây Siđăch a ngai an tât sân nhi gru sipăm măq. Lăm lăp sŭng di lăm en, nĕh gŭq jưr simơ bây khây congti chĕq sên vrŭh lŭh bơh năm. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />Vrêq heq, khây gru sipăm măq bây lĕq Vatom Tamun wŏng camvŭm candân mvâr chŏl sĭq vlâq Siđăch Yêsu, ôp bơh năm chĕq khây nĕh dơp Siđăch lăp dôih chưt. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />En khây nĕh đăng wŏng gĕh păch lây, cồ gĕh gŏq ndu tao yăq ôp candân mvâr. Aheq alưr nŏq, gĕh var ndu tĭq saq hao, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />gĕh nhai: “Nĕh heq gĕh nhai: ‘Ănh pâm talĭh gĕh Nhi Cŭh Cô Voq de en tatao sĭq vlâq sŭng pe năr.’” <verse eid="MAT 26:61" /><verse number="62" style="v" sid="MAT 26:62" />Lăm tao yăq, gru sipăm măq lŭp Siđăch: “Cô đăng âh camvŭm uy? Khây tamun heq ôp candân chŏl sĭq vlâq Cô sĭq vrŭq lây nŏq?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Cồ canŏq Siđăch Yêsu gŭq krap. Gru sipăm măq nhai bây Siđăch: “Cuôl săq Siđăch Trôq hôm rĭh, ănh săng Cô chĕq Cô nhai an khananh gưt nhâng gal Cô cồ Candranh Krit, Con Siđăch Trôq, ha đăng?” <verse eid="MAT 26:63" /><verse number="64" style="v" sid="MAT 26:64" />Siđăch Yêsu nhai bây nĕh: “Nhâng nơm cô gĕh nhai canŏq. Cồ canŏq, Ănh nhai an khây cô gưt, pơq vôq a lăm heq, khây cô nhâng gĕh sây Con Tamun gŭq u maq ti ma Candranh Prơn Gŭn, en jưr tât vlơ khây lawang tŭq trôq.” <verse eid="MAT 26:64" /><verse number="65" style="v" sid="MAT 26:65" />Lăm heq, gru sipăm măq hêch ao jong nơm de, nhai: “Nĕh nhai bap! Lŭh vơn hôm gŭq câp tamun candân wŏq? Sên tĭq, vrêq Khây cô gĕh chăng camvŭm nhai bap nŏq en. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Khây cô sinâng bơh năm?” En lăm âh camvŭm, khây nĕh nhai: “Nhâng Nĕh chưt gal lŭng” <verse eid="MAT 26:66" /><verse number="67" style="v" sid="MAT 26:67" />Alưr nŏq, khây nĕh vrăch lăp măt Siđăch, pâm tôp Nĕh, en tavăh Nĕh, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />pành: “Heq Candranh Yơt Dưnya, nhai tiêng tri an khananh vồh. Vu lây cồ tamun pâm Cô?”<verse eid="MAT 26:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Lăm vrêq, Phi-e-rơ hôm gŭq u sŭng sân maq ling, en du mvu dĭch ur tât mơch nĕh, nhai: “Cô khoi gŭq simơ bây Yêsu, tamun Ga-li-lê nŏq.” <verse eid="MAT 26:69" /><verse number="70" style="v" sid="MAT 26:70" />Aheq nĕh di mo a vôq măt ăp ndu, pành: “Ănh đăng gưt ay nhai păch lây uy.” <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />En lăm saq lŭh tât lapông paga, du mvu dĭch ur ndây gĕh deng sây nĕh en nhai bây khây vu cồ gŭq u nŏq: “Nĕh heq gŭq simơ bây Yêsu, tamun Na-sa-ret heq.” <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />En nĕh di mo wŏq nggâm bây du camvŭm raq săq, pành: “Ănh đăng gưt tamun nŏq!” <verse eid="MAT 26:72" /><verse number="73" style="v" sid="MAT 26:73" />Cồ canŏq alưr nŏq ndêt, khây tamun cồ gĕh tao yăq u nŏq, lăm tât mơch, gĕh nhai bây Phi-e-rơ: “Nhâng cô khoi gŭq sŭng khây nĕh nŏq, mvăc sŏng cồ trong nhai cô de ôp an cô lŭh vôq.” <verse eid="MAT 26:73" /><verse number="74" style="v" sid="MAT 26:74" />Lăm nŏq, nĕh pơq vôq raq pandai, bây raq săq pành: “Ănh đăng gưt tamun nŏq,” en sŏng lăm nŏq, iêr nrau. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />En Phi-e-rơ căh sĭq vlâq khây camvŭm cồ Siđăch Yêsu gĕh nhai, pành: “Lor a lăm iêr nrau, pôp di mo Ănh pe dâq.” En lăm saq lŭh tu ling, nĕh nhim rơp sŭng sinlơ hơr tăng.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Lăm vrêq, a măng rŭq, lĕq khây gru sipăm măq bây khây cô camvĭnh sŭng con văl tăm nhai tăm sŭmmrăp trong chŏl sĭq vlâq Siđăch Yêsu chĕq tachưt Nĕh. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Lăm tănchăp Siđăch Yêsu sĭq vlâq en, khây nĕh iau Siđăch saq en dơp an ganwâr Phi-lat.<verse eid="MAT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Alưr nŏq, lăm Yu-đa, cồ tamun chŏl sĭq vlâq Siđăch, sây pành Siđăch bị ôp dôih, en payh ơ can'ai, nĕh trŏh sĭq vlâq pe jât păndŏh jên an khây gru sipăm măq bây khây cô camvĭnh, <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />nhai pành: “Ănh gĕh ôp bưn bap mvăc chŏl sĭq vlâq lăm dơp n'ham đăng gĕh bap.” Cồ canŏq khây nĕh nhai: “Gĕh ratênh lây tât khananh uy? Nơm may wŏq ayh vŏq.” <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" />En lăm hwât khây păndŏh jên lăp sŭng nhi cŭh, nĕh saq lŭh, en lăm saq ngai en, nĕh rêt nco chưt chĕq. <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />Vrêq heq, lăm dônh hao khây păndŏh jên, khây gru sipăm nhai: “Chĕq khây jên heq lăp sŭng nâm nhi cŭh cồ đăng dip gal mvăc nŏq cồ jên prơn n'ham de.” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Aheq lăm pơq vôq tăm nhai en, nŏq khây nĕh vro lôq tamăn tamun ôp uq de a khây jên nŏq an vrŭq tâp khây tamuôi. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Payh canŏq, tamăn nŏq gĕh cuôl pành “Tamăn N'ham” an tât năr heq. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Canŏq, camvŭm cồ gĕh nhai lor a tiêng tri Yê-rê-mi gĕh jêng, pành: “Khây nĕh nhŭp pe jât păndŏh jên, cồ jên văt lŭh vro du mvu, cồ tamun gĕh con sinau I-sơ-ra-ên tăch dâng nŏq jên, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />en khây nĕh dơp jên nŏq chĕq vro tamăn tamun ôp uq de, dân ca Cô Voq gĕh săng pađăr ănh.”<verse eid="MAT 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Vrêq heq, Siđăch Yêsu tao yăq a vôq măt ganwâr măq, en ganwâr nŏq lŭp Nĕh, pành: “Gal đăng Cô cồ vatau văl Yo-thai?” En Siđăch Yêsu nhai bây nĕh: “Cô nhai nŏq en vồh.” <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />En sŭng lăm Siđăch vlam yăq văq a khây gru sipăm măq bây khây cô camvĭnh, nŏq Nĕh đăng âh sĭq vlâq camvŭm lây. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />En nŏq, Phi-lat nhai bây Siđăch: “Cô đăng chăng gưt gŏq sinlơ cồ khây nĕh ôp candân chŏl sĭq vlâq Cô uy?” <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />En Siđăch đăng âh camvŭm nĕh, cồ a du camvŭm ngăn khoi đăng, tât daq ganwâr chăng ca-ayh cavon lŭng. <verse eid="MAT 27:14" /><verse number="15" style="v" sid="MAT 27:15" />Lăm vrêq, sŭng dŏq lễ, ganwâr măq gĕh du ravwŏq đŏh lŭh an convăl du mvu bap cồ khây nĕh săch sŏq. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />En sŭng lăm nŏq, vu gĕh trăng du mvu tamun bap canh jŏq gĕh săq pành Ba-ra-ba. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Canŏq, lăm khây con văl gĕh vatom sĭq vlâq, Phi-lat nhai bây khây nĕh: “Khây cô cơnh ănh đŏh vu lây an khây cô? Ba-ra-ba ha Yêsu, cồ tamun gĕh cuôl pành Candranh Yơt Dưnya?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Mvăc ganwâr gưt cồ nhâng khây nĕh dơp Siđăch an nĕh payh ơ nuih talaq tăm canănh. <verse eid="MAT 27:18" /><verse number="19" style="v" sid="MAT 27:19" />Vrêq heq, sŭng lăm nĕh gŭq vlơ gatŭq săc si, si-ur nĕh de gĕh pađăr dơp camvŭm nhai tât nĕh, pành: “Ngwân an đăng gĕh vrŭq lây văt tât an nơm nggâm an tamun yăh sŏng nŏq. Mvăc năr heq, ănh chăng hyoq chŏnh lŭng payh ơ du dŏq vĭq vơq sĭq tamun heq.” <verse eid="MAT 27:19" /><verse number="20" style="v" sid="MAT 27:20" />Hôm khây gru sipăm măq bây khây cô camvĭnh nhai rapôt con văl chĕq khây nĕh wĭnh đŏh an Ba-ra-ba saq, en tachưt Siđăch Yêsu. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Cồ canŏq chĕq âh sĭq vlâq, ganwâr măq nhai bây khây nĕh: “Khây cô cơnh ănh đŏh vu lây sŭng var ndu heq an khây cô?” En khây nĕh âh pành: “Ba-ra-ba.” <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" />Phi-lat nhai bây khây nĕh: “Canŏq, ănh gưt ôp păch lây bây Yêsu, cồ Tamun gĕh cuôl pành Candranh Yơt Dưnya heq?” Lĕq săq khây nĕh âh: “Nĕh phải gĕh pâng jimâng vlơ chhơ pagăn.” <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />Aheq ganwâr nhai: “Nŏq Nĕh gĕh ôp vrŭq chin'hâc lây?” Cồ canŏq, khây nĕh cuôl sec măq dông wŏq, pành: “Nĕh phải gĕh pâng jimâng vlơ chhơ pagăn.” <verse eid="MAT 27:23" /><verse number="24" style="v" sid="MAT 27:24" />Vrêq heq, Phi-lat, lăm sây pành nơm đăng ôp gĕh păch lây, en sŭng lăm nŏq, du dŏq minsôc minsac gĕh pành jêng, nŏq lăm an nhŭp daq en, nĕh rao ti nơm a vôq măt con văl bây nhai: “Ănh đăng gĕh bap sĭq n'ham tamun heq de. Nơm khây cô wŏq an vơn vŏq.” <verse eid="MAT 27:24" /><verse number="25" style="v" sid="MAT 27:25" />En lăm âh sĭq vlâq, lĕq săq con văl nhai: “N'ham Nĕh de gŭq vlơ khananh bây vlơ con sinau khananh.” <verse eid="MAT 27:25" /><verse number="26" style="v" sid="MAT 27:26" />Alưr nŏq, ganwâr đŏh Ba-ra-ba an khây nĕh, en lăm an pâm Siđăch Yêsu en, nĕh an têch Siđăch saq chĕq an vu pâng jimâng vlơ chhơ pagăn.<verse eid="MAT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Alưr nŏq, lăm têch Siđăch Yêsu lăp sŭng nhi ganwâr măq, khây congti sŭng bĭnh ya ganwâr măq de vatom sĭq vlâq a vôq măt Siđăch. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Alưr nŏq lăm đŏh jrŏh Siđăch, khây nĕh tachuq du păng ao paho vlơ Siđăch. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Lăm tanh du lâm đuôn a loq en, khây nĕh chĕq vlơ camvôq Siđăch, nggâm chhơ ramvŭng lăp ti ma Siđăch, en lăm chŏl nkrŭng jưr a vôq măt Siđăch, khây nĕh pagơq Siđăch, pành: “Cŭh vatau văl Yo-thai!” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />En lăm vrăch lăp Siđăch, khây nĕh nhŭp chhơ ramvŭng en pâm diêt vlơ camvôq Siđăch. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Lăm ôp pagơq Siđăch sŏng, khây nĕh đŏh ao ling lŭh en chuq lăp an Siđăch ao Nĕh de, en đưc Siđăch saq chĕq pâng jimâng vlơ chhơ pagăn.<verse eid="MAT 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Vrêq heq, sŭng lăm saq lŭh, khây nĕh sây du mvu a Si-ren, săq Si-môn, en khây nĕh nhŭp bây piêt chĕq nĕh tung chhơ pagăn Siđăch de. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Alưr nŏq lăm saq tât du gatŭq gĕh cuôl pành Gô-gô-tha, en gatŭq nŏq khoi cuôl pành “Tŭq Krang Vôq,” <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />khây nĕh an Siđăch huch alăc valâm bây klang măt tăng. Lăm layĕp, nŏq Siđăch đăng huch. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Vrêq heq, lăm pâng jimâng Siđăch vlơ chhơ pagăn en, khây congti tăm paq su ao Siđăch de a vrŭq tăm pol, <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />en khây nĕh cŏch jơ Siđăch lăm gŭq u nŏq. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />A maq vlơ camvôq Siđăch, khây nĕh chĕq dôih Siđăch de, gĕh chêr caheq: “Heq Cồ Yêsu, Vatau văl Yo-thai.” <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Lăm nŏq, gĕh var ndu sa avlăh bị pâng jimâng bây Siđăch, du mvu u maq ma bây du mvu u maq gyau. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Khây tamun saq găn pagơq Siđăch, ta-hwây vôq nơm <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />bây nhai: “Ơ Nĕh cồ pâm ta yaih Nhi Cŭh en ta tao sĭq vlâq sŭng pe năr tĭq, yơt nơm vơn chĕq! Hê may cồ con Siđăch Trôq, nŏq jưr ntrăch a chhơ pagăn chĕq vồh!” <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />Khoi dân canŏq, khây gru sipăm măq nggâm khây gru pađau ravwŏq bây khây cô camvĭnh, lăm pagơq Siđăch, gĕh nhai: <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“Nĕh gĕh yơt khây tamun ndây; nĕh đăng lôch prơn chĕq yơt nơm. Nĕh cồ vatau văl I-sơ-ra-ên de. Vrêq nĕh phải jưr ntrăch a chhơ pagăn, nŏq khananh tôq u nĕh. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Nĕh tôq camvân u Siđăch Trôq; vrêq chĕq Siđăch yơt nĕh hê Siđăch cơnh nĕh. Mvăc Nĕh gĕh nhai pành: ‘Ănh cồ con Siđăch Trôq de.’” <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Khoi dân canŏq, sŏng cồ khây tamun sa avlăh, cồ khây tamun bị pâng jimâng bây Siđăch, khây nĕh khoi pagơq Siđăch.<verse eid="MAT 27:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Lăm vrêq, a vadâq di prau, sinlơ jingo tât vlơ lam ntĕh an tât vadâq di sưn. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />En mơch vadâq di sưn, Siđăch Yêsu cuôl du camvŭm măq, pành: “Ê-li, Ê-li, la-ma sa-bach-tha-ni?” camvŭm nŏq cồ: “Ơ Siđăch Trôq Ănh de, Ơ Siđăch Trôq Ănh de, lŭh Cô lăq chĕq Ănh?” <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />Aheq lăm chăng canŏq, khây tamun cồ tao yăq u nŏq nhai pành: “Nĕh cuôl Ê-li.” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Sŏng lăm nŏq, du mvu sŭng khây nĕh, lăm lôt saq en nhŭp du vŭm paih, ndăng plŏng vênh sĕh sat ndăng tămviêq vlơ chhơ ramvŭng, ntŏng hao an Siđăch huch. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Sŭng lăm khây tamun cồ hôm sĭq vlâq nhai: “Valay nĕh. Chĕq vơn sên Ê-li gĕh tât yơt Nĕh đăng.” <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />Canŏq en, lăm cuôl hao du camvŭm măq wŏq, Siđăch Yêsu tŭh wênh nggui. <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />En sên tĭq, păng cŭmvai sŭng Nhi Cŭh tahec vlăh var a vlơ jưr tu tĕh, hôm ntĕh lănggưn, en tamô măq pachăh lŭh. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Gŏq ganăp gĕh pơq lŭh en gŏq rŭp swan khây tamun gŭn cồ vĭq gĕh cuôl tao rĭh sĭq vlâq, <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />En lăm lŭh ntrăch a ganăp alưr sinlơ tao rĭh sĭq vlâq Siđăch Yêsu de en, khây nĕh lăp sŭng palây gŭn, en lŭh an gŏq ndu sây. <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />Lăm vrêq, sây ntĕh lănggưn bây khây vrŭq gĕh ôp lŭh, cô var nggâm khây tamun gŭq cŏch jơ Siđăch Yêsu simơ bây nĕh chăng phŭng candŭh vyăq lŭng, nhai pành: “Nhâng, nĕh heq cồ Con Siđăch Trôq.” <verse eid="MAT 27:54" /><verse number="55" style="v" sid="MAT 27:55" />Lăm vrêq, gĕh gŏq tamun ur u nŏq, gŭq a ngai deng lân lân, nŏq cồ khây tamun gĕh saq bây Siđăch Yêsu, ôp vrŭq Siđăch a ntĕh Ga-li-lê. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Sŭng khây nĕh gĕh Ma-ri Ma-đơ-len, Ma-ri mê Ya-cơ bây Yô-sep, nggâm mê khây con klô Sê-bê-đê de.<verse eid="MAT 27:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Vrêq heq, lăm tât bwây mau jingo en, du mvu gan'hăp a A-ri-ma-thê tât, săq pành Yô-sep, en nơm nĕh heq khoi cồ con tuyh saq bây Siđăch Yêsu. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Alưr lăm tât vlam Phi-lat, nĕh wĭnh rup swan Siđăch Yêsu. Lăm nŏq, Phi-lat lŭh camvŭm chĕq dơp rup swan an nĕh iưn. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Lăm wŏq rup swan en, Yô-sep poq rup nŏq sĭq vlâq sŭng cŭmvai voq bây jrŏh, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />en chĕq rŭp lăp sŭng ganăp me nơm de cồ nĕh gĕh phaq sŭng chhŭng tamô. En lăm palăm du cŭc tamô măq păng mŭnh ganăp en, nŏq nĕh saq. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Lăm vrêq, u nŏq gĕh Ma-ri Ma-đơ-len bây du Ma-ri ndây wŏq, gŭq lăm măt bây chhŭng ganăp.<verse eid="MAT 27:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />En năr a lưr, nŏq cồ alưr năr Sŭm Mrăp, khây gru sipăm măq bây khây tamun Pha-ri-si gĕh tăm vatom sĭq vlâq a vôq Phi-lat, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />nhai pành: “Ơ ganwâr, khananh căh pành lăm hôm rĭh, nĕh cồ mvâr tĭq gĕh nhai: ‘A lưr pe năr, Ănh gĕh ôp an tao rĭh sĭq vlâq.’ <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Payh canŏq, wĭnh lŭh camvŭm chĕq ganăp gĕh jơ sên an di yăh an tât năr di pe. Mvăc hê đăng, khây con tuyh Nĕh de tât en, nhŭp khưn rup swan Nĕh de nggưt, en nhai bây con văl: ‘Nĕh gĕh ôp an tao rĭh sĭq vlâq a gatŭq chưt,’ nŏq sinlơ mvâr a lưr nĕh hôm rôch bach vlơ a lăm daq vôq.” <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />En nŏq Phi-lat nhai bây khây nĕh: “Khây cô gĕh congti cŏch jơ. Saq chĕq, căh jơ sên an di yăh dân ca khây cô gưt.” <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />En lăm saq, păng sưt tamô nggâm bây congti cŏch jơ, khây nĕh ôp an ganăp gĕh kranh gajăp.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Vrêq heq, a lưr năr Sa-bat, lăm ôi silang năr di muôi sŭng twâng mơch tât, gĕh Ma-ri Ma-đơ-len bây du Ma-ri ndây tât păng mơq ganăp. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Sên tĭq, du dŏq ntĕh lănggưn măq gĕh ôp lŭh, mvăc du con gŭn Cô Voq de, lăm a vlơ trôq rŏh jưr en tât mơch, palăm cŭc tamô en gŭq vlơ nŏq. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Lăm nŏq, maq ling khây cô nŏq cồ dân ca chhe lơp, hôm su ao nĕh de voq dân ca daq yŭh tamô. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Canŏq en, mvăc phŭng râm săq payh ơ con gŭn nŏq, khây congti cŏch jơ kranh nơm en jêng dân ca tamun chưt. <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />Aheq lăm pơq camvŭm, con gŭn nhai bây khây tamun ur: “Khây pôp vâng phŭng, mvăc ănh gưt pành khây pôp wŏng Siđăch Yêsu, cồ Candranh gĕh pâng jimâng. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Siđăch đăng gŭq u heq pà, mvăc Nĕh gĕh ôp an tao rĭh sĭq vlâq en, dip ca Nĕh gĕh nhai lor. Tât heq vồh, sên gatŭq cồ Nĕh gĕh vĭq. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />En lăm jăc jâng saq hao trong, căh đơm an khây con tuyh Nĕh de pành: ‘Siđăch gĕh ôp an tao rĭh sĭq vlâq a gatŭq chưt. En sên tĭq, Siđăch saq lor pôp ŏh ur klô tât Ga-li-lê. U nŏq, pôp ŏh ur klô gĕh vlam Nĕh.’ Sên heq, ănh gĕh nhai an khây pôp gưt en nŏq.” <verse eid="MAT 28:7" /><verse number="8" style="v" sid="MAT 28:8" />En lăm jăc jâng saq ntrăch a ganăp sŭng sinlơ phŭng candŭh nggâm sinlơ vui hơn âr, khây nĕh lôt saq chĕq nhai an khây con tuyh Siđăch de gưt. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Sên heq, Siđăch Yêsu vlam khây nĕh, nhai: “Khwây khây pôp!” En lăm tât mơch, khây nĕh ut jâng Siđăch en cŭh sưmvăh Nĕh. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />En nŏq, Siđăch Yêsu nhai bây khây nĕh: “Vâng phŭng vầy. Căh saq nhai an khây pôp ŏh Ănh chĕq khây nĕh hao trong saq tât Ga-li-lê, en u nŏq, khây nĕh gĕh vlam Ănh.”<verse eid="MAT 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Vrêq heq, sŭng lăm khây nĕh saq, sên heq, var pe ndu sŭng khây congti cŏch jơ, lăm saq lăp sŭng palây, gĕh đơm sĭq vlâq an khây gru sipăm măq ăp vrŭq gĕh ôp lŭh. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />En lăm gĕh tăm vatom bây khây cô camvĭnh, bây saq tât sinlơ tăm nhai en, khây nĕh an khây congti gŏq jên, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />săng pành: “Căh nhai: ‘Lăm tât sŭng dŭng măng, khây con tuyh Nĕh de gĕh can'hưn rŭp Nĕh de sŭng lăm khananh vĭq.’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />En hê vrŭq heq gĕh nhai tât tôr ganwâr măq, khananh wŏng camvŭm chĕq rapôt nĕh en ôp an khây pôp đăng vlam cađĕh cađông.” <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Canŏq en, lăm wŏq gĕh jên, khây nĕh ôp dân ca gĕh pân pađau. Vrŭq heq gĕh tăm riq tôr parang lŭh sŭng văl Yo-thai an tât năr heq.<verse eid="MAT 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Lăm vrêq, mât muôi con tuyh saq tât Ga-li-lê, tât vwây gŭng cồ Siđăch Yêsu gĕh pađau an khây nĕh. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />En lăm gĕh sây Siđăch, khây nĕh cŭh sưmvăh Siđăch, cồ canŏq, gĕh var pe ndu hôm nding ndăng phung. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Lăm saq tât mơch, Siđăch Yêsu nhai păch bây khây nĕh, pành: “Ăp prơn gŭn a vlơ trôq bây u tĕh ntĕh gĕh dơp an Ănh. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Payh canŏq, lăm saq, pôp ŏh căh ôp an lĕq khây văl jêng con tuyh, en ŭm vôq an khây nĕh sŭng săq Siđăch Vap, Siđăch Con bây Siđăch Wênh; <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />pađau tămti khây nĕh chĕq tôq jơ ăp sinlơ cồ Ănh gĕh pân pađau an pôp ŏh. En sên heq, Ănh gŭq bây pôp ŏh ăp năr an tât chôch dưnya.”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>