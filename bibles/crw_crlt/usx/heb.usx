  <book code="HEB" style="id">EN_CRLT crw_Chrau_ltr Thu Mar 27 2025 14:24:11 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Hebrews</para>
  <para style="toc1">Sirăq Hê-bơ-rơ</para>
  <para style="toc2">Hê-bơ-rơ</para>
  <para style="toc3">Heb</para>
  <para style="mt">Hê-bơ-rơ</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />Sŭng gŏq lăm vadâq bây sŏq gŏq a tanrong a đu đơm, alưr lăm Siđăch Trôq nhai bây khây cô jây don ju khây tiêng tri, <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />nŏq lăp khây năr chôch lŭt heq, Siđăch gĕh nhai bây vơn ju Con Siđăch, cồ Candranh Nĕh gĕh iơq hao ôp tamun wŏq sŏq tamơn păch sinlơ, khoi don ju Con nŏq, Siđăch răq panjêng lŭh ăp nggơih; <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />nhâng Con nŏq cồ sinlơ silang tagăh sindraq sindil bây sinlơ klăq jêng sŏng dip sĭq di tơm swan Siđăch de, nggâm bây nong iơq tamơn păch sinlơ don ju camvŭm prơn gŭn nơm de, en lăm ôp chhŏng vrŭq chhat rao bưn bap, Con nŏq gŭq maq ma Candranh Tăng Yot vlơ gatŭq prĭh; <verse eid="HEB 1:3" /><verse number="4" style="v" sid="HEB 1:4" />mvăc gĕh jêng măq mi ntrăch vlơ a con gŭn, Con gĕh wŏq sŏq săq cồ gĕh tan'hya mvưt mvơ gưt dâng lây dông a khây con gŭn nŏq. <verse eid="HEB 1:4" /><verse number="5" style="v" sid="HEB 1:5" />Mvăc Siđăch gĕh dâq lây nhai bây du mvu con gŭn lây pành:</para>
  <para style="q1" vid="HEB 1:5">“Con cồ Con Ănh je.</para>
  <para style="q1" vid="HEB 1:5">Năr heq Ănh dĕh lŭh Con”?</para>
  <para style="m" vid="HEB 1:5">En khoi nhai:</para>
  <para style="q1" vid="HEB 1:5">“Ănh nhâng cồ Vap nơm Nĕh,</para>
  <para style="q1" vid="HEB 1:5">en Nĕh nhâng cồ Con Ănh je”?<verse eid="HEB 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 1:6" />Nhâng cồ vlơ nŏq wŏq, lăm Siđăch văt Con Jibong saq lăp dưnya, Siđăch nhai: “Lĕq khây con gŭn Siđăch Trôq de cŭh sưmvăh Con nŏq.” <verse eid="HEB 1:6" /><verse number="7" style="v" sid="HEB 1:7" />Sĭq khây con gŭn, Siđăch nhai:</para>
  <para style="q1" vid="HEB 1:7">“Candranh cồ ôp khây con gŭn nơm jêng du mvrông chhal,</para>
  <para style="q1" vid="HEB 1:7">bây khây dĭch năc jêng khây vông ŭnh.”<verse eid="HEB 1:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />En sĭq bây Con nŏq, pành:</para>
  <para style="q1" vid="HEB 1:8">“Cŭh Siđăch Trôq, gatŭq vatau Siđăch de hôm diêt wân lawân,</para>
  <para style="q1" vid="HEB 1:8">bây prơn vatau sŏng yăh cồ prơn vatau daq Siđăch de.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />Siđăch sinđach sinlơ cồ sŏng yăh bây ncom sinlơ đăng tôq rĭh viêm chhât.</para>
  <para style="q1" vid="HEB 1:9">Payh sinlơ nŏq, Siđăch Trôq, nŏq cồ Siđăch Trôq Nĕh de,</para>
  <para style="q1" vid="HEB 1:9">gĕh văng an Nĕh daq pring vui hơn gŏq vlơ khây ganai Nĕh de.”<verse eid="HEB 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 1:10" />Bây “Cŭh Siđăch, lăm a daq vôq, Siđăch chĕq njâng ntĕh,</para>
  <para style="q1" vid="HEB 1:10">bây khây tăp trôq cồ vrŭq ti Siđăch de.<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />Trôq ntĕh cambet lĕq, en ayh Siđăch hôm diêt lawân,</para>
  <para style="q1" vid="HEB 1:11">lĕq săq khây nĕh lŭh dâm sam dân ca păng ao jong,<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />bây dân ca ao jong, Siđăch taklôn trôq ntĕh vlâq,</para>
  <para style="q1" vid="HEB 1:12">dân ca taklôn ao, trôq ntĕh tăm pagâl lĕq,</para>
  <para style="q1" vid="HEB 1:12">nhâng ayh Siđăch gât hôm diêt canŏq,</para>
  <para style="q1" vid="HEB 1:12">bây khay mva Siđăch Trôq de đăng chôch lĕq.”<verse eid="HEB 1:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />Payh canŏq, Siđăch gĕh nhai gĕh dâq lây nhai bây du mvu lây sŭng khây con gŭn:</para>
  <para style="q1" vid="HEB 1:13">“Tât gŭq ndăl ma Ănh</para>
  <para style="q1" vid="HEB 1:13">di tât lăm lây Ănh chĕq khây tamun cồ tăm chŏl Con de jêng lŭh păch iơq an jâng Con de”?<verse eid="HEB 1:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="HEB 1:14" />Đăng gal lĕq khây con gŭn nŏq cồ khây gŭn ôp vrŭq, gĕh săng pađăr an vrŭq ranô ranăm sĭq sinlơ tuyh twơ khây tamun cồ mơch wŏq sinlơ yơt hàh?.<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />Payh canŏq, vrŭq heq tacăh vơn gưt chĕq tôr dông wŏq sĭq khây sinlơ cồ vơn gĕh iêt chăng, phŭng đăng gưt nơm vơn tarui tapĭq ntrăch a nŏq. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />Mvăc hê camvŭm gŭn gĕh nhai lŭh ju khây con gŭn gĕh jêng gayh nhâng bâng, bây ăp sinlơ tĭh nggâm sinlơ cammlăh nhâng wŏq sinlơ sa dôih canjŏq lŭng, <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />nŏq mŏq vơn diêr ntrăch di gĕh lăm sên jot sinlơ wŏq yơt măq mi canŏq? Cồ sinlơ têch yơt nŏq, alưr lăm don Siđăch gĕh nhai lŭh lor lĕq, nŏq gĕh candân an khây vơn payh ơ khây tamun cồ gĕh chăng; <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />mvăc Siđăch Trôq khoi vatom simơ chĕq candân bây khây nĕh a khây vrŭq chin'hâu, sinlơ krăq krây, nggâm gŏq vrŭq prơn gŭn tăm ca-ayh, nggâm bây sinlơ paq an Siđăch Wênh de bây nuih cơnh Siđăch.<verse eid="HEB 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />Mvăc đăng gal chĕq ân an khây con gŭn cồ Siđăch Trôq nhŭp phlâq dưnya mơch tât nŏq, cồ dưnya vơn gĕh tăm nhai tât nŏq, <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />Măt ndây, gĕh tamun ôp candân u tŭq lây nŏq, pành:</para>
  <para style="q1" vid="HEB 2:6">“Con tamun ade păch lây, en lŭh Siđăch chĕq nuih sĭq nĕh,</para>
  <para style="q1" vid="HEB 2:6">ha con tamun ade vu lây, lŭh Siđăch sên ranăm tât nĕh?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />Siđăch chĕq tamun can'hâm dông a khây con gŭn sŭng du khay mva dêh nŏq vòq;</para>
  <para style="q1" vid="HEB 2:7">Siđăch ndau đuôn vatau an tamun sŭng sinlơ sindraq sindil bây iơq hao prĭh.<verse eid="HEB 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 2:8" />Siđăch chĕq ăp vrŭq sinlơ atĕh jâng tamun.”</para>
  <para style="p" vid="HEB 2:8">Mvăc sŭng lăm nhŭq phlâq ăp sinlơ, Siđăch chĕq đăng du vrŭq sinlơ lây cồ đăng tôq iêt Nĕh. Cồ canŏq vrêq heq vơn khoi hôm ndŏh sây ăp sinlơ tôq chăng nĕh uy, <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />cồ canŏq vơn gĕh sây Siđăch Yêsu, Candranh cồ gĕh chĕq gŭq a can'hâm a khây con gŭn sŭng du khay mva dêh nŏq ngăn, gĕh ndau đuôn vatau sŭng sinlơ sindraq sindil bây gĕh iơq prĭh payh ơ sinlơ lŏh sat sŭng sinlơ chưt Siđăch de, chĕq don sinăc yăh Siđăch Trôq, Nĕh dân gưt sinlơ chưt ala an ăp du. <verse eid="HEB 2:9" /><verse number="10" style="v" sid="HEB 2:10" />Mvăc Siđăch Trôq, Candranh cồ payh a Nĕh ăp vrŭq gĕh jêng gayh bây don u Siđăch ăp vrŭq jêng gayh, chĕq têch văt gŏq con tât sinlơ sindraq sindil, nŏq cồ vrŭq ôp nhâng dip gal lăm ôp an Candranh Ôp Vôq sinlơ têch yơt khây nĕh de jêng vênh lôch sŭng sinlơ minlŏh minsat. <verse eid="HEB 2:10" /><verse number="11" style="v" sid="HEB 2:11" />Mvăc lawân Candranh cồ ôp soch jrŏh nggâm lawân lĕq khây tamun cồ gĕh ôp soch jrŏh gĕh lŭh simơ a du vôl. Payh ơ vrŭq heq, Siđăch đăng prênh mŭnh chĕq cuôl khây nĕh pành pôp ŏh nơm, <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />lăm nhai:</para>
  <para style="q1" vid="HEB 2:12">“Con nhai lŭh sĭq săq Siđăch an pôp ŏh Con;</para>
  <para style="q1" vid="HEB 2:12">Con nhâng adŏh payom Siđăch u vôq măt khây nĕh.”<verse eid="HEB 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />En du dâq wŏq:</para>
  <para style="q1" vid="HEB 2:13">“Ănh nhâng tôq camvân u Cô Voq.”</para>
  <para style="m" vid="HEB 2:13">En nhai wŏq:</para>
  <para style="q1" vid="HEB 2:13">“Sên heq, ănh bây khây con se cồ Siđăch Trôq gĕh paq an Ănh iưn.”<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />Payh canŏq, mvăc khây con se gĕh simơ du rup n'ham, nŏq Siđăch khoi gĕh phần sŭng nơm simơ du rup n'ham dân canŏq chĕq don ju sinlơ chưt nơm de, Siđăch nhâng ôp an chưt lawăch nĕh cồ văt vôq sinlơ chưt, nŏq cồ chaq yang tĭq, <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />bây lôch prơn yơt ntrăch khây tamun nŏq, nŏq cồ ăp ndu lây hôm mrĭh sŭng sinlơ phŭng candŭh sĭq sinlơ chưt, cồ vaih ôp dĭch tăm ratênh. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />Mvăc nhâng canŏq, đăng gal Siđăch sên grô grăm khây con gŭn, palâq vlâq Siđăch jơ sên chhe njang Ap-ra-ham de, <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />payh canŏq Siđăch ôp nơm jêng lŭh dân ca pôp ŏh nơm sŭng ăp ti singging, chĕq Siđăch jêng gayh sipăm măq cồ uĕh sinđach nggâm du nuih tôr sĭq bây khây vrŭq jan dăh sĭq Siđăch Trôq cồ du vrŭq di tơm tănlŭh sinăc yăh vlơ bưn bap văl Siđăch de. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />Alưr lăm wŏq sinlơ lamvoch, Siđăch lôch prơn nong iơq khây vu lây cồ vlam sinlơ lamvoch, mvăc payh nơm Siđăch dân gưt diêt vrŭq nŏq.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />Payh canŏq, ơ khây pôp ŏh jrŏh soch, cồ khây tamun tăm lăp ti sŭng sinlơ cuôl panh gŭn gayh, căh chĕq nuih tât Nĕh cồ Siđăch Pađăr nggâm Gru Sipăm Măq sĭq camvŭm candân vơn de, nŏq cồ Siđăch Yêsu, <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />lăm du nuih talaq bây Candranh cồ iơq Nĕh hao, khoi dân ca Môi-se sŭng nhi Siđăch Trôq. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />Mvăc Candranh heq gĕh wŏq pành cồ tăm dip bây sinlơ sindraq sindil măq mi dông a Môi-se, dân ca tamun tatao nhi gĕh măq dông vagưt dâng lây lăm tăm wĕh bây rot nhi. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />Mvăc ăp rot nhi gĕh tatao hao don du mvu lây nŏq, sŭng lăm Siđăch Trôq cồ Candranh sun lŭh ăp vrŭq. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />Môi-se du nuih talaq dân ca dĭch năc sŭng rot nhi Siđăch Trôq de, chĕq dân ca du camvŭm candân sĭq khây sinlơ gĕh nhai tât sŭng năr tan'hui. <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />Cồ canŏq Siđăch Yơt Dưnya, dân ca du Mvu Con sŭng nhi Siđăch Trôq de (vơn heq cồ nhi Nĕh de hê vơn jơ kranh nuih talaq tôq gân bây payh lơ vôq sĭq sinlơ camvân jăp nơm de). <verse eid="HEB 3:6" /><verse number="7" style="v" sid="HEB 3:7" />Payh canŏq, nhâng dip ca Siđăch Wênh gĕh nhai:</para>
  <para style="q1" vid="HEB 3:7">“Năr heq, hê khây con chăng camvŭm Siđăch,<verse eid="HEB 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 3:8" />nŏq vâng ôp kranh nuih talaq khây con</para>
  <para style="q1" vid="HEB 3:8">dân ca lăm tăm chŏl,</para>
  <para style="q1" vid="HEB 3:8">di chôch khay mva cồ long găn Siđăch u tamăn singot,<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />cồ gatŭq cô jây khây con gĕh long găn Ănh ju vrŭq ôp jilŏq nuih,</para>
  <para style="q1" vid="HEB 3:9">en khây nĕh sây dân u măt khây vrŭq ôp Ănh je<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />sŭng puôn jât mva. Payh canŏq, Ănh hao nuih vyăq lŭng bây khây nggơih nŏq, bây</para>
  <para style="q1" vid="HEB 3:10">Ănh pành: ‘Khây nĕh gât chĕq sinlơ lamvoch tih wil sŭng nuih talaq nơm,</para>
  <para style="q1" vid="HEB 3:10">en khây nĕh đăng singgal lŭh khây tanrong Ănh je.’<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />Dân ca Ănh gĕh raq săq sŭng lăm hao nuih nơm de:</para>
  <para style="q1" vid="HEB 3:11">‘… Khây nĕh đăng gĕh lăp sŭng sinlơ lu lŏh Ănh je!’”<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />Ơ khây pôp ŏh, căh jơ nơm, vaih cồ nuih talaq đăng tôq viêm chhât phŭt lŭh u vu lây nŏq sŭng ndăng pôp ŏh, nŏq cồ tŭq tamun tabayh ngai ntrăch a Siđăch Trôq cồ rĭh wân lawân. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />Cồ canŏq, căh jrông jrâng ndăng ganai sŭng ăp năr, di tât lăm lây khoi hôm gĕh cuôl pành “năr heq,” chĕq đăng gĕh vu lây sŭng ndăng pôp ŏh bị ôp an pơh kranh payh a sinlơ palôm tagat bưn bap de. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />Mvăc vơn gĕh jêng khây tamun tăm lăp ti Siđăch Yơt Dưnya de, payh cồ vơn gât jơ di jăp alăm daq vôq nuih talaq kram gân nơm de di tât năr chôch lŭt, <verse eid="HEB 3:14" /><verse number="15" style="v" sid="HEB 3:15" />dân ca sinlơ gĕh nhai:</para>
  <para style="q1" vid="HEB 3:15">“Năr heq, hê khây con chăng camvŭm Siđăch,</para>
  <para style="q1" vid="HEB 3:15">vâng ôp kranh nuih talaq khây con</para>
  <para style="q1" vid="HEB 3:15">dân ca sŭng vadâq minsôc minsac.”<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />Mvăc khây vu lây jilŏq nuih Siđăch alưr lăm iêt chăng? Đăng gĕh vu ndây lây ayh cồ lĕq săq khây tamun gĕh lŭh ntrăch a Ai-câp don Môi-se têch nŏq? <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />En Siđăch nhâng hao nuih lŭng bây khây vu lây sŭng puôn jât mva? Nhâng đăng gal cồ bây khây tamun ôp bưn bap, en rup swan khây nĕh de vĭq jong sŭng tamăn singot vồh? <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />En Siđăch gĕh raq săq bây khây vu lây cồ đăng gĕh lăp u sŭng sinlơ lu lŏh Siđăch de, payh đăng gal simơ lawân khây nĕh cồ đăng tôq iêt? <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />Khây vơn sây nhâng pành khây nĕh đăng lôch prơn chĕq saq lăp mvăc nuih talaq đăng tôq.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />Payh canŏq, vơn căh gưt phŭng bây râm săq, mvăc phŭng pành camvŭm pănggân saq lăp sŭng sinlơ lu lŏh Siđăch de gât hôm nŏq, en vu lây nŏq sŭng pôp ŏh pôq vaih taphlăt cambet en. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />Mvăc dân ca khây nĕh, vơn khoi gĕh nhai tămti Sipơp yăh. Cồ canŏq, vrŭq chăng iêt camvŭm gŭn nŏq đăng văt tât sinlơ yăh lây an khây nĕh, lăm đăng gĕh pănggrăp bây sinlơ tôq camvân u sŭng khây tamun chăng iêt. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />Sĭq bây vơn heq, cồ khây tamun tôq en, nŏq gĕh lăp sŭng sinlơ lu lŏh, bây tanrong cồ Siđăch gĕh nhai:</para>
  <para style="q1" vid="HEB 4:3">“Dân ca Ănh gĕh raq săq sŭng lăm măq nuih ănh je,</para>
  <para style="q1" vid="HEB 4:3">‘… khây nĕh đăng gĕh lăp sŭng sinlơ lu lŏh Ănh je!’”</para>
  <para style="m" vid="HEB 4:3">Cồ payh khây vrŭq Siđăch ôp jêng gayh alăm sun chĕq vri dưnya. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />Mvăc gĕh gatŭq Siđăch nhai caheq sĭq năr di păh:</para>
  <para style="q1" vid="HEB 4:4">“En Siđăch Trôq lu lŏh ăp vrŭq Nĕh de sŭng năr di păh.”<verse eid="HEB 4:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="HEB 4:5" />En du dâq wŏq u sŭng gatŭq ndây:</para>
  <para style="q1" vid="HEB 4:5">“… Khây nĕh đăng lăm lây lăp gĕh sŭng sinlơ lu lŏh Ănh je.”<verse eid="HEB 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6" />Canŏq, lăm camvŭm pănggân gât hôm chĕq ân an du số tamun chĕq lăp sŭng sinlơ lu lŏh nŏq, en khây tamun a paheq gĕh nhai an gưt Sipơp Yăh đăng lăp gĕh payh ơ sinlơ đăng ôp bây, <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />nŏq Siđăch Trôq chĕq lŭh du năr wŏq, cuôl pành: “Năr heq,” lăm nhai ju Đa-vít du vau khay mva jŏq jong alưr nŏq, dân ca camvŭm gĕh nhai avlơ:</para>
  <para style="q1" vid="HEB 4:7">“Năr heq, hê khây con chăng camvŭm Siđăch,</para>
  <para style="q1" vid="HEB 4:7">nŏq vâng ôp kranh nuih khây con.”<verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />Mvăc hê Yô-swê gĕh văt tât sinlơ lu lŏh an văl ganơ, nŏq nhâng Siđăch đăng nhai sĭq du năr ndây alưr khây vrŭq heq. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />Payh canŏq, khoi hôm u nŏq sinlơ lu lŏh Sa-bat chĕq an con văl Siđăch Trôq de. <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />Mvăc vu lây gĕh lăp sŭng sinlơ lu lŏh Siđăch Trôq de, nơm khây nĕh khoi lu lŏh khây vrŭq ôp nơm de, dân ca Siđăch Trôq sĭq bây khây vrŭq ôp Siđăch de. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />Payh canŏq, yăh dông vơn căh gưt uĕh vrawŏq chĕq lăp sŭng sinlơ lu lŏh nŏq, chĕq đăng gĕh vu lây tarŏh lăp sŭng têr viêm sĭq sinlơ đăng tôq tĭq. <verse eid="HEB 4:11" /><verse number="12" style="v" sid="HEB 4:12" />Mvăc camvŭm Siđăch Trôq hôm mrĭh, jêng gayh bây sôt krĭq dông a pĭh var maq măt, juh phưt di tât gatŭq paklăh nggui bây wênh, lĕq nting côq bây chhu, bây gĕh prơn sên păndĕh khây sinlơ sinâng nggâm khây vrŭq sŭng nuih talaq. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />Đăng gĕh păch sun lŭh lây cồ tăm pôn sưt u vôq măt Siđăch. Palâq vlâq, ăp păch gĕh sun sirôq pôq rang bây pri lŭh lĕq u vôq măt Siđăch de, cồ Candranh pành camvŭm nhai lŭh vơn de dâl sĭq Nĕh.<verse eid="HEB 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />Canŏq, sŭng lăm gĕh du gru sipăm măq mi gĕh găn ntrăch khây tăp trôq, nŏq cồ Siđăch Yêsu, Con Siđăch Trôq, nŏq vơn căh jơ di gân khây camvŭm nhai candân nơm de. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />Mvăc đăng gal vơn gĕh du gru sipăm măq đăng gĕh prơn chĕq rawa nuih bây khây sinlơ la-ui vơn de, palâq sĭq vlâq nŏq cồ Candranh gĕh wŏq sinlơ lamvoch sŭng ăp ti singging bây tanrong tăm dân ca vơn, cồ đăng gĕh bưn bap lây. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />Payh canŏq, bây nuih talaq chha kram, vơn gĕh prơn tât mơch gatŭq sinăc yăh, chĕq wŏq sŏq sinlơ sinđach bây wŏng gĕh sinlơ yăh sŭng sinlơ tăm paq sŏng vadâq nŏq.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />Mvăc ăp gru sipăm măq, lăm gĕh săch sŏq lŭh sŭng văl ganơ, gĕh iơq hao ala an văl ganơ sŭng khây vrŭq gĕh ratênh tât Siđăch Trôq, chĕq pađăc păch pađăc bây con pađăc trŏh dôih bưn bap; <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />lăm gĕh prơn sinđach bây khây nĕh cồ gala galâp bây tih chroc, mvăc nơm nĕh khoi vlam sinlơ la-ui nhŭp phlâq vôq. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />Payh canŏq, nĕh nŏq phải pađăc con pađăc trŏh dôih bưn bap, dân ca an văl ganơ canŏq, en an nơm khoi dân canŏq. <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />Đăng gĕh du mvu lây wŏq vrŭq sipăm măq heq an nơm, en ayh gĕh Siđăch Trôq cuôl panh, khoi dân ca A-rôn. <verse eid="HEB 5:4" /><verse number="5" style="v" sid="HEB 5:5" />Khoi canŏq, Siđăch Yơt Dưnya khoi đăng pành vaih iơq nơm hao chĕq ôp sipăm măq. Ala lăp nŏq cồ Candranh gĕh nhai bây Siđăch:</para>
  <para style="q1" vid="HEB 5:5">“Con cồ Con Ănh;</para>
  <para style="q1" vid="HEB 5:5">Năr heq Ănh cồ panjêng Con.”<verse eid="HEB 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />Dân ca Candranh nŏq khoi gĕh nhai u du gatŭq ndây:</para>
  <para style="q1" vid="HEB 5:6">“Con cồ gru sipăm an tât wân lawân</para>
  <para style="q1" vid="HEB 5:6">bây njang Mên-chi-sê-đec.”<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />Diêt sŭng khây năr rĭh sŭng săq swan nơm, Siđăch pađăc hao lawân camvŭm vơu ngwân nggâm côt wĭnh, nggâm bây camvŭm cuôl nhim lĕq nuih bây daq măt hao an Candranh gĕh prơn gŭn yơt nơm ntrăch chưt, bây Siđăch nhâng gĕh iêt chăng mvăc sinlơ hôm mrĭh phŭng candŭh nơm de. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />Cồ pành Con, en Siđăch gĕh đom gưt sinlơ tôq rĭh bây a khây vrŭq cồ Siđăch wŏq vadâng. <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />En lăm gĕh jêng vênh lôch, Siđăch jêng vôl têch yơt wân lawân an lĕq săq vu lây tôq bây Siđăch, <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />alưr lăm gĕh Siđăch Trôq pân pađau ôp gru sipăm măq bây njang Mên-chi-sê-đec, <verse eid="HEB 5:10" /><verse number="11" style="v" sid="HEB 5:11" />en cồ sĭq tamun heq nŏq camvŭm gŭn an vơn cồ gŏq lŭng, bây đăng plôq sơr lŭh lĕq gĕh, payh ơ pôp ŏh pôq vaih jêng lŭh ranĭq ranưng sŭng sinlơ iêt chăng. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />Mvăc tât daq di tât avrêq heq, pành lĕq jêng gayh khây gru pađau, pôp ŏh lŭh pành saq wŏng vu lây nŏq chĕq pađau nơm khây sinwơi dêh thơl sŭng camvŭm Siđăch Trôq de, bây pôp ŏh jêng lŭh khây con paho cơnh daq tŏh, dŏh gal cồ păch sa kranh. <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />Mvăc cồ vu lây ayh huch daq tŏh nŏq pŏh pât sinlơ dân gưt sĭq camvŭm gŭn sinlơ sŏng yăh de, mvăc tamun nŏq hôm cồ con se. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />Cồ canŏq, păch sa kranh chĕq an tamun jêng măq, nŏq cồ khây vu lây don vrŭq uĕh ôp bây prơn nhwa dân gưt sĭq vrŭq gưt singgal vrŭq yăh ha vrŭq tih viêm.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />Canŏq, lăm lăq chĕq alưr sipơp cồ hôm thơl sĭq Siđăch Yơt Dưnya, vơn di sô saq tât gatŭq jêng măq, đăng tatao vlâq vrŭq thơl di tơm sĭq sinlơ palâq vôq lŭh ntrăch khây vrŭq chưt, sĭq sinlơ tôq camvân u Siđăch Trôq, <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />vrŭq pađau sĭq ŭm vôq, nggâm sinlơ chĕq ti bây lawân sinlơ tao rĭh sĭq vlâq tamun chưt de, bây sinlơ wŏq dôih wân lawân. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />Vơn nhâng ôp vrŭq nŏq lăm Siđăch Trôq an ôp. <verse eid="HEB 6:3" /><verse number="4" style="v" sid="HEB 6:4" />Mvăc nŏq cồ vrŭq đăng gĕh prơn — sĭq bây khây nĕh cồ lĕq gĕh sol silang, nggâm lawân dân gưt sinăc yăh Cô Voq an, jêng gayh tamun wŏq vrŭq simơ sĭq Siđăch Wênh <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />bây gĕh dân gưt camvŭm yăh Siđăch Trôq de nggâm khây prơn gŭn sĭq vadâq nggơih au klaq de <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />en vông hlâq — chĕq vlâq tatao khây nĕh nŏq dăh sĭq sinlơ palâq vôq, lăm pâng jimŏng Con Siđăch Trôq an nơm du dâq wŏq, bây dân dân gơm chhŏh Siđăch. <verse eid="HEB 6:6" /><verse number="7" style="v" sid="HEB 6:7" />Mvăc du lôq ntĕh, lăm gĕh vadâng lôch daq mi wân lawân rŏh jưr vlơ nĕh bây dĕh lŭh play jo tuyh twơ an con tamun, nŏq cồ an khây vu lây tăm swây nĕh, nŏq gĕh don sinlơ yăh a Siđăch Trôq, <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />en hôm lăm dĕh lŭh loq phla ha canji hwang, lôq ntĕh nŏq ayh hwât tabayh bây mơch wŏq sinlơ raq răh, en gatŭq chôch lĕq nĕh de ayh chĕq an ŭnh sŏh roq.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />En cồ sĭq khây pôp ŏh, khây tamun gĕh sinđach, sŏng lăm nhai canŏq, khananh nhâng gĕh vayh nuih sĭq khây vrŭq rom yăh dông bây gĕh vadâng sinlơ wŏq yơt. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />Mvăc Siđăch Trôq đăng tih khwĭnh en pành hŭch tôr khây vrŭq ôp pôp ŏh de, nggâm sinlơ sinđach cồ pôp ŏh gĕh chĕq vu sây an săq Siđăch, lăm uĕh ôp vrŭq khây Vatom gŭn bây avrêq gât hôm paq an khây nĕh. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />En khananh ngwân cơnh ăp ndu sŭng pôp ŏh jơ mŏq nuih talaq dŭh dăh canŏq, dăh tât sinlơ candân nhâng gân lĕq nuih sĭq sinlơ camvân nơm de di tât năr chôch lĕq, <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />chĕq an pôp ŏh đăng jêng lŭh khây tamun n'niêt si-uŏq, en jêng khây tamun pơch dăh bây têr rapui don sinlơ tôq camvân bây nuih talaq mbêr chĕq wŏq sŏq camvŭm pănggân.<verse eid="HEB 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />Mvăc Siđăch Trôq, lăm pănggân bây Ap-ra-ham, payh mvăc Siđăch đăng gĕh vu lây măq dông chĕq pănggơih lăp raq săq, nŏq raq săq pănggơih lăp di nơm, <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />pành: “Mvăc nhâng bâng hê paq sinăc yăh, Ănh nhâng tŭh sinlơ yăh vlơ con, en hê tŭh wŏq, Ănh tŭh jưr an con chhâl hao vênh rămvi.” <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />Payh canŏq, alưr lăm mbêr nuih câp nggơ, nĕh wŏq gĕh camvŭm pănggân nŏq. <verse eid="HEB 6:15" /><verse number="16" style="v" sid="HEB 6:16" />Mvăc khây vu raq săq don a vrŭq pănggơih lăp du mvu lây nŏq măq vlơ nơm, en bây khây nĕh, gatŭq chôch lĕq ăp sinlơ tăm cammlăh iau tât sinlơ du nuih talaq nŏq cồ camvŭm raq săq, <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />don trong nŏq, lăm cơnh nhai lŭh sinlơ canăh dông wŏq an khây tamun wŏq camvŭm pănggân sĭq sinlơ pơh ngâr đăng pagâl bây nuih cơnh Siđăch de, nŏq Siđăch Trôq gĕh lŭh mŭnh a du camvŭm raq săq, <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />chĕq don u var sinlơ đăng pagâl nŏq, sĭq var vrŭq nŏq đăng gĕh trong lây chĕq Siđăch Trôq nhai mvâr uy, khây vơn, cồ khây tamun lôt tât gatŭq n'un nơm, nhâng gĕh sinlơ jrông jrâng camhlăng chĕq văt gât sinlơ camvân a vrêq gĕh chĕq u vôq măt nơm; <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />nŏq cồ sinlơ camvân cồ vơn wŏq sŏq dân ca camvong đec an wênh nggui, dŭp lôch iên gân, dŭp lôch an kram gajăp, bây saq lăp sŭng di lăm cŭmvai măq, <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />gatŭq cồ Siđăch Yêsu gĕh saq lăp dân ca du Candranh saq lor ala an vơn, alưr lăm jêng gru sipăm măq di tât wân lawân bây njang Mên-chi-sê-đec.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />Mvăc Mên-chi-sê-đec heq, nŏq cồ vatau Sa-lem de, sipăm Siđăch Trôq Prĭh Vlơ Lĕq, nĕh gĕh vlam Ap-ra-ham lăm saq sĭq a pâm minsŭh sa vôq khây vatau, bây gĕh ngwân păch yăh an nĕh, <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />en Ap-ra-ham khoi paklăh ca-ayh du phần mât sĭq ăp păch caya sŏq gĕh chĕq pađăc an vatau nŏq; lor lĕq, Mên-chi-sê-đec gĕh tan'hya pành “Vatau yăh sŏng”, en cồ hôm khoi cuôl pành vatau Sa-lem de, sinlơ nŏq cồ “Vatau yăh iên,” <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />vatau đăng vap, đăng mê, đăng chhe njang, khoi đăng gĕh khây năr pơq vôq ha gatŭq chôch sinlơ hôm mrĭh, cồ canŏq gĕh jêng dân ca Con Siđăch Trôq, vatau khoi cồ gru sipăm măq an tât wân lawân.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />En căh chĕq măt chĕq sên vatau nŏq măq mi gưt dâng lây, nŏq cô jây Ap-ra-ham pađăc hao phân mât sŭng khây păch sŏq gĕh cồ yăh vlơ lĕq. <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />En cồ khây tamun a chhe njang Lê-vi, lăm wŏq vrŭq pađăc păch pađăc, nŏq gĕh camvŭm pân gĕh wŏq du phân mât a con văl bây ravwŏq, nŏq cồ a pôp ŏh nơm, payh cồ lŭh simơ a candưl Ap-ra-ham. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />Cồ canŏq, lăm đăng gĕh vĭq sŭng chhe njang lŭh a khây nĕh, vatau heq wŏq sŏq phân mât u Ap-ra-ham, bây ngwân păch yăh an tamun cồ gĕh khây camvŭm pănggân. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />Maq ndây, đăng gĕh du sinlơ tăm cammlăh lây lăm tamun tăp dêh dông gĕh gĕh ngwân păch yăh a tamun tăp prĭh dông. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />En sŭng vrŭq caheq, khây tamun mơch chưt wŏq sŏq phân mât, hôm sŭng vrŭq tĭq, vatau nŏq gĕh candân pành nĕh hôm mrĭh. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />Payh nhai gĕh du vrŭq caheq, Lê-vi, tamun wŏq sŏq khây phân mât, khoi gĕh wŏq phân mât don ju Ap-ra-ham, <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />mvăc nĕh gât hôm gŭq sŭng talaq cô jây nơm lăm Mên-chi-sê-đec tăm vlam măt Ap-ra-ham.<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />Nŏq, hê sinlơ jêng yăh cồ don vrŭq ôp sipăm tamun Lê-vi de (mvăc vlơ tơm nŏq, văl ganơ gĕh paq an ravwŏq), nŏq păch cơnh cồ iơq hao wŏq gru sipăm ndây sĭq njang Mên-chi-sê-đec en đăng gĕh cuôl dăh bây njang A-rôn? <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />Mvăc lăm jơ vrŭq sipăm gĕh tăm pagâl, nŏq payh ơ sinlơ piêt ôp, sinlơ tăm pagâl sĭq ravwŏq khoi gĕh sẫy lŭh. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />Mvăc Siđăch, Candranh cồ khây vrŭq heq gĕh nhai tât, sĭq du chhe njang ndây, en a sŭng chhe njang nŏq ndŏh gĕh vu lây cồ ôp vrŭq u mvrăh cŭh. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />Mvăc dân lŭng pành Siđăch vơn de lŭh a njang Yu-đa, en payh bây chhe njang nŏq, Môi-se đăng nhai tât vrŭq lây ratênh tât khây gru sipăm. <verse eid="HEB 7:14" /><verse number="15" style="v" sid="HEB 7:15" />Vrŭq heq nhâng hôm sây dân dông wŏq hê du mvu gru sipăm ndây gĕh iơq hao tăm dăh ca nggui nơm Mên-chi-sê-đec, <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />cồ Candranh jêng sipăm đăng bây ravwŏq sŭng ganơt sĭq săq swan, en pành bây prơn gŭn sinlơ hôm mrĭh de wân lawân. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />Mvăc Siđăch gĕh ôp candân pành:</para>
  <para style="q1" vid="HEB 7:17">“Con cồ gru sipăm wân lawân bây chhe njang Mên-chi-sê-đec.”<verse eid="HEB 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 7:18" />Payh ơ du maq, vrŭq hwât tabayh ravwŏq lor paheq gĕh ôp lŭh mvăc nĕh la-ui bây đăng ôp gĕh vrŭq lây <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />(nŏq cồ mvăc ravwŏq đăng ôp an di jêng yăh vrŭq lây lĕq), en maq ndây cồ vrŭq văt tât sinlơ camvân yăh rom dông, en don u nŏq vơn tât mơch Siđăch Trôq. <verse eid="HEB 7:19" /><verse number="20" style="v" sid="HEB 7:20" />Bây đăng gal gĕh lĕq khây vrŭq a vlơ nŏq cồ đăng gĕh camvŭm raq săq, — mvăc payh pành khây tamun tĭq đăng gĕh camvŭm raq săq nŏq khoi gĕh jêng khây gru sipăm, <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />En nhâng Siđăch Nĕh tăm pănggrăp takêp bây du camvŭm raq săq, don Candranh nhai bây Nĕh:</para>
  <para style="q1" vid="HEB 7:21">“Cô Voq gĕh raq săq bây đăng tăm pagâl nuih:</para>
  <para style="q1" vid="HEB 7:21">‘Con cồ gru sipăm di tât wân lawân.’” —<verse eid="HEB 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />nŏq bây tanrong prĭh yăh vlơ nŏq, Siđăch Yêsu jêng Candranh jơ ca'hya yăh sĭq du sinlơ tăm lăp ti yăh dông. <verse eid="HEB 7:22" /><verse number="23" style="v" sid="HEB 7:23" />En cồ khây tamun gĕh dŏq gĕh jêng gru sipăm cồ gŏq săq dông, payh ơ sinlơ chưt khăq king chĕq đăng ôp diêt vrŭq nŏq, <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />cồ canŏq, Siđăch jơ vrŭq ôp sipăm đăng pagâl gĕh, mvăc Siđăch hôm mrĭh di tât wân lawân, <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />en payh canŏq, Siđăch khoi gĕh prơn gŭn chĕq yơt tât gatŭq jêng lôch an khây tamun tât mơch Siđăch Trôq găn ju Nĕh, cồ Candranh hôm rĭh chĕq wĭnh ngwân ala an khây nĕh. <verse eid="HEB 7:25" /><verse number="26" style="v" sid="HEB 7:26" />Mvăc du gru sipăm măq canŏq nhâng dip gal pành chĕq ân an vơn: Candranh jrŏh soch, đăng bưn bap, yăh jrŏh, gĕh paklăh ntrăch a khây tamun bưn bap, bây jêng măq mi dông vlơ khây tăp trôq; <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />cồ Candranh đăng gĕh khây păch cơnh lây ăp năr dân ca khây sipăm măq ndây, phải pađăc con pađăc, lor lĕq cồ ala an bưn bap nơm de, alưr nŏq cồ bưn bap văl ganơ de, mvăc Siđăch gĕh ôp jêng en vrŭq nŏq alưr lăm pađăc nơm du dâq lôch lawân. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />Mvăc ravwŏq iơq hao khây tamun gĕh sinlơ la-ui ôp gru sipăm măq, en camvŭm raq săq, cồ vrŭq tât alưr ravwŏq, nŏq iơq Con, cồ Candranh gĕh ôp an jêng yăh lôch di tât wân lawân.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />Payh canŏq, gatŭq măq vlơ lĕq sĭq vrŭq cồ gĕh nhai nĕh caheq: Khây vơn gĕh du gru sipăm măq canŏq, cồ Candranh gŭq a maq ma gatŭq gŭq Candranh Măq Mi de vlơ khây tăp trôq, <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />du mvu dĭch năc sŭng gatŭq gŭn bây padai sưmvăh nhâng bâng cồ nơm Siđăch tatao hao, đăng gal con tamun. <verse eid="HEB 8:2" /><verse number="3" style="v" sid="HEB 8:3" />Mvăc ăp ndu gru sipăm măq nŏq gĕh iơq hao chĕq pađăc lĕq khây păch pađăc nggâm khây con pađăc, cồ payh u nŏq, Candranh nŏq khoi cơnh gĕh păch lây nŏq chĕq Siđăch pađăc hao gĕh. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />Nŏq, pành payh Siđăch hôm gŭq u dưnya heq, nŏq payh pành Siđăch tât daq đăng ôp sipăm, mvăc lĕq gĕh khây tamun pađăc păch pađăc dăh bây ravwŏq; <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />cồ khây tamun ôp sipăm nŏq tăm simơ du haih cồ bây ca rup gui khây vrŭq vlơ trôq; dân ca Môi-se gĕh pân lăm mơch jêng en padai sưmvăh, mvăc Siđăch Trôq gĕh nhai: “Căh jơ di yăh, con nhâng ôp ăp vrŭq bây tơm têr cồ gĕh nhai pân con u vlơ gŭng.” <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />En vrêq heq, Siđăch gĕh wŏq du vrŭq ôp măq mi dông dâng lây, Siđăch khoi cồ Candranh Gŭq Canđal vrŭq tăm lăp ti yăh dông dâng nŏq, cồ sinlơ tăm lăp ti gĕh tayh jêng pănggơih vlơ khây camvŭm pănggân yăh dông. <verse eid="HEB 8:6" /><verse number="7" style="v" sid="HEB 8:7" />Mvăc hê vrŭq tăm lăp ti di muôi nŏq cồ đăng tih wil, nŏq nhâng pành gatŭq an vrŭq tăm lăp ti di var nŏq đăng wŏng sây gĕh. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />Mvăc lăm chih lăh văl ganơ, Siđăch Trôq pành:</para>
  <para style="q1" vid="HEB 8:8">“Deng sên hèq, khây năr nŏq saq tât, Cô Voq nhai:</para>
  <para style="q1" vid="HEB 8:8">en Ănh ôp jêng gayh du tăm lăp ti me</para>
  <para style="q2" vid="HEB 8:8">bây nhi I-sơ-ra-ên nggâm bây nhi Yu-đa;<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />đăng pănggơih bây vrŭq tăm lăp ti</para>
  <para style="q2" vid="HEB 8:9">cồ Ănh gĕh panh bây khây cô jây khây nĕh</para>
  <para style="q1" vid="HEB 8:9">sŭng năr cồ Ănh văt ti khây nĕh</para>
  <para style="q2" vid="HEB 8:9">chĕq têch khây nĕh lŭh ntrăch ntĕh Ai-câp,</para>
  <para style="q1" vid="HEB 8:9">mvăc khây nĕh đăng gŭq diêt sŭng vrŭq tăm lăp ti Ănh je,</para>
  <para style="q2" vid="HEB 8:9">Ănh khoi lĕq hwât tabayh khây nĕh,</para>
  <para style="q1" vid="HEB 8:9">Cô Voq nhai.<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />Mvăc heq cồ vrŭq tăm lăp ti</para>
  <para style="q2" vid="HEB 8:10">cồ Ănh ôp lŭh bây nhi I-sơ-ra-ên</para>
  <para style="q1" vid="HEB 8:10">alưr khây năr nŏq,</para>
  <para style="q2" vid="HEB 8:10">Siđăch nhai,</para>
  <para style="q1" vid="HEB 8:10">lăm chĕq khây ravwŏq ănh je lăp sŭng vôq tôr khây nĕh,</para>
  <para style="q1" vid="HEB 8:10">Ănh khoi chêr khây ravwŏq nŏq lăp sŭng nuih talaq khây nĕh,</para>
  <para style="q1" vid="HEB 8:10">en Ănh heq cồ Siđăch Trôq ndăl khây nĕh,</para>
  <para style="q1" vid="HEB 8:10">en khây nĕh cồ du văl chĕq an Ănh.<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />Nhâng bâng khây nĕh đăng gĕh pađau ăp ndu sŭng ganai nơm</para>
  <para style="q1" vid="HEB 8:11">nggâm bây ăp ndu pôp ŏh nơm, pành: ‘Căh singgal gưt Cô Voq,’</para>
  <para style="q1" vid="HEB 8:11">mvăc lĕq săq khây nĕh gưt Ănh,</para>
  <para style="q1" vid="HEB 8:11">a khây tamun ken dông lĕq sŭng khây nĕh di tât tamun măq dông lĕq.<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />Mvăc Ănh nhâng nkhơch ti bây khây vrŭq ôp đăng yăh sŏng khây nĕh de,</para>
  <para style="q1" vid="HEB 8:12">en Ănh nhâng bâng đăng hôm căh tât bưn bap khây nĕh de wŏq.”<verse eid="HEB 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13" />Mvăc vrŭq nhai lŭh cồ “me”, nŏq Siđăch ôp an vrŭq tăm lăp ti di muôi jêng lŭh păch dâm tabayh èn; en vrŭq cồ ôp an đăng hôm tăm răp bây lŭh dâm sam nŏq sên dân ca cồ păch lĕq lêch lawăch èn.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />Vrêq heq, vrŭq tăm lăp ti di muôi nŏq gĕh khây sinlơ pađau sĭq vrŭq cŭh sưmvăh, saq bây du gatŭq jrŏh soch u ntĕh, <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />mvăc du padai sưmvăh cồ gĕh tatao hao, maq di muôi, sŭng nŏq gĕh lawân jâng ŭnh bây nra, nggâm bây bănh pađăc hao, cồ gatŭq gĕh cuôl pành “Gatŭq Soch Jrŏh”, <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />en alưr du păng cŭmvai di var cồ maq padai sưmvăh, gatŭq gĕh cuôl pành “Gatŭq Mơ Jrŏh Soch”, <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />gĕh du mvrăh pađăc n'hŭm ôp a mơh, bây dor tăm lăp ti gĕh pưt lam rawênh a mơh, sŭng di lăm nŏq cồ du lâm sitôq ôp a mơh vadâng ma-na, chhơ gadông lŭh ncao A-rôn de, nggâm khây păng tăm lăp ti, <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />hôm avlơ dor, khây chê-ru-bim sindraq tang tŏq sitŭq thi ân, en sĭq khây păch nŏq đăng gal lăm chĕq nhai lŭh a sinlơ uy. <verse eid="HEB 9:5" /><verse number="6" style="v" sid="HEB 9:6" />En lăm khây păch nŏq gĕh sŭmmrăp canŏq, khây gru sipăm uĕh saq lăp u sŭng padai pănggơih di muôi, chĕq ôp khây vrŭq cồ nơm gĕh wŏq sŏq. <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />En ayh gru sipăm măq lăp sŭng maq di var du dâq sŭng du mva, bây gĕh n'ham, cồ con pađăc cồ nĕh pađăc hao ala an nơm nĕh khoi ca khây bưn bap văl ganơ de. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />Siđăch Wênh ju vrŭq nŏq an sây dân pành trong lăp sŭng gatŭq gŭn khoi hôm ndŏh gĕh pơq lŭh, lăm padai sưmvăh di muôi khoi hôm tao yăq, <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />sinlơ nŏq cồ du vrŭq tăm wĕh chĕq an khây nggơih vrêq heq, en bây trong nŏq, lawân păch pađăc nggâm con pađăc gĕh pađăc hao đăng gĕh prơn chĕq ôp jêng yăh an tamun cŭh sưmvăh chĕq tabaq sĭq nuih talaq, <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />ayh ratênh tât păch sa bây păch huch, nggâm khây lễ chhat rao tăm ca-ayh, nŏq cồ khây ganơt sĭq săq swan, chĕq tănchăp di tât năr tăm pagâl.<verse eid="HEB 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />Cồ canŏq Siđăch Yơt Dưnya, lăm lŭh măt sŭng gatŭq gru sipăm măq an khây sinlơ yăh rom lĕq gĕh jŏq èn, don ju padai sưmvăh măq mi dông nggâm jêng yăh dông đăng gal ti con tamun tatao hao, nŏq cồ đăng sĭq maq dưnya gĕh sun lŭh heq, <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />khoi đăng gal payh ơ n'ham dive kwŏng de nggâm lamo con de, aheq don ju n'ham nơm, Siđăch gĕh lăp sŭng khây gatŭq gŭn du dâq lôch lawân, ayh u nơm wŏng gĕh sinlơ têch yơt wân lawân. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />Mvăc hê n'ham ve ve kwŏng bây lamo kwŏng nggâm vrŭq vrŏh vuh lamo vang drŭh vlơ tamun cồ sŭq cavơm hôm mo văt tât sinlơ jêng jrŏh, don sŭng vrŭq chhat rao săq swan khây nĕh, <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />nŏq n'ham Siđăch Yơt Dưnya de, cồ Candranh don Siđăch Wênh wân lawân gĕh pađăc nơm Nĕh ôp păch pađăc đăng chŏh laq an Siđăch Trôq, nhâng ôp jrŏh nuih talaq pôp ŏh de gưt dâng lây chĕq ntrăch khây vrŭq chưt chĕq tachŏq an Siđăch Trôq hôm mrĭh wân lawân! <verse eid="HEB 9:14" /><verse number="15" style="v" sid="HEB 9:15" />Payh canŏq, Siđăch cồ Candranh Vlăc Canđal sĭq vrŭq tăm lăp ti me, chĕq alưr sinlơ chưt chĕq ân an vrŭq song yơt khây sinlơ tabaq bưn bap pănggơih vlơ vrŭq tăm lăp ti di muôi gĕh ôp lŭh, khây tamun gĕh cuôl panh gĕh wŏq sŏq camvŭm pănggân sĭq păch caya wân lawân. <verse eid="HEB 9:15" /><verse number="16" style="v" sid="HEB 9:16" />Mvăc tŭq lây gĕh sirăq pân chĕq don, u nŏq nhŭp tănh sinlơ chưt tamun chêr sirăq pân don vlâq nŏq gĕh candân. <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />Mvăc sirăq pân chĕq dơn vlâq ayh jêng gayh don u sinlơ chưt, payh canŏq nĕh đăng don gĕh lăm tamun cồ chêr sirăq pân dơn vlâq hôm mrĭh. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />Payh canŏq, sŏng lawân vrŭq tăm lăp ti a vôq lĕq khoi đăng gĕh ôp lŭh en đăng gĕh n'ham. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />Mvăc lăm ăp camvŭm pân bây ravwŏq gĕh Môi-se nhai lŭh an lĕq văl ganơ, alưr lăm sŏq n'ham lamo con bây ve ve kwŏng, nggâm bây daq, chhe paih paho bây singging chhơ nthôr, nĕh gĕh vrŏh lawân vlơ păng sirăq taklôn nggâm lawân lĕq con văl, <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />nhai pành: “Heq cồ n'ham tăm lăp ti cồ Siđăch Trôq gĕh pân pađau an pôp ŏh.” <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />En bây tanrong simơ canŏq, nĕh vrŏh n'ham vlơ padai sưmvăh bây khây păch cồ sŏq chĕq ôp sŭng vrŭq pađăc. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />Dăh bây ravwŏq, pành mơch lĕq ăp sinlơ gĕh chhat rao ayh a n'ham, en đăng gĕh sinlơ tapinh n'ham nŏq đăng gĕh sinlơ bôih hwât bưn bap.<verse eid="HEB 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />Payh canŏq, du maq, vrŭq nhâng cơnh di gĕh nŏq cồ khây sinlơ sŏq ôp dŭng sĭq khây sinlơ vlơ trôq gĕh chhat rao don ju con pađăc heq, en măt ndây, payh cồ khây păch u vlơ trôq phải gĕh chhat rao a khây con pađăc yăh dông găn ntrăch vlơ khây con pađăc nŏq, <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />mvăc nhâng, Siđăch Yơt Dưnya đăng lăp sŭng di lăm khây gatŭq gŭn cồ ti con tamun ôp lŭh — cồ khây sinlơ sŏq ôp dŭng sĭq khây păch gĕh nhâng — palâq sĭq vlâq nŏq cồ lăp sŏng sŭng Daq Trôq, chĕq vrêq heq lŭh măt u vôq măt Siđăch Trôq ala an vơn, <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />khoi đăng gal chĕq pađăc nơm vơn gŏq dâq, dân ca gru sipăm măq ăp mva saq lăp sŭng khây gatŭq gŭn nggâm bây n'ham tamun ndây de; <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />Mvăc hê đăng gal canŏq, nŏq vrŭq cơnh vlơ lĕq an Siđăch nŏq cồ phải vlam lŏh sat gŏq dâq alăm tatao tơm dưnya. En vrêq heq, ayh du dâq lăm chôch khây nggơih, payh ơ vrŭq ôp panjwăch jrŏh bưn bap, Siđăch gĕh pơq an sây don ju sinlơ chưt Nĕh de. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />En bây vrŭq cồ gĕh sŭmmrăp sindăc an con tamun phải chưt du dâq, en alưr nŏq cồ sinlơ ôp dôih, <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />en khoi canŏq, alưr lăm gĕh pađăc hao ayh du dâq chĕq văq nong bưn bap an gŏq ndu, Siđăch Yơt Dưnya gĕh deng sây sŭng dâq di var, đăng gal chĕq văq nong bưn bap, en chĕq sinlơ wŏq yơt tât bây khây vu lây lĕq nuih câp nggơ Nĕh.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />Mvăc ravwŏq — lăm wŏq gĕh ayh gui khây sinlơ rom yăh cồ mơch tât, đăng gal cồ nơm rup nhâng khây vrŭq yăh nŏq de — đăng dâq lây cồ ôp an di jêng yăh gĕh khây vu lây tât mơch Siđăch Trôq nggâm bây khây con pađăc cồ khây nĕh gât wân lawân văt pađăc hao ăp mva. <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />Mvăc hê gĕh prơn, nŏq đăng gal khây con pađăc lĕq pâh lu gĕh pađăc hao, mvăc khây tamun cŭh sưmvăh đăng hôm sây văq njŏq bưn bap wŏq, lăm lĕq gĕh chhat rao jrŏh du dâq lôch lawân hàh? <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />Palâq vlâq, sĭq khây păch pađăc nŏq, gĕh du sinlơ chĕq tacăh sĭq bưn bap sŭng ăp mva. <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />Mvăc n'ham lamo kwŏng bây ve ve kwŏng đăng hwât bưn bap saq gĕh. <verse eid="HEB 10:4" /><verse number="5" style="v" sid="HEB 10:5" />Payh canŏq, lăm lăp sŭng dưnya, Siđăch nhai:</para>
  <para style="q1" vid="HEB 10:5">“Siđăch đăng cơnh</para>
  <para style="q2" vid="HEB 10:5">con pađăc bây păch pađăc,</para>
  <para style="q2" vid="HEB 10:5">En Siđăch gĕh sŭmmrăp sưndăc du rup swan an Con;<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />Siđăch khoi đăng can'hir cơnh</para>
  <para style="q2" vid="HEB 10:6">khây păch pađăc cồ gwŭch lĕq bây trŏh ala bưn bap.<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />Alưr nŏq, ănh pành: ‘Wĭnh deng sên, Con tât —</para>
  <para style="q2" vid="HEB 10:7">dăh bây camvŭm sŭng sirăq taklôn gĕh chêr sĭq con —</para>
  <para style="q1" vid="HEB 10:7">chĕq ôp bây nuih cơnh Siđăch de, ơ Siđăch Trôq.’”<verse eid="HEB 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 10:8" />Lăm Siđăch nhai dân ca avlơ nŏq pành: “Siđăch đăng cơnh con pađăc bây păch pađăc, nggâm khây sinlơ pađăc cồ gwŭch bây wŏq bưn bap. Siđăch khoi đăng dĭh nuih khây sinlơ nŏq” (cồ khây păch gĕh pađăc hao bây ravwŏq pađau), <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />alưr nŏq, Siđăch nhai: “Wĭnh deng sên, Con tât chĕq ôp bây nuih cơnh Siđăch de.” Siđăch hwât tagayh vrŭq di muôi chĕq iơq hao vrŭq di var. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />Payh ơ nuih cơnh nŏq, khây vơn heq gĕh jêng jrŏh soch don sinlơ pađăc rup swan Siđăch Yơt Dưnya Yêsu de ôp con pađăc du dâq lôch lawân. <verse eid="HEB 10:10" /><verse number="11" style="v" sid="HEB 10:11" />Nhâng, Ăp ndu gru sipăm ăp năr tao yăq ôp vrŭq pân ôp bây wân lawân pađăc simơ khây con pađăc, cồ khây con pađăc đăng dâq lây hwât gĕh sinlơ bưn bap uy. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />Aheq Siđăch, alưr lăm payh ơ sinlơ bưn bap pađăc ayh du con pađăc di tât wân lawân, nŏq gĕh gŭq a dăl ma Siđăch Trôq de, <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />câp nggơ a vadâq nŏq di tât lăm khây tamun chŏl sĭq vlâq Siđăch bị chĕq jưr chĕq ôp panâr nong jâng Siđăch. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />Mvăc don ayh du con pađăc, Siđăch gĕh ôp khây tamun gĕh chhat rao jêng gayh jrŏh yăh di tât wân lawân. <verse eid="HEB 10:14" /><verse number="15" style="v" sid="HEB 10:15" />En Siđăch Wênh khoi ôp candân an vơn, mvăc alưr nŏq gĕh nhai:<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />“Heq cồ tăm lăp ti cồ Ănh iơq lŭh bây khây nĕh,</para>
  <para style="q2" vid="HEB 10:16">Alưr khây năr nŏq, Siđăch nhai,</para>
  <para style="q1" vid="HEB 10:16">lăm chĕq ravwŏq Ănh sŭng nuih talaq khây nĕh</para>
  <para style="q2" vid="HEB 10:16">Ănh khoi chêr ravwŏq lăp sŭng vôq tôr khây nĕh.”<verse eid="HEB 10:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17" />En:</para>
  <para style="q1" vid="HEB 10:17">“Ănh nhâng đăng hôm căh tât bưn bap khây nĕh</para>
  <para style="q2" vid="HEB 10:17">bây khây vrŭq đăng ravwŏq khây nĕh wŏq.”<verse eid="HEB 10:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="HEB 10:18" />En gatŭq lây gĕh sinlơ chhat rao khây sinlơ tĭh bap nŏq, vi nŏq đăng hôm con pađăc trŏh ala bưn bap.<verse eid="HEB 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />Payh canŏq, ơ pôp ŏh, mvăc gĕh nuih talaq chha kram an vrŭq tât lăp khây gatŭq gŭn gayh don ju n'ham Siđăch Yêsu, <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />cồ Candranh gĕh pơq lŭh an vơn du lâm con trong me bây rĭh găn ntrăch păng cŭmvai măq, nŏq cồ rup nơm Siđăch de, <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />bây du mvu gru sipăm măq mi vlơ lĕq jơ vôq nhi Siđăch Trôq, <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />nŏq vơn căh tât mơch Siđăch Trôq sŏq nuih talaq yăh nhâng sŭng sinlơ candân krit gât sinlơ tôq camvân de, nuih talaq gĕh vrŏh n'ham chhat rao ntrăch a nuih tôr viêm chhât bây rup swan gĕh rao a daq soch jrŏh. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />Vơn căh gưt jơ di gân camvŭm nhai lŭh sĭq sinlơ camvân nơm de bây đăng jăl wăl, mvăc Candranh cồ pănggân lawân jơ camvŭm. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />Bây vơn gưt chĕq nuih talaq tămhơch tât ndăng ganai chĕq saq tât vrŭq tăm jŭh jăh nuih talaq tăm sinđach bây khây vrŭq ôp yăh, <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />lăm đăng hwât tabayh sinlơ jŭm vatom tăm simơ sŭng ganai vơn de dân ca vrŭq cồ uĕh ôp sŭng takiq ndu, palâq vlâq nŏq cồ vrŭq jrông jrâng ganai, en hê pôp ŏh sây năr nŏq mơch tât dâng lây nŏq căh ôp canŏq di camhlăng dông wŏq.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />Mvăc hê vơn panâr vôq ôp bưn bap alưr lăm gĕh wŏq sŏq sinlơ dân gưt vênh lôch sĭq sipơp gŭn, nŏq đăng hôm con pađăc lây chĕq trŏh ala bap wŏq, <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />nŏq cồ sinlơ câp nggơ phŭng candŭh lŭng âr nhâng bâng sĭq sinlơ sa dôih bây sĭq ŭnh ngit lahưp sindăc chĕq sŏh roq khây nĕh cồ tăm chŏl nŏq. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />Payh cồ vu lây, hê hwât tagayh ravwŏq Môi-se pănggơih u var ha pe ndu ôp candân, nŏq chưt đăng yâh sinđach uy. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />Pôp ŏh sinâng vồq nĕh cồ jot lât Con Siđăch Trôq de, bây sên n'ham sĭq vrŭq tăm lăp ti đăng lŭh păch lây chhŭq chhau — cồ don n'ham nŏq, nơm jêng jrŏh soch — bây ôp bap tât Siđăch Wênh sinăc yăh de, nĕh phải wŏq sinlơ sa dôih canjŏq dông cồ gưt dâng lây? <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />Mvăc vơn gưt Candranh gĕh nhai: “Sinlơ trŏh daq cồ Ănh je; Ănh nhâng trŏh daq.” Bây nhai pành: “Siđăch ôp dôih văl Nĕh.” <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />Tarŏh lăp sŭng ti Siđăch Trôq hôm mrĭh wân lawân cồ du vrŭq phŭng ranđih!<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />En căh sĭq vlâq khây năr lor heq, cồ gĕh sol silang sŭng khây năr nŏq, pành pôp ŏh gĕh wŏq du dŏq tăm chŏl măq mi gŏq sinlơ panhji panhlŏh, <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />dâq heq cồ vlam lawân sinlơ gơm sâh nggâm sinlơ pagơq a vôq măt văl ganơ, hôm dâq tĭq cồ jêng tamun tăm paq bây khây vu lây pŏh vlam bây tanrong nŏq. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />Mvăc pôp ŏh khoi gĕh sŏq nuih sinđach khây tamun gŭq u vi jingo, nggâm bây wŏq vadâng vrŭq plôq avlăh păch caya nơm bây sinlơ vui hơn, mvăc gưt dân nơm gĕh caya yăh dông bây hôm diêt lawân. <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />Payh canŏq, pôp ŏh vâng hwât tagayh nuih talaq gân tôq nơm de, cồ vrŭq wŏq sĭq nơm du sinlơ trŏh song yăh măq mi. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />Mvăc pôp ŏh gĕh pŏh pât sĭq vrŭq mbêr nuih wŏq vadâng, chĕq alưr lăm ôp bây nuih cơnh Siđăch Trôq de, pôp ŏh gĕh prơn wŏq gĕh camvŭm pănggân.<verse eid="HEB 10:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="HEB 10:37" />“Mvăc sŭng ndêt takiq jŏq wŏq,</para>
  <para style="q1" vid="HEB 10:37">Candranh saq tât nhâng tât, bây đăng lĭh jŏq wŏq.<verse eid="HEB 10:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38" />En tamun yăh sŏng Ănh je rĭh don ju sinlơ tôq camvân;</para>
  <para style="q1" vid="HEB 10:38">en hê tamun n'hưn sĭq alưr, nŏq wênh nggui Ănh đăng vayh nuih sĭq nĕh nŏq.”<verse eid="HEB 10:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />En di nơm vơn đăng gŭq sŭng sinlơ n'hưn sĭq alưr vaih tât gatŭq chưt lawăch, palâq sĭq vlâq cồ sŭng sinlơ tôq camvân dăh sĭq tât gatŭq chhwa sưt wênh nggui de.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />Tôq camvân cồ sinlơ tayh gân gajăp sĭq khây vrŭq gĕh gŭq câp, cồ sinlơ candân sĭq khây vrŭq đăng sây gĕh. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />Mvăc don tôq camvân, khây tamun ađơm gĕh camvŭm candân yăh. <verse eid="HEB 11:2" /><verse number="3" style="v" sid="HEB 11:3" />Don ju tôq camvân vơn dân gưt n'hop trôq ntĕh heq gĕh jêng gayh — don a camvŭm Siđăch Trôq de — chĕq vrŭq sây gĕh đăng jêng gayh a khây sinlơ cồ pành gĕh deng sây. <verse eid="HEB 11:3" /><verse number="4" style="v" sid="HEB 11:4" />Don tôq camvân A-bên gĕh pađăc hao Siđăch Trôq du con pađăc yăh dông a Ca-in, en don u nŏq nĕh gĕh candân pành sŏng yăh, lăm Siđăch Trôq dơp lŭh sinlơ wŏq candân vlơ khây păch pađăc nĕh de, bây don tôq camvân, A-bên gât hôm mo nhai cồ pành lĕq chưt èn. <verse eid="HEB 11:4" /><verse number="5" style="v" sid="HEB 11:5" />Don tôq camvân, Hê-noc gĕh văt saq, đăng gưt tât sinlơ chưt, bây “nĕh đăng gĕh wŏng sây, mvăc Siđăch Trôq roc nĕh saq.” Mvăc lor alăm wŏq hao nơm de, nĕh gĕh candân pành rĭh rom nuih Siđăch Trôq. <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />Cồ canŏq, đăng gĕh tôq camvân nŏq đăng ôp rom nuih Siđăch Trôq, mvăc vrŭq nhŭp krêh vu lây cồ tât bây Siđăch Trôq sŭng nuih nhâng tôq pành Siđăch nhâng gĕh bây Siđăch cồ Candranh paq sinlơ yăh an vu lây wŏng miêng Nĕh. <verse eid="HEB 11:6" /><verse number="7" style="v" sid="HEB 11:7" />Don tôq camvân, alưr lăm gĕh pân tacăh sĭq khây vrŭq ndŏh sây, nŏq mvăc phŭng candŭh, Nô-ê pâng du tong duq chĕq yơt caniêp nơm de, en don ju nŏq, nĕh ôp dôih dưnya bây jêng tamun don wŏq sinlơ sŏng yăh don u tôq camvân. <verse eid="HEB 11:7" /><verse number="8" style="v" sid="HEB 11:8" />Don tôq camvân, mvăc gĕh cuôl panh, Ap-ra-ham gĕh tôq bây chĕq lŭh saq tât gatŭq cồ nơm wŏq chĕq ôp păch caya, en nĕh gĕh lŭh saq lăm đăng gưt nơm saq vi lây. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />Don tôq camvân, nĕh gŭq sŭng ntĕh pănggân dân ca văl daq ndây, lăm rĭh sŭng tông padai bây I-sac nggâm Ya-côp, cồ khây tamun gĕh don wŏq simơ du camvŭm pănggân, <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />mvăc nĕh gât câp nggơ du palây cồ kram gŏt, cồ Di tơm Chêr Lŭh bây Ta Tao Hao palây nŏq payh cồ Siđăch Trôq. <verse eid="HEB 11:10" /><verse number="11" style="v" sid="HEB 11:11" />Don ju tôq camvân, tât daq payh Sa-ra nhâng wŏq gĕh prơn chĕq rŏh vŭn sŏng lăm cồ pành đăng tăm dip bây khay mva măq cammra, mvăc nĕh nhâng tôq Candranh gĕh pănggân lawân jơ camvŭm. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />Payh canŏq, khoi cồ a du mvu — en cồ gĕh sên dân ca chưt èn — nŏq ăp nggơih con sinau gĕh dĕh lŭh, dân ca sinlơ gŏq săq khây simănh vlơ trôq, bây dân ca chwŏh đăng cơp gĕh vlơ vâr daq lênh. <verse eid="HEB 11:12" /><verse number="13" style="v" sid="HEB 11:13" />Sŭng sinlơ tôq camvân, lĕq săq khây tamun heq pành chưt lăm ndŏh wŏq gĕh khây camvŭm pănggân, ayh sên sây bây khwây wŏq khây vrŭq nŏq a ngai, nggâm nhai pành nơm heq cồ văl gŭq don bây văl tamuôi u vlơ ntĕh heq. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />Mvăc khây tamun nhai khây vrŭq canŏq an sây dân pành khây nĕh saq wŏng miêng du palây pala. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />Hê khây nĕh căh sĭq palây cồ khây nĕh a nŏq lŭh saq, nŏq nhâng khây nĕh gĕh trong chĕq palâq sĭq. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />En vrêq heq khây nĕh can'hir cơnh du gatŭq rom yăh dông, nŏq cồ palây u vlơ trôq, Payh canŏq Siđăch Trôq đăng prênh tôr sĭq khây nĕh, chĕq gĕh cuôl pành Siđăch Trôq khây nĕh de, mvăc Siđăch gĕh sŭmmrăp sindăc du palây an khây nĕh. <verse eid="HEB 11:16" /><verse number="17" style="v" sid="HEB 11:17" />Don tôq camvân, Ap-ra-ham pađăc I-sac sŭng lăm wŏq sinlơ long găn, tât daq alưr lăm wŏq gĕh khây camvŭm pănggân, nĕh gĕh văt pađăc con klô di muôi nơm de, <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />en sĭq con nŏq, gĕh camvŭm nhai pành: “Don ju I-sac, chhe njang con de nhâng gĕh tan'hya săq,” <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />mvăc gĕh sinâng pành Siđăch Trôq gĕh kwiềng ôp an rĭh sĭq vlâq, lawân a gatŭq chưt, bây sŭng sinlơ nhai dŭng, nĕh gĕh wŏq sĭq vlâq con nơm a gatŭq nŏq. <verse eid="HEB 11:19" /><verse number="20" style="v" sid="HEB 11:20" />Khoi don tôq camvân, I-sac ngwân păch yăh an Ya-côp bây Ê-sau sĭq khây vrŭq gĕh sẫy lŭh. <verse eid="HEB 11:20" /><verse number="21" style="v" sid="HEB 11:21" />Don tôq camvân, lăm mơch chưt, Ya-côp ngwân păch yăh an ăp ndu con klô Yô-sep de, bây gơih lăp vôq chhơ gadông nơm, nĕh chŏl nkrŭng cŭh sưmvăh. <verse eid="HEB 11:21" /><verse number="22" style="v" sid="HEB 11:22" />Don tôq camvân, lăm chôch nggơih, Yô-sep pân tacăh sĭq vrŭq lŭh saq con sinau I-sơ-ra-ên de bây pân tacăh khây nĕh sĭq nting nơm nĕh. <verse eid="HEB 11:22" /><verse number="23" style="v" sid="HEB 11:23" />Don tôq camvân, alưr lăm gĕh dĕh lŭh, Môi-se gĕh mê vap nĕh văt tăm pôn sŭng pe khay mvăc khây nĕh sây con se yăh krây, en khây nĕh đăng phŭng camvŭm vatau de. <verse eid="HEB 11:23" /><verse number="24" style="v" sid="HEB 11:24" />Don ju tôq camvân, lăm hao măq, Môi-se alăh tagayh păch cồ gĕh cuôl pành con klô ur ramăch Pha-ra-ôn de. <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />Ala an vrŭq nŏq, nĕh săch sŏq wŏq rabăh rabơp simơ bây văl Cô Voq vlơ a wŏq sŏq sinlơ sa lêng sô pachĕq bưn bap de. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />Nĕh sên sây sinlơ prênh poq tamun gĕh văng daq pring cồ sinlơ gan'hăp măq mi dông a nhi prăp mơh bạc Ai-câp de, mvăc nĕh chĕq măt vatom sĭq tât prơn yăh nĕh de. <verse eid="HEB 11:26" /><verse number="27" style="v" sid="HEB 11:27" />Don tôq camvân, nĕh lŭh ntrăch a Ai-câp, đăng phŭng sinlơ hao nuih vatau de; mvăc nĕh mbêr nuih wŏq vadâng dân ca sên sây Candranh cồ đăng sây gĕh. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />Don tôq camvân, nĕh ôp Lễ Saq Ntrăch bây sinlơ vrŏh n'ham, chĕq candranh tachưt khây con jibong đăng baq tât văl ganơ. <verse eid="HEB 11:28" /><verse number="29" style="v" sid="HEB 11:29" />Don ju tôq camvân, văl ganơ saq găn ntrăch daq Lênh Paho dân ca saq u vlơ ntĕh sâh, cồ gatŭq tamun Ai-câp vlam chơh daq tavŭq alưr lăm lŭh prơn nhâng bâng. <verse eid="HEB 11:29" /><verse number="30" style="v" sid="HEB 11:30" />Don tôq camvân, khây ding palây Yê-ri-cô talĭh jưr, alưr lăm saq rawênh lôch pâh năr. <verse eid="HEB 11:30" /><verse number="31" style="v" sid="HEB 11:31" />Don ju tôq camvân, ur ôp jên Ra-hap đăng chưt simơ bây khây vu đăng tôq, alưr lăm wŏq tăm pôn khây tamun saq sên yŭh palây bây nuih talaq yăh. <verse eid="HEB 11:31" /><verse number="32" style="v" sid="HEB 11:32" />En ănh hôm nhai wŏq vrŭq lây heq? Mvăc vadâq đăng lôch an ănh đơm sĭq Gê-đê-ôn, Ba-rac, Sam-sôn, Yep-thê, Đa-vit, nggâm bây Sa-mu-ên lawân khây tamun nhai lor wŏq, <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />cồ khây tamun, don tôq camvân, sŏq gĕh khây daq, ôp khây vrŭq sŏng yăh, wŏq sŏq gĕh camvŭm pănggân, khlop mŭnh yau chamhưr, <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />vŭq tangât prơn camhlăng ŭnh de, diêr ntrăch a pĭh taq, gĕh lavĕh prơn a gatŭq la-ui, gĕh jêng camhlăng lăm pâm minsŭh, ôp an khây mintan congti daq a ling alăh. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />Gŏq ndu ur wŏq sĭq vlâq tamun nhi cồ chưt nơm de a vrŭq hôm mrĭh sĭq vlâq, en khây vu ndây vlam vu săc si pagơq pahơn, đăng camvân gĕh vu an trŏh sĭq, chĕq khây nĕh don wŏq sinlơ tao rĭh rom yăh dông. <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />En hôm khây vu ndây gĕh wŏq sinlơ long găn a khây camvŭm gơm sâh bây pâm gông, en vlơ a nŏq wŏq cồ loih jicŏng bây nhi jingo. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />Khây nĕh vlam vu tôp tamô, vlăh var nơm, khây nĕh wŏq sinlơ long găn, chưt a pĭh taq panjwăch, khây nĕh saq nŏq heq sŭng ntô dive, ntô ve ve, vlam lŏh sat, vlam tân vôq, vlam pagơq pahơn; <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />(sŭng lăm dưnya heq cồ đăng dip yăh bây khây nĕh), vlam sinlơ dơp yâl taprăh taprăng sŭng tamăn singot, vlơ gŭng canăng, sŭng vơc răn gâp, sŭng ntu jru cồ atĕh ntĕh. <verse eid="HEB 11:38" /><verse number="39" style="v" sid="HEB 11:39" />En alưr lăm gĕh candân yăh payh ơ sinlơ tôq camvân, lĕq săq khây tamun heq ndŏh wŏq sŏq vlâq camvŭm pănggân an nơm, <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />mvăc Siđăch Trôq gĕh sŭmmrăp sinlơ yăh dông gĕh ratênh tât khây vơn, chĕq đăng gĕh khây vơn, nŏq khây nĕh đăng gĕh ôp an vênh yăh gĕh.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />Mvăc canŏq nhâng pành, sŭng lăm gĕh du garwang tŭq măq gŏq săq tamun candân gŭq rawênh nơm, nŏq khây vơn, alưr lăm hwât tagayh lĕq khây sinlơ canjâq njơng nggâm bưn bap cồ khăq king khwŏq takêp, en khoi lăp sŭng tanrong mprăng dăh ndap cồ gĕh chĕq sindăc u vôq măt vơn bây sinlơ mbêr nuih, <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />chĕq pănggrop măt deng lăp Siđăch Yêsu, Candranh Sun Tatao bây Candranh Ôp Jêng Lôch sinlơ tôq camvân, cồ Candranh payh u sinlơ hơn yăh chĕq u vôq măt nơm chĕq wŏq sŏq chhơ pagăn, sên dêh sinlơ gơm sâh, nggâm bây Siđăch gĕh gŭq a dăl ma ganwâr Siđăch Trôq. <verse eid="HEB 12:2" /><verse number="3" style="v" sid="HEB 12:3" />Căh mrŏng mrŏng sinâng tât Candranh gĕh wŏq sinlơ tăm chŏl dâng canŏq payh a khây tamun bưn bap dăh sĭq khây nĕh, chĕq pôp ŏh đăng vuyh n'hyoq sŭng nuih talaq nơm, têch tât sinlơ vông takhlĭh.<verse eid="HEB 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 12:4" />Pôp ŏh ndŏh tăm chŏl tât daq tapinh n'ham lăm tăm klŏq chŏl vlâq bưn bap, <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />cồ pôp ŏh nhâng hŭch tôr lĕq sinlơ pân tacăh, cồ camvŭm pađau tămti pôp ŏh dân ca con, pành:</para>
  <para style="q1" vid="HEB 12:5">“Ơ con ănh je, vâng sên nkhơch sinlơ lăh pađau Siđăch de,</para>
  <para style="q1" vid="HEB 12:5">khoi vâng vông tôr lăm Siđăch chih lăh;<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />Mvăc tamun Siđăch sinđach, nŏq Siđăch lăh vât,</para>
  <para style="q1" vid="HEB 12:6">bây Nĕh pâm ăp ndu con cồ Nĕh wŏq sŏq.”<verse eid="HEB 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />Pôp ŏh nhâng wŏq vadâng sŭng sinlơ lăh pađau; nŏq cồ Siđăch Trôq chĭh nhai bây pôp ŏh dân ca con. Mvăc tamun con lây cồ vap đăng chih pâm? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />Cồ canŏq hê pôp ŏh đăng wŏq sinlơ chih lăh, cồ sinlơ lĕq săq ŏh con gĕh jêng khây tamun wŏq simơ, canŏq pôp ŏh cồ khây ŏh con vôq vri, đăng gal cồ khây con nhâng. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />Dông wŏq, vơn gĕh khây vap săq swan nơm de, dân ca tamun lăh pađau, bây vơn nhâng iêt tôq; en sĭq bây Vap maq wênh nggui, cồ đăng gal vơn tôq phŭng gŏq dông wŏq, bây vơn nhâng cồ pành gĕh rĭh vồh? <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />Mvăc cồ vap sĭq maq săq swan lăh pađau vơn sŭng takiq năr bây vrŭq dân cồ pành yăh vlơ lĕq sĭq bây khây nĕh, en hôm cồ Vap maq wênh nggui lăh pađau payh ơ văt tât sinlơ tuyh twơ an vơn, chĕq tăm lăp ti sŭng sinlơ soch jrŏh Siđăch de. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />Payh cồ ăp sinlơ lăh pađau sŭng lăm sẫy lŭh đăng gĕh păch lây cồ sinlơ yăh vui, palâq sĭq vlâq ayh cồ ji côr, cồ canŏq sĭq alưr heq, vrŭq nŏq dĕh lŭh play yăh iên sinlơ sŏng yăh de an khây vu lây gĕh trui vŭh don u nĕh. <verse eid="HEB 12:11" /><verse number="12" style="v" sid="HEB 12:12" />Payh canŏq, căh tatao sĭq vlâq khây lapăng ti cồ lavăn tayưr bây khây vôq nkrŭng cồ can'hyo la'ngây, <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />bây căh ôp di sŏng khây trong saq an jâng pôp ŏh, chĕq tamun cannwe đăng chơh vlam wil tih trong tanrong, en ala lăp nŏq pành gĕh ranăm yăh.<verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />Căh dăh ndap sinlơ tăm yăh iên bây ăp ndu, nggâm jêng yăh soch, pành hê đăng gĕh vrŭq heq nŏq đăng vu lây gĕh deng sây Siđăch, <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />wŏq nhŭp vrŭq chĕq măt jơ sên di yăh, phŭng vu lây nŏq swâp ntrăch a sinăc yăh Siđăch Trôq de, phŭng pành diyĕh tăng lây nŏq hon hao ôp minsôc minsac, bây gŏq ndu tăm têp chhŭq chhau payh ơ nĕh, <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />phŭng vu lây nŏq cani camăn ha đăng tul cơnh dân ca Ê-sau, cồ tamun payh ơ tăm pagâl sŏq du păch sa lŭh tăch kwiềng con klô măq nơm de. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />Mvăc pôp ŏh gưt pành tât daq alưr nŏq, lăm ngwân cơnh wŏq sinlơ yăh, nŏq nĕh bị hwât lŭh, mvăc nĕh đăng wŏng gĕh vadâq lây chĕq palâq vôq, cồ pành gĕh wŏng miêng sinlơ yăh nŏq simơ bây daq măt.<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />Mvăc pôp ŏh payh đăng tât mơch bây vrŭq gĕh prơn tagoq lăp gĕh, bây ŭnh ngit lahưp, bây nhung jingo, bây sinlơ tĭq tưl, nggâm bây chhal mvrông <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />nggâm bây camvŭm nggôr tale de, nggâm bây mŭnh khây camvŭm de cồ khây tamun chăng ayh ngwân wĭnh chĕq khây nĕh đăng iêt chăng du camvŭm lây wŏq <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />Mvăc khây nĕh đăng wŏq truh camvŭm gĕh pân, pành: “Hê con gŏng lây tât daq ayh tagoq lăp gŭng, nĕh nŏq chơh vlam hwât mô.” <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />En sinlơ păng gui gĕh pơq lŭh nŏq taphlat nuih tôr tât daq Môi-se gĕh nhai: “Ănh phŭng candŭh bây râm săq.” <verse eid="HEB 12:21" /><verse number="22" style="v" sid="HEB 12:22" />Cồ canŏq, pôp ŏh gĕh tât Gŭng Si-ôn bây palây Siđăch Trôq lawân hôm mrĭh, bây Yê-ru-sa-lem gŭn gayh, bây a ravu tamơn con gŭn, bây sinlơ vatom măq mi, <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />bây vatom gŭn khây con jibong de cồ gĕh chêr săq vlơ khây tăp trôq, bây Siđăch Trôq cồ Candranh Ôp Dôih ăp ndu de, bây khây wênh tamun sŏng yăh de cồ gĕh ôp an vênh lôch, <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />bây Siđăch Yêsu, Candranh Vlăc Canđal tăm lăp ti me de, nggâm bây n'ham sŭng sinlơ vrŏh lŭh gĕh camvŭm nhai camhlăng dông wĕh bây A-bên. <verse eid="HEB 12:24" /><verse number="25" style="v" sid="HEB 12:25" />Căh jơ sên, phŭng pôp ŏh đăng wŏq Candranh cồ nhai pađau. Mvăc hê khây tamun tĭq cồ đăng ntrăch gĕh alưr lăm đăng wŏq tamun pân tacăh nơm u ntĕh heq, nŏq vơn vaih cồ viêm gŏq dông, lăm cồ tamun pale ncơi bây Candranh lŭh a trôq, <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />cồ camvŭm Candranh nŏq de ôp ntĕh lănggưn sŭng vadâq nŏq, en vrêq heq Siđăch gĕh pănggân pành: “Du dâq wŏq nơm Ănh ôp lănggưn, đăng gal ayh ntĕh, cồ lawân tăp trôq.” <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />En vau camvŭm “Du dâq wŏq” pađau dân vrŭq hwât tabayh khây sinlơ cồ lănggưn, dân ca khây păch cồ gĕh sun lŭh, chĕq an khây vrŭq đăng hôm lănggưn gĕh prơn hôm sĭq vlâq. <verse eid="HEB 12:27" /><verse number="28" style="v" sid="HEB 12:28" />Payh canŏq, vơn căh gĕh nuih talaq gưt may mo lăm wŏq sŏq du daq gŭn đăng lănggưn, chĕq don ju nŏq vơn cŭh sưmvăh bây tanrong ôp rom nuih Siđăch Trôq, bây nuih tôr iơq prĭh nggâm phŭng candŭh, <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />mvăc Siđăch Trôq vơn de cồ vông ŭnh sŏh roq.<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />Sinlơ tăm sinđach pôp ŏh de căh gât hôm diêt. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />Vâng hwât hŭch nuih talaq uĕh wŏq tamuôi, mvăc payh ơ vrŭq heq, takiq ndu đăng gưt pành nơm roq wŏq khây con gŭn. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />Gưt căh tât khây tamun gŭq u nhi jingo, dân ca gĕh krêh simơ bây khây nĕh, bây khây tamun vu pagơq pahơn, dân ca nơm pôp ŏh khoi gŭq sŭng du rup swan. <verse eid="HEB 13:3" /><verse number="4" style="v" sid="HEB 13:4" />Sinlơ tăm sai nŏq cồ vrŭq prĭh măq u sŭng ndăng con tamun, nggâm chơnơng ncao tăm sai nŏq căh đăng chĕq chhŭq chhau, mvăc Siđăch Trôq ôp dôih khây tamun tăm vĭq râm bây mintan cani camăn. <verse eid="HEB 13:4" /><verse number="5" style="v" sid="HEB 13:5" />Sinlơ rĭh pôp ŏh de căh đăng can'hir jên, lăm gưt vayh nuih sĭq khây păch cồ nơm gĕh, mvăc nơm Siđăch gĕh nhai: “Ănh đăng dâq lây paklăq ngai con, Ănh khoi đăng dâq lây hwât tabayh con,” <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />di tât daq, mvăc gĕh nuih talaq kram gajăp, vơn nhai:</para>
  <para style="q1" vid="HEB 13:6">“Siđăch cồ Candranh Nong Iơq ănh bây ănh nhâng đăng phŭng candŭh.</para>
  <para style="q1" vid="HEB 13:6">Con tamun pành ôp vrŭq lây tât ănh?”<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />Gưt căh tât khây tamun têch iau nơm, cồ khây tamun tămti Camvŭm Siđăch Trôq de an pôp ŏh, lăm deng sên plây jo sinlơ rĭh khây nĕh, căh pơch dăh sinlơ tôq camvân khây nĕh. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />Siđăch Yơt Dưnya Yêsu năr nđau, năr heq bây di tât wân lawân nŏq gât hôm mŏq mŏq. <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />Vâng tarŏh sŭng sinlơ lamvoch cồ lôch sinlơ pađau krây ca-ayh. Mvăc vrŭq rom yăh an nuih talaq pành gĕh gân iên don ju sinăc yăh, đăng gal a khây păch sa, en sĭq khây sinlơ nŏq, khây tamun rĭh don ju sinlơ nŏq đăng gĕh tuyh twơ lây. <verse eid="HEB 13:9" /><verse number="10" style="v" sid="HEB 13:10" />Vơn gĕh du mvrăh cŭh, cồ a nŏq, khây tamun ôp vrŭq sŭng padai cŭh đăng gĕh kwiềng sa. <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />Mvăc n'ham trŏh bưn bap, cồ păch lŭh a con gŏng, gĕh văt lăp sŭng khây gatŭq jrŏh soch ju sipăm măq, maq săq swan con gŏng nŏq sŏh aling padai congti. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />Payh canŏq, Siđăch Yêsu khoi wŏq sinlơ lŏh sat a maq aling lapông palây, chĕq Nĕh lôch prơn ôp jrŏh soch văl ganơ don ju n'ham nơm de. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />Payh canŏq, vơn căh tât bây Siđăch maq aling padai congti, văq nong sinlơ gơm sâh Siđăch de. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />Mvăc vơn đăng gĕh du palây lây hôm diêt tŭq heq, palâq vlâq, vơn nhâng wŏng miêng du palây mơch tât. <verse eid="HEB 13:14" /><verse number="15" style="v" sid="HEB 13:15" />Don u Siđăch, vơn lôch prơn pađăc con pađăc tapơ payom pađăc hao Siđăch Trôq sŭng ăp sinlơ, nŏq cồ ncao plây mŭnh vĕq de cuôl wŏq săq Siđăch de. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />En sĭq sinlơ ôp vrŭq yăh bây sinlơ tăm paq nong iơq nŏq vâng hŭch tôr mvăc Siđăch Trôq nhâng vui nuih talaq sĭq khây con pađăc canŏq. <verse eid="HEB 13:16" /><verse number="17" style="v" sid="HEB 13:17" />Gưt tôq iêt nggâm phlâq nơm u khây tamun têch iau pôp ŏh, mvăc khây nĕh iêh căh sĭq bây wênh nggui pôp ŏh de dân ca dơp lŭh camvŭm sơr lŭh dân, chĕq an khây nĕh lôch prơn ôp vrŭq nŏq ju nuih talaq hơn vui cồ đăng lŭh camvŭm ga mrau, mvăc vrŭq heq đăng gĕh tuyh twơ an pôp ŏh.<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />Căh vơu ngwân an khananh, mvăc khananh gĕh dĭh nuih pành nơm gĕh nuih tôr yăh, lăm cơnh can'hir hôm mrĭh yăh dip gal sŭng ăp vrŭq. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />En ănh gât cơnh jrông jrâng pôp ŏh ôp canŏq gŏq dông wŏq, chĕq ănh sô gĕh trŏh sĭq bây pôp ŏh.<verse eid="HEB 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />Siđăch Trôq iên yăh, Candranh gĕh iơq tao Candranh Tê Dive Măq, nŏq cồ Siđăch Yêsu vơn de, a gatŭq chưt don n'ham tăm lăp ti wân lawân, <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />ngwân Siđăch sŭmmrăp sindăc pôp ŏh bây ăp vrŭq rom yăh chĕq ôp bây nuih cơnh Siđăch, lăm ôp vrŭq dip nuih u vôq măt Siđăch sŭng vơn, don Siđăch Yơt Dưnya Yêsu, cồ Candranh cồ sindraq sindil dăh sĭq Siđăch di tât wân lawân đăng chôch. A-men.<verse eid="HEB 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />Wĭnh nhai bây pôp ŏh, ănh côt cĕh vuôi pôp ŏh lawân mbêr nuih bây camvŭm jrông jrâng yăh heq, mvăc ănh gĕh chêr an pôp ŏh ayh takiq camvŭm heq ngăn. <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />Pôp ŏh gưt pành tamun pôp ŏh Ti-mô-thê vơn de gĕh trŏq sĭq rĭh sŭng sinlơ lahông, en nggâm bây dêq nŏq ănh nhâng vlam măt pôp ŏh payh dêq nĕh sô tât.<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />Wĭnh khwây mơq lĕq săq khây tamun têch iau pôp ŏh nggâm lĕq săq khây Vatom Gŭn. Khây Vatom Gŭn a I-ta-li păng mơq pôp ŏh.<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />Ngwân wĭnh sinăc yăh gŭq bây lĕq săq pôp ŏh.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>