  <book code="3JN" style="id">EN_CRLT crw_Chrau_ltr Mon Feb 17 2025 09:52:32 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">3 John</para>
  <para style="toc1">Sirăq Yăng di pe</para>
  <para style="toc2">3 Yăng</para>
  <para style="toc3">3Jn</para>
  <para style="mt">3 Yăng</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />Chhŭng kwŏng chêr an Gai-ut yăh sinđach, tamun cồ ănh sinđach sŭng sinlơ dip gal.<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />Ơ pôp sinđach, sŭng ăp sinlơ, ănh ngwân an pôp gĕh vênh rămvi, tât daq sĭq maq rup swan gĕh yăh camhlăng dân ca sĭq maq wênh nggui pôp nĕh gĕh vênh rămvi. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />Mvăc ănh vui hơn lŭng lăm khây pôp ŏh tât bây ôp candân nhâng bâng sĭq pôp, bây ca vrŭq pôp gĕh saq bây trong dip gal. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />Ănh đăng gĕh sinlơ vui hơn lây măq dông ăp sinlơ heq, nŏq cồ ănh gĕh iêt chăng pành ŏh con nơm de gĕh saq bây trong dip gal.<verse eid="3JN 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />Ơ pôp yăh sinđach, pôp gĕh rĭh sŭng sinlơ tôq camvân sŭng ăp sinlơ lây cồ pôp gĕh ôp an khây pôp ŏh iưn, tât daq ôp vrŭq nŏq an khây chăm tamuôi, <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />cồ khây tamun lăq ôp candân sĭq sinlơ sinđach pôp de u vôq măt vatom gŭn. Pôp gĕh ôp yăh lôch lăm njưn khây nĕh saq trong bây vrŭq yăh dip gal bây Siđăch Trôq, <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />mvăc khây nĕh lăq saq lŭh mvăc Săq nŏq, lăm đăng wŏq păch lây a khây văl aling. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />Canŏq vơn căh wŏq khây tamun canŏq, chĕq vơn jêng lŭh khây tamun ôp vrŭq simơ an sinlơ dip gal.<verse eid="3JN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />Ănh gĕh chêr takiq camvŭm an vatom gŭn, nŏq Đi-ô-trep, tamun cồ uĕh cơnh tao yăq vôq ăp ndu, đăng gĕh wŏq khananh. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />Payh ơ tu tơm heq, hê ănh tât, ănh nhâng sên tât ăp vrŭq nĕh de cồ nĕh gĕh ôp lăm yăq mvâr khananh don a khây vrŭq chin'hâc. Bây lăm hôm ndŏh vayh nuih bây khây vrŭq nŏq, nĕh nŏq đăng cơnh wŏq khây pôp ŏh, en nĕh khoi păng khăq ăp ndu sindăc nuih talaq roc wŏq bây dăh khây nĕh lŭh ntrăch a vatom gŭn.<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />Ơ pôp sinđach, vâng pơch bây vrŭq viêm vây, nŏq căh pơch bây vrŭq yăh. Vu lây ôp yăh nŏq sĭq maq Siđăch Trôq, tamun ôp viêm nŏq ndŏh sây Siđăch Trôq.<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />Đê-mê-triu gĕh camvŭm candân yăh a ăp ndu bây a sinlơ dip gal. Sĭq măt ndây, khananh khoi ôp candân wŏq, bây pôp gưt pành camvŭm candân vơn de cồ nhâng.<verse eid="3JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />Ănh gĕh gŏq vrŭq chĕq chêr an pôp, nŏq ănh đăng cơnh sŏq daq chêr bây can'hêr chĕq chêr an pôp. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />Nŏq ănh ngwân vlam pôp di sô, bây vơn gĕh nhai vrŭq măt dân măt. <verse eid="3JN 1:14" /><verse number="15" style="v" sid="3JN 1:15" />Ngwân sinlơ yăh song săq gŭq bây pôp. Khây ganai u heq pân mơq pôp. Wĭnh gĕh camvŭm pân mơq khây ganai u nŏq a ndu a ndu.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>