<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="3JN" style="id">Bugun: Bible Translation 1st Edition</book>
  <para style="ide">Unicode (UTF8)</para>
  <para style="h">3 Jon</para>
  <para style="toc1">JON ro Uomchiieng pha Jigigam</para>
  <para style="toc2">3 Jon</para>
  <para style="toc3">3Jon</para>
  <para style="mt1">JON</para>
  <para style="mt2">Ro Uomchiieng Pha Jigigam</para>
  <para style="imt">Yaophi</para>
  <para style="ip">
    <char style="bk">“Dukho re-è” Jon shii uomchiieng pha jigi zey phi pha ne Gaius beng pha charch dumuii shii zey ruii phro. Gai masiphothek shii ai nong phi srane, Diothrephes beng pha bran ro gidieg phriie phi phro yao ne zey pho yi Gaius shii chiong phi ro.</char></para>
  <para style="iot">Iliing shii um pha ji</para>
  <para style="io1">Yaophi <char style="ior">(<ref loc="3JN 1:1-4">1-4</ref>) </char></para>
  <para style="io1">Gaius è chiong <char style="ior">(<ref loc="3JN 1:5-8">5-8</ref>) </char></para>
  <para style="io1">Diothrephes shii the <char style="ior">(<ref loc="3JN 1:9-10">9-10</ref>) </char></para>
  <para style="io1">Demethrius shii chiong <char style="ior">(<ref loc="3JN 1:11-12">11-12</ref>) </char></para>
  <para style="io1">Jongsha <char style="ior">(<ref loc="3JN 1:13-15">13-15</ref>) </char></para>
  <chapter number="1" style="c" sid="3JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">1: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:29">Blk 19:29</ref>; <ref loc="ROM 16:23">Rom 16:23</ref>; <ref loc="1CO 1:14">1Khor 1:14</ref></char>
    </note> Dukhow re-è—</para>
  <para style="p" vid="3JN 1:1">Guro miie pha Gaius shii, hanyie shii gu izai miie. <verse eid="3JN 1:1"/><verse number="2" style="v" sid="3JN 1:2"/>Guro bushun pha iijiiak, zab wie re yi pha nane na siu wie yi pha gu ne sia ramuii ro—Na ne ragung shii wie rone gu thieg. <verse eid="3JN 1:2"/><verse number="3" style="v" sid="3JN 1:3"/>Giak Masiphothek gu shii wuii ne gu shii yao, nane khama chua è isiie nane zai shii rai ramuii, ji yao shii gu ne bajo sang—Idang zai shii rai pha duiine rai ramuii. <verse eid="3JN 1:3"/><verse number="4" style="v" sid="3JN 1:4"/>Guro aniphiing zai shii rai ramuii ji yoi shii ji è yoh-yoh gu shii sang phi pha oi ro.<verse eid="3JN 1:4"/></para>
  <para style="s">Gaius shii chiong</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5"/>Guro bushun pha iijiiak, athiegphothek magunde nathek ne gai Masiphothek shii bajo migi è blia rek phi. <verse eid="3JN 1:5"/><verse number="6" style="v" sid="3JN 1:6"/>Ichiih pha charch shii ithek è naro miie pha miyao ji yao ro. Hamangkhung-aphuii shii sang pha rek pha lumuii shii ithek shii nong phi bo, ji è ai ne sang ruii phro. <verse eid="3JN 1:6"/><verse number="7" style="v" sid="3JN 1:7"/>Ithek ne migipho asi pha bran re-è nyie de nong ayie pha Masi ro blia shii khiajong ro. <verse eid="3JN 1:7"/><verse number="8" style="v" sid="3JN 1:8"/>Chiihphado, gethek Masipho hìpha branthek shii nong phi chid, ji anine ithek è zai pha blia rek pha ji shii gethek de mathang rey ruii.<verse eid="3JN 1:8"/></para>
  <para style="s">Diothrephes nane Demethrius</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9"/>Gu è charch shii jigi dum jia zey; jishii Diothrephes, hanyie è ithek ro dumuii rek yang jine guro miyao anuii phi. <verse eid="3JN 1:9"/><verse number="10" style="v" sid="3JN 1:10"/>Ai è gathek chiang nyie rum pha nane khlamphothek miyao yao, gu thog shii ne ai è nyie rek ruii pha ji shii zab khia ruii phro! Jishii aishii hanyie magunde jia è nyie acho ba phro; ai ne Masiphothek thog shii ne aho phro, chiih-è hanyie è masipho shii ho pha yangpho shii de gak muii phro chiih-è ithek shii ne charch è de fuang gieng pha saro phro! <verse eid="3JN 1:10"/><verse number="11" style="v" sid="3JN 1:11"/>Guro bushun iijiiak, awie pha jishii anui pha wie pha jishii nui bo. Hanyie è wie rek ithek ne Hamangkhung-aphuii ro; hanyie è awie pha rek ithek ne Hamangkhung-aphuii shii adoh ba ro. <verse eid="3JN 1:11"/><verse number="12" style="v" sid="3JN 1:12"/>Zab jia è Demethrius shii wie rone yao; zai de awai shii wie rone yao. Gathek de aishii wie rone yao, chiih-è na ne ìd gathek nyie yao pha jine zai ro.<verse eid="3JN 1:12"/></para>
  <para style="s">Idohhè pha salamthek</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13"/>Na shii yao pha gu shii ne bajo um, jimagunde gu ne kholom è azey yang ro. <verse eid="3JN 1:13"/><verse number="14" style="v" sid="3JN 1:14"/>Gu ne luthong nathek shii ne khthiie si ruii, chiihphado gethek ne ò jia shii nyamulo muii phro. <verse eid="3JN 1:14"/><verse number="15" style="v" sid="3JN 1:15"/>Liijiing nathek rog shii um bo. Zab na iijiiakthek ne salamthek thoh gey. Zab gethek ro iijiiakthek shii salam yao bo.<verse eid="3JN 1:15"/></para>
  <chapter eid="3JN 1"/>
</usx>
