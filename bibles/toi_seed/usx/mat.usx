<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">– Shanjo</book>
  <para style="h">Mateu</para>
  <para style="toc3">Mat</para>
  <para style="toc2">Mateu</para>
  <para style="toc1">Ibuka lya Mateu</para>
  <para style="mt2">Ibuka lya</para>
  <para style="mt1">Mateu</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">U mukoga gwa Jesu u Mushaligwa</para>
  <para style="r">(<ref loc="LUK 3:23-38">Luk 3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Ili nde ñolo li bonisa u mukoga gwa Jesu, u Mushaligwa gwa Nyambe uju ka li mwiwe gwa Deviti no mwiwe gwa Abbulaama.<verse eid="MAT 1:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="MAT 1:2" />Abbulaama ndege ka li isi gwa Isaka mi Isaka ndege ka li isi gwa Jakobo mi</para>
  <para style="q2" vid="MAT 1:2">Jakobo kale ga ba isi gwa Juda no bancegwe.<verse eid="MAT 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 1:3" />Juda kale ga ba isi gwa Pelezi no Zela, mi nyinabo ka li Tamale.</para>
  <para style="q2" vid="MAT 1:3">Pelezi kale ga ba isi gwa Ezilomi mi Ezilomi ndege ka li isi gwa Lami.<verse eid="MAT 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 1:4" />Lami ndege ka li isi gwa Aminadabi.</para>
  <para style="q2" vid="MAT 1:4">Aminadabi kale ga ba isi gwa Nashoni, mi</para>
  <para style="q1" vid="MAT 1:4">Nashoni kale ga ba isi gwa Salumoni.<verse eid="MAT 1:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="MAT 1:5" />Salumoni kale ga ba isi gwa Bboazi, mi nyina ka li Laaba.</para>
  <para style="q1" vid="MAT 1:5">Bboazi kale ga ba isi gwa Obbedi, mi nyina ka li Luti, mi</para>
  <para style="q2" vid="MAT 1:5">Obbedi ndege ka li isi gwa Jese.<verse eid="MAT 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 1:6" />Jese ndege ka li isi go mfumu Deviti,</para>
  <para style="q2" vid="MAT 1:6">mi Deviti kale ga ba isi gwa Solomoni<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">Solomoni sa ba u mfumu gwa Isilaele ku zwa ku mfumu Deviti.</char></note>. Mi nyina gwa Solomoni sa ba u mukazi gwa Uliya.<verse eid="MAT 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 1:7" />Solomoni ndeesi gwa Leoboami,</para>
  <para style="q2" vid="MAT 1:7">mi Leoboami kale ga ba isi gwa Abbija.</para>
  <para style="q1" vid="MAT 1:7">Abbija kale ga ba isi gwa Asa.<verse eid="MAT 1:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="MAT 1:8" />Asa ndeesi gwa Jeosafati,</para>
  <para style="q1" vid="MAT 1:8">mi Jeosafati kale ga ba isi gwa Jeolami.</para>
  <para style="q2" vid="MAT 1:8">Jeolami ndege ka li isi gwa Uziya.<verse eid="MAT 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 1:9" />Uziya ndeesi gwa Jotami, mi Jotami kale ga ba isi <optbreak />gwa Akaziya.</para>
  <para style="q2" vid="MAT 1:9">Akaziya kale ga ba isi gwa Ezekiya.<verse eid="MAT 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 1:10" />Ezekiya ndeesi gwa Manase,</para>
  <para style="q2" vid="MAT 1:10">mi Manase ndeesi gwa Amoni.</para>
  <para style="q1" vid="MAT 1:10">Amoni kale ga ba isi gwa Josiya,<verse eid="MAT 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 1:11" />mi Josiya ndeesi gwa Jekoniya no bancegwe uju sa bonigwa mu nako jo ntigilo jo bana ba Isilaele mwilonga <optbreak />lya Bbabbilona.<verse eid="MAT 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 1:12" />Aa se ba la ka zwi mu ntigilo mwilonga lya Bbabbilona,</para>
  <para style="q1" vid="MAT 1:12">Jekoniya kale ga ba isi gwa Sheyalutiyele, mi</para>
  <para style="q2" vid="MAT 1:12">Sheyalutiyele kale ga ba isi gwa Zelubabele.<verse eid="MAT 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 1:13" />Zelubabele ndege ka li isi gwa Abbiyudi,</para>
  <para style="q2" vid="MAT 1:13">mi Abbiyudi ndeesi gwa Eliyakimi.</para>
  <para style="q1" vid="MAT 1:13">Eliyakimi kale ga ba isi gwa Azoli.<verse eid="MAT 1:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="MAT 1:14" />Azoli ndeesi gwa Zadoki,</para>
  <para style="q1" vid="MAT 1:14">mi Zadoki kale ga ba isi gwa Akimi.</para>
  <para style="q2" vid="MAT 1:14">Akimi kale ga ba isi gwa Eliyudi.<verse eid="MAT 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 1:15" />Eliyudi kale ga ba isi gwa Eliza,</para>
  <para style="q2" vid="MAT 1:15">mi Eliza kale ga ba isi gwa Matani.</para>
  <para style="q1" vid="MAT 1:15">Matani ndeesi gwa Jakobo, mi<verse eid="MAT 1:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="MAT 1:16" />Jakobo kale ga ba isi gwa Josefa, uju ka sesete Maliya.</para>
  <para style="q1" vid="MAT 1:16">Mi Maliya ndege ka li nyina gwa Jesu uju ka kugigwa <optbreak />u Mushaligwa.<verse eid="MAT 1:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Jonse i mikoga ka ji itilila i kumi no jone ku tatikila kwa Abbulaama ku ja kwa Deviti, no mikoga je kumi no jone ku zwa kwa Deviti ku ja ku nako ka ba joja a bana ba Isilaele mu ntigilo mwilonga lya Bbabbilona, no mikoga je kumi no jone ku zwa ku ntigilo ja mwilonga lya Bbabbilona ku twala ku Mushaligwa.<verse eid="MAT 1:17" /></para>
  <para style="s">Uku bonigwa kwa Jesu u Mushaligwa</para>
  <para style="r">(<ref loc="LUK 2:1-7">Luk 2:1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Uku bonigwa kwa Jesu u Mushaligwa mbuti se ku tendaalila buti, nyina ka gungilikizwe buti na sesegwe kwa Josefa. Kono na ba sini uku kala antu-onke, Maliya kale ga gwanaala buti sa li sumbele ko Moya go Kucena. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Kakuli Josefa muka Maliya ka sepaala ku mulao, mi ta ka shaka buti a fwise Maliya inshoni ku bantu, kale ga gaja bulyo buti a mu lukulule bu ombelele.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />Kono aa sa la gaji byebyo, kale ga lota iñiloi lyo Mfumu na li bonaala kwakwe na li ta na lyo, “Josefa, mwana Deviti, u leke uku joga uku inda Maliya no ku mu twala ku njugo ku ba u mukazi gwako, kakuli u busumba bwakwe nku Moya go Kucena bu zwa. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Kuti na bone u mwana go muninzana mi igwe no mu gulike izina lya Jesu kakuli kuti na jojese a bantu bakwe ku zwa ku bitendantu i bimangoju byabo.”<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Byonse byebyo kale bya tendaala ku vumbiliza ubu sa co u Mfumu ko muboni gwakwe buti,<verse eid="MAT 1:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="MAT 1:23" />“U mwalyansho kuti na sumbale</para>
  <para style="q2" vid="MAT 1:23">no ku bona u mwana go muninzana</para>
  <para style="q1" vid="MAT 1:23">mi kuti na ba mu kugange buti ndi Imanuwele,<note caller="+" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="ISA 7:14">Isaya 7:14</ref>.</char></note></para>
  <para style="q2" vid="MAT 1:23">ku toloka buti, ‘Nyambe neswe a kele.’ ”<verse eid="MAT 1:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Josefa aa buka, kale ga tenda ubu na lya mu lagila iñiloi lyo Mfumu, mi kale ga inda Maliya ku ba u mukazi gwakwe. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Kono Josefa ta ka lalanga nage ku twala aa na ga bonena u mwana go muninzana. Mi kale ga mu gulika izina lya Jesu.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">A bankosi bo magano ba ku buzwe-juba</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Jesu aa sa la bonenwa mwa Bbeteleema mwilonga lya Judeya, mu nako jo mfumu Eloda. A bankosi bo magano aba ka ba zwa ku buzwe-juba, kale ba keza ku sika mu munzi gwa Jelusalema <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />kale ba buza nabo, “Kwibo a li uju na ga bonigwa u mfumu go Majuda? Na twa bona u lutungwezi lwakwe aa ka lu nanuka mi tu la kezi buti tu mu shogelele.”<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />U mfumu Eloda aa shugwa bulyao, kale ga zielea mane no bantu bonse ba mu munzi gwa Jelusalema. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Eloda aa sa la kugi no ku gwanika a mapulisiti a bakulu bo bantu bonse no bazigi bo mulao kale ga ba buza uku ka botele uku bonenwa u Mushaligwa. <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Kale ba taba nabo, “Mwa Bbeteleema mwilonga lya Judeya kakuli mbobo sa ñolela u muboni gwa Nyambe buti,<verse eid="MAT 2:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />‘Kono inwe mwe</para>
  <para style="q2" vid="MAT 2:6">bantu ba mwa Bbeteleema mwilonga lya Juda,</para>
  <para style="q2" vid="MAT 2:6">ta mu li bashwauki mukati ko babusisi ba mwa Juda,</para>
  <para style="q1" vid="MAT 2:6">kakuli mukati kenu kuti na ku zwe u mubusisi</para>
  <para style="q2" vid="MAT 2:6">uju na lise a bantu bangu ba Isilaele.’ <note caller="+" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="MIC 5:2">Mika 5:2</ref>,<ref loc="MIC 5:4">4</ref>.</char></note> ”<verse eid="MAT 2:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Eloda kale ga kuga babo a bankosi bo magano mu buzinda mi kale ga ba buza inako wawa na lwa bonaala u lutungwezi. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Eloda kale ga ba tuma kwa Bbeteleema no ku ta nage, “Mu ka je no ka shakisisa nenja u mwanuke. Mu si ka mu gwana, mu keze mu ndi zibise, buti neme na ndi ka je no ka mu shogelela.”<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Aa se ba la shugwi u mfumu kale ba ka li jila mu nzila jabo. Mi u lutungwezi ulu na ba bona aa ka lu nanuka kale lwa ba tangilila ku twala aa na lwa ka zimanina egulu lyo cibaka aa ka li u mwanuke. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Babo a bankosi aa se ba la boni u lutungwezi kale ba jangala lwini. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Aa ba keza ku njugo, kale ba bona u mwanuke no nyina Maliya mi kale ba tongama no ku mu shogelela. Kale ba galula u lubono lwabo no ku mu wa a mampo go butale bwa gauda, insense no mila.<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">U busu bu nunka nenja ka bu kugigwa insense, mi a mafuta go menzi ka ga kugigwa mila.</char></note> <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Mi aa se ba la nanguzwi mwiloto buti ba leke uku bogola kwa Eloda, kale ba bogola kwilonga lyabo ko nzila jimwinya.<figure style="fig" alt="The Wise Men worship Jesus" file="cn01632b.jpg" size="span" loc="Mat 2:7 - 12" ref="2:7-12">A bankosi bo magano aa ba shogelela Jesu</figure><verse eid="MAT 2:12" /></para>
  <para style="s">Jesu aa andila kwa Egepita</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Babo a bankosi aa se ba la bogoli, iñiloi lyo Mfumu kale lya li bonaaza kwa Josefa mwiloto na lyo, “Buka, u inde u mwanuke no nyina mu andile kwa Egepita. Na mu ka kale koko ku twala aa na ndi ku lugwile, kakuli Eloda kuti na shakisise u mwanuke buti a mu yage.” <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Cwale Josefa kale ga buka, mi kale ga inda u mwanuke no nyina gago a masiku mi kale ba ja kwa Egepita, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />uku na ga ka kala ku twala ku lufu lwa Eloda. Mi kale kwa vumbilizwa bulyo ibi sa gamba u Mfumu ko muboni gwa Nyambe aa sa co buti, “Se ndi kuga Mwanangu ku mu zwisa mwa Egepita.”<note caller="+" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="HOS 11:1">Oseya 11:1</ref>.</char></note><verse eid="MAT 2:15" /></para>
  <para style="s">Uku yagigwa ko banuke ba mwa Bbeteleema</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Eloda aa sa la nanguli buti a bankosi bo magano na ba mu oma, kale ga lunguka, kale ga wa inzuminino jo ku yaga a baninzana bonse mwa Bbeteleema no mu minzi ja mu mbali aba se ka ba kwesi i myaka jo bile ku bogoza ansi, ku jendelela no nako na ga ziba ku zwa ku bankosi bo magano.<verse eid="MAT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 2:17" />Mi ibi na bya gambigwa ko muboni gwa Nyambe Jelemiya kale bya vumbilizwa ibi bi ta buti,<verse eid="MAT 2:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />“Ijwi na lya shugwigwa mwa Lama,</para>
  <para style="q2" vid="MAT 2:18">a malilo no ku tompa u kunene,</para>
  <para style="q1" vid="MAT 2:18">ndi Laele a lilila bane</para>
  <para style="q2" vid="MAT 2:18">mi ta shaki uku senga-sengigwa,</para>
  <para style="q2" vid="MAT 2:18">kakuli bonse na ba fwa.”<note caller="+" style="x"><char style="xo" closed="false">2:18 </char><char style="xt" closed="false"><ref loc="JER 31:15">Jelemiya 31:15</ref>.</char></note><verse eid="MAT 2:18" /></para>
  <para style="b" />
  <para style="s">Josefa aa bogola kwa Nanzaleta</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Eloda aa sa la fwi, iñiloi lyo Mfumu kale lya bonaala mwiloto kwa Josefa mwa Egepita <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />no ku mu ta na lyo, “Buka, u inde u mwanuke no nyina mi mu bogole kwilonga lya Isilaele, kakuli aba ka ba jeleka uku yaga u mwanuke na ba fwa.”<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />Cwale Josefa kale ga buka, mi kale ga inda u mwanuke no nyina no ku ja kwilonga lya Isilaele. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Kono aa shugwa buti Akileyusi ndege ka busa mwa Judeya mu cibaka ceesi Eloda, kale ga joga uku jako. Aa sa la nanguzwi mwiloto kale ga ja mwilonga lya Galileya, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />mi kale ga ka ja no ka joja mu munzi ka gu kugigwa Nanzaleta. Cwale kale kwa vumbilizwa ibi se ba ta a baboni ba Nyambe buti, “Mwina Nanzaleta.”<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">Joani u mukolobezi aa shaba inzila</para>
  <para style="r">(<ref loc="MRK 1:1-8">Male 1:1-8</ref>; <ref loc="LUK 3:1-18">Luk 3:1-18</ref>; <ref loc="JHN 1:19-28">Joa 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Momo mu majuba kale kwa keza Joani u mukolobezi, na tandaza a bantu aba ka ba joja mu mangusu gelonga lya Judeya. <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />Ka tandaza nage, “Mu siguluke kakuli u mubuso gwegulu na gwa keza a fuwi.” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Joani ndege ka gambigwa ku muboni gwa Nyambe Isaya buti,</para>
  <para style="b" vid="MAT 3:3" />
  <para style="q1" vid="MAT 3:3">“Ijwi lyo ju a kugiliza mu mangusu.</para>
  <para style="q1" vid="MAT 3:3">‘U shabe inzila jo Mfumu,</para>
  <para style="q2" vid="MAT 3:3">U mu golwele a mazila!’ ”<note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">Isaya 40:3</ref>.</char></note><verse eid="MAT 3:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />I bizwato bya Joani ka bi li byo ku suma a boja bo nkamele, mi ka kwesi u lukaku lo mukumba mu munda jakwe. I bilyo byakwe ka bi li bipansi no buci bwa mu lugole. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />A bantu kale ba ka ja kwakwe ku zwa mwa Jelusalema no mwilonga lyonse lya Judeya mane nelonga lyonse lya Joodani. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Ko ku li lugula i bitendantu i bimangoju byabo, Joani ka ba kolobeza mu Lwizi lwa Joodani.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Joani aa bona u bungi bo Bafalisi no Basaduki na ba keza uku ka kolobezeza, kale ga ba ta nage, “Inwe mwe luasi lo bili! Ndini na ga mi nanguza uku anda ku bukali ubu bu keza? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Mu ake i biyango bi jendelela no nsiguluko. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Mi mu leke uku gaja buti mu la gola uku li ta mwebeni buti, ‘Isetu ndi Abbulaama.’ Nda sa mi lugwila buti Nyambe a la gola uku tendela Abbulaama a bana ku zwa a gaga a mabwe. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />A katemu se ka li li a miisi jo bishamu, mi i cishamu conse ici ta ci aki i biyango i bilotu kuti na ci temegwe no ku shonjelwa mu mulilo.<verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />“Nda sa mi kolobeza ko menzi buti mu gwane insiguluko. Kono nkwali uju a keza mwishule lyangu uju a kwesi inguzu ku ndi ita, mi ta ndi botele uku inda inshangu jakwe. Kuti na mi kolobeze ko Moya go Kucena no mulilo. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />I civuluso cakwe mu maganja gakwe ci li, mi kuti na kule a cindanda cakwe, no ku gwanika u buloto bwakwe mu mayongo no ku tenta u luungu ko mulilo ugu ta gu zimi.”<verse eid="MAT 3:12" /></para>
  <para style="s">Inkolobezo ja Jesu</para>
  <para style="r">(<ref loc="MRK 1:9-11">Male 1:9-11</ref>; <ref loc="LUK 3:21-22">Luk 3:21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Cwale Jesu kale ga zwa mwa Galileya no ku ja kwa Joodani buti aka kolobezigwe kwa Joani. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Kono Joani kale ga jeleka uku mu kanina nage, “Ndigwe u botele uku ndi kolobeza, mi gwa sa keza kwangu?”<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Jesu kale ga taba nage, “U leke ku tendaale bulyao aano, ku li botele kwetu uku tenda bulyaa ku vumbiliza uku lulikila konse.” Cwale Joani kale ga zumina.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Aobulyo Jesu aa sa la mani uku kolobezigwa, kale ga bomboka mu menzi. Mwa jejo inako igulu kale lya galuka, mi kale ga bona u Moya gwa Nyambe na gu sezumukila akwe sinagwe nu nziba. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Mi ijwi kale lya zwa kwigulu li ta buti, “Joju ndi Mwanangu, ndi la mu shaka lwini mi a la ndi nyangulula nenja.”<figure style="fig" alt="John Baptizes Jesus" file="wa03810b.jpg" size="col" loc="Mat 3:13-17" ref="3:13-17">Joani aa kolobeza Jesu</figure><verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">I mijeleko ja Jesu</para>
  <para style="r">(<ref loc="MRK 1:12-13">Male 1:12-13</ref>; <ref loc="LUK 4:1-13">Luk 4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Cwale Jesu kale ga twaligwa mu mangusu ko Moya buti a ka jelekigwe kwa Satani. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Aa sa la linyimi i bilyo mu majuba go makumi gone no masiku go makumi gone, kale ga fwa injala. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />U mujeleki kale ga keza kwakwe no ku mu ta nage, “Ati u li Mwana Nyambe, u lugwile gaga a mabwe ga zoke u buobe!”<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Jesu kale ga taba nage, “Ku li ñoletwe buti,</para>
  <para style="b" vid="MAT 4:4" />
  <para style="q1" vid="MAT 4:4">‘U muntu ta na joje u buobe bulyo, <optbreak />kono no keejwi lyonse ili li zwa <optbreak />mu kanwa ka Nyambe.’ <note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">Mulao 8:3</ref>.</char></note> ”<verse eid="MAT 4:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Satani kale ga mu twala ku Munzi gu Cenete no ka mu zimika a bule wawa bo tempele.<note caller="+" style="f"><char style="fr" closed="false">4:5 </char><char style="ft" closed="false">I tempele ni njugo inene ja Nyambe iji ka ji gwanaala bulyo mu munzi gwa Jelusalema u mu ka ba lapelelanga a Maisilaele. Ka ba zuminanga buti Nyambe mwali momo mu njugo.</char></note> <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />Kale ga ta nage, “Ati u li Mwana Nyambe u li shonjele ansi gwemwini, kakuli mbuti ku ñoletwe buti,</para>
  <para style="b" vid="MAT 4:6" />
  <para style="q1" vid="MAT 4:6">‘Kuti na lage a mañiloi gakwe</para>
  <para style="q1" vid="MAT 4:6">kebaka lyako mi kuti na ga ku nanune mu maganja gago,</para>
  <para style="q2" vid="MAT 4:6">buti no leke uku kaba itende lyako mwibwe.’ <note caller="+" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">Nimbo 91:11-12</ref>. </char></note> ”<verse eid="MAT 4:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Jesu kale ga mu taba nage, “Ku li ñoletwe kame buti, ‘U leke uku tula u Mfumu Nyambe gwako mu ntatubo.’ <note caller="+" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="DEU 6:16">Mulao 6:16</ref>. </char></note> ”<figure style="fig" alt="The pinnacle of the Temple" file="lb00249b.jpg" size="col" loc="Mat 4:5-7" ref="4:5-7">U bule wawa bo Tempele</figure><verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Kame, Satani kale ga mu twala elundu ile no ku mu bonisa i mibuso jonse jelonga no bulotu bwajo. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Kale ga mu ta nage, “Byonse byebi kuti na ndi bi ku we ati kuti u tongame no ku ndi lapela.”<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Jesu kale ga mu ta nage, “U zwe kwangu, Satani! Kakuli ku li ñoletwe buti,</para>
  <para style="b" vid="MAT 4:10" />
  <para style="q1" vid="MAT 4:10">‘U lapele u Mfumu Nyambe gwako</para>
  <para style="q2" vid="MAT 4:10">mi u mu sebeleze ige bulyo genke.’ <note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="DEU 6:13">Mulao 6:13</ref>. </char></note> ”<verse eid="MAT 4:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Cwale Satani kale ga mu leka mi a mañiloi kale ga keza no ku mu tusa.<verse eid="MAT 4:11" /></para>
  <para style="s">Jesu aa tatika uku tandaza</para>
  <para style="r">(<ref loc="MRK 1:14-15">Male 1:14-15</ref>; <ref loc="LUK 4:14-15">Luk 4:14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Jesu aa shugwa buti Joani na ga tuligwa mu ntolongo, kale ga bogola kwa Galileya. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Aa zwa mwa Nanzaleta, kale ga ja no ka joja mwa Kapenauma, uju ka li afuwi neziba mwilonga lya Zebuloni no Nafetali. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Ku vumbiliza ibi se bi gambigwa ko muboni gwa Nyambe Isaya aa sa ta buti,<verse eid="MAT 4:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />“Mwilonga lya Zebuloni nelonga lya Nafetali,</para>
  <para style="q2" vid="MAT 4:15">Inzila je Wate mwisilya lya Joodani,</para>
  <para style="q1" vid="MAT 4:15">Galileya go bantu aba ta ba li a Majuda,<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />a bantu ba joja mu kansindwe</para>
  <para style="q2" vid="MAT 4:16">na ba bona ituba inene,</para>
  <para style="q1" vid="MAT 4:16">a babo ba joja mwilonga lyo munzule go lufu</para>
  <para style="q2" vid="MAT 4:16">ituba lyo maca-siku na lya bonaala.”<note caller="+" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="ISA 9:1-2">Isaya 9:1-2</ref>.</char></note><verse eid="MAT 4:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Ku zwa mwa jeji inako no ku nungako Jesu kale ga tatika uku tandaza, na ta nage, “Mu siguluke, kakuli u mubuso gwegulu se gu li li afuwi.”<verse eid="MAT 4:17" /></para>
  <para style="s">A bazigigwa ba Jesu betanzi</para>
  <para style="r">(<ref loc="MRK 1:16-20">Male 1:16-20</ref>; <ref loc="LUK 5:1-11">Luk 5:1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Jesu aa ka itile afuwi neziba inene lya Galileya, kale ga bona a bankosi bo bile, Simoni uju ka kugigwa Pitolosi no mwancegwe Andileya. Kame ka ba shonjele a kanyandi mwiziba, kakuli ka ba li mandui. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Jesu kale ga ta nage, “Mu keze mu ndi umpilile mi kuti na ndi mi tume buti mu ka yambe a bantu.” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Aobulyo, kale ba leka u tunyandi twabo no ku mu umpilila. <verse eid="MAT 4:20" /><verse number="21" style="v" sid="MAT 4:21" />Aa sa la zwio, kale ga bona a bankosi bamwinya bo bile, ndi Jakobo mwana Zebedeya no mwancegwe Joani. Mu bwato ka ba li nesabo Zebedeya, na ba tazinga u tunyandi twabo. Jesu kale ga ba kuga, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />mi aobulyo kale ba leka u bwato nesabo no ku mu umpilila.<figure style="fig" alt="Jesus call disciples to follow Him" file="cn01681b.jpg" size="span" loc="Mat 4:18-22" ref="4:18-22">Jesu aa kuga a bazigigwa</figure><verse eid="MAT 4:22" /></para>
  <para style="s">Jesu aa ziga no ku oza a bantu</para>
  <para style="r">(<ref loc="LUK 6:17-19">Luk 6:17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Jesu kale ga ja bu zimbuluka mwilonga lyonse lya Galileya na ziga mu majugo go malapelelo go Majuda,<note caller="+" style="f"><char style="fr" closed="false">4:23 </char><char style="ft" closed="false">A majugo go malapelelo go Majuda, majugo u mu ka ba gwananinanga a Majuda, ku bala a mabuka ga Mushe no ku kumbila i bintu kwa Nyambe. Mu Cigelike ka ba ga kuganga buti Masinagoge.</char></note> na ja bu gamba a majwi a malotu go mubuso, no ku oza a malwele ga andene-andene mukati ko bantu. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />I ñambagulo jakwe kale ja jandulukila mwilonga lyonse lya Siliya, mi a bantu kale ba mu letela a bantu bonse aba ka ba lwala a malwele ga andene-andene, na ba ka ba penga ku nshishamo imbi, aba ka ba munitwe ku mayauma no bo malwele go ku fwanga no bo ku golomena i bilama mi kale ga ba oza. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />A bantu a bangi aba ka ba zwa mwa Galileya, Dekapolisi, Jelusalema, Judeya nelonga lya mwisilya lya Joodani kale ba mu umpilila.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Inzigo ja Jesu ja elundu</para>
  <para style="r">(<ref loc="MAT 5:1-7:29">5:1–7:29</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Ijuba limwinya Jesu aa bona a bantu a bangi ba keza kwakwe kale ga kala a nkambamo jelundu mi a bazigigwa bakwe kale ba senena kwakwe. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Jesu kale ga tatika uku ba ziga nage,<verse eid="MAT 5:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />“Imfwijaguzi ja Nyambe nja bantu a bampale mu moya</para>
  <para style="q2" vid="MAT 5:3">kakuli u mubuso gwa kwigulu ngwabo.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Imfwijaguzi nja bantu aba ba lila,</para>
  <para style="q2" vid="MAT 5:4">kakuli kuti na ba senga-senge.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Imfwijaguzi nja bantu a bagomba</para>
  <para style="q2" vid="MAT 5:5">kakuli kuti na ba jobole ilonga.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Imfwijaguzi ja Nyambe nja bantu aba ba fwa injala no nyotwa jo ku lulikila,</para>
  <para style="q2" vid="MAT 5:6">kakuli kuti na ba ezululwe.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Imfwijaguzi ja Nyambe nja bantu ba kwesi inse,</para>
  <para style="q2" vid="MAT 5:7">kakuli nabo kuti na ba fwilwe inse.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Imfwijaguzi nja bantu ba cenete mu myojo,</para>
  <para style="q2" vid="MAT 5:8">kakuli kuti na ba bone Nyambe.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Imfwijaguzi nja bantu aba ba leta buti a bantu ba joje nenja,</para>
  <para style="q2" vid="MAT 5:9">kakuli kuti na ba kugigwe buti mbana Nyambe.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Imfwijaguzi nja bantu ba pengisigwa kebaka lyo ku lulikila,</para>
  <para style="q2" vid="MAT 5:10">kakuli u mubuso gwa kwigulu ngwabo.<verse eid="MAT 5:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />“Mu li kwesi imfwijaguzi a bantu aa ba mi tukagula, no ku mi pengisa mane no ku mi kwaga ko bubi bonse ko manya kebaka lyangu. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Mu jangale no ku tangalala kakuli u mupuzo gwenu munene mwigulu, kakuli mbobo ka ba pengisezanga no baboni ba Nyambe aba ka ba liko inwe na mu sini uku bako.<verse eid="MAT 5:12" /></para>
  <para style="s">Izwai ne Tuba</para>
  <para style="r">(<ref loc="MRK 9:50">Male 9:50</ref>; <ref loc="LUK 14:34-35">Luk 14:34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />“Ndinwe zwai lyelonga, kono ati izwai na li sampuka, mbuti mu gola uku li tendela buti li shugwaale nenja kame? Ta li si kwesi u bulotu bumwinya kame kono mbwita uku li showa no ku lyataguligwa.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />“Ndinwe tuba lyelonga. U munzi gu jakilwe elundu ta gu goli uku bikama. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Takuli u muntu a gola uku jakiza lambi no ku mu fulumika i ciemele. Kono mpantu ku bonaala a botele uku tuligwa buti a bonise ituba ku bantu bonse ba li mu njugo. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Nenwe bulyao, mu leke ituba lyo bitendantu i bilotu byenu li munike buti a bantu bonse ba li bone mi ba lumbe Isenu gwa kwigulu.<verse eid="MAT 5:16" /></para>
  <para style="s">Byo mulao</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />“Mu leke uku gaja buti mulao kampa ibi na ba ñola a baboni ba Nyambe, na nda keza ku manisa. Inga! Kame na nda keza ku vumbiliza ibi na ba ñola. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Mbyaconse ndi mi lugwila buti, ku twala ku nako igulu nelonga aa na bi zweko, takuli nanga muñolelo u mununu go mulao ugu na gu zweko uku i bintu byonse ibi ka bi botele uku tendaala na bi sini uku tendaala. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />U muntu gense uju a shwauza u mulao, gu niniye gu mane, no ku ziga bamwinya uku tenda bulyao, kuti na kugigwe buti munini mu mubuso gwa kwigulu. Kono uju a kutika jeji i milao no ku ziga bamwinya bulyao, kuti na kugigwe buti munene mu mubuso gwa kwigulu. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Kakuli nda sa mi lugwila buti aa ta mu bi no ku lulikila uku ku ita ko bazigi bo mulao no Bafalisi, ta na mu ngine mu mubuso gwegulu.<verse eid="MAT 5:20" /></para>
  <para style="s">Jesu aa ziga byo bushanshu</para>
  <para style="r">(<ref loc="LUK 12:57-59">Luk 12:57-59</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />“Na mwa shugwa buti basukuzetu ba ku nkulu-katanzi se ba lugwilwa buti, ‘U leke uku yaga, mi u muntu gense uju a yaga u muntu, a li botele uku atuligwa.’<note caller="+" style="x"><char style="xo" closed="false">5:21 </char><char style="xt" closed="false"><ref loc="EXO 20:13">Lujendo 20:13</ref>; <ref loc="DEU 5:17">Mulao 5:17</ref>. </char></note> <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Kono mbuti ndi mi tela buti, u muntu gense uju a nyegelela u muntu jumwinya, a li botele uku atuligwa. Kame u muntu gense uju a ta jumwinya buti, ‘U li cigelo,’ a li botele uku twaligwa ku nkuta. Mi uju a konkwela jumwinya, kuti na be mu bujoge bweleba lyo mulilo.<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />“Cwale aa u leta i citagilo a lutala lwa mu njugo ja Nyambe mi so la vuluka buti nkwali uju u li nyegelele nage, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />u leke i citagilo cako ao a lutala mi u bogole mu ka zumininane tanzila no mugenzo, nko kuti u ka bogole nenja no keza ku wa i citagilo cako kwa Nyambe.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />“Ati u muntu a ku zimbite na ku twala ku nkuta, u li kumbilile kwakwe na mu si jenda mu nzila, kakuli aa se mu la ka siki kuti a ka ku we ku muatuli mi ige kuti a ku tule mu nguzu jo mupokola mi kuti na ku shonjele mu ntolongo. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Nda sa ku lugwila initi to no zwemo mbwita aa no lifile isheleñi lyo mamaninino.<verse eid="MAT 5:26" /></para>
  <para style="s">Jesu aa ziga byo ku zwa ku cise</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />“Na mwa shugwa aa se ku tegwa buti, ‘U leke uku tenda i cise,’<note caller="+" style="x"><char style="xo" closed="false">5:27 </char><char style="xt" closed="false"><ref loc="EXO 20:14">Lujendo 20:14</ref>; <ref loc="DEU 5:18">Mulao 5:18</ref>.</char></note> <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Kono ime mbuti ndi mi tela buti, u muntu gense uju a lola u mwanakazi ko lwinsho, kale ga tenda i cise nage mu mojo. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Cwale ati i linsho lyako lyo mulyo aa li ku sitagalisa, u li nonkole no ku li showa. Kakuli i cintu i cilotu kwako nku jonekelwa i cilama conke co mubili gwako ku ita buti u mubili gwako gonse gu ka shonjelwe mwileba lyo mulilo. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Mi ati iganja lyako lyo mulyo na li ku tendisa i bitendantu i bimangoju, u li koshole no ku li showa. I cintu i cilotu kwako, nku jonekelwa i cilama conke co mubili gwako ku ita u mubili gonse gwako aa gu ka shonjelwa mwileba lyo mulilo.<verse eid="MAT 5:30" /></para>
  <para style="s">Jesu aa ziga byo ku manisanga a maseswa</para>
  <para style="r">(<ref loc="MAT 19:9">Mat 19:9</ref>; <ref loc="MRK 10:11-12">Male 10:11-12</ref>; <ref loc="LUK 16:18">Luk 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />“Se ku tegwa mu mulao buti, ‘U muntu a la gola uku kana no ku manisa a maseswa no mukazi gwakwe ko ku mu ñolela iñolo lyo ku mu kana no ku li mu wa.’<note caller="+" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="DEU 24:1">Mulao 24:1</ref>.</char></note> <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Kono ime nda sa mi ta buti, u muntu gense uju a kana mukazi gwakwe uku ta li ngwa cise, kale ga mu letela buti a be go cise. Mi u muntu gense uju a sesa u mwanakazi uju na ga kanigwa, nage kale ga tenda i cise.<verse eid="MAT 5:32" /></para>
  <para style="s">Jesu aa ziga byo ku sa konka</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />“Se mu shugwa kame buti basukuzetu se ba lugwilwa buti, ‘Mu leke uku colanga inkuluwizi na mwa kuluwiza u Mfumu Nyambe ko ku konka,’<note caller="+" style="x"><char style="xo" closed="false">5:33 </char><char style="xt" closed="false"><ref loc="NUM 30:2">Mapalo 30:2</ref>.</char></note> <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Kono nda sa mi ta buti, mu leke ku kuluwizanga ko ku konka. Kampa nku konka kegulu, kakuli nce cikalo co bumfumu ca Nyambe, <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />kampa nku konka kelonga, kakuli ngo malyatililo gakwe. Mu leke ku konka nanga nka Jelusalema kakuli Jelusalema ngo munzi u munene go Mfumu u Munene. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Mu leke uku konkanga nanga nka mitwi jenu, kakuli ta mu goli uku zola u lushuki nanga ndonke buti lu tube kampa buti lu siye. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Kono inwe mu tange bulyo buti, ‘Ee’ aa mu zumina no ‘Inga’ aa mu kana. I cintu conse ici mu nungako, nku muntu u mubi ci zwa.<verse eid="MAT 5:37" /></para>
  <para style="s">Uku sa bogoza u bubi ko bubi</para>
  <para style="r">(<ref loc="LUK 6:29-30">Luk 6:29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />“Na mwa shugwa buti se ku tegwa buti uju a ku shugwisa uku shisha, negwe u mu shugwise uku shisha, ‘I linsho ko linsho’ no ‘lino ko lino.’<note caller="+" style="x"><char style="xo" closed="false">5:38 </char><char style="xt" closed="false"><ref loc="EXO 21:24">Lujendo 21:24</ref>; <ref loc="LEV 24:20">Livitike 24:20</ref>; <ref loc="DEU 19:21">Mulao 19:21</ref>.</char></note> <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Kono nda sa mi ta buti, mu leke uku kababuwanga ku bantu a bamangoju. U muntu aa ku kaba kwitama lyo mulyo, u mu zolele no limwinya kame. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Aa u kugilwa ku nkuta mi se ba la ku tapa i cijabalo cako, u ba we no cizwato cako cimwinya. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Ati u muntu na ku indikiza buti u mu sindikize kanunu u mu sindikize ku mu itiliza ao a la ku teli. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Mu we kwa ba ba mi kumbila, mi mu leke uku kanina aba ba shaka uku mi kolotela.<verse eid="MAT 5:42" /></para>
  <para style="s">Jesu aa ziga byo ku shaka aba ba tu zimbite</para>
  <para style="r">(<ref loc="LUK 6:27-28">Luk 6:27-28</ref>,<ref loc="LUK 6:32-36">32-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />“Na mwa shugwa u mulao gu ta buti, ‘Mu shake a bantu mu bambene nabo’<note caller="+" style="x"><char style="xo" closed="false">5:43 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Livitike 19:18</ref>.</char></note> mi mu zimbe aba ba mi zimbite. <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Kono ime mbuti ndi co buti, mu shake a bantu aba ba mi zimbite!<note caller="+" style="f"><char style="fr" closed="false">5:44 </char><char style="ft" closed="false">A mabuka gamwinya kame ga nungako buti, “Mu we imfwijaguzi ku bantu aba ba mi kuntwila. Mu tende nenja a bantu aba ba mi zimbite”. Mu kozanise no bu ku ñolelwe mwa Luka 6:27-28.</char></note> Mu lapelele a bantu aba ba mi pengisa. <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />Ko ku tenda bulyao, kuti na mu koze Isenu gwa kwigulu. Kakuli ige ga sa ñatulisiza ijuba lyakwe ku bantu bonse a babi no bantu-awa, mi ga sa tumina umvula gwakwe ku bantu aba ba lulikile no bantu aba ta ba lulikile. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Aa mu shaka bulyo a bantu aba ba mi shaka, mupuzo gwa buti na mu gwane a ku tenda bulyao? Ntali no batentesi mbobo ba tendela. <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Ati na mu tenda nenja no ku li zuminizanga no bagenzenu bulyo, mbuti mu andanina no bantu bonse? Kakuli no bantu ta ba zumine mbobo ba tendela. <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Kono mu li botele uku ba a bantu ba lulikile sinagwe ndi Senu Nyambe gwa kwigulu aa lulikile.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">Jesu aa ziga a bantu bo ku wela ku bampale</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />“Mu mamele buti i bitendantu byenu i bilotu bi leke ku tendelwa a kati ko bantu buti a bantu ba mi bone, kakuli aa mu tenda bulyao Isenu Nyambe gwa kwigulu ta na mi we u mupuzo.<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />“Aa mu wa ku bampale, mu leke ku tenda sinagwe mbantu bo mantu ubu ba tendelanga mu majugo go malapelelo go Majuda. Mba ku lituntanga no ku ja bu kugiliza mu mazila no mu bibaka byo malapelelo buti a bantu ba ba lumbe. Mbyaconse ndi mi lugwila buti se ba li gwanite u mupuzo gwabo. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Kono inwe aa mu wa ku bampale, iganja lyenu lyo monsho li leke ku ziba ibi li tenda iganja lyenu lyo mulyo. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Mu we mu buzinda, mi isenu uju awene i bintu byonse kuti na mi we u mupuzo.<verse eid="MAT 6:4" /></para>
  <para style="s">Jesu aa ziga bo ku lapelela</para>
  <para style="r">(<ref loc="LUK 11:2-4">Luk 11:2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />“Aa mu lapela, mu leke uku lapela sinagwe mbantu bo mantu aba ba shaka lwini uku lapelela mu mazila no mu majugo go malapelelo go Majuda buti a bantu ba ba bone. Mbyaconse ndi mi lugwila buti se ba li gwanite u mupuzo gwabo ugu gu ba botele. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Kono inwe aa mu lapela, mu ngine mu kampetu, mu gale i cigalo mi mu lapele kwe Senu uju ta bonwa. Mi Isenu uju a bona ibi bi tendegwa mu buzinda, kuti na mi we u mupuzo. <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />Aa mu lapela, mu zwe kwigaba-gaba sinagwe mbantu ta ba zumine, aba ba gaja buti i bintu ba kumbila bya sa tabigwa aa ba gamba a majwi a mangi. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Mu leke uku lapelenga bulyao, kakuli isenu a li zekelele ibi mu shaka nanga na mu sini uku bi mu kumbila.<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />“Inwe mu lapele buti,</para>
  <para style="b" vid="MAT 6:9" />
  <para style="q1" vid="MAT 6:9">‘Tata gwetu gwa kwigulu, izina lyako li be lyo kucena,<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />u mubuso gwako gu keze,</para>
  <para style="q2" vid="MAT 6:10">u tende ansi ubu u shakila sinagwe ubu ku kalile kwigulu.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />U tu we shunu i bilyo byetu bya mwijuba-mwijuba.<verse eid="MAT 6:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="MAT 6:12" />U tu kwatile i bitendantu i bimangoju byetu,</para>
  <para style="q1" vid="MAT 6:12">sinagwe ubu na twa kwatila aba na ba tu fosekeza.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />U leke uku tu twala mu mujeleko,</para>
  <para style="q2" vid="MAT 6:13">kono u tu lamwine ku mubi.’<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">A mabuka gamwinya go kale go Cigelike ga sa nungako buti, “Kakuli u mubuso ngwako, no nguzu no mpazimo ku twala koko. Ameni.”</char></note><verse eid="MAT 6:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />“Ati na mu kwatila a bantu aba ba mi fosekeza, Isenu Nyambe gwa kwigulu kuti na mi kwatile. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Kono ati na mu kana uku kwatila bamwinya, Isenu Nyambe ta na mi kwatile nenwe i bitendantu i bimangoju byenu.<verse eid="MAT 6:15" /></para>
  <para style="s">Jesu aa ziga byo ku li nyima i bilyo</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />“Mi aa mu li nyima i bilyo, mu leke uku tenda sinagwe mbantu bo mantu aba ba li bonisa uku tompa buti a bantu ba zibe buti mbilyo ba li nyimite. Mbyaconse ndi mi lugwila buti, na ba gwana u mupuzo gwabo ugu ka ba botele uku gwana. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Kono inwe aa mu li nyima i bilyo, mu li singe a mafuta ku mutwi no ku shamba ku mensho, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />mi ko ku tenda bulyao, takuli uju sa ka nangule buti mbilyo mu li nyimite, mbwita Isenu Nyambe bulyo genke uju a zekelele ibi mu tenda mu buzinda. Mi ige uju a wene i bintu byonse kuti na mi we u mupuzo.<verse eid="MAT 6:18" /></para>
  <para style="s">Jesu aa ziga byo masheleñi</para>
  <para style="r">(<ref loc="LUK 12:33-34">Luk 12:33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />“Mu leke uku li bundikila u lubono aano ansi aa lu gola uku ligwa ku bampelenzi no ku jonigwa ku mafume, mane no basa aba ba gola uku tulula u mu lu li no ku lu iba. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Kono mu li bundikile u lubono kwigulu uku ta lu goli uku jonaguligwa ku ba bampelenzi no mafume mane no ku ibigwa ku basa kakuli ta ba goli uku tululako. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Kakuli uku ku li u lubono lwako no mojo gwako nkoko sa ka gu be nago.<verse eid="MAT 6:21" /></para>
  <para style="s">Ituba lyo mubili</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />“A mensho nde tuba lyo mubili. Ati a mensho gako ga la bona nenja, u mubili gwako gonse kuti gu be mwituba. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Kono ati a mensho gako ta ga boni nenja, u mubili gwako gonse kuti gu be mu kansindwe. Ati ituba u gaja buti ndelyo li li kwako kanti nkansindwe, kako a kansindwe ka li botele uku siya lwini!<verse eid="MAT 6:23" /></para>
  <para style="s">Byo ku sebeleza a bamfumu bo bile</para>
  <para style="r">(<ref loc="LUK 16:13">Luk 16:13</ref>; <ref loc="LUK 12:22-31">12:22-31</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />“Takuli u muntu uju a gola uku sebeleza a bamfumu bo bile, kakuli kuti a shake genke no ku zimba jumwinya. Kampa kuti a kutike genke no ku shwauza jumwinya. Ta mu goli uku sebeleza Nyambe no masheleñi.<verse eid="MAT 6:24" /></para>
  <para style="s">Jesu aa ziga byo nkengejezi</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />“Cwale nda sa mi lugwila, mu leke ku tongaukanga kebaka lyo bumi bwenu ibi na mu lye kampa byo mibili jenu, ibi na mu zwate. Kakuli u bumi bu la ita i bilyo, no mubili gu la ita i bizwato. <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Mu gaje no bijuni buti ta bi byali kampa uku zimbula mane ta bi tuli u lukau mu mayongo, kakuli Isenu gwa kwigulu ndege a bi lela. Ta mwi zi buti inwe mu li ba butokwa ku ita i bijuni? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Ndini kwenu uju a gola uku nunga inako jonke ku bumi bwakwe ko ku tongauka?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />“Ncinzi aa mu tongaukanga kebaka lyo bizwato? Nga mu lole a mapalisa ga mu lugole ubu ga kulila, ta ga sebezi no ku suma. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Kono nanga ndi Solomoni mu bumfumu bwakwe, ta ga la zwata nenja sinagwe ndimwinya lya gaga a mapalisa. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Cwale ati Nyambe na babalela nenja u bwiju bwa mu lugole ubu bu bonaala bulyo shunu, kono ijona se bu la shonjelwa mu mulilo, buti ta na mi babalele lwini no ku ita inwe bo nzumino inunu?<verse eid="MAT 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31" />“Mu leke ku tongaukanga na mu ta buti, ‘Mbinzi na tu lye?’ kampa ‘Mbinzi na tu nywe? Mbinzi na tu zwate?’ <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Kakuli byebyo mbantu ta ba zumine ba bi zunda, mi Isenu gwa kwigulu a li zekelele ibi mu zunda. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Kono mu shake u mubuso gwa Nyambe tanzila no ku lulikila kwakwe mi kuti na mi we i bintu byonse ibi mu zunda. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Mu leke uku tongaukanga kebaka lya byejona, kakuli ijona kuti na li li tongaukile byalyo. Ijuba ne juba li li kwesi a makababu galyo.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Jesu aa ziga byo ku sa atula bamwinya</para>
  <para style="r">(<ref loc="LUK 6:37-38">Luk 6:37-38</ref>,<ref loc="LUK 6:41-42">41-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />“Mu leke uku atulanga bamwinya buti nenwe na mu leke uku atuligwa. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Kakuli ubu mu atwila bamwinya, nenwe mbobo na mu atwilwe mi ubu mu tendela bamwinya nenwe mbobo na mu tendelwe.<verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />“Ncinzi aa u lolelele a kasasa aka ka la ngini mu linsho lya mugenzo no ku zwisa ingana kwiala li li mu linsho lyako? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Mbuti u gola uku ta mugenzo buti, ‘Keza ndi ku togole a keju mu linsho lyako,’ mwa lyako i linsho na ku li iala? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Igwe go mantu, u zwise tanzi iala mu linsho lyako nko kuti u gole uku bona nenja mi kuti u gole uku togola a keju mu linsho lya mugenzo.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />“Mu leke uku wa a bambwa i bintu byo kucena. Mu leke uku wa a banjili i bintu i bilotu kakuli ka ba mana ku bi lyatagula bulyo no ku mi zokela ku mi kakagula.<verse eid="MAT 7:6" /></para>
  <para style="s">Jesu aa ziga byo ku zundamina</para>
  <para style="r">(<ref loc="LUK 11:9-13">Luk 11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />“Mu zundamine uku kumbila mi kuti na mu tambule ici mu kumbila. Mu zundamine uku shaka, mi kuti na mu gwane. Mu zundamine uku kokota, mi kuti na mu galwilwe. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Kakuli u muntu gense uju a kumbila ga sa tambula, uju a shaka ga sa gwana, mi no ku muntu uju a kokota, i cigalo kuti na ci galulwe.<verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />“Kwenu mwe bazazi buti nkwali uju a gola uku wa mwane ibwe uku na la mu kumbili u buobe? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Kampa ati na la kumbili unswi, buti mu la gola uku mu wa ijoka? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Mbali inwe bo ntalu mu zekelele uku wa i bintu i bilotu ku banenu, Isenu Nyambe gwa kwigulu kuti na mi ite lwini mu ku wa a mampo a malotu kwa ba ba mu kumbila.<verse eid="MAT 7:11" /></para>
  <para style="s">Byo mulao u munene</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />“Mu tendele bamwinya ubu mu shakila buti nenwe ba mi tendele. Kakuli mbobo gu co u mulao gwa Mushe no baboni ba Nyambe.<verse eid="MAT 7:12" /></para>
  <para style="s">Byo mazila go bile inene nenunu</para>
  <para style="r">(<ref loc="LUK 13:24">Luk 13:24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />“Mu ngine mu mubuso gwa Nyambe ko ku nginina mu cizi i cinunu. Kakuli inzila ji ja ku njoneko ninene, mi mbantu a bangi ba jendamo. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />I cizi ici ci ja ku bumi nci nunu mane no nzila ji tungulwizeko ni nunu kame ni nkababu, mi mbantu a bace ba jendamo.<verse eid="MAT 7:14" /></para>
  <para style="s">Byo baboni bo manya</para>
  <para style="r">(<ref loc="LUK 6:43-44">Luk 6:43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />“Mu nangule a baboni bo manya aba ba bonaala sinagwe ningu kanti mba ku koza a bantugu mukati. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Kuti na mu ba zibe ko biyango byabo. Ta mu goli uku yanga incinga ku lwege kampa u mulya-nshwi ku lusu. <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />I cishamu i cilotu mbiyango i bilotu ci la ku aka, mi i cishamu i cimangoju mbiyango i bimangoju ci la kuakanga. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />I cishamu i cilotu ta ci goli uku aka i biyango i bimangoju, mi i cishamu i cimangoju ta ci goli uku aka i biyango i bilotu. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Cwale i cishamu conse ici ta ci aki i biyango i bilotu ca sa temigwa no ku shonjigwa mu mulilo. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Bulyao mu gola uku zibila i cishamu ko biyango byaco, mbobo mu gola uku zibila a bantu no bitendantu byabo.<verse eid="MAT 7:20" /></para>
  <para style="s">Byo ku shugwa no ku tenda</para>
  <para style="r">(<ref loc="LUK 13:25-27">Luk 13:25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />“Ntali muntu gense uju a ndi ta buti, ‘Mfumu! Mfumu!’ uju na ngine mu mubuso gwa kwigulu. Kono kuti na ku ngine bulyo uju a tenda ubu a shakila Tata gwa kwigulu. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Mwijuba lyo nkatulo, a bantu a bangi kuti na ba ndi te buti, ‘Mfumu, Mfumu, ka tu gambanga ko buboni mwizina lyako no ku tanda a mayauma mwizina lyako mane no ku tenda a mamakazo a mangi mwizina lyako.’ <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Kono ime kuti na ndi ba tabe buti, ‘Ta na nda mi ziba, mu zwe kwangu inwe mu shwaaguzanga u mulao gwa Nyambe.’<verse eid="MAT 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />“U muntu gense uju a shugwa a majwi gangu no ku tenda ubu ga co, nda sa mu kozanisa no muntu go magano uju a jakila injugo jakwe aa ku gongwele. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Umvula nanga na shoka ku tenda i mikukile nanga na ku ba no bulobe, no ku unga lwini ko nkuli ku kaba jejo injugo, ta ji zeguki kakuli aa ji jakilwe ku li gongwele. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Kono u muntu gense uju a shugwa a majwi gangu kono ta tendi ubu ga co, kuti ndi mu kozanise no muntu u mugelo uju a jakila injugo jakwe e bwetete. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Umvula aa shoka mi u bulobe se bu la bako mi inkuli aa ji unga ku kaba jejo injugo, se ji la zeguka mi uku gwa kwajo se ku la leta injoneko inene.”<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Jesu aa sa la mani uku gamba byebyo i bintu, a bantu a bangi kale ba komokwa lwini ku bintu ka ziga. <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />Kakuli kame ka ba ziga ko nguzu ku ita a bazigi babo bo mulao.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Jesu aa oza unkosi ka lwala i cisenda</para>
  <para style="r">(<ref loc="MRK 1:40-45">Male 1:40-45</ref>; <ref loc="LUK 5:12-16">Luk 5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />A bantu a bangi kale ba umpilila Jesu aa ka sezumuka ku zwa elundu. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Aobulyo kale kwa keza unkosi uju ka lwala i cisenda no keza ku tongama afuwi no Jesu mi kale ga ta nage, “Mfumwangu, ati u la shaka u ndi oze.” <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />Jesu kale ga golola iganja no ka mu kwata mi kale ga ta nage, “Ndi la shaka, u lwaluke!” Aobulyo i cisenda cakwe kale ca mana. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Jesu kale ga mu ta nage, “U leke ka gambaguza a bantu kono u je bulyo ku mupulisiti aka ku tatube mi u itule no citagilo ku ja ko bu gu tela u mulao gwa Mushe kwa ba ba ozwa ku bulwele bo cisenda. Ko ku tenda bulyao, a bantu kuti na ba be no bupaki buti na gwa ozwa no ku cenisigwa.”<verse eid="MAT 8:4" /></para>
  <para style="s">Byo nzumino jo nkosi gwa mwa Kapenauma</para>
  <para style="r">(<ref loc="LUK 7:1-10">Luk 7:1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Jesu aa sa la bogoli ku munzi gwa Kapenauma, u mujendesi go masole go Muloma kale ga keza kwakwe, ku kumbila intuso nage, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />“Mfumwangu, u muika gwangu mpa bulo a kwashamite bu golomene mi a li shugwile lwini uku shisha.”<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Jesu kale ga ta nage, “Ndi la keza ndi mu oze.”<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Kono u mujendesi go masole kale ga ta Jesu nage, “Mfumwangu, ta ndi botele buti igwe u ngine mu njugo jangu. U gambe bulyo ijwi mi u muika gwangu kuti a lwaluke. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Ndi li zekelele buti nko ba li a bajendesi a bakulu kwangu ku nguzu jo bujendesi kono neme nko ba li a masole aba ndi jendesa. Ndi la gola uku ta jumwinya kwa babo buti, ‘U jende,’ mi sa la ka ja, kampa ku mu ta buti, ‘U keze,’ sa la keza. Kampa uku ta u muika gwangu buti, ‘U tende ci,’ sa la ci tenda.”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Jesu aa shugwa bulyao, kale ga komokwa lwini. Kale ga sigulukila ku bantu aba ka ba mu umpilile no ku ba ta nage, “Mbyaconse ndi mi lugwila buti, ka ndi sini uku bona u muntu go nzumino inene lwini bulyao mwilonga lya Isilaele. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Kame nda sa mi lugwila buti u bungi bo bantu aba ta ba li a Majuda kuti na ba ka zwe mu malonga ga andene-andene ga ku buzwe-juba no ga ku bugwe-juba no keza ku lya u mukiti no Abbulaama no Isaka no Jakobo mu mubuso gwegulu. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Kono u bungi bo bantu ba Isilaele aba na ba lukisezwa u mubuso gwa kwigulu, kuti na ba ka shonjelwe kunze mu kansindwe u mu na ku ka be a malilo no ku kweka a meno.”<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Cwale Jesu kale ga ta jojo u mujendesi go masole nage, “U bogole ku njugo mi kakuli u la zumini ku la tendaali ubu shakila.” Mi u muika kale ga lwaluka mwa jejo inako.<verse eid="MAT 8:13" /></para>
  <para style="s">Jesu aa oza mukwe gwa Pitolosi go mwanakazi</para>
  <para style="r">(<ref loc="MRK 1:29-34">Male 1:29-34</ref>; <ref loc="LUK 4:38-41">Luk 4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Jesu aa sa la siki ku njugo ja Pitolosi, kale ga bona mukwe gwa Pitolosi go mwanakazi na lele a bulo na lwala ielenge. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Jesu kale ga mu kwata kwiganja, mi ielenge kale lya zwa kwakwe mi kale ga buka no ku mu tendela byo ku lya.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Gago a matengu a bantu aba ka ba munitwe ku mayauma, kale ba ba leta kwa Jesu mi kale ga tanda i myoya i mibi ko ku gamba bulyo, no ku oza bonse aba ka ba lwala. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Gogu u mutendelo ka gu li go ku vumbiliza ijwi lyo muboni gwa Nyambe Isaya aa sa ta buti,</para>
  <para style="b" vid="MAT 8:17" />
  <para style="q1" vid="MAT 8:17">“Sa inda a malwalila getu</para>
  <para style="q2" vid="MAT 8:17">no ku oza a malwele getu.”<note caller="+" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="ISA 53:4">Isaya 53:4</ref>.</char></note><verse eid="MAT 8:17" /></para>
  <para style="s">Byo ku umpilila Jesu</para>
  <para style="r">(<ref loc="LUK 9:57-62">Luk 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Jesu aa bona buti a bantu a bangi se ba li mu bunganine, kale ga ta a bazigigwa bakwe buti ba shatukile mwisilya lyeziba. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Mi jumwinya go bazigi bo mulao kale ga ta Jesu nage, “Muzigi, kuti ndi ku umpilile konse uku so ko je.”<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Kono Jesu kale ga mu taba nage, “A basibwe ba li kwesi a malambo, no bijuni bi li kwesi i bijakilo, kono ime nde Mwana Muntu<note caller="+" style="f"><char style="fr" closed="false">8:20 </char><char style="ft" closed="false">“Mwana Muntu” ncitulo ici ka litusisanga Jesu mu ku li kuganga gemwini.</char></note> ta ndi kwesi i cibaka o ku lalika u mutwi gwangu.”<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Jumwinya u muzigigwa kale ga ta nage, “Mfumwangu u ndi leke tanzila ndi bogole ndi ka zike tata.”<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Kono Jesu kale ga mu ta nage, “U ndi umpilile, mi u leke aba ba fwite ba zike a bafu babo.”<verse eid="MAT 8:22" /></para>
  <para style="s">Jesu aa ombeleza inkuli</para>
  <para style="r">(<ref loc="MRK 4:35-41">Male 4:35-41</ref>; <ref loc="LUK 8:22-25">Luk 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Jesu kale ga ngina mu bwato mi u bazigigwa bakwe kale ba mu umpilila. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Aobulyo inkuli kale ja fukuka ku ukusa iziba buti a makupezi se ka ga ja bu ngina mu bwato. Kono Jesu kame ka lele. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />A bazigigwa bakwe kale ba mu jila no ka mu busa na ba kumbagana nabo, “Mfumwetu, u tu jojese! Mane tu lobele!”<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Jesu kale ga taba nage, “Inwe bo nzumino inunu, ncinzi aa mu jogete bulyao?” Kale ga zimana no ku jukukila inkuli no makupezi mi kale kwa ombelela lwini.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />A bazigigwa kale ba komokwa lwini mi kale ba buza nabo, “Nu nkosi gwa buti joju buti inkuli no makupezi bi mu kutike?”<verse eid="MAT 8:27" /></para>
  <para style="s">A mayauma aa ga ngina mu banjili</para>
  <para style="r">(<ref loc="MRK 5:1-20">Male 5:1-20</ref>; <ref loc="LUK 8:26-39">Luk 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Jesu aa sa la ka siki mwisilya lyeziba lya Galileya mwilonga lyo Magadala, a bankosi bo bile aba ka ba munitwe ku mayauma kale ba li shangana nage. Mpa mabita ka ba zwa mi ka ba shanshuwite lwini buti mane takuli u muntu uju ka gola uku itila koko ku cibaka. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Kale ba tatika uku mu kumbaganina nabo, “Ncinzi u shaka kwetu igwe gwe Mwana Nyambe? Kame u la kezi ku tu bangisa inako na ji sini ku sika?”<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Nko ka gu li u mugona go banjili ugu ka gu yangila u kule kanunu no ao. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />A mayauma kale ga kumbila Jesu nago, “Ati gwa sa tu tanda u tu tandile mu mugona go banjili.”<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Kale ga ga ta nage, “Mu jende!” A mayauma kale ga zwa kwa babo a bankosi bo bile, no ka ngina mu mugona go banjili. Mi u mugona gonse kale gwa landumukila ku nsezumusi je nkonkomwa lyeziba no ka shotaukila mu menzi no ka fwilamo. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />A bankosi aba ka ba lisa a banjili kale ba tigila ku minzi ja afuwi, na ba ja bu gambaguza a bantu i bintu byonse ibi na bya tendaala ku bankosi ka ba munitwe ku mayauma. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />A bantu bonse ba mu munzi kale ba keza kwa Jesu, mi kale ba mu kumbila lwini buti a zwe mwilonga lyabo no ku ba leka bonke.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">Jesu aa oza unkosi uju ka golomene u mubili</para>
  <para style="r">(<ref loc="MRK 2:1-12">Male 2:1-12</ref>; <ref loc="LUK 5:17-26">Luk 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Jesu kale ga ngina mu bwato no ku shatuka iziba ku bogola ku munzi gwakwe. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />A bantu bamwinya kale ba mu letela unkosi uju ka golomene u mubili na ba mu indile a bulo. Jesu aa bona inzumino jabo, kale ga ta jojo unkosi ka golomene u mubili nage, “U gongole mwanangu, i bitendantu i bimangoju byako bi la kwatilwa!”<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Kono a bazigi bamwinya bo mulao kale ba li gambaguza mwalyabo nabo, “Kaka se nkashwau, mbuti a gajila buti nde Nyambe?”<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Ko ku ziba ibi ka ba gaja, Jesu kale ga ta nage, “Ncinzi aa mu gaja i bigajantu i bimangoju mu myojo jenu? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />I cintu i citole ncibo, no ku ta buti, ‘I bitendantu i bimangoju byako bi la kwatilwa’ no ku ta buti, ‘Zimana u jende?’ <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Cwale kuti ndi mi sunde buti nde Mwana Muntu ndi li kwesi inguzu ansi jo ku kwatila i bitendantu i bimangoju.” Jesu kale ga sigulukila kwa jojo unkosi ka golomene u mubili no ku mu ta nage, “Zimana, u inde u bulo bwako u jende kwilapa lyako.” <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Mi jojo unkosi kale ga zimana na ka li jila kwilapa lyakwe. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />U bungi bo bantu kale ba komokwa lwini aa ba bona ici ci la tendaali, mi kale ba lumba Nyambe uju sa wa inguzu ja bulyao ku bantu.<verse eid="MAT 9:8" /></para>
  <para style="s">Jesu aa kuga Mateu</para>
  <para style="r">(<ref loc="MRK 2:13-17">Male 2:13-17</ref>; <ref loc="LUK 5:27-32">Luk 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Jesu aa zwa momo, kale ga bona unkosi gwezina lya Mateu na kele a njugo jo mutenteko. Jesu kale ga mu ta nage, “U ndi umpilile,” mi Mateu kale ga zimana no ku umpilila Jesu.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Ku zwao, Mateu kale ga kugila Jesu no bazigigwa bakwe ku njugo jakwe buti ba ka lye i bilyo. Kale ga kuga no batentesi a bangi no batendi bo bimangoju bamwinya. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Kono a Bafalisi aa ba bona bulyao kale ba buza a bazigigwa ba Jesu nabo, “Ncinzi u muzigi gwenu aa lya no batentesi mane no batendi bo bimangoju?”<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Jesu aa sa la shugwi bulyao, kale ga ta nage, “A bantu ta ba lwali ta ba zundangi u muangi, kono mbalwele ba zundanga u muangi. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Kono mu ka je no ka li ziga ubu gu co gogu u mugambilo gu ta buti, ‘Ninse ndi shaka ta li mbitagilo.’<note caller="+" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="HOS 6:6">Oseya 6:6</ref>.</char></note> Ta na nda keza ku kuga aba ba lulikile, kono mbantu bo bitendantu i bimangoju.”<verse eid="MAT 9:13" /></para>
  <para style="s">Byo ku li nyima i bilyo</para>
  <para style="r">(<ref loc="MRK 2:18-22">Male 2:18-22</ref>; <ref loc="LUK 5:33-39">Luk 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Ijuba limwinya, a bazigigwa ba Joani kale ba keza kwa Jesu mi kale ba mu buza nabo, “Ncinzi a bazigigwa bako aa ta ba li nyimangi i bilyo sinagwe ndiswe no Bafalisi?”<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Jesu kale ga ba taba nage, “Buti a basele bo musesi ba la gola uku tompa uku na ba si kele no musesi? Kono inako ji la keza u musesi aa na zwisigwe kwabo mi nko kuti na ba linyime i bilyo.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />“Ndini a gola uku inda i cikamba i ciya no ku ci tula a cizwato co kale? Kakuli i cizwato co kale kuti ci mwankukile umu mu la ci sumini ku jonagula i cizwato. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Kame takuli u muntu a botele uku inda waine u muya no ku mu tula mu kaumbu ko kale. Kakuli waine sa ka fufuluke, a kaumbu ka mane ku ñatuka, ige waine a jwije ku leka a kaumbu ka fwite. Kono waine u muya mu kaumbu a kaya ba la ku mu tulanga buti waine no kaumbu bi kale nenja.”<verse eid="MAT 9:17" /></para>
  <para style="s">Byo mukazana na ga fwa no mwanakazi ka lwala</para>
  <para style="r">(<ref loc="MRK 5:21-43">Male 5:21-43</ref>; <ref loc="LUK 8:40-56">Luk 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Jesu aa ka si kwesi uku gamba byebyo, u mujendesi go njugo jo malapelelo jo Majuda kale ga keza ku tongama afuwi no Jesu no ku mu ta nage, “Mwanangu go mukazana ndi nawangu a zwa uku fwa. Nanganceciba bulyao u keze kakuli u la gola uku mu jojesa ko ku mu tula iganja lyako.” <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Mi Jesu no bazigigwa bakwe kale ba ka ja no jojo unkosi.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Aa ka ba kwesi uku jenda bulyao, u mwanakazi uju sa penga lwini mu myaka je kumi no jo bile na lwala u bulwele bwelowa kale ga keza mwishule lya Jesu no ku kwata ku mungundo go mukanjo gwa Jesu, <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />kakuli kame ka gaja buti, “Ati na ndi kwata bulyo ku mukanjo gwakwe kuti ndi lwaluke.”<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Jesu kale ga litemuna mi kale ga mu bona no ku mu ta nage, “U gongole mwanangu! Inzumino jako ji la ku ozi.” Aobulyo jojo u mwanakazi kale ga lwaluka.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Jesu aa ka ngina mu njugo jo mujendesi go njugo jo malapelelo jo Majuda kale ga bona a bantu aba ka ba tenda ijaba no ku zimba inimbo jo mafu. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Jesu kale ga ta a bantu nage, “Mu zwile anze, u mwanuke ta fwite mbulyo a lele!” Kono a bantu kale ba mu nyungulula. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />A bantu aa se ba la zwili anze, Jesu kale ga jila jojo u mukazana no ku mu kwata kwiganja mi kale ga zimana. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />A bantu kale ba shugwa bya jejo i makazo momo mwilonga lyonse.<verse eid="MAT 9:26" /></para>
  <para style="s">Jesu aa oza a baofu no muntu uju ta ka gamba</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Jesu aa sa zwamo, a bankosi bo bile bo baofu kale ba mu umpilila, na ba kugiliza nabo, “Mwana Deviti, u tu fwile inse!”<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Kale ba ja mu njugo u mu ka li Jesu, mi ige kale ga ba buza nage, “Mu la zumina buti ndi la gola uku oza a mensho genu buti mu bone?” Kale ba mu taba nabo, “Ee Mfumwetu, tu la zumina.”<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Jesu kale ga kwata a mensho gabo no ku ba ta nage, “Ku ja ko nzumino jenu, ku tendaale kwenu bulyao.” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Mi a mensho gabo kale ga ozwa mi kale ba tatika uku bona. Kono Jesu kale ga ba nanguza ko ku ba ta buti, “Na mu leke u ka gambaguza u muntu gense.” <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Kono abo kale ba ja bu gambaguza a bantu bonse bya Jesu momo mwilonga lyonse.<verse eid="MAT 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Aa se ba la zwi ao, unkosi uju ka munitwe kwiyauma mi ta ka gamba, kale ba mu leta kwa Jesu. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Mi Jesu kale ga tanda lelyo iyauma, mi jojo unkosi kale ga tatika uku gamba. A bantu a bangi kale ba komokwa lwini nabo, “Ka tu sini uku bona i cintu ca bulyao ci tendaala mwilonga lya Isilaele.”<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Kono a Bafalisi kale ba ta nabo, “Ni nguzu jo mfumu go mayauma a litusisa mpaa gola uku tanda a mayauma.”<verse eid="MAT 9:34" /></para>
  <para style="s">Ilonga ndigwa lya Nyambe</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Jesu kale ga ja bu ita mu minzi i minene no minunu ja lelyo ilonga, na ja bu ziga a bantu mu majugo go malapelelo go Majuda no ku zibisa a majwi a malotu go mubuso mi ka oza no malwele gonse aga ga andene-andene. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Jesu aa bona a bantu a bangi, kale ga ba fwila inse kakuli ka ba bonaala uku sa ziba cimwinya no ku zielea sinagwe ningu ta ji kwesi u mulisani. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Jesu kale ga ta a bazigigwa bakwe nage, “U muzimbu mungi, kono a babeleki mbace. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Cwale mu kumbile ku Mfumu Nyambe kakuli nde mwini igwa buti a tume a babeleki a bangi mwigwa lyakwe buti ba keze ba zimbule.”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">Jesu aa tuma a bazigigwa be kumi no bo bile</para>
  <para style="r">(<ref loc="MRK 3:13-19">Male 3:13-19</ref>; <ref loc="LUK 6:12-16">Luk 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Jesu kale ga kuga a bazigigwa bakwe bonse be kumi no bo bile no ku ba wa inguzu jo ku tanda i myoya i mibi, no ku oza a malwele gonse ga andene-andene. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />A mazina go batumigwa be kumi no bo bile nga gaga,</para>
  <para style="b" vid="MAT 10:2" />
  <para style="q1" vid="MAT 10:2">mba Simoni (uju ka kugigwa Pitolosi),</para>
  <para style="q2" vid="MAT 10:2">no Andileya (mwancegwe gwa Pitolosi),</para>
  <para style="q1" vid="MAT 10:2">no Jakobo (mwana Zebedeya),</para>
  <para style="q2" vid="MAT 10:2">no Joani (mwancegwe gwa Jakobo),<verse eid="MAT 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 10:3" />Filipi no Bbatolome, Tomasi no Mateu (u mutentesi),</para>
  <para style="q1" vid="MAT 10:3">Jakobo (mwana Alufeyasi),</para>
  <para style="q2" vid="MAT 10:3">no Tediyusi,<verse eid="MAT 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 10:4" />Simoni (uju ka kugigwa Ziloti)</para>
  <para style="q2" vid="MAT 10:4">no Judasi Isikaliota (uju na ga legeza Jesu).<verse eid="MAT 10:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Jesu kale ga tuma be kumi no bo bile no ku ba lugwila nage, “Mu leke uku ja ku bantu aba ta ba li a Majuda kampa a Masamaliya. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Kono mu je bulyo ku bantu ba Isilaele aba ba kozete ingu ji jobete. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Mu je bu ba tandaza buti, ‘U mubuso gwa kwigulu se gu li li afuwi.’ <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Mu je bu oza a balwele no ku busa a bafu mane no ku oza aba ba lwala i cisenda. Mu je bu tanda no mayauma aga ga tembeka a bantu. Mu je bu tusa a bantu bulyo mu leke ku zunda uku lifigwa. Kakuli mbulyo na mwa wegwa inguzu, mi ta na mwa ji lifela, mu ji we bulyo ku bantu mi mu leke ku ba lifisa.<verse eid="MAT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 10:9" />“Mu leke uku inda a masheleñi, gauda, kampa a masheleñi go buwaya-waya. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />Mu leke uku inda nanga mukotana go myabi, i cizwato cimwinya, inshangu kampa u lutaga. Mi mu leke ku li kalililwa kakuli a bantu kuti na ba je bu mi tambula. Kakuli a bantu ba sebeza ba li botele uku wegwa co ku lya.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />“Aa mu ngina mu munzi u munene kampa u mununu, mu shake u muntu go ngana mi mu kale a mubanda gwakwe ku twala aa na mu zwemo. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Aa mi tambula, mu mu we imfwijaguzi ige no luasi lwakwe. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Ati lolo u luasi lu li botele jejo imfwijaguzi, imfwijaguzi jenu kuti ba ji gwane. Kono ati takuli, imfwijaguzi jenu kuti ji mi bogwele. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />U muntu gense uju ta na mi tambule no ku tegeleza ku majwi genu, sa ka na mu zwe a mubanda gwakwe kampa momo mu munzi, na mu kunkumune isukwe ku matende genu. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Mbyaconse ndi mi lugwila buti, uku bangisigwa kwa gogo u munzi kuti na ku be u kunene lwini ku ita ko minzi ja Sodoma no Gomola mwijuba lyo nkatulo.<verse eid="MAT 10:15" /></para>
  <para style="s">A mapenzi go bazumini</para>
  <para style="r">(<ref loc="MRK 13:9-13">Male 13:9-13</ref>; <ref loc="LUK 21:12-17">Luk 21:12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />“Nga mu lole, nda sa mi tuma sinagwe ningu mukati ko bambogela, kebaka lelyo mu talife sinagwe majoka mi mu bule u mulandu sinagwe mbanziba. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Kono mu zibe buti kuti na mu twaligwange ku makuta no ku shapigwa no ndupwa mu majugo go malapelelo go Majuda. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />A babusisi no bamfumu kuti na ba mi zekise kakuli mu li baumpilili bangu. Kono jejo ne nako na ji be jenu jo ku gambaguza a bajendesi no bantu aba ta ba zumine byangu. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Aa mu shuminigwa, mu leke uku li kalililwa bo ka tabila kampa bo ka gambila. Kakuli Nyambe kuti na mi we a majwi go ku gamba mu nako ji botete. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Kakuli ta li ndinwe sa ka mu gambange kono Moya gwe Senu sa ka gu mi tusange mu ku gamba.<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />“Mwanca-muntu, kuti na legeze mukulwe go nkosi buti a yagigwe, mi isi gwa muntu, kuti na legeze mwane go muninzana. Mi a bana kuti na ba zokele no ku lwisa a bazazi babo no ku ba yagisa. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />A bantu bonse kuti na ba mi zimbe kebaka lyangu. Kono u muntu gense uju na zundamine ku twala ku mamaninino, kuti na jojeswe. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Aa mu pengisigwa mu munzi gumwinya, mu tigile mu munzi gumwinya. Mbyaconse ndi mi lugwila buti ime nde Mwana Muntu kuti na ndi ka bogole na mu sini uku mana u musebezi mu minzi jonse jelonga lya Isilaele.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />“U muzigigwa ta iti u muzigi gwakwe, no muika ta iti mfumwe. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Kono u muzigigwa a li botele uku ba sinagwe muzigi gwakwe mi no muika a li botele uku ba sinagwe ni mfumwe. Ati u muzazi na kugigwa buti ndi Bbeluzebule<note caller="+" style="f"><char style="fr" closed="false">10:25 </char><char style="ft" closed="false">A bañoli bo mabuka gamwinya kame na ba ñola Bbeluzebule kakuli nde zina limwinya lya Satani u mfumu go myoya i mibi jonse.</char></note>, u luasi lwakwe kuti lu kwagigwe ko mazina a mabi lwini.<verse eid="MAT 10:25" /></para>
  <para style="s">Uju a botele uku jogigwa ndi Nyambe</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />“Cwale mu leke uku ba joga. Takuli ici ci zinditwe ici ta na ci zibigwe, kampa ici ci bikamite ici ta na ci bikululwe. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Ibi ndi mi lugwila mu masiku, na mu bi gambe a kamwi. Ici ndi mi shobotela mu matwi genu, na mu ci lugule ko ku gongoza buti a bantu bonse ba ci shugwe. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Mu leke uku joga aba ba gola uku yaga u mubili kono ta ba goli uku yaga u muuja. Kono mu joge uju a gola uku yaga u mubili mane no muuja bulyao mwileba lyo mulilo. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />U tulumbu to bile nanga na mu tu gulisa, ndi bukai mu gola uku gwanao, ta li nka sheleñi ko muwaya-waya konke bulyo? Kono takuli nanga nkalumbu konke ka li fwila bulyo uku Isenu ta la zibi. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Mane no nshuki jenu ja ku mitwi ji li balitwe. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Cwale mu leke uku joga, inwe mu li ba butokwa lwini ku ita u tulumbu u tungi.<verse eid="MAT 10:31" /></para>
  <para style="s">Uku zumina Kilesite kampa uku mu shampula</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />“Uju a ndi lugula ku bantu, neme kuti na ndi mu lugule kwa Tata mwigulu. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Mi uju a ndi shampula ku bantu, neme kuti na ndi mu shampule kwa Tata gwa kwigulu.<verse eid="MAT 10:33" /></para>
  <para style="s">Tali nku joja nenja na nda leta</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />“Mu leke uku gaja buti nku joja nenja na nda leta mwilonga! Ta li nku joja nenja, kono ni nkondo na nda leta. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Ici na nda kezela nkuta buti,</para>
  <para style="b" vid="MAT 10:35" />
  <para style="q1" vid="MAT 10:35">u muntu a zokele isi,</para>
  <para style="q2" vid="MAT 10:35">no mwana go mukazana a zokele nyina,</para>
  <para style="q1" vid="MAT 10:35">u mwanakazi a sesetwe kuti na zokele mukwe gwakwe go mwanakazi.<verse eid="MAT 10:35" /></para>
  <para style="q2">
    <verse number="36" style="v" sid="MAT 10:36" />Mi aba na ba zimbe u muntu mbantu <optbreak />bo luasi lwakwe.<note caller="+" style="x"><char style="xo" closed="false">10:36 </char><char style="xt" closed="false"><ref loc="MIC 7:6">Mika 7:6</ref>.</char></note><verse eid="MAT 10:36" /></para>
  <para style="b" />
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />“U muntu a shaka lwini isi kampa nyina ku ita ubu a ndi shakila, ta botele uku ba gwangu. Mi u muntu gense uju a shaka lwini mwane go muninzana kampa go mukazana ku ita ubu a ndi shakila, ta botele uku ba gwangu. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Mi u muntu gense uju ta indi i cifapaano cakwe no ku ndi umpilila, ta botele uku ba gwangu. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />U muntu gense uju a shaka lwini u bumi bwakwe kuti na bu jonekelwe, mi uju a jonekelwa u bumi bwakwe kebaka lyangu kuti na bu gwane.<verse eid="MAT 10:39" /></para>
  <para style="s">Byo mipuzo</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />“U muntu gense uju a mi tambula, ndime a la tambuli, mi uju a ndi tambula ga sa tambula uju sa ndi tuma. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Uju a tambula u muboni gwa Nyambe kebaka lyo ku ta buti muboni gwa Nyambe, kuti na tambule u mupuzo go muboni gwa Nyambe. Mi uju a tambula u muntu a lulikile, ko ku ba u muntu a lulikile, kuti na tambule u mupuzo go muntu a lulikile. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Mi ati u muntu gense na wa nanga ni nkomoki jo menzi go ku tontola ku banunu bamwinya ba baba a bazigigwa bangu, mbyaconse ndi mi lugwila buti, jojo u muntu ta na jonekelwe u mupuzo gwakwe.”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Jesu no Joani u mukolobezi</para>
  <para style="r">(<ref loc="LUK 7:18-35">Luk 7:18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Jesu aa sa la mani uku laga a bazigigwa bakwe be kumi no bo bile, kale ga ja bu zimbuluka mu minzi no mu bibaka bimwinya bya mwilonga lya Galileya, na ja bu ziga no ku tandaza ijwi lya Nyambe.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Joani uju ka li mu ntolongo, kale ga shugwa i bintu byonse ibi ka tenda Kilesite. Mi kale ga tuma a bazigigwa bakwe kwa Jesu buti ba ka mu buze buti, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />“Ndigwe Mushaligwa ko tegwa buti u li botele uku keza kampa tu lindile jumwinya?”<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Jesu kale ga ba taba nage, “Mu bogole mu ka lugwile Joani ibi mu la shugwi no ku bona, <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />a baofu se ba la bona, aba ta ka ba jenda se ba la jenda, bo cisenda se ba li lwalukite mi a baulu se ba la shugwa, aba ba fwa ba sa busigwa mi a makande a malotu se ga la tandazigwa ku bampale. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Imfwijaguzi nja muntu uju ta sitagali angu.”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />A bazigigwa ba Joani aa se ba la bogoli, Jesu kale ga tatika uku gambagula bya Joani ku bantu nage, “Aa na mwa ja kwa Joani aa ka ka li mu lugole, muntu gwa buti na mwa ka bona? Izo ndutaka ka lu ungisigwa ku nkuli? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Kampa mbinzi ka mu gaja u ka bona, nu nkosi ka zwesi mu bizwato bi tula lwini? Inga, a bantu ba zwata i bizwato bi tula mu minzi jo bumfumu ba joja. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Kono ncinzi na mwa ka bona? Muboni gwa Nyambe? Ee, mane a la ita u muboni gwa Nyambe. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Kakuli Joani ndege na ba ñola mu Mañolo aga ga ta buti,</para>
  <para style="b" vid="MAT 11:10" />
  <para style="q1" vid="MAT 11:10">‘Nga mu lole, kuti na ndi tume u mutumigwa gwangu uju na li tangize ku buso bwako mi kuti na ka ku shabwile inzila.’<note caller="+" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="MAL 3:1">Malaki 3:1</ref>.</char></note><verse eid="MAT 11:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11" />“Mbyaconse ndi mi lugwila buti, ku bantu bonse aba na ba joja aano ansi, takuli u munene uju a ita Joani u mukolobezi. Kono kame, u mununu mu mubuso gwegulu, munene ku mu ita. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Mi ku zwa mu nako na ga tatika Joani u mukolobezi uku tandaza ijwi lya Nyambe ku leta aano, u mubuso gwa kwigulu gu li kwesi uku janduluka ko nguzu<note caller="+" style="f"><char style="fr" closed="false">11:12 </char><char style="ft" closed="false">A mabuka gamwinya mbuti ku ñolelwe buti, “U mubuso gwa Nyambe gwa sa lwisigwa.” </char></note> mi a bankosi bo kazula ba sa gu muna. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Kakuli a baboni ba Nyambe mane no mulao gwa Mushe byonse na bya sebeza ko buboni ku leta ku nako ja Joani. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Mi ati na mu shaka uku bi tambula, Joani nde Eliya uju ka tegwa buti ka botele uku keza.<note caller="+" style="x"><char style="xo" closed="false">11:14 </char><char style="xt" closed="false"><ref loc="MAL 4:5">Malaki 4:5</ref>.</char></note> <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />U muntu gense uju a kwesi a matwi go ku shugwisa, a shugwe.<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />“Ncinzi sa ka ndi kozanise a bantu ba shunu-aano? Mba ku koza sinagwe mbanuke ba zana a nkanza. Aba ba li kuga-kuga mwalyabo nabo,<verse eid="MAT 11:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />‘Tu la mi zimbili inimbo jo mukiti ko ku litusisa insengo</para>
  <para style="q2" vid="MAT 11:17">kono ta mu la nengi,</para>
  <para style="q1" vid="MAT 11:17">kame tu la mi zimbili inimbo jo mafu, kono ta mu la lili.’<verse eid="MAT 11:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="MAT 11:18" />“Kakuli Joani na ga keza uku ta li i bilyo no ku nywa, kono na ba mu ta buti, ‘Ndiyauma li mu munite.’ <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Kono ime nde Mwana Muntu na nda keza na ndi lilila no ku linywina, kono kame se ba la ta buti, ‘Ngwa malyabi jojo kame ncidakwa, musele go batentesi no bantu bo bitendantu i bimangoju.’ Kono a magano ga la ku li bonaazanga buti ga li kele nenja ko bitendantu byago.”<verse eid="MAT 11:19" /></para>
  <para style="s">U bumpai bo bantu ta na ba siguluka</para>
  <para style="r">(<ref loc="LUK 10:13-15">Luk 10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Cwale Jesu kale ga tatika uku nyaza a bantu ba mu minzi u mu na ga tenda a mamakazo a mangi kono kakuli ta na ba leka i bitendantu byabo i bimangoju no ku sigulukila kwa Nyambe. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />“U bumpai mbwenu mwe bantu ba mu munzi gwa Kolazini nenwe mwe bantu ba mu munzi gwa Bbesaida! Kakuli a mamakazo na nda tendela mu minzi jenu, kali na ndi la ga tendeli mu minzi ja Taya no Sidoni, a bantu ba jejo i minzi nkale na ba la siguluki ko ku jabala a masaka no ku li singa itwe. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Ta ndi mi omi, u bumpai bo bantu ba mu minzi ja Taya no Sidoni kuti na bu be u buuba ku ita bwenu mwijuba lyo nkatulo.<verse eid="MAT 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 11:23" />“Nenwe mwe bantu ba mu munzi gwa Kapenauma, buti kuti na mu ka nanunigwe no ka kutikigwa kwigulu? Inga! Kuti na mu ka tininikizwe kwinsi mu cibaka co bafu. Kakuli a mamakazo na nda tendela mu munzi gwenu kali mu munzi gwa Sodoma na ndi la ga tendeli, gogo u munzi na gu si kele no shunu-aano. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Kono nda sa mi lugwila buti, u bumpai bwenu kuti na bu be bunene mwijuba lyo nkatulo ku ita bo bantu ba mu munzi gwa Sodoma.”<verse eid="MAT 11:24" /></para>
  <para style="s">Inkuluwizi jo ku wisa kwa ba ba kotele</para>
  <para style="r">(<ref loc="LUK 10:21-22">Luk 10:21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Mwa jejo inako, Jesu kale ga lapela nage, “Tata gwe Mfumu gwa kwigulu no ansi. Nda sa ku lumba kakuli na gwa zindila a bantu aba ba kwesi a magano no bantu a bagomba u bulotu bo bintu bi zinditwe, ibi bi zibigwa bulyo ku bantu ba kozete a banuke-gana kakuli ba la zumina kwako. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Ee Tata, kakuli mbobo ko shakile.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />“Tata sa ndi wa i bintu byonse. Takuli uju a ndi zi ime nde Mwana Nyambe mbwita Tata, mi takuli uju e zi Tata mbwita ime nde Mwana Nyambe na ba na nda li shalila buti ndi mu ba ganwine.”<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />“Mu keze kwangu inwe mwense se mu kotele no ku koleka i mizigo jo ku lema, mi kuti na ndi mi we uku wisa. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Mu inde ijokwe lyangu mu li li kambike mi mu li zige kwangu kakuli ndi li mugomba no bulotu u mojo, mi kuti na mu gwanine i miuja jenu uku wisa. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Kakuli ijokwe lyangu ndi tole uku li koleka mi u muzigo gwangu muuba.”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Jesu nu Mfumu gwejuba lyo Nsabata</para>
  <para style="r">(<ref loc="MRK 2:23-28">Male 2:23-28</ref>; <ref loc="LUK 6:1-5">Luk 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Momo mu nako Jesu kale ga itila mu lugwa lo lukau mwijuba lyo Nsabata<note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="ft" closed="false">Ijuba lyo bu 7 mu nsunda, ili ta ka ba sebezanga a Majuda na ba lapela Nyambe mi mu Cishanjo ndya Mukibelo kampa ijuba lyo ku wisa.</char></note>. A bazigigwa bakwe se ka ba fwite injala mi kale ba ja bu koshagula i mikunku jo bweke na ba ji lya. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />A Bafalisi aa ba bona bulyao kale ba ta Jesu nabo, “Ngolole, a bazigigwa bako se ba la tenda ici ta ci zumininwa ko mulao uku tendigwa mwijuba lyo Nsabata.”<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Jesu kale ga ba taba nage, “Ka mu sini uku bala mu mabuka go baboni ba Nyambe ici na ga tenda Deviti aa ka fwite injala na ba ka jenda nabo? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Aa sa ngina mu njugo ja Nyambe no ku shwauza u mulao ko ku lya i binkwa bi cenete ibi ka bi botele uku ligwa ku mapulisiti bulyo. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Ta na mwa bala no mu mulao buti a mapulisiti ba la ku shwauzanga lyo Nsabata aa ba sebezanga mu tempele mi nanganceciba bulya ta ba kwesi u mulandu? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Nda sa mi lugwila buti, mo muno mwa li u muntu u munene ku ita i tempele! <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Kali na mu la zibi ibi bi tolokigwa mu Mañolo u mu ku ta buti, ‘Ime ninse ndi shaka ku ita i citagilo,’<note caller="+" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="HOS 6:6">Oseya 6:6</ref>.</char></note> mi ta na mu la atuli u muntu uju ta kwesi u mulandu. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Kakuli ime nde Mwana Muntu ndi li mfumu gwejuba lyo Nsabata.”<verse eid="MAT 12:8" /></para>
  <para style="s">Jesu aa oza u muntu mwijuba lyo Nsabata</para>
  <para style="r">(<ref loc="MRK 3:1-6">Male 3:1-6</ref>; <ref loc="LUK 6:6-11">Luk 6:6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Cwale Jesu kale ga zwa momo mu cibaka, mi kale ga ngina mu njugo jo malapelelo jo Majuda. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Momo mo ka li unkosi ka juminine u kuboko. Ko ku shaka a kaito ko ku shangeza Jesu i cintu, a Bafalisi kale ba buza Jesu nabo, “Izo ncintu ci botete uku oza a balwele mwijuba lyo Nsabata?”<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Jesu kale ga ta nage, “Ati jumwinya gwenu na kwesi ingu mi jejo ingu se ji la gwila mwilambo lyo Nsabata, buti ta na ga ka ji kokamo? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Mi mu gaje buti u muntu ngwa butokwa lwini ku ita ingu. Ko ku tenda bulyao, u mulao kanti gu la zuminina a bantu uku tenda ici ci botete lyo Nsabata.”<verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />Cwale Jesu kale ga ta jojo unkosi nage, “Golola iganja lyako.” Jojo unkosi kale ga golola iganja lyakwe mi kale lya lwaluka sinagwe ndimwinya. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Kono a Bafalisi kale ba zwao no ka gambagula ubu ka ba botele uku yagila Jesu.<verse eid="MAT 12:14" /></para>
  <para style="s">Jesu u Mushaligwa gwa Nyambe</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Jesu aa sa la nanguli, kale ga zwa momo mu cibaka. A bantu a bangi kale ba mu umpilila. Ige kale ga oza a balwele bonse. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Mi kale ga nanguza a bantu buti ba leke uku lugwila a bantu buti Jesu ndini. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Kale kwa vumbilizwa ibi sa co u muboni gwa Nyambe Isaya aa sa ta buti,<verse eid="MAT 12:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“Uju nde muika gwangu uju na nda li shalila.</para>
  <para style="q1" vid="MAT 12:18">Ndege ndi shaka mi a la ndi jangaza.</para>
  <para style="q1" vid="MAT 12:18">Kuti na ndi tule u Moya gwangu egulu lyakwe,</para>
  <para style="q1" vid="MAT 12:18">mi kuti na lugwile a bantu bo malonga gonse byo <optbreak />nkatulo jangu.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Ta na likanane no muntu kampa uku kumba</para>
  <para style="q1" vid="MAT 12:19">mi takuli uju na shugwe ijwi lyakwe mu mazila.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Ta na colelele u lutaka lu funyukite,</para>
  <para style="q1" vid="MAT 12:20">kampa uku zima a kalilo ka si suma u busi.</para>
  <para style="q1" vid="MAT 12:20">Kuti na zundamine bulyao ku twala inkatulo ji kele nenja aa na ji gole.<verse eid="MAT 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21" />Mi izina lyakwe ndelyo na li be insepo jo bantu bo malonga gonse.”<note caller="+" style="x"><char style="xo" closed="false">12:21 </char><char style="xt" closed="false"><ref loc="ISA 42:1-4">Isaya 42:1-4</ref>.</char></note><verse eid="MAT 12:21" /></para>
  <para style="s">Jesu no Bbeluzebule u mfumu go mayauma</para>
  <para style="r">(<ref loc="MRK 3:20-30">Male 3:20-30</ref>; <ref loc="LUK 11:14-23">Luk 11:14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Cwale nko ka li unkosi uju ka munitwe ku mayauma. Ka li muofu kame ta ka gamba mi kale ba mu leta kwa Jesu. Jesu kale ga mu oza jojo unkosi mi kale ga tatika uku gamba no ku bona. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />A bantu bonse kale ba komokwa mi kale ba buza nabo, “Izo buti Jesu nde mwana Deviti?” <verse eid="MAT 12:23" /><verse number="24" style="v" sid="MAT 12:24" />Kono a Bafalisi aa se ba la shugwi bulyao, kale ba ta nabo, “Ndi Bbeluzebule, u mfumu go mayauma a mu wete inguzu jo ku tanda a mayauma.”<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Jesu kale ga ziba ibi ka ba gaja mi kale ga ba ta nage, “U mubuso gonse ugo no ku li taa gwa sa shwauka, mi no munzi gonse kampa a bantu bo luasi lonke abo no ku li taa mwalyabo, ta na ba zimane bu gongwele. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Mi ati Satani na tanda Satani kale ga li taa gemwini mi u mubuso gwakwe gwa sa shwauka. <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Mi ati inguzu ndi litusisa mu ku tanda a mayauma nkwa Bbeluzebule ji zwa, inga a baumpilili benu nkwibo ba gwana inguzu? Mi elu kuti na ba be a baatuli benu. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Kono ati kame ndi tanda a mayauma ko Moya gwa Nyambe, mu zibe buti u mubuso gwa Nyambe se gu li li mukati kenu. <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />Kame ndini a gola uku ngina mu njugo jo muntu a gongwele no ka inda u lubono lwakwe? Mbwita u muntu go kazula ku mu ita ndege a gola uku mu shumina no ku ngina mu njugo ku iba u lubono lwakwe.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />“U muntu gense uju ta kele neme ndime a lwisa, mi u muntu gense uju ta gwaniki neme ga sa mwaga. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Mi nda sa mi lugwila buti, i bitendantu i bimangoju byonse mane no kashwau konse ibi ba tenda a bantu, kuti na bi kwatilwe kono uju a shwauza u Moya go Kucena ta na kwatilwe. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />U muntu gense uju na ndi kwage ime nde Mwana Muntu kuti na kwatilwe, kono u muntu gense uju na gambe ku kwaga u Moya go Kucena ta na kwatilwe mo muno mwilonga mane no mwilonga li keza.<verse eid="MAT 12:32" /></para>
  <para style="s">I cishamu mpa biyango byaco ci zibilwa</para>
  <para style="r">(<ref loc="LUK 6:43-45">Luk 6:43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />“I cishamu mpa biyango ci aka ba ci zibilanga. Ati i cishamu ncilotu, i biyango ci aka nabyo kuti bi be i bilotu. Ati i cishamu ncimangoju, no biyango byaco ibi ci aka kuti bi be i bimangoju. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Inwe mwe bantu mu kozete a bana bo bili! Mbuti mu gola uku gambagula i bintu i bilotu uku na mu li babi? Kakuli a kanwa kame ka gambagulanga i bintu ibi bi vumbite mu mojo. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />U muntu u mulotu mbintu i bilotu a zwisanga mu cibiko cakwe i cilotu ca mu mojo gwakwe, kono u muntu u mubi ga sa zwisa mu cibiko i cibi co mojo u mubi gwakwe. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Mi nda sa mi lugwila buti, mwijuba lyo nkatulo kuti na mu ligambilile kwijwi lyonse ili se mu gamba. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Kakuli ko majwi gako kuti no tendigwe ko cisemo mi kame ko majwi gako kuti no atuligwe.”<verse eid="MAT 12:37" /></para>
  <para style="s">I cijuliko ca Jonasi</para>
  <para style="r">(<ref loc="MRK 8:11-12">Male 8:11-12</ref>; <ref loc="LUK 11:29-32">Luk 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Cwale, a Bafalisi bamwinya no bazigi bo mulao kale ba keza kwa Jesu no keza ku mu ta nabo, “Muzigi, kame tu shaka uku bona i cijuliko ci zwa kwako.”<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Jesu kale ga ba taba nage, “Inwe mwe luasi lu mangujuwite no cise ncijuliko mu kumbila! Kono takuli i cijuliko sa ka ndi mi tendele mbwita i cijuliko co muboni gwa Nyambe Jonasi. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Kakuli sinagwe ndi Jonasi aa na ga kala a majuba go tatwe no masiku go tatwe mwivumo lyoonswi u munene, neme nde Mwana Muntu kuti na ndi kale a majuba go tatwe no masiku go tatwe mwibita.<verse eid="MAT 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 12:41" />“Mwijuba lyo nkatulo, a bantu bo munzi gwa Nenive kuti na ba be a bampaki ku atula lo luno u luasi lwa shunu. Kakuli abo na ba siguluka ku leka i bitendantu byabo i bimangoju ko ntandazo ja Jonasi, kono u munene ku ita Jonasi ndime. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />No mfumu go mwanakazi gwa ku mbogela kuti na be umpaki kwa lo luno u luasi mwijuba lyo nkatulo no ku lu atula, kakuli na ga ka zwa kwilonga lya kule keza ku shugwa ku magano ga Solomoni. Kono u munene ku ita Solomoni ndime.<verse eid="MAT 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />“U moya u mumangoju aa gu zwa ku muntu, mu lugole gu janga ku ja bu shaka mo ku wisikiza, mi aa gu kangwa uku gwana, <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />se gu la ta nago, ‘Kuti na ndi bogole mu njugo jangu u mu na nda zwa.’ Aa gu ka sika se gu la ka gwana jejo injugo buti takuli ici ci limo mi se nja kucena no ku tuligwa nenja. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Mi gogo u moya u mubi se gu la ka ja no ka shaka jimwinya i myoya ja 7 iji ji gu ita ku bumangoju, mi se ji la ngina kwa jojo u muntu no ku jojamo. Mi jojo u muntu sa la ba u muntu u mumangoju ku ita ubu ka kalile etanzi. Mbobo na ku kalile no kwa lo luno u luasi lu mangujuwite.”<verse eid="MAT 12:45" /></para>
  <para style="s">U luasi lwa Jesu wawa</para>
  <para style="r">(<ref loc="MRK 3:31-35">Male 3:31-35</ref>; <ref loc="LUK 8:19-21">Luk 8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Jesu aa ka si gambagula ku bantu a bangi, nyina no bancegwe kale ba keza ku zimana anze mi kame ka ba shaka uku gambagula nage. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />U muntu jumwinya, kale ga ka gambaguza Jesu nage, “Nyoko no bancego mpanze ba zimene na ba shakite uku gambagula negwe.” <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />Jesu kale ga mu taba nage, “Maa ndini no bance gwangu mbani?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Jesu kale ga julika a bazigigwa bakwe mi kale ga ta nage, “Aba mba bamaa no bance gwangu. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Kakuli u muntu gense uju a tenda ubu a shakila Tata mwigulu, nde mwance gwangu, no ncii jangu no maa.”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Inguli jo mubyali</para>
  <para style="r">(<ref loc="MRK 4:1-9">Male 4:1-9</ref>; <ref loc="LUK 8:4-8">Luk 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Mwa lelyo ijuba, Jesu kale ga zwa momo mu njugo no ka kala kumbali je ziba. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />A bantu a bangi kale ba ka gwanana no ka mu bunganina, mi Jesu kale ga ngina mu bwato no ka kalamo a bantu bonse kale ba zimana ekamba. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Mi Jesu kale ga lugwila a bantu i bintu i bingi mu manguli nage, “U mubyali jumwinya sa ja ku ku byala i mbuto jakwe. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Aa ka kwesi uku mwaga imbuto, jimwinya kale ja gwila mu nzila mi i bijuni kale bya ji tolao no ku ji lya. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Jimwinya kale ja gwila a mabwe, aa ta ka ku li ivu ilingi. Kale ja mena wangu-wangu, kakuli ivu ka li li ice. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Kono ijuba aa se li tatika u kuya, kebaka lyo ku bula i miisi, i bimenantu kale bya boba. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Imbuto jimwinya kale ja gwila mu bivuna byo miga ibi na bya kula no ku funkuntisa i bimenantu. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Imbuto jimwinya kame kale ja gwila mwivu ilotu mi kale ja aka lwini u bweke u bungi. Jimwinya kale ja aka u bweke bo makumi ge kumi, jimwinya makumi ga 6 mane jimwinya makumi go tatwe ku ita aa ka bu sika u bweke na bu sini uku byaligwa. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />U muntu gense uju a kwesi a matwi, a shugwe.”<verse eid="MAT 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />A bazigigwa kale ba keza ku mu buza nabo, “Ncinzi aa u gambanga ku bantu mu manguli?”<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />Jesu kale ga ba taba nage, “Inwe na mwa wegwa inzibo jo bintu bi zinditwe byo mubuso gwa kwigulu, kono bamwinya ta na ba wegwa bulyao. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />U muntu gense uju a kwesi cimwinya, kuti na wegwe i bingi mi kuti na be no bintu i bingi. Kono u muntu uju ta kwesi nenja cimwinya, kuti na tapigwe utu ka li kuluwize tonse. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Mpaa ndi gambagula nabo mu manguli buti,</para>
  <para style="b" vid="MAT 13:13" />
  <para style="q2" vid="MAT 13:13">‘Nanga na ba wene, ta ba bonisisi, nanga na ba shugwile, <optbreak />ta ba shugwi kampa uku shugwilisa.’<verse eid="MAT 13:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="MAT 13:14" />“Ceco ca sa vumbiliza kwabo u buboni bo muboni gwa Nyambe Isaya aa sa ta buti,</para>
  <para style="b" vid="MAT 13:14" />
  <para style="q1" vid="MAT 13:14">‘Kuti mu shugwange kono ta mu shugwilisange.</para>
  <para style="q2" vid="MAT 13:14">Kuti mu bonange wawa kono ta mu bonisisange.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Kakuli ba ba a bantu mba ciulu,</para>
  <para style="q2" vid="MAT 13:15">i myojo jabo mi kukutu mi ta ba shugwi nanga na ba kwesi a matwi,</para>
  <para style="q1" vid="MAT 13:15">mi mba ku li zima a mensho,</para>
  <para style="q1" vid="MAT 13:15">ko ku tenda bulyao, ka ba bona ko mensho gabo,</para>
  <para style="q2" vid="MAT 13:15">no ku shugwa ko matwi gabo mi ka ba shugwilisa ko myojo jabo,</para>
  <para style="q1" vid="MAT 13:15">no ku siguluka buti ndi ba oze.’<note caller="+" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="ISA 6:9">Isaya 6:9</ref>,<ref loc="ISA 6:10">10</ref>.</char></note><verse eid="MAT 13:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />“Kono inwe mu li kwesi imfwijaguzi kakuli mu la bona mi mu la shugwa. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Kakuli mbyaconse ndi mi lugwila buti, u bungi bo baboni ba Nyambe no bantu ba lulikile ka ba zilwize uku bona ibi mu wene kono ta na ba bi bona, no ku shugwa ibi mu shugwa kono ta na ba bi shugwa.<verse eid="MAT 13:17" /></para>
  <para style="s">Intoloko jo nguli jo mubyali</para>
  <para style="r">(<ref loc="MRK 4:13-20">Male 4:13-20</ref>; <ref loc="LUK 8:11-15">Luk 8:11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />“Cwale nga mu tegeleze intoloko jo nguli jo mubyali. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />U muntu gense aa shugwa byo mubuso mi ta bi shugwilisi, u muntu u mubi ga sa keza kwakwe keza ku inda ici na ca byaligwa mu mojo gwakwe. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Imbuto na ja gwila mwivu lyo ku gwanana no mabwe, ja sa julika a bantu ba shugwa no ku tambula ijwi bu jangele. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Kono inako imfuwi bulyo, se ba la unguluka a makababu no mapenzi aa ga keza kwabo kebaka lyeejwi, se ba la gwa. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Imbuto na ja gwila mwivu lya mu bivuna byo miga, ja sa julika a bantu ba shugwa ijwi lya Nyambe kono inkengejezi ja bo buno u bumi no ku ungululwa ko lubono se bi la funkuntisa ijwi mi ta li si aki i biyango. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Kono imbuto na ja gwila mwivu ilotu, ja sa julika a bantu ba shugwa ijwi no ku li shugwilisa. Mi babo se ba la leta i biyango i bingi byo makumi ge kumi, makumi ga 6 mane no makumi go tatwe ku ita ibi na bya byaligwa.”<verse eid="MAT 13:23" /></para>
  <para style="s">Inguli ja nampuluza</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Jesu kale ga ba lugwila inguli jimwinya nage, “U mubuso gwa kwigulu ngwa ku koza sinagwe muntu a byala imbuto indotu mwigwa lyakwe. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Kono a bantu bonse aa ka ba si lele, u muntu uju a mu zimbite kale ga keza ku byala i mbuto ja nampuluza mukati ko buloto na ka li jila. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />U buloto aa se bu la shomaguli no ku tula i mikunku no nampuluza nage kale ga shomagula.<verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />“A baika kale ba keza kwa mfumwabo no keza ku mu buza nabo, ‘Mfumwetu, ta li ni mbuto indotu na gwa byala mwigwa lyako? Uku na ga zwila nampuluza kwibo?’<verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />“Ige kale ga taba nage, ‘Muntu a ndi zimbite na ga tenda bulyao.’ Babo a baika kale ba mu buza nabo, ‘U la shaka buti tu ka bi nyukagulemo?’<verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />“Ige kale ga ba taba nage, ‘Inga, kakuli aa sa ka mu je bu nyukagula nampuluza mane mu ka nyukilile no buloto antu-onke. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Mu bi leke bi kulilile antu-onke byonse ku twala a ku zimbula. A nako jo ku zimbula kuti na ndi lugwile a bazimbuli buti, mu gwanike tanzi nampuluza mu mu shumangile mu mañata buti a tentigwe, mi inwe mu ka gwanike no ka leta u buloto mwiyongo lyangu.’ ”<verse eid="MAT 13:30" /></para>
  <para style="s">Inguli jo lubuto u lununu</para>
  <para style="r">(<ref loc="MRK 4:30-32">Male 4:30-32</ref>; <ref loc="LUK 13:18-19">Luk 13:18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Jesu kale ga ba lugwila kame inguli jimwinya nage, “U mubuso gwa kwigulu ngwa ku koza u lubuto u lununu<note caller="+" style="f"><char style="fr" closed="false">13:31 </char><char style="ft" closed="false">A mabuka go Cigelike mbuti ga co buti, “ndubuto lo masitete” mi ndununu lwini mi ka lu byaligwanga mu malonga go Majuda, ka lu menanga no ku kula ku ba i cishamu.</char></note> ulu lu byaligwa mwigwa. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Nanga na lu li u lununu ku mbuto jonse, kono aa se lu la kuli, se lu la ba i cishamu i cinene ku ita i bishamu byonse bya mwigwa buti mane no bijuni se bi la keza ku jakila i bijakilo ku ntabi jaco.”<verse eid="MAT 13:32" /></para>
  <para style="s">Inguli jo mumela</para>
  <para style="r">(<ref loc="MRK 4:33-34">Male 4:33-34</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Jesu kale ga ba lugwila inguli jimwinya kame nage, “U mubuso gwa kwigulu ngwa ku koza u mumela u muce ugu a la indi u mwanakazi no ku gu gwanika no makomoki go tatwe go busu bo ku kanda mi se gu la gwanana no mukandilo gonse.”<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Jesu kale ga gamba i bintu byonse byebi ku bantu a bangi ko ku litusisa a manguli. Ta ka gamba bulyo kwabo uku ta litusisi a manguli. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Mi ceco ka ci vumbiliza ibi sa gamba Nyambe ko muboni gwakwe aa sa ta buti,</para>
  <para style="b" vid="MAT 13:35" />
  <para style="q1" vid="MAT 13:35">“Kuti na ndi gambe nenwe mu manguli.</para>
  <para style="q2" vid="MAT 13:35">Kuti na ndi toloke i bintu ka bi zinditwe ku zwa ilonga <optbreak />aa li bumbigwa.<note caller="+" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 78:2">Nimbo 78:2</ref>.</char></note>”<verse eid="MAT 13:35" /></para>
  <para style="b" />
  <para style="s">Jesu aa toloka inguli ja nampuluza</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Jesu kale ga zwa aa ka ba li a bantu no ku ngina mu njugo. A bazigigwa bakwe kale ba mu ta nabo, “Tu tansulwile ibi ji toloka inguli ja nampuluza na ga byaligwa mwigwa.”<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Jesu kale ga ba taba nage, “U muntu uju na ga byala i mbuto indotu ndime nde Mwana Muntu. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Igwa ndilonga, mi i mbuto indotu ja sa julika a bantu bo mubuso. Nampuluza ga sa julika a bantu bo muntu u mubi. <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />Mi u muntu a ndi zimbite uju na ga ba byala ndi Satani. Inako jo ku zimbula ja sa julika a mamaninino ga je jino inako, mi a bazimbuli mañiloi.<verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />“Sinagwe ubu na ba nyukila nampuluza no ku mu tenta mu mulilo, mbobo na ku tendaalile no ku mamaninino go nako. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Ime nde Mwana Muntu kuti na ndi tume a mañiloi gangu mi kuti na ga zwise i bintu byonse mu mubuso gwangu ibi bi leta i bitendantu i bimangoju mane no bantu aba ta ba tendi ubu gu shakila u mulao. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Kuti na ba ba shonjele mwileba lyo mulilo u mu na ku ka be no malilo mane no ku kweka a meno. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Mi aba ba lulikile kuti na ba ka bege sinagwe ndi juba mu mubuso gwesabo. U muntu gense uju a kwesi a matwi, a shugwe.<verse eid="MAT 13:43" /></para>
  <para style="s">Inguli jo lubono lu bikamite</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“U mubuso gwa kwigulu ngwa ku koza u lubono lu bikamite mwigwa, mi u muntu kale ga lu gwana. Ko ku jangala lwini kale ga lu bika no ku bogola ku munzi ka gulisa i bintu byonse ibi ka kwesi no ka gula lelyo igwa.<verse eid="MAT 13:44" /></para>
  <para style="s">Inguli jo bigulantu byo butokwa</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />“Kame u mubuso gwa kwigulu ngwa ku koza u mugulisi uju a ja bu shaka i bigulisantu byo butokwa. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Aa sa la gwani i cigulisantu co butokwa lwini, sa la bogola ka gulisa i bintu byonse ibi a kwesi no keza ku ci gula.<verse eid="MAT 13:46" /></para>
  <para style="s">Inguli jo kanyandi a kanene</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />“Kame, u mubuso gwa kwigulu ngwa ku koza a kanyandi a kanene aka ka shonjelwa mwiziba mi se ka la kwata inswi ji andene-andene. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Aa se ka la vumbi, a mandui se ba la kokela a kanyandi ekamba. Mi se ba la kala ansi no ku gwanika inswi indotu mu bitundu no ku showa inswi imangoju. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Mbobo na ku kalile ku mamaninino go nako. A mañiloi kuti na ga keze ku taa a bantu bo bitendantu i bimangoju ku bantu bo bitendantu i bilotu. <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />Mi kuti na ga shonjele a bantu bo bitendantu i bimangoju mwileba lyo mulilo ta gu zimi, u mu na ku be no malilo no ku kweka a meno.” <verse eid="MAT 13:50" /><verse number="51" style="v" sid="MAT 13:51" />Jesu kale ga ba buza nage, “Izo mu la bi shugwilisi byonse byebi?” Abo kale ba mu taba nabo, “Ee, tula bi shugwilisi.”<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Jesu kale ga ba ta kame nage, “U muzigi go mulao gense uju aba u muzigigwa go mubuso gwa kwigulu ngwa ku koza sinagwe mwini njugo uju a longotola i bintu i biya no bikulu-kulu mu cibiko co njugo jakwe.”<verse eid="MAT 13:52" /></para>
  <para style="s">Jesu aa kanigwa mu munzi gwa Nanzaleta</para>
  <para style="r">(<ref loc="MRK 6:1-6">Male 6:1-6</ref>; <ref loc="LUK 4:16-30">Luk 4:16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Jesu aa sa la mani uku ba gambaguza byebyo i bintu mu manguli, kale ga zwa momo mwilonga. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Kale ga bogola ku munzi gwakwe, mi kale ga tatika uku ziga a bantu mu majugo go malapelelo go Majuda gabo. A bantu ka ba komokwa ku bintu ka ziga mi ka ba li buzagula mwalyabo nabo, “Kwibo na ga gwana gonse gaga a magano no nguzu iji a litusisa mu ku tenda a mamakazo?” <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Kale ba mu kwaga nabo, “Izo ta li nde mwana mubeji no nyina buti ta li ndi Maliya? No bancegwe buti ta li mba Jakobo no Josefa no Simoni no Judasi? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Ba nciijankwe ta li mbabo baba tu joja nabo? Kwibo na ga bi gwana byonse byebi i bintu?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Kale ba mu nyegelela mi kale ba kana uku zumina kwakwe.</para>
  <para style="p" vid="MAT 13:57">Jesu kale ga ba ta nage, “U muboni gwa Nyambe a la kutikigwa mwilonga lyonse mbwita mu munzi gwakwe no ku bantu bo luasi lwakwe.” <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Kebaka lelyo Jesu kale ga kangwa uku tenda a mamakazo a mangi momo kebaka lyabo lyo ku bula inzumino.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">U lufu lwa Joani u mukolobezi</para>
  <para style="r">(<ref loc="MRK 6:14-29">Male 6:14-29</ref>; <ref loc="LUK 9:7-9">Luk 9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Momo mu nako u mfumu Eloda uju ka busa ilonga lya Galileya kale ga shugwa bya Jesu. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />Kale ga lugwila a bantu bakwe nage, “Joani u mukolobezi na ga ka zikuka, ka zwa ku bafu. Mpaa kwesi inguzu jo ku tenda a mamakazo bulyao.”<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Eloda ndege sa kwata Joani no ku mu shumina no ku mu tula mu ntolongo ku jangaza u mukazi gwakwe Elodiasi uju ka sesigwanga etanzi kwa mwancegwe Filipi. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Kakuli Joani ka lugwilanga Eloda buti, “To zumininwa uku ja ko mulao aa u sesa joju u mwanakazi.” <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Eloda kale ga shaka uku yaga Joani kono ka jogete a bantu, kakuli a bantu bonse ka ba zumine buti Joani ka li muboni gwa Nyambe.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Kono mwijuba lyo mukiti gwa Eloda go ku li vulusa ijuba lyakwe lyo ku bonigwa, mwana Elodiasi go mukazana kale ga nenga ku jangaza Eloda. <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />Ige kale ga mu kuluwiza ko ku konka uku mu wa i bintu byonse ibi ka kumbila kwakwe. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Ko ku lugwilwa kwa nyina, jojo u mukazana kale ga ta nage, “Mutwi gwa Joani u mukolobezi ndi shaka, ugu ndi tulile aa a kasuba ko ku galama.” <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />U mfumu kale ga zielea mi kebaka lyo ku konka ko nkuluwizi na ga li shumina akati ko bantu aba na ga kuga, Eloda kale ga ta buti ku tendaale ubu a la kumbilili. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Mi kale ba ka koshola Joani u mutwi mu ntolongo, <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />no ka leta gogo u mutwi a kasuba ko ku galama no keza ku gu wa jojo u mukazana. Ige kale ga gu twalila nyina. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />A bazigigwa ba Joani kale ba keza no ku inda i citupu cakwe no ka ci zika, mi kale ba ka ja no ka lugwila Jesu.<verse eid="MAT 14:12" /></para>
  <para style="s">Jesu aa wa i bilyo ku bantu ba 5,000</para>
  <para style="r">(<ref loc="MRK 6:30-44">Male 6:30-44</ref>; <ref loc="LUK 9:10-17">Luk 9:10-17</ref>; <ref loc="JHN 6:1-14">Joa 6:1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Jesu aa sa la shugwi ibi na bya tendaala, kale ga ngina mu bwato mu buzinda no ku ja ku cibaka uku takuli a bantu. A bantu aa se ba la shugwi uku na ga ja, kale ba zwa mu minzi i mingi kale ba jenda no matende bulyo ku mu umpililako. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Jesu aa ka fugika u bwato, kale ga bona a bantu a bangi. Kale ga ba fwila inse mi kale ga oza a balwele babo.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />A matengu, a bazigigwa ba Jesu kale ba keza kwakwe no keza ku mu ta nabo, “Mo muno mu mangusu mi kame se matengu. U te a bantu ba bogole buti ba li jile mu minzi ba ka ligulile i bilyo.”<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Kono Jesu kale ga ba taba nage, “Ta ba botele u ka ja, mu ba we co ku lya ba lye.”<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />Abo kale ba mu taba nabo, “Makoto ga 5 bulyo go buobe tu kwesi aano, nonswi jo bile.”<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />Jesu kale ga ba ta nage, “Mu bi ndi letele kuno.” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Jesu kale ga ta a bantu buti ba kale ansi a bwiju. Kale ga inda gago a makoto ga 5 go buobe nonswi jo bile mi kale ga ligamina kwigulu no ku litumela. Kale ga komagula gago a makoto no ku wa a bazigigwa bakwe mi abo kale ba taangila a bantu. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />A bantu bonse kale ba lya ku kuta mi aa se ba la mani, a bazigigwa ba Jesu kale ba vumba i bitundu bye kumi no byo bile byo buobe na bwa sigala. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />A bantu aba na ba lya ka ba li bangi. Ta na ba bala a banuke no banakazi kono a bankosi bulyo ka ba li ba 5,000.<verse eid="MAT 14:21" /></para>
  <para style="s">Jesu aa jenda a menzi</para>
  <para style="r">(<ref loc="MRK 6:45-52">Male 6:45-52</ref>; <ref loc="JHN 6:15-21">Joa 6:15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Aobulyo, Jesu kale ga indikiza a bazigigwa bakwe buti ba ngine mu bwato no ku shatukila mwisilya lyeziba. Ige kale ga sigala na si fundula a bantu. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Aa sa la mani uku fundula a bantu, Jesu kale ga ja elundu no ka kalao genke na lapela. Ijuba kale lya ka gwa mane na ku siya Jesu na sikalio genke. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />U bwato se ka bu ka li u kule ne kamba mi a makupezi se ka ga ukusa u bwato kebaka lyo nkuli na ja fukuka ku tenga-tengisa u bwato.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />A maca-siku, Jesu kale ga keza bu ba tungulwize na jenda a menzi. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />A bazigigwa aa ba mu bona na jenda a menzi, kale ba joga lwini. Kale ba kumbagana bu jogete nabo, “Ncilumba!”<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Kono Jesu kale ga gamba nabo wangu-wangu nage, “Mu leke uku joga, mu gongole i myojo! Ndime!”<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Pitolosi kale ga taba nage, “Mfumwangu, ati ndigwe wawa, u ndi te ndi keze kwako bu jenda a menzi.”<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />Jesu kale ga ta nage, “Keza.”</para>
  <para style="p" vid="MAT 14:29">Cwale Pitolosi kale ga zwa mu bwato no ku ja kwa Jesu na jenda a menzi. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Kono Pitolosi aa bona inkuli no bushanshu bo makupezi, kale ga joga mi kale ga tatika uku lobela. Kale ga kumba nage, “Ndi jojese mfumwangu!”<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Aobulyo, Jesu kale ga golola iganja lyakwe no ku mu kwata, mi kale ga mu ta nage, “Igwe go nzumino ince, ncinzi aa u la mamanyi?”<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />Aa se ba la ngini mu bwato, inkuli kale ja ombelela. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Mi a bazigigwa kale ba mu shogelela, no ku mu ta nabo, “Ndiconse u li Mwana Nyambe.”<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Aa se ba la ka siki mwisilya lyeziba, kale ba ka fugikila ekamba lya Genenzaleta. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Mi a bantu ba momo mwilonga kale ba ziba buti ndi Jesu mi kale ba ka gambaguza bamwinya. Mi aba ka ba kwesi a balwele, kale ba ba leta buti aba oze. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Bamwinya kale ba mu kumbila buti a zuminine a balwele uku kwata bulyo nanga nku mungundo go mukanjo gwakwe, mi aba ka ba mu kwata ka ba lwaluka.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">Jesu aa ziga byo bintu ibi bi gola uku <optbreak />jonagula u muntu</para>
  <para style="r">(<ref loc="MRK 7:1-13">Male 7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Mi a Bafalisi bamwinya no bazigi bo mulao, kale ba zwa mu munzi gwa Jelusalema no keza kwa Jesu mi kale ba mu buza nabo, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“Ncinzi a bazigigwa bako aa ba shwauza i cizo co bakulu? Kakuli ta ba shambangi ku maganja na ba sini uku lya i bilyo!”<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Jesu kale ga taba nage, “Ingenwe ncinzi aa mu shwauzanga i milao ja Nyambe ko ku kutikanga bulyo i milao jo cizo cenu? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Kakuli Nyambe sa ta buti, ‘U kutike isho no nyoko,’<note caller="+" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="EXO 20:12">Lujendo 20:12</ref>; <ref loc="DEU 5:16">Mulao 5:16</ref>.</char></note> mi ‘U muntu uju a kuta isi no nyina, a li botele uku yagigwa.’<note caller="+" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="EXO 21:17">Lujendo 21:17</ref>; <ref loc="LEV 20:9">Livitike 20:9</ref>. </char></note> <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Kono inwe mbuti mu co buti ati u muntu na ta isi no nyina nage, ‘I bintu ka ndi botele uku mi tusa ndi Nyambe na nda bi wa.’ <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Ko ku tenda bulyao se mu la ta buti ta ba botele uku kutika a bazazi babo mi se mu la manisa ijwi lya Nyambe kebaka lyo cizo cenu. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Inwe mwe bantu bo mantu! U muboni gwa Nyambe Isaya sa bona byenu nenja aa sa gamba ko buboni buti,<verse eid="MAT 15:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />‘Baba a bantu mba ku ndi kutika bulyo mu bigambo byabo kono i myojo jabo, nkule wawa neme ji ka li.<verse eid="MAT 15:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="MAT 15:9" />Ba sa ndi lapela mwa bulyo kakuli inzigo jabo nja bantu bulyo.’ <note caller="+" style="x"><char style="xo" closed="false">15:9 </char><char style="xt" closed="false"><ref loc="ISA 29:13">Isaya 29:13</ref>. </char></note> ”<verse eid="MAT 15:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Jesu kale ga kuga a bantu a bangi no ku ba ta buti, “Mu tegeleze mi mu shugwilise. <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />I bintu a lya u muntu ta bi goli uku mu jonagula kono i bigambo a gamba mbebyo bi gola uku mu jonagula.”<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />A bazigigwa ba Jesu kale ba keza kwakwe no keza ku mu buza nabo, “lzo u la nanguli buti a Bafalisi ba la lunguki kebaka lyo bintu u la ba teli?”<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Jesu kale ga ba taba nage, “I cibyalantu conse ici ta na ga byala Tata gwa kwigulu, kuti na ci nyukigwe. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Mu ba leke kakuli mbaofu nanga na ba li bajendesi bulyao, mi ati i ciofu na ci jendesa i ciofu mugenzaco, byonse kuti bi ka gwile mwilambo.”<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Pitolosi kale ga mu ta nage, “Ngo tu tansulwile ibi ji co jejo inguli.”<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />Jesu kale ga ba buza nage, “Kanti nenwe mu sili bigelo aa ta mu la ji shugwilisi? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Ta mu wene buti i bintu bi ngina mu kanwa mwivumo bi ja no ka zwila kunze jo mubili? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Kono i bigambo a gambanga u muntu, mu mojo bi zwanga mi mbebyo bi gola uku mu jonagula. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Kakuli mu mojo momo ku zwanga i biganjantu i bimangoju, u buyagi, u kunyanka bamwinya, i cise, u busa, u bupaki bo manya no bukwagi. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Bebyo mbye bintu bi gola uku jonagula u muntu. Kono uku lya i bilyo uku u muntu ta la shambi ku maganja, ta ku goli uku mu jonagula.”<verse eid="MAT 15:20" /></para>
  <para style="s">Inzumino jo mwanakazi gwa mwilonga lya Kanana</para>
  <para style="r">(<ref loc="MRK 7:24-30">Male 7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Jesu kale ga zwa momo mu cibaka mi kale ga ja mwilonga lyo minzi ja Taya no Sidoni. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />U mwanakazi gwa mwilonga lya Kanana kale ga keza kwakwe no keza ku mu kugiliza nage, “Gwe Mfumu, mwana Deviti, u ndi fwile inse mwanangu go mukazana ndiyauma li mu munite mi lya sa mu pengisa wawa.”<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Kono Jesu kale ga ombelela bulyo, mi ta na ga mu taba cimwinya. A bazigigwa ba Jesu kale ba keza ku kumbila Jesu nabo, “U tande joju u mwanakazi a bogole, ga sa zundamina uku ja bu lila mwishule lyetu.”<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Jesu kale ga ta nage, “Nku bantu ba Isilaele bulyo na nda tumigwa aba se ba kozete sinagwe ningu ji jobete.”<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Jojo u mwanakazi kale ga keza ku tongama afuwi no Jesu mi kale ga mu kumbila lwini nage, “Mfumwangu, u ndi tuse!”<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Jesu kale ga ta nage, “Ta ku botele uku inda i bilyo byo banuke no ku bi wa a bambwa.”<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />Jojo u mwanakazi kale ga ta nage, “Ee mbobo bulyao Mfumwangu, kono nabo a bambwa ba la kulyanga u bubugulusi ubu bu gwilanga ansi ku zwa a ntafule aa ba lilanga bamfumwabo.”<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Mi Jesu kale ga mu ta nage, “Mwanakazi, u li kwesi inzumino inene ku tendaale ubu u la kumbilili.” Aobulyo jojo mwane kale ga lwaluka.<verse eid="MAT 15:28" /></para>
  <para style="s">Jesu aa ngiisa i bilyo no ku bi wa a bantu ba 4,000</para>
  <para style="r">(<ref loc="MRK 8:1-10">Male 8:1-10</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Jesu kale ga zwa momo mu cibaka mi kale ga sezumuka no ka landika ikamba lyeziba inene lya Galileya. Kale ga kambama a nkambamo jelundu mi kale ga kala ansi. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />A bantu a bangi kale ba keza kwakwe mi bamwinya kale ba mu letela a balwele aba ta ba jendi, a baofu, bo ku golomena i bilama na ba ta ba gambi mane no balwele aba ka ba lwala a malwele ga andene-andene mi kale ga ba oza. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />A bantu a bangi kale ba komokwa aa ba bona a bantu aba ta ka ba gamba na ba gamba, no bo ku golomena i bilama na ba golokete nenja, aba ta ka ba gola uku jenda se ka ba jenda no baofu buti se ba la bona, mi kale ba lumba Nyambe go bantu ba Isilaele.<verse eid="MAT 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Jesu kale ga kuga a bazigigwa bakwe no ku ba ta buti, “Nda sa fwila inse baba a bantu kakuli se ba li indite a majuba go tatwe, bu bulite co ku lya. Nda sa kangwa uku ba fundula bulyaa mane ba kangwe uku jenda kebaka lyo njala.”<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />A bazigigwa ba Jesu kale ba mu buza nabo, “Kwibo tu botele uku gwana i bilyo mo muno mu mangusu buti tu we a bantu a bangi bulyaa?”<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Jesu kale ga buza a bazigigwa bakwe nage, “Makoto goti mu kwesi?”</para>
  <para style="p" vid="MAT 15:34">A bazigigwa bakwe kale ba mu taba nabo, “Makoto ga 7 bulyo tu kwesi nonswi ince inunu.”<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Mi Jesu kale ga ta a bantu buti ba kale ansi. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Kale ga inda a makoto ga 7 nonswi no ku bi lapelela mi kale ga bi komagula no ku wa a bazigigwa bakwe mi abo kale ba bi taila a bantu. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />A bantu bonse kale ba lya ku kuta mi aa se ba la mani uku lya, a bazigigwa ba Jesu kale ba vumba i bitundu bya 7 byo bubugulusi ubu na bwa sigala. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Impalo jo bankosi bulyo aba na ba lya ndi 4,000 kono a banakazi no banuke ta na ba baligwa. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Jesu kale ga fundula a bantu mi ige kale ga ngina mu bwato u bunene no ku ja mwilonga lyo Magadana.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">A bajendesi aa ba kumbila i makazo kwa Jesu</para>
  <para style="r">(<ref loc="MRK 8:11-13">Male 8:11-13</ref>; <ref loc="LUK 12:54-56">Luk 12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />A Bafalisi no Basaduki kale ba senena kwa Jesu mi kale ba mu jeleka ko ku mu kumbila buti aba sunde i cijuliko ci zwa kwigulu.<verse eid="MAT 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2" />Jesu kale ga ba ta nage, “A matengu ijuba na li ka gwa mu la ku zibanga buti ijona kuti na li ñatule nenja kakuli igulu li la ku bonaalanga uku subila. <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Mi a masiku-siku, mu la ku zibanga buti shunu umvula kuti a shoke kakuli igulu li la ku bonaalanga uku subila mane no majoba. Mu li zekelele no ku tansulula u mubonaalilo gwegulu kono mwa sa kangwa uku toloka i bijuliko byo manako. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />U luasi u lubi no cise ncijuliko lu shaka kono takuli i cijuliko sa ka ndi ba sunde mbwita i cijuliko co muboni gwa Nyambe Jonasi.” Jesu kale ga ba leka na ka li jila.<verse eid="MAT 16:4" /></para>
  <para style="s">U mumela go Bafalisi no Basaduki</para>
  <para style="r">(<ref loc="MRK 8:14-21">Male 8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Kale ba shatuka iziba ku ja mwisilya mi a bazigigwa kale ba zibala uku inda u buobe. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Jesu kale ga ba ta nage, “Mu ligunge no ku mamela u mumela go Bafalisi no Basaduki.”<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />A bazigigwa ba Jesu kale ba gambagula mwalyabo nabo, “Mpaa tu la zibali uku inda u buobe mpaa gamba bulyao.”<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Jesu kale ga ziba ibi ka ba ja bu gambagula mwalyabo mi kale ga ba buza nage, “Inwe bo nzumino ince, ncinzi aa mu gambagula mwalyenu byo ku sa inda u buobe? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Ta mu la shugwilisi ibi ndi la ku ta? Ta mu gaji a makoto ga 5 go buobe aga na ga ligwa ku bantu ba 5,000, no ku ta buti mbitundu byoti na mwa vumba byo makoto aga na ga sigala? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />No makoto ga 7 na ga ligwa ku bantu ba 4,000 no ku ta buti mbitundu byoti na mwa vumba byo makoto aga na ga sigala? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Ncinzi aa ta mu shugwilisi buti ta li mbya buobe ndi la ku gambagula? Kono nda sa mi ta kame buti, ‘Mu ligunge no ku mamela u mumela go Bafalisi no Basaduki.’ ” <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />A bazigigwa ba Jesu kale ba shugwilisa buti Jesu ta li mumela go ku tula mu buobe ka ba nanguza kono mbintu ibi ba ziga a Bafalisi no Basaduki ka ba nanguza.<verse eid="MAT 16:12" /></para>
  <para style="s">Pitolosi aa ta buti Jesu nde <optbreak />Mushaligwa gwa Nyambe</para>
  <para style="r">(<ref loc="MRK 8:27-30">Male 8:27-30</ref>; <ref loc="LUK 9:18-21">Luk 9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Jesu aa sa la ka siki mwilonga lya Sesaleya Filipi, kale ga buza a bazigigwa bakwe nage, “A bantu mbuti ba co buti ime nde Mwana Muntu ndimeni?”<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />Abo kale ba taba nabo, “Bamwinya mbuti ba co nabo ndigwe Joani u mukolobezi, bamwinya nabo ndigwe Eliya mi bamwinya kame ba sa ta nabo ndigwe Jelemiya kampa jumwinya go baboni ba Nyambe.”<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />Jesu kale ga ba buza kame nage, “Ingenwe mbuti mu ndi co?”<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />Simoni Pitolosi kale ga mu taba nage, “Ndigwe Mushaligwa no Mwana Nyambe uju a joja.”<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Jesu kale ga mu ta nage, “Simoni mwana Jona, u li gwa mfwijaguzi kakuli ta li muntu na ga bi ku ganwina kono ndi Tata wawa gwa kwigulu na ga bi ku ganwina. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Mi nda sa ku ta buti, ndigwe Pitolosi<note caller="+" style="f"><char style="fr" closed="false">16:18 </char><char style="ft" closed="false">Pitolosi ku toloka “ibwe.”</char></note> mi ime kuti na ndi jake no ku gongoza a bazumini bangu sinagwe muntu a jakila injugo jakwe ebwe buti nanga ni nguzu jo cibaka co bafu ta na ji ba gole. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Mi kuti na ndi ku we i biatiso byo mubuso gwa kwigulu. I bintu no kanine ansi kuti na bi kanigwe no kwigulu, mi ibi no zuminine ansi kuti na bi zumininwe no kwigulu.” <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Jesu kale ga binda a bazigigwa bakwe buti ba leke uku lugwila a bantu buti nde Mushaligwa gwa Nyambe.<verse eid="MAT 16:20" /></para>
  <para style="s">Jesu aa gamba byo lufu lwakwe</para>
  <para style="r">(<ref loc="MRK 8:31-9:1">Male 8:31–9:1</ref>; <ref loc="LUK 9:22-27">Luk 9:22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Ku zwa jejo inako, Jesu kale ga tatika uku gambaguzanga a bazigigwa bakwe buti a li botele uku ja ku munzi gwa Jelusalema buti a manduna no mapulisiti a bakulu mane no bazigi bo mulao ba ka mu pengise, buti a yagigwe kono na buke ku zwa ku bafu mwijuba lya tatu.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Pitolosi kale ga mu kugila kumbali no ka mu binda buti, “Mfumwangu, bya bulyao na bi leke uku tendaala kwako!”<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Jesu kale ga mu zokela no ku mu ta nage, “Zwa kwangu Satani! U li cisitagaliso kwangu. Kakuli to shugwilisi bya Nyambe mbwita byo bantu.”<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Jesu kale ga ta a bazigigwa bakwe nage, “Ati u muntu na shaka uku ba u muzigigwa gwangu, a leke uku twalikiza ingana kwa byakwe kono a inde i cifapaano cakwe no ku ndi umpilila. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Kakuli u muntu gense uju a shaka uku unela u bumi bwakwe kuti na bu jonekelwe. Mi u muntu gense uju na jonekelwe u bumi bwakwe kebaka lyangu, ndege na bu gwane. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Mbulotunzi nanga u muntu na muna ilonga lyonse mi ige nko ka fwa? Kampa ncintunzi a botele uku joboza u muntu no muuja gwakwe? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Kakuli ime nde Mwana Muntu kuti na ndi keze mu mpazimo no nguzu ja Tata antu-onke no mañiloi mi kuti na ndi atule u muntu gense ko ku ja ke bi na ga tenda. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Mbyaconse ndi mi lugwila buti, bamwinya aba ba zimene aano ta na ba lase u lufu na ba sini uku ndi bona ime nde Mwana Muntu na ndi keza mu mubuso gwangu.”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">Jesu aa zoka uku tuba</para>
  <para style="r">(<ref loc="MRK 9:2-13">Male 9:2-13</ref>; <ref loc="LUK 9:28-36">Luk 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />A majuba ga 6 aa se ga la mani, Jesu kale ga inda Pitolosi, Jakobo no Joani mwancegwe gwa Jakobo mi kale ga ja nabo elundu ile no ka kalao bonke. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Aa ka ba si kele bulyao, Jesu kale ga zoka mi inkumo jakwe kale ja pazima sinagwe ndituba lyejuba mi i bizwato byakwe kale bya tuba sinagwe ndituba. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Aobulyo Mushe no Eliya kale ba bonaala na ba gambagula no Jesu.<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />Pitolosi kale ga ta Jesu nage, “Mfumwangu, mbulotu kwetu aa ka tu kalilila bulyo aano mi ati u la shaka kuti ndi jake i bikutu byo tatwe. Cimwinya ci be cako, cimwinya ci be ca Mushe mi cimwinya ci be ca Eliya.”<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Aa ka si gamba bulyao, kale kwa keza ijoba lyo ku tuba keza ku ba vwika, mi kale kwa shugwaala ijwi mwijoba li ta buti, “Joju ndi Mwanangu, uju ndi shaka lwini mi a la ndi jangaza. Mu mu shugwe!”<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />A bazigigwa aa ba shugwa bulyao kale ba joga lwini mi kale ba gwila ansi bu sungamite. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Mi Jesu kale ga keza kwabo no keza ku ba kwata mi kale ga ba ta nage, “Mu zimane, mu leke uku joga.” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />A bazigigwa aa ba lola, kale ba kangwa uku bona u muntu jumwinya mbwita Jesu.<figure style="fig" alt="Jesus is transfigured" file="gt00032.jpg" size="col" loc="Mat 17:1-8" copy="Gordon" ref="17:1-8">Jesu aa zoka uku tuba</figure><verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Aa se ka ba ka zwa elundu, Jesu kale ga ba ta nage, “Na mu leke uku gambaguza u muntu gense i bintu ibi mu la boni ku twala aa na ndi buke ku zwa ku bafu ime nde Mwana Muntu.”<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />A bazigigwa bakwe kale ba mu buza nabo, “Ncinzi a bazigi bo mulao aa ba si ta buti Eliya a si botele uku keza tanzila?”<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Jesu kale ga taba nage, “Mbyaconse, Eliya a si botele uku keza tanzila buti a lukise i bintu byonse. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Kono nda sa mi lugwila buti Eliya sa keza, kono ta na ba mu ziba, mi kale ba mu tenda ubu ka ba shakila bonse. Mbobo na ba ndi tendele neme nde Mwana Muntu.” <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />A bazigigwa kale ba ziba buti Jesu mbya Joani u mukolobezi ka ta.<verse eid="MAT 17:13" /></para>
  <para style="s">Jesu aa oza u muninzana uju <optbreak />ka munitwe kwiyauma</para>
  <para style="r">(<ref loc="MRK 9:14-29">Male 9:14-29</ref>; <ref loc="LUK 9:37-43">Luk 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Aa se ba la sezumuki elundu, kale ba gwana a bantu a bangi aba ka ba ba lindile. Unkosi jumwinya kale ga keza ku tongama a fuwi no Jesu. Kale ga mu kumbila nage, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />“Mfumwangu, u fwile inse mwanangu go muninzana. Mulwele go cinagu mi ga sa penga lwini. U bungi bo nako a la ku gwilanga mu mulilo kampa mu menzi. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Na nda mu leta ku bazigigwa bako, kono ta na ba mu oza.”<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Jesu kale ga ta nage, “Inwe mwe luasi ta lu zumine no lunyono! Ni nako ji sika kwibo na ndi kale nenwe? Ndusiku nzi na mu ndi zumine? Ndi letele jojo u muninzana.” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Mi Jesu kale ga jukukila lelyo iyauma ili ka li li ku muninzana, mi kale lya mu leka. Ku zwao jojo u muninzana kale ga lwaluka.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Cwale a bazigigwa ba Jesu kale ba mu buza mu buzinda nabo, “Ncinzi iswe aa na twa kangwa uku tanda le lilya iyauma?”<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />Jesu kale ga taba nage, “Ta mu gongwele mu nzumino. Mbyaconse ndi mi lugwila buti, kali na mu kwesi inzumino sinagwe ndubuto u lununu, ka mu gola uku lugwila leli ilundu buti, ‘U zwe ao u je alya,’ mi ka li mana ku zwao. Mi takuli ici ka ci kangwa uku golaala.”<verse eid="MAT 17:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 17:21" />Kono iyauma lya bulyaa ta li zwangi bulyo mbwita ko ku lapela no ku li nyima i bilyo.<note caller="+" style="f"><char style="fr" closed="false">17:21 </char><char style="ft" closed="false">A mabuka go Cigelike gamwinya no mabuka gamwinya ta ga kwesi intimana ja 21.</char></note><verse eid="MAT 17:21" /></para>
  <para style="s">Jesu aa gamba byo lufu lwakwe lyabili</para>
  <para style="r">(<ref loc="MRK 9:30-32">Male 9:30-32</ref>; <ref loc="LUK 9:43-45">Luk 9:43-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Aa se ba la kezi kame mwilonga lya Galileya, Jesu kale ga ba lugwila nage, “Ime nde Mwana Muntu nge nde ku legezigwa ku bantu aba ba ndi zimbite. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />Kuti na ba ndi yage, kono mwijuba lya tatu kuti na ndi buke ku zwa ku bafu.” Mi a bazigigwa kale ba ba mu nkalilwa.<verse eid="MAT 17:23" /></para>
  <para style="s">U mutenteko go tempele</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Aa ba ka sika mu munzi gwa Kapenauma, A batentesi ba mu tempele kale ba keza kwa Pitolosi no keza ku buza nabo, “U muzigi gwenu buti a la ku tentekanga u mutenteko go tempele?”<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />Pitolosi kale ga ba taba nage, “Eni, a la ku tentekanga.”</para>
  <para style="p" vid="MAT 17:25">Mi Pitolosi kale ga ngina mu njugo. Na sini uku gamba, Jesu kale ga mu buza nage, “Simoni, mbuti u gajila? Buti a bamfumu ba la ku tentekisanga a bakwabo kampa mbantu bulyo ba tentekisanga?”<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />Pitolosi kale ga taba nage, “Mbantu bulyo ba tentekisanga.”</para>
  <para style="p" vid="MAT 17:26">Jesu kale ga mu taba nage, “U la tabi nenja, a bakwakwe bo bamfumu ta ba botele uku tentekanga! <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Nanganceciba bulyao, ta tu shaki buti tu ba fosekeze, cwale u sezumuke kwiziba u ka shonje a kashuto kako mu menzi. Unswi gwe tanzi uju so ko ka kwate u mu kwate mu kanwa mi kuti u gwanemo isheleñi inene lyo buwaya-waya. U li indemo no ka li tenteka buti li tu zimanine twe bile.”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">U munene mu mubuso gwa kwigulu</para>
  <para style="r">(<ref loc="MRK 9:33-37">Male 9:33-37</ref>; <ref loc="LUK 9:46-48">Luk 9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Mwa jejo inako a bazigigwa kale ba keza kwa Jesu no ku mu buza nabo “U munene mu mubuso gwa kwigulu ndini?”<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />Jesu kale ga kuga u mwanuke-gana no ku mu zimika mukati kabo. <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />Mi Jesu kale ga ta nage, “Mbyaconse ndi mi lugwila buti, ati ta mu siguluki no ku koza sinagwe mbanuke-gana, ta na mu ngine mu mubuso gwa kwigulu. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />U muntu gense aa ba u mugomba sinagwe ndege joju u mwanuke-gana, nde munene mu mubuso gwa kwigulu.<verse eid="MAT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 18:5" />“Mi gense uju a tambula u mwanuke-gana sinagwe ndege joju mwizina lyangu, ndime a la tambuli. <verse eid="MAT 18:5" /><verse number="6" style="v" sid="MAT 18:6" />Kono ati u muntu na letela jumwinya gwa baba a bantu aba ba ndi sepete sinagwe mbanuke-gana, buti ba tende i bitendantu i bimangoju, u bulotu kwakwe nku mu sungilila ibwe inene mu nsingo no ku mu shonjela mwiwate.<verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />“U bumpai mbwa bantu ba mwilonga, kakuli ba sa sitagalisa bamwinya buti ba tende i bitendantu i bimangoju mi i bintu bya bulyao bi li botele uku keza, kono u bumpai mbwa muntu uju a letela bamwinya uku sitagala! <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Cwale ati iganja lyako kampa itende lyako na li ku tendisa i bitendantu i bimangoju, u li koshole no ku li showa. U bulotu nku ngina mu bumi ta bu mani ne ganja lyonke kampa itende lyonke ku ita u ka ngina mu mulilo ta gu zimi no maganja go bile kampa no matende go bile. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Mi ati i linsho lyako na li ku tendisa i bitendantu i bimangoju, u li nonkolemo no ku li showa. U bulotu nku ngina mu bumi ta bu mani no linsho lyonke ku ita uku shonjelwa mwileba lyo mulilo no mensho go bile.<verse eid="MAT 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />“Mu mamele buti mu leke uku shwauza baba a banuke-gana. Kakuli nda sa mi lugwila buti a mañiloi gabo ga li lolelele inako jonse inkumo ja Tata gwa kwigulu. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />Mi ime nde Mwana Muntu kame na nda keza ku jojesa a bantu aba ba jobete.<note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">A mabuka go Cigelike gamwinya no mabuka gamwinya ta ga kwesi intimana ja 11.</char></note><verse eid="MAT 18:11" /></para>
  <para style="s">Inguli jongu jo ku joba</para>
  <para style="r">(<ref loc="LUK 15:3-7">Luk 15:3-7</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />“Mbuti mu gajila? U muntu ati na kwesi ingu jo makumi ge kumi, mi se ku la jobao jonke, mbuti a botele uku tendela? Ta na ga leka ja 99 a malundu, no ka shaka jejo ji jobete? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Mbyaconse ndi mi lugwila buti, aa ka ji gwana ga sa jangala lwini ku ita ubu ka jangalile aa ka lolelele jejo ta na ja joba ja 99. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Ko ku tenda bulyao, Isenu gwa kwigulu ta shaki buti kwa baba a banuke-gana ku jobeo nanga genke.<figure style="fig" alt="Parable of the lost sheep" file="dn00473b.jpg" size="col" loc="Mat18:12-14" copy="Dunham" ref="18:12-14">Ingu jo ku joba</figure><verse eid="MAT 18:14" /></para>
  <para style="s">Byo ku joja nenja no bamwinya</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />“Ati u mukwako na ku fosekeza, u mujile mu buzinda no ka mu lugwila ubu a la ku fosekezi. Ati na ku shugwa, kuti mu jojisane nenja kame. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Kono ati ta ku tegelezi, u mu bogwele no muntu genke kampa bo bile, buti ibi sa ka mu gambe byonse bi be no bupaki bo bantu bo bile kampa bo tatwe. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Ati jojo u muntu na zundamina uku kana bulyo, u twale jejo intaba ku kagugi ko bazumini. Ati na kana uku zumina ku kagugi ko bazumini, u mu tende sinagwe muntu ta zumine kampa u mutentesi.<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />“Mbyaconse ndi mi lugwila buti, ibi mu kanina ansi, kuti na bi kaninwe no kwigulu, mi ibi mu zuminina ansi kuti na bi zumininwe no kwigulu.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />“Ndi si mi lugwila kame buti, ati a bantu bo bile ansi na ba zumininana a cintu conse mi se ba la ci kumbila kwa Tata gwa kwigulu, kuti na ci ba tendele. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Kakuli aa ku gwananina a bantu bo bile kampa bo tatwe mwizina lyangu, neme nabo ndi kele.”<verse eid="MAT 18:20" /></para>
  <para style="s">Inguli jo muika ta sepaali</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Mi Pitolosi kale ga keza kwa Jesu no ku mu buza nage, “Mfumwangu, nkoti ndi botele uku kwatila u muntu ati na ndi tenda i bitendantu i bimangoju, nka 7?”<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Jesu kale ga mu taba nage, “Ntali nka 7 bulyo kono makumi ga 7 aa ga baligwa ka 7!<verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />“Cwale u mubuso gwa kwigulu kuti ndi gu kozanise no mfumu uju a gwanika nenja impalo jo masheleñi aga na ba kolota kwakwe a baika. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Aa ka kwesi uku tenda bulyao, ku baika aba ka ba mu kolotele, kale kwa keza genke uju ka mu kolotele a masaka ga 10,000 ga gauda. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Kebaka lyo ku ta buti na ga kangwa uku tenteka, mi mfumwe kale ga ta buti jojo u muika a gulisigwe no mukazi gwakwe no bane mane ne bi ba kwesi byonse buti ba tenteke i cikoloti.<verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />“Kono jojo u muika kale ga tongama afuwi no mfumwe no ku mu kumbila nage, ‘U ndi lindile tanzi, kuti na ndi tenteke i cikoloti conse.’ <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Mfumwe gwa jojo u muika kale ga mu fwila inse, mi kale ga mu kwatila i cikoloti cakwe no ku mu leka.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />“Kono jojo u muika aa zwao, kale ga ja ku muika mugenze uju ka mu kolotele a masheleñi a mace. Kale ga mu kwata mu nsingo no ku mu ta buti a mu life wangu.<verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />“Jojo u muika mugenze kale ga tongama no ku mu kumbila nage, ‘U ndi leke tanzila, kuti na ndi lifilile i cikoloti conse.’<verse eid="MAT 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30" />“Kono jojo kale ga kana mi kale ga mu inda no ka mu nginika mu ntolongo ku twala aa na lifile i cikoloti conse. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />A baika bamwinya aa ba bona ibi na bya tendaala, kale ba nyegela mi kale ba ka gambaguza mfumwabo byonse ibi na bya tendaala.<verse eid="MAT 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32" />“Ige kale ga kuga jojo u muika gwakwe uju sa kwatila i cikoloti cakwe no ku mu ta nage, ‘U li muika u mubi! Ime na nda ku kwatila i cikoloti i cinene kakuli na gwa li kumbilila. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Igwe ncinzi aa ta na gwa fwila inse u muika mugenzo sinagwe ubu na nda ku fwilila inse?’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Jojo u mfumu kale ga mu nyegelela no ku twala jojo u muika ku ntolongo buti aka bangisigwe ku twala aa na lifile i cikoloti cakwe conse.<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />“No Tata gwa kwigulu mbobo na mi tendele bulyao ati ta mu kwatili bamwinya mu myojo jenu.”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Byo ku manisa a maseswa</para>
  <para style="r">(<ref loc="MRK 10:1-12">Male 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Jesu aa sa la mani uku gamba byebi i bintu, kale ga zwa mwilonga lya Galileya no ku ja kwilonga lya Judeya, mwisilya lyo Lwizi lwa Joodani. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />A bantu a bangi kale ba mu umpililako, mi kale ga oza a balwele babo.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />A Bafalisi bamwinya kale ba keza ku mu jeleka ko ku mu buza nabo, “Izo buti ncintu ci botete ku ja ko mulao unkosi aa tanda u mukazi gwakwe?”<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />Jesu kale ga taba nage, “Ka mu sini uku bala mu Mañolo u mu ku ñoletwe buti ku matatikilo ‘Nyambe sa ba bumba ko ku ba unkosi no mwanakazi.’<note caller="+" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="GEN 1:27">Matatikilo 1:27</ref>.</char></note> ” <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />Mi Jesu kale ga nungako nage, “ ‘Nko ku ta buti, unkosi a li botele uku leka isi no nyina no ka gwanana no mukazi gwakwe mi bo bile babo se ba la ba u muntu genke.<note caller="+" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="GEN 2:24">Matatikilo 2:24</ref>.</char></note>’ <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Kakuli ta ba si li bo bile kono se muntu genke. Nko ku ta buti, i cintu na ga nunga antu-onke Nyambe, u muntu a leke uku ci taa.”<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />A Bafalisi kale ba mu buza kame nabo, “Ncinzi Mushe aa sa ta mu mulao buti, unkosi aa tanda mukazi gwakwe a mu ñolele iñolo lyo ku mu tanda no ku mu fundula?”<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Jesu kale ga ba taba nage, “Ee, Mushe sa zuminina uku tanda a bakazi benu kebaka lyo bukukutu bo myojo jenu, kono ta li mbobo ka ku kalile ku zwa ku matatikilo. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Mi nda sa mi lugwila buti, u muntu gense uju a lukulula mukazi gwakwe no ku sesa u mungi, kale ga tenda i cise mbwitelu mukazi gwakwe ba la mu kwati na tenda i cise.”<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />A bazigigwa ba Jesu, kale ba ta nabo, “Ati mbobo ku kalile bulyao mukati ko nkosi no mukazi, u bulotu nku sa sesa.”<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Jesu kale ga taba nage, “Ntali muntu gense a gola uku tenda bulyao, mbwita kwa ba na ba wegwa bulyao. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Bamwinya a bankosi ta ba sesi kakuli mbobo na ba bonenwa, mi bamwinya mbantu na ba ba tenda bulyao, mi bamwinya kame ta ba sesi kebaka lyo mubuso gwa kwigulu. Uju a gola uku tambula bulyao a tambule.”<verse eid="MAT 19:12" /></para>
  <para style="s">Jesu aa wa a banuke imfwijaguzi</para>
  <para style="r">(<ref loc="MRK 10:13-16">Male 10:13-16</ref>; <ref loc="LUK 18:15-17">Luk 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Mi a bantu kale ba leta a banuke kwa Jesu buti aba kambike a maganja no ku ba lapelela. Kono a bazigigwa kale ba ba jukukila.<verse eid="MAT 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14" />Kono Jesu kale ga ta nage, “Mu leke a banuke ba keze kwangu, mi mu leke uku ba binda, kakuli u mubuso gwa kwigulu ngwa bantu bo ku koza baba a banuke.” <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Mi aa sa la ba kambiki a maganja gakwe egulu kale ga funduka.<figure style="fig" alt="Jesus blessing little children" file="dn00413b.jpg" size="col" loc="Mat 19:13-15" ref="19:13-15">Jesu aa lapelela a banuke-gana</figure><verse eid="MAT 19:15" /></para>
  <para style="s">Unkosana go lubono</para>
  <para style="r">(<ref loc="MRK 10:17-31">Male 10:17-31</ref>; <ref loc="LUK 18:18-30">Luk 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />U muntu jumwinya kale ga keza kwa Jesu no ku mu buza nage, “Muzigi, mbulotu bwa buti ndi botele uku tenda buti ndi gwane u bumi ta bu mani?”<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />Jesu kale ga mu taba nage, “Ncinzi aa u ndi buza byo cintu i cilotu? Nkwali u mulotu mi ndege genke. Aa u shaka uku ngina mu bumi, u kutike i milao.”<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />Jojo unkosana kale ga mu buza nage, “Milao ja buti?”</para>
  <para style="p" vid="MAT 19:18">Jesu kale ga mu taba nage, “U leke uku yaga. U leke uku tenda i cise. U leke uku iba. U leke uku pakanga byo manya. <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />U kutike isho no nyoko. U shake uju u bambene nage sinagwe ubu u li shakila.”<note caller="+" style="x"><char style="xo" closed="false">19:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">Lujendo 20:12-16</ref>; <ref loc="DEU 5:16-20">Mulao 5:16-20</ref>; <ref loc="LEV 19:18">Livitike 19:18</ref>.</char></note><verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />Jojo nkosana kale ga taba nage, “Ndi la ji kutika jeji i milao jonse. Ncintunzi ndi si botele uku tenda?”<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Jesu kale ga mu ta nage, “Ati kame u shaka buti u be u muntu uju a lulikile, u jende u ka gulise u lubono lonse ulu u kwesi mi a masheleñi u ga taangile a bampale, mi kuti no ka gwane u lubono kwigulu. Igwe u keze, u ndi umpilile.”<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />Kono jojo unkosana aa shugwa bulyao, kale ga tompa lwini mi kale ga zwao na ka li jila, kakuli ka kwesi u lubono u lungi.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Cwale Jesu kale ga ta a bazigigwa bakwe nage, “Mbyaconse ndi mi lugwila buti, ncintu i cikababu ku muntu uju a kwesi u lubono uku ngina mu mubuso gwa kwigulu. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Ndi si mi lugwila kame buti, u butole ni nkamele aa ji itila mu linsho lyo nsonga ku ita u muntu a kwesi u lubono, aa ngina mu mubuso gwa Nyambe!”<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />A bazigigwa aa ba shugwa bulyao, kale ba komokwa lwini, mi kale ba buza nabo, “Ndini na jojeswe elu?”<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Jesu kale ga ba lola mi kale ga ba ta nage, “Ku bantu byebi ta bi golaali. Kono kwa Nyambe i bintu byonse bi la golaala.”<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Mi Pitolosi kale ga gamba nage, “Iswe na twa leka i bintu byonse no ku ku umpilila! Iswe mbinzi na tu gwane?”<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Jesu kale ga mu taba nage, “Mbyaconse ndi mi lugwila buti i bintu byonse sa ka na bi zoke u buya, mi neme nde Mwana Muntu aa na ndi kale mu cikalo cangu co mpazimo, inwe na mwa ndi umpilila, kuti na mu kale nenwe mu bikalo bye kumi no byo bile byo bumfumu, na mu atula i mikoga je kumi no jo bile jo bana ba Isilaele. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Mi u muntu gense uju na ga leka a majugo gakwe kampa a bakwakwe, kampa isi kampa nyina, kampa a bana kampa u lugwa kebaka lyangu, kuti na bogolekezwe byo makumi ge kumi, mi kuti na jobole u bumi ta bu mani. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Kono a bangi aba ba li betanzi, kuti na ba be bo mamaninino mi a bangi bo mamaninino, kuti na ba be betanzi.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">Inguli jo babeleki ba mwigwa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />“U mubuso gwa kwigulu ngwa ku koza u muntu a kwesi igwa mi sa la meneka ka shaka a babeleki buti ba ka beleke mwigwa lyakwe. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Kale ga zumininana nabo buti aba olisange a masheleñi ga kwana ijuba mutumbi, mi kale ga ba tuma kwigwa.<verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />“Ku ma 9 jo masiku-siku, u mwini igwa kale ga itila mu cibaka co magulikizo mi kale ga bona a bantu bamwinya ba zimene-zimene bulyo uku takuli ici ba tenda. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Kale ga ba lugwila nage, ‘Nenwe mu jende mu ka beleke mwigwa lyangu mi kuti ndi mi life ici ci botele.’ <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Mi abo kale ba ka ja.</para>
  <para style="p" vid="MAT 20:5">“A kamwi kale ga jako, kame no mu nako jo ma 15, kale ga tenda bulyao. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Mu nako jo ma 17, kale ga jako no ka gwana bamwinya ba zimene-zimene bulyao, mi kale ga ba buza nage, ‘Ncinzi aa mu zimene-zimene bulyo ijuba mukatumbi uku takuli ici mu tenda?’<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />“Abo kale ba mu taba nabo, ‘Takuli uju a la tu tuli a musebezi.’</para>
  <para style="p" vid="MAT 20:7">“Jojo u mwini igwa kale ga ba ta nage, ‘Mu jende nenwe mu ka beleke mwigwa lyangu.’<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />“A matengu, u mwini igwa kale ga kuga u mubelekisi gwakwe no ku mu ta buti, ‘U kuge a babeleki u ba olise mi u tatikile uku olisa aba ba la ngini mwishule tanzila.’<verse eid="MAT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9" />“A ba na ba ngina ku ma 17 kale ba olisigwa a masheleñi ga kwana ijuba mutumbi. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />A babeleki aba na ba tangila uku ngina u musebezi, kale ba keza buti ba keze ba ole mi ka ba li kuluwize buti kuti ba gwane a masheleñi a mangi. Kono nabo kale ba gwana a masheleñi ga kwana ijuba lyonke. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Aa se ba la tambuli a masheleñi kale ba ka tongauka ku mwini igwa nabo, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />‘Ba balya a babeleki ni nako imfuwi bulyo ba la beleki kono u la ba olisi a masheleñi ga jelekele no getu iswe tu la beleki ijuba mukatumbi aa kale ku lengukila a kamwi.’<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />“U mwini igwa kale ga taba jumwinya gwabo nage, ‘Musele, ta ndi la ku omeneni! Masheleñi gejuba lyonke u la zumini uku belekela. <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Inda a masheleñi gako u jende. Ime kame ka ndi shaka uku wa u mubeleki gwa mwishule sinagwe ubu ndi la ku weli. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Buti ncintu ci lwisa u mulao aa ndi tenda ubu ndi shakila ko masheleñi gangu? Kampa muna u fwa aa ndi kwesi i cisemo?’<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />“Kakuli aba ba li bo mamaninino kuti na ba be betanzi, mi betanzi kuti na ba be bo mamaninino.”<verse eid="MAT 20:16" /></para>
  <para style="s">Jesu aa gamba byo lufu lwakwe lya tatu</para>
  <para style="r">(<ref loc="MRK 10:32-34">Male 10:32-34</ref>; <ref loc="LUK 18:31-34">Luk 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Jesu aa ka kambamina ku munzi gwa Jelusalema, kale ga inda a bazigigwa bakwe be kumi no bo bile, mi kale ga ba twala kumbali, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />kale ga ba ta nage, “Nga mu tegeleze! Se tu la ja ku munzi gwa Jelusalema uku na ndi ka legezigwe ime nde Mwana Muntu ku mapulisiti a bakulu no bazigi bo mulao. Kuti na ba ndi atwile u lufu. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />Kuti na ndi wegwe ku bantu aba ta ba li a Majuda buti ba ndi nyungulule no ku ndi shapa mane no ku ndi kankamina a cifapaano. Kono mwijuba lya tatu kuti na ndi buke ku zwa ku bafu.”<verse eid="MAT 20:19" /></para>
  <para style="s">Jesu aa ziga byo ku sebeleza bamwinya</para>
  <para style="r">(<ref loc="MRK 10:35-45">Male 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Aobulyo nyina ba Jakobo no Joani, bana Zebedeya kale ga keza kwa Jesu no bane. Kale ga tongama afuwi no Jesu no ku mu kumbila buti a mu tende nenja.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />Jesu kale ga buza nage, “Mbinzi u kumbila?”</para>
  <para style="p" vid="MAT 20:21">Ige kale ga mu taba nage, “Kame ndi kumbila buti baba a banangu bo bile na ba ka kale, jumwinya ku mulyo gweganja lyako jumwinya ku monsho, mu mubuso gwako.”<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />Jesu kale ga ba taba nage, “Ta mu zekelele ibi mu kumbila! Buti mu la gola uku nywina mu cinywino u mu na ndi nywine?”</para>
  <para style="p" vid="MAT 20:22">Abo kale ba taba nabo, “Ee, tu la gola!”<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Jesu kale ga ba lugwila nage, “Mbyaconse kuti na mu nywine mu cinywino cangu, kono ime ta ndi kwesi inguzu jo ku zuminina uju na ka kale ku mulyo gwangu kampa ku monsho. Kakuli Tata sa shala kale a bantu aba na ba ka kale momo mu bibaka.”<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />A bazigigwa bamwinya be kumi aa ba shugwa ibi na ba kumbila ba Jakobo no Joani, kale ba ba nyegelela. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Jesu kale ga ba gwanika no ku ba ta bonse nage, “Mu li zi buti a babusisi ba le lino ilonga ba sa busa a bantu babo mu bukababu, mi a bakulu ba sa lyatilila aba ba li mwinsi lyabo. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Kono kwenu ku leke ku kala bulyao. Gense uju a shaka uku ba u mujendesi a li botele uku ba u muika gwenu, <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />mi uju a shaka uku ba gwe tanzi mukati kenu, a li botele uku ba u muika gwenu. <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />Kakuli nanga ndime nde Mwana Muntu ta na nda keza ku ku sebelezwa, kono buti ndi sebeleze a bantu no ku wa u bumi bwangu ku ba intifo jo bantu a bangi.”<verse eid="MAT 20:28" /></para>
  <para style="s">Jesu aa oza a bankosi a baofu bo bile</para>
  <para style="r">(<ref loc="MRK 10:46-52">Male 10:46-52</ref>; <ref loc="LUK 18:35-43">Luk 18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Jesu no bazigigwa bakwe aa ba zwa mu munzi gwa Jeliko, a bantu a bangi kale ba mu umpilila. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />A bankosi bo bile a baofu aba ka ba kele kumbali no nzila aa ba shugwa buti ndi Jesu ka ita momo mu nzila, kale ba tatika uku kumbagana nabo, “Mfumwetu, mwana Deviti, u tu fwile inse!”<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />A bantu a bangi kale ba ba jukukila nabo, “Mu ombelele!” Kono abo kale ba kumbagana lwini nabo, “Mfumwetu, mwana Deviti, u tu fwile inse!”<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Jesu kale ga zimana no ku ba kuga. Mi kale ga ba buza nage, “Mbinzi mu shaka buti ndi mi tendele?”<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />Abo kale ba mu taba nabo, “Mfumwetu, kame tu shaka buti tu bone!”<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Jesu kale ga ba fwila inse mi kale ga ba kwata a mensho gabo. Aobulyo kale ba tatika uku bona mi kale ba mu umpilila.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">Jesu aa ngina mu munzi gwa <optbreak />Jelusalema ko bumfumu</para>
  <para style="r">(<ref loc="MRK 11:1-11">Male 11:1-11</ref>; <ref loc="LUK 19:28-40">Luk 19:28-40</ref>; <ref loc="JHN 12:12-19">Joa 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Jesu no bazigigwa bakwe aa se ka ba kokelele u munzi gwa Jelusalema, kale ba itila mu munzi gwa Bbetifage Elundu lya Olive, mi Jesu kale ga tuma a bazigigwa bakwe bo bile buti ba li tangize. <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />Kale ga ba ta nage, “Mu ka je mwa go gulya u munzi mi aa sa ka mu ka sike kuti mu ka gwane a kambongolo ka sungitwe no mwanako kumbali. Mu tu sungulule mi mu ka tu lete kwangu. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Ati nkwali uju sa ka mi buze buti ncinzi mu ka sungulwila, mu mu tabe buti, ‘Nu Mfumu aka shaka,’ mi aobulyo kuti a mi zuminine buti mu ka inde.”<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Kale kwa tendaala bulyao buti ku vumbilizwe u buboni ubu se bu co buti,<verse eid="MAT 21:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />“Mu lugwile a bantu ba mu munzi gwa Jelusalema buti,</para>
  <para style="q2" vid="MAT 21:5">‘Nga mu lole, Mfumwenu nkeza a keza kwenu.<note caller="+" style="f"><char style="fr" closed="false">21:5 </char><char style="ft" closed="false">Mu mabuka go Cigelike mbuti ku ñoletwe buti “Mwana Sione” go mukazana.</char></note></para>
  <para style="q1" vid="MAT 21:5">Mugomba, mi mpa kambongolo a paamite,</para>
  <para style="q2" vid="MAT 21:5">a kambongolo-gana.’ ”<note caller="+" style="x"><char style="xo" closed="false">21:5 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">Zakaliya 9:9</ref>. </char></note><verse eid="MAT 21:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Babo a bazigigwa bo bile kale ba tenda ubu na ga ba tela Jesu. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Kale ba leta a kambongolo no mwanako kwa Jesu mi kale ba jala i bizwato a mishana jato mi Jesu kale ga kalao. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />A bantu a bangi kale ba jala i bizwato bimwinya mu nzila, mi bamwinya kale ba tema intabi jo bishamu no ku ji jala mu nzila. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />A bantu aba ka ba tangilile na ba ka ba sigalile mwishule lya Jesu, kale ba ja bu kugiliza nabo,</para>
  <para style="q1" vid="MAT 21:9">“Ku lumbigwe Nyambe kebaka lya mwana Deviti!</para>
  <para style="q2" vid="MAT 21:9">Imfwijaguzi njakwe uju a keza mwizina lyo Mfumu!</para>
  <para style="q2" vid="MAT 21:9">Ku lumbigwe Nyambe mwigulu!”<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Jesu aa ngina mu munzi gwa Jelusalema, u bungi bo bantu kale ba ba mu nyungani jo ku jangala lwini mi kale ba buza nabo, “Ndini joju?”<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />A bantu a bangi kale ba taba nabo, “Ndi Jesu, u muboni gwa Nyambe gwa mu munzi gwa Nanzaleta mwilonga lya Galileya.”<verse eid="MAT 21:11" /></para>
  <para style="s">Jesu aa tanda a bagulisi mu tempele</para>
  <para style="r">(<ref loc="MRK 11:15-19">Male 11:15-19</ref>; <ref loc="LUK 19:45-48">Luk 19:45-48</ref>; <ref loc="JHN 2:13-22">Joa 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Jesu kale ga ngina mu tumpetu to tempele mi kale ga tandila kunze a bantu bonse aba ka ba gula no ku gulisa i bimunantu byo ku tendisa i bitagilo. Kale ga gwisa-gwisa a matafule go bantu aba ka ba cinca a masheleñi mane no bikalo byo bantu ka ba gulisa u tunkwilimba. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Jesu kale ga ba ta nage, “Mu Mañolo mbuti ku ñolelwe buti, ‘Injugo jangu kuti na ji kugigwe buti ni njugo jo malapelelo,’<note caller="+" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="ISA 56:7">Isaya 56:7</ref>.</char></note> kono inwe mwa sa ji tenda ‘a malibiko go basa!’<note caller="+" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="JER 7:11">Jelemiya 7:11</ref>.</char></note> ”<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />A baofu na ba ta ka ba gola uku jenda nenja kale ba keza kwa Jesu mu tempele, mi kale ga ba oza. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />A mapulisiti a bakulu no bazigi bo mulao, kale ba bona a mamakazo ga komokwisa mane no ku shugwa a banuke aba ka ba kumbagana mu tumpetu to tempele buti, “Ku lumbigwe Nyambe kebaka lya mwana Deviti,” kale ba ba nyegelela.<verse eid="MAT 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16" />Kale ba buza Jesu nabo, “U li shugwile ibi ba ta baba a banuke?”</para>
  <para style="p" vid="MAT 21:16">Jesu kale ga ba taba nage, “Ee, ka mu sini uku bala mu Mañolo aga ga co buti, ‘Na gwa ziga a banuke no bacece uku wa a malumbo kwa Nyambe.’<note caller="+" style="x"><char style="xo" closed="false">21:16 </char><char style="xt" closed="false"><ref loc="PSA 8:2">Nimbo 8:2</ref>.</char></note> ”<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Jesu kale ga bogola ku munzi gwa Bbetaniya no ka lalako.<verse eid="MAT 21:17" /></para>
  <para style="s">Jesu aa kuntwila i cishamu co mulya-nshwi</para>
  <para style="r">(<ref loc="MRK 11:12-14">Male 11:12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />A masiku-siku Jesu aa ka bogola ku munzi gwa Jelusalema, se ka fwite injala. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Kale ga bona i cishamu co mulya-nshwi ici ka ci zimene kumbali no nzila. Kale ga jako kono takuli ici na ga ka gwanako mbwita a mani bulyo. Cwale Jesu kale ga ta ceco i cishamu nage, “To si aki i biyango kame!” Aobulyo i cishamu kale ca boba.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />A bazigigwa kale ba komokwa aa ba bona bulyao mi kale ba buza nabo, “Mbuti ci la bobeli wangu ceci i cishamu co mulya-nshwi?”<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />Jesu kale ga ba ta nage, “Mbyaconse ndi mi lugwila buti ati na mu zumina mi ta mu mamanyi, mu la gola uku tenda ibi bi la tendigwa ko ku ku cishamu co mulya-nshwi. Ka mu gola uku ta leli ilundu buti, ‘U nyukuke no ka gwila mwiwate,’ mi ka ku mana ku tendaala bulyao. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Ati na mu zumina, kuti na mu tambule ici mu kumbila conse mu ntapelo.”<verse eid="MAT 21:22" /></para>
  <para style="s">A mapulisiti aa ba buza Jesu <optbreak />uku ka ji zwa inguzu jakwe</para>
  <para style="r">(<ref loc="MRK 11:27-33">Male 11:27-33</ref>; <ref loc="LUK 20:1-8">Luk 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Jesu kale ga ngina mu tumpetu to tempele no ka tatika uku ziga. A mapulisiti a bakulu no bakulu bo bantu kale ba keza kwakwe. Mi kale ba mu buza nabo, “Ni nguzu ja buti ji ku tendisa byonse byebi i bintu? Ndini na ga ku wa inguzu jejo?”<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Jesu kale ga ba taba nage, “Kuti ndi mi buze ibuzi lyonke tanzila neme, mi sa ka mu ndi tabe nko kuti ndi mi lugwile uku ji zwa inguzu ji ndi tendisa byebyo i bintu.” <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Jesu kale ga ba buza nage, “Inkolobezo ja Joani nkwigulu ka ji zwa indi ku bantu?”</para>
  <para style="p" vid="MAT 21:25">Kale ba li gambaguza mwalyabo nabo, “Sa ka tu mu te buti, ‘Kwigulu ka ji zwa’ a mane ku tu ta buti, ‘Ncinzi aa ta na mwa mu zumina Joani?’ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Kono kame sa ka tu mu te buti, ‘Nku bantu ka ji zwa’ twa sa joga bantu kakuli ba li zumine buti Joani ka li muboni gwa Nyambe.”<verse eid="MAT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27" />Kale ba taba Jesu nabo, “Ta tu zekelele.”</para>
  <para style="p" vid="MAT 21:27">Jesu kale ga ba taba nage, “Neme ta ndi mi lugwile uku ji zwa inguzu ndi litusisa mu ku tenda byebi i bintu.”<verse eid="MAT 21:27" /></para>
  <para style="s">Inguli jo bana bo bile bo baninzana</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />Jesu kale ga ba buza nage, “Mbuti mu gajila? Nko ka li unkosi ka kwesi a bana bo bile bo baninzana. Kale ga ta mukulwa-muntu nage, ‘Mwanangu, shunu u ka sebeze mwigwa.’<verse eid="MAT 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29" />“Jojo muninzana kale ga taba nage, ‘Inga, ta ndi ku je.’ Kono kame kale ga gaja nenja mi kale ga jako.<verse eid="MAT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30" />“Jojo unkosi kale ga ta mwanca-muntu nage, ‘U jende kwigwa.’ Kono ige kale ga taba isi nage, ‘Ee, tata kuti ndi jeko.’ Kono ta na ga jako.”<verse eid="MAT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31" />Jesu kale ga ba buza nage, “Kwa babo a bana bo bile, njwibo na ga kutika isi?”</para>
  <para style="p" vid="MAT 21:31">Abo kale ba mu taba nabo, “Jojo gwe tanzi.”</para>
  <para style="p" vid="MAT 21:31">Jesu kale ga ba tansulwila ibi ka ji julika jejo inguli nage, “Mbyaconse ndi mi lugwila buti, a batentesi no banakazi bo cise kuti na ba ka ngine mu mubuso gwa Nyambe inwe na mu sini. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Kakuli Joani u mukolobezi sa keza ku mi sunda inzila ji lulikile, kono ta na mwa zumina kwakwe, kono a batentesi no banakazi bo cise abo na ba zumina kwakwe. Nanga aa ka mu biwene bi tendaala, na mwa kana uku siguluka no ku zumina kwakwe.”<verse eid="MAT 21:32" /></para>
  <para style="s">Jesu aa gamba byo nguli jo balimi a babi</para>
  <para style="r">(<ref loc="MRK 12:1-12">Male 12:1-12</ref>; <ref loc="LUK 20:9-19">Luk 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Jesu kale ga ba ta kame nage, “Mu tegeleze ndi mi lugwile inguli jimwinya. U mulimi jumwinya sa lima igwa lya veine, mi kale ga li tula mu lubaga. Mi kale ga sa ilambo lyo ku kabila u lukau no ku jaka i tawala o ku lindila mi kale ga leka lelyo igwa ku balimi bamwinya no ku ja mu lujendo. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />A nako jo ku zimbula, u mwini gwa kale ga tuma a baika bakwe buti ba ka mu indile ku lukau.<verse eid="MAT 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35" />“Kono a bauneli kale ba kwata babo a baika, mi kale ba kaba jumwinya, jumwinya kale ba mu yaga mi gwa tatu kale ba mu sobagula ko mabwe. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />U mwini gwa kale ga tumako a baika a bangi ku ita betanzi, kono nabo kale ba ka tendigwa bulyao. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Ku mamaninino, u mwini igwa kale ga tumako mwane na gaja buti, ‘Wawa ige kuti na ba ka mu kutike.’<verse eid="MAT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38" />“Kono a bauneli aa ba mu bona kale ba li gambaguza mwalyabo nabo, ‘Uju nde mujoboli, ndokweni tu mu yage buti tu jobole igwa!’ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Kale ba mu kwata no ku mu kokela kunze jegwa no ka mu yagilako.”<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />Jesu kale ga ba buza nage, “Mbuti mu gajila ubu ka keza ku tendela u mwini igwa kwa babo a bauneli aa ka keza ku sika?”<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />Babo A bajendesi kale ba taba Jesu nabo, “U mwini igwa ka mana keza ku ba yaga babo a bauneli a babi no ku tulamo a bauneli a bangi aba sa ka ba mu letelange u lukau ulu lu mu botele a nako jo ku zimbula.”<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Jesu kale ga ba buza nage, “Ta se mu bala mu Mañolo aga ga ñoletwe buti,</para>
  <para style="b" vid="MAT 21:42" />
  <para style="q1" vid="MAT 21:42">‘Ibwe na ba kana a bajaki</para>
  <para style="q2" vid="MAT 21:42">ndebwe na lya ba lyo nsumpo.<note caller="+" style="f"><char style="fr" closed="false">21:42 </char><char style="ft" closed="false">Ibwe ndya ku koza sinagwe ncishamu co ku sumpisa injugo. Kakuli a majugo getu no bishamu tu ga sumpisanga ta li mabwe. </char></note></para>
  <para style="q1" vid="MAT 21:42">Nu Mfumu Nyambe na ga bi tenda</para>
  <para style="q2" vid="MAT 21:42">mi bi la komokwisa mu mensho getu.’<note caller="+" style="x"><char style="xo" closed="false">21:42 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">Nimbo 118:22-23</ref>. </char></note><verse eid="MAT 21:42" /></para>
  <para style="b" />
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />“Mi nda sa mi lugwila buti u mubuso gwa Nyambe kuti na gu indigwe kwenu no ku gu wa a bantu aba na ba lete i biyango i bilotu. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />U muntu gense uju na gwile a leli ibwe, kuti na colauke mu tu tuntula, mi u muntu gense uju na li gwile kuti na li mu sage.”<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />A mapulisiti a bakulu no Bafalisi aa ba shugwa jejo inguli ja Jesu, kale ba nangula buti Jesu mbabo ka ta. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Kale ba shaka a kaito bo ku mu shuminina kono kale ba joga a bantu a bangi aba se ka ba zumine buti Jesu muboni gwa Nyambe.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Inguli jo mukiti go maseswa</para>
  <para style="r">(<ref loc="LUK 14:15-24">Luk 14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Jesu kale ga ba gambaguza a manguli gamwinya kame nage, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“U mubuso gwa kwigulu ngwa ku koza u mfumu uju na ga tendela mwane u mukiti go maseswa. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Kale ga tuma a baika bakwe buti ba ka zibise a bantu aba na ba kugigwa. Kono bonse kale ba kana uku kezako!<verse eid="MAT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4" />“Kame kale ga ba tumina a baika bamwinya buti ba ka ba lugwile buti, ‘I bintu byo mukiti bi la zukili. A mapulu gangu no ñombe jimwinya jo ku nuna ji la yagigwa, mi i bintu byonse se bi li lulikile. Mu keze ku mukiti go maseswa!’<verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />“Kono babo a bantu kale ba kana no ku lijila u kungi, jumwinya kwigwa lyakwe, jumwinya ku bigulisantu byakwe. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Bamwinya kale ba kwata a baika aba na ba tumigwa, ku ba talula mane no ku ba yaga. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Jojo u mfumu kale ga lunguka lwini, mi kale ga tuma a masole bakwe ka yaga babo a bantu aba na ba yaga a baika bakwe no ku tenta u munzi gwabo.<verse eid="MAT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8" />“Kale ga lugwila a baika bakwe nage, ‘U mukiti segwe ku tatika mi a bantu na nda kuga ta gu ba botele. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Cwale mu jende mu mazila mi mu ka kugile gense uju sa ka mu ka gwane ku mukiti.’ <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />A baika kale ba ja mu mazila no ku gwanika a bantu bonse aba ka ba gola uku gwana, a balotu no babi, buti mane injugo u mu ka gu tendelwa u mukiti kale ja vumba a banyenda.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />“Kono u mfumu aa keza ku nginamo buti a bone a banyenda, kale ga nangula buti nko ka li unkosi uju ta ka zwesi i bizwato ibi bi botelele a mukiti go maseswa. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Kale ga mu buza nage, ‘Musele, ncinzi aa u gwanaala mo muno bu zwesi i bizwato ta bi botele a mukiti go maseswa?’ Kono jojo unkosi kale ga bula i cigambo.<verse eid="MAT 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13" />“U mfumu kale ga ta a batusi bakwe nage, ‘Mu shumine joju unkosi ku maganja no ku matende mi mu mu showele kunze, mu kansindwe u mu na ku ka be a malilo no ku kweka a meno.’<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />“Kakuli aba ba kugigwa mbangi, kono aba ba shaligwa mbace.”<verse eid="MAT 22:14" /></para>
  <para style="s">Byo ku tenteka</para>
  <para style="r">(<ref loc="MRK 12:13-17">Male 12:13-17</ref>; <ref loc="LUK 20:20-26">Luk 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />A Bafalisi kale ba gwanana ku gaja ubu ka ba golela uku kwatila Jesu mu bigambo byakwe. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Kale ba tuma kwa Jesu a bazigigwa babo no batusi ba Eloda. No ka mu ta nabo, “Muzigi, tu li zekelele buti u la sepaala. Mi gwa sa ziga inzila ja Nyambe ku ja ko niti. Kame to azi ku ku shala a bantu. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Tu lugwile elu, mbuti u gajila? Tu li botele uku tenteka i mitenteko kwa Sesale indi ta tu botele?”<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Kono Jesu kale ga ziba i bigajantu byabo i bimangoju mi kale ga ba taba nage, “Inwe mwe bantu bo mantu! Ncinzi aa mu ndi jeleka sinagwe ni ntezo mu ndi tega buti mu ndi gwanine a kaito ko ku ndi kwata? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Mu ndi sunde isheleñi lyo mutenteko.” Kale ba mu wa isheleñi lyo buwaya-waya. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Jesu kale ga ba buza nage, “I cifateo ne zina bilyaa mbyani?”<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />Kale ba mu taba nabo, “Mbya Sesale.”</para>
  <para style="p" vid="MAT 22:21">Ige kale ga ba ta nage, “Mu we Sesale ibi bi botele Sesale, mi mu we Nyambe ibi bi botele Nyambe.”<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Aa ba shugwa bulyao kale ba komokwa mi kale ba mu leka na ba ka li jila.<verse eid="MAT 22:22" /></para>
  <para style="s">Jesu aa buzaguligwa a ntaba jo mbuko jo bafu</para>
  <para style="r">(<ref loc="MRK 12:18-27">Male 12:18-27</ref>; <ref loc="LUK 20:27-40">Luk 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Mwa lelyo ijuba, a Basaduki kale ba keza kwa Jesu. A Basaduki mbantu ka ba zumina buti takuli imbuko jo bafu. Kale ba mu buza nabo, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />“Muzigi, Mushe sa tu ta buti, ‘Ati unkosi na fwa uku ta la gwani a bana, mwancegwe a sese jojo umfwilwa no ku bonako a bana buti a letele nyandi u luasi.’ <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Cwale nko ka ba li a bana ba 7 kwetu aba ba zwa ivumo lyoke, nkulu jabo kale ga sesa mi kale ga fwa uku ta kwesi u mwana kale ga lekela mwancegwe mukazi gwakwe. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Kono nage kale ga fwa mi mwancegwe kale ga sesa umfwilwa kono kame kale kwa tendaala bulyao mane bonse ba 7 na ba kwana. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Ku mamaninino nage u mwanakazi kale ga fwa. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Ngo tu lugwile, a mbuko jo bafu jojo u mwanakazi kuti na be gwani kakuli bonse ba 7 se ba mu sesa?”<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Jesu kale ga ba taba nage, “Mu li fosete kakuli ta mu shugwilisi nenja a Mañolo kampa inguzu ja Nyambe. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Kakuli ku mbuko jo bafu a bantu ta na ba sese no ku sesigwa, kakuli a bantu kuti na ba koze a mañiloi ga kwigulu. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Kono a ntaba jo mbuko jo bafu, ta se mu bala ubu sa mi tela Nyambe buti, <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘Ndime Nyambe gwa Abbulaama, Nyambe gwa Isaka no Nyambe gwa Jakobo’<note caller="+" style="x"><char style="xo" closed="false">22:32 </char><char style="xt" closed="false"><ref loc="EXO 3:6">Lujendo 3:6</ref>.</char></note>? Nko ku ta buti, Nyambe ta li ngwa bafu kono ngwa bomi.”<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />A bantu a bangi aa ba shugwa bulyao, kale ba komokwa ku bintu ka ziga Jesu.<verse eid="MAT 22:33" /></para>
  <para style="s">Byo mulao u munene</para>
  <para style="r">(<ref loc="MRK 12:28-34">Male 12:28-34</ref>; <ref loc="LUK 10:25-28">Luk 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Kono a Bafalisi aa ba shugwa buti Jesu na ga ombeleza a Basaduki ko mutabilo gwakwe, kale ba gwanana. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Jumwinya gwabo uju ka zekelele nenja byo mulao, kale ga mu jeleka ko ku mu buza buti,<verse eid="MAT 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 22:36" />“Muzigi, u mulao u munene ku ita jimwinya mu Mulao ngwibo?” <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />Jesu kale ga taba nage, “ ‘U shake Mfumo Nyambe gwako, ko mojo gwako gonse no ko muuja gwako gonse mane no ko ngana jako jonse.’<note caller="+" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="DEU 6:5">Mulao 6:5</ref>.</char></note> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Gogu ngo mulao gwe tanzi mi ngo munene. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Gwa bili ngwa ku li koza nago ugu gu ta buti, ‘U shake uju u bambene nage sinagwe ubu u li shakila.’<note caller="+" style="x"><char style="xo" closed="false">22:39 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Livitike 19:18</ref>.</char></note> <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />U mulao gonse gwa Mushe mane no baboni ba Nyambe mpaa bi li zingite a jeji i milao jo bile.”<verse eid="MAT 22:40" /></para>
  <para style="s">Jesu ndi mwanani?</para>
  <para style="r">(<ref loc="MRK 12:35-37">Male 12:35-37</ref>; <ref loc="LUK 20:41-44">Luk 20:41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />A Bafalisi aa ka ba gwanene antu-onke, Jesu kale ga ba buza nage, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />“Mbuti mu gajila bya Kilesite buti, ndi mwanani?”</para>
  <para style="p" vid="MAT 22:42">Kale ba taba nabo, “Ndi mwana Deviti.”<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Jesu kale ga ba taba nage, “Ncinzi elu ka ci gambisa Deviti ko Moya aa ka mu kuga buti, ‘Mfumwangu?’ Kakuli Deviti sa ta buti,<verse eid="MAT 22:43" /></para>
  <para style="b" />
  <para style="p">
    <verse number="44" style="v" sid="MAT 22:44" />“ ‘U Mfumu Nyambe sa ta kwa Mfumwangu buti, u kale ku mulyo gweganja lyangu ku twala aa na ndi ka golele aba ba ku zimbite buti na ba be kwinsi lyako, sinagwe malyatilo go matende.’<note caller="+" style="x"><char style="xo" closed="false">22:44 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Nimbo 110:1</ref>.</char></note><verse eid="MAT 22:44" /></para>
  <para style="b" />
  <para style="p">
    <verse number="45" style="v" sid="MAT 22:45" />“Ati Deviti ga sa mu kuga, ‘Mfumwangu’ cwale u Mushaligwa mbuti a golela uku ba mwana Deviti?” <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Takuli uju ka gola uku mu taba. Mi ku zwa lelyo ijuba takuli uju ka li gongoza uku mu buza cimwinya kame.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Jesu aa nanguza a bantu no bazigigwa bakwe</para>
  <para style="r">(<ref loc="MRK 12:38-39">Male 12:38-39</ref>; <ref loc="LUK 11:43">Luk 11:43</ref>,<ref loc="LUK 11:46">46</ref>; <ref loc="LUK 20:45-46">20:45-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Jesu kale ga gamba ku bantu a bangi mane no bazigigwa bakwe nage, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />“A bazigi bo mulao no Bafalisi ba li zekelele u mulao mi mu cikalo ca Mushe ba kele.<note caller="+" style="f"><char style="fr" closed="false">23:2 </char><char style="ft" closed="false">I cikalo ca Mushe ca sa toloka buti ni nguzu jakwe.</char></note> <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Cwale mu tende no ku kutika byonse i bintu ibi ba mi lugwila kono mu leke uku umpilila i bitendantu byabo. Kakuli ta ba tendi i bintu ba tandaza. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Ba sa kolekisa a bantu i mizigo jo ku lema kono abo na ba kanite uku kwatako nanga no munwe buti ba ba ubisizeko.<verse eid="MAT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5" />“I bintu ba tenda byonse mba ku bi tenda buti a bantu ba ba bone. Basa shumina u tukwama u tunene a makumo gabo no a maboko umu ku li a Mañolo no ku zwata i mikanjo uku ku shumangilwe utuala u tule utu tu zela-zela ku mingundo. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Mba ku suna lwini uku kala mu bibaka ibi bi kutekea mu mikiti no mu bikalo byo butokwa mu majugo go malapelelo go Majuda. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />Mba ku shaka uku zuminizwa aa ba ita mu bibaka byo magulikizo no ku kugigwa ku bantu buti ‘Muzigi.’<verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />“Mu leke uku zuminina u muntu uku mi kuga buti ‘Muzigi,’<note caller="+" style="f"><char style="fr" closed="false">23:8 </char><char style="ft" closed="false">A mabuka gamwinya ndi Labbi na ba ñola.</char></note> kakuli mwense muzigi genke bulyo mu kwesi mi ta mu andene ko ku ba a bankosi no banakazi. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Kame na mu leke uku kuga u muntu gense buti ‘Tata’ aano ansi, kakuli ndi Senu genke mu kwesi mi nkwigulu a li. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Mi mu leke uku zumina u muntu gense uku mi kuga buti ‘bajendesi’, kakuli Mujendesi genke bulyo mu kwesi, mi ndi Kilesite. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />U munene mukati kenu kuti na be u muika. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Mi a bantu aba ba li kulisa, kuti na ba gombaazwe mi aba ba li gombaaza, kuti na ba kulisigwe.<verse eid="MAT 23:12" /></para>
  <para style="s">U bumpai bo Bafalisi no bazigi bo mulao</para>
  <para style="r">(<ref loc="MRK 12:38-39">Male 12:38-39</ref>; <ref loc="LUK 11:43">Luk 11:43</ref>,<ref loc="LUK 11:46">46</ref>; <ref loc="LUK 20:45-46">20:45-46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />“U bumpai mbwenu inwe mwe bazigi bo mulao nenwe mwe Bafalisi, inwe mwe bantu bo mantu! Kakuli mwa sa galila a bantu a kaito ko mubuso gwa kwigulu. Inwe ta mu nginimo kame aba ba shaka uku nginamo se mu la ba binda. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />Mu li bampai wawa inwe mwe bazigi bo mulao nenwe mwe Bafalisi. Kakuli mwa sa omenena a bamfwilwa mi mwa sa ba ibila i bintu bi li mu majugo gabo, no ku ba oma-oma ko ku tagama bu ba lapelela. Ko ku tenda bulyao kuti na mu atuligwe ko bukababu wawa.<note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">A mabuka go Cigelike gamwinya no mabuka gamwinya ta ga kwesi intimana ja 14.</char></note><verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />“U bumpai mbwenu mwe bazigi bo mulao nenwe mwe Bafalisi kakuli mu li bantu bo mantu! Mi mwa sa luta a mawate mane no ku konshokanya a malonga buti mu gwane u muntu nanga genke mi aa se mu la mu gwani sa la ba u muumpilili, mi se mu la mu kokela mwileba lyo mulilo ko bile sinagwe ubu mu kalile.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />“U bumpai mbwenu mwe bajendesi kakuli mu li baofu! Inwe mu ta buti, ‘U muntu nanga na konka ko ku lumbululanga i tempele,’ mwa sa ta buti takuli u bukababu, kono aa konka ko ku lumbulula u butale bwa gauda bwa mu tempele jojo muntu a li shuminwe ko bulikonki bwakwe. <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Mu li bagelo kame mu li baofu. I cinene ncibo, ndi tempele kampa mbutale bwa gauda? Kakuli i tempele njejo ji cenesa u butale bwa gauda. <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Mi kame mwa sa ta buti, ‘U muntu nanga na konka ko ku lumbululanga u lutala, takuli u bukababu,’ kono u muntu aa konkaika ko ku litusisa i bitagilo ibi bi li a lutala, a li botele uku tenda bulyao kakuli a la likonki. <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Inwe mu li baofu wawa, co butokwa ncibo, ncitagilo ci li a lutala kampa ndutala ulu lu cenesa i citagilo? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Aa mu konkaika ko ku litusisa u lutala, kale mwa konka ko lutala no bintu byonse ibi bi lio. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Mi aa mu konka ko ku lumbululanga i tempele, kale mwa konka ko tempele mane no Nyambe uju a kalamo. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Kame aa mu konka ko ku lumbululanga ‘igulu,’ kale mwa konka ko ku litusisa i cikalo co bumfumu ca Nyambe, mane kale mwa konka no kakwe uju a kele mu cikalo co bumfumu.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />“U bumpai mbwenu mwe bazigi bo mulao mane nenwe mwe Bafalisi kakuli mu li bantu bo mantu! Mi mwa sa twalikiza bulyo ingana ku ku wanga ce kumi ku mani go bisiu bya mu lugwa lwenu kono ta mu twalikizi ingana ku bintu byo butokwa ibi gu ta u mulao byonse, inkatulo iji ji lulikile, inse mane no ku sepaala. Ka mu botele uku tenda i bintu bya shunu-aano, uku ta mu shwauzi byo kale. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Inwe mwe bajendesi a baofu, mu la kutogolanga i biuka mu menzi buti mu leke ku bi nywa ko ku sa ziba, kono inwe na mu mina i bintu i binene bi sika a nkamele, uku na mu fungilebo.<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />“U bumpai mbwenu inwe mwe bazigi bo mulao nenwe mwe Bafalisi kakuli mu li bo mantu! Mbulyo mu twalikizanga ingana ku ku sanza inkomoki egulu mane no kasuba bulyao, kono mukati ni nkole ji vumbitemo no ku sa ligunga! <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Igwe gwe Mufalisi u muofu! U sanze inkomoki tanzila no kasuba mukati mi kuti bi cene no egulu.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />“U bumpai mbwenu inwe mwe bazigi bo mulao mane nenwe mwe Bafalisi inwe mwe bantu bo mantu! Se mu li kozete a mabita ga sebwilwe nenja no ku bonaala u bulotu kunze kanti kwinsi mbifuwa byo bafu bi vumbiteko mane no bintu byonse ibi ta bi cenete. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Nenwe bulyao, anze jo mibili jenu mwa sa bonaala sinagwe mbantu ba lulikile, kono mukati ko myojo jenu mantu no bubi bi vumbitemo.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />“U bumpai mbwenu mwe bazigi bo mulao nenwe mwe Bafalisi kakuli mu li bo mantu! Mi mwa sa sebulanga no ku botesa a mabita go baboni ba Nyambe no go bantu ka ba lulikile. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Kame mbuti mu co buti, ‘Ka li nko ka tu li mu nako ka ba liko basukuzetu ta na tu la gwanani nabo mu ku yaga a baboni ba Nyambe.’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Kono ati mbobo mu co mane no ku paka buti mu li bo mukoga gwa babo se ba yaga a baboni ba Nyambe. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Mu leke ku li kalila, kono mu maninine ibi se ba tatika basukuzenu.<verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />“Inwe mwe majoka! Mwe bana bili! Mbuti mu gola uku andila inkatulo jeleba lyo mulilo? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Cwale se ndi la mi tumina a baboni ba Nyambe no bantu bo magano mane no bazigi. Kono kuti na mu yageo bamwinya ko ku ba kankamina mi bamwinya, kuti na mu ba shapile mu majugo go malapelelo go Majuda genu, na mu shensha bamwinya ku ba lokola mu munzi gumwinya mbwita u ka ba nginika mwa gumwinya. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Ko ku tenda bulyao, a mafu gonse go bantu aba ka ba lulikile aga na ga tendaala ndinwe na mwa ga leta. Ku tatikila ku lufu lwa Abele ku twala ku lufu lwa Zakaliya mwana Bbelekiya, uju na mwa yagila mukati ko tempele no lutala. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Mbyaconse ndi mi lugwila buti, inkatulo ta na ji leke lo luno u luasi.<verse eid="MAT 23:36" /></para>
  <para style="s">Jesu aa lilila u munzi gwa Jelusalema</para>
  <para style="r">(<ref loc="LUK 13:34-35">Luk 13:34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />“Jelusalema, Jelusalema, u mu ku joja a bantu na ba yaga a baboni ba Nyambe no ku sobagula ko mabwe aba na ba tuminwa kwenu! Ka ndi shakite uku gwanika banenu antu-onke sinagwe nu nkuku ubu a gwanikilanga u tusyo twakwe mwinsi lyo mabando gakwe, kono ta ka mu shakite. <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Cwale nga mu lole, injugo jenu se ji li sigele kwenu sinagwe ndi tongo. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Nda sa mi ta buti, ta mu sindi boni kame ku twala aa na mu te buti, ‘Imfwijaguzi njakwe uju a keza mwizina lyo Mfumu Nyambe!’<note caller="+" style="x"><char style="xo" closed="false">23:39 </char><char style="xt" closed="false"><ref loc="PSA 118:26">Nimbo 118:26</ref>.</char></note> ”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">Jesu aa gamba byo ku jonauka <optbreak />ko tempele ja mwa Jelusalema</para>
  <para style="r">(<ref loc="MRK 13:1-2">Male 13:1-2</ref>; <ref loc="LUK 21:5-6">Luk 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Jesu aa ka zwa mu tempele, a bazigigwa bakwe kale ba mu senena no ku mu sundisa i mijako jo tempele. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Kono ige kale ga ba ta nage, “Byonse byebyo mu wene, mbyaconse ndi mi lugwila buti takuli nanga ndibwe lyonke na li sigale bu kumbi kwa limwinya, byonse kuti na bi ulumukile ansi!”<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Ku zwao, Jesu kale ga kala ansi Elundu lya Olive. A bazigigwa ba Jesu kale ba keza kwakwe mu buzinda no ku mu ta nabo, “Tu lugwile, ndusiku nzi na bi tendaale byonse byebi? Ncijuliko ca buti na ci tu sunde buti so la li bonaaza mi kame ngo mamaninino ga je jino inako?”<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Jesu kale ga ba ta nage, “Mu leke uku zumina u muntu buti a mi ungulule, <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />kakuli a bantu a bangi kuti na ba keze mwizina lyangu na ba li ta buti, ‘Ndime Kilesite’ mi kuti na ba ome a bantu a bangi. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Kuti na mu shugwange byo nkondo no maluguzi go nkondo, kono na mu leke uku joga. Ee, byebi bi li botele uku tendaala, kono ta li ngo mamaninino gelonga. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Ilonga kuti na li li lwise nelonga limwinya, mi u mubuso gumwinya kuti na gu li lwise no mubuso gumwinya. Kuti na ku bange no njala mane no ku ukutanga kweevu mu bibaka i bingi byelonga. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Kono byebyo kuti na bi be byo matatikilo bulyo go mapenzi.<note caller="+" style="f"><char style="fr" closed="false">24:8 </char><char style="ft" closed="false">A mabuka gamwinya ga sa nungako gogu u mugambilo, “Mi kuti na ku be no kushisha sinagwe nkushisha ko mwanakazi a shaka uku bona u mucece.” </char></note><verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />“Kuti na mu shuminigwange no ku pengisigwa mane no ku yagigwa. A bantu ba mwilonga lyonse kuti na ba mi zimbe kebaka lyangu. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />A bantu a bangi kuti na ba ndi futatile na ba li legeze no ku li zimba mwalyabo. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Kuti na ku keze a baboni bo manya a bangi mi kuti na ba ome a bantu a bangi. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Kakuli u bubi kuti na bu li twala-twale mwilonga lyonse, mi u lushako lo bantu a bangi kuti na lu kujuke. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Kono u muntu uju na li gongoze ku twala ku mamaninino ndege na jojeswe. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Mi gaga a majwi a malotu go mubuso kuti na ga tandazigwe mwilonga lyonse ko ku ba u bupaki ku malonga gonse, nko kuti na ku be no mamaninino.<verse eid="MAT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />“Mi aa na mu bone ‘u bumangoju bu jogisa’<note caller="+" style="x"><char style="xo" closed="false">24:15 </char><char style="xt" closed="false"><ref loc="DAN 9:27">Daniele 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="DAN 12:11">12:11</ref>.</char></note> bo bintu sa gamba u muboni gwa Nyambe Daniele buti se bu li kele mukati ko Cibaka ci Cenete.” (Gwe mubali u nangule!) <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />“A bantu ba mwilonga lya Judeya na ba tigile ku malundu. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />U muntu na gwanaale na li a cituwa na leke uku sezumukila mukati ko njugo jakwe buti aka indemo i cintu. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />U muntu na gwanaale mwigwa na leke uku bogola ku munzi buti a ka inde nanga ncizwato. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />U bumpai mbwa banakazi aba na ba gwanaale bu sumbele kampa aba na ba gwanaale na ba nyonsa mwa gago a majuba. <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Mu lapele buti intigo kwenu na ku leke uku tendaala a mweo kampa lyo Nsabata. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Kakuli jejo inkalilwa inene ta ji la bako ku zwa aa na lya bumbilwa ilonga, mi jejo inkalilwa ta na ji beko kame. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Wawa jejo inako jo makababu ati ta na ji koshokezwe, takuli nanga muntu genke na anduke. Kono kuti na ji fuwimpiswe kebaka lyo bashaligwa ba Nyambe.<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />“Ati u muntu na mi lugwila buti, ‘Nga mu lole, juno nde Kilesite’ kampa ‘Julya ku lya,’ na mu leke uku zumina. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Kakuli a bashaligwa bo manya no baboni bo manya kuti na ba beko na ba tende i bijuliko i binene no bintu bi komokwisa na ba ome nanga mbashaligwa ba Nyambe, ati na ku golaala. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Nga mu lole, se ndi mi nanguza byebi i bintu na bi sini uku tendaala.<verse eid="MAT 24:25" /></para>
  <para style="s">Jesu aa gamba byo bu na ka bogwele</para>
  <para style="r">(<ref loc="MRK 13:24-27">Male 13:24-27</ref>; <ref loc="LUK 21:25-28">Luk 21:25-28</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />“Cwale ati u muntu na mi lugwila buti, ‘Nga mu lole, u Mushaligwa mu mangusu a ka li,’ na mu leke uku jako. Kampa uku ta buti, ‘Juno mu tumpetu,’ na mu leke uku zumina! <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Kakuli sinagwe ndumuni lo mvula lu besa ku buzwe-juba lwa sa ka bonaalila no ku bugwe-juba, mbobo na ku kalile no keza kwangu ime nde Mwana Muntu. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Mi aa ku li citupu, mpaa na ga gwananine a makubi.<verse eid="MAT 24:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />“Aobulyo a majuba go nkalilwa aa se ga la mani,</para>
  <para style="b" vid="MAT 24:29" />
  <para style="q1" vid="MAT 24:29">‘ijuba kuti na li zimange,</para>
  <para style="q2" vid="MAT 24:29">mi u kwezi kuti na ku kangwange uku wa ituba.</para>
  <para style="q2" vid="MAT 24:29">Intungwezi, kuti na ji gwange kwigulu, mi i bintu bya kwigulu kuti na bi ukuswange.’<note caller="+" style="x"><char style="xo" closed="false">24:29 </char><char style="xt" closed="false"><ref loc="ISA 13:10">Isaya 13:10</ref>; <ref loc="ISA 34:4">34:4</ref>.</char></note><verse eid="MAT 24:29" /></para>
  <para style="b" />
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />“Ku mamaninino, i cijuliko co keza kwangu ime nde Mwana Muntu kuti na ci bonaale mwigulu, mi a bantu bonse bo malonga kuti na ba lile. Mi kuti na ba ndi bone ndi keza a majoba gegulu ko nguzu no mpazimo inene. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Mi kuti na ndi tume a mañiloi gangu aga na ga fuze intolombita no ku kugiliza ko ku gongoza, mi kuti na ga gwanike a bashaligwa bakwe ku zwa mu bibaka byone bya ansi, ku zwa ku ncinko jimwinya jegulu ku twala kwa jimwinya.<verse eid="MAT 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />“Mu li zige cimwinya a cishamu co mulya-nshwi. Mu si ci bona se ci tumpila a mani a maya, mu zibe buti imvumbi se ji li li afuwi. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Nenwe aa sa ka na mu bi bone byonse byebi i bintu, na mu zibe buti ime nde mwana muntu se nde ka bogola mi mpa cizi se ndi li. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Mbyaconse ndi mi lugwila buti, a bantu ba lo luno u luasi ta na ba junde uku na bi sini uku tendaala byebi i bintu byonse. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Igulu nelonga kuti na bi mane kono a majwi gangu ta na ga mane.<verse eid="MAT 24:35" /></para>
  <para style="s">Mu tonde na mu lindile uku keza kwa Jesu</para>
  <para style="r">(<ref loc="MRK 13:32-37">Male 13:32-37</ref>; <ref loc="LUK 17:26-30">Luk 17:26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />“Nanganceciba bulyao, takuli uju a zekelele ijuba ne nako aa na bi tendaale byebi i bintu, nanga mañiloi ga kwigulu mane nanga ndime nde Mwana Muntu. Ndi Tata bulyo genke ndege a zekelele. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Sinagwe ubu ka ku kalile mu majuba ga Nuwe, mbobo na ku kalile kame aa sa ka na ndi keze ime nde Mwana Muntu. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Kakuli mu majuba aa ka bu sini uku bako u bulobe, a bantu ka ba lya no ku nywa, ku sesa mane no ku sesisa ku twala kwijuba sa ngina Nuwe mwa aleka.<note caller="+" style="f"><char style="fr" closed="false">24:38 </char><char style="ft" closed="false">aleka, mbwato u bunene wawa ubu sa panga Nuwe a maala.</char></note> <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />A bantu ta ka ba zekelele ici ka ci botele uku tendaala mbwita u bulobe aa se bu la biko no ku ba lobeza bonse. Mbobo na ku kalile mu nako na ndi keze ime nde Mwana Muntu. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />A bankosi bo bile aba na ba gwanaale na ba sebeza mwigwa, kuti na ku indigwemo genke ku lekamo genke. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />A banakazi bo bile aba na ba gwanaale na ba twa mu kwina, kuti na ku indigweo genke ku lekao genke.<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />“Cwale nenwe mu tonde! Kakuli ta mu zekelele ijuba na ka bogole Mfumwenu. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Mu zibe buti u mwini injugo ka li ne zi buti shunu u musa kuti a ndi ibile, ka mana ku ningama bu tonda buti injugo jakwe ji leke uku tululigwa. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Cwale nenwe bulyao mu litukiseze kakuli ime nde Mwana Muntu kuti na ndi keze mu nako ta mu lindile.<verse eid="MAT 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />“U muika a sepaala ige na kwesi a magano, mfumwe a la gola uku mu wa u bujendesi bo ku jendesa a baika bamwinya mane no ku ba wanga i bilyo mu nako ji botete. <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Kuti na ku be u bulotu kwa jojo u muika mfumwe aa mu gwana a tenda bulyao aa ka bogola. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Mbyaconse ndi mi lugwila, jojo mfumwe kuti na mu tule a bujendesi bo bintu byonse ibya kwesi. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Kono bunga jojo u muika mubi mi sa la gaja buti mfumwangu kuti na ka tagame uku na ga ja, <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />mi sa la tatika uku kaba a baika bagenze, ku tenda u mukiti no ku nywa no bidakwa, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />mfumwe gwa jojo u muika kuti na keze mwijuba ili ta mu lindile no mu nako iji ta zekelele. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Mi kuti na mu koshagule mu bituntula no ku mu shonjela mu cibaka co bantu bo mantu, u mu na ku be a malilo no ku kweka a meno.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">Inguli jo balyansho be kumi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />“Mwa jejo inako u mubuso gwa kwigulu kuti na gu koze sinagwe mbalyansho be kumi aba na ba inda a malambi gabo no ku cengamina u musesi. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Ba 5 babo, ka ba li bagelo mi ba 5 ka ba li bo magano. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Ba 5 a bagelo na ba inda a malambi gabo, kono ta na ba inda a mafuta gamwinya ga ambali. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Bo magano kale ba inda a malambi gabo no mafuta gamwinya mu tuzunga. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />U musesi kale ga ka nangisa uku keza, mi bonse kale ba sukula mi kale ba lala.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />“Akati ko masiku, kale kwa shugwaala a kakumbo ka kugiliza buti, ‘Juno ndo musesi! Mu keze mu mu cengamine!’<verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />“Mi a balyansho bonse kale ba buka no ku jakiza a malambi gabo. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />A bagelo, kale ba ta ku bo magano nabo, ‘Nga mu tu we ku mafuta genu gamwinya, a malambi getu se ga la zima.’<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />“Kono abo kale ba taba nabo, ‘Inga, ta tu kwesi a mafuta aga ga gola uku tu kwana twense iswe nenwe. Mu jende ku bagulisi bo mafuta mu ka ligulile genu.’ <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Kono aa ka ba si li mu nzila ku ka gula a mafuta, u musesi kale ga sika. A balyansho aba ka ba li bambite kale ba ngina nage umu ka ku tendelwa u mukiti go maseswa. Mi i cizi kale ca galigwa.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />“Mwishule bamwinya nabo kale ba keza, kale ba ta nabo, ‘Mfumwetu! Mfumwetu! U tu galwile i cizi!’<verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />“Kono kale ga ba taba nage, ‘Mbyaconse ndi mi lugwila, ta ndi mi zi.’<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />“Cwale mu tonde, kakuli ta mu zekelele ijuba kampa inako.<verse eid="MAT 25:13" /></para>
  <para style="s">Inguli jo baika bo tatwe</para>
  <para style="r">(<ref loc="LUK 19:11-27">Luk 19:11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />“Kame kuti na ku be sinagwe muntu uju sa ja mu lujendo. Kale ga gwanika a baika bakwe no ku ba wa inguzu jo ku babalela u lubono lwakwe. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Kwa jumwinya kale ga wa a masaka ga 5 go buwaya-wawa.<note caller="+" style="f"><char style="fr" closed="false">25:15 </char><char style="ft" closed="false">Mu mabuka go kale go Cigelike, ka ba litusisanga italenta ngago ka ga li masheleñi gabo. Mi italenta ka ga li masheleñi a mangi aga ga kwesi u bulemenezi bu sika a 34 u muntu ka gola uku ga sebeleza a myaka ja 20.</char></note> Gwa bili kale ga mu wa a masaka go bile go buwaya-waya. Gwa tatu kale ga mu wa isaka lyonke lyo buwaya-waya. Kale ga wa u muntu no muntu ku ja ko bu a golela mi kale ga li jila mu lujendo lwakwe. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />U muika uju na ga tambula a masaka ga 5 go buwaya-waya, kale ga ga sebelisa mi kale ga gwaninao ga 5 go buwaya-waya. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />No muika go masaka go bile go buwaya-waya, kale ga gwaninao gamwinya go bile go buwaya-waya kame. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Kono u muika uju na ga tambula isaka lyonke lyo buwaya-waya, kale ga sa ilambo mwivu no kubikamo isaka lya mfumwe.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />“Aa se ku la iti inako inde, u mfumu gwa babo a baika kale ga ka bogola, mi kale ga li gambaguza nabo ubu na ba gwanina. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />U muika uju na ga tambula a masaka ga 5 go buwaya-waya, kale ga ta nage, ‘Mfumwangu, so ndi wa a masaka ga 5 go buwaya-waya mi na nda gwaninao inkambikile jo masaka ga 5 go buwaya-waya.’<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />“Mfumwe kale ga ta nage, ‘Na gwa tenda nenja, gwe muika u mulotu noju a sepaala! Kakuli na gwa sepaala ku bintu i bice, cwale kuti na ndi ku tule a bujendesi bo bintu i bingi. U keze tu jangale antu-onke!’<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />“U muika uju na ga wegwa a masaka go bile, kale ga ta nage, ‘Mfumwangu, so ndi wa a masaka go bile go buwaya-waya mi ngo lole na nda gwaninao a masaka go bile kame.’<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />“Mfumwe kale ga mu ta nage, ‘Na gwa tenda nenja, gwe muika u mulotu noju a sepaala, na gwa sepaala ku bintu i bice, kuti na ndi ku tule a bujendesi bo bintu i bingi. U keze tu jangale antu-onke.’<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />“Cwale u muika uju na ga tambula isaka lyonke lyo buwaya-waya kale ga ta mfumwe nage, ‘Mfumwangu, ka ndi zi buti u li muntu u mukababu, uju a zimbula u mu ta na gwa byala no ku gwanika u mu ta na gwa mwagila i mbuto. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Mi ka ndi jogete mpa na nda bika isaka lyako lyonke lyo buwaya-waya mwivu. Ngolole, i bintu byako ibi.’<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />“Mfumwe kale ga taba nage, ‘Igwe gwe muika u mubi, no bukata! Ko zekelele buti ndi li go ku zimbulanga umu ta na nda byala no ku gwanika umu ta na nda mwagila i mbuto, <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />elu ko botele uku tula a masheleñi gangu ku babiki bo masheleñi buti aa na ndi la ka bogoli na ndi la ga tambuli no nkambikile.’<verse eid="MAT 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28" />“Jojo mfumwe kale ga ta nage, ‘Mu mu tape isaka lyo buwaya-waya mi mu li we jojo a kwesi a masaka go buwaya-waya ge kumi. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Kakuli u muntu gense uju a kwesi, kuti na kwate i bingi. Kono uju ta kwesi, kuti na tapigwe nanga ici a kwesi. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Cwale jojo u muika uju ta kwesi intuso, mu mu shonjele kunze mu kansindwe, uku na ku be no malilo no ku kweka a meno.’<verse eid="MAT 25:30" /></para>
  <para style="s">Inkatulo jo mamaninino</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />“Kono ime nde Mwana Muntu aa na ndi keze mu mpazimo jangu no mañiloi gonse, kuti na ndi kale a cikalo cangu ci pazima. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />A bantu bo malonga gonse kuti na ba gwanikigwe a fuwi neme mi kuti na ndi ba tae sinagwe mulisani ubu a tailanga ingu ku ji zwisa ku tupuli. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Kuti na ndi tule ingu ku mulyo gweganja lyangu no tupuli kuti na ndi tu timbile ku monsho gweganja lyangu.<verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />“Mi ime nde Mfumu kuti na ndi te ku bantu na ba be ku mulyo gwangu neme, ‘Mu keze, inwe na mwa wegwa imfwijaguzi kwa Tata, mu jobole u mubuso ugu na mwa lukisezwa ku zwa ku mbumbo jelonga. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Kakuli ka ndi fwite injala, kale mwa ndi wa cimwinya co ku lya, ka ndi fwite inyotwa, mi na mwa ndi wa i cinywantu. Ka ndi li nyenda mi na mwa ndi tambula. <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Mbizwato ka ndi shaka, kale mwa ndi wa i bizwato. Ka ndi li mulwele kono na mwa ndi babalela. Ka ndi li mu ntolongo mi na mwa keza ku ndi bona.’<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />“Mi a bantu aba ba lulikile kuti na ba mu tabe nabo, ‘Mfumwetu, ndusiku nzi na twa ku bona no fwite injala mi kale twa ku wa i cilyo? Kampa no fwite inyotwa mi kale twa ku wa i cinywantu? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Ndusikunzi na twa ku bona no li nyenda mi kale twa ku tambula? Kampa no bulite i bizwato mi kale twa ku wa i bizwato? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Ndusikunzi na twa ku bona buti u li mulwele kampa mu ntolongo u li mi kale twa ka ku bona?’<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />“Mfumwabo kuti na tabe buti, ‘Mbyaconse ndi mi lugwila buti, aa ka mu tenda byebyo ku bakwangu a bashwauki, nkwangu ka mu bi tenda!’<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />“Cwale u Mfumu kuti na te babo ba li ku monsho gwakwe nage, ‘Mu zwe kwangu inwe mu kutitwe, mu je mu mulilo ta gu zimi ugu na gwa lukisezwa Satani no mañiloi gakwe. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Kakuli ka ndi fwite injala, mi ta na mwa ndi wa i cilyo. Ka ndi fwite inyotwa mi ta na mwa ndi wa i cinywantu. <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Ka ndi li nyenda mi ta na mwa ndi tambula. Ka ndi shakite i bizwato kono ta na mwa bi ndi wa. Ka ndi li mulwele mi ka ndi li mu ntolongo mi ta na mwa ndi babalela.’<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />“Nabo kuti na ba mu tabe nabo, ‘Mfumwetu ndusiku nzi na twa ku bona no fwite injala kampa inyotwa kampa no li nyenda kampa no shakite i bizwato kampa no li mulwele kampa no li mu ntolongo, mi kale twa kana uku ku tusa?’<verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />“Ige kuti na ba tabe nage, ‘Mbyaconse ndi mi lugwila buti ibi ta na mwa tendela bakwangu a bashwauki, ndime ka mu kana uku tusa.’<verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />“Mi kuti na ba je mu ku bangisigwa uku ta ku mani, kono a bantu aba ba lulikile kuti na ba je ku bumi ta bu mani.”<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">Aa ba gaja bo ku yagila Jesu</para>
  <para style="r">(<ref loc="MRK 14:1-2">Male 14:1-2</ref>; <ref loc="LUK 22:1-2">Luk 22:1-2</ref>; <ref loc="JHN 11:45-53">Joa 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Jesu aa sa la mani uku gamba byonse byebyo, kale ga ta a bazigigwa bakwe nage, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“Sinagwe ubu mu zibile buti se ku li sigalile bulyo a majuba go bile buti u Mukiti go Mpaseka gu tendaale mi ime nde Mwana Muntu kuti na ndi wegwe buti ndi kankaminwe a cifapaano.”<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Mi a mapulisiti a bakulu no bajendesi bo bantu kale ba gwananina mwilapa lyo mupulisiti u mukulu uju ka kugigwa Kayafa, <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />kale ba li gambaguza ubu ka ba botele uku kwatila Jesu mu buzinda no ku mu yaga. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Kale ba li gambaguza nabo, “Tu leke uku mu kwata mu nako jo mukiti kakuli a bantu mane ba lwe.”<verse eid="MAT 26:5" /></para>
  <para style="s">Jesu aa singigwa a mafuta <optbreak />mu munzi gwa Bbetaniya</para>
  <para style="r">(<ref loc="MRK 14:3-9">Male 14:3-9</ref>; <ref loc="JHN 12:1-8">Joa 12:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Jesu aa ka li mu munzi gwa Bbetaniya, mu njugo jo nkosi uju ka kugigwa Simoni go cisenda. <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />Jesu aa ka si lya a ntafule, kale kwa keza u mwanakazi uju ka indite ibotela lya alabbasitela ili ka li vumbite a mafuta ga tula aga ga nunka u bulotu. Kale ga sintila a mafuta go menzi a mutwi gwa Jesu.<verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />A bazigigwa aa ba bona bulyao kale ba nyegela mi kale ba buza nabo, “Nja cinzi jeji injoneko? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Kakuli gaga a mafuta ka li na ga la gulisigwa masheleñi a mangi no ku ga wa a bampale.”<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Kono Jesu kale ga nangula ibi ka ba gamba mi kale ga ba ta nage, “Ncinzi mu tembekela joju u mwanakazi ta mwi zi buti i cintu a la tendi kwangu ncilotu? <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Kuti mu kalange no bampale inako jonse, kono ime ta mu kalange neme inako jonse. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Joju u mwanakazi aa la ndi sintili a mafuta a mubili gwangu kame a la lukisezi uku zikigwa kwangu. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Mbyaconse ndi mi lugwila buti, konse uku na ku ka tandazigwe a majwi a malotu mwilonga lyonse, ibi a la tendi joju u mwanakazi nabyo kuti na bi gambigwe, ku mu vuluka.”<verse eid="MAT 26:13" /></para>
  <para style="s">Judasi Isikaliota aa zumina uku legeza Jesu</para>
  <para style="r">(<ref loc="MRK 14:10-11">Male 14:10-11</ref>; <ref loc="LUK 22:3-6">Luk 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Cwale Judasi Isikaliota jumwinya go bazigigwa ba Jesu be kumi no bo bile, kale ga ja ku mapulisiti a bakulu <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />no ka ba buza nage, “Ncinzi mu shakite uku ndi wa ati na ndi mu mi tambika?” Abo kale ba mu balila a masheleñi go buwaya-waya go makumi go tatwe go cilibela. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Ku zwa momo mu nako, Judasi Isikaliota kale ga shaka-shaka a kaito ko ku kwatisa Jesu no ku mu ba wa.<verse eid="MAT 26:16" /></para>
  <para style="s">U mulalilo go mamaninino</para>
  <para style="r">(<ref loc="MRK 14:12-21">Male 14:12-21</ref>; <ref loc="LUK 22:7-13">Luk 22:7-13</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Joa 13:21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Mwijuba lyetanzi lyo Mukiti go Binkwa Ta bi Umelwe, a bazigigwa kale ba keza kwa Jesu no keza ku mu ta nabo, “Kwibo u shaka buti tu ka ku tendele u mulalilo go Mpaseka?”<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Jesu kale ga taba nage, “Mu je mwa go gulya u munzi u munene ku nkosi jumwinya mi mu ka mu lugwile buti, ‘U muzigi mbuti a co buti, inako jangu mpafuwi se ji li. Kuti ndi kalile u mulalilo go Mpaseka mu njugo jako no bazigigwa bangu.’ ” <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />A bazigigwa kale ba tenda ubu na ga ba tela Jesu mi kale ba ka lukisa i Mpaseka.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />A matengu, Jesu no bazigigwa bakwe be kumi no bo bile kale ba zela intafule.<note caller="+" style="f"><char style="fr" closed="false">26:20 </char><char style="ft" closed="false">Mu cizo co Majuda kame ka ba lyanga bu sendamite.</char></note> <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Aa ka ba kwesi uku lya bulyao, Jesu kale ga ta nage, “Mbyaconse ndi mi lugwila buti jumwinya kwenu kuti na ndi legeze.”<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />A bazigigwa kale ba tompa lwini mi u muzigigwa no muzigigwa kale ga mu buza nage, “Mfumwangu, buti ndime?”<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />Jesu kale ga ba taba nage, “Jumwinya uju a la ñwati antu-onke neme mu kasuba ndege na ndi legeze. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Kakuli ime nde Mwana Muntu kuti na ndi ka li jile sinagwe ubu na bya ñolelwa byangu mu Mañolo. Kono u bumpai mbwa muntu uju na ndi legeze ime nde Mwana Muntu. U bulotu nku ta buti kali ta na la bonigwa!”<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Judasi uju na mu legeze kale ga mu buza nage, “Muzigi, buti ndime?” Jesu kale ga mu taba nage, “U la gambi ndigwe.”<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Aa ka ba silya, Jesu kale ga inda i cinkwa no ku litumela. Kale ga ci komagula no ku ci wa a bazigigwa bakwe, mi kale ga ta nage, “Mu inde mu lye, gogu mubili gwangu.”<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Mi kale ga inda inkomoki mi aa sa la litumeli, kale ga ba wa no ku ba ta nage, “Mu nywemo mwense, <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />gaga ngo malowa gangu go nzumininano,<note caller="+" style="f"><char style="fr" closed="false">26:28 </char><char style="ft" closed="false">Mu mabuka gamwinya mbuti ku ñoletwe buti, “Inzumininano impya.”</char></note> aga ga sintikila a bantu ku ba inkwatilo jo bitendantu i bimangoju byo bantu a bangi. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Nda sa mi lugwila, ta ndi si nywi i cinywantu co ciyango ca veine ku zwa aano ku twala mwa lelyo ijuba aa na ndi nywe u muya antu-onke nenwe mu mubuso gwa Tata.”<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Kale ba zimba u lwimbo mi kale ba nanuka ku ja Kwilundu lya Olive.<verse eid="MAT 26:30" /></para>
  <para style="s">Jesu aa lugwila Pitolosi buti kuti na mu shampule</para>
  <para style="r">(<ref loc="MRK 14:27-31">Male 14:27-31</ref>; <ref loc="LUK 22:31-34">Luk 22:31-34</ref>; <ref loc="JHN 13:36-38">Joa 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Cwale Jesu kale ga lugwila a bazigigwa bakwe nage, “A masiku ga shunu mwense kuti mu ndi leke ndenke. Kakuli mbuti ku ñolelwe mu Mañolo buti,</para>
  <para style="b" vid="MAT 26:31" />
  <para style="q1" vid="MAT 26:31">‘Kuti na ndi kabe u mulisani</para>
  <para style="q2" vid="MAT 26:31">mi ingu jo mugona kuti na ji mwagale.’<note caller="+" style="x"><char style="xo" closed="false">26:31 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">Zakaliya 13:7</ref>.</char></note><verse eid="MAT 26:31" /></para>
  <para style="b" />
  <para style="p">
    <verse number="32" style="v" sid="MAT 26:32" />“Kono aa na ndi buke ku zwa ku bafu, kuti na ndi li tangize ku ja kwilonga lya Galileya.”<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Pitolosi kale ga taba Jesu nage, “Nanga na ba ku leke a bantu bonse, ime ta na ndi ku leke.”<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Jesu kale ga mu taba nage, “Mbyaconse ndi ku lugwila buti, a masiku ga shunu, silukombwe na sini uku tungula kuti u ndi shampule ko tatwe buti to ndi zekelele.”<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Pitolosi kale ga kana nage, “Nanga na nku fwa ka ndi gola uka fwa negwe, ta na ndi ku shampule.” No bazigigwa bamwinya nabo kale ba ta bulyao.<verse eid="MAT 26:35" /></para>
  <para style="s">Jesu aa lapela mu cibaka ci kugigwa Gesemani</para>
  <para style="r">(<ref loc="MRK 14:32-42">Male 14:32-42</ref>; <ref loc="LUK 22:39-46">Luk 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Cwale Jesu kale ga ja no bazigigwa bakwe ku cibaka ka ci kugigwa Gesemani. Kale ga ba ta nage, “Mu kale aano tanzila ime ndi si ka lapela ku lya.” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Kale ga inda Pitolosi, no bana ba Zebedeya bo bile mi Jesu kale ga tatika uku tompa no ku ba mu nkalilwa. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Kale ga ba ta nage, “U moya gwangu se gu li tompete mi se gu lili mu nkalilwa sinagwe se ndi fwe bulyo. Mu kale mo muno mi mu tonde neme.”<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Jesu kale ga senena u kule kanunu no ka gwila ansi bu sungamite no ku lapela nage, “Tata! Ati ku la golaala, jeji inkomoki ji indigwe kwangu. Kono ku leke uku tendaala ubu ndi shakila, kono ubu u shakila igwe.”<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Cwale Jesu kale ga bogola ku bazigigwa bakwe mi kale ga ka ba gwana ba lele. Kale ga buza Pitolosi nage, “Inwe mwe bankosi mwa sa kangwa uku tonda neme mu nako imfuwi bulyo? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Mu tonde mi mu lapele buti mu leke uku ngina mu mujeleko. U moya gu la shaka, kono u mubili ta gu kwesi inguzu!”<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Jesu kale ga ba leka kame lyabili mi kale ga ka lapela nage, “Tata! Ati ta ku golaali buti u timbile u kule jeji inkomoki mbwita aa ndi nywinamo, ku tendaale bulyo ubu u shakila.”<verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />Kale ga bogola kame ku bazigigwa bakwe mi kale ga ka ba gwana ba lele kakuli se ka ba sukula. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Kale ga ba leka no ku ja kame no ka lapela lya tatu, mi kale ga lapela i bintu bi li kozete.<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />Cwale Jesu kale ga bogola ku ba bazigigwa no keza ku ba ta nage, “Mu si lele no ku wisa? Nga mu lole inako se ji li li afuwi buti ime nde Mwana Muntu ndi wegwe mu maganja go bantu bo bitendantu i bimangoju. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Mu zimane, tu jende! Nga mu lole uju a ndi legeza a la siki!”<verse eid="MAT 26:46" /></para>
  <para style="s">Jesu aa kwatigwa</para>
  <para style="r">(<ref loc="MRK 14:43-50">Male 14:43-50</ref>; <ref loc="LUK 22:47-53">Luk 22:47-53</ref>; <ref loc="JHN 18:3-12">Joa 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Jesu aa ka si gamba byebyo, Judasi uju ka li jumwinya go bazigigwa be kumi no bo bile, kale ga sika no kagugi a kanene ko bantu aba ka ba indite u tufulo u tunene no bivuni. Mapulisiti a bakulu no manduna bo bantu na ba ba tuma. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Judasi u mulegezi, sa ba wa i cijuliko nage, “Uju sa ka ndi ka sonsone ndege mu mu shumine.” <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Cwale Judasi kale ga jililila bulyo kwa Jesu no ka mu zuminiza nage, “U joje nenja, Muzigi!” mi kale ga mu sonsona.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Jesu kale ga ta nage, “Musele, u tende ibi u la kezeli.”</para>
  <para style="p" vid="MAT 26:50">Mi bamwinya kale ba kwata Jesu no ku mu shumina. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Kono jumwinya ku bankosi aba ka ba li no Jesu kale ga inda a kafulo a kanene no ku kajula u kutwi ko muika go mupulisiti u mukulu.<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />Jesu kale ga mu ta nage, “U bogoze a kafulo a kanene u mu kale ku li, kakuli gense uju a lwisa a kafulo, kuti na yagiswe ko kafulo. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Ta mwi zi buti ndi la gola uku kuga kwa Tata, mi ka ndi wa wangu-wangu a mañiloi a mangi wawa ga itilila i kumi no go bile? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Kono, a Mañolo mbuti ka ga golela uku vumbilizwa aga ga ta buti byebi bi li botele uku tendaala ka gogu u mutendelo?” <verse eid="MAT 26:54" /><verse number="55" style="v" sid="MAT 26:55" />Cwale Jesu kale ga ta a bantu a bangi nage, “Ncinzi aa mu la kezi no tufulo u tunene no bivuni sinagwe ndi li cijoni? Ka ndi kalanga mu tumpetu to tempele na ndi ziga a bantu mwijuba-mwijuba, kono ta na mwa ndi kwata. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Kono byebi bya sa tendaala buti ku vumbilizwe ibi se ba ñola a baboni ba Nyambe.” Mi a bazigigwa bonse kale ba mu leka no ku tiga.<verse eid="MAT 26:56" /></para>
  <para style="s">Jesu aa twaligwa a nkuta</para>
  <para style="r">(<ref loc="MRK 14:53-65">Male 14:53-65</ref>; <ref loc="LUK 22:54-55">Luk 22:54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Joa 18:13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Babo a bantu na ba kwata Jesu, kale ba mu twala ku mupulisiti u mukulu gwezina lya Kayafa uku ka ba gwananine a bazigi bo mulao no manduna. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Kono Pitolosi kale ga mu umpilila na jenda u kule. Kale ga keza kwilapa lyo mupulisiti u mukulu. Kale ga ngina mwilapa no ka kala no bamameli buti a bone ibi sa ka bi tendaale. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />A mapulisiti a bakulu no manduna bo nkuta kale ba shaka a bampaki a bangi buti ba shangeze Jesu i bintu byo manya buti ba mu yagileo. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Kono kale ba kangwa uku mu gwanina u bupaki nanga aa kakuli a bampaki a bangi bo manya. Ku mamaninino kale kwa keza a bankosi bo bile <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />mi kale ba keza ku gamba nabo, “Joju unkosi sa ta buti, ‘Ndi la gola uku jakulula jeji i tempele ja Nyambe no ku ji jaka mu majuba go tatwe.’ ”<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Mi u mupulisiti u mukulu kale ga zimana no ku ta Jesu nage, “To tabe cimwinya? Mbupaki bwa buti ba ku shumina kabo baba a bankosi?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Kono Jesu kale ga ombelela bulyo. Mi u mupulisiti u mukulu kale ga ta Jesu nage, “Nda sa ku konka mwizina lya Nyambe uju a joja, nda sa shaka buti u ndi lugwile ati ndigwe Kilesite, Mwana Nyambe.”<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Jesu kale ga taba nage, “U la gambi. Kono nda sa mi ta mwense buti, ku zwa aano kuti na mu ndi bone ime nde Mwana Muntu na ndi kele mu cibaka co nguzu ku mulyo gweganja lya Go Nguzu na ndi keza a majoba ga kwigulu.”<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />U mupulisiti u mukulu kale ga ñatula i bizwato byakwe mi kale ga ta nage, “Ngwa kashwau! Mba cinzi a bampaki sa ka tu zunde kame! Mwense mu la li shugwili a kashwau kakwe. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Inwe mbuti mu gajila?”</para>
  <para style="p" vid="MAT 26:66">Kale ba ta nabo, “Ali botele uku fwa!”<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Mi kale ba mu suwagila a mate ku mensho no ku mu kaba no mafaindi gabo. Mi bamwinya kale ba mu akusula a maaka, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />na ba mu tanga nabo, “U gambe kwetu ko buboni, gwe Kilesite, ndini a la ku kabi?”<verse eid="MAT 26:68" /></para>
  <para style="s">Pitolosi aa shampula Jesu</para>
  <para style="r">(<ref loc="MRK 14:66-72">Male 14:66-72</ref>; <ref loc="LUK 22:56-62">Luk 22:56-62</ref>; <ref loc="JHN 18:15-18">Joa 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Cwale Pitolosi mwilapa ka kele, mi u muika go mukazana kale ga keza kwakwe, no ku mu ta nage, “Negwe u li jumwinya go bantu ka ba kalanga no Jesu gwa kwilonga lya Galileya.”<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Kono Pitolosi kale ga shampula a bantu bonse na ba mu shugwile nage, “Ta ndi zi ici u gamba.”<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />Pitolosi kale ga ja ku cizi ce lapa mi u muika jumwinya go mukazana kale ga mu bona, mi kale ga ta a bantu ka ba zimene ambali nage, “Joju unkosi nage ka kalanga no Jesu gwa Nanzaleta.”<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />No ao Pitolosi kale ga shampula ko ku konka, “Joju unkosi ta ndi mwizi!”<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Aa se ku la iti inako ince bulyo, bamwinya aba ka ba zimene-zimene bulyo kale ba keza kwa Pitolosi no ku mu ta nabo, “Negwe wawa u li jumwinya gwabo kakuli tu li ku shugwile ubu u lumbulwila i bintu.”<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Pitolosi kale ga ta nage, “Nyambe a ndi bangise ati kame ndi oma.” Mi kale ga ba konka nabo nage, “Ta ndi mwizi joju unkosi!” Aobulyo silukombwe kale ga tungula.<verse eid="MAT 26:74" /></para>
  <para style="p">
    <verse number="75" style="v" sid="MAT 26:75" />Mi aobulyo Pitolosi kale ga vuluka ibi sa gamba Jesu aa sa mu ta buti, “A masiku ga shunu silukombwe na sini uku tungula, kuti u ndi shampule ko tatwe.” Mi kale ga anina kunze no ka lila lwini.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">Jesu aa twaligwa kwa Pilato</para>
  <para style="r">(<ref loc="MRK 15:1">Male 15:1</ref>; <ref loc="LUK 23:1-2">Luk 23:1-2</ref>; <ref loc="JHN 18:28-32">Joa 18:28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />A masiku-siku, a mapulisiti a bakulu no manduna kale ba gwanana kame ku li gambaguza ubu ka ba botele uku yagila Jesu. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Kale ba mu shumina no ku mu twala kwa Pilato uju ka li mubusisi.<verse eid="MAT 27:2" /></para>
  <para style="s">Judasi aa li yaga ko ku li sungilila</para>
  <para style="r">(<ref loc="ACT 1:18-19">Bit 1:18-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Cwale Judasi, uju na ga legeza Jesu aa bona buti kale ba atwila Jesu u lufu, kale ga li shugwa u bubi. Mi kale ga bogoza a masheleñi go buwaya-waya bo makumi go tatwe ku mapulisiti a bakulu no manduna. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />Kale ga ba ta nage, “I bitendantu na nda tenda mbi mangoju kakuli na nda legeza u muntu ta kwesi u mulandu.”</para>
  <para style="p" vid="MAT 27:4">Abo kale ba mu taba nabo, “Mbya cinzi byebyo kwetu? U bi li bonene gwemwini.”<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Judasi kale ga ka mwagila bobo u buwaya-waya bo masheleñi mu tempele mi kale ga anina anze no ka li sungilila gemwini.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />A mapulisiti a bakulu, kale ba tola bobo u buwaya-waya mi kale ba ta nabo, “Nku shwauza u mulao uku tula gaga a masheleñi mu mabikilo ga mu tempele, kakuli masheleñi go ntifo jo lufu lo muntu.” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Aa se ba la gambaguli kale ba zumininana buti ba ga gule igwa lyo mubumbi go tuzunga buti li be a mabita go bazwa-malonga. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Mpaa li si kugigwa no shunu-aano buti ndigwa lyo Cilowa-lowa. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Mi ibi na ga bona u muboni gwa Nyambe Jelemiya, kale bya vumbilizwa aa sa ta buti,</para>
  <para style="b" vid="MAT 27:9" />
  <para style="q1" vid="MAT 27:9">“Na ba inda a masheleñi go buwaya-waya go makumi go tatwe</para>
  <para style="q2" vid="MAT 27:9">njejo na ja ba ingulo jakwe na ba gulisa a bantu ba Isilaele,<verse eid="MAT 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 27:10" />kale ba gulao igwa lyo mubumbi go tuzunga</para>
  <para style="q2" vid="MAT 27:10">ubu sa co u Mfumu.<note caller="+" style="x"><char style="xo" closed="false">27:10 </char><char style="xt" closed="false"><ref loc="JER 32:6-9">Jelemiya 32:6-9</ref>; <ref loc="ZEC 11:12-13">Zakaliya 11:12-13</ref>. </char></note>”<verse eid="MAT 27:10" /></para>
  <para style="s">Pilato aa zekisa Jesu</para>
  <para style="r">(<ref loc="MRK 15:2-5">Male 15:2-5</ref>; <ref loc="LUK 23:3-5">Luk 23:3-5</ref>; <ref loc="JHN 18:33-38">Joa 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Jesu aa ka zimene a nkuta, Pilato, u mubusisi kale ga mu buza nage, “Ndigwe mfumu go Majuda?”</para>
  <para style="p" vid="MAT 27:11">Jesu kale ga mu taba nage, “U la gambi.”<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Kono a mapulisiti a bakulu no manduna, kale ba mu shangeza i bintu byo manya, kono Jesu kale ga ombelela bulyo. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Pilato kale ga mu buza nage, “To shugwile ibi i bintu ba ku shangeza?” <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Kono Jesu takuli ici na ga taba ku bintu ka ba mu shangeza, mi Pilato kale ga komokwa lwini.<verse eid="MAT 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Ka gu li mutendelo go mubusisi go ku zwisanga u muntu genke mu ntolongo a nako jo Mukiti go Mpaseka uju ka shaligwa ku bantu. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Mwa gogo u mwaka, nko ka li unkosi uju ka zibaala lwini mi ka li ntembeka uju ka li mu ntolongo gwezina lya Bbalabbasi. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Gago a masiku-siku a bantu a bangi kale ba keza ku gwananina a njugo ja Pilato, mi kale ga ba buza nage, “Ndini mu shaka buti ndi mi shumunwine, ndi Bbalabbasi kampa ndi Jesu uju a kugigwa u Mushaligwa?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />(Pilato ka zekelele buti a bajendesi na ba shumina Jesu kebaka lyo ku mu fwila u muna.)<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Pilato aa ka si kele mu cikalo co buatuli, mukazi gwakwe kale ga mu tumina indagano nage, “U leke jojo unkosi kakuli ta kwesi u mulandu. Ndi la tembekigwa lwini shunu aa ndi le ku lota kebaka lyakwe.”<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />A mapulisiti a bakulu no manduna kale ba shonga a bantu a bangi buti ba kumbile Pilato buti a shumunune Bbalabbasi mi Jesu ige a yagigwe.<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />Pilato kale ga ba buza kame nage, “Kwa baba bo bile, ndini mu shaka buti ndi mi shumunwine?”</para>
  <para style="p" vid="MAT 27:21">A bantu a bangi kale ba kugiliza nabo, “Ndi Bbalabbasi!”<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />Pilato kale ga ba buza nage, “Inga Jesu uju a kugigwa buti nde Mushaligwa, mbuti mu shakila buti ndi mu tendele?”</para>
  <para style="p" vid="MAT 27:22">Abo kale ba taba nabo, “U mu kankamine!”<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Pilato kale ga ba buza nage, “Icinzi? Mulandunzi na ga tenda?”</para>
  <para style="p" vid="MAT 27:23">Kono bonse kale ba kugiliza lwini nabo, “U mu kankamine!”<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Pilato aa sa la boni buti ta ku si li intuso iji a gola uku tenda, ko ku ta buti inkondo se ka ji tatika, kale ga inda a menzi mi kale ga shamba ku maganja a bantu bonse na ba mu lolelele. Mi kale ga lugwila a bantu nage, “Ta ndi kwesi u mulandu mu lufu lwa joju unkosi. Mbyenu byebyo mu bi libonene!”<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />A bantu bonse kale ba kugiliza nabo, “U mulandu gwa lolu u lufu lwakwe gu be gwetu no banetu!”<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Cwale Pilato kale ga ba shumunwina Bbalabbasi. Mi kale ga ta buti Jesu a shapigwe no ndupwa, no ku mu wa a masole bo Maloma buti ba ka mu kankamine.<verse eid="MAT 27:26" /></para>
  <para style="s">A masole aa ba nyungulula Jesu</para>
  <para style="r">(<ref loc="MRK 15:16-20">Male 15:16-20</ref>; <ref loc="JHN 19:2-3">Joa 19:2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />A masole ba Pilato kale ba twala Jesu mwilapa lyo mubusisi mi a masole bonse kale ba ka mu bunganina. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Kale ba mu jabula i bizwato byakwe no ku mu jabika u mukanjo go ku subila. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Mi kale ba mu tula u tutabi to miga ku mutwi u tu na ba zinga sinagwe nciusi co mfumu. Mi kale ba mu kwatika u mulamu mwiganja lyakwe lyo mulyo mi kale ba tongama no ku mu nyungulula nabo, “Oosho! Gwe mfumu go Majuda!” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Kale ba mu suwagila a mate no ku mu kwanyuna gogo u mulamu no ku gu mu kabagulisa ku mutwi. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Aa se ba la mani uku mu nyungulula, kale ba mu zula u mukanjo no ku mu zwatika i bizwato byakwe kame. Mi kale ba mu twala buti ba ka mu kankamine.<verse eid="MAT 27:31" /></para>
  <para style="s">Jesu aa kankaminwa</para>
  <para style="r">(<ref loc="MRK 15:21-32">Male 15:21-32</ref>; <ref loc="LUK 23:26-43">Luk 23:26-43</ref>; <ref loc="JHN 19:17-27">Joa 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Aa ka jenda bulyao, kale ba shangana unkosi gwezina lya Simoni, uju ka zwa mu munzi gwa Silene,<note caller="+" style="f"><char style="fr" closed="false">27:32 </char><char style="ft" closed="false">Silene ka gu li munzi ka gu li ku mutulo gwelonga lya Afulika, mu cibaka se kuli ilonga lya Tunisiya.</char></note> mi a masole kale ba mu indikiza buti a koleke i cifapaano ca Jesu. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Kale ba ka sika a cibaka ci kugigwa Gologota (ku toloka i “Cibaka co katendele”). <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />A masole kale ba mu wa waine go ku gwanika no ntulukiza, kono aa sa la shutuliko, kale ga kana uku mu nywa.<verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />Aa se ba la mani uku mu kankamina a cifapaano, kale ba li taangila i bizwato byakwe ko ku tenda iñeela. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Kale ba kala bulyao na ba mu mamela. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Kale ba kankaminao iala egulu lyo mutwi gwakwe aa ka ku ñoletwe byo mulandu gwakwe aa ka ku ñoletwe buti, “<char style="sc">Joju ndi Jesu, u Mfumu go Majuda</char>.” <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Kale ba kankamina no bijoni byo bile kumbali nage, cimwinya ku mulyo cimwinya ku monsho.<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />A bantu aba ka ba ita kumbali ka ba mu nyungulula ko majwi a mamangoju, na ba ukusa i mitwi jabo, <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />na ba ta nabo, “Ngolole cwale, ta li ndigwe so ta buti u la gola uku jakulula i tempele no ku ji jaka mu majuba go tatwe? U li jojese gwemini! Suka a cifapaano, ati ndigwe Mwana Nyambe!”<figure style="fig" alt="Jesus is crucified" file="cn01836b.jpg" size="span" loc="Mat 27:32-40" ref="27:35-38">Jesu aa kankaminwa a cifapaano</figure><verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />A mapulisiti a bakulu, no bazigi bo mulao mane no manduna, nabo kale ba nyungulula Jesu. <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />Kale ba ta nabo, “Ka jojesanga bamwinya, kono ga sa kangwa uku li jojesa gemwini! Ndo mfumu gwa Isilaele, indi mbuti? Mu mu leke a li suse gemwini a cifapaano, mi kuti tu zumine kwakwe. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Ka sepete Nyambe, mu leke Nyambe a mu lamwine aano ati a la mu shaka! Kakuli mbuti ka telanga buti, ‘Ndi li Mwana Nyambe.’ ” <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Mane no basa aba ka ba kankaminwe antu-onke nage, nabo kale ba mu nyungulula bulyao.<verse eid="MAT 27:44" /></para>
  <para style="s">Jesu aa fwa</para>
  <para style="r">(<ref loc="MRK 15:33-41">Male 15:33-41</ref>; <ref loc="LUK 23:44-49">Luk 23:44-49</ref>; <ref loc="JHN 19:28-30">Joa 19:28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Ku ma 12, a kansindwe kale ka vwika ilonga lyonse ku twala ku ma 15. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Mu nako jo ma 15, Jesu kale ga kumba keejwi inene nage, “Eli, Eli, lama sabakatani?” Nko ku ta buti, “Nyambe gwangu, Nyambe gwangu, ncinzi aa u la ndi lekeleli?”<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />A ba ka ba zimene afuwi aa ba shugwa bulyao, kale ba ta nabo, “Ujo, sa la kuga u muboni gwa Nyambe Eliya.”<verse eid="MAT 27:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48" />Aobulyo, jumwinya kale ga tiga no ka tula i ciponci mwa waine go ku lyelyeta no ku ci shupika kwitaka buti a nywe. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Kono u bungi bwabo kale ba ta nabo, “Ndokweni tu lindile tu bone ati Eliya kuti a keze a mu jojese.”<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Jesu kale ga kumba kame mi kale ga lekelela u muuja gwakwe buti gu mane.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Mwa jejo inako isila lya mu tempele kale lya ñatuka akati ku tatikila kwigulu lyalyo ku twala ansi. Ilonga kale lya ukuta mi a mabwe kale ga ñatauka akati. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />A mabita nago kale ga galuka mi i mibili jo bafu bo bankosi no banakazi ba Nyambe a bangi aba se ba fwa, kale ja zikuka no ku joja. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Kale ba zwa mu mabita Jesu aa sa la buki ku zwa ku bafu. Mi kale ba ngina mu munzi gu cenete gwa Jelusalema, no ku bonaala ku bantu a bangi.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />U mujendesi go masole no babo aba ka ba mamela Jesu, aa ba bona ilonga li ukusigwa mane ne bi ka bi tendaala byonse kale ba joga lwini no ku ta nabo, “Ndiconse joju unkosi ka li Mwana Nyambe!”<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Mi a banakazi a bangi aba ka ba zwa mwilonga lya Galileya, aba ka ba tusanga Jesu, nabo ka ba mu lolelele na ba zimene u kule kace. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Mi a mazina gabo mba, Maliya Magadalena, no Maliya nyina gwa Jakobo no Josefa, mane no nyina gu ba Jakobo no Joani a bana ba Zebedeya.<verse eid="MAT 27:56" /></para>
  <para style="s">Jesu aa tuligwa mwibita</para>
  <para style="r">(<ref loc="MRK 15:42-47">Male 15:42-47</ref>; <ref loc="LUK 23:50-56">Luk 23:50-56</ref>; <ref loc="JHN 19:38-42">Joa 19:38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Aa se ka ku ja bu tenguwa, Josefa uju ka zwa ku munzi gwa Alimateya, mi ka li go lubono kame nage ka li muumpilili gwa Jesu, <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />kale ga ja kwa Pilato ka kumbila i citupu ca Jesu. Mi Pilato kale ga ta buti ba ka ci mu angwile no ka ci mu wa. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Josefa kale ga ci inda no ku ci vungila mwisila ile lyo kucena. <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />Kale ga ka ci tula mwibita lyakwe iya, ili na lya conkomonigwa mwibwe. Mi kale ga galumwina ibwe inene ku fwinka ku manginino na ka li jila. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Maliya Magadalena no Maliya jumwinya kale ba kala afuwi nebita na ba lolelele.<verse eid="MAT 27:61" /></para>
  <para style="s">Byo bamameli bebita</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Ijuba na lya nungako, lyo Nsabata, a mapulisiti a bakulu no Bafalisi kale ba ja kwa Pilato. <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />Kale ba ka mu lugwila nabo, “Mfumwetu, ta tu zibele ibi ka li gambanga lilya isawana aa ka li si joja. Mbuti ka li telanga na lyo, ‘Aa na ku ite a majuba go tatwe, kuti na ndi buke ku zwa ku bafu.’ <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Kame tu ku kumbila buti u lugwile a masole ba mamele nenja ibita ku twala mwijuba lya tatu. Ko ku tenda bulyao, a bazigigwa bakwe kuti na ba kangwe uku iba i citupu cakwe no ku oma a bantu bonse buti na ga buka ku bafu! Bebyo bi si tendaala bulyao, nela se tu la zielea ku ita ubu ka tu zieleele etanzi.”<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />Pilato kale ga ba taba nage, “Mu inde a bamameli buti ba ka mamele nenja ibita ubu mu wenene.” <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Mi abo kale ba ka ja mi kale ba ka tula u lukanko lo muñolo go mfumu ebwe no ku lugwila a bamameli buti ba mamele nenja ibita.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Jesu aa buka ku zwa ku bafu</para>
  <para style="r">(<ref loc="MRK 16:1-10">Male 16:1-10</ref>; <ref loc="LUK 24:1-12">Luk 24:1-12</ref>; <ref loc="JHN 20:1-10">Joa 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Lyo Nsabata aa se li la mani, mi se ka ga li maca-siku ge juba lyo nsunda, Maliya Magadalena no Maliya jumwinya, kale ba menekela kwibita.<verse eid="MAT 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2" />Aobulyo kale kwa ba no ku ukuta kweevu, kakuli iñiloi lya Nyambe na lya keza ansi ku zwa kwigulu, no ku galumuna ibwe ku li indao no ku kalao. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Ka li bonaala sinagwe ndumuni, mi i bizwato byalyo ka bi li byo ku tuba twaa. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />A bamameli kale ba joga lwini aa ba li bona mi kale ba tutuma, kale ba ba sinagwe mbantu ba fwite.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />Mi iñiloi kale lya ta a banakazi na lyo, “Mu leke uku joga! Ndi li zi buti ndi Jesu mu shaka, uju sa kankaminwa. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Ta mu li mo muno! Na ga buka ku zwa ku bafu, ku ja ko bu sa co. Mu keze mu bone u mu ka ci lele i citupu. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Cwale mu jende wangu mu ka lugwile a bazigigwa bakwe buti Jesu a la buki ku zwa ku bafu, mi a la li tangizi ku ja kwilonga lya Galileya, kuti na mu ka mu gwaneko. Cwale ndi la mani uku mi gambaguza.”<figure style="fig" alt="The empty tomb" file="gt00088.jpg" size="col" loc="Mat 28:1-7" ref="28:1-7">Ibita lyo ciashamizi</figure><verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />A banakazi kale ba zwa kwibita bu tiga, ka ba jogete kono kame ka ba jangele lwini. Kale ba welangila ku bazigigwa buti ba ka ba gambaguze ibi li la ba gambaguzi iñiloi. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Aobulyo, Jesu kale ga ba shangana mi kale ga ba ta nage, “Mu joje.” Abo kale ba mu senena mi kale ba mu gunzilila ku matende no ku mu lapela. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Jesu kale ga ba ta nage, “Mu leke uku joga! Mu jende mu ka lugwile a bakwangu buti ba je kwilonga lya Galileya mi kuti ba ka ndi gwaneko.”<verse eid="MAT 28:10" /></para>
  <para style="s">U bupaki bo bamameli bebita</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />A banakazi aa ka ba si li mu nzila, a bamameli kale ba ja mu munzi no ka gambaguza a mapulisiti a bakulu i bintu byonse ibi na bya tendaala. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />A mapulisiti a bakulu aa se ba la gwanani no manduna, kale ba li gambaguza buti ba we a bamameli a masheleñi a mangi buti ba lyata-lyate intaba mu manya. <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />Kale ba ta a bamameli buti, “Na mu te buti, ‘A bazigigwa ba Jesu na ba keza a masiku na tu lele mi na ba iba i citupu cakwe.’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Ati Pilato na shugwa bulyao, kuti na tu mu logwise buti tu mi zwise mu bukababu.” <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />A bamameli kale ba zumina uku wegwa a masheleñi mi kale ba lugula ubu na ba ba tela. Mi jejo intaba kale ja ja impuwo ku Majuda bonse mi ba si ji sukulula no shunu-aano.<verse eid="MAT 28:15" /></para>
  <para style="s">Indagano inene</para>
  <para style="r">(<ref loc="MRK 16:14-18">Male 16:14-18</ref>; <ref loc="LUK 24:36-49">Luk 24:36-49</ref>; <ref loc="JHN 20:19-23">Joa 20:19-23</ref>; <ref loc="ACT 1:6-8">Bit 1:6-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Cwale a bazigigwa be kumi no genke kale ba ja kwilonga lya Galileya, kwilundu uku na ga ba tela Jesu buti ba jeko. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Aa ba mu bona kale ba mu lapela, kono bamwinya kale ba mamanya. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Jesu kale ga ta a bazigigwa bakwe nage, “Na nda wegwa inguzu jonse mwigulu no ansi. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Mu jende mu ka zige a bantu bo malonga gonse buti ba be a bazigigwa bangu, na mu ba kolobeza mwizina lya Tata no lyo Mwana no lyo Moya go Kucena. <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />Mu ba zige uku kutika i bintu byonse ibi na nda mi laga. Mi mu zibe buti, ime ndi li kele nenwe ku twala ku mamaninino go nako.”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>