<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- Shanjo</book>
  <para style="h">Maebelu</para>
  <para style="toc3">Maeb</para>
  <para style="toc2">Maebelu</para>
  <para style="toc1">Iñolo lyo Maebelu</para>
  <para style="mt2">Iñolo lyo</para>
  <para style="mt1">Maebelu</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s">Jesu nde Mwana Nyambe</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />Ku kale-kale koko Nyambe sa gamba ku basukuzetu ko baboni ba Nyambe mu bungi bo nako no ko mazila a mangi, <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />kono mo muno mu majuba go mamaninino sa gamba kwetu ka Mwane, uju sa shala ku ba u mujoboli go bintu byonse, mi kame nkakwe Nyambe aa sa bumba i bintu byonse. <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />U Mwana ndege a li mubonaalilo go mpazimo ja Nyambe no muzimanini wawa go mukalilo gwakwe, uju a kalikise i bintu byonse keejwi lyakwe lyo nguzu. Aa sa la tu leteli uku cenisigwa ku bitendantu i bimangoju byetu, kale ga kala ku mulyo gweganja lya Nyambe go Nguzu-Jonse mwigulu. <verse eid="HEB 1:3" /><verse number="4" style="v" sid="HEB 1:4" />Mi kale ga ba u munene ku mañiloi sinagwe izina ili na ga jobola aa li li inene ku mazina gago.<verse eid="HEB 1:4" /></para>
  <para style="s">U Mwana munene ku ita a mañiloi</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 1:5" />Kakuli nkwa libo limwinya lyo mañiloi uku sa ta Nyambe buti,</para>
  <para style="b" vid="HEB 1:5" />
  <para style="q1" vid="HEB 1:5">“Ndigwe Mwanangu,</para>
  <para style="q2" vid="HEB 1:5">shunu ndi la bi Isho”<note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">Nimbo 2:7</ref>. </char></note>?</para>
  <para style="b" vid="HEB 1:5" />
  <para style="m" vid="HEB 1:5">Kampa ku gamba kame buti,</para>
  <para style="b" vid="HEB 1:5" />
  <para style="q1" vid="HEB 1:5">“Kuti na ndi be Isi,</para>
  <para style="q2" vid="HEB 1:5">mi ige kuti na be Mwanangu”<note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="2SA 7:14">2 Samuele 7:14</ref>; <ref loc="1CH 17:13">1 Makolonika 17:13</ref>. </char></note>?<verse eid="HEB 1:5" /></para>
  <para style="b" />
  <para style="m">
    <verse number="6" style="v" sid="HEB 1:6" />Mi kame, Nyambe aa leta u mueli gwakwe mwilonga, ga sa ta buti,</para>
  <para style="b" vid="HEB 1:6" />
  <para style="q1" vid="HEB 1:6">“Mu leke a mañiloi gonse ga Nyambe ga mu lapele.”<note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="DEU 32:43">Mulao 32:43</ref>.</char></note><verse eid="HEB 1:6" /></para>
  <para style="b" />
  <para style="m">
    <verse number="7" style="v" sid="HEB 1:7" />Mu ku gamba ko mañiloi sa ta nage,</para>
  <para style="b" vid="HEB 1:7" />
  <para style="q1" vid="HEB 1:7">“A mañiloi gakwe ga sa ga tenda inkuli,</para>
  <para style="q2" vid="HEB 1:7">no baika bakwe ku ba tenda indimi jo mulilo.”<note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="PSA 104:4">Nimbo 104:4</ref>. </char></note><verse eid="HEB 1:7" /></para>
  <para style="b" />
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />Kono ko Mwana ga sa ta nage,</para>
  <para style="b" vid="HEB 1:8" />
  <para style="q1" vid="HEB 1:8">“I cikalo cako co bumfumu, Nyambe, kuti na ci kalilile ku twala koko,</para>
  <para style="q2" vid="HEB 1:8">u mulamu go ku lulikila kuti na gu be u mulamu go <optbreak />mubuso gwako.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />Na gwa shaka u bumi bu lulikile no ku zimba u bubi,</para>
  <para style="q2" vid="HEB 1:9">kebaka lelyo Nyambe gwako, na ga ku nanwina egulu lyo bagenzo</para>
  <para style="q2" vid="HEB 1:9">ko ku ku sintila a mafuta go ku jangala.<note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="PSA 45:6">Nimbo 45:6</ref>,<ref loc="PSA 45:7">7</ref>. </char></note><verse eid="HEB 1:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10" />Kame sa ta buti,</para>
  <para style="b" vid="HEB 1:10" />
  <para style="q1" vid="HEB 1:10">Ku matatikilo, gwe Mfumu, so lalika insumpo jelonga,</para>
  <para style="q2" vid="HEB 1:10">mi igulu musebezi go maganja gako.<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />Kuti na bi mane, kono igwe u li kalilile,</para>
  <para style="q2" vid="HEB 1:11">byonse kuti na bi kulumpale sinagwe ncijabalo.<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />Kuti no bi vunge sinagwe mukanjo,</para>
  <para style="q2" vid="HEB 1:12">mi kuti na bi zoligwe sinagwe ncijabalo.</para>
  <para style="q1" vid="HEB 1:12">Kono igwe u li kalilile bulyo to zoki,</para>
  <para style="q2" vid="HEB 1:12">mi i myaka jako ta na ji mane.”<note caller="+" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="PSA 102:25-27">Nimbo 102:25-27</ref>.</char></note><verse eid="HEB 1:12" /></para>
  <para style="b" />
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />Nyambe ta sa ta kwiñiloi limwinya lyo mañiloi buti,</para>
  <para style="b" vid="HEB 1:13" />
  <para style="q2" vid="HEB 1:13">“U ndi kale ku mulyo gweganja lyangu</para>
  <para style="q1" vid="HEB 1:13">ku twala aa na ndi tule a bantu ba <optbreak />ku zimbite kwinsi</para>
  <para style="q2" vid="HEB 1:13">sinagwe ncikalo o lyatilila a matende gako.”<note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Nimbo 110:1</ref>.</char></note><verse eid="HEB 1:13" /></para>
  <para style="b" />
  <para style="m">
    <verse number="14" style="v" sid="HEB 1:14" />A mañiloi gonse buti ta li myoya ji sebeza iji ji tumigwanga ka sebeleza a bantu aba na ba jobole injojeso?<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s">Inanguzo jo nshugwiliso</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />Kebaka lelyo, tu li botele uku twalikiza ingana ku bintu ibi na twa shugwa buti tu leke uku ungulukila u kungi. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />Kakuli ati ijwi ili na lya gambigwa ku mañiloi ka lili lyaconse, mi uku li cola konse no ku sa li kutika u muntu ka tambula uku bangisigwa uku ku lulikile, <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />mbuti na tu andile ati na tu shwauza jejo injojeso inene. Jeji injojeso iji se ji zibisigwa etanzi ko Mfumu mi se ji vumbilizwa kwetu ko bantu aba na ba mu shugwa. <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />Nyambe sa ku paka kame ko bijuliko, no bintu bi komokwisa mane no mamakazo ga andene-andene, no ko mampo go Moya go Kucena aga ga wegwa ko bwa shakila.<verse eid="HEB 2:4" /></para>
  <para style="s">Jesu sa tendigwa sinagwe mbancegwe</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />Ta li nku mañiloi uku na ga wa inguzu jo ku busa ilonga ili li keza, ili tu gambagula byalyo. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />Kono nko ci li i cibaka mu Mañolo u mu sa gamba u muntu jumwinya buti,</para>
  <para style="b" vid="HEB 2:6" />
  <para style="q1" vid="HEB 2:6">“U muntu ncintunzi buti u mu twalikize ingana,</para>
  <para style="q2" vid="HEB 2:6">no mwana muntu buti u mu babalele?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />Na gwa mu tula kace-kace kwinsi lyo mañiloi,</para>
  <para style="q2" vid="HEB 2:7">na gwa mu tula i ciusi co mpazimo nekute<verse eid="HEB 2:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 2:8" />no ku tula i bintu byonse mwisiko lyo bujendesi bwakwe.”<note caller="+" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="PSA 8:4-6">Nimbo 8:4-6</ref>. </char></note></para>
  <para style="b" vid="HEB 2:8" />
  <para style="m" vid="HEB 2:8">Ko ku tula i bintu byonse mwisiko lyo bujendesi bwakwe, Nyambe takuli ibi na ga leka ibi ta bi jendesigwa kwakwe. Kono mo muno mu nako ta tu wene i bintu byonse bi jendesigwa kwakwe. <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />Kono tu liwene Jesu, uju sa tuligwa kwinsi lyo mañiloi mu nako imfuwi, aa wegwa i ciusi co mpazimo nekute kebaka lyo lufu ulu na ga pengisigwa kalo, buti ko cisemo ca Nyambe a fwile a bantu bonse.<verse eid="HEB 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 2:10" />Ko ku leta a bana bo baninzana no bakazana mu mpazimo, ka botelelwe buti Nyambe uju sa bumba noju a jojesa i bintu byonse, a tende Jesu uku ba u mutangilili go njojeso uku lulikila ko mapenzi na ga penga. <verse eid="HEB 2:10" /><verse number="11" style="v" sid="HEB 2:11" />Jesu uju a cenesa a bantu na ba ba cenesigwa, bonse mbantu bo luasi lonke. Mi Jesu ta fwi inshoni uku ba kuga buti mbakwakwe. <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />Kale ga ta nage,</para>
  <para style="b" vid="HEB 2:12" />
  <para style="q1" vid="HEB 2:12">“Kuti na ndi zibise izina lyako ku bakwangu,</para>
  <para style="q2" vid="HEB 2:12">kuti na ndi zimbe a malumbo gako mu nkongani jo bantu a bangi.”<note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="PSA 22:22">Nimbo 22:22</ref>. </char></note><verse eid="HEB 2:12" /></para>
  <para style="b" />
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />Kame sa ta nage,</para>
  <para style="b" vid="HEB 2:13" />
  <para style="q1" vid="HEB 2:13">“Kuti na ndi tule insepo jangu mwakwe.”<note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="ISA 8:17">Isaya 8:17</ref>. </char></note></para>
  <para style="b" vid="HEB 2:13" />
  <para style="m" vid="HEB 2:13">Mane kame sa ta buti,</para>
  <para style="b" vid="HEB 2:13" />
  <para style="q1" vid="HEB 2:13">“Ime juno no banangu aba sa ndi wa Nyambe.”<note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="ISA 8:18">Isaya 8:18</ref>. </char></note><verse eid="HEB 2:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />Kebaka lyo ku ta buti a bana mbantu bo nyama no malowa, nage na ga li taila mu buntu bwabo buti ko lufu lwakwe a manise inguzu ja Satani, uju a kwatilile inguzu jo lufu, <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />no ku sungulula a bantu aba ka ba sungitwe mu buika bo lyoga lyabo lyo lufu mu bumi bwabo bonse. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />Mi initi ta li mañiloi a tusa, kono mba luasi lwa Abbulaama. <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />Kebaka lelyo nage ka botele uku tendigwa u buntu wawa bu vumbite mu mikalilo jonse sinagwe mbakwake, buti a be nonse no ku sepaala ko ku ba u mupulisiti u mukulu mu nsebelezo kwa Nyambe, no ku ta buti a be i citagilo mu ku sebeleza Nyambe kebaka lyo bitendantu i bimangoju byo bantu. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />Kebaka lyo ku ta buti ige wawa sa penga aa sa jelekigwa, a la gola uku tusa a bantu aba ba kwesi uku jelekigwa.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s">Jesu munene ku ita Mushe</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />Kebaka lelyo, bakwangu ba cenete, inwe mu li taila munkugo ja kwigulu, mu twalikize i migajalo jenu kwa Jesu, uju tu kuga buti nde mutumigwa gwetu no mupulisiti u mukulu. <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />Ige sa sepaala kwoju na ga mu shala sinagwe ndi Mushe ubu sa sepaalila mu njugo ja Nyambe jonse.<verse eid="HEB 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 3:3" />Jesu sa gwanaala uku botelelwa kwikute inene ku ita Mushe, sinagwe mujaki go njugo aa kwesi ikute inene ku ita injugo iji a la jaki. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />Kakuli injugo ne njugo muntu na ga ji jaka, kono Nyambe nde mujaki go bintu byonse.<verse eid="HEB 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 3:5" />“Mushe sa sepaala sinagwe muika mu njugo ja Nyambe jonse,”<note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="NUM 12:7">Mapalo 12:7</ref>.</char></note> na gunzilile u bupaki bo bintu ibi ka gamba Nyambe mu majuba ga keza. <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />Kono Kilesite a la sepaala sinagwe Mwana egulu lyo njugo ja Nyambe. Mi ndiswe njugo jakwe, ati na tu gunzilila bu gongwele mu nzumino jetu no nsepo iji tu litunta kajo.<verse eid="HEB 3:6" /></para>
  <para style="s">U bubi bo ku sa shugwa</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />Cwale, sinagwe ubu gu tela u Moya go Kucena buti,</para>
  <para style="b" vid="HEB 3:7" />
  <para style="q1" vid="HEB 3:7">“Shunu, ati na mu shugwa ijwi lyakwe,<verse eid="HEB 3:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8" />mu leke uku ngangatiza i myojo jenu,</para>
  <para style="q1" vid="HEB 3:8">sinagwe ubu na mwa tendela aa na mwa ndi futatila mu kashwau</para>
  <para style="q2" vid="HEB 3:8">mu nako jo ntatubo mu mangusu,<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />aa se ba ndi tatuba basukuzenu no ku ndi jeleka</para>
  <para style="q2" vid="HEB 3:9">no ku se ba bona mu myaka jo makumi gone ibi na nda tenda.<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />Ndebaka na nda nyegelela lo lulya u luasi,</para>
  <para style="q2" vid="HEB 3:10">mi kale nda ta neme, ‘I myojo jabo nja ku unguluka inako jonse,</para>
  <para style="q2" vid="HEB 3:10">mi ta na ba zekelela a mazila gangu,’<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />Mi kale nda gamba ko ku li konka mu bunyegezi bwangu neme,</para>
  <para style="q2" vid="HEB 3:11">‘Ta na ba kale neme mu buwisize bwangu.’ ”<note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="PSA 95:7-11">Nimbo 95:7-11</ref>.</char></note><verse eid="HEB 3:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />Bakwangu, mu bone buti ku leke uku gwanaala jumwinya gwenu uju a kwesi u mojo u mubi ugu ta gu zumini, ugu gu futatila kungi ku zwa kwa Nyambe uju a joja. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />Kono mu li gongoze mwalyenu mwijuba-mwijuba aa tu si gola uku ta buti “Shunu,” buti ku bule jumwinya gwenu uju a gola uku kukutuwiswa ko ku omigwa ku citendantu i cimangoju. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />Kakuli twa sa kwatisana no Kilesite ati na tu gunzilila bu gongwele ko bundume ubu ka tu kwesi etanzi mane ku twala ku mamaninino. <verse eid="HEB 3:14" /><verse number="15" style="v" sid="HEB 3:15" />Sinagwe aa ku gambigwa wangu buti,</para>
  <para style="b" vid="HEB 3:15" />
  <para style="q1" vid="HEB 3:15">“Shunu, ati na mu shugwa ijwi lyakwe,</para>
  <para style="q2" vid="HEB 3:15">mu leke uku ngangatiza i myojo jenu</para>
  <para style="q1" vid="HEB 3:15">sinagwe ubu na mwa tendela aa na mwa mu futatila <optbreak />mu kashwau.”<note caller="+" style="x"><char style="xo" closed="false">3:15 </char><char style="xt" closed="false"><ref loc="PSA 95:7">Nimbo 95:7</ref>,<ref loc="PSA 95:8">8</ref>.</char></note><verse eid="HEB 3:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />Mbani aba se ba shugwa no ku mu futatila mu kashwau? Izo buti ta li mbantu bonse balya sa zwisa Mushe mwilonga lya Egepita? <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />Mi mbani sa nyegelela a myaka jo makumi gone? Izo buti ta li mbantu balya se ba tenda i bitendantu i bimangoju, aba se ba fwila mu mangusu? <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />Mi nku bani uku sa li konka Nyambe buti ta na ba kale nage mu buwisize bwakwe ati ta li nku bantu balya se ba shwauza? <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />Cwale mu liwene buti ta ka ba gola uku ngina, kebaka lyo ku sa zumina kwabo.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="s">Ijuba lyo buwisize bo bantu ba Nyambe</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />Cwale, ko ku ta buti inkuluwizi jo ku ngina mu ku wisa kwakwe ji si kele bulyao, tu mamele buti na ku bule u muntu gwenu uju na gwanaale buti a la kangwi uku nginamo. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />Kakuli neswe na twa shugwa a majwi a malotu aga na ga gambigwa kwetu, sinagwe ubu na ba ga shugwila, kono a majwi aga na ba shugwa ta ka ga kwesi u butokwa kwabo, kakuli ta na ba li taila inzumino ja babo na ba kutika. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />Cwale iswe na twa zumina twa sa ngina mwa koko uku wisa, sinagwe ubu sa gambila Nyambe,</para>
  <para style="b" vid="HEB 4:3" />
  <para style="q1" vid="HEB 4:3">“Cwale na nda gamba ko ku konka mu bunyegezi bwangu,</para>
  <para style="q2" vid="HEB 4:3">‘Ta na ba ngine mu buwisize bwangu.’ ”<note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="PSA 95:11">Nimbo 95:11</ref>. </char></note></para>
  <para style="b" vid="HEB 4:3" />
  <para style="m" vid="HEB 4:3">I misebezi jakwe na ja manisigwa ku zwa aa na lya bumbilwa ilonga. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />Kakuli mpo ku li amwinya mu Mañolo aa na ga gamba byejuba lyo bu 7 mwa gaga a majwi, “Mwijuba lyo bu 7 Nyambe na ga wisa ku zwa ku misebezi jakwe jonse.”<note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="GEN 2:2">Matatikilo 2:2</ref>. </char></note> <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />Mi kame mu Mañolo gamwinya mbuti sa co buti, “Ta na ba ngine mu buwisize bwangu.”<verse eid="HEB 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6" />Cwale ko ku ta buti ku si sigalile a bantu bamwinya uku ngina mwa bobo u buwisize, mi ko ku ta buti babo na ba gambilwa a majwi a malotu etanzi ta na ba ngina kebaka lyo kashwau kabo, <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />Nyambe sa shala ijuba limwinya, no ku li kuga “Shunu.” Sa gamba byalyo aa se ku la iti i myaka i mingi kame kale ga gamba ka Deviti, sinagwe ubu na kwa gambilwa buti,</para>
  <para style="b" vid="HEB 4:7" />
  <para style="q1" vid="HEB 4:7">“Shunu, ati mwa sa shugwa ijwi lyakwe,</para>
  <para style="q2" vid="HEB 4:7">mu leke uku kukutuwisa i myojo jenu.”<note caller="+" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="PSA 95:7">Nimbo 95:7</ref>,<ref loc="PSA 95:8">8</ref>. </char></note><verse eid="HEB 4:7" /></para>
  <para style="b" />
  <para style="m">
    <verse number="8" style="v" sid="HEB 4:8" />Kakuli ka li Joshuwa na la ba wi uku wisa, Nyambe ta na la gambi byejuba limwinya kame. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />Ao se ku li sigalile elu, i Nsabata jo ku wisa ko bantu ba Nyambe, <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />kakuli u muntu gense uju a ngina mu buwisize bwa Nyambe ga sa wisa kame ku misebezi jakwe, sinagwe ubu na ga wisikiza Nyambe ku misebezi jakwe. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />Ndokweni, cwale, tu tende ubu tu golela bonse uku ngina mwa bobo u buwisize, buti na ku leke uku fwa u muntu ko ku umpilila u mwanza gwabo go kashwau.<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />Kakuli ijwi lya Nyambe ndyumi mi li li kwesi inguzu. Ndiceku ku ita a kafulo a kanene ko bucesi bo bile, lya sa funda ka sika mane uku bi li taila u muuja no moya, mu ñongo no mu muzongwela, lya sa atula i migajalo no bishakantu byo mojo. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />Takuli ici ci bikamite mu mbumbo jonse mu mensho ga Nyambe. I bintu byonse mpantu bulyo bi kele mi ta bi vwikitwe mu mensho ga jojo uju tu botele uku li tabilila kwakwe.<verse eid="HEB 4:13" /></para>
  <para style="s">Jesu u mupulisiti u mukulu</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />Cwale, ko ku ta buti tu li kwesi u mupulisiti u mukulu uju sa kambamina kwigulu, Jesu Mwana Nyambe, ndokweni tu gunzilile ku nzumino iji na twa zumina kwajo. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />Kakuli ta tu kwesi u mupulisiti u mukulu uju ta goli uku tu fwila inse mu ku bula inguzu kwetu, kono uju tu kwesi ige sa jelekigwa mu mutendelo gonse, sinagwe ubu tu tendelwa neswe, kono ta na ga tenda i citendantu i cimangoju. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />Ndokweni cwale tu senene ku cikalo co bumfumu ca Nyambe co cisemo ko bundume, buti tu tambule inse no ku gwana i cisemo ici ci tu tusa mu nako jo makababu getu.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />U mupulisiti u mukulu gense ga sa shaligwa ku zwa mukati ko bantu mi ga sa julikigwa buti a zimanine a bantu mu bintu bya Nyambe, uku wa a mampo no bitagilo byo bitendantu i bimangoju. <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />A la gola uku sebelisana ko mojo u mulotu no nzundamo no bantu aba ta ba zekelele cimwinya na ba ba jobete, ko ku ta buti ige wawa ta kwesi inguzu. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />Ceci nceco ci leta buti a we i bitagilo byo bitendantu i bimangoju byakwe, mane no bitendantu i bimangoju byo bantu.<figure style="fig" alt="High Priest" file="lb00266b.jpg" size="col" loc="Heb 5:1-3" copy="Knowles" ref="5:1-3">U mupulisiti u mukulu</figure><verse eid="HEB 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 5:4" />Mi takuli uju a gola uku li indila leli ikute gemwini, kono ga sa li tambula aa kugigwa kwa Nyambe, sinagwe ubu ka kalile Aloni. <verse eid="HEB 5:4" /><verse number="5" style="v" sid="HEB 5:5" />Ko mutendelo ugu gu li kozete, Kilesite ta na ga li indila ikute gemwini lyo ku ba u mupulisiti u mukulu. Kono Nyambe sa gamba kwakwe buti,</para>
  <para style="b" vid="HEB 5:5" />
  <para style="q1" vid="HEB 5:5">“Ndigwe Mwanangu,</para>
  <para style="q2" vid="HEB 5:5">shunu ndi la bi Isho.”<note caller="+" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">Nimbo 2:7</ref>. </char></note><verse eid="HEB 5:5" /></para>
  <para style="b" />
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />Mi amwinya mbuti a co buti,</para>
  <para style="b" vid="HEB 5:6" />
  <para style="q1" vid="HEB 5:6">“U li mupulisiti ku twala koko,</para>
  <para style="q2" vid="HEB 5:6">ko mutendelo gwa Melekisedeki.”<note caller="+" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="PSA 110:4">Nimbo 110:4</ref>. </char></note><verse eid="HEB 5:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />Mu majuba go bumi bwa Jesu ansi, ka wa a matapelo no nkumbilo ko ku lila lwini no minsozi kwa jojo uju ka gola uku mu jojesa ku lufu, mi na ga shugwigwa kebaka lyo ku li tula kwinsi lya Nyambe. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />No ku ka li Mwana Nyambe, na ga li ziga uku ba nekute ku bintu ka penga kwabyo <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />mi, na ga tendigwa uju a lulikile, na ga leta buti a bantu ba gwane injojeso iji ta ji mani ku bantu bonse aba ba mu kutika <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />mi Nyambe na ga mu shala buti a be u mupulisiti u mukulu mu mutendelo gwa Melekisedeki.<verse eid="HEB 5:10" /></para>
  <para style="s">Uku nanguzwa kebaka lyo ku gwa mu nzumino</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />Mbingi tu kwesi byo ku gamba a jeji intaba, kono mbukababu uku ji tenda buti ji shugwaale nenja kwenu kakuli mu li ba muleleja uku li ziga. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />Initi nja ku ta buti, nanganceciba je jino inako se ka mu botele uku ba a bazigi, kono mu si shaka u muntu jumwinya uju a mi ziga kame byo nzigo jo matatikilo jo niti jeejwi lya Nyambe. Mabisi mu zunda, ta li mbilyo bi gongwele! <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />U muntu gense uju a joja a mabisi, a sili mucece, a sini uku li ziga byo nzigo jo ku lulikila kwa Nyambe. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />I bilyo ibi bi gongwele mbya bantu a bakulu, aba na ba zundamina uku li sholeza a beni uku shala u bulotu ku bubi.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />Cwale ndokweni tu nunge ku nzigo jo matatikilo ja Kilesite no ku twaligwa ku buso mu ku gongola, sini ku ku sumpa kame insumpo jo ku siguluka ku zwa ku bitendantu ibi bi twala ku lufu, no byo nzumino kwa Nyambe, <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />byo nzigo jo makolobezo ga andene-andene, byo ku kambika a maganja, byo mbuko jo bafu, no nkatulo iji ta ji mani. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />Mi Nyambe aa zuminina, kuti na tu tende bulyao.<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />Ta ku golaali kwa babo na ba wegwa ituba, aba na ba jeleka impo ja kwigulu, aba na ba li taila mu Moya go Kucena, <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />aba na ba jeleka u bulotu bwejwi lya Nyambe no nguzu jo nako ji keza <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />mi na ba zwa ku nzumino, ba bogozwe ku nsiguluko. Icintu i cimangoju kwabo nkuta buti ba sa kankamina Mwana Nyambe kame no ku mu fwisa inshoni ku bantu.<verse eid="HEB 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7" />Ivu ili li tambula a menzi go mvula mu bungi bo nako lya sa zwisa u lukau lo butokwa kwa babo aba ba li lima mi lya sa tambula imfwijaguzi ja Nyambe. <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />Kono ivu ili li menisa i miga no nshonsho ta li kwesi intuso mi mu bujoge li li bo ku kutigwa. Ku mamaninino kuti na li tentigwe.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />Nanganceciba buti twa sa gamba bulyaa, mwe basele aba tu shaka, tula logwa ko bintu i bilotu wawa byenu, i bintu bi nungite ku njojeso. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />Nyambe a li lulikile, ta na zibale u musebezi gwenu no lushako ulu na mwa bonisa kwakwe aa ka mu tusa a bantu bakwe no ku zundamina uku ba tusa. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />Twa sa shaka buti u muntu no muntu gwenu a be no ku gongolekeza kwa bulyaa ku twala ku mamaninino, buti ici mu sepete ci zibigwe ko ku vumba. <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />Ta tu shaki buti mu be a bakata, kono buti mu jelekeze babo na ba jobola ici na ca kuluwizwa ko nzumino no nzundamo.<verse eid="HEB 6:12" /></para>
  <para style="s">Uku zibaala ko nkuluwizi ja Nyambe</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />Nyambe aa na ga kuluwiza inkuluwizi jakwe kwa Abbulaama, ko ku ta buti ta ka ku li u muntu u munene ku mu ita uju ka gola uku konka kakwe, kale ga konka kakwe, <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />ku ta buti,</para>
  <para style="b" vid="HEB 6:14" />
  <para style="q1" vid="HEB 6:14">“Wawa kuti na ndi ku we imfwijaguzi no ku ku wa <optbreak />a bewa a bangi.”<note caller="+" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="GEN 22:17">Matatikilo 22:17</ref>. </char></note><verse eid="HEB 6:14" /></para>
  <para style="b" />
  <para style="m">
    <verse number="15" style="v" sid="HEB 6:15" />Mi ko ku lindila bu zundamine, Abbulaama na ga tambula ici na ga kuluwizwa.<verse eid="HEB 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 6:16" />A bantu ba sa konka ko muntu jumwinya u munene ku ba ita, mi uku konka kwa sa gongozwa kwe ci ci la gambigwa mi kwa sa manisa inkani jonse. <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />Kakuli Nyambe kame ka shaka uku tenda u mukalilo gwakwe ugu ta gu cinci go mugajalo gwakwe buti gu shugwaale nenja ku bajoboli kwe ci na ca kuluwizwa, na ga ji gongoza ko ku konka. <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />Nyambe sa tenda bulyao buti ko bintu byo bile inkuluwizi no ku konka kwakwe, ibi ta bi cinci, ku leke ku golaala buti Nyambe a ome, buti iswe na twa tigila kwakwe tu gunzilile ku nsepo iji na ja wegwa kwetu buti tu gongozwe ko bunene. <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />Tu li kwesi jeji insepo sinagwe ndi kwanato lyo myojo jetu, ili li gongwele no ku ba no mukalilo go ngana. Lya sa ngina mu cibaka co kucena ca mukati ka sika kwisilya lyesila, <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />uku na ga li tangiza Jesu sinagwe mutigi a tu tangilile, uju na ga ka tu ngininamo kebaka lyetu. Na ga ba u mupulisiti u mukulu ku twala koko, ko mutendelo gwa Melekisedeki.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s">U mupulisiti Melekisedeki</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />Joju Melekisedeki ndege ka li mfumu gwa Salema no mupulisiti gwa Nyambe Sakapanga. Kale ga li gwana no Abbulaama aa ka ka zwa ku ku gola a bamfumu mi kale ga mu wa imfwijaguzi, <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />mi Abbulaama kale ga mu wa ce kumi ku bintu byonse. Tanzi, izina lya Melekisedeki lya sa toloka “u mfumu go ku lulikila”, mi kame, nu mfumu gwa Salema ku toloka “u mfumu go mujojelo u mulotu.” <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />Isi kampa nyina no bo mukoga gwakwe ta ba zibaali, ta ku zibaali u lusiku na ga bonigwa no lusiku na ga fwa, na kozete Mwana Nyambe, na li mupulisiti ku twala koko.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />Nga mu gaje bulyo ubu ka neneele, buti nanga ndi Abbulaama u mukulu go luasi uju ka kutikigwa lwini sa mu wa ce kumi ku bintu na ga ka tapa ku nkondo! <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />Cwale u mulao ka gu zunda buti a bantu bo mukoga gwa Livi aba ka ba ba a mapulisiti ba indange ce kumi ku bakwabo a bantu ba Isilaele jebo nabo ka ba li bo mukoga gwa Abbulaama. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />Joju unkosi, nanganceciba buti, takali go mukoga gwa Livi, kono sa tambula ce kumi kwa Abbulaama no ku mu wa imfwijaguzi ige uju ka kwesi inkuluwizi. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />Aa taali uku mamanya u muntu u mushwauki ga sa wegwa imfwijaguzi ku muntu u munene.<verse eid="HEB 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 7:8" />Mu ntaba jimwinya, ce kumi ca sa tambulwa ku bantu aba ba fwa, kono mu ntaba jimwinya, Melekisedeki na ga ci inda uju sa tegwa buti a la joja. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />Jumwinya a la gola ukuta buti Livi, uju a tambula ce kumi, sa tenteka ce kumi ka Abbulaama, <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />kakuli Melekisedeki aa sa li gwana no Abbulaama, Livi ka sili mu mubili gwa sukuze Abbulaama.<verse eid="HEB 7:10" /></para>
  <para style="s">U bupulisiti bwa Jesu no bwa Melekisedeki</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />Ati uku lulikila na kwa gwanaala ko bupulisiti bo Malivi, mi ndiconse ka koko uku lulikila u mulao na gwa wegwa ku bantu, ncinzi aa ka ku si shakaala kame buti jumwinya u mupulisiti a keze, mu mukalilo gwa Melekisedeki sini mu mukalilo gwa Aloni?<verse eid="HEB 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 7:12" />Kakuli u bupulisiti aa bu cincigwa, no mulao gu li botele uku cincigwa bulyao nago. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />Ige uju a tegwa kwa byebi i bintu ka li go mukoga u mungi, mi takuli u muntu gwa gogo u mukoga uju ga la sebeleza a lutala. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />Kakuli ku la zibaala nenja wawa buti Mfumwetu mu mukoga gwa Juda sa bonigwa, mi ku ja ka gogo u mukoga Mushe takuli ici na ga gamba co mapulisiti. <verse eid="HEB 7:14" /><verse number="15" style="v" sid="HEB 7:15" />Mi ibi tula gambi bi la zibaala no ku ita ati u mupulisiti jumwinya na keza uju a kozete Melekisedeki, <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />uju sa ba u mupulisiti sini a mukalilo go mulao sinagwe ku basukuze kono mpa mukalilo go nguzu jo bumi ubu ta bu joneki. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />Kakuli se ku tegwa buti,</para>
  <para style="b" vid="HEB 7:17" />
  <para style="q1" vid="HEB 7:17">“U li mupulisiti ku twala koko,</para>
  <para style="q2" vid="HEB 7:17">mu mukalilo gwa Melekisedeki.”<note caller="+" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="PSA 110:4">Nimbo 110:4</ref>. </char></note><verse eid="HEB 7:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="HEB 7:18" />U mulao gwe tanzi gwa sa kumbikigwa kebaka lyo ku sa gongola no ku bula intuso kwago <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />(kakuli u mulao ta gwa la lulikiza i cintu conse), mi insepo indotu wawa ja sa zibaazwa, iji ji tu senekeza kwa Nyambe.<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />Kame ta ka ji tendigwa aa taali uku li konka! Bamwinya na ba ba a mapulisiti aa taali uku li konka, <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />kono ige na ga ba u mupulisiti ko ku li konka Nyambe aa sa ta kwakwe buti,</para>
  <para style="b" vid="HEB 7:21" />
  <para style="q1" vid="HEB 7:21">“U Mfumu Nyambe sa konka</para>
  <para style="q2" vid="HEB 7:21">mi ta na cince u mugajalo gwakwe,</para>
  <para style="q1" vid="HEB 7:21">‘U li mupulisiti ku twala koko.’ ”<note caller="+" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="PSA 110:4">Nimbo 110:4</ref>. </char></note><verse eid="HEB 7:21" /></para>
  <para style="b" />
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />Kebaka lyo ku li konka ko ku, Jesu na ga ba u mugongolekezi go nzumininano impya indotu ku ita jo kale.<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />Cwale na kwabanga a mapulisiti a bangi, kakuli u lufu ka lu ba kangwisanga uku kalilila a bujendesi, <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />kono kakuli Jesu a la joja ku twala koko, a li kwesi u bupulisiti ubu bu kalilile. <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />Kebaka lelyo a la gola uku jojesa ku maninina a bantu bonse aba ba keza kwa Nyambe kakwe, kakuli ige a la joja inako jonse ku ba kumbilila.<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />U mupulisiti u mukulu gwa bulyao ndege tu zunda, kakuli ige a li cenete, ta kwesi u mulandu, ngwa kucena, a li taitwe ku bantu bo bitendantu i bimangoju, na ga nanunwa egulu lyegulu lyonse. <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />Ko ku andana no mapulisiti a bakulu bamwinya, ta zundi uku wa i bitagilo mwijuba-mwijuba, a bitendantu i bimangoju byakwe tanzi, mane naa bitendantu i bimangoju byo bantu. Na ga wa i citagilo lyonke bulyo nela a bitendantu i bimangoju byabo aa sa li wa gemwini. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />Kakuli u mulao gwa sa shala a bankosi ko ku ba a mapulisiti a bakulu mu ku sa gongola kwabo, kono uku konka, uku se ku keza mwishule lyo mulao, se ku shala u Mwana, uju na ga tendigwa uju a lulikile ku twala koko.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s">U mupulisiti u mukulu go nzumininano impya</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />Cwale ibaka inene lyebi tu gamba ndi leli, tu li kwesi u mupulisiti u mukulu uju sa kala ku mulyo gweganja lyo cikalo co bumfumu bo Bumfumu mwigulu, <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />mi ndege a sebeza mu Cibaka ci Cenete, itente lyaconse ili na ga sumpa u Mfumu, mi ta li nka muntu bulyo.<figure style="fig" alt="Tabernacle and the Most Holy Place" file="lb00259b.jpg" size="span" loc="Heb 8:1-2" ref="8:1-2">Itente no Cibaka ci Cenete Lwini</figure><verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />U mupulisiti u mukulu gense a la ku shaligwanga uku wa a mampo no bitagilo, mi ka ku li ko butokwa no kwa joju uku wa cimwinya nage. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />Ka li mpansi na la ku li, ta na la bi u mupulisiti, kakuli se ku li li a mapulisiti aba ba wa a mampo ku ja ko bu gu co u mulao. <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />Ba sa sebeza mu Cibaka ci Cenete ici ci li bukozele no munzule go bintu ibi bi li mwigulu. Nceco na ca leta buti Mushe a nanguzwe aa se ka shaka uku sumpa itente buti, “U bone buti gwa sa tenda i bintu byonse ku ja ko mwanza ugu na gwa sundisigwa elundu.”<note caller="+" style="x"><char style="xo" closed="false">8:5 </char><char style="xt" closed="false"><ref loc="EXO 25:40">Lujendo 25:40</ref>. </char></note><verse eid="HEB 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 8:6" />Kono ko niti bulyo insebelezo iji sa tambula Jesu ji li kozete sinagwe ji li li egulu ku ita jabo sinagwe ni nzumininano iji a li muzimanini gwajo ji la ita jo kale, kebaka lyo ku ta buti inzumininano impya ji li sumpitwe a nkuluwizi indotu wawa.<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />Kakuli kali ta na ku le ku li i cintu ci fosaalite co nzumininano jo kale, takuli i cibaka na ci la shaakali co nzumininano jimwinya. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />Kono Nyambe na ga gwana buti a bantu ba li kwesi u mulandu mi kale ga ta nage,</para>
  <para style="b" vid="HEB 8:8" />
  <para style="q1" vid="HEB 8:8">“Nde Mfumu Nyambe mbuti ndi co buti, a majuba ga la keza,</para>
  <para style="q2" vid="HEB 8:8">aa na ndi tende inzumininano impya</para>
  <para style="q1" vid="HEB 8:8">no bantu ba Isilaele</para>
  <para style="q2" vid="HEB 8:8">mane no bantu ba Juda.<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />Ta na ji li koze no nzumininano iji se ndi tenda</para>
  <para style="q2" vid="HEB 8:9">no basukuzabo</para>
  <para style="q1" vid="HEB 8:9">aa se ndi ba kwata kwiganja</para>
  <para style="q2" vid="HEB 8:9">ku ba zwisa mwilonga lya Egepita,</para>
  <para style="q1" vid="HEB 8:9">kakuli ta na ba kala bu sepaala ku nzumininano jangu,</para>
  <para style="q2" vid="HEB 8:9">mi kale nda ba futatila,</para>
  <para style="q3" vid="HEB 8:9">mbobo ndi co nde Mfumu Nyambe.<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />Iji ne nzumininano na ndi gongoze no bantu ba Isilaele</para>
  <para style="q2" vid="HEB 8:10">mwishule lya jejo inako,</para>
  <para style="q1" vid="HEB 8:10">Kuti na ndi tule i milao jangu mu ngana jabo</para>
  <para style="q2" vid="HEB 8:10">no ku ji ñola mu myojo jabo.</para>
  <para style="q1" vid="HEB 8:10">Kuti na ndi be Nyambe gwabo,</para>
  <para style="q2" vid="HEB 8:10">mi kuti na ba be a bantu bangu, mbobo ndi co nde Mfumu Nyambe.<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />Ta kusili u muntu uju na zige uju a bambene nage kame,</para>
  <para style="q2" vid="HEB 8:11">kampa uku li gambaguza mwalyabo buti, ‘U zibe <optbreak />u Mfumu Nyambe,’</para>
  <para style="q1" vid="HEB 8:11">kakuli bonse kuti na ba ndi zibe,</para>
  <para style="q2" vid="HEB 8:11">ku zwa ku mwanuke gwabo ku ja ku mukulu wawa.<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />Kakuli kuti na ndi ba kwatile u bubi bwabo</para>
  <para style="q2" vid="HEB 8:12">mi ta ndi si vuluki i bitendantu i bimangoju byabo kame.”<note caller="+" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="JER 31:31-34">Jelemiya 31:31-34</ref>. </char></note><verse eid="HEB 8:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13" />Aa sa kuga jeji inzumininano buti “nimpya,” sa kumbika inzumininano jetanzi, mi i cintu ici se ci kumbikitwe ne ci ta ci sebezi se ce ku zwako aano.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s">I milao jo bulapeli bo kale</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />Cwale inzumininano jetanzi ka ji kwesi i milao jo bo ku lapelela mi no cibaka ci cenete ca mwilonga bulyao. <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />Ka ku sumpigwanga Itente. Mu kampetu ketanzi ka ku kalanga inzimano jo lambi jo ntabi ja 7 no ntafule aa ka ba tulanga i binkwa bi cenete. Ka ka kugigwa i Cibaka ci Cenete. <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />Kwisilya lyesila lyabili nko kakuli a kampetu ka ka kugigwa i Cibaka ci Cenete Lwini, <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />u mu ka ku li u lutala lo butale bwa gauda lo ku tulanga insense. Mo kakuli ne ponkisi lyo nzumininano ka li vwikitwe u butale bwa gauda. Momo mwi ponkisi mo kakuli a kazunga ka gauda u mu ka ku li imana, no mulamu gwa Aloni ugu se gu tumpila a mani, no bupapalala bo mabwe go nzumininano. <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />Egulu lyo ponkisi mpo ka ku li i bibumbantu byo makelubbimi byo mpazimo ja Nyambe, na bi vwikite a mabando gabyo a cibaka co nkwatilo jo bitendantu i bimangoju. Kono ta tu goli uku gambagula bya byebi i bintu mu bunokele aano.<figure style="fig" alt="Ark of the covenant in the Most Holy Place" file="cn02092b.jpg" size="col" loc="Heb 9:1-5" ref="9:1-5">I ponkisi lyo nzumininano mu Cibaka ci Cenete Lwini</figure><verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />I bintu byonse aa se bi la tuligwa bulyaa, a mapulisiti ka ba nginanga inako ne nako mu kampetu ka kunze ka sebelezamo. <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />Kono mu cibaka ca mukati, u mupulisiti u mukulu bulyo ka nginangamo lyonke mu mwaka, mi ta ka gola uku nginamo uku ta indite a malowa, aga ka tagilanga kebaka lyakwe no kebaka lyo bitendantu i bimangoju ibi na ba tendanga a bantu mu ku sa ziba. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />U Moya go Kucena kame ka gu sunda ka jejo inzila buti inzila ji ja ku Cibaka ci Cenete Lwini ka ji sini uku zibigwa mu nako jonse Itente lyetanzi aa ka li si sebeza.<verse eid="HEB 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 9:9" />Gogu, mwanza gu julika kwa je jino inako, gu bonisa buti a mampo no bitagilo ibi bi wegwa ta bi goli uku cenesa u mojo go mulapeli. <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />Bebyo ka bi li bintu byo ku lya no ku nywa no byo ku shamba ibi ka bi li milao ja kunze iji ka ji botele uku sebeza ku twala ku nako jo mukalilo u muya.<verse eid="HEB 9:10" /></para>
  <para style="s">A malowa ga Kilesite</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />Kono aa sa la kezi Kilesite ko ku ba u mupulisiti u mukulu go bintu i bilotu ibi se bi liko aano, kale ga ngina Mwitente inene wawa ne li li lulikile wawa ili ta na lya bumbigwa ko maganja go bantu, mi tu te buti ta li li lubazu lo mubumbilo go guno. <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />Ta na ga nginamo ko malowa go tupuli no manamani, kono kame na ga ngina mu Cibaka ci Cenete Lwini lyonke bulyo nela ko malowa gakwe, ka tu gwanina indamwino ji kalilile.<verse eid="HEB 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 9:13" />A malowa go tupuli no bankunzi netwe lyo nkomwana jo citole aga ka ba shanshagilanga a bantu aba ka ba tegwa buti ta ba cenete ka ga ba cenesanga buti ba be aba ba cenete mu mibili jabo. <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />Cwale mbungi bwa buti, ku malowa ga Kilesite, uju sa li wa gemwini ko Moya gu kalilile bu bulite u mulandu kwa Nyambe, ga gola uku cenesa i myojo jetu ku bitendantu ibi bi twala ku lufu, buti tu sebeleze Nyambe a joja!<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />Kebaka leli Kilesite nde muzimanini go nzumininano impya, buti a bantu aba na ba kugigwa ba tambule uku jobola ku kalilile uku na kwa kuluwilizigwa. Aano na ga fwa ku ba intifo jo ku ba lukulula ku bitendantu i bimangoju ibi se ba tenda mu nzumininano jetanzi.<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />Mu ntaba jo ndagano jo mufu, nkwa butokwa uku bonisa u bupaki buti jejo indagano uju sa ji tenda na ga fwa. <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />Kakuli indagano jo muntu sa fwa ji li kwesi inguzu ati ndi wawa jojo u muntu na ga fwa. Indagano ta ji kwesi inguzu u mwini gwajo na si joja.<verse eid="HEB 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 9:18" />Nceco ci leta buti nanga ni nzumininano jetanzi ta ka ji kwesi inguzu uku takuli a malowa. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />Mushe aa sa la gambaguli indagano jo mulao ku bantu bonse, ka indanga a malowa go manamani, antu-onke no menzi, no boja bo ku subila no tutabi to cishamu ca isopa ku shanshagila ipupu no bantu bonse. <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />Ka gambanga a majwi ku ta nage, “Ga ga ngo malowa go nzumininano, iji sa mi laga Nyambe buti mu ji mamele.”<note caller="+" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="EXO 24:8">Lujendo 24:8</ref>. </char></note> <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />Ko mutendelo gu li kozete, ka shanshagilanga ko malowa Itente no bintu byonse ibi ka bi litusisigwa aa ka ba lapelanga. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />Ndiconse wawa, u mulao mbobo ka gu shakila buti i bintu byonse mpace bulyo na bi la cenesigwa ko malowa, mi aa taali isintiko jo malowa taali inkwatilo jo bitendantu i bimangoju.<verse eid="HEB 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />Mbobo ka ku shakaalila, kakuli i bintu ka ba jelekeza byo bintu byegulu ka bi cenesigwa ko bitagilo byebyo, mi i bintu byegulu ibyo wawa ka bi cenesigwa ko bitagilo byo ngana wawa ku ita byebi.<verse eid="HEB 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 9:24" />Kakuli Kilesite ta na ga ngina mu Cibaka ci Cenete ici na ca jakigwa ko maganja go bantu ici ka ci li bukozele bulyo bo cibaka co kucena co niti, kono kame sa ngina mwigulu wawa, ka li bonaaza kwa Nyambe kebaka lyetu. <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />Mi ta na ga ngina mwigulu ka li wa gemwini naa-naa, ubu ka ngininanga u mupulisiti u mukulu mu Cibaka ci Cenete Lwini lyonke mu mwaka no mwaka ko malowa aga ta ka ga li gakwe. <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />Ka li na mbulyao na la pengangi naa-naa ku zwa ilonga aa na lya bumbigwa. Kono sa li bonaaza lyonke bulyo nela ku mamaninino go manako keza ku zwisa i bitendantu i bimangoju ko citagilo cakwe gemwini.<verse eid="HEB 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 9:27" />Sinagwe mbantu aa ba botele uku fwa lyonke, mi ku zwao se ku la keza inkatulo, <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />no Kilesite sa tagilwa lyonke ku inda i bitendantu i bimangoju byo bantu a bangi, kame kuti na bonaale lyabili, sini uku koleka i citendantu i cimangoju, kono ku leta injojeso ku bantu aba ba mu lindile.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="s">I citagilo ca Kilesite ci li kalilile</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />U mulao ka gu li munzule bulyo go bintu i bilotu ibi bi keza, ta gu li u mukalila wawa. Kebaka leli ta gu goli wawa uku lulikiza a bantu aba ba senena kwa Nyambe, ko bitagilo ibi ta bi andene ibi bi tagilwa naa-naa mu mwaka no mwaka ko ku bogwela-bogwela. <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />Ka li na bi gola, ta na bi la lekigwa uku wegwa. Kakuli a balapeli na ba la cenesigwa lyonke bulyo nela, ta na ba la li shugwi uku fosa kebaka lyo bitendantu i bimangoju byabo. <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />Kono byebyo i bitagilo ka bi li bivuluso byo bitendantu i bimangoju bya mu mwaka mu mwaka. <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />Kakuli ta ku golaali buti a malowa go bankunzi no tupuli ga inde i bitendantu i bimangoju.<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />Kebaka lelyo, Kilesite aa na ga keza mwilonga, sa ta nage,</para>
  <para style="b" vid="HEB 10:5" />
  <para style="q1" vid="HEB 10:5">“To ko shaka i citagilo no ciwantu,</para>
  <para style="q2" vid="HEB 10:5">kono na gwa ndi tendela u mubili,<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />to ko jangazwa ko bitagilantu ibi ka bi tentigwa</para>
  <para style="q2" vid="HEB 10:6">no biwantu kebaka lyo bitendantu i bimangoju.<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />Mi kale nda ta neme, ‘Ime juno, ku ja ko bu ku ñolelwe byangu mwi pupu</para>
  <para style="q2" vid="HEB 10:7">na nda keza ku tenda ubu u shakila gwe <optbreak />Nyambe gwangu.’ ”<note caller="+" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="PSA 40:6-8">Nimbo 40:6-8</ref>. </char></note><verse eid="HEB 10:7" /></para>
  <para style="b" />
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8" />Etanzi sa ta buti, “To ko shaka i bitagilo no biwantu, no biwantu bi tentigwa a lutala no biwantu bi tendelwa i bitendantu i bimangoju kampa ku jangazigwa kabyo” no ku ka bi wegwa ku ja ko mulao. <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />Mi kale ga ta nage, “Ime juno, ndi la kezi ku tenda ubu u shakila,” Kale ga kumbika inzumininano jo kale no ku sumpa ja bili. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />Mi ko ku shaka kwakwe koko, na twa cenesigwa ko citagilo co mubili gwa Jesu Kilesite lyonke bulyo nela.<verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />U mupulisiti no mupulisiti ka zimananga mwijuba-mwijuba ku tenda byo musebezi gwakwe go nsebelezo, na wanga i bitagilo ibi ta bi andene naa-naa, ibi ta bi goli wawa uku inda i bitendantu i bimangoju. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />Kono Kilesite u mupulisiti u mukulu gwetu aa sa la wi i citagilo conke ca mu nako jonse bulyo co bitendantu i bimangoju, kale ga ka kala ku mulyo gweganja lya Nyambe, <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />mi ku zwa jejo inako sa li lindile buti aba ba mu zimbite ba kale mwinsi lyakwe sinagwe ncikalo aa lyatila a matende gakwe. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />Kakuli ko citagilo conke na ga lulikiza a bantu bonse ku twala koko aba ba kwesi uku cenesigwa.<verse eid="HEB 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />U Moya go Kucena kame ga sa paka kwetu bulyao kakuli ga sa ta tanzi buti,<verse eid="HEB 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />“Iji ne nzumininano na ndi li kwate nabo</para>
  <para style="q2" vid="HEB 10:16">mwishule lya jejo inako, ubu ndi co nde Mfumu Nyambe.</para>
  <para style="q1" vid="HEB 10:16">Kuti na ndi tule i milao jangu mu myojo jabo,</para>
  <para style="q2" vid="HEB 10:16">mi kuti na ndi ji ñole a ngana jabo.”<note caller="+" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="JER 31:33">Jelemiya 31:33</ref>. </char></note><verse eid="HEB 10:16" /></para>
  <para style="b" />
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17" />Mi kale ga ta kame nage,</para>
  <para style="b" vid="HEB 10:17" />
  <para style="q1" vid="HEB 10:17">“Ta ndi si gaji kame nela byo</para>
  <para style="q2" vid="HEB 10:17">bitendantu i bimangoju no milandu jabo.”<note caller="+" style="x"><char style="xo" closed="false">10:17 </char><char style="xt" closed="false"><ref loc="JER 31:34">Jelemiya 31:34</ref>. </char></note><verse eid="HEB 10:17" /></para>
  <para style="b" />
  <para style="m">
    <verse number="18" style="v" sid="HEB 10:18" />Mi aa se ku li inkwatilo jo bitendantu i bimangoju, ta ku si shakaali i citagilo kame.<verse eid="HEB 10:18" /></para>
  <para style="s">Tu senene afuwi no Nyambe</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />Kebaka lelyo bakwetu, ko ku bona buti tu li kwesi u bundume bo ku ngina mu Cibaka ci Cenete Lwini ko malowa ga Jesu, <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />ko nzila impya no nzila ji joja iji na ga tu galwila ko lufu lwakwe ko ku ñatuka kwesila. <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />Mi ko ku ta buti tu li kwesi u mupulisiti u munene egulu lyo njugo ja Nyambe, <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />ndokweni tu senene afuwi no Nyambe ko myojo ji sepaala no ku logwa ku vumbite uku ku zwa ku nzumino, no myojo jetu ji shanshagilwe ku tu cenesa ku nkengejezi jo bubi na tu kwesi no mibili ji sanzitwe ko menzi ga cenete.<verse eid="HEB 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 10:23" />Ndokweni tu gunzilile bu gongwele ku nsepo iji tu paka, kakuli uju na ga kuluwiza a la sepaala. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />Mi ndokweni tu gaje ubu tu botele uku ligongolekeza mwalyetu mu lushako no bitendantu i bilotu, <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />tu zundamine mu ku gwanananga antu-onke, kakuli bamwinya ta ba si zundamine mu ku gwanananga, mi tu li gongoze mwalyetu ko ku bona buti ijuba lyo keza kwakwe se li li senene.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />Ati na tu tenda i bitendantu i bimangoju na tu fungilebo uku na tu la zibi initi, ao cwale ta kusili i citagilo co bitendantu i bimangoju ci sigalile, <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />kono se ni nindilo ji jogesa bulyo jo nkatulo ji sigalile no jo mulilo u munene ugu na gu tente a bantu ba zimbite Nyambe. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />U muntu gense uju ka kana u mulao gwa Mushe ka yagigwa aa taali inse ko bupaki bo bampaki bo bile kampa bo tatwe. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />Mbuti mu gajila ubu a botele uku bangisezwa ko ntalu u muntu uju na ga shwauza u Mwana Nyambe sinagwe ncintu a lyatagula ko matende, uju na ga zokela ku shwauza a malowa go nzumininano aga na ga mu cenesa, sinagwe ncintu ta ci cenete noju na ga tukagula u Moya go cisemo? <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />Kakuli tu li mwizi uju sa ta buti,</para>
  <para style="b" vid="HEB 10:30" />
  <para style="q1" vid="HEB 10:30">“Uku lomboza nkwangu,</para>
  <para style="q2" vid="HEB 10:30">kuti na ndi lomboze.”<note caller="+" style="x"><char style="xo" closed="false">10:30 </char><char style="xt" closed="false"><ref loc="DEU 32:35">Mulao 32:35</ref>. </char></note></para>
  <para style="b" vid="HEB 10:30" />
  <para style="m" vid="HEB 10:30">Mi kame sa ta buti,</para>
  <para style="b" vid="HEB 10:30" />
  <para style="q1" vid="HEB 10:30">“U Mfumu Nyambe kuti na atule a bantu bakwe.”<note caller="+" style="x"><char style="xo" closed="false">10:30 </char><char style="xt" closed="false"><ref loc="DEU 32:36">Mulao 32:36</ref>; <ref loc="PSA 135:14">Nimbo 135:14</ref>. </char></note><verse eid="HEB 10:30" /></para>
  <para style="b" />
  <para style="m">
    <verse number="31" style="v" sid="HEB 10:31" />Ncintu ci jogesa uku gwila mu maganja ga Nyambe uju a joja.<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />Mu gaje galya a majuba ga mwishule uku se mu la tambuli ituba, aa ka mu zimana bu gongwele mu nkondo inene jo mapenzi. <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />Amwinya ka mu tukaguligwa no ku pengisezwa a kati ko bantu, mi amwinya ka mu zimana antu-onke ku tusa a bantu aba ka ba taluligwa bulyao. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />Ka mu penga no bantu aba ka ba li mu ntolongo mi no ku ka mu tapigwa ibi ka mu munite ka mu jangala, kakuli ka mwizi buti inwe wawa mu li kwesi i bintu i bilotu wawa no lubono lu kalilile.<verse eid="HEB 10:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="HEB 10:35" />Cwale mu leke uku showa u bundume bwenu. Kuti na bu mi letele u mupuzo u munene. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />Mu li botele uku zundamina buti aa se mu la tendi ubu a shakila Nyambe, na mu tambule i bintu na ga kuluwiza. <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />Kakuli,</para>
  <para style="b" vid="HEB 10:37" />
  <para style="q1" vid="HEB 10:37">“Mu nako imfuwi bulyo</para>
  <para style="q2" vid="HEB 10:37">ige uju a keza kuti na keze mi ta na nangise.”<note caller="+" style="x"><char style="xo" closed="false">10:37 </char><char style="xt" closed="false"><ref loc="ISA 26:20">Isaya 26:20</ref>; <ref loc="HAB 2:3">Abakuki 2:3</ref>. </char></note><verse eid="HEB 10:37" /></para>
  <para style="q2">
    <verse number="38" style="v" sid="HEB 10:38" />“Kono uju a lulikile gwangu kuti na joje ko nzumino.</para>
  <para style="q1" vid="HEB 10:38">Mi ati na bogwela mwishule ta na ndi jangazigwe kakwe.”<note caller="+" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="HAB 2:3">Abakuki 2:3</ref>,<ref loc="HAB 2:4">4</ref>. </char></note><verse eid="HEB 10:38" /></para>
  <para style="b" />
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />Kono iswe ta tu li ku bantu aba ba bogwela mwishule no ka jonauka, kono nku bantu ba kwesi inzumino tu li mi twa sa jojeswa.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s">Inzumino mu bitendantu</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />Cwale inzumino nku ba no bundume mu bintu ibi tu sepete no ku logwa ku bintu ibi ta tu wene. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />Nkebaka lyo nzumino jabo a bantu ba ku kale aa na ba gambigwa nenja.<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />Ko nzumino twa sa shugwilisa buti i bintu byonse na bya bumbigwa keejwi lya Nyambe, buti i bintu ibi bi bonaala ta na bya bumbigwa ku zwa a bintu ibi ka bi bonaala.<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />Ko nzumino Abele sa letela Nyambe i citagilo i cilotu ku ita ubu sa tendela Kaine. Ko nzumino sa lumbigwa buti a li lulikile, Nyambe aa sa gamba nenja ko biwantu byakwe. Mi ko nzumino Abele a si gamba, nanganceciba buti na ga fwa.<verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />Ko nzumino Inoki sa indigwa ku zwa mwa bo buno u bumi, buti na leke uku ita mu lufu. “Ta sa gwanaala, kakuli Nyambe sa mu inda.”<note caller="+" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="GEN 5:24">Matatikilo 5:24</ref>. </char></note> Kakuli aa ka sini uku indigwa, sa lumbigwa ko ku ba jumwinya sa jangaza Nyambe. <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />Mi aa takuli inzumino ta ku golaali uku jangaza Nyambe, kakuli u muntu gense uju a keza kwakwe a li botele uku zumina buti nkwali mi kame ndege a wa u mupuzo kwa babo ba zundamina uku mu shaka.<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />Nka nzumino Nuwe, aa na ga nanguzwa ko bintu ibi ka bi sini uku bonigwa, mu lyoga li cenete kale ga jaka aleka buti a jojese u luasi lwakwe. Ko nzumino jakwe kale ga atula a bantu ba mwilonga mi kale ga ba u muntu uju a lulikile ku ja ko nzumino.<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />Nka nzumino Abbulaama, aa na ga kugigwa buti a je ku cibaka ici ka botele uku jobola mu majuba ka ga si keza, kale ga kutika no ku jako, nanganceciba buti ta kezi uku kaja. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />Ko nzumino kale ga ka joja mwilonga lyo nkuluwizi sinagwe nu nyenda uju a li mwilonga ilingi, na joja mu matente, ubu na ga tendela Isaka no Jakobo aa na ba ba a bajoboli bo nkuluwizi iji ta ji andene antu-onke nage. <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />Kakuli kame ka zilwize u munzi u munene ugu gu kwesi insumpo, mi u mufunwini gwago no mujaki gwago ndi Nyambe.<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />Mi ko nzumino nanga ndi Sala, uju se ka zwite ku ku bona u luasi kebaka lyo bukalamba, sa goliswa uku bona a bana kakuli sa inda Nyambe buti a la sepaala uju sa mu kuluwiza. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />Mi ku zwa kwa jojo unkosi genke se ku zwa a maasi a mangi sinagwe ni ntungwezi ja kwigulu mi ta ka ga golaala uku baligwa sinagwe ndi bwetete lya ekamba lyewate, no ku se ka indigwa buti a li fwite kebaka lyo bukalamba lwini.<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />Baba a bantu bonse ka ba si joja mu nzumino ku twala ku ku fwa kwabo. Ta se ba tambula i bintu na bya kuluwizwa, mbulyo se ba bi bonena u kule bu jangele, na ba li gamba abo beni buti mbazwa-malonga mi mbanyenda mwilonga. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />A bantu aba ba gamba i bintu bya bulyao ba sa bonisa buti ndilonga lyabo wawa ba shaka. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />Ka li ka ba si kwesi uku gaja byelonga ili na ba leka, na ba la bi no kaito ko ku bogola. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />Kono kame ka ba zilwize ilonga ilotu wawa, lya kwigulu. Kebaka lelyo Nyambe ta fwi inshoni uku kugigwa buti ndi Nyambe gwabo, kakuli na ga ba lukiseza u munzi.<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />Nka nzumino Abbulaama, aa na ga tatubigwa kwa Nyambe, sa wa mwane Isaka ku ba i citagilo. Abbulaama uju se ka tambwile inkuluwizi se ka litukiseze uku tenda mwane genke bulyo i citagilo, <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />nanganceciba buti Nyambe sa gamba kwakwe buti, “Nka Isaka bulyo a maasi gako aa na ga baligwe.”<note caller="+" style="x"><char style="xo" closed="false">11:18 </char><char style="xt" closed="false"><ref loc="GEN 21:12">Matatikilo 21:12</ref>. </char></note> <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />Abbulaama kale ga gaja buti Nyambe ka gola nanga nku busa a bafu, mi ko mugambilo bulyo kale ga bogolekezwa Isaka sinagwe nku bafu a la buki.<figure style="fig" alt="Abraham and Isaac" file="co00663b.jpg" size="col" loc="Heb 11:17-19" ref="11:17-19">Abbulaama no Isaka</figure><verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />Ko nzumino Isaka kale ga wa imfwijaguzi kwa Jakobo no Isau kebaka lyo bumi bwabo bo majuba ga keza.<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />Ko nzumino Jakobo aa se ka li afuwi no ku fwa, kale ga wa bana ba Josefa imfwijaguzi mi kale ga lapela na gongolele a lutaga lwakwe.<verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />Ko nzumino Josefa a mamaninino gakwe aa se ka ga li afuwi, kale ga gamba byo lujendo lo bantu ba Isilaele lo ku zwa mwilonga lya Egepita no ku ba wa ubu na ba tendele aa na ba zike i bifuwa byakwe.<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />Ko nzumino a bazazi ba Mushe se ba mu bika a myezi jo tatwe ku zwa aa na ga bonenwa, kakuli na ba bona buti ka li mwana u mulotu, mi ta na ba joga u mulao go mfumu.<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />Ko nzumino Mushe aa sa la ku li, kale ga kana uku zibaala buti nyina ndi mwana Falo. <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />Kale ga li shalila uku taluligwa antu-onke no bantu ba Nyambe ku ita uku likola iminyakulo iji ji ita bulyo jo bitendantu i bimangoju. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />Kale ga inda buti uku shugwa inshoni kebaka lya Kilesite nkwa butokwa lwini ku ita u lubono lwa mwilonga lya Egepita, kakuli ka zilwize u mupuzo gwakwe ugu ka gu keza. <verse eid="HEB 11:26" /><verse number="27" style="v" sid="HEB 11:27" />Ko nzumino kale ga zwa mwilonga lya Egepita uku ta jogete u bunyegezi bo mfumu mi kale ga zundamina kakuli se ka wene uju ta bonwa. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />Ko nzumino kale ga tenda i Mpaseka no byo ku shanshagila a malowa, buti u mujoni go baeli a leke uku kwata a mueli go bantu ba Isilaele.<verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />Ko nzumino a bantu ba Isilaele kale ba itila Mwiwate lyo ku Subila sinagwe mpevu lyo ku juma, kono a Maegepita aa na ba jeleka uku tenda bulyao, kale ba lobela.<verse eid="HEB 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30" />Ko nzumino a mamota ga Jeliko kale ga gwa, a Maisilaele aa se ba la ga zimbuluki mu majuba ga 7.<verse eid="HEB 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="HEB 11:31" />Ko nzumino u mwanakazi go cise Laaba, ta sa yagigwa antu-onke no bantu aba ta ka ba zumine, kakuli sa tambula a bajunji.<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />Mi mbinzi kame ibi sa ka ndi gambe? Ta ndi kwesi inako jo ku gamba bya Gidioni, no bya Bbalaki, no bya Samisoni no Jafeta, no bya Deviti no Samuele mane no byo baboni ba Nyambe, <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />aba se ba gola i mibuso ko nzumino, no ku tenda ici ci lulikile, mi kale ba gwana ibi na bya kuluwizwa. A ba se ba fwinka u tunwa to bandavu, <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />se ba zima u bushanshu bo ndimi jo mulilo, no ku anda ku bucesi bo kafulo a kanene. Uku bula inguzu kwabo kale kwa zoligwa u bukozu, mi se ba ba bo nguzu mu nkondo no ku gola a masole bo malonga ga kungi. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />A banakazi se ba tambula a bafu babo, aba na ba busigwa buti ba joje kame. Nko ba li bamwinya aba ka ba bangisigwa, mi ka ba kana uku lukululigwa buti na ba gwane imbuko indotu wawa. <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />Bamwinya ka ba nyungululwa no ku shapigwa, mane no ku shuminigwa ko mawenge no ku tuligwa mu matolongo. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />Ka ba yagigwa ko ku sobagulwa ko mabwe,<note caller="+" style="f"><char style="fr" closed="false">11:37 </char><char style="ft" closed="false">A mabuka gamwinya go kale na ga nunga ku mugambilo go ku sobagulwa ko mabwe buti, na ba jelekigwa.</char></note> ka ba saigwa akati, mi ka ba yagigwa ko kafulo a kanene. Ka ba jenda bu zwesi i mikumba jongu no mikumba jo tupuli, bu bulite i bintu, bu pengisigwa no ku taluligwa, <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />ilonga ta ka li ba botele. Ka ba jenda na ba jambangila mu mangusu no mu malundu, na ba joja mu malambo ga mu mabwe no mu malambo ga mwivu.<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />Bonse babo na ba lumbigwa ko nzumino jabo, kono takuli nanga genke gwabo uju na ga tambula ibi na bya kuluwizwa, <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />kakuli Nyambe sa tu gajila i bintu i bilotu wawa buti twense aa tu li gwana nabo bi lulikizwe nenja.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s">Nyambe ndi Setu</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />Cwale, ko ku ta buti iswe tu li zimbulukitwe ku bampaki a bangi aba ba kozete sinagwe ndijoba inene, ndokweni tu zwise i bintu byonse ibi bi tu kangwisa no bitendantu i bimangoju ibi bi tu gunzilile ko butole. Mi tu tige ko ku li gongoza intigo iji tu li kwajo, <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />na tu lolelele bulyo kwa Jesu, u mutangilili no mululikizi go nzumino jetu. Kakuli ko ku jangala uku ka ku mu lindile na ga li gongoza ku cifapaano, no ku shwauza inshoni jaco, mi kale ga kala ku mulyo gweganja lyo cikalo co bumfumu ca Nyambe. <verse eid="HEB 12:2" /><verse number="3" style="v" sid="HEB 12:3" />Mu mu gaje ige uju na ga li gongoza mu nkondo ja bulyao jo batendi bo bimangoju, buti mu leke uku kotela no ku suwa i myojo.<verse eid="HEB 12:3" /></para>
  <para style="s">Nyambe ga sa laga bane</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 12:4" />Mu nkondo jenu jo ku lwa no bitendantu i bimangoju, ta na mwa sika a nako jo ku yagigwa. <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />Mi buti se mu li zibele wawa leli ijwi lyo ku gongozwa ili li mi bonisa sinagwe muzazi go nkosi aa gamba kwa mwane? Mbuti li co buti,</para>
  <para style="b" vid="HEB 12:5" />
  <para style="q1" vid="HEB 12:5">“Mwanangu, u leke uku ubisa a majwi go Mfumu Nyambe <optbreak />aa ku laga,</para>
  <para style="q2" vid="HEB 12:5">mi u leke uku suwa u mojo aa ku jukukila,<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />kakuli u Mfumu Nyambe ga sa laga u muntu uju a shaka,</para>
  <para style="q2" vid="HEB 12:6">mi ga sa shapa u muntu gense uju a tambula ko ku <optbreak />ba mwane.”<note caller="+" style="x"><char style="xo" closed="false">12:6 </char><char style="xt" closed="false"><ref loc="PRO 3:11">Milya 3:11</ref>,<ref loc="PRO 3:12">12</ref>. </char></note><verse eid="HEB 12:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />Mu gongole mu makababu sinagwe nku lagigwa. Nyambe kame a mi tenda sinagwe mbane. Kakuli buti nko ba li a bana aba ta ba lagigwa kwe sabo? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />Ati ta mu lagigwa, mi bamwinya bonse na ba lagigwa elu ta mu si li a bana wawa se mu li bana ba mu bunyazi. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />Nanganceciba bulyao, twense ka tu kwesi besetu bo buntu aba na ba tu laga mi na twa ba kutika kebaka lelyo. Ta li mane tu li botele uku li tula kwinsi no ku ita kwe Setu go myoya buti tu joje!<verse eid="HEB 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 12:10" />Na ba tu laga a nako imfuwi bulyo ko bu ka ba gajila buti mbobo, kono Nyambe ga sa tu laga ku tu tusa, buti tu gole uku li taila mu kucena kwakwe. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />Takuli uku lagigwa uku ku bonaalanga u bulotu mwa jejo inako, kono nku shisha. Nanga na ku li bulyao aa se ku la iti inako, kwa sa leta u muzimbu go ku tenda ubu a shakila Nyambe no ku joja nenja kwa babo na ba sholezwa bulyao.<verse eid="HEB 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />Cwale, mu gongoze a maganja genu aga ta ga kwesi inguzu no mazwi genu aga ta ga kwesi inguzu. <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />“Mu tendele nenja a matende genu a mazila,”<note caller="+" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="PRO 4:26">Milya 4:26</ref>. </char></note> buti itende ili li kubele li leke uku kangwa, kono li ozwe.<verse eid="HEB 12:13" /></para>
  <para style="s">Inanguzo no ñongozo</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />Mu tende ubu mu golela bonse buti mu joje nenja no muntu gense no kucena. Aa takuli u kucena takuli u muntu na bone u Mfumu. <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />Mu bone buti takuli u muntu uju a koshokelwa ku cisemo ca Nyambe no ku ta buti ku leke uku ba no muntu uju a kozete sinagwe muisi go kulula ugu gu ku la no ku leta a makababu no ku jona a bantu a bangi. <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />Mu bone buti takuli u muntu uju a tenda i cise, kampa uju ta kutiki Nyambe sinagwe ndi Isau, uju sa gulisa u mubotelelo gwakwe go bweli ko mutailo gonke go bilyo. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />Aa se ku la iti inako, sinagwe ubu mu zibile, aa na ga shaka buti a gwane jeji imfwijaguzi, kale ga kanigwa. Nanganceciba buti na ga ji lilila ko minsozi, ta ka gola uku cinca ici na ga tenda.<verse eid="HEB 12:17" /></para>
  <para style="s">Byo lyoga no byo ku jangala</para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />Ta na mwa keza kwilundu ili li gola uku kwatigwa ne li li ya ku mulilo, ku kansindwe ka siite lwini no nkuli jo kaungwe-ungwe, sinagwe ubu na ba tendela a Maisilaele elundu lya Sinai. <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />Ku ntolombita ji lila kampa kwijwi li gamba a majwi buti aba na ba li shugwa kale ba kumbila buti ijwi li leke uku gamba kwabo kame, <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />kakuli ta ka ba gola uku li gongoza kwe ci na ca lagigwa, “Ati nanga ncipagu aa ci kwata ilundu, ci li botele uku sobaguligwa ko mabwe mane na ci fwa.”<note caller="+" style="x"><char style="xo" closed="false">12:20 </char><char style="xt" closed="false"><ref loc="EXO 19:12">Lujendo 19:12</ref>,<ref loc="EXO 19:13">13</ref>. </char></note> <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />U mubonaalilo ka gu jogesa wawa buti mane Mushe kale ga ta buti, “Nda sa tutuma kebaka lyo bujoge.”<note caller="+" style="x"><char style="xo" closed="false">12:21 </char><char style="xt" closed="false"><ref loc="DEU 9:19">Mulao 9:19</ref>.</char></note><verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />Kono na mwa keza Kwilundu lya Sione, ku munzi gwa Nyambe uju a joja, u munzi gwa Jelusalema gwa kwigulu. Na mwa keza ku mañiloi ga sika a mpalo jo ma 1,000 ga kambi a ma 1,000 ku nkongani jo njangalo, <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />na mwa keza ku kagugi ko bazumini bo baeli, bo mazina ga ñoletwe kwigulu. Na mwa keza kwa Nyambe, u muatuli go bantu bonse, no ku myoya jo bantu a bagomba na ba ba lulikile. <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />Na mwa keza kwa Jesu u muzimanini go nzumininano impya, no ku malowa aga se ga shanshagilwa aga ga gamba ijwi ilotu ku ita a malowa ga Abele.<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />Mu bone buti ta mu kani u muntu uju a gamba. Ati ta na ba anda aa na ba kana uju sa ba nanguza ansi, iswe mbuti na tu andile, ati na tu futatila no ku zwa kwakwe uju a tu nanguza na zwa kwigulu? <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />Mwa je jilya inako ijwi lyakwe se li ukusa ilonga, kono aano na ga kuluwiza buti, “Kuti na ndi bogweleo uku ukusa kame ilonga mi ntali ndilonga bulyo kono negulu bulyao.”<note caller="+" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="HAG 2:6">Agai 2:6</ref>. </char></note> <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />Aa ku gambigwa buti “kame” kwa sa bonisa buti i bintu byonse ibi bi gola uku ukuswa, ibi na bya bumbigwa kuti na bi zwisigweko, buti ibi ta bi goli uku ukuswa na bi sigale.<verse eid="HEB 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28" />Cwale, ko ku ta buti mubuso tu tambula ugu ta gu goli uku ukuswa, tu litumele, mi tu lapele Nyambe ko mutendelo ugu gu tambulwa nekute no bujoge. <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />Kakuli “Nyambe gwetu mulilo gu tenta ku jongisa.”<note caller="+" style="x"><char style="xo" closed="false">12:29 </char><char style="xt" closed="false"><ref loc="DEU 4:24">Mulao 4:24</ref>. </char></note><verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s">Inanguzo jo mamaninino</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />Mu zundamine uku li shaka mwalyenu sinagwe mbana bo luasi lonke. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />Mu leke uku zibala uku tambula a banyenda, kakuli ko ku tenda bulyao a bantu bamwinya se ba tambula a mañiloi ko ku sa ziba. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />Mu zundamine uku vuluka babo ba li mu ntolongo sinagwe mu ntolongo mu kele nabo, no babo ba taluligwa sinagwe nenwe bulyao kame mu pengisigwa.<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />A maseswa ga li botele uku kutikigwa ku bantu bonse, mi unkosi no mwanakazi ba sepaale jumwinya kwa jumwinya, kakuli Nyambe kuti na atule aba ba lala no baka bantu no bo cise bonse. <verse eid="HEB 13:4" /><verse number="5" style="v" sid="HEB 13:5" />Mu ligunge ku ku suna a masheleñi mi mu logwe ibi mu kwesi, kakuli Nyambe sa ta buti,</para>
  <para style="b" vid="HEB 13:5" />
  <para style="q1" vid="HEB 13:5">“Ta na ndi mi leke,</para>
  <para style="q2" vid="HEB 13:5">ta na ndi mi lekelele.”<note caller="+" style="x"><char style="xo" closed="false">13:5 </char><char style="xt" closed="false"><ref loc="DEU 31:6">Mulao 31:6</ref>. </char></note><verse eid="HEB 13:5" /></para>
  <para style="b" />
  <para style="m">
    <verse number="6" style="v" sid="HEB 13:6" />Mi ko ku tenda bulyao twa sa gamba ko bundume,</para>
  <para style="b" vid="HEB 13:6" />
  <para style="q1" vid="HEB 13:6">“U Mfumu Nyambe nde mutusi gwangu, ta na ndi joge.</para>
  <para style="q2" vid="HEB 13:6">Ncinzi ba gola uku ndi tenda a bantu?”<note caller="+" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false"><ref loc="PSA 118:6">Nimbo 118:6</ref>,<ref loc="PSA 118:7">7</ref>. </char></note><verse eid="HEB 13:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />Mu vuluke a bajendesi benu, aba se ba gamba ijwi lya Nyambe kwenu. Mu gaje i bintu ibi na bya zwa mu mujojelo gwabo go bumi mi mu zigize inzumino jabo. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />Jesu Kilesite ta andene ubu ka kalile ijona no shunu a si kele bulyao mane no ku twala koko.<verse eid="HEB 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 13:9" />Mu leke uku ungululwa ku mukalilo gonse go nzigo ji andene. Mbulotu i myojo jetu aa ji gongozwa ko cisemo, sini ko ku lya i bilyo byo milao, ibi ta bi kwesi intuso kwa babo ba tenda bulyao. <verse eid="HEB 13:9" /><verse number="10" style="v" sid="HEB 13:10" />Tu li kwesi u lutala aa ta ba zumininwa uku lilao a bantu aba ba beleka Mwitente.<verse eid="HEB 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 13:11" />U mupulisiti u mukulu ga sa inda a malowa go bipagu no ku ga twala mu Cibaka ci Cenete Lwini ko ku ba sinagwe ncitagilo co bitendantu i bimangoju, kono i mibili ijo ja sa tentelwa kunze jo mafulo. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />Mi ko ku tenda bulyao Jesu nage sa pengela kunze jo munzi buti a bantu ba cenesegwe ko malowa gakwe. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />Ndokweni cwale, tu je kwakwe kunze jo mafulo, tu shugwe inshoni sa shugwa. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />Kakuli ko kuno ta tu kwesi u munzi ugu gu kalilile, kono kame tu zilwize u munzi ugu gu si keza.<verse eid="HEB 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 13:15" />Cwale, ka Jesu, ndokweni tu zundamine uku wa i citagilo co malumbo kwa Nyambe, ko ku shugwaalisa ko milomo jetu a malumbo ga lumba izina lyakwe. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />Mu leke uku zibala uku tenda nenja no ku li taila i bintu no bamwinya, kakuli ka byebyo i bitagilo Nyambe ga sa jangala.<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />Mu kutike a bajendesi benu mi mu li tule kwinsi lyo bujendesi bwabo, kakuli ba la mi unela ko ku ba buti mbabo ba botele uku li tabilila. Mu tende bulyao buti u musebezi gwabo na gu be uku jangala, sini uku ba u muzigo, kakuli ceco ta na ca ba no ntuso kwenu.<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />Mu tu lapelele. Ta tu mamanyi mi tu li kwesi u mojo ugu gu lulikile no ku shaka uku joja kekute ko mutendelo gonse. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />Ime wawa nda sa mi kumbila buti mu lapele izo ndi bogolekezwe wangu kwenu.<verse eid="HEB 13:19" /></para>
  <para style="s">A manzuminizo go mamaninino</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />Cwale Nyambe go ku joja nenja, ko malowa go nzumininano iji ta ji mani sa busa Mfumwetu Jesu ku bafu, uju a li Mulisani u munene gongu, <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />a mi we i bintu byonse i bilotu ibi mu zunda buti mu tende ubu a shakila, mi a sebeze kwetu i bintu ibi bi mu jangaza, ka Jesu Kilesite mi impazimo ji be kwa Kilesite ku twala koko. Ameni.<verse eid="HEB 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />Bakwangu, nda sa mi kumbila buti mu shugwane nejwi lyangu lyo ku mi laga, mi initi nja ku ta buti se ndi mi ñolela ko bufuwi bulyo.<verse eid="HEB 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 13:23" />Nda sa shaka buti mu zibe buti u mukwetu Timoteya na ga zwisigwa mu ntolongo. Ati na sika wangu, kuti na ndi keze nage keza ku mi bona.<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />Mu zuminize a bajendesi benu bonse no bantu bonse bo Mfumu Nyambe. A bantu ba mwilonga lya Italiya ba sa mi zuminiza.<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />I cisemo ci be nenwe mwense.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>