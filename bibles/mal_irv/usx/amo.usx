<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id" />
  <para style="ide">UTF-8</para>
  <para style="h">ആമോസ്</para>
  <para style="toc1">ആമോസ്</para>
  <para style="toc2">ആമോ.</para>
  <para style="toc3">ആമോ.</para>
  <para style="mt">ആമോസ്</para>
  <para style="is">ഗ്രന്ഥകര്‍ത്താവ്</para>
  <para style="ip">ആമോസ്പ്രവാചകനാണ് ഈ പുസ്തകത്തിന്‍റെ എഴുത്തുകാരൻ. തെക്കോവയിൽ ഒരു കൂട്ടം ഇടയന്മാരുടെ മധ്യത്തിലാണ് ആമോസ് പാർത്തിരുന്നത്. താനൊരു പ്രവാചക കുടുംബത്തിൽ നിന്നല്ല വന്നിട്ടുള്ളതെന്നും സ്വയം ഒരു പ്രവാചകനായി കരുതുന്നില്ല എന്നും ആമോസ് വ്യക്തമാക്കിയിട്ടുണ്ട്. ദൈവം വെട്ടുക്കിളി കൊണ്ടും തീകൊണ്ടും ദേശത്തെ ന്യായംവിധിക്കും എന്ന് അരുളിച്ചെയ്തപ്പോൾ ആമോസ് പ്രവാചകന്‍റെ പ്രാർത്ഥനയാൽ യിസ്രായേൽ ജനത്തെ അത് വിട്ടുമാറുന്നു.</para>
  <para style="is">എഴുതപ്പെട്ട കാലഘട്ടവും സ്ഥലവും</para>
  <para style="ip">ഏകദേശം ക്രി മു. 760-750.</para>
  <para style="ip">വടക്കേ രാജ്യത്തെ ബെതേലിലും ശമര്യയിലുമാണ് ആമോസ് ശുശ്രൂഷിച്ചത്.</para>
  <para style="is">സ്വീകര്‍ത്താക്കള്‍</para>
  <para style="ip">വടക്കേ രാജ്യത്തിലെ നിവാസികൾ ആണ് ഇതിലെ പ്രധാന ശ്രോതാക്കൾ, അതുപോലെ മറ്റു വായനക്കാർ.</para>
  <para style="is">ഉദ്ദേശ്യം</para>
  <para style="ip">നിഗളം ദൈവം വെറുക്കുന്നു. സ്വയം പ്രാപ്തരായി എന്ന മിഥ്യാധാരണ തങ്ങൾക്ക് എല്ലാം നൽകിയ ദൈവത്തെ ഉപേക്ഷിക്കുവാൻ കാരണമായിത്തീർന്നു. കര്‍ത്താവ് എല്ലാവരെയും അംഗീകരിക്കുന്നു. ദരിദ്രരെ ചൂഷണം ചെയ്യുന്നതിനെതിരെ ദൈവം മുന്നറിയിപ്പ് നൽകുന്നു. ദൈവത്തെ മാനിച്ചുകൊണ്ട് സത്യത്തിൽ അവനെ ആരാധിപ്പാൻ ദൈവം ജനത്തോട് ആവശ്യപ്പെടുന്നു. മറ്റുള്ളവരെ അവഗണിച്ച് അവരെ കാര്യസാധ്യത്തിനുവേണ്ടി ചൂഷണം ചെയ്യുകയും സ്വന്തം കാര്യങ്ങൾക്ക് വേണ്ടി മാത്രം ചിന്തിക്കുകയും ചെയ്യുന്ന യിസ്രായേലിനോടാണ് ആമോസ് ഈ സന്ദേശം അറിയിക്കുന്നത്.</para>
  <para style="is">പ്രമേയം</para>
  <para style="ip">ന്യായവിധി</para>
  <para style="iot">സംക്ഷേപം</para>
  <para style="io1">1. ദേശത്തിൻ്റെ നാശം — 1:1-2:16</para>
  <para style="io1">2. പ്രവാചക വിളി — 3:1-8</para>
  <para style="io1">3. യിസ്രായേലിന്മേല്‍ ഉള്ള ന്യായവിധി — 3:9-9:10</para>
  <para style="io1">4. പുനഃസ്ഥാപനം — 9:11-15</para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />തെക്കോവയിലെ ഇടയന്മാരിൽ ഒരുവനായ ആമോസ്, യെഹൂദാ രാജാവായ ഉസ്സീയാവിന്‍റെയും യിസ്രായേൽ രാജാവായ യോവാശിന്‍റെ മകനായ യൊരോബെയാമിന്‍റെയും കാലത്ത്, ഭൂകമ്പത്തിന് രണ്ടു വര്‍ഷം മുമ്പ് യിസ്രായേലിനെക്കുറിച്ച് ദർശിച്ച വചനങ്ങൾ.<verse eid="AMO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2" />അവൻ പറഞ്ഞത്:</para>
  <para style="b" vid="AMO 1:2" />
  <para style="q1" vid="AMO 1:2">“യഹോവ സീയോനിൽനിന്ന് ഗർജ്ജിക്കും;</para>
  <para style="q2" vid="AMO 1:2">യെരൂശലേമിൽനിന്ന് തന്‍റെ നാദം കേൾപ്പിക്കും.</para>
  <para style="q1" vid="AMO 1:2">അപ്പോൾ ഇടയന്മാരുടെ മേച്ചല്പുറങ്ങൾ ദുഃഖിക്കും;</para>
  <para style="q2" vid="AMO 1:2">കർമ്മേലിന്‍റെ കൊടുമുടി വാടിപ്പോകും.”<verse eid="AMO 1:2" /></para>
  <para style="s">യിസ്രായേലിന്‍റെ അയൽക്കാർക്കുള്ള ന്യായവിധി</para>
  <para style="s">സിറിയ</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3" />യഹോവ ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:</para>
  <para style="b" vid="AMO 1:3" />
  <para style="q1" vid="AMO 1:3">“ദമാസ്കോസിന്‍റെ മൂന്നോ നാലോ അതിക്രമംനിമിത്തം,</para>
  <para style="q2" vid="AMO 1:3">അവർ ഗിലെയാദിനെ ഇരിമ്പുമെതിവണ്ടികൊണ്ട് മെതിച്ചിരിക്കുകയാൽ തന്നെ,</para>
  <para style="q2" vid="AMO 1:3">ഞാൻ ശിക്ഷ മടക്കിക്കളയുകയില്ല.<verse eid="AMO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 1:4" />ഞാൻ ഹസായേൽഗൃഹത്തിൽ ഒരു തീ അയയ്ക്കും;</para>
  <para style="q2" vid="AMO 1:4">അത് ബെൻ-ഹദദിന്‍റെ അരമനകളെ ദഹിപ്പിച്ചുകളയും.<verse eid="AMO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 1:5" />ഞാൻ ദമാസ്കോസിന്‍റെ ഓടാമ്പൽ തകർത്ത്,</para>
  <para style="q2" vid="AMO 1:5">ആവെൻതാഴ്വരയിൽനിന്ന് നിവാസിയെയും<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="fq" closed="false">നിവാസിയെയും </char><char style="ft" closed="false">രാജാവിനെയും </char></note></para>
  <para style="q1" vid="AMO 1:5">ഏദെൻഗൃഹത്തിൽനിന്ന് ചെങ്കോൽ പിടിക്കുന്നവനെയും ഛേദിച്ചുകളയും;</para>
  <para style="q2" vid="AMO 1:5">അരാമ്യർ ബദ്ധന്മാരായി കീറിലേക്ക് പോകേണ്ടിവരും”</para>
  <para style="q2" vid="AMO 1:5">എന്ന് യഹോവ അരുളിച്ചെയ്യുന്നു.<verse eid="AMO 1:5" /></para>
  <para style="s">ഫെലിസ്ത്യ</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6" />യഹോവ ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:</para>
  <para style="q1" vid="AMO 1:6">“ഗസ്സയുടെ മൂന്നോ നാലോ അതിക്രമംനിമിത്തം,</para>
  <para style="q2" vid="AMO 1:6">അവർ ബദ്ധന്മാരെ മുഴുവൻ ഏദോമിന് ഏല്പിക്കേണ്ടതിന് കൊണ്ടുപോയിരിക്കുകയാൽ,</para>
  <para style="q2" vid="AMO 1:6">ഞാൻ ശിക്ഷ മടക്കിക്കളയുകയില്ല.<verse eid="AMO 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 1:7" />ഞാൻ ഗസ്സയുടെ മതിലിനകത്ത് ഒരു തീ അയയ്ക്കും;</para>
  <para style="q2" vid="AMO 1:7">അത് അതിന്‍റെ അരമനകളെ ദഹിപ്പിച്ചുകളയും.<verse eid="AMO 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 1:8" />ഞാൻ അസ്തോദിൽനിന്ന് നിവാസിയെയും</para>
  <para style="q2" vid="AMO 1:8">അസ്കലോനിൽനിന്ന് ചെങ്കോൽ പിടിക്കുന്നവനെയും</para>
  <para style="q2" vid="AMO 1:8">ഛേദിച്ചുകളയും;</para>
  <para style="q1" vid="AMO 1:8">എന്‍റെ കൈ എക്രോന്‍റെ നേരെ തിരിക്കും;</para>
  <para style="q2" vid="AMO 1:8">ഫെലിസ്ത്യരിൽ ശേഷിപ്പുള്ളവർ നശിച്ചുപോകും”</para>
  <para style="q2" vid="AMO 1:8">എന്ന് യഹോവയായ കർത്താവ് അരുളിച്ചെയ്യുന്നു.<verse eid="AMO 1:8" /></para>
  <para style="s">സോർ</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9" />യഹോവ ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:</para>
  <para style="b" vid="AMO 1:9" />
  <para style="q1" vid="AMO 1:9">“സോരിന്‍റെ മൂന്നോ നാലോ അതിക്രമംനിമിത്തം,</para>
  <para style="q2" vid="AMO 1:9">അവർ സഹോദരസഖ്യത ഓർക്കാതെ</para>
  <para style="q1" vid="AMO 1:9">ബദ്ധന്മാരെ മുഴുവൻ ഏദോമിന് ഏല്പിച്ചുകളഞ്ഞിരിക്കുകയാൽ,</para>
  <para style="q2" vid="AMO 1:9">ഞാൻ ശിക്ഷ മടക്കിക്കളയുകയില്ല.<verse eid="AMO 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 1:10" />ഞാൻ സോരിന്‍റെ മതിലിനകത്ത് ഒരു തീ അയയ്ക്കും;</para>
  <para style="q2" vid="AMO 1:10">അത് അതിന്‍റെ അരമനകളെ ദഹിപ്പിച്ചുകളയും.”<verse eid="AMO 1:10" /></para>
  <para style="s">എദോം</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11" />യഹോവ ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:</para>
  <para style="b" vid="AMO 1:11" />
  <para style="q1" vid="AMO 1:11">“ഏദോമിന്‍റെ മൂന്നോ നാലോ അതിക്രമംനിമിത്തം,</para>
  <para style="q2" vid="AMO 1:11">അവൻ തന്‍റെ സഹോദരനെ വാളോടുകൂടി പിന്തുടർന്ന്,</para>
  <para style="q1" vid="AMO 1:11">തന്‍റെ കോപം സദാകാലം ജ്വലിക്കുവാൻ തക്കവിധം</para>
  <para style="q2" vid="AMO 1:11">അനുകമ്പ വിട്ടുകളയുകയും</para>
  <para style="pi" vid="AMO 1:11">ക്രോധം സദാകാലം വച്ചുകൊള്ളുകയും ചെയ്തിരിക്കുകയാൽ,</para>
  <para style="q2" vid="AMO 1:11">ഞാൻ ശിക്ഷ മടക്കിക്കളയുകയില്ല.<verse eid="AMO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 1:12" />ഞാൻ തേമാനിൽ ഒരു തീ അയയ്ക്കും;</para>
  <para style="q2" vid="AMO 1:12">അത് ബൊസ്രയിലെ അരമനകളെ ദഹിപ്പിച്ചുകളയും.”<verse eid="AMO 1:12" /></para>
  <para style="s">അമ്മോൻ</para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13" />യഹോവ ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:</para>
  <para style="b" vid="AMO 1:13" />
  <para style="q1" vid="AMO 1:13">“അമ്മോന്യരുടെ മൂന്നോ നാലോ അതിക്രമംനിമിത്തം,</para>
  <para style="q2" vid="AMO 1:13">അവർ തങ്ങളുടെ അതിരുകൾ വിസ്താരമാക്കേണ്ടതിന്</para>
  <para style="q1" vid="AMO 1:13">ഗിലെയാദിലെ ഗർഭിണികളെ പിളർന്നുകളഞ്ഞിരിക്കുകയാൽ,</para>
  <para style="q2" vid="AMO 1:13">ഞാൻ ശിക്ഷ മടക്കിക്കളയുകയില്ല.<verse eid="AMO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 1:14" />ഞാൻ രബ്ബയുടെ മതിലിനകത്ത് ഒരു തീ കത്തിക്കും;</para>
  <para style="q2" vid="AMO 1:14">അത് യുദ്ധദിവസത്തിലെ ആർപ്പോടും</para>
  <para style="q1" vid="AMO 1:14">ചുഴലിക്കാറ്റിന്‍റെ നാളിലെ കൊടുങ്കാറ്റോടുംകൂടി</para>
  <para style="q2" vid="AMO 1:14">അതിലെ അരമനകളെ ദഹിപ്പിച്ചുകളയും.<verse eid="AMO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 1:15" />അവരുടെ രാജാവ് പ്രവാസത്തിലേക്കു പോകേണ്ടിവരും;</para>
  <para style="q2" vid="AMO 1:15">അവനും അവന്‍റെ പ്രഭുക്കന്മാരും ഒരുപോലെ തന്നെ”</para>
  <para style="q2" vid="AMO 1:15">എന്ന് യഹോവ അരുളിച്ചെയ്യുന്നു.<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="s">മോവാബ്</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1" />യഹോവ ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:</para>
  <para style="b" vid="AMO 2:1" />
  <para style="q1" vid="AMO 2:1">“മോവാബിന്‍റെ മൂന്നോ നാലോ അതിക്രമംനിമിത്തം,</para>
  <para style="q2" vid="AMO 2:1">അവൻ ഏദോം രാജാവിന്‍റെ അസ്ഥികളെ ചുട്ട് കുമ്മായമാക്കിക്കളഞ്ഞിരിക്കുകയാൽ തന്നെ,</para>
  <para style="q2" vid="AMO 2:1">ഞാൻ ശിക്ഷ മടക്കിക്കളയുകയില്ല.<verse eid="AMO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 2:2" />ഞാൻ മോവാബിൽ ഒരു തീ അയയ്ക്കും;</para>
  <para style="q2" vid="AMO 2:2">അത് കെരീയോത്തിന്‍റെ അരമനകളെ ദഹിപ്പിച്ചുകളയും;</para>
  <para style="q1" vid="AMO 2:2">മോവാബ് കലഹത്തോടും ആർപ്പോടും</para>
  <para style="q2" vid="AMO 2:2">കാഹളനാദത്തോടുംകൂടി മരിക്കും.<verse eid="AMO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 2:3" />ഞാൻ ന്യായാധിപതിയെ അതിന്‍റെ നടുവിൽനിന്ന് ഛേദിച്ച്,</para>
  <para style="q1" vid="AMO 2:3">അതിന്‍റെ സകലപ്രഭുക്കന്മാരെയും അവനോടുകൂടെ കൊല്ലും”</para>
  <para style="q2" vid="AMO 2:3">എന്ന് യഹോവ അരുളിച്ചെയ്യുന്നു.<verse eid="AMO 2:3" /></para>
  <para style="s">യെഹൂദാ</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4" />യഹോവ ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:</para>
  <para style="q1" vid="AMO 2:4">“യെഹൂദായുടെ മൂന്നോ നാലോ അതിക്രമംനിമിത്തം,</para>
  <para style="q2" vid="AMO 2:4">അവർ യഹോവയുടെ ന്യായപ്രമാണം നിരസിക്കുകയും,</para>
  <para style="q1" vid="AMO 2:4">അവിടുത്തെ ചട്ടങ്ങൾ പ്രമാണിക്കാതെയിരിക്കുകയും,</para>
  <para style="q2" vid="AMO 2:4">അവരുടെ പൂര്‍വ്വ പിതാക്കന്മാർ പിന്തുടർന്നുപോന്ന</para>
  <para style="q1" vid="AMO 2:4">അവരുടെ വ്യാജമൂർത്തികൾ</para>
  <para style="q2" vid="AMO 2:4">അവരെ തെറ്റിനടക്കുമാറാക്കുകയും ചെയ്തിരിക്കുകയാൽ തന്നെ,</para>
  <para style="q2" vid="AMO 2:4">ഞാൻ ശിക്ഷ മടക്കിക്കളയുകയില്ല.<verse eid="AMO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 2:5" />ഞാൻ യെഹൂദായിൽ ഒരു തീ അയയ്ക്കും;</para>
  <para style="q2" vid="AMO 2:5">അത് യെരൂശലേമിലെ അരമനകൾ ദഹിപ്പിച്ചുകളയും.”<verse eid="AMO 2:5" /></para>
  <para style="s">ഇസ്രായേലിനുള്ള ന്യായവിധി</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6" />യഹോവ ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:</para>
  <para style="b" vid="AMO 2:6" />
  <para style="q1" vid="AMO 2:6">“യിസ്രായേലിന്‍റെ മൂന്നോ നാലോ അതിക്രമംനിമിത്തം,</para>
  <para style="q2" vid="AMO 2:6">അവർ നീതിമാനെ പണത്തിനും</para>
  <para style="q2" vid="AMO 2:6">ദരിദ്രനെ ഒരു ജോടി ചെരുപ്പിനും വിറ്റുകളഞ്ഞിരിക്കുകയാൽ തന്നെ,</para>
  <para style="q2" vid="AMO 2:6">ഞാൻ ശിക്ഷ മടക്കിക്കളയുകയില്ല.<verse eid="AMO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 2:7" />അവർ എളിയവരുടെ തലയിൽ മൺപൊടി കാണുവാൻ കാംക്ഷിക്കുകയും</para>
  <para style="q2" vid="AMO 2:7">സാധുക്കളുടെ വഴി മറിച്ചുകളയുകയും ചെയ്യുന്നു:</para>
  <para style="q1" vid="AMO 2:7">എന്‍റെ വിശുദ്ധനാമത്തെ അശുദ്ധമാക്കുവാൻ തക്കവണ്ണം</para>
  <para style="q2" vid="AMO 2:7">ഒരു പുരുഷനും അവന്‍റെ അപ്പനും</para>
  <para style="q2" vid="AMO 2:7">ഒരു യുവതിയുടെ അടുക്കൽ ചെല്ലുന്നു.<verse eid="AMO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 2:8" />അവർ ഏത് ബലിപീഠത്തിനരികത്തും</para>
  <para style="q2" vid="AMO 2:8">പണയം വാങ്ങിയ വസ്ത്രം വിരിച്ച് കിടന്നുറങ്ങുകയും</para>
  <para style="q1" vid="AMO 2:8">പിഴ അടച്ചവരുടെ വീഞ്ഞ് തങ്ങളുടെ</para>
  <para style="q2" vid="AMO 2:8">ദേവന്മാരുടെ ആലയത്തിൽവച്ച് കുടിക്കുകയും ചെയ്യുന്നു.<verse eid="AMO 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 2:9" />ഞാൻ അമോര്യനെ അവരുടെ മുമ്പിൽനിന്ന് നശിപ്പിച്ചുകളഞ്ഞു;</para>
  <para style="q2" vid="AMO 2:9">അവന്‍റെ ഉയരം ദേവദാരുക്കളുടെ ഉയരംപോലെയായിരുന്നു;</para>
  <para style="q1" vid="AMO 2:9">അവൻ കരുവേലകങ്ങൾപോലെ ശക്തിയുള്ളവനുമായിരുന്നു;</para>
  <para style="q2" vid="AMO 2:9">എങ്കിലും ഞാൻ മീതെ അവന്‍റെ ഫലവും</para>
  <para style="q2" vid="AMO 2:9">താഴെ അവന്‍റെ വേരും നശിപ്പിച്ചുകളഞ്ഞു.<verse eid="AMO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 2:10" />ഞാൻ നിങ്ങളെ മിസ്രയീമിൽ നിന്ന് പുറപ്പെടുവിച്ച്,</para>
  <para style="q2" vid="AMO 2:10">അമോര്യന്‍റെ ദേശം കൈവശമാക്കേണ്ടതിന്</para>
  <para style="q2" vid="AMO 2:10">നിങ്ങളെ നാല്പത് വര്‍ഷം മരുഭൂമിയിൽക്കൂടി നടത്തി.<verse eid="AMO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 2:11" />ഞാൻ നിങ്ങളുടെ പുത്രന്മാരിൽ ചിലരെ പ്രവാചകന്മാരായും</para>
  <para style="q2" vid="AMO 2:11">നിങ്ങളുടെ യൗവനക്കാരിൽ ചിലരെ വ്രതസ്ഥന്മാരായും എഴുന്നേല്പിച്ചു;</para>
  <para style="q1" vid="AMO 2:11">അങ്ങനെ തന്നെ അല്ലയോ, യിസ്രായേൽ മക്കളേ,”</para>
  <para style="q2" vid="AMO 2:11">എന്ന് യഹോവയുടെ അരുളപ്പാട്.<verse eid="AMO 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 2:12" />എന്നാൽ നിങ്ങൾ വ്രതസ്ഥന്മാർക്കു വീഞ്ഞു കുടിക്കുവാൻ കൊടുക്കുകയും</para>
  <para style="q2" vid="AMO 2:12">പ്രവാചകന്മാരോട്: ‘പ്രവചിക്കരുത്’ എന്നു കല്പിക്കുകയും ചെയ്തു.<verse eid="AMO 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 2:13" />കറ്റ കയറ്റിയ വണ്ടി അമർത്തുന്നതുപോലെ</para>
  <para style="q2" vid="AMO 2:13">ഞാൻ നിങ്ങളെ നിങ്ങൾ ഇരിക്കുന്നിടത്ത് അമർത്തിക്കളയും.<verse eid="AMO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 2:14" />അങ്ങനെ വേഗത്തിൽ ഓടുന്നവർക്ക് ശരണം നശിക്കും;</para>
  <para style="q2" vid="AMO 2:14">ബലവാന്‍റെ ശക്തി നിലനില്‍ക്കുകയില്ല;</para>
  <para style="q2" vid="AMO 2:14">വീരൻ തന്‍റെ ജീവനെ രക്ഷിക്കുകയില്ല;<verse eid="AMO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 2:15" />വില്ലാളി ഉറച്ചുനിൽക്കുകയില്ല;</para>
  <para style="q2" vid="AMO 2:15">വേഗത്തിൽ ഓടുന്നവൻ സ്വയം വിടുവിക്കുകയില്ല,</para>
  <para style="q1" vid="AMO 2:15">കുതിരപ്പുറത്തു കയറി ഓടുന്നവൻ</para>
  <para style="q2" vid="AMO 2:15">തന്‍റെ ജീവനെ രക്ഷിക്കുകയുമില്ല.<verse eid="AMO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 2:16" />വീരന്മാരിൽ ധൈര്യമേറിയവൻ</para>
  <para style="q2" vid="AMO 2:16">അന്നാളിൽ നഗ്നനായി ഓടിപ്പോകും”</para>
  <para style="q2" vid="AMO 2:16">എന്ന് യഹോവയുടെ അരുളപ്പാട്.<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />യിസ്രായേൽ മക്കളേ, നിങ്ങളെക്കുറിച്ചും ഞാൻ മിസ്രയീമിൽ നിന്ന് പുറപ്പെടുവിച്ച സർവ്വവംശത്തെക്കുറിച്ചും യഹോവ അരുളിച്ചെയ്തിരിക്കുന്ന ഈ വചനം കേൾക്കുവിൻ!<verse eid="AMO 3:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="AMO 3:2" />ഭൂമിയിലെ സകലവംശങ്ങളിലുംവച്ച്</para>
  <para style="q2" vid="AMO 3:2">ഞാൻ നിങ്ങളെ മാത്രം തിരഞ്ഞെടുത്തിരിക്കുന്നു;</para>
  <para style="q2" vid="AMO 3:2">അതുകൊണ്ട് ഞാൻ നിങ്ങളുടെ അകൃത്യങ്ങൾനിമിത്തം</para>
  <para style="q2" vid="AMO 3:2">നിങ്ങളെ സന്ദർശിക്കും.<verse eid="AMO 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 3:3" />രണ്ടുപേർ തമ്മിൽ ഒത്തിട്ടല്ലാതെ ഒരുമിച്ച് നടക്കുമോ?</para>
  <para style="q2" vid="AMO 3:3">ഇരയില്ലാതിരിക്കുമ്പോൾ സിംഹം കാട്ടിൽ അലറുമോ?<verse eid="AMO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 3:4" />ഒന്നിനെയും പിടിച്ചിട്ടല്ലാതെ</para>
  <para style="q2" vid="AMO 3:4">ബാലസിംഹം ഗുഹയിൽനിന്ന് മുരൾച്ച പുറപ്പെടുവിക്കുമോ?<verse eid="AMO 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 3:5" />കുടുക്കില്ലാതിരുന്നാൽ പക്ഷി നിലത്തെ കെണിയിൽ അകപ്പെടുമോ?</para>
  <para style="q2" vid="AMO 3:5">ഒന്നും അകപ്പെടാതെ കെണി നിലത്തുനിന്ന് പൊങ്ങുമോ?<verse eid="AMO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 3:6" />നഗരത്തിൽ കാഹളം ഊതുമ്പോൾ ജനം പേടിക്കാതിരിക്കുമോ?</para>
  <para style="q2" vid="AMO 3:6">യഹോവ വരുത്തീട്ടല്ലാതെ നഗരത്തിൽ അനർത്ഥം ഭവിക്കുമോ?<verse eid="AMO 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 3:7" />യഹോവയായ കർത്താവ് പ്രവാചകന്മാരായ തന്‍റെ ദാസന്മാർക്ക്</para>
  <para style="q2" vid="AMO 3:7">തന്‍റെ രഹസ്യം വെളിപ്പെടുത്താതെ</para>
  <para style="q1" vid="AMO 3:7">ഒരു കാര്യവും ചെയ്യുകയില്ല.<verse eid="AMO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 3:8" />സിംഹം ഗർജ്ജിച്ചിരിക്കുന്നു;</para>
  <para style="q2" vid="AMO 3:8">ആര്‍ ഭയപ്പെടാതിരിക്കും?</para>
  <para style="q1" vid="AMO 3:8">യഹോവയായ കർത്താവ് അരുളിച്ചെയ്തിരിക്കുന്നു;</para>
  <para style="q2" vid="AMO 3:8">ആര്‍ പ്രവചിക്കാതിരിക്കും?<verse eid="AMO 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 3:9" />“ശമര്യാപർവ്വതങ്ങളിൽ വന്നുകൂടി</para>
  <para style="q2" vid="AMO 3:9">അതിന്‍റെ നടുവിലുള്ള മഹാകലഹങ്ങളെയും</para>
  <para style="q1" vid="AMO 3:9">അതിന്‍റെ മദ്ധ്യേയുള്ള പീഡനങ്ങളെയും നോക്കുവിൻ”</para>
  <para style="q2" vid="AMO 3:9">എന്ന് അസ്തോദിലെയും മിസ്രയീമിലെയും</para>
  <para style="q2" vid="AMO 3:9">അരമനകളിന്മേൽ ഘോഷിച്ചുപറയുവിൻ!<verse eid="AMO 3:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 3:10" />“തങ്ങളുടെ അരമനകളിൽ അന്യായവും സാഹസവും സംഗ്രഹിച്ചുവയ്ക്കുന്നവർ</para>
  <para style="q2" vid="AMO 3:10">ന്യായം പ്രവർത്തിക്കുവാൻ അറിയുന്നില്ല”</para>
  <para style="q2" vid="AMO 3:10">എന്ന് യഹോവയുടെ അരുളപ്പാട്.<verse eid="AMO 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 3:11" />അതുകൊണ്ട് യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:</para>
  <para style="q2" vid="AMO 3:11">“ദേശത്തിന് ചുറ്റും ഒരു വൈരി ഉണ്ടാകും;</para>
  <para style="q1" vid="AMO 3:11">അവൻ നിന്‍റെ ഉറപ്പ് നിന്നിൽനിന്ന് താഴ്ത്തിക്കളയും;</para>
  <para style="q2" vid="AMO 3:11">നിന്‍റെ അരമനകൾ കൊള്ളയായിത്തീരും.”<verse eid="AMO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12" />യഹോവ ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:</para>
  <para style="b" vid="AMO 3:12" />
  <para style="q1" vid="AMO 3:12">“ഒരു ഇടയൻ സിംഹത്തിന്‍റെ വായിൽനിന്ന്</para>
  <para style="q2" vid="AMO 3:12">രണ്ടു കാലോ ഒരു കാതോ വലിച്ചെടുക്കുന്നതുപോലെ</para>
  <para style="q1" vid="AMO 3:12">ശമര്യയിൽ കിടക്കയുടെ കോണിലും പട്ടുമെത്തമേലും ഇരിക്കുന്ന</para>
  <para style="q2" vid="AMO 3:12">യിസ്രായേൽ മക്കൾ വിടുവിക്കപ്പെടും.<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">ഒരു മൃഗം വന്യമൃഗങ്ങളാല്‍ കൊല്ലപ്പെട്ടാല്‍ അതിന്‍റെ അവശിഷ്ടം കൊണ്ടുവന്ന് ഉടമയെ കാണിക്കേണ്ടതും അത്‌ എങ്ങനെ കൊല്ലപ്പെട്ടു എന്ന് വിവരിക്കേണ്ടതും ഇടയന്‍റെ ഉത്തരവാദിത്വമായിരുന്നു ഇടയനു അതിന് കഴിയുന്നില്ലെങ്കില്‍ ആ മൃഗത്തിന്‍റെ വിലക്ക് തുല്യമായ പണം ഉടമക്ക് നല്‍കേണ്ടതുമാണ്‌ </char></note><verse eid="AMO 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13" />നിങ്ങൾ കേട്ട് യാക്കോബ് ഗൃഹത്തോട് സാക്ഷീകരിക്കുവിൻ” എന്ന് സൈന്യങ്ങളുടെ ദൈവമായ യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="AMO 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="AMO 3:14" />“ഞാൻ യിസ്രായേലിന്‍റെ അതിക്രമങ്ങൾനിമിത്തം</para>
  <para style="q2" vid="AMO 3:14">അവനെ സന്ദർശിക്കുന്ന നാളിൽ</para>
  <para style="q1" vid="AMO 3:14">ബലിപീഠത്തിന്‍റെ കൊമ്പുകൾ മുറിഞ്ഞ് നിലത്ത് വീഴത്തക്കവിധം</para>
  <para style="q2" vid="AMO 3:14">ഞാൻ ബേഥേലിലെ ബലിപീഠങ്ങളെയും സന്ദർശിക്കും.<verse eid="AMO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 3:15" />ഞാൻ വേനൽക്കാലവസതിയും ശൈത്യകാലവസതിയും</para>
  <para style="q2" vid="AMO 3:15">ഒരുപോലെ തകർത്തുകളയും;</para>
  <para style="q1" vid="AMO 3:15">ദന്തഭവനങ്ങൾ നശിച്ചുപോകും;</para>
  <para style="q2" vid="AMO 3:15">പലവീടുകളും മുടിഞ്ഞുപോകും”</para>
  <para style="q2" vid="AMO 3:15">എന്ന് യഹോവയുടെ അരുളപ്പാട്.<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="s">യിസ്രായേൽ ദൈവത്തിന്‍റെ അടുക്കൽ മടങ്ങിവന്നില്ല</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="AMO 4:1" />എളിയവരെ പീഡിപ്പിക്കുകയും ദരിദ്രന്മാരെ ഞെരുക്കുകയും</para>
  <para style="q2" vid="AMO 4:1">സ്വന്തം ഭർത്താക്കന്മാരോട്:</para>
  <para style="q1" vid="AMO 4:1">“കൊണ്ടുവരുവിൻ; ഞങ്ങൾ കുടിക്കട്ടെ” എന്ന് പറയുകയും ചെയ്യുന്ന സ്ത്രീകളേ,</para>
  <para style="q2" vid="AMO 4:1">ശമര്യാപർവ്വതത്തിലെ ബാശാന്യ<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="fq" closed="false">ബാശാന്യ </char><char style="ft" closed="false">ഊര്‍വ്വര ഭൂമി</char></note>പശുക്കളേ, ഈ വചനം കേൾക്കുവിൻ.<verse eid="AMO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 4:2" />“ഞാൻ നിങ്ങളെ കൊളുത്തുകൊണ്ടും</para>
  <para style="q2" vid="AMO 4:2">നിങ്ങളുടെ സന്തതിയെ ചൂണ്ടൽകൊണ്ടും</para>
  <para style="q1" vid="AMO 4:2">പിടിച്ചു കൊണ്ടുപോകുന്ന കാലം നിങ്ങൾക്ക് വരും”</para>
  <para style="q2" vid="AMO 4:2">എന്ന് യഹോവയായ കർത്താവ് തന്‍റെ വിശുദ്ധിയെച്ചൊല്ലി സത്യം ചെയ്തിരിക്കുന്നു.<verse eid="AMO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 4:3" />“അപ്പോൾ നിങ്ങൾ ഓരോരുത്തരും നേരെ</para>
  <para style="q2" vid="AMO 4:3">മുമ്പോട്ട് മതിൽ പിളർപ്പുകളിൽകൂടി പുറത്തുചെല്ലുകയും</para>
  <para style="q1" vid="AMO 4:3">നിങ്ങളെ ഹെർമ്മോന്‍<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="fq" closed="false">ഹെർമ്മോന്‍ </char><char style="ft" closed="false">ജീര്‍ണ്ണാവശിഷ്ടങ്ങളുടെ സ്ഥലം </char></note> പര്‍വ്വതത്തിലേക്കു എറിഞ്ഞുകളയുകയും ചെയ്യും”</para>
  <para style="q2" vid="AMO 4:3">എന്ന് യഹോവയുടെ അരുളപ്പാട്.<verse eid="AMO 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="AMO 4:4" />ബേഥേലിൽ ചെന്നു അതിക്രമം ചെയ്യുവിൻ;</para>
  <para style="q2" vid="AMO 4:4">ഗില്ഗാലിൽ ചെന്നു അതിക്രമം വർദ്ധിപ്പിക്കുവിൻ;</para>
  <para style="q1" vid="AMO 4:4">രാവിലെതോറും നിങ്ങളുടെ ഹനനയാഗങ്ങളും</para>
  <para style="q2" vid="AMO 4:4">മൂന്നാംനാൾതോറും നിങ്ങളുടെ ദശാംശങ്ങളും കൊണ്ടുവരുവിൻ.<verse eid="AMO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 4:5" />“പുളിച്ച മാവുകൊണ്ടുള്ള സ്തോത്രയാഗം അർപ്പിക്കുവിൻ;</para>
  <para style="q2" vid="AMO 4:5">സ്വമേധാദാനങ്ങളെക്കുറിച്ച് ഘോഷിച്ച് പ്രസിദ്ധമാക്കുവിൻ;</para>
  <para style="q1" vid="AMO 4:5">ഇതല്ലയോ, യിസ്രായേൽ മക്കളേ, നിങ്ങൾക്ക് ഇഷ്ടമായിരിക്കുന്നത്”</para>
  <para style="q2" vid="AMO 4:5">എന്ന് യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="AMO 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="AMO 4:6" />“നിങ്ങളുടെ എല്ലാ പട്ടണങ്ങളിലും ഞാൻ</para>
  <para style="q2" vid="AMO 4:6">നിങ്ങൾക്ക് പല്ലിന്‍റെ വെടിപ്പും</para>
  <para style="q1" vid="AMO 4:6">എല്ലായിടങ്ങളിലും അപ്പത്തിന്‍റെ കുറവും വരുത്തിയിട്ടും</para>
  <para style="q2" vid="AMO 4:6">നിങ്ങൾ എന്നിലേയ്ക്ക് തിരിഞ്ഞില്ല”</para>
  <para style="q2" vid="AMO 4:6">എന്ന് യഹോവയുടെ അരുളപ്പാട്.<verse eid="AMO 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 4:7" />“കൊയ്ത്തിന് ഇനി മൂന്നു മാസമുള്ളപ്പോൾ</para>
  <para style="q2" vid="AMO 4:7">ഞാൻ നിങ്ങൾക്ക് മഴ മുടക്കിക്കളഞ്ഞു;</para>
  <para style="q1" vid="AMO 4:7">ഞാൻ ഒരു പട്ടണത്തിൽ മഴ നൽകുകയും</para>
  <para style="q2" vid="AMO 4:7">മറ്റെ പട്ടണത്തിൽ മഴ നൽകാതിരിക്കുകയും ചെയ്തു;</para>
  <para style="q1" vid="AMO 4:7">ഒരു വയലിൽ മഴ പെയ്തു;</para>
  <para style="q2" vid="AMO 4:7">മഴ പെയ്യാത്ത മറ്റെ വയൽ വരണ്ടുപോയി.<verse eid="AMO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 4:8" />രണ്ടോ മൂന്നോ പട്ടണങ്ങൾ വെള്ളം കുടിക്കുവാൻ ഒരു പട്ടണത്തിലേക്ക് ഉഴന്നുചെന്നു,</para>
  <para style="q2" vid="AMO 4:8">ദാഹം തീർന്നില്ലതാനും;</para>
  <para style="q1" vid="AMO 4:8">എന്നിട്ടും നിങ്ങൾ എന്നിലേയ്ക്ക് തിരിഞ്ഞില്ല”</para>
  <para style="q2" vid="AMO 4:8">എന്ന് യഹോവയുടെ അരുളപ്പാട്.<verse eid="AMO 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 4:9" />“ഞാൻ നിങ്ങളെ വെൺകതിർകൊണ്ടും വിഷമഞ്ഞുകൊണ്ടും ശിക്ഷിച്ചു;</para>
  <para style="q2" vid="AMO 4:9">നിങ്ങളുടെ തോട്ടങ്ങളും മുന്തിരിത്തോപ്പുകളും</para>
  <para style="q1" vid="AMO 4:9">അത്തിവൃക്ഷങ്ങളും ഒലിവുമരങ്ങളും</para>
  <para style="q2" vid="AMO 4:9">പലപ്പോഴും വെട്ടുക്കിളി തിന്നുകളഞ്ഞു;</para>
  <para style="q1" vid="AMO 4:9">എങ്കിലും നിങ്ങൾ എന്നിലേയ്ക്ക് തിരിഞ്ഞില്ല”</para>
  <para style="q2" vid="AMO 4:9">എന്ന് യഹോവയുടെ അരുളപ്പാട്.<verse eid="AMO 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 4:10" />“മിസ്രയീമിലെപ്പോലെ ഞാൻ മഹാവ്യാധി നിങ്ങളു നിലടെ ഇടയിൽ അയച്ച്</para>
  <para style="q2" vid="AMO 4:10">നിങ്ങളുടെ യൗവനക്കാരെ വാൾകൊണ്ട് കൊന്ന്</para>
  <para style="q1" vid="AMO 4:10">നിങ്ങളുടെ കുതിരകളെ പിടിച്ചു കൊണ്ടുപോയി;</para>
  <para style="q2" vid="AMO 4:10">നിങ്ങളുടെ പാളയങ്ങളിലെ നാറ്റം ഞാൻ</para>
  <para style="q1" vid="AMO 4:10">നിങ്ങളുടെ മൂക്കിൽ കയറുമാറാക്കി;</para>
  <para style="q2" vid="AMO 4:10">എന്നിട്ടും നിങ്ങൾ എന്നിലേയ്ക്കു തിരിഞ്ഞില്ല”</para>
  <para style="q2" vid="AMO 4:10">എന്ന് യഹോവയുടെ അരുളപ്പാട്.<verse eid="AMO 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 4:11" />“ദൈവം സൊദോമിനെയും ഗൊമോറായെയും ഉന്മൂലനാശം ചെയ്തതുപോലെ</para>
  <para style="q2" vid="AMO 4:11">ഞാൻ നിങ്ങളുടെ ഇടയിൽ ഒരു ഉന്മൂലനാശം വരുത്തി,</para>
  <para style="q1" vid="AMO 4:11">നിങ്ങൾ കത്തുന്ന തീയിൽനിന്ന് വലിച്ചെടുക്കപ്പെട്ട ഒരു കൊള്ളിപോലെ ആയിരുന്നു;</para>
  <para style="q2" vid="AMO 4:11">എന്നിട്ടും നിങ്ങൾ എന്നിലേയ്ക്ക് തിരിഞ്ഞില്ല”</para>
  <para style="q2" vid="AMO 4:11">എന്ന് യഹോവയുടെ അരുളപ്പാട്.<verse eid="AMO 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="AMO 4:12" />“അതുകൊണ്ട് യിസ്രായേലേ, ഞാൻ നിന്നോട് ഇങ്ങനെ ചെയ്യും;</para>
  <para style="q2" vid="AMO 4:12">യിസ്രായേലേ, ഞാൻ ഇത് നിന്നോട് ചെയ്യുവാൻ പോകുന്നതുകൊണ്ട്</para>
  <para style="q2" vid="AMO 4:12">നിന്‍റെ ദൈവത്തെ എതിരേല്ക്കുവാൻ ഒരുങ്ങിക്കൊള്ളുക.”<verse eid="AMO 4:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13" />“പർവ്വതങ്ങളെ നിർമ്മിക്കുകയും</para>
  <para style="q2" vid="AMO 4:13">കാറ്റിനെ സൃഷ്ടിക്കുകയും</para>
  <para style="q2" vid="AMO 4:13">മനുഷ്യനോട് അവന്‍റെ നിരൂപണം ഇന്നതെന്ന് അറിയിക്കുകയും</para>
  <para style="q1" vid="AMO 4:13">പ്രഭാതത്തെ അന്ധകാരമാക്കുകയും</para>
  <para style="q2" vid="AMO 4:13">ഭൂമിയുടെ ഉന്നതികളിന്മേൽ നടകൊള്ളുകയും ചെയ്യുന്ന ഒരുവനുണ്ട്;</para>
  <para style="q2" vid="AMO 4:13">സൈന്യങ്ങളുടെ ദൈവമായ യഹോവ എന്നാകുന്നു അവിടുത്തെ നാമം.”<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s">ഒരു വിലാപവും മാനസാന്തരത്തിനുള്ള ആഹ്വാനവും</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />യിസ്രായേൽ ഗൃഹമേ, നിങ്ങളെക്കുറിച്ചുള്ള ഈ വിലാപവചനം കേൾക്കുവിൻ!<verse eid="AMO 5:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2" />യിസ്രായേൽകന്യക വീണിരിക്കുന്നു;</para>
  <para style="q2" vid="AMO 5:2">ഇനി എഴുന്നേൽക്കുകയും ഇല്ല;</para>
  <para style="q1" vid="AMO 5:2">അവൾ നിലത്തോട് പറ്റിക്കിടക്കുന്നു;</para>
  <para style="q2" vid="AMO 5:2">അവളെ എഴുന്നേൽപ്പിക്കുവാൻ ആരുമില്ല.<verse eid="AMO 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:</para>
  <para style="b" vid="AMO 5:3" />
  <para style="q1" vid="AMO 5:3">“യിസ്രായേൽഗൃഹത്തിൽ ആയിരംപേരുമായി പുറപ്പെട്ട പട്ടണത്തിൽ നൂറുപേർ മാത്രം ശേഷിക്കും;</para>
  <para style="q2" vid="AMO 5:3">നൂറ് പേരുമായി പുറപ്പെട്ടതിൽ പത്തുപേർ മാത്രം ശേഷിക്കും.”<verse eid="AMO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4" />യഹോവ യിസ്രായേൽ ഗൃഹത്തോട് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:</para>
  <para style="b" vid="AMO 5:4" />
  <para style="q1" vid="AMO 5:4">“നിങ്ങൾ ജീവിച്ചിരിക്കേണ്ടതിന് എന്നെ അന്വേഷിക്കുവിൻ.<verse eid="AMO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 5:5" />ബേഥേലിനെ അന്വേഷിക്കരുത്;</para>
  <para style="q2" vid="AMO 5:5">ഗില്ഗാലിലേയ്ക്ക് പോകരുത്;</para>
  <para style="q1" vid="AMO 5:5">ബേർ-ശേബയിലേയ്ക്ക് കടക്കുകയുമരുത്;</para>
  <para style="q2" vid="AMO 5:5">ഗില്ഗാൽ പ്രവാസത്തിലേക്കു പോകേണ്ടിവരും;</para>
  <para style="q2" vid="AMO 5:5">ബെഥേൽ ശൂന്യമായിത്തീരും.<verse eid="AMO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 5:6" />നിങ്ങൾ ജീവിച്ചിരിക്കേണ്ടതിന് യഹോവയെ അന്വേഷിക്കുവിൻ;</para>
  <para style="q2" vid="AMO 5:6">അല്ലെങ്കിൽ അവിടുന്ന് ബേഥേലിൽ ആർക്കും</para>
  <para style="q2" vid="AMO 5:6">കെടുത്തുവാൻ കഴിയാത്ത ഒരു തീപോലെ</para>
  <para style="q1" vid="AMO 5:6">യോസേഫ്ഗൃഹത്തിൽ കടന്ന്</para>
  <para style="q2" vid="AMO 5:6">അതിനെ ദഹിപ്പിച്ചുകളയും.<verse eid="AMO 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 5:7" />ന്യായത്തെ കാഞ്ഞിരം ആക്കിത്തീർക്കുകയും</para>
  <para style="q2" vid="AMO 5:7">നീതിയെ നിലത്ത് തള്ളിയിട്ടുകളയുകയും ചെയ്യുന്നവരേ,<verse eid="AMO 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8" />കാർത്തികയെയും മകയിരത്തെയും സൃഷ്ടിക്കുകയും</para>
  <para style="q2" vid="AMO 5:8">അന്ധതമസ്സിനെ പ്രഭാതമാക്കി മാറ്റുകയും</para>
  <para style="q2" vid="AMO 5:8">പകലിനെ രാത്രിയാക്കി തീർക്കുകയും</para>
  <para style="q1" vid="AMO 5:8">സമുദ്രത്തിലെ വെള്ളത്തെ വിളിച്ച്</para>
  <para style="q2" vid="AMO 5:8">ഭൂതലത്തിൽ പകരുകയും ചെയ്യുന്നവനെ അന്വേഷിക്കുവിൻ;</para>
  <para style="q2" vid="AMO 5:8">യഹോവ എന്നാകുന്നു അവിടുത്തെ നാമം.<verse eid="AMO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 5:9" />അവിടുന്ന് കോട്ടയ്ക്കു നാശം വരുവാൻ തക്കവിധം</para>
  <para style="q2" vid="AMO 5:9">ബലവാന്‍റെ മേൽ നാശം പെയ്യിക്കുന്നു.<verse eid="AMO 5:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 5:10" />ഗോപുരത്തിങ്കൽ ന്യായം വിധിക്കുന്നവനെ അവർ ദ്വേഷിക്കുകയും</para>
  <para style="q2" vid="AMO 5:10">പരമാർത്ഥം സംസാരിക്കുന്നവനെ വെറുക്കുകയും ചെയ്യുന്നു.<verse eid="AMO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 5:11" />അങ്ങനെ നിങ്ങൾ എളിയവനെ ചവിട്ടിക്കളയുകയും</para>
  <para style="q2" vid="AMO 5:11">അവനോട് കോഴയായി ധാന്യം വാങ്ങുകയും ചെയ്യുന്നതിനാൽ</para>
  <para style="q1" vid="AMO 5:11">നിങ്ങൾ വെട്ടുകല്ലുകൊണ്ട് വീടു പണിയും;</para>
  <para style="q2" vid="AMO 5:11">അതിൽ പാർക്കുകയില്ലതാനും;</para>
  <para style="q1" vid="AMO 5:11">നിങ്ങൾ മനോഹരമായ മുന്തിരിത്തോട്ടങ്ങൾ ഉണ്ടാക്കും;</para>
  <para style="q2" vid="AMO 5:11">അവയിലെ വീഞ്ഞ് കുടിക്കുകയില്ലതാനും;<verse eid="AMO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 5:12" />നീതിമാനെ പീഡിപ്പിച്ച് കൈക്കൂലി വാങ്ങുകയും</para>
  <para style="q2" vid="AMO 5:12">ഗോപുരത്തിങ്കൽ ദരിദ്രന്മാരുടെ ന്യായം മറിച്ചുകളയുകയും ചെയ്യുന്നവരേ,</para>
  <para style="q1" vid="AMO 5:12">നിങ്ങളുടെ അതിക്രമങ്ങൾ അനവധിയും</para>
  <para style="q2" vid="AMO 5:12">നിങ്ങളുടെ പാപങ്ങൾ കഠിനവും എന്ന് ഞാൻ അറിയുന്നു.<verse eid="AMO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 5:13" />അതുകൊണ്ട് ബുദ്ധിമാൻ ഈ കാലത്ത് മിണ്ടാതിരിക്കുന്നു;</para>
  <para style="q2" vid="AMO 5:13">ഇത് ദുഷ്ക്കാലമല്ലോ;<verse eid="AMO 5:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="AMO 5:14" />നിങ്ങൾ ജീവിച്ചിരിക്കേണ്ടതിന് തിന്മയല്ല</para>
  <para style="q2" vid="AMO 5:14">നന്മ തന്നെ അന്വേഷിക്കുവിൻ;</para>
  <para style="q1" vid="AMO 5:14">അപ്പോൾ നിങ്ങൾ പറയുന്നതുപോലെ</para>
  <para style="q2" vid="AMO 5:14">സൈന്യങ്ങളുടെ ദൈവമായ യഹോവ നിങ്ങളോടുകൂടി ഇരിക്കും.<verse eid="AMO 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 5:15" />നിങ്ങൾ തിന്മ വെറുത്ത് നന്മ ഇച്ഛിച്ച്</para>
  <para style="q2" vid="AMO 5:15">ഗോപുരത്തിങ്കൽ ന്യായം നിലനിർത്തുവിൻ;</para>
  <para style="q1" vid="AMO 5:15">പക്ഷേ സൈന്യങ്ങളുടെ ദൈവമായ യഹോവ</para>
  <para style="q2" vid="AMO 5:15">യോസേഫിൽ ശേഷിപ്പുള്ളവരോട് കൃപ കാണിക്കും.<verse eid="AMO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16" />അതുകൊണ്ട് സൈന്യങ്ങളുടെ ദൈവമായ യഹോവ എന്ന കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു;</para>
  <para style="b" vid="AMO 5:16" />
  <para style="q1" vid="AMO 5:16">സകല വീഥികളിലും വിലാപം ഉണ്ടാകും;</para>
  <para style="q2" vid="AMO 5:16">എല്ലാ തെരുക്കളിലും അവർ: ‘അയ്യോ, അയ്യോ’ എന്ന് പറയും;</para>
  <para style="q1" vid="AMO 5:16">അവർ കൃഷിക്കാരെ ദുഃഖിക്കുവാനും</para>
  <para style="q2" vid="AMO 5:16">വിലാപക്കാരെ വിലപിക്കുവാനും വിളിക്കും.<verse eid="AMO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 5:17" />ഞാൻ നിന്‍റെ നടുവിൽകൂടി കടന്നുപോകുന്നതുകൊണ്ട്</para>
  <para style="q2" vid="AMO 5:17">എല്ലാ മുന്തിരിത്തോട്ടങ്ങളിലും വിലാപമുണ്ടാകും”</para>
  <para style="q2" vid="AMO 5:17">എന്ന് യഹോവ അരുളിച്ചെയ്യുന്നു.<verse eid="AMO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="AMO 5:18" />യഹോവയുടെ ന്യായവിധി ദിവസത്തിനായി കാത്തിരിക്കുന്ന നിങ്ങൾക്ക് അയ്യോ കഷ്ടം!</para>
  <para style="q2" vid="AMO 5:18">യഹോവയുടെ ദിവസംകൊണ്ട് നിങ്ങൾക്ക് എന്ത് ഗുണം!</para>
  <para style="q2" vid="AMO 5:18">അത് വെളിച്ചമല്ല ഇരുട്ടത്രേ.<verse eid="AMO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="AMO 5:19" />അത് ഒരുവൻ സിംഹത്തിന്‍റെ മുമ്പിൽനിന്ന് ഓടിപ്പോയി</para>
  <para style="q2" vid="AMO 5:19">കരടിയുടെ മുമ്പിൽ പെടുന്നതുപോലെയും</para>
  <para style="q1" vid="AMO 5:19">വീട്ടിൽ ചെന്നു ചുമരിൽ കൈ ചാരുമ്പോൾ</para>
  <para style="q2" vid="AMO 5:19">സർപ്പം അവനെ കടിക്കുന്നതുപോലെയും ആകുന്നു.<verse eid="AMO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="AMO 5:20" />യഹോവയുടെ ദിവസം വെളിച്ചമല്ല,</para>
  <para style="q2" vid="AMO 5:20">ഇരുൾ തന്നെയല്ലോ;</para>
  <para style="q2" vid="AMO 5:20">ഒട്ടും പ്രകാശമില്ലാതെ അന്ധകാരം തന്നെ.<verse eid="AMO 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="AMO 5:21" />നിങ്ങളുടെ ഉത്സവങ്ങളെ ഞാൻ ദ്വേഷിച്ച് നിരസിക്കുന്നു;</para>
  <para style="q2" vid="AMO 5:21">നിങ്ങളുടെ സഭായോഗങ്ങളിൽ എനിക്ക് പ്രസാദമില്ല.<verse eid="AMO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="AMO 5:22" />നിങ്ങൾ എനിക്ക് ഹോമയാഗങ്ങളും ഭോജനയാഗങ്ങളും അർപ്പിച്ചാലും</para>
  <para style="q2" vid="AMO 5:22">ഞാൻ പ്രസാദിക്കുകയില്ല;</para>
  <para style="q1" vid="AMO 5:22">തടിപ്പിച്ച മൃഗങ്ങളെകൊണ്ടുള്ള നിങ്ങളുടെ സമാധാനയാഗങ്ങളെ</para>
  <para style="q2" vid="AMO 5:22">ഞാൻ സ്വീകരിക്കുകയില്ല.<verse eid="AMO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="AMO 5:23" />നിന്‍റെ പാട്ടുകളുടെ സ്വരം എന്‍റെ മുമ്പിൽനിന്ന് നീക്കുക;</para>
  <para style="q2" vid="AMO 5:23">നിന്‍റെ വീണനാദം ഞാൻ കേൾക്കുകയില്ല.<verse eid="AMO 5:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="AMO 5:24" />എന്നാൽ ന്യായം വെള്ളംപോലെയും</para>
  <para style="q2" vid="AMO 5:24">നീതി വറ്റാത്ത തോടുപോലെയും കവിഞ്ഞൊഴുകട്ടെ.<verse eid="AMO 5:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="AMO 5:25" />യിസ്രായേൽ ഗൃഹമേ, നിങ്ങൾ മരുഭൂമിയിൽ എനിക്ക്</para>
  <para style="q2" vid="AMO 5:25">നാല്പത് വര്‍ഷം ഹനനയാഗങ്ങളും ഭോജനയാഗങ്ങളും അർപ്പിച്ചുവോ?<verse eid="AMO 5:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="AMO 5:26" />നിങ്ങൾ നിങ്ങൾക്കുവേണ്ടി ഉണ്ടാക്കിയ വിഗ്രഹങ്ങളായ</para>
  <para style="q2" vid="AMO 5:26">നക്ഷത്രദേവൻ കീയൂനെയും</para>
  <para style="q1" vid="AMO 5:26">നിങ്ങളുടെ രാജാവ് സിക്കൂത്തിനെയും</para>
  <para style="q2" vid="AMO 5:26">നിങ്ങൾ ചുമന്നുകൊണ്ട് പോകേണ്ടിവരും.<verse eid="AMO 5:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="AMO 5:27" />ഞാൻ നിങ്ങളെ ദമസ്കൊസിന് അപ്പുറം</para>
  <para style="q2" vid="AMO 5:27">പ്രവാസത്തിലേക്കു പോകുമാറാക്കും”</para>
  <para style="q1" vid="AMO 5:27">എന്ന് യഹോവ അരുളിച്ചെയ്യുന്നു;</para>
  <para style="q2" vid="AMO 5:27">സൈന്യങ്ങളുടെ ദൈവം എന്നാകുന്നു അവിടുത്തെ നാമം.<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s">യിസ്രായേലിന്‍റെ നാശം</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="AMO 6:1" />സീയോനിൽ സ്വൈരമായിരിക്കുന്നവരും</para>
  <para style="q2" vid="AMO 6:1">ശമര്യാപർവ്വതത്തിൽ നിർഭയരായിരിക്കുന്നവരും</para>
  <para style="q1" vid="AMO 6:1">ജനതകളിൽ പ്രധാനികളായ ശ്രേഷ്ഠന്മാരും,</para>
  <para style="q2" vid="AMO 6:1">യിസ്രായേൽഗൃഹം സമീപിക്കുന്നവരുമായുള്ളോരേ,</para>
  <para style="q2" vid="AMO 6:1">നിങ്ങൾക്ക് അയ്യോ കഷ്ടം.<verse eid="AMO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 6:2" />നിങ്ങൾ കല്നെയിൽ ചെന്നു നോക്കുവിൻ;</para>
  <para style="q2" vid="AMO 6:2">അവിടെനിന്ന് മഹാനഗരമായ ഹമാത്തിലേക്ക് പോകുവിൻ;</para>
  <para style="q1" vid="AMO 6:2">ഫെലിസ്ത്യരുടെ ഗത്തിലേക്ക് ചെല്ലുവിൻ;</para>
  <para style="q2" vid="AMO 6:2">അവ ഈ രാജ്യങ്ങളെക്കാൾ നല്ലവയോ?</para>
  <para style="q1" vid="AMO 6:2">അവയുടെ ദേശം നിങ്ങളുടെ ദേശത്തെക്കാൾ വിസ്താരമുള്ളതോ?<verse eid="AMO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 6:3" />നിങ്ങൾ ദുർദ്ദിവസം അകറ്റിവയ്ക്കുകയും</para>
  <para style="q2" vid="AMO 6:3">സാഹസത്തിന്‍റെ ഇരിപ്പിടം അടുപ്പിക്കുകയും ചെയ്യുന്നു.<verse eid="AMO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 6:4" />നിങ്ങൾ ആനക്കൊമ്പുകൊണ്ടുള്ള കട്ടിലുകളിന്മേൽ ചാരിയിരിക്കുകയും</para>
  <para style="q2" vid="AMO 6:4">നിങ്ങളുടെ ശയ്യകളിന്മേൽ നിവർന്നു കിടക്കുകയും</para>
  <para style="q1" vid="AMO 6:4">ആട്ടിൻകൂട്ടത്തിൽനിന്ന് കുഞ്ഞാടുകളെയും</para>
  <para style="q2" vid="AMO 6:4">തൊഴുത്തിൽനിന്ന് പശുക്കിടാക്കളെയും തിന്നുകയും ചെയ്യുന്നു.<verse eid="AMO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 6:5" />നിങ്ങൾ വീണനാദത്തോടെ വ്യർത്ഥസംഗീതം മീട്ടി</para>
  <para style="q2" vid="AMO 6:5">ദാവീദിനെപ്പോലെ സംഗീതോപകരണങ്ങൾ ഉണ്ടാക്കുന്നു.<verse eid="AMO 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 6:6" />നിങ്ങൾ കലശങ്ങളിൽ വീഞ്ഞ് കുടിക്കുകയും</para>
  <para style="q2" vid="AMO 6:6">വിശേഷതൈലം പൂശുകയും ചെയ്യുന്നു;</para>
  <para style="q2" vid="AMO 6:6">യോസേഫിന്‍റെ കഷ്ടതയെക്കുറിച്ച് വ്യസനിക്കുന്നില്ലതാനും.<verse eid="AMO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 6:7" />അതുകൊണ്ട് അവർ ഇപ്പോൾ പ്രവാസികളിൽ മുമ്പന്മാരായി പ്രവാസത്തിലേക്കു പോകും;</para>
  <para style="q2" vid="AMO 6:7">സുഖശയനം നടത്തുന്നവരുടെ മദ്യപാനഘോഷം നിന്നുപോകും.<verse eid="AMO 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8" />യഹോവയായ കർത്താവ് തന്നെച്ചൊല്ലി സത്യം ചെയ്തിരിക്കുന്നു എന്ന് സൈന്യങ്ങളുടെ ദൈവമായ യഹോവയുടെ അരുളപ്പാട്:</para>
  <para style="b" vid="AMO 6:8" />
  <para style="q1" vid="AMO 6:8">“ഞാൻ യാക്കോബിന്‍റെ ഗർവ്വത്തെ വെറുത്ത് അവന്‍റെ അരമനകളെ ദ്വേഷിക്കുന്നു;</para>
  <para style="q2" vid="AMO 6:8">ഞാൻ പട്ടണവും അതിലുള്ളതൊക്കെയും ഏല്പിച്ചുകൊടുക്കും.”<verse eid="AMO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />ഒരു വീട്ടിൽ പത്തു പുരുഷന്മാർ ശേഷിച്ചിരുന്നാലും അവർ മരിക്കും. <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />ഒരു മനുഷ്യന്‍റെ ബന്ധു, അവനെ ദഹിപ്പിക്കേണ്ടുന്നവൻ തന്നെ, അവന്‍റെ അസ്ഥികളെ വീട്ടിൽനിന്ന് നീക്കേണ്ടതിന് അവനെ ചുമന്നുകൊണ്ടുപോകുമ്പോൾ അവൻ വീടിന്‍റെ അകത്തെ മൂലയിൽ ഇരിക്കുന്നവനോട്: “നിന്‍റെ അടുക്കൽ ഇനി വല്ലവരും ഉണ്ടോ?” എന്ന് ചോദിക്കുന്നതിന് അവൻ: “ആരുമില്ല” എന്ന് പറഞ്ഞാൽ അവൻ: “യഹോവയുടെ നാമത്തെ കീർത്തിച്ചുകൂടായ്കയാൽ നീ മിണ്ടാതിരിക്കുക” എന്ന് പറയും.<verse eid="AMO 6:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 6:11" />യഹോവ കല്പിച്ചിട്ട് വലിയ വീട് ഇടിഞ്ഞും</para>
  <para style="q2" vid="AMO 6:11">ചെറിയ വീട് പിളർന്നും തകർന്നുപോകും.<verse eid="AMO 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 6:12" />കുതിര പാറമേൽ ഓടുമോ?</para>
  <para style="q2" vid="AMO 6:12">അവിടെ കാളയെ പൂട്ടി ഉഴുമോ?</para>
  <para style="q1" vid="AMO 6:12">എന്നാൽ നിങ്ങൾ ന്യായത്തെ വിഷമായും</para>
  <para style="q2" vid="AMO 6:12">നീതിഫലത്തെ കാഞ്ഞിരമായും മാറ്റിയിരിക്കുന്നു.<verse eid="AMO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 6:13" />ലോദേബാര്‍ പിടിച്ചടക്കിയതില്‍ നിങ്ങൾ സന്തോഷിച്ചുകൊണ്ട്:</para>
  <para style="q2" vid="AMO 6:13">“സ്വന്തശക്തിയാൽ ഞങ്ങൾ കര്‍ണ്ണയിം പിടിച്ചടക്കിയില്ലയോ” എന്ന് പറയുന്നു.<verse eid="AMO 6:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="AMO 6:14" />“എന്നാൽ യിസ്രായേൽ ഗൃഹമേ, ഞാൻ നിങ്ങളുടെനേരെ ഒരു ജനതയെ എഴുന്നേല്പിക്കും;</para>
  <para style="q2" vid="AMO 6:14">അവർ ഹമാത്തിലേക്കുള്ള പ്രവേശനംമുതൽ അരാബായിലെ തോടുവരെ നിങ്ങളെ ഞെരുക്കും”</para>
  <para style="q2" vid="AMO 6:14">എന്ന് സൈന്യങ്ങളുടെ ദൈവമായ യഹോവയുടെ അരുളപ്പാട്.<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s">വെട്ടുക്കിളിയുടെ ദർശനം</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />യഹോവയായ കർത്താവ് എനിക്ക് കാണിച്ചുതന്നതെന്തെന്നാൽ: വിള രണ്ടാമത് മുളച്ചു തുടങ്ങിയപ്പോൾ അവിടുന്ന് വിട്ടിലുകളെ ഒരുക്കി: അത് രാജാവിന്‍റെ വക വിളവെടുത്തശേഷം മുളച്ച രണ്ടാമത്തെ വിള ആയിരുന്നു. <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />എന്നാൽ അവ ദേശത്തിലെ സസ്യം തിന്നുതീർന്നപ്പോൾ ഞാൻ: “യഹോവയായ കർത്താവേ, ക്ഷമിക്കേണമേ; യാക്കോബിന് എങ്ങനെ നിലനിൽക്കാൻ കഴിയും? അവൻ ചെറിയവനല്ലോ” എന്ന് പറഞ്ഞു.<verse eid="AMO 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3" />യഹോവ അതിനെക്കുറിച്ച് അനുതപിച്ചു; “അത് സംഭവിക്കുകയില്ല” എന്ന് യഹോവ അരുളിച്ചെയ്തു. <verse eid="AMO 7:3" /><verse number="4" style="v" sid="AMO 7:4" />യഹോവയായ കർത്താവ് എനിക്ക് കാണിച്ചുതന്നതെന്തെന്നാൽ: യഹോവയായ കർത്താവ് തീയാൽ വ്യവഹരിക്കുവാൻ അതിനെ വിളിച്ചു; അത് വലിയ ആഴിയെ വറ്റിച്ചുകളഞ്ഞു; യഹോവയുടെ ഓഹരിയെയും തിന്നുകളഞ്ഞു. <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />അപ്പോൾ ഞാൻ: “യഹോവയായ കർത്താവേ, മതിയാക്കണമേ; യാക്കോബിന് എങ്ങനെ നിലനിൽക്കാൻ കഴിയും? അവൻ ചെറിയവനല്ലോ” എന്ന് പറഞ്ഞു.<verse eid="AMO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6" />യഹോവ അതിനെക്കുറിച്ച് അനുതപിച്ചു; “അത് സംഭവിക്കുകയില്ല” എന്ന് യഹോവയായ കർത്താവ് അരുളിച്ചെയ്തു. <verse eid="AMO 7:6" /><verse number="7" style="v" sid="AMO 7:7" />അവിടുന്ന് എനിക്ക് കാണിച്ചുതന്നതെന്തെന്നാൽ: തൂക്കുകട്ട ഉപയോഗിച്ച് പണിത ഒരു മതിലിന്മേൽ കർത്താവ് കയ്യിൽ തൂക്കുകട്ട പിടിച്ചുകൊണ്ട് നിന്നു. <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />യഹോവ എന്നോട്: “ആമോസേ, നീ എന്ത് കാണുന്നു?” എന്ന് ചോദിച്ചതിന്</para>
  <para style="p" vid="AMO 7:8">“ഒരു തൂക്കുകട്ട” എന്ന് ഞാൻ പറഞ്ഞു.</para>
  <para style="p" vid="AMO 7:8">അതിന് കർത്താവ്: “ഞാൻ എന്‍റെ ജനമായ യിസ്രായേലിന്‍റെ നടുവിൽ ഒരു തൂക്കുകട്ട പിടിക്കും; ഞാൻ ഇനി അവരെ ശിക്ഷിക്കാതെ വിടുകയില്ല;<verse eid="AMO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 7:9" />“യിസ്ഹാക്കിന്‍റെ പൂജാഗിരികൾ പാഴും</para>
  <para style="q2" vid="AMO 7:9">യിസ്രായേലിന്‍റെ വിശുദ്ധമന്ദിരങ്ങൾ ശൂന്യവുമായിത്തീരും;</para>
  <para style="q1" vid="AMO 7:9">ഞാൻ യൊരോബെയാം ഗൃഹത്തിനു വിരോധമായി വാളുമായി എഴുന്നേൽക്കും” എന്ന് അരുളിച്ചെയ്തു.<verse eid="AMO 7:9" /></para>
  <para style="s">ആമോസും അമസ്യാവും</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />എന്നാൽ ബേഥേലിലെ പുരോഹിതനായ അമസ്യാവ് യിസ്രായേൽ രാജാവായ യൊരോബെയാമിന്‍റെ അടുക്കൽ ആളയച്ച്: “ആമോസ് യിസ്രായേൽ ഗൃഹത്തിന്‍റെ മദ്ധ്യത്തിൽ നിനക്ക് വിരോധമായി കൂട്ടുകെട്ടുണ്ടാക്കുന്നു; അവന്‍റെ വാക്കുകൾ സഹിക്കുവാൻ ദേശത്തിന് കഴിയുന്നില്ല.<verse eid="AMO 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 7:11" />‘യൊരോബെയാം വാൾകൊണ്ടു മരിക്കും;</para>
  <para style="q2" vid="AMO 7:11">യിസ്രായേൽ സ്വദേശം വിട്ട് പ്രവാസത്തിലേക്കു പോകേണ്ടിവരും’ എന്നിങ്ങനെ ആമോസ് പറയുന്നു” എന്ന് പറയിച്ചു.<verse eid="AMO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12" />എന്നാൽ ആമോസിനോട് അമസ്യാവ്: “ദർശകാ, യെഹൂദാദേശത്തിലേക്ക് ഓടിപ്പൊയ്ക്കൊള്ളുക; അവിടെ പ്രവചിച്ച് ഉപജീവനം കഴിച്ചുകൊള്ളുക. <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />ബേഥേലിലോ ഇനി പ്രവചിക്കരുത്; അത് രാജാവിന്‍റെ വിശുദ്ധമന്ദിരവും രാജധാനിയുമല്ലോ<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="fq" closed="false">രാജധാനിയുമല്ലോ </char><char style="ft" closed="false">ആലയം</char></note>” എന്ന് പറഞ്ഞു.<verse eid="AMO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14" />അതിന് ആമോസ് അമസ്യാവിനോട്: “ഞാൻ പ്രവാചകനല്ല, പ്രവാചക ഗണത്തിലൊരുവനുമല്ല, ഇടയനും കാട്ടത്തിപ്പഴം പെറുക്കുന്നവനും <note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="fq" closed="false">പെറുക്കുന്നവനും </char><char style="ft" closed="false">കാക്കുന്നവനും </char></note>അത്രേ. <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />ഞാൻ ആടുകളെ നോക്കിക്കൊണ്ടിരിക്കുമ്പോൾ യഹോവ എന്നെ പിടിച്ചു: ‘നീ ചെന്നു എന്‍റെ ജനമായ യിസ്രായേലിനോടു പ്രവചിക്കുക’ എന്ന് യഹോവ എന്നോട് കല്പിച്ചു” എന്ന് ഉത്തരം പറഞ്ഞു. <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />ആകയാൽ നീ യഹോവയുടെ വചനം കേൾക്കുക:</para>
  <para style="b" vid="AMO 7:16" />
  <para style="q1" vid="AMO 7:16">“‘യിസ്രായേലിനെക്കുറിച്ച് പ്രവചിക്കരുത്;</para>
  <para style="q2" vid="AMO 7:16">യിസ്‌ഹാക്ക്ഗൃഹത്തിനു വിരോധമായി നീ പ്രസംഗിക്കരുത്’ എന്ന് നീ പറയുന്നുവല്ലോ.”<verse eid="AMO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 7:17" />“അതുകൊണ്ട് യഹോവ ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:</para>
  <para style="q2" vid="AMO 7:17">‘നിന്‍റെ ഭാര്യ നഗരത്തിൽ വേശ്യയാകും;</para>
  <para style="q1" vid="AMO 7:17">നിന്‍റെ പുത്രന്മാരും പുത്രിമാരും വാൾകൊണ്ടു വീഴും;</para>
  <para style="q2" vid="AMO 7:17">നിന്‍റെ ദേശം അളവുനൂൽകൊണ്ട് വിഭാഗിക്കപ്പെടും;</para>
  <para style="q1" vid="AMO 7:17">നീയോ ദൈവത്തെ അറിയാത്ത ഒരു ദേശത്തുവച്ച്<note caller="+" style="f"><char style="fr" closed="false">7:17 </char><char style="fq" closed="false">ദൈവത്തെ അറിയാത്ത ഒരു ദേശത്തുവച്ച് </char><char style="ft" closed="false">അശുദ്ധ ദേശത്തുവച്ച്</char></note> മരിക്കും;</para>
  <para style="q2" vid="AMO 7:17">യിസ്രായേൽ സ്വദേശം വിട്ടു പ്രവാസത്തിലേക്കു പോകേണ്ടിവരും.”<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s">ഒരു പഴക്കൊട്ടയുടെ ദർശനം</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />യഹോവയായ കർത്താവ് എനിക്ക് ഒരു കൊട്ട പഴുത്ത വേനല്‍ക്കാലപ്പഴം<note caller="+" style="f"><char style="fr" closed="false">8:1 </char><char style="fq" closed="false">വേനല്‍ക്കാലപ്പഴം </char><char style="ft" closed="false">അത്തിപ്പഴം</char></note> കാണിച്ചുതന്നു. <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />“ആമോസേ, നീ എന്ത് കാണുന്നു?” എന്ന് അവിടുന്ന് ചോദിച്ചതിന്:</para>
  <para style="p" vid="AMO 8:2">“ഒരു കൊട്ട പഴുത്തപഴം” എന്ന് ഞാൻ പറഞ്ഞു.</para>
  <para style="p" vid="AMO 8:2">യഹോവ എന്നോട് അരുളിച്ചെയ്തത്: “എന്‍റെ ജനമായ യിസ്രായേലിനു പഴുപ്പ് വന്നിരിക്കുന്നു; ഞാൻ ഇനി അവരെ ശിക്ഷിക്കാതെ വിടുകയില്ല. <verse eid="AMO 8:2" /><verse number="3" style="v" sid="AMO 8:3" />ആ നാളിൽ മന്ദിരത്തിലെ ഗീതങ്ങൾ മുറവിളിയാകും” എന്ന് യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്. “ശവം അനവധി! എല്ലായിടത്തും അവ നിശ്ശബ്ദമായി എറിഞ്ഞുകളയപ്പെടും.”<verse eid="AMO 8:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="AMO 8:4" />”ഞങ്ങൾ ഏഫയെ കുറച്ച്,</para>
  <para style="q2" vid="AMO 8:4">ശേക്കലിനെ വലുതാക്കി</para>
  <para style="q1" vid="AMO 8:4">കള്ളത്തുലാസ്സുകൊണ്ട് വഞ്ചന പ്രവർത്തിച്ച്,</para>
  <para style="q2" vid="AMO 8:4">എളിയവരെ പണത്തിനും,</para>
  <para style="q1" vid="AMO 8:4">ദരിദ്രന്മാരെ ഒരു ജോടി ചെരുപ്പിനും</para>
  <para style="q2" vid="AMO 8:4">പകരമായി വാങ്ങേണ്ടതിനും,</para>
  <para style="q1" vid="AMO 8:4">ഗോതമ്പിന്‍റെ പതിര് വില്‍ക്കേണ്ടതിനും,<verse eid="AMO 8:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="AMO 8:5" />ധാന്യവ്യാപാരം ചെയ്യുവാൻ തക്കവിധം</para>
  <para style="q1" vid="AMO 8:5">അമാവാസിയും ഗോതമ്പുവ്യാപാരശാല തുറന്നുവെക്കുവാൻ തക്കവിധം</para>
  <para style="q2" vid="AMO 8:5">ശബ്ബത്തും എപ്പോൾ കഴിഞ്ഞുപോകും’ എന്ന് പറഞ്ഞ്,<verse eid="AMO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 8:6" />ദരിദ്രന്മാരെ വിഴുങ്ങുവാനും</para>
  <para style="q2" vid="AMO 8:6">ദേശത്തിലെ സാധുക്കളെ ഇല്ലാതാക്കുവാനും പോകുന്നവരേ,</para>
  <para style="q2" vid="AMO 8:6">ഇത് കേൾക്കുവിൻ.<verse eid="AMO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 8:7" />ഞാൻ അവരുടെ പ്രവൃത്തികളിൽ യാതൊന്നും ഒരുനാളും മറക്കുകയില്ല”</para>
  <para style="q2" vid="AMO 8:7">എന്ന് യഹോവ യാക്കോബിന്‍റെ മഹിമയെച്ചൊല്ലി സത്യം ചെയ്തിരിക്കുന്നു.<verse eid="AMO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 8:8" />“അതുനിമിത്തം ഭൂമി നടുങ്ങുകയും</para>
  <para style="q2" vid="AMO 8:8">അതിൽ വസിക്കുന്ന ഏവനും ഭ്രമിച്ചുപോകുകയും ചെയ്യുകയില്ലയോ?</para>
  <para style="q1" vid="AMO 8:8">അത് മുഴുവനും നീലനദിപോലെ പൊങ്ങും;</para>
  <para style="q2" vid="AMO 8:8">മിസ്രയീമിലെ നദിപോലെ പൊങ്ങുകയും താഴുകയും ചെയ്യും.<verse eid="AMO 8:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 8:9" />”അന്നാളിൽ ഞാൻ ഉച്ചയ്ക്കു സൂര്യനെ അസ്തമിപ്പിക്കുകയും</para>
  <para style="q2" vid="AMO 8:9">പട്ടാപ്പകൽ ഭൂമിയെ ഇരുട്ടാക്കുകയും ചെയ്യും.<verse eid="AMO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 8:10" />ഞാൻ നിങ്ങളുടെ ഉത്സവങ്ങളെ ദുഃഖമായും</para>
  <para style="q2" vid="AMO 8:10">നിങ്ങളുടെ ഗീതങ്ങളെ വിലാപമായും മാറ്റും;</para>
  <para style="q1" vid="AMO 8:10">ഞാൻ ഏത് അരയിലും രട്ടും</para>
  <para style="q2" vid="AMO 8:10">ഏത് തലയിലും കഷണ്ടിയും വരുത്തും;</para>
  <para style="q1" vid="AMO 8:10">ഞാൻ അതിനെ ഏകജാതനെക്കുറിച്ചുള്ള വിലാപം പോലെയും</para>
  <para style="q2" vid="AMO 8:10">അതിന്‍റെ അവസാനത്തെ കൈപ്പുള്ള ദിവസംപോലെയും ആക്കും”</para>
  <para style="q2" vid="AMO 8:10">എന്ന് യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="AMO 8:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 8:11" />“അപ്പത്തിനായുള്ള വിശപ്പല്ല,</para>
  <para style="q2" vid="AMO 8:11">വെള്ളത്തിനായുള്ള ദാഹവുമല്ല,</para>
  <para style="q1" vid="AMO 8:11">യഹോവയുടെ വചനങ്ങൾ കേൾക്കേണ്ടതിനുള്ള വിശപ്പു തന്നെ</para>
  <para style="q1" vid="AMO 8:11">ഞാൻ ദേശത്തേക്ക് അയക്കുന്ന നാളുകൾ വരുന്നു”</para>
  <para style="q2" vid="AMO 8:11">എന്ന് യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="AMO 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 8:12" />“അന്ന് അവർ സമുദ്രംമുതൽ സമുദ്രംവരെയും</para>
  <para style="q2" vid="AMO 8:12">വടക്കുമുതൽ കിഴക്കുവരെയും ഉഴന്നുചെന്ന്</para>
  <para style="q1" vid="AMO 8:12">യഹോവയുടെ വചനം അന്വേഷിച്ച് അലഞ്ഞുനടക്കും;</para>
  <para style="q2" vid="AMO 8:12">കണ്ടുകിട്ടുകയില്ലതാനും.<verse eid="AMO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 8:13" />ആ നാളിൽ സൗന്ദര്യമുള്ള കന്യകമാരും യൗവനക്കാരും</para>
  <para style="q2" vid="AMO 8:13">ദാഹംകൊണ്ട് ബോധംകെട്ടു വീഴും.<verse eid="AMO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 8:14" />‘ദാനേ, നിന്‍റെ ദൈവത്താണ,</para>
  <para style="q2" vid="AMO 8:14">ബേർ-ശേബാമാർഗ്ഗത്താണ’ എന്ന് പറഞ്ഞുംകൊണ്ട്</para>
  <para style="q2" vid="AMO 8:14">ശമര്യയുടെ അകൃത്യത്തെച്ചൊല്ലി</para>
  <para style="q1" vid="AMO 8:14">സത്യം ചെയ്യുന്നവർ വീഴും;</para>
  <para style="q2" vid="AMO 8:14">ഇനി എഴുന്നേൽക്കുകയുമില്ല.”<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s">ഇസ്രായേൽ നശിപ്പിക്കപ്പെടും</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />യഹോവ യാഗപീഠത്തിനു മീതെ നില്ക്കുന്നത് ഞാൻ കണ്ടു; അവിടുന്ന് അരുളിച്ചെയ്തതെന്തെന്നാൽ:</para>
  <para style="b" vid="AMO 9:1" />
  <para style="q1" vid="AMO 9:1">“ഉത്തരങ്ങൾ കുലുങ്ങുമാറ്</para>
  <para style="q2" vid="AMO 9:1">നീ മകുടത്തെ അടിക്കുക;</para>
  <para style="q1" vid="AMO 9:1">അവ എല്ലാവരുടെയും തലമേൽ വീഴുവാൻ തക്കവിധം തകർത്തുകളയുക;</para>
  <para style="q2" vid="AMO 9:1">അവരുടെ സന്തതിയെ ഞാൻ വാൾകൊണ്ട് കൊല്ലും;</para>
  <para style="q1" vid="AMO 9:1">അവരിൽ ആരും ഓടിപ്പോകുകയില്ല.</para>
  <para style="q2" vid="AMO 9:1">അവരിൽ ആരും വഴുതിപ്പോകുകയുമില്ല.<verse eid="AMO 9:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="AMO 9:2" />അവർ പാതാളത്തിൽ തുരന്നുകടന്നാലും</para>
  <para style="q2" vid="AMO 9:2">അവിടെനിന്ന് എന്‍റെ കൈ അവരെ പിടിക്കും;</para>
  <para style="q1" vid="AMO 9:2">അവർ ആകാശത്തിലേക്ക് കയറിപ്പോയാലും</para>
  <para style="q2" vid="AMO 9:2">അവിടെനിന്ന് ഞാൻ അവരെ ഇറക്കും.<verse eid="AMO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 9:3" />അവർ കർമ്മേലിന്‍റെ കൊടുമുടിയിൽ ഒളിച്ചിരുന്നാലും</para>
  <para style="q2" vid="AMO 9:3">ഞാൻ അവരെ തിരഞ്ഞ് അവിടെനിന്ന് പിടിച്ചുകൊണ്ടുവരും;</para>
  <para style="q1" vid="AMO 9:3">അവർ എന്‍റെ ദൃഷ്ടിയിൽനിന്ന് സമുദ്രത്തിന്‍റെ അടിയിൽ മറഞ്ഞിരുന്നാലും</para>
  <para style="q2" vid="AMO 9:3">ഞാൻ അവിടെ സർപ്പത്തോടു കല്പിച്ചിട്ട് അത് അവരെ കടിക്കും.<verse eid="AMO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 9:4" />അവർ ശത്രുക്കളുടെ മുമ്പിൽ പ്രവാസത്തിലേക്കു പോയാലും</para>
  <para style="q2" vid="AMO 9:4">ഞാൻ അവിടെ വാളിനോടു കല്പിച്ചിട്ട് അത് അവരെ കൊല്ലും.</para>
  <para style="q1" vid="AMO 9:4">നന്മയ്ക്കായിട്ടല്ല തിന്മയ്ക്കായിട്ടു തന്നെ</para>
  <para style="q2" vid="AMO 9:4">ഞാൻ അവരുടെ മേൽ ദൃഷ്ടിവക്കും.”<verse eid="AMO 9:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5" />സൈന്യങ്ങളുടെ യഹോവയായ കർത്താവ് ദേശത്തെ തൊടുന്നു;</para>
  <para style="q2" vid="AMO 9:5">അത് ഉരുകിപ്പോകുന്നു;</para>
  <para style="q1" vid="AMO 9:5">അതിൽ പാർക്കുന്നവർ എല്ലാവരും വിലപിക്കും;</para>
  <para style="q2" vid="AMO 9:5">അത് മുഴുവനും നീലനദിപോലെ പൊങ്ങുകയും</para>
  <para style="q2" vid="AMO 9:5">മിസ്രയീമിലെ നദിപോലെ താഴുകയും ചെയ്യും.<verse eid="AMO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6" />അവിടുന്ന് ആകാശത്തിൽ തന്‍റെ മാളികമുറികളെ പണിയുകയും</para>
  <para style="q2" vid="AMO 9:6">ഭൂമിയിൽ തന്‍റെ മണ്ഡപത്തിന് അടിസ്ഥാനം ഇടുകയും</para>
  <para style="q1" vid="AMO 9:6">സമുദ്രത്തിലെ വെള്ളത്തെ വിളിച്ച് ഭൂതലത്തിൽ പകരുകയും ചെയ്യുന്നു;</para>
  <para style="q2" vid="AMO 9:6">യഹോവ എന്നാകുന്നു അവിടുത്തെ നാമം.<verse eid="AMO 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 9:7" />“യിസ്രായേൽ മക്കളേ നിങ്ങൾ</para>
  <para style="q2" vid="AMO 9:7">എനിക്ക് കൂശ്യരെപ്പോലെ അല്ലയോ”</para>
  <para style="q2" vid="AMO 9:7">എന്ന് യഹോവയുടെ അരുളപ്പാട്;</para>
  <para style="q1" vid="AMO 9:7">“ഞാൻ യിസ്രായേലിനെ മിസ്രയീമിൽനിന്നും</para>
  <para style="q2" vid="AMO 9:7">ഫെലിസ്ത്യരെ കഫ്തോരിൽനിന്നും</para>
  <para style="q1" vid="AMO 9:7">അരാമ്യരെ കീരിൽനിന്നും</para>
  <para style="q2" vid="AMO 9:7">കൊണ്ടുവന്നില്ലയോ?”<verse eid="AMO 9:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 9:8" />“യഹോവയായ കർത്താവിന്‍റെ ദൃഷ്ടി</para>
  <para style="q2" vid="AMO 9:8">പാപമുള്ള രാജ്യത്തിന്മേൽ ഇരിക്കുന്നു;</para>
  <para style="q1" vid="AMO 9:8">ഞാൻ അതിനെ ഭൂതലത്തിൽനിന്ന് നശിപ്പിക്കും;</para>
  <para style="q2" vid="AMO 9:8">എങ്കിലും ഞാൻ യാക്കോബ് ഗൃഹത്തെ മുഴുവനും നശിപ്പിക്കുകയില്ല”</para>
  <para style="q2" vid="AMO 9:8">എന്ന് യഹോവയുടെ അരുളപ്പാട്.<verse eid="AMO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 9:9" />“അരിപ്പകൊണ്ട് അരിക്കുന്നതുപോലെ</para>
  <para style="q2" vid="AMO 9:9">ഞാൻ യിസ്രായേൽഗൃഹത്തെ</para>
  <para style="q1" vid="AMO 9:9">സകലജനതകളുടെയും ഇടയിൽ അരിക്കുവാൻ കല്പിക്കും;</para>
  <para style="q2" vid="AMO 9:9">ഒരു മണിപോലും നിലത്തു വീഴുകയില്ല.<verse eid="AMO 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 9:10" />‘അനർത്ഥം ഞങ്ങളെ പിന്തുടർന്നെത്തുകയില്ല,</para>
  <para style="q2" vid="AMO 9:10">എത്തിപ്പിടിക്കുകയുമില്ല’ എന്നു പറയുന്നവരായി</para>
  <para style="q1" vid="AMO 9:10">എന്‍റെ ജനത്തിലുള്ള സകലപാപികളും</para>
  <para style="q2" vid="AMO 9:10">വാൾകൊണ്ടു മരിക്കും.<verse eid="AMO 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 9:11" />“അവർ ഏദോമിൽ ശേഷിച്ചിരിക്കുന്നവരുടെയും</para>
  <para style="q2" vid="AMO 9:11">എന്‍റെ നാമം വിളിക്കപ്പെടുന്ന സകലജനതകളുടെയും</para>
  <para style="q1" vid="AMO 9:11">ദേശത്തെ കൈവശമാക്കേണ്ടതിന്<verse eid="AMO 9:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="AMO 9:12" />ദാവീദിന്‍റെ വീണുപോയ കൂടാരത്തെ</para>
  <para style="q1" vid="AMO 9:12">ഞാൻ ആ നാളിൽ ഉയർത്തുകയും</para>
  <para style="q2" vid="AMO 9:12">അതിന്‍റെ പിളർപ്പുകളെ അടയ്ക്കുകയും</para>
  <para style="q1" vid="AMO 9:12">അതിന്‍റെ ഇടിവുകളെ തീർക്കുകയും</para>
  <para style="q2" vid="AMO 9:12">അതിനെ പുരാതനകാലത്തിൽ എന്നപോലെ പണിയുകയും ചെയ്യും”</para>
  <para style="q2" vid="AMO 9:12">എന്നാകുന്നു ഇത് അനുഷ്ഠിക്കുന്ന യഹോവയുടെ അരുളപ്പാട്.<verse eid="AMO 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 9:13" />“ഉഴുന്നവൻ കൊയ്യുന്നവന്‍റെയും</para>
  <para style="q2" vid="AMO 9:13">മുന്തിരിപ്പഴം ചവിട്ടുന്നവൻ</para>
  <para style="q1" vid="AMO 9:13">വിതയ്ക്കുന്നവന്‍റെയും മുമ്പിലെത്തുകയും</para>
  <para style="q2" vid="AMO 9:13">പർവ്വതങ്ങൾ പുതുവീഞ്ഞ് പൊഴിക്കുകയും</para>
  <para style="q1" vid="AMO 9:13">എല്ലാ കുന്നുകളും ഉരുകിപ്പോകുകയും</para>
  <para style="q2" vid="AMO 9:13">ചെയ്യുന്ന നാളുകൾ വരും”</para>
  <para style="q2" vid="AMO 9:13">എന്ന് യഹോവയുടെ അരുളപ്പാട്.<verse eid="AMO 9:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="AMO 9:14" />“അപ്പോൾ ഞാൻ എന്‍റെ ജനമായ യിസ്രായേലിന്‍റെ പ്രവാസികളെ മടക്കിവരുത്തും;</para>
  <para style="q2" vid="AMO 9:14">ശൂന്യമായിപ്പോയിരുന്ന പട്ടണങ്ങളെ അവർ പണിത് പാർക്കുകയും</para>
  <para style="q1" vid="AMO 9:14">മുന്തിരിത്തോട്ടങ്ങൾ ഉണ്ടാക്കി അവയിലെ വീഞ്ഞ് കുടിക്കുകയും</para>
  <para style="q2" vid="AMO 9:14">തോട്ടങ്ങൾ ഉണ്ടാക്കി അവയിലെ ഫലം അനുഭവിക്കുകയും ചെയ്യും.<verse eid="AMO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15" />ഞാൻ അവരെ അവരുടെ ദേശത്ത് നടും;</para>
  <para style="q2" vid="AMO 9:15">ഞാൻ അവർക്ക് കൊടുത്തിരിക്കുന്ന ദേശത്തുനിന്ന്</para>
  <para style="q1" vid="AMO 9:15">അവരെ ഇനി പറിച്ചുകളയുകയുമില്ല”</para>
  <para style="q2" vid="AMO 9:15">എന്ന് നിന്‍റെ ദൈവമായ യഹോവ അരുളിച്ചെയ്യുന്നു.<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>