<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="REV" style="id" />
  <para style="ide">UTF-8</para>
  <para style="h">വെളിപ്പാട്</para>
  <para style="toc1">വെളിപ്പാട്</para>
  <para style="toc2">വെളി.</para>
  <para style="toc3">വെളി.</para>
  <para style="mt">വെളിപ്പാട്</para>
  <para style="is">ഗ്രന്ഥകര്‍ത്താവ്</para>
  <para style="ip">“കർത്താവ് ദൂതൻ മുഖാന്തരം അരുളിച്ചെയ്തത് എഴുതിയ” വ്യക്തി എന്നാണ് യോഹന്നാൻ അപ്പോസ്തലൻ സ്വയം പരിചയപ്പെടുത്തുന്നത്. സഭയുടെ ആദ്യകാല എഴുത്തുകാര്‍ ആയിരുന്ന ജസ്റ്റിന്‍ മാര്‍ട്ടിയര്‍ ഐറേനിയസ്, ഹിപ്പോളിടസ്, തെര്‍ത്തുല്യന്‍ അലെക്സന്ത്രിയായിലെ ക്ലെമന്ത്, കൂടാതെ മൂററ്റൊരിയന്‍ രേഖകള്‍ എല്ലാം വെളിപ്പാട് യോഹന്നാന്‍ അപ്പോസ്തലൻ എഴുതി എന്നു അംഗീകരിക്കുന്നു. വെളിപ്പാട് ”അപ്പോകാലിപ്ടിക്” (പ്രത്യാശയെ ദൈവത്തിന്‍റെ ആത്യന്തിക വിജയത്തിൻ്റെ അടിസ്ഥാനത്തില്‍ പ്രകടിപ്പിക്കുവാന്‍ പ്രതീകാത്മകമായ അലങ്കാര പ്രയോഗങ്ങളില്‍ എഴുതുന്ന യെഹൂദ ശൈലി) ശൈലിയിലാണ് രചിച്ചിരിക്കുന്നത്.</para>
  <para style="is">എഴുതപ്പെട്ട കാലഘട്ടവും സ്ഥലവും</para>
  <para style="ip">ഏകദേശം എ. ഡി 95-96.</para>
  <para style="ip">യോഹന്നാന് ഈ പ്രവചനങ്ങള്‍ കിട്ടിയത് ഈജിയന്‍ കടലിലുള്ള പത്മോസ് ദ്വീപില്‍ വച്ചാണ് (വെളി 1:9).</para>
  <para style="is">സ്വീകര്‍ത്താക്കൾ</para>
  <para style="ip">ഏഷ്യമൈനറിലെ ഏഴു സഭകള്‍ക്ക് വേണ്ടിയാണ് ഈ പ്രവചനങ്ങള്‍ ലഭിച്ചത് (വെളി 1:4).</para>
  <para style="is">ഉദ്ദേശ്യം</para>
  <para style="ip">വെളിപ്പാട് പുസ്തകം യേശുവിന്‍റെ ദിവ്യത്വത്തെ വെളിപ്പെടുത്തുന്നു (വെളി 1:1). അവന്‍റെ വ്യക്തിത്വം, ശക്തി, ഭാവികാല സംഭവങ്ങള്‍ എന്നിവയും എഴുതപ്പെട്ടിരിക്കുന്നു. ലോകാവസാനവും അന്ത്യന്യായവിധിയും സംഭവിക്കാൻ പോകുന്ന യാഥാര്‍ത്ഥ്യങ്ങള്‍ ആണെന്ന് മുന്നറിയിപ്പ് നൽകുന്നു. സ്വർഗ്ഗത്തെ കുറിച്ചുള്ള ചെറിയ കാഴ്ച ഈ പുസ്തകം നൽകുന്നു. അതോടൊപ്പം തങ്ങളെത്തന്നെ ശുദ്ധിയായി സൂക്ഷിച്ച ഭക്തന്മാർക്ക് ലഭിക്കാനിരിക്കുന്ന മഹത്വത്തെയും വെളിപ്പെടുത്തുന്നു. വരുവാനുള്ള എല്ലാ അവിശ്വാസികളും നിത്യതയിൽ അഭിമുഖീകരിക്കുന്ന മഹോപദ്രവം അതിന്‍റെ എല്ലാ കഷ്ടങ്ങള്‍, കൂടാതെ അഗ്നിനരകം എന്നിവയുടെ വിവരണം വെളിപ്പാട് പുസ്തകം നമുക്ക് നൽകുന്നു. സാത്താനും അവന്‍റെ ദൂതൻമാർക്കും വരുവാൻ പോകുന്ന ശിക്ഷയെക്കുറിച്ചും ഈ പുസ്തകം വിവരിക്കുന്നു.</para>
  <para style="is">പ്രമേയം</para>
  <para style="ip">മറ നീക്കുക</para>
  <para style="iot">സംക്ഷേപം</para>
  <para style="io1">1. യേശുക്രിസ്തുവിന്‍റെ വെളിപാടും യേശുവിന്‍റെ സാക്ഷ്യവും — 1:1-8</para>
  <para style="io1">2. ആദ്യത്തെ ദർശനം — 1:9-20</para>
  <para style="io1">3. ഏഴു പ്രാദേശിക സഭകൾ — 2:1-3:22</para>
  <para style="io1">4. സംഭവിക്കാൻ പോകുന്ന കാര്യങ്ങൾ — 4:1-22:5</para>
  <para style="io1">5. കർത്താവിന്‍റെ അവസാനമുന്നറിയിപ്പും അപ്പൊസ്തലൻ്റെ സമാപന പ്രാർത്ഥനയും ഉപസംഹാരവും — 22:6-21</para>
  <chapter number="1" style="c" sid="REV 1" />
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1" />യേശുക്രിസ്തുവിന്‍റെ വെളിപ്പാട്: വേഗത്തിൽ സംഭവിക്കുവാനുള്ളത് തന്‍റെ ദാസന്മാരെ കാണിക്കേണ്ടതിന് ദൈവം അത് അവനു കൊടുത്തു. അവൻ അത് തന്‍റെ ദൂതൻ മുഖാന്തരം അയച്ച് തന്‍റെ ദാസനായ യോഹന്നാനെ കാണിച്ചു. <verse eid="REV 1:1" /><verse number="2" style="v" sid="REV 1:2" />യോഹന്നാൻ ദൈവവചനവും യേശുക്രിസ്തുവിനെക്കുറിച്ചുള്ള സാക്ഷ്യവുമായി താൻ കണ്ടതെല്ലാം സാക്ഷീകരിച്ചു. <verse eid="REV 1:2" /><verse number="3" style="v" sid="REV 1:3" />സമയം അടുത്തിരിക്കുന്നതുകൊണ്ട് ഈ പ്രവചനത്തിന്‍റെ വാക്കുകളെ വായിക്കുന്നവനും അവയെ കേൾക്കുന്നവരും അതിൽ എഴുതിയിരിക്കുന്നത് അനുസരിക്കുന്നവരും ഭാഗ്യവാന്മാർ.<verse eid="REV 1:3" /></para>
  <para style="s">ഏഴു സഭകൾക്ക് വന്ദനം</para>
  <para style="p">
    <verse number="4" style="v" sid="REV 1:4" />യോഹന്നാൻ ആസ്യയിലെ ഏഴു സഭകൾക്കും എഴുതുന്നത്: ഇരിക്കുന്നവനും ഇരുന്നവനും വരുന്നവനുമായവങ്കൽ നിന്നും, അവന്‍റെ സിംഹാസനത്തിന്മുമ്പിലുള്ള ഏഴു ആത്മാക്കളുടെ അടുക്കൽനിന്നും, <verse eid="REV 1:4" /><verse number="5" style="v" sid="REV 1:5" />വിശ്വസ്തസാക്ഷിയും മരിച്ചവരിൽ ആദ്യജാതനും ഭൂമിയിലെ രാജാക്കന്മാർക്കു ഭരണകർത്താവുമായ യേശുക്രിസ്തുവിങ്കൽ നിന്നും, നിങ്ങൾക്ക് കൃപയും സമാധാനവും ഉണ്ടാകട്ടെ. <verse eid="REV 1:5" /><verse number="6" style="v" sid="REV 1:6" />നമ്മെ സ്നേഹിച്ചവനും തന്‍റെ രക്തത്താൽ നമ്മുടെ പാപങ്ങളിൽ നിന്നു നമ്മെ മോചിപ്പിച്ചു തന്‍റെ പിതാവായ ദൈവത്തിന് നമ്മെ രാജ്യവും പുരോഹിതന്മാരും ആക്കിത്തീർത്തവനുമായവന് എന്നെന്നേക്കും മഹത്വവും ബലവും; ആമേൻ.<verse eid="REV 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="REV 1:7" />ഇതാ, അവൻ മേഘാരൂഢനായി വരുന്നു;</para>
  <para style="q2" vid="REV 1:7">ഏത് കണ്ണും, അവനെ കുത്തിത്തുളച്ചവരും അവനെ കാണും;</para>
  <para style="q1" vid="REV 1:7">ഭൂമിയിലെ സകലഗോത്രങ്ങളും</para>
  <para style="q2" vid="REV 1:7">അവനെച്ചൊല്ലി വിലപിക്കും. അതെ, ആമേൻ.<verse eid="REV 1:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8" />
    <char style="wj">ഞാൻ അല്ഫയും ഓമേഗയും ആകുന്നു </char>എന്നു ഇരിക്കുന്നവനും ഇരുന്നവനും വരുന്നവനുമായ സർവ്വശക്തിയുള്ള ദൈവമായ കർത്താവ് അരുളിച്ചെയ്യുന്നു.<verse eid="REV 1:8" /></para>
  <para style="s">ക്രിസ്തുവിനെ ദർശിക്കുന്നു</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9" />നിങ്ങളുടെ സഹോദരനും യേശു ക്രിസ്തുവിന്‍റെ കഷ്ടതയിലും രാജ്യത്തിലും സഹനത്തിലും പങ്കാളിയുമായ യോഹന്നാൻ എന്ന ഞാൻ, ദൈവവചനവും യേശുവിനെക്കുറിച്ചുള്ള സാക്ഷ്യം അറിയിച്ചതു നിമിത്തവും പത്മൊസ് എന്ന ദ്വീപിൽ ആയിരുന്നു. <verse eid="REV 1:9" /><verse number="10" style="v" sid="REV 1:10" />കർത്തൃദിവസത്തിൽ<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">കര്‍ത്തൃദിവസം-ആഴചവട്ടത്തിൻ്റെ ഒന്നാം ദിവസമായ ഞായറാഴ്ച</char></note> ഞാൻ പരിശുദ്ധാത്മ വിവശതയിലായി: കാഹളനാദംപോലെ വലിയൊരു ശബ്ദം എന്‍റെ പുറകിൽ കേട്ടു; <verse eid="REV 1:10" /><verse number="11" style="v" sid="REV 1:11" /><char style="wj">ഞാൻ അല്ഫയും ഓമേഗയും ആകുന്നു; ആദ്യനും അന്ത്യനും തന്നെ. നീ കാണുന്നത് ഒരു പുസ്തകത്തിൽ എഴുതി എഫെസൊസ്, സ്മുർന്നാ, പെർഗ്ഗമൊസ്, തുയഥൈരാ, സർദ്ദിസ്, ഫിലദെൽഫ്യ, ലവൊദിക്ക്യാ എന്നീപട്ടണങ്ങളിലുള്ള ഏഴു സഭകൾക്കും അയയ്ക്കുക.</char><verse eid="REV 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12" />എന്നോട് സംസാരിച്ച ശബ്ദം ആരുടേതെന്ന് കാണുവാൻ ഞാൻ തിരിഞ്ഞു. അപ്പോൾ ഏഴു പൊൻനിലവിളക്കുകളെയും <verse eid="REV 1:12" /><verse number="13" style="v" sid="REV 1:13" />നിലവിളക്കുകളുടെ നടുവിൽ നിലയങ്കിയും മാറത്ത് പൊൻകച്ചയും ധരിച്ചവനായി മനുഷ്യപുത്രനെപ്പോലെയുള്ളവനെയും കണ്ടു. <verse eid="REV 1:13" /><verse number="14" style="v" sid="REV 1:14" />അവന്‍റെ തലയും തലമുടിയും വെളുത്ത പഞ്ഞിപോലെ ഹിമത്തോളം വെള്ളയും കണ്ണ് അഗ്നിജ്വാലപോലെയും <verse eid="REV 1:14" /><verse number="15" style="v" sid="REV 1:15" />കാൽ ഉലയിൽ ശുദ്ധീകരിച്ച് തേച്ചുമിനുക്കിയ വെള്ളോടുപോലെയും അവന്‍റെ ശബ്ദം പെരുവെള്ളത്തിന്‍റെ ഇരച്ചിൽപോലെയും ആയിരുന്നു. അവന്‍റെ വലങ്കയ്യിൽ ഏഴു നക്ഷത്രം ഉണ്ട്; <verse eid="REV 1:15" /><verse number="16" style="v" sid="REV 1:16" />അവന്‍റെ വായിൽനിന്നു മൂർച്ചയുള്ള ഇരുവായ്ത്തലയുള്ള വാൾ പുറപ്പെടുന്നു; അവന്‍റെ മുഖം സൂര്യൻ ശോഭയോടെ പ്രകാശിക്കുന്നതുപോലെ ആയിരുന്നു.<verse eid="REV 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 1:17" />അവനെ കണ്ടപ്പോൾ ഞാൻ മരിച്ചവനെപ്പോലെ അവന്‍റെ കാല്ക്കൽ വീണു. അവൻ വലങ്കൈ എന്‍റെമേൽ വെച്ചിട്ട് എന്നോട്: <char style="wj">ഭയപ്പെടേണ്ടാ, ഞാൻ ആദ്യനും അന്ത്യനും ജീവിച്ചിരിക്കുന്നവനും ആകുന്നു.</char> <verse eid="REV 1:17" /><verse number="18" style="v" sid="REV 1:18" /><char style="wj">ഞാൻ മരിച്ചവനായിരുന്നു; എന്നാൽ ഇതാ, എന്നെന്നേക്കും ജീവിക്കുന്നു; ആമേൻ, മരണത്തിൻ്റെയും പാതാളത്തിൻ്റെയും താക്കോൽ എന്‍റെ കയ്യിൽ ഉണ്ട്.</char> <verse eid="REV 1:18" /><verse number="19" style="v" sid="REV 1:19" /><char style="wj">അതുകൊണ്ട് നീ കണ്ടതും ഇപ്പോൾ ഉള്ളതും ഇതിനുശേഷം സംഭവിപ്പാനിരിക്കുന്നതും</char> <verse eid="REV 1:19" /><verse number="20" style="v" sid="REV 1:20" /><char style="wj">എന്‍റെ വലങ്കയ്യിൽ കണ്ട ഏഴു നക്ഷത്രത്തിൻ്റെ മർമ്മവും ഏഴു പൊൻനിലവിളക്കിൻ്റെ വിവരവും എഴുതുക. ഏഴു നക്ഷത്രം ഏഴു സഭകളുടെ ദൂതന്മാരാകുന്നു; നീ കണ്ട ഏഴു നിലവിളക്കുകൾ ഏഴു സഭകൾ ആകുന്നു.</char><verse eid="REV 1:20" /></para>
  <chapter eid="REV 1" />
  <chapter number="2" style="c" sid="REV 2" />
  <para style="s">എഫെസൊസിലെ സഭയ്ക്കുള്ള സന്ദേശം</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1" />
    <char style="wj">എഫെസൊസിലെ സഭയുടെ ദൂതന് എഴുതുക: ഏഴു നക്ഷത്രം വലങ്കയ്യിൽ പിടിച്ചുംകൊണ്ട് ഏഴു പൊൻനിലവിളക്കുകളുടെ നടുവിൽ നടക്കുന്നവൻ അരുളിച്ചെയ്യുന്നത്:</char><verse eid="REV 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 2:2" />
    <char style="wj">ഞാൻ നിന്‍റെ പ്രവൃത്തിയും കഠിനാദ്ധ്വാനവും സഹനവും കൊള്ളരുതാത്തവരെ നിനക്കു സഹിക്കുവാൻ കഴിയാത്തതും അപ്പൊസ്തലന്മാരല്ലാതിരിക്കെ തങ്ങൾ അപ്പൊസ്തലന്മാർ എന്നു പറയുന്നവരെ നീ പരിശോധിച്ച് കള്ളന്മാർ എന്നു കണ്ടെത്തിയതും അറിയുന്നു.</char> <verse eid="REV 2:2" /><verse number="3" style="v" sid="REV 2:3" /><char style="wj">കൂടാതെ നിന്‍റെ സഹനശക്തിയും എന്‍റെ നാമംനിമിത്തം നീ അദ്ധ്വാനിച്ചതും ക്ഷീണിച്ചുപോകാഞ്ഞതും ഞാൻ അറിയുന്നു. </char> <verse eid="REV 2:3" /><verse number="4" style="v" sid="REV 2:4" /><char style="wj">എങ്കിലും നിന്‍റെ ആദ്യസ്നേഹം വിട്ടുകളഞ്ഞു എന്ന ഒരു കുറ്റം എനിക്ക് നിന്നെക്കുറിച്ച് പറയുവാനുണ്ട്.</char> <verse eid="REV 2:4" /><verse number="5" style="v" sid="REV 2:5" /><char style="wj">അതുകൊണ്ട് നീ എവിടെനിന്ന് വീണിരിക്കുന്നു എന്നു ഓർത്തു മാനസാന്തരപ്പെട്ടു ആദ്യത്തെ പ്രവൃത്തി ചെയ്യുക; അല്ലെങ്കിൽ ഞാൻ നിന്‍റെ അടുക്കൽ വേഗം വരുകയും, നീ മാനസാന്തരപ്പെടാഞ്ഞതിനാൽ നിന്‍റെ നിലവിളക്ക് അതിന്‍റെ സ്ഥാനത്തുനിന്ന് നീക്കിക്കളയുകയും ചെയ്യും.</char> <verse eid="REV 2:5" /><verse number="6" style="v" sid="REV 2:6" /><char style="wj">എങ്കിലും നിക്കൊലാവ്യരുടെ</char><note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">നിക്കോലാവോസ് എന്ന വ്യക്തിയുടെ അനുയായികള്‍. അവര്‍ സഭയുടെ ഉപദേശങ്ങള്‍ക്ക് എതിരായിരുന്നു. വിഗ്രഹങ്ങളെ ആരാധിച്ചിരുന്നു. അപ്പൊസ്തലന്മാര്‍ അവരുടെ പ്രവര്‍ത്തികളെയും ഉപദേശങ്ങളെയുംഎതിര്‍ത്തിരുന്നു</char></note> <char style="wj">പ്രവൃത്തി നീ വെറുക്കുന്നു എന്നൊരു നന്മ നിനക്കുണ്ട്. അത് ഞാനും വെറുക്കുന്നു.</char> <verse eid="REV 2:6" /><verse number="7" style="v" sid="REV 2:7" /><char style="wj">ആത്മാവ് സഭകളോടു പറയുന്നത് എന്തെന്ന് കേൾക്കുവാൻ ചെവിയുള്ളവൻ കേൾക്കട്ടെ. ജയിക്കുന്നവന് ഞാൻ ദൈവത്തിന്‍റെ പറുദീസയിൽ ഉള്ള ജീവവൃക്ഷത്തിൻ്റെ ഫലം ഭക്ഷിക്കുവാൻ കൊടുക്കും.</char><verse eid="REV 2:7" /></para>
  <para style="s">സ്മുർന്നയിലെ സഭയ്ക്കുള്ള സന്ദേശം</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8" />
    <char style="wj">സ്മുർന്നയിലെ സഭയുടെ ദൂതന് എഴുതുക: മരിച്ചവനായിരുന്നു എങ്കിലും വീണ്ടും ജീവിക്കയും ചെയ്ത ആദ്യനും അന്ത്യനുമായവൻ അരുളിച്ചെയ്യുന്നത്:</char> <verse eid="REV 2:8" /><verse number="9" style="v" sid="REV 2:9" /><char style="wj">ഞാൻ നിന്‍റെ പ്രവൃത്തിയും കഷ്ടതയും ദാരിദ്ര്യവും — നീ സമ്പന്നനാകുന്നുതാനും — തങ്ങൾ യെഹൂദർ എന്നു പറയുന്നുവെങ്കിലും യെഹൂദരല്ലാത്ത, സാത്താനെ അനുസരിക്കുന്നവരുടെ കൂട്ടരായ പള്ളിക്കാരായവരുടെ ദൈവദൂഷണവും അറിയുന്നു.</char> <verse eid="REV 2:9" /><verse number="10" style="v" sid="REV 2:10" /><char style="wj">നീ സഹിക്കുവാനുള്ളതിനെ ഭയപ്പെടേണ്ടാ; ഇതാ; നിന്നെ പരീക്ഷിക്കേണ്ടതിന് പിശാച് നിങ്ങളിൽ ചിലരെ തടവിൽ ആക്കുവാൻ പോകുന്നു; പത്തു ദിവസം നിനക്കു ഉപദ്രവം ഉണ്ടാകും; മരണംവരെ വിശ്വസ്തനായിരിക്ക; എന്നാൽ ഞാൻ ജീവകിരീടം</char><note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">ജീവകിരീടം-നിത്യജീവന്‍</char></note> <char style="wj">നിനക്കു തരും.</char> <verse eid="REV 2:10" /><verse number="11" style="v" sid="REV 2:11" /><char style="wj">ആത്മാവ് സഭകളോടു പറയുന്നത് എന്തെന്ന് കേൾക്കുവാൻ ചെവിയുള്ളവൻ കേൾക്കട്ടെ. ജയിക്കുന്നവന് രണ്ടാം മരണത്താൽ</char><note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">ഒന്നാം മരണം-ശാരീരിക മരണം. രണ്ടാം മരണം-നിത്യമായ മരണം</char></note> <char style="wj">ദോഷം വരികയില്ല.</char><verse eid="REV 2:11" /></para>
  <para style="s">പെർഗ്ഗമൊസിലെ സഭയ്ക്കുള്ള സന്ദേശം</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12" />
    <char style="wj">പെർഗ്ഗമൊസിലെ സഭയുടെ ദൂതന് എഴുതുക: മൂർച്ചയുള്ള ഇരുവായ്ത്തലവാൾ ഉള്ളവൻ അരുളിച്ചെയ്യുന്നത്:</char> <verse eid="REV 2:12" /><verse number="13" style="v" sid="REV 2:13" /><char style="wj">നിന്‍റെ പ്രവൃത്തിയും നീ എവിടെ താമസിക്കുന്നു എന്നും അത് സാത്താന്‍റെ സിംഹാസനം ഉള്ള സ്ഥലം എന്നും ഞാൻ അറിയുന്നു; എന്നിട്ടും നീ എന്‍റെ നാമം മുറുകെ പിടിച്ചിരിക്കുന്നു; നിങ്ങളുടെ ഇടയിൽ, സാത്താൻ താമസിക്കുന്നിടത്ത് തന്നെ, എന്‍റെ സാക്ഷിയും വിശ്വസ്തനുമായ അന്തിപ്പാസ് കൊല ചെയ്യപ്പെട്ട കാലത്തുപോലും നീ എന്നിലുള്ള വിശ്വാസം നിഷേധിച്ചിട്ടില്ല.</char> <verse eid="REV 2:13" /><verse number="14" style="v" sid="REV 2:14" /><char style="wj">എങ്കിലും നിന്നെക്കുറിച്ച് അല്പം കുറ്റം പറയുവാൻ എനിക്കുണ്ട്; യിസ്രായേൽ മക്കൾ വിഗ്രഹാർപ്പിതം ഭക്ഷിക്കേണ്ടതിനും ദുർന്നടപ്പ് ആചരിക്കേണ്ടതിനും അവരുടെ മുമ്പിൽ തടസ്സംവെപ്പാൻ ബാലാക്കിന്</char><note caller="+" style="f"><char style="fr" closed="false">2:14 </char><char style="ft" closed="false">ബാലാക്ക്-മോവാബ്‌രാജാവ്. ബിലയാം-ബാബിലോണ്യ കള്ളപ്രവാചകന്‍ സംഖ്യ 31:16</char></note> <char style="wj">ഉപദേശിച്ചുകൊടുത്ത ബിലെയാമിന്‍റെ ഉപദേശം മുറുകെപ്പിടിച്ചിരിക്കുന്നവർ അവിടെ നിനക്കുണ്ട്.</char> <verse eid="REV 2:14" /><verse number="15" style="v" sid="REV 2:15" /><char style="wj">അതുപോലെ ഞാൻ വെറുക്കുന്ന നിക്കൊലാവ്യരുടെ ഉപദേശം മുറുകെപ്പിടിച്ചിരിക്കുന്ന ചിലർ നിനക്കും ഉണ്ട്.</char> <verse eid="REV 2:15" /><verse number="16" style="v" sid="REV 2:16" /><char style="wj">അതുകൊണ്ട് മാനസാന്തരപ്പെടുക; അല്ലാതിരുന്നാൽ ഞാൻ വേഗത്തിൽ വന്നു എന്‍റെ വായിൽനിന്നു വരുന്ന വാളുകൊണ്ടു അവർക്കെതിരെ യുദ്ധം ചെയ്യും.</char> <verse eid="REV 2:16" /><verse number="17" style="v" sid="REV 2:17" /><char style="wj">ആത്മാവ് സഭകളോടു പറയുന്നത് എന്തെന്ന് കേൾക്കുവാൻ ചെവിയുള്ളവൻ കേൾക്കട്ടെ. ജയിക്കുന്നവന് ഞാൻ മറഞ്ഞിരിക്കുന്ന മന്ന</char><note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="ft" closed="false">മറഞ്ഞിരിക്കുന്ന മന്ന-സ്വര്‍ഗത്തില്‍ നിന്നും നല്‍കപ്പെടുന്ന രഹസ്യ ഭക്ഷണം</char></note> <char style="wj">തിന്മാൻ കൊടുക്കും; ഞാൻ അവനു വെള്ളക്കല്ലും, ലഭിക്കുന്നവനല്ലാതെ മറ്റാരും അറിയാത്തതും ആ കല്ലിന്മേൽ എഴുതിയിരിക്കുന്നതുമായ പുതിയ ഒരു നാമവും കൊടുക്കും.</char><verse eid="REV 2:17" /></para>
  <para style="s">തുയഥൈരയിലെ സഭയ്ക്കുള്ള സന്ദേശം</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18" />
    <char style="wj">തുയഥൈരയിലെ സഭയുടെ ദൂതന് എഴുതുക: അഗ്നിജ്വാല പോലെ കണ്ണും തേച്ചുമിനുക്കിയ വെള്ളോട്ടിന് സമമായ കാലും ഉള്ള ദൈവപുത്രൻ അരുളിച്ചെയ്യുന്നത്:</char> <verse eid="REV 2:18" /><verse number="19" style="v" sid="REV 2:19" /><char style="wj">ഞാൻ നിന്‍റെ പ്രവൃത്തിയും നിന്‍റെ സ്നേഹം, വിശ്വാസം, ശുശ്രൂഷ, സഹനശക്തി എന്നിവയും നിന്‍റെ ഇപ്പോഴുള്ള പ്രവൃത്തി ആദ്യം ചെയ്തതിലും അധികമെന്നും അറിയുന്നു.</char> <verse eid="REV 2:19" /><verse number="20" style="v" sid="REV 2:20" /><char style="wj">എങ്കിലും, നിനക്കെതിരെ ചിലത് പറയുവാനുണ്ട്; താൻ പ്രവാചകി എന്നു സ്വയം അവകാശപ്പെടുകയും എന്‍റെ ദാസന്മാരെ ദുർന്നടപ്പിൽ ഏർപ്പെടുവാനും വിഗ്രഹാർപ്പിതം ഭക്ഷിക്കുവാനും തക്കവണ്ണം വശീകരിക്കുകയും ഉപദേശിക്കുകയും ചെയ്യുന്ന ഈസേബെൽ എന്ന സ്ത്രീയെ നീ അനുവദിക്കുന്നു.</char> <verse eid="REV 2:20" /><verse number="21" style="v" sid="REV 2:21" /><char style="wj">ഞാൻ അവൾക്ക് മാനസാന്തരപ്പെടുവാൻ അവസരം കൊടുത്തിട്ടും അധാർമ്മികത വിട്ടു അവൾ മാനസാന്തരപ്പെട്ടില്ല.</char> <verse eid="REV 2:21" /><verse number="22" style="v" sid="REV 2:22" /><char style="wj">ജാഗ്രതയായിരിക്ക! അവൾ മാനസാന്തരപ്പെടാതിരുന്നാൽ ഞാൻ അവളെ രോഗകിടക്കയിലും അവളുമായി വ്യഭിചരിക്കുന്നവരെ വലിയ കഷ്ടതയിലും ആക്കിക്കളയും.</char> <verse eid="REV 2:22" /><verse number="23" style="v" sid="REV 2:23" /><char style="wj">ഞാൻ അവളുടെ മക്കളെയും കൊന്നുകളയും; ഞാൻ മനസ്സിനേയും ഹൃദയവിചാരങ്ങളെയും ശോധന ചെയ്യുന്നവൻ എന്നു സകലസഭകളും അറിയും; നിങ്ങളുടെ പ്രവർത്തികൾക്കൊത്തവിധം ഞാൻ നിങ്ങൾക്ക് ഓരോരുത്തർക്കും പകരം ചെയ്യും.</char> <verse eid="REV 2:23" /><verse number="24" style="v" sid="REV 2:24" /><char style="wj">എന്നാൽ നിങ്ങളോടും, ഈ ഉപദേശം സ്വീകരിക്കാതെയും അവർ പറയുന്നതുപോലെ സാത്താനെക്കുറിച്ച് ആഴമായ കാര്യങ്ങൾ ഗ്രഹിക്കാതെയും ഇരിക്കുന്ന തുയഥൈരയിലെ ശേഷമുള്ളവരോടും മറ്റ് വലിയ ഭാരം ഒന്നുംതന്നെ ഞാൻ നിങ്ങളുടെമേൽ ചുമത്തുന്നില്ല.</char> <verse eid="REV 2:24" /><verse number="25" style="v" sid="REV 2:25" /><char style="wj">എന്തുതന്നെ ആയാലും ഞാൻ വരുംവരെ നിനക്കുള്ളത് മുറുകെപ്പിടിച്ചുകൊൾവിൻ.</char> <verse eid="REV 2:25" /><verse number="26" style="v" sid="REV 2:26" /><char style="wj">ജയിക്കുകയും ഞാൻ കല്പിച്ച എന്‍റെ പ്രവൃത്തികളെ അവസാനത്തോളം കാത്തുകൊള്ളുകയും ചെയ്യുന്നവന് എന്‍റെ പിതാവിൽനിന്നും എനിക്ക് ലഭിച്ചതുപോലെ ഞാൻ ജാതികളുടെമേൽ അധികാരം കൊടുക്കും.</char> <verse eid="REV 2:26" /><verse number="27" style="v" sid="REV 2:27" /><char style="wj">അവൻ ഇരുമ്പുചെങ്കോൽകൊണ്ട് അവരെ ഭരിക്കും; മൺപാത്രങ്ങൾപോലെ അവരെ ഉടച്ചുകളയും.</char> <verse eid="REV 2:27" /><verse number="28" style="v" sid="REV 2:28" /><char style="wj">ഞാൻ അവനു ഉദയനക്ഷത്രവും കൊടുക്കും.</char> <verse eid="REV 2:28" /><verse number="29" style="v" sid="REV 2:29" /><char style="wj">ആത്മാവ് സഭകളോടു പറയുന്നത് എന്തെന്ന് കേൾക്കുവാൻ ചെവിയുള്ളവൻ കേൾക്കട്ടെ.</char><verse eid="REV 2:29" /></para>
  <chapter eid="REV 2" />
  <chapter number="3" style="c" sid="REV 3" />
  <para style="s">സർദ്ദിസിലെ സഭയ്ക്കുള്ള സന്ദേശം</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1" />
    <char style="wj">സർദ്ദിസിലെ സഭയുടെ ദൂതന് എഴുതുക: ദൈവത്തിന്‍റെ ഏഴു ആത്മാക്കളും ഏഴു നക്ഷത്രവും വഹിക്കുന്നവൻ അരുളിച്ചെയ്യുന്നത്: ഞാൻ നിന്‍റെ പ്രവൃത്തി അറിയുന്നു. ജീവനുള്ളവൻ എന്നു നിനക്കു ഒരു പേർ ഉണ്ട് എങ്കിലും നീ മരിച്ചവനാകുന്നു.</char> <verse eid="REV 3:1" /><verse number="2" style="v" sid="REV 3:2" /><char style="wj">ഉണരുക; മരിക്കാറായ ശേഷിപ്പുകളെ ശക്തീകരിക്ക; എന്തുകൊണ്ടെന്നാൽ ഞാൻ നിന്‍റെ പ്രവൃത്തി ദൈവത്തിന്‍റെ കണ്ണിൽ പൂർണ്ണതയുള്ളതായി കണ്ടില്ല.</char> <verse eid="REV 3:2" /><verse number="3" style="v" sid="REV 3:3" /><char style="wj">അതുകൊണ്ട് നീ പ്രാപിക്കുകയും കേൾക്കുകയും ചെയ്തതു എന്ത് എന്നു ഓർത്തു കാത്തു സൂക്ഷിക്കുകയും മാനസാന്തരപ്പെടുകയും ചെയ്ക. നീ ഉണരാതിരുന്നാൽ ഞാൻ ഒരു കള്ളനെപ്പോലെ വരും; ഏത് സമയത്ത് ഞാൻ നിനക്കെതിരെ വരും എന്നു നീ അറിയുകയും ഇല്ല.</char> <verse eid="REV 3:3" /><verse number="4" style="v" sid="REV 3:4" /><char style="wj">എങ്കിലും തങ്ങളുടെ വസ്ത്രം അഴുക്കാകാത്ത കുറെ പേർ സർദ്ദിസിലുണ്ട്. അവർ യോഗ്യതയുള്ളവരാകയാൽ വെള്ളധരിച്ചുംകൊണ്ട് എന്നോടുകൂടെ നടക്കും.</char> <verse eid="REV 3:4" /><verse number="5" style="v" sid="REV 3:5" /><char style="wj">ജയിക്കുന്നവൻ വെള്ളവസ്ത്രം ധരിക്കും; അവന്‍റെ പേരു ഞാൻ ഒരിക്കലും ജീവപുസ്തകത്തിൽനിന്ന് മായിച്ചു കളയാതെ എന്‍റെ പിതാവിന്‍റെ സന്നിധിയിലും അവന്‍റെ ദൂതന്മാരുടെ മുമ്പാകെയും ഞാൻ ഏറ്റുപറയും.</char> <verse eid="REV 3:5" /><verse number="6" style="v" sid="REV 3:6" /><char style="wj">ആത്മാവ് സഭകളോടു പറയുന്നത് എന്തെന്ന് കേൾക്കുവാൻ ചെവിയുള്ളവൻ കേൾക്കട്ടെ.</char><verse eid="REV 3:6" /></para>
  <para style="s">ഫിലദെൽഫ്യയിലെ സഭയ്ക്കുള്ള സന്ദേശം</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7" />
    <char style="wj">ഫിലദെൽഫ്യയിലെ സഭയുടെ ദൂതന് എഴുതുക: വിശുദ്ധനും സത്യവാനും ദാവീദിന്‍റെ താക്കോൽ കയ്യിൽ ഉള്ളവനും ആർക്കും അടച്ചുകൂടാതവണ്ണം തുറക്കുന്നവനും ആർക്കും തുറക്കാനാകാത്ത വിധം അടയ്ക്കുകയും ചെയ്യുന്നവൻ അരുളിച്ചെയ്യുന്നത്:</char> <verse eid="REV 3:7" /><verse number="8" style="v" sid="REV 3:8" /><char style="wj">ഞാൻ നിന്‍റെ പ്രവൃത്തി അറിയുന്നു. ഇതാ, ആർക്കും അടയ്ക്കുവാൻ കഴിയാത്തതായ ഒരു തുറന്ന വാതിൽ ഞാൻ നിന്‍റെ മുമ്പിൽ വെച്ചിരിക്കുന്നു; നിനക്കു അല്പം ശക്തി</char><note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">അല്പം ശക്തി-കുറവ് അംഗങ്ങള്‍ മാത്രമുള്ള സഭ</char></note> <char style="wj">മാത്രമേയുള്ളൂ എങ്കിലും നീ എന്‍റെ വചനം അനുസരിച്ചു, എന്‍റെ പേർ തള്ളികളഞ്ഞിട്ടും ഇല്ല.</char> <verse eid="REV 3:8" /><verse number="9" style="v" sid="REV 3:9" /><char style="wj">ജാഗ്രതയായിരിക്ക! യെഹൂദരല്ലാതിരിക്കെ യെഹൂദരെന്ന് കളവായി പറയുന്ന ചിലരെ സാത്താന്‍റെ പള്ളിയിൽ നിന്നും ഞാൻ വരുത്തുകയും നിന്‍റെ പാദത്തിൽ നമസ്കരിപ്പാനും ഞാൻ നിന്നെ സ്നേഹിച്ചു എന്നു അവർ അറിയുവാനും ഇടവരുത്തും.</char> <verse eid="REV 3:9" /><verse number="10" style="v" sid="REV 3:10" /><char style="wj">ക്ഷമയോടുകൂടി ഇരിപ്പാനുള്ള എന്‍റെ കല്പന നീ കാത്തുസൂക്ഷിച്ചതിനാൽ ഭൂമിയിൽ ഒക്കെയും ഉള്ളവരെ ശോധന ചെയ്യേണ്ടതിന് ലോകത്തിൽ വരുവാനുള്ള ശോധനാകാലത്ത് ഞാനും നിന്നെ കാത്തുസൂക്ഷിക്കും.</char> <verse eid="REV 3:10" /><verse number="11" style="v" sid="REV 3:11" /><char style="wj">ഞാൻ വേഗം വരുന്നു; നിന്‍റെ കിരീടം ആരും തട്ടിയെടുക്കാതിരിക്കുവാൻ തക്കവണ്ണം നിനക്കുള്ളത് മുറുകെപ്പിടിച്ചുകൊൾക.</char> <verse eid="REV 3:11" /><verse number="12" style="v" sid="REV 3:12" /><char style="wj">ജയിക്കുന്നവനെ ഞാൻ എന്‍റെ ദൈവത്തിന്‍റെ ആലയത്തിൽ ഒരു തൂണാക്കും; അവൻ ഒരിക്കലും അവിടെനിന്ന് പുറത്തുപോകയില്ല; എന്‍റെ ദൈവത്തിന്‍റെ പേരും എന്‍റെ ദൈവത്തിൻ്റെ പക്കൽ നിന്ന്, സ്വർഗ്ഗത്തിൽനിന്ന് തന്നെ ഇറങ്ങിവരുന്ന, പുതിയ യെരൂശലേം എന്ന എന്‍റെ ദൈവത്തിൻ നഗരത്തിന്‍റെ പേരും എന്‍റെ പുതിയ പേരും ഞാൻ അവന്‍റെമേൽ എഴുതും.</char> <verse eid="REV 3:12" /><verse number="13" style="v" sid="REV 3:13" /><char style="wj">ആത്മാവ് സഭകളോടു പറയുന്നത് എന്തെന്ന് കേൾക്കുവാൻ ചെവിയുള്ളവൻ കേൾക്കട്ടെ.</char><verse eid="REV 3:13" /></para>
  <para style="s">ലവൊദിക്ക്യയിലെ സഭയ്ക്കുള്ള സന്ദേശം</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14" />
    <char style="wj">ലവൊദിക്യയിലെ സഭയുടെ ദൂതന് എഴുതുക: വിശ്വസ്തനും സത്യസാക്ഷിയും ദൈവസൃഷ്ടിയുടെ ആരംഭവുമായ ആമേൻ എന്ന ഞാൻ അരുളിച്ചെയ്യുന്നത്:</char> <verse eid="REV 3:14" /><verse number="15" style="v" sid="REV 3:15" /><char style="wj">ഞാൻ നിന്‍റെ പ്രവൃത്തി അറിയുന്നു; നീ ചൂടുള്ളവനുമല്ല; തണുപ്പുള്ളവനുമല്ല; നീ തണുപ്പുള്ളവനോ ചൂടുള്ളവനോ</char><note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="ft" closed="false">ആത്മികമായി ജീവനോ ആത്മികമായി മരണമോ ഇല്ലാത്തതായ അവസ്ഥ</char></note> <char style="wj">ആയിരുന്നെങ്കിൽ കൊള്ളാമായിരുന്നു.</char> <verse eid="REV 3:15" /><verse number="16" style="v" sid="REV 3:16" /><char style="wj">അതുകൊണ്ട്, നീ തണുപ്പും ചൂടും ഉള്ളവനാകാതെ, അല്പം മാത്രം ചൂടുള്ളവനാകയാൽ ഞാൻ നിന്നെ എന്‍റെ വായിൽനിന്നു തുപ്പിക്കളയും.</char> <verse eid="REV 3:16" /><verse number="17" style="v" sid="REV 3:17" /><char style="wj">ഞാൻ ധനവാൻ; എനിക്ക് ഭൗതിക സ്വത്തുക്കൾ ധാരാളം ഉണ്ട്. എനിക്ക് ഒന്നുംതന്നെ ആവശ്യം ഇല്ല എന്നു നീ പറയുന്നതുകൊണ്ടും; നീ ഏറ്റവും നിർഭാഗ്യവാനും അരിഷ്ടനും ദരിദ്രനും കുരുടനും നഗ്നനും എന്നു അറിയായ്കകൊണ്ടും;</char> <verse eid="REV 3:17" /><verse number="18" style="v" sid="REV 3:18" /><char style="wj">നീ സമ്പന്നൻ ആകേണ്ടതിന് തീയിൽ ഊതിക്കഴിച്ച പൊന്നും നിന്‍റെ നഗ്നതയുടെ ലജ്ജ വെളിവാകാതവണ്ണം ധരിക്കേണ്ടതിന് തിളങ്ങുന്ന ശുഭ്രവസ്ത്രവും, നിനക്കു കാഴ്ച ലഭിക്കേണ്ടതിന് കണ്ണിൽ പുരട്ടുവാൻ ലേപവും എന്നോട് വിലയ്ക്കുവാങ്ങുവാൻ ഞാൻ നിന്നോട് ബുദ്ധി ഉപദേശിക്കുന്നു.</char> <verse eid="REV 3:18" /><verse number="19" style="v" sid="REV 3:19" /><char style="wj">എനിക്ക് പ്രിയമുള്ളവരെയൊക്കെയും ഞാൻ ശാസിക്കുകയും ശിക്ഷിക്കുകയും ചെയ്യുന്നു; അതുകൊണ്ട് നീ ജാഗ്രതയുള്ളവനായിരിക്ക; മാനസാന്തരപ്പെടുക.</char> <verse eid="REV 3:19" /><verse number="20" style="v" sid="REV 3:20" /><char style="wj">ഇതാ, ഞാൻ വാതില്ക്കൽ നിന്നു മുട്ടുന്നു; ആരെങ്കിലും എന്‍റെ ശബ്ദം കേട്ട് വാതിൽ തുറന്നാൽ ഞാൻ അവന്‍റെ അടുക്കൽ ചെല്ലുകയും ഞാൻ അവനോടും അവൻ എന്നോടും കൂടെ അത്താഴം കഴിക്കുകയും ചെയ്യും.</char> <verse eid="REV 3:20" /><verse number="21" style="v" sid="REV 3:21" /><char style="wj">ജയിക്കുന്നവന് ഞാൻ എന്നോടുകൂടെ എന്‍റെ സിംഹാസനത്തിൽ ഇരിക്കുവാൻ അവകാശം നല്കും; ഞാനും ജയിച്ച് എന്‍റെ പിതാവിനോടുകൂടെ അവന്‍റെ സിംഹാസനത്തിൽ ഇരുന്നതുപോലെ തന്നെ.</char> <verse eid="REV 3:21" /><verse number="22" style="v" sid="REV 3:22" /><char style="wj">ആത്മാവ് സഭകളോടു പറയുന്നത് എന്തെന്ന് കേൾക്കുവാൻ ചെവിയുള്ളവൻ കേൾക്കട്ടെ.</char><verse eid="REV 3:22" /></para>
  <chapter eid="REV 3" />
  <chapter number="4" style="c" sid="REV 4" />
  <para style="s">സ്വർഗ്ഗത്തിലെ സിംഹാസനം</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1" />അതിനുശേഷം ഞാൻ നോക്കിയപ്പോൾ സ്വർഗ്ഗത്തിൽ ഒരു വാതിൽ തുറന്നിരിക്കുന്നത് കണ്ടു; ആദ്യമായി ഞാൻ കേട്ടത് കാഹളനാദംപോലെ എന്നോട് സംസാരിച്ചുകൊണ്ടിരുന്ന ഒരു ശബ്ദം ആയിരുന്നു. അത് എന്നോട് പറഞ്ഞത്: <char style="wj">ഇവിടെ കയറിവരിക; ഇനിയും സംഭവിപ്പാനുള്ളത് എന്തെന്ന് ഞാൻ നിന്നെ കാണിച്ചു തരാം.</char> <verse eid="REV 4:1" /><verse number="2" style="v" sid="REV 4:2" />അപ്പോൾ തന്നെ ഞാൻ പരിശുദ്ധാത്മ വിവശതയിലായി, സ്വർഗ്ഗത്തിൽ ഒരു സിംഹാസനം വെച്ചിരിക്കുന്നതും അതിൽ ഒരുവൻ ഇരിക്കുന്നതും ഞാൻ കണ്ടു. <verse eid="REV 4:2" /><verse number="3" style="v" sid="REV 4:3" />അതിൽ ഇരിക്കുന്നവൻ കാഴ്ചയ്ക്ക് സൂര്യകാന്തത്തോടും പത്മരാഗത്തോടും പോലെ ഉള്ളവൻ; സിംഹാസനത്തിന്‍റെ ചുറ്റും കാഴ്ചയ്ക്ക് മരതകത്തോടു തുല്യമായൊരു പച്ചവില്ല്; <verse eid="REV 4:3" /><verse number="4" style="v" sid="REV 4:4" />സിംഹാസനത്തിന്‍റെ ചുറ്റിലും ഇരുപത്തിനാല് സിംഹാസനം; സിംഹാസനത്തിൽ വെള്ളവസ്ത്രം ധരിച്ചുംകൊണ്ട് ഇരുപത്തിനാല് മൂപ്പന്മാർ ഇരുന്നിരുന്നു; അവരുടെ തലയിൽ പൊൻകിരീടങ്ങൾ. <verse eid="REV 4:4" /><verse number="5" style="v" sid="REV 4:5" />സിംഹാസനത്തിൽ നിന്നും മിന്നലും, ഇടിമുഴക്കവും, ശബ്ദഘോഷവും പുറപ്പെട്ടു വരുന്നു; ദൈവത്തിന്‍റെ ഏഴു ആത്മാക്കളായ ഏഴുവിളക്കുകൾ സിംഹാസനത്തിന്‍റെ മുമ്പിൽ കത്തിക്കൊണ്ടിരുന്നു; <verse eid="REV 4:5" /><verse number="6" style="v" sid="REV 4:6" />സിംഹാസനത്തിന്‍റെ മുമ്പിൽ സ്ഫടിക തുല്യമായ കണ്ണാടിക്കടൽ; സിംഹാസനത്തിൻ്റെ നടുവിലും സിംഹാസനത്തിന്‍റെ ചുറ്റിലും നാലു ജീവികൾ, അതിൻ്റെ മുമ്പിലും പുറകിലും കണ്ണുകൾ നിറഞ്ഞിരിക്കുന്നു. <verse eid="REV 4:6" /><verse number="7" style="v" sid="REV 4:7" />ഒന്നാം ജീവി സിംഹത്തെപ്പോലെ; രണ്ടാം ജീവി കാളയെപ്പോലെ മൂന്നാം ജീവി മനുഷ്യനെപ്പോലെ മുഖമുള്ളത്; നാലാം ജീവി പറക്കുന്ന കഴുകനോടു സദൃശം. <verse eid="REV 4:7" /><verse number="8" style="v" sid="REV 4:8" />നാലു ജീവികൾക്കും ആറു ചിറകുകൾ വീതം, അവയ്ക്കുള്ളിൽ നിറയെ കണ്ണുകളും ഉണ്ടായിരുന്നു. ഇരിക്കുന്നവനും ഇരുന്നവനും വരുന്നവനുമായ സർവ്വശക്തിയുള്ള കർത്താവായ ദൈവം പരിശുദ്ധൻ, പരിശുദ്ധൻ, പരിശുദ്ധൻ എന്നു അവർ രാപ്പകൽ വിശ്രമം കൂടാതെ നിരന്തരം പറഞ്ഞുകൊണ്ടിരിക്കുന്നു.<verse eid="REV 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 4:9" />എന്നെന്നേക്കും ജീവിച്ചിരിക്കുന്നവനായി സിംഹാസനത്തിൽ ഇരിക്കുന്നവന് ആ ജീവികൾ മഹത്വവും ബഹുമാനവും സ്തോത്രവും കൊടുക്കുമ്പോഴൊക്കെയും <verse eid="REV 4:9" /><verse number="10" style="v" sid="REV 4:10" />സിംഹാസനത്തിൽ ഇരിക്കുന്നവൻ്റെ മുമ്പിൽ ഇരുപത്തിനാല് മൂപ്പന്മാരും വീണു, എന്നെന്നേക്കും ജീവിച്ചിരിക്കുന്നവനെ നമസ്കരിക്കുകയും അവരുടെ കിരീടങ്ങളെ സിംഹാസനത്തിൻ മുമ്പിൽ ഇട്ടുകൊണ്ട്, <verse eid="REV 4:10" /><verse number="11" style="v" sid="REV 4:11" />ഞങ്ങളുടെ കർത്താവേ, മഹത്വവും, ബഹുമാനവും ശക്തിയും സ്വീകരിക്കുവാൻ നീ യോഗ്യൻ. നിന്‍റെ സന്തോഷത്തിനായി അവ ഉളവാകുകയും സൃഷ്ടിക്കപ്പെടുകയും ചെയ്തിരിക്കുന്നു എന്നു പറഞ്ഞുകൊണ്ടിരിക്കുന്നു.<verse eid="REV 4:11" /></para>
  <chapter eid="REV 4" />
  <chapter number="5" style="c" sid="REV 5" />
  <para style="s">പുസ്തകച്ചുരുളും കുഞ്ഞാടും</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1" />പിന്നെ ഞാൻ സിംഹാസനത്തിൽ ഇരിക്കുന്നവൻ്റെ വലങ്കയ്യിൽ അകത്തും പുറത്തും എഴുതിയിരിക്കുന്നതും ഏഴു മുദ്രയാൽ മുദ്രയിട്ടിരിക്കുന്നതുമായ ഒരു ചുരുൾ കണ്ടു. <verse eid="REV 5:1" /><verse number="2" style="v" sid="REV 5:2" />ആ ചുരുൾ തുറപ്പാനും അതിന്‍റെ മുദ്ര പൊട്ടിയ്ക്കുവാനും യോഗ്യൻ ആർ? എന്നു അത്യുച്ചത്തിൽ വിളംബരം ചെയ്യുന്ന ശക്തനായൊരു ദൂതനെയും ഞാൻ കണ്ടു. <verse eid="REV 5:2" /><verse number="3" style="v" sid="REV 5:3" />ചുരുൾ തുറക്കുവാനോ അത് ഒന്ന് നോക്കുവാൻ പോലുമോ സ്വർഗ്ഗത്തിലും ഭൂമിയിലും ഭൂമിക്കു കീഴിലും ആർക്കും കഴിഞ്ഞില്ല. <verse eid="REV 5:3" /><verse number="4" style="v" sid="REV 5:4" />ചുരുൾ തുറക്കുവാനോ അത് വായിക്കുവാനോ നോക്കുവാനോ യോഗ്യതയുള്ള ആരെയും കണ്ടെത്തായ്കകൊണ്ട് ഞാൻ അതിദുഃഖത്തോടെ കരഞ്ഞു. <verse eid="REV 5:4" /><verse number="5" style="v" sid="REV 5:5" />എങ്കിലും മൂപ്പന്മാരിൽ ഒരുവൻ എന്നോട് പറഞ്ഞത്: കരയേണ്ടാ; നോക്കൂ, യെഹൂദാഗോത്രത്തിലെ സിംഹവും<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="ft" closed="false">യഹൂദാ ഗോത്രത്തിലെ സിംഹം-യഹൂദാ ഗോത്രത്തിലെ ശക്തിയുള്ള ജയിക്കുന്നവനും ദാവീദിന്‍റെ മഹത്വമുള്ള പിന്തുടര്‍ച്ചക്കാരനുമായ ക്രിസ്തു</char></note> ദാവീദിന്‍റെ വേരുമായവൻ ചുരുൾ തുറക്കുവാനും അതിന്‍റെ ഏഴുമുദ്രയും അഴിപ്പാനും തക്കവണ്ണം ജയം പ്രാപിച്ചിരിക്കുന്നു.<verse eid="REV 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6" />സിംഹാസനത്തിൻ്റെയും നാലു ജീവികളുടെയും നടുവിലും മൂപ്പന്മാരുടെ മദ്ധ്യത്തിലും ഒരു കുഞ്ഞാട് അറുക്കപ്പെട്ടതുപോലെ നില്ക്കുന്നതു ഞാൻ കണ്ടു: അവനു ഏഴു കൊമ്പും ഭൂമിയിൽ എല്ലായിടത്തേക്കും അയച്ചിരിക്കുന്ന ദൈവത്തിന്‍റെ ഏഴു ആത്മാക്കളായ ഏഴു കണ്ണും ഉണ്ട്. <verse eid="REV 5:6" /><verse number="7" style="v" sid="REV 5:7" />അവൻ ചെന്നു സിംഹാസനത്തിൽ ഇരിക്കുന്നവൻ്റെ വലങ്കയ്യിൽ നിന്നു ചുരുൾ വാങ്ങി. <verse eid="REV 5:7" /><verse number="8" style="v" sid="REV 5:8" />അവൻ ചുരുൾ വാങ്ങിയപ്പോൾ നാലുജീവികളും ഇരുപത്തിനാല് മൂപ്പന്മാരും കുഞ്ഞാടിൻ്റെ മുമ്പാകെ വീണു. ഓരോരുത്തനു വീണയും വിശുദ്ധന്മാരുടെ പ്രാർത്ഥന എന്ന സുഗന്ധം നിറഞ്ഞ സ്വർണ്ണപാത്രവും ഉണ്ടായിരുന്നു. <verse eid="REV 5:8" /><verse number="9" style="v" sid="REV 5:9" />അവർ ഒരു പുതിയ പാട്ട് പാടി:</para>
  <para style="b" vid="REV 5:9" />
  <para style="q1" vid="REV 5:9">ചുരുൾ വാങ്ങുവാനും അതിന്‍റെ മുദ്ര തുറക്കുവാനും നീ യോഗ്യൻ;</para>
  <para style="q2" vid="REV 5:9">“അങ്ങ് അറുക്കപ്പെട്ടു അങ്ങേയുടെ രക്തംകൊണ്ടു</para>
  <para style="q1" vid="REV 5:9">സകലഗോത്രത്തിലും ഭാഷയിലും വംശത്തിലും ജനതയിലും നിന്നുള്ള ജനങ്ങളെ</para>
  <para style="q2" vid="REV 5:9">അങ്ങ് ദൈവത്തിനായി വിലയ്ക്കു വാങ്ങി;<verse eid="REV 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10" />ഞങ്ങളുടെ ദൈവത്തിനായി അങ്ങ് ഞങ്ങളെ രാജ്യവും പുരോഹിതന്മാരും ആക്കിവെച്ചു;</para>
  <para style="q2" vid="REV 5:10">അവർ ഭൂമിയിൽ വാഴും.”<verse eid="REV 5:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11" />പിന്നെ ഞാൻ നോക്കിയപ്പോൾ സിംഹാസനത്തിൻ്റെയും ജീവികളുടെയും മൂപ്പന്മാരുടെയും ചുറ്റിലും അനേകം ദൂതന്മാരുടെ ശബ്ദം കേട്ടു; അവരുടെ എണ്ണം പതിനായിരം പതിനായിരവും ആയിരം ആയിരവും ആയിരുന്നു. <verse eid="REV 5:11" /><verse number="12" style="v" sid="REV 5:12" />അവർ അത്യുച്ചത്തിൽ പറഞ്ഞത്:</para>
  <para style="b" vid="REV 5:12" />
  <para style="q1" vid="REV 5:12">“അറുക്കപ്പെട്ട കുഞ്ഞാട്</para>
  <para style="q2" vid="REV 5:12">ശക്തിയും ധനവും ജ്ഞാനവും ബലവും</para>
  <para style="q2" vid="REV 5:12">ബഹുമാനവും മഹത്വവും സ്തോത്രവും ലഭിപ്പാൻ യോഗ്യൻ.”<verse eid="REV 5:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="REV 5:13" />സ്വർഗ്ഗത്തിലും ഭൂമിയിലും ഭൂമിക്കു കീഴിലും സമുദ്രത്തിലും ഉള്ള സകല സൃഷ്ടിയും അവയിലുള്ളത് ഒക്കെയും പറയുന്നതായി ഞാൻ കേട്ടത്:</para>
  <para style="b" vid="REV 5:13" />
  <para style="q1" vid="REV 5:13">“സിംഹാസനത്തിൽ ഇരിക്കുന്നവനും കുഞ്ഞാടിനും</para>
  <para style="q2" vid="REV 5:13">സ്തോത്രവും ബഹുമാനവും മഹത്വവും ബലവും</para>
  <para style="q2" vid="REV 5:13">എന്നെന്നേക്കും ഉണ്ടായിരിക്കട്ടെ.”<verse eid="REV 5:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="REV 5:14" />അപ്പോൾ നാലു ജീവികളും, “ആമേൻ!” എന്നു പറഞ്ഞു; ഇരുപത്തിനാല് മൂപ്പന്മാരും എന്നെന്നേക്കും ഇരിക്കുന്നവനെ വീണു നമസ്കരിച്ചു.<verse eid="REV 5:14" /></para>
  <chapter eid="REV 5" />
  <chapter number="6" style="c" sid="REV 6" />
  <para style="s">ഏഴു മുദ്രകൾ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1" />കുഞ്ഞാട് ഏഴു മുദ്രകളിൽ ഒന്ന് പൊട്ടിച്ചപ്പോൾ ഞാൻ കണ്ടത്: “വരിക!” എന്നു നാലു ജീവികളിൽ ഒന്ന് ഇടിമുഴക്കത്തിനൊത്ത ശബ്ദത്തിൽ പറയുന്നതായിരുന്നു. ഞാൻ അത് കേൾക്കുകയും ചെയ്തു. <verse eid="REV 6:1" /><verse number="2" style="v" sid="REV 6:2" />ഞാൻ നോക്കിയപ്പോൾ ഇതാ ഒരു വെള്ളക്കുതിര; അതിന്‍റെ പുറത്ത് ഇരിക്കുന്നവൻ ഒരു വില്ല് പിടിച്ചിരിക്കുന്നു; അവനു ഒരു കിരീടവും കൊടുത്തു; അവൻ ജയിക്കുന്നവനായും ജയാളിയായും പുറപ്പെട്ടു.<verse eid="REV 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3" />അവൻ രണ്ടാം മുദ്ര പൊട്ടിച്ചപ്പോൾ: “വരിക!” എന്നു രണ്ടാം ജീവി പറയുന്നത് ഞാൻ കേട്ടു. <verse eid="REV 6:3" /><verse number="4" style="v" sid="REV 6:4" />അപ്പോൾ ചുവപ്പു നിറമുള്ള മറ്റൊരു കുതിര പുറപ്പെട്ടു; അതിന്‍റെ പുറത്ത് ഇരിക്കുന്നവന് മനുഷ്യർ അന്യോന്യം കൊല്ലുവാൻ തക്കവണ്ണം ഭൂമിയിൽനിന്നു സമാധാനം എടുത്തുകളയേണ്ടതിന് അധികാരം കൊടുത്തു; ഒരു വലിയ വാളും അവനു കൊടുത്തു.<verse eid="REV 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5" />അവൻ മൂന്നാം മുദ്ര പൊട്ടിച്ചപ്പോൾ: “വരിക!” എന്നു മൂന്നാം ജീവി പറയുന്നത് ഞാൻ കേട്ടു. അപ്പോൾ ഞാൻ ഒരു കറുത്ത കുതിരയെ കണ്ടു; അതിന്‍റെ പുറത്ത് ഇരിക്കുന്നവൻ ഒരു തുലാസ് കയ്യിൽ പിടിച്ചിരുന്നു. <verse eid="REV 6:5" /><verse number="6" style="v" sid="REV 6:6" />ഒരു ദിവസക്കൂലിയായ ഒരു പണത്തിന് ഒരിടങ്ങഴി ഗോതമ്പു; ഒരു ദിവസക്കൂലിയായ ഒരു പണത്തിന് മൂന്നിടങ്ങഴി യവം; എന്നാൽ എണ്ണയ്ക്കും വീഞ്ഞിനും കേട് വരുത്തരുത് എന്നു നാലു ജീവികളുടെയും ഇടയിൽനിന്നും ഒരു ശബ്ദവും ഞാൻ കേട്ടു.<verse eid="REV 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7" />അവൻ നാലാം മുദ്ര പൊട്ടിച്ചപ്പോൾ: “വരിക!” എന്നു നാലാം ജീവി പറയുന്ന ശബ്ദം ഞാൻ കേട്ടു. <verse eid="REV 6:7" /><verse number="8" style="v" sid="REV 6:8" />അപ്പോൾ ഞാൻ മഞ്ഞനിറമുള്ള ഒരു കുതിരയെ കണ്ടു; അതിന്മേൽ ഇരിക്കുന്നവന് മരണം എന്നു പേർ; പാതാളം അവനെ പിന്തുടർന്നു; അവർക്ക് വാളുകൊണ്ടും ക്ഷാമംകൊണ്ടും മഹാവ്യാധികൊണ്ടും ഭൂമിയിലെ കാട്ടുമൃഗങ്ങളെക്കൊണ്ടും കൊന്നുകളയുവാൻ ഭൂമിയുടെ നാലിലൊന്നിന്മേൽ അധികാരം നല്കപ്പെട്ടു.<verse eid="REV 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9" />അവൻ അഞ്ചാം മുദ്ര പൊട്ടിച്ചപ്പോൾ: ദൈവവചനം നിമിത്തവും തങ്ങൾ ഉറപ്പോടെ കാത്തുകൊണ്ട സാക്ഷ്യം നിമിത്തവും കൊല്ലപ്പെട്ടവരുടെ ആത്മാക്കളെ ഞാൻ യാഗപീഠത്തിന്‍റെ കീഴിൽ കണ്ടു; <verse eid="REV 6:9" /><verse number="10" style="v" sid="REV 6:10" />വിശുദ്ധനും സത്യവാനുമായ കർത്താവേ, ഭൂമിയിൽ ജീവിക്കുന്നവരോട് ന്യായവിധിയും ഞങ്ങളുടെ രക്തത്തിനുള്ള പ്രതികാരവും നീ എത്രത്തോളം നടത്താതെയിരിക്കും എന്നു അവർ ഉറക്കെ നിലവിളിച്ചു. <verse eid="REV 6:10" /><verse number="11" style="v" sid="REV 6:11" />അപ്പോൾ അവരിൽ ഓരോരുത്തർക്കും വെള്ളനിലയങ്കി നല്കപ്പെട്ടു; അവരെപ്പോലെ കൊല്ലപ്പെടുവാനിരിക്കുന്ന അവരുടെ സഹശുശ്രൂഷകന്മാരും സഹോദരന്മാരും സംഖ്യ പൂർത്തിയാകുന്നതുവരെ അല്പകാലം കൂടെ വിശ്രമിക്കേണമെന്ന് അവർക്ക് അരുളപ്പാടുണ്ടായി.<verse eid="REV 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12" />അവൻ ആറാം മുദ്ര പൊട്ടിച്ചപ്പോൾ; ഞാൻ കണ്ടത്: ഒരു വലിയ ഭൂകമ്പം ഉണ്ടായി; സൂര്യൻ കരിമ്പടംപോലെ കറുത്തു; ചന്ദ്രൻ രക്തതുല്യമായിത്തീർന്നു. <verse eid="REV 6:12" /><verse number="13" style="v" sid="REV 6:13" />അത്തിവൃക്ഷം കൊടുങ്കാറ്റുകൊണ്ട് കുലുങ്ങിയിട്ട് തണുപ്പുകാലത്ത് കായ് ഉതിർക്കുമ്പോലെ ആകാശത്തിലെ നക്ഷത്രങ്ങൾ ഭൂമിയിൽ വീണു. <verse eid="REV 6:13" /><verse number="14" style="v" sid="REV 6:14" />ചുരുൾ മുകളിലേക്കു ചുരുട്ടുംപോലെ ആകാശം ഇല്ലാതായി; എല്ലാ മലയും ദ്വീപും സ്വസ്ഥാനത്തുനിന്ന് നീങ്ങിപ്പോയി.<verse eid="REV 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 6:15" />അപ്പോൾ ഭൂമിയിലെ രാജാക്കന്മാരും പ്രധാനികളും സഹസ്രാധിപന്മാരും ധനവാന്മാരും ബലവാന്മാരും സകല ദാസനും സ്വതന്ത്രനും ഗുഹകളിലും മലകളിലെ പാറകളുടെ ഇടയിലും ഒളിച്ചുകൊണ്ട് മലകളോടും പാറകളോടും; <verse eid="REV 6:15" /><verse number="16" style="v" sid="REV 6:16" />“ഞങ്ങളുടെമേൽ വീഴുവിൻ; സിംഹാസനത്തിൽ ഇരിക്കുന്നവൻ്റെ ദൃഷ്ടിയിൽനിന്നും കുഞ്ഞാടിൻ്റെ കോപത്തിൽ നിന്നും ഞങ്ങളെ മറയ്ക്കുവിൻ. <verse eid="REV 6:16" /><verse number="17" style="v" sid="REV 6:17" />അവന്‍റെ മഹാകോപദിവസം വന്നിരിക്കുന്നു; ആർക്ക് നില്ക്കുവാൻ കഴിയും?” എന്നു പറഞ്ഞു.<verse eid="REV 6:17" /></para>
  <chapter eid="REV 6" />
  <chapter number="7" style="c" sid="REV 7" />
  <para style="s">മുദ്രയിട്ട 1,44,000</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1" />ഇതിനുശേഷം ഭൂമിമേലും കടലിന്മേലും യാതൊരു വൃക്ഷത്തിന്മേലും കാറ്റ് ഊതാതിരിക്കേണ്ടതിനു നാലു ദൂതന്മാർ ഭൂമിയിലെ നാലു കാറ്റും പിടിച്ചുകൊണ്ടു ഭൂമിയുടെ നാലു ദിക്കിലും നില്ക്കുന്നതു ഞാൻ കണ്ടു. <verse eid="REV 7:1" /><verse number="2" style="v" sid="REV 7:2" />മറ്റൊരു ദൂതൻ ജീവനുള്ള ദൈവത്തിന്‍റെ മുദ്രയുമായി കിഴക്കുനിന്ന് മുകളിലേക്കു വരുന്നത് ഞാൻ കണ്ടു. അവൻ ഭൂമിക്കും സമുദ്രത്തിനും കേടുവരുത്തുവാൻ അധികാരം നല്കപ്പെട്ട നാലു ദൂതന്മാരോട്: <verse eid="REV 7:2" /><verse number="3" style="v" sid="REV 7:3" />നമ്മുടെ ദൈവത്തിന്‍റെ ദാസന്മാരുടെ നെറ്റികളിൽ ഞങ്ങൾ ഒരു മുദ്രയിട്ട് തീരുവോളം ഭൂമിക്കോ, സമുദ്രത്തിനോ, വൃക്ഷങ്ങൾക്കോ കേടുവരുത്തരുത് എന്നു ഉറക്കെ വിളിച്ചുപറഞ്ഞു. <verse eid="REV 7:3" /><verse number="4" style="v" sid="REV 7:4" />മുദ്രയേറ്റവരുടെ എണ്ണവും ഞാൻ കേട്ടു; യിസ്രായേൽ ജനങ്ങളുടെ എല്ലാ ഗോത്രത്തിലും നിന്നു മുദ്രയേറ്റവർ നൂറ്റിനാല്പത്തിനാലായിരം (1,44,000) പേർ ആയിരുന്നു.<verse eid="REV 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 7:5" />യെഹൂദാ ഗോത്രത്തിൽ നിന്നു മുദ്രയേറ്റവർ പന്ത്രണ്ടായിരം;</para>
  <para style="q2" vid="REV 7:5">രൂബേൻഗോത്രത്തിൽനിന്നു പന്ത്രണ്ടായിരം;</para>
  <para style="q1" vid="REV 7:5">ഗാദ്ഗോത്രത്തിൽ നിന്നു പന്ത്രണ്ടായിരം.<verse eid="REV 7:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="REV 7:6" />ആശേർ ഗോത്രത്തിൽ നിന്നു പന്ത്രണ്ടായിരം;</para>
  <para style="q1" vid="REV 7:6">നഫ്താലി ഗോത്രത്തിൽ നിന്നു പന്ത്രണ്ടായിരം;</para>
  <para style="q2" vid="REV 7:6">മനശ്ശെ ഗോത്രത്തിൽ നിന്നു പന്ത്രണ്ടായിരം.<verse eid="REV 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 7:7" />ശിമെയോൻ ഗോത്രത്തിൽ നിന്നു പന്ത്രണ്ടായിരം;</para>
  <para style="q2" vid="REV 7:7">ലേവി ഗോത്രത്തിൽ നിന്നു പന്ത്രണ്ടായിരം;</para>
  <para style="q1" vid="REV 7:7">യിസ്സാഖാർ ഗോത്രത്തിൽ നിന്നു പന്ത്രണ്ടായിരം;<verse eid="REV 7:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="REV 7:8" />സെബൂലൂൻ ഗോത്രത്തിൽ നിന്നു പന്ത്രണ്ടായിരം;</para>
  <para style="q1" vid="REV 7:8">യോസേഫ് ഗോത്രത്തിൽ നിന്നു പന്ത്രണ്ടായിരം;</para>
  <para style="q2" vid="REV 7:8">ബെന്യാമീൻ ഗോത്രത്തിൽ നിന്നു മുദ്രയേറ്റവർ പന്ത്രണ്ടായിരവും ആയിരുന്നു.<verse eid="REV 7:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="REV 7:9" />ഈ സംഭവങ്ങൾക്കുശേഷം ഞാൻ നോക്കിയപ്പോൾ, എല്ലാ ജനതകളിലും ഗോത്രങ്ങളിലും വംശങ്ങളിലും ഭാഷകളിലും നിന്ന് സിംഹാസനത്തിനും കുഞ്ഞാടിനും മുമ്പാകെ നില്ക്കുന്ന, ആർക്കും എണ്ണിത്തീർക്കുവാൻ കഴിയാത്ത വെള്ളനിലയങ്കി ധരിച്ചും കൈകളിൽ കുരുത്തോലകൾ പിടിച്ചും ഉള്ള ഒരു മഹാപുരുഷാരത്തെ കണ്ടു. അവർ അത്യുച്ചത്തിൽ വിളിച്ചുപറഞ്ഞത്: <verse eid="REV 7:9" /><verse number="10" style="v" sid="REV 7:10" />“രക്ഷ സിംഹാസനത്തിൽ ഇരിക്കുന്നവനായ നമ്മുടെ ദൈവത്തിനും കുഞ്ഞാടിനും ഉള്ളത്.”<verse eid="REV 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 7:11" />സകലദൂതന്മാരും സിംഹാസനത്തിൻ്റെയും മൂപ്പന്മാരുടെയും നാലു ജീവികളുടെയും ചുറ്റും നിന്നു, അവർ സിംഹാസനത്തിന്‍റെ മുമ്പിൽ കവിണ്ണുവീണു ദൈവത്തെ ആരാധിച്ചും കൊണ്ടു പറഞ്ഞത്:<verse eid="REV 7:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="REV 7:12" />“ആമേൻ;</para>
  <para style="q2" vid="REV 7:12">നമ്മുടെ ദൈവത്തിന് എന്നെന്നേക്കും</para>
  <para style="q1" vid="REV 7:12">സ്തുതിയും മഹത്വവും ജ്ഞാനവും സ്തോത്രവും</para>
  <para style="q2" vid="REV 7:12">ബഹുമാനവും ശക്തിയും ബലവും;</para>
  <para style="q1" vid="REV 7:12">ആമേൻ.”<verse eid="REV 7:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13" />അപ്പോൾ മൂപ്പന്മാരിൽ ഒരുവൻ എന്നോട്: “വെള്ളനിലയങ്കി ധരിച്ചിരിക്കുന്ന ഇവർ ആർ? അവർ എവിടെ നിന്നു വന്നു?“ എന്നു ചോദിച്ചു.<verse eid="REV 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14" />“യജമാനനേ അങ്ങേയ്ക്ക് അറിയാമല്ലോ“ എന്നു ഞാൻ പറഞ്ഞതിന്</para>
  <para style="p" vid="REV 7:14">അവൻ എന്നോട് പറഞ്ഞത്: “ഇവർ മഹാകഷ്ടത്തിൽ നിന്ന് വന്നവർ; അവർ കുഞ്ഞാടിൻ്റെ രക്തത്തിൽ<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="ft" closed="false">കുഞ്ഞാടിൻ്റെ രക്തം-ക്രിസ്തുവിന്‍റെ പാപപരിഹാരയാഗം</char></note> അവരുടെ അങ്കി അലക്കി വെളുപ്പിച്ചിരിക്കുന്നു. <verse eid="REV 7:14" /><verse number="15" style="v" sid="REV 7:15" />അതുകൊണ്ട് അവർ ദൈവത്തിന്‍റെ സിംഹാസനത്തിൻ മുമ്പിലിരുന്ന് അവന്‍റെ ആലയത്തിൽ രാവും പകലും അവനെ ആരാധിക്കുന്നു; സിംഹാസനത്തിൽ ഇരിക്കുന്നവൻ അവരോട് കൂടെ വസിക്കും. <verse eid="REV 7:15" /><verse number="16" style="v" sid="REV 7:16" />ഇനി അവർക്ക് വിശക്കയില്ല ദാഹിക്കയും ഇല്ല; വെയിലോ അത്യുഷ്ണമോ അവരെ ഒരിക്കലും ബാധിക്കുകയില്ല. <verse eid="REV 7:16" /><verse number="17" style="v" sid="REV 7:17" />സിംഹാസനത്തിന്‍റെ മദ്ധ്യേ ഉള്ള കുഞ്ഞാട് അവരെ മേയിക്കുകയും അവരെ ജീവജലത്തിൻ്റെ ഉറവുകളിലേക്ക് നയിക്കുകയും ചെയ്യും. ദൈവം അവരുടെ കണ്ണിൽ നിന്ന് കണ്ണുനീർ എല്ലാം തുടച്ചുകളയുകയും ചെയ്യും.“<verse eid="REV 7:17" /></para>
  <chapter eid="REV 7" />
  <chapter number="8" style="c" sid="REV 8" />
  <para style="s">ഏഴാം മുദ്രയും തങ്കധൂപകലശവും</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1" />കുഞ്ഞാട് ഏഴാം മുദ്ര പൊട്ടിച്ചപ്പോൾ സ്വർഗ്ഗത്തിൽ ഏകദേശം അരമണിക്കൂറോളം നിശബ്ദത ഉണ്ടായി. <verse eid="REV 8:1" /><verse number="2" style="v" sid="REV 8:2" />അപ്പോൾ ഞാൻ ദൈവസന്നിധിയിൽ നില്ക്കുന്ന ഏഴു ദൂതന്മാരെ കണ്ടു, അവർക്ക് ഏഴു കാഹളം കൊടുക്കുകയും ചെയ്തു.<verse eid="REV 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3" />മറ്റൊരു ദൂതൻ വന്നു ഒരു സ്വർണ്ണധൂപപാത്രം പിടിച്ചുകൊണ്ടു യാഗപീഠത്തിനരികെ നിന്നു. സിംഹാസനത്തിൻ മുമ്പിലുള്ള സ്വർണ്ണയാഗപീഠത്തിന്മേൽ സകലവിശുദ്ധജനങ്ങളുടെയും പ്രാർത്ഥനയോടുകൂടെ അത് അർപ്പിക്കേണ്ടതിന് ധാരാളം സുഗന്ധദ്രവ്യവും അവനു കൊടുത്തു. <verse eid="REV 8:3" /><verse number="4" style="v" sid="REV 8:4" />സുഗന്ധദ്രവ്യത്തിൻ്റെ പുക വിശുദ്ധന്മാരുടെ പ്രാർത്ഥനയോടുകൂടെ ദൂതന്‍റെ കയ്യിൽനിന്ന് ദൈവസന്നിധിയിലേക്ക് ഉയർന്നു. <verse eid="REV 8:4" /><verse number="5" style="v" sid="REV 8:5" />ദൂതൻ സുഗന്ധധൂപം എടുത്തു യാഗപീഠത്തിൽ നിന്നും തീക്കനൽ നിറച്ച് ഭൂമിയിലേക്കു എറിഞ്ഞു; അവിടെ ഇടിമുഴക്കങ്ങളും, ശബ്ദകോലാഹലങ്ങളും, മിന്നലുകളും, ഭൂകമ്പവും ഉണ്ടായി.<verse eid="REV 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6" />ഏഴു കാഹളങ്ങളുള്ള ഏഴു ദൂതന്മാർ കാഹളം ഊതുവാൻ ഒരുങ്ങിനിന്നു.<verse eid="REV 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7" />ഒന്നാമത്തെ ദൂതൻ കാഹളം ഊതി; അപ്പോൾ രക്തം കലർന്ന കല്മഴയും തീയും ഭൂമിയിൽ പതിച്ചു; ഭൂമിയിൽ മൂന്നിലൊന്നു വെന്തുപോയി; വൃക്ഷങ്ങളിൽ മൂന്നിലൊന്നു വെന്തുപോയി; എല്ലാ പച്ചപ്പുല്ലും വെന്തുപോയി.<verse eid="REV 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8" />രണ്ടാമത്തെ ദൂതൻ കാഹളം ഊതി; അപ്പോൾ തീ കത്തുന്ന വൻമലപോലെയൊന്ന് സമുദ്രത്തിലേക്കു വീണിട്ട് കടൽ മൂന്നിലൊന്നു രക്തമായിത്തീർന്നു. <verse eid="REV 8:8" /><verse number="9" style="v" sid="REV 8:9" />സമുദ്രത്തിൽ ജീവനുണ്ടായിരുന്ന സൃഷ്ടികളിൽ മൂന്നിലൊന്നു ചത്തുപോയി; കപ്പലുകളിലും മൂന്നിലൊന്നു നശിച്ചുപോയി.<verse eid="REV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10" />മൂന്നാമത്തെ ദൂതൻ കാഹളം ഊതി; അപ്പോൾ ദീപംപോലെ ജ്വലിക്കുന്ന ഒരു മഹാനക്ഷത്രം ആകാശത്തുനിന്നു വീണു. നദികളിൽ മൂന്നിലൊന്നിന്മേലും നീരുറവുകളിന്മേലും ആയിരുന്നു വീണത്. <verse eid="REV 8:10" /><verse number="11" style="v" sid="REV 8:11" />ആ നക്ഷത്രത്തിന് കാഞ്ഞിരം എന്നു പേർ; വെള്ളത്തിൽ മൂന്നിലൊന്നു വിഷമയം ആയിത്തീർന്നു. കയ്പായ വെള്ളത്താൽ മനുഷ്യരിൽ പലരും മരിച്ചുപോയി.<verse eid="REV 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12" />നാലാമത്തെ ദൂതൻ കാഹളം ഊതി; അപ്പോൾ സൂര്യനിൽ മൂന്നിലൊന്നും ചന്ദ്രനിൽ മൂന്നിലൊന്നും നക്ഷത്രങ്ങളിൽ മൂന്നിലൊന്നും ബാധിക്കപ്പെട്ടു; അതുകൊണ്ട് അവയിൽ മൂന്നിലൊന്നു ഇരുണ്ടുപോയി; മൂന്നിലൊന്നു പകലും മൂന്നിലൊന്നു രാവും വെളിച്ചമില്ലാതെയായി.<verse eid="REV 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13" />ഇനിയും ഊതുവാനുള്ള മൂന്നു ദൂതന്മാരുടെ കാഹളനാദം നിമിത്തം ഭൂമിയിൽ ജീവിക്കുന്നവർക്ക് കഷ്ടം, കഷ്ടം, കഷ്ടം എന്നു ഉറക്കെ പറഞ്ഞുകൊണ്ട് ആകാശമധ്യേ പറന്നുകൊണ്ടിരിക്കുന്ന ഒരു കഴുകനെ ഞാൻ കാണുകയും അതിന്‍റെ ശബ്ദം കേൾക്കുകയും ചെയ്തു.<verse eid="REV 8:13" /></para>
  <chapter eid="REV 8" />
  <chapter number="9" style="c" sid="REV 9" />
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1" />പിന്നെ അഞ്ചാമത്തെ ദൂതൻ കാഹളം ഊതി; അപ്പോൾ ഒരു നക്ഷത്രം ആകാശത്തുനിന്നു ഭൂമിയിൽ വീഴുന്നത് ഞാൻ കണ്ടു; അഗാധഗർത്തത്തിൻ്റെ താക്കോൽ അവനു കൊടുത്തു. <verse eid="REV 9:1" /><verse number="2" style="v" sid="REV 9:2" />അവൻ അഗാധഗർത്തം തുറന്നു; ഒരു വലിയ ചൂളയിൽ നിന്നുള്ള പുകപോലെ ഗർത്തത്തിൽനിന്ന് പുകപൊങ്ങി; ഗർത്തത്തിൽ നിന്നും ഉയർന്ന പുകയാൽ സൂര്യനും അന്തരീക്ഷവും ഇരുണ്ടുപോയി. <verse eid="REV 9:2" /><verse number="3" style="v" sid="REV 9:3" />പുകയിൽ നിന്ന് വെട്ടുക്കിളികൾ ഭൂമിമേൽ വന്നു, അവയ്ക്ക് ഭൂമിയിലെ തേളുകൾക്കുള്ളതുപോലെയുള്ള ശക്തി കൊടുക്കപ്പെടുകയും ചെയ്തു. <verse eid="REV 9:3" /><verse number="4" style="v" sid="REV 9:4" />നെറ്റിയിൽ ദൈവത്തിന്‍റെ മുദ്രയില്ലാത്ത മനുഷ്യർക്കല്ലാതെ ഭൂമിയിലുള്ള പുല്ലിനൊ, പച്ചയായ സസ്യത്തിനൊ, യാതൊരു വൃക്ഷത്തിനും കേടുവരുത്തരുത് എന്നു അതിന് കല്പന ലഭിച്ചു. <verse eid="REV 9:4" /><verse number="5" style="v" sid="REV 9:5" />അവരെ കൊല്ലുവാനല്ല, എന്നാൽ അഞ്ചുമാസക്കാലം അവരെ ഉപദ്രവിക്കുവാനത്രേ അവയ്ക്ക് അധികാരം നല്കിയത്; അവരുടെ വേദന, തേൾ മനുഷ്യനെ കുത്തുമ്പോൾ ഉണ്ടാകുന്ന വേദനപോലെ തന്നെ. <verse eid="REV 9:5" /><verse number="6" style="v" sid="REV 9:6" />ആ കാലത്ത് മനുഷ്യർ മരണം അന്വേഷിക്കും; പക്ഷേ അത് കണ്ടെത്തുകയില്ലതാനും; അവർ മരിക്കുവാൻ ആശിക്കും; എന്നാൽ മരണം അവരെ വിട്ട് ഓടിപ്പോകും.<verse eid="REV 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7" />വെട്ടുക്കിളികളുടെ രൂപം യുദ്ധത്തിന് ഒരുക്കിയ കുതിരകളെപ്പോലെ; അവയുടെ തലകളിൽ സ്വർണ്ണകിരീടങ്ങൾ പോലെ എന്തോ ഉണ്ടായിരുന്നു; അവയുടെ മുഖങ്ങൾ മനുഷ്യരുടെ മുഖങ്ങൾ പോലെയും ആയിരുന്നു. <verse eid="REV 9:7" /><verse number="8" style="v" sid="REV 9:8" />സ്ത്രീകളുടെ മുടിപോലെ അവയ്ക്ക് മുടി ഉണ്ടായിരുന്നു; അവയുടെ പല്ലുകൾ സിംഹത്തിന്‍റെ പല്ലുകൾ പോലെ ആയിരുന്നു. <verse eid="REV 9:8" /><verse number="9" style="v" sid="REV 9:9" />ഇരുമ്പുകവചംപോലെ അവയ്ക്ക് കവചങ്ങൾ ഉണ്ട്; അവയുടെ ചിറകുകളുടെ ശബ്ദം യുദ്ധത്തിനു ഓടുന്ന അനേകം രഥങ്ങളും കുതിരകളും ഉണ്ടാക്കുന്ന ശബ്ദംപോലെയും ആയിരുന്നു. <verse eid="REV 9:9" /><verse number="10" style="v" sid="REV 9:10" />അവയ്ക്ക് തേളുകളെപ്പോലെ വാലുകളും വിഷമുള്ളുകളും ഉണ്ടായിരുന്നു; മനുഷ്യരെ അഞ്ചുമാസക്കാലം ഉപദ്രവിക്കുവാനുള്ള ശക്തി അവയുടെ വാലുകളിൽ ഉണ്ടായിരുന്നു. <verse eid="REV 9:10" /><verse number="11" style="v" sid="REV 9:11" />അഗാധഗർത്തത്തിൻ്റെ ദൂതൻ അവയുടെമേൽ രാജാവായി ഉണ്ടായിരുന്നു; അവന്‍റെ പേർ എബ്രായ ഭാഷയിൽ അബദ്ദോൻ<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="ft" closed="false">അബദ്ദോന്‍-നാശം, അപ്പല്ലുവോന്‍-നശിപ്പിക്കുന്നവന്‍</char></note> എന്നാകുന്നു, എന്നാൽ ഗ്രീക്ക് ഭാഷയിൽ അത് അപ്പൊല്ലുവോൻ എന്നും ആകുന്നു.<verse eid="REV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12" />ആദ്യത്തെ കഷ്ടം കഴിഞ്ഞുപോയി. ജാഗ്രതയായിരിക്ക! ഇനിയും രണ്ടു കഷ്ടങ്ങൾ കൂടെ വരുവാനുണ്ട്.<verse eid="REV 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13" />ആറാമത്തെ ദൂതൻ കാഹളം ഊതി; അപ്പോൾ ദൈവസന്നിധിയിലുള്ള സ്വർണ്ണയാഗപീഠത്തിലെ നാലു കൊമ്പുകളിൽനിന്ന് ഒരു ശബ്ദം വരുന്നത് ഞാൻ കേട്ടു. <verse eid="REV 9:13" /><verse number="14" style="v" sid="REV 9:14" />ആ ശബ്ദം കാഹളം കയ്യിലുള്ള ആറാമത്തെ ദൂതനോട് പറഞ്ഞത്, “യൂഫ്രട്ടീസ് എന്ന മഹാനദിക്കരികെ ബന്ധിച്ചിരിക്കുന്ന നാലു ദൂതന്മാരെ അഴിച്ചുവിടുക.” <verse eid="REV 9:14" /><verse number="15" style="v" sid="REV 9:15" />ഉടനെ മനുഷ്യരിൽ മൂന്നിലൊന്നിനെ കൊല്ലുവാനായി, ഒരു മണിക്കൂറിനും ഒരു ദിവസത്തിനും ഒരു മാസത്തിനും ഒരു വർഷത്തിനും ഒരുക്കിയിരുന്ന നാലു ദൂതന്മാരെ അഴിച്ചുവിട്ടു. <verse eid="REV 9:15" /><verse number="16" style="v" sid="REV 9:16" />കുതിരപ്പടയുടെ സംഖ്യ പതിനായിരം മടങ്ങ് ഇരുപതിനായിരം എന്നു ഞാൻ കേട്ടു.<verse eid="REV 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 9:17" />ഞാൻ കുതിരകളെയും കുതിരപ്പുറത്ത് ഇരിക്കുന്നവരെയും എന്‍റെ ദർശനത്തിൽ കണ്ടത് എങ്ങനെ എന്നാൽ: അവരുടെ മാർകവചങ്ങൾ തീകൊണ്ടുള്ളതും, ചുവന്ന സ്ഫടികവും ഗന്ധകവും പോലെ ഉള്ളതും ആയിരുന്നു; കുതിരകളുടെ തല സിംഹങ്ങളുടെ തലപോലെ ആയിരുന്നു; അവയുടെ വായിൽ നിന്നും തീയും പുകയും ഗന്ധകവും പുറപ്പെട്ടു. <verse eid="REV 9:17" /><verse number="18" style="v" sid="REV 9:18" />അവയുടെ വായിൽനിന്നു പുറപ്പെട്ട തീ, പുക, ഗന്ധകം എന്നിവയാൽ മനുഷ്യരിൽ മൂന്നിലൊന്നു കൊല്ലപ്പെട്ടു. <verse eid="REV 9:18" /><verse number="19" style="v" sid="REV 9:19" />കുതിരകളുടെ ശക്തി വായിലും വാലിലും ആയിരുന്നു; അവയുടെ വാലുകൾ സർപ്പങ്ങളെപ്പോലെ ആയിരുന്നു; മനുഷ്യനെ ദണ്ഡിപ്പിക്കുന്നതിന് അവയ്ക്ക് തലകളും ഉണ്ടായിരുന്നു.<verse eid="REV 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20" />ഈ ബാധകളാൽ കൊല്ലപ്പെടാത്ത ബാക്കി മനുഷ്യരോ അവർ ചെയ്തിരുന്ന പ്രവൃത്തി വിട്ടു മാനസാന്തരപ്പെട്ടില്ല, ദുർഭൂതങ്ങളെയും, കാണുവാനും കേൾക്കുവാനും നടക്കുവാനും കഴിയാത്ത പൊന്നു, വെള്ളി, ചെമ്പു, കല്ല്, മരം എന്നിവകൊണ്ടുള്ള ബിംബങ്ങളെയും ആരാധിക്കുന്നതും അവർ നിർത്തിയില്ല. <verse eid="REV 9:20" /><verse number="21" style="v" sid="REV 9:21" />അവരുടെ കൊലപാതകം, മന്ത്രവാദം, ദുർന്നടപ്പ്, മോഷണം എന്നീ പ്രവൃത്തികള്‍ വിട്ടു മാനസാന്തരപ്പെട്ടതുമില്ല.<verse eid="REV 9:21" /></para>
  <chapter eid="REV 9" />
  <chapter number="10" style="c" sid="REV 10" />
  <para style="s">ദൂതനും ചെറിയ പുസ്തകച്ചുരുളും</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1" />അപ്പോൾ മേഘം ധരിച്ചുകൊണ്ട് ബലവാനായ മറ്റൊരു ദൂതൻ സ്വർഗ്ഗത്തിൽനിന്നും ഇറങ്ങി വരുന്നത് ഞാൻ കണ്ടു. അവന്‍റെ തലയ്ക്ക് മീതെ ഒരു മഴവില്ലും ഉണ്ടായിരുന്നു. അവന്‍റെ മുഖം സൂര്യനെപ്പോലെയും അവന്‍റെ പാദങ്ങൾ തീത്തൂണുകൾപോലെയും ആയിരുന്നു. <verse eid="REV 10:1" /><verse number="2" style="v" sid="REV 10:2" />അവൻ കയ്യിൽ തുറന്നിരുന്ന ഒരു ചെറിയ ചുരുൾ പിടിച്ചിരുന്നു. അവൻ വലത്തെ കാൽ സമുദ്രത്തിന്മേലും ഇടത്തെ കാൽ ഭൂമിമേലും വച്ചു. <verse eid="REV 10:2" /><verse number="3" style="v" sid="REV 10:3" />പിന്നെ അവൻ സിംഹത്തിന്‍റെ ഗർജ്ജനം പോലെ അത്യുച്ചത്തിൽ ആർത്തു പറഞ്ഞു; ആർത്തപ്പോൾ ഏഴു ഇടികളും നാദം മുഴക്കി. <verse eid="REV 10:3" /><verse number="4" style="v" sid="REV 10:4" />ഏഴു ഇടികളും നാദം മുഴക്കിയപ്പോൾ, ഞാൻ എഴുതുവാൻ തുനിഞ്ഞു; എന്നാൽ ഏഴു ഇടിമുഴക്കങ്ങൾ പറഞ്ഞത്, ഒന്നും എഴുതാതെ മുദ്രയിട്ട് സൂക്ഷിക്കുന്നു എന്നു പറയുന്ന ഒരു ശബ്ദം സ്വർഗ്ഗത്തിൽനിന്ന് ഞാൻ കേട്ടു.<verse eid="REV 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5" />പിന്നെ സമുദ്രത്തിന്മേലും ഭൂമിമേലും നില്ക്കുന്നവനായി ഞാൻ കണ്ട ദൂതൻ വലത്തെ കൈ ആകാശത്തേക്ക് ഉയർത്തി: <verse eid="REV 10:5" /><verse number="6" style="v" sid="REV 10:6" />‘ഇനി കാലം ഉണ്ടാകയില്ല’ എന്നു എന്നെന്നേക്കും ജീവിച്ചിരിക്കുന്നവനും, ആകാശത്തെയും അതിലുള്ള സർവ്വത്തിനേയും ഭൂമിയേയും അതിലുള്ള സർവ്വത്തിനേയും സമുദ്രത്തേയും അതിലുള്ള സർവ്വത്തിനേയും സൃഷ്ടിച്ചവനെ ചൊല്ലി സത്യം ചെയ്തു. <verse eid="REV 10:6" /><verse number="7" style="v" sid="REV 10:7" />എന്നാൽ ഏഴാം ദൂതന്‍റെ ശബ്ദം ഉണ്ടാകുന്ന കാലത്ത്, അവൻ കാഹളം ഊതുവാൻ തുടങ്ങുമ്പോൾ തന്നെ, ദൈവം തന്‍റെ ദാസരായ പ്രവാചകന്മാരോട് അരുളിച്ചെയ്ത പ്രകാരം ദൈവിക മർമ്മത്തിനു പൂർത്തിയുണ്ടാകും.<verse eid="REV 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8" />ഞാൻ സ്വർഗ്ഗത്തിൽനിന്നു കേട്ട ശബ്ദം പിന്നെയും എന്നോട്: “പോകുക, സമുദ്രത്തിന്മേലും ഭൂമിമേലും നില്ക്കുന്ന ദൂതന്‍റെ കയ്യിലുള്ള തുറന്നിരിക്കുന്ന ചെറിയ ചുരുൾ എടുക്കുക.” എന്നു പറഞ്ഞു.<verse eid="REV 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9" />പിന്നെ ഞാൻ ദൂതന്‍റെ അടുക്കൽ ചെന്നു ചെറിയ ചുരുൾ എനിക്ക് തരിക എന്നു പറഞ്ഞു. അവൻ എന്നോട്: “ചുരുൾ എടുത്തു തിന്നുക; അത് നിന്‍റെ വയറ്റിൽ കയ്പായിരിക്കും എങ്കിലും നിന്‍റെ വായിൽ അത് തേൻപോലെ മധുരിക്കും“ എന്നു പറഞ്ഞു. <verse eid="REV 10:9" /><verse number="10" style="v" sid="REV 10:10" />ഞാൻ ദൂതന്‍റെ കയ്യിൽ നിന്നു ചെറിയ ചുരുൾ എടുത്തു തിന്നു; അത് എന്‍റെ വായിൽ തേൻപോലെ മധുരമായിരുന്നു; എന്നാൽ ഞാൻ അത് തിന്ന ഉടനെ എന്‍റെ വയറു കയ്പായി തീർന്നു.<verse eid="REV 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 10:11" />അപ്പോൾ ആ ദൂതന്‍ <note caller="+" style="f"><char style="fr" closed="false">10:11 </char><char style="ft" closed="false">ആ ദൂതന്‍-അവന്‍ അല്ലെങ്കില്‍ ദൈവം</char></note>എന്നോട്: “നീ ഇനിയും അനേകം വംശങ്ങളുടേയും ജനതകളുടേയും ഭാഷകളുടേയും രാജാക്കന്മാരുടേയും മുമ്പാകെ പ്രവചിക്കേണം“ എന്നു പറഞ്ഞു.<verse eid="REV 10:11" /></para>
  <chapter eid="REV 10" />
  <chapter number="11" style="c" sid="REV 11" />
  <para style="s">രണ്ട് സാക്ഷികൾ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1" />പിന്നെ അളവുകോൽപോലെയുള്ള ഒരു ദണ്ഡ് എനിക്ക് നൽകി. ദൂതൻ നിന്നുകൊണ്ട് എന്നോട് പറഞ്ഞത്: “എഴുന്നേറ്റ് ദൈവത്തിന്‍റെ ആലയത്തെയും യാഗപീഠത്തെയും അതിൽ ആരാധിക്കുന്നവരെയും അളക്കുക. <verse eid="REV 11:1" /><verse number="2" style="v" sid="REV 11:2" />എന്നാൽ ആലയത്തിന് പുറത്തുള്ള പ്രാകാരം വിട്ടേക്കുക, അത് അളക്കരുത്; അത് ജനതകൾക്ക് കൊടുത്തിരിക്കുന്നു; അവർ വിശുദ്ധനഗരത്തെ നാല്പത്തിരണ്ട് മാസം ചവിട്ടി മെതിക്കും. <verse eid="REV 11:2" /><verse number="3" style="v" sid="REV 11:3" />ചണവസ്ത്രം ധരിച്ചുകൊണ്ട് ആയിരത്തിരുനൂറ്ററുപത് ദിവസം പ്രവചിക്കുവാനുള്ള അധികാരം ഞാൻ എന്‍റെ രണ്ടു സാക്ഷികൾക്കു കൊടുക്കും.”<verse eid="REV 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4" />അവർ ഭൂമിയുടെ കർത്താവിന്‍റെ സന്നിധിയിൽ നില്ക്കുന്ന രണ്ടു ഒലിവുവൃക്ഷവും രണ്ടു നിലവിളക്കും ആകുന്നു. <verse eid="REV 11:4" /><verse number="5" style="v" sid="REV 11:5" />ആരെങ്കിലും അവരെ ഉപദ്രവിച്ചാൽ അവരുടെ വായിൽനിന്നു തീ പുറപ്പെടുകയും അവരുടെ ശത്രുക്കളെ ദഹിപ്പിച്ചുകളയുകയും ചെയ്യും; അവരെ ഉപദ്രവിക്കുന്നവൻ ആരായിരുന്നാലും അവൻ ഇങ്ങനെ മരിക്കേണ്ടിവരും. <verse eid="REV 11:5" /><verse number="6" style="v" sid="REV 11:6" />അവർ പ്രവചിക്കുന്ന കാലത്ത് മഴപെയ്യാതെവണ്ണം ആകാശം അടച്ചുകളയുവാൻ അവർക്ക് അധികാരം ഉണ്ട്. അവർ ആഗ്രഹിക്കുമ്പോഴൊക്കെയും വെള്ളത്തെ രക്തമാക്കുവാനും സകലവിധബാധകൊണ്ട് ഭൂമിയെ ദണ്ഡിപ്പിക്കുവാനും അവർക്ക് അധികാരം ഉണ്ട്.<verse eid="REV 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7" />അവർ അവരുടെ സാക്ഷ്യം പൂർത്തീകരിക്കുമ്പോൾ, അഗാധഗർത്തത്തിൽ നിന്നും കയറി വരുന്ന മൃഗം അവർക്കെതിരെ യുദ്ധം ചെയ്യുകയും അവരെ ജയിക്കുകയും കൊല്ലുകയും ചെയ്യും. <verse eid="REV 11:7" /><verse number="8" style="v" sid="REV 11:8" />അവരുടെ ശവശരീരങ്ങൾ നമ്മുടെ കർത്താവ് ക്രൂശിക്കപ്പെട്ടതും പ്രതീകാത്മകമായി സൊദോം എന്നും മിസ്രയീം എന്നും വിളിക്കപ്പടുന്നതുമായ മഹാനഗരത്തിൻ്റെ തെരുവിൽ കിടക്കും. <verse eid="REV 11:8" /><verse number="9" style="v" sid="REV 11:9" />മൂന്നരദിവസത്തേക്ക് എല്ലാ വംശങ്ങളിലും ഗോത്രങ്ങളിലും ഭാഷകളിലും ജനതകളിലും ഉള്ളവർ അവരുടെ മൃതശരീരങ്ങൾ കാണുകയും അവരുടെ ശവങ്ങൾ കല്ലറയിൽ അടക്കം ചെയ്യുവാൻ അനുവദിക്കാതിരിക്കുകയും ചെയ്യും. <verse eid="REV 11:9" /><verse number="10" style="v" sid="REV 11:10" />ഈ പ്രവാചകന്മാർ ഇരുവരും ഭൂമിയിൽ ജീവിച്ചിരുന്നവരെ ദണ്ഡിപ്പിച്ചതുകൊണ്ട് ഭൂവാസികൾ അവർ നിമിത്തം സന്തോഷിക്കുകയും ആനന്ദഘോഷം നടത്തുകയും അന്യോന്യം സമ്മാനങ്ങൾ കൊടുത്തയയ്ക്കുകയും ചെയ്യും.<verse eid="REV 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 11:11" />എന്നാൽ മൂന്നര ദിവസത്തിനുശേഷം ദൈവത്തിൽനിന്നുള്ള ജീവന്‍റെ ആത്മാവ് അവരിൽ പ്രവേശിച്ച് അവർ കാൽ ഊന്നിനിന്നു. അവരെ കണ്ടവർക്കെല്ലാം വലിയ ഭയം ഉണ്ടായി. <verse eid="REV 11:11" /><verse number="12" style="v" sid="REV 11:12" />അപ്പോൾ “ഇവിടെ കയറിവരുവിൻ!” എന്നു സ്വർഗ്ഗത്തിൽനിന്ന് ഒരു മഹാശബ്ദം അവരോട് പറയുന്നത് അവർ കേട്ടു. അവരുടെ ശത്രുക്കൾ അവരെ നോക്കിക്കൊണ്ടിരിക്കുമ്പോൾ തന്നെ അവർ മേഘത്തിൽ സ്വർഗ്ഗത്തിലേക്ക് കയറി.<verse eid="REV 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 11:13" />ആ നാഴികയിൽ തന്നെ അവിടെ വലിയൊരു ഭൂകമ്പം ഉണ്ടായി; നഗരത്തിൽ പത്തിലൊന്ന് ഭാഗം തകർന്നുപോയി; ഭൂകമ്പത്തിൽ ഏഴായിരം പേർ കൊല്ലപ്പെട്ടു; ശേഷമുള്ളവർ ഭയപരവശരാവുകയും സ്വർഗ്ഗത്തിലെ ദൈവത്തിന് മഹത്വം കൊടുക്കുകയും ചെയ്തു.<verse eid="REV 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14" />രണ്ടാമത്തെ കഷ്ടം കഴിഞ്ഞു; ജാഗ്രതയായിരിക്ക! മൂന്നാമത്തെ കഷ്ടം വേഗം വരുന്നു.<verse eid="REV 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15" />പിന്നെ ഏഴാമത്തെ ദൂതൻ കാഹളം ഊതി: “ലോകരാജ്യങ്ങൾ നമ്മുടെ കർത്താവിൻ്റെയും അവന്‍റെ ക്രിസ്തുവിൻ്റെയും രാജ്യങ്ങൾ ആയിത്തീർന്നിരിക്കുന്നു; അവൻ എന്നെന്നേക്കും വാഴും” എന്നു സ്വർഗ്ഗത്തിൽ മഹാഘോഷം ഉണ്ടായി. <verse eid="REV 11:15" /><verse number="16" style="v" sid="REV 11:16" />അപ്പോൾ ദൈവമുമ്പാകെ സിംഹാസനങ്ങളിൽ ഇരിക്കുന്ന ഇരുപത്തിനാല് മൂപ്പന്മാരും കവിണ്ണുവീണു ദൈവത്തെ നമസ്കരിച്ചുകൊണ്ട് പറഞ്ഞത്:<verse eid="REV 11:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="REV 11:17" />“ഇരിക്കുന്നവനും ഇരുന്നവനും വരുന്നവനുമായ</para>
  <para style="q2" vid="REV 11:17">സർവ്വശക്തനായ ദൈവമേ,</para>
  <para style="q1" vid="REV 11:17">അങ്ങ് അങ്ങേയുടെ മഹാശക്തിയോടെ വാഴ്ച ആരംഭിച്ചതിനാൽ</para>
  <para style="q2" vid="REV 11:17">ഞങ്ങൾ അങ്ങേയ്ക്കു നന്ദി കരേറ്റുന്നു.<verse eid="REV 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18" />ജനതകൾ കോപിച്ചു: എന്നാൽ അങ്ങയുടെ ക്രോധം വന്നിരിക്കുന്നു:</para>
  <para style="q2" vid="REV 11:18">മരിച്ചവരെ ന്യായം വിധിപ്പാനും</para>
  <para style="q1" vid="REV 11:18">അങ്ങയുടെ ദാസന്മാരായ പ്രവാചകന്മാർക്കും വിശുദ്ധന്മാർക്കും</para>
  <para style="q2" vid="REV 11:18">അങ്ങയെ ഭയപ്പെടുന്ന ചെറിയവരും വലിയവരുമായ എല്ലാവർക്കും</para>
  <para style="q1" vid="REV 11:18">പ്രതിഫലം കൊടുക്കുവാനുള്ള സമയവും</para>
  <para style="q2" vid="REV 11:18">ഭൂമിയെ നശിപ്പിക്കുന്നവരെ നശിപ്പിക്കുവാൻ ഉള്ള അങ്ങയുടെ സമയവും വന്നിരിക്കുന്നു.“<verse eid="REV 11:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19" />അപ്പോൾ സ്വർഗ്ഗത്തിലെ ദൈവാലയം തുറന്നു, അവന്‍റെ നിയമപ്പെട്ടകം അവന്‍റെ ആലയത്തിൽ കാണപ്പെടുകയും ചെയ്തു; അവിടെ മിന്നലുകളും ശബ്ദകോലാഹലങ്ങളും ഇടിമുഴക്കങ്ങളും ഭൂകമ്പവും വലിയ കല്മഴയും ഉണ്ടായി.<verse eid="REV 11:19" /></para>
  <chapter eid="REV 11" />
  <chapter number="12" style="c" sid="REV 12" />
  <para style="s">സ്ത്രീയും മഹാസർപ്പവും</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1" />സ്വർഗ്ഗത്തിൽ വലിയൊരു അടയാളം കാണ്മാനായി: സൂര്യനെ അണിഞ്ഞൊരു സ്ത്രീ; അവളുടെ കാൽക്കീഴിൽ ചന്ദ്രനും അവളുടെ തലയിൽ പന്ത്രണ്ടു നക്ഷത്രംകൊണ്ടുള്ളൊരു കിരീടവും ഉണ്ടായിരുന്നു. <verse eid="REV 12:1" /><verse number="2" style="v" sid="REV 12:2" />അവൾ ഗർഭിണിയായി പ്രസവവേദനയാൽ നോവുകിട്ടി നിലവിളിച്ചു.<verse eid="REV 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 12:3" />സ്വർഗ്ഗത്തിൽ മറ്റൊരു അടയാളം കൂടി കാണപ്പെട്ടു: ഏഴു തലയും പത്തു കൊമ്പും തലയിൽ ഏഴു കിരീടവും ഉള്ളതായി വലിയ ഒരു ചുവന്ന മഹാസർപ്പം. <verse eid="REV 12:3" /><verse number="4" style="v" sid="REV 12:4" />അതിന്‍റെ വാൽ ആകാശത്തിലെ നക്ഷത്രങ്ങളിൽ മൂന്നിലൊന്നിനെ വലിച്ചുകൂട്ടി ഭൂമിയിലേക്കു എറിഞ്ഞുകളഞ്ഞു. പ്രസവിപ്പാറായ സ്ത്രീ പ്രസവിക്കുമ്പോൾ അവളുടെ ശിശുവിനെ വിഴുങ്ങിക്കളവാൻ മഹാസർപ്പം അവളുടെ മുമ്പിൽ നിന്നു. <verse eid="REV 12:4" /><verse number="5" style="v" sid="REV 12:5" />അവൾ സകലജനതകളെയും ഇരുമ്പുകോൽകൊണ്ടു ഭരിക്കുവാനുള്ളോരു ആൺകുട്ടിയെ പ്രസവിച്ചു; അവളുടെ ശിശു ദൈവത്തിന്‍റെ അടുക്കലേക്കും അവന്‍റെ സിംഹാസനത്തിലേക്കും പെട്ടെന്ന് എടുക്കപ്പെട്ടു. <verse eid="REV 12:5" /><verse number="6" style="v" sid="REV 12:6" />ആയിരത്തിരുനൂറ്ററുപത് ദിവസം അവളെ പോറ്റുന്നതിനായി മരുഭൂമിയിൽ അവൾക്കായി ദൈവം ഒരുക്കിയിരുന്നൊരു സ്ഥലത്തേക്ക് സ്ത്രീ ഓടിപ്പോകയും ചെയ്തു.<verse eid="REV 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7" />പിന്നെ സ്വർഗ്ഗത്തിൽ യുദ്ധം ഉണ്ടായി; മീഖായേലും<note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="ft" closed="false">മീഖായേല്‍-ദൈവത്തിന്‍റെ പ്രധാന ദൂതന്‍</char></note> അവന്‍റെ ദൂതന്മാരും മഹാസർപ്പത്തിനെതിരെ പോരാടി; തന്‍റെ ദൂതന്മാരുമായി മഹാസർപ്പവും തിരിച്ച് പോരാടിയെങ്കിലും ജയിക്കുവാൻ കഴിഞ്ഞില്ല; <verse eid="REV 12:7" /><verse number="8" style="v" sid="REV 12:8" />സ്വർഗ്ഗത്തിൽ അവരുടെ സ്ഥലം പിന്നെ കണ്ടതുമില്ല. <verse eid="REV 12:8" /><verse number="9" style="v" sid="REV 12:9" />ലോകത്തെ മുഴുവനും ചതിക്കുന്ന സാത്താൻ എന്നും പിശാച് എന്നും വിളിക്കുന്ന പഴയ പാമ്പായ മഹാസർപ്പത്തെ ഭൂമിയിലേക്കു തള്ളിക്കളഞ്ഞു; അവനെയും അവന്‍റെ ദൂതന്മാരെയും ഭൂമിയിലേക്ക് തള്ളിക്കളഞ്ഞു.<verse eid="REV 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10" />അപ്പോൾ ഞാൻ സ്വർഗ്ഗത്തിൽ ഒരു മഹാശബ്ദം കേട്ടത്:</para>
  <para style="b" vid="REV 12:10" />
  <para style="q1" vid="REV 12:10">”ഇപ്പോൾ നമ്മുടെ ദൈവത്തിന്‍റെ രക്ഷയും ശക്തിയും രാജ്യവും</para>
  <para style="q2" vid="REV 12:10">അവന്‍റെ ക്രിസ്തുവിന്‍റെ അധികാരവും വന്നിരിക്കുന്നു;</para>
  <para style="q1" vid="REV 12:10">നമ്മുടെ സഹോദരന്മാരെ രാവും പകലും ദൈവത്തിന്‍റെ സന്നിധിയിൽ</para>
  <para style="q2" vid="REV 12:10">കുറ്റം ചുമത്തുന്ന അപവാദിയെ താഴേക്ക് തള്ളിയിട്ടു കളഞ്ഞുവല്ലോ.<verse eid="REV 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 12:11" />അവർ അവനെ കുഞ്ഞാടിൻ്റെ രക്തത്താലും അവരുടെ സാക്ഷ്യവചനത്താലും ജയിച്ചു;</para>
  <para style="q2" vid="REV 12:11">മരണത്തോളം അവരുടെ ജീവനെ അവർ സ്നേഹിച്ചതുമില്ല.<verse eid="REV 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="REV 12:12" />ആകയാൽ സ്വർഗ്ഗവും അതിൽ വസിക്കുന്നവരും ആയുള്ളോരേ, ആനന്ദിപ്പിൻ;</para>
  <para style="q2" vid="REV 12:12">എന്നാൽ, അല്പസമയം മാത്രമേ തനിക്കുള്ളൂ എന്നറിഞ്ഞ്</para>
  <para style="q1" vid="REV 12:12">പിശാച് മഹാകോപത്തോടെ നിങ്ങളുടെ അടുക്കലേക്ക് വന്നിരിക്കുന്നതുകൊണ്ട്</para>
  <para style="q2" vid="REV 12:12">ഭൂമിയിലും സമുദ്രത്തിലും വസിക്കുന്നവരേ, നിങ്ങൾക്ക് അയ്യോ കഷ്ടം.”<verse eid="REV 12:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13" />തന്നെ ഭൂമിയിലേക്കു എറിഞ്ഞുകളഞ്ഞു എന്നു സർപ്പം മനസ്സിലാക്കിയപ്പോൾ, അവൻ ആൺകുട്ടിയെ പ്രസവിച്ച സ്ത്രീയെ പിന്തുടർന്ന് ദ്രോഹിച്ചു. <verse eid="REV 12:13" /><verse number="14" style="v" sid="REV 12:14" />അപ്പോൾ സ്ത്രീക്ക് മരുഭൂമിയിൽ തന്‍റെ സ്ഥലത്തേക്കു പറന്നു പോകേണ്ടതിനു വലിയ കഴുകന്‍റെ രണ്ടു ചിറകു ലഭിച്ചു; അവിടെ അവളെ മഹാസർപ്പത്തിൻ്റെ പിടിയിൽപ്പെടാതെ ഒരുകാലവും കാലങ്ങളും അരക്കാലവും പോറ്റി രക്ഷിച്ചു.<verse eid="REV 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 12:15" />സർപ്പം സ്ത്രീയെ വെള്ളപ്പൊക്കത്താൽ ഒഴുക്കിക്കളയേണ്ടതിന് തന്‍റെ വായിൽനിന്നു നദിപോലെ വെള്ളം പുറപ്പെടുവിച്ചു. <verse eid="REV 12:15" /><verse number="16" style="v" sid="REV 12:16" />എന്നാൽ ഭൂമി സ്ത്രീയെ സഹായിച്ചു; മഹാസർപ്പം തന്‍റെ വായിൽനിന്നു പുറപ്പെടുവിച്ച നദിയെ ഭൂമി വായ് തുറന്ന് വിഴുങ്ങിക്കളഞ്ഞു. <verse eid="REV 12:16" /><verse number="17" style="v" sid="REV 12:17" />അപ്പോൾ മഹാസർപ്പം സ്ത്രീയോട് കോപിക്കുകയും ദൈവകല്പന അനുസരിക്കുന്നവരും യേശുക്രിസ്തുവിന്‍റെ സാക്ഷ്യം ഉള്ളവരുമായ അവളുടെ സന്തതിയിൽ ശേഷിപ്പുള്ളവരോട് യുദ്ധം ചെയ്യുവാൻ പുറപ്പെടുകയും ചെയ്തു. <verse eid="REV 12:17" /><verse number="18" style="v" sid="REV 12:18" />പിന്നെ മഹാസർപ്പം കടൽപ്പുറത്തെ മണലിന്മേൽ നിന്നു.<verse eid="REV 12:18" /></para>
  <chapter eid="REV 12" />
  <chapter number="13" style="c" sid="REV 13" />
  <para style="s">സമുദ്രത്തിൽനിന്ന് കയറിവന്ന മൃഗം</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1" />അപ്പോൾ പത്തു കൊമ്പുകളും ഏഴു തലകളും കൊമ്പുകളിൽ പത്തു കിരീടങ്ങളും തലയിൽ ദൈവത്തെ നിന്ദിക്കുന്ന പേരുകളും ഉള്ളൊരു മൃഗം സമുദ്രത്തിൽനിന്നു കയറി വരുന്നത് ഞാൻ കണ്ടു. <verse eid="REV 13:1" /><verse number="2" style="v" sid="REV 13:2" />ഞാൻ കണ്ട മൃഗം പുള്ളിപ്പുലിയെപ്പോലെയും അതിന്‍റെ കാലുകൾ കരടിയുടെ കാലുകൾ പോലെയും വായ് സിംഹത്തിന്‍റെ വായ്പോലെയും ആയിരുന്നു. അതിന് മഹാസർപ്പം തന്‍റെ ശക്തിയും സിംഹാസനവും വലിയ അധികാരവും കൊടുത്തു.<verse eid="REV 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 13:3" />മൃഗത്തിന്‍റെ തലകളിൽ ഒന്നിൽ മരണകരമായ ഒരു മുറിവുള്ളതായി കാണപ്പെട്ടു; എന്നാൽ മരണകരമായ ആ മുറിവ് സൗഖ്യമായി; സർവ്വഭൂമിയും മൃഗത്തെ കണ്ടു അതിശയിച്ചു. <verse eid="REV 13:3" /><verse number="4" style="v" sid="REV 13:4" />മൃഗത്തിന് തന്‍റെ അധികാരം കൊടുത്ത മഹാസർപ്പത്തെ അവർ ആരാധിച്ചു: മൃഗത്തോടു തുല്യൻ ആർ? അതിന് എതിരെ പൊരുതുവാൻ ആർക്ക് കഴിയും? എന്നു പറഞ്ഞുകൊണ്ട് അവർ മൃഗത്തെയും ആരാധിച്ചു.<verse eid="REV 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5" />അഹങ്കാരവും ദൈവനിന്ദയും പറയുന്നതിനുള്ള ഒരു വായ് അതിന് ലഭിച്ചു; നാല്പത്തിരണ്ട് മാസം പ്രവർത്തിപ്പാൻ അതിന് അധികാരം ലഭിച്ചു. <verse eid="REV 13:5" /><verse number="6" style="v" sid="REV 13:6" />ദൈവത്തേയും അവന്‍റെ നാമത്തേയും അവന്‍റെ കൂടാരത്തേയും സ്വർഗ്ഗത്തിൽ വസിക്കുന്നവരെയും നിന്ദിപ്പാൻ വായ് തുറന്നു. <verse eid="REV 13:6" /><verse number="7" style="v" sid="REV 13:7" />വിശുദ്ധന്മാരോട് യുദ്ധം ചെയ്യുവാനും അവരെ ജയിക്കുവാനും അതിന് അധികാരം ലഭിച്ചു. സകല വംശത്തിന്മേലും ഭാഷമേലും ജനതമേലും കർത്തൃത്വം നടത്തുവാൻ അവനു അധികാരം ഉണ്ടായിരുന്നു. <verse eid="REV 13:7" /><verse number="8" style="v" sid="REV 13:8" />ലോകസ്ഥാപനം മുതൽ അറുക്കപ്പെട്ടതായ കുഞ്ഞാടിൻ്റെ ജീവപുസ്തകത്തിൽ പേർ എഴുതപ്പെട്ടിട്ടില്ലാത്തവരായ ഭൂവാസികൾ എല്ലാവരും അതിനെ ആരാധിക്കും.<verse eid="REV 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9" />കേൾക്കുവാൻ ചെവിയുള്ളവൻ കേൾക്കട്ടെ.<verse eid="REV 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 13:10" />അടിമത്തത്തിലേക്ക് നയിക്കുന്നവർ</para>
  <para style="q2" vid="REV 13:10">അടിമത്തത്തിലായിപ്പോകും;</para>
  <para style="q1" vid="REV 13:10">ആരെങ്കിലും വാൾകൊണ്ടു കൊല്ലുന്നവൻ</para>
  <para style="q2" vid="REV 13:10">വാളാൽ കൊല്ലപ്പെടേണ്ടിവരും;</para>
  <para style="m" vid="REV 13:10">വിശുദ്ധന്മാരുടെ സഹിഷ്ണുതയും വിശ്വാസവും ഇവിടെ ആവശ്യം.<verse eid="REV 13:10" /></para>
  <para style="s">ഭൂമിയിൽ നിന്നുള്ള മൃഗം</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11" />പിന്നെ മറ്റൊരു മൃഗം ഭൂമിയിൽനിന്നു കയറി വരുന്നത് ഞാൻ കണ്ടു; അതിന് കുഞ്ഞാടിനുള്ളതുപോലെ രണ്ടു കൊമ്പുണ്ടായിരുന്നു; അത് മഹാസർപ്പം എന്നപോലെ സംസാരിച്ചു. <verse eid="REV 13:11" /><verse number="12" style="v" sid="REV 13:12" />അതിന് മുമ്പുണ്ടായിരുന്ന ഒന്നാമത്തെ മൃഗത്തിന്‍റെ അധികാരം എല്ലാം അത് ഏറ്റെടുക്കുകയും ഭൂമിയെയും അതിൽ വസിക്കുന്നവരെയും മരണകരമായ മുറിവ് സൗഖ്യമായ ഒന്നാം മൃഗത്തെ ആരാധിപ്പാൻ ഇടയാക്കുകയും ചെയ്യുന്നു. <verse eid="REV 13:12" /><verse number="13" style="v" sid="REV 13:13" />അത് ജനങ്ങളുടെ മുമ്പിൽ ആകാശത്തുനിന്നു ഭൂമിയിലേക്കു തീ ഇറക്കുന്നതുപോലെയുള്ള അത്ഭുതങ്ങൾ പ്രവർത്തിക്കയും <verse eid="REV 13:13" /><verse number="14" style="v" sid="REV 13:14" />ആദ്യമൃഗത്തിൻ്റെ ദൃഷ്ടിയിൽ ചെയ്യുവാൻ തനിക്കു ലഭിച്ച അധികാരം കൊണ്ടു അത്ഭുതങ്ങൾ പ്രവർത്തിച്ച് ഭൂമിയിൽ ജീവിക്കുന്നവരെ വഞ്ചിക്കുകയും വാളാൽ മുറിവേറ്റിട്ടും ജീവിച്ചിരിക്കുന്ന മൃഗത്തിന്‍റെ പ്രതിമ ഉണ്ടാക്കുവാൻ ഭൂമിയിൽ ജീവിക്കുന്നവരോട് പറയുകയും ചെയ്യുന്നു. <verse eid="REV 13:14" /><verse number="15" style="v" sid="REV 13:15" />മൃഗത്തിന്‍റെ പ്രതിമയ്ക്ക് ജീവൻ നൽകുവാനും, പ്രതിമ സംസാരിക്കേണ്ടതിനും മൃഗത്തിന്‍റെ പ്രതിമയെ ആരാധിക്കാത്തവരെ എല്ലാം കൊല്ലേണ്ടതിനും അതിന് അധികാരം ഉണ്ടായിരുന്നു. <verse eid="REV 13:15" /><verse number="16" style="v" sid="REV 13:16" />അത് ചെറിയവരും വലിയവരും സമ്പന്നന്മാരും സാധുക്കളും സ്വതന്ത്രന്മാരും അടിമകളുമായ എല്ലാവരെയും വലങ്കൈമേലോ നെറ്റിയിലോ ഒരു മുദ്ര സ്വീകരിക്കുവാനും; <verse eid="REV 13:16" /><verse number="17" style="v" sid="REV 13:17" />മുദ്രയോ, മൃഗത്തിന്‍റെ പേരോ, പേരിന്‍റെ സംഖ്യയോ ഇല്ലാത്ത ആർക്കും തന്നെ വാങ്ങുവാനോ വില്ക്കുവാനോ അനുവദിക്കാതിരിക്കുകയും ചെയ്യുന്നു.<verse eid="REV 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18" />ഇവിടെ ജ്ഞാനംകൊണ്ട് ആവശ്യം. ബുദ്ധിയുള്ളവൻ മൃഗത്തിന്‍റെ സംഖ്യ കണക്കുകൂട്ടട്ടെ: അത് ഒരു മനുഷ്യന്‍റെ സംഖ്യയത്രേ. അവന്‍റെ സംഖ്യ അറുനൂറ്റിഅറുപത്തിയാറ് (666).<verse eid="REV 13:18" /></para>
  <chapter eid="REV 13" />
  <chapter number="14" style="c" sid="REV 14" />
  <para style="s">കുഞ്ഞാടും 1,44,000 പേരും</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1" />പിന്നെ ഞാൻ നോക്കിയപ്പോൾ സീയോൻമലയിൽ കുഞ്ഞാട് നില്ക്കുന്നതു കണ്ടു. അവന്‍റെ നാമവും അവന്‍റെ പിതാവിന്‍റെ നാമവും നെറ്റിയിൽ എഴുതിയിരിക്കുന്നവരായ നൂറ്റിനാല്പത്തിനാലായിരം (1,44,000) പേർ അവനോടുകൂടെ ഉണ്ടായിരുന്നു. <verse eid="REV 14:1" /><verse number="2" style="v" sid="REV 14:2" />പെരുവെള്ളത്തിന്‍റെ ഇരച്ചിൽപോലെയും വലിയൊരു ഇടിമുഴക്കംപോലെയും സ്വർഗ്ഗത്തിൽനിന്ന് ഒരു ഘോഷം ഞാൻ കേട്ടു; ഞാൻ കേട്ട ഘോഷം വീണ വായനക്കാർ അവരുടെ വീണകൾ മീട്ടുന്നതുപോലെയും ആയിരുന്നു. <verse eid="REV 14:2" /><verse number="3" style="v" sid="REV 14:3" />അവർ സിംഹാസനത്തിനും നാലു ജീവികൾക്കും മൂപ്പന്മാർക്കും മുമ്പാകെ ഒരു പുതിയ പാട്ടുപാടി; ഭൂമിയിൽനിന്നു വീണ്ടെടുക്കപ്പെട്ടവരായ നൂറ്റിനാല്പത്തിനാലായിരം (1,44,000) പേർക്കല്ലാതെ ആർക്കും ആ പാട്ടു പഠിപ്പാൻ കഴിഞ്ഞില്ല. <verse eid="REV 14:3" /><verse number="4" style="v" sid="REV 14:4" />അവർ സ്ത്രീകളാൽ മാലിന്യപ്പെടാത്തവർ; ശുദ്ധിയുള്ളവരായി<note caller="+" style="f"><char style="fr" closed="false">14:4 </char><char style="ft" closed="false">ശുദ്ധിയുള്ളവര്‍-വിഗ്രഹത്തെ ആരാധിക്കാത്തവര്‍</char></note> സൂക്ഷിച്ചവർ തന്നെ. കുഞ്ഞാട് പോകുന്നേടത്തൊക്കെയും അവർ അവനെ അനുഗമിക്കുന്നു; ഇവർ ദൈവത്തിനും കുഞ്ഞാടിനും ആദ്യഫലമായി മനുഷ്യരുടെ ഇടയിൽ നിന്ന് വീണ്ടെടുക്കപ്പെട്ടവർ ആയിരുന്നു. <verse eid="REV 14:4" /><verse number="5" style="v" sid="REV 14:5" />കള്ളം അവരുടെ വായിൽ ഉണ്ടായിരുന്നില്ല; ദൈവസിംഹാസനത്തിന്മുമ്പിൽ അവർ കുറ്റമില്ലാത്തവർ തന്നെ.<verse eid="REV 14:5" /></para>
  <para style="s">മൂന്നു ദൂതന്മാർ</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6" />വേറൊരു ദൂതൻ ആകാശമധ്യേ പറക്കുന്നത് ഞാൻ കണ്ടു; ഭൂമിയിൽ വസിക്കുന്ന സകലജനതയും ഗോത്രവും ഭാഷയും വംശവും ആയവരോട് അറിയിക്കുവാൻ അവന്‍റെ പക്കൽ നിത്യസുവിശേഷം ഉണ്ടായിരുന്നു. <verse eid="REV 14:6" /><verse number="7" style="v" sid="REV 14:7" />ദൈവത്തെ ഭയപ്പെട്ടു അവനു മഹത്വം കൊടുക്കുവിൻ; അവന്‍റെ ന്യായവിധിയുടെ നാഴിക വന്നിരിക്കുന്നു. ആകാശവും ഭൂമിയും സമുദ്രവും നീരുറവകളും ഉണ്ടാക്കിയവനെ ആരാധിപ്പിൻ എന്നു അവൻ അത്യുച്ചത്തിൽ പറഞ്ഞുകൊണ്ടിരുന്നു.<verse eid="REV 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8" />വേറൊരു ദൂതൻ പിൻചെന്നു: വീണുപോയി! തന്‍റെ ദുർന്നടപ്പിൻ്റെ ക്രോധമദ്യം സകലജനതകളെയും കുടിപ്പിച്ചതുകൊണ്ട് മഹാനഗരമായ ബാബേല്‍ വീണുപോയി എന്നു പറഞ്ഞുകൊണ്ടിരുന്നു.<verse eid="REV 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9" />മൂന്നാമതു വേറൊരു ദൂതൻ അവരുടെ പിന്നാലെ ചെന്നു അത്യുച്ചത്തിൽ പറഞ്ഞത്: മൃഗത്തെയോ അതിന്‍റെ പ്രതിമയേയോ ആരാധിക്കുകയും തന്‍റെ നെറ്റിയിലോ കൈമേലോ അവന്‍റെ മുദ്ര സ്വീകരിക്കുകയും ചെയ്യുന്നവൻ ആരായിരുന്നാലും <verse eid="REV 14:9" /><verse number="10" style="v" sid="REV 14:10" />അവൻ ദൈവകോപത്തിന്‍റെ പാനപാത്രത്തിൽ കലർപ്പില്ലാതെ പകർന്നിരിക്കുന്ന ദൈവത്തിന്‍റെ ക്രോധമദ്യം കുടിക്കേണ്ടിവരും; അവൻ വിശുദ്ധദൂതന്മാരുടേയും കുഞ്ഞാടിൻ്റെയും മുമ്പാകെ തീയിലും ഗന്ധകത്തിലും ദണ്ഡിപ്പിക്കപ്പെടുകയും ചെയ്യും. <verse eid="REV 14:10" /><verse number="11" style="v" sid="REV 14:11" />അവരുടെ ദണ്ഡനത്തിൻ്റെ പുക എന്നെന്നേക്കും പൊങ്ങിക്കൊണ്ടിരിക്കും; മൃഗത്തെയും അതിന്‍റെ പ്രതിമയേയും ആരാധിക്കുന്നവർക്കും അതിന്‍റെ പേരിന്‍റെ മുദ്ര സ്വീകരിക്കുന്ന ഏവർക്കും രാവും പകലും ഒരു സ്വസ്ഥതയും ഉണ്ടാകയില്ല. <verse eid="REV 14:11" /><verse number="12" style="v" sid="REV 14:12" />ദൈവകല്പന അനുസരിക്കുന്നവരും യേശുവിങ്കലുള്ള വിശ്വാസവും കാത്തുകൊള്ളുന്നവരുമായ വിശുദ്ധന്മാരുടെ സഹിഷ്ണുതകൊണ്ട് ഇവിടെ ആവശ്യം.<verse eid="REV 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13" />സ്വർഗ്ഗത്തിൽനിന്ന് ഒരു ശബ്ദം എന്നോട് പറയുന്നത് ഞാൻ കേട്ടു; “ഇതു എഴുതുക: ഇന്നുമുതൽ കർത്താവിൽ മരിക്കുന്ന മൃതന്മാർ ഭാഗ്യവാന്മാർ; അതെ, അവരുടെ അദ്ധ്വാനങ്ങളിൽ നിന്നു അവർ വിശ്രമിക്കേണ്ടതാകുന്നു; അവരുടെ പ്രവൃത്തികൾ അവരെ പിന്തുടരും എന്നു ആത്മാവ് പറയുന്നു.”<verse eid="REV 14:13" /></para>
  <para style="s">ഭൂമിയിലെ കൊയ്ത്ത്</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14" />പിന്നെ ഞാൻ നോക്കിയപ്പോൾ, ഇതാ ഒരു വെളുത്ത മേഘം, മേഘത്തിന്മേൽ മനുഷ്യപുത്രനെപ്പോലെ ഒരുവൻ ഇരിക്കുന്നതും ഞാൻ കണ്ടു. അവന്‍റെ തലയിൽ ഒരു സ്വർണ്ണകിരീടവും കയ്യിൽ മൂർച്ചയുള്ളൊരു അരിവാളും ഉണ്ടായിരുന്നു. <verse eid="REV 14:14" /><verse number="15" style="v" sid="REV 14:15" />പിന്നെ മറ്റൊരു ദൂതൻ ദൈവാലത്തിൽ നിന്നു പുറത്തു വന്നു, മേഘത്തിന്മേൽ ഇരിക്കുന്നവനോട്: “നിന്‍റെ അരിവാൾ എടുത്തു കൊയ്യുവാൻ തുടങ്ങുക; ഭൂമിയിലെ വിളവ് വിളഞ്ഞിരിക്കുന്നതിനാൽ കൊയ്ത്തിന് സമയം ആയിരിക്കുന്നു“ എന്നു ഉറക്കെ വിളിച്ചു പറഞ്ഞു. <verse eid="REV 14:15" /><verse number="16" style="v" sid="REV 14:16" />അപ്പോൾ മേഘത്തിന്മേൽ ഇരിക്കുന്നവൻ അവന്‍റെ അരിവാൾ ഭൂമിയിലേക്ക് എറിഞ്ഞു, ഭൂമിയിലെ കൊയ്ത്ത് നടക്കുകയും ചെയ്തു.<verse eid="REV 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17" />മറ്റൊരു ദൂതൻ സ്വർഗ്ഗത്തിലെ ആലയത്തിൽനിന്ന് പുറത്തു വന്നു; മൂർച്ചയുള്ളൊരു അരിവാൾ അവനും ഉണ്ടായിരുന്നു. <verse eid="REV 14:17" /><verse number="18" style="v" sid="REV 14:18" />പിന്നീട് തീയുടെമേൽ അധികാരമുള്ള വേറൊരു ദൂതൻ യാഗപീഠത്തിങ്കൽ നിന്നു പുറത്തു വന്നു, അവൻ മൂർച്ചയുള്ള അരിവാൾ പിടിച്ചിരുന്നവനോട്: “മുന്തിരിങ്ങ നന്നായി പഴുത്തിരിക്കയാൽ നിന്‍റെ മൂർച്ചയുള്ള അരിവാൾ എടുത്തു ഭൂമിയിലെ മുന്തിരിക്കുലകളെ അറുത്തെടുക്കുക“ എന്ന് ഉറക്കെ വിളിച്ചു പറഞ്ഞു. <verse eid="REV 14:18" /><verse number="19" style="v" sid="REV 14:19" />ദൂതൻ തന്‍റെ അരിവാൾ ഭൂമിയിലേക്കു എറിഞ്ഞു, ഭൂമിയിലെ മുന്തിരിക്കുലകൾ ശേഖരിച്ച്, ദൈവകോപത്തിന്‍റെ വലിയ മുന്തിരിച്ചക്കിൽ ഇട്ടു. <verse eid="REV 14:19" /><verse number="20" style="v" sid="REV 14:20" />മുന്തിരിച്ചക്ക് നഗരത്തിന് പുറത്തുവച്ച് ചവിട്ടി; ചക്കിൽനിന്ന് രക്തം കുതിരയുടെ കടിഞ്ഞാണോളം ഉയരത്തില്‍ മുന്നൂറ് കിലോമീറ്ററോളം ദൂരത്തോളം ഒഴുകി.<verse eid="REV 14:20" /></para>
  <chapter eid="REV 14" />
  <chapter number="15" style="c" sid="REV 15" />
  <para style="s">ഏഴു ബാധകൾ വഹിക്കുന്ന ഏഴു ദൂതന്മാർ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1" />പിന്നെ വലുതും അത്ഭുതകരവുമായ മറ്റൊരു അടയാളം ഞാൻ സ്വർഗ്ഗത്തിൽ കണ്ടു; അവിടെ അവസാനത്തെ ഏഴു ബാധയുമുള്ള ഏഴു ദൂതന്മാരെ തന്നെ. ദൈവക്രോധം ഇവരിൽ പൂർത്തിയായി.<verse eid="REV 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 15:2" />തീ കലർന്ന പളുങ്കുകടൽ പോലെയൊന്നും അതിനരികെ മൃഗത്തെയും അതിന്‍റെ പ്രതിമയേയും മൃഗത്തിന്‍റെ പേരിന്‍റെ സംഖ്യയേയും ജയിച്ചവർ, ദൈവം നല്കിയ വീണകൾ പിടിച്ചുംകൊണ്ടു നില്ക്കുന്നതും ഞാൻ കണ്ടു. <verse eid="REV 15:2" /><verse number="3" style="v" sid="REV 15:3" />അവർ ദൈവത്തിന്‍റെ ദാസനായ മോശെയുടെ പാട്ടും കുഞ്ഞാടിൻ്റെ പാട്ടും പാടിക്കൊണ്ടിരുന്നു: സകലത്തെയും ഭരിക്കുന്നവനായ ദൈവമായ കർത്താവേ, നിന്‍റെ പ്രവൃത്തികൾ വലുതും അത്ഭുതങ്ങളുമായവ; സർവ്വശക്തനായ കർത്താവും വിശുദ്ധരുടെ രാജാവേ, നിന്‍റെ വഴികൾ നീതിയും സത്യവുമുള്ളവ. <verse eid="REV 15:3" /><verse number="4" style="v" sid="REV 15:4" />കർത്താവേ, ആർ അങ്ങയെ ഭയപ്പെടാതെയും അങ്ങയുടെ നാമത്തെ മഹത്വപ്പെടുത്താതെയും ഇരിക്കും? എന്തെന്നാൽ അങ്ങ് മാത്രം പരിശുദ്ധൻ; അവിടുത്തെ ന്യായവിധികൾ വെളിപ്പെട്ടിരിക്കുന്നതിനാൽ സകലജാതികളും വന്നു തിരുസന്നിധിയിൽ ആരാധിക്കും.<verse eid="REV 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5" />ഈ സംഭവങ്ങൾക്ക് ശേഷം ഞാൻ നോക്കിയപ്പോൾ, സ്വർഗ്ഗത്തിലെ സാക്ഷ്യകൂടാരമായ ദൈവാലയം തുറന്നതായി കണ്ടു. <verse eid="REV 15:5" /><verse number="6" style="v" sid="REV 15:6" />ഏഴു ബാധയുള്ള ഏഴു ദൂതന്മാരും ശുദ്ധമായ വെള്ളവസ്ത്രം ധരിച്ചും മാറത്ത് പൊൻകച്ച കെട്ടിയുംകൊണ്ട് ദൈവാലയത്തിൽ നിന്നു പുറത്തു വന്നു. <verse eid="REV 15:6" /><verse number="7" style="v" sid="REV 15:7" />നാലു ജീവികളിൽ ഒന്ന് എന്നെന്നേക്കും ജീവിച്ചിരിക്കുന്ന ദൈവത്തിന്‍റെ ക്രോധം നിറഞ്ഞ ഏഴു സ്വർണ്ണപാത്രങ്ങൾ ആ ഏഴു ദൂതന്മാർക്ക് കൊടുത്തു. <verse eid="REV 15:7" /><verse number="8" style="v" sid="REV 15:8" />ദൈവത്തിന്‍റെ തേജസ്സിനാലും ശക്തിയാലും ദൈവാലയം പുകകൊണ്ട് നിറഞ്ഞു; ഏഴു ദൂതന്മാരുടെ ബാധ ഏഴും പൂർത്തിയാകുവോളം ദൈവാലയത്ത് പ്രവേശിക്കുവാൻ ആർക്കും കഴിഞ്ഞില്ല.<verse eid="REV 15:8" /></para>
  <chapter eid="REV 15" />
  <chapter number="16" style="c" sid="REV 16" />
  <para style="s">ദൈവക്രോധത്തിൻ്റെ പാത്രം</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1" />നിങ്ങൾ പോയി ദൈവക്രോധത്തിൻ്റെ പാത്രങ്ങൾ ഏഴും ഭൂമിയിൽ ഒഴിച്ചുകളവിൻ എന്നു ഏഴു ദൂതന്മാരോടും വിളിച്ചുപറയുന്ന ഒരു മഹാശബ്ദം ദൈവാലയത്തിൽ നിന്നു ഞാൻ കേട്ടു.<verse eid="REV 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2" />ഒന്നാമത്തെ ദൂതൻ പോയി തന്‍റെ പാത്രം ഭൂമിയിൽ ഒഴിച്ചു; മൃഗത്തിന്‍റെ മുദ്രയുള്ളവരും അതിന്‍റെ പ്രതിമയെ ആരാധിച്ചവരുമായ മനുഷ്യരുടെമേൽ നാറ്റമുണ്ടാക്കുന്ന ദുഷിച്ച വ്രണം ഉണ്ടായി.<verse eid="REV 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3" />രണ്ടാമത്തെ ദൂതൻ തന്‍റെ പാത്രം സമുദ്രത്തിൽ ഒഴിച്ചു; അത് മരിച്ചവൻ്റെ രക്തംപോലെ ആയിത്തീർന്നു; സമുദ്രത്തിലെ ജീവജന്തുക്കൾ ഒക്കെയും ചത്തുപോയി.<verse eid="REV 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4" />മൂന്നാമത്തെ ദൂതൻ തന്‍റെ പാത്രം നദികളിലും നീരുറവുകളിലും ഒഴിച്ചു, അവ രക്തമായിത്തീർന്നു. <verse eid="REV 16:4" /><verse number="5" style="v" sid="REV 16:5" />അപ്പോൾ ജലത്തിനധിപനായ ദൂതൻ പറയുന്നതായി ഞാൻ കേട്ടത്: “ഇരിക്കുന്നവനും ഇരുന്നവനും വരുവാനുള്ളവനുമായ പരിശുദ്ധനായുള്ളോവേ, അങ്ങ് അവിടുത്തെ ന്യായവിധി നടത്തിയതുകൊണ്ട് അങ്ങ് നീതിമാൻ ആകുന്നു. <verse eid="REV 16:5" /><verse number="6" style="v" sid="REV 16:6" />വിശുദ്ധന്മാരുടെയും പ്രവാചകന്മാരുടെയും രക്തം അവർ ഒഴുക്കിയതുകൊണ്ട് അങ്ങ് അവർക്ക് രക്തം കുടിക്കുവാൻ കൊടുത്തു; അതിന് അവർ യോഗ്യർ തന്നെ.”<verse eid="REV 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 16:7" />അതുപോലെ യാഗപീഠത്തിൽ നിന്നും: “അതേ, സർവ്വശക്തനായ ദൈവമായ കർത്താവേ, അങ്ങയുടെ ന്യായവിധികൾ സത്യവും നീതിയുമുള്ളവ” എന്നു പറയുന്നതായി ഞാൻ കേട്ടു.<verse eid="REV 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8" />നാലാമത്തെ ദൂതൻ തന്‍റെ പാത്രം സൂര്യനിൽ ഒഴിച്ചു; അപ്പോൾ തീകൊണ്ട് മനുഷ്യരെ ചുട്ടുപൊള്ളിക്കുവാൻ അതിന് അധികാരം കൊടുത്തു. <verse eid="REV 16:8" /><verse number="9" style="v" sid="REV 16:9" />മനുഷ്യർ അത്യുഷ്ണത്താൽ വെന്തുപോയി; എങ്കിലും ഈ ബാധകളുടെമേൽ അധികാരമുള്ള ദൈവത്തിന്‍റെ നാമത്തെ നിന്ദിച്ചതല്ലാതെ, അവനു മഹത്വം കൊടുക്കുവാൻ തക്കവണ്ണം അവർ മാനസാന്തരപ്പെട്ടില്ല.<verse eid="REV 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10" />അഞ്ചാമത്തെ ദൂതൻ തന്‍റെ പാത്രം മൃഗത്തിന്‍റെ സിംഹാസനത്തിന്മേൽ ഒഴിച്ചു; അപ്പോൾ അതിന്‍റെ രാജ്യം ഇരുണ്ടുപോയി. അതിവേദനയാൽ അവർ നാവ് കടിച്ചു. <verse eid="REV 16:10" /><verse number="11" style="v" sid="REV 16:11" />വേദനയും വ്രണങ്ങളും നിമിത്തം സ്വർഗ്ഗത്തിലെ ദൈവത്തെ നിന്ദിച്ചതല്ലാതെ അപ്പോഴും അവർ ചെയ്തിരുന്ന പ്രവൃത്തി വിട്ടു മാനസാന്തരപ്പെട്ടില്ല.<verse eid="REV 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12" />ആറാമത്തെ ദൂതൻ തന്‍റെ പാത്രം യൂഫ്രട്ടീസ് എന്ന മഹാനദിയിൽ ഒഴിച്ചു: കിഴക്ക് നിന്നു വരുന്ന രാജാക്കന്മാർക്കു വഴി ഒരുങ്ങേണ്ടതിന് അതിലെ വെള്ളം വറ്റിപ്പോയി. <verse eid="REV 16:12" /><verse number="13" style="v" sid="REV 16:13" />മഹാസർപ്പത്തിൻ്റെയും മൃഗത്തിൻ്റെയും കള്ളപ്രവാചകൻ്റെയും<note caller="+" style="f"><char style="fr" closed="false">16:13 </char><char style="ft" closed="false">കള്ളപ്രവാചകന്‍-ഭൂമിയില്‍ നിന്ന് കയറിവന്ന രണ്ടാമത്തെ മൃഗം, വെളിപ്പാട് 13:1</char></note> വായിൽനിന്ന് തവളകളെപ്പോലെ മൂന്നു അശുദ്ധാത്മാക്കൾ പുറത്തു വരുന്നത് ഞാൻ കണ്ടു. <verse eid="REV 16:13" /><verse number="14" style="v" sid="REV 16:14" />ഇവ ഭൂതലത്തിലെങ്ങും ഉള്ള രാജാക്കന്മാരെ ഒക്കെയും സർവ്വശക്തനായ ദൈവത്തിന്‍റെ മഹാദിവസത്തിലെ യുദ്ധത്തിന് കൂട്ടിച്ചേർക്കുവാൻ തക്കവണ്ണം അത്ഭുതങ്ങൾ ചെയ്തുകൊണ്ട് അവരുടെ അടുക്കലേക്ക് ചെല്ലുന്ന ഭൂതാത്മാക്കൾ തന്നെ. <verse eid="REV 16:14" /><verse number="15" style="v" sid="REV 16:15" /><char style="wj">ജാഗ്രതയായിരിക്ക! ഞാൻ കള്ളനെപ്പോലെ വരും; സൂക്ഷിച്ചു തന്‍റെ വസ്ത്രം വൃത്തിയായി കാത്തുകൊള്ളുന്നവൻ ഭാഗ്യവാൻ. അല്ലെങ്കിൽ, അവർ നഗ്നരായി നടക്കുകയും മറ്റുള്ളവർ അവരുടെ ലജ്ജ കാണുകയും ചെയ്യും.</char> <verse eid="REV 16:15" /><verse number="16" style="v" sid="REV 16:16" />അവൻ അവരെ എബ്രായ ഭാഷയിൽ ഹർമ്മഗെദ്ദോൻ<note caller="+" style="f"><char style="fr" closed="false">16:16 </char><char style="ft" closed="false">ഹര്‍മ്മഗദോന്‍-മഗിദ്ദോന്‍-കുന്ന്</char></note> എന്നു പേരുള്ള സ്ഥലത്ത് കൂട്ടിക്കൊണ്ട് വന്നു.<verse eid="REV 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17" />ഏഴാമത്തെ ദൂതൻ തന്‍റെ പാത്രം ആകാശത്തിൽ ഒഴിച്ചു; അപ്പോൾ: ചെയ്തു തീർന്നു എന്നു പറയുന്ന ഒരു മഹാശബ്ദം സിംഹാസനത്തിൽ നിന്നും ദൈവാലയത്തിൽ നിന്നും പുറപ്പെട്ടു. <verse eid="REV 16:17" /><verse number="18" style="v" sid="REV 16:18" />അപ്പോൾ ശബ്ദകോലാഹലങ്ങളും ഇടിമുഴക്കവും മിന്നലുകളും ഭൂമിയിൽ മനുഷ്യർ ഉണ്ടായതുമുതൽ ഇന്നോളം ഉണ്ടായിട്ടില്ലാത്തതുമായ വലുതായൊരു ഭൂകമ്പവും ഉണ്ടായി. <verse eid="REV 16:18" /><verse number="19" style="v" sid="REV 16:19" />മഹാനഗരം മൂന്നു ഭാഗമായി പിരിഞ്ഞു; ജനതകളുടെ പട്ടണങ്ങളും വീണുപോയി; ദൈവം മഹാബാബേലിനെ ഓർത്തു. അപ്പോൾ ദൈവക്രോധത്തിൻ്റെ തീഷ്ണതയുള്ള മദ്യം നിറഞ്ഞിരിക്കുന്ന പാനപാത്രം അവൾക്ക് കുടിക്കുവാൻ കൊടുക്കുകയും ചെയ്തു. <verse eid="REV 16:19" /><verse number="20" style="v" sid="REV 16:20" />സകലദ്വീപും ഓടി മറഞ്ഞു; പർവ്വതങ്ങൾ കാണ്മാനില്ലാതെയായി. <verse eid="REV 16:20" /><verse number="21" style="v" sid="REV 16:21" />മനുഷ്യരുടെമേൽ ആകാശത്ത് നിന്നും വലിയ കല്മഴ പെയ്തു. ഓരോ കല്ലിനും ഒരു താലന്തു<note caller="+" style="f"><char style="fr" closed="false">16:21 </char><char style="fq" closed="false">ഒരു താലന്തു </char><char style="ft" closed="false">40 കിലോഗ്രാം. </char></note> ഭാരം ഉണ്ടായിരുന്നു. കല്മഴയുടെ ബാധ ഏറ്റവും കഠിനമായിരുന്നതുകൊണ്ട് മനുഷ്യർ ആ ബാധനിമിത്തം ദൈവത്തെ ദുഷിച്ചു.<verse eid="REV 16:21" /></para>
  <chapter eid="REV 16" />
  <chapter number="17" style="c" sid="REV 17" />
  <para style="s">മൃഗത്തിന്മേൽ ഇരിക്കുന്ന സ്ത്രീ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1" />ഏഴു പാത്രമുള്ള ഏഴു ദൂതന്മാരിൽ ഒരുവൻ വന്നു എന്നോട് സംസാരിച്ച് പറഞ്ഞത്: “വരിക, ഭൂമിയിലെ രാജാക്കന്മാർ വേശ്യാവൃത്തി ചെയ്തു, തന്‍റെ വേശ്യാവൃത്തിയുടെ മദ്യത്താൽ <verse eid="REV 17:1" /><verse number="2" style="v" sid="REV 17:2" />ഭൂവാസികളെ മത്തരാക്കി പെരുവെള്ളത്തിന്മീതെ ഇരിക്കുന്ന മഹാവേശ്യയുടെ ന്യായവിധി ഞാൻ നിനക്കു കാണിച്ചുതരാം.”<verse eid="REV 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3" />ആ ദൂതൻ എന്നെ ആത്മാവിൽ മരുഭൂമിയിലേക്ക് കൊണ്ടുപോയി. അപ്പോൾ ഏഴു തലകളും പത്തു കൊമ്പുകളും ഉള്ള, ദൂഷണനാമങ്ങൾ നിറഞ്ഞു കടുഞ്ചുവപ്പുള്ളൊരു മൃഗത്തിന്മേൽ ഒരു സ്ത്രീ ഇരിക്കുന്നത് ഞാൻ കണ്ടു. <verse eid="REV 17:3" /><verse number="4" style="v" sid="REV 17:4" />ആ സ്ത്രീ ധൂമ്രവർണ്ണവും കടുഞ്ചുവപ്പ് നിറവും ഉള്ള വസ്ത്രം ധരിച്ചു പൊന്നും രത്നവും മുത്തും അണിഞ്ഞവളായി, അവളുടെ വേശ്യാവൃത്തിയുടെ മ്ലേച്ഛതയും അശുദ്ധിയും നിറഞ്ഞ സ്വർണ്ണപാനപാത്രം കയ്യിൽ പിടിച്ചിരുന്നു. <verse eid="REV 17:4" /><verse number="5" style="v" sid="REV 17:5" />മർമ്മം: മഹതിയാം ബാബേല്‍; വേശ്യകളുടേയും ഭൂമിയിലെ മ്ലേച്ഛതകളുടെയും മാതാവ് എന്നൊരു പേർ അവളുടെ നെറ്റിയിൽ എഴുതീട്ടുണ്ട്. <verse eid="REV 17:5" /><verse number="6" style="v" sid="REV 17:6" />വിശുദ്ധന്മാരുടെ രക്തവും യേശുവിനു വേണ്ടി സാക്ഷികളായവരുടെ രക്തവും കുടിച്ച് സ്ത്രീ മത്തയായിരിക്കുന്നതു ഞാൻ കണ്ടു; അവളെ കണ്ടപ്പോൾ, ഞാൻ അത്യന്തം ആശ്ചര്യപ്പെട്ടു.<verse eid="REV 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 17:7" />ദൂതൻ എന്നോട് പറഞ്ഞത്: ”നീ ആശ്ചര്യപ്പെടുന്നത് എന്ത്? ഈ സ്ത്രീയുടെയും ഏഴു തലയും പത്തു കൊമ്പും ഉള്ള അവളെ ചുമക്കുന്ന മൃഗത്തിൻ്റെയും അർത്ഥം ഞാൻ നിനക്കു വിശദീകരിച്ചു തരാം. <verse eid="REV 17:7" /><verse number="8" style="v" sid="REV 17:8" />നീ കണ്ട മൃഗമോ ഉണ്ടായിരുന്നതും ഇപ്പോൾ ഇല്ലാത്തതും ഇനി അഗാധഗർത്തത്തിൽനിന്നും കയറി നാശത്തിലേക്കു പോകുവാൻ ഉള്ളതും ആകുന്നു; ലോകസ്ഥാപനം മുതൽ ജീവപുസ്തകത്തിൽ പേർ എഴുതപ്പെടാതിരിക്കുന്ന ഭൂവാസികൾ ഒക്കെയും, ഉണ്ടായിരുന്നതും ഇപ്പോൾ ഇല്ലാത്തതും വരുവാനുള്ളതുമായ മൃഗത്തെ കാണുമ്പോൾ അതിശയിക്കും.<verse eid="REV 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 17:9" />”ഇവിടെ ജ്ഞാനമുള്ള മനസ്സ് ആവശ്യം; തല ഏഴും സ്ത്രീ ഇരിക്കുന്ന ഏഴു മലകളാകുന്നു. <verse eid="REV 17:9" /><verse number="10" style="v" sid="REV 17:10" />അവ ഏഴു രാജാക്കന്മാരും ആകുന്നു; അഞ്ചുരാജാക്കന്മാർ വീണുപോയി; ഒരുവൻ ഉണ്ട്; മറ്റൊരുവൻ ഇതുവരെ വന്നിട്ടില്ല; അവൻ വരുമ്പോൾ, അവനു അല്പകാലം ഇരിക്കേണ്ടിവരും. <verse eid="REV 17:10" /><verse number="11" style="v" sid="REV 17:11" />ഉണ്ടായിരുന്നതും ഇപ്പോൾ ഇല്ലാത്തതുമായ മൃഗം എട്ടാമത്തവനും എഴുവരിൽ ഒരുവനും നാശത്തിലേക്കു പോകുന്നവനും ആകുന്നു.<verse eid="REV 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12" />”നീ കണ്ട പത്തു കൊമ്പുകളും ഇതുവരെ രാജത്വം പ്രാപിച്ചിട്ടില്ലാത്ത പത്തു രാജാക്കന്മാർ; എന്നാൽ അവർ മൃഗത്തോടു കൂടെ ഒരു നാഴിക നേരത്തേക്ക് രാജാക്കന്മാരേപ്പോലെ അധികാരം പ്രാപിക്കും. <verse eid="REV 17:12" /><verse number="13" style="v" sid="REV 17:13" />ഇവർ ഒരേ മനസ്സുള്ളവർ; അവർ അവരുടെ ശക്തിയും അധികാരവും മൃഗത്തിന് ഏല്പിച്ചുകൊടുക്കുന്നു. <verse eid="REV 17:13" /><verse number="14" style="v" sid="REV 17:14" />അവർ കുഞ്ഞാടിനെതിരെ യുദ്ധം ചെയ്യും; എന്നാൽ താൻ കർത്താധികർത്താവും രാജാധിരാജാവും ആയതുകൊണ്ട് കുഞ്ഞാട് അവരുടെ മേൽ ജയംപ്രാപിക്കും. അവനോട് കൂടെയുള്ളവർ തിരഞ്ഞെടുക്കപ്പെട്ടവരും വിശ്വസ്തരും എന്നു വിളിക്കപ്പെടും.”<verse eid="REV 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15" />ദൂതൻ എന്നോട് പറഞ്ഞത്: ”നീ കണ്ടതും വേശ്യ ഇരിക്കുന്നതുമായ വെള്ളം വംശങ്ങളും ജനങ്ങളും ജനതകളും ഭാഷകളും അത്രേ. <verse eid="REV 17:15" /><verse number="16" style="v" sid="REV 17:16" />നീ കണ്ട മൃഗത്തിന്മേലുള്ള കൊമ്പുകളും വേശ്യയെ വെറുക്കുകയും അവർ അവളെ നിർമ്മൂലവും നഗ്നയുമാക്കി അവളുടെ മാംസം തിന്നുകളയുകയും അവളെ തീകൊണ്ട് ചുട്ടുകളയുകയും ചെയ്യും. <verse eid="REV 17:16" /><verse number="17" style="v" sid="REV 17:17" />ദൈവത്തിന്‍റെ വചനം നിവൃത്തിയാകുവോളം, ദൈവഹിതം നടത്തുന്നതിന്, മൃഗത്തിനു ഏല്പിച്ചുകൊടുക്കുവാൻ തക്കവണ്ണം ദൈവം അവരുടെ ഹൃദയങ്ങളിൽ ആലോചന നൽകി. <verse eid="REV 17:17" /><verse number="18" style="v" sid="REV 17:18" />നീ കണ്ട സ്ത്രീയോ ഭൂരാജാക്കന്മാരുടെ മേൽ വാഴുന്ന മഹാനഗരം തന്നെ.”<verse eid="REV 17:18" /></para>
  <chapter eid="REV 17" />
  <chapter number="18" style="c" sid="REV 18" />
  <para style="s">ബാബേലിന്‍റെ പതനം</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1" />ഈ സംഭവങ്ങൾക്കുശേഷം വലിയ അധികാരമുള്ള മറ്റൊരു ദൂതൻ സ്വർഗ്ഗത്തിൽനിന്ന് ഇറങ്ങി വരുന്നത് ഞാൻ കണ്ടു; അവന്‍റെ തേജസ്സിനാൽ ഭൂമി മുഴുവനും പ്രകാശിച്ചു. <verse eid="REV 18:1" /><verse number="2" style="v" sid="REV 18:2" />അവൻ ഉറക്കെ വിളിച്ചുപറഞ്ഞത്: “വീണുപോയി! മഹതിയാം ബാബേല്‍ വീണുപോയി; അവൾ ഭൂതങ്ങളുടെ പാർപ്പിടവും സകല അശുദ്ധാത്മാക്കളുടെയും വാസസ്ഥലവും അശുദ്ധിയും അറപ്പുമുണ്ടാക്കുന്ന സകലപക്ഷികളുടെയും താവളവുമായിത്തീർന്നിരിക്കുന്നു. <verse eid="REV 18:2" /><verse number="3" style="v" sid="REV 18:3" />അവളുടെമേൽ വേശ്യാവൃത്തിയുടെ ക്രോധമദ്യം സകലജനതകളും കുടിച്ചിരിക്കുന്നു; ഭൂമിയിലെ രാജാക്കന്മാർ അവളോട് വേശ്യാസംഗം ചെയ്തു; ഭൂമിയിലെ വ്യാപാരികൾ അവളുടെ അതിമോഹത്താൽ സമ്പന്നരായിത്തീർന്നു.”<verse eid="REV 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4" />പിന്നെ വേറൊരു ശബ്ദം സ്വർഗ്ഗത്തിൽനിന്നു പറയുന്നതായി ഞാൻ കേട്ടു: ”എന്‍റെ ജനങ്ങളേ, അവളുടെ പാപങ്ങളിൽ പങ്കാളികളാകാതെയും അവളുടെ ബാധകളിൽ ഒന്നുംതന്നെ തട്ടാതെയുമിരിപ്പാൻ അവളെ വിട്ടുപോരുവിൻ. <verse eid="REV 18:4" /><verse number="5" style="v" sid="REV 18:5" />അവളുടെ പാപം സ്വർഗ്ഗത്തോളം കൂമ്പാരമായിരിക്കുന്നു; അവളുടെ ദുഷ്കർമ്മങ്ങൾ ദൈവം ഓർത്തിട്ടുമുണ്ട്. <verse eid="REV 18:5" /><verse number="6" style="v" sid="REV 18:6" />അവൾ നിങ്ങൾക്ക് ചെയ്തതുപോലെ നിങ്ങൾ അവൾക്കും പകരം ചെയ്‌വിൻ; അവളുടെ പ്രവൃത്തികൾക്കു തക്കവണ്ണം അവൾക്ക് ഇരട്ടിയിരട്ടിയായി പകരം കൊടുക്കുവിൻ; അവൾ നിറച്ചു തന്ന പാനപാത്രത്തിൽ തന്നെ അവൾക്ക് ഇരട്ടി നിറച്ചു കൊടുക്കുവിൻ; <verse eid="REV 18:6" /><verse number="7" style="v" sid="REV 18:7" />അവൾ എത്രത്തോളം തന്നെത്താൻ പുകഴ്ത്തി മോഹപരവശയായി ജീവിച്ചുവോ, അത്രത്തോളം പീഡയും ദുഃഖവും അവൾക്ക് കൊടുക്കുവിൻ. രാജ്ഞിയായി ഞാൻ ഇരിക്കുന്നു; ഞാൻ വിധവയല്ല; ഞാൻ ഒരിക്കലും ദുഃഖം കാണുകയില്ല എന്നു അവൾ ഹൃദയംകൊണ്ട് പറയുന്നു. <verse eid="REV 18:7" /><verse number="8" style="v" sid="REV 18:8" />അതുകൊണ്ട് മരണം, വിലാപം, ക്ഷാമം എന്നിങ്ങനെ അവളുടെ ബാധകൾ ഒരു ദിവസത്തിൽ തന്നെ വരും; അവളെ തീയിൽ ഇട്ടു നിശേഷം ചുട്ടുകളയും; അവളെ ന്യായംവിധിക്കുന്ന ദൈവമായ കർത്താവ് ശക്തനല്ലോ.”<verse eid="REV 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9" />അവളോടു കൂടെ വേശ്യാസംഗം ചെയ്തു മോഹപരവശരായിരുന്ന ഭൂരാജാക്കന്മാർ അവളുടെ ദഹനത്തിന്‍റെ പുക കണ്ടു അവളെച്ചൊല്ലി മുറയിടുകയും വിലപിക്കുകയും ചെയ്യും. <verse eid="REV 18:9" /><verse number="10" style="v" sid="REV 18:10" />അവളുടെ പീഡ കണ്ടു ഭയപ്പെട്ട് ദൂരെ നിന്നുകൊണ്ട്: ”മഹാനഗരമായ ബാബേലേ, ബലമേറിയ പട്ടണമേ, കഷ്ടം, കഷ്ടം!, ഒരു മണിക്കൂറുകൊണ്ടു നിന്‍റെ ന്യായവിധി വന്നല്ലോ” എന്നു പറയും<verse eid="REV 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11" />ഭൂമിയിലെ വ്യാപാരികൾ അവളെച്ചൊല്ലി കരയുകയും വിലപിക്കുകയും ചെയ്യുന്നു. എന്തുകൊണ്ടെന്നാൽ അവരുടെ ചരക്കുകൾ ഇനി വാങ്ങാൻ ആരുമില്ല. <verse eid="REV 18:11" /><verse number="12" style="v" sid="REV 18:12" />പൊന്നു, വെള്ളി, രത്നം, മുത്ത്, നേരിയ തുണി, ധൂമ്രവസ്ത്രം, പട്ട്, കടുഞ്ചുവപ്പ്, ചന്ദനത്തരങ്ങൾ, ആനക്കൊമ്പുകൊണ്ടുള്ള സകലവിധ പാത്രങ്ങൾ, വിലയേറിയ മരം, പിച്ചള, ഇരുമ്പ്, മർമ്മരക്കല്ല് എന്നിവകൊണ്ടുള്ള സകല സാമാനങ്ങളും, <verse eid="REV 18:12" /><verse number="13" style="v" sid="REV 18:13" />ലവംഗം, സുഗന്ധദ്രവ്യങ്ങൾ, ലേപനങ്ങൾ, ധൂപവർഗ്ഗങ്ങൾ, വീഞ്ഞ്, എണ്ണ, നേരിയ മാവു, കോതമ്പ്, കന്നുകാലി, ആട്, കുതിര, രഥങ്ങൾ, അടിമകൾ, മാനുഷപ്രാണൻ ഈ വകകളൊക്കെ ആയിരുന്നു അവർ വ്യാപാരം ചെയ്തു വന്നിരുന്നത്.<verse eid="REV 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 18:14" />നിന്‍റെ മുഴുശക്തിയോടെ നീ ഏറ്റവും കൊതിച്ച കായ്കനികൾ നിനക്കു നഷ്ടമായി; നിന്‍റെ സ്വാദിഷ്ട ഭോജ്യങ്ങളും അവയുടെ രുചിയും ഇല്ലാതെയായി; നീ ഇനി ഒരിക്കലും അവ കാണുകയില്ല. <verse eid="REV 18:14" /><verse number="15" style="v" sid="REV 18:15" />ഈ സാധനങ്ങളെകൊണ്ട് അവളാൽ സമ്പന്നരായ വ്യാപാരികൾ അവളുടെ പീഡ കണ്ടു ഭയപ്പെട്ട് കരഞ്ഞും അലമുറയിട്ടും കൊണ്ടു ദൂരത്ത് മാറിനിൽക്കും.<verse eid="REV 18:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 18:16" />നേരിയ തുണിയും ധൂമ്രവർണ്ണവും കടുഞ്ചുവപ്പും ധരിച്ച് പൊന്നും രത്നവും മുത്തും അണിഞ്ഞ മഹാനഗരമേ, കഷ്ടം, കഷ്ടം! ഇത്രവലിയ സമ്പത്ത് ഒരു മണിക്കൂറുകൊണ്ടു നശിച്ചുപോയല്ലോ എന്നു അവർ പറയും. <verse eid="REV 18:16" /><verse number="17" style="v" sid="REV 18:17" />എല്ലാ കപ്പിത്താന്മാരും ഓരോ ദിക്കിലേക്കും കപ്പലേറി പോകുന്നവരും നാവികരും കടലിൽ വ്യാപാരം ചെയ്യുന്നവരൊക്കെയും <verse eid="REV 18:17" /><verse number="18" style="v" sid="REV 18:18" />ദൂരത്തുനിന്ന് അവളുടെ ദഹനത്തിന്‍റെ പുക കണ്ടപ്പോൾ, ഈ മഹാനഗരത്തോട് തുല്യമായി മറ്റേത് നഗരം ഉണ്ട്? എന്നു നിലവിളിച്ചുപറഞ്ഞു. <verse eid="REV 18:18" /><verse number="19" style="v" sid="REV 18:19" />അവർ തലയിൽ പൂഴി വാരിയിട്ടുംകൊണ്ട്: കടലിൽ കപ്പലുള്ളവർക്കെല്ലാം തന്‍റെ ധനത്താൽ സമ്പത്ത് വർദ്ധിപ്പിച്ച മഹാനഗരമേ, കഷ്ടം, കഷ്ടം! ഒറ്റ മണിക്കൂറുകൊണ്ടു അവൾ നശിച്ചുപോയല്ലോ എന്നു പറഞ്ഞ് അവർ വിലപിച്ചും നിലവിളിച്ചും കരഞ്ഞു. <verse eid="REV 18:19" /><verse number="20" style="v" sid="REV 18:20" />സ്വർഗ്ഗമേ, വിശുദ്ധ അപ്പൊസ്തലന്മാരും പ്രവാചകന്മാരുമേ, ആനന്ദിക്ക! ദൈവം നിങ്ങൾക്കുവേണ്ടി അവളോട് പ്രതികാരം നടത്തിയല്ലോ.<verse eid="REV 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21" />പിന്നെ, ശക്തനായൊരു ദൂതൻ തിരികല്ല് പോലെ വലിയ ഒരു കല്ല് എടുത്തു സമുദ്രത്തിൽ എറിഞ്ഞു പറഞ്ഞത്: ഇങ്ങനെ ബാബേല്‍ എന്ന മഹാനഗരത്തെ ശക്തിയോടെ എറിഞ്ഞുകളയും; ഇനി അതിനെ ഒരിക്കലും കാണുകയില്ല. <verse eid="REV 18:21" /><verse number="22" style="v" sid="REV 18:22" />വീണ വായിക്കുന്നവരുടെയും, സംഗീതക്കാരുടെയും, കുഴലൂത്തുകാരുടെയും, കാഹളക്കാരുടെയും സ്വരം നിന്നിൽ ഇനി ഒരിക്കലും കേൾക്കുകയില്ല; ഒരു തരത്തിലുമുള്ള കൗശലപ്പണിക്കാരും നിന്നിൽ ഇനി കാണുകയില്ല; തിരികല്ലിന്‍റെ ഒച്ച ഒരിക്കലും നിന്നിൽ കേൾക്കുകയുമില്ല. <verse eid="REV 18:22" /><verse number="23" style="v" sid="REV 18:23" />വിളക്കിൻ്റെ വെളിച്ചം ഇനി നിന്നിൽ പ്രകാശിക്കുകയില്ല; മണവാളൻ്റെയും മണവാട്ടിയുടെയും സ്വരം ഇനി നിന്നിൽ കേൾക്കുകയില്ല; നിന്‍റെ വ്യാപാരികൾ ഭൂമിയിലെ മഹത്തുക്കൾ ആയിരുന്നു; നിന്‍റെ മന്ത്രവാദത്താൽ എല്ലാ ജാതികളും വഞ്ചിക്കപ്പെട്ടിരുന്നു. <verse eid="REV 18:23" /><verse number="24" style="v" sid="REV 18:24" />പ്രവാചകന്മാരുടെയും വിശുദ്ധന്മാരുടെയും ഭൂമിയിൽവെച്ചു കൊല ചെയ്യപ്പെട്ട എല്ലാവരുടെയും രക്തം അവളിൽ അല്ലോ കണ്ടത്.<verse eid="REV 18:24" /></para>
  <chapter eid="REV 18" />
  <chapter number="19" style="c" sid="REV 19" />
  <para style="s">സ്വർഗ്ഗത്തിൽ മഹാഘോഷം</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1" />ഈ സംഭവങ്ങൾക്ക് ശേഷം സ്വർഗ്ഗത്തിൽ വലിയൊരു പുരുഷാരത്തിന്‍റെ മഹാഘോഷം ഞാൻ കേട്ടു:</para>
  <para style="q1" vid="REV 19:1">“ഹല്ലെലൂയ്യാ!<note caller="+" style="f"><char style="fr" closed="false">19:1 </char><char style="fp" closed="false">ഹല്ലെലൂയ്യാ-ദൈവത്തിനു സ്തുതി</char></note></para>
  <para style="q2" vid="REV 19:1">രക്ഷയും മഹത്വവും ബഹുമാനവും ശക്തിയും നമ്മുടെ ദൈവത്തിനുള്ളത്.<verse eid="REV 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="REV 19:2" />തന്‍റെ വേശ്യാവൃത്തികൊണ്ട് ഭൂമിയെ വഷളാക്കിയ മഹാവേശ്യയെ</para>
  <para style="q2" vid="REV 19:2">അവൻ ന്യായം വിധിച്ചതുകൊണ്ട്</para>
  <para style="q1" vid="REV 19:2">അവന്‍റെ ന്യായവിധികൾ സത്യവും നീതിയുമുള്ളവ.</para>
  <para style="q2" vid="REV 19:2">അവൾ ചൊരിഞ്ഞ അവന്‍റെ ദാസന്മാരുടെ രക്തത്തിന്</para>
  <para style="q2" vid="REV 19:2">അവൻ പ്രതികാരം ചെയ്തു.”<verse eid="REV 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 19:3" />അവർ രണ്ടാം പ്രാവശ്യം, ഹല്ലെലൂയ്യാ! എന്നു പാടി. അവളുടെ ന്യായവിധിയുടെ പുക എന്നെന്നേക്കും ഉയർന്നുക്കൊണ്ടിരുന്നു.<verse eid="REV 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 19:4" />ഇരുപത്തിനാല് മൂപ്പന്മാരും നാലു ജീവികളും, ‘ആമേൻ, ഹല്ലെലൂയ്യാ!’ എന്നു പറഞ്ഞു സിംഹാസനത്തിൽ ഇരിക്കുന്ന ദൈവത്തെ വീണു നമസ്കരിച്ചു.<verse eid="REV 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5" />നമ്മുടെ ദൈവത്തിന്‍റെ സകലദാസന്മാരും അവനെ ഭയപ്പെടുന്നവരുമായി ചെറിയവരും വലിയവരും ആയുള്ളോരേ, അവനെ വാഴ്ത്തുവിൻ എന്നു പറയുന്നൊരു ശബ്ദം സിംഹാസനത്തിൽ നിന്നു പുറപ്പെട്ടു.<verse eid="REV 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 19:6" />അപ്പോൾ വലിയ പുരുഷാരത്തിന്‍റെ ഘോഷംപോലെയും പെരുവെള്ളത്തിന്‍റെ ഇരച്ചിൽപോലെയും തകർത്ത ഇടിമുഴക്കംപോലെയും പറയുന്നത് ഞാൻ കേട്ടു; ഹല്ലെലൂയ്യാ! പരിപൂർണ്ണാധികാരി ആയ ദൈവമായ കർത്താവ് വാഴുന്നു. <verse eid="REV 19:6" /><verse number="7" style="v" sid="REV 19:7" />നമുക്ക് സന്തോഷിക്കാം, ആനന്ദിക്കാം അവനു ബഹുമാനം കൊടുക്കാം. കുഞ്ഞാടിൻ്റെ കല്യാണം വന്നിരിക്കുന്നു. അവന്‍റെ മണവാട്ടിയും തന്നെത്താൻ ഒരുങ്ങിയിരിക്കുന്നു. <verse eid="REV 19:7" /><verse number="8" style="v" sid="REV 19:8" />അവൾക്കു ശുദ്ധവും ശുഭ്രവുമായ വിശേഷവസ്ത്രം കൊണ്ടു അലങ്കരിക്കുവാൻ കൃപ ലഭിച്ചിരിക്കുന്നു; ആ വിശേഷവസ്ത്രം വിശുദ്ധന്മാരുടെ നീതിപ്രവൃത്തികൾ തന്നെ.<verse eid="REV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9" />പിന്നെ അവൻ എന്നോട് പറഞ്ഞത്: ”ഇതു എഴുതുക, കുഞ്ഞാടിൻ്റെ കല്യാണസദ്യയ്ക്ക് ക്ഷണിക്കപ്പെട്ടവർ ഭാഗ്യവാന്മാർ; ഇതു ദൈവത്തിന്‍റെ സത്യവചനങ്ങൾ ആകുന്നു.” എന്നും അവൻ എന്നോടു പറഞ്ഞു.<verse eid="REV 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10" />ഞാൻ അവനെ നമസ്കരിക്കേണ്ടതിന് അവന്‍റെ കാല്ക്കൽ വീണു; എന്നാൽ അവൻ എന്നോടു പറഞ്ഞത്: “നീ അത് ചെയ്യരുത്; ഞാൻ നിനക്കും യേശുവിനെകുറിച്ചു സാക്ഷ്യം ഉള്ള നിന്‍റെ സഹോദരന്മാർക്കും കൂട്ടുദാസനത്രേ; ദൈവത്തെ ആരാധിക്ക; പ്രവചനത്തിന്‍റെ ആത്മാവ് എന്നത് യേശുവിനെകുറിച്ചുള്ള സാക്ഷ്യം തന്നെ.”<verse eid="REV 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11" />പിന്നെ സ്വർഗ്ഗം തുറന്നിരിക്കുന്നത് ഞാൻ കണ്ടു; ഞാൻ നോക്കിയപ്പോൾ ഒരു വെള്ളക്കുതിര പ്രത്യക്ഷമായി; അതിന്മേൽ ഇരിക്കുന്നവന് വിശ്വസ്തനും സത്യവാനും എന്നു പേർ, അവൻ നീതിയോടെ ന്യായം വിധിക്കുകയും പോരാടുകയും ചെയ്യുന്നു. <verse eid="REV 19:11" /><verse number="12" style="v" sid="REV 19:12" />അവന്‍റെ കണ്ണ് അഗ്നിജ്വാലപോലെ; അവന്‍റെ തലയിൽ അനേകം കിരീടങ്ങൾ; അവനല്ലാതെ മറ്റാർക്കും അറിഞ്ഞുകൂടാതെ എഴുതപ്പെട്ടിട്ടുള്ള ഒരു നാമവും അവനുണ്ട്. <verse eid="REV 19:12" /><verse number="13" style="v" sid="REV 19:13" />അവൻ രക്തത്തിൽ മുക്കിയിരിക്കുന്ന ഒരു അങ്കിയും ധരിച്ചിരിക്കുന്നു; ദൈവവചനം എന്നു അവനു പേർ പറയുന്നു. <verse eid="REV 19:13" /><verse number="14" style="v" sid="REV 19:14" />സ്വർഗ്ഗത്തിലെ സൈന്യം ശുദ്ധവും ശുഭ്രവുമായ വിശേഷവസ്ത്രം ധരിച്ച് വെള്ളക്കുതിരകളുടെ പുറത്തു കയറി അവനെ അനുഗമിച്ചു. <verse eid="REV 19:14" /><verse number="15" style="v" sid="REV 19:15" />ജനതകളെ വെട്ടേണ്ടതിന് അവന്‍റെ വായിൽനിന്നു മൂർച്ചയുള്ള ഒരു വാള്‍ പുറപ്പെടുന്നു. ഇരുമ്പുകോൽ കൊണ്ടു അവൻ അവരെ ഭരിക്കും; സർവ്വശക്തനായ ദൈവത്തിന്‍റെ ക്രോധവും കോപാഗ്നിയുമായ മുന്തിരിച്ചക്ക് അവൻ മെതിക്കുന്നു. <verse eid="REV 19:15" /><verse number="16" style="v" sid="REV 19:16" />രാജാധിരാജാവും കർത്താധികർത്താവും എന്നൊരു നാമം അവന്‍റെ അങ്കിമേലും തുടമേലും എഴുതിയിരിക്കുന്നു.<verse eid="REV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17" />ഒരു ദൂതൻ സൂര്യനിൽ നില്ക്കുന്നതു ഞാൻ കണ്ടു; അവൻ ആകാശത്തുകൂടി പറക്കുന്ന സകല പക്ഷികളോടും: “ദൈവത്തിന്‍റെ വലിയ അത്താഴത്തിന് വന്നുകൂടുവിൻ, <verse eid="REV 19:17" /><verse number="18" style="v" sid="REV 19:18" />രാജാക്കന്മാരുടെ മാംസവും സേനാധിപന്മാരുടെ മാംസവും വീരന്മാരുടെ മാംസവും കുതിരകളുടെയും അതിന്‍റെ പുറത്തു ഇരിക്കുന്നവരുടെയും മാംസവും സ്വതന്ത്രന്മാരും അടിമകളും ചെറിയവരും വലിയവരുമായ സകലമനുഷ്യരുടെയും മാംസവും ഭക്ഷിക്കുവിൻ” എന്നു ഉച്ചത്തിൽ വിളിച്ചുപറഞ്ഞു.<verse eid="REV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19" />കുതിരപ്പുറത്തിരിക്കുന്നവനോടും അവന്‍റെ സൈന്യത്തോടും യുദ്ധം ചെയ്‌വാൻ മൃഗവും ഭൂമിയിലെ രാജാക്കന്മാരും അവരുടെ സൈന്യങ്ങളും ഒന്നിച്ച് കൂടിയത് ഞാൻ കണ്ടു. <verse eid="REV 19:19" /><verse number="20" style="v" sid="REV 19:20" />മൃഗത്തെയും അതിന്‍റെ മുമ്പാകെ താൻ ചെയ്ത അടയാളങ്ങളാൽ മനുഷ്യരെ ചതിച്ച് മൃഗത്തിന്‍റെ മുദ്ര ഏല്പിക്കുകയും അതിന്‍റെ പ്രതിമയെ ആരാധിപ്പിക്കുകയും ചെയ്ത കള്ളപ്രവാചകനെയും പിടിച്ച് കെട്ടി. അവർ ഇരുവരെയും ഗന്ധകം കത്തുന്ന തീപ്പൊയ്കയിൽ ജീവനോടെ തള്ളിക്കളഞ്ഞു. <verse eid="REV 19:20" /><verse number="21" style="v" sid="REV 19:21" />ശേഷിച്ചവർ കുതിരപ്പുറത്തിരിക്കുന്നവൻ്റെ വായിൽനിന്നു പുറപ്പെട്ട വാളിനാൽ കൊല്ലപ്പെട്ടു, അവരുടെ മാംസം സകല പക്ഷികളും തിന്ന് തൃപ്തരായി.<verse eid="REV 19:21" /></para>
  <chapter eid="REV 19" />
  <chapter number="20" style="c" sid="REV 20" />
  <para style="s">സഹസ്രാബ്ദം</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1" />പിന്നെ ഒരു ദൂതൻ അഗാധഗർത്തത്തിൻ്റെ താക്കോലും വലിയ ഒരു ചങ്ങലയും പിടിച്ചുകൊണ്ടു സ്വർഗ്ഗത്തിൽനിന്നും ഇറങ്ങി വരുന്നത് ഞാൻ കണ്ടു. <verse eid="REV 20:1" /><verse number="2" style="v" sid="REV 20:2" />അവൻ പിശാചും സാത്താനും എന്ന പഴയ പാമ്പായ മഹാസർപ്പത്തെ പിടിച്ച് ആയിരം വർഷത്തേക്ക് ബന്ധിച്ചു. <verse eid="REV 20:2" /><verse number="3" style="v" sid="REV 20:3" />ആയിരം വർഷക്കാലം ജനതകളെ വഞ്ചിക്കാതിരിപ്പാൻ ദൂതൻ അവനെ അഗാധഗർത്തത്തിലേക്ക് തള്ളിയിട്ട് അടച്ചുപൂട്ടുകയും മീതെ മുദ്രയിടുകയും ചെയ്തു. അതിന്‍റെശേഷം അല്പസമയത്തേക്ക് അവനെ അഴിച്ചുവിടേണ്ടതാകുന്നു.<verse eid="REV 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4" />പിന്നെ ഞാൻ സിംഹാസനങ്ങളെയും അവയിൽ ഇരിക്കുന്നവരെയും കണ്ടു; ന്യായം വിധിപ്പാനുള്ള അധികാരം അവർക്ക് കൊടുത്തു; യേശുവിന്‍റെ സാക്ഷ്യവും ദൈവവചനവും നിമിത്തം തലയറുക്കപ്പെട്ട്, മൃഗത്തെയോ അതിന്‍റെ പ്രതിമയെയോ ആരാധിക്കാതെ നെറ്റിയിലോ കൈമേലോ അവന്‍റെ മുദ്ര ഏൽക്കാതിരുന്നവരുടെ ആത്മാക്കളെയും ഞാൻ കണ്ടു; അവർ ജീവിച്ചു ആയിരം വർഷം ക്രിസ്തുവിനോടുകൂടി വാണു. <verse eid="REV 20:4" /><verse number="5" style="v" sid="REV 20:5" />ശേഷം മരിച്ചവർ ആയിരം വർഷക്കാലം ജീവിച്ചില്ല. ഇതു ഒന്നാമത്തെ പുനരുത്ഥാനം. <verse eid="REV 20:5" /><verse number="6" style="v" sid="REV 20:6" />ഒന്നാമത്തെ പുനരുത്ഥാനത്തിൽ പങ്കുള്ളവൻ ഭാഗ്യവാനും വിശുദ്ധനും ആകുന്നു; ഇങ്ങനെയുള്ളവരുടെ മേൽ രണ്ടാം മരണത്തിന് അധികാരം ഇല്ല; അവർ ദൈവത്തിനും ക്രിസ്തുവിനും പുരോഹിതന്മാരായി ക്രിസ്തുവിനോടുകൂടെ ആയിരം വർഷം വാഴും.<verse eid="REV 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7" />ആയിരം വർഷം കഴിയുമ്പോഴോ സാത്താനെ തടവിൽ നിന്നു മോചിപ്പിക്കും. <verse eid="REV 20:7" /><verse number="8" style="v" sid="REV 20:8" />അവൻ ഭൂമിയുടെ നാലു ദിക്കിലുമുള്ള ജാതികളായി, ഗോഗ്, മാഗോഗ് എന്നിവരെ, വശീകരിച്ച്, യുദ്ധത്തിനായി കൂട്ടിച്ചേർക്കേണ്ടതിന് പുറപ്പെടും. അവർ സംഖ്യയിൽ കടല്പുറത്തെ മണൽപോലെ ആയിരുന്നു. <verse eid="REV 20:8" /><verse number="9" style="v" sid="REV 20:9" />അവർ ഭൂമിയിൽ പരക്കെ ചെന്നു വിശുദ്ധന്മാരുടെ പാളയത്തെയും പ്രിയനഗരത്തെയും വളഞ്ഞു. എന്നാൽ സ്വർഗ്ഗത്തിലെ ദൈവത്തിൽനിന്ന് തീ ഇറങ്ങി അവരെ ദഹിപ്പിച്ചുകളയും. <verse eid="REV 20:9" /><verse number="10" style="v" sid="REV 20:10" />അവരെ വഞ്ചിച്ച പിശാചിനെ, മൃഗവും കള്ളപ്രവാചകനും ഉള്ള ഗന്ധകത്തീപ്പൊയ്കയിലേയ്ക്ക് തള്ളിയിടും; അവർ എന്നെന്നേക്കും രാപ്പകൽ ദണ്ഡനം അനുഭവിക്കേണ്ടിവരും.<verse eid="REV 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11" />പിന്നെ ഞാൻ വലിയൊരു വെള്ള സിംഹാസനവും അതിൽ ഇരിക്കുന്നവനെയും കണ്ടു; അവന്‍റെ സന്നിധിയിൽനിന്ന് ഭൂമിയും ആകാശവും ഓടിപ്പോയി; അവയ്ക്ക് അവിടെ സ്ഥാനമില്ലായിരുന്നു. <verse eid="REV 20:11" /><verse number="12" style="v" sid="REV 20:12" />വലിയവരും ചെറിയവരുമായ മരിച്ചവർ സിംഹാസനത്തിന്‍റെ മുമ്പിൽ നില്ക്കുന്നതു ഞാൻ കണ്ടു; പുസ്തകങ്ങൾ തുറന്നു; ജീവന്‍റെ പുസ്തകം എന്ന മറ്റൊരു പുസ്തകവും തുറന്നു; പുസ്തകങ്ങളിൽ എഴുതിയിരുന്നതിന് ഒത്തവണ്ണം മരിച്ചവർക്ക് അവർ ചെയ്ത പ്രവൃത്തികൾക്കുള്ള ന്യായവിധിയുണ്ടായി. <verse eid="REV 20:12" /><verse number="13" style="v" sid="REV 20:13" />സമുദ്രം തന്നിലുള്ള മരിച്ചവരെ ഏല്പിച്ചുകൊടുത്തു; മരണവും പാതാളവും തങ്ങളിലുള്ള മരിച്ചവരെ ഏല്പിച്ചുകൊടുത്തു; അവർ ഓരോരുത്തനും അവനവൻ ചെയ്ത പ്രവൃത്തികൾക്കനുസരിച്ച് ന്യായവിധിയുണ്ടായി. <verse eid="REV 20:13" /><verse number="14" style="v" sid="REV 20:14" />മരണത്തെയും പാതാളത്തെയും തീപ്പൊയ്കയിൽ തള്ളിയിട്ടു. ഇതു രണ്ടാമത്തെ മരണം<note caller="+" style="f"><char style="fr" closed="false">20:14 </char><char style="ft" closed="false">രണ്ടാമത്തെ മരണം-നിത്യമരണം</char></note>. <verse eid="REV 20:14" /><verse number="15" style="v" sid="REV 20:15" />ജീവപുസ്തകത്തിൽ പേരെഴുതിക്കാണാത്ത ഏവനെയും തീപ്പൊയ്കയിൽ തള്ളിയിടും.<verse eid="REV 20:15" /></para>
  <chapter eid="REV 20" />
  <chapter number="21" style="c" sid="REV 21" />
  <para style="s">പുതിയ ഒരു ആകാശവും പുതിയ ഒരു ഭൂമിയും</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1" />പിന്നെ ഞാൻ പുതിയ ഒരു ആകാശവും പുതിയ ഒരു ഭൂമിയും കണ്ടു; ഒന്നാമത്തെ ആകാശവും ഒന്നാമത്തെ ഭൂമിയും ഇല്ലാതെ ആയി; സമുദ്രവും ഇനിമേൽ ഇല്ല. <verse eid="REV 21:1" /><verse number="2" style="v" sid="REV 21:2" />പുതിയ യെരൂശലേം എന്ന വിശുദ്ധനഗരം ഭർത്താവിനായി അണിയിച്ചൊരുക്കിയ മണവാട്ടിയെപ്പോലെ ഒരുങ്ങി സ്വർഗ്ഗത്തിൽ, ദൈവസന്നിധിയിൽനിന്ന് തന്നെ, ഇറങ്ങി വരുന്നത് ഞാൻ കണ്ടു. <verse eid="REV 21:2" /><verse number="3" style="v" sid="REV 21:3" />സിംഹാസനത്തിൽനിന്ന് ഒരു മഹാശബ്ദം പറയുന്നതായി ഞാൻ കേട്ടത്: “ഇതാ, മനുഷ്യരോടുകൂടെ ദൈവത്തിന്‍റെ കൂടാരം; അവൻ അവരോടുകൂടെ വസിക്കും; അവർ അവന്‍റെ ജനമായിരിക്കും; ദൈവം താൻതന്നെ അവരുടെ ദൈവമായി അവരോടുകൂടെ ഇരിക്കും. <verse eid="REV 21:3" /><verse number="4" style="v" sid="REV 21:4" />അവൻ അവരുടെ കണ്ണിൽ നിന്നു കണ്ണുനീർ എല്ലാം തുടച്ചുകളയും. ഇനിമേൽ മരണമോ ദുഃഖമോ കരച്ചിലോ വേദനയോ ഉണ്ടാവുകയില്ല; മുമ്പുണ്ടായിരുന്നത് കഴിഞ്ഞുപോയി.“<verse eid="REV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5" />സിംഹാസനത്തിൽ ഇരിക്കുന്നവൻ എന്നോട് പറഞ്ഞത്: “ഇതാ, ഞാൻ സകലവും പുതിയതാക്കുന്നു. അവൻ എന്നോട് പറഞ്ഞത്: എഴുതുക; ഈ വചനം വിശ്വാസയോഗ്യവും സത്യവും ആകുന്നു.“<verse eid="REV 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 21:6" />പിന്നെയും അവൻ എന്നോട് അരുളിച്ചെയ്തത്: “അത് സംഭവിച്ചുതീർന്നു; ഞാൻ അല്ഫയും ഓമേഗയും ആദിയും അന്തവും ആകുന്നു; ദാഹിക്കുന്നവന് ജീവനീരുറവിൽ നിന്നു സൗജന്യമായി ഞാൻ കൊടുക്കും. <verse eid="REV 21:6" /><verse number="7" style="v" sid="REV 21:7" />ജയിക്കുന്നവൻ ഇതെല്ലാം അവകാശമാക്കും; ഞാൻ അവനു ദൈവവും അവൻ എനിക്ക് മകനുമായിരിക്കും. <verse eid="REV 21:7" /><verse number="8" style="v" sid="REV 21:8" />എന്നാൽ ഭീരുക്കൾക്കും, അവിശ്വാസികൾക്കും, അറയ്ക്കപ്പെട്ടവർക്കും, കൊലപാതകന്മാർക്കും, ദുർന്നടപ്പുകാർക്കും, ക്ഷുദ്രക്കാർക്കും, ബിംബാരാധികൾക്കും, ഭോഷ്കുപറയുന്ന ഏവർക്കും ഉള്ള പങ്ക്, തീയും ഗന്ധകം കത്തുന്ന തീപൊയ്കയിലത്രെ; ഇതു രണ്ടാമത്തെ മരണം.“ <note caller="+" style="f"><char style="fr" closed="false">21:8 </char><char style="ft" closed="false">രണ്ടാമത്തെ മരണം-നിത്യമരണം</char></note><verse eid="REV 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9" />അന്ത്യബാധകൾ ഏഴും നിറഞ്ഞ ഏഴു പാത്രങ്ങൾ ഉണ്ടായിരുന്ന ഏഴു ദൂതന്മാരിൽ ഒരുവൻ എന്‍റെ അടുക്കൽ വന്നു പറഞ്ഞത്: “ഇവിടെ വരിക, ഞാൻ കുഞ്ഞാടിൻ്റെ കാന്തയാകുവാനുള്ള മണവാട്ടിയെ കാണിച്ചുതരാം.”<verse eid="REV 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 21:10" />അവൻ എന്നെ ആത്മാവിൽ ഉയർന്നതും വലിയതും ആയ ഒരു മലയിൽ കൊണ്ടുപോയി, വിശുദ്ധ യെരൂശലേമെന്ന വലിയ നഗരം സ്വർഗ്ഗത്തിൽനിന്ന്, ദൈവസന്നിധിയിൽനിന്ന് തന്നെ, ദൈവമഹത്വത്തോടെ ഇറങ്ങി വരുന്നത് എനിക്ക് കാണിച്ചുതന്നു. <verse eid="REV 21:10" /><verse number="11" style="v" sid="REV 21:11" />അതിന്‍റെ ജ്യോതിസ്സ് ഏറ്റവും വിലയേറിയ രത്നത്തിന് തുല്യമായി സ്ഫടികസ്വച്ഛമായുള്ള സൂര്യകാന്തംപോലെ ആയിരുന്നു. <verse eid="REV 21:11" /><verse number="12" style="v" sid="REV 21:12" />അതിന് വലിയ ഉയരമുള്ള മതിലും പന്ത്രണ്ടു വാതിലുകളും, വാതിലുകളിൽ പന്ത്രണ്ടു ദൂതന്മാരും ഉണ്ട്; യിസ്രായേൽ മക്കളുടെ പന്ത്രണ്ടു ഗോത്രങ്ങളുടെയും പേരുകൾ വാതിലുകളിൽ കൊത്തീട്ടും ഉണ്ടായിരുന്നു. <verse eid="REV 21:12" /><verse number="13" style="v" sid="REV 21:13" />കിഴക്ക് മൂന്നു വാതിലുകൾ, വടക്കു മൂന്നു വാതിലുകൾ, തെക്ക് മൂന്നു വാതിലുകൾ പടിഞ്ഞാറു മൂന്നു വാതിലുകൾ. <verse eid="REV 21:13" /><verse number="14" style="v" sid="REV 21:14" />നഗരത്തിന്‍റെ മതിലിന് പന്ത്രണ്ടു അടിസ്ഥാനങ്ങളും അവയിൽ കുഞ്ഞാടിൻ്റെ പന്ത്രണ്ടു അപ്പൊസ്തലന്മാരുടെ പേരുകളും ഉണ്ട്.<verse eid="REV 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 21:15" />എന്നോട് സംസാരിച്ചവന് നഗരത്തെയും അതിന്‍റെ വാതിലുകളെയും അതിന്‍റെ മതിലിനെയും അളക്കേണ്ടതിന് ഒരു സ്വർണ്ണകോൽ ഉണ്ടായിരുന്നു. <verse eid="REV 21:15" /><verse number="16" style="v" sid="REV 21:16" />നഗരം സമചതുരമായി കിടക്കുന്നു; അതിന്‍റെ വീതിയും നീളവും സമം. അളവുകോൽകൊണ്ട് അവൻ നഗരത്തെ അളന്നു; ആയിരത്തിരുനൂറ് നാഴിക; അതിന്‍റെ നീളവും വീതിയും ഉയരവും സമം തന്നെ. <verse eid="REV 21:16" /><verse number="17" style="v" sid="REV 21:17" />അവൻ അതിന്‍റെ മതിലും അളന്നു; നൂറ്റിനാല്പത്തിനാല് മുഴം ഘനം; മനുഷ്യന്‍റെ അളവിന് എന്നുവച്ചാൽ ദൂതന്‍റെ അളവിന് തന്നെ. <verse eid="REV 21:17" /><verse number="18" style="v" sid="REV 21:18" />മതിലിന്‍റെ പണി സൂര്യകാന്തവും നഗരം സ്വച്ഛസ്ഫടികത്തിനൊത്ത തങ്കവും ആയിരുന്നു. <verse eid="REV 21:18" /><verse number="19" style="v" sid="REV 21:19" />മതിലിന്‍റെ അടിസ്ഥാനങ്ങൾ സകലവിധ രത്നങ്ങളുംകൊണ്ട് അലങ്കരിച്ചിരുന്നു; ഒന്നാം അടിസ്ഥാനം സൂര്യകാന്തം രണ്ടാമത്തേത് നീലരത്നം, മൂന്നാമത്തേതു മാണിക്യം, നാലാമത്തേത് മരതകം, <verse eid="REV 21:19" /><verse number="20" style="v" sid="REV 21:20" />അഞ്ചാമത്തേത് സ്ഫടികക്കല്ല്, ആറാമത്തേത് ചുവപ്പുകല്ല്, ഏഴാമത്തേത് ചന്ദ്രകാന്തം, എട്ടാമത്തേത് ഗോമേദകം, ഒമ്പതാമത്തേത് പുഷ്യരാഗം, പത്താമത്തേത് വൈഡൂര്യം, പതിനൊന്നാമത്തേത് പത്മരാഗം, പന്ത്രണ്ടാമത്തേത് സുഗന്ധിരത്നം.<verse eid="REV 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 21:21" />പന്ത്രണ്ടു വാതിലുകളും പന്ത്രണ്ടു മുത്ത്; ഓരോ വാതിലും ഓരോ മുത്തുകൊണ്ടുള്ളതും നഗരത്തിന്‍റെ വീഥികൾ സ്വച്ഛസ്ഫടികത്തിന് തുല്യമായ തങ്കവും ആയിരുന്നു.<verse eid="REV 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22" />ഒരു ആലയവും നഗരത്തിൽ ഞാൻ കണ്ടില്ല; സർവ്വശക്തനായ ദൈവമായ കർത്താവും കുഞ്ഞാടും അതിന്‍റെ ആലയം ആകുന്നു. <verse eid="REV 21:22" /><verse number="23" style="v" sid="REV 21:23" />ദൈവതേജസ്സ് നഗരത്തെ പ്രകാശിപ്പിച്ചിരുന്നതുകൊണ്ട് അതിൽ സൂര്യന്‍റെയോ ചന്ദ്രൻ്റേയോ ആവശ്യമില്ലായിരുന്നു; കുഞ്ഞാട് അതിന്‍റെ വിളക്കു ആകുന്നു. <verse eid="REV 21:23" /><verse number="24" style="v" sid="REV 21:24" />രക്ഷിയ്ക്കപ്പെട്ട ജനതകൾ അതിന്‍റെ വെളിച്ചത്തിൽ നടക്കും; ഭൂമിയിലെ രാജാക്കന്മാർ അവരുടെ മഹത്വവും ബഹുമാനവും അതിലേക്ക് കൊണ്ടുവരും. <verse eid="REV 21:24" /><verse number="25" style="v" sid="REV 21:25" />അതിന്‍റെ വാതിലുകൾ പകൽക്കാലത്ത് അടയ്ക്കുകയില്ല; രാത്രി അവിടെ ഇല്ലല്ലോ. <verse eid="REV 21:25" /><verse number="26" style="v" sid="REV 21:26" />അവർ ജനതകളുടെ മഹത്വവും ബഹുമാനവും അതിലേക്ക് കൊണ്ടുവരും. <verse eid="REV 21:26" /><verse number="27" style="v" sid="REV 21:27" />കുഞ്ഞാടിൻ്റെ ജീവപുസ്തകത്തിൽ പേർ എഴുതിയിരിക്കുന്നവരല്ലാതെ<note caller="+" style="f"><char style="fr" closed="false">21:27 </char><char style="ft" closed="false">ജീവപുസ്തകത്തിൽ പേരില്ലെങ്കിൽ അതിൽ കടക്കുകയില്ല എന്ന അർത്ഥത്തിലാണ് ഈ പ്രയോഗം. </char></note> അശുദ്ധമായത് യാതൊന്നും, ഏതെങ്കിലും ചതിവോ മ്ലേച്ഛതയോ പ്രവർത്തിക്കുന്നതോ ആയ ഒന്നുംതന്നെ അതിൽ കടക്കുകയില്ല.<verse eid="REV 21:27" /></para>
  <chapter eid="REV 21" />
  <chapter number="22" style="c" sid="REV 22" />
  <para style="s">ജീവജലനദി</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1" />പിന്നെ അവൻ ദൈവത്തിന്‍റെയും കുഞ്ഞാടിൻ്റെയും സിംഹാസനത്തിൽ നിന്നും പുറപ്പെടുന്ന പളുങ്കുപോലെ നിർമ്മലമായ ജീവജലനദിയും എന്നെ കാണിച്ചു. <verse eid="REV 22:1" /><verse number="2" style="v" sid="REV 22:2" />അതിന്‍റെ വീഥിയുടെ നടുവിൽ നദിയ്ക്ക് ഇക്കരെയും അക്കരെയും ജീവവൃക്ഷം ഉണ്ടായിരുന്നു; അത് പന്ത്രണ്ടുവിധം ഫലം കായിച്ച് മാസംതോറും അതത് ഫലം കൊടുത്തിരുന്നു; വൃക്ഷത്തിന്‍റെ ഇലകൾ ജനതകൾക്ക് രോഗശാന്തിക്കു നല്കിയിരുന്നു. <verse eid="REV 22:2" /><verse number="3" style="v" sid="REV 22:3" />യാതൊരു ശാപവും ഇനി ഉണ്ടാകയില്ല; ദൈവത്തിന്‍റെയും കുഞ്ഞാടിൻ്റെയും സിംഹാസനം അതിൽ ഇരിക്കും; അവന്‍റെ ദാസന്മാർ അവനെ ആരാധിക്കും. <verse eid="REV 22:3" /><verse number="4" style="v" sid="REV 22:4" />അവർ അവന്‍റെ മുഖം കാണും; അവന്‍റെ പേർ അവരുടെ നെറ്റിയിൽ ഉണ്ടായിരിക്കും. <verse eid="REV 22:4" /><verse number="5" style="v" sid="REV 22:5" />ഇനി രാത്രി അവിടെ ഉണ്ടാകയില്ല; ദൈവമായ കർത്താവ് അവർക്ക് പ്രകാശം നല്കുന്നതുകൊണ്ട് വിളക്കിൻ്റെ വെളിച്ചമോ സൂര്യപ്രകാശമോ അവർക്ക് ആവശ്യമില്ല. അവർ എന്നെന്നേക്കും വാഴും.<verse eid="REV 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6" />അവൻ എന്നോട്: “ഈ വചനം വിശ്വാസയോഗ്യവും സത്യവും ആകുന്നു; വിശുദ്ധ പ്രവാചകന്മാരുടെ കർത്താവായ ദൈവം വേഗത്തിൽ സംഭവിപ്പാനുള്ളത് തന്‍റെ ദാസന്മാരെ കാണിക്കേണ്ടതിന് തന്‍റെ ദൂതനെ അയച്ചു.“<verse eid="REV 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7" />
    <char style="wj">ഇതാ, ഞാൻ വേഗം വരുന്നു; ഈ പുസ്തകത്തിലെ പ്രവചനത്തിന്‍റെ വചനങ്ങളെ കാത്തുകൊള്ളുന്നവൻ ഭാഗ്യവാൻ.</char><verse eid="REV 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8" />യോഹന്നാൻ എന്ന ഞാൻ ഈ കാര്യങ്ങൾ എല്ലാം കാണുകയും കേൾക്കുകയും ചെയ്തു. ഞാൻ കേൾക്കുകയും കാൺകയും ചെയ്തപ്പോൾ അത് എനിക്ക് കാണിച്ചുതന്ന ദൂതനെ നമസ്കരിക്കേണ്ടതിന് ഞാൻ കാൽക്കൽ വീണു. <verse eid="REV 22:8" /><verse number="9" style="v" sid="REV 22:9" />അവൻ എന്നോട്: “നീ അത് ചെയ്യരുത്: ഞാൻ നിന്‍റെയും നിന്‍റെ സഹോദരന്മാരായ പ്രവാചകന്മാരുടെയും ഈ പുസ്തകത്തിലെ വചനം അനുസരിക്കുന്നവരുടെയും കൂട്ടുദാസനത്രേ; ദൈവത്തെ ആരാധിക്ക“ എന്നു പറഞ്ഞു.<verse eid="REV 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 22:10" />അവൻ എന്നോട് പറഞ്ഞത്: “സമയം അടുത്തിരിക്കുകയാൽ ഈ പുസ്തകത്തിലെ പ്രവചനത്തിന്‍റെ വചനങ്ങളെ മുദ്രയിടരുതു. <verse eid="REV 22:10" /><verse number="11" style="v" sid="REV 22:11" />അനീതിയുള്ളവൻ ഇനിയും അനീതി ചെയ്യട്ടെ; മ്ലേച്ഛനായവൻ ഇനിയും മ്ലേച്ഛനായിരിക്കട്ടെ; നീതിമാൻ ഇനിയും നീതിമാനായിരിക്കട്ടെ; വിശുദ്ധൻ ഇനിയും വിശുദ്ധനായിരിക്കട്ടെ.“<verse eid="REV 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12" />
    <char style="wj">ഇതാ, ഞാൻ വേഗം വരുന്നു; ഓരോരുത്തനും അവനവന്‍റെ പ്രവൃത്തിക്കു തക്കവണ്ണം കൊടുക്കുവാൻ പ്രതിഫലം എന്‍റെ അടുക്കൽ ഉണ്ട്.</char> <verse eid="REV 22:12" /><verse number="13" style="v" sid="REV 22:13" /><char style="wj">ഞാൻ അല്ഫയും ഓമേഗയും ആരംഭവും അവസാനവും ആദിയും അന്ത്യവും ആകുന്നു.</char> <verse eid="REV 22:13" /><verse number="14" style="v" sid="REV 22:14" /><char style="wj">ജീവന്‍റെ വൃക്ഷത്തിൽ പങ്ക് ലഭിക്കേണ്ടതിനും വാതിലുകളിൽകൂടി നഗരത്തിൽ കടക്കേണ്ടതിനും അവന്‍റെ പ്രമാണങ്ങളെ അനുസരിക്കുന്നവരായ തങ്ങളുടെ വസ്ത്രങ്ങളെ അലക്കുന്നവര്‍</char><note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">തങ്ങളുടെ വസ്ത്രങ്ങളെ അലക്കുന്നവര്‍-പ്രമാണങ്ങളെ അനുസരിക്കുന്നവര്‍</char></note> <char style="wj">ഭാഗ്യവാന്മാർ. </char> <verse eid="REV 22:14" /><verse number="15" style="v" sid="REV 22:15" /><char style="wj">നായ്ക്കളും ക്ഷുദ്രക്കാരും ദുർന്നടപ്പുകാരും കൊലപാതകന്മാരും ബിംബാരാധികളും വ്യാജത്തെ ഇഷ്ടപ്പെടുകയും പ്രവർത്തിക്കയും ചെയ്യുന്ന എല്ലാവരും പുറത്തു തന്നെ.</char><verse eid="REV 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16" />
    <char style="wj">സഭകളിൽ ഈ കാര്യങ്ങൾ സാക്ഷീകരിക്കേണ്ടതിന് യേശു എന്ന ഞാൻ എന്‍റെ ദൂതനെ നിന്‍റെ അടുക്കൽ അയച്ചിരിക്കുന്നു; ഞാൻ ദാവീദിന്‍റെ വേരും വംശവും തേജസ്സുള്ള ഉദയനക്ഷത്രവുമാകുന്നു.</char><verse eid="REV 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17" />വരിക എന്നു ആത്മാവും മണവാട്ടിയും പറയുന്നു; കേൾക്കുന്നവനും വരിക എന്നു പറയട്ടെ; ദാഹിക്കുന്നവൻ വരട്ടെ; ആശിക്കുന്നവൻ ജീവജലം സൗജന്യമായി വാങ്ങട്ടെ.<verse eid="REV 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18" />ഈ പുസ്തകത്തിലെ പ്രവചനത്തിന്‍റെ വാക്കുകൾ കേൾക്കുന്ന ഏവനോടും ഞാൻ സാക്ഷീകരിക്കുന്നത്: അതിനോട് ആരെങ്കിലും കൂട്ടിയാൽ ഈ പുസ്തകത്തിൽ എഴുതിയിരിക്കുന്ന ബാധകൾ ദൈവം അവനു വരുത്തും. <verse eid="REV 22:18" /><verse number="19" style="v" sid="REV 22:19" />ഈ പ്രവചന പുസ്തകത്തിലെ വചനങ്ങളിൽ നിന്നു ആരെങ്കിലും എന്തെങ്കിലും നീക്കിക്കളഞ്ഞാൽ ജീവന്‍റെ പുസ്തകത്തിലേയും വിശുദ്ധനഗരത്തിലേയും ഈ പുസ്തകത്തിൽ എഴുതിയിരിക്കുന്ന മറ്റെല്ലാത്തിലും അവനുള്ള ഓഹരി ദൈവം നീക്കിക്കളയും.<verse eid="REV 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20" />ഈ കാര്യങ്ങളെ സാക്ഷീകരിക്കുന്നവൻ അരുളിച്ചെയ്യുന്നത്: അതേ, <char style="wj">ഞാൻ വേഗം വരുന്നു.</char> ആമേൻ, അതെ, കർത്താവായ യേശുവേ, വരേണമേ.<verse eid="REV 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21" />കർത്താവായ യേശുവിന്‍റെ കൃപ നിങ്ങളോടെല്ലാവരോടുംകൂടെ ഇരിക്കുമാറാകട്ടെ; ആമേൻ.<verse eid="REV 22:21" /></para>
  <chapter eid="REV 22" />
</usx>