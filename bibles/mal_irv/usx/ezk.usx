<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EZK" style="id" />
  <para style="ide">UTF-8</para>
  <para style="h">യെഹെസ്കേൽ</para>
  <para style="toc1">യെഹെസ്കേൽ</para>
  <para style="toc2">യെഹെ.</para>
  <para style="toc3">യെഹെ.</para>
  <para style="mt">യെഹെസ്കേൽ</para>
  <para style="is">ഗ്രന്ഥകര്‍ത്താവ്</para>
  <para style="ip">ബുസ്സിയുടെ മകനും പ്രവാചകനും പുരോഹിതനുമായിരുന്നു യെഹസ്കേല്‍. യെരൂശലേമിലെ ഒരു പൗരോഹിത്യ കുടുംബത്തിൽ ജനിച്ച അദ്ദേഹം ബാബേൽ പ്രവാസത്തിൽ യെഹൂദാ ജനത്തോടൊപ്പം ജീവിച്ചു. യെഹസ്കേലിൻ്റെ പൗരോഹിത്യ പാരമ്പര്യം തന്‍റെ പ്രവാചക ശുശ്രൂഷയിലൂടെ പ്രകാശിക്കുന്നു. ദൈവാലയം, പൗരോഹിത്യം, ദൈവമഹത്വം, യാഗങ്ങൾ, തുടങ്ങിയ വിഷയങ്ങള്‍ക്ക് അദ്ദേഹത്തിന്‍റെ എഴുത്തിൽ പ്രത്യേക പരാമർശങ്ങളുണ്ട്.</para>
  <para style="is">എഴുതപ്പെട്ട കാലഘട്ടവും സ്ഥലവും</para>
  <para style="ip">ഏകദേശം ക്രി. മു. 593-570.</para>
  <para style="ip">ബാബേലില്‍ വച്ചാണ് പുസ്തകത്തിന് രചന നടന്നിട്ടുള്ളത് എങ്കിലും അദ്ദേഹത്തിന്‍റെ പ്രവചനങ്ങൾ യിസ്രായേലിനെ സംബന്ധിച്ചും അതിന്‍റെ അയല്‍രാജ്യങ്ങളെയും കുറിച്ചാണ്.</para>
  <para style="is">സ്വീകര്‍ത്താക്കള്‍</para>
  <para style="ip">സ്വദേശത്തും ബാബിലോണില്‍ പ്രവാസത്തിലും ആയിരിക്കുന്ന യിസ്രായേല്‍ ജനത്തിനാണ് ഈ പുസ്തകം എഴുതിയിട്ടുള്ളത്.</para>
  <para style="is">ഉദ്ദേശ്യം</para>
  <para style="ip">പാപത്തിൽ മുഴുകി യാതൊരു പ്രത്യാശയും ഇല്ലാതെ കഴിയുന്ന ഒരു തലമുറക്കാണ് യെഹസ്കേൽ ശുശ്രൂഷ ചെയ്തത്. അദ്ദേഹം തന്‍റെ പ്രവാചക ശുശ്രൂഷയിലൂടെ ജനത്തെ അനുതാപത്തിലേക്കും അതുവഴി ഭാവിയെക്കുറിച്ചുള്ള പ്രതീക്ഷകളിലേക്കും തിരികെ കൊണ്ടുവരുവാൻ ശ്രമിച്ചു. ദൈവം പലപ്പോഴും മനുഷ്യരെ തന്‍റെ ദൂതന്മാരാക്കി അയക്കുന്നു. പരാജയപ്പെടുമ്പോഴും നിരാശയിൽ ആയിരിക്കുമ്പോഴും ദൈവത്തെ അംഗീകരിക്കുവാനും, ദൈവവചനം ഒരിക്കലും നശിക്കുന്നില്ല എന്നും ദൈവം സർവ്വവ്യാപി ആയതിനാൽ എവിടെയും ദൈവത്തെ ആരാധിക്കാനായി സാധിക്കും എന്നു അദ്ദേഹം പഠിപ്പിച്ചു. സ്വയം നഷ്ടപ്പെട്ടവരായി നിരാശപ്പെടുന്ന സമയത്ത് ദൈവസന്നിധിയിലേക്ക് നോക്കി സ്വയം പരിശോധിച്ചു ദൈവത്തിൽ പ്രത്യാശ അർപ്പിക്കുവാൻ ഈ പുസ്തകം ഓർമ്മിപ്പിക്കുന്നു.</para>
  <para style="is">പ്രമേയം</para>
  <para style="ip">ദൈവമഹത്വം</para>
  <para style="iot">സംക്ഷേപം</para>
  <para style="io1">1. യെഹെസ്കേല്‍ വിളിക്കപ്പെടുന്നു — 1:1-3:27</para>
  <para style="io1">2. യെരൂശലേമിനും, ദൈവാലയത്തിനും, യെഹൂദാക്കും വിരോധമായ പ്രവചനം — 4:1-24:27</para>
  <para style="io1">3. രാജ്യങ്ങളെപ്പറ്റിയുള്ള പ്രവചനങ്ങൾ — 25:1-32:32</para>
  <para style="io1">4. യിസ്രായേലിനെ സംബന്ധിച്ചുള്ള പ്രവചനങ്ങൾ — 33:1-39:29</para>
  <para style="io1">5. പുനഃസ്ഥാപനത്തിൻ്റെ ദർശനം — 40:1-48:35</para>
  <chapter number="1" style="c" sid="EZK 1" />
  <para style="s">നാലു ജീവികളുടെ ദർശനം</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 1:1" />എന്‍റെ ആയുസിന്‍റെ മുപ്പതാം ആണ്ട് നാലാംമാസം അഞ്ചാം തീയതി ഞാൻ കെബാർനദീതീരത്ത് പ്രവാസികളുടെ ഇടയിൽ ഇരിക്കുമ്പോൾ, സ്വർഗ്ഗം തുറക്കപ്പെട്ടു; ഞാൻ ദിവ്യദർശനങ്ങൾ കണ്ടു. <verse eid="EZK 1:1" /><verse number="2" style="v" sid="EZK 1:2" />യെഹോയാഖീൻ രാജാവിൻ്റെ പ്രവാസത്തിന്‍റെ അഞ്ചാം ആണ്ടിൽ നാലാംമാസം അഞ്ചാം തീയതി തന്നെ, <verse eid="EZK 1:2" /><verse number="3" style="v" sid="EZK 1:3" />കല്ദയദേശത്ത് കെബാർനദീതീരത്തുവച്ച് ബൂസിയുടെ മകൻ യെഹെസ്കേൽ പുരോഹിതന് യഹോവയുടെ അരുളപ്പാടു ഉണ്ടായി; അവിടെ യഹോവയുടെ കരവും അവന്‍റെമേൽ ഉണ്ടായിരുന്നു.<verse eid="EZK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 1:4" />ഞാൻ നോക്കിയപ്പോൾ വടക്കുനിന്ന് ഒരു കൊടുങ്കാറ്റും ഒരു വലിയ മേഘവും ആളിക്കത്തുന്ന തീയും വരുന്നത് കണ്ടു; അതിന്‍റെ ചുറ്റും ഒരു പ്രകാശവും അതിന്‍റെ നടുവിൽനിന്ന്, തീയുടെ നടുവിൽനിന്നു തന്നെ, ശുക്ലസ്വർണ്ണംപോലെ ഒരു കാഴ്ചയും ഉണ്ടായിരുന്നു. <verse eid="EZK 1:4" /><verse number="5" style="v" sid="EZK 1:5" />അതിന്‍റെ നടുവിൽ നാലു ജീവികളുടെ രൂപസാദൃശ്യം കണ്ടു; അവയുടെ രൂപത്തിന് മനുഷ്യസാദൃശ്യം ഉണ്ടായിരുന്നു. <verse eid="EZK 1:5" /><verse number="6" style="v" sid="EZK 1:6" />ഓരോന്നിന് നാലു മുഖവും നാലു ചിറകും വീതം ഉണ്ടായിരുന്നു. <verse eid="EZK 1:6" /><verse number="7" style="v" sid="EZK 1:7" />അവയുടെ കാൽ നിവർന്നതും, പാദങ്ങൾ കാളക്കിടാവിൻ്റെ കുളമ്പുപോലെയും ആയിരുന്നു; മിനുക്കിയ താമ്രംപോലെ അവ മിന്നിക്കൊണ്ടിരുന്നു. <verse eid="EZK 1:7" /><verse number="8" style="v" sid="EZK 1:8" />അവയ്ക്കു നാലു ഭാഗത്തും ചിറകിന്‍റെ കീഴിലായി മനുഷ്യന്‍റെ കൈകൾ ഉണ്ടായിരുന്നു; നാലിനും മുഖങ്ങളും ചിറകുകളും ഇപ്രകാരം ആയിരുന്നു. <verse eid="EZK 1:8" /><verse number="9" style="v" sid="EZK 1:9" />അവയുടെ ചിറകുകൾ പരസ്പരം തൊട്ടിരുന്നു; പോകുമ്പോൾ അവ തിരിയാതെ ഓരോന്നും നേരെ മുമ്പോട്ടു പോകും.<verse eid="EZK 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 1:10" />അവയുടെ മുഖരൂപമോ: അവയ്ക്കു മനുഷ്യമുഖം ഉണ്ടായിരുന്നു; നാലിനും വലത്തുഭാഗത്ത് സിംഹമുഖവും ഇടത്തുഭാഗത്ത് കാളമുഖവും ഉണ്ടായിരുന്നു; നാലിനും കഴുകുമുഖവും ഉണ്ടായിരുന്നു. <verse eid="EZK 1:10" /><verse number="11" style="v" sid="EZK 1:11" />ഇങ്ങനെയായിരുന്നു അവയുടെ മുഖങ്ങൾ; അവയുടെ ചിറകുകൾ മേൽഭാഗം വിടർന്നിരുന്നു; ഈ രണ്ടു ചിറകുകൾ തമ്മിൽ സ്പർശിച്ചും ഈ രണ്ടു ചിറകുകൾകൊണ്ട് ശരീരം മറച്ചും ഇരുന്നു. <verse eid="EZK 1:11" /><verse number="12" style="v" sid="EZK 1:12" />അവ ഓരോന്നും നേരെ മുമ്പോട്ടു പോകും; പോകുമ്പോൾ അവ തിരിയാതെ ആത്മാവിനു പോകേണ്ട സ്ഥലത്തേക്ക് തന്നെ പോകും.<verse eid="EZK 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 1:13" />ജീവികളുടെ നടുവിൽ കത്തിക്കൊണ്ടിരിക്കുന്ന തീക്കനൽപോലെയും പന്തങ്ങൾ പോലെയും ഒരു കാഴ്ച ഉണ്ടായിരുന്നു; അത് ജീവികളുടെ ഇടയിൽ സഞ്ചരിച്ചുകൊണ്ടിരുന്നു; ആ തീ തേജസ്സുള്ളതായിരുന്നു. തീയിൽനിന്ന് മിന്നൽ പുറപ്പെട്ടുകൊണ്ടിരുന്നു. <verse eid="EZK 1:13" /><verse number="14" style="v" sid="EZK 1:14" />ജീവികൾ മിന്നൽപോലെ അങ്ങോട്ടും ഇങ്ങോട്ടും ഓടിക്കൊണ്ടിരുന്നു.<verse eid="EZK 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 1:15" />ഞാൻ ജീവികളെ നോക്കിയപ്പോൾ നിലത്ത് ജീവികളുടെ അരികിൽ നാലു മുഖത്തിനും നേരെ ഓരോ ചക്രം കണ്ടു. <verse eid="EZK 1:15" /><verse number="16" style="v" sid="EZK 1:16" />ചക്രങ്ങളുടെ കാഴ്ചയും പണിയും പുഷ്പരാഗത്തിൻ്റെ കാഴ്ചപോലെ ആയിരുന്നു; അവയ്ക്കു നാലിനും ഒരേ ആകൃതി ആയിരുന്നു; അവയുടെ കാഴ്ചയും പണിയും ചക്രത്തിൽകൂടി മറ്റൊരു ചക്രം ഉള്ളതുപോലെ ആയിരുന്നു. <verse eid="EZK 1:16" /><verse number="17" style="v" sid="EZK 1:17" />അവയ്ക്കു നാലുഭാഗത്തേക്കും പോകാം; തിരിയുവാൻ ആവശ്യമില്ല. <verse eid="EZK 1:17" /><verse number="18" style="v" sid="EZK 1:18" />അവയുടെ പട്ട പൊക്കമേറിയതും ഭയങ്കരവും ആയിരുന്നു; നാലിൻ്റെയും പട്ടകൾക്കു ചുറ്റും അടുത്തടുത്ത് കണ്ണുണ്ടായിരുന്നു.<verse eid="EZK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 1:19" />ജീവികൾ പോകുമ്പോൾ ചക്രങ്ങളും ഒപ്പം പോകും; ജീവികൾ ഭൂമിയിൽനിന്നു പൊങ്ങുമ്പോൾ ചക്രങ്ങളും പൊങ്ങും. <verse eid="EZK 1:19" /><verse number="20" style="v" sid="EZK 1:20" />ആത്മാവിനു പോകേണ്ട സ്ഥലത്തെല്ലാം അവ പോകും; ജീവികളുടെ ആത്മാവ് ചക്രങ്ങളിൽ ആയിരുന്നതുകൊണ്ട് ചക്രങ്ങൾ അവയോടുകൂടി പൊങ്ങും. <verse eid="EZK 1:20" /><verse number="21" style="v" sid="EZK 1:21" />ജീവികളുടെ ആത്മാവ് ചക്രങ്ങളിൽ ആയിരുന്നതുകൊണ്ട്, അവ പോകുമ്പോൾ ഇവയും പോകും; അവ നില്ക്കുമ്പോൾ ഇവയും നില്ക്കും; അവ ഭൂമിയിൽനിന്നു പൊങ്ങുമ്പോൾ ചക്രങ്ങളും അവയോടുകൂടി പൊങ്ങും.<verse eid="EZK 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 1:22" />ജീവികളുടെ തലയ്ക്കുമീതെ ഭയങ്കരമായ, പളുങ്കുപോലെയുള്ള ഒരു വിതാനത്തിൻ്റെ രൂപം ഉണ്ടായിരുന്നു; അത് അവയുടെ തലയ്ക്കുമീതെ വിരിഞ്ഞിരുന്നു. <verse eid="EZK 1:22" /><verse number="23" style="v" sid="EZK 1:23" />വിതാനത്തിൻ്റെ കീഴിൽ അവയുടെ ചിറകുകൾ നേർക്കുനേരെ വിടർന്നിരുന്നു; ഓരോ ജീവിക്കും ശരീരത്തിന്‍റെ ഇരുഭാഗവും മൂടുവാൻ ഈരണ്ടു ചിറകുകൾ വീതം ഉണ്ടായിരുന്നു. <verse eid="EZK 1:23" /><verse number="24" style="v" sid="EZK 1:24" />അവ പോകുമ്പോൾ ചിറകുകളുടെ ശബ്ദം പെരുവെള്ളത്തിന്‍റെ ശബ്ദംപോലെയും സർവ്വശക്തനായ ദൈവത്തിന്‍റെ നാദംപോലെയും ഒരു സൈന്യത്തിന്‍റെ ആരവം പോലെയും ഉള്ള മുഴക്കമായി ഞാൻ കേട്ടു; നില്ക്കുമ്പോൾ അവ ചിറകു താഴ്ത്തും. <verse eid="EZK 1:24" /><verse number="25" style="v" sid="EZK 1:25" />അവയുടെ തലയ്ക്കു മീതെയുള്ള വിതാനത്തിനു മുകളിൽനിന്ന് ഒരു നാദം പുറപ്പെട്ടു; നില്ക്കുമ്പോൾ അവ ചിറകു താഴ്ത്തും.<verse eid="EZK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 1:26" />അവയുടെ തലയ്ക്കു മീതെയുള്ള വിതാനത്തിനു മീതെ നീലക്കല്ലിൻ്റെ കാഴ്ചപോലെ സിംഹാസനത്തിന്‍റെ രൂപവും സിംഹാസനത്തിന്‍റെ രൂപത്തിന്മേൽ അതിന് മീതെ മനുഷ്യസാദൃശ്യത്തിൽ ഒരു രൂപവും ഉണ്ടായിരുന്നു. <verse eid="EZK 1:26" /><verse number="27" style="v" sid="EZK 1:27" />അവിടുത്തെ അരമുതൽ മേലോട്ടുള്ള ഭാഗം തീ നിറമുള്ള ശുക്ലസ്വർണ്ണംപോലെ ഞാൻ കണ്ടു; അവിടുത്തെ അരമുതൽ കീഴോട്ട് തീപോലെ ഞാൻ കണ്ടു; അതിന്‍റെ ചുറ്റും പ്രകാശവും ഉണ്ടായിരുന്നു. <verse eid="EZK 1:27" /><verse number="28" style="v" sid="EZK 1:28" />അതിന്‍റെ ചുറ്റുമുള്ള പ്രകാശം മഴയുള്ള ദിവസത്തിൽ മേഘത്തിൽ കാണുന്ന വില്ലിൻ്റെ കാഴ്ചപോലെ ആയിരുന്നു. യഹോവയുടെ മഹത്വത്തിന്‍റെ പ്രത്യക്ഷത ഇങ്ങനെ ആയിരുന്നു കണ്ടത്; അത് കണ്ടിട്ട് ഞാൻ കവിണ്ണുവീണു; സംസാരിക്കുന്ന ഒരുവന്‍റെ ശബ്ദവും ഞാൻ കേട്ടു.<verse eid="EZK 1:28" /></para>
  <chapter eid="EZK 1" />
  <chapter number="2" style="c" sid="EZK 2" />
  <para style="s">യെഹെസ്കേൽ പ്രവാചകനായി നിയോഗിക്കപ്പെടുന്നു</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 2:1" />അവിടുന്ന് എന്നോട്: “മനുഷ്യപുത്രാ, നിവർന്നുനില്‍ക്കുക; ഞാൻ നിന്നോട് സംസാരിക്കും” എന്നു കല്പിച്ചു. <verse eid="EZK 2:1" /><verse number="2" style="v" sid="EZK 2:2" />അവിടുന്ന് എന്നോട് സംസാരിച്ചപ്പോൾ ദൈവത്തിന്‍റെ ആത്മാവ് എന്നിൽ വന്നു, എന്നെ നിവർന്നുനില്‍ക്കുമാറാക്കി; യഹോവ എന്നോട് സംസാരിക്കുന്നത് ഞാൻ കേട്ടു. <verse eid="EZK 2:2" /><verse number="3" style="v" sid="EZK 2:3" />അവിടുന്ന് എന്നോട് അരുളിച്ചെയ്തത്: “മനുഷ്യപുത്രാ, എന്നോട് മത്സരിച്ചിരിക്കുന്ന മത്സരികളായ യിസ്രായേൽ മക്കളുടെ അടുക്കൽ ഞാൻ നിന്നെ അയയ്ക്കുന്നു; അവരും അവരുടെ പിതാക്കന്മാരും ഇന്നുവരെ എന്നോട് അതിക്രമം ചെയ്തിരിക്കുന്നു. <verse eid="EZK 2:3" /><verse number="4" style="v" sid="EZK 2:4" />മക്കളോ ധാർഷ്ട്യവും ദുശ്ശാഠ്യവും ഉള്ളവരത്രെ; അവരുടെ അടുക്കലാകുന്നു ഞാൻ നിന്നെ അയയ്ക്കുന്നത്.” യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു എന്നു നീ അവരോടു പറയേണം. <verse eid="EZK 2:4" /><verse number="5" style="v" sid="EZK 2:5" />കേട്ടാലും കേൾക്കാഞ്ഞാലും - അവർ മത്സരഗൃഹമാണല്ലോ - അവരുടെ ഇടയിൽ ഒരു പ്രവാചകൻ ഉണ്ടായിരുന്നു എന്നു അവർ അറിയേണം.<verse eid="EZK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 2:6" />“നീയോ, മനുഷ്യപുത്രാ, അവരെ പേടിക്കരുത്; പറക്കാരയും മുള്ളും നിന്‍റെ അരികിൽ ഉണ്ടായിരുന്നാലും, തേളുകളുടെ ഇടയിൽ നീ വസിച്ചാലും അവരുടെ വാക്ക് പേടിക്കരുത്; അവർ മത്സരഗൃഹമല്ലോ; നീ അവരുടെ വാക്ക് പേടിക്കരുത്; അവരുടെ നോട്ടം കണ്ടു ഭ്രമിക്കുകയുമരുത്. <verse eid="EZK 2:6" /><verse number="7" style="v" sid="EZK 2:7" />അവർ കേട്ടാലും കേൾക്കാഞ്ഞാലും നീ എന്‍റെ വചനങ്ങൾ അവരോടു പ്രസ്താവിക്കേണം; അവർ മഹാമത്സരികൾ അല്ലയോ. <verse eid="EZK 2:7" /><verse number="8" style="v" sid="EZK 2:8" />നീയോ, മനുഷ്യപുത്രാ, ഞാൻ നിന്നോട് സംസാരിക്കുന്നത് കേൾക്കുക; നീ ആ മത്സരഗൃഹംപോലെ മത്സരക്കാരനായിരിക്കരുത്; ഞാൻ നിനക്കു തരുന്നത് നീ വായ് തുറന്നു തിന്നുക.“<verse eid="EZK 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 2:9" />ഞാൻ നോക്കിയപ്പോൾ: ഒരു കൈ എന്നിലേക്കു നീട്ടിയിരിക്കുന്നതും അതിൽ ഒരു പുസ്തകച്ചുരുൾ ഇരിക്കുന്നതും കണ്ടു. <verse eid="EZK 2:9" /><verse number="10" style="v" sid="EZK 2:10" />അവൻ അത് എന്‍റെ മുമ്പിൽ വിടർത്തി: അതിൽ അകത്തും പുറത്തും എഴുത്തുണ്ടായിരുന്നു; വിലാപങ്ങളും സങ്കടവും കഷ്ടവും അതിൽ എഴുതിയിരുന്നു.<verse eid="EZK 2:10" /></para>
  <chapter eid="EZK 2" />
  <chapter number="3" style="c" sid="EZK 3" />
  <para style="p">
    <verse number="1" style="v" sid="EZK 3:1" />അവിടുന്ന് എന്നോട്: “മനുഷ്യപുത്രാ, നീ കാണുന്നതു തിന്നുക: ഈ ചുരുൾ തിന്നശേഷം ചെന്നു യിസ്രായേൽ ഗൃഹത്തോട് സംസാരിക്കുക” എന്നു കല്പിച്ചു. <verse eid="EZK 3:1" /><verse number="2" style="v" sid="EZK 3:2" />ഞാൻ വായ് തുറന്നു; അവിടുന്ന് ആ ചുരുൾ എനിക്ക് തിന്നുവാൻ തന്ന് എന്നോട്: <verse eid="EZK 3:2" /><verse number="3" style="v" sid="EZK 3:3" />“മനുഷ്യപുത്രാ, ഞാൻ നിനക്കു തരുന്ന ഈ ചുരുൾ നീ വയറ്റിൽ ആക്കി ഉദരം നിറയ്ക്കുക” എന്നു കല്പിച്ചു; അങ്ങനെ ഞാൻ അത് തിന്നു; അത് വായിൽ തേൻപോലെ മധുരമായിരുന്നു.<verse eid="EZK 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 3:4" />പിന്നെ അവിടുന്ന് എന്നോട് കല്പിച്ചത്: “മനുഷ്യപുത്രാ, നീ യിസ്രായേൽ ഗൃഹത്തിന്‍റെ അടുക്കൽ ചെന്നു എന്‍റെ വചനങ്ങൾ അവരോടു പ്രസ്താവിക്കുക. <verse eid="EZK 3:4" /><verse number="5" style="v" sid="EZK 3:5" />അവ്യക്തവാക്കും കടുത്ത ഭാഷയും ഉള്ള ജനതയുടെ അടുക്കൽ അല്ല, യിസ്രായേൽ ഗൃഹത്തിന്‍റെ അടുക്കലേക്കാകുന്നു നിന്നെ അയയ്ക്കുന്നത്; <verse eid="EZK 3:5" /><verse number="6" style="v" sid="EZK 3:6" />അവ്യക്തവാക്കും കടുത്ത ഭാഷയും ഉള്ളവരും, നിനക്കു വാക്ക് ഗ്രഹിച്ചുകൂടാത്തവരുമായ അനേകം ജനതകളുടെ അടുക്കലേക്കല്ല; അവരുടെ അടുക്കൽ ഞാൻ നിന്നെ അയച്ചെങ്കിൽ അവർ നിന്‍റെ വാക്ക് കേൾക്കുമായിരുന്നു. <verse eid="EZK 3:6" /><verse number="7" style="v" sid="EZK 3:7" />യിസ്രായേൽഗൃഹമോ നിന്‍റെ വാക്ക് കേൾക്കുകയില്ല; എന്‍റെ വാക്ക് കേൾക്കുവാൻ അവർക്ക് മനസ്സില്ലല്ലോ; യിസ്രായേൽഗൃഹമെല്ലാം ദുശ്ശാഠ്യവും കഠിനഹൃദയവും ഉള്ളവരാകുന്നു. <verse eid="EZK 3:7" /><verse number="8" style="v" sid="EZK 3:8" />എന്നാൽ ഞാൻ നിന്‍റെ മുഖം അവരുടെ മുഖത്തിനുനേരെ കഠിനവും നിന്‍റെ നെറ്റി അവരുടെ നെറ്റിക്കു നേരെ കടുപ്പവും ആക്കിയിരിക്കുന്നു. <verse eid="EZK 3:8" /><verse number="9" style="v" sid="EZK 3:9" />ഞാൻ നിന്‍റെ നെറ്റി തീക്കല്ലിനെക്കാൾ കടുപ്പമുള്ള വജ്രംപോലെ ആക്കിയിരിക്കുന്നു; അവർ മത്സരഗൃഹമെങ്കിലും നീ അവരെ പേടിക്കരുത്; അവരുടെ നോട്ടം കണ്ടു ഭ്രമിക്കുകയുമരുത്.” <verse eid="EZK 3:9" /><verse number="10" style="v" sid="EZK 3:10" />യഹോവ പിന്നെയും എന്നോട് കല്പിച്ചത്: “മനുഷ്യപുത്രാ, ഞാൻ നിന്നോട് സംസാരിക്കുന്ന വചനങ്ങളെല്ലാം ചെവികൊണ്ട് കേട്ടു ഹൃദയത്തിൽ കൈക്കൊള്ളുക. <verse eid="EZK 3:10" /><verse number="11" style="v" sid="EZK 3:11" />നീ നിന്‍റെ ജനത്തിന്‍റെ പുത്രന്മാരായ പ്രവാസികളുടെ അടുക്കൽ ചെന്നു, അവർ കേട്ടാലും കേൾക്കാഞ്ഞാലും അവരോടു സംസാരിച്ച്: ‘യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു’ എന്നു പറയുക.”<verse eid="EZK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 3:12" />അപ്പോൾ ദൈവത്തിന്‍റെ ആത്മാവ് എന്നെ എടുത്തു: “യഹോവയുടെ മഹത്വം സ്വസ്ഥാനത്ത് അനുഗ്രഹിക്കപ്പെടുമാറാകട്ടെ” എന്നു ഞാൻ വലിയ മുഴക്കത്തോടെ ഒരു ശബ്ദം എന്‍റെ പിമ്പിൽ കേട്ടു. <verse eid="EZK 3:12" /><verse number="13" style="v" sid="EZK 3:13" />ജീവികളുടെ ചിറകുകൾ തമ്മിൽ തട്ടുന്ന ശബ്ദവും അവയുടെ അരികിലുള്ള ചക്രങ്ങളുടെ ശബ്ദവും വലിയ മുഴക്കമുള്ള ഒരു ശബ്ദവും ഞാൻ കേട്ടു. <verse eid="EZK 3:13" /><verse number="14" style="v" sid="EZK 3:14" />ദൈവത്തിന്‍റെ ആത്മാവ് എന്നെ എടുത്തുകൊണ്ടുപോയി; ഞാൻ വ്യസനത്തോടും മനസ്സിന്‍റെ തീക്ഷ്ണതയോടും കൂടെ പോയി; യഹോവയുടെ കൈ ശക്തിയോടെ എന്‍റെ മേൽ ഉണ്ടായിരുന്നു. <verse eid="EZK 3:14" /><verse number="15" style="v" sid="EZK 3:15" />അങ്ങനെ ഞാൻ കെബാർനദീതീരത്ത് താമസിച്ച തേൽ-ആബീബിലെ പ്രവാസികളുടെ അടുക്കൽ, അവർ വസിച്ചിരുന്ന സ്ഥലത്തുതന്നെ എത്തി, അവരുടെ മദ്ധ്യത്തിൽ ഏഴു ദിവസം സ്തബ്ധനായി താമസിച്ചു.<verse eid="EZK 3:15" /></para>
  <para style="s">കാവല്‌ക്കാരനായി നിയമിക്കുന്നു</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 3:16" />ഏഴു ദിവസം കഴിഞ്ഞിട്ട് യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ: <verse eid="EZK 3:16" /><verse number="17" style="v" sid="EZK 3:17" />“മനുഷ്യപുത്രാ, ഞാൻ നിന്നെ യിസ്രായേൽ ഗൃഹത്തിനു കാവല്ക്കാരനാക്കി വച്ചിരിക്കുന്നു; നീ എന്‍റെ വായിൽനിന്ന് വചനം കേട്ടു എന്‍റെ നാമത്തിൽ അവരെ പ്രബോധിപ്പിക്കണം. <verse eid="EZK 3:17" /><verse number="18" style="v" sid="EZK 3:18" />ഞാൻ ദുഷ്ടനോട്: ‘നീ മരിക്കും’ എന്നു കല്പിക്കുമ്പോൾ നീ അവനെ ഓർമ്മിപ്പിക്കുകയോ, ദുഷ്ടൻ ജീവരക്ഷ പ്രാപിക്കേണ്ടതിന് അവൻ തന്‍റെ ദുർമ്മാർഗ്ഗം ഉപേക്ഷിക്കുവാൻ അവനെ ഓർമ്മിപ്പിച്ചുകൊണ്ട് ഒന്നും പറയുകയോ ചെയ്യാതിരുന്നാൽ, ദുഷ്ടൻ തന്‍റെ അകൃത്യത്തിൽ മരിക്കും; അവന്‍റെ രക്തം ഞാൻ നിന്നോട് ചോദിക്കും. <verse eid="EZK 3:18" /><verse number="19" style="v" sid="EZK 3:19" />എന്നാൽ നീ ദുഷ്ടനെ ഓർമ്മിപ്പിച്ചിട്ടും അവൻ തന്‍റെ ദുഷ്ടതയും ദുർമ്മാർഗ്ഗവും വിട്ടുതിരിയുന്നില്ലെങ്കിൽ അവൻ തന്‍റെ അകൃത്യത്തിൽ മരിക്കും; നീയോ നിന്‍റെ പ്രാണനെ രക്ഷിച്ചിരിക്കുന്നു. <verse eid="EZK 3:19" /><verse number="20" style="v" sid="EZK 3:20" />അഥവാ, നീതിമാൻ തന്‍റെ നീതി വിട്ടുമാറി നീതികേട് പ്രവർത്തിച്ചിട്ടു ഞാൻ അവന്‍റെ മുമ്പിൽ ഇടർച്ച വയ്ക്കുന്നുവെങ്കിൽ അവൻ മരിക്കും; നീ അവനെ ഓർമ്മിപ്പിക്കായ്കകൊണ്ട് അവൻ തന്‍റെ പാപത്തിൽ മരിക്കും; അവൻ ചെയ്ത നീതി അവന് കണക്കിടുകയുമില്ല; അവന്‍റെ രക്തം ഞാൻ നിന്നോട് ചോദിക്കും. <verse eid="EZK 3:20" /><verse number="21" style="v" sid="EZK 3:21" />എന്നാൽ നീതിമാൻ പാപം ചെയ്യാതെയിരിക്കേണ്ടതിന് നീ നീതിമാനെ ഓർമ്മിപ്പിച്ചിട്ട് അവൻ പാപം ചെയ്യാതെ ഇരുന്നാൽ, അവൻ പ്രബോധനം കൈക്കൊണ്ടിരിക്കുകയാൽ അവൻ ജീവിക്കും; നീയും നിന്‍റെ പ്രാണനെ രക്ഷിച്ചിരിക്കുന്നു.”<verse eid="EZK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 3:22" />യഹോവയുടെ കൈ അവിടെ പിന്നെയും എന്‍റെ മേൽ വന്നു; അവിടുന്ന് എന്നോട്: “നീ എഴുന്നേറ്റ് സമഭൂമിയിലേക്കു പോകുക; അവിടെവച്ച് ഞാൻ നിന്നോട് സംസാരിക്കും” എന്നു കല്പിച്ചു. <verse eid="EZK 3:22" /><verse number="23" style="v" sid="EZK 3:23" />അങ്ങനെ ഞാൻ എഴുന്നേറ്റ് സമഭൂമിയിലേക്കു പോയി; ഞാൻ കെബാർനദീതീരത്തു കണ്ട മഹത്വംപോലെ അവിടെ യഹോവയുടെ മഹത്വം നില്ക്കുന്നതു കണ്ടു, ഞാൻ കവിണ്ണുവീണു. <verse eid="EZK 3:23" /><verse number="24" style="v" sid="EZK 3:24" />അപ്പോൾ ദൈവത്തിന്‍റെ ആത്മാവ് എന്നിൽ വന്ന് എന്നെ നിവർന്നുനില്‍ക്കുമാറാക്കി, എന്നോട് സംസാരിച്ചു: “നീ ചെന്നു നിന്‍റെ വീടിനകത്ത് കതകടച്ചു താമസിക്കുക. <verse eid="EZK 3:24" /><verse number="25" style="v" sid="EZK 3:25" />എന്നാൽ മനുഷ്യപുത്രാ, നിനക്കു അവരുടെ ഇടയിൽ പോകുവാൻ കഴിയാത്തവിധം അവർ നിന്നെ കയറുകൊണ്ട് കെട്ടും. <verse eid="EZK 3:25" /><verse number="26" style="v" sid="EZK 3:26" />നീ ഊമനായി അവരെ ശാസിക്കാതെയിരിക്കേണ്ടതിന് ഞാൻ നിന്‍റെ നാവിനെ നിന്‍റെ അണ്ണാക്കോടു പറ്റുമാറാക്കും; അവർ മത്സരഗൃഹമാണല്ലോ. <verse eid="EZK 3:26" /><verse number="27" style="v" sid="EZK 3:27" />ഞാൻ നിന്നോട് സംസാരിക്കുമ്പോൾ ഞാൻ നിന്‍റെ വായ് തുറക്കും; നീ അവരോട്: “യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു” എന്നു പറയേണം; കേൾക്കുന്നവൻ കേൾക്കട്ടെ; കേൾക്കാത്തവൻ കേൾക്കാതെ ഇരിക്കട്ടെ; അവർ മത്സരഗൃഹമാണല്ലോ.”<verse eid="EZK 3:27" /></para>
  <chapter eid="EZK 3" />
  <chapter number="4" style="c" sid="EZK 4" />
  <para style="s">ഉപരോധത്തിൻ്റെയും പ്രവാസത്തിൻ്റെയും പ്രതീകങ്ങൾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 4:1" />“മനുഷ്യപുത്രാ, നീ ഒരു ഇഷ്ടിക എടുത്ത് നിന്‍റെ മുമ്പിൽവച്ച്, അതിൽ യെരൂശലേം നഗരം വരച്ച്, അതിനെ ഉപരോധിച്ച്, <verse eid="EZK 4:1" /><verse number="2" style="v" sid="EZK 4:2" />അതിന്‍റെ നേരെ കോട്ട പണിത് മൺതിട്ട ഉണ്ടാക്കി പാളയം അടിച്ച് ചുറ്റും യന്ത്രമുട്ടികൾ വെക്കുക. <verse eid="EZK 4:2" /><verse number="3" style="v" sid="EZK 4:3" />പിന്നെ ഒരു ഇരുമ്പുചട്ടി എടുത്ത് നിനക്കും നഗരത്തിനും മദ്ധ്യത്തിൽ ഇരിമ്പുമതിലായി വെക്കുക; നിന്‍റെ മുഖം അതിന്‍റെ നേരെ വച്ചു, അത് ഉപരോധത്തിൽ ആകേണ്ടതിന് അതിനെ നിരോധിക്കുക; ഇത് യിസ്രായേൽഗൃഹത്തിന് ഒരു അടയാളം ആയിരിക്കട്ടെ.<verse eid="EZK 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 4:4" />പിന്നെ നീ ഇടത്തുവശം ചരിഞ്ഞുകിടന്ന് യിസ്രായേൽ ഗൃഹത്തിന്‍റെ അകൃത്യം അതിന്മേൽ ചുമത്തുക; നീ അങ്ങനെ കിടക്കുന്ന ദിവസങ്ങളുടെ എണ്ണത്തോളം അവരുടെ അകൃത്യം വഹിക്കേണം. <verse eid="EZK 4:4" /><verse number="5" style="v" sid="EZK 4:5" />ഞാൻ അവരുടെ അകൃത്യത്തിൻ്റെ വർഷങ്ങളെ നിനക്കു ദിവസങ്ങളായി എണ്ണും; അങ്ങനെ മുന്നൂറ്റിത്തൊണ്ണൂറു (390) ദിവസങ്ങൾ നീ യിസ്രായേൽ ഗൃഹത്തിന്‍റെ അകൃത്യം വഹിക്കേണം. <verse eid="EZK 4:5" /><verse number="6" style="v" sid="EZK 4:6" />ഇത് തികച്ചശേഷം നീ വലത്തുവശം ചരിഞ്ഞുകിടന്ന് യെഹൂദാഗൃഹത്തിന്‍റെ അകൃത്യം നാല്പതു (40) ദിവസം വഹിക്കേണം; ഒരു വർഷത്തിന് ഒരു ദിവസംവീതം ഞാൻ നിനക്കു നിയമിച്ചിരിക്കുന്നു.<verse eid="EZK 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 4:7" />നീ യെരൂശലേമിന്‍റെ ഉപരോധത്തിനുനേരെ നിന്‍റെ മുഖവും നഗ്നമായ ഭുജവും വച്ചു അതിന് വിരോധമായി പ്രവചിക്കേണം. <verse eid="EZK 4:7" /><verse number="8" style="v" sid="EZK 4:8" />നിന്‍റെ ഉപരോധകാലം തികയുവോളം നീ ഒരു വശത്തുനിന്ന് മറുവശത്തേക്കു തിരിയാതെ ഇരിക്കേണ്ടതിന് ഞാൻ ഇതാ, കയറുകൊണ്ട് നിന്നെ കെട്ടുന്നു.<verse eid="EZK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 4:9" />നീ ഗോതമ്പും യവവും അമരയും ചെറുപയറും തിനയും ചോളവും എടുത്ത് ഒരു പാത്രത്തിൽ ഇട്ടു അവ കൊണ്ടു അപ്പം ഉണ്ടാക്കുക; നീ വശം ചരിഞ്ഞു കിടക്കുന്ന ദിവസങ്ങളുടെ എണ്ണത്തിനൊത്തവണ്ണം മുന്നൂറ്റിതൊണ്ണൂറു (390) ദിവസം അതു തിന്നേണം. <verse eid="EZK 4:9" /><verse number="10" style="v" sid="EZK 4:10" />നീ ഭക്ഷിക്കുന്ന ആഹാരം ഒരു ദിവസത്തേക്ക് ഇരുപതു (20) ശേക്കൽ തൂക്കമായിരിക്കേണം; നേരത്തോടുനേരം നീ അതുകൊണ്ട് ഉപജീവിച്ചുകൊള്ളേണം. <verse eid="EZK 4:10" /><verse number="11" style="v" sid="EZK 4:11" />ഒരു ഹീനിൻ്റെ ആറിൽ ഒരു ഭാഗം വെള്ളവും നീ കുടിക്കേണം; നേരത്തോടുനേരം നീ അത് കുടിക്കേണം. <verse eid="EZK 4:11" /><verse number="12" style="v" sid="EZK 4:12" />നീ അത് യവദോശപോലെ തിന്നേണം; അവരുടെ മുമ്പിൽ നീ മാനുഷമലം കത്തിച്ച് അത് ചുടേണം. <verse eid="EZK 4:12" /><verse number="13" style="v" sid="EZK 4:13" />ഇങ്ങനെതന്നെ യിസ്രായേൽ മക്കൾ, ഞാൻ അവരെ നീക്കിക്കളയുന്ന ജനതകളുടെ ഇടയിൽ അവരുടെ ആഹാരം മലിനമായി ഭക്ഷിക്കും” എന്നു യഹോവ അരുളിച്ചെയ്തു.<verse eid="EZK 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 4:14" />അതിന് ഞാൻ: “അയ്യോ, യഹോവയായ കർത്താവേ, എനിക്ക് ഒരിക്കലും ഒരു മാലിന്യവും ഭവിച്ചിട്ടില്ല; ഞാൻ ബാല്യം മുതൽ ഇന്നുവരെ തനിയെ ചത്തതിനെയോ പറിച്ചുകീറിപ്പോയതിനെയോ തിന്നിട്ടില്ല; അറപ്പായുള്ള മാംസം എന്‍റെ വായിൽ വച്ചിട്ടുമില്ല” എന്നു പറഞ്ഞു.<verse eid="EZK 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 4:15" />അവിടുന്ന് എന്നോട്: “നോക്കുക മാനുഷമലത്തിനു പകരം ഞാൻ നിനക്കു പശുവിൻചാണകം അനുവദിക്കുന്നു; അത് കത്തിച്ച് നിന്‍റെ അപ്പം ചുട്ടുകൊള്ളുക” എന്നു കല്പിച്ചു. <verse eid="EZK 4:15" /><verse number="16" style="v" sid="EZK 4:16" />“മനുഷ്യപുത്രാ, അവർക്ക് അപ്പവും വെള്ളവും ഇല്ലാതാകേണ്ടതിനും ഓരോരുത്തൻ സ്തംഭിച്ച് അകൃത്യം നിമിത്തം ക്ഷയിച്ചുപോകേണ്ടതിനും <verse eid="EZK 4:16" /><verse number="17" style="v" sid="EZK 4:17" />ഞാൻ യെരൂശലേമിൽ അപ്പം എന്ന കോൽ ഒടിച്ചുകളയും; അവർ തൂക്കപ്രകാരവും ഭയത്തോടെയും അപ്പം തിന്നും; അവർ അളവു പ്രകാരവും സ്തംഭനത്തോടെയും വെള്ളം കുടിക്കും” എന്നു അവിടുന്ന് എന്നോട് അരുളിച്ചെയ്തു.<verse eid="EZK 4:17" /></para>
  <chapter eid="EZK 4" />
  <chapter number="5" style="c" sid="EZK 5" />
  <para style="s">ദൈവത്തിന്‍റെ ന്യായവിധിയുടെ അടയാളം</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 5:1" />മനുഷ്യപുത്രാ, നീ മൂർച്ചയുള്ള ഒരു വാൾ എടുത്ത് ക്ഷൗരക്കത്തിയായി ഉപയോഗിച്ച് നിന്‍റെ തലയും താടിയും ക്ഷൗരം ചെയ്യുക; പിന്നെ തുലാസ്സ് എടുത്ത് ആ രോമം തൂക്കി വിഭജിക്കുക. <verse eid="EZK 5:1" /><verse number="2" style="v" sid="EZK 5:2" />ഉപരോധകാലം തികയുമ്പോൾ മൂന്നിൽ ഒന്ന് നീ നഗരത്തിന്‍റെ നടുവിൽ തീയിൽ ഇട്ടു ചുട്ടുകളയേണം; മൂന്നിൽ ഒന്ന് എടുത്ത് അതിന്‍റെ ചുറ്റും വാൾകൊണ്ട് അടിക്കേണം; മൂന്നിൽ ഒന്ന് കാറ്റത്ത് ചിതറിച്ചുകളയേണം; ഊരിപ്പിടിച്ച വാളുമായി ഞാൻ അവയ്ക്കു പിന്നാലെ ചെല്ലും. <verse eid="EZK 5:2" /><verse number="3" style="v" sid="EZK 5:3" />അതിൽനിന്ന് അല്പം നീ എടുത്ത് നിന്‍റെ വസ്ത്രത്തിന്‍റെ അഗ്രത്തു കെട്ടേണം. <verse eid="EZK 5:3" /><verse number="4" style="v" sid="EZK 5:4" />ഇതിൽ നിന്നു പിന്നെയും നീ അല്പം എടുത്ത് തീയിൽ ഇട്ടു ചുട്ടുകളയേണം; അതിൽ നിന്നു യിസ്രായേൽ ഗൃഹത്തിലേക്കെല്ലാം ഒരു തീ പുറപ്പെടും.<verse eid="EZK 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 5:5" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഇത് യെരൂശലേം ആകുന്നു; ഞാൻ അതിനെ ജനതകളുടെ മദ്ധ്യത്തിൽ വച്ചിരിക്കുന്നു; അതിന് ചുറ്റും രാജ്യങ്ങൾ ഉണ്ട് <verse eid="EZK 5:5" /><verse number="6" style="v" sid="EZK 5:6" />അത് ദുഷ്പ്രവൃത്തിയിൽ മറ്റു ജനതകളെക്കാൾ എന്‍റെ ന്യായങ്ങളോടും, ചുറ്റുമുള്ള രാജ്യങ്ങളെക്കാൾ അധികം എന്‍റെ ചട്ടങ്ങളോടും മത്സരിച്ചിരിക്കുന്നു; എന്‍റെ ന്യായങ്ങളെ അവർ തള്ളിക്കളഞ്ഞു; എന്‍റെ ചട്ടങ്ങളെ അവർ അനുസരിച്ചുനടന്നിട്ടുമില്ല.”<verse eid="EZK 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 5:7" />അതുകൊണ്ട് യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “നിങ്ങൾ നിങ്ങളുടെ ചുറ്റുമുള്ള ജനതകളെക്കാൾ അധികം മത്സരിച്ച്, എന്‍റെ ചട്ടങ്ങളെ അനുസരിച്ചുനടക്കാതെയും എന്‍റെ ന്യായങ്ങളെ പ്രമാണിക്കാതെയും ചുറ്റുമുള്ള ജനതകളുടെ ന്യായങ്ങളെപ്പോലും ആചരിക്കാതെയും ഇരിക്കുകകൊണ്ട്, <verse eid="EZK 5:7" /><verse number="8" style="v" sid="EZK 5:8" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: ‘ഇതാ, ഞാൻ, ഞാൻ തന്നെ നിനക്കു വിരോധമായിരിക്കുന്നു; ജനതകൾ കാണത്തക്കവിധം ഞാൻ നിന്‍റെ നടുവിൽ ന്യായവിധികൾ നടത്തും. <verse eid="EZK 5:8" /><verse number="9" style="v" sid="EZK 5:9" />നിന്‍റെ സകല മ്ലേച്ഛതകളും നിമിത്തം, ഞാൻ ഇതുവരെ ചെയ്തിട്ടില്ലാത്തതും, മേലാൽ ചെയ്യാത്തതുമായ കാര്യം നിന്‍റെ മദ്ധ്യത്തിൽ ചെയ്യും. <verse eid="EZK 5:9" /><verse number="10" style="v" sid="EZK 5:10" />ആകയാൽ നിന്‍റെ മദ്ധ്യത്തിൽ അപ്പന്മാർ മക്കളെ തിന്നും; മക്കൾ അപ്പന്മാരെയും തിന്നും; ഞാൻ നിന്നിൽ ന്യായവിധി നടത്തും; നിന്നിലുള്ള ശേഷിപ്പിനെ മുഴുവനും ഞാൻ എല്ലാ കാറ്റുകളിലേക്കും ചിതറിച്ചുകളയും.”<verse eid="EZK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 5:11" />അതുകൊണ്ട് യഹോവയായ കർത്താവ് അരുളിച്ചെയ്യുന്നത്: “നിന്‍റെ എല്ലാ ഹീനപ്രവൃത്തികളാലും സകലമ്ലേച്ഛതകളാലും എന്‍റെ വിശുദ്ധമന്ദിരത്തെ നീ അശുദ്ധമാക്കിയതുകൊണ്ട്, എന്നാണ, ഞാനും നിന്നെ ആദരിക്കാതെ എന്‍റെ കടാക്ഷം നിന്നിൽനിന്ന് മാറ്റിക്കളയും; ഞാൻ കരുണ കാണിക്കുകയുമില്ല. <verse eid="EZK 5:11" /><verse number="12" style="v" sid="EZK 5:12" />നിന്നിൽ മൂന്നിൽ ഒന്ന് മഹാമാരികൊണ്ടു മരിക്കും; ക്ഷാമംകൊണ്ടും അവർ നിന്‍റെ നടുവിൽ മുടിഞ്ഞുപോകും; മൂന്നിൽ ഒന്നിനെ നിന്‍റെ ചുറ്റും വാൾകൊണ്ട് വീഴും; മൂന്നിൽ ഒന്ന് ഞാൻ എല്ലാ കാറ്റുകളിലേക്കും ചിതറിച്ചുകളയുകയും അവരുടെ പിന്നാലെ വാളൂരുകയും ചെയ്യും. <verse eid="EZK 5:12" /><verse number="13" style="v" sid="EZK 5:13" />അങ്ങനെ എന്‍റെ കോപത്തിനു നിവൃത്തിവരും; ഞാൻ അവരോട് എന്‍റെ ക്രോധം തീർത്ത് തൃപ്തനാകും; എന്‍റെ ക്രോധം അവരിൽ നിവർത്തിക്കുമ്പോൾ യഹോവയായ ഞാൻ എന്‍റെ തീക്ഷ്ണതയിൽ അത് അരുളിച്ചെയ്തു എന്നു അവർ അറിയും. <verse eid="EZK 5:13" /><verse number="14" style="v" sid="EZK 5:14" />വഴിപോകുന്ന എല്ലാവരും കാണത്തക്കവിധം ഞാൻ നിന്നെ നിന്‍റെ ചുറ്റുമുള്ള ജനതകളുടെ ഇടയിൽ ശൂന്യവും നിന്ദ്യവുമാക്കും. <verse eid="EZK 5:14" /><verse number="15" style="v" sid="EZK 5:15" />ഞാൻ കോപത്തോടും ക്രോധത്തോടും കഠിനശിക്ഷകളോടും കൂടെ നിന്നിൽ ന്യായവിധി നടത്തുമ്പോൾ നീ നിന്‍റെ ചുറ്റുമുള്ള ജനതകൾക്കു നിന്ദയും ആക്ഷേപവും ബുദ്ധിയുപദേശവും സ്തംഭനഹേതുവും ആയിരിക്കും” യഹോവയായ ഞാൻ അരുളിച്ചെയ്തിരിക്കുന്നു.<verse eid="EZK 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 5:16" />“നിങ്ങളെ നശിപ്പിക്കേണ്ടതിന് ക്ഷാമം എന്ന നാശകരമായ ദുരസ്ത്രങ്ങൾ ഞാൻ എയ്യുമ്പോൾ, നിങ്ങൾക്ക് ക്ഷാമം വർദ്ധിപ്പിച്ച് നിങ്ങളുടെ അപ്പം എന്ന കോൽ ഒടിച്ചുകളയും. <verse eid="EZK 5:16" /><verse number="17" style="v" sid="EZK 5:17" />നിന്നെ മക്കളില്ലാതെയാക്കേണ്ടതിന് ഞാൻ ക്ഷാമത്തെയും ദുഷ്ടമൃഗങ്ങളെയും നിങ്ങളുടെ ഇടയിൽ അയയ്ക്കും; മഹാമാരിയും കൊലയും നിന്നിൽ കടക്കും; ഞാൻ വാളും നിന്‍റെനേരെ വരുത്തും” യഹോവയായ ഞാൻ അരുളിച്ചെയ്തിരിക്കുന്നു.<verse eid="EZK 5:17" /></para>
  <chapter eid="EZK 5" />
  <chapter number="6" style="c" sid="EZK 6" />
  <para style="s">യിസ്രായേൽപർവ്വതങ്ങളുടെ വിനാശം</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 6:1" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ: <verse eid="EZK 6:1" /><verse number="2" style="v" sid="EZK 6:2" />“മനുഷ്യപുത്രാ, നീ യിസ്രായേൽപർവ്വതങ്ങളുടെ നേരെ മുഖംതിരിച്ച് അവർക്ക് വിരോധമായി പ്രവചിച്ചു പറയേണ്ടത്: <verse eid="EZK 6:2" /><verse number="3" style="v" sid="EZK 6:3" />“യിസ്രായേൽപർവ്വതങ്ങളേ, യഹോവയായ കർത്താവിന്‍റെ വചനം കേൾക്കുവിൻ! മലകളോടും കുന്നുകളോടും നീരൊഴുക്കുകളോടും താഴ്വരകളോടും യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: ‘ഞാൻ നിങ്ങളുടെനേരെ വാൾ വരുത്തും: ഞാൻ നിങ്ങളുടെ പൂജാഗിരികൾ നശിപ്പിക്കും. <verse eid="EZK 6:3" /><verse number="4" style="v" sid="EZK 6:4" />നിങ്ങളുടെ ബലിപീഠങ്ങൾ ശൂന്യമാകും; നിങ്ങളുടെ സൂര്യസ്തംഭങ്ങൾ തകർന്നുപോകും; നിങ്ങളുടെ നിഹതന്മാരെ ഞാൻ നിങ്ങളുടെ വിഗ്രഹങ്ങളുടെ മുമ്പിൽ വീഴിക്കും. <verse eid="EZK 6:4" /><verse number="5" style="v" sid="EZK 6:5" />ഞാൻ യിസ്രായേൽ മക്കളുടെ ശവങ്ങൾ അവരുടെ വിഗ്രഹങ്ങളുടെ മുമ്പിൽ ഇടും; ഞാൻ നിങ്ങളുടെ അസ്ഥികൾ നിങ്ങളുടെ ബലിപീഠങ്ങൾക്കു ചുറ്റും ചിതറിക്കും. <verse eid="EZK 6:5" /><verse number="6" style="v" sid="EZK 6:6" />നിങ്ങളുടെ ബലിപീഠങ്ങൾ ഇടിഞ്ഞ് ശൂന്യമാകുകയും നിങ്ങളുടെ വിഗ്രഹങ്ങൾ തകർന്നു മുടിഞ്ഞുപോകുകയും നിങ്ങളുടെ സൂര്യസ്തംഭങ്ങൾ വെട്ടിക്കളയുകയും നിങ്ങളുടെ പണികൾ നശിച്ചുപോകുകയും ചെയ്യുവാൻ തക്കവിധം നിങ്ങളുടെ വാസസ്ഥലങ്ങളിലെല്ലാം പട്ടണങ്ങൾ പാഴായും പൂജാഗിരികൾ ശൂന്യമായും തീരും. <verse eid="EZK 6:6" /><verse number="7" style="v" sid="EZK 6:7" />നിഹതന്മാർ നിങ്ങളുടെ നടുവിൽ വീഴും; ഞാൻ യഹോവ എന്നു നിങ്ങൾ അറിയും.<verse eid="EZK 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 6:8" />എങ്കിലും നിങ്ങൾ ദേശങ്ങളിൽ ചിതറിപ്പോകുമ്പോൾ വാളിനു തെറ്റിപ്പോയവർ ജനതകളുടെ ഇടയിൽ നിങ്ങൾക്ക് ഉണ്ടാകേണ്ടതിന് ഞാൻ ഒരു ശേഷിപ്പിനെ വച്ചേക്കും. <verse eid="EZK 6:8" /><verse number="9" style="v" sid="EZK 6:9" />എന്നെ വിട്ടകന്ന് പരസംഗം ചെയ്യുന്ന അവരുടെ ഹൃദയത്തെയും വിഗ്രഹങ്ങളോടു ചേർന്നു പരസംഗം ചെയ്യുന്ന അവരുടെ കണ്ണുകളെയും ഞാൻ തകർത്തുകളഞ്ഞശേഷം, നിങ്ങളിൽ ചാടിപ്പോയവർ, അവരെ പിടിച്ചു കൊണ്ടുപോയ ജനതകളുടെ ഇടയിൽവച്ച് എന്നെ ഓർക്കും; അവരുടെ സകലമ്ലേച്ഛതകളാലും ചെയ്ത ദോഷങ്ങളാലും അവർക്ക് അവരോടു തന്നെ വെറുപ്പുതോന്നും. <verse eid="EZK 6:9" /><verse number="10" style="v" sid="EZK 6:10" />ഞാൻ യഹോവ എന്നു അവർ അറിയും; ഈ അനർത്ഥം അവർക്ക് വരുത്തുമെന്നു വെറുതെയല്ല ഞാൻ അരുളിച്ചെയ്തിരിക്കുന്നത്.”<verse eid="EZK 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 6:11" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “യിസ്രായേൽ ഗൃഹത്തിന്‍റെ ദോഷകരമായ സകലമ്ലേച്ഛതകളും നിമിത്തം നീ കൈകൊണ്ടടിച്ച്, കാൽ കൊണ്ടു ചവിട്ടി, ‘അയ്യോ കഷ്ടം!’ എന്നു പറയുക; അവർ വാൾകൊണ്ടും ക്ഷാമംകൊണ്ടും മഹാമാരികൊണ്ടും വീഴും; <verse eid="EZK 6:11" /><verse number="12" style="v" sid="EZK 6:12" />ദൂരത്തുള്ളവൻ മഹാമാരിയാൽ മരിക്കും; സമീപത്തുള്ളവൻ വാളാൽ വീഴും; ശേഷിച്ചിരിക്കുന്നവനും രക്ഷപെട്ടവനും ക്ഷാമത്താൽ മരിക്കും; ഇങ്ങനെ ഞാൻ എന്‍റെ ക്രോധം അവരിൽ നിവർത്തിക്കും. <verse eid="EZK 6:12" /><verse number="13" style="v" sid="EZK 6:13" />അവർ അവരുടെ സകലവിഗ്രഹങ്ങൾക്കും സൗരഭ്യവാസന അർപ്പിച്ച, ഉയരമുള്ള എല്ലാ കുന്നിന്മേലും സകല പർവ്വതശിഖരങ്ങളിലും എല്ലാ പച്ചമരത്തിൻകീഴിലും തഴച്ചിരിക്കുന്ന എല്ലാ കരുവേലകത്തിൻകീഴിലും അവരുടെ നിഹതന്മാർ അവരുടെ ബലിപീഠങ്ങളുടെ ചുറ്റും അവരുടെ വിഗ്രഹങ്ങളുടെ ഇടയിൽ വീണുകിടക്കുമ്പോൾ, ഞാൻ യഹോവ എന്നു നിങ്ങൾ അറിയും. <verse eid="EZK 6:13" /><verse number="14" style="v" sid="EZK 6:14" />ഞാൻ അവരുടെ നേരെ കൈ നീട്ടി, അവരുടെ സകലവാസസ്ഥലങ്ങളിലും ദേശത്തെ രിബ്ലാമരുഭൂമിയെക്കാൾ അധികം നിർജ്ജനവും ശൂന്യവുമാക്കും; അപ്പോൾ ഞാൻ യഹോവയെന്ന് അവർ അറിയും.”<verse eid="EZK 6:14" /></para>
  <chapter eid="EZK 6" />
  <chapter number="7" style="c" sid="EZK 7" />
  <para style="s">യിസ്രായേലിൻ്റെ അന്ത്യം അടുത്തിരിക്കുന്നു</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 7:1" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ: <verse eid="EZK 7:1" /><verse number="2" style="v" sid="EZK 7:2" />“മനുഷ്യപുത്രാ, യഹോവയായ കർത്താവ് യിസ്രായേൽദേശത്തോട് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:</para>
  <para style="b" vid="EZK 7:2" />
  <para style="q1" vid="EZK 7:2">‘ഇതാ അവസാനം! യിസ്രായേൽ ദേശത്തിന്‍റെ നാലുഭാഗത്തും</para>
  <para style="q2" vid="EZK 7:2">അവസാനം വന്നെത്തിയിരിക്കുന്നു!<verse eid="EZK 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 7:3" />ഇപ്പോൾ നിനക്കു അവസാനം വന്നിരിക്കുന്നു;</para>
  <para style="q2" vid="EZK 7:3">ഞാൻ എന്‍റെ കോപം നിന്‍റെമേൽ അയച്ച്</para>
  <para style="q1" vid="EZK 7:3">നിന്‍റെ നടപ്പിനു തക്കവണ്ണം നിന്നെ ന്യായംവിധിച്ച്</para>
  <para style="q2" vid="EZK 7:3">നിന്‍റെ സകലമ്ലേച്ഛതകൾക്കും നിന്നോട് പകരം ചെയ്യും.<verse eid="EZK 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 7:4" />എന്‍റെ കണ്ണ് നിന്നെ ആദരിക്കാതെയും</para>
  <para style="q2" vid="EZK 7:4">ഞാൻ കരുണ കാണിക്കാതെയും</para>
  <para style="q1" vid="EZK 7:4">നിന്‍റെ നടപ്പിനു തക്കവണ്ണം നിന്നോട് പകരം ചെയ്യും;</para>
  <para style="q2" vid="EZK 7:4">നിന്‍റെ മ്ലേച്ഛതകൾ നിന്‍റെ നടുവിൽ വെളിപ്പെട്ടുവരും;</para>
  <para style="q2" vid="EZK 7:4">ഞാൻ യഹോവ എന്നു നിങ്ങൾ അറിയും.”<verse eid="EZK 7:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="EZK 7:5" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:</para>
  <para style="q1" vid="EZK 7:5">“ഒരു അനർത്ഥം, ഒരു അനർത്ഥം ഇതാ, വരുന്നു!<verse eid="EZK 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 7:6" />അവസാനം വന്നിരിക്കുന്നു! അവസാനം വന്നിരിക്കുന്നു!</para>
  <para style="q2" vid="EZK 7:6">അത് നിന്‍റെനേരെ ഉണർന്നുവരുന്നു! ഇതാ, അത് വരുന്നു.<verse eid="EZK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 7:7" />ദേശനിവാസിയേ, ആപത്തു നിനക്കു വന്നിരിക്കുന്നു;</para>
  <para style="q2" vid="EZK 7:7">കാലമായി, സമയം അടുത്തു;</para>
  <para style="q2" vid="EZK 7:7">മലകളിൽ ആർപ്പുവിളി; സന്തോഷത്തിന്‍റെ ആർപ്പുവിളിയല്ല.<verse eid="EZK 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 7:8" />ഇപ്പോൾ ഞാൻ വേഗത്തിൽ എന്‍റെ ക്രോധം നിന്‍റെമേൽ പകർന്ന്,</para>
  <para style="q2" vid="EZK 7:8">എന്‍റെ കോപം നിന്നിൽ നിവർത്തിക്കും;</para>
  <para style="q1" vid="EZK 7:8">ഞാൻ നിന്‍റെ നടപ്പിനു തക്കവണ്ണം നിന്നെ ന്യായംവിധിച്ച്</para>
  <para style="q2" vid="EZK 7:8">നിന്‍റെ സകലമ്ലേച്ഛതകൾക്കും നിന്നോടു പകരം ചെയ്യും.<verse eid="EZK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 7:9" />എന്‍റെ കണ്ണ് ആദരിക്കാതെയും</para>
  <para style="q2" vid="EZK 7:9">ഞാൻ കരുണ കാണിക്കാതെയും</para>
  <para style="q1" vid="EZK 7:9">നിന്‍റെ നടപ്പിനു തക്കവണ്ണം ഞാൻ നിന്നോട് പകരം ചെയ്യും;</para>
  <para style="q2" vid="EZK 7:9">നിന്‍റെ മ്ലേച്ഛതകൾ നിന്‍റെ നടുവിൽ വെളിപ്പെട്ടുവരും;</para>
  <para style="q2" vid="EZK 7:9">യഹോവയായ ഞാനാകുന്നു ദണ്ഡിപ്പിക്കുന്നത് എന്നു നിങ്ങൾ അറിയും.<verse eid="EZK 7:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="EZK 7:10" />“ഇതാ, നാൾ; ഇതാ, അത് വരുന്നു;</para>
  <para style="q2" vid="EZK 7:10">നിന്‍റെ ആപത്ത് പുറപ്പെട്ടിരിക്കുന്നു;</para>
  <para style="q2" vid="EZK 7:10">വടി പൂത്ത് അഹങ്കാരം തളിർത്തിരിക്കുന്നു.<verse eid="EZK 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 7:11" />സാഹസം ദുഷ്ടതയുടെ വടിയായിട്ടു വളർന്നിരിക്കുന്നു;</para>
  <para style="q2" vid="EZK 7:11">അവരിലോ അവരുടെ കോലാഹലത്തിലോ</para>
  <para style="q2" vid="EZK 7:11">അവരുടെ സമ്പത്തിലോ ഒന്നും ശേഷിക്കുകയില്ല;</para>
  <para style="q2" vid="EZK 7:11">അവരെക്കുറിച്ചു വിലാപം ഉണ്ടാകുകയുമില്ല.<verse eid="EZK 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 7:12" />കാലം വന്നിരിക്കുന്നു; നാൾ അടുത്തിരിക്കുന്നു;</para>
  <para style="q2" vid="EZK 7:12">അതിന്‍റെ സകല ജനസമൂഹത്തിന്മേലും ക്രോധം വന്നിരിക്കുകയാൽ</para>
  <para style="q2" vid="EZK 7:12">വാങ്ങുന്നവൻ സന്തോഷിക്കുകയും വില്‍ക്കുന്നവൻ ദുഃഖിക്കുകയും വേണ്ടാ.<verse eid="EZK 7:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="EZK 7:13" />“അവർ ജീവിച്ചിരുന്നാലും വില്‍ക്കുന്നവനു വിറ്റതു മടക്കിക്കിട്ടുകയില്ല; ദർശനം അതിന്‍റെ സകല ജനസമൂഹത്തെയും കുറിച്ചുള്ളതാകുന്നു; ആരും മടങ്ങിവരുകയില്ല; അകൃത്യത്തിൽ ജീവിതം കഴിക്കുന്ന ഒരുത്തനും ശക്തി പ്രാപിക്കുകയില്ല.<verse eid="EZK 7:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="EZK 7:14" />“അവർ കാഹളം ഊതി സകലവും ഒരുക്കുന്നു;</para>
  <para style="q2" vid="EZK 7:14">എന്നാൽ എന്‍റെ ക്രോധം അതിന്‍റെ സകല ജനസമൂഹത്തിന്മേലും വന്നിരിക്കുകയാൽ</para>
  <para style="q2" vid="EZK 7:14">ആരും യുദ്ധത്തിനു പോകുന്നില്ല,<verse eid="EZK 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="EZK 7:15" />പുറത്തു വാൾ, അകത്ത് മഹാമാരിയും ക്ഷാമവും;</para>
  <para style="q2" vid="EZK 7:15">വയലിൽ ഇരിക്കുന്നവൻ വാൾകൊണ്ടു മരിക്കും;</para>
  <para style="q2" vid="EZK 7:15">പട്ടണത്തിൽ ഇരിക്കുന്നവൻ ക്ഷാമത്തിനും മഹാമാരിക്കും ഇരയായിത്തീരും.<verse eid="EZK 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="EZK 7:16" />എന്നാൽ അവരിൽ ചാടിപ്പോകുന്നവർ ചാടിപ്പോകുകയും</para>
  <para style="q2" vid="EZK 7:16">ഓരോരുത്തനും അവനവന്‍റെ അകൃത്യത്തെക്കുറിച്ച്</para>
  <para style="q1" vid="EZK 7:16">താഴ്വരകളിലെ പ്രാവുകളെപ്പോലെ</para>
  <para style="q2" vid="EZK 7:16">മലകളിൽ ഇരുന്നു കുറുകുകയും ചെയ്യും.<verse eid="EZK 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="EZK 7:17" />എല്ലാകൈകളും തളരും;</para>
  <para style="q2" vid="EZK 7:17">എല്ലാമുഴങ്കാലുകളും വെള്ളംപോലെ ബലഹീനമാകും.<verse eid="EZK 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="EZK 7:18" />അവർ രട്ടുടുക്കും;</para>
  <para style="q2" vid="EZK 7:18">ഭീതി അവരെ മൂടും;</para>
  <para style="q1" vid="EZK 7:18">സകലമുഖങ്ങളിലും ലജ്ജയും</para>
  <para style="q2" vid="EZK 7:18">എല്ലാതലകളിലും കഷണ്ടിയും ഉണ്ടായിരിക്കും.<verse eid="EZK 7:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="EZK 7:19" />“അവർ അവരുടെ വെള്ളി വീഥികളിൽ എറിഞ്ഞുകളയും;</para>
  <para style="q2" vid="EZK 7:19">പൊന്ന് അവർക്ക് മലമായി തോന്നും;</para>
  <para style="q1" vid="EZK 7:19">അവരുടെ വെള്ളിക്കും പൊന്നിനും</para>
  <para style="q2" vid="EZK 7:19">യഹോവയുടെ കോപദിവസത്തിൽ അവരെ വിടുവിക്കുവാൻ കഴിയുകയില്ല;</para>
  <para style="q1" vid="EZK 7:19">അതിനാൽ അവരുടെ വിശപ്പ് അടങ്ങുകയില്ല,</para>
  <para style="q2" vid="EZK 7:19">അവരുടെ വയറ് നിറയുകയും ഇല്ല;</para>
  <para style="q2" vid="EZK 7:19">അത് അവർക്ക് അകൃത്യഹേതു ആയിരുന്നുവല്ലോ.<verse eid="EZK 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="EZK 7:20" />അതുകൊണ്ടുള്ള ആഭരണങ്ങളുടെ ഭംഗി അവർ ഡംഭത്തിനായി ഉപയോഗിച്ചു;</para>
  <para style="q2" vid="EZK 7:20">അതുകൊണ്ട് അവർ അവർക്ക് മ്ലേച്ഛവിഗ്രഹങ്ങളെയും മലിനബിംബങ്ങളെയും ഉണ്ടാക്കി; ആകയാൽ ഞാൻ അത് അവർക്ക് മലമാക്കിയിരിക്കുന്നു.<verse eid="EZK 7:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="EZK 7:21" />ഞാൻ അത് അന്യന്മാരുടെ കയ്യിൽ കവർച്ചയായും</para>
  <para style="q2" vid="EZK 7:21">ഭൂമിയിലെ ദുഷ്ടന്മാർക്ക് കൊള്ളയായും കൊടുക്കും;</para>
  <para style="q2" vid="EZK 7:21">അവർ അത് അശുദ്ധമാക്കും.<verse eid="EZK 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="EZK 7:22" />ഞാൻ എന്‍റെ മുഖം അവരിൽ നിന്നു തിരിക്കും.</para>
  <para style="q2" vid="EZK 7:22">അവർ എന്‍റെ അമൂല്യസ്ഥലത്തെ അശുദ്ധമാക്കും;</para>
  <para style="q2" vid="EZK 7:22">കവർച്ചക്കാർ അതിനകത്ത് കടന്ന് അതിനെ അശുദ്ധമാക്കും.<verse eid="EZK 7:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="EZK 7:23" />“ദേശം രക്തപാതകംകൊണ്ടും നഗരം സാഹസംകൊണ്ടും നിറഞ്ഞിരിക്കുകയാൽ</para>
  <para style="q2" vid="EZK 7:23">നീ ഒരു ചങ്ങല ഉണ്ടാക്കുക.<verse eid="EZK 7:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="EZK 7:24" />ഞാൻ ജനതകളിൽ അതിദുഷ്ടന്മാരായവരെ വരുത്തും;</para>
  <para style="q2" vid="EZK 7:24">അവർ അവരുടെ വീടുകൾ കൈവശമാക്കും;</para>
  <para style="q1" vid="EZK 7:24">ഞാൻ ബലവാന്മാരുടെ പ്രതാപം ഇല്ലാതെയാക്കും;</para>
  <para style="q2" vid="EZK 7:24">അവരുടെ വിശുദ്ധസ്ഥലങ്ങൾ അശുദ്ധമായിത്തീരും.<verse eid="EZK 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="EZK 7:25" />നാശം വരുന്നു! അവർ സമാധാനം അന്വേഷിക്കും;</para>
  <para style="q2" vid="EZK 7:25">എന്നാൽ അത് ഇല്ലാതെ ഇരിക്കും.<verse eid="EZK 7:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="EZK 7:26" />അപകടത്തിന്മേൽ അപകടവും കിംവദന്തിയ്ക്കു പിന്നാലെ കിംവദന്തിയും വന്നുകൊണ്ടിരിക്കും;</para>
  <para style="q2" vid="EZK 7:26">അവർ പ്രവാചകനോടു ദർശനം അന്വേഷിക്കും;</para>
  <para style="q1" vid="EZK 7:26">എന്നാൽ പുരോഹിതന്‍റെ പക്കൽനിന്ന് ഉപദേശവും</para>
  <para style="q2" vid="EZK 7:26">മൂപ്പന്മാരുടെ പക്കൽനിന്ന് ആലോചനയും നഷ്ടമായിപ്പോകും.<verse eid="EZK 7:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="EZK 7:27" />രാജാവു ദുഃഖിക്കും; പ്രഭു നിരാശ്രയനാകും;</para>
  <para style="q2" vid="EZK 7:27">ദേശത്തെ ജനത്തിന്‍റെ കൈകൾ വിറയ്ക്കും;</para>
  <para style="q1" vid="EZK 7:27">ഞാൻ അവരുടെ നടപ്പിനു തക്കവണ്ണം അവരോടു പകരം ചെയ്യും;</para>
  <para style="q2" vid="EZK 7:27">അവർക്ക് ന്യായമായതുപോലെ അവരെ വിധിക്കും;</para>
  <para style="q2" vid="EZK 7:27">ഞാൻ യഹോവ എന്നു അവർ അറിയും.“<verse eid="EZK 7:27" /></para>
  <chapter eid="EZK 7" />
  <chapter number="8" style="c" sid="EZK 8" />
  <para style="s">ദൈവാലയത്തിൽ വിഗ്രഹാരാധന</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 8:1" />ബാബിലോന്യ പ്രവാസത്തിന്‍റെ ആറാം ആണ്ട് ആറാം മാസം അഞ്ചാം തീയതി, ഞാൻ ബാബിലോണിലെ വീട്ടിൽ ഇരിക്കുമ്പോൾ, യെഹൂദാമൂപ്പന്മാർ എന്‍റെ മുമ്പിൽ ഇരിക്കുന്നുണ്ടായിരുന്നു. അപ്പോൾ അവിടെ യഹോവയായ കർത്താവിന്‍റെ കൈ എന്‍റെ മേൽ വന്നു. <verse eid="EZK 8:1" /><verse number="2" style="v" sid="EZK 8:2" />അപ്പോൾ ഞാൻ മനുഷ്യസാദൃശത്തിൽ ഒരു രൂപം കണ്ടു; അവിടുത്തെ അരമുതൽ കീഴോട്ടു തീപോലെയും അരമുതൽ മേലോട്ടു ശുക്ലസ്വർണ്ണത്തിൻ്റെ പ്രഭപോലെയും ആയിരുന്നു. <verse eid="EZK 8:2" /><verse number="3" style="v" sid="EZK 8:3" />അവിടുന്ന് കൈപോലെ ഒന്ന് നീട്ടി എന്നെ തലമുടിക്കു പിടിച്ചു; ദൈവത്തിന്‍റെ ആത്മാവ് എന്നെ ഭൂമിയുടെയും ആകാശത്തിൻ്റെയും മദ്ധ്യത്തിലേക്ക് ഉയർത്തി ദിവ്യദർശനങ്ങളിൽ യെരൂശലേമിൽ വടക്കോട്ടുള്ള അകത്തെ വാതില്ക്കൽ കൊണ്ടുചെന്നു; അവിടെ തീക്ഷ്ണത ജനിപ്പിക്കുന്ന തീക്ഷ്ണതാ ബിംബത്തിന്‍റെ ഇരിപ്പിടം ഉണ്ടായിരുന്നു. <verse eid="EZK 8:3" /><verse number="4" style="v" sid="EZK 8:4" />അവിടെ ഞാൻ സമഭൂമിയിൽ കണ്ട ദർശനംപോലെ യിസ്രായേലിന്‍റെ ദൈവത്തിന്‍റെ മഹത്ത്വം ഉണ്ടായിരുന്നു.<verse eid="EZK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 8:5" />അവിടുന്ന് എന്നോട്: “മനുഷ്യപുത്രാ, തലപൊക്കി വടക്കോട്ടു നോക്കുക” എന്നു കല്പിച്ചു; ഞാൻ തലപൊക്കി വടക്കോട്ടു നോക്കി; യാഗപീഠത്തിന്‍റെ വാതിലിനു വടക്കോട്ട്, പ്രവേശനകവാടത്തിൽ തന്നെ, ആ തിക്ഷ്ണതാബിംബത്തെ കണ്ടു. <verse eid="EZK 8:5" /><verse number="6" style="v" sid="EZK 8:6" />അവിടുന്ന് എന്നോട്: “മനുഷ്യപുത്രാ, അവർ ചെയ്യുന്നത്, ഞാൻ എന്‍റെ വിശുദ്ധമന്ദിരം വിട്ടു പോകേണ്ടതിന് യിസ്രായേൽഗൃഹം ഇവിടെ ചെയ്യുന്ന മഹാമ്ലേച്ഛതകൾ തന്നെ, നീ കാണുന്നുവോ? ഇതിലും വലിയ മ്ലേച്ഛതകൾ നീ കാണും” എന്നു അരുളിച്ചെയ്തു.<verse eid="EZK 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 8:7" />അവിടുന്ന് എന്നെ പ്രാകാരത്തിന്‍റെ വാതില്ക്കൽ കൊണ്ടുപോയി; ഞാൻ നോക്കിയപ്പോൾ ചുവരിൽ ഒരു ദ്വാരം കണ്ടു. <verse eid="EZK 8:7" /><verse number="8" style="v" sid="EZK 8:8" />അവിടുന്ന് എന്നോട്: “മനുഷ്യപുത്രാ, ചുവർ കുത്തിത്തുരക്കുക” എന്നു പറഞ്ഞു; ഞാൻ ചുവർ കുത്തിത്തുരന്നപ്പോൾ ഒരു വാതിൽ കണ്ടു. <verse eid="EZK 8:8" /><verse number="9" style="v" sid="EZK 8:9" />അവിടുന്ന് എന്നോട്: “അകത്ത് ചെന്നു, അവർ ഇവിടെ ചെയ്യുന്ന കടുത്ത മ്ലേച്ഛതകൾ നോക്കുക” എന്നു കല്പിച്ചു. <verse eid="EZK 8:9" /><verse number="10" style="v" sid="EZK 8:10" />അങ്ങനെ ഞാൻ അകത്ത് ചെന്നു; വെറുപ്പായുള്ള ഓരോ തരം ഇഴജാതികളെയും മൃഗങ്ങളെയും യിസ്രായേൽ ഗൃഹത്തിന്‍റെ സകലവിഗ്രഹങ്ങളെയും ചുറ്റും ചുവരിന്മേൽ വരച്ചിരിക്കുന്നതു കണ്ടു. <verse eid="EZK 8:10" /><verse number="11" style="v" sid="EZK 8:11" />അവയുടെ മുമ്പിൽ യിസ്രായേൽ ഗൃഹത്തിന്‍റെ മൂപ്പന്മാരിൽ എഴുപതുപേരും ശാഫാന്‍റെ മകനായ യയസന്യാവ് അവരുടെ നടുവിലും ഓരോരുത്തൻ കയ്യിൽ ധൂപകലശം പിടിച്ചുകൊണ്ടു നിന്നു; മേഘതുല്യമായ ധൂപത്തിൻ്റെ വാസന പൊങ്ങിക്കൊണ്ടിരുന്നു. <verse eid="EZK 8:11" /><verse number="12" style="v" sid="EZK 8:12" />അപ്പോൾ അവിടുന്ന് എന്നോട്: “മനുഷ്യപുത്രാ, യിസ്രായേൽ ഗൃഹത്തിന്‍റെ മൂപ്പന്മാർ ഇരുട്ടത്ത്, ഓരോരുത്തൻ അവനവന്‍റെ ബിംബങ്ങളുടെ അറകളിൽ ചെയ്യുന്നത് നീ കാണുന്നുവോ? യഹോവ നമ്മെ കാണുന്നില്ല, യഹോവ ദേശത്തെ വിട്ടു പോയിരിക്കുന്നു എന്നു അവർ പറയുന്നു” എന്നരുളിച്ചെയ്തു. <verse eid="EZK 8:12" /><verse number="13" style="v" sid="EZK 8:13" />“അവർ ഇതിലും വലിയ മ്ലേച്ഛതകൾ ചെയ്യുന്നത് നീ കാണും” എന്നും അവിടുന്ന് എന്നോട് അരുളിച്ചെയ്തു.<verse eid="EZK 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 8:14" />അവിടുന്ന് എന്നെ യഹോവയുടെ ആലയത്തിൽ വടക്കോട്ടുള്ള വാതിലിന്‍റെ പ്രവേശനത്തിലേക്ക് കൊണ്ടുപോയി; അവിടെ സ്ത്രീകൾ തമ്മൂസിനെക്കുറിച്ച്<note caller="+" style="f"><char style="fr" closed="false">8:14 </char><char style="fq" closed="false">തമ്മൂസിനെക്കുറിച്ച് </char><char style="ft" closed="false">പുരാതന മധ്യപൂര്‍വ ദേശത്ത് ഒരു ചെടി നശിക്കുമ്പോള്‍ തമ്മൂസ് എന്ന ദേവന്‍ നശിക്കുകയും തൊട്ടടുത്ത വര്‍ഷം ഉയിര്‍ത്തെഴുന്നേല്ക്കുകയും ചെയ്യുമെന്ന് വിശ്വസിച്ചിരുന്നു. സ്ത്രീകള്‍ തമ്മൂസിൻ്റെ മരണത്തില്‍ വിലപിച്ചിരുന്നു </char></note> കരഞ്ഞുകൊണ്ട് ഇരിക്കുന്നത് ഞാൻ കണ്ടു. <verse eid="EZK 8:14" /><verse number="15" style="v" sid="EZK 8:15" />അവിടുന്ന് എന്നോട്: “മനുഷ്യപുത്രാ, നീ കാണുന്നുവോ? ഇതിലും വലിയ മ്ലേച്ഛതകളെ ഇനിയും കാണും” എന്നു അരുളിച്ചെയ്തു.<verse eid="EZK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 8:16" />അവിടുന്ന് എന്നെ യഹോവയുടെ ആലയത്തിന്‍റെ അകത്തെ പ്രാകാരത്തിൽ കൊണ്ടുപോയി; യഹോവയുടെ മന്ദിരത്തിന്‍റെ വാതില്ക്കൽ മണ്ഡപത്തിനും യാഗപീഠത്തിനും മദ്ധ്യത്തിൽ ഏകദേശം ഇരുപത്തഞ്ചു പുരുഷന്മാർ അവരുടെ പുറം യഹോവയുടെ മന്ദിരത്തിന്‍റെ നേരെയും മുഖം കിഴക്കോട്ടും തിരിച്ചുകൊണ്ട് നിന്നിരുന്നു; അവർ കിഴക്കോട്ടു നോക്കി സൂര്യനെ നമസ്കരിക്കുകയായിരുന്നു. <verse eid="EZK 8:16" /><verse number="17" style="v" sid="EZK 8:17" />അപ്പോൾ അവിടുന്ന് എന്നോട്: “മനുഷ്യപുത്രാ, നീ കാണുന്നുവോ? യെഹൂദാഗൃഹം ഇവിടെ ചെയ്യുന്ന മ്ലേച്ഛതകൾ പോരാഞ്ഞിട്ടോ, അവർ എന്നെ അധികമധികം കോപിപ്പിക്കുവാൻ ദേശം സാഹസംകൊണ്ടു നിറയ്ക്കുന്നത്? കണ്ടില്ലേ അവർ മരച്ചില്ല മൂക്കിൽ തൊടുവിക്കുന്നത്? <verse eid="EZK 8:17" /><verse number="18" style="v" sid="EZK 8:18" />ആകയാൽ ഞാനും ക്രോധത്തോടെ പ്രവർത്തിക്കും; എന്‍റെ കണ്ണിന് ആദരവ് തോന്നുകയില്ല; ഞാൻ കരുണ കാണിക്കുകയുമില്ല; അവർ അത്യുച്ചത്തിൽ എന്നോട് നിലവിളിച്ചാലും ഞാൻ അപേക്ഷ കേൾക്കുകയില്ല” എന്നു അരുളിച്ചെയ്തു.<verse eid="EZK 8:18" /></para>
  <chapter eid="EZK 8" />
  <chapter number="9" style="c" sid="EZK 9" />
  <para style="s">യെരൂശലേം ശിക്ഷിക്കപ്പെടുന്നു</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 9:1" />അനന്തരം ഞാൻ കേൾക്കെ ദൈവം അത്യുച്ചത്തിൽ വിളിച്ചു: “നഗരത്തിൽ ശിക്ഷ നൽകുന്നവരെ അടുത്തു വരുമാറാക്കുവിൻ; ഓരോരുത്തനും നാശകരമായ ആയുധം കയ്യിൽ എടുക്കട്ടെ” എന്നു കല്പിച്ചു. <verse eid="EZK 9:1" /><verse number="2" style="v" sid="EZK 9:2" />അപ്പോൾ ആറു പുരുഷന്മാർ, ഓരോരുത്തനും വെണ്മഴു കയ്യിൽ എടുത്തുകൊണ്ടു വടക്കോട്ടുള്ള മുകളിലത്തെ പടിവാതിലിൻ്റെ വഴിയായി വന്നു; അവരുടെ നടുവിൽ ശണവസ്ത്രം ധരിച്ച് അരയിൽ എഴുത്തുകാരൻ്റെ മഷിക്കുപ്പിയുമായി ഒരുത്തൻ ഉണ്ടായിരുന്നു; അവർ അകത്ത് ചെന്നു താമ്രയാഗപീഠത്തിൻ്റെ അരികിൽ നിന്നു.<verse eid="EZK 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 9:3" />യിസ്രായേലിന്‍റെ ദൈവത്തിന്‍റെ മഹത്വം, അത് ഇരുന്നിരുന്ന കെരൂബിന്മേൽനിന്ന് ആലയത്തിന്‍റെ ഉമ്മരപ്പടിക്കൽ വന്നിരുന്നു; പിന്നെ അവിടുന്ന്, ശണവസ്ത്രം ധരിച്ച് അരയിൽ എഴുത്തുകാരൻ്റെ മഷിക്കുപ്പിയുമായി നിന്നിരുന്ന പുരുഷനെ വിളിച്ചു. <verse eid="EZK 9:3" /><verse number="4" style="v" sid="EZK 9:4" />അവനോട് യഹോവ: “നീ നഗരത്തിന്‍റെ നടുവിൽ, യെരൂശലേമിന്‍റെ നടുവിൽകൂടി ചെന്നു, അതിൽ നടക്കുന്ന സകലമ്ലേച്ഛതകളും കാരണം നെടുവീർപ്പിട്ടു കരയുന്ന പുരുഷന്മാരുടെ നെറ്റികളിൽ ഒരു അടയാളം ഇടുക” എന്നു കല്പിച്ചു.<verse eid="EZK 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 9:5" />മറ്റുള്ളവരോട് ഞാൻ കേൾക്കെ അവിടുന്ന്: “നിങ്ങൾ അവന്‍റെ പിന്നാലെ നഗരത്തിൽകൂടി ചെന്നു വെട്ടുവിൻ! നിങ്ങളുടെ കണ്ണിന് ആദരവ് തോന്നരുത്; നിങ്ങൾ കരുണ കാണിക്കുകയുമരുത്. <verse eid="EZK 9:5" /><verse number="6" style="v" sid="EZK 9:6" />വൃദ്ധന്മാരെയും യൗവനക്കാരെയും കന്യകമാരെയും കുഞ്ഞുങ്ങളെയും സ്ത്രീകളെയും കൊന്നുകളയുവിൻ! എന്നാൽ അടയാളമുള്ള ഒരുത്തനെയും തൊടരുത്; എന്‍റെ വിശുദ്ധമന്ദിരത്തിൽ തന്നെ തുടങ്ങുവിൻ” എന്നു കല്പിച്ചു; അങ്ങനെ അവർ ആലയത്തിന്‍റെ മുമ്പിൽ ഉണ്ടായിരുന്ന മൂപ്പന്മാരുടെ ഇടയിൽ തുടങ്ങി.<verse eid="EZK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 9:7" />അവിടുന്ന് അവരോട്: “നിങ്ങൾ ആലയത്തെ അശുദ്ധമാക്കി, പ്രാകാരങ്ങളെ നിഹതന്മാരെക്കൊണ്ടു നിറയ്ക്കുവിൻ; പുറപ്പെടുവിൻ” എന്നു കല്പിച്ചു. അങ്ങനെ അവർ പുറപ്പെട്ടു, യെരൂശലേം നഗരത്തിൽ സംഹാരം നടത്തി.<verse eid="EZK 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 9:8" />അവരെ കൊന്നുകളഞ്ഞശേഷം ഞാൻ മാത്രം ശേഷിച്ചു; ഞാൻ കവിണ്ണുവീണു; “അയ്യോ, യഹോവയായ കർത്താവേ, യെരൂശലേമിന്മേൽ അങ്ങേയുടെ ക്രോധം പകരുന്നതിനാൽ യിസ്രായേലിൽ ശേഷിപ്പുള്ളവരെ ഒക്കെയും സംഹരിക്കുമോ?” എന്നു നിലവിളിച്ചുപറഞ്ഞു.<verse eid="EZK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 9:9" />അതിന് അവിടുന്ന് എന്നോട്: “യിസ്രായേൽഗൃഹത്തിൻ്റെയും യെഹൂദാഗൃഹത്തിൻ്റെയും അകൃത്യം ഏറ്റവും വലുതായിരിക്കുന്നു; ദേശം രക്തപാതകംകൊണ്ടും നഗരം അന്യായംകൊണ്ടും നിറഞ്ഞിരിക്കുന്നു; ‘യഹോവ ദേശത്തെ വിട്ടു പോയിരിക്കുന്നു; യഹോവ കാണുന്നില്ല’ എന്നു അവർ പറയുന്നുവല്ലോ. <verse eid="EZK 9:9" /><verse number="10" style="v" sid="EZK 9:10" />ഞാനോ എന്‍റെ കണ്ണിന് ആദരവ് തോന്നാതെയും ഞാൻ കരുണ കാണിക്കാതെയും അവരുടെ നടപ്പിനു തക്കവണ്ണം അവരുടെ തലമേൽ പകരം കൊടുക്കും” എന്നു അരുളിച്ചെയ്തു.<verse eid="EZK 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 9:11" />ശണവസ്ത്രം ധരിച്ച് അരയിൽ മഷിക്കുപ്പിയുമായുള്ള പുരുഷൻ: “എന്നോട് കല്പിച്ചതുപോലെ ഞാൻ ചെയ്തിരിക്കുന്നു” എന്നു ബോധിപ്പിച്ചു.<verse eid="EZK 9:11" /></para>
  <chapter eid="EZK 9" />
  <chapter number="10" style="c" sid="EZK 10" />
  <para style="s">ദൈവത്തിന്‍റെ തേജസ്സ് ആലയം വിട്ടുപോകുന്നു</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 10:1" />അനന്തരം ഞാൻ നോക്കിയപ്പോൾ കെരൂബുകളുടെ തലയ്ക്കുമീതെ ഉണ്ടായിരുന്ന വിതാനത്തിൽ നീലക്കല്ലുപോലെ സിംഹാസനത്തിന്‍റെ സാദൃശ്യത്തിൽ ഒരു രൂപം അവയുടെമേൽ കാണപ്പെട്ടു. <verse eid="EZK 10:1" /><verse number="2" style="v" sid="EZK 10:2" />അവിടുന്ന് ശണവസ്ത്രം ധരിച്ച പുരുഷനോടു സംസാരിച്ചു: “നീ കെരൂബിന്‍റെ കീഴിൽ തിരിഞ്ഞുകൊണ്ടിരിക്കുന്ന ചക്രങ്ങളുടെ നടുവിൽ ചെന്നു കെരൂബുകളുടെ ഇടയിൽനിന്ന് നിന്‍റെ കൈ നിറയെ തീക്കനൽ എടുത്ത് നഗരത്തിന്മേൽ വിതറുക” എന്നു കല്പിച്ചു; അങ്ങനെ ഞാൻ കാൺകെ അവൻ ചെന്നു. <verse eid="EZK 10:2" /><verse number="3" style="v" sid="EZK 10:3" />ആ പുരുഷൻ അകത്ത് ചെല്ലുമ്പോൾ കെരൂബുകൾ ആലയത്തിന്‍റെ വലത്തുഭാഗത്തുനിന്നു; മേഘവും അകത്തെ പ്രാകാരത്തിൽ നിറഞ്ഞിരുന്നു. <verse eid="EZK 10:3" /><verse number="4" style="v" sid="EZK 10:4" />എന്നാൽ യഹോവയുടെ മഹത്ത്വം കെരൂബുകളിൽ നിന്നു പൊങ്ങി, ആലയത്തിന്‍റെ ഉമ്മരപ്പടിക്കു മീതെ നിന്നു; ആലയം മേഘംകൊണ്ടു നിറഞ്ഞിരുന്നു; പ്രാകാരവും യഹോവയുടെ മഹത്വത്തിന്‍റെ ശോഭയാൽ നിറഞ്ഞിരുന്നു. <verse eid="EZK 10:4" /><verse number="5" style="v" sid="EZK 10:5" />കെരൂബുകളുടെ ചിറകുകളുടെ ശബ്ദം പുറത്തെ പ്രാകാരം വരെ സർവ്വശക്തനായ ദൈവം സംസാരിക്കുന്ന നാദംപോലെ കേൾക്കുന്നുണ്ടായിരുന്നു.<verse eid="EZK 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 10:6" />എന്നാൽ അവിടുന്ന് ശണവസ്ത്രം ധരിച്ച പുരുഷനോട്: “നീ കെരൂബുകളുടെ ഇടയിൽനിന്ന്, തിരിഞ്ഞുകൊണ്ടിരിക്കുന്ന ചക്രങ്ങളുടെ നടുവിൽനിന്നു തന്നെ, തീ എടുക്കുക” എന്നു കല്പിച്ചപ്പോൾ അവൻ ചെന്നു ചക്രങ്ങളുടെ അരികിൽ നിന്നു. <verse eid="EZK 10:6" /><verse number="7" style="v" sid="EZK 10:7" />ഒരു കെരൂബ്, കെരൂബുകളുടെ ഇടയിൽനിന്ന് തന്‍റെ കൈ കെരൂബുകളുടെ നടുവിലുള്ള തീയിലേക്ക് നീട്ടി കുറെ എടുത്തു ശണവസ്ത്രം ധരിച്ചവൻ്റെ കയ്യിൽ കൊടുത്തു; അവൻ അത് വാങ്ങി പുറപ്പെട്ടുപോയി. <verse eid="EZK 10:7" /><verse number="8" style="v" sid="EZK 10:8" />കെരൂബുകളുടെ ചിറകുകൾക്കു കീഴിൽ മനുഷ്യന്‍റെ കൈപോലെ ഒന്ന് കാണപ്പെട്ടു.<verse eid="EZK 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 10:9" />ഞാൻ കെരൂബുകളുടെ അരികിൽ നാലു ചക്രം കണ്ടു; ഓരോ കെരൂബിനരികിലും ഓരോ ചക്രം ഉണ്ടായിരുന്നു; ചക്രങ്ങളുടെ കാഴ്ച പുഷ്പരാഗംപോലെ ആയിരുന്നു. <verse eid="EZK 10:9" /><verse number="10" style="v" sid="EZK 10:10" />അവയുടെ കാഴ്ചയോ നാലിനും ഒരുപോലെയുള്ള രൂപം ആയിരുന്നു; ചക്രത്തിൽകൂടി മറ്റൊരു ചക്രം ഉള്ളതുപോലെ തന്നെ. <verse eid="EZK 10:10" /><verse number="11" style="v" sid="EZK 10:11" />അവയ്ക്കു നാലു ഭാഗത്തേക്കും പോകാം; തിരിയുവാൻ ആവശ്യമില്ലാതെ, തലതിരിയുന്ന ഭാഗത്തേക്ക് അതിന്‍റെ പിന്നാലെ അവ പോകും; പോകുമ്പോൾ തിരിയുകയുമില്ല. <verse eid="EZK 10:11" /><verse number="12" style="v" sid="EZK 10:12" />അവയുടെ ശരീരം മുഴുവനും പിൻഭാഗത്തും കൈയിലും ചിറകിലും ചക്രത്തിലും, നാലിനും ഉള്ള ചക്രത്തിൽ തന്നെ, ചുറ്റും അടുത്തടുത്ത് കണ്ണുകൾ ഉണ്ടായിരുന്നു. <verse eid="EZK 10:12" /><verse number="13" style="v" sid="EZK 10:13" />ചക്രങ്ങൾക്ക്, ഞാൻ കേൾക്കെ “ചുഴലികൾ” എന്നു പേർ വിളിച്ചു. <verse eid="EZK 10:13" /><verse number="14" style="v" sid="EZK 10:14" />ഓരോന്നിനും നന്നാലു മുഖം ഉണ്ടായിരുന്നു; ഒന്നാമത്തെ മുഖം കെരൂബ് മുഖവും രണ്ടാമത്തേത് മാനുഷമുഖവും മൂന്നാമത്തേത് സിംഹമുഖവും നാലാമത്തേത് കഴുകുമുഖവും ആയിരുന്നു.<verse eid="EZK 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 10:15" />കെരൂബുകൾ മുകളിലേക്ക് പൊങ്ങി; ഇത് ഞാൻ കെബാർനദീതീരത്തുവച്ചു കണ്ട ജീവി തന്നെ. <verse eid="EZK 10:15" /><verse number="16" style="v" sid="EZK 10:16" />കെരൂബുകൾ പോകുമ്പോൾ ചക്രങ്ങളും അവയോടൊപ്പം പോകും; ഭൂമിയിൽനിന്നു പൊങ്ങുവാൻ കെരൂബുകൾ ചിറകു വിടർത്തുമ്പോൾ ചക്രങ്ങൾ അവയുടെ പാർശ്വത്തിൽനിന്ന് വിട്ടുമാറുകയില്ല. <verse eid="EZK 10:16" /><verse number="17" style="v" sid="EZK 10:17" />ജീവിയുടെ ആത്മാവ് ചക്രങ്ങളിൽ ആയിരുന്നതുകൊണ്ട് അവ നില്ക്കുമ്പോൾ ഇവയും നില്ക്കും; അവ പൊങ്ങുമ്പോൾ ഇവയും പൊങ്ങും.<verse eid="EZK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 10:18" />പിന്നെ യഹോവയുടെ മഹത്ത്വം ആലയത്തിന്‍റെ ഉമ്മരപ്പടി വിട്ട് പുറപ്പെട്ടു കെരൂബുകളിൻ മീതെ വന്നുനിന്നു. <verse eid="EZK 10:18" /><verse number="19" style="v" sid="EZK 10:19" />അപ്പോൾ കെരൂബുകൾ ചിറകുവിടർത്തി, ഞാൻ കാൺകെ ഭൂമിയിൽനിന്നു മുകളിലേക്കുപൊങ്ങി; അവ പൊങ്ങിയപ്പോൾ ചക്രങ്ങളും അവയോടൊപ്പം ഉണ്ടായിരുന്നു; എല്ലാംകൂടി യഹോവയുടെ ആലയത്തിന്‍റെ കിഴക്കെ പടിവാതില്ക്കൽ ചെന്നുനിന്നു; യിസ്രായേലിന്‍റെ ദൈവത്തിന്‍റെ മഹത്ത്വവും അവയ്ക്കു മീതെ നിന്നു.<verse eid="EZK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 10:20" />ഇത് ഞാൻ കെബാർനദീതീരത്തുവച്ച് യിസ്രായേലിന്‍റെ ദൈവത്തിന്‍റെ കീഴിൽ കണ്ട ജീവി തന്നെ; അവ ‘കെരൂബുകൾ’ എന്നു ഞാൻ ഗ്രഹിച്ചു. <verse eid="EZK 10:20" /><verse number="21" style="v" sid="EZK 10:21" />ഓരോന്നിനും നന്നാലു മുഖവും നന്നാലു ചിറകും ഉണ്ടായിരുന്നു; ചിറകിൻ കീഴിൽ മാനുഷകൈപോലെ ഒന്നുണ്ടായിരുന്നു; <verse eid="EZK 10:21" /><verse number="22" style="v" sid="EZK 10:22" />അവയുടെ മുഖരൂപം ഞാൻ കെബാർനദീതീരത്തുവച്ചു കണ്ട മുഖങ്ങൾ തന്നെ ആയിരുന്നു; അവയുടെ രൂപവും അപ്രകാരം തന്നെ; അവ ഓരോന്നും നേരെ മുമ്പോട്ടു തന്നെ പോകും.<verse eid="EZK 10:22" /></para>
  <chapter eid="EZK 10" />
  <chapter number="11" style="c" sid="EZK 11" />
  <para style="s">യെരൂശലേമിൻ്റെമേൽ ന്യായവിധി</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 11:1" />അനന്തരം ആത്മാവ് എന്നെ എടുത്ത് യഹോവയുടെ ആലയത്തിൽ കിഴക്കോട്ടു ദർശനമുള്ള കിഴക്കെ പടിവാതില്ക്കൽ കൊണ്ടുപോയി; പടിവാതിലിൻ്റെ പ്രവേശനകവാടത്തിൽ ഞാൻ ഇരുപത്തഞ്ചു പുരുഷന്മാരെയും അവരുടെ നടുവിൽ ജനത്തിന്‍റെ പ്രഭുക്കന്മാരായ അസ്സീരിന്‍റെ മകൻ യയസന്യാവിനെയും ബെനായാവിന്‍റെ മകൻ പെലത്യാവിനെയും കണ്ടു.<verse eid="EZK 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EZK 11:2" />അവിടുന്ന് എന്നോട്: “മനുഷ്യപുത്രാ, ഇവർ ഈ നഗരത്തിൽ നീതികേട് നിരൂപിച്ച് ദുരാലോചന കഴിക്കുന്ന പുരുഷന്മാരാകുന്നു. <verse eid="EZK 11:2" /><verse number="3" style="v" sid="EZK 11:3" />‘വീടുകൾ പണിയുവാൻ സമയം അടുത്തിട്ടില്ല; ഈ നഗരം കുട്ടകവും നാം മാംസവുമാകുന്നു’ എന്നു അവർ പറയുന്നു. <verse eid="EZK 11:3" /><verse number="4" style="v" sid="EZK 11:4" />അതുകൊണ്ട് അവരെക്കുറിച്ചു പ്രവചിക്കുക, മനുഷ്യപുത്രാ, പ്രവചിക്കുക” എന്നു കല്പിച്ചു. <verse eid="EZK 11:4" /><verse number="5" style="v" sid="EZK 11:5" />അപ്പോൾ യഹോവയുടെ ആത്മാവ് എന്‍റെ മേൽ വന്ന് എന്നോട് കല്പിച്ചത്: “നീ പറയേണ്ടത് എന്തെന്നാൽ: ‘യഹോവ ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: യിസ്രായേൽ ഗൃഹമേ, നിങ്ങൾ ഇപ്രകാരം പറഞ്ഞിരിക്കുന്നു; നിങ്ങളുടെ മനസ്സിൽ തോന്നുന്ന കാര്യങ്ങളും ഞാൻ അറിയുന്നു. <verse eid="EZK 11:5" /><verse number="6" style="v" sid="EZK 11:6" />നിങ്ങൾ ഈ നഗരത്തിൽ നിഹതന്മാരെ വർദ്ധിപ്പിച്ച് വീഥികളെ നിഹതന്മാരെക്കൊണ്ടു നിറച്ചുമിരിക്കുന്നു.<verse eid="EZK 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 11:7" />അതുകൊണ്ട് യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “നിങ്ങൾ ഈ നഗരത്തിന്‍റെ നടുവിൽ വീഴ്ത്തിയ നിഹതന്മാർ മാംസവും ഈ നഗരം കുട്ടകവും ആകുന്നു; എന്നാൽ നിങ്ങളെ ഞാൻ അതിന്‍റെ നടുവിൽനിന്ന് പുറപ്പെടുവിക്കും. <verse eid="EZK 11:7" /><verse number="8" style="v" sid="EZK 11:8" />നിങ്ങൾ വാളിനെ പേടിക്കുന്നു; വാളിനെ തന്നെ ഞാൻ നിങ്ങളുടെനേരെ വരുത്തും” എന്നു യഹോവയായ കർത്താവ് അരുളിച്ചെയ്യുന്നു. <verse eid="EZK 11:8" /><verse number="9" style="v" sid="EZK 11:9" />ഞാൻ നിങ്ങളെ അതിന്‍റെ നടുവിൽനിന്നു പുറപ്പെടുവിച്ച് അന്യന്മാരുടെ കയ്യിൽ ഏല്പിച്ച് നിങ്ങളുടെ ഇടയിൽ ന്യായവിധി നടത്തും. <verse eid="EZK 11:9" /><verse number="10" style="v" sid="EZK 11:10" />നിങ്ങൾ വാളാൽ വീഴും; യിസ്രായേലിന്‍റെ അതിർത്തിയിൽവച്ച് ഞാൻ നിങ്ങളെ ന്യായംവിധിക്കും; ഞാൻ യഹോവ എന്നു നിങ്ങൾ അറിയും. <verse eid="EZK 11:10" /><verse number="11" style="v" sid="EZK 11:11" />ഈ നഗരം നിങ്ങൾക്ക് കുട്ടകം ആയിരിക്കുകയില്ല; നിങ്ങൾ അതിനകത്ത് മാംസവും ആയിരിക്കുകയില്ല; യിസ്രായേലിന്‍റെ അതിർത്തിയിൽവച്ചു തന്നെ ഞാൻ നിങ്ങളെ ന്യായംവിധിക്കും. <verse eid="EZK 11:11" /><verse number="12" style="v" sid="EZK 11:12" />എന്‍റെ ചട്ടങ്ങളിൽ നടക്കുകയോ എന്‍റെ ന്യായങ്ങളെ ആചരിക്കുകയോ ചെയ്യാതെ, ചുറ്റുമുള്ള ജനതകളുടെ ന്യായങ്ങളെ പ്രമാണിച്ചുനടന്ന നിങ്ങൾ, ഞാൻ യഹോവ എന്നു അറിയും.”<verse eid="EZK 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 11:13" />ഞാൻ പ്രവചിച്ചുകൊണ്ടിരിക്കുമ്പോൾ തന്നെ ബെനായാവിന്‍റെ മകനായ പെലത്യാവ് മരിച്ചു; അപ്പോൾ ഞാൻ കവിണ്ണുവീണ് ഉറക്കെ നിലവിളിച്ചു: “അയ്യോ, യഹോവയായ കർത്താവേ, യിസ്രായേലിൽ ശേഷിപ്പുള്ളവരെ നീ അശേഷം മുടിച്ചു കളയുമോ” എന്നു പറഞ്ഞു.<verse eid="EZK 11:13" /></para>
  <para style="s">യിസ്രായേലിൻ്റെ മടങ്ങിവരവിനെക്കുറിച്ചുള്ള വാഗ്ദാനം</para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 11:14" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ: <verse eid="EZK 11:14" /><verse number="15" style="v" sid="EZK 11:15" />“മനുഷ്യപുത്രാ, ‘യഹോവയോട് അകന്നുനില്ക്കുവിൻ! ഞങ്ങൾക്കാകുന്നു ഈ ദേശം അവകാശമായി നല്കപ്പെട്ടിരിക്കുന്നത്’ എന്നല്ലയോ യെരൂശലേം നിവാസികൾ, നിന്‍റെ ചാർച്ചക്കാരായ നിന്‍റെ സഹോദരന്മാരോടും മുഴുവൻ യിസ്രായേൽ ഗൃഹത്തോടും പറയുന്നത്.<verse eid="EZK 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 11:16" />അതുകൊണ്ട് നീ പറയേണ്ടത്: ‘യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഞാൻ അവരെ ദൂരത്ത് ജനതകളുടെ ഇടയിലേക്ക് നീക്കി രാജ്യങ്ങളിൽ ചിതറിച്ചുകളഞ്ഞുവെങ്കിലും, അവർ പോയിരിക്കുന്ന രാജ്യങ്ങളിൽ ഞാൻ അവർക്ക് അല്പകാലത്തേക്ക് ഒരു വിശുദ്ധമന്ദിരമായിരിക്കും.”<verse eid="EZK 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 11:17" />“ആകയാൽ നീ പറയേണ്ടത്: ‘യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: ഞാൻ നിങ്ങളെ ജനതകളിൽനിന്ന് ശേഖരിച്ച്, നിങ്ങൾ ചിതറിപ്പോയിരിക്കുന്ന രാജ്യങ്ങളിൽനിന്ന് കൂട്ടിച്ചേർത്ത് യിസ്രായേൽദേശം നിങ്ങൾക്ക് തരും.<verse eid="EZK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 11:18" />“അവർ അവിടെ വന്ന്, അതിലെ സകല മലിനബിംബങ്ങളെയും മ്ലേച്ഛവിഗ്രഹങ്ങളെയും നീക്കിക്കളയും. <verse eid="EZK 11:18" /><verse number="19" style="v" sid="EZK 11:19" />അവർ എന്‍റെ ചട്ടങ്ങളിൽ നടന്ന് എന്‍റെ വിധികൾ പ്രമാണിച്ച് ആചരിക്കേണ്ടതിന് ഞാൻ അവർക്ക് വേറൊരു ഹൃദയം നല്കുകയും പുതിയൊരു ആത്മാവിനെ ഉള്ളിൽ ആക്കുകയും ചെയ്യും; കല്ലായുള്ള ഹൃദയം ഞാൻ അവരുടെ ജഡത്തിൽനിന്ന് നീക്കി മാംസമായുള്ള ഹൃദയം അവർക്ക് കൊടുക്കും. <verse eid="EZK 11:19" /><verse number="20" style="v" sid="EZK 11:20" />അവർ എനിക്ക് ജനമായും ഞാൻ അവർക്ക് ദൈവമായും ഇരിക്കും. <verse eid="EZK 11:20" /><verse number="21" style="v" sid="EZK 11:21" />എന്നാൽ അവരുടെ മലിനബിംബങ്ങളുടെയും മ്ലേച്ഛവിഗ്രഹങ്ങളുടെയും ഇഷ്ടം അനുസരിച്ച് നടക്കുന്നവർക്ക്, ഞാൻ അവരുടെ നടപ്പിനു തക്കവിധം അവരുടെ തലമേൽ പകരം കൊടുക്കും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു.<verse eid="EZK 11:21" /></para>
  <para style="s">ദൈവതേജസ്സ് യെരൂശലേം വിടുന്നു</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 11:22" />അനന്തരം കെരൂബുകൾ ചിറകുവിടർത്തി; ചക്രങ്ങളും അവയോടൊപ്പം ഉണ്ടായിരുന്നു; യിസ്രായേലിന്‍റെ ദൈവത്തിന്‍റെ മഹത്ത്വവും അവക്കുമീതെ ഉണ്ടായിരുന്നു. <verse eid="EZK 11:22" /><verse number="23" style="v" sid="EZK 11:23" />യഹോവയുടെ മഹത്വം നഗരത്തിന്‍റെ നടുവിൽനിന്ന് മുകളിലേക്ക് പൊങ്ങി നഗരത്തിന് കിഴക്കുവശത്തുള്ള പർവ്വതത്തിന്മേൽ നിന്നു.<verse eid="EZK 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 11:24" />എന്നാൽ ആത്മാവ് എന്നെ എടുത്ത്, ദർശനത്തിൽ ദൈവാത്മാവിനാൽ തന്നെ, കല്ദയദേശത്ത് പ്രവാസികളുടെ അടുക്കൽ കൊണ്ടുവന്നു; ഞാൻ കണ്ട ദർശനം എന്നെവിട്ടു പൊങ്ങിപ്പോയി. <verse eid="EZK 11:24" /><verse number="25" style="v" sid="EZK 11:25" />ഞാൻ യഹോവ എനിക്ക് വെളിപ്പെടുത്തിയ അവിടുത്തെ സകലവചനങ്ങളും പ്രവാസികളോടു പ്രസ്താവിച്ചു.<verse eid="EZK 11:25" /></para>
  <chapter eid="EZK 11" />
  <chapter number="12" style="c" sid="EZK 12" />
  <para style="s">പ്രവാചകൻ പ്രവാസത്തിലേക്ക്</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 12:1" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായത് എന്തെന്നാൽ: <verse eid="EZK 12:1" /><verse number="2" style="v" sid="EZK 12:2" />“മനുഷ്യപുത്രാ, നീ മത്സരഗൃഹത്തിന്‍റെ നടുവിൽ വസിക്കുന്നു; കാണുവാൻ കണ്ണുണ്ടെങ്കിലും അവർ കാണുന്നില്ല; കേൾക്കുവാൻ ചെവിയുണ്ടെങ്കിലും അവർ കേൾക്കുന്നില്ല; അവർ മത്സരഗൃഹമാണല്ലോ.<verse eid="EZK 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 12:3" />“ആകയാൽ മനുഷ്യപുത്രാ, നീ യാത്രാസാമഗ്രികൾ ഒരുക്കി പകൽ സമയത്ത് അവർ കാണുമ്പോൾ പുറപ്പെടുക; അവർ കാണുമ്പോൾ നിന്‍റെ സ്ഥലം വിട്ട് മറ്റൊരു സ്ഥലത്തേക്ക് യാത്ര പുറപ്പെടുക; മത്സരഗൃഹമെങ്കിലും ഒരുപക്ഷേ അവർ കണ്ടു ഗ്രഹിക്കുമായിരിക്കും. <verse eid="EZK 12:3" /><verse number="4" style="v" sid="EZK 12:4" />നിന്‍റെ സാധനങ്ങൾ നീ പകൽ സമയത്ത് അവർ കാണുമ്പോൾ പുറത്ത് കൊണ്ടുവരേണം; വൈകുന്നേരത്ത് അവർ കാൺകെ പ്രവാസത്തിനു പോകുന്നവരെപ്പോലെ നീ പുറപ്പെടേണം. <verse eid="EZK 12:4" /><verse number="5" style="v" sid="EZK 12:5" />അവർ കാണുമ്പോൾ നീ മതിൽ കുത്തിത്തുരന്ന് അതിൽകൂടി അത് പുറത്തു കൊണ്ടുപോകേണം. <verse eid="EZK 12:5" /><verse number="6" style="v" sid="EZK 12:6" />അവർ കാണുമ്പോൾ നീ അത് തോളിൽ ചുമന്നുകൊണ്ട് ഇരുട്ടത്ത് യാത്ര പുറപ്പെടേണം; നിലം കാണാത്തവിധം നിന്‍റെ മുഖം മൂടിക്കൊള്ളണം; ഞാൻ നിന്നെ യിസ്രായേൽഗൃഹത്തിന് ഒരു അടയാളം ആക്കിയിരിക്കുന്നു.”<verse eid="EZK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 12:7" />എന്നോട് കല്പിച്ചതുപോലെ ഞാൻ ചെയ്തു; യാത്രാസാമഗ്രികൾപോലെ ഞാൻ എന്‍റെ സാധനങ്ങൾ പകൽ സമയത്ത് പുറത്തു കൊണ്ടുവന്ന്, വൈകുന്നേരത്ത് ഞാൻ എന്‍റെ കൈകൊണ്ട് മതിൽ കുത്തിത്തുരന്ന് ഇരുട്ടത്ത് അത് പുറത്തു കൊണ്ടുവന്ന്, അവർ കാണത്തക്കവിധം തോളിൽ ചുമന്നു. <verse eid="EZK 12:7" /><verse number="8" style="v" sid="EZK 12:8" />എന്നാൽ രാവിലെ യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ: <verse eid="EZK 12:8" /><verse number="9" style="v" sid="EZK 12:9" />“മനുഷ്യപുത്രാ, മത്സരഗൃഹമായ യിസ്രായേൽഗൃഹം നിന്നോട്: ‘നീ എന്ത് ചെയ്യുന്നു’ എന്നു ചോദിച്ചില്ലയോ?” <verse eid="EZK 12:9" /><verse number="10" style="v" sid="EZK 12:10" />ഈ അരുളപ്പാടു യെരൂശലേമിലെ ‘പ്രഭുക്കന്മാർക്കും അവരുടെ ചുറ്റും വസിക്കുന്ന എല്ലാ യിസ്രായേൽ ഗൃഹത്തിനും ഉള്ളത്’ എന്നു യഹോവയായ കർത്താവ് അരുളിച്ചെയ്യുന്നു എന്നു നീ അവരോടു പറയുക. <verse eid="EZK 12:10" /><verse number="11" style="v" sid="EZK 12:11" />‘ഞാൻ നിങ്ങൾക്ക് ഒരു അടയാളമാകുന്നു’ എന്നു നീ പറയുക; ഞാൻ ചെയ്തതുപോലെ അവർക്ക് ഭവിക്കും; അവർ നാടുകടന്ന് പ്രവാസത്തിലേക്കു പോകേണ്ടിവരും.<verse eid="EZK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 12:12" />”അവരുടെ ഇടയിലുള്ള പ്രഭു ഇരുട്ടത്ത് തോളിൽ ചുമടുമായി പുറപ്പെടും; അത് പുറത്ത് കൊണ്ടുപോകേണ്ടതിന് അവർ മതിൽ കുത്തിത്തുരക്കും; കണ്ണുകൊണ്ട് നിലം കാണാതിരിക്കത്തക്കവിധം അവൻ മുഖം മൂടും. <verse eid="EZK 12:12" /><verse number="13" style="v" sid="EZK 12:13" />ഞാൻ എന്‍റെ വല അവന്‍റെമേൽ വീശും; അവൻ എന്‍റെ കെണിയിൽ അകപ്പെടും; ഞാൻ അവനെ കല്ദയരുടെ ദേശത്ത് ബാബേലിൽ കൊണ്ടുപോകും; എങ്കിലും അവൻ അതിനെ കാണാതെ അവിടെവച്ച് മരിക്കും. <verse eid="EZK 12:13" /><verse number="14" style="v" sid="EZK 12:14" />അവന്‍റെ ചുറ്റുമുള്ള സഹായികൾ എല്ലാവരെയും അവന്‍റെ പടക്കൂട്ടങ്ങളെ ഒക്കെയും ഞാൻ നാലു ദിക്കിലേക്കും ചിതറിച്ചുകളയുകയും അവരുടെ പിന്നാലെ വാളൂരുകയും ചെയ്യും. <verse eid="EZK 12:14" /><verse number="15" style="v" sid="EZK 12:15" />ഞാൻ അവരെ ജനതകളുടെ ഇടയിൽ ചിതറിച്ച് ദേശങ്ങളിൽ ചിന്നിക്കുമ്പോൾ ഞാൻ യഹോവ എന്നു അവർ അറിയും. <verse eid="EZK 12:15" /><verse number="16" style="v" sid="EZK 12:16" />എന്നാൽ അവർ പോയിരിക്കുന്ന ജനതകളുടെ ഇടയിൽ അവരുടെ സകലമ്ലേച്ഛതകളും വിവരിച്ചു പറയേണ്ടതിന് ഞാൻ അവരിൽ ഏതാനുംപേരെ വാൾ, ക്ഷാമം, മഹാമാരി എന്നിവയിൽനിന്ന് ശേഷിപ്പിക്കും; ഞാൻ യഹോവ എന്നു അവർ അറിയും.”<verse eid="EZK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 12:17" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായത് എന്തെന്നാൽ; <verse eid="EZK 12:17" /><verse number="18" style="v" sid="EZK 12:18" />“മനുഷ്യപുത്രാ, നടുക്കത്തോടെ അപ്പം തിന്നുകയും വിറയലോടും പേടിയോടുംകൂടെ വെള്ളം കുടിക്കുകയും ചെയ്യുക. <verse eid="EZK 12:18" /><verse number="19" style="v" sid="EZK 12:19" />ദേശത്തിലെ ജനത്തോട് നീ പറയേണ്ടത്: ‘യെരൂശലേം നിവാസികളെയും യിസ്രായേൽ ദേശത്തെയും കുറിച്ച് യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: അവരുടെ ദേശം അതിലെ സകലനിവാസികളുടെയും സാഹസംനിമിത്തം അതിന്‍റെ നിറവോടുകൂടി ശൂന്യമായിപ്പോകുന്നതുകൊണ്ട് അവർ പേടിയോടെ അപ്പം തിന്നുകയും അമ്പരപ്പോടെ വെള്ളം കുടിക്കുകയും ചെയ്യും. <verse eid="EZK 12:19" /><verse number="20" style="v" sid="EZK 12:20" />നിവാസികളുള്ള പട്ടണങ്ങൾ ശൂന്യവും ദേശം നിർജ്ജനവും ആയിത്തീരും; ഞാൻ യഹോവ എന്നു നിങ്ങൾ അറിയും.”<verse eid="EZK 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 12:21" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ: <verse eid="EZK 12:21" /><verse number="22" style="v" sid="EZK 12:22" />“മനുഷ്യപുത്രാ, ‘കാലം നീണ്ടുപോകും; ദർശനമൊക്കെയും ഫലിക്കാതെപോകും’ എന്നു നിങ്ങൾക്ക് യിസ്രായേൽ ദേശത്ത് ഒരു പഴഞ്ചൊല്ലുള്ളത് എന്താണ്? <verse eid="EZK 12:22" /><verse number="23" style="v" sid="EZK 12:23" />അതുകൊണ്ട് നീ അവരോടു പറയേണ്ടത്: ‘യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു; “ഞാൻ ഈ പഴഞ്ചൊല്ല് നിർത്തലാക്കും; അവർ യിസ്രായേലിൽ ഇനി അത് ഒരു പഴഞ്ചൊല്ലായി ഉപയോഗിക്കുകയില്ല; കാലവും സകലദർശനത്തിൻ്റെയും നിവൃത്തിയും അടുത്തിരിക്കുന്നു’ എന്നു അവരോട് പ്രസ്താവിക്കുക.”<verse eid="EZK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 12:24" />“യിസ്രായേൽഗൃഹത്തിൽ ഇനി കപടദർശനവും വ്യാജപ്രശ്നവും ഉണ്ടാകുകയില്ല. <verse eid="EZK 12:24" /><verse number="25" style="v" sid="EZK 12:25" />യഹോവയായ ഞാൻ പ്രസ്താവിക്കുവാൻ ഇച്ഛിക്കുന്ന വചനം പ്രസ്താവിക്കും; അത് താമസിയാതെ നിവൃത്തിയാകും; മത്സരഗൃഹമേ, നിങ്ങളുടെ കാലത്ത് തന്നെ ഞാൻ വചനം പ്രസ്താവിക്കുകയും നിവർത്തിക്കുകയും ചെയ്യും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 12:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 12:26" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ: <verse eid="EZK 12:26" /><verse number="27" style="v" sid="EZK 12:27" />“മനുഷ്യപുത്രാ, യിസ്രായേൽഗൃഹം: ‘ഇവൻ ദർശിക്കുന്ന ദർശനം വളരെനാളത്തേക്കുള്ളതും ഇവൻ പ്രവചിക്കുന്നത് ദീർഘകാലത്തേക്കുള്ളതും ആകുന്നു’ എന്നു പറയുന്നു. <verse eid="EZK 12:27" /><verse number="28" style="v" sid="EZK 12:28" />“അതുകൊണ്ട് നീ അവരോടു പറയേണ്ടത്: യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “എന്‍റെ വചനങ്ങളിൽ ഒന്നും ഇനി താമസിക്കുകയില്ല; ഞാൻ പ്രസ്താവിക്കുന്ന വചനം നിവൃത്തിയാകും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 12:28" /></para>
  <chapter eid="EZK 12" />
  <chapter number="13" style="c" sid="EZK 13" />
  <para style="s">വ്യാജപ്രവാചകന്മാർക്ക് അയ്യോ കഷ്ടം!</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 13:1" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ: <verse eid="EZK 13:1" /><verse number="2" style="v" sid="EZK 13:2" />“മനുഷ്യപുത്രാ, യിസ്രായേലിൽ പ്രവചിച്ചുകൊണ്ടിരിക്കുന്ന പ്രവാചകന്മാരെക്കുറിച്ച് നീ ഇപ്രകാരം പ്രവചിക്കുക; സ്വന്തഹൃദയങ്ങളിൽനിന്നു പ്രവചിക്കുന്നവരായ അവരോട് പറയേണ്ടത്: “യഹോവയുടെ വചനം കേൾക്കുവിൻ! <verse eid="EZK 13:2" /><verse number="3" style="v" sid="EZK 13:3" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: ‘സ്വന്തമനസ്സിനെയും കണ്ടിട്ടില്ലാത്ത കാര്യങ്ങളെയും പിന്തുടരുന്ന ബുദ്ധികെട്ട പ്രവാചകന്മാർക്ക് അയ്യോ കഷ്ടം! <verse eid="EZK 13:3" /><verse number="4" style="v" sid="EZK 13:4" />യിസ്രായേലേ, നിന്‍റെ പ്രവാചകന്മാർ ശൂന്യപ്രദേശങ്ങളിലെ കുറുക്കന്മാരെപ്പോലെ ആയിരിക്കുന്നു. <verse eid="EZK 13:4" /><verse number="5" style="v" sid="EZK 13:5" />യഹോവയുടെ നാളിൽ യുദ്ധത്തിൽ ഉറച്ചുനില്ക്കേണ്ടതിന് നിങ്ങൾ ഇടിവുകളിൽ കയറിയിട്ടില്ല, യിസ്രായേൽ ഗൃഹത്തിനുവേണ്ടി മതിൽ കെട്ടിയിട്ടുമില്ല. <verse eid="EZK 13:5" /><verse number="6" style="v" sid="EZK 13:6" />അവർ വ്യാജവും കള്ളപ്രശ്നവും ദർശിച്ചിട്ട് ‘യഹോവയുടെ അരുളപ്പാടു’ എന്നു പറയുന്നു; യഹോവ അവരെ അയച്ചിട്ടില്ലാതിരിക്കെ, വചനം നിവൃത്തിയായി വരുമെന്ന് അവർ ആശിക്കുന്നു. <verse eid="EZK 13:6" /><verse number="7" style="v" sid="EZK 13:7" />ഞാൻ അരുളിച്ചെയ്യാതിരിക്കെ ‘യഹോവയുടെ അരുളപ്പാടു’ എന്നു നിങ്ങൾ പറയുന്നതിനാൽ നിങ്ങൾ കപടദർശനം ദർശിക്കുകയും വ്യാജപ്രശ്നം പറയുകയും അല്ലയോ ചെയ്തിരിക്കുന്നത്?<verse eid="EZK 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 13:8" />“അതുകൊണ്ട് യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: നിങ്ങൾ വ്യാജം പ്രസ്താവിച്ച് കാപട്യം ദർശിച്ചിരിക്കുകകൊണ്ട്, ഞാൻ നിങ്ങൾക്ക് വിരോധമായിരിക്കുന്നു” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്. <verse eid="EZK 13:8" /><verse number="9" style="v" sid="EZK 13:9" />വ്യാജം ദർശിക്കുകയും കള്ളപ്രശ്നം പറയുകയും ചെയ്യുന്ന പ്രവാചകന്മാർക്ക് എന്‍റെ കൈ വിരോധമായിരിക്കും; എന്‍റെ ജനത്തിന്‍റെ ആലോചനാസഭയിൽ അവർ ഇരിക്കുകയില്ല; യിസ്രായേൽ ഗൃഹത്തിന്‍റെ പേരുവിവരപട്ടികയിൽ അവരെ എഴുതുകയില്ല; യിസ്രായേൽദേശത്തിൽ അവർ കടക്കുകയുമില്ല; ഞാൻ യഹോവയായ കർത്താവ് എന്നു നിങ്ങൾ അറിയും. <verse eid="EZK 13:9" /><verse number="10" style="v" sid="EZK 13:10" />സമാധാനം ഇല്ലാതെയിരിക്കുമ്പോൾ “സമാധാനം” എന്നു പറഞ്ഞ് അവർ എന്‍റെ ജനത്തെ ചതിച്ചിരിക്കുകകൊണ്ടും, ഒരുവൻ ഭിത്തി പണിത്, അവർ അതിൽ പാകപ്പെടുത്താത്ത കുമ്മായം പൂശിക്കളയുന്നതുകൊണ്ടും <verse eid="EZK 13:10" /><verse number="11" style="v" sid="EZK 13:11" />അടർന്നുവീഴത്തക്കവണ്ണം കുമ്മായം പൂശുന്നവരോട് നീ പറയേണ്ടത്: “പെരുമഴ ചൊരിയും; ഞാൻ ആലിപ്പഴം പൊഴിയിച്ച് കൊടുങ്കാറ്റ് അടിപ്പിക്കും.” <verse eid="EZK 13:11" /><verse number="12" style="v" sid="EZK 13:12" />“ഭിത്തി വീണിരിക്കുന്നു; നിങ്ങൾ പൂശിയ കുമ്മായം എവിടെപ്പോയി” എന്നു നിങ്ങളോടു പറയുകയില്ലയോ?<verse eid="EZK 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 13:13" />“അതുകൊണ്ട് യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഞാൻ എന്‍റെ ക്രോധത്തിൽ ഒരു കൊടുങ്കാറ്റ് അടിക്കുമാറാക്കും; എന്‍റെ കോപത്തിൽ പെരുമഴ പെയ്യിക്കും; എന്‍റെ ക്രോധത്തിൽ നാശകരമായ വലിയ ആലിപ്പഴം പൊഴിക്കും. <verse eid="EZK 13:13" /><verse number="14" style="v" sid="EZK 13:14" />നിങ്ങൾ കുമ്മായം പൂശിയ ഭിത്തി ഞാൻ ഇങ്ങനെ ഇടിച്ച് നിലത്തു തള്ളിയിട്ട് അതിന്‍റെ അടിസ്ഥാനം വെളിപ്പെടുത്തും; അത് വീഴും; നിങ്ങൾ അതിന്‍റെ നടുവിൽ നശിച്ചുപോകും; ഞാൻ യഹോവ എന്നു നിങ്ങൾ അറിയും.” <verse eid="EZK 13:14" /><verse number="15" style="v" sid="EZK 13:15" />അങ്ങനെ ഞാൻ ഭിത്തിമേലും അതിന് കുമ്മായം പൂശിയവരുടെമേലും എന്‍റെ ക്രോധം നിറവേറ്റിയിട്ട് നിങ്ങളോട്: <verse eid="EZK 13:15" /><verse number="16" style="v" sid="EZK 13:16" />“ഇനി ഭിത്തിയില്ല; അതിന് കുമ്മായം പൂശിയവരായി, യെരൂശലേമിനെക്കുറിച്ച് പ്രവചിച്ച്, സമാധാനമില്ലാതിരിക്കുമ്പോൾ അതിന് സമാധാനദർശനങ്ങളെ ദർശിക്കുന്ന യിസ്രായേലിന്‍റെ പ്രവാചകന്മാരും ഇല്ല” എന്നു പറയും എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 13:17" />“നീയോ, മനുഷ്യപുത്രാ, സ്വന്തവിചാരം പ്രവചിക്കുന്നവരായ നിന്‍റെ ജനത്തിന്‍റെ പുത്രിമാരുടെനേരെ നിന്‍റെ മുഖംതിരിച്ച് അവർക്ക് വിരോധമായി പ്രവചിച്ചു പറയേണ്ടതെന്തെന്നാൽ: <verse eid="EZK 13:17" /><verse number="18" style="v" sid="EZK 13:18" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ദേഹികളെ വേട്ടയാടേണ്ടതിന് കൈത്തണ്ടുകൾക്ക് ഒക്കെയും മാന്ത്രികചരടുകളും, ഏതു ഉയരം ഉള്ളവരുടെയും തലയ്ക്കു യോജിച്ച മൂടുപടങ്ങളും ഉണ്ടാക്കുന്ന സ്ത്രീകൾക്ക് അയ്യോ കഷ്ടം! നിങ്ങൾ എന്‍റെ ജനത്തിൽ ചില ദേഹികളെ വേട്ടയാടി കൊല്ലുകയും നിങ്ങളുടെ ആദായത്തിനായി ചില ദേഹികളെ ജീവനോടെ രക്ഷിക്കുകയും ചെയ്യുന്നു. <verse eid="EZK 13:18" /><verse number="19" style="v" sid="EZK 13:19" />മരിക്കരുതാത്ത ദേഹികളെ കൊല്ലേണ്ടതിനും ജീവിച്ചിരിക്കരുതാത്ത ദേഹികളെ ജീവനോടെ രക്ഷിക്കേണ്ടതിനും നിങ്ങൾ, വ്യാജം കേൾക്കുന്ന എന്‍റെ ജനത്തോടു വ്യാജം പറയുന്നതിനാൽ എന്‍റെ ജനത്തിന്‍റെ ഇടയിൽ ഒരു പിടി യവത്തിനും ഒരു അപ്പക്കഷണത്തിനും വേണ്ടി എന്നെ അശുദ്ധമാക്കിയിരിക്കുന്നു.”<verse eid="EZK 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 13:20" />“അതുകൊണ്ട് യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ദേഹികളെ പക്ഷികളെപ്പോലെ വേട്ടയാടുന്ന നിങ്ങളുടെ മാന്ത്രികചരടുകൾക്ക് ഞാൻ വിരോധമായിരിക്കുന്നു; ഞാൻ അവയെ നിങ്ങളുടെ ഭുജങ്ങളിൽനിന്നു പറിച്ചുകീറി, ദേഹികളെ, നിങ്ങൾ പക്ഷികളെപ്പോലെ വേട്ടയാടുന്ന ദേഹികളെത്തന്നെ, വിടുവിക്കും <verse eid="EZK 13:20" /><verse number="21" style="v" sid="EZK 13:21" />നിങ്ങളുടെ മൂടുപടങ്ങളെയും ഞാൻ പറിച്ചുകീറി എന്‍റെ ജനത്തെ നിങ്ങളുടെ കയ്യിൽനിന്ന് വിടുവിക്കും; അവർ ഇനി നിങ്ങളുടെ കയ്യിൽ വേട്ടയായിരിക്കുകയില്ല; ഞാൻ യഹോവ എന്നു നിങ്ങൾ അറിയും. <verse eid="EZK 13:21" /><verse number="22" style="v" sid="EZK 13:22" />ഞാൻ ദുഃഖിപ്പിക്കാത്ത നീതിമാന്‍റെ ഹൃദയത്തെ നിങ്ങൾ വ്യാജത്താൽ ദുഃഖിപ്പിക്കുകയും തന്‍റെ ദുർമ്മാർഗ്ഗം വിട്ടുതിരിഞ്ഞു ജീവരക്ഷ പ്രാപിക്കാത്തവിധം ദുഷ്ടനെ നിങ്ങൾ ധൈര്യപ്പെടുത്തുകയും ചെയ്യുന്നതുകൊണ്ടു <verse eid="EZK 13:22" /><verse number="23" style="v" sid="EZK 13:23" />നിങ്ങൾ ഇനി വ്യാജം ദർശിക്കുകയോ പ്രശ്നം പറയുകയോ ചെയ്യുകയില്ല; ഞാൻ എന്‍റെ ജനത്തെ നിങ്ങളുടെ കയ്യിൽനിന്നു വിടുവിക്കും; ഞാൻ യഹോവ എന്നു നിങ്ങൾ അറിയും.“<verse eid="EZK 13:23" /></para>
  <chapter eid="EZK 13" />
  <chapter number="14" style="c" sid="EZK 14" />
  <para style="s">വിഗ്രഹാരാധകർ കുറ്റംചുമത്തപ്പെടുന്നു</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 14:1" />യിസ്രായേൽമൂപ്പന്മാരിൽ ചിലർ എന്‍റെ അടുക്കൽവന്ന് എന്‍റെ മുമ്പിൽ ഇരുന്നു. <verse eid="EZK 14:1" /><verse number="2" style="v" sid="EZK 14:2" />അപ്പോൾ യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായത് എന്തെന്നാൽ: <verse eid="EZK 14:2" /><verse number="3" style="v" sid="EZK 14:3" />“മനുഷ്യപുത്രാ, ഈ പുരുഷന്മാർ അവരുടെ വിഗ്രഹങ്ങളെ ഹൃദയത്തിൽ സ്മരിച്ച് അവരുടെ അകൃത്യകാരണം അവരുടെ മുമ്പിൽ വച്ചിരിക്കുന്നു; അവർ ചോദിച്ചാൽ ഞാൻ ഉത്തരമരുളുമോ? <verse eid="EZK 14:3" /><verse number="4" style="v" sid="EZK 14:4" />അതുകൊണ്ട് നീ അവരോടു പറയേണ്ടത്: ‘യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “യിസ്രായേൽഗൃഹത്തിൽ തന്‍റെ വിഗ്രഹങ്ങളെ ഹൃദയത്തിൽ സ്മരിച്ചും തന്‍റെ അകൃത്യകാരണം തന്‍റെ മുമ്പിൽ വച്ചുംകൊണ്ട് പ്രവാചകന്‍റെ അടുക്കൽ വരുന്ന ഏവനോടും യഹോവയായ ഞാൻ തന്നെ യിസ്രായേൽഗൃഹത്തെ അവരുടെ ഹൃദയത്തെ പിടിച്ചടക്കേണ്ടതിന്, അവന്‍റെ വിഗ്രഹങ്ങളുടെ ബഹുത്വത്തിനു തക്കവണ്ണം ഉത്തരം അരുളും; <verse eid="EZK 14:4" /><verse number="5" style="v" sid="EZK 14:5" />അവർ എല്ലാവരും അവരുടെ വിഗ്രഹങ്ങൾനിമിത്തം എന്നെ വിട്ടകന്നിരിക്കുന്നുവല്ലോ.”<verse eid="EZK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 14:6" />അതിനാൽ നീ യിസ്രായേൽ ഗൃഹത്തോട് പറയേണ്ടത്: “യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: നിങ്ങൾ അനുതപിച്ച് നിങ്ങളുടെ വിഗ്രഹങ്ങളെ വിട്ടുതിരിയുവിൻ; നിങ്ങളുടെ സകല മ്ലേച്ഛബിംബങ്ങളിൽ നിന്നും നിങ്ങളുടെ മുഖം തിരിക്കുവിൻ. <verse eid="EZK 14:6" /><verse number="7" style="v" sid="EZK 14:7" />യിസ്രായേൽഗൃഹത്തിലും യിസ്രായേലിൽ വന്നുപാർക്കുന്ന പരദേശികളിലും എന്നെ വിട്ടകന്ന് തന്‍റെ വിഗ്രഹങ്ങളെ ഹൃദയത്തിൽ സ്മരിച്ചും തന്‍റെ അകൃത്യകാരണം മുമ്പിൽ വച്ചുംകൊണ്ട് പ്രവാചകന്‍റെ അടുക്കൽ അരുളപ്പാടു ചോദിക്കുവാൻ വരുന്ന ഏവനോടും യഹോവയായ ഞാൻ തന്നെ ഉത്തരം അരുളും. <verse eid="EZK 14:7" /><verse number="8" style="v" sid="EZK 14:8" />ഞാൻ ആ മനുഷ്യന്‍റെ നേരെ മുഖംതിരിച്ച് അവനെ ഒരടയാളവും പഴഞ്ചൊല്ലും ആക്കും; ഞാൻ അവനെ എന്‍റെ ജനത്തിന്‍റെ നടുവിൽനിന്ന് ഛേദിച്ചുകളയും; ഞാൻ യഹോവ എന്നു നിങ്ങൾ അറിയും.<verse eid="EZK 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 14:9" />”എന്നാൽ പ്രവാചകൻ വശീകരിക്കപ്പെട്ടിട്ട് ഒരു വാക്കു പ്രസ്താവിച്ചാൽ യഹോവയായ ഞാൻ ആ പ്രവാചകനെ വശീകരിച്ചിരിക്കുന്നു; ഞാൻ അവന്‍റെനേരെ കൈ നീട്ടി അവനെ യിസ്രായേൽ ജനത്തിൽനിന്ന് സംഹരിച്ചുകളയും. <verse eid="EZK 14:9" /><verse number="10" style="v" sid="EZK 14:10" />യിസ്രായേൽഗൃഹം ഇനി മേൽ എന്നെവിട്ടു തെറ്റിപ്പോകുകയും സകലവിധ ലംഘനങ്ങളുംകൊണ്ട് അശുദ്ധരായിത്തീരുകയും ചെയ്യാതെ അവർ എനിക്ക് ജനവും ഞാൻ അവർക്ക് ദൈവവും ആയിരിക്കേണ്ടതിന് <verse eid="EZK 14:10" /><verse number="11" style="v" sid="EZK 14:11" />അവർ അവരുടെ അകൃത്യം വഹിക്കും; ചോദിക്കുന്നവൻ്റെ അകൃത്യവും പ്രവാചകന്‍റെ അകൃത്യവും ഒരുപോലെ ആയിരിക്കും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 14:11" /></para>
  <para style="s">നോഹ, ദാനീയേൽ, ഇയ്യോബ്</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 14:12" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ: <verse eid="EZK 14:12" /><verse number="13" style="v" sid="EZK 14:13" />“മനുഷ്യപുത്രാ ഒരു ദേശം എന്നോട് ദ്രോഹിച്ച് പാപം ചെയ്യുമ്പോൾ ഞാൻ അതിന്‍റെ നേരെ കൈ നീട്ടി, അപ്പം എന്ന കോൽ ഒടിച്ച്, ക്ഷാമം വരുത്തി, മനുഷ്യനെയും മൃഗത്തെയും അതിൽ നിന്നു ഛേദിച്ചുകളയും. <verse eid="EZK 14:13" /><verse number="14" style="v" sid="EZK 14:14" />നോഹ, ദാനീയേൽ, ഇയ്യോബ് എന്നീ മൂന്നു പുരുഷന്മാർ അതിൽ ഉണ്ടായിരുന്നാലും അവർ അവരുടെ നീതിയാൽ സ്വന്തജീവനെ മാത്രമേ രക്ഷിക്കുകയുള്ളു” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു.<verse eid="EZK 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 14:15" />”ഞാൻ ദുഷ്ടമൃഗങ്ങളെ ദേശത്തു വരുത്തുകയും ആ മൃഗങ്ങളെ ഭയന്ന് ആരും വഴിപോകാത്തവിധം അവ അതിനെ നിർജ്ജനമാക്കിയിട്ട് അത് ശൂന്യമാകുകയും ചെയ്താൽ, <verse eid="EZK 14:15" /><verse number="16" style="v" sid="EZK 14:16" />ആ മൂന്നു പുരുഷന്മാർ അതിൽ ഉണ്ടായിരുന്നാലും എന്നാണ, അവർക്ക് പുത്രന്മാരെയോ പുത്രിമാരെയോ രക്ഷിക്കുവാൻ സാധിക്കാതെ അവർ മാത്രമേ രക്ഷപ്പെടുകയുള്ളു; ദേശമോ ശൂന്യമായിപ്പോകുമെന്ന്” യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു.<verse eid="EZK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 14:17" />”അല്ലെങ്കിൽ ഞാൻ ആ ദേശത്ത് വാൾ വരുത്തി ‘വാളേ, നീ ദേശത്തുകൂടി കടക്കുക’ എന്നു കല്പിച്ച് മനുഷ്യരെയും മൃഗങ്ങളെയും <verse eid="EZK 14:17" /><verse number="18" style="v" sid="EZK 14:18" />അതിൽനിന്ന് ഛേദിച്ചുകളഞ്ഞാൽ ആ മൂന്നു പുരുഷന്മാർ അതിൽ ഉണ്ടായിരുന്നാലും, എന്നാണ, അവർക്ക് പുത്രന്മാരെയോ പുത്രിമാരെയോ രക്ഷിക്കുവാൻ സാധിക്കാതെ, അവർ മാത്രമേ രക്ഷപ്പെടുകയുള്ളു” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു.<verse eid="EZK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 14:19" />”അല്ലെങ്കിൽ ഞാൻ ആ ദേശത്ത് മഹാമാരി അയച്ച്, അതിൽനിന്ന് മനുഷ്യരെയും മൃഗങ്ങളെയും ഛേദിച്ചുകളയുവാൻ തക്കവിധം എന്‍റെ ക്രോധം രക്തരൂപേണ അതിന്മേൽ പകർന്നാൽ <verse eid="EZK 14:19" /><verse number="20" style="v" sid="EZK 14:20" />നോഹയും ദാനീയേലും ഇയ്യോബും അതിൽ ഉണ്ടായിരുന്നാലും, എന്നാണ, അവർ പുത്രനെയോ പുത്രിയെയോ രക്ഷിക്കാതെ അവരുടെ നീതിയാൽ സ്വന്തജീവനെ മാത്രമേ രക്ഷിക്കുകയുള്ളു” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 14:21" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഞാൻ യെരൂശലേമിൽ നിന്നു മനുഷ്യരെയും മൃഗങ്ങളെയും ഛേദിച്ചുകളയേണ്ടതിന് വാൾ, ക്ഷാമം, ദുഷ്ടമൃഗം, മഹാമാരി എന്നിങ്ങനെ അനർത്ഥകരമായ ന്യായവിധികൾ നാലും കൂടി അയച്ചാലോ? <verse eid="EZK 14:21" /><verse number="22" style="v" sid="EZK 14:22" />എന്നാൽ പുറപ്പെട്ടു പോരുവാനുള്ള പുത്രന്മാരും പുത്രിമാരും ആയ ഒരു രക്ഷിതഗണം അതിൽ ശേഷിച്ചിരിക്കും; അവർ പുറപ്പെട്ടു നിങ്ങളുടെ അടുക്കൽ വരും; നിങ്ങൾ അവരുടെ നടപ്പും പ്രവൃത്തികളും കണ്ടു, ഞാൻ യെരൂശലേമിനു വരുത്തിയ അനർത്ഥവും അതിന് വരുത്തിയ സകലവും ചൊല്ലി ആശ്വാസം പ്രാപിക്കും. <verse eid="EZK 14:22" /><verse number="23" style="v" sid="EZK 14:23" />നിങ്ങൾ അവരുടെ നടപ്പും പ്രവൃത്തികളും കാണുമ്പോൾ നിങ്ങൾക്ക് ആശ്വാസമായിരിക്കും; ഞാൻ അതിൽ ചെയ്തിരിക്കുന്നതെല്ലാം വെറുതെയല്ല ചെയ്തത് എന്നു നിങ്ങൾ അറിയും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 14:23" /></para>
  <chapter eid="EZK 14" />
  <chapter number="15" style="c" sid="EZK 15" />
  <para style="s">യെരൂശലേം പ്രയോജനമില്ലാത്ത ഒരു മുന്തിരിവള്ളി</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 15:1" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ: <verse eid="EZK 15:1" /><verse number="2" style="v" sid="EZK 15:2" />“മനുഷ്യപുത്രാ, കാട്ടിലെ വൃക്ഷങ്ങളുടെ ഇടയിൽ ഒരു ചെടിയായിരിക്കുന്ന മുന്തിരിവള്ളിക്ക് മറ്റു വൃക്ഷങ്ങളെക്കാൾ എന്ത് വിശേഷതയുള്ളു? <verse eid="EZK 15:2" /><verse number="3" style="v" sid="EZK 15:3" />ഏതെങ്കിലും പണിക്ക് അതിൽനിന്ന് മരത്തടി എടുക്കാമോ? ഏതെങ്കിലും സാധനം തൂക്കിയിടേണ്ടതിന് അതുകൊണ്ട് ഒരാണി ഉണ്ടാക്കാമോ? <verse eid="EZK 15:3" /><verse number="4" style="v" sid="EZK 15:4" />അതിനെ തീക്ക് ഇരയായി കൊടുക്കുന്നു; തീ അതിന്‍റെ രണ്ടറ്റവും ദഹിപ്പിച്ചിരിക്കുന്നു; അതിന്‍റെ നടുമുറിയും വെന്തിരിക്കുന്നു; ഇനി അത് ഏതെങ്കിലും പണിക്ക് കൊള്ളുമോ? <verse eid="EZK 15:4" /><verse number="5" style="v" sid="EZK 15:5" />അത് മുഴുവനായിരുന്നപ്പോൾതന്നെ ഒരു പണിക്കും ഉപയോഗമില്ലാതിരുന്നു; തീ അതിനെ ദഹിപ്പിക്കുകയും അത് ദഹിച്ചുപോകുകയും ചെയ്തശേഷം ഏതെങ്കിലും പണിക്ക് ഉപകരിക്കുമോ?”<verse eid="EZK 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 15:6" />അതുകൊണ്ട് യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “കാട്ടിലെ വൃക്ഷങ്ങളിൽ ഞാൻ തീക്കിരയാക്കിക്കൊടുത്ത മുന്തിരിവള്ളിയെപ്പോലെ ഞാൻ യെരൂശലേം നിവാസികളെയും ആക്കും. <verse eid="EZK 15:6" /><verse number="7" style="v" sid="EZK 15:7" />ഞാൻ അവർക്ക് വിരോധമായി മുഖം തിരിക്കും; അവർ തീയിൽനിന്നു പുറപ്പെട്ടിരിക്കുന്നു എങ്കിലും അവർ തീക്കിരയായിത്തീരും; ഞാൻ അവർക്ക് വിരോധമായി മുഖം തിരിക്കുമ്പോൾ ഞാൻ യഹോവ എന്നു നിങ്ങൾ അറിയും. <verse eid="EZK 15:7" /><verse number="8" style="v" sid="EZK 15:8" />അവർ ദ്രോഹം ചെയ്യുകകൊണ്ട് ഞാൻ ദേശത്തെ ശൂന്യമാക്കും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 15:8" /></para>
  <chapter eid="EZK 15" />
  <chapter number="16" style="c" sid="EZK 16" />
  <para style="s">യെരൂശലേമിന്‍റെ അവിശ്വസ്തത</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 16:1" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായത് എന്തെന്നാൽ: <verse eid="EZK 16:1" /><verse number="2" style="v" sid="EZK 16:2" />“മനുഷ്യപുത്രാ, നീ യെരൂശലേമിനോട് അതിന്‍റെ മ്ലേച്ഛതകളെ അറിയിച്ചു പറയേണ്ടത്: <verse eid="EZK 16:2" /><verse number="3" style="v" sid="EZK 16:3" />യഹോവയായ കർത്താവ് യെരൂശലേമിനോട് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: ‘നിന്‍റെ ഉത്ഭവവും ജനനവും കനാൻദേശത്താകുന്നു; നിന്‍റെ അപ്പൻ അമോര്യനും അമ്മ ഹിത്യസ്ത്രീയും അത്രേ. <verse eid="EZK 16:3" /><verse number="4" style="v" sid="EZK 16:4" />നിന്‍റെ ജനനവസ്തുതയോ - ജനിച്ചനാളിൽ നിന്‍റെ പൊക്കിൾക്കൊടി മുറിച്ചിരുന്നില്ല; നിന്നെ വെള്ളത്തിൽ കുളിപ്പിച്ച് വെടിപ്പാക്കിയില്ല; ഉപ്പ് തേച്ചിരുന്നില്ല, തുണി ചുറ്റിയതുമില്ല. <verse eid="EZK 16:4" /><verse number="5" style="v" sid="EZK 16:5" />നിന്നോട് മനസ്സലിവു തോന്നിയിട്ട് ഇവയിൽ ഒന്നെങ്കിലും നിനക്കു ചെയ്തുതരുവാൻ ഒരു കണ്ണിനും നിന്നോട് കനിവുണ്ടായില്ല; നീ ജനിച്ചനാളിൽ തന്നെ അവർക്ക് നിന്നോട് വെറുപ്പുതോന്നിയതുകൊണ്ട് നിന്നെ വെളിമ്പ്രദേശത്ത് ഇട്ടുകളഞ്ഞു.<verse eid="EZK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 16:6" />“എന്നാൽ ഞാൻ നിന്‍റെ സമീപത്ത് കൂടി കടന്നുപോകുമ്പോൾ നീ രക്തത്തിൽ കിടന്നുരുളുന്നതു കണ്ടു നിന്നോട്: “നീ രക്തത്തിൽ കിടക്കുന്നു എങ്കിലും ജീവിക്കുക” എന്നു കല്പിച്ചു; “അതേ, നീ രക്തത്തിൽ കിടക്കുന്നു എങ്കിലും ജീവിക്കുക” എന്നു ഞാൻ നിന്നോട് കല്പിച്ചു. <verse eid="EZK 16:6" /><verse number="7" style="v" sid="EZK 16:7" />വയലിലെ സസ്യംപോലെ ഞാൻ നിന്നെ വർദ്ധിപ്പിച്ചു; നീ വളർന്നു വലിയവളായി അതിസൗന്ദര്യം പ്രാപിച്ചു; നിനക്കു ഉന്നതസ്തനവും ദീർഘകേശവും ഉണ്ടായി; എങ്കിലും നീ നഗ്നയും അനാവൃതയും ആയിരുന്നു.<verse eid="EZK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 16:8" />“ഞാൻ നിന്‍റെ അരികിൽ കൂടി കടന്ന് നിന്നെ നോക്കിയപ്പോൾ നിനക്കു പ്രേമത്തിൻ്റെ സമയമായി എന്നു മനസ്സിലാക്കി, എന്‍റെ വസ്ത്രം നിന്‍റെമേൽ വിരിച്ച് നിന്‍റെ നഗ്നത മറച്ചു; ഞാൻ നിന്നോട് സത്യവും നിയമവും ചെയ്തു നീ എനിക്കുള്ളവൾ ആയിത്തീർന്നു” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു.<verse eid="EZK 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 16:9" />“പിന്നെ ഞാൻ നിന്നെ വെള്ളത്തിൽ കുളിപ്പിച്ച്, രക്തം കഴുകിക്കളഞ്ഞ് എണ്ണപൂശി. <verse eid="EZK 16:9" /><verse number="10" style="v" sid="EZK 16:10" />ഞാൻ നിന്നെ വിചിത്രവസ്ത്രം ധരിപ്പിച്ച്, തഹശുതോൽകൊണ്ടുള്ള ചെരിപ്പിടുവിച്ചു; ശണപടംകൊണ്ടു ചുറ്റി പട്ട് പുതപ്പിച്ചു. <verse eid="EZK 16:10" /><verse number="11" style="v" sid="EZK 16:11" />ഞാൻ നിന്നെ ആഭരണം അണിയിച്ച് നിന്‍റെ കൈയ്ക്ക് വളയും കഴുത്തിൽ മാലയും ഇട്ടു. <verse eid="EZK 16:11" /><verse number="12" style="v" sid="EZK 16:12" />ഞാൻ നിന്‍റെ മൂക്കിനു മൂക്കുത്തിയും കാതിൽ കുണുക്കും ഇട്ടു, തലയിൽ ഭംഗിയുള്ള ഒരു കിരീടവും വച്ചു. <verse eid="EZK 16:12" /><verse number="13" style="v" sid="EZK 16:13" />ഇങ്ങനെ നീ പൊന്നും വെള്ളിയും അണിഞ്ഞു; നിന്‍റെ ഉടുപ്പ് ശണപടവും പട്ടും വിചിത്രവസ്ത്രവും ആയിരുന്നു; നീ നേരിയമാവും തേനും എണ്ണയും ഭക്ഷിച്ച് ഏറ്റവും സൗന്ദര്യമുള്ളവളായിത്തീർന്നു; നീ രാജത്വവും പ്രാപിച്ചു. <verse eid="EZK 16:13" /><verse number="14" style="v" sid="EZK 16:14" />ഞാൻ നിന്നെ അണിയിച്ച അലങ്കാരംകൊണ്ട് നിന്‍റെ സൗന്ദര്യം പരിപൂർണ്ണമായതിനാൽ നിന്‍റെ കീർത്തി ജനതകളുടെ ഇടയിൽ പരന്നു” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 16:15" />“എന്നാൽ നീ നിന്‍റെ സൗന്ദര്യത്തിൽ ആശ്രയിച്ച്, നിന്‍റെ കീർത്തി ഹേതുവായി പരസംഗം ചെയ്തു; വഴിപോകുന്ന എല്ലാവരോടും ഒപ്പം പരസംഗം ചെയ്തു. <verse eid="EZK 16:15" /><verse number="16" style="v" sid="EZK 16:16" />നിന്‍റെ വസ്ത്രങ്ങളിൽ ചിലതു നീ എടുത്ത്, പല നിറത്തിൽ പൂജാഗിരികളെ തീർത്ത്, അലങ്കരിച്ച്, അവയുടെമേൽ പരസംഗം ചെയ്തു; ഇത് ഒരിടത്തും സംഭവിച്ചിട്ടില്ല, സംഭവിക്കുകയും ഇല്ല. <verse eid="EZK 16:16" /><verse number="17" style="v" sid="EZK 16:17" />ഞാൻ നിനക്കു തന്ന പൊന്നും വെള്ളിയും കൊണ്ടുള്ള ആഭരണങ്ങൾ നീ എടുത്ത്, പുരുഷരൂപങ്ങൾ ഉണ്ടാക്കി അവയോടു പരസംഗം ചെയ്തു. <verse eid="EZK 16:17" /><verse number="18" style="v" sid="EZK 16:18" />നിന്‍റെ വിചിത്രവസ്ത്രങ്ങൾ നീ എടുത്ത് അവയെ പുതപ്പിച്ച്, എന്‍റെ എണ്ണയും കുന്തുരുക്കവും അവയുടെ മുമ്പിൽവച്ചു. <verse eid="EZK 16:18" /><verse number="19" style="v" sid="EZK 16:19" />ഞാൻ നിനക്കു തന്ന ആഹാരമായി, നിന്‍റെ പോഷണത്തിനുള്ള നേരിയമാവും എണ്ണയും തേനും നീ അവയുടെ മുമ്പിൽ സൗരഭ്യവാസനയായി നിവേദിച്ചു; ഇങ്ങനെയാണ് സംഭവിച്ചത്” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 16:20" />“നീ എനിക്ക് പ്രസവിച്ച നിന്‍റെ പുത്രന്മാരെയും പുത്രിമാരെയും നീ എടുത്ത് അവയ്ക്കു ഭോജനബലിയായി അർപ്പിച്ചു. <verse eid="EZK 16:20" /><verse number="21" style="v" sid="EZK 16:21" />നിന്‍റെ പരസംഗം പോരാഞ്ഞിട്ടോ നീ എന്‍റെ മക്കളെ അറുത്ത് അഗ്നിപ്രവേശം ചെയ്യിച്ച് അവയ്ക്കു ഏല്പിച്ചുകൊടുത്തത്? <verse eid="EZK 16:21" /><verse number="22" style="v" sid="EZK 16:22" />എന്നാൽ നിന്‍റെ സകലമ്ലേച്ഛതകളിലും പരസംഗങ്ങളിലും നീ മുമ്പ് നഗ്നയും അനാവൃതയും ആയി രക്തത്തിൽ കിടന്നുരുണ്ട നിന്‍റെ യൗവനകാലം ഓർത്തില്ല.<verse eid="EZK 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 16:23" />നിന്‍റെ ദുഷ്ടതയെല്ലാം പ്രവർത്തിച്ചശേഷം ”നിനക്കു കഷ്ടം, കഷ്ടം!” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്. <verse eid="EZK 16:23" /><verse number="24" style="v" sid="EZK 16:24" />“നീ ഒരു കമാനം പണിത്, സകലവീഥിയിലും ഓരോ പൂജാഗിരി ഉണ്ടാക്കി. <verse eid="EZK 16:24" /><verse number="25" style="v" sid="EZK 16:25" />എല്ലാ വഴിത്തലക്കലും പൂജാഗിരി പണിത്, നീ നിന്‍റെ സൗന്ദര്യത്തെ വഷളാക്കി, വഴിപോകുന്ന ഏവനും നിന്‍റെ കാലുകൾ അകത്തി നിന്‍റെ പരസംഗം വർദ്ധിപ്പിച്ചു. <verse eid="EZK 16:25" /><verse number="26" style="v" sid="EZK 16:26" />മാംസപുഷ്ടിയുള്ള മിസ്രയീം നിവാസികളായ നിന്‍റെ അയല്ക്കാരോടും നീ പരസംഗം ചെയ്തു, എന്നെ കോപിപ്പിക്കേണ്ടതിന് നിന്‍റെ പരസംഗം വർദ്ധിപ്പിച്ചു. <verse eid="EZK 16:26" /><verse number="27" style="v" sid="EZK 16:27" />അതുകൊണ്ട് ഞാൻ നിന്‍റെനേരെ കൈ നീട്ടി, നിന്‍റെ നിത്യച്ചെലവു കുറച്ച്, നിന്നെ ദ്വേഷിക്കുകയും നിന്‍റെ ദുർമ്മാർഗ്ഗത്തെക്കുറിച്ചു ലജ്ജിക്കുകയും ചെയ്യുന്ന ഫെലിസ്ത്യപുത്രിമാരുടെ ഇഷ്ടത്തിനു നിന്നെ ഏല്പിച്ചു. <verse eid="EZK 16:27" /><verse number="28" style="v" sid="EZK 16:28" />നീ തൃപ്തി വരാത്തവളാകയാൽ അശ്ശൂര്യരോടും പരസംഗം ചെയ്തു; അവരുമായി പരസംഗം ചെയ്തിട്ടും നിനക്കു തൃപ്തി വന്നില്ല. <verse eid="EZK 16:28" /><verse number="29" style="v" sid="EZK 16:29" />നീ കനാൻദേശത്തും കല്ദയദേശംവരെയും നിന്‍റെ പരസംഗം വർദ്ധിപ്പിച്ചു; അതുകൊണ്ടും നിനക്കു തൃപ്തി വന്നില്ല.<verse eid="EZK 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 16:30" />“നാണംകെട്ട വേശ്യയുടെ പ്രവൃത്തിയായിരിക്കുന്ന ഇതൊക്കെയും ചെയ്തതിൽ, നീ എല്ലാ വഴിത്തലക്കലും കമാനം പണിത്, സകലവീഥിയിലും പൂജാഗിരി ഉണ്ടാക്കിയതിൽ, <verse eid="EZK 16:30" /><verse number="31" style="v" sid="EZK 16:31" />നിന്‍റെ ഹൃദയം എത്ര വഷളത്വം പൂണ്ടിരിക്കുന്നു” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്; “നീ കൂലി നിരസിക്കുന്നതുകൊണ്ട് വേശ്യയെപ്പോലെയല്ല. <verse eid="EZK 16:31" /><verse number="32" style="v" sid="EZK 16:32" />ഭർത്താവിനു പകരം അന്യന്മാരെ സ്വീകരിച്ച് വ്യഭിചാരം ചെയ്യുന്ന സ്ത്രീയേ! <verse eid="EZK 16:32" /><verse number="33" style="v" sid="EZK 16:33" />സകലവേശ്യാസ്ത്രീകളും സമ്മാനം വാങ്ങുന്നു; നീയോ നിന്‍റെ സകലജാരന്മാർക്കും സമ്മാനം നല്കുകയും നീയുമായി പരസംഗം ചെയ്യേണ്ടതിന് നാലുപുറത്തുനിന്നും നിന്‍റെ അടുക്കൽ വരുവാൻ അവർക്ക് കൈക്കൂലി കൊടുക്കുകയും ചെയ്യുന്നു. <verse eid="EZK 16:33" /><verse number="34" style="v" sid="EZK 16:34" />നിന്‍റെ പരസംഗത്തിൽ നിനക്കു മറ്റു സ്ത്രീകളുമായി ഒരു വ്യത്യാസം ഉണ്ട്; നിന്‍റെ അടുക്കൽ പരസംഗത്തിന് ആരും വരുന്നില്ല; നീ സമ്മാനം വാങ്ങുകയല്ല, സമ്മാനം കൊടുക്കുകയാകുന്നു ചെയ്യുന്നത്; അതിലാകുന്നു വ്യത്യാസം ഉള്ളത്.<verse eid="EZK 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 16:35" />ആകയാൽ വേശ്യാസ്ത്രീയേ, യഹോവയുടെ വചനം കേൾക്കുക. <verse eid="EZK 16:35" /><verse number="36" style="v" sid="EZK 16:36" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ജാരന്മാരുമായുള്ള നിന്‍റെ പരസംഗങ്ങളാൽ നിന്‍റെ പണം ചെലവഴിക്കുകയും നിന്‍റെ നഗ്നത അനാവൃതമാകുകയും ചെയ്യുകകൊണ്ട്, നിന്‍റെ സകലമ്ലേച്ഛവിഗ്രഹങ്ങളും നിമിത്തവും നീ അവയ്ക്കു കൊടുത്ത നിന്‍റെ മക്കളുടെ രക്തംനിമിത്തവും <verse eid="EZK 16:36" /><verse number="37" style="v" sid="EZK 16:37" />നീ രമിച്ച നിന്‍റെ സകലജാരന്മാരെയും നീ സ്നേഹിച്ച ഏവരെയും നീ പകച്ച ഏവരെയും ഞാൻ കൂട്ടിവരുത്തും; ഞാൻ അവരെ നിനക്കു വിരോധമായി ചുറ്റും കൂട്ടിവരുത്തി, അവർ നിന്‍റെ നഗ്നത കാണത്തക്കവണ്ണം നിന്‍റെ നഗ്നത അവരുടെ മുമ്പിൽ അനാവൃതമാക്കും. <verse eid="EZK 16:37" /><verse number="38" style="v" sid="EZK 16:38" />വ്യഭിചരിക്കുകയും രക്തം ചൊരിയുകയും ചെയ്യുന്ന സ്ത്രീകളെ വിധിക്കുന്നതുപോലെ ഞാൻ നിന്നെ ന്യായംവിധിച്ച് ക്രോധത്തിൻ്റെയും ജാരശങ്കയുടെയും രക്തം നിന്‍റെമേൽ ചൊരിയും. <verse eid="EZK 16:38" /><verse number="39" style="v" sid="EZK 16:39" />ഞാൻ നിന്നെ അവരുടെ കയ്യിൽ ഏല്പിക്കും; അവർ നിന്‍റെ കമാനം പൊളിച്ച്, നിന്‍റെ പൂജാഗിരികളെ ഇടിച്ചുകളയും; അവർ നിന്‍റെ വസ്ത്രം അഴിച്ച് ആഭരണങ്ങൾ എടുത്ത്, നിന്നെ നഗ്നയും അനാവൃതയും ആക്കിവിടും. <verse eid="EZK 16:39" /><verse number="40" style="v" sid="EZK 16:40" />അവർ നിനക്കു വിരോധമായി ഒരു സഭയെ കൂട്ടിവരുത്തി നിന്നെ കല്ലെറിഞ്ഞ് വാൾകൊണ്ടു വെട്ടിക്കളയും. <verse eid="EZK 16:40" /><verse number="41" style="v" sid="EZK 16:41" />അവർ നിന്‍റെ വീടുകളെ തീവച്ചു ചുട്ടുകളയും; അനേകം സ്ത്രീകളുടെ കണ്മുമ്പിൽ നിന്‍റെമേൽ ന്യായവിധി നടത്തും; നിന്‍റെ പരസംഗം ഞാൻ നിർത്തലാക്കും; നീ ഇനി ആർക്കും കൂലി കൊടുക്കുകയില്ല. <verse eid="EZK 16:41" /><verse number="42" style="v" sid="EZK 16:42" />ഇങ്ങനെ ഞാൻ എന്‍റെ ക്രോധം നിന്നിൽ നിവർത്തിച്ചിട്ട് എന്‍റെ തീക്ഷ്ണത നിന്നെ വിട്ടുമാറും; പിന്നെ ഞാൻ കോപിക്കാതെ അടങ്ങിയിരിക്കും. <verse eid="EZK 16:42" /><verse number="43" style="v" sid="EZK 16:43" />നീ നിന്‍റെ യൗവനകാലം ഓർക്കാതെ ഇവയാൽ ഒക്കെയും എന്നെ കോപിപ്പിച്ചതുകൊണ്ട്, ഞാനും നിന്‍റെ നടപ്പിനു തക്കവണ്ണം നിനക്കു പകരം ചെയ്യും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്; “നിന്‍റെ സകലമ്ലേച്ഛതകൾക്കും പുറമെ നീ ഈ ദുഷ്കർമ്മവും ചെയ്തിട്ടില്ലയോ.<verse eid="EZK 16:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="EZK 16:44" />പഴഞ്ചൊല്ല് പറയുന്നവനെല്ലാം: “യഥാമാതാതഥാപുത്രീ” <note caller="+" style="f"><char style="fr" closed="false">16:44 </char><char style="fq" closed="false">“യഥാമാതാതഥാപുത്രീ” </char><char style="ft" closed="false">അമ്മ എപ്രകാരമോ അതുപോൽ തന്നെ മകളും </char></note>എന്നുള്ള പഴഞ്ചൊല്ല് നിന്നെക്കുറിച്ച് പറയും. <verse eid="EZK 16:44" /><verse number="45" style="v" sid="EZK 16:45" />നീ ഭർത്താവിനെയും മക്കളെയും വെറുക്കുന്ന അമ്മയുടെ മകളും, ഭർത്താക്കന്മാരെയും മക്കളെയും വെറുത്തിരിക്കുന്ന സഹോദരിമാർക്കു നീ സഹോദരിയുമാകുന്നു; നിങ്ങളുടെ അമ്മ ഹിത്യസ്ത്രീയും അപ്പൻ അമോര്യനും ആയിരുന്നു. <verse eid="EZK 16:45" /><verse number="46" style="v" sid="EZK 16:46" />നിന്‍റെ ജ്യേഷ്ഠത്തി നിന്‍റെ ഇടത്തുഭാഗത്ത് തന്‍റെ പുത്രിമാരുമായി പാർക്കുന്ന ശമര്യ; നിന്‍റെ അനുജത്തി നിന്‍റെ വലത്തുഭാഗത്ത് തന്‍റെ പുത്രിമാരുമായി പാർക്കുന്ന സൊദോം. <verse eid="EZK 16:46" /><verse number="47" style="v" sid="EZK 16:47" />നീ അവരുടെ വഴികളിൽ നടന്നില്ല; അവരുടെ മ്ലേച്ഛതകൾപോലെ ചെയ്തില്ല; അത് പോരാ എന്നുവച്ച് നീ നിന്‍റെ എല്ലാ വഴികളിലും അവരെക്കാൾ അധികം വഷളത്വം പ്രവർത്തിച്ചു. <verse eid="EZK 16:47" /><verse number="48" style="v" sid="EZK 16:48" />എന്നാണ, നീയും നിന്‍റെ പുത്രിമാരും ചെയ്തിരിക്കുന്നതുപോലെ നിന്‍റെ സഹോദരിയായ സൊദോമും അവളുടെ പുത്രിമാരും ചെയ്തിട്ടില്ല” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 16:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="EZK 16:49" />“നിന്‍റെ സഹോദരിയായ സൊദോമിൻ്റെ അകൃത്യമോ: ഗർവ്വവും അമിതഭക്ഷണവും അലസജീവിതവും തന്നെ. അത് അവൾക്കും അവളുടെ പുത്രിമാർക്കും ഉണ്ടായിരുന്നു; എളിയവനെയും ദരിദ്രനെയും അവൾ സഹായിച്ചതുമില്ല. <verse eid="EZK 16:49" /><verse number="50" style="v" sid="EZK 16:50" />അവർ അഹങ്കാരികളായി എന്‍റെ മുമ്പിൽ മ്ലേച്ഛത ചെയ്തു; അതുകൊണ്ട് എനിക്ക് ബോധിച്ചതുപോലെ ഞാൻ അവരെ നീക്കിക്കളഞ്ഞു.<verse eid="EZK 16:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="EZK 16:51" />ശമര്യയും, നിന്‍റെ പാപങ്ങളിൽ പകുതിയോളം ചെയ്തിട്ടില്ല; നീ അവരെക്കാൾ നിന്‍റെ മ്ലേച്ഛതകൾ വർദ്ധിപ്പിച്ച്, നീ ചെയ്തിരിക്കുന്ന സകലമ്ലേച്ഛതകളാലും നിന്‍റെ സഹോദരിമാരെ നീതീകരിച്ചിരിക്കുന്നു. <verse eid="EZK 16:51" /><verse number="52" style="v" sid="EZK 16:52" />സഹോദരിമാരെ ന്യായം വിധിച്ചിരിക്കുന്ന നീയും നിന്‍റെ ലജ്ജ വഹിക്കുക; നീ അവരെക്കാൾ അധികം മ്ലേച്ഛമായി പ്രവർത്തിച്ചിരിക്കുന്ന നിന്‍റെ പാപങ്ങളാൽ അവർ നിന്നെക്കാൾ നീതിയുള്ളവരല്ലയോ; അതേ, നീ നിന്‍റെ സഹോദരിമാരെ നീതീകരിച്ചതിൽ, നാണിച്ച് നിന്‍റെ ലജ്ജ വഹിച്ചുകൊള്ളുക.<verse eid="EZK 16:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="EZK 16:53" />നീ അവർക്ക് ആശ്വാസമായി നിന്‍റെ ലജ്ജ വഹിക്കേണ്ടതിനും നീ ചെയ്തിട്ടുള്ള എല്ലാറ്റിനെയും കുറിച്ചു ലജ്ജിക്കേണ്ടതിനും <verse eid="EZK 16:53" /><verse number="54" style="v" sid="EZK 16:54" />ഞാൻ സൊദോമിൻ്റെയും അവളുടെ പുത്രിമാരുടെയും സ്ഥിതിയും ശമര്യയുടെയും അവളുടെ പുത്രിമാരുടെയും സ്ഥിതിയും അവരുടെ നടുവിൽ ഉള്ള നിന്‍റെ പ്രവാസികളുടെ സ്ഥിതിയും മാറ്റും. <verse eid="EZK 16:54" /><verse number="55" style="v" sid="EZK 16:55" />നിന്‍റെ സഹോദരിയായ സൊദോമും അവളുടെ പുത്രിമാരും അവരുടെ പൂർവ്വാവസ്ഥയിലേക്കു മടങ്ങിവരും; ശമര്യയും അവളുടെ പുത്രിമാരും അവരുടെ പൂർവ്വാവസ്ഥയിലേക്കു മടങ്ങിവരും; നീയും നിന്‍റെ പുത്രിമാരും നിങ്ങളുടെ പൂർവ്വാവസ്ഥയിലേക്കു മടങ്ങിവരും. <verse eid="EZK 16:55" /><verse number="56" style="v" sid="EZK 16:56" />അരാമിൻ്റെ പുത്രിമാരും അവളുടെ ചുറ്റുമുള്ളവരെല്ലാം നിന്‍റെ ചുറ്റും നിന്ന് നിന്നെ നിന്ദിക്കുന്ന ഫെലിസ്ത്യപുത്രിമാരും നിന്നെ നിന്ദിച്ച കാലത്ത് എന്നപോലെ നിന്‍റെ ദുഷ്ടത വെളിപ്പെടുന്നതിനു മുമ്പ് <verse eid="EZK 16:56" /><verse number="57" style="v" sid="EZK 16:57" />നിന്‍റെ ഗർവ്വത്തിന്‍റെ നാളിൽ നിന്‍റെ സഹോദരിയായ സൊദോമിൻ്റെ പേരുപോലും നീ ഉച്ചരിച്ചിട്ടില്ല. <verse eid="EZK 16:57" /><verse number="58" style="v" sid="EZK 16:58" />നിന്‍റെ ദുഷ്കർമ്മവും നിന്‍റെ മ്ലേച്ഛതകളും നീ വഹിക്കുന്നു” എന്നു യഹോവയുടെ അരുളപ്പാട്.<verse eid="EZK 16:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="EZK 16:59" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “നിയമം ലംഘിച്ച് സത്യം തുച്ഛീകരിക്കുന്ന നീ ചെയ്തതുപോലെ ഞാൻ നിന്നോടും ചെയ്യും. <verse eid="EZK 16:59" /><verse number="60" style="v" sid="EZK 16:60" />എങ്കിലും നിന്‍റെ യൗവനകാലത്ത് നിന്നോടുള്ള എന്‍റെ നിയമം ഞാൻ ഓർത്തു ഒരു ശാശ്വതനിയമം നിന്നോട് ചെയ്യും. <verse eid="EZK 16:60" /><verse number="61" style="v" sid="EZK 16:61" />നിന്‍റെ ജ്യേഷ്ഠത്തിമാരും അനുജത്തിമാരുമായ സഹോദരിമാരെ നീ കൈക്കൊള്ളുമ്പോൾ, അന്നു നീ നിന്‍റെ വഴികളെ ഓർത്തു ലജ്ജിക്കും; ഞാൻ അവരെ നിനക്കു പുത്രിമാരായി തരും; നിന്‍റെ നിയമപ്രകാരമല്ലതാനും. <verse eid="EZK 16:61" /><verse number="62" style="v" sid="EZK 16:62" />നീ ചെയ്തതെല്ലാം ഞാൻ നിന്നോട് ക്ഷമിക്കുമ്പോൾ നീ ഓർത്തു ലജ്ജിച്ച് നാണം നിമിത്തം ഇനി ഒരിക്കലും വായ് തുറക്കാതിരിക്കേണ്ടതിന് <verse eid="EZK 16:62" /><verse number="63" style="v" sid="EZK 16:63" />ഞാൻ നിന്നോട് എന്‍റെ നിയമം ചെയ്യും; ഞാൻ യഹോവ എന്നു നീ അറിയും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 16:63" /></para>
  <chapter eid="EZK 16" />
  <chapter number="17" style="c" sid="EZK 17" />
  <para style="s">ഒരു മുന്തിരിച്ചെടിയും രണ്ടു കഴുകന്മാരും</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 17:1" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ: <verse eid="EZK 17:1" /><verse number="2" style="v" sid="EZK 17:2" />“മനുഷ്യപുത്രാ, നീ യിസ്രായേൽ ഗൃഹത്തോട് ഒരു കടങ്കഥ പറഞ്ഞ് ഒരു ഉപമ പ്രസ്താവിക്കേണ്ടത്: <verse eid="EZK 17:2" /><verse number="3" style="v" sid="EZK 17:3" />‘യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: വലിയ ചിറകും നീണ്ടതും പലനിറത്തിലുമുള്ള തൂവലുകൾ നിറഞ്ഞതുമായ ഒരു വലിയ കഴുകൻ ലെബനോനിൽ വന്ന് ഒരു ദേവദാരുവിന്‍റെ ശിഖരം എടുത്തു. <verse eid="EZK 17:3" /><verse number="4" style="v" sid="EZK 17:4" />അവൻ അതിന്‍റെ ഇളഞ്ചില്ലികളുടെ അറ്റം മുറിച്ച് വാണിജ്യപ്രാധാന്യമുള്ള ദേശത്ത് കൊണ്ടുചെന്ന്, കച്ചവടക്കാരുടെ പട്ടണത്തിൽ നട്ടു.<verse eid="EZK 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 17:5" />“അവൻ ദേശത്തെ തൈകളിൽ ഒന്നെടുത്ത് ഒരു വിളനിലത്തു നട്ടു; അവൻ അത് ധാരാളം വെള്ളമുള്ള സ്ഥലത്ത് കൊണ്ടുചെന്ന് അലരിവൃക്ഷംപോലെ നട്ടു. <verse eid="EZK 17:5" /><verse number="6" style="v" sid="EZK 17:6" />അത് വളർന്ന്, പൊക്കം കുറഞ്ഞ് പടരുന്ന മുന്തിരിവള്ളിയായിത്തീർന്നു; അതിന്‍റെ വള്ളി അവന്‍റെനേരെ തിരിഞ്ഞിരുന്നു; അതിന്‍റെ വേരുകൾ താഴോട്ട് ആയിരുന്നു; ഇങ്ങനെ അത് മുന്തിരിവള്ളിയായി കൊമ്പുകളെ പുറപ്പെടുവിക്കുകയും ചില്ലികളെ നീട്ടുകയും ചെയ്തു.<verse eid="EZK 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 17:7" />“എന്നാൽ വലിയ ചിറകും വളരെ തൂവലും ഉള്ള മറ്റൊരു വലിയ കഴുകൻ ഉണ്ടായിരുന്നു; അവൻ അത് നനയ്ക്കേണ്ടതിന് ആ മുന്തിരിവള്ളി തന്‍റെ തടത്തിൽനിന്ന് വേരുകളെ അവന്‍റെനേരെ തിരിച്ച് കൊമ്പുകളെ അവന്‍റെനേരെ നീട്ടി. <verse eid="EZK 17:7" /><verse number="8" style="v" sid="EZK 17:8" />കൊമ്പുകളെ പുറപ്പെടുവിച്ച്, ഫലം കായിക്കുവാനും നല്ല മുന്തിരിവള്ളി ആയിത്തീരുവാനും തക്കവിധം അതിനെ ധാരാളം വെള്ളത്തിനരികിൽ നല്ലനിലത്ത് നട്ടിരുന്നു.<verse eid="EZK 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 17:9" />“ഇതു സാദ്ധ്യമാകുമോ? അത് വാടിപ്പോകത്തക്കവണ്ണം, അതിന്‍റെ തളിർത്ത ഇലകളൊക്കെയും വാടിപ്പോകത്തക്കവണ്ണം തന്നെ, അവൻ അതിന്‍റെ വേരുകൾ മാന്തുകയും കായ്കൾ പറിച്ചുകളയുകയും ചെയ്യുകയില്ലയോ? അതിനെ വേരോടെ പിഴുതുകളയേണ്ടതിന് വലിയ ബലമോ വളരെ ജനമോ ആവശ്യമില്ല. <verse eid="EZK 17:9" /><verse number="10" style="v" sid="EZK 17:10" />അത് നട്ടിരിക്കുന്നു സത്യം; അത് തഴയ്ക്കുമോ? കിഴക്കൻകാറ്റു തട്ടുമ്പോൾ അത് വേഗം വാടിപ്പോകുകയില്ലയോ? വളർന്ന തടത്തിൽ തന്നെ അത് ഉണങ്ങിപ്പോകും എന്നു യഹോവയായ കർത്താവ് അരുളിച്ചെയ്യുന്നു എന്നു നീ പറയുക.”<verse eid="EZK 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 17:11" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ: <verse eid="EZK 17:11" /><verse number="12" style="v" sid="EZK 17:12" />“ഇതിന്‍റെ അർത്ഥം നിങ്ങൾ അറിയുന്നില്ലയോ” എന്നു നീ ആ മത്സരഗൃഹത്തോട് ചോദിച്ചിട്ട് അവരോടു പറയേണ്ടത്: “ബാബേൽരാജാവ് യെരൂശലേമിലേക്കു വന്ന് അതിന്‍റെ രാജാവിനെയും പ്രഭുക്കന്മാരെയും പിടിച്ച് തന്നോടുകൂടി ബാബേലിലേക്കു കൊണ്ടുപോയി; <verse eid="EZK 17:12" /><verse number="13" style="v" sid="EZK 17:13" />രാജസന്തതിയിൽ ഒരുവനെ അവൻ എടുത്ത് അവനുമായി ഒരു ഉടമ്പടി ചെയ്തു അവനെക്കൊണ്ട് സത്യംചെയ്യിച്ചു; <verse eid="EZK 17:13" /><verse number="14" style="v" sid="EZK 17:14" />രാജ്യം തന്നത്താൻ ഉയർത്താതെ താണിരുന്ന് അവന്‍റെ ഉടമ്പടി പ്രമാണിച്ച് നിലനിന്നുപോരേണ്ടതിന് അവൻ ദേശത്തിലെ ബലവാന്മാരെ കൊണ്ടുപോയി. <verse eid="EZK 17:14" /><verse number="15" style="v" sid="EZK 17:15" />എങ്കിലും അവനോട് മത്സരിച്ച് ഇവൻ തനിക്കു കുതിരകളെയും വളരെ പടജ്ജനത്തെയും അയച്ചുതരണമെന്ന് പറയുവാൻ ദൂതന്മാരെ മിസ്രയീമിലേക്കു അയച്ചു: അവൻ കൃതാർത്ഥനാകുമോ? ഇങ്ങനെ ചെയ്യുന്നവൻ തെറ്റി ഒഴിയുമോ? അല്ല, അവൻ ഉടമ്പടി ലംഘിച്ചിട്ട് രക്ഷപ്പെടാൻ കഴിയുമോ?<verse eid="EZK 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 17:16" />“എന്നാണ, അവനെ രാജാവാക്കിയ രാജാവിന്‍റെ സ്ഥലമായ ബാബേലിൽ, അവന്‍റെ അരികിൽ വച്ചു തന്നെ, അവൻ മരിക്കും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു; അവനോട് ചെയ്ത സത്യം അവൻ ധിക്കരിക്കുകയും അവനുമായുള്ള ഉടമ്പടി ലംഘിക്കുകയും ചെയ്തുവല്ലോ. <verse eid="EZK 17:16" /><verse number="17" style="v" sid="EZK 17:17" />അസംഖ്യം ജനത്തെ നശിപ്പിച്ചുകളയുവാൻ തക്കവിധം അവർ ഉപരോധം ഏർപ്പെടുത്തി, കോട്ട പണിയുമ്പോൾ ഫറവോൻ മഹാസൈന്യത്തോടും വലിയ കൂട്ടത്തോടും കൂടി അവനുവേണ്ടി യുദ്ധത്തിൽ ഒന്നും പ്രവർത്തിക്കുകയില്ല. <verse eid="EZK 17:17" /><verse number="18" style="v" sid="EZK 17:18" />അവൻ ഉടമ്പടി ലംഘിച്ച് സത്യം ധിക്കരിച്ചിരിക്കുന്നു; അവൻ കൈയടിച്ച് സത്യം ചെയ്തിട്ടും ഇതൊക്കെയും ചെയ്തിരിക്കുന്നു; ആകയാൽ അവൻ രക്ഷപെടുകയില്ല.”<verse eid="EZK 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 17:19" />അതുകൊണ്ട് യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “എന്നാണ, അവൻ ധിക്കരിച്ചിരിക്കുന്ന എന്‍റെ സത്യവും ലംഘിച്ചിരിക്കുന്ന എന്‍റെ ഉടമ്പടിയും ഞാൻ അവന്‍റെ തലമേൽ വരുത്തും. <verse eid="EZK 17:19" /><verse number="20" style="v" sid="EZK 17:20" />ഞാൻ എന്‍റെ വല അവന്‍റെമേൽ വീശും; അവൻ എന്‍റെ കെണിയിൽ അകപ്പെടും; ഞാൻ അവനെ ബാബേലിലേക്ക് കൊണ്ടുചെന്ന്, അവൻ എന്നോട് ചെയ്തിരിക്കുന്ന ദ്രോഹത്തെക്കുറിച്ച് അവിടെവച്ച് അവനോട് വ്യവഹരിക്കും. <verse eid="EZK 17:20" /><verse number="21" style="v" sid="EZK 17:21" />അവന്‍റെ ശ്രേഷ്ഠയോദ്ധാക്കൾ എല്ലാവരും അവന്‍റെ എല്ലാ പടക്കൂട്ടങ്ങളും വാളാൽ വീഴും; ശേഷിപ്പുള്ളവർ നാലു ദിക്കിലേക്കും ചിതറിപ്പോകും; യഹോവയായ ഞാൻ അത് അരുളിച്ചെയ്തു എന്നു നിങ്ങൾ അറിയും.”<verse eid="EZK 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 17:22" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഞാനും ഉയരമുള്ള ദേവദാരുവിന്‍റെ ഒരു ശിഖരം എടുത്ത് നടും; അതിന്‍റെ ഇളഞ്ചില്ലികളുടെ അറ്റത്തുനിന്ന് ഇളയതായിരിക്കുന്ന ഒന്ന് ഞാൻ മുറിച്ചെടുത്തു ഉയരവും ഉന്നതവുമായ ഒരു പർവ്വതത്തിൽ നടും. <verse eid="EZK 17:22" /><verse number="23" style="v" sid="EZK 17:23" />യിസ്രായേലിന്‍റെ ഉയർന്ന പർവ്വതത്തിൽ ഞാൻ അത് നടും; അത് കൊമ്പുകളെ പുറപ്പെടുവിച്ച് ഫലം കായിച്ച് ഭംഗിയുള്ള ഒരു ദേവദാരുവായിത്തീരും; അതിന്‍റെ കീഴിൽ പലവിധം ചിറകുള്ള പക്ഷികൾ പാർക്കും; അതിന്‍റെ കൊമ്പുകളുടെ നിഴലിൽ അവ വസിക്കും. <verse eid="EZK 17:23" /><verse number="24" style="v" sid="EZK 17:24" />‘യഹോവയായ ഞാൻ ഉയരമുള്ള വൃക്ഷത്തെ താഴ്ത്തി, താണിരുന്ന വൃക്ഷത്തെ ഉയർത്തുകയും, പച്ചയായ വൃക്ഷത്തെ ഉണക്കി, ഉണങ്ങിയ വൃക്ഷത്തെ തഴപ്പിക്കുകയും ചെയ്തിരിക്കുന്നു’ എന്നു കാട്ടിലെ സകലവൃക്ഷങ്ങളും അറിയും; യഹോവയായ ഞാൻ അത് പ്രസ്താവിച്ചും നിറവേറ്റിയും ഇരിക്കുന്നു.”<verse eid="EZK 17:24" /></para>
  <chapter eid="EZK 17" />
  <chapter number="18" style="c" sid="EZK 18" />
  <para style="s">പാപം ചെയ്യുന്നവർ മരിക്കും</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 18:1" />യഹോവയുടെ അരുളപ്പാടു എനിക്ക് ഉണ്ടായതെന്തെന്നാൽ: <verse eid="EZK 18:1" /><verse number="2" style="v" sid="EZK 18:2" />“‘അപ്പന്മാർ പച്ചമുന്തിരിങ്ങാ തിന്നു; മക്കളുടെ പല്ലു പുളിച്ചു’ എന്നു നിങ്ങൾ യിസ്രായേൽ ദേശത്ത് ഒരു പഴഞ്ചൊല്ല് പറയുന്നത് എന്ത്? <verse eid="EZK 18:2" /><verse number="3" style="v" sid="EZK 18:3" />എന്നാണ, നിങ്ങൾ ഇനി യിസ്രായേലിൽ ഈ പഴഞ്ചൊല്ല് പറയുവാൻ ഇടവരുകയില്ല” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു. <verse eid="EZK 18:3" /><verse number="4" style="v" sid="EZK 18:4" />സകല ദേഹികളും എനിക്കുള്ളവർ; അപ്പന്‍റെ പ്രാണനും മകന്‍റെ പ്രാണനും ഒരുപോലെ എനിക്കുള്ളത്; പാപം ചെയ്യുന്ന ദേഹി മരിക്കും.<verse eid="EZK 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 18:5" />”എന്നാൽ ഒരു മനുഷ്യൻ നീതിമാനായിരുന്ന് നീതിയും ന്യായവും പ്രവർത്തിക്കുന്നു എങ്കിൽ <verse eid="EZK 18:5" /><verse number="6" style="v" sid="EZK 18:6" />പൂജാഗിരികളിൽവച്ച് ഭക്ഷണം കഴിക്കുകയോ യിസ്രായേൽ ഗൃഹത്തിന്‍റെ വിഗ്രഹങ്ങളെ നോക്കി നമസ്കരിക്കുകയോ കൂട്ടുകാരന്‍റെ ഭാര്യയെ വഷളാക്കുകയോ ഋതുവായ സ്ത്രീയുടെ അടുക്കൽ ചെല്ലുകയോ ആരോടും അന്യായം പ്രവർത്തിക്കുകയോ ചെയ്യാതെ <verse eid="EZK 18:6" /><verse number="7" style="v" sid="EZK 18:7" />കടം വാങ്ങിയവനു പണയം മടക്കിക്കൊടുക്കുകയും ആരോടും പിടിച്ചുപറിക്കാതെ തന്‍റെ അപ്പം വിശപ്പുള്ളവനു കൊടുക്കുകയും നഗ്നനെ ഉടുപ്പിക്കുകയും <verse eid="EZK 18:7" /><verse number="8" style="v" sid="EZK 18:8" />പലിശയ്ക്കു കൊടുക്കുകയോ ലാഭം വാങ്ങുകയോ ചെയ്യാതിരിക്കുകയും നീതികേട് ചെയ്യാത്തവണ്ണം കൈ മടക്കിക്കൊള്ളുകയും മനുഷ്യർ തമ്മിലുള്ള വ്യവഹാരത്തിൽ നേരോടെ വിധിക്കുകയും <verse eid="EZK 18:8" /><verse number="9" style="v" sid="EZK 18:9" />എന്‍റെ ചട്ടങ്ങൾ അനുസരിക്കുകയും എന്‍റെ ന്യായങ്ങൾ പ്രമാണിക്കുകയും ചെയ്തുകൊണ്ട് നേരോടെ നടക്കുന്നവൻ നീതിമാൻ - അവൻ നിശ്ചയമായി ജീവിച്ചിരിക്കും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 18:10" />എന്നാൽ അവന് ഒരു മകൻ ജനിച്ചിട്ട്, അവൻ അക്രമിയായിത്തീരുകയോ രക്തം ചൊരിയുകയോ, <verse eid="EZK 18:10" /><verse number="11" style="v" sid="EZK 18:11" />ചെയ്യേണ്ടതൊന്നും ചെയ്യാതിരിക്കുക, പൂജാഗിരികളിൽവച്ച് ഭക്ഷണം കഴിക്കുക, <verse eid="EZK 18:11" /><verse number="12" style="v" sid="EZK 18:12" />കൂട്ടുകാരന്‍റെ ഭാര്യയെ വഷളാക്കുക, എളിയവനോടും ദരിദ്രനോടും അന്യായം ചെയ്യുക, പിടിച്ചുപറിക്കുക, പണയം മടക്കിക്കൊടുക്കാതിരിക്കുക, വിഗ്രഹങ്ങളെ നോക്കി നമസ്കരിക്കുക, <verse eid="EZK 18:12" /><verse number="13" style="v" sid="EZK 18:13" />മ്ലേച്ഛത പ്രവർത്തിക്കുക, പലിശയ്ക്കു കൊടുക്കുക, ലാഭം വാങ്ങുക എന്നിവ പ്രവർത്തിക്കുകയോ ചെയ്യുന്നവനായാൽ അവൻ ജീവിച്ചിരിക്കുമോ? അവൻ ജീവിച്ചിരിക്കുകയില്ല; അവൻ ഈ മ്ലേച്ഛതകളെല്ലാം ചെയ്തുവല്ലോ; അവൻ മരിക്കും; അവന്‍റെ രക്തം അവന്‍റെമേൽ വരും.<verse eid="EZK 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 18:14" />”എന്നാൽ അവന് ഒരു മകൻ ജനിച്ചിട്ട് അവൻ തന്‍റെ അപ്പൻ ചെയ്ത സകലപാപങ്ങളും കണ്ടു ഭയന്ന് അങ്ങനെയുള്ളത് ചെയ്യാതെ പർവ്വതങ്ങളിൽവച്ച് ഭക്ഷണം കഴിക്കുക, <verse eid="EZK 18:14" /><verse number="15" style="v" sid="EZK 18:15" />യിസ്രായേൽ ഗൃഹത്തിന്‍റെ വിഗ്രഹങ്ങളെ നോക്കി നമസ്കരിക്കുക, കൂട്ടുകാരന്‍റെ ഭാര്യയെ വഷളാക്കുക, <verse eid="EZK 18:15" /><verse number="16" style="v" sid="EZK 18:16" />ആരോടെങ്കിലും അന്യായം ചെയ്യുക, പണയം കൈവശം വച്ചുകൊണ്ടിരിക്കുക, പിടിച്ചുപറിക്കുക, എന്നീവകയൊന്നും ചെയ്യാതെ വിശപ്പുള്ളവനു അപ്പം കൊടുക്കുകയും നഗ്നനെ ഉടുപ്പിക്കുകയും <verse eid="EZK 18:16" /><verse number="17" style="v" sid="EZK 18:17" />നീതികേട് ചെയ്യാതെ തന്‍റെ കൈ പിൻവലിക്കുകയും പലിശയും ലാഭവും വാങ്ങാതിരിക്കുകയും എന്‍റെ വിധികൾ നടത്തി, എന്‍റെ ചട്ടങ്ങൾ അനുസരിക്കുകയും ചെയ്യുന്നു എങ്കിൽ അവൻ അപ്പന്‍റെ അകൃത്യം നിമിത്തം മരിക്കാതെ ജീവിച്ചിരിക്കും. <verse eid="EZK 18:17" /><verse number="18" style="v" sid="EZK 18:18" />അവന്‍റെ അപ്പനോ കഠിനമായി കഷ്ടപ്പെടുത്തി, സഹോദരനോട് പിടിച്ചുപറിച്ച്, തന്‍റെ ജനത്തിന്‍റെ ഇടയിൽ കൊള്ളരുതാത്തത് പ്രവർത്തിച്ചതുകൊണ്ട് തന്‍റെ അകൃത്യത്താൽ മരിക്കും.<verse eid="EZK 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 18:19" />എന്നാൽ ‘മകൻ അപ്പന്‍റെ അകൃത്യം വഹിക്കേണ്ടതല്ലയോ’ എന്നു നിങ്ങൾ ചോദിക്കുന്നു; മകൻ നീതിയും ന്യായവും പ്രവർത്തിച്ച് എന്‍റെ ചട്ടങ്ങൾ പ്രമാണിച്ചു നടക്കുന്നു എങ്കിൽ, അവൻ ജീവിച്ചിരിക്കും. <verse eid="EZK 18:19" /><verse number="20" style="v" sid="EZK 18:20" />പാപം ചെയ്യുന്ന ദേഹി മരിക്കും; മകൻ അപ്പന്‍റെ അകൃത്യം വഹിക്കേണ്ട; അപ്പൻ മകന്‍റെ അകൃത്യവും വഹിക്കേണ്ട; നീതിമാന്‍റെ നീതി അവന്‍റെമേലും ദുഷ്ടന്‍റെ ദുഷ്ടത അവന്‍റെമേലും ഇരിക്കും.<verse eid="EZK 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 18:21" />”എന്നാൽ ദുഷ്ടൻ താൻ ചെയ്ത സകലപാപങ്ങളും വിട്ടുതിരിഞ്ഞ് എന്‍റെ ചട്ടങ്ങളൊക്കെയും പ്രമാണിച്ച്, നീതിയും ന്യായവും പ്രവർത്തിക്കുന്നു എങ്കിൽ, അവൻ മരിക്കാതെ ജീവിച്ചിരിക്കും. <verse eid="EZK 18:21" /><verse number="22" style="v" sid="EZK 18:22" />അവൻ ചെയ്ത അതിക്രമങ്ങളിൽ ഒന്നും അവന് കണക്കിടുകയില്ല; അവൻ ചെയ്ത നീതിയാൽ അവൻ ജീവിക്കും. <verse eid="EZK 18:22" /><verse number="23" style="v" sid="EZK 18:23" />ദുഷ്ടന്‍റെ മരണത്തിൽ എനിക്ക് അല്പമെങ്കിലും താത്പര്യം ഉണ്ടോ? അവൻ തന്‍റെ വഴികൾ വിട്ടുതിരിഞ്ഞ് ജീവിക്കണം എന്നല്ലയോ എന്‍റെ താത്പര്യം” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു.<verse eid="EZK 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 18:24" />”എന്നാൽ നീതിമാൻ തന്‍റെ നീതി വിട്ടുതിരിഞ്ഞ് നീതികേട് പ്രവർത്തിച്ച്, ദുഷ്ടൻ ചെയ്യുന്ന സകലമ്ലേച്ഛതകളും ചെയ്യുന്നു എങ്കിൽ, അവൻ ജീവിച്ചിരിക്കുമോ? അവൻ ചെയ്ത നീതിയൊന്നും കണക്കിടുകയില്ല; അവൻ ചെയ്ത ദ്രോഹത്താലും അവൻ ചെയ്ത പാപത്താലും അവൻ മരിക്കും.”<verse eid="EZK 18:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 18:25" />“എന്നാൽ നിങ്ങൾ: ‘കർത്താവിന്‍റെ വഴി ചൊവ്വുള്ളതല്ല’ എന്നു പറയുന്നു; യിസ്രായേൽ ഗൃഹമേ, കേൾക്കുവിൻ; എന്‍റെ വഴി ചൊവ്വുള്ളതല്ലയോ? നിങ്ങളുടെ വഴികൾ ചൊവ്വില്ലാത്തവയല്ലയോ? <verse eid="EZK 18:25" /><verse number="26" style="v" sid="EZK 18:26" />നീതിമാൻ തന്‍റെ നീതി വിട്ടുതിരിഞ്ഞ് നീതികേട് പ്രവർത്തിക്കുന്നുവെങ്കിൽ അവൻ അതുനിമിത്തം മരിക്കും; അവൻ ചെയ്ത നീതികേടുനിമിത്തം തന്നെ അവൻ മരിക്കും. <verse eid="EZK 18:26" /><verse number="27" style="v" sid="EZK 18:27" />ദുഷ്ടൻ താൻ ചെയ്ത ദുഷ്ടത വിട്ടുതിരിഞ്ഞ് നീതിയും ന്യായവും പ്രവർത്തിക്കുന്നു എങ്കിൽ, അവൻ തന്നത്താൻ ജീവനോടെ രക്ഷിക്കും. <verse eid="EZK 18:27" /><verse number="28" style="v" sid="EZK 18:28" />അവൻ ഓർത്തു, താൻ ചെയ്ത അതിക്രമങ്ങളൊക്കെയും വിട്ടുതിരിയുകകൊണ്ട്, അവൻ മരിക്കാതെ ജീവിച്ചിരിക്കും <verse eid="EZK 18:28" /><verse number="29" style="v" sid="EZK 18:29" />എന്നാൽ യിസ്രായേൽഗൃഹം: ‘കർത്താവിന്‍റെ വഴി ചൊവ്വുള്ളതല്ല’ എന്നു പറയുന്നു; യിസ്രായേൽ ഗൃഹമേ, എന്‍റെ വഴികൾ ചൊവ്വുള്ളവയല്ലയോ? നിങ്ങളുടെ വഴികൾ ചൊവ്വില്ലാത്തവയല്ലയോ?<verse eid="EZK 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 18:30" />”അതുകൊണ്ട് യിസ്രായേൽ ഗൃഹമേ, ഞാൻ നിങ്ങളിൽ ഓരോരുത്തനെയും അവനവന്‍റെ വഴിക്കു തക്കവണ്ണം ന്യായംവിധിക്കും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു: “അകൃത്യം നിങ്ങൾക്ക് നാശകരമായി ഭവിക്കാതെയിരിക്കേണ്ടതിന് നിങ്ങൾ മനംതിരിഞ്ഞ് നിങ്ങളുടെ അതിക്രമങ്ങളെല്ലാം വിട്ടുതിരിയുവിൻ. <verse eid="EZK 18:30" /><verse number="31" style="v" sid="EZK 18:31" />നിങ്ങൾ ചെയ്തിരിക്കുന്ന അതിക്രമങ്ങൾ സകലവും നിങ്ങളിൽനിന്ന് എറിഞ്ഞുകളയുവിൻ; നിങ്ങൾക്ക് ഒരു പുതിയ ഹൃദയത്തെയും പുതിയ ആത്മാവിനെയും സമ്പാദിച്ചുകൊള്ളുവിൻ; യിസ്രായേൽ ഗൃഹമേ നിങ്ങൾ എന്തിന് മരിക്കുന്നു? <verse eid="EZK 18:31" /><verse number="32" style="v" sid="EZK 18:32" />മരിക്കുന്നവൻ്റെ മരണത്തിൽ എനിക്ക് ഇഷ്ടമില്ല” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്; ആകയാൽ നിങ്ങൾ മനംതിരിഞ്ഞ് ജീവിച്ചുകൊള്ളുവിൻ.<verse eid="EZK 18:32" /></para>
  <chapter eid="EZK 18" />
  <chapter number="19" style="c" sid="EZK 19" />
  <para style="s">യിസ്രായേലിലെ പ്രഭുക്കന്മാരെക്കുറിച്ച് ഒരു വിലാപഗീതം</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 19:1" />നീ യിസ്രായേലിന്‍റെ പ്രഭുവിനെക്കുറിച്ച് ഒരു വിലാപം ചൊല്ലേണ്ടത്:<verse eid="EZK 19:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="EZK 19:2" />“നിന്‍റെ അമ്മ ആരായിരുന്നു;</para>
  <para style="q2" vid="EZK 19:2">ഒരു സിംഹി തന്നെ; അവൾ സിംഹങ്ങളുടെ ഇടയിൽ കിടന്ന്</para>
  <para style="q2" vid="EZK 19:2">തന്‍റെ കുട്ടികളെ ബാലസിംഹങ്ങളുടെ ഇടയിൽ വളർത്തി.<verse eid="EZK 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 19:3" />അവൾ തന്‍റെ കുട്ടികളിൽ ഒന്നിനെ വളർത്തി;</para>
  <para style="q2" vid="EZK 19:3">അത് ഒരു ബാലസിംഹമായിത്തീർന്നു;</para>
  <para style="q1" vid="EZK 19:3">അത് ഇരതേടി പിടിക്കുവാൻ ശീലിച്ച്,</para>
  <para style="q2" vid="EZK 19:3">മനുഷ്യരെ തിന്നുകളഞ്ഞു.<verse eid="EZK 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 19:4" />ജനതകൾ അവന്‍റെ വസ്തുത കേട്ടു;</para>
  <para style="q2" vid="EZK 19:4">അവരുടെ കുഴിയിൽ അവൻ അകപ്പെട്ടു;</para>
  <para style="q1" vid="EZK 19:4">അവർ അവനെ കൊളുത്തിട്ട്</para>
  <para style="q2" vid="EZK 19:4">മിസ്രയീമിലേക്കു കൊണ്ടുപോയി.<verse eid="EZK 19:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="EZK 19:5" />എന്നാൽ അവൾ പ്രതീക്ഷിച്ചുകൊണ്ടിരുന്ന ആശയ്ക്ക് ഭംഗംവന്നു</para>
  <para style="q2" vid="EZK 19:5">എന്നു കണ്ടിട്ട് തന്‍റെ കുട്ടികളിൽ മറ്റൊന്നിനെ എടുത്ത് ബാലസിംഹമാക്കി.<verse eid="EZK 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 19:6" />അവനും സിംഹങ്ങളുടെ ഇടയിൽ സഞ്ചരിച്ച്</para>
  <para style="q2" vid="EZK 19:6">ബാലസിംഹമായിത്തീർന്നു;</para>
  <para style="q1" vid="EZK 19:6">ഇര തേടിപ്പിടിക്കുവാൻ ശീലിച്ച്,</para>
  <para style="q2" vid="EZK 19:6">മനുഷ്യരെ തിന്നുകളഞ്ഞു.<verse eid="EZK 19:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 19:7" />അവൻ അവരുടെ രാജധാനികളെ അറിഞ്ഞ്,</para>
  <para style="q2" vid="EZK 19:7">അവരുടെ പട്ടണങ്ങളെ ശൂന്യമാക്കി;</para>
  <para style="q1" vid="EZK 19:7">അവന്‍റെ ഗർജ്ജനം ഹേതുവായി</para>
  <para style="q2" vid="EZK 19:7">ദേശവും അതിലുള്ളതൊക്കെയും ശൂന്യമായിപ്പോയി.<verse eid="EZK 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 19:8" />അപ്പോൾ ജനതകൾ ചുറ്റുമുള്ള സംസ്ഥാനങ്ങളിൽനിന്ന്</para>
  <para style="q2" vid="EZK 19:8">അവന്‍റെനേരെ വന്ന് അവന്‍റെമേൽ വലവീശി;</para>
  <para style="q2" vid="EZK 19:8">അവൻ അവരുടെ കുഴിയിൽ അകപ്പെട്ടു.<verse eid="EZK 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 19:9" />അവർ അവനെ കൊളുത്തിട്ട് ഒരു കൂട്ടിൽ ആക്കി</para>
  <para style="q2" vid="EZK 19:9">ബാബേൽരാജാവിന്‍റെ അടുക്കൽ കൊണ്ടുപോയി;</para>
  <para style="q1" vid="EZK 19:9">ഇനി അവന്‍റെ നാദം യിസ്രായേൽ പർവ്വതങ്ങളിൽ കേൾക്കാതെയിരിക്കേണ്ടതിന്</para>
  <para style="q2" vid="EZK 19:9">അവർ അവനെ ദുർഗ്ഗങ്ങളിൽ കൊണ്ടുപോയി.<verse eid="EZK 19:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="EZK 19:10" />നിന്‍റെ അമ്മ, മുന്തിരിത്തോട്ടത്തിൽ വെള്ളത്തിനരികിൽ നട്ടിരിക്കുന്ന</para>
  <para style="q2" vid="EZK 19:10">മുന്തിരിവള്ളിപോലെയാകുന്നു;</para>
  <para style="q1" vid="EZK 19:10">വളരെ വെള്ളം ഉള്ളതുകൊണ്ട്</para>
  <para style="q2" vid="EZK 19:10">അത് ഫലപ്രദവും തഴച്ചതുമായിരുന്നു.<verse eid="EZK 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 19:11" />അതിൽ അധിപതികളുടെ ചെങ്കോലുകൾക്കായി ബലമുള്ള കൊമ്പുകൾ ഉണ്ടായിരുന്നു;</para>
  <para style="q2" vid="EZK 19:11">അത് തിങ്ങിയ കൊമ്പുകളുടെ ഇടയിൽ വളർന്നു പൊങ്ങിയിരുന്നു;</para>
  <para style="q1" vid="EZK 19:11">അത് പൊക്കംകൊണ്ടും കൊമ്പുകളുടെ പെരുപ്പംകൊണ്ടും</para>
  <para style="q2" vid="EZK 19:11">പ്രസിദ്ധമായിരുന്നു.<verse eid="EZK 19:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 19:12" />എന്നാൽ അതിനെ ക്രോധത്തോടെ പറിച്ച് നിലത്തു തള്ളിയിട്ടു;</para>
  <para style="q2" vid="EZK 19:12">കിഴക്കൻകാറ്റ് അതിന്‍റെ ഫലം ഉണക്കിക്കളഞ്ഞു;</para>
  <para style="q1" vid="EZK 19:12">അതിന്‍റെ ബലമുള്ള കൊമ്പുകൾ ഒടിഞ്ഞ് ഉണങ്ങിപ്പോയി,</para>
  <para style="q2" vid="EZK 19:12">തീ അതിനെ ദഹിപ്പിച്ചുകളഞ്ഞു.<verse eid="EZK 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 19:13" />ഇപ്പോൾ അതിനെ മരുഭൂമിയിൽ</para>
  <para style="q2" vid="EZK 19:13">ഉണങ്ങി വരണ്ട നിലത്തു നട്ടിരിക്കുന്നു.<verse eid="EZK 19:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 19:14" />അതിന്‍റെ കൊമ്പുകളിലെ ഒരു ശാഖയിൽനിന്ന് തീ പുറപ്പെട്ടു</para>
  <para style="q2" vid="EZK 19:14">അതിന്‍റെ ഫലം ദഹിപ്പിച്ചുകളഞ്ഞു;</para>
  <para style="q1" vid="EZK 19:14">അതുകൊണ്ട് ആധിപത്യത്തിൻ്റെ ചെങ്കോലായിരിക്കുവാൻ തക്ക</para>
  <para style="q2" vid="EZK 19:14">ബലമുള്ള കോൽ അതിൽ നിന്നെടുക്കുവാൻ ഇല്ലാതെപോയി.</para>
  <para style="b" vid="EZK 19:14" />
  <para style="p" vid="EZK 19:14">ഇത് ഒരു വിലാപം; ഒരു വിലാപമായിത്തീർന്നുമിരിക്കുന്നു.<verse eid="EZK 19:14" /></para>
  <chapter eid="EZK 19" />
  <chapter number="20" style="c" sid="EZK 20" />
  <para style="s">മത്സരിയായ യിസ്രായേൽ ശുദ്ധീകരിക്കപ്പെടുന്നു</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 20:1" />ബാബിലോന്യ പ്രവാസത്തിന്‍റെ ഏഴാം ആണ്ട് അഞ്ചാം മാസം പത്താം തീയതി യിസ്രായേൽമൂപ്പന്മാരിൽ ചിലർ യഹോവയോടു അരുളപ്പാടു ചോദിക്കുവാൻ വന്ന് എന്‍റെ മുമ്പിൽ ഇരുന്നു.<verse eid="EZK 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EZK 20:2" />അപ്പോൾ യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായത് എന്തെന്നാൽ: <verse eid="EZK 20:2" /><verse number="3" style="v" sid="EZK 20:3" />“മനുഷ്യപുത്രാ, നീ യിസ്രായേൽമൂപ്പന്മാരോടു സംസാരിച്ച്, ‘യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: നിങ്ങൾ എന്നോട് അരുളപ്പാടു ചോദിക്കുവാൻ വന്നിരിക്കുന്നുവോ? നിങ്ങൾ എന്നോട് ചോദിച്ചാൽ, എന്നാണ, ഞാൻ ഉത്തരം അരുളുകയില്ല’ എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു” എന്നു അവരോടു പറയേണം.<verse eid="EZK 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 20:4" />“മനുഷ്യപുത്രാ, നീ അവരെ ന്യായംവിധിക്കുമോ? നീ അവരെ ന്യായംവിധിക്കുമോ? നീ അവരുടെ പിതാക്കന്മാരുടെ മ്ലേച്ഛതകൾ അവരോട് അറിയിച്ചു പറയേണ്ടത്: <verse eid="EZK 20:4" /><verse number="5" style="v" sid="EZK 20:5" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: ഞാൻ യിസ്രായേലിനെ തിരഞ്ഞെടുത്ത്, യാക്കോബ് ഗൃഹത്തിന്‍റെ സന്തതിയോടു കൈ ഉയർത്തി സത്യംചെയ്ത്, മിസ്രയീമിൽവെച്ച് എന്നെത്തന്നെ അവർക്ക് വെളിപ്പെടുത്തിയ നാളിൽ: “ഞാൻ നിങ്ങളുടെ ദൈവമായ യഹോവയാകുന്നു” എന്നു കൈ ഉയർത്തിക്കൊണ്ട് അവരോട് അരുളിച്ചെയ്തു. <verse eid="EZK 20:5" /><verse number="6" style="v" sid="EZK 20:6" />ഞാൻ അവരെ മിസ്രയീമിൽ നിന്ന് പുറപ്പെടുവിക്കുമെന്നും ഞാൻ അവർക്കുവേണ്ടി നോക്കിവച്ചിരുന്നതും പാലും തേനും ഒഴുകുന്നതും സർവ്വദേശങ്ങളുടെയും മഹത്ത്വമായിരിക്കുന്നതുമായ ദേശത്തിലേക്ക് അവരെ കൊണ്ടുവരുമെന്നും ആ നാളിൽ കൈ ഉയർത്തി സത്യംചെയ്തു.” <verse eid="EZK 20:6" /><verse number="7" style="v" sid="EZK 20:7" />അവരോട്: “നിങ്ങൾ ഓരോരുത്തനും അവനവന്‍റെ കണ്ണിന്മുമ്പിൽ ഇരിക്കുന്ന മ്ലേച്ഛവിഗ്രഹങ്ങൾ എറിഞ്ഞുകളയുവിൻ; മിസ്രയീമിലെ ബിംബങ്ങളെക്കൊണ്ട് നിങ്ങളെ മലിനമാക്കരുത്, ഞാനാകുന്നു നിങ്ങളുടെ ദൈവമായ യഹോവ” എന്നു കല്പിച്ചു.<verse eid="EZK 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 20:8" />“അവരോ എന്നോട് മത്സരിച്ച്, എന്‍റെ വാക്കു കേൾക്കുവാൻ മനസ്സില്ലാതെ ഇരുന്നു; അവരിൽ ഒരുത്തനും തന്‍റെ കണ്ണിന്മുമ്പിൽ ഇരുന്ന മ്ലേച്ഛവിഗ്രഹങ്ങളെ എറിഞ്ഞുകളയുകയോ മിസ്രയീമിലെ ബിംബങ്ങളെ ഉപേക്ഷിക്കുകയോ ചെയ്തില്ല; ആകയാൽ ഞാൻ: മിസ്രയീമിന്‍റെ നടുവിൽവച്ച് എന്‍റെ ക്രോധം അവരുടെ മേൽ പകർന്ന് എന്‍റെ കോപം അവരിൽ നിവർത്തിക്കും” എന്നും അരുളിച്ചെയ്തു. <verse eid="EZK 20:8" /><verse number="9" style="v" sid="EZK 20:9" />എങ്കിലും അവരുടെ ചുറ്റും വസിക്കുകയും ഞാൻ അവരെ മിസ്രയീമിൽ നിന്ന് പുറപ്പെടുവിച്ച് എന്നെത്തന്നെ വെളിപ്പെടുത്തിയത് കാണുകയും ചെയ്ത ജനതകളുടെ മുമ്പാകെ, എന്‍റെ നാമം അശുദ്ധമാകാതെ ഇരിക്കേണ്ടതിന് ഞാൻ എന്‍റെ നാമംനിമിത്തം പ്രവർത്തിച്ചു. <verse eid="EZK 20:9" /><verse number="10" style="v" sid="EZK 20:10" />അങ്ങനെ ഞാൻ അവരെ മിസ്രയീമിൽ നിന്ന് പുറപ്പെടുവിച്ച് മരുഭൂമിയിൽ കൊണ്ടുവന്നു. <verse eid="EZK 20:10" /><verse number="11" style="v" sid="EZK 20:11" />ഞാൻ എന്‍റെ ചട്ടങ്ങൾ അവർക്ക് കൊടുത്ത്, എന്‍റെ വിധികൾ അവരെ അറിയിച്ചു; അവയെ പ്രമാണിക്കുന്ന മനുഷ്യൻ അവയാൽ ജീവിക്കും. <verse eid="EZK 20:11" /><verse number="12" style="v" sid="EZK 20:12" />‘ഞാൻ അവരെ വിശുദ്ധീകരിക്കുന്ന യഹോവ’ എന്നു അവർ അറിയേണ്ടതിന് എനിക്കും അവർക്കും മദ്ധ്യത്തിൽ അടയാളമായിരിക്കുവാൻ തക്കവിധം ഞാൻ എന്‍റെ ശബ്ബത്തുകൾ അവർക്ക് കൊടുത്തു.<verse eid="EZK 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 20:13" />യിസ്രായേൽഗൃഹമോ മരുഭൂമിയിൽവച്ച് എന്നോട് മത്സരിച്ചു; അവർ എന്‍റെ ചട്ടങ്ങൾ അനുസരിച്ചുനടക്കാതെ എന്‍റെ വിധികൾ ത്യജിച്ചുകളഞ്ഞു; ‘അവയെ പ്രമാണിക്കുന്ന മനുഷ്യൻ അവയാൽ ജീവിക്കും.’ എന്‍റെ ശബ്ബത്തുകളെയും അവർ ഏറ്റവും അശുദ്ധമാക്കി; ആകയാൽ ഞാൻ മരുഭൂമിയിൽവച്ച് എന്‍റെ ക്രോധം അവരുടെ മേൽ പകർന്ന് അവരെ സംഹരിക്കുമെന്ന് അരുളിച്ചെയ്തു. <verse eid="EZK 20:13" /><verse number="14" style="v" sid="EZK 20:14" />എങ്കിലും ഞാൻ അവരെ പുറപ്പെടുവിച്ചതു കണ്ട ജനതകളുടെ മുമ്പാകെ എന്‍റെ നാമം അശുദ്ധമാകാതെയിരിക്കേണ്ടതിന് ഞാൻ അത് നിമിത്തം പ്രവർത്തിച്ചു. <verse eid="EZK 20:14" /><verse number="15" style="v" sid="EZK 20:15" />‘അവരുടെ ഹൃദയം അവരുടെ വിഗ്രഹങ്ങളോടു ചേർന്നിരുന്നതുകൊണ്ട് അവർ എന്‍റെ വിധികളെ ധിക്കരിച്ച് എന്‍റെ ചട്ടങ്ങളിൽ നടക്കാതെ എന്‍റെ ശബ്ബത്തുകളെ അശുദ്ധമാക്കുകയാൽ <verse eid="EZK 20:15" /><verse number="16" style="v" sid="EZK 20:16" />ഞാൻ അവർക്ക് കൊടുത്തിരുന്നതും പാലും തേനും ഒഴുകുന്നതും സർവ്വദേശങ്ങളുടെയും മഹത്ത്വമായിരിക്കുന്നതും ആയ ദേശത്തേക്ക് അവരെ കൊണ്ടുവരുകയില്ല’ എന്നു ഞാൻ മരുഭൂമിയിൽവച്ച് കൈ ഉയർത്തി സത്യംചെയ്തു. <verse eid="EZK 20:16" /><verse number="17" style="v" sid="EZK 20:17" />“എങ്കിലും അവരെ നശിപ്പിക്കുകയും മരുഭൂമിയിൽവച്ച് അവരെ നശിപ്പിച്ചുകളയുകയും ചെയ്യാതിരിക്കത്തക്കവിധം എനിക്ക് അവരോടു സഹതാപം തോന്നി.<verse eid="EZK 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 20:18" />ഞാൻ മരുഭൂമിയിൽവച്ച് അവരുടെ മക്കളോടു: ‘നിങ്ങളുടെ പൂര്‍വ്വ പിതാക്കന്മാരുടെ ചട്ടങ്ങളിൽ നടക്കരുത്; അവരുടെ വിധികളെ പ്രമാണിക്കരുത്; അവരുടെ വിഗ്രഹങ്ങളെക്കൊണ്ടു നിങ്ങളെത്തന്നെ അശുദ്ധമാക്കുകയും അരുത്; <verse eid="EZK 20:18" /><verse number="19" style="v" sid="EZK 20:19" />ഞാൻ നിങ്ങളുടെ ദൈവമായ യഹോവയാകുന്നു; നിങ്ങൾ എന്‍റെ ചട്ടങ്ങൾ അനുസരിച്ചുനടന്ന് എന്‍റെ വിധികളെ പ്രമാണിച്ച് അനുഷ്ഠിക്കുവിൻ; <verse eid="EZK 20:19" /><verse number="20" style="v" sid="EZK 20:20" />എന്‍റെ ശബ്ബത്തുകളെ വിശുദ്ധീകരിക്കുവിൻ; ‘ഞാൻ നിങ്ങളുടെ ദൈവമായ യഹോവ’ എന്നു നിങ്ങൾ അറിയേണ്ടതിന് അവ എനിക്കും നിങ്ങൾക്കും ഇടയിൽ അടയാളമായിരിക്കട്ടെ” എന്നു കല്പിച്ചു.<verse eid="EZK 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 20:21" />എന്നാൽ മക്കളും എന്നോട് മത്സരിച്ചു; അവർ എന്‍റെ ചട്ടങ്ങൾ അനുസരിച്ചില്ല; എന്‍റെ വിധികൾ പ്രമാണിച്ചുനടന്നതുമില്ല; ‘അവയെ ചെയ്യുന്ന മനുഷ്യൻ അവയാൽ ജീവിക്കും.’ അവർ എന്‍റെ ശബ്ബത്തുകളെ അശുദ്ധമാക്കി; ആകയാൽ ഞാൻ: ‘മരുഭൂമിയിൽവച്ച് എന്‍റെ ക്രോധം അവരുടെ മേൽ പകർന്ന്<note caller="+" style="f"><char style="fr" closed="false">20:21 </char><char style="fq" closed="false">മരുഭൂമിയിൽവച്ച് എന്‍റെ ക്രോധം അവരുടെ മേൽ പകർന്ന് </char><char style="ft" closed="false">മരുഭൂമിയിൽവച്ച് അവരെ നശിപ്പിച്ച് </char></note> എന്‍റെ കോപം അവരിൽ നിവർത്തിക്കും” എന്നു അരുളിച്ചെയ്തു. <verse eid="EZK 20:21" /><verse number="22" style="v" sid="EZK 20:22" />എങ്കിലും ഞാൻ എന്‍റെ കൈ പിൻവലിക്കുകയും ഞാൻ അവരെ പുറപ്പെടുവിച്ചതു കണ്ട ജനതകളുടെ മുമ്പിൽ എന്‍റെ നാമം അശുദ്ധമാകാതെ ഇരിക്കേണ്ടതിന് അതുനിമിത്തം പ്രവർത്തിക്കുകയും ചെയ്തു. <verse eid="EZK 20:22" /><verse number="23" style="v" sid="EZK 20:23" />അവർ എന്‍റെ വിധികൾ പ്രമാണിക്കാതെ എന്‍റെ ചട്ടങ്ങൾ ധിക്കരിച്ച് എന്‍റെ ശബ്ബത്തുകളെ അശുദ്ധമാക്കുകയും അവരുടെ ദൃഷ്ടികൾ അവരുടെ പിതാക്കന്മാരുടെ വിഗ്രഹങ്ങളുടെമേൽ ഇരിക്കുകയും ചെയ്തതുകൊണ്ട്, <verse eid="EZK 20:23" /><verse number="24" style="v" sid="EZK 20:24" />ഞാൻ അവരെ ജനതകളുടെ ഇടയിൽ ചിന്നിച്ച് രാജ്യങ്ങളിൽ ചിതറിച്ചുകളയുമെന്ന് മരുഭൂമിയിൽവച്ച് കൈ ഉയർത്തി അവരോടു സത്യംചെയ്തു. <verse eid="EZK 20:24" /><verse number="25" style="v" sid="EZK 20:25" />ഞാൻ അവർക്ക് ദോഷകരമായ ചട്ടങ്ങളും ജീവരക്ഷ പ്രാപിക്കുവാൻ ഉതകാത്ത വിധികളും കൊടുത്തു. <verse eid="EZK 20:25" /><verse number="26" style="v" sid="EZK 20:26" />‘ഞാൻ യഹോവ’ എന്നു അവർ അറിയുവാൻ തക്കവിധം ഞാൻ അവരെ ശൂന്യമാക്കേണ്ടതിന് അവർ എല്ലാകടിഞ്ഞൂലുകളെയും അഗ്നിപ്രവേശം ചെയ്യിച്ചതിനാൽ ഞാൻ അവരുടെ സ്വന്തവഴിപാടുകളാൽത്തന്നെ അവരെ അശുദ്ധമാക്കി.<verse eid="EZK 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EZK 20:27" />അതുകൊണ്ട് മനുഷ്യപുത്രാ നീ യിസ്രായേൽ ഗൃഹത്തോട് പറയേണ്ടത് എന്തെന്നാൽ: ‘യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: നിങ്ങളുടെ പിതാക്കന്മാർ എന്നോട് ദ്രോഹം ചെയ്തിരിക്കുന്നതിനാൽ എന്നെ ദുഷിക്കുകയും ചെയ്തിരിക്കുന്നു. <verse eid="EZK 20:27" /><verse number="28" style="v" sid="EZK 20:28" />അവർക്ക് കൊടുക്കുമെന്ന് ഞാൻ കൈ ഉയർത്തി സത്യംചെയ്ത ദേശത്തേക്ക് ഞാൻ അവരെ കൊണ്ടുവന്നശേഷം അവർ ഉയർന്ന എല്ലാ കുന്നുകളും തഴച്ച സകലവൃക്ഷങ്ങളും നോക്കി, അവിടെ യാഗങ്ങൾ അർപ്പിക്കുകയും കോപകാരണമായ വഴിപാട് കഴിക്കുകയും സൗരഭ്യവാസന നിവേദിക്കുകയും പാനീയബലികളെ പകരുകയും ചെയ്തു.” <verse eid="EZK 20:28" /><verse number="29" style="v" sid="EZK 20:29" />“നിങ്ങൾ പോകുന്ന പൂജാഗിരി<note caller="+" style="f"><char style="fr" closed="false">20:29 </char><char style="fq" closed="false">ബാമ </char><char style="ft" closed="false">പൂജാഗിരി</char></note> എന്ത്” എന്നു ഞാൻ അവരോടു ചോദിച്ചു; ഇന്നുവരെയും അതിന് ‘ബാമ’ എന്നു പേരായിരിക്കുന്നു.<verse eid="EZK 20:29" /></para>
  <para style="s">മത്സരമുള്ള യിസ്രായേൽജനം പുനരുദ്ധരിക്കപ്പെടുന്നു</para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 20:30" />അതുകൊണ്ട് നീ യിസ്രായേൽ ഗൃഹത്തോട് പറയേണ്ടത്: “യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: നിങ്ങൾ നിങ്ങളുടെ പൂര്‍വ്വ പിതാക്കന്മാരുടെ മര്യാദപ്രകാരം നിങ്ങളെത്തന്നെ അശുദ്ധമാക്കുവാനും അവരുടെ മ്ലേച്ഛവിഗ്രഹങ്ങളോടു ചേർന്ന് പരസംഗം ചെയ്യുവാനും പോകുന്നുവോ? <verse eid="EZK 20:30" /><verse number="31" style="v" sid="EZK 20:31" />നിങ്ങളുടെ വഴിപാടുകൾ കഴിക്കുന്നതിനാലും നിങ്ങളുടെ മക്കളെ അഗ്നിപ്രവേശം ചെയ്യിക്കുന്നതിനാലും നിങ്ങൾ ഇന്നുവരെ നിങ്ങളുടെ സകലവിഗ്രഹങ്ങളാലും നിങ്ങളെത്തന്നെ അശുദ്ധമാക്കുന്നു; യിസ്രായേൽ ഗൃഹമേ, നിങ്ങൾ ചോദിച്ചാൽ ഞാൻ ഉത്തരമരുളുമോ? നിങ്ങൾ ചോദിച്ചാൽ, എന്നാണ ഞാൻ ഉത്തരമരുളുകയില്ല” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 20:32" />“‘നാം മരത്തെയും കല്ലിനെയും സേവിച്ച്, ജനതകളെപ്പോലെയും ദേശങ്ങളിലെ വംശങ്ങളെപ്പോലെയും ആയിത്തീരുക’ എന്നു നിങ്ങൾ പറയുന്നതായ നിങ്ങളുടെ മനസ്സിലെ വിചാരം ഒരിക്കലും നടക്കുകയില്ല. <verse eid="EZK 20:32" /><verse number="33" style="v" sid="EZK 20:33" />എന്നാണ, ബലമുള്ള കൈകൊണ്ടും നീട്ടിയ ഭുജംകൊണ്ടും ചൊരിയുന്ന ക്രോധംകൊണ്ടും ഞാൻ നിങ്ങളെ ഭരിക്കും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു. <verse eid="EZK 20:33" /><verse number="34" style="v" sid="EZK 20:34" />“ബലമുള്ള കൈകൊണ്ടും നീട്ടിയ ഭുജംകൊണ്ടും ചൊരിയുന്ന ക്രോധംകൊണ്ടും ഞാൻ നിങ്ങളെ ജനതകളിൽനിന്നു പുറപ്പെടുവിക്കുകയും നിങ്ങൾ ചിതറിപ്പോയിരിക്കുന്ന രാജ്യങ്ങളിൽനിന്നു ശേഖരിക്കുകയും ചെയ്യും. <verse eid="EZK 20:34" /><verse number="35" style="v" sid="EZK 20:35" />ഞാൻ നിങ്ങളെ ജനതകളുടെ മരുഭൂമിയിലേക്ക് കൊണ്ടുചെന്ന് അവിടെവച്ച് അഭിമുഖമായി നിങ്ങളോടു വ്യവഹരിക്കും. <verse eid="EZK 20:35" /><verse number="36" style="v" sid="EZK 20:36" />മിസ്രയീമിലെ മരുഭൂമിയിൽവച്ച് നിങ്ങളുടെ പൂര്‍വ്വ പിതാക്കന്മാരോട് ഞാൻ വ്യവഹരിച്ചതുപോലെ നിങ്ങളോടും വ്യവഹരിക്കും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു. <verse eid="EZK 20:36" /><verse number="37" style="v" sid="EZK 20:37" />ഞാൻ നിങ്ങളെ വടിയുടെകീഴിലൂടെ കടത്തി നിയമത്തിന്‍റെ ബന്ധനത്തിൽ ഉൾപ്പെടുത്തും. <verse eid="EZK 20:37" /><verse number="38" style="v" sid="EZK 20:38" />എന്നോട് മത്സരിച്ച് അതിക്രമിക്കുന്നവരെ ഞാൻ നിങ്ങളുടെ ഇടയിൽനിന്ന് നീക്കിക്കളയും; അവർ ചെന്നു പാർക്കുന്ന രാജ്യത്തുനിന്ന് ഞാൻ അവരെ പുറപ്പെടുവിക്കും; എങ്കിലും യിസ്രായേൽ ദേശത്ത് അവർ കടക്കുകയില്ല; ഞാൻ യഹോവ എന്നു നിങ്ങൾ അറിയും.”<verse eid="EZK 20:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="EZK 20:39" />യിസ്രായേൽ ഗൃഹമേ, യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “നിങ്ങൾ ചെന്നു ഓരോരുത്തൻ അവനവന്‍റെ വിഗ്രഹങ്ങളെ സേവിച്ചുകൊള്ളുവിൻ; എന്നാൽ പിന്നീട് നിങ്ങൾ എന്‍റെ വാക്കു കേൾക്കും; എന്‍റെ വിശുദ്ധനാമത്തെ നിങ്ങളുടെ വഴിപാടുകളെക്കൊണ്ടും വിഗ്രഹങ്ങളെക്കൊണ്ടും ഇനി അശുദ്ധമാക്കുകയും ഇല്ല. <verse eid="EZK 20:39" /><verse number="40" style="v" sid="EZK 20:40" />എന്‍റെ വിശുദ്ധപർവ്വതത്തിൽ, യിസ്രായേലിന്‍റെ ഉന്നത പർവ്വതത്തിൽ തന്നെ, യിസ്രായേൽഗൃഹമെല്ലാം ഒട്ടൊഴിയാതെ അവിടെ ദേശത്തുവച്ച് എന്നെ സേവിക്കുമെന്ന്” യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു; അവിടെ ഞാൻ അവരെ സ്വീകരിക്കും; അവിടെ ഞാൻ നിങ്ങളുടെ വഴിപാടുകളെയും ആദ്യദാനങ്ങളെയും സകലനിവേദ്യങ്ങളെയും ആഗ്രഹിക്കും. <verse eid="EZK 20:40" /><verse number="41" style="v" sid="EZK 20:41" />ഞാൻ നിങ്ങളെ ജനതകളുടെ ഇടയിൽനിന്ന് പുറപ്പെടുവിച്ച്, നിങ്ങൾ ചിതറിപ്പോയിരിക്കുന്ന രാജ്യങ്ങളിൽനിന്നു ശേഖരിക്കുമ്പോൾ ഞാൻ നിങ്ങളെ സൗരഭ്യവാസനയായി സ്വീകരിക്കും; അങ്ങനെ ഞാൻ ജനതകൾ കാൺകെ നിങ്ങളിൽ വിശുദ്ധീകരിക്കപ്പെടും. <verse eid="EZK 20:41" /><verse number="42" style="v" sid="EZK 20:42" />നിങ്ങളുടെ പൂര്‍വ്വ പിതാക്കന്മാർക്കു കൊടുക്കുമെന്ന് ഞാൻ കൈ ഉയർത്തി സത്യംചെയ്ത ദേശമായ യിസ്രായേൽദേശത്തേക്ക് നിങ്ങളെ കൊണ്ടുവരുമ്പോൾ ഞാൻ യഹോവ എന്നു നിങ്ങൾ അറിയും. <verse eid="EZK 20:42" /><verse number="43" style="v" sid="EZK 20:43" />അവിടെവച്ചു നിങ്ങൾ നിങ്ങളുടെ വഴികളും നിങ്ങളെത്തന്നെ മലിനമാക്കിയ സകലക്രിയകളും ഓർക്കും; നിങ്ങൾ ചെയ്ത സകലദോഷവും നിമിത്തം നിങ്ങൾക്ക് നിങ്ങളോടുതന്നെ വെറുപ്പുതോന്നും. <verse eid="EZK 20:43" /><verse number="44" style="v" sid="EZK 20:44" />യിസ്രായേൽ ഗൃഹമേ, നിങ്ങളുടെ ദോഷമായുള്ള വഴികൾക്കു തക്കവണ്ണമല്ല, നിങ്ങളുടെ വഷളായുള്ള പ്രവൃത്തികൾക്കു തക്കവണ്ണവുമല്ല, എന്‍റെ നാമംനിമിത്തം തന്നെ ഞാൻ നിങ്ങളോടു പ്രവർത്തിക്കുമ്പോൾ ഞാൻ യഹോവ എന്നു നിങ്ങൾ അറിയും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 20:44" /></para>
  <para style="s">തെക്കേ ദേശത്തിന് എതിരേയുള്ള പ്രവചനം</para>
  <para style="p">
    <verse number="45" style="v" sid="EZK 20:45" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ: <verse eid="EZK 20:45" /><verse number="46" style="v" sid="EZK 20:46" />“മനുഷ്യപുത്രാ, നിന്‍റെ മുഖം തെക്കോട്ടു തിരിച്ച് തെക്കേദേശത്തിനെതിരായി പ്രസംഗിച്ച്, തെക്കേദിക്കിലെ വനപ്രദേശത്തിനെതിരായി പ്രവചിച്ച് തെക്കുള്ള വനത്തോടു പറയേണ്ടത്: <verse eid="EZK 20:46" /><verse number="47" style="v" sid="EZK 20:47" />യഹോവയുടെ വചനം കേൾക്കുക; യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഞാൻ നിന്‍റെ നടുവിൽ തീ വയ്ക്കും; അത് നിന്നിൽ ഉള്ള സകല പച്ചവൃക്ഷത്തെയും ഉണങ്ങിയവൃക്ഷത്തെയും ദഹിപ്പിച്ചുകളയും; ജ്വലിക്കുന്ന ജ്വാല കെട്ടുപോകുകയില്ല; തെക്കുമുതൽ വടക്കുവരെയുള്ള മുഖങ്ങളെല്ലാം അതിനാൽ കരിഞ്ഞുപോകും. <verse eid="EZK 20:47" /><verse number="48" style="v" sid="EZK 20:48" />‘യഹോവയായ ഞാൻ അത് കത്തിച്ചു’ എന്നു സകലജനവും കാണും; അത് കെട്ടുപോകുകയുമില്ല.”<verse eid="EZK 20:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="EZK 20:49" />അപ്പോൾ ഞാൻ: “അയ്യോ, യഹോവയായ കർത്താവേ, ‘ഇവൻ ഉപമയല്ലയോ സംസാരിക്കുന്നത്’ എന്നു അവർ എന്നെക്കുറിച്ച് പറയുന്നു” എന്നു പറഞ്ഞു.<verse eid="EZK 20:49" /></para>
  <chapter eid="EZK 20" />
  <chapter number="21" style="c" sid="EZK 21" />
  <para style="s">ബാബേൽ ദൈവികന്യായവിധിയുടെ വാൾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 21:1" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ: <verse eid="EZK 21:1" /><verse number="2" style="v" sid="EZK 21:2" />മനുഷ്യപുത്രാ, നിന്‍റെ മുഖം യെരൂശലേമിനു നേരെ തിരിച്ച് വിശുദ്ധമന്ദിരത്തിനു വിരോധമായി പ്രസംഗിച്ച് യിസ്രായേൽദേശത്തിനു വിരോധമായി പ്രവചിച്ച് യിസ്രായേൽദേശത്തോടു പറയേണ്ടത്: <verse eid="EZK 21:2" /><verse number="3" style="v" sid="EZK 21:3" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഞാൻ നിന്‍റെനേരെ പുറപ്പെട്ടു എന്‍റെ വാൾ ഉറയിൽനിന്ന് ഊരി നീതിമാനെയും ദുഷ്ടനെയും നിന്നിൽനിന്ന് ഛേദിച്ചുകളയും. <verse eid="EZK 21:3" /><verse number="4" style="v" sid="EZK 21:4" />ഞാൻ നീതിമാനെയും ദുഷ്ടനെയും നിന്നിൽനിന്നു ഛേദിച്ചുകളയുവാൻ പോകുന്നതുകൊണ്ട്, തെക്കുമുതൽ വടക്കുവരെ സകലജഡത്തിനും വിരോധമായി എന്‍റെ വാൾ ഉറയിൽനിന്ന് പുറപ്പെടും. <verse eid="EZK 21:4" /><verse number="5" style="v" sid="EZK 21:5" />യഹോവയായ ഞാൻ എന്‍റെ വാൾ ഉറയിൽനിന്ന് ഊരിയെന്ന് സകലജഡവും അറിയും. <verse eid="EZK 21:5" /><verse number="6" style="v" sid="EZK 21:6" />അത് ഇനി മടങ്ങിപ്പോരുകയില്ല. നീയോ, മനുഷ്യപുത്രാ, തകർന്ന ഹൃദയത്തോടെ നെടുവീർപ്പിടുക; അവർ കാൺകെ കഠിനമായി നെടുവീർപ്പിടുക. <verse eid="EZK 21:6" /><verse number="7" style="v" sid="EZK 21:7" />‘എന്തിന് നെടുവീർപ്പിടുന്നു’ എന്നു അവർ നിന്നോട് ചോദിച്ചാൽ നീ ഉത്തരം പറയേണ്ടത്: ‘ഒരു വർത്തമാനംനിമിത്തം തന്നെ; അത് സംഭവിക്കുമ്പോൾ സകലഹൃദയവും ഉരുകിപ്പോകും, എല്ലാകൈകളും കുഴഞ്ഞുപോകും, ഏതു മനസ്സും കലങ്ങിപ്പോകും; എല്ലാമുഴങ്കാലും വെള്ളംപോലെ ഒഴുകിപ്പോകും; അത് വന്നുകഴിഞ്ഞു’ എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു.”<verse eid="EZK 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 21:8" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ: <verse eid="EZK 21:8" /><verse number="9" style="v" sid="EZK 21:9" />“മനുഷ്യപുത്രാ, നീ പ്രവചിച്ചു പറയേണ്ടത്: യഹോവ ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:</para>
  <para style="q1" vid="EZK 21:9">ഒരു വാൾ, ഒരു വാൾ;</para>
  <para style="q2" vid="EZK 21:9">അത് മൂർച്ചകൂട്ടി മിനുക്കിയിരിക്കുന്നു എന്നു പറയുക.<verse eid="EZK 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 21:10" />കൊല നടത്തുവാൻ അതിന് മൂർച്ചകൂട്ടിയിരിക്കുന്നു;</para>
  <para style="q2" vid="EZK 21:10">മിന്നുവാൻ തക്കവണ്ണം അതിനെ മിനുക്കിയിരിക്കുന്നു;</para>
  <para style="q1" vid="EZK 21:10">അല്ലെങ്കിൽ നമുക്കു സന്തോഷിക്കാമോ?</para>
  <para style="q2" vid="EZK 21:10">അത് എന്‍റെ മകന്‍റെ ചെങ്കോലിനെയും</para>
  <para style="q2" vid="EZK 21:10">സകലവൃക്ഷത്തെയും നിന്ദിക്കുന്നു.<verse eid="EZK 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 21:11" />ഉപയോഗിക്കുവാൻ തക്കവണ്ണം അവൻ അത് മിനുക്കുവാൻ കൊടുത്തിരിക്കുന്നു;</para>
  <para style="q2" vid="EZK 21:11">കൊല്ലുന്നവൻ്റെ കയ്യിൽ കൊടുക്കുവാൻ</para>
  <para style="q2" vid="EZK 21:11">ഈ വാൾ മൂർച്ചകൂട്ടി മിനുക്കിയിരിക്കുന്നു.<verse eid="EZK 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 21:12" />മനുഷ്യപുത്രാ, നിലവിളിച്ചു മുറയിടുക!</para>
  <para style="q2" vid="EZK 21:12">വാള് എന്‍റെ ജനത്തിന്മേലും യിസ്രായേലിന്‍റെ സകലപ്രഭുക്കന്മാരുടെ മേലും വരും;</para>
  <para style="q1" vid="EZK 21:12">അവർ എന്‍റെ ജനത്തോടുകൂടി വാളിന് ഏല്പിക്കപ്പെട്ടവരാകുന്നു;</para>
  <para style="q2" vid="EZK 21:12">ആകയാൽ നീ തുടയിൽ അടിക്കുക.<verse eid="EZK 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 21:13" />അതൊരു പരീക്ഷയല്ലയോ; എന്നാൽ നിന്ദിക്കുന്ന ചെങ്കോൽ തന്നെ ഇല്ലാതെ പോയാൽ എന്ത്” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു.<verse eid="EZK 21:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 21:14" />“നീയോ മനുഷ്യപുത്രാ, പ്രവചിച്ച് കൈകൊട്ടുക;</para>
  <para style="q2" vid="EZK 21:14">വാൾ, നിഹതന്മാരുടെ വാൾ തന്നെ, മൂന്നിരട്ടിയായി ഭവിക്കട്ടെ;</para>
  <para style="q2" vid="EZK 21:14">നിഹതൻ്റെ വലിയ വാൾ അവരെ ചുറ്റുന്നു.<verse eid="EZK 21:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="EZK 21:15" />അവരുടെ ഹൃദയം ഉരുകിപ്പോകേണ്ടതിനും</para>
  <para style="q2" vid="EZK 21:15">അവരിൽ പട്ടുപോയവർ പെരുകേണ്ടതിനും</para>
  <para style="q1" vid="EZK 21:15">ഞാൻ വാളിന്‍റെ മുനയെ</para>
  <para style="q2" vid="EZK 21:15">അവരുടെ എല്ലാ വാതിലുകൾക്കും നേരെ വച്ചിരിക്കുന്നു;</para>
  <para style="q1" vid="EZK 21:15">അയ്യോ, അത് മിന്നൽപോലെയിരിക്കുന്നു;</para>
  <para style="q2" vid="EZK 21:15">അത് കൊലയ്ക്കായി കൂർപ്പിച്ചിരിക്കുന്നു.<verse eid="EZK 21:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="EZK 21:16" />പുറകോട്ടോ ഇടത്തോട്ടോ വലത്തോട്ടോ</para>
  <para style="q2" vid="EZK 21:16">നിന്‍റെ വായ്ത്തല<note caller="+" style="f"><char style="fr" closed="false">21:16 </char><char style="fq" closed="false">വായ്ത്തല </char><char style="ft" closed="false">മുഖം</char></note> തിരിയുന്നിടത്തേക്കു തന്നെ പുറപ്പെടുക.<verse eid="EZK 21:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="EZK 21:17" />ഞാനും കൈകൊട്ടി, എന്‍റെ ക്രോധം ശമിപ്പിക്കും;</para>
  <para style="q2" vid="EZK 21:17">യഹോവയായ ഞാൻ അത് അരുളിച്ചെയ്തിരിക്കുന്നു.”<verse eid="EZK 21:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="EZK 21:18" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ: <verse eid="EZK 21:18" /><verse number="19" style="v" sid="EZK 21:19" />മനുഷ്യപുത്രാ, ബാബേൽരാജാവിന്‍റെ വാൾ വരേണ്ടതിന് നീ രണ്ടു വഴി നിയമിക്കുക; രണ്ടും ഒരു ദേശത്തുനിന്ന് തന്നെ പുറപ്പെടേണം; ഒരു ചൂണ്ടുപലക ഉണ്ടാക്കി നഗരത്തിലേക്കുള്ള വഴിയുടെ തലയ്ക്കൽ നാട്ടുക. <verse eid="EZK 21:19" /><verse number="20" style="v" sid="EZK 21:20" />അങ്ങനെ വാൾ അമ്മോന്യരുടെ രബ്ബയിലും യെഹൂദായിൽ ഉറപ്പുള്ള യെരൂശലേമിലും വരേണ്ടതിന് നീ വഴി നിയമിക്കുക. <verse eid="EZK 21:20" /><verse number="21" style="v" sid="EZK 21:21" />ബാബേൽരാജാവ് ഇരുവഴിത്തലയ്ക്കൽ, വഴിത്തിരിവിങ്കൽ തന്നെ, പ്രശ്നം നോക്കുവാൻ നില്ക്കുന്നു; അവൻ തന്‍റെ അമ്പുകളെ കുലുക്കി കുലദേവന്മാരോടു ചോദിക്കുകയും കരൾ നോക്കുകയും ചെയ്യുന്നു. <note caller="+" style="f"><char style="fr" closed="false">21:21 </char><char style="fq" closed="false">കുലദേവന്മാരോടു ചോദിക്കുകയും കരൾ നോക്കുകയും ചെയ്യുന്നു. </char><char style="ft" closed="false">പ്രശ്നം നോക്കുവാനുള്ള മൂന്നുപാധികൾ 1 യരൂശലേമിനും രബ്ബക്കും വേണ്ടി അവൻ ഓരോ അമ്പ് കാണിക്കുന്നു 2 അവൻ തന്‍റെ കുലദേവന്മാരോടു ചോദിക്കുന്നു 3 കൊല്ലപ്പെട്ട ചില മൃഗങ്ങളുടെ കരളിലേക്ക് അവൻ നോക്കുന്നു</char></note> <verse eid="EZK 21:21" /><verse number="22" style="v" sid="EZK 21:22" />യന്ത്രമുട്ടികളെ വയ്ക്കേണ്ടതിനും വൻകൊലയ്ക്കായി വായ് തുറന്ന് ആർപ്പുവിളിക്കേണ്ടതിനും വാതിലുകളുടെ നേരെ യന്ത്രമുട്ടികൾ വയ്ക്കേണ്ടതിനും ഉപരോധം ഏർപ്പെടുത്തി കോട്ട പണിയേണ്ടതിനും യെരൂശലേമിനെക്കുറിച്ചുള്ള പ്രശ്നം അവന്‍റെ വലംകൈയിൽ വന്നിരിക്കുന്നു. <verse eid="EZK 21:22" /><verse number="23" style="v" sid="EZK 21:23" />എന്നാൽ അത് അവർക്ക് വ്യാജലക്ഷണമായി തോന്നുന്നു; അവർ ആണ ഇടുവിച്ചിരിക്കുന്നുവല്ലോ; എന്നാൽ അവർ പിടിക്കപ്പെടേണ്ടതിന് അവൻ അകൃത്യം ഓർമ്മിപ്പിക്കുന്നു.” <verse eid="EZK 21:23" /><verse number="24" style="v" sid="EZK 21:24" />അതുകൊണ്ട് യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “നിങ്ങളുടെ സകലപ്രവൃത്തികളിലും നിങ്ങളുടെ പാപങ്ങൾ ഓർക്കത്തക്കവണ്ണം നിങ്ങളുടെ അതിക്രമങ്ങൾ വെളിപ്പെട്ടുവരുന്നതിനാൽ നിങ്ങൾ നിങ്ങളുടെ അകൃത്യം ഓർമ്മിപ്പിച്ചിരിക്കുന്നതുകൊണ്ടും നിങ്ങളെയും ഓർത്തിരിക്കുന്നതുകൊണ്ടും നിങ്ങൾ പിടിക്കപ്പെടും.<verse eid="EZK 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 21:25" />നിഹതനും ദുഷ്ടനുമായി യിസ്രായേലിന്‍റെ പ്രഭുവായുള്ളോവേ, നിന്‍റെ അകൃത്യത്തിൻ്റെ അന്ത്യനാൾ വന്നിരിക്കുന്നു.” <verse eid="EZK 21:25" /><verse number="26" style="v" sid="EZK 21:26" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഞാൻ തലപ്പാവ് നീക്കി കിരീടം എടുത്തുകളയും; അത് അങ്ങനെ ഇരിക്കുകയില്ല; ഞാൻ താണതിനെ ഉയർത്തുകയും ഉയർന്നതിനെ താഴ്ത്തുകയും ചെയ്യും. <verse eid="EZK 21:26" /><verse number="27" style="v" sid="EZK 21:27" />ഞാൻ അതിന് ഉന്മൂലനാശം, ഉന്മൂലനാശം, ഉന്മൂലനാശം വരുത്തും; അതിന് അവകാശമുള്ളവൻ വരുവോളം അത് ഇല്ലാതെയിരിക്കും; അവന് ഞാൻ അത് കൊടുക്കും.”<verse eid="EZK 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 21:28" />മനുഷ്യപുത്രാ, നീ പ്രവചിച്ചു പറയേണ്ടത്: അമ്മോന്യരെക്കുറിച്ചും അവരുടെ നിന്ദയെക്കുറിച്ചും യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: <verse eid="EZK 21:28" /><verse number="29" style="v" sid="EZK 21:29" />“അകൃത്യത്തിൻ്റെ അവസാനനാൾ വരുമ്പോൾ, ദുഷ്ടന്മാരായ നിഹതന്മാരുടെ കഴുത്തിൽ വെക്കേണ്ടതിന് അവർ നിനക്കു വ്യാജം ദർശിക്കുന്ന നേരത്തും, നിനക്കു കപടലക്ഷണം പറയുന്ന നേരത്തും ഒരു വാൾ, ഒരു വാൾ ഊരിയിരിക്കുന്നു; അത് മിന്നൽപോലെ മിന്നേണ്ടതിനും തിന്നുകളയേണ്ടതിനും കൊലയ്ക്കായി മിനുക്കിയിരിക്കുന്നു എന്നു പറയുക. <verse eid="EZK 21:29" /><verse number="30" style="v" sid="EZK 21:30" />അത് ഉറയിൽ ഇടുക; നീ സൃഷ്ടിക്കപ്പെട്ട സ്ഥലത്ത്, നിന്‍റെ ജന്മദേശത്തു തന്നെ ഞാൻ നിന്നെ ന്യായംവിധിക്കും, <verse eid="EZK 21:30" /><verse number="31" style="v" sid="EZK 21:31" />ഞാൻ എന്‍റെ ക്രോധം നിന്‍റെമേൽ പകർന്ന് എന്‍റെ കോപാഗ്നി നിന്‍റെമേൽ ഊതി, മൃഗപ്രായരും നശിപ്പിക്കുവാൻ സമർത്ഥന്മാരുമായ മനുഷ്യരുടെ കയ്യിൽ നിന്നെ ഏല്പിക്കും. <verse eid="EZK 21:31" /><verse number="32" style="v" sid="EZK 21:32" />നീ തീയ്ക്കിരയായ്തീരും; നിന്‍റെ രക്തം നിന്‍റെ ദേശത്തിന്‍റെ നടുവിൽ ഇരിക്കും; നിന്നെ ഇനി ആരും ഓർക്കുകയില്ല; യഹോവയായ ഞാൻ അത് അരുളിച്ചെയ്തിരിക്കുന്നു.”<verse eid="EZK 21:32" /></para>
  <chapter eid="EZK 21" />
  <chapter number="22" style="c" sid="EZK 22" />
  <para style="s">യെരൂശലേമിൻ്റെ അകൃത്യങ്ങൾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 22:1" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ:<verse eid="EZK 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EZK 22:2" />“മനുഷ്യപുത്രാ, നീ ന്യായംവിധിക്കുമോ? രക്തപാതകമുള്ള പട്ടണത്തെ നീ ന്യായംവിധിക്കുമോ? എന്നാൽ നീ അതിന്‍റെ സകലമ്ലേച്ഛതകളും അതിനോട് അറിയിച്ചു പറയേണ്ടത്: <verse eid="EZK 22:2" /><verse number="3" style="v" sid="EZK 22:3" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “നിന്‍റെ കാലം വരുവാൻ തക്കവണ്ണം നിന്‍റെ നടുവിൽ രക്തം ചൊരിഞ്ഞ് നിന്നെത്തന്നെ മലിനമാക്കേണ്ടതിന് വിഗ്രഹങ്ങളെ ഉണ്ടാക്കുന്ന നഗരമേ! <verse eid="EZK 22:3" /><verse number="4" style="v" sid="EZK 22:4" />നീ ചൊരിഞ്ഞ രക്തത്താൽ നീ കുറ്റക്കാരിയായിത്തീർന്നു; നീ ഉണ്ടാക്കിയിരിക്കുന്ന വിഗ്രഹങ്ങളാൽ നീ നിന്നെത്തന്നെ മലിനമാക്കിയിരിക്കുന്നു; നിന്‍റെ നാളുകളെ നീ സമീപിക്കുമാറാക്കി; നിന്‍റെ ആണ്ടുകൾ നിനക്കു വന്നെത്തിയിരിക്കുന്നു; അതുകൊണ്ട് ഞാൻ നിന്നെ ജനതകൾക്കു നിന്ദയും സകലദേശങ്ങൾക്കും പരിഹാസവിഷയവും ആക്കിയിരിക്കുന്നു. <verse eid="EZK 22:4" /><verse number="5" style="v" sid="EZK 22:5" />നിനക്കു സമീപസ്ഥന്മാരും ദൂരസ്ഥന്മാരും ആയിരിക്കുന്നവർ ദുഷ്കീർത്തിയും ക്ഷോഭവും ഉള്ള നിന്നെ പരിഹസിക്കും.<verse eid="EZK 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 22:6" />“യിസ്രായേൽ പ്രഭുക്കന്മാർ ഓരോരുത്തനും അവനാൽ കഴിയുന്നിടത്തോളം രക്തം ചൊരിയുവാനത്രേ നിന്നിൽ വസിക്കുന്നത്. <verse eid="EZK 22:6" /><verse number="7" style="v" sid="EZK 22:7" />നിന്‍റെ നടുവിൽ അവർ അപ്പനെയും അമ്മയെയും പുച്ഛിക്കുന്നു; നിന്‍റെ മദ്ധ്യേ അവർ പരദേശിയെ പീഡിപ്പിക്കുന്നു; നിന്നിൽവച്ച് അവർ അനാഥനെയും വിധവയെയും ഉപദ്രവിക്കുന്നു. <verse eid="EZK 22:7" /><verse number="8" style="v" sid="EZK 22:8" />എന്‍റെ വിശുദ്ധവസ്തുക്കളെ നീ ധിക്കരിച്ച് എന്‍റെ ശബ്ബത്തുകളെ അശുദ്ധമാക്കുന്നു. <verse eid="EZK 22:8" /><verse number="9" style="v" sid="EZK 22:9" />രക്തം ചൊരിയേണ്ടതിന് ഏഷണി പറയുന്നവർ നിന്നിൽ ഉണ്ട്; പൂജാഗിരികളിൽ ഭക്ഷണം കഴിക്കുന്നവർ നിന്നിൽ ഉണ്ട്; നിന്‍റെ മദ്ധ്യേ അവർ ദുഷ്കർമ്മം പ്രവർത്തിക്കുന്നു. <verse eid="EZK 22:9" /><verse number="10" style="v" sid="EZK 22:10" />നിന്നിൽ അവർ അപ്പന്‍റെ നഗ്നത അനാവൃതമാക്കുന്നു; നിന്നിൽവച്ച് അവർ ഋതുമാലിന്യത്തിൽ ഇരിക്കുന്നവളെ വഷളാക്കുന്നു. <verse eid="EZK 22:10" /><verse number="11" style="v" sid="EZK 22:11" />ഒരുത്തൻ തന്‍റെ കൂട്ടുകാരന്‍റെ ഭാര്യയുമായി മ്ലേച്ഛത പ്രവർത്തിക്കുന്നു; മറ്റൊരുത്തൻ തന്‍റെ മരുമകളെ ദുഷ്ടത പ്രവർത്തിച്ച് മലിനയാക്കുന്നു; വേറൊരുത്തൻ നിന്നിൽവച്ച് തന്‍റെ അപ്പന്‍റെ മകളായ സഹോദരിയെ വഷളാക്കുന്നു. <verse eid="EZK 22:11" /><verse number="12" style="v" sid="EZK 22:12" />രക്തം ചൊരിയേണ്ടതിന് അവർ നിന്നിൽ കൈക്കൂലി വാങ്ങുന്നു; പലിശയും ലാഭവും വാങ്ങി നീ കൂട്ടുകാരെ ഞെരുക്കി സമ്പാദ്യമുണ്ടാക്കി എന്നെ മറന്നുകളഞ്ഞിരിക്കുന്നു” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 22:13" />“നീ സമ്പാദിച്ചിരിക്കുന്ന ലാഭത്തെയും നിന്‍റെ നടുവിലുണ്ടായ രക്തപാതകത്തെയും കുറിച്ച് ഞാൻ കൈകൊട്ടും: <verse eid="EZK 22:13" /><verse number="14" style="v" sid="EZK 22:14" />ഞാൻ നിന്നോട് കാര്യം തീർക്കുന്ന നാളിൽ നീ ധൈര്യത്തോടെ നില്‍ക്കുമോ? നിന്‍റെ കൈകൾ ബലപ്പെട്ടിരിക്കുമോ?” യഹോവയായ ഞാൻ അത് അരുളിച്ചെയ്തിരിക്കുന്നു; “ഞാൻ നിവർത്തിക്കുകയും ചെയ്യും. <verse eid="EZK 22:14" /><verse number="15" style="v" sid="EZK 22:15" />ഞാൻ നിന്നെ ജനതകളുടെ ഇടയിൽ ചിന്നിച്ച് രാജ്യങ്ങളിൽ ചിതറിച്ച് നിന്‍റെ മലിനത നിന്നിൽനിന്നു നീക്കും. <verse eid="EZK 22:15" /><verse number="16" style="v" sid="EZK 22:16" />ജനതകൾ കാൺകെ നീ നിന്നിൽത്തന്നെ മലിനയായിത്തീരും; ഞാൻ യഹോവ എന്നു നീ അറിയും.”<verse eid="EZK 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 22:17" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായത് എന്തെന്നാൽ: <verse eid="EZK 22:17" /><verse number="18" style="v" sid="EZK 22:18" />മനുഷ്യപുത്രാ, യിസ്രായേൽഗൃഹം എനിക്ക് ലോഹമാലിന്യമായിത്തീർന്നിരിക്കുന്നു; അവരെല്ലാവരും ഉലയുടെ നടുവിൽ താമ്രവും വെളുത്തീയവും ഇരിമ്പും കറുത്തീയവും തന്നെ; അവർ വെള്ളിയുടെ മാലിന്യമായിത്തീർന്നിരിക്കുന്നു.” <verse eid="EZK 22:18" /><verse number="19" style="v" sid="EZK 22:19" />അതുകൊണ്ട് യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “നിങ്ങൾ എല്ലാവരും ലോഹമാലിന്യമായിത്തീർന്നിരിക്കുകകൊണ്ട് ഞാൻ നിങ്ങളെ യെരൂശലേമിന്‍റെ നടുവിൽ കൂട്ടും. <verse eid="EZK 22:19" /><verse number="20" style="v" sid="EZK 22:20" />വെള്ളിയും താമ്രവും ഇരിമ്പും കറുത്തീയവും വെളുത്തീയവും ഉലയുടെ നടുവിൽ ഇട്ടു ഊതി ഉരുക്കുന്നതുപോലെ, ഞാൻ എന്‍റെ കോപത്തിലും എന്‍റെ ക്രോധത്തിലും നിങ്ങളെയും കൂട്ടിയുരുക്കും. <verse eid="EZK 22:20" /><verse number="21" style="v" sid="EZK 22:21" />ഞാൻ നിങ്ങളെ കൂട്ടി എന്‍റെ ക്രോധാഗ്നിയെ നിങ്ങളുടെമേൽ ഊതും; അങ്ങനെ നിങ്ങൾ അതിന്‍റെ നടുവിൽ ഉരുകിപ്പോകും. <verse eid="EZK 22:21" /><verse number="22" style="v" sid="EZK 22:22" />ഉലയുടെ നടുവിൽ വെള്ളി ഉരുകിപ്പോകുന്നതു പോലെ, നിങ്ങൾ അതിന്‍റെ നടുവിൽ ഉരുകിപ്പോകും; യഹോവയായ ഞാൻ എന്‍റെ ക്രോധം നിങ്ങളുടെമേൽ പകർന്നിരിക്കുന്നു എന്നു നിങ്ങൾ അറിയും.”<verse eid="EZK 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 22:23" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ: <verse eid="EZK 22:23" /><verse number="24" style="v" sid="EZK 22:24" />“മനുഷ്യപുത്രാ, നീ അതിനോട് പറയേണ്ടത്: ക്രോധദിവസത്തിൽ നീ ശുദ്ധിയില്ലാത്തതും മഴയില്ലാത്തതുമായ ദേശമായിരിക്കും. <verse eid="EZK 22:24" /><verse number="25" style="v" sid="EZK 22:25" />അതിന്‍റെ നടുവിൽ അതിലെ പ്രവാചകന്മാരുടെ ഒരു കൂട്ടുകെട്ടുണ്ട്; അലറി ഇര കടിച്ചുകീറുന്ന ഒരു സിംഹംപോലെ അവർ മനുഷ്യരെ വിഴുങ്ങിക്കളയുന്നു; നിക്ഷേപങ്ങളും വിലയേറിയ വസ്തുക്കളും അപഹരിച്ചുകൊണ്ട് അവർ അതിന്‍റെ നടുവിൽ വിധവമാരെ വർദ്ധിപ്പിക്കുന്നു. <verse eid="EZK 22:25" /><verse number="26" style="v" sid="EZK 22:26" />അതിലെ പുരോഹിതന്മാർ എന്‍റെ ന്യായപ്രമാണത്തോടു ദ്രോഹം ചെയ്തു; എന്‍റെ വിശുദ്ധവസ്തുക്കൾ അശുദ്ധമാക്കുന്നു; അവർ ശുദ്ധവും അശുദ്ധവും തമ്മിൽ വേർതിരിക്കുന്നില്ല; മലിനവും നിർമ്മലവും തമ്മിലുള്ള ഭേദം കാണിച്ചുകൊടുക്കുന്നതുമില്ല; ഞാൻ അവരുടെ മദ്ധ്യത്തിൽ അശുദ്ധനായി ഭവിക്കത്തക്കവണ്ണം അവർ എന്‍റെ ശബ്ബത്തുകളെ നോക്കാതെ കണ്ണ് മറച്ചുകളയുന്നു. <verse eid="EZK 22:26" /><verse number="27" style="v" sid="EZK 22:27" />അതിന്‍റെ നടുവിലെ പ്രഭുക്കന്മാർ ലാഭം ഉണ്ടാക്കേണ്ടതിന് ഇര കടിച്ചുകീറുന്ന ചെന്നായ്ക്കളെപ്പോലെ രക്തം ചൊരിയുവാനും മനുഷ്യരെ നശിപ്പിക്കുവാനും നോക്കുന്നു. <verse eid="EZK 22:27" /><verse number="28" style="v" sid="EZK 22:28" />അതിലെ പ്രവാചകന്മാർ വ്യാജം ദർശിച്ചും കള്ളപ്രശ്നം പറഞ്ഞും യഹോവ അരുളിച്ചെയ്യാതിരിക്കെ, ‘യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു’ എന്നു പറഞ്ഞുംകൊണ്ട് അവർക്കുവേണ്ടി വെള്ള പൂശുന്നു. <verse eid="EZK 22:28" /><verse number="29" style="v" sid="EZK 22:29" />ദേശത്തിലെ ജനം പീഡനം ചെയ്യുകയും പിടിച്ചുപറിക്കുകയും എളിയവനെയും ദരിദ്രനെയും ഉപദ്രവിക്കുകയും പരദേശിയെ അന്യായമായി പീഡിപ്പിക്കുകയും ചെയ്യുന്നു.<verse eid="EZK 22:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 22:30" />“ഞാൻ ദേശത്തെ നശിപ്പിക്കാത്തവിധം അതിന് മതിൽ കെട്ടി എന്‍റെ മുമ്പാകെ ഇടിവിൽ നില്ക്കേണ്ടതിന് ഒരു പുരുഷനെ ഞാൻ അവരുടെ ഇടയിൽ അന്വേഷിച്ചു; ആരെയും കണ്ടില്ലതാനും. <verse eid="EZK 22:30" /><verse number="31" style="v" sid="EZK 22:31" />ആകയാൽ ഞാൻ എന്‍റെ ക്രോധം അവരുടെ മേൽ പകർന്ന് എന്‍റെ കോപാഗ്നികൊണ്ട് അവരെ നശിപ്പിച്ചുകളഞ്ഞിരിക്കുന്നു; അവരുടെ നടപ്പിനു തക്കവിധം ഞാൻ അവർക്ക് പകരം കൊടുത്തിരിക്കുന്നു” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 22:31" /></para>
  <chapter eid="EZK 22" />
  <chapter number="23" style="c" sid="EZK 23" />
  <para style="s">വ്യഭിചാരിണികളായ രണ്ടു സഹോദരിമാർ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 23:1" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായത് എന്തെന്നാൽ: <verse eid="EZK 23:1" /><verse number="2" style="v" sid="EZK 23:2" />“മനുഷ്യപുത്രാ, ഒരമ്മയുടെ മക്കളായ രണ്ടു സ്ത്രീകൾ ഉണ്ടായിരുന്നു. <verse eid="EZK 23:2" /><verse number="3" style="v" sid="EZK 23:3" />അവർ മിസ്രയീമിൽ വച്ചു പരസംഗം ചെയ്തു; യൗവനത്തിൽ തന്നെ അവർ പരസംഗം ചെയ്തു; അവിടെവച്ച് അവരുടെ സ്തനങ്ങൾ തഴുകപ്പെട്ടു; അവരുടെ മാറിടം തലോടപ്പെട്ടു. <verse eid="EZK 23:3" /><verse number="4" style="v" sid="EZK 23:4" />അവരിൽ മൂത്തവൾക്ക് ഒഹൊലാ എന്നും ഇളയവൾക്ക് ഒഹൊലീബാ എന്നും പേരായിരുന്നു; അവർ എനിക്കുള്ളവരായിരുന്നു; പുത്രന്മാരെയും പുത്രിമാരെയും പ്രസവിച്ചു; അവരുടെ പേര് ഒഹൊലാ എന്നത് ശമര്യയും ഒഹൊലീബാ എന്നത് യെരൂശലേമും ആകുന്നു.<verse eid="EZK 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 23:5" />“എന്നാൽ ഒഹൊലാ എന്നെ വിട്ട് പരസംഗം ചെയ്തു; <verse eid="EZK 23:5" /><verse number="6" style="v" sid="EZK 23:6" />അവൾ തന്‍റെ സമീപസ്ഥരായ അശ്ശൂര്യജാരന്മാരെ മോഹിച്ചു; അവർ ധൂമ്രവസ്ത്രം ധരിച്ച ദേശാധിപതികളും സ്ഥാനാപതികളും കോമളയുവാക്കളും കുതിരപ്പുറത്തു കയറി ഓടിക്കുന്നവരുമായിരുന്നു. <verse eid="EZK 23:6" /><verse number="7" style="v" sid="EZK 23:7" />അശ്ശൂര്യശ്രേഷ്ഠന്മാരായവരുമായി അവൾ വേശ്യാവൃത്തിയിൽ കഴിഞ്ഞുകൂടി; താൻ മോഹിച്ച എല്ലാവരുടെയും സകലവിഗ്രഹങ്ങളാലും അവൾ തന്നെത്തന്നെ മലിനയാക്കി. <verse eid="EZK 23:7" /><verse number="8" style="v" sid="EZK 23:8" />മിസ്രയീമിൽ നിന്നു കൊണ്ടുവന്ന തന്‍റെ വേശ്യാവൃത്തിയും അവൾ ഉപേക്ഷിച്ചില്ല; അവർ അവളുടെ യൗവനത്തിൽ അവളോടുകൂടി ശയിച്ച്, അവളുടെ മാറിടം തലോടി, തങ്ങളുടെ പരസംഗത്തിന് അവളെ ഉപകരണമാക്കി.<verse eid="EZK 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 23:9" />അതുകൊണ്ട് ഞാൻ അവളെ അവളുടെ ജാരന്മാരുടെ കയ്യിൽ, അവൾ മോഹിച്ചിരുന്ന അശ്ശൂര്യരുടെ കയ്യിൽ തന്നെ, ഏല്പിച്ചു. <verse eid="EZK 23:9" /><verse number="10" style="v" sid="EZK 23:10" />അവർ അവളുടെ നഗ്നത അനാവരണം ചെയ്തു; അവളുടെ പുത്രന്മാരെയും പുത്രിമാരെയും പിടിക്കുകയും അവളെ വാൾകൊണ്ട് കൊല്ലുകയും ചെയ്തു; അവർ അവളുടെമേൽ വിധി നടത്തിയതുകൊണ്ട് അവൾ സ്ത്രീകളുടെ ഇടയിൽ ഒരു നിന്ദാപാത്രമായിത്തീർന്നു.<verse eid="EZK 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 23:11" />എന്നാൽ അവളുടെ സഹോദരിയായ ഒഹൊലീബാ ഇതു കണ്ടു എങ്കിലും, തന്‍റെ കാമവികാരത്തിൽ അവളെക്കാളും, തന്‍റെ വേശ്യാവൃത്തിയിൽ സഹോദരിയുടെ വേശ്യവൃത്തിയെക്കാളും അധികം വഷളത്തം പ്രവർത്തിച്ചു. <verse eid="EZK 23:11" /><verse number="12" style="v" sid="EZK 23:12" />മോടിയായി ഉടുത്തുചമഞ്ഞ ദേശാധിപതികളും സ്ഥാനാപതികളും കുതിരപ്പുറത്തു കയറി ഓടിക്കുന്നവരും കോമളയുവാക്കന്മാരുമായ, സമീപസ്ഥരായ എല്ലാ അശ്ശൂര്യരെയും അവൾ മോഹിച്ചു, <verse eid="EZK 23:12" /><verse number="13" style="v" sid="EZK 23:13" />അവളും തന്നെത്തന്നെ മലിനയാക്കി എന്നു ഞാൻ കണ്ടു; ഇരുവരും ഒരേ വഴിയിൽ തന്നെ നടന്നു.<verse eid="EZK 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 23:14" />“അവൾ പിന്നെയും പരസംഗം ചെയ്തുകൊണ്ടിരുന്നു; ചുവപ്പുചായംകൊണ്ട് എഴുതിയ കല്ദയരുടെ ചിത്രങ്ങൾ, <verse eid="EZK 23:14" /><verse number="15" style="v" sid="EZK 23:15" />കല്ദയദേശം ജന്മഭൂമിയായുള്ള ബാബേല്‍ക്കാരുടെ രൂപത്തിൽ അരയ്ക്ക് കച്ചകെട്ടി, തലയിൽ തലപ്പാവു ചുറ്റി, പ്രഭുക്കന്മാരെപ്പോലെ കാണപ്പെട്ട പുരുഷന്മാരുടെ ചിത്രങ്ങളെ തന്നെ ചുവരിന്മേൽ വരച്ചിരിക്കുന്നത് അവൾ കണ്ടു. <verse eid="EZK 23:15" /><verse number="16" style="v" sid="EZK 23:16" />കണ്ട ഉടനെ അവൾ അവരെ മോഹിച്ച്, കല്ദയദേശത്തേക്ക് അവരുടെ അടുക്കൽ ദൂതന്മാരെ അയച്ചു. <verse eid="EZK 23:16" /><verse number="17" style="v" sid="EZK 23:17" />അങ്ങനെ ബാബേല്‍ക്കാർ പ്രേമശയനത്തിനായി അവളുടെ അടുക്കൽവന്ന് പരസംഗംകൊണ്ട് അവളെ മലിനയാക്കി; അവൾ അവരാൽ മലിനയായിത്തീർന്നു; പിന്നെ അവൾക്ക് അവരോട് വെറുപ്പുതോന്നി. <verse eid="EZK 23:17" /><verse number="18" style="v" sid="EZK 23:18" />ഇങ്ങനെ അവൾ തന്‍റെ പരസംഗം വെളിപ്പെടുത്തി തന്‍റെ നഗ്നത അനാവരണം ചെയ്തപ്പോൾ, എനിക്ക് അവളുടെ സഹോദരിയോട് വെറുപ്പു തോന്നിയതുപോലെ അവളോടും വെറുപ്പുതോന്നി. <verse eid="EZK 23:18" /><verse number="19" style="v" sid="EZK 23:19" />എന്നിട്ടും അവൾ മിസ്രയീമിൽ വച്ചു പരസംഗം ചെയ്ത തന്‍റെ യൗവനകാലം ഓർത്തു പരസംഗം വർദ്ധിപ്പിച്ചു. <verse eid="EZK 23:19" /><verse number="20" style="v" sid="EZK 23:20" />കഴുതകളുടെ ലിംഗംപോലെ ലിംഗവും കുതിരകളുടെ ബീജസ്രവണംപോലെ ബീജസ്രവണവും ഉള്ള ജാരന്മാരെ അവൾ മോഹിച്ചു. <verse eid="EZK 23:20" /><verse number="21" style="v" sid="EZK 23:21" />ഇങ്ങനെ നിന്‍റെ യൗവനസ്തനങ്ങൾ നിമിത്തം മിസ്രയീമ്യർ നിന്‍റെ സ്തനാഗ്രങ്ങൾ തലോടിയ നിന്‍റെ യൗവനത്തിലെ ദുഷ്കർമ്മം നീ തിരിഞ്ഞുനോക്കി.<verse eid="EZK 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 23:22" />“അതുകൊണ്ട് ഒഹൊലീബയേ, യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: ‘ബാബേല്‍ക്കാർ, കല്ദയർ, പെക്കോദ്യർ, ശോവ്യർ, <verse eid="EZK 23:22" /><verse number="23" style="v" sid="EZK 23:23" />കോവ്യർ, അശ്ശൂര്യർ എന്നിങ്ങനെയുള്ള കോമളയുവാക്കളും ദേശാധിപതികളും സ്ഥാനാപതികളും പ്രഭുക്കന്മാരും കീർത്തികേട്ടവരും കുതിരപ്പുറത്തു കയറി ഓടിക്കുന്നവരുമായി, നിനക്കു വെറുപ്പു തോന്നിയിരിക്കുന്ന നിന്‍റെ ജാരന്മാരെ ഞാൻ നിനക്കു വിരോധമായി ഉണർത്തി എല്ലാവശത്തുനിന്നും നിന്‍റെനേരെ വരുത്തും. <verse eid="EZK 23:23" /><verse number="24" style="v" sid="EZK 23:24" />അവർ അനവധി രഥങ്ങളും വാഹനങ്ങളും ഒരു ജനസമൂഹവുമായി നിന്‍റെനേരെ വരും; അവർ പരിചയും പലകയും പിടിച്ച് ശിരസ്ത്രം ധരിച്ച് നിന്നെ വന്നു വളയും; ഞാൻ ന്യായവിധി അവരെ ഭരമേല്പിക്കും; അവർ അവരുടെ ന്യായങ്ങൾക്ക് അനുസരിച്ച് നിന്നെ ന്യായംവിധിക്കും. <verse eid="EZK 23:24" /><verse number="25" style="v" sid="EZK 23:25" />ഞാൻ എന്‍റെ തീക്ഷ്ണത നിന്‍റെനേരെ പ്രയോഗിക്കും; അവർ ക്രോധത്തോടെ നിന്നോട് പെരുമാറും; അവർ നിന്‍റെ മൂക്കും ചെവിയും ചെത്തിക്കളയും; നിനക്കു ശേഷിക്കുന്നവർ വാൾകൊണ്ടു വീഴും; അവർ നിന്‍റെ പുത്രന്മാരെയും പുത്രിമാരെയും പിടിച്ചു കൊണ്ടുപോകും; നിനക്കു ശേഷിക്കുന്നവർ തീയാൽ ദഹിപ്പിക്കപ്പെടും. <verse eid="EZK 23:25" /><verse number="26" style="v" sid="EZK 23:26" />അവർ നിന്‍റെ വസ്ത്രം ഉരിഞ്ഞ് ആഭരണങ്ങൾ എടുത്തുകളയും. <verse eid="EZK 23:26" /><verse number="27" style="v" sid="EZK 23:27" />ഇങ്ങനെ ഞാൻ നിന്‍റെ ദുർന്നടപ്പും, മിസ്രയീമിൽ നിന്നു കൊണ്ടുവന്ന നിന്‍റെ വേശ്യാവൃത്തിയും നിർത്തലാക്കും; നീ ഇനി തലപൊക്കി അവരെ നോക്കുകയില്ല; മിസ്രയീമിനെ ഓർക്കുകയുമില്ല.”<verse eid="EZK 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 23:28" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഞാൻ നിന്നെ നീ പകയ്ക്കുന്നവരുടെ കയ്യിൽ, നിനക്കു വെറുപ്പു തോന്നുന്നവരുടെ കയ്യിൽ തന്നെ, ഏല്പിക്കും. <verse eid="EZK 23:28" /><verse number="29" style="v" sid="EZK 23:29" />അവർ പകയോടെ നിന്നോട് പെരുമാറി, നിന്‍റെ സമ്പാദ്യം മുഴുവനും എടുത്ത്, നിന്നെ നഗ്നയും അനാവൃതയും ആക്കിവിടും; അങ്ങനെ നിന്‍റെ വേശ്യാവൃത്തിയുടെ നഗ്നതയും നിന്‍റെ ദുർന്നടപ്പും പരസംഗങ്ങളും വെളിപ്പെട്ടുവരും. <verse eid="EZK 23:29" /><verse number="30" style="v" sid="EZK 23:30" />നീ ജനതകളോടു ചേർന്ന് പരസംഗം ചെയ്തതുകൊണ്ടും അവരുടെ വിഗ്രഹങ്ങളാൽ നിന്നെത്തന്നെ മലിനയാക്കിയതുകൊണ്ടും ഇത് നിനക്കു ഭവിക്കും. <verse eid="EZK 23:30" /><verse number="31" style="v" sid="EZK 23:31" />നീ സഹോദരിയുടെ വഴിയിൽ നടന്നതുകൊണ്ട് ഞാൻ അവളുടെ പാനപാത്രം നിന്‍റെ കയ്യിൽ തരും.”<verse eid="EZK 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 23:32" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “നീ സഹോദരിയുടെ ആഴവും വിസ്താരവും ഉള്ള പാനപാത്രത്തിൽനിന്നു കുടിച്ച് നിന്ദയ്ക്കും പരിഹാസത്തിനും വിഷയമായിത്തീരും; അതിൽ വളരെ കൊള്ളുമല്ലോ. <verse eid="EZK 23:32" /><verse number="33" style="v" sid="EZK 23:33" />ഭീതിയും ശൂന്യതയുമുള്ള പാനപാത്രമായി, നിന്‍റെ സഹോദരി ശമര്യയുടെ പാനപാത്രമായ ലഹരിയും ദുഃഖവുംകൊണ്ട് നീ നിറഞ്ഞിരിക്കുന്നു. <verse eid="EZK 23:33" /><verse number="34" style="v" sid="EZK 23:34" />നീ അത് കുടിച്ചു വറ്റിച്ച് ഉടച്ച് കഷണങ്ങളെ നക്കി നിന്‍റെ സ്തനങ്ങളെ കീറിക്കളയും; ഞാൻ അത് കല്പിച്ചിരിക്കുന്നു” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു.<verse eid="EZK 23:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 23:35" />ആകയാൽ യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “നീ എന്നെ മറന്ന് എന്നെ നിന്‍റെ പിമ്പിൽ എറിഞ്ഞുകളയുകകൊണ്ട് നീ നിന്‍റെ ദുർന്നടപ്പും പരസംഗവും വഹിക്കുക.”<verse eid="EZK 23:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EZK 23:36" />പിന്നെയും യഹോവ എന്നോട് അരുളിച്ചെയ്തത്: “മനുഷ്യപുത്രാ, നീ ഒഹൊലയെയും ഒഹൊലീബയെയും ന്യായംവിധിക്കുമോ? എന്നാൽ അവരുടെ മ്ലേച്ഛതകൾ അവരോട് അറിയിക്കുക. <verse eid="EZK 23:36" /><verse number="37" style="v" sid="EZK 23:37" />അവർ വ്യഭിചാരം ചെയ്തു; അവരുടെ കയ്യിൽ രക്തം ഉണ്ട്; അവരുടെ വിഗ്രഹങ്ങളോട് അവർ വ്യഭിചാരം ചെയ്തു; അവർ എനിക്ക് പ്രസവിച്ച മക്കളെ അവയ്ക്കു ഭോജനമായി അഗ്നിപ്രവേശം ചെയ്യിച്ചു. <verse eid="EZK 23:37" /><verse number="38" style="v" sid="EZK 23:38" />ഒന്നുകൂടെ അവർ എന്നോട് ചെയ്തിരിക്കുന്നു: അന്നു തന്നെ അവർ എന്‍റെ വിശുദ്ധമന്ദിരത്തെ മലിനമാക്കി, എന്‍റെ ശബ്ബത്തുകളെ അശുദ്ധമാക്കി. <verse eid="EZK 23:38" /><verse number="39" style="v" sid="EZK 23:39" />അവർ അവരുടെ മക്കളെ വിഗ്രഹങ്ങൾക്ക് വേണ്ടി കൊന്ന ശേഷം അന്നുതന്നെ അവർ എന്‍റെ വിശുദ്ധമന്ദിരത്തെ അശുദ്ധമാക്കേണ്ടതിന് അതിലേക്ക് വന്നു; ഇങ്ങനെയാകുന്നു അവർ എന്‍റെ ആലയത്തിന്‍റെ മദ്ധ്യത്തിൽ ചെയ്തത്.<verse eid="EZK 23:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="EZK 23:40" />ഇതുകൂടാതെ, ദൂരത്തുനിന്ന് വന്ന പുരുഷന്മാർക്ക് അവർ ആളയച്ച്; ഒരു ദൂതൻ അവരുടെ അടുക്കൽ ചെന്നയുടൻ അവർ വന്നു; അവർക്ക് വേണ്ടി നീ കുളിച്ച്, കണ്ണിൽ മഷി എഴുതി, ആഭരണം അണിഞ്ഞ്, <verse eid="EZK 23:40" /><verse number="41" style="v" sid="EZK 23:41" />ഭംഗിയുള്ള ഒരു കട്ടിലിന്മേൽ ഇരുന്നു, അതിന്‍റെ മുമ്പിൽ ഒരു മേശ ഒരുക്കി, അതിന്മേൽ എന്‍റെ കുന്തുരുക്കവും എണ്ണയും വച്ചു. <verse eid="EZK 23:41" /><verse number="42" style="v" sid="EZK 23:42" />നിർഭയമായിരിക്കുന്ന ഒരു പുരുഷാരത്തിന്‍റെ ഘോഷം അവളോടുകൂടി ഉണ്ടായിരുന്നു; ജനസമൂഹത്തിലെ പുരുഷന്മാരുടെ അടുക്കൽ അവർ ആളയച്ച്, മരുഭൂമിയിൽനിന്നു മദ്യപന്മാരെ വരുത്തി; അവർ അവരുടെ കൈകളിൽ വളയിടുകയും തലയിൽ ഭംഗിയുള്ള കിരീടങ്ങൾ വയ്ക്കുകയും ചെയ്തു.”<verse eid="EZK 23:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="EZK 23:43" />അപ്പോൾ വ്യഭിചാരവൃത്തികൊണ്ട് വൃദ്ധയായവളെക്കുറിച്ച് ഞാൻ: “ഇപ്പോൾ അവർ അവളോടും അവൾ അവരോടും പരസംഗം ചെയ്യുമോ?” എന്നു പറഞ്ഞു. <verse eid="EZK 23:43" /><verse number="44" style="v" sid="EZK 23:44" />അങ്ങനെ വേശ്യയുടെ അടുക്കൽ ചെല്ലുന്നതുപോലെ അവർ അവളുടെ അടുക്കൽ ചെന്നു; അതെ അവർ കാമുകികളായ ഒഹൊലയുടെ അടുക്കലും ഒഹൊലീബയുടെ അടുക്കലും ചെന്നു. <verse eid="EZK 23:44" /><verse number="45" style="v" sid="EZK 23:45" />എന്നാൽ നീതിമാന്മാരായ പുരുഷന്മാർ, വ്യഭിചാരിണികൾക്കും രക്തപാതകികൾക്കും തക്ക ന്യായപ്രകാരം അവരെ ന്യായംവിധിക്കും; അവർ വ്യഭിചാരിണികളല്ലയോ; അവരുടെ കയ്യിൽ രക്തവും ഉണ്ട്.<verse eid="EZK 23:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="EZK 23:46" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഞാൻ അവരുടെ നേരെ ഒരു സഭ കൂട്ടി അവരെ പരിഭ്രമത്തിനും കവർച്ചയ്ക്കും ഏല്പിക്കും. <verse eid="EZK 23:46" /><verse number="47" style="v" sid="EZK 23:47" />ആ സഭ അവരെ കല്ലെറിഞ്ഞ് വാൾകൊണ്ടു വെട്ടിക്കളയും; അവരുടെ പുത്രന്മാരെയും പുത്രിമാരെയും അവർ കൊന്ന് അവരുടെ വീടുകൾ തീവച്ച് ചുട്ടുകളയും. <verse eid="EZK 23:47" /><verse number="48" style="v" sid="EZK 23:48" />ഇങ്ങനെ നിങ്ങളുടെ ദുർന്നടപ്പുപോലെ ചെയ്യാതിരിക്കുവാൻ സകലസ്ത്രീകളും ഒരു പാഠം പഠിക്കേണ്ടതിന് ഞാൻ ദുർന്നടപ്പ് ദേശത്തുനിന്ന് നീക്കിക്കളയും. <verse eid="EZK 23:48" /><verse number="49" style="v" sid="EZK 23:49" />അങ്ങനെ അവർ നിങ്ങളുടെ ദുർന്നടപ്പിനു തക്കവണ്ണം നിങ്ങൾക്ക് പകരം ചെയ്യും; നിങ്ങൾ നിങ്ങളുടെ വിഗ്രഹങ്ങളുടെ പാപങ്ങളെ ചുമക്കേണ്ടിവരും; ഞാൻ യഹോവയായ കർത്താവ് എന്നു നിങ്ങൾ അറിയും.”<verse eid="EZK 23:49" /></para>
  <chapter eid="EZK 23" />
  <chapter number="24" style="c" sid="EZK 24" />
  <para style="s">തിളയ്ക്കുന്ന കുട്ടകം</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 24:1" />ബാബിലോന്യ പ്രവാസത്തിന്‍റെ ഒമ്പതാം ആണ്ട് പത്താം മാസം, പത്താം തീയതി യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായത് എന്തെന്നാൽ: <verse eid="EZK 24:1" /><verse number="2" style="v" sid="EZK 24:2" />“മനുഷ്യപുത്രാ, ഈ തീയതി ഇന്നത്തെ തീയതി തന്നെ, എഴുതിവയ്ക്കുക; ഇന്നുതന്നെ ബാബേൽരാജാവ് യെരൂശലേമിനെ ആക്രമിച്ചിരിക്കുന്നു. <verse eid="EZK 24:2" /><verse number="3" style="v" sid="EZK 24:3" />നീ മത്സരഗൃഹത്തോട് ഒരു ഉപമ പ്രസ്താവിച്ചു പറയേണ്ടത്: ‘യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: നീ ഒരു കുട്ടകം അടുപ്പത്തു വച്ചു അതിൽ വെള്ളം ഒഴിക്കുക. <verse eid="EZK 24:3" /><verse number="4" style="v" sid="EZK 24:4" />മാംസക്കഷണങ്ങൾ, തുട, കൈക്കുറക് മുതലായ നല്ല കഷണങ്ങളെല്ലാം തന്നെ എടുത്ത് അതിൽ ഇടുക; ഉത്തമമായ അസ്ഥിക്കഷണങ്ങൾകൊണ്ട് അത് നിറയ്ക്കുക. <verse eid="EZK 24:4" /><verse number="5" style="v" sid="EZK 24:5" />ആട്ടിൻകൂട്ടത്തിൽനിന്ന് വിശേഷമായതിനെ പിടിച്ചുകൊണ്ടുവന്ന്, അതിന്‍റെ കീഴിൽ വിറക് അടുക്കി അതിനെ നല്ലവണ്ണം പുഴുങ്ങുക; അതിന്‍റെ അസ്ഥികൾ അതിനകത്ത് കിടന്ന് വേകട്ടെ.”<verse eid="EZK 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 24:6" />അതുകൊണ്ട് യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “അകത്ത് ക്ലാവുള്ളതും ക്ലാവു വിട്ടുപോകാത്തതുമായ കുട്ടകത്തിന്, രക്തപാതകമുള്ള നഗരത്തിനു തന്നെ, അയ്യോ കഷ്ടം! അതിനെ കഷണംകഷണമായി പുറത്തെടുക്കുക; ചീട്ട് അതിന്മേൽ വീണിട്ടില്ല. <verse eid="EZK 24:6" /><verse number="7" style="v" sid="EZK 24:7" />അവൾ ചൊരിഞ്ഞിരിക്കുന്ന രക്തം അവളുടെ മദ്ധ്യത്തിൽ ഉണ്ട്; അവൾ അത് വെറും പാറമേലാകുന്നു ചൊരിഞ്ഞത്; മണ്ണുകൊണ്ടു മൂടത്തക്കവിധം അവൾ അത് നിലത്ത് ഒഴിച്ചില്ല. <verse eid="EZK 24:7" /><verse number="8" style="v" sid="EZK 24:8" />ക്രോധം വരുത്തേണ്ടതിനും പ്രതികാരം ചെയ്യേണ്ടതിനും ഞാൻ, അവൾ ചൊരിഞ്ഞ രക്തം മൂടിപ്പോകാതവണ്ണം അതിനെ വെറും പാറമേൽ തന്നെ നിർത്തിയിരിക്കുന്നു.”<verse eid="EZK 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 24:9" />അതുകൊണ്ട് യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “രക്തപാതകങ്ങളുടെ നഗരത്തിന് അയ്യോ കഷ്ടം! ഞാൻ വിറകുകൂമ്പാരം വലുതാക്കും. <verse eid="EZK 24:9" /><verse number="10" style="v" sid="EZK 24:10" />വിറകു കൂട്ടുക; തീ കത്തിക്കുക; മാംസം വേകട്ടെ; ചാറു കുറുകട്ടെ; അസ്ഥികൾ വെന്തുപോകട്ടെ. <verse eid="EZK 24:10" /><verse number="11" style="v" sid="EZK 24:11" />അതിന്‍റെ താമ്രം കാഞ്ഞു വെന്തുപോകേണ്ടതിനും, അതിന്‍റെ കറ അതിൽ ഉരുകി അതിന്‍റെ ക്ലാവു ഇല്ലാതെയാകേണ്ടതിനും അതിലെ വസ്തുക്കൾ നീക്കം ചെയ്തു, അത് കനലിന്മേൽ വെക്കുക. <verse eid="EZK 24:11" /><verse number="12" style="v" sid="EZK 24:12" />അവൾ അദ്ധ്വാനംകൊണ്ടു തളർന്നുപോയി; അവളുടെ കനത്ത ക്ലാവ് അവളെ വിട്ടുപോകുന്നില്ല. അവളുടെ ക്ലാവ് തീയിലും വിട്ടുപോകുന്നില്ല. <verse eid="EZK 24:12" /><verse number="13" style="v" sid="EZK 24:13" />നിന്‍റെ മലിനമായ ദുർന്നടപ്പുനിമിത്തം ഞാൻ നിന്നെ ശുദ്ധീകരിച്ചിട്ടും നീ ശുദ്ധമാകാത്തതിനാൽ, ഞാൻ എന്‍റെ ക്രോധം നിന്‍റെമേൽ തീർക്കുവോളം ഇനി നിന്‍റെ മലിനത നീങ്ങി നീ ശുദ്ധയായിത്തീരുകയില്ല.<verse eid="EZK 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 24:14" />“യഹോവയായ ഞാൻ അത് അരുളിച്ചെയ്തിരിക്കുന്നു; അത് സംഭവിക്കും; ഞാൻ അത് അനുഷ്ഠിക്കും; ഞാൻ പിന്മാറുകയില്ല, ആദരിക്കുകയില്ല, സഹതപിക്കുകയുമില്ല, നിന്‍റെ നടപ്പിനും ക്രിയകൾക്കും തക്കവിധം അവർ നിന്നെ ന്യായംവിധിക്കും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 24:14" /></para>
  <para style="s">യെഹെസ്കേലിൻ്റെ ഭാര്യയുടെ മരണം</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 24:15" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ: <verse eid="EZK 24:15" /><verse number="16" style="v" sid="EZK 24:16" />“മനുഷ്യപുത്രാ, ഞാൻ നിന്‍റെ കണ്ണിന്‍റെ ആനന്ദമായവളെ ഒറ്റ അടിയാൽ തന്നെ നിന്നിൽനിന്ന് എടുത്തുകളയും; നീ വിലപിക്കുകയോ കരയുകയോ കണ്ണുനീർ വാർക്കുകയോ ചെയ്യരുത്. <verse eid="EZK 24:16" /><verse number="17" style="v" sid="EZK 24:17" />നീ മൗനമായി നെടുവീർപ്പിട്ടുകൊള്ളുക; മരിച്ചവൾക്കുവേണ്ടി വിലാപം കഴിക്കരുത്; തലയ്ക്കു തലപ്പാവു കെട്ടി കാലിന് ചെരിപ്പിടുക; അധരം മൂടരുത്; മറ്റുള്ളവർ കൊടുത്തയയ്ക്കുന്ന അപ്പം തിന്നുകയും അരുത്.” <verse eid="EZK 24:17" /><verse number="18" style="v" sid="EZK 24:18" />അങ്ങനെ ഞാൻ രാവിലെ ജനത്തോടു സംസാരിച്ചു; വൈകുന്നേരത്ത് എന്‍റെ ഭാര്യ മരിച്ചു; എന്നോട് കല്പിച്ചതുപോലെ ഞാൻ പിറ്റെ ദിവസം രാവിലെ ചെയ്തു. <verse eid="EZK 24:18" /><verse number="19" style="v" sid="EZK 24:19" />അപ്പോൾ ജനം എന്നോട്: “നീ ഈ ചെയ്യുന്നതിൻ്റെ അർത്ഥം എന്ത്? ഞങ്ങൾക്കു പറഞ്ഞുതരുകയില്ലയോ” എന്നു ചോദിച്ചു.<verse eid="EZK 24:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 24:20" />അതിന് ഞാൻ അവരോട് ഉത്തരം പറഞ്ഞത്: “യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായത് എന്തെന്നാൽ: <verse eid="EZK 24:20" /><verse number="21" style="v" sid="EZK 24:21" />നീ യിസ്രായേൽ ഗൃഹത്തോട് പറയേണ്ടത്: യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: നിങ്ങൾ ഗർവ്വത്തോടെ അഭിമാനിക്കുന്നതും നിങ്ങളുടെ കണ്ണിന്‍റെ ആനന്ദവും നിങ്ങളുടെ ഹൃദയത്തിന്‍റെ വാഞ്ഛയും ആയിരിക്കുന്ന എന്‍റെ വിശുദ്ധമന്ദിരത്തെ ഞാൻ അശുദ്ധമാക്കും; നിങ്ങൾ വിട്ടിട്ടുപോകുന്ന നിങ്ങളുടെ പുത്രന്മാരും പുത്രിമാരും വാൾകൊണ്ടു വീഴും. <verse eid="EZK 24:21" /><verse number="22" style="v" sid="EZK 24:22" />ഞാൻ ചെയ്തതുപോലെ നിങ്ങളും അന്നു ചെയ്യും; നിങ്ങൾ അധരം മൂടാതെയും മറ്റുള്ളവർ കൊടുത്തയയ്ക്കുന്ന അപ്പം തിന്നാതെയും ഇരിക്കും. <verse eid="EZK 24:22" /><verse number="23" style="v" sid="EZK 24:23" />നിങ്ങളുടെ തലപ്പാവു തലയിലും ചെരിപ്പ് കാലിലും ഇരിക്കും; നിങ്ങൾ വിലപിക്കുകയോ കരയുകയോ ചെയ്യാതെ നിങ്ങളുടെ അകൃത്യങ്ങളിൽ തന്നെ ക്ഷയിച്ച്, തമ്മിൽതമ്മിൽ നോക്കി ഞരങ്ങും. <verse eid="EZK 24:23" /><verse number="24" style="v" sid="EZK 24:24" />ഇങ്ങനെ യെഹെസ്കേൽ നിങ്ങൾക്ക് ഒരടയാളം ആയിരിക്കും; അവൻ ചെയ്തതുപോലെ എല്ലാം നിങ്ങളും ചെയ്യും; അത് സംഭവിക്കുമ്പോൾ ഞാൻ യഹോവയായ കർത്താവ് എന്നു നിങ്ങൾ അറിയും.”<verse eid="EZK 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 24:25" />“മനുഷ്യപുത്രാ, അവരുടെ ശരണവും അവരുടെ മഹത്ത്വമുള്ള സന്തോഷവും അവരുടെ കണ്ണിന്‍റെ ആനന്ദവും അവരുടെ ഹൃദയവാഞ്ഛയും ആയിരിക്കുന്നതിനെയും അവരുടെ പുത്രന്മാരെയും പുത്രിമാരെയും ഞാൻ അവരിൽനിന്ന് എടുത്തുകളയുന്ന നാളിൽ, <verse eid="EZK 24:25" /><verse number="26" style="v" sid="EZK 24:26" />ആ നാളിൽ തന്നെ, രക്ഷപെട്ടുപോകുന്ന ഒരുത്തൻ നിന്‍റെ അടുക്കൽവന്ന് വസ്തുത നിന്നെ പറഞ്ഞു കേൾപ്പിക്കും; <verse eid="EZK 24:26" /><verse number="27" style="v" sid="EZK 24:27" />രക്ഷപെട്ടുപോകുന്നവനോടു സംസാരിക്കുവാൻ അന്നു നിന്‍റെ വായ് തുറക്കും; നീ ഇനി മൗനമായിരിക്കാതെ സംസാരിക്കും; അങ്ങനെ നീ അവർക്ക് ഒരു അടയാളമായിരിക്കും; ഞാൻ യഹോവ എന്നു അവർ അറിയും.”<verse eid="EZK 24:27" /></para>
  <chapter eid="EZK 24" />
  <chapter number="25" style="c" sid="EZK 25" />
  <para style="s">അമ്മോന്യർക്കെതിരായുള്ള പ്രവചനം</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 25:1" />“യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായത് എന്തെന്നാൽ: <verse eid="EZK 25:1" /><verse number="2" style="v" sid="EZK 25:2" />മനുഷ്യപുത്രാ, നീ അമ്മോന്യരുടെ നേരെ മുഖംതിരിച്ച് അവരെക്കുറിച്ചു പ്രവചിച്ച് അവരോടു പറയേണ്ടത്: <verse eid="EZK 25:2" /><verse number="3" style="v" sid="EZK 25:3" />“യഹോവയായ കർത്താവിന്‍റെ വചനം കേൾക്കുവിൻ; യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: ‘എന്‍റെ വിശുദ്ധമന്ദിരം അശുദ്ധമായിത്തീർന്നപ്പോൾ നീ അതിനെയും, യിസ്രായേൽദേശം ശൂന്യമായിത്തീർന്നപ്പോൾ അതിനെയും, യെഹൂദാഗൃഹം പ്രവാസത്തിലേക്കു പോയപ്പോൾ അവരെയും ചൊല്ലി ‘നന്നായി’ എന്നു പറഞ്ഞതുകൊണ്ട് <verse eid="EZK 25:3" /><verse number="4" style="v" sid="EZK 25:4" />ഞാൻ നിന്നെ കിഴക്കുള്ളവർക്ക് കൈവശമാക്കിക്കൊടുക്കും; അവർ നിന്നിൽ പാളയമടിച്ച്, നിവാസങ്ങളെ ഉണ്ടാക്കും; അവർ നിന്‍റെ ഫലം തിന്നുകയും നിന്‍റെ പാല് കുടിക്കുകയും ചെയ്യും. <verse eid="EZK 25:4" /><verse number="5" style="v" sid="EZK 25:5" />ഞാൻ രബ്ബായെ ഒട്ടകങ്ങൾക്ക് മേച്ചിൽസ്ഥലവും അമ്മോനിനെ ആട്ടിൻകൂട്ടങ്ങൾക്കു താവളവും ആക്കും; ഞാൻ യഹോവ എന്നു നിങ്ങൾ അറിയും.”<verse eid="EZK 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 25:6" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “യിസ്രായേൽ ദേശത്തെക്കുറിച്ചു നീ കൈകൊട്ടി കാലുകൊണ്ടു ചവിട്ടി സർവ്വനിന്ദയോടുംകൂടി ഹൃദയപൂർവ്വം സന്തോഷിച്ചതുകൊണ്ട്, <verse eid="EZK 25:6" /><verse number="7" style="v" sid="EZK 25:7" />ഞാൻ നിന്‍റെനേരെ കൈ നീട്ടി നിന്നെ ജനതകൾക്കു കവർച്ചയായി കൊടുക്കും; ഞാൻ നിന്നെ വംശങ്ങളിൽനിന്നു ഛേദിച്ച് ദേശങ്ങളിൽ നിന്നു മുടിച്ച് നശിപ്പിച്ചുകളയും; ഞാൻ യഹോവ എന്നു നീ അറിയും.”<verse eid="EZK 25:7" /></para>
  <para style="s">മോവാബ്യർക്കെതിരായുള്ള പ്രവചനം</para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 25:8" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “യെഹൂദാഗൃഹം സകല ജനതകളെയുംപോലെ തന്നെ’ എന്നു മോവാബും സേയീരും പറയുന്നതുകൊണ്ട്, <verse eid="EZK 25:8" /><verse number="9" style="v" sid="EZK 25:9" />ഞാൻ മോവാബിന്‍റെ പാർശ്വത്തെ അതിന്‍റെ അതിർത്തികളിലുള്ള പട്ടണങ്ങളായി ദേശത്തിന്‍റെ മഹത്ത്വമായ ബേത്ത്-യെശീമോത്ത്, ബാൽ-മെയോൻ, കിര്യഥയീം എന്നീ പട്ടണങ്ങൾമുതൽ തുറന്നുവച്ചു <verse eid="EZK 25:9" /><verse number="10" style="v" sid="EZK 25:10" />അവയെ അമ്മോന്യർ ജനതകളുടെ ഇടയിൽ ഓർക്കപ്പെടാത്തവിധം ആയിരിക്കേണ്ടതിന് അമ്മോന്യരോടുകൂടി കിഴക്കുള്ളവർക്ക് കൈവശമാക്കിക്കൊടുക്കും. <verse eid="EZK 25:10" /><verse number="11" style="v" sid="EZK 25:11" />ഇങ്ങനെ ഞാൻ മോവാബിൽ ന്യായവിധി നടത്തും; ഞാൻ യഹോവ എന്നു അവർ അറിയും.”<verse eid="EZK 25:11" /></para>
  <para style="s">ഏദോമ്യർക്കെതിരായുള്ള പ്രവചനം</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 25:12" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഏദോം യെഹൂദാഗൃഹത്തോടു പ്രതികാരം ചെയ്തു ഏറ്റവുമധികം കുറ്റക്കാരായിരിക്കുന്നു.” <verse eid="EZK 25:12" /><verse number="13" style="v" sid="EZK 25:13" />അതുകൊണ്ട് യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു; “ഞാൻ ഏദോമിൻ്റെ നേരെ കൈ നീട്ടി അതിൽനിന്ന് മനുഷ്യനെയും മൃഗത്തെയും ഛേദിച്ച് അതിനെ ശൂന്യമാക്കിക്കളയും; തേമാൻ മുതൽ ദേദാൻ വരെ അവർ വാളിനാൽ വീഴും. <verse eid="EZK 25:13" /><verse number="14" style="v" sid="EZK 25:14" />ഞാൻ എന്‍റെ ജനമായ യിസ്രായേൽമുഖാന്തരം ഏദോമിനോടു പ്രതികാരം നടത്തും; അവർ എന്‍റെ കോപത്തിനും എന്‍റെ ക്രോധത്തിനും തക്കവിധം ഏദോമിനോടു ചെയ്യും; അപ്പോൾ അവർ എന്‍റെ പ്രതികാരം അറിയും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 25:14" /></para>
  <para style="s">ഫെലിസ്ത്യർക്കെതിരായുള്ള പ്രവചനം</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 25:15" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഫെലിസ്ത്യർ പ്രതികാരം ചെയ്തു പൂർവ്വദ്വേഷത്തോടും നാശം വരുത്തുവാൻ നിന്ദാഹൃദയത്തോടും കൂടെ പകരം വീട്ടിയിരിക്കുകകൊണ്ട് <verse eid="EZK 25:15" /><verse number="16" style="v" sid="EZK 25:16" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: ഞാൻ ഫെലിസ്ത്യരുടെ നേരെ കൈ നീട്ടി ക്രേത്യരെ സംഹരിച്ച് കടല്ക്കരയിൽ ശേഷിപ്പുള്ളവരെ നശിപ്പിച്ചുകളയും. <verse eid="EZK 25:16" /><verse number="17" style="v" sid="EZK 25:17" />ഞാൻ ക്രോധശിക്ഷകളോടു കൂടെ അവരോട് മഹാപ്രതികാരം നടത്തും; ഞാൻ പ്രതികാരം നടത്തുമ്പോൾ, ഞാൻ യഹോവ എന്നു അവർ അറിയും.”<verse eid="EZK 25:17" /></para>
  <chapter eid="EZK 25" />
  <chapter number="26" style="c" sid="EZK 26" />
  <para style="s">സോരിനെതിരേയുള്ള പ്രവചനം</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 26:1" />ബാബിലോന്യ പ്രവാസത്തിന്‍റെ പതിനൊന്നാം ആണ്ട് ഒന്നാം തീയതി യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായത് എന്തെന്നാൽ: <verse eid="EZK 26:1" /><verse number="2" style="v" sid="EZK 26:2" />“മനുഷ്യപുത്രാ, യെരൂശലേമിനെക്കുറിച്ച്: ‘നന്നായി, ജനതകളുടെ വാതിലായിരുന്നവൾ തകർന്നുപോയി; അവൾ എന്നിലേക്കു തിരിഞ്ഞിരിക്കുന്നു; അവൾ ശൂന്യമായിത്തീർന്നിരിക്കുകയാൽ ഞാൻ നിറയും’ എന്നു സോർ പറയുന്നു.<verse eid="EZK 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 26:3" />അതുകൊണ്ട് യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: സോരേ, ഞാൻ നിനക്കു വിരോധമായിരിക്കുന്നു; സമുദ്രം തന്‍റെ തിരകളെ കയറിവരുമാറാക്കുന്നതുപോലെ ഞാൻ അനേകം ജനതകളെ നിന്‍റെനേരെ പുറപ്പെട്ടുവരുമാറാക്കും. <verse eid="EZK 26:3" /><verse number="4" style="v" sid="EZK 26:4" />അവർ സോരിന്‍റെ മതിലുകൾ നശിപ്പിച്ച്, അതിന്‍റെ ഗോപുരങ്ങളെ ഇടിച്ചുകളയും; ഞാൻ അതിന്‍റെ പൊടി അടിച്ചുവാരിക്കളഞ്ഞ് അതിനെ വെറും പാറയാക്കും. <verse eid="EZK 26:4" /><verse number="5" style="v" sid="EZK 26:5" />അത് സമുദ്രത്തിന്‍റെ നടുവിൽ വലവിരിക്കുന്നതിനുള്ള സ്ഥലമായിത്തീരും; ഞാൻ അത് അരുളിച്ചെയ്തിരിക്കുന്നു” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്; “അത് ജനതകൾക്കു കവർച്ചയായിത്തീരും. <verse eid="EZK 26:5" /><verse number="6" style="v" sid="EZK 26:6" />നാട്ടിൻപുറത്തുള്ള അതിന്‍റെ പുത്രിമാർ വാളാൽ കൊല്ലപ്പെടും; ഞാൻ യഹോവ എന്നു അവർ അറിയും.”<verse eid="EZK 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 26:7" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഞാൻ വടക്കുനിന്ന് രാജാധിരാജാവായ നെബൂഖദ്നേസർ എന്ന ബാബേൽരാജാവിനെ കുതിരകളോടും രഥങ്ങളോടും കുതിരച്ചേവകരോടും ജനസമൂഹത്തോടും വളരെ പടജ്ജനത്തോടും കൂടി സോരിനുനേരെ വരുത്തും. <verse eid="EZK 26:7" /><verse number="8" style="v" sid="EZK 26:8" />അവൻ നാട്ടിൻപുറത്തുള്ള നിന്‍റെ പുത്രിമാരെ വാൾകൊണ്ടു കൊല്ലും; അവൻ നിന്‍റെനേരെ ഉപരോധമതിലുകൾ പണിത്, മൺകൂനകൾ ഉയർത്തും, പരിചകള്‍കൊണ്ട് മറ ഉയര്‍ത്തും. <verse eid="EZK 26:8" /><verse number="9" style="v" sid="EZK 26:9" />അവൻ നിന്‍റെ മതിലുകളുടെ നേരെ യന്ത്രമുട്ടികൾ വച്ചു കോടാലികൊണ്ടു നിന്‍റെ ഗോപുരങ്ങൾ തകർത്തുകളയും. <verse eid="EZK 26:9" /><verse number="10" style="v" sid="EZK 26:10" />അവന്‍റെ കുതിരകളുടെ പെരുപ്പംകൊണ്ട് ഉയരുന്ന പൊടി നിന്നെ മൂടും; മതിൽ ഇടിഞ്ഞുകിടക്കുന്ന പട്ടണത്തിലേക്ക് കടക്കുന്നതുപോലെ അവൻ നിന്‍റെ ഗോപുരങ്ങളിൽകൂടി കടക്കുമ്പോൾ കുതിരച്ചേവകരുടെയും ചക്രങ്ങളുടെയും രഥങ്ങളുടെയും മുഴക്കംകൊണ്ട് നിന്‍റെ മതിലുകൾ കുലുങ്ങിപ്പോകും. <verse eid="EZK 26:10" /><verse number="11" style="v" sid="EZK 26:11" />തന്‍റെ കുതിരകളുടെ കുളമ്പുകൊണ്ട് അവൻ നിന്‍റെ സകലവീഥികളെയും മെതിച്ചുകളയും; നിന്‍റെ ജനത്തെ അവൻ വാൾകൊണ്ടു കൊല്ലും; നിന്‍റെ ബലമുള്ള തൂണുകൾ നിലത്തു വീണുകിടക്കും.<verse eid="EZK 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 26:12" />അവർ നിന്‍റെ സമ്പത്ത് കവർന്ന് നിന്‍റെ ചരക്കു കൊള്ളയിട്ട് നിന്‍റെ മതിലുകൾ ഇടിച്ച് നിന്‍റെ മനോഹരഭവനങ്ങൾ നശിപ്പിക്കും; നിന്‍റെ കല്ലും മരവും മണ്ണും എല്ലാം അവർ വെള്ളത്തിൽ ഇട്ടുകളയും. <verse eid="EZK 26:12" /><verse number="13" style="v" sid="EZK 26:13" />നിന്‍റെ സംഗീതഘോഷം ഞാൻ ഇല്ലാതെയാക്കും; നിന്‍റെ വീണകളുടെ നാദം ഇനി കേൾക്കുകയുമില്ല. <verse eid="EZK 26:13" /><verse number="14" style="v" sid="EZK 26:14" />ഞാൻ നിന്നെ വെറും പാറയാക്കും; നീ വലവിരിക്കുവാനുള്ള സ്ഥലമായിത്തീരും; നിന്നെ ഇനി പണിയുകയില്ല; യഹോവയായ ഞാൻ അത് കല്പിച്ചിരിക്കുന്നു” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 26:15" />യഹോവയായ കർത്താവ് സോരിനോട് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “നിഹതന്മാർ ഞരങ്ങുമ്പോഴും നിന്‍റെ മദ്ധ്യത്തിൽ സംഹാരം നടക്കുമ്പോഴും നിന്‍റെ വീഴ്ചയുടെ ശബ്ദത്താൽ ദ്വീപുകൾ നടുങ്ങിപ്പോകുകയില്ലയോ? <verse eid="EZK 26:15" /><verse number="16" style="v" sid="EZK 26:16" />അപ്പോൾ സമുദ്രത്തിലെ സകലപ്രഭുക്കന്മാരും സിംഹാസനം വിട്ടിറങ്ങി, അങ്കികൾ നീക്കി വിചിത്രവസ്ത്രങ്ങൾ അഴിച്ചുവയ്ക്കും; അവർ വിറയൽപൂണ്ട് നിലത്തിരുന്ന് നിമിഷംതോറും വിറച്ചുകൊണ്ട് നിന്നെക്കുറിച്ച് സ്തംഭിച്ചുപോകും. <verse eid="EZK 26:16" /><verse number="17" style="v" sid="EZK 26:17" />അവർ നിന്നെച്ചൊല്ലി ഒരു വിലാപം തുടങ്ങി നിന്നെക്കുറിച്ച് പറയും:</para>
  <para style="q1" vid="EZK 26:17">‘സമുദ്രസഞ്ചാരികൾ വസിച്ചതും കീർത്തികേട്ടതുമായ പട്ടണമേ,</para>
  <para style="q2" vid="EZK 26:17">നീ എങ്ങനെ നശിച്ചിരിക്കുന്നു;</para>
  <para style="q1" vid="EZK 26:17">നീയും നിന്‍റെ നിവാസികളും സമുദ്രത്തിൽ പ്രാബല്യം പ്രാപിച്ചിരുന്നു;</para>
  <para style="q2" vid="EZK 26:17">അതിലെ സകലനിവാസികൾക്കും നിങ്ങളെ പേടി ആയിരുന്നുവല്ലോ!<verse eid="EZK 26:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="EZK 26:18" />ഇപ്പോൾ നിന്‍റെ വീഴ്ചയുടെ നാളിൽ ദ്വീപുകൾ വിറയ്ക്കും;</para>
  <para style="q2" vid="EZK 26:18">അതെ, സമുദ്രത്തിലെ ദ്വീപുകൾ നിന്‍റെ തകർച്ചയിൽ ഭ്രമിച്ചുപോകും.”<verse eid="EZK 26:18" /></para>
  <para style="b" />
  <para style="pi">
    <verse number="19" style="v" sid="EZK 26:19" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഞാൻ നിന്നെ നിവാസികൾ ഇല്ലാത്ത പട്ടണങ്ങളെപ്പോലെ ശൂന്യപട്ടണം ആക്കുമ്പോഴും ഞാൻ നിന്‍റെമേൽ ആഴിയെ വരുത്തി പെരുവെള്ളം നിന്നെ മൂടുമ്പോഴും, <verse eid="EZK 26:19" /><verse number="20" style="v" sid="EZK 26:20" />ഞാൻ നിന്നെ കുഴിയിൽ ഇറങ്ങുന്നവരോടുകൂടെ പുരാതനജനത്തിന്‍റെ അടുക്കൽ ഇറക്കുകയും നിനക്കു നിവാസികൾ ഇല്ലാതെയിരിക്കേണ്ടതിനും നീ ജീവനുള്ളവരുടെ ദേശത്തു നിലനില്‍ക്കാതെയിരിക്കേണ്ടതിനും ഞാൻ നിന്നെ ഭൂമിയുടെ അധോഭാഗങ്ങളിൽ, പുരാതനശൂന്യങ്ങളിൽ തന്നെ, കുഴിയിൽ ഇറങ്ങുന്നവരോടുകൂടി താമസിപ്പിക്കുകയും ചെയ്യും. <verse eid="EZK 26:20" /><verse number="21" style="v" sid="EZK 26:21" />ഞാൻ നിനക്കു ഭീതിജനകമായ അവസാനം വരുത്തും; നീ ഇല്ലാതെയാകും; നിന്നെ അന്വേഷിച്ചാലും ഇനി ഒരിക്കലും നിന്നെ കണ്ടെത്തുകയില്ല” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 26:21" /></para>
  <chapter eid="EZK 26" />
  <chapter number="27" style="c" sid="EZK 27" />
  <para style="s">സോരിനെക്കുറിച്ച് ഒരു വിലാപഗീതം</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 27:1" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായത് എന്തെന്നാൽ: <verse eid="EZK 27:1" /><verse number="2" style="v" sid="EZK 27:2" />“മനുഷ്യപുത്രാ, നീ സോരിനെക്കുറിച്ച് ഒരു വിലാപം തുടങ്ങി സോരിനോടു പറയേണ്ടത്: <verse eid="EZK 27:2" /><verse number="3" style="v" sid="EZK 27:3" />‘തുറമുഖങ്ങളിൽ വസിക്കുന്നവളും ഏറിയ ദ്വീപുകളിലെ ജനതകളുടെ വ്യാപാരിയും ആയ സോരേ, യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:</para>
  <para style="q1" vid="EZK 27:3">“ഞാൻ പൂർണ്ണസുന്ദരിയാകുന്നു”</para>
  <para style="q2" vid="EZK 27:3">എന്നു നീ പറഞ്ഞിരിക്കുന്നു.<verse eid="EZK 27:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 27:4" />നിന്‍റെ രാജ്യം സമുദ്രമദ്ധ്യത്തിൽ ഇരിക്കുന്നു;</para>
  <para style="q2" vid="EZK 27:4">നിന്നെ നിർമ്മിച്ചവർ നിന്‍റെ സൗന്ദര്യത്തെ പരിപൂർണ്ണമാക്കിയിരിക്കുന്നു.<verse eid="EZK 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 27:5" />സെനീരിലെ സരളമരംകൊണ്ട്</para>
  <para style="q2" vid="EZK 27:5">അവർ നിന്‍റെ തട്ടുപലകകൾ പണിതു;</para>
  <para style="q1" vid="EZK 27:5">നിനക്കു പാമരം ഉണ്ടാക്കേണ്ടതിന്</para>
  <para style="q2" vid="EZK 27:5">അവർ ലെബാനോനിൽനിന്നു ദേവദാരു കൊണ്ടുവന്നു.<verse eid="EZK 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 27:6" />ബാശാനിലെ കരുവേലകംകൊണ്ട്</para>
  <para style="q2" vid="EZK 27:6">അവർ നിന്‍റെ തണ്ടുകൾ ഉണ്ടാക്കി;</para>
  <para style="q1" vid="EZK 27:6">കിത്തീംദ്വീപുകളിലെ പുന്നമരത്തിൽ ആനക്കൊമ്പു പതിച്ച്</para>
  <para style="q2" vid="EZK 27:6">നിനക്കു തട്ടുണ്ടാക്കിയിരിക്കുന്നു.<verse eid="EZK 27:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 27:7" />നിനക്കു കൊടി ആയിരിക്കേണ്ടതിന്</para>
  <para style="q2" vid="EZK 27:7">നിന്‍റെ കപ്പൽപായ് മിസ്രയീമിൽ നിന്നുള്ള</para>
  <para style="q1" vid="EZK 27:7">വിചിത്രശണവസ്ത്രംകൊണ്ട് ഉണ്ടാക്കിയതായിരുന്നു;</para>
  <para style="q2" vid="EZK 27:7">എലീശാദ്വീപുകളിലെ ധൂമ്രപടവും</para>
  <para style="q2" vid="EZK 27:7">രക്താംബരവും നിന്‍റെ വിതാനമായിരുന്നു.<verse eid="EZK 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 27:8" />സീദോനിലെയും അർവ്വാദിലെയും നിവാസികൾ</para>
  <para style="q2" vid="EZK 27:8">നിന്‍റെ തണ്ടുവലിക്കാരായിരുന്നു;</para>
  <para style="q1" vid="EZK 27:8">സോരേ, നിന്നിൽ ഉണ്ടായിരുന്ന ജ്ഞാനികൾ</para>
  <para style="q2" vid="EZK 27:8">നിന്‍റെ കപ്പിത്താന്മാർ ആയിരുന്നു.<verse eid="EZK 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 27:9" />ഗെബലിലെ മൂപ്പന്മാരും അതിലെ ജ്ഞാനികളും</para>
  <para style="q2" vid="EZK 27:9">നിന്‍റെ <note caller="+" style="f"><char style="fr" closed="false">27:9 </char><char style="ft" closed="false">വിടവുകൾ അടക്കുന്നവരായിരുന്നു</char></note>ഓരായപ്പണിക്കാരായിരുന്നു;</para>
  <para style="q1" vid="EZK 27:9">നിന്‍റെ കച്ചവടം നടത്തേണ്ടതിന് സമുദ്രത്തിലെ എല്ലാ കപ്പലുകളും</para>
  <para style="q2" vid="EZK 27:9">അവയുടെ കപ്പല്ക്കാരും നിന്നിൽ ഉണ്ടായിരുന്നു.<verse eid="EZK 27:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="EZK 27:10" />പാർസികളും ലൂദ്യരും പൂത്യരും യോദ്ധാക്കളായി നിന്‍റെ സൈന്യത്തിൽ ഉണ്ടായിരുന്നു; അവർ പരിചയും ശിരസ്ത്രങ്ങളും നിന്നിൽ തൂക്കി നിനക്കു ഭംഗിപിടിപ്പിച്ചു. <verse eid="EZK 27:10" /><verse number="11" style="v" sid="EZK 27:11" />അർവ്വാദ്യർ നിന്‍റെ സൈന്യത്തോടുകൂടെ ചുറ്റും നിന്‍റെ മതിലുകളിന്മേലും ഗമ്മാദ്യർ നിന്‍റെ ഗോപുരങ്ങളിലും ഉണ്ടായിരുന്നു; അവർ നിന്‍റെ മതിലുകളിന്മേൽ ചുറ്റും പരിച തൂക്കി നിന്‍റെ സൗന്ദര്യത്തെ പരിപൂർണ്ണമാക്കി.<verse eid="EZK 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 27:12" />തർശ്ശീശ് സകലവിധസമ്പത്തിൻ്റെയും പെരുപ്പംനിമിത്തം നിന്‍റെ വ്യാപാരിയായിരുന്നു; വെള്ളി, ഇരിമ്പ്, വെള്ളീയം, കാരീയം എന്നിവ അവർ നിന്‍റെ ചരക്കിനു പകരം തന്നു. <verse eid="EZK 27:12" /><verse number="13" style="v" sid="EZK 27:13" />യാവാൻ, തൂബാൽ, മേശെക്ക് എന്നിവർ നിന്‍റെ വ്യാപാരികൾ ആയിരുന്നു; അവർ ആളുകളെയും താമ്രസാധനങ്ങളെയും നിന്‍റെ ചരക്കിനു പകരം തന്നു.<verse eid="EZK 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 27:14" />തോഗർമ്മാഗൃഹക്കാർ നിന്‍റെ ചരക്കിനു പകരം കുതിരകളെയും പടക്കുതിരകളെയും കോവർകഴുതകളെയും തന്നു. <verse eid="EZK 27:14" /><verse number="15" style="v" sid="EZK 27:15" />ദെദാന്യർ നിന്‍റെ വ്യാപാരികളായിരുന്നു; അനേകം ദ്വീപുകൾ നിന്‍റെ അധീനത്തിലെ വ്യാപാരദേശങ്ങളായിരുന്നു; അവർ ആനക്കൊമ്പും കരിമരവും നിനക്കു കപ്പമായി കൊണ്ടുവന്നു.<verse eid="EZK 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 27:16" />നിന്‍റെ പണിത്തരങ്ങളുടെ പെരുപ്പംനിമിത്തം അരാം നിന്‍റെ വ്യാപാരി ആയിരുന്നു; അവർ മരതകവും ധൂമ്രവസ്ത്രവും വിചിത്രവസ്ത്രവും ശണവസ്ത്രവും പവിഴവും പത്മരാഗവും നിന്‍റെ ചരക്കിനു പകരം തന്നു. <verse eid="EZK 27:16" /><verse number="17" style="v" sid="EZK 27:17" />യെഹൂദയും യിസ്രായേൽ ദേശവും നിന്‍റെ വ്യാപാരികളായിരുന്നു; അവർ മിന്നീത്തിലെ ഗോതമ്പും പലഹാരവും തേനും എണ്ണയും പരിമളതൈലവും നിന്‍റെ ചരക്കിനു പകരം തന്നു. <verse eid="EZK 27:17" /><verse number="18" style="v" sid="EZK 27:18" />നിന്‍റെ പണിത്തരങ്ങളുടെയും സകലവിധസമ്പത്തിൻ്റെയും പെരുപ്പംനിമിത്തം, ദമാസ്കോസ് ഹെൽബോനിലെ വീഞ്ഞും വെളുത്ത ആട്ടുരോമവുംകൊണ്ട് നിന്നോട് വ്യാപാരം ചെയ്തു. <verse eid="EZK 27:18" /><verse number="19" style="v" sid="EZK 27:19" />വെദാന്യരും ഊസാലിലെ യാവാന്യരും നിന്‍റെ ചരക്കുകൊണ്ട് വ്യാപാരം ചെയ്തു; മിനുസമുള്ള ഇരിമ്പും വഴനത്തോലും വയമ്പും നിന്‍റെ ചരക്കിൻ്റെ കൂട്ടത്തിൽ ഉണ്ടായിരുന്നു.<verse eid="EZK 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 27:20" />കുതിരപ്പുറത്തിടുന്ന വിശിഷ്ടവസ്ത്രംകൊണ്ട് ദെദാൻ നിന്‍റെ വ്യാപാരിയായിരുന്നു; <verse eid="EZK 27:20" /><verse number="21" style="v" sid="EZK 27:21" />അരാബികളും കേദാർപ്രഭുക്കന്മാർ എല്ലാവരും നിനക്കധീനരായ വ്യാപാരികൾ ആയിരുന്നു; കുഞ്ഞാടുകൾ, ആട്ടുകൊറ്റന്മാർ, കോലാടുകൾ എന്നിവകൊണ്ട് അവർ നീയുമായി കച്ചവടം നടത്തി. <verse eid="EZK 27:21" /><verse number="22" style="v" sid="EZK 27:22" />ശെബയിലെയും രാമയിലെയും വ്യാപാരികൾ നിന്‍റെ കച്ചവടക്കാരായിരുന്നു; അവർ മേല്ത്തരമായ സകലവിധപരിമളതൈലവും സകലവിധരത്നങ്ങളും പൊന്നും നിന്‍റെ ചരക്കിനു പകരം തന്നു.<verse eid="EZK 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 27:23" />ഹാരാനും കല്നെയും ഏദേനും ശെബാവ്യാപാരികളും അശ്ശൂരും കില്മദും നിന്‍റെ കച്ചവടക്കാരായിരുന്നു. <verse eid="EZK 27:23" /><verse number="24" style="v" sid="EZK 27:24" />അവർ വിശിഷ്ടസാധനങ്ങളും ചിത്രത്തയ്യലുള്ള ധൂമ്രപ്പുതപ്പുകളും പരവതാനികളും ബലത്തിൽ പിരിച്ച കയറുകളും നിന്‍റെ ചരക്കിനു പകരം തന്നു. <verse eid="EZK 27:24" /><verse number="25" style="v" sid="EZK 27:25" />തർശ്ശീശ് കപ്പലുകൾ നിനക്കു ചരക്കു കൊണ്ടുവന്നു<note caller="+" style="f"><char style="fr" closed="false">27:25 </char><char style="fq" closed="false">തർശ്ശീശ് കപ്പലുകൾ നിനക്കു ചരക്കു കൊണ്ടുവന്നു </char><char style="ft" closed="false">തർശ്ശീശ് കപ്പലില്‍ ഉള്ളവര്‍ വ്യപാരസ്ഥലത്ത് നിന്നെ പുകഴ്ത്തി </char></note>; നീ പരിപൂർണ്ണയും സമുദ്രമദ്ധ്യത്തിൽ നിന്നെ തന്നെ സ്വയം പുകഴ്ത്തുകയും ചെയ്തു<note caller="+" style="f"><char style="fr" closed="false">27:25 </char><char style="fq" closed="false">നീ പരിപൂർണ്ണയും സമുദ്രമദ്ധ്യത്തിൽ നിന്നെ തന്നെ സ്വയം പുകഴ്ത്തുകയും ചെയ്തു </char><char style="ft" closed="false">നിന്‍റെ ചരക്ക് തർശ്ശീശ് കപ്പലുകളോടൊപ്പം യാത്ര ചെയ്യുകയും സമുദ്രമദ്ധ്യത്തിൽ വച്ചു അനവധി സമ്പത്തുകൊണ്ട് നിറയുകയും ചെയ്തു</char></note>.<verse eid="EZK 27:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="EZK 27:26" />നിന്‍റെ തണ്ടുവലിക്കാർ നിന്നെ പുറങ്കടലിലേക്ക് കൊണ്ടുപോയി;</para>
  <para style="q2" vid="EZK 27:26">എന്നാൽ കിഴക്കൻകാറ്റ് സമുദ്രമദ്ധ്യത്തിൽവച്ച് നിന്നെ ഉടച്ചുകളഞ്ഞു.<verse eid="EZK 27:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="EZK 27:27" />നിന്‍റെ സമ്പത്തും ചരക്കും കച്ചവടവും</para>
  <para style="q2" vid="EZK 27:27">കപ്പല്‍ക്കാരും കപ്പിത്താന്മാരും ഓരായപ്പണിക്കാരും വ്യാപാരികളും</para>
  <para style="q1" vid="EZK 27:27">നിന്നിലുള്ള സകലയോദ്ധാക്കളും</para>
  <para style="q2" vid="EZK 27:27">നിന്‍റെ അകത്തുള്ള സർവ്വജനസമൂഹത്തോടും കൂടെ</para>
  <para style="q2" vid="EZK 27:27">നിന്‍റെ വീഴ്ചയുടെ നാളിൽ സമുദ്രമദ്ധ്യത്തിൽ വീഴും.<verse eid="EZK 27:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="EZK 27:28" />നിന്‍റെ കപ്പിത്താന്മാരുടെ നിലവിളികൊണ്ട്</para>
  <para style="q2" vid="EZK 27:28">കപ്പൽകൂട്ടങ്ങൾ നടുങ്ങിപ്പോകും.<verse eid="EZK 27:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="EZK 27:29" />തണ്ടുവലിക്കാർ എല്ലാവരും കപ്പല്ക്കാരും</para>
  <para style="q2" vid="EZK 27:29">കടലിലെ കപ്പിത്താന്മാരും കപ്പലുകളിൽനിന്ന് ഇറങ്ങി കരയിൽ നില്ക്കും.<verse eid="EZK 27:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="EZK 27:30" />അവർ കൈപ്പോടെ ഉറക്കെ നിലവിളിച്ച്</para>
  <para style="q2" vid="EZK 27:30">തലയിൽ പൂഴി വാരിയിട്ട് ചാരത്തിൽ കിടന്നുരുളുകയും<verse eid="EZK 27:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="EZK 27:31" />നിന്നെച്ചൊല്ലി തല മുണ്ഡനം ചെയ്തു രട്ടുടുക്കുകയും</para>
  <para style="q2" vid="EZK 27:31">നിന്നെക്കുറിച്ച് മനോവ്യസനത്തോടും</para>
  <para style="q2" vid="EZK 27:31">കൈപ്പുള്ള വിലാപത്തോടുംകൂടി കരയുകയും ചെയ്യും.<verse eid="EZK 27:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="EZK 27:32" />അവരുടെ ദുഃഖത്തിൽ അവർ നിന്നെച്ചൊല്ലി ഒരു വിലാപം തുടങ്ങി, നിന്നെക്കുറിച്ച് വിലപിക്കുന്നത്:</para>
  <para style="q2" vid="EZK 27:32">സമുദ്രമദ്ധ്യത്തിൽ നശിച്ചുപോയ സോരിനെപ്പോലെ ഏതു നഗരമുള്ളു?’<verse eid="EZK 27:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="EZK 27:33" />നിന്‍റെ ചരക്ക് സമുദ്രത്തിൽനിന്നു കയറിവന്നപ്പോൾ,</para>
  <para style="q2" vid="EZK 27:33">നീ ഏറിയ വംശങ്ങൾക്കു തൃപ്തിവരുത്തി,</para>
  <para style="q1" vid="EZK 27:33">നിന്‍റെ സമ്പത്തിൻ്റെയും വ്യാപാരത്തിൻ്റെയും പെരുപ്പംകൊണ്ട്</para>
  <para style="q2" vid="EZK 27:33">ഭൂമിയിലെ രാജാക്കന്മാരെ സമ്പന്നന്മാരാക്കി.<verse eid="EZK 27:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="EZK 27:34" />ഇപ്പോൾ നീ സമുദ്രത്തിൽനിന്ന് തകർന്നു പൊയ്പോയി;</para>
  <para style="q2" vid="EZK 27:34">നിന്‍റെ വ്യാപാരസമ്പത്തും നിന്‍റെ അകത്തുള്ള ജനസമൂഹങ്ങളും</para>
  <para style="q2" vid="EZK 27:34">വെള്ളത്തിന്‍റെ ആഴത്തിൽ വീണിരിക്കുന്നു.<verse eid="EZK 27:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="EZK 27:35" />ദ്വീപുവാസികളെല്ലാവരും നിന്നെക്കുറിച്ച് സ്തംഭിച്ചുപോകുന്നു;</para>
  <para style="q2" vid="EZK 27:35">അവരുടെ രാജാക്കന്മാർ ഏറ്റവും ഭയപ്പെട്ട് മുഖം വാടി നില്ക്കുന്നു.<verse eid="EZK 27:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="EZK 27:36" />ജനതകൾക്കിടയിലെ വ്യാപാരികൾ നിന്നെ നിന്ദിക്കുന്നു:</para>
  <para style="q2" vid="EZK 27:36">‘നിനക്കു ശീഘ്രനാശം ഭവിച്ചു നീ സദാകാലത്തേക്കും ഇല്ലാതെയാകും.”<verse eid="EZK 27:36" /></para>
  <para style="b" />
  <chapter eid="EZK 27" />
  <chapter number="28" style="c" sid="EZK 28" />
  <para style="s">സോർരാജാവിനെതിരേയുള്ള പ്രവചനം</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 28:1" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായത് എന്തെന്നാൽ: <verse eid="EZK 28:1" /><verse number="2" style="v" sid="EZK 28:2" />“മനുഷ്യപുത്രാ, നീ സോർപ്രഭുവിനോടു പറയേണ്ടത്: യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:</para>
  <para style="q1" vid="EZK 28:2">“നിന്‍റെ ഹൃദയം നിഗളിച്ചുപോയി; നീ ദൈവമല്ല മനുഷ്യൻ മാത്രമാകുമ്പോൾ: ‘ഞാൻ ദൈവമാകുന്നു;</para>
  <para style="q2" vid="EZK 28:2">ഞാൻ സമുദ്രമദ്ധ്യത്തിൽ ദൈവസിംഹാസനത്തിൽ ഇരിക്കുന്നു’ എന്നു പറഞ്ഞു.<verse eid="EZK 28:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 28:3" />നീ ദൈവഭാവം നടിച്ചതുകൊണ്ട് - നീ ദാനീയേലിലും ജ്ഞാനിയോ?</para>
  <para style="q2" vid="EZK 28:3">നീ അറിയാത്തവിധം മറച്ചുവയ്ക്കാകുന്ന ഒരു രഹസ്യവുമില്ലയോ?<verse eid="EZK 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 28:4" />നിന്‍റെ ജ്ഞാനംകൊണ്ടും വിവേകംകൊണ്ടും</para>
  <para style="q2" vid="EZK 28:4">നീ ധനം സമ്പാദിച്ച് പൊന്നും വെള്ളിയും</para>
  <para style="q2" vid="EZK 28:4">നിന്‍റെ ഭണ്ഡാരത്തിൽ സംഗ്രഹിച്ചുവച്ചു;<verse eid="EZK 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 28:5" />നീ മഹാജ്ഞാനംകൊണ്ട് കച്ചവടത്താൽ ധനം വർദ്ധിപ്പിച്ചു<note caller="+" style="f"><char style="fr" closed="false">28:5 </char><char style="fq" closed="false">നീ മഹാജ്ഞാനംകൊണ്ട് കച്ചവടത്താൽ ധനം വർദ്ധിപ്പിച്ചു </char><char style="ft" closed="false">നിന്‍റെ മഹാജ്ഞാനം കൊണ്ടും വ്യാപാരം കൊണ്ടും നീ നിന്‍റെ സമ്പത്ത് വര്‍ദ്ധിപ്പിച്ചു</char></note>;</para>
  <para style="q2" vid="EZK 28:5">നിന്‍റെ ഹൃദയം ധനംനിമിത്തം ഗർവ്വിച്ചുമിരിക്കുന്നു”<verse eid="EZK 28:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 28:6" />അതുകൊണ്ട് തന്നെ യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:<verse eid="EZK 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 28:7" />നീ ദൈവഭാവം നടിക്കുകയാൽ</para>
  <para style="q2" vid="EZK 28:7">ഞാൻ ജനതകളിൽ ഉഗ്രന്മാരായ അന്യജാതിക്കാരെ നിന്‍റെനേരെ വരുത്തും;</para>
  <para style="q1" vid="EZK 28:7">അവർ നിന്‍റെ ജ്ഞാനത്തിന്‍റെ മനോഹാരിതയ്ക്കു നേരെ വാളൂരി</para>
  <para style="q2" vid="EZK 28:7">നിന്‍റെ പ്രഭയെ അശുദ്ധമാക്കും.<verse eid="EZK 28:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 28:8" />അവർ നിന്നെ കുഴിയിൽ ഇറങ്ങുമാറാക്കും;</para>
  <para style="q2" vid="EZK 28:8">നീ സമുദ്രമദ്ധ്യത്തിൽ നിഹതന്മാരെപ്പോലെ മരിക്കും.<verse eid="EZK 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 28:9" />നിന്നെ കൊല്ലുന്നവൻ്റെ കയ്യിൽ നീ ദൈവമല്ല, മനുഷ്യൻ മാത്രം ആയിരിക്കുമ്പോൾ,</para>
  <para style="q2" vid="EZK 28:9">നിന്നെ കൊല്ലുന്നവൻ്റെ മുമ്പിൽ: ‘ഞാൻ ദൈവം’ എന്നു നീ പറയുമോ?<verse eid="EZK 28:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 28:10" />അന്യദേശക്കാരുടെ കൈകൊണ്ട് നീ അഗ്രചർമ്മികളെപ്പോലെ മരിക്കും;</para>
  <para style="q2" vid="EZK 28:10">ഞാൻ അത് കല്പിച്ചിരിക്കുന്നു” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു.<verse eid="EZK 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 28:11" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായത് എന്തെന്നാൽ: <verse eid="EZK 28:11" /><verse number="12" style="v" sid="EZK 28:12" />“മനുഷ്യപുത്രാ, നീ സോർരാജാവിനെക്കുറിച്ച് ഒരു വിലാപം തുടങ്ങി അവനോട് പറയേണ്ടത്: യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു!</para>
  <para style="q1" vid="EZK 28:12">‘നീ പരിപൂർണ്ണതയുടെ മുദ്രയാകുന്നു;</para>
  <para style="q2" vid="EZK 28:12">നീ ജ്ഞാനസമ്പൂർണ്ണനും സൗന്ദര്യസമ്പൂർണ്ണനും തന്നെ.<verse eid="EZK 28:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 28:13" />നീ ദൈവത്തിന്‍റെ തോട്ടമായ ഏദെനിൽ ആയിരുന്നു;</para>
  <para style="q2" vid="EZK 28:13">താമ്രമണി, പീതരത്നം, വജ്രം, പുഷ്പരാഗം, ഗോമേദകം, സൂര്യകാന്തം,</para>
  <para style="q1" vid="EZK 28:13">നീലക്കല്ല്, മാണിക്യം, മരതകം മുതലായ സകലരത്നങ്ങളും നിന്നെ മൂടിയിരുന്നു;</para>
  <para style="q2" vid="EZK 28:13">നിന്നെ നിർമ്മിച്ചനാളിൽ നിന്‍റെ തംബുരുവിൻ്റെയും</para>
  <para style="q2" vid="EZK 28:13">പുല്ലാംകുഴലിൻ്റെയും പണി പൊന്നുകൊണ്ടുള്ളതായിരുന്നു.<verse eid="EZK 28:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 28:14" />നീ ചിറകുവിടർത്തി മറയ്ക്കുന്ന കെരൂബ് ആകുന്നു;</para>
  <para style="q2" vid="EZK 28:14">ഞാൻ നിന്നെ വിശുദ്ധദേവപർവ്വതത്തിൽ ഇരുത്തിയിരുന്നു;</para>
  <para style="q2" vid="EZK 28:14">നീ അഗ്നിമയരഥങ്ങളുടെ മദ്ധ്യത്തിൽ സഞ്ചരിച്ചുപോന്നു.<verse eid="EZK 28:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="EZK 28:15" />നിന്നെ സൃഷ്ടിച്ച നാൾമുതൽ നിന്നിൽ നീതികേട് കണ്ടതുവരെ</para>
  <para style="q2" vid="EZK 28:15">നീ നടപ്പിൽ നിഷ്കളങ്കനായിരുന്നു.<verse eid="EZK 28:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="EZK 28:16" />നിന്‍റെ വ്യാപാരത്തിൻ്റെ പെരുപ്പംനിമിത്തം</para>
  <para style="q2" vid="EZK 28:16">നിന്‍റെ അന്തർഭാഗം സാഹസംകൊണ്ടു നിറഞ്ഞ് നീ പാപംചെയ്തു;</para>
  <para style="q1" vid="EZK 28:16">അതുകൊണ്ട് ഞാൻ നിന്നെ ‘അശുദ്ധൻ’ എന്നു എണ്ണി</para>
  <para style="q2" vid="EZK 28:16">ദേവപർവ്വതത്തിൽ നിന്ന് തള്ളിക്കളഞ്ഞു;</para>
  <para style="q1" vid="EZK 28:16">മറയ്ക്കുന്ന കെരൂബേ,</para>
  <para style="q2" vid="EZK 28:16">ഞാൻ നിന്നെ അഗ്നിമയരഥങ്ങളുടെ മദ്ധ്യത്തിൽനിന്ന് നശിപ്പിച്ചുകളഞ്ഞു.<verse eid="EZK 28:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="EZK 28:17" />നിന്‍റെ സൗന്ദര്യംനിമിത്തം നിന്‍റെ ഹൃദയം ഗർവ്വിച്ചു;</para>
  <para style="q2" vid="EZK 28:17">നിന്‍റെ പ്രഭനിമിത്തം നീ നിന്‍റെ ജ്ഞാനത്തെ വഷളാക്കി;</para>
  <para style="q2" vid="EZK 28:17">ഞാൻ നിന്നെ നിലത്തു തള്ളിയിട്ട്,</para>
  <para style="q1" vid="EZK 28:17">രാജാക്കന്മാർ നിന്നെ കണ്ടു രസിക്കത്തക്കവണ്ണം</para>
  <para style="q2" vid="EZK 28:17">നിന്നെ അവരുടെ മുമ്പിൽ ഇട്ടുകളഞ്ഞു.<verse eid="EZK 28:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="EZK 28:18" />നിന്‍റെ അകൃത്യബാഹുല്യംകൊണ്ടും നിന്‍റെ വ്യാപാരത്തിൻ്റെ നീതികേടുകൊണ്ടും</para>
  <para style="q2" vid="EZK 28:18">നീ നിന്‍റെ വിശുദ്ധമന്ദിരങ്ങളെ അശുദ്ധമാക്കി;</para>
  <para style="q1" vid="EZK 28:18">അതുകൊണ്ട് ഞാൻ നിന്‍റെ നടുവിൽനിന്ന് ഒരു തീ പുറപ്പെടുവിക്കും;</para>
  <para style="q2" vid="EZK 28:18">അത് നിന്നെ ദഹിപ്പിച്ചുകളയും;</para>
  <para style="q1" vid="EZK 28:18">നിന്നെ കാണുന്ന എല്ലാവരുടെയും മുമ്പിൽ</para>
  <para style="q2" vid="EZK 28:18">ഞാൻ നിന്നെ നിലത്തു ഭസ്മമാക്കിക്കളയും.<verse eid="EZK 28:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="EZK 28:19" />ജനതകളിൽ നിന്നെ അറിയുന്നവരെല്ലാവരും നിന്നെ കണ്ടു സ്തംഭിച്ചുപോകും;</para>
  <para style="q2" vid="EZK 28:19">നിനക്കു ശീഘ്രനാശം ഭവിച്ചിട്ട് നീ സദാകാലത്തേക്കും ഇല്ലാതെയാകും.”<verse eid="EZK 28:19" /></para>
  <para style="s">സീദോനെതിരേയുള്ള പ്രവചനം</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 28:20" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ: <verse eid="EZK 28:20" /><verse number="21" style="v" sid="EZK 28:21" />“മനുഷ്യപുത്രാ, നീ സീദോനു നേരെ മുഖംതിരിച്ച് അതിനെക്കുറിച്ച് പ്രവചിച്ചു പറയേണ്ടത്: <verse eid="EZK 28:21" /><verse number="22" style="v" sid="EZK 28:22" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: ‘സീദോനേ, ഞാൻ നിനക്കു വിരോധമായിരിക്കുന്നു; ഞാൻ നിന്‍റെ നടുവിൽ എന്നെത്തന്നെ മഹത്വീകരിക്കും; ഞാൻ അതിൽ ന്യായവിധികൾ നടത്തി എന്നെത്തന്നെ വിശുദ്ധീകരിക്കുമ്പോൾ ഞാൻ യഹോവ എന്നു അവർ അറിയും. <verse eid="EZK 28:22" /><verse number="23" style="v" sid="EZK 28:23" />ഞാൻ അതിൽ പകർച്ചവ്യാധിയും അതിന്‍റെ വീഥികളിൽ രക്തവും അയയ്ക്കും; എല്ലാഭാഗത്തുനിന്നും അതിന്‍റെ നേരെ വരുന്ന വാൾകൊണ്ടു നിഹതന്മാരായവർ അതിന്‍റെ നടുവിൽ വീഴും; ഞാൻ യഹോവ എന്നു അവർ അറിയും. <verse eid="EZK 28:23" /><verse number="24" style="v" sid="EZK 28:24" />യിസ്രായേൽഗൃഹത്തെ നിന്ദിച്ചവരായി അവരുടെ ചുറ്റുമുള്ള എല്ലാവരിലും നിന്ന് കുത്തുന്ന മുൾച്ചെടിയും നോവിക്കുന്ന മുള്ളും ഇനി അവർക്കുണ്ടാകുകയില്ല; ഞാൻ യഹോവയായ കർത്താവ് എന്നു അവർ അറിയും.”<verse eid="EZK 28:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 28:25" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഞാൻ യിസ്രായേൽഗൃഹത്തെ അവർ ചിതറിപ്പോയിരിക്കുന്ന ജനതകളുടെ ഇടയിൽനിന്ന് ശേഖരിച്ചു ജനതകളുടെ കണ്മുമ്പിൽ എന്നെത്തന്നെ അവരിൽ വിശുദ്ധീകരിക്കുമ്പോൾ, ഞാൻ എന്‍റെ ദാസനായ യാക്കോബിനു കൊടുത്ത ദേശത്ത് അവർ വസിക്കും. <verse eid="EZK 28:25" /><verse number="26" style="v" sid="EZK 28:26" />അവർ അതിൽ നിർഭയമായി വസിക്കും; അതെ, അവർ വീടുകൾ പണിത് മുന്തിരിത്തോട്ടങ്ങൾ ഉണ്ടാക്കും; അവരെ നിന്ദിക്കുന്ന അവരുടെ ചുറ്റുമുള്ള എല്ലാവരിലും ഞാൻ ന്യായവിധി നടത്തുമ്പോൾ അവർ നിർഭയമായി വസിക്കും; ഞാൻ അവരുടെ ദൈവമായ യഹോവ എന്നു അവർ അറിയും.”<verse eid="EZK 28:26" /></para>
  <chapter eid="EZK 28" />
  <chapter number="29" style="c" sid="EZK 29" />
  <para style="s">മിസ്രയീമിനെതിരേയുള്ള പ്രവചനം</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 29:1" />ബാബിലോന്യ പ്രവാസത്തിന്‍റെ പത്താം ആണ്ട്, പത്താം മാസം, പന്ത്രണ്ടാം തീയതി യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായത് എന്തെന്നാൽ: <verse eid="EZK 29:1" /><verse number="2" style="v" sid="EZK 29:2" />“മനുഷ്യപുത്രാ, നീ മിസ്രയീം രാജാവായ ഫറവോന്‍റെനേരെ മുഖംതിരിച്ച് അവനും എല്ലാ മിസ്രയീമിനും എതിരായി പ്രവചിച്ചു പറയേണ്ടത് എന്തെന്നാൽ: <verse eid="EZK 29:2" /><verse number="3" style="v" sid="EZK 29:3" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:</para>
  <para style="q1" vid="EZK 29:3">“മിസ്രയീം രാജാവായ ഫറവോനേ, തന്‍റെ നദികളുടെ നടുവിൽ കിടന്ന്:</para>
  <para style="q2" vid="EZK 29:3">‘ഈ നദി എനിക്കുള്ളതാകുന്നു;</para>
  <para style="q1" vid="EZK 29:3">ഞാൻ അതിനെ എനിക്കായിട്ട് ഉണ്ടാക്കിയിരിക്കുന്നു’ എന്നു പറയുന്ന മഹാസത്വമേ,</para>
  <para style="q2" vid="EZK 29:3">ഞാൻ നിനക്കു വിരോധമായിരിക്കുന്നു.<verse eid="EZK 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 29:4" />ഞാൻ നിന്‍റെ ചെകിളയിൽ ചൂണ്ടൽ കൊളുത്തി,</para>
  <para style="q2" vid="EZK 29:4">നിന്‍റെ നദികളിലെ മത്സ്യങ്ങളെ നിന്‍റെ ചെതുമ്പലിൽ പറ്റുമാറാക്കും;</para>
  <para style="q1" vid="EZK 29:4">നിന്നെ നിന്‍റെ നദികളുടെ നടുവിൽനിന്നു വലിച്ചുകയറ്റും;</para>
  <para style="q2" vid="EZK 29:4">നിന്‍റെ നദികളിലെ മത്സ്യം എല്ലാം നിന്‍റെ ചെതുമ്പലിൽ പറ്റിയിരിക്കും.<verse eid="EZK 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 29:5" />ഞാൻ നിന്നെയും നിന്‍റെ നദികളിലെ മത്സ്യങ്ങളെ എല്ലാം മരുഭൂമിയിൽ എറിഞ്ഞുകളയും;</para>
  <para style="q2" vid="EZK 29:5">നീ വെളിമ്പ്രദേശത്തു വീഴും;</para>
  <para style="q1" vid="EZK 29:5">ആരും നിന്നെ പെറുക്കുകയോ ശേഖരിക്കുകയോ ചെയ്യുകയില്ല;</para>
  <para style="q2" vid="EZK 29:5">ഞാൻ നിന്നെ കാട്ടുമൃഗങ്ങൾക്കും ആകാശത്തിലെ പക്ഷികൾക്കും ഇരയായി കൊടുക്കും.<verse eid="EZK 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 29:6" />മിസ്രയീം നിവാസികൾ യിസ്രായേൽഗൃഹത്തിന് ഒരു <note caller="+" style="f"><char style="fr" closed="false">29:6 </char><char style="ft" closed="false">ഞാങ്ങണവടി</char></note>ഓടക്കോലായിരുന്നതുകൊണ്ട് ഞാൻ യഹോവ എന്നു അവരെല്ലം അറിയും. <verse eid="EZK 29:6" /><verse number="7" style="v" sid="EZK 29:7" />അവർ നിന്നെ കയ്യിൽ പിടിച്ചപ്പോൾ തന്നെ നീ ഒടിഞ്ഞ് അവരുടെ തോൾ എല്ലാം കീറിക്കളഞ്ഞു; അവർ ഊന്നിയപ്പോൾ തന്നെ നീ ഒടിഞ്ഞ് അവരുടെ നടുവെല്ലാം കുലുങ്ങുമാറാക്കി.”<verse eid="EZK 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 29:8" />അതുകൊണ്ട് യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഞാൻ നിന്‍റെനേരെ വാൾ വരുത്തി നിന്നിൽനിന്ന് മനുഷ്യനെയും മൃഗത്തെയും ഛേദിച്ചുകളയും. <verse eid="EZK 29:8" /><verse number="9" style="v" sid="EZK 29:9" />മിസ്രയീം പാഴും ശൂന്യവുമായിത്തീരും; ഞാൻ യഹോവ എന്നു അവർ അറിയും; ‘നദി എനിക്കുള്ളതാകുന്നു; ഞാൻ അതിനെ ഉണ്ടാക്കിയിരിക്കുന്നു’ എന്നു അവൻ പറഞ്ഞുവല്ലോ. <verse eid="EZK 29:9" /><verse number="10" style="v" sid="EZK 29:10" />അതുകൊണ്ട് ഞാൻ നിനക്കും നിന്‍റെ നദികൾക്കും വിരോധമായിരുന്ന് മിസ്രയീമിലെ സെവേനെഗോപുരം മുതൽ കൂശിന്‍റെ അതിർത്തിവരെ അശേഷം പാഴും ശൂന്യവുമാക്കും. <verse eid="EZK 29:10" /><verse number="11" style="v" sid="EZK 29:11" />മനുഷ്യന്‍റെ കാൽ അതിൽകൂടി കടന്നുപോകുകയില്ല; മൃഗത്തിന്‍റെ കാൽ അതിൽ ചവിട്ടുകയുമില്ല; നാല്പതു സംവത്സരത്തേക്ക് അതിൽ നിവാസികൾ ഇല്ലാതെയിരിക്കും. <verse eid="EZK 29:11" /><verse number="12" style="v" sid="EZK 29:12" />ഞാൻ മിസ്രയീമിനെ ശൂന്യദേശങ്ങളുടെ കൂട്ടത്തിൽ ശൂന്യമാക്കും; അതിലെ പട്ടണങ്ങൾ ശൂന്യപട്ടണങ്ങളുടെ കൂട്ടത്തിൽ നാല്പതു വർഷത്തേക്ക് ശൂന്യമായിരിക്കും; ഞാൻ മിസ്രയീം നിവാസികളെ ജനതകളുടെ ഇടയിൽ ഛിന്നിച്ച് ദേശങ്ങളിൽ ചിതറിച്ചുകളയും.”<verse eid="EZK 29:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 29:13" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “നാല്പതു വര്‍ഷം കഴിഞ്ഞിട്ട് ഞാൻ മിസ്രയീം നിവാസികളെ അവർ ചിതറിപ്പോയിരിക്കുന്ന ജനതകളിൽനിന്ന് ശേഖരിക്കും. <verse eid="EZK 29:13" /><verse number="14" style="v" sid="EZK 29:14" />ഞാൻ മിസ്രയീമിന്‍റെ പ്രവാസം മാറ്റി, അവരെ അവരുടെ ജന്മദേശമായ പത്രോസ് ദേശത്തേക്ക് മടക്കിവരുത്തും; അവിടെ അവർ ഒരു എളിയരാജ്യമായിരിക്കും. <verse eid="EZK 29:14" /><verse number="15" style="v" sid="EZK 29:15" />അത് രാജ്യങ്ങളിൽവച്ച് ഏറ്റവും എളിയരാജ്യമായിരിക്കും; ഇനി ജനതകൾക്കു മേലായി അത് തന്നെത്താൻ ഉയർത്തുകയും ഇല്ല; അവർ ജനതകളുടെമേൽ വാഴാത്തവിധം ഞാൻ അവരെ കുറച്ചുകളയും. <verse eid="EZK 29:15" /><verse number="16" style="v" sid="EZK 29:16" />യിസ്രായേൽഗൃഹം തിരിഞ്ഞ് അവരെ നോക്കുമ്പോൾ, അവരവരുടെ അകൃത്യം ഓർമ്മിപ്പിക്കുന്ന ഒരു ശരണമായി അവർ ഇരിക്കുകയില്ല; ഞാൻ യഹോവയായ കർത്താവ് എന്നു അവർ അറിയും.”<verse eid="EZK 29:16" /></para>
  <para style="s">നെബൂഖദ്നേസരിനുള്ള പ്രതിഫലം</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 29:17" />ബാബിലോന്യ പ്രവാസത്തിന്‍റെ ഇരുപത്തേഴാം ആണ്ട്, ഒന്നാം മാസം, ഒന്നാം തീയതി യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായത് എന്തെന്നാൽ: <verse eid="EZK 29:17" /><verse number="18" style="v" sid="EZK 29:18" />“മനുഷ്യപുത്രാ, ബാബേൽരാജാവായ നെബൂഖദ്നേസർ സോരിന്‍റെ നേരെ തന്‍റെ സൈന്യത്തെക്കൊണ്ട് കഠിനവേല ചെയ്യിച്ചു; എല്ലാ തലയും കഷണ്ടിയായി, എല്ലാചുമലും തോലുരിഞ്ഞുപോയി; എങ്കിലും സോരിനു വിരോധമായി ചെയ്തവേലയ്ക്കു അവനോ അവന്‍റെ സൈന്യത്തിനോ അവിടെനിന്നു പ്രതിഫലം കിട്ടിയില്ല.” <verse eid="EZK 29:18" /><verse number="19" style="v" sid="EZK 29:19" />അതുകൊണ്ട് യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഞാൻ മിസ്രയീമിനെ ബാബേൽരാജാവായ നെബൂഖദ്നേസരിനു കൊടുക്കും; അവൻ അതിലെ സമ്പത്ത് എടുത്ത് അതിനെ കൊള്ളയിട്ട് കവർച്ച ചെയ്യും; അത് അവന്‍റെ സൈന്യത്തിനു പ്രതിഫലമായിരിക്കും. <verse eid="EZK 29:19" /><verse number="20" style="v" sid="EZK 29:20" />ഞാൻ അവന്, അവൻ ചെയ്തവേലയ്ക്കു പ്രതിഫലമായി മിസ്രയീമിനെ കൊടുക്കുന്നു; അവർ എനിക്കായിട്ടല്ലയോ പ്രവർത്തിച്ചത്” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 29:21" />“അന്നാളിൽ ഞാൻ യിസ്രായേൽഗൃഹത്തിന് ഒരു കൊമ്പ് മുളയ്ക്കുമാറാക്കി, അവരുടെ നടുവിൽ നിനക്കു തുറന്ന വായ് നല്കും; ഞാൻ യഹോവ എന്നു അവർ അറിയും.”<verse eid="EZK 29:21" /></para>
  <chapter eid="EZK 29" />
  <chapter number="30" style="c" sid="EZK 30" />
  <para style="s">മിസ്രയീമിനെക്കുറിച്ച് ഒരു വിലാപഗീതം</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 30:1" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ: <verse eid="EZK 30:1" /><verse number="2" style="v" sid="EZK 30:2" />മനുഷ്യപുത്രാ, നീ പ്രവചിച്ചു പറയേണ്ടത്: യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “അയ്യോ, കഷ്ടദിവസം!” എന്നു വിലപിക്കുവിൻ.<verse eid="EZK 30:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="EZK 30:3" />“നാൾ അടുത്തിരിക്കുന്നു! അതേ, യഹോവയുടെ നാൾ അടുത്തിരിക്കുന്നു!</para>
  <para style="q2" vid="EZK 30:3">അത് മേഘമുള്ള ദിവസം, ജനതകളുടെ കാലം തന്നെ ആയിരിക്കും.<verse eid="EZK 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 30:4" />മിസ്രയീമിന്‍റെ നേരെ വാൾവരും; കൂശിൽ അതിവേദനയുണ്ടാകും</para>
  <para style="q2" vid="EZK 30:4">മിസ്രയീമിൽ നിഹതന്മാർ വീഴുകയും</para>
  <para style="q1" vid="EZK 30:4">അവർ അതിലെ ജനത്തെ<note caller="+" style="f"><char style="fr" closed="false">30:4 </char><char style="fq" closed="false">ജനത്തെ </char><char style="ft" closed="false">സമ്പത്ത്</char></note> അപഹരിക്കുകയും</para>
  <para style="q2" vid="EZK 30:4">അതിന്‍റെ അടിസ്ഥാനങ്ങൾ ഇടിക്കുകയും ചെയ്യും.<verse eid="EZK 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 30:5" />കൂശ്യരും പൂത്യരും ലൂദ്യരും ആയ സകല സമ്മിശ്രജനതകളും</para>
  <para style="q2" vid="EZK 30:5">കൂബ്യരും സഖ്യത്തിൽപെട്ട ദേശക്കാരും അവരോടുകൂടെ വാൾകൊണ്ടു വീഴും.”<verse eid="EZK 30:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="EZK 30:6" />യഹോവ ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:</para>
  <para style="q1" vid="EZK 30:6">“മിസ്രയീമിനെ താങ്ങുന്നവർ വീഴും;</para>
  <para style="q2" vid="EZK 30:6">അതിന്‍റെ ബലത്തിന്‍റെ പ്രതാപം താണുപോകും;</para>
  <para style="q1" vid="EZK 30:6">സെവേനേഗോപുരംമുതൽ അവർ വാൾകൊണ്ടു വീഴും”</para>
  <para style="q2" vid="EZK 30:6">എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 30:7" />അവർ ശൂന്യദേശങ്ങളുടെ മദ്ധ്യത്തിൽ ശൂന്യമായിപ്പോകും;</para>
  <para style="q2" vid="EZK 30:7">അതിലെ പട്ടണങ്ങൾ ശൂന്യപട്ടണങ്ങളുടെ കൂട്ടത്തിൽ ആയിരിക്കും.<verse eid="EZK 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 30:8" />ഞാൻ മിസ്രയീമിനു തീ വച്ചിട്ട്,</para>
  <para style="q2" vid="EZK 30:8">അതിന്‍റെ സഹായികൾ എല്ലാവരും തകർന്നുപോകുമ്പോൾ</para>
  <para style="q2" vid="EZK 30:8">ഞാൻ യഹോവയെന്ന് അവർ അറിയും.<verse eid="EZK 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 30:9" />ആ നാളിൽ ദൂതന്മാർ അശ്രദ്ധരായ കൂശ്യരെ ഭയപ്പെടുത്തേണ്ടതിന് കപ്പലുകളിൽ കയറി എന്‍റെ മുമ്പിൽനിന്നു പുറപ്പെടും; അപ്പോൾ മിസ്രയീമിന്‍റെ നാളിൽ എന്നപോലെ അവർക്ക് അതിവേദന ഉണ്ടാകും; ഇതാ, അത് വരുന്നു.”<verse eid="EZK 30:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="EZK 30:10" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:</para>
  <para style="q2" vid="EZK 30:10">“ഞാൻ ബാബേൽരാജാവായ നെബൂഖദ്നേസരിന്‍റെ കയ്യാൽ</para>
  <para style="q2" vid="EZK 30:10">മിസ്രയീമിന്‍റെ പുരുഷാരത്തെ ഇല്ലാതെയാകും.<verse eid="EZK 30:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 30:11" />ദേശത്തെ നശിപ്പിക്കേണ്ടതിന് അവനെയും</para>
  <para style="q2" vid="EZK 30:11">അവനോടുകൂടെ ജനതകളിൽ ഭയങ്കരന്മാരായ അവന്‍റെ ജനത്തെയും വരുത്തും;</para>
  <para style="q1" vid="EZK 30:11">അവർ മിസ്രയീമിന്‍റെ നേരെ വാൾ ഊരി</para>
  <para style="q2" vid="EZK 30:11">ദേശത്തെ നിഹതന്മാരെക്കൊണ്ടു നിറയ്ക്കും.<verse eid="EZK 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 30:12" />ഞാൻ നദികൾ വറ്റിച്ച് ദേശത്തെ ദുഷ്ടന്മാർക്കു വിറ്റുകളയും;</para>
  <para style="q2" vid="EZK 30:12">ദേശത്തെയും അതിലുള്ള സകലത്തെയും ഞാൻ അന്യജനതകളുടെ കയ്യാൽ ശൂന്യമാക്കും;</para>
  <para style="q2" vid="EZK 30:12">യഹോവയായ ഞാൻ അത് അരുളിച്ചെയ്തിരിക്കുന്നു.”<verse eid="EZK 30:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="EZK 30:13" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:</para>
  <para style="q2" vid="EZK 30:13">“ഞാൻ വിഗ്രഹങ്ങളെ നശിപ്പിച്ച് അവരുടെ മിഥ്യാമൂർത്തികളെ നോഫിൽനിന്ന് ഇല്ലാതെയാകും;</para>
  <para style="q1" vid="EZK 30:13">ഇനി മിസ്രയീമിൽ നിന്ന് ഒരു പ്രഭു ഉത്ഭവിക്കുകയില്ല;</para>
  <para style="q2" vid="EZK 30:13">ഞാൻ മിസ്രയീമിൽ ഭയം വരുത്തും.<verse eid="EZK 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 30:14" />ഞാൻ പത്രോസിനെ ശൂന്യമാക്കും;</para>
  <para style="q2" vid="EZK 30:14">സോവാനു തീ വയ്ക്കും, നോവിൽ ന്യായവിധി നടത്തും.<verse eid="EZK 30:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="EZK 30:15" />മിസ്രയീമിന്‍റെ കോട്ടയായ സീനിൽ ഞാൻ എന്‍റെ ക്രോധം പകരും;</para>
  <para style="q2" vid="EZK 30:15">ഞാൻ നോവിലെ പുരുഷാരത്തെ ഛേദിച്ചുകളയും.<verse eid="EZK 30:15" /></para>
  <para style="pi">
    <verse number="16" style="v" sid="EZK 30:16" />ഞാൻ മിസ്രയീമിനു തീ വയ്ക്കും;</para>
  <para style="q2" vid="EZK 30:16">സീൻ അതിവേദനയിൽ ആകും;</para>
  <para style="q1" vid="EZK 30:16">നോവ് പിളർന്നുപോകും;</para>
  <para style="q2" vid="EZK 30:16">നോഫ് നിരന്തരം ദുരിതത്തിലാകും.<verse eid="EZK 30:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="EZK 30:17" />ആവെനിലെയും പി-ബേസെത്തിലെയും യൗവനക്കാർ വാൾകൊണ്ടു വീഴും;</para>
  <para style="q2" vid="EZK 30:17">ആ പട്ടണങ്ങൾ പ്രവാസത്തിലേക്കു പോകേണ്ടിവരും.<verse eid="EZK 30:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="EZK 30:18" />ഞാൻ മിസ്രയീമിന്‍റെ നുകം ഒടിച്ച് അവളുടെ ബലത്തിന്‍റെ പ്രതാപം ഇല്ലാതാക്കുമ്പോൾ</para>
  <para style="q2" vid="EZK 30:18">തഹഫ്നേഹെസിൽ പകൽ ഇരുണ്ടുപോകും;</para>
  <para style="q1" vid="EZK 30:18">അവളെ ഒരു മേഘം മൂടും;</para>
  <para style="q2" vid="EZK 30:18">അവളുടെ പുത്രിമാർ പ്രവാസത്തിലേക്കു പോകേണ്ടിവരും.<verse eid="EZK 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="EZK 30:19" />ഇങ്ങനെ ഞാൻ മിസ്രയീമിൽ ന്യായവിധികൾ നടത്തും;</para>
  <para style="q2" vid="EZK 30:19">ഞാൻ യഹോവ എന്നു അവർ അറിയും.”<verse eid="EZK 30:19" /></para>
  <para style="s">ഫറവോന്‍റെ കൈകൾ തകർക്കപ്പെടുന്നു</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 30:20" />പതിനൊന്നാമാണ്ട്, ഒന്നാം മാസം ഏഴാം തീയതി യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായത് എന്തെന്നാൽ: <verse eid="EZK 30:20" /><verse number="21" style="v" sid="EZK 30:21" />“മനുഷ്യപുത്രാ, മിസ്രയീം രാജാവായ ഫറവോന്‍റെ ഭുജത്തെ ഞാൻ ഒടിച്ചിരിക്കുന്നു; അത് വാൾ പിടിക്കുവാൻ തക്കവണ്ണം ശക്തി പ്രാപിക്കേണ്ടതിന് അതിന് മരുന്ന് വച്ചുകെട്ടുകയില്ല, ചികിത്സ ചെയ്യുകയുമില്ല.” <verse eid="EZK 30:21" /><verse number="22" style="v" sid="EZK 30:22" />അതുകൊണ്ട് യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഞാൻ മിസ്രയീം രാജാവായ ഫറവോനു വിരോധമായിരിക്കുന്നു; ഞാൻ അവന്‍റെ ഭുജങ്ങളെ, ബലമുള്ളതിനെയും ഒടിഞ്ഞിരിക്കുന്നതിനെയും തന്നെ, ഒടിച്ചുകളയും; ഞാൻ അവന്‍റെ കയ്യിൽനിന്നു വാൾ വീഴ്ത്തികളയുകയും ചെയ്യും. <verse eid="EZK 30:22" /><verse number="23" style="v" sid="EZK 30:23" />ഞാൻ മിസ്രയീമ്യരെ ജനതകളുടെ ഇടയിൽ ഛിന്നിച്ച് ദേശങ്ങളിൽ ചിതറിച്ചുകളയും. <verse eid="EZK 30:23" /><verse number="24" style="v" sid="EZK 30:24" />ഞാൻ ബാബേൽരാജാവിന്‍റെ ഭുജങ്ങളെ ബലപ്പെടുത്തി എന്‍റെ വാൾ അവന്‍റെ കയ്യിൽ കൊടുക്കും; ഫറവോന്‍റെ ഭുജങ്ങളെയോ ഞാൻ ഒടിച്ചുകളയും; മുറിവേറ്റവൻ ഞരങ്ങുന്നതുപോലെ അവൻ അവന്‍റെ മുമ്പിൽ ഞരങ്ങും. <verse eid="EZK 30:24" /><verse number="25" style="v" sid="EZK 30:25" />ഇങ്ങനെ ഞാൻ ബാബേൽരാജാവിന്‍റെ ഭുജങ്ങളെ ബലപ്പെടുത്തും; ഫറവോന്‍റെ ഭുജങ്ങൾ വീണുപോകും; ഞാൻ എന്‍റെ വാൾ ബാബേൽരാജാവിന്‍റെ കയ്യിൽ കൊടുത്തിട്ട്, അവൻ അതിനെ മിസ്രയീമിന്‍റെ നേരെ ഓങ്ങുമ്പോൾ ഞാൻ യഹോവ എന്നു അവർ അറിയും. <verse eid="EZK 30:25" /><verse number="26" style="v" sid="EZK 30:26" />ഞാൻ മിസ്രയീമ്യരെ ജനതകളുടെ ഇടയിൽ ഛിന്നിച്ച് ദേശങ്ങളിൽ ചിതറിച്ചുകളയും; ഞാൻ യഹോവ എന്നു അവർ അറിയും.”<verse eid="EZK 30:26" /></para>
  <chapter eid="EZK 30" />
  <chapter number="31" style="c" sid="EZK 31" />
  <para style="s">ലെബാനോനിലെ ദേവദാരു</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 31:1" />ബാബിലോന്യ പ്രവാസത്തിന്‍റെ പതിനൊന്നാം ആണ്ട്, മൂന്നാം മാസം, ഒന്നാം തീയതി യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായത് എന്തെന്നാൽ: <verse eid="EZK 31:1" /><verse number="2" style="v" sid="EZK 31:2" />“മനുഷ്യപുത്രാ, നീ മിസ്രയീം രാജാവായ ഫറവോനോടും അവന്‍റെ പുരുഷാരത്തോടും പറയേണ്ടത്:</para>
  <para style="q1" vid="EZK 31:2">‘നിന്‍റെ മഹത്ത്വത്തിൽ നീ ആരോട് സമനായിരിക്കുന്നു?<verse eid="EZK 31:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="EZK 31:3" />അശ്ശൂർ, ലെബാനോനിൽ ഭംഗിയുള്ള കൊമ്പുകളോടും</para>
  <para style="q1" vid="EZK 31:3">തണലുള്ള ഇലകളോടും കൂടി ഉയർന്ന്</para>
  <para style="q2" vid="EZK 31:3">പടർന്നുപന്തലിച്ച ഒരു ദേവദാരു ആയിരുന്നുവല്ലോ;</para>
  <para style="q2" vid="EZK 31:3">അതിന്‍റെ അഗ്രം മേഘങ്ങളോളം എത്തിയിരുന്നു.<verse eid="EZK 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 31:4" />വെള്ളം അതിനെ വളർത്തി ആഴി അതിനെ ഉയരുമാറാക്കി;</para>
  <para style="q2" vid="EZK 31:4">അതിന്‍റെ നദികൾ തോട്ടത്തെ ചുറ്റി ഒഴുകി,</para>
  <para style="q1" vid="EZK 31:4">അത് തന്‍റെ പ്രവാഹങ്ങളെ വയലിലെ സകലവൃക്ഷങ്ങളുടെയും</para>
  <para style="q2" vid="EZK 31:4">അടുക്കലേക്ക് അയച്ചുകൊടുത്തു.<verse eid="EZK 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 31:5" />അതുകൊണ്ട് അത് വളർന്ന് വയലിലെ സകലവൃക്ഷങ്ങളെക്കാളും പൊങ്ങി;</para>
  <para style="q2" vid="EZK 31:5">വെള്ളത്തിന്‍റെ സമൃദ്ധികൊണ്ട് അത് പടർന്ന്</para>
  <para style="q2" vid="EZK 31:5">തന്‍റെ കൊമ്പുകളെ വർദ്ധിപ്പിച്ച് ചില്ലികളെ നീട്ടി.<verse eid="EZK 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 31:6" />അതിന്‍റെ ചില്ലികളിൽ ആകാശത്തിലെ പറവകൾ എല്ലാം കൂടുണ്ടാക്കി;</para>
  <para style="q2" vid="EZK 31:6">അതിന്‍റെ കൊമ്പുകളുടെ കീഴിൽ കാട്ടുമൃഗങ്ങൾ എല്ലാം പ്രസവിച്ചുകിടന്നു;</para>
  <para style="q2" vid="EZK 31:6">അതിന്‍റെ തണലിൽ വലിയ ജനസമൂഹമെല്ലാം വസിച്ചു.<verse eid="EZK 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 31:7" />ഇങ്ങനെ അതിന്‍റെ വേര് ജലസമൃദ്ധിക്കരികിൽ ആയിരുന്നതുകൊണ്ട്,</para>
  <para style="q2" vid="EZK 31:7">അത് വലുതായി കൊമ്പുകൾ നീട്ടി ശോഭിച്ചിരുന്നു.<verse eid="EZK 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 31:8" />ദൈവത്തിന്‍റെ തോട്ടത്തിലെ ദേവദാരുക്കൾക്ക് അതിനെ മറയ്ക്കുവാൻ കഴിഞ്ഞില്ല;</para>
  <para style="q2" vid="EZK 31:8">സരളവൃക്ഷങ്ങൾ അതിന്‍റെ കൊമ്പുകളോടു തുല്യമായിരുന്നില്ല;</para>
  <para style="q1" vid="EZK 31:8">അരിഞ്ഞിൽവൃക്ഷങ്ങൾ അതിന്‍റെ ചില്ലികളോട് ഒത്തിരുന്നില്ല;</para>
  <para style="q2" vid="EZK 31:8">ദൈവത്തിന്‍റെ തോട്ടത്തിലെ ഒരു വൃക്ഷവും ഭംഗിയിൽ അതിനോട് സമമായിരുന്നതുമില്ല.<verse eid="EZK 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 31:9" />കൊമ്പുകളുടെ പെരുപ്പംകൊണ്ട് ഞാൻ അതിന് ഭംഗിവരുത്തിയതിനാൽ</para>
  <para style="q2" vid="EZK 31:9">ദൈവത്തിന്‍റെ തോട്ടമായ ഏദെനിലെ സകലവൃക്ഷങ്ങളും അതിനോട് അസൂയപ്പെട്ടു.”<verse eid="EZK 31:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 31:10" />അതുകൊണ്ട് യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “അത് വളർന്നുപൊങ്ങി അഗ്രം മേഘങ്ങളോളം നീട്ടി, അതിന്‍റെ ഹൃദയം തന്‍റെ വളർച്ചയിൽ നിഗളിച്ചുപോയതുകൊണ്ട്, <verse eid="EZK 31:10" /><verse number="11" style="v" sid="EZK 31:11" />ഞാൻ അതിനെ ജനതകളിൽ ബലവാനായവൻ്റെ കയ്യിൽ ഏല്പിക്കും; അവൻ അതിനോട് ഇടപെടും; അതിന്‍റെ ദുഷ്ടതനിമിത്തം ഞാൻ അതിനെ തള്ളിക്കളഞ്ഞിരിക്കുന്നു. <verse eid="EZK 31:11" /><verse number="12" style="v" sid="EZK 31:12" />ജനതകളിൽ ഉഗ്രന്മാരായ അന്യജാതിക്കാർ അതിനെ വെട്ടി തള്ളിയിട്ടു; അതിന്‍റെ കൊമ്പുകൾ മലകളിലും എല്ലാ താഴ്വരകളിലും വീണു; അതിന്‍റെ ശാഖകൾ ദേശത്തിലെ എല്ലാതോടുകളുടെയും അരികത്ത് ഒടിഞ്ഞു കിടക്കുന്നു; ഭൂമിയിലെ സകലജനവർഗ്ഗങ്ങളും അതിന്‍റെ തണൽ വിട്ട്, അതിനെ ഉപേക്ഷിച്ചുപോയി.<verse eid="EZK 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 31:13" />വീണുകിടക്കുന്ന അതിന്‍റെ തടിമേൽ ആകാശത്തിലെ പറവകളെല്ലാം പാർക്കും;</para>
  <para style="q2" vid="EZK 31:13">അതിന്‍റെ കൊമ്പുകളുടെ ഇടയിലേക്ക് കാട്ടുമൃഗങ്ങളെല്ലാം വരും.<verse eid="EZK 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 31:14" />വെള്ളത്തിനരികിലുള്ള ഒരു വൃക്ഷവും ഉയരം കാരണം നിഗളിക്കുകയോ, അഗ്രം മേഘങ്ങളോളം നീട്ടുകയോ, വെള്ളം കുടിക്കുന്നവരായ അവരുടെ സകലബലശാലികളും അവരുടെ ഉയർച്ചയിൽ നിഗളിച്ചു നില്‍ക്കുകയോ ചെയ്യാതിരിക്കേണ്ടതിനു തന്നെ; അവരെല്ലാം മനുഷ്യപുത്രന്മാരുടെ ഇടയിൽ കുഴിയിൽ ഇറങ്ങുന്നവരോടുകൂടെ ഭൂമിയുടെ അധോഭാഗത്ത് മരണത്തിന് ഏല്പിക്കപ്പെട്ടിരിക്കുന്നു.”<verse eid="EZK 31:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 31:15" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “അത് പാതാളത്തിൽ ഇറങ്ങിപ്പോയനാളിൽ ഞാൻ ഒരു വിലാപം കഴിപ്പിച്ചു; അതിന് വേണ്ടി ആഴത്തെ മൂടി; പെരുവെള്ളം കെട്ടിനില്ക്കുവാൻ തക്കവിധം അതിന്‍റെ നദികളെ തടസ്സപ്പെടുത്തി; അതുനിമിത്തം ഞാൻ ലെബാനോനെ വിലപിക്കുമാറാക്കി; കാട്ടിലെ സകലവൃക്ഷങ്ങളും അതുനിമിത്തം ക്ഷീണിച്ചുപോയി. <verse eid="EZK 31:15" /><verse number="16" style="v" sid="EZK 31:16" />ഞാൻ കുഴിയിൽ ഇറങ്ങുന്നവരോടുകൂടെ പാതാളത്തിൽ അതിനെ തള്ളിയിട്ടപ്പോൾ, അതിന്‍റെ വീഴ്ചയുടെ മുഴക്കത്തിൽ ഞാൻ ജനതകളെ നടുങ്ങുമാറാക്കി; ഏദെനിലെ സകലവൃക്ഷങ്ങളും ലെബാനോനിലെ ശ്രേഷ്ഠവും ഉത്തമവുമായ, വെള്ളം കുടിക്കുന്ന സകലവൃക്ഷങ്ങളും ഭൂമിയുടെ അധോഭാഗത്ത് ആശ്വാസം പ്രാപിച്ചു. <verse eid="EZK 31:16" /><verse number="17" style="v" sid="EZK 31:17" />അവയും അതിനോടുകൂടെ വാളാൽ നിഹതന്മാരായവരുടെ അടുക്കൽ പാതാളത്തിൽ ഇറങ്ങിപ്പോയി; അതിന്‍റെ തുണയായി അതിന്‍റെ നിഴലിൽ ജനതകളുടെ മദ്ധ്യത്തിൽ വസിച്ചവർ തന്നെ.<verse eid="EZK 31:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 31:18" />അങ്ങനെ നീ മഹത്ത്വത്തിലും വലിപ്പത്തിലും ഏദെനിലെ വൃക്ഷങ്ങളിൽ ഏതിനോട് തുല്യമാകുന്നു? എന്നാൽ നീ ഏദെനിലെ വൃക്ഷങ്ങളോടുകൂടെ ഭൂമിയുടെ അധോഭാഗത്ത് ഇറങ്ങിപ്പോകേണ്ടിവരും; വാളാൽ നിഹതന്മാരായവരോടുകൂടെ നീ അഗ്രചർമ്മികളുടെ ഇടയിൽ കിടക്കും. ഇത് ഫറവോനും അവന്‍റെ സകലപുരുഷാരവും തന്നെ” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 31:18" /></para>
  <chapter eid="EZK 31" />
  <chapter number="32" style="c" sid="EZK 32" />
  <para style="s">ഫറവോനെക്കുറിച്ച് ഒരു വിലാപഗീതം</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 32:1" />ബാബിലോന്യ പ്രവാസത്തിന്‍റെ പന്ത്രണ്ടാം ആണ്ട്, പന്ത്രണ്ടാം മാസം, ഒന്നാം തീയതി യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായത് എന്തെന്നാൽ: <verse eid="EZK 32:1" /><verse number="2" style="v" sid="EZK 32:2" />“മനുഷ്യപുത്രാ, നീ മിസ്രയീം രാജാവായ ഫറവോനെക്കുറിച്ച് ഒരു വിലാപം കഴിച്ച് അവനോട് പറയേണ്ടത്:</para>
  <para style="q1" vid="EZK 32:2">‘ജനതകളിൽ ബാലസിംഹമായുള്ളോവേ, നീ നശിച്ചിരിക്കുന്നു;</para>
  <para style="q2" vid="EZK 32:2">നീ കടലിലെ നക്രംപോലെ ആയിരുന്നു;</para>
  <para style="q1" vid="EZK 32:2">നീ നദികളിൽ ചാടി കാൽ കൊണ്ടു വെള്ളം കലക്കി</para>
  <para style="q2" vid="EZK 32:2">നദികളെ മലിനമാക്കിക്കളഞ്ഞു.’<verse eid="EZK 32:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 32:3" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:</para>
  <para style="q1" vid="EZK 32:3">“ഞാൻ അനേകം ജനതകളുടെ കൂട്ടത്തെക്കൊണ്ട്</para>
  <para style="q2" vid="EZK 32:3">നിന്‍റെമേൽ എന്‍റെ വല വീശിക്കും;</para>
  <para style="q2" vid="EZK 32:3">എന്‍റെ വലയിൽ അവർ നിന്നെ വലിച്ചെടുക്കും;<verse eid="EZK 32:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 32:4" />ഞാൻ നിന്നെ കരയിലേക്ക് വലിച്ചിടും;</para>
  <para style="q2" vid="EZK 32:4">നിന്നെ വെളിമ്പ്രദേശത്ത് എറിഞ്ഞുകളയും;</para>
  <para style="q1" vid="EZK 32:4">ആകാശത്തിലെ പറവകളെയെല്ലാം നിന്‍റെമേൽ ഇരിക്കുമാറാക്കും;</para>
  <para style="q2" vid="EZK 32:4">സർവ്വഭൂമിയിലെയും മൃഗങ്ങൾക്ക് നിന്നെ ഇരയാക്കി,</para>
  <para style="q2" vid="EZK 32:4">അവയ്ക്ക് തൃപ്തി വരുത്തും.<verse eid="EZK 32:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 32:5" />ഞാൻ നിന്‍റെ മാംസം പർവ്വതങ്ങളിന്മേൽ കൂട്ടി,</para>
  <para style="q2" vid="EZK 32:5">നിന്‍റെ ശരീരാവശിഷ്ടംകൊണ്ട് താഴ്വരകൾ നിറയ്ക്കും.<verse eid="EZK 32:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 32:6" />ഞാൻ കരകളെല്ലാം നിന്‍റെ രക്തംകൊണ്ട്, മലകളോളം നനയ്ക്കും;</para>
  <para style="q2" vid="EZK 32:6">നീർച്ചാലുകൾ നിന്നെക്കൊണ്ടു നിറയും.<verse eid="EZK 32:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 32:7" />നിന്‍റെ വെളിച്ചം കെടുത്തിക്കളയുമ്പോൾ</para>
  <para style="q2" vid="EZK 32:7">ഞാൻ ആകാശത്തെ മൂടി അതിലെ നക്ഷത്രങ്ങളെ ഇരുളടഞ്ഞവയാക്കും;</para>
  <para style="q1" vid="EZK 32:7">ഞാൻ സൂര്യനെ മേഘംകൊണ്ടു മറയ്ക്കും;</para>
  <para style="q2" vid="EZK 32:7">ചന്ദ്രൻ പ്രകാശം നല്കുകയും ഇല്ല.<verse eid="EZK 32:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 32:8" />ആകാശത്തിലെ ശോഭയുള്ള ജ്യോതിസ്സുകളെയെല്ലാം</para>
  <para style="q2" vid="EZK 32:8">നിന്‍റെ നിമിത്തം ഞാൻ ഇരുളടഞ്ഞവയാക്കുകയും,</para>
  <para style="q1" vid="EZK 32:8">നിന്‍റെ ദേശത്ത് അന്ധകാരം വരുത്തുകയും ചെയ്യും”</para>
  <para style="q2" vid="EZK 32:8">എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 32:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="EZK 32:9" />നിന്‍റെ നാശം ജനതകളുടെ ഇടയിലും</para>
  <para style="q2" vid="EZK 32:9">നീ അറിയാത്ത ദേശങ്ങളോളവും പ്രസിദ്ധമാക്കുമ്പോൾ</para>
  <para style="q2" vid="EZK 32:9">ഞാൻ അനേകം ജനതകളുടെ ഹൃദയങ്ങളെ വ്യസനിപ്പിക്കും.<verse eid="EZK 32:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 32:10" />ഞാൻ അനേകം ജനതകളെ നിന്നെച്ചൊല്ലി സ്തംഭിക്കുമാറാക്കും;</para>
  <para style="q2" vid="EZK 32:10">അവരുടെ രാജാക്കന്മാർ കാൺകെ ഞാൻ എന്‍റെ വാൾ വീശുമ്പോൾ,</para>
  <para style="q1" vid="EZK 32:10">അവർ നിന്‍റെ നിമിത്തം അത്യന്തം പേടിച്ചുപോകും;</para>
  <para style="q2" vid="EZK 32:10">നിന്‍റെ വീഴ്ചയുടെ നാളിൽ അവർ ഓരോരുത്തനും</para>
  <para style="q2" vid="EZK 32:10">അവരവരുടെ പ്രാണനെ ഓർത്തു നിമിഷംതോറും വിറയ്ക്കും.”<verse eid="EZK 32:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 32:11" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:</para>
  <para style="q2" vid="EZK 32:11">“ബാബേൽരാജാവിന്‍റെ വാൾ നിന്‍റെനേരെ വരും.<verse eid="EZK 32:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 32:12" />വീരന്മാരുടെ വാൾകൊണ്ടു ഞാൻ നിന്‍റെ പുരുഷാരത്തെ വീഴുമാറാക്കും;</para>
  <para style="q2" vid="EZK 32:12">അവരെല്ലാവരും ജനതകളിൽവച്ച് ഉഗ്രന്മാർ;</para>
  <para style="q1" vid="EZK 32:12">അവർ മിസ്രയീമിന്‍റെ പ്രതാപത്തെ ശൂന്യമാക്കും;</para>
  <para style="q2" vid="EZK 32:12">അതിലെ പുരുഷാരമൊക്കെയും നശിച്ചുപോകും.<verse eid="EZK 32:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 32:13" />സമൃദ്ധമായ ജലാശയത്തിനരികെനിന്നു</para>
  <para style="q2" vid="EZK 32:13">ഞാൻ അതിലെ സകലമൃഗങ്ങളെയും നശിപ്പിക്കും;</para>
  <para style="q1" vid="EZK 32:13">ഇനി മേൽ മനുഷ്യന്‍റെ കാൽ അതിനെ കലക്കുകയില്ല;</para>
  <para style="q2" vid="EZK 32:13">മൃഗങ്ങളുടെ കുളമ്പും അതിനെ കലക്കുകയില്ല.<verse eid="EZK 32:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 32:14" />ആ കാലത്ത് അവരുടെ വെള്ളം തെളിമയുള്ളതാക്കി,</para>
  <para style="q2" vid="EZK 32:14">ഞാൻ അവരുടെ നദികളെ എണ്ണപോലെ ഒഴുകുമാറാക്കും”</para>
  <para style="q2" vid="EZK 32:14">എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 32:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="EZK 32:15" />“ഞാൻ മിസ്രയീമിനെ പാഴാക്കി, ദേശം ശൂന്യമാക്കി,</para>
  <para style="q2" vid="EZK 32:15">അതിലുള്ളതെല്ലാം ഇല്ലാതാകുമ്പോഴും,</para>
  <para style="q1" vid="EZK 32:15">ഞാൻ അതിലെ നിവാസികളെയെല്ലാം നശിപ്പിക്കുമ്പോഴും,</para>
  <para style="q2" vid="EZK 32:15">ഞാൻ യഹോവ എന്നു അവർ അറിയും.<verse eid="EZK 32:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 32:16" />അവർ അതിനെക്കുറിച്ച് വിലപിക്കുന്ന വിലാപം ഇതത്രേ; ജനതകളുടെ പുത്രിമാർ ഇതു ചൊല്ലി വിലപിക്കും; അവർ മിസ്രയീമിങ്കലും അതിലെ സകലപുരുഷന്മാരെക്കുറിച്ചും ഇതു ചൊല്ലി വിലപിക്കും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 32:16" /></para>
  <para style="s">മിസ്രയീമിന്‍റെ പതനം</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 32:17" />പന്ത്രണ്ടാം ആണ്ട്, അതേ മാസം, പതിനഞ്ചാം തീയതി യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ: <verse eid="EZK 32:17" /><verse number="18" style="v" sid="EZK 32:18" />“മനുഷ്യപുത്രാ, നീ മിസ്രയീമിലെ ജനസമൂഹത്തെക്കുറിച്ചു വിലപിച്ച്, അതിനെയും പ്രസിദ്ധമായ ജനതകളുടെ പുത്രിമാരെയും കുഴിയിൽ ഇറങ്ങുന്നവരോടുകൂടെ ഭൂമിയുടെ അധോഭാഗത്തു തള്ളിയിടുക. <verse eid="EZK 32:18" /><verse number="19" style="v" sid="EZK 32:19" />സൗന്ദര്യത്തിൽ നീ ആരെക്കാൾ മെച്ചപ്പെട്ടിരിക്കുന്നു; നീ ഇറങ്ങിച്ചെന്ന് അഗ്രചർമ്മികളുടെ കൂട്ടത്തിൽ കിടക്കുക. <verse eid="EZK 32:19" /><verse number="20" style="v" sid="EZK 32:20" />വാളാൽ കൊല്ലപ്പെട്ടവരുടെ നടുവിൽ അവർ വീഴും; വാൾ നിയമിക്കപ്പെട്ടിരിക്കുന്നു; അതിനെയും അതിന്‍റെ സകലപുരുഷാരത്തെയും വലിച്ചുകൊണ്ടുപോകുവിൻ. <verse eid="EZK 32:20" /><verse number="21" style="v" sid="EZK 32:21" />വീരന്മാരിൽ ബലവാന്മാരായവർ അവന്‍റെ സഹായികളോടുകൂടെ പാതാളത്തിന്‍റെ നടുവിൽനിന്ന് അവനോട് സംസാരിക്കും; അഗ്രചർമ്മികളായി വാളാൽ കൊല്ലപ്പെട്ടവർ ഇറങ്ങിച്ചെന്ന് അവിടെ കിടക്കുന്നു.<verse eid="EZK 32:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 32:22" />അവിടെ അശ്ശൂരും അതിന്‍റെ സർവ്വസമൂഹവും ഉണ്ട്; അവന്‍റെ ശവക്കുഴികൾ അവന്‍റെ ചുറ്റും കിടക്കുന്നു; അവരെല്ലാവരും വാളാൽ കൊല്ലപ്പെട്ടവരായി വീണവർ തന്നെ. <verse eid="EZK 32:22" /><verse number="23" style="v" sid="EZK 32:23" />അവരുടെ ശവക്കുഴികൾ പാതാളത്തിന്‍റെ ഏറ്റവും അടിയിൽ സ്ഥിതിചെയ്യുന്നു; അതിന്‍റെ സമൂഹം അതിന്‍റെ ശവക്കുഴിയുടെ ചുറ്റും ഇരിക്കുന്നു; ജീവനുള്ളവരുടെ ദേശത്തു ഭീതിപരത്തിയ, അവരെല്ലാവരും വാളാൽ കൊല്ലപ്പെട്ടവരായി വീണിരിക്കുന്നു.<verse eid="EZK 32:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 32:24" />അവിടെ ഏലാമും അതിന്‍റെ സകലപുരുഷാരവും അതിന്‍റെ ശവക്കുഴിയുടെ ചുറ്റും ഉണ്ട്; അവർ എല്ലാവരും വാളാൽ കൊല്ലപ്പെട്ടവരായി വീണ്, അഗ്രചർമ്മികളായി, ഭൂമിയുടെ അധോഭാഗത്ത് ഇറങ്ങിപ്പോയിരിക്കുന്നു; ജീവനുള്ളവരുടെ ദേശത്ത് അവർ ഭീതി പരത്തി; ഇപ്പോൾ കുഴിയിൽ ഇറങ്ങുന്നവരോടുകൂടെ അവർ ലജ്ജ വഹിക്കുന്നു. <verse eid="EZK 32:24" /><verse number="25" style="v" sid="EZK 32:25" />കൊല്ലപ്പെട്ടവരുടെ മദ്ധ്യേ അവർ അതിനും അതിന്‍റെ സകലപുരുഷാരത്തിനും ഒരു കിടക്ക വിരിച്ചിരിക്കുന്നു; അതിന്‍റെ ശവക്കുഴികൾ അതിന്‍റെ ചുറ്റും ഇരിക്കുന്നു; അവരെല്ലാവരും അഗ്രചർമ്മികളായി വാളാൽ കൊല്ലപ്പെട്ടവരാകുന്നു; ജീവനുള്ളവരുടെ ദേശത്ത് അവർ ഭീതി പരത്തിയിരിക്കുകയാൽ കുഴിയിൽ ഇറങ്ങുന്നവരോടുകൂടെ ലജ്ജ വഹിക്കുന്നു; കൊല്ലപ്പെട്ടവരുടെ മദ്ധ്യത്തിൽ അത് കിടക്കുന്നു.<verse eid="EZK 32:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 32:26" />അവിടെ മേശെക്കും തൂബലും അതിന്‍റെ സകലപുരുഷാരവും ഉണ്ട്; അതിന്‍റെ ശവക്കുഴികൾ അതിന്‍റെ ചുറ്റും സ്ഥിതിചെയ്യുന്നു; അവർ ജീവനുള്ളവരുടെ ദേശത്ത് ഭീതി പരത്തിയിരിക്കുകയാൽ അവരെല്ലാം അഗ്രചർമ്മികളായി വാളാൽ കൊല്ലപ്പെട്ടിരിക്കുന്നു. <verse eid="EZK 32:26" /><verse number="27" style="v" sid="EZK 32:27" />അവർ ജീവനുള്ളവരുടെ ദേശത്ത് വീരന്മാർക്കു ഭീതി ആയിരുന്നതുകൊണ്ട്, അവരുടെ അകൃത്യങ്ങൾ അസ്ഥികളിന്മേൽ ചുമന്നും, അവരുടെ വാളുകൾ തലയ്ക്കു കീഴിൽ വച്ചുംകൊണ്ട്, അഗ്രചർമ്മികളിൽ പട്ടുപോയ വീരന്മാരായി യുദ്ധായുധങ്ങളോടുകൂടെ പാതാളത്തിൽ ഇറങ്ങിയവരുടെ കൂട്ടത്തിൽ കിടക്കേണ്ടതല്ലയോ?<verse eid="EZK 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 32:28" />”നീയോ, അഗ്രചർമ്മികളുടെ കൂട്ടത്തിൽ തകർന്നുപോകുകയും വാളാൽ കൊല്ലപ്പെട്ടവരോടുകൂടെ കിടക്കുകയും ചെയ്യും.<verse eid="EZK 32:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EZK 32:29" />”അവിടെ ഏദോമും അതിന്‍റെ രാജാക്കന്മാരും സകലപ്രഭുക്കന്മാരും ഉണ്ട്; അവർ അവരുടെ വല്ലഭത്വത്തിൽ വാളാൽ കൊല്ലപ്പെട്ടവരുടെ കൂട്ടത്തിൽ കിടക്കേണ്ടിവന്നു; അവർ അഗ്രചർമ്മികളോടും, കുഴിയിൽ ഇറങ്ങുന്നവരോടും കൂടി കിടക്കുന്നു.<verse eid="EZK 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 32:30" />”അവിടെ വടക്കെ പ്രഭുക്കന്മാരെല്ലാവരും കൊല്ലപ്പെട്ടവരോടുകൂടെ ഇറങ്ങിപ്പോയ സകല സീദോന്യരും ഉണ്ട്; അവർ അവരുടെ ആധിപത്യം മൂലം പരത്തിയ ഭീതിനിമിത്തം ലജ്ജിക്കുന്നു; അവർ അഗ്രചർമ്മികളായി വാളാൽ കൊല്ലപ്പെട്ടവരോടുകൂടെ കിടക്കുകയും കുഴിയിൽ ഇറങ്ങുന്നവരോടുകൂടെ ലജ്ജ വഹിക്കുകയും ചെയ്യുന്നു.<verse eid="EZK 32:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EZK 32:31" />”അവരെ ഫറവോൻ കണ്ടു തന്‍റെ സകലപുരുഷാരത്തെയും കുറിച്ച് ആശ്വസിക്കും; ഫറവോനും അവന്‍റെ സകലസൈന്യവും വാളാൽ കൊല്ലപ്പെട്ടവരായിരിക്കുന്നു” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു. <verse eid="EZK 32:31" /><verse number="32" style="v" sid="EZK 32:32" />“ഞാനല്ലയോ അവന്‍റെ ഭീതി ജീവനുള്ളവരുടെ ദേശത്തു പരത്തിയത്; ഫറവോനും അവന്‍റെ പുരുഷാരമെല്ലാം വാളാൽ കൊല്ലപ്പെട്ടവരോടുകൂടി അഗ്രചർമ്മികളുടെ കൂട്ടത്തിൽ കിടക്കേണ്ടിവരും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 32:32" /></para>
  <chapter eid="EZK 32" />
  <chapter number="33" style="c" sid="EZK 33" />
  <para style="s">യെഹെസ്കേൽ ഒരു കാവല്ക്കാരൻ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 33:1" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായത് എന്തെന്നാൽ; <verse eid="EZK 33:1" /><verse number="2" style="v" sid="EZK 33:2" />“മനുഷ്യപുത്രാ, നീ നിന്‍റെ സ്വജാതിക്കാരോടു പ്രവചിച്ച് പറയേണ്ടത്: ‘ഞാൻ ഒരു ദേശത്തിന്‍റെ നേരെ വാൾ വരുത്തുമ്പോൾ, ആ ദേശത്തിലെ ജനം അവരുടെ കൂട്ടത്തിൽനിന്ന് ഒരു പുരുഷനെ തിരഞ്ഞെടുത്ത് കാവല്ക്കാരനായിവച്ചാൽ, <verse eid="EZK 33:2" /><verse number="3" style="v" sid="EZK 33:3" />ദേശത്തിന്‍റെ നേരെ വാൾ വരുന്നത് കണ്ടിട്ട് അവൻ കാഹളം ഊതി ജനത്തെ ഓർമ്മപ്പെടുത്തുമ്പോൾ, <verse eid="EZK 33:3" /><verse number="4" style="v" sid="EZK 33:4" />ആരെങ്കിലും കാഹളനാദം കേട്ടു കരുതിക്കൊള്ളാതെ ഇരുന്നാൽ, വാൾ വന്ന് അവനെ ഛേദിച്ചുകളയുന്നു എങ്കിൽ അവന്‍റെ രക്തം അവന്‍റെ തലമേൽ തന്നെ ഇരിക്കും. <verse eid="EZK 33:4" /><verse number="5" style="v" sid="EZK 33:5" />അവൻ കാഹളനാദം കേട്ടിട്ടു മുൻകരുതൽ എടുക്കാതെയിരുന്നതിനാൽ അവന്‍റെ രക്തം അവന്‍റെമേൽ ഇരിക്കും; മുൻകരുതൽ എടുത്തിരുന്നുവെങ്കിൽ അവൻ തന്‍റെ പ്രാണനെ രക്ഷിക്കുമായിരുന്നു. <verse eid="EZK 33:5" /><verse number="6" style="v" sid="EZK 33:6" />എന്നാൽ കാവല്ക്കാരൻ വാൾ വരുന്നത് കണ്ടു കാഹളം ഊതാതെയും ജനം കരുതിക്കൊള്ളാതെയും ഇരുന്നിട്ട്, വാൾ വന്ന് അവരുടെ ഇടയിൽനിന്ന് ഒരുവനെ ഛേദിച്ചുകളയുന്നു എങ്കിൽ, ഇവൻ തന്‍റെ അകൃത്യം നിമിത്തം ഛേദിക്കപ്പെട്ടുപോയി എങ്കിലും, അവന്‍റെ രക്തം ഞാൻ കാവല്ക്കാരനോടു ചോദിക്കും.<verse eid="EZK 33:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 33:7" />“അതുപോലെ മനുഷ്യപുത്രാ, ഞാൻ നിന്നെ യിസ്രായേൽ ഗൃഹത്തിനു കാവല്ക്കാരനാക്കി വച്ചിരിക്കുന്നു, നീ എന്‍റെ വായിൽനിന്നു വചനം കേട്ടു എന്‍റെ നാമത്തിൽ അവരെ ഓർമ്മപ്പെടുത്തേണം. <verse eid="EZK 33:7" /><verse number="8" style="v" sid="EZK 33:8" />ഞാൻ ദുഷ്ടനോട്: ‘ദുഷ്ടാ, നീ മരിക്കും’ എന്നു കല്പിക്കുമ്പോൾ ദുഷ്ടൻ തന്‍റെ വഴി വിട്ടുതിരിയുവാൻ തക്കവിധം നീ അവനെ പ്രബോധിപ്പിക്കാതെയിരുന്നാൽ ദുഷ്ടൻ തന്‍റെ അകൃത്യം നിമിത്തം മരിക്കും; അവന്‍റെ രക്തമോ ഞാൻ നിന്നോട് ചോദിക്കും. <verse eid="EZK 33:8" /><verse number="9" style="v" sid="EZK 33:9" />എന്നാൽ ദുഷ്ടൻ തന്‍റെ വഴി വിട്ടുതിരിയേണ്ടതിന് നീ അവനെ ഓർമ്മപ്പെടുത്തിയിട്ടും, അവൻ തന്‍റെ വഴി വിട്ടുതിരിയാതെയിരുന്നാൽ, അവൻ തന്‍റെ അകൃത്യം നിമിത്തം മരിക്കും; നീയോ, നിന്‍റെ പ്രാണനെ രക്ഷിച്ചിരിക്കുന്നു.<verse eid="EZK 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 33:10" />“അതുകൊണ്ട് മനുഷ്യപുത്രാ, നീ യിസ്രായേൽ ഗൃഹത്തോട് പറയേണ്ടത്: ‘ഞങ്ങളുടെ അതിക്രമങ്ങളും പാപങ്ങളും ഞങ്ങളുടെമേൽ ഇരിക്കുന്നു; അവയാൽ ഞങ്ങൾ ക്ഷയിച്ചുപോകുന്നു; ഞങ്ങൾ എങ്ങനെ ജീവിച്ചിരിക്കും’ എന്നു നിങ്ങൾ പറയുന്നു. <verse eid="EZK 33:10" /><verse number="11" style="v" sid="EZK 33:11" />എന്നാണ, ദുഷ്ടന്‍റെ മരണത്തിൽ അല്ല, ദുഷ്ടൻ തന്‍റെ വഴി വിട്ടുതിരിഞ്ഞു ജീവിക്കുന്നതിൽ ആകുന്നു എനിക്ക് ഇഷ്ടമുള്ളത്” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു; “തിരിയുവിൻ, നിങ്ങളുടെ ദുർമ്മാർഗ്ഗങ്ങളെ വിട്ടുതിരിയുവിൻ; യിസ്രായേൽ ഗൃഹമേ, നിങ്ങൾ എന്തിന് മരിക്കുന്നു” എന്നു അവരോടു പറയുക.<verse eid="EZK 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 33:12" />“അതുകൊണ്ട് മനുഷ്യപുത്രാ, നീ നിന്‍റെ സ്വജാതിക്കാരോടു പറയേണ്ടത് ‘നീതിമാൻ അതിക്രമം ചെയ്യുന്ന നാളിൽ അവന്‍റെ നീതി അവനെ രക്ഷിക്കുകയില്ല; ദുഷ്ടൻ തന്‍റെ ദുഷ്ടത വിട്ടുതിരിയുന്ന നാളിൽ തന്‍റെ ദുഷ്ടതയാൽ ഇടറിവീഴുകയുമില്ല; നീതിമാൻ പാപം ചെയ്യുന്ന നാളിൽ, അവന് തന്‍റെ നീതിയാൽ ജീവിക്കുവാൻ കഴിയുകയുമില്ല. <verse eid="EZK 33:12" /><verse number="13" style="v" sid="EZK 33:13" />നീതിമാൻ ജീവിക്കുമെന്ന് ഞാൻ അവനോട് പറയുമ്പോൾ, അവൻ സ്വന്ത നീതിയിൽ ആശ്രയിച്ച് അകൃത്യം പ്രവർത്തിക്കുന്നു എങ്കിൽ, അവന്‍റെ നീതിപ്രവൃത്തികൾ ഒന്നും അവനു കണക്കിടുകയില്ല; അവൻ ചെയ്ത നീതികേടുനിമിത്തം അവൻ മരിക്കും. <verse eid="EZK 33:13" /><verse number="14" style="v" sid="EZK 33:14" />എന്നാൽ ഞാൻ ദുഷ്ടനോട്: ‘നീ മരിക്കും’ എന്നു പറയുമ്പോൾ അവൻ തന്‍റെ പാപം വിട്ടുതിരിഞ്ഞ് നീതിയും ന്യായവും പ്രവർത്തിക്കുകയും, <verse eid="EZK 33:14" /><verse number="15" style="v" sid="EZK 33:15" />പണയം തിരികെ കൊടുക്കുകയും, അപഹരിച്ചതു മടക്കിക്കൊടുക്കുകയും, നീതികേട് ഒന്നും ചെയ്യാതെ ജീവന്‍റെ ചട്ടങ്ങളെ അനുസരിക്കുകയും ചെയ്താൽ അവൻ മരിക്കാതെ ജീവിക്കും. <verse eid="EZK 33:15" /><verse number="16" style="v" sid="EZK 33:16" />അവൻ ചെയ്ത പാപം ഒന്നും അവനോട് കണക്കിടുകയില്ല; അവൻ നീതിയും ന്യായവും പ്രവർത്തിച്ചിരിക്കുന്നു; അവൻ ജീവിക്കും.<verse eid="EZK 33:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 33:17" />“എന്നാൽ നിന്‍റെ സ്വജാതിക്കാർ: ‘കർത്താവിന്‍റെ വഴി ന്യായമുള്ളതല്ല’ എന്നു പറയുന്നു; അവരുടെ വഴിയത്രേ ന്യായമല്ലാത്തതായിരിക്കുന്നത്. <verse eid="EZK 33:17" /><verse number="18" style="v" sid="EZK 33:18" />നീതിമാൻ തന്‍റെ നീതി വിട്ടുതിരിഞ്ഞ് നീതികേട് പ്രവർത്തിക്കുന്നുവെങ്കിൽ അവൻ അതിനാൽ തന്നെ മരിക്കും. <verse eid="EZK 33:18" /><verse number="19" style="v" sid="EZK 33:19" />എന്നാൽ ദുഷ്ടൻ തന്‍റെ ദുഷ്ടത വിട്ടുതിരിഞ്ഞ് നീതിയും ന്യായവും പ്രവർത്തിക്കുന്നുവെങ്കിൽ അവൻ അതിനാൽ ജീവിക്കും. <verse eid="EZK 33:19" /><verse number="20" style="v" sid="EZK 33:20" />എന്നിട്ടും ‘കർത്താവിന്‍റെ വഴി ന്യായമുള്ളതല്ല’ എന്നു നിങ്ങൾ പറയുന്നു; യിസ്രായേൽ ഗൃഹമേ, ഞാൻ നിങ്ങളിൽ ഓരോരുത്തനെയും അവനവന്‍റെ നടപ്പിനു തക്കവണ്ണം ന്യായംവിധിക്കും.”<verse eid="EZK 33:20" /></para>
  <para style="s">യെരൂശലേമിന്‍റെ പതനം വിശദീകരിക്കുന്നു</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 33:21" />ഞങ്ങളുടെ പ്രവാസത്തിന്‍റെ പന്ത്രണ്ടാം ആണ്ട്, പത്താം മാസം, അഞ്ചാം തീയതി, യെരൂശലേമിൽ നിന്നു രക്ഷപെട്ട ഒരുവൻ എന്‍റെ അടുക്കൽ വന്നു: “നഗരം പിടിക്കപ്പെട്ടുപോയി” എന്നു പറഞ്ഞു. <verse eid="EZK 33:21" /><verse number="22" style="v" sid="EZK 33:22" />രക്ഷപെട്ടവൻ വരുന്നതിൻ്റെ തലേദിവസം വൈകുന്നേരം യഹോവയുടെ കൈ എന്‍റെ മേൽ വന്നു; രാവിലെ അവൻ എന്‍റെ അടുക്കൽ വരുമ്പോഴേക്ക് യഹോവ എന്‍റെ വായ് തുറന്നിരുന്നു; അങ്ങനെ എന്‍റെ വായ് തുറന്നതുകൊണ്ട് ഞാൻ പിന്നെ മൗനമായിരുന്നില്ല.<verse eid="EZK 33:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 33:23" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ: “മനുഷ്യപുത്രാ, <verse eid="EZK 33:23" /><verse number="24" style="v" sid="EZK 33:24" />യിസ്രായേൽദേശത്തിലെ ശൂന്യസ്ഥലങ്ങളിൽ വസിക്കുന്നവർ: ‘അബ്രാഹാം ഏകനായിരിക്കെ അവനു ദേശം അവകാശമായി ലഭിച്ചു; ഞങ്ങൾ പലരാകുന്നു; ഈ ദേശം ഞങ്ങൾക്ക് അവകാശമായി നൽകപ്പെട്ടിരിക്കുന്നു’ എന്നു പറയുന്നു. <verse eid="EZK 33:24" /><verse number="25" style="v" sid="EZK 33:25" />അതുകൊണ്ട് നീ അവരോടു പറയേണ്ടത്: യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “നിങ്ങൾ മാംസം രക്തത്തോടുകൂടി തിന്നുകയും നിങ്ങളുടെ വിഗ്രഹങ്ങളെ നോക്കി നമസ്കരിക്കുകയും രക്തം ചൊരിയുകയും ചെയ്യുന്നു; <verse eid="EZK 33:25" /><verse number="26" style="v" sid="EZK 33:26" />നിങ്ങൾ ദേശം കൈവശമാക്കുമോ? നിങ്ങൾ നിങ്ങളുടെ വാളിൽ ആശ്രയിക്കുകയും മ്ലേച്ഛത പ്രവർത്തിക്കുകയും ഓരോരുത്തനും തന്‍റെ കൂട്ടുകാരന്‍റെ ഭാര്യയെ വഷളാക്കുകയും ചെയ്യുന്നു; നിങ്ങൾ ദേശം കൈവശമാക്കുമോ?”<verse eid="EZK 33:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EZK 33:27" />നീ അവരോടു പറയേണ്ടത്: യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “എന്നാണ, ശൂന്യസ്ഥലങ്ങളിൽ പാർക്കുന്നവർ വാൾകൊണ്ടു വീഴും; വെളിമ്പ്രദേശത്തുള്ളവരെ ഞാൻ മൃഗങ്ങൾക്ക് ഇരയായി കൊടുക്കും; കോട്ടകളിലും ഗുഹകളിലും ഉള്ളവരോ പകർച്ചവ്യാധിയാൽ മരിക്കും. <verse eid="EZK 33:27" /><verse number="28" style="v" sid="EZK 33:28" />ഞാൻ ദേശത്തെ പാഴും ശൂന്യവും ആക്കും; അതിന്‍റെ ബലത്തിന്‍റെ പ്രതാപം നിന്നുപോകും; ആരും വഴിനടക്കാത്തവണ്ണം യിസ്രായേൽപർവ്വതങ്ങൾ ശൂന്യമായിത്തീരും. <verse eid="EZK 33:28" /><verse number="29" style="v" sid="EZK 33:29" />അവർ ചെയ്ത സകലമ്ലേച്ഛതകളും നിമിത്തം ഞാൻ ദേശത്തെ പാഴും ശൂന്യവുമാക്കുമ്പോൾ, ഞാൻ യഹോവ എന്നു അവർ അറിയും.<verse eid="EZK 33:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 33:30" />മനുഷ്യപുത്രാ, നിന്‍റെ സ്വജാതിക്കാർ മതിലുകൾക്കരികിലും വീട്ടുവാതില്‍ക്കലും വച്ചു നിന്നെക്കുറിച്ച് സംഭാഷിച്ച്: ‘യഹോവയിൽ നിന്നുണ്ടായ അരുളപ്പാടു എന്തെന്ന് വന്നു കേൾക്കുവിൻ’ എന്നു തമ്മിൽതമ്മിലും ഓരോരുത്തൻ അവനവന്‍റെ സഹോദരനോടും പറയുന്നു. <verse eid="EZK 33:30" /><verse number="31" style="v" sid="EZK 33:31" />സംഘം കൂടിവരുന്നതുപോലെ അവർ നിന്‍റെ അടുക്കൽവന്ന് എന്‍റെ ജനമായിട്ട് നിന്‍റെ മുമ്പിൽ ഇരുന്ന് നിന്‍റെ വചനങ്ങൾ കേൾക്കുന്നു; എന്നാൽ അവർ അവ പ്രമാണിക്കുന്നില്ല; വായ്കൊണ്ട് അവർ വളരെ സ്നേഹം കാണിക്കുന്നു; ഹൃദയമോ, അന്യായലാഭം കൊതിക്കുന്നു. <verse eid="EZK 33:31" /><verse number="32" style="v" sid="EZK 33:32" />നീ അവർക്ക് മധുരസ്വരവും വാദ്യനൈപുണ്യവും ഉള്ള ഒരുവന്‍റെ പ്രേമഗീതംപോലെ ഇരിക്കുന്നു; അവർ നിന്‍റെ വചനങ്ങൾ കേൾക്കുന്നു; അനുസരിക്കുന്നില്ലതാനും. <verse eid="EZK 33:32" /><verse number="33" style="v" sid="EZK 33:33" />എന്നാൽ അത് സംഭവിക്കുമ്പോൾ - ഇതാ, അത് വരുന്നു - അവരുടെ ഇടയിൽ ഒരു പ്രവാചകൻ ഉണ്ടായിരുന്നു. എന്നു അവർ അറിയും.”<verse eid="EZK 33:33" /></para>
  <chapter eid="EZK 33" />
  <chapter number="34" style="c" sid="EZK 34" />
  <para style="s">യിസ്രായേലിന്‍റെ ഇടയന്മാർ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 34:1" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായത് എന്തെന്നാൽ: <verse eid="EZK 34:1" /><verse number="2" style="v" sid="EZK 34:2" />“മനുഷ്യപുത്രാ, യിസ്രായേലിന്‍റെ ഇടയന്മാരെക്കുറിച്ചു പ്രവചിക്കുക; നീ പ്രവചിച്ച് അവരോട്, ഇടയന്മാരോടു തന്നെ, പറയേണ്ടത്: ‘യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: അവരവരെത്തന്നെ മേയിക്കുന്ന യിസ്രായേലിന്‍റെ ഇടയന്മാർക്ക് അയ്യോ കഷ്ടം! ആടുകളെ അല്ലയോ ഇടയന്മാർ മേയിക്കേണ്ടത്? <verse eid="EZK 34:2" /><verse number="3" style="v" sid="EZK 34:3" />നിങ്ങൾ മേദസ്സ് തിന്നുകയും ആട്ടുരോമം ധരിക്കുകയും തടിച്ചിരിക്കുന്നവയെ അറുക്കുകയും ചെയ്യുന്നു; ആടുകളെ നിങ്ങൾ മേയിക്കുന്നില്ലതാനും. <verse eid="EZK 34:3" /><verse number="4" style="v" sid="EZK 34:4" />നിങ്ങൾ ബലഹീനമായതിനെ ശക്തീകരിക്കുകയോ രോഗം ബാധിച്ചതിനെ ചികിത്സിക്കുകയോ ഒടിഞ്ഞതിനെ മുറിവുകെട്ടുകയോ ചിതറിപ്പോയതിനെ തിരിച്ചുവരുത്തുകയോ കാണാതെപോയതിനെ അന്വേഷിക്കുകയോ ചെയ്യാതെ, കഠിനതയോടും ക്രൂരതയോടും കൂടെ അവയെ ഭരിച്ചിരിക്കുന്നു. <verse eid="EZK 34:4" /><verse number="5" style="v" sid="EZK 34:5" />ഇടയൻ ഇല്ലാതിരിക്കുകയാൽ അവ ചിതറിപ്പോയി; ചിതറിപ്പോയിട്ട് അവ കാട്ടിലെ സകലമൃഗങ്ങൾക്കും ഇരയായിത്തീർന്നു. <verse eid="EZK 34:5" /><verse number="6" style="v" sid="EZK 34:6" />എന്‍റെ ആടുകൾ എല്ലാമലകളിലും ഉയരമുള്ള എല്ലാ കുന്നിന്മേലും അലഞ്ഞുനടന്നു; ഭൂതലത്തിൽ എല്ലായിടവും എന്‍റെ ആടുകൾ ചിതറിപ്പോയി; ആരും അവയെ തിരയുകയോ അന്വേഷിക്കുകയോ ചെയ്തിട്ടില്ല.<verse eid="EZK 34:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 34:7" />“അതുകൊണ്ട് ഇടയന്മാരേ, യഹോവയുടെ വചനം കേൾക്കുവിൻ; <verse eid="EZK 34:7" /><verse number="8" style="v" sid="EZK 34:8" />എന്നാണ, ഇടയനില്ലാഞ്ഞതിനാലാകുന്നു എന്‍റെ ആടുകൾ കവർച്ചയായിപ്പോകുകയും, കാട്ടിലെ സകലമൃഗത്തിനും ഇരയായിത്തീരുകയും ചെയ്തത്” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു; എന്‍റെ ഇടയന്മാർ എന്‍റെ ആടുകളെ അന്വേഷിക്കാതെ അവരവരെത്തന്നെ മേയിക്കുകയും ആടുകളെ മേയിക്കാതെയിരിക്കുകയും ചെയ്യുകകൊണ്ട്, <verse eid="EZK 34:8" /><verse number="9" style="v" sid="EZK 34:9" />ഇടയന്മാരേ, യഹോവയുടെ വചനം കേൾക്കുവിൻ: <verse eid="EZK 34:9" /><verse number="10" style="v" sid="EZK 34:10" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: ‘ഞാൻ ഇടയന്മാർക്കു വിരോധമായിരിക്കുന്നു; ഞാൻ എന്‍റെ ആടുകളെ അവരുടെ കയ്യിൽനിന്നു ചോദിച്ച്, ആടുകളെ മേയിക്കുന്ന വേലയിൽനിന്ന് അവരെ നീക്കിക്കളയും; ഇടയന്മാർ ഇനി തങ്ങളെത്തന്നെ മേയിക്കുകയില്ല; എന്‍റെ ആടുകൾ അവർക്ക് ഇരയാകാതെയിരിക്കേണ്ടതിന് ഞാൻ അവയെ അവരുടെ വായിൽനിന്നു വിടുവിക്കും.”<verse eid="EZK 34:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 34:11" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഞാൻ തന്നെ എന്‍റെ ആടുകളെ അന്വേഷിച്ചുകണ്ടെത്തും. <verse eid="EZK 34:11" /><verse number="12" style="v" sid="EZK 34:12" />ഒരു ഇടയൻ ചിതറിപ്പോയിരിക്കുന്ന തന്‍റെ ആടുകളുടെ ഇടയിൽ ഇരിക്കുന്ന നാളിൽ, തന്‍റെ ആട്ടിൻകൂട്ടത്തെ അന്വേഷിക്കുന്നതുപോലെ ഞാൻ എന്‍റെ ആടുകളെ അന്വേഷിച്ച്, കാർമേഘവും അന്ധകാരവുമുള്ള ദിവസത്തിൽ, അവ ചിതറിപ്പോയ സകലസ്ഥലങ്ങളിലുംനിന്ന് അവയെ വിടുവിക്കും. <verse eid="EZK 34:12" /><verse number="13" style="v" sid="EZK 34:13" />ഞാൻ അവയെ ജനതകളുടെ ഇടയിൽനിന്ന് പുറപ്പെടുവിച്ച്, ദേശങ്ങളിൽ നിന്നു ശേഖരിച്ച്, സ്വദേശത്ത് കൊണ്ടുവന്ന്, യിസ്രായേൽമലകളിലും നദീതീരങ്ങളിലും ദേശത്തിലെ സകലവാസസ്ഥലങ്ങളിലും മേയിക്കും. <verse eid="EZK 34:13" /><verse number="14" style="v" sid="EZK 34:14" />നല്ല മേച്ചിൽപുറത്തു ഞാൻ അവയെ മേയിക്കും; യിസ്രായേലിന്‍റെ ഉയർന്ന മലകളിൽ അവ കിടക്കും; അവിടെ അവ നല്ല തൊഴുത്തുകളിൽ കിടക്കുകയും യിസ്രായേൽമലകളിലെ പുഷ്ടിയുള്ള മേച്ചിൽപുറത്തു മേയുകയും ചെയ്യും. <verse eid="EZK 34:14" /><verse number="15" style="v" sid="EZK 34:15" />ഞാൻ തന്നെ എന്‍റെ ആടുകളെ മേയിക്കുകയും കിടത്തുകയും ചെയ്യും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു. <verse eid="EZK 34:15" /><verse number="16" style="v" sid="EZK 34:16" />“കാണാതെപോയതിനെ ഞാൻ അന്വേഷിക്കുകയും, ഓടിച്ചുകളഞ്ഞതിനെ തിരിച്ചുവരുത്തുകയും, ഒടിഞ്ഞതിനെ മുറിവുകെട്ടുകയും, രോഗം ബാധിച്ചതിനെ ശക്തീകരിക്കുകയും ചെയ്യും; എന്നാൽ കൊഴുത്തതിനെയും കരുത്തുള്ളതിനെയും ഞാൻ നശിപ്പിക്കും; ഞാൻ ന്യായത്തോടെ അവയെ മേയിക്കും.<verse eid="EZK 34:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 34:17" />”നിങ്ങളോ, എന്‍റെ ആടുകളേ,” യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഞാൻ ആടിനും ആടിനും നടുവിലും ആട്ടുകൊറ്റന്മാർക്കും കോലാട്ടുകൊറ്റന്മാർക്കും നടുവിലും ന്യായം വിധിക്കുന്നു. <verse eid="EZK 34:17" /><verse number="18" style="v" sid="EZK 34:18" />നിങ്ങൾ നല്ല സ്ഥലത്തു മേഞ്ഞശേഷം, മേച്ചിലിൻ്റെ ശേഷിപ്പ് കാൽ കൊണ്ടു ചവിട്ടിക്കളയുന്നതും, തെളിഞ്ഞവെള്ളം കുടിച്ചിട്ട് ശേഷിപ്പുള്ളത് കാൽ കൊണ്ടു കലക്കിക്കളയുന്നതും നിങ്ങൾക്ക് പോരായോ? <verse eid="EZK 34:18" /><verse number="19" style="v" sid="EZK 34:19" />നിങ്ങൾ കാൽ കൊണ്ടു ചവിട്ടിയത് എന്‍റെ ആടുകൾ തിന്നുകയും, നിങ്ങൾ കാൽ കൊണ്ടു കലക്കിയത് അവ കുടിക്കുകയും ചെയ്യണമോ?”<verse eid="EZK 34:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 34:20" />”അതുകൊണ്ട് യഹോവയായ കർത്താവ് അവയോട് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഞാൻ തന്നെ തടിച്ച ആടുകൾക്കും മെലിഞ്ഞ ആടുകൾക്കും മദ്ധ്യത്തിൽ ന്യായംവിധിക്കും. <verse eid="EZK 34:20" /><verse number="21" style="v" sid="EZK 34:21" />രോഗം ബാധിച്ചവയെ പാർശ്വംകൊണ്ടും തോൾകൊണ്ടും ഉന്തിയും, കൊമ്പുകൊണ്ട് ഇടിച്ചും അവയെ ചുറ്റും ചിതറിക്കുന്നതിനാൽ, <verse eid="EZK 34:21" /><verse number="22" style="v" sid="EZK 34:22" />ഞാൻ എന്‍റെ ആട്ടിൻകൂട്ടത്തെ രക്ഷിക്കും; അവ ഇനി ഇരയായിത്തീരുകയില്ല; ഞാൻ ആടിനും ആടിനും മദ്ധ്യത്തിൽ ന്യായംവിധിക്കും. <verse eid="EZK 34:22" /><verse number="23" style="v" sid="EZK 34:23" />അവയെ മേയിക്കേണ്ടതിന് ഞാൻ ഒരു ഇടയനെ അവക്കായി നിയമിക്കും; എന്‍റെ ദാസനായ ദാവീദിനെ തന്നെ; അവൻ അവയെ മേയിച്ച്, അവയ്ക്ക് ഇടയനായിരിക്കും. <verse eid="EZK 34:23" /><verse number="24" style="v" sid="EZK 34:24" />അങ്ങനെ യഹോവയായ ഞാൻ അവർക്ക് ദൈവവും എന്‍റെ ദാസനായ ദാവീദ് അവരുടെ മദ്ധ്യത്തിൽ പ്രഭുവും ആയിരിക്കും; യഹോവയായ ഞാൻ അത് അരുളിച്ചെയ്തിരിക്കുന്നു.<verse eid="EZK 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 34:25" />”ഞാൻ അവയോട് ഒരു സമാധാനനിയമം ചെയ്തു ദുഷ്ടമൃഗങ്ങളെ ദേശത്തുനിന്ന് നീക്കിക്കളയും; അങ്ങനെ അവ മരുഭൂമിയിൽ നിർഭയമായി വസിക്കുകയും കാടുകളിൽ ഉറങ്ങുകയും ചെയ്യും. <verse eid="EZK 34:25" /><verse number="26" style="v" sid="EZK 34:26" />ഞാൻ അവയെയും എന്‍റെ കുന്നിനു ചുറ്റുമുള്ള സ്ഥലങ്ങളും ഒരു അനുഗ്രഹമാക്കിവെക്കും; ഞാൻ തക്ക സമയത്തു മഴപെയ്യിക്കും; അത് അനുഗ്രഹകരമായ മഴ ആയിരിക്കും. <verse eid="EZK 34:26" /><verse number="27" style="v" sid="EZK 34:27" />വയലിലെ വൃക്ഷം ഫലം കായിക്കുകയും നിലം നന്നായി വിളയുകയും അവർ അവരുടെ ദേശത്ത് നിർഭയമായി വസിക്കുകയും ഞാൻ അവരുടെ നുകബന്ധനങ്ങൾ പൊട്ടിച്ച്, അവരെക്കൊണ്ടു പണി എടുപ്പിച്ചവരുടെ കയ്യിൽനിന്ന് അവരെ വിടുവിക്കുകയും ചെയ്യുമ്പോൾ ഞാൻ യഹോവ എന്നു അവർ അറിയും. <verse eid="EZK 34:27" /><verse number="28" style="v" sid="EZK 34:28" />അവർ ഇനി ജനതകൾക്കു കവർച്ച ആയിത്തീരുകയില്ല; കാട്ടുമൃഗം അവരെ കടിച്ചു കീറുകയില്ല; അവർ നിർഭയമായി വസിക്കും; ആരും അവരെ ഭയപ്പെടുത്തുകയുമില്ല. <verse eid="EZK 34:28" /><verse number="29" style="v" sid="EZK 34:29" />വിളവുകൾക്ക് പ്രശസ്തമായൊരു തോട്ടം ഞാൻ അവർക്ക് നട്ടുണ്ടാക്കും; അവർ ഇനി ദേശത്തു പട്ടിണി കിടന്നു നശിക്കുകയില്ല; ജനതകളുടെ നിന്ദ ഇനി വഹിക്കുകയുമില്ല. <verse eid="EZK 34:29" /><verse number="30" style="v" sid="EZK 34:30" />ഇങ്ങനെ അവരുടെ ദൈവമായ യഹോവ എന്ന ഞാൻ അവരോടുകൂടെ ഉണ്ടെന്നും, യിസ്രായേൽഗൃഹമായിരിക്കുന്ന അവർ എന്‍റെ ജനമാകുന്നു എന്നും അവർ അറിയും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്. <verse eid="EZK 34:30" /><verse number="31" style="v" sid="EZK 34:31" />“എന്നാൽ എന്‍റെ മേച്ചിൽപുറത്തെ ആടുകളായ, എന്‍റെ ആടുകളേ, നിങ്ങൾ മനുഷ്യരത്രേ; ഞാനോ നിങ്ങളുടെ ദൈവം” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 34:31" /></para>
  <chapter eid="EZK 34" />
  <chapter number="35" style="c" sid="EZK 35" />
  <para style="s">ഏദോമിനെതിരേയുള്ള പ്രവചനം</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 35:1" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ: <verse eid="EZK 35:1" /><verse number="2" style="v" sid="EZK 35:2" />“മനുഷ്യപുത്രാ, നീ സെയീർപർവ്വതത്തിനു നേരെ മുഖംതിരിച്ച് അതിനെക്കുറിച്ച് പ്രവചിച്ച് അതിനോട് പറയേണ്ടത്: <verse eid="EZK 35:2" /><verse number="3" style="v" sid="EZK 35:3" />‘യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “സെയീർപർവ്വതമേ, ഞാൻ നിനക്കു വിരോധമായിരിക്കുന്നു; ഞാൻ നിന്‍റെനേരെ കൈ നീട്ടി നിന്നെ പാഴും ശൂന്യവുമാക്കും. <verse eid="EZK 35:3" /><verse number="4" style="v" sid="EZK 35:4" />ഞാൻ നിന്‍റെ പട്ടണങ്ങളെ ശൂന്യമാക്കും; നീ പാഴായിത്തീരും; ഞാൻ യഹോവയെന്ന് നീ അറിയും.<verse eid="EZK 35:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 35:5" />“നീ പുരാതനശത്രുത്വം പുലർത്തി, യിസ്രായേൽ മക്കളുടെ അകൃത്യത്തിൻ്റെ അന്ത്യശിക്ഷാകാലമായ അവരുടെ ആപത്തുകാലത്ത്, അവരെ വാളിന് ഏല്പിച്ചുവല്ലോ. <verse eid="EZK 35:5" /><verse number="6" style="v" sid="EZK 35:6" />അതുകൊണ്ട്: എന്നാണ, ഞാൻ നിന്നെ രക്തച്ചൊരിച്ചിലിന് ഏല്പിക്കുകയും രക്തം നിന്നെ പിന്തുടരുകയും ചെയ്യും; രക്തം നീ വെറുക്കാതിരുന്നതുകൊണ്ട്, രക്തം നിന്നെ പിന്തുടരും എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്. <verse eid="EZK 35:6" /><verse number="7" style="v" sid="EZK 35:7" />അങ്ങനെ ഞാൻ സെയീർപർവ്വതത്തെ പാഴും ശൂന്യവുമാക്കി, അതിൽകൂടി കടന്നുപോകുന്നവരെ അതിൽ നിന്നു ഛേദിച്ചുകളയും. <verse eid="EZK 35:7" /><verse number="8" style="v" sid="EZK 35:8" />ഞാൻ അതിന്‍റെ മലകളെ നിഹതന്മാരെക്കൊണ്ടു നിറയ്ക്കും; നിന്‍റെ കുന്നുകളിലും താഴ്വരകളിലും നിന്‍റെ സകലനദികളിലും വാളാൽ നിഹതന്മാരായവർ വീഴും. <verse eid="EZK 35:8" /><verse number="9" style="v" sid="EZK 35:9" />ഞാൻ നിന്നെ ശാശ്വതശൂന്യങ്ങളാക്കും; നിന്‍റെ പട്ടണങ്ങൾ നിവാസികൾ ഇല്ലാതെയിരിക്കും; ഞാൻ യഹോവ എന്നു നിങ്ങൾ അറിയും.<verse eid="EZK 35:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 35:10" />“യഹോവ അവിടെ ഉണ്ടായിരിക്കുമ്പോൾ: ‘ഈ ജനതകൾ രണ്ടും ഈ ദേശങ്ങൾ രണ്ടും എനിക്കുള്ളവയാകും; ഞങ്ങൾ അത് കൈവശമാക്കും’ എന്നു നീ പറഞ്ഞതുകൊണ്ട് <verse eid="EZK 35:10" /><verse number="11" style="v" sid="EZK 35:11" />എന്നാണ, നീ അവരോടു നിന്‍റെ വിദ്വേഷം ഹേതുവായി കാണിച്ചിരിക്കുന്ന കോപത്തിനും അസൂയയ്ക്കും ഒത്തവിധം ഞാനും പ്രവർത്തിക്കും; ഞാൻ നിനക്കു ന്യായം വിധിക്കുമ്പോൾ ഞാൻ അവരുടെ ഇടയിൽ എന്നെത്തന്നെ വെളിപ്പെടുത്തും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്. <verse eid="EZK 35:11" /><verse number="12" style="v" sid="EZK 35:12" />“‘യിസ്രായേൽപർവ്വതങ്ങൾ ശൂന്യമായിരിക്കുന്നു; അവ ഞങ്ങൾക്ക് ഇരയായി നല്കപ്പെട്ടിരിക്കുന്നു’ എന്നിങ്ങനെ അവയെക്കുറിച്ച് നീ പറഞ്ഞിരിക്കുന്ന ദൂഷണങ്ങൾ എല്ലാം യഹോവയായ ഞാൻ കേട്ടിരിക്കുന്നു എന്നു നീ അറിയും. <verse eid="EZK 35:12" /><verse number="13" style="v" sid="EZK 35:13" />നിങ്ങൾ വായ്കൊണ്ട് എന്‍റെ നേരെ വമ്പുപറഞ്ഞ് എനിക്ക് വിരോധമായി നിങ്ങളുടെ വാക്കുകളെ വർദ്ധിപ്പിച്ചു; ഞാൻ അത് കേട്ടിരിക്കുന്നു.” <verse eid="EZK 35:13" /><verse number="14" style="v" sid="EZK 35:14" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “സർവ്വഭൂമിയും സന്തോഷിച്ചുകൊണ്ടിരിക്കുമ്പോൾ ഞാൻ നിന്നെ ശൂന്യമാക്കും. <verse eid="EZK 35:14" /><verse number="15" style="v" sid="EZK 35:15" />യിസ്രായേൽ ഗൃഹത്തിന്‍റെ അവകാശം ശൂന്യമായതിൽ നീ സന്തോഷിച്ചുവല്ലോ; ഞാൻ നിന്നോടും അതുപോലെ ചെയ്യും; സെയീർപർവ്വതവും എല്ലാ ഏദോമുമായുള്ളവയേ, നീ ശൂന്യമായിത്തീരും; ഞാൻ യഹോവയെന്ന് അവർ അറിയും.”<verse eid="EZK 35:15" /></para>
  <chapter eid="EZK 35" />
  <chapter number="36" style="c" sid="EZK 36" />
  <para style="s">യിസ്രായേലിനെ അനുഗ്രഹം</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 36:1" />“നീയോ, മനുഷ്യപുത്രാ, യിസ്രായേൽപർവ്വതങ്ങളോടു പ്രവചിച്ചു പറയേണ്ടത്: ‘യിസ്രായേൽപർവ്വതങ്ങളേ, യഹോവയുടെ വചനം കേൾക്കുവിൻ!’ <verse eid="EZK 36:1" /><verse number="2" style="v" sid="EZK 36:2" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ശത്രു നിങ്ങളെക്കുറിച്ച്: ‘നന്നായി; പുരാതനഗിരികൾ ഞങ്ങൾക്കു കൈവശം ആയിരിക്കുന്നു’ എന്നു പറയുന്നു. <verse eid="EZK 36:2" /><verse number="3" style="v" sid="EZK 36:3" />അതുകൊണ്ട് നീ പ്രവചിച്ചു പറയേണ്ടത്: യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “നിങ്ങൾ ജനതകളിൽ ശേഷിച്ചവർക്കു കൈവശമായിത്തീരത്തക്കവിധം അവർ നിങ്ങളെ ശൂന്യമാക്കി നിങ്ങളെ ചുറ്റും നിന്നു വിഴുങ്ങിക്കളയുന്നതുകൊണ്ടും നിങ്ങൾ വായാടികളുടെ അധരങ്ങളാൽ ലോകരുടെ അപവാദവിഷയമായിത്തീർന്നിരിക്കുകകൊണ്ടും <verse eid="EZK 36:3" /><verse number="4" style="v" sid="EZK 36:4" />യിസ്രായേൽപർവ്വതങ്ങളേ, യഹോവയായ കർത്താവിന്‍റെ വചനം കേൾക്കുവിൻ! മലകളോടും കുന്നുകളോടും തോടുകളോടും താഴ്വരകളോടും പാഴായിരിക്കുന്ന ശൂന്യപ്രദേശങ്ങളോടും നിർജ്ജനമായ പട്ടണങ്ങളോടും യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: ചുറ്റുമുള്ള ജനതകളിൽ ശേഷിച്ചവർക്കു കവർച്ചയും പരിഹാസവുമായി ഭവിച്ചിരിക്കുന്നു. <verse eid="EZK 36:4" /><verse number="5" style="v" sid="EZK 36:5" />അതുകൊണ്ട് യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ജനതകളിൽ ശേഷിച്ചവരോടും എല്ലാ ഏദോമിനോടും ഞാൻ നിശ്ചയമായി എന്‍റെ ജ്വലിക്കുന്ന തീക്ഷ്ണതയോടെ സംസാരിക്കും; അവർ എന്‍റെ ദേശത്തെ കവർച്ചയ്ക്കായി തള്ളിക്കളയുവാൻ തക്കവിധം അതിനെ പൂർണ്ണഹൃദയസന്തോഷത്തോടും നിന്ദാഭാവത്തോടും കൂടി അവർക്ക് അവകാശമായി നിയമിച്ചുവല്ലോ.”<verse eid="EZK 36:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 36:6" />അതുകൊണ്ട് നീ യിസ്രായേൽ ദേശത്തെക്കുറിച്ചു പ്രവചിച്ച് മലകളോടും കുന്നുകളോടും തോടുകളോടും താഴ്വരകളോടും പറയേണ്ടത്: “യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “നിങ്ങൾ ജനതകളുടെ നിന്ദ വഹിച്ചതുകൊണ്ട് ഞാൻ എന്‍റെ തീക്ഷ്ണതയോടും എന്‍റെ ക്രോധത്തോടുംകൂടി സംസാരിക്കുന്നു.” <verse eid="EZK 36:6" /><verse number="7" style="v" sid="EZK 36:7" />അതുകൊണ്ട് യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “നിങ്ങളുടെ ചുറ്റുമുള്ള ജനതകൾ നിശ്ചയമായി തങ്ങളുടെ ലജ്ജ വഹിക്കും എന്നു ഞാൻ കൈ ഉയർത്തി സത്യം ചെയ്യുന്നു.<verse eid="EZK 36:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 36:8" />നിങ്ങളോ, യിസ്രായേൽപർവ്വതങ്ങളേ, എന്‍റെ ജനമായ യിസ്രായേൽ വരുവാൻ അടുത്തിരിക്കുകകൊണ്ട് കൊമ്പുകളെ നീട്ടി അവർക്ക് വേണ്ടി ഫലം കായിക്കുവിൻ. <verse eid="EZK 36:8" /><verse number="9" style="v" sid="EZK 36:9" />ഞാൻ നിങ്ങൾക്ക് അനുകൂലമായിരിക്കുന്നു; ഞാൻ നിങ്ങളുടെ അടുക്കലേക്ക് തിരിയും; നിങ്ങളിൽ കൃഷിയും വിതയും നടക്കും. <verse eid="EZK 36:9" /><verse number="10" style="v" sid="EZK 36:10" />ഞാൻ നിങ്ങളിൽ മനുഷ്യരെ, യിസ്രായേൽഗൃഹം മുഴുവനെയും തന്നെ, വർദ്ധിപ്പിക്കും; പട്ടണങ്ങളിൽ നിവാസികൾ ഉണ്ടാകും; ശൂന്യപ്രദേശങ്ങളെയും പണിയും. <verse eid="EZK 36:10" /><verse number="11" style="v" sid="EZK 36:11" />ഞാൻ നിങ്ങളിൽ മനുഷ്യരെയും മൃഗങ്ങളെയും വർദ്ധിപ്പിക്കും; അവർ പെരുകി സന്താനപുഷ്ടിയുള്ളവരാകും; കഴിഞ്ഞകാലത്ത് എന്നപോലെ ഞാൻ നിങ്ങളിൽ ജനവാസമുണ്ടാക്കും; നിങ്ങളുടെ ആദികാലത്തുണ്ടായിരുന്നതിനെക്കാൾ അധികം നന്മ ഞാൻ നിങ്ങൾക്ക് ചെയ്യും; ഞാൻ യഹോവ എന്നു നിങ്ങൾ അറിയും. <verse eid="EZK 36:11" /><verse number="12" style="v" sid="EZK 36:12" />ഞാൻ നിങ്ങളിൽക്കൂടി മനുഷ്യരെ, എന്‍റെ ജനമായ യിസ്രായേലിനെ തന്നെ, സഞ്ചരിക്കുമാറാക്കും; അവർ നിന്നെ കൈവശമാക്കും; നീ അവർക്ക് അവകാശമായിരിക്കും; നീ ഇനി അവരെ മക്കളില്ലാത്തവരാക്കുകയുമില്ല.”<verse eid="EZK 36:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 36:13" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: അവർ നിന്നോട്: “നീ മനുഷ്യരെ തിന്നുകളയുകയും നിന്‍റെ ജനത്തെ മക്കളില്ലാത്തവരാക്കുകയും ചെയ്ത ദേശമാകുന്നു’ എന്നു പറയുന്നതുകൊണ്ട്, <verse eid="EZK 36:13" /><verse number="14" style="v" sid="EZK 36:14" />നീ ഇനി മേൽ മനുഷ്യരെ തിന്നുകളയുകയില്ല; നിന്‍റെ ജനത്തെ മക്കളില്ലാത്തവരാക്കുകയുമില്ല” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്. <verse eid="EZK 36:14" /><verse number="15" style="v" sid="EZK 36:15" />“ഞാൻ ഇനി നിന്നെ ജനതകളുടെ നിന്ദ കേൾപ്പിക്കുകയില്ല; വംശങ്ങളുടെ അപമാനം നീ ഇനി വഹിക്കുകയില്ല; നീ ഇനി നിന്‍റെ ജനത്തെ മക്കളില്ലാത്തവരാക്കുകയുമില്ല” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 36:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 36:16" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായത് എന്തെന്നാൽ: <verse eid="EZK 36:16" /><verse number="17" style="v" sid="EZK 36:17" />“മനുഷ്യപുത്രാ, യിസ്രായേൽഗൃഹം അവരുടെ ദേശത്തു വസിച്ചിരുന്നപ്പോൾ, അവർ അതിനെ അവരുടെ നടപ്പുകൊണ്ടും പ്രവൃത്തികൾകൊണ്ടും മലിനമാക്കി; എന്‍റെ മുമ്പാകെ അവരുടെ നടപ്പ് ഋതുവായോരു സ്ത്രീയുടെ മാലിന്യംപോലെ ആയിരുന്നു. <verse eid="EZK 36:17" /><verse number="18" style="v" sid="EZK 36:18" />അവർ ദേശത്തു ചൊരിഞ്ഞ രക്തംനിമിത്തവും അതിനെ അവരുടെ വിഗ്രഹങ്ങൾകൊണ്ടു മലിനമാക്കിയതുനിമിത്തവും ഞാൻ എന്‍റെ ക്രോധം അവരുടെ മേൽ പകർന്നു. <verse eid="EZK 36:18" /><verse number="19" style="v" sid="EZK 36:19" />ഞാൻ അവരെ ജനതകളുടെ ഇടയിൽ ചിന്നിച്ചു; അവർ ദേശങ്ങളിൽ ചിതറിപ്പോയി; അവരുടെ നടപ്പിനും പ്രവൃത്തികൾക്കും തക്കവിധം ഞാൻ അവരെ ന്യായംവിധിച്ചു. <verse eid="EZK 36:19" /><verse number="20" style="v" sid="EZK 36:20" />ജനതകളുടെ ഇടയിൽ അവർ എത്തുന്നയിടത്തെല്ലാം അവരെക്കുറിച്ച്: ‘ഇവർ യഹോവയുടെ ജനം, അവിടുത്തെ ദേശം വിട്ടുപോകേണ്ടിവന്നവർ’ എന്നു പറയുവാൻ ഇടയാക്കിയതിനാൽ അവർ എന്‍റെ വിശുദ്ധനാമത്തെ അശുദ്ധമാക്കി. <verse eid="EZK 36:20" /><verse number="21" style="v" sid="EZK 36:21" />എങ്കിലും യിസ്രായേൽഗൃഹം ചെന്നുചേർന്ന ജനതകളുടെ ഇടയിൽ അശുദ്ധമാക്കിയ എന്‍റെ വിശുദ്ധനാമത്തെക്കുറിച്ച് എനിക്ക് ഹൃദയഭാരം ഉണ്ടായി.<verse eid="EZK 36:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 36:22" />അതുകൊണ്ട് നീ യിസ്രായേൽ ഗൃഹത്തോട് പറയേണ്ടത്: യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: യിസ്രായേൽ ഗൃഹമേ, നിങ്ങളുടെ നിമിത്തമല്ല, നിങ്ങൾ ചെന്നുചേർന്ന ജനതകളുടെ ഇടയിൽ നിങ്ങൾ അശുദ്ധമാക്കിയിരിക്കുന്ന എന്‍റെ വിശുദ്ധനാമംനിമിത്തം അത്രേ ഞാൻ അങ്ങനെ ചെയ്യുന്നത്. <verse eid="EZK 36:22" /><verse number="23" style="v" sid="EZK 36:23" />ജനതകളുടെ ഇടയിൽ നിങ്ങൾ അശുദ്ധമാക്കിയതായി അവരുടെ ഇടയിൽ അശുദ്ധമായിത്തീർന്നിരിക്കുന്ന എന്‍റെ മഹത്തായ നാമത്തെ ഞാൻ വിശുദ്ധീകരിക്കും; ജനതകളുടെ മുൻപിൽ ഞാൻ എന്നെത്തന്നെ നിങ്ങളിൽ വിശുദ്ധീകരിക്കുമ്പോൾ ഞാൻ യഹോവ എന്നു അവർ അറിയും എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു. <verse eid="EZK 36:23" /><verse number="24" style="v" sid="EZK 36:24" />ഞാൻ നിങ്ങളെ ജനതകളുടെ ഇടയിൽനിന്ന് കൂട്ടിവരുത്തി, സകലദേശങ്ങളിൽനിന്നും നിങ്ങളെ ശേഖരിച്ച്, സ്വന്തദേശത്തേക്കു കൊണ്ടുവരും. <verse eid="EZK 36:24" /><verse number="25" style="v" sid="EZK 36:25" />ഞാൻ നിങ്ങളുടെമേൽ നിർമ്മലജലം തളിക്കും; നിങ്ങൾ നിർമ്മലരായിത്തീരും; ഞാൻ നിങ്ങളുടെ സകലമലിനതയെയും സകലവിഗ്രഹങ്ങളെയും നീക്കി നിങ്ങളെ നിർമ്മലീകരിക്കും. <verse eid="EZK 36:25" /><verse number="26" style="v" sid="EZK 36:26" />ഞാൻ നിങ്ങൾക്ക് പുതിയ ഒരു ഹൃദയം തരും; പുതിയ ഒരു ആത്മാവിനെ ഞാൻ നിങ്ങളുടെ ഉള്ളിൽ ആക്കും; കല്ലായുള്ള ഹൃദയം ഞാൻ നിങ്ങളുടെ ജഡത്തിൽനിന്നു നീക്കി മാംസമായുള്ള ഹൃദയം നിങ്ങൾക്ക് തരും. <verse eid="EZK 36:26" /><verse number="27" style="v" sid="EZK 36:27" />ഞാൻ എന്‍റെ ആത്മാവിനെ നിങ്ങളുടെ ഉള്ളിൽ ആക്കി നിങ്ങളെ എന്‍റെ ചട്ടങ്ങളിൽ നടക്കുമാറാക്കും; നിങ്ങൾ എന്‍റെ വിധികളെ പ്രമാണിച്ച് അനുഷ്ഠിക്കും. <verse eid="EZK 36:27" /><verse number="28" style="v" sid="EZK 36:28" />ഞാൻ നിങ്ങളുടെ പൂര്‍വ്വ പിതാക്കന്മാർക്കു കൊടുത്ത ദേശത്ത് നിങ്ങൾ വസിക്കും; നിങ്ങൾ എനിക്ക് ജനമായും ഞാൻ നിങ്ങൾക്ക് ദൈവമായും ഇരിക്കും. <verse eid="EZK 36:28" /><verse number="29" style="v" sid="EZK 36:29" />ഞാൻ നിങ്ങളുടെ സകല മലിനതകളും നീക്കി നിങ്ങളെ രക്ഷിക്കും; ഞാൻ നിങ്ങളുടെമേൽ ക്ഷാമം വരുത്താതെ ധാന്യം വിളിച്ചുവരുത്തി അതിനെ വർദ്ധിപ്പിക്കും.<verse eid="EZK 36:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 36:30" />നിങ്ങൾ ഇനി ഒരിക്കലും ജനതകളുടെ ഇടയിൽ ക്ഷാമത്തിന്‍റെ നിന്ദ അനുഭവിക്കാതെയിരിക്കേണ്ടതിന് ഞാൻ വൃക്ഷങ്ങളുടെ ഫലവും നിലത്തിന്‍റെ വിളവും വർദ്ധിപ്പിക്കും. <verse eid="EZK 36:30" /><verse number="31" style="v" sid="EZK 36:31" />അപ്പോൾ നിങ്ങൾ നിങ്ങളുടെ ദുർമ്മാർഗ്ഗങ്ങളെയും ദുഷ്ടപ്രവൃത്തികളെയും ഓർത്തു, നിങ്ങളുടെ അകൃത്യങ്ങളും മ്ലേച്ഛതകളും നിമിത്തം നിങ്ങൾക്ക് നിങ്ങളോടുതന്നെ വെറുപ്പുതോന്നും. <verse eid="EZK 36:31" /><verse number="32" style="v" sid="EZK 36:32" />‘നിങ്ങളുടെ നിമിത്തമല്ല ഞാൻ ഇതു ചെയ്യുന്നത്’ എന്നു നിങ്ങൾ മനസ്സിലാക്കണമെന്ന് യഹോവയായ കർത്താവ് അരുളിച്ചെയ്യുന്നു; യിസ്രായേൽ ഗൃഹമേ, നിങ്ങളുടെ നടപ്പുനിമിത്തം ലജ്ജിച്ചു നാണിക്കുവിൻ. <verse eid="EZK 36:32" /><verse number="33" style="v" sid="EZK 36:33" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഞാൻ നിങ്ങളുടെ അകൃത്യങ്ങളെല്ലാം നീക്കി നിങ്ങളെ നിർമ്മലീകരിക്കുന്ന നാളിൽ ഞാൻ നിങ്ങളുടെ പട്ടണങ്ങൾ ജനവാസമുള്ളതാക്കും; ശൂന്യസ്ഥലങ്ങളെയും പണിയും. <verse eid="EZK 36:33" /><verse number="34" style="v" sid="EZK 36:34" />അതിലെ വഴിപോകുന്ന എല്ലാവരുടെയും കാഴ്ചക്ക് ശൂന്യമായിക്കിടന്നിരുന്ന പ്രദേശത്ത് കൃഷി നടക്കും. <verse eid="EZK 36:34" /><verse number="35" style="v" sid="EZK 36:35" />‘ശൂന്യമായിക്കിടന്നിരുന്ന ദേശം ഏദെൻതോട്ടം പോലെയായിത്തീർന്നുവല്ലോ; പാഴും ശൂന്യവുമായി ഇടിഞ്ഞുകിടന്നിരുന്ന പട്ടണങ്ങൾ ഉറപ്പും നിവാസികളും ഉള്ളവ ആയിത്തീർന്നുവല്ലോ’ എന്നു അവർ പറയും. <verse eid="EZK 36:35" /><verse number="36" style="v" sid="EZK 36:36" />ഇടിഞ്ഞുകിടന്നിരുന്ന പട്ടണങ്ങളെ യഹോവയായ ഞാൻ പണിത്, ശൂന്യപ്രദേശത്ത് കൃഷി ചെയ്യുമെന്ന് നിങ്ങളുടെ ചുറ്റും ശേഷിച്ചിരിക്കുന്ന ജനതകൾ അന്നു അറിയും; യഹോവയായ ഞാൻ അരുളിച്ചെയ്തിരിക്കുന്നു; ഞാൻ നിവർത്തിക്കുകയും ചെയ്യും.”<verse eid="EZK 36:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="EZK 36:37" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “യിസ്രായേൽ ഗൃഹത്തിന്‍റെ അപേക്ഷ കേട്ടു, ഞാൻ ഒന്നുകൂടി ചെയ്യും: ഞാൻ അവർക്ക് ആളുകളെ ആട്ടിൻകൂട്ടത്തെപ്പോലെ വർദ്ധിപ്പിച്ചുകൊടുക്കും. <verse eid="EZK 36:37" /><verse number="38" style="v" sid="EZK 36:38" />ശൂന്യമായിപ്പോയിരുന്ന പട്ടണങ്ങൾ വിശുദ്ധമായ ആട്ടിൻകൂട്ടംപോലെ, ഉത്സവങ്ങളിൽ യെരൂശലേമിലെ ആട്ടിൻകൂട്ടംപോലെ തന്നെ, മനുഷ്യരാകുന്ന ആട്ടിൻകൂട്ടം കൊണ്ടു നിറയും; ഞാൻ യഹോവ എന്നു അവർ അറിയും.”<verse eid="EZK 36:38" /></para>
  <chapter eid="EZK 36" />
  <chapter number="37" style="c" sid="EZK 37" />
  <para style="s">ഉണങ്ങിയ അസ്ഥികളുടെ താഴ്വര</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 37:1" />യഹോവയുടെ കൈ എന്‍റെ മേൽ വന്ന്, യഹോവയുടെ ആത്മാവിൽ എന്നെ പുറപ്പെടുവിച്ച്, താഴ്വരയുടെ നടുവിൽ നിർത്തി; അത് അസ്ഥികൾകൊണ്ടു നിറഞ്ഞിരുന്നു. <verse eid="EZK 37:1" /><verse number="2" style="v" sid="EZK 37:2" />അവിടുന്ന് എന്നെ അവയുടെ ഇടയിലൂടെ ചുറ്റിനടക്കുമാറാക്കി; തുറസ്സായ താഴ്വരയിൽ അവ എത്രയും അധികമായിരുന്നു; അവ ഏറ്റവും ഉണങ്ങിയുമിരുന്നു. <verse eid="EZK 37:2" /><verse number="3" style="v" sid="EZK 37:3" />അവിടുന്ന് എന്നോട്: “മനുഷ്യപുത്രാ, ഈ അസ്ഥികൾ ജീവിക്കുമോ?” എന്നു ചോദിച്ചു;</para>
  <para style="p" vid="EZK 37:3">അതിന് ഞാൻ: “യഹോവയായ കർത്താവേ, അങ്ങ് അറിയുന്നു” എന്നുത്തരം പറഞ്ഞു.<verse eid="EZK 37:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 37:4" />അവിടുന്ന് എന്നോട് കല്പിച്ചത്: “നീ ഈ അസ്ഥികളെക്കുറിച്ചു പ്രവചിച്ച് അവയോടു പറയേണ്ടത്: “ഉണങ്ങിയ അസ്ഥികളേ, യഹോവയുടെ വചനം കേൾക്കുവിൻ! <verse eid="EZK 37:4" /><verse number="5" style="v" sid="EZK 37:5" />യഹോവയായ കർത്താവ് ഈ അസ്ഥികളോട് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “നിങ്ങൾ ജീവിക്കേണ്ടതിന് ഞാൻ നിങ്ങളിലേക്ക് ശ്വാസം<note caller="+" style="f"><char style="fr" closed="false">37:5 </char><char style="fq" closed="false">ശ്വാസം </char><char style="ft" closed="false">ആത്മാവ്</char></note> അയയ്ക്കും. <verse eid="EZK 37:5" /><verse number="6" style="v" sid="EZK 37:6" />ഞാൻ നിങ്ങളുടെമേൽ ഞരമ്പുവച്ച് മാംസം പിടിപ്പിച്ച് നിങ്ങളെ ത്വക്കുകൊണ്ടു പൊതിഞ്ഞ് നിങ്ങൾ ജീവിക്കേണ്ടതിന് നിങ്ങളിലേക്ക് ശ്വാസം അയയ്ക്കും; ഞാൻ യഹോവ എന്നു നിങ്ങൾ അറിയും.”<verse eid="EZK 37:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 37:7" />എന്നോട് കല്പിച്ചതുപോലെ ഞാൻ പ്രവചിച്ചു; ഞാൻ പ്രവചിച്ചുകൊണ്ടിരിക്കുമ്പോൾ ഒരു മുഴക്കം കേട്ടു; ഉടനെ ഒരു ഭൂകമ്പം ഉണ്ടായി, അസ്ഥി അസ്ഥിയോടു വന്നുചേർന്നു. <verse eid="EZK 37:7" /><verse number="8" style="v" sid="EZK 37:8" />പിന്നെ ഞാൻ നോക്കി: അവയുടെമേൽ ഞരമ്പും മാംസവും വന്നതും അവയുടെമേൽ ത്വക്കുപൊതിഞ്ഞതും കണ്ടു; എന്നാൽ ശ്വാസം അവയിൽ ഉണ്ടായിരുന്നില്ല.<verse eid="EZK 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 37:9" />അപ്പോൾ അവിടുന്ന് എന്നോട് കല്പിച്ചത്: “ശ്വാസത്തോട്<note caller="+" style="f"><char style="fr" closed="false">37:9 </char><char style="fq" closed="false">ശ്വാസത്തോട് </char><char style="ft" closed="false">കാറ്റിനോടു</char></note> പ്രവചിക്കുക; മനുഷ്യപുത്രാ, നീ പ്രവചിച്ച് കാറ്റിനോടു പറയേണ്ടത്: ‘യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: ശ്വാസമേ, നീ നാലു കാറ്റുകളിൽനിന്നും വന്ന് ഈ നിഹതന്മാർ ജീവിക്കേണ്ടതിന് അവരുടെ മേൽ ഊതുക.”<verse eid="EZK 37:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 37:10" />അവിടുന്ന് എന്നോട് കല്പിച്ചതുപോലെ ഞാൻ പ്രവചിച്ചപ്പോൾ ശ്വാസം അവരിൽ വന്നു; അവർ ജീവിച്ച് ഏറ്റവും വലിയ സൈന്യമായി നിവിർന്നുനിന്നു.<verse eid="EZK 37:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 37:11" />പിന്നെ അവിടുന്ന് എന്നോട് അരുളിച്ചെയ്തത്: “മനുഷ്യപുത്രാ, ഈ അസ്ഥികൾ യിസ്രായേൽഗൃഹം മുഴുവനും ആകുന്നു; ‘ഞങ്ങളുടെ അസ്ഥികൾ ഉണങ്ങി, ഞങ്ങളുടെ പ്രത്യാശക്കു ഭംഗം വന്ന്, ഞങ്ങൾ തീരെ മുടിഞ്ഞിരിക്കുന്നു’ എന്നു അവർ പറയുന്നു. <verse eid="EZK 37:11" /><verse number="12" style="v" sid="EZK 37:12" />അതുകൊണ്ട് നീ പ്രവചിച്ച് അവരോടു പറയേണ്ടത്: ‘യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: എന്‍റെ ജനമേ, ഞാൻ നിങ്ങളുടെ ശവക്കുഴി തുറന്ന് നിങ്ങളെ ശവക്കുഴിയിൽനിന്നു കയറ്റി യിസ്രായേൽദേശത്തേക്കു കൊണ്ടുപോകും. <verse eid="EZK 37:12" /><verse number="13" style="v" sid="EZK 37:13" />അങ്ങനെ എന്‍റെ ജനമേ, ഞാൻ നിങ്ങളുടെ ശവക്കുഴി തുറന്ന് നിങ്ങളെ ശവക്കുഴിയിൽനിന്നു കയറ്റുമ്പോൾ ഞാൻ യഹോവ എന്നു നിങ്ങൾ അറിയും. <verse eid="EZK 37:13" /><verse number="14" style="v" sid="EZK 37:14" />നിങ്ങൾ ജീവിക്കേണ്ടതിന് ഞാൻ എന്‍റെ ശ്വാസത്തെ<note caller="+" style="f"><char style="fr" closed="false">37:14 </char><char style="fq" closed="false">ശ്വാസത്തെ </char><char style="ft" closed="false">ആത്മാവിനെ</char></note> നിങ്ങളിൽ ആക്കും; ഞാൻ നിങ്ങളെ സ്വദേശത്ത് പാർപ്പിക്കും; യഹോവയായ ഞാൻ അരുളിച്ചെയ്തു നിവർത്തിച്ചുമിരിക്കുന്നു എന്നു നിങ്ങൾ അറിയും’ എന്നു യഹോവയുടെ അരുളപ്പാട്.”<verse eid="EZK 37:14" /></para>
  <para style="s">ഒരു രാജാവ് ഒരു രാഷ്ട്രം</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 37:15" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായതെന്തെന്നാൽ: <verse eid="EZK 37:15" /><verse number="16" style="v" sid="EZK 37:16" />മനുഷ്യപുത്രാ, നീ ഒരു വടി എടുത്ത് അതിന്മേൽ: ‘യെഹൂദായ്ക്കും അവനോട് ചേർന്നിരിക്കുന്ന യിസ്രായേൽമക്കൾക്കും’ എന്നു എഴുതിവയ്ക്കുക; പിന്നെ മറ്റൊരു വടി എടുത്ത് അതിന്മേൽ: ‘എഫ്രയീമിന്‍റെ വടിയായ യോസേഫിനും അവനോട് ചേർന്നിരിക്കുന്ന എല്ലാ യിസ്രായേൽ ഗൃഹത്തിനും’ എന്നു എഴുതിവയ്ക്കുക. <verse eid="EZK 37:16" /><verse number="17" style="v" sid="EZK 37:17" />പിന്നെ നീ അവയെ ഒരു വടിയായി ഒന്നോടൊന്നു ചേർക്കുക; അവ നിന്‍റെ കയ്യിൽ ഒന്നായിത്തീരും. <verse eid="EZK 37:17" /><verse number="18" style="v" sid="EZK 37:18" />‘ഇതിന്‍റെ അർത്ഥം എന്തെന്ന് നീ ഞങ്ങളെ അറിയിക്കുകയില്ലയോ?’ എന്നു നിന്‍റെ സ്വജാതിക്കാർ നിന്നോട് ചോദിക്കുമ്പോൾ, നീ അവരോടു പറയേണ്ടത്: <verse eid="EZK 37:18" /><verse number="19" style="v" sid="EZK 37:19" />‘യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: ഞാൻ എഫ്രയീമിന്‍റെ കയ്യിലുള്ള യോസേഫിന്‍റെ വടിയും അവനോട് ചേർന്നിരിക്കുന്ന എല്ലാ യിസ്രായേൽഗോത്രങ്ങളെയും എടുത്ത് അവരെ അവനോട്, യെഹൂദായുടെ വടിയോടു തന്നെ, ചേർത്ത് ഒരു വടിയാക്കും; അവർ എന്‍റെ കയ്യിൽ ഒന്നായിരിക്കും.’<verse eid="EZK 37:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 37:20" />നീ എഴുതിയ വടികൾ അവരുടെ കൺമുമ്പിൽ നിന്‍റെ കയ്യിൽ ഇരിക്കേണം. <verse eid="EZK 37:20" /><verse number="21" style="v" sid="EZK 37:21" />പിന്നെ നീ അവരോടു പറയേണ്ടത്: ‘യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: ഞാൻ യിസ്രായേൽ മക്കളെ അവർ ചെന്നു ചേർന്നിരിക്കുന്ന ജനതകളുടെ ഇടയിൽനിന്ന് കൂട്ടി എല്ലാഭാഗത്തുനിന്നും സ്വരൂപിച്ച് സ്വദേശത്തേക്കു കൊണ്ടുവരും. <verse eid="EZK 37:21" /><verse number="22" style="v" sid="EZK 37:22" />ഞാൻ അവരെ ദേശത്ത്, യിസ്രായേൽ പർവ്വതങ്ങളിൽ തന്നെ, ഏകജനതയാക്കും; ഒരു രാജാവ് അവർക്കെല്ലാവർക്കും രാജാവായിരിക്കും; അവർ ഇനി രണ്ടു ജനതയായിരിക്കുകയില്ല, രണ്ടു രാജ്യമായി പിരിയുകയുമില്ല. <verse eid="EZK 37:22" /><verse number="23" style="v" sid="EZK 37:23" />അവർ ഇനി വിഗ്രഹങ്ങളാലും മ്ലേച്ഛതകളാലും യാതൊരു അതിക്രമത്താലും അവരെ സ്വയം മലിനമാക്കുകയില്ല; അവർ പാപം ചെയ്ത അവരുടെ സകല വാസസ്ഥലങ്ങളിലുംനിന്ന് ഞാൻ അവരെ രക്ഷിച്ചു ശുദ്ധീകരിക്കും; അങ്ങനെ അവർ എനിക്ക് ജനമായും ഞാൻ അവർക്ക് ദൈവമായും ഇരിക്കും.<verse eid="EZK 37:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 37:24" />”എന്‍റെ ദാസനായ ദാവീദ് അവർക്ക് രാജാവായിരിക്കും; അവർക്കെല്ലാവർക്കും ഒരു ഇടയൻ ഉണ്ടാകും; അവർ എന്‍റെ വിധികളിൽ നടന്ന് എന്‍റെ ചട്ടങ്ങളെ പ്രമാണിച്ച് അനുഷ്ഠിക്കും. <verse eid="EZK 37:24" /><verse number="25" style="v" sid="EZK 37:25" />എന്‍റെ ദാസനായ യാക്കോബിനു ഞാൻ കൊടുത്തതും നിങ്ങളുടെ പൂര്‍വ്വ പിതാക്കന്മാർ വസിച്ചിരുന്നതും ആയ ദേശത്ത് അവർ വസിക്കും; അവരും, മക്കളും, മക്കളുടെ മക്കളും എന്നേക്കും അവിടെ വസിക്കും; എന്‍റെ ദാസനായ ദാവീദ് എന്നേക്കും അവർക്ക് പ്രഭുവായിരിക്കും. <verse eid="EZK 37:25" /><verse number="26" style="v" sid="EZK 37:26" />ഞാൻ അവരോട് ഒരു സമാധാനനിയമം ചെയ്യും; അത് അവർക്ക് ഒരു ശാശ്വതനിയമം ആയിരിക്കും; ഞാൻ അവരെ സ്ഥിരപ്പെടുത്തി, വർദ്ധിപ്പിച്ച് അവരുടെ നടുവിൽ എന്‍റെ വിശുദ്ധമന്ദിരത്തെ സദാകാലത്തേക്കും സ്ഥാപിക്കും. <verse eid="EZK 37:26" /><verse number="27" style="v" sid="EZK 37:27" />എന്‍റെ നിവാസം അവരോടുകൂടി ആയിരിക്കും; ഞാൻ അവർക്ക് ദൈവമായും അവർ എനിക്ക് ജനമായും ഇരിക്കും. <verse eid="EZK 37:27" /><verse number="28" style="v" sid="EZK 37:28" />എന്‍റെ വിശുദ്ധമന്ദിരം സദാകാലത്തേക്കും അവരുടെ നടുവിൽ ഇരിക്കുമ്പോൾ ഞാൻ യിസ്രായേലിനെ വിശുദ്ധീകരിക്കുന്ന യഹോവയെന്ന് ജനതകൾ അറിയും.”<verse eid="EZK 37:28" /></para>
  <chapter eid="EZK 37" />
  <chapter number="38" style="c" sid="EZK 38" />
  <para style="s">ഗോഗിനെതിരെ പ്രവചനം</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 38:1" />യഹോവയുടെ അരുളപ്പാടു എനിക്കുണ്ടായത് എന്തെന്നാൽ: <verse eid="EZK 38:1" /><verse number="2" style="v" sid="EZK 38:2" />“മനുഷ്യപുത്രാ, മേശക്കിന്‍റെയും തൂബലിൻ്റെയും മുഖ്യപ്രഭുവായ, മാഗോഗ് ദേശത്തിലുള്ള ഗോഗിൻ്റെ നേരെ നീ മുഖംതിരിച്ച് അവനെക്കുറിച്ചു പ്രവചിച്ചു പറയേണ്ടത്: <verse eid="EZK 38:2" /><verse number="3" style="v" sid="EZK 38:3" />‘യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:മേശക്കിന്‍റെയും തൂബലിൻ്റെയും മുഖ്യപ്രഭുവായ ഗോഗേ, ഞാൻ നിനക്കു വിരോധമായിരിക്കുന്നു. <verse eid="EZK 38:3" /><verse number="4" style="v" sid="EZK 38:4" />ഞാൻ നിന്നെ വഴിതെറ്റിച്ച്, നിന്‍റെ താടിയെല്ലിൽ ചൂണ്ടൽ കൊളുത്തി, നിന്നെയും നിന്‍റെ സകലസൈന്യത്തെയും എല്ലാ കുതിരകളെയും സർവ്വായുധം ധരിച്ച എല്ലാ കുതിരച്ചേവകരെയും വാളും പരിചയും പലകയും എടുത്ത ഒരു മഹാസമൂഹത്തെയും, <verse eid="EZK 38:4" /><verse number="5" style="v" sid="EZK 38:5" />അവരോടുകൂടിയുള്ള പരിചയും ശിരസ്ത്രവും ധരിച്ച പാർസികൾ, കൂശ്യർ, പൂത്യർ എന്നിവരും, ഗോമെരും <verse eid="EZK 38:5" /><verse number="6" style="v" sid="EZK 38:6" />അവന്‍റെ എല്ലാ പടക്കൂട്ടങ്ങളും വടക്കെ അറ്റത്തുള്ള തോഗർമ്മാഗൃഹവും അതിന്‍റെ എല്ലാ പടക്കൂട്ടങ്ങളും എന്നിങ്ങനെ പല ജനതകളെയും നിന്നോടുകൂടെ പുറപ്പെടുമാറാക്കും.<verse eid="EZK 38:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 38:7" />“ഒരുങ്ങിക്കൊള്ളുക! നീയും നിന്‍റെ അടുക്കൽ കൂടിയിരിക്കുന്ന നിന്‍റെ സമൂഹവും എല്ലാം ഒരുങ്ങിക്കൊള്ളുവിൻ! നീ അവർക്ക് മേധാവി ആയിരിക്കുക. <verse eid="EZK 38:7" /><verse number="8" style="v" sid="EZK 38:8" />ഏറിയനാൾ കഴിഞ്ഞിട്ട് നീ സന്ദർശിക്കപ്പെടും; വാളിൽനിന്ന് രക്ഷപെട്ടതും, പല ജനതകളിൽനിന്ന് ശേഖരിക്കപ്പെട്ടതുമായ ഒരു രാജ്യത്തിലേക്ക് നീ അവസാനം വന്നുചേരും; നിരന്തരശൂന്യമായി കിടന്നിരുന്ന യിസ്രായേൽ പർവ്വതങ്ങളിൽ തന്നെ; എന്നാൽ അവർ ജനതകളുടെ ഇടയിൽനിന്ന് വന്ന് എല്ലാവരും നിർഭയമായി വസിക്കും. <verse eid="EZK 38:8" /><verse number="9" style="v" sid="EZK 38:9" />നീ മഴക്കോൾപോലെ കയറിവരും; നീയും നിന്‍റെ എല്ലാ പടക്കൂട്ടങ്ങളും നിന്നോടുകൂടെയുള്ള പല ജനതകളും മേഘംപോലെ ദേശത്തെ മൂടും.”<verse eid="EZK 38:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 38:10" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ആ നാളിൽ നിന്‍റെ ഹൃദയത്തിൽ ചില ചിന്തകൾ ഉത്ഭവിക്കും; <verse eid="EZK 38:10" /><verse number="11" style="v" sid="EZK 38:11" />നീ ഒരു ദുരുപായം നിരൂപിക്കും; ‘മതിലില്ലാത്ത ഗ്രാമങ്ങൾ ഉള്ള ദേശത്തു ഞാൻ ചെല്ലും; കൊള്ളയിടേണ്ടതിനും കവർച്ച ചെയ്യേണ്ടതിനും, ശൂന്യമായിക്കിടന്നശേഷം വീണ്ടും നിവാസികൾ ഉള്ളതായ സ്ഥലങ്ങൾക്കു നേരെയും, ജനതകളുടെ ഇടയിൽനിന്ന് ശേഖരിക്കപ്പെട്ട്, കന്നുകാലികളും ധനവും സമ്പാദിച്ച്, ഭൂമിയുടെ മദ്ധ്യത്തിൽ വസിച്ചിരിക്കുന്ന ഒരു ജനത്തിന്‍റെ നേരെയും കൈ നീട്ടേണ്ടതിനും <verse eid="EZK 38:11" /><verse number="12" style="v" sid="EZK 38:12" />മതിലും ഓടാമ്പലും കതകും കൂടാതെ നിർഭയം വസിച്ച് സ്വൈരമായിരിക്കുന്ന എല്ലാവരുടെയും നേരെ ഞാൻ ചെല്ലും” എന്നും നീ പറയും. <verse eid="EZK 38:12" /><verse number="13" style="v" sid="EZK 38:13" />ശെബയും ദെദാനും തർശ്ശീശിലെ വ്യാപാരികളും അതിലെ സകലബാലസിംഹങ്ങളും നിന്നോട്: ‘നീ കൊള്ളയിടുവാനോ വന്നത്? കവർച്ച ചെയ്യുവാനും വെള്ളിയും പൊന്നും എടുത്തു കൊണ്ടുപോകുവാനും കന്നുകാലികളെയും ധനത്തെയും അപഹരിക്കുവാനും ഏറ്റവും വലിയ കൊള്ള നടത്തുവാനും ആകുന്നുവോ നീ നിന്‍റെ സമൂഹത്തെ കൂട്ടിയിരിക്കുന്നത്’ എന്നു പറയും.<verse eid="EZK 38:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 38:14" />ആകയാൽ മനുഷ്യപുത്രാ, നീ പ്രവചിച്ച് ഗോഗിനോടു പറയേണ്ടത്: യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “എന്‍റെ ജനമായ യിസ്രായേൽ നിർഭയമായി വസിക്കുന്ന ആ നാളിൽ, നീ അത് അറിയുകയില്ലയോ? <verse eid="EZK 38:14" /><verse number="15" style="v" sid="EZK 38:15" />നീയും നിന്നോടുകൂടെ പല ജനതകളും, മഹാസൈന്യവും, മഹാസമൂഹമായി എല്ലാവരും കുതിരപ്പുറത്തു കയറി, നിന്‍റെ ദിക്കിൽനിന്ന്, വടക്കെ അറ്റത്തുനിന്നു തന്നെ, വരും. <verse eid="EZK 38:15" /><verse number="16" style="v" sid="EZK 38:16" />ദേശത്തെ മറയ്ക്കേണ്ടതിനുള്ള ഒരു മേഘംപോലെ നീ എന്‍റെ ജനമായ യിസ്രായേലിന്‍റെ നേരെ വരും; ഗോഗേ, അന്ത്യകാലത്ത് ജനതകളുടെ കൺമുമ്പിൽ ഞാൻ എന്നെത്തന്നെ നിന്നിൽ വിശുദ്ധീകരിക്കുമ്പോൾ അവർ എന്നെ അറിയേണ്ടതിന് ഞാൻ നിന്നെ എന്‍റെ ദേശത്തിന്‍റെ നേരെ വരുത്തും.”<verse eid="EZK 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 38:17" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഞാൻ നിന്നെ യിസ്രായേലിനു വിരോധമായി വരുത്തും’ എന്നു കഴിഞ്ഞകാലത്ത്, അനേകം സംവത്സരങ്ങളായി പ്രവചിച്ചുപോന്ന അവരുടെ പ്രവാചകന്മാരായ എന്‍റെ ദാസന്മാർ മുഖാന്തരം ഞാൻ അന്നു അരുളിച്ചെയ്തത് നിന്നെക്കുറിച്ചല്ലയോ? <verse eid="EZK 38:17" /><verse number="18" style="v" sid="EZK 38:18" />യിസ്രായേൽദേശത്തിനു വിരോധമായി ഗോഗ് വരുന്ന ആ നാളിൽ, എന്‍റെ മുഖം ഉഗ്രകോപത്താൽ ജ്വലിക്കും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്. <verse eid="EZK 38:18" /><verse number="19" style="v" sid="EZK 38:19" />“അന്നാളിൽ നിശ്ചയമായി യിസ്രായേൽ ദേശത്ത് ഒരു വലിയ ഭൂകമ്പം ഉണ്ടാകും’ എന്നു ഞാൻ എന്‍റെ തീക്ഷ്ണതയിലും എന്‍റെ കോപാഗ്നിയിലും അരുളിച്ചെയ്തിരിക്കുന്നു. <verse eid="EZK 38:19" /><verse number="20" style="v" sid="EZK 38:20" />അങ്ങനെ സമുദ്രത്തിലെ മത്സ്യവും ആകാശത്തിലെ പറവയും കാട്ടിലെ മൃഗവും നിലത്തിഴയുന്ന എല്ലാ ഇഴജാതിയും ഭൂതലത്തിലെ സകലമനുഷ്യരും എന്‍റെ സന്നിധിയിൽ വിറയ്ക്കും; മലകൾ ഇടിഞ്ഞുപോകും; കടുന്തൂക്കായ സ്ഥലങ്ങൾ വീണുപോകും; എല്ലാ മതിലും നിലംപരിചാകും. <verse eid="EZK 38:20" /><verse number="21" style="v" sid="EZK 38:21" />ഞാൻ എന്‍റെ സകലപർവ്വതങ്ങളോടും അവന്‍റെനേരെ വാളെടുക്കുവാൻ കല്പിക്കും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു; ഓരോരുത്തന്‍റെ വാൾ അവനവന്‍റെ സഹോദരനു വിരോധമായിരിക്കും. <verse eid="EZK 38:21" /><verse number="22" style="v" sid="EZK 38:22" />ഞാൻ മഹാമാരികൊണ്ടും രക്തംകൊണ്ടും അവനെ ന്യായംവിധിക്കും; ഞാൻ അവന്‍റെമേലും അവന്‍റെ പടക്കൂട്ടങ്ങളുടെമേലും അവനോടുകൂടിയുള്ള പല ജനതകളുടെമേലും പെരുമഴയും വലിയ ആലിപ്പഴവും തീയും ഗന്ധകവും വർഷിപ്പിക്കും. <verse eid="EZK 38:22" /><verse number="23" style="v" sid="EZK 38:23" />ഇങ്ങനെ ഞാൻ സ്വയം മഹത്ത്വീകരിക്കുകയും സ്വയം വിശുദ്ധീകരിക്കുകയും പല ജനതകളുടെയും കൺമുമ്പിൽ എന്നെത്തന്നെ വെളിപ്പെടുത്തുകയും ചെയ്യുമ്പോൾ ഞാൻ യഹോവ എന്നു അവർ അറിയും.<verse eid="EZK 38:23" /></para>
  <chapter eid="EZK 38" />
  <chapter number="39" style="c" sid="EZK 39" />
  <para style="s">ഗോഗിൻ്റെ പതനം</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 39:1" />നീയോ, മനുഷ്യപുത്രാ, ഗോഗിനെക്കുറിച്ചു പ്രവചിച്ച് പറയേണ്ടത്: “യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: മേശക്കിന്‍റെയും തൂബലിൻ്റെയും മുഖ്യപ്രഭുവായ ഗോഗേ, ഞാൻ നിനക്കു വിരോധമായിരിക്കുന്നു. <verse eid="EZK 39:1" /><verse number="2" style="v" sid="EZK 39:2" />ഞാൻ നിന്നെ വഴിതെറ്റിച്ച് നിന്നിൽ ആറിലൊന്നു മാത്രം ശേഷിപ്പിച്ച്, നിന്നെ വടക്കെ അറ്റത്തുനിന്നു പുറപ്പെടുവിച്ച്, യിസ്രായേൽ പർവ്വതങ്ങളിൽ വരുത്തും. <verse eid="EZK 39:2" /><verse number="3" style="v" sid="EZK 39:3" />ഞാൻ നിന്‍റെ ഇടങ്കയ്യിൽനിന്നു വില്ലു തെറിപ്പിച്ച്, നിന്‍റെ വലങ്കയ്യിൽനിന്ന് അമ്പ് വീഴിക്കും. <verse eid="EZK 39:3" /><verse number="4" style="v" sid="EZK 39:4" />നീയും നിന്‍റെ എല്ലാ പടക്കൂട്ടങ്ങളും നിന്നോടുകൂടെയുള്ള ജനതകളും യിസ്രായേൽ പർവ്വതങ്ങളിൽ വീഴും; ഞാൻ നിന്നെ കഴുകൻ മുതലായ പറവകൾക്കും, എല്ലാ കാട്ടുമൃഗങ്ങൾക്കും ഇരയായി കൊടുക്കും. <verse eid="EZK 39:4" /><verse number="5" style="v" sid="EZK 39:5" />നീ വെളിമ്പ്രദേശത്തു വീഴും; ഞാനല്ലയോ അത് കല്പിച്ചിരിക്കുന്നത്” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്. <verse eid="EZK 39:5" /><verse number="6" style="v" sid="EZK 39:6" />“മാഗോഗിലും തീരപ്രദേശങ്ങളിൽ നിർഭയം വസിക്കുന്നവരുടെ ഇടയിലും ഞാൻ തീ അയയ്ക്കും; ഞാൻ യഹോവ എന്നു അവർ അറിയും.<verse eid="EZK 39:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 39:7" />ഇങ്ങനെ ഞാൻ എന്‍റെ വിശുദ്ധനാമം എന്‍റെ ജനമായ യിസ്രായേലിന്‍റെ നടുവിൽ വെളിപ്പെടുത്തും; ഇനി എന്‍റെ വിശുദ്ധനാമം അശുദ്ധമാക്കുവാൻ ഞാൻ സമ്മതിക്കുകയില്ല; ഞാൻ യിസ്രായേലിൽ പരിശുദ്ധനായ യഹോവയാകുന്നു എന്നു ജനതകൾ അറിയും. <verse eid="EZK 39:7" /><verse number="8" style="v" sid="EZK 39:8" />ഇതാ, അത് വരുന്നു; അത് സംഭവിക്കും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു; “ഇതത്രേ ഞാൻ അരുളിച്ചെയ്ത ദിവസം.<verse eid="EZK 39:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 39:9" />“യിസ്രായേലിന്‍റെ പട്ടണങ്ങളിൽ വസിക്കുന്നവർ പുറപ്പെട്ടു പരിച, പലക, വില്ല്, അമ്പ്, കുറുവടി, കുന്തം മുതലായ ആയുധങ്ങൾ എടുത്തു തീ കത്തിക്കും; അവർ അവ കൊണ്ടു ഏഴു വര്‍ഷം തീ കത്തിക്കും. <verse eid="EZK 39:9" /><verse number="10" style="v" sid="EZK 39:10" />വയലിൽനിന്നു വിറകു ശേഖരിക്കുകയോ, കാട്ടിൽനിന്നു വിറകു വെട്ടുകയോ ചെയ്യാതെ ആയുധങ്ങൾ തന്നെ അവർ കത്തിക്കും; അവരെ കൊള്ളയിട്ടവരെ അവർ കൊള്ളയിടുകയും അവരെ കവർച്ച ചെയ്തവരെ കവർച്ച ചെയ്യുകയും ചെയ്യും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 39:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 39:11" />അന്നു ഞാൻ ഗോഗിന് യിസ്രായേലിൽ ഒരു ശ്മശാനഭൂമി കൊടുക്കും. കടലിന് കിഴക്കുവശത്ത് വഴിപോക്കരുടെ താഴ്വര തന്നെ; അവിടെ അവർ ഗോഗിനെയും അവന്‍റെ സകലപുരുഷാരത്തെയും അടക്കം ചെയ്യുന്നതുനിമിത്തം വഴിപോക്കർക്ക് അത് മാർഗതടസ്സമായിത്തീരും; അതിന് ഹാമോൻ-ഗോഗ് (ഗോഗ് പുരുഷാരത്തിന്‍റെ) താഴ്വര എന്നു അവർ വിളിക്കും. <verse eid="EZK 39:11" /><verse number="12" style="v" sid="EZK 39:12" />യിസ്രായേൽഗൃഹം അവരെ അടക്കം ചെയ്തുതീർത്ത്, ദേശം വെടിപ്പാക്കുവാൻ ഏഴു മാസം വേണ്ടിവരും. <verse eid="EZK 39:12" /><verse number="13" style="v" sid="EZK 39:13" />ദേശത്തിലെ ജനം എല്ലാവരും ചേർന്ന് അവരെ അടക്കം ചെയ്യും; ഞാൻ എന്നെത്തന്നെ മഹത്വീകരിക്കുന്ന നാളിൽ അത് അവർക്ക് കീർത്തിയായിരിക്കും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 39:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 39:14" />“ദേശമെല്ലാം വെടിപ്പാക്കേണ്ടതിന് അതിൽ ശേഷിച്ച ശവങ്ങൾ അടക്കുവാൻ ദേശത്തിൽ ചുറ്റി സഞ്ചരിക്കുന്ന പതിവുജോലിക്കാരെ നിയമിക്കും; ഏഴു മാസം കഴിഞ്ഞശേഷം അവർ പരിശോധന കഴിക്കും. <verse eid="EZK 39:14" /><verse number="15" style="v" sid="EZK 39:15" />അവർ ദേശത്തു ചുറ്റി സഞ്ചരിക്കുമ്പോൾ, അവരിൽ ഒരുവൻ ഒരു മനുഷ്യാസ്ഥി കണ്ടാൽ അതിനരികിൽ ഒരു അടയാളം വയ്ക്കും; അടക്കം ചെയ്യുന്നവർ അത് ഹാമോൻ-ഗോഗ് താഴ്വരയിൽ കൊണ്ടുപോയി അടക്കം ചെയ്യും. <verse eid="EZK 39:15" /><verse number="16" style="v" sid="EZK 39:16" />ഹമോനാ (പുരുഷാരം) എന്ന പേരിൽ ഒരു നഗരമുണ്ടാകും; ഇങ്ങനെ അവർ ദേശത്തെ വെടിപ്പാക്കും.<verse eid="EZK 39:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 39:17" />“മനുഷ്യപുത്രാ, യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: സകലവിധ പക്ഷികളോടും എല്ലാ കാട്ടുമൃഗങ്ങളോടും നീ പറയേണ്ടത്: നിങ്ങൾ കൂടിവരുവിൻ; നിങ്ങൾ മാംസം തിന്നുകയും രക്തം കുടിക്കുകയും ചെയ്യേണ്ടതിന് ഞാൻ യിസ്രായേൽ പർവ്വതങ്ങളിൽ ഒരു മഹായാഗമായി നിങ്ങൾക്ക് വേണ്ടി അറുക്കുവാൻ പോകുന്ന എന്‍റെ യാഗത്തിന് നാലുഭാഗത്തുനിന്നും വന്നുകൂടുവിൻ. <verse eid="EZK 39:17" /><verse number="18" style="v" sid="EZK 39:18" />നിങ്ങൾ വീരന്മാരുടെ മാംസം തിന്ന് ഭൂമിയിലെ പ്രഭുക്കന്മാരുടെ രക്തം കുടിക്കണം; അവരെല്ലാം ബാശാനിലെ തടിപ്പിച്ച ആട്ടുകൊറ്റന്മാരും കുഞ്ഞാടുകളും കോലാട്ടുകൊറ്റന്മാരും കാളകളും തന്നെ. <verse eid="EZK 39:18" /><verse number="19" style="v" sid="EZK 39:19" />ഞാൻ നിങ്ങൾക്ക് വേണ്ടി അറുത്തിരിക്കുന്ന എന്‍റെ യാഗത്തിൽനിന്ന് നിങ്ങൾ തൃപ്തരാകുവോളം മേദസ്സു തിന്നുകയും ലഹരിയാകുവോളം രക്തം കുടിക്കുകയും ചെയ്യും. <verse eid="EZK 39:19" /><verse number="20" style="v" sid="EZK 39:20" />ഇങ്ങനെ നിങ്ങൾ എൻ്റെ മേശയിങ്കൽ കുതിരകളെയും വാഹനമൃഗങ്ങളെയും വീരന്മാരെയും സകലയോദ്ധാക്കളെയുംകൊണ്ടും നിറയും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 39:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 39:21" />ഞാൻ എന്‍റെ മഹത്വം ജനതകളുടെ ഇടയിൽ സ്ഥാപിക്കും; ഞാൻ നടത്തിയിരിക്കുന്ന എന്‍റെ ന്യായവിധിയും ഞാൻ അവരുടെ മേൽ വച്ച എന്‍റെ കയ്യും സകലജനതകളും കാണും. <verse eid="EZK 39:21" /><verse number="22" style="v" sid="EZK 39:22" />അങ്ങനെ അന്നുമുതൽ, ഞാൻ തങ്ങളുടെ ദൈവമായ യഹോവയെന്ന് യിസ്രായേൽഗൃഹം അറിയും. <verse eid="EZK 39:22" /><verse number="23" style="v" sid="EZK 39:23" />യിസ്രായേൽഗൃഹം അവരുടെ അകൃത്യം നിമിത്തം പ്രവാസത്തിലേക്കു പോകേണ്ടിവന്നു എന്നും, അവർ എന്നോട് ദ്രോഹം ചെയ്തതുകൊണ്ട് ഞാൻ എന്‍റെ മുഖം അവർക്ക് മറച്ച്, അവരെല്ലാം വാൾകൊണ്ടു വീഴേണ്ടതിന് അവരെ അവരുടെ വൈരികളുടെ കയ്യിൽ ഏല്പിച്ചു എന്നും ജനതകൾ അറിയും. <verse eid="EZK 39:23" /><verse number="24" style="v" sid="EZK 39:24" />അവരുടെ അശുദ്ധിക്കും അവരുടെ അതിക്രമങ്ങൾക്കും തക്കവിധം ഞാൻ അവരോടു പ്രവർത്തിച്ച്, എന്‍റെ മുഖം അവർക്ക് മറച്ചു.”<verse eid="EZK 39:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 39:25" />അതുകൊണ്ട് യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഇപ്പോൾ ഞാൻ യാക്കോബിന്‍റെ പ്രവാസികളെ മടക്കിവരുത്തി, എല്ലാ യിസ്രായേൽ ഗൃഹത്തോടും കരുണ ചെയ്തു, എന്‍റെ വിശുദ്ധനാമംനിമിത്തം തീക്ഷ്ണത കാണിക്കും. <verse eid="EZK 39:25" /><verse number="26" style="v" sid="EZK 39:26" />ഞാൻ അവരെ ജനതകളുടെ ഇടയിൽനിന്ന് മടക്കിവരുത്തി, അവരുടെ ശത്രുക്കളുടെ ദേശങ്ങളിൽനിന്ന് അവരെ ശേഖരിച്ച് പല ജനതകളുടെയും കൺമുമ്പിൽ എന്നെത്തന്നെ അവരിൽ വിശുദ്ധീകരിച്ചശേഷം <verse eid="EZK 39:26" /><verse number="27" style="v" sid="EZK 39:27" />ആരും അവരെ ഭയപ്പെടുത്താതെ അവർ അവരുടെ ദേശത്ത് നിർഭയമായി വസിക്കുമ്പോൾ, അവരുടെ ലജ്ജയും, എന്നോട് ചെയ്തിരിക്കുന്ന സർവ്വദ്രോഹങ്ങളും മറക്കും. <verse eid="EZK 39:27" /><verse number="28" style="v" sid="EZK 39:28" />ഞാൻ അവരെ ജനതകളുടെ ഇടയിൽ പ്രവാസികളായി കൊണ്ടുപോയെങ്കിലും, അവരിൽ ആരെയും അവിടെ വിട്ടുകളയാതെ അവരുടെ ദേശത്തേക്ക് കൂട്ടിവരുത്തുകയും ചെയ്തതിനാൽ ഞാൻ അവരുടെ ദൈവമായ യഹോവ എന്നു അവർ അറിയും. <verse eid="EZK 39:28" /><verse number="29" style="v" sid="EZK 39:29" />ഞാൻ യിസ്രായേൽഗൃഹത്തിന്മേൽ എന്‍റെ ആത്മാവിനെ പകർന്നിരിക്കുകയാൽ ഇനി എന്‍റെ മുഖം അവർക്ക് മറയ്ക്കുകയുമില്ല” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 39:29" /></para>
  <chapter eid="EZK 39" />
  <chapter number="40" style="c" sid="EZK 40" />
  <para style="s">ദൈവാലയനിർമിതിക്കുള്ള സ്ഥലം പുനഃസ്ഥാപിക്കപ്പെടുന്നു</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 40:1" />ഞങ്ങളുടെ ബാബിലോന്യ പ്രവാസത്തിന്‍റെ ഇരുപത്തഞ്ചാം ആണ്ടിന്‍റെ ആരംഭത്തിൽ പത്താം തീയതി, നഗരം പിടിക്കപ്പെട്ടതിൻ്റെ പതിനാലാം ആണ്ടിൽ, അതേ ദിവസം തന്നെ, യഹോവയുടെ കൈ എന്‍റെ മേൽ വന്ന് എന്നെ അവിടേക്കു കൊണ്ടുപോയി. <verse eid="EZK 40:1" /><verse number="2" style="v" sid="EZK 40:2" />ദിവ്യദർശനങ്ങളിൽ അവിടുന്ന് എന്നെ യിസ്രായേൽദേശത്തു കൊണ്ടുചെന്ന് ഏറ്റവും ഉയർന്ന ഒരു പർവ്വതത്തിന്മേൽ നിർത്തി; അതിന്മേൽ തെക്കുഭാഗത്ത് ഒരു നഗരത്തിന്‍റെ രൂപംപോലെ ഒന്ന് കാണുവാനുണ്ടായിരുന്നു. <verse eid="EZK 40:2" /><verse number="3" style="v" sid="EZK 40:3" />അവിടുന്ന് എന്നെ അവിടെ കൊണ്ടുചെന്നു; അവിടെ ഒരു പുരുഷൻ ഉണ്ടായിരുന്നു; അവൻ കാഴ്ചക്ക് താമ്രംപോലെ ആയിരുന്നു; അവന്‍റെ കയ്യിൽ ഒരു ചണച്ചരടും അളവുദണ്ഡും ഉണ്ടായിരുന്നു; അവൻ പടിവാതില്ക്കൽ നിന്നു. <verse eid="EZK 40:3" /><verse number="4" style="v" sid="EZK 40:4" />ആ പുരുഷൻ എന്നോട്: “മനുഷ്യപുത്രാ, നീ കണ്ണുകൊണ്ട് നോക്കി, ചെവികൊണ്ട് കേട്ടു, ഞാൻ നിന്നെ കാണിക്കുവാൻ പോകുന്നതെല്ലാം ശ്രദ്ധിച്ചുകൊള്ളുക; അവ നിനക്കു കാണിച്ചുതരുവാനായിട്ടാകുന്നു ഞാൻ നിന്നെ ഇവിടെ കൊണ്ടുവന്നത്; നീ കാണുന്നത് സകലവും യിസ്രായേൽ ഗൃഹത്തോട് അറിയിക്കുക” എന്നു കല്പിച്ചു.<verse eid="EZK 40:4" /></para>
  <para style="s">കിഴക്കേ ഗോപുരം</para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 40:5" />എന്നാൽ ആലയത്തിന് പുറമെ ചുറ്റും ഒരു മതിൽ ഉണ്ടായിരുന്നു; ആ പുരുഷന്‍റെ കയ്യിൽ ആറു മുഴം നീളമുള്ള ഒരു അളവുദണ്ഡ് ഉണ്ടായിരുന്നു; ഓരോ മുഴവും, ഒരു മുഴത്തോട് നാലു വിരലിൻ്റെ വീതിയും കൂടിയതായിരുന്നു; അവൻ മതിൽ അളന്നു; വീതി ഒരു ദണ്ഡ്, ഉയരം ഒരു ദണ്ഡ്; <verse eid="EZK 40:5" /><verse number="6" style="v" sid="EZK 40:6" />പിന്നെ അവൻ കിഴക്കോട്ടു ദർശനമുള്ള ഗോപുരത്തിൽ ചെന്നു, അതിന്‍റെ പടികളിൽ കയറി ഗോപുരത്തിൻ്റെ ഉമ്മരപ്പടി അളന്നു; അതിന്‍റെ വീതി ഒരു ദണ്ഡ്; മറ്റെ ഉമ്മരപ്പടിയുടെ വീതിയും ഒരു ദണ്ഡ്; <verse eid="EZK 40:6" /><verse number="7" style="v" sid="EZK 40:7" />ഓരോ കാവൽമാടത്തിനും ഒരു ദണ്ഡു നീളവും ഒരു ദണ്ഡു വീതിയും ഉണ്ടായിരുന്നു; കാവൽമാടങ്ങൾ തമ്മിൽ അയ്യഞ്ചു മുഴം അകന്നിരുന്നു; ഗോപുരത്തിൻ്റെ ഉമ്മരപ്പടി അകത്ത് ഗോപുരത്തിൻ്റെ പൂമുഖത്തിനരികിൽ ഒരു ദണ്ഡായിരുന്നു. <verse eid="EZK 40:7" /><verse number="8" style="v" sid="EZK 40:8" />അവൻ ഗോപുരത്തിൻ്റെ പൂമുഖം അകവശം അളന്നു; ഒരു ദണ്ഡ്. <verse eid="EZK 40:8" /><verse number="9" style="v" sid="EZK 40:9" />അവൻ ഗോപുരത്തിൻ്റെ പൂമുഖം അളന്നു; അത് എട്ട് മുഴവും അതിന്‍റെ കട്ടിളക്കാലുകൾ ഈ രണ്ടു മുഴവും ആയിരുന്നു; ഗോപുരത്തിൻ്റെ പൂമുഖം അകത്തോട്ടായിരുന്നു.<verse eid="EZK 40:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 40:10" />കിഴക്കോട്ടു ദർശനമുള്ള ഗോപുരത്തിൻ്റെ കാവൽമാടങ്ങൾ ഒരു വശത്ത് മൂന്നും മറുവശത്ത് മൂന്നും ആയിരുന്നു; മൂന്നിനും ഒരേ അളവായിരുന്നു; ഇരുവശത്തും ഉള്ള കട്ടിളക്കാലുകൾക്കും ഒരേ അളവായിരുന്നു. <verse eid="EZK 40:10" /><verse number="11" style="v" sid="EZK 40:11" />അവൻ ഗോപുരദ്വാരത്തിൻ്റെ വീതി അളന്നു; പത്തുമുഴം; ഗോപുരത്തിൻ്റെ നീളം അളന്നു: പതിമൂന്നു മുഴം. <verse eid="EZK 40:11" /><verse number="12" style="v" sid="EZK 40:12" />കാവൽമാടങ്ങളുടെ മുമ്പിൽ ഇരുവശത്തും ഓരോ മുഴം വീതമുള്ള അഴികൾ കൊണ്ടു അതിരിട്ടിരുന്നു; ഇരുവശത്തെയും കാവൽമാടങ്ങൾ ആറു മുഴം വീതമായിരുന്നു. <verse eid="EZK 40:12" /><verse number="13" style="v" sid="EZK 40:13" />അവൻ ഒരു കാവൽമാടത്തിൻ്റെ മേല്പുര മുതൽ മറ്റേതിന്‍റെ മേല്പുരവരെ അളന്നു; വാതിലോടു വാതിൽ ഇരുപത്തഞ്ചു മുഴമായിരുന്നു. <verse eid="EZK 40:13" /><verse number="14" style="v" sid="EZK 40:14" />അവൻ പൂമുഖം അളന്നു: ഇരുപതു മുഴം; ഗോപുരത്തിൻ്റെ കാവൽമാടങ്ങൾ ചുറ്റും പ്രാകാരത്തിലേക്കു തുറന്നിരുന്നു. <verse eid="EZK 40:14" /><verse number="15" style="v" sid="EZK 40:15" />പ്രവേശനദ്വാരത്തിന്‍റെ മുൻഭാഗംതുടങ്ങി അകത്തെ വാതില്‍ക്കലെ പൂമുഖത്തിൻ്റെ മുൻഭാഗംവരെ അമ്പത് മുഴമായിരുന്നു. <verse eid="EZK 40:15" /><verse number="16" style="v" sid="EZK 40:16" />ഗോപുരത്തിനും പൂമുഖത്തിനും അകത്തേക്ക് ചുറ്റിലും കാവൽമാടങ്ങളിലും ഇടത്തൂണുകളിലും അഴിയുള്ള ജാലകങ്ങൾ ഉണ്ടായിരുന്നു; ആ ജാലകങ്ങൾ അകത്ത് ചുറ്റും ഉണ്ടായിരുന്നു; ഓരോ ഇടത്തൂണിന്മേലും ഈന്തപ്പനകളും ഉണ്ടായിരുന്നു.<verse eid="EZK 40:16" /></para>
  <para style="s">പുറത്തെ പ്രാകാരം</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 40:17" />പിന്നെ അവൻ എന്നെ പുറത്തെ പ്രാകാരത്തിലേക്കു കൊണ്ടുചെന്നു; അവിടെ പ്രാകാരത്തിനു ചുറ്റും മണ്ഡപങ്ങളും ഓരോ കല്ത്തളവും ഉണ്ടായിരുന്നു; കല്ത്തളത്തിൽ മുപ്പതു മണ്ഡപങ്ങൾ ഉണ്ടായിരുന്നു. <verse eid="EZK 40:17" /><verse number="18" style="v" sid="EZK 40:18" />കല്ത്തളം ഗോപുരങ്ങളുടെ നീളത്തിനൊത്തവണ്ണം ഗോപുരങ്ങളുടെ പാർശ്വത്തിൽ ആയിരുന്നു; അത് താഴത്തെ കല്ത്തളം. <verse eid="EZK 40:18" /><verse number="19" style="v" sid="EZK 40:19" />പിന്നെ അവൻ താഴത്തെ ഗോപുരത്തിൻ്റെ മുൻഭാഗം മുതൽ അകത്തെ പ്രാകാരത്തിന്‍റെ പുറത്തെ മുൻഭാഗംവരെയുള്ള ദൂരം അളന്നു; കിഴക്കോട്ടും വടക്കോട്ടും നൂറുമുഴം വീതമായിരുന്നു.<verse eid="EZK 40:19" /></para>
  <para style="s">വടക്കേ ഗോപുരം</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 40:20" />വടക്കോട്ടു ദർശനമുള്ള പുറത്തെ പ്രാകാരഗോപുരത്തിൻ്റെ നീളവും വീതിയും അവൻ അളന്നു. <verse eid="EZK 40:20" /><verse number="21" style="v" sid="EZK 40:21" />അതിന്‍റെ കാവൽമാടങ്ങൾ ഇരുവശവും മൂന്നു വീതം ആയിരുന്നു; അതിന്‍റെ ഇടത്തൂണുകളും പൂമുഖവും ഒന്നാമത്തെ ഗോപുരത്തിൻ്റെ അളവുപോലെ ആയിരുന്നു; അതിന്‍റെ നീളം അമ്പത് മുഴവും വീതി ഇരുപത്തഞ്ചു മുഴവുമായിരുന്നു. <verse eid="EZK 40:21" /><verse number="22" style="v" sid="EZK 40:22" />അതിന്‍റെ ജാലകങ്ങളും പൂമുഖവും ഈന്തപ്പനകളും കിഴക്കോട്ടു ദർശനമുള്ള ഗോപുരത്തിൻ്റെ അളവുപോലെ ആയിരുന്നു; അതിലേക്ക് കയറാൻ ഏഴു പടികൾ ഉണ്ടായിരുന്നു; അതിന്‍റെ പൂമുഖം അതിന്‍റെ അകത്ത് ഭാഗത്തായിരുന്നു. <verse eid="EZK 40:22" /><verse number="23" style="v" sid="EZK 40:23" />അകത്തെ പ്രാകാരത്തിനു വടക്കോട്ടും കിഴക്കോട്ടും ഉള്ള ഗോപുരത്തിനു നേരെ ഒരു ഗോപുരം ഉണ്ടായിരുന്നു; ഒരു ഗോപുരംമുതൽ മറ്റെ ഗോപുരംവരെ അവൻ അളന്നു: നൂറുമുഴം.<verse eid="EZK 40:23" /></para>
  <para style="s">തെക്കേ ഗോപുരം</para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 40:24" />പിന്നെ അവൻ എന്നെ തെക്കോട്ടു കൊണ്ടുചെന്നു; തെക്കോട്ട് ഒരു ഗോപുരം; അതിന്‍റെ ഇടത്തൂണുകളും പൂമുഖവും അവൻ ഈ അളവുപോലെ തന്നെ അളന്നു. <verse eid="EZK 40:24" /><verse number="25" style="v" sid="EZK 40:25" />ആ ജാലകങ്ങൾപോലെ ഇതിനും അതിന്‍റെ പൂമുഖത്തിനും ചുറ്റും ജാലകങ്ങൾ ഉണ്ടായിരുന്നു; നീളം അമ്പത് മുഴവും വീതി ഇരുപത്തഞ്ചു മുഴവും ആയിരുന്നു. <verse eid="EZK 40:25" /><verse number="26" style="v" sid="EZK 40:26" />അതിലേക്ക് കയറുവാൻ ഏഴു പടികൾ ഉണ്ടായിരുന്നു; അതിന്‍റെ പൂമുഖം അതിന്‍റെ അകത്തുഭാഗത്തായിരുന്നു; അതിന് അതിന്‍റെ ഇടത്തൂണുകളിന്മേൽ ഈന്തപ്പനകൾ ഇരുവശവും ഓരോന്നുവീതം ഉണ്ടായിരുന്നു. <verse eid="EZK 40:26" /><verse number="27" style="v" sid="EZK 40:27" />അകത്തെ പ്രാകാരത്തിനു തെക്കോട്ട് ഒരു ഗോപുരം ഉണ്ടായിരുന്നു; തെക്കോട്ടുള്ള ഗോപുരംമുതൽ മറ്റെ ഗോപുരംവരെ അവൻ അളന്നു: നൂറുമുഴം.<verse eid="EZK 40:27" /></para>
  <para style="s">അകത്തെ പ്രാകാരത്തിൻ്റെ കവാടങ്ങൾ</para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 40:28" />പിന്നെ അവൻ തെക്കേ ഗോപുരത്തിൽകൂടി എന്നെ അകത്തെ പ്രാകാരത്തിൽ കൊണ്ടുചെന്നു; അവൻ തെക്കേ ഗോപുരവും ഈ അളവുപോലെ തന്നെ അളന്നു. <verse eid="EZK 40:28" /><verse number="29" style="v" sid="EZK 40:29" />അതിന്‍റെ കാവൽമാടങ്ങളും ഇടത്തൂണുകളും പൂമുഖവും ഈ അളവുപോലെ തന്നെ ആയിരുന്നു; അതിനും അതിന്‍റെ പൂമുഖത്തിനു ചുറ്റും ജാലകങ്ങൾ ഉണ്ടായിരുന്നു; അത് അമ്പത് മുഴം നീളവും ഇരുപത്തഞ്ചു മുഴം വീതിയും ഉള്ളതായിരുന്നു. <verse eid="EZK 40:29" /><verse number="30" style="v" sid="EZK 40:30" />പൂമുഖങ്ങൾ ചുറ്റും ഇരുപത്തഞ്ചു മുഴം നീളവും അഞ്ചുമുഴം വീതിയും ഉള്ളവയായിരുന്നു. <verse eid="EZK 40:30" /><verse number="31" style="v" sid="EZK 40:31" />അതിന്‍റെ പൂമുഖം പുറത്തെ പ്രാകാരത്തിന്‍റെ നേരെ ആയിരുന്നു; അതിന്‍റെ ഇടത്തൂണുകളിന്മേൽ ഈന്തപ്പനകൾ ഉണ്ടായിരുന്നു; അതിലേക്ക് കയറുവാൻ എട്ട് പടികൾ ഉണ്ടായിരുന്നു.<verse eid="EZK 40:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 40:32" />പിന്നെ അവൻ എന്നെ കിഴക്ക് അകത്തെ പ്രാകാരത്തിലേക്കു കൊണ്ടുചെന്നു; അവൻ ഗോപുരത്തെ ഈ അളവുപോലെ തന്നെ അളന്നു. <verse eid="EZK 40:32" /><verse number="33" style="v" sid="EZK 40:33" />അതിന്‍റെ കാവൽമാടങ്ങളും ഇടത്തൂണുകളും പൂമുഖവും ഈ അളവുപോലെ തന്നെ ആയിരുന്നു; അതിന്‍റെ പൂമുഖത്തിനു ചുറ്റും ജാലകങ്ങൾ ഉണ്ടായിരുന്നു; അത് അമ്പത് മുഴം നീളവും ഇരുപത്തഞ്ചു മുഴം വീതിയും ഉള്ളതായിരുന്നു; <verse eid="EZK 40:33" /><verse number="34" style="v" sid="EZK 40:34" />അതിന്‍റെ പൂമുഖം പുറത്തെ പ്രാകാരത്തിനു നേരെ ആയിരുന്നു; അതിന്‍റെ ഇടത്തൂണുകളിന്മേൽ ഇരുവശത്തും ഈന്തപ്പനകൾ ഉണ്ടായിരുന്നു; അതിലേക്ക് കയറുവാൻ എട്ട് പടികൾ ഉണ്ടായിരുന്നു.<verse eid="EZK 40:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 40:35" />പിന്നെ അവൻ എന്നെ വടക്കെ ഗോപുരത്തിലേക്കു കൊണ്ടുചെന്ന്, ഈ അളവുപോലെ തന്നെ അതും അളന്നു. <verse eid="EZK 40:35" /><verse number="36" style="v" sid="EZK 40:36" />അവൻ അതിന്‍റെ കാവൽമാടങ്ങളും ഇടത്തൂണുകളും പൂമുഖവും അളന്നു; ചുറ്റും അതിന് ജാലകങ്ങൾ ഉണ്ടായിരുന്നു; അതിന്‍റെ നീളം അമ്പത് മുഴവും വീതി ഇരുപത്തഞ്ചു മുഴവും ആയിരുന്നു. <verse eid="EZK 40:36" /><verse number="37" style="v" sid="EZK 40:37" />അതിന്‍റെ പൂമുഖം പുറത്തെ പ്രാകാരത്തിനു നേരെ ആയിരുന്നു; ഇടത്തൂണുകളിന്മേൽ ഇരുവശത്തും ഈന്തപ്പനകൾ ഉണ്ടായിരുന്നു; അതിലേക്ക് കയറുവാൻ എട്ട് പടികൾ ഉണ്ടായിരുന്നു.<verse eid="EZK 40:37" /></para>
  <para style="s">യാഗം ഒരുക്കുന്നതിനുള്ള അറകൾ</para>
  <para style="p">
    <verse number="38" style="v" sid="EZK 40:38" />അവിടെ ഒരു അറ ഉണ്ടായിരുന്നു; അതിലേക്കുള്ള പ്രവേശനം ഗോപുരത്തിൻ്റെ പൂമുഖത്തിൽകൂടി ആയിരുന്നു; അവിടെ അവർ ഹോമയാഗം കഴുകിയിരുന്നു. <verse eid="EZK 40:38" /><verse number="39" style="v" sid="EZK 40:39" />ഗോപുരത്തിൻ്റെ പൂമുഖത്ത് ഒരു വശത്ത് രണ്ടു മേശകളും, മറുവശത്ത് രണ്ടു മേശകളും ഉണ്ടായിരുന്നു; അവയുടെമേൽ ഹോമയാഗവും പാപയാഗവും അകൃത്യയാഗവും അറുത്തിരുന്നു. <verse eid="EZK 40:39" /><verse number="40" style="v" sid="EZK 40:40" />ഗോപുരപ്രവേശനത്തിൽ കയറുമ്പോൾ പുറമെ വടക്കുവശത്തു രണ്ടുമേശയും പൂമുഖത്തിൻ്റെ മറുവശത്ത് രണ്ടുമേശയും ഉണ്ടായിരുന്നു. <verse eid="EZK 40:40" /><verse number="41" style="v" sid="EZK 40:41" />ഗോപുരത്തിൻ്റെ പാർശ്വഭാഗത്ത് ഇരുവശത്തും നാലുവീതം, ഇങ്ങനെ എട്ട് മേശകൾ ഉണ്ടായിരുന്നു; അവയുടെമേൽ അവർ യാഗങ്ങളെ അറുത്തിരുന്നു. <verse eid="EZK 40:41" /><verse number="42" style="v" sid="EZK 40:42" />ഹോമയാഗത്തിനുള്ള നാലു മേശകളും ചെത്തിയ കല്ലുകൊണ്ടു ഒന്നര മുഴം നീളവും ഒന്നര മുഴം വീതിയും ഒരു മുഴം ഉയരവുമായി ഉണ്ടാക്കിയിരുന്നു; ഹോമയാഗവും ഹനനയാഗവും അറുക്കുവാനുള്ള ആയുധങ്ങൾ, അവയുടെമേൽ അവർ വച്ചിരുന്നു. <verse eid="EZK 40:42" /><verse number="43" style="v" sid="EZK 40:43" />അകത്ത് ചുറ്റിലും നാലു വിരൽ നീളമുള്ള കൊളുത്തുകൾ തറച്ചിരുന്നു; എന്നാൽ മേശകളുടെ മേൽ യാഗമാംസം വച്ചിരുന്നു.<verse eid="EZK 40:43" /></para>
  <para style="s">പുരോഹിതന്മാർക്കുള്ള മുറികൾ</para>
  <para style="p">
    <verse number="44" style="v" sid="EZK 40:44" />അകത്തെ ഗോപുരത്തിനു പുറത്ത്, അകത്തെ പ്രാകാരത്തിൽ തന്നെ, രണ്ടു മണ്ഡപങ്ങൾ ഉണ്ടായിരുന്നു; ഒന്ന് വടക്കെ ഗോപുരത്തിൻ്റെ പാർശ്വത്തിൽ തെക്കോട്ടു ദർശനമുള്ളതായിരുന്നു; മറ്റേത് തെക്കെഗോപുരത്തിൻ്റെ പാർശ്വത്തിൽ വടക്കോട്ടു ദർശനമുള്ളതായിരുന്നു. <verse eid="EZK 40:44" /><verse number="45" style="v" sid="EZK 40:45" />അവൻ എന്നോട് കല്പിച്ചത്: “തെക്കോട്ടു ദർശനമുള്ള ഈ മണ്ഡപം ആലയത്തിന്‍റെ ചുമതലക്കാരായ പുരോഹിതന്മാർക്കുള്ളത്. <verse eid="EZK 40:45" /><verse number="46" style="v" sid="EZK 40:46" />വടക്കോട്ടു ദർശനമുള്ള മണ്ഡപം യാഗപീഠത്തിന്‍റെ ചുമതലക്കാരായ പുരോഹിതന്മാർക്കുള്ളത്; ഇവർ യഹോവയ്ക്കു ശുശ്രൂഷ ചെയ്യേണ്ടതിന് അടുത്തുചെല്ലുന്ന ലേവ്യരിൽ സാദോക്കിന്‍റെ പുത്രന്മാരാകുന്നു.<verse eid="EZK 40:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="EZK 40:47" />അവൻ പ്രാകാരം അളന്നു; അത് നൂറുമുഴം നീളവും നൂറുമുഴം വീതിയും ഇങ്ങനെ സമചതുരമായിരുന്നു; യാഗപീഠമോ ആലയത്തിന്‍റെ മുൻവശത്തായിരുന്നു.<verse eid="EZK 40:47" /></para>
  <para style="s">പുതിയ ദൈവാലയം</para>
  <para style="p">
    <verse number="48" style="v" sid="EZK 40:48" />പിന്നെ അവൻ എന്നെ ആലയത്തിന്‍റെ പൂമുഖത്തു കൊണ്ടുചെന്നു; അവൻ പൂമുഖത്തിൻ്റെ കട്ടിളപ്പടി അളന്നു, ഇരുവശത്തും അഞ്ചു മുഴം വീതം; കട്ടിളപ്പടിയുടെ വീതിയോ ഇരുവശവും മൂന്നു മുഴം വീതം ആയിരുന്നു. <verse eid="EZK 40:48" /><verse number="49" style="v" sid="EZK 40:49" />പൂമുഖത്തിൻ്റെ നീളം ഇരുപതു മുഴം, വീതി പന്ത്രണ്ടു മുഴം, അതിലേക്ക് കയറുവാനുള്ള പടികൾ പത്തു; കട്ടിളപ്പടികൾക്കരികിൽ ഇരുവശത്തും ഓരോ തൂണുകൾ ഉണ്ടായിരുന്നു.<verse eid="EZK 40:49" /></para>
  <chapter eid="EZK 40" />
  <chapter number="41" style="c" sid="EZK 41" />
  <para style="s">ദൈവാലയത്തിന്‍റെ കട്ടിളപ്പടികൾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 41:1" />അനന്തരം അവൻ എന്നെ മന്ദിരത്തിലേക്കു കൊണ്ടുചെന്ന്, കട്ടിളപ്പടികൾ അളന്നു; കട്ടിളപ്പടികളുടെ വീതി ഒരു വശത്ത് ആറു മുഴവും മറുവശത്ത് ആറു മുഴവും ആയിരുന്നു. <verse eid="EZK 41:1" /><verse number="2" style="v" sid="EZK 41:2" />പ്രവേശനകവാടത്തിൻ്റെ വീതി പത്തു മുഴവും അതിന്‍റെ പാർശ്വഭിത്തികൾ ഒരു വശത്ത് അഞ്ചു മുഴവും മറുവശത്ത് അഞ്ചു മുഴവും ആയിരുന്നു; അവൻ മന്ദിരം അളന്നു: അതിന്‍റെ നീളം നാല്പതു മുഴം, വീതി ഇരുപതു മുഴം. <verse eid="EZK 41:2" /><verse number="3" style="v" sid="EZK 41:3" />പിന്നെ അവൻ അകത്തേക്കു ചെന്നു, പ്രവേശനകവാടത്തിൻ്റെ കട്ടിളപ്പടികൾ അളന്നു: ഘനം രണ്ടു മുഴവും അതിന്‍റെ ഉയരം ആറു മുഴവും കട്ടിളപ്പടികളുടെ വീതി ഏഴു മുഴം വീതവുമായിരുന്നു. <verse eid="EZK 41:3" /><verse number="4" style="v" sid="EZK 41:4" />അവൻ അതിന്‍റെ നീളം അളന്നു: ഇരുപതു മുഴം; വീതി മന്ദിരത്തിനൊത്തവിധം ഇരുപതു മുഴം; “ഇത് അതിവിശുദ്ധസ്ഥലം” എന്നു അവൻ എന്നോട് കല്പിച്ചു.<verse eid="EZK 41:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 41:5" />പിന്നെ അവൻ ആലയത്തിന്‍റെ ഭിത്തി അളന്നു: ഘനം ആറു മുഴം: ആലയത്തിന്‍റെ ചുറ്റുമുള്ള പാർശ്വമുറികളുടെ വീതി നാലു മുഴം. <verse eid="EZK 41:5" /><verse number="6" style="v" sid="EZK 41:6" />എന്നാൽ പാർശ്വമുറികൾ ഒന്നിന്‍റെ മേൽ ഒന്നായി മൂന്നു നിലയായും, ഒരു നിലയിൽ മുപ്പതു വീതവും ആയിരുന്നു; പാർശ്വമുറികൾക്കു ചുറ്റും തുലാങ്ങൾ ഉണ്ടായിരുന്നു; അവ ആലയത്തിനും പാർശ്വമുറികൾക്കും ഇടയിലുള്ള ഭിത്തിയെ താങ്ങിനിർത്തുവാൻ തക്കവിധം ചേർന്നിരുന്നു; എന്നാൽ തുലാങ്ങൾ ആലയഭിത്തിക്കകത്ത് എത്തിയിരുന്നില്ല. <verse eid="EZK 41:6" /><verse number="7" style="v" sid="EZK 41:7" />ആലയത്തിന്‍റെ മുകളിലേക്കു പോകുന്തോറും ചുറ്റിനുമുള്ള പാർശ്വമുറികൾക്ക് വിസ്താരം ഏറിയിരുന്നു; ആലയത്തിന് ചുറ്റും മുറിക്കകത്ത്, മുകളിലേക്കു പോകുന്തോറും വീതി കൂടിയിരുന്നു; അതുകൊണ്ട്, മുകളിലേക്കു ചെല്ലുന്തോറും അതിന്‍റെ ഘടനയ്ക്ക് വിസ്താരം ഏറിയിരുന്നു; താഴത്തെ നിലയിൽനിന്ന് മദ്ധ്യനിലയിൽക്കൂടി മുകളിലത്തെ നിലയിൽ കയറാം.<verse eid="EZK 41:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 41:8" />ഞാൻ ആലയത്തിന്‍റെ ചുറ്റിലും പൊക്കമുള്ള ഒരു തറ കണ്ടു; പാർശ്വമുറികളുടെ അടിസ്ഥാനങ്ങൾ ഒരു മുഴുദണ്ഡായിരുന്നു; അതായത് ആറു മുഴം വീതി. <verse eid="EZK 41:8" /><verse number="9" style="v" sid="EZK 41:9" />പാർശ്വമുറികളുടെ പുറംഭിത്തിയുടെ ഘനം അഞ്ചു മുഴമായിരുന്നു; <verse eid="EZK 41:9" /><verse number="10" style="v" sid="EZK 41:10" />എന്നാൽ ആലയത്തിന്‍റെ പാർശ്വമുറികൾക്കും മണ്ഡപങ്ങൾക്കും ഇടയിൽ ആലയത്തിന് ചുറ്റും ഇരുപതു മുഴം വീതിയുള്ള മുറ്റം ഉണ്ടായിരുന്നു. <verse eid="EZK 41:10" /><verse number="11" style="v" sid="EZK 41:11" />പാർശ്വമുറികളുടെ വാതിലുകൾ പുറംതിണ്ണയ്ക്കു നേരെ തുറന്നിരുന്നു; ഒരു വാതിൽ വടക്കോട്ടും ഒരു വാതിൽ തെക്കോട്ടും ആയിരുന്നു; പുറംതിണ്ണയുടെ വീതി ചുറ്റും അഞ്ചു മുഴമായിരുന്നു.<verse eid="EZK 41:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 41:12" />മുറ്റത്തിൻ്റെ മുമ്പിൽ പടിഞ്ഞാറോട്ടുള്ള കെട്ടിടം എഴുപത് മുഴം വീതിയുള്ളതും കെട്ടിടത്തിൻ്റെ ചുറ്റുമുള്ള ഭിത്തി അഞ്ചു മുഴം ഘനമുള്ളതും തൊണ്ണൂറു മുഴം നീളമുള്ളതും ആയിരുന്നു.<verse eid="EZK 41:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 41:13" />അവൻ ആലയം അളന്നു: നീളം നൂറുമുഴം; മുറ്റവും കെട്ടിടവും അതിന്‍റെ ഭിത്തികളും അളന്നു; അതിനും നൂറുമുഴം നീളം. <verse eid="EZK 41:13" /><verse number="14" style="v" sid="EZK 41:14" />ആലയത്തിന്‍റെ മുൻഭാഗത്തിൻ്റെയും കിഴക്കുള്ള മുറ്റത്തിൻ്റെയും വീതിയും നൂറുമുഴമായിരുന്നു.<verse eid="EZK 41:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 41:15" />പിന്നെ അവൻ മുറ്റത്തിൻ്റെ പിൻഭാഗത്ത് അതിനെതിരെയുള്ള കെട്ടിടത്തിൻ്റെ നീളവും അതിന് ഇരുവശത്തും ഉള്ള നടപ്പുരകളും അളന്നു; നൂറുമുഴം.</para>
  <para style="p" vid="EZK 41:15">അകത്തെ മന്ദിരത്തിനും പ്രാകാരത്തിന്‍റെ പൂമുഖങ്ങൾക്കും <verse eid="EZK 41:15" /><verse number="16" style="v" sid="EZK 41:16" />ഉമ്മരപ്പടികൾക്കും അഴിയുള്ള ജാലകങ്ങൾക്കും ഉമ്മരപ്പടിക്കു മേൽ മൂന്നു നിലയായി ചുറ്റും ഉണ്ടായിരുന്ന നടപ്പുരകൾക്കും നിലത്തുനിന്ന് ജാലകങ്ങൾ വരെ പലകയടിച്ചിരുന്നു; ജാലകങ്ങൾ മൂടിയിരുന്നു. <verse eid="EZK 41:16" /><verse number="17" style="v" sid="EZK 41:17" />അകത്തെ ആലയത്തിന്‍റെ വാതിലിന്‍റെ മുകൾഭാഗം വരെയും, പുറമെയും, ചുറ്റും എല്ലാ ഭിത്തിമേലും അകത്തും പുറത്തും ചിത്രപ്പണി ഉണ്ടായിരുന്നു. <verse eid="EZK 41:17" /><verse number="18" style="v" sid="EZK 41:18" />കെരൂബുകളും ഈന്തപ്പനകളും അതിന്മേൽ കൊത്തിയിരുന്നു; കെരൂബിനും കെരൂബിനും ഇടയിൽ ഓരോ ഈന്തപ്പനയും ഓരോ കെരൂബിനും ഈ രണ്ടു മുഖവും ഉണ്ടായിരുന്നു. <verse eid="EZK 41:18" /><verse number="19" style="v" sid="EZK 41:19" />മനുഷ്യമുഖം ഒരു വശത്തുള്ള ഈന്തപ്പനയുടെ നേരെയും ബാലസിംഹമുഖം മറുവശത്തുള്ള ഈന്തപ്പനയുടെ നേരെയും ആയിരുന്നു; ആലയത്തിന്‍റെ ചുറ്റും എല്ലായിടവും ഇങ്ങനെ ഉണ്ടാക്കിയിരുന്നു. <verse eid="EZK 41:19" /><verse number="20" style="v" sid="EZK 41:20" />നിലംമുതൽ വാതിലിന്‍റെ മുകൾഭാഗംവരെ കെരൂബുകളും ഈന്തപ്പനകളും ഉണ്ടായിരുന്നു; ഇങ്ങനെ ആയിരുന്നു മന്ദിരത്തിന്‍റെ ഭിത്തി.<verse eid="EZK 41:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 41:21" />മന്ദിരത്തിന് സമചതുരമായുള്ള കട്ടിളക്കാലുകളുണ്ടായിരുന്നു; അവ വിശുദ്ധമന്ദിരത്തിന്‍റെ മുമ്പിൽ യാഗപീഠംപോലെയുള്ളതായിരുന്നു. <verse eid="EZK 41:21" /><verse number="22" style="v" sid="EZK 41:22" />യാഗപീഠം മരംകൊണ്ടുള്ളതും, മൂന്നു മുഴം ഉയരവും രണ്ടു മുഴം നീളവും ഉള്ളതുമായിരുന്നു; അതിന്‍റെ കോണുകളും ചുവടും വശങ്ങളും മരംകൊണ്ടായിരുന്നു; അവൻ എന്നോട്: “ഇത് യഹോവയുടെ സന്നിധിയിലെ മേശയാകുന്നു” എന്നു കല്പിച്ചു. <verse eid="EZK 41:22" /><verse number="23" style="v" sid="EZK 41:23" />മന്ദിരത്തിനും അതിവിശുദ്ധമന്ദിരത്തിനും ഈ രണ്ടു കതകുകൾ ഉണ്ടായിരുന്നു. <verse eid="EZK 41:23" /><verse number="24" style="v" sid="EZK 41:24" />കതകുകൾക്ക് ഈ രണ്ടു മടക്കുപാളികൾ ഉണ്ടായിരുന്നു; ഒരു കതകിന് രണ്ടു മടക്കുപാളികൾ; മറ്റെ കതകിന് രണ്ടു മടക്കുപാളികൾ. <verse eid="EZK 41:24" /><verse number="25" style="v" sid="EZK 41:25" />ഭിത്തികളിൽ എന്നപോലെ മന്ദിരത്തിന്‍റെ കതകുകളിന്മേലും കെരൂബുകളും ഈന്തപ്പനകളും ഉണ്ടാക്കിയിരുന്നു; പുറമെ പൂമുഖത്തിൻ്റെ മുമ്പിൽ മരംകൊണ്ടുള്ള ഒരു വിതാനം ഉണ്ടായിരുന്നു. <verse eid="EZK 41:25" /><verse number="26" style="v" sid="EZK 41:26" />പൂമുഖത്തിൻ്റെ പാർശ്വങ്ങളിൽ ഇരുവശത്തും അഴിയുള്ള ജാലകങ്ങളും ഈന്തപ്പനകളും ഉണ്ടായിരുന്നു; ഇങ്ങനെയായിരുന്നു ആലയത്തിന്‍റെ പാർശ്വമുറികളുടെയും തുലാങ്ങളുടെയും പണികൾ.<verse eid="EZK 41:26" /></para>
  <chapter eid="EZK 41" />
  <chapter number="42" style="c" sid="EZK 42" />
  <para style="s">പുരോഹിതന്മാർക്കുള്ള മുറികൾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 42:1" />അനന്തരം ആ മനുഷ്യന്‍ എന്നെ വടക്കോട്ടുള്ള വഴിയായി പുറത്തെ പ്രാകാരത്തിലേക്ക് കൊണ്ടുപോയി; മുറ്റത്തിനു നേരെയും വടക്കോട്ടുള്ള കെട്ടിടത്തിനെതിരെയും ഉണ്ടായിരുന്ന മണ്ഡപത്തിലേക്ക് എന്നെ കൊണ്ടുചെന്നു. <verse eid="EZK 42:1" /><verse number="2" style="v" sid="EZK 42:2" />അതിന്‍റെ മുൻഭാഗത്തിന് നൂറുമുഴം നീളവും, വടക്കോട്ടു വാതിലും ഉണ്ടായിരുന്നു; വീതി അമ്പത് മുഴം. <verse eid="EZK 42:2" /><verse number="3" style="v" sid="EZK 42:3" />അകത്തെ പ്രാകാരത്തിനുള്ള ഇരുപതു മുഴത്തിനെതിരെയും പുറത്തെ പ്രാകാരത്തിനുള്ള കല്ത്തളത്തിനെതിരെയും മൂന്നു നിലയായി നടപ്പുരയ്ക്കു നേരെ നടപ്പുര ഉണ്ടായിരുന്നു. <verse eid="EZK 42:3" /><verse number="4" style="v" sid="EZK 42:4" />മണ്ഡപങ്ങളുടെ മുമ്പിൽ അകത്തോട്ടു പത്തുമുഴം വീതിയും നൂറുമുഴം നീളവുമുള്ള ഒരു നടപ്പുര ഉണ്ടായിരുന്നു. അവയുടെ വാതിലുകൾ വടക്കോട്ടായിരുന്നു. <verse eid="EZK 42:4" /><verse number="5" style="v" sid="EZK 42:5" />കെട്ടിടത്തിൻ്റെ താഴത്തെ മണ്ഡപങ്ങളിൽനിന്നും മദ്ധ്യത്തേതിൽനിന്നും എടുത്തതിനെക്കാൾ അധികം സ്ഥലം മുകളിലത്തെ മണ്ഡപങ്ങളിൽനിന്ന് നടപ്പുരകൾക്ക് എടുത്തിരുന്നതിനാൽ അവ നീളം കുറഞ്ഞവ ആയിരുന്നു. <verse eid="EZK 42:5" /><verse number="6" style="v" sid="EZK 42:6" />അവ മൂന്നു നിലയായിരുന്നു; എന്നാൽ അവയ്ക്കു പ്രാകാരങ്ങളുടെ തൂണുകൾപോലെ തൂണുകൾ ഇല്ലാതിരുന്നതിനാൽ, താഴത്തേതിനെക്കാളും മദ്ധ്യത്തേതിനെക്കാളും മുകളിലത്തേതിന്‍റെ തറയുടെ വിസ്താരം കുറവായിരുന്നു. <verse eid="EZK 42:6" /><verse number="7" style="v" sid="EZK 42:7" />പുറമെ മണ്ഡപങ്ങളുടെ നീളത്തിൽ പുറത്തെ പ്രാകാരത്തിന്‍റെ നേരെ മണ്ഡപങ്ങളുടെ മുൻവശത്തെ മതിലിന്‍റെ നീളം അമ്പത് മുഴം ആയിരുന്നു. <verse eid="EZK 42:7" /><verse number="8" style="v" sid="EZK 42:8" />പുറത്തെ പ്രാകാരത്തിലേക്കു ദർശനമുള്ള മണ്ഡപങ്ങളുടെ നീളം അമ്പത് മുഴമായിരുന്നു; എന്നാൽ മന്ദിരത്തിനെതിരെയുള്ള നീളം നൂറുമുഴമായിരുന്നു; <verse eid="EZK 42:8" /><verse number="9" style="v" sid="EZK 42:9" />പുറത്തെ പ്രാകാരത്തിൽനിന്ന് ഇവയിലേക്കു കടന്നാൽ കിഴക്കോട്ടു ഈ മണ്ഡപങ്ങൾക്കു താഴെ ഒരു പ്രവേശനം ഉണ്ടായിരുന്നു.<verse eid="EZK 42:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 42:10" />കിഴക്കോട്ടുള്ള പ്രാകാരത്തിന്‍റെ മതിലിന്‍റെ ഘനത്തിനൊത്ത് മുറ്റത്തിനും കെട്ടിടത്തിനുമെതിരായി മണ്ഡപങ്ങൾ ഉണ്ടായിരുന്നു. <verse eid="EZK 42:10" /><verse number="11" style="v" sid="EZK 42:11" />അവയുടെ മുമ്പിലുള്ള വഴി വടക്കോട്ടുള്ള മണ്ഡപങ്ങളുടെ അളവുപോലെ ആയിരുന്നു; അവയ്ക്ക് തുല്യമായ നീളവും വീതിയും ഉണ്ടായിരുന്നു; അവയുടെ അകത്തേക്കും പുറത്തേക്കുമുള്ള വഴികളും മറ്റു സംവിധാനങ്ങളും ഒരുപോലെ തന്നെ. <verse eid="EZK 42:11" /><verse number="12" style="v" sid="EZK 42:12" />തെക്കോട്ടുള്ള മണ്ഡപങ്ങളുടെ പ്രവേശനങ്ങൾ പോലെ ഒരു പ്രവേശനം വഴിയുടെ മുൻഭാഗത്ത് ഉണ്ടായിരുന്നു; അവയിലേക്കു കടന്നാൽ, കിഴക്കോട്ടുള്ള മതിലിനു നേരെ മുമ്പിലുള്ള വഴിയുടെ മുമ്പിൽ പ്രവേശിക്കാം.<verse eid="EZK 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 42:13" />പിന്നെ അവൻ എന്നോട് കല്പിച്ചത്: “മുറ്റത്തിൻ്റെ മുമ്പിലുള്ള വടക്കെ മണ്ഡപങ്ങളും തെക്കേ മണ്ഡപങ്ങളും യഹോവയോട് അടുത്തുചെല്ലുന്ന പുരോഹിതന്മാർ അതിവിശുദ്ധവസ്തുക്കൾ ഭക്ഷിക്കുവാനുള്ള വിശുദ്ധമണ്ഡപങ്ങളാകുന്നു<note caller="+" style="f"><char style="fr" closed="false">42:13 </char><char style="fq" closed="false">വിശുദ്ധമണ്ഡപങ്ങളാകുന്നു </char><char style="ft" closed="false">പുരോഹിതന്‍റെ സ്വകാര്യ മുറി</char></note>; അവിടെ അവർ അതിവിശുദ്ധവസ്തുക്കളും ഭോജനയാഗവും പാപയാഗവും അകൃത്യയാഗവും വയ്ക്കേണം. ആ സ്ഥലം വിശുദ്ധമാണല്ലോ. <verse eid="EZK 42:13" /><verse number="14" style="v" sid="EZK 42:14" />പുരോഹിതന്മാർ വിശുദ്ധമന്ദിരത്തിൽനിന്ന് പുറത്തെ പ്രാകാരത്തിലേക്കു കടക്കാതെ വേണം അതിൽ പ്രവേശിക്കുവാൻ; ശുശ്രൂഷയ്ക്കുള്ള അവരുടെ വസ്ത്രം അവർ അവിടെ വച്ചേക്കണം; അവ വിശുദ്ധമാണല്ലോ; വേറെ വസ്ത്രം ധരിച്ച ശേഷം മാത്രമേ അവർ ജനത്തിനുള്ള സ്ഥലത്ത് പോകാവു.“<verse eid="EZK 42:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 42:15" />അവൻ അകത്തെ ആലയം അളന്നു തീർന്നശേഷം, കിഴക്കോട്ടു ദർശനമുള്ള വാതില്ക്കൽകൂടി എന്നെ കൊണ്ടു ചെന്നു അവിടം ചുറ്റും അളന്നു. <verse eid="EZK 42:15" /><verse number="16" style="v" sid="EZK 42:16" />അവൻ കിഴക്കുഭാഗം ദണ്ഡുകൊണ്ട് അളന്നു; ആകെ അഞ്ഞൂറ് മുഴം. <verse eid="EZK 42:16" /><verse number="17" style="v" sid="EZK 42:17" />അവൻ വടക്കുഭാഗം ദണ്ഡുകൊണ്ട് അളന്നു; ആകെ അഞ്ഞൂറ് മുഴം. <verse eid="EZK 42:17" /><verse number="18" style="v" sid="EZK 42:18" />അവൻ തെക്കുഭാഗം ദണ്ഡുകൊണ്ട് അളന്നു; ആകെ അഞ്ഞൂറ് മുഴം. <verse eid="EZK 42:18" /><verse number="19" style="v" sid="EZK 42:19" />അവൻ പടിഞ്ഞാറോട്ടു തിരിഞ്ഞ് ദണ്ഡുകൊണ്ട് അളന്നു; അഞ്ഞൂറ് മുഴം. <verse eid="EZK 42:19" /><verse number="20" style="v" sid="EZK 42:20" />ഇങ്ങനെ അവൻ നാലുവശവും അളന്നു; വിശുദ്ധമായതും സാമാന്യമായതും തമ്മിൽ വേർതിരിക്കുവാൻ തക്കവണ്ണം അഞ്ഞൂറ് മുഴം നീളത്തിലും അഞ്ഞൂറുമുഴം വീതിയിലും ഒരു മതിൽ അതിന് ചുറ്റും ഉണ്ടായിരുന്നു.<verse eid="EZK 42:20" /></para>
  <chapter eid="EZK 42" />
  <chapter number="43" style="c" sid="EZK 43" />
  <para style="s">ദൈവത്തിന്‍റെ തേജസ്സ് ദൈവാലയത്തിലേക്കു മടങ്ങിവരുന്നു</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 43:1" />അനന്തരം ആ മനുഷ്യന്‍ എന്നെ ഗോപുരത്തിലേക്ക്, കിഴക്കോട്ടുള്ള ഗോപുരത്തിലേക്കു തന്നെ, കൊണ്ടുചെന്നു; <verse eid="EZK 43:1" /><verse number="2" style="v" sid="EZK 43:2" />അപ്പോൾ യിസ്രായേലിന്‍റെ ദൈവത്തിന്‍റെ തേജസ്സ് കിഴക്കുനിന്ന് വന്നു; അതിന്‍റെ മുഴക്കം പെരുവെള്ളത്തിന്‍റെ ഇരച്ചിൽപോലെ ആയിരുന്നു; ഭൂമി അവിടുത്തെ തേജസ്സുകൊണ്ട് പ്രകാശിച്ചു. <verse eid="EZK 43:2" /><verse number="3" style="v" sid="EZK 43:3" />ഇതു ഞാൻ കണ്ട ദർശനംപോലെ ആയിരുന്നു; നഗരത്തെ നശിപ്പിക്കുവാൻ ഞാൻ വന്നപ്പോൾ കണ്ട ദർശനംപോലെ തന്നെ; ഈ ദർശനങ്ങൾ കെബാർനദീതീരത്തുവച്ച് ഞാൻ കണ്ട ദർശനംപോലെ ആയിരുന്നു; അപ്പോൾ ഞാൻ കവിണ്ണുവീണു. <verse eid="EZK 43:3" /><verse number="4" style="v" sid="EZK 43:4" />യഹോവയുടെ തേജസ്സ് കിഴക്കോട്ടു ദർശനമുള്ള ഗോപുരത്തിൽകൂടി ആലയത്തിലേക്കു പ്രവേശിച്ചു. <verse eid="EZK 43:4" /><verse number="5" style="v" sid="EZK 43:5" />ആത്മാവ് എന്നെ എടുത്ത് അകത്തെ പ്രാകാരത്തിലേക്കു കൊണ്ടുചെന്നു; യഹോവയുടെ തേജസ്സ് ആലയത്തെ നിറച്ചിരുന്നു.<verse eid="EZK 43:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 43:6" />ആ പുരുഷൻ എന്‍റെ അടുക്കൽ നില്ക്കുമ്പോൾ, ആലയത്തിൽനിന്ന് ഒരുവൻ എന്നോട് സംസാരിക്കുന്നത് ഞാൻ കേട്ടു. <verse eid="EZK 43:6" /><verse number="7" style="v" sid="EZK 43:7" />അവിടുന്ന് എന്നോട് അരുളിച്ചെയ്തത്: “മനുഷ്യപുത്രാ, ഇത് ഞാൻ എന്നേക്കും യിസ്രായേൽ മക്കളുടെ മദ്ധ്യത്തിൽ വസിക്കുന്ന എന്‍റെ സിംഹാസനത്തിന്‍റെ സ്ഥലവും എന്‍റെ കാലടികളുടെ സ്ഥലവും ആകുന്നു; യിസ്രായേൽഗൃഹമോ, അവരുടെ രാജാക്കന്മാരോ, അവരുടെ പരസംഗംകൊണ്ടും പൂജാഗിരികളിലെ അവരുടെ രാജാക്കന്മാരുടെ ശവങ്ങൾകൊണ്ടും <verse eid="EZK 43:7" /><verse number="8" style="v" sid="EZK 43:8" />എനിക്കും അവർക്കും ഇടയിൽ ഒരു ഭിത്തി മാത്രം ഉണ്ടായിരിക്കത്തക്കവിധം അവരുടെ ഉമ്മരപ്പടി എന്‍റെ ഉമ്മരപ്പടിയും അവരുടെ കട്ടിള എന്‍റെ കട്ടിളയും ആക്കുന്നതുകൊണ്ടും എന്‍റെ വിശുദ്ധനാമത്തെ ഇനി അശുദ്ധമാക്കേണ്ടതല്ല; അവർ ചെയ്ത മ്ലേച്ഛതകളാൽ അവർ എന്‍റെ വിശുദ്ധനാമത്തെ അശുദ്ധമാക്കിയിരിക്കുന്നു; അതുകൊണ്ട് ഞാൻ എന്‍റെ കോപത്തിൽ അവരെ നശിപ്പിച്ചു. <verse eid="EZK 43:8" /><verse number="9" style="v" sid="EZK 43:9" />ഇപ്പോൾ അവർ അവരുടെ പരസംഗവും രാജാക്കന്മാരുടെ ശവങ്ങളും എന്‍റെ മുമ്പിൽനിന്ന് നീക്കിക്കളയട്ടെ; എന്നാൽ ഞാൻ അവരുടെ മദ്ധ്യത്തിൽ എന്നേക്കും വസിക്കും.<verse eid="EZK 43:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 43:10" />മനുഷ്യപുത്രാ, യിസ്രായേൽഗൃഹം അവരുടെ അകൃത്യങ്ങളെക്കുറിച്ച് ലജ്ജിക്കേണ്ടതിന് നീ ഈ ആലയം അവരെ കാണിക്കുക; അവർ അതിന്‍റെ മാതൃക അളക്കട്ടെ. <verse eid="EZK 43:10" /><verse number="11" style="v" sid="EZK 43:11" />അവർ ചെയ്ത സകലത്തെയുംകുറിച്ച് അവർ ലജ്ജിച്ചാൽ നീ ആലയത്തിന്‍റെ ആകൃതിയും സംവിധാനവും, അകത്തേക്കും പുറത്തേക്കുമുള്ള വാതിലുകളും, അതിന്‍റെ മാതൃകകളും സകലവ്യവസ്ഥകളും അതിന്‍റെ സകലനിയമങ്ങളും അവരെ അറിയിച്ച്, അവർ അതിന്‍റെ എല്ലാ ചട്ടങ്ങളും വ്യവസ്ഥകളും പ്രമാണിച്ച് അനുഷ്ഠിക്കേണ്ടതിന് അതെല്ലാം അവർ കാണത്തക്കവിധം എഴുതിവയ്ക്കുക. <verse eid="EZK 43:11" /><verse number="12" style="v" sid="EZK 43:12" />ഇതാകുന്നു ആലയത്തെക്കുറിച്ചുള്ള പ്രമാണം; പർവ്വതത്തിന്‍റെ മുകളിൽ അതിന്‍റെ അതിർത്തിക്കകമെല്ലാം അതിവിശുദ്ധമായിരിക്കേണം; അതേ, ഇതാകുന്നു ആലയത്തെക്കുറിച്ചുള്ള പ്രമാണം.<verse eid="EZK 43:12" /></para>
  <para style="s">യാഗപീഠം</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 43:13" />മുഴപ്രകാരം യാഗപീഠത്തിന്‍റെ അളവ് ഇവയാണ് മുഴം ഒന്നിന് ഒരു മുഴവും നാലു വിരലും: ചുവട് ഒരു മുഴം; വീതി ഒരു മുഴം; അതിന്‍റെ അകത്ത് ചുറ്റുമുള്ള വക്ക് ഒരു ചാൺ. യാഗപീഠത്തിന്‍റെ ഉയരം ഇപ്രകാരമാണ്: <verse eid="EZK 43:13" /><verse number="14" style="v" sid="EZK 43:14" />നിലത്തുള്ള അതിന്‍റെ ചുവടുമുതൽ താഴത്തെ തട്ടുവരെ രണ്ടു മുഴവും വീതി ഒരു മുഴവും; താഴത്തെ ചെറിയ തട്ടുമുതൽ വലിയ തട്ടുവരെ നാലു മുഴവും വീതി ഒരു മുഴവും ആയിരിക്കേണം. <verse eid="EZK 43:14" /><verse number="15" style="v" sid="EZK 43:15" />ഇങ്ങനെ മുകളിലെ യാഗപീഠം നാലു മുഴം; യാഗപീഠത്തിന്‍റെ അടുപ്പിൽനിന്ന് മുകളിലേക്ക് നാലു കൊമ്പ് ഉണ്ടായിരിക്കേണം; <verse eid="EZK 43:15" /><verse number="16" style="v" sid="EZK 43:16" />യാഗപീഠത്തിന്‍റെ അടുപ്പിന്‍റെ നീളം പന്ത്രണ്ടു മുഴവും വീതി പന്ത്രണ്ടു മുഴവുമായി സമചതുരമായിരിക്കണം. <verse eid="EZK 43:16" /><verse number="17" style="v" sid="EZK 43:17" />അതിന്‍റെ നാലു വശത്തുമുള്ള തട്ട് പതിനാലു മുഴം നീളവും പതിനാലു മുഴം വീതിയും അതിന്‍റെ ചുറ്റുമുള്ള വക്ക് അര മുഴവും ചുവട് ചുറ്റും ഒരു മുഴവും ആയിരിക്കേണം; അതിന്‍റെ പടികൾ കിഴക്കോട്ടായിരിക്കണം.<verse eid="EZK 43:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 43:18" />പിന്നെ അവിടുന്ന് എന്നോട് കല്പിച്ചത്: “മനുഷ്യപുത്രാ, യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: അവർ യാഗപീഠം ഉണ്ടാക്കുന്ന നാളിൽ അതിന്മേൽ ഹോമയാഗം കഴിക്കേണ്ടതിനും രക്തം തളിക്കേണ്ടതിനും അതിനെക്കുറിച്ചുള്ള ചട്ടങ്ങൾ ഇവയാണ്: <verse eid="EZK 43:18" /><verse number="19" style="v" sid="EZK 43:19" />എനിക്ക് ശുശ്രൂഷ ചെയ്യേണ്ടതിന് എന്നോട് അടുത്തുവരുന്ന സാദോക്കിന്‍റെ സന്തതിയിലുള്ള ലേവ്യരായ പുരോഹിതന്മാർക്ക്, പാപയാഗമായി ഒരു കാളക്കുട്ടിയെ നീ കൊടുക്കേണം” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു. <verse eid="EZK 43:19" /><verse number="20" style="v" sid="EZK 43:20" />നീ അതിന്‍റെ രക്തത്തിൽ കുറെ എടുത്ത് യാഗപീഠത്തിന്‍റെ നാലു കൊമ്പിലും തട്ടിൻ്റെ നാലു കോണിലും ചുറ്റുമുള്ള വക്കിലും പുരട്ടി, അതിന് പാപപരിഹാരവും പ്രായശ്ചിത്തവും വരുത്തേണം. <verse eid="EZK 43:20" /><verse number="21" style="v" sid="EZK 43:21" />പിന്നെ നീ പാപയാഗത്തിന് കാളയെ എടുത്ത് ആലയത്തിൽ നിയമിക്കപ്പെട്ട സ്ഥലത്ത് വിശുദ്ധമന്ദിരത്തിന്‍റെ പുറത്തുവച്ച് ദഹിപ്പിക്കേണം.<verse eid="EZK 43:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 43:22" />“രണ്ടാംദിവസം നീ ഊനമില്ലാത്ത ഒരു കോലാട്ടുകൊറ്റനെ പാപയാഗമായി അർപ്പിക്കേണം; അവർ കാളയെക്കൊണ്ട് യാഗപീഠത്തിനു പാപപരിഹാരം വരുത്തിയതുപോലെ ഇതിനെക്കൊണ്ടും അതിന് പാപപരിഹാരം വരുത്തേണം. <verse eid="EZK 43:22" /><verse number="23" style="v" sid="EZK 43:23" />അതിന് പാപപരിഹാരം വരുത്തിത്തീർന്നശേഷം, നീ ഊനമില്ലാത്ത ഒരു കാളക്കുട്ടിയെയും ആട്ടിൻകൂട്ടത്തിൽനിന്ന് ഊനമില്ലാത്ത ഒരു ആട്ടുകൊറ്റനെയും അർപ്പിക്കേണം. <verse eid="EZK 43:23" /><verse number="24" style="v" sid="EZK 43:24" />നീ അവയെ യഹോവയുടെ സന്നിധിയിൽ കൊണ്ടുവരേണം; പുരോഹിതന്മാർ അവയുടെമേൽ ഉപ്പ് വിതറിയശേഷം അവയെ യഹോവയ്ക്കു ഹോമയാഗമായി അർപ്പിക്കേണം.<verse eid="EZK 43:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 43:25" />“ഏഴു ദിവസം ദിനംപ്രതി പാപയാഗമായി ഓരോ കോലാടിനെ നീ അർപ്പിക്കേണം; അവർ ഊനമില്ലാത്ത ഒരു കാളക്കുട്ടിയെയും ആട്ടിൻകൂട്ടത്തിൽനിന്ന് ഒരു ആട്ടുകൊറ്റനെയും കൂടെ അർപ്പിക്കേണം. <verse eid="EZK 43:25" /><verse number="26" style="v" sid="EZK 43:26" />അങ്ങനെ അവർ ഏഴു ദിവസം യാഗപീഠത്തിന് പ്രായശ്ചിത്തം വരുത്തിയും അതിനെ നിർമ്മലീകരിച്ചുംകൊണ്ട് പ്രതിഷ്ഠ കഴിക്കേണം. <verse eid="EZK 43:26" /><verse number="27" style="v" sid="EZK 43:27" />ഈ ദിവസങ്ങൾ തികച്ചശേഷം, എട്ടാം ദിവസംമുതൽ പുരോഹിതന്മാർ യാഗപീഠത്തിന്മേൽ നിങ്ങളുടെ ഹോമയാഗങ്ങളെയും സമാധാനയാഗങ്ങളെയും അർപ്പിക്കേണം. അങ്ങനെ എനിക്ക് നിങ്ങളിൽ പ്രസാദമുണ്ടാകും” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 43:27" /></para>
  <chapter eid="EZK 43" />
  <chapter number="44" style="c" sid="EZK 44" />
  <para style="s">പൗരോഹിത്യം പുനഃസ്ഥാപിക്കപ്പെടുന്നു</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 44:1" />അനന്തരം ആ മനുഷ്യന്‍ എന്നെ വിശുദ്ധമന്ദിരത്തിന്‍റെ കിഴക്കോട്ടു ദർശനമുള്ള പുറത്തെ ഗോപുരത്തിലേക്കു മടക്കിക്കൊണ്ടുവന്നു; എന്നാൽ അത് അടച്ചിരുന്നു. <verse eid="EZK 44:1" /><verse number="2" style="v" sid="EZK 44:2" />അപ്പോൾ യഹോവ എന്നോട് അരുളിച്ചെയ്തത്: “ഈ ഗോപുരം തുറക്കാതെ അടച്ചിരിക്കേണം; ആരും അതിൽകൂടി കടക്കരുത്; യിസ്രായേലിന്‍റെ ദൈവമായ യഹോവ അതിൽകൂടി അകത്ത് കടന്നതുകൊണ്ട് അത് അടച്ചിരിക്കേണം. <verse eid="EZK 44:2" /><verse number="3" style="v" sid="EZK 44:3" />പ്രഭുവായിരിക്കുകയാൽ, അവൻ മാത്രം യഹോവയുടെ സന്നിധിയിൽ ഭക്ഷണം കഴിക്കുവാൻ അവിടെ ഇരിക്കേണം; അവൻ ആ ഗോപുരത്തിൻ്റെ പൂമുഖത്തുകൂടി അകത്ത് കടക്കുകയും അതിൽകൂടി പുറത്തു പോകുകയും വേണം.”<verse eid="EZK 44:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 44:4" />പിന്നെ അവൻ എന്നെ വടക്കെഗോപുരംവഴിയായി ആലയത്തിന്‍റെ മുമ്പിൽ കൊണ്ടുചെന്നു; ഞാൻ നോക്കി, യഹോവയുടെ തേജസ്സ് യഹോവയുടെ ആലയത്തിൽ നിറഞ്ഞിരിക്കുന്നതു കണ്ടു കവിണ്ണുവീണു.<verse eid="EZK 44:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 44:5" />അപ്പോൾ യഹോവ എന്നോട് അരുളിച്ചെയ്തത്: ”മനുഷ്യപുത്രാ, യഹോവയുടെ ആലയത്തിന്‍റെ സകലവ്യവസ്ഥകളെയും നിയമങ്ങളെയും കുറിച്ച് ഞാൻ നിന്നോട് കല്പിക്കുന്നതെല്ലാം നീ നല്ലവണ്ണം ശ്രദ്ധവച്ച് കണ്ണുകൊണ്ട് നോക്കി, ചെവികൊണ്ട് കേൾക്കുക; ആലയത്തിലേക്ക് പ്രവേശിക്കുന്നത് ആരെന്നും വിശുദ്ധമന്ദിരത്തിൽനിന്നു പുറത്തേക്ക് പോകുന്നത് ആരെന്നും നീ നല്ലവണ്ണം കുറിക്കൊള്ളുക.” <verse eid="EZK 44:5" /><verse number="6" style="v" sid="EZK 44:6" />മത്സരികളായ യിസ്രായേൽ ഗൃഹത്തോട് നീ പറയേണ്ടത്: “യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: ‘യിസ്രായേൽ ഗൃഹമേ, നിങ്ങളുടെ സകലമ്ലേച്ഛതകളും മതിയാക്കുവിൻ. <verse eid="EZK 44:6" /><verse number="7" style="v" sid="EZK 44:7" />നിങ്ങൾ എന്‍റെ ആഹാരമായ മേദസ്സും രക്തവും അർപ്പിക്കുമ്പോൾ, എന്‍റെ ആലയത്തെ അശുദ്ധമാക്കേണ്ടതിന് നിങ്ങൾ, ഹൃദയത്തിലും മാംസത്തിലും അഗ്രചർമ്മികളായ അന്യജനതകളെ എന്‍റെ വിശുദ്ധമന്ദിരത്തിൽ കൊണ്ടുവന്നതിനാൽ, നിങ്ങളുടെ സകലമ്ലേച്ഛതകൾക്കും പുറമെ നിങ്ങൾ എന്‍റെ നിയമവും ലംഘിച്ചിരിക്കുന്നു. <verse eid="EZK 44:7" /><verse number="8" style="v" sid="EZK 44:8" />നിങ്ങൾ എന്‍റെ വിശുദ്ധവസ്തുക്കളുടെ കടമകൾ നിറവേറ്റാതെ, എന്‍റെ വിശുദ്ധമന്ദിരത്തിലെ കാര്യങ്ങൾ നിറവേറ്റാൻ അവരെ ആക്കിയിരിക്കുന്നു.” <verse eid="EZK 44:8" /><verse number="9" style="v" sid="EZK 44:9" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “യിസ്രായേൽ മക്കളുടെ ഇടയിലുള്ള യാതൊരു അന്യജാതിക്കാരനും, അനുസരണമില്ലാത്ത ഹൃദയത്തിലും പരിച്ഛേദന<note caller="+" style="f"><char style="fr" closed="false">44:9 </char><char style="fq" closed="false">അനുസരണമില്ലാത്ത ഹൃദയത്തിലും </char><char style="ft" closed="false">പരിച്ഛേദന ഏല്‍ക്കാത്ത </char></note> മാംസത്തിലും പരിച്ഛേദന ഏല്ക്കാത്ത യാതൊരു അന്യജാതിക്കാരനും, എന്‍റെ വിശുദ്ധമന്ദിരത്തിൽ പ്രവേശിക്കരുത്.<verse eid="EZK 44:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 44:10" />”യിസ്രായേൽ തെറ്റിപ്പോയ കാലത്ത്, എന്നെ വിട്ടകന്നു പോയവരും, എന്നെ ഉപേക്ഷിച്ച് വിഗ്രഹങ്ങളോടു ചേർന്നവരുമായ ലേവ്യർ തന്നെ അവരുടെ അകൃത്യം വഹിക്കേണം. <verse eid="EZK 44:10" /><verse number="11" style="v" sid="EZK 44:11" />അവർ എന്‍റെ വിശുദ്ധമന്ദിരത്തിൽ ആലയത്തിന്‍റെ പടിവാതില്ക്കൽ ശുശ്രൂഷകന്മാരായി കാവൽനിന്ന്, ആലയത്തിൽ ശുശ്രൂഷ ചെയ്യേണം; അവർ ജനത്തിനുവേണ്ടി ഹോമയാഗവും ഹനനയാഗവും അറുത്ത്, അവർക്ക് ശുശ്രൂഷ ചെയ്യേണ്ടതിന് അവരുടെ മുമ്പിൽ നില്ക്കേണം. <verse eid="EZK 44:11" /><verse number="12" style="v" sid="EZK 44:12" />അവർ അവരുടെ വിഗ്രഹങ്ങളുടെ മുമ്പിൽ ശുശ്രൂഷചെയ്തതിനാൽ, യിസ്രായേൽഗൃഹം അകൃത്യം ചെയ്യുവാൻ കാരണമായി; അതുകൊണ്ട് ഞാൻ അവർക്ക് വിരോധമായി കൈ ഉയർത്തി സത്യം ചെയ്തിരിക്കുന്നു; അവർ അവരുടെ അകൃത്യം വഹിക്കേണം” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്. <verse eid="EZK 44:12" /><verse number="13" style="v" sid="EZK 44:13" />“എനിക്ക് പുരോഹിതശുശ്രൂഷ ചെയ്യുവാനും, അതിവിശുദ്ധങ്ങളായ എന്‍റെ സകലവിശുദ്ധവസ്തുക്കളെയും സ്പർശിക്കുവാനും, അവർ എന്നോട് അടുത്തുവരരുത്; അങ്ങനെ അവരുടെ അവർ ചെയ്ത മ്ലേച്ഛതകളും അവർ വഹിക്കേണം. <verse eid="EZK 44:13" /><verse number="14" style="v" sid="EZK 44:14" />എന്നാൽ ആലയത്തിന്‍റെ എല്ലാ വേലയ്ക്കും അതിൽ ചെയ്യുവാനുള്ള എല്ലാ പ്രവൃത്തികൾക്കും ഞാൻ അവരെ കാര്യവിചാരകന്മാരാക്കിവയ്ക്കും.<verse eid="EZK 44:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 44:15" />”യിസ്രായേൽ മക്കൾ എന്നെവിട്ടു തെറ്റിപ്പോയ കാലത്ത്, എന്‍റെ വിശുദ്ധമന്ദിരത്തിന്‍റെ കർത്തവ്യങ്ങൾ നിർവഹിച്ചിരുന്നവരും സാദോക്കിന്‍റെ പുത്രന്മാരുമായ ലേവ്യപുരോഹിതന്മാർ എനിക്ക് ശുശ്രൂഷ ചെയ്യേണ്ടതിന് എന്നോട് അടുത്തുവന്ന്, എനിക്ക് മേദസ്സും രക്തവും അർപ്പിക്കേണ്ടതിന് എന്‍റെ മുമ്പാകെ നില്ക്കേണം” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു. <verse eid="EZK 44:15" /><verse number="16" style="v" sid="EZK 44:16" />അവർ എന്‍റെ വിശുദ്ധമന്ദിരത്തിൽ കടന്ന് എനിക്ക് ശുശ്രൂഷ ചെയ്യേണ്ടതിന് എന്‍റെ മേശയുടെ അടുക്കൽ വരുകയും എന്‍റെ കാര്യവിചാരണ നടത്തുകയും വേണം.<verse eid="EZK 44:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 44:17" />”എന്നാൽ അകത്തെ പ്രാകാരത്തിന്‍റെ വാതിലുകൾക്കകത്തു കടക്കുമ്പോൾ അവർ ശണവസ്ത്രം ധരിക്കേണം; അകത്തെ പ്രാകാരത്തിന്‍റെ വാതില്‍ക്കലും ആലയത്തിനകത്തും ശുശ്രൂഷ ചെയ്യുമ്പോൾ ആട്ടിൻ രോമംകൊണ്ടുള്ള വസ്ത്രം ധരിക്കരുത്. <verse eid="EZK 44:17" /><verse number="18" style="v" sid="EZK 44:18" />അവരുടെ തലയിൽ ശണംകൊണ്ടുള്ള തലപ്പാവും അരയിൽ ശണംകൊണ്ടുള്ള കാല്ക്കുപ്പായവും ഉണ്ടായിരിക്കേണം; വിയർപ്പുണ്ടാകുന്ന യാതൊന്നും അവർ ധരിക്കരുത്. <verse eid="EZK 44:18" /><verse number="19" style="v" sid="EZK 44:19" />അവർ പുറത്തെ പ്രാകാരത്തിൽ ജനത്തിന്‍റെ അടുക്കലേക്ക് ചെല്ലുമ്പോൾ അവരുടെ വസ്ത്രത്താൽ ജനത്തെ വിശുദ്ധീകരിക്കാതിരിക്കേണ്ടതിന്, അവർ ശുശ്രൂഷചെയ്ത സമയം ധരിച്ചിരുന്ന വസ്ത്രം നീക്കി വിശുദ്ധമണ്ഡപങ്ങളിൽ വച്ചിട്ടു വേറെ വസ്ത്രം ധരിക്കേണം.<verse eid="EZK 44:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 44:20" />”അവർ തല ക്ഷൗരം ചെയ്യുകയോ തലമുടി നീട്ടുകയോ ചെയ്യാതെ കത്രിക്കുക മാത്രമേ ചെയ്യാവു. <verse eid="EZK 44:20" /><verse number="21" style="v" sid="EZK 44:21" />യാതൊരു പുരോഹിതനും വീഞ്ഞു കുടിച്ച് അകത്തെ പ്രാകാരത്തിൽ കടക്കരുത്. <verse eid="EZK 44:21" /><verse number="22" style="v" sid="EZK 44:22" />വിധവയെയോ ഉപേക്ഷിക്കപ്പെട്ടവളെയോ ഭാര്യയായി എടുക്കാതെ അവർ യിസ്രായേൽ ഗൃഹത്തിലെ സന്തതിയിലുള്ള കന്യകമാരെയോ ഒരു പുരോഹിതന്‍റെ ഭാര്യയായിരുന്ന വിധവയെയോ വിവാഹം കഴിക്കേണം. <verse eid="EZK 44:22" /><verse number="23" style="v" sid="EZK 44:23" />അവർ വിശുദ്ധമായതിനും സാമാന്യമായതിനും തമ്മിലുള്ള വ്യത്യാസം എന്‍റെ ജനത്തിന് ഉപദേശിച്ച്, മലിനമായതും നിർമ്മലമായതും അവരെ തിരിച്ചറിയുമാറാക്കണം.<verse eid="EZK 44:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 44:24" />”വ്യവഹാരത്തിൽ അവർ ന്യായം വിധിക്കുവാൻ നില്ക്കേണം; എന്‍റെ വിധികളെ അനുസരിച്ച് അവർ ന്യായം വിധിക്കേണം; അവർ ഉത്സവങ്ങളിൽ എല്ലാം എന്‍റെ പ്രമാണങ്ങളും ചട്ടങ്ങളും ആചരിക്കുകയും എന്‍റെ ശബ്ബത്തുകളെ വിശുദ്ധീകരിക്കുകയും വേണം. <verse eid="EZK 44:24" /><verse number="25" style="v" sid="EZK 44:25" />അവർ മരിച്ച ആളുടെ അടുക്കൽ ചെന്നു അശുദ്ധരാകരുത്; എങ്കിലും അപ്പൻ, അമ്മ, മകൻ, മകൾ, സഹോദരൻ, ഭർത്താവില്ലാത്ത സഹോദരി എന്നിവർക്കുവേണ്ടി അശുദ്ധരാകാം. <verse eid="EZK 44:25" /><verse number="26" style="v" sid="EZK 44:26" />അവന്‍റെ ശുദ്ധീകരണം കഴിഞ്ഞശേഷം ഏഴു ദിവസം എണ്ണേണം. <verse eid="EZK 44:26" /><verse number="27" style="v" sid="EZK 44:27" />വിശുദ്ധമന്ദിരത്തിൽ ശുശ്രൂഷ ചെയ്യേണ്ടതിന് അവൻ അകത്തെ പ്രാകാരത്തിൽ വിശുദ്ധമന്ദിരത്തിലേക്കു പോകുന്ന ദിവസത്തിൽ അവൻ പാപയാഗം അർപ്പിക്കേണം” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 44:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 44:28" />അവരുടെ അവകാശമോ, ഞാൻ തന്നെ അവരുടെ അവകാശം; നിങ്ങൾ അവർക്ക് യിസ്രായേലിൽ സ്വത്ത് ഒന്നും കൊടുക്കരുത്; ഞാൻ തന്നെ അവരുടെ സ്വത്താകുന്നു. <verse eid="EZK 44:28" /><verse number="29" style="v" sid="EZK 44:29" />അവർ ഭോജനയാഗം, പാപയാഗം, അകൃത്യയാഗം എന്നിവകൊണ്ട് ഉപജീവനം കഴിക്കേണം; യിസ്രായേലിൽ നിവേദിതമായ സകലവും അവർക്കുള്ളതായിരിക്കണം. <verse eid="EZK 44:29" /><verse number="30" style="v" sid="EZK 44:30" />സകലവിധ ആദ്യഫലങ്ങളിലും ഉത്തമമായതും വഴിപാടായി വരുന്ന എല്ലാവക വഴിപാടുകളും പുരോഹിതന്മാർക്കുള്ളതായിരിക്കേണം; നിന്‍റെ ഭവനത്തിന്മേൽ അനുഗ്രഹം വസിക്കേണ്ടതിന് നിങ്ങളുടെ തരിമാവിൻ്റെ ആദ്യഭാഗവും പുരോഹിതനു കൊടുക്കേണം. <verse eid="EZK 44:30" /><verse number="31" style="v" sid="EZK 44:31" />സ്വയം ചത്തതും പറിച്ചുകീറിപ്പോയതുമായ പക്ഷിയെയോ മൃഗത്തെയോ ഒന്നിനെയും പുരോഹിതൻ തിന്നരുത്.<verse eid="EZK 44:31" /></para>
  <chapter eid="EZK 44" />
  <chapter number="45" style="c" sid="EZK 45" />
  <para style="s">യിസ്രായേൽ പൂർണ്ണമായും പുനഃസ്ഥാപിക്കപ്പെടുന്നു</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 45:1" />“ദേശത്തെ അവകാശമായി ചീട്ടിട്ടു വിഭാഗിക്കുമ്പോൾ, നിങ്ങൾ ദേശത്തിന്‍റെ ഒരു വിശുദ്ധാംശം യഹോവയ്ക്കു വഴിപാടായി അർപ്പിക്കേണം; അത് ഇരുപത്തയ്യായിരം (25,000) മുഴം നീളവും ഇരുപതിനായിരം മുഴം (20,000) വീതിയും ഉള്ളതായിരിക്കേണം; അതിന്‍റെ ചുറ്റുമുള്ള എല്ലാ അതിരുകളും വിശുദ്ധമായിരിക്കേണം. <verse eid="EZK 45:1" /><verse number="2" style="v" sid="EZK 45:2" />അതിൽ അഞ്ഞൂറ് മുഴം നീളവും അഞ്ഞൂറ് മുഴം വീതിയും ആയി സമചതുരമായ ഒരു ഭാഗം വിശുദ്ധസ്ഥലത്തിന് ആയിരിക്കേണം; അതിന് ചുറ്റും അമ്പത് മുഴം സ്ഥലം വെളിമ്പ്രദേശം ആയി കിടക്കേണം. <verse eid="EZK 45:2" /><verse number="3" style="v" sid="EZK 45:3" />ആ അളവിൽ നിന്ന് ഇരുപത്തയ്യായിരം (25,000) മുഴം നീളവും പതിനായിരം (10,000) മുഴം വീതിയും നീ അളക്കേണം; അതിൽ അതിവിശുദ്ധമായ വിശുദ്ധമന്ദിരം ഉണ്ടായിരിക്കേണം; <verse eid="EZK 45:3" /><verse number="4" style="v" sid="EZK 45:4" />അത് ദേശത്തിന്‍റെ വിശുദ്ധാംശമാകുന്നു; അത് യഹോവയ്ക്കു ശുശ്രൂഷ ചെയ്യുവാൻ അടുത്തു വരുന്നവരായി, വിശുദ്ധമന്ദിരത്തിലെ ശുശ്രൂഷകന്മാരായ പുരോഹിതന്മാർക്കുള്ളതായിരിക്കേണം; അത് അവരുടെ വീടുകൾക്കുള്ള സ്ഥലവും വിശുദ്ധമന്ദിരത്തിനുള്ള വിശുദ്ധസ്ഥലവുമായിരിക്കേണം. <verse eid="EZK 45:4" /><verse number="5" style="v" sid="EZK 45:5" />പിന്നെ ഇരുപത്തയ്യായിരം (25,000) മുഴം നീളവും പതിനായിരം (10,000) മുഴം വീതിയും ഉള്ള ഭാഗം, ആലയത്തിന്‍റെ ശുശ്രൂഷകന്മാരായ ലേവ്യർക്കു വസിക്കുവാനുള്ള ഗ്രാമത്തിനു വേണ്ട സ്വത്തായിരിക്കേണം.<verse eid="EZK 45:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 45:6" />വിശുദ്ധാംശമായ വഴിപാടിനോടു ചേർന്ന് നഗരസ്വത്തായി അയ്യായിരം (5,000) മുഴം വീതിയിലും ഇരുപത്തയ്യായിരം (25,000) മുഴം നീളത്തിലും ഒരു സ്ഥലം നിയമിക്കേണം; അത് യിസ്രായേൽ ഗൃഹത്തിനു മുഴുവനും ഉള്ളതായിരിക്കേണം.<verse eid="EZK 45:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 45:7" />പ്രഭുവിനുള്ളത്, വിശുദ്ധവഴിപാടായ സ്ഥലത്തിനും നഗരസ്വത്തിനും ഇരുവശത്തും വിശുദ്ധവഴിപാടായ സ്ഥലത്തിനും നഗരസ്വത്തിനും മുമ്പിൽ പടിഞ്ഞാറുവശത്ത് പടിഞ്ഞാറോട്ടും കിഴക്കുവശത്ത് കിഴക്കോട്ടും ആയിരിക്കേണം; അതിന്‍റെ നീളം ദേശത്തിന്‍റെ പടിഞ്ഞാറെ അതിരുമുതൽ കിഴക്കെ അതിരുവരെയുള്ള അംശങ്ങളിൽ ഒന്നിനോട് ഒത്തിരിക്കേണം. <verse eid="EZK 45:7" /><verse number="8" style="v" sid="EZK 45:8" />അത് യിസ്രായേലിൽ അവനുള്ള സ്വത്തായിരിക്കേണം; എന്‍റെ പ്രഭുക്കന്മാർ ഇനി എന്‍റെ ജനത്തെ പീഡിപ്പിക്കാതെ, യിസ്രായേൽ ഗൃഹത്തിലെ അതത് ഗോത്രത്തിനു ദേശം കൊടുക്കേണം.”<verse eid="EZK 45:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 45:9" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “യിസ്രായേൽപ്രഭുക്കന്മാരേ, മതിയാക്കുവിൻ! സാഹസവും കവർച്ചയും അകറ്റി നീതിയും ന്യായവും നടത്തുവിൻ; എന്‍റെ ജനത്തോടു പിടിച്ചുപറിക്കുന്നത് നിർത്തുവിൻ” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്. <verse eid="EZK 45:9" /><verse number="10" style="v" sid="EZK 45:10" />ഒത്ത തുലാസ്സും ഒത്ത ഏഫായും ഒത്ത ബത്തും നിങ്ങൾക്കുണ്ടായിരിക്കണം. <verse eid="EZK 45:10" /><verse number="11" style="v" sid="EZK 45:11" />ഏഫായും ബത്തും ഒരേ അളവായിരിക്കേണം; ബത്ത് ഹോമെരിൻ്റെ പത്തിൽ ഒന്നും ഏഫാ ഹോമെരിൻ്റെ പത്തിൽ ഒന്നും ആയിരിക്കേണം; അതിന്‍റെ അളവ് ഹോമെരിനൊത്തതായിരിക്കേണം. <verse eid="EZK 45:11" /><verse number="12" style="v" sid="EZK 45:12" />ഒരു ശേക്കൽ ഇരുപതു ഗേരാ ആയിരിക്കേണം; ഇരുപതു ശേക്കൽ, ഇരുപത്തഞ്ചു ശേക്കൽ, പതിനഞ്ചു ശേക്കൽ ഇവ കൂടുമ്പോൾ ഒരു മാനേ ആയിരിക്കേണം.<verse eid="EZK 45:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 45:13" />”നിങ്ങൾ വഴിപാട് കഴിക്കേണ്ടത് എങ്ങനെ എന്നാൽ: ഒരു ഹോമെർ ഗോതമ്പിൽനിന്ന് ഏഫായുടെ ആറിലൊന്നും ഒരു ഹോമെർ യവത്തിൽനിന്ന് ഏഫായുടെ ആറിലൊന്നും കൊടുക്കേണം. <verse eid="EZK 45:13" /><verse number="14" style="v" sid="EZK 45:14" />എണ്ണയ്ക്കുള്ള പ്രമാണം: പത്തു ബത്ത് കൊള്ളുന്ന ഹോമെർ ഒരു കോർ; അതിൽനിന്ന് ബത്തിന്‍റെ പത്തിലൊന്ന് കൊടുക്കേണം; പത്തു ബത്ത് ഒരു ഹോമെർ. <verse eid="EZK 45:14" /><verse number="15" style="v" sid="EZK 45:15" />പ്രായശ്ചിത്തം വരുത്തേണ്ടതിന് ഭോജനയാഗമായും ഹോമയാഗമായും സമാധാനയാഗങ്ങളായും യിസ്രായേലിന്‍റെ പുഷ്ടിയുള്ള മേച്ചിൽപുറങ്ങളിലെ ഇരുനൂറ് ആടുള്ള ഒരു കൂട്ടത്തിൽനിന്ന് ഒരു കുഞ്ഞാടിനെ കൊടുക്കേണം” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാടു. <verse eid="EZK 45:15" /><verse number="16" style="v" sid="EZK 45:16" />ദേശത്തെ സകലജനവും യിസ്രായേലിന്‍റെ പ്രഭുവിനു വേണ്ടിയുള്ള ഈ വഴിപാടിനായി കൊടുക്കേണം. <verse eid="EZK 45:16" /><verse number="17" style="v" sid="EZK 45:17" />ഉത്സവങ്ങളിലും അമാവാസികളിലും ശബ്ബത്തുകളിലും യിസ്രായേൽ ഗൃഹത്തിന്‍റെ ഉത്സവസമയങ്ങളിൽ എല്ലാം ഹോമയാഗങ്ങളും ഭോജനയാഗങ്ങളും പാനീയയാഗങ്ങളും കഴിക്കുവാൻ പ്രഭു ബാദ്ധ്യസ്ഥനാകുന്നു; യിസ്രായേൽ ഗൃഹത്തിനു പ്രായശ്ചിത്തം വരുത്തേണ്ടതിന് അവൻ പാപയാഗവും ഭോജനയാഗവും ഹോമയാഗവും സമാധാനയാഗങ്ങളും അർപ്പിക്കേണം.<verse eid="EZK 45:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 45:18" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഒന്നാം മാസം ഒന്നാം തീയതി നീ ഊനമില്ലാത്ത ഒരു കാളക്കുട്ടിയെ എടുത്ത് വിശുദ്ധമന്ദിരത്തിനു പാപപരിഹാരം വരുത്തേണം. <verse eid="EZK 45:18" /><verse number="19" style="v" sid="EZK 45:19" />പുരോഹിതൻ പാപയാഗത്തിന്‍റെ രക്തത്തിൽ കുറെ എടുത്ത് ആലയത്തിന്‍റെ വാതിൽപ്പടികളിലും യാഗപീഠത്തിന്‍റെ തട്ടിൻ്റെ നാലു കോണിലും അകത്തെ പ്രാകാരത്തിന്‍റെ ഗോപുരത്തിൻ്റെ വാതിൽപ്പടികളിലും പുരട്ടേണം. <verse eid="EZK 45:19" /><verse number="20" style="v" sid="EZK 45:20" />അങ്ങനെ തന്നെ നീ ഏഴാം മാസം ഒന്നാം തീയതിയും, അബദ്ധത്താലോ ബുദ്ധിഹീനതയാലോ പിഴച്ചു പോയവനു വേണ്ടി ചെയ്യേണം; ഇങ്ങനെ നിങ്ങൾ ആലയത്തിന് പ്രായശ്ചിത്തം വരുത്തേണം.<verse eid="EZK 45:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 45:21" />ഒന്നാം മാസം പതിനാലാം തീയതിമുതൽ നിങ്ങൾ ഏഴു ദിവസത്തേക്ക് പെസഹാപെരുനാൾ ആചരിച്ച് പുളിപ്പില്ലാത്ത അപ്പം തിന്നേണം. <verse eid="EZK 45:21" /><verse number="22" style="v" sid="EZK 45:22" />അന്നു പ്രഭു തനിക്കുവേണ്ടിയും ദേശത്തിലെ സകലജനത്തിനു വേണ്ടിയും പാപയാഗമായി ഒരു കാളയെ അർപ്പിക്കേണം. <verse eid="EZK 45:22" /><verse number="23" style="v" sid="EZK 45:23" />ഉത്സവത്തിന്‍റെ ഏഴു ദിവസവും അവൻ യഹോവയ്ക്ക് ഹോമയാഗമായി ഊനമില്ലാത്ത ഏഴു കാളയെയും ഏഴു ആട്ടുകൊറ്റനെയും ആ ഏഴു ദിവസവും ദിനംപ്രതി അർപ്പിക്കേണം; പാപയാഗമായി ദിനംപ്രതി ഓരോ കോലാട്ടിൻകുട്ടിയെയും അർപ്പിക്കേണം. <verse eid="EZK 45:23" /><verse number="24" style="v" sid="EZK 45:24" />കാള ഒന്നിന് ഒരു ഏഫായും ആട്ടുകൊറ്റൻ ഒന്നിന് ഒരു ഏഫായും ഏഫാ ഒന്നിന് ഒരു ഹീൻ എണ്ണയും വീതം അവൻ ഭോജനയാഗം അർപ്പിക്കേണം.<verse eid="EZK 45:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 45:25" />ഏഴാം മാസം പതിനഞ്ചാം തീയതിയിലുള്ള ഉത്സവത്തിൽ അവൻ ഈ ഏഴു ദിവസം എന്നപോലെ, പാപയാഗത്തിനും ഹോമയാഗത്തിനും ഭോജനയാഗത്തിനും എണ്ണയ്ക്കും തക്കവണ്ണം അർപ്പിക്കേണം.<verse eid="EZK 45:25" /></para>
  <chapter eid="EZK 45" />
  <chapter number="46" style="c" sid="EZK 46" />
  <para style="s">രാജാവും ഉത്സവങ്ങളും</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 46:1" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “അകത്തെ പ്രാകാരത്തിന്‍റെ കിഴക്കോട്ടു ദർശനമുള്ള ഗോപുരം ആറു പ്രവൃത്തിദിവസങ്ങളിലും അടച്ചിരിക്കേണം; ശബ്ബത്തുനാളിലും അമാവാസിയിലും അത് തുറന്നിരിക്കേണം. <verse eid="EZK 46:1" /><verse number="2" style="v" sid="EZK 46:2" />എന്നാൽ പ്രഭു പുറത്തുനിന്ന് ആ ഗോപുരത്തിൻ്റെ പൂമുഖംവഴിയായി കടന്നുചെന്ന്, ഗോപുരത്തിൻ്റെ കട്ടിളത്തൂണിനരികിൽ നില്ക്കേണം; പുരോഹിതൻ അവന്‍റെ ഹോമയാഗവും സമാധാനയാഗവും അർപ്പിക്കുമ്പോൾ അവൻ ഗോപുരത്തിൻ്റെ ഉമ്മരപ്പടിക്കൽ നമസ്കരിക്കേണം; പിന്നെ അവൻ പുറത്തേക്ക് പോകേണം: എന്നാൽ ഗോപുരം സന്ധ്യവരെ അടയ്ക്കാതെയിരിക്കേണം. <verse eid="EZK 46:2" /><verse number="3" style="v" sid="EZK 46:3" />ദേശത്തെ ജനം ശബ്ബത്തുകളിലും അമാവാസികളിലും ഈ ഗോപുരപ്രവേശനത്തിങ്കൽ യഹോവയുടെ സന്നിധിയിൽ നമസ്കരിക്കേണം. <verse eid="EZK 46:3" /><verse number="4" style="v" sid="EZK 46:4" />പ്രഭു ശബ്ബത്തുനാളിൽ യഹോവയ്ക്ക് ഹോമയാഗമായി ഊനമില്ലാത്ത ആറു കുഞ്ഞാടുകളെയും ഊനമില്ലാത്ത ഒരു മുട്ടാടിനെയും അർപ്പിക്കേണം. <verse eid="EZK 46:4" /><verse number="5" style="v" sid="EZK 46:5" />ഭോജനയാഗമായി അവൻ മുട്ടാടിന് ഒരു ഏഫായും കുഞ്ഞാടുകൾക്ക് തന്‍റെ പ്രാപ്തിപോലെയുള്ള ഭോജനയാഗവും, ഏഫാ ഒന്നിന് ഒരു ഹീൻ എണ്ണവീതവും അർപ്പിക്കേണം. <verse eid="EZK 46:5" /><verse number="6" style="v" sid="EZK 46:6" />അമാവാസിദിവസത്തിൽ ഊനമില്ലാത്ത ഒരു കാളക്കുട്ടിയെയും ആറു കുഞ്ഞാടുകളെയും ഒരു മുട്ടാടിനെയും അർപ്പിക്കേണം; ഇവയും ഊനമില്ലാത്തവ ആയിരിക്കേണം. <verse eid="EZK 46:6" /><verse number="7" style="v" sid="EZK 46:7" />ഭോജനയാഗമായി അവൻ കാളയ്ക്ക് ഒരു ഏഫായും മുട്ടാടിന് ഒരു ഏഫായും കുഞ്ഞാടുകൾക്കു തന്‍റെ പ്രാപ്തിപോലെയും ഏഫാ ഒന്നിന് ഒരു ഹീൻ എണ്ണവീതവും അർപ്പിക്കേണം.<verse eid="EZK 46:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 46:8" />“അധിപതി വരുമ്പോൾ അവൻ ഗോപുരത്തിൻ്റെ പൂമുഖംവഴിയായി കടക്കുകയും ആ വഴിയായി തന്നെ പുറത്തേക്ക് പോകുകയും വേണം. <verse eid="EZK 46:8" /><verse number="9" style="v" sid="EZK 46:9" />എന്നാൽ ദേശത്തെ ജനം ഉത്സവങ്ങളിൽ യഹോവയുടെ സന്നിധിയിൽ വരുമ്പോൾ, വടക്കെ ഗോപുരംവഴി നമസ്കരിക്കുവാൻ വരുന്നവൻ തെക്കെഗോപുരം വഴി പുറത്തേക്ക് പോകുകയും തെക്കെഗോപുരം വഴി വരുന്നവൻ വടക്കെ ഗോപുരംവഴി പുറത്തേക്ക് പോകുകയും വേണം; താൻ വന്ന ഗോപുരംവഴിയായി മടങ്ങിപ്പോകാതെ അതിനെതിരെയുള്ളതിൽകൂടി പുറത്തേക്ക് പോകേണം. <verse eid="EZK 46:9" /><verse number="10" style="v" sid="EZK 46:10" />അവർ വരുമ്പോൾ പ്രഭുവും അവരുടെ മദ്ധ്യത്തിൽ വരുകയും അവർ പോകുമ്പോൾ അവനും കൂടെ പോകുകയും വേണം.<verse eid="EZK 46:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 46:11" />വിശേഷദിവസങ്ങളിലും ഉത്സവങ്ങളിലും ഭോജനയാഗം, കാളയ്ക്ക് ഒരു ഏഫായും മുട്ടാടിന് ഒരു ഏഫായും കുഞ്ഞാടുകൾക്ക് തന്‍റെ പ്രാപ്തിപോലെയും ഏഫായ്ക്ക് ഒരു ഹീൻ എണ്ണയും വീതം ആയിരിക്കേണം. <verse eid="EZK 46:11" /><verse number="12" style="v" sid="EZK 46:12" />എന്നാൽ അധിപതി സ്വമേധാദാനമായ ഹോമയാഗമോ സ്വമേധാദാനമായ സമാധാനയാഗങ്ങളോ യഹോവയ്ക്ക് അർപ്പിക്കുമ്പോൾ കിഴക്കോട്ടു ദർശനമുള്ള ഗോപുരം അവനു തുറന്നുകൊടുക്കണം; അവൻ ശബ്ബത്തുനാളിൽ ചെയ്യുന്നതുപോലെ തന്‍റെ ഹോമയാഗവും സമാധാനയാഗങ്ങളും അർപ്പിക്കേണം; പിന്നെ അവൻ പുറത്തേക്ക് പോകേണം; അവൻ പുറത്തേക്ക് പോയശേഷം ഗോപുരം അടയ്ക്കേണം.<verse eid="EZK 46:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 46:13" />“ഒരു വയസ്സു പ്രായമുള്ളതും ഊനമില്ലാത്തതുമായ ഒരു കുഞ്ഞാടിനെ നീ ദിനംപ്രതി യഹോവയ്ക്കു ഹോമയാഗമായി അർപ്പിക്കേണം; രാവിലെതോറും അതിനെ അർപ്പിക്കേണം. <verse eid="EZK 46:13" /><verse number="14" style="v" sid="EZK 46:14" />അതിന്‍റെ ഭോജനയാഗമായി നീ രാവിലെതോറും ഏഫയിൽ ആറിലൊന്നും നേരിയ മാവു നനയ്ക്കേണ്ടതിന് ഹീനിൽ മൂന്നിലൊന്ന് എണ്ണയും അർപ്പിക്കേണം; അത് ഒരു ശാശ്വതനിയമമായി യഹോവയ്ക്കുള്ള നിരന്തരഭോജനയാഗം. <verse eid="EZK 46:14" /><verse number="15" style="v" sid="EZK 46:15" />ഇങ്ങനെ നിരന്തരഹോമയാഗമായി കുഞ്ഞാടും, ഭോജനയാഗവും എണ്ണയും അവർ രാവിലെതോറും അർപ്പിക്കേണം.”<verse eid="EZK 46:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 46:16" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “അധിപതി തന്‍റെ പുത്രന്മാരിൽ ഒരുവന് ഒരു ദാനം കൊടുക്കുന്നുവെങ്കിൽ അത് അവന്‍റെ അവകാശമായി അവന്‍റെ പുത്രന്മാർക്കുള്ളതായിരിക്കണം; അത് അവകാശമായി അവരുടെ കൈവശം ഇരിക്കേണം. <verse eid="EZK 46:16" /><verse number="17" style="v" sid="EZK 46:17" />എന്നാൽ അവൻ തന്‍റെ ദാസന്മാരിൽ ഒരുവന് തന്‍റെ അവകാശത്തിൽനിന്ന് ഒരു ദാനം കൊടുക്കുന്നുവെങ്കിൽ അത് വിമോചനവർഷം<note caller="+" style="f"><char style="fr" closed="false">46:17 </char><char style="fq" closed="false">വിമോചനവർഷം </char><char style="ft" closed="false">ക്ഷമ ലഭിക്കുന്നതിന്‍റെയും പുനരുദ്ധാരണത്തിന്‍റെയും ജൂബിലി വര്‍ഷമായ എഴാം വര്‍ഷം</char></note> വരെ അവനുള്ളതായിരിക്കേണം; പിന്നത്തേതിൽ അത് പ്രഭുവിനു തിരികെ ചേരേണം; അതിന്‍റെ അവകാശം അവന്‍റെ പുത്രന്മാർക്കു തന്നെ ഇരിക്കേണം. <verse eid="EZK 46:17" /><verse number="18" style="v" sid="EZK 46:18" />അധിപതി ജനത്തെ അവരുടെ അവകാശത്തിൽനിന്നു നീക്കി അവരുടെ അവകാശത്തിലൊന്നും അപഹരിക്കരുത്; എന്‍റെ ജനത്തിൽ ഓരോരുത്തനും അവനവന്‍റെ അവകാശം കൈവിട്ടു പോകാതെയിരിക്കുവാൻ അവൻ സ്വന്തഅവകാശത്തിൽനിന്നു തന്നെ തന്‍റെ പുത്രന്മാർക്ക് അവകാശം കൊടുക്കേണം.”<verse eid="EZK 46:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 46:19" />പിന്നെ അവൻ ഗോപുരത്തിൻ്റെ പാർശ്വത്തിലുള്ള പ്രവേശനത്തിൽകൂടി എന്നെ വടക്കോട്ടു ദർശനമുള്ളതായ, പുരോഹിതന്മാരുടെ വിശുദ്ധമണ്ഡപങ്ങളിലേക്കു കൊണ്ടുചെന്നു; അവിടെ ഞാൻ പടിഞ്ഞാറെ അറ്റത്ത് ഒരു സ്ഥലം കണ്ടു. <verse eid="EZK 46:19" /><verse number="20" style="v" sid="EZK 46:20" />അവൻ എന്നോട്: “പുരോഹിതന്മാർ അകൃത്യയാഗവും പാപയാഗവും പാകം ചെയ്യുന്നതും, ഭോജനയാഗം ചുടുന്നതുമായ സ്ഥലം ഇതാകുന്നു; അവർ ജനത്തെ വിശുദ്ധീകരിക്കേണ്ടതിന് അവയെ പുറത്ത്, പുറത്തെ പ്രാകാരത്തിലേക്കു കൊണ്ടു പോകാതെയിരിക്കുവാൻ തന്നെ” എന്നു അരുളിച്ചെയ്തു.<verse eid="EZK 46:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 46:21" />പിന്നെ അവൻ എന്നെ പുറത്തെ പ്രാകാരത്തിലേക്കു കൊണ്ടുപോയി, പ്രാകാരത്തിന്‍റെ നാലു കോണിലും ചെല്ലുമാറാക്കി; പ്രാകാരത്തിന്‍റെ ഓരോ കോണിലും ഓരോ മുറ്റം ഉണ്ടായിരുന്നു. <verse eid="EZK 46:21" /><verse number="22" style="v" sid="EZK 46:22" />പ്രാകാരത്തിന്‍റെ നാലു കോണിലും നാല്പതു മുഴം നീളവും മുപ്പതു മുഴം വീതിയും ഉള്ള അടക്കപ്പെട്ട മുറ്റങ്ങൾ ഉണ്ടായിരുന്നു; നാലു കോണിലും ഉള്ള, അവ നാലിനും ഒരേ അളവായിരുന്നു. <verse eid="EZK 46:22" /><verse number="23" style="v" sid="EZK 46:23" />അവയ്ക്കു നാലിനും ചുറ്റും ഒരു പന്തി കല്ല് കെട്ടിയിരുന്നു; ഈ കൽനിരകളുടെ ചുവട്ടിൽ ചുറ്റും അടുപ്പ് ഉണ്ടാക്കിയിരുന്നു. <verse eid="EZK 46:23" /><verse number="24" style="v" sid="EZK 46:24" />അവൻ എന്നോട്: “ഇവ ആലയത്തിന്‍റെ ശുശ്രൂഷകന്മാർ ജനത്തിന്‍റെ ഹനനയാഗം പാകം ചെയ്യുന്ന പാചകശാലയാകുന്നു” എന്നു അരുളിച്ചെയ്തു.<verse eid="EZK 46:24" /></para>
  <chapter eid="EZK 46" />
  <chapter number="47" style="c" sid="EZK 47" />
  <para style="s">ദൈവാലയത്തിൽനിന്ന് ഒഴുകുന്ന നദി</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 47:1" />ആ മനുഷ്യന്‍ എന്നെ ആലയത്തിന്‍റെ പ്രവേശനത്തിങ്കൽ തിരികെ കൊണ്ടുവന്നപ്പോൾ, ആലയത്തിന്‍റെ ഉമ്മരപ്പടിയുടെ കീഴിൽനിന്ന് വെള്ളം കിഴക്കോട്ടു പുറപ്പെടുന്നത് ഞാൻ കണ്ടു. ആലയത്തിന്‍റെ ദർശനം കിഴക്കോട്ടായിരുന്നു; ആ വെള്ളം ആലയത്തിന്‍റെ വലത്തുഭാഗത്ത് കീഴിൽനിന്ന് യാഗപീഠത്തിനു തെക്കുവശമായി ഒഴുകി. <verse eid="EZK 47:1" /><verse number="2" style="v" sid="EZK 47:2" />അവൻ വടക്കോട്ടുള്ള ഗോപുരത്തിൽകൂടി എന്നെ പുറത്തു കൊണ്ടുചെന്ന് പുറത്തെ വഴിയായി കിഴക്കോട്ടു ദർശനമുള്ള ഗോപുരത്തിൽകൂടി പുറത്തെ ഗോപുരത്തിലേക്ക് ചുറ്റിനടത്തി കൊണ്ടുപോയി; വെള്ളം വലത്തുഭാഗത്തുകൂടി ഒഴുകുന്നതു ഞാൻ കണ്ടു.<verse eid="EZK 47:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 47:3" />ആ പുരുഷൻ കയ്യിൽ ചരടുമായി കിഴക്കോട്ടു നടന്നു; ആയിരം മുഴം അളന്ന്, എന്നെ വെള്ളത്തിൽകൂടി കടക്കുമാറാക്കി; വെള്ളം കണങ്കാലോളം ആയി. <verse eid="EZK 47:3" /><verse number="4" style="v" sid="EZK 47:4" />അവൻ പിന്നെയും ആയിരം മുഴം അളന്ന്, എന്നെ വെള്ളത്തിൽകൂടി കടക്കുമാറാക്കി; വെള്ളം മുട്ടോളം ആയി; അവൻ പിന്നെയും ആയിരം മുഴം അളന്ന്, എന്നെ കടക്കുമാറാക്കി; വെള്ളം അരയോളം ആയി. <verse eid="EZK 47:4" /><verse number="5" style="v" sid="EZK 47:5" />അവൻ പിന്നെയും ആയിരം മുഴം അളന്നു; അത് എനിക്ക് കടക്കുവാൻ കഴിയാത്ത ഒരു നദിയായി; വെള്ളം പൊങ്ങി, നീന്തിയിട്ടല്ലാതെ കടക്കുവാൻ കഴിയാത്ത ഒരു നദിയായിത്തീർന്നു.<verse eid="EZK 47:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 47:6" />അവൻ എന്നോട്: “മനുഷ്യപുത്രാ, ഇത് നീ കണ്ടുവോ” എന്നു ചോദിച്ചു; പിന്നെ അവൻ എന്നെ നദീതീരത്തു മടങ്ങിച്ചെല്ലുമാറാക്കി. <verse eid="EZK 47:6" /><verse number="7" style="v" sid="EZK 47:7" />ഞാൻ മടങ്ങിച്ചെന്നപ്പോൾ നദീതീരത്ത് ഇക്കരെയും അക്കരെയും അനവധി വൃക്ഷങ്ങൾ നില്ക്കുന്നതു കണ്ടു. <verse eid="EZK 47:7" /><verse number="8" style="v" sid="EZK 47:8" />അപ്പോൾ അവൻ എന്നോട് അരുളിച്ചെയ്തത്: “ഈ വെള്ളം കിഴക്കെ ഗലീലയിലേക്ക് പുറപ്പെട്ടു അരാബായിലേക്ക് ഒഴുകി കടലിൽ വീഴുന്നു; വെള്ളം ഒഴുകിച്ചെന്ന് കടലിൽ വീണ്, അതിലെ വെള്ളം ശുദ്ധമായിത്തീരും. <verse eid="EZK 47:8" /><verse number="9" style="v" sid="EZK 47:9" />എന്നാൽ ഈ നദി ചെല്ലുന്നിടത്തെല്ലാം ചലിക്കുന്ന സകലപ്രാണികളും ജീവിച്ചിരിക്കും; ഈ വെള്ളം അവിടെ വന്നതുകൊണ്ട്, ഏറ്റവുമധികം മത്സ്യം ഉണ്ടാകും; ഈ നദി ചെല്ലുന്നിടത്തെല്ലാം അത് ശുദ്ധമായിത്തീർന്നിട്ട് സകലവും ജീവിക്കും. <verse eid="EZK 47:9" /><verse number="10" style="v" sid="EZK 47:10" />അതിന്‍റെ കരയിൽ ഏൻ-ഗെദി മുതൽ ഏൻ-എഗ്ലയീംവരെ മീൻപിടിത്തക്കാർ നിന്നു വല വീശും; അതിലെ മത്സ്യം മഹാസമുദ്രത്തിലെ മത്സ്യംപോലെ വിവിധ ഇനങ്ങളായി അസംഖ്യമായിരിക്കും. <verse eid="EZK 47:10" /><verse number="11" style="v" sid="EZK 47:11" />എന്നാൽ അതിന്‍റെ ചേറ്റുകണ്ടങ്ങളും ചതുപ്പുനിലങ്ങളും ശുദ്ധമാകാതെ, ഉപ്പിനുവേണ്ടി മാറ്റിവയ്ക്കും. <verse eid="EZK 47:11" /><verse number="12" style="v" sid="EZK 47:12" />നദീതീരത്ത് ഇക്കരെയും അക്കരെയും ഭക്ഷ്യയോഗ്യമായ ഫലമുള്ള സകലവിധ വൃക്ഷങ്ങളും വളരും; അവയുടെ ഇല വാടുകയില്ല, ഫലം ഇല്ലാതെപോകുകയുമില്ല; അതിലെ വെള്ളം വിശുദ്ധമന്ദിരത്തിൽനിന്ന് ഒഴുകിവരുന്നതുകൊണ്ട് അവ മാസംതോറും പുതിയ ഫലം കായ്ക്കും; അവയുടെ ഫലം ഭക്ഷണത്തിനും, അവയുടെ ഇല ചികിത്സക്കും ഉപകരിക്കും.”<verse eid="EZK 47:12" /></para>
  <para style="s">ദേശത്തിൻ്റെ അതിരുകൾ</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 47:13" />യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “നിങ്ങൾ ദേശത്തെ യിസ്രായേലിന്‍റെ പന്ത്രണ്ടു ഗോത്രങ്ങൾക്കും അവകാശമായി വിഭാഗിക്കേണ്ട അതിരുകൾ ഇവയായിരിക്കും: യോസേഫിന് രണ്ടു പങ്ക് ഉണ്ടായിരിക്കേണം. <verse eid="EZK 47:13" /><verse number="14" style="v" sid="EZK 47:14" />‘നിങ്ങളുടെ പൂര്‍വ്വ പിതാക്കന്മാർക്കു നല്കുമെന്ന്’ ഞാൻ കൈ ഉയർത്തി സത്യം ചെയ്തിരിക്കുകകൊണ്ട് നിങ്ങൾക്ക് എല്ലാവർക്കും തുല്യാവകാശം ലഭിക്കേണം; ഈ ദേശം നിങ്ങൾക്ക് അവകാശമായി വരും.<verse eid="EZK 47:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 47:15" />ദേശത്തിന്‍റെ അതിർത്തികൾ ഇങ്ങനെ ആയിരിക്കേണം: വടക്കുഭാഗത്ത് മഹാസമുദ്രംമുതൽ ഹെത്ലോൻവഴിയായി <verse eid="EZK 47:15" /><verse number="16" style="v" sid="EZK 47:16" />സെദാദ് വരെയും ഹമാത്തും ബേരോത്തയും ദമാസ്ക്കസിൻ്റെ അതിർത്തിക്കും ഹമാത്തിന്‍റെ അതിർത്തിക്കും ഇടയിലുള്ള സിബ്രയീമും ഹൗറാൻ്റെ അതിർത്തിയിലുള്ള നടുഹാസേരും <verse eid="EZK 47:16" /><verse number="17" style="v" sid="EZK 47:17" />ഇങ്ങനെ അതിരുകൾ സമുദ്രംമുതൽ ദമാസ്ക്കസിൻ്റെ അതിർത്തിയിലും ഹസർ-ഏനാൻ വരെ വടക്കെഭാഗത്ത് വടക്കോട്ടുള്ള ഹമാത്തിന്‍റെ അതിർത്തിയിലും ആയിരിക്കേണം; അത് വടക്കേഭാഗം.<verse eid="EZK 47:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 47:18" />കിഴക്ക് ഭാഗം ഹൗറാൻ, ദമാസ്കോസ്, ഗിലെയാദ് എന്നിവയ്ക്കും യിസ്രായേൽദേശത്തിനും ഇടയിൽ യോർദ്ദാൻ ആയിരിക്കേണം; വടക്കെ അതിരുമുതൽ കിഴക്കെ കടൽവരെ നിങ്ങൾ അളക്കേണം; അത് കിഴക്കുഭാഗം.<verse eid="EZK 47:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 47:19" />തെക്കുഭാഗം തെക്കോട്ട് താമാർമുതൽ മെരീബോത്ത്-കാദേശ് ജലാശയംവരെയും മിസ്രയീം തോടുവരെയും മഹാസമുദ്രംവരെയും ആയിരിക്കേണം; അത് തെക്കോട്ട് തെക്കേഭാഗം.<verse eid="EZK 47:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 47:20" />പടിഞ്ഞാറുഭാഗം: തെക്കേ അതിരുമുതൽ ഹമാത്തിലേക്കുള്ള തിരിവിന്‍റെ അറ്റംവരെയും മഹാസമുദ്രം ആയിരിക്കേണം; അത് പടിഞ്ഞാറെഭാഗം.<verse eid="EZK 47:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 47:21" />ഇങ്ങനെ നിങ്ങൾ ഈ ദേശത്തെ യിസ്രായേൽഗോത്രങ്ങൾക്കനുസരിച്ച് വിഭാഗിച്ചുകൊള്ളണം. <verse eid="EZK 47:21" /><verse number="22" style="v" sid="EZK 47:22" />നിങ്ങൾ അതിനെ നിങ്ങൾക്കും നിങ്ങളുടെ ഇടയിൽ വന്നുപാർക്കുന്നവരായി, നിങ്ങളുടെ ഇടയിൽ മക്കളെ ജനിപ്പിക്കുന്ന പരദേശികൾക്കും അവകാശമായി ചീട്ടിട്ടു വിഭാഗിക്കേണം; അവർ നിങ്ങൾക്ക് യിസ്രായേൽ മക്കളുടെ ഇടയിൽ സ്വദേശികളെപ്പോലെ ആയിരിക്കേണം; നിങ്ങളോടുകൂടി അവർക്കും യിസ്രായേൽ ഗോത്രങ്ങളുടെ ഇടയിൽ അവകാശം ലഭിക്കേണം. <verse eid="EZK 47:22" /><verse number="23" style="v" sid="EZK 47:23" />പരദേശി വന്നുപാർക്കുന്ന ഗോത്രത്തിൽതന്നെ നിങ്ങൾ അവന് അവകാശം കൊടുക്കേണം” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 47:23" /></para>
  <chapter eid="EZK 47" />
  <chapter number="48" style="c" sid="EZK 48" />
  <para style="s">ദേശത്തിൻ്റെ അതിരുകൾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 48:1" />എന്നാൽ ഗോത്രങ്ങളുടെ പേരുകൾ ഇവയാണ്: വടക്കെ അറ്റം മുതൽ ഹെത്ലോൻ വഴിക്കരികിലുള്ള ഹമാത്ത്‌വരെ വടക്കോട്ട് ദമാസ്ക്കസിൻ്റെ അതിർത്തിയിലുള്ള ഹസർ-ഏനാനും, ഇങ്ങനെ വടക്ക് ഹമാത്തിന്‍റെ പാർശ്വത്തിൽ കിഴക്കും പടിഞ്ഞാറും ഉള്ള ഭാഗങ്ങളായി ദാൻ്റെ ഓഹരി ഒന്ന്. <verse eid="EZK 48:1" /><verse number="2" style="v" sid="EZK 48:2" />ദാൻ്റെ അതിർത്തിയിൽ കിഴക്കെഭാഗംമുതൽ പടിഞ്ഞാറെ ഭാഗംവരെ ആശേരിന്‍റെ ഓഹരി ഒന്ന്. <verse eid="EZK 48:2" /><verse number="3" style="v" sid="EZK 48:3" />ആശേരിന്‍റെ അതിർത്തിയിൽ കിഴക്കെഭാഗംമുതൽ പടിഞ്ഞാറെ ഭാഗംവരെ നഫ്താലിയുടെ ഓഹരി ഒന്ന്. <verse eid="EZK 48:3" /><verse number="4" style="v" sid="EZK 48:4" />നഫ്താലിയുടെ അതിർത്തിയിൽ കിഴക്കെഭാഗംമുതൽ പടിഞ്ഞാറെ ഭാഗംവരെ മനശ്ശെയുടെ ഓഹരി ഒന്ന്. <verse eid="EZK 48:4" /><verse number="5" style="v" sid="EZK 48:5" />മനശ്ശെയുടെ അതിർത്തിയിൽ കിഴക്കുഭാഗംമുതൽ പടിഞ്ഞാറെ ഭാഗംവരെ എഫ്രയീമിന്‍റെ ഓഹരി ഒന്ന്. <verse eid="EZK 48:5" /><verse number="6" style="v" sid="EZK 48:6" />എഫ്രയീമിന്‍റെ അതിർത്തിയിൽ കിഴക്കെഭാഗംമുതൽ പടിഞ്ഞാറെ ഭാഗംവരെ രൂബേന്‍റെ ഓഹരി ഒന്ന്. <verse eid="EZK 48:6" /><verse number="7" style="v" sid="EZK 48:7" />രൂബേന്‍റെ അതിർത്തിയിൽ കിഴക്കെഭാഗംമുതൽ പടിഞ്ഞാറെ ഭാഗംവരെ യെഹൂദായുടെ ഓഹരി ഒന്ന്.<verse eid="EZK 48:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 48:8" />യെഹൂദായുടെ അതിർത്തിയിൽ കിഴക്കെഭാഗംമുതൽ പടിഞ്ഞാറെ ഭാഗംവരെ ഇരുപത്തയ്യായിരം (25,000) മുഴം വീതിയും കിഴക്കെഭാഗംമുതൽ പടിഞ്ഞാറെഭാഗംവരെയുള്ള മറ്റെ ഓഹരികളിൽ ഒന്നിനെപ്പോലെ നീളവും ഉള്ളത് നിങ്ങൾ അർപ്പിക്കേണ്ട വഴിപാടായിരിക്കേണം; വിശുദ്ധമന്ദിരം അതിന്‍റെ നടുവിൽ ആയിരിക്കേണം. <verse eid="EZK 48:8" /><verse number="9" style="v" sid="EZK 48:9" />നിങ്ങൾ യഹോവയ്ക്ക് വഴിപാടായി വേർതിരിക്കുന്ന പ്രദേശം ഇരുപത്തയ്യായിരം (25,000) മുഴം നീളവും പതിനായിരം (10,000) മുഴം വീതിയും ആയിരിക്കേണം. <verse eid="EZK 48:9" /><verse number="10" style="v" sid="EZK 48:10" />ഈ വിശുദ്ധവഴിപാട് പുരോഹിതന്മാർക്കുള്ളതായിരിക്കേണം; അത് വടക്ക് ഇരുപത്തയ്യായിരം (25,000) മുഴം നീളവും പടിഞ്ഞാറ് പതിനായിരം (10,000) മുഴം വീതിയും കിഴക്ക് പതിനായിരം (10,000) മുഴം വീതിയും തെക്ക് ഇരുപത്തയ്യായിരം (25,000) മുഴം നീളവും ഉള്ളത് തന്നെ; യഹോവയുടെ വിശുദ്ധമന്ദിരം അതിന്‍റെ നടുവിൽ ആയിരിക്കേണം. <verse eid="EZK 48:10" /><verse number="11" style="v" sid="EZK 48:11" />അത് എന്‍റെ കാര്യങ്ങൾ നിർവഹിക്കുകയും, യിസ്രായേൽ മക്കൾ തെറ്റിപ്പോയ കാലത്ത്, ലേവ്യർ തെറ്റിപ്പോയതു പോലെ തെറ്റിപ്പോകാതിരിക്കുകയും ചെയ്ത, സാദോക്കിന്‍റെ പുത്രന്മാരായി വിശുദ്ധീകരിക്കപ്പെട്ട പുരോഹിതന്മാർക്കുള്ളതായിരിക്കേണം. <verse eid="EZK 48:11" /><verse number="12" style="v" sid="EZK 48:12" />അങ്ങനെ അത് അവർക്ക് ലേവ്യരുടെ അതിർത്തിയിൽ, ദേശത്തിന്‍റെ വഴിപാടിൽനിന്ന് ഒരു വഴിപാടും അതിപരിശുദ്ധവുമായിരിക്കേണം.<verse eid="EZK 48:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 48:13" />പുരോഹിതന്മാരുടെ അതിരിനോടുചേർന്ന് ലേവ്യർക്കും ഇരുപത്തയ്യായിരം (25,000) മുഴം നീളവും പതിനായിരം മുഴം (10,000) വീതിയും ഉള്ള ഒരംശം ഉണ്ടായിരിക്കേണം; ആകെ ഇരുപത്തയ്യായിരം (25,000) മുഴം നീളവും ഇരുപതിനായിരം (20,000) മുഴം വീതിയും തന്നെ. <verse eid="EZK 48:13" /><verse number="14" style="v" sid="EZK 48:14" />അവർ അതിൽ ഒട്ടും വില്‍ക്കരുത്; കൈമാറ്റം ചെയ്യരുത്; ദേശത്തിന്‍റെ ആദ്യഫലമായ ഇത് അന്യർക്ക് കൈവശം കൊടുക്കുകയുമരുത്; അത് യഹോവയ്ക്കു വിശുദ്ധമാണല്ലോ.<verse eid="EZK 48:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 48:15" />എന്നാൽ ഇരുപത്തയ്യായിരം (25,000) മുഴം വീതിയിൽ ശേഷിച്ചിരിക്കുന്ന അയ്യായിരം (5,000) മുഴം നഗരത്തിനു വാസസ്ഥലവും വെളിമ്പ്രദേശവുമായ സാമാന്യഭൂമിയും, നഗരം അതിന്‍റെ നടുവിലും ആയിരിക്കേണം. <verse eid="EZK 48:15" /><verse number="16" style="v" sid="EZK 48:16" />അതിന്‍റെ അളവ് ഇപ്രകാരമാണ്: വടക്കെഭാഗം നാലായിരത്തഞ്ഞൂറും (4,500) തെക്കെഭാഗം നാലായിരത്തഞ്ഞൂറും (4,500) കിഴക്കെഭാഗം നാലായിരത്തഞ്ഞൂറും (4,500) പടിഞ്ഞാറെഭാഗം നാലായിരത്തഞ്ഞൂറും (4,500) മുഴം. <verse eid="EZK 48:16" /><verse number="17" style="v" sid="EZK 48:17" />നഗരത്തിനുള്ള വെളിമ്പ്രദേശമോ; വടക്കോട്ട് ഇരുനൂറ്റമ്പതും തെക്കോട്ട് ഇരുനൂറ്റമ്പതും കിഴക്കോട്ടു ഇരുനൂറ്റമ്പതും പടിഞ്ഞാറോട്ട് ഇരുനൂറ്റമ്പതും മുഴം. <verse eid="EZK 48:17" /><verse number="18" style="v" sid="EZK 48:18" />എന്നാൽ വിശുദ്ധവഴിപാടിന് ഒത്ത നീളത്തിൽ കിഴക്കോട്ടു പതിനായിരവും (10,000) പടിഞ്ഞാറോട്ടു പതിനായിരവും (10,000) മുഴം; ശേഷിക്കുന്നത് വിശുദ്ധവഴിപാടിനൊത്തവണ്ണം തന്നെ ആയിരിക്കേണം; അതിന്‍റെ അനുഭവം നഗരത്തിലെ കൃഷിക്കാരുടെ ഉപജീവനം ആയിരിക്കേണം. <verse eid="EZK 48:18" /><verse number="19" style="v" sid="EZK 48:19" />യിസ്രായേലിന്‍റെ സർവ്വഗോത്രങ്ങളിലും നിന്നുള്ളവരായ നഗരത്തിലെ കൃഷിക്കാർ അതിൽ കൃഷിചെയ്യേണം. <verse eid="EZK 48:19" /><verse number="20" style="v" sid="EZK 48:20" />വഴിപാടുസ്ഥലം മുഴുവനും ഇരുപത്തയ്യായിരം (25,000) നീളവും ഇരുപത്തയ്യായിരം (25,000) വീതിയും ആയിരിക്കേണം. നഗരസ്വത്തോടുകൂടി ഈ വിശുദ്ധവഴിപാടുസ്ഥലം സമചതുരമായി നിങ്ങൾ അർപ്പിക്കേണം.<verse eid="EZK 48:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 48:21" />ശേഷിക്കുന്ന ഭാഗം പ്രഭുവിനുള്ളതായിരിക്കേണം; വിശുദ്ധവഴിപാടായ സ്ഥലത്തിനും നഗരസ്വത്തിനും ഇരുവശത്തും വഴിപാടുസ്ഥലത്തിൻ്റെ ഇരുപത്തയ്യായിരം (25,000) മുഴത്തിനെതിരെ കിഴക്കെ അതിർത്തിയിലും പടിഞ്ഞാറ് ഇരുപത്തയ്യായിരം (25,000) മുഴത്തിനെതിരെ പടിഞ്ഞാറേ അതിർത്തിയിലും ഗോത്രങ്ങളുടെ ഓഹരികൾക്ക് ഒത്തവണ്ണം തന്നെ; ഇത് പ്രഭുവിനുള്ളതായിരിക്കേണം; വിശുദ്ധവഴിപാടുസ്ഥലവും വിശുദ്ധമന്ദിരമായ ആലയവും അതിന്‍റെ നടുവിൽ ആയിരിക്കേണം; <verse eid="EZK 48:21" /><verse number="22" style="v" sid="EZK 48:22" />ലേവ്യർക്കുള്ള സ്വത്തും നഗരസ്വത്തും പ്രഭുവിനുള്ള സ്ഥലത്തിന്‍റെ മദ്ധ്യത്തിലായിരിക്കണം; യെഹൂദായുടെ അതിരിനും ബെന്യാമീന്‍റെ അതിരിനും ഇടയിൽ ഉള്ളത് പ്രഭുവിനുള്ളതായിരിക്കേണം.<verse eid="EZK 48:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 48:23" />ശേഷമുള്ള ഗോത്രങ്ങൾക്കോ: കിഴക്കെഭാഗംമുതൽ പടിഞ്ഞാറെ ഭാഗംവരെ ബെന്യാമീന് ഓഹരി ഒന്ന്. <verse eid="EZK 48:23" /><verse number="24" style="v" sid="EZK 48:24" />ബെന്യാമീന്‍റെ അതിർത്തിയിൽ കിഴക്കെഭാഗംമുതൽ പടിഞ്ഞാറെ ഭാഗംവരെ ശിമെയോന് ഓഹരി ഒന്ന്. <verse eid="EZK 48:24" /><verse number="25" style="v" sid="EZK 48:25" />ശിമെയൊന്‍റെ അതിർത്തിയിൽ കിഴക്കെഭാഗംമുതൽ പടിഞ്ഞാറെ ഭാഗംവരെ യിസ്സാഖാരിന് ഓഹരി ഒന്ന്. <verse eid="EZK 48:25" /><verse number="26" style="v" sid="EZK 48:26" />യിസ്സാഖാരിന്‍റെ അതിർത്തിയിൽ കിഴക്കെഭാഗംമുതൽ പടിഞ്ഞാറെ ഭാഗംവരെ സെബൂലൂന് ഓഹരി ഒന്ന്. <verse eid="EZK 48:26" /><verse number="27" style="v" sid="EZK 48:27" />സെബൂലൂൻ്റെ അതിർത്തിയിൽ കിഴക്കേഭാഗംമുതൽ പടിഞ്ഞാറെ ഭാഗംവരെ ഗാദിന് ഓഹരി ഒന്ന്. <verse eid="EZK 48:27" /><verse number="28" style="v" sid="EZK 48:28" />ഗാദിന്‍റെ അതിർത്തിയിൽ തെക്കോട്ട് തെക്കേ ഭാഗത്ത് താമാർമുതൽ മെരീബത്ത്-കാദേശ് ജലാശയംവരെയും മിസ്രയീം തോടുവരെയും മഹാസമുദ്രംവരെയും ആയിരിക്കേണം. <verse eid="EZK 48:28" /><verse number="29" style="v" sid="EZK 48:29" />നിങ്ങൾ ചീട്ടിട്ട് യിസ്രായേൽ ഗോത്രങ്ങൾക്ക് അവകാശമായി വിഭാഗിക്കേണ്ടുന്ന ദേശം ഇതുതന്നെ; അവരുടെ ഓഹരികൾ ഇവ തന്നെ” എന്നു യഹോവയായ കർത്താവിന്‍റെ അരുളപ്പാട്.<verse eid="EZK 48:29" /></para>
  <para style="s">പുതിയ നഗരത്തിന്‍റെ കവാടങ്ങൾ</para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 48:30" />നഗരത്തിന്‍റെ അളവുകൾ ഇപ്രകാരമാണ്: വടക്കുഭാഗത്തെ അളവ് നാലായിരത്തഞ്ഞൂറു (4,500) മുഴം. <verse eid="EZK 48:30" /><verse number="31" style="v" sid="EZK 48:31" />നഗരത്തിന്‍റെ ഗോപുരങ്ങൾ യിസ്രായേൽ ഗോത്രങ്ങളുടെ പേരുകൾക്ക് ഒത്തവണ്ണമായിരിക്കണം; വടക്കോട്ട് മൂന്നു ഗോപുരം; രൂബേന്‍റെ ഗോപുരം ഒന്ന്; യെഹൂദായുടെ ഗോപുരം ഒന്ന്; ലേവിയുടെ ഗോപുരം ഒന്ന്. <verse eid="EZK 48:31" /><verse number="32" style="v" sid="EZK 48:32" />കിഴക്കുഭാഗത്ത് നാലായിരത്തഞ്ഞൂറു (4 500) മുഴം; ഗോപുരം മൂന്നു: യോസേഫിന്‍റെ ഗോപുരം ഒന്ന്; ബെന്യാമീന്‍റെ ഗോപുരം ഒന്ന്; ദാൻ്റെ ഗോപുരം ഒന്ന്. <verse eid="EZK 48:32" /><verse number="33" style="v" sid="EZK 48:33" />തെക്കുഭാഗത്തെ അളവ് നാലായിരത്തഞ്ഞൂറു (4,500) മുഴം; ഗോപുരം മൂന്നു; ശിമെയോന്‍റെ ഗോപുരം ഒന്ന്; യിസ്സാഖാരിന്‍റെ ഗോപുരം ഒന്ന്; സെബൂലൂൻ്റെ ഗോപുരം ഒന്ന്. <verse eid="EZK 48:33" /><verse number="34" style="v" sid="EZK 48:34" />പടിഞ്ഞാറെ ഭാഗത്ത് നാലായിരത്തഞ്ഞൂറു (4,500) മുഴം; ഗോപുരം മൂന്നു: ഗാദിന്‍റെ ഗോപുരം ഒന്ന്; ആശേരിന്‍റെ ഗോപുരം ഒന്ന്; നഫ്താലിയുടെ ഗോപുരം ഒന്ന്. <verse eid="EZK 48:34" /><verse number="35" style="v" sid="EZK 48:35" />അതിന്‍റെ ചുറ്റളവ് പതിനെണ്ണായിരം (18,000) മുഴം. അന്നുമുതൽ നഗരത്തിനു ‘യഹോവശമ്മാ<note caller="+" style="f"><char style="fr" closed="false">48:35 </char><char style="fq" closed="false">യഹോവശമ്മാ </char><char style="ft" closed="false">യഹോവ അവിടെ</char></note>’ എന്നു പേരാകും.<verse eid="EZK 48:35" /></para>
  <chapter eid="EZK 48" />
</usx>