<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HOS" style="id" />
  <para style="ide">UTF-8</para>
  <para style="h">ഹോശേയ</para>
  <para style="toc1">ഹോശേയ</para>
  <para style="toc2">ഹോശേ.</para>
  <para style="toc3">ഹോശേ.</para>
  <para style="mt">ഹോശേയ</para>
  <para style="is">ഗ്രന്ഥകര്‍ത്താവ്</para>
  <para style="ip">ഈ പുസ്തകത്തിലെ മിക്ക സന്ദേശങ്ങളും ഹോശേയ പ്രവാചകന്‍റെ സന്ദേശങ്ങളാണ്. ഈ പുസ്തകം അദ്ദേഹം തന്നെ എഴുതിയതാണോ എന്നുള്ളത് വ്യക്തമല്ല, എങ്കിലും ഈ സന്ദേശത്തിന്‍റെ പ്രസക്തി മനസിലാക്കിയ പിന്‍ഗാമികളില്‍ ആരെങ്കിലുമാകാം എഴുതിയത്. രക്ഷ എന്നാണ് ഹോശേയ എന്ന പേരിന്‍റെ അർത്ഥം. മറ്റേത് പ്രവാചകന്മാരെക്കാളും ഇദ്ദേഹത്തിന്‍റെ ശുശ്രൂഷ വ്യക്തി ജീവിതവുമായി വളരെ അടുത്തുനില്‍ക്കുന്ന ഒന്നാണ്. താൻ വിവാഹം കഴിച്ച സ്ത്രീ തന്നെ വഞ്ചിക്കും എന്ന് മനസ്സിലാക്കിയ പ്രവാചകൻ സന്തതികൾക്ക് ന്യായവിധിയുടെ സന്ദേശം ധ്വനിക്കുന്ന പേരുകൾ നൽകി. തന്‍റെ ജീവിതമായിരുന്നു അദ്ദേഹത്തിന്‍റെ സന്ദേശം.</para>
  <para style="is">എഴുതപ്പെട്ട കാലഘട്ടവും സ്ഥലവും</para>
  <para style="ip">ഏകദേശം ക്രി. മു. 750-710.</para>
  <para style="ip">പ്രവാചകന്‍റെ സന്ദേശങ്ങൾ ശേഖരിച്ചു പകർത്തി എഴുതപ്പെട്ടവയാണ് പുസ്തകത്തിന്‍റെ സമാഹരണം. എപ്പോൾ സംഭവിച്ചു എന്നുള്ളത് വ്യക്തമല്ല എങ്കിലും യെരൂശലേമിന്‍റെ നാശത്തിന് മുൻപ് സംഭവിച്ചു എന്നുള്ളത് മനസ്സിലാക്കാം.</para>
  <para style="is">സ്വീകര്‍ത്താക്കള്‍</para>
  <para style="ip">ഇതിന്‍റെ യഥാർത്ഥശ്രോതാക്കൾ വടക്കേ യിസ്രായേൽ രാജ്യത്തെ ജനങ്ങളാണ്. ന്യായവിധിയെകുറിച്ചുള്ള മുന്നറിയിപ്പും മാനസാന്തരപ്പെടുവാൻ ഉള്ള ആഹ്വാനവും, പുനഃസ്ഥാപനത്തെക്കുറിച്ചുള്ള വാഗ്ദാനവുമാണ് പ്രവാചകന്‍റെ വാക്കുകൾ.</para>
  <para style="is">ഉദ്ദേശ്യം</para>
  <para style="ip">ദൈവസന്നിധിയിൽ വിശ്വസ്തതയുടെ പ്രാധാന്യത്തെയാണ് പ്രവാചകൻ യിസ്രായേൽ ജനത്തെയും വായനക്കാരെയും ഓർമിപ്പിക്കുന്നത്. യാഹോവയാണ് ഏക സത്യദൈവം. അവൻ സത്യസന്ധതയാണ് ആവശ്യപ്പെടുന്നത്. പാപം ന്യായവിധിയെ കൊണ്ടുവരുന്നു. വരാൻപോകുന്ന ശത്രുവിന്‍റെ അധിനിവേശത്തെയും അടിമത്തത്തെയും കുറിച്ച് പ്രവാചകൻ മുന്നറിയിപ്പ് നൽകുന്നു. പൊള്ളയായ വാഗ്ദാനങ്ങൾ നൽകുവാൻ ദൈവം മനുഷ്യനല്ല. യിസ്രായേൽജനം ദൈവത്തെ ഉപേക്ഷിച്ചെങ്കിലും അവരെ ഉപേക്ഷിക്കാതെ അവര്‍ക്ക് പുനഃസ്ഥാപനത്തിനുവേണ്ടി ദൈവം വഴിയൊരുക്കുന്നു. പ്രവാചകന്‍റെ അവിശ്വസ്തയായ ഭാര്യയോട് കാണിക്കുന്ന സ്നേഹത്തിന് സമാനമാണ് വിഗ്രഹാരാധകരായ ജനത്തോട് ദൈവം കാണിക്കുന്ന സ്നേഹം. പാപത്തിന്‍റെയും ന്യായവിധിയുടെയും പശ്ചാത്തലത്തിലാണ് ക്ഷമിക്കുന്ന ദൈവസ്നേഹത്തിന്‍റെ പ്രസക്തി.</para>
  <para style="is">പ്രമേയം</para>
  <para style="ip">അവിശ്വസ്തത</para>
  <para style="iot">സംക്ഷേപം</para>
  <para style="io1">1. ഹോശേയയുടെ അവിശ്വസ്തയായ ഭാര്യ — 1:1-11</para>
  <para style="io1">2. യിസ്രായേൽ ജനത്തിന്മേല്‍ ദൈവത്തിന്‍റെ കോപവും ന്യായവിധിയും — 2:1-23</para>
  <para style="io1">3. ദൈവം തന്‍റെ ജനത്തെ വീണ്ടെടുക്കുന്നു — 3:1-5</para>
  <para style="io1">4. യിസ്രായേലിന്‍റെ അവിശ്വസ്തത — 4:1-10:15</para>
  <para style="io1">5. യിസ്രായേലിനോടുള്ള ദൈവത്തിന്‍റെ സ്നേഹവും പുനഃസ്ഥാപനവും — 11:1-14:9</para>
  <chapter number="1" style="c" sid="HOS 1" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 1:1" />ഉസ്സീയാവ്, യോഥാം, ആഹാസ്, ഹിസ്കീയാവ് എന്നീ യെഹൂദാ രാജാക്കന്മാരുടെ കാലത്തും യിസ്രായേൽ രാജാവായ യോവാശിന്‍റെ മകൻ യൊരോബെയാമിന്‍റെ കാലത്തും ബെയേരിയുടെ മകനായ ഹോശേയെക്ക് ഉണ്ടായ യഹോവയുടെ അരുളപ്പാട്.<verse eid="HOS 1:1" /></para>
  <para style="s">ഹോശേയയുടെ ഭാര്യയും മക്കളും</para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 1:2" />യഹോവ ഹോശേയ മുഖാന്തരം സംസാരിച്ചു തുടങ്ങിയപ്പോൾ, യഹോവ ഹോശേയയോട്: “നീ ചെന്നു പരസംഗം ചെയ്യുന്ന ഒരു ഭാര്യയെയും പരസംഗത്തിൽ ജനിച്ച മക്കളെയും എടുക്കുക; ദേശം യഹോവയെ വിട്ടുമാറി കഠിന പരസംഗം ചെയ്തിരിക്കുന്നുവല്ലോ” എന്നു കല്പിച്ചു.<verse eid="HOS 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HOS 1:3" />അങ്ങനെ അവൻ ചെന്നു ദിബ്ലയീമിന്‍റെ മകളായ ഗോമരിനെ പരിഗ്രഹിച്ചു. അവൾ ഗർഭംധരിച്ച് അവന് ഒരു മകനെ പ്രസവിച്ചു. <verse eid="HOS 1:3" /><verse number="4" style="v" sid="HOS 1:4" />യഹോവ അവനോട്: “അവന് ‘യിസ്രായേൽ’<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="fq" closed="false">യിസ്രായേൽ</char><char style="ft" closed="false">ഈ യിസ്രയേല്‍ പട്ടണത്തില്‍ വെച്ചാണ് യേഹു യിസ്രായേല്‍ രാജാവിനേയും രാജകുടുംബാംഗങ്ങളേയും കൊലപ്പെടുത്തിയതും പുതിയ ഭരണത്തിന്‍റെ പ്രഥമ രാജാവായി അധികാരമേറ്റതും. 2 രാജാക്കന്മാര്‍ 9, 10 അധ്യായങ്ങള്‍ നോക്കുക </char></note> എന്നു പേര് വിളിക്കണം; ഇനി കുറെക്കാലം കഴിഞ്ഞിട്ട് ഞാൻ യിസ്രായേലിന്‍റെ രക്തപാതകങ്ങൾ യേഹൂഗൃഹത്തെ സന്ദർശിച്ച് യിസ്രായേൽ ഗൃഹത്തിന്‍റെ രാജത്വം അവസാനിപ്പിക്കും; <verse eid="HOS 1:4" /><verse number="5" style="v" sid="HOS 1:5" />അന്നാളിൽ ഞാൻ യിസ്രായേൽ താഴ്വരയിൽവച്ച് യിസ്രായേലിന്‍റെ വില്ല് ഒടിച്ചുകളയും” എന്നു അരുളിച്ചെയ്തു.<verse eid="HOS 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HOS 1:6" />അവൾ പിന്നെയും ഗർഭംധരിച്ച് ഒരു മകളെ പ്രസവിച്ചു. യഹോവ അവനോട്: “അവൾക്കു ‘ലോരൂഹമാ’<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="fq" closed="false">ലോരൂഹമാ </char><char style="ft" closed="false">കരുണ ലഭിക്കാത്തവൾ</char></note> എന്ന് പേര് വിളിക്കണം; ഞാൻ ഇനി യിസ്രായേൽ ഗൃഹത്തോട് ക്ഷമിക്കുവാൻ തക്കവണ്ണം അവരോട് ഒട്ടും കരുണ കാണിക്കുകയില്ല. <verse eid="HOS 1:6" /><verse number="7" style="v" sid="HOS 1:7" />എന്നാൽ യെഹൂദാഗൃഹത്തോട് ഞാൻ കരുണ കാണിച്ച്, അവരെ വില്ലുകൊണ്ടോ വാൾകൊണ്ടോ യുദ്ധംകൊണ്ടോ കുതിരകളെക്കൊണ്ടോ കുതിരപ്പടയാളികളെക്കൊണ്ടോ രക്ഷിക്കാതെ അവരുടെ ദൈവമായ യഹോവയെക്കൊണ്ട് അവരെ രക്ഷിക്കും” എന്നു അരുളിച്ചെയ്തു.<verse eid="HOS 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 1:8" />അവൾ ലോരൂഹമയെ മുലകുടി മാറ്റിയശേഷം വീണ്ടും ഗർഭംധരിച്ച് ഒരു മകനെ പ്രസവിച്ചു. <verse eid="HOS 1:8" /><verse number="9" style="v" sid="HOS 1:9" />അപ്പോൾ യഹോവ: “അവന് ‘ലോ-അമ്മീ’<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="fq" closed="false">ലോ-അമ്മീ </char><char style="ft" closed="false">എന്‍റെ ജനമല്ല</char></note> എന്നു പേര് വിളിക്കണം; നിങ്ങൾ എന്‍റെ ജനമല്ല, ഞാൻ നിങ്ങൾക്ക് ദൈവമായിരിക്കുകയുമില്ല” എന്നു അരുളിച്ചെയ്തു.<verse eid="HOS 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HOS 1:10" />“എങ്കിലും യിസ്രായേൽ മക്കളുടെ എണ്ണം അളക്കുവാനും എണ്ണുവാനും കഴിയാത്ത കടല്ക്കരയിലെ മണൽ പോലെയായിരിക്കും; ‘നിങ്ങൾ എന്‍റെ ജനമല്ല’ എന്നു അവരോട് അരുളിച്ചെയ്തതിന് പകരം ‘നിങ്ങൾ ജീവനുള്ള ദൈവത്തിന്‍റെ മക്കൾ’ എന്നു അവരോട് പറയും. <verse eid="HOS 1:10" /><verse number="11" style="v" sid="HOS 1:11" />യെഹൂദാമക്കളും യിസ്രായേൽമക്കളും ഒന്നിച്ചുകൂടി തങ്ങൾക്കു ഒരു തലവനെ നിയമിച്ച് ദേശത്തുനിന്ന് പുറപ്പെട്ടുപോകും; യിസ്രായേലിന്‍റെ നാൾ വലുതായിരിക്കുമല്ലോ<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="fq" closed="false">യിസ്രായേലിന്‍റെ നാൾ വലുതായിരിക്കുമല്ലോ </char><char style="ft" closed="false">ദൈവം തന്‍റെ ജനത്തെ വീണ്ടും നടും</char></note>.”<verse eid="HOS 1:11" /></para>
  <chapter eid="HOS 1" />
  <chapter number="2" style="c" sid="HOS 2" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 2:1" />നിങ്ങളുടെ സഹോദരന്മാർക്ക് ‘അമ്മീ’<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fq" closed="false">അമ്മീ </char><char style="ft" closed="false">എന്‍റെ ജനം</char></note> എന്നും നിങ്ങളുടെ സഹോദരിമാർക്ക് ‘രൂഹമാ’<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fq" closed="false">രൂഹമാ </char><char style="ft" closed="false">കരുണ ലഭിച്ചവൾ</char></note> എന്നും പേര് വിളിക്കുവിൻ.<verse eid="HOS 2:1" /></para>
  <para style="s">യിസ്രായേലിന്‍റെ ശിക്ഷയും വീണ്ടെടുപ്പും</para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="HOS 2:2" />വ്യവഹരിക്കുവിൻ;</para>
  <para style="q2" vid="HOS 2:2">നിങ്ങളുടെ അമ്മയോട് വ്യവഹരിക്കുവിൻ;</para>
  <para style="q1" vid="HOS 2:2">അവൾ എന്‍റെ ഭാര്യയല്ല,</para>
  <para style="q2" vid="HOS 2:2">ഞാൻ അവളുടെ ഭർത്താവുമല്ല;</para>
  <para style="q1" vid="HOS 2:2">അവൾ പരസംഗം മുഖത്തുനിന്നും</para>
  <para style="q2" vid="HOS 2:2">വ്യഭിചാരം മാറിടത്തിൽ നിന്നും നീക്കിക്കളയട്ടെ.<verse eid="HOS 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 2:3" />അല്ലെങ്കിൽ ഞാൻ അവളെ വസ്ത്രം അഴിച്ച് നഗ്നയാക്കി,</para>
  <para style="q2" vid="HOS 2:3">ജനിച്ച ദിവസത്തിലെന്നപോലെ നിർത്തുകയും</para>
  <para style="q1" vid="HOS 2:3">അവളെ മരുഭൂമിയും വരണ്ടനിലവും പോലെ ആക്കി,</para>
  <para style="q2" vid="HOS 2:3">ദാഹംകൊണ്ട് മരിപ്പിക്കുകയും ചെയ്യും.<verse eid="HOS 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 2:4" />ഞാൻ അവളുടെ മക്കളോട് കരുണ കാണിക്കുകയില്ല;</para>
  <para style="q2" vid="HOS 2:4">അവർ പരസംഗത്തിൽ ജനിച്ച മക്കളല്ലോ.<verse eid="HOS 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 2:5" />അവരുടെ അമ്മ പരസംഗം ചെയ്തു;</para>
  <para style="q2" vid="HOS 2:5">അവരെ പ്രസവിച്ചവൾ ലജ്ജാകരമായി പ്രവർത്തിച്ചു;</para>
  <para style="q1" vid="HOS 2:5">“എനിക്ക് അപ്പവും വെള്ളവും</para>
  <para style="q2" vid="HOS 2:5">ആട്ടുരോമവും ശണവും</para>
  <para style="q1" vid="HOS 2:5">എണ്ണയും പാനീയവും തരുന്ന</para>
  <para style="q2" vid="HOS 2:5">എന്‍റെ ജാരന്മാരുടെ പിന്നാലെ ഞാൻ പോകും” എന്നു പറഞ്ഞുവല്ലോ.<verse eid="HOS 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 2:6" />അതുകൊണ്ട് ഞാൻ അവളുടെ വഴി</para>
  <para style="q2" vid="HOS 2:6">മുള്ളുകൊണ്ട് വേലികെട്ടി അടയ്ക്കും;</para>
  <para style="q1" vid="HOS 2:6">അവൾ തന്‍റെ പാതകൾ കണ്ടെത്താത്ത വിധം</para>
  <para style="q2" vid="HOS 2:6">ഞാൻ ഒരു മതിൽ ഉണ്ടാക്കും.<verse eid="HOS 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 2:7" />അവൾ ജാരന്മാരെ പിന്തുടരും;</para>
  <para style="q2" vid="HOS 2:7">എങ്കിലും അവരോട് ഒപ്പം എത്തുകയില്ല;</para>
  <para style="q1" vid="HOS 2:7">അവൾ അവരെ അന്വേഷിക്കും,</para>
  <para style="q2" vid="HOS 2:7">കണ്ടെത്തുകയില്ലതാനും;</para>
  <para style="q1" vid="HOS 2:7">അപ്പോൾ അവൾ: “ഞാൻ എന്‍റെ ആദ്യത്തെ ഭർത്താവിന്‍റെ അടുക്കൽ മടങ്ങിപ്പോകും;</para>
  <para style="q2" vid="HOS 2:7">ഇന്നത്തേക്കാൾ അന്ന് എനിക്ക് ഏറെ നന്നായിരുന്നുവല്ലോ” എന്നു പറയും.<verse eid="HOS 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 2:8" />അവൾക്ക് ധാന്യവും വീഞ്ഞും എണ്ണയും നല്കിയതും</para>
  <para style="q2" vid="HOS 2:8">ബാലിനു വേണ്ടി ഉപയോഗിച്ച</para>
  <para style="q1" vid="HOS 2:8">അവളുടെ വെള്ളിയും പൊന്നും വർദ്ധിപ്പിച്ചതും</para>
  <para style="q2" vid="HOS 2:8">ഞാനായിരുന്നു എന്ന് അവൾ അറിഞ്ഞില്ല.<verse eid="HOS 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HOS 2:9" />അതുകൊണ്ട് തക്കകാലത്ത് എന്‍റെ ധാന്യവും</para>
  <para style="q2" vid="HOS 2:9">തക്കസമയത്ത് എന്‍റെ വീഞ്ഞും ഞാൻ തിരികെ എടുക്കുകയും</para>
  <para style="q1" vid="HOS 2:9">അവളുടെ നഗ്നത മറയ്ക്കുവാൻ കൊടുത്തിരുന്ന</para>
  <para style="q2" vid="HOS 2:9">എന്‍റെ ആട്ടിൻ രോമവും ശണവും എടുത്തുകളയുകയും ചെയ്യും.<verse eid="HOS 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 2:10" />ഇപ്പോൾ ഞാൻ അവളുടെ ജാരന്മാർ കാൺകെ</para>
  <para style="q2" vid="HOS 2:10">അവളുടെ നഗ്നത അനാവൃതമാക്കും;</para>
  <para style="q1" vid="HOS 2:10">ആരും അവളെ എന്‍റെ കയ്യിൽനിന്ന്</para>
  <para style="q2" vid="HOS 2:10">വിടുവിക്കുകയില്ല.<verse eid="HOS 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 2:11" />ഞാൻ അവളുടെ സകലവിധ സന്തോഷവും ഉത്സവങ്ങളും</para>
  <para style="q2" vid="HOS 2:11">അമാവാസികളും ശബ്ബത്തുകളും</para>
  <para style="q2" vid="HOS 2:11">അവളുടെ വിശേഷദിവസങ്ങളും ഇല്ലാതെയാക്കും.<verse eid="HOS 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 2:12" />“ഇത് എന്‍റെ ജാരന്മാർ എനിക്ക് തന്ന സമ്മാനങ്ങൾ” എന്ന് അവൾ പറഞ്ഞ</para>
  <para style="q2" vid="HOS 2:12">മുന്തിരിവള്ളികളും അത്തിവൃക്ഷങ്ങളും ഞാൻ നശിപ്പിക്കും;</para>
  <para style="q1" vid="HOS 2:12">അവയെ ഞാന്‍ വനമാക്കിത്തീര്‍ക്കും;</para>
  <para style="q2" vid="HOS 2:12">വന്യമൃഗങ്ങൾ അവയെ തിന്നുകളയും.<verse eid="HOS 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 2:13" />അവൾ ബാല്‍ വിഗ്രഹങ്ങൾക്ക് ധൂപം കാണിച്ച്</para>
  <para style="q2" vid="HOS 2:13">കുണുക്കും ആഭരണങ്ങളുംകൊണ്ട് സ്വയം അലങ്കരിച്ച്</para>
  <para style="q1" vid="HOS 2:13">തന്‍റെ ജാരന്മാരെ പിന്തുടർന്ന്</para>
  <para style="q2" vid="HOS 2:13">എന്നെ മറന്നുകളഞ്ഞ നാളുകൾ ഞാൻ അവളോട് സന്ദർശിക്കും” എന്നു യഹോവയുടെ അരുളപ്പാട്.<verse eid="HOS 2:13" /></para>
  <para style="s">യഹോവയുടെ സ്നേഹം</para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 2:14" />“അതുകൊണ്ട് ഞാൻ അവളെ വശീകരിച്ച്</para>
  <para style="q2" vid="HOS 2:14">മരുഭൂമിയിൽ കൊണ്ടുചെന്ന്</para>
  <para style="q2" vid="HOS 2:14">അവളോട് ഹൃദ്യമായി സംസാരിക്കും.<verse eid="HOS 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 2:15" />അവിടെ ഞാൻ അവൾക്ക് മുന്തിരിത്തോട്ടങ്ങളും</para>
  <para style="q2" vid="HOS 2:15">പ്രത്യാശയുടെ വാതിലായി ആഖോർ താഴ്‌വരയും കൊടുക്കും;</para>
  <para style="q1" vid="HOS 2:15">അവൾ അവിടെ യൗവന കാലത്തെന്നപോലെയും</para>
  <para style="q2" vid="HOS 2:15">മിസ്രയീം ദേശത്തുനിന്ന് പുറപ്പെട്ടുവന്ന നാളിലെപ്പോലെയും പാട്ട് പാടും<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="fq" closed="false">പാട്ട് പാടും </char><char style="ft" closed="false">ഉത്തരം പറയും</char></note>.<verse eid="HOS 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 2:16" />അന്നാളിൽ നീ എന്നെ ‘ബാലീ’<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="fq" closed="false">ബാലീ </char><char style="ft" closed="false">ഉടയവനേ</char></note> എന്നല്ല</para>
  <para style="q2" vid="HOS 2:16">‘ഈശീ’<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="fq" closed="false">ഈശീ </char><char style="ft" closed="false">ഭർത്താവേ</char></note> എന്ന് വിളിക്കും” എന്നു യഹോവയുടെ അരുളപ്പാട്.<verse eid="HOS 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 2:17" />“ഞാൻ ബാല്‍ വിഗ്രഹങ്ങളുടെ പേരുകൾ അവളുടെ വായിൽനിന്ന് നീക്കിക്കളയും;</para>
  <para style="q2" vid="HOS 2:17">ഇനി ആരും അവയെ പേര് ചൊല്ലി സ്മരിക്കുകയുമില്ല.<verse eid="HOS 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 2:18" />അന്നാളിൽ ഞാൻ അവർക്ക് വേണ്ടി കാട്ടിലെ മൃഗങ്ങളോടും</para>
  <para style="q2" vid="HOS 2:18">ആകാശത്തിലെ പക്ഷികളോടും</para>
  <para style="q1" vid="HOS 2:18">ഭൂമിയിലെ ഇഴജാതികളോടും</para>
  <para style="q2" vid="HOS 2:18">ഒരു നിയമം ചെയ്യും;</para>
  <para style="q1" vid="HOS 2:18">ഞാൻ വില്ലും വാളും യുദ്ധവും</para>
  <para style="q2" vid="HOS 2:18">ഭൂമിയിൽനിന്ന് നീക്കി,</para>
  <para style="q2" vid="HOS 2:18">അവരെ നിർഭയം വസിക്കുമാറാക്കും.<verse eid="HOS 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 2:19" />ഞാൻ നിന്നെ സദാകാലത്തേക്കും</para>
  <para style="q2" vid="HOS 2:19">എനിക്ക് വിവാഹത്തിന് നിശ്ചയിക്കും;</para>
  <para style="q1" vid="HOS 2:19">അതെ, നീതിയോടും ന്യായത്തോടും ദയയോടും കരുണയോടുംകൂടി</para>
  <para style="q2" vid="HOS 2:19">നിന്നെ എനിക്ക് വിവാഹത്തിന് നിശ്ചയിക്കും.<verse eid="HOS 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="HOS 2:20" />ഞാൻ വിശ്വസ്തതയോടെ നിന്നെ എനിക്ക് വിവാഹത്തിന് നിശ്ചയിക്കും;</para>
  <para style="q2" vid="HOS 2:20">നീ യഹോവയെ അറിയുകയും ചെയ്യും.”<verse eid="HOS 2:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="HOS 2:21" />“ആ കാലത്ത് ഞാൻ ഉത്തരം നല്കും”</para>
  <para style="q2" vid="HOS 2:21">എന്നു യഹോവ അരുളിച്ചെയ്യുന്നു:</para>
  <para style="q1" vid="HOS 2:21">“ഞാൻ ആകാശത്തിന് ഉത്തരം നല്കും;</para>
  <para style="q2" vid="HOS 2:21">ആകാശം ഭൂമിക്ക് ഉത്തരം നല്കും;<verse eid="HOS 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="HOS 2:22" />ഭൂമി ധാന്യത്തിനും വീഞ്ഞിനും എണ്ണയ്ക്കും ഉത്തരം നല്കും;</para>
  <para style="q2" vid="HOS 2:22">അവ യിസ്രയേലിനും ഉത്തരം നല്കും.<verse eid="HOS 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="HOS 2:23" />ഞാൻ അതിനെ എനിക്കായി ദേശത്ത് വിതയ്ക്കും;</para>
  <para style="q2" vid="HOS 2:23">കരുണ ലഭിക്കാത്തവളോട് ഞാൻ കരുണ കാണിക്കും.</para>
  <para style="q1" vid="HOS 2:23">എന്‍റെ ജനമല്ലാത്തവരോട്: ‘നീ എന്‍റെ ജനം’ എന്നു ഞാൻ പറയും;</para>
  <para style="q2" vid="HOS 2:23">‘അങ്ങ് എന്‍റെ ദൈവം’ എന്നു അവരും പറയും.”<verse eid="HOS 2:23" /></para>
  <chapter eid="HOS 2" />
  <chapter number="3" style="c" sid="HOS 3" />
  <para style="s">ഹോശേയയുടെ ഭാര്യ വീണ്ടെടുക്കപ്പെടുന്നു</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 3:1" />അനന്തരം യഹോവ എന്നോട്: “യിസ്രായേൽ മക്കൾ അന്യദേവന്മാരോട് ചേർന്ന് മുന്തിരിയടകൾ<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="fq" closed="false">മുന്തിരിയടകൾ </char><char style="ft" closed="false">പുരാതന മധ്യപൂര്‍വ ദേശത്ത് ജനങ്ങള്‍ ഉണങ്ങിയ മുന്തിരിയില്‍ നിന്ന് അടകളുണ്ടാക്കി അന്യദൈവങ്ങള്‍ക്ക് സമര്‍പ്പിക്കുമായിരുന്നു. അങ്ങനെ ചെയ്യുന്നതിലൂടെ വലിയ വിളവു ലഭിക്കുമെന്ന് അവര്‍ വിശ്വസിച്ചിരുന്നു</char></note> ഇഷ്ടപ്പെടുന്നുവെങ്കിലും യഹോവ അവരെ സ്നേഹിക്കുന്നതുപോലെ, നീ വീണ്ടും ചെന്നു ഒരു ജാരനാൽ സ്നേഹിക്കപ്പെടുന്ന വ്യഭിചാരിണിയായ സ്ത്രീയെ സ്നേഹിക്കുക” എന്ന് കല്പിച്ചു.<verse eid="HOS 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 3:2" />അങ്ങനെ ഞാൻ അവളെ പതിനഞ്ചു വെള്ളിക്കാശും<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fq" closed="false">പതിനഞ്ചു വെള്ളിക്കാശും </char><char style="ft" closed="false">170 ഗ്രാം വെള്ളി</char></note> ഒന്നര ഹോമെർ<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fq" closed="false">ഒന്നര ഹോമെർ </char><char style="ft" closed="false">ഏകദേശം 150 കിലോഗ്രാം യവം</char></note> യവവും വിലകൊടുത്ത് വാങ്ങി. <verse eid="HOS 3:2" /><verse number="3" style="v" sid="HOS 3:3" />ഞാൻ അവളോട്: “നീ ബഹുകാലം എന്നോടൊപ്പം അടങ്ങിപ്പാർക്കണം; പരസംഗം ചെയ്യുകയോ മറ്റൊരു പുരുഷന്‍റെ ഭാര്യയാകുകയോ അരുത്; ഞാനും അങ്ങനെ തന്നെ ചെയ്യും” എന്നു പറഞ്ഞു.<verse eid="HOS 3:3" /></para>
  <para style="s">യിസ്രായേലിന്‍റെ തിരിച്ചുവരവ്</para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 3:4" />ഈ വിധം യിസ്രായേൽ മക്കൾ ബഹുകാലം രാജാവില്ലാതെയും, പ്രഭുവില്ലാതെയും, യാഗമില്ലാതെയും, പ്രതിഷ്ഠയില്ലാതെയും, എഫോദില്ലാതെയും, ഗൃഹബിംബമില്ലാതെയും ഇരിക്കും. <verse eid="HOS 3:4" /><verse number="5" style="v" sid="HOS 3:5" />പിന്നെ, യിസ്രായേൽ മക്കൾ മനംതിരിഞ്ഞ് തങ്ങളുടെ ദൈവമായ യഹോവയെയും തങ്ങളുടെ രാജാവായ ദാവീദിനെയും അന്വേഷിക്കും. അന്ത്യനാളുകളിൽ അവർ ഭയപ്പെട്ട് യഹോവയിലേക്കും അവിടുത്തെ നന്മയിലേക്കും മടങ്ങിവരും.<verse eid="HOS 3:5" /></para>
  <chapter eid="HOS 3" />
  <chapter number="4" style="c" sid="HOS 4" />
  <para style="s">യിസ്രായേലിനെതിരെ കുറ്റാരോപണം</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 4:1" />യിസ്രായേൽ മക്കളേ, യഹോവയുടെ വചനം കേൾക്കുവിൻ;</para>
  <para style="q2" vid="HOS 4:1">യഹോവയ്ക്ക് ദേശനിവാസികളോട് ഒരു വ്യവഹാരം ഉണ്ട്;</para>
  <para style="q1" vid="HOS 4:1">ദേശത്ത് സത്യവും ദയയും ഇല്ല,</para>
  <para style="q2" vid="HOS 4:1">ദൈവപരിജ്ഞാനവുമില്ല.<verse eid="HOS 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 4:2" />അവർ ആണയിടുന്നു; ഭോഷ്ക് പറയുന്നു;</para>
  <para style="q2" vid="HOS 4:2">കൊല ചെയ്യുന്നു; മോഷ്ടിക്കുന്നു;</para>
  <para style="q1" vid="HOS 4:2">വ്യഭിചരിക്കുന്നു; എല്ലാ അതിരുകളും ലംഘിക്കുന്നു;</para>
  <para style="q2" vid="HOS 4:2">രക്തപാതകത്തോട് രക്തപാതകം കൂട്ടുന്നു.<verse eid="HOS 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 4:3" />അതുകൊണ്ട് ദേശം ദുഃഖിക്കുന്നു;</para>
  <para style="q2" vid="HOS 4:3">അതിലെ സകലനിവാസികളും വയലിലെ മൃഗങ്ങളും</para>
  <para style="q1" vid="HOS 4:3">ആകാശത്തിലെ പറവകളും തളർന്നുപോകുന്നു;</para>
  <para style="q2" vid="HOS 4:3">സമുദ്രത്തിൽ മത്സ്യങ്ങളും ഇല്ലാതെയാകുന്നു.<verse eid="HOS 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HOS 4:4" />എങ്കിലും ആരും തർക്കിക്കരുത്;</para>
  <para style="q2" vid="HOS 4:4">ആരും മറ്റൊരുവനെ ശാസിക്കുകയും അരുത്;</para>
  <para style="q1" vid="HOS 4:4">നിന്‍റെ ജനമോ, പുരോഹിതനോട്</para>
  <para style="q2" vid="HOS 4:4">തർക്കിക്കുന്നവരെപ്പോലെ ഇരിക്കുന്നു.<verse eid="HOS 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 4:5" />അതുകൊണ്ട് നീ പകൽ സമയത്ത് ഇടറിവീഴും;</para>
  <para style="q2" vid="HOS 4:5">പ്രവാചകനും നിന്നോടൊപ്പം രാത്രിയിൽ ഇടറിവീഴും;</para>
  <para style="q2" vid="HOS 4:5">നിന്‍റെ അമ്മയെ ഞാൻ നശിപ്പിക്കും.<verse eid="HOS 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 4:6" />പരിജ്ഞാനമില്ലായ്കയാൽ എന്‍റെ ജനം നശിച്ചുപോകുന്നു;</para>
  <para style="q2" vid="HOS 4:6">പരിജ്ഞാനം ത്യജിച്ചതുകൊണ്ട്</para>
  <para style="q2" vid="HOS 4:6">നീ എനിക്ക് പുരോഹിതനായിരിക്കാതെ ഞാൻ നിന്നെയും ത്യജിക്കും;</para>
  <para style="q1" vid="HOS 4:6">നീ നിന്‍റെ ദൈവത്തിന്‍റെ ന്യായപ്രമാണം മറന്നുകളഞ്ഞതുകൊണ്ട്</para>
  <para style="q2" vid="HOS 4:6">ഞാനും നിന്‍റെ മക്കളെ മറക്കും.<verse eid="HOS 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 4:7" />അവർ പെരുകുന്തോറും എന്നോട് ഏറെ പാപംചെയ്തു;</para>
  <para style="q2" vid="HOS 4:7">ഞാൻ അവരുടെ മഹത്ത്വത്തെ ലജ്ജയായി മാറ്റും.<verse eid="HOS 4:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HOS 4:8" />അവർ എന്‍റെ ജനത്തിന്‍റെ പാപംകൊണ്ട് ഉപജീവനം കഴിക്കുന്നു;</para>
  <para style="q2" vid="HOS 4:8">ജനം അകൃത്യത്തിനായിട്ട് ആഗ്രഹിക്കുന്നു.<verse eid="HOS 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 4:9" />ആകയാൽ ജനത്തിന് എപ്രകാരമോ, പുരോഹിതനും അപ്രകാരം തന്നെ ഭവിക്കും.</para>
  <para style="q2" vid="HOS 4:9">ഞാൻ അവരുടെ തെറ്റായ വഴികൾ നിമിത്തം അവരെ സന്ദർശിച്ച്</para>
  <para style="q2" vid="HOS 4:9">അവരുടെ പ്രവൃത്തികൾക്കു തക്കവിധം അവർക്ക് പകരം കൊടുക്കും.<verse eid="HOS 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 4:10" />അവർ ഭക്ഷിച്ചാലും തൃപ്തി പ്രാപിക്കുകയില്ല;</para>
  <para style="q2" vid="HOS 4:10">അവർ പരസംഗം ചെയ്താലും പെരുകുകയില്ല;</para>
  <para style="q2" vid="HOS 4:10">യഹോവയെ അനുസരിക്കുന്നത് അവർ വിട്ടുകളഞ്ഞുവല്ലോ.<verse eid="HOS 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 4:11" />പരസംഗവും വീഞ്ഞും പുതിയ വീഞ്ഞും</para>
  <para style="q2" vid="HOS 4:11">ബുദ്ധിയെ കെടുത്തിക്കളയുന്നു.<verse eid="HOS 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 4:12" />എന്‍റെ ജനം തങ്ങളുടെ മരംകൊണ്ടുള്ള വിഗ്രഹങ്ങളോട് അരുളപ്പാട് ചോദിക്കുന്നു;</para>
  <para style="q2" vid="HOS 4:12">അവരുടെ ഊന്നുവടി അവരോട് ലക്ഷണം പറയുന്നു;</para>
  <para style="q1" vid="HOS 4:12">പരസംഗമോഹം അവരെ വഴി തെറ്റിക്കുന്നു;</para>
  <para style="q2" vid="HOS 4:12">അവർ തങ്ങളുടെ ദൈവത്തെ വിട്ട് പരസംഗം ചെയ്യുന്നു.<verse eid="HOS 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 4:13" />അവർ പർവ്വതശിഖരങ്ങളിൽ ബലികഴിക്കുന്നു;</para>
  <para style="q2" vid="HOS 4:13">കുന്നുകളിൽ അവർ നല്ല തണലുള്ള കരുവേലകത്തിന്‍റെയും പുന്നയുടെയും ആലിന്‍റെയും കീഴിൽ ധൂപം കാട്ടുന്നു;</para>
  <para style="b" vid="HOS 4:13" />
  <para style="q1" vid="HOS 4:13">അവിടെ നിങ്ങളുടെ പുത്രിമാർ പരസംഗം ചെയ്യുന്നു;</para>
  <para style="q2" vid="HOS 4:13">നിങ്ങളുടെ പുത്ര ഭാര്യമാർ വ്യഭിചരിക്കുന്നു.<verse eid="HOS 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 4:14" />നിങ്ങളുടെ പുത്രിമാർ പരസംഗം ചെയ്യുന്നതും</para>
  <para style="q2" vid="HOS 4:14">നിങ്ങളുടെ വധുക്കൾ വ്യഭിചരിച്ചുനടക്കുന്നതും ഞാൻ സന്ദർശിക്കുകയില്ല;</para>
  <para style="q1" vid="HOS 4:14">നിങ്ങളുടെ പുരുഷന്മാരും വേശ്യാസ്ത്രീകളോടുകൂടി വേറിട്ട് പോകുകയും</para>
  <para style="q2" vid="HOS 4:14">ദേവദാസികളോടുകൂടി ബലി കഴിക്കുകയും ചെയ്യുന്നുവല്ലോ;</para>
  <para style="q2" vid="HOS 4:14">ഇങ്ങനെ ബുദ്ധിയില്ലാത്ത ജനം നശിച്ചുപോകും. <note caller="+" style="f"><char style="fr" closed="false">4:14 </char><char style="fq" closed="false">നിങ്ങളുടെ പുത്രിമാർ പരസംഗം ചെയ്യുന്നതും നിങ്ങളുടെ വധുക്കൾ വ്യഭിചരിച്ചുനടക്കുന്നതും ഞാൻ സന്ദർശിക്കുകയില്ല; നിങ്ങളുടെ പുരുഷന്മാരും വേശ്യാസ്ത്രീകളോടുകൂടി വേറിട്ട് പോകുകയും ദേവദാസികളോടുകൂടി ബലി കഴിക്കുകയും ചെയ്യുന്നുവല്ലോ; ഇങ്ങനെ ബുദ്ധിയില്ലാത്ത ജനം നശിച്ചുപോകും. </char><char style="ft" closed="false">ഈ ജനം കനാന്യവിഗ്രഹാരാധന സ്ഥലങ്ങളില്‍ ആയിരിക്കുകയും സമൃദ്ധി പ്രദാനം ചെയ്യുമെന്ന് അന്ധമായി കരുതുന്ന അന്യദേവന്മാരെ ആരാധിക്കുകയും ചെയ്തിരുന്നു. കനാന്യസ്തീകളുമായി അവിഹിതബന്ധം പുലര്‍ത്തിയാല്‍ അവരുടെ നിലങ്ങള്‍ക്കും കന്നുകാലികള്‍ക്കും സമൃദ്ധിയുണ്ടാകുമെന്നും വിശ്വസിച്ചിരുന്നു. </char></note><verse eid="HOS 4:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="HOS 4:15" />യിസ്രായേലേ, നീ പരസംഗം ചെയ്താലും,</para>
  <para style="q2" vid="HOS 4:15">യെഹൂദാ അപരാധം ചെയ്യാതിരിക്കട്ടെ;</para>
  <para style="q1" vid="HOS 4:15">നിങ്ങൾ ഗില്ഗാലിലേക്ക് ചെല്ലരുത്;</para>
  <para style="q2" vid="HOS 4:15">ബേത്ത്-ആവെനിലേക്ക് കയറിപ്പോകരുത്;</para>
  <para style="q2" vid="HOS 4:15">യഹോവയാണ’ എന്ന് സത്യം ചെയ്യുകയുമരുത്.<verse eid="HOS 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 4:16" />യിസ്രായേൽ ദുശ്ശാഠ്യമുള്ള പശുക്കിടാവിനെപ്പോലെ ദുശ്ശാഠ്യം കാണിച്ചാൽ</para>
  <para style="q2" vid="HOS 4:16">യഹോവ അവരെ ഒരു വിശാലസ്ഥലത്ത് കുഞ്ഞാടിനെപ്പോലെ മേയിക്കുമോ?<verse eid="HOS 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 4:17" />എഫ്രയീം വിഗ്രഹങ്ങളുടെ കൂട്ടാളിയാകുന്നു;</para>
  <para style="q2" vid="HOS 4:17">അവനെ വിട്ടുകളയുക.<verse eid="HOS 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 4:18" />മദ്യപാനം കഴിയുമ്പോൾ അവർ പരസംഗം ചെയ്യും;</para>
  <para style="q2" vid="HOS 4:18">അവരുടെ പ്രഭുക്കന്മാർ ലജ്ജാകരമായ കാര്യങ്ങൾ അത്യന്തം ഇഷ്ടപ്പെടുന്നു.<verse eid="HOS 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 4:19" />കാറ്റ് അവളെ ചിറകുകൾകൊണ്ട് ചുറ്റിപ്പിടിക്കുന്നു.</para>
  <para style="q2" vid="HOS 4:19">അവർ തങ്ങളുടെ ബലികൾ നിമിത്തം ലജ്ജിച്ചുപോകും.<verse eid="HOS 4:19" /></para>
  <chapter eid="HOS 4" />
  <chapter number="5" style="c" sid="HOS 5" />
  <para style="s">യിസ്രായേൽ നേതാക്കളുടെ പരാജയം</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 5:1" />പുരോഹിതന്മാരേ, കേൾക്കുവിൻ;</para>
  <para style="q2" vid="HOS 5:1">യിസ്രായേൽ ഗൃഹമേ, ചെവിക്കൊള്ളുവിൻ;</para>
  <para style="q1" vid="HOS 5:1">രാജഗൃഹമേ, ചെവിതരുവിൻ;</para>
  <para style="q2" vid="HOS 5:1">നിങ്ങൾ മിസ്പയ്ക്ക് ഒരു കെണിയും</para>
  <para style="q1" vid="HOS 5:1">താബോരിന്മേൽ വിരിച്ച വലയും ആയിത്തീർന്നിരിക്കുകകൊണ്ട്</para>
  <para style="q2" vid="HOS 5:1">നിങ്ങൾക്ക് ന്യായവിധി വരുന്നു.<verse eid="HOS 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 5:2" />മത്സരികൾ വഷളത്വത്തിൽ ആണ്ടുപോയിരിക്കുന്നു;</para>
  <para style="q2" vid="HOS 5:2">ഞാൻ അവർ എല്ലാവരെയും ശാസിക്കും.<verse eid="HOS 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 5:3" />ഞാൻ എഫ്രയീമിനെ അറിയുന്നു;</para>
  <para style="q2" vid="HOS 5:3">യിസ്രായേൽ എനിക്ക് മറഞ്ഞിരിക്കുന്നതുമില്ല;</para>
  <para style="q1" vid="HOS 5:3">എഫ്രയീമേ, നീ ഇപ്പോൾ പരസംഗം ചെയ്തിരിക്കുന്നു;</para>
  <para style="q2" vid="HOS 5:3">യിസ്രായേൽ മലിനമായിരിക്കുന്നു.<verse eid="HOS 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 5:4" />അവർ തങ്ങളുടെ ദൈവത്തിന്‍റെ അടുക്കലേക്ക് മടങ്ങിവരുവാൻ</para>
  <para style="q2" vid="HOS 5:4">അവരുടെ പ്രവൃത്തികൾ സമ്മതിക്കുന്നില്ല;</para>
  <para style="q1" vid="HOS 5:4">പരസംഗമോഹം അവരുടെ ഉള്ളിൽ ഉണ്ട്;</para>
  <para style="q2" vid="HOS 5:4">അവർ യഹോവയെ അറിയുന്നതുമില്ല.<verse eid="HOS 5:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="HOS 5:5" />യിസ്രായേലിന്‍റെ മുഖം അവന്‍റെ അഹംഭാവം സാക്ഷീകരിക്കുന്നു;</para>
  <para style="q2" vid="HOS 5:5">അതുകൊണ്ട് യിസ്രായേലും എഫ്രയീമും തങ്ങളുടെ അകൃത്യത്താൽ ഇടറിവീഴും;</para>
  <para style="q2" vid="HOS 5:5">യെഹൂദയും അവരോടുകൂടി ഇടറിവീഴും.<verse eid="HOS 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 5:6" />അവർ ആടുമാടുകളോടുകൂടി</para>
  <para style="q2" vid="HOS 5:6">യഹോവയെ അന്വേഷിക്കും;</para>
  <para style="q1" vid="HOS 5:6">എങ്കിലും അവർ അവനെ കണ്ടെത്തുകയില്ല;</para>
  <para style="q2" vid="HOS 5:6">അവൻ അവരെ വിട്ടുമാറിയിരിക്കുന്നു.<verse eid="HOS 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 5:7" />അവർ ജാരസന്തതികൾക്കു ജന്മം നല്കിയിരിക്കുകയാൽ</para>
  <para style="q2" vid="HOS 5:7">യഹോവയോട് വിശ്വാസവഞ്ചന ചെയ്തിരിക്കുന്നു.</para>
  <para style="q1" vid="HOS 5:7">ഇപ്പോൾ അമാവാസി അവരെ</para>
  <para style="q2" vid="HOS 5:7">അവരുടെ അവകാശത്തോടുകൂടി തിന്നുകളയും.<verse eid="HOS 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HOS 5:8" />ഗിബെയയിൽ ആട്ടിൻകൊമ്പും</para>
  <para style="q2" vid="HOS 5:8">രാമയിൽ കാഹളവും ഊതുവിൻ;</para>
  <para style="q1" vid="HOS 5:8">ബേത്ത്-ആവെനിൽ പോർവിളി മുഴക്കുവിൻ;</para>
  <para style="q2" vid="HOS 5:8">ബെന്യാമീനേ, ഞങ്ങൾ നിന്‍റെ പിറകെ വരുന്നു.<verse eid="HOS 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 5:9" />ശിക്ഷാദിവസത്തിൽ എഫ്രയീം ശൂന്യമാകും;</para>
  <para style="q2" vid="HOS 5:9">നിശ്ചയമുള്ളത് ഞാൻ യിസ്രായേൽ ഗോത്രങ്ങളുടെ ഇടയിൽ അറിയിച്ചിരിക്കുന്നു.<verse eid="HOS 5:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="HOS 5:10" />യെഹൂദാപ്രഭുക്കന്മാർ അതിര്‍ മാറ്റുന്നവരെപ്പോലെ ആയിത്തീർന്നു;</para>
  <para style="q2" vid="HOS 5:10">അതുകൊണ്ട് ഞാൻ എന്‍റെ ക്രോധം വെള്ളംപോലെ അവരുടെ മേൽ പകരും.<verse eid="HOS 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 5:11" />എഫ്രയീം മാനുഷകല്പന അനുസരിച്ചുനടക്കുവാൻ ഇഷ്ടപ്പെട്ടതുകൊണ്ട്</para>
  <para style="q2" vid="HOS 5:11">അവൻ പീഡിതനും വ്യവഹാരത്തിൽ തോറ്റവനും ആയിരിക്കുന്നു.<verse eid="HOS 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 5:12" />അതുകൊണ്ട് ഞാൻ എഫ്രയീമിന് പുഴുവും</para>
  <para style="q2" vid="HOS 5:12">യെഹൂദാഗൃഹത്തിന് ദ്രവത്വവുമായിരിക്കും.<verse eid="HOS 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 5:13" />എഫ്രയീം തന്‍റെ വ്യാധിയും</para>
  <para style="q2" vid="HOS 5:13">യെഹൂദാ തന്‍റെ മുറിവും കണ്ടപ്പോൾ</para>
  <para style="q1" vid="HOS 5:13">എഫ്രയീം അശ്ശൂരിൽ യുദ്ധതല്പരനായ രാജാവിന്‍റെ അടുക്കൽ ആളയച്ചു;</para>
  <para style="q2" vid="HOS 5:13">എങ്കിലും നിങ്ങളെ സൗഖ്യമാക്കുവാനും</para>
  <para style="q2" vid="HOS 5:13">നിങ്ങളുടെ മുറിവ് ഉണക്കുവാനും അവനു കഴിഞ്ഞില്ല.<verse eid="HOS 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 5:14" />ഞാൻ എഫ്രയീമിന് ഒരു സിംഹംപോലെയും</para>
  <para style="q2" vid="HOS 5:14">യെഹൂദാഗൃഹത്തിന് ഒരു ബാലസിംഹംപോലെയും ആയിരിക്കും;</para>
  <para style="q2" vid="HOS 5:14">ഞാൻ തന്നെ കടിച്ചുകീറി കടന്നുപോകും;</para>
  <para style="q1" vid="HOS 5:14">ഞാൻ പിടിച്ചു കൊണ്ടുപോകും;</para>
  <para style="q2" vid="HOS 5:14">ആരും എന്‍റെ കയ്യിൽനിന്ന് വിടുവിക്കുകയുമില്ല.<verse eid="HOS 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 5:15" />അവർ കുറ്റം ഏറ്റുപറഞ്ഞ് എന്‍റെ മുഖം അന്വേഷിക്കുവോളം</para>
  <para style="q2" vid="HOS 5:15">ഞാൻ മടങ്ങിപ്പോയി എന്‍റെ സ്ഥാനത്ത് ഇരിക്കും;</para>
  <para style="q1" vid="HOS 5:15">അവരുടെ കഷ്ടതയിൽ</para>
  <para style="q2" vid="HOS 5:15">അവർ എന്നെ ജാഗ്രതയോടെ അന്വേഷിക്കും.<verse eid="HOS 5:15" /></para>
  <chapter eid="HOS 5" />
  <chapter number="6" style="c" sid="HOS 6" />
  <para style="s">മാനസാന്തരപ്പെടാത്ത യിസ്രായേൽ</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 6:1" />വരുവിൻ നാം യഹോവയുടെ അടുക്കലേക്ക് മടങ്ങിചെല്ലുക.</para>
  <para style="q2" vid="HOS 6:1">അവിടുന്നു നമ്മെ കടിച്ചു കീറിയിരിക്കുന്നു;</para>
  <para style="q2" vid="HOS 6:1">എങ്കിലും അവിടുന്നു നമ്മെ സൗഖ്യമാക്കും;</para>
  <para style="q1" vid="HOS 6:1">അവിടുന്നു നമ്മെ അടിച്ചിരിക്കുന്നു;</para>
  <para style="q2" vid="HOS 6:1">എങ്കിലും അവിടുന്നു നമ്മുടെ മുറിവ് കെട്ടും.<verse eid="HOS 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 6:2" />രണ്ടു ദിവസം കഴിഞ്ഞ് അവിടുന്നു നമ്മെ ജീവിപ്പിക്കും;</para>
  <para style="q2" vid="HOS 6:2">മൂന്നാംദിവസം അവിടുന്നു നമ്മെ എഴുന്നേല്പിക്കും;</para>
  <para style="q2" vid="HOS 6:2">നാം അവിടുത്തെ മുമ്പാകെ ജീവിക്കുകയും ചെയ്യും.<verse eid="HOS 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 6:3" />നാം അറിഞ്ഞുകൊള്ളുക;</para>
  <para style="q2" vid="HOS 6:3">യഹോവയെ അറിയുവാൻ നാം ഉത്സാഹിക്കുക;</para>
  <para style="q1" vid="HOS 6:3">അവിടുത്തെ ഉദയം പ്രഭാതം പോലെ നിശ്ചയമുള്ളത്;</para>
  <para style="q2" vid="HOS 6:3">അവിടുന്ന് മഴപോലെ, ഭൂമിയെ നനയ്ക്കുന്ന പിൻമഴപോലെ തന്നെ, നമ്മുടെ അടുക്കൽ വരും.<verse eid="HOS 6:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HOS 6:4" />എഫ്രയീമേ, ഞാൻ നിനക്കുവേണ്ടി എന്ത് ചെയ്യേണം?</para>
  <para style="q2" vid="HOS 6:4">യെഹൂദയേ, ഞാൻ നിനക്കുവേണ്ടി എന്ത് ചെയ്യേണം?</para>
  <para style="q1" vid="HOS 6:4">നിങ്ങളുടെ സ്നേഹം പ്രഭാതമേഘംപോലെയും</para>
  <para style="q2" vid="HOS 6:4">പുലർച്ചയിൽ നീങ്ങിപ്പോകുന്ന മഞ്ഞുപോലെയും ഇരിക്കുന്നു.<verse eid="HOS 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 6:5" />അതുകൊണ്ട് ഞാൻ പ്രവാചകന്മാർ മുഖാന്തരം അവരെ വെട്ടി,</para>
  <para style="q2" vid="HOS 6:5">എന്‍റെ വായിലെ വചനങ്ങളാൽ അവരെ കൊന്നുകളഞ്ഞു;</para>
  <para style="q2" vid="HOS 6:5">എന്‍റെ ന്യായം വെളിച്ചംപോലെ ഉദിക്കുന്നു.<verse eid="HOS 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 6:6" />യാഗമല്ല, കരുണ അത്രേ ഞാൻ ആഗ്രഹിക്കുന്നത്;</para>
  <para style="q2" vid="HOS 6:6">ഹോമയാഗങ്ങളെക്കാൾ ദൈവപരിജ്ഞാനത്തിൽ ഞാൻ പ്രസാദിക്കുന്നു.<verse eid="HOS 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 6:7" />എന്നാൽ അവർ ആദാമിനെപ്പോലെ നിയമം ലംഘിച്ചു;</para>
  <para style="q2" vid="HOS 6:7">അവിടെ അവർ എന്നോട് അവിശ്വസ്തത കാണിച്ചിരിക്കുന്നു.<verse eid="HOS 6:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HOS 6:8" />ഗിലെയാദ് അകൃത്യം പ്രവർത്തിക്കുന്നവരുടെ പട്ടണം,</para>
  <para style="q2" vid="HOS 6:8">അത് രക്തംകൊണ്ട് മലിനമായിരിക്കുന്നു.<verse eid="HOS 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 6:9" />പതിയിരിക്കുന്ന കവർച്ചക്കാരെപ്പോലെ ഒരു കൂട്ടം പുരോഹിതന്മാർ</para>
  <para style="q2" vid="HOS 6:9">ശെഖേമിലേക്കുള്ള വഴിയിൽ കൊല ചെയ്യുന്നു;</para>
  <para style="q2" vid="HOS 6:9">അതേ, അവർ ദുഷ്കർമ്മം ചെയ്യുന്നു.<verse eid="HOS 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 6:10" />യിസ്രായേൽഗൃഹത്തിൽ ഞാൻ ഒരു ഭയങ്കരകാര്യം കണ്ടിരിക്കുന്നു;</para>
  <para style="q2" vid="HOS 6:10">അവിടെ എഫ്രയീം പരസംഗം ചെയ്തു;</para>
  <para style="q2" vid="HOS 6:10">യിസ്രായേൽ മലിനമായിരിക്കുന്നു.<verse eid="HOS 6:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 6:11" />യെഹൂദയേ, ഞാൻ എന്‍റെ ജനത്തിന്‍റെ സ്ഥിതി മാറ്റുമ്പോൾ,</para>
  <para style="q2" vid="HOS 6:11">നിനക്കും ഒരു കൊയ്ത്ത് വച്ചിരിക്കുന്നു.<verse eid="HOS 6:11" /></para>
  <chapter eid="HOS 6" />
  <chapter number="7" style="c" sid="HOS 7" />
  <para style="s">ദുഷ്ടതയോടുള്ള യിസ്രായേലിന്‍റെ സ്നേഹം</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 7:1" />ഞാൻ യിസ്രായേലിനെ സൗഖ്യമാക്കുമ്പോൾ,</para>
  <para style="q2" vid="HOS 7:1">എഫ്രയീമിന്‍റെ അകൃത്യങ്ങൾ വെളിച്ചത്തുവരുകയും</para>
  <para style="q1" vid="HOS 7:1">ശമര്യയുടെ ദുഷ്ടത വെളിപ്പെട്ടുവരുകയും ചെയ്യുന്നു;</para>
  <para style="q2" vid="HOS 7:1">അവർ വ്യാജം പ്രവർത്തിക്കുന്നു;</para>
  <para style="q1" vid="HOS 7:1">അകത്ത് കള്ളൻ കടക്കുന്നു;</para>
  <para style="q2" vid="HOS 7:1">പുറത്ത് കവർച്ചക്കാരുടെ കൂട്ടം കൊള്ളയിടുന്നു.<verse eid="HOS 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 7:2" />എന്നാൽ, അവരുടെ സകല ദുഷ്ടതയും ഞാൻ ഓർക്കുന്നു എന്ന്</para>
  <para style="q2" vid="HOS 7:2">അവർ മനസ്സിൽ ചിന്തിക്കുന്നില്ല;</para>
  <para style="q1" vid="HOS 7:2">ഇപ്പോൾ അവരുടെ സ്വന്തപ്രവൃത്തികൾ അവരെ ചുറ്റിയിരിക്കുന്നു;</para>
  <para style="q2" vid="HOS 7:2">അവ എന്‍റെ മുമ്പാകെ ഇരിക്കുന്നു.<verse eid="HOS 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 7:3" />അവർ ദുഷ്ടതകൊണ്ട് രാജാവിനെയും</para>
  <para style="q2" vid="HOS 7:3">ഭോഷ്കുകൊണ്ട് പ്രഭുക്കന്മാരെയും സന്തോഷിപ്പിക്കുന്നു.<verse eid="HOS 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 7:4" />അവർ എല്ലാവരും വ്യഭിചാരികൾ ആകുന്നു;</para>
  <para style="q2" vid="HOS 7:4">അവർ നീറിക്കത്തുന്ന അടുപ്പുപോലെ ആകുന്നു.</para>
  <para style="q1" vid="HOS 7:4">മാവു കുഴച്ചതുമുതൽ അത് പുളിക്കുവോളം</para>
  <para style="q2" vid="HOS 7:4">അപ്പക്കാരൻ തീ ആളികത്തിക്കാതിരിക്കുന്നതുപോലെ.<verse eid="HOS 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 7:5" />നമ്മുടെ രാജാവിന്‍റെ ഉത്സവദിവസത്തിൽ</para>
  <para style="q2" vid="HOS 7:5">പ്രഭുക്കന്മാർ വീഞ്ഞു കുടിച്ച് ഉന്മത്തരാകുന്നു;</para>
  <para style="q2" vid="HOS 7:5">അവൻ പരിഹാസികളുമായി കൂട്ടുചേരുന്നു.<verse eid="HOS 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 7:6" />അവർ പതിയിരിക്കുന്ന സമയത്ത്</para>
  <para style="q2" vid="HOS 7:6">അവരുടെ ഹൃദയം അടുപ്പുപോലെ നീറിക്കത്തുന്നു;</para>
  <para style="q1" vid="HOS 7:6">അവരുടെ വികാരം രാത്രിമുഴുവൻ പുകയുന്നു;</para>
  <para style="q2" vid="HOS 7:6">രാവിലെ അത് ജ്വലിക്കുന്ന തീപോലെ കത്തുന്നു.<verse eid="HOS 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 7:7" />അവരെല്ലാം അടുപ്പുപോലെ ചൂടുപിടിച്ച്,</para>
  <para style="q2" vid="HOS 7:7">തങ്ങളുടെ ന്യായാധിപതിമാരെ തിന്നുകളയുന്നു;</para>
  <para style="q1" vid="HOS 7:7">അവരുടെ രാജാക്കന്മാർ എല്ലാം വീണുപോയിരിക്കുന്നു;</para>
  <para style="q2" vid="HOS 7:7">അവരുടെ ഇടയിൽ എന്നോട് അപേക്ഷിക്കുന്നവൻ ആരുമില്ല.<verse eid="HOS 7:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HOS 7:8" />എഫ്രയീം ജനതയോട് ഇടകലർന്നിരിക്കുന്നു;</para>
  <para style="q2" vid="HOS 7:8">എഫ്രയീം മറിച്ചിടാത്ത ദോശ ആകുന്നു.<verse eid="HOS 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 7:9" />അന്യജനത അവന്‍റെ ബലം തിന്നുകളഞ്ഞെങ്കിലും</para>
  <para style="q2" vid="HOS 7:9">അവൻ അത് അറിയുന്നില്ല;</para>
  <para style="q1" vid="HOS 7:9">അവന്‍റെ തല അവിടവിടെ നരച്ചിരിക്കുന്നു</para>
  <para style="q2" vid="HOS 7:9">എങ്കിലും അവൻ അത് അറിയുന്നില്ല.<verse eid="HOS 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 7:10" />യിസ്രായേലിന്‍റെ അഹംഭാവം അവന്‍റെ മുഖത്ത് പ്രകടമായിരിക്കുന്നു;</para>
  <para style="q2" vid="HOS 7:10">എന്നാൽ അവർ തങ്ങളുടെ ദൈവമായ യഹോവയുടെ അടുക്കൽ മടങ്ങിവന്നിട്ടില്ല;</para>
  <para style="q2" vid="HOS 7:10">ഈ കാര്യങ്ങളിൽ അവനെ അന്വേഷിച്ചിട്ടും ഇല്ല.<verse eid="HOS 7:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 7:11" />എഫ്രയീം ബുദ്ധികെട്ട പൊട്ടപ്രാവുപോലെ ആകുന്നു;</para>
  <para style="q2" vid="HOS 7:11">അവർ മിസ്രയീമിനെ വിളിക്കുകയും അശ്ശൂരിലേക്ക് പോകുകയും ചെയ്യുന്നു.<verse eid="HOS 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 7:12" />അവർ പോകുമ്പോൾ ഞാൻ എന്‍റെ വല അവരുടെ മേൽ വീശും;</para>
  <para style="q2" vid="HOS 7:12">ഞാൻ അവരെ ആകാശത്തിലെ പറവകളെപ്പോലെ താഴെ വരുത്തും;</para>
  <para style="q1" vid="HOS 7:12">അവരുടെ സഭയിൽ കേൾപ്പിച്ചതുപോലെ</para>
  <para style="q2" vid="HOS 7:12">ഞാൻ അവരെ ശിക്ഷിക്കും.<verse eid="HOS 7:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="HOS 7:13" />അവർ എന്നെ വിട്ട് ഓടിപ്പോയതുകൊണ്ട് അവർക്ക് അയ്യോ കഷ്ടം;</para>
  <para style="q2" vid="HOS 7:13">അവർ എന്നോട് അതിക്രമം ചെയ്തതുകൊണ്ട് അവർക്ക് നാശം;</para>
  <para style="q1" vid="HOS 7:13">ഞാൻ അവരെ വീണ്ടെടുക്കുവാൻ വിചാരിച്ചിട്ടും</para>
  <para style="q2" vid="HOS 7:13">അവർ എന്നോട് ഭോഷ്ക് സംസാരിക്കുന്നു.<verse eid="HOS 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 7:14" />അവർ ഹൃദയപൂർവ്വം എന്നോട് നിലവിളിക്കാതെ</para>
  <para style="q2" vid="HOS 7:14">കിടക്കയിൽവച്ച് അലമുറയിടുന്നു;</para>
  <para style="q1" vid="HOS 7:14">അവർ ധാന്യവും വീഞ്ഞും നിമിത്തം ഒന്നിച്ചുകൂടുന്നു;</para>
  <para style="q2" vid="HOS 7:14">അവർ എന്നോട് മത്സരിക്കുന്നു.<verse eid="HOS 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 7:15" />ഞാൻ അവരെ അഭ്യസിപ്പിച്ച് അവരുടെ ഭുജങ്ങളെ ബലപ്പെടുത്തിയിട്ടും,</para>
  <para style="q2" vid="HOS 7:15">അവർ എന്‍റെ നേരെ ദോഷം നിരൂപിക്കുന്നു.<verse eid="HOS 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 7:16" />അവർ മടങ്ങിവരുന്നു, അത്യുന്നതനായ ദൈവത്തിന്‍റെ അടുക്കലേക്ക് അല്ലതാനും;</para>
  <para style="q2" vid="HOS 7:16">അവർ വഞ്ചനയുള്ള വില്ലുപോലെ ആകുന്നു;</para>
  <para style="q1" vid="HOS 7:16">അവരുടെ പ്രഭുക്കന്മാർ നാവിന്‍റെ ക്രോധം നിമിത്തം വാളുകൊണ്ട് വീഴും;</para>
  <para style="q2" vid="HOS 7:16">അത് മിസ്രയീം ദേശത്ത്</para>
  <para style="q2" vid="HOS 7:16">അവർക്ക് പരിഹാസഹേതുവായിത്തീരും.<verse eid="HOS 7:16" /></para>
  <chapter eid="HOS 7" />
  <chapter number="8" style="c" sid="HOS 8" />
  <para style="s">യിസ്രായേൽ കൊടുങ്കാറ്റു കൊയ്യും</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 8:1" />“കാഹളം നിന്‍റെ ചുണ്ടുകളോട് അടുപ്പിക്കുക;</para>
  <para style="q2" vid="HOS 8:1">അവർ എന്‍റെ ഉടമ്പടി ലംഘിച്ച്</para>
  <para style="q1" vid="HOS 8:1">എന്‍റെ ന്യായപ്രമാണത്തോടു മത്സരിച്ചതുമൂലം;</para>
  <para style="q2" vid="HOS 8:1">യഹോവയുടെ മന്ദിരത്തിനുമീതേ ശത്രു ഒരു കഴുകനെപ്പോലെ പറന്നുവരും.<verse eid="HOS 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 8:2" />അവർ എന്നോട്: “ദൈവമേ, യിസ്രായേലാകുന്ന ഞങ്ങൾ നിന്നെ അറിയുന്നു” എന്ന് അവർ എന്നോടു നിലവിളിക്കുന്നു.<verse eid="HOS 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 8:3" />യിസ്രായേൽ നന്മയായത് ഉപേക്ഷിച്ചുകളഞ്ഞിരിക്കുന്നു;</para>
  <para style="q2" vid="HOS 8:3">ശത്രു അവനെ പിന്തുടരട്ടെ.<verse eid="HOS 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 8:4" />അവർ രാജാക്കന്മാരെ വാഴിച്ചു, ഞാൻ മുഖാന്തരം അല്ലതാനും;</para>
  <para style="q2" vid="HOS 8:4">ഞാൻ അറിയാതെ പ്രഭുക്കന്മാരെ അവർ നിയമിച്ചിരിക്കുന്നു;</para>
  <para style="q1" vid="HOS 8:4">അവർ ഛേദിക്കപ്പെടേണ്ടതിന് വെള്ളികൊണ്ടും പൊന്നുകൊണ്ടും</para>
  <para style="q2" vid="HOS 8:4">തങ്ങൾക്ക് വിഗ്രഹങ്ങൾ ഉണ്ടാക്കി.<verse eid="HOS 8:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="HOS 8:5" />“ശമര്യയേ, നിന്‍റെ പശുക്കിടാവിനെ അവൻ വെറുക്കുന്നു;</para>
  <para style="q2" vid="HOS 8:5">എന്‍റെ കോപം അവരുടെ നേരെ ജ്വലിക്കുന്നു;</para>
  <para style="q2" vid="HOS 8:5">അവർക്ക് നിഷ്ക്കളങ്കത എത്രത്തോളം അപ്രാപ്യമായിരിക്കും?<verse eid="HOS 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 8:6" />ഇത് യിസ്രായേലിന്‍റെ കൈപ്പണി തന്നെ;</para>
  <para style="q2" vid="HOS 8:6">ഒരു കൗശലപ്പണിക്കാരൻ അത് ഉണ്ടാക്കി, അത് ദൈവമല്ല;</para>
  <para style="q2" vid="HOS 8:6">ശമര്യയുടെ പശുക്കിടാവ് പല കഷണങ്ങളായി നുറുങ്ങിപ്പോകും.<verse eid="HOS 8:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="HOS 8:7" />“അവർ കാറ്റ് വിതച്ച്, ചുഴലിക്കാറ്റ് കൊയ്യും;</para>
  <para style="q2" vid="HOS 8:7">ചെടികളിൽ തണ്ടിൽ കതിരില്ല,</para>
  <para style="q1" vid="HOS 8:7">അവ ധാന്യമാവ് നല്കുകയുമില്ല;</para>
  <para style="q2" vid="HOS 8:7">നല്കിയാലും അന്യർ അത് തിന്നുകളയും.<verse eid="HOS 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 8:8" />യിസ്രായേൽ വിഴുങ്ങപ്പെട്ടു;</para>
  <para style="q2" vid="HOS 8:8">അവർ ഇപ്പോൾ ജനതയുടെ ഇടയിൽ ആർക്കും ഇഷ്ടമില്ലാത്ത ഒരു പാത്രംപോലെ ആയിരിക്കുന്നു.<verse eid="HOS 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 8:9" />അവർ കൂട്ടം വിട്ട് നടക്കുന്ന കാട്ടുകഴുതയെപോലെ</para>
  <para style="q2" vid="HOS 8:9">അശ്ശൂരിലേക്കു പോയി;</para>
  <para style="q1" vid="HOS 8:9">എഫ്രയീം ജാരന്മാരെ</para>
  <para style="q2" vid="HOS 8:9">കൂലിക്ക് വാങ്ങിയിരിക്കുന്നു.<verse eid="HOS 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 8:10" />അവർ ജനതയുടെ ഇടയിൽനിന്ന് ജാരന്മാരെ കൂലിക്ക് വാങ്ങിയാലും</para>
  <para style="q2" vid="HOS 8:10">ഇപ്പോൾ ഞാൻ അവരെ ഒന്നിച്ചുകൂട്ടും;</para>
  <para style="q1" vid="HOS 8:10">അവർ പ്രഭുക്കന്മാരുടെ രാജാവിന്‍റെ ചുമടിൻകീഴിൽ</para>
  <para style="q2" vid="HOS 8:10">അല്പം വേദന അനുഭവിക്കും.<verse eid="HOS 8:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 8:11" />“എഫ്രയീം പാപപരിഹാരത്തിനായി അനേകം യാഗപീഠങ്ങൾ ഉണ്ടാക്കിയതുകൊണ്ട്,</para>
  <para style="q1" vid="HOS 8:11">യാഗപീഠങ്ങൾ അവന് പാപഹേതുവായി തീർന്നിരിക്കുന്നു.<verse eid="HOS 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 8:12" />ഞാൻ എന്‍റെ ന്യായപ്രമാണം അവന് പതിനായിരം കല്പനയായി എഴുതിക്കൊടുത്താലും</para>
  <para style="q2" vid="HOS 8:12">അവ അപൂർവ്വകാര്യമായി എണ്ണപ്പെടുന്നു.<verse eid="HOS 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 8:13" />അവർ എന്‍റെ അർപ്പണയാഗങ്ങൾക്കുള്ള മൃഗങ്ങളെ അറുത്ത് മാംസം തിന്നുന്നു;</para>
  <para style="q2" vid="HOS 8:13">എന്നാൽ യഹോവ അവയിൽ പ്രസാദിക്കുന്നില്ല;</para>
  <para style="q1" vid="HOS 8:13">ഇപ്പോൾ അവൻ അവരുടെ അകൃത്യം ഓർത്തു അവരുടെ പാപം സന്ദർശിക്കും;</para>
  <para style="q2" vid="HOS 8:13">അവർ മിസ്രയീമിലേക്ക് മടങ്ങിപ്പോകേണ്ടിവരും.<verse eid="HOS 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 8:14" />യിസ്രായേൽ അവരെ ഉണ്ടാക്കിയ ദൈവത്തെ മറന്ന് മന്ദിരങ്ങൾ പണിതിരിക്കുന്നു;</para>
  <para style="q2" vid="HOS 8:14">യെഹൂദാ ഉറപ്പുള്ള പട്ടണങ്ങൾ വർദ്ധിപ്പിച്ചിരിക്കുന്നു;</para>
  <para style="q1" vid="HOS 8:14">എന്നാൽ ഞാൻ അവന്‍റെ പട്ടണങ്ങളിൽ തീ അയയ്ക്കും;</para>
  <para style="q2" vid="HOS 8:14">ആ തീ അവയിലുള്ള അരമനകൾ ദഹിപ്പിച്ചുകളയും.”<verse eid="HOS 8:14" /></para>
  <chapter eid="HOS 8" />
  <chapter number="9" style="c" sid="HOS 9" />
  <para style="s">യിസ്രായേൽ ശിക്ഷിക്കപ്പെടും</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 9:1" />യിസ്രായേലേ, നീ ആനന്ദിക്കരുത്;</para>
  <para style="q2" vid="HOS 9:1">മറ്റു ജനതകളെപ്പോലെ സന്തോഷംകൊണ്ടു തുള്ളിച്ചാടുകയും വേണ്ട;</para>
  <para style="q1" vid="HOS 9:1">നിന്‍റെ ദൈവത്തെ ഉപേക്ഷിച്ചു നീ പരസംഗം ചെയ്തിരിക്കുന്നുവല്ലോ.</para>
  <para style="q2" vid="HOS 9:1">ധാന്യക്കളങ്ങളിൽ എല്ലാം നിങ്ങൾ വേശ്യയുടെ കൂലിയാണല്ലോ ആഗ്രഹിച്ചത്.<verse eid="HOS 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 9:2" />ധാന്യക്കളവും ചക്കും അവരെ പോഷിപ്പിക്കുകയില്ല,</para>
  <para style="q2" vid="HOS 9:2">പുതുവീഞ്ഞ് അതിൽ ഇല്ലാതെയാകും.<verse eid="HOS 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 9:3" />അവർ യഹോവയുടെ ദേശത്ത് വസിക്കുകയില്ല;</para>
  <para style="q2" vid="HOS 9:3">എഫ്രയീം മിസ്രയീമിലേക്ക് മടങ്ങിപ്പോകുകയും</para>
  <para style="q2" vid="HOS 9:3">അശ്ശൂരിൽവച്ച് മലിനമായത്<note caller="+" style="f"><char style="fr" closed="false">9:3 </char><char style="fq" closed="false">മലിനമായത് </char><char style="ft" closed="false">മോശെയുടെ ന്യായപ്രമാണപ്രകാരം ചില ഭക്ഷണവസ്തുക്കള്‍ അശുദ്ധമായതിനാല്‍ ഭക്ഷിക്കുവാന്‍ പാടുള്ളതല്ല. </char></note> തിന്നുകയും ചെയ്യും.<verse eid="HOS 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 9:4" />അവർ യഹോവയ്ക്ക് വീഞ്ഞ് അർപ്പിക്കുകയില്ല;</para>
  <para style="q2" vid="HOS 9:4">അവരുടെ ഹനനയാഗങ്ങൾ അവന് പ്രസാദമായിരിക്കുകയുമില്ല;</para>
  <para style="q1" vid="HOS 9:4">അവർ അർപ്പിക്കുന്ന അപ്പം</para>
  <para style="q2" vid="HOS 9:4">അവർക്ക് വിലാപത്തിന്‍റെ അപ്പം പോലെ ആയിരിക്കും;</para>
  <para style="q1" vid="HOS 9:4">അത് തിന്നുന്നവനെല്ലാം അശുദ്ധനായിത്തീരും;</para>
  <para style="q1" vid="HOS 9:4">അവരുടെ അപ്പം വിശപ്പടക്കുവാൻ മാത്രം അവർക്ക് ഉതകും;</para>
  <para style="q2" vid="HOS 9:4">അത് യഹോവയുടെ ആലയത്തിലേക്ക് കൊണ്ടുവരുകയില്ല.<verse eid="HOS 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 9:5" />സഭായോഗ ദിവസത്തിലും</para>
  <para style="q2" vid="HOS 9:5">യഹോവയുടെ ഉത്സവദിവസത്തിലും നിങ്ങൾ എന്ത് ചെയ്യും?<verse eid="HOS 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 9:6" />അവർ നാശത്തിൽനിന്ന് ഓടിപ്പോയാലും മിസ്രയീം അവരെ ഒരുമിച്ച് കൂട്ടും;</para>
  <para style="q2" vid="HOS 9:6">മോഫ് അവരെ അടക്കം ചെയ്യും;</para>
  <para style="q1" vid="HOS 9:6">വെള്ളികൊണ്ടുള്ള അവരുടെ മനോഹരവസ്തുക്കൾ മുൾച്ചെടികൾ കൈവശമാക്കും;</para>
  <para style="q2" vid="HOS 9:6">മുള്ളുകൾ അവരുടെ കൂടാരങ്ങളിൽ ഉണ്ടാകും.<verse eid="HOS 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 9:7" />ശിക്ഷയുടെ ദിനങ്ങൾ വന്നിരിക്കുന്നു;</para>
  <para style="q2" vid="HOS 9:7">പ്രതികാരദിവസം അടുത്തിരിക്കുന്നു;</para>
  <para style="q1" vid="HOS 9:7">നിന്‍റെ അകൃത്യബാഹുല്യവും വിദ്വേഷവും നിമിത്തം</para>
  <para style="q2" vid="HOS 9:7">പ്രവാചകൻ ഭോഷനും</para>
  <para style="q1" vid="HOS 9:7">ആത്മപൂർണ്ണൻ ഭ്രാന്തനും</para>
  <para style="q2" vid="HOS 9:7">എന്ന് യിസ്രായേൽ അറിയും.<verse eid="HOS 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 9:8" />എഫ്രയീം എന്‍റെ ദൈവത്തിന്‍റെ നേരെ പതിയിരിക്കുന്നു;</para>
  <para style="q2" vid="HOS 9:8">പ്രവാചകൻ തന്‍റെ എല്ലാ വഴികളിലും വേട്ടക്കാരന്‍റെ കെണിയും</para>
  <para style="q2" vid="HOS 9:8">ദൈവത്തിന്‍റെ ആലയത്തിൽ പകയും നേരിടും.<verse eid="HOS 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 9:9" />ഗിബെയയുടെ കാലത്ത് എന്നപോലെ അവർ വഷളത്വത്തിൽ മുഴുകിയിരിക്കുന്നു;</para>
  <para style="q2" vid="HOS 9:9">അവൻ അവരുടെ അകൃത്യം ഓർത്തു</para>
  <para style="q2" vid="HOS 9:9">അവരുടെ പാപത്തിന് ശിക്ഷ നൽകും.<verse eid="HOS 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 9:10" />മരുഭൂമിയിൽ മുന്തിരിപ്പഴംപോലെ</para>
  <para style="q2" vid="HOS 9:10">ഞാൻ യിസ്രായേലിനെ കണ്ടിരുന്നു;</para>
  <para style="q1" vid="HOS 9:10">അത്തിവൃക്ഷത്തിൽ ആദ്യം ഉണ്ടായ തലക്കനിപോലെ</para>
  <para style="q2" vid="HOS 9:10">ഞാൻ നിങ്ങളുടെ പിതാക്കന്മാരെ കണ്ടിരുന്നു;</para>
  <para style="q1" vid="HOS 9:10">ബാൽ-പെയോരിൽ എത്തിയപ്പോൾ</para>
  <para style="q2" vid="HOS 9:10">അവർ തങ്ങളെത്തന്നെ ലജ്ജയായതിന് ഏല്പിച്ചു;</para>
  <para style="q2" vid="HOS 9:10">അവരുടെ ഇഷ്ടദേവനെപ്പോലെ അവരും മ്ലേച്ഛതയുള്ളവരായി.<verse eid="HOS 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 9:11" />പ്രസവമോ ഗർഭമോ ഗർഭധാരണമോ ഒന്നും ഇല്ലാതെ</para>
  <para style="q2" vid="HOS 9:11">എഫ്രയീമിന്‍റെ മഹത്വം ഒരു പക്ഷിയെപ്പോലെ പറന്നുപോകും.<verse eid="HOS 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 9:12" />അവർ മക്കളെ വളർത്തിയാലും</para>
  <para style="q2" vid="HOS 9:12">ഞാൻ അവരെ ഒരുത്തനും ശേഷിക്കാതെ മക്കളില്ലാത്തവരാക്കും;</para>
  <para style="q1" vid="HOS 9:12">ഞാൻ അവരെ വിട്ടു മാറിപ്പോകുമ്പോൾ</para>
  <para style="q2" vid="HOS 9:12">അവർക്ക് അയ്യോ കഷ്ടം!<verse eid="HOS 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 9:13" />ഞാൻ എഫ്രയീമിനെ നോക്കുമ്പോൾ സോർവരെ അത് മനോഹരസ്ഥലത്തെ നടുതല പോലെ ഇരിക്കുന്നു;</para>
  <para style="q2" vid="HOS 9:13">എങ്കിലും എഫ്രയീം തന്‍റെ മക്കളെ ഘാതകന്‍റെ അടുക്കൽ പുറത്ത് കൊണ്ടുചെല്ലേണ്ടിവരും.<verse eid="HOS 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 9:14" />യഹോവേ, അവർക്ക് കൊടുക്കേണമേ;</para>
  <para style="q2" vid="HOS 9:14">നീ അവർക്ക് എന്തുകൊടുക്കും?</para>
  <para style="q1" vid="HOS 9:14">അലസിപ്പോകുന്ന ഗർഭവും</para>
  <para style="q2" vid="HOS 9:14">വരണ്ട സ്തനങ്ങളും അവർക്ക് കൊടുക്കേണമേ.<verse eid="HOS 9:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="HOS 9:15" />അവരുടെ ദുഷ്ടതയെല്ലാം ഗില്ഗാലിൽവച്ച് സംഭവിച്ചു;</para>
  <para style="q2" vid="HOS 9:15">അവിടെവച്ച് ഞാൻ അവരെ വെറുത്തു;</para>
  <para style="q1" vid="HOS 9:15">അവരുടെ പ്രവൃത്തികളുടെ ദുഷ്ടതനിമിത്തം</para>
  <para style="q2" vid="HOS 9:15">ഞാൻ ഇനി അവരെ സ്നേഹിക്കാതെ</para>
  <para style="q1" vid="HOS 9:15">എന്‍റെ ആലയത്തിൽനിന്ന് നീക്കിക്കളയും;</para>
  <para style="q2" vid="HOS 9:15">അവരുടെ സകലപ്രഭുക്കന്മാരും മത്സരികൾ ആകുന്നു.<verse eid="HOS 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 9:16" />എഫ്രയീമിന് പുഴുക്കുത്തു പിടിച്ചു;</para>
  <para style="q2" vid="HOS 9:16">അവരുടെ വേര് ഉണങ്ങിപ്പോയി;</para>
  <para style="q1" vid="HOS 9:16">അവർ ഫലം കായിക്കുകയില്ല;</para>
  <para style="q2" vid="HOS 9:16">അവർ പ്രസവിച്ചാലും ഞാൻ അവരുടെ ഇഷ്ടസന്തതികളെ കൊന്നുകളയും.<verse eid="HOS 9:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="HOS 9:17" />അവർ എന്‍റെ ദൈവത്തെ അനുസരിക്കായ്കകൊണ്ട്</para>
  <para style="q2" vid="HOS 9:17">യഹോവ അവരെ തള്ളിക്കളയും;</para>
  <para style="q2" vid="HOS 9:17">അവർ ജനതയുടെ ഇടയിൽ ഉഴന്നു നടക്കേണ്ടിവരും.<verse eid="HOS 9:17" /></para>
  <chapter eid="HOS 9" />
  <chapter number="10" style="c" sid="HOS 10" />
  <para style="s">യിസ്രായേലിനെതിരായ യഹോവയുടെ ന്യായവിധി</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 10:1" />യിസ്രായേൽ പടർന്നിരിക്കുന്ന ഒരു മുന്തിരിവള്ളി ആകുന്നു;</para>
  <para style="q2" vid="HOS 10:1">അവൻ ഫലം കായിക്കുന്നു;</para>
  <para style="q1" vid="HOS 10:1">തന്‍റെ ഫലം വർദ്ധിച്ചപ്പോൾ</para>
  <para style="q2" vid="HOS 10:1">അവൻ ബലിപീഠങ്ങളും വർദ്ധിപ്പിച്ചു;</para>
  <para style="q1" vid="HOS 10:1">തന്‍റെ ദേശത്തിന് സമൃദ്ധി ഉണ്ടായപ്പോൾ</para>
  <para style="q2" vid="HOS 10:1">അവൻ ഭംഗിയുള്ള വിഗ്രഹസ്തംഭങ്ങളും ഉണ്ടാക്കി.<verse eid="HOS 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 10:2" />അവരുടെ ഹൃദയം ഭിന്നിച്ചിരിക്കുന്നു;</para>
  <para style="q2" vid="HOS 10:2">ഇപ്പോൾ അവർ കുറ്റക്കാരായിത്തീരും;</para>
  <para style="q1" vid="HOS 10:2">അവൻ അവരുടെ ബലിപീഠങ്ങൾ ഇടിച്ചുകളയുകയും</para>
  <para style="q2" vid="HOS 10:2">അവരുടെ വിഗ്രഹസ്തംഭങ്ങൾ നശിപ്പിക്കുകയും ചെയ്യും.<verse eid="HOS 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 10:3" />ഇപ്പോൾ അവർ: “നമുക്ക് രാജാവില്ല; നാം യഹോവയെ ഭയപ്പെടുന്നില്ലല്ലോ;</para>
  <para style="q2" vid="HOS 10:3">രാജാവ് നമുക്കുവേണ്ടി എന്ത് ചെയ്യും?” എന്ന് പറയും.<verse eid="HOS 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 10:4" />അവർ വ്യർത്ഥവാക്കുകൾ സംസാരിച്ച്,</para>
  <para style="q2" vid="HOS 10:4">ഉടമ്പടി ചെയ്യുമ്പോൾ കള്ളസ്സത്യം ചെയ്യുന്നു;</para>
  <para style="q1" vid="HOS 10:4">അതുകൊണ്ട് ദൈവത്തിന്‍റെ ന്യായവിധി</para>
  <para style="q2" vid="HOS 10:4">വയലിലെ ഉഴവുചാലുകളിൽ നഞ്ചുചെടിപോലെ മുളച്ചുവരുന്നു.<verse eid="HOS 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 10:5" />ശമര്യാ നിവാസികൾ ബേത്ത്-ആവെനിലെ കാളക്കുട്ടി നിമിത്തം ഭയപ്പെടുന്നു;</para>
  <para style="q2" vid="HOS 10:5">അവിടുത്തെ ജനം അതിനെക്കുറിച്ച് ദുഃഖിക്കുന്നു;</para>
  <para style="q1" vid="HOS 10:5">അവരുടെ പൂജാരികൾ മഹത്വം അതിനെ വിട്ടുപോയതുകൊണ്ട്</para>
  <para style="q2" vid="HOS 10:5">അതിനെക്കുറിച്ച് ഭയപ്പെട്ട് വിറയ്ക്കുന്നു.<verse eid="HOS 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 10:6" />ആ വിഗ്രഹത്തെയും യുദ്ധതല്പരനായ രാജാവിന് സമ്മാനമായി അശ്ശൂരിലേക്ക് കൊണ്ടുപോകും;</para>
  <para style="q2" vid="HOS 10:6">എഫ്രയീം ലജ്ജിക്കും;</para>
  <para style="q2" vid="HOS 10:6">യിസ്രായേൽ സ്വന്തം തടി വിഗ്രഹങ്ങളെ കുറിച്ച്<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="fq" closed="false">സ്വന്തം തടി വിഗ്രഹങ്ങളെ കുറിച്ച് </char><char style="ft" closed="false">ആലോചനയെക്കുറിച്ച്</char></note> ലജ്ജിക്കും.<verse eid="HOS 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 10:7" />ശമര്യയുടെ കാര്യമോ, അതിന്‍റെ രാജാവ്</para>
  <para style="q2" vid="HOS 10:7">വെള്ളത്തിലെ ചുള്ളിക്കമ്പ് പോലെ നശിച്ചുപോകും.<verse eid="HOS 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 10:8" />യിസ്രായേലിന്‍റെ പാപമായിരിക്കുന്ന ആവെനിലെ പൂജാഗിരികൾ നശിച്ചുപോകും;</para>
  <para style="q2" vid="HOS 10:8">മുള്ളും പറക്കാരയും അവരുടെ ബലിപീഠങ്ങളിന്മേൽ മുളയ്ക്കും;</para>
  <para style="q2" vid="HOS 10:8">അവർ മലകളോട്: “ഞങ്ങളുടെമേൽ വീഴുവിൻ” എന്ന് പറയും.<verse eid="HOS 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 10:9" />യിസ്രായേലേ, ഗിബെയയുടെ കാലം മുതൽ നീ പാപം ചെയ്തിരിക്കുന്നു;</para>
  <para style="q2" vid="HOS 10:9">അവർ ഇന്നും അതേ അവസ്ഥയിൽ തുടരുന്നു;</para>
  <para style="q2" vid="HOS 10:9">ഗിബെയയിൽ നീതികെട്ടവരോടുള്ള പോരാട്ടം അവരെ കീഴടക്കിയില്ല;<verse eid="HOS 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 10:10" />ഞാൻ ഇച്ഛിക്കുമ്പോൾ അവരെ ശിക്ഷിക്കും;</para>
  <para style="q2" vid="HOS 10:10">അവരുടെ രണ്ടു അകൃത്യങ്ങൾ നിമിത്തം</para>
  <para style="q1" vid="HOS 10:10">ഞാൻ അവരെ ശിക്ഷിക്കുമ്പോൾ</para>
  <para style="q2" vid="HOS 10:10">ജനതകള്‍ അവർക്കെതിരെ കൂടിവരും.<verse eid="HOS 10:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 10:11" />എഫ്രയീം മെരുക്കമുള്ളതും ധാന്യം മെതിക്കുവാൻ ഇഷ്ടപ്പെടുന്നതുമായ പശുക്കിടാവ് ആകുന്നു;</para>
  <para style="q2" vid="HOS 10:11">ഞാൻ അതിന്‍റെ ഭംഗിയുള്ള കഴുത്തിൽ നുകം വയ്ക്കും;</para>
  <para style="q1" vid="HOS 10:11">ഞാൻ എഫ്രയീമിനെ നുകത്തിൽ കെട്ടും;</para>
  <para style="q2" vid="HOS 10:11">യെഹൂദാ ഉഴുകയും യാക്കോബ് കട്ട ഉടയ്ക്കുകയും ചെയ്യേണ്ടിവരും.<verse eid="HOS 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 10:12" />നീതിയിൽ വിതയ്ക്കുവിൻ;</para>
  <para style="q2" vid="HOS 10:12">ദയക്കൊത്തവണ്ണം കൊയ്യുവിൻ;</para>
  <para style="q1" vid="HOS 10:12">നിങ്ങളുടെ തരിശുനിലം ഉഴുവിൻ;</para>
  <para style="q2" vid="HOS 10:12">യഹോവ വന്ന് നിങ്ങളുടെമേൽ</para>
  <para style="q1" vid="HOS 10:12">നീതി വർഷിപ്പിക്കേണ്ടതിന്</para>
  <para style="q2" vid="HOS 10:12">അവനെ അന്വേഷിക്കുവാനുള്ള കാലം ഇതാകുന്നു.<verse eid="HOS 10:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="HOS 10:13" />നിങ്ങൾ ദുഷ്ടത ഉഴുത്,</para>
  <para style="q2" vid="HOS 10:13">നീതികേട് കൊയ്ത്,</para>
  <para style="q2" vid="HOS 10:13">ഭോഷ്കിന്‍റെ ഫലം തിന്നിരിക്കുന്നു;</para>
  <para style="q1" vid="HOS 10:13">നിങ്ങൾ സ്വന്ത വഴിയിലും</para>
  <para style="q2" vid="HOS 10:13">നിങ്ങളുടെ വീരന്മാരുടെ സംഖ്യാബലത്തിലും ആശ്രയിച്ചിരിക്കുന്നു.<verse eid="HOS 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 10:14" />അതുകൊണ്ട് നിന്‍റെ ജനത്തിന്‍റെ ഇടയിൽ ഒരു കലഹം ഉണ്ടാകും;</para>
  <para style="q2" vid="HOS 10:14">യുദ്ധദിവസത്തിൽ ശൽമാൻ ബേത്ത്-അർബ്ബേലിനെ നശിപ്പിച്ചതുപോലെ</para>
  <para style="q1" vid="HOS 10:14">നിങ്ങളുടെ എല്ലാ കോട്ടകൾക്കും നാശം വരും;</para>
  <para style="q2" vid="HOS 10:14">അവർ അമ്മയെ മക്കളോടുകൂടി തകർത്തുകളഞ്ഞുവല്ലോ.<verse eid="HOS 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 10:15" />അങ്ങനെ തന്നെ ബേഥേലേ!</para>
  <para style="q2" vid="HOS 10:15">നിങ്ങളുടെ മഹാദുഷ്ടതനിമിത്തം നിങ്ങൾക്ക് ഇത് സംഭവിക്കും;</para>
  <para style="q2" vid="HOS 10:15">പുലർച്ചയ്ക്ക് യിസ്രായേൽ രാജാവ് അശേഷം നശിച്ചുപോകും.<verse eid="HOS 10:15" /></para>
  <chapter eid="HOS 10" />
  <chapter number="11" style="c" sid="HOS 11" />
  <para style="s">യിസ്രായേലിനോടുള്ള ദൈവത്തിന്‍റെ സ്നേഹം</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 11:1" />“യിസ്രായേൽ ബാലനായിരുന്നപ്പോൾ ഞാൻ അവനെ സ്നേഹിച്ചു;</para>
  <para style="q2" vid="HOS 11:1">മിസ്രയീമിൽ നിന്ന് ഞാൻ എന്‍റെ മകനെ വിളിച്ചു.<verse eid="HOS 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 11:2" />എന്നാൽ, ഞാൻ അവരെ വിളിക്കുന്തോറും</para>
  <para style="q2" vid="HOS 11:2">അവർ എന്നെ വിട്ടകന്നുപോയി;</para>
  <para style="q1" vid="HOS 11:2">ബാല്‍ ബിംബങ്ങൾക്ക് അവർ ബലികഴിച്ചു,</para>
  <para style="q2" vid="HOS 11:2">വിഗ്രഹങ്ങൾക്ക് ധൂപം കാട്ടി.<verse eid="HOS 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 11:3" />ഞാൻ എഫ്രയീമിനെ നടക്കുവാൻ പരിശീലിപ്പിച്ചു;</para>
  <para style="q2" vid="HOS 11:3">ഞാൻ അവരെ എന്‍റെ ഭുജങ്ങളിൽ എടുത്തു;</para>
  <para style="q1" vid="HOS 11:3">എങ്കിലും ഞാൻ അവരെ സൗഖ്യമാക്കി</para>
  <para style="q2" vid="HOS 11:3">എന്ന് അവർ അറിഞ്ഞില്ല.<verse eid="HOS 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 11:4" />ഞാൻ മനുഷ്യകരുണയുടെ ചരടുകൾകൊണ്ട്, സ്നേഹബന്ധനങ്ങൾ കൊണ്ട് തന്നെ,</para>
  <para style="q2" vid="HOS 11:4">ഞാൻ അവരെ നയിച്ചു;</para>
  <para style="q1" vid="HOS 11:4">അവരുടെ കഴുത്തിൽനിന്ന് നുകം നീക്കിക്കളയുന്നവനെപ്പോലെ അവർക്ക് ഞാൻ ആയിരുന്നു;</para>
  <para style="q2" vid="HOS 11:4">ഞാൻ കുനിഞ്ഞ് അവർക്ക് ഭക്ഷണം ഇട്ടുകൊടുത്തു.<verse eid="HOS 11:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="HOS 11:5" />“അവർ മിസ്രയീം ദേശത്തേക്ക് മടങ്ങിപ്പോകുകയില്ല;</para>
  <para style="q2" vid="HOS 11:5">എന്നാൽ എങ്കലേക്ക് മടങ്ങിവരുവാൻ അവർക്ക് മനസ്സില്ലായ്കകൊണ്ട്</para>
  <para style="q2" vid="HOS 11:5">അശ്ശൂര്യൻ അവരുടെ രാജാവാകും.<verse eid="HOS 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 11:6" />അവരുടെ നഗരങ്ങൾക്കു നേരെ വാൾ ആഞ്ഞുവീശും.</para>
  <para style="q2" vid="HOS 11:6">നഗരകവാടങ്ങളുടെ ഓടാമ്പലുകൾ തകർക്കും.</para>
  <para style="q2" vid="HOS 11:6">അവരുടെ ആലോചനയാൽ തന്നെ അവർ നശിക്കും.<verse eid="HOS 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 11:7" />എന്‍റെ ജനം എന്നെ വിട്ട് പിന്തിരിയുവാൻ ഒരുങ്ങിയിരിക്കുന്നു;</para>
  <para style="q2" vid="HOS 11:7">അവർ അത്യുന്നതനോട് നിലവിളിച്ചാലും</para>
  <para style="q2" vid="HOS 11:7">അവൻ അവരെ ഉയർത്തുകയില്ല.<verse eid="HOS 11:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 11:8" />എഫ്രയീമേ, ഞാൻ നിന്നെ എങ്ങനെ വിട്ടുകൊടുക്കും?</para>
  <para style="q2" vid="HOS 11:8">യിസ്രായേലേ, ഞാൻ നിന്നെ എങ്ങനെ ഏല്പിച്ചുകൊടുക്കും?</para>
  <para style="q1" vid="HOS 11:8">ഞാൻ നിന്നെ എങ്ങനെ ആദ്മയെപ്പോലെ ആക്കും?</para>
  <para style="q2" vid="HOS 11:8">ഞാൻ നിന്നെ എങ്ങനെ സെബോയിമിനെപ്പോലെ ആക്കിത്തീർക്കും?</para>
  <para style="q1" vid="HOS 11:8">എന്‍റെ ഹൃദയം എന്നെ അതിന് അനുവദിക്കുന്നില്ല;</para>
  <para style="q2" vid="HOS 11:8">എനിക്ക് നിങ്ങളോട് അയ്യോഭാവം തോന്നുന്നു.<verse eid="HOS 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 11:9" />എന്‍റെ ഉഗ്രകോപം ഞാൻ ചൊരിയുകയില്ല;</para>
  <para style="q2" vid="HOS 11:9">ഞാൻ എഫ്രയീമിനെ വീണ്ടും നശിപ്പിക്കുകയുമില്ല;</para>
  <para style="q1" vid="HOS 11:9">ഞാൻ മനുഷ്യനല്ല ദൈവം അത്രേ.</para>
  <para style="q2" vid="HOS 11:9">നിങ്ങളുടെ നടുവിൽ പരിശുദ്ധൻ തന്നെ;</para>
  <para style="q2" vid="HOS 11:9">ഞാൻ ക്രോധത്തോടെ വരുകയുമില്ല<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="fq" closed="false">ഞാൻ ക്രോധത്തോടെ വരുകയുമില്ല </char><char style="ft" closed="false">ഞാൻ എന്‍റെ കോപത്തില്‍ പട്ടണത്തിനെതിരെ വരികയില്ല</char></note>.<verse eid="HOS 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 11:10" />അവർ യഹോവയെ അനുഗമിക്കും.</para>
  <para style="q2" vid="HOS 11:10">അവിടുന്ന് സിംഹംപോലെ ഗർജിക്കും;</para>
  <para style="q1" vid="HOS 11:10">യഹോവ ഗർജിക്കുമ്പോൾ പടിഞ്ഞാറുനിന്ന് അവിടുത്തെ മക്കൾ വിറച്ചുകൊണ്ട് വരും.<verse eid="HOS 11:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 11:11" />അവർ പക്ഷികളെപ്പോലെ മിസ്രയീമിൽനിന്നും</para>
  <para style="q2" vid="HOS 11:11">പ്രാവുകളെപ്പോലെ അശ്ശൂരിൽനിന്നും വിറച്ചുകൊണ്ട് വരും;</para>
  <para style="q1" vid="HOS 11:11">ഞാൻ അവരെ അവരുടെ വീടുകളിൽ പാർപ്പിക്കും”</para>
  <para style="q2" vid="HOS 11:11">എന്ന് യഹോവയുടെ അരുളപ്പാട്.<verse eid="HOS 11:11" /></para>
  <para style="b" />
  <para style="s">യിസ്രായേലിന്‍റെ പാപം</para>
  <para style="q2">
    <verse number="12" style="v" sid="HOS 11:12" />എഫ്രയീം കാപട്യം കൊണ്ടും</para>
  <para style="q2" vid="HOS 11:12">യിസ്രായേൽഗൃഹം വഞ്ചനകൊണ്ടും എന്നെ ചുറ്റിയിരിക്കുന്നു;</para>
  <para style="q1" vid="HOS 11:12">എന്നാൽ യെഹൂദായെ ദൈവം ഇന്നും അറിയുന്നു.</para>
  <para style="q2" vid="HOS 11:12">അവൻ പരിശുദ്ധനായവനോടു വിശ്വസ്തത പുലർത്തുന്നു.<verse eid="HOS 11:12" /></para>
  <chapter eid="HOS 11" />
  <chapter number="12" style="c" sid="HOS 12" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 12:1" />എഫ്രയീം കാറ്റിനെ സ്നേഹിച്ച്,</para>
  <para style="q2" vid="HOS 12:1">കിഴക്കൻ കാറ്റിനെ പിന്തുടരുന്നു;</para>
  <para style="q2" vid="HOS 12:1">അവൻ ഇടവിടാതെ ഭോഷ്കും ശൂന്യതയും വർദ്ധിപ്പിക്കുന്നു;</para>
  <para style="q2" vid="HOS 12:1">അവർ അശ്ശൂര്യരോട് ഉടമ്പടി ചെയ്യുന്നു;</para>
  <para style="q2" vid="HOS 12:1">മിസ്രയീമിലേക്ക് എണ്ണ കൊടുത്തയയ്ക്കുന്നു.<verse eid="HOS 12:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="HOS 12:2" />യഹോവയ്ക്ക് യെഹൂദയോടും ഒരു വ്യവഹാരം ഉണ്ട്;</para>
  <para style="q2" vid="HOS 12:2">യഹോവ യാക്കോബിനെ അവന്‍റെ നടപ്പിന് തക്കവണ്ണം സന്ദർശിക്കും;</para>
  <para style="q1" vid="HOS 12:2">അവന്‍റെ പ്രവൃത്തികൾക്കു തക്കവണ്ണം</para>
  <para style="q2" vid="HOS 12:2">അവന് പകരം കൊടുക്കും.<verse eid="HOS 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 12:3" />അവൻ ഗർഭത്തിൽവച്ച് തന്‍റെ സഹോദരന്‍റെ കുതികാൽ പിടിച്ചു;</para>
  <para style="q2" vid="HOS 12:3">തന്‍റെ പുരുഷപ്രായത്തിൽ ദൈവത്തോടു പൊരുതി. <note caller="+" style="f"><char style="fr" closed="false">12:3 </char><char style="fq" closed="false">അവൻ ഗർഭത്തിൽവച്ച് തന്‍റെ സഹോദരന്‍റെ കുതികാൽ പിടിച്ചു; തന്‍റെ പുരുഷപ്രായത്തിൽ ദൈവത്തോടു പൊരുതി. </char><char style="ft" closed="false">ഉല്പത്തി 25:26-32:24-26 വരെ നോക്കുക</char></note><verse eid="HOS 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 12:4" />അവൻ ദൂതനോട് പൊരുതി ജയിച്ചു;</para>
  <para style="q2" vid="HOS 12:4">അവൻ യഹോവയോട് കരഞ്ഞപേക്ഷിച്ചു;</para>
  <para style="q1" vid="HOS 12:4">അവൻ ബേഥേലിൽവച്ച് ദൈവത്തെ കണ്ടെത്തി,</para>
  <para style="q2" vid="HOS 12:4">അവിടെവച്ച് യഹോവ അവനോട്<note caller="+" style="f"><char style="fr" closed="false">12:4 </char><char style="fq" closed="false">അവനോട് </char><char style="ft" closed="false">നമ്മോടു </char></note> സംസാരിച്ചു.<verse eid="HOS 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 12:5" />യഹോവ സൈന്യങ്ങളുടെ ദൈവമാകുന്നു;</para>
  <para style="q2" vid="HOS 12:5">‘യഹോവ’ എന്നാകുന്നു അവിടുത്തെ നാമം.<verse eid="HOS 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 12:6" />അതുകൊണ്ട് നീ നിന്‍റെ ദൈവത്തിന്‍റെ സഹായത്താൽ യഹോവയുടെ അടുക്കലേക്ക് മടങ്ങിവരുക;</para>
  <para style="q2" vid="HOS 12:6">ദയയും ന്യായവും പ്രമാണിച്ച്, ഇടവിടാതെ ദൈവത്തിനായി കാത്തിരിക്കുക.<verse eid="HOS 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="HOS 12:7" />യിസ്രായേൽ ഒരു കനാന്യനാകുന്നു;</para>
  <para style="q2" vid="HOS 12:7">കള്ളത്തുലാസ് അവന്‍റെ കയ്യിൽ ഉണ്ട്;</para>
  <para style="q2" vid="HOS 12:7">പീഡിപ്പിക്കുവാൻ അവൻ ആഗ്രഹിക്കുന്നു.<verse eid="HOS 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 12:8" />എന്നാൽ എഫ്രയീം: “ഞാൻ സമ്പന്നനായിരിക്കുന്നു,</para>
  <para style="q2" vid="HOS 12:8">എനിക്ക് ധനം കിട്ടിയിരിക്കുന്നു;</para>
  <para style="q1" vid="HOS 12:8">എന്‍റെ സകല പ്രയത്നങ്ങളിലും</para>
  <para style="q2" vid="HOS 12:8">പാപകരമായ യാതൊരു അകൃത്യവും എന്നിൽ കണ്ടെത്തുകയില്ല” എന്നിങ്ങനെ പറയുന്നു.<verse eid="HOS 12:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HOS 12:9" />ഞാനോ മിസ്രയീം ദേശം മുതൽ</para>
  <para style="q2" vid="HOS 12:9">നിന്‍റെ ദൈവമായ യഹോവയാകുന്നു;</para>
  <para style="q1" vid="HOS 12:9">ഞാൻ നിന്നെ ഉത്സവദിവസങ്ങളിലെന്നപോലെ</para>
  <para style="q2" vid="HOS 12:9">ഇനിയും കൂടാരങ്ങളിൽ വസിക്കുമാറാക്കും.<verse eid="HOS 12:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 12:10" />ഞാൻ പ്രവാചകന്മാരോട് സംസാരിച്ച് ദർശനങ്ങൾ വർദ്ധിപ്പിച്ചു;</para>
  <para style="q2" vid="HOS 12:10">പ്രവാചകന്മാർ മുഖാന്തരം സദൃശവാക്യങ്ങളും നൽകിയിരിക്കുന്നു.<verse eid="HOS 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 12:11" />ഗിലെയാദ്യർ നീതികെട്ടവർ എങ്കിൽ അവർ വ്യർത്ഥരായിത്തീരും;</para>
  <para style="q2" vid="HOS 12:11">അവർ ഗില്ഗാലിൽ കാളകളെ ബലികഴിക്കുന്നു എങ്കിൽ,</para>
  <para style="q1" vid="HOS 12:11">അവരുടെ ബലിപീഠങ്ങൾ</para>
  <para style="q2" vid="HOS 12:11">വയലിലെ ഉഴവുചാലുകളിൽ ഉള്ള കൽകൂമ്പാരങ്ങൾപോലെ ആകും.<verse eid="HOS 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 12:12" />യാക്കോബ് അരാം ദേശത്തേക്ക് ഓടിപ്പോയി;</para>
  <para style="q2" vid="HOS 12:12">യിസ്രായേൽ ഒരു ഭാര്യയ്ക്കുവേണ്ടി സേവ ചെയ്തു,</para>
  <para style="q2" vid="HOS 12:12">ഒരു ഭാര്യയ്ക്കുവേണ്ടി ആടുകളെ പാലിച്ചു.<verse eid="HOS 12:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 12:13" />യഹോവ ഒരു പ്രവാചകൻമുഖാന്തരം യിസ്രായേലിനെ മിസ്രയീമിൽനിന്നു കൊണ്ടുവന്നു,</para>
  <para style="q2" vid="HOS 12:13">ഒരു പ്രവാചകനാൽ അവൻ സംരക്ഷിക്കപ്പെട്ടു.<verse eid="HOS 12:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 12:14" />എഫ്രയീം അവനെ ഏറ്റവും കൈപ്പോടുകൂടി പ്രകോപിപ്പിച്ചു;</para>
  <para style="q2" vid="HOS 12:14">ആകയാൽ അവന്‍റെ കർത്താവ് അവന്‍റെ രക്തപാതകം അവന്‍റെമേൽ ചുമത്തുകയും</para>
  <para style="q2" vid="HOS 12:14">അവൻ നിന്ദിച്ചതിന് തക്കവണ്ണം അവന് പകരം കൊടുക്കുകയും ചെയ്യും.<verse eid="HOS 12:14" /></para>
  <chapter eid="HOS 12" />
  <chapter number="13" style="c" sid="HOS 13" />
  <para style="s">യിസ്രായേലിനെതിരെ യഹോവയുടെ കോപം</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 13:1" />എഫ്രയീം സംസാരിച്ചപ്പോൾ വിറയൽ ഉണ്ടായി;</para>
  <para style="q2" vid="HOS 13:1">അവൻ യിസ്രായേലിൽ ഉന്നതനായിരുന്നു;</para>
  <para style="q2" vid="HOS 13:1">എന്നാൽ ബാല്‍ മുഖാന്തരം കുറ്റം ചെയ്തപ്പോൾ അവൻ മരിച്ചുപോയി.<verse eid="HOS 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 13:2" />ഇപ്പോഴോ, അവർ അധികമധികം പാപം ചെയ്യുന്നു;</para>
  <para style="q2" vid="HOS 13:2">അവർ വെള്ളികൊണ്ട് ബിംബങ്ങളും ബോധിച്ചതുപോലെ വിഗ്രഹങ്ങളും ഉണ്ടാക്കി;</para>
  <para style="q1" vid="HOS 13:2">ഇവയെല്ലാം കൗശലപ്പണിക്കാരുടെ പണിയാകുന്നു;</para>
  <para style="q2" vid="HOS 13:2">അവയോട് അവർ സംസാരിക്കുന്നു;</para>
  <para style="q2" vid="HOS 13:2">ബലികഴിക്കുന്ന മനുഷ്യർ കാളക്കിടാക്കളെ ചുംബിക്കുന്നു.<verse eid="HOS 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 13:3" />അതുകൊണ്ട് അവർ പ്രഭാതമേഘംപോലെയും</para>
  <para style="q2" vid="HOS 13:3">പുലർച്ചയിൽ നീങ്ങിപ്പോകുന്ന മഞ്ഞുപോലെയും</para>
  <para style="q1" vid="HOS 13:3">ധാന്യക്കളത്തിൽ നിന്ന് കാറ്റ് പറപ്പിക്കുന്ന പതിർപോലെയും</para>
  <para style="q2" vid="HOS 13:3">പുകക്കുഴലിൽനിന്നു പൊങ്ങുന്ന പുകപോലെയും ആയിരിക്കും.<verse eid="HOS 13:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HOS 13:4" />“എന്നാൽ മിസ്രയീം ദേശം മുതൽ</para>
  <para style="q2" vid="HOS 13:4">നിന്‍റെ ദൈവമായ യഹോവ ഞാൻ ആകുന്നു;</para>
  <para style="q1" vid="HOS 13:4">എന്നെയല്ലാതെ വേറൊരു ദൈവത്തെ നീ അറിയുന്നില്ല;</para>
  <para style="q2" vid="HOS 13:4">ഞാനല്ലാതെ ഒരു രക്ഷിതാവ് ഇല്ലല്ലോ.<verse eid="HOS 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 13:5" />ഞാൻ മരുഭൂമിയിൽ</para>
  <para style="q2" vid="HOS 13:5">ഏറ്റവും വരണ്ട ദേശത്ത് നിന്നെ മേയിച്ചു.<verse eid="HOS 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 13:6" />അവർക്ക് സമൃദ്ധിയായി മേച്ചൽ ലഭിച്ചു<note caller="+" style="f"><char style="fr" closed="false">13:6 </char><char style="fq" closed="false">അവർക്ക് സമൃദ്ധിയായി മേച്ചൽ ലഭിച്ചു </char><char style="ft" closed="false">അളവിന് അനുസരിച്ച് ഞാന്‍ അവരെ പോഷിപ്പിച്ചു </char></note>.</para>
  <para style="q2" vid="HOS 13:6">അവർ തൃപ്തരായപ്പോൾ അവരുടെ ഹൃദയം നിഗളിച്ചു;</para>
  <para style="q2" vid="HOS 13:6">അതുകൊണ്ട് അവർ എന്നെ മറന്നുകളഞ്ഞു.<verse eid="HOS 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 13:7" />ആകയാൽ ഞാൻ അവർക്ക് ഒരു സിംഹത്തെപ്പോലെ ഇരിക്കും;</para>
  <para style="q2" vid="HOS 13:7">വഴിയരികെ ഒരു പുള്ളിപ്പുലിയെപ്പോലെ ഞാൻ അവർക്കായി പതിയിരിക്കും;<verse eid="HOS 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 13:8" />കുട്ടികൾ നഷ്ടപ്പെട്ട കരടിയെപ്പോലെ</para>
  <para style="q2" vid="HOS 13:8">ഞാൻ അവരെ എതിരിട്ട് അവരുടെ മാറിടം കീറിക്കളയും;</para>
  <para style="q1" vid="HOS 13:8">അവിടെവച്ച് ഞാൻ അവരെ ഒരു സിംഹത്തെപ്പോലെ തിന്നുകളയും;</para>
  <para style="q2" vid="HOS 13:8">കാട്ടുമൃഗം അവരെ കടിച്ചുകീറും.<verse eid="HOS 13:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HOS 13:9" />“യിസ്രായേലേ, ഞാൻ നിന്നെ നശിപ്പിക്കും;</para>
  <para style="q2" vid="HOS 13:9">ആർക്കു നിന്നെ സഹായിക്കാൻ കഴിയും?<verse eid="HOS 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 13:10" />നിന്‍റെ എല്ലാ പട്ടണങ്ങളിലും നിന്നെ രക്ഷിക്കുവാൻ നിന്‍റെ രാജാവ് ഇപ്പോൾ എവിടെ?</para>
  <para style="q2" vid="HOS 13:10">‘ഞങ്ങൾക്ക് ഒരു രാജാവിനെയും പ്രഭുക്കന്മാരെയും തരേണം’ എന്ന് അപേക്ഷിച്ച നിന്‍റെ ന്യായാധിപന്മാർ എവിടെ?<verse eid="HOS 13:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 13:11" />എന്‍റെ കോപത്തിൽ ഞാൻ നിനക്ക് ഒരു രാജാവിനെ തന്നു,</para>
  <para style="q2" vid="HOS 13:11">എന്‍റെ ക്രോധത്തിൽ ഞാൻ അവനെ നീക്കിക്കളഞ്ഞു.<verse eid="HOS 13:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="HOS 13:12" />“എഫ്രയീമിന്‍റെ അകൃത്യം സംഗ്രഹിച്ചും</para>
  <para style="q2" vid="HOS 13:12">അവന്‍റെ പാപം സൂക്ഷിച്ചും വച്ചിരിക്കുന്നു.<verse eid="HOS 13:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 13:13" />നോവുകിട്ടിയ സ്ത്രീയുടെ വേദന അവന് ഉണ്ടാകും;</para>
  <para style="q2" vid="HOS 13:13">എന്നാൽ അവൻ ബുദ്ധിയില്ലാത്ത മകൻ;</para>
  <para style="q1" vid="HOS 13:13">സമയമാകുമ്പോൾ</para>
  <para style="q2" vid="HOS 13:13">അവൻ ഗർഭദ്വാരത്തിൽ എത്തുന്നില്ല.<verse eid="HOS 13:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="HOS 13:14" />“ഞാൻ അവരെ പാതാളത്തിന്‍റെ അധികാരത്തിൽനിന്ന് വീണ്ടെടുക്കും;</para>
  <para style="q2" vid="HOS 13:14">മരണത്തിൽനിന്നു ഞാൻ അവരെ വിടുവിക്കും;</para>
  <para style="q1" vid="HOS 13:14">മരണമേ, നിന്‍റെ വിഷമുള്ള് എവിടെ?</para>
  <para style="q2" vid="HOS 13:14">പാതാളമേ, നിന്‍റെ സംഹാരം എവിടെ?</para>
  <para style="b" vid="HOS 13:14" />
  <para style="q1" vid="HOS 13:14">“എനിക്ക് സഹതാപം തോന്നുകയില്ല.<verse eid="HOS 13:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="HOS 13:15" />അവൻ തന്‍റെ സഹോദരന്മാരുടെ ഇടയിൽ ഫലപുഷ്ടിയുള്ളവനായിരുന്നാലും</para>
  <para style="q2" vid="HOS 13:15">യഹോവയുടെ അടുക്കൽനിന്ന് ഒരു കിഴക്കൻകാറ്റു വരും;</para>
  <para style="q1" vid="HOS 13:15">മരുഭൂമിയിൽനിന്നു അതു വരും;</para>
  <para style="q2" vid="HOS 13:15">അവന്‍റെ നീരുറവ വറ്റിപ്പോകും;</para>
  <para style="q1" vid="HOS 13:15">അവന്‍റെ കിണർ വരണ്ടുപോകും.</para>
  <para style="q1" vid="HOS 13:15">അവൻ സകലമനോഹരവസ്തുക്കളുടെയും നിക്ഷേപം</para>
  <para style="q2" vid="HOS 13:15">കവർന്നുകൊണ്ടുപോകും.<verse eid="HOS 13:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 13:16" />ശമര്യ തന്‍റെ ദൈവത്തോട് മത്സരിച്ചതുകൊണ്ട്</para>
  <para style="q2" vid="HOS 13:16">അവൾ തന്‍റെ അകൃത്യം വഹിക്കേണ്ടിവരും;</para>
  <para style="q1" vid="HOS 13:16">അവർ വാൾകൊണ്ടു വീഴും;</para>
  <para style="q1" vid="HOS 13:16">അവരുടെ ശിശുക്കളെ അവർ തകർത്തുകളയും;</para>
  <para style="q2" vid="HOS 13:16">അവരുടെ ഗർഭിണികളുടെ ഉദരം പിളർന്നുകളയും.”<verse eid="HOS 13:16" /></para>
  <chapter eid="HOS 13" />
  <chapter number="14" style="c" sid="HOS 14" />
  <para style="s">യഹോവയിങ്കലേക്കു മടങ്ങുക</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 14:1" />യിസ്രായേലേ, നിന്‍റെ ദൈവമായ യഹോവയുടെ അടുക്കലേക്ക് മടങ്ങിച്ചെല്ലുക;</para>
  <para style="q2" vid="HOS 14:1">നിന്‍റെ അകൃത്യം നിമിത്തം അല്ലയോ നീ വീണിരിക്കുന്നത്.<verse eid="HOS 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 14:2" />നിങ്ങൾ അനുതാപവാക്യങ്ങളോടുകൂടി</para>
  <para style="q2" vid="HOS 14:2">യഹോവയുടെ അടുക്കൽ മടങ്ങിച്ചെന്ന്</para>
  <para style="q1" vid="HOS 14:2">യഹോവയോട്: “സകല അകൃത്യവും ക്ഷമിച്ച്,</para>
  <para style="q2" vid="HOS 14:2">ഞങ്ങളെ കൃപയോടെ കൈക്കൊള്ളണമേ;</para>
  <para style="q2" vid="HOS 14:2">എന്നാൽ ഞങ്ങൾ ഞങ്ങളുടെ അധരഫലങ്ങളെ അർപ്പിക്കും.<note caller="+" style="f"><char style="fr" closed="false">14:2 </char><char style="fq" closed="false">ഞങ്ങളുടെ അധരഫലങ്ങളെ അർപ്പിക്കും </char><char style="ft" closed="false">ഞങ്ങളുടെ അധരാർപ്പണമായ കാളകളെ അർപ്പിക്കും</char></note><verse eid="HOS 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 14:3" />അശ്ശൂർ ഞങ്ങളെ രക്ഷിക്കുകയില്ല;</para>
  <para style="q2" vid="HOS 14:3">ഞങ്ങൾ കുതിരപ്പുറത്തു കയറി ഓടുകയോ</para>
  <para style="q1" vid="HOS 14:3">ഇനി ഞങ്ങളുടെ കൈവേലയോട്:</para>
  <para style="q2" vid="HOS 14:3">‘ഞങ്ങളുടെ ദൈവമേ’ എന്ന് പറയുകയോ ചെയ്യുകയില്ല;</para>
  <para style="q1" vid="HOS 14:3">അനാഥന് തിരുസന്നിധിയിൽ കരുണ ലഭിക്കുന്നുവല്ലോ”</para>
  <para style="q2" vid="HOS 14:3">എന്നു പറയുവിൻ.<verse eid="HOS 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HOS 14:4" />“ഞാൻ അവരുടെ പിൻമാറ്റം ചികിത്സിച്ചു സൗഖ്യമാക്കും;</para>
  <para style="q2" vid="HOS 14:4">എന്‍റെ കോപം അവനെ വിട്ടുമാറിയിരിക്കുകയാൽ</para>
  <para style="q2" vid="HOS 14:4">ഞാൻ അവരെ ഔദാര്യമായി സ്നേഹിക്കും.<verse eid="HOS 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 14:5" />ഞാൻ യിസ്രായേലിനു മഞ്ഞുപോലെയിരിക്കും;</para>
  <para style="q2" vid="HOS 14:5">അവൻ താമരപോലെ പൂത്ത്</para>
  <para style="q1" vid="HOS 14:5">ലെബാനോൻ വനം പോലെ വേരൂന്നും.<verse eid="HOS 14:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 14:6" />അവന്‍റെ കൊമ്പുകൾ പടരും;</para>
  <para style="q1" vid="HOS 14:6">അവന്‍റെ ഭംഗി ഒലിവുവൃക്ഷത്തിന്‍റെ ഭംഗിപോലെയും</para>
  <para style="q2" vid="HOS 14:6">അവന്‍റെ സൗരഭ്യം ലെബാനോൻ പോലെയും ആയിരിക്കും.<verse eid="HOS 14:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 14:7" />ജനം അവന്‍റെ നിഴലിൽ വീണ്ടും പാര്‍ക്കും<note caller="+" style="f"><char style="fr" closed="false">14:7 </char><char style="fq" closed="false">ജനം അവന്‍റെ നിഴലിൽ വീണ്ടും പാര്‍ക്കും </char><char style="ft" closed="false">അവര്‍ യഹോവയുടെ നിഴലില്‍ വീണ്ടും പാര്‍ക്കും</char></note>.</para>
  <para style="q2" vid="HOS 14:7">പാർക്കുന്നവർ വീണ്ടും ധാന്യം വിളയിക്കുകയും</para>
  <para style="q1" vid="HOS 14:7">മുന്തിരിവള്ളിപോലെ തളിർക്കുകയും ചെയ്യും;</para>
  <para style="q2" vid="HOS 14:7">അതിന്‍റെ കീർത്തി ലെബാനോനിലെ വീഞ്ഞുപോലെ ആയിരിക്കും.<verse eid="HOS 14:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HOS 14:8" />“എഫ്രയീമേ, ഇനി എനിക്ക് വിഗ്രഹങ്ങളോട് എന്ത് കാര്യം?</para>
  <para style="q2" vid="HOS 14:8">ഞാൻ അവന് ഉത്തരം അരുളി അവനെ കടാക്ഷിക്കും;</para>
  <para style="q1" vid="HOS 14:8">ഞാൻ തഴച്ചിരിക്കുന്ന സരള വൃക്ഷംപോലെ ആകുന്നു.</para>
  <para style="q2" vid="HOS 14:8">എന്നിൽ നീ ഫലം കണ്ടെത്തും.”<verse eid="HOS 14:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HOS 14:9" />ഇത് ഗ്രഹിക്കുവാൻ തക്ക ജ്ഞാനി ആര്‍?</para>
  <para style="q2" vid="HOS 14:9">ഇത് അറിയുവാൻ തക്ക വിവേകി ആര്‍?</para>
  <para style="q1" vid="HOS 14:9">യഹോവയുടെ വഴികൾ ചൊവ്വുള്ളവയല്ലോ;</para>
  <para style="q2" vid="HOS 14:9">നീതിമാന്മാർ അവയിൽ നടക്കും;</para>
  <para style="q2" vid="HOS 14:9">അതിക്രമക്കാരോ അവയിൽ ഇടറിവീഴും.<verse eid="HOS 14:9" /></para>
  <chapter eid="HOS 14" />
</usx>