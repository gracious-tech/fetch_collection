<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="TIT" style="id" />
  <para style="ide">UTF-8</para>
  <para style="h">തീത്തൊസ്</para>
  <para style="toc1">തീത്തൊസ്</para>
  <para style="toc2">തീത്തൊ.</para>
  <para style="toc3">തീത്തൊ.</para>
  <para style="mt">തീത്തൊസ്</para>
  <para style="is">ഗ്രന്ഥകര്‍ത്താവ്</para>
  <para style="ip">തീത്തൊസിനു എഴുതപ്പെട്ട ഈ കത്തിൽ പൗലൊസ് സ്വയം തന്നെക്കുറിച്ച് വെളിപ്പെടുത്തുന്നത് “ദൈവത്തിന്‍റെ ദാസനും യേശുക്രിസ്തുവിന്‍റെ അപ്പൊസ്തലനും” എന്നാണ് (തീത്തൊ 1:1). തീത്തോസുമായുള്ള പൗലൊസിന്‍റെ ബന്ധത്തിന്‍റെ തുടക്കം അജ്ഞാതമാണ്. പൗലൊസിന്‍റെ ശുശ്രൂഷയിലൂടെ ക്രിസ്തു വിശ്വാസത്തിലേക്ക് വന്ന വ്യക്തിയാണ് തീത്തൊസ്. അതുകൊണ്ടാണ് പൗലൊസ് “പൊതുവിശ്വാസത്തിൽ നിജ പുത്രനായ തീത്തൊസ്” എന്നു അഭിസംബോധന ചെയ്യുന്നത് (തീത്തൊ 1:4). സുവിശേഷത്തിന് സഹകാരിയും സുഹൃത്തുമായ തീത്തൊസിനെ വളരെ ബഹുമാനത്തോടു കൂടിയാണ് പൗലൊസ് കണ്ടിരുന്നത്. തീത്തൊസിൻ്റെ സ്നേഹവും, അചഞ്ചലതയെയും അപ്പോസ്തലന്‍ ശ്ലാഘിക്കുന്നു.</para>
  <para style="is">എഴുതപ്പെട്ട കാലഘട്ടവും സ്ഥലവും</para>
  <para style="ip">ഏകദേശം. ക്രിസ്താബ്ദം 63 - 65.</para>
  <para style="ip">റോമിലെ തന്‍റെ ആദ്യത്തെ കാരാഗൃഹ വാസത്തിനുശേഷം പുറത്തുവന്ന പൗലൊസ് നിക്കോപ്പോലിസ് എന്ന സ്ഥലത്തു വച്ചാണ് ഈ ലേഖനം എഴുതിയത്. ശുശ്രൂഷയ്ക്കായി എഫെസൊസിൽ തിമോഥെയോസിനെ വിട്ടിട്ടുപോരുന്ന പൗലൊസ് ക്രേത്തദ്വീപിൽ തീത്തൊസുമായി ചേര്‍ന്നു പ്രവർത്തിക്കുന്നു.</para>
  <para style="is">സ്വീകര്‍ത്താക്കൾ</para>
  <para style="ip">തീത്തൊസ് ക്രേത്തയിലെ ഒരു സഹപ്രവർത്തകനും വിശ്വാസത്താല്‍ നിജ പുത്രനുമാണ്.</para>
  <para style="is">ഉദ്ദേശ്യം</para>
  <para style="ip">ക്രേത്തയിലെ പുതിയ സഭകളിൽ ഉള്ള ചില പോരായ്മകൾ നികത്തുവാനും തെറ്റായ വ്യവസ്ഥിതിയും അംഗങ്ങളുടെ അച്ചടക്കമില്ലായ്മയും മാറ്റുന്നതിന് പുതിയ മൂപ്പന്മാരെ നിയമിക്കുവാനും അവിശ്വാസികളുടെ മുമ്പാകെ നല്ല സാക്ഷ്യവും മാതൃകയും മുൻനിർത്തി അവരെ വേലയ്ക്കു മുതൽക്കൂട്ടാക്കി തീർക്കുവാനും നിർദ്ദേശം നൽകുന്നു.</para>
  <para style="is">പ്രമേയം</para>
  <para style="ip">പെരുമാറ്റത്തിലുള്ള ചട്ടങ്ങൾ</para>
  <para style="iot">സംക്ഷേപം</para>
  <para style="io1">1. അഭിവാദനം — 1:1-4</para>
  <para style="io1">2. മൂപ്പന്മാരുടെ നിയമനം — 1:5-16</para>
  <para style="io1">3. വിവിധ പ്രായക്കാർക്കുള്ള നിർദ്ദേശങ്ങൾ — 2:1-3:11</para>
  <para style="io1">4. സമാപന സന്ദേശം — 3:12-15</para>
  <chapter number="1" style="c" sid="TIT 1" />
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1" />നമ്മുടെ രക്ഷിതാവായ ദൈവത്തിന്‍റെ കല്പനപ്രകാരം എന്നെ ഭരമേല്പിച്ച പ്രസംഗത്താൽ തക്കസമയത്ത് തന്‍റെ വചനം വെളിപ്പെടുത്തിയ, <verse eid="TIT 1:1" /><verse number="2" style="v" sid="TIT 1:2" />ഭോഷ്ക് പറയാത്ത ദൈവം സകലകാലത്തിനും മുമ്പെ വാഗ്ദത്തം ചെയ്ത നിത്യജീവൻ്റെ പ്രത്യാശയിൽ <verse eid="TIT 1:2" /><verse number="3" style="v" sid="TIT 1:3" />താൻ തിരഞ്ഞെടുത്തവരുടെ വിശ്വാസത്തിനും ഭക്തിക്കനുസാരമായ സത്യത്തിന്‍റെ പരിജ്ഞാനത്തിനുമായി, ദൈവത്തിന്‍റെ ദാസനും യേശുക്രിസ്തുവിന്‍റെ അപ്പൊസ്തലനുമായ പൗലൊസ്, <verse eid="TIT 1:3" /><verse number="4" style="v" sid="TIT 1:4" />നമ്മുടെ പൊതുവിശ്വാസത്തിൽ യഥാർത്ഥപുത്രനായ തീത്തൊസിന് എഴുതുന്നത്: പിതാവായ ദൈവത്തിങ്കൽനിന്നും നമ്മുടെ രക്ഷിതാവായ ക്രിസ്തുയേശുവിങ്കൽനിന്നും നിനക്കു കൃപയും സമാധാനവും ഉണ്ടാകട്ടെ.<verse eid="TIT 1:4" /></para>
  <para style="s">തീത്തൊസിന്‍റെ ക്രേത്തയിലെ ദൗത്യം</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5" />ഞാൻ ക്രേത്തയിൽ നിന്നെ വിട്ടിട്ടുപോന്നത്: ശേഷിച്ച കാര്യങ്ങളെ ക്രമത്തിലാക്കേണ്ടതിനും ഞാൻ നിന്നോട് ആജ്ഞാപിച്ചതുപോലെ എല്ലാ പട്ടണത്തിലും മൂപ്പന്മാരെ നിയമിക്കേണ്ടതിനും തന്നെ. <verse eid="TIT 1:5" /><verse number="6" style="v" sid="TIT 1:6" />മൂപ്പൻ കുറ്റമില്ലാത്തവനും ഏകഭാര്യയുള്ളവനും ദുർന്നടപ്പിൻ്റെ ശ്രുതിയോ അനുസരണക്കേടോ ഇല്ലാത്ത വിശ്വാസികളായ മക്കളുള്ളവനും ആയിരിക്കേണം. <verse eid="TIT 1:6" /><verse number="7" style="v" sid="TIT 1:7" />അദ്ധ്യക്ഷൻ ദൈവത്തിന്‍റെ ഗൃഹവിചാരകനാകയാൽ കുറ്റമില്ലാത്തവനായിരിക്കേണം; തന്നിഷ്ടക്കാരനും മുൻകോപിയും മദ്യപ്രിയനും കലഹക്കാരനും ദുർല്ലാഭമോഹിയും അരുത്.<verse eid="TIT 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="TIT 1:8" />എന്നാൽ അതിഥിപ്രിയനും സൽഗുണപ്രിയനും സുബോധശീലനും നീതിമാനും നിർമ്മലനും ഇന്ദ്രിയജയമുള്ളവനും <verse eid="TIT 1:8" /><verse number="9" style="v" sid="TIT 1:9" />ആരോഗ്യകരമായ ഉപദേശത്താൽ പ്രബോധിപ്പിക്കുവാനും വിരോധികൾക്കു ബോധം വരുത്തുവാനും ശക്തനാകേണ്ടതിന്, ഉപദേശപ്രകാരമുള്ള വിശ്വാസ്യവചനം മുറുകെപ്പിടിക്കുന്നവനും ആയിരിക്കേണം.<verse eid="TIT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10" />വൃഥാവാചാലന്മാരും, ജനങ്ങളെ വഞ്ചിക്കുന്നവരുമായ കീഴടങ്ങാത്ത പലരും ഉണ്ട്; വിശേഷാൽ പരിച്ഛേദനക്കാർ തന്നെ. <verse eid="TIT 1:10" /><verse number="11" style="v" sid="TIT 1:11" />അവരുടെ വായ് അടയ്ക്കേണ്ടതാകുന്നു. അവർ ദുരാദായത്തിനു വേണ്ടി, ഉപദേശിക്കരുതാത്തത് ഉപദേശിച്ചുകൊണ്ട് കുടുംബങ്ങളെ മുഴുവനും മറിച്ചുകളയുന്നു. <verse eid="TIT 1:11" /><verse number="12" style="v" sid="TIT 1:12" />“ക്രേത്തർ സദാ നുണയന്മാരും, ദുഷ്ടജന്തുക്കളും മടിയന്മാരായ പെരുവയറന്മാരും അത്രേ” എന്നു അവരിൽ ഒരുവൻ, അവരുടെ ഒരു പ്രവാചകൻ തന്നെ, പറഞ്ഞിരിക്കുന്നു. <verse eid="TIT 1:12" /><verse number="13" style="v" sid="TIT 1:13" />ഈ സാക്ഷ്യം സത്യം തന്നെ; അതുകൊണ്ട് അവർ വിശ്വാസത്തിൽ ആരോഗ്യമുള്ളവരായിത്തീരേണ്ടതിനും <verse eid="TIT 1:13" /><verse number="14" style="v" sid="TIT 1:14" />യെഹൂദകെട്ടുകഥകളെയും സത്യം വിട്ടകലുന്ന മനുഷ്യരുടെ കല്പനകളെയും ശ്രദ്ധിക്കാതിരിക്കേണ്ടതിനും അവരെ കഠിനമായി ശാസിക്കുക.<verse eid="TIT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 1:15" />ശുദ്ധിയുള്ളവർക്കു എല്ലാം ശുദ്ധം തന്നെ; എന്നാൽ മലിനന്മാർക്കും അവിശ്വാസികൾക്കും ഒന്നും ശുദ്ധമല്ല; അവരുടെ ഹൃദയവും മനസ്സാക്ഷിയും മലിനമായിത്തീർന്നിരിക്കുന്നു. <verse eid="TIT 1:15" /><verse number="16" style="v" sid="TIT 1:16" />അവർ ദൈവത്തെ അറിയുവാൻ പ്രഖ്യാപിക്കുന്നുവെങ്കിലും പ്രവൃത്തികളാൽ അവനെ നിഷേധിക്കുന്നു. അവർ അറപ്പുളവാക്കുന്നവരും അനുസരണംകെട്ടവരും യാതൊരു നല്ലകാര്യത്തിനും കൊള്ളരുതാത്തവരുമാകുന്നു.<verse eid="TIT 1:16" /></para>
  <chapter eid="TIT 1" />
  <chapter number="2" style="c" sid="TIT 2" />
  <para style="s">ആരോഗ്യകരമായ ഉപദേശം</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1" />നീയോ ആരോഗ്യകരമായ ഉപദേശത്തിന് യോഗ്യമായത് പ്രസ്താവിക്കുക. <verse eid="TIT 2:1" /><verse number="2" style="v" sid="TIT 2:2" />വൃദ്ധന്മാർ സമചിത്തരും ആദരണീയരും സുബോധം ഉള്ളവരും വിശ്വാസത്തിലും സ്നേഹത്തിലും സഹിഷ്ണതയിലും ദൃഢതയുള്ളവരും ആയിരിക്കേണം എന്നും <verse eid="TIT 2:2" /><verse number="3" style="v" sid="TIT 2:3" />വൃദ്ധമാരും അങ്ങനെ തന്നെ സ്വഭാവത്തിൽ മാന്യതയുള്ളവരും ഏഷണി പറയാത്തവരോ വീഞ്ഞിന് അടിമപ്പെടാത്തവരോ ആയിരിക്കേണം എന്നും <verse eid="TIT 2:3" /><verse number="4" style="v" sid="TIT 2:4" />ദൈവവചനം ദുഷിക്കപ്പെടാതിരിക്കേണ്ടതിന് യൗവനക്കാരത്തികളെ തങ്ങളുടെ ഭർത്താക്കന്മാരേയും കുട്ടികളെയും സ്നേഹിക്കുന്നവരായും <verse eid="TIT 2:4" /><verse number="5" style="v" sid="TIT 2:5" />സുബോധവും പാതിവ്രത്യവുമുള്ളവരും വീട്ടുകാര്യം നോക്കുന്നവരും ദയയുള്ളവരും തങ്ങളുടെ സ്വന്ത ഭർത്താക്കന്മാർക്ക് കീഴ്പെടുന്നവരും ആയിരിക്കുവാൻ പരിശീലിപ്പിക്കേണ്ടതിന് നന്മ ഉപദേശിക്കുന്നവരായിരിക്കേണം എന്നും പ്രബോധിപ്പിക്കുക.<verse eid="TIT 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6" />അപ്രകാരം യൗവനക്കാരെയും സുബോധമുള്ളവരായിരിക്കുവാൻ പ്രബോധിപ്പിക്കുക. <verse eid="TIT 2:6" /><verse number="7" style="v" sid="TIT 2:7" />വിരോധി നമ്മെക്കൊണ്ട് ഒരു തിന്മയും പറയുവാൻ വകയില്ലാതെ ലജ്ജിക്കേണ്ടതിന് സകലത്തിലും നിന്നെത്തന്നെ സൽപ്രവൃത്തികൾക്ക് മാതൃകയാക്കി കാണിക്കുകയും, <verse eid="TIT 2:7" /><verse number="8" style="v" sid="TIT 2:8" />നിന്‍റെ ഉപദേശത്തിൽ സത്യസന്ധതയും ഗൗരവവും വാക്കുകളിൽ ആക്ഷേപിക്കാൻ കഴിയാത്ത കൃത്യതയും വേണം. <verse eid="TIT 2:8" /><verse number="9" style="v" sid="TIT 2:9" />ദാസന്മാർ നമ്മുടെ രക്ഷിതാവായ ദൈവത്തിന്‍റെ ഉപദേശത്തെ സകലത്തിലും അലങ്കരിക്കേണ്ടതിന് യജമാനന്മാർക്ക് കീഴടങ്ങി സകലവിധത്തിലും പ്രസാദം വരുത്തുന്നവരും <verse eid="TIT 2:9" /><verse number="10" style="v" sid="TIT 2:10" />എതിർ പറയുകയോ വഞ്ചിച്ചെടുക്കുകയോ ചെയ്യാതെ, എന്നാൽ സകലത്തിലും നല്ല വിശ്വസ്തത കാണിക്കുന്നവരുമായിരിക്കേണം.<verse eid="TIT 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11" />സകലമനുഷ്യർക്കും രക്ഷാകരമായ ദൈവകൃപ ഉദിച്ചുവല്ലോ; <verse eid="TIT 2:11" /><verse number="12" style="v" sid="TIT 2:12" />ഭാഗ്യകരമായ പ്രത്യാശയ്ക്കായിട്ടും നമ്മുടെ മഹാദൈവവും രക്ഷിതാവുമായ യേശുക്രിസ്തുവിന്‍റെ തേജസ്സിൻ്റെ പ്രത്യക്ഷതയ്ക്കായിട്ടും നാം കാത്തുകൊണ്ട്, <verse eid="TIT 2:12" /><verse number="13" style="v" sid="TIT 2:13" />ഭക്തികേടും ലൗകികമോഹങ്ങളും വർജ്ജിക്കുവാനും, ഈ ലോകത്തിൽ സുബോധത്തോടും നീതിയോടും ദൈവഭക്തിയോടും കൂടെ ജീവിക്കുവാനും അത് നമ്മെ ശിക്ഷിച്ചുവളർത്തുന്നു. <verse eid="TIT 2:13" /><verse number="14" style="v" sid="TIT 2:14" />അവൻ നമ്മെ സകല അധർമ്മത്തിൽനിന്നും വീണ്ടെടുക്കുവാനും സൽപ്രവൃത്തികളിൽ ശുഷ്കാന്തിയുള്ളൊരു സ്വന്തജനമായി തനിക്കു ശുദ്ധീകരിക്കേണ്ടതിനും തന്നെത്താൻ നമുക്കുവേണ്ടി കൊടുത്തു.<verse eid="TIT 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15" />ഇത് പൂർണ്ണ അധികാരത്തോടെ പ്രസംഗിക്കുകയും പ്രബോധിപ്പിക്കുകയും ശാസിക്കുകയും ചെയ്ക. ആരും നിന്നെ തുച്ഛീകരിക്കരുത്.<verse eid="TIT 2:15" /></para>
  <chapter eid="TIT 2" />
  <chapter number="3" style="c" sid="TIT 3" />
  <para style="s">സൽപ്രവൃത്തികൾ ചെയ്യുക</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1" />ഭരണകർത്താക്കൾക്കും അധികാരികൾക്കും കീഴടങ്ങുവാനും അനുസരിക്കുവാനും സകലസൽപ്രവൃത്തിക്കും ഒരുങ്ങിയിരിക്കുവാനും <verse eid="TIT 3:1" /><verse number="2" style="v" sid="TIT 3:2" />ആരെയും കുറിച്ച് ദൂഷണം പറയാതെയും കലഹിക്കാതെയും ശാന്തന്മാരായി സകലമനുഷ്യരോടും പൂർണ്ണസൗമ്യത കാണിക്കുവാനും അവരെ ഓർമ്മപ്പെടുത്തുക.<verse eid="TIT 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="TIT 3:3" />മുമ്പെ നാമും ഭോഷന്മാരും അനുസരണമില്ലാത്തവരും വഞ്ചിക്കപ്പെട്ടവരും നാനാമോഹങ്ങൾക്കും ഭോഗങ്ങൾക്കും അധീനരും വിദ്വേഷത്തിലും അസൂയയിലും കാലം കഴിക്കുന്നവരും നിന്ദിതരും അന്യോന്യം വെറുക്കുന്നവരും ആയിരുന്നുവല്ലോ. <verse eid="TIT 3:3" /><verse number="4" style="v" sid="TIT 3:4" />എന്നാൽ നമ്മുടെ രക്ഷിതാവായ ദൈവത്തിന്‍റെ ദയയും മനുഷ്യനോടുള്ള സ്നേഹവും ഉദിച്ചപ്പോൾ, <verse eid="TIT 3:4" /><verse number="5" style="v" sid="TIT 3:5" />അവൻ നമ്മെ നാം ചെയ്ത നീതിപ്രവൃത്തികളാലല്ല, തന്‍റെ കാരുണ്യം കൊണ്ടും വീണ്ടും ജനത്തിന്‍റെ ശുദ്ധീകരണം കൊണ്ടും പരിശുദ്ധാത്മാവിനാലുള്ള നവീകരണം കൊണ്ടുമത്രേ രക്ഷിച്ചത്. <verse eid="TIT 3:5" /><verse number="6" style="v" sid="TIT 3:6" />നാം അവന്‍റെ കൃപയാൽ നീതീകരിക്കപ്പെട്ടിട്ട് നിത്യജീവൻ്റെ പ്രത്യാശപ്രകാരം അവകാശികളായിത്തീരേണ്ടതിന്, <verse eid="TIT 3:6" /><verse number="7" style="v" sid="TIT 3:7" />നമ്മുടെ രക്ഷിതാവായ യേശുക്രിസ്തു മുഖാന്തരം നമ്മുടെമേൽ അതേ പരിശുദ്ധാത്മാവിനെ ധാരാളമായി പകർന്നു. <verse eid="TIT 3:7" /><verse number="8" style="v" sid="TIT 3:8" />ഈ വചനം വിശ്വാസയോഗ്യം; ദൈവത്തിൽ വിശ്വസിച്ചവർ സൽപ്രവൃത്തികളിൽ ഉത്സാഹികളായിരിക്കുവാൻ കരുതേണ്ടതിന് നീ ഇത് ഉറപ്പിച്ചു പറയേണം എന്നു ഞാൻ ഇച്ഛിക്കുന്നു. ഇത് ശുഭവും മനുഷ്യർക്ക് ഉപകാരവും ആകുന്നു. <verse eid="TIT 3:8" /><verse number="9" style="v" sid="TIT 3:9" />എന്നാൽ മൂഢതർക്കവും വംശാവലികളും കലഹവും ന്യായപ്രമാണത്തെക്കുറിച്ചുള്ള വാദവും ഒഴിഞ്ഞുനിൽക്കുക. ഇവ നിഷ്പ്രയോജനവും വ്യർത്ഥവുമല്ലോ. <verse eid="TIT 3:9" /><verse number="10" style="v" sid="TIT 3:10" />നിങ്ങൾക്കിടയിൽ ഭിന്നത വരുത്തുന്ന മനുഷ്യനോട് ഒന്നുരണ്ട് വട്ടം മുന്നറിയിപ്പ് കൊടുത്തശേഷം അവനെ ഒഴിവാക്കുക; <verse eid="TIT 3:10" /><verse number="11" style="v" sid="TIT 3:11" />ഇങ്ങനെയുള്ളവൻ വക്രത കാണിച്ചും പാപം ചെയ്തും തന്നെത്താൻ കുറ്റം വിധിച്ചിരിക്കുന്നു എന്നു നിനക്കു അറിയാമല്ലോ.<verse eid="TIT 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12" />ഞാൻ അർത്തെമാസിനെയോ തിഹിക്കൊസിനേയോ അങ്ങോട്ട് അയയ്ക്കുമ്പോൾ നിക്കൊപ്പൊലിസിൽ വന്ന് എന്നോട് ചേരുവാൻ ആവതും ശ്രമിക്കുക. എന്തെന്നാൽ അവിടെ ഞാൻ ശീതകാലം കഴിക്കുവാൻ നിശ്ചയിച്ചിരിക്കുന്നു. <verse eid="TIT 3:12" /><verse number="13" style="v" sid="TIT 3:13" />ന്യായശാസ്ത്രിയായ സേനാസിനും അപ്പൊല്ലോസിനും ഒന്നിനും കുറവില്ലാതെയിരിക്കുവാൻ ഉത്സാഹിച്ച് യാത്ര അയയ്ക്കുക. <verse eid="TIT 3:13" /><verse number="14" style="v" sid="TIT 3:14" />നമുക്കുള്ളവരും ഫലമില്ലാത്തവർ ആകാതെ, അത്യാവശ്യസംഗതികളിൽ ഉപകരിക്കേണ്ടതിന് സൽപ്രവൃത്തികൾക്ക് ഉത്സാഹികളായിരിക്കുവാൻ പഠിക്കട്ടെ.<verse eid="TIT 3:14" /></para>
  <para style="s">സ്നേഹവന്ദനം</para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15" />എന്നോടുകൂടെയുള്ളവർ എല്ലാവരും നിനക്കു വന്ദനം ചൊല്ലുന്നു. ഞങ്ങളെ വിശ്വാസത്തിൽ സ്നേഹിക്കുന്നവർക്ക് വന്ദനം ചൊല്ലുക.</para>
  <para style="p" vid="TIT 3:15">കൃപ നിങ്ങളോടെല്ലാവരോടുംകൂടെ ഇരിക്കുമാറാകട്ടെ.<verse eid="TIT 3:15" /></para>
  <chapter eid="TIT 3" />
</usx>