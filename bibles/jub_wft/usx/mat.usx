<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- WANU BIBLE TRANSLATION PROJECT</book>
  <para style="h">Matu</para>
  <para style="toc1">Matu</para>
  <para style="toc2">Matu</para>
  <para style="toc3">Mat.</para>
  <para style="mt1">Matu</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s1">Azyì Áwádako àwu Mbùkú wa Ángyèké àwu Yesu Kristi</para>
  <para style="r">(Lk 3.23–38)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Azyì àwu áwádako wu mbùkú wa ngyèké àwu Yesu Kristi, ángode-ngode kpendu àwu Dawuda wàyi ngode-ngode kpendu àwu Ibrahim lá.<verse eid="MAT 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2" />Ibrahim mbà Ishaku, Ishaku mbà Yakubu, Yakubu mbà Yahuda wa ázyēyī'a. <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />Yahuda mbà Peresa wa Zera, áyī'wa yi Tamar, Perez mbà Hezron, Hezron mbà Ram, <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />Ram mbà Aminadab, Aminadab mbà Nashon, Nashon mbà Salmon, <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />Salmon mbà Boaz, áyī'a yi Rahab. Boaz mbà Obed, áyī'a yi Rut, Obed mbà Jese, <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />Jese mbà aku Dawuda. Dawuda mbà Solomon, áyī'a yi àwà Uria, <verse eid="MAT 1:6" /><verse number="7" style="v" sid="MAT 1:7" />Solomon mbà Rehobowam, Rehobowam mbà Abija, Abija mbà Asa, <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />Asa mbà Jehoshafat, Jehoshafat mbà Jehoram, Jehoram mbà Uziya, <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Uziya mbà Jotam, Jotam mbà Ahaz, Ahaz mbà Hezekiya, <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Hezekiya mbà Manase, Manase mbà Amon, Amon mbà Josiya, <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />Josiya mbà Jekoniya wa ázyēyī'a yiifu dédē waa wa hwo Áwáisrela ya sá kolo fyì yii zyoku Babila lá.<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />Yii niki dédēwaa wa lò Áwáisrela hwo ya zyoku Babila lá, Jekoniya mbà Sheyaltiyel, Sheyaltiyel mbà Zerubabel, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />Zerubabel mbà Abiud, Abiud mbà Eliyakim, Eliyakim mbà Azɔ, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />Azɔ mbà Zadok, Zadok mbà Akim, Akim mbà Eliwud, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Eliwud mbà Eliyaza, Eliyaza mbà Matan, Matan mbà Yakubu, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />Yakubu mbà Yusufu ànù Maryamu wàmbà Yesu waa wa hwoi bá'u la, Kristi lá.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Yimamala dà yiishina Ibrahim ya ishina Dawuda, àchù idezeni, kà dà yiishina Dawuda ya dédēwaa wa hwoi sá kolo fyì yii zyoku Babila lá, kà yi chù idezeni, yiifu dédē waa wa hwo panku ya sá kolo fyì yii zyoku Babila lá bē mbàmbà Kristi kà yi chù idezeni.<verse eid="MAT 1:17" /></para>
  <para style="s1">Ámbàmbà Yesu Kristi</para>
  <para style="r">(Lk 2.1–7)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Yiiyi waa wa mbà Yesu Kristi lá gbaa yiinì. Wa lò yī'a Maryamu kā Yusufu, dedee gbógbó wálò bā dɛ̀ wa diwa lá, Maryamu lò yìnɔ̀ la, u bā fu wa Nidi Wànyɛnyɛ. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Yusufu yi panku wàyi sá wú wàgyēgyē gbɛ̀n, dedee u yi fú ú káwa dó Maryamu zúde yii zú panku yɔ̀, Yimamala, u lò nwā wàlò gàfā wa'u kyó má. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />U yiifu zyíhwɛ̀ lá wàgàgà, ángochɔ̀ àwu Adando gbá pwè'uzū ní yiifu ndó ma zɛ̀ la, &lt;&lt;Yusufu, ángode Dawuda, káwa sázī wàlò Maryamu kōlò ú lò kà wà'o yɔ̀, dizyi wa Nidi Wànyɛnyɛ waa u kàsɔ̀fu ní. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />U yi mbà ngo wánù, o yi chò'u zyì la, Yesu, ishina u lò panku'a hwoi tɛ̄ zumyɛ yiibe wúwàbɛbɛ'wa lá.&gt;&gt;<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Tàma sásá wú wàhwoila kwò mazyi áwú waa Adando lò zɛ̀ zube ándówyapyɛ̀ lá, ú lò kà byɛ̀, <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />&lt;&lt;angozuwa wàyì wánù yɔ̀ yi bāfu ma yi mbà ngo wánù, wa hwoi bá'u la, Imanuwel&gt;&gt;átɛ́'a zyī la, &lt;&lt;Shidɔ yi wa'i.&gt;&gt;<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Yimamala dédēwaa Yusufu lò zèná lá, u lò bā dɛ̀ wa Maryamu, sáyìna yiiyi waa ángochɔ̀ àwu Adando zɛ̀ yí'u la, ú sá lá. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Dedee u gba nábená wa'u yɔ̀ gbógbó u lò ngo'a mbà. Yusufu chò'u zyì la Yesu.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s1">Áwápàkyù Wàzu Zúdɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Wa mbà Yesu yii gá àwu Betalami yii Yahudiya, yiifu dédēwaa Hirudus yi ku lá. U gba nashɔ yɔ̀, áwánù wándó wàyì chí lá gbá zū zúdɔ ya Urushelima <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />ma mbyēshé la, &lt;&lt;Ángotā waa wa mbà lò yi kà ku Áwáyahuda lá yii be wàni ní? I wya chí'a dédēwaa u dà ya dɔ yii zúdɔ lá, i bē mazyi í wá'u.&gt;&gt;<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Dédēwaa Aku Hirudus fá mamá lá, u lò kà fu bēbèwàwèwè, kà mamá wa nɔ́nɔ̄ yii Urushelima dúdú wa'u. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Hirudus lò áwádakumbwa wàshuwɔ̀ wa wándó tà Dɔ̀ Musa bándɛ̀ gbàyi ma mbyē'wa shé la, &lt;&lt;Yii be wàni waa wa hwoi mbà Kristi ní?&gt;&gt;<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />Wa zɛ̀ yí'u la, &lt;&lt;Yii fu gá àwu Betalami yii Yahudiya, dizyi áwú waa ándówyapyɛ̀ tā lá gbaa hwoi nì,<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />&lt;Betalami wàyii zyoku Yahuda lá,</para>
  <para style="q2" vid="MAT 2:6">áwo gba zōnwū kā yiifu gáwàshūwɔ̀ wàhwoi sáchɔ̀ yii Yahuda lá ní,</para>
  <para style="q1" vid="MAT 2:6">yii fu'u waa dóshī zū yi zumyɛ ní,</para>
  <para style="q2" vid="MAT 2:6">ándó wàyi kó panku'm Isrela lá.&gt;&gt;&gt;<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Yimamala Hirudus lò áwápàkyù wàzu zúdɔ lá bándɛ̀ kyómá gbàyi mazyi ú yì nyunu pwá waa chí pwèzū lá yiibe'wa. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Yiibeli u chō'wa chɔ̀ ya Betalami ma zɛ̀ la, &lt;&lt;Ni ya hwāzú ngo lá myɔ̀myɔ̀, mazyi dédē waa ni ma wya'u ní, ni yí'm yìnɔ̀ mazyi ḿ ya wá'u dúdú.&gt;&gt;<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Niki waa wa lò zyí fá bwā lá, wa ya'wa, yii nyàshɔ'wa, wa wya chí waa wa wya'u yii zúdɔ lá lò kɛ́pyɛ̀ gbógbó ya sāli yii bē waa ngo yiiní lá. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Dédēwaa wa wya chí li lá, wa mbònwú kà mbònwú buu. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Wa lò kà futá ma wya ngo wa yī'a Maryamu lá, wa kàli ma wá'u. Yiibeli wa lò gúmà'wa pòfā ma sá'usɔ̀ àshɔ́wànyànyà, wa àmbwò kòfyī waa wa hwoi wè pyù nūfyì vyāàvyā lá, wa àbyù kòfyī wànūfyì kwɛ́nkwɛ́n lá.<verse eid="MAT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12" />Yiibeli wa lò kàsɛ̄ zū nyàshɔ zukɛ̄kɛ̄ ma ya'wa zyoku ndō'wa, dizyiwaa Shidɔ lò vo bwà'wa yiifu ndó mazyi wá ká kàsɛ zū bé Hirudus gɛ̀ yɔ̀ lá.<verse eid="MAT 2:12" /></para>
  <para style="s1">Wa lò Shè Ya Masar.</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Niki waa wa lò ya'wa lá, ángochɔ̀ Adando pwèzū Yusufu ní yiifu ndó ma zɛ̀ la, &lt;&lt;Hirudus yi hwāzú ngo lá mazyi ú lò'u bwā. Yimamala dàdɔ, lò ngo lá wa yī'a lò mazyi ni lò shè ya Masar, ni shí beli gbógbó m ma zɛ̀ yí'o la, ni kàsɛ pùnū.&gt;&gt;<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />Yimamala Yusufu lò dàdɔ, ma lò ngo lá wa yī'a lò súnɔ̀ ya Masar, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />ma shí beli gbógbó Hirudus lò hu. Áwú lá kwò mamá mazyi áwú waa Adando zɛ̀ zū nū ándówyapyɛ̀ lá, ú lò kà byɛ̀, u zɛ̀ la, &lt;&lt;M lò ngo'm bándɛ̀ zumyɛ yii Masar.&gt;&gt;<verse eid="MAT 2:15" /></para>
  <para style="s">Wa Bwā Zyētíìfyí</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Dédēwaa Hirudus lò yìnɔ̀ la, áwándó wàzu zúdɔ byè'uni lá, àbɔ̄dú waa u lò sáàpá ní. U yínū mazyi wá bwā zyētíìfyí wánù wàhwoi fu Betalami wa gáwàtiti wàbàbà wa'u lá sásá, dà zū ishina wándó dɛ ipyɛ bē zyoku, u lò wú lá sá mamá dizyi ádédē waa u dò yiibe áwápàkyù ishina ápwèzu chí lá.<verse eid="MAT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 2:17" />Áwú lá hwā zyí waa Jeremiya ándówyapyɛ̀ zɛ̀ lá lòkà zyíbyɛ̀, u zɛ̀ la,<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />&lt;&lt;Apanku fá huna kito yii Rama,</para>
  <para style="q2" vid="MAT 2:18">ákito kishèshè àwu nwútòtò.</para>
  <para style="q1" vid="MAT 2:18">Rahila gbaa yi shèki ishina zyē'a ní,</para>
  <para style="q2" vid="MAT 2:18">u nghà la, wáká pé'u yɔ̀,</para>
  <para style="q1" vid="MAT 2:18">dizyi zyē'a hwo hu.&gt;&gt;<verse eid="MAT 2:18" /></para>
  <para style="s1">Wa Lò Kàsɛ Ya Nazaret</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Niki waa Hirudus lò hu lá, ángochɔ̀ Adando pwèzū Yusufu ní yiifu ndó yii Masar <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />ma zɛ̀ la, &lt;&lt;Dàdɔ, lò ngo lá wa yī'a lò mazyi ni kàsɛ̄ ya zyoku Isrela, dizyi áwándó wàhwoi hwāzú ngo lá wàbwāàbwā lá hwo hu ló.&gt;&gt;<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />Yimamala Yusufu lò dàdɔ, ma lò ngo lá wa yī'a lò ma hwo kàsɛ ya zyoku Isrela.<verse eid="MAT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22" />Dedee dédēwaa Yusufu fá la, Akilayus zyīfí dā'a Hirudus ma lò kà ku àwu Yahudiya lá, u lò kàzī wàya beli. Wa bwà'uvo yiifu ndó lá, u lò dányà ya vozyoku Galili <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />ma ya shí fu gá zū zyī la, Nazaret. Yimamala áwú waa áwándówyapyɛ̀ zɛ̀ lá lò kà zyíbyɛ̀, zɛ̀ la, &lt;&lt;Wa hwoi bá'u la, Áwánazaret.&gt;&gt;<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s1">Yohana sá Yesu Batisma</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Yiifu dédē li Yohana wàyi sá Batisma lá bē ma yi dádɔ̀ yii sáchɔ́ àwu Yahudiya. <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />u yi zɛ̀ la, &lt;&lt;Ni me wúwàbɛbɛ'ni ní, dizyi Àchɔ̀ wà yii Dɔ lò bē bàdì!&gt;&gt; <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Yohana waa Ishaya ándówyapyɛ̀ zɛ̀zyí ishina'a la,</para>
  <para style="q1" vid="MAT 3:3">&lt;&lt;Apazu yi dákito yii sáchɔ́,</para>
  <para style="q2" vid="MAT 3:3">&lt;ni mbyā nyàshɔ àwu Adando,</para>
  <para style="q2" vid="MAT 3:3">ni mbyā'u nyàshɔ wàndāfā.&gt;&gt;&gt;<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Átúkpá wàyii dì Yohana lá wa mbyā'u wa áhwɛ̄dì wēwànárī, u dɛ̀ vyù gàhwɔ̄ shèkwà fyū'a, áwúzyī'a yi bàkūdú wa zyàdɛ. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Apanku zū Urushelima wa sásá vozyoku Yahudiya bē bé'a, wa sásá zyoku wàbàbà wa numgbe Jodan lá. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Wa zɛ̀ wúwàbɛbɛ'wa, u sá'wa batisma yii numgbe Jodan.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Waa Yohana wya Áwáfaris ndàbè wa Áwásadus hwoi be bé'a mazyi ú sá'wa batisma lá, u zɛ̀ yí'wa la, &lt;&lt;Awuni shīkwā wusu wàbɛbɛ! Ánɔ̄ bwà'ni vo wàlò shè yiibe fyì àwu Shidɔ wàyi bēèbē lá ní? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Ni sá wú wàyi tà la, ni hwo vēkà yiibe wúwàbɛbɛ'ni kàsɛ bà Shidɔ. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Mazyi ni káwa gàzyíhwɛ̀ la, ni hwoi nwàzū yiibe fyì lá wa zyí waa ni hwoi zɛ̀ la, Ibrahim yi dako'ni àwu mbùkú wa ángyèké lá yɔ̀. M ngyi zɛ̀ yí'ni la, Shidɔ bā gba wàlò gɔ́ hwoila kà zyēdēkpéndū àwu Ibrahim! <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Tàma ákē kɛ́pyɛ̀ jā yiibe dúfyī wà lò'u gé kwèkwè, sásá fyī wà ma nwā ngyì wàsàsà yɔ̀ ní, wa lò'u yi gé tá wè pyù. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />&lt;&lt;Ami yi sá'ni batisma wa lape wàyi tà la ni lò vēkà yiibe wúwàbɛbɛ, dedee ándó wàyi bē gbá lá yi sá'ni batisma wa Nidi Wànyɛnyɛ, wa pyù. U bā gba kā'm ní, m kē wàpà'uvo yiibe tābá'a yɔ̀. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />U bā bírí wàlò yiibe'a wàlò zá sásá vé. U lò áwá'a yi hwo kwazɔ yi wè fu vā'a, dedee ma lò kpátāfú yi sōpyù yiifu pyù wà yi dɛ yɔ̀ lá.<verse eid="MAT 3:12" /></para>
  <para style="s1">Yohana sá Yesu Batisma</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Yiifu dédē li Yesu zū Galili bē Jodan bé Yohana mazyi ú sá'u batisma. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Dedee Yohana ngā mazyi ú lò'u nwú'a lòdɔ yii ní, ma zɛ̀ la, &lt;&lt;Ami gbaa yi ndó wàyi fú mazyi ó sá'm batisma ní, dedee o kà bē bé'm!&gt;&gt;<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Yesu zɛ̀'undɛ̀ ní la, &lt;&lt;Ú yí mamá tàma. Dizyi yii nyàshɔ lá waa i hwoi sá wú waa Shidɔ yi fú lá ní.&gt;&gt; Yimamala Yohana lò zɛ̀ndɛ̀.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Nikiwaa Yesu lò baptisma sá yiibe Yohana, ma mbàámbàní ma lò zumyɛ yii lape lá, ādɔ lò pòfā yí Yohana, u wya Nidi Shidɔ yi tòli sáyìna ndàkpò wa bēyá yii ishina Yesu. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Yiibeli àhuna zɛ̀zyí zū dɔ la, &lt;&lt;Ango'm waa m ngyi shó lá gbaa yiinì, dizyi áhu gbaa yi sá wú wàvyā'mdì ní.&gt;&gt;<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s1">Ápɛ́ Wàmbà Yesu Lá</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Yiibeli Nidi wànyɛ̄nyɛ̄ lò Yesu lò ya sáchɔ́ mazyi Ápawàbɛbɛ ú mbà'upɛ́. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Nikiwaa Yesu sá nyunu idipaipyɛ, àsúnɔ̀ idipàipyɛ mazyi wúzyī yɔ̀ lá, ámbɔ̄ lò kāgbá'adɔ. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Yiibeli Ápawàbɛbɛ bē dò'u ma zɛ̀ la, &lt;&lt;Nyunuwaa o ma yi Ngo Shidɔ ní, yí gɔ́ hwoila nū mazyi wálò kà wúzyī.&gt;&gt;<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Yesu zɛ̀'undɛ̀ ní la, &lt;&lt;Ázyí Shidɔ wàtāàtā zɛ̀ la, &lt;Ápanku yi gbā wa wúzyī wàzyīìzyī tànwú'a yɔ̀, dedee u yi fú sásá zyí wàyi zumyɛ yii nū Shidɔ lá.&gt; &gt;&gt;<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Yiibeli Ápawàbɛbɛ lò Yesu lò ya Urushelima, Àgáwàshuwɔ̀ Wànyɛnyɛ lá, ma lò'u chá ya sā bē wà yii dɔdɔ kā lá yii ishina táwàwáshidɔ, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />ma zɛ̀ yí'u la, &lt;&lt;Nyunuwaa o ma yi Ngo Shidɔ ní,&gt;&gt; &lt;&lt;nwà ya zyoku, dizyi Ázyí Shidɔ wàtāàtā zɛ̀ la,</para>
  <para style="q1" vid="MAT 4:6">&lt;Shidɔ yi yí ázyēchɔ̀'a nū ishina'o,</para>
  <para style="q2" vid="MAT 4:6">wálò'o yi pà wa vo'wa,</para>
  <para style="q2" vid="MAT 4:6">mazyi bá'o ú káwa dá bé gɔ́ yɔ̀.&gt; &gt;&gt;<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Yesu zɛ̀'undɛ̀ ní la, &lt;&lt;Dedee ázyí Shidɔ wàtāàtā kà zɛ̀ la, &lt;Káwa mbàwya Adando Shidɔ'o yɔ̀.&gt; &gt;&gt;<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Yiibeli, Angyefu lò Yesu lò ya ishina gā ya dɔdɔ ma tà'u chɔ̀ wàhwoi denmyɛ sásá lá wa áhwɛ̀ waa wa bā lá. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Ma zɛ̀ yí'u la, &lt;&lt;Sásá wúwàhwoila m lò yi yí'o, nyunuwaa o ma kàli ma wá'm.&gt;&gt;<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Yesu zɛ̀'undɛ̀ ní la, &lt;&lt;Dàdɔ yii maa, Ápawàbɛbɛ! Ázyí Shidɔ wàtāàtā zɛ̀ la, &lt;Wá Adando Shidɔ'o, mazyi ó sá kolo yí'u tànwú'a.&gt; &gt;&gt;<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Yiibeli Ápawàbɛbɛ me Yesu ní, ázyēchɔ̀ be dò'u ma sázá'u ní.<verse eid="MAT 4:11" /></para>
  <para style="s1">Yesu Vyō Kolo'a yii Galili</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Dédēwaa Yesu fá la, wa lò Yohana pà hwā fu táfyì lá, u lò dàdɔ yii Yahudiya ya Galili. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />U gba sāli yii Nazaret yɔ̀, ma ya shí Kapernaum, àgá wàbàbà wa núkù Galili lá, yii vozyoku Zebulun wa Naftali. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Áwú lá kwò mamá mazyi ázyí Ishaya ándówyapyɛ̀ zɛ̀ lá, ú lò kà zyíbyɛ̀, yi zɛ̀ la,<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />&lt;&lt;Áwuni panku wàshí hwoi zyoku Zebulun wa zyoku Naftali,</para>
  <para style="q2" vid="MAT 4:15">wàyii nyàshɔ wàya núkù, yii zyɛ̄ Jodan,</para>
  <para style="q2" vid="MAT 4:15">wa Galili, azyoku pànku wàhwoi Áwáyahuda yɔ̀ lá!<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Apanku wàshí hwoi bēwàsèfē lá</para>
  <para style="q2" vid="MAT 4:16">hwoi wya bēyá wàshuwɔ̀.</para>
  <para style="q1" vid="MAT 4:16">Áwándó wàshí hwoi zyoku wàsèfē àwu ki lá bēyá yi té jā'wa.&gt;&gt;<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Dà zū dédē lá Yesu vyō dɔ̀wàdáàdá'a, yi zɛ̀ la, &lt;&lt;Ni vekà me wúwàbɛbɛ'ni ní, dizyi àchɔ̀ wàyii dɔ lá lò bē bàdì!&gt;&gt;<verse eid="MAT 4:17" /></para>
  <para style="s1">Yesu Bá Áwándópàzyé Ini ndɛ̀</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Yiiyi waa Yesu yi kyēkyū bàbà yii núkù àwu Galili lá, u wya zyēyī ápà ipyɛ hwoi wándópàzyé, Siman waa wa bá la, Bitrus lá, wa ngoyī'a Andrawus, hwoi pà zyé yii núkù wa kyɛ́lɛ́bɛ́. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Yesu zɛ̀ yí'wa la, &lt;&lt;Ni bē'm ní, mazyi ḿ tà'ni yiiyi wa hwoi pà panku lá.&gt;&gt; <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Yiibebeli wa me kyɛ́lɛ́bɛ́'wa ní ma lò be'u ní.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />U kyēkyū ya pyɛ̀ ma wya zyēyī zukɛ̄kɛ̄ ipyɛ, Yakubu wa Yohana ázyē Zebedi. Wa hwoi fu kɔ̀'wa wa ada'wa Zebedi, ma hwoi mbyā kyɛ́lɛ́bɛ́'wa. Yesu bá'wandɛ̀, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />yiibebeli wa me kɔ̀'wa ní wa ada'wa ma lò bē'u ní.<verse eid="MAT 4:22" /></para>
  <para style="s1">Yesu yi Tàwú, Yi dɔ̀wàdáàdá, Ma yi Dàgba Wándówútòtò</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Yesu lò zyoku Galili kyē sásá, yi tàwú hwoi táwàwáshidɔ, yi dádɔ̀ Shévyā Wàsàsà ishina Chɔ̀ Shidɔ, ma yi dàgba panku wàbā ādōdì kɛ̄-kɛ̄kɛ̄ wa wútòtò lá. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Ashévyā ishina Yesu kà zyoku Siriya sásá, apanku hwo wándó wàhwo tòwú sásá lá bē yí'u, wa wándó waa ādōdì kɛ̄-kɛ̄kɛ̄ hwoi tà'wa fyì lá, wa wándó wàfá vyā dì yɔ̀ lá, wa áwándó wàbā zyɔ̀, wa wándó wàhwoi pà kpíìkpíì, wa áwándó wàhu zédì, Yesu lò'wa dàgba sásá. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Apanku ndàbè be'uni zū Galili, wa gá ídē, wa Urushelima, wa zyoku Yahudiya, kà wa wándó wàhwoi zyɛ̄ Jodan lá.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s1">Àdɔ̀wàdáàdá Yesu Yiishina Gā</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Yesu wya panku lò ndàbè, ma lò né ishina gā, ma ya shí li. Áwátu'a gbàyi ma lò'u tábílíkā, <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />u gbá pòfā nū'a ma yi tà'wa wú la,<verse eid="MAT 5:2" /></para>
  <para style="s">Avosɔ̀ Wàbuu</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />&lt;&lt;Avosɔ̀ Shidɔ yi wu áwándó wàyì'wanɔ̀ la, wa nyànì nidi lá,</para>
  <para style="q2" vid="MAT 5:3">dizyi Àchɔ̀ wàyii dɔ lá yi wuwa!<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Avosɔ̀ Shidɔ yi wu áwándó wàhwoi shèki lá,</para>
  <para style="q2" vid="MAT 5:4">dizyi Shidɔ gbaa yi pé'wa ní!<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Avosɔ̀ Shidɔ yi wu áwándó wàhwo ishina'wa náli lá,</para>
  <para style="q2" vid="MAT 5:5">dizyi áwuwa gbaa hwoi zyīfí bēèmyɛ̄ ní!<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Avosɔ̀ Shidɔ yi wu áwándó wàhwoi fá mbɔ̄ wa nwúzyà àwu wú wàgyēgyē lá,</para>
  <para style="q2" vid="MAT 5:6">dizyi Shidɔ yí'wa hwoi zɛ̀fu!<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Avosɔ̀ Shidɔ yi wu áwándó wàhwoi wyashīshī wándó wànati lá,</para>
  <para style="q2" vid="MAT 5:7">dizyi Shidɔ yi wyashīshī'wa dúdú!<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Avosɔ̀ Shidɔ yi wu áwándó wàbā nwú wànyɛnyɛ lá,</para>
  <para style="q2" vid="MAT 5:8">dizyi wa hwoi wya Shidɔ!<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Avosɔ̀ Shidɔ yi wu áwándó wàhwoi pézyí lá,</para>
  <para style="q2" vid="MAT 5:9">dizyi Shidɔ yi bá'wa la, ázyē'a!<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Avosɔ̀ Shidɔ yi wu áwándó waa wa hwoi tà'wa fyì ishina wàsá wú waa Shidɔ yi fú lá,</para>
  <para style="q2" vid="MAT 5:10">dizyi Àchɔ̀ wàyii dɔ lá yi wuwa!<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />&lt;&lt;Avosɔ̀ Shidɔ yi wuni nyunuwaa ápanku ma chō'ni tè, ma tà'ni fyì, ma té'ni zyí kɛ̄-kɛ̄kɛ̄ wàbɛbɛ àwu zyígé ishina ni hwoi be'mni lá ní. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Ni mbònwú mazyi ni shàáshà, dizyi ābetò kolo'ni wàshūwɔ̀ hwā'ni yii dɔ. dizyi mamá waa áwándówyapyɛ̀ wàkɛ́pyɛ̀ yí'ni lá wyafyì ní.<verse eid="MAT 5:12" /></para>
  <para style="s1">Áwándó Wàhwoi Bē Yesu ní lá Hwoi Sena Āmā wa Beyá</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />&lt;&lt;Ni hwoi sáyìna āmā àwu pànku sásá. Dedee nyunu waa āmā magadì wa àvyā'a, bā nyashɔ waa o kà yi sá'u yi vyāàvyā gɛ̀ yɔ̀. U lò kà wúwàtàánchɔ̀, yimamala wa lò'u yi nyámbyɛ́ wè myɛ̄, ápanku hwoi tébá yii ní.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />&lt;&lt;Ni hwoi sáyìna bēyá àwu denmyɛ sásá. Àgáwàshuwɔ̀ waa wa myī'u yiishina gwū yi yùyò yɔ̀. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Ápàzukponu yi hwāpyù yiibe kyàngyà ma lò wú yi bē'u yɔ̀. Kin ú lò'u sè bé wúwàsèní, yii bē waa u yi yí nɔ́nɔ̄ yi bēyá yii futá lá. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Kà yi zukpo mamá, mazyi ábēyá'ni ú sánghánghálá yii pyɛ̀ panku, mazyi wá wya wúwàsàsà waa ni hwoi sá lá, mazyi wá ngyā Adā'ni wà yii dɔ lá.<verse eid="MAT 5:16" /></para>
  <para style="s1">Áwútàtà Yesu ishina Dɔ̀</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />&lt;&lt;Ni káwa gàzyíhwɛ̀ la, m be wàlò Dɔ̀ Musa wa wútàtà áwándówyapyɛ̀ sábɛ yɔ̀. M gba be wàlò'wa sábɛ yɔ̀, dedee m be wàyí wútàtà'wa ú lò kà zyíbyɛ̀. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Yibyɛ̀, m ngyi zɛ̀ yí'ni la, gbógbó dɔ wa bēèmyɛ̄ wálò zyìli lá, kwā ngyì wúwàtāàtā wàtítíntíì kwɛɛ àzyèwúchɔ̀ wàtítíntíì wàhwoi fu Dɔ̀ Musa lá, hwoi zyìli yɔ̀, gbógbó áwúsásá lò yi gyīlà. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Yimamala sásá pà wàma nghà kwā wú wàtítíntíì yiifu dɔ̀ ma tà wándówànati mazyi wásá zukponu mamá ní, u lò yi kà ápanku wàtítíntíì yiifu Chɔ̀ wàyii dɔ. Dedee sásá pà wàma zɛ̀ndɛ̀ wa Dɔ̀ ma tà wándówànati mazyi wá sá zukponu mamá ní, u lò yi kà ápanku wàshūwɔ̀ yiifu Chɔ̀ wàyii dɔ. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />M ngyi zɛ̀ yí'ni la, nyunuwaa àbyɛ̀'ni ma kāgbá àwu áwándó tà Dɔ̀ Musa wa Áwáfaris yɔ̀ ní, ni hwoi kàfu Chɔ̀ wàyii dɔ lá yɔ̀.<verse eid="MAT 5:20" /></para>
  <para style="s1">Áwútàtà Yesu Ishina Àpáwàsáàsá</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />&lt;&lt;Ni kàpyɛ̀ fá Shidɔ zɛ̀ yí panku ndii la, &lt;O yi bwā panku yɔ̀, sásá pà wàma bwā panku wa hwoi hwà'ukwɛ́.&gt; <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Dedee tàma m ngyi zɛ̀ yí'ni la, sásá pà wàma yi sáàpá wa ngoyī'a, wa hwoi hwà'ukwɛ́, sásá pà wà ma bá ngoyī'a la, &lt;Àkyɔ̀!&gt; wa hwoi chá'u yi ya tákwɛ́ wàshūwɔ̀, Sásá pà wàma bá ngoyī'a la, àkyɔ̀ wàbā lɛ̀ yɔ̀, u yii nūki wàya ndō pyù. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />&lt;&lt;Yimamala nyunuwaa o ma yi ndāvo wúwàsásɔ̀'o yi yí Shidɔ yiishina gwūdù wàpyāndɛ̀ ma kyé la, ángoyī'o bā nūhwɛ̀ zū wa'o ní, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />me wúwàsásɔ̀'o ní hwā pyɛ̀ gwūdù wàpyāndɛ̀ yii beli, ya lò diu mbyā wa ngoyī'o, mazyi ó pi kàsɛ lò wúwàsásɔ̀'o ndāvo yí Shidɔ ní.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />&lt;&lt;Lò diu mbyā mwɔ̄mwɔ̄ wa wámà'o wàchá yi ya tákwɛ́ lá, sá dédēwaa ni kà hwoi nyàshɔ lá, kwɛɛ u ma mamá yɔ̀, u lò'o yi ndāvo yí ndógàkwɛ́, ándógàkwɛ́ lò'o yi ndāvo yí ndósèdì pi lò'o yi tá hwā fu táfyì. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Ázyíbyɛ̀ waa m ngyi zɛ̀ ní, o yi zumyɛ yii beli yɔ̀ gbógbó o lò banji kwɛ́ waa wa pà'o lá yi hwātɔ̄bwā.<verse eid="MAT 5:26" /></para>
  <para style="s1">Áwútàtà Yesu ishina báwàkyáàkyá</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />&lt;&lt;Ni kàpyɛ̀ fá Shidɔ zɛ̀ yí panku ndii la, &lt;O yi kyábá yɔ̀.&gt; <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Dedee tàma m ngyi zɛ̀ yí'ni la, sásá pà wà ma jā wáwà zú àwu shɔ́wàmāàmā, u kàpyɛ̀ lò bákyá wa'u yiifu nwú'a mánì. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Yimamala nyunuwaa ázú vonzyī'u ma hwā'o yi sá wúwàbɛbɛ ní, lò'u shā támbyɛ́! U yi pà'otáshì ní buu mazyi o sáfyì àkélédì'u zukpo lá kā waa wa lò dìu mɛ̀mbɛ̀lɛ̀ yi tá hwā ndōpyù lá ní. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Nyunuwaa àvonzyī'u ma hwā'o yi sá wúwàbɛbɛ ní, lò'u kè mazyi ó lò'u támbyɛ́! U yi pà'otáshì ní buu mazyi ó sáfyì àkélédì'u zukpo lá kā waa dìu mɛ̀mbɛ̀lɛ̀ yi ya ndōpyù lá ní.<verse eid="MAT 5:30" /></para>
  <para style="s1">Áwútàtà Yesu ishina Bāwàgàgà</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />&lt;&lt;Wa kà zɛ̀ la, &lt;Sásá pà wàma nghà wà'a, u yi yí'u āfā wàgàbā.&gt; <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Dedee tàma m ngyi zɛ̀ yí'ni la, Sásá pà wàma nghà wà'a, dizyi wúsásá wàmahwā gba ishina báwàkyáàkyá yɔ̀ ní, yiibeli u yi sá wúwàbɛbɛ wàyí'u yi kyábá nyunuwaa u makà bà nù zū, ànù wàkà yi bà'u lá, kà yi kyábá dúdú.<verse eid="MAT 5:32" /></para>
  <para style="s1">Áwútàtà Yesu ishina Kiwàdàdà</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />&lt;&lt;Ni kà fá wa zɛ̀ yí panku ndii la, &lt;Káwa dàki àwu zyígé yɔ̀, dedee sá wú waa o dàki yí Adando la, o yi sá lá.&gt; <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Dedee tàma m ngyi zɛ̀ yí'ni la, ni káwa dàki zukponu yiifu dédēwaa ni hwoi génū lá yɔ̀. Ni káwa dàki wa dɔ yɔ̀ kin, dizyi u yi dù waa Shidɔ yi shí ní; <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />kwɛɛ wa bēèmyɛ̄ wàyi bē wàsè bá'a yii ní lá yɔ̀, kwɛɛ wa Urushelima wàyi àgáwàshuwɔ̀ àwu ku wàshūwɔ̀ lá yɔ̀. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />O yi dàki wa ishina'o yɔ̀, dizyi o lò ngyì zyí zukponu yi vēkà mòmbò kwɛɛ wàpèpè kà yɔ̀. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Kin zɛ̀ la, &lt;Eba&gt; kwɛɛ &lt;Aayi&gt; dedee o ma zɛ̀ wúzu gbòkyā wú wàhwoila, u zube Ápawàbɛbɛ.<verse eid="MAT 5:37" /></para>
  <para style="s1">Áwútàtà Yesu ishina Wú Wàlò Hwātɔ̄ Kàshī</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />&lt;&lt;Ni kàpyɛ̀ fá Shidɔ zɛ̀ yí panku ndii la, áyīzú yi wàlò hwātɔ̄ kàshī wa áyīzú, kàwa nyí yi wàlò hwātɔ̄ kàshī wa nyí. <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Dedee tàma m ngyi zɛ̀ yí'ni, ni kálò wúwàbɛbɛ waa pàzu sá'ni lá hwātɔ̄ kàshī yɔ̀. Nyunuwaa ápazu ma tá'o pitá yii gbákyì zyɛ̄ vonzyī ní, kà vēkà gbákyì zyɛ̄ vonsɔ́ yí'u dúdú. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Kàwa nyunuwaa ápazu ma chá'okwɛ́ yii tákwɛ́ dizyi áwúkɛ̀'o ní, me túkpá'o ní yí'u dúdú. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Nyunuwaa pàzu ma pà'o wu gbā lò'u wúchɛ́ ya kyilomita zukponu ní, lò'u ní lò ya kyilomita ipyɛ. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Nyunuwaa pàzu ma vá'o wúzu ní, lò yí'u, nyunuwaa pàzu ma fú ó hwā'u wúzu ní, lò hwā'u ní.<verse eid="MAT 5:42" /></para>
  <para style="s1">Áwútàtà Yesu ishina Wàshó Wàzé</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />&lt;&lt;Ni kàpyɛ̀ fá Shidɔ zɛ̀ yí panku ndii la, &lt;Ni shó áwábugɛ'ni mazyi ni zé áwáwàzé'ni.&gt; <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Dedee tàma m ngyi zɛ̀ yí'ni la, ni shó áwáwàzé'ni mazyi ni jāndɛ̀ wè wándó wàhwoi tà'ni fyì lá, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />mazyi ni hwo kà ázyē Ada'ni wàyii dɔ lá. Dizyi u yí nyunu'a yi vyì ya dɔ yiishina ápanku wàbɛbɛ wa ápanku wàsàsà, ma yí fyù yi tā yí wándó sá wúwàsàsà wa wándó sá wúwàbɛbɛ. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Nyunuwaa ni ma shó ákèké wándó wàshó'ni lá ní, Shidɔ yi hwa'ni tɔ̄ mamánī ní? Kwā wándó pà gbā hwoi sá mamá. <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Nyunuwaa ni ma hwoi tá mamgba wa ákèké áwábugɛ'ni ní, ni sá wúzu kɛ̄kɛ̄ wa yiiyi waa wa hwoi sá gbɛ̀n lá mánì? Kwā áwándó wá wúhwɔ̀ hwoi sá mamá. <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />U lò kà kɛ́n mazyi ni lò kà ápanku wàgyīlà sáyìna yiiyi waa Ada'ni wàyii dɔ gyīlà lá!<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s1">Áwútàtà Yesu ishina Sɔ̀wàsáàsá</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />&lt;&lt;Ni pà dini mazyi ni káwa sásɔ̀ yii pyɛ̀ panku wá wya wú waa ni sá lá yɔ̀. nyunuwaa ni ma sá mamá yii pyɛ̀ panku ní, ni hwoi dò bētòkolo'ni zukponu yi yiibe Ada'ni wàyii dɔ lá yɔ̀.<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />Yimamala nyunuwaa o ma yi sá ándówànyànì lá sɔ̀ ní, ká lò'u dádɔ̀ wa kito sáyìna yiiyi waa áwándódúgyɛ́ hwoi sá yii táwàwáshidɔ wa nyàshɔ lá yɔ̀. Wa hwoi sá mamá mazyi apanku wá ngyā'wa. Ḿ zɛ̀ yí'ni zyíbyɛ̀, wa kàpyɛ̀ lò bētòkolo'wa hwā'watɔ̄bwā mánì. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Dedee nyunuwaa o ma yi sá ándówànyànì lá sɔ̀ ní, sá'u mazyi àbugɛ'o wàbàzɔ̄ wa'o pyápyá lá ú ká yìnɔ̀ yɔ̀. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Yiibeli àsɔ̀wàsáàsá'o ú lò kà wú wàyùyò. Mazyi Ada'o wàyi wya wú wàyùyò lá, ú hwā'otɔ̄.<verse eid="MAT 6:4" /></para>
  <para style="s1">Áwútàtà Yesu ishina Andɛ̀wàjāàjā</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />&lt;&lt; Dédēwaa ni ma hwoi jāndɛ̀ ní, ni ká lò kà sáyìna áwándódúgyɛ́ yɔ̀! Wa shó ndɛ̀wàjāàjā wàsādɔ yii táwàwáshidɔ wa nyàshɔ mazyi ápanku wá wya'wa. Ḿ zɛ̀ yí'ni zyíbyɛ̀, wa kàpyɛ̀ lò bētòkolo'wa hwā'watɔ̄bwā mánì. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Dedee o ma yi jāndɛ̀ ní, ya kà fu tá'o, mazyi ó lò nūkyɔ́ chù, mazyi ó jāndɛ̀ yí Ada'o, waa wa hwoi wya'u yɔ̀ lá. Mazyi Ada'o wàyi wya wú wà yùyò lá, ú hwā'otɔ̄.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />Dédēwaa ni ma hwoi jāndɛ̀, ni káwa jāsā wa zyí wànùchɔ̀ wàzɛ̀ kà zɛ̀ sáyìna yiiyi waa áwándó wá wúhwɔ̀ hwoi sá lá yɔ̀, áwándó wàhwoi gàzyíhwɛ̀ la, áwúhwɔ̀'wa hwoi fá'wa ishina ndɛ̀wàjāàjā'wa gwɔ̄ɔ̀gwɔ̄ lá. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Ni kálò kà sáyìna wa yɔ̀, dizyi Ada'ni kàpyɛ̀ yì wú waa ni hwoi fú lá pùnū waa ni pi vá ní. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />Yiiyi waa o yi jāndɛ̀ lá gbaa yi nì,</para>
  <para style="q1" vid="MAT 6:9">&lt;&lt;Ada'i wàyii dɔ lá,</para>
  <para style="q2" vid="MAT 6:9">àzyì'u ó lòkà zyì wànyɛnyɛ,<verse eid="MAT 6:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="MAT 6:10" />Achɔ̀'o ú bē,</para>
  <para style="q2" vid="MAT 6:10">áwú waa o yi fú lá, wá sá yii bēèmyɛ̄ sáyìna yiiyi waa u yii dɔ lá.<verse eid="MAT 6:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="MAT 6:11" />Yí'i wúzyī waa i hwoi fú lá.<verse eid="MAT 6:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="MAT 6:12" />Gbā'izyɔ̀ wú wàbɛbɛ waa i sá lá,</para>
  <para style="q2" vid="MAT 6:12">sáyìna yiiyi waa i gbāzyɔ̀ wúwàbɛbɛ waa wándó wànàti sá'i lá.<verse eid="MAT 6:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="MAT 6:13" />Káwa chá'i ya fu pɛ́wàmbàmbà yɔ̀,</para>
  <para style="q2" vid="MAT 6:13">dedee tɛ̄'i yiibe wúwàbɛbɛ.&gt;<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />&lt;&lt;Nyunuwaa ni ma gbāzyɔ̀ wúwàbɛbɛ waa panku sá'ni lá ní, Ada'ni wàyii dɔ lá yi gbā'nizyɔ̀ dúdú. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Dedee nyunuwaa ni ma gbā panku zyɔ̀ yɔ̀ ní, mamá waa Ada'ni yi gbā'nizyɔ̀ wúwàbɛbɛ waa ni sá lá yɔ̀ ní.<verse eid="MAT 6:15" /></para>
  <para style="s1">Áwútàtà Yesu ishina Nūwàsèsè</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />&lt;&lt;Dédēwaa ni ma hwoi sènū ní, ni kálò zú gbē sáyìna yiiyi waa áwándógyɛ́ hwoi sá lá yɔ̀. Wa lò zú'wa gbē mazyi ápanku wáwya la, wa hwoi sènū. Ḿ zɛ̀ yí'ni zyíbyɛ̀, wa kàpyɛ̀ lò bētòkolo'wa hwā'watɔ̄bwā mánì. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Dédēwaa o ma yi sènū ní, lò byù pwò ishina'o mazyi ó lò zú'u tō, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />mazyi ápanku káwa yìnɔ̀ la, o yi sènū yɔ̀, mazyi ákèké Ada'o waa ápanku hwoi wya'u kà yɔ̀ lá, ú yìnɔ̀. Ada'o wàyi wya wú waa o sá yùyò lá, ú hwā'otɔ̄.<verse eid="MAT 6:18" /></para>
  <para style="s1">Áwútàtà Yesu ishina Wàhwo Wúchɔ́ Ya Kóshī Yii Dɔ</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />&lt;&lt;Ni kálò wúchɔ́'ni hwo kóshī yii bēèmyɛ̄ yɔ̀, yii bē waa àgɛ̀ wa dɛ́pàpà lò'wa hwoi sábɛ̄ lá yɔ̀, wa bē waa ávyú hwoi téká nūkyɔ́ kàfu ma hwoi vyí lá yɔ̀. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Dedee ni hwo wúchɔ́'ni ya kóshī yii dɔ, yii bē waa àgɛ̀ wa dɛ́pàpà hwoi sábɛ̄ kà yɔ̀ lá, kàwa bē waa ávyú hwoi téká kàfu ma hwoi vyí kà yɔ̀ lá. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Dizyi ánwú'u gbɛ̀n yi sā bé waa wúchɔ́'o wè hwoi ní lá.<verse eid="MAT 6:21" /></para>
  <para style="s">Áwútàtà Yesu Ishina Kyàngyà Dì</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />&lt;&lt;Áyīzú hwoi sáyìna kyàngyà àwu dì. Nyunuwaa áyīzú'u ma sàsà, àdì'u sásá lò yi mwɛ̀ wa bēyá, <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />dedee nyunuwaa áyīzú'u ma sàsà yɔ̀, àdì'u lò yi sèfē. Yimamala nyunuwaa bēyá wàyii dì'u lá ma lò sèfē, u yi sèfē bɛbɛ mamáni ní!<verse eid="MAT 6:23" /></para>
  <para style="s">Ni hwoi Wá Shidɔ Kwɛɛ Wúchɔ́</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />&lt;&lt;Apazukponu lò yi kà nyàchɛ̄ awasendo ipyɛ kà yɔ̀, dizyi ú yi zé wàsèndo zū mazyi shó wàsèndo zū, ú yi sá wàsèndo zū sàsà ma yi sìnì wàsèndo zū. O yi wá Shidɔ wa banji sásá wú ipyɛ kà yɔ̀.<verse eid="MAT 6:24" /></para>
  <para style="s1">Ni Zɛ̀ndɛ̀ wa Shidɔ Mazyi Ni káwa Zánwú Yɔ̀</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />&lt;&lt;Ishinali lá m zɛ̀ la, ni káwa zánwú ishina wúzyī wa zyàwā wàyí'ni hwoi shí hwoi zyoo lá yɔ̀, kwɛɛ pi ishina wúchɛ́ wàwèdì yɔ̀. Nyemgba, ánwú sàsà buu kā wúzyī yɔ̀? Àdì sàsà buu kā wúchɛ́ wàwèwè yɔ̀? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Ni wya ányī wàhwoi pēèpē yii dɔ, wa hwoi tà chɛ̄wú yɔ̀, kwɛɛ wá pi be wúzyī mazyi wáhwoi wè vā yɔ̀, dedee Ada'ni wàyii dɔ lá yí'wa wúzyī, hwoi zyàwā. Áwuni kā ányī wa hwɛ̀ buu ní yɔ̀? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Ánɔ̄ yiifu'ni waa ánwúzáàzá'a yi kwā nyunu zukponu yii bé nyunu ki'a kà ní?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />&lt;&lt;Lá áyɛ̄ sá waa ni hwoi zánwú ishina wúchɛ́ wàwèdì ní? Ni wya yiiyi waa àdòdó byɛ́ hwoi ngā yii fubyɛ́ lá. Wa hwoi sá kolo yɔ̀, kwɛɛ wá pi zù túkpá yí di'wa yɔ̀. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Dedee m ngyi zɛ̀ yí'ni la, kwā aku Solomon wa wúchɔ́'a sásá waa u bā lá, u gbā mbyādì sàsà sáyìna dòdó byɛ́ zukpo yiifu dòdó byɛ́ wàhwoi lá yɔ̀. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Shidɔ gbaa yi mbyā ábyɛ́ wàyii fubyɛ́ dì ní, ábyɛ́ wàyii maa zyìna waa ákyɛ̀ wa lò'u yi sōpyù lá, nyemgba pi hwoi wuni? Awuni wándó waa àbyɛ̀'ni hwo zō lá! <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />Yimamala ni káwa zánwú ishina wú wàhwoila yɔ̀: &lt;Áyɛ̄ waa i hwoi zyī ní?&gt; Kwɛɛ &lt;Áyɛ̄ waa i hwoi wā ní?&gt; Kwɛɛ &lt;Áyɛ̄ waa i hwoi wèdì ní?&gt; <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Áwú hwoila waa áwándó wá wúhwɔ̀ lò nwú'wa jā hwoi ni ní. Adā'ni wàyii dɔ lá, yìnɔ̀ la, ni hwoi fú wú wàhwoila sásá. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Dedee ni kàpyɛ̀ mashɔ́ áwúwàsàsà wàhwoi fu Chɔ̀ Shidɔ lá, mazyi ni sá wúwàsàsà waa u yi fú lá, mazyi ú lò wúsásá wànàti waa ni hwoi fú lá yí'ni. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Yimamala ni káwa zánwú ishina ákyɛ̀ yɔ̀, dizyi ákyɛ̀ yi zánwú ishina dia. Sásá nyunu bā nwúzáàzá'a wua kē'u.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s1">Ni káwa hwà Pazunkponu kwɛ́ yɔ̀</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />&lt;&lt;Ni káwa hwà pà zū kwɛ́, mazyi Shidɔ ú hwà'ni kwɛ́ yɔ̀. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Dizyi Shidɔ yi hwà'ni kwɛ́ li zukponu sáyìna yiiyi waa ni hwà wándówànati ní lá, kà wúwàmbàwú zukponu waa ni mbà wu wándówànati wa'u lá, waa wa kà hwoi mbà wuni wa'u ní. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />Áyɛ̄ sá waa o pi yi wya wúwàtítíntíì wàdó yiifu áyīzú ngoyī'o lá, ma yi wyà àgbólófyī wàdó yiifu áyīzú'u lá yi wúzu yɔ̀ ní? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Mamánī waa o pi yi zɛ̀ yí ngoyī'o la, &lt;Mamgba ḿ lò'o wúwàtítíntíì dó yiifu áyīzú'u lá tɛ̄zūmyɛ̄,&gt; waa áyīzú wuo gɛ̀ bā àgbólófyī dó yii fu'a lá ní? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Áwo ndógyɛ́! Kàpyɛ̀ lò àgbólófyī wàdó yiifu áyīzú'u lá tɛ̄zūmyɛ̄ pùnū, mazyi ó pi wyabe nyɛnyɛ wàlò wúwàtítíntíì wàdó yiifu yīzú ngoyī'o lá tɛ̄ zumyɛ ní.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />&lt;&lt;Ni kálò wú wànyɛnyɛ lò yí bɛ́ yɔ̀, dizyi wa hwoi vēkà ishina té'ni ma hwoi tɛ̄'ni fɔ́. Ni ká lò tángúdē'ni tá hwā luma pyɛ̀ yɔ̀, dizyi wálò bá hwoi té ní, ma hwoi vēkà ishina té'ni wàtɛ̄'ni fɔ́.<verse eid="MAT 7:6" /></para>
  <para style="s1">Ni Vá, Ni Hwāzú, Ni Dávo.</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />&lt;&lt; Ni ma hwoi vá, Shidɔ yi yí'ni, ni ma hwoi hwāzú, ni hwoi fyò, ni ma hwoi dávo yii nūkyɔ́, Shidɔ yi pò nūkyɔ́ yí'ni. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Sásá pà wàma vá Shidɔ yi yí'u; sásá pà wàma hwāzú u yi fyò, sásá pà wàma dávo yii nūkyɔ́, Shidɔ yi pò nūkyɔ́ yí'u. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />Adā wànī hwoi fu'ni waa ángo'a ma vá wúzyī, waa u yi yí'u gɔ́ ní? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Kwɛɛ u ma vá zyé waa u yi yí'u wúsù ní? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Kwā yiiyi waa áwúsáàsá'ni bɛbɛ lá, ni yì yiiyi waa ni hwoi yí zyē'ni wúwàsàsà lá. ni hwoi gà la, Ada'ni wàyii dɔ lá yi yí wándó wàhwoi vá'u lá wúwàsàsà kà yɔ̀ ní?<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />&lt;&lt;Yimamala ni sá panku wú waa ni hwoi fú wásá'ni lá, dizyi mamá waa Àdɔ̀ Musa wa áwándówyapyɛ̀ tà ní.<verse eid="MAT 7:12" /></para>
  <para style="s1">Nūkyɔ́ Wàpyíìpyí</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />&lt;&lt;Ni zū nūkyɔ́ wàpyíìpyí kàfu. Dizyi nūkyɔ́ wàya ndōpyù yáàyá, nyàshɔ wàzu ya fu'a yi nyàshɔ wàkpéndé, ápanku wàzu hwoi ya fu'a lá ndàbè. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Dedee nūkyɔ́ wàzu ya dò nwú wàgbógbó pyiipyi, nyàshɔ wàzu ya fu'a kàdì, ápanku wàzu hwoi ya fu'a lá ndàbè yɔ̀.<verse eid="MAT 7:14" /></para>
  <para style="s1">Āfyī wa Ngyì'a</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />&lt;&lt;Ni pà dini wa áwándówyapyɛ̀ àwu zyígé, wàdó hwoi fu gàhwɔ̄ dɛ̀ bē hwoi dò'ni lá, dedee waa nwú'wa sáyìna vyìvyìjɔ̄ wàbā púpù lá. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Ni hwoi yìkyà'wa yiibe wú waa wa hwoi sá lá. Ni hwoi nwá ngyì zyàbā yiibe sé yɔ̀, ni hwoi nwá ngyì gbánkòlò yiibe sé yɔ̀. <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Kà mamá waa sásá fyī wàsàsà lá yi nwā ngyì wàsàsà ní, dedee āfyī wà wàbɛbɛ, kà yi nwā ngyì wàbɛbɛ. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Āfyī wàsàsà yi nwā ngyì wàbɛbɛ yɔ̀, āfyī wàbɛbɛ yi nwā ngyì wàsàsà yɔ̀. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Sásá fyī wàma nwā ngyì wàsàsà yɔ̀ ní, wálò'u gé tá hwā pyù. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Yimamala ni hwoi yìkyà áwándówyapyɛ̀ àwu zyígé yiibe wú waa wa hwoi sá lá.<verse eid="MAT 7:20" /></para>
  <para style="s1">M Gbā Yì'ni Ló Yɔ̀</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />&lt;&lt;Gba yi sásá wándó wàhwoi bá'm la, &lt;Adando, Adando,&gt; lá hwoi kàfu chɔ̀ wàyii dɔ lá ní yɔ̀, dedee ákèké wándó wàhwoi sá wú waa Adā'm wàyii dɔ lá yi fú mazyi wásá lá, gbaa hwoi kà fua ní. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Dédēwaa nyunu wàhwàkwɛ́ yi bē lá, ápanku ndàbè hwo zɛ̀ yí'm la, &lt;Adando, Adando! Yiifu zyì'u zɛ̀ chɔ̀ Shidɔ, wa zyì'u i ká zyɔ̀ buu zumyɛ ma sá wúgbashu!&gt; <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Yiibeli m ngyi zɛ̀ yí'wa la, &lt;M yì'ni ló yɔ̀. Ni dàdɔ yii be wa'm yiiní lá, áwándó sá wúwàbɛbɛ!&gt;<verse eid="MAT 7:23" /></para>
  <para style="s1">Áwándó Myītá Ápà Ipyɛ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />&lt;&lt;Yimamala sásá pà wàma fá zyí'm ma sá wú waa m zɛ̀ lá ní, u yi sáyìna ándókyíyá wàmyī tá'a yii ishina gɔ́ lá. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Àfyù tā, alape lò mwɛ̀, áwɔ̀ sā gbakpo lò ishina té bé táli. Dedee u gba hwó yɔ̀, ishina wa myī'u yii ishina gɔ́ lá. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Dedee sásá pà wàma fá zyí'm ma sá wú waa m zɛ̀ lá yɔ̀ ní, u yi sáyìna ákyɔ̀ panku lá wàmyī tá'a yiishina chīchɔ́ lá. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Àfyù tā, alape lò mwɛ̀, áwɔ̀ sā gbakpo lò ishina té bé tá li, átá kwèkwè yii zyoku ma lò hwó sásá!&gt;&gt;<verse eid="MAT 7:27" /></para>
  <para style="s1">Ágba àwu Yesu</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Waa Yesu lò zyí hwoila zɛ̀bwā lá, àgbashu lò panku pà yiibe wútàtà'a, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />dizyi u tà'wa wú sáyìna ándó wàbā gbā, gba sáyìna áwándó tà Dɔ̀ Musa lá yɔ̀.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s1">Yesu Dàgba Ándó Dìwànyànyà</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Dédēwaa Yesu lò tòli zū ishina gā bē zyoku lá, ápanku ndàbè lò bē'uni. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Ápà zū wàbā wútòtò gàhwɔ̄ dì lá bē kàli lò zú bē zyoku yii pyɛ̀'a, ma zɛ̀ la, &lt;&lt;Adando, o ma shó ní, lò'm dàgba.&gt;&gt;<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Yesu ndāvo gwà'udì ma zɛ̀ la, &lt;&lt;M shó,&gt;&gt; Yesu zɛ̀ la, &lt;&lt;Lò yúùyú!&gt;&gt; Yiibebeli wútòtò gàhwɔ̄ dì'a lò kɛ̀. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Yiibeli Yesu zɛ̀ yí'u la, &lt;&lt;Fá! Káwa zɛ̀ yí pazukponu yɔ̀. Dedee ndāfā ya dò ádākúmbwá mazyi ú wya'o, kà ishina mazyi ánɔ́nɔ̄ ú zɛ̀ndɛ̀ la, wútòtò lò kɛ̀bwā lá, ya kúfà sáyìna yiiyi waa Dɔ̀ Musa zɛ̀ lá.&gt;&gt;<verse eid="MAT 8:4" /></para>
  <para style="s1">Yesu Lò Ango Ndósèdì Wàshūwɔ̀ Àwu Roma Dàgba</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Dédēwaa Yesu kà Kapernaum lá, ndósèdì wàshuwɔ̀ àwu Roma zū bē dò'u ma vá'u la, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />&lt;&lt;Adando, ángo'm wàwūnù yi tòwú ná yiibe wúnáná yii ndō, yi dàdɔ kà yɔ̀ ma yi wyafyì wàbɛbɛ lá.&gt;&gt;<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Yesu zɛ̀ yí'u la, &lt;&lt;M ngyi bē ma lò'u yi dàgba.&gt;&gt;<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Ndósèdì wàshūwɔ̀ àwu Roma lá zɛ̀'undɛ̀ ní la, &lt;&lt;Adando, m gbā kē wàyí'o bē ndō'm yɔ̀. Yínū kin, ángo'm lò yi dàgba. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Dizyi ami yii vo wáshuwɔ̀ wàbā gbā kā'm lá dúdú, m bā soja hwoi vo'm. M ngyi yí ndó wàyila nū la, &lt;Ya!&gt;u yi ya, m ngyi yí ndó wàyimá nū la, &lt;Be!&gt; u yi be, m ngyi yí nyà'm nū la, &lt;Sá wú wàyila!&gt; u yi sá'u.&gt;&gt;<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Dédēwaa Yesu fá mamá lá, àgbashu lò'u pà, u zɛ̀ yí wándó wà hwoi be'uni lá, &lt;&lt;Zyíbyɛ̀ waa ngyi zɛ̀ yí'ni ní, m gbā wya pàzu yiifu Isrela wàbā byɛ̀ shuwɔ̀ mamá ló yɔ̀. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />M ngyi zɛ̀ yí'ni la, apanku ndàbè hwoi zū zúdɔ wa vyívyò bē hwoi shí bé dùdù wa Ibrahim, wa Ishaku, wa Yakubu yiifu Chɔ̀ wàyii dɔ lá. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Dedee áwándó wàhwoi zyē àwu Chɔ̀ lá, wa lò'wa hwoi tá wè myɛ yii bēwàsèfē, yii bē waa wa hwoi shèki ma hwoi pā nyí'wa lá.&gt;&gt; <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />Yiibeli Yesu gbá zɛ̀ yí ndósèdì lá, &lt;&lt;Ya ndō! Áwú waa o zɛ̀ndɛ̀ ishina'a lá, lò yi sá.&gt;&gt;</para>
  <para style="p" vid="MAT 8:13">Ángonyà ndósèdì lá lò dàgba yiifu dédē lá pwá.<verse eid="MAT 8:13" /></para>
  <para style="s1">Yesu dàgba panku ndàbè</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Dédēwaa Yesu kà ndō Bitrus lá, u wya vyó Bitrus wàwūwà ná yiibe wúnáná yi tò lamba. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Yesu gwà'uvo yii vo'a, alamba me'uni, u dàdɔ ma sá wúzyī yí'wa.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Dédēwaa nyunu lò kwò lá, apanku hwo wándó wàbā zyɔ̀ yii dì'wa lá bē Yesu, Yesu lò nidi wàbɛbɛ ká zumyɛ wa zyí nū'a ma lò wándó wàtòwú lá hwo dàgba sásá. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />U sá mamá mazyi ázyí waa Ishaya ándówyapyɛ̀ zɛ̀ lá ú lò kà zyíbyɛ̀, yi zɛ̀ la,</para>
  <para style="q1" vid="MAT 8:17">&lt;&lt;Áhu vodia lò'i wútòtò lòdɔ</para>
  <para style="q2" vid="MAT 8:17">ma lò'i dōdì tɛ̄ zumyɛ̄.&gt;&gt;<verse eid="MAT 8:17" /></para>
  <para style="s1">Wándó Wàzɛ̀ la, Wa hwoi Bē Yesu ní lá</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Dédēwaa Yesu wya panku ndàbè lò'u tábílíkā lá, u yí wátú'a nū mazyi wákyanú ya zyɛ̄. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Yiibeli ándótà Dɔ̀ Musa bē dò'u ma zɛ̀ la, &lt;&lt;Andótàwú, m ngyi be'oní yi ya bē sásá waa o ma ya ní.&gt;&gt;<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Yesu zɛ̀ yí'u la, &lt;&lt;Abɛ́fubyɛ́ bā shī waa wa hwoi ná ní, ányī wàyi pē yii dɔ bā ndō, dedee Ango Panku bā bē wàlò ishina hwāní yɔ̀.&gt;&gt;<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Ápazu yi tú zɛ̀ la, &lt;&lt;Wàsèndo, ḿ ya lò ada'm zyì pùnū.&gt;&gt;<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Dedee Yesu zɛ̀ yí'u la, &lt;&lt;Be'mni, mazyi ó me wándó wàhuuhu ní wálò wándó wàhūùhū'wa zyì.&gt;&gt;<verse eid="MAT 8:22" /></para>
  <para style="s1">Yesu yí Áwɔ̀fyù lò pà Sāli</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Yesu lò kà fu kɔ̀, áwátu'a lò be'uni. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Mamá kin wa wya áwɔ̀ fyù wàshuwɔ̀ dà yiifu núkù, yimamala ányázyà né yi gbòkyā kɔ̀. Dedee Yesu gɛ̀ lò náná. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Áwátú ya dò'u ma lò'u zèná, wa hwoi zɛ̀ la, &lt;&lt;Adando, lò'i tɛ̄ la, i lò yi hu!&gt;&gt;<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Yesu zɛ̀ yí'wa la, &lt;&lt;Awuni wándó zyíbyɛ̀ wàtítíìntí, áyɛ̄ sá waa ni hwoi sázī ní?&gt;&gt; Yiibeli u dàdɔ ma yi áwɔ̀ wa nyázyà nū wàsā li, áwɔ̀ wa nyázyà lò pà.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Agbashu lò panku pà, wa hwoi mbyēshé la, &lt;&lt;Āchɛ̄ panku wànī yi lá? Kwā áwɔ̀ wa nyázyà hwoi sá wú waa u zɛ̀ lá!&gt;&gt;<verse eid="MAT 8:27" /></para>
  <para style="s1">Yesu Lò Zyɔ̀ Ká Zumyɛ Yii Dì Wánù Ipyɛ</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Dédēwaa Yesu lò kyā bà zyɛ̄ zyoku Áwágadara lá, u gbàyi wa wánù ápà ipyɛ wàzu bé mbélā lá. Wánù hwoila bā zyɔ̀ ma hwoi wándó sá shà hwoi ngāngɛ̄ wa nɔ́nɔ̄ lá, ápanku hwoi zū nyashɔ li yɔ̀. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Kin wa gbá lò kito sèni la, &lt;&lt;Ango Shidɔ, áyɛ̄ waa o yi fú yii bé'i ní? O bē wàtà'i fyì gbógbó bà dédē waa Shidɔ shē lá ní?&gt;&gt;<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />U gbā nāshɔ̄ wa beli yɔ̀, àbè luma buu hwoi zyī. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Àzyɔ̀ hwoi vá Yesu la, &lt;&lt;O ma lò'i ká zumyɛ ní, lò'i sù dó fu bè luma hwoi má.&gt;&gt;<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Yesu zɛ̀ yí'wa la, &lt;&lt;Ni ya!&gt;&gt; Yimamala wa zumyɛ ma ya kà fu bè luma. Sásá bè luma hwoila shìshɔ̀ tòlī yii nū búwà ya kàfu núkù ma hwo hu yiifu lape.<verse eid="MAT 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33" />Áwándó pyō luma hwo shè ya fu gá, ma lò zyí sásá gbòtà wa wú wàkwò wa wánù ipyɛ hwoila wàbā zyɔ̀ lá. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Yiibeli sásá panku wàhwoi gá lá zumyɛ mazyi wáya dò Yesu. Waa wa wya'u lá, wa vá'u mazyi ú me zyoku'wa ní.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s1">Yesu lò Wánù zū wàhu zédì dàgba</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Yesu kà kɔ̀ ma kyānú kàsɛ̄ ya'a Kapernaum gándō'a. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Wánù wándó wànati lò wánù zū wàhu zédì be yí'u, ná yiibe shō. Waa Yesu wya byɛ̀ waa wa bā lá, u zɛ̀ yí ndó wàhu zédì lá la, &lt;&lt;Ngōnwú ngo, wa lò wúwàbɛbɛ'o gbā'ozyɔ̀.&gt;&gt;<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Waa áwándó tà Dɔ̀ Musa fá mamá lá, wa zɛ̀ yí diwa la, &lt;&lt;Apà lá magbɔ̄ wa Shidɔ!&gt;&gt;<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Yesu lò zyíhwɛ̀wàgàgà'wa yìkyà lá, u zɛ̀ la, &lt;&lt;Áyɛ̄ sá waa ni hwoi gàzyíhwɛ̀ bɛbɛ mamá ní? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Wàni kàdì yɔ̀ ní? Wàzɛ̀ la, &lt;Wa lò wúwàbɛbɛ'o gbā'ozyɔ̀, kwɛɛ wàzɛ̀ la, dàdɔ mazyi ó kyēkyū lá ní&gt;? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Yimamala m ngyi tà'ni la, Ángo Panku bā gbā yii bēèmyɛ̄ wàgbāzyɔ̀ wúwàbɛbɛ.&gt;&gt; Yiibeli u zɛ̀ yí ándó wàhu zédì lá la, &lt;&lt;Dàdɔ, lò shō'o pè mazyi ó ya ndō!&gt;&gt;<verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />Yiibeli, ápà lá dàdɔ ma ya'a ndō. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Waa panku ndàbè wya wú li mamá lá, ázī lò'wa pà, wa ngyā Shidɔ, wàyi yí panku ágba mamá lá.<verse eid="MAT 9:8" /></para>
  <para style="s1">Yesu bá Matu ndɛ̀</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Dédēwaa Yesu me beli ní ma kyēkyū yi ya lá, u wya ndópàgbā, àzyì'a zyī la, Matu, shí yii futá kolo'a wàpà gbā. Yesu zɛ̀ yí'u la, &lt;&lt;Be'm ní,&gt;&gt; Matu dàdɔ ma lò bē'u ní.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Waa Yesu yi zyī wúzyī wànyizɔ̄ yii ndō Matu lá, áwándó pà gbā ndàbè, wa áwándó sá wúwàbɛbɛ bē shí wa Yesu wa áwátu'a yiibe wúzyī. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Waa Áwáfaris wya wúli mamá lá, wa mbyē áwátu'a shé la, &lt;&lt;ishina yɛ̄ waa ándótàwú'ni lá yi zyī wúzyī wa áwándó pà gbā wa áwándó sá wúwàbɛbɛ ní?&gt;&gt;<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Yesu fá zyí'wa ma zɛ̀ la, &lt;&lt;Áwándó wàhwoi tòwú yɔ̀ lá, hwoi hwāzú ándósáfyī yɔ̀, dedee ákèké wándó wàhwoi tòwú lá, gbaa hwoi hwāzú ní. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Tàma ni ya fyé átɛ́ zyí Shidɔ wàtāàtā zɛ̀ la, &lt;Azúshīshī waa m ngyi fú ní, gba yi wúpyō wàgé ma pyāndɛ̀ yɔ̀. Dizyi m gbā bē ishina wàbá wándó wàhwoi sá wúwàsàsà lá yɔ̀, dedee m bē ishina wándó wàhwoi sá wú wàbɛbɛ lá.&gt;&gt;<verse eid="MAT 9:13" /></para>
  <para style="s1">Ashé Wàmbyēèmbyē ishina Nūwàsèsè</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Yiibeli áwátu Yohana wàyi sá batisma lá bē mbyē Yesu shé la, &lt;&lt;Mamánī waa áwi'i wa Áwáfaris hwoi sènū, waa áwátu'u hwoi sènū yɔ̀ ní?&gt;&gt;<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Yesu zɛ̀'wandɛ̀ ní la, &lt;&lt;O yi wya sáyìna áwápàkyù wàhwoi bé dùdù wàsèbā lá hwoi bɛ̄nwú kwāwaa ànùwàpyoo wa'wa hwoi dùdù lá? Yi byɛ̀, wa hwoi bɛ̄nwú yɔ̀! Dedee ányunu yi bē waa wa lò nùwàpyoo yi lòdɔ me'wa ní má, wa pi hwoi sènū ní.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />&lt;&lt;Apazukponu lò túkpá wàpyoo yi kwà bē bé wúkɛ̀ wàkwɔ̄ wàyàyà lá yɔ̀, dizyi túkpá wàpyoo lá, lò yi vyì ma lò wúkɛ̀ wàkwɔ lá yi yà kāgbá wàndii lá. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Kwɛɛ mazyi pazu u pi lò zyàbā wàpyoo wè fu kwɛ̀ wàkwɔ̄ yɔ̀. Wa ma sá mamá, àkwɛ̀ lò yi tábwà, àzyàbā lò yi nyámbyɛ́, àkwɛ̀ lò yi sábɛ̄. Wa ma lò zyàbā wàpyoo wè fu kwɛ̀ wàpyoo, àkwɛ̀ wa zyàbā hwoi sá wúzu yɔ̀. &gt;&gt;<verse eid="MAT 9:17" /></para>
  <para style="s1">Angu wáwà wàlò hu wa wà wà fá vyā yɔ̀</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Yesu kà yiifu zyí wàzɛ̀zɛ̀'a, ádóshī tá wànyɛnyɛ be kàli yii pyɛ̀'a ma yi zɛ̀ la,&lt;&lt; angu'm lò hu tama yiinì. Dedee be gwà'uvo yii dì, u lò yi dà&gt;&gt; <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Yesu lò dàdɔ ma wa'u dóbá, wa áwátu'a.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Yiibeli kin àwàzu wà dazyɛ̀ dɛ idezepyɛ̀ lá zu niki'a ma be gwà'uvo yii nū túkpá'a. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />U zɛ̀ wa di'a la, &lt;&lt;Nyunu waa m ma gwà'uvo yii nū túkpá'a kɛ̀ló, áwútòtò'm lò yi kɛ̀.&gt;&gt;<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Yesu vekà zu ma wya'u ma zɛ̀ la, &lt;&lt;Lò nwú gba, ango, ázyíbyɛ̀'o lò'o tɛ.&gt;&gt; Yiibebeli wútòtò àwàlá lò kɛ̀.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Dédēwaa Yesu lò fè ndō dóshī ma wya wándó nwɛ̄ tufɛ̀lɛ́ wa bè panku hwoi shèki lá, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />u zɛ̀ la, &lt;&lt;Ni dàdɔ yii maa, anguwáwà lá hu yɔ̀, u yi náná.&gt;&gt; Wa vye'uvyū. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Wa lò bè panku ká ya myɛ bwā lá, u kà fu ma pà nguwáwà li vo, u dàdɔ. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Ashévyā lá kà zyokuli sásá .<verse eid="MAT 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Yesu me beli ni, Àbòzú ápà ipyɛ̀ lò be'uni, wa kito la, &lt;&lt;Wya shishi'i, Ango wu Dawuda!&gt;&gt;<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Yesu lò kà ndō zu, Àbòzú hwoila be dò'u, u mbyē'wa shé la, &lt;&lt; Ni zɛ̀ndɛ̀ la, m bā gba wàyi dàgba ni kà?&gt;&gt;Wa zɛ̀ yí'u la,</para>
  <para style="p" vid="MAT 9:28">&lt;&lt;Eba, Adandō,&gt;&gt;<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Yiibeli Yesu gwà'wa vo yii zú ma zɛ̀ la, &lt;&lt;Yiishina byɛ̀ ni lá ázú'ni ú lò pò&gt;&gt;; <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Ázú'wa lò pò. Yesu bwà'wa vo, kà bwà'wa vo la, wa ká zɛ̀ yí pazukponu yɔ̀ <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Dedee wa ya zɛ̀ zyí'a yii zyokuli sásá.<verse eid="MAT 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Dédēwaa Yesu wa áwátu'a hwoi zumyɛ lá, wa lò wánù zu wàbā zyɔ̀ yi zɛ̀ zyí yɔ̀ be dò Yesu. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Dédēwaa Yesu lò zyɔ̀ ká yii dì pàli wàyi zɛ̀ zyí yɔ̀ lá, u dà zyí zɛ̀zɛ̀. Agbashu lò àbè panku pà wa hwoi zɛ̀ la, &lt;&lt;I wya wúzu mamá yii Isrela nyunzu ló yɔ̀&gt;&gt;<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Dedee Áwáfaris zɛ̀ la, &lt;&lt;Aku wu zyɔ̀ gbaa yí'u gba wà ká zyɔ̀ ni.&gt;&gt;<verse eid="MAT 9:34" /></para>
  <para style="s1">Yesu Wyashishi panku</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Yesu dà kyū vekà gáwàshuwɔ̀ wa gáwàti, u yi tà wa wú yii táwàkwāshī 'wa, u yi dádɔ̀ zyí Shidɔ wàsàsà àwu chɔ̀ wàyii dɔ lá, ma dàgba wútòtò kɛ-kɛkɛ wa wándó wàfá vyā yɔ̀ lá. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Dédēwaa u wya bè panku lò kādɔ lá, ázúshishi'wa lò'u pà, dizyi wa wya fyì ma dò pà wàsázá'wa ní yɔ̀, sáyìna dɛ̀ wàbā ndó wàyi pyō yɔ̀. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Yiibeli Yesu zɛ̀ yí áwátu'a la, &lt;&lt;Áwúzyī wàbēèbē buu, áwándó sá kolo buu yɔ̀. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Yimamala ni vá Adandō wàyi be wúzyī lá mazyi u sù wándó kolo kà fu dā'a mazyi wa lò wúzyī bē.&gt;&gt;<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s1">Yesu shē áwátu idezepyɛ̀</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Yesu bā áwátu'a idezepyɛ̀ ndɛ̀ ma yí'wa gbā wàká nidi wàbɛbɛ mazyi wa dàgba sásá wútòtò wa wándó wàfá vyā yɔ̀ lá.<verse eid="MAT 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2" />Àzyì wánù idezepyɛ̀ hwoila gbaa hwoi nì: ándó wàkɛ́pyɛ̀, yi Siman (waa wa bá'u la, Bitrus) wa ngoyī'a Andrawus, Yakubu yi ngo wu Zebedi, wa ngoyī'a Yohana, <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Filip wa Batolomi, wa Tomas, wa Matu hwoi wándó pà gba, wa Yakubu ngo wu Alfaus, wa Taddaeus; <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />wa Siman Ndó wàshó gá'a, wa Judas ndó wàlò Yesu kpáti lá. <verse eid="MAT 10:4" /><verse number="5" style="v" sid="MAT 10:5" />Apanku idezepyɛ̀ hwoila Yesu gbò'wa chɔ̀ ma bwà'wa vo lá, &lt;&lt;Ni káwa kà fu panku wàhwoi Áwáyahuda yɔ̀ lá, ni káwa kà fu gá zukponu àwu Samariya yɔ̀. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Ni ya bé dɛ̀ àwu Áwáisrela wàhwo mìzyɛ̀ lá. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Ni ya mazyi ni dádɔ̀ zyí Shidɔ yí'wa la, &lt;Achɔ̀ wàyii dɔ lá lò be bà'izɔ ló.&gt; <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Ni lò wándó wàfá vyā yɔ̀ lá dàgba, ni yí wándó wàhuuhu wá dàdɔ, wándó wà bā wútòtò gàhwɔ̄ dì, ni lò'wa dì tō, ni ká zyɔ̀ zumyɛ. Nùchɔ̀ waa ni dò ní, nùchɔ̀ waa ni kà hwoi yí ní. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Ni káwa pà shɔ́wànyànyà kwɛɛ shɔ́wàmòmbò kwɛɛ shɔ́dìmwú ni lò dó dì'ni yɔ̀; <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />ni káwa ya kyu lá wa ndú yɔ̀, kwɛɛ wúkɛ̀ ipyɛ̀ yɔ̀, mazyi ni pi ya wa tābá kwɛɛ kutɛ̀ yɔ̀; dizyi ápà wàyi sá kolo lá, yi dāhwɛ wúzyī wa be wàná ní yii bé wándó waa u yi sá'wa kolo lá yɔ̀. <verse eid="MAT 10:10" /><verse number="11" style="v" sid="MAT 10:11" />Sásá gáwàshuwɔ̀ kwɛɛ gáwàti waa ni ma kàni ní, ni hwāzú panku wàbā byɛ̀ mazyi ni shí wa'u gbógbó bà nyunu waa ni kà hwoi me beli ní lá. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Nyunu waa ni ma hwoi kà ndō ní, ni zɛ̀ la, &lt;Anwúkwòli ú shí wa'ni.&gt; <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Nyunu waa ndōli ma pà'ni kyù ní, anwúkwòli'ni ú shí ní; nyunu waa wa ma pà ni kyù yɔ̀ ní, ni yí nwúkwòli'ni ú kàsɛ be dò'ni. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Sásá pà wàma pà'ni kyù yɔ̀ kwɛɛ ma nghà wà fá zyí'ni ní, ni lò mwú bá'ni dáàdá dédēwaa ni ma hwoi zumyɛ yiifu ndōli kwɛɛ yiifu gáli. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />M ngyi zɛ̀ yí'ni zyíbyɛ̀ la, nyunu wà hwàkwɛ́ Shidɔ yi wyashishi Sodom wa Gomorra yi kā panku wàhwoi gáli lá ní. <verse eid="MAT 10:15" /><verse number="16" style="v" sid="MAT 10:16" />M ngyi gbò'ni chɔ̀ hwoi zumyɛ sáyìna dɛ̀ wàhwoi fu vyìvyìjɔ lá, yimamala ni lò kà wándó zúbyɛ sáyìna wusu, ni lò kà wándó wà hwoi hwā zyí yɔ̀ sáyìna ndàkpò.<verse eid="MAT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 10:17" />&lt;&lt;Ni pà di'ni wa panku, dizyi wa lò ni hwoi chá ya pyɛ̀ wacha'wa ma hwoi gyógá'ni wa yō yii táwàkwāshī'wa. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Kà yiishina zyí'm, wa hwoi chá'ni hwoi ya pyɛ̀ áwádoshi wa áwáku, mazyi ni zɛ̀zyí wàsàsà yí'wa wa wándó wàhwoi wá wúhwɔ̀ lá. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Nyunu waa wa ma lò ni pà, ni káwa wèbēbè la, áyɛ̄ waa i hwoi zɛ̀ ní kwɛɛ i hwoi zɛ̀ zyí li mamáni ní yɔ̀. Dizyi nyunuli ma be, ni hwoi dò wú wàzɛ̀zɛ̀, <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />dizyi áwuni gbaa hwoi zɛ̀ zyíli ní yɔ̀, Anidi Ada'ni gbaa yi zɛ̀ zyíli yi zu nū'ni ní.<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />&lt;&lt;Angoyī lò ngoyī yi lò yí wa lò'u yi bwā, ada dedee lò ngo'a yi lò yí; ázyē dedee hwoi dà shinagba wa wándó wàmbà'wa lá ma yí'wa lò wa hwoi bwā. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Sásá panku hwoi zé'ni yiishina'm, dedee ápà wàma sāli gbakpo gbógbó ya nyunu wàkenū ní, u yi dò nwàzū. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Nyunuwaa wa ma tà'ni fyì yii be waa ni hwoi ní lá ní, ni lò shè ya bezu kɛkɛ. M ngyi zɛ̀ yí'ni zyíbyɛ̀ la, gbógbó ni lò gá Isrela tabilika bwā lá, Ango Panku yi be.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />&lt;&lt;Atú yi kāgbá ndo wàyi tà'uwú lá yɔ̀, ànyà yi kāgbá wàsendo'a yɔ̀. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />U lò sā gyegye mazyi tú ú lò kà sáyìna ndó wàyi tà'uwú lá ló, ànyà ú lò kà sáyìna wàsèndo'a. Nyunu waa wa ma lò wàsendo bá la, Bilzebub ló, apanku wàhwoi fu ndō lá wa hwoi bá'wa zyì wàbɛbɛ kā mamá!<verse eid="MAT 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />&lt;&lt;Yimamala ni káwa sázī yɔ̀. Dizyi áwú wàchùchù waa wa lò'u yi pò yɔ̀ lá yiiní yɔ̀, áwú wàyùyò waa wà hwoi yìnɔ̀ yɔ̀ lá yiiní yɔ̀. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Áwú waa m ngyi zɛ̀ yí'ni yiifu fēsè lá, ni zɛ̀ nyitò; áwú waa m ngyi zɛ̀ kyókyó yii chùchú'ni lá, ni lò dádɔ̀ yii shitónā. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Ni káwa sázī wándó wà lò dì yi bwā ma hwoi bwā nwú kà yɔ̀ lá yɔ̀. Nyemgba ni sázī Shidɔ wàyi zyìchù nwú wa dì yii ndō pyù lá. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />M zɛ̀ la, ányī wàtítíìntí ipyɛ̀ gbaa yi banji wàtítíìntí ní yɔ̀? Dedee yiifu'wa zukponu ma kwèkwè yii zyoku Ada yi yìnɔ̀. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Kwā zyí ishina'ni sásá hwɛ̀hwɛ̀. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Yimamala ni káwa sázī yɔ̀; áhwɛ̀'ni kāgbá wu nyī buu.<verse eid="MAT 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />&lt;&lt;Sásá pà wàma tà di'a yii pyɛ̀ panku la, u yi wum, ami dedee m ngyi tà'u yii pyɛ̀ Ada wà yii dɔ lá. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Sásá pà wàma gɛ̀ kà nghà'm yii pyɛ̀ panku ní, ami dedee m ngyi nghà'u yii pyɛ̀ Ada wàyii dɔ.<verse eid="MAT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />&lt;&lt;Káwa gàzyíhwɛ̀ la, m be mazyi bēèmyɛ̄ ú dò nwúkwòli ni yɔ̀mbo. Aayì, anwúkwòli waa m chá be ní yɔ̀, m be wà hwāzyí. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />M be mazyi</para>
  <para style="q1" vid="MAT 10:35">&lt;&lt;ázyēwánù wálò da'wa hwāpyɛ̀ wa zyí,</para>
  <para style="q2" vid="MAT 10:35">ázyēwáwà wálò yī'wa hwāpyɛ̀ wa zyí,</para>
  <para style="q1" vid="MAT 10:35">áwáwà àwu zyē wálò áwáyī àwu nù'wa hwāpyɛ̀ wa zyí,<verse eid="MAT 10:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="MAT 10:36" />dizyi àwàzé panku yi zu fu ndō'a.&gt;<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />&lt;&lt;Áwándó wàshó da'wa wa yī'wa kā'm lá, gba kē wàhwoi áwátu'm yɔ̀, áwándó wàshó ngo'wa wàwūnù kwɛɛ ángù'wa wàwūwà kā'm lá, gba kē wàhwoi áwátu'm yɔ̀, <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />áwándó wàkōlò fyī'wa ma be bákyū'm ní yɔ̀ lá, gba kē wàhwoi áwátu'm yɔ̀. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Áwándó wàhwoi ngā mazyi wá kó nwú'wa lá, hwoi sáfyì nwú'wa, dedee wándó wàsáfyì nwú'wa ishina'm lá, hwoi dò nwú wàgbógbó.<verse eid="MAT 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />&lt;&lt;Apà wàma zɛ̀ndɛ̀ wa'ni ní, u zɛ̀ndɛ̀ wa'm mánì, ápà wàma zɛ̀ndɛ̀ wa'm ní, u zɛ̀ndɛ̀ wa ándó wàgbò'm be lá mánì. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Apà wàma zɛ̀ndɛ̀ wa ándówyàpyɛ̀ ishina u yi ndówyapyɛ̀ lá ní, u yi dò sɔ̀ wu ndówyapyɛ̀. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Apà wàma yí pàzukponu ágè lape wàtashuma yiishina wa hwoi áwátu'm lá ní, m ngyi zɛ̀ yí'ni zyíbyɛ̀, u yi sáfyì yɔ̀.&gt;&gt;<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s1">Áwándózɛ̀chɔ̀ Àwu Yohana Andó sá Baptisma</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Dédēwaa Yesu lò zyí zɛ̀ bwā wa áwátu'a idezepyɛ̀ lá, u dàdɔ yii beli ya pyɛ̀ mazyi ú tàwú, ú kà dádɔ̀ zyí Shidɔ yiifu gá wàhwoi Galili lá. <verse eid="MAT 11:1" /><verse number="2" style="v" sid="MAT 11:2" />Dédēwaa Yohana yiifu táfyì ma fá wú waa Kristi yi sá lá, baptisma u chō áwátu'a ya <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />mbyē'ushé la, &lt;&lt; Áwo gbaa yi ndótɛpa waa Yohana ndó sá baptisma zɛ̀ la, u yi bē lá kwɛɛ í lò zú hwali yiishina pàzu kɛkɛ ní?&gt;&gt; <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />Yesu zɛ̀ yí'wa la, &lt;&lt;Ni kàsɛ ya zɛ̀ yí Yohana wú waa ni fá ma kà wya lá: <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Abòzú hwoi wyabe àkábá hwoi kyēkyū, wándó wàbā wútòtò gàhwɔ̄dì lá áwútòtò'wa lò kɛ̀, akochu hwoi fá zyí zɛ̀zɛ̀, áwándó wàhūùhū hwo dà, áwándó chɛ̀ fá dɔ̀wàdáàdá àwu shévyā wàsàsà. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Ánwúmbòmbò yi wu ápà wàyi mɛ̀nwú ishina'm yɔ̀ lá!&gt;&gt; <verse eid="MAT 11:6" /><verse number="7" style="v" sid="MAT 11:7" />Dédēwaa áwátu Yohana hwoi ya'wa lá, Yesu pi dà zyí Yohana wàzɛ̀ yí bèpanku la, &lt;&lt;Áyɛ̄ waa ni zumyɛ mazyi ni ya wya yii sáchɔ́ ní? Ni ya wya byɛ́ waa wɔ̀ yi sā'wa hwoi hwò lá kwɛɛ? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />U ma yi mamá yɔ̀, áyɛ̄ waa ni zumyɛ ma ya wya ní? Áwánù mbyadì wa túkpá wàsàsà? Aayì, áwándó wàhwoi wè wúchɛ́ wàsàsà lá, hwoi sukpa ku. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Lá yɛ̄ waa ni ya wya yii myɛ ní? Andówyapyɛ̀? Eba, ḿ zɛ̀ yí ni, u kāgbá ndówyapyɛ̀ buu. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Ahu waa zyí'a tāàtā yiifu fā yi zɛ̀ la,</para>
  <para style="q1" vid="MAT 11:10">&lt;&lt;M ngyi chō ndózɛ̀chɔ̀'m chɔ̀ yi kɛ́pyɛ̀ yí'o,</para>
  <para style="q2" vid="MAT 11:10">ándó wàlò nyàshɔ'o yi mbyā dɛ̀dɛ̀ bà zú'u lá.<verse eid="MAT 11:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11" />Ḿ zɛ̀ yí ni zyíbyɛ̀! Yiifu mbàmbà wáwà, Yohana ndó sá Baptisma lá kā'wa sásá ní, dedee ándó wàzōnwū kā yiifu ndochɔ̀ wu Shidɔ lá, kā'u ní. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Dà yiifu dédē wu Yohana ándó sá Baptisma lá be tama, àchɔ̀ wu Shidɔ yi wya fyì wa ngɛ̄, ápanku wàbɛbɛ fú lò chɔ̀ wu Shidɔ fyé. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />gbógbó mazyi Yohana ndó sá baptisma ú bē lá, wándówyapyɛ̀ wa dɔ̀ wu Musa zɛ̀zyí yiishina chɔ̀ wu Shidɔ . <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Nyunu waa ni ma hwoi zɛ̀ndɛ̀ wa ázéchɔ̀'wa ní, Yohana gbaa yi Iliya waa wa zɛ̀zyí'a la, u yi be lá ní. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Ápà wàma bā chùchú wàfá ní, ú fá.<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />&lt;&lt;Wa yɛ̄ waa m ngyi lò panku wàtama ya yi sé wa'u ní? Wa hwoi sáyìna zyetifyi wà hwoi zyízyó yi fīfí ti, hwoi bá bugɛ zyó'wa ndɛ̀ la,<verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />&lt;&lt;I mwɛ̀ tufɛ̀lɛ́ yí'ni,</para>
  <para style="q2" vid="MAT 11:17">ni nghà wa gbòzyó;</para>
  <para style="q1" vid="MAT 11:17">I chòvyū ki</para>
  <para style="q2" vid="MAT 11:17">ni nghà wàshèki.&gt;<verse eid="MAT 11:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18" />Dédēwaa Yohana be lá, u yi zyī buu yɔ̀, u yi wā zyàwā buu yɔ̀, dedee wa zɛ̀ la, &lt;U bā nídì wàbɛbɛ.&gt; <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Ango Panku be ma yi zyī, ma yi wā, wa zɛ̀ la &lt;Wya ndó zyī wúzyī buu, ándó wā zyàwā buu, àbugɛ wándó pà gbā wa &lt;&lt;wándó sá wúwàbɛbɛ.&gt;&gt;&gt; Dedee áyìyì wu Shidɔ yi tà di'a yii bé wúsáàsá'a.&gt;&gt;<verse eid="MAT 11:19" /></para>
  <para style="s1">Àgá Wàmbyā beshí'wa yɔ̀ lá</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Yiibeli Yesu hwa áwágáwashuwɔ̀ hwoila nū dizyi u sá wugbashu'a buu yiifu'wa, dedee wa me wúwàbɛbɛ'wa ní mazyi wa mbya beshí'wa yɔ̀. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />Yesu zɛ̀ la,&lt;&lt;Shàmákɛ̀ló, ápanku wu Korazin! Shàmákɛ̀ló, ápanku wu Betsayida! Wa ngaa zɛ̀ la, áwúgbàshú waa m sá yiifu'ni lá, yii Áwátaya wa Áwábasayida ní, wa ngaa hwoi mbyā beshí'wa nashɔ-nashɔ wa wúkɛ̀ wàshúki wa chúpyù pwò dì. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Dedee m ngyi zɛ̀ yí'ni, anyunu wàhwàkwɛ́ Shidɔ yi wyashishi panku wàhwoi Áwátaya wa Áwásidon yi kā'ni ní. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Áwo Kapernaum, o yi fú ú lò'di'u dɔ gbógbó ya gwà dɔ? Aayì, o yi kà pyù. Wa ngaa zɛ̀ la, áwúgbàshú wàsá yiifu'u lá, sá yii Sodom ní, ú ngaa kà yiiní bà zyina. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Dedee m ngyi zɛ̀ yí'ni, anyunu wàhwàkwɛ́, Shidɔ yi wyashishi Sodom lá, yi kā'ni ní.&gt;&gt;<verse eid="MAT 11:24" /></para>
  <para style="s1">Ni be Be'm Mazyi ni dó Nghànwū</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Yiifu kyūli Yesu zɛ̀ la, &lt;&lt; M tá'o mamgba, Ada, Adandō wà yii dɔ wa bēèmyɛ̄ lá, dizyi o lò wú wàhwoila yìyò yii bé wándó wàbyɛzu wa wándó wàbā yìyì, ma lò pòfā tà zyetifyi wàtiti. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Eba, Ada, áwú wàsàsà vyā'odì lá mánì. <verse eid="MAT 11:26" /><verse number="27" style="v" sid="MAT 11:27" />Ada'm lò wúsásá ndavo yí'm. Apazukponu yì Ngoli yɔ̀, Ada tanwú'a gbaa yì'u ní, apazukponu kàwa yì Ada yɔ̀, Angoli tanwú'a wa ándó waa u shē mazyi ú lò pòfā tà'u lá.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />&lt;&lt;Ni be bé'm, sásá wuni wándó wà hwoi wya fyì wa wúchɛ́ wàndabɔ lá, m ngyi yí'ni nghànwū. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Ni lò gyūnūnɛ̀'m sè dini ní, mazyi ni fyé wú yii bé'm, dizyi m ngyi ndózyínyà yɔ̀ ma yi ndóshina lòdɔ yɔ̀ yiifu nidi, ni kà hwoi nghànwū yiifu nwúdì'ni. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Àgyūnūnɛ̀'m patashi, áwúchɛ́ waa m ngyi sèni ní lá gba ndabɔ yɔ̀.&gt;&gt;<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s1">Nyunu Wànghànwū</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Nyunu wànghànwū Yesu wa áwátu'a hwoi kyēkyū yiifu dā àwu áwá. Ámbɔ̄ lò kāgbá áwátu'a dɔ lá, wa nwá ngyì áwá ma hwoi jɔ̄. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Dédēwaa Áwáfaris wya mamá lá, wa zɛ̀ yí'u la, &lt;&lt;Wya! Áwátu'u hwoi sá wú waa dɔ̀ wade lá yiifu Nyunu Wànghànwū.&gt;&gt;<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />U zɛ̀ yí'wa la, &lt;&lt;Ni zɛ̀ fā wú waa Dawuda sá dédēwaa u wa áwábugɛ'a ámbwɔ̄ lò kāgbá'wa dɔ lá yɔ̀? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />U kà fu tá Shidɔ, ahu wa áwábugɛ'a lò wúzyī waa wa sá Shidɔ sɔ̀ lá zyī, nyemgba waa u shìshè yiibe Dɔ̀ mazyi wá zyī wúzyī lá, ákèké áwádakumbwa gbaa hwoi zyī ní. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Kwɛɛ ni zɛ̀ yiifu dɔ̀ wu Musa ló yɔ̀, yiifu Nyunu Wànghànwū àwu áwádakumbwa yii táwàwáshidɔ hwoi sádà dɔ̀ wu Nyunu Wànghànwū, dedee u yi wúwàbɛbɛ waa wa sá ní yɔ̀? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />M ngyi zɛ̀ yí'ni la, ándó wàkāgbá Táwàwáshidɔ lá yi maa. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Ḿ ngaa zɛ̀ la, ni yì sɛ̄ zyí wa fá wu Shidɔ zɛ̀ mamá lá dedee&lt;M ngyi fú ni wya shishi di'ni, ni ká lò di'ni hwā kpɔ́kɔ̀ yɔ̀,&gt; Ni ngaa yì tɛ́ zyí lá ní, panku wàma sá wu wàbɛbɛ yɔ̀, ni ngaa hwoi hwà'ukwɛ́ yɔ̀. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Dizyi Ango Panku gbaa yi Adandō wu Nyunu Wànghànwū ní.&gt;&gt; <verse eid="MAT 12:8" /><verse number="9" style="v" sid="MAT 12:9" />Yesu me beli ní lá, u lò kà táwàkwāshī'wa, <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />apazu yii beli hu vo. Wa hwoi hwāzú nyashɔ wàkpō Yesu bī lá, wa mbyeshé la, &lt;&lt;Àdɔ̀ wu Musa zɛ̀ndɛ̀ mazyi wa dàgba yiifu Nyunu Wànghànwū?&gt;&gt;<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />U zɛ̀ yí'wa la, &lt;&lt;Nyunu waa pàzu'ni ma bā dɛ̀ u ma ya kwèkwè yii fushi yiifu Nyunu Wànghànwū, o yi pà'u ma lò'u yi tɛ zumyɛ yɔ̀? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Áhwɛ̀ panku kāgbá wu dɛ̀ buu! Yimamala o ma sá wú wàsàsà yiifu Nyunu Wànghànwū ní, u bɛbɛ yɔ̀.&gt;&gt;<verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />Yiibeli u zɛ̀ yí pàli la, &lt;&lt;Ndafa vo'o.&gt;&gt; Yimamala u ndafa vo'a, avo'a lò kàsɛ be gyegye sáyìna yiiyi waa vo'a zu yi lá. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Dedee Áwáfaris hwo dàdɔ ya myɛ ma nwāzyí wàlò Yesu bwā.<verse eid="MAT 12:14" /></para>
  <para style="s1">Ànyà Shidɔ Waa U Shē Lá</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Yesu lò yìkyà la, wa hwoi nwāzyí yiishina'a lá, u me beli ní. Apanku ndàbè be'uni, u lò wándó wàfá vyā yɔ̀ sásá lá dàgba, <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />ma bwà'wa vo mazyi wáká ya gbòtà zyí'a yí pazukponu yɔ̀. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />U sá mamá mazyi zyí waa Shidɔ zɛ̀ zu nū Ishaya ándówyapyɛ̀ lá ú lò kà yibyɛ̀ yi zɛ̀ la,<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />Ànyà'm waa m shē lá gbaa yiinì,</para>
  <para style="q2" vid="MAT 12:18">ándó waa m shó zyí'a, ma yi fá vyā'a lá;</para>
  <para style="q1" vid="MAT 12:18">M lò Nidi'm yi dó'u dì,</para>
  <para style="q2" vid="MAT 12:18">u yi dádɔ̀ zyíbyɛ̀ yí panku.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />U yi hwɛ̀nū kwɛɛ u yi dákito yɔ̀;</para>
  <para style="q2" vid="MAT 12:19">apazukponu yi fá huna zyí'a yii kpandala yɔ̀.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Akwákwɛ wàyi hwò lá, u lò'u yi téká yɔ̀,</para>
  <para style="q2" vid="MAT 12:20">àkyàngyà wàyi fú wàdɛ̄ɛ̀dɛ̄ lá, yi dɛ yɔ̀,</para>
  <para style="q1" vid="MAT 12:20">gbógbó u yi yí zyíbyɛ̀ yi zyībwe.<verse eid="MAT 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21" />Yiifu zyì'a lá waa panku sásá hwoi tɛnwú sè'uni ní.&gt;&gt;<verse eid="MAT 12:21" /></para>
  <para style="s1">Yesu wa Bilzebub</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Yiibeli wa chá pazu wà bā nídì wàbɛbɛ makà yi bòzú yi zɛ̀zyí yɔ̀ be dò'u, Yesu lò'u dàgba, u yi zɛ̀zyí ma yi wyabe. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Áwúli lò kà panku sásá wugbashu, wa hwoi zɛ̀ la, &lt;&lt; Ahu gbaa yi Ngo wu Dawuda ní?&gt;&gt;<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Dedee dédēwaa Áwáfaris fá mamá lá, wa zɛ̀ la, &lt;Bilzebub, aku nídì wàbɛbɛ gbaa yi'u gbā wà ká nídì wàbɛbɛ zumyɛ ní.&gt;&gt;<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />&lt;Yesu lò zyíhwɛ̀wàgàgà'wa yìkyà ma zɛ̀ la, &lt;&lt;Sásá chɔ̀ wàma lò di'a gàfā ipyɛ̀ ma hwoi ngangɛ wa di'wa u lò yi nyàdì, sásá gá kwɛɛ fumba wàma lò di'a gàfā ipyɛ̀ ma hwoi ngangɛ wa di'wa, u yi sāli yɔ̀. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Nyunu waa Angyefu ma ká Angyefu yi zumyɛ, u lò dia gàfā mánì. Àchɔ̀'a sáni ma pi yi sāli ní? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Nyunu waa m ma yi ká nídì wàbɛbɛ zumyɛ wa gbā wu Bilzebub ní, wa gbā wàni waa wándó ni hwoi ká'wa hwoi zumyɛ ní? Yimamala apanku'ni gbaa hwoi kà wándó hwàkwɛ́ ni. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Nyunu waa m ma ká nídì wàbɛbɛ zumyɛ wa Nidi wu Shidɔ ni gɛ̀, ni yìnɔ̀ la, àchɔ̀ wu Shidɔ lò bē bé'ni mánì. <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />Kwɛɛ ápà wàni yi kà ndō ndógba ma lò'u wúchɛ́ yi hwo kà ní, u lò ndógba yi dɛ̀ pùnū? Yiibeli ma pi yi vyú'uvyú yii ndō kà ní.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />&lt;&lt; &lt;Ápà wà ma yi wa'm yɔ̀ yi sá gàfà wa'm, kàwa sásá pà wà ma sázá'mni hwo kwazɔ yɔ̀, u yi shànyáshàshà. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Yimamala m ngyi zɛ̀ yí'ni la, sásá wúwàbɛbɛ wa zyíwàbɛbɛ waa panku yi zɛ̀ lá, Shidɔ yi meni, ápà wà ma zɛ̀ zyí wàbɛbɛ yiishina Nidi Wànyɛnyɛ, wa hwoi gbā'uzyɔ̀ yɔ̀. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Sásá pà wà ma zɛ̀zyí wàbɛbɛ yiishina Ngo Panku, wa hwoi gbā'uzyɔ̀, dedee, sásá pà wàma zɛ̀zyí wàbɛbɛ yiishina Nidi Wànyɛnyɛ, wa hwoi gbā'uzyɔ̀ yɔ̀, tama wa dédē wàyi be yii sɛ lá.<verse eid="MAT 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />&lt;&lt; &lt;Afyī wàsàsà yi nwā ngyì wàsàsà, afyī wàbɛbɛ yi nwā ngyì wàbɛbɛ, dizyi wa hwoi yìkyà fyī yii bé ngyì'a. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Awuni wusu, waa ni hwoi panku wàbɛbɛ lá ni sáni ma pi hwoi zɛ̀ zyí wàsàsà ni? Dizyi áwú wà lò nwú yi mwɛ̀ lá waa nū yi zɛ̀ ní. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Apà wàsàsà yi tɛ wú wàsàsà yi zumyɛ yiifu nwú'a wàsàsà, ápà wàbɛbɛ yi tɛ wú wàbɛbɛ yi zumyɛ yiifu nwú'a wàbɛbɛ. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Dedee m ngyi zɛ̀ yí'ni la, sásá panku wà hwoi zɛ̀ zyí wànùchɔ̀ yii nū'wa lá, anyunu wàhwàkwɛ́ wa hwoi hwɛ̀ wa nū'wa . <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Yii bé zyí nū'u waa o yi dò nwàzu ní, yii bé zyí nū'u waa o yi dò fyì ní.&gt;&gt;<verse eid="MAT 12:37" /></para>
  <para style="s1">Àsɛ̀ wu Yunana</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Yiibeli Áwáfaris wànati wa wándó tà dɔ̀ wu Musa zɛ̀ Yesu la, &lt;&lt;Ándótàwú, i hwoi fú í wya sɛ̄ wugbashu yii bé'o&gt;&gt;<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />U zɛ̀ yí'wa la, &lt;&lt;Ápanku wu dédē wàtama wàbɛbɛ bā zyíbyɛ̀ yɔ̀ lá hwoi mbyeshé àsɛ̀ wu gbàshú! Dedee wa hwoi dò yɔ̀, àsɛ̀ wú Yunana andówyapyɛ̀, waa m ngyi tà'wa ní. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Àwu Yunana lá u dò nyunu isa yii mufu zyé wàshuwɔ̀, yimamala Ango Panku dedee kà yi sá nyunu isa yiifu shī. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Nyunu li apanku wàhwoi Nineveh lá hwoi dàdɔ sādɔ yiibé kwɛ́hwàhwà wa panku wu dédē wàtama ma lò'wa hwoi zyī, dizyi wa me wúwàbɛbɛ'wa ní ma lò beshí'wa mbyā dédēwaa Yunana dádɔ̀ zyí Shidɔ yí'wa lá, tama ándó wàkā Yunana lá yii maa. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Nyunu wàhwàkwɛ́, Àwàku yii Byì yi dàdɔ sādɔ àwu kwɛ́hwàhwà wa panku wu dédē wàtama ma lò'wa hwoi zyī, dizyi u dà zu bewànashɔ mazyi ú fá zyí Solomon wa áyìyì'a, tama ándó wàkā Solomon lá yii maa. <verse eid="MAT 12:42" /><verse number="43" style="v" sid="MAT 12:43" />Dédēwaa nidi wàbɛbɛ ma zumyɛ yii dì panku, u yi ngyā yiibe wànwɔ̄ɔ̀nwɔ̄ ma yi hwāzú be wànghànwū, nyunu waa u ma dò yɔ̀ ní, <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />yiibeli u yi zɛ̀ la, &lt;M ngyi kà'msɛ ya tá waa m zumyɛ yii ní lá.&gt; Dédēwaa u ma lò kàsɛ ma wya tá yi nùchɔ̀, wàzàzà ma yúùyú ma mbyāàmbyā. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Yiibeli u yi kàsɛ ma ya yi hwo nidi wàbɛbɛ kāgbá wua lá isumpyɛ̀, ma hwoi kàni ya hwoi shí beli. Yimamala àdì pàlá wàtama lò yi bɛbɛ buu kāgbá wàkɛ́pyɛ̀ lá. Áwú wàyi kwò wa panku wàbɛbɛ àwu dédē wàtama lá mánì.&gt;&gt;<verse eid="MAT 12:45" /></para>
  <para style="s1">áyī Yesu wa Zyēyī'a</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Dédēwaa Yesu kà yiifu zyí wàzɛ̀zɛ̀ wa bè panku lá, áyī'a wa zyēyī'a be sā hwoi myɛ, hwoi gbavo mazyi wa zɛ̀ zyí wa'u. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Ápazu yii beli zɛ̀ yí'u la, &lt;&lt;Wya, áyī'o wa zyēyī'o sā hwoi myɛ hwoi gbavo wàzɛ̀zyí wa'o mánì<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />&lt;&lt;U zɛ̀ yí'u la, &lt;&lt; anɔ̄ yi yi'm ní? Áwá nɔ̄ hwoi zyeyi'm ní?&gt;&gt; <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />U tàvo jā áwátu'a ma yi zɛ̀ la, &lt;&lt;Wya, áyī'm wa zyēyī'm gbaa hwoi nì. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Dizyi ápa wàma sá wú waa Ada'm wàyii dɔ yi shó lá ní, áhu gbaa yi ngoyī'm, ma yi nguyī'm, ma yi yī'm ní.&gt;&gt;<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s1">Atɛ́káàká Yesu Yiishina Andónàchɛ̄wú</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Yiifu nyunu li Yesu zumyɛ yii ndō ma ya shí yii numgbe núkù, <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Abè panku gbayi buu ma lò'ú shèkwà lá, u lò kà fu kɔ̀ ma ya shí fu'a, apanku sásá gɛ̀ sā hwoi chīchɔ́. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Yiibeli Yesu zɛ̀ zyí buu wa tɛ́káàká yí'wa la, &lt;&lt; zu ya dā mazyi ú nà chɛ̄wú. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Yiiyi waa u yi nyá chɛ̄wú lá, āchɛ̄wú wànati hwoi kwèkwè yii nyashɔ, ányī be ma lò'wa zyī. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Wándówanati kwèkwè yii ishina gɔ́, yii be wàbā dɛ̀ buu yɔ̀. U nga mɔmɔ dizyi dɛ̀ li zùfu yɔ̀. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Dedee dédēwaa nyunu lò gbādɔ lá, wa lò fyù, ma kà lò nwɔ dizyi wa bā dú yɔ̀. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Āchɛ̄wú wànati kwèkwè yiifu sé, Asé nga ya dɔ ma lò'wa pyí. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Āchɛ̄wú wànati kwèkwè yii bé dɛ̀ wàsàsà, ma nwā ngyì wúzyī wàsàsà idipaichɔ, wànati idipaisa, wanati idizuzede kāgbá chɛ̄wú waa wa nyá lá. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Yesu zɛ̀ la, &lt;&lt;ápà wà ma bā chùchú wàfá ní, ú fá.&gt;&gt;<verse eid="MAT 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Áwátú'a be dò'u ma mbye'ushé la, &lt;&lt;Áyɛ̄ sá waa'o yi zɛ̀zyí wa tɛ́káàká yí panku ní?&gt;&gt;<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />U zɛ̀ yí'wa la, &lt;&lt;Áyìyì wú wàyùyò àwu chɔ̀ wàyii dɔ lá wa lò pòfā yí ni, dedee ma yí'wa yɔ̀. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Dizyi ándó wàbā lá, waa wa ká hwoi kwā'u ní buu ní, mazyi ú bā kē'u. Dedee ándó wàbā wúzu yɔ̀ lá, kwā wàtitinti waa u bā lá, wa lò yi fyé me'uni. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Áwú wàsá waa m ngyi zɛ̀zyí wa'wa wa tɛ́káàká lá gbaa yiinì:</para>
  <para style="q1" vid="MAT 13:13">&lt;&lt;Wa lò zú hwoi jā wú nyààh, dedee wa hwoi wyabe yɔ̀;</para>
  <para style="q2" vid="MAT 13:13">wa lò chùchú hwoi gāli dedee wa hwoi fá yɔ̀, wa hwoi yìkyà yɔ̀.<verse eid="MAT 13:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 13:14" />Yiishina'wa àpyɛ̀wyawya Ishaya lò gyila zɛ̀ la,</para>
  <para style="q1" vid="MAT 13:14">&lt;&lt;Ni hwoi fá kà fá dedee ni hwoi yìkyà yɔ̀;</para>
  <para style="q2" vid="MAT 13:14">ni lò zú hwoi jā bé wú kà jā, dedee ni hwoi yìkyà yɔ̀.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Dizyi ánwú panku hwoila lò hu;</para>
  <para style="q2" vid="MAT 13:15">u kàdì mazyi wa fá zyí wa chùchú'wa,</para>
  <para style="q2" vid="MAT 13:15">ma kà lò zú'wa memba.</para>
  <para style="q1" vid="MAT 13:15">Yimama yɔ̀ ní wá ngaa hwoi wyabe wa zú'wa,</para>
  <para style="q2" vid="MAT 13:15">ma hwoi fá zyí wa chùchú'wa,</para>
  <para style="q2" vid="MAT 13:15">ma hwoi yìkyà wa nwú'wa</para>
  <para style="q1" vid="MAT 13:15">ma vekà, ḿ ngaa pi lò'wa hwoi dàgba.<verse eid="MAT 13:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16" />Avosɔ̀ yi wuni dizyi zú'ni hwoi wyabe, àchùchú'ni hwoi fá. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />M ngyi zɛ̀ yí'ni zyíbyɛ̀ la, áwándówyapyɛ̀ wa wándóbyɛ̀ ndabe lò zú hwali mazyi wa wya wú waa ni wya lá, dedee wa wya'u yɔ̀, mazyi wa fá wú waa ni fá lá, dedee wa fá'ú yɔ̀.<verse eid="MAT 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />&lt;&lt;Tama ni lò chùchú gāli mazyi ḿ tɛsɛ̀ tɛ́káàká àwu ndónàchɛ̄wú lá yí'ni mazyi ni fá: <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Sásá pà wà ma fá zéchɔ̀ yiishina chɔ̀ wàyii dɔ lá ma yìkyà yɔ̀ ní, angyefu gbaa be ma lò wú wàtàtà yii fu nwú'a lá yi kwàfyé manì. Ahu li gbaa yi chɛ̄wú wàkwèkwè yii nyashɔ lá manì. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Achɛ̄wú wàkwèkwè yii ishina be wàbā gɔ́ lá gbaa yi ápà wàfá zyí yiibebeli ma kà lò pà mɔmɔ wa nwúmbòmbò lá manì. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Dedee yiishina dú waa u bā yɔ̀ lá, u yi nashɔ yɔ̀. Dédēwaa zyí zu kwɛɛ fyì ma dà yiishina zyí Shidɔ, u yi shè huna'a yi kàsɛ mɔmɔ ma lò vo'a yi tɛ. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Achɛ̄wú wàkwèkwè yii fu sé lá, gbaa yi ápà wàyi fá zyí Shidɔ dedee ma yi wèbēbè mazyi ú dò beshívyā wa shɔ́māàmā mazyi ú lò kà ndówúchɔ́ lò'u pyí ma wade'u ngyì wànwāànwā. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Achɛ̄wú wàkwèkwè yii bé dɛ̀ wàsàsà lá, gbaa yi ápà wàfá zyí Shidɔ makà yìkyà'u lá manì. U nwā ngyì wúzyī wàsàsà idipaichɔ, awanati idipaisa, awanati idizuzede kāgbá chɛ̄wú waa wa nyá lá.&gt;&gt;<verse eid="MAT 13:23" /></para>
  <para style="s1">Átɛ́káàká Yesu yiishina byɛ́</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Yesu kà mbyā wàkátɛ́ zu yí'wa la, &lt;&lt;Àchɔ̀ wàyii dɔ lá yi sáyìna apanku wànà chɛ̄wú wàsàsà yiifu dā'a. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Dedee dédēwaa nɔ́nɔ̄ lò náná lá, àwàzé be ma lò byɛ́ nà dó fu áwá, ma ya'a. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Dédēwaa áwá dà ma nwà ishina wànwā ngyì lá, yiibeli ábyɛ́ pwèzu dúdú.<verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />&lt;&lt;Áwányà pàli be dò'u ma zɛ̀ la, &lt;Wasendo, achɛ̄wú wàsàsà waa o tà yii dā'o ní yɔ́? Be wàni waa byɛ́ kà zuni ní?&gt;<verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />&lt;&lt;U zɛ̀ la, &lt;&lt; &lt;Àwàzé gbaa sá ní,</para>
  <para style="p" vid="MAT 13:28">&lt;&lt; &lt;áwányà mbye'ushé lá, &lt;O yi fú mazyi í lò byɛ́ gbòdɔ yii fu'a?&gt;<verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />&lt;&lt;U zɛ̀ la, &lt;&lt;Aayì, dizyi dédēwaa ni ma hwoi gbò byɛ́, nwázuyɔ̀ ni lò áwá hwoi gbò wa byɛ́ dùdù. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Ni me áwá ni wa byɛ́ mazyi wa hwɛ̀ dùdù gbógbó bà nyunu wàbēèbē. Nyunu li m ngyi zɛ̀ zyí wa wándóbēèbē la: Wá kɛ́pyɛ̀ lò byɛ́ gbò kwazɔ mazyi wá lò'u dɛ̀ ishina-ishina mazyi wá lò'u dó pyù pùnū, yiibeli má wa pi lò áwá hwo kwazɔ ma lò wè'm fu vā.&gt;&gt;&gt;<verse eid="MAT 13:30" /></para>
  <para style="s1">Átɛ́káàká yiishina Ngyì Mustad wa Yist</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Yesu kà mbya'a kátɛ́ zu yí'wa la, &lt;&lt;Àchɔ̀ wàyii dɔ lá yi sáyìna ngyì wàtitinti wu fyī zu waa wa bā'u la, mustad lá, apazu lò ma tà yiifu dā'a. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Nyemgba áhu waa ngyì'a titinti kā chɛ̄wú wànati sásá lá ní, u ma nga, u yi hwɛ̀li kā zyèwú wúzyī wànati sásá lá ma lò yi kà fyī, ányi hwoi jā vo'a.&gt;&gt;<verse eid="MAT 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />U kà mbyā wàkátɛ́ zu yí'wa la, &lt;&lt;Achɔ̀sáàsá àwu Shidɔ yi sáyìna yist waa àwàzu lò'u nū wa mbò wu áwá buu waa yist lò pà ní sásá ma lò'u ndē lá.&gt;&gt;<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Yesu zɛ̀ zyí wa tɛ́káàká gbaa yi bè panku sásá ní; u zɛ̀ zu wa'wa mamá ma kwá tɛ́káàká hwali yɔ̀. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Yimamala u sá wúli mamá mazyi zyí waa Shidɔ zɛ̀ zu nū ándówyapyɛ̀ lá ú lò kà yi byɛ̀:</para>
  <para style="q1" vid="MAT 13:35">&lt;&lt;M ngyi zɛ̀zyí wa'wa wa tɛ́káàká,</para>
  <para style="q2" vid="MAT 13:35">m lò wú wàyùyò nashɔ dédēwaa wa mà denmyɛ lá, yi zɛ̀.<verse eid="MAT 13:35" /></para>
  <para style="s1">Yesu lò tɛ́káàká wu byɛ́ zɛ̀</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />&lt;&lt;Yiibeli Yesu me bè panku ní ma lò kà fu ndō. Áwátu'a be dò'u ma zɛ̀ la, &lt;&lt;Kyà tɛ́káàká wàzɛ̀ la, ábyɛ́ yiifu dā yí'i.&gt;&gt;<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Yesu zɛ̀ la, &lt;&lt;Apà wàtà chɛ̄wú wàsàsà lá yi mi, Ango Panku. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Ādā gbaa yi denmyɛ ní. Àngyì wàsàsà yi panku àwu ndō wàbā chɔ̀. Ábyɛ́ gbaa hwoi zyē ngyefu ní. <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />Awàzé wàtà byɛ́ lá gbaa yi ngyefu ní. Anyunu wàbe wúzyī, gbaa yi nyunu wàkenū àwu denmyɛ ní. Áwándó wàhwoi be wúzyī lá, hwoi zyēchɔ̀.<verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />&lt;&lt;Kwɛina yiiyi waa wa lò byɛ́ gbò kwazɔ ma lò sopyu lá, mamá waa u kà yi kwò nyunu wàkenu ní. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Yesu Ango Panku yi chō zyēchɔ̀'a chɔ̀ be lò sásá wándó wa hwoi chá wúwàbɛbɛ hwoi be lá wa sásá wándówàhwoi sá wúwàbɛbɛ yiifu ndōchɔ̀'a lá hwoi tɛ zumyɛ. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Ma lò'wa hwoi nyá wè ndō pyù wàbàpyù, yiibeli wa hwoi shèki ma hwoi be vo yii shina. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Yiibeli áwándó waa hwoi sá wú waa Shidɔ yi fu lá hwoi yúùyú sáyìna nyunu yiifu chɔ̀ wàsáàsá àwu Ada'wa. Ápà wàma bā chùchú wàfá ní, ú fá.<verse eid="MAT 13:43" /></para>
  <para style="s1">Átɛ́káàká yiishina Wúchɔ́ wà yùyò</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />&lt;&lt;àchɔ̀wàsáàsá wu Shidɔ yi sáyìna áwúchɔ́ waa wa lò'u yùyò yiifu dā lá. Dédēwaa pazu ma lò'u fyò, u kà mbya'u yi yùyò, yiibeli u shàáshà ma lò wú waa u bā sásá lá hwo kpáti ma lò dāli hwɛ̄.<verse eid="MAT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />&lt;&lt;Wàkà kwaani, àchɔ̀wàsáàsá wu Shidɔ yi sáyìna ngoti wà yi hwāzú gɔ́ wàbā hwɛ̀. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Dédēwaa u wya gɔ́ wàbā hwɛ̀ kādɔ lá, u kàsɛ ma lò wú waa u bā sásá lá kpátí ma lò'u hwɛ̀.<verse eid="MAT 13:46" /></para>
  <para style="s1">Átɛ́káàká Àwu Ndù</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />&lt;&lt;Wàkà kwaani, àchɔ̀ wàyii dɔ lá yi sáyìna ndù waa wa lò'u wè fu núkù yi pà chɛ̄ zyé kɛkɛ-kɛkɛ lá. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Dédēwaa ndù ma lò mwɛ̀, áwándópàzyé lò'u yi gbe bà dìkɛ́pɛ̀. Yiibeli wa hwoi shí zyoku ma hwoi shē zyé wàsàsà hwoi wè fu tikishɛ, ma lò wándówàbɛbɛ lá hwoi nyámbyɛ́. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Yiiyi waa nyunu wàkɛ̄ɛ̀kɛ̄ yi be lá manì. Ázyēchɔ̀ hwoi be ma lò wándó nwúbɛbɛ hwoi shē dɔ yiifu wándózyíbyɛ̀ <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />ma lò'wa hwoi nyá wè ndō pyù wàbàpyù yii be waa wa hwoi shèki ma hwoi dó vo yii nyí lá.<verse eid="MAT 13:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />&lt;&lt; Ni yìkyà wú wàhwoila sásá?&gt;&gt;</para>
  <para style="p" vid="MAT 13:51">Wa zɛ̀ la,&lt;&lt;Eba.&gt;&gt;<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Yesu zɛ̀ yí'wa la, &lt;&lt;Nyemgba sásá wándótà Dɔ̀ wu Musa wàma dò yìyì wàzèfu yiishina chɔ̀ wàyii dɔ lá ní, u lò yi kà wàsendo wàyi tɛ wú wàpyoo wa wàkwɔ yi zumyɛ yiifu táwàsāchɛ'á lá.<verse eid="MAT 13:52" /></para>
  <para style="s1">Andówyapyɛ̀ wàbā hwɛ̀ yɔ̀</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />&lt;&lt;Dédēwaa Yesu lò tɛ́'a kábwā lá, u dà'adɔ yii beli. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Yesu lò kàsɛ be gándō'a, ma yi tà panku wú yiifu táwàkwāshī'wa, wándó wàfá'u lá agbashu hwo'wa pà. Wa hwoi mbyeshé la, &lt;&lt;Yii be wàni waa pà lá dò yìyì wa gbā wàsá wugbashu lá ní? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />&lt;&lt;Ango wu kapinta lá gbaa yi nì yɔ̀? Ahu waa zyì yī'a zyī la, Maryamu ní yɔ̀? Ahu waa ázyēyī'a hwoi Yakubu, wa Yusufu, wa Siman, wa Yahuda ní yɔ̀? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Sásá zyēyī'a wàwuwà gbaa wa'i hwoi dùdù ní yɔ̀? Be wàni waa pàlá ya dò wúlá sásá hwoi ni ní?&gt;&gt; <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Áwúli lò kà wa púpù la wa zɛ̀ndɛ̀ wa'u yɔ̀.</para>
  <para style="p" vid="MAT 13:57">Dedee Yesu zɛ̀ yí'wa la, &lt;&lt;Andówyapyɛ̀ yi bā hwɛ̀ yii be sásá dedee yii gándō'a wa fundō'a kɛ̀ló waa u yi bā hwɛ̀ yɔ̀ ní.&gt;&gt;<verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />Dizyi wa nyànì zyíbyɛ̀ lá, u sá wugbashu buu yii beli yɔ̀.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s1">Wa lò Yohana wàyi sá Baptisma lá ishina kè</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Yiifu dédē li Hirudus fá zyí buu yiishina Yesu, <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />u zɛ̀ yí áwányà'a la, &lt;&lt;Yohana wàyi sá Baptisma lá gbaa yiinì; ahu waa wa lò'u dà yii bé ki ní! Áwú wàsá waa u dò gbā ma yi sá wugbashu buu lá manì.&gt;&gt;<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Hirudus kɛ́pyɛ̀ lò Yohana pà ma lò'u tá wa gbàlàgbà hwā fu táfyì yiishina Herodias àwà ngoyī'a Filip, <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />dizyi Yohana yi zɛ̀ yí'u lá,&lt;&lt;U bā sàsà yiibe dɔ̀ mazyi ó lò Herodias bà yɔ̀.&gt;&gt; <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Hirudus yi fú mazyi ú lò Yohana bwā, dedee u yi sázī Áwáyahuda dizyi wa hwoi wya'u sáyìna ándówyàpyɛ̀.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Dédēwaa nyunu mbàmbà wu Hirudus kà lò vekà be lá, ango wu Herodias gbòzyó yii pyɛ̀'wa, áwúli vyā Hirudus dì lò kādɔ <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />lá u génū wa kidàdà wàyí'u wú waa u ma mbyeshé sásá. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />áyī'a dózyí yí'u lá, u zɛ̀ la, &lt;&lt;Yí'm ishina Yohana wàyi sá Baptisma.&gt;&gt; <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Ánwúzáàzá lò ku pà, dedee yiishina ki waa u dà yii pyɛ̀ áwá pàkyù'a lá, u yínū la, áwú waa u yi fú lá wa sá <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />ázyēndō ku Hiridus lò Yohana ishina kè yii tá. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Wa lò ishina'a lò yiifu wú be yí nguwáwà li, u lò chá yí yī'a. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Áwátú Yohana be lò kwā lò ma lò zyì. Yiibeli wa ya ma lò zɛ̀ yí Yesu.<verse eid="MAT 14:12" /></para>
  <para style="s1">Yesu yí panku idipaichɔndoide ichɔ wúzyī</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Dédēwaa Yesu fá zyí ki Yohana ándó sá batisma lá, u dàdɔ kyómá wa kɔ̀ ma ya'a be waa pazukponu yii ní yɔ̀ lá. Apanku fá mamá lá, wa me gá'wàni ma hwoi be'uni. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Dédēwaa Yesu lò tòli ma wya bè panku lò kādɔ lá, azushishi'wa lò'u pà, u lò wándó wàfá vyā yɔ̀ lá dàgba.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Anyizɔli, áwátu be dò'u ma zɛ̀ la, &lt;&lt;Abe'a yi lá bā wuzukponu yɔ̀, nyunu kà lò'a kwò ló. Me bè panku hwoi lá ní wa ya'wa, mazyi wa kà gáwàtiti wa hwɛ wúzyī yí di'wa.&gt;&gt;<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Yesu zɛ̀ yí'wa la, &lt;&lt;U bā sàsà mazyi wa ya'wa yɔ̀. Awuni ni yí'wa wúzu wàzyīìzyī.<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />&lt;&lt;Wa zɛ̀ yí'u la, &lt;&lt;I bā bredi ichɔ wa zyé ipyɛ̀ kɛ̀ ló.&gt;&gt;<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />U zɛ̀ yí'wa la, &lt;&lt;Ni lò wa chá be yí'm yii maa.&gt;&gt; <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />U yí panku nū mazyi wá shí ishina byɛ́, yiibeli u lò bredi ichɔ wa zyé ipyɛ̀ lá lò, u lò zú jā dɔ, ma tá mamgba ma lò bredi hwoila téká sásá. Yibeli ma lò yí áwátu'a, áwátu'a lò gà yí bè panku. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Sásá'wa zyī ma lò mufu zɛ̀, áwúzyī wànati lá, áwátu'a hwo tikishɛ mwɛ̀mwɛ̀ idezepyɛ̀. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Àbè panku wàzyī wúzyīli lá, kāgbá idipaichɔndoide ichɔ, dizyi wa hwɛ̀ wáwà wa zyetifyi yɔ̀.<verse eid="MAT 14:21" /></para>
  <para style="s1">Yesu kyēkyū yiishina lape</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Yiibeli Yesu yí áwátu'a kà kɔ̀ ma kyā nú ya zyɛ̄ kɛ́pyɛ̀ yí'ú, áhu gɛ̀ lò sāli wa bè panku ma yí'wa nū wàgànyá. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Dédēwaa Yesu lò gàfā wa bè panku lá, u lò né ya ishina gā vodi'a mazyi ú jāndɛ̀. Dédēwaa nyunu lò kwò lá, u yii beli tàtànwú'a, <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />dedeeli, àkɔ̀ lò kɛ́pyɛ̀ ya benashɔ wa zyoku ló, ányázyà yi sù kɔ̀ wa wɔ̀ wàsā lò ishina té'u lá.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />Dédēwaa be fu lò kyà la, Yesu lò ishina té'wa, yi kyēkyū yiishina lape. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Dédēwaa áwátu wya'u yi kyēkyū yiishina lape lá, wa lò kàzi ma zɛ̀ la, &lt;&lt;Anidi ndówàhūùhū,&gt;&gt;wa dá kito wa zī.<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Yesu zɛ̀ yí'wa mɔmɔ la,&lt;&lt;Ni lò nwú byɛ̄! Ami. Ni ká sázī yɔ̀.&gt;&gt;<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Bitrus zɛ̀ la, &lt;&lt;Adandō, u ma yi wo ní, yí'm nū mazyi ḿ kyēkyū yiishina lape be dò'u.&gt;&gt;<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />Yesu zɛ̀ la, &lt;&lt;Be.&gt;&gt; Yiibeli Bitrus lò tòli zumyɛ yiifu kɔ̀ ma dà kyū yiishina lape lò ishina té Yesu. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Dedee dédēwaa Bitrus wya wɔ̀ lò gbakpo lá, u lò kàzi ma yi shìli minɛ ní, u dá kito la, &lt;&lt;Adandō, sá zá'm ní!&gt;&gt;<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Yiibebeli Yesu ndavo ma lò'u pà, ma zɛ̀ la, &lt;&lt;Andó byɛ̀ wàtitinti, áyɛ̄ sá waa o yi mɛ̀nwú ní?<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />&lt;&lt; Dédēwaa wa lò kà kɔ̀ lá, áwɔ̀ lò pà. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Yiibeli áwátú'a wàhwoi fu kɔ̀ lá, ngya'o, hwoi zɛ̀ la, &lt;&lt;Yi byɛ̀ o yi Ngo Shidɔ.&gt;&gt;<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Dédēwaa wa lò nú kyābwā lá, wa lò bà zyoku Jenesaret. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Waa panku wàhwoi beli lò Yesu yìkyà lá, wa zɛ̀chɔ̀ yí di'wa shèkwà zyokuli ánɔ́nɔ̄ chá wándó wà fá vyā yɔ̀ be dò Yesu <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />ma vá'u mazyi ú me wándó wà fá vyā yɔ̀ lá wa gwà'uvo yii nū túkpá'a wàyádì, sásá wándó wàgwà'uvo lá hwo dàgba.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s1">Áwúchù Wácha</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Yiibeli Áwáfaris wa wándó tà dɔ̀ wu Musa dà zu Urushalima be dò Yesu ma mbyeshé la, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />&lt;&lt;Áyɛ̄ sá waa áwátu'u hwoi sábɛ wúchù wácha ní? Wa hwoi tōvo'wa yii nyàshɔ wàgyegye pùnū yɔ̀ ma hwoi zyī wúzyī!&gt;&gt; <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />Yesu zɛ̀ yí'wa la, &lt;&lt;Áyɛ̄ sá waa ni hwoi bàdɔ̀ Shidɔ yɔ̀ ishina wúchù'ni ní? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Dizyi Shidɔ zɛ̀ la, &lt;Yí da'o wa yī'o hwɛ̀&gt;kàwa &lt;Sásá pà wàma chō da'a tè kwɛɛ yī'a tè, wá lò'u bwā.&gt; <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Dedee àwuni lá ni zɛ̀ la, nyunu waa panku ma bā wú waa u yi sázá da'a wa yi'a ni ní, u zɛ̀ la, &lt;Sásá wú waa m bā wàsázá'ni ní, dedee ú zɛ̀ la, &lt;Wàyila yi wu Shidɔ,&gt; <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />ú káwa yí da'a hwɛ̀ gɛ̀ yɔ̀. Yii nyàshɔ wàyila ni sìnì zyí Shidɔ mazyi ni sá wúchù wuni. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Awuni wándóbɛfù! Ishaya zɛ̀'a gyegye wa wú waa u wya yii pyɛ̀ yiishina ni ma zɛ̀ lá: <verse eid="MAT 15:7" /><verse number="8" style="v" sid="MAT 15:8" />&lt;&lt;Apà hwoila hwoi yí'm hwɛ̀ wa nū, dedee ánwú'wa yii benashɔ wa'm. <verse eid="MAT 15:8" /><verse number="9" style="v" sid="MAT 15:9" />Wa hwoi wá'm nùchɔ̀; dizyi wa hwoi tà dɔ̀ panku yi sè ishina zyí Shidɔ.&gt;&gt;&gt; <verse eid="MAT 15:9" /><verse number="10" style="v" sid="MAT 15:10" />Yesu bá bè panku ndɛ̀ gbayi yii pyɛ̀'a ma zɛ̀ la, &lt;&lt;Ni gā chùchú mazyi ni yìkyà. <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Áwúzyī waa ni hwoi zyī lá gbaa lò ni hwoi kà &lt;wándósɔ́ ní yɔ̀,&gt; dedee áwú wàyi zumyɛ yii nū'ni lá gbaa lò ni hwoi kà &lt;wándósɔ́ ní.&gt;&gt;&gt; <verse eid="MAT 15:11" /><verse number="12" style="v" sid="MAT 15:12" />Yiibeli áwátu be dò'u ma mbyē'ushé la,&lt;&lt;O yìnɔ̀ la, Áwáfaris hwo sáàpá yiishina wa zyí waa o zɛ̀ lá?&gt;&gt; <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" />U zɛ̀ la, &lt;&lt;Sásá fyī waa Ada'm wà yii dɔ lá ma tà ní yɔ̀, wa lò'u yi gbò wa dú'a. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Me wa ní; wa hwoi bòzú wàhwoi gbe bòzú kutɛ̀. Nyunuwaa bòzú ma gbe bòzú kutɛ̀ sásá'wa hwoi kwèkwè yiifu shī&gt;&gt; <verse eid="MAT 15:14" /><verse number="15" style="v" sid="MAT 15:15" />Bitrus zɛ̀ la, &lt;&lt;Zɛ̀ tɛ́ lá waa o ká lá yí'i.&gt;&gt; <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />Yesu mbye'wa shé la,&lt;&lt;Kwā wuni kà ndèndè dúdú?&gt;&gt; <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />&lt;&lt;Ni wya waa wú wàma kà nū sásá yi kà jɔ̀fu ma yi zumyɛ yii dì lá yɔ̀? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Dedee áwú wàhwoi zumyɛ yii nū lá, yi zu nwú, áwúli gbaa yí panku lò yi kà &lt;ndósɔ́ ní.&gt; <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Dizyi yiifu nwú waa zyíhwɛ̀ wàbɛbɛ hwoi zuni ní, sáyìna apanku wàbwāàbwā, wa bákyáàkyá wa lákpá, wa vyú, wa pyɛ̀bàbà wu zyígé, wa zyì pàsɛ wàsábɛ. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Áwú wàhwoila gbaa lò panku yi kà ndósɔ́ ní&gt;; dedee gba yi wúzyī wàzyī ma tōvo yɔ̀, gbaa lò'u yi kà &lt;ndósɔ́ ní yɔ̀.&gt;&gt;&gt;<verse eid="MAT 15:20" /></para>
  <para style="s1">Azyíbyɛ̀ wu Wàzu</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Yesu me beli ní ma ya zyoku wu Taya wa Sidon. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Àwàzu yi ngo zyoku Kanaana zu beli be dò'u, u yi dákito yi zɛ̀ la, &lt;&lt;Adandō, Ango wu Dawuda, wyashishi'm! ango'm yi wya fyì wàbɛbɛ wa zyɔ̀ wàyii dì lá.&gt;&gt; <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />Yesu zɛ̀ zyí zukponu yɔ̀. Yimamala áwátu'a be dò'u ma vá'u la,&lt;Lò'u ká, dizyi u yi be'ini wa kito.&gt;&gt; <verse eid="MAT 15:23" /><verse number="24" style="v" sid="MAT 15:24" />Yesu zɛ̀ la, &lt;&lt;Shidɔ chō'm be ishina panku Isrela wàhwo mìzyɛ̀ lá.&gt;&gt; <verse eid="MAT 15:24" /><verse number="25" style="v" sid="MAT 15:25" />Dedee àwàlá be kàli yii pyɛ̀'a, ma zɛ̀ la, &lt;&lt;Adandō, sázá'm ni! &gt;&gt; <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />Yesu zɛ̀ la, &lt;&lt;U sàsà mazyi wa lò wúzyī zyetifyi tá yí bɛ́ yɔ̀.&gt;&gt; <verse eid="MAT 15:26" /><verse number="27" style="v" sid="MAT 15:27" />Àwàlá zɛ̀ la, &lt;&lt;Ázyí'u yibyɛ̀, Adandō, dedee ábɛ́ yi zyī wúzyī wànyámbyɛ́ zu ishina tebul wu wasendo'a lá dúdú.&gt;&gt; <verse eid="MAT 15:27" /><verse number="28" style="v" sid="MAT 15:28" />Yiibeli Yesu zɛ̀ la,&lt;&lt;O yi wà waa zyíbyɛ̀'o hwɛ̀li! Áwú waa o vá lá, o lò dò.&gt;&gt;Yiibebeli, ángù'a lò gba.<verse eid="MAT 15:28" /></para>
  <para style="s1">Yesu dàgba Panku Ndabe.</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Yesu me beli ní ma zu bàbà wa núkù wu Galili. Yiibeli u né gā ma ya shíli. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Apanku ndabe be dò'u, áwándó wàhwoi kyēkyū kà yɔ̀, wa bòzú, áwándó vo nyíìnyí, wa áwándó wàhwoi zɛ̀zyí yɔ̀, wa panku ndabe wándówànati wàfá vyā yɔ̀ lá, hwoi pyɛ̀'a; u lò'wa dàgba. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Agbashu lò panku hwo pà dédēwaa wa wya áwándó wàhwoi zɛ̀zyí yɔ̀ hwoi zɛ̀zyí, áwándó vonyíìnyí hwo dàgba, áwándó wàhwoi kyēkyū yɔ̀ hwoi kyēkyū, áwándó wàhwoi wyabe yɔ̀ hwoi wyabe lá, wa ngyā Shidɔ wu Isrela. <verse eid="MAT 15:31" /><verse number="32" style="v" sid="MAT 15:32" />Yesu bá áwátu'a ndɛ̀ be dò'u ma zɛ̀ yí wa la, &lt;&lt;M ngyi wyashishi panku hwoila; wa wa'i hwoi dùdù zyina nyunu isa ma ba wuzukponu wàzyīìzyī yɔ̀. M ngyi fú mazyi ḿ ká me'wàni wáya wa mbɔ yɔ̀, yiishina wáká ya kwèkwè yii nyàshɔ yɔ̀.&gt;&gt; <verse eid="MAT 15:32" /><verse number="33" style="v" sid="MAT 15:33" />Áwátu'a zɛ̀ la, &lt;&lt;Yii fubyɛ́ lá, be wàni waa i ya hwoi dò bredi buu ma pi hwoi yí'wa hwoi zyī ní? <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />Yesu zɛ̀ la, &lt;&lt;Bredi yi puna waa ni ba ní?&gt;&gt; Wa zɛ̀ la, &lt;&lt;Isumpyɛ̀ wa zyé wàtiti tima kɛ̀ ló.&gt;&gt; <verse eid="MAT 15:34" /><verse number="35" style="v" sid="MAT 15:35" />U yí bè panku sásá shí zyoku. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Yiibeli u lò bredi isumpyɛ̀ wa zyé, dédēwaa u lò mamgba tá Shidɔ bwā lá, u lò'wa téká ma lò ndavo yí áwátu'a, áwátu'a lò gà yí bè panku. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Sásá'wa zyī ma zɛ̀fu. Yiibeli áwátu hwo buburu wúzyī wànati lá yi tikishɛ idezepyɛ̀ <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Andabe wándó wàzyī wúzyī lá, fè panku ideipaichɔndoide kwazɔ̄ ini, wáwà wa zyetifyi hwoi fu'a yɔ̀. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Gbá má waa Yesu lò gàfā wa'wa lá, u lò kà fu kɔ̀ ma ya'a zyoku Magadan.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s1">Wa hwoi hwāzú àsɛ̀ Wugbashu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Áwáfaris wa Áwásadus be dò Yesu ma mbawya'u wa shéwàmbyēèmbyē mazyi ú tà'wa àsɛ̀ wúzu yii dɔ. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />U zɛ̀ la, &lt;&lt;Dédēwaa nyunu ma yi kwò, ni hwoi zɛ̀ la, &lt;Abē yi sàsà dizyi adɔ lò nyànyà,&gt; <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Apunɔ bìbìrì, ni hwoi zɛ̀ la, &lt;Azyina àfyù yi tā dizyi abe lò nyànyà ma lò sèfē.&gt; Ni hwoi jāzú yii dɔ̀ ma hwoi yìkyà'u, dedee àsɛ̀ wu dédē waa i hwoi fu'a lá ni hwoi yìkyà yɔ̀. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Apanku wàtama wàbɛbɛ nwú ma ba byɛ̀ yɔ̀ lá hwoi hwāzú àsɛ̀ wúgbashu, dedee wa hwoi dò yɔ̀, àsɛ̀ wugbashu wu Yunana kɛ̀ló waa wa hwoi dò ní,&gt;&gt;Yiibeli Yesu me'wa ní ma ya'a.<verse eid="MAT 16:4" /></para>
  <para style="s1">Yist wu Áwáfaris wa Áwásadus</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Dédēwaa wa lò kyānú yii núkù bà zyɛ̄ lá, áwátu lò mòmú wàlò bredi. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Yesu zɛ̀ yí'wa la, &lt;&lt;Ni pà di'ni, mazyi ni kó di'ni yiishina yist àwu Áwáfaris wa Áwásadus.&gt;&gt; <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />Wa fá mamá lá wa vyāshé wa di'wa la,&lt;&lt;Yiishina i be wa bredi zukponu yɔ̀ lá.&gt;&gt; <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />Yesu yì wú waa wa hwoi zɛ̀ lá, yimamala u mbye'wa shé la,&lt;&lt;Áyɛ̄ sá waa ni hwoi vyāshé wa di'ni la, ni ba bredi yɔ̀ ní? Ázyíbyɛ̀ wàzōòzō wàni waa ni bā ní! <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Ni yìkyà ló yɔ̀? Ni kyé bredi ichɔ waa m yí panku idipaichɔndoide kwazɔ̄ ichɔ zyī lá yɔ̀, atikishɛ yi puna waa ni hwo kwazɔ̄ ní? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Kwɛɛ bredi isumpyɛ̀ waa panku idipaichɔndoide kwazɔ̄ ini zyī lá yìh, atikishɛ yi puna waa ni kà lò hwo mwɛ̀ kwazɔ̄ ní? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Áyɛ̄ sá waa ni hwoi yìkyà yɔ̀ ma hwoi wya sáyìna m ngyi zɛ̀ zyí bredi wàni ní? M zɛ̀ la, ni kó di'ni yiishina yist wu Áwáfaris wa Áwásadus.&gt;&gt; <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Yiibeli áwátu hwo yìkyà la, u yi bwà'wa vo mazyi wá kó diwa wa yist wàsá buredi ni yɔ̀, dedee ishina wàkó diwa wa wúwàtàtà àwu Áwáfaris wa Áwásadus.<verse eid="MAT 16:12" /></para>
  <para style="s1">Bitrus zɛ̀ la, Yesu yi Ndótɛpà</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Dédēwaa Yesu be zyoku Sisariya Filip lá, u mbyē áwátu'a shé la, &lt;&lt;Ánɔ̄ waa panku hwoi zɛ̀ la, &lt;&lt;U yi ngo Panku ní?&gt;&gt; <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />Wa zɛ̀ la, &lt;&lt;Wándó wànati hwoi zɛ̀ la, Yohana wàyi sá Baptisma lá; wándówanati hwoi zɛ̀ la, Iliya; wándówanati hwoi zɛ̀ la Irimiya, wándówanati hwoi zɛ̀ la ápazu yii fu wándowyapyɛ̀. <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />Yesu zɛ̀ yí'wa la, &lt;&lt;Awuni yìh? Ni zɛ̀ la m ngyi nɔ̄ ní?&gt;&gt; <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />Siman wa Bitrus zɛ̀ la,&lt;&lt;O yi Ndótɛpà, Ango wu Shidɔ wàbā nwú lá. &gt;&gt; <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />Yesu zɛ̀ la,&lt;&lt;Avosɔ̀ yi wuo, Siman ngo wu Yunana, dizyi apanku pòfā tà'o ní yɔ̀, Adā'm wàyii dɔ lá, gbaa pòfā tà'o ní. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />M ngyi zɛ̀ yí'o, Bitrus, o yi gɔ́, ábátá gɔ́ lá, m ngyi myī ngyi myī tá'm wànyɛnyɛ yiiní, kwā ki gba yi sá'u wuzukponu kà yɔ̀. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />M ngyi yí'o ngyúwàpò àwu chɔ̀ wàyii dɔ lá, áwú waa o ma dɛ̀ yii bēèmyɛ̄, u dɛ̀dɛ̀ yii dɔ, áwú waa o ma lò fɛ̀ yii bēèmyɛ̄ u fɛ̀fɛ̀ yii dɔ.&gt;&gt; <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Yiibeli u bwà áwátu'a vo mazyi wá ká zɛ̀ yí pàzu la, áhu gbaa yi Ndótɛpà ní yɔ̀.<verse eid="MAT 16:20" /></para>
  <para style="s1">Yesu zɛ̀ nyunu ki'a</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Dà zu nyunuli ya pyɛ̀ Yesu yi zɛ̀ yí áwátu'a la, ahu yi ya Urushelima mazyi ú wyafyì buu yii vo wacha, wa áwàshuwɔ̀ áwádakumbwa wa wándó tà dɔ̀ wu Musa, u zɛ̀ la, wa lò'u yi bwā, dedee nyunu isa u kà yi dàdɔ yi hwonwu. <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />Bitrus lò'u gbe ya kìká ma bwà'u vo la, &lt;&lt;U yi sá yɔ̀, Adandō, áwúzukponu yi sá'o yɔ̀!&gt;&gt; <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />Yesu vekà zú ma zɛ̀ yí Bitrus la, &lt;&lt;Gbe di'u kàsɛ niki wa'm Angyefu! Yii bé'm o yi gɔ wàyí pà táchù ma kwèkwè, ázyíhwɛ̀wàgàgà'o yi wu Shidɔ yɔ̀, yi wu panku.&gt;&gt; <verse eid="MAT 16:23" /><verse number="24" style="v" sid="MAT 16:24" />Yiibeli Yesu zɛ̀ yí áwátu'a la,&lt;&lt;Sásá pà wàma yi fú ú be'mni ní, u yi nghà di'a ma yi lò fyī'a yi be'mni. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Dizyi sásá pà wàma sū nwú'a, u yi sáfyì'a, sásá pà wàma lò nwú'a sáfyì yiishina'm, u lò'u yi fyò. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Áyɛ̄ waa panku yi dò kwaani nyunu waa u ma lò denmyɛ sásá dò kà wua, ma sáfyì nwú'a ní? Kwɛɛ, áyɛ̄ waa panku yi hwātɔ̄ yiishina nwú'a kà ní? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Ango Panku yi bēèbē yiifu gwá àwu Ada'a wa ázyēchɔ̀'a, yiibeli ma yi hwā nɔ́nɔ̄ tɔ̄ betò kolo'a waa u sá lá. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />M ngyi zɛ̀ yí'ni zyíbyɛ̀, wándówanati wàsā hwoi maa la, hwoi hu yɔ̀ gbógbó wa hwoi wya Ango Panku yi be yii fu chɔ̀'a.&gt;&gt;<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s1">Yesu lò di'a zá</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Yii niki ishinzyi, Yesu lò Bitrus lò wa'u, wa Yakubu wa Yohana ngoyī Yakubu ma lò'wa lò ya dɔdɔ yii ishina gā, wa hwoi beli tànwú'wa. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Yiibeli u lò zu pàzu kɛkɛ yii pyɛ̀'wa. Azú'a lò nyànyà sáyìna nyunu, átúkpá'a lò mombo sáyìna beyá. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Yiibebeli áwátu'a isa hwoila wya Musa wa Iliya hwoi vyāshé wa Yesu. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Yimamala Bitrus zɛ̀ yí Yesu la, &lt;&lt;Adandō, u sàsà waa i hwoi maa lá, nyunu waa u ma vyā'odì ní, m ngyi dá dáwà isa, zu, wuo, zu wu Musa, zu wu Iliya.&gt;&gt; <verse eid="MAT 17:4" /><verse number="5" style="v" sid="MAT 17:5" />U yii fu zyí wàzɛ̀zɛ̀, ábèhwa wànghálá-nghálá tòli be'wa, ahuna zyí yiifu bèhwā lá yi zɛ̀ la, &lt;&lt;Ango'm gbaa yiinì, ándó waa m ngyi shó lá; m fá vyā'a lò kādɔ. Ni fá zyí'a! <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />Dédēwaa áwátu fá huna zyíli lá, ázī wàlò kāgbá'wa dɔ lá, wa kwèkwè lò zú be zyoku. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Yesu be gwà'wa vo yii dì ma zɛ̀ la,&lt;&lt;Ni dàdɔ, niká sázī yɔ̀.&gt;&gt; <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Dédēwaa wa lò ishina dɔ lá, wa wya wuzukponu yii beli yɔ̀, ákèké Yesu waa wa wya minɛ ní. <verse eid="MAT 17:8" /><verse number="9" style="v" sid="MAT 17:9" />Dédēwaa wa hwoi tòli yiishina gā lá, Yesu bwà'wa vo la,&lt;&lt;Ni káwa zɛ̀ yí pazukponu wú waa ni wya lá yɔ̀ gbógbó Ango Panku ma dàdɔ yiibe dì wàhūùhū pùnū.&gt;&gt; <verse eid="MAT 17:9" /><verse number="10" style="v" sid="MAT 17:10" />Áwátu mbyē'ushé la, &lt;&lt;Lá áyɛ̄ sá waa áwándó tà dɔ̀ wu Musa hwoi zɛ̀ la, Iliya kɛ́pyɛ̀ yi be ní?&gt;&gt; <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />Yesu zɛ̀ la, &lt;&lt;Yibyɛ̀, Iliya yi be ma lò wú sásá yi mbya. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Dedee ḿ zɛ̀ yí'ni, Iliya kɛ́pyɛ̀ lò'a be ló waa wa yìkyà'u yɔ̀ ma sá'u wú wàvyā'wa dì ní. Mamá waa Ango Panku kà yi wyafyì yii vo'wa ní.&gt;&gt; <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Yiibeli áwátu lò yìkyà la u yi zɛ̀ zyí wa wa yiishina Yohana wàyi sá Baptisma lá.<verse eid="MAT 17:13" /></para>
  <para style="s1">Yesu lò zyɔ̀ ká zumyɛ yii dì Ngowánùzu</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Dédēwaa wa lò kàsɛ yiifu bè panku lá, ápazu gbe di'a bà Yesu ma kàli yii pyɛ̀'a ma zɛ̀ la, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />&lt;&lt;Adandō, wyashishi ngo'm, u yi pà kpikpi, àfyì waa u yi wya lá lò buu. U kwò fu pyù buu, u kwò lape buu. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />M lò'u ya dò áwátu'u, dedee wa lò dàgba kà yɔ̀&gt;&gt; <verse eid="MAT 17:16" /><verse number="17" style="v" sid="MAT 17:17" />Yesu zɛ̀ la, &lt;&lt;Áwuni panku wàtama wàbā zyíbyɛ̀ yɔ̀ nàti ni wa wúwàbɛbɛ lá, m ngyi shí wa ni gbógbó bà nyunu wàni ni? Bá yi puna waa m ngyi pànwú wa ni ní? Ni lò ngoli be maa.&gt;&gt; <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Yesu nyá zyɔ̀ ndɛ̀, u zumyɛ yi dì ngoli, yiibebeli u lò dàgba.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Yiibeli áwátu be dò Yesu kyó ma mbyē'ushé la, &lt;&lt;Áyɛ̄ sá waa i hwoi ká zyɔ̀ zumyɛ kà yɔ̀ ní?<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />&lt;&lt;Yesu zɛ̀ yí la, &lt;&lt;Yiishina ni ba zyíbyɛ̀ wàtitinti lá. Ḿ zɛ̀ yí'ni zyíbyɛ̀, o ma ba zyíbyɛ̀ titinti sáyìna ngyì fyī zu wàtí waa wa ba'u la mustad, o yi zɛ̀ yí gā lá la, &lt;Dàdɔ yii maa ya bewàmu&gt; u yi dàdɔ. Wuzukponu yi kāgbá ni dɔ kà yɔ̀. <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />Wa ndɛ̀wàjāàjā wa nūwàsèsè waa zyɔ̀ wàmamá yi zumyɛ ní.<verse eid="MAT 17:21" /></para>
  <para style="s1">Yesu kà zɛ̀ zyí yiishina ki'a.</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />&lt;&lt;Dédēwaa wa ya gbayi sásá wa yi Galili lá, Yesu zɛ̀ yí'wa la, &lt;&lt;Wa lò Ango Panku yi lò hwa panku vo. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />Wa lò'u yi bwā, nyunu isa u yi dàdɔ yi hwonwu&gt;&gt;Abēbè lò áwátu pà.<verse eid="MAT 17:23" /></para>
  <para style="s1">Agba wu Táwàwáshidɔ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Yesu wa áwátu'a be fè Kapernaum lá, áwándó wàhwoi pà gba wu Táwàwáshidɔ lá be dò Bitrus ma mbyē'ushé, &lt;&lt;Andótàwú ni yi hwa gba wu Táwàwáshidɔ yɔ̀? <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />U zɛ̀ la, &lt;&lt; Eba, u yi hwa.&gt;&gt;Dédēwaa Bitrus lò kàsɛ be futá lá, Yesu gbaa kɛ́pyɛ̀ zɛ̀ zyí ní. U mbyeshé la&lt;&lt;Siman, áyɛ̄ waa o wya yiishina zyí lá ní? Áwá nɔ̄ waa ku denmyɛ hwoi pà banji gba yiibe'wa ní, yii bé zyē'wa kwɛɛ yiibe áwápàkyù?&gt;&gt; <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />Bitrus zɛ̀ la, &lt;&lt;Yiibe áwápàkyù.&gt;&gt;Yesu zɛ̀ la, &lt;&lt;Ázyē'wa hwoi hwa gba yɔ̀.&gt;&gt; Yesu zɛ̀ la, <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />&lt;&lt;Yiishina í ká lò kà áwándó wàbɛbɛ yii bé wa yɔ̀ lá, ya núkù mazyi o tá lii. Azyé waa o yi pà kɛ́pyɛ̀ má; lò'u nū pòfā, o yi wya shɔ́wàmòmbò yii nū'a. Lò tɛ mazyi ó lò yí'wa agba'm wa wuni manì.&gt;&gt;<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s1">Ánɔ̄ Bā hwɛ̀ kā Yiifu Chɔ̀ Wàyii Dɔ Lá Ní?</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Yiifu nyunuli áwátu be dò Yesu ma mbyē'ushé la,&lt;&lt;Ánɔ̄ yi pà wàshuwɔ̀ kā yiifu chɔ̀ wàyii dɔ lá ní?&gt;&gt; <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />U bá ngotifyi wàtitinti ndɛ̀ be sā yiyɔ́'wa ma zɛ̀ la, <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />&lt;&lt;Ḿ zɛ̀ yí'ni zyíbyɛ̀, ni ma lò vekà sáyìna zyetifyi wàtiti hwoila yɔ̀, ni hwoi kà fu chɔ̀ wàyii dɔ lá yɔ̀ . <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Nyemgba, sásá pà wàma lò hwɛ̀'a kwá kàsɛ sáyìna angolá ní, ahu gbaa yi pà wàshuwɔ̀ kā yii fu chɔ̀ wàyii dɔ lá ní.<verse eid="MAT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 18:5" />&lt;&lt;Sásá panku wàma pà ngotifyi wàtitinti mamá kyù yiishina zyì'm ní, ami waa u pà'm kyù ní. <verse eid="MAT 18:5" /><verse number="6" style="v" sid="MAT 18:6" />Dedee sásá pà wà ma yí zyetifyi wàtiti hwoila wàzɛ̀ndɛ̀ wa'm lá sá wú wàbɛbɛ, áwú wàyi vyā wa pàli lá wa lò kuna wàshuwɔ̀ dɛ̀ pá'u huna mazyi wa lò'u hwa be wàzufu yii núkù. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />Shàmákɛ̀ló, yí denmyɛ yiishina wú wàyí panku hwoi sá wúwàbɛbɛ lá! Áwúli hwoi be, dedee shàmákɛ̀ló kà yiishina panku waa wúwàbɛbɛ yi zu bé'a lá. <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Nyunuwaa vo'o kwɛɛ bá'o ma yí'o yi sá wú wàbɛbɛ ní, lò'u kè tatambyɛ́. U sàsà mazyi o kà màndō wàbā nwú wàgbógbó gbògbò lá wa vo zukponu, wa bá zukponu kā waa wa lò'o yi lò wa vo ipyɛ̀, ábá ipyɛ̀ yi tá hwa fundō pyù lá ní. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Nyunu waa zú'u ma yí'o yi sá wú wàbɛbɛ ní, lò'u shā tatambyɛ́. U sàsà mazyi o kà bé nwú wàgbógbó gbògbò wa zú zukponu kā waa wa lò'u yi lò tá hwa fundō pyù wa zú ipyɛ̀ lá ní.<verse eid="MAT 18:9" /></para>
  <para style="s1">Atɛ́káàká yiishina dɛ̀ wà lò mìzyɛ̀</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />Ni lò nwú sáni mazyi ni káwa zō zyetifyi zukponu wàtiti hwoila hwɛ̀ yɔ̀. Dizyi m ngyi zɛ̀ yí'ni la, ázyēchɔ̀'wa hwoi dɔ hwoi wya zú Ada'm wàyii dɔ. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />Dizyi Ango Panku be mazyi u tɛ áwándó wàhwo mìzyɛ̀ lá. <verse eid="MAT 18:11" /><verse number="12" style="v" sid="MAT 18:12" />Ni hwoi gàzyíhwɛ̀ mamáni ní? Nyunu waa panku ma bā dɛ̀ idipaichɔ, zukpo yiifu'a ma lò mìzyɛ̀, u yi me áwándowànti idipainizede wa isungyɔ̀ lá ní yiishina gā ma ya yi hwāzú wàngyā ma lò mìzyɛ̀ lá yɔ̀? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Nyunuwaa u ma lò'u fyò, ḿ zɛ̀ yí'ni zyíbyɛ̀, u yi mbonwú yiishina dɛ̀ zukponu lá kā dɛ̀ idipainizede wa sungyɔ̀ wàlò mìzyɛ̀ lá ní. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Kà yi zukponu mamá waa Ada'ni wàyii dɔ lá yi fú ngo zukponu yii fu zyetifyi wàtiti hwoila ká lò mìzyɛ̀ yɔ̀ ní.<verse eid="MAT 18:14" /></para>
  <para style="s1">Angoyī'o ma sá'o wúwàbɛbɛ.</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />&lt;&lt;Nyunuwaa ngoyī'o ma sá'o wú wàbɛbɛ, ya mazyi o tà'u dà'a, ni sá'u wa dini kyó ma. Nyunuwaa u ma fá zyí'u ni, ázyíli lò nwázu manì. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Dedee u ma fá zyí'u yɔ̀ ní, ya lò pàzu kwɛɛ apà ipyɛ̀ bà wa'o, dizyi nyunu wàákyɛ̀ wa fá zyíli gyegye yii nū pà ipyɛ̀ kwɛɛ apanku isa hwoila. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Nyunuwaa u ma nghà wà fá zyí'wa ní, ni ya zɛ̀'u yii tá wàwá Shidɔ; nyunuwaa u ma kà nghà wà fá tá wàwá Shidɔ ní, wya'u sáyìna áwándó wá wúhwɔ̀, kwɛɛ áwándó pà gbā. <verse eid="MAT 18:17" /><verse number="18" style="v" sid="MAT 18:18" />&lt;&lt;Yimamala m ngyi zɛ̀ yí'ni sásá la, áwúli ma yi yɛ̄ waa ni ma lò dɛ̀ yii bēèmyɛ̄, u dɛ̀dɛ̀ yii dɔ, wa wúli ma yi yɛ̄ waa ni ma lò fɛ̀ yii bēèmyɛ̄ ní, u fɛ̀fɛ̀ yii dɔ. <verse eid="MAT 18:18" /><verse number="19" style="v" sid="MAT 18:19" />&lt;&lt;Ḿ kà zɛ̀ yí'ni yibyɛ̀ buu la, nyunuwaa ápà ipyɛ̀ yii bēèmyɛ̄ ma zɛ̀ndɛ̀ wa wúli ma yi yɛ̄ ma jāndɛ̀, Ada'm wàyii dɔ lá lò wúli yi sá yí'ni. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Ābē waa ápà ipyɛ̀ kwɛɛ ápà isa ma bē kwazɔ ishina zyì'm ní, m ngyi beli wa'wa.<verse eid="MAT 18:20" /></para>
  <para style="s1">Nwunya wàyi wyashishi yɔ̀</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />&lt;&lt;Yiibeli Bitrus be dò Yesu ma mbyeshé la, &lt;&lt;Adandō, bá yi puna waa m ngyi me dà ngoyī'm ní yi yí'u ní, nyunu waa u ma sá'm wú wàbɛbɛ, bá isumpyɛ̀?&gt;&gt; <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" />Yesu zɛ̀ la, &lt;&lt;Ḿ zɛ̀ yí'o, bá isumpyɛ̀ kɛ̀ ló yɔ̀, bá idipaisazede ndō isumpyɛ̀. <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />&lt;&lt;Yimamala, àchɔ̀ wàyii dɔ lá yi sáyìna aku wàyi fú ú hwɛ̀ wúchɔ́ wàyii vo nwunya'a lá. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Dédēwaa wa hwoi hwɛ̀ lá, wa lò pàzu wàzyī'u tɔ̄ shɔ́wàmòmbò idipaichɔndoide kwazɔ̄ ide be dò'u. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />U yi hwātɔ̄li kà yɔ̀ lá, aku yínū mazyi wa lò'u kpátí wa wà'a, wa zyē'a wa sásá wú waa u ba lá mazyi wa lò tɔ̄li hwa. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />&lt;&lt;Ànyà lá káli yii pyɛ̀'a ma vá'u la,&lt;Pà nwú wa'm, m lò tɔ̄'o yi hwa'o sásá.&gt; <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Aku wya shishi'a ma me tɔ̄li ní yí'o, u ya'a. <verse eid="MAT 18:27" /><verse number="28" style="v" sid="MAT 18:28" />&lt;&lt;Dédēwaa nyà lá támyɛ lá, u wya bugɛ'a wàzyī'u tɔ̄ wu shɔ́wàmòmbò tima lá lò wúkɛ̀ kwá dó'u huna ma yi zɛ̀ la, &lt;Hwatɔ wú waa o pà yii bé'm lá!&gt;<verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />Abugɛ nwunya lá kàli ma vá'u la, &lt;Pà nwú wa'm, m ngyi hwa'utɔ̄.&gt; <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />&lt;&lt;Dedee ànyàli nghà'a. ma lò bugɛ pà hwā tá gbógbó bà nyunu waa bugɛ lò tɔ̄li yi hwā lá. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Dédēwaa áwányà wànati fá wú wàkwò lá, anwú'wa bɛbɛ wa ya ma lò wú sásá zɛ̀ yí wasendo'wa.<verse eid="MAT 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32" />&lt;&lt;Yiibeli àwasendo bá ànyà ndɛ̀ ma zɛ̀ la,&lt; O yi nyà wàbɛbɛ, m lò tɔ̄'m wàyii ishina'o lá bwā sásá dizyi waa o vá'm lá. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />O yi wya shishi bugɛ sáyìna yiiyi waa m wya shishi'u lá yɔ̀? <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Áwúli lò be wasendo'a nwú buu lá, u yí'wa lò'u pà hwa tá mazyi wá tà'u fyì gbógbó u lò tɔ̄li hwā. <verse eid="MAT 18:34" /><verse number="35" style="v" sid="MAT 18:35" />&lt;&lt; Mamá waa Ada'm wàyii dɔ kà yi sá wa nɔ́nɔ̄ wà ma nghà wa me dà ngoyī'a ní yí'u wa nwú'a sásá ní.<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s1">Áwútàtà wu Yesu yiishina Bā wàgàgà</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Dédēwaa Yesu lò zyí hwoila zɛ̀bwā lá, u me zyoku Galili ní ma lò kà zyoku Urdun. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Abè panku lò be'uni, u lò wa dàgba yii be li. <verse eid="MAT 19:2" /><verse number="3" style="v" sid="MAT 19:3" />Áwáfaris be dò'u mazyi wa mbàwya'u. Wa mbyē'ushé la, &lt;&lt; U sàsà yii fu dɔ̀ wu Musa mazyi wánù u hwo vo bà bé wúzu mazyi ú lò ba gà wa wà'a? <verse eid="MAT 19:3" /><verse number="4" style="v" sid="MAT 19:4" />Yesu zɛ̀ la, &lt;&lt;Ni zɛ̀ dɔ̀ wu Musa yɔ̀, yiifu nyunu wàkɛ́pyɛ̀ Amà &lt;mà panku yi wánù wa wáwà,&gt; <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />ma zɛ̀ la, u lò kà mamá lá, apanku yi me da'a wa wà'a ní ma yi nàbà wà'a, áwuwa pà ipyɛ̀ hwoila lò yi kà zukponu. <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Yimamala wa hwoi panku ipyɛ̀ yɔ̀, apanku zukponu. Yimamala áwú waa Shidɔ ma lò bàzɔ, apazukponu ú ká lò fyà yɔ̀.&gt;&gt; <verse eid="MAT 19:6" /><verse number="7" style="v" sid="MAT 19:7" />Áwáfaris mbyē'ushé la, &lt;&lt;Lá yiishina yɛ̄ waa Musa pi yínū la, apanku ú yí wà'a zyèwú wàgàbā mazyi ú lò ba gà wa'u ní?&gt;&gt; <verse eid="MAT 19:7" /><verse number="8" style="v" sid="MAT 19:8" />Yesu zɛ̀ la,&lt;&lt;Musa yínū mazyi ni lò ba gà wa wà'ni yiishina nwúgbakpo ni wà lò kādɔ lá. Dedee, àndii u yi mamá yɔ̀.&gt;&gt; <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Ḿ zɛ̀ yí'ni la, sásá pà wàma lò ba gà wa wà'a, ma yiishina bákyáàkyá yɔ̀, ma ya sèbā wa wà zu kɛkɛ, u kyábá. <verse eid="MAT 19:9" /><verse number="10" style="v" sid="MAT 19:10" />Áwátu'a zɛ̀ yí'u la, &lt;&lt;Nyunu waa zyí wà wa nù ma yi mamá ní, u sàsà mazyi panku ú sèbā yɔ̀.&gt;&gt; <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" />Yesu zɛ̀ yí'wa la, &lt;&lt;Sásá panku yi zɛ̀ndɛ̀ wa zyí lá ní yɔ̀, dedee ákèké wándó waa Shidɔ lò yí'wa lá, gbaa hwoi zɛ̀ndɛ̀ ní. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Wánù wándówanati àdì'wa ba kolo yɔ̀ mamá waa wa mbà wa ní; wándówanati apanku gbaa lò wa sá mamá ní; wándówanati nghà wà gbe wà yiishina chɔ̀ wàyii dɔ lá. Sásá pà wàma zɛ̀ndɛ̀ wa zyí lá ní, ú zɛ̀ndɛ̀ wa'u.&gt;&gt;<verse eid="MAT 19:12" /></para>
  <para style="s1">Azyetifyi wàtiti wa Yesu</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Yiibeli wándówanati chá zyetifyi wàtiti be dò Yesu mazyi ú sè wa vo, ú jā'wandɛ̀. Dedee áwátu hwoi nyá wándó wàhwo wa be lá ndɛ̀. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Yesu zɛ̀ la, &lt;&lt;Ni me zyetifyi wàtiti ní mazyi wa be bé'm, ni káwa wade wa ni yɔ̀, dizyi àchɔ̀ wàyii dɔ̀ lá, yii wu panku wàhwoi mamá lá.&gt;&gt; <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />U sè'wa vo ma kwā'wandɛ̀ lá, yiibeli u ya'a.<verse eid="MAT 19:15" /></para>
  <para style="s1">Angozusɔ̀ Wàyi Ndówúchɔ́</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Wa hwoi ni, angozusɔ̀ zu be dò Yesu ma mbyeshé la, &lt;&lt;Ándótàwú, áwú wàsàsà wàni waa m ngyi sá ma yi dò nwú wàgbógbó gbògbò ní?&gt;&gt; <verse eid="MAT 19:16" /><verse number="17" style="v" sid="MAT 19:17" />Yesu zɛ̀ la, &lt;&lt;Áyɛ̄ sá waa o mbyē'mshé yiishina wú wàsàsà ní? Apazukponu wàsàsà lá yiiní. Nyunu waa o ma yi fú ó dò nwú wàgbógbó gbòbgò ní, zɛ̀ndɛ̀ wa dɔ̀&gt;&gt; <verse eid="MAT 19:17" /><verse number="18" style="v" sid="MAT 19:18" />U zɛ̀ yí Yesu la, &lt;&lt;Adɔ̀ wàni ní?&gt;&gt;Yesu zɛ̀ yí'u la, &lt;&lt;Káwa bwā panku yɔ̀, o yi kyábá yɔ̀, o yi vyúvyú yɔ̀, o yi bàpyɛ̀ panku yiishina zyígé yɔ̀, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />yí da'o wa yī'o hwɛ̀ mazyi o shó nɔ̀beshí'u sáyìna yiiyi waa o shó di'u lá.&gt;&gt;&gt; <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />Angozusɔ̀ li zɛ̀ la, &lt;&lt;Sásá wú wàhwoi lá m ngyi sá'wa, áyɛ̄ waa m kà sá yɔ̀ ní?&gt;&gt; <verse eid="MAT 19:20" /><verse number="21" style="v" sid="MAT 19:21" />Yesu zɛ̀ la, &lt;&lt;O ma fú ó lò kà pà wàlò gyila ní, ya lò wú waa o ba sásá lá kpátí mazyi ó lò banjili yí wándóchɛ̀, o lò yi kà ndówúchɔ́ yii dɔ. Yiibeli o pi be be'mni. <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />Dédēwaa ngozusɔ̀ li fá mamá lá, u ya'a wa nwútòtò dizyi u yi ndówúchɔ́ wàshuwɔ̀. <verse eid="MAT 19:22" /><verse number="23" style="v" sid="MAT 19:23" />Yiibeli Yesu zɛ̀ yí áwátu'a la, &lt;&lt;Ḿ zɛ̀ yí'ni zyíbyɛ̀, u yi tòtò mazyi ándówúchɔ́ ú kà fu chɔ̀ wàyii dɔ lá. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />M kà mbyā wàyi zɛ̀ la, u yi kàdì buu má yí ndówúchɔ́ wàkàfu Ndō chɔ̀ àwu Shidɔ lá kā waa wenārī yi kàfu zú bùnyī kpende lá ní.&gt;&gt; <verse eid="MAT 19:24" /><verse number="25" style="v" sid="MAT 19:25" />Dédēwaa áwátu fá mamá lá, agbashu lò'wa pà, wa mbyeshé la, &lt;&lt;Ánɔ̄ pi yi dò nwàzu ní?&gt;&gt; <verse eid="MAT 19:25" /><verse number="26" style="v" sid="MAT 19:26" />Yesu lò zú jā wa din ma zɛ̀ la, &lt;&lt;Wa panku u yi tòtò, dedee wa Shidɔ lá, áwú sásá yi sá.&gt;&gt; <verse eid="MAT 19:26" /><verse number="27" style="v" sid="MAT 19:27" />Bitrus zɛ̀ la, &lt; Áwui, i me wú sásá ní ma be'uni! Áyɛ̄ waa i pi hwoi dò wui ní?&gt;&gt; <verse eid="MAT 19:27" /><verse number="28" style="v" sid="MAT 19:28" />Yesu zɛ̀ yí wa la, &lt;&lt;M ngyi zɛ̀ yí ni zyíbyɛ̀, adede wàyi be yii pyɛ̀ lá, nyunu waa Ango Panku ma shí ishina dù wu chɔ̀ wàbā hwɛ̀ má, áwuni wándó wàbe'mni lá dedee hwoi shí ishina dù wu chɔ̀ idezepyɛ̀, ma hwoi hwà chɛ Isrela idezepyɛ̀ kwɛ́. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Wàkà beni sásá pà wàma me ndō ní, kwɛɛ zyēyī'a wàwunù, kwɛɛ zyēyī'a wàwuwà, kwɛɛ ada'a, kwɛɛ áyī'a, kwɛɛ zyē'a, kwɛɛ zyoku wànànɛ̀'a yiishina'm ní, u yi dò kāgbá idipaichɔ ndō idipaichɔ, u kà yi zyīfí nwú wàgbógbó gbògbò. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Dedee apanku buu wándó wàkɛ́pyɛ̀ lá, hwoi kà wándó wàkɛ̄ɛ̀kɛ̄, wándó wàkɛ̄ɛ̀kɛ̄ lá, hwoi kà wándó wàkɛ́pyɛ̀.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s1">Wándó wàhwoi sá kolo yiifu dā</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />&lt;&lt; &lt;Àchɔ̀wàsáàsá wàyii dɔ lá yi mamá. Nyunu zu àwàsendo zumyɛ pupunɔ mazyi ú hwo wándó sákolo àwu banji wàsá'u kolo yiifu dā'a. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />U zɛ̀ndɛ̀ wàhwā'wa tɔ̄ banji waa wa hwoi hāwātɔ̄ àwu nyunu zukponu lá, ma lò'wa sù ya hwoi sá'u kolo yiifu dā'a.<verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />Dédēwaa shɔ́ isùngyɔ̀ sá lá, u zumyɛ ma dò wándó wanati sā hwoi ti hwoi sá wuzukponu yɔ̀. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Andó dā zɛ̀ yí wa la,&lt; Awuni dedee ni ya dā'm mazyi ni sá kolo, m ngyi hwa'nitɔ wàsàsà. &gt; <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Yimamala wa lò ya.</para>
  <para style="p" vid="MAT 20:5">&lt;&lt; Andó kà mbya'a zumyɛ nyitò wa shɔ́ isā, ma hwo wándó kolo. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Gbógbó shɔ́ ichɔ̄ wànyizɔ u kà mbyā wàzumyɛ ma wya panku sā hwoili. U mbye'wa shé la, &lt; Áyɛ̄ sá wa ni sā hwoili kyaakya hwoi sá wuzukponu yɔ̀ ní?&gt;<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />Wa zɛ̀ yí'u la, &lt;&lt; Yiishina pazukponu yí'i kolo yɔ̀ lá,&gt;</para>
  <para style="p" vid="MAT 20:7">&lt;&lt;U zɛ̀ yí'wa la, &lt; Áwuni dedee ni ya sá kolo yii dā'm.&gt;<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />&lt;&lt; Dédēwaa nyunu lò kwò la, ándó wàbā dā lá zɛ̀ yí ápà wàyi jā'uzú yii dā lá la, &lt;Bá wándó sákolo ndɛ̀ mazyi ú hwa'watɔ̄ banji'wa, hwātɔ̄ zu ishina wándó kɛɛkɛ lá bē ishina wándó wàkɛ́pyɛ̀.&gt;<verse eid="MAT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9" />&lt;&lt;Áwándó sá kolo waa wa lò'wa yiifu àshɔ́ ichɔ̄ lá ánɔ́nɔ̄ be pà banji kolo àwu nyunu zukpo. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Yimamala dédēwaa áwándó waa wa lò'wa kolo kɛ́pyɛ̀ lò be lá, wa lò nwú sā ni la, wa hwoi pà banji wàbuu. Dedee, abanji'wa kà yi zunkponu wa wándó waa wa hwo wa kɛɛkɛ lá. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Dédēwaa wā lò banji pà lá, wa nwínwí yii niki wàsendo'wa. <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />&lt; Ápà hwoila waa wa hwō'wa kɛɛ̀kɛ lá, sá kolo àwu shɔ́ zukponu kɛ̀ló,&gt; wa zɛ̀ la, &lt;o hwa'watɔ̄ kà gyegye wa'i, áwui wàtò betò sá kolo wa bàpyù yii nyunu kwò nyunu lá.&gt;<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />U zɛ̀ yí pà zu yiifu áwándó sá kolo lá la, &lt;&lt; Abugɛ'm, m gba zyī bētò'o yɔ̀. Abanji kolo wu nyunu waa o zɛ̀ndɛ̀ lá waa m hwā'otɔ̄ ní yɔ̀? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Pà banji'o mazyi ó ya'o. M shó wàhwā ndó waa m kōlò'u kɛ̄ɛ̀kɛ̄ lá gyēgyē wa wuo. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />M ba gba wa sá wú waa nwú m shó wa banji m yɔ̀? Kwɛɛ o yi sápa wa m yishina m ba nwú wa sásɔ̀ la?&gt;<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />&lt;&lt; Yimamala, wàkɛɛkɛ lò kā wàkɛ́pyɛ, wàkɛ́pyɛ̀ lò kà wàkɛɛkɛ.&gt;&gt;<verse eid="MAT 20:16" /></para>
  <para style="s1">Yesu Kambyaa Zɛ̀zyí Kí a</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Dédēwaa Yesu yi kà Urushalima la, u lò áwátu a hwo ya kìká ma zɛ̀ yi wa la, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />&lt;&lt; I hwoi né ya Urushalima, yiibe waa wàlò Ngo Panku ndavo yí áwádakumbwa wàshuwɔ̀ wa áwándó tà Dɔ̀ wu Musa mazyi wá hwà'u kwɛ́ wá lò'u bwā. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />Wa lò'u yi kōlò yí wándó wa hwoi Áwáyahuda yɔ̀ la mazyi wa hwo u wɔ̀, mazyi wa zɛ̀ yɔ̀, wa kà lò'u dábà bé fyī. Yifu nyunu wàhwāsa u lò yi dà ma yi hwonwu! &gt;&gt;<verse eid="MAT 20:19" /></para>
  <para style="s1">Avává Wú Yi</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Yibeli, áyī wu zyē Zabadi bē dò Yesu wa zyé a, ma lò kunuba wè zyoku ma vá'u.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />Yesu mbyē'u shé la, &lt;&lt; Áyɛ̄ wa o yi fu ni? &gt;&gt;</para>
  <para style="p" vid="MAT 20:21">U zɛ̀ la, &lt;&lt;Ngmángbá yi zyē m ipyɛ̀ hwoila, apazu ú shí zyɛ̄ vonsɔ́, apazu ú shí zyɛ̄ vonzyī ndō chɔ̀'o. &gt;&gt;<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />Yesu zɛ̀ yí'wa la, &lt;&lt; Ni gba yì wú waa ni hwoi vá lá yɔ̀, ni hwoi wā gè àwu fyì waa m be yi wā lá kà?&gt;&gt;</para>
  <para style="p" vid="MAT 20:22">Wa zɛ̀ yí'u la, &lt;&lt;I hwoi wā kà.&gt;&gt;<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Yesu zɛ̀ yi wa la, &lt;&lt; Ni hwoi wa yiifu gè'm, wa shí vonsɔ m kwɛɛ vonzyī m wa ba gba wa zɛ̀ wa li yɔ̀. Ada m wa yi dɔ la bá mbya bē li yishina wándó wa u shé la ni.&gt;&gt;<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Dédēwaa áwátu'a kwazɔ ide lò zyíli fá lá, wa hwo sáàpá wa Yakubu wa Yohana. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Yesu lò wa bándɛ̀ gbàyi ma zɛ̀ yí'wa la, &lt;&lt; Ni yìnɔ̀ la, ádóshī wándó wàhwoi Áwáyahuda yɔ̀ lá bā gba yiishina'wa, áwáshuwɔ̀'wa hwoi tà gba yishina'wa dúdú. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />U lò yi kà mamá yiifu'ni yɔ̀, ápà wàma fú ú lò ndó wàshuwɔ̀ yiifu'ni ní, ú lò dia kà nyà àwu wándó wànati, <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />ándó wà ma yi fú ú lò kà wàkɛ́pyɛ̀ u lò kà kɛ́n u kɛ́pyɛ̀ lò kà nyà <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />sáyìna Ango Panku, wàbe mazyi wá wá'u yɔ̀ lá, dedee u be wàwá panku ma lò nwú yí wàhwɛ̄ panku buu.&gt;&gt;<verse eid="MAT 20:28" /></para>
  <para style="s1">Abòzú Ipyɛ Wyabe</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Dédēwaa Yesu wa áwátu'a me Jeriko ní lá, àbè buu be'u ni. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Abòzú pàipyɛ̀ shí hwoi nyashɔ, waa wā fá la Yesu ba yi nwázū ni, wā kōlò huna dɔ ma zɛ̀ la,&lt;&lt; Wasendo, ngo u Dawuda, wya shishi yi!&gt;&gt;<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Abe li bwà wa vo ma zɛ̀ yi wa la wa bàndɛ̀, dedee wā kwá huna kwaani ma zɛ̀ la, &lt;&lt;Wasendo , ngo u Dawuda, wya shishi yi!&gt;&gt;<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Yesu sāli ma bá'wa ndɛ. U mbye wa shé la, &lt;&lt; Áyɛ̄ waa ni hwoi fú mazyi ḿ sá yí'ni ní?&gt;&gt;<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />Wa zɛ̀ndɛ̀ la,&lt;&lt;Wasendo!&gt;&gt; &lt;&lt; I hwoi fú í wyabe.&gt;&gt;<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Yesu nyézú wya'wa, ma wya shishi'wa ma gwà'wa vo yii zú. Yiibebeli, wa wyabe ma be'u ní.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s1">Yesu Kà Urushelima wa Gwá</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Dédēwaa Yesu wa áwátu'a lò be bà Urushelima lá, wa ya Betfage yii bé gā wu fyī zu, Yiibeli Yesu chō áwátu'a pà ipyɛ̀ chɔ̀, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />U zɛ̀ yí wa la, &lt;&lt; Ni kà gá wàtí wàyii pyɛ̀ ni la, yiibeli ni hwoi wya lēbànā wa ngu'a dɛ̀dɛ̀. Ni lò wa fɛ̀ mazyi ni lò'wa chá bē yí'm. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Apà wàma zɛ̀zyí zu ní, ni zɛ̀ yí'u la, Adandō gbaa yi fú ní, u lò yi meni yí ni.&gt;&gt;<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Áwúli sá mamá mazyi zyí waa ándówyàpyɛ̀ zɛ̀ lá ú lò gyila:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />&lt;&lt; Zɛ̀ yí Áwáisrela la, Wya, aku'ni lò ishina té'ni yi bē manì,</para>
  <para style="q1" vid="MAT 21:5">u yi ndó lò ishina dɔ yɔ̀ u né ishina ngu lēbànā,</para>
  <para style="q2" vid="MAT 21:5">yiishina túkpá, yiishina ngu lēbànā. &gt; &gt;&gt;<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Áwátu'a ya ma sá yiiyi waa Yesu zɛ̀ yí'wa la, wa sá lá. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Wa lò lēbànā wa ngu chá be, ma lò tukpá byá'wa dì, Yesu lò shí shina'a. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Abè panku hwo tukpá'wa hwoi byá nyashɔ, wándówanati gé zyèwú hwoi byá nyashɔ. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Abè hwoi pyɛ̀ wa wándó wàhwoi niki'a lá hwoi dákito, Osana, Ango wu Dawuda!&gt;&gt; &lt;&lt;Avosɔ̀ yi wu wándó wàbe yiifu zyì Adando lá!&gt;&gt;</para>
  <para style="q1" vid="MAT 21:9">&lt;&lt; Í ngya Shidɔ!&gt;&gt;<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Dédēwaa Yesu kà Urushelima lá, sásá panku wàhwoi gáwàshūwɔ̀ lá hwoi mbyē shé la,&lt;&lt;U yi nɔ̄ ní?&gt;&gt;<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Abèpanku zɛ̀ la, &lt;&lt;Ahu gbaa yi Yesu ndówyàpyɛ̀ wàzu Nazaret yii Galili lá ní.&gt;&gt;<verse eid="MAT 21:11" /></para>
  <para style="s1">Yesu yii Táwàwáshidɔ</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Yesu kà fu táwàwáshidɔ ma lò wándó wà hwoi kpátí wú, wa wándó wa hwoi hwɛ̄ wu lá ká sásá. U lò tebul wu wándó zá banji wa dù wu wándó kpátí ndàkpò vékà beli. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Yesu zɛ̀ yi wa la,&lt;&lt; U tāàtā yiifu fā Shidɔ la,&gt;&gt; &lt;&lt; &lt;Wa bá ndō m la, ndō wa jāndɛ̀, ni lò'u kà ndō vyú.&gt; &gt;&gt;<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Áwábòzú wa áwákábá bē dò Yesu yii táwàwáshidɔ , Yesu lò wa dàgba. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Dédēwaa dākúmbwá wà shuwɔ̀ wā áwándótà dɔ̀ wu Musa wya wu gbàshú waa u sá kà wa yiiyi waa zyētíìfyí hwoi dákito yi táwàwáshidɔ la,&lt;&lt; Ossana yi Ngo wu Dawuda,&gt;&gt;la, wā hwo sáàpá.<verse eid="MAT 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16" />Wa mbyē Yesu shé la, &lt;&lt;O fá zyí waa zyē hwoila hwoi zɛ̀ lá?&gt;&gt;Yesu zɛ̀ la, &lt;&lt; M fá, ni zɛ̀ yiifu fā ló yɔ̀,</para>
  <para style="q1" vid="MAT 21:16">&lt;&lt;Zu nū zyētíìfyí wa zyēwàmyɛɛ</para>
  <para style="q2" vid="MAT 21:16">wa hwoi fá ngyaangya zyí'u yɔ̀?&gt;&gt;<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Yesu me'wa ní ma zumyɛ̄ yiifu gá ma ya Betani, ma ná be li kyàbe.<verse eid="MAT 21:17" /></para>
  <para style="s1">Yesu Hwā Fyī Gbankòlò nū</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Dédēwaa bē lò kyà waa u yi kàsɛ̄ lá, ámbɔ̄ bwā'u. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />U wya fyī gbankòlò sā yii li bà nyàshɔ, u ya bé fyī gbankòlò lá, dedee u wya wúzu yiiní yɔ̀, ákèké zyèwú waa u wyà ni. Yimamala, u zɛ̀ yí fyī lá' la, &lt;&lt; O yi nwāngyì gɛ̀ yɔ̀!&gt;&gt; Yiibebeli fyī gbankòlò lá lò nwɔ̄.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Áwátu'a wya wúli mamá lá, àgbashu lò'wa pà. Wa mbyeshé la, &lt;&lt; Áyɛ̄ sá waa fyī gbankòlò lá lò nwɔ̄ mɔmɔ mamá ní?&gt;&gt;<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />Yesu zɛ̀ la,&lt;&lt; M ngyi zɛ̀ yí'ni zyíbyɛ̀, ni ma yíbyɛ̀ ma mɛ̀nwú yɔ̀ ní, ni hwoi bā gba wàsá wú waa m sá fyī gbankòlò lá. Kàwa yi wàyila tànwú'a yɔ̀, dedee ni hwoi bā gba kwā wàzɛ̀ yí gā la, &lt;Dàdɔ mazyi ó lò diu tá hwa fu núkù,&gt; u kà yi sá mamá. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Ni ma yíbyɛ̀ ní, ni hwoi dò sásá wú waa ni hwoi mbyeshé lá yiifu ndɛ̀wàjāàjā.&gt;&gt;<verse eid="MAT 21:22" /></para>
  <para style="s1">Wa Hwoi Táwàshú Yiishina Gba Yesu</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Yesu kà fu táwàwáshidɔ, dédēwaa u yi tà wu la, áwádakumbwa wàshuwɔ̀ wa wácha bē dò'u ma mbye'u shé la, &lt;&lt;Wa gbā wàni waa o yi sá wú wàhwoila ní, ánɔ̄ kà yí'o gba lá ní?&gt;&gt;<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Yesu zɛ̀ la, &lt;&lt; M ngyi mbye'ni shé zū. Ni ma zɛ̀'mndɛ̀ ni ní, m ngyi zɛ̀ yí'ni gba waa m ngyi sá wú wàhwoila wa'u lá. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Yohana dò gba wàsá batisma zu be wàni ní? U zu be Shidɔ kwɛɛ u zu be panku?&gt;&gt;</para>
  <para style="p" vid="MAT 21:25">Wa zɛ̀zyí wa di'wa ma zɛ̀ la, &lt;&lt; I ma zɛ̀ la, &lt;U zu dɔ,&gt;u yi mbyē yi shé la, &lt; Áyɛ̄ sá waa ni zɛ̀ndɛ̀ wa'u yɔ̀ ni?&gt; <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />I ma zɛ̀ la &lt;U zu be panku &gt; i hwoi sázī panku, dizyi wa hwoi zɛ̀ la, Yohana yi ndówyàpyɛ̀.&gt;&gt;<verse eid="MAT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27" />Wa zɛ̀ yi Yesu la, &lt;&lt; I ba yìnɔ̀ yɔ̀.&gt;&gt;</para>
  <para style="p" vid="MAT 21:27">Yiibeli, Yesu zɛ̀ la,&lt;&lt; Ami dedee m ngyi zɛ̀ yi ni bē waa m dò gbā wàyi sá wu hwoila yɔ̀.<verse eid="MAT 21:27" /></para>
  <para style="s1">Atɛ́káàká Yiishina Zyewánù Ipyɛ̀</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />&lt;&lt;Tama, áyɛ̄ waa ni wya ni? Apazu ba zyē wánù ipyɛ̀. U ya ma dò ndó wàkɛ́pyɛ̀ ma zɛ̀ yí'u la, &lt;Ango, ya sá kolo zyìná yiifu dā.&gt;<verse eid="MAT 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29" />Angoli zɛ̀ la, &lt;&lt;&lt; M ngyi ya yɔ̀,&gt; u kàsɛ̄ ma gàzyíhwɛ̀ ma ya.<verse eid="MAT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30" />&lt;&lt; Ada'a mbyā wàya dò ngo wàhwapyɛ̀ ma kà zɛ̀ yi'u mamá. &lt;Ada m ngyi ya,&gt; dedee u ba ya yɔ̀.<verse eid="MAT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31" />&lt;&lt; anɔ̄ yiifu zyē ipyɛ̀ hwoila sá wu waa da'a yi fú lá ni?&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">Wa zɛ̀ la, &lt;&lt;ándó wàkɛ́pyɛ̀ lá&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">Yesu zɛ̀ yi wa la,&lt;&lt; M ngyi zɛ̀ yi ni zyíbyɛ̀, áwándó pà gbā wa áwándó wàhwoi sálákpá lá hwoi kà ndō Shidɔ kɛ́pyɛ̀ yi ni ní. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Yohana ándó sá baptisma bē dò ni mazyi u tà ni nyashɔ wà gyēgyē, ni ngha wa zɛ̀ndɛ̀ wa'u, kwa wu hwoila waa ni wya sásá lá, ni ngha wà me wúwàbɛbɛ ní, ma kà zɛ̀ndɛ̀ wa'u yɔ̀.<verse eid="MAT 21:32" /></para>
  <para style="s1">Atɛ́káàká yiishina Wándónànɛ̀</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />&lt;&lt;Yesu zɛ̀ la, ni gā chùchú mazyi ni kà fá tɛ́wàkáàká zu: apazu bā dā wà nà nwānwāàfyī. U lò'u dó shèkwà wa kō, u kā shī wú wà pyí zyà nwānwāàfyī, ma myī tá wàshí ní wàjāzú yii dā. Ma lò yí wa dizyi wàsá kolo yii ní ma hwātɔ̄ ma ya'a kyū. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Dédēwaa nyunu wàbē wúzyī lò be bà dì lá, u chō áwányà'a chɔ̀ mazyi wá ya pà ánwāànwafyī'a yii bé wándó waa u lò dā yí'wa mazyi wá hwātɔ̄ lá.<verse eid="MAT 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35" />&lt;&lt;Áwándó waa u lò dā kwà wa vo la lò nwunya'a hwoila sásá pà; wa dá ándó zu bwà, ma lò ándó zu bwā, ma tá ándó wàhwasa lá gɔ́. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Yiibeli u kà mbya'a chō áwányà ndabe kāgbá wándó wàkɛpyɛ̀ lá ya dò wa, Áwándó waa u lò dā kwà wa vo lá kà mbyā wàsá wú waa wa sá wándó wàkɛ́pyɛ̀ lá. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Wàkɛɛkɛ lá u chō ngo'a chɔ̀ ya dò wa. U zɛ̀ la&lt; M yìnɔ̀, wa hwoi wya ngo'm wa hwɛ̀.&gt;<verse eid="MAT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38" />Dédēwaa wándó waa u lò dā kwà wa vo lá wya ngoli la, wa zɛ̀ yí dì wa la,&lt; Andó wà yi zyīfí lá gbaa yi nì. Ni be, mazyi í lò'u bwā mazyi í lò fí'a zyī.&gt; <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Yimamala, wa lò'u kōlò ma lò'u tá zumyɛ yiifu dā ma lò'u bwā.<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />Yesu mbye'wa shé la, dédēwaa ándó dā ma lò kàsɛ̄, áyɛ̄ waa u yi sá panku hwoila waa u lò dā kwà wa vo lá ní?&gt;&gt; <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />Wa zɛ̀ yi'u la,&lt;&lt; Aki wàbɛbɛ waa u yi bwā panku wàbɛbɛ hwoila yi bwā, ma lò dā li yi yí wándó wàhwoi lò ma hwoi hwātɔ̄ lá, dédēwaa nyunu wà bē wúzyī ma lò sá wa hwoi yí'o wú wà yi wua.&gt;&gt;<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Yesu zɛ̀ yi wa la,&lt;&lt; Ni zɛ̀ yiifu fā ló yɔ̀:</para>
  <para style="q1" vid="MAT 21:42">&lt;&lt; &lt;Agɔ́ waa wándó myī tá nghà lá</para>
  <para style="q2" vid="MAT 21:42">gbaa lò yi kà gɔ́ wà sàsà kā ní;</para>
  <para style="q1" vid="MAT 21:42">avo kolo wu Adandō gbaa yiinì,</para>
  <para style="q2" vid="MAT 21:42">u kà lò kà wú gbàshú yí zú'i&gt;?<verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />&lt;&lt;Yimamala,Yesu zɛ̀ la, m ngyi zɛ̀ yí'ni la, wa lò ndō chɔ̀ àwu Shidɔ yi kōlòdɔ yiibe'ni ma lò yi yí wándó wàhwoi nwā ngyìfyī lá. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Andó wa ma kwòli yiishina gɔ́ li lò bwā, ándó wa gɔ́ li ma kwòli sè'u u lò'u yi bwā.&gt;&gt;<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Dédēwaa wácha wa Áwáfaris fá zyí waa Yesu sásá lá, wa yì'wanɔ̀ la u wā wa. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Wa hwāzú nyashɔ mazyi wa lò Yesu pà, dedee wa hwo kàzi panku dizyi wa zɛ̀ndɛ̀ la u yi ándówyàpyɛ̀.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Atɛ́káàká yishina Bā</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Yesu kà zɛ̀zyí wa tɛ́káàká yí panku la, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />&lt;&lt;Àchɔ̀ wàyii dɔ lá, yi sáyìna aku zū wàlò wú dùdù sábwā wàsèbā ngo'a lá. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />U chō áwányà'a chɔ̀ mazyi wáya bá wándó waa u bá'wāndɛ̀ dùdù lá ndɛ̀, dedee áwándó waa u bá'wāndɛ̀ dùdù lá gba bē yɔ̀.<verse eid="MAT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4" />&lt;&lt;Yimamala u kà chō áwányà'a wándó wànàtī chɔ̀ ya bé áwándó waa u bá'wāndɛ̀ dùdù lá la, &lt;Tàma m lò wúzyī dùdù'm mbyā ló, m gé nɛ̄'m wàkwàkwà lá ma lò fā, m lò wúsásá mbyā ló. Ni bē dùdù wàsèbā!&gt;<verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />Dedee áwándó waa u bá'wāndɛ̀ dùdù lá nghà'wa zyí'a, ma hwoi sá kolo'wa, ápazu ya'a dā, ápazu ya'a bé wúchɛ́'a yii tí. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Wándó wànàti lò áwányà pà ma dá'wa bwà ma lò'wa bwā. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Aku lò sáàpá, yimamala u sù soja'a ya lò wándó wàlò áwányà'a bwā lá, bwā ma lò'wa gá sōpyù. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Yiibeli u lò áwányà'a bándɛ̀ ma zɛ̀ yí'wa la, &lt;M lò wú dùdù'm wàsèbā mbyābwā, dedee wándó waa m bá'wa ndɛ lá, gba vyā wa'u yɔ̀. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Tàma ni ya nyashɔ mazyi sásá wándó waa ni ma wya ní, ni bá'wa ndɛ̀.&gt; <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Yimamala, áwányà zumyɛ ya kpandala ma hwo panku sásá waa zú'wa wya lá, bándɛ̀ gbàyi, kwā wándó wàbā nwú wàsàsà wa wándó wàbā nwú wàbɛbɛ gbógbó be wàsèbāli lò mwɛ̀ wa panku.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />Dedee dédēwaa ku kàfu mazyi ú wya ápanku lá, u wya pàzu gba wè wúchɛ́ dùdù wàsèbā yɔ̀. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Aku mbye'u shé la, &lt;Abugɛ o sáni ma kàfu yii maa wa wúchɛ́ dùdù wàsèbā yɔ̀ ní?&gt; Dedee ápalá zɛ̀zyí yɔ̀.<verse eid="MAT 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13" />&lt;&lt;Yiibeli, akù zɛ̀ yí áwányà la, ni lò'u vo wa bá dɛ̀, mazyi ni lò'u tá hwā myɛ̄ yii be wàsèfē. Yii beli u yi shèki ma yi pā nyí'a. <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />Yesu lò zyí kē la, &lt;&lt;Àndɛ̀ bá panku buu, dedee ápanku tímá waa wa shē'wa ní.<verse eid="MAT 22:14" /></para>
  <para style="s">Àgbā Wàhwā yí Kesa</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />&lt;&lt;Áwáfaris ya bwābɔ̄ wàchá Yesu chɔ̀ wa shéwàmbwēèmbwē. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Yiibeli wa chō áwátu'a wa panku Hiridus dùdù. Wa zɛ̀ la, &lt;&lt;Andótàwú,&gt;&gt; i yìnɔ̀ la, o yi zɛ̀zyí byɛ̀, o yi tà wú byɛ̀ waa Shidɔ fú ápanku ú sá lá, ma yi wèbēbè ishina wú waa wándó wànàti hwoi gàhwɛ̀ lá yɔ̀, dizyi o yi fá zyí pàzu ishina áhwɛ̀'a yɔ̀. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Zɛ̀ yí'i, o wya mamánī ní? U yi wú wàbɛbɛ yiibe Dɔ̀'i wàhwā gbā yí ku Roma kwɛɛ u bɛbɛ yɔ̀ ní?&gt;&gt;<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Dedee, Yesu lò áwú wàbɛbɛ waa wa nwā yiifu nwú'wa lá yìkyà, ma zɛ̀ la, &lt;&lt;Awuni áwágyɛ́! Áyɛ̄ sá waa ni hwoi ngāngɛ̄ wàchá'mchɔ̀ ní? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Ni tà'm banji wàhwā gba wa'u.&gt;&gt; Wa lò banji tɛ̄ zumyɛ yí'u, <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />u mbyē'washé la, &lt;&lt;Ázú wa zyì nɔ̄ hwoi lá?&gt;&gt; <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />Wa zɛ̀ yí'u la, &lt;&lt;Àwu Kesa.&gt;&gt;</para>
  <para style="p" vid="MAT 22:21">Yiibeli Yesu zɛ̀ yi'wa la, &lt;&lt;Ni hwā Kesa tɔ̄ áwú wàyiwu Kesa, mazyi ni hwā Shidɔ tɔ̄ áwú wàyiwu Shidɔ.&gt;&gt;<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Waa wa fá mamá lá, gbàshú lò'wa pà. Yiibeli wa me'u ní ma ya'wa.<verse eid="MAT 22:22" /></para>
  <para style="s">Ashé Wàmbyēèmbyē ishina Ádàdɔ Ándówàhūùhū</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Kà yiifu nyunu lá zukponu, Áwásadus wànàti be dò Yesu ma zɛ̀ la, ápanku ma lò hu wa hwoi dàdɔ yiibe ki yɔ̀. <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />Wa zɛ̀ lā, &lt;&lt;Andótàwú, Musa zɛ̀ la, áwánù wàma bā ngo yɔ̀ ma lò hu ní, ángoyī'a ú lò wàki bà kɛ́nkɛ́n mazyi wámbà zyē yí ándó wàlò hu lá. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Tàma i bā ázyēyī wánù isumpyɛ hwoi maa. Ándó wàyi wáshuwɔ̀ lá gbe wà ma lò hu bā zyē yɔ̀, yimamala u me àwàki'a ní yí ngoyī'a. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Áwú lá zukponu kà kwò yiishina ándówàhwāpyɛ̀, ma kwò yiishina ándówàhwāsa, gbógbó ya ishina ándó wàhwāísumpyɛ. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Áwú wàkɛ̄ɛ̀kɛ̄, àwà lá lò hu. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Tàma, yiifu nyunu waa pànku wàhūùhū hwoi dàdɔ lá, àwà lá lò yi kà wu nɔ̄ ní? Dizyi sásá'wa sèbā wa'u.&gt;&gt;<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Yesu zɛ̀ yí'wa la, ni ngyāzú! ishina ni yì zyí Shidɔ wa ágba Shidɔ yɔ̀ lá. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Dizyi nyunu waa panku wàhūùhū hwoi dàdɔ lá, áwánù hwoi sèbā yɔ̀, áwáwà hwoi sèbā yɔ̀, wa hwoi kà sáyìna ázyēchɔ̀ wàhwoi dɔ lá. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Tàma, sáyìna àwu dàdɔ áwándó wàhūùhū lá, ni zɛ̀ wú waa Shidɔ zɛ̀ yí'ni yiifu āfā lá yɔ̀? U zɛ̀ la, <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />&lt;M ngyi Shidɔ àwu Ibrahim, Shidɔ àwu Ishaku, Shidɔ àwu Yakubu.&gt; U yi Shidɔ àwu wándó wàhwoi zyoo lá, u gbā yi Shidɔ àwu wándó wàhūùhū yɔ̀.&gt;&gt;<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Dédēwaa àbè panku fá mamá lá, àgbashu lò'wa pà.<verse eid="MAT 22:33" /></para>
  <para style="s1">Àdɔ̀ Wàshūwɔ̀ Kā</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Dedee waa Áwáfaris fá la, Yesu yí Áwásadus lò bàndɛ̀ lá, wa lò diwa bándɛ̀ gbàyi, <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Apazu wàyì Dɔ̀ Musa yiifu’wa lá, chá Yesu chɔ̀ wa shéwàmbyēèmbyē la, <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />&lt;&lt;Andótàwú, àdɔ̀ wàni shuwɔ̀kā yiifu Dɔ̀ ní?&gt;&gt;<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />Yesu zɛ̀'undɛ̀ ní la, &lt;&lt; &lt;Ni shó Adando Shidɔ'ni wa nyùnwú'ni sásá, wa nwúdì'ni sásá, wa ázyíhwɛ̀wàgàgà'ni sásá. <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Wàyila gbaa yi dɔ̀ wàkɛ́pyɛ̀ ma kà yi dɔ̀ wàshūwɔ̀kā lá ní.” <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Wàhwāpyɛ̀ kà yi sáyìna wàkɛ́pyɛ̀ lá, &lt;Shó áwánɔ̀beshí'u sáyìna yiiyi waa o shó diu lá.&gt; <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Àdɔ̀ ipyɛ hwoila waa Àdɔ̀ Musa wa áwútàtà áwándówyapyɛ̀ hwoi be wàni ní.&gt;&gt;<verse eid="MAT 22:40" /></para>
  <para style="s">Yesu Yi Ngo Nɔ̄ ní</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Dédē waa Áwáfaris bē gbàyi yii bē zukponu lá, Yesu mbye'washé lā, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />&lt;&lt;Ni gàzyíhwɛ̀ ishina Kristi mamáni ní? Ni bá'u la ngo nɔ̄?&gt;&gt;</para>
  <para style="p" vid="MAT 22:42">Wa zɛ̀ yí'u la, &lt;&lt; U yi ngode kpendu àwu Dawuda,<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Yesu zɛ̀ yí'wa la, &lt;&lt;Áyɛ̄ hwā waa Nídì yí Dawuda bá'u la, &lt;Adando ní&gt;? Dizyi Dawuda zɛ̀ la,<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />&lt;&lt; &lt;Adando zɛ̀ yí Adando'm la,</para>
  <para style="q2" vid="MAT 22:44">&lt;&lt; Shí vonzyī'm</para>
  <para style="q1" vid="MAT 22:44">gbógbó ḿ lò</para>
  <para style="q2" vid="MAT 22:44">wàzé'o dó zyoku pátābá'o.&gt;<verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Nyunu waa Dawuda ma bá'u la, Adando&gt;, Mamánī waa Kristi pi lò yi kà ngo Dawuda ní?&gt;&gt;<verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />Apazukponu yiifu'wa zɛ̀zyí zū kà yɔ̀, kà dà zū nyunu li yapyɛ̀ ápazukponu ngōnwú ma mbyē'ushé gɛ̀ yɔ̀.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s1">Yesu Fù Dìnyà Wándótà Dɔ̀ Wa Áwáfaris</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Yi beli Yesu zɛ̀ yi abe panku wa áwátu'a lā: <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />&lt;&lt; Áwándótà Dɔ̀ wu Musa wa Áwáfaris shí yiishina dù wu Musa. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Yimamala, ni hwoi zɛ̀ndɛ̀ wa wā ni hwoi sá wú sásá waa wa hwoi zɛ̀ yí'ni lá yɔ̀. Dedee ni kà sá wú waa wa hwoi sá lá yɔ̀,dizyi wa hwoi sá wu waa wā hwoi zɛ̀ lā yɔ̀. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Wa hwoi chá panku wúchɛ́ wàndabɔ, dedee wa hwoi sá wuzukponu wà sázá'wa ní yɔ̀.<verse eid="MAT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5" />Sásá wu waa wa hwoi sá lá hwoi wu zú mazyi panku wā wya: Wā hwo vyù wa fā wu zyí Shidɔ tā yi dɛ bà mopyɛ̀ wa, ma hwoi dɛ nú vo wúchɛ́ wa; <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Wa shó gwá yi be dùdù wā shó wa shí dù yi táwàkwāshī; <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />wa hwoi shó mazyi wā tá'wamángbá yii tí, wa hwoi fú panku wa bá wa la, &lt;Áwándótàwú.&gt;<verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />&lt;&lt; Ni káwa zɛ̀ndɛ̀ mazyi wá bá'ni la, &lt;Áwándótàwú&gt; yɔ̀, dizyi ni ba Ndótàwú zukponu, ni hwoi zyēyī. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Yii bēèmyɛ̄ ni káwa bá pazukponu la &lt; ada &gt; yɔ̀, dizyi Ada ni zukponu waa ni bā ni, u yii dɔ. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Ni káwa zɛ̀ndɛ̀ mazyi wá bá'ni la, &lt;ndótàwú&gt;yɔ̀, dizyi Ndótàwú ni zukponu, gbaa yí Ndótɛpa mánì. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Ándó wàshuwɔ̀ yiifu'ni kā lá lò yi kà nyà. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Dizyi ándó wa yi lò shinadɔ wā lò'u yi kwá kàsɛ, ándó wa ma kwá di'a kàsɛ̄ wa lò'u yi lò yi ya dɔ.<verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />&lt;&lt; Àfyì wuni yi bɛbɛ mamáni ní, áwuni wándótà Dɔ̀ wu Musa wa Áwáfaris! Áwuni wándó sábɛfù! Ni lò nūkyɔ́ wàya ndō chɔ̀ wàyii dɔ lá chù yii zú panku, áwuni vodini hwoi kà fu yɔ̀, kwɛɛ mazyi ni pi me wándó wàhwoi ngā mazyi wa kà fu lá ní yɔ̀! <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />Àfyì wuni yi bɛbɛ mamáni ní, áwuni wándótà Dɔ̀ wu Musa wa Áwáfaris! Áwuni wándó sábɛfù! Ni hwoi zyī wúchɛ́ àwu áwáwàki, ni kà hwoi jāndɛ̀ wàgwɔ́ɔ̀gwɔ̄ mazyi panku wa wya'ni. Yimamala wa hwoi tà'ni fyì wàbɛbɛ buu lá.<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />&lt;&lt;Àfyì wuni yi bɛbɛ mamáni ní, áwuni wándótà Dɔ̀ wu Musa wa Áwáfaris! Áwuni wándó sábɛfù! Ni hwoi kye ya benashɔ ma kà hwoi kyānú dizyi ni dò pazukponu wàyi mbyā beshí'a shí, nyunu u ma mbyā beshí'a, ni lò'u kà pà wàbɛbɛ kā'ni.&gt;&gt;<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />&lt;&lt; Shàmákɛ̀ló yi wu ni, áwábòzú! Ni zɛ̀ lā, ándó wa ma dàki wā Táwàwáshidɔ, u tà wuzukponu yɔ̀; dedee pazu ma dàki wa shɔ́wànyànyà wa yiifu Táwàwáshidɔ, ákidàdàli yi pà'u.&gt; <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Awuni, àkyɔ̀ bòzú! Wàni yi washuwɔ kā ni: ashɔ́wànyànyà, kwɛɛ Táwàwáshidɔ gbaa lò shɔ́wànyànyà kà wú wà nyɛnyɛ ni? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Ni kà mbyā wà zɛ̀ la, &lt;Ándó wa ma dàki wa gwùdù, u gbaa yi wuzukponu yɔ̀; dedee pazu ma dàki wa sɔ̀wàsáàsá wàyii ishina gwùdù li, ákidàdàli yi pà'o. <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Awuni bòzú! Wàni yi washuwɔ ni: asɔ̀wàsáàsa, kwɛɛ agwudu gbaa lò asɔ̀wàsáàsa yi kà wu wànyɛnyɛ ni? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Yimamala, wándó wa ma dàki wa gwūdù u dàki wa'u wa wú wàhwoi ishina gwūdù sásá lá. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Waa wándó wa ma dàki wa Táwàwáshidɔ dàki wa'u wa wándó wa shí yi táwàwáshidɔ la. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Áwándó wa ma dàki wa dɔ dàki wa àdù wu Shidɔ wa ándó wà yi shí ni lá.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />&lt;&lt;Shàmákɛ̀ló ni, áwándó tàdɔ wu Musa wa Áwáfaris, áwándósábēfu! Ni hwoi yi zū yiifu ide wúsásá wa ni hwoi dò lá. Dedee wu wa sàsà wa hwoi fu dɔ la ni me'wa ní, zyèwú wúzyī wà nūfyìkwenkwen wa ákpɔ̄kɔ̄ wàshìshì. Dedee ni nghà wa sá . <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Awuni bòzú! Ni hwoi shā shishi zu fú gè lape dedee ni hwoi ma wenārī.<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />&lt;&lt; Shàmákɛ̀ló ni, áwándótà Dɔ̀ wu Musa wa Áwáfaris, áwándósábēfu! Ni hwoi tō niki gè, ma hwoi me fu'a wa wu waa ni pà wa gba wa shóshódì. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Áwáfaris wándó wa zū mbélā bwàbwà! Ni kɛ́pyɛ̀ lò fu gè tō, mazyi niki'a u lò yúùyú.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />&lt;&lt;Shàmákɛ̀ló ni, áwándótà Dɔ̀ wu Musa wa Áwáfaris, áwándósábēfu!! Ni hwoi sáyìna mbélā waa wā lò tō mombo,wàsàsà yi myɛ̄ dedee yiifu'a pùkē panku wàhuuhu ma nàázē gbaa mwɛ̀ fu'a ni. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Awuni dedee hwoi mamá, panku hwoi wya ni yi myɛ sáyìna panku wa sàsà dedee ni hwoi wándó sá bɛfù, ni kà bā nwúwàbɛbɛ. <verse eid="MAT 23:28" /><verse number="29" style="v" sid="MAT 23:29" />&lt;&lt;Shàmákɛ̀ló ni, áwándótà Dɔ̀ wu Musa wa Áwáfaris, áwándósábēfu! Ni hwoi myī mbélā yi wándówyàpyɛ̀ ma lò mbélā wándó wàbā byɛ̀ mbya sàssà. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Ni kà zɛ̀ la,&lt; Í ngaa zɛ̀ la i hwoi ni dédēwaa áwádako'i hwoi ni lá ní, i hwoi bwā wándówyàpyɛ̀ yɔ̀&gt; <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Tama ni tà la, ni hwoi zyēdē wándó wa lò wándówyàpyɛ̀ bwā lá. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Ni lò wú wàbɛbɛ dako'ni sábwā<verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />&lt;&lt; Awuni wusu hwoila! Wusu wàbā kyà! Ni hwoi sá mamánī ma hwoi kà pyù yɔ̀ ní? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Yimamala, m ngyi chō wándówyàpyɛ̀ wa wándó wàbā yìyì wa wándótàwú. Wándó wànati'wa ni hwo'wa hwoi bwā ma kà hwo'wa hwoi dábà bé fyī, wándó wànati ni hwoi gyógá'wa wa yō yiifu táwàkwashī, ma hwoi ká be'wa ni àgá wa gá. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Áwú waa ni sá lá, àfyì àwu wándó wàhwoi gbàdà ma yì wúzu yɔ̀ waa ni bwā lá yi tòli yiishina'ni dà zu ábwāàbwā Abila wa Zakariya ngo Berekiya, wándó waa ni hwo'wa bwā yii yiyɔ́ táwàwáshidɔ wa gwūdù lá. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />M ngyi zɛ̀ yí'ni zyíbyɛ̀, sásá fyì wú wàhwoila hwoi tòli yiishina panku wàtama.<verse eid="MAT 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />&lt;&lt;Awuni Urushelima, Urushelima, ni hwo wándówyapyɛ̀ bwā ma kà tá wándó waa Shidɔ chō'wa chɔ̀ bē dò ni lá gɔ́, m shó mazyi m bá zyē ni ndɛ̀ gbayi nashɔ, yiiyi wa kwu hwo zyē'a kwazɔ̄ dó sàvo'a lá, dedee ni zɛ̀ndɛ̀ yɔ̀. <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Wya, pazukponu yi ndō ni yɔ̀. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />M ngyi zɛ̀ yi ni, ni hwoi wyam gɛ̀ yɔ̀ ni ma nghà wa zɛ̀ la, &lt; Avosɔ̀ yi wu ándó wà yi bē yiifu zyì wu Adandō lá&gt; &gt;&gt;<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s1">Yesu Zɛ̀zyí Akɛ̀kɛ̀ Denmyɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Yesu me táwàwáshidɔ ní dédēwaa u támyɛ yi ya lá, áwátu'a be dò'u ma tà'u ámyīìmyī táwàwáshidɔ. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />U zɛ̀ la, &lt;&lt;Eba, ni wya wú wàhwoila sásá. Ḿ zɛ̀ yí'ni, wa hwoi me gɔ́ zukponu ní yi nati yii beshí'a yɔ̀, wa lò'wa hwoi hwó wè zyoku.&gt;&gt;<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Yesu shí yii ishina gā àwu fyī Oliv, áwátu'a be dò'u kyó má. Wa mbyeshé la, &lt;&lt;Zɛ̀ yí'i dédēwaa sásá wú wàhwoila yi kwò lá, kà wa wú yi kwò ma yi tà dédē bēèbē'o wa ákɛ̀kɛ̀ denmyɛ lá.&gt;&gt;<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Yesu zɛ̀ yí'wa la, &lt;&lt;Ni kó dini, mazyi ni káwa me pazu ní ú byè'ni ní yɔ̀. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Apanku ndabe hwoi zɛ̀ la, wa hwoi zɛ̀zyí wum, ma be hwoi zɛ̀ la, &lt;Ami gbaa yi Kristi ní!&gt; ma hwoi byè panku ní ndabe. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Ni hwoi fá kito kɛ̀ bàbà wa ni kà wa tɛ̄ kɛ̀ wàyii benashɔ, dedee ni káwa sázī yɔ̀. U lò kà kén mazyi wu wa hwoila ú sá mamá, ákɛ̀kɛ̀ kà nàtī. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Àchúpanku wàndabe hwoi bā zyī wa Àchúpanku wàndabe, àchɔ̀ hwoi ba zyī wa àchɔ̀. Ámbwɔ̄ bē yiiní, zyoku sásá hwo yi júùjú. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Sásá wu wa hwoila hwoi fyì wàkɛ́pyɛ.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />&lt;&lt; Yiibeli, wa hwoi tà'ni fyì makà hwo'ni yi bwā, àchúpanku wàndabe hwoi zé'ni dizyi'm. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Nyunu li, panku ndabe hwoi me nyàshɔ zyí Shidɔ ní ma hwoi sá diwa bɛfù ma hwoi zé diwa. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Áwándówyapyɛ̀ àwu zyígé hwoi be ma hwoi byè panku ndabe ni. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Ishina wúwàbɛbɛ wàhwo buu lá, ashóòshó lò yi tashuma, <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />dedee wándó wà ma lò nwúgbā ya kèli, u be yi dò nwàzu. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Dedee wa hwoi zɛ̀zyí chɔ̀ wu Shidɔ la yi denmyɛ̄ ú lò yi kà áshévyā yi denmyɛ̄ sásá waa kɛ̀kɛ̀ denmyɛ̄ yi bē ni. <verse eid="MAT 24:14" /><verse number="15" style="v" sid="MAT 24:15" />&lt;&lt; Yimamala ni ma wya &lt;wúsɔ́ sā hwoili yii bē wànyɛnyɛ, waa pazukponu yi ndō yɔ̀ lá,&gt; <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />Yiibeli, wàhwoi Yahudiya shìshɔ̀ né gā. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Apazukponu wàyi dɔ tá ndō'a ká tòli be kōlò wúzu yiifu tá yɔ̀ <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Andó wàyii dā yi kàsɛ̄ be wàhwo wúchɛ́'a yɔ̀. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Nyunu li wándó wà yi wā dì ipyɛ̀ wa wándó wa hwoi yi zyē wàmyɛɛ ma hwoi wya fyì! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Ni jāndɛ̀ yí Shidɔ la, ni hwoi shè yiifu dédē wōhwɔ̀ kwɛɛ yiifu Nyunu wànghànwū yɔ̀! <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Apanku hwoi wyà fyì buu kágba dédēwaa wa mà denmyɛ lá. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Wā ma kwá nyunu wa hwoila kàsɛ̄ yɔ̀ ni, pazukponu be yi shí kà yɔ̀, dedee yiishina wándó waa Shidɔ shē lá, u lò nyunuli yi kwákàsɛ̄. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />Yiifu nyunuli, apazu ma zɛ̀'u la,&lt; Wya, Ndótɛpa yi ni!&gt; Kwɛɛ,&lt; U yi mánì!&gt; Ni ká wa zɛ̀ndɛ̀ yɔ̀. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Dizyi ndótɛpa wúzyīgé wa wándówyàpyɛ̀ wuzyigé hwoi pwèzu makà hwoi sá wu gbàshú buu mazyi wa byè panku kwa wa Shidɔ shē lá ma hwoi sákà ni. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Wya, m lò kɛ́pyɛ̀ zɛ̀ yi ni.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />&lt;&lt; Yimamala, apazu ma zɛ̀ yi ni la, &lt;U yi mánì, yi sáchɔ́ ,&gt; ni ká ya myɛ̄ yɔ̀; kwɛɛ &lt; U yùyò yiifu tá,&gt; ni ká zɛ̀ndɛ̀ yɔ̀. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Kwɛina zú kwáàkwá fyù wàyi dà yii zúdɔ gbógbó be yi zyìli yii vyívyò lá, mamá waa kàsɛ Ngo Panku yi yi ní. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Sásá bē wa kwā ma hwoi ni, ngyífyī hwoi kwazɔ̄ yiibeli.<verse eid="MAT 24:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />Yii niki fyì wu nyunu wa hwoila</para>
  <para style="q1" vid="MAT 24:29">&lt;&lt; &lt; nyunu lò yi sèfē,</para>
  <para style="q2" vid="MAT 24:29">àsɔ̀ yi mbò gɛ̀ yɔ̀;</para>
  <para style="q1" vid="MAT 24:29">áchí zu dɔ hwo kwèkwè,</para>
  <para style="q2" vid="MAT 24:29">sásá wu wa hwoi dɔ la hwoi júùjú.&gt;<verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />&lt;&lt; Yi fu nyunuli wu Ngo Panku yi pwèzu yi dɔ, sásá àchù panku ndabe hwoi shúki. Wa hwoi wya Ngo Panku yi be yiifu bèhwā wàyii dɔ, wa gba, wa gwá wàshuwɔ̀. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />U kà yi chō zyēchɔ̀ mazyi wa nwɛ fyū, wa kà hwoi hwo wándó waa Shidɔ shē lá hwo kwazɔ̄ zu. denmyɛ̄ sásá<verse eid="MAT 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />Yimamala, ni fyé wúzu yiibe fyī gbánkòlò, dédēwaa u ma yi chà zyèwú, ni hwoi yìnɔ̀ la, ádɛ̀ɛ́nɔ̀ lò kwò. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Yimamala, ni ma wya wú hwoila sásá ní, ni hwoi yìnɔ̀ la, ábēèbē Ngo Panku lò be bà'i zɔ yii nūkyɔ́. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />M ngyi zɛ̀ yí'ni byɛ̀, ápanku yi kɛ̀ yɔ̀ gbógbó wú wàhwoila hwoi sá. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Adɔ wa bēèmyɛ̄ hwoi kɛ̀, dedee ázyí'm yi kè yɔ́.<verse eid="MAT 24:35" /></para>
  <para style="s1">Apazukponu Yì Nyunu Ábēèbē Kristi Yɔ̀</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />&lt;&lt; Apazukponu gba yì kyū kwɛɛ nyunu, ázyēchɔ̀ wa hwoi dɔ dedee kwɛɛ Ngo li, gba yìnɔ̀ bēèbē'a yɔ̀, Ada tànwú'a gbá yìnɔ̀ ní. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Yiiyi waa u yiifu nyunu àwu Nuhu lá, mamá waa u yi kwò nyunu bēèbē Ngo Panku ní. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Dédēwaa làpè mwɛ̀ ló yɔ̀ lá, apanku hwoi zyī ma hwoi wa, wánù hwoi sèbā, wa hwo zyēwáwà yi nù, gbógbó nyunu waa Nuhu kà fu kɔ̀; <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />dedee wa gba yì wú wàyi sá yɔ̀ gbógbó fyù bē lò wa hwo ya sásá. Mamá waa u yi yi ni nyunu bēèbē Ngo Panku. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Apa ipyɛ̀ hwoi sá kolo yi dā, wa lò zu yi kōlò chá ya ma hwoi me zu ní. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Áwáwà ipyɛ̀ hwoi shé kuna, wa lò zū yi kōlò chá ya ma hwoi me zū ní.<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />&lt;&lt; Yimamala, ni hwo zu hwali, dizyi ni ba yi nyunu waa Adandō yi be la yɔ̀. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Dedee ni yìnɔ̀ la: Andó ndó ma yìnɔ̀ la vyú yi bē súnɔ̀, u yi shíli ma lò zú yi hwali ma yi me ndō ni yí vyú u kà ni yɔ̀. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Yimamala, ni mbyā di ni, dizyi Ango Panku yi bē nyunu waa pazukponu lò nwú sáni yɔ̀.<verse eid="MAT 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />&lt;&lt; Ánɔ̄ yí nyà wa bābyɛ̀ makà byɛ̄zú ní, waa wàsendo lò'u kà dóshī nwúnyà wa hwoi fu ndō'a la mazyi u yi wa wúzyī yiifu nyunu gyēgyē? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />U yi sàsà mazyi wàsendo u kàsɛ̄ bē dò nwúnyà yi sá kóló waa wa dà'u ni la. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />M ngyi zɛ̀ yi ni zyibyɛ̀, u lò sásá wu waa u bā la hwoi kwà'u vo. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Nyunu waa nyàli ma bā nwúwàbɛbɛ ma zɛ̀ yiifu nwú'a la, &lt; Wàsendo'm lò shí myɛ nashɔ,&gt; <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />Nyunu u ma tà áwányà wanati fyī, ma yi zyī ma kà yi wā wā wándó wa hwoi wa shā. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Wàsendo nyàli yi be dédēwaa u sá nwú yi ni yɔ̀ kwɛɛ nyunu waa u yi yìnɔ̀ yɔ̀. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Wàsendo lò nwúnyà li yi gé wìlìwìlì ma lò nyàli yi kwazɔ̄ wa wándó sá bɛfù, yiibeli, kishèshè wa nyíwàpāàpā.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s1">Azyezuwa Ídē Waa Yesu Zɛ̀zyí Yiishina wa lá.</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />Yiifu nyunuli, achɔ̀ wà yii dɔ yi sáyìna Azyezuwa ídē, wa lò kyàngyà ma ya myɛ̄ mazyi wa dò nù'wa. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Azyezuwa ichɔ̄ yiifu'wa byɛ̄byɛ̄ yɔ̀, ichɔ̄ yiifu'wa byɛ̄byɛ̄. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Áwándó wàbā kyɔ̀ lá hwo kyàngyà'wa dedee ma kōlò byù bà ní yɔ̀. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Wándó wà byɛ̄byɛ̄ hwoila, gɛ̀, chá byù'wa yiifu kwɛ̀ wa kyàngyà'wa. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Anù'wa gɛ̀ bē mɔ̄mɔ̄ yɔ̀, áná fyè'wa wa hwo náná.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />Asunɔ chōgégé wa fá kitó, &lt; Anù yiinì! Zumyɛ̄ be dò'u!&gt;<verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />&lt;&lt; Yiibeli, sásá zyēzuwà ide hwo zɛ̀ná ma lò kyàngyà'wa hwāpyù. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Yiibeli áwándó wàbā kyɔ̀ lá zɛ̀ yí wándó wàbyɛ̄zú lá la, &lt;Ni yí'i byù'ni tímá la, àkyàngyà'i lò yi dɛ.&gt;<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />Wa zɛ̀ yi wa lā, &lt;&lt; Aayi, àbyù la ba yí kē yi wa ni yɔ̀. Yimamala, ni ya be wándó wa hwoi kpátí byù la mazyi ni mbà.<verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />&lt;&lt;Dédēwaa wa hwoi nyashɔ̄ hwoi ya wa mbà byù lá, ànù lò kà ndō. Azyezuwa wa mbya di wa la ya wa bé wàsèbā dùdù wa'u.Wa lò nūkyɔ́ chù.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />Gbámá wándó wànati kàsɛ̄ bē. Wa zɛ̀ la, Wàsèndo! Wàsèndo! &lt; Lò nūkyɔ́ pò yi!&gt;<verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />Dedee u zɛ̀ yi wa la, &lt;M ngyi zɛ̀ yí'ni zyíbyɛ̀, M bā yi ni yɔ̀.&gt;<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />Yimamala, ni hwo zú hwāli, dizyi ni ba yì nyunu kwɛɛ àshɔ́ yi puna waa Ngo Panku yi be lá yɔ̀.<verse eid="MAT 25:13" /></para>
  <para style="s1">Atɛ́káàká Áwányà Pà Isa</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />Yesu kà mbya zɛ̀ la &lt;&lt; achɔ̀ wà yii dɔ lá yi sáyìna ápazu wa yi ya kyū, ma bá áwányà'a ndɛ̀ ma lò wúchɛ́'a kwà wa vo. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />U yí ndó zu shɔ́wànyànyà idipaichɔ ichɔ̄, u kà yí ndózu shɔ́wànyànyà idipaichɔ ipyɛ̀, ma kà yí ndózu shɔ́wànyànyà idipaichɔ zukponu, nɔ́nɔ̄ pà gyēgyē wa gbá'a. Yiibeli lá, ma ya'a kyū. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Andó wà pà shɔ́wànyànyà idipaichɔ ichɔ̄ lá zumyɛ ma ya vekà vo wa'u ma dò shɔ́wànyànyà idipaichɔ kwani. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Andó wà pà shɔ́wànyànyà idipaichɔ ipyɛ̀ lá zumyɛ ma ya vekà vo wa'u ma dò shɔ́wànyànyà idipaichɔ ipyɛ̀ kwani. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Yimamala ándó wà pà shɔ́wànyànyà idipaichɔ zukponu lá, ya kā shī ma lò banji wàsendo'a yù ní.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />&lt;&lt; Dédēwaa wàsendo nwúnyà hwoila ya nashɔ gbógbó ma kàsɛ̄ lá,u lò'wa bá ndɛ gbayi mazyi u yì wú waa wā sá wa banji li lá. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Andó wà pà shɔ́wànyànyà idipaichɔ ichɔ̄ lá, kà chá shɔ́wànyànyà idipaichɔ ichɔ bē. Ma zɛ̀ la, &lt;Wàsendo, o yí'm shɔ́wànyànyà idipaichɔ ichɔ̄, wyà ami dedee kà dò kwa vo ni. Wya, m kà dò ichɔ̄ kwā ni.&gt;<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />Wàsendo'wa zɛ̀ la,&lt;&lt; Mgbagyē, ànyà wa sàsà wàbā byɛ̀! O tà byɛ̀ wa wu wa tí; M lò'o yi kà dóshī wu wa buu. Bē mbonwu wa Wàsendo! &gt;<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />Apa wa pà kobo ipyɛ̀ la, chá ipyɛ̀ kà bē. U zɛ̀ la, &lt;Wàsendo, o lò kobo ipyɛ̀ kwà'm vo ni. Wya, m kà dò ipyɛ̀ kwā ni.&gt;<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />Wàsendo'a zɛ̀ la,&lt;&lt; Mgbagye, nyà wà sàsà ma bā byɛ̀! O tà byɛ̀ yiibe wú wà mambani; M lò'o yi kà dóshī yiibe wú buu. Bē mbonwú wa'm dùdù!&gt;<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />&lt;&lt;Yiibeli andó wà pà shɔ́wànyànyà zukponu lá, zɛ̀ la, zɛ̀ la, &lt;Wàsendo,&gt;&lt;M yìnɔ̀ la, wúsáàsá'o tòtò, o yi bē wúzyī yii be waa o nànɛ̀ yiiní yɔ̀, ma kà yi hwo wúzyī kwazɔ̄ yi be waa o nyá chɛ̄wú yiiní yɔ̀. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Yimamala, m lò kàzī ma lò shɔ́wànyànyà'o yùyò yii fu shī. Wyà, áwúchɛ́'o yiinì.&gt;<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />&lt;&lt;Wàsendo zɛ̀ yí'u la, &lt; O yi nwúnyà wà bɛ̄bɛ̄, o zɛ̀dìhwɛ yɔ̀! O yìnɔ̀ la, m ngyi bē wúzyī yiibe waa m nànɛ̀ yiiní yɔ̀ ma kà yi hwo wúzyī kwazɔ̄ yiibe waa m nyá chɛ̄wú yiiní yɔ̀? <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Ó ngaa lò'm banji lá kwà wándó wà hwoi vekà vo lá vo ni, nyunu waa m ma kàsɛ̄ m ngyi dò kwani.<verse eid="MAT 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28" />&lt;&lt; &lt;Yimamala, ni lò banji li pà yi vo'a mazyi ni lò yi ándó wà ba shɔ́wànyànyà idipaichɔndoide lá. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Dizyi ándó wà bā wú buu lá waa wa hwoi kwa'uni gbógbó u yi bā buu ni. Andó wà bā yɔ̀ lá, wa wú wàtitinti waa u bā yii vo'a lá, wa lò yi fyé. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Wa lò nwúnyà lá wàtánchɔ̀ lá yi tá hwā myɛ̄ be wàsèfē, bē waa wa hwoi shèki ma hwoi dó vo yi nyí lá&gt;<verse eid="MAT 25:30" /></para>
  <para style="s1">Adɛ̀ wa byí</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />&lt;&lt; Nyunu waa, Ngo Panku ma bē yiifu gwá'a wa sásá zyēchɔ̀ wa'u dùdù, u yi shí bé dù àwu gwá chɔ̀'a wà yii dɔ lá. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Sásá panku denmyɛ hwoi gbàyi pyɛ̀'a. Yiibeli u lò'wa ndō ipyɛ̀, sáyìna yiiyi waa ndópyōwú yi gàfā dɛ̀ wa byí lá. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />U lò dɛ̀ hwoi wè zyɛ̄ vonzyī ma lò byí hwoi wè zyɛ̄ vonsɔ́.<verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />&lt;&lt; Yibeli Àku yi zɛ̀ yi wándó wa hwoi zyɛ̄ vonzyī la, &lt; Bē, áwuni wa Ada'm kwāndɛ̀ yí'ni lá; ni be zyīfí ndō chɔ̀ wuni waa wa lò mbyā ndii-ndii yiibe màmà denmyɛ lá. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Ámbɔ̄ bwā'm ni yi'm wúzyī, nwúzyàwā zá'm ni yí'm zyàwā, M ngyi pàkyù ni kà tà'mkyù , <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />M ngyi kyē myàmbyà ni hwo wúchɛ́ wè'm dì, M tòwú ni fú fyī yí'm, wa lò'm pà hwā tá ni be ma wya'm.&gt;<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />&lt;&lt; Yiibeli, wándó wàbā byɛ̀ hwo zɛ̀ yí'u la, &lt; Adando, nyunu wa ni wa i wya'u yi bwā ámbɔ̄ ma yi'o wúzyī ni, kwɛɛ nwúzyàwā zá'u ma yí'o zyàwā ni, &gt; <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Nyunu wa ni waa i wya'u yi pàkyù ma tà'ukyù ni, kwɛɛ o yi kyē myàmbyà ma hwo wúchɛ́ wè'o dì ni, <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Nyunu wàni waa o tòwú kwɛɛ yiifu táfyì waa í be wya'u ní?&gt;<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />&lt;&lt; Aku yi zɛ̀ yí wā la, &lt; M ngyi zɛ̀ yi ni zyibyɛ̀, sásá wu wa ni ma sá yi zyēyī'm wa vo'wa lò zō, ni sá yi'm mánì. &gt;<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />&lt;&lt; Yiibeli, u yi zɛ̀ yi wándó wa hwoi zyɛ̄ vonsɔ́ lá la,&lt; Dàdɔ yi pyɛ̀'m, Awuni waa wa hwa'ni nūli lá, ni kà fu pyù waa wa mbya yi pà wàbɛbɛ wa ázyēchɔ̀'a. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Ámbɔ̄ bwā'm ni yí'm wúzyī yɔ̀, nwúzyàwā zá'm ni yí'm zyàwā yɔ̀, &gt; <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />M ngyi pàkyù ni tà'mkyù yɔ̀ , M ngyi kyē myàmbyà ni hwo wúkɛ̀ wè'm dì yɔ̀, M tòwú ni fú fyī yí'm yɔ̀, wā lò'm pà hwa táfyì ni bē wya'm yɔ̀.&gt;<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />Wā hwoi zɛ̀ la, &lt; Adando, nyunu wa ni wa i wya'o yi bwā ámbɔ̄, kwɛɛ, yi zánwú zyàwā, kwɛɛ yi pàkyù, kwɛɛ myàmbyà, kwɛɛ yí tòwú, kwɛɛ wā lò'o pà hwa táfyì ma sázá'o ní yɔ̀ ní?&gt;<verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />&lt;&lt; Aku yi zɛ̀ yí wā la, &lt; M ngyi zɛ̀ yi ni zyibyɛ̀, sásá wu waa ni ma sá yi zyēyī'm waa vo'a lò zō la ni sá yí'm yɔ̀ mánì.&gt; <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />&lt;&lt; Yiibeli,wa hwoi kà fu pyù wa gbógbógbògbò, dedee, wándó wàbā byɛ̀ hwoi dò nghànwū wàgbógbó gbògbò.<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s1">Wa Bwābɔ̄ Wàlò Yesu Bwā</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Dédēwaa Yesu lò wú tàbwā lá, u zɛ̀ yí áwátu'a la, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />&lt;&lt;Ni yìnɔ̀ lá, Àdùdù Wàkyānú nàti nyunu ipyɛ, mazyi wá lò Ngo Panku ndavo yí wa lò'u dá bà bé fyī.&gt;&gt;<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Yiibeli, áwádakumbwa wàshūwɔ̀ wa áwácha kwazɔ yii súkpà Kayafas wàyi Adākúmbwá wàshuwɔ̀ kā lá, <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />ma bwābɔ̄ wàlò Yesu pà kyómá mazyi wá lò'u bwā. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />&lt;&lt;Wa zɛ̀ la, i hwoi sá'u yiifu dédē wàsá dùdù yɔ̀, kwɛɛ nwázuyɔ̀ ápanku be hwoi dà pyáwàsáàsá.&gt;&gt;<verse eid="MAT 26:5" /></para>
  <para style="s1">Yii Betani Mariyamu Wè Yesu Byù Yii Shina</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Yesu yii Betani yii ndō Siman, ándó wà bā wútòtò dìwànyànyà ndii lá. <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />Yesu yiifu wúzyī wàzyīìzyī, àwàzu gbá bē dò'u wa ángo kwɛ̀ mwɛ̀mwɛ̀ wa byù wànufyì kwénkwén, bā banji buu, ma lò wè'u shina.<verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />Áwátu wyà mamá lá, àpúpù lò'wa pà. Wa mbyēshé la &lt;&lt;Áyɛ̄ sá wu fyìwàsáàsá mamá ní?&gt;&gt; <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />&lt;&lt;Wángaa lò byù wàkwénkwén lá kpátí wa banji wàbuu, ma lò yí áwándóchɛ̀!&gt;&gt;<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Yesu yì zyí waa wa hwoi zɛ̀ lá, yimamala u zɛ̀ yí'wa la, &lt;&lt;Áyɛ̄ sá waa ni hwoi sá àwàlá gìdìgìdì ní? Áwú wàsàsà waa u sá'm ní. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Áwándóchɛ̀ wa ni hwoi dùdù gbɛ̀n, dedee ámì wa ni hwoi shí gbɛ̀n yɔ̀. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Àbyù wànūfyì kwénkwén waa àwàlá lò wè'm dì lá, u lò'm dì mbyā wàzyìzyì ní. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Tàma m ngyi zɛ̀ yí'ni zyíbyɛ̀ la, sásá bē waa wa ma ya dádɔ̀ shévyā wàsàsà lá yii ní, ápanku hwoi jāsā wa shéwàvyāàvyā ishina wú waa àwàlá sá lá, àdenmyɛ sásá yi kyé'u.<verse eid="MAT 26:13" /></para>
  <para style="s1">Yahuda Zɛ̀ndɛ̀ wàlò Yesu Kpátí</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Yiibeli, yiifu áwátu idezepyɛ lá, ápazu'wa waa wa bá'u la, Yahuda Iskarioti lá, ya dò áwádakumbwa wàshūwɔ̀ <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />ma mbyē'washé la, &lt;&lt;Nyunuwaa m ma lò Yesu pà yí'ni, áyɛ̄ waa ni hwoi yí'm ní?&gt;&gt; Yiibeli wa hwɛ̀ kobo shɔ́wàmòmbò idizuzede ma lò yí'u. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Dà zū nyunu li, waa Yahuda yi hwāzú nyàshɔ wàlò Yesu ndāvo yí'wa ní.<verse eid="MAT 26:16" /></para>
  <para style="s1">Yesu Zyī Wúzyī Dùdù Wàkyānú wa Áwátú'a</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Yiifu nyunu wàkɛ́pyɛ àwu Dùdù wàzyī wúzyī wàbā yist yɔ̀ lá, áwátu bē dò Yesu ma mbyē'ushé la, &lt;&lt;Ābē wànī waa o yi fú í mbyā wúzyī Dùdù Wàkyānú yí'o yii ní ní?&gt;&gt;<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Yesu zɛ̀ yí'wa la, &lt;&lt;Ni ya dò pàzu yiifu gáwàshūwɔ̀, mazyi ni zɛ̀ yí'u la, &lt;Ándótàwú zɛ̀ la, Ádédē'a lò bē bà dì, áhu wa áwátu'a hwoi zyī wúzyī Dùdù Wàkyānú yii ndō'o.&gt; &gt;&gt; <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Yimamala, áwátu sá wú waa Yesu zɛ̀ yí'wa lá, ma lò wúzyī Dùdù Wàkyānú sá.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Ànyíìzɔ́, Yesu lò shíli wa áwátu'a wàzyī wúzyī. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Wa hwoi fu wúzyī wàzyīìzyī, Yesu gbá zɛ̀ la, &lt;&lt;Yibyɛ̀ ápazu'ni lò'm yi kpátí.&gt;&gt;<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Ánwú áwátu hwo bɛbɛ lá wa jāsā'u wa shéwàmbyēèmbyē zū-zū la, &lt;&lt;Yibyɛ̀, Adandō, o wya sáyìna mi yɔ̀?&gt;&gt; <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />Yesu zɛ̀ yí'wa ndɛ̀ ní la, &lt;&lt;Ápà wàwa'm yi dóvozɔ yiifu gè lá gbaa lò'm yi kpátí ní. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Ngo Panku lò yi hu sáyìna yiiyi waa Āfā zyí Shidɔ wàtāàtā zɛ̀ la, u lò yi hu lá, dedee áfyì wàbɛbɛ yi wu pà wàlò Ngo Panku yi kpátí lá! Wá ngaa ká mbà pàli yɔ̀ ní, ú ngaa yi pà'utáshì ní yi kā ní!&gt;&gt;<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Yiibeli Yahuda, ándójāzyí, zɛ̀ la, &lt;&lt;Yibyɛ̀, Andótàwú, o yi wya sáyìna ámì yɔ̀?&gt;&gt;</para>
  <para style="p" vid="MAT 26:25">Yesu zɛ̀'undɛ̀ ní la, &lt;&lt;O lò zɛ̀.&gt;&gt;<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Wa hwoi fu wúzyī wàzyīìzyī, Yesu gbá lò bùbùrù zū, ma tá Shidɔ mamgba, ma téká-téká yí áwátu'a, ma zɛ̀ la, &lt;&lt;Ni pà mazyi ni zyī; àdì'm gbaa yiinì.&gt;&gt;<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Yiibeli u kà lò gè zyàbā, ma tá Shidɔ mamgba, ma lò yí'wa, ma zɛ̀ la, &lt;&lt;Ni wa, sásá'ni. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Àzyàbā lá yi sà'm àwu nūwàgéègé Shidɔ wa panku'a. Àsà'm yi nyámbyɛ́ dizyi wàgbā panku ndabe zyɔ̀ wúwàbɛbɛ'wa. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />M ngyi zɛ̀ yí ni, m ngyi wā zyàwā lá gɛ̀ yɔ̀, gbógbó bà nyunu lá waa m wa'ni hwoi wā zyàbā wàpyoo yii Ndōchɔ̀ àwu Dā'm lá. <verse eid="MAT 26:29" /><verse number="30" style="v" sid="MAT 26:30" />Yiibeli waa wa chòvyū wàngyā Shidɔ lá, wa támyɛ ma ya shina gā àwu fyī Oliv.<verse eid="MAT 26:30" /></para>
  <para style="s1">Yesu Zɛ̀ la, Bitrus Yi Ngha'u</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Yiibeli, Yesu zɛ̀ yi wa la,&lt;&lt; Asunɔ la sásá ni hwoi shè ma hwoi me'm ní dizyi u táàtá:</para>
  <para style="q1" vid="MAT 26:31">&lt;&lt; &lt; M ngyi dá ndópyōdɛ̀ li,</para>
  <para style="q2" vid="MAT 26:31">dɛ̀ li hwoi shànyá. &gt;<verse eid="MAT 26:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />Dedee nyunu waa m ma dà zu ki, M ngyi kɛ́pyɛ̀ yi ni yi ya Galili. &gt;&gt;<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Bitrus zɛ̀ la, &lt;&lt; Nyunu nɔ́nɔ̄ ma chēzyí la wa ba yi o yɔ̀, M ngyi chēzyí yɔ̀.&gt;&gt;<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Yesu zɛ̀ la, &lt;&lt; M ngyi zɛ̀ yi ni zyibyɛ̀, asunɔ wa yi la, gbógbó gogorokwu u dá kitó, o yi ngha'm bá isā.&gt;&gt;<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Dedee Bitrus zɛ̀ la, &lt;&lt; U ma pà waa m lò hu wa'u, m ngyi nghà'u yɔ̀.&gt;&gt; Sásá áwátu wànati zɛ̀ mamá.<verse eid="MAT 26:35" /></para>
  <para style="s1">Yesu Jāndɛ̀ Yii Getsemani</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Yiibeli, Yesu ya bezu dùdù wa áwátú zyī la Getsemani, &lt;&lt;Ni shí maa mazyi ḿ gbòkyā ya jāndɛ̀ yii be wàmú.&gt;&gt; <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />U ya wa Bitrus wa zyē Zabadi ipyɛ, ánwú'a lò bɛbɛ wa bēbèwàwèwè. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Yibeli, u zɛ̀ yí'wa la, &lt;&lt;Ánwú'm wàlò tòtò kādɔ lá, nàtī tí ú lò'm bwā. Ni shí maa mazyi ni ká náná yɔ̀ wa'm dùdù.&gt;&gt;<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />U kyē ya pyɛ̀ tímá ma lò zú bē zyoku ma jāndɛ̀ la, &lt;&lt;Ada'm, o ma shó, o lò'm ki lá yi kōlòdɔ kà! Dedee ká sá wu nwúm yɔ̀, sá wu nwú'u.&gt;&gt;<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Yiibeli, u kàsɛ bē dò áwátu ápà isa ma wya'wa hwoi náná, ma mbyē Bitrus shé la, &lt;&lt;Mamánī waa áwuni pà isa wa'm hwoi náná yɔ̀ àwu áwà zukponu kà yɔ̀ ní?&gt;&gt; <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Ni ká náná yɔ̀ wa ndɛ̀wàjāàjā ishina ni ká kwò fu pɛ́wàmbàmbà yɔ̀. Ánidi yi fú, dedee àdì lò zāhwɔ̄.&gt;&gt;<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Yesu kà mbyā wà kàsɛ bá wàhwāpyɛ̀ ma jāndɛ̀ la, &lt;&lt;Ada'm, nyunuwaa ki lá ma lò yi lòdɔ yɔ̀, m lò yi hu kɛ́nkɛ́n ní, sá wú waa nwú'u yi shó lá.&gt;&gt;<verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />U kà mbyā wàkàsɛ ma wya áwátu hwo náná, dizyi ázú'wa hwo ndàbɔ̀ wa ná. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Yesu kà mbyā wà me'wa ní ma ya'a, ma jāndɛ̀ bá wàhwāsā, ma yi zɛ̀ wú waa u zɛ̀ kyaa lá.<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />Yiibeli u kàsɛ bē dò áwátu ma zɛ̀ yí'wa la, &lt;&lt;Bà tàma ni hwoi náná ma kà hwoi nghànwū? Ni wya! Dédē lò bē waa wa lò Ngo Panku yi kpáti yí wándó sá wúwàbɛbɛ ló. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Ni dàdɔ mazyi í ya. Ni wya, ápà wàlò'm yi kpátí lá gbaa yiinì!&gt;&gt;<verse eid="MAT 26:46" /></para>
  <para style="s1">Wa lò Yesu Pà</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Yesu yiifu zyíwàzɛ̀zɛ̀ kin Yahuda wàyi panku zū yiifu áwátu idēzepyɛ̀ lá gbá pwèzū. Wa panku ndàbè wa kwɛ́wàgwɔɔgwɔ hwoi vo'wa wa kùtɛ̀, áwádakumbwa wàshūwɔ̀ wa wácha gbaa chō'wa bē ní. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Andó wàlò'u kpátí lá kɛ́pyɛ̀ lò tà bèpanku sāli la, &lt;&lt;Ápà waa m ngyi tá mamgba nū wàgwàzɔ̄ wa'u má, ni lò'u pà!&gt;&gt; <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Yahuda ndafa ya dò Yesu ma zɛ̀ la, &lt;&lt;Ánwúkwòli ú shí wa'u, Ándótàwú,&gt;&gt; ma tá mamgba nū wàgwàzɔ̄ wa'u.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Yesu zɛ̀ yí'u la, &lt;&lt;Abugɛ, sá wú waa o bē yiishina'a lá mɔ̄mɔ̄.&gt;&gt;</para>
  <para style="p" vid="MAT 26:50">Yiibeli, wa kyēkyū bà Yesu ma lò'u pà. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Ápazu yiifu wándó wàhwoi dùdù wa Yesu lá gbēnwà kwɛ́wàgwɔɔgwɔ'a ma lò nyà Adakumbwa wàshuwɔ̀ kā lá chùchú kè.<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />Yesu zɛ̀ yí'u la, &lt;&lt;Lò kwɛ́wàgwɔɔgwɔ'o dó fu fyā'a, dizyi sásá pà wàyi lò kwɛ́wàgwɔɔgwɔ lá, yi huki kwɛ́wàgwɔɔgwɔ. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Ni wya sáyìna m ma bá Adā'm ndɛ̀ wàsázá'm, yiibebeli u yi chō ázyēchɔ̀ wàhwoi ndūkɛ̀ lá kāgbá idezepyɛ bē yí'm kà yɔ̀ ní? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Dedee m ma sá mamá, áwú waa Āfā zyí Shidɔ wàtāàtā zɛ̀ la, u lò kà kɛ́n mazyi ú kwò lá sáni ma pi lò yi kà yi byɛ̀ ní?&gt;&gt;<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Yiibeli Yesu zɛ̀ yí bèpanku la, &lt;&lt;Ni zumyɛ̄ wa kwɛ́wàgwɔɔgwɔ wa kùtɛ̀ ma lò'm pà sáyìna m ngyi vyú? M gɛ̀ shí Táwàwáshidɔ ma yi tàwú gbɛ̀n, dedee ni pà'm yɔ̀. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Dedee sásá wú wàhwoila kwò mamá mazyi ú lò wú waa áwándówyapyɛ̀ tā hwoi fu Āfā zyí Shidɔ wàtāàtā lá kà zyí byɛ̀.&gt;&gt;</para>
  <para style="p" vid="MAT 26:56">Yiibeli, sásá áwátu me'u ní ma hwo shè.<verse eid="MAT 26:56" /></para>
  <para style="s1">Yesu Yii Pyɛ̀ Wácha</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Áwándó wàlò Yesu pà lá, lò'u chá ya dò Kayafas, Ádākúmbwá Wàshūwɔ̀ kā lá, yiibe waa áwándó tà Dɔ̀ Musa wa wácha gbàyi hwoi ní lá. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Dedee Bitrus lò bē ní yii bēnashɔ, gbógbó kà táwàhwàkwɛ̄ wàyi ndō Ádākúmbwá Wàshūwɔ̀ kā lá. U kàfu táwàhwàkwɛ̄ ma shí wa áwándókó nūkyɔ́ mazyi ú wya wú wàbē yi kwò lá. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />Áwádakumbwa Wàshūwɔ̀ wa wácha sásá hwāzú zyí wàté Yesu ní mazyi wá dò lò'u bwā. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Dedee wa dò zyí zukponu yɔ̀, kwā waa panku ndàbè zumyɛ̄ ma gézyígé dó'u lá. Wàkɛ̄ɛ̀kɛ̄ ápà ipyɛ zumyɛ <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />ma zɛ̀ la, &lt;&lt;Apà lá zɛ̀ la, &lt; M lò Táwàwáshidɔ àwu Shidɔ yi hwó ma mbyā'u yi myī yiifu nyunu isa kà.&gt; &gt;&gt;<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Yiibeli, Ádākúmbwá Wàshūwɔ̀ kā lá dàdɔ sādɔ ma mbyē Yesu shé la, &lt;&lt;O bā ndɛ̀wàzɛ̀ ishina zyí waa wa té'o ní lá? <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Dedee Yesu bà'andɛ̀.</para>
  <para style="p" vid="MAT 26:63">&lt;&lt;Ádākúmbwá Wàshūwɔ̀ kā lá zɛ̀ yí'u la, &lt;&lt; Yì zyì Shidɔ wàzyoo, nyunuwaa o ma yi Kristi, Ángo wu Shidɔ ní zɛ̀ yí'i.&gt;&gt;<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Yesu yí ndɛ̀ zɛ̀ la, &lt;&lt; Yimamala, o lò zɛ̀. Dedee m ngyi zɛ̀ yí'ni sásá lá, Dà zū maa ya pyɛ̀, ni hwoi wya Ángo Panku shí vonzyī Ándó wàbā gbā lá yi tòli zū fu bèhwā yii dɔ!&gt;&gt;<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Yibeli, Ádākúmbwá Wàshūwɔ̀ kā lá túkpá'a yà ma zɛ̀ la, &lt;&lt;U chō Shidɔ tè! I gba hwoi fú wándó wànati wàhwoi zɛ̀zyí yiishina'a gɛ̀ yɔ̀! Ni fá tè waa u chō Shidɔ tàma la! <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Áyɛ̄ waa ni wya ní?&gt;&gt;</para>
  <para style="p" vid="MAT 26:66">Wa yí ndɛ̀ zɛ̀ la, u sá wúwàbɛbɛ ma vyā wa ki.&gt;&gt;<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Yiibeli, wa chɛ́chɛ́ wè'u zú ma dá'ubwà, áwándó wàtá'u pitá lá <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />zɛ̀ la, &lt;&lt;Zɛ̀ wú wàyi kwò yii pyɛ̀ lá yí'i, O ma yi Kristi ní! Zɛ̀ ndó wàdá'u bwà lá!&gt;&gt;<verse eid="MAT 26:68" /></para>
  <para style="s1">Bitrus chēzyí la, u yì Yesu yɔ̀</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Bitrus shí yii myɛ̄, yii fundō táwàhwàkwɛ̄, àwàzu wàyi sákolo wa Ádākúmbwá Wàshūwɔ̀ kā lá gbá bē dò'u ma zɛ̀ la, &lt;&lt;Kwā wo dedee wa Yesu wàzu Galili lá hwoi dùdù.&gt;&gt;<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Dedee Bitrus chēzyí yii pyɛ̀'wa sásá la, &lt;&lt;M gbā yì wú waa o yi zɛ̀zyí yiishina'a lá yɔ̀.&gt;&gt;<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />ma zumyɛ̄ támyɛ yii nūkyɔ́ wàkàfu, àwà zukɛ̄kɛ̄ wàkà yi ndó sákolo wya'u ma zɛ̀ yí panku wàhwoi beli lá la, &lt;&lt;Ápà lá wa Yesu wàzu Nazaret lá hwoi dùdù.&gt;&gt;<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Bitrus kà mbyā wàchēzyí, ma dàki la, &lt;&lt;M gba yì pà lá yɔ̀!&gt;&gt;<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Gbámá, wándó wàsā hwoi beli lá gbē diwa bà Bitrus ma zɛ̀ yí'u la, &lt;&lt;Yibyɛ̀, o yi pazu yiifu'wa, dizyi ázyízɛ̀zɛ̀'o lò'o fù!&gt;&gt;<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Yiibeli, Bitrus yi hwa dia nūli ma yi dàki la, &lt;&lt;M gba yì pà li yɔ̀!&gt;&gt;</para>
  <para style="p" vid="MAT 26:74">Yiibebeli gogorokwu gbá dákito, <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Bitrus gbá kyé zyí waa Yesu zɛ̀ yí'u lá la, &lt;&lt;Gbógbó gogorokwu ú dákito, o yi chēzyí bá isa la, o yì'm yɔ̀.&gt;&gt; Yimamala Bitrus zumyɛ̄ ma jāsā wa kiwàshèshè.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s1">Yahuda Lò Vyù Dó Dia Hùnā.</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Apupunɔ, sásá Adakumbwa wàshūwɔ̀ wa wácha wu bè li hwo zɛ̀ndɛ̀ la, wa lò Yesu yi bwā. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Wa lò'o dɛ̀, ma lò'u chá ya dò Bilatus, dóshī zyoku.<verse eid="MAT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Dédēwaa, Yahuda wà lò Yesu kpátí lá wya fyì waa wa hwoi tà Yesu lá, ánwú'a lò bɛbɛ, u lò shɔwàmombò 30 chá kàsɛ̄ ya yi áwádakumbwa wàshūwɔ̀ wa wácha. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />U zɛ̀ la, &lt;&lt; M lò sá dà, dizyi m lò pà wa sá wúwàbɛbɛ yɔ̀ kpátí&gt;&gt;</para>
  <para style="p" vid="MAT 27:4">Wa zɛ̀ yi'u la, &lt;&lt; Awui zyī la yɛ̄? Wú wàli yi zyí'u.&gt;&gt;<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Yimamala, Yahuda lò banji li nyá wè fú Táwàwáshidɔ ma ya. U ya ma lò vyù dó di'a huna. <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />Áwádakumbwa lò shɔwàmombò li hwo ma zɛ̀ la,&lt;&lt; U ba sàsà mazyi i lò banji la hwā fu banji táwàwáshidɔ yɔ̀, dizyi u yi banji sà. &gt;&gt; <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Yimamala, wa zɛ̀ndɛ̀ ma lò banji li hwɛ̄ zyókù wu ndómyīpá mazyi wa dò mbéla àwu pàkyù. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Yiishinali waa wa hwoi ba'u la zyókù wu sà kà bà zyìná ni. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Yiibeli, zyí waa Irimiya ndówyapyɛ̀ lò gyila ni:&lt;&lt; Wa hwo shɔwàmombò idizuzede, átí waa Áwáisrela hwɛ̄ yiishina lá ma ni, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />ma hwo wa hwɛ̄ zyókù àwu ndómyīpá, yiiyi waa Adando yí'm nū lá.&gt;&gt;<verse eid="MAT 27:10" /></para>
  <para style="s1">Yesu Sā Yii Pyɛ̀ Bilatus</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Yesu sā yii pyɛ̀ dóshī zyoku, Ádóshī li mbyē'ushé la, &lt;&lt; Áwo gbaa yi ku wu Áwáyahuda ni? &gt;&gt;</para>
  <para style="p" vid="MAT 27:11">Yesu zɛ̀ la, &lt;&lt; Eba, yiiyi wa'o zɛ̀ la manì. &gt;&gt;<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Dédēwaa adakumbwa wàshūwɔ̀ wa wácha té'o zyí la, zɛ̀zyí zukponu yɔ̀. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Yiibeli, Bilatus mbyē Yesu shé la, &lt;&lt; O fá zyí waa wa hwoi té'oní lá yɔ̀?&gt;&gt; <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Dedee Yesu pò'wa nū yɔ̀, u zɛ̀zyí zukponu yɔ̀; áwúli lò kà dóshī zyoku áwúgbàshú.<verse eid="MAT 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Nyunuli, lò kà wú wàsáàsá dóshī nyunu dùdù mazyi u fā dà li yi ndó waa wa hwo pà wè tá waa bè ma shē. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Nyunu li wa bā pazu wàbɛbɛ waa wa pà'u hwa tá zyī la Barabas. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Yimamala dédēwaa bèpanku gbayi lá, Bilatus mbyē'wa shé la, &lt;&lt;Anɔ̄ waa ni hwoi fú mazyi ḿ me'u ní yí'ni ní, Barabas, kwɛɛ Yesu waa wa hwoi bá'u la Kristi lá ní? &gt;&gt; <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Dizyi u yìnɔ̀ la Yishina wā shó yɔ̀ la, wa lò'u lò ndāvo yí'u ní.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Dédēwaa Bilatus shí shina dù ndóhwàkwɛ́ lá, àwà'a chōchɔ̀ la, &lt;&lt; Lò vo'o tɛ yiifu zyí panku wàsá wúwàbɛbɛ yɔ̀ lá, dizyi àsunɔ̀ zyina m wyafyì yiibe ndó yiishina'a.&gt;&gt; <verse eid="MAT 27:19" /><verse number="20" style="v" sid="MAT 27:20" />Dedee adakumbwa wa wácha byè bè panku ni mazyi wa shē Barabas mazyi wā lò Yesu bwā.<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />Adóshī mbyē'wa shé la, &lt;&lt; Ánɔ̄ yiifu pà ipyɛ̀ hwoila waa ni hwoi fú mazyi ḿ me'u ní yí'ni ní? Wa zɛ̀ la, &lt;&lt;Barabas!&gt;&gt;<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />Bilatus mbyē'wa shé la, &lt;&lt; Áyɛ̄ wa m pi yi sá wa Yesu waa wa ba'u la Ndótɛpa ni? &gt;&gt;</para>
  <para style="p" vid="MAT 27:22">Wa zɛ̀ la, &lt;&lt; Lò u táfyī!&gt;&gt;<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Bilatus mbyē wa shé &lt;&lt; Yishina yɛ̄? Áwú wa bɛ̄bɛ̄ wàni waa u sá ní? Dedee sásá wa dákito ma zɛ̀ la, &lt;&lt; Lò u táfyī!&gt;&gt;<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Dédēwaa Bilatus wya la, u yi kē ní wa wa kà yɔ̀, wa hwoi fú wá dà zyí lá, u kwá lape ma hwo vo'a tō yii pyɛ̀'wa. U zɛ̀ la,&lt;&lt; Avo'm yiifu sà pàlá yɔ̀,&gt;&gt; &lt;&lt; Wa li yi zyí ni!&gt;&gt;<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Sásá bè li zɛ̀ndɛ̀ la, &lt;&lt; Asa a yishina i wa zyē i!&gt;&gt;<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Yibeli, u me Barabas ní yí'wa. Ma lò Yesu ndāvo yi wa da u, ma lò u táfyī.<verse eid="MAT 27:26" /></para>
  <para style="s1">Áwándósèdì Hwa Yesu Wɔ.</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Yibeli, wándósèdì wu dóshī lò Yesu chá ya fu sukpa a dóshī ma lò u shèkwà . <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Wa lò u gbò myàmbyà ma hwo wúchɛ́ wa nyànyà wè'u dì, <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />wa kà kpá bíshī sé ma lò wó'u shina, ma lò kutɛ̀ dó vonzyi, ma kàli yii pyɛ̀ a hwoi sá'u wɛ́. Ma hwoi zɛ̀ la, &lt;&lt;Shí gbógbó Aku àwu Áwáyahuda!&gt;&gt; <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Wa chɛ́chɛ́ wè'u dì, ma kōlò kutɛ̀ ma dá'u shina. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Dédēwaa wa lò wɛ́ sá'u bwā lá, wa lò'u wúkɛ̀ wàgwɔ̄ɔ̀gwɔ̄ tɛ́ ma hwo túkpá'a zé'u ní.<verse eid="MAT 27:31" /></para>
  <para style="s1">Wa Lò Yesu Dábà Bé Fyī</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Dédēwaa wa hwoi nyashɔ hwoi zumyɛ̄ la, wa gbàyi wa pazu wa zu Sayirin, wa ba u la, Siman, wa pà'u wu gba la u lò fyī li. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Wa fè bē zu wa ba u la, Golgota ( u yi tà la, Abe wu Puke Shina) <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Yiibeli, wa yí Yesu zyàbā nūùnū wa wúzu wàjɛ̀jɛ̀, dedee niki waa u mbàwya lá, u nghà wàwā. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Dédēwaa wa lò u dábà bé fyī la, wa lò wúchɛ́'a gà yí di'wa wa shéèshē. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Wa shí hwoi beli, wa hwo zu jā u yibeli. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Wa tā zyí wàkpō'ubī ma lò bà shina'a yii dɔ la, &lt;&lt;Yesu gbaa yinì, Aku wu Áwáyahuda.&gt;&gt; <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Wa hwo vyú kwazɔ ipyɛ̀ dábà bé fyī wa'u, ándózu yii zyɛ̄ vonzyi ndózu yii zyɛ̄ vonsɔ'a. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Ápanku wa hwoi nwázū la hwoi chō tè, ma hwoi jú shina wa <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />ma hwoi zɛ̀ la, &lt;&lt;áwo pà wa lò táwàwáshidɔ yi hwo ma lò u yi myī yiifu nyunu isā lá, tɛ̄ diu ! Tòli zu be fyī, o ma yi Ngo u Shidɔ ni! &gt;&gt;<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Mamá wa áwákù dakumbwa, áwándótà Dɔ̀ Musa wa áwácha sá'u wɛ́. <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />Wa zɛ̀ la, &lt;&lt; U lò wanati tɛ.&gt;&gt; &lt;&lt; dedee, u tɛ dia kà yɔ̀! Ahu gbaa yi Ku àwu Isrela ní! U tòli yishina fyī be zyókù, mazyi i zɛ̀ndɛ̀ wa'u. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />U zɛ̀ndɛ̀ wa Shidɔ. Shidɔ u lò u tɛ̄ tama, u ma shó u ni, dizyi u zɛ̀ la, &lt; M ngyi Ngo wu Shidɔ.&gt;&gt;&gt; <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Kwā áwávyú waa wa hwo'wa dábà bé fyī dùdù wa'u lá, kà chō'u tè.<verse eid="MAT 27:44" /></para>
  <para style="s1">Aki Wu Yesu</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Dà zu shɔ́ idezepyɛ wànyitò gbógbó ya shɔ́ isā wa nyitò abe lò sèfē. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Wa lò shina té shɔ́ isa lá, Yesu shèki wa huna wàgbakpo la, &lt;&lt;Eloi, Eloi, lama sabatani? Tà la, &lt;&lt; Shidɔ'm, Shidɔ'm, áyɛ̄ sá waa o me'm ni ní?&gt;&gt;<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />&lt;&lt;Dédēwaa wándó wa sā hwoili fá mamá lá, wa zɛ̀ la, &lt;&lt; U yi ba Iliya ndɛ̀.&gt;&gt;<verse eid="MAT 27:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48" />Yiibebeli, apazu yiifu'wa shìshɔ̀ ma ya kōlò gàsálà, ma lò'u dó fu zyàbā wàngháànghá, ma lò dó bé kutɛ̀, ma yi ngā wàyí Yesu mazyi ú wā. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Wándó wànati zɛ̀ la, &lt;&lt; Tama ni me'u ní. Mazyi i wya kwɛɛ Iliya yi be ma lò'u yi tɛ̄ kà.&gt;&gt;<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Dédēwaa Yesu kà mbya a dákito la, u lò nū tɛ̄.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Yiibebeli, túkpáwàgònúkyɔ́ wu táwànyɛ̄nyɛ̄ lò yà gàfā ipyɛ̀ dà zu dɔ be zyókù. Abēènmyɛ̄ júùjú, àgɔ́ hwo kyà. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Ámbélā hwō hwó ma lò pò, ākwā panku wànyɛnyɛ hwo dàdɔ. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Wa zumyɛ̄ me mbélā ní, niki waa Yesu lò dàdɔ yiibe ki lá, wa kà fu gá wànyɛ̄nyɛ̄, ápanku buu wya'wa.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Dédēwaa dóshī ndósèdì wa wándó wa hwoi jā Yesu zu la wya zyókù júùjú wa sásá wu wa sá la, wa lò kàzī, wa zɛ̀ la, &lt;&lt; Zyíbyɛ̀ u yi Ngo Shidɔ! &gt;&gt;<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Wáwà ndàbè hwo beli, ma hwo wya bē zu bēnashɔ. Wa bē u ni zu Galili ma hwoi sázá u ni. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Maryamu wàzu Magadala lá, wa Maryamu áyī Yakubu wa Yusufu, wa áyī wu zyē Zebedi.<verse eid="MAT 27:56" /></para>
  <para style="s1">Ázyìzyì Yesu</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Dédēwaa nyunu lò kwò la, ndówúchɔ́ zū zu Arimatiya, zyī la Yusufu be, u yi fu áwátu wu Yesu dúdú. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />U ya ma dò Bilatus, ma mbyeshé kwā wu Yesu, Bilatus yínū la wa lò yi u. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Yusufu lò kwā lò, ma lò kpá wa túkpá wàpyoo, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />ma lò'u hwā fu mbélā'a wàpyoo waa u kā yiifu gɔ́ lá. U gā gɔ́ wàshuwɔ̀ zu ma lò nūkyɔ́ mbélā chù ma ya'a. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Maryamu àwu Magadala wa Maryamu zu lá shí hwoi beli lò zú jā mbélā.<verse eid="MAT 27:61" /></para>
  <para style="s1">Wándó Jāzú Yii Mbélā</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Bànábēkyà, niki nyunu wànghànwū, adakumbwa wàshuwɔ̀ wa Áwáfaris ya dò Bilatus. <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />Wa zɛ̀ la, &lt;&lt; Wàsendo, i kyé la, dédēwaa u kà yi zyoo lá u byè'wa ní la, &lt; Bà nyunu isā m kà lò yi dà.&gt; <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Yimamala, yínū mazyi wa hwo zu hwo jā mbélā ba nyunu isā. Áwátu'a ká bē lò kwā'a vyí mazyi wa zɛ̀ yi panku la u lò dà yɔ̀. Abyè wa kɛkɛ la be yi kà wa kɛ́pyɛ̀ la ni. &gt;&gt;<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />Bilatus zɛ̀ la, &lt;&lt; Ni hwo ndósèdì ni ya lò nwú sá mbélā gyēgyē.&gt;&gt; <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Yibeli, waa ya ma lò mbélā chù gyēgyē, ma kà lò ndósèdì hwa bé li.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s1">Yesu dà Yii Bé Kí</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Yii niki Nyunu Wànghànwū, apúpúnɔ̀ wu nyunu wàkɛ́pyɛ̀, Maryamu wa zu Magdali wa Maryamu zu ya mazyi wa wya mbélā.<verse eid="MAT 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2" />Yiibeli, zyókù júùjú, dizyi ázéchɔ̀ wu Adando tòli zu dɔ , ma ya mbélā , ma lò gɔ gā dɔ ma shí shina'a. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Apwèzu'a sáyìna zúkwáàkwá, átúkpá'a mòmbò sáyìna mbwòfyɔ̄. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Áwándósèdì hwo kàzi wa dì'wàjɔ̄ɔ̀jɔ̄ ma kwèkwè hwo kà sáyìna kwā. <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />Ázéchɔ̀ zɛ̀ yí wáwà la,&lt;&lt; Ni káwa sázī yɔ̀, dizyi m yìnɔ̀ la ni hwoi hwāzú Yesu waa wa lò táfyī <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />U yi maa yɔ̀; u dà'a dɔ ló, sáyìna yiiyi waa u zɛ̀ lá. Bē mazyi ni wya bē waa wa lò'u náni lá. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Yimamala, ni ya mɔ̄mɔ̄ mazyi ni zɛ̀ yi áwátu'a la, &lt;U dàdɔ yi bé ki ló ma kɛ́pyɛ̀ yí'ni ya'a Galili. Ni hwoi wya u yi bē li.&gt; M lò zɛ̀ yi ni mánì.&gt;&gt;<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Yiibeli, wáwà li me mbélā ní mɔmɔ, wa hwo kàzi dedee wa mbònwú, ma shìshɔ̀ ya zɛ̀ yi áwátu'a. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Yiibeli Yesu gbàyi wā wā. Ma zɛ̀ la, &lt;&lt; Ni mgbangye&gt;&gt; Wa bē dò'u, ma lò'u bá hwápà ma wá'u. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Yimamala, Yesu zɛ̀ yi wa la, &lt;&lt; ni ká wa kàzī yɔ̀. Ni ya mazyi ni zɛ̀ yi zyēyī m la wa ya Galili; wa hwoi wya m yi beli. &gt;&gt;<verse eid="MAT 28:10" /></para>
  <para style="s1">Ázyíwàgbāàgbā Wándósèdì</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Dédēwaa wáwà lá hwoi nyàshɔ hwoi yāàyā lá, wándósèdì wanati ya fu gá ma zɛ̀ yí adakumbwa wàshūwɔ̀ sásá wú wàkwò lá. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Dédēwaa áwádakumbwa gbàyi wa wácha ma lò nūmá, ma yi ndósèdì banji buu, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />ma zɛ̀ yi wa la, &lt;&lt; Ni zɛ̀ la, &lt; Áwátu'a bē súnɔ̀ ma lò u lò dédēwaa i hwoi náná la.&gt; <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Ázyí la ma fè bé dóshī, i hwoi wa u yi zɛ̀zyí ni kà hwoi dò &gt;&gt; <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Yimamala, wándósèdì li lò banji li pà ma sá wu wa zɛ̀ yi wa la. Mamá waa wa gbòtà zyī li gbógbó ba nyunu wa zyìná.<verse eid="MAT 28:15" /></para>
  <para style="s1">Kóló Wà Shuwɔ̀</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Yiibeli, àtú kwazɔ̄ idezezu ya Galili, ma né gā be waa Yesu zɛ̀ yi wa la wa ya la. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Dédēwaa wa wya u la,wa wa u; dedee wanati táwàshú. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Yibeli Yesu bē dò wa ma zɛ̀ la, &lt;&lt;Wa hwō sásá gbā wà hwoi dɔ wa bēèmyɛ̄ la yi'm. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Yimamala, ni ya bé panku yii bē sásá mazyi ni lò'wa hwokà tú, ni sá'wa batisma yiifu zyì Dā, wa Ngo, wa Nidi Wànyɛ̄nyɛ̄, <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />ni kà tà'wa mazyi wá zɛ̀ndɛ̀ wúsásá waa m yí'ni nū wà sá lá. Ami gɛ̀ wa'ni hwoi dùdù gbɛ̀n, gbógbó dédē lò yi kɛ̀ .&gt;&gt;<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>