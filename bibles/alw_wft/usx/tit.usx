<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="TIT" style="id">- HALABA NEW TESTAMENT</book>
  <para style="h">ቲቶ</para>
  <para style="toc1">ጳዉሎስ ቲቶሃ ከተቦ ሶህኑተ</para>
  <para style="toc2">ቲቶ</para>
  <para style="toc3">ቲቶ</para>
  <para style="mt1">ጳዉሎስ ቲቶሃ</para>
  <para style="mt2">ከተቦ ሶህኑተ</para>
  <para style="imt1">ኣጉስ</para>
  <para style="ip">ቲቱ ሀንቅ መገኑ አመዕንዮበእ ኡመቲች አመዕነት አደ ፈንቀሎሃ እሀን ጳውሎሴሃ እንጂል ሆጎን መዴስ እክ ሀዕለኖስ ሆጎስያ ጃለ እቅ፤ ጳዉሎስ ከ ሶህኑተ ከተቦሁ ኡምሪን ቀው እኮ ሆጎስ ጃሊሃ ቲቶሃ እኮቤቺሃ ቲቱ ህከ ወክት ዱእ ምኒ ሆጉተ አገረን ቀርጤሳን ሄአኖ እቅ። ሶህኑስ ለልሳኢሁ ሰሱ ቡዕለ እኮ ጠውኒት፦</para>
  <para style="ili">1. ጳዉሎስ ቀርጤስ ባድ መን ሂለ ሃል ደገኖቤቺሃ ህከን ባዶን አመዕናኖ ጭምት አዎንሳኑት ሀትናሙ እሁ ሀስሰኖ ጎሬ ቲቶሃ ጠረኝሽ ሸዘነተ ኣሴስ።</para>
  <para style="ili">2. አመዕናኖ ጭምት ኣዜን ባልቆ ጎነለከ ሜንቱ ህትን ወደልቹ ጎነለከ ሜንት ካዲመተ ሀት ተማርሱ ሀስሰኖ ጎሬ ቲቶሃ ሸዘነተ ኣስዮኡ።</para>
  <para style="ili">3. መጨረሻን አመዕናኑት ሀት ሄኡ ሀስሰኖሰ ጎሬ ወገሬቲንለከ ኢታን ሄአን አመዕናኖ ጭምት በሊች ብተተ፥ ኦደተለከ መለዕለንሸ ቤሶተ ጳዉሎስ ቲቶ ሸዦስ።</para>
  <para style="iot">መጻፉስ አፎሃ</para>
  <para style="io1">ኣጉስ <char style="ior">(<ref loc="TIT 1:1-4">1፥1-4</ref>)</char></para>
  <para style="io1">ዱእ ምኒ አዎንሳኑተ <char style="ior">(<ref loc="TIT 1:5-16">1፥5-16</ref>)</char></para>
  <para style="io1">መገን ምኔን ካድመ አደደ ሆጎ ወጥ <char style="ior">(<ref loc="TIT 2:1-15">2፥1-15</ref>)</char></para>
  <para style="io1">ሸዘነተለከ ኤገተ <char style="ior">(<ref loc="TIT 3:1-11">3፥1-11</ref>)</char></para>
  <para style="io1">መጨረሸስ <char style="ior">(<ref loc="TIT 3:12-15">3፥12-15</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="TIT 1"/>
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1"/>መገን ካዲንቹለከ መሲህ ኢስ አሳቤቹ እኮም ጳዉሎስ መገኑ መጠሮሰ መነ አመዕነትቤቹ ገኢሃለከ መገኑ አጉድ ሀት እክ ሄኡ ሀስሰኖሰ ጎሬ ለሊሰኖ ሀንቅ ደጎተ ተማርሶተ ሹመ እኮም ጳዉሎሴች ሶሀሞእሃ፦<verse eid="TIT 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="TIT 1:2"/>ሁኩ ሀንቁ ዘላለሚሃ ሄኡ ተሬገጥሲሽ ኣሰኖ፤ ህካንን ዘላለሚሃ ሄኡ ኣሰኖኔገ ዘመኒች ብርተ ሄጭ ጠወዕዮሁ ክዝብበሃ መገኑ። <verse eid="TIT 1:2"/><verse number="3" style="v" sid="TIT 1:3"/>ዘማኑስ ኢሌ ወክት ፌሳንቹሃኔ መገን ትዛዚን አን ዱዱብሶተ ኣሰሞኤ ዱዱብስ ኤገ መሳን መገኑ ሶህኑስ ለልሾ።<verse eid="TIT 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="TIT 1:4"/>ሜጡበ አመዕንኖም አመዕነቲን ሀንቅ ቤቱኤ እኮ ቲቶ አነ እኮ መገኒችለከ ፌሳንቾ መሲህ ኢሲች ኣስቱትለከ ወገሬቱ ኬሳሃ እሁን።<note caller="-" style="x"><char style="xo" closed="false">1፥4 </char><char style="xt" closed="false"><ref loc="2CO 8:23">2 ቆሮ. 8፥23</ref>፤ <ref loc="GAL 2:3">ገላ. 2፥3</ref>፤ <ref loc="2TI 4:10">2 ጢሞ. 4፥10</ref>።</char></note><verse eid="TIT 1:4"/></para>
  <para style="s1">ቲቱ ቀርጤሳን አዕዮ ሆጉተ</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5"/>ኬሳሃ ቀርጤሳን አጉሮም መሰት መክበርቹ መክሶተለከ አን አዘዦንኬገን ከተማን ጉዕማንን አመዕናኖ ባልቀተ ሾንቶታት። <verse eid="TIT 1:5"/><verse number="6" style="v" sid="TIT 1:6"/>አመዕናኖ ባልቁንኩ ቀነጤኖስርቹ ዮበኢሃ፥ መቴ መንቾ ምኒ አነ እኮኢሃ፥ ማሊተ አኢንለከ አዘዛሙ ሆጊን ዎቀሰንትቡ መገኑ አመዕንቶ እለት ዮሲሃ እሁ ሀስሰኖስ። <verse eid="TIT 1:6"/><verse number="7" style="v" sid="TIT 1:7"/>መሰንትስ አመዕናኖ ዱእ ምኒ አዎንሳንቹ መገን ሆጎ ኤገተ ቶጎሃ እኮቤቺሃ ቀነጤኖስርቹ ዮበኢሃ እሁ ሀስሰኖስ፤ እስን ቦንባሃ፥ ኡሙዕርባሃ፥ ሰከርባሃ፥ ብተምባሃለከ ብሪሃ ጎራይባሃ እሁ ሀስሰኖስ። <verse eid="TIT 1:7"/><verse number="8" style="v" sid="TIT 1:8"/>ጠዉ እኮጎሬ ኮሃ ቶገኖሃ፥ ጡመ ጠወ ኢተኖሃ፥ ገዉስ አገዕረኖሃ፥ ሀንቅ ኢተኖሃ፥ መገን ሆጎተ አደ እኮሃለከ ዮስ ጌሲን ሄአኖ እሁ ሀስሰኖስ። <verse eid="TIT 1:8"/><verse number="9" style="v" sid="TIT 1:9"/>እስን ዎሉ መነ ሀንቅ ትምህርት ተማርሰን ሸዞተለከ ህከ ላገተ ኦደ መኒሃ መስለ ኣሶተ ከኒች ብርተ ተማሮ ትምርት ሃሊን አመዕነንቶ ላጋን ጠረኙን።<note caller="-" style="x"><char style="xo" closed="false">1፥6-9 </char><char style="xt" closed="false"><ref loc="1TI 3:2-7">1 ጢሞ. 3፥2-7</ref>።</char></note><verse eid="TIT 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10"/>ልግቡ መኑ በትሽን አይሁድ አድረ እኮእሩ ጡርከሜኖ ሴረ አዎንታሩ፥ አዘዘንትበረለከ ተሰ እኮ ጠወ ጠወአን ሉሲሳእሩ ዮኡ። <verse eid="TIT 1:10"/><verse number="11" style="v" sid="TIT 1:11"/>ከ መናከተ ሰዕም ይታገ አኡ ሀስሰኖ፤ እሰን ገበእበ ትርፈ ደእቶተ ገበእበ ጠወ ተማርስተን አበሮሱ ጉዕመንከ ኩማዳአ። <verse eid="TIT 1:11"/><verse number="12" style="v" sid="TIT 1:12"/>እሳች መቱስ ገይሰ ራጋንቹ «ቀርጤስ መኑ ጉዕመ ወክት ክዝበኛኑተ፥ ሂለ ቡሳወ እኮእራ፥ ሆጉተ ኢትቲበለከ ጎራሜቻኖታን» ዬእ። <verse eid="TIT 1:12"/><verse number="13" style="v" sid="TIT 1:13"/>ኩ መሰከረሞ ጠዉንኩ ሀንቅሃን፤ ህካን እኮቤቺሃ ዊሙ አመዕነቱ ሄኦሰተ ከ መነ ጠረኝስ ኡሙዕር። <verse eid="TIT 1:13"/><verse number="14" style="v" sid="TIT 1:14"/>አይሁድ መን ማቁተ አዎንትበገለከ ሀንቅ ግብ ኦዳ መን ትዛዝ ሞጮጭትበገ ጠረኝስ ኡሙዕርሰ። <verse eid="TIT 1:14"/><verse number="15" style="v" sid="TIT 1:15"/>ነጠ መኒሃ ጉዕሙርቹንኩ ነጠሃን፤ ጠው እኮጎሬ ንጃሶሀኑኡተለከ አመዕንትበሀኑኡተ መቱርቹሁ ነጣበአ፤ ህትን ቀልቡሰለከ ሰው ይታርቹ ንጃሾእሃን። <verse eid="TIT 1:15"/><verse number="16" style="v" sid="TIT 1:16"/>እሰን «መገኑ ደንጋም» ይተን ሆጎንተሰ እሱ ለገኣእረ፤ ህትን ኮፍ ይታእረ፥ አዘዘንትበረለከ ጡመ ሆጉተ አኡ አታልትበረ።<verse eid="TIT 1:16"/></para>
  <para style="b"/>
  <chapter eid="TIT 1"/>
  <chapter number="2" style="c" sid="TIT 2"/>
  <para style="s1">ሀንቅ ትምርትተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1"/>አት እኮጎሬ ሀንቅ ትምህርት ተማርስ። <verse eid="TIT 2:1"/><verse number="2" style="v" sid="TIT 2:2"/>ኡሙሪን ባልቆ ጎኑ ወልቀሰ ጌሲን ሄኣእራን፥ ኬዕምኝሰ አገርታእረ፥ ገውሰ አገርታእረ፥ አመዕነቲንለከ ኢታን አታዕሊኒን ሂልመት ዮሰበእረ እካገ ሸዝሰ። <verse eid="TIT 2:2"/><verse number="3" style="v" sid="TIT 2:3"/>ህትን ኡሙሪን ባሊቆ ሜንቱ አመዕነቱሰ አገርት ሄኣእረ ሄዕምትበረለከ ሰከርትበረ ጡመ ጠወ ተማርስታእረ እካገ ሸዝሰ። <verse eid="TIT 2:3"/><verse number="4" style="v" sid="TIT 2:4"/>ህትን ባሊቆ ሜንቱ ሀርድ ሜንቱ ምንሰ አናኑተለከ እለሰ እትታእረ፥ <verse eid="TIT 2:4"/><verse number="5" style="v" sid="TIT 2:5"/>ገውሰ አገዕርታእረ፥ ነጣኑተ፥ ጉዕመርቾንን ምንሰ አገርታእረለከ ምንሰ አናኑተ ኬዕምሳእረ እካገ ተማርስቱንሰ፤ ህካንን አታኢሁ መገን ላገት ህንቀንታበእጋት።<verse eid="TIT 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6"/>ህትን ዎደልቹ ገውስ አገዕር ሄአኖገ ሸዝ። <verse eid="TIT 2:6"/><verse number="7" style="v" sid="TIT 2:7"/>አት ጡመ ጠወ አተን ጉዕመ ጠዋንን ምሳልተ እህ፤ ትምርቲንከክ ሀንቅ መንቹ እሁክለከ ደግለለኖ ጠዉ ዮሄ መንቹ እሁክ ለሊስ። <verse eid="TIT 2:7"/><verse number="8" style="v" sid="TIT 2:8"/>ህንቄኖበእ ጡመ ጠወ ለሊስሰ፤ ከን ሃሌን ኔሳሃ ግባኔሩ ኒ አሌን ጠወአ ሂለ ጠወ ሆጋረ ሙልታአ።<verse eid="TIT 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9"/>ካዲመት ቀርቻኖተሰ አዘዘንታገ፥ ጉዕመርቾንን ቀርቻኑሰ ሙንዲሲሳገ፥ ሂለ መስለ ፈንቀሽት ጠወኣበእገ፥ <verse eid="TIT 2:9"/><verse number="10" style="v" sid="TIT 2:10"/>ሞግትበገ ሸዝሰ፤ በትሽን ፌሳንቹሃኔ መገን ትምርቱ ጉዕመ ጠዋንን ኢተሞሃ እሆተ ጉዕመ ወክት ዊመ ደገንቶእረ እኩን።<verse eid="TIT 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11"/>መገኑ መነ ጡምሰኖ ኣስቱስ ጉዕሚንከ ለሊሾኡ። <verse eid="TIT 2:11"/><verse number="12" style="v" sid="TIT 2:12"/>ሁኩ ኣስቱንት ለግተለከ ኣዱንያ አል ሄዕላቸተ አጉሬን ገዉ አገዕሪን፥ ጌጥዬለከ መገኑ አጉዲን ከን ዘማኔን ሄዕኖተ ተማርሰኖኔ። <verse eid="TIT 2:12"/><verse number="13" style="v" sid="TIT 2:13"/>ከን ሃሊን ማሰአሞ ተብሳኔ ሁኩንን ሎሩ መገኑኔለከ ጡምሳንቹኔ መሲህ ኢስ ኬዕምኚን አሜቱስ አገዕርናም። <verse eid="TIT 2:13"/><verse number="14" style="v" sid="TIT 2:14"/>መሲህ ኢስ ሾክማች ጉዕሚችን ጡምሶኔተለከ ጡመ ሆጉተ አዕኖተ ጠረኛኑተለከ እሲሃ አደ እንኮም ነጠ ኡመት እንኮተ ነጠ አኦኔተ ኒተኔሃ ገዉስ ህግሽ ኣሴእ።<note caller="-" style="x"><char style="xo" closed="false">2፥14 </char><char style="xt" closed="false"><ref loc="PSA 130:8">መዝ. 130፥8</ref>፤ <ref loc="EXO 19:5">ፉል. 19፥5</ref>፤ <ref loc="DEU 4:20">ዘዳ. 4፥20</ref>፤ <ref loc="DEU 7:6">7፥6</ref>፤ <ref loc="DEU 14:2">14፥2</ref>፤ <ref loc="1PE 2:9">1 ጴጥ. 2፥9</ref>።</char></note> <verse eid="TIT 2:14"/><verse number="15" style="v" sid="TIT 2:15"/>ቴሱ ከ ጉዕመንከ ጠወ ዊመ ሹምነቲን ተማርስ፤ ሸዝ፤ ኡሙዕር፤ አዪሁ ህንቁንከሄ።<verse eid="TIT 2:15"/></para>
  <chapter eid="TIT 2"/>
  <chapter number="3" style="c" sid="TIT 3"/>
  <para style="s1">አመዕናኖ ሄእተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1"/>መኑ ጉዕሙንኩ ገሽታሰሀኑኡተለከ ዳኛኖተ ገዉሰ ሆፍስ አዘዘንቶተ ጡመ ሆጉተ ጉዕመንከ አቶተ ተቃጠቦረ እኮተ <verse eid="TIT 3:1"/><verse number="2" style="v" sid="TIT 3:2"/>ሀከን መንች አሌኒ ሂለ ጠወ ጠወኣበእገ ሰዉ ይታገ አእሰ፤ በትሽን መኒን ብተንትበረለከ ጎደበ ላፋኑተ፥ ገዉ ሙግ አኤን ሄኡ መኒሃ ጉዕሚንከ ለሊሳእረ እኩን። <verse eid="TIT 3:2"/><verse number="3" style="v" sid="TIT 3:3"/>ነኡን ከኒች ብርተ ገዋኑተ፥ ትዛዝ ቶንግበረ፥ ጡመ ዎቃሃ ሉንሶምረ፥ አደደ ሂለ ሄዕላቻተለከ ማል ተሽቲሃ ጠገሞምረ፥ ተንኮንለከ ምቀኞማን ሄዕናምረ፥ ግበሞምረለከ መት-መቲንከኔ ኢተቀምበረ እቅ። <verse eid="TIT 3:3"/><verse number="4" style="v" sid="TIT 3:4"/>ጠው እኮጎሬ ጩብችኔ ጡምሾኔ መገንኔ ጎደብ ለፍመትለከ ኢተት ዊንቶ አሙዙ ለሌ ወክት <verse eid="TIT 3:4"/><verse number="5" style="v" sid="TIT 3:5"/>ነኡ አዕኖም ፈየ ሆጎንተኔ እሁዕናን ገዉንኩስ ማርቶንከስ ጡምሾኔ፤ ጡምሾኔንኩ ሃዕሮ እለሚን አዕሊንለከ ጠሊለ አያኒን ደገሞ ሃዕሮሃ ሄኡ። <verse eid="TIT 3:5"/><verse number="6" style="v" sid="TIT 3:6"/>መገኑ ኣስቶንከስ ጡምሳንቹሃኔ መሲህ ኢስ አዲን አያነስ ኒ አሌን በትሽ ደፈፍሾኔ። <verse eid="TIT 3:6"/><verse number="7" style="v" sid="TIT 3:7"/>ህካንን አዕዮሁ ኣስቶንከስ ፈያኑተ እንክ ተብሴን አገርናም ዘላለሚሃ ሄአኖ ሄኡ ረገዕኖታት። <verse eid="TIT 3:7"/><verse number="8" style="v" sid="TIT 3:8"/>ኩን አመዕነሞእሃ ጠወ፤ መገኖን አመዕንቶ መናከት ጡመ ሆጎተ ጠረኝቶተ ከ ጠወ ጉዕመንከ ጠረኝስ ቃግሶተ ሀሳም፤ ኩ ጠዉንኩ ጡመለከ ጉዕመ መኒንከ ደግለለኖሃን። <verse eid="TIT 3:8"/><verse number="9" style="v" sid="TIT 3:9"/>ጠዉ እኮጎሬ ተሰ እኮ ኦዳች፥ ደቦ ዎልንሺች፥ ብታች፥ ሕግ መሳን ኬአኖ ጠዊች ቄዕር፤ ህትኔ ጠዉንኩ ደግለልባሃለከ ተሰሃን። <verse eid="TIT 3:9"/><verse number="10" style="v" sid="TIT 3:10"/>አደዶመተ ኤበኖ መንቹ መቶረ ህከረንገ ለሞረ ሸዞንትሲች ኤተሮን እሲች አደ እህ። <verse eid="TIT 3:10"/><verse number="11" style="v" sid="TIT 3:11"/>ህትኔ መንቹ ሂላለከ ጩበኛሃን፤ እስ ገይስ አሌን ፈረጆ እሁስ ደግ።<verse eid="TIT 3:11"/></para>
  <para style="s1">መጨረሽ ሸዘነተ</para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12"/>አርጤማሴ ህከረንገ ትኪቆሴ ኪቤቹ ሶሃም ወክት አን ዮም ቤቹ ኒቆጵልዮነ ደዕልት አም፤ አን ከርም ህከኔ ዱንኮተ ሙዕርዮም።<note caller="-" style="x"><char style="xo" closed="false">3፥12 </char><char style="xt" closed="false"><ref loc="ACT 20:4">ሶቀ. 20፥4</ref>፤ <ref loc="EPH 6:21-22">ኤፌ. 6፥21-22</ref>፤ <ref loc="COL 4:7-8">ቆላ. 4፥7-8</ref>፤ <ref loc="2TI 4:12">2 ጢሞ. 4፥12</ref>።</char></note> <verse eid="TIT 3:12"/><verse number="13" style="v" sid="TIT 3:13"/>ሕገ ደገኖ ዜናስለከ አጵሎስ ዎቃሰ ሃንቶተ ደግለለኖሰርቹ ጉዕመንከ ሀዕልሰ።<note caller="-" style="x"><char style="xo" closed="false">3፥13 </char><char style="xt" closed="false"><ref loc="ACT 18:24">ሶቀ. 18፥24</ref>፤ <ref loc="1CO 16:12">1 ቆሮ. 16፥12</ref>።</char></note> <verse eid="TIT 3:13"/><verse number="14" style="v" sid="TIT 3:14"/>ኒ መኑንኩ አቶቱ ዮበኢሃ ፈቃበእገለከ ደግለሸቀም ኦርሻች ጡምቶተ ጡመ ሆጉተ አኡ ተማርቱን።<verse eid="TIT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15"/>ኢን ሜጡበ ዮኢሩ ጉዕሙንኩ «ዎገሬቴ ዮንተንዶ?» ይቶህዕኔ ይሰ፤ አመዕነቲን ኒን ሜጡበ እኮ ጃላተኔ ጉዕሚንከ ወገሬት ኢልስ።</para>
  <para style="p" vid="TIT 3:15">መገን ኣስቱት ጉዕሚንከክዕኔ ሜጡበ እኩን።<verse eid="TIT 3:15"/></para>
  <chapter eid="TIT 3"/>
</usx>
