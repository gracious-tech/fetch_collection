<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="REV" style="id">- HALABA NEW TESTAMENT</book>
  <para style="h">ያህይ ለዕዮ መናመተ</para>
  <para style="toc1">ያህይ ለዕዮ መናመተ</para>
  <para style="toc2">ያህይ ለዕዮ መናመተ</para>
  <para style="toc3">መና.</para>
  <para style="mt">ያህይ ለዕዮ መናመተ</para>
  <para style="imt1">ኣጉስ</para>
  <para style="ip">ያህይ ለዕዮ መናመት ከተበንቶኢሁ አመዕናኑት መሲህ ኢስ ቀርቹሰ እሁስ አመዕንሰ መሳን ቶቸሙለከ ኦርሸት ኢልቶሰ ወክትዪት። ከተቦስሀን ቡዕለ እኮ ጠዉ አነበባእረ ተብሶሰ ዊመ እሆተ ጠረኝሲሃለከ ኢልቶሰ ኦሪሸ ኣዜን አመዕነቶንከሰ ጠረኝታገ አኢሃት።</para>
  <para style="ip">መጻፍስ ኣዜን በተአኖስ አዱ ልግብለከ አዎዕናቀንት ዮእ መገኑ ለልሾስ ሶህኑተ አፎእሃን፤ መገኑ ለልሾስ ሶህኑት ህከን ዘማኔን ሄኦ አመዕናኑት ኤንኬዕንታኢሃ እክ ዎሎ መኒሃ እኮጎሬ ምስጥር ምስል ሃሊን ሆንጠኮእራን። መዝሙረ ፈንቀላንሴን ዬኖሀገን መጻፍስ ቡዕለ እኮ ጠዉ አደደ መገኑ ለሊሾስ ሶህኖ መሳን አደደ ደኒን በርጋቀም ሆንጠኮኡ። መጻፈስ ፈሰርተኔሃ አደ እኮ ሰውቱ ሄዕዮስጎሬ ቡዕለ እኮ ጠዉ ለልዮእሃን፤ ሁኩንን መገኑ ቀርቾሃ መሲህ አዲን ለንኪሃ በርግበ ሃሊን መቶረለከ ኤተሩ አዕይ ሸይጣኒን ሜጡበ ዲነ ጉዕመንከ ቄለኖ፤ ዲነ ቄሎች ኤተሮን አመዕነንቶስሀኑኡተ ሃዕሮ ሰማለከ ኡለተ ረገእሲሰኖሰ።</para>
  <para style="iot">መጻፉስ አፎሃ</para>
  <para style="io1">ኣጉስ <char style="ior">(<ref loc="REV 1:1-8">1፥1-8</ref>)</char></para>
  <para style="io1">መገኑ ለሊሾስ ሶህኑት ፈንተኡለከ ለመለ መገን አመዕናኖ ዱእ ጭምት ምናች ሶሀንቶ ሶህኑተ <char style="ior">(<ref loc="REV 1:9-3:22">1፥9—3፥22</ref>)</char></para>
  <para style="io1">መጻፈስለከ ለመለ ማተበ <char style="ior">(<ref loc="REV 4:1-8:1">4፥1—8፥1</ref>)</char></para>
  <para style="io1">ለመለ ጡሩምበ <char style="ior">(<ref loc="REV 8:2-11:19">8፥2—11፥19</ref>)</char></para>
  <para style="io1">ደህቹለከ ለሙ ግዘ <char style="ior">(<ref loc="REV 12:1-13:18">12፥1—13፥18</ref>)</char></para>
  <para style="io1">አደደ መገኑ ለሊሾስ ሶህኑተ <char style="ior">(<ref loc="REV 14:1-15:8">14፥1—15፥8</ref>)</char></para>
  <para style="io1">ለመለ መገን ኡሙዕሬ ጠበትተ <char style="ior">(<ref loc="REV 16:1-21">16፥1-21</ref>)</char></para>
  <para style="io1">ባብሎን በኡ፥ ቡሳውች፥ ክዝበኘ ነብዬችለከ እልቢስ ቄልተኡ <char style="ior">(<ref loc="REV 17:1-20:10">17፥1—20፥10</ref>)</char></para>
  <para style="io1">ቂያመ ፍርደ <char style="ior">(<ref loc="REV 20:11-15">20፥11-15</ref>)</char></para>
  <para style="io1">ሃዕሮ ሰማሃ፥ ሃዕሮ ኡለተ፥ ሃዕሮ ዬሩሳሌመ <char style="ior">(<ref loc="REV 21:1-22:5">21፥1—22፥5</ref>)</char></para>
  <para style="io1">መጨረሽስ ሰውት <char style="ior">(<ref loc="REV 22:6-21">22፥6-21</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="REV 1"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1"/>ኩ መገኑ ለሊሾስ ሶህኑት ግደኖ ወክቴን እሀኖሀ እሁስ ካዲማተስ ለሊሶተ መገኑ መሲህ ኢሲሃ ኣስዮስሃን፤ መሲህ ኢሲን መላይኬቹስ ሶክ ካዲሚሀስ ያህዪሃ ከ ሶህኑተ ለሊሾስ። <verse eid="REV 1:1"/><verse number="2" style="v" sid="REV 1:2"/>ያህይን መገን ላገተኔሃለከ መሲህ ኢስ ምስክር እህስተኔሃ ህትን ለሊሾስ ጠወ ጉዕመንከ መሰከሮ። <verse eid="REV 1:2"/><verse number="3" style="v" sid="REV 1:3"/>ኩ ጠዉ ጉዕሙንኩ እሀኖ ወክቱ ግደኑ እኮቤቺሃ ከ ራግ ላገተ አነበበኖሁ ማሰአሞእሃን፤ ህትን ከ ራግስ ላገተ ሞጮጭታእሩለከ ከን ራግ ላገ ኣዜን ከተበሞሃ አታእሩ ማሰአንቶእራን።<verse eid="REV 1:3"/></para>
  <para style="s1">ለመለንከ እስይ አመዕናኖ ዱእ ምናች ሶሀሞ ወገሬትተኔሃ</para>
  <para style="p">
    <verse number="4-5" style="v" sid="REV 1:4-5"/>ያህዪች እስይ ባዶን ለመላንከ መገን አመዕናኖ ዱእ ጭምት ምናች ዮሀኒች፥ ሄዕዮሀኒችለከ አሜተኖ መገኒች፥ ጄነትስ ቦርጭመ ብሬን ዮ ለመለ አያኒች፥ ህትን ሬሆች ኬኢን ሀንገፈ እኮ ኣዱንያ አል ዎመ ዳኛኑተ ገሸኖሃ፥ አመዕነሞ ምስክር እኮ፥ ኢተኖህዕኔሀኒችለከ ቄጊንከስ ጩቢችኔ ነጠ ፉሼኔ መሲህ ኢሲች ኣስቱትለከ ወገሬቱ ክዕኔሃ እሁን።<note caller="-" style="x"><char style="xo" closed="false">1፥4 </char><char style="xt" closed="false"><ref loc="EXO 3:14">ፉል. 3፥14</ref>፤ <ref loc="REV 4:5">መና. 4፥5</ref>።</char></note><note caller="-" style="x"><char style="xo" closed="false">1፥5 </char><char style="xt" closed="false"><ref loc="ISA 55:4">ኢሳ. 55፥4</ref>፤ <ref loc="PSA 89:27">መዝ. 89፥27</ref>።</char></note> <verse eid="REV 1:4-5"/><verse number="6" style="v" sid="REV 1:6"/>መሲህ ኢስ አና መገኑ ካደሞተ መንግስትስ ኡመት ቂሰተ አዕዮኔ መሲህ ኢሲሃ ኬዕምኙለከ ወልቀት ዘማንሃ ጉዕሚንከ ኢለ እሁን! ኣሚዕን።<note caller="-" style="x"><char style="xo" closed="false">1፥6 </char><char style="xt" closed="false"><ref loc="EXO 19:6">ፉል. 19፥6</ref>፤ <ref loc="REV 5:10">መና. 5፥10</ref>።</char></note><verse eid="REV 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 1:7"/>መኑ ጉዕሙንኩ እሱ ቀሶሩ ፈቁዕናን ጎማን አሜተን ለኣአ፤ ህትን ኣዱንያ አሌን ዮ ኡመቱ ጉዕሙንኩ አሜትስተኔሃ ኦኣአ፤ ሁኩ ጠዉ ሀንቅሃን፤ ኣሚዕን።<note caller="-" style="x"><char style="xo" closed="false">1፥7 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳን. 7፥13</ref>፤ <ref loc="MAT 24:30">ማቶ. 24፥30</ref>፤ <ref loc="MRK 13:26">ማር. 13፥26</ref>፤ <ref loc="LUK 21:27">ሉቃ. 21፥27</ref>፤ <ref loc="1TH 4:17">1 ተሰ. 4፥17</ref>፤ <ref loc="ZEC 12:10">ዘካ. 12፥10</ref>፤ <ref loc="JHN 19:34-37">ያህ. 19፥34-37</ref>።</char></note><verse eid="REV 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8"/>ጉዕመንከ አታለኖ ዎዕናሃ፥ ቴሁ ዮኢሁለከ አሜተኖ ቀርቹ መገኑ «ዎዕኔሁለከ ኤተሪሁ አኔት!» የኖ።<note caller="+" style="f"><char style="fqa" closed="false">«ዎዕኔሁለከ ኤተሪሁ አኔት!» የመሞሁ አማርሳን አልፈለከ ኦሜገ፦ </char><char style="ft" closed="false">የኖሁ አማርሳን «ወዕኔ ‹ሀ› ፍደልገለከ ኤተር ‹ፐ› » ፍደልጋት፤ ህትን ግሪክ ባድ ፍደሊን ዎዕኔለከ ኤተር ፍደለ ዩሃን፤ ሁኩን ጉዕሙንኩ መገን ዎልቀ ኣዜን ሄኡስ ለሊሰኖ።</char></note><note caller="-" style="x"><char style="xo" closed="false">1፥8 </char><char style="xt" closed="false"><ref loc="REV 22:13">መና. 22፥13</ref>፤ <ref loc="EXO 3:14">ፉል. 3፥14</ref>።</char></note><verse eid="REV 1:8"/></para>
  <para style="s1">መሲህ ያህዪሃ ለሌገ</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9"/>አን አመክዕኔ ቤቱ ያህይ ኢስተኔሃ ኦሪሸተ ኣኡለከ አታዕሉሃ መገን ጄነት ኣጉሃ ክዕኔንን ሜጡበ ወጡ ዮኤሃን፤ አንን መሲህ ኢስ ዱዱብሴ መገን ላገተ ጠወዕዮምቤቺሃ ዊን ረበንቶ «ፍጥሞ» ዬኖ ባዶን ሄዕዮም እቅ። <verse eid="REV 1:9"/><verse number="10-11" style="v" sid="REV 1:10-11"/>ቀርች በሬን ጠሊለ አያኒን እክ ሄዕዮም ወክት ኤተርኤ አዲን «ከ ለኣንቲሃ መጻፋን ከተብ፤ መጻፈስ ‹እስየ› ዬኖ ባዶን ዮ ‹ኤፌሶኒሃ፥ ሰምርኔሲሃ፥ ጴርጋሞኒሃ፥ ትያጥሮኒሃ፥ ሰርዴሲሃ፥ ፊላደልፍየለከ ሎዶቅየ› ዬኖ ለመላንከ ከተማን ዮ አመዕናኖ ዱእ ምነ ጭምቲሃ ሶህ» ይታ ጡሩምብገ ዮ አበ ላገተ ሞጮጬም። <figure style="fig" alt="Lamp stand" file="HK00264B.tif" size="span" ref="1፥12-13">ወርቂን መክሴመ ለመለ ኩራዘ አፉሼኖሃ</figure><verse eid="REV 1:10-11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12"/>ጠወዕዮኤ መንቹ ለኦተ ኤተር አደ ዘህ ለዕዮም ወክት ዎርቂን መክሴመ ለመለ ኩራዘ አፉሼኖሀኒንከስን ለዕዮም፤ <verse eid="REV 1:12"/><verse number="13" style="v" sid="REV 1:13"/>ህከን ኩረዘ አፉሼኖሀን በላን ሎከስ ኢለ ቅራዕሩ ኦድኑተ ኦደዕይ ወዘነስ ዎርቅ ቀበቶን ቆዕሬ መንች ቤቱ አጉደኖሃ ለዕዮም።<note caller="-" style="x"><char style="xo" closed="false">1፥13 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳን. 7፥13</ref>፤ <ref loc="DAN 10:5">10፥5</ref>።</char></note> <verse eid="REV 1:13"/><verse number="14" style="v" sid="REV 1:14"/>ቡዕሉስለከ ሙሙስ በረድገለከ ሱፍገ ዋጁሃ እቅ፤ ህትን እልስ ጊረ ለበነተ አጉዳ እቅ።<note caller="-" style="x"><char style="xo" closed="false">1፥14-15 </char><char style="xt" closed="false"><ref loc="DAN 7:9">ዳን. 7፥9</ref>፤ <ref loc="DAN 10:6">10፥6</ref>።</char></note> <verse eid="REV 1:14"/><verse number="15" style="v" sid="REV 1:15"/>ሎከስ ምዳች ጊረ ክፈሊን መክሴመ ናሰ ዬኖ ብረት አጉደኖሃ እቅ፤ ላገስ ፋማን ዛዘኖ ዊ ላገገ ዮእሃ እቅ።<note caller="-" style="x"><char style="xo" closed="false">1፥15 </char><char style="xt" closed="false"><ref loc="EZK 1:24">ሕዝ. 1፥24</ref>፤ <ref loc="EZK 43:2">43፥2</ref>።</char></note> <verse eid="REV 1:15"/><verse number="16" style="v" sid="REV 1:16"/>መኬስ አንጋን ለመለ ቤዜተ አፎ እቅ፤ እስ አፌች ለሞ አዲን እጳሹ ሲፉ ፉለኖ እቅ፤ ህትን ሚንስ ዊመ ኑሪን ለሊሰኖ አሪጋት እቅ። <verse eid="REV 1:16"/><verse number="17" style="v" sid="REV 1:17"/>አን እሱ ለዕዮንስ ወክት ሬዮ መንገ እክ ሎከስ ኣዜን ኡቦም፤ እኮጎሬ እስን መኬስ አንገተ አሌእ አዕይ «ዋጅቶት! ብሬሁለከ ኤተሪሁ አኔት።<note caller="-" style="x"><char style="xo" closed="false">1፥17 </char><char style="xt" closed="false"><ref loc="ISA 44:6">ኢሳ. 44፥6</ref>፤ <ref loc="ISA 48:12">48፥12</ref>፤ <ref loc="REV 2:8">መና. 2፥8</ref>፤ <ref loc="REV 22:13">22፥13</ref>።</char></note> <verse eid="REV 1:17"/><verse number="18" style="v" sid="REV 1:18"/>አን ሄኣምሃን፤ አን ሬዮም እቅ፤ ጠዉ እኮጎሬ ቴሁ ዘላለሚሃ ሄኣምሃን፤ ህትን አን ሬሁተለከ አዛብ ፈናም ቁልፉ ዮኤ። <verse eid="REV 1:18"/><verse number="19" style="v" sid="REV 1:19"/>ቴሱ ለኦንቲሃ ዮኢሀለከ ከኒች ኤተሮን አሜተኖሃ ለኣንቲሃ ከተብ። <verse eid="REV 1:19"/><verse number="20" style="v" sid="REV 1:20"/>ዎርቂን መክሴመ ለመለንከ ኩራዘ አፉሼኖሀንለከ መኬ አንጋን አፋን ለኦንት ለመለንከ ቤዜ ፍሳረት ከኒት፤ ለመሉ ቤዜት ለመላንከ መገን አመዕናኖ ጭምት ዱእ ምነተ መላይከ፤ ህትን ለመሉ ኩራዛ አፉሼኖሁ ለመለንከ መገን አመዕናኖ ጭምት ዱእተ ምነ» ዬኤ።<verse eid="REV 1:20"/></para>
  <chapter eid="REV 1"/>
  <chapter number="2" style="c" sid="REV 2"/>
  <para style="s1">ኤፌሶን ባዶን መገን አመዕናኖ ዱእ ምናተ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1"/>ኤፌሶን መገን አመዕናኖ ዱእ ምና መላይኬቺሃ «ለመል ቤዜተ መኬ አንጋን አፎሃለከ ለመለ ወርቅ ኩረዘ አፉሼኖሀን በላን ፈንቀላመኖሁ፤ <verse eid="REV 2:1"/><verse number="2" style="v" sid="REV 2:2"/>ሆጉክ፥ አጰንታንትገለከ አታዕሉክ ደጋም፤ ጠዉ እኮጎሬ ሂላኑተ አታሉ ሆጉክ ህትን አሳበኤ እኩዕናን ‹አሳበታን› ይታ መነ ክዝበኛኑተ እኮገ አጥራመት ደጉክ ደጎም። <verse eid="REV 2:2"/><verse number="3" style="v" sid="REV 2:3"/>አታዕሊን ጠረኙክለከ ሱዕምኤተኔሃ ህፈቱዕናን ኦርሸተ ቶጉክ ደጎም፤ <verse eid="REV 2:3"/><verse number="4" style="v" sid="REV 2:4"/>ጠዉ እኮጎሬ መቱ ግባንኬ ጠዉ ዮኢሁ ወዕና ዮሄ ኢተተ አጉርቶንት። <verse eid="REV 2:4"/><verse number="5" style="v" sid="REV 2:5"/>ሀከኔ ኡቦንት ጎር ሰውይት ቶበት! ወዕና አተን ሄኦንት ሆጉክ አእ፤ ህካን ጉዕመንከ አትበጎሬ ኪቤቹ አሜታም፥ ቶበትበጎሬ ኩረዘ አፉሼኖሃ ቤቺችስ ኬሽ ከማም። <verse eid="REV 2:5"/><verse number="6" style="v" sid="REV 2:6"/>ጠዉ እኮጎሬሁ አን ግቦምገን ንቆላዉያኑት አታ ሆጉተ ግቡክ ጡመሃን።<verse eid="REV 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 2:7"/>«መገን አያኑ መገን አመዕናኖ ጭምት ዱእ ምናተ የኖሃ መጨት ዮሲሁ ሞጮጩን! ‹ድለ አዕዮሀኒሃ መገን ቤቾን ፎሎጬኖ ቤቾን ነጴ ሄእ ሀቁቾ ላልቹ እተኖገ አኣም› የኖት» ይት ከተብ።<note caller="-" style="x"><char style="xo" closed="false">2፥7 </char><char style="xt" closed="false"><ref loc="GEN 2:9">ክል. 2፥9</ref>፤ <ref loc="REV 22:2">መና. 22፥2</ref>፤ <ref loc="EZK 28:13">ሕዝ. 28፥13</ref>፤ <ref loc="EZK 31:8">31፥8</ref>።</char></note><verse eid="REV 2:7"/></para>
  <para style="s1">ሰምርኔስ መገን አምዕናኖ ዱእ ምናተ</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8"/>«ሰምርኔስ መገን አመዕናኖ ዱእ ምነ መላይኬቺሃ፦<note caller="-" style="x"><char style="xo" closed="false">2፥8 </char><char style="xt" closed="false"><ref loc="ISA 44:6">ኢሳ. 44፥6</ref>፤ <ref loc="ISA 48:12">48፥12</ref>፤ <ref loc="ISA 1:17">1፥17</ref>፤ <ref loc="ISA 22:13">22፥13</ref>።</char></note></para>
  <para style="p" vid="REV 2:8">«ዎኔሁለከ ኤተሪሃ እኮ፥ ሬዮሀኒችለከ ፎሊን ዮሀኒች ሶሀንቶእተ፤ <verse eid="REV 2:8"/><verse number="9" style="v" sid="REV 2:9"/>ኦርሸክለከ ቡጥመክ ደጋም፤ እሁን ቤሉ አት ቀባጣሙሃን፤ አይሁደ እኩዕናን አይሁድ አድረ ይታ ሼይጣን ምኒ እኮእሩ ሱዕመክ ክዝቢን ቤሳገ ደጋም። <verse eid="REV 2:9"/><verse number="10" style="v" sid="REV 2:10"/>ብርተ ዋሽት ኢልታሄ ኦርሸተ ዋጅቶት፤ እልቢሱ አመዕነቱክ ደጎተ ቶኑ በር ኦርሸተ ቶጎኖተ ክዕኔች መት-መቱክዕኔ ኡሱር ምኒ ኣግሰኖህዕኔ፤ አን ሽልማት ኣሴኖሀንገ ቄልቴነንተ ወጥ ሄኡ ኣሳንክዕኔቤቺሃ ሬቶኖተ ኢለ አመዕነንቴንተረ እኬ።<verse eid="REV 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 2:11"/>«መገን አያኑ መገን አመዕናኖ ጭምት ዱእ ምናተ የኖሃ መጨት ዮሲሁ ሞጮጩን!</para>
  <para style="p" vid="REV 2:11">«ድለ አዕዮሀኒሃ ለንክ ሬሆን ምርተአኖበአ የኖት» ይት ከተብ።<note caller="-" style="x"><char style="xo" closed="false">2፥11 </char><char style="xt" closed="false"><ref loc="REV 20:14">መና. 20፥14</ref>፤ <ref loc="REV 21:8">21፥8</ref>።</char></note><verse eid="REV 2:11"/></para>
  <para style="s1">ጴርጋሞን ከተም መገን አምዕናኖ ዱእ ምናተ</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12"/>«ጴርጋሞን መገን አመዕናኖ ዱእ ምነ መላይኬቺሃ</para>
  <para style="p" vid="REV 2:12">«ለሞንከ አዲን ሙረኖ እጳሸ ሲፈ አፎ መንቹ <verse eid="REV 2:12"/><verse number="13" style="v" sid="REV 2:13"/>አት ሼይጣን ኬዕምኝ ቦርጭመት ዮቤቾን ሄኡክ ደጋም፤ እሁን ቤሉ ሱዕመኤ ጠረኝስ አፎንት፤ ኢ አሌን ዮሄ አመዕነቱ ለገኦንትበአ፤ አመዕነሞ ኢ ምስክር እኮ አንቲጳሴ ሸይጣኑ ሄአኖቤቾን ክዕኔ ከተማን ሼመ ወክት ኢን አመዕኑ ሆሮ አጉርቶንትበአ። <verse eid="REV 2:13"/><verse number="14" style="v" sid="REV 2:14"/>ጠዉ እኮጎሬሁ ግባንኬ መት-መቱ ጠዉ ዮሄ፤ ሁኩንን ባለአሜ ትምርት አዎንታ መት-መቱ መኑ በላንከክዕኔ ዮኡ፤ ኩ ባለኣም እስራኤል ኡመት ሽርኬተ ክትሜመ ማለ እቲንለከ ዝነተ አኢን ቆዕልታገ ባለቄ ሸዦሃን።<note caller="-" style="x"><char style="xo" closed="false">2፥14 </char><char style="xt" closed="false"><ref loc="NUM 22:5">ዘኁ. 22፥5</ref>፤ <ref loc="NUM 7">7</ref>፤ <ref loc="NUM 31:16">31፥16</ref>፤ <ref loc="DEU 23:4">ዘዳ. 23፥4</ref>፤ <ref loc="NUM 25:1-3">ዘኁ. 25፥1-3</ref>።</char></note> <verse eid="REV 2:14"/><verse number="15" style="v" sid="REV 2:15"/>ህትን ክዕኔ በላን ኒቆላውያኖ ትምርት ኣእት አዎንታ መኑ ዮኡ። <verse eid="REV 2:15"/><verse number="16" style="v" sid="REV 2:16"/>ህካን እኮቤቺሃ ቶበት፤ ህካን እህባች ኪቤቹ ደዕል አሜች አፌኤ ሲፊን ኦለማንሰ። <verse eid="REV 2:16"/><verse number="17" style="v" sid="REV 2:17"/>መገን አያኑ መገን አመዕናኖ ጭምት ዱእ ምናተ የኖሀ መጨት ዮሲሁ ሞጮጩን፤ ድለ አዕዮሀኒሃ ማጤመ መና ኣሳንስ፤ ሃዕሮ ሱዕመ ከተበሞ ቀዉ ዋጁ ክኑ<note caller="+" style="f"><char style="fqa" closed="false">ቀዉ ዋጁ ክኑ፦ </char><char style="ft" closed="false">ግርክ ባዶን ብሬ ዘማን ፍርድ ምኒ ዳኛኑት ኦጆ መንቺሃ ዋጁ ክኑ ኣስቶስጎሬ መንቹስ ኦዳች ነጠ እሀኖ።</char></note>ኣሳንስ፤ ቶገኖ አን ቤሉ ካን አዪሁ ደገኖበአ የኖት ይት ከተብ።»<note caller="-" style="x"><char style="xo" closed="false">2፥17 </char><char style="xt" closed="false"><ref loc="EXO 16:14-15">ፉል. 16፥14-15</ref>፤ <ref loc="EXO 16:33-34">16፥33-34</ref>፤ <ref loc="JHN 6:48-50">ያህ. 6፥48-50</ref>፤ <ref loc="ISA 62:2">ኢሳ. 62፥2</ref>፤ <ref loc="ISA 65:15">65፥15</ref>።</char></note><verse eid="REV 2:17"/></para>
  <para style="s1">ትያጥሮን ከተም መገን አመዕናኖ ዱእ ምናተ</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18"/>«ትያጥሮን ከተም መገን አመዕናኖ ዱእ ምነ መላይኬቺ</para>
  <para style="p" vid="REV 2:18">«ጊረ ለበነ አጉዳ እልትለከ ጊራን ሽልሴን መክሴመ መዳበ አጉዳ ሎከቲ ዮ መገን ቤቲች <verse eid="REV 2:18"/><verse number="19" style="v" sid="REV 2:19"/>‹አን ሆጉክ፥ ኢተክ፥ አመዕነቱክ፥ ክድመክለከ አታዕሉክ› ደጋም፤ ህትን ወዕኔ ሆጎች ኤተርክ ሆጉት ቆካአ። <verse eid="REV 2:19"/><verse number="20" style="v" sid="REV 2:20"/>ጠዉ እኮጎሬ መቱ ግባንኬ ጠዉ ዮኢሁ ‹አን ራጋንቹተ› ይታ መንቹተ ኤልዛቤል ኢ ካዲመት ዝነተ አቶተለከ ሽርኬተ ክትሜመ ክትም ማለ እቶተ ሉሲስ ተማርስተን ሰዕምት አጉርቶንት።<note caller="-" style="x"><char style="xo" closed="false">2፥20 </char><char style="xt" closed="false"><ref loc="1KI 16:31">1 ነገ. 16፥31</ref>፤ <ref loc="2KI 9:22">2 ነገ. 9፥22</ref>፡<ref loc="2KI 9:30">30</ref>።</char></note> <verse eid="REV 2:20"/><verse number="21" style="v" sid="REV 2:21"/>አን ዝነተ አኡሴ ቶበት ፈንቀልታገ ወክት ኣስዮንሴ እቅ፤ እኮጎሬ ዝነተ አጉሩ ግቦኡ። <verse eid="REV 2:21"/><verse number="22" style="v" sid="REV 2:22"/>ህካን እኮቤቺሃ አን እሴተ ኦርሸ መዕነ አሌን ኡጃንሴ፤ ህትን እሴንን ዝነተ አታ መኑ እሴ አታ ሂለ ሆጎች ቶበት ፈንቀሉ ሆጋረ አበ ኦርጨቀንታገ አኣም። <verse eid="REV 2:22"/><verse number="23" style="v" sid="REV 2:23"/>ኦሱሴ ሬሆን ቀጠኣም፤<note caller="+" style="f"><char style="fqa" closed="false">ኦሱሴ ሬሆን ቀጠኣም፦ </char><char style="ft" closed="false">የኖሁ ልግቡ መኑ ህት ኦሱት እሴ እልቶእረበአ፤ እሴ ትምርት ኣእት እሴ እካገ እከን ሄኣእረ ይታአ።</char></note> ህካን እኮቤቺሃ መገን አመዕናኖ ጭምት ዱእ ምነት ጉዕሙንኩ መን ሰውትለከ ሄዕላቸስ መረመር ደጋሚሁ ኤሳሃ እሁኤ ደጋአ፤ አን መት-መቲሃክዕኔ ሆጎክዕኔ ጌሰ ኣሳም።<verse eid="REV 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 2:24"/>«ትያጥሮናን ዮንታሁለከ ከ ሂለ ትምርት ቶጌንበሀኑኡተ ጉዕሚንከ ህትን መት-መቱ ‹ሼይጣን ጥዕላሸ ምስጥር› የኖሃ አዎንቶኑዕናን ፈቄንተ ክዕኔሃ ዎልት እጅነተ እጅሲሳንክዕኔበአ። <verse eid="REV 2:24"/><verse number="25" style="v" sid="REV 2:25"/>እኮጎሬ አን አሜቶተ ኢለ ዮህዕኔሃ ጠረኝሴን አፌ። <verse eid="REV 2:25"/><verse number="26" style="v" sid="REV 2:26"/>መጨረሸ ኢለ ድለ አዕዮሀኒሃ ሆጎንተእ ጠረኘኖሀኒሃ ኡመት ገሸኖ ሹምነቱ ኣሳንስ። <verse eid="REV 2:26"/><verse number="27" style="v" sid="REV 2:27"/>‹ብረት በርቲን ጠቀኖሰ፤ ትብ ኦዳገ ቀጠቀጭ ቀመ አአኖሰ› ኩ ሹምነቱ አን አኒችኤ ቶጎምሀንጋት። <verse eid="REV 2:27"/><verse number="28" style="v" sid="REV 2:28"/>አን እሲሃ ሶዝ ቤዜተ ኣሳንስ።<verse eid="REV 2:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="REV 2:29"/>«መገን አያኑ መገን አመዕናኖ ጭምት ዱእ ምናተ የኖሃ መጨት ዮሲሁ ሞጮጩን የኖት» ይት ከተብ።<verse eid="REV 2:29"/></para>
  <chapter eid="REV 2"/>
  <chapter number="3" style="c" sid="REV 3"/>
  <para style="s1">ሰርዴስ መገን አመዕናኖ ዱእ ምናተ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1"/>«ሴርዴስ መገን አመዕናኖ ዱእ ምነ መላይኬቺሃ</para>
  <para style="p" vid="REV 3:1">«ለመለ መገን አያነለከ ለመል ቤዜት አፎሀኒች ጠወአሞዕሃን፤ ሆጉክ ደጋም፤ ጠለዕል ሱዕሙ ዮሄ ቤሉ አት ሬቶንት። <verse eid="REV 3:1"/><verse number="2" style="v" sid="REV 3:2"/>በቅይ፤ ሬሆተ ሆንጠኮሃለከ ፈቆሄ ቀዉ ወልቀክ ጠረኝስ፤ መገን ብሬን ሆጉክ ዊመ እካን ደጎምበአ። <verse eid="REV 3:2"/><verse number="3" style="v" sid="REV 3:3"/>ህንዴ መ ተማርሴመሄጎር መ ሞጮጭቶንትጎር ሰውይ፤ አገርስ፤ ቶበት፤ ጠዉ እኮጎሬ በቅ ይቱዕነ ድንገቴን ሞጋንችገ አሜታም፤ መ ወክት ኪቤቹ አሜታምገ ደጋንትበአ።<note caller="-" style="x"><char style="xo" closed="false">3፥3 </char><char style="xt" closed="false"><ref loc="MAT 24:43-44">ማቶ. 24፥43-44</ref>፤ <ref loc="LUK 12:39-40">ሉቃ. 12፥39-40</ref>፤ <ref loc="REV 16:15">መና. 16፥15</ref>።</char></note> <verse eid="REV 3:3"/><verse number="4" style="v" sid="REV 3:4"/>ጠዉ እኮጎሬ ኦድኑሰ ንጃስሶበእ ቀዉ መኑ ኪን ሜጡበ ሰርዴስ ከተማን ዮኡ፤ እሰ ዋጁተ ኦድኑተ ኦደኡ<note caller="+" style="f"><char style="fqa" closed="false">ዋጁተ ኦድኑተ ኦደኡ፦ </char><char style="ft" closed="false">የኖሁ መኑ ኦደአኖ ነጠ ኦድኑተ እሁዕነ ኦርሸተ ቄሎ መኒሃ መገኑ ኣሰኖ መሲህ ኢሲሃ ወገሬት።</char></note> ሀስሰኖሳሃ እኮቤቺሃ ዋጁተ ኦድኑተ ኦደእ ኢን ሜጡበ መርታአ። <verse eid="REV 3:4"/><verse number="5" style="v" sid="REV 3:5"/>ድለ አዕዮሀኒሃ እሰገን ዋጁተ ኦድኑተ ኦድሴኖ፤ አን ሱዕመስ አንኤለከ መላይከ ብሬን ሙንደዕይ ኩላም ቤሉ ሄእ መጻፊች ሱዕመስ ቤሳምበአ።<note caller="-" style="x"><char style="xo" closed="false">3፥5 </char><char style="xt" closed="false"><ref loc="EXO 32:32-33">ፉል. 32፥32-33</ref>፤ <ref loc="PSA 69:28">መዝ. 69፥28</ref>፤ <ref loc="REV 20:12">መና. 20፥12</ref>፤ <ref loc="MAT 10:32">ማቶ. 10፥32</ref>፤ <ref loc="LUK 12:8">ሉቃ. 12፥8</ref>።</char></note><verse eid="REV 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 3:6"/>«መገን አያኑ መገን አመዕናኖ ጭምት ዱእ ምኒሃ የኖሃ መጨት ዮሲሁ ሞጮጩን» የኖት ይት ከተብ።<verse eid="REV 3:6"/></para>
  <para style="s1">ፊሌዴልፍ መገን አመዕናኖ ዱእ ምናተ</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7"/>ፊሌዴልፍ መገን አመዕናኖ ዱእ ምነ መላይኬቺሃ</para>
  <para style="p" vid="REV 3:7">«ጠሊለለከ ሀንቅ እኮሀኒቺት፤ ህትን እሲንከ ደዉዴ ቁልፉ ዮሲ እኮቤቺሃ እስ ፈኞ ኡሩተ አዪሁ ጡፈኖበአ፤ ህትን እስ ጡፎ ኡሩተ አዪሁ ፈነኖበአ።<note caller="-" style="x"><char style="xo" closed="false">3፥7 </char><char style="xt" closed="false"><ref loc="ISA 22:22">ኢሳ. 22፥22</ref>፤ <ref loc="JOB 12:14">አዩ. 12፥14</ref>።</char></note> <verse eid="REV 3:7"/><verse number="8" style="v" sid="REV 3:8"/>ሆጉክ ደጎም፤ አዪሁ ጡፎተ አታለኖበእ ኡሩተ ብሬክ አዕዮም፤ ዎልቀክ ቀዉ እሁስ ደጎም፤ እሁን ቤሉ ላጋኤ አገርቶንት፤ ሱዕመኤ ካዶንትበአ።<note caller="-" style="x"><char style="xo" closed="false">3፥9 </char><char style="xt" closed="false"><ref loc="ISA 49:23">ኢሳ. 49፥23</ref>፤ <ref loc="ISA 60:14">60፥14</ref>፤ <ref loc="ISA 43:4">43፥4</ref>።</char></note> <verse eid="REV 3:8"/><verse number="9" style="v" sid="REV 3:9"/>አይሁደ እኩዕናን አይሁድራን ይታእረ ህከ ሼይጣን ምኒ እኮ ክዝበኛኑት አሜት ሎከክ አሌን ኡብ ሰገዳሄገ አኣም፤ አን ኢቱኤ ደጋገ አኣም። <verse eid="REV 3:9"/><verse number="10" style="v" sid="REV 3:10"/>ፈረህ ይ አዘዦንኬ ላጋኤ አገርቶንትቤቺሃ ኣዱንያ አሌን ሄአኖሃ ጉዕመንከ ፌተንቶተ አሜታ ኦርሸ ወክቲች አገራንኬ። <verse eid="REV 3:10"/><verse number="11" style="v" sid="REV 3:11"/>አን ደዕል አሜታም፤ ህትን አዪሁ ኬሳሃ ዬመ ሽልማት አአኖሄበእገ ዮሄሃ ጠረኝስ አጵ። <verse eid="REV 3:11"/><verse number="12" style="v" sid="REV 3:12"/>ድለ አዕዮሀኒሃ ዱእ ምኒ ቱቃ አኣም፤ እስን ህከኒች ሆሮ ፉለኖበአ፤ መገንኔ ሱዕመለከ መገን ከተም ሱዕመ እስ አሌን ከተባም፤ ሁኩ ከተሙንኩ ሰሜች መገንኔ አዲች አሜታ ሃዕሮሃ ዬሩሳሌመ፤ ህትን ኢ ገይኤ ሃዕሮ ሱዕመ እስ አሌን ከተባም።<note caller="-" style="x"><char style="xo" closed="false">3፥12 </char><char style="xt" closed="false"><ref loc="REV 21:2">መና. 21፥2</ref>፤ <ref loc="ISA 62:2">ኢሳ. 62፥2</ref>፤ <ref loc="ISA 65:15">65፥15</ref>።</char></note><verse eid="REV 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 3:13"/>ህትን «መገን አያኑ መገን አመዕናኖ ጭምት ዱእ ምናተ የኖሃ መጨት ዮሲሁ ሞጮጩን የኖት» ይት ከተብ።<verse eid="REV 3:13"/></para>
  <para style="s1">ሎዶቅይ መገን አመዕናኖ ዱእ ምናተ</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14"/>ሎዶቅይ መገን አመዕናኖ ዱእ ምኒ መላይኬቺሃ</para>
  <para style="p" vid="REV 3:14">«እሁን እኮሃ፥ አመዕነሞለከ ሀንቅ ምስክር እኮሀኒች ህትን መገን ክልቀቲሃ ጉዕሚንከ ቡቁተ እኮሁ<note caller="-" style="x"><char style="xo" closed="false">3፥14 </char><char style="xt" closed="false"><ref loc="JDG 8:22">መሳ. 8፥22</ref>።</char></note> <verse eid="REV 3:14"/><verse number="15" style="v" sid="REV 3:15"/>እስን አን ሆጉክ ደጋም፤ አት ቅዞንትያበአ ህከረንገ እቦንትያበአ፤ ህካን እኮቤቺሃ ቂዘ ህከረንገ ኢባቡ እኮንት እቃ ጡመ እቅ። <verse eid="REV 3:15"/><verse number="16" style="v" sid="REV 3:16"/>ቂዘ ህከረንገ ኢባቡ እኩዕነ ልብጭ ይቶንትቤቺሃ አፌችኤ ፉሽ ቱ ዮሄታት። <verse eid="REV 3:16"/><verse number="17" style="v" sid="REV 3:17"/>አት ‹ልግቡ ብሩ ዮኤ፤ ቀባጣሙሃን፤ ሆፈዕዮኤሁ መቱርቹሁ ዮኤበአ› ይታንቲት፤ ጠዉ እኮጎሬ ኦርሻሙ፥ ላፈ፥ ቡጥቹ፥ ቆቀለከ ከሉ እኮንትገ ደቅቶንትበአ። <verse eid="REV 3:17"/><verse number="18" style="v" sid="REV 3:18"/>አት ቀባጣሙ እኮተ ጊራን ሺል መኬ ዎርቀ ኢች ህዕርቶተ፥ ከልመክ ለልትበገ ድቦተ ዋጁ ኦድኑተ ህዕርቶተ ኦደኦተለከ ለኦተ እሌንከክ ቡዕርታንት እሌ ዘቡሃ<note caller="+" style="f"><char style="ft" closed="false">«እሌሀክ ደነ ቀጩ» የመም ፈሰረሞሁ ሀላብሳን «እሌ ዘቡ» የመሞኡ፤ መሰንትስ ግሪክ አፎን «እሌ ዘቡ» የኖሃ ቤሉ ደነ ቀሲሃ ቡዕሬኖሃበአ።</char></note> ህዕርት ቡዕርታንትገ ሸዛንኬ። <verse eid="REV 3:18"/><verse number="19" style="v" sid="REV 3:19"/>አን ኢታም መነ ጉዕመንከ ኡሙዕራም፤ ቀጠኣንሰ፤ ህካን እኮቤቺሃ ሰጭትኬእ ቶበት።<note caller="-" style="x"><char style="xo" closed="false">3፥19 </char><char style="xt" closed="false"><ref loc="PRO 3:12">ምሳ. 3፥12</ref>፤ <ref loc="HEB 12:6">እብ. 12፥6</ref>።</char></note> <verse eid="REV 3:19"/><verse number="20" style="v" sid="REV 3:20"/>አን ኡሮን ኡር ጡፈ ቆጫም፤ አዪሁ ላገእ ሞጮጭ ፈኞጎሬ እስቤቹ ኣግ እሲንን ሜጡበ እታም፤ ህትን እስን ኢን ሜጡበ እተኖ። <verse eid="REV 3:20"/><verse number="21" style="v" sid="REV 3:21"/>አን ድለ አዕዮሀኒሃ አኒንከኤ ጄነትስ ቦርጭማን አፉዕሌምሀንገን ህትን ቄሎሁ ጄነቴንኬኤ ቦርጭማን ኢን ሜጡበ አፉዕለኖገ አኣም።<verse eid="REV 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 3:22"/>«መገን አያኑ መገን አመዕናኖ ጭምት ዱእ ምናተ የኖሃ መጨት ዮሲሁ ሞጮጩን የኖት» ይት ከተብ።<verse eid="REV 3:22"/></para>
  <chapter eid="REV 3"/>
  <chapter number="4" style="c" sid="REV 4"/>
  <para style="s1">ያህይ መገኑ ለዕዮገ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1"/>ህከኒች ኤተሮን ለዕዮንስ፤ ሰማን ፈንተኦ ኡሩተ ሄኦ እቅ፤ ወዕና ሞጮጬም ጡሩምብገ ዮ ላገት «አም ከበ ፉል፤ ከኒች ኤተሪሃ እሀኖ ጠወ ለሊሳንኬ» ዬእ።<verse eid="REV 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 4:2"/>ወክትንከስ መገን አያኒን እክ ሰሜ ኬዕምኝ ቦርጭመ አሌን መቱ መንቹ አፉዕሌኢሃ ለዕዮም። <verse eid="REV 4:2"/><verse number="3" style="v" sid="REV 4:3"/>ኬዕምኝ ቦርጭማን አፉዕሌኢሁ ደኑስ ኢያሰጵደለከ ሰርዲኖነ ዬኖ ጤአተ እኮ ክኑ አጉደኖ፤ ኬዕምኝ ቦርጭመተ ዘህ መርግድ ጤአተ እኮ ክኑ አጉደኖ ሰመንዲቁት ሄኦ እቅ።<note caller="-" style="x"><char style="xo" closed="false">4፥2-3 </char><char style="xt" closed="false"><ref loc="EZK 1:26-28">ሕዝ. 1፥26-28</ref>፤ <ref loc="EZK 10:1">10፥1</ref>።</char></note> <verse eid="REV 4:3"/><verse number="4" style="v" sid="REV 4:4"/>ህትን ኬዕምኝ ቦርጭመ ገበላን ዘህ ለሞይዱምኔ ሾልት ኬዕምኝ ቦርጭመት ሄኦ እቅ፤ ህትን ኬዕምኝ ቦርጭማን ዋጁ ኦድኑተ ኦደእ ቡዕላንከሰ ዎርቅ አክሊለ ጣጦ ለሞይዱምኔ ሾልት ባልቀት አፉዕልቶ እቅ። <verse eid="REV 4:4"/><verse number="5" style="v" sid="REV 4:5"/>ኬዕምኝስ ቦርጭማች በለቁለከ ላገት ጉገኛት ፉልታ እቅ፤ ጄነትስ ቦርጭመ ብሬን ለመሉ ኩራዙ ለሊሰኖት እቅ፤ ሁኩ ለመሉንኩ ኩራዙ መገንየ አያነ እቅ።<note caller="-" style="x"><char style="xo" closed="false">4፥5 </char><char style="xt" closed="false"><ref loc="EXO 19:16">ፉል. 19፥16</ref>፤ <ref loc="REV 8:5">መና. 8፥5</ref>፤ <ref loc="REV 11:19">11፥19</ref>፤ <ref loc="REV 16:18">16፥18</ref>፤ <ref loc="EZK 1:13">ሕዝ. 1፥13</ref>፤ <ref loc="REV 1:4">መና. 1፥4</ref>፤ <ref loc="ZEC 4:2">ዘካ. 4፥2</ref>።</char></note> <verse eid="REV 4:5"/><verse number="6" style="v" sid="REV 4:6"/>ህትን ጄነትስ ቦርጭመ ብሬን ለአቃንቹ አጉደኖ ባሩ ሄዕዮ እቅ፤ ለአቃንቹንኩ ነጠ እኮእሃ እቅ፤ ጄነትስ ቦርጭመተ ዘህ ብሬ አዲንለከ ኤተር አዲን ልግቡ እልት ዮ ሾሉ ፎላሙ ክልቀቱ ሄዕዮ እቅ። <verse eid="REV 4:6"/><verse number="7" style="v" sid="REV 4:7"/>እሰን ዎዕኔ ክልቀቱ ዞቦሃ አጉደኖ እቅ፤ ለንክሁ ቦረ አጉደኖሃ እቅ፤ ሰቂሁ መን ሚንተ አጉዳ ሚንት ሄኦስ እቅ፤ ህትን ሾልቂሁ ብር የኖ የብሮ አጉደኖ እቅ።<note caller="-" style="x"><char style="xo" closed="false">4፥7 </char><char style="xt" closed="false"><ref loc="EZK 1:22">ሕዝ. 1፥22</ref>፤ <ref loc="EZK 5:10">5፥10</ref>፤ <ref loc="EZK 10:14">10፥14</ref>።</char></note> <verse eid="REV 4:7"/><verse number="8" style="v" sid="REV 4:8"/>ህከን ሾሎንከ ፎላሞ ክልቀቲሃ መት-መትሀሰ ሌህት ጎንት ዮሰ እቅ፤ ህከን ጎኔን ኣዝ አዲንለከ ገበላን ዘህ ልግቡ እልት ዮሰረ እቅ፤ እሰን</para>
  <para style="q1" vid="REV 4:8">«ጠሊሉ! ጠሊሉ! ጠሊሉ!</para>
  <para style="q1" vid="REV 4:8">ጉዕመንከ አታልታንት ቀርቾ መገኖ!</para>
  <para style="q1" vid="REV 4:8">ዮኢሁ፥ ሄዕዮሁለከ አሜተኖሁ»</para>
  <para style="m" vid="REV 4:8">ይተን ሀንከዕርተለከ በራሃ ኡርሳበአ እቅ።<note caller="-" style="x"><char style="xo" closed="false">4፥8 </char><char style="xt" closed="false"><ref loc="EZK 1:8">ሕዝ. 1፥8</ref>፤ <ref loc="EZK 10:12">10፥12</ref>፤ <ref loc="ISA 6:2-3">ኢሳ. 6፥2-3</ref>።</char></note><verse eid="REV 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 4:9"/>ክልቀቱንኩ ኬዕምኝ ቦርጭማን አፉዕሌሀኒሃ ዘላለሚሃ ሄአኖሀኒሃ ሎርመት፥ ኬዕምኙለከ ሹኩር ሆንጠህሳ ወክት <verse eid="REV 4:9"/><verse number="10" style="v" sid="REV 4:10"/>ለሞዱምኔ ሾሉንኩ ባልቀት ዘላለሚሃ ሄአኖ ኬዕምኝ ቦርጭመ አሌን አፉዕሌ አን ብሬን ምኔንከሰ ኡብ ሰገዳአ፤ ህትን ቡዕላንከሰ ዮ አክሊለ ፉሽት ኬዕምኝ ቦርጭመ ብሬን አፉሽት<verse eid="REV 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11"/>«ኒ ቀርቾ መገኖ!</para>
  <para style="q2" vid="REV 4:11">ጉዕመርቹንከ ከለቆንትቤቺሃ፥</para>
  <para style="q1" vid="REV 4:11">ጉዕሙርቹንኩ ከለቀሞሁለከ</para>
  <para style="q2" vid="REV 4:11">ፎል ደእኖሚሁ ኪ አምሬን እኮቤቺሃ</para>
  <para style="q2" vid="REV 4:11">ሎርመት፥ ኬዕምኙለከ ዎልቀት ኬሳሃ ሀስሳሄ» ይታ እቅ።<verse eid="REV 4:11"/></para>
  <chapter eid="REV 4"/>
  <chapter number="5" style="c" sid="REV 5"/>
  <para style="s1">መጻፈለከ ሆልችተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1"/>ጄነት ቦርጭማን አፉዕሌሀን መኬ አንጋን ኣዝ አዲንለከ አብል አዲን ከተቤመ ለመለ ማተቢን አሸጌመ ጣጠሞ መጻፈ ለዕዮም።<note caller="-" style="x"><char style="xo" closed="false">5፥1 </char><char style="xt" closed="false"><ref loc="EZK 2:9-10">ሕዝ. 2፥9-10</ref>፤ <ref loc="ISA 29:11">ኢሳ. 29፥11</ref>።</char></note> <verse eid="REV 5:1"/><verse number="2" style="v" sid="REV 5:2"/>መቱ ጠረኙ መላይኬቹ ሎረ ላጋን «ከ ማተበ ፊሎተለከ ጣጠሞ መጻፈ ፈኖተ ሀስሰኖሲሁ አዬት?» የን አዋጀኖሃ ለዕዮም። <figure style="fig" alt="Scroll" file="HK00150B.tif" size="span" ref="5፥2">ጣጠሞ መጻፋ</figure> <verse eid="REV 5:2"/><verse number="3" style="v" sid="REV 5:3"/>ጠዉ እኮጎሬ ሰማን፥ ኡላንለከ ኡላች ኣዚን ጣጠሞ መጻፈ ፈኖተ ህከረንገ ኣዝስ ለኦተ አታሎሁ አዪሁ ደገሞበአ። <verse eid="REV 5:3"/><verse number="4" style="v" sid="REV 5:4"/>አንን ጣጠሞ መጻፈ ፈኖተ ህከረንገ ኣዝስ ለኦተ አታለኖሁ ደገሙሆጎቤቺሃ አበ ኦዕዮም። <verse eid="REV 5:4"/><verse number="5" style="v" sid="REV 5:5"/>ህከ ወክት ባልቃች መቱ «ኦኦት! ይሁድ ዘሬች ደዉዴ ደቦች እኮሁ ድለ አዕዮቤቺሃ ጣጠሞ መጻፈለከ ለመለንከ ማተበ ፈኖተ አታለኖ» ዬኤ።<note caller="-" style="x"><char style="xo" closed="false">5፥5 </char><char style="xt" closed="false"><ref loc="GEN 49:9">ክል. 49፥9</ref>፤ <ref loc="ISA 11:1">ኢሳ. 11፥1</ref>፤ <ref loc="ISA 10">10</ref>።</char></note><verse eid="REV 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6"/>ህከኒች ኤተሮን ኬዕምኝ ቦርጭመ በላን ሾሎንከ ክልቀትለከ ለሞድምኔ ሾሎንከ ባልቀ በላን ጎረጠሞሃ አጉደኖ ሆልቹ ኡሬኢሃ ለዕዮም፤ ሁኩ ሆልቹ ለመሉ ቡዱለከ ለመልት እልት ሄኦስ እቅ፤ እሰን ኣዱንያ አል ጉዕመንከ ሶሃንቶ መገንየ አያነ እቅ።<note caller="-" style="x"><char style="xo" closed="false">5፥6 </char><char style="xt" closed="false"><ref loc="ISA 53:7">ኢሳ. 53፥7</ref>፤ <ref loc="ZEC 4:10">ዘካ. 4፥10</ref>።</char></note> <verse eid="REV 5:6"/><verse number="7" style="v" sid="REV 5:7"/>እስን አሜች ኬዕምኝ ቦርጭማን አፉዕሌሀኒች መኬስ አንጋች ጣጠሞ መጻፈ ኣኤእ። <verse eid="REV 5:7"/><verse number="8" style="v" sid="REV 5:8"/>ጣጠሞ መጻፈ ኣኤ ወክት ሾሉንኩ ክልቀቱለከ ለሞድምኔ ሾሉንኩ ባልቀት ሆልች ብሬን ሚኔንከሰ ጎምብሰንቶኡ፤ ጉዕሙንኩሰ ክራረ አፎ እቅ፤ ህትን ጠሊላኖ ዱአ እኮ ህጣነ ዊሞ ወርቅ ኦደተ አፎ እቅ፤<note caller="-" style="x"><char style="xo" closed="false">5፥8 </char><char style="xt" closed="false"><ref loc="PSA 141:2">መዝ. 141፥2</ref>።</char></note> <verse eid="REV 5:8"/><verse number="9" style="v" sid="REV 5:9"/>እሰን ሃዕሮ መዝሙረ</para>
  <para style="q1" vid="REV 5:9">«ቄጊንከክ ደቦች፥ አደደ አፎ ጠወኣ መኒች</para>
  <para style="q2" vid="REV 5:9">ቦክችለከ ኡመቲች</para>
  <para style="q1" vid="REV 5:9">መነ መገኒሃ ዎዚሃ</para>
  <para style="q1" vid="REV 5:9">አት ጎረጠንቶንትቤቺሃ</para>
  <para style="q2" vid="REV 5:9">ጣጠሞ መጻፈ ኣኢሃለከ</para>
  <para style="q2" vid="REV 5:9">ማተበ ፈኒሃ በቀኦንቲሃ እኮንት፤<note caller="-" style="x"><char style="xo" closed="false">5፥9 </char><char style="xt" closed="false"><ref loc="PSA 33:3">መዝ. 33፥3</ref>፤ <ref loc="PSA 98:1">98፥1</ref>፤ <ref loc="ISA 42:10">ኢሳ. 42፥10</ref>።</char></note><verse eid="REV 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10"/>መገኒሃኔ ቂሰተለከ ዎመ</para>
  <para style="q2" vid="REV 5:10">እካገ አቶንትሰ፤</para>
  <para style="q2" vid="REV 5:10">ኡለ አሌን ዎመ እካአ» ይተን ዘመርቶኡ።<note caller="-" style="x"><char style="xo" closed="false">5፥10 </char><char style="xt" closed="false"><ref loc="EXO 19:6">ፉል. 19፥6</ref>፤ <ref loc="REV 1:6">መና. 1፥6</ref>።</char></note><verse eid="REV 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11"/>ህከ ቤቹ ለዕዮም ወክት ኬዕምኝ ቦርጭመተ፥ ክልቀትለከ ለሞዱምኔ ሾሉንከ ባልቀተ ዘህ ልግቤ መላይከ ላገተ ሞጮጬም፤ በትኝሰን ዎለኤን አታሌንበ ጌሰ እቅ።<note caller="-" style="x"><char style="xo" closed="false">5፥11 </char><char style="xt" closed="false"><ref loc="DAN 7:10">ዳን. 7፥10</ref>።</char></note> <verse eid="REV 5:11"/><verse number="12" style="v" sid="REV 5:12"/>ሎረ ላጋኒን</para>
  <para style="q1" vid="REV 5:12">«ጎረጠሞ ሆልቺሃ ወልቀት፥ ቀባጡት</para>
  <para style="q1" vid="REV 5:12">ሀይመተ፥ ጠረኝመተ፥ ሎርመተ፥ ኬዕምኝለከ</para>
  <para style="q1" vid="REV 5:12">ገለት ቶጊሃ ሀስሰኖስ» ይቶኡ።<verse eid="REV 5:12"/></para>
  <para style="m">
    <verse number="13" style="v" sid="REV 5:13"/>ህትን ቴሱ ሰማንለከ ኡላን፥ ኡለች ኣዝ አዲንለከ ባር ኣዚን ጉዕመ ቤቾንን ዮ ክልቀቱ ጉዕሙንኩ</para>
  <para style="q1" vid="REV 5:13">«ኬዕምኝ ቦርጭማን አፉዕሌሀኒሃለከ ሆልቺሃ</para>
  <para style="q1" vid="REV 5:13">ገለቱ፥ ሎርመት፥ ኬዕምኙለከ ዎልቀት</para>
  <para style="q1" vid="REV 5:13">ዘላለሚሃ እሲሃ እሁን» ይተን ሞጮጬም።<verse eid="REV 5:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="REV 5:14"/>ሾሉንኩ ክልቀቱ «ኣሚዕን!» ይቶኡ፤ ህትን ለሞድምኔ ሾልት ባልቀት ሚኔንከሰ ጎምብሰንት ሰገዶኡ።<verse eid="REV 5:14"/></para>
  <chapter eid="REV 5"/>
  <chapter number="6" style="c" sid="REV 6"/>
  <para style="s1">ለመሉንኩ መጻፉ ፈንተኡስ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1"/>ህከኒች ኤተሮን ሆልቹ ለመለንከ ማተቢች ዎኔሲሃ ፈነን ለዕዮም፤ ህትን ሾሎንከ ክልቀቲች መቱስ ጉገኛገ ዮ ላጋን «አም!» የን ሞጮጬም። <verse eid="REV 6:1"/><verse number="2" style="v" sid="REV 6:2"/>ህትን ዋጁ ፋሹ ለዕዮም፤ ፋሾንከስን ቆጶሁ በገዙ አፎ እቅ፤ አክሊሉንኩ ኣሰሞስ፤ እስን ቄላንቹ እክ ድሊች ድለ አአን መሮ።<note caller="-" style="x"><char style="xo" closed="false">6፥2 </char><char style="xt" closed="false"><ref loc="ZEC 1:8">ዘካ. 1፥8</ref>፤ <ref loc="ZEC 6:3">6፥3</ref>፤ <ref loc="ZEC 6">6</ref>።</char></note><verse eid="REV 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3"/>ህከኒች ኤተሮን ሆልቹ ለንክ ማተበ ፊል ፈኞ ወክት ለንክስ ክልቀቱ «አም!» የን ሞጮጬም። <verse eid="REV 6:3"/><verse number="4" style="v" sid="REV 6:4"/>ህትን ዎሉ ዳሙ ፋሹ ፉሎ፤ ህከን ፋሾን ቆጶሀኒሃ ኣዱንያ አሊች ወገሬት ከማን መኑ ገገዪንከስ ሸቀንታገ አታ ዎልቀተለከ ሎሩ ሲፉንኩ ኣሰሞስ።<note caller="-" style="x"><char style="xo" closed="false">6፥4 </char><char style="xt" closed="false"><ref loc="ZEC 1:8">ዘካ. 1፥8</ref>፤ <ref loc="ZEC 6:2">6፥2</ref>።</char></note><verse eid="REV 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5"/>ህከኒች ኤተሮን ሆልቹ ሰቅ ማተበ ፊል ፈኞ ወክት ሰቅስ ክልቀቱ «አም!» የን ሞጮጬም፤ ህከኔን ጊለ ፋሾን ቆጶ መንቹ አንጋንከስ ሜዛነ አፎሃ ለዕዮም።<note caller="-" style="x"><char style="xo" closed="false">6፥5 </char><char style="xt" closed="false"><ref loc="ZEC 6:2">ዘካ. 6፥2</ref>፤ <ref loc="ZEC 6">6</ref>።</char></note> <verse eid="REV 6:5"/><verse number="6" style="v" sid="REV 6:6"/>ሾሎንከ ክልቀት በሊች አሜታኢሃ አጉዳ ላገተ ሞጮጬም፤ ህት ላገንት «ኪሎ ደሬ አለሱ መቶ በሬ ደሞዘ፤ መት ኪሉተ ደሬን እሀኖ ሶአ መቶ በሬ ደሞዘ እሁን፤ ጠዉ እኮጎሬ ወይነለከ ዘይተ ቤሶት!» የን ሞጮጬም።<verse eid="REV 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7"/>ህከኒች ኤተሮን ሆልቹ ሾልቅ ማተበ ፊል ፈኞ ወክት ሾልቅ ክልቀት ላገተ «አም!» የን ሞጮጬም። <verse eid="REV 6:7"/><verse number="8" style="v" sid="REV 6:8"/>ህከ ወክት ሺሬ ፋሹ ለዕዮም፤ እስንን ቆጶሀን ሱዕሙስ ሬሁተ የመመኖ እቅ፤ አዛቡ አዎነኖሲት እቅ፤ ሬሁትለከ አዛቡ እሰን ኣዱንያ አል መኒች ሾልቅ አፎሃ ኦሊን፥ ጎሪን፥ ልግቤ ጥዘናንለከ አብል ቡሳዊን ሽቶተ ሹምነቱ ኣሰሞሰ።<note caller="-" style="x"><char style="xo" closed="false">6፥8 </char><char style="xt" closed="false"><ref loc="EZK 14:21">ሕዝ. 14፥21</ref>።</char></note><verse eid="REV 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9"/>ሆልቹ ኦንትቅ ማተበ ፊል ፈኞ ወክት መገን ላገተለከ ኣቶ ምስክርተኔሃ ሼመ መን ነብሳሃ መገኒሃ ክትም ሆንጠህሴኖ ጠረጴዚች ዎሮ አዲን ለዕዮም። <verse eid="REV 6:9"/><verse number="10" style="v" sid="REV 6:10"/>እሰን ሎረ ላጋን «ጠሊለለከ ሀንቅ ጉዕመንከ አታልታንቲ መገኖ! ኡላን ዮ መን አሌን ፈረዳንትበእሁለከ ቄግኔተኔንከ ገዱተ ፉልትባሁ መ በር ኢላት!» ይተን ያርቶኡ። <verse eid="REV 6:10"/><verse number="11" style="v" sid="REV 6:11"/>መት-መቲሃሰ ዋጁ ቀምብሰ ኣሴመሰ፤ እሰገን ሬታእሩ፥ እሰገን ካዲመተ እኮ ኢተሰለከ አመሰ ኦሶ ዎሊንሹ ዊሞተ ኢለ ቀዉ ጌሰ ፎሎጭት ዱንክታገ ኩለሞሰ።<verse eid="REV 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12"/>ህከኒች ኤተሮን ሆልቹ ሌህቅ ማተበ ፊል ፈኛን ለዕዮም ወክት ኡለት አበ ሌንቄቅቶኡ፤ ህትን አሪቹንት ጥጅ ኦድኖገ ትልመ ገምበለ እኮኡ፤ አገንቹንኩ ቄግገ ጉዕሙ ቤቹስ ቢሸዕዮ።<note caller="-" style="x"><char style="xo" closed="false">6፥2 </char><char style="xt" closed="false"><ref loc="REV 11:13">መና. 11፥13</ref>፤ <ref loc="REV 16:18">16፥18</ref>፤ <ref loc="ISA 13:10">ኢሳ. 13፥10</ref>፤ <ref loc="JOL 2:10">ኢዩ. 2፥10</ref>፤ 31፤ <ref loc="JOL 3:15">3፥15</ref>፤ <ref loc="MAT 24:29">ማቶ. 24፥29</ref>፤ <ref loc="MRK 13:24-25">ማር. 13፥24-25</ref>፤ <ref loc="LUK 21:25">ሉቃ. 21፥25</ref>።</char></note> <verse eid="REV 6:12"/><verse number="13" style="v" sid="REV 6:13"/>ከርሜን ጠረኙ ቦብሩ ኦድ ሀቁቹተ ሌንቄቅሻን ላልቹ ግግለኖሀንገ ሰሜ ቤዜንት ኡለ አሌን ግግልቶኡ።<note caller="-" style="x"><char style="xo" closed="false">6፥13-14 </char><char style="xt" closed="false"><ref loc="ISA 34:4">ኢሳ. 34፥4</ref>።</char></note> <verse eid="REV 6:13"/><verse number="14" style="v" sid="REV 6:14"/>ሰሞንኩ ጣጠሞ መጻፍገ ጣጠም በዕዮ፤ ህትን ቆተትለከ ዊ በላን ዮ ኡለት ጉዕሙንኩ ቤቺችሰ ኬእ በኦኡ።<note caller="-" style="x"><char style="xo" closed="false">6፥14 </char><char style="xt" closed="false"><ref loc="REV 16:20">መና. 16፥20</ref>።</char></note> <verse eid="REV 6:14"/><verse number="15" style="v" sid="REV 6:15"/>ህከኒች ኤተሮን ኣዱንያ አል ዳኛኑት፥ ሎርሎራኑት፥ በገዝ ሀለቀት፥ ቀባጣመት፥ ዎልቃመት፥ ሮስቹለከ ሰዎልድቹ ጉዕሙንኩ ሻንቃንለከ ቆተ አሌን ዮ ክን ረበ ኣዜን ገዪሀሰ ማጠንቶኡ።<note caller="-" style="x"><char style="xo" closed="false">6፥15 </char><char style="xt" closed="false"><ref loc="ISA 2:19-21">ኢሳ. 2፥19-21</ref>።</char></note> <verse eid="REV 6:15"/><verse number="16" style="v" sid="REV 6:16"/>እሰን ቆተተለ ክነተ «ኒ አሌን ኡቤ! ኬዕምኝ ቦርጭመ አሌን አፉዕሌሀኒች ብርተ ሆልች ኡሙዕሬች ማጬኔ!<note caller="-" style="x"><char style="xo" closed="false">6፥16 </char><char style="xt" closed="false"><ref loc="HOS 10:8">ሆሴ. 10፥8</ref>፤ <ref loc="LUK 23:30">ሉቃ. 23፥30</ref>።</char></note> <verse eid="REV 6:16"/><verse number="17" style="v" sid="REV 6:17"/>እሰ ሎሩ ኡሙዕሬ በሩ አሜቾቤቺሃ አይ ኡሮተ አታለኖ?» ይቶኡ።<note caller="-" style="x"><char style="xo" closed="false">6፥17 </char><char style="xt" closed="false"><ref loc="JOL 2:11">ኢዩ. 2፥11</ref>፤ <ref loc="MAL 3:2">ሚል. 3፥2</ref>።</char></note><verse eid="REV 6:17"/></para>
  <chapter eid="REV 6"/>
  <chapter number="7" style="c" sid="REV 7"/>
  <para style="s1">መት ጥብተ ሸይልኔ ሾሌ ኩሜ እስራኤል መነ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1"/>ህከኒች ኤተሮን ሾል መላይከት ሾሎንከ ኡለ ሙረባን ኡርታን ለዕዮም፤ እሰ ኡለ አሌን እኮ ባራን ህከረንገ ሀቅ አሌን ቦብሩ ቦብርበገ ሾሎንከ አዲን አሜታ ኡለ አል ቦብረ አፎኡ።<note caller="-" style="x"><char style="xo" closed="false">7፥1 </char><char style="xt" closed="false"><ref loc="JER 49:36">ኤር. 49፥36</ref>፤ <ref loc="DAN 7:2">ዳን. 7፥2</ref>፤ <ref loc="ZEC 6:5">ዘካ. 6፥5</ref>።</char></note> <verse eid="REV 7:1"/><verse number="2" style="v" sid="REV 7:2"/>ሄአኖ መገን ማተበ አፎ ዎሉ መላይኬቹ ሸርቂች አሜተን ለዕዮም፤ እስን ኡለተለከ ባረ ቤሶተ ዎልቀት ኣሰንቶሰ ሾሎንከ መላይከቤቹ ላገስ ጎት አዕይ <verse eid="REV 7:2"/><verse number="3" style="v" sid="REV 7:3"/>«መገን ካዲመ ሚኔን ማተበ አዕኖተ ኢለ ኡለተ እኮ ባረ ህከረንገ ሀቀ ቤሶኖቼ» ይ ያሮ።<note caller="-" style="x"><char style="xo" closed="false">7፥3 </char><char style="xt" closed="false"><ref loc="EZK 9:4">ሕዝ. 9፥4</ref>፤ <ref loc="EZK 6">6</ref>።</char></note> <verse eid="REV 7:3"/><verse number="4" style="v" sid="REV 7:4"/>እስራኤል ቶና ለሞንከ ደቦች ጉዕሚችን ሚኔንከሰ መገን ማተበ ዎቀሬመ መን ዎሊንሹ ጥብታ ሸይልኔ ሾሌ ኩምተ እሁስ ሞጮጬም። <verse eid="REV 7:4"/><verse number="5" style="v" sid="REV 7:5"/>ማተቡ ዎቀረሞሰሩ ይሁድ ደቦች ቶነ ለም ኩምተ፥ ሮቤሌ ደቦች ቶነ ለሙ ኩምተ፥ ጋዴ ደቦች ቶነ ለሙ ኩምተ፥ <verse eid="REV 7:5"/><verse number="6" style="v" sid="REV 7:6"/>አሴር ደቦች ቶነ ለሙ ኩምተ፥ ንፍታሌም ደቦች ቶነ ለሙ ኩምተ፥ ምናሴ ደቦች ቶነ ለሙ ኩምተ፥ <verse eid="REV 7:6"/><verse number="7" style="v" sid="REV 7:7"/>ስሞኔ ደቦች ቶነ ለሙ ኩምተ፥ ሌዌ ደቦች ቶነ ለሙ ኩምተ፥ ይሳኮሬ ደቦች ቶነ ለሙ ኩምተ፥ <verse eid="REV 7:7"/><verse number="8" style="v" sid="REV 7:8"/>ዛብሎኔ ደቦች ቶነ ለሙ ኩምተ፥ ዩሱፍ ደቦች ቶነ ለሙ ኩምትለከ ቢንያሜ ደቦች ቶነ ለሞ ኩምተ እቅ።<verse eid="REV 7:8"/></para>
  <para style="s1">ዋጁተ ኦድኑተ ኦደኦ ልግብ ኡመት</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9"/>ህከኒች ኤተሮን አዪሁ ዎለኦተ አታልቡ ልግብ ኡመት ለዕዮም፤ እሰን ኡመቲችለከ ደቦች፥ ዘሬችለከ አደደ አፎ ጠወአኖሀኒች ጉዕሚችን መኒች፥ ዘሬች፥ ባዲች፥ አደደ አፎን ጠወኣ መኒች ጉዕሚችን ጭምይት ዋጁተ ኦድኑተ ኦደእ አንጋንከሰ ዘምባብ ሀበረ አፍ ዳኝነት ቦርጭመለከ ሆልች ብሬን ኡርቶ እቅ። <verse eid="REV 7:9"/><verse number="10" style="v" sid="REV 7:10"/>እሰን ሎረ ላጋን ጨንጭተን</para>
  <para style="q1" vid="REV 7:10">«ጡምሱ</para>
  <para style="q1" vid="REV 7:10">ዳኝነቲ ቦርጭማን አፉዕሌ ኒ መገኒሃለከ</para>
  <para style="q1" vid="REV 7:10">ሆልቺሃን»</para>
  <para style="m" vid="REV 7:10">ይታኢት እቅ።<verse eid="REV 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 7:11"/>መላይከት ጉዕሙንኩ ኬዕምኝ ቦርጭማንለከ ሾሎንከ ክልቀትሃ፥ ባልቂሃ ዘህት ኡርት ኬዕምኝ ቦርጭመ ብሬን ሚኔንከሰ ሙግይት መገኒሃ ሰገዶኡ። <verse eid="REV 7:11"/><verse number="12" style="v" sid="REV 7:12"/>እሰን</para>
  <para style="q1" vid="REV 7:12">«ኣሚዕን! ሎርሱ፥ ሎርመት፥</para>
  <para style="q1" vid="REV 7:12">ሀይመት፥ ገለቱ፥ ኬዕምኙ፥</para>
  <para style="q1" vid="REV 7:12">ዎልቀቲለከ ጠረኝመቲ መገኒሃኔ</para>
  <para style="q1" vid="REV 7:12">ዘላለሚሃ ኢለ እሲሃ እሁን! ኣሚዕን» ይቶኡ።<verse eid="REV 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13"/>ህከኒች ኤተሮን ባልቂች መቱ ኢ አደ ፈንቀል «ኩሩ ዋጁ ቀምብሰ ኦደኦ መኑ አዬኤታን? እሰን ሀከንቤቺች አሜቶእራን?» ዬኤ።<verse eid="REV 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14"/>አንን «ቀርቾ! አት ደጋንት» ዬንስ፤ እስን «ህከን አበ ኦሪሻች ፉልት አሜቶእራን፤ እሰን ኦድኑሰ ሆልች ቄጊን ሜጭት ዋጁ አቶእራን።<note caller="-" style="x"><char style="xo" closed="false">7፥14 </char><char style="xt" closed="false"><ref loc="DAN 12:1">ዳን. 12፥1</ref>፤ <ref loc="MAT 24:21">ማቶ. 24፥21</ref>፤ <ref loc="MRK 13:19">ማር. 13፥19</ref>።</char></note> <verse eid="REV 7:14"/><verse number="15" style="v" sid="REV 7:15"/>ህካን እኮቤቺሃ መገን ኬዕምኝ ቦርጭመ ብሬን ሀንከዕርተለከ በራሃ መገን ምኔን ካደንታአ፤ ህትን ኬዕምኝ ቦርጭማን አፉዕሌኢንኩ ሀላ እሀኖሰ። <verse eid="REV 7:15"/><verse number="16" style="v" sid="REV 7:16"/>ከኒች ኤተሪሃ እሰ ጎራይታበአ፤ ሰገብት አፋሰበአ፤ አሩ ህከረንገ ፋረት ኡልታሰበአ፤<note caller="-" style="x"><char style="xo" closed="false">7፥16 </char><char style="xt" closed="false"><ref loc="ISA 49:10">ኢሳ. 49፥10</ref>።</char></note> <verse eid="REV 7:16"/><verse number="17" style="v" sid="REV 7:17"/>ኬዕምኝ ቦርጭመ በላን ዮ ሆልቹ ዜማንቹሰ እሀኖ፤ ሄእ ዊ ቡቆበ አዎንሰኖሰ፤ መገኑ እሌችሰ እንጂጃተ ሺንሸኖ» ዬኤ።<note caller="-" style="x"><char style="xo" closed="false">7፥17 </char><char style="xt" closed="false"><ref loc="PSA 23:1">መዝ. 23፥1</ref>፤ <ref loc="EZK 34:23">ሕዝ. 34፥23</ref>፤ <ref loc="PSA 23:2">መዝ. 23፥2</ref>፤ <ref loc="ISA 49:10">ኢሳ. 49፥10</ref>፤ <ref loc="ISA 25:8">25፥8</ref>።</char></note><verse eid="REV 7:17"/></para>
  <chapter eid="REV 7"/>
  <chapter number="8" style="c" sid="REV 8"/>
  <para style="s1">ለመልቅ ማተቡ ፈንተኡስ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1"/>ሆልቹ ለመልቅ ማተበ ፊል ፈኞ ወክት ሰኣት ደሬ ብከ ሰሞሁ ጨለ ዬእ። <verse eid="REV 8:1"/><verse number="2" style="v" sid="REV 8:2"/>ህከኒች ኤተሮን መገን ብሬን ኡርቶ ለመለ መላይከተ ለዕዮም፤ እሳንከ ለመለ ጡሩምበ ኣሴመሰ።<verse eid="REV 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3"/>ወርቅ ህጣን ኦዳተ አፎ ዎሉ መላይኬቹ አሜች ክትም ጠረጴዝ መዴን ኡሬእ፤ እሲንከ ኬዕምኝ ቦርጭመ ብሬን ዮ ዎርቂን መክሴመ ህጣነ አጪሴኖ ጠረጴዝ አሌን ጠሊላኖ ዱኢን ሜጡበ ሆንጠህሰኖ ልግብ ህጣነ ኣሴመስ።<note caller="-" style="x"><char style="xo" closed="false">8፥3 </char><char style="xt" closed="false"><ref loc="AMO 9:1">አሞ. 9፥1</ref>፤ <ref loc="EXO 30:1-3">ፉል. 30፥1-3</ref>።</char></note> <verse eid="REV 8:3"/><verse number="4" style="v" sid="REV 8:4"/>ህጣን ዉሊልት ጠሊላኖ ዱኢን ሜጡበ መላይኬች አንጋች መገን ብርተ ፉሎ። <verse eid="REV 8:4"/><verse number="5" style="v" sid="REV 8:5"/>ህከኒች ኤተሮን መላይኬቹ ህጣነ ዎሬኖ ኦዳተ አፍ ክትም ጠረጴዝች ፊመ ዊንሽ ኡለተ ዋሽ ቶሬእ፤ በለቁ፥ ላገት፥ ጉገኛትለከ ኡለ ሌንቄቁሁ እኮ።<note caller="-" style="x"><char style="xo" closed="false">8፥5 </char><char style="xt" closed="false"><ref loc="LEV 16:12">ሌዌ 16፥12</ref>፤ <ref loc="EZK 10:2">ሕዝ. 10፥2</ref>፤ <ref loc="EXO 19:16">ፉል. 19፥16</ref>፤ <ref loc="REV 11:19">መና. 11፥19</ref>፤ <ref loc="REV 16:18">16፥18</ref>።</char></note><verse eid="REV 8:5"/></para>
  <para style="s1">ጡሩምበ ቡስተኔሃ</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6"/>ለመለ ጡሩምበ አፎ ለመሉንኩ መላይከት ጡሩምበሰ ቡሶተ ቅጥ ይቶኡ።<verse eid="REV 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7"/>ወዕኔ መላይኬቹ ጡሩምበስ ቡሾ ወክት በረደለከ ሰቅሜሹ ቄጉ ልቃልቀሞ ጊረተ እኮ፤ ኡለተ ዋል ቶረሞ፤ ኡለ ሰቅሜሹ ቡቦ፤ ሀቅ ሰቅ አፎሁ ቡቦ፤ ለቶ ህጥት ጉዕሙንኩ ቡቦኡ።<note caller="-" style="x"><char style="xo" closed="false">8፥7 </char><char style="xt" closed="false"><ref loc="EXO 9:23-35">ፉል. 9፥23-35</ref>፤ <ref loc="EZK 38:22">ሕዝ. 38፥22</ref>።</char></note><verse eid="REV 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8"/>ህከኒች ኤተሮን ለንክ መላይኬቹ ጡሩምበስ ቡሾ፤ ሎረ ቆተተ አጉደኖርቹ ቡበን ባር ኣዜን ኡቦ፤ ባር ሰቅሜሹ ቄጉ እኮ፤ <verse eid="REV 8:8"/><verse number="9" style="v" sid="REV 8:9"/>ባር ኣዜስ ሄኣ ነብሶሁ ዮስ ክልቀቲች ሰቅስ አፎሁ ሬዮ፤ ህትን ባር ዊ አሌን ዮ ሰፊናች ሰቅ አፎሁ በዕዮ።<verse eid="REV 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10"/>ሰቅ መላይኬቹ ጡሩምበስ ቡሾ፤ መብራትገ ለልሳ ሎረ ቤዜት ሰሜች ኡለተ ዋልት ኡቦኡ፤ ኡቦንኩ ዊ ሰቅ አፎንለከ ቡቆ አሌኒት።<note caller="-" style="x"><char style="xo" closed="false">8፥10 </char><char style="xt" closed="false"><ref loc="ISA 14:12">ኢሳ. 14፥12</ref>።</char></note> <verse eid="REV 8:10"/><verse number="11" style="v" sid="REV 8:11"/>ህከን ቤዜ ሱዕሙ «ቁዕረንዳ» ዬኖሃን፤ መሰንትስ ዊ ሰቅሜሹ ቀራረኖሃ እኮ፤ ውስ ቀራሮቤቺሃ ህከ ዋሃ አጎ ልግቡ መኑ ሬዮ።<note caller="-" style="x"><char style="xo" closed="false">8፥11 </char><char style="xt" closed="false"><ref loc="JER 9:15">ኤር. 9፥15</ref>።</char></note><verse eid="REV 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12"/>ህከኒች ኤተሮን ሾልቅ መላይኬቹ ጡሩምበ ቡሾ፤ አሪ ሰቅ አፎሁ፥ አገንች ሰቅ አፎሁለከ ቤዜ ሰቅ አፎሁ ዎቀረሞ፤ ህካን እኮቤቺሃ እሰ ሰቅ አፎሁ ቱንስቹ እኮ፤ ከን ሃሌን በሬ ሰቅሜሹለከ ሀንከዕሬ ሰቅሜሹ ኑሩ ዮበኢሃ እኮ።<note caller="-" style="x"><char style="xo" closed="false">8፥12 </char><char style="xt" closed="false"><ref loc="ISA 13:10">ኢሳ. 13፥10</ref>፤ <ref loc="EZK 32:7">ሕዝ. 32፥7</ref>፤ ኢዩ. 2፥10፤31፤ <ref loc="JOL 3:15">3፥15</ref>።</char></note><verse eid="REV 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13"/>ህከኒች ኤተሮን ለኣምረ መቱ የብሮ ሰሜ በላን ብርየን ሎረ ላጋን «ፈቆ ሰሱንኩ መላይከት ጡሩምበ ቡሳ ወክት ኣዱንያ አሌን ሄኣ መኒሃ ቆሀኖህዕኔ! ቆሀኖህዕኔ! ቆሀኖህዕኔ!» ይተን ያርተን ሞጮጬም።<verse eid="REV 8:13"/></para>
  <chapter eid="REV 8"/>
  <chapter number="9" style="c" sid="REV 9"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1"/>ኦንትቅ መላይኬቹ ጡሩምበ ቡሾ፤ ሰሜች ኡላን ኡቦ መት ቤዜተ ለዕዮም፤ እሲንከ ሎረ ጥዕላሸ ኤሎ ፈኔኖ ቁልፈ ኣሴመስ። <verse eid="REV 9:1"/><verse number="2" style="v" sid="REV 9:2"/>እስ ሎረ ጥዕላሸ ኤሎ ፈኞ፤ ዉሊልት ምዳቺች ፉልታሀንገ እክ ጥዕላሸ ኤሌች ፉሎ፤ ኤሌች ፉልቶ ዉሊሌ መሳን አርቹትለከ ሰሞሁ ቱንስቹ እኮኡ።<note caller="-" style="x"><char style="xo" closed="false">9፥2 </char><char style="xt" closed="false"><ref loc="GEN 19:28">ክል. 19፥28</ref>።</char></note> <verse eid="REV 9:2"/><verse number="3" style="v" sid="REV 9:3"/>ህከኒች ኤተሮን ከንቸፈሩ ውሊሌ ኣዚች ኡለ አሌን ፉሎ፤ እሳንከ ኡለ አሌን ዮ ግንጥ<note caller="+" style="f"><char style="fqa" closed="false">ግንጠ ዩ፦ </char><char style="ft" closed="false">ዱብንከስ ከርኖ መርዛሙ ዘቡዕሉተ ዩሃን።</char></note> ዎልቀገ ዮ ዎልቀተ ኣሴመሰ።<note caller="-" style="x"><char style="xo" closed="false">9፥3 </char><char style="xt" closed="false"><ref loc="EXO 10:12-15">ፉል. 10፥12-15</ref>።</char></note> <verse eid="REV 9:3"/><verse number="4" style="v" sid="REV 9:4"/>ኡለ አሌን ዮ ህጥተ እኮ እኮስ ለቾርቹ ጉዕመንከ ህከረንገ እኮስ ሀቀ ምዕርታበእገ ኩለሞሰ፤ ጠዉ እኮጎሬ ምዕሩ ሀስሰኖሰ ሚኔንከሰ መገን ማተቡ ዮስበእ መነሃት እቅ።<note caller="-" style="x"><char style="xo" closed="false">9፥4 </char><char style="xt" closed="false"><ref loc="EZK 9:4">ሕዝ. 9፥4</ref>።</char></note> <verse eid="REV 9:4"/><verse number="5" style="v" sid="REV 9:5"/>እሰ መነ ሽቱዕናን ኦንቱ አገነ ኦሪሶታትቤሉ ሽቶተ ፍቃድ ኣሴማሰበአ፤ ከንቸፈሩንኩ ኢሌሰ ኦርሸት ጊንጡ መነ ከረኖ ወክት ሞጮጨመኖሀኒጋት። <verse eid="REV 9:5"/><verse number="6" style="v" sid="REV 9:6"/>ህከ ወክት መኑ ሬሁ ሀሰኖ፤ ጠዉ እኮጎሬ ሬሁተ ደአኖበአ፤ እሰን ሬሁት ሄዕላታአ፤ ጠዉ እኮጎሬ ሬሁት እሳች ሁንታአ።<note caller="-" style="x"><char style="xo" closed="false">9፥6 </char><char style="xt" closed="false"><ref loc="JOB 3:2">አዩ. 3፥2</ref>፤ <ref loc="JER 8:3">ኤር. 8፥3</ref>።</char></note><verse eid="REV 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7"/>ሁኩ ከንቸፈሩ በገዚሃ ቅጥአኤመ ፋርሱተ አጉዳ እቅ፤ እሳንከ አክሊለ አጉደኖሁ ቡዕለሰ ሄዕዮ እቅ፤ ህትን ሚንሰ መን ሚንተ አጉዳ እቅ።<note caller="-" style="x"><char style="xo" closed="false">9፥7 </char><char style="xt" closed="false"><ref loc="JOB 2:4">አዩ. 2፥4</ref>።</char></note> <verse eid="REV 9:7"/><verse number="8" style="v" sid="REV 9:8"/>እሳንከ ሜንት ሙም አጉደኖ ሙሙ ሄዕዮሰ፤ እንኩሰ ዞቤ እንኩተ አጉዳ እቅ።<note caller="-" style="x"><char style="xo" closed="false">9፥8 </char><char style="xt" closed="false"><ref loc="JOB 1:16">አዩ. 1፥16</ref>።</char></note> <verse eid="REV 9:8"/><verse number="9" style="v" sid="REV 9:9"/>ወዘናንከሰ ብረቲን መክሴመ ጌሬንጌሩ አጉደኖ ብረቱ ዮሰ እቅ፤ ህትን ጎኔሰ ላገት በገዚሃ ጅገን መርታ ልግቡ ፋርሱተለከ ኬዕምኝ ጋርት ሞጮጭሳ ላገተ አጉደኖ እቅ።<note caller="-" style="x"><char style="xo" closed="false">9፥9 </char><char style="xt" closed="false"><ref loc="JOB 2:5">አዩ. 2፥5</ref>።</char></note> <verse eid="REV 9:9"/><verse number="10" style="v" sid="REV 9:10"/>እሳንከ ግንጥ ዱብገ ከረኖ ዱቡ ዮሰ፤ ህትን ዱቢንከሰ መነ ከርተን ኦንቱ አገነ ኢለ ምርታ ወልቀት ዮሰ። <verse eid="REV 9:10"/><verse number="11" style="v" sid="REV 9:11"/>ዎሙንኩ ዮሰ፤ እስ ጥዕላሸ በውያ መላይኬቹ፤ ሱዕሙስ ዕብራይስጥ አፎን አባዶን<note caller="+" style="f"><char style="fqa" closed="false">አባዶነ፦ </char><char style="ft" closed="false">ዩ ኡዱምሳንቹ ዩሃን</char></note> ግርክ አፎን አጶልዮነ ዬኖ።<verse eid="REV 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12"/>ዎኔ ኣዬ ዬኖ ኦርሸት ህጎኡ፥ ከኒች ኤተሪሃ ዎሉ ለሙ አዬ ዬኖ ኦርሸት አሜታአ።<verse eid="REV 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13"/>ሌህቅ መላይኬቹ ጡሩምበ ቡሾ፤ መገን ብሬን ህጣነ አጪሲሃ ወርቂን መክሴመ ጠረጴዝ ሾሎ ቡዲች ፉልታ ላገተ ሞጮጬም።<note caller="-" style="x"><char style="xo" closed="false">9፥13 </char><char style="xt" closed="false"><ref loc="EXO 30:1-3">ፉል. 30፥1-3</ref>።</char></note> <verse eid="REV 9:13"/><verse number="14" style="v" sid="REV 9:14"/>ት ላገት ጡሩምበ አፎ ሌህቅ መላይኬቹ «ሎረ ኤፍራጢስ ዛዘኖ ዋን ኡሱረንቶ ሾሉንከ መላይከተ ገፈር!» ዬስ። <verse eid="REV 9:14"/><verse number="15" style="v" sid="REV 9:15"/>ህከን ሳኣቴንለከ ህከን በሬን፥ ህከን አገኒሃለከ ከን ዘማኒሃ ቅጥይቶ ሾሉንከ መላይከት መን ዘርተ ሰቅሜሸ ሽቶተ ገፈረንቶኡ። <verse eid="REV 9:15"/><verse number="16" style="v" sid="REV 9:16"/>ፋሻንች ጎጎት ዎሊንሹ ለሜ ጥቤ ምሎነ እሁስ ሞጮጬም። <verse eid="REV 9:16"/><verse number="17" style="v" sid="REV 9:17"/>ህትን ፋርሱተለከ ፋርሶ አሌን ቆጶ መነ መናማን ለዕዮሚሁ ህትጎታን፤ ዎዘናንከሰ ኦደኦ ብረቲን መክሴመ ጌሬንጌሩ አጉደኖ ጊረ ፊምገ ቢሸ፥ ገንበለ፥ ሰማሃ አጉደኖለከ ቡርቱካነ አጉደኖ እቅ፤ ህትን ፋርሶስ ቡዕሉ ዞቤ ቡዕለ አጉደኖ፤ ህትን አፌችሰ ፉልታ ጊረት ዉሊልትለከ ዲን<note caller="+" style="f"><char style="fqa" closed="false">ዲን፦ </char><char style="ft" closed="false">ግርክ አፎን ዲን ክኑ እክ ቡርቱካን ደኑ ዮስ፤ እስን አበ ቡበኖሃለከ ሂሉ ቦበኖ ፎገሉ ዮስሃን።</char></note> ፉለኖ እቅ። <verse eid="REV 9:17"/><verse number="18" style="v" sid="REV 9:18"/>አፌችሰ ፉልታ ጊራን፥ ዉሊሌንለከ ዲኒን ህከን ሰሶንከ በላን መን ዘሬ ሰቅሜሹ ሬዮ። <verse eid="REV 9:18"/><verse number="19" style="v" sid="REV 9:19"/>መሰንትስ ፋርሶሰ ዎልቀት ዮኢሁ አፎንከስለከ ዱብንከሳት እቅ፤ ዱቡሰ ዎርቹ አጉደኖ ቡዕላሙ እኮቤቺሃ መነ ምርታኢሁ እሲንት እቅ።<verse eid="REV 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20"/>ህከን በላን ሬቱዕነ ፈቆ መን ዘርት አንገሰ ሆጎች ፈንቀልት ቶበቶበአ፤ ሩሃንዪችለከ ወርቂች፥ ብሪች፥ ናሲች፥ ክኒችለከ ሀቂች መክሴመረ ለኡ ህከረንገ ሞጮጩ ህከረንገ ኦሮኡ አታልታበእ ሽርኬተ ሰገዱ አጉርቶበአ።<note caller="-" style="x"><char style="xo" closed="false">9፥20 </char><char style="xt" closed="false"><ref loc="PSA 115:4-7">መዝ. 115፥4-7</ref>፤ <ref loc="PSA 135:15-17">135፥15-17</ref>፤ <ref loc="DAN 5:23">ዳን. 5፥23</ref>።</char></note> <verse eid="REV 9:20"/><verse number="21" style="v" sid="REV 9:21"/>ህትን መነ ሹሃ፥ ኪሉሃ፥ ዝነተለከ ሞጉ ቶበት ፈንቀሉ ግቦኡ።<verse eid="REV 9:21"/></para>
  <chapter eid="REV 9"/>
  <chapter number="10" style="c" sid="REV 10"/>
  <para style="s1">መላይኬቹለከ ቀዉ ሉህን ጣጠሞ መጻፈ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1"/>ህከኒች ኤተሮን ጎመተ ኦደዕዮ ዎሉ ሎሩ ወልቀት ዮስ መላይኬቹ ሰሜች ድረን ለዕዮም፤ ቡዕላንከስ ሰመንዲቁት ሄኦ እቅ፤ ህትን ሚንስ አሩለከ ሎከስ ጊረ ቱቀ አጉዳ እቅ። <verse eid="REV 10:1"/><verse number="2" style="v" sid="REV 10:2"/>ፈንተኦ ቀዉ ጣጠሞ መጻፈ አንጋንከስ አፎ እቅ፤ መኬስ ሎከተ ባር አሌን፥ ጉረስ ሎከተ ኡለ አሌን አዕዮ፤ <verse eid="REV 10:2"/><verse number="3" style="v" sid="REV 10:3"/>ቡርቀኖ ዞቤገ ላገስ ጎት አዕይ ዎጆ፤ ዎጆ ወክት ለመሉንኩ ጉገኛት ላገሰ ሞጮጭሶኡ። <verse eid="REV 10:3"/><verse number="4" style="v" sid="REV 10:4"/>ለመሉንኩ ጉገኛት ላገሰ ሞጮጭሶ ወክት አን ከተቦተ እኮም፤ ጠዉ እኮጎሬ «ለመሉንኩ ጉገኛት ጠወኦኢሃ አሸግ ምስጥርን ማጥ አፍ ቤሉ ከተቦት» ይታ ላገተ ሰሜች ሞጮጬም።<verse eid="REV 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5"/>ህከኒች ኤተሮን ባራንለከ ኡለ አሌን ኡሬኢሃ ለዕዮም መላይኬቹ መኬስ አንገተ ሰማ ዋሽ ኬሽ <verse eid="REV 10:5"/><verse number="6" style="v" sid="REV 10:6"/>ዘማኒሃ ጉዕሚሃ ሄአኖ ሰማለከ እስ ኣዜን ዮ ኡለተለከ እሴ ኣዜን ዮ ባረለከ እስ ኣዜን ዮኢሃ ከለቆ መገን ሱዕሚን ጤሌዕለን «ከኒች ኤተሪሃ ዱንከኖበአ! <verse eid="REV 10:6"/><verse number="7" style="v" sid="REV 10:7"/>ጠዉ እኮጎሬ ለመልቅ መላይኬቹ ጡሩምበስ ቡሽ ሞጮጭሰኖ በር ካዲማተስ ነብያኖተ ተሽት ላገተ ኩሎሰገን መገን ምስጥሩ ዊመኖ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">10፥5-7 </char><char style="xt" closed="false"><ref loc="EXO 20:11">ፉል. 20፥11</ref>፤ <ref loc="DEU 32:40">ዘዳ. 32፥40</ref>፤ <ref loc="DAN 12:7">ዳን. 12፥7</ref>፤ አሞጽ 3፥7።</char></note> <verse eid="REV 10:7"/><verse number="8" style="v" sid="REV 10:8"/>ህከኒች ኤተሮን ዎዕናሃ ሰሜች ሞጮጬም ላገት «ባር አሌንለከ ኡለ አሌን ኡሬ መላይኬች አንጋች ዮኢሃለከ ፈንተዕዮ ጣጠሞ መጻፈ መርት ኣእ» ይ ለንኪሃ ጠወዕዮኤ።<verse eid="REV 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9"/>ህካን እኮቤቺሃ መላይኬችበ መር «ቀዉ ጣጠሞ መጸፈ ኣሴኤ» ይ ጠዕሜምረ «ኣእት እት፤ አፎንከክ መለብገ ጤአኖ፤ ጠዉ እኮጎሬ ጎደባንከክ ቀራረኖሃ እሀኖ» ዬእ።<verse eid="REV 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 10:10"/>ህከ ቀዉ ጣጠሞ መጻፈ መላይኬች አንጋች ኣእ እቻን አፌኤ ኣዜን መለብገ ጤዕዮኤ፤ ጠዉ እኮጎሬ እች ኬዕዮሚች ኤተሮን ጎደቡኤ ቀራረኖሃ እኮ።<note caller="-" style="x"><char style="xo" closed="false">10፥8-10 </char><char style="xt" closed="false">ዕዝ. 2፥8-33።</char></note> <verse eid="REV 10:10"/><verse number="11" style="v" sid="REV 10:11"/>ህከኒች ኤተሮን «ልግብያ መንተኔሃ፥ ኡመትተኔሃ፥ አደደ ላገተ ጠወኣ መንተኔሃለከ ዎመተኔሃ ለንኪሃ ራገ ጠወኡ ሀስሰኖሄ» የመም ኩለሞኤ።<verse eid="REV 10:11"/></para>
  <chapter eid="REV 10"/>
  <chapter number="11" style="c" sid="REV 11"/>
  <para style="s1">ለሞ ምስክርተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1"/>ህከኒች ኤተሮን ኤሳሃ ብኪሃ ደግለለኖ በርትገ ዮ መቱ ብኬኖ ቶመ ኣሴማኤ፤ ኤሳሃ «ኬእ ዱእ ምኒለከ ክትመ ክትሜኖ ጠረጴዘ ብክ፤ ህከን ቤቾን ሰገዳእረ ወለእ፤<note caller="-" style="x"><char style="xo" closed="false">11፥1 </char><char style="xt" closed="false"><ref loc="EZK 40:3">ሕዝ. 40፥3</ref>፤ <ref loc="ZEC 2:1-2">ዘካ. 2፥1-2</ref>።</char></note> <verse eid="REV 11:1"/><verse number="2" style="v" sid="REV 11:2"/>መገን ምኒች አብል አዲን ዮ ባዳተ ብክቶት፤ ሁኩ ቤቹ አይሁደ እኮበእ መኒሃ ኣሰሞሃ እኮቤቺሃ ብክቶት፤ አይሁደ እህቡ መኑ ጠሊልቹተ ከተመ ሸይልኔ ለሙ አገነ ፈንቀላንታሴ፤<note caller="-" style="x"><char style="xo" closed="false">11፥2 </char><char style="xt" closed="false"><ref loc="LUK 21:24">ሉቃ. 21፥24</ref>።</char></note> <verse eid="REV 11:2"/><verse number="3" style="v" sid="REV 11:3"/>ኢ ለሙንኩ ምስክሩ ጥጅ ኦድኑተ ኦደእ መቱ ኩምተ ለም ጥብታ ሌሃሁ በር ራገ ኩልታገ ወልቀተ ኣሳንሰ» ዬእ።<verse eid="REV 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4"/>እሰ ኡለ ቀርች ብሬን ኡርታ ለሙንኩ ወርች ሀቃከትለከ ለሙንኩ ኩረዘ አፉሼኖሃን፤<note caller="-" style="x"><char style="xo" closed="false">11፥4 </char><char style="xt" closed="false"><ref loc="ZEC 4:3">ዘካ. 4፥3</ref>፤ <ref loc="ZEC 11-14">11—14</ref>።</char></note> <verse eid="REV 11:4"/><verse number="5" style="v" sid="REV 11:5"/>አዪሁ እሰተ ምዕሮተ ሀሾ ጎሬ ጊረት አፌችሰ ፉልት ባለጋረሰ ቡስታአ፤ ህትን እሰተ ምሮተ ሀሰኖሁ ጉዕሙንኩ ሬሀኖሁ ከን ሀለቴኒት። <verse eid="REV 11:5"/><verse number="6" style="v" sid="REV 11:6"/>እሰ ራገ ጠወኣ ህከ በር ሰሜች ጤኑ ኡበኖበእገ ሰማሃ ጡፎተ ወልቀት ዮሰ፤ ህትን ዋሃ ቄጉ አት ዶርቶተለከ ሀሳ ወክት ጉዕመ እኮስ ሃሌን በለት ኡለተ ዎቀርቶተ ወልቀት ዮሰ።<note caller="-" style="x"><char style="xo" closed="false">11፥6 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 ነገ. 17፥1</ref>፤ <ref loc="EXO 7:17-19">ፉል. 7፥17-19</ref>፤ <ref loc="1SA 4:8">1 ሳሙ. 4፥8</ref>።</char></note><verse eid="REV 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7"/>ምስክርነቱሰ ሹልቶች ኤተሮን አበ ጥዕላሸ በዊች ፉለኖ ቡሳውቹ እሳን ኦለም ቄል ሸኖሰ።<note caller="-" style="x"><char style="xo" closed="false">11፥7 </char><char style="xt" closed="false"><ref loc="DAN 7:7">ዳን. 7፥7</ref>፡<ref loc="DAN 7:21">21</ref>፤ <ref loc="REV 13:5-7">መና. 13፥5-7</ref>፤ <ref loc="REV 17:8">17፥8</ref>።</char></note> <verse eid="REV 11:7"/><verse number="8" style="v" sid="REV 11:8"/>ሬሸሰ ሎረ ከተም ዎቄ በላን ኡጄኖ፤ ሁኩ ከተሙ ሶዶመ ህከረንገ ግብጸ ዬን ገኤኖ ከተሚሃ ምሳሌተ፤ ሁኩቤቹንኩ እሰ ቀርቹ ሰቀለሞሃቤቹ።<note caller="-" style="x"><char style="xo" closed="false">11፥8 </char><char style="xt" closed="false"><ref loc="ISA 1:9-10">ኢሳ. 1፥9-10</ref>።</char></note> <verse eid="REV 11:8"/><verse number="9" style="v" sid="REV 11:9"/>ህከኒች ኤተሮን ወገኒች፥ ደቦች፥ ዘሬች፥ አደደ አፎ ጠወአኖ መኒች፥ ባዲች ጉዕሚች ልግቡ ኡመቱ ሞገምበገ ከንት ሰሱ በርሃ መቶ በሬ ደርተ ሬሸሰ ለኣአ፤ ሬሸሰ ሞገመኖበእገ ከንታአ። <verse eid="REV 11:9"/><verse number="10" style="v" sid="REV 11:10"/>ሁኩ ለሙንኩ ነብያኑት ኣዱንያ አል መነ ኦርሶቤቺሃ ኣዱንያ አሌን ሄአኖ መኑ ነብያኑት ሬቶቤቺሃ አበ ሙንደኣአ፤ ህትን ሙንዲኖ ከበጃት ከበጅት ገገዉንኩሰ ኣስቱተ ኣሰቀንታአ። <verse eid="REV 11:10"/><verse number="11" style="v" sid="REV 11:11"/>ጠዉ እኮጎሬ ሰሱ በር ደሬን ህጎች ኤተሮን ሄእ ሩሁ መገኒች አሜች ሬሻን ኣጎ፤ ሎካንከሰ ኡሪቶኡ፤ ለኦ መኑ አበ ዋጅቶኡ።<note caller="-" style="x"><char style="xo" closed="false">11፥11 </char><char style="xt" closed="false"><ref loc="EZK 37:10">ሕዝ. 37፥10</ref>።</char></note> <verse eid="REV 11:11"/><verse number="12" style="v" sid="REV 11:12"/>ህከኒች ኤተሮን ለሙንኩ ነብያከት አሌ ፉሌ ይታ ሎረ ላገተ ሰሜች ሞጮጭቶኡ፤ ባለጋሩሰ ለአን ጎማን ሰማ ዋልት መርቶኡ።<note caller="-" style="x"><char style="xo" closed="false">11፥12 </char><char style="xt" closed="false"><ref loc="2KI 2:11">2 ነገ. 2፥11</ref>።</char></note> <verse eid="REV 11:12"/><verse number="13" style="v" sid="REV 11:13"/>ህከ ወክትንከ ኡለ አሌን አቡ ሌንቄቁ እኮ፤ ከተሚችስ ቶንቅ አፎሁ ድጀሞ፤ ኡለ ሌንቄቅ መሳን ለመሉ ሺህ መኑ ሬዮ፤ ሬሆች ፈቆእሩ አበ ዋጅቶኡ፤ ሰሜ መገኒሃ ሰገዶኡ።<note caller="-" style="x"><char style="xo" closed="false">11፥13 </char><char style="xt" closed="false"><ref loc="REV 6:12">መና. 6፥12</ref>፤ <ref loc="REV 16:18">16፥18</ref>።</char></note><verse eid="REV 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14"/>ለንክ «ኣዬ» ዬኖ ኦርሸት ህጎኡ፤ ህትን ሰቅ «ኣዬ» ዬኖ ኦርሸት ደዕልት አሜታአ።<verse eid="REV 11:14"/></para>
  <para style="s1">ለመልቅ ጡሩምብተኔሃ</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15"/>ለመልቅ መላይኬቹ ጡሩምበስ ቡሾ ወክት «ኣዱንያ አል ዎምነቱ ቀርችሃኔ መሲህሃ እኮኡ፤ እስን ዘማኒሃ ዎመ እክ ጠዕቅቶንትቤቺሃ ገለትጭናንኬ» ይታ ሎርሎረ ላገት ሞጮጨንቶኡ።<note caller="-" style="x"><char style="xo" closed="false">11፥15 </char><char style="xt" closed="false"><ref loc="EXO 15:18">ፉል. 15፥18</ref>፤ <ref loc="DAN 2:44">ዳን. 2፥44</ref>፤ <ref loc="DAN 7:14-27">7፥14-27</ref>።</char></note> <verse eid="REV 11:15"/><verse number="16" style="v" sid="REV 11:16"/>መገን ብሬን ኬዕምኝ ቦርጭማን አፉዕልቶ ለሞድምኔ ሾልንት ባልቀት ሚኔንተሰ ሙግይት መገኒሃ ሰገዶኡ፤ <verse eid="REV 11:16"/><verse number="17" style="v" sid="REV 11:17"/>«ዮንቲሁ፥ ሄኣንቲሁ፤</para>
  <para style="q2" vid="REV 11:17">ጉዕመንከ አታልታንት ቀርቾ መገኖ!</para>
  <para style="q2" vid="REV 11:17">ሎረ ወልቀክ ገይኪሃ አቶንትቤቺሃለከ</para>
  <para style="q2" vid="REV 11:17">ዎመ እክ ጠዕቅቶንትቤቺሃ ገለትጭናንኬ።<verse eid="REV 11:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18"/>አይሁደ እኮበእ መኑ ኡሙዕርቶኡ፤</para>
  <para style="q2" vid="REV 11:18">ጠዉ እኮጎሬ ኪ ኡሙዕርት አሜቶኡ፤</para>
  <para style="q2" vid="REV 11:18">ህትን ሬቶ መን አሌን ፈረዳንት ወክቱ ኢልዮኡ፤</para>
  <para style="q1" vid="REV 11:18">ካዲማተክ ነብያኖተለከ</para>
  <para style="q2" vid="REV 11:18">ጠሊላኖተ ሱዕመክ ሎርስታሀኑኡተ፥</para>
  <para style="q2" vid="REV 11:18">ቀቀዋኖተለከ ሎርሎራኖተ፥</para>
  <para style="q1" vid="REV 11:18">ዋገሰ አታንትሰ ወክቱ ኢሌዮኡ</para>
  <para style="q2" vid="REV 11:18">ኣዱንያ አል ቤሶረ ቤሳንት ወክቱ ኢልዮኡ» ይቶኡ።<note caller="-" style="x"><char style="xo" closed="false">11፥18 </char><char style="xt" closed="false"><ref loc="PSA 2:5">መዝ. 2፥5</ref>፤ <ref loc="PSA 110:5">110፥5</ref>፤ <ref loc="PSA 115:13">115፥13</ref>።</char></note><verse eid="REV 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19"/>ህከኒች ኤተሮን ሰማን ዮ መገን ምኑ ፈንተዕያን ወኣድ ሳጥኑ መገን ምኔን ለሌእ፤ ህትን በለቁ፥ ላገቲ፥ ጉገኛት፥ ኡለ ሌንቄቁለከ አበ በረደሃ እኮ።<note caller="-" style="x"><char style="xo" closed="false">11፥19 </char><char style="xt" closed="false"><ref loc="REV 8:5">መና. 8፥5</ref>፤ <ref loc="REV 16:18">16፥18</ref>፤ <ref loc="REV 21">21</ref>።</char></note><verse eid="REV 11:19"/></para>
  <chapter eid="REV 11"/>
  <chapter number="12" style="c" sid="REV 12"/>
  <para style="s1">መንቾለከ ደህችተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1"/>ህከኒች ኤተሮን አበ አጀብሲሳ መላት ሰማን ለልቶኡ፤ ሁኩንን መት መንቹት አሩ ኦደኦኢት አገንቹ ሎካችሴ ዎሮ አዲን ዮኢት ቶነ ለሞ ቤዜ አክሊለ ቡዕላንከሴ አቶኢት ሄኦ እቅ። <verse eid="REV 12:1"/><verse number="2" style="v" sid="REV 12:2"/>እሴን ላፈተ እኮቤቺሃ ኒጠኛት አፋንሴ ጨነቀንት ያርታኢት እቅ።<verse eid="REV 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 12:3"/>ህትን ዎልት መላት ሰማን ለሊቶኡ፤ እስን ለመሉ ቡዕሉለከ ቶኑ ቡዱ ቡዕላንከስ ለመሉ አክሊሉ ዮ ሎሩ ቢሹ ደህቹ ለሌእ።<note caller="-" style="x"><char style="xo" closed="false">12፥3 </char><char style="xt" closed="false"><ref loc="DAN 7:7">ዳን. 7፥7</ref>።</char></note> <verse eid="REV 12:3"/><verse number="4" style="v" sid="REV 12:4"/>ደህቹስ ዱቢንከስ ቤዜ ሰቅሜሸ ሰሜች ሀጣው ኡላን ኡጄእ፤ እስን ህት ኒጣ መንቹት እልቶ ወክት ጩልሴ አጉዕም ከሞተ እልቶተ እኮ መንቾ ብሬን ኡሬእ።<note caller="-" style="x"><char style="xo" closed="false">12፥4 </char><char style="xt" closed="false"><ref loc="DAN 8:10">ዳን. 8፥10</ref>።</char></note> <verse eid="REV 12:4"/><verse number="5" style="v" sid="REV 12:5"/>እሴን ኡመት ጉዕመንከ ብረት በርቲን አዘዥ ጠቀኖ ለባ ጩል እልቶኡ፤ እኮጎሬ ቤቱሴ መገን ቤቹ ሁኩንን መገን ኬዕምኝ ቦርጭመ ቤቹ ቀቡል አኤን መሴመስ።<note caller="-" style="x"><char style="xo" closed="false">12፥5 </char><char style="xt" closed="false"><ref loc="ISA 66:7">ኢሳ. 66፥7</ref>፤ <ref loc="PSA 2:9">መዝ. 2፥9</ref>።</char></note> <verse eid="REV 12:5"/><verse number="6" style="v" sid="REV 12:6"/>ህት መንቹንት መቱ ኩምተ፥ ለም ጥብተለከ ሌሃዉ በር ክድማተ መገኑ ቅጥ አዕዮሴቤቹ ኡለ ኡድመ ሁንቶኡ።<verse eid="REV 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7"/>ህከኒች ኤተሮን ሰማን በገዙ ኬዕዮ፤ ምካኤሊለከ እስ መላይከት ደህቺን ኦለንቶኡ፤ ደህቹለከ መላይከት ፈንቀልት ምካኤሊንለከ መላይካን ኦለንቶኡ።<note caller="-" style="x"><char style="xo" closed="false">12፥7 </char><char style="xt" closed="false"><ref loc="DAN 10:13">ዳን. 10፥13</ref>፡<ref loc="DAN 10:21">21</ref>፤ <ref loc="DAN 12:1">12፥1</ref>፤ <ref loc="JUD 1:9">ይሁደ 9</ref>።</char></note> <verse eid="REV 12:7"/><verse number="8" style="v" sid="REV 12:8"/>ጠዉ እኮጎሬ ደህቹለከ እስ መላይከት ቄለንቶኡ፤ ቄለንቶች ኤተሮን እሰ ሰማን ሄኣበእገ ቤቹ ሆሮ ደገሞሰበአ። <verse eid="REV 12:8"/><verse number="9" style="v" sid="REV 12:9"/>ህከ ሎረ ደህቹ ዎሮ ዋሼን ቶሬመ፤ እስን መነ ጉዕመንከ ሉሲሰኖ እልቢሰ ህከረንገ ሼይጣነ ዬን ገኤኖ ወዕኔሃ ዎርቹ፤ እሱ ኡለተ ዋሼን ቶሬመ፤ እስ መላይከንተ እሲን ሜጡበ ቶሬመ።<note caller="-" style="x"><char style="xo" closed="false">12፥9 </char><char style="xt" closed="false"><ref loc="GEN 3:1">ክል. 3፥1</ref>፤ <ref loc="LUK 10:18">ሉቃ. 10፥18</ref>።</char></note><verse eid="REV 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10"/>ህከኒች ኤተሮን መት ሎረ ላገት ሰማን «ቴሁ መገኑ ገይስ ጡምሱስ፥ ዎልቀስለከ ዎምነቱስ ለሊሾኡ፤ እስ መሲሁ ሹምነቱስ ለሊሾኡ፤ አመኔኦሱተ መገንኔ ብሬን ሀንከዕርተለከ በራሃ ብተንሰን ሄዕዮ አመኔኦሶ ከሳሹ ቶረሞኡ።<note caller="-" style="x"><char style="xo" closed="false">12፥10 </char><char style="xt" closed="false"><ref loc="JOB 1:9-11">አዩ. 1፥9-11</ref>፤ <ref loc="ZEC 3:1">ዘካ. 3፥1</ref>።</char></note> <verse eid="REV 12:10"/><verse number="11" style="v" sid="REV 12:11"/>እሰ ሆልች ቄጊንለከ ጠወኦ ምስክር ላጋን እሱ ቄልቶኡ፤ ነብሴሃሰ አሙዙዕነ ገዉሰ ሬሆተ ህግስ ኣቶኡ። <verse eid="REV 12:11"/><verse number="12" style="v" sid="REV 12:12"/>ህካን እኮቤቺሃ ሰሞለከ ሰሜ ኣዜን ሄኤነንተሩ ጉዕሙንኩ ተሽ ዩንክዕኔ፤ ቀዉ ወክቱ ፈቆስገ ደጎቤቺሃ እልቢሱ ሎረ ኡሙዕሬን ክዕኔቤቹ ድሬቤቺሃ ኡለትለከ ባሩ ቆሀኖህዕኔ» ይተን ሞጮጬም።<verse eid="REV 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13"/>ሁኩ ደህቹ ኡላን ኡጄመስገ ለዕዮ ወክት ለባ ጩል እልቶ መንቹተ ሸሩ ጀመሮ። <verse eid="REV 12:13"/><verse number="14" style="v" sid="REV 12:14"/>መንቹት ኡለ ኡድማን ቅጥ አኤመሴቤቹ ብር ይት መርቶተ ሎረ የብሮ ጎንተ አጉደኖ ለምት ጎንት ኣሰንቶሴ፤ ህከኔን ዎሪች ብሬች ቄዕርት ሰሱ ዘማን ደሬን<note caller="+" style="f"><char style="fqa" closed="false">ዘማን ደሬን፦ </char><char style="ft" closed="false">የኖሁ ግርካን ወክቱ፥ ወክትለከ ወክት ደርተ የኖ፤ ሁኩንን ዳን. 7፥25፤ 12፥7 ከተበሞኡ።</char></note> ጡመገ አኤን ካደሜነን አገሬኖሴ እቅ።<note caller="-" style="x"><char style="xo" closed="false">12፥14 </char><char style="xt" closed="false"><ref loc="DAN 7:25">ዳን. 7፥25</ref>፤ <ref loc="DAN 12:7">12፥7</ref>።</char></note> <verse eid="REV 12:14"/><verse number="15" style="v" sid="REV 12:15"/>ህት መንቹት ድርሱ መሰኖሴገ ዎርቹ አበ ዛዘኖ ዊ ጌሰ ዋሃ አፌችስ ኤተርንከሴ ቱፎ። <verse eid="REV 12:15"/><verse number="16" style="v" sid="REV 12:16"/>ጠዉ እኮጎሬ ኡለት መንቾተ ሀዕልት አፎሴ ፈንት ደህቹ አፌችስ ቱፎሃ አበ ዛዘኖ ዋሃ አጎኡ። <verse eid="REV 12:16"/><verse number="17" style="v" sid="REV 12:17"/>ህከኒች ኤተሮን ደህቹ መንቾን ኡሙዕር ፈቆ እሴ ዘሬን ኦለሞተ ኦሮዕዮ፤ እሰን መገን ትዛዝ አገርታሀኑኡንለከ ኢሲሃ አመዕነንት መሰከርታእረ። <verse eid="REV 12:17"/><verse number="18" style="v" sid="REV 12:18"/>ደህቹንኩ ባር ገበላን ሽፋር አሌን ኡሬእ።<verse eid="REV 12:18"/></para>
  <chapter eid="REV 12"/>
  <chapter number="13" style="c" sid="REV 13"/>
  <para style="s1">ለሞ ቡሳውተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1"/>ህከኒች ኤተሮን መቱ ቡሳውቹ ባሪች ፉለን ለዕዮም፤ እሲንከ ቶኑ ቡዱለከ ለመሉ ቡዕሉ ሄዕዮስ እቅ፤ ቡዳንከስ ቶኑ አክሊሉ ሄዕዮስ እቅ፤ ቡዕላንከስ መገኑ ቦሮርታ ቦሮር ሱዕሙ ሄዕዮ እቅ።<note caller="-" style="x"><char style="xo" closed="false">13፥1 </char><char style="xt" closed="false"><ref loc="DAN 7:3">ዳን. 7፥3</ref>፤ <ref loc="REV 17:3">መና. 17፥3</ref>፤ <ref loc="REV 7:12">7፥12</ref>።</char></note> <verse eid="REV 13:1"/><verse number="2" style="v" sid="REV 13:2"/>ለዕዮም ቡሳውቹ ሰማገ አጉደኖ እቅ፤ ጠዉ እኮጎሬ ሎከስ ድበ ዬኖ ቡሳውች ሎከተ አፎስ ዞቤ አፎ አጉደኖ እቅ፤ ህትን ደህቹ ገይስ ወልቀተለከ ገይስ ኬዕምኝ ቦርጭመተ ሎረ ወልቀተ ህከን ቡሳዊቺሃ ኣሴስ።<note caller="-" style="x"><char style="xo" closed="false">13፥2 </char><char style="xt" closed="false"><ref loc="DAN 7:4-6">ዳን. 7፥4-6</ref>።</char></note> <verse eid="REV 13:2"/><verse number="3" style="v" sid="REV 13:3"/>ቡሳውች ቡዕልች መቱስ ሬሆታ ኢልሰኖ ጡሎ ሄኡስ ለዕዮም፤ ጠዉ እኮጎሬ ሁኩ ሬሆተ አበቀአኖስ ጡሎ ፈይሃን ኣዱንያ አሌን ዮ መኑ ጉዕሙንኩ አጀብስጭ ቡሳውቹ አዎኞ። <verse eid="REV 13:3"/><verse number="4" style="v" sid="REV 13:4"/>ደህቹ ቡሳውቺሃ ዎልቀስ ኣሴቤቺሃ መኑ ጉዕሙንኩ ደህቺሃ ሰገጆ፤ ህትን «ቡሳውቹ አጉደኖሁ አዬት? ህትን እሲንን ኦለሞተ አታለኖ አዬት» ይተን ቡሳውቺሃ ሰገዶኡ።<verse eid="REV 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5"/>መገን አሌን ቦንለከ ቦሮረኖ ላገተ ጠወአኖ አፎሃ ቡሳውቺሃ ኣሴመስ፤ ሸይልኔ ለሙ አገነ ገዘእይ ጠቆተ ዎልቀተ ኣሴመስ። <verse eid="REV 13:5"/><verse number="6" style="v" sid="REV 13:6"/>መገኑ፥ ሱዕመስለከ ሰማን ሄኣእረ መገኑ እሰ ኣዜን ሄኣ መነ ቦሮሩ ጀመሮ።<note caller="-" style="x"><char style="xo" closed="false">13፥5-6 </char><char style="xt" closed="false"><ref loc="DAN 7:8">ዳን. 7፥8</ref>፤ 25፤ <ref loc="DAN 11:36">11፥36</ref>።</char></note> <verse eid="REV 13:6"/><verse number="7" style="v" sid="REV 13:7"/>እስን ጠሊላኖን ኦለሞተለከ ድለ አዕይ ቄለኖገ ሹምነቱ ኣሰሞስ፤ ህትን ወገኒን፥ ደቦን፥ አደደ አፎን ጠወኣእረለከ ኡመት አሌን ጉዕማንን ሹምነቱ ኣሰሞስ።<note caller="-" style="x"><char style="xo" closed="false">13፥7 </char><char style="xt" closed="false"><ref loc="DAN 7:21">ዳን. 7፥21</ref>።</char></note> <verse eid="REV 13:7"/><verse number="8" style="v" sid="REV 13:8"/>ዱንየ አሉ ከለቀሞች ጀመር ሱዕሙሰ ጎረጠሞ ሆልች ሄእ መጻፋን ከተበምባሁ ዱንየ አሌን ሄአኖ መኑ ጉዕሙንኩ ቡሳዊሃ ሰገዳአ።<note caller="-" style="x"><char style="xo" closed="false">13፥8 </char><char style="xt" closed="false"><ref loc="PSA 69:28">መዝ. 69፥28</ref>።</char></note><verse eid="REV 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9"/>መጨት ዮሲሁ ዮ ጎሬ ሞጮጩን! <verse eid="REV 13:9"/><verse number="10" style="v" sid="REV 13:10"/>«አዪሁ አግ መሰኖሁ ዮጎር አገም ኦሮአኖ፤ አዪሁ ሲፊን ሬሆተ መደበሞሁ ሲፊን ሬሀኖ» ህትን ጠሊላኖ አታዕሉለከ አመዕነቱ ለለኖሁ ህከ ወክትዪት።<note caller="-" style="x"><char style="xo" closed="false">13፥10 </char><char style="xt" closed="false"><ref loc="JER 15:2">ኤር. 15፥2</ref>፤ <ref loc="JER 43:11">43፥11</ref>።</char></note><verse eid="REV 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11"/>ዎሉ ቡሳውቹ ኡላች ፉለን ለዕዮም፤ እሲንከ ሆለ ቡድገ ዮ ለሙ ቡዱ ዮስ፤ ጠወአኖሁ ደህችጋት እቅ። <verse eid="REV 13:11"/><verse number="12" style="v" sid="REV 13:12"/>ወዕኔ ቡሳውች ቤቾን እስ ሹምነቲን አአኖ እቅ፤ ዱንየ አሉለከ እሴ አሌን ሄኣእሩ ጉዕሙንኩ ወዕኔ ቡሳውቺሃ ሰገዳገ አዕዮ፤ ሁኩ ቡሳውቹ ወዕና ሬሆተ አበቀአኖ ጡሎ ፈዬስ ወዕኔሃ ቡሳውቹ። <verse eid="REV 13:12"/><verse number="13" style="v" sid="REV 13:13"/>ጠዉ እኮጎሬ ለምቅ ቡሰውቹ መን ብሬን ጊረተ ሰሜች ኡለተ ድርሰኖ ኢለ ሎርሎረ አጀብሲሰኖርቹ አአኖ እቅ። <verse eid="REV 13:13"/><verse number="14" style="v" sid="REV 13:14"/>ዎዕኔ ቡሳዉ ብሬን አኦተ ኣሰሞስ አጀብሲሰኖርች መሳን ዱንየ አሌን ሄኣ መነ ሉሲሰኖ እቅ፤ ሲፊን ጡላይ ፈዬ ቡሳውቺሃ ኬዕምኝ ምስለ መክሶተ ዱንየ አሌን ሄአኖ መኒሃ ለንክ ቡሳውቹ አዘዦሰ። <verse eid="REV 13:14"/><verse number="15" style="v" sid="REV 13:15"/>ለንክ ቡሳውቹ ወዕኔ ቡሳውቺሃ ምስሊሃ ሄእ ሩህ ኣሶተ ሹምነቱ ኣሰሞስ፤ ሄእ ሩህ ኣሶተ ሹምነቱ ኣሰሞሲንኩ ምስሉ ጠወኦተ አታሎታትለከ እሲሃ ሰገድቡሩ ጉዕሙንኩ ሬታገ አአኖ እቅ። <verse eid="REV 13:15"/><verse number="16" style="v" sid="REV 13:16"/>ለንክ ቡሳውቹ ቀቀዋኑተ እኮኡ ሎርሎራኑተ፥ ቀባጣመተ እኮኡ ቡጥቻኑተ፥ ሮስቹ እኮ ሰዎልድቹ፥ ጉዕሙንኩ መኬሰ አንጋን ህከረንገ ሚኔሰ አሌን መላተ አቶተ ግድሾሰ። <verse eid="REV 13:16"/><verse number="17" style="v" sid="REV 13:17"/>ከን ሃሌን ቡሳዉች ሱዕመ ለሊሰኖ መላት ህከረንገ ሱዕምስ ዎልንሹ ዮበኢሁ ሀኩ መንቹሁ ህዕሮተለከ ህሮታ አታለኖበአ።<verse eid="REV 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18"/>ቴሁ ሀይመት ዮኢሁ ከንቤቾንት፤ ቀልቡ ዮሲሁ ቡሳውች ዎልንሸ ዎለኡን፤ ሁኩ ዎልንሹ መን ዎልንሸ ለሊሰኖ፤ ዎልንሹስ ሌህ ጥብታ ሌሃይኔ ሌሁሃን።<verse eid="REV 13:18"/></para>
  <chapter eid="REV 13"/>
  <chapter number="14" style="c" sid="REV 14"/>
  <para style="s1">ሆልችለከ መት ጥብተ ሸይልኔ ሾሌ ኩሜ መንተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1"/>ህከኒች ኤተሮን ሆልቹ ጽዮን ቆተ አሌን ኡሬኢሃ ለዕዮም፤ እሲን ሜጡበ እስ ሱዕሙለከ አንስ ሱዕሙ ሚኔሰ አሌን ከተበሞ መት ጥብተ ሸይልኔ ሾሌ ኩሜ መኑ ሄኦ እቅ።<note caller="-" style="x"><char style="xo" closed="false">14፥1 </char><char style="xt" closed="false"><ref loc="EZK 9:4">ሕዝ. 9፥4</ref>፤ <ref loc="REV 7:3">መና. 7፥3</ref>።</char></note> <verse eid="REV 14:1"/><verse number="2" style="v" sid="REV 14:2"/>ሰሜች አበ ፋም ዊ ላገገለከ አበ ጉገኛ ላገገ ዮ አበ ላገተ ሞጮጬም፤ ሞጮጬም ላገት ክራረ ዎቀርታ ክራር ላገተ አጉደኖሃ እቅ። <verse eid="REV 14:2"/><verse number="3" style="v" sid="REV 14:3"/>ኬዕምኝ ቦርጭማንለከ ሾሎንከ ክልቀት ባሊቀ ብሬን መት ጥብተ ሸይልኔ ሾሌ ኩሜ መኑ ሃዕሮ መዝሙረ ዘመርቶኡ፤ ህከ መዝሙረ ኡለ አሌን ዎዜመሰ መት ጥብተ ሸይልኔ ሾሌ ኩሜ መን ቤሉ አዪሁ ደጎተ አታለኖበአ። <verse eid="REV 14:3"/><verse number="4" style="v" sid="REV 14:4"/>እሰን እለንቶኢች ዝነተ አት አገኝትበረ እኮቤቺሃ ሜንቲን ዝነተ አኡ ሆግንከሰ ንጃሶበአ፤ ሆልቹ መሮቤቹሃ ጉዕመንከ አዎንታአ፤ እሰ መገኒሃለከ ሆልቺሃ<note caller="+" style="f"><char style="fqa" closed="false">ሆልቺሃ፦ </char><char style="ft" closed="false">የኖሁ ኢሰ ዩሃን።</char></note> መን በሊች ሀንገፈ እክ ዎዘንቶእራን። <verse eid="REV 14:4"/><verse number="5" style="v" sid="REV 14:5"/>እሰ ክዝብ ጠወኣበአ፤ ሂሉ ኩሌኖሰርቹንኩ ዮሰበአ።<note caller="-" style="x"><char style="xo" closed="false">14፥5 </char><char style="xt" closed="false"><ref loc="ZEP 3:13">ሶፎ. 3፥13</ref>።</char></note><verse eid="REV 14:5"/></para>
  <para style="s1">መገን ፍርደ ኩልታ ሰሶ መላይከተኔሃ</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6"/>ህከኒች ኤተሮን ዎሉ መላይኬቹ ኣዱንያ አሌን ሄአኖ ኡመቲሃ፥ ደቦተ፥ ባዲሃ፥ አደደ አፎ ጠወኣ መኒሃለከ ወገኒሃ ጉዕሚንከ ዱዱብሲሃ ዘላለሚሃ ሄኣ ተሽት ላገተ ኩሎተ ሰሜ በላን ብርየን ለዕዮም። <verse eid="REV 14:6"/><verse number="7" style="v" sid="REV 14:7"/>እስን ሎረ ላጋን «መገኑ ዋጅዬ! ከበጅዬስ! መሰንትስ እስ ፈረደኖ ወክቱ ኢሌቤቺሃ ሰማንለከ ኡለተ፥ ባረለከ ዊ ቡቁተ ከለቆ መገኒሃ ሰገጄ!» ዬእ።<verse eid="REV 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8"/>ዎሉ ለምቅ መላይኬቹ «ሰከርሰኖ ዝነሴ ዎይን ጠጀ ኡመቲሃ ጉዕሚንከ አግሶ ህት ሎረት ባብሎንቹት ኡቦኡ! ኡቦኡ!» የን ወዕኔስ መላይኬቹ አዎኞስ።<note caller="-" style="x"><char style="xo" closed="false">14፥8 </char><char style="xt" closed="false"><ref loc="ISA 21:9">ኢሳ. 21፥9</ref>፤ <ref loc="JER 51:8">ኤር. 51፥8</ref>፤ <ref loc="REV 18:2">መና. 18፥2</ref>።</char></note><verse eid="REV 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9"/>ዎሉ ሰቅ መላይኬቹ ሎረ ላጋን «ቡሳውቺሃለከ ምስሊሃ ሰገዳእሩ፥ መላስ ሚኔንከሰ ህከረንገ አንጋንከሰ አታሩ ጉዕሙንኩ <verse eid="REV 14:9"/><verse number="10" style="v" sid="REV 14:10"/>መገን ኡሙዕሬ ወይን ጠጀ አጋአ፤ ሁኩ ወይን ጠጁ ልቃለቀሙዕናን ኡሙዕሬስ ጠበቴን እንክለሞሃን፤ ህትን ጠሊለ መላይከ ብሬንለከ ሆልች ብሬን ጊራንለከ ዲን ዬኖ ፍሚን ኦርጨቀንታአ።<note caller="-" style="x"><char style="xo" closed="false">14፥10 </char><char style="xt" closed="false"><ref loc="ISA 51:17">ኢሳ. 51፥17</ref>፤ <ref loc="GEN 19:24">ክል. 19፥24</ref>፤ <ref loc="EZK 38:22">ሕዝ. 38፥22</ref>።</char></note> <verse eid="REV 14:10"/><verse number="11" style="v" sid="REV 14:11"/>እሰተ ኦርጨቀንታገ አታ ጊራች ፉልታ ዉሊልት ዘላለሚሃ አሌ ሰማ ዋልት ፉልታአ፤ ህከን ቡሳውቺሃለከ እስ ምስሊሃ ሰገዳእሩ ሱዕምስ መላተ አቶሩ ጉዕሙንኩ ሀንከዕርተለከ በራሃ ፎሎጩ ዮሰበአ» የን አዎኞሰ።<note caller="-" style="x"><char style="xo" closed="false">14፥11 </char><char style="xt" closed="false"><ref loc="ISA 34:10">ኢሳ. 34፥10</ref>።</char></note><verse eid="REV 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 14:12"/>መገን ትዛዝ አገርታሀኑኡንለከ ኢሳን አመዕንት ጠረኝት ሄኣ ጠሊላኖ አታዕሉ ለለኖሁ ከኒንት።<verse eid="REV 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13"/>ሰሜቺን «ካን ከተብ፤ ከኒች ኤተሮን ቀርቹ አመዕንት ሬታእሩ ማሰአንቶእረ» ይታ ላገተ ሞጮጬም፤ ህትን ጠሊሉ አያኑ «ሆጎሰ ሆንጌች ፎሎጭቶተ ሆጉሰ አዎንታሰቤቺሃ እሰ ሀንቅንከ ማሰአንቶእረ» የኖ።<verse eid="REV 14:13"/></para>
  <para style="s1">ቀርች ኡሙዕርት ኣዱንያ አሌን</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14"/>ህከኒች ኤተሮን ዋጁተ ጎመተ ለዕዮም፤ ጎመስ አሌን መንች ቤቱ አጉደኖሁ አፉዕልዮኡ፤ ቡዕላንከስ ወርቅ አክሊለ አዕዮኡ፤ አንጋንከስ እጳሸተ ዘዘረተ አፎኡ።<note caller="-" style="x"><char style="xo" closed="false">14፥14 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳን. 7፥13</ref>።</char></note> <verse eid="REV 14:14"/><verse number="15" style="v" sid="REV 14:15"/>ዎሉ መላይኬቹ መገን ምኒች አሜች ጎመ አሌን አፉዕሌኢሃ ሎረ ላጋን «ኡለ አሌን አዝመረ ጭም አኤኖለከ ምዴኖ ወክቱ ሆንጠኮኡ!» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">14፥15 </char><char style="xt" closed="false"><ref loc="JOL 3:13">ኢዩ. 3፥13</ref>።</char></note> <verse eid="REV 14:15"/><verse number="16" style="v" sid="REV 14:16"/>ጎመ አሌን አፉዕሌኢሁ ዘዘረስ ኡለተ ሶካን ኡለንት ምደንቶኡ።<verse eid="REV 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17"/>ዎሉ መላይኬቹ ሰማን ዮ መገን ምኒች ፉሎ፤ እስን እጳሸት ዘዘረት አፎ እቅ።<verse eid="REV 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 14:18"/>ጊረ አሌን ዎልቀት ዮሲሁ ዎሉ መላይኬቹ ክትመ ክትሜኖ ጠረጴዝ መዲች ፉል ኢጳሸተ ዘዘረተ አፎ መላይኬቹ «ወይኑ ላሎቤቺሃ እጳሸተ ዘዘረክ ሶክ ወይን ላልቹ ጉዕመንከ ኡለ አሊች ምድ ጭም አእ!» ይ ሎረ ላጋን ያሮ። <verse eid="REV 14:18"/><verse number="19" style="v" sid="REV 14:19"/>መላይኬቹንኩ ዘዘረስ ኡለ አል ሶክ ኡለ አሌን ዮ ወይን ላልቹ ምጅ ዎይነ ጩንሼኖ ሎረ ቤቾን ዎሮ፤ ሁኩንን መገን ኡሙዕርያቤቹ። <verse eid="REV 14:19"/><verse number="20" style="v" sid="REV 14:20"/>ከተሚች አብሌን ዮ ወይነ ጩንሼኖቤቾን ጩንሸሞ፤ ጩንሼኖቤቺች ፋርሶ ብጣለ ኢለኖ ጌሰ አሌ ዋል ሰሴ ጥቤ ኪሎ ሜትረ<note caller="+" style="f"><char style="fqa" closed="false">ሰሴ ጥቤ ኪሎ ሜትረ፦ </char><char style="ft" closed="false">የኖሁ መቱ መንቹ ሌሁ በር ሃመኖ ዎቄ ጌሰ እሀኖሃን።</char></note> ኢለ ኢለኖ ቄጉ ፉል ዱንተዕዮ።<note caller="-" style="x"><char style="xo" closed="false">14፥20 </char><char style="xt" closed="false"><ref loc="ISA 63:3">ኢሳ. 63፥3</ref>፤ <ref loc="LAM 1:15">ሻዞ. 1፥15</ref>፤ <ref loc="REV 19:15">መና. 19፥15</ref>።</char></note><verse eid="REV 14:20"/></para>
  <chapter eid="REV 14"/>
  <chapter number="15" style="c" sid="REV 15"/>
  <para style="s1">መጨረሽ በለተ አፎ መላይከተ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1"/>ዎሉ አጀብሲሰኖ መላተ ሰማን ለዕዮም፤ ሁኩንን መገን ኡሙዕርት ጎፋ መጨረሽ ለመለ በለተ አፎ ለመለ መላይከተ ለዕዮም።<verse eid="REV 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 15:2"/>ህከኒች ኤተሮን ጊራን ልቀለቀሞ ለአቃንች ባረ አጉደኖሃ ለዕዮም፤ ህትን ቡሳውችለከ ቡሳውች ምስለ፥ ሱዕምስ ዎሊንሽ መላተ ድለ አቶረ ለዕዮም፤ መገኑ ኣሴሰ ክራረ አፍ ህከን ቡርጩቅ ባር መዴን ኡርቶኢሃ ለዕዮም። <verse eid="REV 15:2"/><verse number="3" style="v" sid="REV 15:3"/>እሰን መገን ካድንቾ ሙስ መዝሙረለከ ሆልች መዝሙረ</para>
  <para style="q1" vid="REV 15:3">«ጉዕመንከ አታልታንት ቀርቾ መገኖ!</para>
  <para style="q2" vid="REV 15:3">ሆጉክ ሎረተለከ አጀብሲሳእታን፤</para>
  <para style="q1" vid="REV 15:3">ጉዕማንከ ኡመት ዎመ!<note caller="+" style="f"><char style="fqa" closed="false">ኡመት ዎመ፦ </char><char style="ft" closed="false">መት-መቱ እንክለንቶሩ «ዘማናከ ዎመ» ይታአ።</char></note></para>
  <para style="q2" vid="REV 15:3">ዎቆክ ጌጥዬሃለከ ሀንቅሃን።<note caller="-" style="x"><char style="xo" closed="false">15፥3 </char><char style="xt" closed="false"><ref loc="EXO 15:1">ፉል. 15፥1</ref>።</char></note><verse eid="REV 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4"/>ቀርቾ! ኬሳሃ ዋጅባሁለከ</para>
  <para style="q2" vid="REV 15:4">ሱዕመክ ከበጅባሁ አዬት?</para>
  <para style="q2" vid="REV 15:4">መሰንትስ ጠሊሉ ጠለዕል አቴት፤</para>
  <para style="q1" vid="REV 15:4">ሀንቅ ፍርዱክ ለሌቤቺሃ</para>
  <para style="q2" vid="REV 15:4">ኡመቱ ጉዕሙንኩ አሜች ብሬንከክ ሰገዳአ» ይተን ዘመርታ እቅ።<note caller="-" style="x"><char style="xo" closed="false">15፥4 </char><char style="xt" closed="false"><ref loc="JER 10:7">ኤር. 10፥7</ref>፤ <ref loc="PSA 86:9">መዝ. 86፥9</ref>።</char></note><verse eid="REV 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5"/>ህከኒች ኤተሮን ምስክር ዱካኑ ሁኩንን መገን ምኑ ሰማን ፈንተዕያን ለዕዮም።<note caller="-" style="x"><char style="xo" closed="false">15፥5 </char><char style="xt" closed="false"><ref loc="EXO 38:21">ፉል. 38፥21</ref>።</char></note> <verse eid="REV 15:5"/><verse number="6" style="v" sid="REV 15:6"/>ህከ ለመለንከ በለተ አፎ ለመሉንኩ መላይከት መገን ምኒች ፉልቶኡ፤ ነጠተ በለቃ ዋጁተ ኦድኑተ ኦደኦ እቅ፤ ወዘነሰ ዎርቅ ቀበቶን ቆዕርቶ እቅ። <verse eid="REV 15:6"/><verse number="7" style="v" sid="REV 15:7"/>ሾሎንከ ክልቀቲች መቱ ለመለንከ መላይኬቺሃ ዘላለሚች ዘላለመ ኢለ ሄአኖ መገን ኡሙዕርት ዊንቶ ለመለ ዎርቅ ጠበትተ ኣሴሰ። <verse eid="REV 15:7"/><verse number="8" style="v" sid="REV 15:8"/>መገን ኬዕምኚችለከ ዎልቃች ፉልታ ዉሊልት ዱእ ምኒ ዊሞ፤ ሁኩ ለመሉንኩ መላይከት አፎ ለመሉንኩ በለት እሆተ ኢለ አዪሁ ዱእ ምኒ ኣጎተ አታሎበአ።<note caller="-" style="x"><char style="xo" closed="false">15፥8 </char><char style="xt" closed="false"><ref loc="EXO 40:34">ፉል. 40፥34</ref>፤ <ref loc="1KI 8:10-11">1 ነገ. 8፥10-11</ref>፤ <ref loc="2CH 5:13-14">2 ዱዱ. 5፥13-14</ref>፤ <ref loc="ISA 6:4">ኢሳ. 6፥4</ref>።</char></note><verse eid="REV 15:8"/></para>
  <chapter eid="REV 15"/>
  <chapter number="16" style="c" sid="REV 16"/>
  <para style="s1">መገን ኡሙዕሬተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1"/>ህከኒች ኤተሮን ለመለንከ መላይከተ «መሬ! መገን ኡሙዕርተ ዊንቶ ለመለንከ ጠበቴሃ ኡለ አሌን ዱኜ» ይታ ሎረት ላገተ መገን ምኒች ፉልተን ሞጮጬም።<verse eid="REV 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2"/>ዎዕኔስ መላይኬቹ መር ጠበቴሃ ኡለ አሌን ዱኞ፤ ቡሳውች መላት ዮሰሀኑኡንለከ ቡሳውች ምስሊሃ ሰገዳ መን አሌን ሂሉለከ አበ ጥዥ ጨነቀኖ ጡሎ ፉሎ።<note caller="-" style="x"><char style="xo" closed="false">16፥2 </char><char style="xt" closed="false"><ref loc="EXO 9:10">ፉል. 9፥10</ref>።</char></note><verse eid="REV 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3"/>ለንክ መላይኬቹ ጠበቴሃ ባር አሌን ዱኞ፤ ህከ ወክት ባሩንኩ ሬዮ መን ቄግገ እኮ፤ ህትን ባር ኣዜን ሄአኖ ፎሉ ዮስርቹ ጉዕሙንኩ ሬዮ።<verse eid="REV 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4"/>ሰቅ መላይኬቹ ጠበቴሃ ዛዘኖ ዋንለከ ዊ ቡቆን ዱኛን እሰን ቄጉ እኮኡ። <verse eid="REV 16:4"/><verse number="5" style="v" sid="REV 16:5"/>ዊ አሌን ዎልቀት ዮስ መላይኬቹ «ዮንቲሁለከ ሄኦንት ጠሊሉ! ህት ፈረዶንትቤቺሃ አት ፈየሃን። <verse eid="REV 16:5"/><verse number="6" style="v" sid="REV 16:6"/>መኑ ጠሊላኖለከ ነብያከ ቄጉ ዱንቶቤቺሃ እሳሃ ቄጉ አግሶንትሰ፤ ሁኩንን እሳሃ ሀስሰኖሰ» የን ሞጮጬም። <verse eid="REV 16:6"/><verse number="7" style="v" sid="REV 16:7"/>ህትን ህጣነ ሀጪሴኖ ጠረጴዙ «ኤ! ጉዕመንከ አታልታንት ቀርቾ መገኖ! ፍርዱክ ሀንቅሃለከ ፈየሃን» ይታ ላገተ ሞጮጬም።<verse eid="REV 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8"/>ህከኒች ኤተሮን ሾልቅ መላይኬቹ ጠበቴሃ አር አሌን ዱኞ፤ አሪቹንት መነ ፋራንተሴ ቡስቶተ ዎልቀት ኣሰንቶሴ። <verse eid="REV 16:8"/><verse number="9" style="v" sid="REV 16:9"/>መኑንኩ አበ ፋራን ቡቦኡ፤ ህከን በለ አሌን ሹምነቱ ዮስ መገን ሱዕመ ቦሮርቶኡ፤ ህትን ቶበቶበአ፤ እሱንከ ከበጅቶስበአ።<verse eid="REV 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10"/>ኦንትቅ መላይኬቹ ጠበቴሃ ቡሳውች ኬዕምኝ ቦርጭም አሌን ዱኞ፤ ቡሳውች ዎምነቱንኩ ቱንስቹ እኮ፤ መኑንኩ አበ ኦርጨቀንቶቤቺሃ እንኩሰ ኢጦኡ። <verse eid="REV 16:10"/><verse number="11" style="v" sid="REV 16:11"/>እሰን አበ ኦርጨቀንቶቤቺሃለከ ጡላይቶቤቺሃ ሰሜ መገኑ ቦሮርቶ ቤሉ ሂለ ሆጎችሰ ቶበት ፈንቀልቶበአ።<verse eid="REV 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12"/>ሌህቅ መላይኬቹ ጠበቴሃ ኤፍራጤሰ ዬኖ ሎረ ዛዘኖ ዋን ዱኞ፤ ዉሁ ሸርቂች አሜታ ዎማተ ወቃሃ መክሲሃ ዛዘኖ ውሁ ሞሎ። <verse eid="REV 16:12"/><verse number="13" style="v" sid="REV 16:13"/>ህትን ደህች አፌችለከ ቡሳውች አፌች፥ ክዝበኛ ነብዬች አፌች ጎኞዕኜተ አጉዳ ሰሱ ሂሉ አያኑ ፉለን ለዕዮም። <verse eid="REV 16:13"/><verse number="14" style="v" sid="REV 16:14"/>እሰን ሩሃንይ አያነ እኮቤቺሃ አጀብሲሰኖ ጠወ አተን ጉዕመንከ አታለኖ መገን ሎረ በሬን እሀኖ በገዚሃ ጭምአቶተ ጉዕማንከ ባድ ዎመቤቹ መርታአ።<verse eid="REV 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 16:15"/>«አን ሞጋንችገ ድንገቴ አሜታም፤ ህካን እኮቤቺሃ ከል እካን መኑ ሻይደስ ለዕበገ ኬዕይ ኦድኑስ አገዕረኖ መንቹ ማሰአሞእሃን።»<note caller="-" style="x"><char style="xo" closed="false">16፥15 </char><char style="xt" closed="false"><ref loc="MAT 24:43-44">ማቶ. 24፥43-44</ref>፤ <ref loc="LUK 12:30-40">ሉቃ. 12፥30-40</ref>፤ <ref loc="REV 3:3">መና. 3፥3</ref>።</char></note><verse eid="REV 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16"/>ሁኩ አያነንት ዎመተ እብራዌ መን አፎን አርማጌዶነ ዬኖቤቾን ጭምአቶኡ።<note caller="-" style="x"><char style="xo" closed="false">16፥16 </char><char style="xt" closed="false"><ref loc="2KI 23:29">2 ነገ. 23፥29</ref>፤ <ref loc="ZEC 12:11">ዘካ. 12፥11</ref>።</char></note><verse eid="REV 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17"/>ህከኒች ኤተሮን ለመልቅ መላይኬቹ ጠበቴሃ ቦብር አሌን ዱኞ፤ ህከ ወክት ዱእ ምኒ ኣዜን ዮ ዳኝነት ቦርጭማች «አበቀዕዮ» ይታ ሎረ ላገት ፉልቶኡ። <verse eid="REV 16:17"/><verse number="18" style="v" sid="REV 16:18"/>ህትን በለቁ፥ ላገት፥ ጉገኛትለከ ኡለ ሌንቄቁሁ እኮ፤ ህትኔ ሎሩ ኡለ ሌንቄቁ መኑ ኣዱንያ አሌን ከለቀሞሀኒች ኬሽ ሆሮ እክ አገኘኖበአ።<note caller="-" style="x"><char style="xo" closed="false">16፥18 </char><char style="xt" closed="false"><ref loc="REV 8:5">መና. 8፥5</ref>፤ <ref loc="REV 11:13">11፥13</ref>፤ <ref loc="REV 19">19</ref>።</char></note> <verse eid="REV 16:18"/><verse number="19" style="v" sid="REV 16:19"/>ህትን ሎረ ከተንቹት ሰሱ ቤቹ እክ ቤሀንቶኡ፤ ህትን ኡመት ከተመንት ድጀንቶኡ፤ መገኑ ሎረ ባብሎነ ቃጎ፤ ሎሩ አሙዕሬስ ዎይን ጠጁ ዊሞ ጠበትተ አጋገ አዕዮሴ።<note caller="-" style="x"><char style="xo" closed="false">16፥19 </char><char style="xt" closed="false"><ref loc="ISA 51:17">ኢሳ. 51፥17</ref>።</char></note> <verse eid="REV 16:19"/><verse number="20" style="v" sid="REV 16:20"/>ህትን ዊን ረበንቶ ኡለት ጉዕመንት በኦኡ፤ ቆተንት ደገንቶበአ።<note caller="-" style="x"><char style="xo" closed="false">16፥20 </char><char style="xt" closed="false"><ref loc="REV 6:14">መና. 6፥14</ref>።</char></note> <verse eid="REV 16:20"/><verse number="21" style="v" sid="REV 16:21"/>ህትን መት-መቱስ ሸይልኔ ኦንቴ ኪሎ ጌሰ እሀኖ በረዱ ሰሜች መን አሌን ኡቦ፤ በለስ አበ ጨነቃቤቺሃ መኑ በረድ በለ መሳን መገኑ ቦሮርቶኡ።<note caller="-" style="x"><char style="xo" closed="false">16፥21 </char><char style="xt" closed="false"><ref loc="EXO 9:23">ፉል. 9፥23</ref>፤ <ref loc="REV 11:19">መና. 11፥19</ref>።</char></note><verse eid="REV 16:21"/></para>
  <chapter eid="REV 16"/>
  <chapter number="17" style="c" sid="REV 17"/>
  <para style="s1">ዝነተ አታ መንቾተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1"/>ህከኒች ኤተሮን ለመልንተ ጠበትተ አፎ ለመለ መላይካች መቱስ ኢቤቹ አሜች «ከበ አም! ልግቤ ዊ አሌን አፉዕልቶ ሎረ ዝነተ አታ መንቾ አሌን ኢለኖ ፍርደ ለሊሳንኬ።<note caller="-" style="x"><char style="xo" closed="false">17፥1 </char><char style="xt" closed="false"><ref loc="JER 51:13">ኤር. 51፥13</ref>።</char></note> <verse eid="REV 17:1"/><verse number="2" style="v" sid="REV 17:2"/>ኣዱንያ አል ዎመት ዝነተ አቶኢሁ እሴኒት፤ ህትን ኣዱንያ አሌን ሄኣእሩ ዝነተ አእሴ ዎይን ጠጂን ሰከርቶኡ» ይ ኩሎኤ።<note caller="-" style="x"><char style="xo" closed="false">17፥2 </char><char style="xt" closed="false"><ref loc="ISA 23:17">ኢሳ. 23፥17</ref>፤ <ref loc="JER 51:7">ኤር. 51፥7</ref>።</char></note><verse eid="REV 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3"/>ህከኒች ኤተሮን መላይኬቹ አያኒን ኡለ ኡድመ መሴኤ፤ ዊሙ ጅስማንከስ ቦሮር ሱዕሙ ዊሞ ቢሸ ቡሳውች አሌን ቆጶ መት መንቹተ ለዕዮም፤ እሲንከ ለመሉ ቡዕሉለከ ቶኑ ቡዱ ዮስየ እቅ።<note caller="-" style="x"><char style="xo" closed="false">17፥3 </char><char style="xt" closed="false"><ref loc="REV 13:1">መና. 13፥1</ref>።</char></note> <verse eid="REV 17:3"/><verse number="4" style="v" sid="REV 17:4"/>ህት መንቹት ሰመ አጉደኖ ብሸ ኦድኑተ ኦደኦ እቅ፤ ወርቂን፥ ጤአተ እኮ ክኒንለከ ዕንቁኤን መክጨንቶ እቅ፤ አንጋንከሴ ኮፍ ይታ ዝነተ አታ ንጃሱ ዊሞስ ዎርቅ ጠበቴሃ አንጋንከሴ አፎ እቅ።<note caller="-" style="x"><char style="xo" closed="false">17፥4 </char><char style="xt" closed="false"><ref loc="JER 51:7">ኤር. 51፥7</ref>።</char></note> <verse eid="REV 17:4"/><verse number="5" style="v" sid="REV 17:5"/>ሚኔሴ አሌን ምስጥር የኖ ሱዕሙ «ዝነተ አታሀኑኡለከ ኡለተ ንጃስሳሀኑኡ አመተ ሎረተ ባብሎንቹተ» የመም ከተበሞኡ። <verse eid="REV 17:5"/><verse number="6" style="v" sid="REV 17:6"/>ህት መንቹት ጠሊላኖ ቄጊንለከ ኢስተኔሃ ይት ሬቶ መን ቄጊን ሰከርታን ለዕዮም ወክት አበ አጀብሲጬም። <verse eid="REV 17:6"/><verse number="7" style="v" sid="REV 17:7"/>ጠዉ እኮጎሬ መላይኬቹ «ሚሃት አጀብሲጭታንቲሁ? መንቾ ምስጢርለከ እሴ ቆጶ ለመሉ ቡዕሉለከ ቶኑ ቡዱ ዮስ ቡሳውች ምስጥር ለሊሳንኬ። <verse eid="REV 17:7"/><verse number="8" style="v" sid="REV 17:8"/>ሁኩ አት ለኦንት ቡሳውቹ ከኒች ብርተ ሄዕዮ እቅ፤ ቴሱ ዮበአ፤ ኤተሮን ጥዕላሸ በው ኣዚች ፉለኖ፤ በእቤቹ መረኖ፤ ኣዱንያ አል ክልቀቲች ጀመር ሱዕሙሰ ሄእ መጻፋን ከተበንትባሁ ኣዱንያ አሌን ሄአኖ መኑ ቡሳውቹስ ከኒች ብርተ ሄዕዮሁ፥ ቴሱንገ ዮበኢሃለከ ኤተሮን አሜተኖሃ እሁስ ለኦ ወክት አበ አጀብሲጭቶኡ።<note caller="-" style="x"><char style="xo" closed="false">17፥8 </char><char style="xt" closed="false"><ref loc="DAN 7:7">ዳን. 7፥7</ref>፤ <ref loc="REV 11:7">መና. 11፥7</ref>፤ <ref loc="PSA 69:28">መዝ. 69፥28</ref>።</char></note><verse eid="REV 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 17:9"/>«ሀይመት ዮ ቡዕለ ሀሴኖሁ ከንቤቾኒት፤ ለመሉንኩ ቡዕሉለከ መንቹት አፉዕልቶ ለመሌንተ ቆተ፤ እሰን ለመሌንተ ዎመ። <verse eid="REV 17:9"/><verse number="10" style="v" sid="REV 17:10"/>እሳችን ኦንቱስ ኡቦኡ፤ መቱስ ቴሱ ዮኡ፤ ህትን ዎሉስ ቴሱ ኢለ አሜቾበአ፤ እስ አሜተኖ ወክት ቀዉ ጌሰ ዱንኩ ሀስሰኖስ። <verse eid="REV 17:10"/><verse number="11" style="v" sid="REV 17:11"/>ሁኩ ከኒች ብርተ ዮኢሁለከ ቴሱ ዮበእ ቡሳውቹ ህዜትቅየ ዎመ፤ እስ ህከን ለመሊችን መቶሃስ፤ እስን በእቤቹ መረኖ።<verse eid="REV 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12"/>«ሁኩ ለዕዮንሰ ቶኑንኩ ቡዱ ዎመ እኩዕነ ዮኢሩ ቶኔተ ዎመ፤ ጠዉ እኮጎሬ ቡሳውቺንን ሜጡበ መቶ ወክቲሃ ዎመ እኮተ ዎልቀት ኣሰንታሰ።<note caller="-" style="x"><char style="xo" closed="false">17፥12 </char><char style="xt" closed="false"><ref loc="ISA 7:24">ኢሳ. 7፥24</ref>።</char></note> <verse eid="REV 17:12"/><verse number="13" style="v" sid="REV 17:13"/>ሁኩ ቶኖንኩ ዎመት መቱ ሰውቱ ዮሰራን፤ እሰን ዎልቀሰለከ ሹምነቱሰ ህከን ቡሳውቺሃ ኣታአ። <verse eid="REV 17:13"/><verse number="14" style="v" sid="REV 17:14"/>እሰን ሆልች አሌን በገዙ ኬሳአ፤ ጠዉ እኮጎሬ ሆልቹ ቀርቻኖ ቀርቹለከ ዎመ ዎመ እኮቤቺሃ ቄለኖሰ፤ ህትን እሲን ሜጡበ ዮእሩ ገአንቶእረ፥ መጠረንቶእረለከ አመዕነንቶእረ» ዬኤ።<verse eid="REV 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15"/>ህትን መላይኬቹ «ህት ዝነተ አታኢት አፉዕልታን ለኦንት ልግቡ ዉሁ፥ ኡመቱ፥ መኑ፥ ወገኑለከ አደደ አፎሃ ጠወኣእረ። <verse eid="REV 17:15"/><verse number="16" style="v" sid="REV 17:16"/>ቡሳውቹለከ ለኦንት ቶኑ ቡደት ዝነተ አታኢተ እልሴ ግባአ፤ በኣገ አታሴ፤ ከል አት ፌሳሴ፤ ማለሴ እት ጊራን ቡስታሴ። <verse eid="REV 17:16"/><verse number="17" style="v" sid="REV 17:17"/>ሃሽኣቱሰ ሹልቶተ ከ ሰውት ቀልቤሰ አዕዮሁ መገኑሃን፤ ህካን እኮቤቺሃ መገን ላገት እሆተ ኢለ እሰ መቶ ሰውትን ኣገቀንታበአ፤ ዎምነት ሹምነቱሰ ቡሳውቺሃ አታአ።<verse eid="REV 17:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 17:18"/>«ህት ለኦንት መንቹት ኡለ አል ዳኛኖ አሌን ዎመ እኮእተ ሎረተ ከተንቹ» ዬኤ።<verse eid="REV 17:18"/></para>
  <chapter eid="REV 17"/>
  <chapter number="18" style="c" sid="REV 18"/>
  <para style="s1">ባብሎን ከተም ኡብተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1"/>ህከኒች ኤተሮን ሎሩ ሹምነቱ ዮስ መላይኬቹ ሰሜች ድረን ለዕዮም፤ ህከን መላይከ ኬዕምኚች ኬዕዮሀኒን ኡለት አበ ኑር እክ ለልቶኡ። <verse eid="REV 18:1"/><verse number="2" style="v" sid="REV 18:2"/>ሎረ ላጋን «ሎረት ባብሎንቹት ኡቦኡ! ኡቦኡ! እሴን ሩሃንዩ ሄአኖ ቤቹ እኮኡ፤ ሂሉ አያኑ ጉዕሙንኩ ገለኖቤቹ እኮኡ፤ ኮፍይታለከ ግቤመሰ ጪኡትለከ ግዙ ጉዕሙንኩ ገለኖቤቹ እኮኡ።<note caller="-" style="x"><char style="xo" closed="false">18፥2 </char><char style="xt" closed="false"><ref loc="ISA 13:21">ኢሳ. 13፥21</ref>፤ <ref loc="ISA 21:9">21፥9</ref>፤ <ref loc="JER 50:39">ኤር. 50፥39</ref>፤ <ref loc="JER 51:8">51፥8</ref>፤ <ref loc="REV 14:8">መና. 14፥8</ref>።</char></note> <verse eid="REV 18:2"/><verse number="3" style="v" sid="REV 18:3"/>መሰንትስ ዝነተ አእሴ ዎይን ጠጀ ኡመቲሃ ጉዕሚንከ አግሶኡ፤ ህትን ኣዱንያ አል ዎመት እሴን ሜጡበ ዝነተ አቶኡ፤ ህትን ኣዱንያ አል ነጋድት እሴ ልግቤ ናጠቀንሺን ኬዕዮሀኒን ቀባጣመተ እኮኡ» ይ ያሮ።<note caller="-" style="x"><char style="xo" closed="false">18፥3 </char><char style="xt" closed="false"><ref loc="ISA 23:17">ኢሳ. 23፥17</ref>፤ <ref loc="JER 51:7">ኤር. 51፥7</ref>።</char></note><verse eid="REV 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4"/>ዎልት ላገንት ሰሜች</para>
  <para style="q1" vid="REV 18:4">«ኢ ኡመቱ! እሴ ጩቢን በርገንቶኖቼ፤</para>
  <para style="q2" vid="REV 18:4">እሴ አሌን አሜታ በላተ ቤቀማኑተ እኬንበገ፤</para>
  <para style="q2" vid="REV 18:4">እሴ ኣዚች ፉሌ!<note caller="-" style="x"><char style="xo" closed="false">18፥4 </char><char style="xt" closed="false"><ref loc="ISA 48:20">ኢሳ. 48፥20</ref>፤ <ref loc="JER 50:8">ኤር. 50፥8</ref>፤ <ref loc="JER 51:6">51፥6</ref>፤ <ref loc="JER 45">45</ref>።</char></note><verse eid="REV 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5"/>ጩብሴ በትኝት ሰማሃ ኢልቶቤቺሃ</para>
  <para style="q2" vid="REV 18:5">መገኑ ብድልሴ ቃጎኡ።<note caller="-" style="x"><char style="xo" closed="false">18፥5 </char><char style="xt" closed="false"><ref loc="GEN 18:20-21">ክል. 18፥20-21</ref>፤ <ref loc="JER 51:9">ኤር. 51፥9</ref>።</char></note><verse eid="REV 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6"/>እሴ ኣስቶ ጌሰ ኣስዬሴ፤</para>
  <para style="q2" vid="REV 18:6">አቶ ሆጎተሴ ለሙ አፎ በርግቴን ባቼሴ፤</para>
  <para style="q1" vid="REV 18:6">እሴ አደደ አጌኖሃ ልቀለቆ ጠበቴን</para>
  <para style="q2" vid="REV 18:6">ለሙ አፎ ጠረኘ አቴን ልቀለቄ።<note caller="-" style="x"><char style="xo" closed="false">18፥6 </char><char style="xt" closed="false"><ref loc="PSA 137:8">መዝ. 137፥8</ref>፤ <ref loc="JER 50:29">ኤር. 50፥29</ref>።</char></note><verse eid="REV 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 18:7"/>እሴ ገይሴ ኬዕምኝለከ ናጀተ ኣስቶ ጌሰ</para>
  <para style="q2" vid="REV 18:7">ኦርሸተለከ ሻዘነተ ኣስዬሴ፤</para>
  <para style="q1" vid="REV 18:7">እሴን ቀልቤንከሴ</para>
  <para style="q2" vid="REV 18:7">‹አን ዎመተ እክ አፉዕልዮም፤</para>
  <para style="q2" vid="REV 18:7">ህዬሸተበአ፤</para>
  <para style="q2" vid="REV 18:7">ሻዘነት ሆሮ ኢልታኤበአ› ይተን ቦንታኢት።<verse eid="REV 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8"/>ህካን እኮቤቺሃ በለት ጉዕሙንኩ መቶ በሬን ኢልታሴ፤</para>
  <para style="q1" vid="REV 18:8">ሬሁት፥ ሻዘነትለከ ጎሩ ኢለኖሴ፤</para>
  <para style="q2" vid="REV 18:8">ጊራን ቡባአ፤</para>
  <para style="q1" vid="REV 18:8">እሴ አሌን ፈረደኖሁ</para>
  <para style="q2" vid="REV 18:8">ቀርቹ መገኑ ጠረኘሃን» የን ሞጮጬም።<verse eid="REV 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9"/>እሴን ሜጡበ ዝነተ አቶእሩለከ ናጃን ሄኦ ኡለ ዎመት እሴ ቡበን ፉልታ ዉሊልተ ለኣ ወክት እሴተኔሃ ያርተን ኦኣአ። <verse eid="REV 18:9"/><verse number="10" style="v" sid="REV 18:10"/>እሰን ኦርሸሴ ዋጅት ቄዕራሻን ኡርት «አት ሎረ ከተንቾ! አት ጠረኘ ከተንቾ ባብሎነ! ፍርዱክ መቶ ሳኣት ጌሳን አሜቾቤቺሃ ኬሳሃ ቆሀኖሄ! ቆሀኖሄ!» ይታአ።<note caller="-" style="x"><char style="xo" closed="false">18፥9-10 </char><char style="xt" closed="false"><ref loc="EZK 26:16-17">ሕዝ. 26፥16-17</ref>።</char></note><verse eid="REV 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11"/>ሆጎቡሰ ከኒች ኤተሮን ህዕረኖሁ ዮበእቤቺሃ ኡለ አል ነጋድንት እሴተኔሃ ኦኣሴ፤ ሻዛሴ።<note caller="-" style="x"><char style="xo" closed="false">18፥11 </char><char style="xt" closed="false"><ref loc="EZK 27:31-36">ሕዝ. 27፥31-36</ref>።</char></note> <verse eid="REV 18:11"/><verse number="12" style="v" sid="REV 18:12"/>መርከባንከሰ ሆጎበሞ ዎርቀ፥ ብረ፥ ኬዕምኙ ዮስ ክኑ፥ ዕንቁ፥ ጡመ ኦድኑተ፥ ሰሜ ደኑለከ ብሸ ሊቀለቀሞ ኦድኑተ፥ ሃር ኦድኑተ፥ ብሸተ ኦድኑተለከ ጡሙ ፎገሉ ዮስ ሀቀ ጉዕመንከ፥ ዘኔ እንኩተ፥ አበ ጤአተ እኮ ሀቀሃ፥ ነሐሰ፥ ብረቲንለከ እብነ በረድ ክኒን መክሴመ ኦዳታ ጉዕመንከ፥ <verse eid="REV 18:12"/><verse number="13" style="v" sid="REV 18:13"/>ቀረፋተ፥ አንጀነተ፥ ከርብተ ዬኖ ጡሙገ አንጀኖርቹ፥ ህጣነ፥ ወይን ጠጀ፥ ወርች ዘይተ፥ ስልቀሞ ቀመ፥ አለሱ፥ ለሉ፥ ሆለተ፥ ፋርሱተ፥ ኬዕምኝ ጋርተ፥ ሮሰተለከ ዎሎሃ መነ እቅ።<note caller="-" style="x"><char style="xo" closed="false">18፥12-13 </char><char style="xt" closed="false"><ref loc="EZK 27:12">ሕዝ. 27፥12</ref>፤ <ref loc="EZK 13">13</ref>፤ <ref loc="EZK 22">22</ref>።</char></note> <verse eid="REV 18:13"/><verse number="14" style="v" sid="REV 18:14"/>እሰን «አት ሄዕላቶንት ጡሙርቹ ጉዕመንኩ ኪች ቄዕር መሮኡ፤ ቀባጡክለከ ሹልሙክ ጉዕሙንኩ በዕዮኡ፤ ከኒች ኤተሮን ህከረ ጉዕመንከ ሆሮ ደጋንትሰበአ» ይታሴ። <verse eid="REV 18:14"/><verse number="15" style="v" sid="REV 18:15"/>ህካን ጉዕመንከ ህዕርተን ቀባጣመተ እኮ ነጋድት ኦርሸሴ ዋጅት ቄዕራሻን ኡርታአ፤ ኦአንለከ ሻዘን<note caller="-" style="x"><char style="xo" closed="false">18፥15 </char><char style="xt" closed="false"><ref loc="EZK 27:31">ሕዝ. 27፥31</ref>፤ <ref loc="EZK 36">36</ref>።</char></note> <verse eid="REV 18:15"/><verse number="16" style="v" sid="REV 18:16"/>«ጡመ ኦድኑተለከ ሰመ አጉደኖ ብሸ ኦድኑተ ኦደኣእት፥ ዎርቂንለከ ጤአተ እኮ ኪን ዕንቁንን በለቃ እቅት ሎረ ከተንቾተ ኣዬ! ኣዬ! <verse eid="REV 18:16"/><verse number="17" style="v" sid="REV 18:17"/>ኬንኩ ቀባጡት መቶ ሳኣት ጌሳን በዕዮ» ይታአ።</para>
  <para style="p" vid="REV 18:17">መርከብ ሀላፌቹ ጉዕሙንኩ፥ መርከቢን ሃንታ መኑ ጉዕሙንኩ፥ መርከብ አሌን አታ መኑ ጉዕሙንኩለከ ባር አሌን ነገዳ መኑ ጉዕሙንኩ ቄዕራሻን ኡርታአ፤<note caller="-" style="x"><char style="xo" closed="false">18፥17 </char><char style="xt" closed="false"><ref loc="ISA 23:14">ኢሳ. 23፥14</ref>፤ <ref loc="EZK 27:26-30">ሕዝ. 27፥26-30</ref>።</char></note> <verse eid="REV 18:17"/><verse number="18" style="v" sid="REV 18:18"/>እሴ ቡበን ፉልታ ዉሊልተ ለኦ ወክት «ተ ሎረ ከተንቹተ አጉደኖ ዎሉ ከተሙ ሄዕዮንዶ?» ይተን ያርቶኡ።<note caller="-" style="x"><char style="xo" closed="false">18፥18 </char><char style="xt" closed="false"><ref loc="EZK 27:32">ሕዝ. 27፥32</ref>።</char></note> <verse eid="REV 18:18"/><verse number="19" style="v" sid="REV 18:19"/>ህትን ቡዕልሰ አሌን ትበ አቶኡ፤ ኦአንለከ ሻዘን «ባር አሌን መርከቡ ዮሰሩ ጉዕሙንኩ እሴ ቀባጦን ቀባጣመተ እኮእሩ ህት ሎረ ከተንቹት መቶ ሳኣት ጌሳን በኦቤቺሃ ኣዬ! ኣዬ!» ይተን ያርታአ።<note caller="-" style="x"><char style="xo" closed="false">18፥19 </char><char style="xt" closed="false"><ref loc="EZK 27:30-34">ሕዝ. 27፥30-34</ref>።</char></note><verse eid="REV 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 18:20"/>ሰሞሁ! እሴን ተሽ ዩንክ፤ መገኑ ክዕኔተኔሃ እሴ አሌን ፈረጆቤቺሃ አዕኑ ጠሊላኑት፥ አሳበትለከ ነብያኑት ተሽ ዩንክዕኔ!<note caller="-" style="x"><char style="xo" closed="false">18፥20 </char><char style="xt" closed="false"><ref loc="DEU 32:43">ዘዳ. 32፥43</ref>፤ <ref loc="JER 51:48">ኤር. 51፥48</ref>።</char></note><verse eid="REV 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21"/>ከኒች ኤተሮን መቱ ጠረኙ መላይኬቹ ሎረ ርትም ክን ጌሰ መቱ ክኑ ኬሽ «ሎረት ባብሎን ከተንቹት ህት ዎልቃን ሀንበለንት ኡባአ፤ እሴን ከኒች ኤተሮን ሆሮ ደገንታበአ።<note caller="-" style="x"><char style="xo" closed="false">18፥21 </char><char style="xt" closed="false"><ref loc="JER 51:63-64">ኤር. 51፥63-64</ref>፤ <ref loc="EZK 26:21">ሕዝ. 26፥21</ref>።</char></note> <verse eid="REV 18:21"/><verse number="22" style="v" sid="REV 18:22"/>ክራረ ዎቀርታሀኑኡለከ ሙዚቀኛኖ ላገቲ፥ ሁሉሌተ ቡሳሀኑኡለከ ጡሩምበ ቡሳ ላገት ከኒች ኤተሮን ኪን ሞጮጨመኖበአ፤ እኮስርቹ መክሰኖ ሀይመት ዮስ መንቹ ከኒች ኤተሮን ኪን ደገመኖበአ፤ ህትን ርትም ላገቲ ከኒች ኤተሮን ኪቤቾን ሞጮጨንታበአ።<note caller="-" style="x"><char style="xo" closed="false">18፥22 </char><char style="xt" closed="false"><ref loc="EZK 26:13">ሕዝ. 26፥13</ref>፤ <ref loc="ISA 24:8">ኢሳ. 24፥8</ref>።</char></note> <verse eid="REV 18:22"/><verse number="23" style="v" sid="REV 18:23"/>ኩራዙክ ከኒች ኤተሮን ኪቤቾን ለሊሰኖበአ፤ እዜቾለከ እዜች ላገት ከኒች ኤተሮን ኪን ሞጮጨመኖበአ፤ ነጋድክ ኣዱንያ አል ሎርሎራኑ መኑ ሄኦኡ፤ ሲርንከክ ኡመት ጉዕመንከ ሉሲሶንት» የን ባር አሌን ቶሬእ።<note caller="-" style="x"><char style="xo" closed="false">18፥22-23 </char><char style="xt" closed="false"><ref loc="JER 7:34">ኤር. 7፥34</ref>፤ <ref loc="JER 25:10">25፥10</ref>።</char></note> <verse eid="REV 18:23"/><verse number="24" style="v" sid="REV 18:24"/>«ህትን ራጋኑት፥ ነብያኑት ኣዱንያ አሌን ሼመ መን ቄጉ ጉዕመንከ እሴ ኣዜን ደገሞኡ።» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">18፥24 </char><char style="xt" closed="false"><ref loc="JER 51:49">ኤር. 51፥49</ref>።</char></note><verse eid="REV 18:24"/></para>
  <chapter eid="REV 18"/>
  <chapter number="19" style="c" sid="REV 19"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1"/>ህከኒች ኤተሮን ሰማን ልግቤ መን ላገተ አጉደኖ ሎረ ላገተ «መገኒሃ ገለቱ እሁስ! ፌሱሁ፥ ኬዕምኙለከ ዎልቀት መገንሃን። <verse eid="REV 19:1"/><verse number="2" style="v" sid="REV 19:2"/>መሰንትስ ፍርዱስ ሀንቅሃለከ ጌጥዬሃን፤ ኣዱንያ አል ዝነተ አኢንከሴ ንጃሲሶ ሎረተ ዝነተ አታኢተ ፈረጆሴ፤ ህትን ካዲማሴ ቄግ ገዱተ እሴች ፉሎኡ» ይተን ሞጮጬም።<note caller="-" style="x"><char style="xo" closed="false">19፥2 </char><char style="xt" closed="false"><ref loc="DEU 32:43">ዘዳ. 32፥43</ref>፤ <ref loc="2KI 9:7">2 ነገ. 9፥7</ref>።</char></note> <verse eid="REV 19:2"/><verse number="3" style="v" sid="REV 19:3"/>ቴሁ «መገኒሃ ገለቱ እሁስ! እሴች ኬኣ ዉሊልት ዘላለሚሃ ሰማ ዋልት ፉልታአ» ይተን ያርቶኡ።<note caller="-" style="x"><char style="xo" closed="false">19፥3 </char><char style="xt" closed="false"><ref loc="ISA 34:10">ኢሳ. 34፥10</ref>።</char></note> <verse eid="REV 19:3"/><verse number="4" style="v" sid="REV 19:4"/>ህትን ለሞይዱምኔ ሾሉንኩ ባልቀትለከ ሾሉንኩ ክልቀቱ ጄነት ቦርጭመ አሌን አፉዕሌ መገኒሃ ኡብ «ኣሚዕን! መገኒሃ ገለቱ እሁስ» ይተን ሰገዶኡ።<verse eid="REV 19:4"/></para>
  <para style="s1">ሆልች ቦሎች ድግሰ</para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5"/>ህከኒች ኤተሮን «እሱ ዋጅቴነንተ ካዲመት ጉዕሙንኩ ቀቀዋኑንት ሎርሎራኑንት መገኑኔ ገለትጭዬ!» ይታ ላገት ኬዕምኝ ቦርጭማች ፉሎ።<note caller="-" style="x"><char style="xo" closed="false">19፥5 </char><char style="xt" closed="false"><ref loc="PSA 115:13">መዝ. 115፥13</ref>።</char></note> <verse eid="REV 19:5"/><verse number="6" style="v" sid="REV 19:6"/>ህከኒች ኤተሮን ልግብየ መን ላገት፥ ዛዘኖ ዊ ላገት፥ ጠረኘ ጉገኛ ላገገ ዮ ላገት «መገኒሃ ገለቱ እሁስ! ጉዕመንከ አታለኖ ቀርቹ መገኑኔ ዎመ እኮኡ!<note caller="-" style="x"><char style="xo" closed="false">19፥6 </char><char style="xt" closed="false"><ref loc="EZK 1:24">ሕዝ. 1፥24</ref>፤ <ref loc="PSA 93:1">መዝ. 93፥1</ref>፤ <ref loc="PSA 97:1">97፥1</ref>፤ <ref loc="PSA 99:1">99፥1</ref>።</char></note> <verse eid="REV 19:6"/><verse number="7" style="v" sid="REV 19:7"/>ሆልች ቦሎቹ ኢሌቤቺሃለከ እዜቹንት ገይሴ ቅጥ አቶቤቺሃ ሙንደዕኑን! ሙንዲኖን እሱንከ ከበጅኖ። <verse eid="REV 19:7"/><verse number="8" style="v" sid="REV 19:8"/>እሴንከ በለቀኖ ነጠ ኦድኑተ ኦደኦተ ኣሴመሴ፤ ህት ኦድኑት ጠሊላኖ ፈይመተ ሆጉ» የን ሞጮጬም።<note caller="-" style="x"><char style="xo" closed="false">19፥8 </char><char style="xt" closed="false"><ref loc="MAT 22:2-3">ማቶ. 22፥2-3</ref>።</char></note><verse eid="REV 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9"/>ህከኒች ኤተሮን መላይኬቹ «ህከ ሆልች ቦሎች ድግሲሃ ገአንቶሩ ማሰአንቶእረ» ይት ከተብ ዬኤ፤ ቴሁ «ኩሩ መገን ሀንቅተ ላገ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">19፥9 </char><char style="xt" closed="false"><ref loc="MAT 22:2-3">ማቶ. 22፥2-3</ref>።</char></note><verse eid="REV 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10"/>አን መላይኬቺሃ ሰገዶተ ሚኔንተኤ ሎካችስ ዎሮን ጎምብሰሞም፤ ጠዉ እኮጎሬ እስ «አጉር! ካን አቶት፤ አን ኪንለከ ኢስ መሰከሮ ጠወ አፎ ኪ አመኦሶን ሜጡበ ካድንቹሃን፤ አት መገኒሃ ሰገድ፤ መሰንትስ ሀንቅ ራጉ ጉዕሙንኩ ኢስተኔሃ መሰከርታአ» ዬኤ።<verse eid="REV 19:10"/></para>
  <para style="s1">ኮምቦ ፋሾን ቆጶ ፋሻንችተኔሃ</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11"/>ህከኒች ኤተሮን ሰሞሁ ፈንተዕያን ኮምቡ ፋሹ ለዕዮም፤ ፋሽ አሌን ቆጶንኩ አመዕነሞሃለከ ሀንቂሃ ዬኖሃን፤ እስን ሀንቂን ፈረደኖ፤ ኦለመኖሁ።<note caller="-" style="x"><char style="xo" closed="false">19፥11 </char><char style="xt" closed="false"><ref loc="EZK 1:1">ሕዝ. 1፥1</ref>፤ <ref loc="PSA 96:13">መዝ. 96፥13</ref>፤ <ref loc="ISA 11:4">ኢሳ. 11፥4</ref>።</char></note> <verse eid="REV 19:11"/><verse number="12" style="v" sid="REV 19:12"/>እልስ ጊረ ለበነተ አጉዳአ፤ ቡዕልስ አሌኒን ልግቡ አክሊሉ ዮኡ፤ እስ ቤሉ አዪሁ ደጎተ አታለኖበኢሁ እስ አሌን ከተበሞ ሱዕሙ ሄዕዮ እቅ።<note caller="-" style="x"><char style="xo" closed="false">19፥12 </char><char style="xt" closed="false"><ref loc="REV 10:6">10፥6</ref>።</char></note> <verse eid="REV 19:12"/><verse number="13" style="v" sid="REV 19:13"/>እስ ቄጊን ጬፌመ ኦድኑተ ኦደዕዮ እቅ፤ ሱዕሙንኩስ «መገን ላገተ» ዬኖሃን። <verse eid="REV 19:13"/><verse number="14" style="v" sid="REV 19:14"/>ህትን ዋጁ ነጠ እኮ ኦድኑተ ኦደኦ ኮምቦ ፋርሶን ቆጶ ሰሜ ጎጎቱ አዎንታሲት እቅ። <verse eid="REV 19:14"/><verse number="15" style="v" sid="REV 19:15"/>ኡመቲንከ ዎቀሬኖ ኢጳሹ ሲፉ አፌችስ ፉለኖት እቅ፤ ህትን ብረት በርቲን ጠቀኖሰ፤ እስን ጉዕመንከ አታለኖ መገን ዋጅሲሰኖ ኡሙዕርስ ለሊሰኖ ዎይን ጠጀ ጩንሼኖቤቾን ዎይነ ጩንሸኖ።<note caller="-" style="x"><char style="xo" closed="false">19፥15 </char><char style="xt" closed="false"><ref loc="REV 2:9">2፥9</ref>፤ <ref loc="ISA 63:3">ኢሳ. 63፥3</ref>፤ <ref loc="JOB 3:13">አዩ. 3፥13</ref>፤ <ref loc="REV 14:20">መና. 14፥20</ref>።</char></note> <verse eid="REV 19:15"/><verse number="16" style="v" sid="REV 19:16"/>ኦድኖስለከ ጋልስ አሌን «ዎማኖ ዎመ፤ ቀርቻኖ ቀርቹ» የኖ ሱዕሙ ከተበሞኡ።<verse eid="REV 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17"/>ህከኒች ኤተሮን አሪ አሌን ኡርዮኢሃ መቱ መላይኬቹ ለዕዮም፤ እስን ሰሜ አሌን ብርይታ ጪኦተ «ሎሩ መገኑ ቅጥአዕዮህዕኔ ድግሲሃ አሜ! ጭምይዬ! <verse eid="REV 19:17"/><verse number="18" style="v" sid="REV 19:18"/>ዎመ ማለ፥ በገዝ ሀለቀ ማለ፥ ጠረኘ መን ማለ፥ ፋርሶ ማለ፥ ፋርሱተለከ ፋርሱተ ቆጳ መን ማለ፥ ቀርቻኖለከ ሮሰ ማለ፥ ቀቀዋኖለከ ሎርሎራኖ ማለ አሜ እቼ» ህት የን ሎረ ላጋን ያሮ።<verse eid="REV 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19"/>ህትን ቡሳውቹለከ ኡለ አል ዎመት ዎታደሩንኩሰ ኮምቦ ፋሽ አሌን ቆጶሀንለከ ጎጎቲንከስ ሜጡበ ኦለንቶተ ጭምይታን ለዕዮም። <verse eid="REV 19:19"/><verse number="20" style="v" sid="REV 19:20"/>ጠዉ እኮጎሬ ቡሳውቹ አፈሞ፤ ህትን እሲን ሜጡበ ብሬንከስ ልግብ አጀብሲሰኖ ጠወ አአን ሄዕዮ ክዝብ ራጋንቹ አፈሞ፤ እስን ቡሳውች መላት ዮሰረለከ ቡሳውች ምስሊሃ ሰገዳእረ አጀብቱተ አአን ሉሲሰኖሰ እቅ፤ ኩሩ ለሙንኩ ፎሊን ሄኦገን ዲን ዬኖ ቡበኖ ጊረ ባር ኣዜን ኡጄመሰ።<note caller="-" style="x"><char style="xo" closed="false">19፥20 </char><char style="xt" closed="false"><ref loc="REV 13:1-18">መና. 13፥1-18</ref>።</char></note> <verse eid="REV 19:20"/><verse number="21" style="v" sid="REV 19:21"/>ፈቆእሩሁ ኮምቦ ፋሽ አሌን ቆጶሀን አፌች ፉልታ ሲፊን ሬታን ጪኡት ጉዕሙንኩ ማለሰ እት ዱቦኡ።<verse eid="REV 19:21"/></para>
  <chapter eid="REV 19"/>
  <chapter number="20" style="c" sid="REV 20"/>
  <para style="s1">ኩሜ ዘማን ዎምተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1"/>ህከኒች ኤተሮን አበ ጥዕላሸ በወ ፈኔኖ ቁልፈለከ ሎረ ሰንሰለተ አንጋንከስ አፎ መላይኬቹ ሰሜች ድረን ለዕዮም። <verse eid="REV 20:1"/><verse number="2" style="v" sid="REV 20:2"/>እስን ደህቹ አፍ ኩሜ ዘማን ኡሱሮ፤ ሁኩ ደህቹ እልቢሱ ህከረንገ ሻይጣኑ ወዕኔሃ ዎሪቹ እቅ።<note caller="-" style="x"><char style="xo" closed="false">20፥2 </char><char style="xt" closed="false"><ref loc="GEN 3:1">ክል. 3፥1</ref>።</char></note> <verse eid="REV 20:2"/><verse number="3" style="v" sid="REV 20:3"/>ኩሜ ዘማኑ ጎፎተ ኢለ ኡመት ሉሲሰኖበእገ መላይኬቹ ደህቹስ ሎረ ጥዕላሸ በዋን ቶር አሌስ ጡፍ ማተበ አዕይ አሸጎ፤ ሁኩ ኩሜ ዘማኑ ጎፎች ኤተሮን ቀዎ ወክቲሃ ሂረሙ ሀስሰኖስ።<verse eid="REV 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4"/>ህከኒች ኤተሮን ኬዕምኝ ቦርጭመተ ለዕዮም፤ ህከን ኬዕምኝ ቦርጭመ አሌን ፈረዶተ ሹምነቱ ኣሰሞሰሩ አፉዕልቶኢሃ ለዕዮም፤ ኢስተኔሃ መሰከርቶቤቺሃለከ መገን ላገተኔሃ ቡዕሉሰ ሙርተዕዮ መን ነብሳሃ ለዕዮም፤ እሰን ህከን ቡሳዊሃለከ ምስሊሃ ሰገድበረ፥ መላስ ሚኔንከሰ ህከረንገ አንጋንከሰ አቶበእረ እቅ፤ እሰን ሬሆች ኬእ መሲሂን ሜጡበ ኩሜ ዘመኒሃ ዎመ እኮኡ።<note caller="-" style="x"><char style="xo" closed="false">20፥4 </char><char style="xt" closed="false"><ref loc="DAN 7:9">ዳን. 7፥9</ref>፡<ref loc="DAN 7:22">22</ref>።</char></note> <verse eid="REV 20:4"/><verse number="5" style="v" sid="REV 20:5"/>ጠዉ እኮጎሬ ዎሉ ሬቶ መኑ ኩሜ ዘማኑ ጎፎተ ኢለ ሬሆች ኬኦበአ፤ ሁኩን ወዕኔሃ ሬሆች ኬኡሃን። <verse eid="REV 20:5"/><verse number="6" style="v" sid="REV 20:6"/>ዎዕኔ ሬሆች ኬእ ወጥ ደእታሩ ማሰአንቶእረለከ ጠሊላኖተ፤ መሰንትስ ለንክ ሬሁት እሰ አሌን ሹምነቱ ዮሰበአ፤ እሰን መገንለከ መሲህ ቂሰተ እክ መሲህን ሜጡበ ኩሜ ዘማኒሃ ነገሳአ።<verse eid="REV 20:6"/></para>
  <para style="s1">ሻይጣኑ ቄለሙስ</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7"/>ሁኩ ኩሜ ዘማኑ ጎፎች ኤተሮን ሻይጣንቹ ኡሱርች ሂረመኖ። <verse eid="REV 20:7"/><verse number="8" style="v" sid="REV 20:8"/>እስን ኣዱንያ አሌን ዮ ኡመት ጉዕመንከ ጎገለከ ማጎገሃ ሉሲሶተለከ ኦሊሃ ቅጥ አኦተ ፉለኖ፤ እሰ ዎሊንሹንኩ ባር ገበላን ዮ ሽፋሪያ ጌሰ።<note caller="-" style="x"><char style="xo" closed="false">20፥8 </char><char style="xt" closed="false"><ref loc="EZK 7:2">ሕዝ. 7፥2</ref>፤ <ref loc="EZK 38:2">38፥2</ref>፤ 9፤15።</char></note> <verse eid="REV 20:8"/><verse number="9" style="v" sid="REV 20:9"/>እሰን ኡለ አል ጉዕመንከ ሆርት ጠሊላኖ ቀእተለከ ኢተንቶ ከተንቹተ ረቦኡ፤ ጠዉ እኮጎሬ ሰሜች ጊረት ድርት ቡስት ሹልቶሰ። <verse eid="REV 20:9"/><verse number="10" style="v" sid="REV 20:10"/>እሰተ ሉሲሾ እልቢሱ፥ ቡሳዊቹለከ ክዝበኙ ነብዬቹ ዮ ቤቹ ዲን ዬኖ ቡበኖ ባር ኣዜን ቶረንቶኡ፤ ህከኔን ሀንከዕርተለከ በራሃ ዘላለሚች ዘላለመ ኢለ ኦርጨቀንታአ።<verse eid="REV 20:10"/></para>
  <para style="s1">መጨረሽ ፍርድተኔሃ</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11"/>ህከኒች ኤተሮን ሎረ ዋጁ ኬዕምኝ ቦርጭመተለከ ቦርጭመስ አሌን አፉዕልዮኢሃ ለዕዮም፤ ብሬችስ ሰሞሁለከ ኡለት ሁንቶኡ፤ ቤቹንኩ ደገሞሰበአ። <verse eid="REV 20:11"/><verse number="12" style="v" sid="REV 20:12"/>ህትን ቀቀዉለከ ሎርሎሩ ሬቶእሩ ጉዕሙንኩ ኬዕምኝ ቦርጭመ ብሬን ኡርታን ለዕዮም፤ ህከንቤቾንን መጻፈንት ፈንተኦኡ፤ ህትን ዎሉ መጻፉ ሁኩንን ሄእ መጻፉ ፈንተዕዮ፤ ሁኩ ሬቶእሩ መጻፋን ከተበሞ ሆጎሰ ሃሊን ፍርደ ቶጎኡ።<note caller="-" style="x"><char style="xo" closed="false">20፥11-12 </char><char style="xt" closed="false">ዳን. 7፥9-10</char></note> <verse eid="REV 20:12"/><verse number="13" style="v" sid="REV 20:13"/>ባሩንኩ ኣዜስ ዮ ሬቶእረ ኣሴእ፤ ህትን ሬሁትለከ አዛቡ እሰ ኣዜን ሬቶእረ ኣቶኡ፤ መት-መቱንኩ ሆጎሰ ሃሊን ፍርደ ኣእቶኡ። <verse eid="REV 20:13"/><verse number="14" style="v" sid="REV 20:14"/>ህከኒች ኤተሮን ሬሁትለከ ጃነሙ ጊረ ባር ኣዝ ቶረንቶኡ፤ ሁኩ ጊረ ባሩ ለምቅተ ሬሁ። <verse eid="REV 20:14"/><verse number="15" style="v" sid="REV 20:15"/>ሱዕሙስ ሄእ መጻፋን ከተበምባሁ አዪሁ ጊረ ባር ኣዜን ቶረሞ።<verse eid="REV 20:15"/></para>
  <chapter eid="REV 20"/>
  <chapter number="21" style="c" sid="REV 21"/>
  <para style="s1">ሃዕሮ ሰማለከ ሃዕሮ ኡለተ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1"/>ህከኒች ኤተሮን ሃዕሮ ሰማለከ ሃዕሮ ኡለታ ለዕዮም፤ መሰንትስ ዎዕኔ ሰሞለከ ኡለት ህጎኡ፤ ከኒች ኤተሮን ባሩንኩ ዮበአ።<note caller="-" style="x"><char style="xo" closed="false">21፥1 </char><char style="xt" closed="false"><ref loc="ISA 65:17">ኢሳ. 65፥17</ref>፤ <ref loc="ISA 66:22">66፥22</ref>፤ <ref loc="2PE 3:13">2 ጴጥ. 3፥13</ref>።</char></note> <verse eid="REV 21:1"/><verse number="2" style="v" sid="REV 21:2"/>ህትን ጠሊለት ከተንቹት ሃዕሮት ዬሩሳሌም ጨውሃሴ መክቶ እዜቾገ ተቃጠብ ሰሜች መገን አዲች ድርተን ለዕዮም።<note caller="-" style="x"><char style="xo" closed="false">21፥2 </char><char style="xt" closed="false"><ref loc="ISA 52:1">ኢሳ. 52፥1</ref>፤ <ref loc="ISA 61:10">61፥10</ref>፤ <ref loc="REV 3:12">መና. 3፥12</ref>።</char></note> <verse eid="REV 21:2"/><verse number="3" style="v" sid="REV 21:3"/>ህትን ሎረ ላገት ኬዕምኝ ቦርጭማች «መገን ገልትት መን በላን እኮኡ፤ እስን እሳን ሜጡበ ሄአኖ፤ እሰን እስ ኡመት እካአ፤ መገኑ ገዉንኩስ መገኑሰ እክ እሳን ሜጡበ እሀኖ።<note caller="-" style="x"><char style="xo" closed="false">21፥3 </char><char style="xt" closed="false"><ref loc="EZK 37:27">ሕዝ. 37፥27</ref>፤ <ref loc="LEV 26:11-12">ሌዌ 26፥11-12</ref>።</char></note> <verse eid="REV 21:3"/><verse number="4" style="v" sid="REV 21:4"/>ህትን እሌችሰ እንጂጃተ ጉዕመንከ ሺንሸኖ፤ ህከኒች ኤተሮን ሬሁት ህከረንገ ሻዘነት ህከረንገ አልፋቴት ህከረንገ ኦሪሸት እካበአ፤ መሰንትስ ከኒች ብሬ ጠዉ ጉዕሙንኩ ህጎኡ» ይተን ሞጮጬም።<note caller="-" style="x"><char style="xo" closed="false">21፥4 </char><char style="xt" closed="false"><ref loc="ISA 25:8">ኢሳ. 25፥8</ref>፤ <ref loc="ISA 35:10">35፥10</ref>፤ <ref loc="ISA 65:19">65፥19</ref>።</char></note><verse eid="REV 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5"/>ህከኒች ኤተሮን ኬዕምኝ ቦርጭመ አሌን አፉዕሌኢሁ «አን ጉዕመርቹንከ ሃዕሮ አኣም» ዬእ፤ ህትን እስን ኤሳሃ «ት ላገት አመዕነሞኢሃለከ ሀንቅ እኮቤቺሃ ከተብ» ዬኤ። <verse eid="REV 21:5"/><verse number="6" style="v" sid="REV 21:6"/>ህከኒች ኤተሮን «አበቀዕዮ፤ ብሬሁለከ ኤተሪሁ አኔት፤ ሰገቦስሀኒሃ ሄእ ዊ ቡቁተ ጠለዕል ዋግቤሉ ህትን ኣሳም።<note caller="-" style="x"><char style="xo" closed="false">21፥6 </char><char style="xt" closed="false"><ref loc="ISA 55:1">ኢሳ. 55፥1</ref>።</char></note> <verse eid="REV 21:6"/><verse number="7" style="v" sid="REV 21:7"/>ድለ አዕዮሁ ካን ረገአኖ፤ አንን መገኑሰ እሃም፤ እስን ቤቱኤ እሀኖ፤<note caller="-" style="x"><char style="xo" closed="false">21፥7 </char><char style="xt" closed="false"><ref loc="2SA 7:14">2 ሳሙ. 7፥14</ref>፤ <ref loc="PSA 89:26-27">መዝ. 89፥26-27</ref>።</char></note> <verse eid="REV 21:7"/><verse number="8" style="v" sid="REV 21:8"/>ጠዉ እኮጎሬ ዋጅታእሩ፥ አመዕነቱ ዮሰበእሩ፥ ንጃሶእሩ፥ ነብሳ ሽታእሩ፥ ዝነተ አታእሩ፥ ኪላኑት፥ ሽርክተ አታእሩ፥ ክዝበኛኑት ጉዕሙንኩ ወጡሰ ‹ዲን› ዬኖ ቡባ ጊረ ባር ኣዜን እሀኖ፤ ሁኩንን ለምቅተ ሬሁ» ዬኤ።<verse eid="REV 21:8"/></para>
  <para style="s1">ሃዕሮ ዬሩሳሌምተኔሃ</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9"/>ህከኒች ኤተሮን ኤተር ለመሉንኩ መገን በለት ዊንቶ ለመለ ጠበትተ አፎ ለመላንከ መላይካች መቱ አሜች «አም! ሆልች ምኒ አመተ እኮ እዜቹተ ለሊሳንኬ» የን ጠወዕዮ። <verse eid="REV 21:9"/><verse number="10" style="v" sid="REV 21:10"/>መገን አያኒን መቶ ሎረ ቆተ አል ፉሽ ጠሊለተ ዬሩሳሌም ከተንቹት መገን አዲች ሰሜች ድርተን ለልሾኤ፤<note caller="-" style="x"><char style="xo" closed="false">21፥10 </char><char style="xt" closed="false"><ref loc="EZK 40:2">ሕዝ. 40፥2</ref>።</char></note> <verse eid="REV 21:10"/><verse number="11" style="v" sid="REV 21:11"/>እሴን መገን ኬዕምኚን ለሊሳእት እቅ፤ ኑርሴ በለቁንኩ አበ ጤአተ እኮ ክንገ እያስጲድ ክንገ እክ ለአቃንችገ በለቀኖሃ እቅ። <verse eid="REV 21:11"/><verse number="12" style="v" sid="REV 21:12"/>ህከን ከተንቾሃ አበ ቄራዕሩት ግንብ ኦተትለከ ቶነ ለሙ ኡሩቲ ዮሴሃ እቅ፤ ህትን ቶነ ለሞሃንከ ኡሮን ቶነ ለሙ መላይከት ሄኦ እቅ፤ ህከን ኡሮ አሌንን ቶና ለሞሃንከ እስራኤል ዘሬ ሱዕሙ ከተበሞኡ እቅ፤ <verse eid="REV 21:12"/><verse number="13" style="v" sid="REV 21:13"/>ህትን ሸርቂን ሰስ ኡሩት ቅልቢን ሰስ ኡሩት ከኣጵን ሰስ ኡሩት ገርቢን ሰስ ኡሩት ሄኦ እቅ።<note caller="-" style="x"><char style="xo" closed="false">21፥12-13 </char><char style="xt" closed="false"><ref loc="EZK 48:30-35">ሕዝ. 48፥30-35</ref>።</char></note> <verse eid="REV 21:13"/><verse number="14" style="v" sid="REV 21:14"/>ህከን ከተም ግምብ ኦታተ ቶነ ለሙ ቀበቡ ሄዕዮስ እቅ፤ ህከን ቀበብ አሌን ሆልች ቶነ ለሞንከ አሳበ ሱዕሙ ከተበሞ እቅ። <verse eid="REV 21:14"/><verse number="15" style="v" sid="REV 21:15"/>ህከን ኤሳሃ ጠወዕዮ መላይኬቺ ከተመ፥ ከተምስ ኡሩተለከ ግንብ ኦተተ ብኬኖ ዎርቅ ቶሙ ሄዕዮስ እቅ።<note caller="-" style="x"><char style="xo" closed="false">21፥15 </char><char style="xt" closed="false"><ref loc="EZK 40:3">ሕዝ. 40፥3</ref>።</char></note> <verse eid="REV 21:15"/><verse number="16" style="v" sid="REV 21:16"/>ከተምቾስ ቅራዕርመሴለከ አልባዕልመሴ ቅጡ እክ ሾሉንኩ ሙረበሴ ቅጡሃን፤ መላይኬቹንኩ ከተመስ በርቲንከስ ብክሃን ቅራዕርመሴ ለም ኩምተ ሾል ጥቤ ኪሎ ሜትር<note caller="+" style="f"><char style="fqa" closed="false">2,400 ኪሎ ሜትር ጌሰ እኮ፦ </char><char style="ft" closed="false">የኖሁ ግርክ መጻፋን 12,000 እስታድየ የኖ፤ 1 እስታድየን 185 የኖሁ ከተበሞኡ።</char></note> ጌሰ እኮ፤ አልባዕልመስለከ ኡርሸሴ ህከን ጌሰ እኮ። <verse eid="REV 21:16"/><verse number="17" style="v" sid="REV 21:17"/>ህትን መላይኬቹ ከተምስ ግምብ ኦተተ ኡርሸሴ ብኬእ፤ መላይኬቹ መን አንጋን ቅጡ እኮ አንገስ ብክሃን መት ጥብታ ሸይልኔ ሾሉ አንገ ብኩተ እኮ፤ <verse eid="REV 21:17"/><verse number="18" style="v" sid="REV 21:18"/>ግምብስ ኦተት ኦተንቶኢሁ ኢያሰጲድ ክኒንት፤ ህት ከተንቹት ጡመ ለአቃንችገ ዮ ነጠ ዎርቂን እጃረንቶእተ እቅ።<note caller="-" style="x"><char style="xo" closed="false">21፥18-21 </char><char style="xt" closed="false"><ref loc="ISA 54:11-12">ኢሳ. 54፥11-12</ref>።</char></note> <verse eid="REV 21:18"/><verse number="19" style="v" sid="REV 21:19"/>ህከን ከተም ግምብ ኦተ ቀበቡ አደደ ጤአተ እኮ ክን ደኒን መክዮሃ እቅ፤ ዎኔ ቀበቡ ኢያሰጲድ ዬኖሃ ክኑ፤ ለምቂሁ ስንፔር ዬኖሃ ክኑ፤ ሰቂሁ ኬልቄዶን ዬኖ ክኑለከ ሾልቂሁ መርግድ የኖሃ ክኑ። <verse eid="REV 21:19"/><verse number="20" style="v" sid="REV 21:20"/>ኦንትቂሁ ሰርዶንክስ ዬኖሃ ክኑ፤ ሌህቂሁ «ሰርድዮን» ዬኖሃ ክኑ፤ ለመልቂሁ «ክርስቲሎቤ» ዬኖሃ ክኑ፤ ህዜትቂሁ «ቢረሌ» ዬኖሃ ክኑ፤ ሆንስቂሁ «ወራዉሬ» ዬኖሃ ክኑ፤ ቶንቂሁ «ክርስጵራስስ» ዬኖሃ ክኑ፤ ቶነ መትቂሁ «ያክንት» ዬኖሃ ክኑ፤ ቶነ ለምቂሁ «አሜቴስጢኖስ» ዬኖሃ ክኑ እቅ። <verse eid="REV 21:20"/><verse number="21" style="v" sid="REV 21:21"/>ሁኩ ቶነ ለሙንኩ ጡፉ ቶና ለሞ ደኒን እጃረሞሃ እቅ፤ መት-መቱስ ጡፉ መቴ ዕንቁን<note caller="+" style="f"><char style="fqa" closed="false">ዕንቁ፦ </char><char style="ft" closed="false">ዩ ባር ኣዜን ዮ ቡዳሜ ኣዜን ጨሌገ ዮኢሃ እክ ኣዜንከሴ አደደርቹ ዩንኩ ሽፋርገዮርቹ ኣግ ቀሰኖሴቤቺሃ ቀሰኖሴሃ ከዕምቶተ ይት አታእሃ ኮቡ።</char></note> መክዮእሃ እቅ፤ ከተምስ ዎቆ ለአቃንችገ ለሊሰኖ ነጠ ዎርቂን እጃረሞሃን እቅ።<verse eid="REV 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22"/>ጉዕመንከ አታለኖ ቀርቹ መገኑለከ ሆልቹ ህከን ከተማን መገን ምኒ እኮቤቺሃ ከተም ኣዜን ዎሉ መገን ምኒ ለዕዮምበአ። <verse eid="REV 21:22"/><verse number="23" style="v" sid="REV 21:23"/>ህከን ከተማን መገን ኬዕምኝ ኑሩ ለሊሰኖሰቤቺሃለከ ሆልቹ ገዉንኩስ ኑርሴ እኮቤቺሃ አሩ ህከረንገ አገንቹ ለልሶሴተ ሀስሰኖሴበአ።<note caller="-" style="x"><char style="xo" closed="false">21፥23 </char><char style="xt" closed="false"><ref loc="ISA 60:19-20">ኢሳ. 60፥19-20</ref>።</char></note> <verse eid="REV 21:23"/><verse number="24" style="v" sid="REV 21:24"/>ኡመቱንኩ ኑሪንከሴ ፈንቀላንታአ፤ ህትን ኡለ አል ዎመት ኬዕምኝሰ ከተም ኣዝ ኤባአ።<note caller="-" style="x"><char style="xo" closed="false">21፥24 </char><char style="xt" closed="false"><ref loc="ISA 60:3">ኢሳ. 60፥3</ref>።</char></note> <verse eid="REV 21:24"/><verse number="25" style="v" sid="REV 21:25"/>ህከን ከተማን ሀንከዕርት ዮበእቤቺሃ ኡራከሴ እኮስበርሃ ጡፈንታበአ። <verse eid="REV 21:25"/><verse number="26" style="v" sid="REV 21:26"/>ኡመት ዎመ ሎርመተለከ ኬዕምኝ እሴቤቹ ኤባአ።<note caller="-" style="x"><char style="xo" closed="false">21፥25-26 </char><char style="xt" closed="false"><ref loc="ISA 60:11">ኢሳ. 60፥11</ref>።</char></note> <verse eid="REV 21:26"/><verse number="27" style="v" sid="REV 21:27"/>ጠዉ እኮጎሬ ኮፍየኖርቹ እኮ ጠዉ ሆሮ እሴቤቹ ኣገኖበአ፤ ንጃስ አአኖሁለከ ክዝብ ጠወአኖ ሆሮ እሴቤቹ ኣገኖበአ፤ እሴቤቹ ኣጋሩ ሱዕሙሰ ሆልች ሄእ መጻፋን ከተበንቶእራን።<note caller="-" style="x"><char style="xo" closed="false">21፥27 </char><char style="xt" closed="false"><ref loc="ISA 52:1">ኢሳ. 52፥1</ref>፤ <ref loc="EZK 44:9">ሕዝ. 44፥9</ref>።</char></note><verse eid="REV 21:27"/></para>
  <chapter eid="REV 21"/>
  <chapter number="22" style="c" sid="REV 22"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1"/>ህከኒች ኤተሮን መላይኬቹ መገንለከ ሆልች ኬዕምኝ ቦርጭማች ፉለኖ ለአቃንችገ ለሊሰኖ ነጠ እኮ ሄእ ዉሁ ዛዘኖ ዋሃ ለልሾኤ።<note caller="-" style="x"><char style="xo" closed="false">22፥1 </char><char style="xt" closed="false"><ref loc="EZK 47:1">ሕዝ. 47፥1</ref>፤ <ref loc="ZEC 14:8">ዘካ. 14፥8</ref>።</char></note> <verse eid="REV 22:1"/><verse number="2" style="v" sid="REV 22:2"/>ሁኩ ዛዘኖ ውሁ ህከን ከተም ዎቃሃ ለሙበ አዕይ ህገኖ እቅ፤ ህከን ዛዘኖ ዊ መኬ አዲንለከ ጉረ አዲን አገናን አገናን ላለን ዘማኔን ቶነ ለሙ ወክት ላልቹ ላለኖ ሄእ ሀቁ ሄዕዮ እቅ፤ ህከን ሀቅች ኡመቱ ሀበረስ ፈይመተ ደኦተ ደግለሸቀመኖ እቅ።<note caller="-" style="x"><char style="xo" closed="false">22፥2 </char><char style="xt" closed="false"><ref loc="GEN 2:9">ክል. 2፥9</ref>፤ <ref loc="EZK 47:12">ሕዝ. 47፥12</ref>።</char></note> <verse eid="REV 22:2"/><verse number="3" style="v" sid="REV 22:3"/>ከኒች ኤተሮን ቦሮሩ ሆሮ ሄአኖበአ፤ ከተማንከስ መገንለከ ሆልች ኬዕምኝ ቦርጭመት ከተምስ ኣዜን እካአ፤ ካዲመስን ሰገዳስ።<note caller="-" style="x"><char style="xo" closed="false">22፥3 </char><char style="xt" closed="false"><ref loc="ZEC 14:11">ዘካ. 14፥11</ref>።</char></note> <verse eid="REV 22:3"/><verse number="4" style="v" sid="REV 22:4"/>እሰን ሚንስ ለኣአ፤ ህትን ሚኔንከሰን እስ ሱዕሙ ሄአኖ። <verse eid="REV 22:4"/><verse number="5" style="v" sid="REV 22:5"/>ከኒች ኤተሮን ሀንከዕርት ሆሮን ሄኣበአ፤ ቀርቹ መገኑ ለሊሰኖሰቤቺሃ ኩራዝ ህከረንገ አሪ ኑሩ ሆሮን ሀስሰኖሰበአ፤ እሰን ዘላለሚሃ ነገሳአ።<note caller="-" style="x"><char style="xo" closed="false">22፥5 </char><char style="xt" closed="false"><ref loc="ISA 60:19">ኢሳ. 60፥19</ref>፤ <ref loc="DAN 7:18">ዳን. 7፥18</ref>።</char></note><verse eid="REV 22:5"/></para>
  <para style="s1">ኢስ ፈንቀል አሜትስተኔሃ</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6"/>ህከኒች ኤተሮን መላይኬቹ «ኩ ላገት አመዕነንቶእተለከ ሀንቅታን፤ ነብያከተ ጠውሲሰኖ ቀርቹ ቀዎ ወክቴን እሀኖ ጠወ ካዲማተስ ለሊሶተ መገኑ መላይኬቹስ ሶኮኡ» ዬኤ።<verse eid="REV 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7"/>ኢስን «አን ደዕል አሜታም፤ ከን መጻፍ ራግ ላገተ አገረኖሁ ማሰአሞእሃን» ዬእ።<verse eid="REV 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8"/>አን ያህይ ገዉንኩእ ህከረ ለዕዮሚሁለከ ሞጮጬሚሁ፤ ህከ ጠወ ለዕዮምለከ ሞጮጬም ወክት ህካን ለሊሾኤ መላይኬቺሃ ሰገዶተ ሎከስ አሌን ኡቦም። <verse eid="REV 22:8"/><verse number="9" style="v" sid="REV 22:9"/>ጠዉ እኮጎሬ መላይኬቹ «አጉር! ካን አቶት፤ አን ኪን፥ አመክ ኦሶንለከ ነብያካን ሜጡበ ከን መጻፍ ላገታ አገርታ ነብያካን ሜጡበ ካድንቹሃን፤ አት መገኒሃ ሰገድ» ዬኤ። <verse eid="REV 22:9"/><verse number="10" style="v" sid="REV 22:10"/>ህትን እስን «ወክቱ ኢሌቤቺሃ ከን መጻፋን ዮ ራግ ላገተ ማተቢን ጡፎት። <verse eid="REV 22:10"/><verse number="11" style="v" sid="REV 22:11"/>ከኒች ኤተሮን ሂሉ ህልማንተስ ቀጠሉን፤ ንጃሾንኩ ንጃስ እሁን፤ ነጡንኩ ነጠ እሁን፤ ጠሊሉንኩ ጠሊለ እሁን» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">22፥11 </char><char style="xt" closed="false"><ref loc="DAN 12:10">ዳን. 12፥10</ref>።</char></note><verse eid="REV 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12"/>ህትን «አን ደዕል አሜታም! ጉዕሚንከስ ሆጎስ ጌሰ ኣሳም ዋገ አፎም፤<note caller="-" style="x"><char style="xo" closed="false">22፥12 </char><char style="xt" closed="false"><ref loc="ISA 40:10">ኢሳ. 40፥10</ref>፤ <ref loc="ISA 62:11">62፥11</ref>፤ <ref loc="PSA 28:4">መዝ. 28፥4</ref>፤ <ref loc="JER 17:10">ኤር. 17፥10</ref>።</char></note> <verse eid="REV 22:12"/><verse number="13" style="v" sid="REV 22:13"/>ብሬሁለከ ኤተሪሁ፥ ወዕኔሁለከ መጨረሺሁ አኔት» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">22፥13 </char><char style="xt" closed="false"><ref loc="REV 1:8">መና. 1፥8</ref>፤ <ref loc="REV 17">17</ref>፤ <ref loc="REV 2:8">2፥8</ref>፤ <ref loc="ISA 44:6">ኢሳ. 44፥6</ref>፤ <ref loc="ISA 48:12">48፥12</ref>።</char></note><verse eid="REV 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 22:14"/>ሄእ ሀቁቾች ላልቹ እትሃለከ ኡሮንከሴን ከተመ ኣጎተ መብቱ ሄኦሰተ ኦድኑሰ ሜጭቶእሩ ማሰአንቶእራን።<note caller="-" style="x"><char style="xo" closed="false">22፥14 </char><char style="xt" closed="false"><ref loc="GEN 2:9">ክል. 2፥9</ref>፤ <ref loc="GEN 3:22">3፥22</ref>።</char></note> <verse eid="REV 22:14"/><verse number="15" style="v" sid="REV 22:15"/>ጠዉ እኮጎሬ ዉሸገ ንጃስሳሩ፥ ሲረ አታእሩ፥ ዝነተ አታእሩ፥ ነብሳ ሽታእሩ፥ ሽርክተ አታእሩ፥ ክዝብ ኢትታእሩለከ ክዝብ ዎቄን መርታሩ ጉዕሙንኩ ከተሚች አብል እካአ።<verse eid="REV 22:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16"/>«አን ኢስ ከ ምስክርነቱ ኣሶህዕኔተ መላይከኤ አመዕናኖ ጭምት ዱእ ምናተ ሶኮም፤ አን ደዉዴ ጠጵሃለከ ዘሬሃን፤ ለሊሳ ሱጴ ቤዜት አኔት።»<note caller="-" style="x"><char style="xo" closed="false">22፥16 </char><char style="xt" closed="false"><ref loc="ISA 11:1">ኢሳ. 11፥1</ref>፤ <ref loc="ISA 10">10</ref>።</char></note><verse eid="REV 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17"/>ጠሊሉ አያኑለከ እዜቹንት «አም!» ይታአ፤ ህትን ሞጮጨኖንኩ «አም!» ዩን፤ ሰገቦንኩ አሜቱን፤ ሀሾንኩ ሄእ ዋሃ ዋግቤሉ ህትን አጉን።<note caller="-" style="x"><char style="xo" closed="false">22፥17 </char><char style="xt" closed="false"><ref loc="ISA 55:1">ኢሳ. 55፥1</ref>።</char></note><verse eid="REV 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18"/>ከን መጻፍ ኣዜን ከተበንቶ ራግ ላገተ ሞጮጨኖሀኒሃ ጉዕሚንከ ጠረኝሽ ኩላም፤ አዪሁ ከን ላገ አሌን መቱርቹ በርጌጎሬ መጻፋን ከተበንቶ በለተ መገኑ አሌስ በርገኖስ። <verse eid="REV 22:18"/><verse number="19" style="v" sid="REV 22:19"/>አዪሁ ከን ራግ መጻፋን ከተበንቶ ላጋች መቱርቹ ጤዕይሾጎር ከን መጻፋን ኩለሞ ሄእ ሀቅ ላልቺች ጠሊለ ከተንቾች መገኑ ወጥስ ጤዕይሰኖ።<note caller="-" style="x"><char style="xo" closed="false">22፥19 </char><char style="xt" closed="false"><ref loc="DEU 4:2">ዘዳ. 4፥2</ref>፤ <ref loc="DEU 12:32">12፥32</ref>።</char></note><verse eid="REV 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20"/>ከን ጉዕመርቺንከ ምስክር እኮሁ «ሀንቅንከ ደዕል አሜታም» የኖ።</para>
  <para style="p" vid="REV 22:20">ኣሚዕን! ቀርቾ ኢሰ አም።<verse eid="REV 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21"/>ቀርቾ ኢስ ኣስቱት ጉዕሚንከክዕኔ<note caller="+" style="f"><char style="fqa" closed="false">ጉዕሚንከክዕኔ፦ </char><char style="ft" closed="false">የኖሁ መት-መቱ ሉህ ኪታበት «ጉዕሚችን» ይተን ዎሉሰንገ «መገን ኡመቲች» ይታአ፤ «መገን ኡመቲች ጉዕሚችን» ይታእሩ ዮኡ።</char></note> ሜጡበ እሁን፤ ኣሚዕን።<verse eid="REV 22:21"/></para>
  <chapter eid="REV 22"/>
</usx>
