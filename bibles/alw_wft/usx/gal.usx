<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- HALABA NEW TESTAMENT</book>
  <para style="h">ገለትይ</para>
  <para style="toc1">ጳዉሎስ ገላትያ መኒሃ ከተቦ ሶህኑተ</para>
  <para style="toc2">ገላትያ</para>
  <para style="toc3">ገላ.</para>
  <para style="mt1">ጳዉሎስ ገላትይ መኒሃ</para>
  <para style="mt2">ከተቦ ሶህኑተ</para>
  <para style="imt1">ኣጉስ</para>
  <para style="ip">ኢስ ጡምስተኔሃ ጠወአኖ እንጂል ላገት ጉዕመ ቤቾን ዱዱብሰንተን አይሁደ እህቡ መኑ ቶገንስ መርቶ ጌሰ «አመዕናኑተ እኮተ ሙስ ሕገ አኡ ሀስሰኖንዶ ሀስሰኖበአ?» ይታ ጠዕምቱት ኬኦኡ፤ ቀቅቾ እስያን ሮም ገሾን እኮእ ገላቲያን ሄኣ አመዕናኖ በላን «መኑ መገን ብሬን ፈየ እሄን ጠለዕል ኢሳን አመዕኑ እሁዕነ ሙሲ አዲን ኣሰሞ ሕገ አኡ ሀስሰኖ» ይተን ጳዉሎሴ ግባ መኑ ሄኦ እቅ።</para>
  <para style="ip">ጳዉሎስ ካን ገላትያ መኒሃ ከተቦሁ ከን ትምርቴን ጉረተ ኣጎሰ መነ ጌጥዬ አመዕነት ዎቃሃ አዎንሲሃት፤ ጳዉሎስ መሲህ ኢስ አሳቤቹ እሁስ ተሬገጭ ጀመረኖ፤ አሳቤቹ እሆተ ገኤሲሁ መገን ቤሉ መነ እሁ ሆጉስለከ እስ ሶቀሙ አይሁደ እህበ መኒሃ እሁስ ሂር ኩለኖ፤ መጨረሽ ፎሎጭ ኣዜን አመዕነት ዎቆሁ ኢሳን አመዕኒን ደገመኖ ኢታች ቡቀኖሃ እሁስ ኩለኖ።</para>
  <para style="iot">መጻፉስ አፎሃ</para>
  <para style="io1">ኣጉስ <char style="ior">(<ref loc="GAL 1:1-10">1፥1-10</ref>)</char></para>
  <para style="io1">ጳዉሎሴ አሳቤቹ እህስ ሹምነቱ <char style="ior">(<ref loc="GAL 1:11-2:21">1፥11—2፥21</ref>)</char></para>
  <para style="io1">መገን ኣስቶ እንጂለ <char style="ior">(<ref loc="GAL 3:1-4:31">3፥1—4፥31</ref>)</char></para>
  <para style="io1">አመዕነቲን ነጠ ፉሉለከ ሹምነቱ <char style="ior">(<ref loc="GAL 5:1-6:10">5፥1—6፥10</ref>)</char></para>
  <para style="io1">መጨረሸስ <char style="ior">(<ref loc="GAL 6:11-18">6፥11-18</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="GAL 1"/>
  <para style="p">
    <verse number="1-2" style="v" sid="GAL 1:1-2"/>አን አሳቤቹ ጳዉሎስለከ ኢን ሜጡበ ዮ አመዕናኑተ ጉዕመንከ አመኦሱት ገለትይ ባዶን ዮ አመዕናኑተ ሶንኮምሃን፤ አን አሳቤቹ እኮም መኒች ህከረንገ መን አዲን እሁዕነ መሲህ ኢሲንለከ ኢሰ ሬሆች ኬሾ አነ መገኒንት።<verse eid="GAL 1:1-2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3"/>አናኔ መገን አዲችለከ ቀርቾ መሲህ ኢሲች ኣስቱትለከ ወገሬቱሁ ክዕኔሃ እሁን።<verse eid="GAL 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 1:4"/>ኢስን ከን ሂለ ዘማኒች ፌሶኔተ አናኔ መገን ሰውቲን ጩብሀኔ ገዉስ ህግሽ ኣሴእ። <verse eid="GAL 1:4"/><verse number="5" style="v" sid="GAL 1:5"/>ዘላለሚሃ መገኒሃ ኬዕምኙ እሁንስ! ኣሚዕን።<verse eid="GAL 1:5"/></para>
  <para style="s1">ሀንቅ እንጂሉ ሜጡ እሁስ</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6"/>መሲህ ኣስቶን ገኤህዕኔ መገን አዲች ደዕልቴን አደ እኬን ዎሎ ተሽት ላገቤቹ ፈንቀሉክዕኔ አጀብሲሰኖኤ። <verse eid="GAL 1:6"/><verse number="7" style="v" sid="GAL 1:7"/>ህካን ያሚሁ ጉረተ ኣግሶተለከ መሲህ እንጂል ላገተ ሾክሶተ ሀሳ መት-መቱ መኑ ዮቤቺሃት ቤሉ ዎሉ እንጂል ላገት ዮቤቺሃበአ። <verse eid="GAL 1:7"/><verse number="8" style="v" sid="GAL 1:8"/>ጠዉ እኮጎሬ ዎዕነ ዱዱብስኖንክዕኔ እንጂል ላጋን ቶቀምባሃ ዎሉ ነኡ እንኮምዕቃ ሰሜ መላይከት እኮ እቃ ዱዱብስቶህዕኔጎሬ ቦሮረንቶኢሃ እኩን። <verse eid="GAL 1:8"/><verse number="9" style="v" sid="GAL 1:9"/>ወዕናሃ ይኖንክዕኔገ አኒሁ ቴሁ ያንክዕኔ፤ አዪሁ አዕኑ ቶጌንተ እንጂል ላጋ ቤሉ ዎሉ ቶቀምባ እንጂል ላገተ ዱዱብሴህዕኔጎሬ ቦሮረሞኢሃ እሁን።<verse eid="GAL 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10"/>ህከረ አን ሀሳሚሁ መኑ ገለትጮኤታትንዶ? ህከረንገ መገኑ ገለትጮኤታት? ህከረንገ አን መነ ሙንዲሲሶተ ሀሳሚት? ቴሶ ኢለ መነ ሙንዲሲሶተ ሀሾም እቃን መሲህ ካዲንቹ እሆተ አታላምበአ እቅ።<verse eid="GAL 1:10"/></para>
  <para style="s1">ጳዉሎስ ገአሞሁ መገን አዲች እሁስ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11"/>አመኤ ኦሶ! አን ዱዱብሴንክዕኔ እንጂል ላገት መኒች እሁ ሆጉሴ ደጎኖተ ሀሳም። <verse eid="GAL 1:11"/><verse number="12" style="v" sid="GAL 1:12"/>መሰንትስ ህካን ኤሳሃ ደግስሾኤሁ መሲህ ኢሳት ቤሉ አን ቶጎሚሁ መኒችበአ፤ ህከረንገ መኑ ተማርስዮኤበአ።<verse eid="GAL 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13"/>ወዕና አይሁድ አመዕነቶን ዮም ወክት ሀት ዮም ጎሬ ሞጮጭቴንታአ፤ አመዕናኑተ ሸረን ቤሶተ አጰማሚት እቅ።<note caller="-" style="x"><char style="xo" closed="false">1፥13 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ሶቀ. 8፥3</ref>፤ <ref loc="ACT 22:4-5">22፥4-5</ref>፤ <ref loc="ACT 26:9-11">26፥9-11</ref>።</char></note> <verse eid="GAL 1:13"/><verse number="14" style="v" sid="GAL 1:14"/>አይሁድ አመዕነቱ አገሪን ዘሬኤ በሊች ኢ ደረቦች ጉዕሚችን በተኣምየ እቅ፤ ህትን አናከኤ ሴረ በአኖበእገ ጠረኝሽ ሀሳም እቅ።<note caller="-" style="x"><char style="xo" closed="false">1፥14 </char><char style="xt" closed="false"><ref loc="ACT 22:3">ሶቀ. 22፥3</ref>።</char></note> <verse eid="GAL 1:14"/><verse number="15" style="v" sid="GAL 1:15"/>ጠዉ እኮጎሬ እለሙዕነ ሄጭ መገኑ መጠሮኤ፤ ኣስቶንከስ ገኤኤ። <verse eid="GAL 1:15"/><verse number="16" style="v" sid="GAL 1:16"/>አይሁደ እህበ መኒሃ ቤትስተኔሃ ተሽት ላገተ ዱዱብሶተ መገኑ ቤቱስ ለሊሶኤተ ኢቴ ወክት አን አዬኒ አማዕለሞምበአ።<note caller="-" style="x"><char style="xo" closed="false">1፥15-16 </char><char style="xt" closed="false"><ref loc="ACT 9:3-6">ሶቀ. 9፥3-6</ref>፤ <ref loc="ACT 22:6-10">22፥6-10</ref>፤ <ref loc="ACT 26:13-18">26፥13-18</ref>።</char></note> <verse eid="GAL 1:16"/><verse number="17" style="v" sid="GAL 1:17"/>ህትን ኢች ብርተ አሳበተ እኮሀኑኡቤቹ ደቀሞተ ዬሩሳሌም ከተመ መሮምበአ፤ ጠዉ እኮጎሬ ሄጭ አረብ ባዱ መሮም፤ ህከኒች ኤተሮን ደማስቆ ከተመ ፈንቀሎም። <verse eid="GAL 1:17"/><verse number="18" style="v" sid="GAL 1:18"/>ሰሶ ዘማኒች ኤተሮን ኬፋ ዬኖ ጴጥሮሴ ለኦተ ዬሩሳሌመ ኦሮዕይ እሲን ሜጡበ ቶነ ኦንቱ በር ዱንኬም።<note caller="-" style="x"><char style="xo" closed="false">1፥18 </char><char style="xt" closed="false"><ref loc="ACT 9:26-30">ሶቀ. 9፥26-30</ref>።</char></note> <verse eid="GAL 1:18"/><verse number="19" style="v" sid="GAL 1:19"/>ጠዉ እኮጎሬ ቀርቾ ኢስ አመቤቲ ያቁብ ቤሉ አሳባች ዎሉ መቱሃ ለዕዮምበአ።<verse eid="GAL 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 1:20"/>ኩ ከተቦንክዕኔሁ ክዝብ እሁ ሆጉስ መገን ብሬን ተሬገጭ ኩላንክዕኔ።<verse eid="GAL 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21"/>ህከኒች ኤተሮን ሶርይለከ ክልቅይ ባዱ ኦሮዕዮም። <verse eid="GAL 1:21"/><verse number="22" style="v" sid="GAL 1:22"/>ይሁድ ባዶን ዮ አመዕናኑት ሚንተ ሚኔን ለአቀንት ከሰበአ። <verse eid="GAL 1:22"/><verse number="23" style="v" sid="GAL 1:23"/>ጠዉ እኮጎሬ እሰ «ወዕና ኔሳሃ ኦርሰኖኔ መንቹ ወዕና ቤሶተ አጰመን ሄዕዮ አመዕነቱ ገዉንኩስ ዱዱብሰኖት» ዬኖሃ ሞጮጭቶ እቅ። <verse eid="GAL 1:23"/><verse number="24" style="v" sid="GAL 1:24"/>ኢ መሳን መገኑ ገለትጭታኢት እቅ።<verse eid="GAL 1:24"/></para>
  <chapter eid="GAL 1"/>
  <chapter number="2" style="c" sid="GAL 2"/>
  <para style="s1">ጳዉሎስ አሳቤቹ እሁስ ዎሎ አሳበቤቾን ደገሙስ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1"/>ቶነ ሾሎ ዘማኒች ኤተሮን በርናባሴን ሜጡበ ዬሩሳሌመ ፈንቀል ኦሮዕዮም፤ ቲቶ ኢን ሜጡበ አእ መሮም እቅ።<note caller="-" style="x"><char style="xo" closed="false">2፥1 </char><char style="xt" closed="false"><ref loc="ACT 11:30">ሶቀ. 11፥30</ref>፤ <ref loc="ACT 15:2">15፥2</ref>።</char></note> <verse eid="GAL 2:1"/><verse number="2" style="v" sid="GAL 2:2"/>ህከ ቤቹ መሮሚንኩ መገኑ ለልሾኤ አዲንት፤ አን ከኒች ብርተ አዕዮም ሆጉትለከ ቴሁ አኣሚሁ ህትን ተሰ እሀኖበእገ ይ አይሁደ እህበ መን በላን ዱዱብሴም እንጂል ላገተ ሎርሎረ አዎንሳኖተ አደ አዕይ ኩሎንሰ። <verse eid="GAL 2:2"/><verse number="3" style="v" sid="GAL 2:3"/>ኢን ሜጡበ ሄዕዮ ቲቱ ግሪክ ባድ መንቹ እኮጎሬሁ ጡርከመሞተ ግድሴማስበአ። <verse eid="GAL 2:3"/><verse number="4" style="v" sid="GAL 2:4"/>ጠዉ እኮጎሬ በላንከኔ ሉኩት ማጠንት ኣጎ መት-መቱ ክዝብ አመዕናኑት ቲቱ ጡርከመሞተ ሀሶ እቅ፤ ሁኩ መናከት ዳንድቶተ ኣዝኔ ማጠንት ኣጎኢሁ መሲህ ኢሲን ደዕኖም ሰዎልድመተ ወልቅስ ሮሶማን ፈንቀሽቶተ ሰውይቲት። <verse eid="GAL 2:4"/><verse number="5" style="v" sid="GAL 2:5"/>እኮጎሬ ነኡ ተሽት ላገ ሀንቅ ክዕኔቤቾን ጠረኝት ሄኦተ ቀዎ ጌሲሃ ህከኑኡሃ ቄለሞምበአ።<verse eid="GAL 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6"/>መገኑ መን ሚንተ ለዕይ ሀዕለኖበእቤቺሃ ሁኩ አዎንሳኑተ እኮእሩ መ መነሃ እኮጎሬ ኤሳሃ ግዱ ዮኤበአ፤ እሰ አን ዱዱብሴም ተሽት ላገ አሌን መቱ ሃዕሮርቹሃ በርግቶበአ።<note caller="-" style="x"><char style="xo" closed="false">2፥6 </char><char style="xt" closed="false"><ref loc="DEU 10:17">ዘዳ. 10፥17</ref>።</char></note> <verse eid="GAL 2:6"/><verse number="7" style="v" sid="GAL 2:7"/>ጠዉ እኮጎሬ ህከን ወጥ ጴጥሮስ ተሽት ላገተ አይሁዲሃ ዱዱብሶተ ኤገት ኣሰሞስ ሃሌን ኤሳሃ አይሁደ እህበ መኒሃ ተሽት ላገተ ዱዱብሶተ ኤገት ኣሰንቶኤገ አጥራመቶኡ። <verse eid="GAL 2:7"/><verse number="8" style="v" sid="GAL 2:8"/>መሰንትስ ጴጥሮሴ አይሁድ መኒሃ አሳቤቹ አዕዮ መገኑ ኤሳሁ አይሁደ እህበ መኒሃ አሳቤቹ አዕዮኤ። <verse eid="GAL 2:8"/><verse number="9" style="v" sid="GAL 2:9"/>ቱቅገ እክ ለልታ አሳበት ያቁብ፥ ጴጥሮስለከ ያህይ መገኑ አዕዮኤ ኣስቱተ ደጎ ወክት ነኡ አይሁደ እኮበእ መንቤቹ መርኖተ እሰ አይሁዲቤቹ መርቶተ አማዕለንት ኤሳለከ በርናባሴ ሜጡበ እህኔ መላተ እሆተ መኬ አንጋን ዚያርቶኔ። <verse eid="GAL 2:9"/><verse number="10" style="v" sid="GAL 2:10"/>መቱ ጠወ አዕኖተ ሀስ ጠረኝሶኔ ጠዉ በለሰ ዮ ቡጥቻኑተ ሰውይኖተ ኤገተ ኣቶኔ፤ ሁኩንን አን አኦተ ኢትዮምየ ጠወ።<verse eid="GAL 2:10"/></para>
  <para style="s1">ጳዉሎስ አንጾካን ጴጥሮሴ ግቡስ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11"/>ጴጥሮስ ሶርያን ዮ አንጾክ ከተመ አሜቾ ወክት ቤሾቤቺሃ ብሬስ አቶንቲሁ ሀንቅያበአ ይዮንስ። <verse eid="GAL 2:11"/><verse number="12" style="v" sid="GAL 2:12"/>ያቁብ ሶኮሰ መት-መቱ መኑ አንጾክ ከተመ አሜቶተ ብርተ አይሁደ እህበ መኒን ሜጡበ እተኖት እቅ፤ እሰ አሜቶች ኤተሮን «አይሁደ እህቡ መን አዲች አመዕንቶእሩ ጡርከመሙ ሀስሰኖሰ» ይታ አይሁድ አመዕናኑተ ዋጅት ኤተሩ ዋልት አይሁደ እህበ መኒች አደ እኮ። <verse eid="GAL 2:12"/><verse number="13" style="v" sid="GAL 2:13"/>አይሁድ አዲች እኮ አመዕናኑት ጴጥሮሴ ሉሰተ አዎንቶኡ፤ ሁኩን ዎሉ ፈቃን በርናባሴሃ ጣንስዮ እቅ። <verse eid="GAL 2:13"/><verse number="14" style="v" sid="GAL 2:14"/>ጠዉ እኮጎሬ እሰገ ተሽት ላገ ሀንቂን ሄኡ ሆጉሰ ለዕዮም ወክት ጉዕማንከ መን ብሬን ጴጥሮሴ «አት አይሁዳውቹ እከን አይሁድ ሴሪን እሁዕነ አይሁደ እህበ መን ሴሪን ሄኣንቲት፤ ህከረ አይሁደ እህቡ መኑ አይሁድ ሴሪን ሄኦተ ሀት ግዳጅሳንትሳት?» ይዮንስ።<verse eid="GAL 2:14"/></para>
  <para style="s1">አይሁደ እኮሁለከ እህቡ መኑ ጡመኖሁ አመዕነቲን እሁስ</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15"/>ነኡ እለንሹኔ አይሁዳ ቤሉ ጩበኛ አይሁደ እህቡሃ መነበአ። <verse eid="GAL 2:15"/><verse number="16" style="v" sid="GAL 2:16"/>ጠዉ እኮጎሬ መኑ ፈየ እሀኖሁ መሲህ ኢሳን አመዕኒንት ቤሉ ሕገ አገሪን እሁ ሆጉስ ደንጋም፤ ነኡ ሕገ አገሪን እሁዕነ መሲሁ አመዕኒን ፈየ እንኮተ መሲህ ኢሳን አመዕንኖም፤ አዪሁ ተዉራት ሕገ አገሪን ፈየ እሀኖበአ።<note caller="-" style="x"><char style="xo" closed="false">2፥16 </char><char style="xt" closed="false"><ref loc="PSA 143:2">መዝ. 143፥2</ref>፤ ሮሜ 3፥20፥22።</char></note> <verse eid="GAL 2:16"/><verse number="17" style="v" sid="GAL 2:17"/>መሲሂን አመዕኒን ፈየ እንኮተ ሀሱኔ ነኡ ገዉንኩኔ ጩበኛኑተ እሁኔ ለሊሰኖ፤ ህከረ ጩብ አዕኖተ አአኖኔሁ መሲሁት ዩሃንዶ? ሆሮን ህትጎተበአ። <verse eid="GAL 2:17"/><verse number="18" style="v" sid="GAL 2:18"/>አን ገዉንኩኤ ድጄም ሕገ ፈንቀሽ መክሳሚሃ እኮምጎሬ አን ገውንኩኤ ሕገ አገርባሃ እሁኤ ተሬገጥሲሳሚት ዩሃን። <verse eid="GAL 2:18"/><verse number="19" style="v" sid="GAL 2:19"/>አን መሲህን ሜጡበ ሰቀለሞምገ ዎለአሞምቤቺሃ መገኒሃ ሄኦተ ይ ሕግ ሬሆን መለዕለም ጌሰ ሕጊች አደ እኮም። <verse eid="GAL 2:19"/><verse number="20" style="v" sid="GAL 2:20"/>ከኒች ኤተሮን መሲሁ ኢ ኣዜን ሄአኖ ቤሉ አን ገዪሀኤ ሄኣምያበአ፤ ቴሁ ጅስሚን ሄኣሚሁ ኢቴኤለከ ኢተኔሃ ገዉስ ህግሽ ኣሴ መገን ቤቶን አመዕኒን ደገመኖ ሄእኒት። <verse eid="GAL 2:20"/><verse number="21" style="v" sid="GAL 2:21"/>ህካን እኮቤቺሃ መገን ኣስቱተ ተሰ ቤሳምበአ፤ መኑ ፈየ እሀኖሁ ሕገ አገሪን እኮች መሲሁ ከልበንከ ሬዮኡ ዩሃን።<verse eid="GAL 2:21"/></para>
  <chapter eid="GAL 2"/>
  <chapter number="3" style="c" sid="GAL 3"/>
  <para style="s1">መኑ ፈየ እሀኖሁ መሲህን አመዕኒን እሁስ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1"/>አዕኑ ኩ ገዋኑት ገለትይ ባድ መኑ! አዬት ሲረ አዕይ ሉስሾህዕኔሁ? መሲህ ኢስ መስቀል አሌን ሰቀለም ብሬንከክዕኔ ዮሀንገ ኩለሞህዕኔ እቅ። <verse eid="GAL 3:1"/><verse number="2" style="v" sid="GAL 3:2"/>ክዕኔች ደጎተ ሀሳሚሁ ጠለዕል መቱ ጠወዪት፤ ጠሊለ አያነ ቶጌንታሁ ሕገ አገርኒትንዶ ህከረንገ ተሽት ላገተ ሞጮጭቴን አመዕንኒት? <verse eid="GAL 3:2"/><verse number="3" style="v" sid="GAL 3:3"/>አዕኑ መገን አያኒን ጀመርቴን ቴሱ ገይክዕኔ ዎልቃን ሹልቶኖተ ሀሴነንታት፤ አደ ኬንከ ኢለ ገዋኖተ! <verse eid="GAL 3:3"/><verse number="4" style="v" sid="GAL 3:4"/>እንጂል መሳን ቶጌንተ ኦርሸት ጉዕሙንኩ ተሰ እክ ፈቆ ዩሃን? ህካን አቴንተጎሬ ሀንቅንከ ተሰ እክ ፈቆኡ። <verse eid="GAL 3:4"/><verse number="5" style="v" sid="GAL 3:5"/>መገኑ ጠሊለ አያነ ኣሰኖህዕኔሁለከ በላንከክዕኔ አጀብሲሰኖ ጠወ አአኖሁ ሕገ አገርቴንተቤቺሃትንዶ? ህከረንገ ተሽት ላገተ ሞጮጭቴን አመዕንቴንተቤቺሃት?<verse eid="GAL 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6"/>«እብራሂም መገኖን አመዕኔእ፤ ህከ አመዕነትስ መሳን መገኑ ፈየ አዕይ ዎለዕዮስ» የመም ከተበሞጋት።<note caller="-" style="x"><char style="xo" closed="false">3፥6 </char><char style="xt" closed="false"><ref loc="GEN 15:6">ክል. 15፥6</ref>፤ <ref loc="ROM 4:3">ሮሜ 4፥3</ref>።</char></note> <verse eid="GAL 3:6"/><verse number="7" style="v" sid="GAL 3:7"/>ህካን እኮች አመዕንታእሩ እብራሂም እለተ እሁሰ ደጌ።<note caller="-" style="x"><char style="xo" closed="false">3፥7 </char><char style="xt" closed="false"><ref loc="ROM 4:16">ሮሜ 4፥16</ref>።</char></note> <verse eid="GAL 3:7"/><verse number="8" style="v" sid="GAL 3:8"/>መገኑ አይሁደ እኮበእ መነ አመዕነቲን ፈያኑተ አአኖገ ጠሊሉ መጻፉ ወዕናንከ «ኡመቱ ጉዕሙንኩ ኪን ማሰአመኖ» ይ ሄጭ እብራሂሚሃ ተሽት ላገተ ኩሎስ።<note caller="-" style="x"><char style="xo" closed="false">3፥8 </char><char style="xt" closed="false"><ref loc="GEN 12:3">ክል. 12፥3</ref>።</char></note> <verse eid="GAL 3:8"/><verse number="9" style="v" sid="GAL 3:9"/>ህካን እኮቤቺሃ አመዕንታሩ ጉዕሙንኩ አመዕኔ እብራሂሚን ማሰአንቶእራን።<verse eid="GAL 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10"/>«ሙስ ሕግ መጻፋን ከተበሞ ትዛዝ ጉዕመንከ ጠረኝ አገርባሁለከ ሄእባሁ ጉዕሙንኩ ቦሮረሞእሃን» የመም ከተበሞቤቺሃ «ሕገ አገሪን ፈያኑተ እንካም» ይታእሩ ጉዕሙንኩ ቦሮረንቶእራን።<note caller="-" style="x"><char style="xo" closed="false">3፥10 </char><char style="xt" closed="false"><ref loc="DEU 7:26">ዘዳ. 7፥26</ref>።</char></note> <verse eid="GAL 3:10"/><verse number="11" style="v" sid="GAL 3:11"/>«ፈዩ መንቹ አመዕነቲን ሄኡ ደአኖ» የመም ከተበሞቤቺሃ አዪሁ ሕገ አገሪን መገን ብሬን ፈየ እሀኖበኢሃ እሁስ ለልዮእሃን።<note caller="-" style="x"><char style="xo" closed="false">3፥11 </char><char style="xt" closed="false"><ref loc="HAB 2:4">ዕን. 2፥4</ref>።</char></note> <verse eid="GAL 3:11"/><verse number="12" style="v" sid="GAL 3:12"/>ሕጉ አመዕነት አሌን ኡርዮእሃበአ፤ መሰንትስ «መንቹ ሕጋን ሄኦተ አታለኖሁ ሕግ ትዛዝ ጉዕመንከ አገረኖራት» የመም ከተበሞኡ።<note caller="-" style="x"><char style="xo" closed="false">3፥12 </char><char style="xt" closed="false"><ref loc="LEV 18:5">ሌዌ 18፥5</ref>።</char></note><verse eid="GAL 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13"/>«ሀቅ አሌን ሰቀለም ሬሀኖሁ ጉዕሙንኩ ቦሮረሞእሃን» የመም ከተበሞቤቺሃ መሲህ ኒተኔሃ ቦሮረሞ መንቹ እክ ሕጊን አሜተኖ ቦሮሪች ዎዦኔ።<note caller="-" style="x"><char style="xo" closed="false">3፥13 </char><char style="xt" closed="false"><ref loc="DEU 21:23">ዘዳ. 21፥23</ref>።</char></note> <verse eid="GAL 3:13"/><verse number="14" style="v" sid="GAL 3:14"/>ሁኩን እኮሁ መገኑ እብራሂሚሃ ኣሴ በረከተ መሲህ ኢስ አዲን አይሁደ እህቡ መኒሃ ኢሎተለከ ነኡን መገኑ ኣሳንክዕኔ ዬ ጠሊለ አያነ አመዕነቲን ቶንጎታት።<verse eid="GAL 3:14"/></para>
  <para style="s1">ሕጉ ተብሴ ላገተ ሻርባሃ እሁስ</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15"/>አመኤ ኦሶ! ህንዴ ከ ጠወ መንቤቾን ሮሰሞ ጠዊን ሜጡበ ለዕዬ፤ መቱ መንቹ ኣጎ ወኣድ ላገተ ቶጌማች ኤተሮን አዪሁ ቤሶተ ህከረንገ በርጎተ አታለኖበአ። <verse eid="GAL 3:15"/><verse number="16" style="v" sid="GAL 3:16"/>መገኑ እብራሂሚሃለከ እስ ዘሬተ ልግብ ተብሴ ላገተ ኣሴኢሁ ከን ሃሊንት፤ ተብሴ ላገት ልግብ እኮገ አዕይ «ዘሬተክዕኔ» የኖበአ፤ ጠዉ እኮጎሬ መቲሃ እኮገ አዕይ «ዘሬተክ» የኖ፤ ሁኩን «ዘርክ» የመሞሁ መሲህት።<note caller="-" style="x"><char style="xo" closed="false">3፥16 </char><char style="xt" closed="false"><ref loc="GEN 12:7">ክል. 12፥7</ref>።</char></note> <verse eid="GAL 3:16"/><verse number="17" style="v" sid="GAL 3:17"/>አን ያሚሁ ከኒት፤ ተብሶሁ እብራሂሚሃ ኣሰሞች ሾል ጥብተ ሰጆ ዘመኒች ኤተሮን ኣሰሞ ሕጉ ዎዕናሃ መገኑ ተሬገጭ ኣሴ ወኣድ ላገተ ሻር ተብሴ ላገተ ቤሶተ አታለኖበአ።<note caller="-" style="x"><char style="xo" closed="false">3፥17 </char><char style="xt" closed="false"><ref loc="EXO 12:40">ፉል. 12፥40</ref>።</char></note> <verse eid="GAL 3:17"/><verse number="18" style="v" sid="GAL 3:18"/>መቱርቹ ረገኤኖሁ ሕግ መሳን እኮ እቃ ተብሴ ላጋን እሁስ ፈቀኖ እቅ፤ ጠዉ እኮጎሬ መገኑ ረግተ እብራሂሚሃ ኣሴኢሁ ተብሴ ላጋኒት።<note caller="-" style="x"><char style="xo" closed="false">3፥18 </char><char style="xt" closed="false"><ref loc="ROM 4:14">ሮሜ 4፥14</ref>።</char></note><verse eid="GAL 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19"/>ህከረ ሕጉ ኣሰሞሁ ሚሃት? ሕጉ በርገሞሁ እብራሂሚሃ ተብሴን ኣሰሞ መት ዘርት አሜቶተ ኢለ ኒ ጩቢች ኬዕይት፤ ሴሩንኩ መላይከ አዲን መንለከ መገን በላን ሄዕዮ መንቺሃ ኣሰሞ። <verse eid="GAL 3:19"/><verse number="20" style="v" sid="GAL 3:20"/>እሁን ቤሉ በላን እክ ሀራርሰኖ መንቹ ለሞ አዲንካት ቤሉ ጠለዕል መቶ አዲሃበአ፤ እኮጎሬ መገኑ ሜጥቹሃን።<verse eid="GAL 3:20"/></para>
  <para style="s1">ሕጉ ሚሃ ኣሰሞ</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21"/>ህከረ ሕጉ መገን ተብሴ ላገተ ግበኖንዶ? ሆሮ ግበኖበአ! ሄኡ ደገመኖ ሕጉ ኣሰሞ እቃኔተ ፈየ እሁ ሕግ አዲን ደገመኖ እቅ። <verse eid="GAL 3:21"/><verse number="22" style="v" sid="GAL 3:22"/>ጠዉ እኮጎሬ መሲህ ኢስን አመዕኒን ደገመኖ ተብሴ ላገት አመዕንታሀኑኡተ ኣሰንቶተ ጠሊሉ መጻፉ የኖ ሃሊን ኣዱንያ አሉ ጉዕሙንኩ ጩቢሃ ጠገንት ጩብ ኡሱረኘ እኮኡ።<verse eid="GAL 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23"/>አመዕነቱ አሜቱዕናን ብርተ ሕጉ ጠቅዮኔ እቅ፤ ሁኩንን አመዕነቱ ለሎተ ኢለ ሕጉ ጡፍ አፎኔ እቅ። <verse eid="GAL 3:23"/><verse number="24" style="v" sid="GAL 3:24"/>ከን ሃሊን አመዕነቲን ፈየ እንኮተ መሲህ አሜቶተ ኢለ ሕጉ አገራንቹኔ እኮ እቅ። <verse eid="GAL 3:24"/><verse number="25" style="v" sid="GAL 3:25"/>እኮጎሬ ቴሱ አመዕነቱ አሜቾቤቺሃ ሕጉ አገራንቹኔ እሁስ ፈቆኡ።<verse eid="GAL 3:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26"/>መሲህ ኢሳን አመዕኒን ጉዕሙንኩክዕኔ መገንተ እለ፤ <verse eid="GAL 3:26"/><verse number="27" style="v" sid="GAL 3:27"/>ጠመቀንቴን መሲሂን ሜጡበ እኬንተሩ ጉዕሙንኩ መሲህ ኦድኖገ ኦደኤንታአ። <verse eid="GAL 3:27"/><verse number="28" style="v" sid="GAL 3:28"/>ጉዕሙንኩክዕኔ መሲህ ኢሲን ሜጡ እኬንተቤቺሃ አይሁድችለከ ግርክቺ፥ ሮስችለከ ሰዎልድቺ፥ ጎንለከ ሜንት በላን አደዶመት ዮበአ። <verse eid="GAL 3:28"/><verse number="29" style="v" sid="GAL 3:29"/>አዕኑ መሲህረ እኬንታች እብራሂምተ ዘር፤ ተብሴስ ላገ መሳን ረገኣኑታን።<note caller="-" style="x"><char style="xo" closed="false">3፥29 </char><char style="xt" closed="false"><ref loc="ROM 4:13">ሮሜ 4፥13</ref>።</char></note><verse eid="GAL 3:29"/></para>
  <chapter eid="GAL 3"/>
  <chapter number="4" style="c" sid="GAL 4"/>
  <para style="s1">መገን ኦሱተ እህኔተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1"/>ቴሁ ያሚሁ ከኒት፤ ረገአኖሁ ቀዉ ጩል እሀኖ ወክት ዱንያተስ ጉዕሚንከ ቀርቹ እኮ እቃ መቶርቺንከስ ሮስቺች አደ እሀኖበአ። <verse eid="GAL 4:1"/><verse number="2" style="v" sid="GAL 4:2"/>ጠዉ እኮጎሬ አኑስ ቀደሮ ወክቱ ኢሎተ ኢለ አገርታሀኑኡለከ ኤገተ ኣሴመ መን አንጋን አገረኖ። <verse eid="GAL 4:2"/><verse number="3" style="v" sid="GAL 4:3"/>ህትን ነኡ አያን ጠዊሃ ጩለገ ዮም ወክት ከን ኣዱንያ አሌን ዮ ሴሪሃ ጠገም ሮስ እንኮም እቅ። <verse eid="GAL 4:3"/><verse number="4" style="v" sid="GAL 4:4"/>ጠዉ እኮጎሬ ቀደሮ ዘማኑ ኢሌ ወክት መገኑ ቤቱስ ሶኮኔ፤ እስ ሕጊች ዎሮን እክ መንቾች እለሞ፤ <verse eid="GAL 4:4"/><verse number="5" style="v" sid="GAL 4:5"/>ህካን አዕዮሁ ሕግ ኣዜን ዮእረ ዎዞተለከ ነኡን መገን እለተ እንካምገ አኦታት።<note caller="-" style="x"><char style="xo" closed="false">4፥5-7 </char><char style="xt" closed="false"><ref loc="ROM 8:15-17">ሮሜ 8፥15-17</ref>።</char></note><verse eid="GAL 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 4:6"/>መገን እለተ እኬንተቤቺሃ መገኑ «አበ» የን ገአኖ ቤትስ አያነ ቀልቢሃኔ ሶኮ። <verse eid="GAL 4:6"/><verse number="7" style="v" sid="GAL 4:7"/>ህካን እኮቤቺሃ ከኒች ኤተሮን ቤቱሃን ቤሉ ሮስሃበአ፤ ቤቱስ እኮንቲች መገኑ ረገኣንቹ አዕዮሄ።<verse eid="GAL 4:7"/></para>
  <para style="s1">ጳዉሎስ ገላትየ ባድ መኒሃ ዮስ ጭንቀተ</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8"/>ከኒች ብርተ መገኑ ደጉ ሆግክዕኔ መሳን ክልቀቲንከሰ መገኑ እኮበእሀኑኡተ ሮስ እኬን ጠገንቴንታ እቅ። <verse eid="GAL 4:8"/><verse number="9" style="v" sid="GAL 4:9"/>እኮጎሬ ቴሱ መገኑ ደጌንታአ፤ በትሽን መገኑ ክዕኔተ ደገኖህዕኔ፤ ህከረ ሀት ላፋለከ ሂለ ኣዱንያ አል ሴርቤቹ ፈንቀልቴን? ሀት ለንኪሃ እሰ ሮስ እኮኖተ ሀሴነንታት? <verse eid="GAL 4:9"/><verse number="10" style="v" sid="GAL 4:10"/>አዕኑ በሪሃ፥ አገኒሃ፥ ወክቲሃለከ ዘማኒሃ ጠረኝሴን አበ ኬዕምኝ ኣቴነንታት። <verse eid="GAL 4:10"/><verse number="11" style="v" sid="GAL 4:11"/>ክዕኔ በላን ሆጎን ሆጎሚሁ ጉዕሙንኩ ተሰ እክ ፈቀኖ ይ ዋጃም።<verse eid="GAL 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12"/>አመኤ ኦሶ! አን ክዕኔገ እኮምቤቺሃ አዕኑሁ ኢገ እኬ ይ ኡጫንክዕኔ፤ አዕኑ መቱ ብድልሃ ኢልሴንታኤበአ። <verse eid="GAL 4:12"/><verse number="13" style="v" sid="GAL 4:13"/>ዎዕኔ ወክት ተሽት ላገተ ክዕኔሃ ዱዱብሶተ እድል ደኤሚሁ ጥዘነ መሳን እሁስ ደጌነንተ። <verse eid="GAL 4:13"/><verse number="14" style="v" sid="GAL 4:14"/>ሄንከ ጥዘነኤ ፌተነተ እኮህዕኔጎሬ ህንቄንታኤበአ ህከረንገ ሽግግ ይቴንታኤበአ፤ በትሽን መገን መላይኬቹ ቶጌነንተሀኒገ አቴን ቶጌንታኤ፤ ህትን መሲህ ኢሰ ቶጌነንተሀኒገ አቴን ቶጌንተኤ። <verse eid="GAL 4:14"/><verse number="15" style="v" sid="GAL 4:15"/>ከኒች ዎዕናሃ ሄኦህዕኔ ሙንዲኑት ሀከቤቹ መርቶኡ? አታልሲሾህዕኔ እቃ እልክዕኔ ፉሽቴን ኣቴነንተኤገ አን ገዉንኩእ መሰከራም። <verse eid="GAL 4:15"/><verse number="16" style="v" sid="GAL 4:16"/>ህከረ ቴሱ ሀንቅ ኩሎንክዕኔቤቺሃ ዲነክዕኔ እኮምንዶ?<verse eid="GAL 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17"/>ዎሉ መኑ ክዕኔተኔሃ ጨነቀንት ሰውይታኢት፤ እሁን ቤሉ ህካን አታኢሁ ጡመ ጠዊሃበአ፤ እሰ ሃሽኣቱት አዕኑ ኒች አደ እኮኖታትለከ እሰተኔሃ አበ ሰውይቶኖታት። <verse eid="GAL 4:17"/><verse number="18" style="v" sid="GAL 4:18"/>ሰውቱሰ ጡመ እኮች ጠረኙ ጉዕመ ወክት ጡመሃን፤ ጠዉ እኮጎሬ ኩ ጠረኝመክዕኔ አን ክዕኔን ሜጡበ ሄኣም ወክት ጠለዕል እሁንከ። <verse eid="GAL 4:18"/><verse number="19" style="v" sid="GAL 4:19"/>ኢ ኦሶ! መሲህ ክዕኔ ኣዜን ለሎተ ኢለ ቴሁ ክዕኔተኔሃ ኒጠን አበ ጨነቀማሚት። <verse eid="GAL 4:19"/><verse number="20" style="v" sid="GAL 4:20"/>ክዕኔሃ መ አኡ ሀሲሰኖኤጎሬ ደጉ ሆግንከኤ ጉረተ ኣጋዕኔ አበ ጨነቀሞም፤ ቴሱ በላንከክዕኔ ደገም አደደ አፎን ጠወዕዮም እቃ ሄንከ ኢታም እቅ።<verse eid="GAL 4:20"/></para>
  <para style="s1">አጋረለከ ሣራ ምሳልተ</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21"/>አዕኑ ሕጊሃ ጠገንቴን ሄኢሃ ሀሴነንተሩ ህንዴ ኩሌኤ፤ ሕጉ የኖሃ ሞጮጭቴነንተበእንዶ? <verse eid="GAL 4:21"/><verse number="22" style="v" sid="GAL 4:22"/>ጠሊለ መጻፋን «እብራሂሚሃ ለም እለት ሄኦስ እቅ፤ መቱስ እለሞሁ ሮስቾ መንቾች እሀን ዎሉስንገ ሰዎልድቾ መንቾቺት» የመም ከተበሞኡ። <verse eid="GAL 4:22"/><verse number="23" style="v" sid="GAL 4:23"/>ሮስቾ መንቾ ቤቱ እለሞሁ ማል ሄዕላቸገ እሀን ሰዎልድቾ መንቾ ቤቱ እለሞሁ ኣሰንቶ ተብሴ ላጋኒት። <verse eid="GAL 4:23"/><verse number="24" style="v" sid="GAL 4:24"/>ኩ ለሙ ሜንቱ ለሞ ወኣድ ላገተ ለሊሰኖቤቺሃ ኩን ምሳሌገ ለለኖሃን፤ መትሴ ወኣድ ላገተ ሲና ዬኖ ቆታች እከን ሮሶማተ እካ እለተ እልታእታን፤ እሴን አጋራት፤<note caller="-" style="x"><char style="xo" closed="false">4፥22 </char><char style="xt" closed="false"><ref loc="GEN 16:15">ክል. 16፥15</ref>፤ <ref loc="GEN 21:2">21፥2</ref>።</char></note> <verse eid="GAL 4:24"/><verse number="25" style="v" sid="GAL 4:25"/>አጋር አረብ ባዶን ዮ ሲና ቆተተ ምሳልተ እቅ፤ ህካን እኮቤቺሃ ቴሱ ዮ ዬሩሳሌሚን አጉጠንታአ፤ እሴን እላንተሴን ሮሶማን ሄኣእታን። <verse eid="GAL 4:25"/><verse number="26" style="v" sid="GAL 4:26"/>አሊች ሰሜች እኮእ ዬሩሳሌሙ ሰዎልድቾታን፤ እሴን አመተኔ።<verse eid="GAL 4:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="GAL 4:27"/>«አት ጎደቡ ዮሄበኢት ተሽ ዩንኬ!</para>
  <para style="q2" vid="GAL 4:27">አት እልቶተ ኒጥ ከሲባት ‹እልል!› ይ፤</para>
  <para style="q1" vid="GAL 4:27">ምኒ አኑ ዮሴ መንቾች በትሽ</para>
  <para style="q2" vid="GAL 4:27">ምንሴ አኑ አጉራንሴ ዮ መንቾተ ልግብ እለት ዮሴ» የመም ከተበሞኡ።<note caller="-" style="x"><char style="xo" closed="false">4፥27 </char><char style="xt" closed="false"><ref loc="ISA 54:1">ኢሳ. 54፥1</ref>።</char></note><verse eid="GAL 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28"/>አመኤ ኦሶ! አዕኑ ቴሱ ኢሳቅገ ተብሴ ላገተ እለ። <verse eid="GAL 4:28"/><verse number="29" style="v" sid="GAL 4:29"/>ጠዉ እኮጎሬ ህከ ወክት ማሊን እለሞሁ ጠሊለ አያኒን እለሞሃ ሸሬገን ከበሪሁ ህትዪንት።<note caller="-" style="x"><char style="xo" closed="false">4፥29 </char><char style="xt" closed="false"><ref loc="GEN 21:9">ክል. 21፥9</ref>።</char></note> <verse eid="GAL 4:29"/><verse number="30" style="v" sid="GAL 4:30"/>ጠዉ እኮጎሬ ጠሊሉ መጻፉ የኖሁ መርቾሃን? ጠሊሉ መጻፉ «ሮስቹት መንቹት እልቶ ጩሉ ሰዎልድቹት እልቶሀኒን ሜጡበ ረገአኖበእቤቺሃ ሮስቹተ ጩሊንከሴን ሜጡበ ሸር» የኖ።<note caller="-" style="x"><char style="xo" closed="false">4፥30 </char><char style="xt" closed="false"><ref loc="GEN 21:10">ክል. 21፥10</ref>።</char></note> <verse eid="GAL 4:30"/><verse number="31" style="v" sid="GAL 4:31"/>ህካን እኮቤቺሃ አመኤ ኦሶ! ነኡ ሰዎልድቾተ እለ ቤሉ ሮስቾተ እለበአ።<verse eid="GAL 4:31"/></para>
  <chapter eid="GAL 4"/>
  <chapter number="5" style="c" sid="GAL 5"/>
  <para style="s1">መሲህን ደገንታ ሰዎልድመተ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1"/>መሲህ ሰዎልድማን ፉሼኔሁ ሰዎልድማን ሄዕኖታት። ህካን እኮቤቺሃ ጠረኝቴን ኡርዬ ቤሉ ለንኪሃ ፈንቀልቴን ሮስ እኬን ጠገንቶኖቼ።<verse eid="GAL 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2"/>ቴሱ አን ጳዉሎስ ያንክዕኔሁ ጡርከመንቴንተ ጎሬ መሲህ መቱርቹሃ ደግለለኖህዕኔበአ፤ <verse eid="GAL 5:2"/><verse number="3" style="v" sid="GAL 5:3"/>ጡርከመመኖሁ ጉዕሙንኩ «ሕገ ጉዕመንከ አኦተ ግዳጁ ዮስ» ይ ለንኪሃ ጠረኝሳም። <verse eid="GAL 5:3"/><verse number="4" style="v" sid="GAL 5:4"/>አዕኑ ሕገ አገርቴነን ፈይቶኖተ ሀሴነንተሩ ጉዕሙንኩ መሲህች አደ እኬንታአ፤ መገን ኣስቶችስ ፉልቴንታአ። <verse eid="GAL 5:4"/><verse number="5" style="v" sid="GAL 5:5"/>ጠዉ እኮጎሬ ነኡ መገን አያኒን ፈይመ ተብሳሃ አመዕነቲን አገዕሪናም። <verse eid="GAL 5:5"/><verse number="6" style="v" sid="GAL 5:6"/>መሲህ ኢሲን ሄኤማች ጡርከመሙ ህከረንገ ጡርከመሙ ሆጉ ደግለለኖበአ፤ ደግለለኖሁ ኢታን ለለኖሃ አመዕነቱ።<verse eid="GAL 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7"/>አመዕነቲን ጡመገ ሃንቴነንታት እቅ፤ ቴሱ ሀንቂሃ አዘዘንቴንበገ ከሞህዕኔሁ አዬት? <verse eid="GAL 5:7"/><verse number="8" style="v" sid="GAL 5:8"/>ህትኔ ሸዘነት ገኤህዕኔ መገኒች አሜቶበእተ። <verse eid="GAL 5:8"/><verse number="9" style="v" sid="GAL 5:9"/>ቀቅቹ ራጭቱ ቡኩተ ጉዕመንከ አቦከኖ።<note caller="-" style="x"><char style="xo" closed="false">5፥9 </char><char style="xt" closed="false"><ref loc="1CO 5:6">1 ቆሮ. 5፥6</ref>።</char></note> <verse eid="GAL 5:9"/><verse number="10" style="v" sid="GAL 5:10"/>ጠዉ እኮጎሬ ከኒች አደ እኮ ዎሉ ሰውቱ ሄአኖህዕኔበእገ ተሬገጭ ቀርቾን አመዕናም፤ ጉረተ ኣግሰኖህዕኔሁ አዪሁ ፍርደስ ኣአኖ።<verse eid="GAL 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11"/>አመኤ ኦሶ! አን ቴሱ ኢለ ዱዱብሰን «ጡሚሃ ጡርከመሙ ሀስሰኖ» ይዮም እቃ ቴሱ ኢለ ሚሃ ሸርታኤ እቅ? ህካን እኮእቀ መሲህ መስቀሉ መኒሃ ጉፉተ እሀኖበ እቅ። <verse eid="GAL 5:11"/><verse number="12" style="v" sid="GAL 5:12"/>ህካን እኮቤቺሃ ኩ ጉረተ ኣግሳህዕኔ መናከት ሀሶ ጎሬ ጡርከመሙ ጠለዕለ እሁዕነ ገዉንኩሰ ፎልሰ ኡለተ ቃርቶ እቃ ኢታም እቅ።<verse eid="GAL 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13"/>አመኤ ኦሶ! አዕኑ ሰዎልድማሃ ገአንቴንታአ፤ ጠዉ እኮጎሬ መት-መቱስ ኢታን ካደሙን ቤሉ ኩ ሰዎልድመክዕኔ ማል ሃሽኣቱተ አቴነንተ መሰተ እሁንከ። <verse eid="GAL 5:13"/><verse number="14" style="v" sid="GAL 5:14"/>ሕጉ ጉዕሙንኩ «ዎሉ መነ ገይክገ አት ኢት» የኖ መቴ ላጋን ጎፎኡ።<note caller="-" style="x"><char style="xo" closed="false">5፥14 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ሌዌ 19፥18</ref>።</char></note> <verse eid="GAL 5:14"/><verse number="15" style="v" sid="GAL 5:15"/>ጠዉ እኮጎሬ ገገዉክዕኔ ገዕመቀንቴነንለከ እተቀንቴነን በኤነንተበእገ አገዕርዬ።<verse eid="GAL 5:15"/></para>
  <para style="s1">ጠሊለ አያንለከ ማል ሰውት ሄኡ</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16"/>ቴሱ ጠሊለ አያነ አዎንቴን ሄኤንተ ጎሬ ማል ሃሽኣቱተ አቴነንተበአ ያም። <verse eid="GAL 5:16"/><verse number="17" style="v" sid="GAL 5:17"/>ማል ሃሽኣቱት ጠሊለ አያን ሃሽኣቶን ቶቃቀንታበአ፤ ህትን ጠሊለ አያን ሃሽኣቱት ማል ሃሽኣቶን ቶቃቀንታበአ፤ ጠሊለ አያን ሃሽኣቱትለከ ማል ሃሽኣቱት ገገዪሀሰ ባለጋረተ፤ ህካን እኮቤቺሃ አዕኑ ሀሴንተርቹ አቶኖተ አታልቴነንተበአ።<note caller="-" style="x"><char style="xo" closed="false">5፥17 </char><char style="xt" closed="false"><ref loc="ROM 7:15-23">ሮሜ 7፥15-23</ref>።</char></note> <verse eid="GAL 5:17"/><verse number="18" style="v" sid="GAL 5:18"/>ጠሊለ አያነ አዎንቴንተጎሬ ሕጊሃ ጠገንቴነንተበአ።<verse eid="GAL 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19"/>ማል ሃሽኣቱት ደገንቶእራን፤ እሰን ዝነተ፥ ሂለ ንጃስ አኡ፥ ገዉ አገዕሩ ሆጉ <verse eid="GAL 5:19"/><verse number="20" style="v" sid="GAL 5:20"/>ሽርክተ አኡ፥ ኪሉ፥ ዲኖመተ፥ ኦደተ፥ አቄሸተ፥ ኡሙዕርተ፥ ገዉ ኢቱ፥ አደዶመተ፥ አድመ አኡ፥ <verse eid="GAL 5:20"/><verse number="21" style="v" sid="GAL 5:21"/>ምቀኞመተ፥ ሰከሩ፥ መጠረቁ ዮበእ ሙንዲኑተ አጉዳእራን፤ ከኒች ዎዕናንከ ጠረኝሽ ኩሎምገን ቴሁ በርግ ጠረኝሽ ኩላንክዕኔ፤ ህትኔ ጠወ አታ መናከት መገን ዎምነቱ ኣጋበአ።<verse eid="GAL 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22"/>ጠዉ እኮጎሬ ጠሊለ አያን ላልቹ ኢተተ፥ ሙንዲኑተ፥ ወገሬት፥ አደብ፥ ጡምመተ፥ ጡመ ጠወ አኡ፥ አመዕነሙ <verse eid="GAL 5:22"/><verse number="23" style="v" sid="GAL 5:23"/>ጎደበ ላፋለከ ገዉ አገዕሩሃን፤ ህትኔ ጠወ ግበኖ ሕጉ ዮበአ፤ <verse eid="GAL 5:23"/><verse number="24" style="v" sid="GAL 5:24"/>መሲህ ኢስረ እኮእሩ ማለሰ ሄዕላቻንተስለከ ሃሽኣቶንከስን መስቀላን ሰቀልቶኡ። <verse eid="GAL 5:24"/><verse number="25" style="v" sid="GAL 5:25"/>ጠሊለ አያኒን ሄዕናሚሃ እንኮሚች ጠሊለ አያነ አዎኖ። <verse eid="GAL 5:25"/><verse number="26" style="v" sid="GAL 5:26"/>መቱ ዎሉ ሂለ ጠዊሃ ኬሰንሰን ገገዉንኩኔ ምቀኝነን ተሳን ቦኑንከ።<verse eid="GAL 5:26"/></para>
  <chapter eid="GAL 5"/>
  <chapter number="6" style="c" sid="GAL 6"/>
  <para style="s1">ገገዉክዕኔ ሀዕላቀሙ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1"/>አመኤ ኦሶ! መቱ መንቹ ጩብ አዕይ ደገሞጎሬ አመዕነቲን ጠረኛኑተ እኬንተሩ ህትኔ መንቹ ጎደበ ላፍማን ብዝ አዕዬስ፤ ጠዉ እኮጎሬ አቲሁ ህትኔ ፌተናን አጋንትበእገ አገዕር። <verse eid="GAL 6:1"/><verse number="2" style="v" sid="GAL 6:2"/>ክዕኔች መት-መቱክዕኔ ዎልስ ኬዕምታ እጅነተ እጁን፤ ከን ሃሌን መሲህ ሕገ ዊንሽቴነንተ።<note caller="+" style="f"><char style="fqa" closed="false">ዊንሽቴነንተ፦ </char><char style="ft" closed="false">መት-መቱ እንክሌመ ክታበት «አዕዬ» ይታአ።</char></note> <verse eid="GAL 6:2"/><verse number="3" style="v" sid="GAL 6:3"/>አዪሁ ዎሎ መኒች ቆሀኖርቹ ዮስበኢንከ «አን ዎሎ መኒች በተኣም» ይ ሰውዬጎሬ ገዉስ ጣንሰኖት። <verse eid="GAL 6:3"/><verse number="4" style="v" sid="GAL 6:4"/>ጠዉ እኮጎሬ ገገዉንኩስ ገይስ ሆጉተ መረመር ለኡን፤ ህከኒች ኤተሮን ገዉስ ዎሎ መኒን ሜዛኝ እሁዕነ ጠለዕል ገይሃስ ድከአኖርቹ ደአኖ። <verse eid="GAL 6:4"/><verse number="5" style="v" sid="GAL 6:5"/>መሰንትስ ገገዉንኩስ ገይስ እጅነተ እጁ ሀስሰኖ።<verse eid="GAL 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6"/>ላገስ ተማረኖ መንቹ አስተማርቺንከስን ሜጡበ ጡመርቹ ጉዕመንከ ቤቀሙን።<verse eid="GAL 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7"/>ገዉክዕኔ ሉሲሶኖቼ፤ መኑ ምደኖሁ ዉጮሃት፤ አዪሁ መገኖን ቀለዶተ አታለኖበአ፤ <verse eid="GAL 6:7"/><verse number="8" style="v" sid="GAL 6:8"/>ማለ ሙንዲሲሶተ ዉጠኖሁ ማሊችስ ሬሁተ ምደኖ፤ ጠሊለ አያነ ሙንዲሲሶተ ዉጠኖሁ ጠሊለ አያኒች ዘላለም ሄኡ ምደኖ። <verse eid="GAL 6:8"/><verse number="9" style="v" sid="GAL 6:9"/>ተብሳ ሙርንባች ወክቱ ኢሌሃን ዉጠተ ጭምአዕናምቤቺሃ ጡመ ሆጉተ አኡ አጉርኑንከ። <verse eid="GAL 6:9"/><verse number="10" style="v" sid="GAL 6:10"/>ቴሱ ጡሙ ወክቱ ዮኔቤቺሃ መኒሃ ጉዕሚንከ በትንስ አመዕንቶ መኒሃ ጡመ ጠወ አዕኖ።<verse eid="GAL 6:10"/></para>
  <para style="s1">ጎፍሜ ሸዘነተለከ ወገሬት</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11"/>ሀትኔ ሎርሎረ ፍደሊን ገይኤ አንጋን ከተቦንክዕኔገ ለዕዬ! <verse eid="GAL 6:11"/><verse number="12" style="v" sid="GAL 6:12"/>ጡርከመንቶኖተ ግደጅሳእሩ አብሊን ጡመ አጉድ ለሊሃ ሀሳእተ መናከ፤ ህካን አታኢሁ መሲህ መስቀል መሳን ሸረንታበእገ ሰውይቲት። <verse eid="GAL 6:12"/><verse number="13" style="v" sid="GAL 6:13"/>እሰ ጡርከመንቶኖተ ሀሳኢሁ ጡርከመምንከክዕኔ ቦንቶታት ቤሉ ጡርከመንቶሩ ገዉንኩሰ ሕገ አገርቶበአ። <verse eid="GAL 6:13"/><verse number="14" style="v" sid="GAL 6:14"/>ቀርቹሃኔ መሲህ ኢስ መስቀል ቤሉ ዎሎርቾን ድከኡ ኢች ቄዕሩን፤ ከን መስቀል መሳን ኣዱንያ አሉ አደ እኮኡ፤ አኒሁ ኣዱንያ አሊች አደ እኮም። <verse eid="GAL 6:14"/><verse number="15" style="v" sid="GAL 6:15"/>ህካን እኮቤቺሃ ጡርከመሙ እኮ ጡርከመሙ ሆጉ መቱርቹሃ ደግለለኖበአ፤ ደግለለኖሁ ሃዕሮ ክልቀት እሆሃን። <verse eid="GAL 6:15"/><verse number="16" style="v" sid="GAL 6:16"/>ከ ትዛዝ አዎነኖሀኒሃ ጉዕሚንከለከ መገን ዎገነ እኮ ሀንቅ እስራኤሊሃ ወገሬቱለከ ማርቱት እኩን።<verse eid="GAL 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17"/>ጅስምኤ አሌን ዮ ገረፌመኤ መላት ኢስ ካዲንቹ እሁኤ ለሊሰኖቤቺሃ ከኒች ኤተሮን አዪሁ ኦርሱንከኤ።<verse eid="GAL 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18"/>አመኤ ኦሶ! ቀርችኔ መሲህ ኢስ ኣስቱት ክዕኔን ሜጡበ እኩን! ኣሚዕን።<verse eid="GAL 6:18"/></para>
  <chapter eid="GAL 6"/>
</usx>
