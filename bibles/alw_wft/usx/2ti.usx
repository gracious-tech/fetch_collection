<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- HALABA NEW TESTAMENT</book>
  <para style="h">ለንክ ጢሞትዎስ</para>
  <para style="toc1">ጳዉሎስ ጢሞትዎሴሃ ከተቦ ለንክ ሶህኑተ</para>
  <para style="toc2">ለንክ ጢሞትዎስ</para>
  <para style="toc3">2 ጢሞ.</para>
  <para style="mt1">ጳዉሎስ ጢሞትዎሴሃ</para>
  <para style="mt2">ከተቦ ሶህኑተ</para>
  <para style="imt1">ኣጉስ</para>
  <para style="ip">ጳዉሎስ ጥማቶሴሃ ከተቦሁ ኩን ለንክተ ሶህኑ፤ ጰውሎሴሃ ሆጎስ ጃለ እኮ ዎደልቺሃ ጢማቶሴ ሸዜመስ ሸዘነተ አፎእሃን፤ ጠረኝሽ ሸዦሲሁ አታዕሊን ሄኦታት፤ ጢማቶስ ሸዘነለከ ጠረኝሳ ላገተ ደኤኢሁ መሲህ ኢስተኔሃ አመዕነሺን ዱዱብሶተ፥ ተሽት ላገተለከ ኑባቾ ወኣድ ትምህተ ጠረኝሽ አፎተለከ ኦርሸት በተኦስጎሬ ተማርሶንለከ እንጅለ ዱዱብሰኖ ሆጎንተስ አጰሞታት እቅ።</para>
  <para style="ip">ጢማቶስ በትሽ አገዕሮተ ኣሰሞሲሁ ገዊማን አአኖ ጠለዕላን ኦደሚች ቄዕሮታት እቅ፤ ህት እኮ ጠዉ ሞጮጭቶኢሃ ቤስ ቤሉ ዎሉ ደግለለኖርቹ ዮስባአ።</para>
  <para style="ip">ከን ጉዕማንን ጢሞትዮስ ሰዉ ዩ ሀስሰኖሲሁ ጳዉሎሴ ሄኡለከ ሄእስ አለማተ በትሽ አመዕነቱስ፥ አደብስ፥ ኢተስ፥ ጠረኝመስለከ ቶቸሚን እልቶስ ኦርሸተ ምሳሌን አዎኖታት።</para>
  <para style="iot">መጻፉስ አፎሃ</para>
  <para style="io1">ኣጉስ <char style="ior">(<ref loc="2TI 1:1-2">1፥1-2</ref>)</char></para>
  <para style="io1">ጢማቶሴ ኣሰንቶ ሸዘነተ <char style="ior">(<ref loc="2TI 1:3-2:13">1፥3—2፥13</ref>)</char></para>
  <para style="io1">አመዕነሜን ሄኡ <char style="ior">(<ref loc="2TI 2:14-4:5">2፥14—4፥5</ref>)</char></para>
  <para style="io1">ወክትስ ሄዕዮ ሃለትለከ ሀሲሰኖ መመረ <char style="ior">(<ref loc="2TI 4:6-18">4፥6-18</ref>)</char></para>
  <para style="io1">መጨረሸስ <char style="ior">(<ref loc="2TI 4:19-22">4፥19-22</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="2TI 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1"/>መሲህ ኢስን ደገሞ ሄእ ተብሴ መሳን መገን ሰውቲን መሲህ ኢስሃ አሳቤቹ እኮም ጳዉሎሴች ሶሃሞእሃን፤ <verse eid="2TI 1:1"/><verse number="2" style="v" sid="2TI 1:2"/>ጠረኝሽ ኢታም ቤቲሃኤ ጢማቶሴሃ ሶሄማእተ ሶህኑ፤</para>
  <para style="p" vid="2TI 1:2">አናኔ መገን አዲች ቀርቹሃኔ መሲህ ኢሲች ኣስቱት፥ ማርቱትለከ ወገሬቱሁ ኬሳሃ እሁን።<note caller="-" style="x"><char style="xo" closed="false">1፥2 </char><char style="xt" closed="false"><ref loc="ACT 16:1">ሶቀ. 16፥1</ref>።</char></note><verse eid="2TI 1:2"/></para>
  <para style="s1">ጥማቶሴ ኣሰንቶ ሸዘነተ</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3"/>ጉዕመ ወክት ሀንከዕርተለከ በራሃ ኬሳሃ ዱኢን ሰዉ ያም ወክት አናኑኤ አቶገን አን ነጠ ቀልቢን ካደማም መገኑኤ ገለትጫም። <verse eid="2TI 1:3"/><verse number="4" style="v" sid="2TI 1:4"/>ህትን ኢንጂጀክ ሰውየን ኬሳሃ ለዕይ አበ ሙንደኦተ ሃሸኣም። <verse eid="2TI 1:4"/><verse number="5" style="v" sid="2TI 1:5"/>ህትን ኪን ዮ ሀንቅ አመዕነቱ ሰውያሚት፤ ሁኩ አመዕነቱንኩ ሄጭ አበመክ ሎይድኒለከ አመክ ኤዉንቄኒ ዮሃ እቅ፤ ኪን ሁኩ አመዕነቱ ዮገ ደጎም።<note caller="-" style="x"><char style="xo" closed="false">1፥5 </char><char style="xt" closed="false"><ref loc="ACT 16:1">ሶቀ. 16፥1</ref>።</char></note> <verse eid="2TI 1:5"/><verse number="6" style="v" sid="2TI 1:6"/>ህካን እኮቤቺሃ አንገእ አሌክ አዕዮም ወክት ኪ ኣዜን ዮ ኣሰሞሄ መገን ኣስቱተ ቴሁ ኬሰንስቶተ ቃግሳንኬት። <verse eid="2TI 1:6"/><verse number="7" style="v" sid="2TI 1:7"/>መሰንትስ መገኑ ወልቀተ፥ ኢቱለከ ገዉ አገዕር አያን ቤሉ ዋጄኖ አያነ ኣስዮኔበአ።<verse eid="2TI 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8"/>ቴሱ ቀርችሃኔ ዱዱብሱ ሙልቶት፤ እስተኔሃ ኡሱረሞም ኢን ሙልቶት፤ ጠዉ እኮጎሬ መገኑ ኣሰኖ ወልቃን እንጂልተኔሃ ኢን ሜጡባ ኦርሸተ ቶግ። <verse eid="2TI 1:8"/><verse number="9" style="v" sid="2TI 1:9"/>ህትን ነኡ አዕኖም ጡመ ሆጎገ እሁዕነ ገይስ ሃሽኣቶንለከ ኣስቶ ጠሊልማን ገእ ፌሾኔ፤ ጠሊልማንተ ገኤኔ፤ ከ ኣስቱንተ ዘመኒች ብርተ መሲህ ኢስ መሳን ኣሴኔ። <verse eid="2TI 1:9"/><verse number="10" style="v" sid="2TI 1:10"/>ሁኩ ኣስቱንት ፌሳንቹኔ መሲህ ኢሲ አሜቲንከስ ቴሱ ለሌእ፤ እስን ሬሁተ ቤሽ እንጂል ላገ አዲን ሬሁ ዮበኢሃ ዘላለሚሃ ጉዕሚንከ ሄዕናም ሄኡ ለሊሾኔ።<verse eid="2TI 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11"/>አን ህከን እንጂል ላገ ዱዱብሳንቹ፥ አሳቤቹለከ አስተማርቹ እክ ሾመሞም።<note caller="-" style="x"><char style="xo" closed="false">1፥11 </char><char style="xt" closed="false"><ref loc="1TI 2:7">1 ጢሞ. 2፥7</ref>።</char></note> <verse eid="2TI 1:11"/><verse number="12" style="v" sid="2TI 1:12"/>ከ ኦርሸተ ቶጋሚሁ ከኒሃት፤ ጠዉ እኮጎሬ አዬ አመዕኔም ጎሬ ደጋምቤቺሃ ሙላምበአ፤ ህትን አን እሲሃ ኣሴም ኤገተ ሁኩ በሩ ኢሎተ ኢለ አገሩ አታለኖገ አመዕናም። <verse eid="2TI 1:12"/><verse number="13" style="v" sid="2TI 1:13"/>አት መሲህ ኢሳን ዮ አመዕነቲንለከ ኢታን ኢች ሞጮጭቶንት አመዕነንቶ ላገተ ምሳልተ አት አገር። <verse eid="2TI 1:13"/><verse number="14" style="v" sid="2TI 1:14"/>ህትን ኒ በላን ዮ ጠሊለ አያኒን ኣሰንቶሄ ኤገተ አገር።<verse eid="2TI 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15"/>እስይ ባዶን ዮ አመዕናኑት ጉዕሙንኩ ግብ መርቶኤገ አት ደጋንት፤ እሰ በላን ፊጌሉስለከ ሄርሞጌኔስ ደገንታአ። <verse eid="2TI 1:15"/><verse number="16" style="v" sid="2TI 1:16"/>ኡሱረሚንከኤ ሙሉዕናን ኦኖስፎሮስ ልግብ ወክት ፎሎሲሾኤቤቺሃ ቀርቹ ኢስ ኦኖስፎሮሴ አበሮሲ አሙዙንሰ። <verse eid="2TI 1:16"/><verse number="17" style="v" sid="2TI 1:17"/>ህትን ሮም ከተመ አሜቾም ወክት አበ ሀሽ ኢን ደቀሞ። <verse eid="2TI 1:17"/><verse number="18" style="v" sid="2TI 1:18"/>ህካን እኮቤቺሃ ቀርቹ ኢስ ህከ በር መገኒች ማርቱተ ደአኖገ አኡንስ፤ ህትን ኤፌሶን ከተማን ዮም ወክት ሄንከ ሀዕሌኤ ጎር አት ጡመገ አት ደጋንት።<verse eid="2TI 1:18"/></para>
  <chapter eid="2TI 1"/>
  <chapter number="2" style="c" sid="2TI 2"/>
  <para style="s1">መሲህ ኢሳን አመዕነሜን ኦርሸተ ቶጉ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1"/>ኢ ቤቶ! አት መሲህ ኢሳን ዮ ኣስቶን ጠረኝ። <verse eid="2TI 2:1"/><verse number="2" style="v" sid="2TI 2:2"/>ህትን ልግቤ ምስክር ብሬን ኢች ሞጮጭቶንቲሃ ዎሉ መነ ተማርስቶተ አታልታ አመዕነሞ መኒሃ ኤገተ ኣስ።<verse eid="2TI 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3"/>አት ገዉክ መሲህ ኢሲሃ ጠረኘ ዎታደረ እክ ኦርሸተ ቶግ። <verse eid="2TI 2:3"/><verse number="4" style="v" sid="2TI 2:4"/>ህትን በገዝ አነ ሙንደእሲሶተ ሀሾ ወታደሩ አዪሁ ወታደር ሆጉተ እኮበእ ሆጎን ሆሰኖበአ። <verse eid="2TI 2:4"/><verse number="5" style="v" sid="2TI 2:5"/>ህትን ደጉዶን ሄጫቀሞተ ሀሾ መኑ ሴርስ ሃሌን ሄጫቀምበጎር ቄል ሽልማት ደአኖበአ። <verse eid="2TI 2:5"/><verse number="6" style="v" sid="2TI 2:6"/>ጠረኝ አቡረኖ ገበሬቹ ዉጣች ወዕኔስ ላልቹ ደኡ ሀስሰኖስ። <verse eid="2TI 2:6"/><verse number="7" style="v" sid="2TI 2:7"/>ቀርቹ ኢስ ጉዕመንከ ጠዋን ደጉ ኣሰኖሄቤቺሃ አን ያንኬ ጠወ ሰውይ።<verse eid="2TI 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8"/>ሬሆች ኬዕዮ ደዉዴ ዘሬች እኮ መሲህ ኢሰ አጥራመት፤ አን ዱዱብሳም እንጂል ላገት ተኒት። <verse eid="2TI 2:8"/><verse number="9" style="v" sid="2TI 2:9"/>ሂለ ሆጉተ አዕዮ መንችገ ከን እንጂል ላገ መሳን ሰንሰለቲን ኡሱረሞተ ኢለ ኦርሸተ ቶጋሚት፤ ጠዉ እኮጎሬ መገን ላገት ኡሱረንታበአ። <verse eid="2TI 2:9"/><verse number="10" style="v" sid="2TI 2:10"/>ህካን እኮቤቺሃ እሰ መሲህ ኢስ መሳን ደገመኖ ጡሙለከ ዘላለም ኬዕምኝ ደዕቶተ መገኑ መጠሮ መንተኔሃ ይኬዕይ ጉዕመ ጠወንከ አታዕላም። <verse eid="2TI 2:10"/><verse number="11" style="v" sid="2TI 2:11"/>ህትን</para>
  <para style="q1" vid="2TI 2:11">«እሲን ሜጡበ ሬኖም ጎር</para>
  <para style="q2" vid="2TI 2:11">እሲን ሜጡበ ፎሊን ሄዕናም።<verse eid="2TI 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12"/>አታዕሊን ጠረኝን ሄዕኖም ጎር</para>
  <para style="q2" vid="2TI 2:12">እሲን ሜጡበ ዎመ እንካም</para>
  <para style="q2" vid="2TI 2:12">ነኡ እሱ ለገዕኖምጎር እስን ኔሳሃ ለገአኖኔ።<note caller="-" style="x"><char style="xo" closed="false">1፥12 </char><char style="xt" closed="false"><ref loc="MAT 10:33">ማቶ. 10፥33</ref>፤ <ref loc="LUK 12:9">ሉቃ. 12፥9</ref>፤ ዘኍ. 16፥5።</char></note><verse eid="2TI 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13"/>ህትን ነኡ አመዕነምባ ጎሬሁ</para>
  <para style="q2" vid="2TI 2:13">እስ ገዉስ ለገኦተ አታለኖበእቤቺሃ አመዕነሞሃ እክ ሄአኖ» ይታ ላገት ሀንቅሃን።<verse eid="2TI 2:13"/></para>
  <para style="s1">ጠረኘ ሆጎ መንቹ</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14"/>ከን ጠውተኔሃ ቃጋገ አእሰ፤ ህትን ሞጮጨኖ መነ ቤስ ቤሉ መቱርቹሃ ደግለልባሃ እኮቤቺሃ ላጋተስ ኦደንትበገ መገን ብሬን ጠረኝስ ኩልሰ። <verse eid="2TI 2:14"/><verse number="15" style="v" sid="2TI 2:15"/>ህትን ሀንቅ ላገተ ጌጥ አዕይ ተማርሰኖ ሙልስበ ጠረኘ ሆጎ መንቹ እክ መለልት ገዉክ መገን ብሬን ሆንጠህሶተ ጠረኝ። <verse eid="2TI 2:15"/><verse number="16" style="v" sid="2TI 2:16"/>ህትን ከን ኣዱንያ አሌን መገኑ ዮበእ ጠውችለከ ገውመተ ጠወኢች ሁን፤ መሰንትስ ህትኔ ሆጉት መኑ መገኒች ቄዕረኖገ አታእተ። <verse eid="2TI 2:16"/><verse number="17" style="v" sid="2TI 2:17"/>እሰ ጠወኣ ጠዉ ጠረኘ ጡሌገለከ ሆሰን ገለን እተን አልባዕለን መረኖሃን፤ ህካን እኮቤቺሃ መን በላን ሄሜኖስለከ ፌለጦስ ሄኣአ። <verse eid="2TI 2:17"/><verse number="18" style="v" sid="2TI 2:18"/>ሁኩ መኑንኩ «ሬዮ መን ኬኡ ከኒች ብርንተ እኮኡ» ይተን ሀንቅ ዎቄች ፉልቶእረን፤ እሰን መት-መቶ መን አመዕነቱ ሌንቄቅሳእት። <verse eid="2TI 2:18"/><verse number="19" style="v" sid="2TI 2:19"/>ጠው እኮጎሬ «መገኑ ገይስ መነ ደገኖ፤ አን ቀርችየ የኖሁ ጉዕሙንኩ ሂለ ሆጎች ሁኑን» የኖ ማተሙ ዮ ሌንቄቅበ መገን ሀንቁ ምኒ ቀበብገ ጠረኝ ሄአኖ።<verse eid="2TI 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20"/>መቶ ቀባጣሞ መንች ምኔን ጠለዕል ዎርቅለከ ብር ኦደተ እሁዕናን ሀቅለከ ትብ ኦደት ዮኡ፤ እሳችን መት-መቱሰ ኬዕምኚሃ ዎሉሰንገ ኬዕምኙ ዮበእ ክድማተ እካአ። <verse eid="2TI 2:20"/><verse number="21" style="v" sid="2TI 2:21"/>ቴሁ አዪሁ ከን ሂለ ጠዊች ገዉስ ነጠ አዕዮ ጎሬ ቀርቺሃስ ደግለልታ ጡመ ሆጎተ ጉዕሚንከ ቅጥይቶ ኬዕምኝ ኦዳተ እሀኖ።<verse eid="2TI 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22"/>ህካን እኮቤቺሃ ሂለ ዎደልመ ሄዕላቻች ሁን፤ ነጠ ቀልቢን ቀርቾሃ ኢስ ሱዕመ ገእታሀኑኡን ሀንቅ እኮ ጠወ አተን አመዕነቱ፥ ኢተተለከ ወገሬት ጠረኝት አዎን። <verse eid="2TI 2:22"/><verse number="23" style="v" sid="2TI 2:23"/>ጠዉ እኮጎሬ ብተተ ኤበኖሃ እሁስ ደጋንትቤቺሃ ገውመለከ ደግለልትበ ኦዳች ሁን። <verse eid="2TI 2:23"/><verse number="24" style="v" sid="2TI 2:24"/>ቀርቾ ኢስ ካድንቹ መኒሃ ጉዕሚንከ ጎደበ ላፈ፥ ተማርሶተ አታለኖሃለከ እጀቀኖሃ እሁ ሀስሰኖስ ቤሉ ብተመኖሃ እሁ ሀስሰኖስበአ። <verse eid="2TI 2:24"/><verse number="25" style="v" sid="2TI 2:25"/>ሀንበዕለንታ መነ ጎደበ ላፍማን ሸዙ ሀስሰኖ፤ አይደጎ መገኑ ቶበት ሀንቅ ደግ ሀንቅቤቹ አሜቶተ ሳመ ኣሰኖሳሃ እሆተ አታለኖ። <verse eid="2TI 2:25"/><verse number="26" style="v" sid="2TI 2:26"/>ከን ሃሌን እልቢስ ሰውት ዊንሽቶተ ኡሱረንት ሄኦ እቅ ሼይጣን ዎሻዲች ገፈርሲጭቶተ ቀልቡሰ ፈንቀለኖሃ እሀኖ።<verse eid="2TI 2:26"/></para>
  <para style="b"/>
  <chapter eid="2TI 2"/>
  <chapter number="3" style="c" sid="2TI 3"/>
  <para style="s1">መጨረሽ በሬን እሀኖ ሂለ ጠዊተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1"/>መጨረሽ ዘማኔን ኦርሸ ወክቱ አሜተኖገ ካን ደግ። <verse eid="2TI 3:1"/><verse number="2" style="v" sid="2TI 3:2"/>መሰንትስ መኑ ገውሰ ኢትታእረ፥ ብረ ኢትታእረ፥ ለዕዬኔ ለዕዬኔ ይታእረ፥ ቦንታእረ፥ ቦሮዕረንታእረ፥ አኒሀለከ አማተ አዘዘንትበረ፥ ዉለቱ ዮሰበእረ፥ ጠሊልመት ዮሰበእረ፥ <verse eid="2TI 3:2"/><verse number="3" style="v" sid="2TI 3:3"/>ኢተት ዮሰበእረ፥ መ ጠዋኒ መኒን ኢተቀንትበረ፥ መን ሱዕመ ቤሳእረ፥ ገውሰ አገዕርትበረ፥ ጎደበ ጠረኛኑተ፥ ጡመርቹ ግባእረ፥ <verse eid="2TI 3:3"/><verse number="4" style="v" sid="2TI 3:4"/>ለገኣስንቻኑተ፥ ደዕለንስታእረ፥ ቦኒን ቡሰንታእረ፥ መገኑ ኢቲች በትስ ተስቄነጡ ኢትታእረ እካአ። <verse eid="2TI 3:4"/><verse number="5" style="v" sid="2TI 3:5"/>ህትን እሰን ሀይማኖቱ ዮሰረ አጉዳአ፤ እኮጎሬ አመዕነትሰ ዎልቀተ ካዳአ፤ ህትናሞ መኒች ገበጭ ይት ሁን። <verse eid="2TI 3:5"/><verse number="6" style="v" sid="2TI 3:6"/>ህትን እሰን ምነተ ደጉደን ኣግ ሰውቲን ላፈ እኮ አደደ ጩቢን ዊንቶረለከ ልግቤ ሄዕላቻን ቀልቡሰ በዕዮ ሜንቱ አፋአ። <verse eid="2TI 3:6"/><verse number="7" style="v" sid="2TI 3:7"/>ህትኔ ሜንቱ ጉዕመ ወክት ተማርታአ፤ ጠዉ እኮጎሬ ሀንቅ ደጋ ቤቹ አሜቶተ አታልታበአ። <verse eid="2TI 3:7"/><verse number="8" style="v" sid="2TI 3:8"/>ህትን ኢያኔሲለከ ኢያንበሬስ ሙሲን ኦደንቶሀንገን ኩ መኑሁ ሀንቅ ግባአ፤ እሰን ቀልቡሰ በዕያን አመዕነቲችሰ ኡባአ።<note caller="-" style="x"><char style="xo" closed="false">3፥8 </char><char style="xt" closed="false"><ref loc="EXO 7:11">ፉል. 7፥11</ref>።</char></note> <verse eid="2TI 3:8"/><verse number="9" style="v" sid="2TI 3:9"/>ጠው እኮጎሬ ኢያኔሴለከ ኢያንበሬሴ ገውመት ለልቶሀንገን ከን መን ገውመት ጉዕመ መን ብሬን ለልታቤቺሃ መከኖሰበአ።<verse eid="2TI 3:9"/></para>
  <para style="s1">ጎፍሜ ሸዘነተ</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10"/>ጠው እኮጎሬ አት ትምርትኤ፥ አን ሄዕዮምገ፥ ሰውትኤ፥ አመዕነቱኤ፥ አታዕሉኤ፥ ኢተኤ፥ ጠረኝመኤ፥ ሸረሙኤለከ ኦርሸኤ አዎንቶንት። <verse eid="2TI 3:10"/><verse number="11" style="v" sid="2TI 3:11"/>ህትን አንጦከሃ፥ እቆንዮነሃ፥ ልስጥረሃ ዬኖ ከተማን አሌንከኤ ኢሌኤ ጠወለከ አታዕሌም ቶቸሙ ደጋንት፤ ጠው እኮጎሬ ጉዕመርቺችን ቀርቹ ኢስ ጡምሾኤ።<note caller="-" style="x"><char style="xo" closed="false">3፥11 </char><char style="xt" closed="false"><ref loc="ACT 13:14-52">ሶቀ. 13፥14-52</ref>፤ <ref loc="ACT 14:1-7">14፥1-7</ref>፤ <ref loc="ACT 8-20">8—20</ref>።</char></note> <verse eid="2TI 3:11"/><verse number="12" style="v" sid="2TI 3:12"/>ሀንቅንከ መሲህ ኢሲን መገኑ አጉደን ሄኦተ ሀሳ መኑ ጉዕሙንኩ ሸረንታአ። <verse eid="2TI 3:12"/><verse number="13" style="v" sid="2TI 3:13"/>ጠው እኮጎሬ ሂሉለከ አመዕነንትቡ መኑ ሉስሰን፥ ሉሰን ሂልመ አሌን ሂልመተ በርግተን መርታአ። <verse eid="2TI 3:13"/><verse number="14" style="v" sid="2TI 3:14"/>እኮጎሬ አት አዬች ተማርቶንት ጎሬ ደጋንትቤቺሃ ተማርቶንትለከ አመዕንቶንት ጠዋን ጠረኝት ኡር። <verse eid="2TI 3:14"/><verse number="15" style="v" sid="2TI 3:15"/>አትን ኦስማችክ ኬስ መሲህ ኢሳን አመዕኒን ጡም አደ አዎንስቶተ አታልታ ጠሊላኑተ መጻፈተ ደጎንት። <verse eid="2TI 3:15"/><verse number="16-17" style="v" sid="2TI 3:16-17"/>ጠሊላኑት መጻፈት ጉዕሙንኩ መገን አያኑ አዎንሰን ከተበንቶእራን፤ እስን መገን መንቹ ቀነጤኖርቹ ዮበኢሃ፥ ጡመ ሆጎተ ጉዕሚንከ ቅጠሞሃ እሆተ ተማርሲሃ፥ ዎቀሻተ፥ ሉጨንሺች ፈንቀሺሃ፥ ነጥማን ሮስሲሃ ደግለልታእረ።<verse eid="2TI 3:16-17"/></para>
  <chapter eid="2TI 3"/>
  <chapter number="4" style="c" sid="2TI 4"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1"/>መገን ብሬን ፈንቀል አሜተኖለከ ዎመ እሀኖ ወክት ፎሊን ዮ መን አሌንለከ ሬዮ መን አሌን ፈረደኖ መሲህ ኢስ ብሬን ኤገተ ያንኬ። <verse eid="2TI 4:1"/><verse number="2" style="v" sid="2TI 4:2"/>መገን ላገንተ ዱዱብስ፤ ወክቴንለከ አለወክቴን ጠረኝ፤ አታዕሊን ተማርስተን ሆጉዕናን ኩልተንለከ ኡሙዕርተን ሸዝ። <verse eid="2TI 4:2"/><verse number="3" style="v" sid="2TI 4:3"/>መሰንትስ መኑ ጡመ ትምርት ሞጮጭቶተ ሀስቡ ወክቱ አሜተኖ፤ ጠው እኮጎሬ መጫተሰ ተሽ የኖ ጠወ ኩልታሰቤቺሃ ገይሰ ሃሽኣቶገ ተሽ የኖሰ ጠወ ኩልታሰ አስተማረተ ጭምአታአ። <verse eid="2TI 4:3"/><verse number="4" style="v" sid="2TI 4:4"/>እሰ ሀንቅ ሞጮጭታሀኒች መጨሰ ማቁተ ሞጮጭቶተ ፈንቀሽታአ። <verse eid="2TI 4:4"/><verse number="5" style="v" sid="2TI 4:5"/>ጠው እኮጎሬ አት ጉዕመ ጠዋንን አጥራመቶንቲሃ እህ፤ ኦርሸንተ አታዕል፤ እንጂለ ዱዱብሱ ሆጉክ አእ፤ ሆጉክን ዊንሽት አእ።<verse eid="2TI 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6"/>አን ክትም እሃም ወክቱ ሆንጠኮኡ፤ ህትን ከን ኣዱንያ አሊች መለዕለም ኦሮኣም ወክቱ ኢልዮኡ። <verse eid="2TI 4:6"/><verse number="7" style="v" sid="2TI 4:7"/>ጡመ አጰንሸ አጰሞም፤ ሄጫቀመኖ መንቹ ሄጫቀሙስ ሹሎሀንገን ክድመኤ ሹሎም፤ አመዕነቱኤ አገሮም። <verse eid="2TI 4:7"/><verse number="8" style="v" sid="2TI 4:8"/>ቴሱ ከኒች ኤተሮን ፈዩ ሽልማቱ ቅጥይ አገረኖኤ፤ ኩ ሽልማቱ መገኑ እስ ሃሽኣቶገ ሄዕዮምቤቺሃ ኣሰኖኤሃ ሽልማት፤ ህካን እኮቤቺሃ ጡመ ፍርደ ፈረደኖ ቀርቹ ኢስ ህከ በር ኣሰኖህዕኔ፤ ህካንን ጠለዕል ኤሳሃ እሁዕነ እስ አሜተኖገ ኢተኖ መኒሃ ጉዕሚንከ ኣሰኖሰ።<verse eid="2TI 4:8"/></para>
  <para style="s1">ጳዉሎሴ መጨረሽ ሸዘነተ</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9"/>ደዕልት ኢቤቹ አሜቶተ አታልስሾሄሃ ጉዕመንከ አእ። <verse eid="2TI 4:9"/><verse number="10" style="v" sid="2TI 4:10"/>መሰንትስ ዴማስ ከን ኣዱንያ አል ጠወ ኢት ኢች መለዕለም ተሰሎንቄ ከተመ ኦሮዕዮኡ፤ ቄርቂስ ገለትይ ባዱ ኦሮዕዮኡ፤ ህትን ቲቶስ ድልማጥ ባዱ ኦሮዕዮኡ።<note caller="-" style="x"><char style="xo" closed="false">4፥10 </char><char style="xt" closed="false"><ref loc="COL 4:14">ቆላ. 4፥14</ref>፤ <ref loc="PHM 1:24">ፍልሞ. 24</ref>፤ <ref loc="2CO 8:23">2 ቆሮ. 8፥23</ref>፤ <ref loc="GAL 2:3">ገላ. 2፥3</ref>፤ <ref loc="TIT 1:4">ቲቶ 1፥4</ref>።</char></note> <verse eid="2TI 4:10"/><verse number="11" style="v" sid="2TI 4:11"/>ጠለዕል ሉቃስ ኢን ሜጡበ ዮኡ፤ ማርቆስ ሆጎተ አበ ሀዕለኖኤቤቺሃ እሱ ኣእት አም። <verse eid="2TI 4:11"/><verse number="12" style="v" sid="2TI 4:12"/>ጠዉ እኮጎሬ ትልቆሴ ኤፌሶን ከተመ ሶኮም።<note caller="-" style="x"><char style="xo" closed="false">4፥12 </char><char style="xt" closed="false"><ref loc="ACT 20:4">ሶቀ. 20፥4</ref>፤ <ref loc="EPH 6:12-22">ኤፌ. 6፥12-22</ref>፤ <ref loc="COL 4:7-8">ቆላ. 4፥7-8</ref>።</char></note> <verse eid="2TI 4:12"/><verse number="13" style="v" sid="2TI 4:13"/>ህትን አሜታንት ወክት ጢሮአድ ከተማን ካርፑስ ቤቾን ዮ ኮርቦተለከ አደደ ጎጊች መክሴመሀኔን ከተበንቶ መጻፈተ ኣእት አም።<note caller="-" style="x"><char style="xo" closed="false">4፥13 </char><char style="xt" closed="false"><ref loc="ACT 20:6">ሶቀ. 20፥6</ref>።</char></note><verse eid="2TI 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14"/>ናሰ መክሰኖ አለክሰንደር ኢ አሌን ሂለ አበ ጠወ አዕዮኡ፤ እሲንከ ቀርቹ ሆጎስገ ባተኖስ።<note caller="-" style="x"><char style="xo" closed="false">4፥14 </char><char style="xt" closed="false"><ref loc="1TI 1:20">1 ጢሞ. 1፥20</ref>፤ <ref loc="PSA 62:12">መዝ. 62፥12</ref>፤ <ref loc="ROM 2:6">ሮሜ 2፥6</ref>።</char></note> <verse eid="2TI 4:14"/><verse number="15" style="v" sid="2TI 4:15"/>ነኡ ጠወዕናም ጠዋን እስ አበ ሀንበዕለመኖቤቺሃ አት ገዉክ እሲች አገዕር።<verse eid="2TI 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16"/>ከሰሰሞም ጠዊሃ ወዕና መስለ ፈንቀሼም ወክት ጉዕሙንኩ ኢች አደ እኮ ቤሉ ሀዕሌኤሁ አዪሁ ዮበአ፤ ህካን መገኑ እሰ አሌን ጩብ አዕይ ወለኡንከ። <verse eid="2TI 4:16"/><verse number="17" style="v" sid="2TI 4:17"/>ጠዉ እኮጎሬ ኢ አዲን መገን ላገት ጉዕሙንኩ ዱዱብሰንቶተለከ አይሁደ እህቡ መኑ ሞጮጮተ ቀርቹ ኢስ ኢ መዴን ኡር ጠረኝሾኤ፤ ዞቤ አፌች ፌሾኤ።<note caller="+" style="f"><char style="fqa" closed="false">ዞቤ አፌች ፌሾኤ፦ </char><char style="ft" closed="false">ፍርዲች ፈቆም ዩሃን።</char></note> <verse eid="2TI 4:17"/><verse number="18" style="v" sid="2TI 4:18"/>ቀርቹ ኢስን ሂለ ጠዊች ጉዕሚችን አገረኖኤ፤ ሰሜ ጄነቲንከ ኢልሰኖኤ፤ እሲንከ ዘላለሚሃ ኬዕምኙ እሁን፤ ኣሚዕን!<verse eid="2TI 4:18"/></para>
  <para style="s1">መጨረሽ ወገሬት</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19"/>ጵርስቂልለከ አቂላ ኦኔስፎርም አበሮስ ምኒ መኒሃ «ወገሬቴ» ይ።<note caller="-" style="x"><char style="xo" closed="false">4፥19 </char><char style="xt" closed="false"><ref loc="ACT 18:2">ሶቀ. 18፥2</ref>፤ <ref loc="2TI 1:16-17">2 ጢሞ. 1፥16-17</ref>።</char></note> <verse eid="2TI 4:19"/><verse number="20" style="v" sid="2TI 4:20"/>ኤራስጦስ ቆሮንቶስ ከተማን ፈቆ፤ ህትን ጥሮፊሞስ ጥዦቤቺሃ ሚሊጢን ከተማን አጉሮም።<note caller="-" style="x"><char style="xo" closed="false">4፥20 </char><char style="xt" closed="false"><ref loc="ACT 19:2">ሶቀ. 19፥2</ref>፤ <ref loc="ROM 16:23">ሮሜ 16፥23</ref>፤ <ref loc="ACT 20:4">ሶቀ. 20፥4</ref>፤ <ref loc="ACT 21:29">21፥29</ref>።</char></note> <verse eid="2TI 4:20"/><verse number="21" style="v" sid="2TI 4:21"/>አት ከርሙ ኣጉዕነ አታልስሾሄ ጌሳን ሄጭት ኢቤቹ አም፤ ኤዉብሎስ፥ ጱዴስ፥ ሊኖስ፥ ቅላዉድየለከ አመዕናኑት ጉዕሙንኩ «ወገሬት ዮንትንዶ» ይታሄት።<verse eid="2TI 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22"/>ቀርቹ መሲህ ኢስ ኪን ሜጡበ እሁን፤ መገን ኣስቱት ክዕኔን ሜጡበ እኩን።<verse eid="2TI 4:22"/></para>
  <chapter eid="2TI 4"/>
</usx>
