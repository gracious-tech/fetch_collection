<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- HALABA NEW TESTAMENT</book>
  <para style="h">ማቶሴ እንጂለ</para>
  <para style="toc1">ማቶስ ከተቦ ቀርችኔ መሲህ ኢስ እንጂለ</para>
  <para style="toc2">ማቶስ እንጂለ</para>
  <para style="toc3">ማቶ.</para>
  <para style="mt1">ማቶስ ከተቦሃ</para>
  <para style="mt2">ቀርችኔ መሲህ ኢስ እንጂለ</para>
  <para style="imt1">ኣጉስ</para>
  <para style="ip">ማቶሴ እንጂሉ ኢስ አሜት ተብሳሃ ሄጭ ኩለሞ ጡምሳንቹ እሁስለከ መገኑ ኑባቾ ጉዲን መኒሃስ ኣሴ ተብሴ ላገተ ዊንሼእንኩ እሲን እሁስ ኩለኖ ተሽት ላገተ አፎእሃን። ኩ ተሽት ላገት ኢስ በለሰ እለም ነጴ ጠለዕል አይሁዲሃ እሁዕነ ጉዕማንከ ኣዱንያ አል መኒሃት።</para>
  <para style="ip">ማቶሴ እንጂሉ ጡመገ አገዕሪን ተቃጠቦሃ መጻፈ፤ ኢስ እለሞሀኒች ኬሽ ጠመቀሙስለከ ፌተነስተኔሃ ጠወዕዮች ኤተሮን ገሊላን አዕዮ አዋጁስ ተማርሱስለከ ጥዘናመተ ፈይስ ክድመተ ሆንጠህሰኖ። ህከኒች ኤተሮን ኢስ ገሊላች ዬሩሳሌመ ኦሮዕዮገለከ ከን ኣዱንያ አሌን ሄዕዮ ዘማን ጎፍሜ ሳምንታን እኮ ጠወ ኩለኖ። ኩ ጠዉንኩ ሰቀለሙስ ሬሁስለከ ሬሆች ኬኡስ ጉዕመንከ ጠወአኖ።</para>
  <para style="ip">ኩ እንጂሉ ኢሰ መገን ሕገ ፈሰሪሃ ሹምነቱ ዮሲሃለከ መገን ዎምነትተኔሃ ተማርሰኖ ሎረ አስተማርቹ እሁስ እኮገ አዕይ ሆንጠህሰኖ ትምርቲችስ በተአኖስ አዱ ጠረኘ ሃሌን ኦንቱ ቤቹ ቤሀሞእሃን፦</para>
  <para style="ili">1. መገን ዎምነቱ ወረሰ መን ሀል መብቲተ ግዳጅለከ መጨረሽ ወጢ ደግሲሰኖ ቆተ አል ትምርተ (ፎሎ. 5-7)</para>
  <para style="ili">2. ቶነ ለሙንኩ አሳበት እንጂለ ዱዱብስቶተ ሶሃንቶ ወክት ኣሰሞሰ አዎኑ ሀስሰኖሰ ጠወ (ፎሎ. 10)</para>
  <para style="ili">3. መገን ዎምነትተኔሃ ሆንጠኮ አደደ ምሳልተ (ፎሎ. 13)</para>
  <para style="ili">4. ኢሰ አዎንተኔሃ ለሊሰኖ ትምርተ (ፎሎ. 18)</para>
  <para style="ili">5. ከን ዘማን ጎፍሞንለከ መገን ዎምነቱ አሜቱስ ኩለኖ ትምርተ (ፎሎ. 24-25)</para>
  <para style="iot">መጻፉስ አፎሃ</para>
  <para style="io1">መሲህ ኢስ እለንሽስ ደቡተለከ እለሙስ <char style="ior">(<ref loc="MAT 1:1-2:23">1፥1—2፥23</ref>)</char></para>
  <para style="io1">ጠመቃንቾ ያህይ ክድመተ <char style="ior">(<ref loc="MAT 3:1-12">3፥1-12</ref>)</char></para>
  <para style="io1">ኢስ ጠመቀሙስለከ ፌተነሙስ <char style="ior">(<ref loc="MAT 3:13-4:11">3፥13—4፥11</ref>)</char></para>
  <para style="io1">ኢስ ዊመ ሆጉስ ገሊላን ጀመሩስ <char style="ior">(<ref loc="MAT 4:12-18:35">4፥12—18፥35</ref>)</char></para>
  <para style="io1">ገሊላች ዬሩሳሌመ <char style="ior">(<ref loc="MAT 19:1-20:34">19፥1—20፥34</ref>)</char></para>
  <para style="io1">መጨረሽ ሳምንተ ዬሩሳሌማንለከ አዝጋጌንከስ <char style="ior">(<ref loc="MAT 21:1-27:66">21፥1—27፥66</ref>)</char></para>
  <para style="io1">ቀርቹኔ ኬኡስለከ ልግብ ወክት ለሉስ <char style="ior">(<ref loc="MAT 28:1-20">28፥1-20</ref>)</char></para>
  <chapter number="1" style="c" sid="MAT 1"/>
  <para style="s1">ኢስ እለሞ አበናኖተኔሃ</para>
  <para style="r">(<ref loc="LUK 3:23-38">ሉቃ. 3፥23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1"/>መሲህ ኢስ ደዉዴለከ እብራሂም ደቦች ከለቀሙስ ህት ከተበሞኡ።<note caller="-" style="x"><char style="xo" closed="false">1፥1 </char><char style="xt" closed="false"><ref loc="PSA 132:11">መዝ. 132፥11</ref>፤ <ref loc="ISA 11:1">ኢሳ. 11፥1</ref>።</char></note><verse eid="MAT 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2"/>እብራሂም ኢሳቀ እሎ፤ ኢሳቅ ያቁበ እሎ፤ ያቁብ ይሁደለከ አመስ ኦሱተ እሎ፤ <verse eid="MAT 1:2"/><verse number="3" style="v" sid="MAT 1:3"/>ይሁድ ትማሬች ፋሬሰለከ ዛረ እሎ፤ ፋሬስ ሄስሮነ እሎ፤ ሄስሮንን አራሜ እሎ፤ <verse eid="MAT 1:3"/><verse number="4" style="v" sid="MAT 1:4"/>አራም አምናደበ እሎ፤ አምናደብ ነኣሶነ እሎ፤ ነኣሶንን ሱልማነ እሎ፤ <verse eid="MAT 1:4"/><verse number="5" style="v" sid="MAT 1:5"/>ሰልሞን ራኣቤች ቦኤዘ እሎ፤ ቦኤዝ ሩቴች ኢዮቤደ እሎ፤ ኢዮቤድን እሴዬ እሎ፤ <verse eid="MAT 1:5"/><verse number="6" style="v" sid="MAT 1:6"/>እሴይን ዎመ ደዉዴ እሎ፤ ደዉድን ኦርዮ ጫች ሱላይማነ እሎ፤ <verse eid="MAT 1:6"/><verse number="7" style="v" sid="MAT 1:7"/>ሱላይማንን ሮብኣመ እሎ፤ ሮብኣምን አብየ እሎ፤ አብየን አሳፈ እሎ፤ <verse eid="MAT 1:7"/><verse number="8" style="v" sid="MAT 1:8"/>አሳፍን ኢዮሳፌጠ እሎ፤ ኢዮሳፌጥን ኢዮራመ እሎ፤ ኢዮራምን ኦዝየ እሎ፤ <verse eid="MAT 1:8"/><verse number="9" style="v" sid="MAT 1:9"/>ኦዝየን ኢዮኣታመ እሎ፤ ኢዮኣታምን አካዘ እሎ፤ አካዝን ሕዝቅያሰ እሎ፤ <verse eid="MAT 1:9"/><verse number="10" style="v" sid="MAT 1:10"/>ሕዝቅያስን ምናሴ እሎ፤ ምናስን አሞጼ እሎ፤ አሞጽን ኢዮስያሰ እሎ፤ <verse eid="MAT 1:10"/><verse number="11" style="v" sid="MAT 1:11"/>ኢዮስያስ እስራኤል ኡመቱ ባብሎነ አገንት መርቶ ወክት እኮንያኔለከ አመስ ኦሱተ እሎ።<note caller="-" style="x"><char style="xo" closed="false">1፥11 </char><char style="xt" closed="false"><ref loc="2KI 24:14-15">2 ነገ. 24፥14-15</ref>፤ <ref loc="2CH 36:10">2 ዱዱ. 36፥10</ref>፤ <ref loc="JER 27:20">ኤር. 27፥20</ref>።</char></note><verse eid="MAT 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12"/>ባብሎናን አገንት መርቶች ኤተሮን እኮንያን ሰላቴለ እሎ፤ ሰላቴልን ዘሩባቤሌ እሎ፤ <verse eid="MAT 1:12"/><verse number="13" style="v" sid="MAT 1:13"/>ዘሩባቤልን አብዮደ እሎ፤ አብዮድን ኤልያቄመ እሎ፤ ኤልያቄምን ኣዞረ እሎ፤ <verse eid="MAT 1:13"/><verse number="14" style="v" sid="MAT 1:14"/>ኣዞርን ሳዶቀ እሎ፤ ሳዶቅን አኪመ እሎ፤ አኪምን ኤልዮደ እሎ፤ <verse eid="MAT 1:14"/><verse number="15" style="v" sid="MAT 1:15"/>ኤልዮድን አልዓዛረ እሎ፤ አልዓዛርን ማታነ እሎ፤ ማታንን ያቁበ እሎ፤ <verse eid="MAT 1:15"/><verse number="16" style="v" sid="MAT 1:16"/>ያቁብን ዩሱፈ እሎ፤ ዩሱፍን «መሲህ»<note caller="+" style="f"><char style="fqa" closed="false">መሲህ፦ </char><char style="ft" closed="false">ዩ ቡረሞሃ ዩሃን።</char></note> ዬኖ ኢሰ እልቶ መርየመ ምኒ አነ እኮ።<verse eid="MAT 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17"/>ህካን እኮቤቺሃ እብራሂሚች ደዉዴ ኢለ ቶነ ሾሎ እለንሸ፤ ህትን ደዉዴች ባብሎን አግተእ መርቶኢሃ ኢለ ቶነ ሾሎ እለንሸ እኮ፤ ህትን ባብሎን አግቶች መሲህ ኢለ ቶነ ሾሎ እለንሸ።<verse eid="MAT 1:17"/></para>
  <para style="s1">መሲህ ኢስ እለሞገ</para>
  <para style="r">(<ref loc="LUK 2:1-7">ሉቃ. 2፥1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18"/>መሲህ ኢስ እለንሹ ህትጎታን፤ አመስ መርየመ ዩሱፍሃ ኣሰንት ዮሃኔን ደቀንቱዕናን ጠሊለ አያን ወልቃን ላፈተ እካን መኑ ጉዕሙንኩ ደጎ።<note caller="-" style="x"><char style="xo" closed="false">1፥18 </char><char style="xt" closed="false"><ref loc="LUK 1:27">ሉቃ. 1፥27</ref>።</char></note> <verse eid="MAT 1:18"/><verse number="19" style="v" sid="MAT 1:19"/>ጠዕሜ ዩሱፍ ፈየ መንቹ እኮቤቺሃ መናን ፍሹዕነ ጠወስ አጉሮተ ሰውዬእ። <verse eid="MAT 1:19"/><verse number="20" style="v" sid="MAT 1:20"/>ህካን ሰውየንን ቀርች መላይኬቹ ሀቄን ለልስ «ዩሱፋ ደዉዴ ቤቶ! ኣሴመሄ መርየመ ላፈተ እኮኢሁ ጠሊለ አያኒን እኮቤቺሃ እሴተ ኣእቶተ ዋጅቶት። <verse eid="MAT 1:20"/><verse number="21" style="v" sid="MAT 1:21"/>እሴን ለቤ ጩል እልታአ፤ እስን ኡመትስ ጩቢችሰ ጡምሰኖቤቺሃ ሱዕመስ ‹ኢሰ› ይታንት» ዬስ።<note caller="-" style="x"><char style="xo" closed="false">1፥21 </char><char style="xt" closed="false"><ref loc="LUK 1:31">ሉቃ. 1፥31</ref>።</char></note><verse eid="MAT 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22"/>ሁኩን ጉዕሙንኩ እኮሁ ቀርቹ ነብዬቾን <verse eid="MAT 1:22"/><verse number="23" style="v" sid="MAT 1:23"/>«ሀፍቱት ላፈተ እክ ለበ ጩል እልታአ፤ ህትን ሱዕመስ ‹አማኑኤለ› ይት ገእታአ» አማኑኤለ ዩ «መገኑ ኒንት» ዩሃን።<note caller="-" style="x"><char style="xo" closed="false">1፥23 </char><char style="xt" closed="false"><ref loc="ISA 7:14">ኢሳ. 7፥14</ref>።</char></note><verse eid="MAT 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24"/>ህካን እኮቤቺሃ ዩሱፍ ግሰኛች በቅዬ ወክት ቀርች መላይኬቹ አዘዦገን መርየመ ኣኤሴ። <verse eid="MAT 1:24"/><verse number="25" style="v" sid="MAT 1:25"/>ጠዉ እኮጎሬ መርየመ ዎኔሴ ጩል እልቶተ ኢለ እሴን ደቀሞበአ<note caller="+" style="f"><char style="fqa" closed="false">ደቀሞበአ፦ </char><char style="ft" closed="false">ዩ ምኒ አኒገለከ ምኒ መንቾገ እክ ኦሰኦበአ ዩሃን።</char></note> እቅ፤ ዩሱፍን እለሞ ጩል «ኢሰ» ይ ሱዕመ ፉሼስ።<note caller="-" style="x"><char style="xo" closed="false">1፥25 </char><char style="xt" closed="false"><ref loc="LUK 2:21">ሉቃ. 2፥21</ref>።</char></note><verse eid="MAT 1:25"/></para>
  <chapter eid="MAT 1"/>
  <chapter number="2" style="c" sid="MAT 2"/>
  <para style="s1">ሸርቂን አሜቶ ቤዜተ ዎለኣ ኤንኬዕናመተ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1"/>ሄሮድስ ዎመ እኮ ዘማን ኢስ ይሁድ ባዶን ቤተሌም ከተማን እለሞ ወክት ቤዜተ ዎለኣ ኤንኬዕናሙ መኑ ሸርቂች ዬሩሳሌመ አሜቶኡ። <verse eid="MAT 2:1"/><verse number="2" style="v" sid="MAT 2:2"/>እሰን «አይሁድ ዎመ እሀኖ ጩሉ እለሞሁ ሀከንቤቾንት? ሸርቂን ቤዜተ ለዕን እሲሃ ሰገንዶተ አሜንቶም» ይት ጠዕምቶኡ።<note caller="-" style="x"><char style="xo" closed="false">2፥2 </char><char style="xt" closed="false"><ref loc="JER 23:5">ኤር. 23፥5</ref>፤ <ref loc="ZEC 9:9">ዘካ. 9፥9</ref>፤ <ref loc="NUM 24:17">ዘኁ. 24፥17</ref>።</char></note><verse eid="MAT 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3"/>ዎሙ ሄሮድስ ህካን ሞጮጬ ወክት አበ ህልቆ፤ ህትን ዬሩሳሌም መኑ ጉዕሙንኩ ህልቆኡ። <verse eid="MAT 2:3"/><verse number="4" style="v" sid="MAT 2:4"/>እስን ኡመትስ ቂስ አዎንሳኑተለከ ሕግ አስተማረተ ጉዕመንከ ጭምአዕይ «ቡረሞ መሲህ እለመኖሁ ሀከቤቹ» እሁስ ጠዕሜሰ።<verse eid="MAT 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5"/>እሰን «ይሁድ ባዶን ቤተሌም ከተማን እለመኖ፤ መሰንትስ ነብዬቹ<verse eid="MAT 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6"/>«ቤተሌም ከተመ!</para>
  <para style="q2" vid="MAT 2:6">አት ይሁድ ባድ አዎንሳኖች ጉዕሚችን ሆፈኣንትበአ፤</para>
  <para style="q2" vid="MAT 2:6">ህካን እኮቤቺሃ ኪች ኢ መነ እስራኤለ አገረኖለከ አዎንሰኖሁ እለመኖ ይ ከተቦኡ» ይቶኡ።<note caller="-" style="x"><char style="xo" closed="false">2፥6 </char><char style="xt" closed="false"><ref loc="MIC 5:2">ሚክ. 5፥2</ref>።</char></note><verse eid="MAT 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7"/>ህከኒች ኤተሮን ሄሮድስ ህከ ኤንኬዕናሙ መነ ማጭ ገእ ጠወስ ፎፎጅ ቤዜት ለልቶ ወክት ጠዕም ደጎ። <verse eid="MAT 2:7"/><verse number="8" style="v" sid="MAT 2:8"/>እስን እሰንተ «መርቴን ህከን ጩልተኔሃ ጡመገ አጥረመቼ፤ ደጌንተጎሬ አሜቴን ኩልቴነንተኤ፤ አኒሁ ሰገዶተ መራም» ይ ቤተሌመ ሶኮ።<verse eid="MAT 2:8"/></para>
  <para style="p">
    <verse number="9-10" style="v" sid="MAT 2:9-10"/>እሰን ሄሮድሴች ሞጮጭት ፉልቶ ወክት ሸርቂን ለኦ ቤዜት አዎንስተንሰ ለኦ ወክት አበ ሙንደኦኡ፤ ሁኩ ሸርቃን ለኦ ቤዜንት ጩሉ ዮ ምኒ ቡዕላን ኡርታኢሃ ኢለ አዎንስቶሰ። <verse eid="MAT 2:9-10"/><verse number="11" style="v" sid="MAT 2:11"/>እሰን ህከ ምኒ ኣጎ ወክት ጩሉ አማንተስ መርየማን ሜጡበ ዮኢሃ ለእ ብሬስ ጉሉጵት ሰገዶኡ፤ ህከኒች ኤተሮን ሳጥነ ፈንት ዎርቀ፥ ህጣነለከ ከርቤተ ዬኖ ህጣነ ፉሽት ኣቶኡ።<verse eid="MAT 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12"/>ሁኩ ኤንኬዕናሙ መኑ ሄሮድሴበ ፈንቀልት መርታበእገ መገኑ ሀቄን ኩላን ዎሎ ዎቄን ባዱሰ ፈንቀልቶኡ።<verse eid="MAT 2:12"/></para>
  <para style="s1">ዩሱፍ ጩሊንለከ አማን ግብጸ ሁኞገ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13"/>እሰን መርቶች ኤተሮን ቀርች መላይኬቹ ሀቄን ዩሱፊሃ ለልስ «ሄሮድስ ጩል ሾተ ሀሰኖቤቺሃ ጩልለከ አመተ ኣእት ግብጽ ባዱ ሁን፤ አን ኩሎሄተ ኢለ ህከኔ አፉዕል» ዬስ።<verse eid="MAT 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14"/>ዩሱፍ ሀንከዕሬን ኬዕይ ጩልለከ አመተ ኣእ ግብጽ ባዱ ኦሮዕዮ። <verse eid="MAT 2:14"/><verse number="15" style="v" sid="MAT 2:15"/>ህከኔን ሄሮድስ ሬሆተ ኢለ አፉዕሌእ፤ ሁኩን እኮሁ ቀርቹ ነብዬቾን «ቤቱኤ ግብጺች ገኤም» ዬ ላገት ዊንቶታት እቅ።<note caller="-" style="x"><char style="xo" closed="false">2፥15 </char><char style="xt" closed="false"><ref loc="HOS 11:1">ሆሴ. 11፥1</ref>።</char></note><verse eid="MAT 2:15"/></para>
  <para style="s1">ሄሮድስ ኦሱተ ሽሲሾገ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16"/>ሄሮድስ ቤዜተ ለኦ መኑ ጣንሱሰ ደጎ ወክት አበ ኡሙዕሬእ፤ ቤተሌማንለከ ህከን አዳን ጉዕማንን ዮ ለሞ ዘማንለከ ለሞ ዘማኒች ዎሮን ዮ ለቤ ኦሱተ ጉዕመንከ ሾኖተ አዘዦ፤ ህከ ወክትንከ ደጎሁ ኤንኬዕናሙ መኑ ኩልቶስጋት እቅ። <verse eid="MAT 2:16"/><verse number="17" style="v" sid="MAT 2:17"/>ሁኩን እኮሁ ነብዬቹ ኤርምያስ<verse eid="MAT 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18"/>«ራሄል እላተሴ ኦአን</para>
  <para style="q2" vid="MAT 2:18">ያርትለከ ጨንጨነት ራማ ዬኖቤቾን ሞጮጨንቶኡ፤ እለሴ ሬቶቤቺሃ ሰብር አቶበአ» ዬኢሁ ዊሞታት።<note caller="-" style="x"><char style="xo" closed="false">2፥18 </char><char style="xt" closed="false"><ref loc="JER 31:15">ኤር. 31፥15</ref>።</char></note><verse eid="MAT 2:18"/></para>
  <para style="s1">ዩሱፍ ጩሊንለከ አማን ግብጺች ፈንቀሉስ</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19"/>ሄሮድስ ሬዮች ኤተሮን ግብጽ ባዶን ቀርች መላይኬቹ ዩሱፍበ ሀቄን አሜች <verse eid="MAT 2:19"/><verse number="20" style="v" sid="MAT 2:20"/>«ጩል ሽቶተ ሀሶ መኑ ሬቶቤቺሃ ኬእ አት ጩልለከ አመተ ኣእት እስራኤል ባዱ ፈንቀል» ይ ኩሎ። <verse eid="MAT 2:20"/><verse number="21" style="v" sid="MAT 2:21"/>ህከ ወክት ዩሱፍ ጩልለከ አመተ ኣእ እስራኤል ባዱ ፈንቀሎ።<verse eid="MAT 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22"/>ይሁድ ባዶን አርኬላዎስ አኒስ ሄሮድሴ ቤቾን ዎመ እክ ሄዕዮገ ዩሱፍ ሞጮጭ ይሁድ ባዱ ኦሮኡ ዋጄእ፤ መገኑ ዩሱፍሃ ሀቄን ኩላንስ ገሊል ባዱ ኦሮዕዮ። <verse eid="MAT 2:22"/><verse number="23" style="v" sid="MAT 2:23"/>ህከቤቹንከ ኢሌ ወክት ናዝሬት ከተማን ሄዕዮ፤ ሁኩን እኮሁ ነብያኖን « ‹ናዝሬት መንቹ› ዬን ገኤኖ» ዬማሁ ዊሞታት።<note caller="-" style="x"><char style="xo" closed="false">2፥23 </char><char style="xt" closed="false"><ref loc="ISA 11:1">ኢሳ. 11፥1</ref>፤ <ref loc="MRK 1:24">ማር. 1፥24</ref>፤ <ref loc="LUK 2:39">ሉቃ. 2፥39</ref>፤ <ref loc="JHN 1:45">ያህ. 1፥45</ref>።</char></note><verse eid="MAT 2:23"/></para>
  <chapter eid="MAT 2"/>
  <chapter number="3" style="c" sid="MAT 3"/>
  <para style="s1">ጠመቃንቾ ያህይ አዋጀ</para>
  <para style="r">(<ref loc="MRK 1:1-8">ማር. 1፥1-8</ref>፤ <ref loc="LUK 3:1-18">ሉቃ. 3፥1-18</ref>፤ <ref loc="JHN 1:19-28">ያህ. 1፥19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1"/>ህከ ወክት ጠመቃንቹ ያህይ ይሁድ ባድ ኡድማን አዋጀን አሜቾ። <verse eid="MAT 3:1"/><verse number="2" style="v" sid="MAT 3:2"/>«ሁኩዕኑን! ሰሜ ዎምነቱ ሆንጠኮቤቺሃ ጩብክዕኔ ቶበቴን ፈንቀሌ» የኖ እቅ።<note caller="-" style="x"><char style="xo" closed="false">3፥2 </char><char style="xt" closed="false"><ref loc="MAT 4:17">ማቶ. 4፥17</ref>፤ <ref loc="MRK 1:15">ማር. 1፥15</ref>።</char></note> <verse eid="MAT 3:2"/><verse number="3" style="v" sid="MAT 3:3"/>ነብዬቹ እስያስ «መቱ መንቹ ኡለ ኡድማን ‹ቀርቹ ህገኖቤቹ ብዝ አዕዬ ህትን ዎቃስ ጌጥ አዕዬ› ይ ያርተን ሄኦ ላገተ» ዬኢሁ ያህይተኔሃት።<verse eid="MAT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4"/>ያህይ ኦድኑት ጋሜል ኦርዛች ደዴመተ እቅ፤ ረመዙስ ጠፍሪን ቆዕረኖ እቅ፤ ህትን ዳመ መለቡለከ ከንቸፈሩሃ እተኖ እቅ።<note caller="-" style="x"><char style="xo" closed="false">3፥4 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 ነገ. 1፥8</ref>፤ <ref loc="ZEC 13:4">ዘካ. 13፥4</ref>፤ <ref loc="LEV 11:22">ሌዌ 11፥22</ref>።</char></note> <verse eid="MAT 3:4"/><verse number="5" style="v" sid="MAT 3:5"/>ህከ ወክት ዬሩሳሌም ከተሚች፥ ይሁድ ባዲች ጉዕሚችለከ ዮርዳኖስ ዊ አዳን ዮ ባዲች ጉዕሚችን መኑ ያህይበ አሜተኖ እቅ። <verse eid="MAT 3:5"/><verse number="6" style="v" sid="MAT 3:6"/>ጩብሰ ቶበተን ዮርዳኖስ ዛዘኖ ዊን ያህይ ጠመቀኖሳት እቅ።<verse eid="MAT 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7"/>ያህይ ልግቡ ፈርሳዊትለከ ሰዱቃውት እስበ ጠመቀንቶተ አሜተን ለዕዮ ወክት እሰንተ «አዕኑ ዎሪች እለት! መገኒች አሜታ ኡሙዕሬች ጡምቶኖተ ኩሎህዕኔሁ አዬት?<note caller="-" style="x"><char style="xo" closed="false">3፥7 </char><char style="xt" closed="false"><ref loc="MAT 12:34">ማቶ. 12፥34</ref>፤ <ref loc="MAT 23:33">23፥33</ref>።</char></note> <verse eid="MAT 3:7"/><verse number="8" style="v" sid="MAT 3:8"/>ቴሱንገ ጩብክዕኔ ቶበቴን ፈንቀሉክዕኔ ለሊሳ ጡመ ሆጉተ አዕዬ። <verse eid="MAT 3:8"/><verse number="9" style="v" sid="MAT 3:9"/>ህትን ነኡ ‹እብራሂምተ እለ› ይቴነን ጡምቴነንታሃ አጉዱንከህዕኔ፤ መገኑ ከን ክኒች እብራሂም እለተ አዕይ ኬሶተ አታለኖገ አን ኩላንክዕኔ።<note caller="-" style="x"><char style="xo" closed="false">3፥9 </char><char style="xt" closed="false"><ref loc="JHN 8:33">ያህ. 8፥33</ref>።</char></note> <verse eid="MAT 3:9"/><verse number="10" style="v" sid="MAT 3:10"/>ከልቱ ሀቅ ፎቃን አፉዕልዮኡ፤ ጡመ ላልቹ ላልበ ሀቀ ጉዕመንከ ሙሬን ጊራን ዎሬኖ።<note caller="-" style="x"><char style="xo" closed="false">3፥10 </char><char style="xt" closed="false"><ref loc="MAT 7:19">ማቶ. 7፥19</ref>።</char></note> <verse eid="MAT 3:10"/><verse number="11" style="v" sid="MAT 3:11"/>ጩብክዕኔ ቶበቴን ፈንቀሉክዕኔ ለልሲሃ ዊን ጠመቃንክዕኔ፤ እኮጎሬ ኩ ኢች ኤተሮን አሜተኖሁ ጠሊለ አያኒንለከ ጊራን ጠመቀኖህዕኔ፤ እስ ኢች አበ ሎረሃን፤ አን ጫዕመስ እጆተ በቀዕዮምበእሃን። <verse eid="MAT 3:11"/><verse number="12" style="v" sid="MAT 3:12"/>ህካን እኮቤቺሃ እስ ኦዱ መክሶተለከ አቶተ ጋቢች አደ አኦተ ቤሉ ዮስ፤ አደ አዕዮች ኤተሮን ጠለሼ አቶተ ጭምአዕይ ጎተራን ዎረኖ፤ ጠዉ እኮጎሬ ጋበስ ጠዕታበእ ጊራን ቡሰኖ» ዬእ። <figure style="fig" alt="Winnowing grain" file="HK00097B.tif" size="span" ref="3፥12">ገበሬቹ ቤሊን አቶተ ጠለሽን</figure><verse eid="MAT 3:12"/></para>
  <para style="s1">ኢስ ጠመቀሙስ</para>
  <para style="r">(<ref loc="MRK 1:9-11">ማር. 1፥9-11</ref>፤ <ref loc="LUK 3:21-22">ሉቃ. 3፥21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13"/>ህከ ወክት ኢስ ገሊላች ያህይበ ዮርዳኖስ ዛዘኖ ዋን ጠመቀሞተ አሜቾ። <verse eid="MAT 3:13"/><verse number="14" style="v" sid="MAT 3:14"/>እኮጎሬ ያህይ «አን ኪን ጠመቀሙ ሀስሰኖኤ ቤሉ አት ሀት ኢቤቹ ጠመቀንቶተ አሜቶንት?» ይ ከሞተ ሀሾ።<verse eid="MAT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15"/>ኢስን «ነኡ መገኑ ሀሰኖርቹ ጉዕመንከ ዊንሹ ሀስሰኖኔቤቺሃ ቴሱ ከንቶቴኤ» ዬ ወክት ያህይ ጠዋንከስ ኢተቀም ኢሰ ጠመቆስ። <verse eid="MAT 3:15"/><verse number="16" style="v" sid="MAT 3:16"/>ኢስን ጠመቀም ዊ ኣዚች ደዕል ፉሎ፤ ህከኒች ኤተሮን ሰሞ ፊልተዕይ ፈንተዕያን መገን አያኑ ሀንደዕሬገ እክ ድር ኢስ አሌን አፉዕለን ለዕዮ። <verse eid="MAT 3:16"/><verse number="17" style="v" sid="MAT 3:17"/>ህከ ወክት «አን ሙንደኣምለከ ኢታም ቤቱኤ ከኒት» ይታ ላገት ሰሜች አሜቶኡ።<note caller="-" style="x"><char style="xo" closed="false">3፥17 </char><char style="xt" closed="false"><ref loc="GEN 22:2">ክል. 22፥2</ref>፤ <ref loc="PSA 2:7">መዝ. 2፥7</ref>፤ <ref loc="ISA 42:1">ኢሳ. 42፥1</ref>፤ <ref loc="MAT 12:18">ማቶ. 12፥18</ref>፤ <ref loc="MAT 17:5">17፥5</ref>፤ <ref loc="MRK 1:11">ማር. 1፥11</ref>፤ <ref loc="LUK 9:35">ሉቃ. 9፥35</ref>።</char></note><verse eid="MAT 3:17"/></para>
  <chapter eid="MAT 3"/>
  <chapter number="4" style="c" sid="MAT 4"/>
  <para style="s1">ኢስ ፌተነሙስ</para>
  <para style="r">(<ref loc="MRK 1:12-13">ማር. 1፥12-13</ref>፤ <ref loc="LUK 4:1-13">ሉቃ. 4፥1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1"/>ህከኒች ኤተሮን ኢስ እልብሲን ፌተነሞተ መገን አያኑ ኡለ ኡድመ መሴስ።<note caller="-" style="x"><char style="xo" closed="false">4፥1 </char><char style="xt" closed="false"><ref loc="HEB 2:18">እብ. 2፥18</ref>፤ <ref loc="HEB 4:15">4፥15</ref>።</char></note> <verse eid="MAT 4:1"/><verse number="2" style="v" sid="MAT 4:2"/>ህከኔን ሸይሉ በርለከ ሸይሉ ሀንከዕርተ ሶመኞች ኤተሮን ኢሰ ጎሩ አፎስ።<note caller="-" style="x"><char style="xo" closed="false">4፥2 </char><char style="xt" closed="false"><ref loc="EXO 34:28">ፉል. 34፥28</ref>፤ <ref loc="1KI 19:8">1 ነገ. 19፥8</ref>።</char></note> <verse eid="MAT 4:2"/><verse number="3" style="v" sid="MAT 4:3"/>ህከ ወክት እልብሱ ኢሰ ፌተኖተ አሜች «አት መገን ቤቱ እኮንትጎሬ ህንዴ ከ ክነተ እቸተ አእ» ዬስ።<verse eid="MAT 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4"/>ጠዉ እኮጎሬ ኢስ ፈንቀሽ « ‹መኑ መገን አፌች ፉልታ ላጋኒት ቤሉ ጠለዕል እቻን ሄአኖበአ› የመም ከተበሞኡ» ዬስ።<note caller="-" style="x"><char style="xo" closed="false">4፥4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">ዘዳ. 8፥3</ref>።</char></note><verse eid="MAT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5"/>ህከኒች ኤተሮን እልብሱ ኢሰ ጠሊለ ዬሩሳሌም ከተመ መሴስ፤ ህከኔን ዱእ ምኒ እሌ አል ፉሽ ኡርሾ<note caller="-" style="x"><char style="xo" closed="false">4፥5 </char><char style="xt" closed="false"><ref loc="NEH 11:1">ነህ. 11፥1</ref>፤ <ref loc="DAN 9:24">ዳን. 9፥24</ref>።</char></note> <verse eid="MAT 4:5"/><verse number="6" style="v" sid="MAT 4:6"/>ጠሊለ መጻፋን</para>
  <para style="q1" vid="MAT 4:6">« ‹ሎከክ ክኖን ቆዕልታበእገ ኬሳሃ አገርት ኬስ አፎተ መገኑ መላይከስ አዘዘኖ› የመም ጠሊለ መጻፋን ከተበሞኡ፤</para>
  <para style="q2" vid="MAT 4:6">ህካን እኮቤቺሃ አት መገን ቤቱ እኮንትጎሬ ህንዴ ዎሮ ዋልት ኡብ» ዬስ።<note caller="-" style="x"><char style="xo" closed="false">4፥6 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">መዝ. 91፥11-12</ref>።</char></note><verse eid="MAT 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7"/>ጠዉ እኮጎሬ ኢስ ፈንቀሽ « ‹ቀርቹ መገኑክ ፌተንቶት› የመም ወዕናንከ ከተበሞኡ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">4፥7 </char><char style="xt" closed="false"><ref loc="DEU 6:16">ዘዳ. 6፥16</ref>።</char></note><verse eid="MAT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8"/>ህከኒች ኤተሮን እልብሱ ኢሰ ሎረ ቆተ አል ፉሽ ኣዱንያ አል ዎመተ ጉዕመንከ ሎርመሰ ለሊሽ <verse eid="MAT 4:8"/><verse number="9" style="v" sid="MAT 4:9"/>«ኤሳሃ ሙግይት ሰገዶንቴኤ ጎር ካን ጉዕመንከ ኣሳንኬ» ዬእ።<verse eid="MAT 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10"/>ኢስ ፈንቀሽ «አት ሸይጣኑ ኢች ቄዕር፤ ጠሊለ መጻፋን ቀርቾ ‹መገኒሃክ ሰገድ፤ ጠለዕል እሲሃ ጠገም› የመም ከተበሞኡ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">4፥10 </char><char style="xt" closed="false"><ref loc="DEU 6:13">ዘዳ. 6፥13</ref>።</char></note><verse eid="MAT 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11"/>ህከ ወክትንከ እልብሱ ኢሰ አጉሮ፤ ህትን መላይከንት አሜት ካደንቶስ።<verse eid="MAT 4:11"/></para>
  <para style="b"/>
  <para style="s1">ኢስ ገሊላን ተማርሱ ጀመሩስ</para>
  <para style="r">(<ref loc="MRK 1:14-15">ማር. 1፥14-15</ref>፤ <ref loc="LUK 4:14-15">ሉቃ. 4፥14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12"/>ኢስ ያህይ ኡሱረሞገ ሞጮጬ ወክት ገሊለተ ኦሮዕዮ፤<note caller="-" style="x"><char style="xo" closed="false">4፥12 </char><char style="xt" closed="false"><ref loc="MAT 14:3">ማቶ. 14፥3</ref>፤ <ref loc="MRK 6:17">ማር. 6፥17</ref>፤ <ref loc="LUK 3:19-20">ሉቃ. 3፥19-20</ref>።</char></note> <verse eid="MAT 4:12"/><verse number="13" style="v" sid="MAT 4:13"/>ጠዉ እኮጎሬ ናዝሬት ከተመ አጉር ዛብሎንለከ ንፍታሌም ባዶን ሎረ ባር መዴን ዮ «ቅፍርናሆመ» ዬኖ ከተማን ሄዕዮ።<note caller="-" style="x"><char style="xo" closed="false">4፥13 </char><char style="xt" closed="false"><ref loc="JHN 2:12">ያህ. 2፥12</ref>።</char></note><verse eid="MAT 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 4:14"/>ሁኩን እኮሁ ነብዬቹ እስያስ<verse eid="MAT 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15"/>«ገሊለ ባር አደ መሰኖ ዎቄ አዲን</para>
  <para style="q2" vid="MAT 4:15">ዮርዳኖስ ዛዘኖ ዊ ዉድ አዲን ለለኖ</para>
  <para style="q1" vid="MAT 4:15">ዛብሎን ባድ መኑ፥ ንፍታሌም ባድ መኑለከ</para>
  <para style="q1" vid="MAT 4:15">አይሁደ እኮበእ ገሊለ መኑ<verse eid="MAT 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16"/>ሁኩ ቱንስቾን ሄአኖ ኡመቱ አበ ኑር ለዕዮ፤</para>
  <para style="q2" vid="MAT 4:16">ህትን ሬሆ ሀሌ ኣዜን ዮ መኒሃ ኑሩ ፉሎሰ»</para>
  <para style="m" vid="MAT 4:16">ጠወዕዮ ራግ ላገት ዊንቶታት።<note caller="-" style="x"><char style="xo" closed="false">4፥16 </char><char style="xt" closed="false"><ref loc="ISA 9:1-2">ኢሳ. 9፥1-2</ref>።</char></note><verse eid="MAT 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17"/>ህከን ወክቲች ኬሽ ኢስ «ሰሜ ዎምነቱ ሆንጠኮቤቺሃ አዕኑ ጩብችክዕኔ ፈንቀሌ» የን ተማርሱ ጀመሮ።<note caller="-" style="x"><char style="xo" closed="false">4፥17 </char><char style="xt" closed="false"><ref loc="MAT 3:2">ማቶ. 3፥2</ref>።</char></note><verse eid="MAT 4:17"/></para>
  <para style="s1">ኢስ ሾሉ ቁርጩሜተ ወሻዳረ ገኡስ</para>
  <para style="r">(<ref loc="MRK 1:16-20">ማር. 1፥16-20</ref>፤ <ref loc="LUK 5:1-11">ሉቃ. 5፥1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18"/>ኢስ ገሊለ ባር መዲን ሃመን ለምተ አመኦሱተ ለዕዮ፤ እሰን «ጴጥሮሴ» ዬኖ ስሞኔትለከ አመስቤቱ እንድራሴት እቅ፤ ቁርጩሜተ ወሻዳእረ እኮቤቺሃ ወሻዳሰ ሎረ ባራን ኡጅተን ለዕዮ። <verse eid="MAT 4:18"/><verse number="19" style="v" sid="MAT 4:19"/>ኢስን «አሜ ኤሳሃ አዎኜኤ፤ አን ክዕኔተ ቁርጩሜተ ወሻዴነንተገን መነ መገን አደ ኤቤነንተረ አኣንክዕኔ» ዬሰ። <verse eid="MAT 4:19"/><verse number="20" style="v" sid="MAT 4:20"/>እሰን ህከ ወክት ወሻደሰ አጉርት ኢሰ አዎንቶኡ።<verse eid="MAT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21"/>ህከንቤቺች ቀዉተ ህጎገን ዘብዴዎሴ እለተ እኮእሩ ዎልት ለምተ አመኦሱት ያቁብለከ ያህይ አኒንከሰን ሜጡበ እክ ጀልብ ኣዜን ቁርጩሜ ወሻደ ጎበን ለዕይ ኢስ ገኤሰ። <verse eid="MAT 4:21"/><verse number="22" style="v" sid="MAT 4:22"/>እሰን ህከ ወክት አነሰለከ ጀልበሰ ጌኝአት ኢሰ አዎንቶኡ። <figure style="fig" alt="Fishing" file="HK00208B.tif" size="span" ref="4፥18-22">ቁርጩሜተ ዎሻዳእረ</figure><verse eid="MAT 4:22"/></para>
  <para style="s1">ኢስ ልግብ መነ ተማርሱስለከ ፈይሱስ</para>
  <para style="r">(<ref loc="LUK 6:17-19">ሉቃ. 6፥17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23"/>ኢስ ጭምትሰ ምናን ተማርሰንለከ መገን ዎምነት ተሽት ላገተ አዋጀን ገሊለ ባዱ ጉዕመንከ ሃመኖት እቅ፤ አደደ ጥዘነተለከ ጎግ ጥዘነተ ፈይሰኖት እቅ። <verse eid="MAT 4:23"/><verse number="24" style="v" sid="MAT 4:24"/>ሁኩ ዱዱቡ ሶርይ ባዶን ጉዕማንን ሞጮጨሞቤቺሃ መኑ አደደ ጥዘናን ጥዝ ኦርጨቀንተ መነ እስበ ኤቦኡ፤ ጥዘናመ በላን ዶሮረኖ ዱሩ አፎ መኑሁ፥ ጮቱ አፎ መኑለከ ናፉ መኑ ሄዕዮ እቅ፤ ጠዉ እኮጎሬ ኢስ ጉዕመንከሰ ፈይሾ። <verse eid="MAT 4:24"/><verse number="25" style="v" sid="MAT 4:25"/>ገሊላችለከ «ቶኑ ከተመ»<note caller="+" style="f"><char style="fqa" closed="false">ቶኑ ከተመ፦ </char><char style="ft" closed="false">የኖሁ ግሪክ አፎ ጠወኣእ አይሁደ እኮበእ መኑ ሜጡበ ሄኣ ቤቹ ቶኑ ከተመ ዬኖ፤ ኩ ከተሙ ልግቡሰ ሄኣኢሁ ገሊለ ባር ሸርቂንለከ ቅልብ ሸርቅ አዲንት።</char></note> ዬኖ ባዲቺ፥ ዬሩሳሌሚቺ፥ ይሁዲችለከ ዮርዳኖስ ዛዘኖ ዊ ዉድ አዲች አሜቶ ኡመቱ ኢሰ አዎንቶኡ።<verse eid="MAT 4:25"/></para>
  <chapter eid="MAT 4"/>
  <chapter number="5" style="c" sid="MAT 5"/>
  <para style="s1">ኢስ ቆተ አሌን ተማርሱስ</para>
  <para style="r">(ፎሎጨት 5—7)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1"/>ኢስ ልግብ ኡመት ለዕይ ቆተ አል ፉል ህከኔ አፉዕሌ ወክት አሳበስ እስቤቹ ሆንጠኮኡ። <verse eid="MAT 5:1"/><verse number="2" style="v" sid="MAT 5:2"/>እሰንተ ተማርሱ ጀመሮ።<verse eid="MAT 5:2"/></para>
  <para style="s1">ሀንቅ በረከተ ደዕተ መነ</para>
  <para style="r">(<ref loc="LUK 6:20-23">ሉቃ. 6፥20-23</ref>)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3"/>ኢስ «ገዉሰ ሆፍስ መገኖን ድከኣእሩ</para>
  <para style="q2" vid="MAT 5:3">ሰሜ ዎምነቱ እሳሃ እኮቤቺሃ ማሰአንቶእረ።<verse eid="MAT 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4"/>ሻዛሩ መገኑ ሰብር ኣሰኖሰቤቺሃ ማሰአንቶእረ።<note caller="-" style="x"><char style="xo" closed="false">5፥4 </char><char style="xt" closed="false"><ref loc="ISA 61:2">ኢሳ. 61፥2</ref>።</char></note><verse eid="MAT 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5"/>መረርሲጭታእሩ ኡለተ ረገኣቤቺሃ ማሰአንቶእረ።<note caller="-" style="x"><char style="xo" closed="false">5፥5 </char><char style="xt" closed="false"><ref loc="PSA 37:11">መዝ. 37፥11</ref>።</char></note><verse eid="MAT 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6"/>መገን ፈይመተ ጎራይታሩለከ ሰገባእሩ</para>
  <para style="q2" vid="MAT 5:6">መገኑ ዱሰኖሰቤቺሃ ማሰአንቶእረ።<note caller="-" style="x"><char style="xo" closed="false">5፥6 </char><char style="xt" closed="false"><ref loc="ISA 55:1-2">ኢሳ. 55፥1-2</ref>።</char></note><verse eid="MAT 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7"/>አሙዛእሩ መገኑ አሙዘኖሰቤቺሃ ማሰአንቶእረ።<verse eid="MAT 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8"/>ነጡ ቀልቡ ዮሰሩ</para>
  <para style="q2" vid="MAT 5:8">መገኑ ለኣቤቺሃ ማሰአንቶእረ።<note caller="-" style="x"><char style="xo" closed="false">5፥8 </char><char style="xt" closed="false"><ref loc="PSA 24:3-4">መዝ. 24፥3-4</ref>።</char></note><verse eid="MAT 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9"/>ሀራርስታእሩለከ ወገሬት አታእሩ</para>
  <para style="q1" vid="MAT 5:9">መገን እለተ የመንታቤቺሃ ማሰአንቶእረ።<verse eid="MAT 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10"/>መገኒሃ አዘዘንቶቤቺሃ ያየንታሩ</para>
  <para style="q2" vid="MAT 5:10">ሰሜ ዎምነቱ እሳሃ እሀኖቤቺሃ ማሰአንቶእረ።<note caller="-" style="x"><char style="xo" closed="false">5፥10 </char><char style="xt" closed="false"><ref loc="1PE 3:14">1 ጴጥ. 3፥14</ref>።</char></note><verse eid="MAT 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11"/>«ኢ መሳን መኑ ቦሮረንክዕኔለከ ሸረንክዕኔ ክዝቢን ሱዕመክዕኔ ቤሴነኒሁ ተሽ ዩንክዕኔ።<note caller="-" style="x"><char style="xo" closed="false">5፥11 </char><char style="xt" closed="false"><ref loc="1PE 4:14">1 ጴጥ. 4፥14</ref>።</char></note> <verse eid="MAT 5:11"/><verse number="12" style="v" sid="MAT 5:12"/>ህካን እኮቤቺሃ ሰማን ሎረ ዋገ ኣእቴነንተቤቺሃ ሙንደዕዬ፤ ተሽ ዩንክዕኔ፤ ክዕኔች ብርተ ሄኦ ነብያኑት ህትን ኦርጨቀንቶኡ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">5፥12 </char><char style="xt" closed="false"><ref loc="2CH 36:16">2 ዱዱ. 36፥16</ref>፤ <ref loc="ACT 7:52">ሶቀ. 7፥52</ref>።</char></note><verse eid="MAT 5:12"/></para>
  <para style="s1">መጥኔለከ ኑር ምሳልተ</para>
  <para style="r">(<ref loc="MRK 9:50">ማር. 9፥50</ref>፤ <ref loc="LUK 14:34-35">ሉቃ. 14፥34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13"/>ኢስን «አዕኑ ዱንየ አልሃ መጥኔተ፤ ጠዉ እኮጎሬ መጥንት ጤኡ ሆጋረ ሀት አኤን ጤኣገ አኤኖሴ? ህት መጥንት መቶርቺሃ ደግለልታበእቤቺሃ ቶሬናንሴ መኑ ሎካን ከደኖሴ ቤሉ መቶርቺሃ ደግለልታበአ።<note caller="-" style="x"><char style="xo" closed="false">5፥13 </char><char style="xt" closed="false">ማቶ. 9፥50፤ <ref loc="LUK 14:34-35">ሉቃ. 14፥34-35</ref>።</char></note> <verse eid="MAT 5:13"/><verse number="14" style="v" sid="MAT 5:14"/>አዕኑ ኣዱንያ አሊሃ ጉዕሚንከ ኑርሃ፤ ቆተ አሌን ዮ ከተሙ ማጠሞተ አታለኖበአ።<note caller="-" style="x"><char style="xo" closed="false">5፥14 </char><char style="xt" closed="false"><ref loc="JHN 8:12">ያህ. 8፥12</ref>፤ <ref loc="JHN 9:5">9፥5</ref>።</char></note> <verse eid="MAT 5:14"/><verse number="15" style="v" sid="MAT 5:15"/>አዪሁ ኩራዘ ለሊሽ ምኒ ኣዜን ዮ መኒሃ ጉዕሚንከ ለለኖ ቤቾን አፉሸኖ ቤሉ ሎንቆች ዎሮን አፉሸኖበአ።<note caller="-" style="x"><char style="xo" closed="false">5፥15 </char><char style="xt" closed="false"><ref loc="MRK 4:21">ማር. 4፥21</ref>፤ <ref loc="LUK 8:16">ሉቃ. 8፥16</ref>፤ <ref loc="LUK 11:33">11፥33</ref>።</char></note> <verse eid="MAT 5:15"/><verse number="16" style="v" sid="MAT 5:16"/>ህትን መኑ ክዕኔ ጡመ ሆጉክዕኔ ለእ ሰማን ዮ አነክዕኔ ገለትጭቶተ ክዕኔ ኑሩሁ መኒሃ ለሉን» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">5፥16 </char><char style="xt" closed="false"><ref loc="1PE 2:12">1 ጴጥ. 2፥12</ref>።</char></note><verse eid="MAT 5:16"/></para>
  <para style="s1">ሕግ ትምህርትተኔሃ</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17"/>ህትን ኢስ «መገኑ ሙሲሃ ኣሴ ሕገለከ ነብያኑት ተማርስቶኢሃ ድጆተ አሜቾሚሃ አጉዱንከህዕኔ፤ አን እሰ ተማርስቶኢሃ አቶኖተ አሜቾም ቤሉ ድጆተ አሜቾምበአ። <verse eid="MAT 5:17"/><verse number="18" style="v" sid="MAT 5:18"/>ሀንቅንከ ያንክዕኔ፤ ኡለትለከ ሰሞሁ ህጎተ ኢለ ኩ ሕጉ ጉዕሙንኩ ዊመኖ ቤሉ ሕጊች መት እልቲ በኣበአ።<note caller="-" style="x"><char style="xo" closed="false">5፥18 </char><char style="xt" closed="false"><ref loc="LUK 16:17">ሉቃ. 16፥17</ref>።</char></note> <verse eid="MAT 5:18"/><verse number="19" style="v" sid="MAT 5:19"/>ህካን እኮቤቺሃ አዪሁ ሕጊች ቀውሃሲ አዘዘምበጎሬለከ መኑ አዘዘመኖበእገ ተማርሴጎሬ እስ ሰሜ ዎምነቴን ጉዕሚችን ቀዉ እሀኖ፤ ጠዉ እኮጎሬ ሕገ ቶገኖሁለከ ዎሉ መኑ ሕገ ቶጋገ ተማርሰኖሁ ሰሜ ዎምነቴን ሎረ እሀኖ። <verse eid="MAT 5:19"/><verse number="20" style="v" sid="MAT 5:20"/>ህካን እኮቤቺሃ ክዕኔ ፈይመት ሕግ አስተማራችለከ ፈርሳዌ ፈይማች በተእባች ሆሮ ሰሜ ዎምነቱ ኣጌነንተበእገ ኩላንክዕኔ።<verse eid="MAT 5:20"/></para>
  <para style="s1">ኡሙዕሬተኔሃ ተማርሴገ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21"/>«ዎዕኔ ዘማን መኒሃ ‹መነ ሽቶት፤ መነ ሼ አን አሌን ፈረደመኖስ› የመሞሃ ሞጮጭቴንታአ።<note caller="-" style="x"><char style="xo" closed="false">5፥21 </char><char style="xt" closed="false"><ref loc="EXO 20:13">ፉል. 20፥13</ref>፤ <ref loc="DEU 5:17">ዘዳ. 5፥17</ref>፤ <ref loc="DEU 16:18">16፥18</ref>።</char></note> <verse eid="MAT 5:21"/><verse number="22" style="v" sid="MAT 5:22"/>እኮጎሬ አን ያሚሁ ከኒት፤ አመስ ቤቲን ኡሙዕረኖሀኒን ፈረደመኖስ፤ አመስቤቱ ቦሮረኖሁ ኦገት ዳኛኖበ ሆንጠሀኖ፤ ህትን ‹ኩ ደግለልትባሁ› ይ መነ ቦሮረኖሁ ሆሮን ጠእትበ ጊራን ፍርደ ኣአኖ። <verse eid="MAT 5:22"/><verse number="23" style="v" sid="MAT 5:23"/>መገኒሃ ክትሜኖ ጠረጴዝ አሌን ክትመ ሆንጠህሳንት ወክት ኪን ኡሙዕሬሄሃ ሰውይቶንትጎሬ <verse eid="MAT 5:23"/><verse number="24" style="v" sid="MAT 5:24"/>ክትመ ሆንጠህሳንት ጠረጴዝ አሌን ህከኔ ጌኝአት አመክቤትበ መርት ሀራዕረም፤ ህከኒች ኤተሮን አሜት ክትመ ሆንጠህስ። <verse eid="MAT 5:24"/><verse number="25" style="v" sid="MAT 5:25"/>ባለጋሩክ ከሰሻንኬ ፍርድ ምኔን ኡርታንትሀኒች ሄጭት ባለጋርንከክ ሀራዕረም፤ ህካን አትበጎሬ ባለጋሩክ ዳኚሃ ህግሽ ኣሰኖሄ፤ ዳኙንኩ ኡሱር ምኒ ኣግሰኖሄ። <verse eid="MAT 5:25"/><verse number="26" style="v" sid="MAT 5:26"/>ሀንቅንከ ያንኬ፤ አሌክ ዮ ኤዳሃ ሹልት ባቱዕነ ኡሱር ምኒች ሆሮ ፉልታንትበአ» ዬእ።<verse eid="MAT 5:26"/></para>
  <para style="s1">ዝነት ሂለ እሁስ ተማርሴገ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27"/>ኢስ « ‹ዝነተ አቶኖቼ› የመሞሃ ሞጮጭቴንታአ። <verse eid="MAT 5:27"/><verse number="28" style="v" sid="MAT 5:28"/>እኮጎሬ ቴሱ አን ኩላንክዕኔ፤ መንቹተ ለዕይ ቀልቤስ ሄዕላቾ መንቹ ዝነተ አዕዮሀንገ ዎለአመኖ። <verse eid="MAT 5:28"/><verse number="29" style="v" sid="MAT 5:29"/>መኬክ እልት ጅስሚችክ መቱስ ሉስሶ ጎሬ እሴተ ፉሽት ኡጅ፤ መሰንትስ ዊሙ ጅስሙክ አዛቤን ቡበኖሀኒች ጅስሚችክ መትተ እልተ ሆጎንቲሁ ቆሀኖ።<note caller="-" style="x"><char style="xo" closed="false">5፥29 </char><char style="xt" closed="false"><ref loc="MAT 18:9">ማቶ. 18፥9</ref>፤ <ref loc="MRK 9:47">ማር. 9፥47</ref>።</char></note> <verse eid="MAT 5:29"/><verse number="30" style="v" sid="MAT 5:30"/>መኬክ አንገክ ሉሲሶሄ ጎሬ ሙርት ኡጅ፤ መሰንትስ ጅስሙክ ጉዕሙንኩ አዛቤን ኣገኖሀኒች ጅስሚችክ መኬክ አንገተ ሆጎንቲሁ ቆሀኖ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">5፥30 </char><char style="xt" closed="false"><ref loc="MAT 18:8">ማቶ. 18፥8</ref>፤ <ref loc="MRK 9:43">ማር. 9፥43</ref>።</char></note><verse eid="MAT 5:30"/></para>
  <para style="s1">ጫተ ገፈርተኔሃ ተማርሱስ</para>
  <para style="r">(<ref loc="MAT 19:9">ማቶ. 19፥9</ref>፤ <ref loc="MRK 10:11-12">ማር. 10፥11-12</ref>፤ <ref loc="LUK 16:18">ሉቃ. 16፥18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31"/>ህትን «ጫስ ገፍረኖሁ ጉዕሙንኩ ገፈሮ ፉርመ ኣሱንሴ» የመሞኡ።<note caller="-" style="x"><char style="xo" closed="false">5፥31 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">ዘዳ. 24፥1-4</ref>፤ <ref loc="MAT 19:7">ማቶ. 19፥7</ref>፤ <ref loc="MRK 10:4">ማር. 10፥4</ref>።</char></note> <verse eid="MAT 5:31"/><verse number="32" style="v" sid="MAT 5:32"/>እኮጎሬ ቴሱ አን ኩላንክዕኔ፤ ዝነተ አቱዕነ መንቹስ ገፈረኖሁ ጉዕሙንኩ ዝነተ አታገ አአኖሴ፤ ህተ ገፈሮ መንቹተ ኣአኖሁ ጉዕሙንኩ ዝነተ አዕዮሃ እሀኖ።<note caller="-" style="x"><char style="xo" closed="false">5፥32 </char><char style="xt" closed="false"><ref loc="MAT 19:9">ማቶ. 19፥9</ref>፤ <ref loc="MRK 10:11-12">ማር. 10፥11-12</ref>፤ <ref loc="LUK 16:18">ሉቃ. 16፥18</ref>፤ <ref loc="1CO 7:10-11">1 ቆሮ. 7፥10-11</ref>።</char></note><verse eid="MAT 5:32"/></para>
  <para style="s1">ጤሌዕልተኔሃ ኣሰሞ ትምርት</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33"/>ህትን «ከኒች ብርተ ሄኦ መኒሃ ‹መገኒሃ ኣጎንት ወኣድ ላገተ ዊንሽ ቤሉ ድጅቶት› የመሞሃ ሞጮጭቴንታአ።<note caller="-" style="x"><char style="xo" closed="false">5፥33 </char><char style="xt" closed="false"><ref loc="LEV 19:12">ሌዌ 19፥12</ref>፤ <ref loc="NUM 30:2">ዘኁ. 30፥2</ref>፤ <ref loc="DEU 23:21">ዘዳ. 23፥21</ref>።</char></note> <verse eid="MAT 5:33"/><verse number="34" style="v" sid="MAT 5:34"/>እኮጎሬ አን ቴሱ ኩላንክዕኔ፤ ሰማን ሆሮ ጤሌዕልቶኖቼ፤ መሰንትስ ሰሞሁ መገን ጄነትተ ቦርጭመ።<note caller="-" style="x"><char style="xo" closed="false">5፥34 </char><char style="xt" closed="false"><ref loc="JAS 5:12">ያቁ. 5፥12</ref>፤ <ref loc="ISA 66:1">ኢሳ. 66፥1</ref>፤ <ref loc="MAT 23:22">ማቶ. 23፥22</ref>።</char></note> <verse eid="MAT 5:34"/><verse number="35" style="v" sid="MAT 5:35"/>ኡላን እኮ እቃ ጤሌዕልቶኖቼ፤ ኡለት መገን ሎከት ፎሎጭታሃ ቤቹ፤ ህትን ዬሩሳሌማኒ ጤሌዕልቶኖቼ፤ ዬሩሳሌሙ ሎረ ዎምየ ከተመ፤ ህካን ኦኮቤቺሃ ሆሮ ጤሌዕልቶኖቼ።<note caller="-" style="x"><char style="xo" closed="false">5፥35 </char><char style="xt" closed="false"><ref loc="ISA 66:1">ኢሳ. 66፥1</ref>፤ <ref loc="PSA 48:2">መዝ. 48፥2</ref>።</char></note> <verse eid="MAT 5:35"/><verse number="36" style="v" sid="MAT 5:36"/>ሙሚችክ መትተ ዋጁተ ህከረንገ ገንበለ አቶተ አታልታንትበእቤቺሃ ጤሌዕልቶት። <verse eid="MAT 5:36"/><verse number="37" style="v" sid="MAT 5:37"/>ህካን እኮቤቺሃ ጠወኤነታሁ እሀኖሀ እሀኖ እህባሁ እሀኖበአ ዩ ሀስሰኖ፤ ከኒች አደ እካ ላገት ጉዕሙንኩ ሸይጣንቺት» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">5፥37 </char><char style="xt" closed="false"><ref loc="LEV 19:12">ሌዌ 19፥12</ref>፤ <ref loc="NUM 30:2">ዘኁ. 30፥2</ref>፤ <ref loc="DEU 23:21">ዘዳ. 23፥21</ref>።</char></note><verse eid="MAT 5:37"/></para>
  <para style="s1">ገዱተ አፉ ሀስሲባሃ እሁስ</para>
  <para style="r">(<ref loc="LUK 6:29-30">ሉቃ. 6፥29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38"/>እስን « ‹እልተ ፉሼሀኒሃ እልስ ፉሽ፤ እንኩተ ብጮሀኒሃ እንኩስ ቢጥ› የመሞሃ ሞጮጭቴንታአ።<note caller="-" style="x"><char style="xo" closed="false">5፥38 </char><char style="xt" closed="false"><ref loc="EXO 21:24">ፉል. 21፥24</ref>፤ <ref loc="LEV 24:20">ሌዌ 24፥20</ref>፤ <ref loc="DEU 19:21">ዘዳ. 19፥21</ref>።</char></note> <verse eid="MAT 5:38"/><verse number="39" style="v" sid="MAT 5:39"/>እኮጎሬ ቴሱ ኩላንክዕኔሁ አዕኑ አዬሃ ገዱተ ፈንቀሽቶኖቼ፤ አዪሁ መኬክ መጫለ ዎቀረኖሀኒሃ ጉረ አድ መጫለ ዎቀሮተ ኣስ። <verse eid="MAT 5:39"/><verse number="40" style="v" sid="MAT 5:40"/>መቱ መንቹ ሸሚዘክ ኣኦተ ሀሽ ከሰሾሄ ጎሬ ኮቴክ በርግት ኣስ። <verse eid="MAT 5:40"/><verse number="41" style="v" sid="MAT 5:41"/>መቱ መንቹ ‹ቀዉ ጌሰ ህርሲሴኤ› ዬጎሬ አት ለሙ አፎ በርግት ህርሲስስ። <verse eid="MAT 5:41"/><verse number="42" style="v" sid="MAT 5:42"/>ኡጨኖሄሀኒሃ ኣስ፤ ህትን ሌቄጮተ ሀሰኖሀኒሃ ሌቄስስ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">5፥42 </char><char style="xt" closed="false"><ref loc="DEU 15:8">ዘዳ. 15፥8</ref>፤ <ref loc="PRO 24:29">ምሳ. 24፥29</ref>።</char></note><verse eid="MAT 5:42"/></para>
  <para style="s1">ዲነ ኢትተኔሃ</para>
  <para style="r">(<ref loc="LUK 6:27-36">ሉቃ. 6፥27-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43"/>ኢስን « ‹ጃለክ ኢት! ዲነክ ግብ› ዬማሃ ሞጮጭቴንታአ።<note caller="-" style="x"><char style="xo" closed="false">5፥43 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ሌዌ 19፥18</ref>።</char></note> <verse eid="MAT 5:43"/><verse number="44" style="v" sid="MAT 5:44"/>እኮጎሬ አን ኩላንክዕኔ፤ ዲነክዕኔ ኢትዬ፤ ሸርታህዕኔሀኑኡተ ዱአ አዕዬ ያንክዕኔ።<note caller="-" style="x"><char style="xo" closed="false">5፥44 </char><char style="xt" closed="false"><ref loc="PRO 25:21-22">ምሳ. 25፥21-22</ref>።</char></note> <verse eid="MAT 5:44"/><verse number="45" style="v" sid="MAT 5:45"/>ህካን አቴንተጎሬ ሰማን አኒሃክዕኔ እለተ እኬነንተ፤ መሰንትስ እስ ሂላኖተለከ ጡመ መኒሃ አሩ ፉሸኖ፤ ህትን ፈየ መኒሃለከ ጩበኛኖተ ጤነ ኣሰኖ። <verse eid="MAT 5:45"/><verse number="46" style="v" sid="MAT 5:46"/>ኢተኖህዕኔሃ ኢትቴንተ ጎር መ ዋጉ ዮህዕኔ? ህካን ጩበኛኑንት አታእሃበእንዶ? <verse eid="MAT 5:46"/><verse number="47" style="v" sid="MAT 5:47"/>ጠለዕል እሉክዕኔ ወገሬትሴንተ ጎሬ ዎሎ መኒች መ ቆኬነን? ህካን አይሁደ እኮበእ መኑሁ አታአ። <verse eid="MAT 5:47"/><verse number="48" style="v" sid="MAT 5:48"/>ህካን እኮቤቺሃ ሰማን ዮ አኑክዕኔ ኩሌኖስሁ ዮበኢሃ እኮገን አዕኑሁ ኩሌኖህዕኔርቹ ዮበእረ እኬ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">5፥48 </char><char style="xt" closed="false"><ref loc="LEV 19:2">ሌዌ 19፥2</ref>፤ <ref loc="LEV 18">18</ref>፤ <ref loc="DEU 18:13">ዘዳ. 18፥13</ref>።</char></note><verse eid="MAT 5:48"/></para>
  <chapter eid="MAT 5"/>
  <chapter number="6" style="c" sid="MAT 6"/>
  <para style="s1">ሰደቀተ ኣስተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1"/>ኢስን «ጡመተ ሆጉተ አቴንተገ መኑ ለዕይ ገለትጩን ይቴን መን ብሬን አኢች አገዕርዬ፤ ህካን አቴንተጎር ሰማን ሄዕዮ መገኒች መቱርቹሃ ደእቴነንተበአ።<note caller="-" style="x"><char style="xo" closed="false">6፥1 </char><char style="xt" closed="false"><ref loc="MAT 23:5">ማቶ. 23፥5</ref>።</char></note> <verse eid="MAT 6:1"/><verse number="2" style="v" sid="MAT 6:2"/>ህካን እኮቤቺሃ ቡጥቻኖተ ሰደቀተ ኣቴነንተ ወክት መኑ ለኦሰተ አታ መኑ ዱአ አኤኖ ምናን አታሀንገ መኑ ለኡኔ ይቴን አቶኖቼ፤ ሀንቅንከ ያንክዕኔ፤ እሰ ሆጎሰ ዋገ ኣእቶኡ። <verse eid="MAT 6:2"/><verse number="3" style="v" sid="MAT 6:3"/>እኮጎሬ አት ቡጥቻኖተ ሰደቀተ ኣታንት ወክት አዪሁ ደጉዕነ ማጥ ኣስ። <verse eid="MAT 6:3"/><verse number="4" style="v" sid="MAT 6:4"/>መሰንትስ ማጥ ሰደቀተ ኣሱክ ደገኖ መገኑ ጡመ ሆጎክ ወጥ ኣሰኖሄ» ዬእ።<verse eid="MAT 6:4"/></para>
  <para style="s1">ዱአ አእተኔሃ</para>
  <para style="r">(<ref loc="LUK 11:2-4">ሉቃ. 11፥2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5"/>ኢስን «ዱአ አቴነንተ ወክት መኑ ለኦሰተ ዱአ አኤኖ ምናንለከ ዎቄ ገበላን ኡርት አታ መንገ አቶኖቼ፤ ሀንቅንከ ያንክዕኔ፤ እሰ ሆጎሰ ወጥ ኣእቶኡ።<note caller="-" style="x"><char style="xo" closed="false">6፥5 </char><char style="xt" closed="false"><ref loc="LUK 18:10-14">ሉቃ. 18፥10-14</ref>።</char></note> <verse eid="MAT 6:5"/><verse number="6" style="v" sid="MAT 6:6"/>ዱአ አቴነንተ ወክት ምንክ ኣግ ጡፈ ጡፍ ማጠም ዮ አንክ ቤቹ ዱአ አእ፤ ማጤን አኤማሃ ለአኖ መገኑክ ጡመ ሆጎክ ዋገ ባተኖሄ። <verse eid="MAT 6:6"/><verse number="7" style="v" sid="MAT 6:7"/>ዱአ አታንት ወክት አይሁደ እኮበእ መንገ ፈንቀላንስቴነን ዱአ አቶኖቼ፤ ሁኩ መኑ ፈንቀላንስት ዱአ አቶቤቺሃ መገኑ ሞጮጨኖሳሃ አት ቂራርስት ዱአ አታአ።<note caller="-" style="x"><char style="xo" closed="false">6፥7 </char><char style="xt" closed="false"><ref loc="1KI 18:25-29">1 ነገ. 18፥25-29</ref>።</char></note> <verse eid="MAT 6:7"/><verse number="8" style="v" sid="MAT 6:8"/>አዕኑ እሰገ እኮኖቼ፤ እስን ክዕኔ አኑ ሀስሰኖህዕኔሃ ጠዕምቶኑዕነ ሄጭ ደገኖ።<verse eid="MAT 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9"/>«ህካን እኮቤቺሃ</para>
  <para style="q1" vid="MAT 6:9">« ‹ሰማን ዮንቲ ኒ አኑ!</para>
  <para style="q2" vid="MAT 6:9">ጠሊሉ ሱዕሙክ ሎዕሩን፤<verse eid="MAT 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10"/>ዎምነቱክ አሜቱን፤</para>
  <para style="q1" vid="MAT 6:10">ሃሽኣቱክ ሰማን እኮገን</para>
  <para style="q2" vid="MAT 6:10">ህትን ኣዱንያ አሌን እኩን።<verse eid="MAT 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11"/>ከበሬተ እካኔ እቸተ ኣስኔ።<verse eid="MAT 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12"/>ነኡ ዎሎ መኒ ቤሱ አጉርናምገን</para>
  <para style="q2" vid="MAT 6:12">ኒ ቤሱሃ አጉርኔ።<verse eid="MAT 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13"/>ሂለርቺች ጡምስኔ ቤሉ</para>
  <para style="q2" vid="MAT 6:13">ፌተናን ኣግሶትኔ፤</para>
  <para style="q2" vid="MAT 6:13">ኣሚዕን› ይቴነን ዱአ አዕዬ።<verse eid="MAT 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14"/>«መን ቤሱ አጉርቴንተ ጎሬ ሰማን ዮ አኑክዕኔ ክዕኔ ቤሱሃ አጉረኖህዕኔ። <verse eid="MAT 6:14"/><verse number="15" style="v" sid="MAT 6:15"/>ጠዉ እኮጎሬ መን ቤሱ አጉሮንስ ይቴንባች ሰማን ዮ አኑክዕኔ ክዕኔ ቤሱሃ አጉረኖህዕኔበአ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">6፥15 </char><char style="xt" closed="false"><ref loc="MAT 11:25-26">ማቶ. 11፥25-26</ref>።</char></note><verse eid="MAT 6:15"/></para>
  <para style="s1">ሶመንተኔሃ ተማርሱስ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16"/>ኢስ «ሶመንቴነንተ ወክት መኑ ለኦሰተ አታ መንገ ሻዞኖቼ፤ እሰ ሶመኑሰ መኑ ለኦተ ይት ሚንሰ ቤሳአ፤ ሀንቅንከ ያንክዕኔ፤ እሰ ሆጎሰ ወጥ ኣእቶኡ።<note caller="-" style="x"><char style="xo" closed="false">6፥16 </char><char style="xt" closed="false"><ref loc="ISA 58:5">ኢሳ. 58፥5</ref>።</char></note> <verse eid="MAT 6:16"/><verse number="17" style="v" sid="MAT 6:17"/>ጠው እኮጎሬ አት ሶመንታንት ወክት ሚንተ ኣዕልት ቡዕለክ ቡዕር። <verse eid="MAT 6:17"/><verse number="18" style="v" sid="MAT 6:18"/>ህካን አቶንትጎሬ ማጭ ለአኖ አኒክ ቤሉ ዎሉ አዪሁ ለአኖበአ፤ ማጭ ለአኖ አኑክ ሆጎክ ወጥ ኣሰኖሄ» ዬእ።<verse eid="MAT 6:18"/></para>
  <para style="s1">ዱንያተ ጭም አኡ ገበእባሃ እሁስ</para>
  <para style="r">(<ref loc="LUK 12:33-34">ሉቃ. 12፥33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19"/>ኢስ «ሞጋኑት ኣግ ቢጥ ሞግታቤቾኒ፥ ብሉት እታቤቾንለከ ቡሃይ በአኖቤቾን ዱንያክዕኔ ኣዱንያ አሌን ጭምአቶኖቼ።<note caller="-" style="x"><char style="xo" closed="false">6፥19 </char><char style="xt" closed="false"><ref loc="JAS 5:2-3">ያቁ. 5፥2-3</ref>።</char></note> <verse eid="MAT 6:19"/><verse number="20" style="v" sid="MAT 6:20"/>ጠዉ እኮጎሬ ብሉት እታበእቤቾኒ፥ ቡሃይ በአኖበእቤቾንለከ ሞጋኑት ቢጥ ኣግ ሞግታበእቤቾን ሰማን ዱንያክዕኔ ጭም አእዬ። <verse eid="MAT 6:20"/><verse number="21" style="v" sid="MAT 6:21"/>ህካን እኮቤቺሃ ዱንያክ ዮቤቾን ቀልቡክ ህከኔ ሄአኖ» ዬእ።<verse eid="MAT 6:21"/></para>
  <para style="s1">ጅስም ኑር</para>
  <para style="r">(<ref loc="LUK 11:34-36">ሉቃ. 11፥34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22"/>ኢስን «እልክ ጅስምሀክ ኑርሃን፤ እልክ ፈየተ እኮጎሬ ጅስሙክ ጉዕሙንኩ ኑር እክ ለለኖ። <verse eid="MAT 6:22"/><verse number="23" style="v" sid="MAT 6:23"/>እልክ ፈየተ እክበጎሬ ጅስሙክ ጉዕሙንኩ ቱንስቹ እሀኖ፤ ህካን እኮቤቺሃ ኬሳን ዮ ኑሩ ቱንስቹ እኮጎሬ ቱንስቹስ ሄንከ በተአኖሃ እሀኖ?» ዬእ።<verse eid="MAT 6:23"/></para>
  <para style="s1">ሄእተኔሃ ጨነቀሙ ገበእባሃ እሁስ</para>
  <para style="r">(<ref loc="LUK 16:13">ሉቃ. 16፥13</ref>፤ <ref loc="LUK 12:22-31">12፥22-31</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24"/>ህትን ኢስ «መቱ መንቹ ለሞ ቀርቺሃ ጠገሞተ አታለኖበአ፤ መቱስ ኢተኖ፤ ዎሉስንገ ግበኖ፤ ህከረንገ መቱስ ሎርሰኖ፤ ዎሉስንገ ህንቀኖ፤ ህትን መገኒሃለከ ብሪሃ ጠገሚሃ አታልቴነንተበአ። <verse eid="MAT 6:24"/><verse number="25" style="v" sid="MAT 6:25"/>ህካን እኮቤቺሃ አን ኩላንክዕኔ ‹መ እንታም? መ አንጋም? መ ኦደዕናም?› ይቴን ሄእክዕኔተኔሃ ሻዞኖቼ፤ እቲች ሄኡ ኦድኖች ጅስሙ በተአኖበእንዶ? <verse eid="MAT 6:25"/><verse number="26" style="v" sid="MAT 6:26"/>ህንዴ ሰማን ብርይታ ጪኡተ ለዕዬ፤ እሰ ዉጣበአ፤ ምዳበአ፤ ቀፎኒ ዎርታበአ፤ ጠዉ እኮጎሬ ሰሜ አኑክዕኔ እትሰኖሰ፤ ህከረ አዕኑ ጪኦች በተኤነንተበእንዶ? <verse eid="MAT 6:26"/><verse number="27" style="v" sid="MAT 6:27"/>ክዕኔኤች ጨነቀም ኡሙሬንከስ መቱ በር<note caller="+" style="f"><char style="fqa" closed="false">ኡሙርስ ዘማኔን መቱ በር፦ </char><char style="ft" closed="false">የኖሁ መት መቶ ፈሰሬመ መጻፋን «ኡርሸስ አሌን መት ብኩተ» የኖሁ ሄአኖ።</char></note> በርጎተ አታለኖሁ አዬት?<note caller="-" style="x"><char style="xo" closed="false">6፥27 </char><char style="xt" closed="false"><ref loc="PSA 39:5-7">መዝ. 39፥5-7</ref>።</char></note> <verse eid="MAT 6:27"/><verse number="28" style="v" sid="MAT 6:28"/>ህትን ሚሃ ኦድኖተ ሻዜነንታት? ህንዴ አብሌን ዮ ቦብሉት ነጵታገ ለዕዬ፤ እሰ ገይሀሰ ሆጎን ሆጋበአ ህከረንገ ደዳበአ። <verse eid="MAT 6:28"/><verse number="29" style="v" sid="MAT 6:29"/>አን ኩላንክዕኔ፤ ሆሮ ዎሙ ሱላይማን ህከን ጉዕመንከ ሎርማንተስ ከን ቦብሎች መትሴገ ኦደዕዮበአ።<note caller="-" style="x"><char style="xo" closed="false">6፥29 </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">1 ነገ. 10፥4-7</ref>፤ <ref loc="2CH 9:3-6">2 ዱዱ. 9፥3-6</ref>።</char></note> <verse eid="MAT 6:29"/><verse number="30" style="v" sid="MAT 6:30"/>መገኑ ከበር ለልት ጋቴተ ጊራን ቡባ ህጤተ ህት ኦደኣገ አአኖሃ እኮች አዕኑ አመዕነቱ ሆፈዕዮህዕኔሩ ክዕኔተ ቆህሽ ኦዲሰኖህዕኔ። <verse eid="MAT 6:30"/><verse number="31" style="v" sid="MAT 6:31"/>ህካን እኮች ‹መ እንታም? መ አንጋም? መ ኦደዕናም?› ይቴን ሻዞኖቼ። <verse eid="MAT 6:31"/><verse number="32" style="v" sid="MAT 6:32"/>ህካን አይሁደ እኮበእ መኑሁ ሀሳአ፤ ክዕኔሃ ሁኩ ጉዕሙንኩ ሀስሰኖህዕኔገ ሰሜ አኑክዕኔ ደገኖ። <verse eid="MAT 6:32"/><verse number="33" style="v" sid="MAT 6:33"/>አዕኑ እኮጎሬ ሄጭቴን መገን ዎምነቱስለከ ፈይመስ ሀሼ፤ ሁኩ ጉዕሙንኩ ጠዉ በርገመኖህዕኔ። <verse eid="MAT 6:33"/><verse number="34" style="v" sid="MAT 6:34"/>ህትን ጋቴተክዕኔ ይቴን ሻዞኖቼ፤ ጋት ገዬተሴ ሻዛአ፤ በሪሃስ በሬስ ጭንቀት እካአ» ዬእ።<verse eid="MAT 6:34"/></para>
  <chapter eid="MAT 6"/>
  <chapter number="7" style="c" sid="MAT 7"/>
  <para style="s1">መን አሌን ፈረዱ ገበእባሃ እሁስ</para>
  <para style="r">(<ref loc="LUK 6:37-42">ሉቃ. 6፥37-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1"/>ኢስን «ፈረደመኖህዕኔበእገ ፈረዶኖቼ። <verse eid="MAT 7:1"/><verse number="2" style="v" sid="MAT 7:2"/>መሰንትስ አዕኑ ፈረዴንተገን ፈረደመኖህዕኔ፤ ህትን ብክቴነንተሀኔን ብከመኖህዕኔ።<note caller="-" style="x"><char style="xo" closed="false">7፥2 </char><char style="xt" closed="false"><ref loc="MRK 4:24">ማር. 4፥24</ref>።</char></note> <verse eid="MAT 7:2"/><verse number="3" style="v" sid="MAT 7:3"/>ኪ እሌን ዮ ሎረ ሁረ ለኡዕናን ሀት ኪ አመክ ቤት እሌ ኣዜን ዮ ሁረ ለኣንቲት? <verse eid="MAT 7:3"/><verse number="4" style="v" sid="MAT 7:4"/>ህትን ኪ እሌን ዮ ሎረ ሁረ ከንቱዕነ ኪ አመክቤቱ ‹ህንዴ እሌክ ዮ ሁረ ፉሻም› ይቶተ ሀት አታልተን? <verse eid="MAT 7:4"/><verse number="5" style="v" sid="MAT 7:5"/>አት አን ሎረሃን ይታንቲሁ፤ ሄጭት እሌክ ዮ ሎረ ሁረ ፉሽ፤ ህከኒች ኤተሮን አመክ ቤት እሌን ዮ ሁረ ፉሽቶተ አጥረመት ለኣንት። <verse eid="MAT 7:5"/><verse number="6" style="v" sid="MAT 7:6"/>መገኒሃ አደ እኮርቹ ዉሻተ ኣቶኖቼ፤ ህትን ሎካንከሰ ከድ ቤሳበእገ ዎርቀ ቦኬ ብሬን ኡጅቶኖቼ፤ ዉሸንት ፈንቀልት ገዕምታህዕኔ» ዬእ።<verse eid="MAT 7:6"/></para>
  <para style="s1">ዱአ አኤን ደእተኔሃ</para>
  <para style="r">(<ref loc="LUK 11:9-13">ሉቃ. 11፥9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7"/>ህትን ኢስ «ኡጭዬ ኣእቴነንተ፤ ሀሼ ደእቴነንተ፤ ህትን ኡሩተ ቆጭዬ ፈነመኖህዕኔ። <verse eid="MAT 7:7"/><verse number="8" style="v" sid="MAT 7:8"/>ህካን እኮቤቺሃ አዪሁ ኡጨኖሁ ቶገኖ፤ አዪሁ ሀሾ ጎሬ ደአኖ፤ ህትን አዪሁ ኡሩተ ቆጬጎሬ ፈንተአኖስ። <verse eid="MAT 7:8"/><verse number="9" style="v" sid="MAT 7:9"/>ክዕኔኤች አዪሁ ቤቱስ ዳቡተ ኡጬጎሬ ክኑ ኣሰኖሁ አዬት? <verse eid="MAT 7:9"/><verse number="10" style="v" sid="MAT 7:10"/>ህትን ቁርጩሜተ ኡጬጎሬ ዎሪቹ ኣሰኖንዶ? <verse eid="MAT 7:10"/><verse number="11" style="v" sid="MAT 7:11"/>አዕኑ ሂላኑተ እኬነን እላተክዕኔ ጡመርቹ ኣሱ ደጌንታች ሰማን ዮ አኑክዕኔ ኡጭታሀኑኡተ ጡመርቹ በትሽ ኣሰኖበእንዶ? <verse eid="MAT 7:11"/><verse number="12" style="v" sid="MAT 7:12"/>ህካን እኮቤቺሃ መኑ አሶህዕኔተ ኢትቴንታሃ ጉዕመንከ አዕኑ እሳሃ ህትን አዕዬ፤ መሰንትስ መገን ሕጋን ዬማሁለከ ነብያኑት ኩልቶኢሁ ህከኒት» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">7፥12 </char><char style="xt" closed="false"><ref loc="LUK 6:31">ሉቃ. 6፥31</ref>።</char></note><verse eid="MAT 7:12"/></para>
  <para style="s1">ሩካሸ ኡሮተኔሃ</para>
  <para style="r">(<ref loc="LUK 13:24">ሉቃ. 13፥24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13"/>ኢስ «ሩካሸ ኡሮን ኣጌ፤ መሰንትስ በእቤቹ መስታ ኡሩት አልባዕሎታን፤ ህትን ዎቆሲ ሎረሃን፤ ህከን ዎቃን ሃመኖ መኑ ልግብያ። <verse eid="MAT 7:13"/><verse number="14" style="v" sid="MAT 7:14"/>እኮጎሬ ሄእቤቹ አዎንስታ ኡሩት ሩካሸታን፤ ህትን ዎቆሲ ኦርሰኖሃን፤ ህካን እኮቤቺሃ ህከ ዎቃሃ ደአኖ መኑ ቀዎሃን» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">7፥14 </char><char style="xt" closed="false"><ref loc="JER 21:8">ኤር. 21፥8</ref>፤ <ref loc="DEU 30:19">ዘዳ. 30፥19</ref>።</char></note><verse eid="MAT 7:14"/></para>
  <para style="s1">ሀቁ ላልቺንከስ ደገመኖ</para>
  <para style="r">(<ref loc="LUK 6:43-44">ሉቃ. 6፥43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15"/>ኢስ «አዕኑ ክዝብ ነብያኖች አገዕርዬ፤ እሰ ክዕኔቤቹ ሆለተ አጉድ አሜታአ፤ ጠዉ እኮጎሬ ወልቅሽ እተኖ ኦሌገ ዮእረ።<note caller="-" style="x"><char style="xo" closed="false">7፥15 </char><char style="xt" closed="false"><ref loc="EZK 22:27">ሕዝ. 22፥27</ref>።</char></note> <verse eid="MAT 7:15"/><verse number="16" style="v" sid="MAT 7:16"/>እሰንተ ደጌነንተሳሁ ላልቺንከሳት፤ ኡት ሀቂች ወይነ ዬኖ ላልቹ ህትን ቃልቃልች ኦድ ላልቹ መጤኖበአ። <verse eid="MAT 7:16"/><verse number="17" style="v" sid="MAT 7:17"/>ህትን ጡሙ ሀቁ ጡመ ላልቹ ላለኖ፤ ጠዉ እኮጎሬ ሂሉ ሀቁ ሂለ ላልቹንከ ላለኖ። <verse eid="MAT 7:17"/><verse number="18" style="v" sid="MAT 7:18"/>ጡሙ ሀቁ ሂለ ላልቹ ላሎተ ህትን ሂሉ ሀቁ ጡመ ላልቹ ላሎተ አታለኖበአ። <verse eid="MAT 7:18"/><verse number="19" style="v" sid="MAT 7:19"/>ጡመ ላልቹ ላለኖበእ ሀቀ ጉዕመንከ ሙሬን ጊራን ቡሴኖ።<note caller="-" style="x"><char style="xo" closed="false">7፥19 </char><char style="xt" closed="false"><ref loc="MAT 3:10">ማቶ. 3፥10</ref>፤ <ref loc="LUK 3:9">ሉቃ. 3፥9</ref>።</char></note><note caller="-" style="x"><char style="xo" closed="false">7፥19 </char><char style="xt" closed="false"><ref loc="MAT 12:33">ማቶ. 12፥33</ref>።</char></note> <verse eid="MAT 7:19"/><verse number="20" style="v" sid="MAT 7:20"/>ህካን እኮቤቺሃ ክዝብ ነብያኑተ ሆጎሰ ላልቺን ደጌነንተሰ» ዬእ።<verse eid="MAT 7:20"/></para>
  <para style="s1">ኢስ «አን ደጋንክዕኔበአ» ዩስ</para>
  <para style="r">(<ref loc="LUK 13:25-27">ሉቃ. 13፥25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21"/>ኢስ «ሰማን ሄአኖ ኢ አን ሃሽኣቱተ ዊንሸኖሀን ቤሉ ‹ቀርቾ! ቀርቾ!› የኖኤሁ ጉዕሙንኩ ሰሜ ዎምነቱ ሆሮ ኣገኖበአ። <verse eid="MAT 7:21"/><verse number="22" style="v" sid="MAT 7:22"/>ፍርድ በር ልግቡ መኑ ‹ቀርቾ! ቀርቾ! ሱዕሚንከክ ራገ ጠወዕንበእንዶ? ሱዕሚንከክ ሩሃንያ ፉሽንበእንዶ? ህትን ሱዕሚንከክ ልግብ አጀብሲሰኖ ጠወ አዕንበእንዶ?› ይታአ። <verse eid="MAT 7:22"/><verse number="23" style="v" sid="MAT 7:23"/>ህከ ወክት ‹አን ሆሮ ደጋንክዕኔበአ፤ አዕኑ መገን ትዛዝ ቶጌንቡሩ ኢች ካጳ ሽቄ› ያም» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">7፥23 </char><char style="xt" closed="false"><ref loc="PSA 6:8">መዝ. 6፥8</ref>።</char></note><verse eid="MAT 7:23"/></para>
  <para style="s1">ክኖንለከ ሽፋር አሌን እጃረንቶ ምነተ</para>
  <para style="r">(<ref loc="LUK 6:47-49">ሉቃ. 6፥47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24"/>ኢስ «ህከ ኢ ላገተ ሞጮጭ አገረኖ መንቹ ምንስ ክን አሌን ጠረኝሽ እጃሮ ኤንኬዕናሙ መንቹ አጉደኖ። <verse eid="MAT 7:24"/><verse number="25" style="v" sid="MAT 7:25"/>ምንስ አሌን ጠረኙ ጤኑ ኡቦ፤ ድርሱንኩ አሜቾ፤ ህትን ቦብሩ ሀንበሎስ፤ ጠዉ እኮጎሬ ምኑ ክን አሌን እጃረሞቤቺሃ ኡቦበአ። <verse eid="MAT 7:25"/><verse number="26" style="v" sid="MAT 7:26"/>ጠዉ እኮጎሬ ኢ ላገተ ሞጮጭ አገርቡ መንቹ ምንስ ሽፋር አሌን እጃሮ ገወ መንቹ አጉደኖ። <verse eid="MAT 7:26"/><verse number="27" style="v" sid="MAT 7:27"/>ምንስ አሌን ጤኑ ኡቦ፤ ድርሱንኩ አሜቾ፤ ህትን ቦብሩ አበ ሀንበላንስ ምኑስ ሽፋር አሌን እጃረሞቤቺሃ ወክትንከስ ኡቦ፤ ሁኩ ምኑንኩ ሂለገ ኡቦ» ይ ተማርሴእ። <verse eid="MAT 7:27"/><verse number="28" style="v" sid="MAT 7:28"/>ኢስ ህካን ተማርስ ሹሎ ወክት እስ ተማርሴ ትምርታን ኡመቱ አበ አጀብሲጬእ። <verse eid="MAT 7:28"/><verse number="29" style="v" sid="MAT 7:29"/>መሰንትስ እሰተ ተማርሴኢሁ ሹምነቱ ዮስ መንጋት ቤሉ ሕግ አስተማረጋበአ።<note caller="-" style="x"><char style="xo" closed="false">7፥29 </char><char style="xt" closed="false"><ref loc="MRK 1:22">ማር. 1፥22</ref>፤ <ref loc="LUK 4:32">ሉቃ. 4፥32</ref>።</char></note><verse eid="MAT 7:29"/></para>
  <chapter eid="MAT 7"/>
  <chapter number="8" style="c" sid="MAT 8"/>
  <para style="s1">ኢስ ጎግ ጥዘነት አፎስ መንቹ ፈይሱስ</para>
  <para style="r">(<ref loc="MRK 1:40-45">ማር. 1፥40-45</ref>፤ <ref loc="LUK 5:12-16">ሉቃ. 5፥12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1"/>ኢስ ቆታች ድሬ ወክት ልግቡ ኡመቱ አዎንቶስ። <verse eid="MAT 8:1"/><verse number="2" style="v" sid="MAT 8:2"/>ህከ ወክት አሌን ፉልታ ጎግ ጥዘነት<note caller="+" style="f"><char style="fqa" closed="false">ጎግ ጥዘነተ፦ </char><char style="ft" closed="false">የኖሁ ጠሊሉ መጻፉ የኖሁ ጎግ አሌን ፉልታ አደደ ጥዘነተ ጉዕመንካት።</char></note> አፎስ መቱ መንቹ ኢስበ አሜቾ፤ እስን ብሬስ ጉሉጵ «ቀርቾ! ኢትቶንትጎር ነጠ አቶኤተ አታልታንት» ዬእ። <verse eid="MAT 8:2"/><verse number="3" style="v" sid="MAT 8:3"/>ኢስን አንገስ ሂር ህከ መንቹ አፍ «ፈቀጆም ነጠ እህ» ዬእ፤ ህከ ወክት ሁኩ ጎግ ጥዘነት አጉርቶስ። <verse eid="MAT 8:3"/><verse number="4" style="v" sid="MAT 8:4"/>ህከ መንቹ ኢስ «ከ ጠወ አዬሃ ጠወኦት፤ ጠዉ እኮጎሬ ቴሱ መርት ነጠ እሁክ ቂስቺሃ ለልስ፤ ህትን መኒሃ ጉዕሚንከ ምስክር እሆተ ሙስ አዘዦገን መገኒሃ ክትም ሆንጠህስ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">8፥4፤ ሌዌ 4፥1-32።</char></note><verse eid="MAT 8:4"/></para>
  <para style="s1">ኢስ ጥቤ ሀለቅች ካዲንቹ ፈይሱስ</para>
  <para style="r">(<ref loc="LUK 7:1-10">ሉቃ. 7፥1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5"/>ኢስ ቅፍርናሆም ከተመ ኣጎ ወክት መቱ ጥቤ ሀለቁ ኢስበ አሜች <verse eid="MAT 8:5"/><verse number="6" style="v" sid="MAT 8:6"/>«ቀርቾ! ካዲንቹኤ ናፈ እክ አበ ኦርጨቀመን ምኔን ኦሰዕዮኡ» ዬእ። <verse eid="MAT 8:6"/><verse number="7" style="v" sid="MAT 8:7"/>ኢስን «አን መር ፈይሳንስ» ዬስ። <verse eid="MAT 8:7"/><verse number="8" style="v" sid="MAT 8:8"/>ጠዉ እኮጎሬ ጥቤ ሀለቁ «ቀርቾ! አት ኢ ምኒ ኣጎተ አን በቀዕባ መንቹ፤ ጠዉ እኮጎሬ ጠለዕልመት ላገተ ጠወእ፤ ካድንቹኤ ፈየኖ። <verse eid="MAT 8:8"/><verse number="9" style="v" sid="MAT 8:9"/>አን ገዉንኩእ ኢች አሊን ዮ ዳኚሃ አዘዘማም፤ ህትን ኢች ዎሮን አን አዘዛም ዎታደሩ ዮኤ፤ መቱስ ‹ካጳ ኦሮእ› ዬም ጎሬ ኦሮአኖ፤ ዎሉንገ ‹ከበ አም› ዬም ጎሬ አሜተኖ፤ ኢ ካድንቹንኩ ‹ካን አእ› ዬም ጎሬ አአኖ» ይ ፈንቀሼእ።<verse eid="MAT 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10"/>ኢስ ካን ሞጮጬ ወክት አጀብሲጭ አዎንተን ሄኦ መኒሃ «ሀንቅንከ ያንክዕኔ፤ ህትኔ አመዕነቱ እስራኤላን ደጎምበአ። <verse eid="MAT 8:10"/><verse number="11" style="v" sid="MAT 8:11"/>ከ ጠወ አጥራመቼ፤ ልግቡ መኑ ሸርቂችለከ ገርቢች አሜት ሰሜ ዎምነቴን እብራሂሚን፥ ኢሳቂንለከ ያቁቢን ሜጡበ እክ ማዳን አፉዕልት እታአ።<note caller="-" style="x"><char style="xo" closed="false">8፥11 </char><char style="xt" closed="false"><ref loc="MAT 13:29">13፥29</ref>።</char></note> <verse eid="MAT 8:11"/><verse number="12" style="v" sid="MAT 8:12"/>ሰሜ ዎምነት እለት አብሌ ቱንስቾን ኡጄናንሰ ህከኔ አልፋቴተለከ እንኩተ እጡ እሀኖ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">8፥12፤ ኢሳ. 49፥12፤ 59፥19 ሚል. 1፥11፤ መዝ. 107፥3፤ ማቶ. 22፥13፤25፥30፤ ሉቃ. 13፥28።</char></note> <verse eid="MAT 8:12"/><verse number="13" style="v" sid="MAT 8:13"/>ህከኒች ኤተሮን ኢስ ጥቤ ሀለቂቹ «ኦሮእ፤ አመዕንቶንትገን እሁን» ዬስ፤ ካድንቹስ ህከ ወክት ፈዬእ።<verse eid="MAT 8:13"/></para>
  <para style="s1">ኢስ ልግብ ጥዘናመተ ፈይሱስ</para>
  <para style="r">(<ref loc="MRK 1:29-34">ማር. 1፥29-34</ref>፤ <ref loc="LUK 4:38-41">ሉቃ. 4፥38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14"/>ኢስ ጴጥሮሴ ምኒ ኣገኖ ወክት ጴጥሮሴ በሉት ፋረ ደሙሜን አበ ጥዣንሴ ኦሰኣን ለዕዮ። <verse eid="MAT 8:14"/><verse number="15" style="v" sid="MAT 8:15"/>እስ አንገሴ ኡሎ ወክት ፋረት አጉርቶሴ፤ እሴን ኬእ እሰንተ ካደንቶኡ። <verse eid="MAT 8:15"/><verse number="16" style="v" sid="MAT 8:16"/>ሀዎሬ ወክት ልግቡ መኑ ሩሃንዩ አፎሰ መነ ኢስበ ኤቦኡ፤ እስን ላጋንተስ ልግብ ዶሮረኖ ዱር ፉሼእ፤ ህትን ጥዘናመተ ጉዕመንከ ፈይሾ። <verse eid="MAT 8:16"/><verse number="17" style="v" sid="MAT 8:17"/>ህካን አዕዮሁ ነብዬቾ እስያሴን «እስ ጥዘነኔ ኣኤእ፤ ጥዘነኔ እጄእ» ዬኢሁ ዊሞታት እቅ።<note caller="-" style="x"><char style="xo" closed="false">8፥17 </char><char style="xt" closed="false"><ref loc="ISA 53:4">ኢሳ. 53፥4</ref>።</char></note><verse eid="MAT 8:17"/></para>
  <para style="s1">ኢስ አሳባተ እልታሰ ኦርሸተ</para>
  <para style="r">(<ref loc="LUK 9:57-62">ሉቃ. 9፥57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18"/>ኢስ ልግቡ ኡመቱ እስ መዴን ጭምዬኢሃ ለዕዮ ወክት «ከን ባርች ዉድ አደ ቶሌ» ይ አሳበስ አዘዦ። <verse eid="MAT 8:18"/><verse number="19" style="v" sid="MAT 8:19"/>ህከኒች ኤተሮን ሕግ አስተማራች መቱ ኢስበ አሜች «አስተማርቾ! አት መርታንትቤቹ ጉዕመንከ አዎናንኬ» ዬስ። <verse eid="MAT 8:19"/><verse number="20" style="v" sid="MAT 8:20"/>ኢስ «ዎለንጌሃ ኤሎ ዮሰ፤ ሰሜ ጪኦንተ ጎዕምት ዮሰ፤ ጠዉ እኮጎሬ መንች ቤቲሃ ገዉስ ፎሎሲሰኖ ቤቹ ዮስበአ» ይ ፈንቀሼእ። <verse eid="MAT 8:20"/><verse number="21" style="v" sid="MAT 8:21"/>ህትን አሳባችስ መቱ «ቀርቾ! ሄጭ መር አነኤ ሞጎተ<note caller="+" style="f"><char style="fqa" closed="false">ሞጎተ፦ </char><char style="ft" closed="false">የኖሁ አኑስ ሬሆተ ኢለ ጦር ሞጎተ ዮስ ሃሽኣቱተ ለሊሰኖሃ አጉደኖ።</char></note> ፈቀደኤ» ዬስ። <verse eid="MAT 8:21"/><verse number="22" style="v" sid="MAT 8:22"/>ጠዉ እኮጎሬ ኢስ «ሬዮ መነ ሬዮ መኑንኩ ሞጉን፤ አት ኤሳሃ አዎኔኤ» ዬስ።<verse eid="MAT 8:22"/></para>
  <para style="s1">ኢስ ዊ ሁለ ጨለ አዕዮገ</para>
  <para style="r">(<ref loc="MRK 4:35-41">ማር. 4፥35-41</ref>፤ <ref loc="LUK 8:22-25">ሉቃ. 8፥22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23"/>ህከኒች ኤተሮን ኢስ ጀልባን ኣጎ ወክት አሳባንት ሜጡበ ኣጎኡ። <verse eid="MAT 8:23"/><verse number="24" style="v" sid="MAT 8:24"/>ጠረኙ ቦብሩ ባር አሌን ኬዕያን ዊ ሁሉ ጀልባ ጥምብሶተ እኮ፤ ጠዉ እኮጎሬ ኢስ ግሾ እቅ። <verse eid="MAT 8:24"/><verse number="25" style="v" sid="MAT 8:25"/>አሳበንት ኢስበ ሆንጠክ «ቀርቾ! በዕናሚት፤ ጡምስኔ» ይት ግሰኛች ኬሶኡ።<verse eid="MAT 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26"/>ኢስን «አዕኑ አመዕነቱ ሆፈዕዮህዕኔሩ፤ ሚሃት ዋጅቴነንታሁ?» ዬሰ፤ ህከኒች ኤተሮን ኢስ ኬዕይ ቦብረለከ ባረንከ አጉረኖገ ሻቃን ጨለ ዬእ። <verse eid="MAT 8:26"/><verse number="27" style="v" sid="MAT 8:27"/>መኑ አበ አጀብሲጭ «ቦብሩለከ ባሩ አዘዘመኖሲሁ ኩን ሀትናሙወ መንቹ» ይቶኡ።<verse eid="MAT 8:27"/></para>
  <para style="s1">ኢስ ዱሪን አፈንቶ ለሙ መነ ፈይሱስ</para>
  <para style="r">(<ref loc="MRK 5:1-20">ማር. 5፥1-20</ref>፤ <ref loc="LUK 8:26-39">ሉቃ. 8፥26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28"/>ኢስ ገሊለ ባረ ቶል ጌርጌሶን ባዱ አሜቾ፤ ህከኔን ሩሃንዩ አፎሰ ለሙ መኑ ሎድ ኣዚች ፉልት ደቀንቶስ፤ እሰ መነ ምርታእረ እኮቤቺሃ አዪሁ ህከን ዎቄን ህጎተ አታለኖበ እቅ። <verse eid="MAT 8:28"/><verse number="29" style="v" sid="MAT 8:29"/>እሰን ያርተን «መገን ቤቶ! ኔሳለከ ኬሳሃ ሚ ደቅንሹ ዮኔ? ወክቱ እሉዕነ ኦርሶኔተ አሜቶንትንዶ?» ይተን ያርቶኡ።<note caller="-" style="x"><char style="xo" closed="false">8፥29 </char><char style="xt" closed="false"><ref loc="JDG 11:12">መሳ. 11፥12</ref>፤ <ref loc="2SA 16:10">2 ሳሙ. 16፥10</ref>።</char></note> <verse eid="MAT 8:29"/><verse number="30" style="v" sid="MAT 8:30"/>እሳች ቀዉንተ ህግ ቦኬ መሰረት ዘግ ይቶ እቅ። <verse eid="MAT 8:30"/><verse number="31" style="v" sid="MAT 8:31"/>ዶሮረኖ ዱሩ «ፉሽታንትኔ ጎሬ ህከን ቦኬ መሰራን ኣንጋምገ አእኔ» ይት ኡጭቶኡ። <verse eid="MAT 8:31"/><verse number="32" style="v" sid="MAT 8:32"/>ኢስን «መሬ» ዬሰ፤ ህከን መኒች ፉልት መርት ቦኬን ኣጎኡ፤ ሁኩ ቦኬ መሰረት ጉዕሙንኩ ቆተ መዲች ደጉደን ባራን ጥንብሰንት ሬቶኡ። <verse eid="MAT 8:32"/><verse number="33" style="v" sid="MAT 8:33"/>ህከን ቦኬ ዜማኑት ሁንት ከተመ ኣግ ጉዕመንከ ጠወለከ ሩሃንዩ አፎ ለሞንከ መናን እኮ ጠወ መኒሃ ጠወኦኡ። <verse eid="MAT 8:33"/><verse number="34" style="v" sid="MAT 8:34"/>ህከኒች ኤተሮን ህከን ከተም መኑ ጉዕሙንኩ ኢሰ ለኦተ መርቶኡ፤ ለኦ ወክት ባዱሰ ገፈር ኦሮአኖገ ኡጭቶስ።<verse eid="MAT 8:34"/></para>
  <chapter eid="MAT 8"/>
  <chapter number="9" style="c" sid="MAT 9"/>
  <para style="s1">ኢስ አንገተ ናፈ መንቹ ፈይሱስ</para>
  <para style="r">(<ref loc="MRK 2:1-12">ማር. 2፥1-12</ref>፤ <ref loc="LUK 5:17-26">ሉቃ. 5፥17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1"/>ኢስ ጀልባን ኣግ ባረ ቶል ገይስ ከተመ አሜቾ። <verse eid="MAT 9:1"/><verse number="2" style="v" sid="MAT 9:2"/>ህከቤቹንከ መቱ ናፈ መንቹ ዴስን እጅት ኤቦኡ፤ ኢስን አመዕነቱሰ ለዕይ «ኢ ቤቶ! ዋጅቶት፤ ጩቡክ ፈቁን የመሞኡ» ዬእ። <verse eid="MAT 9:2"/><verse number="3" style="v" sid="MAT 9:3"/>ህከ ወክት ሕግ አስተማራች መት-መቱ ገገዉንኩሰን «ኩ መንቹ መገን አሌን ቦሮር ላገተ ጠወአኖት» ይት ቀልቤንከሰ ሰውይቶኡ። <verse eid="MAT 9:3"/><verse number="4" style="v" sid="MAT 9:4"/>ጠዉ እኮጎሬ ኢስ ቀልብሰ ጠወ ደግ «አዕኑ ሚሃት ሂለ ጠወ ቀልቤንከክዕኔ ሰውይቴነንታሁ? <verse eid="MAT 9:4"/><verse number="5" style="v" sid="MAT 9:5"/>‹ጩቡክ ፈቁን የመሞሄ› ዪችለከ ‹ኬእ ኡርት ሃም› ዪች ሀኩንስ ቆሀኖ? <verse eid="MAT 9:5"/><verse number="6" style="v" sid="MAT 9:6"/>ጠዉ እኮጎሬ መንች ቤቱ ኣዱንያ አሌን ጩብ ፈቁን ዮተ ወልቀት ዮሲሃ እሁስ ደጌ» ይ ናፈ መንቹ «ኬእ ዴሰክ እጅት ምንክ ኦሮእ» ዬስ። <verse eid="MAT 9:6"/><verse number="7" style="v" sid="MAT 9:7"/>መንቹንኩ ኬዕይ ምንስ ኦሮዕዮ። <verse eid="MAT 9:7"/><verse number="8" style="v" sid="MAT 9:8"/>ኡመቱንኩ ህካን ለኦ ወክት ዋጅት ህትኔ ዎልቀተ መኒሃ ኣሴ መገኑ ገለትጭቶኡ።<verse eid="MAT 9:8"/></para>
  <para style="s1">ኢስ ማቶሴ ዬመ ሌዌ ገኡስ</para>
  <para style="r">(<ref loc="MRK 2:13-17">ማር. 2፥13-17</ref>፤ <ref loc="LUK 5:27-32">ሉቃ. 5፥27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9"/>ኢስ ህከንቤቺች ኬዕይ ኦሮአን «ማቶሴ» ዬኖ ቀረጠ ሙረኖሃ ቀረጠ ሙረኖ ቤቾን አፉዕሌኢሃ ለዕይ «አወኔኤ» ዬስ፤ እስን ኬዕይ አዎኞስ።<verse eid="MAT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10"/>ህከኒች ኤተሮን ኢስ ማቶሴ ምኔን ማዳን አፉዕሌሀኔን ልግቡ ቀረጠ ሙርታእሩለከ ጩበኛኑት ህከ ቤቹ አሜት እሲንለከ አሳባንን ማዳን አፉዕልቶኡ። <verse eid="MAT 9:10"/><verse number="11" style="v" sid="MAT 9:11"/>ህካን ፈርሳውት ለእ አሳበስ «አስተማርቹክዕኔ ጩበኛኖንለከ ቀረጠ ሙርታሀኑኡን ሜጡበ እተኖሁ ሚሃት?» ይቶኡ።<note caller="-" style="x"><char style="xo" closed="false">9፥11 </char><char style="xt" closed="false"><ref loc="MAT 15:1-2">15፥1-2</ref>።</char></note> <verse eid="MAT 9:11"/><verse number="12" style="v" sid="MAT 9:12"/>ጠዉ እኮጎሬ ኢስ ህካን ሞጮጭ «ሀኪሙ ሀስሰኖሁ ጥዘናማታት ቤሉ ፈየ መኒሃትበአ። <verse eid="MAT 9:12"/><verse number="13" style="v" sid="MAT 9:13"/>ኦሮዕዬ ‹አን ኢታሚሁ ማርቱታት ቤሉ ክትምሃትበአ› የመም ከተበሞሃ መሃጎር አጥራመቴን ደጌ፤ አን አሜቾሚሁ ጩበኛኑት ጩብችሰ ፈንቀልታገ ገኦታት ቤሉ ፈየ መነ ገኦታበአ» ይ ፈንቀሼሰ።<note caller="-" style="x"><char style="xo" closed="false">9፥13 </char><char style="xt" closed="false"><ref loc="HOS 6:6">ሆሴ. 6፥6</ref>፤ <ref loc="MAT 12:7">ማቶ. 12፥7</ref>።</char></note><verse eid="MAT 9:13"/></para>
  <para style="s1">ሶመንተኔሃ ሆንጠኮ ጠዕምቱተ</para>
  <para style="r">(<ref loc="MRK 2:18-22">ማር. 2፥18-22</ref>፤ <ref loc="LUK 5:33-39">ሉቃ. 5፥33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14"/>ህከ ወክት ያህይ አዎናኑት ኢስበ አሜት «ነኡለከ ፈርሳውት ሶመን አንፈን ኪ አሳበት ሶመንታበኢሁ ሚሃት?» ይት ጠዕምቶኡ። <verse eid="MAT 9:14"/><verse number="15" style="v" sid="MAT 9:15"/>ኢስን «እዜቹ እሳን ሜጡበ ሄአን ጃለት ሻዛእንዶ? ጠው እኮጎሬ እዜቹ እሳች አደ እሀኖ ወክቱ አሜተኖ፤ ህከ ወክት ሶመንታአ። <verse eid="MAT 9:15"/><verse number="16" style="v" sid="MAT 9:16"/>አዪሁ ኑባጵቶ ኦድኖን ሃዕሮ ቃፈተ ቃፈኖሁ ዮበአ፤ ቃፌጎሬ ኦድኑስ ፊልተኣአ፤ ፊልተኡንኩስ ወዕኔች ባሰ እሀኖ። <verse eid="MAT 9:16"/><verse number="17" style="v" sid="MAT 9:17"/>ህትን ሃዕሮ ጠጀ ኑባጴ ሆቆማዶን ዎሬኖበአ፤ ህካን አኤመ ጎሬ ሃዕሮ ጠጁ ኑባጴ ሆቆማዱ ፊለኖ፤ ጠጁሲ ዱንተአኖ፤ ጠው እኮጎሬ ሃዕሮ ጠጀ ሃዕሮ ሆቆማዶን ዎሬኖረ ጠጁሲ ዱንተአኖበአ፤ ህትን ሆቆማዱንኩ ፊልተአኖበአ» ይ ፈንቀሼእ።<verse eid="MAT 9:17"/></para>
  <para style="s1">ኢያሮሴ ጩልተለከ ኢስ ኦድኑተ ኡልቶ መንቹተ</para>
  <para style="r">(<ref loc="MRK 5:21-43">ማር. 5፥21-43</ref>፤ <ref loc="LUK 8:40-56">ሉቃ. 8፥40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18"/>ኢስ ህካን ጠወአንን መቱ ሹሙ ኢስበ አሜች ብሬስ ጉሉጵ «ጩልኤ ቴሱ ሬቶኡ፤ ጠዉ እኮጎሬ አት አሜት አንገክ እሴ አሌን አቶንት ጎር ፈይታአ» ዬእ። <verse eid="MAT 9:18"/><verse number="19" style="v" sid="MAT 9:19"/>ኢስ ኬዕይ አሳባንተስን ሜጡበ ህከ መንቹ አዎኞ።<verse eid="MAT 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20"/>እሰን ሃንተን ሄኦገን ቶነ ለሙ ዘማን ጅስምችሴ ቄጉ ዱንተአን ኦርጨቀንተን ሄኣ መት መንቹት አሜት ኤተርስ አዲን ኢስ ኦድኖስ ሰኑተ አንጋንተሴ ኡልቶኡ።<note caller="-" style="x"><char style="xo" closed="false">9፥20 </char><char style="xt" closed="false"><ref loc="NUM 15:38">ዘኁ. 15፥38</ref>፤ <ref loc="DEU 22:12">ዘዳ. 22፥12</ref>።</char></note> <verse eid="MAT 9:20"/><verse number="21" style="v" sid="MAT 9:21"/>ህካን አቶኢሁ ቀልቤንከሴ «ኦድኖስ ሰኑተ ኡሎም ጎሬ ፈያም» ይቲት እቅ። <verse eid="MAT 9:21"/><verse number="22" style="v" sid="MAT 9:22"/>ኢስን ፈንቀል እሴንተ ለዕይ «ኢ ጩሌ! ዋጅቶት፤ አመዕነቱክ ፈይሾሄ» ዬሴ፤ ህከ ወክትንከ እሴ ፈይቶኡ።<verse eid="MAT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23"/>ህከኒች ኤተሮን ኢስ ሹም ምኒ ኢሌ ወክት አልፋቴተ ጡሩንበ ቡሰን ምኒ ኣዜን ኦአኖ መነ ለዕዮ። <verse eid="MAT 9:23"/><verse number="24" style="v" sid="MAT 9:24"/>«ጉዕሙንኩክዕኔ ከን ምኒች ፉሌ! ሀፍቱት ግሶ ቤሉ ሬቶበአ» ዬእ፤ ጠዉ እኮጎሬ እሰ ኦሰዕልቶኡ። <verse eid="MAT 9:24"/><verse number="25" style="v" sid="MAT 9:25"/>መኑ ፉሎች ኤተሮን ኢስ ሀፍቶ ጀናዘት ዮ ቤቹ ኣግ አንገሴ አፎ ወክት ኬኦኡ። <verse eid="MAT 9:25"/><verse number="26" style="v" sid="MAT 9:26"/>ሁኩ ጠዉ ጉዕሙንኩ ህከን ባዶን ሞጮጨሞ።<verse eid="MAT 9:26"/></para>
  <para style="s1">ኢስ ለሙ እልተ ቆቆ መነ ፈይሱስ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27"/>ኢስ ህከንቤቺች ኬዕይ ኦሮአን ሄዕዮገን ለሙ ቆቁ መኑ «ደዉዴ ቤቶ! ሀዕይ አሙዝኔ» ይተን አዎንቶስ። <verse eid="MAT 9:27"/><verse number="28" style="v" sid="MAT 9:28"/>ኢስ ምኒ ኣጎ ወክት እስ መድ ሆንጠክ «አን ካን አኣምገ አመዕንቴነንዶ?» ዬሰ፤ እሰን «ኤ ቀርቾ!» ይት ፈንቀሽቶኡ። <verse eid="MAT 9:28"/><verse number="29" style="v" sid="MAT 9:29"/>ህከኒች ኤተሮን ኢስ አንጋንተስ እልሰ አፍ «አመዕንቴንተገን እሁንክዕኔ» ዬሰ። <verse eid="MAT 9:29"/><verse number="30" style="v" sid="MAT 9:30"/>እልሰ ፈንተኦኡ፤ ኢስን «ከ ጠወ አዬሃ ጠወኦኖቼ» ይ ጠረኝሽ አዘዦሰ። <verse eid="MAT 9:30"/><verse number="31" style="v" sid="MAT 9:31"/>ጠዉ እኮጎሬ እሰ መርት ህከን ባዶን ጉዕማንን ኢስተኔሃ ኩልቶኡ።<verse eid="MAT 9:31"/></para>
  <para style="s1">ኢስ መቱ ዱደ መንቹ ፈይሱስ</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32"/>ሁኩ እልሰ ፈንተኣን ለኦ መኑ መርቶገን ዎሉ መኑ ዶሮረኖ ዱሩ አፎስ ዱደ መንቹ ኢስበ ኤቦኡ። <verse eid="MAT 9:32"/><verse number="33" style="v" sid="MAT 9:33"/>ዶሮረኖ ዱሩ ፉሎች ኤተሮን ሁኩ መንቹ ጠወኡ ጀመሮ፤ መኑ «ህትናሙ ጠወ እስራኤላን ሆሮ ለዕኖምበአ» ይት አጀብሲጭቶኡ። <verse eid="MAT 9:33"/><verse number="34" style="v" sid="MAT 9:34"/>ጠዉ እኮጎሬ ፈርሳውት «እስ ሩሃንየ ፉሸኖሁ ሩሃንይ ዎም ወልቃኒት» ይቶስ።<note caller="-" style="x"><char style="xo" closed="false">9፥34 </char><char style="xt" closed="false"><ref loc="MAT 10:25">ማቶ. 10፥25</ref>፤ <ref loc="MAT 12:34">12፥34</ref>፤ <ref loc="MRK 3:22">ማር. 3፥22</ref>፤ <ref loc="LUK 11:15">ሉቃ. 11፥15</ref>።</char></note><verse eid="MAT 9:34"/></para>
  <para style="s1">ኢስ መኒሃ አሙዙስ</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35"/>ኢስ ዱኣ አኤኖ ምናን ተማርሰን፥ መገን ዎምነት ተሽት ላገተ አዋጀንለከ መነ ጥዘናች ጉዕሚችን ፈይሰን ከተመለከ ቀዕየተ ጉዕመንከ ሃመን ተማርሰኖ እቅ።<note caller="-" style="x"><char style="xo" closed="false">9፥35 </char><char style="xt" closed="false"><ref loc="MAT 4:23">ማቶ. 4፥23</ref>፤ <ref loc="MRK 1:39">ማር. 1፥39</ref>፤ <ref loc="LUK 4:44">ሉቃ. 4፥44</ref>።</char></note> <verse eid="MAT 9:35"/><verse number="36" style="v" sid="MAT 9:36"/>እስ መኑ ዜሞ ዮበእ ሆለገ እክ ብን ይት ኦርጨቀንተን ለዕዮሰ ወክት አሙዦሰ።<note caller="-" style="x"><char style="xo" closed="false">9፥36 </char><char style="xt" closed="false"><ref loc="NUM 27:17">ዘኁ. 27፥17</ref>፤ <ref loc="1KI 22:17">1 ነገ. 22፥17</ref>፤ <ref loc="2CH 18:16">2 ዱዱ. 18፥16</ref>፤ <ref loc="EZK 34:5">ሕዝ. 34፥5</ref>፤ <ref loc="ZEC 10:2">ዘካ. 10፥2</ref>፤ <ref loc="MRK 6:34">ማር. 6፥34</ref>።</char></note> <verse eid="MAT 9:36"/><verse number="37" style="v" sid="MAT 9:37"/>ህካን እኮቤቺሃ አሳባተስ «አኤኖስ ሆጉት ልግብያን፤ ጠዉ እኮጎሬ ሆጉተ አአኖ መኑ ቀዎሃን። <verse eid="MAT 9:37"/><verse number="38" style="v" sid="MAT 9:38"/>ህካን እኮቤቺሃ ሆጎስ አኑ ሆጎቤቹ መነ ሶሆተ ኡጭዬ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">9፥38 </char><char style="xt" closed="false"><ref loc="LUK 10:2">ሉቃ. 10፥2</ref>።</char></note><verse eid="MAT 9:38"/></para>
  <chapter eid="MAT 9"/>
  <chapter number="10" style="c" sid="MAT 10"/>
  <para style="s1">ቶነ ለሞንከ አሳበተኔሃ</para>
  <para style="r">(<ref loc="MRK 3:13-19">ማር. 3፥13-19</ref>፤ <ref loc="LUK 6:12-16">ሉቃ. 6፥12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1"/>ኢስ ቶነ ለሙንከ አሳበተ እስበ ገእ ዶሮረኖ አያነ ፉሽቶተለከ መነ አደደ ጥዘናች ጉዕሚችን ፈይሰ ወልቀተ ኣሴሰ። <verse eid="MAT 10:1"/><verse number="2" style="v" sid="MAT 10:2"/>ቶነ ለሞንከ አሳበ<note caller="+" style="f"><char style="fqa" closed="false">አሳበተ፦ </char><char style="ft" closed="false">የኖሁ መገኒች ሶሀንቶረ ዩሃን።</char></note> ሱዕሙ ከኒች ዎሮን ከተበሞኡ፤ እሰን «ጴጥሮሴ» ዬኖ ስሞኔት፥ አመስቤቱ እንድራሴት፥ ዘብዶሴ ኦሱት ያቁባት፥ ያህይት፥ <verse eid="MAT 10:2"/><verse number="3" style="v" sid="MAT 10:3"/>ፍልጶሴት፥ ባርቴለሞሴት፥ ቶማሴት፥ ቀረጠ ሙረኖ ማቶሴት፥ እልፎሴ ቤቱ ያቁባት፥ ታዶሴት፥ <verse eid="MAT 10:3"/><verse number="4" style="v" sid="MAT 10:4"/>ባዱስ ኢተኖሁ<note caller="+" style="f"><char style="fqa" closed="false">አስቆሮቶ፦ </char><char style="ft" closed="false">የኖሁ ከን ላገ ኣሌን ለሙ ሰዉቱ ዮኡ፤ መቱ ሰዉቱ ባዲን ህከረንገ ቤቺን ሜጡ አአን ዎሉስ ሰዉቱ ይሁዳ ክዝበኘ ህከረንገ ጣንሳንቹ ዬን ቦሮሬኖ ለምቂያ ሱዕመ።</char></note> ይሁዳት እቅ።<verse eid="MAT 10:4"/></para>
  <para style="s1">ቶነ ለሙንኩ አሳበተ ተማርሲሃ ሶሀሙሰ</para>
  <para style="r">(<ref loc="MRK 6:7-13">ማር. 6፥7-13</ref>፤ <ref loc="LUK 9:1-6">ሉቃ. 9፥1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5"/>ኢስ ህከ ቶነ ለሙንከ አሳበተ «አይሁደ እኮበእ መንቤቹ መርቶኖቼ፤ ህትን ሰመር ከተመ ኣጎኖቼ። <verse eid="MAT 10:5"/><verse number="6" style="v" sid="MAT 10:6"/>ሆለገ እክ በኦ እስራኤል መንቤቹ ኦሮዕዬ <verse eid="MAT 10:6"/><verse number="7" style="v" sid="MAT 10:7"/>‹ሰሜ ዎምነቱ ሆንጠኮ› ይቴነን ተማርስዬ።<note caller="-" style="x"><char style="xo" closed="false">10፥7-15 </char><char style="xt" closed="false"><ref loc="LUK 10:4-12">ሉቃ. 10፥4-12</ref>።</char></note> <verse eid="MAT 10:7"/><verse number="8" style="v" sid="MAT 10:8"/>ጥዘናመተ ፈይሼ፤ ሬዮ መነ ሬሆች ኬሼ፤ ጎግ አሌን ፉልታ ሂለ ጥዘነት ዮ መነ ነጠ አዕዬ፤ ሩሃንየ ፉሽዬ፤ ጠለዕላን ኣኢቴንታሃ ጠለዕላንን ኣስዬ። <verse eid="MAT 10:8"/><verse number="9" style="v" sid="MAT 10:9"/>ክሳንከክዕኔ ሳንትበተ አፎኖቼ። <verse eid="MAT 10:9"/><verse number="10" style="v" sid="MAT 10:10"/>ዎቄሃክዕኔ ከረጥትተ ህከረንገ ለሙ ቀንቢሰ ህከረንገ ጫዕመተ ህከረንገ በርተ አፎኖቼ፤ መሰንትስ ሆጉተ አአኖ መንቺሃ እተኖሁ ሀስሰኖስ።<note caller="-" style="x"><char style="xo" closed="false">10፥10 </char><char style="xt" closed="false"><ref loc="1CO 9:14">1 ቆሮ. 9፥14</ref>፤ <ref loc="1TI 5:18">1 ጢሞ. 5፥18</ref>።</char></note> <verse eid="MAT 10:10"/><verse number="11" style="v" sid="MAT 10:11"/>አዕኑ ኣጌነንተ ከተማን ህከረንገ ቀኤን ክዕኔተ ቶጎተ ሙንደአኖ መንቹ አጥራመቴን ደጌ፤ ህከ ቤቹ አጉርቴን መርቶኖተ ኢለ እሲን ሜጡበ አገሬ። <verse eid="MAT 10:11"/><verse number="12" style="v" sid="MAT 10:12"/>መን ምኒ ኣጌነንተ ወክት ‹ወገሬትሼ›። <verse eid="MAT 10:12"/><verse number="13" style="v" sid="MAT 10:13"/>ምኔን ዮ መኑ ወገሬትክዕኔ ቶጎ ጎሬ ወገሬቱክዕኔ እሰ አሌን እሁን፤ ጠዉ እኮጎሬ ወገሬትክዕኔ ቶጉ ግቦጎሮ ወገሬቱክዕኔ ክዕኔ አደንከ ፈንቀሉን። <verse eid="MAT 10:13"/><verse number="14" style="v" sid="MAT 10:14"/>አዪሁ ቶጉ ግበኖህዕኔ ወክት ህከረንገ ጠወኤነንተ ጠወ ሞጮጩ ግበኖህዕኔ ወክት ህከ ምኒ ህከረንገ ህከ ከተመ አጉርቴን ፉልቴነን ሎከክዕኔ ትበ ግግሽቴን ፉሌ።<note caller="-" style="x"><char style="xo" closed="false">10፥14 </char><char style="xt" closed="false"><ref loc="ACT 13:51">ሶቀ. 13፥51</ref>።</char></note> <verse eid="MAT 10:14"/><verse number="15" style="v" sid="MAT 10:15"/>አን ሀንቅንከ ያንክዕኔ፤ ፍርድ በር ህከን ከተሚች በትሽ ሶዶምለከ ጎሞር ከተም መኒሃ ቅጣቱስ ቆሀኖ» ይ አዘዥ ሶኮ።<note caller="-" style="x"><char style="xo" closed="false">10፥15 </char><char style="xt" closed="false"><ref loc="MAT 11:24">ማቶ. 11፥24</ref>፤ <ref loc="GEN 19:24-28">ክል. 19፥24-28</ref>።</char></note><verse eid="MAT 10:15"/></para>
  <para style="s1">ቀርቹ አሜቲች ብርተ ኦርሸት እካገ</para>
  <para style="r">(<ref loc="MRK 13:3-13">ማር. 13፥3-13</ref>፤ <ref loc="LUK 21:12-17">ሉቃ. 21፥12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16"/>ኢስን «ህትን ፉሽ ሆለገ ኦሌ በላን ሶሃንክዕኔ፤ ህካን እኮቤቺሃ ዎሪችገ ኤንኬዕናመተ ሀንደዕሬገ ጎደበ ላፋኑተ እኬ።<note caller="-" style="x"><char style="xo" closed="false">10፥16 </char><char style="xt" closed="false"><ref loc="LUK 10:3">ሉቃ. 10፥3</ref>።</char></note> <verse eid="MAT 10:16"/><verse number="17" style="v" sid="MAT 10:17"/>ጠዉ እኮጎሬ ፍርድ ኦገት ዳኛኖበ ህግሴን ኣሴኖህዕኔ፤ ዱአ አኤኖ ምናን ሀለንጌን ኦሌኖህዕኔ፤ ህካን እኮቤቺሃ መኒች አገዕርዬ።<note caller="-" style="x"><char style="xo" closed="false">10፥17-20 </char><char style="xt" closed="false"><ref loc="MRK 13:9-11">ማር. 13፥9-11</ref>፤ <ref loc="LUK 12:11-12">ሉቃ. 12፥11-12</ref>፤ <ref loc="LUK 21:12-15">21፥12-15</ref>።</char></note> <verse eid="MAT 10:17"/><verse number="18" style="v" sid="MAT 10:18"/>ኢተኔሃ ባድ ዳኛኖቤቹሃ ዎም ብርተ መሴኖህዕኔ፤ አዕኑ እሳሃለከ አይሁደ እህበ መኒሃ መሰከርቴነንተ። <verse eid="MAT 10:18"/><verse number="19" style="v" sid="MAT 10:19"/>መኑ ፍርድቤቹ ሆንጠህሰኖህዕኔ ወክት ጠወኤነንተ ጠዉ ህከ ወክትንከ ኣሰመኖህዕኔቤቺሃ ‹ሀት› ህከረንገ ‹መ ጠወዕናም?› ይቴን ሻዞኖቼ። <verse eid="MAT 10:19"/><verse number="20" style="v" sid="MAT 10:20"/>መሰንትስ ክዕኔ ኣዜን ጠወአኖሁ ሰሜ አንክዕኔሃ አያነ ቤሉ ጠወኤነንታሁ አዕኖበአ።<note caller="-" style="x"><char style="xo" closed="false">10፥20 </char><char style="xt" closed="false"><ref loc="MRK 13:12">ማር. 13፥12</ref>፤ <ref loc="LUK 21:16">ሉቃ. 21፥16</ref>።</char></note> <verse eid="MAT 10:20"/><verse number="21" style="v" sid="MAT 10:21"/>መኑ ገይስ አመቤቱ ሬሆተ ህግሽ ኣሰኖ፤ ህትን አኑ ገይስ ቤቱ ሬሆተ ህግሽ ኣሰኖ፤ እለት አነሰ ህከረንገ አመሰ ዲንስት ሬሆተ ህግስ ኣታአ። <verse eid="MAT 10:21"/><verse number="22" style="v" sid="MAT 10:22"/>ጉዕሙንኩ መኑ ኢ ሱዕምተኔሃ ግበኖህዕኔ፤ ጠዉ እኮጎሬ መጨረሸ ኢለ ጠረኝ ኡረኖሁ ፈቀኖ።<note caller="-" style="x"><char style="xo" closed="false">10፥22 </char><char style="xt" closed="false"><ref loc="MAT 24:9">ማቶ. 24፥9</ref>፤ <ref loc="MAT 13">13</ref>፤ <ref loc="MRK 13:13">ማር. 13፥13</ref>፤ <ref loc="LUK 21:17">ሉቃ. 21፥17</ref>።</char></note> <verse eid="MAT 10:22"/><verse number="23" style="v" sid="MAT 10:23"/>መቶ ከተማን ኦርሸት በተኣ ወክት ዎሉ ከተመ ሁኜ፤ አን ሀንቅንከ ያንክዕኔ፤ መንች ቤቱ ፈንቀል አሜቶተ ኢለ እስራኤል ከተመ ጉዕመንከ ኢልቴነንተበአ። <verse eid="MAT 10:23"/><verse number="24" style="v" sid="MAT 10:24"/>ተማረኖሁ ተማርሰኖስሀኒች ህትን ካድንቹ ቀርቺች በተአኖበአ።<note caller="-" style="x"><char style="xo" closed="false">10፥24 </char><char style="xt" closed="false"><ref loc="LUK 6:40">ሉቃ. 6፥40</ref>፤ <ref loc="JHN 13:16">ያህ. 13፥16</ref>፤ <ref loc="JHN 15:20">15፥20</ref>።</char></note> <verse eid="MAT 10:24"/><verse number="25" style="v" sid="MAT 10:25"/>ህካን እኮቤቺሃ ተማረኖሁ ተማርሰኖሀንገ ህትን ካድንቹ ቀርችስገ እኮች እሀኖስ፤ ጠዉ እኮጎሬ ምንስ አነ ‹ቤዔልዜቡል› ዬን ገኤመ ጎሬ ምንስ አበሮስ ህከኒች ባሰ ሂለ ሱዕሚን ገኤኖበእንዶ?» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">10፥25 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቶ. 9፥34</ref>፤ <ref loc="MAT 12:24">12፥24</ref>፤ <ref loc="MRK 3:2">ማር. 3፥2</ref>፤ <ref loc="LUK 11:15">ሉቃ. 11፥15</ref>።</char></note><verse eid="MAT 10:25"/></para>
  <para style="s1">አዬ ዋጁ ሀስሰኖ ጎሬ</para>
  <para style="r">(<ref loc="LUK 12:4-7">ሉቃ. 12፥4-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26"/>ኢስ «መነ ዋጅቶኖቼ፤ መሰንትስ እፍሰሞሁ ፈንተኡነ ህትን ማጠሞርቹ ለሉዕነ ፈቀኖበአ።<note caller="-" style="x"><char style="xo" closed="false">10፥26 </char><char style="xt" closed="false"><ref loc="MRK 4:22">ማር. 4፥22</ref>፤ <ref loc="LUK 8:17">ሉቃ. 8፥17</ref>።</char></note> <verse eid="MAT 10:26"/><verse number="27" style="v" sid="MAT 10:27"/>አን ቱንስቾን ኩላንክዕኔሃ አዕኑ በራን ኩሌ፤ ህትን ማጤን ኩሌነን ሞጮጭቴንተ ጠወ በነቻን ፉልቴን ጠወዕዬ። <verse eid="MAT 10:27"/><verse number="28" style="v" sid="MAT 10:28"/>ማለ ሽታረ እኮጎሬ ፎል ሽቶተ አታልታበእረ ዋጅቶኖቼ፤ ጠዉ እኮጎሬ ማለለከ ነብሳሃ ጠእትበ ጊራን ኡጆተ አታለኖ መገኑ ዋጅዬ። <verse eid="MAT 10:28"/><verse number="29" style="v" sid="MAT 10:29"/>ለምተ ጭኡት መቶ በከናን ህረንታእበእንዶ? ጠዉ እኮጎሬ ሰሜ አኑክዕኔ ይበጎሬ ኢች ሆሮ መት ጭኡቲ ኡለ ኡብ ፈቃበአ። <verse eid="MAT 10:29"/><verse number="30" style="v" sid="MAT 10:30"/>ክዕኔ ሙሙክዕኔ ፈቁዕነ ዎለአሞእሃን። <verse eid="MAT 10:30"/><verse number="31" style="v" sid="MAT 10:31"/>ህካን እኮቤቺሃ ዋጅቶኖቼ፤ አዕኑ ልግብ ጭኦች በተኤነንተ።<verse eid="MAT 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32"/>«መን ብሬን ኢተኔሃ መሰከረኖሀኒሃ ጉዕሚንከ አን ሰማን ዮ አኒኤ ብሬን መሰከራንስ። <verse eid="MAT 10:32"/><verse number="33" style="v" sid="MAT 10:33"/>ጠዉ እኮጎሬ መን ብሬን ለገአኖኤሃ አዬሁ አን ሰማን ዮ አኒኤ ብሬን ለገኣንስ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">10፥33 </char><char style="xt" closed="false"><ref loc="2TI 2:12">2 ጢሞ. 2፥12</ref>።</char></note> <verse eid="MAT 10:33"/><verse number="34" style="v" sid="MAT 10:34"/>ኢስ «አን ኣዱንያ አሌን ወገሬት ኤቦተ አሜቾሚሃ አጉዱንከህዕኔ፤ አን አሜቾሚሁ በገዙ ኤቦታት ቤሉ ወገሬት ኤቦታበአ። <verse eid="MAT 10:34"/><verse number="35" style="v" sid="MAT 10:35"/>መሰንትስ ቤቱ አኒን ህትን ቤቱተ አማንተሴ ቤቲተ በሎንተሴ ብተንሶተ አሜቾም። <verse eid="MAT 10:35"/><verse number="36" style="v" sid="MAT 10:36"/>መኒ ባለገሩ ገይስ ምኒ መነ እሀኖ።<note caller="-" style="x"><char style="xo" closed="false">10፥36 </char><char style="xt" closed="false"><ref loc="MIC 7:6">ሚክ. 7፥6</ref>።</char></note> <verse eid="MAT 10:36"/><verse number="37" style="v" sid="MAT 10:37"/>አዪሁ አነስለከ አመስ ኢች በትሽ ኢቴ ጎሬ ኤሳሃ እሆተ ሀስሰኖበአ፤ ህትን አዪሁ ቤቱስ ህከረንገ ቤቱተ ኢች በትሽ ኢተኖሁ ኤሳሃ እሆተ ሀስሰኖበአ። <verse eid="MAT 10:37"/><verse number="38" style="v" sid="MAT 10:38"/>ገይስ መስቀለ እጅ አዎንበኤሁ አዪሁ ኤሳሃ እሆተ ሀስሰኖበአ።<note caller="-" style="x"><char style="xo" closed="false">10፥38 </char><char style="xt" closed="false"><ref loc="MAT 16:24">ማቶ. 16፥24</ref>፤ <ref loc="MRK 8:34">ማር. 8፥34</ref>፤ <ref loc="LUK 9:23">ሉቃ. 9፥23</ref>።</char></note> <verse eid="MAT 10:38"/><verse number="39" style="v" sid="MAT 10:39"/>ፎልስ ፌሶተ ኢተኖሁ አዪሁ ቤሰኖ፤ ጠዉ እኮጎሬ ፎልስ ኢተኔሃ ቤሰኖሁ አዪሁ ፈቀኖ።<note caller="-" style="x"><char style="xo" closed="false">10፥39 </char><char style="xt" closed="false"><ref loc="MAT 16:25">ማቶ. 16፥25</ref>፤ <ref loc="MRK 8:35">ማር. 8፥35</ref>፤ <ref loc="LUK 9:24">ሉቃ. 9፥24</ref>፤ <ref loc="LUK 17:33">17፥33</ref>፤ <ref loc="JHN 12:25">ያህ. 12፥25</ref>።</char></note> <verse eid="MAT 10:39"/><verse number="40" style="v" sid="MAT 10:40"/>ክዕኔተ ቶገኖሁ አዪሁ ኤሳሃ ቶገኖ፤ ኤሳሃ ቶገኖሁ አዪሁ ኤሳሃ ሶኮሃ ቶገኖ።<note caller="-" style="x"><char style="xo" closed="false">10፥40 </char><char style="xt" closed="false"><ref loc="MRK 9:37">ማር. 9፥37</ref>፤ <ref loc="LUK 9:48">ሉቃ. 9፥48</ref>፤ <ref loc="LUK 10:16">10፥16</ref>፤ <ref loc="JHN 13:20">ያህ. 13፥20</ref>።</char></note> <verse eid="MAT 10:40"/><verse number="41" style="v" sid="MAT 10:41"/>ነብዬቹ ነብዬች ሱዕሚን ቶገኖሁ ነብዬች ዋጋ ደአኖ፤ ፈየ መንቹ ፈዪ ሱዕሚን ቶገኖሁ ፈዪ ዋጋ ደአኖ። <verse eid="MAT 10:41"/><verse number="42" style="v" sid="MAT 10:42"/>ሀንቅንከ ያንክዕኔ፤ ኢ አሳቤቹ እኮቤቺሃ ከን ማዕናኖች መትሀስ መቱ ቡርጩቆ ዋሀ ኣሰኖሁ አዪሁ ዋገስ ደኡዕነ ፈቀኖበአ» ዬእ።<verse eid="MAT 10:42"/></para>
  <chapter eid="MAT 10"/>
  <chapter number="11" style="c" sid="MAT 11"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1"/>ኢስ ቶነ ለሙንከ አሳበስ አዎንታገ አዘዥ ሹሎች ኤተሮን ህከ ቤቹ ጌኝ አዕይ ግደኖን ዮ ከተመ ዱዱብሶተለከ ተመርሶተ ኦሮዕዮ።<verse eid="MAT 11:1"/></para>
  <para style="s1">ጠመቃንቾ ያህዪች ኢስበ ሶሀንቶ ሶቀማኑተ</para>
  <para style="r">(<ref loc="LUK 7:18-35">ሉቃ. 7፥18-35</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2"/>ህከ ወክት ጠመቃንቹ ያህይ ኡሱር ምኔን ሄዕዮገ መሲህ ኢስተኔሃ ሞጮጭ <verse eid="MAT 11:2"/><verse number="3" style="v" sid="MAT 11:3"/>« ‹አሜተኖ› ዬመ መሲህ ኢስ አቴትንዶ? ህከረንገ ዎሉ አገርኑ» ይ አዎናኑስ ኢስበ ሶኮ። <verse eid="MAT 11:3"/><verse number="4" style="v" sid="MAT 11:4"/>ኢስ «መርቴን ለኤንታሃለከ ሞጮጭቴንታሃ ያህዪሃ ኩሌ። <verse eid="MAT 11:4"/><verse number="5" style="v" sid="MAT 11:5"/>ሁኩዕኑን ቆቃኑት ለኣኢት፤ ሎከተ ናፉ መኑ ጌጥ ይ ሃመኖት፤ ጎግ አሌን ፉልታ ሂለ ጥዘነት አፎሰ መኑ ነጠ እካኢት፤ ዶንቁ መኑ ሞጮጨኖት፤ ሬዮ መኑ ሬሆች ኬአኖት፤ ቡጥቻኖተ እንጂሉ ዱዱብሰመኖት።<note caller="-" style="x"><char style="xo" closed="false">11፥5 </char><char style="xt" closed="false"><ref loc="ISA 35:5-6">ኢሳ. 35፥5-6</ref>፤ <ref loc="ISA 61:1">61፥1</ref>።</char></note> <verse eid="MAT 11:5"/><verse number="6" style="v" sid="MAT 11:6"/>ኢተኔሃ ሸክባሁ ማሰአሞእሃ» ዬእ።<verse eid="MAT 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7"/>ያህይ አዎናኑት መርቶች ኤተሮን ኢስ ህከኔ ጭምዬ መኒሃ ያህይተኔሃ ጠወአን «መ ለኢሃት ኡለ ኡድመ ፉልቴንታሁ? ቦብሩ ሌንቄቅሰኖ ሸምቦቁተ ለኢሃትንዶ? <verse eid="MAT 11:7"/><verse number="8" style="v" sid="MAT 11:8"/>መ ለኦኖተ ፉልቴን? ጡመተ ኦድኑተ ኦደዕዮ መነ ለኢሃትንዶ? ጡመተ ኦድኑተ ኦደዕዮ መኑ ሄአኖሁ ዎመ ምናኒት። <verse eid="MAT 11:8"/><verse number="9" style="v" sid="MAT 11:9"/>ህከረ መ ለኦኖተ ፉልቴን? ነብዬቹ ለኦኖታትንዶ? ኤ! አን ያንክዕኔ፤ ነብዬቺች በተአኖሃ ለኢሃት። <verse eid="MAT 11:9"/><verse number="10" style="v" sid="MAT 11:10"/>‹ሁኩዕኑን ዎቃክ ብዝ አአኖ ሶቀማንቹኤ ብሬክ ሶሃም› የመም እስተኔሃ ከተበሞሁ ከኒት።<note caller="-" style="x"><char style="xo" closed="false">11፥10 </char><char style="xt" closed="false"><ref loc="MAL 3:1">ሚል. 3፥1</ref>።</char></note> <verse eid="MAT 11:10"/><verse number="11" style="v" sid="MAT 11:11"/>ሀንቅንከ ያንክዕኔ፤ ከን ኣዱንያ አሌን ከለቀሞ መኒች ጉዕሚችን ጠመቃንቾ ያህዪች በተአኖሁ ዮበአ፤ ጠዉ እኮጎሬ ሰሜ ዎምነቴን ጉዕሚችን ሆፈአኖሁ እሲች ሎዕረኖ። <verse eid="MAT 11:11"/><verse number="12" style="v" sid="MAT 11:12"/>ጠመቃንቾ ያህይ ዘማኒች ኬሽ ከበሬ ኢለ ሰሜ ዎምነቱ ወልቃን ኣጎተ አበ አጰንታኢት።<note caller="+" style="f"><char style="fqa" closed="false">አጰንታአ፦ </char><char style="ft" closed="false">ሀንበዕለሙለከ አጰንሹ ለሊሰኖሁ ሰሜ ጄነት ኣጊሃ ጉዕሙንኩ መኑ አአኖሃ አጰንሸ።</char></note><verse eid="MAT 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 11:13"/>«ነብያኑትለከ ሙስ አንጋን ኣሰሞ ሕጉሁ ጠመቃንቾ ያህይ ወክት ኢለ ራገ ጠወኦኡ።<note caller="-" style="x"><char style="xo" closed="false">11፥13 </char><char style="xt" closed="false"><ref loc="LUK 16:16">ሉቃ. 16፥16</ref>።</char></note> <verse eid="MAT 11:13"/><verse number="14" style="v" sid="MAT 11:14"/>ቴሱ ቶጎኖተ ሀሴንተ ጎሬ ‹አሜተኖ› ዬመ እልያስ ከኒት።<note caller="-" style="x"><char style="xo" closed="false">11፥14 </char><char style="xt" closed="false"><ref loc="MAL 4:5">ሚል. 4፥5</ref>፤ <ref loc="MAT 17:10-13">ማቶ. 17፥10-13</ref>፤ <ref loc="MRK 9:11-13">ማር. 9፥11-13</ref>።</char></note> <verse eid="MAT 11:14"/><verse number="15" style="v" sid="MAT 11:15"/>ሞጮጭታ መጨት ዮሲሁ ዮ ጎሬ ሞጮጩን።<verse eid="MAT 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16"/>«ጠዉ እኮጎሬ ከን ዘማን መነ ሚን አጉጣቀንሳም? እሰ ጌባን አፉዕልት መት-መቱሰ ገእተን <verse eid="MAT 11:16"/><verse number="17" style="v" sid="MAT 11:17"/>‹ሁሉሌተ ቡንሳንክዕኔረ ቦለቸ ከዴንታበአ፤ ህትን ኦዕናምረ ቶጌንታኔበአ› ይተን አለጵታ እለተ አጉዳአ። <verse eid="MAT 11:17"/><verse number="18" style="v" sid="MAT 11:18"/>መሰንትስ ያህይ እቱዕነለከ አጉዕና አሜቾ ወክት ‹ዶሮረኖ ዱሩ አፎስ› ይቶስ። <verse eid="MAT 11:18"/><verse number="19" style="v" sid="MAT 11:19"/>መንች ቤቱ እተንለከ አገን አሜተኖረ ‹ኩ መንቹ እቱሃ አጉሃ ኢተኖ፤ ህትን ቀረጠ ሙረኖ መኒሃለከ ጩበኛኖተ ጃላ!› ዬመስ፤ እኮጎሬ ሀይቹ ሆጎንተስ ለለኖ» ዬእ።<verse eid="MAT 11:19"/></para>
  <para style="s1">አመዕኑ ሆግንከሰ ዎቀሰንቶ ከተመተ</para>
  <para style="r">(<ref loc="LUK 10:13-15">ሉቃ. 10፥13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20"/>ኢስ ልግብ አጀብሲሰኖ ጠወ አዕዮ ከተም መኑ ጩብችሰ ፈንቀሉ ግቦቤቺሃ ዎቀሱ ጀመሮ። <verse eid="MAT 11:20"/><verse number="21" style="v" sid="MAT 11:21"/>«ኣዬ ኮራዜ! ኣዬ ቤተ ሳይዳ! ክዕኔን እኮ አጀብሲሰኖ ጠወ ጢሮስለከ ሲዶን ከተሚሃ አሰሞ እቃን ሁኩ መኑ ሄጭት ጥጅ ኦድኑተ ኦደእ ጠበሩ አሌሰ አት ጩብችሰ ፈንቀሉሰ ለሊሳ እቅ።<note caller="-" style="x"><char style="xo" closed="false">11፥21 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">ኢሳ. 23፥1-18</ref>፤ ሕዝ. 26፥1-28፤ <ref loc="EZK 26">26</ref>፤ <ref loc="JOL 3:4-8">ኢዩ. 3፥4-8</ref>፤ አሞጽ 1፥9-10፤ <ref loc="ZEC 9:2-4">ዘካ. 9፥2-4</ref>።</char></note> <verse eid="MAT 11:21"/><verse number="22" style="v" sid="MAT 11:22"/>ጠዉ እኮጎሬ አን ያንክዕኔ፤ ፍርድ በር ክዕኔች አበ ጢሮስለከ ሲዶን ከተም መኒሃ ፍርዱስ ቢለኖ። <verse eid="MAT 11:22"/><verse number="23" style="v" sid="MAT 11:23"/>አት ቅፍርናሆም ከተንቹት! ሰማሃ ኢለ ጎት ጎት ይቶንትንዶ? አዛቤን ድርታንት፤ ኪን አሰሞ አጀብሲሰኖ ጠዉ ሶዶም ከተማን አሰሞ እቃኔተ ሁኩ ከተሙ ከበሬ ኢለ በኡዕነ ኢልታ እቅ።<note caller="-" style="x"><char style="xo" closed="false">11፥23 </char><char style="xt" closed="false"><ref loc="ISA 14:13-15">ኢሳ. 14፥13-15</ref>፤ <ref loc="GEN 19:24-28">ክል. 19፥24-28</ref>።</char></note> <verse eid="MAT 11:23"/><verse number="24" style="v" sid="MAT 11:24"/>አን ሀንቅንከ ያንክዕኔ፤ ፍርድ በር ኪች በትሽ ሶዶም ከተም ፍርዱ ቆሀኖ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">11፥24 </char><char style="xt" closed="false"><ref loc="MAT 10:15">ማቶ. 10፥15</ref>፤ <ref loc="LUK 10:12">ሉቃ. 10፥12</ref>።</char></note><verse eid="MAT 11:24"/></para>
  <para style="s1">መሲህ ኢሳን ፎሎጩ ደኡ</para>
  <para style="r">(<ref loc="LUK 10:21-22">ሉቃ. 10፥21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25"/>ህከ ወክት ኢስ «ሰሜለከ ኡለ ቀርቹ እኮንት ኢ አነ! ካን ሀይቻኖችለከ ደጋሀኑኡች ማጥ ቀልቡስ ኦሶገ ቶገኖ መኒሃ ለሊሶንትቤቺሃ ገለትጫንኬ። <verse eid="MAT 11:25"/><verse number="26" style="v" sid="MAT 11:26"/>ኤ ኢ አነ! ኪ ጡሙ ሰውቱ ህትናሙሃን። <verse eid="MAT 11:26"/><verse number="27" style="v" sid="MAT 11:27"/>አኑኤ ጉዕመርቹንከ ኣስዮኤ፤ አኒ ቤሉ ቤቱ ደገኖሁ አዪሁ ዮበአ፤ ህትን ቤትለከ ቤቱ ለሊሶተ መጠሮ መንች ቤሉ አነ ደገኖሁ ዮበአ።<note caller="-" style="x"><char style="xo" closed="false">11፥27 </char><char style="xt" closed="false"><ref loc="JHN 3:35">ያህ. 3፥35</ref>፤ <ref loc="JHN 1:18">1፥18</ref>፤ <ref loc="JHN 10:5">10፥5</ref>።</char></note><verse eid="MAT 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28"/>«አዕኑ እጅነት ኬዕምታንክዕኔ ሆጌንተ መኑ ጉዕሙንኩ ኢቤቹ አሜ፤ አን ፎሎሲሳንክዕኔ። <verse eid="MAT 11:28"/><verse number="29" style="v" sid="MAT 11:29"/>ኢ አንገቼተ እጅዬ፤ ኢችን ትምርት ኣእዬ፤ አን ጎደበ ላፋለከ መረርሲጫምሃን፤ ፎልሃክዕኔ ፎሎጩ ደዕቴነንተ።<note caller="-" style="x"><char style="xo" closed="false">11፥29 </char><char style="xt" closed="false"><ref loc="JER 6:16">ኤር. 6፥16</ref>።</char></note> <verse eid="MAT 11:29"/><verse number="30" style="v" sid="MAT 11:30"/>አንገቼእ ኬዕምታበእታን፤ እጅነኤን ኬዕምታበአ» ዬእ።<verse eid="MAT 11:30"/></para>
  <chapter eid="MAT 11"/>
  <chapter number="12" style="c" sid="MAT 12"/>
  <para style="s1">አበ በሬተ ሆንጠኮ ጠዕምቱተ</para>
  <para style="r">(<ref loc="MRK 2:23-28">ማር. 2፥23-28</ref>፤ <ref loc="LUK 6:1-5">ሉቃ. 6፥1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1"/>ህከ ወክት ኢስለከ አሳበስ አበ በሬን አለስ ኣዚን ህጋኢት እቅ፤ አሳበስ ጎሩ አፎሰቤቺሃ ሀማሙተ ተንቅስ ቁስት እቱ ጀመርቶኡ። <verse eid="MAT 12:1"/><verse number="2" style="v" sid="MAT 12:2"/>ፈርሳዉት ህካን ለኦ ወክት ኢሰ «አሳበክ አበ በሬን አኡ ገበእበ ጠወ አታኢሃ ለእ» ይቶኡ። <verse eid="MAT 12:2"/><verse number="3" style="v" sid="MAT 12:3"/>ኢስን ፈንቀሽ «ዳዉድለከ እሲን ሜጡበ ሄዕዮ መኑሁ ጎሩ አፎሰ ወክት ዳዉድ አዕዮሃ አነበቤንታበእንዶ? <verse eid="MAT 12:3"/><verse number="4" style="v" sid="MAT 12:4"/>ዱእ ምኒ ኣግ ቂስ ቤሉ እስ ህከረንገ እሲን ሜጡበ ሄኦ መኑ እቶተ ፈቀደሞበእ መገኒሃ አደ እኮ ዳቡተ እቶኡ።<note caller="-" style="x"><char style="xo" closed="false">12፥4 </char><char style="xt" closed="false"><ref loc="LEV 24:9">ሌዌ 24፥9</ref>።</char></note> <verse eid="MAT 12:4"/><verse number="5" style="v" sid="MAT 12:5"/>ህትን ቂሰት አበ በሬን መገን ምኔን አተን ፎሎጭ በሬ ሕገ ድጅታ ወክት ቤሱ እሀኖሰበእገ ሙስ መሳን ኣሰሞ ሕጋን ከተበሞሃ አነበቤንታበእንዶ? <verse eid="MAT 12:5"/><verse number="6" style="v" sid="MAT 12:6"/>ጠዉ እኮጎሬ መገን ምኒች በተአኖሁ ከበ ዮኡ። <verse eid="MAT 12:6"/><verse number="7" style="v" sid="MAT 12:7"/>‹አን ክትሚች አበ አሙዙ ኢታም› ዩ መ ዩሃ ጎሬ አጥራመቴንታእቃን ቤሾበእ መን አሌን ፈረዴነንተበ እቅ።<note caller="-" style="x"><char style="xo" closed="false">12፥7 </char><char style="xt" closed="false"><ref loc="MAT 9:3">ማቶ. 9፥3</ref>፤ <ref loc="HOS 6:6">ሆሴ. 6፥6</ref>።</char></note> <verse eid="MAT 12:7"/><verse number="8" style="v" sid="MAT 12:8"/>እኮጎሬ መንች ቤቱ አበ በሬተ ቀርቹሃን» ዬእ።<verse eid="MAT 12:8"/></para>
  <para style="s1">ኢስ አንገተ ናፈ መንቹ ፈይሱስ</para>
  <para style="r">(<ref loc="MRK 3:1-6">ማር. 3፥1-6</ref>፤ <ref loc="LUK 6:6-11">ሉቃ. 6፥6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9"/>ኢስ ህከንቤቺች ኬዕይ ጭምትሰ ምኒ ኦሮዕዮ። <verse eid="MAT 12:9"/><verse number="10" style="v" sid="MAT 12:10"/>ህከንቤቾንን መቱ አንገተ ናፉ መንቹ ሄዕዮ እቅ፤ እሰን ከሰሶስተ ሀስ «አበ በሬን ጥዘናሙ ፈይሱ ፈቀደሞእንዶ?» ይት ኢሰ ጠዕምቶኡ። <verse eid="MAT 12:10"/><verse number="11" style="v" sid="MAT 12:11"/>ኢስን ፈንቀሽ «ክዕኔኤች መት ሆልቹት ዮሲሁ አበ በሬን በዋን ኡቦጎሬ በዊች ፉሽባሁ አዬት?<note caller="-" style="x"><char style="xo" closed="false">12፥11 </char><char style="xt" closed="false"><ref loc="LUK 14:5">ሉቃ. 14፥5</ref>።</char></note> <verse eid="MAT 12:11"/><verse number="12" style="v" sid="MAT 12:12"/>ህካን እኮች መንቹ ሆልቺች አበ በተአኖበእንዶ? ህካን እኮቤቺሃ አበ በሬን ጡመ ጠወ አኡ ሀስሰኖሃን» ዬእ። <verse eid="MAT 12:12"/><verse number="13" style="v" sid="MAT 12:13"/>ህከኒች ኤተሮን ኢስ አንገተ ናፈ መንቹ «አንገክ ሂር» ዬእ፤ መንቹንኩ አንገስ ሂሮ ወክት ዎሌ አንገስገን ፈየተ አንገተ እኮኡ። <verse eid="MAT 12:13"/><verse number="14" style="v" sid="MAT 12:14"/>እኮጎሬ ፈርሳውት ህከንቤቺች ፉልት ኢሰ ሀት አት ሽታስጎሬ አማዕለንቶኡ።<verse eid="MAT 12:14"/></para>
  <para style="s1">መገኑ መጠሮ ካዲንችተኔሃ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15"/>ኢስ እሰ አማዕለሙሰ ደግ ህከንቤቺች ገበጭ ዬእ፤ ህትን ልግቡ መኑ አዎንቶስ፤ እስን ጉዕመንከሰ ፈይሾ። <verse eid="MAT 12:15"/><verse number="16" style="v" sid="MAT 12:16"/>እሰን እስተኔሃ አዬሃ ጠወኣበእገ አዘዦሰ። <verse eid="MAT 12:16"/><verse number="17" style="v" sid="MAT 12:17"/>ሁኩን እኮሁ መገኑ ነብዬቾ እስያሴን<verse eid="MAT 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18"/>«ሁኩዕኑን! አን መጠሮም ካዲንቹኤ፤</para>
  <para style="q2" vid="MAT 12:18">እስ አን ኢታሚሃለከ ሙንደኣምሃን፤</para>
  <para style="q2" vid="MAT 12:18">እስ አሌንን ጠሊለ አያነኤ አኣም፤</para>
  <para style="q2" vid="MAT 12:18">እስን ሀንቅ ፍርደ አይሁደ እህበ ኡመቲሃ አዋጀኖ።<verse eid="MAT 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19"/>እስን ኦደኖበአ ህከረንገ ያረኖበአ፤</para>
  <para style="q2" vid="MAT 12:19">ዎቄ አሌን ጉዕማንን ላገስ ሞጮጨኖሁ ዮበአ።<verse eid="MAT 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20"/>እስን ሀንቅ ፍርደ አኦተ ኢለ</para>
  <para style="q2" vid="MAT 12:20">ቀጠቀጠንቶ ሾምቦቁተ ቢጠኖበአ፤</para>
  <para style="q2" vid="MAT 12:20">ህከረንገ ዉሊለኖ ኩራዝ ፈትለ ኡፍ አዕይ ጠእሰኖበአ፤<verse eid="MAT 12:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21"/>ህትን መገኑ ደግቡ መኑ ሱዕማንከስ ተብሳሃ አአኖ» ዬ ጠዉ ዊሞታት።<note caller="-" style="x"><char style="xo" closed="false">12፥21 </char><char style="xt" closed="false"><ref loc="ISA 42:1-4">ኢሳ. 42፥1-4</ref>።</char></note><verse eid="MAT 12:21"/></para>
  <para style="s1">ኢሰለከ ብዔልዜቡለ</para>
  <para style="r">(<ref loc="MRK 3:20-30">ማር. 3፥20-30</ref>፤ <ref loc="LUK 11:14-23">ሉቃ. 11፥14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22"/>ህከኒች ኤተሮን መኑ መቱ ዶሮረኖ ዱሩ አፎስ ቆቀለከ ዱደ መንቹ ኢስበ ኤቦኡ፤ ኢስን ህከ መንቹ ጠወአኖገለከ ለአኖጋ አዕይ ፈይሾ። <verse eid="MAT 12:22"/><verse number="23" style="v" sid="MAT 12:23"/>ህካን እኮቤቺሃ መኑ ጉዕሙንኩ አጀብሲጭ «ኩን ደዉዴየ ቤቱንዶ?» ይቶኡ።<verse eid="MAT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24"/>እኮጎሬ ፈርሳውት ህካን ሞጮጭቶ ወክት «ኩ መንቹ ሩሃንየ ፉሸኖሁ ‹ብዔልዜቡል› ዬኖ ሩሃንይ ሀለቅች ዎልቃኒት» ይቶኡ።<verse eid="MAT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25"/>ኢስ እሰ ቀልብ ጠወ ደግ «መቱ ዎሙ አደ እክ ገገይንከስ ብተመኖሃ እኮች ሁኩ ዎሙ ኡበኖ፤ ህትን መቱ ከተሙ ህከረንገ መቶ ምኔን ሄአኖ መኑ ገገይንከስ አደ እኮች ጠረኝ ሄኦተ አታለኖበአ። <verse eid="MAT 12:25"/><verse number="26" style="v" sid="MAT 12:26"/>ሸይጣነ ሸይጣኑ ፉሸኖሃ እኮች ገገይንተስ አደ እኮ ዩሃን፤ ህካን እኮች መንግስቱስ ሀት እክ ጠረኝ ሄኦተ አታለኖ? <verse eid="MAT 12:26"/><verse number="27" style="v" sid="MAT 12:27"/>አን ብዔልዜቡሌ ዎልቃን ሩሃንየ ፉሻሚሃ እኮች ክዕኔ መኑ አዬ ዎልቃን ፉሽታአ? ህካን እኮቤቺሃ መኑክዕኔ ክዕኔ አሌን ፈረዳእረ እካአ። <verse eid="MAT 12:27"/><verse number="28" style="v" sid="MAT 12:28"/>አን ሩሃንየ ፉሻሚሁ መገን አያኒን እኮች ቴሱ መገን ዎምነቱ ክዕኔቤቹ አሜተኖ። <verse eid="MAT 12:28"/><verse number="29" style="v" sid="MAT 12:29"/>ህትን መቱ መንቹ መቱ ጠረኘ መንቹ ኡሱርባች ምንስ ቢጭ ኣግ ዱንያስ ዘረፎተ ሀት እክ አታለኖ? እኮጎሬ ህከ ጠረኘ መንቹ ኡሱሮች ኤተሮን ዱንያስ ዘረፎተ አታለኖ። <verse eid="MAT 12:29"/><verse number="30" style="v" sid="MAT 12:30"/>አዪሁ ኢን ሜጡ እህባሁ ኢን ሀንበዕለመኖ፤ ህትን ኢን ጭምአእቡ ጉዕሙንኩ ብንአአኖ።<note caller="-" style="x"><char style="xo" closed="false">12፥30 </char><char style="xt" closed="false"><ref loc="MRK 9:40">ማር. 9፥40</ref>።</char></note> <verse eid="MAT 12:30"/><verse number="31" style="v" sid="MAT 12:31"/>ህካን እኮቤቺሃ አን ኩላንክዕኔ፤ መኑ አዕዮ ጩቡ ጉዕሙንኩ፥ ቦሮር ላገቲ ፈቁን የመንታአ፤ እኮጎሬ ጠሊለ አያን አሌን ጠወኤኖ ቦሮር ላገት ጉዕሙንኩ ማረመኖስበአ። <verse eid="MAT 12:31"/><verse number="32" style="v" sid="MAT 12:32"/>መንች ቤት አሌን ቦሮር ላገተ ጠወአኖአን ቤሱ ማረመኖስ፤ ጠዉ እኮጎሬ ጠሊለ አያን አሌን ቦሮር ላገተ ጠወአኖአን ቤሱ ከን ዘማኔንለከ አሜተኖ ዘማኔን ማረመኖስበአ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">12፥32 </char><char style="xt" closed="false"><ref loc="LUK 12:10">ሉቃ. 12፥10</ref>።</char></note><verse eid="MAT 12:32"/></para>
  <para style="s1">ጡሙ ሀቁ ላልቺንከስ ደገመኖ</para>
  <para style="r">(<ref loc="LUK 6:43-45">ሉቃ. 6፥43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33"/>ኢስ «ሀቁ ጉዕሙንኩ ላልቺንከስ ደገመኖቤቺሃ ጡሙ ላልቹ ሄኡንክዕኔ፤ ላልቹስ ጡመ እኮጎሬ ሀቁሲ ጡመሃን፤ ላልቹስ ሂለ እኮጎሬ ሀቁሲ ሂለ ዩሃን።<note caller="-" style="x"><char style="xo" closed="false">12፥33 </char><char style="xt" closed="false"><ref loc="MAT 7:20">ማቶ. 7፥20</ref>፤ <ref loc="LUK 6:44">ሉቃ. 6፥44</ref>።</char></note> <verse eid="MAT 12:33"/><verse number="34" style="v" sid="MAT 12:34"/>ቀልቤን ዊሞሀኒች አፎሁ ጠወአኖቤቺሃ አዕኑ ኩ ዎሪች እለት! ሂላኑተ እኬነን ሀት እኬን ጡመ ጠወ ጠወኦኖተ አታልቴነን?<note caller="-" style="x"><char style="xo" closed="false">12፥34 </char><char style="xt" closed="false"><ref loc="MAT 3:7">ማቶ. 3፥7</ref>፤ <ref loc="MAT 23:33">23፥33</ref>፤ <ref loc="MAT 15:18">15፥18</ref>፤ <ref loc="LUK 3:7">ሉቃ. 3፥7</ref>፤ <ref loc="LUK 6:45">6፥45</ref>።</char></note><verse eid="MAT 12:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 12:35"/>«ጡሙ መንቹ ጡመ ጠወ ማጮ ጡመ ቤቺች ጠወአኖ፤ ሂሉ መንቹ ሂለ ጠወ ማጮ ሂለ ቤቺች ጠወአኖ። <verse eid="MAT 12:35"/><verse number="36" style="v" sid="MAT 12:36"/>አን ሀንቅንከ ያንክዕኔ፤ ሀኩ መንቹሁ ህትን ጠወአኖ ሀስስበ ጠዊሃ ጉዕሚንከ ፍርድ በር ጠዕመመኖ። <verse eid="MAT 12:36"/><verse number="37" style="v" sid="MAT 12:37"/>መሰንትስ ጠወኦንት ላጋን ነጠ እካንት፤ ህትን ሂለ ጠወኦንት ላጋንን ፈረደመኖሄ» ዬእ።<verse eid="MAT 12:37"/></para>
  <para style="s1">አጀብሲሰኖ ጠወ ለኢሃ ሆንጠኮ ጠዕምቱተ</para>
  <para style="r">(<ref loc="MRK 8:11-12">ማር. 8፥11-12</ref>፤ <ref loc="LUK 11:29-32">ሉቃ. 11፥29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38"/>መት-መቱ ሕግ አስተማረትለከ ፈርሳውት ኢሰ «አስተማርቾ! አት መላተ አተን ለዕኖተ ሀንሳም» ይቶኡ።<note caller="-" style="x"><char style="xo" closed="false">12፥38 </char><char style="xt" closed="false"><ref loc="MAT 16:1">ማቶ. 16፥1</ref>፤ <ref loc="MRK 8:11">ማር. 8፥11</ref>፤ <ref loc="LUK 11:16">ሉቃ. 11፥16</ref>።</char></note> <verse eid="MAT 12:38"/><verse number="39" style="v" sid="MAT 12:39"/>እስን ፈንቀሽ «ከን ዘማን ሂሉለከ አመዕንቡ ክልቀቱ መላተ ለኦተ ሀሰኖ፤ ጠዉ እኮጎሬ ነብዬቾ ዩኑስ መላ ቤሉ ዎልት መላት ኣሰመኖስበአ።<note caller="-" style="x"><char style="xo" closed="false">12፥39 </char><char style="xt" closed="false"><ref loc="MAT 16:4">ማቶ. 16፥4</ref>፤ <ref loc="MRK 8:12">ማር. 8፥12</ref>።</char></note> <verse eid="MAT 12:39"/><verse number="40" style="v" sid="MAT 12:40"/>ዩኑስ ሎረ ቁርጩሜ ጎደባን ሰሱ በራለከ ሰስ ሀዎሩተ ዱንኬሀንገን መንች ቤቱሁ ኡለ ኣዜን ሰሱ በራለከ ሰስ ሀዎሩተ ዱንከኖ።<note caller="-" style="x"><char style="xo" closed="false">12፥40 </char><char style="xt" closed="false"><ref loc="JON 1:17">ዩኑ. 1፥17</ref>።</char></note> <verse eid="MAT 12:40"/><verse number="41" style="v" sid="MAT 12:41"/>ናናዌ ከተም መኑ ፍርድ በር ከን ዘማን መኒን ሜጡበ እክ እሰ አሌን ፈረዳአ፤ መሰንትስ ናናዌ መኑ ዩኑስ ዱዱብሴኢሃ ሞጮጭቶ ወክት ጩብችሰ ቶበት ፈንቀልቶኡ፤ ሁኩዕኑን ዩኑሲች በተአኖሁ ከበ ዮኡ።<note caller="-" style="x"><char style="xo" closed="false">12፥41 </char><char style="xt" closed="false"><ref loc="JON 3:5">ዩኑ. 3፥5</ref>።</char></note> <verse eid="MAT 12:41"/><verse number="42" style="v" sid="MAT 12:42"/>ካኣጵ ዎመት ሱለይማን ሀይመተ ሞጮጭቶተ ኡለ ገበሊች አሜቶቤቺሃ ፍርድ በር ከን ዘማን መኒን ሜጡበ እሰ አሌን ፈረዳአ፤ ሁኩዕኑን ሱለይማኒች በተአኖሁ ከበ ዮኡ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">12፥42 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1 ነገ. 10፥1-10</ref>፤ <ref loc="2CH 9:1-12">2 ዱዱ. 9፥1-12</ref>።</char></note><verse eid="MAT 12:42"/></para>
  <para style="s1">ዶሮርኖ ዱሩ መን ኣዝ ፈንቀሉስ</para>
  <para style="r">(<ref loc="LUK 11:24-26">ሉቃ. 11፥24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43"/>ኢስ «ዶሮረኖ ዱሩ መንቺች ፉሎ ወክት ፎሎጨኖ ቤቹ ሀሰን ዉሁ ዮበእቤቾን ጉዕማንን ዘሀኖ፤ እኮጎሬ ደአኖበአ። <verse eid="MAT 12:43"/><verse number="44" style="v" sid="MAT 12:44"/>ህካን እኮቤቺሃ ‹ፉሎም ምኒ ፈንቀል ኦሮኣም› የኖ፤ እስን ፈንቀል አሜተኖረ ምኑስ ኦነ እክ ሀጣወም ተቃጠብያን ደገኖ። <verse eid="MAT 12:44"/><verse number="45" style="v" sid="MAT 12:45"/>ህከኒች ኤተሮን ኦሮዕይ እሲች ሂላኑተ ዎሉ ለመለ ሩሃንየ ኤበኖ፤ እሰን ህከን መንቾን ኣግ ሄኣአ፤ ህካን እኮቤቺሃ ህከን መንች ሄኡ ዎኔች ኤተርሲሁ በትሽ ሂለ እሀኖ፤ ከን ዘማን ሂለ መን አሌን ህትኔ ጠዉ እሀኖ» ዬእ።<verse eid="MAT 12:45"/></para>
  <para style="s1">ኢስ አመተለከ አመስ ኦሱተ</para>
  <para style="r">(<ref loc="MRK 3:31-35">ማር. 3፥31-35</ref>፤ <ref loc="LUK 8:19-21">ሉቃ. 8፥19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46"/>ኢስ ኡመቲሃ ጠወአንን አመስለከ አመስኦሱት ደቀንቶስተ ሀስ አብሌን ኡርቶ እቅ። [ <verse eid="MAT 12:46"/><verse number="47" style="v" sid="MAT 12:47"/>መቱ መንቹ ኢሰ «አመክለከ አመክ ኦሱት ደቀንቶሄተ ሀስ አብሌን ኡርቶኡ» ዬስ።]<note caller="+" style="f"><char style="fqa" closed="false">መቱ መንቹ ኢሰ «አመክለከ አመክ ኦሱት ደቀንቶሄተ ሀስ አብሌን ኡርቶኡ» ዬስ፦ </char><char style="ft" closed="false">መት-መቱ ሉህ ክታበት ዎልንሽ 47 ዮሰበአ።</char></note><verse eid="MAT 12:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48"/>እኮጎሬ ኢስ ህከን መንቺሃ ፈንቀሽ «አመኢለከ አመኤ ኦሱቲ አዬኤታን?» ዬእ። <verse eid="MAT 12:48"/><verse number="49" style="v" sid="MAT 12:49"/>ህከኒች ኤተሮን አንገስ አሳበስ አደ ለልሰን «አመእለከ አመኤ ኦሱቲ ከኑኡታን። <verse eid="MAT 12:49"/><verse number="50" style="v" sid="MAT 12:50"/>መሰንትስ ሰማን ዮ አንኤ ሃሽኣቱተ ዊንሸኖሁ ጉዕሙንኩ አመኤየ ቤቱ፥ አመኤተ ቤቱለከ አመተኤ» ዬእ።<verse eid="MAT 12:50"/></para>
  <chapter eid="MAT 12"/>
  <chapter number="13" style="c" sid="MAT 13"/>
  <para style="s1">ዜሬተ ውጠኖ መንች ምሳልተ</para>
  <para style="r">(<ref loc="MRK 4:9">ማር. 4፥9</ref>፤ <ref loc="LUK 8:4-8">ሉቃ. 8፥4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1"/>ህከ በር ኢስ ምኒች ፉል ባር መዴን አፉዕሌእ። <verse eid="MAT 13:1"/><verse number="2" style="v" sid="MAT 13:2"/>ልግቡ ኡመቱ እስበ አሜች ጭምዬቤቺሃ ኢስ ጀልባን ኣግ አፉዕሌእ፤ ኡመቱ ጉዕሙንኩ ባር መዴን ኡርዮ እቅ።<note caller="-" style="x"><char style="xo" closed="false">13፥2 </char><char style="xt" closed="false"><ref loc="LUK 5:1-3">ሉቃ. 5፥1-3</ref>።</char></note> <verse eid="MAT 13:2"/><verse number="3" style="v" sid="MAT 13:3"/>ህከኒች ኤተሮን ኢስ ልግብ ጠወ ማቆን ኩለን «ሁኩዕኑን! መቱ መንቹ ዜሬተ ዉጦተ ፉሎ። <verse eid="MAT 13:3"/><verse number="4" style="v" sid="MAT 13:4"/>ዉጠንን መት-መቱስ ዎቄ ገበላን ኡባን ጪኡት አሜት እቶኡ። <verse eid="MAT 13:4"/><verse number="5" style="v" sid="MAT 13:5"/>ዎሉ ዜሬቱ ልግቡ ትቡ ዮበእቤቾን ክኑ ዮ ኡላን ኡቦ፤ ልግቡ ትቡ ዮበእቤቺሃ ደዕል ሙቾ፤ <verse eid="MAT 13:5"/><verse number="6" style="v" sid="MAT 13:6"/>ጠዉ እኮጎሬ አሩ ፉሎ ወክት ቆሮ፤ ጠጱ ዮስበእቤቺሃ ሞሎ። <verse eid="MAT 13:6"/><verse number="7" style="v" sid="MAT 13:7"/>ዎሉስ ዜሬቱ ኡት ኣዜን ኡቦ፤ ኡቱ ነጵ ሙተ አጉዕሜእ። <verse eid="MAT 13:7"/><verse number="8" style="v" sid="MAT 13:8"/>ዎሉ ዜሬቱ ጡመ ኡላን ኡብ ሙች መቱስ ጥብተ፥ መቱስ ሌሃዉ፥ መቱስ ሰጁ አቶቾ <verse eid="MAT 13:8"/><verse number="9" style="v" sid="MAT 13:9"/>ሞጮጭታ መጨት ዮሲሁ ሞጮጩን» ዬእ።<verse eid="MAT 13:9"/></para>
  <para style="s1">ኢስ ማቆን ሚሃ ጠወዕዮ ጎሬ</para>
  <para style="r">(<ref loc="MRK 4:10-12">ማር. 4፥10-12</ref>፤ <ref loc="LUK 8:9-10">ሉቃ. 8፥9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10"/>ህከኒች ኤተሮን አሳበስ ኢስበ አሜት «መኒሃ ማቆን ጠወኣንቲሁ ሚሃት?» ይቶኡ።<verse eid="MAT 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11"/>ኢስን ፈንቀሽ «ሰሜ ዎምነት ምስጥረ ደጉ ኣሰሞህዕኔ፤ ጠዉ እኮጎሬ ህካን ደጉ እሳሃ ኣሰሞሰበአ። <verse eid="MAT 13:11"/><verse number="12" style="v" sid="MAT 13:12"/>መሰንትስ ዮስ መንቺሃ ኣሰመኖስ፤ አበንከ በተአኖስ፤ ዮስበእሀኒች ሁኩ ዮሲንኩ ኣአመኖስ።<note caller="-" style="x"><char style="xo" closed="false">13፥12 </char><char style="xt" closed="false"><ref loc="MAT 25:29">ማቶ. 25፥29</ref>፤ <ref loc="MRK 4:25">ማር. 4፥25</ref>፤ <ref loc="LUK 8:18">ሉቃ. 8፥18</ref>፤ <ref loc="LUK 19:26">19፥26</ref>።</char></note> <verse eid="MAT 13:12"/><verse number="13" style="v" sid="MAT 13:13"/>አን እሳሃ ማቆን ኩላንሳሃ ለአን ለእበረ፥ ሞጮጭተን ሞጮጭትበረ፥ አጥራመትቡረ እኮቤቺሃት። <verse eid="MAT 13:13"/><verse number="14" style="v" sid="MAT 13:14"/>ህካን እኮቤቺሃ ነብዬቾ እስያሴን</para>
  <para style="q1" vid="MAT 13:14">« ‹ሞጮጩ ሞጮጭቴነንተ፤ ጠዉ እኮጎሬ አጥራመቴነንተበአ፤</para>
  <para style="q2" vid="MAT 13:14">ለኡስ ለኤነንተ ጠዉ እኮጎሬ ሆሮን ቀልብ አቴነንተበአ።<verse eid="MAT 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15"/>መሰንትስ ከን መን ቀልቡ ዱጆኡ፤</para>
  <para style="q2" vid="MAT 13:15">መጨንትሰ እፍሰንቶኡ፤ እልንትሰ ቆቆኡ፤</para>
  <para style="q2" vid="MAT 13:15">ህት እኮበእቀ፥ እሌንከሰ ለእ፥</para>
  <para style="q2" vid="MAT 13:15">መጫንከሰ ሞጮጭት፥</para>
  <para style="q2" vid="MAT 13:15">ቀልብንከሰ አጥረመት፥</para>
  <para style="q2" vid="MAT 13:15">ኢ አደ ፈንቀልቶ እቃን ፈይሳንሰ እቅ› »</para>
  <para style="m" vid="MAT 13:15">የመሞ ጠዉ አሌሰ ዊመኖ።<note caller="-" style="x"><char style="xo" closed="false">13፥15 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">ኢሳ. 6፥9-10</ref>።</char></note><verse eid="MAT 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16"/>«እኮጎሬ ክዕኔ እልት ለኣቤቺሃ፥ መጨክዕኔን ሞጮጭታቤቺሃ ማሰአንቶእራን። <verse eid="MAT 13:16"/><verse number="17" style="v" sid="MAT 13:17"/>አን ሀንቅ ያንክዕኔ፤ ከ አዕኑ ለኤነንታሃ ልግቡ ነብያኑትለከ ልግቡ ጠሊላኑት ለኦተ አበ ሄዕላቶ እቅ፤ ጠዉ እኮጎሬ ለኦበአ፤ ህትን ከ አዕኑ ሞጮጭቴንታሃ ሞጮጭቶተ ሄዕላቶ እቅ፤ እኮጎሬ ሞጮጭቶበአ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">13፥17 </char><char style="xt" closed="false"><ref loc="LUK 10:23-24">ሉቃ. 10፥23-24</ref>።</char></note><verse eid="MAT 13:17"/></para>
  <para style="s1">ዜሬተ ዉጣንች ምሳሌ ፍሳረተ</para>
  <para style="r">(<ref loc="MRK 4:13-20">ማር. 4፥13-20</ref>፤ <ref loc="LUK 8:11-15">ሉቃ. 8፥11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18"/>ኢስ «ቴ አዕኑ ከን ዜሬተ ዉጣንች ምሳሌ ፍሳረተ ሞጮጭዬ። <verse eid="MAT 13:18"/><verse number="19" style="v" sid="MAT 13:19"/>አዪሁ መገን ዎምነት ላገተ ሞጮጭ አጥራመትቡ ዎቄ አሌን ኡቦ ዜሬተ አጉደኖ፤ ሸይጣኑ አሜች ዉጠንቶ ላገተ ቀልቢችስ ኣእ ከመኖ። <verse eid="MAT 13:19"/><verse number="20" style="v" sid="MAT 13:20"/>ልግቡ ትቡ ዮበእቤቾን ክኑ ዮ ኡላን ኡቦ ዜሬቱ ላገስ ሞጮጭ ደዕል ሙንዲኖን ቶገኖ መንችተ ምሳል። <verse eid="MAT 13:20"/><verse number="21" style="v" sid="MAT 13:21"/>እኮጎሬ ጠጱ ዮስበእቤቺሃ ቀዉ ወክት ዱንከኖ፤ ህከን ላገ መሳን ኦርሸት ህከረንገ ያየሙ ኬእዮእቃን ወክትንከስ ደዕልን አመዕነቲችስ ኡበኖ። <verse eid="MAT 13:21"/><verse number="22" style="v" sid="MAT 13:22"/>ሁኩ ኡት ኣዜን ኡቦ ዜሬቱ ላገስ ሞጭጨኖ መንችተ ምሳል፤ እኮጎሬ ከን ኣዱንያ አሌን ሄእ ጠወ ሰውዩለከ ቀባጦን ናጠቀሙ ቀልቤስ ኣግ ሞጮጬ ላገተ አቶቱ ዮበኢሃ ፌሰኖ። <verse eid="MAT 13:22"/><verse number="23" style="v" sid="MAT 13:23"/>ጡመ ኡላን ዉጠሞ ዜሬቱ ላገስ ሞጮጭ ቀልቤስ ቶግ ኣኤ መንችተ ምሳል፤ እስን መቱ ጥብተ መቱ ሌሃዉ መቱ ሰጁ አቶተኖ» ዬእ።<verse eid="MAT 13:23"/></para>
  <para style="s1">ቅንጬ ምሳልተ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24"/>ህትን ኢስ ዎሌ ምሳሌን «ሰሜ ዎምነቱ ኡላንከስ ጡመ ዜሬተ ዉጮ መንቺን አጉጣቀመኖ። <verse eid="MAT 13:24"/><verse number="25" style="v" sid="MAT 13:25"/>ጠዉ እኮጎሬ መኑ ግሾ ወክት ዲኑስ አሜች አለስ ኣዜን ቅንጭተ ዉጭ ኦሮዕዮ። <verse eid="MAT 13:25"/><verse number="26" style="v" sid="MAT 13:26"/>ህካን እኮቤቺሃ አለሱ ነጵ አቶቾ ወክት ቅንጭንትስ ህከ ወክት ለልቶኡ። <verse eid="MAT 13:26"/><verse number="27" style="v" sid="MAT 13:27"/>ካዲመስ ኡለስ አንቤቹ አሜት ‹ቀርቾ! አቡራንከክ ጡመ ዜሬተ ዉጦንት እቅበእንዶ? ህከረ ቅንጭት ሀከን አዲች አሜቶኡ?› ይቶኡ። <verse eid="MAT 13:27"/><verse number="28" style="v" sid="MAT 13:28"/>እስን ፈንቀሽ ‹ህካን አዕዮሁ ዲና› ዬእ፤ ካዲመንት ፈንቀሽት ‹ህከረ መርን ቅንጭተ ቡቱንክ ከሞተ ሀሰንንዶ?› ይት ጠዕምቶኡ። <verse eid="MAT 13:28"/><verse number="29" style="v" sid="MAT 13:29"/>እስን ፈንቀሽ ‹እሀኖበአ! መሰንትስ ቅንጭተ ቡቱኬነንተ ወክት አለሱ ሜጡበ ቡቱኬነንተ። <verse eid="MAT 13:29"/><verse number="30" style="v" sid="MAT 13:30"/>ህካን እኮቤቺሃ ምዴኖ ወክቱ ኢሎተ ኢለ አለሱ ቅንጬን ሜጡበ ነጱን፤ ምዴኖ ወክት ምዳሀኑኡተ ሄጭቴን ቅንጭተ ቡቱኬን ጊረ ቡቦተ ኡሱሬ፤ እኮጎሬ አለሱስ ጭምአቴን ጎተራንከኤ ዎሬ ያም› ዬእ» ይ ኩሎሰ።<verse eid="MAT 13:30"/></para>
  <para style="s1">ዎንጌ እሌ ዜሬት ምሳልተ</para>
  <para style="r">(<ref loc="MRK 4:30-32">ማር. 4፥30-32</ref>፤ <ref loc="LUK 13:18-19">ሉቃ. 13፥18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31"/>ኢስ «ሰሜ ዎምነቱ መቱ መንቹ ጋሮ ኣዜን ዉጮ ዎንጌ እሌ ዜሬተ አጉዳኣ። <verse eid="MAT 13:31"/><verse number="32" style="v" sid="MAT 13:32"/>እሴን ዜሬት እሌች ጉዕሚችን ቀዉተ፤ እኮጎሬ ነጵቶ ወክት ጋሮን ካሴኖ አታክልቲች በተኣአ፤ ሎረ እካን ሰሜ ጪኡት አሜት ሀማንከሴ ምኒ እጃርታአ» ይ ዎሉ ምሳልተ ኩሎሰ።<verse eid="MAT 13:32"/></para>
  <para style="s1">ራጭት ምሳልተ</para>
  <para style="r">(<ref loc="LUK 13:20-21">ሉቃ. 13፥20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33"/>ኢስ ዎሎ ምሳሌን «ሰሜ ዎምነቱ መት መንቹት ጉዕሙንኩስ ሁፍ ዮተ ሰሶ ኮርቦቦ ቀማን ሜጡበ ቁፍሶ ራጭተ አጉዳአ» ይ ኩሎሰ።<verse eid="MAT 13:33"/></para>
  <para style="s1">ኢስ ምሳሌን ሚሃ ተማርሴጎሬ</para>
  <para style="r">(<ref loc="MRK 4:33-34">ማር. 4፥33-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34"/>ኢስ ከ ጉዕመንከ ጠወ ልግብየ ኡመቲ ምሳሌን ጠወዕዮ፤ ምሳልት ዮበኢሃ መቱርቹሃ ጠወዕዮሰበአ። <verse eid="MAT 13:34"/><verse number="35" style="v" sid="MAT 13:35"/>እስን ነብዬቾን</para>
  <para style="q1" vid="MAT 13:35">«ጠወኤ ምሳሌን ኩላም፤</para>
  <para style="q2" vid="MAT 13:35">ኣዱንያት ከለቀንቶች ኬሽ ደጵ ዬ ጠወ ጠወኣም» የመሞሁ ዊሞታት።<note caller="-" style="x"><char style="xo" closed="false">13፥35 </char><char style="xt" closed="false"><ref loc="PSA 78:2">መዝ. 78፥2</ref>።</char></note><verse eid="MAT 13:35"/></para>
  <para style="s1">ኢስ ቅንጬ ምሳልተ ጠወኡስ</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36"/>ኢስ ልግብ ኡመት አጉር ምኒ ኣጎ ወክት አሳበስ እስበ አሜት «አለሲን ሜጡበ ነጴ ቅንጬ ምሳልተ መሃጎር ኩልኔ» ይት ጠዕምቶኡ።<verse eid="MAT 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37"/>ኢስን ፈንቀሽ «ጡመ ዜሬተ ዉጮሁ መንችየ ቤቱ። <verse eid="MAT 13:37"/><verse number="38" style="v" sid="MAT 13:38"/>አቡረስ ከን ኣዱንያሃ አል፤ ጡሙ ዜሬቱ መገን ዎምነትተ እለ፤ ቅንጭንት ሸይጣንተ እለ። <verse eid="MAT 13:38"/><verse number="39" style="v" sid="MAT 13:39"/>ቅንጭተ ዉጮ ባለጋሩ እልቢስሃን፤ ምዴኖስ ወክቱ ኣዱንያሃ መጨረሸ፤ ምዳእሩ መገንተ መላይከ። <verse eid="MAT 13:39"/><verse number="40" style="v" sid="MAT 13:40"/>ህትን ቅንጭተ ጭምአኤን ጊራን ቡሴኖሀንገን ዘማን ጎፍሞኒ ህት እሀኖ። <verse eid="MAT 13:40"/><verse number="41" style="v" sid="MAT 13:41"/>መንች ቤቱ መላይከስ ሶክ መኑ ጩብ አአኖገ አታረለከ ሂለ ሆጉተ አቶረ እስ ዎምነቲችስ መጥ ፉሽታአ። <verse eid="MAT 13:41"/><verse number="42" style="v" sid="MAT 13:42"/>እሰንተ ጠረኘ ጊራን ኡጄናን ኦኡለከ የቡሩ ገዕሙ እሀኖ። <verse eid="MAT 13:42"/><verse number="43" style="v" sid="MAT 13:43"/>እኮጎሬ ሙጩራኑት አንሰ ዎምነቴን አሪገ ለሊሳአ፤ ሞጮጭታ መጨት ዮሲሁ ሄዕዮ ጎሬ ሞጮጩን» ዬእ።<verse eid="MAT 13:43"/></para>
  <para style="s1">ማጠንቶ ቀባጦ ምሳልተ</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44"/>ኢስ «ሰሜ ዎምነቱ መቴ አቡረ ኣዜን ማጠንቶ ቀባጡተ አጉዳአ፤ መቱ መንቹ ህከ ቀባጡተ ደኤ ወክት ፈንቀሽ ማጭ ሙንደአን ኦሮዕዮች ኤተሮን ዮሲሃ ጉዕመንከ ህር ህከ ኡለተ ህዕሬእ።»<verse eid="MAT 13:44"/></para>
  <para style="s1">ጤአተ እኮ ክን ምሳልተ</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45"/>ህትን ኢስ «ሰሜ ዎምነቱ አበ ጤአተ እኮ ክኑ ህዕሮተ ሀሰኖ ነጋዴተ አጉዳኣ። <verse eid="MAT 13:45"/><verse number="46" style="v" sid="MAT 13:46"/>እስን ዋጉስ አበ ጤአተ እኮ ክኑ ደኤ ወክት ምንስ ኦሮዕይ ዮሲሃ ጉዕመንከ ህር ህከ አበ ጤአተ እኮ ክኑ ህዕሬእ» ዬእ።<verse eid="MAT 13:46"/></para>
  <para style="s1">ዎሻድ ምሳልተ</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47"/>ህትን ኢስ «ሰሜ ዎምነቱ ባራን ኡጄናን አደደ ቁርጩሜተ ጭምአአኖ ዎሻደ አጉዳኣ። <verse eid="MAT 13:47"/><verse number="48" style="v" sid="MAT 13:48"/>ዎሻዱስ ዊሞ ወክት መኑ ገበለ ፉሽ ጡመስ መጠር ኦዳንከስ ዎር ሂለስ ቶረኖ። <verse eid="MAT 13:48"/><verse number="49" style="v" sid="MAT 13:49"/>ዘማን ጎፍሞን ህት እሀኖ፤ መገን መላይካት አሜት ጩበኛኑተ ፈየ መኒች አደ አታአ። <verse eid="MAT 13:49"/><verse number="50" style="v" sid="MAT 13:50"/>ጩበኛኑስ ጠእትበ ጊራን ቶሬናን ኦኡለከ የቡሩ ገዕሙ እሀኖሰ» ዬእ።<verse eid="MAT 13:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51"/>ኢስ አሳባተስ «ህካን ጉዕመንከ አጥራመቴንታእንዶ?» ይ ጠዕሜሰ ወክት «ኤ» ይቶኡ።<verse eid="MAT 13:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52"/>ኢስን «ህከረ ሰሜ ዎምነት ምስጥር ተማረኖ ሕግ አስተማርቹ ማጮ ቀባጡተ ምኒችስ ኑባቹለከ ሃዕሮ ኦዳተ ፉሸኖ መንቹ አጉደኖ» ዬእ።<verse eid="MAT 13:52"/></para>
  <para style="s1">ናዝሬት መኑ ኢሰ ቶጉ ግቦገ</para>
  <para style="r">(<ref loc="MRK 6:1-6">ማር. 6፥1-6</ref>፤ <ref loc="LUK 4:16-30">ሉቃ. 4፥16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53"/>ኢስ ህከ ምሳልተ ሹሎች ኤተሮን ህከንቤቺች ኦሮዕዮ። <verse eid="MAT 13:53"/><verse number="54" style="v" sid="MAT 13:54"/>ገይስ ባዱ አሜች ህከኔ ጭምትሰ ምናን ተማርሰኖሳት እቅ፤ እሰን አበ አጀብሲጭት «ኩ መንቹ ከ ሀይመተለከ ከ አጀብሲሰኖ ጠወ ሀከን አዲች ኤቦ? <verse eid="MAT 13:54"/><verse number="55" style="v" sid="MAT 13:55"/>ኩን አናጤችየ ቤቱበእንዶ? አመስ ማይረመ ዬኖተበእንዶ? አመስ ኦሱንት ያቁባቲ፥ ዩሱፋቲ፥ ስሞኔትለከ ይሁዳበእንዶ? <verse eid="MAT 13:55"/><verse number="56" style="v" sid="MAT 13:56"/>ህትን ሜአኖ አመስ ኦሱንት ጉዕሙንኩ ከኔ ኒን ሄኣእበእንዶ? ህካን እኮጎሬ ኩ መንቹ ከ ጠወ ጉዕመንከ ሀከን አዲች ደኤእ?» ይቶኡ። <verse eid="MAT 13:56"/><verse number="57" style="v" sid="MAT 13:57"/>እሰን ኢሰ ሙንደእ ቶጎበአ፤ ኢስን እሳንከ «ነብዬቹ ኬዕምሴኖስበኢሁ ባዶንከስለከ ጠለዕል ገይስ ምኔንት» ዬእ<note caller="-" style="x"><char style="xo" closed="false">13፥57 </char><char style="xt" closed="false"><ref loc="JHN 4:44">ያህ. 4፥44</ref>።</char></note> <verse eid="MAT 13:57"/><verse number="58" style="v" sid="MAT 13:58"/>አመዕነቱ ዮሰበእቤቺሃ ኢስ ህከን ቤቾን ልግብ አጀብሲሰኖ ጠወሃ አዕዮበአ።<verse eid="MAT 13:58"/></para>
  <chapter eid="MAT 13"/>
  <chapter number="14" style="c" sid="MAT 14"/>
  <para style="s1">ጠመቃንቾ ያህይ ሬሁተ</para>
  <para style="r">(<ref loc="MRK 6:14-29">ማር. 6፥14-29</ref>፤ <ref loc="LUK 9:7-9">ሉቃ. 9፥7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1"/>ህከ ወክት ገሊለ ባዱ ገሸኖ ሄሮድስ ኢስ ዱዱቡ ሞጮጬእ። <verse eid="MAT 14:1"/><verse number="2" style="v" sid="MAT 14:2"/>ህካን እኮቤቺሃ ሄሮድስ ካዲመስ «ኩን ጠመቃንቾ ያህዪት፤ ከ አጀብሲሰኖ ጠወ አአኖቲሁ ሬሆች ኬዕዮቤቺሃት» ዬሰ።<verse eid="MAT 14:2"/></para>
  <para style="p">
    <verse number="3-4" style="v" sid="MAT 14:3-4"/>መሰንትስ ሄሮድስ «ፍልጶሴ» ዬኖ አመስ ቤት ጫተ «ሄሮዳደ» ዬኖተ ኣኤቤቺሃ ያህይ «ሄሮዳደ ኣኡ ሀስሰኖሄበአ» ዬስቤቺሃ ሄሮድስ ያህይ ኡሱርስሾ እቅ።<note caller="-" style="x"><char style="xo" closed="false">14፥3-4 </char><char style="xt" closed="false"><ref loc="LUK 3:19-20">ሉቃ. 3፥19-20</ref>።</char></note><note caller="-" style="x"><char style="xo" closed="false">14፥3-4 </char><char style="xt" closed="false"><ref loc="LEV 18:16">ሌዌ 18፥16</ref>፤ <ref loc="LEV 20:21">20፥21</ref>።</char></note> <verse eid="MAT 14:3-4"/><verse number="5" style="v" sid="MAT 14:5"/>ህካን እኮቤቺሃ ሄሮድስ ያህይ ሾተ ሀሰኖ እቅ፤ ጠዉ እኮጎሬ ኡመቱ ያህይ ነብዬችገ አዕይ ለአኖስቤቺሃ ዋጄእ። <verse eid="MAT 14:5"/><verse number="6" style="v" sid="MAT 14:6"/>ሄሮድስ እለሞ በር ከበጄኖ በሬን ሄሮዳደ ቤቱት አሜት እሱለከ እስ ኮሀ ቦሎቸ አለጵተን ሙንዲሲሶኡ። <verse eid="MAT 14:6"/><verse number="7" style="v" sid="MAT 14:7"/>ህካን እኮቤቺሃ ሄሮድስ «ኢትታንት ጠወ ጉዕመንከ ኣሳንኬ» ይ ጤሌዕሌእ።<verse eid="MAT 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 14:8"/>እሴን አመሴ ሸዛንሴ «ጠመቃንቾ ያህይ ቡዕለ ከን ሳናን አት ቴሱ ኣሴኤ» ይቶኡ።<verse eid="MAT 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9"/>ዎሙ ህከን ጠዋን አበ ሻዦ፤ እኮጎሬ ላገተ ኣጎቤቺሃ ማዳን አፉዕልቶ ኮህ ማሌተ ይ ያህይ ቡዕለ ኣሴኖሴገ አዘዦ። <verse eid="MAT 14:9"/><verse number="10" style="v" sid="MAT 14:10"/>ህካን እኮቤቺሃ መቱ መንቹ ሶክ ያህይ ቡዕለ ኡሱር ምኔን ሙርሲሾ። <verse eid="MAT 14:10"/><verse number="11" style="v" sid="MAT 14:11"/>እስ ቡዕለንከ ሳናን ዎሬን ኣሴናንሴ አማተሴ መስት ኣቶኡ። <verse eid="MAT 14:11"/><verse number="12" style="v" sid="MAT 14:12"/>ያህይ አዎናኑት አሜት ጀናዘስ መስት ሞጎች ኤተሮን ጠወስ ኢስሃ ኩልቶኡ።<verse eid="MAT 14:12"/></para>
  <para style="s1">ኢስ ኦንቶ ኩሜ መኒሃ እትሾገ</para>
  <para style="r">(<ref loc="MRK 6:30-44">ማር. 6፥30-44</ref>፤ <ref loc="LUK 9:10-17">ሉቃ. 9፥10-17</ref>፤ <ref loc="JHN 6:1-14">ያህ. 6፥1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13"/>ኢስ ያህይ ሬሁተ ሞጮጬ ወክት ጀልባን ኣግ ኡለ ኡድመ ሜጢሀስ ኦሮዕዮ፤ ኡመቱንኩ ህካን ሞጮጭቶ ወክት ከተሚች ፉልት ሎካን አዎንቶስ። <verse eid="MAT 14:13"/><verse number="14" style="v" sid="MAT 14:14"/>ኢስ ጀልብች ፉል ልግብ ኡመት ለዕዮ ወክት አሙዦሰ፤ ጥዘናመሰን ፈይሾ።<verse eid="MAT 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15"/>ኡለት ሀዎርቶ ወክት አሳበት ኢስበ አሜት «ኩ ቤቹ ኡለሃ ኡድመ፤ ወክቱንኩ ሀዎርዮኡ፤ ህካን እኮቤቺሃ ኩ መኑ ግደኖን ዮ ቀእተ መርት እታኢሃ ህዕርቶተ ህርሲስሰ» ይቶኡ።<verse eid="MAT 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16"/>ኢስን «እሰ እታኢሃ አዕኑ ኣስዬ ቤሉ እሰ ህትን እቱዕነ ኦሮኡ ሀስሰኖበአ» ዬሰ።<verse eid="MAT 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17"/>አሳበንት «ኦንቱ ጣብተለከ ለሜ ቁርጩሜ ቤሉ መቱርቹሁ ዮኔበአ» ይቶኡ።<verse eid="MAT 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18"/>ኢስን «ኢቤቹ ኤቤ» ዬእ። <verse eid="MAT 14:18"/><verse number="19" style="v" sid="MAT 14:19"/>ህከኒች ኤተሮን መኑ ኡላን አፉዕሎተ አዘዦ፤ ኦንቱ ጣቢተለከ ለምተ ቁርጩሜተ አፍ ሰማ ለአን መገኑ ገለትጭ ጣቢተ ቢጭ አሳባተስ ኣሴእ፤ እሰን መኒሃ ኣቶኡ። <verse eid="MAT 14:19"/><verse number="20" style="v" sid="MAT 14:20"/>ጉዕሙንኩ መኑ እተን ዱባን ፈቆ ፉርፉሩ አሳበስ ቶነ ለሙ መሶበ ዊመ ኬሶኡ። <verse eid="MAT 14:20"/><verse number="21" style="v" sid="MAT 14:21"/>ህካን እቾ መን ዎሊንሹ ሜንቱሁ፥ ኦሱቲ ፈቀን ጎኑ ኦንቶ ኩሜ መን ጌሰ እሀኖ እቅ።<verse eid="MAT 14:21"/></para>
  <para style="s1">ኢስ ባር አሌን ሃመን ኦሮዕዮገ</para>
  <para style="r">(<ref loc="MRK 6:45-52">ማር. 6፥45-52</ref>፤ <ref loc="JHN 6:15-21">ያህ. 6፥15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22"/>ኢስ ኡመት ህርሲሰን አሳበስ ጀልባን ኣግ እሱ ሄጭት ዊች ዉድ አደ ቶልታገ አዘዦሰ። <verse eid="MAT 14:22"/><verse number="23" style="v" sid="MAT 14:23"/>ኡመት ህርሲሾች ኤተሮን ዱአ አኦተ ሜጥሀስ መቶ ቆተ አል ፉሎ፤ ኡለት ሀዎርቶ ወክት ኢስ ሜጢሀስ ህከኔ ሄዕዮ እቅ። <verse eid="MAT 14:23"/><verse number="24" style="v" sid="MAT 14:24"/>ህከ ወክት ጀልቡ ኡላች ቄዕር ዮሀኔን ዎሎ አዲን ቦብረኖ ቦብሪን ሀንበለመን ዊ ሁሉ ከበሃ ካጰ አአን ጨነቀኖሳት እቅ። <verse eid="MAT 14:24"/><verse number="25" style="v" sid="MAT 14:25"/>ሀንከዕሬ ቶኖ ሰኣት ጌሳን ኢስ ባር አሌን ሃመን አሳበስበ አሜቾ። <verse eid="MAT 14:25"/><verse number="26" style="v" sid="MAT 14:26"/>አሳበስ ባር አሌን ሃመን ለኦ ወክት አበ ህልቅ «ኩን ሀብዙላትሃ» ይት ዋጅት ያርቶኡ።<verse eid="MAT 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27"/>ኢስ ህከ ወክት አሳበስ «አደብ አዕዬ! ዋጅቶኖቼ አኔት» ይ ጠወዕዮሰ።<verse eid="MAT 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28"/>ህከ ወክት ጴጥሮስ «ቀርቾ! አቴትጎሬ ዊ አሌን ሃመን ኪበ አሜቶተ አዘዜኤ» ዬእ።<verse eid="MAT 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29"/>ኢስን «አም» ዬእ፤ ጴጥሮስን ጀልብ ኣዚች ፉል ዊ አሌን ሃመን ኢስበ ኦሮዕዮ። <verse eid="MAT 14:29"/><verse number="30" style="v" sid="MAT 14:30"/>ጠዉ እኮጎሬ ጠረኘ ቦብረ ለዕዮ ወክት ዋጄእ፤ ዊ ኣዝ ዋል ኣአሞተ እኮ ወክት «ቀርቾ! ፌሴኤ» ይ ያሮ።<verse eid="MAT 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31"/>ኢስን ወክትንከስ አንገስ ሶክ አፍ «ኩ አመዕነቱ ሆፈዕዮኤሁ! ሚሃት ሸክቶንቲሁ?» ዬእ።<verse eid="MAT 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32"/>ኢስለከ ጴጥሮስ ጀልባን ኣጎ ወክት ቦብሩ ጨለ ዬእ። <verse eid="MAT 14:32"/><verse number="33" style="v" sid="MAT 14:33"/>ህካን እኮቤቺሃ ጀልባን ሄኦ አሳበት «ሀንቅንከ አት መገንየ ቤቱ» ይት ኢሲሃ ሰገዶኡ።<verse eid="MAT 14:33"/></para>
  <para style="s1">ኢስ ጌንሴሬጣን ጥዘናመተ ፈይሱስ</para>
  <para style="r">(<ref loc="MRK 6:53-56">ማር. 6፥53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34"/>ኢስለከ አሳበስ ባረ ቶልት «ጌንሴሬጠ» ዬኖ ባዱ ኢልቶኡ። <verse eid="MAT 14:34"/><verse number="35" style="v" sid="MAT 14:35"/>ህከን ባዶን ሄዕዮ መኑ ኢሰ እሁስ ደጎ ወክት ህከን አዳን ሄዕዮ ባዱ ጉዕመንከ ሶካን ጥዘናመተ ጉዕመንከ እስበ ኤቦኡ። <verse eid="MAT 14:35"/><verse number="36" style="v" sid="MAT 14:36"/>ሁኩ ጥዘናመት ጠለዕል ኦድኖስ ሰኑተ ኡልቶተ ኡጭቶስ፤ ኦድኑስ ኡልቶእሩ ጉዕሙንኩ ጥዘናችሰ ፈይቶኡ።<verse eid="MAT 14:36"/></para>
  <chapter eid="MAT 14"/>
  <chapter number="15" style="c" sid="MAT 15"/>
  <para style="s1">አናኖ ዎገ</para>
  <para style="r">(<ref loc="MRK 7:1-13">ማር. 7፥1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1"/>ፈርሳውትለከ ሕግ አስተማረት ዬሩሳሌሚች ኢስበ አሜት <verse eid="MAT 15:1"/><verse number="2" style="v" sid="MAT 15:2"/>«ሚሃት አሳበክ ባልቅ ዎገ ድጅታኢሁ? መሰንትስ አንገተ ኣዕልቱዕናን እታኢሁ ሚሃት?» ይት ጠዕምቶኡ።<verse eid="MAT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3"/>ኢስ ፈንቀሽ «አዕኑ ሚሃት ዎጊሀክዕኔ ይቴነን መገን ትዛዝ ድጅቴነንታት? <verse eid="MAT 15:3"/><verse number="4" style="v" sid="MAT 15:4"/>መሰንትስ መገኑ ‹አነክለከ አመክ ኬዕምስ› ህትን ‹አንስለከ አመስ አሌን ቦሮር ላገተ ጠወአኖሁ ሬሆን ቀጠአሙን› ይ አዘዦኡ።<note caller="-" style="x"><char style="xo" closed="false">15፥4 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ፉል. 20፥12</ref>፤ <ref loc="EXO 21:17">21፥17</ref>፤ <ref loc="DEU 5:16">ዘዳ. 5፥16</ref>፤ <ref loc="LEV 20:9">ሌዌ 20፥9</ref>።</char></note> <verse eid="MAT 15:4"/><verse number="5" style="v" sid="MAT 15:5"/>እኮጎሬ አዕኑ ‹መቱ መንቹ አነስለከ አመስ ኢች ደእቴነንታሃ አን መገኒሃ ኣስዮም› ዬጎሬ <verse eid="MAT 15:5"/><verse number="6" style="v" sid="MAT 15:6"/>‹ሁኩ መንቹ አነስ<note caller="+" style="f"><char style="fqa" closed="false">አነስ፦ </char><char style="ft" closed="false">የኖሁ መት-መቱ ሉህ ክታበት አነስ ህከረንገ አመስ ይታአ።</char></note> ኬዕምሱ ሀሲሰኖበአ› ይቴነንተ፤ ህካን እኮቤቺሃ አዕኑ ገይክዕኔ ዎጊሃ ይቴን መገን ሕገ ድጅቴነንታት። <verse eid="MAT 15:6"/><verse number="7" style="v" sid="MAT 15:7"/>አዕኑ ኩ መኑ ለኦህዕኔተ ይቴን አቴነንተሩ! ነብዬቹ እስያስ ክዕኔተኔሃ<verse eid="MAT 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8"/>« ‹ኩ መኑ አፌንከስ ኬዕምሰኖኤ፤</para>
  <para style="q2" vid="MAT 15:8">እኮጎሬ ቀልቡስ ኢች ቄዕርዮኡ፤<verse eid="MAT 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9"/>እሰ መን ወገለከ ሴረ</para>
  <para style="q2" vid="MAT 15:9">ሕግገ አት ተማርስተን ኤሳሃ ሰገዱሰ ተሰ ዮንከስ ሀንቅ ራጎኡ› » ዬእ።<note caller="-" style="x"><char style="xo" closed="false">15፥9 </char><char style="xt" closed="false"><ref loc="ISA 29:1">ኢሳ. 29፥1</ref>።</char></note><verse eid="MAT 15:9"/></para>
  <para style="s1">መነ ንጃስሰኖ ጠወ</para>
  <para style="r">(<ref loc="MRK 7:14-23">ማር. 7፥14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10"/>ኢስ ኡመት እስቤቹ ገእ «ሞጮጭዬ! አጥራመቼ! <verse eid="MAT 15:10"/><verse number="11" style="v" sid="MAT 15:11"/>መነ ንጃስሰኖሁ አፌች ፉለኑወ ቤሉ አፎንከስ ኣገኖሃበአ» ዬእ።<verse eid="MAT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12"/>ህከኒች ኤተሮን አሳበስ እስበ አሜት «ፈርሳውት ከ ጠወ ሞጮጭቶ ወክት ኡሙዕርቶገ ደጎንትንዶ?» ይት ጠዕምቶኡ። <verse eid="MAT 15:12"/><verse number="13" style="v" sid="MAT 15:13"/>ኢስን ፈንቀሽ «ሰማን ዮ አኑኤ ካስቡ ሀቁ ጉዕሙንኩ ቡቱከመኖ። <verse eid="MAT 15:13"/><verse number="14" style="v" sid="MAT 15:14"/>እሰ ቆቃኑተለከ ቆቃኑተ አዎንስታረ እኮቤቺሃ ጌኝ አዕዬሰ፤ ቆቁ ቆቀ አዎንሴ ጎር ለሙንኩ ኤሎን ኡባአ» ዬእ።<verse eid="MAT 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15"/>ጴጥሮስ ኢሰ «ከን ማቆ ፍሳረተ ኩልኔ» ዬስ። <verse eid="MAT 15:15"/><verse number="16" style="v" sid="MAT 15:16"/>ኢስ ፈንቀሽ «አዕኑ ቴሶ ኢለ አጥራመቴንታበእንዶ? <verse eid="MAT 15:16"/><verse number="17" style="v" sid="MAT 15:17"/>አፎን ኣጎርቹ ጉዕሙንኩ ጎደባን ኣግ ሹመተ እክ ፉለኖገ ደጌነንተበእንዶ? <verse eid="MAT 15:17"/><verse number="18" style="v" sid="MAT 15:18"/>እኮጎሬ አፌች ፉለኖሁ ቀልቤን ዮሀኒችት፤ መነ ንጃስሰኖሁ ህከኒት።<note caller="-" style="x"><char style="xo" closed="false">15፥18 </char><char style="xt" closed="false"><ref loc="MAT 12:34">ማቶ. 12፥34</ref>።</char></note> <verse eid="MAT 15:18"/><verse number="19" style="v" sid="MAT 15:19"/>መሰንትስ ሂለ ሰውዩሁ፥ መነ ሹሁ፥ ዝነት፥ ሞጉሁ፥ ክዝብ መሰከሩሁ፥ መን ሱዕመ ቤሱሁ ሁኩን ጉዕሙንኩ መን ቀልቢች ፉለኖሃን። <verse eid="MAT 15:19"/><verse number="20" style="v" sid="MAT 15:20"/>መነ ንጃስሰኖሁ ህከኒት ቤሉ አንገተ አዕሎኑዕነ እቱ ሆሮ ንጃስሰኖበአ» ዬእ።<verse eid="MAT 15:20"/></para>
  <para style="s1">መቴ መንቾ አመዕነቱ</para>
  <para style="r">(<ref loc="MRK 7:24-30">ማር. 7፥24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21"/>ኢስ ህከንቤቺች ኬዕይ ጢሮሰለከ ሲዶነ ዬኖ ባዱ ኦሮዕዮ። <verse eid="MAT 15:21"/><verse number="22" style="v" sid="MAT 15:22"/>ህከን ባዶን ሄኣ መት ከነኣናውቹት መንቹት ኢስበ አሜት «ደዉዴ ቤቶ ቀርቾ! ቤቱኤ ዶሮረኖ አያኑ አፋንሴ አበ ኦርጨቀንታኢት፤ ሀዕይ አሙዜኤ» ይት ኡጭቶስ።<verse eid="MAT 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23"/>እኮጎሬ ኢስ መት ላገታ ፈንቀሽዮበአ፤ ህካን እኮቤቺሃ አሳበስ እስበ ሆንጠክ «ት መንቹት ኔሳሃ አዎንተን ጨንጭታቤቺሃ ሀዕይ መርታገ አእሴ» ይት ኡጭቶስ። <verse eid="MAT 15:23"/><verse number="24" style="v" sid="MAT 15:24"/>ኢስን «አን ሶሀሞሚሁ እስራኤል ምኒች በኦ ሆላታት ቤሉ ወሊሃ ሶሀሞምበአ» ይ ፈንቀሼእ።<verse eid="MAT 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25"/>እኮጎሬ ህት መንቹት «ሀዕይ ቀርቾ ሀዕሌኤ» ይት ሎከስ ኡቦኡ።<verse eid="MAT 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26"/>ኢስ «ኦሱት እታ እቸተ ዉሻተ ቶሩ ሀስሰኖበአ» ዬእ።<verse eid="MAT 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27"/>እሴን «ቀርቾ ሁኩን ሀንቅሃን፤ ጠዉ እኮጎሬ ዉሸት ምኒ መን ማዲች ፈቆ ፉርፉሩ እታአ» ይቶኡ።<verse eid="MAT 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28"/>ህከ ወክት ኢስ «አት አቡ አመዕነቱ ዮሄተ መንቹ፤ ህካን እኮቤቺሃ አት ኢትቶንትገን እሆሄ» ዬሴ፤ ህከ ወክትንከ ቤቱሴ ፈይቶኡ።<verse eid="MAT 15:28"/></para>
  <para style="s1">ኢስ ልግብ ጥዘናመተ ፈይሱስ</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29"/>ኢስ ህከንቤቺች ኬዕይ ገሊለ ባር መዲን ህግ ቆተ አል ፉል ህከኔ አፉዕሌእ። <verse eid="MAT 15:29"/><verse number="30" style="v" sid="MAT 15:30"/>ልግቡ ኡመቱ ሎከተ ድናኑታ፥ ቆቃኑታ፥ ናፎ መነሃ፥ ዱዳኑታለከ ዎልት ጥዘናመታ ኣእት ኢስበ አሜት ሎከስ መዴን አፉሽቶኡ፤ እስን ፈይሾሰ። <verse eid="MAT 15:30"/><verse number="31" style="v" sid="MAT 15:31"/>ህካን እኮቤቺሃ ኡመቱ ዱዳኑት ጠወአን፥ ናፋኑት ፈይተን፥ ድናኑት ጌጥ ይት ሃንተን፥ ቆቃኑት ለአን ለኦ ወክት አጀብሲጭት እስራኤል መገኑ ገለትጭቶኡ።<verse eid="MAT 15:31"/></para>
  <para style="s1">ኢስ ሾሌ ኩሜ መነ እትሱስ</para>
  <para style="r">(<ref loc="MRK 8:1-10">ማር. 8፥1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32"/>ኢስ አሳበስ እስበ ገእ «ኩ ኡመቱ ኢን ሜጡበ ሰሱ በር ዱንክቶኡ፤ እታኢሁ መቱርቹሁ ዮሰበእቤቺሃ አሙዛንሰ፤ ዎቃን ሆጋቤቺሃ ጎሪንከሰ መርቶተ ገፈራንሰበአ» ዬእ። <verse eid="MAT 15:32"/><verse number="33" style="v" sid="MAT 15:33"/>አሳበስ «ህከረ ከን ጉዕማንከ መኒሃ እካ እቸተ ከን ኡለ ኡድማን ሀከንቤቺች ኤምባም?» ይቶኡ። <verse eid="MAT 15:33"/><verse number="34" style="v" sid="MAT 15:34"/>ኢስ «ሄንኩ ጣቢቱ ዮህዕኔ?» ይ ጠዕሜሰ፤ እሰን «ለመሉ ጣቢቱለከ ቀዉንኩ ቀቀዋኑት ቁርጩሜት ዮኔ» ይቶኡ።<verse eid="MAT 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35"/>ህከኒች ኤተሮን ኢስ ኡመቱ ኡላን አፉዕለኖገ አዕዮ። <verse eid="MAT 15:35"/><verse number="36" style="v" sid="MAT 15:36"/>ህት አዕይ ለመለ ጣቢተለከ ቁርጩሜተ አፍ መገኑ ገለትጭ ቢጭ አሳባተስ ኣስያን አሳበስ መኒሃ ኣቶኡ። <verse eid="MAT 15:36"/><verse number="37" style="v" sid="MAT 15:37"/>ጉዕሙንኩሰ እት ዱባን ፈቆ ፉርፉሩ አሳበስ ለመለ መሶበ ዊመ ኬሶኡ። <verse eid="MAT 15:37"/><verse number="38" style="v" sid="MAT 15:38"/>እቾ መኑ ሜንቱለከ ኦሱተ ወለአንቱዕናን ሾሌ ኩሜ ጎነ እቅ።<verse eid="MAT 15:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39"/>ኢስ ኡመት ህርሲሾች ኤተሮን ጀልባን ኣግ «መጌዶነ» ዬኖ ባዱ ኦሮዕዮ።<verse eid="MAT 15:39"/></para>
  <chapter eid="MAT 15"/>
  <chapter number="16" style="c" sid="MAT 16"/>
  <para style="s1">መላተ ለኢሃ ሆንጠኮ ጠዕምቱተ</para>
  <para style="r">(<ref loc="MRK 8:11-13">ማር. 8፥11-13</ref>፤ <ref loc="LUK 12:54-56">ሉቃ. 12፥54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1"/>ፈርሳውትለከ ሰዱቃውት አሜት ኢሰ ፌተንቶተ «ህንዴ ሰሜች መላተ ለሊስኔ» ይት ጠዕምቶስ።<note caller="-" style="x"><char style="xo" closed="false">16፥1 </char><char style="xt" closed="false"><ref loc="MAT 12:38">ማቶ. 12፥38</ref>፤ <ref loc="LUK 11:16">ሉቃ. 11፥16</ref>።</char></note> <verse eid="MAT 16:1"/><verse number="2" style="v" sid="MAT 16:2"/>ኢስ ፈንቀሽ «ኡለት ሀዎርቶ ወክት ሰሞሁ ቢሸዕዮኡ፤ [‹ጋተ ኡለት ብረተ እካአ› ይቴነንተ። <verse eid="MAT 16:2"/><verse number="3" style="v" sid="MAT 16:3"/>ህትን ገስመ ‹ሰሞሁ ጎመተ እኮኡ፤ ከበር ጠረኙ ጤኑ ኡበኖ› ይቴነንተ፤ ሰማሃ ለኤን አደ አቴን ደጌነንታት፤ ህከረ ሚሃት ዘማንስ መላተ አደ አቴን ደጌነንተበኢሁ?]<note caller="+" style="f"><char style="ft" closed="false">መት-መቱ ሉህ ክታበት ዎሊንሽ ለሞንለከ ሰሶን ዮኢሃ ኢስ ጠወእዮሃ በርግታበአ።</char></note> <verse eid="MAT 16:3"/><verse number="4" style="v" sid="MAT 16:4"/>አመዕነቱ ዮበእ ሂሉ ከን ዘማን መኑ መላተ ለኦተ ሀሰኖ፤ እኮጎሬ ዩኑስ መላ ቤሉ ዎልት መላት ኣሰንታስበአ» ዬሰ፤ ህከኒች ኤተሮን ኢስ እሰተ አጉር ዎሉቤቹ ኦሮዕዮ።<note caller="-" style="x"><char style="xo" closed="false">16፥4 </char><char style="xt" closed="false"><ref loc="MAT 12:39">ማቶ. 12፥39</ref>፤ <ref loc="LUK 11:29">ሉቃ. 11፥29</ref>።</char></note><verse eid="MAT 16:4"/></para>
  <para style="s1">ፈርሳዌለከ ሰዱቃዌ ራጭትተኔሃ</para>
  <para style="r">(<ref loc="MRK 8:14-21">ማር. 8፥14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5"/>ኢስ አሳበት ባረ ቶልቶ ወክት እቸተ አፉዕነ ሀቦ እቅ። <verse eid="MAT 16:5"/><verse number="6" style="v" sid="MAT 16:6"/>ኢስ «ፈርሳዌለከ ሰዱቃዌ ራጭቲች ጠረኝቴን አገዕርዬ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">16፥6 </char><char style="xt" closed="false"><ref loc="LUK 12:1">ሉቃ. 12፥1</ref>።</char></note><verse eid="MAT 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7"/>እሰን «እቸተ አንፍበቤቺሃትጎር?» ይት ገገዉንኩሰ ጠወኦኡ።<verse eid="MAT 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8"/>እኮጎሬ ኢስ ህካን ደግ «ኩ አመዕነቱ ሆፈዕዮህዕኔ መኑ! እቸተ አንፍበቤቺሃት ይቴነን ሚሃት ገገዊንከክዕኔ ጠወኤነንታት? <verse eid="MAT 16:8"/><verse number="9" style="v" sid="MAT 16:9"/>ቴሶሃ ኢለ አጥራመቴንበረንዶ? ኦንቱ ጣቢተ ኦንቶ ኩሜ መኑ እቻን ፈቆ ፉርፉሩ ሄንከ መሶበ ኬሴንተጎሬ ሰውይቴነንተበእንዶ?<note caller="-" style="x"><char style="xo" closed="false">16፥9 </char><char style="xt" closed="false"><ref loc="MAT 14:17-21">ማቶ. 14፥17-21</ref>።</char></note> <verse eid="MAT 16:9"/><verse number="10" style="v" sid="MAT 16:10"/>ህትን ለመለ ጣቢተ ሾሌ ኩሜ መኑ እተን ፈቆ ፉርፉሩ ኬሴንታሁ ሄንካጎሬ ሰውይቴነንተበእንዶ?<note caller="-" style="x"><char style="xo" closed="false">16፥10 </char><char style="xt" closed="false"><ref loc="MAT 15:34-38">ማቶ. 15፥34-38</ref>።</char></note> <verse eid="MAT 16:10"/><verse number="11" style="v" sid="MAT 16:11"/>አን ጠወዕዮሚሁ እቸተኔሃ እሁ ሆጉስ ሀት አጥረመቴነንተበአ? ፈርሳዌለከ ሰዱቃዌ ራጭቲች አገዕርዬ» ዬሰ።<verse eid="MAT 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12"/>አሳበስ ኢስ «አገዕርዬ» ዬሳሁ ፈርሳዌለከ ሰዱቃዌ ትምርቲች ቤሉ ጣብት ራጭቲች እሁ ሆጉስ አጥረመቶኡ።<verse eid="MAT 16:12"/></para>
  <para style="s1">ኢስ ቡረሞሃ እሁስ ጴጥሮስ መሰከሩስ</para>
  <para style="r">(<ref loc="MRK 8:27-30">ማር. 8፥27-30</ref>፤ <ref loc="LUK 9:18-21">ሉቃ. 9፥18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13"/>ኢስ «ፍልጶስ ቂሳረ» ዬኖ ባዱ አሜቾ ወክት አሳበስ «መኑ መንች ቤቱ አዬት ይታኢት?» ይ ጠዕሜሰ።<verse eid="MAT 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14"/>እሰን «መት-መቱ ‹ጠመቃንቾ ያህዪት› ዎሉሰ ‹እልያሴት› ዎሉሰንገ ‹ኤርምያሴት ህከረንገ ነብያኖች መቶሃስ› ይታኢት» ይቶኡ።<note caller="-" style="x"><char style="xo" closed="false">16፥14 </char><char style="xt" closed="false"><ref loc="MAT 14:1-2">ማቶ. 14፥1-2</ref>፤ <ref loc="MRK 6:14-15">ማር. 6፥14-15</ref>፤ <ref loc="LUK 9:7-8">ሉቃ. 9፥7-8</ref>።</char></note><verse eid="MAT 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15"/>ኢስ «አዕኑ ኤሳሃ አዬት ይቴነንተኤት?» ዬሰ።<verse eid="MAT 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16"/>ስሞን ጴጥሮስ «አት ሄአኖ መገኒየ ቤቱ መሲህት» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">16፥16 </char><char style="xt" closed="false"><ref loc="JHN 6:66-69">ያህ. 6፥66-69</ref>።</char></note><verse eid="MAT 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17"/>ኢስን «ዮነ ቤቱ ስሞኔ! አት ማሰአንቶንትሃን፤ መሰንትስ ካን ለሊሾሄሁ ሰማን ዮ አናኤ ቤሉ መናበአ። <verse eid="MAT 16:17"/><verse number="18" style="v" sid="MAT 16:18"/>አን ኩላንኬ፤ ኪ ሱዕሙ ጴጥሮሴት፤ ጠረኛ ክኑ፤ ከን ክን አሌን ጭምት ዱእ ምኒ እጃራም፤ ህካንን ሬሆ ዎልቀት ቄልታበአ። <verse eid="MAT 16:18"/><verse number="19" style="v" sid="MAT 16:19"/>አን ኬሳሃ ሰሜ ዎምነት ቁልፋከተ ኣሳንኬ፤ ኡላን ኡሱርቶንቲሁ ሰማን ኡሱረሞሃ እሀኖ፤ ህትን ኡላን ሂርቶንቲሁ ሰማን ሂረሞሃ እሀኖ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">16፥19 </char><char style="xt" closed="false"><ref loc="MAT 18:18">ማቶ. 18፥18</ref>፤ <ref loc="JHN 20:23">ያህ. 20፥23</ref>።</char></note> <verse eid="MAT 16:19"/><verse number="20" style="v" sid="MAT 16:20"/>ህከኒች ኤተሮን አሳበስ እስ መሲህ እሁስ አዬሃ ኩልታበእገ ጠረኝሽ አዘዦሰ።<verse eid="MAT 16:20"/></para>
  <para style="s1">ኢስ ሬሁስለከ እልታስ ኦርሸተ ጠወኡስ</para>
  <para style="r">(<ref loc="MRK 8:31-33">ማር. 8፥31-33</ref>፤ <ref loc="LUK 9:22-27">ሉቃ. 9፥22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21"/>ህከን ወክቲች ኬሽ ኢስ አሳበስ «ዬሩሳሌመ ኦሮኣም፤ ህከኔን ባድ ባልቃች፥ ሎርሎረ ቂሳችለከ ሕግ አስተማራች ኦርሸት ኢልታኤ፤ ሽታኤ፤ እኮጎሬ ሰቅ በር ሬሆች ኬኣም» ዩ ጀመሮ።<verse eid="MAT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22"/>ህካን እኮቤቺሃ ጴጥሮስ ኢሰ መድ ዋሽ «ቀርቾ! ሆሮ እሀኖበአ፤ ኩ ጠዉ ሆሮን እለኖሄበአ» የን ሻቁ ጀመሮ።<verse eid="MAT 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23"/>እኮጎሬ ኢስ ጴጥሮሴ አደ ፈንቀል «ኩ ሻይጣንቹ መዲችኤ ሽቅ! አት መኒሃ ቤሉ መገን መኑ ሰውየኖ ሃሊን ሰውይታንትበእቤቺሃ ቆፉተ እኮንቴኤ» ዬእ።<verse eid="MAT 16:23"/></para>
  <para style="s1">መሲህ አዎኑ ዋጋ ባትሲሰኖሃ እሁስ</para>
  <para style="r">(<ref loc="MRK 8:34-9:1">ማር. 8፥34—9፥1</ref>፤ <ref loc="LUK 9:23-27">ሉቃ. 9፥23-27</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24"/>ህከኒች ኤተሮን ኢስ አሳበስ «አዪሁ ኤሳሃ አዎኖተ ሀሰኖሁ ገዉስ ለገኡን፤ ህትን መስቀለስ እጅ ኤሳሃ አዎኑን።<note caller="-" style="x"><char style="xo" closed="false">16፥24 </char><char style="xt" closed="false"><ref loc="MAT 10:38">ማቶ. 10፥38</ref>፤ <ref loc="LUK 14:27">ሉቃ. 14፥27</ref>።</char></note> <verse eid="MAT 16:24"/><verse number="25" style="v" sid="MAT 16:25"/>አዪሁ ፎልስ ፌሶተ ሀሾ ጎሬ ቤሰኖ፤ ህትን አዪሁ ኢተኔሃ ፎልስ ቤሰኖሁ ደአኖ።<note caller="-" style="x"><char style="xo" closed="false">16፥25 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቶ. 10፥39</ref>፤ <ref loc="LUK 17:33">ሉቃ. 17፥33</ref>፤ <ref loc="JHN 12:25">ያህ. 12፥25</ref>።</char></note> <verse eid="MAT 16:25"/><verse number="26" style="v" sid="MAT 16:26"/>መቱ መንቹ ኣዱንያ አሌን ዮኢሃ ጉዕመንከ ደእ ፎልስ ቤሾ ጎሬ መ ደግለለኖስ? ህከረንገ መቱ መንቹ ፎልስ ወጥ መ ባቶተ አታለኖ? <verse eid="MAT 16:26"/><verse number="27" style="v" sid="MAT 16:27"/>መንች ቤቱ አንስ ኬዕምኚን ገይስ መላይካን ሜጡበ አሜተኖ፤ ህከ ወክት እስን አነኒንከ ሆጎስ ወጥ ባተኖ።<note caller="-" style="x"><char style="xo" closed="false">16፥27 </char><char style="xt" closed="false"><ref loc="MAT 25:31">ማቶ. 25፥31</ref>፤ <ref loc="PSA 62:12">መዝ. 62፥12</ref>፤ <ref loc="ROM 2:6">ሮሜ 2፥6</ref>።</char></note> <verse eid="MAT 16:27"/><verse number="28" style="v" sid="MAT 16:28"/>ሀንቅንከ ያንክዕኔ፤ መንች ቤቱ ጄነቴንከስ አሜተን ለኦተ ኢለ ከኔ ኡርቶሀኑኡች ሬታበእሩ ዮኡ» ዬእ።<verse eid="MAT 16:28"/></para>
  <chapter eid="MAT 16"/>
  <chapter number="17" style="c" sid="MAT 17"/>
  <para style="s1">ኢስ ደኑ ዶረሙስ</para>
  <para style="r">(<ref loc="MAT 19:2-13">ማቶ. 19፥2-13</ref>፤ <ref loc="LUK 9:28-36">ሉቃ. 9፥28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1"/>ሌሆ በሬች ኤተሮን ኢስ ጴጥሮሴ፥ ያቁበለከ ያቁብ አመቤቱ ጠለዕል ያህይ አዎንስ መቴ ቆተ አል ፉሎ።<note caller="-" style="x"><char style="xo" closed="false">17፥1-5 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2 ጴጥ. 1፥17-18</ref>።</char></note> <verse eid="MAT 17:1"/><verse number="2" style="v" sid="MAT 17:2"/>ኢስ ደኑንኩ ብሬሰ ዶረሞ፤ ሚንስን አርገ ኑር እኮኡ፤ ኦድኑስን ዋቅይት ዋጀእ ኑርገ በለቆኡ። <verse eid="MAT 17:2"/><verse number="3" style="v" sid="MAT 17:3"/>ህከኔን ሙሲለከ እልያስ ኢሲን ጠወአን ለኦኡ። <verse eid="MAT 17:3"/><verse number="4" style="v" sid="MAT 17:4"/>ህከ ወክት ጴጥሮስ ኢሰ «ቀርቾ! ከንቤቾን ሄኡ ኔሳሃ ጡመሃን፤ ሀሶንት ጎሬ ሰሱ ዳሰ ዳሳም፤ መቱስ ኬሳሃ፥ መቱስ ሙሲሃ መቱስ እልያሴሃ» ዬእ።<verse eid="MAT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5"/>ጴጥሮስ ህካን ጠወአንን በለቃ ጎመት ቴልቶስ፤ ህከን ጎመ ኣዜን «እሲን ተሽ የኖኤ ኢታም ቤቱኤ ከኒት፤ እሱ ሞጮጭዬ» ይታ ላገት አሜቶኡ።<note caller="-" style="x"><char style="xo" closed="false">17፥5 </char><char style="xt" closed="false"><ref loc="GEN 22:2">ክል. 22፥2</ref>፤ <ref loc="DEU 18:15">ዘዳ. 18፥15</ref>፤ <ref loc="PSA 2:7">መዝ. 2፥7</ref>፤ <ref loc="ISA 42:1">ኢሳ. 42፥1</ref>፤ <ref loc="MAT 3:17">ማቶ. 3፥17</ref>፤ <ref loc="MAT 12:8">12፥8</ref>፤ <ref loc="MRK 1:11">ማር. 1፥11</ref>፤ <ref loc="LUK 3:22">ሉቃ. 3፥22</ref>።</char></note><verse eid="MAT 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6"/>አሳበስ ህከ ላገተ ሞጮጭቶ ወክት አበ ዋጅት ኡለ ኡቦኡ። <verse eid="MAT 17:6"/><verse number="7" style="v" sid="MAT 17:7"/>እኮጎሬ ኢስ እሰበ አሜች አንጋንከስ አፍ «ኬዕዬ፤ ዋጅቶኖቼ» ዬሰ። <verse eid="MAT 17:7"/><verse number="8" style="v" sid="MAT 17:8"/>እሰን ኬእ ለኣ ወክት ኢስ ቤሉ ዎሉ አዬሃ ለኦበአ።<verse eid="MAT 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9"/>እሰን ቆታች ድርተን ኢስ «መንች ቤቱ ሬሆች ኬአኖ ኢለ ከ ለኤንታሃ አዬሃ ኩልቶኖቼ» ይ አዘዦሰ።<verse eid="MAT 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10"/>አሳበስ «ህከረ ሚሃ ሕግ አስተማረት ‹ሄጭ እልያስ አሜቱ ሀስሰኖስ› ይታኢት?» ይተን ኢሰ ጠዕምቶስ።<note caller="-" style="x"><char style="xo" closed="false">17፥10 </char><char style="xt" closed="false"><ref loc="MAL 4:5">ሚል. 4፥5</ref>።</char></note><verse eid="MAT 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11"/>ህትን ኢስ «እልያስዕኑ ሄጭ አሜች ጉዕመርቹንከ ቅጥአአኖ። <verse eid="MAT 17:11"/><verse number="12" style="v" sid="MAT 17:12"/>አን ኩላንክህዕኔ፤ እልያስ ሄጭ አሜቾኡ፤ እኮጎሬ መኑ እሱ ነብዬቹ አዕይ ቶጎስበአ፤ ህካን እኮቤቺሃ እሱሃ ሀሶገ አቶስ፤ ህትን መንች ቤቱ እሳች ኦሪሸተ ቶገኖ» ይ ፈንቀሼእ።<note caller="-" style="x"><char style="xo" closed="false">17፥12 </char><char style="xt" closed="false"><ref loc="MAT 11:14">ማቶ. 11፥14</ref>።</char></note><verse eid="MAT 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13"/>ህከ ወክት አሳበስ ኢስ ጠወዕዮሁ ጠመቃንቾ ያህይተኔሃ እሁስ አጥራመቶኡ።<verse eid="MAT 17:13"/></para>
  <para style="s1">ኢስ ዱሩ አፎስ ጩል ፈይሱስ</para>
  <para style="r">(<ref loc="MRK 9:14-29">ማር. 9፥14-29</ref>፤ <ref loc="LUK 9:37-43">ሉቃ. 9፥37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14"/>እሰን ኡመት ቤቹ አሜቶ ወክት መቱ መንቹ ኢስበ አሜች ብሬስ ጉሉጵ <verse eid="MAT 17:14"/><verse number="15" style="v" sid="MAT 17:15"/>«ቀርቾ! ጮት ዱሩ አፍ ልግብ ወክት ጊራንለከ ዋን ኡጀንስ አበ ኦርሰኖስቤቺሃ ቤቱኤ መረርስጭስ። <verse eid="MAT 17:15"/><verse number="16" style="v" sid="MAT 17:16"/>አሳበክቤቹ ኤቦም ወክት ፈይሶተ አታልቶበአ» ዬእ። <verse eid="MAT 17:16"/><verse number="17" style="v" sid="MAT 17:17"/>ኢስን «አዕኑ ኩ አመዕንቴንቡለከ ሾኩ ከን ዘማን መኑ! ሀከ በር ኢለ ክዕኔን ሄኣም? ሀከ በር ኢለ ክዕኔተ አታላም? ህንዴ ጩልስ ከበ ኤቤ» ዬሰ። <verse eid="MAT 17:17"/><verse number="18" style="v" sid="MAT 17:18"/>ኢስን ዱር ሻቃን ህከን ጩሊች ፉሎ፤ ጩሉንኩ ህከ ወክት ፈዬእ።<verse eid="MAT 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19"/>ህከኒች ኤተሮን አሳበት ኢስበ አደደ እክ አሜት «ነኡ ካን ፉሽኖተ አታልንባሁ ሚሃት?» ይት ጠዕምቶኡ። <verse eid="MAT 17:19"/><verse number="20" style="v" sid="MAT 17:20"/>ኢስ «አመዕነቱ ሆፈዕዮህዕኔቤቺሃት፤ ሀንቅንከ ያንክዕኔ፤ ዎንጌ እሌ ጌሱ አመዕነቱ ሄዕዮህዕኔ እቃን ከ ቆተተ ‹ከንቤቺች ኬእ ካጰ ኦሮእ› ይቴንተጎሬ ኦሮታአ፤ ዎልቅሰኖህዕኔርቹ መቱርቹሁ ሄአኖበአ።<note caller="-" style="x"><char style="xo" closed="false">17፥20 </char><char style="xt" closed="false"><ref loc="MAT 21:21">ማቶ. 21፥21</ref>፤ <ref loc="MRK 11:23">ማር. 11፥23</ref>፤ <ref loc="1CO 13:2">1 ቆሮ. 13፥2</ref>።</char></note> <verse eid="MAT 17:20"/><verse number="21" style="v" sid="MAT 17:21"/>[እኮጎሬ ህትኔ ዱሩ ዱኢንለከ ሶመኒን እህባች ሆሮ ፉለኖበአ»]<note caller="+" style="f"><char style="ft" closed="false">መት-መቱ ሉህ ክታበት ዎሊንሽ 21 ዮኢሃ በርግታበአ፤ ላገንትስ ማር. 9፥29 ዮኢሃ አጉደኖ።</char></note><verse eid="MAT 17:21"/></para>
  <para style="s1">ኢስ ሬሁስለከ ኬኡስ ለንኪሃ ጠወዕዮገ</para>
  <para style="r">(<ref loc="MRK 9:30-32">ማር. 9፥30-32</ref>፤ <ref loc="LUK 9:43-45">ሉቃ. 9፥43-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22"/>አሳባስ ገሊላን ሄኦሀኔን ኢስ «መንች ቤቱ መን አንጋን ህግሴን ኣሴኖ፤ <verse eid="MAT 17:22"/><verse number="23" style="v" sid="MAT 17:23"/>እሰን ሽታስ፤ እኮጎሬ እስ ሰቅ በር ሬሆች ኬአኖ» ዬሰ፤ ህካን እኮቤቺሃ እሰ አበ ሻዞኡ።<verse eid="MAT 17:23"/></para>
  <para style="s1">መገን ምኒሃ ግብረ ባትተኔሃ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24"/>ኢስለከ አሳበስ ቅፍርናሆም ከተመ ኢልቶ ወክት ዱእ ምኒ ግብረ ጭምአታ መኑ ጴጥሮሴቤቹ አሜት «አስተማርቹክዕኔ መገን ምኒ ግብረ ባተኖበእንዶ?» ይት ጠዕምቶኡ።<note caller="-" style="x"><char style="xo" closed="false">17፥24 </char><char style="xt" closed="false"><ref loc="EXO 30:13">ፉል. 30፥13</ref>፤ <ref loc="EXO 38:26">38፥26</ref>።</char></note> <verse eid="MAT 17:24"/><verse number="25" style="v" sid="MAT 17:25"/>ጴጥሮስ «ኤ ባተኖ» ይ ምኒ ኣጎ ወክት ኢስ ሄጭ «ስሞኔ! ኬሳሃ መ አጉደኖሄት? ከን ኣዱንያ አል መንግስታከት ቀረጠለከ ግብር ቶጋኢሁ እላችሳትንዶ ዎሎ መኒቺት?» ይ ጠዕሜእ። <verse eid="MAT 17:25"/><verse number="26" style="v" sid="MAT 17:26"/>ጴጥሮስን «ዎሎ መኒቺት» ዬእ፤ ኢስ «ህከረ ኦሱሰ ግብር ባትበረንዶ? <verse eid="MAT 17:26"/><verse number="27" style="v" sid="MAT 17:27"/>እኮጎሬ እሰ ቆዕልታበእገ ባር አሌን ዎሻደ ኡጅት ሄጭት ፉልቶ ቁርጩሜተ አፍ አፎሴ ፈንቶንት ወክት ባታንት ጌሰ ብረ ደጋንት፤ ህካን መስት ኢለ ኪ ወጥ ባት» ዬእ።<verse eid="MAT 17:27"/></para>
  <chapter eid="MAT 17"/>
  <chapter number="18" style="c" sid="MAT 18"/>
  <para style="s1">ጉዕሚችን በተአኖሁ አዬት?</para>
  <para style="r">(<ref loc="MRK 9:33-37">ማር. 9፥33-37</ref>፤ <ref loc="LUK 9:46-48">ሉቃ. 9፥46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1"/>ህከ ወክት አሳበት ኢስበ አሜት «ሰሜ ዎምነቴን ጉዕሚችን በተአኖሁ አዬት?» ይት ጠዕምቶኡ።<note caller="-" style="x"><char style="xo" closed="false">18፥1 </char><char style="xt" closed="false"><ref loc="LUK 22:24">ሉቃ. 22፥24</ref>።</char></note> <verse eid="MAT 18:1"/><verse number="2" style="v" sid="MAT 18:2"/>ህካን እኮቤቺሃ ኢስ መቱ ጩል ገእ በላንከሰ ኡርሽ <verse eid="MAT 18:2"/><verse number="3" style="v" sid="MAT 18:3"/>«አን ሀንቅንከ ያንክዕኔ፤ ሰዊቱክዕኔ ጡመ እህባችለከ ኦሶገ እኬንባች ሰሜ ዎምነቱ ሆሮ ኣጌነንተበአ።<note caller="-" style="x"><char style="xo" closed="false">18፥3 </char><char style="xt" closed="false"><ref loc="MRK 10:15">ማር. 10፥15</ref>፤ <ref loc="LUK 18:17">ሉቃ. 18፥17</ref>።</char></note> <verse eid="MAT 18:3"/><verse number="4" style="v" sid="MAT 18:4"/>ሰሜ ዎምነቴን ሎሩ ከን ጩልገ ገዉስ ሆፍሰኖሃን። <verse eid="MAT 18:4"/><verse number="5" style="v" sid="MAT 18:5"/>ከን ጩልገ ዮኢሃ ኢ ሱዕሚን ቶገኖሁ አዪሁ ኤሳሃ ቶገኖ።<verse eid="MAT 18:5"/></para>
  <para style="s1">መነ ቆዕለኖገ አኢች አገዕሩ</para>
  <para style="r">(<ref loc="MRK 9:42-48">ማር. 9፥42-48</ref>፤ <ref loc="LUK 17:1-2">ሉቃ. 17፥1-2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6"/>«ኢን አመዕንቶ ከን ማዕናኖች መቱስ ሉሲሰኖ መንቹ ሎረ ሪትም ክኑ ጎበስ ኡሱሬን ጥዕላሸ ባራን ቶረም ኣአሞእቀ ቆሀኖስ» ዬእ። <verse eid="MAT 18:6"/><verse number="7" style="v" sid="MAT 18:7"/>ኢስ «ሉሲሰኖርቹ አሜተኖቤቺሃ ከን ኣዱንያ አል መኒሃ ኣዬ! መሰንትስ ሉሲሰኖርቹ አሜቱዕነ ሆሮ ፈቀኖበአ፤ ሉሲሰኖርቹ እስ መሳን አሜተኖ መንቺሃ ኣዬ! <verse eid="MAT 18:7"/><verse number="8" style="v" sid="MAT 18:8"/>ህካን እኮቤቺሃ አንገክ ህከረንገ ሎከክ ሉሲሳሄትጎሬ ሙርት ኡጅ፤ መሰንትስ ለምተ አንገት ህከረንገ ለምተ ሎከት ሄኣንኬ ዘላለሚሃ ሆሮ ጠእትበ ጊራን ኣጋንትሀኒች ድኑለከ አንገተ ሙረሞሃ እክ ሄእቤቹ ኣጉ ቆሀኖሄ።<note caller="-" style="x"><char style="xo" closed="false">18፥8 </char><char style="xt" closed="false"><ref loc="MAT 5:30">ማቶ. 5፥30</ref>።</char></note> <verse eid="MAT 18:8"/><verse number="9" style="v" sid="MAT 18:9"/>ህትን እልክ ሉሲሳሄትጎሬ ፉሽት ቶር፤ መሰንትስ ለሜ እሌን ሄእ አዛብ ጊራን ኣጋንትሀኒች መትእልቹ እክ ሄእቤቹ ኣጉ ቆሀኖሄ።<note caller="-" style="x"><char style="xo" closed="false">18፥9 </char><char style="xt" closed="false"><ref loc="MAT 5:29">ማቶ. 5፥29</ref>።</char></note> <verse eid="MAT 18:9"/><verse number="10" style="v" sid="MAT 18:10"/>ከን ማዕናኖች መቱስ ህንቄነንተበእገ አገዕርዬ፤ አን ኩላንክዕኔ፤ ሰማን ዮ እሰ መላይከት ጉዕመ ወክት ሰማን ዮ አንኤ ብሬን ለልታአ። [ <verse eid="MAT 18:10"/><verse number="11" style="v" sid="MAT 18:11"/>መሰንትስ መንች ቤቱንኩ አሜቾሁ በዕዮሃ ጡምሲሃት»]<note caller="+" style="f"><char style="ft" closed="false">መት-መቱ ሉህ ክታበት ዎሊንሽ 11 ዮኢሃ በርግታበአ፤ ላገንትስ ሉቃ. 10 ዮኢሃ አጉደኖ።</char></note><note caller="-" style="x"><char style="xo" closed="false">18፥11 </char><char style="xt" closed="false"><ref loc="LUK 19:10">ሉቃ. 19፥10</ref>።</char></note><verse eid="MAT 18:11"/></para>
  <para style="s1">በዕይ ደገሞ ሆልች ምሳልተ</para>
  <para style="r">(<ref loc="LUK 15:3-7">ሉቃ. 15፥3-7</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12"/>ኢስ «ህንዴ መ አጉደኖህዕኔ፤ መቶ መንቺሃ ጥቤ ሆለት ዮስሀኒች መትሴ በኦስጎሬ ሆንሳይኔ ሆንሱንከ ቆተ አሌን አጉር በዕዮሲሃ ሀሶተ ኦሮአኖበእንዶ? <verse eid="MAT 18:12"/><verse number="13" style="v" sid="MAT 18:13"/>ሀንቅንከ ያንክዕኔ፤ ሀሽ ደጎ ወክት በኡዕነ ፈቆ ሆንሳይኔ ሆንሶ ሆላች በትሽ በዕያን ደጎ ሆልቺሃ ሙንደአኖ። <verse eid="MAT 18:13"/><verse number="14" style="v" sid="MAT 18:14"/>ህትን ሰማን ዮ አኑክዕኔ ከን ማዕናኖች መቱስ በኦተ ኢተኖበአ» ዬእ።<verse eid="MAT 18:14"/></para>
  <para style="s1">ቤሾ መንቺሃ መ አኡ ሀስሰኖ ጎሬ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15"/>ኢስ «አመክቤቱ ቤሾሄ ጎሬ መርት ቤሱስ ገዪንከስን ኩል፤ እስን ቤሱስ አመዕኔሄጎሬ አመክቤቱ አቶንትስ ዩሃን።<note caller="-" style="x"><char style="xo" closed="false">18፥15 </char><char style="xt" closed="false"><ref loc="LUK 17:3">ሉቃ. 17፥3</ref>።</char></note> <verse eid="MAT 18:15"/><verse number="16" style="v" sid="MAT 18:16"/>ሞጮጩ ግቦሄጎሬ ጠዉ ጉዕሙንኩ ለሞ ህከረንገ ሰሶ ምስክር ላጋን ዊመኖቤቺሃ መቱ ህከረንገ ለሙ መንቹ አፍ እስቤቹ መር።<note caller="-" style="x"><char style="xo" closed="false">18፥16 </char><char style="xt" closed="false"><ref loc="DEU 19:15">ዘዳ. 19፥15</ref>።</char></note> <verse eid="MAT 18:16"/><verse number="17" style="v" sid="MAT 18:17"/>እሰ ይታኢሃ ሞጮጩ ግበኖረ ዱእ ምኒ መኒሃ ኩል፤ ዱእ ምኒ መኒሃ ሞጮጩ ግበኖረ መገኑ አመዕንበ መንችገለከ ሰጭ ፈንቀልበ ጩበኝገ ዎለእ።<verse eid="MAT 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18"/>«ሀንቅንከ ያንክዕኔ፤ ኡለ ኡሱርቴንታሁ ሰማን ኡሱረሞሃ እሀኖ፤ ኡላን ሂርቴንታሁ ሰማኒ ሂረሞሃ እሀኖ።<note caller="-" style="x"><char style="xo" closed="false">18፥18 </char><char style="xt" closed="false"><ref loc="MAT 16:19">ማቶ. 16፥19</ref>፤ <ref loc="JHN 20:23">ያህ. 20፥23</ref>።</char></note> <verse eid="MAT 18:18"/><verse number="19" style="v" sid="MAT 18:19"/>ህትን አን በርግ ኩላንክዕኔ፤ ክዕኔ በሊች ለሙ መንቹ መ ጠወሃ ኢተቀንት ዱአ አቶጎሬ ሰማን ዮ አኑኤ ህከ ጠወ አአኖሰ። <verse eid="MAT 18:19"/><verse number="20" style="v" sid="MAT 18:20"/>መሰንትስ ለሙ ህከረንገ ሰሱ መንቹ ሱዕሚንከኤ ጭምይቶቤቾን አን በላንከሰ እሃምቤቺሃት» ዬእ።<verse eid="MAT 18:20"/></para>
  <para style="s1">አጉርተኔሃ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21"/>ህከኒች ኤተሮን ጴጥሮስ ኢስቤቹ ሆንጠክ «ቀርቾ! አመኤቤቱ በደሎኤጎሬ ሜኡ ወክት አጉሩስ? ለመለ ወክት አጉሩስንዶ?» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">18፥21-22 </char><char style="xt" closed="false"><ref loc="LUK 17:3-4">ሉቃ. 17፥3-4</ref>።</char></note><verse eid="MAT 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22"/>ኢስን «ለመላዩ ወክት ለመላ ቤሉ ጠለዕል ለመለ ወክት ያንኬበአ» ዬስ።<note caller="-" style="x"><char style="xo" closed="false">18፥22 </char><char style="xt" closed="false"><ref loc="GEN 4:24">ክል. 4፥24</ref>።</char></note><verse eid="MAT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23"/>ህካን እኮቤቺሃ «ኢስ ሰሜ ዎምነቱ ካዲማንከስ ሜጡበ ሆጎተስ ሀስሰኖ ህሳበ አማዕለመኖ ዎመ አጉዳአ። <verse eid="MAT 18:23"/><verse number="24" style="v" sid="MAT 18:24"/>እስን ስሌት አኡ ጀመርቶ ወክት ቶኖ ኩሜ መክሊት<note caller="+" style="f"><char style="fqa" closed="false">መክሊተ፦ </char><char style="ft" closed="false">መቱ መክሊቱ ህከ ወክት ቶነ ኦንቶ ዘማን በሬ ሆጉተ አአኖ መንቺሃ ባተመኖ ደሞዝችስ በተአኖሃን እቅ።</char></note> ኤዶሁ ዮስ መቱ ካዲንቹ አፍ እስበ ኤቦኡ። <verse eid="MAT 18:24"/><verse number="25" style="v" sid="MAT 18:25"/>ሁኩ ካዲንቹ ኤዳስ ባቱ ሆጎቤቺሃ ገዉሲ፥ መንቹስለከ እለስ ዮስርቹ ጉዕመንከ ህሬን ኤዳስ ባተመኖገ ቀርቹስ አዘዦ። <verse eid="MAT 18:25"/><verse number="26" style="v" sid="MAT 18:26"/>ህካን እኮቤቺሃ ካዲንቹስ ቀርችስ ሎካን ኡብ ‹ኢ ቀርቾ! ሀዕይ ቀዉ ጌሰ አገሬኤ፤ ጉዕመንከስ ባታም› ይ ኡጬስ። <verse eid="MAT 18:26"/><verse number="27" style="v" sid="MAT 18:27"/>ቀርቹንኩስ አሙዦስቤቺሃ ገፈሮስ፤ ኤዳስ ጉዕመንከ አጉሮስ።<verse eid="MAT 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28"/>«ጠዉ እኮጎሬ ሁኩ ካዲንቹ ህከንቤቺች ፉል ኦሮአን ጥቤ ዲናረ ሌቄሾ ሆጎስ ጃለ ደግ ‹ሌቄሾንኬሃ ባቴኤ› ይ ቆኤስ ለንግ አፎ። <verse eid="MAT 18:28"/><verse number="29" style="v" sid="MAT 18:29"/>ጃሉንኩስ ሎከስ አሌን ኡብ ‹ሀዕይ ቀዉ ጌሰ አገሬኤ፤ ባታንኬ› ይ ኡጬስ። <verse eid="MAT 18:29"/><verse number="30" style="v" sid="MAT 18:30"/>እኮጎሬ መንቹስ ግብ ኤዳስ ባቶተ ኢለ ኡሱርሲሾስ። <verse eid="MAT 18:30"/><verse number="31" style="v" sid="MAT 18:31"/>ሆጎስ ጃለት ህካን ለኦ ወክት አበ ሻዝ እኮ ጠወ ጉዕመንከ ቀርቺሃንሰ መርት ኩልቶኡ። <verse eid="MAT 18:31"/><verse number="32" style="v" sid="MAT 18:32"/>ቀርቹንኩ ህከ ካዲንቹ ገእሲሽ ‹ኩ ሂሉ ካዲንቹ፤ ኡጭቶንቴኤረ ህከ ኤዳክ ጉዕመንከ አጉርበሄንዶ? <verse eid="MAT 18:32"/><verse number="33" style="v" sid="MAT 18:33"/>አን አሙዦኬገን አቲሁ ጃልሀክ አሙዛንትስበእንዶ?› ይ <verse eid="MAT 18:33"/><verse number="34" style="v" sid="MAT 18:34"/>ቀርቹስ ኡሙዕር ኤዳስ ጉዕመንከ ባች ሹሎተ ኢለ ኡሱር ምኒ ሀለቅቺሃ ህግሽ ኣሴእ።<verse eid="MAT 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35"/>«ህትን አዕኑሁ አመክዕኔቤት ብድል ቀልቢን ሹልቴን አጉርቴንበጎሬ ሰማን ዮ አኑኤ ህትን አአኖህዕኔ ዬሰ።»<verse eid="MAT 18:35"/></para>
  <chapter eid="MAT 18"/>
  <chapter number="19" style="c" sid="MAT 19"/>
  <para style="s1">ሜንቱ ገፈርተኔሃ ኢሰ ጠዕሜመገ</para>
  <para style="r">(<ref loc="MRK 10:1-2">ማር. 10፥1-2</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1"/>ኢስ ህከ ጠወ ጠወዕይ ሹሎች ኤተሮን ገሊላች ኬዕይ ዮርዳኖስ ዛዘኖ ዊ ዉድ አዲን ሄዕዮ ይሁድ ባዱ ኦሮዕዮ። <verse eid="MAT 19:1"/><verse number="2" style="v" sid="MAT 19:2"/>ልግቡ ኡመቱ አዎኞስ፤ እስን ህከኔ ፈይሾሰ።<verse eid="MAT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3"/>ህከ ወክት ፈርሳውት ኢስበ አሜት ሉሲሶተ «መቱ መንቹ ጫስ እኮስ መሳን ሸሩ ፈቀደመኖስንዶ?» ይት ጠዕምቶኡ።<verse eid="MAT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4"/>እስን ፈንቀሽ «ካልቁሰ ዎዕናንከ ‹ሜኣተለከ ለባሃ አዕይ ከለቆሰ› የመሞሃ አነበቤንታበእንዶ?<note caller="-" style="x"><char style="xo" closed="false">19፥4 </char><char style="xt" closed="false"><ref loc="GEN 1:27">ክል. 1፥27</ref>፤ <ref loc="GEN 5:2">5፥2</ref>።</char></note> <verse eid="MAT 19:4"/><verse number="5" style="v" sid="MAT 19:5"/>ህትን ‹መንቹ አነስለከ አመስ አጉር ጫንከስ ሜጡ እሀኖ፤ ለሙንኩ መቱ ጅስመ› እካአ።<note caller="-" style="x"><char style="xo" closed="false">19፥5 </char><char style="xt" closed="false"><ref loc="GEN 2:24">ክል. 2፥24</ref>።</char></note> <verse eid="MAT 19:5"/><verse number="6" style="v" sid="MAT 19:6"/>ህካን እኮቤቺሃ እሰ ከኒች ኤተሮን መቶሃ ጅስመ ቤሉ ለሞሃበአ፤ መገኑ ሜጡ አዕይ በርጌኢሃ መኑ አደ አኡንከ» ዬሰ።<verse eid="MAT 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7"/>እሰን «ህከረ ሙስ ሚሃት ምኒ አኑ መንቾተስ ንከሴ ሂር ገፈሮተ አዘዦ?» ይት ጠዕምቶስ።<note caller="-" style="x"><char style="xo" closed="false">19፥7 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">ዘዳ. 24፥1-4</ref>፤ <ref loc="MAT 5:31">ማቶ. 5፥31</ref>።</char></note><verse eid="MAT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8"/>ኢስ «ሙስዕኑ ሜንቱክዕኔ ገፈርቶኖተ ፈቀጆሁ ቀልቡክዕኔ ዱጆቤቺሃት፤ እኮጎሬ ዎዕናሃ ህትጎተበአ።<verse eid="MAT 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 19:9"/>«አን ያንክዕኔ፤ ዝነተ አቱዕነ ጫስ ገፈር ዎልተ ጫተ ኣአኖሁ ጉዕሙንኩ ዝነተ አአኖሃን» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">19፥9 </char><char style="xt" closed="false"><ref loc="MAT 5:32">ማቶ. 5፥32</ref>፤ <ref loc="1CO 7:10-11">1 ቆሮ. 7፥10-11</ref>።</char></note><verse eid="MAT 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10"/>አሳበስ «ለቤለከ ሜኣ ደኑ ካን እኮች ኣኡ ሆጉ ቆሀኖ» ይቶስ።<verse eid="MAT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11"/>ጠዉ እኮጎሬ ኢስ «ኣሰሞሰሀኑኡ ቤሉ ኩ ጠዉ ጉዕመ መኒሃ አታልሲስበሃን። <verse eid="MAT 19:11"/><verse number="12" style="v" sid="MAT 19:12"/>መሰንትስ እለንተንን ለቤነቱ ዮሰበእሩ ዮኡ፤ ህትን መኑ ቃሮሰሩ ዮኡ፤ ህትን ሰሜ ዎምነቲሃ ይት ምኒሃ እሁ ግቦእሩ ዮኡ፤ ህካን ቶጎተ አታለኖሁ ዮ ጎሬ ቶጉን» ዬሰ።<verse eid="MAT 19:12"/></para>
  <para style="s1">ኢስ ኦሱተ ማሰዕዮገ</para>
  <para style="r">(<ref loc="MRK 10:13-16">ማር. 10፥13-16</ref>፤ <ref loc="LUK 18:15-17">ሉቃ. 18፥15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13"/>ህከ ወክት አንገስ አሌሰ አዕይ ዱአ አኦተ መኑ ኦሱተ ኢስቤቹ ኤቦኡ፤ አሳበስ ኤቦ መነ ኡሙዕርቶሰ። <verse eid="MAT 19:13"/><verse number="14" style="v" sid="MAT 19:14"/>እኮጎሬ ኢስ «ሰሜ ዎምነቱ ከኑኡገ ዮሀኑኡተ እኮቤቺሃ አጉሬሰ፤ ኦሱት ኢቤቹ አሜቶተ ከንቶኖቼሰ» ይ <verse eid="MAT 19:14"/><verse number="15" style="v" sid="MAT 19:15"/>አንገስ አሌሰ አዕዮች ኤተሮን ዎሉ አደ ኦሮዕዮ።<verse eid="MAT 19:15"/></para>
  <para style="s1">ኣዱንያ ቀባጡተለከ ሰሜ ዎምነትተኔሃ</para>
  <para style="r">(<ref loc="MRK 10:17-31">ማር. 10፥17-31</ref>፤ <ref loc="LUK 18:18-30">ሉቃ. 18፥18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16"/>መቱ በር መቱ መንቹ ኢስበ አሜች «አስተማርቾ! ዘላለሚሃ ሄአኖ ሄኡ ደኦተ መ ጡመ ጠወሃ አኡ?» ዬእ።<verse eid="MAT 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17"/>ኢስን «ጡመ ጠውተኔሃ ሚሃ ጠዕምታንቴኤት? ጡሙ ሜጥቾሃ መገኑ፤ ሄእቤቹ ኣጎተ ሀሶንት ጎሬ ትዛዝ አገር» ዬእ።<verse eid="MAT 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18"/>መንቹንኩ «ሀከ ትዛዝዪት?» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">19፥18 </char><char style="xt" closed="false"><ref loc="EXO 20:13-16">ፉል. 20፥13-16</ref>፤ <ref loc="DEU 5:17-20">ዘዳ. 5፥17-20</ref>።</char></note></para>
  <para style="p" vid="MAT 19:18">ኢስን «ሽቶት፥ ዝነተ አቶት፥ ሞግቶት፥ ጩብ መሰከርቶት፤ <verse eid="MAT 19:18"/><verse number="19" style="v" sid="MAT 19:19"/>አነክለከ አመክ ኬዕምስ፤ ዎሉ መነ ገይክገ አት ኢት» ዬስ።<note caller="-" style="x"><char style="xo" closed="false">19፥19 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ፉል. 20፥12</ref>፤ <ref loc="DEU 5:16">ዘዳ. 5፥16</ref>፤ <ref loc="LEV 19:18">ሌዌ 19፥18</ref>።</char></note> <verse eid="MAT 19:19"/><verse number="20" style="v" sid="MAT 19:20"/>እስን ኢሰ «ከ ትዛዝ ጉዕመንከ አዕዮም፤ ዎሉ ፈቆኤሁ መርቹሃን?» ዬእ።<verse eid="MAT 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21"/>ኢስን «ዊመ እኮተ ሀሶንት ጎሬ መርት ዮሄ ዱንያተ ጉዕመንከ ህርት ቡጥቺሃ ኣስ፤ ሰማን ዱንያት ሄኣሄ፤ ህከኒች ኤተሮን አሜት አዎኔኤ» ዬስ።<verse eid="MAT 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22"/>ሁኩ ዎደልቹ ህካን ሞጮጬ ወክት አቡ ዱንያት ዮስቤቺሃ ሻዘን ኦሮዕዮ።<verse eid="MAT 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23"/>ህከኒች ኤተሮን ኢስ አሳበስ «ሀንቅንከ ያንክዕኔ፤ ቀባጣሞ መንቺሃ ሰሜ ዎምነቱ ኣጉ አበ ኦርሰኖሃን። <verse eid="MAT 19:23"/><verse number="24" style="v" sid="MAT 19:24"/>ለንኪሃ ያንክዕኔ፤ ቀባጣሙ መንቹ መገን ዎምነቱ ኣገኖሀኒች ጋሜሉ መርፌ ጠላዕላን ሕጉ ቆሀኖ» ዬሰ።<verse eid="MAT 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25"/>አሳበስ ህካን ሞጮጭቶ ወክት አበ አጀብሲጭት «ህከረ አይ ጡሞተ አታለኖ?» ይቶኡ።<verse eid="MAT 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26"/>ጠዉ እኮጎሬ ኢስ እሰተ ለአን «ኩ ጠዉ መኒሃ አታለምበሃን፤ እኮጎሬ መገኒሃ ጉዕሙርቹንኩ አታለመኖስ» ዬሰ።<verse eid="MAT 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27"/>ህከ ወክት ጴጥሮስ ፈንቀሽ «ሁኩዕኑን ነኡ ጉዕመርቹንከ አጉርን አዎኖንኬ፤ ህከረ ደእናሚሁ መርቹሃን» ዬእ።<verse eid="MAT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28"/>ኢስን «ሀንቅንከ ያንክዕኔ፤ አዕኑ ኤሳሃ አዎንቴንተሩ መንች ቤቱ ጉዕሙርቹንኩ ሃዕሮ እሀኖ ዘማኔን ኬዕምኝ ቦርጭማን አፉዕለኖ ወክት አዕኑ ቶነ ለሞ ቦርጭማን አፉዕልቴን ቶነ ለሞሃንከ እስራኤል ደቦ አሌን ፈረዴነንተ።<note caller="-" style="x"><char style="xo" closed="false">19፥28 </char><char style="xt" closed="false"><ref loc="MAT 25:31">ማቶ. 25፥31</ref>፤ <ref loc="LUK 22:30">ሉቃ. 22፥30</ref>።</char></note> <verse eid="MAT 19:28"/><verse number="29" style="v" sid="MAT 19:29"/>ህትን ኢ ሱዕምተኔሃ ምነተ ህከረንገ አመስ ኦሱተ ህከረንገ አነ ህከረንገ አመተ ህከረንገ እለስ ህከረንገ ኡለስ አጉሮሁ ጉዕሙንኩ ጥቤ አፎሃ ኣአኖ፤ ህትን ዘላለሚሃ ሄአኖ ሄኡ ደአኖ። <verse eid="MAT 19:29"/><verse number="30" style="v" sid="MAT 19:30"/>ጠዉ እኮጎሬ ልግቡ ብርት ሄኦእሩ ኤተራኑተ ኤተራኑንት ብርተ ሄኦእረ እካአ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">19፥30 </char><char style="xt" closed="false"><ref loc="MAT 20:16">ማቶ. 20፥16</ref>፤ <ref loc="LUK 13:30">ሉቃ. 13፥30</ref>።</char></note><verse eid="MAT 19:30"/></para>
  <chapter eid="MAT 19"/>
  <chapter number="20" style="c" sid="MAT 20"/>
  <para style="s1">ጡመ ሆጉተ አሲሰኖ መንች ምሳልተ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1"/>ኢስ «ሰሜ ዎምነቱ ዎይነስ አስሲሶተ ሆጉተ አታ መነ ቀጠሮተ ገስመ ሱጵተ ፉሎ ኡለ አነ አጉዳኖ። <verse eid="MAT 20:1"/><verse number="2" style="v" sid="MAT 20:2"/>ኢስን መት-መትሀሰ በሬን መት-መቱ ዲናረ ባቶተ ኢተቀም ሆጉተ አታ መነ ዎይነ መክሴኖ ላልች ኣዝ ሶኮ። <verse eid="MAT 20:2"/><verse number="3" style="v" sid="MAT 20:3"/>ኡለስ አኑንኩ ሰሶ ሰኣት ጌሳን ፉል ሆጉተ ሆግ በነቻን ኡርቶ ዎሉ መነ ለዕዮ። <verse eid="MAT 20:3"/><verse number="4" style="v" sid="MAT 20:4"/>እሳንከ ‹አዕኑ ዎይን ላልች ኣዝ መርቴን ሆጉተ አዕዬ፤ ሀስሰኖ ጌሰ ባታንክዕኔ› ዬሰ። <verse eid="MAT 20:4"/><verse number="5" style="v" sid="MAT 20:5"/>እሰን ዎይን ላልች ቤቹ መርቶኡ፤ ህትን ሌሆ ሰኣትለከ ሆንሶ ሰኣት ጌሳን ፉል ህትን አዕዮ። <verse eid="MAT 20:5"/><verse number="6" style="v" sid="MAT 20:6"/>ህትን ቶነ መቶ ሰኣት ጌሳን ፉል ዎሉ ኡርቶ መነሃ ደግ ‹ከኔ ዊመ በር ሆጉት ዮበኢሃ ኡርቴን ሚሃ ሆሴንታአ?› ዬሰ። <verse eid="MAT 20:6"/><verse number="7" style="v" sid="MAT 20:7"/>እሰን ‹ቀጠረኖ መንቹ ሆንጊት› ይቶስ፤ እስን ‹አዕኑ ዎይን ላልች ኣዝ መርቴን ሆጉተ አዕዬ› ዬሰ።<verse eid="MAT 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8"/>«ኡለት ሀዎርቶ ወክት ዎይን ላልች አኑ ሆጎስ ሀላፌቹ ‹ሆጉተ አታእረ ገእት መጨረሻን ቀጠረንቶሀኑኡች ኬስ ዎዕናሃ ቀጠረንቶእረ ኢለ ሆጉተ አቶ ዲናረ ባት› ዬስ።<note caller="-" style="x"><char style="xo" closed="false">20፥8 </char><char style="xt" closed="false"><ref loc="LEV 19:13">ሌዌ 19፥13</ref>፤ <ref loc="DEU 24:15">ዘዳ. 24፥15</ref>።</char></note> <verse eid="MAT 20:8"/><verse number="9" style="v" sid="MAT 20:9"/>ህከ ወክት ቶነ መቶ ሳኣቴን ቀጠረንቶእሩ ሆንጠክ መት-መቱሰ መት-መቱ ዲናረ ኣእቶኡ። <verse eid="MAT 20:9"/><verse number="10" style="v" sid="MAT 20:10"/>ህትን ዎዕና ቀጠረንቶእሩ ሆንጠኮ ወክት በትስ ኣእታኢሃ አጉጆሰ እቅ፤ ጠዉ እኮጎሬ እሳ መት-መቱ ዲናረ ኣእቶኡ። <verse eid="MAT 20:10"/><verse number="11-12" style="v" sid="MAT 20:11-12"/>እሰ ዲናረ ኣእተን ‹ኩ ኒች ኤተሮን ቀጠረንቶእሩ ሆጉተ አቶኢሁ መቶሃ ሰኣት፤ ዊመ በረ አሮን ቡንብ አዕነን ሆንሶም ኒን ቅጡ ባቶንት› ይት ኡለስ አኒን ቁንቁንቶኡ። <verse eid="MAT 20:11-12"/><verse number="13" style="v" sid="MAT 20:13"/>ኡለስ አኑንኩ ህከን ሆጉተ አታ መኒች መቱስ ‹ኢ ጃለ አን መቱርቹሃ ቤሾምበአ፤ አት ኢን መቶ በሬተ መቱ ዲናረ ባቶሄተ ኢተቀሞምበእንዶ? <verse eid="MAT 20:13"/><verse number="14" style="v" sid="MAT 20:14"/>ህካን እኮቤቺሃ ወጥክ ኣኢት ኦሮእ፤ አን ኬሳሃ ኣሴምሀንገን መጨረሻን አሜቾ መኒቺሃ ኣሶተ ኢትዮም። <verse eid="MAT 20:14"/><verse number="15" style="v" sid="MAT 20:15"/>ገይኤሃ ኢቴምገ አኦተ አታላምበእንዶ? ህከረንገ አን ጡመ እኮምቤቺሃ ምቀኝቶንትንዶ?› » ይ ፈንቀሼእ።<verse eid="MAT 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16"/>ህካን እኮቤቺሃ ኢስ «ኤተሩ ሄኦእሩ ብርተ እካአ ህትን ብርተ ሄኦእሩ ኤተሩ እካአ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">20፥16 </char><char style="xt" closed="false"><ref loc="MAT 19:30">ማቶ. 19፥30</ref>፤ <ref loc="MRK 10:31">ማር. 10፥31</ref>፤ <ref loc="LUK 13:30">ሉቃ. 13፥30</ref>።</char></note><verse eid="MAT 20:16"/></para>
  <para style="s1">ኢስ ሬሆስተኔሃ ሰቅ ወክት ጠወኡስ</para>
  <para style="r">(<ref loc="MRK 10:32-34">ማር. 10፥32-34</ref>፤ <ref loc="LUK 18:31-34">ሉቃ. 18፥31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17"/>ህከኒች ኤተሮን ኢስ ዬሩሳሌም ከተመ አሌ ዋል ኦሮአን ቶነ ለሙንኩ አሳበተ አደ አዕይ እስበ መስ <verse eid="MAT 20:17"/><verse number="18" style="v" sid="MAT 20:18"/>«ሁኩዕኑን ነኡ ዬሩሳሌመ መርናሚት፤ ህከኔን መንች ቤቱ ቂስ አዎናኖተለከ ሕግ አስተማራታ ህግሴን ኣሴናን እሰን አሌስ ሬሆ ፍርደ ፈረዳአ። <verse eid="MAT 20:18"/><verse number="19" style="v" sid="MAT 20:19"/>ህትን እሰ ቀለደንስለከ አበ ገረፈንስ ሰቀልቶተ አይሁደ እኮበእ መኒሃ ኣታስ፤ ህትን ሰቅ በር ሬሆች ኬአኖ» ዬሰ።<verse eid="MAT 20:19"/></para>
  <para style="s1">ዜብዶሴ ኦሶ አመ ኡጨቱተ</para>
  <para style="r">(<ref loc="MRK 10:35-45">ማር. 10፥35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20"/>ዜብዶሴ ኦሶ አመት ኦሱሴ ኣእት ኢስበ አሜት ብሬስ ጉሉጵት መቱ ጠወ አኦተ ኡጭቶኡ። <verse eid="MAT 20:20"/><verse number="21" style="v" sid="MAT 20:21"/>ኢስን «መ ሀሶንት?» ዬሴ፤ እሴን «ዎምነቴንከክ ለሜ እላችኤ መቱሰ መኬ አዲን መቱሰ ጉረ አዲን አፉዕልታገ አእ» ይቶስ።<verse eid="MAT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22"/>ጠዉ እኮጎሬ ኢስ «ኡጭቴነንታሃ ደጌነንተበአ፤ አን ግደኖ በሬን አጋም ኦርሸ ጠበቴሃ አጎኖተ አታልቴነንንዶ?» ዬእ፤ እሰን «ኤ አታልናም» ይቶስ።<verse eid="MAT 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23"/>ኢስን «ኦርሻኤ ጠበትተ አጎኖተ አታልቴነንተ፤ ጠዉ እኮጎሬ ጉረኤ አዲንለከ መኬኤ አዲን አኣሚሁ አኔበአ፤ ሁኩ ቤቹ ኣሰመኖሁ አኑኤ ቅጥአዕዮ መኒሃት» ዬእ።<verse eid="MAT 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24"/>ፈቆ ቶኑንኩ አሳበት ህከ ጠወ ሞጮጭቶ ወክት ለሞንከ አመኦሶ አሌን ኡሙዕርቶኡ። <verse eid="MAT 20:24"/><verse number="25" style="v" sid="MAT 20:25"/>እኮጎሬ ኢስ ጉዕመንከሰ እስበ ገእ «ኣዱንያ አል መን ሀለቀት መነሰ ገሽታእራን፤ አዎንሳኑሰን እሰ አሌን ሹምነቱ ዮሰገ ደጌነንተ። <verse eid="MAT 20:25"/><verse number="26" style="v" sid="MAT 20:26"/>ክዕኔ በላን ህት እሁንከ፤ ጠዉ እኮጎሬ አዪሁ ክዕኔ በሊች ሎረ እሆተ ኢተኖሁ ሄዕዮ ጎሬ ክዕኔ ካድንቹ እሁን።<note caller="-" style="x"><char style="xo" closed="false">20፥26 </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">ሉቃ. 22፥25-26</ref>።</char></note> <verse eid="MAT 20:26"/><verse number="27" style="v" sid="MAT 20:27"/>ህትን አዪሁ ክዕኔ በሊች ጉዕሚችን ሎረ እሆተ ኢተኖሁ ሄዕዮ ጎሬ ክዕኔ ካድንቹ እሁን።<note caller="-" style="x"><char style="xo" closed="false">20፥27 </char><char style="xt" closed="false"><ref loc="MAT 23:11">ማቶ. 23፥11</ref>፤ <ref loc="MRK 9:35">ማር. 9፥35</ref>፤ <ref loc="LUK 22:26">ሉቃ. 22፥26</ref>።</char></note> <verse eid="MAT 20:27"/><verse number="28" style="v" sid="MAT 20:28"/>ህትን መንች ቤቱ ፎልስ ልግብ መኒሃ ዎዝኑተ አዕይ ኣሶተ አሜቾ ቤሉ ካደሞኖስተ አሜቾበአ» ዬሰ።<verse eid="MAT 20:28"/></para>
  <para style="s1">ለሙ ቆቀ መነ ኢስ ፈይሱስ</para>
  <para style="r">(<ref loc="MRK 10:46-52">ማር. 10፥46-52</ref>፤ <ref loc="LUK 18:35-43">ሉቃ. 18፥35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29"/>ህከኒች ኤተሮን ኢስለከ አሳበስ ኢያርኮ ከተሚች ፉልት መርተን ልግቡ ኡመቱ አዎኞሰ። <verse eid="MAT 20:29"/><verse number="30" style="v" sid="MAT 20:30"/>ዎቄ ገበላን አፉዕልቶ ለሙ ቆቁ መኑ ኢስ ህከን አዲን ህገን ሞጮጭቶ ወክት ላገሰ ጎት አት «ቀርቾ ዳዉዴ ቤቶ! መረርሲጭኔ» ይተን ያርቶኡ።<verse eid="MAT 20:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31"/>ሁኩ ኡመቱ «ጨለ ይዬ» ይት ሻቆሰ፤ ጠዉ እኮጎሬ እሰን ዎዕኔች በትስ «ቀርቾ ዳዉዴ ቤቶ! ሀዕይ አሙዝኔ» ይት አበ ያርቶኡ።<verse eid="MAT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32"/>ኢስን ኡር እስበ ገእ «መ አኦህዕኔተ ሀሴነን?» ዬሰ።<verse eid="MAT 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33"/>እሰን «ቀርቾ! እልኔ ፈንተኣገ አእኔ» ይቶስ።<verse eid="MAT 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34"/>ኢስን አሙዥ እልሰ አንጋን አፎ ወክት አጀብሲሰኖ ሃሊን እልሰ ፈንተኣን አዎንቶስ።<verse eid="MAT 20:34"/></para>
  <chapter eid="MAT 20"/>
  <chapter number="21" style="c" sid="MAT 21"/>
  <para style="s1">ኢስ ኬዕምኝን ዬሩሳሌም ከተመ ኣጉስ</para>
  <para style="r">(<ref loc="MRK 11:1-11">ማር. 11፥1-11</ref>፤ <ref loc="LUK 19:28-40">ሉቃ. 19፥28-40</ref>፤ <ref loc="JHN 12:12-19">ያህ. 12፥12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1"/>ኢስለከ አሳበስ ዬሩሳሌም ከተመ ሆንጠኮ ወክት ዘይት ሀቁ ነጰኖ ቆተ አሌን ዮ «ቤተ ፋጌ» ዬኖ ቀእተ ኢልቶኡ፤ ህከ ወክት ኢስ አሳባችስ ለሙ <verse eid="MAT 21:1"/><verse number="2" style="v" sid="MAT 21:2"/>«ብሬክዕኔ ዮ ቀእተ መሬ፤ ህከኔን መት ሀሩቹተ ዎተሪንከሴን ኡሱሬማሃ ደጌነንተ፤ እሰንተ ሂርቴን ኤቤ። <verse eid="MAT 21:2"/><verse number="3" style="v" sid="MAT 21:3"/>አዪሁ መቱርቹ ዬህዕኔጎሬ ‹ቀርቹ ሀሾቤቺሃት› ይዬ፤ እስን ወክትንከስ ሶሀኖ» ይ ሶኮ። <verse eid="MAT 21:3"/><verse number="4" style="v" sid="MAT 21:4"/>ሁኩን እኮሁ ነብዬቾን<verse eid="MAT 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5"/>«ጽዮን ቤቶ<note caller="+" style="f"><char style="fqa" closed="false">ጽዮን ቤቶ የመሞሁ፦ </char><char style="ft" closed="false">ሴነፉ እሀን ፍሳረስ ዬሩሳሌም መነ ዩሃን።</char></note></para>
  <para style="q2" vid="MAT 21:5">‹ሁኩዕኑን! ዎሙክ ገዉስ ሆፍሽ ሀሩቾንለከ</para>
  <para style="q2" vid="MAT 21:5">ሀሩቾ ዎተራን ቆጵ ኪቤቹ አሜተኖ!› ይቴን ኩሌሰ» የመም ጠወአሞሁ ዊሞታት።<note caller="-" style="x"><char style="xo" closed="false">21፥5 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">ዘካ. 9፥9</ref>።</char></note><verse eid="MAT 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6"/>አሳበንት መርት ኢስ ዬሰገን አቶኡ። <verse eid="MAT 21:6"/><verse number="7" style="v" sid="MAT 21:7"/>እሰን ሀሩቹተ ዎተሪንከሴን ኤብ ኦድኑሰ ሀሩቾ ጉጆን አታን ኢስ ቆጶ። <verse eid="MAT 21:7"/><verse number="8" style="v" sid="MAT 21:8"/>ህከን መኒች ልግቡሰ ኦድኑሰ ዎቃን ዌሶኡ፤ ዎሉሰንገ ሀቅ ሀበረ ተንቅሰን ዎቃን ዌሳኢት እቅ። <verse eid="MAT 21:8"/><verse number="9" style="v" sid="MAT 21:9"/>ልግቡ መኑ ብሬ አዲንለከ ኤተር አዲን ላገሰ ጎት አት «ሆሳና!<note caller="+" style="f"><char style="fqa" closed="false">ሆሳና፦ </char><char style="ft" closed="false">ዩ ዕብራይስጥ አፌን ጡሙ ዩሃን፥ አት ጡምስኔ ዩሃን።</char></note> ጡምሳንቺሃኔ ደዉዴ ቤቲሃ፤ ቀርች ሱዕሚን አሜተኖሁ ማሰአሞእሃን፤ ሆሳና! አሌ ሰማን» ይታኢት እቅ።<note caller="-" style="x"><char style="xo" closed="false">21፥9 </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">መዝ. 118፥25-26</ref>።</char></note> <verse eid="MAT 21:9"/><verse number="10" style="v" sid="MAT 21:10"/>ኢስ ዬሩሳሌም ከተመ ኣጎ ወክት «ኩን አዬት?» ይተን ከተም መኑ ጉዕሙንኩ ረበሾኡ። <verse eid="MAT 21:10"/><verse number="11" style="v" sid="MAT 21:11"/>ሁኩ ኡመቱ «ኩን ገሊለ ባዶን ዮ ናዝሬት ከተሚች አሜቾሃ ነብዬቾ ኢሳት» ይቶኡ።<verse eid="MAT 21:11"/></para>
  <para style="s1">ኢስ ዱአ አኤኖ ምናን ጌባ አታእረ ሸሩስ</para>
  <para style="r">(<ref loc="MRK 11:15-19">ማር. 11፥15-19</ref>፤ <ref loc="LUK 19:45-48">ሉቃ. 19፥45-48</ref>፤ <ref loc="JHN 2:13-22">ያህ. 2፥13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12"/>ኢስ ዱእ ምኒ ኣግ ዱእ ምኒ ኣዜን ህርታእረለከ ህዕርታእራ ሸር ፉሼእ፤ ብረ ዶርታ ጠረጴዘተለከ ሀንደዕርተ ህርታ መን ቦርጭመተ ኮሎንኮዕልሾ። <verse eid="MAT 21:12"/><verse number="13" style="v" sid="MAT 21:13"/>እስን « ‹ምኑኤ ዱአ አኤኖ ምኒ ዬን ገኤኖ› የመም ከተበሞኡ፤ እኮጎሬ አዕኑ ሽፍጡ አፉዕለኖ ሻንቀ አቴንተ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">21፥13 </char><char style="xt" closed="false"><ref loc="ISA 56:7">ኢሳ. 56፥7</ref>፤ <ref loc="JER 7:11">ኤር. 7፥11</ref>።</char></note><verse eid="MAT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14"/>ኢስ መገን ምኔን ዮሀኔን ቆቃኑትለከ ድናኑት እስበ አሜታን ፈይሾሰ። <verse eid="MAT 21:14"/><verse number="15" style="v" sid="MAT 21:15"/>ጠዉ እኮጎሬ ቂስ አዎንሳኑትለከ ሕግ አስተማረት ኢስ አዕዮ አጀብሲሰኖ ጠወ መገን ምኔን «ሆሳና! ደዉዴ ቤቲሃ» ይተን ጨንጭቶቤቺሃ ኡሙዕርቶኡ። <verse eid="MAT 21:15"/><verse number="16" style="v" sid="MAT 21:16"/>እሰን «ኩ ኦሱት ይታኢሃ ሞጮጭታንቲትንዶ?» ይቶስ፤ ኢስን «ኤ! ‹ኦሶችለከ ቀንታሀኑኡ አፌች ገለት ቅጥ አቶንት› ይታ ላገተ ሆሮ አነበቤንታበእንዶ?» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">21፥16 </char><char style="xt" closed="false"><ref loc="PSA 8:2">መዝ. 8፥2</ref>።</char></note> <verse eid="MAT 21:16"/><verse number="17" style="v" sid="MAT 21:17"/>ኢስን እሳች አደ እክ ዬሩሳሌም ከተሚች ፉል «ቢታነ» ዬኖ ቀእተ ኦሮዕይ ህከኔ ገሎ።<verse eid="MAT 21:17"/></para>
  <para style="s1">ኢስ ቦሮሮ ኦድ ሀቁቹተ</para>
  <para style="r">(<ref loc="MRK 11:12-14:20">ማር. 11፥12—14፥20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18"/>ኢስ ለንክ በር ገስመ ሱጵተ ዬሩሳሌም ከተመ ፈንቀል ኦሮአን ጎሩ አፎስ። <verse eid="MAT 21:18"/><verse number="19" style="v" sid="MAT 21:19"/>እስን ዎቄ ገበላን ዮ መት ኦድ ሀቁቹተ ለዕይ እሴቤቹ ኦሮዕዮ፤ እኮጎሬ ሀበር ቤሉ መቱ ላልቹሃ ደጎሴበአ፤ ህከ ኦድ ሀቁቹተ «ለንኪሃ ኬሳሃ ሆሮ ላልቹ ሄኡንከሄ» ዬሴ፤ ኦድ ሀቁቹንት ህከ ወክት ሞልቶኡ። <verse eid="MAT 21:19"/><verse number="20" style="v" sid="MAT 21:20"/>አሳበስ ህካን ለኦ ወክት አጀብሲጭት «ሀት ት ኦድ ሀቁቹት ሜጦረን ሞልቶኡ?» ይቶኡ። <verse eid="MAT 21:20"/><verse number="21" style="v" sid="MAT 21:21"/>ኢስን ፈንቀሽ «ሀንቅንከ ያንክዕኔ፤ አመዕነቱ ሄዕዮህዕኔጎሬ፥ ሸክቴንበረ ከን ኦድ ሀቁቾን እኮ ጠወ ጠለዕል አቴነንተበአ፤ ጠዉ እኮጎሬ ተ ቆተተ ‹ከንቤቺች ቡቱከንት ባራን ኡብ› ይቴንተጎሬ እሀኖህዕኔ።<note caller="-" style="x"><char style="xo" closed="false">21፥21 </char><char style="xt" closed="false"><ref loc="MAT 17:20">ማቶ. 17፥20</ref>፤ <ref loc="1CO 13:2">1 ቆሮ. 13፥2</ref>።</char></note> <verse eid="MAT 21:21"/><verse number="22" style="v" sid="MAT 21:22"/>አመዕነቱ ሄዕዮህዕኔጎሬ ኡጭቴነንተርቹ ጉዕመንከ ደእቴነንተ» ዬሰ።<verse eid="MAT 21:22"/></para>
  <para style="s1">ኢስ መ ሹምነቲን አአኖት ጎሬ ጠዕሜመገ</para>
  <para style="r">(<ref loc="MRK 11:27-33">ማር. 11፥27-33</ref>፤ <ref loc="LUK 20:1-8">ሉቃ. 20፥1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23"/>ኢስ ዱእ ምኒ ኣግ ተማርሰን ቂስ አዎንሳኑትለከ ባድ ባልቀት እስበ አሜት «ከ ጠወ ጉዕመንከ አታንቲሁ መ ዎልቃኔት? ህትን ከ ዎልቃተ ኣሴሄሁ አዬት?» ይቶስ። <verse eid="MAT 21:23"/><verse number="24" style="v" sid="MAT 21:24"/>ኢስን ፈንቀሽ «መቱርቹ ጠዕማንክዕኔ፤ አዕኑ ህካን ፈንቀሽቴንተጎሬ አኒሁ ካን መ ዎልቃን አኣሚት ጎሬ ኩላንክዕኔ። <verse eid="MAT 21:24"/><verse number="25" style="v" sid="MAT 21:25"/>ያህይ ጥምቀቱ ሀከን አዲች አሜቾ? መገን አዲችትንዶ መን አዲችት?» ዬሰ፤ ገገዉንኩሰን « ‹መገኒችት› ይኖምጎሬ ‹ህከረ ሚሃ ያህዪን አመዕንቴንታበአ?› የኖኔ። <verse eid="MAT 21:25"/><verse number="26" style="v" sid="MAT 21:26"/>ጠዉ እኮጎሬ ‹መኒችት› ይኖምጎሬ መኑ ጉዕሙንኩ ያህይ ‹ነብዬቹወ› ይ አመዕኔቤቺሃ መነ ዋጅኖም» የቀንቶኡ። <verse eid="MAT 21:26"/><verse number="27" style="v" sid="MAT 21:27"/>ህካን እኮቤቺሃ እሰን ኢሲሃ «ደንጋምበአ» ይት ፈንቀሽቶኡ፤ ኢስን «አኒሁ ካን ጉዕመንከ መ ዎልቃን አኣምትጎሬ ኩላንክዕኔበአ» ዬሰ።<verse eid="MAT 21:27"/></para>
  <para style="s1">ለሜ ኦሶ ምሳልተ</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28"/>ኢስ «መ አጉደኖህዕኔት? መቶ መንቺሃ ለምተ ኦሱት ሄኦስ እቅ፤ እስን መትስቤቹ ሆንጠክ ‹ከበር ዎይን ኣዝ መርት ሆጉተ አእ› ዬእ። <verse eid="MAT 21:28"/><verse number="29" style="v" sid="MAT 21:29"/>ቤቱንኩስ ‹መራምበአ› ይ ፈንቀሼእ፤ እኮጎሬ ኤተሮን ሸጭ ሆጉተ አኦተ መሮ። <verse eid="MAT 21:29"/><verse number="30" style="v" sid="MAT 21:30"/>ህትን ለምቅስ ቤት ቤቹ መር ዎዕኔሀንገን ዬስረ ‹ኤኩ ኢ አነ መራም› ዬእ፤ ጠዉ እኮጎሬ መሩዕነ ፈቆ። <verse eid="MAT 21:30"/><verse number="31" style="v" sid="MAT 21:31"/>ህከን ለሜ ኦሶች አኒሀስ አዘዘሞሁ ሀከኒት?» ዬእ፤ እሰን «ዎኔስየ» ይቶኡ፤ ኢስን «ሀንቅንከ ያንክዕኔ፤ ቀረጠ ሙርታእሩለከ ዝነተ አታእሩ ክዕኔተ ሄጭት መገን ዎምነቱ ኣጋአ። <verse eid="MAT 21:31"/><verse number="32" style="v" sid="MAT 21:32"/>መሰንትስ ያህይ መገኒን ሄኤኖ ዎቃሃ ለሊሶህዕኔተ አሜቾ ጎሬ አመዕንቴንታስበአ፤ ጠዉ እኮጎሬ ቀረጠ ሙርታሩለከ ዝነተ አታእሩ አመዕንቶስ፤ አዕኑ ኤተሮን ህካን ለኤኒ ቶበቴን አመዕንቴንታስበአ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">21፥32 </char><char style="xt" closed="false"><ref loc="LUK 3:12">ሉቃ. 3፥12</ref>፤ <ref loc="LUK 7:29-30">7፥29-30</ref>።</char></note><verse eid="MAT 21:32"/></para>
  <para style="s1">ዎይን ላልች ሆጉተ አታ መን ምሳልተ</para>
  <para style="r">(<ref loc="MRK 12:1-12">ማር. 12፥1-12</ref>፤ <ref loc="LUK 20:9-19">ሉቃ. 20፥9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33"/>ኢስ «ዎልት ምሳልተ ሞጮጭዬ፤ ኡላንከስ ዎይን ላልቹ ዮስ መቱ መንቹ ሄዕዮ እቅ፤ እስን ዎይነስ ኦች ላልቹስ ጩንሼኖ ኡለተ እም አገርታ መኒሃ ሀንሸሩ እጃር ቀባኖተ ኣስ ዎሉ ባዱ ኦሮዕዮ።<note caller="-" style="x"><char style="xo" closed="false">21፥33 </char><char style="xt" closed="false"><ref loc="ISA 5:1-2">ኢሳ. 5፥1-2</ref>።</char></note> <verse eid="MAT 21:33"/><verse number="34" style="v" sid="MAT 21:34"/>ዎይኑስ ላለኖ ወክቱ እካን ላልቺችስ ኤቦተ ካዲመስ ቀባኖቤቹ ሶኮ። <verse eid="MAT 21:34"/><verse number="35" style="v" sid="MAT 21:35"/>ሁኩ ቀባኑት ካዲማች መቱስ ኦልቶኡ፤ መቱንገ ሽቶኡ፤ ዎሉስንገ ክኒን ቀሶኡ። <verse eid="MAT 21:35"/><verse number="36" style="v" sid="MAT 21:36"/>ለንኪሃ ኡለስ አኑ ዎኔሀኑኡች በተኣ ካዲመተ ሶኮረ ሁኩ ቀባኑት ዎኔረ አቶገን አቶኡ። <verse eid="MAT 21:36"/><verse number="37" style="v" sid="MAT 21:37"/>ህከኒች ኤተሮን ‹ቤቱኤ ከበጅታስ› ይ ቤቱስ ሶኮ። <verse eid="MAT 21:37"/><verse number="38" style="v" sid="MAT 21:38"/>ጠዉ እኮጎሬ ሁኩ ቀባኑት ቤቱስ ለኦ ወክት መት-መትሀሰ ‹ረገአኖሁ ከኒት፤ አሜ እሱ ሽን ዮስርቹ ጉዕመንከ ረገዕናም› የቀንቶኡ። <verse eid="MAT 21:38"/><verse number="39" style="v" sid="MAT 21:39"/>እሰን እሱ አፍ ዎይን ኣዚች አብል ፉሽት ሽቶኡ።<verse eid="MAT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40"/>«ኡለስ አኑ አሜቾ ወክት ህከ ቀባኑተ መ አአኖሰ?» ዬሰ። <verse eid="MAT 21:40"/><verse number="41" style="v" sid="MAT 21:41"/>እሰን «ህከ ሂለ መነ ሂለገ አዕይ ሽ ዎይን ላልቹ ወክቲን አታ ዎሎ ቀባኖተ ኣሰኖ» ይቶስ።<verse eid="MAT 21:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42"/>ኢስን</para>
  <para style="q2" vid="MAT 21:42">« ‹ግንበኛኑት ህንቆ ክኑ</para>
  <para style="q2" vid="MAT 21:42">እስ ሙረበ ቡዕል ክኑ እኮ፤</para>
  <para style="q2" vid="MAT 21:42">ሁኩንን ቀርችተ ሆጉ፤ እሌን ለኢሃ አጀብሲሰኖሃን› የመም መጻፋን ከተበሞሃ ሆሮ አነበቤንታበእንዶ?<note caller="-" style="x"><char style="xo" closed="false">21፥42 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">መዝ. 118፥22-23</ref>።</char></note><verse eid="MAT 21:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43"/>«ህካን እኮቤቺሃ አን ኩላንክዕኔ፤ መገን ዎምነቱ ክዕኔች ከሜን ላልቹ ላለኖ ኡመቲሃ ኣሴኖ። <verse eid="MAT 21:43"/><verse number="44" style="v" sid="MAT 21:44"/>[ህከን ክን አሌን ኡበኖሁ ቁሽቁሽ የኖ፤ ሁኩ ክኑ አዬ አሌኒ ኡቦጎሬ ፍጭርቀኖስ» ዬሰ።]<note caller="+" style="f"><char style="ft" closed="false">መት-መቱ ሉህ ክታበት ዎሊንሽ 44 በርግታበአ፤ ላገንትስ ሉቃ. 20፥18 ዮኢሃ አጉደኖ።</char></note><verse eid="MAT 21:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45"/>ቂስ አዎንሳኑትለከ ፈርሳውት ኢስ ጠወዕዮ ምሳልተ ሞጮጭቶ ወክት እሰተኔሃ ጠወኡስ አጥራመቶኡ። <verse eid="MAT 21:45"/><verse number="46" style="v" sid="MAT 21:46"/>ህካን እኮቤቺሃ እሰ አፎስተ ሀሶኡ፤ ጠዉ እኮጎሬ ኡመቱ ኢሰ ነብዬችገ ለአኖስቤቺሃ መነ ዋጅቶኡ።<verse eid="MAT 21:46"/></para>
  <chapter eid="MAT 21"/>
  <chapter number="22" style="c" sid="MAT 22"/>
  <para style="s1">ቦለች ድግስ ምሳሌተኔሃ</para>
  <para style="r">(<ref loc="LUK 14:15-24">ሉቃ. 14፥15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1"/>ኢስን ለንኪሃ ምሳሌን <verse eid="MAT 22:1"/><verse number="2" style="v" sid="MAT 22:2"/>«ሰሜ ዎምነቱ ቤቲሀስ ቦለች ድግሰ ቅጥአዕዮ ዎመ አጉደኖ። <verse eid="MAT 22:2"/><verse number="3" style="v" sid="MAT 22:3"/>ዎሙንኩ ቦለቺሃ ገኤመ መነ ገእቶተ ካዲመስ ሶኮ፤ ጠዉ እኮጎሬ ገኤመ መኑ አሜቱ ግቦኡ።<verse eid="MAT 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4"/>«ለንኪሃ ዎሙንኩ ዎልት ካዲመስ ‹ሁኩዕኑን ድግሰኤ ቅጥ አዕዮም፤ ቦረኤለከ ምሶ ደርገጌተ ጎረጮም፤ ጉዕሙርቹንኩ ቅጥ ይዮኡ፤ ድግስቤቹ አሜ ይቴን ገኤመሀኑኡሃ ኩሌ› ይ ሶኮ። <verse eid="MAT 22:4"/><verse number="5" style="v" sid="MAT 22:5"/>እሰን ጠወስ ህንቅ መቱ አቡረ ቤቹ ዎሉስንገ ህትን ንግድቤቹ መርቶኡ። <verse eid="MAT 22:5"/><verse number="6" style="v" sid="MAT 22:6"/>ፈቆሩ ህትን ካዲመስ አፍ ዎቀርት ሽቶኡ። <verse eid="MAT 22:6"/><verse number="7" style="v" sid="MAT 22:7"/>ዎሙንኩ ኡሙዕር ዎታደረስ ሶክ ህከ ሽቶ መነ ሽሲሾ፤ ህከ ከተመንከ ቡሴእ። <verse eid="MAT 22:7"/><verse number="8" style="v" sid="MAT 22:8"/>ህከ ወክት ካዲማተስ ‹ድግሱኤ ቅጥ ይዮኡ፤ እኮጎሬ ገኤመ መኑ ድግሲሀስ ገበእበረ እኮኡ። <verse eid="MAT 22:8"/><verse number="9" style="v" sid="MAT 22:9"/>ህካን እኮቤቺሃ ዎቃሃ ፉልቴን ደጌንተ መነ ጉዕመንከ ድግሲሃ ገእዬ› ዬሰ። <verse eid="MAT 22:9"/><verse number="10" style="v" sid="MAT 22:10"/>ካዲመንትስ ጎዳነ ፉልት ደጎኢሃ ጉዕመንከ ሂለለከ ጡመ ጭምአታን ቦለች ምኒ መኑ ዊሞ።<verse eid="MAT 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11"/>«ዎሙ ህከ መነ ለኦተ ምኒ ኣጎ ወክት ቦለች ኦድኑተ ኦደእበ መንቹ ለዕይ <verse eid="MAT 22:11"/><verse number="12" style="v" sid="MAT 22:12"/>‹ኢ ጃለ! ቦለች ኦድኑተ ኦደኡዕነ ሀት ከበ ኣጎንት?› ዬስ፤ ሁኩ መንቹንኩ ጨለ ዬእ። <verse eid="MAT 22:12"/><verse number="13" style="v" sid="MAT 22:13"/>ህከኒች ኤተሮን ዎሙ ካዲማተስ ‹አንገስለከ ሎከስ ኡሱርቴን አብሌ ቱንሽቾን ኡጅዬ፤ ህከን ቤቾን ኦኡለከ የቡሩ ገዕሙ እሀኖ› ዬእ።<note caller="-" style="x"><char style="xo" closed="false">22፥13 </char><char style="xt" closed="false"><ref loc="MAT 8:12">ማቶ. 8፥12</ref>፤ <ref loc="MAT 25:30">25፥30</ref>፤ <ref loc="LUK 13:28">ሉቃ. 13፥28</ref>።</char></note> <verse eid="MAT 22:13"/><verse number="14" style="v" sid="MAT 22:14"/>መሰንትስ ገአንቶእሩ ልግብየ፤ እኮጎሬ መጠረንቶእሩ ቀዎሃን» ዬእ።<verse eid="MAT 22:14"/></para>
  <para style="s1">ግብር ባቲሃ ኢሰ ጠዕሜመገ</para>
  <para style="r">(<ref loc="MRK 12:13-17">ማር. 12፥13-17</ref>፤ <ref loc="LUK 20:20-26">ሉቃ. 20፥20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15"/>ህከኒች ኤተሮን ፈርሳውት መርት ኢሰ ጠወአኖ ጠዊን ሉሲሶተ አማዕለንቶኡ። <verse eid="MAT 22:15"/><verse number="16-17" style="v" sid="MAT 22:16-17"/>እሰን «አስተማርቾ! አት ሀንቀኘ እሁክለከ መገን ዎቃሃ ሀንቂን ተማርስታንቲሃ እሁክ ህትን መን እልተ ለእ ፈረድባሃ እሁክ ደንጋም፤ ህንዴ ኩልኔ መ አጉደኖሄት? ሮም ዎሚሃ ግብር ባቱ ፈቀደሞሃንዶ ፈቀደሞበእሃን?» ይቶተ አዎናኑሰለከ ሄሮድሴ አድ መነ ሶኮኡ። <verse eid="MAT 22:16-17"/><verse number="18" style="v" sid="MAT 22:18"/>ኢስን ሂልመሰ ደግ «አዕኑ ኩ መኑ ለኦህዕኔተ ይቴን አቴነንተሩ፤ ሚሃት ፌተንቴነንተኤሁ? <verse eid="MAT 22:18"/><verse number="19" style="v" sid="MAT 22:19"/>ህንዴ ግብር ባቴኖ ዲናረ ለልሼኤ» ዬሰ፤ እሰን መቱ ዲናረ ኤብ ኣቶስ። <verse eid="MAT 22:19"/><verse number="20" style="v" sid="MAT 22:20"/>ኢስን «ከን ዲናር አሌን ከተበሞሁለከ ፎቱስ አዬሃን?» ዬሰ። <verse eid="MAT 22:20"/><verse number="21" style="v" sid="MAT 22:21"/>እሰን «ሮም ዎምሃን!» ይቶኡ፤ ኢስን «ህካን እኮች ቄሳሬሃ ቄሳሬንከ መገኒሃ መገኒንከ ኣስዬ» ዬሰ። <verse eid="MAT 22:21"/><verse number="22" style="v" sid="MAT 22:22"/>እሰን ህካን ሞጮጭቶ ወክት አጀብሲጭት አጉርት መርቶኡ።<verse eid="MAT 22:22"/></para>
  <para style="s1">ሬሆች ኬእተኔሃ ኢሰ ጠዕሜመገ</para>
  <para style="r">(<ref loc="MRK 12:18-27">ማር. 12፥18-27</ref>፤ <ref loc="LUK 20:27-40">ሉቃ. 20፥27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23"/>ህከ በር «ሬዮ መኑ ኬአኖበአ» ይታ ሳዱቃውት ኢስበ አሜት<note caller="-" style="x"><char style="xo" closed="false">22፥23 </char><char style="xt" closed="false"><ref loc="ACT 23:8">ሶቀ. 23፥8</ref>።</char></note> <verse eid="MAT 22:23"/><verse number="24" style="v" sid="MAT 22:24"/>«አስተማርቾ! ሙስ ‹መቱ መንቹ እለተ እሉዕነ ሬዮ ጎሬ አመስቤቱ ጫስ ረገዕይ ሬዮ አመስቤቲሀስ እለተ እሉን› ዬእ።<note caller="-" style="x"><char style="xo" closed="false">22፥24 </char><char style="xt" closed="false"><ref loc="DEU 25:5">ዘዳ. 25፥5</ref>።</char></note> <verse eid="MAT 22:24"/><verse number="25" style="v" sid="MAT 22:25"/>ለመሉ አመኦሱት ኒ አዳን ሄኦ እቅ፤ ሀንገፉስ ጫተ ኤብ እለተ እሉዕነ ሬያን ማዕኑ አመስቤቱ ጫስ ረገዕዮ። <verse eid="MAT 22:25"/><verse number="26" style="v" sid="MAT 22:26"/>ህትን ለንክሁ፥ ሰቂሁ ለመልቂሃ ኢለ ረገእ እለተ እልቱዕነ ሬቶኡ። <verse eid="MAT 22:26"/><verse number="27" style="v" sid="MAT 22:27"/>ጉዕሚችሰን ኤተሮን ህት ጫቲ ሬቶኡ። <verse eid="MAT 22:27"/><verse number="28" style="v" sid="MAT 22:28"/>ጉዕሙንኩሰ ኣእቶሴቤቺሃ ሬሆች ኬኤኖ ወክት ህት ጫት ህከን ለመለ አመኦሶች ሀከንስ ጫተ እካአ?» ይት ጠዕምቶስ።<verse eid="MAT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29"/>ጠዉ እኮጎሬ ኢስ ፈንቀሽ «መጻፈለከ መገን ዎልቀተ ደጌነንተበእቤቺሃ ሉሴነንታት። <verse eid="MAT 22:29"/><verse number="30" style="v" sid="MAT 22:30"/>መሰንትስ ሬሆች ኬኤኖ ወክት እሰ ሰሜ መላይከገ እካ ቤሉ ኣእታበኢ፤ መእሲሰንታበኢ። <verse eid="MAT 22:30"/><verse number="31" style="v" sid="MAT 22:31"/>ሬሆች ኬእተኔሃ እኮጎሬ መገኑ ክዕኔኤሃ <verse eid="MAT 22:31"/><verse number="32" style="v" sid="MAT 22:32"/>‹አን እብራሂምሃ መገኑ፥ ኢሳቂሃ መገኑለከ ያቁብሃ መገኑ› ዬኢሃ አነበቤንታበእንዶ? እስ ሄኣ መኒሃ መገኑ ቤሉ ሬዮ መኒሃ መገኑበአ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">22፥32 </char><char style="xt" closed="false"><ref loc="EXO 3:6">ፉል. 3፥6</ref>።</char></note> <verse eid="MAT 22:32"/><verse number="33" style="v" sid="MAT 22:33"/>ሁኩ ኡመቱ ህካን ሞጮጭቶ ወክት ኢስ ትምርታን አበ አጀብሲጭቶኡ።<verse eid="MAT 22:33"/></para>
  <para style="s1">ጉዕሚችን በተአኖ ትዛዝ</para>
  <para style="r">(<ref loc="MRK 12:28-34">ማር. 12፥28-34</ref>፤ <ref loc="LUK 10:25-28">ሉቃ. 10፥25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34"/>ኢስ ሰዱቃውተ መስለ ከሞሰገ ፈርሳውት ሞጮጭቶ ወክት ሜጡበ እክ እስበ አሜቶኡ። <verse eid="MAT 22:34"/><verse number="35" style="v" sid="MAT 22:35"/>እሳችን መቱ ሕገ ደገኖ መንቹ ፌተኖስተ<note caller="-" style="x"><char style="xo" closed="false">22፥35-40 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">ሉቃ. 10፥25-28</ref>።</char></note> <verse eid="MAT 22:35"/><verse number="36" style="v" sid="MAT 22:36"/>«አስተማርቾ! ሕግ ኣዜን ዮ ትዛዚች ሀኩን በተአኖ?» ይ ጠዕሜስ። <verse eid="MAT 22:36"/><verse number="37" style="v" sid="MAT 22:37"/>ኢስን ፈንቀሽ «ቀርቹ መገኑክ ዊመ ቀልብንከኪ፥ ዊመ ነብሴንከክለከ ዊመ ሰውቲንከክ ኢት።<note caller="-" style="x"><char style="xo" closed="false">22፥37 </char><char style="xt" closed="false"><ref loc="DEU 6:5">ዘዳ. 6፥5</ref>።</char></note> <verse eid="MAT 22:37"/><verse number="38" style="v" sid="MAT 22:38"/>ኩን ጉዕሚችን በተአኖሃለከ ዎኔሃ ትዛዝ። <verse eid="MAT 22:38"/><verse number="39" style="v" sid="MAT 22:39"/>ህካን አጉደኖ ለንክ ትዛዙ ‹ዎሉ መነ ገይክገ ኢት› የኖሃን።<note caller="-" style="x"><char style="xo" closed="false">22፥39 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ሌዌ 19፥18</ref>።</char></note> <verse eid="MAT 22:39"/><verse number="40" style="v" sid="MAT 22:40"/>ሕጉለከ ነብያኑት ይቶኢሃ ኩ ለሙ ትዛዙ ሜጡበ አዕይ አፈኖ» ዬእ።<verse eid="MAT 22:40"/></para>
  <para style="s1">መሲህተኔሃ ሆንጠኮ ጠዕምቱተ</para>
  <para style="r">(<ref loc="MRK 12:35-37">ማር. 12፥35-37</ref>፤ <ref loc="LUK 20:41-44">ሉቃ. 20፥41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41"/>ፈርሳውት ሜጡበ እክ ጭምይቶ ወክት ኢስ <verse eid="MAT 22:41"/><verse number="42" style="v" sid="MAT 22:42"/>«መሲህተኔሃ መ ሰውይቴነን? እስ አዬሃ ቤቱ?» ይ ጠዕሜሰ፤ እሰን «ደዉዴየ ቤቱ» ይቶኡ። <verse eid="MAT 22:42"/><verse number="43" style="v" sid="MAT 22:43"/>እስን «ህካን እኮች ደዉድ ጠሊለ አያኒን እክ ሀት ‹ቀርቾ› ይ ገአኖስ?<verse eid="MAT 22:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44"/>« ‹ቀርቹ መገኑ ኢ ቀርቺሃ</para>
  <para style="q2" vid="MAT 22:44">ባለጋረክ ሎካችክ ዎሮ አዲን አኣሚሃ ኢለ</para>
  <para style="q2" vid="MAT 22:44">መኬኤ አዲን አፉዕል› ዬእ።<note caller="-" style="x"><char style="xo" closed="false">22፥44 </char><char style="xt" closed="false"><ref loc="PSA 110:1">መዝ. 110፥1</ref>።</char></note><verse eid="MAT 22:44"/></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45"/>ደዉድ ገዉንኩስ ‹ቀርቾ› ይ ገኤኢች ሀት እክ ቤቱስ እሆተ አታለኖ?» ዬሰ። <verse eid="MAT 22:45"/><verse number="46" style="v" sid="MAT 22:46"/>ህካን እኮቤቺሃ አዪሁ መት ላገታ ፈንቀሾተ አታሎበአ፤ ህከን በሬች ኬስ እሰ መቱርቹሃ ጠዕምቶተ መለልቶበአ።<verse eid="MAT 22:46"/></para>
  <chapter eid="MAT 22"/>
  <chapter number="23" style="c" sid="MAT 23"/>
  <para style="s1">ሕግ አስተማረተለከ ፈርሳዌ ሂልመተኔሃ</para>
  <para style="r">(<ref loc="MRK 12:38-39">ማር. 12፥38-39</ref>፤ <ref loc="LUK 11:43-46">ሉቃ. 11፥43-46</ref>፤ <ref loc="LUK 20:45-46">20፥45-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1"/>ህከኒች ኤተሮን ኢስ ኡመትሀለከ አሳባተስ <verse eid="MAT 23:1"/><verse number="2" style="v" sid="MAT 23:2"/>«ሕግ አስተማረትለከ ፈርሳውት ሙስ ቦርጭማን አፉዕልቶኡ። <verse eid="MAT 23:2"/><verse number="3" style="v" sid="MAT 23:3"/>ህካን እኮቤቺሃ እሰ አታኢሃ እሁዕነ ኩልታህዕኔሃ ጉዕመንከ አዕዬሁ፥ አገሬሁ፤ መሰንትስ እሰ ኩልታ ጠወ ሆጎን ሆሲሳበእራን። <verse eid="MAT 23:3"/><verse number="4" style="v" sid="MAT 23:4"/>እሰ አዪሁ አታልቡለከ ኬዕምተ እጅነተ ኡሱርት መን ጌነኖን እጅሲሳእራን፤ እኮጎሬ ገዉሰ ዙሩዕሜሰ ሰኖኒ ኡልቶተ ሀሳበእራን። <verse eid="MAT 23:4"/><verse number="5" style="v" sid="MAT 23:5"/>ሆጉተ አታኢሁ መኒሃ ለሊሶታት፤ መሰንትስ መገን ላጋች መት-መቱ ከተቤን ጎቤመ<note caller="+" style="f"><char style="fqa" closed="false">መገን ላጋች መት-መቱ ከተቤን ጎቤመ መጻፉ፦ </char><char style="ft" closed="false">አይሁድ ሃይማኖት አዎንሳኑት ለኦኖሰተ ይት ሚኔሰ፥ አንጋንከሰለከ ጌነኖሰ ዱአ አታ ወክት ኦደአ ኦድኖ ሰኖን ቅራርስት ኦደኣእሃን</char></note> ክታበ አልባሽት ሚኔሰ ኡሱርታኢሁ፥ አንገሰለከ ጌነኖንከሰ ኦደአ ኦድኖሰ ሰኑተ ቄራርስታአ።<note caller="-" style="x"><char style="xo" closed="false">23፥5 </char><char style="xt" closed="false"><ref loc="MAT 6:1">ማቶ. 6፥1</ref>፤ <ref loc="NUM 15:38">ዘኁ. 15፥38</ref>፤ <ref loc="DEU 6:8">ዘዳ. 6፥8</ref>።</char></note> <verse eid="MAT 23:5"/><verse number="6" style="v" sid="MAT 23:6"/>ድግስ ምናን ኬዕምኝ ቤቾን አፉዕሉለከ ጭምት ምናን ጡመ ቦርጭማን አፉዕሉ ኢትታአ። <verse eid="MAT 23:6"/><verse number="7" style="v" sid="MAT 23:7"/>ህትን በነቻን ጠብሲሶኖሰተለከ መኑ ‹አስተማርቾ!› ይ ገኦሰተ ኢትታአ። <verse eid="MAT 23:7"/><verse number="8" style="v" sid="MAT 23:8"/>ጠዉ እኮጎሬ ጠለዕል መቱ አስተማርቹ ዮህዕኔቤቺሃ፥ አዕኑ ጉዕሙንኩክዕኔ አመኦሱተ እኬንተቤቺሃ ‹አስተማርቾ!› የመንቴን ገአንቶኖቼ። <verse eid="MAT 23:8"/><verse number="9" style="v" sid="MAT 23:9"/>ህትን ሰማን ዮ አኑክዕኔ መጡ እኮቤቺሃ አዬሁ ከን ኣዱንያ አሌን ‹ኒ አነ!› ይቴን ገእቶኖቼ። <verse eid="MAT 23:9"/><verse number="10" style="v" sid="MAT 23:10"/>ህትን አዎንሳንቹክዕኔ ሜጡ መሲህ እኮቤቺሃ ‹አዎንሳንቹ!› የመንቴን ገአንቶኖቼ። <verse eid="MAT 23:10"/><verse number="11" style="v" sid="MAT 23:11"/>ክዕኔኤ በሊች ጉዕሚችን ሎሩስ ካዲንቹክዕኔ እሁን።<note caller="-" style="x"><char style="xo" closed="false">23፥11 </char><char style="xt" closed="false"><ref loc="MAT 20:26-27">ማቶ. 20፥26-27</ref>፤ <ref loc="MRK 9:35">ማር. 9፥35</ref>፤ <ref loc="MRK 10:43-44">10፥43-44</ref>፤ <ref loc="LUK 22:26">ሉቃ. 22፥26</ref>።</char></note> <verse eid="MAT 23:11"/><verse number="12" style="v" sid="MAT 23:12"/>ገዉስ ሎርሰኖሁ ሆፈአኖ፤ ህትን ገዉስ ሆፍሰኖሁ ሎዕረኖ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">23፥12 </char><char style="xt" closed="false"><ref loc="LUK 14:11">ሉቃ. 14፥11</ref>፤ <ref loc="LUK 18:14">18፥14</ref>።</char></note><verse eid="MAT 23:12"/></para>
  <para style="s1">ሕግ አስተማረተለከ ፈርሳውተ ዎቀሴመሰገ</para>
  <para style="r">(<ref loc="MRK 12:40">ማር. 12፥40</ref>፤ ሉቃ. 11፥39-42፤44፤52፤ <ref loc="LUK 20:47">20፥47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13"/>ኢስ «መኑ ሰሜ ዎምነቱ ኣገኖበእገ ጡፌን ከንቴነንተ ሕግ አስተማረተለከ ፈርሳዌሃ ክዕኔኤ ከን መኑ ለኦህዕኔተ ይቴን አቴነንተሀኑኡሃ ኣዬ! አዕኑ ገዉክዕኔ ኣጌነንተበአ፤ ኣጎተ ሀሳእሩ ኣጋበእገ ከንቴነንታት።<verse eid="MAT 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 23:14"/>[«ለኦዕኔ ይቴን ሆንጠህሴነንተ ቄራዕሩ ዱአ መሰተ አቴን ምንሰ አኑ ሬዮ ሜንቱ ዮሰርቹ ሹልቴነንተ አዕኑ ሕግ አስተማረትለከ ፈሪሳውያኑት ቆሀኖህዕኔ! ህካን እኮቤቺሃ ክዕኔሃ ባሱ ፍርዱ አሌክዕኔ አሜተኖ።]<note caller="+" style="f"><char style="ft" closed="false">መት-መቱ ሉህ ክታበት ዎሊንሽ 14 በርግታበአ፤ ላገንትስ ማር. 12፥40 ዮኢሃ አጉደኖ።</char></note><verse eid="MAT 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15"/>«አዕኑ ኩ መኑ ለኦህዕኔተ ይቴን አቴነንተ ሕግ አስተማረትለከ ፈርሳውት መቱ መንቹ ክዕኔኤ አመዕነቶን ፈንቀሽቶኖተ ባርለከ ኡለ አሌን ዘህቴነንተ፤ እስን ፈንቀሎ ወክት ክዕኔኤች ለሙ አፎሃ በተእ ዘላለሚሃ ጠእትቡ ጊራን ቅጠሞኢሃ አቴነንተቤቺሃ ክዕኔኤሃ ቆሀኖህዕኔ!<verse eid="MAT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16"/>«አዕኑ ቆቁ አዎንሳኑት! ‹መቱ መንቹ መገን ምኔን ጤሌዕሌጎሬ መቱርቹሃ ደግለለኖስበአ፤ እኮጎሬ መገን ምኔን ዮ ዎርቃን ጤሌዕሌጎሬ ጤሌዕልንከስ አፈመኖ› ይቴነንተቤቺሃ ክዕኔኤሃ ቆሀኖህዕኔ! <verse eid="MAT 23:16"/><verse number="17" style="v" sid="MAT 23:17"/>አዕኑ ኩ ቆቃኑትለከ ገዋኑት! ዎርቀስ ጠሊለ አአኖ መገን ምኑንዶ ዎርቁስ በተአኖ? <verse eid="MAT 23:17"/><verse number="18" style="v" sid="MAT 23:18"/>ህትን ‹መቱ መንቹ መገኒሃ ክትመ ሆንጠህሴኖ ጠረጴዝ ቤቾን ጤሌዕሌጎሬ መቱርቹሃ ደግለለኖስበአ፤ እኮጎሬ ክትሜኖ ቤቾን ክትሚሃ ሆንጠህሴኖርቾን ጤሌዕሌጎሬ ጤሌዕልንከስ አፈመኖ› ይቴነንተ። <verse eid="MAT 23:18"/><verse number="19" style="v" sid="MAT 23:19"/>አዕኑ ኩ ቆቃኑት! ክትመ ጠሊለ አአኖ መገኒሃ ክትም ሆንጠህሴኖ ጠረጴዙንዶ ክትሙስ በተአኖ? <verse eid="MAT 23:19"/><verse number="20" style="v" sid="MAT 23:20"/>ህካን እኮቤቺሃ መገኒሃ ክትም<note caller="+" style="f"><char style="fqa" closed="false">ክትም፦ </char><char style="ft" closed="false">ዩ መኑ መገኒሃ ሆንጠህሰኖርቹ ጉዕሙንኩ ክትም የመመኖ።</char></note> ሆንጠህሴኖ ጠረጴዛን ጤሌዕሌኢሁ መገኒሃ ክትም ሆንጠህሴኖ ጠረጴዘለከ ዮርቾን ጉዕማንን ጤሌዕለኖ። <verse eid="MAT 23:20"/><verse number="21" style="v" sid="MAT 23:21"/>ህትን መገን ምኔን ጤሌዕሌኢሁ መገን ምኔንለከ ኣዜንከስ ሄአኖ መገኖን ጤሌዕለኖ። <verse eid="MAT 23:21"/><verse number="22" style="v" sid="MAT 23:22"/>ህትን ሰማን ጤሌዕለኖሁ መገን ጄነት ቦርጭማንለከ ጄነት ቦርጭማን አፉዕለኖሀኔን ጤሌዕለኖ።<verse eid="MAT 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23"/>«አዕኑ ኩ መኑ ለኦህዕኔተ ይቴን አቴነንተ ሕግ አስተማረትለከ ፈርሳውት፤ መንዞቺ፥ ዎስማሚቺ፥ አደደ ጠጎቺ ቶኒች መቱ ፉሽቴን ሕግ ኣዜን ዮ ሎረስ ጠወ ሀንቅ ፍርደሃ፥ አሙዙለከ አመዕነሙ አጉርቴነንተቤቺሃ ክዕኔኤሃ ቆሀኖህዕኔ! ዎሉስ አጉርቶኑዕነ ካን አኡ ሀስሰኖህዕኔ እቅ። <verse eid="MAT 23:23"/><verse number="24" style="v" sid="MAT 23:24"/>አዕኑ ቆቁ አዎንሳኑት! አጌነንተሀኒች ጉዕሚችን ቢንቤገ ቀቅቹ እኮሃ ጠሊሽቴነን ኡጅቴነንተ፤ እኮጎሬ ጋሜልገ ዮ ሎረስ አጉዕምቴነንታት።<verse eid="MAT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25"/>«አዕኑ ኩ መኑ ለኦህዕኔተ ይቴን አቴነንተ ሕግ አስተማረትለከ ፈርሳውት ቡርጩቆለከ ሳህን አብል አደ ሙጩርስቴነንታት፤ እኮጎሬ ኣዙክዕኔ አደደ ገዶንለከ ጎራምማን ዊሞቤቺሃ ክዕኔኤሃ ቆሀኖህዕኔ! <verse eid="MAT 23:25"/><verse number="26" style="v" sid="MAT 23:26"/>አዕኑ ኩ ቆቃኑት ፈርሳውት! ኤተርስ አዱ ሙጩራን ሄጭቴን ቡርጩቆለከ ሳህን ኣዝስ ሙጩሩ አዕዬ።<verse eid="MAT 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27"/>«አዕኑ ኩ መኑ ለኦህዕኔተ ይቴን አቴነንተ ሕግ አስተማረትለከ ፈርሳውት፤ ኣዜሰ ሬዮ መን ምቁለከ ንጃሾርቹ ጉዕሙንኩ ዊማንሰ እኮጎሬ አብል አዲን ጡመ ተሽ የኖ ኖሪን መክሴመ ሎደ አጉዴነንተቤቺሃ ክዕኔኤሃ ቆሀኖህዕኔ!<note caller="-" style="x"><char style="xo" closed="false">23፥27 </char><char style="xt" closed="false"><ref loc="ACT 23:3">ሶቀ. 23፥3</ref>።</char></note> <verse eid="MAT 23:27"/><verse number="28" style="v" sid="MAT 23:28"/>ህከንገን አዕኑ መኒሃ ፈየ አጉዴን ለልቴነን ኣዜንከክዕኔ መኑ ለኦህዕኔተ ይቴነን አኡለከ አዘዘሙ ግቡ ዊሞህዕኔ።<verse eid="MAT 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29"/>«አዕኑ ኩ መኑ ለኦህዕኔተ ይቴን አቴነንተ ሕግ አስተማረትለከ ፈርሳውት፤ ነብያኖ ሎደ ግምብቴነንለከ ፈየ መን ሎዳን ሐዉልተ መክሴነን <verse eid="MAT 23:29"/><verse number="30" style="v" sid="MAT 23:30"/>‹አናኖኔ ዘማኔን ሄዕኖም እቃ አናኑኔ ነብያኖ ቄጉ ዱንተን ነኡ ሜጡበ እንካምበአ እቅ› ይቴነንተቤቺሃ ክዕኔኤሃ ቆሀኖህዕኔ! <verse eid="MAT 23:30"/><verse number="31" style="v" sid="MAT 23:31"/>ህከኒን ነብያኑተ ሽቶ መን እለተ እሁክህዕኔ ገዉንኩክዕኔ መሰከርቴነንታት። <verse eid="MAT 23:31"/><verse number="32" style="v" sid="MAT 23:32"/>ህካን እኮች አዕኑ አናኑክዕኔ አቶተ ጀመርቶ ሂለ ሆጉተ ሹሌ። <verse eid="MAT 23:32"/><verse number="33" style="v" sid="MAT 23:33"/>አዕኑ ኩ ደህችለከ ዎሪች እለት አዛብ ፍርዲች ሀት እኬን ፈቄነን?<note caller="-" style="x"><char style="xo" closed="false">23፥33 </char><char style="xt" closed="false"><ref loc="MAT 3:7">ማቶ. 3፥7</ref>፤ <ref loc="MAT 12:34">12፥34</ref>፤ <ref loc="LUK 3:7">ሉቃ. 3፥7</ref>።</char></note> <verse eid="MAT 23:33"/><verse number="34" style="v" sid="MAT 23:34"/>ህካን እኮቤቺሃ ሁኩዕኑን አን ነብያኑተ፥ ሀይቻኑተ፥ አስተማረተ ክዕኔቤቹ ሶሃም፤ እሳችን መት-መቱሰ ሽቴነንተ፤ መት-መቱሰ ሰቀልቴነንተ፤ ህትን መት-መቱሰ ጭምትክዕኔ ምኔን አብዳዴን ኦልቴነንተ፤ መቶ ከተሚች ዎሉ ከተመ ሸርቴነንተሰ። <verse eid="MAT 23:34"/><verse number="35" style="v" sid="MAT 23:35"/>ህካን እኮቤቺሃ ጠሊለ አቤሌ ቄጊች ጀመር መገን ምኔንለከ መገኒሃ ክትም ክትሜኖ ጠረጴዝ በላን ሽቴንተ በራክዮ ቤቱ ዘከርያ ቄጉ ኢለ ኡለ አሌን ዱንተዕዮ ጠሊላኖ ቄጊሃ ጉዕሚንከ አዕኑ ጠዕመንቴነንተ።<note caller="-" style="x"><char style="xo" closed="false">23፥35 </char><char style="xt" closed="false"><ref loc="GEN 4:8">ክል. 4፥8</ref>፤ <ref loc="2CH 24:20-21">2 ዱዱ. 24፥20-21</ref>።</char></note> <verse eid="MAT 23:35"/><verse number="36" style="v" sid="MAT 23:36"/>ሀንቅንከ ያንክዕኔ፤ ኩ ቄግ ቅጣቱ ጉዕሙንኩ ከን ዘማን መን አሌን ኢለኖ።»<verse eid="MAT 23:36"/></para>
  <para style="s1">ኢስ ዬሩሳሌሚሃ ኦዕዮገ</para>
  <para style="r">(<ref loc="LUK 13:34-35">ሉቃ. 13፥34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37"/>«ዬሩሳሌማ! ዬሩሳሌማ! ነብያኑተ ሽታንቲት! ኪቤቹ ሶሀንቶእረ ክኒን ቀስ ሽታንቲት! ሀንጠቤቹት ጪጮረሴ ጎኔሴ ኣዜን ሀንቀፋገን አኒሁ ኪ እለተ ጭምአኦተ ሀሾሚሁ ሄንከ ወክትሃት? እኮጎሬ አዕኑ ሀሴንታኤበአ። <verse eid="MAT 23:37"/><verse number="38" style="v" sid="MAT 23:38"/>ሁኩዕኑን ምኑክዕኔ ኦነ እሀኖ።<note caller="-" style="x"><char style="xo" closed="false">23፥38 </char><char style="xt" closed="false"><ref loc="JER 22:5">ኤር. 22፥5</ref>።</char></note> <verse eid="MAT 23:38"/><verse number="39" style="v" sid="MAT 23:39"/>መሰንትስ አን ኩላንክዕኔ፤ ‹ቀርች ሱዕሚን አሜተኖሁ ማሰአሞእሃን› ይቶኖተ ኢለ ለንኪሃ ለኤነንተኤበአ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">23፥39 </char><char style="xt" closed="false"><ref loc="PSA 118:26">መዝ. 118፥26</ref>።</char></note><verse eid="MAT 23:39"/></para>
  <chapter eid="MAT 23"/>
  <chapter number="24" style="c" sid="MAT 24"/>
  <para style="s1">ዱእ ምኒ ድጀምተኔሃ ኢስ ራጎገ</para>
  <para style="r">(<ref loc="MRK 13:1-2">ማር. 13፥1-2</ref>፤ <ref loc="LUK 21:5-6">ሉቃ. 21፥5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1"/>ኢስ መገን ምኒች ፉል ኦሮአን አሳበስ ዱእ ምኒ ግምበ ለሊሶስተ ሆንጠኮኡ። <verse eid="MAT 24:1"/><verse number="2" style="v" sid="MAT 24:2"/>እኮጎሬ እስ «ከ ጉዕመንከ ለኤነንታትንዶ? ሀንቅንከ ያንክዕኔ፤ ክኑ ክን አሌን እኮገን መቱ ክኑሁ ከንቤቾን ፈቁዕነ ድጀመኖ» ዬእ።<verse eid="MAT 24:2"/></para>
  <para style="s1">ቀርቹ አሜቱዕናን ብርተ እካ ኦርሸተ</para>
  <para style="r">(<ref loc="MRK 13:3-13">ማር. 13፥3-13</ref>፤ <ref loc="LUK 21:8-19">ሉቃ. 21፥8-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3"/>ኢስ ዘይት ሀቁ ነጰኖ ቆተ አል ፉል አፉዕሌሀኔን ጠለዕል አሳበስ እስበ ሆንጠክ «ኪ አሜቱለከ ቂያመት ቢጠም መላት መሃን? ህትን ኩ ጉዕሙንኩ ጠዉ እሀኖሁ መ ወክትዪት?» ይት ጠዕምቶስ።<verse eid="MAT 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4"/>ኢስን ፈንቀሽ «አዪሁ ሉሲሰኖህዕኔበእገ አገዕርዬ። <verse eid="MAT 24:4"/><verse number="5" style="v" sid="MAT 24:5"/>መሰንትስ ልግቡ መኑ ‹አን መሲህት!› ይተን ሱዕሚንከኤ አሜት ልግብ መነ ሉሲሳአ። <verse eid="MAT 24:5"/><verse number="6" style="v" sid="MAT 24:6"/>በገዙለከ በገዝ ትምርት ሞጮጭቴነንተ፤ ሁኩን ጉዕሙንኩ እሁዕነ ፈቀኖበእቤቺሃ ህልቆኖቼ፤ እኮጎሬ መጨረሹስ ኢልዮበአ። <verse eid="MAT 24:6"/><verse number="7" style="v" sid="MAT 24:7"/>መኑ መን አሌን ዎሙ ዎም አሌን በገዙ ኬሰኖ፤ ጎሩለከ አደደ ቤቾን ኡለ ሌንቄቁ እሀኖ። <verse eid="MAT 24:7"/><verse number="8" style="v" sid="MAT 24:8"/>ሁኩን ጉዕሙንኩ ኒጠኛ ጭንቃተ ዎኔሲሃ እሀኖ። <verse eid="MAT 24:8"/><verse number="9" style="v" sid="MAT 24:9"/>ህከ ወክት ኦርሻተ ህግሴን ኣሴኖህዕኔ፤ ህትን ሼኖህዕኔ፤ ክዕኔተ ኢ ሱዕምተኔሃ ጉዕማንከ መንቤቾን ግቤኖህዕኔ።<note caller="-" style="x"><char style="xo" closed="false">24፥9 </char><char style="xt" closed="false"><ref loc="MAT 10:22">ማቶ. 10፥22</ref>።</char></note> <verse eid="MAT 24:9"/><verse number="10" style="v" sid="MAT 24:10"/>ህትን ልግቡ መኑ ህከ ወክት ሀይማኖተሰ ካደአ፤ ህትን መቱ መቱስ ህግሽ ኣሰኖ፤ መኑ ገገይንከስ ብተመኖ። <verse eid="MAT 24:10"/><verse number="11" style="v" sid="MAT 24:11"/>ልግቡ ክዝብ ነብያኑት ኬእ ልግብ መነ ሉሲሳአ። <verse eid="MAT 24:11"/><verse number="12" style="v" sid="MAT 24:12"/>ሂሉ ጠዉ በተዕዮቤቺሃ ልግብያ መን ኢተት በኣአ። <verse eid="MAT 24:12"/><verse number="13" style="v" sid="MAT 24:13"/>ጠዉ እኮጎሬ መጨረሸ ኢለ ጠረኘኖሁ ጡመኖ።<note caller="-" style="x"><char style="xo" closed="false">24፥13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">ማቶ. 10፥22</ref>።</char></note> <verse eid="MAT 24:13"/><verse number="14" style="v" sid="MAT 24:14"/>መን ጉዕሚንከ ምስክር እሆተ ኩ መገን ዎምነት ተሽት ላገት ኣዱንያ አሌን ጉዕማንን ዱዱብሰንታአ፤ ህከ ወክት ቅያመት ሆንጠካአ» ዬእ።<verse eid="MAT 24:14"/></para>
  <para style="s1">አበ ኦርሸተኔሃ</para>
  <para style="r">(<ref loc="MRK 13:14-23">ማር. 13፥14-23</ref>፤ <ref loc="LUK 21:20-24">ሉቃ. 21፥20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15"/>አነበበኖሁ ካን አጥራመቱን፤ ነብዬቹ ዳኔል ጠወዕዮገን ኮፍየኖ ንጃሾርቹ ማሰአሞ ቤቾን እካን ለኤነንተ ወክት<note caller="-" style="x"><char style="xo" closed="false">24፥15 </char><char style="xt" closed="false"><ref loc="DAN 9:27">ዳን. 9፥27</ref>፤ <ref loc="DAN 11:31">11፥31</ref>፤ <ref loc="DAN 12:11">12፥11</ref>።</char></note> <verse eid="MAT 24:15"/><verse number="16" style="v" sid="MAT 24:16"/>ይሁድ ባዶን ሄኣእሩ ቆተ አል ሁንቱን። <verse eid="MAT 24:16"/><verse number="17" style="v" sid="MAT 24:17"/>ምኒ እሌ አሌን ዮ መንቹ ምኔስ ዮርቹ ኣኦተ ድሩንከ።<note caller="-" style="x"><char style="xo" closed="false">24፥17-18 </char><char style="xt" closed="false"><ref loc="LUK 17:31">ሉቃ. 17፥31</ref>።</char></note> <verse eid="MAT 24:17"/><verse number="18" style="v" sid="MAT 24:18"/>ህትን አቡረ ቤቾን ዮ መንቹ ኦድኑስ ኣኦተ ምንስ ፈንቀሉንከ። <verse eid="MAT 24:18"/><verse number="19" style="v" sid="MAT 24:19"/>ህከ ወክት ቀንስተሀኑኡተለከ ላፈ ሜንቲሃ ኣዬ። <verse eid="MAT 24:19"/><verse number="20" style="v" sid="MAT 24:20"/>ሁንቴነንተ ወክቱ ከርሜን ህከረንገ አበ በር እሀኖበእገ ዱአ አዕዬ። <verse eid="MAT 24:20"/><verse number="21" style="v" sid="MAT 24:21"/>ህከ ወክት ኣዱንያ አሉ ከለቀሞች ጀመር እኮበኢሁለከ ብርተ ዋሽ ሆሮን እሀኖበእ አቡ ኦሪሸት አሜታአ። <verse eid="MAT 24:21"/><verse number="22" style="v" sid="MAT 24:22"/>ሁኩ ኦሪሸ ወክቱ ገቦጥዮበእቃን መቱ መንቹሁ ጡሞተ አታለኖበአ እቅ፤ ጠዉ እኮጎሬ መጠረንቶ መንተኔሃ ሁኩ ወክቱ ገበንቹ እሀኖ።<verse eid="MAT 24:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23"/>ህከ ወክት አዪሁ «መሲሁ ከበ ዮኡ!» ህከረንገ «ካጳ ዮኡ!» ዬህዕኔጎሬ አመዕንቶኖቼ። <verse eid="MAT 24:23"/><verse number="24" style="v" sid="MAT 24:24"/>መሰንትስ ክዝብ መሲህት ይታእሩለከ ነብያኑት ኬኢሃ አታልቶ እቃን መጠረንቶ መነሃ ፈቁዕናን ሉሲሶተ አበ መላተለከ አጀብሲሰኖ ጠወሃ ለሊሳቤቺሃት።<note caller="-" style="x"><char style="xo" closed="false">24፥24 </char><char style="xt" closed="false"><ref loc="DAN 12:1">ዳን. 12፥1</ref>፤ <ref loc="REV 7:14">መና. 7፥14</ref>።</char></note><verse eid="MAT 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 24:25"/>ሁኩዕኑን አን ጉዕመርቹንከ ሄጭ ኩሎንክዕኔ። <verse eid="MAT 24:25"/><verse number="26" style="v" sid="MAT 24:26"/>ህካን እኮቤቺሃ «ሁኩዕኑን! ኡድማን ዮኡ» ዬመህዕኔጎሬ ፉልቶኖቼ፤ ህትን «ሁኩዕኑን! ማጠሞ ቤቾን ዮኡ» ዬመህዕኔጎሬ አመዕንቶኖቼ።<note caller="-" style="x"><char style="xo" closed="false">24፥26 </char><char style="xt" closed="false"><ref loc="LUK 17:23-24">ሉቃ. 17፥23-24</ref>።</char></note> <verse eid="MAT 24:26"/><verse number="27" style="v" sid="MAT 24:27"/>መሰንትስ ጉገኛት ጉጋ ወክት ሸርቂች ኬሽ ገርበ ኢለ ለለኖሀንገን መንች ቤት አሜቱሁ ህትን እሀኖ። <verse eid="MAT 24:27"/><verse number="28" style="v" sid="MAT 24:28"/>ሬሹ ኡቦቤቹ ዞብሩ ጭምየኖ ዬእ።<note caller="-" style="x"><char style="xo" closed="false">24፥28 </char><char style="xt" closed="false"><ref loc="LUK 17:37">ሉቃ. 17፥37</ref>።</char></note><verse eid="MAT 24:28"/></para>
  <para style="s1">መንች ቤቱ ለንኪሃ አሜቱስ</para>
  <para style="r">(<ref loc="MRK 13:24-27">ማር. 13፥24-27</ref>፤ <ref loc="LUK 21:25-28">ሉቃ. 21፥25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29"/>ኢስ «ህከን ኦርሻች ኤተሮን ወክትንከስ አሩ ቱንሰኖ፤ አገንቹንኩ ለሊሰኖበአ፤ ቤዜት ሰሜች ኡባአ፤ ሰማንዮርቹ ጉዕሙንኩ ሌንቄቀኖ።<note caller="-" style="x"><char style="xo" closed="false">24፥29 </char><char style="xt" closed="false"><ref loc="ISA 13:10">ኢሳ. 13፥10</ref>፤ <ref loc="ISA 34:4">34፥4</ref>፤ <ref loc="EZK 32:7">ሕዝ. 32፥7</ref>፤ <ref loc="JOL 2:10-31">ኢዩ. 2፥10-31</ref>፤ <ref loc="JOL 3:15">3፥15</ref>፤ <ref loc="REV 6:12-13">መና. 6፥12-13</ref>፤ <ref loc="DAN 7:13">ዳን. 7፥13</ref>፤ <ref loc="ZEC 12:10-14">ዘካ. 12፥10-14</ref>፤ <ref loc="REV 1:7">መና. 1፥7</ref>።</char></note> <verse eid="MAT 24:29"/><verse number="30" style="v" sid="MAT 24:30"/>ህከ ወክት መንች ቤት መላት ሰማን ለልታአ፤ ኣዱንያ አሌን ዮ መኑ ጉዕሙንኩ አበ ኦአኖ፤ መንች ቤቱንኩ ዎልቃንለከ ሎረ ኬዕምኚን ሰሜ ጎማን አሜተን ለኣአ። <verse eid="MAT 24:30"/><verse number="31" style="v" sid="MAT 24:31"/>ጡሩምበ ሎረ ላጋን ቡሳ መላይከተ ሶሀኖ፤ እሰን ሾሎንከ ሰሜ ዳንጊች እሲሃ መጠረንቶእረ ጭምአታአ» ዬእ።<verse eid="MAT 24:31"/></para>
  <para style="s1">ኦድ ሀቁቾ ምሳሌተኔሃ</para>
  <para style="r">(<ref loc="MRK 13:28-31">ማር. 13፥28-31</ref>፤ <ref loc="LUK 21:29-33">ሉቃ. 21፥29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32"/>ኢስ «ኦድ ሀቁቾ ምሳሌች ተማሬ፤ ሀሙሴ ለተንለከ ሀበሩሴ ገምበለዕያን ለኤንተ ወክት ሀጎ<note caller="+" style="f"><char style="fqa" closed="false">ሀጎ፦ </char><char style="ft" closed="false">ኩን ለሊሰኖሁ እሰ ባዶን ሀቁ ቀንሰኖሁለከ ሀበሩ ለተኖሁ ሀጎ ሆንጠካኒት።</char></note> ሆንጠሁስ ደጌነንተ። <verse eid="MAT 24:32"/><verse number="33" style="v" sid="MAT 24:33"/>ህትን አዕኑ ኩ ጠዉ ጉዕሙንኩ እሀን ለኤንተ ወክት ጠወአንቶ ላገኤ ዊንታ ወክቱ ኢሌገ ደጌ። <verse eid="MAT 24:33"/><verse number="34" style="v" sid="MAT 24:34"/>ሀንቅንከ ያንክዕኔ፤ ኩን ጉዕሙንኩ ዊሞተ ኢለ ከን ዘማን መኑ ህገኖበአ። <verse eid="MAT 24:34"/><verse number="35" style="v" sid="MAT 24:35"/>ሰሞሁለከ ኡለት ህጋአ፤ ጠዉ እኮጎሬ ላገኤ ሆሮ ህጋበአ» ዬእ።<verse eid="MAT 24:35"/></para>
  <para style="s1">መንች ቤቱ አሜቱስ አዪሁ ደገኖበአ</para>
  <para style="r">(<ref loc="MRK 13:32-37">ማር. 13፥32-37</ref>፤ <ref loc="LUK 17:26-30">ሉቃ. 17፥26-30</ref>፤ 34-36።)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36"/>ኢስን «ህከ በርለከ ህከ ሳኣት አነ መገን ቤሉ ሰሜ መላይከት እኮእቃን ቤቱሃ እቃን አዪሁ ደጎተ አታለኖበአ። <verse eid="MAT 24:36"/><verse number="37" style="v" sid="MAT 24:37"/>ኑህ ዘማን እኮገን መንች ቤቲ አሜቱሁ ህትን እሀኖ።<note caller="-" style="x"><char style="xo" closed="false">24፥37 </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">ክል. 6፥5-8</ref>።</char></note> <verse eid="MAT 24:37"/><verse number="38" style="v" sid="MAT 24:38"/>ህከ ዘማን ቤሰኖ ዊች ሄጭ ኑህ መርከባን ኣገኖ በር ኢለ መኑ እተኖቲ፥ አገኖቲ፥ ኣአኖትለከ መዕሲሰኖት እቅ። <verse eid="MAT 24:38"/><verse number="39" style="v" sid="MAT 24:39"/>ቤሰኖ ውሁ አሜች ጉዕመንከሰ ሀጣው መሶተ ኢለ ደጎበእሀንገን መንች ቤቲ አሜቱሁ ህትን እሀኖ።<note caller="-" style="x"><char style="xo" closed="false">24፥39 </char><char style="xt" closed="false"><ref loc="GEN 7:6-24">ክል. 7፥6-24</ref>።</char></note> <verse eid="MAT 24:39"/><verse number="40" style="v" sid="MAT 24:40"/>ለሙ መኑ አቡርታቤቺች መቱስ መሴናን መቱስ ፈቀኖ። <verse eid="MAT 24:40"/><verse number="41" style="v" sid="MAT 24:41"/>ለሙ ሜንቱ ሪትማን ሪታ ቤቺች መትሴ መሴናን መትሴ ፈቃአ። <verse eid="MAT 24:41"/><verse number="42" style="v" sid="MAT 24:42"/>ህካን እኮቤቺሃ ቀርቹክዕኔ አሜተኖ በር ደጌነንተበእቤቺሃ ጠረኝቴን አገዕርዬ። <verse eid="MAT 24:42"/><verse number="43" style="v" sid="MAT 24:43"/>ጠዉ እኮጎሬ ካን ደጌ፤ መቶ ምኒ አኑ ሞጋንቹ ሀንከዕሬን ሀከ ወክት አሜተኖጎሬ ደጎእቃን ምንስ እሞኖተ ሰዕምየኖበአ እቅ። <verse eid="MAT 24:43"/><verse number="44" style="v" sid="MAT 24:44"/>ህካን እኮቤቺሃ መንች ቤቱ ሰውይቴንበ ወክቴን አሜተኖቤቺሃ አዕኑ ተቃጠቤን አገሬ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">24፥44 </char><char style="xt" closed="false"><ref loc="LUK 12:39-40">ሉቃ. 12፥39-40</ref>።</char></note><verse eid="MAT 24:44"/></para>
  <para style="s1">አመዕነሞሃለከ አመዕነሞበእ ካዲንች ምሳልተ</para>
  <para style="r">(<ref loc="LUK 12:41-48">ሉቃ. 12፥41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45"/>ኢስ «ምንስ አበሮሲሃ እቸተ ወክቲን ኣሶተ ቀርቹስ አበሮስስ አሌን ዳኛ አእዮስ አመዕነሞለከ ኤንኬዕናሙ ካዲንቹ አዬት? <verse eid="MAT 24:45"/><verse number="46" style="v" sid="MAT 24:46"/>ቀርቹስ አሜቾ ወክት እስ ዬገን አአን ደገመኖ ካዲንቹ ማሰአሞእሃን። <verse eid="MAT 24:46"/><verse number="47" style="v" sid="MAT 24:47"/>አን ሀንቅንከ ያንክዕኔ፤ ህከ ካዲንቹ ቀርቹስ ዮስ ዱንያ አሌን ጉዕማንን ሹመ አአኖስ። <verse eid="MAT 24:47"/><verse number="48" style="v" sid="MAT 24:48"/>እኮጎሬ ሂሉ ካዲንቹ ‹ቀርቹኤ ቴሱ አሜተኖበአ› ይ ሰውዬጎሬ <verse eid="MAT 24:48"/><verse number="49" style="v" sid="MAT 24:49"/>ሆጎስ ጃለተ ኦለን ሰካራሚን ሜጡበ እቱለከ አጉ ጀመሮጎሬ <verse eid="MAT 24:49"/><verse number="50" style="v" sid="MAT 24:50"/>ህከን ካዲንች ቀርቹ አገሮበእ በሬንለከ ሳኣቴን አሜች <verse eid="MAT 24:50"/><verse number="51" style="v" sid="MAT 24:51"/>ህከ ካዲንቹ ቀጠአኖስ፤ ህትን መኑ ለኦሰተ ይት አታ መኒን ሜጡበ አዕያንስ ህከኔ ኦኡለከ የቡሩ ገዕሙ እሀኖስ» ዬእ።<verse eid="MAT 24:51"/></para>
  <chapter eid="MAT 24"/>
  <chapter number="25" style="c" sid="MAT 25"/>
  <para style="s1">ቶኖ ሜኣኖ ምሳልተ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1"/>ኢስን ሰሜ ዎምነቱ ኩረዘ አፍ እዜቹ ቶጎተ ፉልቶ ቶን ሜኣኑተ አጉዳአ።<note caller="-" style="x"><char style="xo" closed="false">25፥1 </char><char style="xt" closed="false"><ref loc="LUK 12:35">ሉቃ. 12፥35</ref>።</char></note> <verse eid="MAT 25:1"/><verse number="2" style="v" sid="MAT 25:2"/>እሳችን ኦንቱሰ ገዋኑተ፥ ኦንቱሰ ኤንኬዕናመተ እቅ። <verse eid="MAT 25:2"/><verse number="3" style="v" sid="MAT 25:3"/>ገዋኑስ ኩረዘ አፎ እቅ፤ እኮጎሬ ጋዘ አፎበአ። <verse eid="MAT 25:3"/><verse number="4" style="v" sid="MAT 25:4"/>ኤንኬዕናመት ኩረዘለከ ዎሌ ኦዳን ጋዘ አፎ እቅ። <verse eid="MAT 25:4"/><verse number="5" style="v" sid="MAT 25:5"/>እዜቹ አሜቱዕነ ዱንኬ ወክት ጉዕመንከሰ ግሰኛት ቄልታንሰ ኦሰኦኡ።<verse eid="MAT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6"/>እኮጎሬ ሀዎሮ በላን «ሁኩዕኑን! እዜቹ አሜቾኡ፤ ፉልቴን ቶጌ!» ዬኖ ጨንጨነት እኮኡ። <verse eid="MAT 25:6"/><verse number="7" style="v" sid="MAT 25:7"/>ህከ ወክት ጉዕሙንኩ ሜኣኑት ኬእ ኩረዘሰ ቅጥአቶኡ። <verse eid="MAT 25:7"/><verse number="8" style="v" sid="MAT 25:8"/>ገዋኑት ኤንኬዕናመተ ኩረዙኔ ጠኦታት፤ ህካን እኮቤቺሃ ጋዝችክዕኔ ኣስዬኔ ይት ኡጭቶኡ። <verse eid="MAT 25:8"/><verse number="9" style="v" sid="MAT 25:9"/>ኤንኬዕናመት ፈንቀሽት ክዕኔኤሃለከ ኔሳሃ እሀኖ ጋዙ ዮኔበአ፤ ሱቀ መርቴን ክዕኔ እሀኖህዕኔ ጋዘ ህዕርዬ ይት ፈንቀሽቶኡ። <verse eid="MAT 25:9"/><verse number="10" style="v" sid="MAT 25:10"/>ሁኩ ገዋኑንት ጋዘ ህዕርቶተ መርቶ ጌሳን እዜቹ አሜቾ፤ ተቃጠብ አገርቶ ሜኣኑት እዜቺን ሜጡበ ቦለች ድግስቤቹ ኣጋን ኡሩት ጡፈንቶኡ።<verse eid="MAT 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11"/>«ሁኩ ገዋኑት ኡሩት ጡፌማች ኤተሮን አሜት ‹ቀርቾ! ቀርቾ! ሀዕይ ኡሩተ ፈንኔ› ይቶኡ። <verse eid="MAT 25:11"/><verse number="12" style="v" sid="MAT 25:12"/>እኮጎሬ እስ ፈንቀሽ ‹ሀንቅንከ ያንክዕኔ፤ አን ደጋንክዕኔበአ› ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">25፥12 </char><char style="xt" closed="false"><ref loc="LUK 13:25">ሉቃ. 13፥25</ref>።</char></note> <verse eid="MAT 25:12"/><verse number="13" style="v" sid="MAT 25:13"/>ህካን እኮቤቺሃ በርስለከ ሰኣትስ ደጌነንተበእቤቺሃ ጠረኝቴን አገዕርዬ» ዬእ።<verse eid="MAT 25:13"/></para>
  <para style="s1">ኤገተ ኣሴመ ሰሶ ካዲመ ምሳልተ</para>
  <para style="r">(<ref loc="LUK 19:11-27">ሉቃ. 19፥11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14"/>ኢስ «ሰሜ ዎምነቱ ዎሉ ባዱ ሃሞተ ካዲመስ ገእ ዮስ ዱንያተ ኣሴ መንቹ አጉደኖ።<note caller="-" style="x"><char style="xo" closed="false">25፥14-30 </char><char style="xt" closed="false"><ref loc="LUK 19:11-27">ሉቃ. 19፥11-27</ref>።</char></note> <verse eid="MAT 25:14"/><verse number="15" style="v" sid="MAT 25:15"/>መት-መትሀሰ ዎልቀሰ ጌሰ ቤሀን መቲሀስ ኦንቱ መክሊተ<note caller="+" style="f"><char style="fqa" closed="false">መክሊተ፦ </char><char style="ft" closed="false">መቱ መክሊቱ መቶ በሬ ሆጉተ አአኖ መንቺሃ ቶነ ኦንቶ ዘማኒያ ደሞዘ</char></note> ሁኩ መክሊቱ መኬኢሁ ጠገር ብርቺት። መቲሀስ ለሙ መክሊተ ህትን ዎልሀስ መቱ መክሊተ ኣስ ዎሉ ባዱ ኦሮዕዮ። <verse eid="MAT 25:15"/><verse number="16" style="v" sid="MAT 25:16"/>ኦንቱ መክሊተ ኣኤኢሁ ወክትንከስ ኦሮዕይ ነገጅ ዎሉ ኦንቱ መክሊተ ተረፍሾ። <verse eid="MAT 25:16"/><verse number="17" style="v" sid="MAT 25:17"/>ህትን ለሙ መክሊተ ኣኤኢሁ ነገጅ ዎሉ ለሙ መክሊተ ተረፍሾ። <verse eid="MAT 25:17"/><verse number="18" style="v" sid="MAT 25:18"/>እኮጎሬ መቱ መክሊተ ኣኤኢሁ ኦሮዕይ ኡለተ እም ቀርችስ መክሊተ ሞጎ።<verse eid="MAT 25:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19"/>«ልግብያ ወክቲች ኤተሮን ህከን ካዲመ ቀርቹ ኦሮዕዮ ቤቺች አሜች ካዲማንከስን መክሊተ አሰቡ ጀመሮ። <verse eid="MAT 25:19"/><verse number="20" style="v" sid="MAT 25:20"/>ኦንቱ መክሊተ ቶጎ ካዲንቹ ዎሉ ኦንቱ መክሊተ አፍ ቀርችቤቹ አሜች ‹ቀርቾ! ኦንቱ መክሊተ ኣቶንቴኤ እቅ፤ ሁኩዕኑን ዎሉ ኦንቱ መክሊተ ተረፍሾም› ዬእ። <verse eid="MAT 25:20"/><verse number="21" style="v" sid="MAT 25:21"/>ቀርቹንኩ ፈንቀሽ ‹ጡመ አቶንት፤ ኩ ጡሙለከ አመዕነንቶንት ካዲንቹ! ከን ቀዎርቾን አመዕነንቶንትቤቺሃ ሎረርቾን ሹመ አኣንኬ፤ አም! ቀርችክ ሙንዲኖቤቹ ኣግ!› ዬስ። <verse eid="MAT 25:21"/><verse number="22" style="v" sid="MAT 25:22"/>ህትን ለሙ መክሊተ ቶጎ ካዲንቹ አሜች ‹ቀርቾ! ለሙ መክሊተ ኣቶንቴኤ፤ ሁኩዕኑን አን ዎሉ ለሙ መክሊተ ተረፍሾም› ዬእ። <verse eid="MAT 25:22"/><verse number="23" style="v" sid="MAT 25:23"/>ቀርቹንኩ ‹ጡመ አቶንት፤ አት ኩ ጡሙለከ አመዕነንቶንት ካዲንቹ! ከን ቀዎርቾን አመዕነንቶንትቤቺሃ ሎረርቾን ሹመ አኣንኬ፤ አም! ቀርችክ ሙንዲኖቤቹ ኣግ› ዬስ። <verse eid="MAT 25:23"/><verse number="24" style="v" sid="MAT 25:24"/>መቱ መክሊተ ቶጎ ካዲንቹ አሜች ‹ቀርቾ! አት ዉጥበቤቺች ምዳንቲሃለከ ፍንጭትበቤቺች ጭምአታንቲ አሙዝበ መንቹ እሁክ ደጎም። <verse eid="MAT 25:24"/><verse number="25" style="v" sid="MAT 25:25"/>ህካን እኮቤቺሃ ዋጅ መክሊተክ ኡለ ኣዜን ሞጎም፤ ሁኩዕኑን መክሊቱክ› ዬስ። <verse eid="MAT 25:25"/><verse number="26" style="v" sid="MAT 25:26"/>ቀርቹንኩ ‹አት ኩ ሂሉ ደግለልትቡ ካዲንቹ! አን ዉጮምበእቤቺች ምዳምገለከ ፍንጭበቤቺች ጭምአኣምገ ደገንንዶ? <verse eid="MAT 25:26"/><verse number="27" style="v" sid="MAT 25:27"/>ህካን እኮች አን አሜች መክሊተእ ትርፊንከስን ኣኦተ ተረፍሰኖ መኒሃ ኣሱ ሀስሰኖኤ እቅ። <verse eid="MAT 25:27"/><verse number="28" style="v" sid="MAT 25:28"/>ህካን እኮቤቺሃ መቱ መክሊተ ኣእቴን ቶኑ መክሊቱ ዮስ መንቺሃ ኣስዬ። <verse eid="MAT 25:28"/><verse number="29" style="v" sid="MAT 25:29"/>መሰንትስ ዮስ መንቺሃ ኣሰመኖሲሁ፥ በተአኖሲሁ፤ እኮጎሬ ዮስበእሀኒች ሁኩ ዮሲንኩ ኣአመኖስ።<note caller="-" style="x"><char style="xo" closed="false">25፥29 </char><char style="xt" closed="false"><ref loc="MAT 13:12">ማቶ. 13፥12</ref>፤ <ref loc="MRK 4:25">ማር. 4፥25</ref>፤ <ref loc="LUK 8:18">ሉቃ. 8፥18</ref>።</char></note> <verse eid="MAT 25:29"/><verse number="30" style="v" sid="MAT 25:30"/>ህከ ደግለልቡ ካዲንቹ አብሌ ዮ ቱንስቾን ፉሽቴን ኡጅዬ፤ ህከኔን ኦኡለከ የቡሩ ገዕሙ እሀኖስ› ዬስ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">25፥30 </char><char style="xt" closed="false"><ref loc="MAT 8:12">ማቶ. 8፥12</ref>፤ <ref loc="MAT 22:13">22፥13</ref>፤ <ref loc="LUK 13:28">ሉቃ. 13፥28</ref>።</char></note><figure style="fig" alt="Oil lamp" file="HK00151B.tif" size="span" ref="25፥1-13">ኩራዘ</figure><verse eid="MAT 25:30"/></para>
  <para style="s1">ዘማን ጎፎን እሀኖ ፍርድተኔሃ</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31"/>ኢስ «መንች ቤቱ ጉዕመንከ መላይካንተስ አጀበም አሜቾ ወክት ኬዕምኝስ ጄነት ቦርጭማን አፉዕለኖ።<note caller="-" style="x"><char style="xo" closed="false">25፥31 </char><char style="xt" closed="false"><ref loc="MAT 16:27">ማቶ. 16፥27</ref>፤ <ref loc="MAT 19:28">19፥28</ref>።</char></note> <verse eid="MAT 25:31"/><verse number="32" style="v" sid="MAT 25:32"/>መኑ ጉዕሙንኩ ብሬስ ጭምየኖ፤ እስን ዜማንቹ ሆለተ ፌዕላኢች አደ አአኖሀንገ መቱ-መቲች አደ አአኖ። <verse eid="MAT 25:32"/><verse number="33" style="v" sid="MAT 25:33"/>ህትን ሆለተ መኬስ አዲን ፌዕላኡ ጉረስ አዲን ኡርሰኖ። <verse eid="MAT 25:33"/><verse number="34" style="v" sid="MAT 25:34"/>ህከ ወክት ዎሙ መኬስ አዲን ዮሀኑኡተ ‹አዕኑ አኑኤ ማሰእዮህዕኔሩ አሜ! ኣዱንያት ከለቀንቶች ኬሽ ቅጠሞህኔ ዎምነቱ ረገዕዬ። <verse eid="MAT 25:34"/><verse number="35" style="v" sid="MAT 25:35"/>መሰንትስ ጎሩ አፋዕኔ እትሴንታኤ፤ ሰገባዕኔ አግሴንታኤ፤ ኮህቹ እክ አሜቻን ቶጌንታኤ። <verse eid="MAT 25:35"/><verse number="36" style="v" sid="MAT 25:36"/>ኦድኑተ ሆጋን ኦድሴንታኤ፤ ጥዣዕኔ ጠዕምቴንታኤ፤ ኡሱረማን ለኤንታኤ› የኖሰ። <verse eid="MAT 25:36"/><verse number="37" style="v" sid="MAT 25:37"/>ህከ ወክት ጠሊላኑት ‹ቀርቾ! ጎሩ አፋንኬ ለዕን ሀከረ እትንሶንኬ ህከረንገ ሰገብት አፋንኬ ለዕን ሀከረ አግንሶንኬ? <verse eid="MAT 25:37"/><verse number="38" style="v" sid="MAT 25:38"/>ህትን ኮህቹ እክ አሜታን ሀከረ ቶንጎንኬ? ኦድኑተ ሆጋን ለዕን ሀከረ ኦዲንሶንኬ? <verse eid="MAT 25:38"/><verse number="39" style="v" sid="MAT 25:39"/>ህትን ሀከረ ጥዛን ህከረንገ ኡሱረንታን ለዕኖንኬ?› ይት ፈንቀሽታስ። <verse eid="MAT 25:39"/><verse number="40" style="v" sid="MAT 25:40"/>ዎሙንኩ ‹ሀንቅንከ ያንክዕኔ፤ ከን አመኤኦሶች መቶ ቀይሀስ አቴንታሁ ጉዕሙንኩ ኤሳሃ አቴንተሀንጋት› ይ ፈንቀሸኖሰ። <verse eid="MAT 25:40"/><verse number="41" style="v" sid="MAT 25:41"/>ህትን ጉረ አዲን ሄኦሀኑኡተ ‹አዕኑ ቦሮረንቴንታእሩ! ኢች ቄዕርዬ! እልቢስሀለከ አዎንታስ መላይከተ ቅጥይቶ ዘላለሚሃ ጠእትቡ ጊራ ኣዝ ኦሮዕዬ። <verse eid="MAT 25:41"/><verse number="42" style="v" sid="MAT 25:42"/>መሰንትስ ጎሩ አፋዕኔ እትሴንታኤበአ፤ ሰገባን አግሴንታኤበአ። <verse eid="MAT 25:42"/><verse number="43" style="v" sid="MAT 25:43"/>ኮህቹ እካን ቶጌንታኤበአ፤ ኦድኑተ ሆጋን ኦዲሴንታኤበአ፤ ጥዣን ህከረንገ ኡሱረማን ጠዕምቴንታኤበአ› የኖሰ። <verse eid="MAT 25:43"/><verse number="44" style="v" sid="MAT 25:44"/>እሰን ፈንቀሽት ‹ቀርቾ! ጎሩ አፋንኬ ለዕን ህከረንገ ሰገባን ህከረንገ ኮህቹ እካን ህከረንገ ኦድኑተ ሆጋን ህከረንገ ጥዛን ህከረንገ ኡሱረንታን ሀከረ ለዕን ሀዕልኑዕነ አጉርኖንኬ?› ይታስ። <verse eid="MAT 25:44"/><verse number="45" style="v" sid="MAT 25:45"/>ዎሙንኩ ‹ሀንቅንከ ያንክዕኔ፤ ከን ቀቀዋኖች መቲሀስ አቴንባች ኤሳሃ አቴንበኤሀንጋት› የኖሰ። <verse eid="MAT 25:45"/><verse number="46" style="v" sid="MAT 25:46"/>ህካን እኮቤቺሃ ጩበኛኑት ዘላለሚሃ ቀጠአንታቤቹ መርታአ፤ እኮጎሬ ፈያኑት ዘላለሚሃ ሄአኖ ሄእቤቹ መርታአ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">25፥46 </char><char style="xt" closed="false"><ref loc="DAN 12:2">ዳን. 12፥2</ref>።</char></note><verse eid="MAT 25:46"/></para>
  <chapter eid="MAT 25"/>
  <chapter number="26" style="c" sid="MAT 26"/>
  <para style="s1">ኢሰ ሽቶተ አማዕለንቶገ</para>
  <para style="r">(<ref loc="MRK 14:1-2">ማር. 14፥1-2</ref>፤ <ref loc="LUK 22:1-2">ሉቃ. 22፥1-2</ref>፤ <ref loc="JHN 11:45-53">ያህ. 11፥45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1"/>ኢስ ካን ጉዕመንከ ተማርስ ሹሎች ኤተሮን አሳባተስ <verse eid="MAT 26:1"/><verse number="2" style="v" sid="MAT 26:2"/>«ለሞ በሬች ኤተሮን ሻሽግ ከበጀት ከበጄኖሃ ደጌነንተ፤ ህትን መንች ቤቱ ሰቀሊሃ ህግሴን ኣሴኖ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">26፥2 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">ፉል. 12፥1-27</ref>።</char></note><verse eid="MAT 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3"/>ህከ ወክት ቂስ አዎንሳኑትለከ ባድ ባልቀት «ቀያፈ» ዬኖ ሎረ ቂስች ግቤን ጭምይቶኡ። <verse eid="MAT 26:3"/><verse number="4" style="v" sid="MAT 26:4"/>እሰ ኢሰ ተንኮን አፍ ሽቶተ አማዕለንቶኡ። <verse eid="MAT 26:4"/><verse number="5" style="v" sid="MAT 26:5"/>ጠዉ እኮጎሬ እሰ «መን በላን ብተት ኬኣቤቺሃ ከበጃት በሬን እሁንከ» ይቶኡ።<verse eid="MAT 26:5"/></para>
  <para style="s1">መትት መንቹት ኢሳን ሽቱተ ቡርቶገ</para>
  <para style="r">(<ref loc="MRK 14:3-9">ማር. 14፥3-9</ref>፤ <ref loc="JHN 12:1-8">ያህ. 12፥1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6"/>ጎግ አሌን ፉልታ ጥዘነት ዮስ ስሞኔ ምኔን «ቢታነ» ዬኖቤቾን ኢስ ዮሀኔን <verse eid="MAT 26:6"/><verse number="7" style="v" sid="MAT 26:7"/>መት መንቹት ዋጉሴ አበ ጤአተ እኮ ሽቱት ዊንቶእ «አልባስጥሮሰ»<note caller="+" style="f"><char style="fqa" closed="false">አልባስጥሮሰ፦ </char><char style="ft" closed="false">ኬዕምኝ ኦዳተ መክሴኖ ዋጁወ ማዕድንየ ክኑ።</char></note> ዬኖ ብልቃጠ አፍ ኢስቤቹ አሜቶኡ፤ እስን ማዳን አፉዕሌቤቾን ቡዕለስ ሽቱተ ዱንቶኡ።<note caller="-" style="x"><char style="xo" closed="false">26፥7 </char><char style="xt" closed="false"><ref loc="LUK 7:37-38">ሉቃ. 7፥37-38</ref>።</char></note> <verse eid="MAT 26:7"/><verse number="8" style="v" sid="MAT 26:8"/>እኮጎሬ አሳበስ ለእ ኡሙዕርት «ኩ ሽቱት ሚሃ ተሰ በኣአ? <verse eid="MAT 26:8"/><verse number="9" style="v" sid="MAT 26:9"/>ከ ሽቱተ አበ ብረ ህሬን ቡጥቻኖተ ኣሴመ እቃን ጡመ እቅ» ይቶኡ። <verse eid="MAT 26:9"/><verse number="10" style="v" sid="MAT 26:10"/>ጠዉ እኮጎሬ ኢስ እሰ ይታኢሃ ደግ «ት መንቹት ኤሳሃ ጡመርቹ አቶኤ፤ ሚሃ ኦርሴነንተሴት? <verse eid="MAT 26:10"/><verse number="11" style="v" sid="MAT 26:11"/>መሰንትስ ቡጥቻኑት ጉዕመ ወክት ክዕኔን ሄኣእረ፤ ጠዉ እኮጎሬ አን ጉዕመ ወክት ክዕኔን ሜጡበ ሄኣምበአ።<note caller="-" style="x"><char style="xo" closed="false">26፥11 </char><char style="xt" closed="false"><ref loc="DEU 15:11">ዘዳ. 15፥11</ref>።</char></note> <verse eid="MAT 26:11"/><verse number="12" style="v" sid="MAT 26:12"/>እሴ ከ ሽቱተ አሌኤ ዱንቶኢሁ ሞጎኖኤተ ቅጥ አቶታት። <verse eid="MAT 26:12"/><verse number="13" style="v" sid="MAT 26:13"/>ሀንቅንከ ያንክዕኔ፤ ኩ ተሽት ላገት ኣዱንያ አሌን ዱዱብሰመኖቤቾን ጉዕማንን ት መንቹት አቶ ጠዉ እሴተ ሰውዬኖሴገ አአኖ» ዬእ።<verse eid="MAT 26:13"/></para>
  <para style="s1">ኢሰ ይሁድ ህግሽ ኣሶተ አማዕለሞገ</para>
  <para style="r">(<ref loc="MRK 14:10-11">ማር. 14፥10-11</ref>፤ <ref loc="LUK 22:3-6">ሉቃ. 22፥3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14"/>ቶነ ለሞንከ አሳባች መቱስ አስቆሮቶ ይሁድ ቂስ አዎንሳኖቤቹ መር <verse eid="MAT 26:14"/><verse number="15" style="v" sid="MAT 26:15"/>«አን ኢሰ ህግሽ ኣሴንክዕኔጎሬ መ ኣቴነዕኔ?» ዬእ፤ እሰን ሰጁ ጠገር ብረ ኣቶስ።<note caller="-" style="x"><char style="xo" closed="false">26፥15 </char><char style="xt" closed="false"><ref loc="ZEC 11:12">ዘካ. 11፥12</ref>።</char></note> <verse eid="MAT 26:15"/><verse number="16" style="v" sid="MAT 26:16"/>እስን ህከን ወክቲች ጀመር ኢሰ ህግሽ ኣሶተ መከኖ ወክት ሀሰኖት እቅ።<verse eid="MAT 26:16"/></para>
  <para style="s1">ኢስ ሻሽግ ሁርባት አሳባንተስን እቱስ</para>
  <para style="r">(<ref loc="MRK 14:12-21">ማር. 14፥12-21</ref>፤ <ref loc="LUK 22:7-14">ሉቃ. 22፥7-14</ref>፤ <ref loc="LUK 21:23">21፥23</ref>፤ <ref loc="JHN 13:21-30">ያህ. 13፥21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17"/>ጦሮሹ እቴነን ከበጄኖ ከበጃት ዎኔ በር አሳበት ኢስበ ሆንጠክ «ሻሽግ ሁርባት ሀከንቤቾን ቅጥአኖሄተ ሀሶንት?» ይት ጠዕምቶስ። <verse eid="MAT 26:17"/><verse number="18" style="v" sid="MAT 26:18"/>ኢስን «ከተመ መርቴን ‹አስተማርቹ ወክቱእ ኢሌቤቺሃ አሳባንተኤን ሻሽግ ከበጃት ሁርባት እታሚሁ ኪ ምኔንት የኖት› ይቴን ኩሌስ» ይ መቶ መንችቤቹ ሶኮ። <verse eid="MAT 26:18"/><verse number="19" style="v" sid="MAT 26:19"/>አሳበስን ኢስ አዘዦገን ሻሽግ ሁርባት ቅጥአቶኡ። <verse eid="MAT 26:19"/><verse number="20" style="v" sid="MAT 26:20"/>ኡለት ሀዎርቶ ወክት ኢስ አሳባንተስን ማዳን አፉዕሌእ። <verse eid="MAT 26:20"/><verse number="21" style="v" sid="MAT 26:21"/>እተንን «ሀንቅንከ ያንክዕኔ፤ ክዕኔች መቱ ኤሳሃ ህግሽ ኣሰኖ» ዬእ። <verse eid="MAT 26:21"/><verse number="22" style="v" sid="MAT 26:22"/>አሳበንት ህከን ጠወን አበ ሻዝ «ቀርቾ! ኤሳህትንዶ?» ይተን መት-መቱሰ ጠዕምቶኡ። <verse eid="MAT 26:22"/><verse number="23" style="v" sid="MAT 26:23"/>ኢስን ፈንቀሽ «ቴሱ ኢን ሜጡበ አንገስ ብጥራን ወረኖሁ ኤሳሃ ህግሽ ኣሰኖኤ።<note caller="-" style="x"><char style="xo" closed="false">26፥23 </char><char style="xt" closed="false"><ref loc="PSA 41:9">መዝ. 41፥9</ref>።</char></note> <verse eid="MAT 26:23"/><verse number="24" style="v" sid="MAT 26:24"/>መንች ቤቱ እስተኔሃ ከተበሞገን ሬሀኖ፤ ጠዉ እኮጎሬ መንች ቤቱ ህግሽ ኣሰኖ መንቺሃ ቆሀኖስ! ሁኩ መንቹ እለሞበእቃን ቆሀኖስ እቅ» ዬእ። <verse eid="MAT 26:24"/><verse number="25" style="v" sid="MAT 26:25"/>ህግሽ ኣሰኖ ይሁድን ፈንቀሽ «አስተማርቾ! ኤሳህትንዶ?» ዬእ፤ ኢስን ፈንቀሽ «አት ይቶንትጋንት» ዬስ።<verse eid="MAT 26:25"/></para>
  <para style="s1">ቀርች ሁርባት ሴረ</para>
  <para style="r">(<ref loc="MRK 14:22-26">ማር. 14፥22-26</ref>፤ <ref loc="LUK 22:15-20">ሉቃ. 22፥15-20</ref>፤ <ref loc="1CO 11:23-25">1 ቆሮ. 11፥23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26"/>እሰ እተንን ኢስ ዳቡተ ኬሽ ማሰዕይ ቢጭ አሳባተስ «ኩን ማላኤ፤ ኣእቴን እቼ» ይ ኣሴሰ። <verse eid="MAT 26:26"/><verse number="27" style="v" sid="MAT 26:27"/>ጠበቴሃ ኬሽ መገኑ ገለትጭ ዱአ አዕዮች ኤተሮን «ጉዕሙንኩክዕኔ ህከን ጠበቴች ኣጌ። <verse eid="MAT 26:27"/><verse number="28" style="v" sid="MAT 26:28"/>ልግብያ መን ጩቡ ፈቆተ ሃዕሮ ጉዲሃ ዱንተአኖሃ ቄጉሃኤ።<note caller="-" style="x"><char style="xo" closed="false">26፥28 </char><char style="xt" closed="false"><ref loc="EXO 24:8">ፉል. 24፥8</ref>፤ <ref loc="JER 31:31-34">ኤር. 31፥31-34</ref>።</char></note> <verse eid="MAT 26:28"/><verse number="29" style="v" sid="MAT 26:29"/>ሃዕሮ ወይነ አንኤ ዎምነቴን ክዕኔን ሜጡበ አጋም በሩ ኢለ ከን ወይን ላልቺን ዎሬማሃ ሆሮን አጋምበአ» ዬሰ። <verse eid="MAT 26:29"/><verse number="30" style="v" sid="MAT 26:30"/>ህከኒች ኤተሮን መዝሙረ ዘመርት ቆተ አል ፉልቶኡ። <figure style="fig" alt="Jesus eating last supper with disciples" file="LB00320B.tif" size="span" ref="26፥26">ኢስ ኣሳባንተስ እቾ መጨረሽ ሁርባት</figure><verse eid="MAT 26:30"/></para>
  <para style="s1">ኢስ ጴጥሮስ ለገአኖስገ ሄጭ ኩሉስ</para>
  <para style="r">(<ref loc="MRK 14:27-31">ማር. 14፥27-31</ref>፤ <ref loc="LUK 22:31-34">ሉቃ. 22፥31-34</ref>፤ <ref loc="JHN 13:36-38">ያህ. 13፥36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31"/>ህከ ወክት ኢስ «ከበሬ ሀንከዕርተ ጉዕሙንኩክዕኔ ኤሳሃ ለገኤነንተኤ፤ መሰንትስ ‹ዜማንቹ ዎቀራም፤ ዜሜ ሆለንት ብን ይታአ› የመም ከተበሞኡ።<note caller="-" style="x"><char style="xo" closed="false">26፥31 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">ዘካ. 13፥7</ref>።</char></note> <verse eid="MAT 26:31"/><verse number="32" style="v" sid="MAT 26:32"/>ጠዉ እኮጎሬ ሬሆች ኬዕዮሚች ኤተሮን ክዕኔተ ሄጭ ገሊለተ ኦሮኣም» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">26፥32 </char><char style="xt" closed="false"><ref loc="MAT 28:16">ማቶ. 28፥16</ref>።</char></note><verse eid="MAT 26:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33"/>ጴጥሮስ ፈንቀሽ «ዎሉ ጉዕሙንኩ ለገዕዮሄ ጎሬ አን ሆሮን ለገኣንኬበአ» ዬእ። <verse eid="MAT 26:33"/><verse number="34" style="v" sid="MAT 26:34"/>ኢስን «ሀንቅንከ ያንኬ፤ ከበሬ ሀንከዕርተ ሀንጠቦ ዎዱዕነ ሄጭት ኤሳሃ ሰሶረ ለገኣንቴኤ» ይ ፈንቀሼእ። <verse eid="MAT 26:34"/><verse number="35" style="v" sid="MAT 26:35"/>እኮጎሬ ጴጥሮስ ፈንቀሽ «ሆሮ ኪን ሜጡበ ሬሃምያ ጎሬ አን ሆሮን ኬሳሃ ለገኣንኬበአ» ዬእ፤ ፈቆ አሳበንት ህትን ይቶኡ።<verse eid="MAT 26:35"/></para>
  <para style="s1">ኢስ «ጌተሰማኔ» ዬኖቤቾን ዱአ አዕዮገ</para>
  <para style="r">(<ref loc="MRK 14:32-42">ማር. 14፥32-42</ref>፤ <ref loc="LUK 22:39-46">ሉቃ. 22፥39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36"/>ህከኒች ኤተሮን ኢስ አሳባንከስን ሜጡበ «ጌተሰማኔ» ዬኖ አቡረ ቤቹ ኦሮዕዮ፤ እሳንከ «አን ካጳ ኦሮዕይ ዱአ አኦተ ኢለ አዕኑ ከኔ አገሬ» ዬሰ። <verse eid="MAT 26:36"/><verse number="37" style="v" sid="MAT 26:37"/>እስን ጴጥሮሴለከ ዘብዶሴ ኦሱተ ኣእ ኦሮዕይ አበ ሻዥ ጨነቀመኖት እቅ። <verse eid="MAT 26:37"/><verse number="38" style="v" sid="MAT 26:38"/>ህትን «ሩህቹኤ ፉልቶተ ኢለ አበ ሻዦም፤ አዕኑ ከኔ አገሬ፤ ኢን ሜጡበ ጠረኝዬ» ዬሰ። <verse eid="MAT 26:38"/><verse number="39" style="v" sid="MAT 26:39"/>እሳች መቱ ጌሰ ቄዕር ኦሮዕዮች ኤተሮን ኡለ ኡብ ዱአ አአን «ኢ አነ! አታለመኖሄ ጎሬ ከ ኦርሸ ጠበትተ ኢች ህግስ፤ ጠዉ እኮጎሬ አን ሀሾምገ እሁዕነ አት ሀሶንትገ እሁን» ዬእ።<verse eid="MAT 26:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40"/>ህከኒች ኤተሮን ሰሶንከ አሳበቤቹ ፈንቀል አሜተኖ ወክት ግሶኢሃ ለዕይ ጴጥሮሴ «ኢን ሜጡበ መቶ ሳኣት ጌሰ አታሉ ሆጌንታእንዶ? <verse eid="MAT 26:40"/><verse number="41" style="v" sid="MAT 26:41"/>ፌተናን ኣጌነንተበእገ ጠረኝቴን ዱአ አዕዬ፤ መገን አያኑ ቅጥ ይዮኡ፤ ጠዉ እኮጎሬ ማሉ ላፈሃን» ዬእ።<verse eid="MAT 26:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42"/>ህትን ኢስ ለንክ ወክት ቀዉንከ ቄዕር ኦሮዕይ «ኢ አነ! ኩ ኦርሸ ጠበትተ አን አጉዕናን ህገኖበኢሃ እኮጎሬ አት ይቶንትገ እሁን» ይ ዱአ አዕዮ። <verse eid="MAT 26:42"/><verse number="43" style="v" sid="MAT 26:43"/>ህትን እስ ፈንቀል ኣሜተኖ ወክት እልሰ ግሰኛት ኬዕምታን ትርክም ይታኢት እቅ። <verse eid="MAT 26:43"/><verse number="44" style="v" sid="MAT 26:44"/>ህትን እሰንተ አጉር ኦሮዕይ ሰቅ ወክት ዎዕኔገን ይ ዱአ አዕዮ። <verse eid="MAT 26:44"/><verse number="45" style="v" sid="MAT 26:45"/>ህከኒች ኤተሮን አሳበስቤቹ አሜች «ቴሱ ግሴን ፎሎጭቴንታእትንዶ? ሁኩዕን! መንች ቤቱ ጩበኛኖ አንጋን ህግሴን ኣሴኖ ወክቱ ኢልዮኡ። <verse eid="MAT 26:45"/><verse number="46" style="v" sid="MAT 26:46"/>ኬዕዬ ኦሮዕኖ፤ ሁኩዕኑን ህግሽ ኣሰኖኤሁ ሆንጠኮኡ» ዬሰ።<verse eid="MAT 26:46"/></para>
  <para style="s1">ኢሰ አፌመገ</para>
  <para style="r">(<ref loc="MRK 14:43-50">ማር. 14፥43-50</ref>፤ <ref loc="LUK 22:47-53">ሉቃ. 22፥47-53</ref>፤ <ref loc="JHN 18:3-12">ያህ. 18፥3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47"/>ኢስ ጠወአንን ቶነ ለሞንከ አሳባች መቱ «ይሁደ» ዬኖሁ አሜቾ፤ እሲን ሜጡበ ቂስ አዎንሳኖችለከ ባድ ባልቃች ሶሄመ ልግቡ መኑ ሲፈለከ በርተ አፍ አሜቶኡ። <verse eid="MAT 26:47"/><verse number="48" style="v" sid="MAT 26:48"/>ኢሰ ህግሽ ኣሰኖ ይሁድን እሲን ሜጡበ አሜተኖ መኒሃ «አዕኑ አን ሱንቃንሲሃ እሱ አፌ» ይ መላተ ኩሎሰ እቅ።<verse eid="MAT 26:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49"/>እስን ህከ ወክት ኢስበ ሆንጠክ «አስተማርቾ! ወገሬቴ!» ይ ሱንቄስ። <verse eid="MAT 26:49"/><verse number="50" style="v" sid="MAT 26:50"/>ኢስን «ኢ ጃለ! አሜቶንት ሰውትክ ዊንሽ» ዬስ፤ ህከኒች ኤተሮን መኑ ኢስበ ሆንጠክ አፎስ። <verse eid="MAT 26:50"/><verse number="51" style="v" sid="MAT 26:51"/>ህከ ወክት ኢሲን ሜጡበ ዮሀኑኡች መቱስ ሲፋ ፉሽ ቂስ አዎንሳንች ካዲንች መጨተ ሙሮ። <verse eid="MAT 26:51"/><verse number="52" style="v" sid="MAT 26:52"/>ኢስን «ብሰክ ኮቦን ዎር፤ ብሰ ኬሳሩ ጉዕሙንኩ ብሲን በኣአ። <verse eid="MAT 26:52"/><verse number="53" style="v" sid="MAT 26:53"/>አን አነኤ ኡጭያን እስ ቶነ ለሞ ጎጎት<note caller="+" style="f"><char style="fqa" closed="false">ጎጎተ፦ </char><char style="ft" closed="false">ዩ ሮም መንግስት ወክት መቱ ጎጎቱ ሌሆ ኩሜ ዎታደር ጌሰ እሀኖ።</char></note> መላይካተ ሶሆተ አታልባሃ አጉደኖሄንዶ? <verse eid="MAT 26:53"/><verse number="54" style="v" sid="MAT 26:54"/>ህካን እኮች ከ ጠወ ጉዕመንከ ቶጉ ሀስሰኖ የኖ መጻፋን ከተቤመ ላገት ሀት እክ ዊንቶተ አታልታአ?» ዬእ።<verse eid="MAT 26:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55"/>ህከ ወክት ኢስ ህከኔ ሄዕዮ ኡመቲሃ «ሽፍጠ አፌነንተሀንገ ብሰለከ በርተ አፌን አፎኖኤተ አሜቴንንዶ? ጉዕመ ወክት መገን ምኔን አፉዕል ተማርሰን አፌንታኤበአ እቅ።<note caller="-" style="x"><char style="xo" closed="false">26፥55 </char><char style="xt" closed="false"><ref loc="LUK 19:47">ሉቃ. 19፥47</ref>፤ <ref loc="LUK 21:37">21፥37</ref>።</char></note> <verse eid="MAT 26:55"/><verse number="56" style="v" sid="MAT 26:56"/>ጠዉ እኮጎሬ ሁኩን ጉዕሙንኩ እኮሁ ነብያኖ መጻፋን የመሞ ጠዉ ዊሞታት» ዬእ፤ ህከ ወክት አሳበስ ጉዕሙንኩ ጌኝአት ሁንቶኡ።<verse eid="MAT 26:56"/></para>
  <para style="s1">ኢሰ ፍርድ ዳኛኖበ መሴመስገ</para>
  <para style="r">(<ref loc="MRK 14:53-65">ማር. 14፥53-65</ref>፤ <ref loc="LUK 22:54-55">ሉቃ. 22፥54-55</ref>፤ <ref loc="JHN 18:13-14">ያህ. 18፥13-14</ref>፤ <ref loc="JHN 19:24">19፥24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57"/>ህከኒች ኤተሮን ኢሰ አፎ መኑ ሕግ አስተማረትለከ ባድ ባልቁ ጭምይታቤቹ ኣእት ሎረ ቂስች ቀያፍበ መስቶኡ። <verse eid="MAT 26:57"/><verse number="58" style="v" sid="MAT 26:58"/>ጠዉ እኮጎሬ ጴጥሮስ ሎረ ቂስች ግቤ ኣዝ ኢለ ቄዕራሻን አዎነኖት እቅ፤ ጠወስ መጨረሸ ኢለ ለኦተ ግቤ ኣዜን ካዲማንን ሜጡበ አፉዕሌእ። <verse eid="MAT 26:58"/><verse number="59" style="v" sid="MAT 26:59"/>ቂስ አዎንሳኑትለከ አይሁድ ኦገት ዳኛኑት ጉዕሙንኩ ኢሰ ሽሲሶተ ክዝብ ጠወ አሌስ ሀሳኢት እቅ። <verse eid="MAT 26:59"/><verse number="60" style="v" sid="MAT 26:60"/>ሄንከሃ ክዝብ ምስክሩ ሆንጠሁን ቤሉ ሬሁተ ፈረድሲሰኖ ጠወሃ ደጎስበአ፤ ጠዉ እኮጎሬ መጨረሽ ለሙ ክዝብ ምስክሩ ሆንጠክ <verse eid="MAT 26:60"/><verse number="61" style="v" sid="MAT 26:61"/>«ኩ መንቹ ‹አን ዱእ ምኒ ድጅ ሰሶ በሬን እጃራም› ይዮኡ» ይቶኡ።<note caller="-" style="x"><char style="xo" closed="false">26፥61 </char><char style="xt" closed="false"><ref loc="JHN 2:19">ያህ. 2፥19</ref>።</char></note><verse eid="MAT 26:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62"/>ሎሩ ቂስቹ ኬዕይ «ኩ መኑ አሌክ መሰከሮ ጠዊሃ ፈንቀሽታንትሁ መቱርቹሁ ዮሄበእንዶ?» ዬስ። <verse eid="MAT 26:62"/><verse number="63" style="v" sid="MAT 26:63"/>ጠዉ እኮጎሬ ኢስ መቱርቹሃ ይዮበአ፤ ሎሩ ቂስቹ ኢሰ «መሲህ<note caller="+" style="f"><char style="fqa" closed="false">መሲህ፦ </char><char style="ft" closed="false">ዩ ግሪክ አፎን ቡረሞሃ ዩ እሀን አይሁድ መኑ አሜተኖ ይተን አገርታስሃን።</char></note> መገን ቤቱ እኮንትጎሬ ሄአኖ መገኖን መገኝዮንኬ ኩልኔ» ዬእ። <verse eid="MAT 26:63"/><verse number="64" style="v" sid="MAT 26:64"/>ኢስን ሎረ ቂስቹ «አት ይቶንትጋንት፤ አን ኩሎንክዕኔ መንች ቤቱ መገን መኬ አዲን አፉዕልሃን ለኤነንተ፤ ህትን ሰሜ ጎማን አሜተን ለኤነንተ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">26፥64 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳን. 7፥13</ref>።</char></note> <verse eid="MAT 26:64"/><verse number="65" style="v" sid="MAT 26:65"/>ህከ ወክት ቂስ አዎንሳንቹ ኦድኑስ ፊል «መገኑ ቦሮሮኡ፤ ከኒች ኤተሮን ም ምስክሩ ሀስሰኖ? መገኑ ቦሮሩስ አዕኑ ሞጮጭቴንታአ። <verse eid="MAT 26:65"/><verse number="66" style="v" sid="MAT 26:66"/>ቴሱ መ አጉደኖህዕኔት?» ዬእ፤ እሰን «ሬሁት ገበኣስ» ይት ፈንቀሽቶኡ።<note caller="-" style="x"><char style="xo" closed="false">26፥66 </char><char style="xt" closed="false"><ref loc="LEV 24:16">ሌዌ 24፥16</ref>።</char></note><verse eid="MAT 26:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67"/>ህከ ወክት ኢስ አሌን አንጀ ቱይቶኡ፤ ጡንጤንን ዎቀርቶኡ፤ ህትን መጨለ ዎቀርተን፥ <verse eid="MAT 26:67"/><verse number="68" style="v" sid="MAT 26:68"/>«መሲህ! ህንዴ አይ ዎቀሮሄ ጎሬ ራገ ጠወእ» ይታስ እቅ።<verse eid="MAT 26:68"/></para>
  <para style="s1">ጴጥሮስ ኢሰ ለገዕዮገ</para>
  <para style="r">(<ref loc="MRK 14:66-72">ማር. 14፥66-72</ref>፤ <ref loc="LUK 22:56-62">ሉቃ. 22፥56-62</ref>፤ ያህ. 18፥15‐18፥25‐27።)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69"/>ጴጥሮስ ሎረ ቂስች ምኒች አብሌን ግቤ ኣዜን አፉዕሌሀኔን መት ገረድቹት እስበ ሆንጠክ «አት ገሊለ ኢስን ሜጡበ ሄኦንት» ይቶኡ። <verse eid="MAT 26:69"/><verse number="70" style="v" sid="MAT 26:70"/>ጠዉ እኮጎሬ እስ «አት ይታንቲሁ አዬት ጎሬ ደጋምበአ» ይ ጉዕምሰ ብሬንን ለገዕዮ። <verse eid="MAT 26:70"/><verse number="71" style="v" sid="MAT 26:71"/>ጴጥሮስ ፉሎተ ብትምቤቹ ሆንጠኮሀኔን ገረድቹት ለእ ህከኔ ሄዕዮ መኒሃ «ኩ መንቹ ናዝሬት ኢስን ሜጡበ ሄዕዮሃን» ይቶኡ። <verse eid="MAT 26:71"/><verse number="72" style="v" sid="MAT 26:72"/>ጴጥሮስ ለንኪሃ ጤሌዕለን «አት ይታንት መንቹ ደጋምበአ» ይ ለገዕዮ። <verse eid="MAT 26:72"/><verse number="73" style="v" sid="MAT 26:73"/>ቀዎ ወክቲች ኤተሮን ህከኔ ኡርቶ መኑ እስበ ሆንጠክ «ጠወኣንትጉ ለሊሰኖት፤ ሀንቅንከ አት እሳች መቶሃስ» ይቶኡ። <verse eid="MAT 26:73"/><verse number="74" style="v" sid="MAT 26:74"/>ጴጥሮስን «አን ከ መንቹ ደጋምበአ» የን ገዉስ ቦሮዕሩሃ ጤሌዕሉሃ ጀመሮ፤ ወክትንከስ ሀንጠቦ ዎጆ።<verse eid="MAT 26:74"/></para>
  <para style="p">
    <verse number="75" style="v" sid="MAT 26:75"/>ጴጥሮስን ኢስ «ሀንጠቦ ዎዱዕነ ሰሶረ ለገኣንቴኤ» ዬ ላገተ ሰውይ አብል ፉል ቡብ ኦዕዮ።<verse eid="MAT 26:75"/></para>
  <chapter eid="MAT 26"/>
  <chapter number="27" style="c" sid="MAT 27"/>
  <para style="s1">ኢሰ ጵላጦሴበ መሴመገ</para>
  <para style="r">(<ref loc="MRK 15:1">ማር. 15፥1</ref>፤ <ref loc="LUK 23:1-2">ሉቃ. 23፥1-2</ref>፤ <ref loc="JHN 18:28-32">ያህ. 18፥28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1"/>ኡለት ሶዞ ወክት ቂስ አዎንሳኑትለከ ኡመት ባልቁ ጉዕሙንኩ ኢሰ ሽቶተ አማዕለንቶኡ። <verse eid="MAT 27:1"/><verse number="2" style="v" sid="MAT 27:2"/>ሀከኒች ኤተሮን ኢሰ ኡሱርት መስት ሮም ባድ ገሻንች ጵላጦሴቤቹ ህግስ ኣቶኡ።<verse eid="MAT 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3"/>ህከ ወክት ኢሰ ህግሽ ኣሴ ይሁድ ኢስ አሌን ሬሆ ፍርደ ፈረዴማሃ ለዕዮ ወክት አበ ሰጭ ሰጁ ጠገር ብረ ቂስ አዎንሳኖተለከ ባድ ባልቃተ ፈንቀሽ ኤብ ኣሴእ። <verse eid="MAT 27:3"/><verse number="4" style="v" sid="MAT 27:4"/>«ፈየ መንቹ ሬሆተ ህግሽ ኣሴምቤቺሃ አን ቤሾም» ዬእ፤ ጠዉ እኮጎሬ «ኔሳሃ ም ኦርሾኔ፤ አት ገዉክ ሹል» ይቶኡ። <verse eid="MAT 27:4"/><verse number="5" style="v" sid="MAT 27:5"/>ይሁድን ሰጁ ብረንከ መገን ምኔን ብንአዕይ ፉል ለንገቅ ሬዮ።<verse eid="MAT 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6"/>እኮጎሬ ቂስ አዎንሳኑት ብረስ ኬስ «ኩ ብሩ ቄግ ብረ እኮቤቺሃ ዱእ ምኒ ብራን ሜጡበ አኡ ሀስሰኖበአ» ይቶኡ። <verse eid="MAT 27:6"/><verse number="7" style="v" sid="MAT 27:7"/>ህካን አማዕለንቶች ኤተሮን ኮሀ እክ አሜች ሬዮ መነ ሞጎተ ፉግቺች ኡለተ ህዕርቶኡ። <verse eid="MAT 27:7"/><verse number="8" style="v" sid="MAT 27:8"/>ህካን እኮቤቺሃ ህተ ኡለተ ከበሬ ኢለ «ቄግ ኡለተ» ዬነን ገኤኖ።<note caller="-" style="x"><char style="xo" closed="false">27፥8 </char><char style="xt" closed="false"><ref loc="ACT 1:18-19">ሶቀ. 1፥18-19</ref>።</char></note><verse eid="MAT 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9"/>ህከን ሃሌን «እስራኤል ኦሱት ‹ሄንከ ፉሸኖ› ይት ገመቶ ዋገ ሰጁ ጠገር ብረ ኣእቶኡ፤ <verse eid="MAT 27:9"/><verse number="10" style="v" sid="MAT 27:10"/>ቀርቹ አዘዦኤገን ፉግቺች ኡለተ ህዕሬመ» የመም ነብዬቾ ኤርምያሴን ጠወአሞ ራጉ ዊሞ።<note caller="-" style="x"><char style="xo" closed="false">27፥10 </char><char style="xt" closed="false"><ref loc="ZEC 11:12-13">ዘካ. 11፥12-13</ref>፤ <ref loc="JER 32:6-15">ኤር. 32፥6-15</ref>።</char></note><verse eid="MAT 27:10"/></para>
  <para style="s1">ጵላጦስ ኢሰ ጠዕሜገ</para>
  <para style="r">(<ref loc="MRK 15:2-5">ማር. 15፥2-5</ref>፤ <ref loc="LUK 23:3-5">ሉቃ. 23፥3-5</ref>፤ <ref loc="JHN 18:33-38">ያህ. 18፥33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11"/>ህከ ወክት ኢሰ ገሻንች ቤቹ ኤቤመ፤ ገሻንቹንኩ «አት አይሁድየ ዎመንዶ?» ይ ጠዕሜእ፤ ኢስን «አት ይቶንትጋት» ይ ፈንቀሼእ። <verse eid="MAT 27:11"/><verse number="12" style="v" sid="MAT 27:12"/>ጠዉ እኮጎሬ ቂስ አዎንሳኑትለከ ባድ ባልቁ ኦዶስ ወክት መቱ ጠወሃ ፈንቀሽዮበአ። <verse eid="MAT 27:12"/><verse number="13" style="v" sid="MAT 27:13"/>ህከኒች ኤተሮን ጵላጦስ «ኩ መኑ ኬንከ ኦዳሄ ጠወ ሞጮጭታንትበእንዶ?» ዬስ። <verse eid="MAT 27:13"/><verse number="14" style="v" sid="MAT 27:14"/>እኮጎሬ ኢስ ገሻንቹ አበ አጀብሲጮተ ኢለ መቱ መስለሃ ፈንቀሽዮበአ።<verse eid="MAT 27:14"/></para>
  <para style="s1">ኢስ አሌን ሬሆ ፍርደ ፈረዴመገ</para>
  <para style="r">(<ref loc="MRK 15:6-15">ማር. 15፥6-15</ref>፤ <ref loc="LUK 23:13-25">ሉቃ. 23፥13-25</ref>፤ <ref loc="JHN 18:39-40">ያህ. 18፥39-40</ref>፤ <ref loc="JHN 19:1-16">19፥1-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15"/>ሻሽግ ከበጃት ወክት መኑ መጠሮ መቱ መንቹ ኡሱሮች ሂር ገፈረኖ ሮሸት ገሻንቾ ጵላጦሴሃ ሄኦስ እቅ። <verse eid="MAT 27:15"/><verse number="16" style="v" sid="MAT 27:16"/>ህከ ወክት «ባርባኔ»<note caller="+" style="f"><char style="fqa" closed="false">ልግቡ ክታበት ባርባኔ የኖሃ፦ </char><char style="ft" closed="false">ኢስ ባርባሴት ይታአ።</char></note> ዬኖ ለልዮኢሁ ኡሱር ምኔን ሄዕዮ እቅ። <verse eid="MAT 27:16"/><verse number="17" style="v" sid="MAT 27:17"/>መኑ ጭምዬ ወክት ጵላጦስ «አዬ ሂሮህዕኔተ ሀሴነን? ባርባኔይትንዶ መሲህ የመሞሃ ኢሰ?» ይ ጠዕሜሰ። <verse eid="MAT 27:17"/><verse number="18" style="v" sid="MAT 27:18"/>ጵላጦስ ህካን ዮተ አታሎሁ ኢሰ ጢቄን ህግስ ኣቶገ ደገኖቤቺሃት እቅ። <verse eid="MAT 27:18"/><verse number="19" style="v" sid="MAT 27:19"/>ጵላጦስ ፍርድ ቦርጭማን አፉዕሌሀኔን ጫስ «ከን ነጠ መንች አሌን መቱርቹሃ አቶት፤ አን እስ መሳን ሀንከዕርተ ሀቄንተኤ አበ ጨነቀመን ገሎምንተገ» ይት ሶኮኡ። <verse eid="MAT 27:19"/><verse number="20" style="v" sid="MAT 27:20"/>ህከ ወክት ቂስ አዎንሳኑትለከ ባድ ባልቀት መኑ ጵላጦሴ ባርባኔ ሂር ኢሰ ሾን ይተን ኡጭታገ አቶኡ። <verse eid="MAT 27:20"/><verse number="21" style="v" sid="MAT 27:21"/>ገሻንቹንኩ «ከን ለሞንከ መንቺች ሀካንስ ሂሮህዕኔተ ሀሴነን?» ይ ጠዕሜሰ፤ እሰን «ባርባኔ ሂርኔ» ይት ፈንቀሽቶኡ። <verse eid="MAT 27:21"/><verse number="22" style="v" sid="MAT 27:22"/>ጵላጦስን «መሲህ የመሞ ኢሰ መ አኡ?» ዬሰ፤ ጉዕሙንኩሰ «ሰቀሎን» ይቶኡ። <verse eid="MAT 27:22"/><verse number="23" style="v" sid="MAT 27:23"/>ገሻንቹንኩ «ሚሃት? እስ አዕዮ ሂሉ ጠዉ መርቹሃን?» ዬእ፤ እሰን «ሰቀለሙን» ይት በትስ ጨንጭቶኡ። <verse eid="MAT 27:23"/><verse number="24" style="v" sid="MAT 27:24"/>ጵላጦስን ኩ ጠዉ ብተተ ኬስ ቤሉ መቱርቹሃ ደግለለኖበእገ ለዕዮ ወክት ጉዕማንከ ኡመት ብሬን ዋሃ ኤብሲሽ አንገስ ኣዕለን «አን ከን መንች ቄጊች ነጠሃን፤ አዕኑን ሹዕልዬ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">27፥24 </char><char style="xt" closed="false"><ref loc="DEU 21:6-9">ዘዳ. 21፥6-9</ref>።</char></note><verse eid="MAT 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25"/>ኡመቱ ጉዕሙንኩ «ቄጉስ ኒለከ እለኔ አሌን እሁን» ይቶኡ።<verse eid="MAT 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26"/>ህከ ወክት ጵላጦስ ባርባኔ ሂር ገፈሮ፤ እኮጎሬ ኢሰ ኦልሲሾች ኤተሮን ሰቀሎኖተ ህግሽ ኣሴእ።<verse eid="MAT 27:26"/></para>
  <para style="s1">ዎታደሩ ኢስ አሌን ቀለዶገ</para>
  <para style="r">(<ref loc="MRK 15:16-20">ማር. 15፥16-20</ref>፤ <ref loc="JHN 19:2-3">ያህ. 19፥2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27"/>ሮም ዎታደሩ ኢሰ ጵላጦሴ ግብተ መስቶኡ፤ ህትን ዎታደረ ጉዕመንከ ኢስ መዴን ጭምአቶኡ። <verse eid="MAT 27:27"/><verse number="28" style="v" sid="MAT 27:28"/>ኦድኑስ ኣእት ብሸ ኦድኑተ ኦድሶኡ። <verse eid="MAT 27:28"/><verse number="29" style="v" sid="MAT 27:29"/>ኡት አክሊለ መክስ ቡዕለስ ዎርት መኬስ አንጋን ሾምቦቁተ አፍሲሶስች ኤተሮን ብሬስ ሰገደን «አይሁድ ዎመ! ወገሬቱ ኬሳሃ እሁን!» ይተን ቀለዳሲት እቅ። <verse eid="MAT 27:29"/><verse number="30" style="v" sid="MAT 27:30"/>አሌስ አንጀ ቱይተን አንጋችስ ሾምቦቁተ ኣእት ቡዕለስ ዎቀርታኢት እቅ። <verse eid="MAT 27:30"/><verse number="31" style="v" sid="MAT 27:31"/>ቀለዶሲች ኤተሮን ብሸ ኦድኑተ ፉሽት ገይስ ኦድኑተ ኦድስ ሰቀልቶተ ኣእት መርቶኡ።<verse eid="MAT 27:31"/></para>
  <para style="s1">ኢሰ ሰቀሌመገ</para>
  <para style="r">(<ref loc="MRK 15:21-32">ማር. 15፥21-32</ref>፤ <ref loc="LUK 23:26-43">ሉቃ. 23፥26-43</ref>፤ <ref loc="JHN 19:17-27">ያህ. 19፥17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32"/>ገሻንች ግቤች ፉልተን «ስሞኔ» ዬኖ ቀሬን ባድ መንቺን ደቀንት ኢስ መስቀለ ግዳን እጅሲሶኡ። <verse eid="MAT 27:32"/><verse number="33" style="v" sid="MAT 27:33"/>እሰን «ጎልጎተ» ዬኖቤቹ ኢልቶኡ፤ «ጎልጎተ» ዩ «ቡዕል ቁሌ ቤቹ» ዩሃን። <verse eid="MAT 27:33"/><verse number="34" style="v" sid="MAT 27:34"/>ህከኔን ደምብቹ ልቃለቀሞ ዎይን ጠጀ አጎተ ኢሲሃ ኣቶኡ፤ እኮጎሬ እስ ቀመሽ ለዕይ አጉ ግቦ።<note caller="-" style="x"><char style="xo" closed="false">27፥34 </char><char style="xt" closed="false"><ref loc="PSA 69:21">መዝ. 69፥21</ref>።</char></note> <verse eid="MAT 27:34"/><verse number="35" style="v" sid="MAT 27:35"/>ኢሰ ሰቀልቶች ኤተሮን ኦድኑስ እጠ ኡጅት ቤቀንቶኡ።<note caller="-" style="x"><char style="xo" closed="false">27፥35 </char><char style="xt" closed="false"><ref loc="PSA 22:18">መዝ. 22፥18</ref>።</char></note> <verse eid="MAT 27:35"/><verse number="36" style="v" sid="MAT 27:36"/>እሰን ህከኔ አፉዕልት አገርታሲት እቅ። <verse eid="MAT 27:36"/><verse number="37" style="v" sid="MAT 27:37"/>«ኩን አይሁድየ ዎመ ኢሳት» ዬኖ ከሰሶ ጠወ ከተብ ቡዕልስ አሌ አዲን አፉሽቶኡ። <verse eid="MAT 27:37"/><verse number="38" style="v" sid="MAT 27:38"/>ኢሲን ሜጡበ ለሙ ወንበድት መቱስ መኬ አዲን መቱስ ጉረ አዲን ሰቀለንቶ እቅ።<verse eid="MAT 27:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39"/>መዲንከስ ህጋ መኑ ህንቅ ቡዕለሰ ሌንቀቅሰን<note caller="-" style="x"><char style="xo" closed="false">27፥39 </char><char style="xt" closed="false"><ref loc="PSA 22:7">መዝ. 22፥7</ref>፤ <ref loc="PSA 109:25">109፥25</ref>።</char></note> <verse eid="MAT 27:39"/><verse number="40" style="v" sid="MAT 27:40"/>«አት ዱእ ምኒ ድጅት ሰቅ በር እጃርታንቲሁ ህንዴ ገዉክ ጡምስ፤ መገን ቤቱ እኮንትጎሬ ህንዴ መስቀሊች ድር» ይተን ቀለዳሲት እቅ።<note caller="-" style="x"><char style="xo" closed="false">27፥40 </char><char style="xt" closed="false"><ref loc="MAT 26:61">ማቶ. 26፥61</ref>፤ <ref loc="JHN 2:19">ያህ. 2፥19</ref>።</char></note><verse eid="MAT 27:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41"/>ህትን ቂስ አዎንሳኑት፥ ሕግ አስተማረትለከ ባድ ባልቀት ቀለደን <verse eid="MAT 27:41"/><verse number="42" style="v" sid="MAT 27:42"/>«ዎሉ መነ ፌሾ፤ ጠዉ እኮጎሬ ገዉስ ጡምሶተ አታሎበአ፤ እስ እስራኤል ዎመ እኮጎሬ ህንዴ መስቀሊች ድሩን፤ ነኡሁ አመዕንናም። <verse eid="MAT 27:42"/><verse number="43" style="v" sid="MAT 27:43"/>‹አን መገንየ ቤቱ› ይ መገኖን አመዕንዮኡ፤ ህካን እኮቤቺሃ መገኑ እሱ እትዮስጎሬ ህንዴ ቴሱ ፌሱንስ» ይቶኡ።<note caller="-" style="x"><char style="xo" closed="false">27፥43 </char><char style="xt" closed="false"><ref loc="PSA 22:8">መዝ. 22፥8</ref>።</char></note> <verse eid="MAT 27:43"/><verse number="44" style="v" sid="MAT 27:44"/>ህትን እሲን ሜጡበ ሰቀለንቶ ዎንበድት ህትን ይተን ቦሮርታሲት እቅ።<verse eid="MAT 27:44"/></para>
  <para style="s1">ኢስ ሬዮገ</para>
  <para style="r">(<ref loc="MRK 15:33-41">ማር. 15፥33-41</ref>፤ <ref loc="LUK 23:44-49">ሉቃ. 23፥44-49</ref>፤ <ref loc="JHN 19:28-30">ያህ. 19፥28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45"/>ሌሆ ሰኣቲች ኬሽ ሆንሱ ሰኣት ኢለ ኡለት ቱንስቹ እኮኡ። <verse eid="MAT 27:45"/><verse number="46" style="v" sid="MAT 27:46"/>ሆንሶ ሰኣት ጌሳን ኢስ ሎረ ላጋን «ኤሎሄ! ኤሎሄ! ላማ ሰበቅታኒ?» ይ ያሮ፤ ህት ዩ «ኢ መገኖ! ኢ መገኖ! ሚሃ አጉርቴኤ?» ዩሃን።<note caller="-" style="x"><char style="xo" closed="false">27፥46 </char><char style="xt" closed="false"><ref loc="PSA 22:1">መዝ. 22፥1</ref>።</char></note> <verse eid="MAT 27:46"/><verse number="47" style="v" sid="MAT 27:47"/>ህከኔ ኡርቶ መኒች መት-መቱ መኑ ህካን ሞጮጭት «ኩ መንቹ እልያሴ ገአኖት» ይቶኡ። <verse eid="MAT 27:47"/><verse number="48" style="v" sid="MAT 27:48"/>ህከ ወክት እሳች መቱ ደጉጅ ሆለጮ ወይነ ጥጢን ጬፍ ሾምቦቆን አዕይ ኢስ አጎተ አፌስበ ሽቅ አዕዮ።<note caller="-" style="x"><char style="xo" closed="false">27፥48 </char><char style="xt" closed="false"><ref loc="PSA 69:21">መዝ. 69፥21</ref>።</char></note> <verse eid="MAT 27:48"/><verse number="49" style="v" sid="MAT 27:49"/>ዎሉሰ «አገር ህንዴ እልያስ አሜች ፌሰኖስ ጎሬ ለዕናም» ይቶኡ። <verse eid="MAT 27:49"/><verse number="50" style="v" sid="MAT 27:50"/>ኢስ ለንኪሃ ሎረ ላጋን ያር ነብሳስ ህግሽ ኣሴእ። <verse eid="MAT 27:50"/><verse number="51" style="v" sid="MAT 27:51"/>መገን ምኔን ሰቀሌመ መጋረጁ አሊች ኡለተ ኢለ ለሙ አደ እክ ፊልተዕዮ፤ ኡለት ሌንቄቅቶኡ፤ ክኑንኩ ጦጭ ፊልተዕዮ። <verse eid="MAT 27:51"/><verse number="52" style="v" sid="MAT 27:52"/>ህትን ሎዱ ፈንተዕያን ዎዕነ ሬቶ ጠሊለ መኒች ልግቡሰ ሬሆች ኬኦኡ። <verse eid="MAT 27:52"/><verse number="53" style="v" sid="MAT 27:53"/>እሰን ሎዲች ፉልት ኢስ ሬሆች ኬዕዮች ኤተሮን ዬሩሳሌም ከተመ ኣግ ልግብየ መኒሃ ለልቶኡ። <verse eid="MAT 27:53"/><verse number="54" style="v" sid="MAT 27:54"/>ጥቤ ሀለቁለከ እሲን ሜጡበ ኢሰ አገርተን ሄኦ መኑ ኡለት ሌንቄቁለከ እኮስ ጠወ ጉዕመንከ ለኦ ወክት አበ ዋጅት «ሀንቅንከ ኩን መገንያ ቤቱ እቅ» ይቶኡ። <verse eid="MAT 27:54"/><verse number="55" style="v" sid="MAT 27:55"/>ህከኔን ልግቡ ሜንቱ ቄዕራሻን ኡርት ለኣኢት እቅ፤ እሰን ገሊላች ጀመርት ኢሰ ሀዕልተን አዎንተን ሄኦእረ። <verse eid="MAT 27:55"/><verse number="56" style="v" sid="MAT 27:56"/>ህከን ሜንቲን ሜጡበ መግደል ከተም መርየመ፥ ያቁብለከ ዩሱፍ አመት መርየመለከ ዘብዶሴ ኦሶ አመት ሄኦ እቅ።<note caller="-" style="x"><char style="xo" closed="false">27፥56 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">ሉቃ. 8፥2-3</ref>።</char></note><verse eid="MAT 27:56"/></para>
  <para style="s1">ኢስ ሞገሙስ</para>
  <para style="r">(<ref loc="MRK 15:42-47">ማር. 15፥42-47</ref>፤ <ref loc="LUK 23:50-56">ሉቃ. 23፥50-56</ref>፤ <ref loc="JHN 19:38-42">ያህ. 19፥38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57"/>ኡለት ሀዎርቶ ወክት አርማትይ ከተም «ዩሱፈ» ዬኖ መቱ ቀባጣሙ መንቹ ህከ ቤቹ አሜቾ፤ እስን ኢስየ አሳቤቹ እቅ። <verse eid="MAT 27:57"/><verse number="58" style="v" sid="MAT 27:58"/>ሁኩ መንቹ ኢስ ጀናዘተ ኣሶስተ ጵላጦሴ ኡጬሃን ኣሶኖስተ አዘዦ። <verse eid="MAT 27:58"/><verse number="59" style="v" sid="MAT 27:59"/>ዩሱፍ ኢስ ጀናዘተ ኣእ ነጠ ጥጥ ጋቤን ከፈኝ <verse eid="MAT 27:59"/><verse number="60" style="v" sid="MAT 27:60"/>ገይሃስ ክኒች መክሾ ሃዕሮ ሎድ ኣዜን ኢስ ጀናዘተ አፉሽ ሎድስ አፎን ሎረ ክኑ ኮሎንኮዕልሽ ጡፎች ኤተሮን ኦሮዕዮ። <verse eid="MAT 27:60"/><verse number="61" style="v" sid="MAT 27:61"/>ህከኔን መግደል ከተም መርየመለከ ዎልት መርየመ ሎድ ብሬን አፉዕልቶ እቅ።<verse eid="MAT 27:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62"/>ህከ ለንክ ፎሎጭ በር ቂስ አዎንሳኑትለከ ፈርሳውት ሜጡበ ጵላጦሴቤቹ መርት <verse eid="MAT 27:62"/><verse number="63" style="v" sid="MAT 27:63"/>«ቀርቾ! ሁኩ ሉሲሰኖሁ ሬሁዕናን ሄጭ ‹ሰሶ በሬች ኤተሮን ሬሆች ኬኣም› ዬ ጠዉ ቃገሞኔ።<note caller="-" style="x"><char style="xo" closed="false">27፥63 </char><char style="xt" closed="false"><ref loc="MAT 16:21">ማቶ. 16፥21</ref>፤ <ref loc="MAT 17:23">17፥23</ref>፤ <ref loc="MAT 20:19">20፥19</ref>፤ <ref loc="MRK 8:31">ማር. 8፥31</ref>፤ <ref loc="MRK 9:31">9፥31</ref>፤ <ref loc="MRK 10:33-34">10፥33-34</ref>፤ <ref loc="LUK 9:22">ሉቃ. 9፥22</ref>፤ <ref loc="LUK 18:31-33">18፥31-33</ref>።</char></note> <verse eid="MAT 27:63"/><verse number="64" style="v" sid="MAT 27:64"/>ህካን እኮቤቺሃ ኢስ አሳበት መርት ሞግታበእገ ሬሆች ኬዕዮኡ ይት መኒሃ ኩልታበእገ ሎደስ ሰቅ በር ኢለ አገርታገ አዘዝ፤ ህካን እህባች ወኔስ ሉጨንሺች ኤተርስ ሉጨንሹ ባሾሃ እሀኖ» ይቶኡ። <verse eid="MAT 27:64"/><verse number="65" style="v" sid="MAT 27:65"/>ጵላጦስ «አገርታ ዎታደሩ ዮህዕኔ፤ መርቴን ደጌነንተ ሃሌን አገርሲሼ» ዬሰ። <verse eid="MAT 27:65"/><verse number="66" style="v" sid="MAT 27:66"/>ህካን እኮቤቺሃ እሰ ሎድበ መርት ሎድ አፎን ዮ ክኖን ማተቢን አሸግ ዎታደሪን አገርሲሶኡ።<verse eid="MAT 27:66"/></para>
  <chapter eid="MAT 27"/>
  <chapter number="28" style="c" sid="MAT 28"/>
  <para style="s1">ኢስ ሬሆች ኬዕዮገ</para>
  <para style="r">(<ref loc="MRK 16:1-10">ማር. 16፥1-10</ref>፤ <ref loc="LUK 24:1-12">ሉቃ. 24፥1-12</ref>፤ <ref loc="JHN 20:1-10">ያህ. 20፥1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1"/>አበ በሩ<note caller="+" style="f"><char style="fqa" closed="false">ፎሎጭ በሩ፦ </char><char style="ft" closed="false">የኖሁ ከንቤቾን ፎሎጭ በር የመሞሁ ሆፍቹታት።</char></note> ህጎች ኤተሮን ሳምንትስ ዎኔ በሬን ኡለት ሶዘን መግደል ከተም መርየመለከ ዎልት መርየመ ሎደ ለኦተ መርቶኡ። <verse eid="MAT 28:1"/><verse number="2" style="v" sid="MAT 28:2"/>ህከ ወክት አቡ ኡለ ሌንቄቁ እኮ፤ ቀርች መላይኬቹ ሰሜች አሜች ሎድ ኡሩተ ጡፌመ ክኑ ፈኝ ጎንብሽ አሌስ አፉዕሌእ። <verse eid="MAT 28:2"/><verse number="3" style="v" sid="MAT 28:3"/>መላይኬችስ ክልቀቱ ጉገኛገ ዮእሃ እቅ፤ ኦድኑስ በረድገ ዋጁተ እቅ። <verse eid="MAT 28:3"/><verse number="4" style="v" sid="MAT 28:4"/>አገርታሩንኩ መላይኬቹ ዋጅት ሁጦኡ፤ ሬዮ መንገን እኮኡ። <verse eid="MAT 28:4"/><verse number="5" style="v" sid="MAT 28:5"/>ጠዉ እኮጎሬ መላይኬቹ ሜንቱ «አዕኑ ሰቀሌመ ኢሰ ሀሴነንተገ ደጋምቤቺሃ ዋጅቶኖቼ። <verse eid="MAT 28:5"/><verse number="6" style="v" sid="MAT 28:6"/>እስ ወዕና ዬገን ሬሆች ኬዕዮኡ፤ ከንቤቾን ዮበአ፤ ጀናዘስ አፉሼመ ቤቹ አሜ ለዕዬ። <verse eid="MAT 28:6"/><verse number="7" style="v" sid="MAT 28:7"/>ቴሱ ደዕልቴን መርቴን አሳባተስ ‹ኢስ ሬሆች ኬዕዮኡ፤ ክዕኔተ ሄጭ ገሊለተ ኦሮአኖ፤ ህከኔ እሱ ለኤነንተ› ይቴን ኩሌሰ፤ ሁኩዕኑን ኩሎንክዕኔ» ዬሰ። <verse eid="MAT 28:7"/><verse number="8" style="v" sid="MAT 28:8"/>ህከኒች ኤተሮን እሰ ዋጅተንለከ አበ ሙንዲኖን አሳባተስ ኩልቶተ ሎድቢች ደዕልት ደጉድ መርቶኡ።<verse eid="MAT 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9"/>ኢስ እሳን ደቀም «ወገሬቱ ክዕኔሃ እሁን!» ዬሰ፤ እሰን እስበ ሆንጠክ ሎከስ ኡብ ሰገዶኡ። <verse eid="MAT 28:9"/><verse number="10" style="v" sid="MAT 28:10"/>ህከ ወክት ኢስ «ዋጅቶኖቼ! መርቴን አመኤ ኦሱት ገሊለተ ህጋገ ኩሌ፤ ኤሳሃ ህከኔ ለኣኤ» ዬሰ።<verse eid="MAT 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11"/>ሜንቱንኩ መርተን ሄኦገን ሁኩዕኑን! ዘበኛኖች መት-መቱ ዎታደሩ ከተመ መርት እኮ ጠወ ጉዕመንከ ቂስ አዎንሳኖተ ኩልቶኡ። <verse eid="MAT 28:11"/><verse number="12" style="v" sid="MAT 28:12"/>ቂስ አዎንሳኑት ባድ ባልቂን ጭምይት አማዕለንት ዎታደሪሃ ልግብ ብረ ኣት <verse eid="MAT 28:12"/><verse number="13" style="v" sid="MAT 28:13"/>«መኒሃ ‹ነኡ ግንሶምአኔን ሀንከዕሬን አዎናኑስ አሜት ሞግት መስቶኡ› ይቴን ኩሌ። <verse eid="MAT 28:13"/><verse number="14" style="v" sid="MAT 28:14"/>ከ ጠወ ባድ ገሻንቹ ሞጮጬ ጎሬ ክዕኔ አሌን ኦርሸት አሜታበእገ ነኡ ጠወስ ብዝ አዕን ኩልናንስ» ይቶኡ። <verse eid="MAT 28:14"/><verse number="15" style="v" sid="MAT 28:15"/>ህካን እኮቤቺሃ ዎታደሩ ብረስ ቶግ ይቶሰገን አቶኡ፤ ሁኩ ጠዉ ከበሬ ኢለ አይሁድ በላን ጠወአመኖት።<verse eid="MAT 28:15"/></para>
  <para style="s1">ኢስ አሳባተስ ለሉስ</para>
  <para style="r">(<ref loc="MRK 16:14-18">ማር. 16፥14-18</ref>፤ <ref loc="LUK 24:36-49">ሉቃ. 24፥36-49</ref>፤ <ref loc="JHN 20:19-23">ያህ. 20፥19-23</ref>፤ <ref loc="ACT 1:6-8">ሶቀ. 1፥6-8</ref>፤ <ref loc="1CO 15:3-8">1 ቆሮ. 15፥3-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16"/>ቶነ መቱንኩ አሳበት ኢስ መርቶተ አዘዦገን ገሊለ ባዶን ዮ ቆተቤቹ መርቶኡ። <verse eid="MAT 28:16"/><verse number="17" style="v" sid="MAT 28:17"/>እሰን ለኦስ ወክት ሰገዶስ፤ እኮጎሬ መት-መቱሰ ሸክቶኡ። <verse eid="MAT 28:17"/><verse number="18" style="v" sid="MAT 28:18"/>ኢስን እሰበ ሆንጠክ «ዎልቀት ጉዕሙንኩ ሰማንለከ ኡላን ኤሳሃ ኣሰንቶኤ። <verse eid="MAT 28:18"/><verse number="19" style="v" sid="MAT 28:19"/>ቴሱ መንቤቹ ጉዕመንከ መርቴን አንኤ ሱዕሚኒ፥ ቤት ሱዕሚኒለከ ጠሊለ አያን ሱዕሚኒ ጠመቄነን አዎናኑኤ አዕዬ።<note caller="-" style="x"><char style="xo" closed="false">28፥19 </char><char style="xt" closed="false"><ref loc="ACT 1:8">ሶቀ. 1፥8</ref>።</char></note> <verse eid="MAT 28:19"/><verse number="20" style="v" sid="MAT 28:20"/>አዘዦንክዕኔሃ ጉዕመንከ አገርታገ ተማርስዬ፤ አን ዘማን መጨረሸ ኢለ ጉዕመንከ ወክት ክዕኔን ሜጡበ እሃም» ዬሰ።<verse eid="MAT 28:20"/></para>
  <chapter eid="MAT 28"/>
</usx>
