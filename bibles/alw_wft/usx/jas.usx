<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- HALABA NEW TESTAMENT</book>
  <para style="h">ያቁብ</para>
  <para style="toc1">ያቁብ ከተቦ ሶህኑተ</para>
  <para style="toc2">ያቁብ ከተቦ ሶህኑተ</para>
  <para style="toc3">ያቁ.</para>
  <para style="mt">ያቁብ ከተቦ ሶህኑተ</para>
  <para style="imt1">ኣጉስ</para>
  <para style="ip">ኩ ያቁብ ሶህኑት በሬተ በሬተ ደግለለኖ ትዛዝ አፎሃ እሀን ከተበሞንኩ ኣዱንያ አሌን ጉዕማንን ብንይቶ ቶነ ለሞንከ ዘሬተ ጉዕሚንካት። ከተቦስ መንቹ ሀይመስ ሆጎ አሌን ሆስሶተለከ አመዕናኖተ ሀስሰኖ ሃሊንን ሄኡ ሀሲሰኖሃ እሁስ ለሊሽ ከተቦኡ፤ ህትን ቀባጦለከ ቡጥመተኔሃ፥ ፌተነለከ አመዕናኖተ ሀስሰኖ ጡመ ሄእተኔሃ፥ ምቀኞመተ፥ አመዕነትለከ ጡመ ሆጎተኔሃ፥ አረቤ ጡምመለከ ሂልመተኔሃ፥ ደግተኔሃ፥ መት-መቲን ብተምተኔሃ፥ ለዕዬኤ ለዕዬኤ ይተኔሃለከ ገው ሆፍስተኔሃ፥ ዎሎ መን አሌን ፈረድተኔሃ፥ ገዎን ድከእተኔሃ፥ አደብተኔሃለከ ዱእተኔሃ አመዕናኑተ እሁ ሀስሰኖሃ ግዳጀ መቲን መቲን ከተቦኡ።</para>
  <para style="ip">ሶህኑስ አመዕናኖ ሄኦን አመዕነቱ ሆጎን ለሊሴኖሃ እሁስ ኩልታእተ።</para>
  <para style="iot">መጻፉስ አፎሃ</para>
  <para style="io1">ኣጉስ <char style="ior">(<ref loc="JAS 1:1">1፥1</ref>)</char></para>
  <para style="io1">አመዕነቱለከ ሀይመተ <char style="ior">(<ref loc="JAS 1:2-8">1፥2-8</ref>)</char></para>
  <para style="io1">ቡጥመተለከ ቀባጡተ <char style="ior">(<ref loc="JAS 1:9-11">1፥9-11</ref>)</char></para>
  <para style="io1">ፌተነተ <char style="ior">(<ref loc="JAS 1:12-18">1፥12-18</ref>)</char></para>
  <para style="io1">መገን ላገተ ሞጮጩለከ ሆጎን ሆስሱ <char style="ior">(<ref loc="JAS 1:19-27">1፥19-27</ref>)</char></para>
  <para style="io1">አደዶመተ ከለቁ ሀስሰኖበእገ ኣሴመ ሸዘነተ <char style="ior">(<ref loc="JAS 2:1-13">2፥1-13</ref>)</char></para>
  <para style="io1">አመዕነቱለከ ሆጉተ <char style="ior">(<ref loc="JAS 2:14-26">2፥14-26</ref>)</char></para>
  <para style="io1">አመዕናንቹለከ አረቤስተኔሃ <char style="ior">(<ref loc="JAS 3:1-18">3፥1-18</ref>)</char></para>
  <para style="io1">አመዕናንቹለከ ኣዱንያ አል <char style="ior">(<ref loc="JAS 4:1-5:6">4፥1—5፥6</ref>)</char></para>
  <para style="io1">አደደ ጠውሃ ኣሰንቶ ሸዘነተ <char style="ior">(<ref loc="JAS 5:7-20">5፥7-20</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="JAS 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1"/>መገንለከ ቀርቾ መሲህ ኢስ ካድንቹ እኮም ያቁቢች ኣዱንያ አሌን ጉዕማንን ብንይቶ ቶነ ለሞሃንከ እስራኤል ዘሬተ ሶሀንቶእተ ሶህኑ፤<note caller="-" style="x"><char style="xo" closed="false">1፥1 </char><char style="xt" closed="false"><ref loc="MAT 13:55">ማቶ. 13፥55</ref>፤ <ref loc="MRK 6:3">ማር. 6፥3</ref>፤ <ref loc="ACT 15:13">ሶቀ. 15፥13</ref>፤ <ref loc="GAL 1:19">ገላ. 1፥19</ref>።</char></note></para>
  <para style="p" vid="JAS 1:1">ወገሬቱ ክዕኔሃ እሁን።<verse eid="JAS 1:1"/></para>
  <para style="s1">አመዕነቱለከ ሀይመተ</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2"/>አመኤ ኦሶ! አደዱ ኦርሸት ኢልቶህዕኔ ወክት ሙንደዕዬ። <verse eid="JAS 1:2"/><verse number="3" style="v" sid="JAS 1:3"/>አመዕነቶንከክዕኔ ኢልታ ኦርሸ መሳን ፈረኬነንተገ ደጌነንተ። <verse eid="JAS 1:3"/><verse number="4" style="v" sid="JAS 1:4"/>አታዕሊን ኡሩክዕኔ መቱርቹሁ ጤዕይዩዕናን ኩሌኖህዕኔርቹ ዮህዕኔበእሩለከ ዊመ እኮኖተ አበቀአኖህዕኔሃ እሁን። <verse eid="JAS 1:4"/><verse number="5" style="v" sid="JAS 1:5"/>ክዕኔኤች አዬሃ ሀይመት ሆፈኦስጎር ህንቁዕነ መረርሲጭ ጉዕሚንከ ኣሰኖ መገኑ ኡጩን፤ እሲንከ ኣሰመኖስ። <verse eid="JAS 1:5"/><verse number="6" style="v" sid="JAS 1:6"/>ጠዉ እኮጎሬ መኑ ሸኩዕናን አመዕነቲን ዱአ አኡን፤ ቀልቤንከስ ሸከኖ መንቹ ቦብሪን ሀምበለም ሌንቄቀኖ ዊ ሁለ አጉደኖ። <verse eid="JAS 1:6"/><verse number="7" style="v" sid="JAS 1:7"/>ህትኔ መንቹ ቀርቺች መቱርቹሃ ደአኖሃ አጉዱንከስ። <verse eid="JAS 1:7"/><verse number="8" style="v" sid="JAS 1:8"/>መሰንትስ ሸከኖ መንቹ ዎቃንከስ ከበሃ ካጳ እሀኖቤቺሃት።<verse eid="JAS 1:8"/></para>
  <para style="s1">ቡጥችለከ ቀባጣሞ መንች ሙንዲኑተ</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9"/>ዮስርቾን ህንቀሞ መንቹ መገኑ ሎርሰኖስቤቺሃ ሙንደኡን። <verse eid="JAS 1:9"/><verse number="10" style="v" sid="JAS 1:10"/>ቀባጣሙ እክ ገውስ ሆፍሾ መንቹ ገውስ ሆፍሲንከስ ተሽ ዩንስ፤ መሰንትስ እስ ገውንኩስ ባዳ ቦብሎገ ግግሉ ፈቀኖበአ። <verse eid="JAS 1:10"/><verse number="11" style="v" sid="JAS 1:11"/>አሩ አበ ቡሰን ፉለኖ ወክት ህከ ባዳ ቦብሉተ ሞሸኖ፤ ቦብሉንትስ ግግልታአ፤ ህትን ቦብሎስ ደኑንኩ በአኖ፤ ህትን ቀባጡተ ደጎተ ይ ከበለከ ካጵ እሀን ሬሀኖ።<note caller="-" style="x"><char style="xo" closed="false">1፥10-11 </char><char style="xt" closed="false"><ref loc="ISA 40:6-7">ኢሳ. 40፥6-7</ref>።</char></note><verse eid="JAS 1:11"/></para>
  <para style="b"/>
  <para style="s1">መን አሌን ኢልታ ፌተነተኔሃ</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12"/>ኦርሸት ኢልቶስ ወክት ጠረኝ ኡረኖ መንቹ ማሰአሞእሃ፤ መሰንትስ ኦርሻን ጠረኝ ኡሬቤቺሃ መገኑ ኢትታስሀኑኡተ ኣሶተ ተቢሳሃ አዕዮ ሄእ አክሊልገ አዕይ ቶገኖ። <verse eid="JAS 1:12"/><verse number="13" style="v" sid="JAS 1:13"/>አዪሁ ፌተነመኖ ወክት «መገኑ ፌተኞኤ» ሆሮ ዩንከ፤ መሰንትስ መገኑ ሂለ ጠዊን ፌተነመኖበአ፤ ህትን ገዉንኩስ አዬኒ ፌተነኖበአ። <verse eid="JAS 1:13"/><verse number="14" style="v" sid="JAS 1:14"/>ጠዉ እኮጎሬ አዪሁ ፌተነመኖሁ ገይስ ሂለ ሄዕላቻን መሰገሚትለከ ጣንሰምት። <verse eid="JAS 1:14"/><verse number="15" style="v" sid="JAS 1:15"/>ህከኒች ኤተሮን ሂሉ ሄዕላቸት ላፈ እክ ጩብ እልታአ፤ ህትን ጩቡንኩ ነጵ ሬሁተ ኤበኖ።<verse eid="JAS 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16"/>ኢተንቴንተ አመኤ ኦሶ! ሉሶኖቼ። <verse eid="JAS 1:16"/><verse number="17" style="v" sid="JAS 1:17"/>ጡሙ ኣስቱትለከ ፈቁ ዮበእ በረከት ጉዕሙንኩ አሜተኖሁ ሰሜቺት፤ ሁኩን አሜተኖሁ ኑር አነ እኮለከ ዶረምበ ህከረንገ ሀሌገ ዘህበ መገን አዲች ድርታአ። <verse eid="JAS 1:17"/><verse number="18" style="v" sid="JAS 1:18"/>ክልቀቲችስ ሀንገፈ እንኮተ መገኑ ገይስ ሃሽኣቶገለከ ሀንቅስ ላጋን እሎኔ።<verse eid="JAS 1:18"/></para>
  <para style="s1">ሞጮጬማሃ ሆጎ አሌን ሆስሱ</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19"/>ኢተንቴንተ አመኤ ኦሶ! ካን ደጌ፤ መኑ ጉዕሙንኩ ሞጮጪሃ ደዕለኖሃ እሁን፤ ጠዉ እኮጎሬ ጠወኢሃለከ ኡሙዕርሃ ደዕለኖሃ እሁንከ። <verse eid="JAS 1:19"/><verse number="20" style="v" sid="JAS 1:20"/>መሰንትስ መን ኡሙዕርት መገን ፈይመተ ኤባበአ። <verse eid="JAS 1:20"/><verse number="21" style="v" sid="JAS 1:21"/>ህካን እኮቤቺሃ ንጃስለከ ሂልመተ ጉዕመንከ ኡጅቴን ቀልቤንከክዕኔ ካሰሞ ነቢሳክዕኔ ፌሲሃ አታልታ ላገተ ገዉ ሆፍሲን ቶጌ።<verse eid="JAS 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22"/>መገን ላገተ ዊንሽቴነንተረ እኬ ቤሉ ገዉክዕኔ ሉሲሴነን ጠለዕል ሞጮጭቴነንተረ እኮኖቼ። <verse eid="JAS 1:22"/><verse number="23" style="v" sid="JAS 1:23"/>ላገስ ሞጮጭ ሆጎን ሆስስባሁ ለአቃንቺን ገዉስ ለአኖ መንቹ አጉደኖ። <verse eid="JAS 1:23"/><verse number="24" style="v" sid="JAS 1:24"/>መሰንትስ ሁኩ መንቹ ገዉስ ለአቀንቺን ለዕይ አብል ፉሎገን መ አጉደኖጎር ደዕልን ሀበኖ። <verse eid="JAS 1:24"/><verse number="25" style="v" sid="JAS 1:25"/>ጠዉ እኮጎሬ ነጠ ፉሸኖ መገን ሕገ ለዕይ ህከኔን ጠረኘኖሁለከ እሱንከ ሞጮጭ ሀቡዕነ ሆጎ አሌን ሆስሰኖሁ ሆጎንከስ ጉዕማንን ማሰአሞሃ እሀኖ።<verse eid="JAS 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26"/>አረብስ አገዕሩዕናን «መገኑ አመዕንዮም» የኖሁ ጉዕሙንኩ ገዉስ ሉስሰኖ፤ ህትን አመዕነቱንኩስ ተሰሃን። <verse eid="JAS 1:26"/><verse number="27" style="v" sid="JAS 1:27"/>አነ መገን ብሬን ነጠለከ ንጀሱ ዮበእ አመዕነቱ ከኔት፤ ሁኩንን ህዬሸ ኦሱተለከ ምንሰ አኑ ሬዮ ሜንቱ ኦርጨንቶ ወክት ሀዕሉሃለከ ህትን ከን ኣዱንያ አል ንጃሲች አገዕሩሃን።<verse eid="JAS 1:27"/></para>
  <chapter eid="JAS 1"/>
  <chapter number="2" style="c" sid="JAS 2"/>
  <para style="s1">ቡጥቹ ህንቁ ሀስሰኖበአ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1"/>ኬዕምኝ ቀርቹ እኮ ቀርቹሃኔ መሲህ ኢሳን አመዕንቴንተ አመኤ ኦሶ! አዕኑ መን በላን ሆሮን አደዶመተ አቶኖቼ። <verse eid="JAS 2:1"/><verse number="2" style="v" sid="JAS 2:2"/>ምሳሌተስ ለሙ መኑ ጭምይቴንተቤቹ አሜታአ፤ መቱስ አንጋንከስ ወርቅ ጨምባረ አዕይ ጡመ ኦድኑተ ኦደዕዮሃን፤ ዎሉስንገ ጡርቶ ኦድኑተ ኦደዕዮ ቡጥቹሃን። <verse eid="JAS 2:2"/><verse number="3" style="v" sid="JAS 2:3"/>ህከ ወክት ጡመ ኦድኑተ ኦደዕዮ መንቹ ኬዕምኚን «ከን ጡመ ቤቾን አፉዕል» ይቴነንተስ። ጠዉ እኮጎሬ ቡጥቹስንገ «አት ህከጴ ኡር» ህከረንገ «ሎከኤ አዲን ኡለ አፉዕል» ይቴነንተስ። <verse eid="JAS 2:3"/><verse number="4" style="v" sid="JAS 2:4"/>ህካን እኮች ኩን በላንከክዕኔ አደዶመተ ከለቁሃለከ እልተ ለኤን ፈረዶሃበእንዶ?<verse eid="JAS 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5"/>ኢተንቴንተ አመኤ ኦሶ! ሞጮጭዬ፤ አመዕነቲን ቀባጣመተ እኮኖተለከ እሱ ኢትታሀኑኡተ ኣሴ ሰሜ ዎምነቱ ረገኦተ ከን ኣዱንያ አል ቡጥቻኑተ መጠሮሰ። <verse eid="JAS 2:5"/><verse number="6" style="v" sid="JAS 2:6"/>ጠዉ እኮጎሬ አዕኑ ቡጥቻኑተ ህንቄነንተ፤ ጭንፍታህዕኔሩለከ ፍርድ ምኒ ጎሾሽታህዕኔሩ ቀባጣመተበእንዶ? <verse eid="JAS 2:6"/><verse number="7" style="v" sid="JAS 2:7"/>አዕኑ ገአንቴንተ ከበጀሞ መሲህ ሱዕመ ቦሮርታሩ ህከን ቀባጣመተበእንዶ?<verse eid="JAS 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8"/>«ገዉክዕኔ ኢትቴነንተገን ዎሉ መነሃ ኢትዬ» የመም ከተበሞ መገን ዎምነት ሕገ ዊንሽቴንተጎር ጡመ አቴነንታት።<note caller="-" style="x"><char style="xo" closed="false">2፥8 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ሌዌ 19፥18</ref>።</char></note> <verse eid="JAS 2:8"/><verse number="9" style="v" sid="JAS 2:9"/>ጠዉ እኮጎሬ መን እልተ ለኤን አደዶመተ አቴነንታሃ እኮጎር ጩብ አቴነንታት፤ መገን ሕገ ቤስሃንክዕኔ ዎቀሰንቴነንተ። <verse eid="JAS 2:9"/><verse number="10" style="v" sid="JAS 2:10"/>መኑ መገን ትዛዚች መቱስ ድጅ ፈቆሲሃ ጉዕመንከ ዊንሼጎር ጉዕመንከ ድጄሀንገ ዎለአመኖ። <verse eid="JAS 2:10"/><verse number="11" style="v" sid="JAS 2:11"/>መሰንትስ «ዝነተ አቶት» ዬ መገኑ ህትን «ሽቶት» ዬቤቺሃ ዝነተ አትበጎሬ ሽቶንትእቀ መገን ሕገ ድጅቶንት።<note caller="-" style="x"><char style="xo" closed="false">2፥11 </char><char style="xt" closed="false"><ref loc="EXO 20:13-14">ፉል. 20፥13-14</ref>፤ <ref loc="DEU 5:17-18">ዘዳ. 5፥17-18</ref>።</char></note> <verse eid="JAS 2:11"/><verse number="12" style="v" sid="JAS 2:12"/>ጠወኤነን እኮ አቴነን ነጥነቱ ኣሰኖ ሕጉ ፈረደመኖሰ መንገ እኬ። <verse eid="JAS 2:12"/><verse number="13" style="v" sid="JAS 2:13"/>መገን ፍርደ ማርበ መንቺሃ ማርቱተ አአኖበአ፤ እኮጎሬ ማርቱት ፍርደ ቄልታአ።<verse eid="JAS 2:13"/></para>
  <para style="b"/>
  <para style="s1">አመዕነቱለከ ሆጉተ</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14"/>አመኤ ኦሶ! መቱ መንቹ «አመዕነቱ ዮኤ» የን አመዕነቱስ ጡመ ሆጎን ለሊስበጎሬ መ ደግለለኖስ? ህትን ሁኩ አመዕነቱ ፌሶስተ አታለኖንዶ? <verse eid="JAS 2:14"/><verse number="15" style="v" sid="JAS 2:15"/>ምሳሌተስ ኦደኣኢሁለከ እታኢሁ ዮሰበእ አመኦሱት ሄኦጎር <verse eid="JAS 2:15"/><verse number="16" style="v" sid="JAS 2:16"/>ክዕኔኤች መቱ ሀስሰኖሳሃ ኣሱዕናንስን «ኢቡንክዕኔ፤ ዱቤ፤ ወገሬቲን ኦሮዕዬ» ዬጎር ሁኩን መ ደግለለኖሰ? <verse eid="JAS 2:16"/><verse number="17" style="v" sid="JAS 2:17"/>ህካን እኮቤቺሃ ሆጉት ዮበእ አመዕነቱ ገዉንኩስ ሬዮሃን።<verse eid="JAS 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18"/>መቱ መንቹ «ኩ መንቹ አመዕነቱ ዮስ፤ እኮጎሬ ሁኩንን ሆጉት ዮስ» ይዮ እቃ አን ከን መንቺሃ ያንሲሁ ህንዴ አት አመዕነቱክ ሆጎ ቤሉ ለሊስ፤ አን እኮጎሬ አመዕነቱኤ ሆጎን ለሊሳንኬ ያንስ። <verse eid="JAS 2:18"/><verse number="19" style="v" sid="JAS 2:19"/>አት መገኑ ሜጡ እሁስ አመዕንታንት፤ ሁኩን ጡመሃን፤ ጠዉ እኮጎሬ አመዕኑሃ ሩሃንዩሁ ሁጠን አመዕነኖ። <verse eid="JAS 2:19"/><verse number="20" style="v" sid="JAS 2:20"/>አት ገዉ መንቹ! ሆጎች አደደ እኮ አመዕነቱ ላሊቹ ዮበኢሃ<note caller="+" style="f"><char style="fqa" closed="false">ላሊቹ ዮበኢሃ፦ </char><char style="ft" closed="false">የኖሃ መት-መቱ ሉህ ኪታበት «ሬዮሃ» ይታአ።</char></note> እሁስ ደጋንትበእንዶ? <verse eid="JAS 2:20"/><verse number="21" style="v" sid="JAS 2:21"/>አኑኔ እብራሂም ቤቱስ እሳቀ መገኒሃ ክትም ሆንጠህሴኖ ጠረጴዛን ክትም አዕይ ሆንጠህሾ ወክት ፈየ እኮሁ ሆጎንበእንዶ?<note caller="-" style="x"><char style="xo" closed="false">2፥21 </char><char style="xt" closed="false"><ref loc="GEN 22:1-14">ክል. 22፥1-14</ref>።</char></note> <verse eid="JAS 2:21"/><verse number="22" style="v" sid="JAS 2:22"/>ህካን እኮቤቺሃ አመዕነቱ ሆጎን ሜጡበ ሄዕዮገለከ አመዕነቱስ እስ አዕዮ ሆጎን ዊመ እሁስ ለአንትበእንዶ? <verse eid="JAS 2:22"/><verse number="23" style="v" sid="JAS 2:23"/>ጠሊለ መጻፋን «እብራሂም መገኑ አመዕኔእ፤ አመዕነቱንኩስ ፈየ እክ ዎለአሞስ» የመንቶ ላገት ዊንቶኡ፤ እብራሂምን «መገን ኢተተ» የመም ገአሞኡ።<note caller="-" style="x"><char style="xo" closed="false">2፥23 </char><char style="xt" closed="false"><ref loc="GEN 15:6">ክል. 15፥6</ref>፤ <ref loc="2CH 20:7">2 ዱዱ. 20፥7</ref>፤ <ref loc="ISA 41:8">ኢሳ. 41፥8</ref>።</char></note> <verse eid="JAS 2:23"/><verse number="24" style="v" sid="JAS 2:24"/>ህካን እኮቤቺሃ መኑ ፈየ እሀኖሁ ጠለዕል አመዕነቲን እሁዕነ ሆጎን ሜጡበ እሁስ ለኣንት።<verse eid="JAS 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25"/>ህትን ዝነተ አታ ረኣብ እስራኤል ሶቀማኑተ ምኔንከሴ ቶግ ዎሎ ዎቄን መርታገ አቶ ወክት ሆጎንከሴ ፈየተ እኮበእንዶ?<note caller="-" style="x"><char style="xo" closed="false">2፥25 </char><char style="xt" closed="false"><ref loc="JOS 2:1-21">ኢያ. 2፥1-21</ref>።</char></note><verse eid="JAS 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26"/>ነቢሴች አደ እኮ ጅስሙ ሬዮሃ እኮገን ሆጎች አደ እኮ አመዕነቱሁ ህትን ሬዮሃን።<verse eid="JAS 2:26"/></para>
  <chapter eid="JAS 2"/>
  <chapter number="3" style="c" sid="JAS 3"/>
  <para style="s1">አረብተ አገዕርተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1"/>አመኤ ኦሶ! ክዕኔኤች ልግቡክዕኔ አስተማረተ እኮኖቼ፤ መሰንትስ አዕኑ ደጌነንተገን አስተማረተ እንኮምሩ ዎሎ መኒች አበ ፍርደ ኣእናምቤቺሃት። <verse eid="JAS 3:1"/><verse number="2" style="v" sid="JAS 3:2"/>ነኡ ጉዕሙንኩኔ ልግብ ወክት ሉንሳም፤ ጠዉ እኮጎሬ የኖሃንን ጉዕማንን ሉስባሁ እስ ገዉስ አገዕሩ አታለኖ ኩሌኖስርቹ ዮስበእሃ መንቹ። <verse eid="JAS 3:2"/><verse number="3" style="v" sid="JAS 3:3"/>ፋሹ ኔሳሃ አዘዘመኖገ አፎንከስ ብጣለ ዎርናም፤ ህከኒች ኤተሮን ሎረ ፋሹ ቀዎ ብጣሊን ሀንሶም አደ ጉዕመንከ መረኖገ አዕኖተ አታልናም። <verse eid="JAS 3:3"/><verse number="4" style="v" sid="JAS 3:4"/>ህትን መርከብተኔሃ ሰውይዬ ህንዴ፤ መርከቡ ኬንከሃ ጠረኙ ቦብሩ ሀምበለን ሃመኖ ሎረ እኮጎሬ መርከብስ ኦተኣንቹ ቀቅቾርቺን ሀሾበ መሰኖ። <verse eid="JAS 3:4"/><verse number="5" style="v" sid="JAS 3:5"/>ህትን አረብት ጅስሚች ጉዕሚችን ቀቅቹተ እኮጎሬ ቦን ጠወ ጠወኣአ፤ ህትን ህንዴ ጊረተ ለዕዬ፤ ቀቅቹት ጊረት አበ ሀቅ ቆጠ ቡስታአ። <verse eid="JAS 3:5"/><verse number="6" style="v" sid="JAS 3:6"/>አረብት ጊረጋት፤ እሴን ጅስሚችኔ ጉዕሚችን ሂለተ፤ ጅስመ ጉዕመንከ ንጃስሳአ፤ ህትን አዛቢች ፉልታ ጊረገ ኦስማች ኬሽ ሎረ እሆተ ኢለ ዮ ክልቀት ፎል ቡስታአ። <verse eid="JAS 3:6"/><verse number="7" style="v" sid="JAS 3:7"/>ጉዕማንከ ደን ቡሳወ፥ ጪኡተ፥ ኡላን ሹርይተን ሀንታእረ፥ ባር ኣዜን ሌንቄቅታ ክልቀት ጉዕመንከ መኑ ገረኦተ አታለኖ፤ ህትን ገረአንቶኡ። <verse eid="JAS 3:7"/><verse number="8" style="v" sid="JAS 3:8"/>ጠዉ እኮጎሬ አረብተ ገረኢሃ አታለኖሁ አዪሁ ዮበአ፤ ሸኖ መርዙ ዊሞሴተ፤ ህትን ፎሎጩ ዮበእተ ሂለተ። <verse eid="JAS 3:8"/><verse number="9" style="v" sid="JAS 3:9"/>ህከን አረቤን ቀርቹለከ አነኔ መገኑ ገለትጭናም፤ እሴንን መገን ደኒን ከለቀሞ መነ ቦሮርናም።<note caller="-" style="x"><char style="xo" closed="false">3፥9 </char><char style="xt" closed="false"><ref loc="GEN 1:26">ክል. 1፥26</ref>።</char></note> <verse eid="JAS 3:9"/><verse number="10" style="v" sid="JAS 3:10"/>መቶ አፌች ገለቱለከ ቦሮሩሁ ፉለኖት፤ አመኤ ኦሶ! ህት እሁ ሀስሰኖበአ። <verse eid="JAS 3:10"/><verse number="11" style="v" sid="JAS 3:11"/>መቴ ቡቆች ጤአኖ ዉሁለከ ቀራረኖ ዉሁ ቡቆተ አታለኖንዶ? <verse eid="JAS 3:11"/><verse number="12" style="v" sid="JAS 3:12"/>አመኤ ኦሶ! ኦዱ ዎርች ላሊቹ ላሎተ አታለኖንዶ? ህትን ዎይን ላልቹ ኦድ ላሊቹ ላሎተ አታለኖንዶ? ህትን መጥንት ዮ ዊች አጌኖ ጡመ ዋሃ ደኦኖተ አታሌኖበአ።<verse eid="JAS 3:12"/></para>
  <para style="s1">ሰሜች አሜታ ሀይመተኔሃ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13"/>ክዕኔ በሊች ሀይቹለከ ደገኖ መንቹ አዬት? ሀይማንለከ ገዉ ሆፍስን አዕዮ ጡመ ጠወ ሄእንከስ ለሊሱን። <verse eid="JAS 3:13"/><verse number="14" style="v" sid="JAS 3:14"/>ጠዉ እኮጎሬ ሂሉ ምቀኞመትለከ ገዉ ኢቱሁ ቀልቤንከክዕኔ ሄዕዮ ጎሬ ህከኒን ቦንቶኖቼ፤ ሀንቅ እኮ ጠዋን ክዝብ ጠወኦኖቼ። <verse eid="JAS 3:14"/><verse number="15" style="v" sid="JAS 3:15"/>መሰንትስ ህትኔ ሀይመት ደገንታኢሁ ከን ኣዱንያ አሊች፥ ማሊችለከ ሼይጣንቺት ቤሉ መገን አዲችበአ። <verse eid="JAS 3:15"/><verse number="16" style="v" sid="JAS 3:16"/>ምቀኞመትለከ ገዉ ኢቱሁ ዮቤቾን ብተትለከ ሂለት ሆጉት ጉዕመንት ሄኣአ። <verse eid="JAS 3:16"/><verse number="17" style="v" sid="JAS 3:17"/>ጠዉ እኮጎሬ መገኒች ደገንታ ሀይመት ወዕናንከ ነጠሃን፤ ህከኒች ኤተሮን ወገሬት ኢታንቹ፥ ጎደበ ላፈ፥ ገው ሆፍሱ፥ ዎሊሃ መረርሲጨኖሃ፥ ጡሙ ላልቹ ዊሞሃ፥ መቱ አደ ጎልባሃለከ ለዕዬኤ ዩ ዮስበእሃን። <verse eid="JAS 3:17"/><verse number="18" style="v" sid="JAS 3:18"/>ወገርት ኢትታ መኑ ወገሬት ዉጥ መገን ሰውትገ ሄእ ላሊቹ ጭምአታአ።<verse eid="JAS 3:18"/></para>
  <chapter eid="JAS 3"/>
  <chapter number="4" style="c" sid="JAS 4"/>
  <para style="s1">ኣዱንያ ሂልመተ ግቡ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1"/>ክዕኔ በላን ዮ በገዙለከ ብተት ሀከንቤቺች አሜቶእታን? ኣዜንከክዕኔ ኦለመኖ ማልክዕኔ ሃሽኣቶችበእንዶ? <verse eid="JAS 4:1"/><verse number="2" style="v" sid="JAS 4:2"/>አዕኑ መቱርቹ ደኢሃ ሀሴነንተ፤ ጠዉ እኮጎሬ ደጌነንተበአ፤ ሽቴነንተ፥ አበ ሄዕላቴነንተ ጠዉ እኮጎሬ ደጌነንተበአ፤ <verse eid="JAS 4:2"/><verse number="3" style="v" sid="JAS 4:3"/>ዱአ አቴንተጎሬ ማልክዕኔ ሰውቲን ሆስሶኖተ ሂለ ሰውቲን ዱአ አቴነንተቤቺሃ ኡጭቴነንታሃ ደእቴነንተበአ። <verse eid="JAS 4:3"/><verse number="4" style="v" sid="JAS 4:4"/>አዕኑ አመዕነንቴንቡ መኑ! ከን ኣዱንያ አል ጠወ ኢትታ መኑ መገኒሃ ዲነ እሁሰ ደጌነንተበእንዶ? ከን ኣዱንያ አል ጃለት ጉዕሙንኩ መገኒሃ ዲነ እኮኡ። <verse eid="JAS 4:4"/><verse number="5" style="v" sid="JAS 4:5"/>ጠሊለ መጻፋን «መገኑ ኣዜንከክዕኔ አፉሼ አያነ ጠለዕል እሲሃ እሆተ ሀሰኖ» ዬኢሁ ተሳንትንዶ? <verse eid="JAS 4:5"/><verse number="6" style="v" sid="JAS 4:6"/>ህትን መገኑ «ቦንታእራ ግበኖ፤ እኮጎሬ ገዉሰ ሆፍሳሀኑኡተ ኣስቱተ ኣሰኖ» የኖቤቺሃ መገን ኣስቱት ጉዕሚችን በተአኣ።<note caller="-" style="x"><char style="xo" closed="false">4፥6 </char><char style="xt" closed="false"><ref loc="PRO 3:34">ምሳ. 3፥34</ref>።</char></note><verse eid="JAS 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7"/>ህካን እኮቤቺሃ መገኒሃ ጠገሜ፤ ጠዉ እኮጎሬ እልብሰ ግቤስ፤ እስን ክዕኔኤች ሁነኖ። <verse eid="JAS 4:7"/><verse number="8" style="v" sid="JAS 4:8"/>መገን ቤቹ ሆንጠኬ፤ እስን ክዕኔቤቹ ሆንጠሀኖ፤ አዕኑ ጩበኛኑት! አንገክዕኔ ነጠ አዕዬ፤ ህትን ከበሃ ካጳ እኬነንተሩ! ቀልብክዕኔ ነጠ አዕዬ። <verse eid="JAS 4:8"/><verse number="9" style="v" sid="JAS 4:9"/>ጩብክዕኔተኔሃ ሻዤ፤ ጨነቀሜ፤ ኦዕዬ፤ ኦሰሉክዕኔ አልፋቴን ሙንዲኑክዕኔ ሻዞን ዶረንቱን። <verse eid="JAS 4:9"/><verse number="10" style="v" sid="JAS 4:10"/>ቀርች ብሬን ገዉክዕኔ ሆፍሼ፤ መገኑ አሌ ዋሽ ሎርሰኖህዕኔ።<verse eid="JAS 4:10"/></para>
  <para style="s1">መን አሌን ፈረዱ ገበእባሃ እሁስ</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11"/>አመኤ ኦሶ! መቱ-መትክዕኔ አሌን ሂለርቹ ጠወኦኖቼ፤ መቱሃ አመስ ቤት አሌን ሂለ ጠወ ጠወአኖሁ ህከረንገ አመስ ቤት አሌን ፈረደኖሁ መገን ሕግ አሌን ሂለርቹ ጠወአኖሃንለከ ሕግ አሌን ፈረደኖሃን፤ መገን ሕግ አሌን ፈረዶንትጎር አት ሕገ አገራንቹ እኩዕነ ፈረዳንቹሃን። <verse eid="JAS 4:11"/><verse number="12" style="v" sid="JAS 4:12"/>ሕገ ኣሰኖሁለከ ፈረደኖሁ ጠለዕል መቱሃ መገኑ፤ ህትን ፌሲሃለከ ቤሲሃ አታለኖሁ ጠለዕል እሶት፤ ህከረ መን አሌን ፈረዳንቲሁ አት አዬት?<verse eid="JAS 4:12"/></para>
  <para style="s1">መገኑ ዬጎሬ ይኑዕናን ጋቴተ ሰውይተኔሃ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13"/>አዕኑ «ከበር ህከረንገ ጋቴተ ዎሉ ባዱ መርን መቱ ዘማን ዱንክናም፤ ነገንድ ተረፍንሳም፤ ልግብ ብረ ጭም አዕናም» ይቴነንተሩ ሞጮጭዬ። <verse eid="JAS 4:13"/><verse number="14" style="v" sid="JAS 4:14"/>መሰንትስ ጋቴተ ም እሀኖጎሬ ደጌነንተበአ፤ ነቢሶክዕኔ መርቹሃን? አዕኑ ቀዎ ወክት ለሊ በኣ ጎመጋት።<note caller="-" style="x"><char style="xo" closed="false">4፥13-14 </char><char style="xt" closed="false"><ref loc="PRO 27:1">ምሳ. 27፥1</ref>።</char></note> <verse eid="JAS 4:14"/><verse number="15" style="v" sid="JAS 4:15"/>ህከን ወጥ አዕኑ «ቀርቹ ዬጎሬለከ ሄዕኖም ጎሬ ካን ህከረንገ ካጵ አዕናም» ዩ ሀስሰኖህዕኔ። <verse eid="JAS 4:15"/><verse number="16" style="v" sid="JAS 4:16"/>ጠዉ እኮጎሬ አዕኑ ህከን ወጥ ቦኖንተክዕኔ ድከኤነንታት፤ ህትኔ ቦኑ ጉዕሙንኩ ሂለሃን።<verse eid="JAS 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17"/>ጡመ ጠወ አኡ ሄዕዮስገ ደገን አእበ መንቺሃ ጩብ እሀኖስ።<verse eid="JAS 4:17"/></para>
  <chapter eid="JAS 4"/>
  <chapter number="5" style="c" sid="JAS 5"/>
  <para style="s1">ቀባጣማተ ኣሰንቶሰ ሸዘነተ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1"/>ቴሱ አዕኑ ቀባጣመት ሞጮጭዬ፤ ጠረኘት ኦርሸት አሌንከክዕኔ አሜታቤቺሃ ያርቴነን ኦዕዬ። <verse eid="JAS 5:1"/><verse number="2" style="v" sid="JAS 5:2"/>ቀባጡክዕኔ ጉዕሙንኩ ሸንቶኡ፤ ኦድኑክዕኔ ብሉት እቶኡ። <verse eid="JAS 5:2"/><verse number="3" style="v" sid="JAS 5:3"/>ዎርቁክዕኔለከ ብሩክዕኔ ጭኞኡ፤ ሁኩ ዎርቁክዕኔለከ ብሩክዕኔ ጭኞሁ ክዕኔኤሃ ምስክር እሀኖ፤ ጅስመክዕኔ ጊረገ እተኖ፤ ከን መጨረሽ በሬን ልግብ ቀባጡተ ጭምአቴንታአ።<note caller="-" style="x"><char style="xo" closed="false">5፥2-3 </char><char style="xt" closed="false">ማቴ. 6፥19።</char></note> <verse eid="JAS 5:3"/><verse number="4" style="v" sid="JAS 5:4"/>አዕኑ ምዳ መኒሃ ሆጎሰ ዋገ ባቴንታበአ፤ እሰን ያርታእት፤ ያርታእንከ ጉዕመንከ አታለኖ ቀርቹ ሞጮጭዮኡ።<note caller="-" style="x"><char style="xo" closed="false">5፥4 </char><char style="xt" closed="false"><ref loc="DEU 24:14-15">ዘዳ. 24፥14-15</ref>።</char></note> <verse eid="JAS 5:4"/><verse number="5" style="v" sid="JAS 5:5"/>አዕኑ ኣዱንያ አሌን ናጃንለከ ሙንዲኖኒ ሄኤንታአ፤ ጎረጥሀ አላሌመ ለልገ ምሴንታአ። <verse eid="JAS 5:5"/><verse number="6" style="v" sid="JAS 5:6"/>ፈየ መንች አሌን ፈረዴን ሽቴንተስ፤ ጠዉ እኮጎሬ እስ ግቦህዕኔበአ።<verse eid="JAS 5:6"/></para>
  <para style="b"/>
  <para style="s1">ቀርች አሜቱ አታዕሊን አገሩ</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7"/>አመኤ ኦሶ! ቴሱ ቀርቹ አሜቶተ ኢለ አታዕሊን አገዕርዬ፤ አቡራንቹ ዎኔሃለከ ኤተር ጤነ ደኦተ ኢለ አታዕሊን ጡመ ኡለ አቶተ አገዕረኖ። <verse eid="JAS 5:7"/><verse number="8" style="v" sid="JAS 5:8"/>አዕኑ ህትን አታዕሊዬ፤ ቀርቹ አሜተኖ በሩ ሆንጠኮቤቺሃ ጠረኝቴን አገዕርዬ።<verse eid="JAS 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9"/>አመኤ ኦሶ! ክዕኔ አሌን ፈረደምበገ መት-መትክዕኔ አሌን ጨቀጨቆኖቼ፤ ሁኩዕን ፈረደኖሁ አሜተኖ ወክቱ ሆንጠኮኡ። <verse eid="JAS 5:9"/><verse number="10" style="v" sid="JAS 5:10"/>አመኤ ኦሶ! ቀርች ሱዕሚን ጠወኣ ነቢያኑት ኦርሸተ ኣኢንለከ አታዕሊን ምሳልተ እሁሰ ህንዴ ለዕዬ። <verse eid="JAS 5:10"/><verse number="11" style="v" sid="JAS 5:11"/>ህትን አታዕሊን ጠረኝቶእሩ «ማሰአንቶእራን» ይናንሰ፤ አዩብ አታዕሌገ ሞጮጭቴንታአ፤ ቀርቹንኩ ኤተሮን አዕዮስ ጡመ ጠወ ጉዕመንከ ለኤንታአ፤ መሰንትስ ቀርቹ አበ መረርሲጨኖሃለከ ጎደበ ላፈሃን።<note caller="-" style="x"><char style="xo" closed="false">5፥11 </char><char style="xt" closed="false"><ref loc="JOB 1:21-22">አዩ. 1፥21-22</ref>፤ <ref loc="JOB 2:10">2፥10</ref>፤ <ref loc="PSA 103:8">መዝ. 103፥8</ref>።</char></note><verse eid="JAS 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12"/>አመኤ ኦሶ! መ ጠዊች ሄጭቴን ሰማን ህከረንገ ኡላን ህከረንገ ዎሎ ጠዋን መቶርቾኒ ጤሌዕልቶኖቼ፤ ጠዉ እኮጎሬ ፍርዳን ኣጌነንተበእገ ጠወኤነንተ ጠዉ ሀንቅ እኮጎሬ «ሀንቅያ ይዬ» ክዝብ እኮች «ክዝብያ» ይዬ።<note caller="-" style="x"><char style="xo" closed="false">5፥12 </char><char style="xt" closed="false"><ref loc="MAT 5:34-37">ማቶ. 5፥34-37</ref>።</char></note><verse eid="JAS 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13"/>ክዕኔ በላን አበ ኦርጨቀሞሁ ሄዕዮ ጎሬ ዱአ አኡን፤ ህትን ሙንደዕዮሁ ሄዕዮ ጎሬ መገኑ ገለትጨን ዘመሩን። <verse eid="JAS 5:13"/><verse number="14" style="v" sid="JAS 5:14"/>ክዕኔ በላን አዪሁ ጥዦ መንቹ ሄዕዮ ጎሬ አመዕናኖ ዱእ ምኒች ባሊቀተ ገኡን፤ እሰን ጥዘናሙስ ቀርች ሱዕሚን ዘይተ ቡርት ዱአ አቱን።<note caller="-" style="x"><char style="xo" closed="false">5፥14 </char><char style="xt" closed="false"><ref loc="MRK 6:13">ማር. 6፥13</ref>።</char></note> <verse eid="JAS 5:14"/><verse number="15" style="v" sid="JAS 5:15"/>ህትኔ ዱኡ ጥዘናሙ ፈይሰኖ፤ ቀርቹንኩ ጥዘናች ኬሰኖስ፤ አዕዮ ጩቡ ሄዕዮ ጎሬ ማረመኖስ። <verse eid="JAS 5:15"/><verse number="16" style="v" sid="JAS 5:16"/>ህካን እኮቤቺሃ አዕኑ ፈይቶኖተ ጩብሃክዕኔ ገገዉክዕኔ ቶበቼ፤ መት-መቲሃክዕኔ ዱአ አዕዬ፤ ፈየ መንች ዱኡ ዎልቀት ዮስቤቺሃ አበ ሆጉተ አአኖ። <verse eid="JAS 5:16"/><verse number="17" style="v" sid="JAS 5:17"/>ኢልያስ ኒገን መንቹሃ እቅ፤ ጠዉ እኮጎሬ ጤኑ ኡበኖበእገ ጠረኝሽ ዱአ አዕዮ ወክት ሰሱ ዘማንለከ ሌሁ አገነ ኢለ ኡለ አሌን ጤኑ ሆሮ ኡቦበአ።<note caller="-" style="x"><char style="xo" closed="false">5፥17 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 ነገ. 17፥1</ref>፤ <ref loc="1KI 18:1">18፥1</ref>።</char></note> <verse eid="JAS 5:17"/><verse number="18" style="v" sid="JAS 5:18"/>ለንኪሃ ዱአ አዕዮ ወክት ጤኑ ኡቦ፤ ኡለንት አቶተ ኣቶኡ።<note caller="-" style="x"><char style="xo" closed="false">5፥18 </char><char style="xt" closed="false"><ref loc="1KI 18:42-45">1 ነገ. 18፥42-45</ref>።</char></note><verse eid="JAS 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19"/>አመኤ ኦሶ! ክዕኔኤ በሊች መቱ ሀንቅ ዎቄች ሉጨሞጎር ዎሉስ መንቹ ሀንቅ አደ ፈንቀሼስጎር <verse eid="JAS 5:19"/><verse number="20" style="v" sid="JAS 5:20"/>መቱ ጩበኘ መንቹ ጩብ ወቄች ፈንቀሸኖ መንቹ ጩበኝ ነብሳሃ ሬሆች ጡምሰኖገለከ ልግቡ ጩቡስ ፈቁን የመመኖስገ ደጉን።<note caller="-" style="x"><char style="xo" closed="false">5፥20 </char><char style="xt" closed="false"><ref loc="PRO 10:12">ምሳ. 10፥12</ref>፤ <ref loc="1PE 4:8">1 ጴጥ. 4፥8</ref>።</char></note><verse eid="JAS 5:20"/></para>
  <chapter eid="JAS 5"/>
</usx>
