<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2CO" style="id">- HALABA NEW TESTAMENT</book>
  <para style="h">ለንክ ቆሮንቶስ</para>
  <para style="toc1">ሶቀማንቾ ጳዉሎሴ ለንክ ሶህኑተ ቆሮንቶስ መኒሃ</para>
  <para style="toc2">ለንክ ቆሮንቶስ</para>
  <para style="toc3">2 ቆሮ.</para>
  <para style="mt1">ሶቀማንቾ ጳዉሎሴ ለንክ ሶህኑተ</para>
  <para style="mt2">ቆሮንቶስ መኒሃ</para>
  <para style="imt1">ኣጉስ</para>
  <para style="ip">ጳዉሎስ ቆሮንቶስ መኒሃ ከተቦ ለንክ ሶህኑት ከተበሞሁ ቆሮንቶሳን ሄኦ መገኑ አመዕኔ መን ጭምት ምናን ሄዕዮሰ ሜጡ እሁ አበ ሂለ እኮ ወክቴንት እቅ። መት-መቱ አመዕናኑት ጳዉሎሴ አሌን መት-መቱ ሂለ ጠወ ጠወኦስ ጎሬ ጳዉሎስ ሀራሩተ ከለቆተ አበ ሀሾ፤ ሁኩንን እኮ ወክት አቡ ሙንዲኑት ሞጮጨንቶስገ ኩለኖ።</para>
  <para style="ip">ሶህኖስ ዎኔ ክፍላን ጳዉሎስ ቆሮንቶሳን ዮ መገኑ አመዕኔ መን ጭምት ዱእ ምናን ዮስ ጠውተኔሃ ኩል አመዕናኖ ኣዜን ኬዕዮ ጠዊሃ ጠረኘ መስለ ሚሃ ኣሴጎሬ ሂር ኩለኖ። ህከኔን ሜጡ አዕይ ኩ እስ ጠረኙ መስሉ ቶበት ሀራዕረንቶተ አዕዮሳሃ እኮቤቺሃ ሞጮጨሞስ ሙንዲኑተ ኩለኖ። ህከኒች ኤተሮን ይሁዳን ሄኦ አመዕናኑተ ሀዕሎኖተ ኒያችሰ ኬስ ኣቶተ ኩለኖ። መጨረሽ ፎሎጮን ጳዎሎስ አሳበ አሌን ኬዕዮ ክሲሃ መከላከያ ኣሰኖ። ቆሮንቶሳን መገኑ አመዕንቶ መን ዱእ ምኒ መት-መቱሰ ገውሰ ሀንቅ አሳበተ አት ጳዎሎሴ ክዝብ ሶቀማንቹ ይት ከሰሳሲት እቅ።</para>
  <para style="iot">መጻፉስ አፎሃ</para>
  <para style="io1">ኣጉስ <char style="ior">(<ref loc="2CO 1:1-11">1፥1-11</ref>)</char></para>
  <para style="io1">ጳዉሎሴለከ ቆሮንቶስ አመዕናኑተ <char style="ior">(<ref loc="2CO 1:12-7:16">1፥12—7፥16</ref>)</char></para>
  <para style="io1">ይሁዳን ሄኣ አመዕናኖተ ሀዕሌመሰገ <char style="ior">(<ref loc="2CO 8:1-9:15">8፥1—9፥15</ref>)</char></para>
  <para style="io1">ጳዉሎስ ሶቀምስ ደኝነቲሃስ ሆንጠህሾ ጠወ <char style="ior">(<ref loc="2CO 10:1-13:10">10፥1—13፥10</ref>)</char></para>
  <para style="io1">መጨረሸስ <char style="ior">(<ref loc="2CO 13:11-14">13፥11-14</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="2CO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 1:1"/>መገን ሰውቲን መሲህ ኢስ አሳቤቹ እኮም አን ጰውሎሴ አመኔቤቲች ጢማቶሴች፥<note caller="-" style="x"><char style="xo" closed="false">1፥1 </char><char style="xt" closed="false"><ref loc="ACT 18:1">ሶቀ. 18፥1</ref>።</char></note></para>
  <para style="p" vid="2CO 1:1">ቆሮንቶሳን ዮ መገን አመዕናኖ ጭምት ዱእ ምናችለከ ህትን ዊመ አካይያን ዮ አመዕናኖተ ጉዕሚንከ<verse eid="2CO 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 1:2"/>አንችኔ መገንቺ፥ ቀርቹሃኔ መሲህ ኢስ ኣስቱትለከ ወገሬቱ ክዕኔሃ እሁን።<verse eid="2CO 1:2"/></para>
  <para style="s1">ጳዉሎስ መገኒሃ ሆንጠህሾ ገለት</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 1:3"/>ማርቶ አነ እኮሃ ጠረኝመተ ጉዕመንከ ኣሰኖ ህትን ቀርቹሃኔ መሲህ ኢስ አነ መገኒሃ ገለቱ ኢሉስ። <verse eid="2CO 1:3"/><verse number="4" style="v" sid="2CO 1:4"/>ነኡን መገኒች ኣእኖም ጠረኝማን ኦርሸ ኣዜን ዮእረ ጉዕመንከ ጠረኝሱ አታልኖተ መገኑ ኔሳሃ ኦርሻን ጉዕማንን ጠረኝሰኖኔ። <verse eid="2CO 1:4"/><verse number="5" style="v" sid="2CO 1:5"/>መሰንትስ መሲህ ኦርሸተ በትኝስ ቤቀሞምገን ጠረኝመታ መሲህ አዲን በትንስ ደእናም። <verse eid="2CO 1:5"/><verse number="6" style="v" sid="2CO 1:6"/>ህትን ነኡ ኦርሸተ ቶንጋሚሁ አዕኑ ጠረኝቶኖተለከ ጡምቶኖታት፤ ህትን ነኡ ጠረኝኖምጎሬ አዕኑሁ ነኡ ቶንጋም ደኒን ኦርሸተ አታዕሊን ቶጌን ጠረኝቴነንተ፤ <verse eid="2CO 1:6"/><verse number="7" style="v" sid="2CO 1:7"/>ህከኒሃ ኒ ኦርሸተ ቤቀንቴነንተሀንገን ሙንዲኑኔ ቤቀንቴነንተገ ደንጋምቤቺሃ ክዕኔ አሌን ዮኔ ተብሶሁ ጠረኘሃን።<verse eid="2CO 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 1:8"/>አመኤ ኦሶ! እስይ ባዶን ኢልቶኔ ኦርሸተ ደጎኖተ ሀንሳም፤ ሁኩንን ኢልቶኔ ኦርሸት አታዕልናም ጌሲች በተኣን ፎሊን ሄዕናም ተብሳሃ ሙርኖም እቅ።<note caller="-" style="x"><char style="xo" closed="false">1፥8 </char><char style="xt" closed="false"><ref loc="1CO 15:3">1 ቆሮ. 15፥3</ref>።</char></note> <verse eid="2CO 1:8"/><verse number="9" style="v" sid="2CO 1:9"/>ህትን ሬሁተ ፈረዴመአንገ አዕን ቀልቤኔ ሰውይኖም እቅ፤ እኮጎሬ ሁኩ ጉዕሙንኩ ጠዉ አሌኔ ኢሌኢሁ ሬቶ መነ ሬሆች ኬሰኖ መገኖን ድከዕንት ቤሉ ገይኔ ዎልቃን ድከዕንበጋት። <verse eid="2CO 1:9"/><verse number="10" style="v" sid="2CO 1:10"/>መገኑ ሬሆች ጡምሾኔ፤ ቴሁ ጡምሰኖኔ፤ ህትን ከ ኤተሩሃ ፌሰኖኔገ መገኖን ተብሳሃ አዕናም። <verse eid="2CO 1:10"/><verse number="11" style="v" sid="2CO 1:11"/>አዕኑሁ ኔሳሃ ዱአ አቴነን ሀዕሉ ሀስሰኖህዕኔ፤ ህትን አበ ዱኢን ነኡ መገን ሀዕለንሸ ደእናም ወክት ልግቡ መኑ ኒ መሳን መገኑ ገለትጨኖ።<verse eid="2CO 1:11"/></para>
  <para style="s1">ጳዉሎስ ዎቃ ሃመኖ ያደተ ዶሩስ</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 1:12"/>ነኡ ድከዕናምርቹ ከኒት፤ ከን ዱንየ አሌን በትሽን ክዕኔን ሜጡበ ዮኔ ደቀንሹ መገኒች ደዕኖም አመዕነንሺን ሄዕኖምገ ቀልቡኔ መሰከረኖ፤ ሁኩንን መን ሀይማን እሁዕነ መገን ኣስቶኒት።<verse eid="2CO 1:12"/></para>
  <para style="p">
    <verse number="13-14" style="v" sid="2CO 1:13-14"/>መሰንትስ አዕኑ አነበቢሃለከ አጥራመቲሃ አታልቴነንተሀን ቤሉ ዎሉ መቱርቹሃ ከተባንክዕኔበአ፤ ህካን እኮቤቺሃ ቀርቹኔ ኢስ አሜተኖ በር ነኡ ክዕኔን ድከዕኖተለከ አዕኑ ኒን ድከኦኖተ ከኒች ብርተ ኒተኔሃ ቀዉንከ አጥራመቴነንታሁ ኤተሮንገ ሹልቴን አጥራመቴነንተገ ተብሳሃ አዕናም።<verse eid="2CO 1:13-14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 1:15"/>ከን ጠዋን ሀንቀኘ እኮምቤቺሃ አዕኑ ኢን ለሙ ወክት ደግለሸቀንቶኖተ ይ ጉዕመርቺችን ሄጭ ክዕኔቤቹ አሜቶተ ሀሾም። <verse eid="2CO 1:15"/><verse number="16" style="v" sid="2CO 1:16"/>አንን መቄዶን ባዱ መረንለከ ህከንቤቺች አሜተን ክዕኔቤቹ አሜቶተ ሰውይዮም እቅ፤ ህትን ክዕኔቤቺች ይሁድ ባዱ መራም ወክት ዎቄሃኤ ሽንቅተ ኣቴን ህርሲሴነንተኤገ ሰውይዮም እቅ።<note caller="-" style="x"><char style="xo" closed="false">1፥16 </char><char style="xt" closed="false"><ref loc="ACT 19:21">ሶቀ. 19፥21</ref>።</char></note> <verse eid="2CO 1:16"/><verse number="17" style="v" sid="2CO 1:17"/>ህትን አን ያጆም ወክት ሸኬምንዶ? ህትን አን ሰውያሚሁ መን ሰውትገ መቱርቹ «እሁን» ይ ፈንቀሽንገ «እሁንከ» የንትንዶ? <verse eid="2CO 1:17"/><verse number="18" style="v" sid="2CO 1:18"/>መገኑ ሀንቅንከ አመነሞኢሃ እኮገን ነኡሁ ኩልናንክዕኔ ላገት «እሁን» ይን «እሁንከ» ይኖታበአ። <verse eid="2CO 1:18"/><verse number="19" style="v" sid="2CO 1:19"/>አን ስላስለከ<note caller="+" style="f"><char style="fqa" closed="false">ስላሴ ዎሉ ሱዕሙስ፦ </char><char style="ft" closed="false">ስልዋኖሴት</char></note> ጢማቶስ ተማርሰኖህዕኔሁ መገን ቤቱ መሲህ ኢስ ጉዕመ ወክት «ኤ ሀንቄንከ» መቶረ «እሁን» መቶረ «እሁንከ ዩሃበአ።»<note caller="-" style="x"><char style="xo" closed="false">1፥19 </char><char style="xt" closed="false"><ref loc="ACT 18:5">ሶቀ. 18፥5</ref>።</char></note> <verse eid="2CO 1:19"/><verse number="20" style="v" sid="2CO 1:20"/>መገኑ ኣሴኔ ተብሶሁ ጉዕሙንኩ «እሁን» እኮሁ መሲህት፤ ነኡ መሲህን መገን ኬዕምኚሃ «ኣሚዕን» ይናሚሁ ከኒሃት። <verse eid="2CO 1:20"/><verse number="21" style="v" sid="2CO 1:21"/>ኔሳሃ ክዕኔን ሜጡበ መሲህን ጠረኝናምገ አዕዮኔሁ መገኑሃን፤ ቡሮኔሁ እሶት። <verse eid="2CO 1:21"/><verse number="22" style="v" sid="2CO 1:22"/>እስረ እሁኔ ለሊሰኖ ገይስ ማተመ ኒ አሌን አዕዮሁለከ ጠሊለ አያነስ ሩብት እሆተ ቀልቤንከኔ አፉሼኢሁ እሶት።<verse eid="2CO 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 1:23"/>አን ቆሮንቶስ ከተመ ፈንቀል አሜቱዕነ ፈቆሚሁ ኡሙዕር ሻዝሳንክዕኔበእገ ይዪት፤ ህከኒሃ መገኑ ምስክርሃእ። <verse eid="2CO 1:23"/><verse number="24" style="v" sid="2CO 1:24"/>አዕኑ አመዕነቶንከክዕኔ ጠረኝቴን ኡርቴነንተረ እኬንተቤቺሃ አዕኑ ሙንደኦኖተ ክዕኔን ሜጡበ አዕናምሀን ቤሉ አመዕነትክዕኔ አሌን ቀርቻኑተ እንካምበአ።<verse eid="2CO 1:24"/></para>
  <para style="b"/>
  <chapter eid="2CO 1"/>
  <chapter number="2" style="c" sid="2CO 2"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 2:1"/>ቴሱ ሻዝሶህዕኔተ ሀሳምበእቤቺሃ ለንኪሃ ክዕኔቤቹ አሜታምበእገ ሙርስጭዮም። <verse eid="2CO 2:1"/><verse number="2" style="v" sid="2CO 2:2"/>አን ክዕኔተ ሻዝሾንክዕኔጎሬ ሻዝሾንክዕኔ ክዕኔ ቤሉ ኤሳሃ ሙንዲሲሰኖ አይ ዮኤ? <verse eid="2CO 2:2"/><verse number="3" style="v" sid="2CO 2:3"/>አን ህት ከተቦንክዕኔሁ ክዕኔቤቹ አሜቾም ወክት ኤሳሃ ሙንዲሲሱ ሀሳ መኑ ሻዛበእገ ይዪት፤ መሰንትስ ኢ ሙንዲኑት ጉዕሚክዕኔ ሙንዲኑተ እሁስ አመዕናም። <verse eid="2CO 2:3"/><verse number="4" style="v" sid="2CO 2:4"/>መሰንትስ አን ልግቤ ኦርሻን፥ ቀልብ ጭንቃንለከ አበ እንጂጃን ከተቦንክዕኔ ክዕኔተ አበ ኢታንክዕኔገ ደጎኖታት ቤሉ ሻዝሶህዕኔታበአ።<verse eid="2CO 2:4"/></para>
  <para style="s1">መን ቤሱ «ፈቁን» ይተኔሃ</para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 2:5"/>መነ ሻዝሾ መንቹ አዪሁ ሄዕዮጎሬ ሻዥሾሁ ጠለዕል ኤሳሃ እሁዕነ ቤሱስ በትሱ እሁንከኤ ቤሉ ጉዕመንከኔ እህበረ ልግብንከኔ ሻዝሾኡ። <verse eid="2CO 2:5"/><verse number="6" style="v" sid="2CO 2:6"/>ህትኔ መንቺሃ ክዕኔች ልግቡኔ ቀጠኤንተስ ቅጣት ጌሱ እሀኖስ። <verse eid="2CO 2:6"/><verse number="7" style="v" sid="2CO 2:7"/>ህካን እኮቤቺሃ ሁኩ መንቹ አበ ሻዦቤቺሃ ተብሳሃ ሙረኖበዕገ አዕኑ እሱሃ ማሮንስ ዩለከ ጠረኝሱ ሀስሰኖህዕኔ። <verse eid="2CO 2:7"/><verse number="8" style="v" sid="2CO 2:8"/>ህትን እሶን ዮህዕኔ ኢተተ ፈንቀሽቴን ጠረኝሶኖተ ኡጫንክዕኔ። <verse eid="2CO 2:8"/><verse number="9" style="v" sid="2CO 2:9"/>አንን ህካን ከተቦንክዕኔሁ ፌተነንቴን ጉዕመ ጠዋንን አዘዘንቴንተረ እሁክዕኔ ደጎተ ይዪት። <verse eid="2CO 2:9"/><verse number="10" style="v" sid="2CO 2:10"/>አዕኑ ማሮንስ ይቴነንተስ መንቹ አዬሁ እኮጎሬ አኒሁ ማራንስ፤ ሁኩ መንቹ ቤሾርቹ ሄዕዮ ጎሬ አን መሲህ ብሬን «ማሮም» ያንሲሁ ክዕኔተኔሃት። <verse eid="2CO 2:10"/><verse number="11" style="v" sid="2CO 2:11"/>አን ህካን አኣሚሁ ሸይጣን ሂለ ጠወ ደንጋምቤቺሃ ኔሳሃ ጣንሰኖበእገ ይዪት።<verse eid="2CO 2:11"/></para>
  <para style="s1">ጢሮኣደ ዬኖቤቾን ጳዉሎስ ጨነቀሙስ</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 2:12"/>ህከኒች ኤተሮን መሲህ ተሽት ላገተ ተማርሶተ ጥሮኣድ ከተመ መሮም ወክት ቀርች ሆጎ ኡሩት ፈንተኦኤ እቅ። <verse eid="2CO 2:12"/><verse number="13" style="v" sid="2CO 2:13"/>እኮጎሬ አመኤ ቤቲን ቲቶን ደቀሙ ሆጎምቤቺሃ ቀልቡኤ ሻዦ እቅ፤ ህካን እኮቤቺሃ «ወገሬቲን ሄዕዬ» ይ እሳች አደ እክ መቄዶን ባዱ ኦሮዕዮም።<note caller="-" style="x"><char style="xo" closed="false">2፥12-13 </char><char style="xt" closed="false"><ref loc="ACT 20:1">ሶቀ. 20፥1</ref>።</char></note><verse eid="2CO 2:13"/></para>
  <para style="s1">እንጂሉ ቄለኖሃን</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 2:14"/>ጠዉ እኮጎሬ መሲሂን ጉዕመ ወክት ድለ አዕናምረ አዕይ አዎንሰኖኔለከ ኤንኬዕንስ አንጀኖ ፎገል ኒ መሳን ጉዕመ ቤቾን ለሊሰኖ መገኒሃ ገለቱ እሁንስ። <verse eid="2CO 2:14"/><verse number="15" style="v" sid="2CO 2:15"/>መሰንትስ ጡምታሀኑኡተለከ በኣሀኑኡ በላን መገኒሃ መሲሂን ጡሙ ፎገሉ ዮስ አንጀነተ እንኮም። <verse eid="2CO 2:15"/><verse number="16" style="v" sid="2CO 2:16"/>ህካን እኮቤቺሃ ነኡ በአኖ መኒሃ ሬሆተ አንጀነ፤ እኮጎሬ ፈቀኖ መኒሃ ሄዕተ አንጀነ፤ ህከን ጠዊሃ በቀአኖ መንቹ አዬት? <verse eid="2CO 2:16"/><verse number="17" style="v" sid="2CO 2:17"/>መሰንትስ ነኡ መገን ላገተ ነገዳ ልግቤ መንጋበአ፤ ጠዉ እኮጎሬ ነኡ መገኒች ሶሀሞ መንገ መሲህ አዲን መገን ብሬን አመዕነሞምረ እንክ ጠወዕናም።<verse eid="2CO 2:17"/></para>
  <chapter eid="2CO 2"/>
  <chapter number="3" style="c" sid="2CO 3"/>
  <para style="s1">ሃዕሮ ወኣድ ካዲመተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 3:1"/>ገዉኔ ፈንቀሽን ገለትጭናምትንዶ? ህከረንገ መት-መቱ መኑ አታሀንገን ክዕኔሃ ህከረንገ ክዕኔች ገይኔ ጡምመተ ለሊሳ ደብዳቤተ ሀስሳኔንዶ? <verse eid="2CO 3:1"/><verse number="2" style="v" sid="2CO 3:2"/>አዕኑ መኑ ጉዕሙንኩ ደገኖህዕኔሁለከ አነበበኖህዕኔሁ ቀልብኔ ኣዜን ከተበንቴንተ ደብዳቤተኔ። <verse eid="2CO 3:2"/><verse number="3" style="v" sid="2CO 3:3"/>አዕኑ ኒ ክድማን አሜቴንታሁ መሲህ ሶህኑተ እሁክዕኔ ለሊዮእሃን፤ ኩ ሶህኑት ከተበንቶኢሁ ሄአኖ መገን አያኒንት ቤሉ ቀለማንበአ፤ ህትን ከተበሞንኩ መን ቀልቤን ቤሉ ክኒ አሌንበአ።<note caller="-" style="x"><char style="xo" closed="false">3፥3 </char><char style="xt" closed="false"><ref loc="EXO 24:12">ፉል. 24፥12</ref>፤ <ref loc="JER 31:33">ኤር. 31፥33</ref>፤ <ref loc="EZK 11:19">ሕዝ. 11፥19</ref>፤ <ref loc="EZK 36:26">36፥26</ref>።</char></note><verse eid="2CO 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 3:4"/>ካን ይናም መሰንት መሲህ መሳን መገን አሌን አመዕነቱ ዮኔቤቺሃት። <verse eid="2CO 3:4"/><verse number="5" style="v" sid="2CO 3:5"/>ክድመ ሆጉተ አዕኖተ አታልናሚሁ ዎልቀተ ኣሰኖኔ መገኒንት ቤሉ ነኡ ጠረኛኑተ እንክበአ። <verse eid="2CO 3:5"/><verse number="6" style="v" sid="2CO 3:6"/>ሃዕሮ ወኣድ ላገ ካዲመተ እንኮተ ዎልቀተ ኣሴኔሁ እሶት፤ ሁኩንን ከተቤመ ሕጊን እሁዕነ መገን አያን ወልቃኒት፤ ከተቤመ ሕጉ ሬሁተ ኤበኖ፤ መገን አያኑ እኮጎሬ ሄኡ ኣሰኖ።<note caller="-" style="x"><char style="xo" closed="false">3፥6 </char><char style="xt" closed="false"><ref loc="JER 31:31">ኤር. 31፥31</ref>።</char></note><verse eid="2CO 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 3:7"/>ክኒ አሌን ከተበሞ ሕጉ አሜቾሁ ኬዕምኚንት፤ ሁኩን ሙስ ሚኔ አሌን ለለን ሄዕዮ ኬዕምኙ ሆፈአን ኦሮዕዮ ጎሬሁ ሚንስ አበ በለቃኢሃ እኮቤቺሃ እስራኤላውያኑት ሚንስ ቱክ ይት ለኦተ አታልቶበአ፤ ቴሱ ኩን ሬሆቤቹ አዎንሰኖ ሕጉ ህትኔ ሎረ ኬዕምኚን አሜቾሃ እኮች <verse eid="2CO 3:7"/><verse number="8" style="v" sid="2CO 3:8"/>ጠሊለ መገን አያን መሳን ደገመኖ ክድመት በተአኖ ኬዕምኙ ሄአኖስበእንዶ? <verse eid="2CO 3:8"/><verse number="9" style="v" sid="2CO 3:9"/>መሰንትስ መን አሌን ፍርደ ኤቦ ሆጎተ ኬንኩ ኬዕምኙ ሄዕዮች መኒ ፈይመተ ኤቦ ሆጎተ በተአኖ ኬዕምኙ ሀት ሄአኖስበአ? <verse eid="2CO 3:9"/><verse number="10" style="v" sid="2CO 3:10"/>ወዕና ሄዕዮ ኬዕምኙ ኤተሮን አሜቾ ኬዕምኚን ሜጡበ ለኤኖ ወክት መቱርቹሁ ኬዕምኙ ዮስበእሃ እሁስ ለዕናም። <verse eid="2CO 3:10"/><verse number="11" style="v" sid="2CO 3:11"/>ሁኩ በአን ኦሮአን ሄዕዮሁ ኬንኩ ኬዕምኙ ሄዕዮሲች ዘላለሚሃ ጠረኝ ሄአኖሁ ሀት በተዕዮ ኬዕምኙ ሄአኖስበአ።<verse eid="2CO 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 3:12"/>ቴሱ ህትኔ ተብሶሁ ሄዕዮኔች ነኡ መለልን ጠወዕናም። <verse eid="2CO 3:12"/><verse number="13" style="v" sid="2CO 3:13"/>እስራኤላውያኑት ሚኔሰ ኑሩ በአን ኦሮአኖሃ መጨረሸስ ለኣበእገ ሚንስ ሻሺን ድቦ ሙስጋበአ። <verse eid="2CO 3:13"/><verse number="14" style="v" sid="2CO 3:14"/>እሰ ቀልቡ ዱጆኡ፤ ከበሬ ኢለ ኑባቹ ወኣድ መጻፈ አነበቤኖረ ቀልቡሰ ህከን ሻሺን እፍሰሞጋንት፤ መሰንትስ ሁኩ እፍሰሞሁ ኬአኖሁ ጠለዕል መሲሂን እኮቤቺሃት። <verse eid="2CO 3:14"/><verse number="15" style="v" sid="2CO 3:15"/>ኤ ከበሬ ኢለ ሕግ መጻፈተ አነበበንታ ወክት ጉዕመንከ ሁኩ ሻሹ ቀልቤንከሰ ሄአኖ። <verse eid="2CO 3:15"/><verse number="16" style="v" sid="2CO 3:16"/>ጠዉ እኮጎሬ መኑ ቀርቾ ኢሲበ ፈንቀሎ ወክት ሁኩ ሻሹ ሽቀኖ። <verse eid="2CO 3:16"/><verse number="17" style="v" sid="2CO 3:17"/>ህትን ቀርቹ አያነ እኮቤቺሃ ቀርች አያኑ ዮቤቾን ጉዕማንን ሰዎልድመት ዮኡ። <verse eid="2CO 3:17"/><verse number="18" style="v" sid="2CO 3:18"/>ነኡ ጉዕሙንኩኔ ጌረደሞበእ ሚኔን እንክ ለአቃንቺን ለእናምሀንገ ቀርች ኬዕምኝ ለዕናም፤ ነኡ ኬዕምኚች ኬዕምኜን እሱ አጉዲሃ ዶረማሚት፤ ሁኩን እኮሁ አያነ እኮ ቀርቺችት።<verse eid="2CO 3:18"/></para>
  <chapter eid="2CO 3"/>
  <chapter number="4" style="c" sid="2CO 4"/>
  <para style="s1">ሀንቅ ክድመተ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 4:1"/>መገን ማርቶን ኩ ሆጉት ዮኔቤቺሃ ተብሳሃ ሙርናምበአ። <verse eid="2CO 4:1"/><verse number="2" style="v" sid="2CO 4:2"/>ጠዉ እኮጎሬ ማጠሞለከ ሙልሲሰኖ ጠወ ኡጅኖም፤ ተንኩተ አዕናምበአ፤ መገን ላገተ ክዝቢን ልቀለንቃምበአ፤ ህከን ወጢ ሀንቅ በነቻን ለሊንሳም፤ ሀንቅ ለልሲን እኮጎሬ መገን ብሬን ጡመ አዕኖሚሃ እሁኔ መኒሃ ጉዕሚንከ ለሊንሳም። <verse eid="2CO 4:2"/><verse number="3" style="v" sid="2CO 4:3"/>ነኡ ተማርስኖም እንጂል ላገት አይደጎ ማጠሞሃ እኮጎሬ ማጠሞሁ በአኖሁ መኒሃት። <verse eid="2CO 4:3"/><verse number="4" style="v" sid="2CO 4:4"/>ህትን መገን ምሳልተ እኮ መሲህ ሎርመተኔሃ ኩለሞ ተሽት እንጂል ላገ ኑር ለኣበእገ ከን ኣዱንያ አል ሸይጣኑ መገኑ አመዕንቶብእ መን ቀልብ ቆቅሾኡ። <verse eid="2CO 4:4"/><verse number="5" style="v" sid="2CO 4:5"/>ነኡን መሲህ ኢስ ቀርቹ እሁስለከ ነኡ ገዉኔ ኢስተኔሃ ክዕኔ ካዲመተ እንኮም ቤሉ ገይኔተኔሃ ተማርስናምበአ። <verse eid="2CO 4:5"/><verse number="6" style="v" sid="2CO 4:6"/>መሰንትስ «ቱንስች ኣዚች ኑሩ ፉሉን» ይ ጠወዕዮ መገኑ መሲህ ብሬን ለሊሰኖ መገን ኬዕምኙ ደንጋም ኑር ኣሶኔተ ኑሩስ ቀልብኔ ኣዜን ለሊሰኖገ አዕዮ።<note caller="-" style="x"><char style="xo" closed="false">4፥6 </char><char style="xt" closed="false"><ref loc="GEN 1:3">ክል. 1፥3</ref>።</char></note><verse eid="2CO 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 4:7"/>ጠዉ እኮጎሬ ኩ ሎሩ ዎልቀት መገኒሃ እሁንስ ቤሉ ኒሃ እሁ ሆጉስ ለልሲሃ ኩ ሎሩ ጠዉ ትብ ኦዳገ እንኮም ኒ ኣዜን ዮኡ። <verse eid="2CO 4:7"/><verse number="8" style="v" sid="2CO 4:8"/>ኔሳሃ ጉዕመ አዲንን ኦርሸት እልታኔ፤ ጠዉ እኮጎሬ ቄለማምበአ፤ ልግብ ወክት ጉረተ ኣገኖኔ ቤሉ ተብሳሃ ሙርናምበአ። <verse eid="2CO 4:8"/><verse number="9" style="v" sid="2CO 4:9"/>ህትን ሸሬኖኔ ቤሉ ሜጢሃኔ እንክ ፈንቃምበአ፤ ዎቀረም ኡንባም፤ እኮጎሬ ሬናምበአ። <verse eid="2CO 4:9"/><verse number="10" style="v" sid="2CO 4:10"/>ኢስ ሄኡ አሌኔ ለሎተ ጉዕመ ወክት ጅስምኔ አሌን ኢስ ሬሁተ እጅን ዘህናም። <verse eid="2CO 4:10"/><verse number="11" style="v" sid="2CO 4:11"/>መሰንትስ ኢስ ሄኡ ሬሀኖ ጅስማንከኔ ለሎተ ኔሳሃ ቴሱ ፎሊን ዮምረ ኢስተኔሃ ጉዕመ ወክት ሬሆተ ህግሴን ኣሴኖኔ። <verse eid="2CO 4:11"/><verse number="12" style="v" sid="2CO 4:12"/>ህካን እኮቤቺሃ ሬሁት ኒ አሌን ሆጉተ አታአ። እኮጎሬ ሄኡክዕኔ አሌን ሆጉተ አአኖት።<verse eid="2CO 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 4:13"/>እሁን ቤሉ «አመዕንዮም፤ ህካን እኮቤቺሃ ጠወዕዮም» የመም ከተበሞቤቺሃ ሁኩ አመዕነት ቀልቡ ዮኔቤቺሃ ነኡ አመዕንናም፤ ህካን እኮቤቺሃ ጠወዕናም።<note caller="-" style="x"><char style="xo" closed="false">4፥13 </char><char style="xt" closed="false"><ref loc="PSA 116:10">መዝ. 116፥10</ref>።</char></note> <verse eid="2CO 4:13"/><verse number="14" style="v" sid="2CO 4:14"/>ቀርቹ ኢሰ ሬሆች ኬሾ መገኑ ኔሳሃ ኢሲን ሜጡበ ኬሰኖኔገለከ ክዕኔንን ሜጡበ እስ ብርተ ሆንጠህሰኖኔገ ደንጋም። <verse eid="2CO 4:14"/><verse number="15" style="v" sid="2CO 4:15"/>ሁኩን ጉዕሙንኩ እኮሁ ክዕኔተ ደግለልሃት። ኣስቱት ልግቤ መኒሃ ኢልቶኢሁ መገኒሃ ኬዕምኝ እሀኖ ገለቱ በተኦታት።<verse eid="2CO 4:15"/></para>
  <para style="s1">አመዕነቲን ሄኡ</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 4:16"/>አብልን ለኤኖ ጅስሙኔ በአን መሮ ጎሬ ኣዝኔ ጅስሙ በሬን በሬን ሃዕሮሃ እኮቤቺሃ ተብሳሃ ሙርናምበአ። <verse eid="2CO 4:16"/><verse number="17" style="v" sid="2CO 4:17"/>ከን ቀዎ ወክቲሃ ኦርጨማም ኬዕምትበ ወክትስ ኦርሸት ሎረለከ ዘላለሚሃ ሄአኖ ኬዕምኚሃ ቅጥ አታኔት። <verse eid="2CO 4:17"/><verse number="18" style="v" sid="2CO 4:18"/>መሰንትስ ነኡ ኦሎንሰን ዮሚሁ ለልባሃት ቤሉ ለለኖሃበአ፤ ለለኖርቹ ቀወ ወክቲሃት፤ እኮጎሬ ለልበርቹ ዘላለሚሃ ሄአኖሃን።<verse eid="2CO 4:18"/></para>
  <para style="b"/>
  <chapter eid="2CO 4"/>
  <chapter number="5" style="c" sid="2CO 5"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 5:1"/>ኩ ዱካንገ ዮ ኣዱንያ አል ምኑኔ ድጀሞች መን አንጋን እሁዕነ መገኑ እጃሮ ዘላለሚሃ ሄአኖ ምኑ ሰማን ዮኔሃ እሁስ ደንጋም። <verse eid="2CO 5:1"/><verse number="2" style="v" sid="2CO 5:2"/>ሀንቅንከ ነኡ ሰሜ ምኒኔ ኦደዕኖተ አበ አዛንባሚት። <verse eid="2CO 5:2"/><verse number="3" style="v" sid="2CO 5:3"/>መሰንትስ ህካን ኦደዕኖሚች ኤተሮን ከልን እንካምበአ። <verse eid="2CO 5:3"/><verse number="4" style="v" sid="2CO 5:4"/>ህትን ከን ዱካናን ዮም ጌሳን ኬዕሜሃኔ አዛንባም፤ ነኡ ኦርጨቀማሚሁ ሬሀኖ ማሉኔ ሄኦን ዶረሞተ ሰማን ዮ ምኒኔ ኣንጎተ ሀንሲት ቤሉ ከን ኣዱንያ አል ጠዊች አደ እሂሃ ሀንስበአ። <verse eid="2CO 5:4"/><verse number="5" style="v" sid="2CO 5:5"/>ከን ጠዊሃ ቅጥ አዕዮኔሁለከ ጠሊለ አያነ ኔሳሃ ሩብት እሆተ ኣሴኔሁ መገኑሃን።<note caller="-" style="x"><char style="xo" closed="false">5፥5 </char><char style="xt" closed="false"><ref loc="ROM 14:10">ሮሜ 14፥10</ref>።</char></note><verse eid="2CO 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 5:6"/>ነኡ ማሊን ከን ኣዱንያ አሌን ዮም ጌሳን ቀርቺን ሜጡበ ሄኡ ሆጉኔ ደንጎምጎሬ ጉዕመ ወክት እሱ አመዕንን ሄዕናም። <verse eid="2CO 5:6"/><verse number="7" style="v" sid="2CO 5:7"/>መሰንትስ ነኡ ሄዕናሚሁ አመዕኒንት ቤሉ ለእንበአ። <verse eid="2CO 5:7"/><verse number="8" style="v" sid="2CO 5:8"/>ህትን ከን ማሊች አደ እንክ ቀርቾሃ ኢሲን ሜጡበ ሄዕኖተ ሄዕላንታምቤቺሃ አመዕነንሺን ሄዕናም። <verse eid="2CO 5:8"/><verse number="9" style="v" sid="2CO 5:9"/>ህካን እኮቤቺሃ ማሊንከኔ ሄዕኖም ጎሬ ህከረንገ ማሊችኔ አደ እንኮምጎሬ ሰውቱኔ መገኑ ሙንዲሲሱሃን። <verse eid="2CO 5:9"/><verse number="10" style="v" sid="2CO 5:10"/>መሰንትስ መት-መቱስ ማሊንከስ አዕዮ ጡመ ጠዊሃ እኮ ሂለ ጠዊሃ ሆጎስ ዋገ ሀስሰኖስርቹ ቶጊሃ ጉዕሙንኩኔ መሲህ ፍርድ ቦርጭመ ብርተ ሆንጠሁ ሀስሰኖኔ።<verse eid="2CO 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 5:11"/>ቀርቹ ዋጁ ዩ መ ዩሃ ጎሬ ደንጋምቤቺሃ መኑሁ ደገኖገ አዕናም፤ እኮጎሬ ነኡ ሀትናሞሃ መነ ጎሬ መገኑ ደገኖ፤ ክዕኔ ቀልቡሁ ህካን ደገኖሃ እሁስ ተብሳሃ አዕናም። <verse eid="2CO 5:11"/><verse number="12" style="v" sid="2CO 5:12"/>ቀልብ ኣዜን ዮ ጠዋን እሁዕነ ለለኖ ጠዋን ድከኣ መኒሃ ፈንቀሽቴነንተ መስሉ ሄኦህዕኔተ ኒን ድከኤነንተ ዎቃሃ ደእቴነንተገ አዕኖህዕኔታት ቤሉ ቴሱ ገዉኔ ክዕኔ ብሬን ገለትጭኖታበአ። <verse eid="2CO 5:12"/><verse number="13" style="v" sid="2CO 5:13"/>ነኡ በርገጋሸ እንኮምጎሬሁ መገኒሃ ይኒት፤ ህትን ኤንኬዕናመተ እንኮምጎሬ ክዕኔኤሃ ይኒት። <verse eid="2CO 5:13"/><verse number="14" style="v" sid="2CO 5:14"/>መቱ ወክት መሲህ መኒሃ ጉዕሚንከ ሬሁስለከ መኑ ጉዕሙንኩ እስ ሬሆተ ቤቃማኑተ እሁሰ ደንጎምቤቺሃ መሲህ ኢተቲ ሆጎተ ግዳጅሳኔ። <verse eid="2CO 5:14"/><verse number="15" style="v" sid="2CO 5:15"/>ህትን ፎሊን ዮ መኑ ጉዕሙንኩ እሳሃ ይ ሬዮለከ ሬሆች ኬዕዮ መሲህሃ ሄኦታት ቤሉ ከ ኤተሩ ገይሀሰ ይት ሄኣበእገ መሲህ ጉዕሚንከ ሬዮ።<verse eid="2CO 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 5:16"/>ቴሱ ከ ኤተሩ አዬሁ መኑ ለአኖ ሃሊን ለዕናምበአ፤ ነኡ መሲህ ከኒች ብርተ ህት ለእኖም ጎሬ ከኒች ኤተሮን እኮጎሬ ህት ለዕናምበአ። <verse eid="2CO 5:16"/><verse number="17" style="v" sid="2CO 5:17"/>ህካን እኮቤቺሃ አዪሁ መሲሂን እኮጎሬ ሃዕሮሃ ክልቀት፤ ኑባቹ ክልቀቱ ህጎኡ፤ እሲንን ሃዕሮ ክልቀቱ አሜቾኡ። <verse eid="2CO 5:17"/><verse number="18" style="v" sid="2CO 5:18"/>ሁኩ ጉዕሙንኩ ጠዉ እኮሁ ኔሳሃ ገይንከስ መሲህ አዲን ሀራርሴኔለከ ሀራሮ ሆጉተ ኣሴኔ መገኒችት። <verse eid="2CO 5:18"/><verse number="19" style="v" sid="2CO 5:19"/>መገኑንኩ መን ጩብ ዎለኡዕነ መሲህ አዲን ከን ኣዱንያ አል መነ ገይንከስ ሀራርሴ ዩሃን፤ መነ ቀርቺን ሀራርስ ላገተ ኔሳሃ ኣሴኔ።<verse eid="2CO 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 5:20"/>መገኑ ኒ አዲን መነ ገአኖቤቺሃ ነኡ መሲህሃ ወከለሞምራን፤ ህካን እኮቤቺሃ ነኡን «መገኒን ሀራዕረሜ» ይን መሲህ ሱዕሚን ኡጭናንክዕኔ። <verse eid="2CO 5:20"/><verse number="21" style="v" sid="2CO 5:21"/>ነኡ መሲህ አዲን መገኒሃ ፈየ እንክ ዎለአሞተ ጩቡ ዮበእ መሲሂ መገኑ ኒተኔሃ ጩበኝገ አዕይ ዎለዕዮስ።<verse eid="2CO 5:21"/></para>
  <chapter eid="2CO 5"/>
  <chapter number="6" style="c" sid="2CO 6"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 6:1"/>ነኡ መገኒን ሜጡበ አዕናምረ እንኮምቤቺሃ መገኒች ቶጌንተ ኣስቱተ ተሰ አቴነንተበእገ ኡጭናንክዕኔ። <verse eid="2CO 6:1"/><verse number="2" style="v" sid="2CO 6:2"/>መሰንትስ መገኑ</para>
  <para style="q1" vid="2CO 6:2">«አን ኢታም ወክቴን ሞጮጬንስ!</para>
  <para style="q2" vid="2CO 6:2">ጡም በርንከ ሀዕሌንኬ» የኖቤቺሃ</para>
  <para style="m" vid="2CO 6:2">«እስ ኢተኖ ወክቱ ቴሶት፤ ጡሜኖ በሩ ቴሶት።»<note caller="-" style="x"><char style="xo" closed="false">6፥2 </char><char style="xt" closed="false"><ref loc="ISA 49:8">ኢሳ. 49፥8</ref>።</char></note><verse eid="2CO 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 6:3"/>ኒ ሆጉት ህንቀንታበእገ ይን መ ጠዋን አዬሁ ጉፉቹ እንካምበአ። <verse eid="2CO 6:3"/><verse number="4" style="v" sid="2CO 6:4"/>እሁን ቤሉ አዕናም ጠዋን ጉዕማንን ገውኔ መገን ካዲመገ ሆንጠህንሳም፤ ሁኩንን አበ ኦርሻን፥ ሻዞን፥ ጭንቃን፥ <verse eid="2CO 6:4"/><verse number="5" style="v" sid="2CO 6:5"/>ገረፈሚን፥ ኡሱረሚን፥ ረብሻን፥ ሆጎ በትኜን፥ ግሰኛተ ሆጊንለከ ጎሪንት።<note caller="-" style="x"><char style="xo" closed="false">6፥5 </char><char style="xt" closed="false"><ref loc="ACT 16:23">ሶቀ. 16፥23</ref>።</char></note> <verse eid="2CO 6:5"/><verse number="6" style="v" sid="2CO 6:6"/>ህትን ነጢማን፥ ኤንኬዕኒን፥ አደቢን፥ ጎደበ ላፍማን፥ ጠሊለ አያኒን፥ ሀንቅ ኢታን፥ <verse eid="2CO 6:6"/><verse number="7" style="v" sid="2CO 6:7"/>ሀንቅ ጠወ ጠወኢንለከ መገን ዎልቃን ሄዕኖም፤ ፈይመ በገዝ ኦዳተ ጉረለከ መኬ አንጋን አፊኒት። <verse eid="2CO 6:7"/><verse number="8" style="v" sid="2CO 6:8"/>ኬዕምኚንለከ ሆፍኚን፥ ገለትጨሚንለከ ቦሮረሚን ሄዕኖም፤ ሀንቀኛኑተ እንከን ክዝበኛኖገ ዎለአሞም፤ <verse eid="2CO 6:8"/><verse number="9" style="v" sid="2CO 6:9"/>ደገማምረ እንከን ደገምበረ እንኮም፤ ሬቶ ዬነን ፎሊን ዮምረ እንክ ደገማም፤ ኦሌመኔጎሬሁ ሬኖምበአ፤ <verse eid="2CO 6:9"/><verse number="10" style="v" sid="2CO 6:10"/>ሻዙት ኢልቶኔጎሬ ጉዕመ ወክትንከ ሙንደዕናም፤ ቡጥቻኑተ እንኮምጎሬሁ ልግብ መነ ቀባጣመተ አዕናም፤ መቱርቹሁ ዮኔበእረ እንኮምጎሬሁ ጉዕሙርቹንኩ ኒሃን።<verse eid="2CO 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 6:11"/>ቆሮንቶስ ከተማን ዮንተ መኑ! ነኡ መቱርቹሃ ፌንሱዕነ ኩልኖንክዕኔ፤ ቀልብኔ አልባሽን ፈኖንክዕኔ። <verse eid="2CO 6:11"/><verse number="12" style="v" sid="2CO 6:12"/>አዕኑ ኢተክዕኔ ኔሳሃ ከንቴንታኔ ቤሉ ነኡ ኢተኔ ክዕኔሃ ከሞምበአ። <verse eid="2CO 6:12"/><verse number="13" style="v" sid="2CO 6:13"/>ጠዉ እኮጎሬ አዕኑ እለኤ እኬንተቤቺሃ ያንክዕኔ፤ ነኡ ቀልብኔ ጠወ ማንጡዕነ ኩልኖንክዕኔገን አዕኑሁ ቀልብክዕኔ ጠወ ማጦኑዕነ ኩሌኔ።<verse eid="2CO 6:13"/></para>
  <para style="s1">አመዕንበ መኒን ሜጡ እሁ ገበእባሃ እሁስ</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 6:14"/>አመዕንበ መኒን ገበእበ ዎቄን ጠመደንቶኖቼ፤ መሰንትስ ፈይመትለከ ጩቡ ሀት እክ ደቀንቶተ አታልታአ? ህትን ኑሩለከ ቱንስቹ ሀት እክ ሜጡበ ሄኦተ አታልታአ? <verse eid="2CO 6:14"/><verse number="15" style="v" sid="2CO 6:15"/>ህትን መስሂሃለከ እልብሲሃ<note caller="+" style="f"><char style="fqa" closed="false">እልቢሱ፦ </char><char style="ft" closed="false">ግሪክ አፎን «ቤልያል» ህከረንገ «ቤልያር» ዕብራይስጥ አፎን «ቤልዐል» ዬኖስ። ፍሳረንትስ «ከልበ እኮሃ» ህከረንገ «ሕጉ ዮስበኢሃ» ዩ እሀን ሻይጣኒሃ ኣሰሞስየ ሱዕመ።</char></note> ም ደቀንሹ ዮሰ? ህትን አመዕኔኢሁለከ አመዕንቡሁ ሚን ደቀንታአ? <verse eid="2CO 6:15"/><verse number="16" style="v" sid="2CO 6:16"/>መገን ምኑ ሽርኬን ም ደቀንሹ ዮኡ? መሰንትስ መገኑ</para>
  <para style="q1" vid="2CO 6:16">«አን እሳን ሜጡበ ሄኣም፤</para>
  <para style="q2" vid="2CO 6:16">በላንከሰ ፈንቀላማም፤</para>
  <para style="q1" vid="2CO 6:16">መገኑሰን እሃም፤</para>
  <para style="q2" vid="2CO 6:16">እሰን ኡመቲኤ እካአ»</para>
  <para style="m" vid="2CO 6:16">ይ ጠወዕዮገን ነኡ ጉዕመንከ አታለኖ መገንያ ምኒ።<note caller="-" style="x"><char style="xo" closed="false">6፥16 </char><char style="xt" closed="false"><ref loc="LEV 26:12">ሌዌ 26፥12</ref>፤ <ref loc="EZK 37:27">ሕዝ. 37፥27</ref>፤ <ref loc="1CO 3:16">1 ቆሮ. 3፥16</ref>፤ <ref loc="1CO 6:19">6፥19</ref>።</char></note> <verse eid="2CO 6:16"/><verse number="17" style="v" sid="2CO 6:17"/>ህካን እኮቤቺሃ ቀርቹ</para>
  <para style="q1" vid="2CO 6:17">«እሰ ኣዚች ፉልቴን አደ እኬ፤</para>
  <para style="q2" vid="2CO 6:17">ንጃሾሃ መርቹሃ ኡልቶኖቼ፤</para>
  <para style="q2" vid="2CO 6:17">አንን ኢረ አዕይ ቶጋንክዕኔ፤<note caller="-" style="x"><char style="xo" closed="false">6፥17 </char><char style="xt" closed="false"><ref loc="ISA 52:11">ኢሳ. 52፥11</ref>።</char></note><verse eid="2CO 6:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="2CO 6:18"/>ህትን አን አነክዕኔ እሃም፤</para>
  <para style="q2" vid="2CO 6:18">አዕኑ ኤሳሃ ጎነለከ ሜኣ እለተ እኬነንተ</para>
  <para style="q2" vid="2CO 6:18">የኖ ጉዕመንከ አታለኖ ቀርቹ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">6፥18 </char><char style="xt" closed="false"><ref loc="2SA 7:14">2 ሳሙ. 7፥14</ref>፤ <ref loc="1CH 17:13">1 ዱዱ. 17፥13</ref>፤ <ref loc="ISA 43:6">ኢሳ. 43፥6</ref>፤ <ref loc="JER 31:9">ኤር. 31፥9</ref>።</char></note><verse eid="2CO 6:18"/></para>
  <chapter eid="2CO 6"/>
  <chapter number="7" style="c" sid="2CO 7"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 7:1"/>ቴሱ ኢ ጃላ! ኩ ጉዕሙንኩ ተብሶሁ ኣሰሞሁ ኔሳሃ እኮቤቺሃ ማለለከ አያነ ንጃስሰኖ ሀከን ጠዊች ገዉኔ አገዕርኖ፤ መገኑ ዋጂን ዊመ ዊሚን ጠሊልማን ሄዕኖ።<verse eid="2CO 7:1"/></para>
  <para style="s1">ጰውሎሴ ሙንዲኑተ</para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 7:2"/>ቀልቢን ቶጌኔ፤ ነኡ ሜጡ መንቹሃ በደልኖምበአ፤ መቱ መንቹሃ ምርኖምበአ፤ መቱ መንቹሃ ደግለሸቀማምሃ አዕኖምበአ። <verse eid="2CO 7:2"/><verse number="3" style="v" sid="2CO 7:3"/>ካን ይናሚሁ ክዕኔ አሌን ፈረንዶታበአ። ከኒች ብርተ ኩሎንክዕኔገን አዕኑ ቀልብኔ ኣዜኒት፤ ህካን እኮቤቺሃ ሄኦን እኮ ሬሆን ጉዕመ ወክት ክዕኔች መለዕለማምበአ። <verse eid="2CO 7:3"/><verse number="4" style="v" sid="2CO 7:4"/>ክዕኔ አሌን ዮኤ አመዕነቱ አበሃን፤ ክዕኔን አበ ቦናም፤ ክዕኔን ጠረኝመተ ደኣም፤ ኦርሻንተኔ ጉዕማኒን ሙንዲኑኔ ዳንጉ ዮስበአ።<verse eid="2CO 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 7:5"/>ነኡ መቅዶን ባዱ አሜንቶም ወክት ጉዕመ አዲን ኦርሸት አሌንከኔ እልቶኔ ቤሉ ጅስሙኔ ፎሎጭዮበአ፤ አብሊን ብተተ ሄኦ እቅ፤ ኣዚን ዋጁ ሄዕዮኔ እቅ።<note caller="-" style="x"><char style="xo" closed="false">7፥5 </char><char style="xt" closed="false"><ref loc="2CO 2:13">2 ቆሮ. 2፥13</ref>።</char></note> <verse eid="2CO 7:5"/><verse number="6" style="v" sid="2CO 7:6"/>ጠው እኮጎሬ ሻዦ መነ ጠረኝሰኖ መገኑ ቲቶ አሜቲን ጠረኝመተ ኣሴኔ። <verse eid="2CO 7:6"/><verse number="7" style="v" sid="2CO 7:7"/>ጠረኝኖሚሁ ትቶ አሜቲን ጠለዕል እሁዕነ አዕኑ እሱ ጠረኝሴንተገ ሞጮጭኒት፤ ህትን አዕኑ ኤሳሃ ለኦኖተ ሱንቴንተገ፥ ኤሳሃ ጨነቀንቴንተገለከ እኮ ጠዋን ሰጩሰ ሞጮጭኖም ወክት አበ ተሽ ዬኤ።<verse eid="2CO 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 7:8"/>ከኒች ብርተ ከተቦንክዕኔ ደብዳቤት ሻዝሳህዕኔጎሬ ሚሃ ከተቦም ይ ሰጫምበአ፤ ሰጬም ጎሬ ሰጬም ሶህኖንከኤ ቀዎ ወክቲሃ ሻዝሶህዕኔቤቺሃት። <verse eid="2CO 7:8"/><verse number="9" style="v" sid="2CO 7:9"/>ቴሱ እኮጎሬ ተሽ ይዮኤ፤ መሰንትስ ኤሳሃ ተሽ ዬኤሁ ክዕኔተ ሻዝሾንክዕኔቤቺሃ እሁዕነ ሻዘነክዕኔ መሳን ቶበቴን ፈንቀልቴንተቤቺሃት፤ ቴሁ ሻዘነክዕኔ መገኑ ዬገ እኮቤቺሃ ነኡ መቱርቹሃ በደልኖንክዕኔበአ ዩሃን። <verse eid="2CO 7:9"/><verse number="10" style="v" sid="2CO 7:10"/>መገን አዲን እኮ ሻዘነት ጡም አደ አዎንሰኖ ቶበቲን ደገመኖ ዶረንሸ ደግሲሰኖቤቺሃ ሰጫቱንት ዮስበአ፤ እኮጎሬ ኣዱንያ አል ሻዘነት ሬሁተ ኤባአ። <verse eid="2CO 7:10"/><verse number="11" style="v" sid="2CO 7:11"/>ኩ መገን አዲን እኮ ሻዘነት ሀትኔ ጠረኝመተ፥ ሀትኔ መስለ ኣሱ፥ ሀትኔ ጡመ ኡሙዕርተ፥ ሀትኔ ከበጅ ዋጁ፥ ሀትኔ ሱኑ፥ ሀትኔ ጡመ ሃሸኡ፥ ሀትኔ ሀንቅ ፍርዱ እሀን ለኤኖ ሄዕላቸተ ደግሲሾህዕኔገ ጡመገ ቀልቢን ለዕዬ። አዕኑ ከን ጠዋን ነጣኑተ እሁክዕኔ ጉዕመ አዲንን መሰከርሲሴንታአ። <verse eid="2CO 7:11"/><verse number="12" style="v" sid="2CO 7:12"/>አን ከተቦንክዕኔሁ ኔሳሃ ዮህዕኔሁ ጡሙ ሰዉቱ መገንሀኔን ክዕኔሃ ጡመገ ለሉን ይዪት ቤሉ ቤሾ መንችተኔሃ ህከረንገ ምዕርተዕዮ መንችተኔሃበአ። <verse eid="2CO 7:12"/><verse number="13" style="v" sid="2CO 7:13"/>ህካን እኮቤቺሃት ነኡ ጠረኝመተ ደእኖሚሁ ህከን መሳኒት፤ ኒ ጠረኝማች አበ አዕኑ ጉዕሙንኩክዕኔ ቲቶ ቀልብ ፎሎስሴነን ቲቱ ሙንደዕዮቤቺሃ ነኡ አበ ሙንደዕኖም። <verse eid="2CO 7:13"/><verse number="14" style="v" sid="2CO 7:14"/>አን ክዕኔን ድከኣምገ ቲቶሃ ኩሎም እቅ፤ አዕኑሁ ሙልሴንታኤበአ፤ ነኡ ጉዕመንከ ወክት ሀንቅ ኩልኖንክዕኔ፤ ህከንገን ክዕኔን ድከዕናምገ ቲቶሃ ኩልኖም ሀንቅ እሁስ ተሬገጠሞኡ። <verse eid="2CO 7:14"/><verse number="15" style="v" sid="2CO 7:15"/>ህካን እኮቤቺሃ ቲቶ ዋጅቴነንለከ ሁጤነን ጉዕሙንኩክዕኔ አዘዘንቴን ቶጌንተስገ ሰዉ የኖ ወክት ክዕኔሃ ዮስ ኢተት አበሃን። <verse eid="2CO 7:15"/><verse number="16" style="v" sid="2CO 7:16"/>አን ክዕኔን አመዕነሙ አታሎምቤቺሃ አበ ተሽ ይዮኤ።<verse eid="2CO 7:16"/></para>
  <chapter eid="2CO 7"/>
  <chapter number="8" style="c" sid="2CO 8"/>
  <para style="s1">ኦርጨንቶ አመዕናኖተ ኣሴመ ሀዕላቀንሸ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 8:1"/>አመኤ ኦሶ! መገኑ መቄዶን ባዶን ዮ መገን መኒሃ ኣሴ ኣስቶተኔሃ ደጎኖተ ሀንሳም። <verse eid="2CO 8:1"/><verse number="2" style="v" sid="2CO 8:2"/>እሰ አሌንን አቡ ኦርሸት እካን ፌተነንቶኡ፤ እሁን ቤሉ ሙንዲኑሰ አበ እኮቤቺሃ እሰ መሃ ቡጥቻኑተ እኮጎሬ ሙንዲኖን አበርቹ አቶኡ። <verse eid="2CO 8:2"/><verse number="3" style="v" sid="2CO 8:3"/>እሰን አታልቶ ጌሰ እሁዕነ አታልታሀኒች አበ ኢትት ኣቶ ኣስቶገ መሰከራም። <verse eid="2CO 8:3"/><verse number="4" style="v" sid="2CO 8:4"/>ቴሁ እሰ «መገን መኒሃ ሀዕለኖ ብረ ነኡ ጭም አዕናም» ይት ጠረኝስ ኡጭቶኔ።<note caller="-" style="x"><char style="xo" closed="false">8፥1-4 </char><char style="xt" closed="false"><ref loc="ROM 15:26">ሮሜ 15፥26</ref>።</char></note> <verse eid="2CO 8:4"/><verse number="5" style="v" sid="2CO 8:5"/>ህትን እሰ ነኡ አገርኖምሀኒች አበሃት ኣቶኢሁ፤ ወዕናሃ ገውሰ ቀርቹሃኔ መሲህ ኢሲሃ ህግስ ኣቶኡ፤ ህከኒች ኤተሮን መገን ሰውትገ ገውሰ ኔሳሃ ህግስ ኣቶኡ። <verse eid="2CO 8:5"/><verse number="6" style="v" sid="2CO 8:6"/>ከ ሆጉተ ወዕናንከ ጀመሮሁ ቲቶ እኮቤቺሃ ቴሁ እስ ገውንኩስን ህከ ጡመ ሆጉተ ሹል አኦተ ኡጭኖንስ። <verse eid="2CO 8:6"/><verse number="7" style="v" sid="2CO 8:7"/>አዕኑ ጉዕመርቾንን እስን አመዕነቲኒ፥ ጠወኤነንተ ጠዊኒ፥ ኤንኬዕኒን፥ ጡመ ሆጎን ጠረኚን፥ ኒን ዮህኔ ኢታን በተኤን ደገንቴንተገን ከን መኒሃ አኤኖ ጡመ ሆጎን በተዕዬ።<verse eid="2CO 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 8:8"/>አን ህት ያንክዕኔሁ ክዕኔተ አዘዞታበአ፤ ጠዉ እኮጎሬ ዎሉሰ ሀዕልቶተ አበ አጰንታቤቺሃ ክዕኔ ኢተተ ሀንቅ እሁስ አጥራመቶተ ይዪት። <verse eid="2CO 8:8"/><verse number="9" style="v" sid="2CO 8:9"/>አዕኑ ቀርቹሃኔ መሲህ ኢስ ኣስቱተ ደጌነንተ፤ እስ መሃ ቀባጣሙ እኮጎሬ እስ ቡጥማን አዕኑ ቀባጣመተ እኮኖተ ክዕኔተኔሃ ቡጥቹ ኢኮኡ። <verse eid="2CO 8:9"/><verse number="10" style="v" sid="2CO 8:10"/>ከን ጠዊተኔሃ ደግለለኖህዕኔ ጠወ ሸዛንክዕኔ፤ ኑሬ ዘማንች ጀመርቴን ጠለዕል ኣሲሃ እሁዕናን ከ ጠወ አቶኖተ ሰዉ ይቴነንተሩ ብሬሩ አዕኖት እቅ። <verse eid="2CO 8:10"/><verse number="11" style="v" sid="2CO 8:11"/>ህካን እኮች ዮህዕኔ ጌሲች ኣቶኖተ ሰው ይቴንተ ሰዊቱክዕኔ ዊሞተ ቴሁ ህከ ሆጉተ ሹልቴን አዕዬ። <verse eid="2CO 8:11"/><verse number="12" style="v" sid="2CO 8:12"/>መቱ መንቹ ዮስበእ ጌስን እሁዕነ ዮስ ጌስን ኢት ኣሰኖሃ እኮች ህከን ኣሴርቾን መገኑ ሙንደአኖ። <verse eid="2CO 8:12"/><verse number="13" style="v" sid="2CO 8:13"/>አን ካን ያሚሁ ጉዕሙንኩክዕኔ ቅጡ እኮኖታት ቤሉ አዕኑ ኣቴነን ኦርጨቀንቴነን ዎሉሰንገ ፎሎጭቱን ይዮምበአ። <verse eid="2CO 8:13"/><verse number="14" style="v" sid="2CO 8:14"/>አዕኑ ኦርጨቀንቴነንተ ወክት እሰ ዱንያት ክዕኔ ኦርሸተ ሀዕልቶተ ቴሱ ክዕኔሃ ዮህዕኔርቹ እሰ ኦርሻተ ሀዕሉን፤ ከን ሃሌን በላንከክዕኔ ሜጦመት ሄኣአ። <verse eid="2CO 8:14"/><verse number="15" style="v" sid="2CO 8:15"/>ሁኩንን፦ «ልግብ ጭምአዕዮሀኒሀ ተረፎስበአ፤ ቀዉ ጭም አዕዮሀኒሃ ሆፈዕዮስበአ» የመም ከተበሞጋት።<note caller="-" style="x"><char style="xo" closed="false">8፥15 </char><char style="xt" closed="false"><ref loc="EXO 16:18">ፉል. 16፥18</ref>።</char></note><verse eid="2CO 8:15"/></para>
  <para style="s1">ቲቶለከ ጃለስ</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 8:16"/>አን ክዕኔሃ ሰውያም ጌሰ ቲቱ ክዕኔኤሃ ቀልቢንከስ ሰውዮተ አዕዮ መገኑ ገለትጨሙን። <verse eid="2CO 8:16"/><verse number="17" style="v" sid="2CO 8:17"/>ቲቱ ክዕኔቤቹ አሜተኖሁ ገውስ ሃሸዕይ ሙንዲኖን ኬዕይት ቤሉ ነኡ ጠለዕል ኡጭኖስቤቺሃበአ። <verse eid="2CO 8:17"/><verse number="18" style="v" sid="2CO 8:18"/>ህትን እንጂለ ተማርሰን አመዕናኖቤቾን ገለትጨሞ አመዕናንቹ እሲን ሜጡበ ሶንካም። <verse eid="2CO 8:18"/><verse number="19" style="v" sid="2CO 8:19"/>ህከኒች አበ ሀዕላቀንሸስ ቶንጋም ወክት ሜጡበ መሮተ አመዕናኖን መጠረሞኡ፤ ሀዕላቀንሸስ ቶንጋሚሁ ቀርቹ ገውስ ኬዕምሰኖሃለከ ዎሉሰ ሀዕሊሃ ዮኔ ጡመ ሃሸኢች ኬዕዮሀኒንት። <verse eid="2CO 8:19"/><verse number="20" style="v" sid="2CO 8:20"/>ከን መኒሃ ኢልንሶተ ኣሰሞኔ ብርተኔሃ አዪሁ ዎቀሰኖኔበእገ አገዕርናም። <verse eid="2CO 8:20"/><verse number="21" style="v" sid="2CO 8:21"/>አላመኔ ቀርች ብሬን ጠለዕል እሁዕነ መን ብሬንን ጡመ እኮ ጠወ አኡሃን።<note caller="-" style="x"><char style="xo" closed="false">8፥15 </char><char style="xt" closed="false"><ref loc="PRO 3:4">ምሳ. 3፥4</ref>።</char></note><verse eid="2CO 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CO 8:22"/>ልግብ ወክት ነኡ አበ ወቄን ፌተነም ጠረኘ እክ ደገሞ አመኔቤቱ ቲቶንን ሜጡበ ሶንኮሚሁ ህከን መሳኒት፤ እስ ክዕኔ አሌን ዮስ አመዕነቱ አበ እኮቤቺሃ ከን ሆጎን ሀዕሎተ ዮስ ጠረኝመት መ ወክቲች አበሃን። <verse eid="2CO 8:22"/><verse number="23" style="v" sid="2CO 8:23"/>ቲቶተኔሃ ደጊሃ ሀሴንተ ጎሬ ክዕኔተ ሀዕሎተ ኢን ሜጡበ አአኑሃ ጃላኤ፤ እሲን ሜጡበ አሜታሀኑኡተ ዎሎ አመኔ ኦሶተ እኮጎሬ እሰ አመዕናኖ ጭምት ወከለንቶረለከ መሲህ ኬዕምኚሃ ኡርቶእረ። <verse eid="2CO 8:23"/><verse number="24" style="v" sid="2CO 8:24"/>ህካን እኮቤቺሃ ኢተክዕኔ ለሊሼሰ፤ ከን ሃሊን ኢተኔለከ ክዕኔ አሌን ህትን ድከኡ ተሰ እሁ ሆጉስ አመዕናኖተ ጉዕሚንከ ለሊሴነንተ።<verse eid="2CO 8:24"/></para>
  <chapter eid="2CO 8"/>
  <chapter number="9" style="c" sid="2CO 9"/>
  <para style="s1">አመዕናኖተ ሀዕሊሃ ጭም አኤመ ብረ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 9:1"/>ይሁዳን ዮ አመዕናኑተ ደግለሊሃ ጭም አኤመ ብርተኔሃ ክዕኔሃ ከተቡ ሀስሰኖበአ። <verse eid="2CO 9:1"/><verse number="2" style="v" sid="2CO 9:2"/>መሰንትስ አዕኑ ደግለልቶኖተ ቅጥ ይቴንታእረ እኬንተገ ደንጎምቤቺሃ «አካይ ባድ መኑ ህጎ ዘማኒች ኬስ ደግለልቶተ ቅጥ ይቶእራን» ይ መቅዶን ባድ መኒሃ ክዕኔተኔሃ አመዕን ጠወዕዮሚሁ ጠረኝመክዕኔ ደጋምቤቺሃት፤ መነ ደግለልቶኖተ ዮህዕኔ ጡሙ ሰውቱ እሳች ልግብሰ ኬሰንስዮኡ። <verse eid="2CO 9:2"/><verse number="3" style="v" sid="2CO 9:3"/>ጠው እኮጎሬ ከን ጠዊን ክዕኔተኔሃ ቦናም ቦኑኔ ህትን ተሰ እህበገ ከ አመኦሱተ ሶሃም፤ አዕኑ አን ከኒች ብርተ ዬምገን ተቃጠቤን አገሬ። <verse eid="2CO 9:3"/><verse number="4" style="v" sid="2CO 9:4"/>መቅዶን ባድ መኑ ኢን ሜጡበ ክዕኔቤቹ አሜት ቅጥ ይቶኑዕነ ደጎህዕኔ ጎሬ ክዕኔን ድከኡኔ ሙልሰኖኔ፤ አዕኑሁ ሂለ ብከ ሙልቴነንተ። <verse eid="2CO 9:4"/><verse number="5" style="v" sid="2CO 9:5"/>ህካን እኮቤቺሃ ኣቶኖተ ላገተ ኣጌንተርቹ ሄጭቴን ቅጥ አቴነንተገ ቃግሶህዕኔተ ይ ከ አመኦሱት ሄጭት ክዕኔቤቹ መርታገ አኡ ሰውዬም፤ ህትን ግዳጂን እሁዕነ ኢታን ኣቴነንታሁ ቅጥ ዬኢሃ እሀኖ።<verse eid="2CO 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 9:6"/>«ቀው ውጮ መንቹ ቀውንከ ምደኖ፤ ህትን ልግብ ውጮ መንቹ ልግብንከ ምደኖ» ህካን ሰውይዬ። <verse eid="2CO 9:6"/><verse number="7" style="v" sid="2CO 9:7"/>ሙንደአን ኣሰኖሃ ጉዕመንከ መገኑ ኢተኖሃ እኮቤቺሃ ጉዕሙንኩ ቀልቤንከስ ሰውዬገ ኣሱን ቤሉ ሻዘን ህከረንገ ግዲን ኣሱንከ።<verse eid="2CO 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 9:8"/>ጉዕመ ወክት ጉዕመ ጠዋን ገውክዕኔ አታልቴን ጡመ ሆጉተ ጉዕመንከ አኢሃ መገኑ አበ በረከስ ኣሶህዕኔተ አታለኖ። <verse eid="2CO 9:8"/><verse number="9" style="v" sid="2CO 9:9"/>ሁኩንን፦</para>
  <para style="q1" vid="2CO 9:9">«ቡጥቻኖተ ህትን በትሽ ኣሴእ፤</para>
  <para style="q2" vid="2CO 9:9">ፈይመስ ዘላለሚሃ ሄኣአ»</para>
  <para style="m" vid="2CO 9:9">የመም ከተበሞጋት።<note caller="-" style="x"><char style="xo" closed="false">9፥9 </char><char style="xt" closed="false"><ref loc="PSA 112:9">መዝ. 112፥9</ref>።</char></note><verse eid="2CO 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 9:10"/>ዜሬተ ዉጠኖሀኒሃ ዜሬተ ህትን እተኖሀኒሃ እቸተ ኣሰኖ መገኑ ዉጤነንተ ዜሬት በረከስ ኣሰኖህዕኔ፤ ህትን ፈይመክዕኔ ላልቹ በትሰኖህዕኔ።<note caller="-" style="x"><char style="xo" closed="false">9፥10 </char><char style="xt" closed="false"><ref loc="ISA 55:10">ኢሳ. 55፥10</ref>።</char></note> <verse eid="2CO 9:10"/><verse number="11" style="v" sid="2CO 9:11"/>አዕኑ ኣቴንተርቹ ኒ አዲን ቶገኖ መኑ ጉዕሙንኩ መገኑ ገለትጮተ ጉዕመ ወክት ኣቶኖተ ጉዕማንከ አዲን ቀባጣመተ እኬነንተ። <verse eid="2CO 9:11"/><verse number="12" style="v" sid="2CO 9:12"/>ኩ አዕኑ ኣቴነንታሁ አመዕናኖ ኦርሸተ ፉሹ ጠለዕለ እሁዕነ መኑ መገኑ አበ ገለትጨኖገ አአኖ። <verse eid="2CO 9:12"/><verse number="13" style="v" sid="2CO 9:13"/>ኩ አዕኑ ኣቴነንታሁ መሲህ ተሽት ላገተ አመዕንዮም ይቴን አዘዘሙክዕኔ እሳሃለከ ዎሎ መኒሃ አቴነንተረ እሁክዕኔ ለሊሰኖሃ እኮቤቺሃ መኑ መገኑ ገለትጭታአ። <verse eid="2CO 9:13"/><verse number="14" style="v" sid="2CO 9:14"/>እሰን መገኑ ክዕኔሃ ኣሴህዕኔ አበ ኣስቶተኔሃ መገኑ ኡጭታህዕኔ ወክት እልክዕኔ ለኦተ ሱንታህዕኔ። <verse eid="2CO 9:14"/><verse number="15" style="v" sid="2CO 9:15"/>መን ላጋን ጠወኦኖተ አታሌንበ ሽልማትስተኔሃ መገኒሃ ገለቱ ኢሉስ።<verse eid="2CO 9:15"/></para>
  <chapter eid="2CO 9"/>
  <chapter number="10" style="c" sid="2CO 10"/>
  <para style="s1">ጳዉሎስ ክድመስተኔሃ ኣሴ መስለ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 10:1"/>አን ጳዉሎስ ክዕኔ ብሬን ዮም ወክት ሙላሚሃ የመሞም፤ ጠዉ እኮጎሬ ክዕኔች ቄዕሬም ወክት መለላንቹ የመሞም፤ መሲህ ጎደበ ላፍማንለከ ጡምማን ኡጫንክዕኔ። <verse eid="2CO 10:1"/><verse number="2" style="v" sid="2CO 10:2"/>ኡጫንክዕኔንኩ አን ክዕኔቤቹ አሜቾም ወክት መለል ጠወኣምገ አቶኖኤበእታት፤ ማል ሰውትገ እንክ ሄዕናምገ አቶእሩ መት መቶ መን ብሬን እኮጎሬ መለል ጠወኦተ ሀሳም። <verse eid="2CO 10:2"/><verse number="3" style="v" sid="2CO 10:3"/>መሰንትስ ነኡ መሃ እኮጎሬ ከን ኣዱንያ አሌን ሄዕኖም ጎሬ ከን ኣዱንያ አል መንገ ኦለማምበአ። <verse eid="2CO 10:3"/><verse number="4" style="v" sid="2CO 10:4"/>ኦለንሽኔ ኦዳት ሻንቀ ድጂሃ አታልሲሰኖ መገን ወልቀት ዮስ ቤሉ ከን ኣዱንያ አል መሳርገ ዮእሃበአ። ክዝብ ኦደተ ድጅናም። <verse eid="2CO 10:4"/><verse number="5" style="v" sid="2CO 10:5"/>ህካን እኮቤቺሃ መን ሰውት መገን ኤንኬዕን አሌን ኬአኖ ቦን ኦደተ ጉዕመንከ ድጅናም፤ ህትን መን ሰውት ጉዕመንከ አንግ መሲህሃ አዘዘመኖገ አዕናም። <verse eid="2CO 10:5"/><verse number="6" style="v" sid="2CO 10:6"/>አዘዘሙክዕኔ ሹልቴንተ ወክት አዘዘንታበእ መነ ገዱተ ፉልኖተ ተቃጠንቦም።<verse eid="2CO 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 10:7"/>አዕኑ ለኤነንታሁ አብልን ለለኖ ጠወዪት፤ ሀኩ መንቹሁ «አን መሲህሃን» ይ አመዕኔኢች ለንኪሃ ሰዉ ዩን፤ ነኡ እስገን መሲህረ እሁኔ ደጉን። <verse eid="2CO 10:7"/><verse number="8" style="v" sid="2CO 10:8"/>ቀርቹ ኣሴኔ ሹምነቴን አበ ድከዕዮም ጎሬ ሙላምበአ፤ ከ ሹምነቱ ቶንጎሚሁ ክዕኔተ ጠረኝንሶህዕኔታቤሉ ድጅኖህዕኔታበአ። <verse eid="2CO 10:8"/><verse number="9" style="v" sid="2CO 10:9"/>አን ክዕኔሃ ከተቦንክዕኔ ደብዳቤን ዋጅሲሳሚሃ አጉዱንከህዕኔ። <verse eid="2CO 10:9"/><verse number="10" style="v" sid="2CO 10:10"/>መሰንትስ መት-መቱ መኑ «ጳዉሎስ ከተቦ ሶህኑት አበ ኬዕምታእረ፤ እኮጎሬ እስ ገውስ ለኤኖረ አበ ላፈሃን፤ ጠወአኖ ጠውንኩ ህንቀሞእሃን» ይታኢት እቅ። <verse eid="2CO 10:10"/><verse number="11" style="v" sid="2CO 10:11"/>ሁኩ መኑንኩ ነኡ ቄዕራሻን ዮም ወክት ደብዳቤተ ከተቦሚሁለከ ግደኖን ክዕኔን ሜጡበ ሄዕዮም ወክት አዕናሚሁ ሜጡ እሁስ ደጉን።<verse eid="2CO 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 10:12"/>ነኡ እኮጎሬ መት መቶ ገውሰ ገለትጭታ መኒን ሜጡበ ገውኔ አመሰልኖተ ህከረንገ ገውኔ ለልንሶተ መለልናምበአ፤ እሰ እኮጎሬሁ ገዉሰ መት-መትንከሰ ለኣ ወክት ገውሰ ገገይንከሰ አመሰለንስት ለኣ ወክት ኤንኬዕኑ ዮሰበእረን። <verse eid="2CO 10:12"/><verse number="13" style="v" sid="2CO 10:13"/>ጠዉ እኮጎሬ ነኡ ክዕኔተ ኢሎተ ኢለ መገኑ ኣሴኔ ሆጎኔ ወጢን ድከዕናም ቤሉ ድከኡ ሀስሰኖኔሀኒች አበ ድከዕናምበአ። <verse eid="2CO 10:13"/><verse number="14" style="v" sid="2CO 10:14"/>አዕኑ ዮንታሁ ክድመኔ ሆጎ ኣዜን እኮቤቺሃ መሲህ እንጂለ ተማርስኖተ አሜንቶም ወክት ኣሰሞኔ ሆጎኔ ወጢች ህንጎምበአ። <verse eid="2CO 10:14"/><verse number="15" style="v" sid="2CO 10:15"/>ዎሉ መኑ ቆንዶዴ ሆጎን ጌሲች አበ ድከኢን የመሞኔ ሆጎኔ ወጢች ህንጋምበአ፤ አመዕነቱክዕኔ ነጰን መሮጌሳን ክዕኔቤቾን መደበንቶኔ ሆጉኔ አልባዕልተን መርታገ ተብሳሃ አዕናም። <verse eid="2CO 10:15"/><verse number="16" style="v" sid="2CO 10:16"/>ቴሁ ከኒች ብርተ ዎሉ መኑ አታ ሆጎቤቾን ኣንግ ቦኑዕነ ክዕኔች ካጵ አዲን ዮ ባዶኒሁ ተሽት ላገተ ተማርስኖተ ተብሳሃ አዕናም።<verse eid="2CO 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 10:17"/>ጠዉ እኮጎሬ «ድከአኖሁ ቀርቾን ድከኡን።»<note caller="-" style="x"><char style="xo" closed="false">10፥17 </char><char style="xt" closed="false"><ref loc="JER 9:24">ኤር. 9፥24</ref>።</char></note> <verse eid="2CO 10:17"/><verse number="18" style="v" sid="2CO 10:18"/>መንቹ ገዉንኩስ ገለትጨሞተ በቀአኖሲሁ ቀርቹ ገለትጨኖስራት ቤሉ ገዉስ ገይንከስ ገለትጨንበአ።<verse eid="2CO 10:18"/></para>
  <chapter eid="2CO 10"/>
  <chapter number="11" style="c" sid="2CO 11"/>
  <para style="s1">ጳውሎሴለከ ክዝብ አሳበተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 11:1"/>አዕኑ ኢ ገውመኤ ቀውንከ አታልቴንታኤ እቃን ጡመሃን እቅ፤ አዕኑ ሀንቅንከ እጀቅቴንታኤ። <verse eid="2CO 11:1"/><verse number="2" style="v" sid="2CO 11:2"/>አንን መገኑ ጡመርቹ ሰውየኖገ ጡመርቹ ሃሸዕዮንኬ፤ መሰንትስ ክዕኔተ ጡመ ሀፍቶገ መቶ ጎኒሃ ሁኩንን መሲህሃ ሆንጠህሶህዕኔተ ጠዕምዮንክዕኔ። <verse eid="2CO 11:2"/><verse number="3" style="v" sid="2CO 11:3"/>ጠው እኮጎሬ ዎሪቹ ሀዋ ሾክማንተስ ሉሲሾሴገን ህትን ክዕኔ ሰውቱ በዕያን መሲህ ዮህዕኔ ጡመ ሰውቲችለከ ነጢማች ፉልቴን መርቶኖታትንዶ ይ ዋጅዮም።<note caller="-" style="x"><char style="xo" closed="false">11፥3 </char><char style="xt" closed="false"><ref loc="GEN 3:1-5">ክል. 3፥1-5</ref>፤ <ref loc="GEN 13">13</ref>።</char></note> <verse eid="2CO 11:3"/><verse number="4" style="v" sid="2CO 11:4"/>መሰንትስ መቱ መንቹ ክዕኔቤቹ አሜች ነኡ ተማርስኖንክዕኔ ኢሲች ዎሉ ኢሰ ተማርሴጎሬ ህከረንገ ቶጌንተ አያኒች አደ እኮ አያነ ቶጌንተጎሬ ህከረንገ ቶጌንተ እንጂሊች አደ እኮ እንጂለ ቶጌንተጎሬ ጠወስ ጨለ ይቴን ኣእቴነንተ ዩሃን።<verse eid="2CO 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 11:5"/>ጠው እኮጎሬ አን ከን ሎርሎራኖ አሳባች መ ጠዋን ሆፈኣሚሃ አጉጆኤበአ። <verse eid="2CO 11:5"/><verse number="6" style="v" sid="2CO 11:6"/>እኮጎሬ አን ጡመገ ጠወኣም መንቹ እህበጎሬ ኤንኬዕኑ ሆፈአኖኤበአ፤ ህከኒሃ ልግብ ወክት ልግቤ ዎቄን ለሊንስ ኩልኖንክዕኔ።<verse eid="2CO 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 11:7"/>አን መገን ተሽት ላገተ ደሞዙ ዮበኢሃ ክዕኔሃ ተማርሲሃለከ ህትን ክዕኔንተ ጎት አኢሃ ገውኤ ሙግ አዕዮሚሁ ጩብሃንዶ? <verse eid="2CO 11:7"/><verse number="8" style="v" sid="2CO 11:8"/>ክዕኔተ ካደሞተ ዎሎ አመዕናኖች ሀዕለንሸ ቶጎንከኤ እሰተ ዘረፎም። <verse eid="2CO 11:8"/><verse number="9" style="v" sid="2CO 11:9"/>ክዕኔን ሜጡበ ሄዕዮም ወክት ኦርሸት ኢሊቶኤ ወክት መቅዶኒች አሜቶ አመዕናኑት ሀስሰኖኤርቹ ጉዕመ ጠዊን ሀዕልተን ሄኦቤቺሃ አዬ አሌን እጅነተ እኮምበአ፤ ቴሱ ኢለ ክዕኔ አሌን መ ጠዋን እጅነተ እኮምበአ፤ ከኒች ኤተሮኒ እጅነተ እሃምበአ።<note caller="-" style="x"><char style="xo" closed="false">11፥9 </char><char style="xt" closed="false"><ref loc="PHP 4:15-18">ፍልጵ. 4፥15-18</ref>።</char></note> <verse eid="2CO 11:9"/><verse number="10" style="v" sid="2CO 11:10"/>መሲህ ሀንቁ ኣዜንከኤ ዮቤቺሃ ከን ጠዋን ቦኑ ከመኖኤሁ አካይ ባዶን አዪሁ ዮበአ። <verse eid="2CO 11:10"/><verse number="11" style="v" sid="2CO 11:11"/>ህከን መሰት መርቹሃን? ኢታንክዕኔበእቤቺሃትንዶ? ኢታንክዕኔገ መገኑ ደገኖ።<verse eid="2CO 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 11:12"/>ሁኩ ዎልት አሳበት «ነኡን እሰገ አዕናም» ይተን ቦንታ መሰተ ከሞተ ቴሱ አኣሚሃ ከ ኤተሩሃ አኣም። <verse eid="2CO 11:12"/><verse number="13" style="v" sid="2CO 11:13"/>መሰንትስ ህትኔ መኑ መሲህ አሳበተ አጉዶተ ገዉሰ ዶርታ ክዝበኛኑተ ሶቀማኑተለከ ሉሲስ ሆጉተ አታእራን። <verse eid="2CO 11:13"/><verse number="14" style="v" sid="2CO 11:14"/>ሁኩን አጀብሲሰኖሃ ጠወበአ፤ መሰንትስ ሸይጣኑ ገዉስ ኑር መላይኬቹ አጉዶተ ገዉስ ዶረኖ። <verse eid="2CO 11:14"/><verse number="15" style="v" sid="2CO 11:15"/>ህካን እኮቤቺሃ ሸይጣን ካዲመት ፍይማ ካዲመተ አጉዶተ ገዉሰ ዶርቶጎሬ አጀብሲሰኖበአ፤ ኤተሮን ሆጎሰ ዋገ ደእታአ።<verse eid="2CO 11:15"/></para>
  <para style="s1">ጰዉሎሴሃ ክድመስ መሳን ኢልቶስ ኦርሸተ</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 11:16"/>«አዪሁ አን ገወ እኮሚሃ አጉዱንከስ» ይ ቴዉ ጠወኣም። ገወ አጉጆንክዕኔጎሬሁ ቀቅቹ ቦኖተ ገወ መንችገ አቴን ዎለዕዬኤ። <verse eid="2CO 11:16"/><verse number="17" style="v" sid="2CO 11:17"/>ህትን አመዕን ቦኒን ጠወኣሚሁ ቀርች ሰውትገ እሁዕነ ገወ መንቹ እክት። <verse eid="2CO 11:17"/><verse number="18" style="v" sid="2CO 11:18"/>ልግቡ መኑ ከን ኣዱንያ አል ጠዋን ቦንታቤቺሃ አኒሁ ቦናም። <verse eid="2CO 11:18"/><verse number="19" style="v" sid="2CO 11:19"/>መሰንትስ አዕኑ ኤንኬዕናመተ እኬንተቤቺሃ ገዋኑተ ሙንዲኖን አታዕልቴነንተሳት። <verse eid="2CO 11:19"/><verse number="20" style="v" sid="2CO 11:20"/>ህትን አዪሁ ሮስገ ጠቄህዕኔጎሬ ህከረንገ ዘረፎህዕኔጎሬ ህከረንገ ደግለሸቀሞህዕኔጎሬ ህከረንገ ህንቆህዕጎሬ ህከረንገ መጫለክዕኔ ዎቀሮጎሬ አታዕልቴነንተ። <verse eid="2CO 11:20"/><verse number="21" style="v" sid="2CO 11:21"/>እኮጎሬ ነኡ ህከኒሃ አበ ላፋኑተ እሁኔ ሙለን ጠወኣም፤</para>
  <para style="p" vid="2CO 11:21">ጠዉ እኮጎሬ አዪሁ ቦኖተ መለሎጎሬ አኒሁ እስገን መለል ቦናም፤ ካን ያሚሁ ገወ መንችገ እክት። <verse eid="2CO 11:21"/><verse number="22" style="v" sid="2CO 11:22"/>እሰ እብራዌየ መነንዶ? አንን እብራውቹሃን፤ ህትን እሰ እስራኤልየ መነንዶ? አን እስራኤላውቹሃን፤ እሰ እብራሂምተ ዘርንዶ? አን እብራሂምተ ዘር። <verse eid="2CO 11:22"/><verse number="23" style="v" sid="2CO 11:23"/>እሰ መሲህተ ካዲመንዶ? አን እሳች ባሽ መሲህየ ካዲንቹ፤ ካን የን በርገጋሽጋት ጠወኣሚሁ፤ እሳች በትሽ ልግብ ወክት ሆጎን ቆንዶድዮም፤ እሳች በትሽ ልግብ ወክት ኡሱራሞም፤ በትሽ ልግብ ወክት ገረፈሞም፤ ልግብ ወክት ሬሆተ ኢልዮም፤<note caller="-" style="x"><char style="xo" closed="false">11፥23 </char><char style="xt" closed="false"><ref loc="ACT 16:23">ሶቀ. 16፥23</ref>።</char></note> <verse eid="2CO 11:23"/><verse number="24" style="v" sid="2CO 11:24"/>አይሁዱ ኦንቱ ወክት ሰጅኔ ሆንሶረ ጅራፊን ገረፎኤ።<note caller="-" style="x"><char style="xo" closed="false">11፥24 </char><char style="xt" closed="false"><ref loc="DEU 25:3">ዘዳ. 25፥3</ref>።</char></note> <verse eid="2CO 11:24"/><verse number="25" style="v" sid="2CO 11:25"/>ህትን ሰሱ ወክት በርቲን ዎቀራሞም፤ መቱ ወክት ክኒን ቀሰሞም፤ ሰሱ ወክት መርከቡኤ ባር አሌን ቢጠሞኡ፤ ህትን መት ሀንከዕርተለከ በራሃ በሃር አሌን ዱንክዮም፤<note caller="-" style="x"><char style="xo" closed="false">11፥25 </char><char style="xt" closed="false"><ref loc="ACT 16:22">ሶቀ. 16፥22</ref>፤ <ref loc="ACT 14:19">14፥19</ref>።</char></note> <verse eid="2CO 11:25"/><verse number="26" style="v" sid="2CO 11:26"/>አን ልግብ ወክት ዎቄ አሌን ሄአን ድርሲን፥ ሽፍጢን፥ አይሁዲን፥ አይሁድ እህበ መኒን፥ ከተማንለከ ኡለ ኡድማን፥ በሃር አሌን ምዕረት እልቶኤ፤ ህትን ክዝብ አመዕናኖን ምዕርተዕዮም።<note caller="-" style="x"><char style="xo" closed="false">11፥26 </char><char style="xt" closed="false"><ref loc="ACT 9:23">ሶቀ. 9፥23</ref>፤ <ref loc="ACT 14:5">14፥5</ref>።</char></note> <verse eid="2CO 11:26"/><verse number="27" style="v" sid="2CO 11:27"/>ህትን ልግቤ ሆጎን ሆጎም እቅ፤ ልግብ ወክት ግሰኛተ ሆጊንለከ ጎሪን፥ ሰገቤንለከ እቸተ ሆግ ኦርጨቀሞም፤ ህትን ቂዚንለከ ኦድኑተ ሆጊን ኦርጨቀሞም። <verse eid="2CO 11:27"/><verse number="28" style="v" sid="2CO 11:28"/>ህካን ጉዕመንከ ጠወ ዎለኡዕነ በሬን በሬን ጨነቀማሚሁ አመዕናኖ ጭሚቲሃት እቅ። <verse eid="2CO 11:28"/><verse number="29" style="v" sid="2CO 11:29"/>መቱ መንቹ ሆገኖ ወክት አን እሲን ሜጡበ ሆጋምሃበእንዶ? መቱ መንቹ ጩብ አዕዮ ጎሬ አን ኡሙዕራምሃበእንዶ?<verse eid="2CO 11:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2CO 11:30"/>ድከኡ ሀስሾኤጎሬ አን ድከኣሚሁ ላፈ እሁኤ ለሊሰኖ ጠውኒት። <verse eid="2CO 11:30"/><verse number="31" style="v" sid="2CO 11:31"/>ዘለለሚሃ ማሰአሞ ቀርቾሃ ኢስ አኑ መገኑ ክዝባምበእገ ደገኖ። <verse eid="2CO 11:31"/><verse number="32" style="v" sid="2CO 11:32"/>አን ደማስቆ ከተማን ሄዕዮም ወክት ዎመ አርስጦሴች ዎሮን ሄዕዮ ገሻንቹ አፎኤተ ሀሽ ደማስቆ ከተም ኡራከተ አገርሲሾ እቅ። <verse eid="2CO 11:32"/><verse number="33" style="v" sid="2CO 11:33"/>ጠዉ እኮጎሬ ኤሳሃ ቀርጫታን ዎሬን ከተምስ ኦታን ሄዕዮ መስኮቲን ድሪሴናን ህከን መንች አንጋች ፉሸኤም።<note caller="-" style="x"><char style="xo" closed="false">11፥32-33 </char><char style="xt" closed="false"><ref loc="ACT 9:23-25">ሶቀ. 9፥23-25</ref>።</char></note><verse eid="2CO 11:33"/></para>
  <chapter eid="2CO 11"/>
  <chapter number="12" style="c" sid="2CO 12"/>
  <para style="s1">ጳዉሎሴሃ ለልቶስ ሃሽኣቱተ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 12:1"/>ቦኑ ደግለለኖሃ እህበጎሬ ቦኑ ሀስሾ ጎሬ ቀርቾሃ ኢሲች ኣሰሞኤ መናማንለከ መገኑ ለልሾኤ ጠዋን ቦናም። <verse eid="2CO 12:1"/><verse number="2" style="v" sid="2CO 12:2"/>መሲህሃ እኮ መቱ መንቹ ደጋም፤ ኩ መንቹ ቶነ ሾሎ ዘመኒች ብርተ ሰቅ ሰማሃ ኢለ መሰሞ፤ መሰሞንኩ ማልንከስ እሁን እሁ ሆጉን ደጋንበአ፤ መገኑ ደገኖ። <verse eid="2CO 12:2"/><verse number="3" style="v" sid="2CO 12:3"/>ጠው እኮጎሬ መንቹ መገን ጄነት መሩስ ደጋም፤ ጠው እኮጎሬ ማልንከስ እሁን እሁ ሆጉን ደጋምበአ፤ መገኑ ደገኖ፤ <verse eid="2CO 12:3"/><verse number="4" style="v" sid="2CO 12:4"/>እስን ህከኔ ኩሎኖተ አታሌንበለከ መኑ ጠወኦተ አታልቡርቹ ሞጮጬእ። <verse eid="2CO 12:4"/><verse number="5" style="v" sid="2CO 12:5"/>አኒሁ ህትኔ መኒን ድከኣም፤ ገዪኤተኔሃ እኮጎሬ ሆንጌእ ቤሉ ድከኣም ጠው ዮኤበአ። <verse eid="2CO 12:5"/><verse number="6" style="v" sid="2CO 12:6"/>ህከኒሃ አን ሀንቅ ጠወኣምቤቺሃ ድከዕዮሚች ገወ እሃምበአ፤ ጠው እኮጎሬ አዪሁ ኢ አሌን ለአኖርቹሃ ኢች ሞጮጨኖሀኒች ኤሰሃ ሎረ አት ለኣበእገ ይ ድከኢች አገዕራም።<verse eid="2CO 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 12:7"/>ከ ኑር እክ ለሌኤ አበ ጠዊች ኬዕዮሀንን ቦናምበእገ ማለኤ ኡትገ ቀሳኤ ኦርሸት ኣሰንቶኤ፤ ህት ኦርሸት ሶቀማንቹ ሽይጣንገ እሀን ኦርጨመን ቦናምበእገ አአኖኤ። <verse eid="2CO 12:7"/><verse number="8" style="v" sid="2CO 12:8"/>ሁኩ ኦርሰኖኤርቹ ኢ አሊች ሽቆተ ቀርቹኤ ሰሱ ወክት ኡጬም። <verse eid="2CO 12:8"/><verse number="9" style="v" sid="2CO 12:9"/>ጠው እኮጎሬ እስ «ኢ ወልቀት ሎረ እክ ለልታኢሁ ኪ ሆንጌን እኮቤቺሃ ኣስቱኤ እካሄ» ዬኤ፤ ህካን እኮቤቺሃ መሲህ ወልቀት ኢ አሌን እኮተ መ ወክቲቺ በትሽ ሆንጌንተኤ ተሽ የዕኔ ድከኦስተ ኢታም። <verse eid="2CO 12:9"/><verse number="10" style="v" sid="2CO 12:10"/>ወልቀተ ደኣሚሁ ሆጎም ወክት እኮቤቺሃ መሲህተኔሃ ቦሮረሙኤ፥ ኦርጨቀሙኤለከ ሆቸሙኤ ተሽ የኖኤ።<verse eid="2CO 12:10"/></para>
  <para style="s1">አሳቤቹ ጳዉሎስ ቆሮንቶስ መኒሃ ሰው ዩስ</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 12:11"/>አን ገወ መንችገ ጠወዕዮም፤ እኮጎሬ ገወ እሃምገ አቴንተኤሁ አዕኖንት፤ አዕኑ እተኔሃ ጡመ ጠወ ጠወኡ ገበአኖህዕኔሁ አዕኖት እቅ፤ መሰንትስ አን መ ቀዉ መንቹሃ እኮም እቃ ህከን ሎርሎራኖ አሳባች መቶርቾን ሆፈኣምበአ። <verse eid="2CO 12:11"/><verse number="12" style="v" sid="2CO 12:12"/>አን ሀንቅ አሳቤቹ እሁኤ ለሊሰኖ ጠዉ አን በላንከክዕኔ ሄአን አደቢን አዕዮምተ ሆጉ፤ ህት መላንት አጅበተለከ ገረምሲሳእታን። <verse eid="2CO 12:12"/><verse number="13" style="v" sid="2CO 12:13"/>አን ክዕኔተ ብረ ጠዕሙ ሆግንከኤ አሌንከክዕኔ እጅነተ እሁዕነ ፈቆም ቤሉ ዎሎ አመዕናኖ ዱእ ምኒች ሆፍሾንክዕኔሁ ማኒት? ሁኩን ቤሱ እኮጎር ማሬእ።<verse eid="2CO 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 12:14"/>አን ክዕኔበ አሜቲሀእ ሰቅያ ወክት፤ አን ክዕኔተ ገዉክዕኔት ቤሉ ክዕኔርቹ ሀሳምበእቤቺሃ ክዕኔ አሌን እጅነተ እሆተ ሀሳምበአ፤ ቴሁ አናኑት ኦሶተሰ ብረ ጭምአት አፉሹ ሀስሰኖሰ ቤሉ ኦሱት አናኖተ ብረ ጭም አታበአ። <verse eid="2CO 12:14"/><verse number="15" style="v" sid="2CO 12:15"/>አን ክዕኔተኔሃ ብሩኤ ፈቅያን ፎልኤ ህግሽ ኣስዮም እቃ አበ ሙንደኣም፤ ህከረ አን ኬንከ በትሽ ኢታንክዕኔሃ እኮች አዕኑ ኤሳሃ ኢቱ ሀስሰኖህዕኔሁ ቀዉሃትንዶ? <verse eid="2CO 12:15"/><verse number="16" style="v" sid="2CO 12:16"/>እሁን ቤሉ አን ክዕኔ አሌን እጅነተ እኮምበአ፤ ጠዉ እኮጎሬ አዕኑ ይቴንተገን ጣንስ ተንኮን አፎንክዕኔሃ አጉደኖ። <verse eid="2CO 12:16"/><verse number="17" style="v" sid="2CO 12:17"/>ክዕኔቤቹ ሶኮም መኒች መትስ አዲኒ እኮዕቃ ክዕኔች ጣንስ ኣእዮክዕኔዶ? <verse eid="2CO 12:17"/><verse number="18" style="v" sid="2CO 12:18"/>ቲቱ ክዕኔ አደ መሮተ ኡጭዮንስ፤ ኒ አመ ቤቱንከ እሲን ሜጡበ ሶኮም፤ ቲቱ ጣንስ አእዮህእኔዶ? አንለከ እስ አዕኖሚሁ መቶ ቀልብንበእንዶ? ህትን ለምኔ ቀልቡንኩ መቱሃበእንዶ?<verse eid="2CO 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CO 12:19"/>አዕኑ ቴሱ ኢለ ነኡ ክዕኔ መዴን ገዉኔ ከዕመቀማሚሃ አቴን ሰውይቴነንታት? ነኡ መሲህን እንክ ጠወዕናሚሁ መገን ብሬኒት፤ ኒ ጃላ! ጠወዕናሚሃ ጉዕመንከ ጠወዕኖሚሁ ክዕኔተ ጠረኝንሳም ይኒት። <verse eid="2CO 12:19"/><verse number="20" style="v" sid="2CO 12:20"/>አን ክዕኔቤቹ አሜታም ወክት አይደጎ እኮኖተ ሀሳምገ እኮኑዕናን አኒሁ አዕኑ እሆተ ሀሴነንተገ እሁዕናን ደቀሞምጎር ይ ዋጃም፤ ህትን ክዕኔ በላን ብተት፥ አቄሸት፥ አሙዕርት፥ ገጉ ኢቱ፥ መን ሱዕመ ቤሱ፥ ሄምት፥ ቦኑ፥ ጨንጨነት ሄኣ ይ ዋጃም። <verse eid="2CO 12:20"/><verse number="21" style="v" sid="2CO 12:21"/>ህትን አን ለንኪሃ ክዕኔበ አሜቾም ወክት ኢ መገኑ ክዕኔ መዴን ሙልሰኖኤ ጎሬ ይ ዋጃም፤ ህትን ከኒች ብርተ ጩብ አት ህከን አቶ ሂለ ንጃሲን፥ ዝነተ አእተኔሃ፥ ህትን አለ ቅልቢን ቶበቱ ሆጎ መን ሻዞ አሌን ኡባም ይ አበ ዋጃም።<verse eid="2CO 12:21"/></para>
  <chapter eid="2CO 12"/>
  <chapter number="13" style="c" sid="2CO 13"/>
  <para style="s1">ጎፍሜ ሸዘነተለከ ወገሬትሱ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 13:1"/>አን ክዕኔበ አሜቶተ ኩን ሰቅያ ወክት፤ ጠዉ ጉዕሙንኩ ኡረኖሁ ለሞ ህከረንገ ሰሶ ምስክር ላጋኒት።<note caller="-" style="x"><char style="xo" closed="false">13፥1 </char><char style="xt" closed="false"><ref loc="DEU 17:6">ዘዳ. 17፥6</ref>፤ <ref loc="DEU 19:15">19፥15</ref>።</char></note> <verse eid="2CO 13:1"/><verse number="2" style="v" sid="2CO 13:2"/>ለንክ ወክት ክዕኔቤቹ ለኦህዕኔተ መሮም ወክት ጠረኝሽ ጠወዕዮም እቅ፤ ቴሁ ህትን ቄዕራሻን እክ ከኒች ብርተ ጩብ አቶሀኑኡተለከ ወሊሃሰ ጠረኝሽ ጠወኣም፤ ቴሱ ክዕኔቤቹ ፈንቀል አሜታም ወክት ሜጢሃ አሙዛምበአ፤ <verse eid="2CO 13:2"/><verse number="3" style="v" sid="2CO 13:3"/>አዕኑ ኢን ሄዕይ ጠወአኖሁ መሲህ እሁሰ አጥራመቶኖተ ሀሴነንታት፤ ክዕኔቤቾን ለለኖንኩ እስተ ወልቀ ቤሉ ሆንጌተስበአ። <verse eid="2CO 13:3"/><verse number="4" style="v" sid="2CO 13:4"/>መሰንትስ እስ ሰቀለም ሬዮሁ ሆንጌን እኮጎሬሁ ቴሱ መገን ወልቃን ፎሊን ሄአኖ፤ ህትን ነኡ እሲን ሜጡበ ላፋኑተ እንኮም፤ እኮጎሬ ነኡ ክዕኔሃ ዮኔ ደቀሺን እኮጎሬ እሲን መገን ወልቃን ሜጡበ ሄዕናም።<verse eid="2CO 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 13:5"/>አመዕነትንከክዕኔ ሄኡክዕኔ ደጊሃ ገዉክዕኔ አጥራመቴን ለዕዬ፤ ህትን ገዉክዕኔ ፌተኜ፤ መሲህ ኢስ ኣዜንከክዕኔ ሄኡስ አጥራመቴንታበእንዶ? ህካን እህባች ሀንቅንከ ፌተናን ኡቤንታ ዩሃን። <verse eid="2CO 13:5"/><verse number="6" style="v" sid="2CO 13:6"/>ነኡ ፌተናን ኡቡ ሆጉኔ ደጌነንተገ ተብሳሃ አዕናም። <verse eid="2CO 13:6"/><verse number="7" style="v" sid="2CO 13:7"/>አዕኑ ሂለርቹ አቴነንተበእገ መገን ቤቹ ዱአ አዕናም፤ እስን ነኡ መቱርቹሃ ፌተናተ በቀንዕበረ እንኮም ጎሬ አዕኑ ጉዕመንከ ወክት ጡመ ጠወ አቶኖታት ቤሉ ነኡ ፌተናንተስ ህንጋም ጠረኛኑተ እሁኔ ለሊንሶታበአ። <verse eid="2CO 13:7"/><verse number="8" style="v" sid="2CO 13:8"/>መሰንትስ ነኡ ሀንቅ ቤሉ ሀንቅ አሌን መቱርቹሃ አዕኖተ አታልናምበአ። <verse eid="2CO 13:8"/><verse number="9" style="v" sid="2CO 13:9"/>ነኡ ላፋኑተ እንካን አዕኑ ጠረኛኑተ እኬንተ ወክት አበ ሙንደዕናም፤ ኒ ዱኡ አዕኑ አመዕነቲንከክዕኔ ጠረኛኑተ እኮኖታት። <verse eid="2CO 13:9"/><verse number="10" style="v" sid="2CO 13:10"/>አን ከ ሶህኑተ ክዕኔች ቄዕር ዮም ወክት ከተቦንክዕኔሁ ክዕኔቤቹ አሜቾም ወክት ቀርቹንኩ ኣሴኤ ሹሚነቲን ጨነቃንክዕኔበእጋት፤ መሰንትስ ቀርቹ ኣሴኤ ሹምነት ወልቀት ክዕኔተ ጠረኝሲሃት ቤሉ ሆግሲሃበአ።<verse eid="2CO 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 13:11"/>በትሽን አመኤ ኦሶ! ወገሬቲን ሄዕዬ፤ አመዕነቲንከክዕኔ ሆፈአኖህዕኔርቹ ዮህዕኔበእረ እኬ፤ ሸዘነእ አጥራመቼ፤ ገገይንከክዕኔ ኢተቀሜ፤ ወገሬቲን ሄዕዬ፤ ኢተለከ ወገሬት መገኑ ክዕኔን ሜጡበ እሀኖ።<verse eid="2CO 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 13:12"/>አመዕናኖተ ሀስሰኖ ሱንቃቀንሺን ሱንቃቀሜ።<verse eid="2CO 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 13:13"/>አመዕናኑት ጉዕሙንኩ «ወገሬት ዮንተንዶ?» ይቶህዕኔ።<verse eid="2CO 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 13:14"/>ቀርቾ መሲህ ኢስ ኣስቱቲ፥ መገን ኢተቲ፥ ጠሊለ አያን ሜጡ እሁ ጉዕሚንከክዕኔ እሁን።<verse eid="2CO 13:14"/></para>
  <chapter eid="2CO 13"/>
</usx>
