<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- HALABA NEW TESTAMENT</book>
  <para style="h">ሰቅ ያህይ</para>
  <para style="toc1">ያህይ ከተቦ ሰቅ ሶህኑተ</para>
  <para style="toc2">ሰቅ ሶህኑተ</para>
  <para style="toc3">3 ያህ.</para>
  <para style="mt1">ያህይ ከተቦሃ</para>
  <para style="mt2">ሰቅ ሶህኑተ</para>
  <para style="imt1">ኣጉስ</para>
  <para style="ip">ሰቅ ያህይ ሶህኑት ከተበንቶኢሁ «ባልቆ አሳቤቾ ያህይን» እሀን ከተበሞንኩ ጋዮሴ ዬኖ ዱእ ምኒ አወንሳንቺሃት እቅ፤ ከተባንቹንኩ መቶ አዲን ዎሉ አመዕናኑተ ሀዕለን ጋዮሴ ገለትጨኖስ፤ ዎሎ አዲን ዲዮትሬፊስ ዬኖስ ሂለ መንቺች አገዕሮታ ቃግሰኖስ።</para>
  <para style="iot">መጻፉስ አፎሃ</para>
  <para style="io1">ኣጉስ <char style="ior">(<ref loc="3JN 1:1-4">1-4</ref>)</char></para>
  <para style="io1">ጋዮሴ ገለትጩ <char style="ior">(<ref loc="3JN 1:5-8">5-8</ref>)</char></para>
  <para style="io1">ዲዮትሬፊስ ዎቀሰሙስ <char style="ior">(<ref loc="3JN 1:9-10">9-10</ref>)</char></para>
  <para style="io1">ድሜጥሮሴ ገለትጩ <char style="ior">(<ref loc="3JN 1:11-12">11-12</ref>)</char></para>
  <para style="io1">መጨረሸስ <char style="ior">(<ref loc="3JN 1:13-15">13-15</ref>)</char></para>
  <chapter number="1" style="c" sid="3JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1"/>ሀንቅን ኢታንኬ ጋዮሴ፥</para>
  <para style="p" vid="3JN 1:1">ኢች ባልቂቺች ሶሀንቶ ሶህኑተ፦<note caller="-" style="x"><char style="xo" closed="false">1፥1 </char><char style="xt" closed="false"><ref loc="ACT 19:29">ሶቀ. 19፥29</ref>፤ <ref loc="ROM 16:23">ሮሜ 16፥23</ref>፤ <ref loc="1CO 1:14">1 ቆሮ. 1፥14</ref>።</char></note><verse eid="3JN 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2"/>ኢተንቶንት አመኤ ቤቶ! አያኒን ፎሉክ ጡመ እሁስ ደጎም፤ ህትን አን ጉዕሙርቹንኩ ብዝዮሄተለከ አፍያተ ደእቶተ ዱአ አኣሚት። <verse eid="3JN 1:2"/><verse number="3" style="v" sid="3JN 1:3"/>ሀንቂሃ አመዕነንቶንቲሃ እሁክለከ ፈንቀላንታንቲንኩ ሀንቂን እኮገ መት-መቱ አመዕናኑት ኩልታዕኔ አበ ተሽ ይዮኤ። <verse eid="3JN 1:3"/><verse number="4" style="v" sid="3JN 1:4"/>አን ኦሱኤ ሀንቅ አዎንታገ ሞጮጪች በተአኖ ሙንዲሲሰኖርቹ ዮበአ።<verse eid="3JN 1:4"/></para>
  <para style="s1">ጋዮስ ገለትጨሙስ</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5"/>ኢተንቶንት አመኤ ቤቶ! ኬሳሃ ኮሃ እኮጎሬሁ አመ ኦሶተ አታንትርቾን ጉዕማንን አመዕነቶንትሃን። <verse eid="3JN 1:5"/><verse number="6" style="v" sid="3JN 1:6"/>እሰን ኢተክተኔሃ ዱእ ምናን ኩልቶኡ፤ ቴሁ መገኑ ሙንዲሲሰኖ ሃሊን ዎቄሰ ሽንቅተ ሀዕልቶንትጎሬ ጡመ አታንቲት። <verse eid="3JN 1:6"/><verse number="7" style="v" sid="3JN 1:7"/>ሱዕምስተኔሃ ፉልቶኢሁ አይሁደ እህበ መኒች ሜጡረ ቶጉዕናንት። <verse eid="3JN 1:7"/><verse number="8" style="v" sid="3JN 1:8"/>ህካን እኮቤቺሃ ነኡ ሜጡበ እሂን ሀንቅ ሆጉተ አዕኖተ ህትኔ ኮህነቱ ቶጉ ሀስሰኖኔ።<verse eid="3JN 1:8"/></para>
  <para style="s1">ዲዮትሬፊስ ዎቀሰሙስለከ ድሜጥሮሴ ገለትጨሙስ</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9"/>ከኒች ብርተ ዱእ ምኒሃ ደብዳቤተ ከተቦም፤ ጠዉ እኮጎሬ ገውንኩስ አዎንሳንቹ እሆተ ሀሰኖ ዲዮትሬፊስ ጠወእ ቶጎበአ። <verse eid="3JN 1:9"/><verse number="10" style="v" sid="3JN 1:10"/>ህካን እኮቤቺሃ አን ክዕኔቤቹ አሜታምረ እስ ቦሮረኔለከ ሙልሰኔ አዕዮ ሂለ ሆጎስተኔሃ በነቻን ጠወኣም፤ ካን አዕዮሁ ሆፈዕያንስ አመኦሱተ ኮህንተ ቶገኖበአ፤ ዎሉሰ ኮህንተ ቶጋበእገ ከመኖ፤ እሰንተ ዱእ ምናች ፉሸኖሰ።<verse eid="3JN 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11"/>ኢተንቶንት አመኤ ቤቶ! ጡመ አጉድ ቤሉ ሂለ አጉዶት፤ ጡመርቹ አአኖሁ ጉዕሙንኩ መገንየን፤ እኮጎሬ ጡመርቹ አእባሃ መገኑ ደገኖስበአ።<verse eid="3JN 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12"/>ድሜጥሮስተኔሃ መኑ ጉዕሙንኩ ጡመርቹ መሰከረኖት፤ ህትን ሀንቁ ገዉንኩስ መሰከረኖ፤ ነኡሁ መሰከርናም፤ ኒ ምስክሩንኩ ሀንቅ እሁስ አት ደጋንት።<verse eid="3JN 1:12"/></para>
  <para style="s1">መጨረሽ ወገሬትሱ</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13"/>አን ከተባንክዕኔ ልግቡ ጠው ሄዕዮኤጎሬ ደብዳቤን ከተቦተ ሀሾምበአ። <verse eid="3JN 1:13"/><verse number="14" style="v" sid="3JN 1:14"/>አን ግደኖ በሬን ደቀሞሄተ ተብሳሃ አኣም፤ ህከ ወክት ሜጡበ እንክ ጉዕመርቹንከ ጠወዕናም።<verse eid="3JN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15"/>ወገሬቱ ኬሳን እሁን።</para>
  <para style="p" vid="3JN 1:15">ኢተክ ጉዕሙንኩ «ወገሬቴ» ይታሄት። አቲሁ ኢታተኔ ጉዕሚንከ «ወገሬቲኤ» ኢልስ።<verse eid="3JN 1:15"/></para>
  <chapter eid="3JN 1"/>
</usx>
