<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- HALABA NEW TESTAMENT</book>
  <para style="h">ዎኔ ያህይ</para>
  <para style="toc1">ያህይ ከተቦ ዎኔ ሶህኑተ</para>
  <para style="toc2">ዎኔ ሶህኑተ</para>
  <para style="toc3">1 ያህ.</para>
  <para style="mt1">ያህይ ከተቦሃ</para>
  <para style="mt2">ዎኔ ሶህኑተ</para>
  <para style="imt1">ኣጉስ</para>
  <para style="ip">ዎዕኔ አሳባች ያህይ ሶህኑት ለሙ ቡዕለ እኮ ጠዉ ዮስ። ሁኩንን ካን አነበባእሩ መገኒንለከ ቤቶሃስ መሲህ ኢስን ሜጦመት ሄኦሰተ ጠረኝሲሃለከ ከ ሜጦመተ ቤሶተ አታለኖ ክህብ ትምርቲች አገዕርቶታት። ህከ ወክት ኬዕዮ ክዝብ ትምርቱ አሜተኖሁ ከን ኣዱንያ ጠዊች እኮቤቺሃ መገን ቤቱ ኢስ ሆሮን መንቹ እሆተ አታለኖበአ የኖሃን እቅ። ሁኩ አስተማረት «ጡሙ ዩ ኣዱንያ ጠዊሃ ጨነቀሙ አጉሩ ዩሃን» ይታ እቅ። ከኒንን በርግት «ጡመ ጠወ አኡለከ ዎሎ መኒሃ ኢተተ ለሊሱ ጡሞን ሜጡ ደቀንሹ ዮስበአ» ይታ እቅ።</para>
  <para style="ip">ከተቦሲሁ ከ ትምርት ቶጉ ግብ መሲህ ኢስ መነ ጡምሶተ ይ መንቹ እኮኡ፤ ኢሳን አመዕንታእሩለከ መገኑ ኢትታእሩ ጉዕሙንኩ ገገዉንኩሰ ኢተቀሙ ሀስሰኖሰ የን ኩሎኡ።</para>
  <para style="iot">መጻፉስ አፎሃ</para>
  <para style="io1">ኣጉስ <char style="ior">(<ref loc="1JN 1:1-4">1፥1-4</ref>)</char></para>
  <para style="io1">ኑርለከ ቱንስቹ <char style="ior">(<ref loc="1JN 1:5-2:29">1፥5—2፥29</ref>)</char></para>
  <para style="io1">መገን ኦሱተለከ እልቢስ ኦሱተ <char style="ior">(<ref loc="1JN 3:1-24">3፥1-24</ref>)</char></para>
  <para style="io1">ሀንቅለከ ክዝብ <char style="ior">(<ref loc="1JN 4:1-6">4፥1-6</ref>)</char></para>
  <para style="io1">ኢተት ግደ እሁስ <char style="ior">(<ref loc="1JN 4:7-21">4፥7-21</ref>)</char></para>
  <para style="io1">ድሉ ዮስ አመዕነቱ <char style="ior">(<ref loc="1JN 5:1-21">5፥1-21</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="1JN 1"/>
  <para style="s1">ሄእ ላገተ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1"/>ክልቀቲች ብርተ ዮ ሄእ ላገተኔ ሞጮጭኖሚሃ፥ እሌንተኔ ለዕኖሚሃ፥ አጥራመንት ለዕኖሚሃለከ አንጋንከኔ አንፎሚሃ ኩልናንክዕኔ።<note caller="-" style="x"><char style="xo" closed="false">1፥1 </char><char style="xt" closed="false"><ref loc="JHN 1:1">ያህ. 1፥1</ref>።</char></note> <verse eid="1JN 1:1"/><verse number="2" style="v" sid="1JN 1:2"/>ኩ ሄኡ ለልዮኡ፤ ነኡን ለዕኖም፤ መሰከርናም፤ ከኒች ብርተ አናከኔ መገን ቤቾን ዮኢሃለከ ኔሳሃ ለሌኢሃ ዘላለሚሃ ሄአኖ ሄእተኔሃ ኩልናንክዕኔ።<note caller="-" style="x"><char style="xo" closed="false">1፥2 </char><char style="xt" closed="false"><ref loc="JHN 1:14">ያህ. 1፥14</ref>።</char></note> <verse eid="1JN 1:2"/><verse number="3" style="v" sid="1JN 1:3"/>ኒን ሜጡበ ሜጦመት ሄኦህዕኔተ ለዕኖሚሃለከ ሞጮጭኖሚሃ ክዕኔንከ ኩልናንክዕኔ፤ ኒ ሜጦመት አነ መገኒንትለከ ቤትንከስ መሲህ ኢስን ሜጡባት። <verse eid="1JN 1:3"/><verse number="4" style="v" sid="1JN 1:4"/>ሙንዲኑኔ ዊመ እኮተ ካን ከተንባንክዕኔ።<note caller="+" style="f"><char style="fqa" closed="false">ሙንዲኑኔ፦ </char><char style="ft" closed="false">መት-መቱ ሉህ ክታበት «ሙንዲኑክዕኔ» ይታአ።</char></note><verse eid="1JN 1:4"/></para>
  <para style="s1">መገኑ ኑር እሁስ</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5"/>ኢሲች ሞጮጭኖሚሁለከ ክዕኔሃ ኩልናም ሶህኑት ተኒት «መገኑ ኑር እኮቤቺሃ እስቤቾን ቱንስቹ ሆሮን ዮበአ» ይታእተ። <verse eid="1JN 1:5"/><verse number="6" style="v" sid="1JN 1:6"/>ህካን እኮቤቺሃ «መገኒን ሜጦመት ዮኔ» ይነን ቱንስች ኣዜን ሄዕኖም ጎሬ ክዝምባሚት ቤሉ ሀንቅን ሄዕኖምበአ ዩሃን። <verse eid="1JN 1:6"/><verse number="7" style="v" sid="1JN 1:7"/>ጠዉ እኮጎሬ እስ ኑሬን ሄዕዮገን ነኡ ኑሬን ሄዕኖም ጎሬ ገገዉንኩኔ ሜጦመት ሄኣኔ፤ ህትን ቤትስ ኢስ ቄጉ ጩብች ጉዕሚችን ነጠ አአኖኔ።<note caller="-" style="x"><char style="xo" closed="false">2፥7 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ያህ. 13፥34</ref>።</char></note><verse eid="1JN 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8"/>ህካን እኮቤቺሃ ነኡ «ጩቡ ዮኔበአ» ይኖምጎሬ ገዉኔ ሉስንሳሚት ቤሉ ሀንቁ ኒ ኣዜን ዮበአ። <verse eid="1JN 1:8"/><verse number="9" style="v" sid="1JN 1:9"/>ህትን ጩብኔ መገኒሃ ኩልኖሚች መገኑ አመዕነሞሃለከ ፈየ እኮቤቺሃ ጩብኔ ጉዕመንከ «ፈቁን» የኖ፤ ህትን ጩብችኔ ጉዕሚችን ነጠ አአኖኔ። <verse eid="1JN 1:9"/><verse number="10" style="v" sid="1JN 1:10"/>ነኡን «ጩብ አዕኖምበአ» ይናሚሃ እንኮምጎሬ መገኑ ክዝበኘ አዕናምት፤ ህትን መገን ላገንት ኒ ኣዜን ዮበአ።<verse eid="1JN 1:10"/></para>
  <chapter eid="1JN 1"/>
  <chapter number="2" style="c" sid="1JN 2"/>
  <para style="s1">መሲህ ጠበቀኔ እሁስ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1"/>ኢ ኦሶ! ካን ከተባንክዕኔሁ ጩብ አቴነንተበእገዪህት፤ ጠዉ እኮጎሬ ሀኩ መንቹሁ ጩብ አዕዮ ጎሬ አናኔ መገን ቤቾን ጠበቁ ዮኔ፤ እስን ፈዩ መሲህ ኢሳት።<note caller="-" style="x"><char style="xo" closed="false">3፥1 </char><char style="xt" closed="false"><ref loc="JHN 1:12">ያህ. 1፥12</ref>።</char></note> <verse eid="1JN 2:1"/><verse number="2" style="v" sid="1JN 2:2"/>ኒ ጩብተኔሃ ኦርሸተ ቶጎሁ እሶት፤ ህትን ኒ ጩብ ጠለዕለ እሁዕነ ኣዱንያ አሌን ሄአኖ መኒሃ ጉዕሚንካንት።<verse eid="1JN 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3"/>አዘዦኔሃ አገርኖምጎሬ መገኑ ደንጋምገ እሲን አጥራመንታም። <verse eid="1JN 2:3"/><verse number="4" style="v" sid="1JN 2:4"/>«አን መገኑ ደጋም» የን እስ አዘዦሃ አገርቡ መንቹ ክዝበኛ ቤሉ ሀንቁ እስ ኣዜን ዮበአ። <verse eid="1JN 2:4"/><verse number="5" style="v" sid="1JN 2:5"/>ጠዉ እኮጎሬ መገን ላጋተ አዘዘመኖሁ ጉዕሙንኩ መገኒሃ ዮስ ኢተት ዊመሃን፤ ሀንቅንከ እሲን ሄኡኔ ደገመኖሁ ከኒንት። <verse eid="1JN 2:5"/><verse number="6" style="v" sid="1JN 2:6"/>አዪሁ «መገኒን ሜጡበ ሄኣም» የኖሁ መሲህ ሄዕዮገ እክ ሄኡ ሀስሰኖስ።<verse eid="1JN 2:6"/></para>
  <para style="s1">ሃዕሮ ትዛዝ</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7"/>ኢ ጃላ! ኩ ከተባንክዕኔ ትዛዙ ዎዕኔችን ኬሽ ዮእሃ ትዛዝ ቤሉ ሃዕሮሃ ትዛዝበአ፤ ኩን ዎዕኔችን ጀመር ዮ ትዛዝ ሄጭቴን ሞጮጭቴንታእተ ላገ። <verse eid="1JN 2:7"/><verse number="8" style="v" sid="1JN 2:8"/>እሁን ቤሉ መሲሂንለከ ክዕኔ ሩሂን ሀንቅ እኮሃ ሃዕሮ ትዛዝ ከተባንክዕኔ፤ መሰንትስ ቱንስቹ ህገኖት ቴሁ ሀንቅ ኑሩ ለሊሰኖት።<verse eid="1JN 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9"/>አዪሁ «ኑሬን ሄኣምት» የን አመስቤቱ ግበኖሁ ቴሱ ኢለ ቱንስቾን ሄአኖት። <verse eid="1JN 2:9"/><verse number="10" style="v" sid="1JN 2:10"/>አመስቤቱ ኢተኖሁ ኑር ኣዜን ሄአኖ፤ ህካን እኮቤቺሃ እሲን መነ ቆል ሉስሰኖርቹ ዮበአ። <verse eid="1JN 2:10"/><verse number="11" style="v" sid="1JN 2:11"/>ጠው እኮጎሬ አመስቤቱ ግበኖሁ ቱንስች ኣዜን ሄአኖ፤ ቱንስች ኣዜንን ፈንቀለመኖ፤ ቱንስቹንኩ እልስ ቆቅሾቤቺሃ ኦሮአኖቤቹሃ ደገኖበአ።<verse eid="1JN 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12"/>ኢ ኦሶ! ጩቡክዕኔ ኢስ ሱዕሚን አጉረሞህዕኔቤቺሃ ከተባንክዕኔ። <verse eid="1JN 2:12"/><verse number="13" style="v" sid="1JN 2:13"/>አናከ! ዎዕኔች ሄዕዮሃ ላገስ ደጌነንተቤቺሃ ከተባንክዕኔ፤ ወደላ! ሼይጣነ ቄልቴንተቤቺሃ ከተባንክዕኔት፤ <verse eid="1JN 2:13"/><verse number="14" style="v" sid="1JN 2:14"/>ኦሶ! መገኑ ደጌንተቤቺሃ ከተቦንክዕኔ፤ አናከ! ወዕናንከ ሄጭ ዮኢሃ ላገስ ደጌንተቤቺሃ ከተቦንክዕኔ፤ ወደላ! ጠረኘ እኬንተቤቺሃለከ መገን ላገት ቀልቤንከክዕኔ ሄኣቤቺሃለከ ሼይጣን ቄልቴንተቤቺሃ ከተቦንክዕኔ።<verse eid="1JN 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15"/>ኣዱንያ አል ህከረንገ ኣዱንያ አሌን ዮ ሂለ ጠወ ኢትቶኖቼ፤ ኣዱንያ አል ኢተኖሁ አና መገኑ ኢተኖበአ። <verse eid="1JN 2:15"/><verse number="16" style="v" sid="1JN 2:16"/>ኣዱንያ አሌን ዮኢሁ ጉዕሙንኩ ማል ሄዕላቸተ፥ እሌ ተሽት፥ ቀባጦን ድከኡ ኣዱንያ አልችቤሉ አና መገን አዲችበአ። <verse eid="1JN 2:16"/><verse number="17" style="v" sid="1JN 2:17"/>ዱንያ አሉለከ ሄዕላቸት ህጋአ፤ ጠው እኮጎሬ መገኑ የኖሃ አአኖሁ ጉዕመ ዘላለሚሃ ሄአኖ።<verse eid="1JN 2:17"/></para>
  <para style="s1">መሲህ ግባሀኑኡች አገዕርዬ</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18"/>ኢ ኦሶ! ኩን መጨረሽሃ ወክት፤ መጨረሽ ወክቴን «መሲህ ግበኖሁ አሜተኖ» ዬኖሃ ሞጮጭቴነንተገን ቴሁ ልግቡ መሲህ ግባሩ አሜቶኡ፤ ሁኩንን መጨረሽ ወክት እሁስ ደንጋም። <verse eid="1JN 2:18"/><verse number="19" style="v" sid="1JN 2:19"/>እሰን ፉልቶኢሁ ኒ በልቺት፤ ጠው እኮጎሬ እሰን ኒረበአ፤ እሰን ኒረ እኮ እቃኔተ ኒን ሜጡበ ጠረኝት ሄኣ እቅ፤ ጠው እኮጎሬ እሰ ጉዕሙንኩሰ ኒረ እሁ ሆጉሰ ደገሞተ ኒ በሊች አደ እክ ፉልቶኡ።<verse eid="1JN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20"/>መገን ጠሊለ እኮ መሲሁ ክዕኔተ ጠሊለ አያኒን ቡሮህዕኔ፤ ህካን እኮቤቺሃ ጉዕሙንኩክዕኔ ሀንቅ ደጌነንተ። <verse eid="1JN 2:20"/><verse number="21" style="v" sid="1JN 2:21"/>አን ከተባንክዕኔሁ ሀንቅ ደጌነንተበእረ እኬንተቤቺሃ እሁዕናን ሀንቅ ደጌነንተረለከ ሀንቅ ኣዚች ክዝቡ ፉለኖበእገ ደጌነንተቤቺሃት።<verse eid="1JN 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22"/>ኢስ «መሲሂበአ» ይ ለገአኖሀን ቤሉ ክዝበኙ አይ ዮኡ? ህትን አነ መገኑለከ ቤቱ ለገአኖሁ እስ መሲህ ግበኖሃን። <verse eid="1JN 2:22"/><verse number="23" style="v" sid="1JN 2:23"/>ቤቱ ለገአኖሀኒሃ ጉዕሚንከ አኑ መገኑ ዮስበአ፤ ህትን አን ቤቲንከስ አመዕናም ይ መሰከረኖሀኒሃ አኑ መገኑ ዮስ።<verse eid="1JN 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24"/>ህካን እኮቤቺሃ አዕኑ ዎዕኔችን ሞጮጭቴንታሁ ክዕኔ ኣዜን ጠረኝ ሄኡን፤ ዎዕነ ሞጮጭቴንታሁ ክዕኔ ኣዜን ጠረኝ ሄዕዮ ጎሬ አዕኑ አነ መገኒንለከ ቤቲን ሜጡበ እኬን ሄኤነንተ። <verse eid="1JN 2:24"/><verse number="25" style="v" sid="1JN 2:25"/>ኩን እስ ኣሴኔ ተብሳሃን፤ ሁኩንን ዘላለምየ ሄኡ።<verse eid="1JN 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26"/>ካን አን ክዕኔተ ሉስሳህዕኔ መንተኔሃ ከተባሚት። <verse eid="1JN 2:26"/><verse number="27" style="v" sid="1JN 2:27"/>ጠዉ እኮጎሬ እስች ኣእቴንተ ጠሊሉ አያኑ ኣዜንከክዕኔ ዮቤቺሃ ዎሉ አስተማርቹ ሀስሰኖህዕኔበአ፤ እስ ጉዕመርቹንከ ተማርሰኖህዕኔ፤ እስ ተማርሰኖህዕኔሁ ሀንቅየ ቤሉ ክዝብሃበአ፤ ህካን እኮቤቺሃ እስ ተማርሰኖህዕኔ ሃሌን መሲህን ጠረኝቴን ሄዕዬ።<verse eid="1JN 2:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28"/>ቴሁ ኢ ኦሶ! ኢስ አሜተኖ በር ዋጅናምበእገለከ ሙልናበእገ እሶን ሄዕዬ። <verse eid="1JN 2:28"/><verse number="29" style="v" sid="1JN 2:29"/>መሲህ ፈየ እሁስ ደጌንታች ፈይመተ አአኖሁ ጉዕሙንኩ መገኒች እለሞሃ እሁስ ደጌነንተ።<verse eid="1JN 2:29"/></para>
  <chapter eid="1JN 2"/>
  <chapter number="3" style="c" sid="1JN 3"/>
  <para style="s1">መገን ኦሱተ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1"/>«መገን ኦሱተ» የመም ገአሞተ አኑ መገኑኔ ኣሴኔ ኢተት ሄንከ ጎሬ ለዕዬ፤ ህትን ሀንቅንከ ነኡ መገንተ እለ፤ ህካን እኮቤቺሃ ኣዱንያ አል መኑ መገኑ ደጉ ሆጎቤቺሃ ኔሳሃ ደጋኔበአ። <verse eid="1JN 3:1"/><verse number="2" style="v" sid="1JN 3:2"/>ኢ ኢተት! ቴሱ ነኡ መገንተ ኦሱ፤ ኤተሮንከስ መ እንካም ጎሬ ደንጎምበአ፤ ጠው እኮጎሬ ኢስ አሜቾ ወክት እሱ ገዉንከስ ለዕናምቤቺሃ እሱ አጉንዳምገ ደንጋም። <verse eid="1JN 3:2"/><verse number="3" style="v" sid="1JN 3:3"/>ኩን እሁስ መሲህ ተብሳሃ አአኖሁ ጉዕሙንኩ መሲህ ነጠ እኮገን እስ ገውስ ነጠ አአኖ።<verse eid="1JN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4"/>ጩብ አአኖሁ ጉዕሙንኩ መገን ሕገ ድጀኖ፤ መሰንትስ ጩቡ ገውንኩስ መገን ሕገ ድጁሃን። <verse eid="1JN 3:4"/><verse number="5" style="v" sid="1JN 3:5"/>መሲህ መን ጩብ ቤሶተ አሜቾገ ደጌነንተ፤ ህትን እሲን ጩቡ ዮበአ።<note caller="-" style="x"><char style="xo" closed="false">3፥5 </char><char style="xt" closed="false"><ref loc="JHN 1:29">ያህ. 1፥29</ref>።</char></note> <verse eid="1JN 3:5"/><verse number="6" style="v" sid="1JN 3:6"/>እሲን ጠረኝ ሄአኖሁ ጉዕሙንኩ ጩብ አአን ሄአኖበአ፤ ጩብ አአኖሁ ጉዕሙንኩ መሲህ ለዕዮበአ ህከረንገ ደጎበአ።<verse eid="1JN 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7"/>ኢ ኦሶ! አዪሁ ጣንሱንከህዕኔ፤ መሲህ ፈየ እኮገን ፈይመ ሆጉተ አአኖሁ ጉዕሙንኩ ፈየሃን። <verse eid="1JN 3:7"/><verse number="8" style="v" sid="1JN 3:8"/>እብልሱ ዎዕኔችን ኬሽ ጩብ አአኖቤቺሃ ጩብ አአኖሁ ጉዕሙንኩ እብልስ አዲቺት፤ ህካን እኮቤቺሃ እብልስ ሆጉተ ቤሶተ መገን ቤቱ አሜቾኡ።<verse eid="1JN 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9"/>መገን ኦሱተ እኮሩ ጉዕሙንኩ ጩብ አቶተ አታልታበአ፤ መሰንትስ መገን ሃለቱ እሰ ኣዜን ሄአኖቤቺሃትለከ መገኒች ከለቀንቶቤቺሃት። <verse eid="1JN 3:9"/><verse number="10" style="v" sid="1JN 3:10"/>መገን ኦሱትለከ እብልስ ኦሱት ከኒን አደ እክ ለልታአ፤ ፈይመ ሆጉተ አእባሁለከ አመስቤቱ ኢትባሁ መገንያ ቤቱበአ።<verse eid="1JN 3:10"/></para>
  <para style="s1">ገገዉኔ ኢተቀምተኔሃ</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11"/>ዎዕኔችን ጀመርቴን ሞጮጭቴንተ ሶህኑት «ገገዉኔ ኢተቀሞ» ይታእታን።<note caller="-" style="x"><char style="xo" closed="false">3፥11 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ያህ. 13፥34</ref>።</char></note> <verse eid="1JN 3:11"/><verse number="12" style="v" sid="1JN 3:12"/>ሸይጣን አድረ እንክ አመስቤቱ ሼ ቃኤሌ እንኩንከ፤ እስ አመስቤቱ ሼኢሁ ሚሃት? ሆጉስ ሂለ እኮቤቺሃ አመስ ቤት ሆጉት ጡመ እኮቤቺሃበእንዶ?<note caller="-" style="x"><char style="xo" closed="false">3፥12 </char><char style="xt" closed="false"><ref loc="GEN 4:8">ክል. 4፥8</ref>።</char></note><verse eid="1JN 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13"/>ህካን እኮቤቺሃ አመኤ ኦሶ! ኣዱንያ አሉ ግቦህኔጎሬ አጀብሲጭቶኖቼ። <verse eid="1JN 3:13"/><verse number="14" style="v" sid="1JN 3:14"/>ነኡ አመኔኦሱተ ኢትናምቤቺሃ ሬሆች ሄኦን ህጉኔ ደንጋም፤ ጠው እኮጎሬ አመስቤቱ ኢትባሁ ሬሆ ኣዜን ሄአኖ።<note caller="-" style="x"><char style="xo" closed="false">3፥14 </char><char style="xt" closed="false"><ref loc="JHN 5:24">ያህ. 5፥24</ref>።</char></note> <verse eid="1JN 3:14"/><verse number="15" style="v" sid="1JN 3:15"/>ህትን አመስቤቱ ግበኖሁ ጉዕሙንኩ ነብሳሃ ሽዮእሃን፤ ነብሳሃ ሸኖሀኒሃ ጉዕሚንከ ዘላለሚሃ ሄአኖ ሄኡ ዮስበእገ ደጌነንተ። <verse eid="1JN 3:15"/><verse number="16" style="v" sid="1JN 3:16"/>ኢተት መሃጎር ደንጋሚሁ መሲህ ኢስ ኔሳሃ ነብሳስ ህግሽ ኣሴቤቺሃት፤ ህካን እኮቤቺሃ ነኡን አመኔ ኦሶተ ነብሳኔ ህግንስ ኣሱ ሀስሰኖኔ። <verse eid="1JN 3:16"/><verse number="17" style="v" sid="1JN 3:17"/>ጠዉ እኮጎሬ ከን ኣዱንያ አል ቀባጡት ዮስ መንቹ ኦርሻሙ አመስቤቱ ለዕይ አሙዝበስ ጎሬ መገን ኢተት ዮኤ ዮተ ሀት እክ አታለኖ። <verse eid="1JN 3:17"/><verse number="18" style="v" sid="1JN 3:18"/>ኢ ኦሶ! ሆጎንለከ ሀንቂን ኢተቀሙን ቤሉ ጠለዕል አፎንለከ ላጋን ኢተቀሙንከ።<verse eid="1JN 3:18"/></para>
  <para style="s1">መገን ብሬን ዮኔ አመዕነንሹ</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19"/>ህካን እኮቤቺሃ ሀንቅ መነ እሁኔ መገን ብሬን ዋጁ ዮበኢሃ መለልን ሆንጠንኮተ አታልናምገ ደንጋም። <verse eid="1JN 3:19"/><verse number="20" style="v" sid="1JN 3:20"/>ቀልቡኔ ሂለ ሆጎተኔ ዎቀሰኖሃ እኮች መገኑ ቀልቢችኔ ሎረ እኮቤቺሃ ጉዕመንከ ጠወ ደገኖገ ደንጋም። <verse eid="1JN 3:20"/><verse number="21" style="v" sid="1JN 3:21"/>ኢ ጃላ! ቀልቡኔ ዎቀስበኔሃ እኮች መገን ብሬን ሙልናምበአ። <verse eid="1JN 3:21"/><verse number="22" style="v" sid="1JN 3:22"/>ህትን ነኡ መገን ትዛዝ አገርናምቤቺሃለከ እሱ ሙንዲሲሰኖርቹ አዕናምቤቺሃ ኡጭናምርቹ ጉዕመንከ እሲች ደእናም። <verse eid="1JN 3:22"/><verse number="23" style="v" sid="1JN 3:23"/>መገን ትዛዙ ቤትንከስ መሲህ ኢስ ሱዕሚን አመዕንናምገለከ መገኑ አዘዦኔገን ገገዉኔ ኢተቀማምጋት።<note caller="-" style="x"><char style="xo" closed="false">3፥23 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ያህ. 13፥34</ref>፤ <ref loc="JHN 15:12">15፥12</ref>፤ <ref loc="JHN 17">17</ref>።</char></note> <verse eid="1JN 3:23"/><verse number="24" style="v" sid="1JN 3:24"/>ትዛዝስ አገረኖሁ ጉዕሙንኩ መገኒን ሄአኖ፤ ህትን መገኑሁ እስ ኣዜን ሄአኖ፤ ህካን እኮቤቺሃ መገኑ ኒ ኣዜን ሄኡስ ደንጋሚሁ እስ ኣሴኔ አያኒንት።<verse eid="1JN 3:24"/></para>
  <chapter eid="1JN 3"/>
  <chapter number="4" style="c" sid="1JN 4"/>
  <para style="s1">ሀንቅ አያንተኔሃለከ ክዝብ አያንተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1"/>ኢ ጃላ! አያኑ ጉዕሙንኩ መገኒሃ እሁስለከ መገኒሃ እሁ ሆጉሲ አጥረመቼ ቤሉ አያነ ጉዕመንከ አመዕንቶኖቼ፤ መሰንትስ ኣዱንያ አሌን ልግቡ ክዝብ ነብያኑት ኬኦኡ። <verse eid="1JN 4:1"/><verse number="2" style="v" sid="1JN 4:2"/>መገን አያነ እሁስ አደ አቴን ደጌነንታሁ ከኒንት፤ «መሲህ ኢስ መንቹ እክ አሜቾኡ» ይ አመዕን ኩለኖሁ ጉዕሙንኩ መገንየ አያነ። <verse eid="1JN 4:2"/><verse number="3" style="v" sid="1JN 4:3"/>ጠው እኮጎሬ መሲህ ኢስ ኒገን መንቹ እክ አሜቾበአ የኖ አያኑ ጉዕሙንኩ መገንየ አያነበአ፤ «ህትናሙ አያኑ አሜተኖ» ዬነን ሞጮጭቴንታሁ መሲህን ኢተቀምባሃ አያነ፤ እስ ቴሁ ኣዱንያ አሌን ዮኡ።<verse eid="1JN 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4"/>ኢ ኦሶ! አዕኑ መገንረ፤ ክዕኔን ዮ መገኑ ከን ኣዱንያ አሌን ዮሀኒች በተአኖቤቺሃ ክዝብ ነብያከተ ቄልቴንታአ። <verse eid="1JN 4:4"/><verse number="5" style="v" sid="1JN 4:5"/>እሰ ከን ኣዱንያ አል መነ እኮቤቺሃ ከን ኣዱንያ አል ጠወ ጠለዕል ጠወኣአ፤ ህካን እኮቤቺሃ ከን ኣዱንያ አሌን ሄአኖ መኑ ሞጮጨኖሰ። <verse eid="1JN 4:5"/><verse number="6" style="v" sid="1JN 4:6"/>ነኡ መገንረ እንኮምቤቺሃ መገኑ ደገኖሁ ጉዕሙንኩ ሞጮጨኖኔ፤ እኮጎሬ መገኒች እህባሁ ሞጮጨኖኔበአ፤ ህካን እኮቤቺሃ ሀንቅ አያነለከ ክዝብ አያነ ከኒን ደንጋም።<verse eid="1JN 4:6"/></para>
  <para style="s1">መገኑ ኢተታን</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7"/>ኢ ጃላ! ኢተት መገኒች እኮቤቺሃ ገገዉኔ ኢተቀሞ፤ ኢተቀመኖሁ ጉዕሙንኩ መገኒች እለሞእሃን፤ ህትን መገኑሃ ደገኖ። <verse eid="1JN 4:7"/><verse number="8" style="v" sid="1JN 4:8"/>መገኑ ኢተተ እኮቤቺሃ መነ ኢትባሁ ጉዕሙንኩ መገኑ ደገኖበአ። <verse eid="1JN 4:8"/><verse number="9" style="v" sid="1JN 4:9"/>ቤቲስ አዲን ሄኡ ደእኖተ መገኑ ሜጡ ቤቱስ ኣዱንያ አል ሶኮኡ፤ ህካን እኮቤቺሃ መገን ኢተት ሄንካጎሬ ለልዮኔ። <verse eid="1JN 4:9"/><verse number="10" style="v" sid="1JN 4:10"/>ኢተት ዩ ህትጎታን፤ ነኡ መገኑ ኢትናምቤቺሃ እሁዕናን መገኑ ኢቴኔቤቺሃትለከ ቅጣትኔ ኣኦተ ቤቱስ ሶኮኔቤቺሃት።<verse eid="1JN 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11"/>ኢ ጃለ! መገኑ ህት ኢቴኔሃ እኮች ገገዉንኩኔ ኢተቀሙ ሀስሰኖኔ። <verse eid="1JN 4:11"/><verse number="12" style="v" sid="1JN 4:12"/>መገኑ ለእዮ መንቹ አዪሁ ዮበአ፤ ገገዉንኩኔ ኢተቀሞም ጎሬ መገኑ ኒ ኣዜን ሄአኖ፤ ህትን እስ ኢተት ኒ ኣዜን ዊመ እክ ሄኣአ።<note caller="-" style="x"><char style="xo" closed="false">4፥12 </char><char style="xt" closed="false"><ref loc="JHN 1:18">ያህ. 1፥18</ref>።</char></note><verse eid="1JN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13"/>መገኑ አያነስ ኔሳሃ ኣሴኔቤቺሃ እሲን ሄዕናምገ እስን ኒን ሄአኖገ ህከኒን ደንጋም። <verse eid="1JN 4:13"/><verse number="14" style="v" sid="1JN 4:14"/>አኑ መገኑ ቤቱስ ኣዱንያ አልሃ መነ ጡምሶተ ሶሁስ ለዕኖሚሃ መሰከርናም። <verse eid="1JN 4:14"/><verse number="15" style="v" sid="1JN 4:15"/>ኢስ መገንየ ቤቱ ይ መሰከረኖ መንቾን ጉዕማንን መገኑ ሄአኖ፤ ህትን እስን መገኒን ሄአኖ። <verse eid="1JN 4:15"/><verse number="16" style="v" sid="1JN 4:16"/>ህከን እኮቤቺሃ መገኑ ኔሳሃ ኢቱስ ደንጋም፤ አመዕንናም። መገኑንኩ ኢተታን፤ ኢታን ሄአኖሁ መገኖን ሄአኖ፤ ህትን መገኑንኩ እሲን ሄአኖ። <verse eid="1JN 4:16"/><verse number="17" style="v" sid="1JN 4:17"/>ከን ኣዱንያ አሌን መሲህ ሄዕዮገ ሄዕኖም ጎሬ ኢተት ኒን ዊመ እካአ፤ ህካን እኮቤቺሃ ፍርድ በር ብርስ ዋጅኑዕነ ሆንጠንኮተ አታልናም። <verse eid="1JN 4:17"/><verse number="18" style="v" sid="1JN 4:18"/>ሀንቅ ኢተት ዋጁ ፉሽት ኡጅታ ቤሉ ኢታን ዋጁ ዮበአ፤ ዋጁ ቅጣቲን ሜጡበ እክ ዮቤቺሃ ዋጀኖ መንች ኢተት ዊመተበአ።<verse eid="1JN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19"/>መገኑ ኔሳሃ ሄጭ ኢቴኔቤቺሃ ነኡን ኢትናም። <verse eid="1JN 4:19"/><verse number="20" style="v" sid="1JN 4:20"/>አዪሁ «መገኑ ኢታም» የን አመስቤቱ ግበኖሁ ክዝበኛን፤ ለዕዮ አመስቤቱ ኢትባሁ ለእበ መገኑ ኢቶተ አታለኖበአ። <verse eid="1JN 4:20"/><verse number="21" style="v" sid="1JN 4:21"/>ህካን እኮቤቺሃ መሲህ ኣሴኔ ትዛዙ መገኑ ኢተኖሁ አመስቤቱሃ ኢቱን የኖሃን።<verse eid="1JN 4:21"/></para>
  <chapter eid="1JN 4"/>
  <chapter number="5" style="c" sid="1JN 5"/>
  <para style="s1">ኣዱንያ አል ሂለርቹ ቄሉ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1"/>ኢሰ መሲህ እሁስ አመዕነኖሁ ጉዕሙንኩ መገኒች እለሞእሃን፤ አዪሁ አነ መገኑ ኢተኖሁ ጉዕሙንኩ ቤቱሲ ኢተኖ። <verse eid="1JN 5:1"/><verse number="2" style="v" sid="1JN 5:2"/>መገን ኦሱተ ኢቱኔ ደንጋሚሁ መገኑ ኢትኖምጎሬትለከ ትዛዝስ አገርኖምጎሬት። <verse eid="1JN 5:2"/><verse number="3" style="v" sid="1JN 5:3"/>መገኑ ኢትናም ዩ ትዛዝስ አገሩሃን፤ ህትን ትዛዙንኩስ ኬዕምበሃን። <verse eid="1JN 5:3"/><verse number="4" style="v" sid="1JN 5:4"/>መሰንትስ መገኒች እኮሁ ጉዕሙንኩ ኣዱንያ አል ቄለኖ፤ ኣዱንያ አል ቄልናሚንኩ አመዕነቲንት። <verse eid="1JN 5:4"/><verse number="5" style="v" sid="1JN 5:5"/>ኢስ መገን ቤቱ እሁስ አመዕነኖሀን ቤሉ ኣዱንያ አል ቄለኖሁ አዬት?<verse eid="1JN 5:5"/></para>
  <para style="s1">መሲህተኔሃ መሰከረሞ ጠወ</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6"/>መሲህ ኢስ አሜቾሁ ዊ [ጥምቀቲንትለከ መስቀል ሬሆ ቄጊንት]፤ እስ አሜቾሁ ጠለዕል ዊን እሁዕነ ዊንለከ ቄጊንት፤ ካን መሰከረኖሁ መገንየ አያነ፤ መገን አያኑ ሀንቅያን። <verse eid="1JN 5:6"/><verse number="7" style="v" sid="1JN 5:7"/>ሰሱ ምስክሩ ዮኡ፤ <verse eid="1JN 5:7"/><verse number="8" style="v" sid="1JN 5:8"/>እሰን ጠሊለ አያነ፥ ዋሃለከ ቄጎሃን፤ ሰሱንኩ ምሰክሩ ኢተቀንታአ። <verse eid="1JN 5:8"/><verse number="9" style="v" sid="1JN 5:9"/>ነኡ መን ምስክር ኣእኖም ጎሬ መገን ምስክሩ ጉዕሚችን በተአኖሃን፤ ምስክሩንኩስ መገኑ ቤትስተኔሃ መሰከሮሃ ጠወ። <verse eid="1JN 5:9"/><verse number="10" style="v" sid="1JN 5:10"/>መገን ቤቶን አመዕነኖሀኒሃ ቀልብስ ኣዜን ምስክሩ ዮስ፤ መገኖን አመዕንበ መንቹ መገኑ ቤትስተኔ መሰከሮ ጠዋን አመዕንዮበእቤቺሃ ሁኩ መንቹ መገኑ ክዝበኘ አዕዮኡ። <verse eid="1JN 5:10"/><verse number="11" style="v" sid="1JN 5:11"/>ምስክርነቱንኩስ መገኑ ዘላለም ሄኡ ኣሴገለከ ሁኩ ሄኡንኩ ቤቲንከስ ሄኡስ መሰከረኖ።<note caller="-" style="x"><char style="xo" closed="false">5፥11 </char><char style="xt" closed="false"><ref loc="JHN 3:36">ያህ. 3፥36</ref>።</char></note> <verse eid="1JN 5:11"/><verse number="12" style="v" sid="1JN 5:12"/>መገን ቤቱ ዮስ መንቺሃ ሄኡ ዮስ፤ ጠው እኮጎሬ መገን ቤቱ ዮስበእ መንቺሃ ሄኡ ዮስበአ።<verse eid="1JN 5:12"/></para>
  <para style="s1">ዘላለም ሄኡ</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13"/>አዕኑ መገን ቤት ሱዕሚን አመዕንቴነንተሩ ጉዕሙንኩ ዘላለም ሄአኖ ሄኡ ዮህኔሃ እሁስ ደጎኖተ ከተቦንክዕኔ። <verse eid="1JN 5:13"/><verse number="14" style="v" sid="1JN 5:14"/>መገን ብሬን ሆንጠንኮተ ዮኔ መለልመት ከኒት፤ መቱርቹሃ እስ ሃሽኣቶስገ ኡጭኖም ጎሬ ሞጮጨኖኔ። <verse eid="1JN 5:14"/><verse number="15" style="v" sid="1JN 5:15"/>ነኡ ኡጭናምርቹ ጉዕመንከ መገኑ ሞጮጨኖኔገ ደንጎሚች እሲች ኡጭናምርቹ ጉዕመንከ ኣእኖምገ ደንጋም።<verse eid="1JN 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16"/>ሀኩ መንቹሁ አመስቤቱ ሬሆተ ኢልስበ ጩብ አአን ለዕዮስጎሬ ዱአ አኡን፤ ጩቡስ ሬሆተ እልስባሃ እኮጎሬ መገኑ ፌሰኖስ፤ ጠዉ እኮጎሬ ሬሆተ ኢልሰኖ ጩቡ ዮኡ፤ ህትናሞ ጩቢሃ «ዱአ አኦን» ያንስበአ። <verse eid="1JN 5:16"/><verse number="17" style="v" sid="1JN 5:17"/>ሂለ ሆጉት ጉዕሙንኩ ጩብሃን፤ ጠዉ እኮጎሬ ሬሁተ እልስቡ ጩቡ ዮኡ።<verse eid="1JN 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18"/>መገን ቤቱ መሲህ ኢስ አገረኖቤቺሃ መገን እለተ እኮሩ ጉዕሙንኩ ጩብ አታበእገ ደንጋም፤ ሼይጣኑሁ ኡለኖሰበእገ ደንጋም፤<note caller="+" style="f"><char style="ft" closed="false">መት-መቱ ግርኪች እንክለንቶሩ ከኒች ዎሮን ዮኢሃ በርግታበአ፤ ሁኩንን መገኒች እለሞሁ ጉዕሙንኩ ገውስ አገረኖቤቺሃ ጩብ አአኖበእገ ደንጋም፤ ሼይጣኑሁ ኡለኖስበአ።</char></note><verse eid="1JN 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19"/>ነኡ መገንረ እሁኔ ደንጋም፤ ጠዉ እኮጎሬ ከን ኣዱንያ አል ጉዕመንከ ሸይጣኑ ጠቅዮሰ።<verse eid="1JN 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20"/>መገን ቤቱ አሜቾገለከ ነኡ ሀንቅ እኮ መገኑ ደንጎተ ሰውየኖ ቀልብ ኣሴኔገ ደንጋም፤ ነኡ ሀንቅ እኮ መገን ኣዜንለከ ቤቲንከስን መሲህ ኢስ አዲን እሲን ሀንቅ መገኒን ሜጦመት ዮኔ፤ እስ ሀንቅያ መገኑለከ ዘላለሚሃ ሄአኖሃ ሄኡ።<verse eid="1JN 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21"/>ቴሱ ኦሶ! ሽርኬን ሰገዲች ገዉክዕኔ አገዕርዬ።<verse eid="1JN 5:21"/></para>
  <chapter eid="1JN 5"/>
</usx>
