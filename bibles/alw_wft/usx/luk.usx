<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LUK" style="id">- HALABA NEW TESTAMENT</book>
  <para style="h">ሉቃስ እንጂለ</para>
  <para style="toc1">ሉቃስ ከተቦ ቀርችኔ መሲህ ኢስ እንጂለ</para>
  <para style="toc2">ሉቃስ እንጂለ</para>
  <para style="toc3">ሉቃ.</para>
  <para style="mt1">ሉቃስ ከተቦሃ</para>
  <para style="mt2">ቀርችኔ መሲህ ኢስ እንጂለ</para>
  <para style="imt1">ኣጉስ</para>
  <para style="ip">ሉቃስ እንጂሉ ኢሰ ሆንጠህሰኖሁ ሄጭ አሜተኖ የመም ነቢያካን ጠወአሞሁ አበ ዘማኒሃ ተቢሴ አነ እኮ እስራኤል ኡመቱ አገረን ሄዕዮ «ቡረሞ መሲህ ኢስ» ህትን መን ዘሬተ ጉዕሚንከ «ጡምሳንቹ» እሁስ ለሊስኒት። ሉቃስ ኢሰ «ቡጥቻኖተ እንጂለ ዱዱብሶተ» አኒችስ ሶሀሞሃ እሁስለከ ኩ እንጂሉ መኑ ዮስ መት-መቶ ኦሪሻተ ደግለለኖሃ እሁስ ሂር ኩለኖ። ሉቃስ እንጂል ኣዜን በትሽን ኢስ አሜቱ ኩልታ ዎዕኔ ፎሎጮንለከ ህትን ኢስ ሰማሃ ኦሮኡስ ኩልታ መጨረሽ ፎሎጮን ለሊ ጠወአሞኢሁ ሙንዲኖተኔሃት። ኢስ ሰማሃ ኦሮዕዮች ኤተሮን አመዕነቱ ሀት እክ ለንኪሃ አልባዕሉስ ኩለኖ ሄሱት ሶቀማኖ ሆጎ መጻፍ ኣዜን ካን ከተቦ መንቺን ኩለሞኡ።</para>
  <para style="ip">መላይከ መዝሙረ ኢስ እለሞ ወክት ዜማኑት ለኦስገ ኩልታ ሄሱት ኢስ ኦስማንከስ ዱእ ምኒ መሩስ ጎደበ ላፈ ሳምራውችለከ በዕይ ደገሞ ጩል ሄሱት ጠለዕል ሉቃስ እንጂላን ሄኣእራን። እንጂል ኣዜን ገበሊች ገበለ ኢለ አበ ሰው የመሞኢሁ ዱአ አእተኔሃ፥ ጠሊለ አያንተኔሃለከ ሜንቱ ኢስ ክድመ ኣዜን ሄኡ ሀስሰኖሰ ቤቹለከ መገኑ ጩብ ፈቁን ዩሲት።</para>
  <para style="iot">መጻፉስ አፎሃ</para>
  <para style="io1">ኣጉስ <char style="ior">(<ref loc="LUK 1:1-4">1፥1-4</ref>)</char></para>
  <para style="io1">ጠመቃንቾ ያህይለከ ኢስ እለሙስ <char style="ior">(<ref loc="LUK 1:5-2:52">1፥5—2፥52</ref>)</char></para>
  <para style="io1">ጠመቃንቾ ያህይ ክድመተ <char style="ior">(<ref loc="LUK 3:1-20">3፥1-20</ref>)</char></para>
  <para style="io1">ኢስ ጠመቀሙስለከ ፌተነሙስ <char style="ior">(<ref loc="LUK 3:21-4:13">3፥21—4፥13</ref>)</char></para>
  <para style="io1">ኢስ ክድመስ ለሊሽ ገሊላን ጀመሩስ <char style="ior">(<ref loc="LUK 4:14-9:50">4፥14—9፥50</ref>)</char></para>
  <para style="io1">ገሊላች ዬሩሳሌመ <char style="ior">(<ref loc="LUK 9:51-19:27">9፥51—19፥27</ref>)</char></para>
  <para style="io1">መጨረሽ ሳምንተ ዬሩሳሌማንለከ ኦሎንከሴ <char style="ior">(<ref loc="LUK 19:28-23:56">19፥28—23፥56</ref>)</char></para>
  <para style="io1">ቀርቹ ሬሆች ኬኡስ፥ ለሉስለከ ሰማሃ ኦሮኡስ <char style="ior">(<ref loc="LUK 24:1-53">24፥1-53</ref>)</char></para>
  <chapter number="1" style="c" sid="LUK 1"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1"/>ከበጀንቶንት ቴዎፍሎሴ! ኒ በላን እኮ ጠውተኔሃ ልግቡ መኑ ማቁስ ከኒች ዎዕናሃ ከተቦኡ። <verse eid="LUK 1:1"/><verse number="2" style="v" sid="LUK 1:2"/>ህከ ሶህኑተ ኔሳሃ ህግሶእሩ ወዕኔችን ኬስ እሌንከሰ ለኦእረለከ ላገስ ካዲመተ እኮእሃ መነ። <verse eid="LUK 1:2"/><verse number="3" style="v" sid="LUK 1:3"/>ህትን አን ወዕኔችን ኬሽ ጉዕመ ጠወንከ ጠረኝሽ አጥራመቾሚች ኤተሮን ጠወስ ቅልቢን ከተቡ ጡመ አጉጅ ለሌኤ። <verse eid="LUK 1:3"/><verse number="4" style="v" sid="LUK 1:4"/>ካን አኡኤ ተማርቶንት ትምህርቱ ሀንቅ እሁስ ጡመገ ደጎተ ይዪት።<verse eid="LUK 1:4"/></para>
  <para style="s1">ጠመቃንቹ ያህይ እለመኖገ መላይኬቹ ጠወኡስ</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5"/>ይሁድ ባድ ዎመ ሄሮድሴ ዘማኔን «አብየ» ዬኖ ቂሶመ ክድመ አዲሁ «ዘከርየ» ዬኖ መቱ ቂስቹ ሄዕዮ እቅ፤ እስን ሀሩን ዘሬች እኮኢት «ኤልሳቤጤ» ዬኖ መንቹት ሄኦስ እቅ።<note caller="-" style="x"><char style="xo" closed="false">1፥5 </char><char style="xt" closed="false"><ref loc="1CH 24:10">1 ዱዱ. 24፥10</ref>።</char></note> <verse eid="LUK 1:5"/><verse number="6" style="v" sid="LUK 1:6"/>ህትን ለሙንኩ ቀርች ትዛዝለከ ሴረ ጉዕመንከ ሂሉርቹ ዮበኢሃ አገርተን መገን ብሬን ፈየ መነ እቅ። <verse eid="LUK 1:6"/><verse number="7" style="v" sid="LUK 1:7"/>ኤልሳቤጥን እልትባተ እኮቤቺሃ እለት ዮሰበእረ፤ ህትን ለሙንኩ ባልቆእረ እቅ።<verse eid="LUK 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8"/>ህከ ወክት ዘከርየ አዲሃ ሆጎ ተሩ ኢልሃን መገን ብሬን ቂሶመ ሆጉተ አአንን <verse eid="LUK 1:8"/><verse number="9" style="v" sid="LUK 1:9"/>ቂሰ ሴር ሃሊን ዱእ ምኒ ኣግ ህጣነ አጪሶተ እጡ ኢሌስ። <verse eid="LUK 1:9"/><verse number="10" style="v" sid="LUK 1:10"/>ህከ ህጣነ አጪሴኖ ወክት ኡመቱ ጉዕሙንኩ አብሌን ኡር ዱአ አታኢት እቅ። <verse eid="LUK 1:10"/><verse number="11" style="v" sid="LUK 1:11"/>ቀርች መላይኬቹ ህጣነ አጪሴኖ ጠረጴዝ መኬ አዲን ኡርኬዕይ ዘከርይሃ ለሌእ። <verse eid="LUK 1:11"/><verse number="12" style="v" sid="LUK 1:12"/>ዘከርይን መላይኬቹ ለዕዮ ወክት ህልቆ፤ አበ ዋጄእ። <verse eid="LUK 1:12"/><verse number="13" style="v" sid="LUK 1:13"/>ጠው እኮጎሬ መላይኬቹ «ዘከርየ! ዱኡክ ሞጮጨሞቤቺሃ ዋጅቶት፤ መንቹክ ለባ ጩል እልታሄ፤ ሱዕመስ ‹ያህይ› ይት ገእታንት። <verse eid="LUK 1:13"/><verse number="14" style="v" sid="LUK 1:14"/>ኬሳሃ አቡ ሙንዲኑት እካሄ፤ ጩሉ እለሞቤቺሃ ልግቡ መኑ ሙንደአኖ። <verse eid="LUK 1:14"/><verse number="15" style="v" sid="LUK 1:15"/>መሰንትስ እስ መገን ብሬን ሎረ እሀኖ፤ ህትን ወይኒን ቦበጤማሀለከ ዎሉ ሰከርሰኖ አጌኖርቹ ሆሮን አገኖበአ፤ ህትን አመስ ጎደባን ሄዕዮ ሰኣቲች ኬሽ ጠሊለ አያኒን ዊሞሃ እሀኖ።<note caller="-" style="x"><char style="xo" closed="false">1፥15 </char><char style="xt" closed="false"><ref loc="NUM 6:3">ዘኁ. 6፥3</ref>።</char></note> <verse eid="LUK 1:15"/><verse number="16" style="v" sid="LUK 1:16"/>እስን እስራኤል ኡመቲች ልግብሰ ቀርቾሃ መገን አደ ፈንቀሸኖ። <verse eid="LUK 1:16"/><verse number="17" style="v" sid="LUK 1:17"/>ህትን ቅጥይቶ መነ ቀርቺሃ ቅጥ አኦታ፥ አናኑተለከ እለተ ሀራርስ ሜጡበ አኦተለከ አዘዘንታበእ መን ቀልብ ጠሊላኖ ደጉ ፈንቀሾታ፥ እልያሴ አያኒንለከ ወልቃን ቀርች ብሬን ሃመኖ» ዬስ።<note caller="-" style="x"><char style="xo" closed="false">1፥17 </char><char style="xt" closed="false"><ref loc="MAL 4:5-6">ሚል. 4፥5-6</ref>።</char></note><verse eid="LUK 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18"/>ዘከርየን ህከ መላይኬቹ «አን ባልቆም፤ ጫንትኤ ባልቆኡ፤ ኩ ጠው ሀንቅ እሁስ ማን ደጎተ አታላም?» ዬእ።<verse eid="LUK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19"/>መላይኬቹንኩ ፈንቀሽ «አን መገን ብሬን ኡራም ጅብርላት፤ ከ ተሽት ኩሎሄተ ሶቀም አሜቾም እቅ።<note caller="-" style="x"><char style="xo" closed="false">1፥19 </char><char style="xt" closed="false"><ref loc="DAN 8:16">ዳን. 8፥16</ref>፤ <ref loc="DAN 9:21">9፥21</ref>።</char></note> <verse eid="LUK 1:19"/><verse number="20" style="v" sid="LUK 1:20"/>እኮጎሬ ወክቴንከስ እካ ላገኤ አመዕንትበቤቺሃ ኩ ጠው እሆተ ኢለ ዱደ እካንት፤ ጠወኡንከ አታልታንትበአ» ዬስ።<verse eid="LUK 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21"/>ህከ ወክት መኑ ዘከርየ አገረኖት እቅ፤ እስን ዱእ ምኒ ኣዜን ዱንኬቤቺሃ አጀብሲጭቶኡ። <verse eid="LUK 1:21"/><verse number="22" style="v" sid="LUK 1:22"/>ዘከርየን ዱእ ምኒች ፉሎ ወክት መኒን ጠወኦተ አታሎበአ፤ ህካን እኮቤቺሃ ዱእ ምኔን መቱርቹ ለሌስገ ደጎኡ፤ መሰንትስ አንጋን ቀቀሰን ኩለኖሳት እቅ፤ እስን ዱደ እኮ።<verse eid="LUK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23"/>ክድመ ወክቱንኩ ጎፋን ምንስ ኦሮዕዮ። <verse eid="LUK 1:23"/><verse number="24" style="v" sid="LUK 1:24"/>ቀወ ወክቲች ኤተሮን ጫስ ኤልሳቤጥ ላፈተ እኮኡ፤ <verse eid="LUK 1:24"/><verse number="25" style="v" sid="LUK 1:25"/>«ቀርቹ ከ ጡመርቹ አዕዮኤ፤ መን በላን ዮኤ ህንቀሙ ከሞኤ» ይት ኦንቱ አገነ መኒች ማጠንቶኡ።<verse eid="LUK 1:25"/></para>
  <para style="s1">ኢስ እለመኖገ መላይኬቹ ጠወኡስ</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26"/>ኤልሳቤጥ ላፈተ እኮ ሌህቅ አገናን መላይኬቹ ገሊለ ባዶን ሄዕዮ «ናዝሬተ» ዬኖ ከተማን ሄኣ መቴ ሀፍቶበ መገን አዲን ሶሀሞ። <verse eid="LUK 1:26"/><verse number="27" style="v" sid="LUK 1:27"/>እሴን ዳዉዴ ዘሬች እኮ «ዩሱፈ» ዬኖ መንቺሃ ኣሰንቶእተ እቅ፤ ሀፍቶስ ሱዕሙ «መርየመ» ዬኖተ እቅ።<note caller="-" style="x"><char style="xo" closed="false">1፥27 </char><char style="xt" closed="false"><ref loc="MAT 1:18">ማቶ. 1፥18</ref>።</char></note> <verse eid="LUK 1:27"/><verse number="28" style="v" sid="LUK 1:28"/>ሁኩ መላይኬቹንኩ እሴቤቹ አሜች «መገን ኣስቱት ዊሞሄት፤ ወገሬቱ ኬሳሃ እሁን፤ መገኑ ኪን ዮኡ፤ አት ሜንቲች ጉዕሚችን ማሰአንቶንትተ» ዬሴ።<verse eid="LUK 1:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29"/>ጠዉ እኮጎሬ እሴን ህከ መላይኬቹ ለኦ ወክት ጠዊንከስ አበ ህልቅ «ኩን ሀትናሙሃ ወገሬት?» ይት ሰውይቶኡ። <verse eid="LUK 1:29"/><verse number="30" style="v" sid="LUK 1:30"/>ሁኩ መላይኬቹንኩ እሴንተ «ቴ መርየማ! መገን አያኑ ዮሄቤቺሃ ዋጅቶት። <verse eid="LUK 1:30"/><verse number="31" style="v" sid="LUK 1:31"/>ሁኩዕኑ! አት ላፈተ እካንት፤ ለባ ጩልንከ እልታንት፤ ሱዕመስ ‹ኢሰ› ይት ገእታንት።<note caller="-" style="x"><char style="xo" closed="false">1፥31 </char><char style="xt" closed="false"><ref loc="MAT 1:21">ማቶ. 1፥21</ref>።</char></note> <verse eid="LUK 1:31"/><verse number="32" style="v" sid="LUK 1:32"/>እስን ሎረ እሀኖ፤ ጉዕሚችን ሎረ መገን ቤቱ የመመኖ፤ ህትን ቀርቹ መገኑ አንስ ደዉዴ ሎረ ኬዕምኝ ቦርጭመተ ኣሰኖስ። <verse eid="LUK 1:32"/><verse number="33" style="v" sid="LUK 1:33"/>ያቁብ እለ አሌን ዘላለሚሃ ዎመ እሀኖ፤ ወሞማተስ ዳንጉ ዮስበአ» ዬሴ።<note caller="-" style="x"><char style="xo" closed="false">1፥33 </char><char style="xt" closed="false"><ref loc="2SA 7:12-13">2 ሳሙ. 7፥12-13</ref>፤ <ref loc="2SA 16">16</ref>፤ <ref loc="ISA 9:7">ኢሳ. 9፥7</ref>።</char></note><verse eid="LUK 1:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34"/>መርየመ ህከ መላይኬቹ «አን ሀፍቱተ እኮምቤቺሃ ኩ ጠዉ ሀት እሆተ አታለኖ?» ይቶስ።<verse eid="LUK 1:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35"/>መላይኬቹንኩ ፈንቀሽ «መገን ጠሊሉ አያኑ ኪ አሌን አሜተኖ፤ ጉዕሚችን ሎረ መገን ወልቀት ኪ አሌን እካአ፤ ህካን እኮቤቺሃ ኪች እለመኖ ጠሊለ ጩል ‹መገን ቤቱ› ዬን ገኤኖስ። <verse eid="LUK 1:35"/><verse number="36" style="v" sid="LUK 1:36"/>ህንዴ ለእ! እልቹክ ኤልሳቤጥ ባልቅማንተሴ ለባ ጩል ላፈታን፤ እሴን ‹እልትበታን› ዬነንሴ ሄእ እሴ ላፈተ እኮኢች ኩን ሌህቅያ አገነ። <verse eid="LUK 1:36"/><verse number="37" style="v" sid="LUK 1:37"/>መሰንትስ መገኑ ቄለኖስ መቱርቹሁ ዮበአ» ዬሴ።<note caller="-" style="x"><char style="xo" closed="false">1፥37 </char><char style="xt" closed="false"><ref loc="GEN 18:14">ክል. 18፥14</ref>።</char></note><verse eid="LUK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38"/>መርየማን «ሁኩዕኑን አን መገንተ ሮስቹ፤ ኤሳንከ አት ይቶንትገ እሁዕኔ» ይቶኡ፤ መላይኬቹንኩ እሴች አደ እክ ኦሮዕዮ።<verse eid="LUK 1:38"/></para>
  <para style="s1">መርየመ ኤልሳቤጤ ለኦተ መሩሴ</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39"/>ህከ ወክትንከ መርየመ ቆተ ባዶን ሄዕዮ ይሁድ ከተመ ደዕልት መርቶኡ። <verse eid="LUK 1:39"/><verse number="40" style="v" sid="LUK 1:40"/>እሴን ዘከርየ ምኒ ኣግ ኤልሳቤጤ ወገሬትሶኡ። <verse eid="LUK 1:40"/><verse number="41" style="v" sid="LUK 1:41"/>ኤልሳቤጥን መርየመ ወገሬትሶ ላገተ ሞጮጭቶ ወክት ጎደባንከሴ ዮ ጩሉ አለጴእ፤ ኤልሳቤጥን ጠሊለ መገን አያኒን ዊንት <verse eid="LUK 1:41"/><verse number="42" style="v" sid="LUK 1:42"/>ላገሴ ጎት አት «አት ሜንቲች ጉዕሚችን ማሰአንቶንትታን፤ ኪች እለመኖሁ ማሰአሞእሃን። <verse eid="LUK 1:42"/><verse number="43" style="v" sid="LUK 1:43"/>ህትን ቀርችኤ አመት ኢቤቹ አሜቱ ሀትናሙሃ ሎረ ኬዕምኝ? <verse eid="LUK 1:43"/><verse number="44" style="v" sid="LUK 1:44"/>መሰንትስ ከለእ! ወገሬትክ ላገተ ሞጮጬም ወክት ጎደባንከኤ ዮ ጩሉ ተሽቲን አለጴእ። <verse eid="LUK 1:44"/><verse number="45" style="v" sid="LUK 1:45"/>ህትን ቀርቹ ኩሎሴ ጠዉ ዊመኖሃ እሁስ አመዕንቶኢት እሴ ማሰአንቶእተ» ይቶኡ።<verse eid="LUK 1:45"/></para>
  <para style="s1">መርየመ መገኑ ገለትጩሴ</para>
  <para style="q1">
    <verse number="46" style="v" sid="LUK 1:46"/>መርየመ</para>
  <para style="q1" vid="LUK 1:46">«ፎልቹኤ መገኑ ገለትጭታአ፤<note caller="-" style="x"><char style="xo" closed="false">1፥46 </char><char style="xt" closed="false"><ref loc="1SA 2:1-10">1 ሳሙ. 2፥1-10</ref>።</char></note><verse eid="LUK 1:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="LUK 1:47"/>ህትን ቀልቡኤ ፌሳንቾ መገኖን ሙንደአኖ።<verse eid="LUK 1:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="LUK 1:48"/>መሰንትስ መገኑ ሮስቾስ ህንቀሙ ለዕዮኡ፤</para>
  <para style="q2" vid="LUK 1:48">ህትን ከበሬች ኬሽ መኑ ጉዕሙንኩ ‹ማሰአንቶእተ› የኖኤ።<note caller="-" style="x"><char style="xo" closed="false">1፥48 </char><char style="xt" closed="false"><ref loc="1SA 1:11">1 ሳሙ. 1፥11</ref>።</char></note><verse eid="LUK 1:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="LUK 1:49"/>ህትን ወልቃሙ መገኑ ኤሳሃ አበ ጠወ አዕዮኤ።</para>
  <para style="q2" vid="LUK 1:49">ሱዕሙስን ጠሊለሃን።<verse eid="LUK 1:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50"/>ህትን እሱ ዋጅታ መኒሃ ጉዕሚንከ መገኑ</para>
  <para style="q2" vid="LUK 1:50">እላች እለ እለተ ኢለሬተ ማረኖሰ።<verse eid="LUK 1:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51"/>አንጋንተስን ጠረኘ ሆጉተ አዕዮኡ፤</para>
  <para style="q2" vid="LUK 1:51">ቦንታ መነንከ ቀልብሰ ሰውቲንን ብን አዕዮ።<verse eid="LUK 1:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52"/>ህትን ሎራኑተ ሹምነቱ ዮሰረ ኬዕምኝ ቦርጭማችሰ ድርሾኡ፤</para>
  <para style="q2" vid="LUK 1:52">ጠው እኮጎሬ ገዉሰ ሆፍሳእረ ኬዕምሾሰ።<note caller="-" style="x"><char style="xo" closed="false">1፥52 </char><char style="xt" closed="false"><ref loc="JOB 5:11">አዩ. 5፥11</ref>።</char></note><verse eid="LUK 1:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53"/>ህትን ጎሩ አፎሰራ ጡመ ጠዊን ዱሴሰ፤</para>
  <para style="q2" vid="LUK 1:53">እኮጎሬ ቀባጣመተ ኦነ አንገንተ መርታገ አዕዮሰ።<verse eid="LUK 1:53"/></para>
  <para style="q1">
    <verse number="54-55" style="v" sid="LUK 1:54-55"/>ህትን መገኑ አናኖተኔ ጠወዕዮገን</para>
  <para style="q1" vid="LUK 1:54-55">እብራሂሚሃለከ ዘሬተስ</para>
  <para style="q1" vid="LUK 1:54-55">ዘላለሚሃ አጉሩስ ሰውይ</para>
  <para style="q1" vid="LUK 1:54-55">ሮስቹስ እስራኤለ ሀዕልዮኡ» ይቶኡ።<note caller="-" style="x"><char style="xo" closed="false">1፥54-55 </char><char style="xt" closed="false"><ref loc="GEN 17:7">ክል. 17፥7</ref>።</char></note><verse eid="LUK 1:54-55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56"/>መርየመን ኤልሰቤጤን ሜጡበ ሰሶ አገን ጌሰ አፉዕልቶች ኤተሮን ምንሴ ፈንቀልት መርቶኡ።<verse eid="LUK 1:56"/></para>
  <para style="s1">ጠመቃንቹ ያህይ እለሙስ</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57"/>ኤልሳቤጥ እልታ ወክቱ ኢልየን ለቤ ጩልንከ እልቶኡ። <verse eid="LUK 1:57"/><verse number="58" style="v" sid="LUK 1:58"/>ህከኒሃ ኦሎሴለከ እሉሴ ጉዕሙንኩ መገኑ አበ አሙዦሴገ ሞጮጭት እሴንን ሜጡበ ሙንደኦኡ።<verse eid="LUK 1:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 1:59"/>እሰን ህዘትቅ በሬን ጩል ጡርከንቶተ አሜት አንስ ሱዕሚን «ዘከርየ» ይት ገእቶተ ሀሶኡ።<note caller="-" style="x"><char style="xo" closed="false">1፥59 </char><char style="xt" closed="false"><ref loc="LEV 12:3">ሌዌ 12፥3</ref>።</char></note> <verse eid="LUK 1:59"/><verse number="60" style="v" sid="LUK 1:60"/>ጠው እኮጎሬ አመስ «ህትጎተበአ፤ ‹ያህይ› የመም ገአመኖ» ይቶኡ።<verse eid="LUK 1:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 1:61"/>ህካን እኮቤቺሃ እሰን «ኪ ዘሬች ከን ሱዕሚን ገአሞኢሁ ዮበእንዶ?» ይቶሴ። <verse eid="LUK 1:61"/><verse number="62" style="v" sid="LUK 1:62"/>ህከኒች ኤተሮን እሰን ጩሉስ አዬ የመም ገአሞተ ሀሰኖ ጎሬ ደጎተ አነስ መላን ጠዕምቶኡ።<verse eid="LUK 1:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 1:63"/>ዘከርየን ከተቤኖሃ አሶኖስተ ጠዕም «ሱዕሙስ ያህይት» ይ ከተቦ፤ ህከን ጠዋንን ጉዕሙንኩሰ አጀብሲጭቶኡ። <verse eid="LUK 1:63"/><verse number="64" style="v" sid="LUK 1:64"/>ህከ ወክት ዘከርየ አፎስ ፈንተዕያንለከ አረብስ ሂርተኣን መገኑ ገለትጨን ጠወኡ ጀመሮ። <verse eid="LUK 1:64"/><verse number="65" style="v" sid="LUK 1:65"/>ህካን እኮቤቺሃ ቀዕየ መኑ ጉዕሙንኩ ዋጄእ፤ ህትን ሁኩ ጠው ጉዕሙንኩ ቆተ ይሁድ ባዶን ጉዕማንን ጠወአሞ። <verse eid="LUK 1:65"/><verse number="66" style="v" sid="LUK 1:66"/>ህከ ጠወ ሞጮጬ መኑ ጉዕሙንኩ «ኩ ጩሉ ሀትናሙ እሆታት?» የን ጠወስ ቀልቤንከስ አፎ፤ መሰንትስ መገን ዎልቀት እሲን ሜጡበ ሄኦቤቺሃት እቅ።<verse eid="LUK 1:66"/></para>
  <para style="s1">ዘከርይ ጠወዕዮ ራገ</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67"/>ጩል አኑ ዘከርይ ጠሊለ አያኒን ዊም<verse eid="LUK 1:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68"/>«ኡመትስ ለዕዮቤቺሃለከ ፌሾቤቺሃ</para>
  <para style="q2" vid="LUK 1:68">እስራኤል ቀርቹ መገኑ ማሰአሞሃ እሁን!<verse eid="LUK 1:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69"/>ካዲንቾ ደዉዴ ዘሬ ምኒች ጠረኘ ጡምሳንቹ ኬሾኔ፤<verse eid="LUK 1:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70"/>ዎዕኔ ዘማኒች ኬሽ ሄኦ ጠሊላኖ ነብያኖ አፎን ጠወዕዮገን፤<verse eid="LUK 1:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71"/>ዲኒችለከ ግበኖኔ መን አንጋች ፌሾኔ።<verse eid="LUK 1:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72"/>ህካን አዕዮንኩ አናካተኔ አጉሮተለከ</para>
  <para style="q2" vid="LUK 1:72">ጠወዕዮ ወኣድ ላገተ ዊንሾተ ሰው ይዪት።<verse eid="LUK 1:72"/></para>
  <para style="q1">
    <verse number="73" style="v" sid="LUK 1:73"/>ከ ወኣድ ላገንተ ጤሌዕል ኣሴኢሁ አኒሀኔ እብራሂሚሃ<verse eid="LUK 1:73"/></para>
  <para style="q1">
    <verse number="74" style="v" sid="LUK 1:74"/>ዲን አንጋች ነጠ ፉልን</para>
  <para style="q2" vid="LUK 1:74">ዋጅኑዕናን ካደሞሲታት፤<verse eid="LUK 1:74"/></para>
  <para style="q1">
    <verse number="75" style="v" sid="LUK 1:75"/>ህትን ሄዕናም ዘማኔን ጉዕማንን</para>
  <para style="q2" vid="LUK 1:75">መገን ብሬን ጠሊልማንለከ ፈይማን ሄዕኖታት።<verse eid="LUK 1:75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76"/>ህትን ኮ ጩሌ! ጠሊለ ሎረ መገን ነብዬቹ ዬኖሄ።</para>
  <para style="q2" vid="LUK 1:76">ወቃንከ ብዝ አቶተ ሄጭት ቀርች ብሬን መርታንት።<note caller="-" style="x"><char style="xo" closed="false">1፥76 </char><char style="xt" closed="false"><ref loc="MAL 3:1">ሚል. 3፥1</ref>።</char></note> <verse eid="LUK 1:76"/><verse number="77" style="v" sid="LUK 1:77"/>ቀርቹ ጩብሰ አጉሮ ይ</para>
  <para style="q2" vid="LUK 1:77">ጡም ኤንኬዕኑ ኣሰኖሰ።<verse eid="LUK 1:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78"/>መገኑኔ መረርሲጫንቹለከ ጎደበ ላፈ እኮቤቺሃ ፈቅ ኑሩ ሰሜች ለሎተ አአኖ።<verse eid="LUK 1:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79"/>እስን ቱንስቾንለከ ሬሆ ሀላን አፉዕልቶ መኒሃ ጉዕሚንከ ለሊሰኖ፤</para>
  <para style="q2" vid="LUK 1:79">ሎከኔ ወጌሬት ወቃሃ አዎንሰኖ» ይ ራገ ጠወዕዮ። <verse eid="LUK 1:79"/><verse number="80" style="v" sid="LUK 1:80"/>ሁኩ ጩሉንኩ ገዉሲ ነጵ አያኒን ጠረኘ እኮ፤ እስራኤል መኒሃ ለለኖ በሩ ኢሎተ ኢለ ኡለ ኡድማን ሄዕዮ።<verse eid="LUK 1:80"/></para>
  <chapter eid="LUK 1"/>
  <chapter number="2" style="c" sid="LUK 2"/>
  <para style="s1">ኢስ እለሞገ</para>
  <para style="r">(<ref loc="MAT 1:18-25">ማቶ. 1፥18-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1"/>ህከ ወክት ሮም ገሽቶ ኣዜን ዮ መነ ጉዕመንከ ወለኢሃ ሮም ዎሚች አውግስጦሴች ትዛዙ ፉሎ። <verse eid="LUK 2:1"/><verse number="2" style="v" sid="LUK 2:2"/>ህከ ወዕኔ ዎሊንሽ ወክት «ቄሬኔዎስ» ዬኖ መንቹ ሶሪይ ባዱ ገሸኖ እቅ። <verse eid="LUK 2:2"/><verse number="3" style="v" sid="LUK 2:3"/>ህካን እኮቤቺሃ መኑ ጉዕሙንኩ ሱዕመስ ከተብሲሶተ ገገዉንኩስ ገገይስ ከተመ መረኖት እቅ።<verse eid="LUK 2:3"/></para>
  <para style="p">
    <verse number="4-5" style="v" sid="LUK 2:4-5"/>ዩሱፍን እለንሹስ ደዉዴ ምኒ ዘርተ እኮቤቺሃ እሲሃ ኣሴናንስ ላፈተ እኮ መርየማን ሜጡበ ገሊላን ሄዕዮ ናዝሬት ከተሚች ኬዕይ ይሁድ ባዶን ሄዕዮ «ቤተሌመ» ዬኖ ደዉዴ ከተመ ኦሮዕዮ። <verse eid="LUK 2:4-5"/><verse number="6" style="v" sid="LUK 2:6"/>ለሙንኩሰ ህከኔ ሄኦገን መርየመ እልታ ወክቱ ኢሌእ። <verse eid="LUK 2:6"/><verse number="7" style="v" sid="LUK 2:7"/>ህከንቤቾንን ሀንገፈ ጩል እልቶኡ፤ ኮሁ ገለኖ ምኔን ቤቹ ዮሰበእቤቺሃ ኦድኖን ጣጥ ጋድር ብሬን ለሉ ህጥተ እተኖ ገበት ኣዜን ኦሲሶስ።<verse eid="LUK 2:7"/></para>
  <para style="s1">ዜማኑተለከ መላይከተ</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8"/>ህከን ቀኤን ባዳን ሆለ ዜሞሃ አገርተን አብሌ ገልታ ዜማኑት ሄኦ እቅ፤ <verse eid="LUK 2:8"/><verse number="9" style="v" sid="LUK 2:9"/>እሳንከ ቀርች መላይኬቹ ለሌሰ፤ ህትን ቀርች ኬዕምኝ ኑሩ አዳንከሰ በለቆ፤ እሰን አበ ዋጅቶኡ። <verse eid="LUK 2:9"/><verse number="10" style="v" sid="LUK 2:10"/>ጠዉ እኮጎሬ መላይኬቹንኩ እሰንተ «መኒሃ ጉዕሚንከ አበ ሙንዲኑተ አፍ ክዕኔበ አሜቾምቤቺሃ ዋጅቶኖቼ። <verse eid="LUK 2:10"/><verse number="11" style="v" sid="LUK 2:11"/>ከበር ደዉዴ ከተማን ጡምሳንቹ ቀርቹ መሲሁ እለሞህዕኔ። <verse eid="LUK 2:11"/><verse number="12" style="v" sid="LUK 2:12"/>ሰብዬቹ ሆጮን ጣጤን ለሉ ህጥተ እተኖ ገበታን ኦስሴናን ደጌነንተ፤ ሁኩን መላተ እሀኖህዕኔ» ዬሰ።<verse eid="LUK 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13"/>ድንገቴን ልግቡ ሰሜ መላይከ ጎጎቱ ህከን መላይኬቺን ሜጡበ ለልቶኡ፤ እሰን መገኑ ገለትጭተን<verse eid="LUK 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14"/>«ሎርመት አሌ ሰማን መገኒሃ እሁን፤</para>
  <para style="q2" vid="LUK 2:14">መገኑ መረርሲጨኖስ መኒሃ ኡለ አሌን ወገሬቱ እሁን» ይታኢት እቅ።<verse eid="LUK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15"/>ሁኩ መላይከንት እሳች አደ እክ ሰማ መርቶ ወክት ዜማኑት ገገዉንኩሰን «ቴሁ ኬዕዬ! ቤተልሄመ ኢለ መርን ቀርቹ ኩሎኔ ከ እኮ ጠወሃ ለዕኖ» የቀንቶኡ።<verse eid="LUK 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16"/>እሰን ደዕልት መርት መርየመለከ ዩሱፈ ህትን ለሉ ህጥተ እተኖ ገበታን ኦሰዕዮ ጩል ደጎኡ። <verse eid="LUK 2:16"/><verse number="17" style="v" sid="LUK 2:17"/>ህትን ሰብዬቹ ጩል ለኦ ወክት ህከን ሰብዬችተኔሃ ኩለሞሰርቹ ጠወኦኡ። <verse eid="LUK 2:17"/><verse number="18" style="v" sid="LUK 2:18"/>ህካን ሞጮጭቶእሩ ዜማኑት ኩልቶሰ ጠዋን አጀብሲጭቶኡ። <verse eid="LUK 2:18"/><verse number="19" style="v" sid="LUK 2:19"/>ጠው እኮጎሬ መርየመ ህከ ጠወ ጉዕመንከ ቀልቤንከሴ አፍ ሰውይታኢት እቅ። <verse eid="LUK 2:19"/><verse number="20" style="v" sid="LUK 2:20"/>ዜማኑት ኩለሞሰገን ሞጮጭቶሀኒሃለከ ለኦሀኒሃ ጉዕሚንከ መገኑ ሎርስተንለከ ሹክር ኣተን ፈንቀልት መርቶኡ።<verse eid="LUK 2:20"/></para>
  <para style="s1">ጩል ኢሰ ዱእ ምኒ መሴመገ</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21"/>ህዜትቅ በር ጩልስ ጡርከሜኖ ወክት ሱዕመስ «ኢሰ» ዬን ገኤመ፤ ሁኩንን አመስ ጎደባን አፉዕሉዕናን ሄጭ መላይኬቹ ፉሽዮስየ ሱዕመ እቅ።<note caller="-" style="x"><char style="xo" closed="false">2፥21 </char><char style="xt" closed="false"><ref loc="LEV 12:3">ሌዌ 12፥3</ref>፤ <ref loc="LUK 1:13">ሉቃ. 1፥13</ref>።</char></note><verse eid="LUK 2:21"/></para>
  <para style="p">
    <verse number="22-23" style="v" sid="LUK 2:22-23"/>ሙስ ሕጋን የመሞገን እሰን ነጠ እካ ወክቱ ሆንጠካን መገን ሴራን «ዎዕነ እለመኖ ለቤ ቤቱ ጉዕመንከ መገኒሃ ኣሴናን አደ እሁን» የመም ከተበሞገን ጩልስ ቀርች ብርተ ሆንጠህሲሃ ዬሩሳሌመ መስቶኡ። <verse eid="LUK 2:22-23"/><verse number="24" style="v" sid="LUK 2:24"/>ህትን መርቶኢሁ ቀርች ሕጋን «ለሙ ሀንደዕርተ ህከረንገ ለሙ ዱብሀንደዕሬ ጭጮራ ሆንጠህሱን» የመሞገን ክትመ ሆንጠህሲሃት እቅ።<verse eid="LUK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25"/>ህከ ወክት ዬሩሳሌም ከተማን «ስሞኔ» ዬኖ ገዉስ መገኒሃ ኣሴ ፈዩ መንቹ ሄዕዮ እቅ፤ እስን እስራኤል ጡም ተቢሳሃ አገረኖት እቅ፤ ጠሊሉ አያኑ እስ አሌን ሄዕዮ እቅ፤ <verse eid="LUK 2:25"/><verse number="26" style="v" sid="LUK 2:26"/>እስን መገኑ እቴስ ቀርቹ መሲህ ለኡዕናን ሄጭ ሬህበገ መገን አያኑ ለሊሾስ እቅ። <verse eid="LUK 2:26"/><verse number="27" style="v" sid="LUK 2:27"/>ስሞን ጠሊሉ አያኑ ቃግሻንስ ዱእ ምኒ ኦሮዕዮ፤ ዩሱፍለከ መርየመ ሴራን ሮሰሞገን አቶተ ጩል ኢሰ ዱእ ምኒ አፍ ኣጎኡ። <verse eid="LUK 2:27"/><verse number="28" style="v" sid="LUK 2:28"/>ህከ ወክት ስሞን ጩል ቶግ ሀንቀፍ መገኑ ገለትጨን<verse eid="LUK 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29"/>«ቀርቾ!</para>
  <para style="q2" vid="LUK 2:29">ቴሱ ካድንቹክ ጠወኦንት ላገክገን ወገሬቲን ህርስሴኤ፤<verse eid="LUK 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30"/>ጡምሱክ እሌንከእ ለዕዮም፤<verse eid="LUK 2:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="LUK 2:31"/>እስን መገኑ አመዕንበ መን ጉዕም ብሬን ቅጥአቶንቲሃን፤<verse eid="LUK 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32"/>እስን መገኑ አመዕንዮበእ መኒሃ ፈኝ ለሊሰኖ ኑር እሀኖ፤</para>
  <para style="q2" vid="LUK 2:32">ህትን እስራኤል ኡመቲሃ ኬዕምኝያ» ዬእ።<verse eid="LUK 2:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33"/>አመስለከ አኑስ ጩልተኔሃ ዬን ጠወኤመ ጠዋን አጀብሲጭቶ እቅ። <verse eid="LUK 2:33"/><verse number="34-35" style="v" sid="LUK 2:34-35"/>ስሞንን እሰንተ ማሰዕዮሰ፤ ህትን ጩልስ አመት መርየመ «ኩ ጩሉ አበ መን ቀልብ ሰውቱ ደገሞተ እስራኤል ኣዜን ሄዕዮ ልግብያ መኒሃ ኡቢሃለከ ኬኢሃ መገኑ ኤቦስ፤ ህከ መላተ ልግቡ መኑ ግቦስ፤ ኪ ቀልብ ሻዙት ሲፍገ ሙርታአ» ዬሴ።<verse eid="LUK 2:34-35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36"/>ህትን አሴር ደቦች ፋኑኤሌ ቤቱት «ሃነ» ዬኖ ራጋንቹት ሄኦ እቅ፤ እሴን ገልቶች ኤተሮን ጨይንከሴ ሜጡበ ለመለ ዘማን ሄኦእተ እቅ፤ ህትን አበ ባልቆ እቅ። <verse eid="LUK 2:36"/><verse number="37" style="v" sid="LUK 2:37"/>እሴን ምንሴ አኑ ዮበኢሃ ህዜታይኔ ሾሉ ዘማን ሄኦ እቅ፤ እሴን ሀንከዕርተለከ በራሃ ዱእ ምኒች ሆሮ አደ እኩዕናን ሶመንተንለከ ዱአ አተን መገኑ ካደንታ እቅ። <verse eid="LUK 2:37"/><verse number="38" style="v" sid="LUK 2:38"/>ህከ ወክትንከ እሴ አሜት መገኑ ገለትጭተን ዬሩሳሌም ጡሙ ተቢሴን አገርታ መኒሃ ጉዕሚንከ እስተኔሃ ኩልቶኡ።<verse eid="LUK 2:38"/></para>
  <para style="s1">ናዝሬተ ፈንቀሉሰ</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39"/>ዩሱፍለከ መርየመ ጉዕመርቹንከ ቀርች ሕጋን የመሞገን አቶች ኤተሮን ገሊላን ሄዕዮ ከተመ ናዝሬተ ፈንቀልት መርቶኡ።<note caller="-" style="x"><char style="xo" closed="false">2፥39 </char><char style="xt" closed="false"><ref loc="MAT 2:23">ማቶ. 2፥23</ref>።</char></note> <verse eid="LUK 2:39"/><verse number="40" style="v" sid="LUK 2:40"/>ጩሉንኩ ነጵ ጠራኜእ፤ ህትን ሀይቹ እኮ፤ ህትን መገን ኣስቱት እሲን ሜጡበ ሄኦ እቅ።<verse eid="LUK 2:40"/></para>
  <para style="s1">ጩሉ ኢስ መገን ምኔን እሁስ</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41"/>አኑስለከ አመስ ዘማን ዘማኔን ሻሽግ ከበጃት ከበጅቶተ ዬሩሳሌም ከተመ መርታ እቅ።<note caller="-" style="x"><char style="xo" closed="false">2፥41 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">ፉል. 12፥1-27</ref>፤ <ref loc="DEU 16:1-8">ዘዳ. 16፥1-8</ref>።</char></note> <verse eid="LUK 2:41"/><verse number="42" style="v" sid="LUK 2:42"/>ኢሲንከ ቶነ ለሙ ዘማን እኮስ ወክት ዎዕነ ሮሰሞገን ከበጃት ከበጂሃ ዬሩሴሌመ መርቶኡ። <verse eid="LUK 2:42"/><verse number="43" style="v" sid="LUK 2:43"/>በሩስ ጎፎች ኤተሮን እሰን ምኒ ፈንቀልታን ጩሉ ኢስ ዬሩሳሌማን ፈቆ እቅ፤ ህካን አኑስለከ አመስ ደጎበአ። <verse eid="LUK 2:43"/><verse number="44" style="v" sid="LUK 2:44"/>ሀራቲን ሜጡበ አሜተኖሃ አጉጃንሰ መቶ በሬ ዎቃ ሃንተን ሆሶኡ፤ ህከኒች ኤተሮን እሉሰ ዮቤቹለከ ደጋ መንቤቾን ሀሶስ። <verse eid="LUK 2:44"/><verse number="45" style="v" sid="LUK 2:45"/>ሀስ ሆጎ ወክት እሱ ሀሰን ዬሩሳሌመ ፈንቀልት መርቶኡ። <verse eid="LUK 2:45"/><verse number="46" style="v" sid="LUK 2:46"/>እስን ተማርሲሰ መን በላን አፉዕል ሞጮጨንለከ ጠዕምቱተ ጠዕመን ሰሶ በሬች ኤተሮን መገን ምኔን ደጎስ። <verse eid="LUK 2:46"/><verse number="47" style="v" sid="LUK 2:47"/>ሞጮጭቶ መኑ ጉዕሙንኩ አጥራመች ቶጊንከስለከ መስሊንከስ አጀብሲጭቶኡ። <verse eid="LUK 2:47"/><verse number="48" style="v" sid="LUK 2:48"/>ዩሱፍለከ መርየመ ለኦ ወክት አበ አጀብሲጭቶኡ፤ አመስን «ኢ ጩሌ! ሚሃት ህት አቶንትኔሁ? ህትን አኑኪ አን ጨነቀመን ሀንሳንኬት እቅ» ይቶስ።<verse eid="LUK 2:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49"/>እስን «ሚሃ ሃሴነዕኔ? አኒሀኤ ዮርቾን እሁ ሀስሰኖኤሀ እሁስ ደጌነንተበእንዶ?» ዬሰ። <verse eid="LUK 2:49"/><verse number="50" style="v" sid="LUK 2:50"/>እሰን ጠወዕዮሰ ጠወሃ አጥራመቶበአ።<verse eid="LUK 2:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51"/>ህከኒች ኤተሮን እሳኒን ሜጡበ ናዝሬተ አሜቾ፤ እሳንከ አዘዘመኖሰ እቅ፤ አመስ ህከ ጠወሃ ጉዕመንከ ቀልቤንከሴ አፋ እቅ። <verse eid="LUK 2:51"/><verse number="52" style="v" sid="LUK 2:52"/>ኢስ መገንለከ መን ብሬን አያኒን ዊም ሀይማንለከ ጉባን ነጰን መረኖት እቅ።<note caller="-" style="x"><char style="xo" closed="false">2፥52 </char><char style="xt" closed="false"><ref loc="1SA 2:26">1 ሳሙ. 2፥26</ref>፤ <ref loc="PRO 3:4">ምሳ. 3፥4</ref>።</char></note><verse eid="LUK 2:52"/></para>
  <chapter eid="LUK 2"/>
  <chapter number="3" style="c" sid="LUK 3"/>
  <para style="s1">ጠመቃንቹ ያህይ ተማርሱስ</para>
  <para style="r">(<ref loc="MAT 3:1-12">ማቶ. 3፥1-12</ref>፤ <ref loc="MRK 1:1-8">ማር. 1፥1-8</ref>፤ <ref loc="JHN 1:19-28">ያህ. 1፥19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1"/>ሮም ዎሙ ጢባርዮስ ዎመ እኮ ቶና ኦንትቅ ዘማን ጴንጠናዊ ጵላጦስን ይሁዳ ገሸኖ እቅ፤ ህትን ሄሮድስን ገሊላ ባዱ ሄሮድሴ አመቤቱ ፊልጶስን «ኢጡርያስለከ ጥራኮኒዶስ» ዬኖ ባዱ ሊሳንዮሰ ህትን «አቢሌኔ» ዬኖ ባዱ ገሽታእረ እቅ። <verse eid="LUK 3:1"/><verse number="2" style="v" sid="LUK 3:2"/>ህትን ሐናኒለከ ቀያፊ መገን ምኔን ሎርሎራኖ ቂሰተ አዎንሰኖ እቅ፤ ህከ ወክት መገን ላገት ዘከርይ ጩልቤቹ ያህይበ ኡለ ኡድማን አሜቶኡ። <verse eid="LUK 3:2"/><verse number="3" style="v" sid="LUK 3:3"/>ህካን እኮቤቺሃ ያህይ ዮርዳኖስ ዊ አዝጋጌን ጉዕማንን ዘሀን «ጩብሀክዕኔ ጡሙ ደእቶኖተ ቶበቴን ጠመቀሜ» የን ተማርሰኖ እቅ። <verse eid="LUK 3:3"/><verse number="4" style="v" sid="LUK 3:4"/>ህካን እኮሁ ነቢዬቹ እስያስ ያህይተኔሃ ሄጭ</para>
  <para style="q1" vid="LUK 3:4">«ሁኩዕኑን! ኩን ኡለ ኡድማን ህት የን ያረኖ መንችተ ላገ፤</para>
  <para style="q2" vid="LUK 3:4">‹መገን ዎቃሃ ቅጥአዕዬ!</para>
  <para style="q2" vid="LUK 3:4">ህገኖ ቤቹንከ ብዝ አዕዬ!<verse eid="LUK 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5"/>በዕዮቤቹ ጉዕሙንኩ ዊሙን!</para>
  <para style="q2" vid="LUK 3:5">ቆተትለከ ቆሩት ጉዕሙንኩ ራሰተ እኩን!</para>
  <para style="q1" vid="LUK 3:5">ሾኩ ዎቆንኩ ጌጥ ዩን!</para>
  <para style="q2" vid="LUK 3:5">ሂሉ ዎቆንኩ ብዝ ዩን!<verse eid="LUK 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6"/>መኑ ጉዕሙንኩ መገን ጡምሱ ለኡን!›»</para>
  <para style="m" vid="LUK 3:6">የመም ከተበሞጋት።<note caller="-" style="x"><char style="xo" closed="false">3፥6 </char><char style="xt" closed="false"><ref loc="ISA 40:3-5">ኢሳ. 40፥3-5</ref>።</char></note><verse eid="LUK 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7"/>ህካን እኮቤቺሃ ጠመቆሰተ አሜቶ ልግብ መነ ያህይ «አዕኑ ኩ አዳዌ እለት! አሜታ ኡሙዕሬች ሁንቶኖተ አይ ኩሎህዕኔ?<note caller="-" style="x"><char style="xo" closed="false">3፥7 </char><char style="xt" closed="false"><ref loc="MAT 12:34">ማቶ. 12፥34</ref>፤ <ref loc="MAT 23:33">23፥33</ref>።</char></note> <verse eid="LUK 3:7"/><verse number="8" style="v" sid="LUK 3:8"/>ቴሱ ቶበቱክዕኔ ለሊሳ ሆጉተ አዕዬ ቤሉ ነኡ ‹እብራሂምተ እለ› ይቴነን ቀልብክዕኔ ጠዊን ድከኦኖቼ፤ መሰንትስ መገኑ ከን ክኒች እብራሂሚሃ እለተ አዕይ ኬሶተ አታለኖገ ኩላንክዕኔ። <verse eid="LUK 3:8"/><verse number="9" style="v" sid="LUK 3:9"/>ቴሱ ከልቱ ሀቅ ፎቃን አፉዕልዮኡ፤ ህካን እኮቤቺሃ ጡመ ላልቹ ላልቡ ሀቁ ጉዕሙንኩ ሙርተዕይ ጊራን ኣገኖ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">3፥9 </char><char style="xt" closed="false"><ref loc="MAT 7:19">ማቶ. 7፥19</ref>።</char></note><verse eid="LUK 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10"/>ሁኩ መኑንኩ ያህይ «ቴሱ መ አዕኑ?» ይት ጠዕምቶስ።<verse eid="LUK 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11"/>እስን ፈንቀሽ «ለሙ ኦድኑት ዮሲሁ ዮስበእሀኒሃ ኣሱን፤ እቴኖሁ ዮሲሁ እቴኖሁ ዮስበእሀኒሃ ቤሁን» ዬእ።<verse eid="LUK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12"/>ህትን ቀረጠ ሙርታእሩ ጠመቀንቶተ አሜት «አስተማርቾ! ነኡ መ አዕኑ?» ይት ጠዕምቶ ወክት<note caller="-" style="x"><char style="xo" closed="false">3፥12 </char><char style="xt" closed="false"><ref loc="LUK 7:29">ሉቃ. 7፥29</ref>።</char></note> <verse eid="LUK 3:12"/><verse number="13" style="v" sid="LUK 3:13"/>«ሕጊን ፈቀደሞህዕኔሀኒች በትሴን ኣእቶኖቼ» ዬሰ።<verse eid="LUK 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 3:14"/>ህትን ወታደሩንኩ «ነኡ መ አዕኑ?» ይት ጠዕምቶ ወክት «መቶ መንቺች ወልቃን ዘረፎኖቼ፤ መቱ መንቹሃ ክዝቢን ከሰሶኖቼ፤ ገይክዕኔ ደሞዙ እሁንክዕኔ» ዬሰ።<verse eid="LUK 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15"/>መኑ ተብሴን አገረኖቤቺሃ ጉዕሙንኩ መኑ ቀልቤንከስ ያህይ «ኩን መሲህትንዶ?» ይት ሰውይታ እቅ። <verse eid="LUK 3:15"/><verse number="16" style="v" sid="LUK 3:16"/>ያህይን «አን ዊን ጠመቃንክዕኔ፤ ጠዉ እኮጎሬ አን ጫዕማስ ወደሩ ሂሮተ አታልቡ ኢች ጠረኙ አሜተኖ፤ እስን ጠሊለ መገን አያኒንለከ ጊራን ጠመቀኖህዕኔ፤ <verse eid="LUK 3:16"/><verse number="17" style="v" sid="LUK 3:17"/>እስን ኦድ አሌን ዉጠተ ጋቢች አደ አኦተ ቤለ አንጋንከስ አፎኡ፤ ጠዉ እኮጎሬ ጋበስ አደ አዕዮች ኤተሮን ዉጠተ ቀፎን ወረኖ፤ ጋበንከ ጠእትበ ጊራን ቡሰኖ» ዬሰ። <verse eid="LUK 3:17"/><verse number="18" style="v" sid="LUK 3:18"/>ህትን መነ አበ ሸዘነተ ሸዘን ተሽት ላገተ ዱዱብሰኖ እቅ። <verse eid="LUK 3:18"/><verse number="19" style="v" sid="LUK 3:19"/>ጠዉ እኮጎሬ ገሊለ ባድ ገሻንቹ ሄሮድስ አመስ ቤት ፊልጶሴ ጫተ ሄሮድያደ ኣኤቤቺሃለከ ዎሉ አዕዮ ተንኮተ ጉዕሚንከ ያህይ ሻቆስ። <verse eid="LUK 3:19"/><verse number="20" style="v" sid="LUK 3:20"/>ሄሮድስ ተንኮ አሌን ተንኩተ አዕይ ያህይ ኡሱር ምኒ አግሾስ።<note caller="-" style="x"><char style="xo" closed="false">3፥20 </char><char style="xt" closed="false"><ref loc="MAT 6:17-18">ማቶ. 6፥17-18</ref>።</char></note><verse eid="LUK 3:20"/></para>
  <para style="s1">ኢስ ጠመቀሙስ</para>
  <para style="r">(<ref loc="MAT 3:13-17">ማቶ. 3፥13-17</ref>፤ <ref loc="MRK 1:9-11">ማር. 1፥9-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21"/>መኑ ጉዕሙንኩ ጠመቀሞች ኤተሮን ኢስ ጠመቀሞ፤ እስን ዱአ አአንን ሰሞ ፈንተዕያን <verse eid="LUK 3:21"/><verse number="22" style="v" sid="LUK 3:22"/>ጠሊሉ አያኑ ሀንደዕሬገ እክ አሌስ ድሬእ፤ ህከ ወክትንከ «ኢታም ቤቱኤ አቴት ኪን ተሽ የኖኤ» ይታ ላገት ሰሜች አሜቶኡ።<note caller="-" style="x"><char style="xo" closed="false">3፥22 </char><char style="xt" closed="false"><ref loc="GEN 22:2">ክል. 22፥2</ref>፤ <ref loc="PSA 2:7">መዝ. 2፥7</ref>፤ <ref loc="ISA 42:1">ኢሳ. 42፥1</ref>፤ <ref loc="MAT 3:17">ማቶ. 3፥17</ref>፤ <ref loc="MRK 1:11">ማር. 1፥11</ref>፤ <ref loc="LUK 9:35">ሉቃ. 9፥35</ref>።</char></note><verse eid="LUK 3:22"/></para>
  <para style="s1">ኢስ እለሞ አበናኖተኔሃ</para>
  <para style="r">(<ref loc="MAT 1:1-17">ማቶ. 1፥1-17</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23"/>ኢስ ሆጉተ ጀመረኖ ወክት ሰጁ ዘማን ጌሰ እኮስ እቅ፤ መኑ እሱ ዩሱፍያ ቤቱ ይ ሰውየኖ እቅ፤ ዩሱፍ ኤልያ ቤቱ እቅ። <verse eid="LUK 3:23"/><verse number="24" style="v" sid="LUK 3:24"/>ኤል ማቲያ ቤቱ፥ ማት ሌዊያ ቤቱ፥ ሌዊ ሚልክያ ቤቱ፥ ሚልኪ ዮና ቤቱ፥ ዮና ዩሱፍያ ቤቱ። <verse eid="LUK 3:24"/><verse number="25" style="v" sid="LUK 3:25"/>ዩሱፍ ማታትዩያ ቤቱ፥ ማታትዩ አሞጽያ ቤቱ፥ አሞጽ ናሆምያ ቤቱ፥ ናሆም ኤስልምያ ቤቱ፥ ኤስልም ናጌያ ቤቱ። <verse eid="LUK 3:25"/><verse number="26" style="v" sid="LUK 3:26"/>ናጌ ማኣትያ ቤቱ፥ ማኣት ማታትዩያ ቤቱ፥ ማታትዩ ሴሜይያ ቤቱ፥ ሴሜይ ዩሱፍያ ቤቱ፥ ዩሱፍ ዮዳያ ቤቱ። <verse eid="LUK 3:26"/><verse number="27" style="v" sid="LUK 3:27"/>ዮዳ ዮናንያ ቤቱ፥ ዮናን ሬስያ ቤቱ፥ ሬስ ዘሩባቤልያ ቤቱ፥ ዘሩባቤል ሰላትያልያ ቤቱ፥ ሰላትያል ኔርያ ቤቱ። <verse eid="LUK 3:27"/><verse number="28" style="v" sid="LUK 3:28"/>ኔር ምልክያ ቤቱ፥ ሚልኪ ሐድያ ቤቱ፥ ሐዲ ቆሳምያ ቤቱ፥ ቆሳም ኤልሞዳምያ ቤቱ፥ ኤልሞዳም ዔርያ ቤቱ። <verse eid="LUK 3:28"/><verse number="29" style="v" sid="LUK 3:29"/>ዔር ዮሴዕያ ቤቱ፥ ዮሴዕ ኤልዔዛርያ ቤቱ፥ ኤሌዔዛር ዮራምያ ቤቱ፥ ዮራም ማጣትያ ቤቱ፥ ማጣት ሌዊያ ቤቱ። <verse eid="LUK 3:29"/><verse number="30" style="v" sid="LUK 3:30"/>ሌዊ ስሞንያ ቤቱ፥ ስሞን ይሁድያ ቤቱ፥ ይሁድ ዩሱፍያ ቤቱ፥ ዩሱፍ ዮናንያ ቤቱ፥ ዮናን ኤልያቅያ ቤቱ። <verse eid="LUK 3:30"/><verse number="31" style="v" sid="LUK 3:31"/>ኤልያቅ ሜልያ ቤቱ፥ ሜልያ ማይናንያ ቤቱ፥ ማይናን ማጣትያ ቤቱ፥ ማጣት ናታንያ ቤቱ፥ ናታን ዳዉድየ ቤቱ። <verse eid="LUK 3:31"/><verse number="32" style="v" sid="LUK 3:32"/>ዳዉድ እሴይያ ቤቱ፥ እሴይ ኢዮቤድያ ቤቱ፥ ኢዮቤድ ቦኤዝያ ቤቱ፥ ቦኤዝ ሰልሞንያ ቤቱ፥ ሰልሞን ነአሶንያ ቤቱ። <verse eid="LUK 3:32"/><verse number="33" style="v" sid="LUK 3:33"/>ነአሶን አምናደብያ ቤቱ፥ አምናደብ አድምንየ ቤቱ፥ አድሚን አሮኒያ ቤቱ፥ አሮኒ ሔጽሮምያ ቤቱ፥ ሔጽሮም ፋሬስያ ቤቱ፥ ፋሬስ ይሁድያ ቤቱ፥ ይሁድ ያቁብያ ቤቱ። <verse eid="LUK 3:33"/><verse number="34" style="v" sid="LUK 3:34"/>ያቁብ ኢሳቅያ ቤቱ፥ ኢሳቅ እብራሂምያ ቤቱ፥ እብራሂም ታራሃ ቤቱ፥ ታራ ናኮርያ ቤቱ። <verse eid="LUK 3:34"/><verse number="35" style="v" sid="LUK 3:35"/>ናኮር ሰሩጊያ ቤቱ፥ ሰሩግ ረኡያ ቤቱ፥ ረኡይ ፈሌቅያ ቤቱ፥ ፋሌቅ አቤርያ ቤቱ፥ አቤር ሳላሃ ቤቱ። <verse eid="LUK 3:35"/><verse number="36" style="v" sid="LUK 3:36"/>ሳላ ቃይንያ ቤቱ፥ ቃይን አርፋክስድያ ቤቱ፥ አርፋክስድ ሴምያ ቤቱ፥ ሴም ኑህያ ቤቱ፥ ኑህ ላሜህያ ቤቱ። <verse eid="LUK 3:36"/><verse number="37" style="v" sid="LUK 3:37"/>ላሜህ ማቱሳልያ ቤቱ፥ ማቱሳል ሔኖክያ ቤቱ፥ ሄኖክ ያሬድያ ቤቱ፥ ያሬድ መላልኤልያ ቤቱ፥ መላልኤል ቃይናምያ ቤቱ። <verse eid="LUK 3:37"/><verse number="38" style="v" sid="LUK 3:38"/>ቃይናም ሄኖስያ ቤቱ፥ ሄኖስ ሤትያ ቤቱ፥ ሤት ኣደምያ ቤቱ፥ ኣደም መገንያ ቤቱ ይታ እቅ።<verse eid="LUK 3:38"/></para>
  <chapter eid="LUK 3"/>
  <chapter number="4" style="c" sid="LUK 4"/>
  <para style="s1">ኢስ ፌተነሙስ</para>
  <para style="r">(<ref loc="MAT 4:1-11">ማቶ. 4፥1-11</ref>፤ <ref loc="MRK 1:12-13">ማር. 1፥12-13</ref>)</para>
  <para style="p">
    <verse number="1-2" style="v" sid="LUK 4:1-2"/>ኢስ ጠሊሉ አያኑ ዊማንስ ዮርዳኖስ ዊች ፈንቀል አሜቾ፤ ህከኒች ኤተሮን ጠሊሉ አያኑ ኢሰ ኡለ ኡድመ ኦሮአኖገ አዕዮስ፤ ህከኔን ሸይሉ በር እልብሱ ፌተኞስ፤ ህከን በራካንን መቱርቹሃ እቱ ሆጎቤቺሃ በሩስ ጎፎ ወክት ጎር አፎስ። <verse eid="LUK 4:1-2"/><verse number="3" style="v" sid="LUK 4:3"/>ህከ ወክት ሸይጣኑ ኢሰ «ህንዴ አት መገን ቤቱ እኮንትጎሬ ከ ክኑ ዳቡተ እሁን ይት አዘዝ» ዬስ።<verse eid="LUK 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4"/>ጠዉ እኮጎሬ ኢስ « ‹መኑ ጠለዕል እቴኖርቺን ሄአኖበአ› የመም ከተበሞኡ» ይ ፈንቀሼእ።<note caller="-" style="x"><char style="xo" closed="false">4፥4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">ዘዳ. 8፥3</ref>።</char></note><verse eid="LUK 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5"/>ህከኒች ኤተሮን እልብሱ ኢሰ ቆሮ አል ፉሽ ኣዱንያ አል ዎመተ ጉዕመንከ ገለብቴንን ለሊሽስ ኬዕይ <verse eid="LUK 4:5"/><verse number="6" style="v" sid="LUK 4:6"/>«ከ ገሽ ወልቀተለከ ሎርማሰ ጉዕመንከ ኣሳንኬ፤ ኩ ኬዕምኙ ኤሳሃ ኣሰሞኤቤቺሃ አን ሀሾምሀኒሃ አዬሃ ኣሶተ አታላም። <verse eid="LUK 4:6"/><verse number="7" style="v" sid="LUK 4:7"/>ህካን እኮቤቺሃ አት ኤሳሃ ሰገዶንቴኤ ጎሬ ኩን ጉዕሙንኩ ኬሳሃ እሀኖሄ» ዬስ።<verse eid="LUK 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8"/>ኢስን « ‹ቀርቹሃ መገኒሃክ ሰገድ፤ ጠለዕል እሲንከ እባደተ አእ› የመም ከተበሞኡ» ይ ፈንቀሼእ።<note caller="-" style="x"><char style="xo" closed="false">4፥8 </char><char style="xt" closed="false"><ref loc="GEN 6:13">ክል. 6፥13</ref>።</char></note><verse eid="LUK 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9"/>ህከኒች ኤተሮን እልቢሱ ኢሰ ዬሩሳሌመ መስስ ዱእ ምኒ እሌ አሌን ኡርሽ «አት መገን ቤቱ እኮንትጎሬ ህንዴ ገዉክ ዎሮ ዋልት ኡብ፤ <verse eid="LUK 4:9"/><verse number="10" style="v" sid="LUK 4:10"/>‹ኬሳሃ አገርቶተ መገኑ መላይከተ አዘዘኖ፤<note caller="-" style="x"><char style="xo" closed="false">4፥10 </char><char style="xt" closed="false"><ref loc="PSA 91:11">መዝ. 91፥11</ref>።</char></note> <verse eid="LUK 4:10"/><verse number="11" style="v" sid="LUK 4:11"/>ህትን ሎከክ ክኖን ቆዕልታበእገ አንጋንከሰ ኬስ አፋሄ› የመም ከተበሞኡ» ዬስ።<note caller="-" style="x"><char style="xo" closed="false">4፥11 </char><char style="xt" closed="false"><ref loc="PSA 91:12">መዝ. 91፥12</ref>።</char></note><verse eid="LUK 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12"/>ኢስን « ‹ቀርቹ መገኑክ ፌተንቶት› የመም ከተበሞኡ» ይ ፈንቀሼስ።<note caller="-" style="x"><char style="xo" closed="false">4፥12 </char><char style="xt" closed="false"><ref loc="DEU 6:1">ዘዳ. 6፥1</ref>።</char></note><verse eid="LUK 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13"/>እልቢሱ ኢሰ ፈተኝ ሹሎች ኤተሮን ወክቲሃስ አጉር ኦሮዕዮ።<verse eid="LUK 4:13"/></para>
  <para style="s1">ኢስ ሆጉስ ገሊላን ጀመሩስ</para>
  <para style="r">(<ref loc="MAT 4:12-17">ማቶ. 4፥12-17</ref>፤ <ref loc="MRK 1:14-15">ማር. 1፥14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14"/>ህከኒች ኤተሮን ኢስ ጠሊለ አያን ዎልቃን ዊም ገሊለተ ፈንቀሎ፤ እስ ዱዱቡንኩ ህከን አዳን ዮ ባዶን ጉዕማንን ሞጮጨሞ። <verse eid="LUK 4:14"/><verse number="15" style="v" sid="LUK 4:15"/>እስን ጭምት ምኔን ተማርሰኖ ወክት መኑ ጉዕሙንኩ ገለትጨኖስ እቅ።<verse eid="LUK 4:15"/></para>
  <para style="s1">ናዝሬት ከተማን ኢሰ ግቤመገ</para>
  <para style="r">(<ref loc="MAT 13:53-58">ማቶ. 13፥53-58</ref>፤ <ref loc="MRK 6:1-6">ማር. 6፥1-6</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16"/>ህከኒች ኤተሮን ኢስ ነጴ ባዱ ናዝሬተ አሜች ሮሾገን አይሁድ አበ በሬን ዱአ አኤኖ ምኒ ኣግ አነበቦተ ኬዕዮ። <verse eid="LUK 4:16"/><verse number="17" style="v" sid="LUK 4:17"/>ህከ ወክት ነብዬቾ እስያሴ መጻፈ ኣስቶስ፤ ህከ ጣጠሞ መጻፈ ፈኞ ወክት<verse eid="LUK 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18"/>«ቀርች አያኑ ኢ አሌኒት፤</para>
  <para style="q2" vid="LUK 4:18">ተሽት ላገተ ቡጥቻኖተ ዱዱብሶተ ሹመ አዕይ ቡሮኤ፤</para>
  <para style="q1" vid="LUK 4:18">ኡሱረንቶእሩ ሂረንቶተ፥</para>
  <para style="q2" vid="LUK 4:18">ቆቁ መኑ ለኣገ አዋጆተ፥</para>
  <para style="q2" vid="LUK 4:18">ጭንፈንቶራ ሰዎልድማን ፉሾተለከ<verse eid="LUK 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LUK 4:19"/>ህትን ቀርቹ ሙንዲሲሰኖ</para>
  <para style="q2" vid="LUK 4:19">ወክቱ እሌገ አዋጆተ ሶኮኤ» የመም ከተበሞቤቹ ደጎ።<note caller="-" style="x"><char style="xo" closed="false">4፥19 </char><char style="xt" closed="false"><ref loc="ISA 61:1-2">ኢሳ. 61፥1-2</ref>።</char></note><verse eid="LUK 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20"/>ኢስን መጻፈ ጣጭ አስናደኖሀኒሃ ኣስ አፉዕሌእ፤ ጭምት ምኔን ሄዕዮ መኑ ጉዕሙንኩ ቱክ ይት ለኣስት እቅ። <verse eid="LUK 4:20"/><verse number="21" style="v" sid="LUK 4:21"/>እስን «ከበር ከን መጻፍ ላገት አዕኑ ሞጮጭቴነን ዊንቶኡ» ዬሰ።<verse eid="LUK 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22"/>ጉዕሙንኩ መኑ እስተኔሃ ጡመ ጠወ ጠወአኖት እቅ፤ ህትን ጠወአኖ ኣስቶ ላጋን አጀብሲጭት «ኩን ዩሱፍሃ ቤቱበእንዶ?» ይቶስ።<verse eid="LUK 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23"/>ኢስን « ‹አት ሀኪንቹ! ህንዴ ገዉክ ፈይስ› ይታ ተ ምሳልተ ሸክት ዮበኢሃ ኤሳሃ ይቴነንተገ ደጋም፤ ህትን ‹ቅፍርናሆም ከተማን አቶንቲሃ ነኡ ሞጮጭኖሚሃ ከን ገይክ ባዶን አእ› ይቴነንተኤ» ዬሰ። <verse eid="LUK 4:23"/><verse number="24" style="v" sid="LUK 4:24"/>ሀንቅንከ ያንክዕኔ፤ ነብዬቹ ገይስ ባዶን ሆሮን ኬዕምሴኖበአ።<note caller="-" style="x"><char style="xo" closed="false">4፥24 </char><char style="xt" closed="false"><ref loc="JHN 4:44">ያህ. 4፥44</ref>።</char></note><verse eid="LUK 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 4:25"/>«ሀንቅንከ ያንክዕኔ እልያሴ ዘማኔን ሰሱ ዘማንለከ ሌሁ አገነ ጤኑ ኡቡ ሆጎቤቺሃ ባዶን ጉዕማንን ጎሩ እኮ ወክት እስራኤል ባዶን ምንሰ አኑ ሬዮ ልግቡ ሜንቱ ሄኦ እቅ።<note caller="-" style="x"><char style="xo" closed="false">4፥25 </char><char style="xt" closed="false"><ref loc="1KI 17:8-16">1 ነገ. 17፥8-16</ref>።</char></note> <verse eid="LUK 4:25"/><verse number="26" style="v" sid="LUK 4:26"/>ጠዉ እኮጎሬ እልያስ ሲዶነ ዬኖ ባዶን ሄዕዮ ሰረጵተ ዬኖ ቀዕያን ሄኣ ምኒ አኑ ዮሴበእ መንቾ ቤሉ ወልሀስ አዬሃ እስራኤላን ሄኣ ምንሰ አኑ ሬዮ ሜንትቤቹ ሶሀሞበአ። <verse eid="LUK 4:26"/><verse number="27" style="v" sid="LUK 4:27"/>ህትን ነብዬቾ እልሳኤ ዘማን እስራኤላን ጎግ አል ጥዘነት አፎስ ልግቡ መኑ ሄዕዮ እቅ፤ ጠዉ እኮጎሬ ሶርየ ዬኖ ባድ ንዕማኔ ዬኖ መንች ቤሉ ዎሉሰ ፈይቶበአ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">4፥27 </char><char style="xt" closed="false"><ref loc="2KI 5:1-14">2 ነገ. 5፥1-14</ref>።</char></note><verse eid="LUK 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28"/>ህከን ጭምት ምኔን ሄዕዮ መኑ ጉዕሙንኩ ህካን ሞጮጭቶ ወክት ኡሙዕርቶኡ። <verse eid="LUK 4:28"/><verse number="29" style="v" sid="LUK 4:29"/>ጉዕሙንኩሰ ከተሚች አብል ፉሽቶሲች ኤተሮን ዎሮ ዋሽት ኡጅቶተ ሀስ ከተሙሰ እጃራሞ ቆሮ ገርደብ መድ መስቶስ። <verse eid="LUK 4:29"/><verse number="30" style="v" sid="LUK 4:30"/>ጠዉ እኮጎሬ እስን በሊንከሰ ፉል ኦሮዕዮ።<verse eid="LUK 4:30"/></para>
  <para style="s1">ዶሮረኖ ዱሩ አፎስ መንቹ ፈዩስ</para>
  <para style="r">(<ref loc="MRK 1:21-28">ማር. 1፥21-28</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31"/>ኢስን ገሊላን ሄዕዮ ቅፍርናሆም ከተመ ዎሮ ዋል ኦሮዕዮ፤ ህከኔን አይሁድ አበ በሬን ጉዕመረን ተማርሰኖሳት እቅ። <verse eid="LUK 4:31"/><verse number="32" style="v" sid="LUK 4:32"/>ጠዉስ ደጊን እኮቤቺሃ እስ ተማርሰኖ ትምርቴን ጉዕሙንኩ አጀብሲጭታ እቅ።<note caller="-" style="x"><char style="xo" closed="false">4፥32 </char><char style="xt" closed="false"><ref loc="MAT 7:28-29">ማቶ. 7፥28-29</ref>።</char></note> <verse eid="LUK 4:32"/><verse number="33" style="v" sid="LUK 4:33"/>ህከኔን ዱእ ምኔን ዶሮረኖ ዱሩ አፎስ መንቹ ሄዕዮ እቅ፤ እስን ሎረ ላጋን <verse eid="LUK 4:33"/><verse number="34" style="v" sid="LUK 4:34"/>«ናዝሬት ኢሰ! ኔሳሃለከ ኬሳሃ ም ደቀንሹ ዮኔ? ቤሶኔተ አሜትንዶ? አት አዬት ጎሬ ደንጋንኬ፤ አት መገንየ ጠሊለ» ይ ያሮ።<verse eid="LUK 4:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35"/>ጠዉ እኮጎሬ ኢስ «ጨለይት እሲች ፉል!» ይ ሻቆስ፤ ህካን እኮቤቺሃ ዶሮረኖ ዱሩ ህከ መንቹ መን በላን ኡጅ መቱርቹሃ ምሩዕናንስ እሲች ፉሎ።<verse eid="LUK 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36"/>ጉዕሙንኩ አጀብሲጭት ገገዉንኩሰን «ኩን ሀትኔታ ላገ? ወልቃንለከ ዳኞማን ዶሮረኖ ዱር አዘዘኖ ወክት እሰን አዘዘንት ፉልታኢት» የቀንቶኡ። <verse eid="LUK 4:36"/><verse number="37" style="v" sid="LUK 4:37"/>ኢስ ዱዱቡንኩ ህከን አዝጋጌን ሄዕዮ ባዶን ጉዕማንን ሞጮጨሞ።<verse eid="LUK 4:37"/></para>
  <para style="s1">ኢስ ልግብ ጥዘናመተ ፈይሱስ</para>
  <para style="r">(<ref loc="MAT 8:14-17">ማቶ. 8፥14-17</ref>፤ <ref loc="MRK 1:29-34">ማር. 1፥29-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38"/>ኢስ ዱእ ምኒች ፉል ስሞኔ ምኒ ኣጎ፤ ህከኔን ስሞኔ በሉት ፋረ ደሙሜን ጥዞ እቅ፤ እሰን እሴንተ ፈይሶተ ኢሰ ኡጭቶስ።<verse eid="LUK 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 4:39"/>እስን እሴ መድ ሆንጠክ ኡርኬዕይ ሁኩ ፋረ ደሙምት ገፈርቶተ አዘዣን አጉሮሴ፤ ህከ ወክት ኬእ እሰንተ ካደሙ ጀመርቶኡ።<verse eid="LUK 4:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40"/>አሩ ኣጎ ወክት መኑ አደደ ጥዘናን ጥዞ ጥዘናመተ ጉዕመንከ ኢስበ ኤቦኡ፤ እስን መት-መትሰ አሌን አንገስ አሌሰ አዕይ ጉዕመንከሰ ፈይሾ። <verse eid="LUK 4:40"/><verse number="41" style="v" sid="LUK 4:41"/>ህትን ሩሃንዩንኩ ልግብያ መኒች «አት መገንየ ቤቱ» የን ያረን ፉሎ፤ ጠው እኮጎሬ ኢስ ሻቆሰ፤ ህትን ዶሮረኖ ዱሩ እስ መሲህ እሁስ ደጎቤቺሃ እሲን ጠወኦተ ፈቀጆሰበአ።<verse eid="LUK 4:41"/></para>
  <para style="s1">ኢስ ገሊላን ተማርሱስ</para>
  <para style="r">(<ref loc="MAT 4:23-25">ማቶ. 4፥23-25</ref>፤ <ref loc="MRK 1:35-39">ማር. 1፥35-39</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42"/>ኡለት ሶዞ ወክት ኢስ ህከንቤቺች ኬዕይ መኑ ዮበእቤቹ ኦሮዕዮ፤ ጠው እኮጎሬ መኑ እሱ ሀሰን አሜት እሰንተ አጉር ኦሮአኖበእገ ኡጭቶስ። <verse eid="LUK 4:42"/><verse number="43" style="v" sid="LUK 4:43"/>እስን «ዎሎ ከተሚሃ መገን ዎምነት ተሽት ላገተ ዱዱብሱ ሀስሰኖኤ፤ መሰንትስ አን ሶሀሞሚሁ ተን ሆጎታት» ዬሰ።<verse eid="LUK 4:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 4:44"/>ህካን እኮቤቺሃ ይሁድ ባድ ጭምት ምናን ፈንቀላመን ተማርሰኖ እቅ።<verse eid="LUK 4:44"/></para>
  <chapter eid="LUK 4"/>
  <chapter number="5" style="c" sid="LUK 5"/>
  <para style="s1">ኢስ ዎዕኔ አሳበተ ገኡስ</para>
  <para style="r">(<ref loc="MAT 4:18-22">ማቶ. 4፥18-22</ref>፤ <ref loc="MRK 1:16-20">ማር. 1፥16-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1"/>መቱ በር ኢስ «ጌንሴሬጠ» ዬኖ ባር መዴን ኡርዮሃኔን ልግቡ መኑ እስበ ሆንጠክ መገን ላገተ ሞጮጭቶተ ሀንበዕለንተን <verse eid="LUK 5:1"/><verse number="2" style="v" sid="LUK 5:2"/>ኢስ ባር ገበላን ኡርት ሄኦ ለሙ ጀልበ ለዕዮ፤ ቁርጩሜተ ወሻዳሩ ጀልብ ኣዚች ፉልት ወሻደሰ ኣንሽታኢት እቅ። <figure style="fig" alt="Fisher men in their fishing boat" file="HK00208B.tif" size="span" ref="5፥2">ጀልብ አሌን ቁርጩሜተ ዎሻዳሩ</figure> <verse eid="LUK 5:2"/><verse number="3" style="v" sid="LUK 5:3"/>ኢስን ህከን ጀልቢች መቶንከስ ስሞኔሀኔን ኣግ ሎረ ባርበ ሽቅ አኦተ ስሞኔ ጠዕሜስ፤ ህከን ጀልባን አፉዕል ኡመት ተማርሴእ።<note caller="-" style="x"><char style="xo" closed="false">5፥3 </char><char style="xt" closed="false"><ref loc="MAT 13:1-2">ማቶ. 13፥1-2</ref>፤ <ref loc="MRK 3:9-10">ማር. 3፥9-10</ref>፤ <ref loc="MRK 4:1">4፥1</ref>።</char></note><verse eid="LUK 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4"/>ኢስ ጠወዕይ ሹሎች ኤተሮን ስሞኔ «ጥዕላሻ አደ ዋሽቴን ቁርጩሜተ ወሻዶኖተ ወሻዳክኔ ኡጅዬ» ዬሰ።<verse eid="LUK 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5"/>ስሞንን ፈንቀሽ «ቀርቾ! ዊመ ሀዎሩተ አጰመን ገልን መቱርቹሃ አንፎምበአ፤ ጠዉ እኮጎሬ አት ይቶንቴኤች ወሻዳኤ ኡጃም» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">5፥5 </char><char style="xt" closed="false"><ref loc="JHN 21:3">ያህ. 21፥3</ref>።</char></note> <verse eid="LUK 5:5"/><verse number="6" style="v" sid="LUK 5:6"/>እስ ዬገን አቶ ወክት ልግብ ቁርጩሜተ አፋን ወሻዱሰ ፊልተኡ ጀመሮ።<note caller="-" style="x"><char style="xo" closed="false">5፥6 </char><char style="xt" closed="false"><ref loc="JHN 21:6">ያህ. 21፥6</ref>።</char></note> <verse eid="LUK 5:6"/><verse number="7" style="v" sid="LUK 5:7"/>እሰን ዎሎ ጀልባን ሄኦ ጃለሰ አሜት ሀዕልቶሰተ ቀቀሶሳ፤ ጃለሰን አሜት ለሞ ጀልባን ቁርጩሜተ ዊንሽታን ጀልቡሰ ዊን ኣአሞተ እኮ። <verse eid="LUK 5:7"/><verse number="8" style="v" sid="LUK 5:8"/>ስሞን ጴጥሮስ ህካን ለዕዮ ወክት ኢስ ሎከ አሌን ኡብ «ቀርቾ! አን ጩበኘ እኮምቤቺሃ ኢ መድ ሆንጠኮት» ዬእ።<verse eid="LUK 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 5:9"/>እስ ህካን ዬ መሰት አፎ ቁርጩሜተስ እስለከ እሲን ሜጡበ ሄኦእሩ ጉዕሙንኩ አበ አጀብሲጭቶቤቺሃት እቅ። <verse eid="LUK 5:9"/><verse number="10" style="v" sid="LUK 5:10"/>ህትን ስሞኔ ጃለት ዘብደዎሴ ኦሱት ያቁብለከ ያህይ አጀብሲጭቶኡ፤ ጠዉ እኮጎሬ ኢስ ስሞኔ «ዋጅቶት ከኒች ኤተሪሃ መነ ወሻዳንቲሃ እካንት» ዬስ።<verse eid="LUK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 5:11"/>እሰን ጀልበሰ ኡለ አደ ሽቅ አቶች ኤተሮን ጉዕመርቹንከሰ አጉርት ኢሰ አዎንቶኡ።<verse eid="LUK 5:11"/></para>
  <para style="s1">ኢስ ጎግ አል ጥዘነተ ፈይሱስ</para>
  <para style="r">(<ref loc="MAT 8:1-4">ማቶ. 8፥1-4</ref>፤ <ref loc="MRK 1:40-45">ማር. 1፥40-45</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12"/>መቱ በር ኢስ መቶ ከተማን ሄዕዮገን ጎግ አል ጥዘናን<note caller="+" style="f"><char style="fqa" closed="false">ጎግ አል ጥዘነተ፦ </char><char style="ft" closed="false">የኖሁ ጠሊለ መጻፍ ፍሳረገ መን አሌን ለለኖ አደደ እኮ ህጋ ጎግ ጥዘነተ ለሊሰኖ (ዘሌ 13 ዮኢሃ ለእ)።</char></note> ጥዦ መቱ መንቹ አሜች ኢሰ ለዕዮ ወክት ብሬንከስ ኡብ «ቀርቾ! ተሽዬሄ ጎሬ ፈይሶኤተ አታልታንት» ይ ኡጬስ።<verse eid="LUK 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13"/>ኢስን አንጋንከስ አልስ ሀጣዊ «ኤ ፈይ!» ዬስ፤ ህከ ወክትንከ ሁኩ ጎግ አል ጥዘነት ገፈርቶስ። <verse eid="LUK 5:13"/><verse number="14" style="v" sid="LUK 5:14"/>ህትን ኢስ መንቹስ «ከ ጠወ መቶ መንቺሃ ጠወኦት፤ ጠዉ እኮጎሬ መርት ገዉክ ቂስቺሃ ለሊስ፤ እሲንከ እማኘ እሆተ ሙስ አዘዦገን ፈይቶንትቤቺሃ ክትመ ሆንጠህስ» ዬስ።<note caller="-" style="x"><char style="xo" closed="false">5፥14 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">ሌዌ 14፥1-32</ref>።</char></note><verse eid="LUK 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15"/>ጠዉ እኮጎሬ ኢስ ዱዱቡ ጉዕመ ወክቲችን በትሽ ሞጮጨሞ፤ ልግቡ መኑ እሲች ሞጮጭቶተለከ ጥዘናችሰ ፈይቶተ ጭም ይታኢት እቅ። <verse eid="LUK 5:15"/><verse number="16" style="v" sid="LUK 5:16"/>እሁን ቤሉ እስ ኡለ ኡድመ መር ሜጡንኩስ ዱአ አአኖ እቅ።<verse eid="LUK 5:16"/></para>
  <para style="s1">ኢስ ናፈ መንቹ ፈይሱስ</para>
  <para style="r">(<ref loc="MAT 9:1-8">ማቶ. 9፥1-8</ref>፤ <ref loc="MRK 2:1-12">ማር. 2፥1-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17"/>መቱ በር ኢስ ተማርሰን ገሊላን ይሁድ ባዶን ዮ ኦሌች ጉዕሚችለከ ዬሩሳሌም ከተሚች አሜቶ ፈርሳውያኑትለከ ሕግ አስተማረት መዴንከስ አፉዕልቶ እቅ፤ ኢሲንከ ጥዘናመተ ፈይሰኖ ቀርች ዎልቀት አሌስ ሄኦ እቅ። <verse eid="LUK 5:17"/><verse number="18" style="v" sid="LUK 5:18"/>ህከ ወክት መቱ ሎከተ ናፈ መንቹ ዴሲን እጅት ኤቦኡ፤ እሱንከ ምኒ ኣግስ ኢስ ብሬን አፉሽቶተ ዎቃ ሀሳኢት እቅ። <verse eid="LUK 5:18"/><verse number="19" style="v" sid="LUK 5:19"/>ጠዉ እኮጎሬ መኑ በተዕዮቤቺሃ ሎከተ ናፈ መንቹ ምኒ ኣግሳ ዎቃሃ ሆጎኡ፤ ህካን እኮቤቺሃ ምኒ እሌ አል ፉልት እሌስ ብሎኬቲች መቱ ጌሰ ፈንት ህከ ናፈ መንቹ ዴሲንከስን ኢስ ብሬን ድርሶኡ።<note caller="+" style="f"><char style="ft" closed="false">አይሁድ ምነ እልት ከበር እጃሬኖ ፉቅ ምነገ እጃረንቶእራን፤ ሁኩንን ጡፈሞሁ ብሎኬቲን መክሴመ እፊኒት፤ ህከ ብሎኬት እፈ ፈንት ህከ ናፈ መንቹ ዴሲንከስን ኣግሱሰ ለሊሰኖ።</char></note> <verse eid="LUK 5:19"/><verse number="20" style="v" sid="LUK 5:20"/>ኢስን አመዕነቱሰ ለዕይ «ኮ መንቾ! ጩቡክ አጉረሞሄ» ዬስ።<verse eid="LUK 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21"/>ህካን እኮቤቺሃ ሕግ አስተማረትለከ ፈርሳውት «ኩ መገን አሌን ቦሮር ላገተ ጠወአኖሁ አዬት? ሜጥቾሃ መገን ቤሉ ጩብ ፈቁን ዮተ አታለኖሁ አዬት?» ይተን ሰውዩ ጀመርቶኡ።<verse eid="LUK 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22"/>ኢስ ሰውትሰ ደግ «ካን ቀልቤንከክዕኔ ሚሃት ሰውይቴነንታሁ? <verse eid="LUK 5:22"/><verse number="23" style="v" sid="LUK 5:23"/>‹ጩቡክ ፈቁን› ዪችለከ ‹ኬዕ ሃም› ዪች ሀኩንስ ቆሀኖ? <verse eid="LUK 5:23"/><verse number="24" style="v" sid="LUK 5:24"/>ጠዉ እኮጎሬ ከን ኣዱንያ አሌን መንች ቤቲሃ ጩብ ፈቁን የኖ ሹምነቱ ሄኡስ ለሊሳንክዕኔ» ይ ፈንቀሽ ናፈ መንቹንከ «አን ኬሳሃ ያንኬ፤ ኬእ ዴሰክ እጅት ምንክ ኦሮእ» ዬስ። <verse eid="LUK 5:24"/><verse number="25" style="v" sid="LUK 5:25"/>ህከ ወክትንከ ብሬሰ ኬዕይ ኦሰዕዮ ዴሰ እጅ መገኑ ገለትጨን ምንስ ኦሮዕዮ። <verse eid="LUK 5:25"/><verse number="26" style="v" sid="LUK 5:26"/>ህካን እኮቤቺሃ ጉዕመንከ መነ አጀብሲሻን መገኑ ገለትጭተን «ከበር አጀብሲሰኖ ጠወ ለዕኖም» ይት አበ ዋጅቶኡ።<verse eid="LUK 5:26"/></para>
  <para style="s1">ኢስ ማቶሴ ዬኖ ሌዌ ገኡስ</para>
  <para style="r">(<ref loc="MAT 9:9-13">ማቶ. 9፥9-13</ref>፤ <ref loc="MRK 2:13-17">ማር. 2፥13-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27"/>ህከኒች ኤተሮን ኢስ ህከን አዲች ፉል «ሌዌ» ዬኖ ቀረጠ ሙረኖሃ ቀረጤኖቤቾን አፉዕሌእሃ ለዕይ «አወኔኤ» ዬስ። <verse eid="LUK 5:27"/><verse number="28" style="v" sid="LUK 5:28"/>እስን ጉዕመርቹንከ አጉር ኬዕይ አዎኞስ።<verse eid="LUK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29"/>ሌዊን ኢስሃ ምኔንከስ አበ ድግሰ ቅጥ አዕያን ልግቡ ቀረጠ ሙርታእሩለከ ዎሉ መኑሁ እሳን ሜጡበ ማዳን አፉዕልቶ እቅ። <verse eid="LUK 5:29"/><verse number="30" style="v" sid="LUK 5:30"/>ፈርሳዊያኑትለከ ሕግ አስተማረት ኢስ አሳበተ «ቀረጠ ሙርታሀኑኡንለከ ጩበኛኖን ሜጡበ እቴነንታሁለከ አጌነንታሁ ሚሃት» ይት ቁንቁቶኡ።<note caller="-" style="x"><char style="xo" closed="false">5፥30 </char><char style="xt" closed="false"><ref loc="LUK 15:1-2">ሉቃ. 15፥1-2</ref>።</char></note><verse eid="LUK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31"/>ኢስን «ሀኪሙ ሀስሰኖሁ ጥዘናማታት ቤሉ ፈይሃበአ። <verse eid="LUK 5:31"/><verse number="32" style="v" sid="LUK 5:32"/>አን አሜቾሚሁ ፈያኑተ ገኦተ እሁዕነ ጩበኛኑት ጩብችሰ ቶበት ፈንቀልታገ አኦታት» ይ ፈንቀሼእ።<verse eid="LUK 5:32"/></para>
  <para style="s1">ሶመንተኔሃ ሆንጠኮ ጠዕምቱተ</para>
  <para style="r">(<ref loc="MAT 9:14-17">ማቶ. 9፥14-17</ref>፤ <ref loc="MRK 2:18-22">ማር. 2፥18-22</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33"/>ህከኒች ኤተሮን መት-መት መናከት ኢሰ «ያህይ አዎናኑትለከ ፈርሳዊያኖ አዎናኑት ልግብ ወክት ሶመንተን ዱአ አታአ፤ ጠዉ እኮጎሬ ኪ አሳበት እታኢሁለከ አጋኢሁ ሚሃት?» ይት ጠዕምቶስ።<verse eid="LUK 5:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34"/>ኢስን «እዜቹ እሳን ሜጡበ ሄዕዮገን ቦሎቸ ገኤመ ኮሃ ሶመንታገ አቶኖተ አታልቴነንንዶ? <verse eid="LUK 5:34"/><verse number="35" style="v" sid="LUK 5:35"/>ጠዉ እኮጎሬ እዜቹንከ እሳች አደ አኤን መሴኖ ወክቱ አሜተኖ፤ ህከ ወክት ሶመንታአ» ዬሰ።<verse eid="LUK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36"/>ኢስን መት ምሳልተ «አዪሁ ሃዕሮ ኦድኖች ቃፈተ ፊል ኑባጵቶ ኦድኖን ቃፈኖሁ ዮበአ፤ ህካን አዕዮ ጎሬ ሃዕሮ እሱ ፊለኖ ቤሉ ሃዕሮ ቃፈት ኑባጵቶ ኦድኖን መክታበአ። <verse eid="LUK 5:36"/><verse number="37" style="v" sid="LUK 5:37"/>ህትን አዪሁ ሃዕሮ ወይነ ቦበጤማሃ ኑባቾ ሆቆማዶን አፉሸኖበአ፤ ህካን አዕዮ ጎሬ ሃዕሮ ወይነ ቦበጤማሁ ሆቆማዱንከ ፊላንስ እስን ዱንተአኖ፤ ሆቆማዱንኩ በአኖ። <verse eid="LUK 5:37"/><verse number="38" style="v" sid="LUK 5:38"/>ህካን እኮቤቺሃ ሃዕሮ ወይነ ቦበጤማሃ ሃዕሮ ሆቆማዶን አፉሹ ሀስሰኖ። <verse eid="LUK 5:38"/><verse number="39" style="v" sid="LUK 5:39"/>ህትን አዪሁ ‹ዱንኬኢሁ ቆሀኖ› የኖቤቺሃ ዱንኬ ወይነ ቦበጤማሃ አጎች ኤተሮን ሃዕሮ እሱ ሀሰኖሁ ዮበአ» ይ ኩሎሰ።<verse eid="LUK 5:39"/></para>
  <chapter eid="LUK 5"/>
  <chapter number="6" style="c" sid="LUK 6"/>
  <para style="s1">አበ በሬተኔ ሆንጠኮ ጠዕምቱተ</para>
  <para style="r">(<ref loc="MAT 12:1-8">ማቶ. 12፥1-8</ref>፤ <ref loc="MRK 2:23-28">ማር. 2፥23-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1"/>ኢስ አበ በሬን ውጠ በሊን ህገን አሳበስ ሀማሙተ ተንቅስ አንጋንከሰ ቁስተን እታኢት እቅ።<note caller="-" style="x"><char style="xo" closed="false">6፥1 </char><char style="xt" closed="false"><ref loc="DEU 23:25">ዘዳ. 23፥25</ref>።</char></note> <verse eid="LUK 6:1"/><verse number="2" style="v" sid="LUK 6:2"/>ህካን እኮቤቺሃ ፈርሳዉያኖች መት-መቱሰ «አበ በሬን አኡ ገበእባሃ አዕኑ ሚሃት አቴነንታት?» ይቶኡ።<verse eid="LUK 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3"/>ጠው እኮጎሬ ኢስ «ደዉዴለከ እሲን ሜጡበ ሄኦ መኑ ጎሩ አፎሰ ወክት አዕዮሀ<note caller="-" style="x"><char style="xo" closed="false">6፥3 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 ሳሙ. 21፥1-6</ref>።</char></note> <verse eid="LUK 6:3"/><verse number="4" style="v" sid="LUK 6:4"/>ሁኩንን እስ ዱእ ምኒ ኣግ ቂስ ቤሉ ዎሉ መኑ እቱ ፈቀደሞበእ ክትም ዳቡተ ኬሽ እቱስለከ እሲን ሜጡበ ሄኦ መኒሃ ኣሴገ አነበቤንታበእንዶ?» ይ ፈንቀሼእ።<note caller="-" style="x"><char style="xo" closed="false">6፥4 </char><char style="xt" closed="false"><ref loc="LEV 24:9">ሌዌ 24፥9</ref>።</char></note><verse eid="LUK 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 6:5"/>ህትን እስ «መንች ቤቱ አበ በሬተ ቀርቹሃን» ዬሰ።<verse eid="LUK 6:5"/></para>
  <para style="s1">አንገተ ናፈ መንቹ ኢስ ፈይሱስ</para>
  <para style="r">(<ref loc="MAT 12:9-14">ማቶ. 12፥9-14</ref>፤ <ref loc="MRK 3:1-6">ማር. 3፥1-6</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6"/>ዎሎ አበ በሬን ኢስ ጭምት ምኒ ኣግ ተማርሰኖት እቅ፤ ህከንቤቾንን መኬስ አንገተ ናፎ መንቹ ሄዕዮ እቅ። <verse eid="LUK 6:6"/><verse number="7" style="v" sid="LUK 6:7"/>ሕግ አስተማረትለከ ፈርሳዉያኑት ኢሰ ከሰሶተ ወንጀል ደጎተ አበ በሬን ፈይሰኖ ጎሬ ለዕናም ይት አገርታ እቅ። <verse eid="LUK 6:7"/><verse number="8" style="v" sid="LUK 6:8"/>ጠዉ እኮጎሬ ኢስ ቀልብሰ ጠወ ደግ አንገተ ናፈ መንቹ «ኬእ መን በላን ኡር» ዬስ፤ ኬዕይን ኡሬእ። <verse eid="LUK 6:8"/><verse number="9" style="v" sid="LUK 6:9"/>ኢስን «ህንዴ መት ጠዕምቱተ ጠዕማንክዕኔ፤ አበ በሬን ጡመ ጠወ አኡሃንዶ ሂለ ጠወ አኡሃን ፈቀደመኖሁ? ነብሳሃ ጡምሱሃንዶ ህከረንገ ቤሱሃን?» ዬሰ። <verse eid="LUK 6:9"/><verse number="10" style="v" sid="LUK 6:10"/>እስን ጉዕመንከሰ ዘህ ለዕዮች ኤተሮን አንገተ ናፈ መንቹ «አንገክ ሂር» ዬስ፤ ሁኩ መንቹንኩ አንገስ ሂሮ ወክት አንገንትስ ፈየተ እኮኡ።<verse eid="LUK 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 6:11"/>ጠዉ እኮጎሬ ሕግ አስተማረትለከ ፈርሳዉያኑ እሰን ኡሙዕርት «ከ ኢሰ መ አዕኑ?» ይት አማዕለንቶኡ።<verse eid="LUK 6:11"/></para>
  <para style="s1">ኢስ ቶነ ለሙ አሳበተ መጠሩስ</para>
  <para style="r">(<ref loc="MAT 10:1-4">ማቶ. 10፥1-4</ref>፤ <ref loc="MRK 3:13-19">ማር. 3፥13-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12"/>ህከ ወክት ኢስ ዱአ አኦተ ቆተ አል ፉል ኬዕይ ዊመ ሀንከዕርተ ዱአ አአን ገሎ። <verse eid="LUK 6:12"/><verse number="13" style="v" sid="LUK 6:13"/>ኡለት ሶዞ ወክት አሳበስ እስበ ገእ እሳችን ቶና ለሙ መጠር «አሳበተ» ይ ሱዕምሾሰ። <verse eid="LUK 6:13"/><verse number="14" style="v" sid="LUK 6:14"/>እሰን «ጴጥሮሴ» ይ ሱዕምሾ ስሞኔት፥ ስሞኔ አመቤቱ እንድርያሴት፥ ያቁባት፥ ያህይት፥ ፍልጶሴት፥ ቤርቶሎሜዎሴት፥ <verse eid="LUK 6:14"/><verse number="15" style="v" sid="LUK 6:15"/>ማቶሴት፥ ቶማሴት፥ እልፍዮሴ ቤቱ ያቁባት፥ ባዱስ ኢተኖ ስሞኔት፥ <verse eid="LUK 6:15"/><verse number="16" style="v" sid="LUK 6:16"/>ያቁብ ቤቱ ይሁዳትለከ ኢሰ ህግሽ ኣሴ አስቆሮንቶ ይሁዳት እቅ።<verse eid="LUK 6:16"/></para>
  <para style="s1">ኢስ ልግብ ኡመት ተማርሱስለከ ፈይሱስ</para>
  <para style="r">(<ref loc="MAT 4:23-25">ማቶ. 4፥23-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17"/>ኢስ አሳባንን ሜጡበ ቆታች ድር ባዳን ልግቤ ኡመቲን ኡሬእ፤ ሁኩ ኡመቱንኩ ሞጮጭቶተለከ ጥዘናችሰ ፈይቶተ ይሁድ ባዲች ጉዕሚች ዬሩሳሌም ከተሚችለከ ባር መዴን ሄዕዮ ጢሮስለከ ስዶን ከተሚች አሜቶእራ እቅ። <verse eid="LUK 6:17"/><verse number="18" style="v" sid="LUK 6:18"/>ዶሮረኖ አያኑ አፋንሰ ኦርጨቀንተን ሄኦእሩ ፈይቶኡ። <verse eid="LUK 6:18"/><verse number="19" style="v" sid="LUK 6:19"/>ኢሲችን ወልቀት ፉልታን ጉዕመንከ ፈይሰኖቤቺሃ መኑ ጉዕሙንኩ እሱ ኡሎተ ሀሰኖት እቅ።<verse eid="LUK 6:19"/></para>
  <para style="s1">ሙንዲኖለከ ሻዘነ መላተ</para>
  <para style="r">(<ref loc="MAT 5:1-12">ማቶ. 5፥1-12</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20"/>ኢስን አሳበስ ለአን «መገን ዎምነቱ» ክዕኔሃ እኮቤቺሃ አዕኑ ቡጥቻኑት ማሰአንቴንታእራን። <verse eid="LUK 6:20"/><verse number="21" style="v" sid="LUK 6:21"/>አዕኑ ቴሱ ጎሩ አፎህዕኔሩ ዱቤነንተቤቺሃ ማሰአንቴንታእራን፤ ህትን አዕኑ ቴሱ ኦኤነንተሩ ኦሰዕልቴነንተቤቺሃ ማሰአንቴንታእራን። <verse eid="LUK 6:21"/><verse number="22" style="v" sid="LUK 6:22"/>መንች ቤት መሳን መኑ ግቦህዕኔ ጎሬ፥ ያዬመህዕኔ ጎሬ፥ ህንቄመህዕኔ ጎሬ፥ ሱዕመክዕኔ ሂልማን አፌመህዕኔ ጎሬ ማሰአንቴንታእራን። <verse eid="LUK 6:22"/><verse number="23" style="v" sid="LUK 6:23"/>ዋጉክዕኔ ሰማን ሎረ እኮቤቺሃ ሁኩን ኢለኖህዕኔ ወክት ሙንዲኖን ተሽ ዩንክዕኔ፤ አናኑሰን ከኒች ብርንተ ነብያኑተ ህት አቶእራን።<note caller="-" style="x"><char style="xo" closed="false">6፥23 </char><char style="xt" closed="false"><ref loc="2CH 36:16">2 ዱዱ. 36፥16</ref>፤ <ref loc="ACT 7:52">ሶቀ. 7፥52</ref>።</char></note><verse eid="LUK 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 6:24"/>ጠዉ እኮጎሬ «አዕኑ ቀባጣመት» መከኖህዕኔርቹ ጉዕመንከ ደእቴነንተቤቺሃ</para>
  <para style="q2" vid="LUK 6:24">ቆሃኖህዕኔ!<verse eid="LUK 6:24"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="25" style="v" sid="LUK 6:25"/>ህትን «አዕኑ ቴሱ ዱቤንተሩ»</para>
  <para style="q2" vid="LUK 6:25">ጎሩ አፈኖህዕኔቤቺሃ ክዕኔሃ ቆሃኖህዕኔ!</para>
  <para style="q1" vid="LUK 6:25">ህትን «አዕኑ ቴሱ ኦሰዕልቴነንተሩ»</para>
  <para style="q2" vid="LUK 6:25">ሻዜነንተቤቺሃለከ ኦኤነንተቤቺሃ ክዕኔሃ ቆሃኖህዕኔ!<verse eid="LUK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 6:26"/>መኑ ጉዕሙንኩ ጡመ ዱዱቡ ክዕኔተኔሃ ዱዱብሴህዕኔጎሬ ቆሃኖህዕኔ! አናኑሰን ክዝበኛኑተ ነብያኑተ ህት አቶእራን ዬእ።<verse eid="LUK 6:26"/></para>
  <para style="s1">ዲነ ኢቱ</para>
  <para style="r">(<ref loc="MAT 5:38-48">ማቶ. 5፥38-48</ref>፤ <ref loc="MAT 7:12">7፥12</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27"/>ኢስ «አን ክዕኔሃ ሞጮጭቴነንተኤሀኑኡተ ያንክዕኔ፤ ዲነክዕኔ ኢትዬ፤ ግባህዕኔሀኑኡሃ ጡመ አዕዬ፤ <verse eid="LUK 6:27"/><verse number="28" style="v" sid="LUK 6:28"/>ቦሮርታህዕኔረ ማሰዕዬ፤ ቤሶህዕኔሀኑኡተ ዱአ አዕዬ፤ <verse eid="LUK 6:28"/><verse number="29" style="v" sid="LUK 6:29"/>መጫለክ ዎቀረኖሀኒሃ ለንክ እሱ ኣስስ፤ ነጠለክ ኣአኖሀኒሃ ሹራበክ በርግት ኣስ፤ <verse eid="LUK 6:29"/><verse number="30" style="v" sid="LUK 6:30"/>ኡጨኖሄሀኒሃ ጉዕሚንከ ኣስ፤ ኪች ዱንያተ ኣኤ መንቹ ፈንቀሾሄተ ጠዕምቶትስ። <verse eid="LUK 6:30"/><verse number="31" style="v" sid="LUK 6:31"/>መኑ ክዕኔሃ አኦተ ሀሴነንታሃ አዕኑሁ ህትን አዕዬ» ያንክዕኔ።<note caller="-" style="x"><char style="xo" closed="false">6፥31 </char><char style="xt" closed="false"><ref loc="MAT 7:12">ማቶ. 7፥12</ref>።</char></note><verse eid="LUK 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32"/>ኢትታህዕኔረ ኢትቴንተ ጎሬ መ ደግለለኖህዕኔ? መሰንትስ ጩበኛኑት ኢትታሰረ ኢትታአ። <verse eid="LUK 6:32"/><verse number="33" style="v" sid="LUK 6:33"/>ህትን ጡመ አታህዕኔሀኑኡተ ጡመ አቴንተጎሬ መ ደግለለኖህዕኔ? ጩበኛኑቲ ህካን አታአ። <verse eid="LUK 6:33"/><verse number="34" style="v" sid="LUK 6:34"/>ፈንቀሽቴን አእቶኖተ ተቢሳ አቴነንተሀኑኡተ ሌቄሴንተ ጎሬ ም ገለቱ ዮህዕኔ? ሌቄሶ ብከ ፈንቀሽት ኣእቶተ ጩበኛኑቲ ጩበኛኖተ ሌቄሳአ። <verse eid="LUK 6:34"/><verse number="35" style="v" sid="LUK 6:35"/>ጠዉ እኮጎሬ ገለትጭትበሀኑኡተ ገዉሰ ኢትታሀኑኡተ መገኑ መረርሲጫንቹ እኮቤቺሃ ዲነክኔ ኢትዬ፤ ጡመ አዕዬ፤ መቱርቹሃ ፈንቀሽቴን ኣእቶኖተ ተቢሳ አቶኑዕነ ሌቄሼ፤ ህከኒሃ አጅሩክዕኔ ሎረ እሀኖ፤ ጉዕሚችን ሎረ መገን እለተ እኬነንተ። <verse eid="LUK 6:35"/><verse number="36" style="v" sid="LUK 6:36"/>ሰሜ አኑክዕኔ መረርሲጫንቹ እኮገን አዕኑሁ መረርሲጫኑተ እኬ ዬእ።<verse eid="LUK 6:36"/></para>
  <para style="s1">ዎሎ መን አሌን ፈረዱ ገበኢባሃ እሁስ</para>
  <para style="r">(<ref loc="MAT 7:1-5">ማቶ. 7፥1-5</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37"/>ኢስ «ፈረዶኖቼ ፈረደመኖህዕኔበአ፤ ዎሉ መነ ዋሃኦኖቼ ዋሃኣንቴነተበአ፤ ‹ማሮንስ› ይዬ አጉረመኖህዕኔ። <verse eid="LUK 6:37"/><verse number="38" style="v" sid="LUK 6:38"/>ኣስዬ ኣሰመኖህዕኔ፤ ጡመ ብካንቾን ጢቤን ቱጉሜን ብኬናን በተዕይ ደፈፍ ይዮኢሁ ኣሰመኖህዕኔ፤ መሰንትስ ብክቴንተ ኦዳኒን ብከመኖህዕኔ» ዬእ።<verse eid="LUK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39"/>ኢስ ምሳሌኒን «ቆቁ መንቹ ቆቀ መንቹ አዎንሶተ አታለኖንዶ? ህካን አዕዮ ጎሬ ለሙንኩሰ ኤሎን ኡባበዕንዶ?<note caller="-" style="x"><char style="xo" closed="false">6፥39 </char><char style="xt" closed="false"><ref loc="MAT 15:14">ማቶ. 15፥14</ref>።</char></note> <verse eid="LUK 6:39"/><verse number="40" style="v" sid="LUK 6:40"/>ተማረኖሁ ተማርሰኖሀኒች በተአኖበአ፤ ጠዉ እኮጎሬ አዪሁ ጠረኝ ተማሮ ጎሬ አስተማርችስገን እሀኖ።<note caller="-" style="x"><char style="xo" closed="false">6፥40 </char><char style="xt" closed="false"><ref loc="MAT 10:24-25">ማቶ. 10፥24-25</ref>፤ <ref loc="JHN 13:16">ያህ. 13፥16</ref>፤ <ref loc="JHN 15:20">15፥20</ref>።</char></note><verse eid="LUK 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41"/>«ገይክ እሌን ሎሩ ሁሩ ሄዕዮገን ጃልክ እሌን ዮ ሁረ ሚሃ ለአን? <verse eid="LUK 6:41"/><verse number="42" style="v" sid="LUK 6:42"/>አት ገይክ እሌን ዮ ሎረ ሁረ ለኡዕናን ሀት ጃልሃክ ‹ኢ ጃላ እሌክ ዮ ሁረ ፉሻም› ይቶተ ሀት አታልተን? ኩ ገዉክ ሎርስታንቲሁ! ሄጭት ገይክ እሌች ሁረ ፉሽ፤ ህከኒች ኤተሮን ጃልክ እሌች ሁረ ፉሽቶተ አጥረመት ለኦተ አታልታንት» ዬሰ።<verse eid="LUK 6:42"/></para>
  <para style="s1">ሀቁ ላልቺንከስ ደገመኖ</para>
  <para style="r">(<ref loc="MAT 7:16-20">ማቶ. 7፥16-20</ref>፤ <ref loc="MAT 12:33-35">12፥33-35</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43"/>ኢስ «ጡሙ ሀቁ ሂለ ላልቹ ህከረንገ ሂሉ ሀቁ ጡመ ላልቹ ሆሮ ላለኖበአ። <verse eid="LUK 6:43"/><verse number="44" style="v" sid="LUK 6:44"/>ህካን እኮቤቺሃ ሀቁ ጉዕሙንኩ ላልቺንከስ ደገመኖ፤ ኦዴቾ ላልቹ ኡቲች መጦኖተለከ ወይን ላልቹ ኡታሞ ሀቂች መጦኖተ አታሌኖበአ።<note caller="-" style="x"><char style="xo" closed="false">6፥44 </char><char style="xt" closed="false"><ref loc="LUK 12:33">12፥33</ref>።</char></note> <verse eid="LUK 6:44"/><verse number="45" style="v" sid="LUK 6:45"/>መኑ ቀልቤንከስ ዊም በተዕዮሃ አፌን ጠወአኖቤቺሃ ጡሙ መንቹ ጡመ ቀልቢችስ ጡመ ጠወ ፉሸኖ፤ ህትን ሂሉ መንቹ ሂለ ቀልቢችስ ሂለ ጠወ ፉሸኖ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">6፥45 </char><char style="xt" closed="false"><ref loc="MAT 12:34">ማቶ. 12፥34</ref>።</char></note><verse eid="LUK 6:45"/></para>
  <para style="s1">ክኖንለከ ሽፋር አሌን እጃረንቶ ምነተ</para>
  <para style="r">(<ref loc="MAT 7:24-27">ማቶ. 7፥24-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46"/>ኢስ «አን ኩላንክዕኔሃ አቴነንተበአ፤ ሚሃት ‹ቀርቾ! ቀርቾ!› ይቴነን ገእቴነንተኤሁ? <verse eid="LUK 6:46"/><verse number="47" style="v" sid="LUK 6:47"/>ኢ ቤቹ አሜተኖሁ ጉዕሙንኩ ላገኤ ሞጮጭ አአኖሁ አዪሁ መ አጉደኖ ጎሬ ለሊሳንክዕኔ። <verse eid="LUK 6:47"/><verse number="48" style="v" sid="LUK 6:48"/>ሁኩ መንቹ ምኒ እጃሮተ ጠረኝሽ ቀበበ እም ክን አሌን ምኒ ኤሎ እመኖ መንቹ አጉደኖ፤ ድርሱ አሜቾ ወክት ህከ ምን ሀንበሎ፤ ጠዉ እኮጎሬ ክን አሌን እጃረሞቤቺሃ ሌንቄቅሶተ አታሎበአ። <verse eid="LUK 6:48"/><verse number="49" style="v" sid="LUK 6:49"/>ላገኤ ሞጮጭ አእቡ መንቹ ምኒሀስ ቀበብ ኤሎሃ እሙዕናን ኡለ አሌን ምኒ እጃሮ መንቹ አጉደኖ፤ ህከ ምኒ ድርሱ ሀንበላን ወክትንከስ ኡቦ፤ ህከን ምኒ ኡቡንኩ ሂለ እኮ» ይ ኩሎሰ።<verse eid="LUK 6:49"/></para>
  <chapter eid="LUK 6"/>
  <chapter number="7" style="c" sid="LUK 7"/>
  <para style="s1">ኢስ ጥቤ ሀለቅች ካድንቹ ፈይሱስ</para>
  <para style="r">(<ref loc="MAT 8:5-13">ማቶ. 8፥5-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1"/>ኢስ መኑ ሞጮጨን ጠወዕይ ሹሎች ኤተሮን ቅፍርናሆም ከተመ ኦሮዕዮ። <verse eid="LUK 7:1"/><verse number="2" style="v" sid="LUK 7:2"/>ህከኔ መቱ ጥቤ ሀለቁንኩ ሄዕዮ እቅ፤ እሲንከ አበ ደግለለኖስ ካድንቹ ጥዥ ሬሆተ ሆንጠኮ እቅ። <verse eid="LUK 7:2"/><verse number="3" style="v" sid="LUK 7:3"/>ጥቤ ሀለቁንኩ ኢስተኔሃ ሞጮጬ ወክት አይሁድ ባልቃተ ኢስ አሜች ካድንቹኤ ፈይሶተ መርቴን ኡጭዬ ይ ሶኮሰ። <verse eid="LUK 7:3"/><verse number="4" style="v" sid="LUK 7:4"/>እሰን ኢስበ አሜቶ ወክት «ከ ጠወ አቶተ ሀስሰኖሃ መንቹ። <verse eid="LUK 7:4"/><verse number="5" style="v" sid="LUK 7:5"/>መሰንትስ ኩ መንቹ መነኔ ኢተኖሃን፤ ህትን ጭምት ምኒ እጃሮኔ» ይት ጠራኝስ ኡጭቶስ።<verse eid="LUK 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 7:6"/>ህካን እኮቤቺሃ ኢስን እሳን ሜጡበ ኦሮዕዮ፤ ጠው እኮጎሬ ምንስ ሆንጠኮ ወክት ጥቤ ሀለቁ ጃለስ «ቀርቾ! አት ኢ ምኒ ኣጎተ አን ገበእበ መንቹ እኮምቤቺሃ ኢቤቹ አሜቶተ ተርበ ይቶት። <verse eid="LUK 7:6"/><verse number="7" style="v" sid="LUK 7:7"/>ህካን እኮቤቺሃ አን ኪበ አሜቶተ ገበእበሃን፤ ጠዉ እኮጎሬ አት ላገክ ጠወኦንት ጎር ካድንቹኤ ፈየኖ። <verse eid="LUK 7:7"/><verse number="8" style="v" sid="LUK 7:8"/>አን ኢች በተኣ ሀለቃተኤ አዘዘመን ኢች ዎሮን አዘዛንሰ ወታደሩ ዮኤ፤ ህከኑኡችን መቱስ ‹መር› ዬም ጎሬ መረኖ፤ ዎሉስንገ ‹አም› ዬም ጎሬ አሜተኖ፤ ህትን ካድንቹኤ ‹ካን አእ› ዬም ጎሬ አአኖ» ይ ኢስቤቹ ሶኮ።<verse eid="LUK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9"/>ኢስ ህካን ሞጮጬ ወክት እስን አበ አጀብሲጭ አዎነን ሄዕዮ ልግብያ መንቤቹ ፈንቀል «አን ኩላንክዕኔ፤ እስራኤላን ህትኔ አመዕነቱ ሆሮን ለዕዮምበአ» ዬሰ።<verse eid="LUK 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 7:10"/>ሁኩ ሶሀንቶእሩ ምኒ ፈንቀልት አሜታ ወክት ካድንቹስ ፈይሃን ለኦኡ።<verse eid="LUK 7:10"/></para>
  <para style="s1">ምንሴ አኑ ሬዮ መንቾ ጩል</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11"/>ኢስ ለንክ በር አሳባንለከ ልግቤ መኒን ሜጡበ «ናይነ» ዬኖ ከተመ ኦሮዕዮ። <verse eid="LUK 7:11"/><verse number="12" style="v" sid="LUK 7:12"/>እስን ከተመ ኣጌኖ ኡሩተ ሆንጠኮ ወክት ጀናዘተ እጅቶ መኑ ከተሚች እጅት ፉልታኢት እቅ፤ እስን አማተስ ሜጥቹሃ ቤቱ እቅ፤ አመስን ምኒ አኑ ዮሴበእተ መንቹ እቅ፤ ህከን ከተም መኒች ልግቡ መኑ እሴን ሜጡበ ሄኦ እቅ። <verse eid="LUK 7:12"/><verse number="13" style="v" sid="LUK 7:13"/>ቀርቹንኩ ለዕዮሴ ወክት መረርሲጭሴ «ኦኦት» ዬሴ። <verse eid="LUK 7:13"/><verse number="14" style="v" sid="LUK 7:14"/>ኢስን ሆንጠክ ዴሰስ ኡሎ ወክት እጅቶእሩንኩ ኡርቶኡ፤ እስን «ወደልቾ! አን ኬሳሃ ያንኬ፤ ኬእ!» ዬእ። <verse eid="LUK 7:14"/><verse number="15" style="v" sid="LUK 7:15"/>ህከ ወክት ሁኩ ሬዮ ጩሉንኩ ጎበስ ኬሽ አፉዕል ጠወኡንከ ጀመሮ፤ ኢስን ህከ ወደልቹንከ አማተስ ኣሴእ።<verse eid="LUK 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16"/>ህካን እኮቤቺሃ ጉዕመንከሰ ባበነት አፋንሰ «ጠረኙ ነብዬቹ በላንከኔ ኬዕዮኡ፤ ህትን መገኑ መነ ጡምሶተ አሜቾኡ» ይተን መገኑ ገለትጭቶኡ።<verse eid="LUK 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 7:17"/>እስ ዱዱቡንኩ ይሁዳንለከ ህከን አዝጋጌን ዮ ባዶን ጉዕማንን ሞጮጨሞ።<verse eid="LUK 7:17"/></para>
  <para style="s1">ጠመቃንቾ ያህዪች ኢስበ ሶሀንቶ ሶቀማኑተ</para>
  <para style="r">(<ref loc="MAT 11:2-19">ማቶ. 11፥2-19</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18"/>ያህይ አዎናኑት ህካን ጉዕመንከ ዱዱብስቶስ። ህካን እኮቤቺሃ ያህይ አዎናኖችስ ለሙ እስቤቹ ገእ <verse eid="LUK 7:18"/><verse number="19" style="v" sid="LUK 7:19"/>«ሁኩ አሜተኖ ዬኖ መሲሁ አቴትንዶ ህከረንገ ዎሉ አገርኑ?» ይ ኢስቤቹ ሶኮሰ።<verse eid="LUK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20"/>እሰን ኢስቤቹ መርት «ጠመቃንቹ ያህይ ‹አሜታንት ዬኖ መሲሁ አቴትንዶ ህከረንገ ዎሉ አገርኑ?› ይ ኪቤቹ ሶኮኔ» ይቶኡ።<verse eid="LUK 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21"/>ህከ ወክት ኢስ ልግብ መነ አደደ ጥዘናች ፈይሾ፤ ህትን ዶሮረኖ ዱርሃ ፉሼእ፤ ልግብ ቆቆ መነ ለኣገ አዕዮ። <verse eid="LUK 7:21"/><verse number="22" style="v" sid="LUK 7:22"/>ኢስን ሶሀንት አሜቶእረ «መርቴን ያህይሃ ለኤንታሃለከ ሞጮጭቴንታሃ ሁኩንን ‹ቆቆ መኑ ለአኖት፤ ድኑ መኑ ሃመኖት፤ ጎግ አል ጥዘነት አፎሰሩ ፈይታኢት፤ ዶንቁ መኑ ሞጮጨኖት፤ ሬቶእሩ ሬሆች ኬኣኢት፤ ቡጥቻኖተ ተሽት ላገት ተማርሴኖት።<note caller="-" style="x"><char style="xo" closed="false">7፥22 </char><char style="xt" closed="false"><ref loc="ISA 35:5-6">ኢሳ. 35፥5-6</ref>፤ <ref loc="ISA 61:1">61፥1</ref>።</char></note> <verse eid="LUK 7:22"/><verse number="23" style="v" sid="LUK 7:23"/>ኢን ቆዕልባሁ ማሰአሞእሃን› ይቴን ኩሌስ» ይ ፈንቀሼሰ።<verse eid="LUK 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24"/>ያህይ አዎናኑት መርቶ ወክት ኢስ ህከን ልግቤ መኒሃ ያህይተኔሃ ጠወኡ ጀመሮ፤ እስን «መ ለኦኖታት ኡለ ኡድመ መርቴንታሁ? ቦብሩ ሌንቄቅሰኖ ሾምቦቁተ ለኦኖታትንዶ? <verse eid="LUK 7:24"/><verse number="25" style="v" sid="LUK 7:25"/>ህከረንገ መ ለኦኖተ ፉልቴን? ጡመ ኦድኑተ ኦደዕዮ መንቹ ለኦኖታትንዶ? ህትጎተበአ፤ ጡመ ኦድኑተ ኦደኦእሩ መኬሃንሰ ሄኣኢሁ ዎመ ምናኒት። <verse eid="LUK 7:25"/><verse number="26" style="v" sid="LUK 7:26"/>ህከረንገ መ ለኦኖተ መርቴን? ነብዬቹ ለኦኖታትንዶ? ህትጎተበአ! አን ኩላንክዕኔ፤ ነብዬቺች በተአኖሃ ለኢሃት። <verse eid="LUK 7:26"/><verse number="27" style="v" sid="LUK 7:27"/>‹ከለእ! ሄጭ ብርክ ሃመን ወቃክ ቅጥአአኖ ሶቀማንቹኤ ሶሃም› የመም እስተኔሃ ከተበሞሁ ከኒት።<note caller="-" style="x"><char style="xo" closed="false">7፥27 </char><char style="xt" closed="false"><ref loc="MAL 3:1">ሚል. 3፥1</ref>።</char></note> <verse eid="LUK 7:27"/><verse number="28" style="v" sid="LUK 7:28"/>አን ኩላንክዕኔ፤ ሜንቲች እለንቶሀኑኡ በላን ያህዪች በተአኖሁ አዪሁ ዮበአ፤ ጠዉ እኮጎሬ መገን ዎምነቴን ጉዕሚችን ሆፈአኖሁ ጉዕሚችን በተአኖ» ዬእ።<verse eid="LUK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29"/>ጉዕሙንኩ መኑለከ ቀረጠ ሙርታእሩ ህካን ሞጮጭቶ ወክት ያህዪን ጠመቀንቶእረ እኮቤቺሃ መገን ሆጉት ሀንቅ እሁስ ደጎኡ።<note caller="-" style="x"><char style="xo" closed="false">7፥29 </char><char style="xt" closed="false"><ref loc="MAT 21:32">ማቶ. 21፥32</ref>፤ <ref loc="LUK 3:12">ሉቃ. 3፥12</ref>።</char></note> <verse eid="LUK 7:29"/><verse number="30" style="v" sid="LUK 7:30"/>ጠዉ እኮጎሬ ፈርሳዊያኑትለከ ሕግ አስተማረት ያህዪን ጠመቀሙ ሆጎቤቺሃ መገን ሰውት ግቦኡ።<verse eid="LUK 7:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31"/>ኢስ «ከን ዘማን መነ ሚን አጉጣቀንሳንሰ? እሰንገ መ አጉዳአ? <verse eid="LUK 7:31"/><verse number="32" style="v" sid="LUK 7:32"/>ኩ መኑ ጌባን አፉዕልት መት-መቱሰ ገእተን ‹ሁሉሌተ ቡንሶንክዕኔ፤ አዕኑንገ አለጵቴንታበአ፤ ህትን ኦእሲንሳም ወክት ኦኡ ግቤንታአ› ይተን መት-መቲንከሰ ገአቀንታ ኦሱተ አጉዳአ። <verse eid="LUK 7:32"/><verse number="33" style="v" sid="LUK 7:33"/>ጠመቃንቹ ያህይ እቸተ እቱዕነለከ ወይነ ቦበጤማሃ አጉዕነ አሜቾረ ‹ዶሮረኖ ዱሩ ዮስ› ይቴንታአ። <verse eid="LUK 7:33"/><verse number="34" style="v" sid="LUK 7:34"/>መንች ቤቱ እተንለከ አገን አሜቾ እቃን ‹ቆኤቻማተ፥ ሰከርታሀኑኡሃ፥ ቀረጠ ሙርታሀኑኡተለከ ጩበኛኖተ ጃለ› ይቴነንተ። <verse eid="LUK 7:34"/><verse number="35" style="v" sid="LUK 7:35"/>ጠዉ እኮጎሬ መገን ሀይመት ሀንቅ እሁስ ደገመኖሁ እስ ሀይመተ አዎንታሀኑኡሃት» ዬሰ።<verse eid="LUK 7:35"/></para>
  <para style="s1">መትት መንቹት ኢስ ሎካን ሽቱተ ቡሩሴ</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36"/>ፈርሳውያኖች መቱ መንቹ ኢስ ምኔስ እቶተ ገኤሃን ህከን ፈርሳውች ምኒ ኣግ ዛበዕይ ማዳን አፉዕሌእ። <verse eid="LUK 7:36"/><verse number="37" style="v" sid="LUK 7:37"/>ህከን ከተማን መትት ጩበኘት ጫት ኢስ ፈርሳውች ምኔን ማዳን ዛበዕይ አፉዕሌኢሃ ደጎ ወክት ሽቱት ዊንቶ «አልባስጥሮሰ» ዬኖ ክኒች መክሴመ ብልቃጠ አፍ አሜቶኡ። <verse eid="LUK 7:37"/><verse number="38" style="v" sid="LUK 7:38"/>እሴን ኤተርስ አዲን ሎከስ መዴን ኡርት ኦአን እንጂጃሴ ሎከስ አሌን ዱንተንለከ ሙሚንከሴ ሎከስ ሺንሽተንለከ ሱንቅተን ሎከስ አሌን ሽቱተ ቡርቶኡ።<note caller="-" style="x"><char style="xo" closed="false">7፥38 </char><char style="xt" closed="false"><ref loc="MAT 26:7">ማቶ. 26፥7</ref>፤ <ref loc="MRK 14:3">ማር. 14፥3</ref>፤ <ref loc="JHN 12:3">ያህ. 12፥3</ref>።</char></note> <verse eid="LUK 7:38"/><verse number="39" style="v" sid="LUK 7:39"/>ህከ ወክት ኢሰ ገኤ ፈርሳውቹ ህካን ለዕዮ ወክት «ኩ መንቹ ነብዬቹ እኮ እቃን ካን አታስ ጫት ጩበኘተ እኮቤቺሃ ሃትናሜተ ጫ ጎሬ ደገኖ እቅ» ይ ቀልቤንከስ ሰውዬእ።<verse eid="LUK 7:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40"/>ኢስን «ስሞኔ! ጠወኣንኬ ጠዉ ዮኡ» ዬስ፤</para>
  <para style="p" vid="LUK 7:40">እስን «አስተማርቾ! መርቾሃን?» ይ ፈንቀሼስ።<verse eid="LUK 7:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41"/>ኢስን «መቶ መንቺች ብረ ሌቄጭቶ ለሙ መኑ ሄኦ እቅ፤ ህከኑኡችን መቱስ ኦንቴ ጥቤ ዲናረ ዎሉንገ ኦንታሁ ዲናረ ሌቄጭቶ እቅ። <verse eid="LUK 7:41"/><verse number="42" style="v" sid="LUK 7:42"/>እሰን ሌቄጭቶኢሃ ባቱ ሆጎ ወክት ሌቄሾ መንቹ ለምሰ ኤዳሃ ጌኝ አዕይ አጉሮ፤ ሌቄጭቶሀኑኡች ሀኩንስ በትሽ ኢተኖስ?» ዬእ።<verse eid="LUK 7:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43"/>ስሞንን «አበ ሌቃሃ አጉሬመሲሃ አጉደኖኤ» ይ ፈንቀሼእ፤ ኢስን «ሀንቅንከ ፈረዶንት» ይ ስሞኔሃ ጠወዕዮስ።<verse eid="LUK 7:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 7:44"/>ህከኒች ኤተሮን ኢስ ህተን ጫ አደ ፈንቀል ስሞኔ «ተ ጫተ ለኣንቲትንዶ? አን ምንክ ኣጎም ወክት አት ሎካተኤ ዋሃ ኣቶንቴኤበአ፤ ጠዉ እኮጎሬ እሴ እንጂጃንከሴ ሎከኤ ቁፍስ ሙሚንከሴ ሺንሽቶኡ። <verse eid="LUK 7:44"/><verse number="45" style="v" sid="LUK 7:45"/>ህትን አት ሱንቅቶንቴኤበአ፤ ጠዉ እኮጎሬ እሴ ምንክ ኣጎምሀኒች ኬሽ ሎከኤ ሱንቁ አጉርቶበአ። <verse eid="LUK 7:45"/><verse number="46" style="v" sid="LUK 7:46"/>አት ቡዕላንከኤ ሆሮ ዘህተሃ ቡርቶንቴኤበአ፤ ጠዉ እኮጎሬ እሴ ሎካንከኤ ሽቱተ ቡርቶኤ። <verse eid="LUK 7:46"/><verse number="47" style="v" sid="LUK 7:47"/>ህካን እኮቤቺሃ አን ያንኬ፤ በትስ ኢትቶቤቺሃ ልግቡ ጩቡሴ አጉረሞሴ፤ ጠዉ እኮጎሬ ቀው አጉረመኖሲሁ ቀው ኢተኖ» ዬስ፤<verse eid="LUK 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48"/>ኢስ ህተ ጫተ «ጩቡክ አጉረሞሄ» ዬሴ።<verse eid="LUK 7:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49"/>እሲን ሜጡበ ማዳን ሄኦእሩ «ኩ ጩብ ፈቁን ዮተ አታለኖሁ አዬት?» ዩ ጀመርቶኡ።<verse eid="LUK 7:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50"/>ጠዉ እኮጎሬ ኢስ ህተ ጫተ «አመዕነቱክ ፈይሾሄ፤ ወገሬቲን ኦሮእ» ዬሴ።<verse eid="LUK 7:50"/></para>
  <chapter eid="LUK 7"/>
  <chapter number="8" style="c" sid="LUK 8"/>
  <para style="s1">ኢስ አሳበተለከ ካደንተን ሄኦ ሜንቱ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1"/>ህከኒች ኤተሮን ኢስ መገን ዎምነት ተሽት ዱዱብሰን ከተማንለከ ኦሎን ጠወአን ህገኖ እቅ፤ ቶና ለሙንኩ አዎንተን ሄኦእሩ እሲን ሜጡበ ሄኦ እቅ። <verse eid="LUK 8:1"/><verse number="2" style="v" sid="LUK 8:2"/>ህትን ዶሮረኖ አያኑ ገፈሮሰሩለከ አደደ ጥዘናች ፈይቶ መት-መቱ ሜንቱ አዎንታሲት እቅ፤ እሰን ለመለ ሩሃንየንከ ፉሼመ «መግደል» መርየማት፥ <verse eid="LUK 8:2"/><verse number="3" style="v" sid="LUK 8:3"/>ሄሮድሴ ምኔን አዘዘን ሄዕዮ «ኩዘ» ዬኖ መንች ጫት ዮሃናቲ፥ «ሶስነ» ዬኖተንለከ ዎሉ ልግቡ ሜንቱ ሄኦ እቅ፤ እሰን ዱንያንከሰ ኢሰለከ አዎንታስረ ካደንታ እቅ።<note caller="-" style="x"><char style="xo" closed="false">8፥3 </char><char style="xt" closed="false"><ref loc="MAT 27:55-56">ማቶ. 27፥55-56</ref>፤ <ref loc="MRK 15:40-44">ማር. 15፥40-44</ref>፤ <ref loc="LUK 23:49">ሉቃ. 23፥49</ref>።</char></note><verse eid="LUK 8:3"/></para>
  <para style="s1">ዉጣንች ማቁተ</para>
  <para style="r">(<ref loc="MAT 13:1-9">ማቶ. 13፥1-9</ref>፤ <ref loc="MRK 4:1-9">ማር. 4፥1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4"/>ልግቡ መኑ ከተሚች ጉዕሚችን አሜች ጭምዬ ወክት ኢስ <verse eid="LUK 8:4"/><verse number="5" style="v" sid="LUK 8:5"/>«መቱ ዉጣንቹ ዜሬተ ዉጦተ ፉሎ፤ ዉጠንን መት-መቱ ዎቄ ገበላን ኡብ ሎካን ከደሞ፤ ህትን ሰሜ ጪኡት እቶስ። <verse eid="LUK 8:5"/><verse number="6" style="v" sid="LUK 8:6"/>ዎሉንገ ክን አሌን ኡብ ሙቾ፤ እኮጎሬ ቤቹስ ሙጥመት ዮስበእቤቺሃ ሞሎ። <verse eid="LUK 8:6"/><verse number="7" style="v" sid="LUK 8:7"/>ህትን መት-መቱስ ኡት ኣዜን ኡቦ፤ ኡቱንኩ እሲን ሜጡበ ነጵ ለንግ አፎስ። <verse eid="LUK 8:7"/><verse number="8" style="v" sid="LUK 8:8"/>ህትን መት-መቱ ጡመ ኡላን ኡብ ሙቾ፤ ነጴ ወክት ጥብተ ጥቤን አቶቾ» ይ ማቆን ኩሎሰ፤ ህካን ጠወዕይ ኬዕይ ላገስ ጎት አዕይ «ሞጮጭታ መጨት ዮሲሁ አዪሁ ሞጮጩን!» ዬእ።<verse eid="LUK 8:8"/></para>
  <para style="s1">ኢስ ምሳሌን ጠወዕዮ መሰት</para>
  <para style="r">(<ref loc="MAT 13:10-17">ማቶ. 13፥10-17</ref>፤ <ref loc="MRK 4:10-12">ማር. 4፥10-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9"/>አሳበስ ኢሰ «ከን ምሳሌ ፍሳረስ መርቹሃን?» ይት ጠዕምቶ ወክት <verse eid="LUK 8:9"/><verse number="10" style="v" sid="LUK 8:10"/>«ክዕኔሃ መገን ዎምነት ምስጥር ደጉ ኣሳሞህዕኔ፤ እኮጎሬ ዎሉ መኑ ለአን ቀልብ አትበገለከ ሞጮጭተን አጥራመትበገ ኩለመኖሳሁ ምሳሌኒት» ዬእ።<verse eid="LUK 8:10"/></para>
  <para style="s1">ዉጣንች ምሳሌ ፍሳረተ</para>
  <para style="r">(<ref loc="MAT 13:18-23">ማቶ. 13፥18-23</ref>፤ <ref loc="MRK 4:13-20">ማር. 4፥13-20</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11"/>ኢስ «ምሳሌስ ፍሳረት ከኒት፤ ዜሬቱ መገንተ ላገ። <verse eid="LUK 8:11"/><verse number="12" style="v" sid="LUK 8:12"/>ህትን ወቄ ገበላን ኡቦ ዜሬቱ ለሊሰኖሁ መገን ላገተ ወክቲሀስ ሞጮጨኖ መነሃት፤ ጠዉ እኮጎሬ አመዕንት ፈቅበገ እልቢሱ አሜች ሞጮጭቶ ላገተ ቀልብችሰ መሰኖ። <verse eid="LUK 8:12"/><verse number="13" style="v" sid="LUK 8:13"/>ክን አሌን ኡቦ ዜሬቱ ለሊሰኖሁ መገን ላገተ ሞጮጭታ ወክት ተሽቲን ቶጋእራን፤ እኮጎሬ እሰ አመዕንቶኢሁ ወክቲሃስት፤ ጠጱ ዮሰበእቤቺሃ ኦሪሸ ወክት ለገኣአ። <verse eid="LUK 8:13"/><verse number="14" style="v" sid="LUK 8:14"/>ህትን ኡት ኣዜን ኡቦ ዜሬቱ ለሊሰኖሁ መገን ላገተ ሞጮጨኖ መነሃት፤ እኮጎሬ ከ ኣዱንያ ጠወ ሰውዩ፥ ቀባጡትለከ ናጠቀሙ ለንግሃንሰ አቶቱዕናን ቆሸ እካአ። <verse eid="LUK 8:14"/><verse number="15" style="v" sid="LUK 8:15"/>ህትን ጡመ ኡላን ኡቦ ዜሬቱ ለሊሰኖሁ ጡመ መክዮ ቀልቢን መገን ላገተ ሞጮጭት ጠረኝት አገርታእረ፤ እሰን አታዕሊን አቶተ አቶታአ» ዬእ።<verse eid="LUK 8:15"/></para>
  <para style="s1">ዛሌ ኣዜን ዮ ኩራዝተኔሃ</para>
  <para style="r">(<ref loc="MRK 4:21-25">ማር. 4፥21-25</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16"/>ኢስ «አዪሁ ኩራዘ ቀሾች ኤተሮን ኦዳን እፍሽ አፉሸኖሁ ህከረንገ መቃጢች ዎሮን አፉሸኖሁ ዮበአ፤ ጠዉ እኮጎሬ ምኒ ኣገኖሀኒሃ ጉዕሚንከ ለሎተ ጎትዬ ቤቾን አፉሼኖ።<note caller="-" style="x"><char style="xo" closed="false">8፥16 </char><char style="xt" closed="false"><ref loc="MAT 5:15">ማቶ. 5፥15</ref>፤ <ref loc="LUK 11:33">ሉቃ. 11፥33</ref>።</char></note><verse eid="LUK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 8:17"/>«መሰንትስ ቴዕሌርቹ ደገሙዕነ ማጠሞርቹንኩ ለሉዕናን ፈቀኖበአ።<note caller="-" style="x"><char style="xo" closed="false">8፥17 </char><char style="xt" closed="false"><ref loc="MAT 10:26">ማቶ. 10፥26</ref>፤ <ref loc="LUK 12:2">ሉቃ. 12፥2</ref>።</char></note><verse eid="LUK 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 8:18"/>«ህካን እኮቤቺሃ ሀት እኬን ሞጮጭቴነንተ ጎሬ አገዕርዬ፤ መሰንትስ ዮስሀኒሃ በርገም ኣሰመኖስ፤ እኮጎሬ ዮስበእሀኒች ሁኩ ዮኤ ይ ሰውየኖንኩ ኣአመኖስ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">8፥18 </char><char style="xt" closed="false"><ref loc="MAT 25:29">ማቶ. 25፥29</ref>፤ <ref loc="LUK 19:26">ሉቃ. 19፥26</ref>።</char></note><verse eid="LUK 8:18"/></para>
  <para style="s1">ኢስ አመትለከ አመስኦሱት</para>
  <para style="r">(<ref loc="MAT 12:46-50">ማቶ. 12፥46-50</ref>፤ <ref loc="MRK 3:31-35">ማር. 3፥31-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19"/>ህከኒች ኤተሮን ኢስ አመትለከ አመስኦሱት እስቤቹ አሜቶኡ፤ እኮጎሬ መኑ በተዕዮቤቺሃ እሲን ደቀንቶተ አታልቶበአ። <verse eid="LUK 8:19"/><verse number="20" style="v" sid="LUK 8:20"/>ህካን እኮቤቺሃ «አመክለከ አመክ ኦሱት ደቀንቶሄተ ሀስ ኡሮን ኡርቶኡ» ዬን ኩሌመስ።<verse eid="LUK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21"/>ጠው እኮጎሬ እስ «መገን ላገተ ሞጮጭት አዘዘንታእሩ ጉዕሙንኩ አመተኤለከ አመኤተ ኦሱ» ዬሰ።<verse eid="LUK 8:21"/></para>
  <para style="s1">ኢስ ዊ ሁለ ኡርሱስ</para>
  <para style="r">(<ref loc="MAT 8:23-27">ማቶ. 8፥23-27</ref>፤ <ref loc="MRK 4:35-41">ማር. 4፥35-41</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22"/>መቱ በር ኢስ አሳባንከስን ሜጡበ ጀልባን ኣግ «ከን ባርች ዉድ አደ ቶልኖ» ዬሰ ወክት እሰን መርቶተ ኬኦኡ። <verse eid="LUK 8:22"/><verse number="23" style="v" sid="LUK 8:23"/>መርተን ሄኦገን ኢስ ግሾ፤ ዊ ሁሉንኩ ህከን ባር አሌን ኬዕይ ዉሁ ህከን ጀልባን ኣግ ዊሞተ እኮቤቺሃ ጨነቀንታኢት እቅ። <verse eid="LUK 8:23"/><verse number="24" style="v" sid="LUK 8:24"/>እሰን እስቤቹ መርት ግሰኛች ኬስ «ቀርቾ! ቀርቾ! ጎንፎታት» ይቶኡ፤ እስን ኬዕይ ቦብረለከ ዊ ሁለ ሻቆ ወክት ኡሬእ፤ አበንከ ጨለ ዬእ። <verse eid="LUK 8:24"/><verse number="25" style="v" sid="LUK 8:25"/>ኢስን «አመዕነቱክዕኔ ህንዴ?» ዬሰ፤ እሰን አበ አጀብሲጭትለከ ዋጅት መት-መቱሰ «ኩ ቦብረለከ ዋሃ አዘዘኖሁ ህትን እሰን አዘዘንታሲሁ ሀትናሙሃ መንቹ?» የቀንቶኡ።<verse eid="LUK 8:25"/></para>
  <para style="s1">ኢስ ዱሪን አፈንቶ መነ ፈይሱስ</para>
  <para style="r">(<ref loc="MAT 8:28-34">ማቶ. 8፥28-34</ref>፤ <ref loc="MRK 5:1-20">ማር. 5፥1-20</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26"/>ህከኒች ኤተሮን ገሊለ ዉድ አዲን ሄዕዮ «ጌርጌሴኖነ» ዬኖ ባዱ ኢልቶኡ። <verse eid="LUK 8:26"/><verse number="27" style="v" sid="LUK 8:27"/>ኢስ ጀልቢች ኡለተ ድሬገን ሩሃንዩ አፎስ መንቹ ከተሚች ፉል ህከኔ ደቀሞስ፤ እስን ልግብያ ወክቲች ኬሽ ኦድኑተ ኦደኡ አጉሮ እቅ፤ ህትን እስ ሄአኖሁ ምኔን እሁዕነ ሎድ ኣዜኒት እቅ። <verse eid="LUK 8:27"/><verse number="28" style="v" sid="LUK 8:28"/>እስን ኢሰ ለዕዮ ወክት ብሬንከስ ያር ኡብ ሎረ ላጋን «ጉዕሚችን ሎረ መገን ቤቶ ኢሰ! ኤሳለከ ኬሳሃ ም ደቀንሹ ዮኔ? ሀዕይ ኤገተክ ኦሪሶቴኤ» ዬእ። <verse eid="LUK 8:28"/><verse number="29" style="v" sid="LUK 8:29"/>ህካን ዬኢሁ ሁኩ ዶሮረኖ ዱሩ ህከን መንቺች ፉሎተ ኢስ ሻቆስቤቺሃት፤ መሰንትስ ከኒች ብርተ ልግብ ወክት አፎስቤቺሃ ሰንሰለቲንለከ ሎከ ብረቲን ኡሱሬን አገሬኖስ እቅ፤ ጠዉ እኮጎሬ ሰንሰለተ ተንቅሽ ሎከ ብረቲንከ ቢጭ ዶሮረኖ ዱሩ አዎንሰንስ ኡለ ኡድመ መሰኖስ እቅ።<verse eid="LUK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30"/>ኢስን «ሱዕሙክ አዬት?» ይ ጠዕሜስ፤ እስን ልግቡ ሩሃንዩ አሌስ ጭምዬቤቺሃ ሱዕሙኤ «ጎጎተሃን»<note caller="+" style="f"><char style="fqa" closed="false">ጎጎተ፦ </char><char style="ft" closed="false">ዩ ልግብ ዩሃን።</char></note> ይ ፈንቀሼስ። <verse eid="LUK 8:30"/><verse number="31" style="v" sid="LUK 8:31"/>ሁኩ ዶሮረኖ ዱሩ «ሀዕይ ጥዕላሸ በዋን ኣንጋምገ አቶትኔ» ይት ኡጭቶስ።<verse eid="LUK 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32"/>ህከን ቤቾን ቆተ መዴን ልግቡ ቦኬ መሰረት ዘግ ይቶ እቅ፤ ሁኩ ዶሮረኖ ዱሩንኩ «ህከን ቦኬ መሰራን ኣንጋምገ አእኔ» ይት ኢሰ ኡጭቶስ፤ እስን ኣጎተ ፈቀጆሰ። <verse eid="LUK 8:32"/><verse number="33" style="v" sid="LUK 8:33"/>ህከኒች ኤተሮን ሩሃንዩንኩ ህከ መንቹ ገፈር ቦኬን ኣጎ ወክት ቦኬ መሰረንት ሂለ ብከ ደጉደን ገርደብ አሊች ጨነቀንተን ድርት ባራን ኣአንቶኡ።<verse eid="LUK 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34"/>ቦኬ ዘማኑት እኮ ጠወ ለኦ ወክት ሁንት መርቶች ኤተሮን ከተማንለከ ገጠራን ጠወስ ዱዱብስቶኡ። <verse eid="LUK 8:34"/><verse number="35" style="v" sid="LUK 8:35"/>መኑንኩ እኮ ጠወ ለኦተ ምኒች ኢስቤቹ አሜቶኡ፤ ሩሃንዩ ፉሎስ መንቹ ቀልቡስ ፈንቀላን ኦድኑተ ኦደዕይ ኢስ ሎከስ ብሬን አፉዕሌኢሃ ለኦ ወክት ዋጅቶኡ። <verse eid="LUK 8:35"/><verse number="36" style="v" sid="LUK 8:36"/>ወክትስ ሄኦ መኑ ሩሃንዩ አፎስ መንቹ ሀት እክ ፈዬ ጎሬ ዱዱብስቶሰ። <verse eid="LUK 8:36"/><verse number="37" style="v" sid="LUK 8:37"/>ህከኒች ኤተሮን «ጌርጌሴኖነ» ዬኖ ቀኤን ሄዕዮ መኑ ጉዕሙንኩ አበ ዋጅቶቤቺሃ ኢስ እሰ ባዲች ኦሮኦተ ኡጭቶስ፤ ህካን እኮቤቺሃ ኢስ ጀልባን ኣግ ወዕና አሜቾ ባዱ ፈንቀል ኦሮዕዮ። <verse eid="LUK 8:37"/><verse number="38" style="v" sid="LUK 8:38"/>ሩሃንዩ ፉሎስ መንቹ ኢሰ አዎናንኬ ይ ኡጬስ፤ እኮጎሬ ኢስ ህርሲሽስ <verse eid="LUK 8:38"/><verse number="39" style="v" sid="LUK 8:39"/>«ምንክ ፈንቀልት መርት መገኑ አዕዮሄ ጠወ ጉዕመንከ ጠወእ» ዬስ፤ ሁኩ መንቹንኩ ኢስ አዕዮስ ጠወ ከተማን ጉዕማንን ጠወአን ኦሮዕዮ።<verse eid="LUK 8:39"/></para>
  <para style="s1">ኢያሮሴ ቤቱለከ ኢስ ኦድኑተ ኡልቶ መንቹተ</para>
  <para style="r">(<ref loc="MAT 9:18-26">ማቶ. 9፥18-26</ref>፤ <ref loc="MRK 5:21-43">ማር. 5፥21-43</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40"/>ኢስ ፈንቀል አሜቾ ወክት ልግቡ መኑ አገርቶስቤቺሃ ሙንዲኖን ቶጎስ። <verse eid="LUK 8:40"/><verse number="41" style="v" sid="LUK 8:41"/>ህከቤቹንከ ጭምት ምኒ ገሻንቹ «ኢያሮሴ» ዬኖ መቱ መንቹ አሜች ኢስ ሎከ አሌን ኡብ «ምኒኤ አም» ይ ኡጬስ። <verse eid="LUK 8:41"/><verse number="42" style="v" sid="LUK 8:42"/>ህካን ዬኢሁ ቶና ለሙ ዘማን እኮሴ መት ቤቱስ ጥዝ ሬቶተ ሆንጠኮቤቺሃት እቅ። ኢስን እሳን ሜጡበ መረን ሄዕዮገን አዎንተን ሄኦ መኑ ከን አዲንለከ ካጵ አዲን ረብ አፎስ እቅ። <verse eid="LUK 8:42"/><verse number="43" style="v" sid="LUK 8:43"/>ቶና ለሙ ዘማን ጉዕመንከ ቄጉ ዱንተአን ኦርጨቀንተን ሄኣ መት መንቹት ሄኦ እቅ፤ እሴን ዱንያሴ ጉዕመንከ ሀኪማን ሹልት አዪሁ ፈይሶሴተ አታሎበአ። <verse eid="LUK 8:43"/><verse number="44" style="v" sid="LUK 8:44"/>እሴን ኢስቤቹ ኤተርስ አዲን ሆንጠክ ኦድኖስ ሰኑተ ኡልቶኡ፤ ህከ ወክትንከ ቄግሴ ቡቁት ኡርቶኡ። <verse eid="LUK 8:44"/><verse number="45" style="v" sid="LUK 8:45"/>ኢስን «አዬት ኡሎኤሁ?» ይ ጠዕሜሰ። ጉዕሙንኩ መኑ «ኡልኖኬበኣ» ዬ ወክት ጴጥሮስለከ እሲን ሜጡበ ሄኦእሩ «አስተማርቾ! ኬንኩ መኑ ጉዕሙንኩ ሀንበዕለመን አዎነንኬ ለአን ‹አዬት ኡሎኤሁ› ይተንንዶ?» ይቶኡ። <verse eid="LUK 8:45"/><verse number="46" style="v" sid="LUK 8:46"/>ጠዉ እኮጎሬ ኢስን «ወልቀት ኢች ፉልቶገ ደጎምቤቺሃ መቱ መንቹ ኡሎኤ» ዬእ። <verse eid="LUK 8:46"/><verse number="47" style="v" sid="LUK 8:47"/>ህት መንቹንት ማጠሙ ሆጉሴ ደጎ ወክት ሁጠን ኢስቤቹ አሜት ሎከስ አሌን ኡብ ጉዕማንከ መን መዴን ሚሃ ኡልቶስጎሬለከ ህከ ወክት ሀት እክ ፈይቶጎሬ ኩልቶኡ። <verse eid="LUK 8:47"/><verse number="48" style="v" sid="LUK 8:48"/>ኢስን «ኢ ቤቶ፤ አመዕነቱክ ፈይሾሄ ወገሬቲን ኦሮእ» ዬሴ።<verse eid="LUK 8:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49"/>ኢስ ህካን ጠወአን ሄዕዮገን መቱ መንቹ ጭምት ምኒ ገሻንች ምኒች አሜች «ጩልክ ሬቶኡ፤ ህካን እኮቤቺሃ አስተማርቹ ጠለዕላን ሆግሶትስ» ዬእ።<verse eid="LUK 8:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50"/>ጠዉ እኮጎሬ ኢስ ህካን ሞጮጭ «ዋጅቶት፤ አመዕን ቤሉ፤ ጩልክ ፈይታአ» ዬስ።<verse eid="LUK 8:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51"/>ኢስ ኢያሮሴ ምኒ ኢሌ ወክት ጴጥሮሴች፥ ያህይች፥ ያቁቢች፥ ጩሌ አንለከ አመ ቤሉ ዎሉ መኑ ሜጡሁ እሲን ሜጡበ ምኒ ኣጎተ ፈቀጆበ እቅ። <verse eid="LUK 8:51"/><verse number="52" style="v" sid="LUK 8:52"/>ህከኔ ሄዕዮ መኑ ጉዕሙንኩ ጩሌተኔሃ «ኣዬ! ኣዬ!» ይተን ኦኣእት እቅ፤ ጠዉ እኮጎሬ ኢስ «ኦኦኖቼ፤ ጩልት ግሶ ቤሉ ሬቶበአ» ዬሰ።<verse eid="LUK 8:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53"/>እሰን ጩልት ሬሁሴ ደጎቤቺሃ ጉዕሙንኩ ቀለደን ኦሰዕልቶስ። <verse eid="LUK 8:53"/><verse number="54" style="v" sid="LUK 8:54"/>ጠዉ እኮጎሬ ኢስ ጩሌ አንገተ አፍ «ቴ ጩሌ ኬእ!» ዬሴ። <verse eid="LUK 8:54"/><verse number="55" style="v" sid="LUK 8:55"/>እሴን ሩሁሴ ፈንቀሎቤቺሃ ወክትንከስ ሾት ይት ኬኦኡ፤ ኢስን «እታኢሃ ኣስዬሴ» ዬእ። <verse eid="LUK 8:55"/><verse number="56" style="v" sid="LUK 8:56"/>ጩሌ አመትለከ አኑ አጀብሲጭቶኡ፤ ጠዉ እኮጎሬ እኮ ጠወ ሜጢሃ ጠወኦኖቼ ይ ኢስ አዘዦሰ።<verse eid="LUK 8:56"/></para>
  <chapter eid="LUK 8"/>
  <chapter number="9" style="c" sid="LUK 9"/>
  <para style="s1">ቶነ ለሙንኩ አሳበት ተማርሲሃ ሶሀሙሰ</para>
  <para style="r">(<ref loc="MAT 10:5-15">ማቶ. 10፥5-15</ref>፤ <ref loc="MRK 6:7-13">ማር. 6፥7-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1"/>ኢስ ቶና ለሙንከ አሳበተ ሜጡበ ገእ ሩሃንየ ፉሽቶተ፥ ጥዘነተ ጉዕመንከ ፈይሳ ወልቀተለከ ሹምነቱ ኣሴሰ። <verse eid="LUK 9:1"/><verse number="2" style="v" sid="LUK 9:2"/>ህት አዕይ መገን ዎምነቱ አሜቱስ መኒሃ ጉዕሚንከ ጠወኦተለከ ጥዘናመተ ፈይሶተ ሶኮሰ። <verse eid="LUK 9:2"/><verse number="3" style="v" sid="LUK 9:3"/>ህትን ዎቄሀክዕኔ «በርተሃ እኮ እቃ ከረጥትታ እኮ እቃ ሽንቅታ እኮ እቃ ብረሃ እኮ እቃ ዶዕርቶኖተ ኦድኑታ እኮ እቃ አፎኖቼ።<note caller="-" style="x"><char style="xo" closed="false">9፥3 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">ሉቃ. 10፥4-11</ref>፤ <ref loc="ACT 13:51">ሶቀ. 13፥51</ref>።</char></note> <verse eid="LUK 9:3"/><verse number="4" style="v" sid="LUK 9:4"/>ህትን ኮሀ እኬን ኣጌንተ ምኒች ፉልቴን መርቶኖተ ኢለ ህከን ምኔን አገሬ። <verse eid="LUK 9:4"/><verse number="5" style="v" sid="LUK 9:5"/>‹ሀበይ ወገሬቲን አሜቴን› ይ መኑ ቶግበህዕኔጎሬ ህከ ከተመ አጉርቴን ፉልቴነንተ ወክት እሳንከ እማኘ እሆተ ሎከክዕኔ ትበ ግግሽቴን ኦሮዕዬ» ዬሰ። <verse eid="LUK 9:5"/><verse number="6" style="v" sid="LUK 9:6"/>ህካን እኮቤቺሃ አሳበት ህከን አዲች ፉልት ተሽት ላገተ ተማርስተንለከ ጉዕመ ቤቾንን ጥዘናመተ ፈይሰን ቀዕያን ጉዕማንን ህጋ እቅ።<verse eid="LUK 9:6"/></para>
  <para style="s1">ኢስ ዱዱቡ ሄሮድስ ሞጮጩስ</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7"/>ገሊለ ባድ ገሻንቹ ሄሮድስ ኢስ አዕዮ ጠወ ሞጮጬ ወክት ዱዱቅ ዬስ፤ ህካን እኮሁ መት-መቱ መኑ «ጠመቃንቹ ያህይ ሬሆች ኬዕዮኡ» <verse eid="LUK 9:7"/><verse number="8" style="v" sid="LUK 9:8"/>ህትን መት-መቱ መኑ «እልያስ ፈንቀል አሜቾኡ» ይተን ዎሉሰንገ «ሄጭት ሄኦ ነቢያኖች መቱ ኬዕዮኡ» ይታቤቺሃት እቅ።<note caller="-" style="x"><char style="xo" closed="false">9፥8 </char><char style="xt" closed="false"><ref loc="MAT 16:14">ማቶ. 16፥14</ref>፤ <ref loc="MRK 8:28">ማር. 8፥28</ref>፤ <ref loc="LUK 9:19">ሉቃ. 9፥19</ref>።</char></note> <verse eid="LUK 9:8"/><verse number="9" style="v" sid="LUK 9:9"/>ሄሮድስን «ያህይ ቡዕለ ሙርሲሾም እቅ፤ ጠዉ እኮጎሬ እስተኔሃ ህትኔ ጠወ ሞጮጫሚሁ ኩን አዬት?» ዬእ፤ ለኦስተ ሀሰኖት እቄ።<note caller="-" style="x"><char style="xo" closed="false">9፥9 </char><char style="xt" closed="false"><ref loc="MAT 14:1-2">ማቶ. 14፥1-2</ref>፤ <ref loc="MRK 6:14-15">ማር. 6፥14-15</ref>፤ <ref loc="LUK 9:7-8">ሉቃ. 9፥7-8</ref>።</char></note><verse eid="LUK 9:9"/></para>
  <para style="s1">ኢስ ኦንቶ ኩሜ መኒሃ እትሱስ</para>
  <para style="r">(<ref loc="MAT 14:1-2">ማቶ. 14፥1-2</ref>፤ <ref loc="MRK 6:30-44">ማር. 6፥30-44</ref>፤ <ref loc="JHN 6:1-14">ያህ. 6፥1-14</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10"/>አሳበስ ሶሄመ አዲች ፈንቀልት አሜት አቶ ጠወ ጉዕመንከ ኢሲሃ ኩልቶኡ፤ እስን «ቤተ ሳይዳ» ዬኖ ከተማን ገበጭ ዬቤቹ ሜጥሃስ ኣእ ኦሮዕዮ። <verse eid="LUK 9:10"/><verse number="11" style="v" sid="LUK 9:11"/>ጠዉ እኮጎሬ ልግቡ መኑ ህካን ሞጮጬ ወክት አዎኞስ፤ እስን መነስ ቶግ መገን ዎምነትተኔሃ ተማርሴሰ፤ ጥዘናች ፈይቶተ አሜቶእረ ፈይሾሰ።<verse eid="LUK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12"/>ኡለት ሀዎርቶተ ሆንጠኮ ወክት ቶና ለሙንኩ አሳበስ ኢስቤቹ ሆንጠክ «ኩ ነኡ ዮም ቤቹ ኡድመ እኮቤቺሃ ከን ቀኤን ዮ ከተመለከ ገጠረ መርት ገልቶተለከ እታኢሃ ሀሶተ ከ መነ ህርሲስ» ይቶስ።<verse eid="LUK 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13"/>ጠዉ እኮጎሬ ኢስን «እታኢሃ አዕኑ ገዉንኩክዕኔ ኣስዬ» ዬ ወክት «ኔሳሃ ዮኔሁ ኦንቱሃ ጣብተለከ ጠለዕል ለሜተ ቁርጩሜ፤ መርን ከን ኡመቲሃ ጉዕሚንከ እካ እቸተ ህዕርን ኤምቦተ ሀሰንንዶ?» ይቶኡ። <verse eid="LUK 9:13"/><verse number="14" style="v" sid="LUK 9:14"/>ጎኑስ ኦንቶ ኩሜ ጌሰ እሀኖ እቅ። ኢስን አሳበስ «ኦንታሁ ኦንታሁ መት-መቶ ቤቾን እክ አፉዕለኖገ አዕዬ» ዬሰ።<verse eid="LUK 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 9:15"/>እሰን እስ አዕዬ ዬገ አት መኑ አፉዕለኖገ አቶኡ። <verse eid="LUK 9:15"/><verse number="16" style="v" sid="LUK 9:16"/>ህከኒች ኤተሮን ኢስ ኦንቱ ጣብተለከ ለም ቁርጩሜተ አፍ ሰማ ዋሽ ለዕይ ማሰዕይ ቢጭ መኒሃ አስናዶተ አሳባተስ ኣሴእ። <verse eid="LUK 9:16"/><verse number="17" style="v" sid="LUK 9:17"/>ጉዕሙንኩ እት ዱቦኡ፤ መኑ እተን ፈቆ ፉርፉሩ ቶና ለሙ መሶበ ዊመ አሳበስ ኬሶኡ።<verse eid="LUK 9:17"/></para>
  <para style="s1">ኢስ መሲህ እሁስ ጴጥሮስ ጠወዕዮገ</para>
  <para style="r">(<ref loc="MAT 16:13-19">ማቶ. 16፥13-19</ref>፤ <ref loc="MRK 8:27-29">ማር. 8፥27-29</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18"/>መቱ በር ኢስ ሜጥሀስ ዱአ አአን አሳበስ እሲን ሜጡበ ሄኦ እቅ፤ እስን «መኑ ኤሳሃ አዬት የኖኤሁ?» ይ ጠዕሜሰ።<verse eid="LUK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19"/>እሰን ፈንቀሽት «መት መቱ መኑ ‹ጠመቃንቾ ያህዪት› ዎሉስንገ ‹እልያሴት› ህትን ዎሉሰ ‹ሄጭት ሄኦ ነቢያካች መቱስ ኬዕዮኡ› ይታኢት» ይቶኡ።<verse eid="LUK 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20"/>እስን አዕኑንገ «ኤሳሃ አዬት ይቴነንታት?» ይ ጠዕሜሰ፤ ጴጥሮስን «አት መገኑ መጠሮሄ መሲህ ኢሳት» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">9፥20 </char><char style="xt" closed="false"><ref loc="JHN 6:68-69">ያህ. 6፥68-69</ref>።</char></note><verse eid="LUK 9:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21"/>ኢስን ከ ጠወ አዬሃ ጠወኣበእገ ጠረኝሽ ኩሎሰ።<verse eid="LUK 9:21"/></para>
  <para style="s1">ኢሰ አዎንተኔሃ</para>
  <para style="r">(<ref loc="MAT 10:38-39">ማቶ. 10፥38-39</ref>፤ <ref loc="MAT 16:24-28">16፥24-28</ref>፤ <ref loc="MRK 8:34-38">ማር. 8፥34-38</ref>፤ <ref loc="LUK 14:25-27">ሉቃ. 14፥25-27</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 9:22"/>ኢስን «መንች ቤቱ ልግብ ኦሪሸተ ቶጎተ ባልቃን፥ ቂስ አዎንሳኖንለከ ሕግ አስተማራን ግበሞተ፥ ሬሆተለከ ሰቅ በሬን ሬሆች ኬአኖ» ይ ጠረኝሽ አዘዦሰ።<verse eid="LUK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23"/>ኢስን ጉዕሚንከሰ «አዪሁ ኤሰ አዎኖተ ሀሰኖኤሁ ገዉስ ለገዕይ በሬን በሬን መስቀለስ እጅ አዎኑዕኔ።<note caller="-" style="x"><char style="xo" closed="false">9፥23 </char><char style="xt" closed="false"><ref loc="MAT 10:38">ማቶ. 10፥38</ref>፤ <ref loc="LUK 14:27">ሉቃ. 14፥27</ref>።</char></note> <verse eid="LUK 9:23"/><verse number="24" style="v" sid="LUK 9:24"/>ነብሳስ ፌሶተ ሀሰኖሁ ጉዕሙንኩ ነብሳስ ቤሰኖ፤ ጠው እኮጎሬ ኢተኔሃ ነብሳስ ቤሰኖሁ ጉዕሙንኩ ነብሳስ ጡምሰኖ።<note caller="-" style="x"><char style="xo" closed="false">9፥24 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቶ. 10፥39</ref>፤ <ref loc="LUK 17:33">ሉቃ. 17፥33</ref>፤ <ref loc="JHN 12:5">ያህ. 12፥5</ref>።</char></note> <verse eid="LUK 9:24"/><verse number="25" style="v" sid="LUK 9:25"/>መቱ መንቹ ከን ኣዱንያ ቀባጡተ ጉዕመንከ ደእ ነብሳስ ቤሾ ጎሬ መ ደግለለኖስ? <verse eid="LUK 9:25"/><verse number="26" style="v" sid="LUK 9:26"/>ህትን አዪሁ ኤሳንለከ ኢ ላጋን ሙሌ ጎሬ መንች ቤቱ ገይስ ኬዕምኚን፥ አንስ ኬዕምኚንለከ ጠሊላኖ መላይከ ኬዕምኚን አሜተኖ ወክት ህከኒን ሙለኖ። <verse eid="LUK 9:26"/><verse number="27" style="v" sid="LUK 9:27"/>ጠው እኮጎሬ ሀንቅስ ኩላንክዕኔ፤ ከኔ ኡርቶሀኑኡች መት-መቱ መገን ዎምነቱ ለኡዕናን ሄጭት ሬትበሩ ዮኡ» ዬሰ።<verse eid="LUK 9:27"/></para>
  <para style="s1">ኢስ ደኑ ዶራሙስ</para>
  <para style="r">(<ref loc="MAT 17:1-8">ማቶ. 17፥1-8</ref>፤ <ref loc="MRK 9:2-8">ማር. 9፥2-8</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28"/>ኢስ ህከ ጠወ ጠወዕዮ ህዜቱ በር እኮች ኤተሮን ጴጥሮሴ፥ ያህይለከ ያቁበ ሜጡበ አዕይ ዱአ አኦተ መቴ ቆተ አል ፉሎ። <verse eid="LUK 9:28"/><verse number="29" style="v" sid="LUK 9:29"/>ዱአ አአንን ሚኔስ ደኑ ዶረሞ፤ ህትን ኦድኑስ ዋጀእ በለቆኡ። <verse eid="LUK 9:29"/><verse number="30" style="v" sid="LUK 9:30"/>ህከ ወክት ለሙ መኑ አሜት እሲን ጠወኣኢት እቅ፤ እሰን ሙሳትለከ እልያሴት እቅ። <verse eid="LUK 9:30"/><verse number="31" style="v" sid="LUK 9:31"/>ኬዕምኝን ለሊት ጠወአን ሄኦ ጠዉንኩ ኢስ ዬሩሳሌም ከተማን መገን ሃሽኣቱተ ሬሆንከስ ዊንሸኖ ወቄሃት እቅ። <verse eid="LUK 9:31"/><verse number="32" style="v" sid="LUK 9:32"/>ጠው እኮጎሬ ጴጥሮሴለከ እሲን ሜጡበ ሄኦእራ ግሰኛት ቄልቶሰ እቅ፤ እሰን ግሰኛች ኬኦ ወክት ኢስ ኬዕምኝለከ እሲን ሜጡበ ኡርቶ ለም መናከተ ለኦኡ። <verse eid="LUK 9:32"/><verse number="33" style="v" sid="LUK 9:33"/>ለም መናከንት ኢሲች አደ እክ መርተንን ጴጥሮስ ኢሰ «አስተማርቾ! ከኔ እሁ ኔሳሃ ጡመ እኮቤቺሃ ሰሱ ዳሰ መቱ ኬሳሃ መቱ ሙሲሃ መቱንገ እልያሴሃ እጃርኖ» ዬስ፤ ጠው እኮጎሬ ጠወአኖርቹ መሃጎሬ ደጎበ እቅ።<verse eid="LUK 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 9:34"/>ጴጥሮስ ከ ጠወ ጠወአን ጎመት አሜት ቴልቶኡ፤ ጎመት ቴልቶሰ ወክት ዋጅቶኡ። <verse eid="LUK 9:34"/><verse number="35" style="v" sid="LUK 9:35"/>ህትን ህከን ጎመ ኣዚች «መጠሮም ቤቱኤ ከኒት፤ እሱ ሞጮጭዬ!» ይታ ላገት አሜቶኡ።<note caller="-" style="x"><char style="xo" closed="false">9፥35 </char><char style="xt" closed="false"><ref loc="ISA 42:1">ኢሳ. 42፥1</ref>፤ <ref loc="MAT 3:17">ማቶ. 3፥17</ref>፤ <ref loc="MAT 12:18">12፥18</ref>፤ <ref loc="MRK 1:11">ማር. 1፥11</ref>፤ <ref loc="LUK 3:22">ሉቃ. 3፥22</ref>።</char></note><verse eid="LUK 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 9:36"/>ህት ላገት ጠወአንቶሀኒች ኤተሮን ኢስ ሜጥሀስ እክ ደገሞ፤ ህትን እሰ ለኦ ጠዊች መቱርቹሃ ህከን ወክቴን አዬሃ ጠወኡዕናን ጨለ ይቶኡ።<verse eid="LUK 9:36"/></para>
  <para style="s1">ኢስ ዶሮረኖ ዱሩ አፎ ጩል ፈይሱስ</para>
  <para style="r">(<ref loc="MAT 17:14-18">ማቶ. 17፥14-18</ref>፤ <ref loc="MRK 9:14-27">ማር. 9፥14-27</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37"/>ለንክስ በር እሰ ቆታች ድርቶ ወክት ልግቡ መኑ ኢስን ደቀንቶኡ። <verse eid="LUK 9:37"/><verse number="38" style="v" sid="LUK 9:38"/>ህከን መኒች መቱስ «አስተማርቾ! እስ ኤሳሃ ሜጥቹ ጩልኤ እኮቤቺሃ ፈይሶኤተ ኡጫንኬ። <verse eid="LUK 9:38"/><verse number="39" style="v" sid="LUK 9:39"/>እሱንከ ዶሮረኖ ዱሩ አፍ ድንገቴን ያርሲሰኖስ፤ ህትን ሁንብ ኩፍ አአንስ ከጣቀንሰኖስ፤ ጅስመስ ቁስ ፍትፍት አዕይ ጨነቅ ገፈረኖስ። <verse eid="LUK 9:39"/><verse number="40" style="v" sid="LUK 9:40"/>ህከ ዶሮረኖ ዱር ፉሽቶተ አዎንታሄረ ኡጭዮም እቅ፤ እኮጎሬ እሰ አታልቶበአ» ይ ያሮ።<verse eid="LUK 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41"/>ኢስን «ኩ ሂሉለከ አመዕነቱ ዮህዕኔበእ ከን ዘማን መኑ ሄንከ በር ኢለ ክዕኔን ሜጡበ ሄኣም? ህትን መ በር ኢለ አታላንክዕኔ? ህንዴ ቤቱክ ከበ ኤብ» ዬእ።<verse eid="LUK 9:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42"/>ጩሉንኩስ አሜተንን ሁኩ ዶሮረኖ ዱሩ ኡጅ ከጣቀንሴስ፤ ጠው እኮጎሬ ኢስ ህከ ዶሮረኖ ዱር ሻቅ ጩልንከስ ፈይሽ አኒሀስ ኣሴእ። <verse eid="LUK 9:42"/><verse number="43" style="v" sid="LUK 9:43"/>ህካን እኮቤቺሃ ኡመቱ ጉዕሙንኩ መገን ሎረ ወልቀተ ለኦቤቺሃ አጀብሲጭቶኡ፤ ጉዕሙንኩ ኢስ አዕዮ ጠዋን አጀብሲጨን ሄዕዮገን እስን አሳበስ <verse eid="LUK 9:43"/><verse number="44" style="v" sid="LUK 9:44"/>«መንች ቤቱ መን አንጋን ህግሰም ኣሰመኖቤቺሃ ከ ላገተ ሰውይቴን ሞጮጭዬ» ዬሰ። <verse eid="LUK 9:44"/><verse number="45" style="v" sid="LUK 9:45"/>ጠው እኮጎሬ ጠውስ አግበሰገ ቴለሞሰቤቺሃ ህከ ጠወ ደጎበአ እቅ፤ ህትን ህከን ጠዊንከ ጠዕምቶስተ ዋጅቶኡ።<verse eid="LUK 9:45"/></para>
  <para style="s1">ጉዕሚችኔ በተአኖሁ አዬት?</para>
  <para style="r">(<ref loc="MAT 18:1-5">ማቶ. 18፥1-5</ref>፤ <ref loc="MRK 9:3-37">ማር. 9፥3-37</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46"/>አሳበስ በላን «ኒች ጉዕሚችኔ በተአኖሁ አዬት?» ይታ ኦደት ኬኦኡ።<note caller="-" style="x"><char style="xo" closed="false">9፥46 </char><char style="xt" closed="false"><ref loc="LUK 22:24">ሉቃ. 22፥24</ref>።</char></note> <verse eid="LUK 9:46"/><verse number="47" style="v" sid="LUK 9:47"/>ጠዉ እኮጎሬ ኢስ ቀልብሰ ጠወ ደግ መቱ ጩል ኤብ መዴንከሰ ኡርሽ <verse eid="LUK 9:47"/><verse number="48" style="v" sid="LUK 9:48"/>«ከ ጩል ሱዕሚንከኤ ቶገኖሁ ጉዕሙንኩ ኤሳሃ ቶገኖ፤ ህትን ኤሳሃ ቶገኖሁ ጉዕሙንኩ ኤሳ ሶኮኤሃ ቶገኖ፤ መሰንትስ በላንከክዕኔ ጉዕሚችን ሆፈአኖሁ እስ ጉዕሚችክዕኔን ሎረሃን» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">9፥48 </char><char style="xt" closed="false"><ref loc="MAT 10:40">ማቶ. 10፥40</ref>፤ <ref loc="LUK 10:16">ሉቃ. 10፥16</ref>፤ <ref loc="JHN 13:20">ያህ. 13፥20</ref>።</char></note><verse eid="LUK 9:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49"/>ህከኒች ኤተሮን ያህይ «ቀርቾ! መቱ መንቹ ሱዕሚንከክ ሩሃንየ ፉሸን ለዕኖም፤ እኮጎሬ እስ ኒን ሜጡበ አዎንበሄሃ እኮቤቺሃ ከሞንስ» ዬእ።<verse eid="LUK 9:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50"/>ጠዉ እኮጎሬ ኢስን «ኦደምበህዕኔሁ ጉዕሙንኩ ክዕኔሃ እኮቤቺሃ ከንቶኖቼስ» ዬእ።<verse eid="LUK 9:50"/></para>
  <para style="s1">ሰማር ባድ መኑ ኢሰ ቶጉ ግቡሰ</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51"/>ኢስ ሰማ ኦሮአኖ ወክቱ ሆንጠካን ዬሩሳሌመ ኦሮኦተ ሙርሲጭ ኬዕዮ። <verse eid="LUK 9:51"/><verse number="52" style="v" sid="LUK 9:52"/>እሲች ሄጭት መርታ አሳበተ ሶካን እሰን ጉዕመርቹንከ ቅጥአቶተ «ሰማርያ» ዬኖ ባዶን ዮ መት ቀዕየተ መርቶኡ። <verse eid="LUK 9:52"/><verse number="53" style="v" sid="LUK 9:53"/>ጠው እኮጎሬ ህከን ቀዕየ መኑ ኢስ ህከኒን ህግ ዬሩሳሌመ መረኖገ ደጎቤቺሃ ቶጎስተ ሀሶበአ። <verse eid="LUK 9:53"/><verse number="54" style="v" sid="LUK 9:54"/>አሳበስ ያቁብለከ ያህይ ህካን ለኦ ወክት «ቀርቾ! ሰሜች ጊረት ድርት ከ መነ ቡስቶተ<note caller="+" style="f"><char style="fqa" closed="false">ሰሜች ጊረት አሜት ቡስቶተ፦ </char><char style="ft" closed="false">የኖሃ «ኤልያስ አዕዮገን ሰሜች ጊረት አሜት ቡሶሰተ» ይታ ላገተ በርግታአ።</char></note> አዘንዞተ ሀሰንንዶ?» ይቶስ።<note caller="-" style="x"><char style="xo" closed="false">9፥54 </char><char style="xt" closed="false"><ref loc="2KI 1:9-16">2 ነገ. 1፥9-16</ref>።</char></note><verse eid="LUK 9:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 9:55"/>እስን ኤተሩ ፈንቀል ሻቆሰ። <verse eid="LUK 9:55"/><verse number="56" style="v" sid="LUK 9:56"/>ህከኒች ኤተሮን ዎልተ ቀዕየተ መርቶኡ።<note caller="+" style="f"><char style="ft" closed="false">መት-መቶ ኪታባን አዕኑ ሀትናሞ አያኒች እኬንተ ጎር ደጌነንተበአ፤ ጠዉ እኮጎሬ «መንች ቤቱ መን ነብሳሃ ፌሶታት ቤሉ ቤሶተ አሜቾበአ» የኖሁ መት-መቶ መጻፋን ዮበአ።</char></note><verse eid="LUK 9:56"/></para>
  <para style="s1">ኢስ አሳበ አሌን ኢልታሰ ኦርሸተ</para>
  <para style="r">(<ref loc="MAT 8:19-22">ማቶ. 8፥19-22</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57"/>ኢስለከ አሳበስ ዎቃን ሀንተንን መቱ መንቹ ኢሰ «መርታንትቤቹ ጉዕመንከ አዎናንኬ» ዬስ ወክት <verse eid="LUK 9:57"/><verse number="58" style="v" sid="LUK 9:58"/>ኢስን «ወለንጌሃ ኤሎ ዮሰ፤ ህትን ሰሜ ጭኦተ ጎዕምት ዮሰ፤ ጠው እኮጎሬ መንች ቤቲሃ ገዉስ ኣግሽ ፎሎሲሰኖ ቤቹ ዮስበአ» ዬስ።<verse eid="LUK 9:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59"/>ኢስ ዎሉ መንቹሃ «አዎኔኤ» ዬእ፤ ጠው እኮጎሬ መንቹስ «ቀርቾ! ሄጭ አነኤ ሞጎተ ፈቀዴኤ» ዬስ ወክት <verse eid="LUK 9:59"/><verse number="60" style="v" sid="LUK 9:60"/>ኢስ «ሬቶእሩ ሬሸሰ ሞጎተ አጉርሰ፤ ጠው እኮጎሬ አት መርት መገን ዎምነትተኔሃ ጠወእ» ዬስ።<verse eid="LUK 9:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61"/>ህትን ዎሉ መንቹ «ቀርቾ! አን አዎናንኬ፤ ጠው እኮጎሬ ሄጭ መር አበሮስኤ ‹ወገሬቲን ሄዕዬ› ዮተ ፈቀዴኤ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">9፥61 </char><char style="xt" closed="false"><ref loc="1KI 19:20">1 ነገ. 19፥20</ref>።</char></note><verse eid="LUK 9:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62"/>ኢስን «አቡሮተ ከዶ ወኝተ አንጋንከስ አፍ ኤተሩ ለአኖ መኑ ጉዕሙንኩ መገን ዎምነቲሃ በቀእበሃን» ዬስ።<verse eid="LUK 9:62"/></para>
  <chapter eid="LUK 9"/>
  <chapter number="10" style="c" sid="LUK 10"/>
  <para style="s1">ኢስ ለመላይኔ ለሙ አሳበተ ሶሁስ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1"/>ህከኒች ኤተሮን ቀርቹ ኢስ ለመላይኔ ለሙ<note caller="+" style="f"><char style="fqa" closed="false">ለመላይኔ ለሙ፦ </char><char style="ft" closed="false">የኖሃ መት-መቱ ሉህ ክታበት «ለመላዩ» ይታአ።</char></note> አሳበተ መጠር እስ መሮተ ሰውዬ ከተመለከ ጉዕመ ቤቹንከ ለም ለሙ አዕይ ሄጭት መርታገ ሶኮሰ። <verse eid="LUK 10:1"/><verse number="2" style="v" sid="LUK 10:2"/>እስን «አዝመሩስ ልግብሃን፤ እኮጎሬ ሆጉተ አታእሩ ቀዎሃን፤ ህካን እኮቤቺሃ ሆጎስ አኑ ሆጉተ አአኖ መነ ሶሆተ ኡጭዬ።<note caller="-" style="x"><char style="xo" closed="false">10፥2 </char><char style="xt" closed="false"><ref loc="MAT 9:37-38">ማቶ. 9፥37-38</ref>።</char></note> <verse eid="LUK 10:2"/><verse number="3" style="v" sid="LUK 10:3"/>ቴ መሬ! ሁኩዕኑን አን ሆለገ ኦሌ በላን ሶሃንክዕኔ።<note caller="-" style="x"><char style="xo" closed="false">10፥3 </char><char style="xt" closed="false"><ref loc="MAT 10:16">ማቶ. 10፥16</ref>።</char></note> <verse eid="LUK 10:3"/><verse number="4" style="v" sid="LUK 10:4"/>ወቄሀክዕኔ ቦርሰ ህከረንገ ከረጢትተ ህከረንገ ጫዕመተ አፎኖቼ፤ ህትን አዬኒ ዎቃን ጠውሲጨንቴነን ወክት ቤሶኖቼ።<note caller="-" style="x"><char style="xo" closed="false">10፥4 </char><char style="xt" closed="false"><ref loc="MAT 10:7-14">ማቶ. 10፥7-14</ref>፤ <ref loc="MRK 6:8-11">ማር. 6፥8-11</ref>፤ <ref loc="LUK 9:3-5">ሉቃ. 9፥3-5</ref>።</char></note> <verse eid="LUK 10:4"/><verse number="5" style="v" sid="LUK 10:5"/>ሀከ ምኒሃ ኣጌንተ ወክት ሄጭቴን ‹ወገሬቱ ከን ምኒሃ እሁን› ይዬ። <verse eid="LUK 10:5"/><verse number="6" style="v" sid="LUK 10:6"/>ህከንቤቾንን ወገሬት መንቹ ሄዕዮ ጎሬ ወገሬቱክዕኔ ህከን መንቾን እሀኖ፤ ዮበእ ጎሬ ወገሬቱክኔ ክዕኔቤቹ ፈንቀለኖ። <verse eid="LUK 10:6"/><verse number="7" style="v" sid="LUK 10:7"/>ሆጉተ አአኖ መንቺሃ ደሞዙ ሀስሰኖስ፤ ከን ሀሌንን አዕኑሁ ኣጌንተ ምኔን ሆንጠህሴመህዕኔሃ እቴነንለከ አጌነን ህከን ምኔን አገሬ ቤሉ መቶ ምኒች መቱ ምኒ ፈንቀላንቶኖቼ።<note caller="-" style="x"><char style="xo" closed="false">10፥7 </char><char style="xt" closed="false"><ref loc="1CO 9:14">1 ቆሮ. 9፥14</ref>፤ <ref loc="1TI 5:18">1 ጢሞ. 5፥18</ref>።</char></note> <verse eid="LUK 10:7"/><verse number="8" style="v" sid="LUK 10:8"/>ህትን ኣጌንተ ከተማን ጉዕማንን ቶጌመህዕኔች ሆንጠህሴመህዕኔሃ እቼ። <verse eid="LUK 10:8"/><verse number="9" style="v" sid="LUK 10:9"/>ህከን ከተማን ዮ ጥዘናመተ ፈይሼ፤ ህትን ‹መገን ዎምነቱ ክዕኔቤቹ ሆንጠኮኡ› ይዬሰ። <verse eid="LUK 10:9"/><verse number="10" style="v" sid="LUK 10:10"/>ጠዉ እኮጎሬ ሀከ ከተመሃ ኣጌንተ ወክት መኑ ቶግበህዕኔጎሬ ከተም በነቻን ፉልቴን <verse eid="LUK 10:10"/><verse number="11" style="v" sid="LUK 10:11"/>‹ሁኩዕኑን ጡር እሆህኔተ ሎከኔ አሌን ዮ ከተምክዕኔ ትበ ግግሽናንክዕኔ፤ እኮጎሬ መገን ዎምነቱ ክዕኔቤቹ ሆንጠሁስ ደጌ› ይዬ።<note caller="-" style="x"><char style="xo" closed="false">10፥11 </char><char style="xt" closed="false"><ref loc="ACT 13:51">ሶቀ. 13፥51</ref>።</char></note> <verse eid="LUK 10:11"/><verse number="12" style="v" sid="LUK 10:12"/>አን ኩላንክዕኔ፤ ፍርድ በር ህከን ከተሚች በትሽ ሰዶም ከተሚሃ እኮ ጠዉ ቢለኖ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">10፥12 </char><char style="xt" closed="false"><ref loc="GEN 19:24-28">ክል. 19፥24-28</ref>፤ <ref loc="MAT 11:24">ማቶ. 11፥24</ref>፤ <ref loc="MAT 10:15">10፥15</ref>።</char></note><verse eid="LUK 10:12"/></para>
  <para style="s1">አመዕኑ ሆግንከሰ ዎቀሰንቶ ከተመተ</para>
  <para style="r">(<ref loc="MAT 11:20-24">ማቶ. 11፥20-24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13"/>ኢስ «ቆሀኖሄ አት ኩራዝ ከተንቾ! ቆሀኖሄ አት ቤተ ሰይደ! ክዕኔቤቾን አሰሞ አጀብሲሰኖርቹ ጢሮስለከ ስዶን ከተማን አሰሞ እቃን እሰን ጥጅ ኦድኑተ ኦደእ ጠበሮን አፉዕልት አበ ወክቲች ብርተ ጩብሰ አጉርኔ ይታ እቅ።<note caller="-" style="x"><char style="xo" closed="false">10፥13 </char><char style="xt" closed="false"><ref loc="ISA 23:1-8">ኢሳ. 23፥1-8</ref>፤ <ref loc="EZK 26:1-18">ሕዝ. 26፥1-18</ref>፤ <ref loc="JOL 3:4-8">ኢዩ. 3፥4-8</ref>፤ <ref loc="AMO 1:9-10">አሞ. 1፥9-10</ref>፤ <ref loc="ZEC 9:2-4">ዘካ. 9፥2-4</ref>።</char></note> <verse eid="LUK 10:13"/><verse number="14" style="v" sid="LUK 10:14"/>ጠዉ እኮጎሬ ፍርድ በር ክዕኔች በትሽ ጢሮስለከ ስዶን ከተሚሃ ቅጣቱስ ቢለኖሰ። <verse eid="LUK 10:14"/><verse number="15" style="v" sid="LUK 10:15"/>ህትን ቴ ቅፍርናሆም ከተንቾ! ሰማሃ ኢለ ጎት ጎት ይቶተ ሀስንዶ? አዛቤን ድርታንት» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">10፥15 </char><char style="xt" closed="false"><ref loc="ISA 14:13-15">ኢሳ. 14፥13-15</ref>።</char></note><verse eid="LUK 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16"/>ህትን አሳበስ «ክዕኔተ ሞጮጨኖሁ ኤሳንከ ሞጮጨኖሃን፤ ህትን ክዕኔተ ቶግባሁ ኤሳንከ ቶግባሃን፤ ህትን ኤሳሃ ቶግባሁ ኤሰ ሶኮኤንከ ቶግባሃን» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">10፥16 </char><char style="xt" closed="false"><ref loc="MAT 10:40">ማቶ. 10፥40</ref>፤ <ref loc="MRK 9:37">ማር. 9፥37</ref>፤ <ref loc="LUK 9:48">ሉቃ. 9፥48</ref>፤ <ref loc="JHN 13:20">ያህ. 13፥20</ref>።</char></note><verse eid="LUK 10:16"/></para>
  <para style="s1">ለመላይኔ ለሙንኩ አሳበት ሶሀንቶቤቺች ፈንቀሉሰ</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17"/>ለመላይኔ ለሙንኩ አሳበት ሶሀንቶ አዲች አበ ሙንዲኖን ፈንቀልት «ቀርቾ! ኪ ሱዕሚን ሩሃንዩ አዘዘሞኔ!» ይቶኡ።<verse eid="LUK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18"/>ኢስን «ሻይጣንቹ ጉገኛገ እክ ሰሜች ኡባን ለዕዮንስ። <verse eid="LUK 10:18"/><verse number="19" style="v" sid="LUK 10:19"/>ሁኩዕኑን አን ዎሪቹለከ ‹ግንጠ› ዬኖ መርዙ ዮስ ዎርቹ ከዶኖተለከ ዲን ዎልቀተ ጉዕመንከ አታልቴነንተ ሹምነቱ ኣስዮንክዕኔ፤ ሚረኖህዕኔሁ መቱርቹሁ ዮበአ።<note caller="-" style="x"><char style="xo" closed="false">10፥19 </char><char style="xt" closed="false"><ref loc="PSA 91:13">መዝ. 91፥13</ref>።</char></note> <verse eid="LUK 10:19"/><verse number="20" style="v" sid="LUK 10:20"/>ሩሃንዩ አዘዘሞህዕኔ ቤቺሃ ተሽ ዩንከህዕኔ፤ ጠዉ እኮጎሬ ሱዕሙክዕኔ ሰማን ከተበሞቤቺሃ ሙንደዕዬ» ዬሰ።<verse eid="LUK 10:20"/></para>
  <para style="s1">ኢስ ሙንደዕዮገ</para>
  <para style="r">(<ref loc="MAT 11:25-27">ማቶ. 11፥25-27</ref>፤ <ref loc="MAT 13:16-17">13፥16-17</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21"/>ህከ ወክት ጠሊሉ አያኑ ኢሰ ተሽቲን ዊንሽስ «ሰሜለከ ኡለ ቀርቹ እኮንት ኢ አነ! ከ ጠወ ሀይቻኖችለከ ደጋሀኑኡች ማጥ ኦሶተ ደግስሶንትቤቺሃ ገለትጫንኬ፤ ኤ ኢ አነ! መሰንትስ ኪ ጡሙ ሰውቱ ህትናሙሃን።<verse eid="LUK 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22"/>«ጉዕሙርቹንኩ አኒችኤ ኣሰሞኤ፤ ቤቱ አዬት ጎሬ አን ቤሉ አዪሁ ደገኖበአ፤ ህትን አኑ አዬት ጎሬ ቤቲችለከ ቤቱ ለሊሶስተ መጠሮ መንች ቤሉ አዪሁ ደገኖበአ» ዬእ።<verse eid="LUK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23"/>ህከኒች ኤተሮን አሳበ አደ ፈንቀል ኬዕይ ጠለዕል እሳሃ «አዕኑ ለኤነንታሃ ለኣእሩ ማሰአንቶእራን። <verse eid="LUK 10:23"/><verse number="24" style="v" sid="LUK 10:24"/>አን ኩላንክዕኔ፤ መሰንትስ ልግቡ ነብያከትለከ ዎመት አዕኑ ለኤንታሃ ለኦተ ሄዕላቶ እቅ፤ እኮጎሬ ለኦበአ፤ ህትን አዕኑ ሞጮጭቴንታሃ ሞጮጭቶተ ሄዕላቶ እቅ፤ እኮጎሬ ሞጮጭቶበአ» ዬሰ።<verse eid="LUK 10:24"/></para>
  <para style="s1">ጎደበ ላፈ ሰምራውቹ</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25"/>መገን ሕገ ደገኖ መቱ መንቹ አሌ ዋል ኡርኬዕይ ኢሰ ፌተኖስተ «አስተማርቾ! ዘላለም ሄኡ ደኦተ መ አኡ?» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">10፥25 </char><char style="xt" closed="false"><ref loc="MAT 22:35-40">ማቶ. 22፥35-40</ref>፤ <ref loc="MRK 12:28-34">ማር. 12፥28-34</ref>።</char></note> <verse eid="LUK 10:25"/><verse number="26" style="v" sid="LUK 10:26"/>ኢስን «ሕጋን ከተበሞሁ መርቾሃን? ህትን ህካን ሀት አነበባንቲት?» ዬስ።<verse eid="LUK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27"/>ሁኩ መንቹንኩ « ‹ቀርቹ መገኑክ ዊመ ቀልቢንከክ፥ ዊመ ፎልኒከክ፥ ዊመ ወልቃንተክለከ ዊመ ሰውቲንከክ ኢት፤ ህትን ዎሉ መነ ገይክገ ኢት› የኖ» ዬስ።<note caller="-" style="x"><char style="xo" closed="false">10፥27 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ሌዌ 19፥18</ref>፤ <ref loc="DEU 6:5">ዘዳ. 6፥5</ref>።</char></note><verse eid="LUK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28"/>ኢስን «ሀንቅንከ ይቶንት፤ ካን አእ፤ ዘላለም ሄኡ ደእታንት» ዬስ።<note caller="-" style="x"><char style="xo" closed="false">10፥28 </char><char style="xt" closed="false"><ref loc="LEV 18:5">ሌዌ 18፥5</ref>።</char></note><verse eid="LUK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29"/>ሁኩ መገን ሕገ ደገኖ መንቹንኩ ገዉስ ፈየ አኦተ ሀሽ ኬዕይ ኢሰ «ኦሌቹኤ አዬት?» ይ ጠዕሜስ።<verse eid="LUK 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30"/>ኢስን ፈንቀሽ «መቱ መንቹ ዬሩሰሌም ከተሚች ኢያርኮ ከተመ ህገኖት እቅ፤ ህከ መንቹንከ ሽፍጡ አፍ ኦድኑስ ቃርት ኦልቶች ኤተሮን ሬሆተ ሆንጠካን ሂለ ፎልስ አጉርት መርቶኡ። <verse eid="LUK 10:30"/><verse number="31" style="v" sid="LUK 10:31"/>ህትን ህከን ዎቄን መቱ ቂስቹ ህገኖት እቅ፤ እስን ህከ መንቹ ገምባትንከ ለዕዮ ወክት አጉር መዲንከስ ኦሮዕዮ። <verse eid="LUK 10:31"/><verse number="32" style="v" sid="LUK 10:32"/>ህትን መቱ ሌውቹ ህከን ቤቺን ህገን ህከ መንቹ ለዕይ ዎሎ አዲን አጉር ኦሮዕዮ። <verse eid="LUK 10:32"/><verse number="33" style="v" sid="LUK 10:33"/>ጠዉ እኮጎሬ መቱ ሰማር ባድ መንቹ ህከን አዲን ኦሮአን ሁኩ መንቹ ዮ ቤቺን አሜቾ፤ እስን ለዕዮስ ወክትንከ አሙዦስ፤ <verse eid="LUK 10:33"/><verse number="34" style="v" sid="LUK 10:34"/>እስበ ሆንጠክ ዘይተለከ ወይነ ቦበጤማሃ ጡላንከስ ዎር ጡላስ ኡሱሮ፤ ህት አዕይ ገይስ ገማሞን ቆጵሲሽ ኮሁ ገለኖቤቹ መስ ጥስሾስ። <verse eid="LUK 10:34"/><verse number="35" style="v" sid="LUK 10:35"/>እስን ለንክ በር ገስማን ኦሮአን ኮሁ ገለኖ ምኒ አኒሃ ለሙ ዲናር ፉሽ ኣስ ‹ከ መንቹ ጡመገ አት ጥሲስስ፤ ከኒች በተአኖ ዲናረ ፉሽቶንት ጎሬ ፈንቀል አሜታም ወክት ባታንኬ› ዬስ። <verse eid="LUK 10:35"/><verse number="36" style="v" sid="LUK 10:36"/>ቴሱ ህከን ሰሶንከ መንቺች ሽፍጡ ኦልታንስ ኡቦ መንቺሃ ጃላ እሁስ ለሊሾሁ ሀከን እሶት?» ዬእ። <verse eid="LUK 10:36"/><verse number="37" style="v" sid="LUK 10:37"/>መገን ሕገ ደገኖ መንቹንኩ «አሙዥ ሀዕሌስሃን» ዬእ፤ ኢስን «አቲሁ መርት ህትን አእ» ዬስ።<verse eid="LUK 10:37"/></para>
  <para style="s1">ኢስ ማርተለከ መርየመ ምኒ መሩስ</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38"/>ኢስ አሳባንተስን ዎቃሃ ሃመን መት ቀዕተ ኣጎ፤ ህከኔን «ማርተ» ዬኖ መት መንቹት ምኔንከሴ ቶጎስ። <verse eid="LUK 10:38"/><verse number="39" style="v" sid="LUK 10:39"/>እሴንከ «መርየመ» ዬኖ አመቤቱት ሄኦሴ እቅ፤ እሴን ኢስ ሎካች ዎሮ አዲን አፉዕልት ተማርሰኖሃ ሞጮጭታኢት እቅ።<note caller="-" style="x"><char style="xo" closed="false">10፥39 </char><char style="xt" closed="false"><ref loc="JHN 11:1">ያህ. 11፥1</ref>።</char></note> <verse eid="LUK 10:39"/><verse number="40" style="v" sid="LUK 10:40"/>ጠዉ እኮጎሬ ማርተ ሆጉት በተኣንሴ መቴምማተሴ ኢስቤቹ መርት «ቀርቾ! አመኤ ቤቱት ሆጉተ አአን ኦርጨቀሞተ ኤሳሃ ሜጥሃኤ አጉርቶኤጉ ሻዝሰኖሄበእንዶ? ቴሱ ሀዕልቶኤተ ኩልሴ» ይቶስ።<verse eid="LUK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41"/>ጠዉ እኮጎሬ ኢስ ፈንቀሽ «ማርታ! ማርታ! አት አበ ጠዊን ጨነቀንታንቲትለከ ኦርጨንታንቲት። <verse eid="LUK 10:41"/><verse number="42" style="v" sid="LUK 10:42"/>እኮጎሬ ሀስሰኖሁ ጠለዕል መቶ ጠወ፤ ህከን እኮቤቺሃ እሴሃ አዪሁ ኣኦተ አታለኖበ፤ ቆሀኖሲሃ መጠርቶኡ» ዬእ።<verse eid="LUK 10:42"/></para>
  <chapter eid="LUK 10"/>
  <chapter number="11" style="c" sid="LUK 11"/>
  <para style="s1">ዱአ አእተኔሃ</para>
  <para style="r">(<ref loc="MAT 6:9-13">ማቶ. 6፥9-13</ref>፤ <ref loc="MAT 7:7-11">7፥7-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1"/>መቱ በር ኢስ መቶ ቤቾን ዱአ አአኖት እቅ፤ ዱአ አዕይ ኬዕዮ ወክት አሳባችስ መቱ «ቀርቾ! ያህይ አዎናኑስ ዱአ አታገ ተማርሴገን አቲሁ ዱአ አዕናምገ ተማርስኔ» ዬስ። <verse eid="LUK 11:1"/><verse number="2" style="v" sid="LUK 11:2"/>ኢስን ዱአ አቴነንተ ወክት</para>
  <para style="q1" vid="LUK 11:2">«ሰማን ዮንቲሁ ኒ አኑ!</para>
  <para style="q2" vid="LUK 11:2">ጠሊሉ ሱዕሙክ ማሰአሞሃ እሁን፤</para>
  <para style="q1" vid="LUK 11:2">ዎምነቱክ አሜቱን!<verse eid="LUK 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3"/>በሪሃ ሀስሳ እቸተ በሬን በሬን ኣስኔ!<verse eid="LUK 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4"/>ነኡ በደልቶኔረ ፈቁን ይን አጉርናምሀንገን፥</para>
  <para style="q2" vid="LUK 11:4">ብድልኔ ፈቁን ይኔ፤</para>
  <para style="q1" vid="LUK 11:4">ፌተናን ኣግሶትኔ ይዬ» ዬእ።<verse eid="LUK 11:4"/></para>
  <para style="p">
    <verse number="5-6" style="v" sid="LUK 11:5-6"/>እስን አሳበስ «ክዕኔች አዪሁ ጃሉ ዮሲሁ ሀዎሮ በላን ጃልስቤቹ መር ‹ኢ ጃላ! ሰሱ ጣብተ ሌቄሴኤ፤ መቱ ጃሉኤ ቄዕራሸ ባዲች ኢ ምኒ አሜቾኡ፤ እሲንከ ሆንጠህሳም መቱርቹሁ ዮኤበአ› ዬስ ጎር<verse eid="LUK 11:5-6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 11:7"/>«ምኒ ኣዚን ዮኢሁ ‹ኦርሶቴኤ! ኡሩት ጡፈንቶኡ፤ እለኤ ኢን ሜጡበ መዕናን ኦሰኦኡ፤ ህከን እኮቤቺሃ ኬዕይ መቱርቹሃ ኣሶሄተ አታላምበአ› የኖንዶ? <verse eid="LUK 11:7"/><verse number="8" style="v" sid="LUK 11:8"/>አን ያንክዕኔ፤ ጃለስ እኮቤቺሃ ኬዕይ ኣሲሃ ሀስበ ጎሬ ዎርዋቾስቤቺሃ ኬዕይ ሀሰኖርቹ ጉዕመንከ ኣሰኖስ።<verse eid="LUK 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 11:9"/>«አኒሁ ያንክዕኔ፤ ኡጭዬ ኣሰመኖህዕኔ፤ ሀሼ ደእቴነንተ፤ ኡሩተ ቆጭዬ ፈንተአኖህዕኔ። <verse eid="LUK 11:9"/><verse number="10" style="v" sid="LUK 11:10"/>መሰንትስ ኡጨኖሁ ጉዕሙንኩ ኣአኖ፤ ሀሰኖንኩ ደአኖ፤ ህትን ኡሩተ ቆጨኖሀኒሃ ፈንተአኖስ።<verse eid="LUK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 11:11"/>«ክዕኔች ቤቱክዕኔ ‹ቁርጩሜተ ኣሴኤ› ይ ኡጬጎሬ ዎሪቹ ኣስቴነንዶ? <verse eid="LUK 11:11"/><verse number="12" style="v" sid="LUK 11:12"/>ህከረንገ ቡጳ ኣሴኤ ይ ኡጬጎሬ ‹ግንጠ› ዬኖ መርዙ ዮስ ዎሪቹ ኣቴነንስንዶ? <verse eid="LUK 11:12"/><verse number="13" style="v" sid="LUK 11:13"/>አዕኑ ሂላኑተ እኬነን እላተክዕኔ ጡመርቹ አኡ ደጌንታች ሰማን ሄአኖ አኑክዕኔ ኡጭታሀኑኡተ ጠሊለ አያነ ሀት በትሽ ኣሰኖሰበአ!» ዬሰ።<verse eid="LUK 11:13"/></para>
  <para style="s1">ኢሰለከ ብዔልዜቡለ</para>
  <para style="r">(<ref loc="MAT 12:22-30">ማቶ. 12፥22-30</ref>፤ <ref loc="MRK 3:20-27">ማር. 3፥20-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14"/>መቱ በር ኢስ መቶ መንቺች ዶሮረኖ ዱር ፉሸኖት እቅ፤ ዶሮረኖ ዱሩንኩ ፉሎ ወክት ዱዱንኩ ጠወዕዮ፤ መኑንኩ ህከን ጠዋን አበ አጀብሲጬእ። <verse eid="LUK 11:14"/><verse number="15" style="v" sid="LUK 11:15"/>ጠዉ እኮጎሬ ህከን መኒች መት-መቱሰ «እስ ሩሃንየ ፉሸኖሁ ሩሃንይ ብዔልዜቡል ወልቃኒት» ይቶኡ።<note caller="-" style="x"><char style="xo" closed="false">11፥15 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቶ. 9፥34</ref>፤ <ref loc="MAT 10:25">10፥25</ref>።</char></note><verse eid="LUK 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 11:16"/>ህትን ዎሉ መኑ ፌተንቶስተ ሀስ ሰሜች መላተ ለሊሶሰተ ጠዕምቶስ።<note caller="-" style="x"><char style="xo" closed="false">11፥16 </char><char style="xt" closed="false"><ref loc="MAT 12:38">ማቶ. 12፥38</ref>፤ <ref loc="MAT 16:1">16፥1</ref>፤ <ref loc="MRK 8:11">ማር. 8፥11</ref>።</char></note> <verse eid="LUK 11:16"/><verse number="17" style="v" sid="LUK 11:17"/>ጠዉ እኮጎሬ ኢስ ቀልብሰ ጠወ ደግ «መቶ ዎም ኣዜን ሄዕዮ መኑ ገገዉንኩስን አደደ እኮጎሬ ሁኩ ዎሙ ድጀመኖ፤ ህትን መቶ ምኔን ሄአኖ መኑ አደደ እክ ገገዉንኩስ ብተሞ ጎሬ ብን የኖ። <verse eid="LUK 11:17"/><verse number="18" style="v" sid="LUK 11:18"/>ህትን አዕኑ ኤሳሃ ‹እስ ፉሸኖሁ ብዔልዜቡሌ ወልቃኔት› ይቴነንተኤቤቺሃ ሻይጣን ዎሙ ገገዉንኩስ ብተም ብን የኖሃ እኮጎሬ ሀት እክ ጠረኝ ኡሮተ አታለኖ? <verse eid="LUK 11:18"/><verse number="19" style="v" sid="LUK 11:19"/>አን ሩሃንየ ፉሻሚሁ ብዔልዜቡሌ ወልቃን እኮጎሬ እለክዕኔ አዬ ሱዕሚን ፉሽታአ? ህካን እኮቤቺሃ ገይክዕኔ እለት ክዕኔ አሌን ፈረዳእረ እካአ። <verse eid="LUK 11:19"/><verse number="20" style="v" sid="LUK 11:20"/>ጠዉ እኮጎሬ አን ሩሃንየ ፉሻሚሁ መገን ወልቃን እኮች መገን ዎምነቱ ክዕኔቤቹ አሜተኖት። <verse eid="LUK 11:20"/><verse number="21" style="v" sid="LUK 11:21"/>ህትን መቱ ጀቡ መንቹ ጌሬንጌሩለከ በገዙ አፍ ምንስ አገረኖረ ዮስ ዱንያስ ጡመገ አገረንታአ። <verse eid="LUK 11:21"/><verse number="22" style="v" sid="LUK 11:22"/>ጠዉ እኮጎሬ እሲች ጀቡ መንቹ አሜች ብተም ቄሎ ወክት ወዕና አመዕን ሄዕዮ እቅ በገዝ ኦደተ ኣእ ከም ዘረፎ ኦዳተ መኒሀስ ቤሀኖ።<verse eid="LUK 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23"/>«ኢን ሜጡበ እህቡ ጉዕሙንኩ ኢን ሀንበዕለመኖ፤ ህትን ኢን ሜጡበ ጭምአእቡ ጉዕሙንኩ ብንአዕይ ከመኖ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">11፥23 </char><char style="xt" closed="false"><ref loc="MRK 9:40">ማር. 9፥40</ref>።</char></note><verse eid="LUK 11:23"/></para>
  <para style="s1">ዶሮርኖ ዱሩ መን ኣዝ ፈንቀሉስ</para>
  <para style="r">(<ref loc="MAT 12:43-45">ማቶ. 12፥43-45</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24"/>ህከኒች ኤተሮን ኢስ «ዶሮረኖ ዱሩ መንቺች ፉል ኦሮዕዮ ወክት ፎሎጨኖ ቤቹ ሀሰን ዉሁ ዮበእቤቾን ሃመን ዘሀኖ፤ ፎሎጨኖ ቤቹ ሆጎ ወክት ‹ወዕና ፉሎም ምኒኤ ፈንቀል ኦሮኣም› የኖ። <verse eid="LUK 11:24"/><verse number="25" style="v" sid="LUK 11:25"/>ፈንቀል አሜተኖ ወክት ምኑስ መክ ሀጠወማን ደገኖ። <verse eid="LUK 11:25"/><verse number="26" style="v" sid="LUK 11:26"/>ህከኒች ኤተሮን መር እሲች ባሰ ሂላኑተ ለመለ ዎሉ ሩሃንየ ኤበኖ፤ እሰን ኣግ ህከኔ ሄኣአ፤ ህከን መንች ኤተሩስ ወዕኔችስ በትሽ ሻዝሰኖሃ እሀኖ» ዬእ።<verse eid="LUK 11:26"/></para>
  <para style="s1">ሀንቅ ማሰተ</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27"/>ኢስ ህካን ጠወአን ሄዕዮገን ልግቤ መን በላን መት መንቹት ላገሴ ጎት አት ኢሰ «ኬሳሃ እልቶ መንቹት ማሰአንቶእታን» ይቶስ።<verse eid="LUK 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28"/>ጠዉ እኮጎሬ እስ «ማሰአንቶእሩኑ መገን ላገተ አገርታእረ» ዬሴ።<verse eid="LUK 11:28"/></para>
  <para style="s1">ዮኑስ መላተ እሁስ</para>
  <para style="r">(<ref loc="MAT 12:38-42">ማቶ. 12፥38-42</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29"/>ልግቡ መኑ ጭምዬ ወክት ኢስ «ከን ዘማኒ መኑ ሂለሃን፤ መላተ ለኦተ ሀሰኖ፤ እኮጎሬ ዩኑስ መላ ቤሉ ዎልት መላት ሆሮን ኣሰንታስበአ።<note caller="-" style="x"><char style="xo" closed="false">11፥29 </char><char style="xt" closed="false"><ref loc="LUK 16:4">16፥4</ref>፤ <ref loc="LUK 8:1">8፥1</ref>።</char></note> <verse eid="LUK 11:29"/><verse number="30" style="v" sid="LUK 11:30"/>መሰንትስ ዩኑስ ናናዌ ከተም መኒ መላተ እኮገን ህትን መንች ቤቱሁ ከን ዘማን መኒሃ መላተ እሀኖ።<note caller="-" style="x"><char style="xo" closed="false">11፥30 </char><char style="xt" closed="false"><ref loc="JON 3:4">ዩኑ. 3፥4</ref>።</char></note> <verse eid="LUK 11:30"/><verse number="31" style="v" sid="LUK 11:31"/>ካበ ባድ ዳኘት ‹ሳበ› ዬኖት ሱላይማኔ ሀይመተ ሞጮጭቶተ ኡለ ዳንጊች አሜቶቤቺሃ ፍርድ በር ከን ዘማን መኒን ሜጡበ ኬእ እሰተ ዎቀሳአ፤ ከለዕዬ! ሱልማኒች በተአኖሁ ከበ ዮኡ። <verse eid="LUK 11:31"/><verse number="32" style="v" sid="LUK 11:32"/>ህትን ናናዌ ከተም መኑ ዩኑስ ዱዱብስያንሰ ጩብሰ ቶበቶቤቺሃ ፍርድ በር ከን ዘማን መኒን ሜጡበ ሬሆች ኬእ እሰተ ዎቀሳአ፤ ከለዕዬ! ዩኑሲች በተአኖሁ ከበ ዮኡ» ዬእ።<verse eid="LUK 11:32"/></para>
  <para style="s1">ጅስም ኑርተኔሃ</para>
  <para style="r">(<ref loc="MAT 5:15">ማቶ. 5፥15</ref>፤ <ref loc="MAT 6:22-23">6፥22-23</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33"/>ኢስን «አዪሁ ኩራዘ ቀሽ ምኒ ኣገኖ መኑ ኑር ለኢሃ አታለኖቤቾን ኩራዘ ሱተኖ ቤሉ ማጭ ሰፈ እፍሰኖሁ ዮበአ። <verse eid="LUK 11:33"/><verse number="34" style="v" sid="LUK 11:34"/>ህትን እልክ ጅስምሃክ ኑርየ፤ እልክ ፈየተ እኮ ወክት ጅስሙክ ጉዕሙንኩ ኑርን ዊሞሃ እሀኖ፤ ህትን እልክ ፈየተ እክበ ወክት ጅስሙክ ጉዕሙንኩ ቱንስቹ እሀኖ። <verse eid="LUK 11:34"/><verse number="35" style="v" sid="LUK 11:35"/>ህካን እኮቤቺሃ ኪን ዮ ኑሩ ቱንስቹ እሀኖበእገ አገዕር። <verse eid="LUK 11:35"/><verse number="36" style="v" sid="LUK 11:36"/>ጅስሙክ ሜጡ ቤቹሁ ቱንስቹ ሄኡዕናንስ ጠለዕል ኑር እኮጎሬ ኩራዝ ኑሩ አበ ለሊሰኖ ጌሰ ጅስሙክ ጉዕሙንኩ ኑር እሀኖ» ዬእ።<verse eid="LUK 11:36"/></para>
  <para style="s1">ፈርሳዉያኑትለከ ሕግ አስተማረት ዎቀሰሙሰ</para>
  <para style="r">(<ref loc="MAT 23:1-36">ማቶ. 23፥1-36</ref>፤ <ref loc="MRK 12:38-40">ማር. 12፥38-40</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37"/>ኢስ ህካን ጠወአንን መቱ ፈርሳውቹ ምኔንከስ ዛበዕይ ሆሹ እቶተ ኡጬስ፤ ህካን እኮቤቺሃ ኢስ ምኒ ኣግ ሆሹ እቶተ አፉዕሌእ። <verse eid="LUK 11:37"/><verse number="38" style="v" sid="LUK 11:38"/>ኢስ ሆሹ እቱዕነ ሄጭ አንገተ ኣዕሉ ሆጉስ ሁኩ ፈርሳውቹ ለዕዮ ወክት አበ አጀብሲጬእ። <verse eid="LUK 11:38"/><verse number="39" style="v" sid="LUK 11:39"/>ህካን እኮቤቺሃ ቀርቹ ህከ ፈርሳውቹ «አዕኑ ፈርሳውያኑት! ኩበየለከ ሳነ አብልስ ኣንሽቴነንተ፤ ጠዉ እኮጎሬ ኣዜንከክዕኔ ወልቅሴን ኣኡለከ ሂሉ ጠዉ ዊሞህዕኔ። <verse eid="LUK 11:39"/><verse number="40" style="v" sid="LUK 11:40"/>ኩ ገዋኑት! ኤተርስ አደ ከለቆሁ ኣዝስ አደ ከለቆበእንዶ? <verse eid="LUK 11:40"/><verse number="41" style="v" sid="LUK 11:41"/>ህከን ኣዜን ዮኢሃ ቡጥቻኖተ ዘከተ ኣስዬ፤ ጉዕሙርቹንኩ ሙጩሩ እሀኖህዕኔ።<verse eid="LUK 11:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42"/>«ጠው እኮጎሬ አዕኑ ፈርሳውያኑት ገንበለ ጠጉተ፥ ጫሮቴችለከ ጋሮ ጠጎች ጉዕሚችን ዘከተ ፉሽቴነን ሀንቅ ፍርደለከ መገኑ ኢቱ ህንቄንተቤቺሃ ክዕኔሃ ቆሀኖህዕኔ! እኮጎሬ ዎሉሲንገ አጉርቶኑዕናን ከ ጠወ አኡ ሀስሰኖህዕኔ እቅ።<verse eid="LUK 11:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43"/>ህትን «ጭምት ምናን ኬዕምኝ ቦርጭማን አፉዕሉለከ ጌቦ ዮቤቾን ጠውሲሶኖህዕኔተ ሀሴነንተቤቺሃ ክዕኔ ፈሪሳውያኖተ ቆሀኖህዕኔ! <verse eid="LUK 11:43"/><verse number="44" style="v" sid="LUK 11:44"/>መኑ ደጉዕነ አሌስ ሃመኖ ለልቡ ሎደ አጉዴነንተቤቺሃ ክዕኔሃ ቆሀኖህዕኔ!» ዬሰ።<verse eid="LUK 11:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45"/>መገን ሕገ ደጋሀኑኡች መቱስ ፈንቀሽ «አስተማርቾ! ካን ዩክ ህትን ኔሳሃ ቦሮሩሃክበዕንዶ!» ዬስ።<verse eid="LUK 11:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46"/>ኢስን ፈንቀሽ «አዕኑ ኬዕምተ እጅነተ መናን እጅሲሴን እጅነስ አዕኑ ዙሩዕሜንከክዕኔ ኡልቴነንተበእቤቺሃ መገን ሕገ ደጌነንተ ክዕኔሃ ቆሀኖህዕኔ! <verse eid="LUK 11:46"/><verse number="47" style="v" sid="LUK 11:47"/>ህትን አናከክዕኔ ሽቶ ነቢያከ ሎደሰ ምልካንስቴን መክሴነንተረ እኬንተቤቺሃ ክዕኔሃ ቆሀኖህዕኔ!» ዬእ። <verse eid="LUK 11:47"/><verse number="48" style="v" sid="LUK 11:48"/>ህካን እኮቤቺሃ አዕኑ ምስክረተለከ አናከክዕኔ ሂለ ሆጎን ኢተቀንቴንታእረ፤ መሰንትስ አናከክዕኔ ሽቶኡ፤ አዕኑንገ ሎደሰ መክሴነንታት። <verse eid="LUK 11:48"/><verse number="49" style="v" sid="LUK 11:49"/>ህካን እኮቤቺሃ መገን ሀይመት አን እሰቤቹ ነቢያከተለከ ሶቀማኑተ ሶሃም፤ እሳችን መት-መቱሰ ሽታአ፤ ፈቆረ ሸርታአ ይቶኡ። <verse eid="LUK 11:49"/><verse number="50" style="v" sid="LUK 11:50"/>ሁኩን እኮሁ ኣዱንያት ከለቀንቶች ኬሽ ነብያካች ዱንተዕዮ ቄጊሃ ከን ዘማን መኑ ጠዕመመኖ። <verse eid="LUK 11:50"/><verse number="51" style="v" sid="LUK 11:51"/>ሁኩንን አቤሌ ቄጊች ኬሽ መገን ክትም ሆንጠህሴኖ ጠረጴዛንለከ ዱእ ምኒ በላን ሬዮ ዘከርያሴ ቄጉ ኢላት፤ ኤ! አን ያንክዕኔ፤ ህከን ቄጊሃ ከን ዘማን መኑ ጠዕመመኖ።<verse eid="LUK 11:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52"/>አዕኑ «ሕገ ደጌነንተሩ ቆሀኖህዕኔ! ደግ ቁልፈ ፈኔኖሃ ሀንቅ ቁልፈ አፌንታአ፤ ጠዉ እኮጎሬ አዕኑ ገዉንኩክዕኔ ኣጌንታበአ፤ ኣጉ ሀሳእራ አጋበእገ ከንቴንታአ።»<verse eid="LUK 11:52"/></para>
  <para style="p">
    <verse number="53-54" style="v" sid="LUK 11:53-54"/>ኢስ ኦሮአን ሕግ አስተማረትለከ ፈርሳዊያኑት መት ሉሰተ አፌችስ ደግ አፎተ ሀስ አበ ጥቅስ ጢቄን ልግብ ጠዕምቱተ ጠዕምቶስተ ኡለንስታሲት እቅ።<verse eid="LUK 11:53-54"/></para>
  <chapter eid="LUK 11"/>
  <chapter number="12" style="c" sid="LUK 12"/>
  <para style="s1">ኢስ «ገዉ ሎርሲች አገዕርዬ» ዩስ</para>
  <para style="r">(<ref loc="MAT 10:26-27">ማቶ. 10፥26-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1"/>ህከ ወክት ልግቡ ኩሜ መኑ ጭምይ ኬዕይ ገገዉንኩሰን ሀንበዕለንተን ከጣቀንታእት እቅ፤ ኢስን ሄጭ አሳባተስ «ፈርሳዌ ራጭቲች አገዕርዬ፤ እስን ለዕዬኤ ዩሃን።<note caller="-" style="x"><char style="xo" closed="false">12፥1 </char><char style="xt" closed="false"><ref loc="MAT 16:6">ማቶ. 16፥6</ref>፤ <ref loc="MRK 8:15">ማር. 8፥15</ref>።</char></note> <verse eid="LUK 12:1"/><verse number="2" style="v" sid="LUK 12:2"/>ጠው እኮጎሬ እፍሰሞርቹ ፈንተኡዕነለከ ማጠሞንኩ ለሉዕነ ፈቀኖበአ።<note caller="-" style="x"><char style="xo" closed="false">12፥2 </char><char style="xt" closed="false"><ref loc="MRK 4:22">ማር. 4፥22</ref>፤ <ref loc="LUK 8:17">ሉቃ. 8፥17</ref>።</char></note> <verse eid="LUK 12:2"/><verse number="3" style="v" sid="LUK 12:3"/>ህካን እኮቤቺሃ ቱንስቾን ጠወኤንተርቹ ጉዕሙንኩ ኑሬን ሞጮጨመኖ፤ ህትን ጡፈንቶ ጎጆን ኩሽኩሽይቴን ጠወኤንታሃ በነቻን አዋጄኖ» ዬእ።<verse eid="LUK 12:3"/></para>
  <para style="s1">አዬ ዋጁ ሀስሰኖኔ?</para>
  <para style="r">(<ref loc="MAT 10:28-31">ማቶ. 10፥28-31</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4"/>ኢስ «ክዕኔተ ኢ ጃላ ያንክዕኔ፤ ጅስመ ሽቶተ አታልታእረ ዎሉ መቱርቹሃ አቶተ አታልትበረ ዋጅቶኖቼ። <verse eid="LUK 12:4"/><verse number="5" style="v" sid="LUK 12:5"/>ጠዉ እኮጎሬ አዬ ዋጁ ሀስሰኖኔ ጎሬ ጠረኝሽ ኩላንክዕኔ፤ ሼች ኤተሮን ዘማኒሃ ጉዕሚንከ ጠእትበ ጊራን ዎረኖ ወልቀት ዮስ መገኑ ዋጅዬ፤ ኤ! አን ያንክዕኔ፤ እሱ ዋጅዬ።<verse eid="LUK 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 12:6"/>«ኦንት ጭኡት መቱ ሳንትበ ህረንታእበእንዶ? ሆሮን እሳች መቱሰ መገን ብሬን ሀበንታበአ። <verse eid="LUK 12:6"/><verse number="7" style="v" sid="LUK 12:7"/>ክዕኔሁ ሆሮ ቡዕልክዕኔ ሙሙሁ ጉዕሙንኩ ዎለአሞእሃን፤ ህካን እኮቤቺሃ አዕኑ ልግቤ ጭኦች በትሴን ደግለልቴነንተቤቺሃ ዋጅቶኖቼ» ዬሰ።<verse eid="LUK 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8"/>ኢስ አን ኩላንክዕኔ፤ መን ብሬን መሰከረኖኤሀኒሃ ጉዕሚንከ መንች ቤቱ መገን መላይካ ብሬን መሰከረኖስ። <verse eid="LUK 12:8"/><verse number="9" style="v" sid="LUK 12:9"/>ህትን መን ብሬን ለገአኖኤሀኒሃ አኒሁ መገን መላይከ ብሬን ለገኣንስ።<verse eid="LUK 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 12:10"/>ህትን መንች ቤት አሌን ቦሮር ላገተ ጠወአኖሀኒሃ ጉዕሚንከ ጩቡስ ማረመኖስ፤ ጠዉ እኮጎሬ ጠሊለ አያን አሌን ቦሮር ላገተ ጠወአኖሀኒሃ ጩቡስ ሆሮን ማረመኖስበአ።<note caller="-" style="x"><char style="xo" closed="false">12፥10 </char><char style="xt" closed="false"><ref loc="MAT 12:32">ማቶ. 12፥32</ref>፤ <ref loc="MRK 3:29">ማር. 3፥29</ref>።</char></note><verse eid="LUK 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11"/>«መኑ ጭምት ምንቤቹ፥ ገሻኖ ብርተለከ ዳኛኖ ብርተ ፍርድ ሆንጠህሰኖህዕኔ ወክት ‹ሀት ፈንቀሽናም? ህከረንገ መ ጠወዕናም?› ይቴን ጨነቀንቶኖቼ። <verse eid="LUK 12:11"/><verse number="12" style="v" sid="LUK 12:12"/>መሰንትስ ጠወኡ ሀስሰኖህዕኔሃ ህከ ወክትንከ ጠሊሉ አያኑ ኩለኖህዕኔ» ዬእ።<verse eid="LUK 12:12"/></para>
  <para style="s1">ቀባጣሞ መንች ገውመተ</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13"/>ህከን ልግብያ መን በሊች መቱ መንቹ «አስተማርቾ አንኤ ወጥ ኤሳሃ ቤሆተ አመኤ ቤቲሃ ኩል» ዬስ።<verse eid="LUK 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14"/>ጠዉ እኮጎሬ ኢስ «ኮ መንቾ! ክዕኔ አሌን ዳኛለከ ወጥ ቤሃንቹ አዕዮኤሁ አዬት?» ዬስ። <verse eid="LUK 12:14"/><verse number="15" style="v" sid="LUK 12:15"/>እስን ጉዕማንከ መኒሃ «መን ሄኡ ቀባጦስ በትኜን እህበቤቺሃ ሄዕላቻች ጉዕሚችን ጠረኝቴን አገዕርዬ» ዬሰ።<verse eid="LUK 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16"/>ኢስን መኒሃ «መቶ ቀባጣሞ መንች ኡለት አበ አቶተ አቶቶኡ። <verse eid="LUK 12:16"/><verse number="17" style="v" sid="LUK 12:17"/>ሁኩ መንቹንኩ ቀልቤንከስ ‹አቶተእ ጭም አአም ቤቹ ዮኤበእቤቺሃ መ አዕዮምጎሬ ቆሀኖኤ?› ይ ሰውዬእ። <verse eid="LUK 12:17"/><verse number="18" style="v" sid="LUK 12:18"/>እስን ‹አአሚሁ ከኒት፤ ጎተረኤ ጉዕመንከ ድጅ አልባዕሉ ጎተረ እጃራም፤ ህት አዕዮሚች ኤተሮን አቶተ ጉዕመንከ ጭምአዕይ አፉሻም። <verse eid="LUK 12:18"/><verse number="19" style="v" sid="LUK 12:19"/>አንን ነብስያኤ ኢ ነብሴቾ! ልግቤ ዘማኒሃ እካ ቀባጡት ዮሄ፤ ህካን እኮቤቺሃ ፎሎጭ! እት! አግ! ሙንደእ! ያንሴ› ዬእ። <verse eid="LUK 12:19"/><verse number="20" style="v" sid="LUK 12:20"/>ጠዉ እኮጎሬ መገኑ ‹ኩ ገዉ! ከበሬ ሀንከዕሬን ነብሳክ ኪች ሀሳም፤ ኩ ጭም አቶንት ዱንያት ጉዕሙንኩ አዬሃ እካአ?› ዬስ።<verse eid="LUK 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21"/>«ገይሀስ ዱንያተ ጭም አአን መገንሀኔን ቀባጣሙ እህቡ ጉዕሙንኩ ህትናሙሃን» ይ መት ማቁተ ኩሎሰ።<verse eid="LUK 12:21"/></para>
  <para style="s1">መገኖን አመዕኑ</para>
  <para style="r">(<ref loc="MAT 6:25-34">ማቶ. 6፥25-34</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22"/>ኢስ አሳበስ «አን ያንክዕኔ፤ ነብሴሃክዕኔ እቴነንተሀኒሃለከ አሊሀክዕኔ ኦደኤነንተሀኒሃ ኦርጨቀንቶኖቼ። <verse eid="LUK 12:22"/><verse number="23" style="v" sid="LUK 12:23"/>መሰንትስ እቴነንተሀኒች ነብሶሁ ኦድኖችን ጅስሙ በተአኖ። <verse eid="LUK 12:23"/><verse number="24" style="v" sid="LUK 12:24"/>ህንዴ ቁሬኤተ ለዕዬሰ፤ ዉጣበአ፤ ምዳበአ፤ ህትን ጭምአታ ምኑ ህከረንገ ጎተሩ ዮሰበአ፤ እሁን ቤሉ እታኢሃ መገኑ ኣሰኖሰ፤ አዕኑ ጭኦች በተኤነንተበእንዶ? <verse eid="LUK 12:24"/><verse number="25" style="v" sid="LUK 12:25"/>ህትን ክዕኔች ጨነቀም ኡሙርስ ዘማኔን መቱ በር በርጎተ አታለኖሁ አዬት? <verse eid="LUK 12:25"/><verse number="26" style="v" sid="LUK 12:26"/>ከ ቀዉ ጠወ አኢሃ አታልቴንቡረ እኬነን ዎሎ ጠዊሃ ሚሃ ሻዜነን? <verse eid="LUK 12:26"/><verse number="27" style="v" sid="LUK 12:27"/>ህትን ቦብሉት ሀት እክ ነጵታ ጎሬ ለዕዬ፤ እሰን ሆጎን ሆጋበአ፥ ደዳበአ፤ እኮጎሬ ዎሉስ ፈቅ ሱላይማን ህከን ጉዕማንከ ሎርማንከስ ህከን ቦብሎች መትሴገ ኦደዕዮበአ።<note caller="-" style="x"><char style="xo" closed="false">12፥27 </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">1 ነገ. 10፥4-7</ref>፤ <ref loc="2CH 9:3-6">2 ዱዱ. 9፥3-6</ref>።</char></note> <verse eid="LUK 12:27"/><verse number="28" style="v" sid="LUK 12:28"/>ጠዉ እኮጎሬ መገኑ ከበር ለልት ጋቴተ ጊረ ኡጄኖ አብል ህጥተ ሄንከ ኑርሰኖ እኮች አዕኑ አመዕነቱ ሆፈዕዮህዕኔሩ! ክዕኔተ ሄንከ ኑርሰኖህዕኔ እቅ!<verse eid="LUK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 12:29"/>«ህካን እኮቤቺሃ ‹መ እንታም? መ አንጋም?› ይቴነን ጉዕመ ወክት ሻዞኖቼ። <verse eid="LUK 12:29"/><verse number="30" style="v" sid="LUK 12:30"/>ህካን ጉዕመንከ ኣዱንያ አሌን ዮ መኑ ጉዕሙንኩ ሀሰኖ፤ እኮጎሬ ሀሲሰኖህዕኔሃ ክዕኔ አኑንኩክዕኔ ደገኖ። <verse eid="LUK 12:30"/><verse number="31" style="v" sid="LUK 12:31"/>አዕኑ መገን ዎምነቱ ሀሼ፤ ሀሴነንታሁ ጉዕሙንኩ ኣሰመኖህዕኔ» ዬእ።<verse eid="LUK 12:31"/></para>
  <para style="s1">ዱንያተ ጭም አኡ ገበእባሃ እሁስ</para>
  <para style="r">(<ref loc="MAT 6:19-21">ማቶ. 6፥19-21</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32"/>አዕኑ ቀዉ መሰረት! ሰሜ አኑክዕኔ ዎምነቱ ኣሶህዕኔተ ኢቴቤቺሃ ዋጅቶኖቼ። <verse eid="LUK 12:32"/><verse number="33" style="v" sid="LUK 12:33"/>ህካን እኮቤቺሃ ዮህዕኔሃ ጉዕመንከ ህርቴን ቡጥቻኖተ ኣስዬ፤ ጎፍበ ከረጥትተ መክሴን ጎፍበ ዱንያተ ኣዜስ አቴን ሞጋንቹ ኣእበቤቾንለከ ብሉት እትበቤቾን ሰማን አፉሽዬ። <verse eid="LUK 12:33"/><verse number="34" style="v" sid="LUK 12:34"/>መሰንትስ ዱንያክዕኔ ሄኣቤቾን ህከኔ ቀልቡክዕኔ ሄአኖ።<verse eid="LUK 12:34"/></para>
  <para style="s1">ጠረኘ ካዲንቹ</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35"/>ኢስ «ረመዙክዕኔ ኡሱርቴን ኑሩክዕኔ ለሌኢሃ እሁን።<note caller="-" style="x"><char style="xo" closed="false">12፥35 </char><char style="xt" closed="false"><ref loc="MAT 25:1-13">ማቶ. 25፥1-13</ref>።</char></note> <verse eid="LUK 12:35"/><verse number="36" style="v" sid="LUK 12:36"/>ህትን ቀርቹሰ አሜች ኡሩተ ቆጬ ወክት ፈንቶተ ቦለች ምኒች ፈንቀል አሜቶተ ኢለ ጠረኝ አገረኖ መነ እኬ።<note caller="-" style="x"><char style="xo" closed="false">12፥36 </char><char style="xt" closed="false"><ref loc="MRK 13:34-36">ማር. 13፥34-36</ref>።</char></note> <verse eid="LUK 12:36"/><verse number="37" style="v" sid="LUK 12:37"/>ቀርቹሰ አሜቾ ወክት ተቃጠብ አገርተን ደገኖሰ ካዲመት ማሰአንቶእረ፤ ሀንቅንከ ያንክዕኔ፤ እስን ረመዙስ ኡሱር ማዳን አፉሽ ካደመን እትሰኖሰ። <verse eid="LUK 12:37"/><verse number="38" style="v" sid="LUK 12:38"/>አይደጎ ቀርቹሰ ሀንከዕሬ በላን ህከረንገ ሀንከዕሬ በሊች ኤተሮን አሜቾ ወክት ጠረኝት አገርተን ደገኖ ካዲመት ማሰአንቶእረ። <verse eid="LUK 12:38"/><verse number="39" style="v" sid="LUK 12:39"/>ጠዉ እኮጎሬ ካን ደጌ፤ መቱ መንቹ ምንስ ሞጋንቹ መ ወክት አሜተኖጎሬ ደጎእቀ ምንስ እሞተ ሰዕምይ አጉረኖበ እቅ።<note caller="-" style="x"><char style="xo" closed="false">12፥39 </char><char style="xt" closed="false"><ref loc="MAT 24:43-44">ማቶ. 24፥43-44</ref>።</char></note> <verse eid="LUK 12:39"/><verse number="40" style="v" sid="LUK 12:40"/>ህትን መንች ቤቱ ሰውይቴንበ ወክት አሜተኖቤቺሃ አዕኑሁ ተቃጠቤን አገሬ» ዬሰ።<verse eid="LUK 12:40"/></para>
  <para style="s1">ጡመ ካዲንችለከ ሂለ ካዲንች ምሳልተ</para>
  <para style="r">(<ref loc="MAT 24:45-51">ማቶ. 24፥45-51</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41"/>ጴጥሮስን «ቀርቾ! ከ ምሳልተ ጠወኣንቲሁ ኒሳህትንዶ? ህከረንገ ጉዕሚሃንት?» ዬእ።<verse eid="LUK 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42"/>ቀርቹንኩ ፈንቀሽ «ህካን እኮች በሬ በሬተ እታኢሃ ወክቲን አሶሰተ ቀርቹ ካዲመስ አሌን ዳኛ አአኖ አመዕነሞ ቀልባሙ መንቹ አዬት? <verse eid="LUK 12:42"/><verse number="43" style="v" sid="LUK 12:43"/>ቀርቹስ አሜች ዬስገ አአን ደገኖስ ሁኩ ካዲንቹ ማሰአሞእሃን። <verse eid="LUK 12:43"/><verse number="44" style="v" sid="LUK 12:44"/>ሀንቅንከ ያንክዕኔ፤ ቀርቹስ ህከ ካዲንቹ ዮስ ዱንያንተስ ጉዕማንን ዳኛ አአኖስ። <verse eid="LUK 12:44"/><verse number="45" style="v" sid="LUK 12:45"/>ጠዉ እኮጎሬ ሁኩ ካዲንቹ ቀልቤንከስ ‹ቀርቹኤ አሜቱዕናን ዱንከኖ› ይ ሜንትለከ ጎን ካዲመተ ኦለን እቱ፥ አጉለከ ሰከሩ ጀመሮረ <verse eid="LUK 12:45"/><verse number="46" style="v" sid="LUK 12:46"/>ህከን ካዲንች ቀርቹ ‹አሜተኖ› ይ አገርበ በሬንለከ ደጎበእ ሰኣቴን ድንገቴን አሜች ቀጠዕይ አመዕነሞበእ መኒን ሜጡበ አአኖስ።<verse eid="LUK 12:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47"/>«ቀርች ሰውት ደገን ተቃጠብቡለከ ቀርቹስ ሀሾ ሃሊን አእቡ ካዲንቹ አበ ገረፈመኖ። <verse eid="LUK 12:47"/><verse number="48" style="v" sid="LUK 12:48"/>እኮጎሬ ቀርችስ ሰውት ደጉዕናን ቀጠአመኖ ሆጉተ አአኖ ካዲንቹ ቀዉ ገረፈመኖ፤ መሰንትስ ልግብ ጠወ ኣሴመስ መንቺች ልግብንከ ሀሴኖ፤ ህትን ልግብ ኤገተ ኣሴመ መንቺች ልግብንከ ኣኦኖተ ሀሴኖስ» ዬእ።<verse eid="LUK 12:48"/></para>
  <para style="s1">ጉዕመርቹ አጉሬን ኢሰ አዎኑ</para>
  <para style="r">(<ref loc="MAT 10:34-36">ማቶ. 10፥34-36</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49"/>ኢስ «አን ኣዱንያ አሌን ጊረተ አፍሲሶተ አሜቾም፤ ህካን እኮቤቺሃ ደዕልት አጵቶ እቃ ሄንከ ኢታም እቅ። <verse eid="LUK 12:49"/><verse number="50" style="v" sid="LUK 12:50"/>ጠዉ እኮጎሬ መቱ ጠመቀማም ኦርሸ ጥምቀቱ ዮኤ፤ እስን እሆተ ኢለ ጨነቀሞም።<note caller="-" style="x"><char style="xo" closed="false">12፥50 </char><char style="xt" closed="false"><ref loc="MRK 10:38">ማር. 10፥38</ref>።</char></note> <verse eid="LUK 12:50"/><verse number="51" style="v" sid="LUK 12:51"/>አን ወገሬት ኤቦተ ኣዱንያ አሊሃ አሜቾሚሃ አጉደኖህዕኔንዶ? ህትጎተበአ፤ ሀንቅስ ጠወኣንክዕኔ፤ አን አሜቾሚሁ አደዶመተ ኤቦታት። <verse eid="LUK 12:51"/><verse number="52" style="v" sid="LUK 12:52"/>ከበሬች ኬሽ መቶ ምኔን ሄኣ ኦንቶ መኒች ሰሱሰ ለም አሌን ህትን ለሙሰ ሰስ አሌን ኬእ ብተንታአ። <verse eid="LUK 12:52"/><verse number="53" style="v" sid="LUK 12:53"/>ህትን አኑ ቤትስ አሌን፥ ቤቱንኩ አንስ አሌን፥ አመንት ቤቶሴ አሌን፥ ቤቱንት አመሴ አሌን፥ በሉት ቤት ጫ አሌን፥ ቤት ጫንት በሎሴ አሌን ኬእ አደደ እካአ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">12፥53 </char><char style="xt" closed="false"><ref loc="MIC 7:6">ሚክ. 7፥6</ref>።</char></note><verse eid="LUK 12:53"/></para>
  <para style="s1">ወክትስ ጠወ ደጉ</para>
  <para style="r">(<ref loc="MAT 16:2-3">ማቶ. 16፥2-3</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54"/>ኢስ ኡመቲሃ «ጎመት ገርብ አዲን ኬአን ለኤንተ ወክት ከበር ‹ጤነ ኡቦታት› ይቴነንተ፤ ይቴንተገን እሀኖ። <verse eid="LUK 12:54"/><verse number="55" style="v" sid="LUK 12:55"/>ህትን ከኣጵ አዲን ቦብርሰን ለኤንተ ወክት ‹አበ ፋረተ እሆታት› ይቴነንተ፤ እስን ይቴንተገን እሀኖ። <verse eid="LUK 12:55"/><verse number="56" style="v" sid="LUK 12:56"/>አዕኑ ኩ ለዕዬኔ! ለዕዬኔ! ይቴነንተሩ ሰሜለከ ኡለ ጠወ ለኤን አደደ አቴን ደጌነንተ፤ ጠዉ እኮጎሬ ሚሃት ከን ዘማኔን እሀኖ ጠወ አደ አቴን ደጌነንተበኢሁ?» ዬሰ።<verse eid="LUK 12:56"/></para>
  <para style="s1">ዲነ ኢቱ</para>
  <para style="r">(<ref loc="MAT 5:25-26">ማቶ. 5፥25-26</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57"/>ኢስ «አዕኑ ገዉክዕኔ ሚሃት ሀንቅ እኮ ጠወ ፈረዴነንተበአ? <verse eid="LUK 12:57"/><verse number="58" style="v" sid="LUK 12:58"/>ባለጋርንከክ ሜጡበ ዳኝቤቹ መርታንት ወክት ዎቃን ሀራዕረም፤ ህካን እህባች ባላጋሩክ ዳኝበ መሴሃን ዳኙንኩ ወታደሪሃ ህግሽ ኣሰኖሄ፤ ህትን ወታደሩንኩ ኡሱር ምኒ ኣግሰኖሄ። <verse eid="LUK 12:58"/><verse number="59" style="v" sid="LUK 12:59"/>ሀንቅንከ ያንኬ፤ መቱርቹሁ ፈቁዕነ ባቱዕናን ህከን ኡሱር ምኒች ሆሮ ፉልታንትበአ» ዬእ።<verse eid="LUK 12:59"/></para>
  <chapter eid="LUK 12"/>
  <chapter number="13" style="c" sid="LUK 13"/>
  <para style="s1">ጩብስ ቶበትባሁ በአኖሃ እሁስ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1"/>ህከ ወክት መኑ አሜች «ገሊለ ባድ መነ ክትመ ሆንጠህሰን ጲላጦስ ሽኬዕይ ቄጉሰ ክትምንከሰ ሜጡበ ሊቃልቆ» ይት ኢሲሃ ኩልቶኡ። <verse eid="LUK 13:1"/><verse number="2" style="v" sid="LUK 13:2"/>ኢስን ፈንቀሽ «ገሊል ባድ መኑ ህትኔ በኡ እሌሰቤቺሃ ገሊለ ባዶን ዮ ዎሎ መኒች ጉዕሚችን አበ ጩበኛኑተ አጉዳህዕኔትንዶ? <verse eid="LUK 13:2"/><verse number="3" style="v" sid="LUK 13:3"/>አን ኩለንኪዕኔ፤ ህትጎተበአ፤ ጠዉ እኮጎሬ ቶበቴንባች አዕኑ ጉዕሙንኩክዕኔ ህትን በኤነንተ። <verse eid="LUK 13:3"/><verse number="4" style="v" sid="LUK 13:4"/>ህትን ‹ሰልሆመ› ዬኖቤቾን ሎሩ ግንቡ አሌሰ ኡብ ሼ ቶነ ህዜቱ መንቹ ዬሩሰሌማን ሄኣ ዎሎ መኒች ጉዕሚችን በትስ ጩበኛኑተ አጉዳህዕኔትንዶ? <verse eid="LUK 13:4"/><verse number="5" style="v" sid="LUK 13:5"/>አን ኩላንክዕኔ፤ ህትጎተበአ፤ ጠዉ እኮጎሬ ቶበቴንበጎሬ አዕኑ ጉዕሙንኩክዕኔ ህትን በኤነንተ» ዬሰ።<verse eid="LUK 13:5"/></para>
  <para style="s1">ላልቹ ላልትበ ኦድ ሀቁቾ ምሳልተ</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6"/>ኢስ «መቶ መንች ጋሮስ ኣዜን ሄኦ ሀቅ በላን መት ኦድ ሀቁቹት ሄኦ እቅ፤ እስን ላልቹ ሀሽ እሴቤቹ አሜቾ ወክት መቱርቹሃ ደጎበአ። <verse eid="LUK 13:6"/><verse number="7" style="v" sid="LUK 13:7"/>ህካን እኮቤቺሃ እስን ህከን ሆጉተ አአኖ መንቺሃ ‹ከለእ! ከን ሰሶ ዘማኔን ተን ኦድ ሀቁቾች ላልቹ ሀሽ መቱርቹሃ ደጎምበአ፤ ሙርት ከም፤ ሚሃ ኡለተ ቤሳአ?› ዬስ። <verse eid="LUK 13:7"/><verse number="8" style="v" sid="LUK 13:8"/>ሆጉተ አአኖንኩ ‹ቀርቾ! ፎቀሴ ሀረሞተለከ መዳበራ ዎሮተ ጠለዕል ከዘማኔተ አጉር። <verse eid="LUK 13:8"/><verse number="9" style="v" sid="LUK 13:9"/>አሜተኖ ዘማን ላልቹ ላልቶጎሬ ጡመሃን፤ ጠዉ እኮጎሬ ላልትበ ጎሬ ሙርቶተ አታልታንት› ይ ፈንቀሼስ» ይኬዕይ ተ ምሳልተ ኩሎሰ።<verse eid="LUK 13:9"/></para>
  <para style="s1">ጉብራይቶ መንቹተ ኢስ ፈይሱስ</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10"/>ኢስ አበ በሬን ጭምት ምናች መቶንከስ ተማርሰኖት እቅ። <verse eid="LUK 13:10"/><verse number="11" style="v" sid="LUK 13:11"/>ህከኔን ቶነ ህዜቱ ዘማን ዶሮረኖ ዱሩ ጉብራይሾሴ መት መንቹት ሄኦ እቅ፤ እሴን ጌጥ ይት ኡርቶተ ሆሮን አታልታበ እቅ። <verse eid="LUK 13:11"/><verse number="12" style="v" sid="LUK 13:12"/>ኢስን ለዕዮሴ ወክት እስቤቹ ገእ «መንቾ! ሆግሳሄ ጥዘናች ፈይቶንት» ይ <verse eid="LUK 13:12"/><verse number="13" style="v" sid="LUK 13:13"/>አንገስ አሌንከሴ አዕዮ፤ ህከ ወክቲንከ ጌጥ ይት ኡርት መገኑ ገለትጭቶኡ።<verse eid="LUK 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14"/>ጠዉ እኮጎሬ ኢስ አበ በሬን ፈይሾሴቤቺሃ ህከን ጭምት ምኒ ገሻንቹ ኡሙዕር መኒሀስ «ሳምንታን ሆጉተ አኤኖ ሌሁ በሩ ዮኡ፤ ህከን በሬን አሜቴነን ፈይዬ ቤሉ አበ በሬን አታልሲሰኖበአ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">13፥14 </char><char style="xt" closed="false"><ref loc="EXO 20:9-10">ፉል. 20፥9-10</ref>፤ <ref loc="DEU 5:13-14">ዘዳ. 5፥13-14</ref>።</char></note><verse eid="LUK 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15"/>ህከኒች ኤተሮን ኢስ ፈንቀሽ «ኩ ለዕዬኔ ለዕዬኔ ይቴነንተሩ! ክዕኔች መት-መትችክዕኔ አበ በሬን ቦረስ ጋድሪች ህከረንገ ሀርስ ጎሊች ሂር ዋሃ አግሶተ መሰኖበእንዶ? <verse eid="LUK 13:15"/><verse number="16" style="v" sid="LUK 13:16"/>ት ጫት ቶነ ህዜቱ ዘማን ሸይጣኑ ኡሱራንሴ ሄኦ እብራሂምተ ቤቱ፤ እሴን አበ በሬን ኡሱሮችሴ ሂርተኡ ሀስሰኖሴበእንዶ?» ዬስ። <verse eid="LUK 13:16"/><verse number="17" style="v" sid="LUK 13:17"/>ኢስ ህካን ጠወአንን እሲን ሀንበዕለንተ መኑ ጉዕሙንኩ ሙልቶኡ፤ ህትን መኑ ጉዕሙንኩ ኢስ አዕዮ አጀብሲሰኖ ጠዋን ጉዕማንን አበ ሙንደኦኡ።<verse eid="LUK 13:17"/></para>
  <para style="s1">ዎንጌ እሌ ዜሬት ምሳልተ</para>
  <para style="r">(<ref loc="MAT 13:31-32">ማቶ. 13፥31-32</ref>፤ <ref loc="MRK 4:30-32">ማር. 4፥30-32</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18"/>ህከኒች ኤተሮን ኢስ «መገን ዎምነቱ መ አጉደኖ? ህትን አን ሚን አጉጣቀንሳንስ? <verse eid="LUK 13:18"/><verse number="19" style="v" sid="LUK 13:19"/>መገን ዎምነቱ መቱ መንቹ ጋሮስ ዉጮ ወንጌ እልተ አጉደኖ፤ እሴን ነጵት ሀቅ ጌሰ እካአ፤ ሰሜ ጪኡት ሀማንከስ ምኒ እጃርታአ» ዬእ።<verse eid="LUK 13:19"/></para>
  <para style="s1">ራጭት ምሳልተ</para>
  <para style="r">(<ref loc="MAT 13:33">ማቶ. 13፥33</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20"/>ለንኪሃ ኢስ «መገን ዎምነቱ ሚን አጉጣቀንሳም? <verse eid="LUK 13:20"/><verse number="21" style="v" sid="LUK 13:21"/>መገን ዎምነቱ መት መንቹት ሰሶ ኮርቦቦ ዊሙ ቀሙ ሁፍ ዮተ ቀማንከስ ቁስቶ ራጭተ አጉደኖ» ዬእ።<verse eid="LUK 13:21"/></para>
  <para style="s1">ሩካሸ ዎቄተኔሃ</para>
  <para style="r">(<ref loc="MAT 7:13-14">ማቶ. 7፥13-14</ref>፤ <ref loc="MAT 21-23">21—23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22"/>ኢስ ዬሩሳሌመ መረን ከተማንለከ ገጠራን ጉዕማንን ተማርሰን ህገኖት እቅ። <verse eid="LUK 13:22"/><verse number="23" style="v" sid="LUK 13:23"/>ህከ ወክት መቱ መንቹ «ቀርቾ! ጡምታእሩ ቀዉሃ መነንዶ?» ይ ጠዕሜሰ፤ ኢስን <verse eid="LUK 13:23"/><verse number="24" style="v" sid="LUK 13:24"/>«ሩካሸ ኡሮን ኣጎኖተ ሄጫቀሜ፤ መሰንትስ ልግቡ መኑ ህከን ኡሮን ኣጎተ ሀስ አታልታበእገ ኩላንክዕኔ። <verse eid="LUK 13:24"/><verse number="25" style="v" sid="LUK 13:25"/>ምንስ አኑ ኬዕይ ኡሩስ ጡፍ ከሞች ኤተሮን አዕኑ አብልን ኡርቴን ኡሩተ ቆጭቴነን ‹ቀርቾ! ፈንኔ!› ይቴነንተ፤ እስን ፈንቀሽ ‹ሀከን አዲች አሜቴንተጎር ደጋንክዕኔበአ› የኖህዕኔ። <verse eid="LUK 13:25"/><verse number="26" style="v" sid="LUK 13:26"/>ህከ ወክት አዕኑ ‹ብሬክ እንቶም፥ አንጎም፤ ህትን በነቻንተኔን ተማርስቶንትኔ› ይቴነንተ። <verse eid="LUK 13:26"/><verse number="27" style="v" sid="LUK 13:27"/>ጠዉ እኮጎሬ እስ ‹አን ያንክዕኔ፤ ሀከን አዲች አሜቴንተጎር ደጋንክዕነበአ፤ አዕኑ ሂለ ጠወ አቴነንተሩ ጉዕሙንኩክዕኔ ኢ መዲች ሽቄ› የኖህዕኔ።<note caller="-" style="x"><char style="xo" closed="false">13፥27 </char><char style="xt" closed="false"><ref loc="PSA 6:8">መዝ. 6፥8</ref>።</char></note> <verse eid="LUK 13:27"/><verse number="28" style="v" sid="LUK 13:28"/>አዕኑ እብራሂመ፥ ኢሳቀለከ ያቁበ ጉዕመንከ ነብያከተ መገን ዎምነቴን ለኤን አዕኑ አብሌን ፈቁክዕኔ ደጌንተ ወክት ህከኔን ኦኡለከ እንኩተ እጡ እሀኖህዕኔ።<note caller="-" style="x"><char style="xo" closed="false">13፥28 </char><char style="xt" closed="false"><ref loc="MAT 22:13">ማቶ. 22፥13</ref>፤ <ref loc="MAT 25:30">25፥30</ref>።</char></note> <verse eid="LUK 13:28"/><verse number="29" style="v" sid="LUK 13:29"/>ህትን ልግቡ መኑ ሸርቂች፥ ገርቢች፥ ቅልቢችለከ ከኣጵ አዲች አሜት መገን ዎምነት ማዳን አፉዕልታአ።<note caller="-" style="x"><char style="xo" closed="false">13፥29 </char><char style="xt" closed="false"><ref loc="MAT 8:11-12">ማቶ. 8፥11-12</ref>።</char></note> <verse eid="LUK 13:29"/><verse number="30" style="v" sid="LUK 13:30"/>ህካን እኮቤቺሃ ኤተራኑት ብራኑተ ህትን ብራኑት ኤተራኑተ እካእሩ ዮኡ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">13፥30 </char><char style="xt" closed="false"><ref loc="MAT 19:30">ማቶ. 19፥30</ref>፤ <ref loc="MAT 20:16">20፥16</ref>፤ <ref loc="MRK 10:31">ማር. 10፥31</ref>።</char></note><verse eid="LUK 13:30"/></para>
  <para style="s1">ኢስ ዬሩሳሌሚሃ ኦኡስ</para>
  <para style="r">(<ref loc="MAT 23:37-39">ማቶ. 23፥37-39</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31"/>ህከ ወክት ፈርሳዌች መት-መቱ መኑ አሜት ኢሰ «ሄሮድስ ሾተ ሀሰኖቤቺሃ ከንቤቺች ፉልት ኦሮእ» ይቶስ።<verse eid="LUK 13:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32"/>እስን «ህከን ወለንጌቺሃ መርቴን ‹ከበርለከ ጋታ ሩሃንየ ፉሻም፤ ጥዘናመንተ ፈይሳም፤ ሰቅ በር ሆጉእ ሹዕላም› የኖት ይቴን ኩሌስ። <verse eid="LUK 13:32"/><verse number="33" style="v" sid="LUK 13:33"/>ጠዉ እኮጎሬ ነብዬቹ ዬሩሳለም ቤሉ ሬሁ ገበእበስቤቺሃ ከበር ጋተለከ ጋቶሽ ዬሩሳሌመ ኦሮኦተ ዎቄ አሌን እሁ ሀስሰኖኤ።<verse eid="LUK 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34"/>«ዬሩሳሌማ! ዬሩሳሌማ! ነብያከተ ሽታንቲት! ኪበ ሶሃንቶእረ ክኒን ቀሳንቲት! ሀንጠቤቹት ጭጮረሴ ጎኔንተሴ ጭም አታገን አን እለክ ጭምአኦተ ሀሾሚሁ ሄንከ ወክትዪት? ጠዉ እኮጎሬ አዕኑ ህካን ሀሴንታበአ። <verse eid="LUK 13:34"/><verse number="35" style="v" sid="LUK 13:35"/>ህካን እኮቤቺሃ ምኑክዕኔ ኦነ እሀኖ፤ አን ኩላንክዕኔ፤ ‹ቀርች ሱዕሚን አሜተኖሁ ማሰአሞኢሃን› ይቶኖተ ኢለ ከኒች ኤተሮን ለኤነንተኤበአ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">13፥35 </char><char style="xt" closed="false"><ref loc="PSA 118:26">መዝ. 118፥26</ref>፤ <ref loc="JER 22:5">ኤር. 22፥5</ref>።</char></note><verse eid="LUK 13:35"/></para>
  <chapter eid="LUK 13"/>
  <chapter number="14" style="c" sid="LUK 14"/>
  <para style="s1">ኢስ ለንኪሃ አበ በሬን ፈይሱስ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1"/>መቶ አበ በሬን ኢስ ፈርሳዌ አዎንሳኖች መትስ ምኔን ሆሹ እቶተ ኣጎ እቅ፤ እሰን መ አአኖ ጎር ለኦተ አገርታኢት እቅ። <verse eid="LUK 14:1"/><verse number="2" style="v" sid="LUK 14:2"/>ህከኔን አሉስ ደርሽዮ መቱ መንቹ ብሬስ ሄዕዮ እቅ። <verse eid="LUK 14:2"/><verse number="3" style="v" sid="LUK 14:3"/>ኢስን መገን ሕገ ደጋረለከ ፈርሳውተ «አበ በሬን ፈይሱ ሀስሰኖንዶ ሀስሰኖበአ?» ይ ጠዕሜእ።<verse eid="LUK 14:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 14:4"/>ጠዉ እኮጎሬ እሰ ጨለ ይቶኡ፤ ህከኒች ኤተሮን ኢስ ህከ ጥዘናሙ አፍ ፈዪሽ ህርሲሾስ። <verse eid="LUK 14:4"/><verse number="5" style="v" sid="LUK 14:5"/>ኢስን «ክዕኔች ቤቱስ ህከረንገ ቦሩስ አበ በሬን ኤሎን ኡቦጎሬ ህከ ወክት ኤሌች ፉሸኖበኢሁ አዬት?» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">14፥5 </char><char style="xt" closed="false"><ref loc="MAT 12:11">ማቶ. 12፥11</ref>።</char></note> <verse eid="LUK 14:5"/><verse number="6" style="v" sid="LUK 14:6"/>እሰ ህከን ጠዊሃ መቱርቹሃ ፈንቀሽቶተ አታልቶበአ።<verse eid="LUK 14:6"/></para>
  <para style="s1">ገዉ ሆፍስተኔሃ</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7"/>ገኤመ መኑ ኬዕምኝ ቤቾን አፉዕልቶተ መጠርተን ኢስ ለዕይ <verse eid="LUK 14:7"/><verse number="8" style="v" sid="LUK 14:8"/>«አዪሁ ቦለቸ ገኤሄ ወክት ኬዕምኝ ቤቾን አፉዕልቶት፤ መሰንትስ አይደጎ ኪች ሎዕረኖ መንቹ ገኤማሃ እሀኖ፤ <verse eid="LUK 14:8"/><verse number="9" style="v" sid="LUK 14:9"/>ለሙንከክዕኔ ገኤ መንቹ ኪቤቹ አሜች ‹ከቤቹ ከን መንቺሃ ኣስ› የኖሄ፤ ህከ ወክት ሙልት ቀዎ ቤቾን አፉዕልታንት። <verse eid="LUK 14:9"/><verse number="10" style="v" sid="LUK 14:10"/>ጠዉ እኮጎሬ ቦለቸ ገኤመሄ ወክት ቀዎ ቤቾን አፉዕል፤ ገኤሄ መንቹ ኪቤቹ አሜች ‹ኢ ጃለ! ኬዕምኝ ቤቾን አፉዕል› የኖሄ፤ ህከ ወክት ኪን ሜጡበ ማዳን አፉዕሌ መን ብሬን ኬዕምኝ ደእታንት። <verse eid="LUK 14:10"/><verse number="11" style="v" sid="LUK 14:11"/>መሰንትስ ገዉስ ሎርሰኖሁ ጉዕሙንኩ ሆፈአኖ፤ እኮጎሬ ገዉስ ሆፍሰኖሁ ኬዕምኝ ደአኖ» ይ መት ምሳልተ ኩሎሰ።<note caller="-" style="x"><char style="xo" closed="false">14፥11 </char><char style="xt" closed="false"><ref loc="MAT 23:12">ማቶ. 23፥12</ref>፤ <ref loc="LUK 18:1">ሉቃ. 18፥1</ref>።</char></note> <verse eid="LUK 14:11"/><verse number="12" style="v" sid="LUK 14:12"/>ህትን ኢስ እሱ ገኤ መንቹ «ሆሹ ህከረንገ ሁርባት ተቃጠቦንት ወክት እሰ አይደጎ ፈንቀሽት ገእት ሌቃ ባትበገ ጃላክ ህከረንገ አመክ ኦሱተ ህከረንገ እሉክ ህከረንገ ቀባጣሙ ቀኤክ መነ ገእቶት። <verse eid="LUK 14:12"/><verse number="13" style="v" sid="LUK 14:13"/>ጠዉ እኮጎሬ ድግሰ ድግሳንት ወክት ቡጥቻኑተ፥ አንገተ ሎከተ ሙርተኦእረ፥ ናፋኑተለከ ቆቃኑተ ገእ። <verse eid="LUK 14:13"/><verse number="14" style="v" sid="LUK 14:14"/>ህካን አቶንትጎር አቶንቲሃ ባቶተ አታልታበእቤቺሃ ማሰአንቶንቲሃ እካንት፤ ህትን ፈዩ መኑ ሬሆች ኬኣ ወክት መገኑ ባተኖሄ» ዬስ።<verse eid="LUK 14:14"/></para>
  <para style="s1">አበ ድግስ ምሳልተ</para>
  <para style="r">(<ref loc="MAT 22:1-10">ማቶ. 22፥1-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15"/>ኢሲን ሜጡበ ማዳን አፉልቶሀኑኡች መቱ ህካን ሞጮጬ ወክት «መገን ዎምነቴን ማዳን እተኖሁ ሀት ማሰአሞእሃን!» ዬስ።<verse eid="LUK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16"/>ጠዉ እኮጎሬ ኢስ ፈንቀሽ «መቱ ወክት መቱ መንቹ ሁርባት ድግሰ ቅጥ አዕይ ልግብ መነ ገኤእ። <verse eid="LUK 14:16"/><verse number="17" style="v" sid="LUK 14:17"/>ሁርባት እቴኖ ወክቱ እካን ‹ቴሱ ጉዕሙርቹንኩ ቅጥዬቤቺሃ አሜ› ዮተ ካድንቹስ ገኤመ መንቤቹ ሶኮስ። <verse eid="LUK 14:17"/><verse number="18" style="v" sid="LUK 14:18"/>ጠዉ እኮጎሬ ገኤመ መኑ ጉዕሙንኩ መቲን መቲን ድግሰስ ፈቆተ ሄዕላት መሰተ ኩሉ ጀመርቶኡ፤ መቱስ ‹ኡለተ ህዕሬምቤቺሃ መር ለኡ ሀስሰኖኤ፤ ህካን እኮቤቺሃ ኤገተክ መረርሲጬኤ› ዬስ። <verse eid="LUK 14:18"/><verse number="19" style="v" sid="LUK 14:19"/>ህትን ዎሉስ ‹ኦንቶ ጥንድ ቦረተ ህዕሬምቤቺሃ አቡርታገ ለኦተ መራሚት፤ ህካን እኮቤቺሃ ኤገተክ መረርሲጬኤ› ዬእ። <verse eid="LUK 14:19"/><verse number="20" style="v" sid="LUK 14:20"/>ህትን ዎሉስ ‹ጫተ ኤብ እዜቹ እኮምቤቺሃ አሜቶተ አታላምበአ› ዬእ።<verse eid="LUK 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 14:21"/>«ሁኩ ካድንቹንኩ አሜች ህካን ጉዕመንከ ቀርቺሃስ ኩሎ፤ ህከ ወክት ምንስ መንቹ ኡሙዕር ካድንቹንከስ ‹ደዕልት ከተም ዎቃሀ፥ በል ዎቃሀ መርት ቡጥቻኑተ፥ አንገተ ሎከተ ሙርተኦእረ፥ ቆቃኑተለከ ናፋኑተ ኤብ ኣግስ› ዬስ። <verse eid="LUK 14:21"/><verse number="22" style="v" sid="LUK 14:22"/>ካድንቹንኩ ‹ቀርቾ! አዘዞንቴኤገን አዕዮም፤ እኮጎሬ ቴሁ ፈቆ ቤቹ ዮኡ› ዬእ። <verse eid="LUK 14:22"/><verse number="23" style="v" sid="LUK 14:23"/>ቀርቹንኩ ካዲንቺሀስ ‹ገጠር ዎቃለከ በል ዎቃሃ መርት ምኑኤ ዊሞተ ኢለ መኑ አሜተኖገ አእ። <verse eid="LUK 14:23"/><verse number="24" style="v" sid="LUK 14:24"/>መሰንትስ አን ያንክዕኔ፤ ህከን ገአሞ መኒች መቱሁ ሁርበቲችኤ ቀመሰኖበአ› ዬእ» ዬሰ።<verse eid="LUK 14:24"/></para>
  <para style="s1">ኢሰ አዎኑ ዋገ ባትሲሰኖ እሁስ</para>
  <para style="r">(<ref loc="MAT 10:37-38">ማቶ. 10፥37-38</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25"/>ልግቡ መኑ ኢሲን ሜጡበ ሃመኖት እቅ፤ እስን መን አደ ፈንቀል <verse eid="LUK 14:25"/><verse number="26" style="v" sid="LUK 14:26"/>«ኢቤቹ አሜተኖሁ ጉዕሙንኩ አነስ፥ አመስ፥ ጫስ፥ እለስ፥ አመስ ኦሱተለከ ዎሉ ፈቅ ገይስ ፎሉ ፈቁዕነ ለገእበጎር አዎኖኤተ አታለኖበአ።<note caller="-" style="x"><char style="xo" closed="false">14፥26 </char><char style="xt" closed="false"><ref loc="MAT 10:37">ማቶ. 10፥37</ref>።</char></note> <verse eid="LUK 14:26"/><verse number="27" style="v" sid="LUK 14:27"/>ህትን አዪሁ መስቀለስ እጅ አዎንበኤሁ አዎናንቹኤ እሆተ አታለኖበአ።<note caller="-" style="x"><char style="xo" closed="false">14፥27 </char><char style="xt" closed="false"><ref loc="MAT 10:38">ማቶ. 10፥38</ref>፤ <ref loc="MAT 16:24">16፥24</ref>፤ <ref loc="MRK 8:34">ማር. 8፥34</ref>፤ <ref loc="LUK 9:23">ሉቃ. 9፥23</ref>።</char></note><verse eid="LUK 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28"/>«ክዕኔች ግንበ እጃሮተ ሀሾ መንቹ ወዕና አፉዕል እጃር ሹልሲሰኖ ብሩ ዮ ጎሬ ይ ሰው ይባሁ አዬት? <verse eid="LUK 14:28"/><verse number="29" style="v" sid="LUK 14:29"/>ህካን እህባች ቀበበ ጀመር ሹል እጃሩ አታልባች ለዕዮሁ ጉዕሙንኩ <verse eid="LUK 14:29"/><verse number="30" style="v" sid="LUK 14:30"/>‹ኩ መንቹ እጃሮተ ጀመር ሹሉ ሆጎ› ይተን ቀለዳስ።<verse eid="LUK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31"/>ህትን «ቶኖ ኩሜ ወታደሩ ዮስ ዎሙ ለሞድመ ኩሜ ወታደረ አፍ አሜተኖ ዎሚን ኦለሞተ አታለኖንዶ? ኦልሃ መሩዕነ ሄጭ አፉዕል አማዕለመኖበእንዶ? <verse eid="LUK 14:31"/><verse number="32" style="v" sid="LUK 14:32"/>ህካን እህባች ኦሊሃ አሜተኖ ወሙ ቄዕራሻን ሄዕዮገን ወገሬት ሶቀማኑተ ሶክ ሀራዕረሞተ ኡጨኖ። <verse eid="LUK 14:32"/><verse number="33" style="v" sid="LUK 14:33"/>ህትን ዮሲሃ ጉዕመንከ አጉርባሁ አዪሁ አዎናንቹኤ እሆተ አታለኖበአ» ዬሰ።<verse eid="LUK 14:33"/></para>
  <para style="s1">ደግለልትበ መጥኔተኔሃ</para>
  <para style="r">(<ref loc="MAT 5:13">ማቶ. 5፥13</ref>፤ <ref loc="MRK 9:50">ማር. 9፥50</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34"/>ቴሁ ኢስ «መጥንት ጡመታን፤ ጠዉ እኮጎሬ መጥንት ጤዕበ ጎሬ ጤኣገ ሚን አኦኖተ አታሌኖ? <verse eid="LUK 14:34"/><verse number="35" style="v" sid="LUK 14:35"/>ህትናምት መጥንት ኡላተ መዳበረ እክ ደግለልታበእቤቺሃ ፉሼን አብሌን ኡጄኖስ፤ ሞጮጭታ መጨት ዮሲሁ ሞጮጩን» ዬሰ።<verse eid="LUK 14:35"/></para>
  <chapter eid="LUK 14"/>
  <chapter number="15" style="c" sid="LUK 15"/>
  <para style="s1">በዕይ ደገሞ ሆልች ምሳልተ</para>
  <para style="r">(<ref loc="MAT 18:12-14">ማቶ. 18፥12-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1"/>መቱ ወክት ቀረጠ ሙርታእሩለከ ጩበኛኑት ጉዕሙንኩ ኢሲች ሞጮጭቶተ ሆንጠካኢት እቅ። <verse eid="LUK 15:1"/><verse number="2" style="v" sid="LUK 15:2"/>ጠዉ እኮጎሬ ፈርሳውትለከ ሕግ አስተማረት «ኩ መንቹ ጩበኛኑተ ቶግ እሳን ሜጡበ እተኖት» ይት ቁንቁቶኡ።<note caller="-" style="x"><char style="xo" closed="false">15፥2 </char><char style="xt" closed="false"><ref loc="LUK 5:29-30">ሉቃ. 5፥29-30</ref>።</char></note> <verse eid="LUK 15:2"/><verse number="3" style="v" sid="LUK 15:3"/>ህካን እኮቤቺሃ ኢስ እሰንተ <verse eid="LUK 15:3"/><verse number="4" style="v" sid="LUK 15:4"/>«ክዕኔች ጥቤ ሆለት ዮሲሁ ህከን ሆላች መትሴ በኦጎር ሆንሳይኔ ሆንስተ ሆለተ ኡለ ኡድማን አጉር በኦ ሆልቹተ ደጎተ ኢለ ሀሶተ መርባሁ አዬት? <verse eid="LUK 15:4"/><verse number="5" style="v" sid="LUK 15:5"/>ደጎሴ ወክት ሙንደዕይ ቆዕሌስ እጅ አሜተኖ። <verse eid="LUK 15:5"/><verse number="6" style="v" sid="LUK 15:6"/>ምንስ ኢሌ ወክት ጃላስለከ ኦሌስ መነ ሜጡበ ገእ ‹በዕዮ ሆልቹኤ ደኤምቤቺሃ ኢን ሜጡበ ሙንደዕዬ› የኖሰ። <verse eid="LUK 15:6"/><verse number="7" style="v" sid="LUK 15:7"/>አን ኩላንክዕኔ፤ ህከንገን ጩብሰ ቶበቱ ሀስሰኖሰበእ ሆንሳይኔ ሆንሶ ጡመ መኒች አበ ጩብስ ቶበተኖ መቶሃ ጩበኚሃ ሰማን አቡ ሙንዲኑት እካአ» ይ ኩሎሰ።<verse eid="LUK 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8"/>ህትን «ቶኑ ሽልንጉ ዮሴሀኒች መቱስ ሽልንጉ በዕዮሴራ ኩራዘ ለሊስ ምንሴ ሀጣውት ደጎተ ኢለ ኩት አት ሀስባት አዬት? <verse eid="LUK 15:8"/><verse number="9" style="v" sid="LUK 15:9"/>ደጎ ወክት ጃላከሴለከ ኦሌሴ መነ ሜጡበ ገእት ‹በዕዮኤ ሽልንገ<note caller="+" style="f"><char style="fqa" closed="false">ሽልንገ ዬኖሁ፦ </char><char style="ft" closed="false">መቱ ሽልንጉ መቶ በሬ ሆጉተ አአኖ መንቺሃ መቶ በሬተ ባቴኖስሃ ደሞዘ።</char></note> ደኤምቤቺሃ ኢን ሜጡበ ሙንደዕዬ› ይታሰ። <verse eid="LUK 15:9"/><verse number="10" style="v" sid="LUK 15:10"/>አን ኩላንክዕኔ፤ ህካን እኮገን ጩብስ ቶበተኖ መቶሃ ጩበኚሃ መገን መላይከ ብሬን ሙንዲኑት እካአ» ይታ ምሳልተ ኩሎሰ።<verse eid="LUK 15:10"/></para>
  <para style="s1">በዕይ ደገሞ ጩልተኔሃ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11"/>ኢስ «መቶ መንቺሃ ለም ኦሱት ሄኦስ እቅ። <verse eid="LUK 15:11"/><verse number="12" style="v" sid="LUK 15:12"/>ህከኑኡች ማዕኑስ አነስ ‹ኢ አነ! ዮሄ ዱንያችክ እለኖኤ ወጥ ኣሴኤ› ዬእ፤ አኑሰ ዮስ ዱንያች ለሚንከሰ ቤኮ። <verse eid="LUK 15:12"/><verse number="13" style="v" sid="LUK 15:13"/>ቀዎ በሬች ኤተሮን ማዕኑ ጩሉ ዮስ ዱንያተ ጉዕመንከ አፍ ቄዕራሸ ባዱ ኦሮዕዮ፤ ህከኔን ዱንያስ ጉዕመንከ ገውማን ደግለልበርቾን ብን አይ ቤሾ። <verse eid="LUK 15:13"/><verse number="14" style="v" sid="LUK 15:14"/>ዮስርቹ ጉዕመንከ ሹሎች ኤተሮን ህከን ባዶን ጠረኙ ጎሩ እካን ሁኩ ጩሉ ኦርጨቀሞ። <verse eid="LUK 15:14"/><verse number="15" style="v" sid="LUK 15:15"/>ህካን እኮቤቺሃ ህከን ባድ መኒች መቶ መንቾን ኤገተ ኣጎ፤ ሁኩ መንቹኩ ቦኬ ዜማንቹ አዕዮስ። <verse eid="LUK 15:15"/><verse number="16" style="v" sid="LUK 15:16"/>ሁኩ ጩሉንኩ ቦክት እታ ሀርቁተ እቶተ ሄዕላተኖ እቅ፤ እኮጎሬ መቱርቹሃ ኣሰኖሲሁ ዮበአ። <verse eid="LUK 15:16"/><verse number="17" style="v" sid="LUK 15:17"/>ኤተሮን ቀልቡስ ፈንቀላን ‹አንኤ ምኔን ሄኣ ካዲመት ጉዕሙንኩ ጣብተ እት ዱባን ፈቀኖሳት፤ እኮጎሬ አን ከኔ ጎሮን ሬሃሚት። <verse eid="LUK 15:17"/><verse number="18" style="v" sid="LUK 15:18"/>ህካን እኮቤቺሃ ከንቢች ኬዕይ አንኤቤቹ መር ኢ አነ! መገኒሃለከ ኬሳሃ ቤሾም። <verse eid="LUK 15:18"/><verse number="19" style="v" sid="LUK 15:19"/>ከኒች ኤተሮን ቤቱክ የመም ገአሙ ሀስሰኖኤበአ፤ ህካን እኮቤቺሃ ቀጠረንት አታ ካዲማችክ መትስገ ወለኤኤ ያንስ› ይ ሰውዬእ። <verse eid="LUK 15:19"/><verse number="20" style="v" sid="LUK 15:20"/>ህከንቤቺችን ኬዕይ አንስቤቹ አሜቾ፤</para>
  <para style="p" vid="LUK 15:20">«እስን ቄዕራሻን ሄዕዮገን አኑስ ለዕይ ሻዥ ደጉጅ መር ጎበስ ሀንቀፍ ሱንቄስ። <verse eid="LUK 15:20"/><verse number="21" style="v" sid="LUK 15:21"/>ቤቱንኩስ ‹ኢ አነ! መገኒሃለከ ኬሳሃ ቤሾም፤ ከኒች ኤተሮን ቤቱክ የመም ገአሙ ሀስሰኖኤበአ› ዬስ። <verse eid="LUK 15:21"/><verse number="22" style="v" sid="LUK 15:22"/>ጠዉ እኮጎሬ አኑስ ካዲመስ ገእ ‹ደዕልቴን አበ ጡመ ኦድኑተ ኤቤን ኦድሼስ፤ ህትን አንገስ ጨንባረ ሎከስን ጫዕመተ ዎሬስ። <verse eid="LUK 15:22"/><verse number="23" style="v" sid="LUK 15:23"/>ህትን ምሾ ደርገጌሸ ኤቤን ጎራጬ፤ ነኡ እንቶሁ፥ ሙንደዕኖሁ። <verse eid="LUK 15:23"/><verse number="24" style="v" sid="LUK 15:24"/>መሰንትስ ኩ ቤቱኤ ሬዮ እቅ፤ ሁኩዕኑን ቴ ፎሊን ዮኡ፤ ህትን በዕዮ እቅ፤ ቴ ደገሞኡ› ዬ ወክት ሙንደኡ ጀመርቶኡ።<verse eid="LUK 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25"/>«ህከ ወክት ሀንገፉ ቤቱ አቡረ ቤቾን አቡረኖት እቅ፤ ፈንቀል አሜተን ምንቤቹ ሆንጠኮ ወክት ከረቡተ ዎቀሬነን ቦለቸ ከዴኖሃ ሞጮጬእ። <verse eid="LUK 15:25"/><verse number="26" style="v" sid="LUK 15:26"/>እስን ካዲማች መቱስ ገእ ‹ኩን መርቹሃን?› ይ ጠዕሜስ። <verse eid="LUK 15:26"/><verse number="27" style="v" sid="LUK 15:27"/>ሁኩ ካዲንቹንኩ ‹አመክቤቱ አሜቾኡ፤ በዕዮ ቤቱስ ደገሞቤቺሃ አኑክ ምሾ ደርገጌሸ ጎራጮኡ› ዬስ።<verse eid="LUK 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28"/>ጠዉ እኮጎሬ «ሀንገፉ ቤቱ ኡሙዕር ምኒ ኣጉ ግቦ፤ አኑስ ምኒች ፉል ምኒ ኣጎተ ኡጬስ። <verse eid="LUK 15:28"/><verse number="29" style="v" sid="LUK 15:29"/>እስን አኒሀስ ፈንቀሽ ‹ሁኩዕኑን! ልግብ ዘማን ካደሞንኬ፤ አዘዜንቴኤንከ ሆሮ ግቦምበአ፤ ህካን እኮቤቺሃ ደረቦንተእ ሜጡበ ሙንደኦተ መቱ ኮርቤሸሃ ኣቶንቴኤበአ። <verse eid="LUK 15:29"/><verse number="30" style="v" sid="LUK 15:30"/>ጠዉ እኮጎሬ ኩ ቤቱክ ዱንያክ ጉዕመንከ ዝነተ አታ መኒን ሜጡበ ሹል አሜቻን ምሾ ደርገጌሸ ጎረጦንትስ› ዬእ። <verse eid="LUK 15:30"/><verse number="31" style="v" sid="LUK 15:31"/>አኑንኩ ‹ኢ ቤቶ! አት ጉዕመ ወክትንከ ኢን ሜጡበ ዮንት፤ ኤሰ ዮኤርቹ ጉዕሙንኩ ኪሃን። <verse eid="LUK 15:31"/><verse number="32" style="v" sid="LUK 15:32"/>ጠዉ እኮጎሬ ኩ አመክቤቱ ሬዮ እቅ፤ ቴሱ ፎልን ዮኡ፤ ህትን በዕዮ እቅ፤ ቴሱ ደገሞኡ፤ ህካን እኮቤቺሃ አበ ሙንደኡ ሀስሰኖኔ› ዬስ» ዬእ።<verse eid="LUK 15:32"/></para>
  <chapter eid="LUK 15"/>
  <chapter number="16" style="c" sid="LUK 16"/>
  <para style="s1">አመዕነሞበእ ሹመ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1"/>ኢስ አሳበስ «መቱ ወክት መቱ ቀባጣሙ መንቹ ሄዕዮ እቅ፤ እሲንከ ምንስ አዘዘኖ መቱ ሀላፌቹ ሄዕዮስ እቅ፤ ህከን ቀባጣሞ መንቺሃ ‹ምንክ ገሻንቹ ዮሄ ዱንያክ ብንአዕይ ቤሰኖት› ዬን ኩሌመስ። <verse eid="LUK 16:1"/><verse number="2" style="v" sid="LUK 16:2"/>ሁኩ ቀባጣሙ መንቹንኩ ምንስ ሀላፌቹ ገእሲሽ ‹ኩ ሞጮጫም ጠዉ መርቹሃን? ከኒች ኤተሮን ምንእ ገሽቶተ አታልታንትበእቤቺሃ አቶንት ዎልቀክ ጌሰ ኩሌኤ› ዬስ። <verse eid="LUK 16:2"/><verse number="3" style="v" sid="LUK 16:3"/>ሁኩ ሀላፌቹንኩ ቀልቤንከስ ‹ቴሱ ሀለቁኤ ኣሴኤ ሆጎች ሸሮኤታት፤ ህካን እኮቤቺሃ መ አኡ? አቡር አታላምበአ፤ ጦለብ እቱ ሙልሰኖኤ። <verse eid="LUK 16:3"/><verse number="4" style="v" sid="LUK 16:4"/>ገሽኤ ሆጎች ሸሬመኤ ወክት መኑ ምናንከሰ ኤሳሃ ቶጎተ አኣም ጠወ ደጎም› ዬእ።<verse eid="LUK 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5"/>«ህካን እኮቤቺሃ ቀርች ኤዴ መነ ጉዕመንከ መቲን መቲን ገእ ዎዕኔስ መንቹ ‹ኢ ቀርቺሃ ባታንት ሄንኩ ኤዶ ዮሄ?› ዬስ። <verse eid="LUK 16:5"/><verse number="6" style="v" sid="LUK 16:6"/>መንቹስ ‹ጥቤ ምዳኖ ዘይት ኤዶ ዮኤ› ዬእ፤ ሀላፌቹንኩ ‹ኤዶክ ከተበሞ ወረቀተ ኣእት አፉዕልት ኦንታሁ ምዳኑተ ይት ደዕልት ከተብ› ዬስ። <verse eid="LUK 16:6"/><verse number="7" style="v" sid="LUK 16:7"/>ህከኒች ኤተሮን ለንክ መንቹሃ ‹ሄንኩ ሌቆ ዮሄ?› ዬስ፤ መንቹንኩ ‹ጥቤ ሆቆማድ<note caller="+" style="f"><char style="fqa" closed="false">ሆቆማዱ፦ </char><char style="ft" closed="false">ዩ መቱ ሆቆማዱ ሰስ ጥብተ ህዜታዩ ሌትሮ ዊ ጌሰ አፈኖ፤ ሁኩንን ኦንቴ ጥቤ ኪሎ ዉጠ ጌሰ አፈኖ።</char></note> አለስ ሌቆሁ ዮኤ› ዬእ፤ ሀላፌቹንኩ ‹ኤዶክ ከተበሞ ወረቀተ ኣእት ህዜታሁ ሆቆማዱ ይት ከተብ› ዬስ። <verse eid="LUK 16:7"/><verse number="8" style="v" sid="LUK 16:8"/>ሀለቁንኩ አመዕነሞበእ ሀላፌቹንከ አት ብላታሞሃን!» ዬስ፤ መሰንትስ ከን ሂለ ኣዱንያ አል መኑ ገገዉሰ ሀዕሊሃ ኑሬን ሄኣ መገን መኒች በትስ ኤንኬዕናመተ እሁሰ ለሊሰኖ።<verse eid="LUK 16:8"/></para>
  <para style="s1">ዱንያተ ቤቺን ደግለሸቀሙ</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 16:9"/>አን ኩላንክዕኔ፤ ከን ኣዱንያ አል ተንኩተ አቴን ደእቴነንተ ቀባጦንከክዕኔ ገይሀክዕኔ ጃለተ መክሴነንተ፤ ሁኩ ቀባጡክዕኔ ጎፎ ወክት ጃለክዕኔ ዘላለሚሃ ሄኣ ምኔንከሰ ቶጋህዕኔ። <verse eid="LUK 16:9"/><verse number="10" style="v" sid="LUK 16:10"/>ቀዎርቾን አመዕነሞሁ ሎረርቾን አመዕነሞእሃን፤ ጠዉ እኮጎሬ ቀዎን ጡመርቹ አእቡ መንቹ አበ ጠዋን ጡመርቹ አአኖበአ። <verse eid="LUK 16:10"/><verse number="11" style="v" sid="LUK 16:11"/>ቴሱ ተንኩተ አኤን ደኤመ ቀባጦን አመዕነንቴንተረ እኬንባች ሀንቅ ቀባጦተ አይ ኤገተ ኣሰኖህዕኔ? <verse eid="LUK 16:11"/><verse number="12" style="v" sid="LUK 16:12"/>ህትን ዎሎ መን ቀባጦን አመዕነንቴንተረ እኬንባች ገይሀክዕኔ እካ ቀባጡተ አይ ኣሰኖህዕኔ?<verse eid="LUK 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13"/>«ለሙ ቀርቹ ካደመኖ ካዲንቹ ዮበአ፤ ህካን እኮቤቺሃ መቱስ ግብ መቱስ ኢተኖ፤ መቱስ ኬዕምሽ መቱስ ሆፍሰኖ፤ ህትን መገኒሃለከ ዱንያሃ ጠገንቶኖተ አታልቴነንተበአ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">16፥13 </char><char style="xt" closed="false"><ref loc="MAT 6:24">ማቶ. 6፥24</ref>።</char></note><verse eid="LUK 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14"/>ዱንያተ ኢትታ ፈርሳውት ኢስ ጠወዕዮሃ ጉዕመንከ ሞጮጭት ቀለዶስ። <verse eid="LUK 16:14"/><verse number="15" style="v" sid="LUK 16:15"/>ጠዉ እኮጎሬ ኢስ «አዕኑ መን መዴን ገዉክዕኔ ፈየ አቴነንተሩ፤ እኮጎሬ መገኑ ቀልብክዕኔ ደገኖ፤ መሰንትስ መንቤቾን ሎረ እክ ለለኖርቹ መገንሀኔን ህንቀሞእሃን» ዬእ።<verse eid="LUK 16:15"/></para>
  <para style="s1">መገን ሕገለከ ጎጆሃ እህተኔሃ</para>
  <para style="r">(<ref loc="MAT 11:12-13">ማቶ. 11፥12-13</ref>፤ <ref loc="MAT 5:31-32">5፥31-32</ref>፤ <ref loc="MRK 10:11-12">ማር. 10፥11-12</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16"/>ኢስ «መገን ሕገለከ ነብያከት ጠወኦኢሁ ጠመቃንቾ ያህይ ወክቱ ኢሎተ ኢለ ሹምነቱ ሄዕዮሰ እቅ፤ ህከን ወክቲች ኬሽ መገን ዎምነት ተሽት ላገት ሜጡበ ተማርሴኖት፤ መኑ ገገዉንኩስ ህከ ዎምነቱ ወልቃን ኣጎተ ሄጫቀመኖት።<note caller="-" style="x"><char style="xo" closed="false">16፥16 </char><char style="xt" closed="false"><ref loc="MAT 11:12-13">ማቶ. 11፥12-13</ref>።</char></note> <verse eid="LUK 16:16"/><verse number="17" style="v" sid="LUK 16:17"/>ጠዉ እኮጎሬ መገን ሕግ ላጋች ቀቅቹት በኣሀኒች ሰሞለከ ኡለት ህጋ ዩ ቆሀኖ።<note caller="-" style="x"><char style="xo" closed="false">16፥17 </char><char style="xt" closed="false"><ref loc="MAT 5:18">ማቶ. 5፥18</ref>።</char></note><verse eid="LUK 16:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18"/>«ጫስ ገፈር ዎልተ ጫተ ኤበኖሁ ጉዕሙንኩ ዝነተ አአኖት፤ ህትን ጨይችሴ ፉልቶ ጫተ ኣአኖሁ ጉዕሙንኩ ዝነተ አአኖት» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">16፥18 </char><char style="xt" closed="false"><ref loc="MAT 5:32">ማቶ. 5፥32</ref>፤ <ref loc="1CO 7:10-11">1 ቆሮ. 7፥10-11</ref>።</char></note><verse eid="LUK 16:18"/></para>
  <para style="s1">ቀባጣሙ መንቹለከ ቡጥቹ አልዓዛሬ</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19"/>ኢስ ሰመ አጉደኖ ብሸተ ኦድኑተለከ ጡመገ መክሴን ደዴመ ኦድኑተ ኦደአኖ መቱ ቀባጣሙ መንቹ ሄዕዮ እቅ፤ እስን በሬን በሬን መክያንስ ተስቄነጭ ሙንዲኖን ሄአኖ እቅ። <verse eid="LUK 16:19"/><verse number="20" style="v" sid="LUK 16:20"/>ህትን አሉስ ጡሌን ጡለ እኮ አልዓዛሬ ዬኖ መቱ ቡጥቹ መንቹ ህከን ቀባጣሞ መንች ግቤስ ብትም መዴን ኦሰዕዮ እቅ። <verse eid="LUK 16:20"/><verse number="21" style="v" sid="LUK 16:21"/>ሁኩ ቡጥቹንኩ ቀባጣሞ መንች ማዲች ኡቦ ፉርፉሩ እቶተ ሄዕላተኖ እቅ፤ ዉሸት አሜት ጡላስ ላጠ እቅ።<verse eid="LUK 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22"/>ሁኩ ቡጥቹ መንቹ ሬዮች መላይከት እብራሂም መድ መስቶስ፤ ህትን ሁኩ ቀባጣሙ መንቹንኩ ሬይ ሞገሞ። <verse eid="LUK 16:22"/><verse number="23" style="v" sid="LUK 16:23"/>ሁኩ ቀባጣሙ መንቹ አዛቤን ኦርጨቀመን ቄዕራሻን እልስ ኬሽ እብራሂመለከ ጋለስ አፉዕሌ አልዓዛሬ ለዕዮ። <verse eid="LUK 16:23"/><verse number="24" style="v" sid="LUK 16:24"/>እስን ኢ አነ እብራሂመ! ሀዕይ ኤሳሃ አሙዜኤ፤ አን ከኔ ጊራ ለበነ ኣዜን ኦርጨቀመምቤቺሃ ዙዕሩሜስ ዋን ጬፍ አራብኤ ቅዝሶተ አልዓዛሬ ሶሄኤ ይ ገኤእ።<verse eid="LUK 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25"/>ጠዉ እኮጎሬ እብራሂም ኢ ቤቶ! ፎሊን ሄኦንት ወክት ናጃን ሄኦንትገ ሰውይ፤ ህትን አልዓዛር ኦርጨቀሞገ ሰውይ፤ ህካን እኮቤቺሃ እሲሃ ቴሱ ከኔ መከኖስ፤ አት ኦርጨቀንታንት። <verse eid="LUK 16:25"/><verse number="26" style="v" sid="LUK 16:26"/>ህትን ህከኒች ጉዕሚችን በትሽ ከን አዲች ክዕኔ አደ ህጎተ ሀሳእሩ አታልታበእገለከ ህካጵ አዲች አዪሁ ኒ አደ ቶለኖበእገ ኒለከ ክዕኔ በላን አቡ በዉ ዮኡ ዬሰ። <verse eid="LUK 16:26"/><verse number="27" style="v" sid="LUK 16:27"/>ሁኩ ቀባጣሙ መንቹንኩ ኢ አነ! ህካን እኮች አልኣዛሬ አንኤ ምኒ ሶሆተ ኡጫንኬ። <verse eid="LUK 16:27"/><verse number="28" style="v" sid="LUK 16:28"/>መሰንትስ ህከኔ ኦንቱ አመኤ ኦሱት ዮኤ፤ እሰን ከ ኦርሸ ቤቹ አሜታበእገ እስን መር ጠረኝሽ ኩሉን ዬእ።<verse eid="LUK 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29"/>ጠዉ እኮጎሬ እብራሂም «እሳንከ ሙሲለከ ነብያኖ ክታበት ዮሰ፤ ህካን ሞጮጭቱን ዬ ወክት <verse eid="LUK 16:29"/><verse number="30" style="v" sid="LUK 16:30"/>ሁኩ ቀባጣሙ መንቹ ፈንቀሽ ‹ኢ አነ እብራሂመ! ህትጎተበአ፤ ሬዮ መኒች መቱ መንቹ ኬዕይ መሮ ጎሬ ጩብሰ ቶበታአ› ዬእ። <verse eid="LUK 16:30"/><verse number="31" style="v" sid="LUK 16:31"/>እብራሂምን ‹ሙሲለከ ነብያኑት ከተቦ ክታበት ይታኢሃ ሞጮጭታበኢሃ እኮች ሬዮ መኒች መቱ መንቹ ኬዕይ ኩሎሰ ጎሬሁ አመዕንታበአ› ዬስ» ዬእ።<verse eid="LUK 16:31"/></para>
  <chapter eid="LUK 16"/>
  <chapter number="17" style="c" sid="LUK 17"/>
  <para style="s1">መነ ሉሲስች አገዕሩ</para>
  <para style="r">(<ref loc="MAT 18:6-7">ማቶ. 18፥6-7</ref>፤ <ref loc="MAT 21-22">21—22</ref>፤ <ref loc="MRK 9:42">ማር. 9፥42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1"/>ኢስ አሳበስ «መነ ሉሲሰኖርቹ አሜቱዕነ ሆሮ ፈቀኖበአ፤ ጠዉ እኮጎሬ ህከ ሉሲሰኖርቹ ኤበኖ መንቺሃ ቆሀኖስ! <verse eid="LUK 17:1"/><verse number="2" style="v" sid="LUK 17:2"/>ሁኩ መንቹ ከን ቀቅቻኖች መቱስ ሉሲሰኖሀኒች ርትም ክኑ ጎበስ ኡሱሬን ባራን ቶሬናንስ ቆሀኖስ እቅ። <verse eid="LUK 17:2"/><verse number="3" style="v" sid="LUK 17:3"/>ህካን እኮቤቺሃ ገይሀክዕኔ አገዕርዬ፤ አመክቤቱ ቤሾሄ ጎሬ ሻቅስ፤ እስን ሰጭ ፈንቀሎ ጎሬ አጉርስ።<note caller="-" style="x"><char style="xo" closed="false">17፥3 </char><char style="xt" closed="false"><ref loc="MAT 18:15">ማቶ. 18፥15</ref>።</char></note> <verse eid="LUK 17:3"/><verse number="4" style="v" sid="LUK 17:4"/>መቶ በሬን ለመለ ወክት ቤሾ ጎር ለመለ ወክትንከ ‹ሰጭ ፈንቀሎም› የን ኪቤቹ ፈንቀሎ ጎሬ አጉሩ ሀስሰኖሄ» ዬእ።<verse eid="LUK 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5"/>አሳበንት ቀርቹ ኢሰ «ሀዕይ አመዕነቱ በርግኔ» ይቶስ። <verse eid="LUK 17:5"/><verse number="6" style="v" sid="LUK 17:6"/>ቀርቹንኩ ፈንቀሽ «ጣፌ እሌ ጌሱ አመዕነቱ ሄዕዮህዕኔ እቃን ከ ኦድ ሀቀ ‹ከንቤቺች ቡቱከንት ባራን ካሰም› ይቴነንተረ አዘዘመኖህዕኔ» ዬሰ።<verse eid="LUK 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7"/>ህትን «አቡረኖ ህከረንገ ሆለተ አላለኖ ካዲንቹ ዮሲሁ ካዲሙስ አቡራች ፈንቀሎ ወክት ‹ደዕልት አፉዕልት እት› የኖሁ ክዕኔች አዬት? <verse eid="LUK 17:7"/><verse number="8" style="v" sid="LUK 17:8"/>ህካን የኖ ወጥ ‹ቴሱ ሁርባት እቶተለከ አጎተ ኢለ ረመዙክ ቆዕርት ካደሜኤ፤ ህከኒች ኤተሮን አት እታንትለከ አጋንት› የኖስበእንዶ? <verse eid="LUK 17:8"/><verse number="9" style="v" sid="LUK 17:9"/>ህትን እስ አዘዦርቹ አዕዮሀኒሃ ህከ ካዲንቹ ገለትጨኖስንዶ? <verse eid="LUK 17:9"/><verse number="10" style="v" sid="LUK 17:10"/>ህትን አዕኑሁ አዘዘንቴንተርቹ ጉዕመንከ አቴንተ ወክት ‹ነኡ ገለት ሀንስበረ፤ አኡ ሀስሰኖ ጠወ ጠለዕል አዕኖም› ይዬ» ዬሰ።<verse eid="LUK 17:10"/></para>
  <para style="s1">ኢስ ቶኑ ጎግ አል ጥዘናመተ ፈይሱስ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11"/>ኢስ ዬሩሳሌም ከተመ መረን ሰመርለከ ገሊል በሊን ህገኖት እቅ። <verse eid="LUK 17:11"/><verse number="12" style="v" sid="LUK 17:12"/>መት ቀዕተ ኣጎ ወክት ጎግ አል ጥዘነት አፎሰ ቶኑ መኑ ቄዕራሻን ኡርቶሀኑኡን ደቀሞ። <verse eid="LUK 17:12"/><verse number="13" style="v" sid="LUK 17:13"/>እሰን ላገሰ ጎት አት «ቀርቾ ኢሰ! ሀዕይ አሙዝኔ!» ይቶኡ።<verse eid="LUK 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14"/>ኢስን እሰተ ለዕይ «መሬ አልክዕኔ ቂሲሃ ለሊሼ» ዬሰ፤ እሰን መርተንን ጎግ አሌን ፉልቶ ጥዘናች ፈይቶኡ።<note caller="-" style="x"><char style="xo" closed="false">17፥14 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">ሌዌ 14፥1-32</ref>።</char></note><verse eid="LUK 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 17:15"/>እሳችን መቱስ ፈዩስ ለዕዮ ወክት ሎረ ላጋን መገኑ ገለትጨን ፈንቀል አሜቾ። <verse eid="LUK 17:15"/><verse number="16" style="v" sid="LUK 17:16"/>እስን ሚኔንከስ ሙግይ ኢስ ሎከ አሌን ኡብ ገለትጬስ፤ መንቹንኩስ ሰመር ባድየ እቅ። <verse eid="LUK 17:16"/><verse number="17" style="v" sid="LUK 17:17"/>ኢስን «ፈይቶሩ ቶኑሃ እቅበእንዶ? ሆንሱሰ ሀከበ ዩኡ? <verse eid="LUK 17:17"/><verse number="18" style="v" sid="LUK 17:18"/>ከን ዎሎ ባድ መንች ቤሉ መገኑ ገለትጮተ ፈንቀል አሜቾሁ ዮእንዶ?» ይኬዕይ <verse eid="LUK 17:18"/><verse number="19" style="v" sid="LUK 17:19"/>ህከ መንቹ «አመዕነቱክ ፈይሾሄ፤ ኬእ ኦሮእ» ዬስ።<verse eid="LUK 17:19"/></para>
  <para style="s1">መገን ዎምነቱ አሜተኖገ</para>
  <para style="r">(<ref loc="MAT 24:23-28">ማቶ. 24፥23-28</ref>፤ 37-41)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20"/>ፈርሳውት ኢሰ «መገን ዎምነቱ መ ወክት አሜተኖ?» ይት ጠዕምቶስ ወክት «መገን ዎምነቱ አሜተኖሁ መኑ አገረኖ ሃልጋበአ።<note caller="+" style="f"><char style="fqa" closed="false">መገን ጄነቱ አሜተኖሁ መኑ አገረኖ ሃልንበአ የኖሁ፦ </char><char style="ft" closed="false">መኑ ለአኖ ሃልጋበአ ዩሃን።</char></note> <verse eid="LUK 17:20"/><verse number="21" style="v" sid="LUK 17:21"/>ህትን ‹ሁኩዕኑን ከበ ዮኡ› ህከረንገ ‹ካጰ ዮኡ› ዬኖሴበአ፤ መሰንትስ መገን ዎምነቱ ዮኢሁ ክዕኔ በላንት»<note caller="+" style="f"><char style="fqa" closed="false">መገን ጄነቱ ዮኢሁ ክዕኔ በላኒት፦ </char><char style="ft" closed="false">የኖሁ ክዕኔ ኣዜኒት ዩሃን።</char></note> ዬሰ።<verse eid="LUK 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22"/>ህከኒች ኤተሮን ኢስ አሳበስ «መንች ቤት በሬች መቱ በር ለኦኖተ ሄዕላቴነንተ ወክቱ አሜተኖ፤ እኮጎሬ ለኤነንተበአ። <verse eid="LUK 17:22"/><verse number="23" style="v" sid="LUK 17:23"/>ህትን መኑ ‹ሁኩዕኑን ከበ ዮኡ› ህከረንገ ‹ሁኩዕኑን ካጰ ዮኡ› የኖህዕኔ፤ ጠዉ እኮጎሬ እሰተ አዎንቴን መርቶኖቼ» ዬሰ። <verse eid="LUK 17:23"/><verse number="24" style="v" sid="LUK 17:24"/>መሰንትስ ሰማን ጉገኛት በለቅ ከን አድ ገበሊች ካጵ አዲ ገበለ ኢሎተ ኢለ ለሊሰኖገን መንች ቤቱ አሜተኖ ወክት ህትን እሀኖ። <verse eid="LUK 17:24"/><verse number="25" style="v" sid="LUK 17:25"/>ጠዉ እኮጎሬ ህከኒች ሄጭ መንች ቤቱ ልግብ ኦርሸተ ቶጎተለከ ከን ዘማን መኒን አበ ግበሞተ ሀስሰኖስ። <verse eid="LUK 17:25"/><verse number="26" style="v" sid="LUK 17:26"/>ህትን ኑህ ዘማን እኮገን መንች ቤት ዘማኔን ህትን እሀኖ።<note caller="-" style="x"><char style="xo" closed="false">17፥26 </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">ክል. 6፥5-8</ref>።</char></note> <verse eid="LUK 17:26"/><verse number="27" style="v" sid="LUK 17:27"/>ሁኩንን ኑህ መርከባን ኣገኖ በሩ ኢሎተ ኢለ መኑ እተኖት፥ አገኖት፥ ኤበቀኖትለከ መእሲሰኖት እቅ፤ ቤሰኖ ውሁ አሜች ጉዕመንከ ቤሾ።<note caller="-" style="x"><char style="xo" closed="false">17፥27 </char><char style="xt" closed="false"><ref loc="GEN 7:6-24">ክል. 7፥6-24</ref>።</char></note> <verse eid="LUK 17:27"/><verse number="28" style="v" sid="LUK 17:28"/>ህትን ሉጥ ዘማንገን እሀኖ፤ ህከ ወክት መኑ እተኖት፥ አገኖት፥ ህረኖት፥ ህዕረኖት፥ ካሰኖትለከ እጃረኖት እቅ። <verse eid="LUK 17:28"/><verse number="29" style="v" sid="LUK 17:29"/>እኮጎሬ ሉጥ ሶዶም ከተሚች ፉሎ ወክት ጊረትለከ ዲን ሰሜች ጤንገ ኡብ ጉዕመንከ ቤሾ።<note caller="-" style="x"><char style="xo" closed="false">17፥29 </char><char style="xt" closed="false"><ref loc="GEN 18:20">ክል. 18፥20</ref>፤ <ref loc="GEN 19:25">19፥25</ref>።</char></note> <verse eid="LUK 17:29"/><verse number="30" style="v" sid="LUK 17:30"/>መንች ቤቱ ለለኖ በርሃ ህትን እሀኖ።<verse eid="LUK 17:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 17:31"/>ህከ በርንከ ምኒ እንት አሌን ሄዕዮ መንቹ ምኔስ ዮ ኦደተ ኣኦተ ድሩንከ፤ ህትን አቡረ ቤቾን ዮእንኩ ኤተሩ ዋል ፈንቀሉንከ።<note caller="-" style="x"><char style="xo" closed="false">17፥31 </char><char style="xt" closed="false"><ref loc="MAT 24:17-18">ማቶ. 24፥17-18</ref>፤ <ref loc="MRK 13:15-16">ማር. 13፥15-16</ref>።</char></note> <verse eid="LUK 17:31"/><verse number="32" style="v" sid="LUK 17:32"/>ህትን ሉጤ ጫንተ ሰውይዬ።<note caller="-" style="x"><char style="xo" closed="false">17፥32 </char><char style="xt" closed="false"><ref loc="GEN 19:26">ክል. 19፥26</ref>።</char></note> <verse eid="LUK 17:32"/><verse number="33" style="v" sid="LUK 17:33"/>ፎልስ ፌሶተ ሀሰኖሁ ጉዕሙንኩ ፎልስ ቤሰኖ፤ ህትን ፎልስ ሆገኖሁ ጉዕሙንኩ ፎልስ ደአኖ።<note caller="-" style="x"><char style="xo" closed="false">17፥33 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቶ. 10፥39</ref>፤ <ref loc="MAT 16:25">16፥25</ref>፤ <ref loc="MAT 18:35">18፥35</ref>፤ <ref loc="LUK 9:24">ሉቃ. 9፥24</ref>፤ <ref loc="JHN 12:25">ያህ. 12፥25</ref>።</char></note> <verse eid="LUK 17:33"/><verse number="34" style="v" sid="LUK 17:34"/>አን ኩላንክዕኔ፤ ህከ ሀዎሮን ለሙ መንቹ መቶ መዕናን ኦሰኣአ፤ ህከኑኡችን መቱስ መሴናን መቱስ ፈቀኖ። <verse eid="LUK 17:34"/><verse number="35" style="v" sid="LUK 17:35"/>ህትን ለሙ ሜንቱ ሜጡበ ሪታአ፤ ህከኑኡችን መትሴ መሴናን መትሴ ፈቃአ። <verse eid="LUK 17:35"/><verse number="36" style="v" sid="LUK 17:36"/>[ህትን ለሙ መኑ መቶ ቤቾን አቡርታአ፤ እሳችን መቱስ መሴናንስ መቱስ ፈቀኖ።]<note caller="+" style="f"><char style="fqa" closed="false">መት-መቶ መጻፋን ዎሊንሽ 36 ዮኢሃ በርግታበአ፤፦ </char><char style="ft" closed="false">ሁኩንን ማቶ 24፥40 ዮኢሃ አጉደኖ።</char></note> <verse eid="LUK 17:36"/><verse number="37" style="v" sid="LUK 17:37"/>ህካን እኮቤቺሃ አሳበስ ኢሰ «ቀርቾ! ሀከበዪት?» ይት ጠዕምቶስ፤ እስን «ሬሹ ዮቤቾን ዞብሩ ጭምየኖ» ዬሰ።<verse eid="LUK 17:37"/></para>
  <chapter eid="LUK 17"/>
  <chapter number="18" style="c" sid="LUK 18"/>
  <para style="s1">ጨዉሴ ሬዮ መንቹተለከ ሂለ ዳኛ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1"/>ህከኒች ኤተሮን ኢስ መኒሃ ሆጉዕናን ጉዕመ ወክትንከ ዱአ አኡ ሀስሰኖሃ እሁስ ተማርሶተ መት ምሳልተ ኩሎሰ። <verse eid="LUK 18:1"/><verse number="2" style="v" sid="LUK 18:2"/>እስን «መቶ ከተማን መገኑ ዋጅቡለከ መነ ከበጅቡ መቱ ዳኙ ሄዕዮ እቅ። <verse eid="LUK 18:2"/><verse number="3" style="v" sid="LUK 18:3"/>ህከን ከተማንን መት ጨዉሴ ሬዮ መንቹት ሄኦ እቅ፤ እሴን ህከን ዳኝቤቹ ጉዕመ ወክት አሜተን ‹ባላጋርንከኤ ኦዳም ጠወ ፈረዴኤ› ይታሲት እቅ። <verse eid="LUK 18:3"/><verse number="4" style="v" sid="LUK 18:4"/>እስን ልግብ ወክት ፈረዱ ግቦሴ፤ ጠዉ እኮጎሬ ኤተሮን ቀልቤንከስ ‹መሃ መገኑ ዋጅበጎሬ መነሃ ከበጅበጎሬ <verse eid="LUK 18:4"/><verse number="5" style="v" sid="LUK 18:5"/>ት ጨዉሴ ሬዮ ጫት ኦርሳኤቤቺሃ ፈረዳንሴ፤ ህካን እህባች ጉዕመ ወክትንከ አሜተን ኦርሱንከኤ› ይ ሰውዬእ» ዬሰ።<verse eid="LUK 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6"/>ቀርቹ ኢስን «ሁኩ ሀንቅ ፈረድቡ ዳኙ ዬ ጠወ ሞጮጭዬ። <verse eid="LUK 18:6"/><verse number="7" style="v" sid="LUK 18:7"/>መገኑ ሀንከዕርተለከ በራሃ እስቤቹ ዎርዋታ መጠረንቶሀኑኡሃ ፈረደኖሰበእንዶ? ህትን ፈረዱዕናን ልግብ ወክት ዱንከኖንዶ? <verse eid="LUK 18:7"/><verse number="8" style="v" sid="LUK 18:8"/>አን ኩላንክዕኔ፤ ደዕል ፈረደኖሰ፤ ጠዉ እኮጎሬ መንች ቤቱ አሜተኖ ወክት ኣዱንያ አሌን አመዕነቱ ደገኖንዶ?» ዬእ።<verse eid="LUK 18:8"/></para>
  <para style="s1">ፈርሳውችለከ ቀረጠ ሙረኖ መንች ምሳልተ</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9"/>ኢስ «ነኡ ፈያኖታን» ይተን ገዎንከሰ ድከኣሀኑኡተለከ ዎሉ መነ ህንቃ መኒሃ ከ ምሳልተ ኩሎሰ። <verse eid="LUK 18:9"/><verse number="10" style="v" sid="LUK 18:10"/>ሁኩንን ለም መናከት ዱአ አቶተ ዱእ ምኒ መርቶኡ፤ ህከኑኡችን መቱስ ፈርሳውቹሃ፤ ህትን ለንክስሁ ቀረጠ ሙረኑሃን እቅ።<verse eid="LUK 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 18:11"/>ፈርሳውቹስ ሜጥሀስ ኡር ቀልቤንከስ መገኖ! ዎሎ መንገ ሁኩንን ወልቅስ ኣእታ መንገ፥ ሾከ መንገለከ ዝነተ አአኖ መንገ ባሰንከስ ከን ቀረጠ ሙረኖ መንችገ እህበቤቺሃ ገለትጫንኬ። <verse eid="LUK 18:11"/><verse number="12" style="v" sid="LUK 18:12"/>አንን ሳምንታን ለሞረ ሶመናሚት፤ ህትን ደኣምሀኒች ጉዕሚችን ቶኒች መቱ ዘከተ ፉሻሚት ይ ዱአ አዕዮ።<verse eid="LUK 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13"/>ጠዉ እኮጎሬ «ቀረጠ ሙረኖሁ ቄዕራሻን ኡርኬዕይ እልስ አሌ ዋሽ ሰማ ለኦተ መለሎበአ እቅ፤ እኮጎሬ ወዘነስ ዎቀረን ‹መገኖ! ኤሰ ጩበኛ መረርሲጬኤ!› የኖት እቅ። <verse eid="LUK 18:13"/><verse number="14" style="v" sid="LUK 18:14"/>አን ኩላንክዕኔ፤ ፈርሳውቺች አበ ቀረጠ ሙረኖሁ ፈየ እክ ምንስ ፈንቀሎ፤ መሰንትስ ገዉስ ሎርሰኖሁ ጉዕሙንኩ ሙግ የኖ፤ እኮጎሬ ገዉስ ሙግ አአኖሁ ሎረኖ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">18፥14 </char><char style="xt" closed="false"><ref loc="MAT 23:12">ማቶ. 23፥12</ref>፤ <ref loc="LUK 14:11">ሉቃ. 14፥11</ref>።</char></note><verse eid="LUK 18:14"/></para>
  <para style="s1">ኢስ ኦሱተ ማሰዕዮገ</para>
  <para style="r">(<ref loc="MAT 19:13-15">ማቶ. 19፥13-15</ref>፤ <ref loc="MRK 10:13-16">ማር. 10፥13-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15"/>መኑ ቀቀዋኑ ኦሱተ ኢስ አንገስ አሌሰ አኦተ እስቤቹ ኤቦኡ፤ ኢስ አሳበት ህካን ለኦ ወክት ህከ መነ ሻቆኡ። <verse eid="LUK 18:15"/><verse number="16" style="v" sid="LUK 18:16"/>ጠዉ እኮጎሬ ኢስ ኦሱተ ገእ «መገን ዎምነቱ ህትናማተ እኮቤቺሃ ኦሱት ኢቤቹ አሜቱን፤ ከንቶኖቼሰ። <verse eid="LUK 18:16"/><verse number="17" style="v" sid="LUK 18:17"/>ሀንቅንከ ያንክዕኔ፤ መገን ዎምነቱ ኦሶገ እክ ቶግባሁ አዪሁ መገን ጄነት ሆሮ ኣገኖበአ» ዬእ።<verse eid="LUK 18:17"/></para>
  <para style="s1">ኣዱንያ ቀባጡተለከ ሰሜ ዎምነቱ</para>
  <para style="r">(<ref loc="MAT 19:16-30">ማቶ. 19፥16-30</ref>፤ <ref loc="MRK 10:17-31">ማር. 10፥17-31</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18"/>መቱ ገሻንቹ ኢሰ «ጡመ አስተማርቾ! ዘላለሚሃ ጎፍበ ሄኡ ደኦተ መ አኡ?» ይ ጠዕሜእ።<verse eid="LUK 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19"/>ኢስን «ሚሃ ‹ጡመ› ይት ገእታንቴኤት? መገን ቤሉ ጡሙ አዪሁ ዮበአ። <verse eid="LUK 18:19"/><verse number="20" style="v" sid="LUK 18:20"/>ህትን ትዛዝ ጉዕመንከ ደጋንት፤ ትዛዙንኩስ ‹ዝነተ አቶት፤ ሽቶት፤ ሞግቶት፤ ክዝብ መሰከርቶት፤ አነክለከ አመክ ከበጅ› የኖሃን» ዬስ።<note caller="-" style="x"><char style="xo" closed="false">18፥20 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">ፉል. 20፥12-16</ref>፤ <ref loc="DEU 5:16-20">ዘዳ. 5፥16-20</ref>።</char></note><verse eid="LUK 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21"/>መንቹንኩስ «ካን ጉዕመንከ ኦስማችኤ ኬሽ አገሮም» ዬእ።<verse eid="LUK 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22"/>ኢስን ህካን ሞጮጬ ወክት «መቱ ጠዉ ፈቆሄ፤ ሁኩንን ዮሄርቹ ጉዕመንከ ህርት ቡጥቻኖተ ኣስ፤ ሰማን ጭምይቶ ዱንያተ ደእታንት፤ ህት እክ አሜት አዎኔኤ» ዬስ። <verse eid="LUK 18:22"/><verse number="23" style="v" sid="LUK 18:23"/>ጠው እኮጎሬ መንቹስ አበ ቀባጣሙ እኮቤቺሃ ህካን ሞጮጬ ወክት ህለብከ ሻዦ። <verse eid="LUK 18:23"/><verse number="24" style="v" sid="LUK 18:24"/>ኢስን ሁኩ መንቹ ሂለ ብከ ሻዦገ ለዕይ «ቀባጣመት መገን ዎምነቱ ኣጉ ሄንከ ኬዕመኖሃን! <verse eid="LUK 18:24"/><verse number="25" style="v" sid="LUK 18:25"/>ህትን ቀባጣሙ መንቹ መገን ዎምነቱ ኣገኖሀኒች ጋሜሉ መርፌ ጠላዕላን ሕጉ ቆሀኖ» ዬእ።<verse eid="LUK 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26"/>ህካን ሞጮጭቶ መኑ «ህካን እኮች አይ ጡሞተ አታለኖ?» ይቶኡ።<verse eid="LUK 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27"/>ጠው እኮጎሬ ኢስ «መኒሃ አታለምቡ መገኒሃ አታለመኖ» ዬእ።<verse eid="LUK 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28"/>ጴጥሮስን «ሁኩዕኑ ነኡ ጉዕመርቹንከ አጉርን አዎኖንኬ» ዬስ።<verse eid="LUK 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29"/>ኢስን «ሀንቅንከ ያንክዕኔ፤ መገን ዎምነትተኔሃ ምንስ ህከረንገ ጫስ ህከረንገ አመስ ኦሱተ ህከረንገ አነስ ህከረንገ አመስለከ እለስ አጉር <verse eid="LUK 18:29"/><verse number="30" style="v" sid="LUK 18:30"/>ከን ዘማኔን ልግብ ወክቲሃ አበ አፎ ኣእቡ ህትን አሜተኖ ዘማኔን ዘላለሚሃ ጎፍቡ ሄኡ ደኡዕነ ፈቀኖ መንቹ ዮበአ» ዬሰ።<verse eid="LUK 18:30"/></para>
  <para style="s1">ኢስ ሬሆስተኔሃ ሰቅ ወክት ጠወኡስ</para>
  <para style="r">(<ref loc="MAT 20:17-19">ማቶ. 20፥17-19</ref>፤ <ref loc="MRK 10:32-34">ማር. 10፥32-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31"/>ኢስ ቶና ለሙንከ አሳበስ መድስ ሽቅ አዕይ «ሁኩዕኑን! ነኡ ዬሩሳሌም ከተመ መርናሚት፤ ህትን መንች ቤትተኔሃ ነብያከት ከተቦ ጠዉ ጉዕሙንኩ ዊመኖ። <verse eid="LUK 18:31"/><verse number="32" style="v" sid="LUK 18:32"/>እሱንከ አይሁደ እህቡ መኒሃ ህግሴን ኣሴናን ቀነጣስ፥ ቦሮርታስለከ አሌስ አንጀ ቱ ይታስ። <verse eid="LUK 18:32"/><verse number="33" style="v" sid="LUK 18:33"/>ኦልቶሲች ኤተሮን ሽታስ፤ ጠዉ እኮጎሬ እስን ሰቅ በር ሬሆች ኬአኖ» ዬሰ።<verse eid="LUK 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34"/>ጠዉ እኮጎሬ አሳበስ ህከን ጠውች መቱርቹሃ አጥራመቶበአ፤ ህትን ጠወኦ ጠዉንኩ ለሉ ሆጎሰቤቺሃ ጠወአሞ ጠወሃ ደጎበአ።<verse eid="LUK 18:34"/></para>
  <para style="s1">ኢስ ቆቀ መንቹ ፈይሱስ</para>
  <para style="r">(<ref loc="MAT 20:29-34">ማቶ. 20፥29-34</ref>፤ <ref loc="MRK 10:46-52">ማር. 10፥46-52</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35"/>ኢስ ኢያርኮ ከተመ ሆንጠኮ ወክት መቱ ቆቁ መንቹ ሰደቀተ ኡጨን ዎቄ ገበላን አፉዕልዮ እቅ። <verse eid="LUK 18:35"/><verse number="36" style="v" sid="LUK 18:36"/>ልግቡ መኑንኩ መዲንከስ ህገን ሞጮጭ «ኩን መርቹሃን?» ይ ጠዕሜሰ።<verse eid="LUK 18:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 18:37"/>መኑንኩ «ናዝሬት ኢስ ከን አዲን ህገኖት» ይት ኩልቶስ።<verse eid="LUK 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38"/>ሁኩ ቆቁንኩ «ዳዉዴ ቤቶ ኢሰ! ሀዕይ አሙዜኤ» የን ያሮ።<verse eid="LUK 18:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39"/>ብሬን ሃንተን ሄኦ መኑ «ጨለይ!» ይት ሻቆስ፤ ጠዉ እኮጎሬ ሁኩ ቆቁንኩ «ዳዉዴ ቤቶ! ሀዕይ አሙዜኤ» የን ላገስ ጎት አዕይ ያሮ።<verse eid="LUK 18:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40"/>ኢስን ኡር እስቤቹ ኤባገ አዘዦ፤ ሁኩ ቆቁንኩ እስቤቹ ሆንጠኮ ወክት <verse eid="LUK 18:40"/><verse number="41" style="v" sid="LUK 18:41"/>ኢስ «መ አኦሄተ ሀሰን?» ይ ጠዕሜስ፤ እስን «ቀርቾ! ለኢሃ ሀሳም!» ዬእ።<verse eid="LUK 18:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42"/>ኢስን «ለእ! አመዕነቱክ ፈይሾሄ» ዬስ።<verse eid="LUK 18:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 18:43"/>ሁኩ ቆቁ ህከ ወክትንከ ለዕዮ፤ እስን መገኑ ገለትጨን ኢሰ አዎኞ፤ ህትን ኡመቱ ጉዕሙንኩ ህካን ለኦ ወክት መገኑ ገለትጭቶኡ።<verse eid="LUK 18:43"/></para>
  <chapter eid="LUK 18"/>
  <chapter number="19" style="c" sid="LUK 19"/>
  <para style="s1">ኢሰለከ ዘክዮሴ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1"/>ኢስ ኢያርኮ ከተመ ኣግ ህከን አዲን ህገኖት እቅ። <verse eid="LUK 19:1"/><verse number="2" style="v" sid="LUK 19:2"/>ህከኔን «ዘክዮሴ» ዬኖ መንቹ ሄዕዮ እቅ፤ እስን ቀረጠ ሙርታሀኑኡተ አዛዣለከ ቀባጣሙሃ መንቹ እቅ። <verse eid="LUK 19:2"/><verse number="3" style="v" sid="LUK 19:3"/>ሁኩ መንቹንኩ ኢሰ አዬት ጎር ለኦተ ሀሰኖ እቅ፤ ጠዉ እኮጎሬ እስ ገበንቹ እኮቤቺሃለከ መኑስ ልግብ እኮቤቺሃ ለኦተ አታሎበአ። <verse eid="LUK 19:3"/><verse number="4" style="v" sid="LUK 19:4"/>ኢስ ህከን ዎቄን ህገኖቤቺሃ ዘክዮስ ብሬን ደጉደን ህግ ኢሰ ለኦተ መቶ ኦድ ሀቃን ቆጶ። <verse eid="LUK 19:4"/><verse number="5" style="v" sid="LUK 19:5"/>ኢስን ህከ ቤቹ ኢሌ ወክት አሌ ዋል ለዕይ «ዘክዮሴ! ከበር ኪ ምኔን ሆሱ ሀስሰኖቤቺሃ ደዕልት ድር» ዬስ። <verse eid="LUK 19:5"/><verse number="6" style="v" sid="LUK 19:6"/>ህካን እኮቤቺሃ ዘክዮስ ደዕል ድር ሙንዲኖን ቶጎስ። <verse eid="LUK 19:6"/><verse number="7" style="v" sid="LUK 19:7"/>መኑንኩ ህካን ለዕዮ ወክት «ጩበኛ መንች ምኒ እቶተ ኣጎ» ይት ጉዕሙንኩሰ ቁንቁቶኡ።<verse eid="LUK 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8"/>ጠዉ እኮጎሬ ዘክዮስ ኡር ኢሰ «ቀርቾ! ዮኤ ዱንያች ጉዕሚችን ደሩስ ቡጥቻኖተ ኣሳም፤ ህትን አዬሁ ጣንስ ኣኤም ጎር ሾሉ አፎስ እሲንከ ፈንቀሽ ኣሳም» ዬእ።<verse eid="LUK 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9"/>ኢስን «ኩ መንቹ እብራሂም ቤቱ እኮቤቺሃ ከበር ጡሙ ከን ምኒሃ እኮኡ። <verse eid="LUK 19:9"/><verse number="10" style="v" sid="LUK 19:10"/>መሰንትስ መንች ቤቱ በዕዮሃ ሀሶተለከ ጡምሶተ አሜቾኡ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">19፥10 </char><char style="xt" closed="false"><ref loc="MAT 18:11">ማቶ. 18፥11</ref>።</char></note><verse eid="LUK 19:10"/></para>
  <para style="s1">ቶኖ ካዲመ ምሳልተ</para>
  <para style="r">(<ref loc="MAT 25:14-30">ማቶ. 25፥14-30</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11"/>መኑ ህካን ሞጮጨንን ኢስ መት ምሳልተ በርግ ኩሎሰ፤ መሰንትስ ኢስ ዬሩሳሌመ ኢሎተ ሆንጠኮቤቺሃትለከ መገን ዎምነቱ ደዕል ለለኖሃ አጉጆሰቤቺሃት እቅ።<note caller="-" style="x"><char style="xo" closed="false">19፥11-27 </char><char style="xt" closed="false"><ref loc="MAT 25:14-30">ማቶ. 25፥14-30</ref>።</char></note> <verse eid="LUK 19:11"/><verse number="12" style="v" sid="LUK 19:12"/>ህካን እኮቤቺሃ ኢስ መቱ ጡመ ደቦች እለሞ ሎሩ መንቹ ዎመ እክ ፈንቀሎተ ቄዕራሸ ባዱ ኦሮዕዮ። <verse eid="LUK 19:12"/><verse number="13" style="v" sid="LUK 19:13"/>ህካን እኮቤቺሃ ካዲማችስ ቶኑሰ ገእ መት-መትሀሰ ቶኑ ቶኑ ምናነ<note caller="+" style="f"><char style="fqa" closed="false">ምናኑ፦ </char><char style="ft" closed="false">ኪሉተ ብኬኖሃን፤ ህትን ብረሃን፤ መቱ ምናኑ መቶ በሬ ሆጉተ አአኖ መንቺሃ ሰሶ አገን ደሞዝየ ጌሰ።</char></note> ኣስ ፈንቀል አሜቶተ ኢለ ከንን ነገጄ ዬሰ።<verse eid="LUK 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 19:14"/>ባድስ መኑ ግቦስቤቺሃ ኩ መንቹ ኒ አሌን ዎመ እሆተ ሀንሳምበአ ይት እስ ኦሮዕዮች ኤተሮን ሶቀማንቹ ሶኮኡ። <verse eid="LUK 19:14"/><verse number="15" style="v" sid="LUK 19:15"/>ሁኩ መንቹንኩ ዎመ እክ ፈንቀሎ ወክት ምናነ ኣሴሰ ካዲመት ነገድ ሄንከ ተረፍሶ ጎር ደጎተ እስቤቹ ገእቶተ አዘዦ። <verse eid="LUK 19:15"/><verse number="16" style="v" sid="LUK 19:16"/>ወዕኔስ ካዲንቹ እስቤቹ ሆንጠክ ‹ቀርቾ! መቱ ምናኑ ቶኑ ምናነ ተረፎኡ› ዬስ። <verse eid="LUK 19:16"/><verse number="17" style="v" sid="LUK 19:17"/>ሀለቅቹንኩ ‹ጡመገ አቶንት! አት ጡሙ ካዲንቹ ቀዎ ጠዋን አመዕነንቶንትቤቺሃ ቶኖ ከተም ሹመ እህ› ዬስ። <verse eid="LUK 19:17"/><verse number="18" style="v" sid="LUK 19:18"/>ህትን ለንክሲንኩ አሜች ‹ቀርቾ! መቱ ምናኑ ኦንቱ ምናነ ተረፎኡ› ዬስ። <verse eid="LUK 19:18"/><verse number="19" style="v" sid="LUK 19:19"/>ሀለቅቹንኩስ እሲሃ ‹አት ኦንቶ ከተሚሃ ሹመ እህ› ዬስ።<verse eid="LUK 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 19:20"/>ህትን «ዎሉስ አሜች ‹ቀርቾ! ሆጮን ጣጭ ማጮም መቱ ምናኑ ሁኩዕኑን። <verse eid="LUK 19:20"/><verse number="21" style="v" sid="LUK 19:21"/>መሰንትስ አት አፉሽቱዕናን ኣእታንቲሀለከ ዉጡዕነን ጭም አታንት እዲዳንቹ መንቹ እሁክ ደግ ዋጄምቤቺሃት› ዬስ። <verse eid="LUK 19:21"/><verse number="22" style="v" sid="LUK 19:22"/>ሀለቅቹንኩ ‹ኩ ሂሉ ካዲንቹ! ገዉክ ጠወኦንት ጠዊን ፈረዳንኬ፤ አን አፉሽባንከ ቶጋሚሃለከ ዉጥባንከ ጭምአኣም እድዳንቹ መንቹ እሁእ ደጎንት! <verse eid="LUK 19:22"/><verse number="23" style="v" sid="LUK 19:23"/>ህካን እኮች ምናነኤ ሚሃት ባንካን አፉሽቶንትበኢሁ? አንን አሜች ትርፊንከስን ኣኣም እቅ› ዬስ። <verse eid="LUK 19:23"/><verse number="24" style="v" sid="LUK 19:24"/>ህከኒች ኤተሮን ሀለቅቹንኩ ህከኔ ኡርቶ መነ ‹ምናነስ ቶጌን ቶኑ ምናኑ ዮስሀኒሃ ኣስዬ› ዬሰ። <verse eid="LUK 19:24"/><verse number="25" style="v" sid="LUK 19:25"/>እሰን ‹ቀርቾ! እሲሃ ቶኑ ምናኑ ዮስ!› ይቶስ። <verse eid="LUK 19:25"/><verse number="26" style="v" sid="LUK 19:26"/>ሀለቅቹንኩ ‹አን ኩላንክዕኔ፤ ዮስሀኒሃ ጉዕሚንከ በርጌን ኣሴኖስ፤ እኮጎሬ ዮስበእሀኒች ሁኩ ዮሲንኩ ኣአመኖስ።<note caller="-" style="x"><char style="xo" closed="false">19፥26 </char><char style="xt" closed="false"><ref loc="MAT 13:12">ማቶ. 13፥12</ref>፤ <ref loc="MRK 4:25">ማር. 4፥25</ref>፤ <ref loc="LUK 8:18">ሉቃ. 8፥18</ref>።</char></note> <verse eid="LUK 19:26"/><verse number="27" style="v" sid="LUK 19:27"/>ጠዉ እኮጎሬ አን ዎመ እሆተ እትትበ ህከ ዲነኤ ኢቤቹ ኤቤን እልኤ ለአን ሽዬ› ዬሰ» ዬእ። <verse eid="LUK 19:27"/><verse number="28" style="v" sid="LUK 19:28"/>ኢስ ከ ምሳልተ ጠወዕዮች ኤተሮን ዬሩሳሌመ ኦሮአን ብርተ ዋል ሃመኖት እቅ።<verse eid="LUK 19:28"/></para>
  <para style="s1">ኢስ ሎረ ኬዕምኚን ዬሩሳሌመ ኣጉስ</para>
  <para style="r">(<ref loc="MAT 21:1-11">ማቶ. 21፥1-11</ref>፤ <ref loc="MRK 11:1-11">ማር. 11፥1-11</ref>፤ <ref loc="JHN 12:12-19">ያህ. 12፥12-19</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 19:29"/>እስን «ዘይት ሀቁ ነጰኖ ቆተተ» ዬኖቤቾን ሄዕዮ «ቤተ ፋጌለከ ቢታነ» ዬኖቤቹ ሆንጠኮ ወክት አሳባች ለሙሰ <verse eid="LUK 19:29"/><verse number="30" style="v" sid="LUK 19:30"/>«ብሬክዕኔ ዮ ቀእተ መሬ፤ ህከቤቹንከ ኢልቴንተ ወክት አዪሁ ሆሮን ቆጶበእ ሀሩች ዎተረ ኡሱረሞሃ ደጌነንተ፤ ህካን ሂርቴን ከቤቹ ኤቤ። <verse eid="LUK 19:30"/><verse number="31" style="v" sid="LUK 19:31"/>አዪሁ ‹ሚሃት ሂርቴነንታሁ?› ይ ጠዕሜህዕኔ ጎር ‹ቀርቹ ሀሾቤቺሃት› ይዬ» ይ ሶኮሰ።<verse eid="LUK 19:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32"/>አሳበንት መርቶ ወክት ጉዕሙርቹንኩ ኢስ ኩሎሰገን እካን ደጎኡ። <verse eid="LUK 19:32"/><verse number="33" style="v" sid="LUK 19:33"/>እሰ ዎተረ ሂርተን ዎተርስ አናከት «ዎተረ ሚሃት ሂርቴነንታሁ?» ይቶሰ። <verse eid="LUK 19:33"/><verse number="34" style="v" sid="LUK 19:34"/>እሰን «ቀርቹ ሀሾቤቺሃት» ይት ፈንቀሽቶኡ። <verse eid="LUK 19:34"/><verse number="35" style="v" sid="LUK 19:35"/>ህከኒች ኤተሮን ዎተራስ ኢስቤቹ ኤብ ኦድኑሰ ዎተር አሌን አት ኢሰ ቆጵሲሶኡ። <verse eid="LUK 19:35"/><verse number="36" style="v" sid="LUK 19:36"/>ኢስን ቆጵ ሃመን መኑ ኦድኑሰ ዎቃን ዌሳኢት እቅ።<verse eid="LUK 19:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 19:37"/>ኢስን ዘይት ሀቁ ነጰኖ ቆተ አዲን መሰኖ ዎቄን ዬሩሳሌመ ኢሎተ ሆንጠኮ ወክት አዎነን ሄዕዮ ልግቡ መኑ ሄጭት ለኦ አጀብሲሰኖ ጠወ ጉዕመንከ ሙንደአን ላገተ ጎት አት መገኑ ገለትጩ ጀመርቶኡ። <verse eid="LUK 19:37"/><verse number="38" style="v" sid="LUK 19:38"/>እሰን «ቀርች ሱዕሚን አሜተኖ ዎሙ ማሰአሞእሃን፤ ወገሬቱ ሰማንለከ ኬዕምኙ መገኒሃ እሁን» ይታኢት እቅ።<note caller="-" style="x"><char style="xo" closed="false">19፥38 </char><char style="xt" closed="false"><ref loc="PSA 118:26">መዝ. 118፥26</ref>።</char></note><verse eid="LUK 19:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39"/>እኮጎሬ ህከን ኡመት በላን ሄኦ ፈርሳዌች መት-መቱሰ «አስተማርቾ! ኬሳሃ አዎንታ መነ ጨለ ይታገ ሻቅ!» ይቶኡ።<verse eid="LUK 19:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40"/>ኢስን «አን ኩላንክዕኔ፤ እሰ ጨለ ይቶጎሬ ኩ ክኑ ያረኖ» ይ ፈንቀሼእ።<verse eid="LUK 19:40"/></para>
  <para style="s1">ኢስ ዬሩሳሌም ከተሚሃ ኦኡስ</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41"/>ኢስን ዬሩሳሌም ከተመ ሆንጠክ ለዕዮ ወክት ከተንቾተስ ኦዕዮ። <verse eid="LUK 19:41"/><verse number="42" style="v" sid="LUK 19:42"/>«ወገሬት ኣሰኖ ጠወ ከበር ደጋንቲሃ እኮ እቃ ጡመሃን፤ ጠዉ እኮጎሬ ቴሱ እሌችክ ደጵይዮኡ። <verse eid="LUK 19:42"/><verse number="43" style="v" sid="LUK 19:43"/>ዲኑክ ጉዕመ አዲን ድችረ ድችር ከን አዲንለከ ካጵ አዲን ረብ ፉሉ ከንታሄ ወክቱ አሜተኖ። <verse eid="LUK 19:43"/><verse number="44" style="v" sid="LUK 19:44"/>ህትን መገኑ ጡምሶሄተ አሜቾ ወክት አጥራመትበቤቺሃ ዲኑክ ኬሳለከ እለክ ድጅታአ፤ ህትን ኣዜንከክ መቱ ክኑሁ መቶ ክን አሌን ፈቀኖበአ» ይ ኦዕዮ።<verse eid="LUK 19:44"/></para>
  <para style="s1">ኢስ ዱእ ምናች ጌባ አታእረ ፉሹስ</para>
  <para style="r">(<ref loc="MAT 21:12-17">ማቶ. 21፥12-17</ref>፤ <ref loc="MRK 11:15-19">ማር. 11፥15-19</ref>፤ <ref loc="JHN 2:13-22">ያህ. 2፥13-22</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45"/>ህከኒች ኤተሮን ኢስ ዱእ ምኒ ኣግ ነገደኖ መነ አብል ሸሬእ። <verse eid="LUK 19:45"/><verse number="46" style="v" sid="LUK 19:46"/>ህትን እሰንተ « ‹ምኑኤ ዱአ አኤኖሃ ምኒ› የመም ከተበሞኡ፤ እኮጎሬ አዕኑ ሽፍጡ ማጠንታ ሻንቀ አቴንታአ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">19፥46 </char><char style="xt" closed="false"><ref loc="ISA 56:7">ኢሳ. 56፥7</ref>፤ <ref loc="JER 7:11">ኤር. 7፥11</ref>።</char></note><verse eid="LUK 19:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47"/>እስን ጉዕመ በርንከ መገን ምኔን ተማርሰኖት እቅ፤ ቂስ አወንሳኑት፥ ሕግ አስተማረትለከ መነ አዎንስታእሩ ኢሰ ሽቶተ ሀሳኢት እቅ።<note caller="-" style="x"><char style="xo" closed="false">19፥47 </char><char style="xt" closed="false"><ref loc="LUK 21:37">ሉቃ. 21፥37</ref>።</char></note> <verse eid="LUK 19:47"/><verse number="48" style="v" sid="LUK 19:48"/>ጠዉ እኮጎሬ መኑ ጉዕሙንኩ ኢስ ጠወአኖ ጠወ ቀልቢን ሞጮጭታቤቺሃ እሰ መ አታጎር ደጎበአ።<verse eid="LUK 19:48"/></para>
  <chapter eid="LUK 19"/>
  <chapter number="20" style="c" sid="LUK 20"/>
  <para style="s1">ኢስ መ ሹምነቲን አአኖጎሬ ጠዕሜመገ</para>
  <para style="r">(<ref loc="MAT 12:23-27">ማቶ. 12፥23-27</ref>፤ <ref loc="MRK 11:27-33">ማር. 11፥27-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1"/>መቱ በር ኢስ ዱአ አኤኖ ምኔን መነ ተማርሰንለከ ተሽት ላገተ ዱዱብሰን ቂስ አዎንሳኑት፥ ሕግ አስተማረትለከ ባድ ባልቀት ሜጡበ አሜት <verse eid="LUK 20:1"/><verse number="2" style="v" sid="LUK 20:2"/>«ህንዴ ኩልኔ፤ ካን አታንቲሁ መ ዎልቃኒት? ህከረንገ ካን አታንት ዎልቀተ ኣሴሄሁ አዬት?» ይት ጠዕምቶስ። <verse eid="LUK 20:2"/><verse number="3" style="v" sid="LUK 20:3"/>ኢስን «አን መቱ ጠወ ጠዕማንክዕኔ፤ ህንዴ ቴሱ ኩሌኤ፤ <verse eid="LUK 20:3"/><verse number="4" style="v" sid="LUK 20:4"/>ያህይ ጠመቀኖ ዎልቀተ ደኤኢሁ መገን አዲኒትንዶ መን አዲኒት?» ዬእ።<verse eid="LUK 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5"/>ህከ ወክት ገገዉንኩሰን « ‹መገን አዲኒት› ይኖም ጎር ‹ሚሃት ያህዪን አመዕንቴንታበአ?› የኖኔ፤ <verse eid="LUK 20:5"/><verse number="6" style="v" sid="LUK 20:6"/>ጠዉ እኮጎሬ ‹መን አዲኒት› ይኖም ጎር መኑ ጉዕሙንኩ ያህይ ነብዬቹ እሁስ አመዕነኖቤቺሃ ክኒን ቀሳኔ» ይት ጠወኦኡ። <verse eid="LUK 20:6"/><verse number="7" style="v" sid="LUK 20:7"/>ህካን እኮቤቺሃ «ሀከን አዲኒት ጎር ደንጎምበአ» ይት ፈንቀሽቶኡ። <verse eid="LUK 20:7"/><verse number="8" style="v" sid="LUK 20:8"/>ኢስን እሰንተ «አን ካን አዬ ወልቃን አኣም ጎር ኩላንክዕኔበአ» ዬእ።<verse eid="LUK 20:8"/></para>
  <para style="s1">ወይን ላሉተ ካሶ አቡራኖ ምሳልተ</para>
  <para style="r">(<ref loc="MAT 21:33-46">ማቶ. 21፥33-46</ref>፤ <ref loc="MRK 12:1-12">ማር. 12፥1-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9"/>ህከኒች ኤተሮን ኢስ መኒሃ «መቱ መንቹ ወይን ላሉተ ካሾ፤ ወይነስ ቀባንቺሃ ኣስ ዎሉ ባዱ ኦሮዕይ ልግብ ወክት ዱንኬእ።<note caller="-" style="x"><char style="xo" closed="false">20፥9 </char><char style="xt" closed="false"><ref loc="ISA 5:1">ኢሳ. 5፥1</ref>።</char></note> <verse eid="LUK 20:9"/><verse number="10" style="v" sid="LUK 20:10"/>እስን ወይኑስ ላለኖ ወክቱ እሌ ውክት ወይን ላልቺች እሲሃ ኢለኖ ወጥ ኣቶተ መቱ ካዲንቹ ቀባኖስቤቹ ሶኮ፤ ጠዉ እኮጎሬ ቀባኑስ ሶሀሞ ካዲንቹ ኦልት መቱርቹሃ ኣቱዕነ ሸርቶኡ። <verse eid="LUK 20:10"/><verse number="11" style="v" sid="LUK 20:11"/>ለንክ ወክት ዎሉ ካዲንቹ ሶኮ፤ ህትን እሰን ህከ ካዲንቹ ኦልትለከ ሙልስ መቱርቹሃ ኣቱዕነ ሸርቶኡ። <verse eid="LUK 20:11"/><verse number="12" style="v" sid="LUK 20:12"/>ህትን ሰቂሃ ሶኮ ወክት እሱንከ ኦልት ጡላይስ አብል ዋሽት ኡጅቶስ። <verse eid="LUK 20:12"/><verse number="13" style="v" sid="LUK 20:13"/>ህከኒች ኤተሮን ወይንስ አኑ ‹መ አኡ? ኢታም ቤቱኤ ሶሃም፤ አይደጎ እሱ ከበጅታኢሃ እሀኖ› ዬእ። <verse eid="LUK 20:13"/><verse number="14" style="v" sid="LUK 20:14"/>ጠዉ እኮጎሬ ቀባኑንት እሱ ለኦ ወክት መት-መቲንከሰ ‹ረገአኖሁ ከኒት፤ ዮስርቹ ኒሀ እሆተ እሱ ሽኖ› የቀንቶኡ። <verse eid="LUK 20:14"/><verse number="15" style="v" sid="LUK 20:15"/>እሰን እሱ ወይን ኣዚች አብል ፉሽት ሽቶኡ፤ ቴሱ ወይንስ አኑ ህከ ቀባኑተ መ አአኖ? <verse eid="LUK 20:15"/><verse number="16" style="v" sid="LUK 20:16"/>ወይንስ አኑ አሜች ህከ ቀባኑተ ሽ ኬዕይ ወይነስ ዎሎ መኒሃ ኣሰኖ» ይታ ምሳልተ ኩሎሰ። እሰን ህካን ሞጮጭቶ ወክት «ህትኔርቹ መገኑ ኤቡንከኔ» ይቶኡ።<verse eid="LUK 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17"/>ጠዉ እኮጎሬ ኢስ እሰንተ ለዕይ «ህካን እኮች ‹ግንበኛኑት ህንቆ ክኑ እስ ሙረበ ቡዕል ክኑ እሀኖ› የመም ከተበሞሁ መ ለሊሰኖ?<note caller="-" style="x"><char style="xo" closed="false">20፥17 </char><char style="xt" closed="false"><ref loc="PSA 118:22">መዝ. 118፥22</ref>።</char></note><verse eid="LUK 20:17"/></para>
  <para style="m">
    <verse number="18" style="v" sid="LUK 20:18"/>ህከን ክኖን ኡቦ አዪሁ ቁሽቁሽ የኖ፤ ጠዉ እኮጎሬ ሁኩ ክኑ አዬ አሌኒ ኡቦጎሬ ፍጭርቀኖስ» ዬእ።<verse eid="LUK 20:18"/></para>
  <para style="s1">ግብር ባቲሃ ኢሰ ጠዕሜመገ</para>
  <para style="r">(<ref loc="MAT 22:15-22">ማቶ. 22፥15-22</ref>፤ <ref loc="MRK 12:13-17">ማር. 12፥13-17</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19"/>ሕግ አስተማረትለከ ቂስ አዎንሳኑት ኢስ ህከን ምሳሌን እሳሃ ጠወኡስ ደግ ህከ ወክትንከ አፎስተ ሀሶኡ፤ ጠዉ እኮጎሬ መነ ዋጅቶኡ። <verse eid="LUK 20:19"/><verse number="20" style="v" sid="LUK 20:20"/>ህትን ገሽ ወልቀትለከ ሹምነቱ ዮስ ገሻንቺሃ ህግስ ኣቶተ መከኖ ወክት ሀሳኢት እቅ፤ ህካን እኮቤቺሃ ፈየ መነ አጉደን ጠውንከስ ትርቲባ መነ ሶኮኡ። <verse eid="LUK 20:20"/><verse number="21" style="v" sid="LUK 20:21"/>እሰን ኢሰ «አስተማርቾ! ሀንቅ ጠወኣንትገለከ ሀንቅ ተማርስታንትገ መን እልተ ለእ ጎልቱዕነ ሀንቅ መገን ዎቃሃ ተማርስታንትገ ደንጋም። <verse eid="LUK 20:21"/><verse number="22" style="v" sid="LUK 20:22"/>ሮም ዎሚሃ ግብር ባቱ ፈቀደሞእሃንዶ ፈቀደሞበእሃን?» ይት ጠዕምቶኡ።<verse eid="LUK 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23"/>ጠው እኮጎሬ ኢስ ተንኩሰ ለዕይ <verse eid="LUK 20:23"/><verse number="24" style="v" sid="LUK 20:24"/>«መቱ ዲናረ ለሊሼኤ፤ ከን ዲናር አሌን ዮ ፎቱትለከ ሱዕሙ አዬሃን?» ዬሰ፤ እሰን ቂሳርያ ይቶኡ።<verse eid="LUK 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25"/>እስን «ህካን እኮች ዎሚሃ ዎሚንከ ህትን መገኒሃ መገኒንከ ኣስዬ» ዬሰ።<verse eid="LUK 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26"/>ህካን እኮቤቺሃ እሰን እስ ጠወዕዮ ጠዊን መን ብሬን ትርቲቦስተ አታልቶበአ፤ እኮጎሬ እስ ፈንቀሼ ጠዊን አጀብሲጭት ጨለ ይቶኡ።<verse eid="LUK 20:26"/></para>
  <para style="s1">ሬሆች ኬእተኔሃ</para>
  <para style="r">(<ref loc="MAT 22:23-33">ማቶ. 22፥23-33</ref>፤ <ref loc="MRK 12:18-27">ማር. 12፥18-27</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27"/>ህከኒች ኤተሮን «ሬዮ መኑ ሬሆች ኬአኖበአ» ይት ተማርስተ «ሰዱቃውተ» ዬኖ መኒች መት-መቱ ኢስቤቹ አሜት<note caller="-" style="x"><char style="xo" closed="false">20፥27 </char><char style="xt" closed="false"><ref loc="ACT 23:8">ሶቀ. 23፥8</ref>።</char></note> <verse eid="LUK 20:27"/><verse number="28" style="v" sid="LUK 20:28"/>«አስተማርቾ! ሙስ ‹መቱ መንቹ ጫተ ኤብ እለተ እሉዕነ ሬዮጎር መንችስ አመቤቱ ሬያን ጫስ ረገዕይ አመስ ቤቲሀ እለተ እሉን› ይ ሴራን ከተቦኔ።<note caller="-" style="x"><char style="xo" closed="false">20፥28 </char><char style="xt" closed="false"><ref loc="DEU 25:5">ዘዳ. 25፥5</ref>።</char></note> <verse eid="LUK 20:28"/><verse number="29" style="v" sid="LUK 20:29"/>መቱ ወክት ለመሉ አመኦሱት ሄኦ እቅ፤ እሳችን ሀንገፉስ ጫተ ኤብ እለተ እሉዕነ ሬዮ። <verse eid="LUK 20:29"/><verse number="30" style="v" sid="LUK 20:30"/>ህትን አሌስ እለሞ አመስቤቱ ጫስ ረገዕዮ፤ <verse eid="LUK 20:30"/><verse number="31" style="v" sid="LUK 20:31"/>አሌስ እለሞ ሰቅ ማዕኑንኩ ረገዕዮ፤ ከን ሃሌን ለመሉንኩ አመኦሱት ረገእ እለተ እልቱዕነ ሬቶኡ። <verse eid="LUK 20:31"/><verse number="32" style="v" sid="LUK 20:32"/>ጉዕሚችሰ ኤተሮን ህት ጫቲ ሬቶኡ። <verse eid="LUK 20:32"/><verse number="33" style="v" sid="LUK 20:33"/>ህካን እኮቤቺሃ ለመሉንኩ ኣእቶሴቤቺሃ ሬቶሩ ሬሆች ኬኣ ወክት ህት ጫት ሀከኒሀስ እካአ?» ይት ጠዕምቶስ።<verse eid="LUK 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34"/>ኢስን እሳንከ «ከን ኣዱንያ አሌን ሄአኖ መኑ ኤባኢሁ፥ መእሲሳኢሁ። <verse eid="LUK 20:34"/><verse number="35" style="v" sid="LUK 20:35"/>ጠዉ እኮጎሬ ሬሆች ኬኢሀለከ አሜተኖ ዘማኔን ሄኦተ ሀስሰኖሰሩ ኤበቅታበኢሁ፥ መእሲሳበኢሁ። <verse eid="LUK 20:35"/><verse number="36" style="v" sid="LUK 20:36"/>እሰን ሰሜ መላይከገ እካቤቺሃ ለንኪሃ ሬታበአ፤ ህትን እሰን ሬሆች ኬኦቤቺሃ መገንተ ኦሱ። <verse eid="LUK 20:36"/><verse number="37" style="v" sid="LUK 20:37"/>ህትን ሙስ ቡባ ሽፎተኔሃ ከተቦሀኔን ቀርቹ ‹እብራሂምሃ መገኑ፥ ኢሳቅሃ መገኑለከ ያቁብሃ መገኑ› ይ ገእ ሬቶሩ ኬኣገ ለሊሾኡ።<note caller="-" style="x"><char style="xo" closed="false">20፥37 </char><char style="xt" closed="false"><ref loc="EXO 3:6">ፉል. 3፥6</ref>።</char></note> <verse eid="LUK 20:37"/><verse number="38" style="v" sid="LUK 20:38"/>ህካን እኮች መገኑ ፎልን ሄዕዮ መኒሃ መገኑ ቤሉ ሬዮ መኒሃ መገኑበአ፤ መሰንትስ እሲን ጉዕሙንኩ ፎሊን ሄኣቤቺሃት» ይ ፈንቀሼእ።<verse eid="LUK 20:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39"/>ህትን ሕግ አስተማራች መት-መቱ ፈንቀሽት «አስተማርቾ! ጡመገ ጠወኦንት» ይቶኡ። <verse eid="LUK 20:39"/><verse number="40" style="v" sid="LUK 20:40"/>ህከኒች ኤተሮን እሰን ኢሰ መቱርቹሃ ጠዕምቶተ መለልቶበአ።<verse eid="LUK 20:40"/></para>
  <para style="s1">ኢሰ ገይስተኔሃ ጠዕሜመገ</para>
  <para style="r">(<ref loc="MAT 22:41-46">ማቶ. 22፥41-46</ref>፤ <ref loc="MRK 12:35-37">ማር. 12፥35-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41"/>ጠዉ እኮጎሬ ኢስ «እሰንተ ‹መሲሁ ደዉዴሃ ቤቱ› ዪ አታልቶኢሁ ሀትዪት? <verse eid="LUK 20:41"/><verse number="42-43" style="v" sid="LUK 20:42-43"/>መሰንትስ ዳዉድ ገዉንኩስ መዝሙር መጻፋን</para>
  <para style="q1" vid="LUK 20:42-43">« ‹ቀርቹ ቀርቺሃኤ</para>
  <para style="q2" vid="LUK 20:42-43">አን ዲነክ ሎከክ ኣዜን አኦተ ኢለ</para>
  <para style="q2" vid="LUK 20:42-43">መኬኤ አዲን አፉዕል› ዬስ የኖ።<note caller="-" style="x"><char style="xo" closed="false">20፥42-43 </char><char style="xt" closed="false"><ref loc="PSA 110:1">መዝ. 110፥1</ref>።</char></note><verse eid="LUK 20:42-43"/></para>
  <para style="m">
    <verse number="44" style="v" sid="LUK 20:44"/>ዳዉድ ‹ቀርቾ› ይ ገኤሲች መሲሁ ሀት እክ ቤቱስ እሀኖ?» ዬሰ።<verse eid="LUK 20:44"/></para>
  <para style="s1">ኢስ ሕግ አስተማራች አገዕርታገ ጠወኡስ</para>
  <para style="r">(<ref loc="MAT 23:1-36">ማቶ. 23፥1-36</ref>፤ <ref loc="MRK 12:38-40">ማር. 12፥38-40</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45"/>ህትን መኑ ጉዕሙንኩ ሞጮጨን ኢስ አሳበስ <verse eid="LUK 20:45"/><verse number="46" style="v" sid="LUK 20:46"/>«ቅራዕሩ ኦድኑተ ኦደእ ሃሙ፥ በነቻን ኬዕምኚን ጠዉሲሶኖሰተ፥ ጭምት ምናን ኬዕሚኝ ቦርጭማን አፉዕሉለከ ድግሰ ድግሴመ ቤቾን ኬዕሚኝ ቤቹ ኢትታ ሕግ አስተማራች አገርዕዬ። <verse eid="LUK 20:46"/><verse number="47" style="v" sid="LUK 20:47"/>እሰን አመሰልት መኑ ለኦሰተ ቅራርስት ዱአ አተን ምንሰ አኑ ሬዮ ሜንቱ ጣንስተን እታአ፤ ህካን እኮቤቺሃ እሳሃ አበ ፍርደ እሀኖሰ» ዬእ።<verse eid="LUK 20:47"/></para>
  <chapter eid="LUK 20"/>
  <chapter number="21" style="c" sid="LUK 21"/>
  <para style="s1">ምንሴ አኑ ሬዮ መንቹት ኣቶ ኣስቱተ</para>
  <para style="r">(<ref loc="MRK 12:41-44">ማር. 12፥41-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1"/>ኢስ ሰደቀተ ቶጌኖ ሳጥናን ቀባጣመት ብረ ዎርተን እልስ አሌ ዋሽ ለአኖት እቅ። <verse eid="LUK 21:1"/><verse number="2" style="v" sid="LUK 21:2"/>ህትን ምንሴ አኑ ሬዮ ቡጥቹት መንቹት ለም ቀቅቻኑተ ሳንትበተ ወርተን ለዕዮ። <verse eid="LUK 21:2"/><verse number="3" style="v" sid="LUK 21:3"/>እስን «ሀንቅንከ ያንክዕኔ፤ ት ምንሴ አኑ ሬዮ ቡጥቹት መንቹት ጉዕሚችሰን አበ ኣቶኡ። <verse eid="LUK 21:3"/><verse number="4" style="v" sid="LUK 21:4"/>መሰንትስ እሰ ጉዕሙንኩሰ ኣቶኢሁ ዮሰ ዱንያች በተዕዮሳሃት፤ ጠዉ እኮጎሬ እሴ ቡጥማንከሴ ሄኦተ ደግለለኖሴሃ ዮሴሃ ጉዕመንከ ኣቶኡ» ዬእ።<verse eid="LUK 21:4"/></para>
  <para style="s1">ዱእ ምኑ ድጀመኖገ ኢስ ራጎገ</para>
  <para style="r">(<ref loc="MAT 24:1-2">ማቶ. 24፥1-2</ref>፤ <ref loc="MRK 13:1-2">ማር. 13፥1-2</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5"/>መት-መቱ መኑ መገን ምኑ ተሽ የኖ ክኒንለከ መገኒሃ ኣሴመ ኣስቶን መክሴናን ተሽ የኖሃ እሁስ ጠወኣኢት እቅ። <verse eid="LUK 21:5"/><verse number="6" style="v" sid="LUK 21:6"/>ኢስን «ኩ ለኤነንተ ክኑ መቶ ክን አሌን እክ ፈቁዕነ ድረሸመኖ በሩ አሜተኖ» ዬእ።<verse eid="LUK 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7"/>ህከኒች ኤተሮን እሰን «አስተማርቾ! ኩ ጠዉ እሀኖሁ መ በርሃት? ህትን ኩ ጠዉ እሆተ ሆንጠሁስ ደንጋም መላስ መርቹሃን?» ይት ጠዕምቶስ።<verse eid="LUK 21:7"/></para>
  <para style="s1">ቀርቹ አሜቱዕናን ሄጭ እካ ኦርሸተ</para>
  <para style="r">(<ref loc="MAT 24:3-14">ማቶ. 24፥3-14</ref>፤ <ref loc="MRK 13:3-13">ማር. 13፥3-13</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8"/>ኢስን «አዪሁ ሉስሰኖህዕኔበእገ አገርዕዬ፤ መሰንትስ ልግቡ መኑ ‹አን መሲሁት› ይተንለከ ‹ወክቱ ኢልዮኡ› ይተን ሱዕሚንከኤ አሜታአ፤ እኮጎሬ እሰንተ አዎንቶኖቼ። <verse eid="LUK 21:8"/><verse number="9" style="v" sid="LUK 21:9"/>ህትን ኦለለከ ተንበከሰ ሞጮጭቴንተ ወክት ህልቆኖቼ፤ መሰንትስ ሁኩን ሄጭ እሁ ሀስሰኖስ፤ ጠዉ እኮጎሬ መጨረሹ ደዕል እሀኖበአ» ዬእ።<verse eid="LUK 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10"/>ህከኒች ኤተሮን ኢስ እሳሃ «ኡመቱ ኡመት አሌን ዎሙ ዎም አሌን ኬአኖ። <verse eid="LUK 21:10"/><verse number="11" style="v" sid="LUK 21:11"/>ህትን አቡ ኡለ ሌንቄቁ፥ ቤቾን ቤቾን ጎሩለከ ዌረሩ እሀኖ፤ ህትን ዋጅሲሰኖርቹለከ አቡ መላት ሰማን ለልታአ። <verse eid="LUK 21:11"/><verse number="12" style="v" sid="LUK 21:12"/>ጠዉ እኮጎሬ ህከን ጠዊች ጉዕሚችን ሄጭ ክዕኔተ መኑ አፈኖለከ ሸረኖ፤ ህትን ጭምት ምኒለከ ኡሱር ምኒ ህግስ ኣስታህዕኔ፤ ህትን ሱዕምኤተኔሃ ዳኛኖለከ ገሻኖ ብርተ ኤባህዕኔ። <verse eid="LUK 21:12"/><verse number="13" style="v" sid="LUK 21:13"/>ህከ ወክትንከ አዕኑ እሳሃ መሰከርቶኖተ መከኖ ወክት እሀኖህዕኔ። <verse eid="LUK 21:13"/><verse number="14" style="v" sid="LUK 21:14"/>ሄጭቴንን ‹መ ይን ፈንቀሽናም› ይቴን ጠዊሀስ ቀልቤክዕኔ ሸዞኖቼ።<note caller="-" style="x"><char style="xo" closed="false">21፥14-15 </char><char style="xt" closed="false"><ref loc="LUK 12:11-12">ሉቃ. 12፥11-12</ref>።</char></note> <verse eid="LUK 21:14"/><verse number="15" style="v" sid="LUK 21:15"/>መሰንትስ አን ዲንችክዕኔ አዪሁ አታሎተ ህከረንገ ሀምበዕለሞተ አታልበ ላገተለከ ሀይመተ ኣሳንክዕኔ። <verse eid="LUK 21:15"/><verse number="16" style="v" sid="LUK 21:16"/>ሆሮን አናከክዕኔ፥ አመክዕኔ ኦሱት፥ እሉክዕኔለከ ጃለክዕኔ ፈቁዕነ ህግስ ኣስታህዕኔ፤ ህትን እሰን ክዕኔች መቱ-መቱክዕኔ ሽታአ። <verse eid="LUK 21:16"/><verse number="17" style="v" sid="LUK 21:17"/>ህትን ሱዕምኤተኔሃ ጉዕማንከ መንቤቾን ግበንቴንታእረ እኬነንተ። <verse eid="LUK 21:17"/><verse number="18" style="v" sid="LUK 21:18"/>ጠው እኮጎሬ ቡዕልክዕኔ ሙሚች ሜጥት በኣበአ። <verse eid="LUK 21:18"/><verse number="19" style="v" sid="LUK 21:19"/>ህካን አታዕሊን ፎልክዕኔ ጡምሴነንተ» ዬእ።<verse eid="LUK 21:19"/></para>
  <para style="s1">ኢስ ዬሩሳሌም ከተሙ በአኖገ ሄጭ ጠወኡስ</para>
  <para style="r">(<ref loc="MAT 24:15-21">ማቶ. 24፥15-21</ref>፤ <ref loc="MRK 13:14-19">ማር. 13፥14-19</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20"/>ኢስ «ዬሩሳሌመ ወታደሩ ረብ አፋን ለኤንተ ወክት በኢሃ ሆንጠሁስ ደጌ። <verse eid="LUK 21:20"/><verse number="21" style="v" sid="LUK 21:21"/>ህከ ወክት ይሁድ ባዶን ሄዕዮ መኑ ቆተተ ዋል ዞሁን፤ ህትን ዬሩሳሌም ከተም ኣዜን ሄኦእሩ ህከን አዲች ፉልቱን፤ ህትን ከተሚች አብል ባዶን ሄኦእሩ ከተም ኣዝ ኣጉንከ። <verse eid="LUK 21:21"/><verse number="22" style="v" sid="LUK 21:22"/>መሰንትስ ከተበሞርቹ ጉዕሙንኩ ዊሞተ ኩን ገዱተ ፉልሃ ወክት።<note caller="-" style="x"><char style="xo" closed="false">21፥22 </char><char style="xt" closed="false"><ref loc="HOS 9:7">ሆሴ. 9፥7</ref>።</char></note> <verse eid="LUK 21:22"/><verse number="23" style="v" sid="LUK 21:23"/>ህከ ወክት ላፈ ሜንቲሀለከ ቀንስታ ሜንቲሃ ቆሀኖህዕኔ፤ መሰንትስ አቡ ኦርሸት ኣዱንያ አሌን እካአ፤ ህትን መገን ኡሙዕርት ከን ኡመት አሌን አሜታአ። <verse eid="LUK 21:23"/><verse number="24" style="v" sid="LUK 21:24"/>እሳችን መት-መቱሰ ሲፊን ጎረጠንታአ፤ ህትን ዎሉሰ አገንት ኡመት ቤቹ ጉዕመንከ መርታአ፤ ህትን አይሁዳ እህቡ መኑ ወክቱስ ኢሎተ ኢለ ዬሩሳሌማን ተንበከሳአ» ዬእ።<verse eid="LUK 21:24"/></para>
  <para style="s1">ኢስ ለንኪሃ ፈንቀል አሜቱስ</para>
  <para style="r">(<ref loc="MAT 24:29-31">ማቶ. 24፥29-31</ref>፤ <ref loc="MRK 13:24-27">ማር. 13፥24-27</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25"/>ኢስ «አሮን፥ አገንቾንለከ ቤዜን መላት ለልታአ፤ ህትን ኣዱንያ አሌን ሄዕዮ መኑ ባርለከ ዊ ሁል ዋጅሲሰኖ ላጋች ኬዕዮሀኒን ዋጅት ጨነቀንታአ።<note caller="-" style="x"><char style="xo" closed="false">21፥25 </char><char style="xt" closed="false"><ref loc="ISA 13:10">ኢሳ. 13፥10</ref>፤ <ref loc="EZK 32:7">ሕዝ. 32፥7</ref>፤ <ref loc="JOL 2:31">ኢዩ. 2፥31</ref>፤ <ref loc="REV 6:12-13">መና. 6፥12-13</ref>።</char></note> <verse eid="LUK 21:25"/><verse number="26" style="v" sid="LUK 21:26"/>ሰማንዮርቹ ሌንቄቀኖ ቤቺሃ መኑ ዋጅት ኣዱንያ አል አሜተኖርቹ አገዕርተን ቀልብሰ ሉሳአ። <verse eid="LUK 21:26"/><verse number="27" style="v" sid="LUK 21:27"/>ህከ ወክት እሰን መንች ቤቱ ወልቃንለከ ሎረ ኬዕሚኚን ጎመ ኣዚን አሜተን ለኣአ።<note caller="-" style="x"><char style="xo" closed="false">21፥27 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳን. 7፥13</ref>፤ <ref loc="REV 1:7">መና. 1፥7</ref>።</char></note> <verse eid="LUK 21:27"/><verse number="28" style="v" sid="LUK 21:28"/>ኩ ጠው ጉዕሙንኩ እሆተ ጀመሮ ወክት ጡሙኔ ሆንጠኮቤቺሃ አሌ ዋሽቴን ለዕዬ» ዬእ።<verse eid="LUK 21:28"/></para>
  <para style="s1">ቀርቹ አሜተኖገ ለሊሰ ኦድ ሀቁቾ ምሳልተ</para>
  <para style="r">(<ref loc="MAT 24:32-35">ማቶ. 24፥32-35</ref>፤ <ref loc="MRK 13:28-31">ማር. 13፥28-31</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29"/>ህከኒች ኤተሮን ኢስ መት ምሳልተ እሳንከ «ኦድ ሀቁቹተለከ ዎሉ ጉዕመንከ ሀቀ ቀልቢን ለዕዬ። <verse eid="LUK 21:29"/><verse number="30" style="v" sid="LUK 21:30"/>ሁኩ ሀቁንኩ ለቾገ ለኤነንተ ወክት ሀጎ ሆንጠሁስ ገውንኩክዕኔ ደጌነንተ። <verse eid="LUK 21:30"/><verse number="31" style="v" sid="LUK 21:31"/>ህትን ኩ ጉዕሙንኩ ጠዉ እሀን ለኤንተ ወክት መገን ዎምነቱ ሆንጠሁስ ደጌ።<verse eid="LUK 21:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 21:32"/>«ሀንቅንከ ያንክዕኔ፤ ኩ ጉዕሙንኩ ጠው እሆተ ኢለ ከን ዘማን መኑ ህገኖበአ። <verse eid="LUK 21:32"/><verse number="33" style="v" sid="LUK 21:33"/>ሰሞለከ ኡለት ህጋአ፤ ጠው እኮጎሬ ላገኤ ሆሮን ህጋበአ።»<verse eid="LUK 21:33"/></para>
  <para style="s1">ጠረኜን አገዕሩ</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34"/>ወክቲሀስ «ደግለልበርቹ እቲን፥ ሰከሪንለከ ከን ኣዱንያ አል ጠው ሻዞን ቀልቡክዕኔ ሆግበገ ሁኩ በሩ ድንገቴን ወሻድገ አሌክዕኔ አሜች አፍበህዕኔገ ገዉክዕኔ አገዕርዬ። <verse eid="LUK 21:34"/><verse number="35" style="v" sid="LUK 21:35"/>መሰንትስ ሁኩ በሩ ኣዱንያ አሌን ጉዕማንን ሄአኖ መንቤቹ አሜተኖ። <verse eid="LUK 21:35"/><verse number="36" style="v" sid="LUK 21:36"/>ህካን እኮቤቺሃ ከን አሜተኖ ጠዊች ጉዕሚችን ጡምቴነንተ ዎልቀተ ደእቶኖተለከ መንች ቤት ብሬን ኡሩ አታልቶኖተ ዱአ አቴነን ጉዕመ ወክትንከ ጠረኝዬ» ይ ኩሎ።<verse eid="LUK 21:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37"/>ኢስን መገን ምኔን ጉዕመ በርንከ ተማርሰን ኡለት ሀዎርታ ወክት ዘይት ሀቁ ነጰኖ ቆተተ ፉለን ገለኖ እቅ።<note caller="-" style="x"><char style="xo" closed="false">21፥37 </char><char style="xt" closed="false"><ref loc="LUK 19:47">ሉቃ. 19፥47</ref>።</char></note> <verse eid="LUK 21:37"/><verse number="38" style="v" sid="LUK 21:38"/>ህትን መኑ ጉዕሙንኩ መገን ምኔን እሲች ሞጮጮተ ገስመ ሱጵተ እስቤቹ አሜተኖ እቅ።<verse eid="LUK 21:38"/></para>
  <chapter eid="LUK 21"/>
  <chapter number="22" style="c" sid="LUK 22"/>
  <para style="s1">ኢሰ ሾኖተ አማዕለሜመገ</para>
  <para style="r">(<ref loc="MAT 26:1-5">ማቶ. 26፥1-5</ref>፤ <ref loc="MRK 14:1-2">ማር. 14፥1-2</ref>፤ <ref loc="JHN 11:45-53">ያህ. 11፥45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1"/>ራጭቱ ዮበኢሃ ጨሊሰሞ ጦሮሹ እቴነን ከበጄኖ ከበጃቱ ሆንጠኮ እቅ።<note caller="-" style="x"><char style="xo" closed="false">22፥1 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">ፉል. 12፥1-27</ref>።</char></note> <verse eid="LUK 22:1"/><verse number="2" style="v" sid="LUK 22:2"/>ህከ ወክት ቂስ አዎንሳኑትለከ ሕግ አስተማረት መነ ዋጅቶቤቺሃ ኢሰ ሀት አት ሽታጎር ዎቃ ሀሳኢት እቅ።<verse eid="LUK 22:2"/></para>
  <para style="s1">ይሁድ ኢሰ ህግሽ ኣሶተ አማዕለሙስ</para>
  <para style="r">(<ref loc="MAT 26:14-16">ማቶ. 26፥14-16</ref>፤ <ref loc="MRK 14:10-11">ማር. 14፥10-11</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 22:3"/>ህከኒች ኤተሮን ቶና ለሞንከ አሳባች መቶንከስ «አስቆሮንቶ» ዬኖ ይሁዳን ሼይጣኑ ኣጎ። <verse eid="LUK 22:3"/><verse number="4" style="v" sid="LUK 22:4"/>እስን ኦሮዕይ ቂስ አዎንሳኖንለከ ዱእ ምኒ አገርታ ወታደር አዛዣን ኢሰ እሳንከ ህግሽ ኣሰኖ ዎቃሃ አማዕለሞ። <verse eid="LUK 22:4"/><verse number="5" style="v" sid="LUK 22:5"/>እሰን ሙንደእ ብረ ኣቶተ ዉለ ኡርሶኡ። <verse eid="LUK 22:5"/><verse number="6" style="v" sid="LUK 22:6"/>ህካን እኮቤቺሃ እስን ዉላንከስ አማዕለም መኑ ዮበእቤቾን ኢሰ እሳሃ ህግሽ ኣሶተ መከኖ ወክት ሀሰኖት እቅ።<verse eid="LUK 22:6"/></para>
  <para style="s1">ኢስ ሻሽግ ሁርባት አሳባንተስን እቱስ</para>
  <para style="r">(<ref loc="MAT 26:17-25">ማቶ. 26፥17-25</ref>፤ <ref loc="MRK 14:12-21">ማር. 14፥12-21</ref>፤ <ref loc="JHN 13:21-30">ያህ. 13፥21-30</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7"/>ህከኒች ኤተሮን ሻሽግ ሆልቹ ዱሌን ራጭቱ ዮበኢሃ ጨሊሰሞ ጦሮሹ እቴነን ከበጄኖ ከበጀ በሩ ሆንጠኮ። <verse eid="LUK 22:7"/><verse number="8" style="v" sid="LUK 22:8"/>ህካን እኮቤቺሃ ኢስ ጴጥሮሴለከ ያህይ «መርቴን ሻሽግ ሁርባት እንቶተ ተቃጠቤ» ይ ሶኮ።<verse eid="LUK 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 22:9"/>እሰን «ህካን ሀከንቤቾን ተቃጠንቦሄተ ሀሰን?» ይቶስ።<verse eid="LUK 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 22:10"/>እስን «ከተመ ኣጌንተ ወክት ዊ ምዳኑተ እጄ መንቺን ደቀንቴነንተ፤ እስን ኣገኖ ምኒ አዎንቴን መርቴን <verse eid="LUK 22:10"/><verse number="11" style="v" sid="LUK 22:11"/>ምንስ አኒንከ ‹አስተማርቹ አሳባንን ሻሽግ ሁርባት እታም ኮሁ ገለኖቤቹ ሀከንቤቾንት? የኖሄት› ይቴን ኩሌስ። <verse eid="LUK 22:11"/><verse number="12" style="v" sid="LUK 22:12"/>እስን ሀስሰኖርቹ ጉዕሙንኩ ተቃጠቦ ፉቅ ምኔን አልባዕሉ ቤቹ ለሊሰኖህዕኔ፤ ህከን ቤቾን ቅጥአዕዬ» ዬሰ። <verse eid="LUK 22:12"/><verse number="13" style="v" sid="LUK 22:13"/>እሰን መርት ጉዕሙርቹንኩ ኢስ ጠወዕዮሰገን እካን ህከን ቤቾን ሻሽግ ሁርባት ቅጥአቶኡ።<verse eid="LUK 22:13"/></para>
  <para style="s1">ጠሊለ ቁርባን ሴረ</para>
  <para style="r">(<ref loc="MAT 26:26-30">ማቶ. 26፥26-30</ref>፤ <ref loc="MRK 14:22-26">ማር. 14፥22-26</ref>፤ <ref loc="1CO 11:23-25">1 ቆሮ. 11፥23-25</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14"/>ሁርባት ወክቱ እሌሃን ኢስ አሳባንን ሜጡበ ማዳን አፉዕሌእ። <verse eid="LUK 22:14"/><verse number="15" style="v" sid="LUK 22:15"/>እስን እሳሃ «ኦርጨቀማምሀኒች ሄጭ ከ ሻሽግ ሁርባት ክዕኔኤን ሜጡበ እቶተ አበ ሄዕላቾም እቅ። <verse eid="LUK 22:15"/><verse number="16" style="v" sid="LUK 22:16"/>መሰንትስ መገን ዎምነቴን ሻሽግ ሁርባት ለልዮበእ ምስጥሩ ለሎተ ኢለ አን ከ ሻሽግ ሁርባት ሆሮን እታምበእገ ኩላንክዕኔ» ዬሰ።<verse eid="LUK 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 22:17"/>ህትን ኢስ ኩባያ ኬሽ መገኑ ገለትጭ «ከን ጠበቴን ዮኢሀ ኣእቴን ቤቀሜ። <verse eid="LUK 22:17"/><verse number="18" style="v" sid="LUK 22:18"/>አን ከን ወክቲች ኬሽ መገን ዎምነቱ አሜቶተ ኢለ ወይን ላልቺች ጩንሼማሃ ሆሮን አጋምበእገ ኩላንክዕኔ» ዬሰ።<verse eid="LUK 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19"/>ህከኒች ኤተሮን ኢስ ዳቡተ ኬሽ መገኑ ገለትጬእ፤ ህካንን ቢጭ እሳንከ ኣስ «ኩን ክዕኔሃ ኣሰሞሃ ማላእ፤ ካን ኤሳሃ ቃጎኖተ አዕዬ» ዬእ። <verse eid="LUK 22:19"/><verse number="20" style="v" sid="LUK 22:20"/>ህትን ሁርባቲች ኤተሮን ጠበቴሃ ኬሽ አሌ ዋሽ «ኩ ጠበቴሁ ክዕኔኤሃ ዱንተአኖ ቄጊንከኤ እሀኖ ሃዕሮሃ ወኣድ።<verse eid="LUK 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 22:21"/>«ጠዉ እኮጎሬ ከለዕዬ፤ ኤሳሃ ህግሽ ኣሰኖኤሀን አንገስ ኢን ሜጡበ ማዳን ዮኡ።<note caller="-" style="x"><char style="xo" closed="false">22፥21 </char><char style="xt" closed="false"><ref loc="PSA 41:9">መዝ. 41፥9</ref>።</char></note> <verse eid="LUK 22:21"/><verse number="22" style="v" sid="LUK 22:22"/>መንች ቤቱ እስተኔሃ ሄጭ ቀደሮስገን ሬሀኖ፤ እኮጎሬ ህግሽ ኣሰኖ መንቺሃ ቆሀኖስ!» ዬእ።<verse eid="LUK 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 22:23"/>ህካን ገገዉንኩሰን «ካን አአኖሁ ኒ በላን አዬት?» ይተን መት-መቱሰ ጠዕሙ ጀመርቶኡ።<verse eid="LUK 22:23"/></para>
  <para style="s1">ጉዕሚችን በተአኖሁ አዬት?</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24"/>ህትን አሳበስ «ኒ በላን ጉዕሚችኔን ሎሩ አዬት?» ይተን ኦደተ ጀመርቶኡ።<note caller="-" style="x"><char style="xo" closed="false">22፥24 </char><char style="xt" closed="false"><ref loc="MAT 18:1">ማቶ. 18፥1</ref>፤ <ref loc="MRK 9:34">ማር. 9፥34</ref>፤ <ref loc="LUK 9:46">ሉቃ. 9፥46</ref>።</char></note> <verse eid="LUK 22:24"/><verse number="25" style="v" sid="LUK 22:25"/>ህካን እኮቤቺሃ ኢስ እሰተ «ኡመት ዎመት መነሰ ገዘኣአ፤ ህከ ገዘኣ ዎመንተ ‹ጡመ ጠወ አቶኡ› ዬን ገኤኖሰ።<note caller="-" style="x"><char style="xo" closed="false">22፥25-26 </char><char style="xt" closed="false"><ref loc="MAT 25:27">ማቶ. 25፥27</ref>፤ <ref loc="MRK 10:42-44">ማር. 10፥42-44</ref>።</char></note> <verse eid="LUK 22:25"/><verse number="26" style="v" sid="LUK 22:26"/>እኮጎሬ አዕኑ ህት እኮኖቼ፤ ህከን ወጥ ክዕኔ በላን ሎረ እኮሁ ቀዉ እሁን፤ ህትን አዎንሳንቹ እኮሁ ካዲንቹ እሁን።<note caller="-" style="x"><char style="xo" closed="false">22፥26 </char><char style="xt" closed="false"><ref loc="MAT 23:11">ማቶ. 23፥11</ref>፤ <ref loc="MRK 9:35">ማር. 9፥35</ref>።</char></note> <verse eid="LUK 22:26"/><verse number="27" style="v" sid="LUK 22:27"/>ማዳን አፉዕል እተኖሀኒችለከ ኡር ካደመኖሀኒች በተአኖሁ አዬት? በተአኖሲሁ ማዳን አፉዕሌሃበእንዶ? ጠዉ እኮጎሬ አን በላንከክኔ ካዲንችጋት።<note caller="-" style="x"><char style="xo" closed="false">22፥27 </char><char style="xt" closed="false"><ref loc="JHN 13:12-15">ያህ. 13፥12-15</ref>።</char></note> <verse eid="LUK 22:27"/><verse number="28" style="v" sid="LUK 22:28"/>ህትን አዕኑ ኢን ሜጡበ ኦርሸኤ ወክት ጉዕመንከ ሄኤንታእራን። <verse eid="LUK 22:28"/><verse number="29" style="v" sid="LUK 22:29"/>ህካን እኮቤቺሃ አኑኤ ኤሳሃ ዳኛ አዕዮኤገን አኒሁ ክዕኔተ ዳኛኑተ አዕይ ሾማንክዕኔ። <verse eid="LUK 22:29"/><verse number="30" style="v" sid="LUK 22:30"/>ጄነቴንከኤ ኢ ማዲች እቶኖተለከ አጎኖተ ህትን ቶና ለሞንከ እስራኤል ደቦን ፈረዶኖተ ዎመ ቦርጭማን አፉዕልቴነንተ ዳኝነቱ ኣሳንክዕኔ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">22፥30 </char><char style="xt" closed="false"><ref loc="MAT 19:28">ማቶ. 19፥28</ref>።</char></note><verse eid="LUK 22:30"/></para>
  <para style="s1">ጴጥሮስ ለገአኖስገ ኢስ ሄጭ ጠወኡስ</para>
  <para style="r">(<ref loc="MAT 26:31-35">ማቶ. 26፥31-35</ref>፤ <ref loc="MRK 14:27-31">ማር. 14፥27-31</ref>፤ <ref loc="JHN 13:36-38">ያህ. 13፥36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31"/>ኢስን «ስሞኔ! ስሞኔ! ገበሬቹ አለሱ ጋቢች አደ አዕይ ጠለሸኖሀንገን ሼይጣኑ ክዕኔተ ጠለሾህዕኔተ ጠረኝሽ ሀሾ። <verse eid="LUK 22:31"/><verse number="32" style="v" sid="LUK 22:32"/>እኮጎሬ አን አመዕነቱክ በእበገ ኬሳሃ ዱአ አኣም፤ ህካን እኮቤቺሃ አት ቶበት ፈንቀልቶንት ወክት አመክ ኦሱተ ጠረኝስ» ዬእ።<verse eid="LUK 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33"/>እስን ኢሰ «ቀርቾ! ኪን ሜጡበ ኡሱረሞተለከ ሬሆተ ተቃጠቦም» ዬእ።<verse eid="LUK 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34"/>ኢስን «ጴጥሮሴ! አን ያንኬ፤ ከበር ሀንጠቦ ዎዶተ ኢለ ‹ደጋንስበአ› ይት ሰሶረ ለገኣንቴኤ» ዬእ።<verse eid="LUK 22:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35"/>ህከኒች ኤተሮን ኢስ አሳበስ «ከረጢትት፥ ሆቆማዱለከ ጫዕመት ሄኡዕነ ሶኮንክዕኔ ወክት ሆፈዮዕኔሩ ሄዕዮእቅንዶ?» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">22፥35 </char><char style="xt" closed="false"><ref loc="MAT 10:9-10">ማቶ. 10፥9-10</ref>፤ <ref loc="MRK 6:8-9">ማር. 6፥8-9</ref>፤ <ref loc="LUK 9:3">ሉቃ. 9፥3</ref>፤ <ref loc="LUK 10:4">10፥4</ref>።</char></note></para>
  <para style="p" vid="LUK 22:35">እሰን «መቱርቹሁ ሆፈዕዮኔበአ» ይቶኡ። <verse eid="LUK 22:35"/><verse number="36" style="v" sid="LUK 22:36"/>እስን «ቴሱ ከረጢትትለከ ሆቆማዱ ዮሲሁ አፉን፤ ህትን ብሱ ዮስበኢሁ ኦድኑስ ህር መቱ ብሰ ህዕሩን። <verse eid="LUK 22:36"/><verse number="37" style="v" sid="LUK 22:37"/>ህካን እኮቤቺሃ ‹ሂለ መኒን ወለአሞ› የመም ከተበሞሁ ኢ አሌን ዊሙ ሀስሰኖ እሁስ ኩላንክዕኔ፤ መሰንትስ ኢተኔ ከተበሞ ጠዉ ጉዕሙንኩ ዊመኖቤቺሃት» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">22፥37 </char><char style="xt" closed="false"><ref loc="ISA 53:12">ኢሳ. 53፥12</ref>።</char></note><verse eid="LUK 22:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38"/>ህትን አሳበስ «ቀርቾ! ከለእ፤ ለሙ ብሱ ከበ ዮኡ» ይቶኡ፤</para>
  <para style="p" vid="LUK 22:38">እስን «እሀኖ» ዬእ።<verse eid="LUK 22:38"/></para>
  <para style="s1">ኢስ ዘይት ሀቁ ነጰኖ ቆታን ዱአ አኡስ</para>
  <para style="r">(<ref loc="MAT 26:36-46">ማቶ. 26፥36-46</ref>፤ <ref loc="MRK 14:32-42">ማር. 14፥32-42</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39"/>ኢስ ከተሚች ፉል ወዕና ሮሾገን ዘይት ሀቁ ነጰኖ ቆተተ ኦሮዕዮ፤ ህትን አሳበስ እሱ አዎንቶኡ። <verse eid="LUK 22:39"/><verse number="40" style="v" sid="LUK 22:40"/>እስን ቤቹስ ኢሌ ወክት እሳንከ «ፌተናን ኣጌንበገ ዱአ አዕዬ» ዬሰ።<verse eid="LUK 22:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 22:41"/>ህከኒች ኤተሮን ክኑ ቶሬን እልሴኖ ቤች ጌሰ እሳች ቄዕር ጉሉጵ <verse eid="LUK 22:41"/><verse number="42" style="v" sid="LUK 22:42"/>«ኢ አነ! አት ሀሶንት ጎሬ ከ ኦርሸ ጠበቴሃ ኢች ቄርስ፤ ጠዉ እኮጎሬ አን ሀሳምገ እሁዕነ አት ሀሳንትገ እሁን» ይ ዱአ አዕዮ። <verse eid="LUK 22:42"/><verse number="43" style="v" sid="LUK 22:43"/>ኢስን ኣዜስ አበ ሻዥ ጠረኝ ዱአ አዕዮ፤ <verse eid="LUK 22:43"/><verse number="44" style="v" sid="LUK 22:44"/>ሁንኩ ቄግገ ኡላን ዛዘኖት እቅ፤ ህከ ወክት መገን መላይኬቹ ሰሜች አሜች እሱ ጠረኝሰን ህከን ቤቾን እስሃ ለሌስ።<verse eid="LUK 22:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45"/>ህትን ዱአ አአኖቤቺች ኬዕይ አሳበስበ አሜቾ ወክት አበ ሻዞቤቺሃ ግሳን ደጎሰ። <verse eid="LUK 22:45"/><verse number="46" style="v" sid="LUK 22:46"/>እስን እሰንተ «ሚሃት ግሴነንታሁ? ፌተናን ኣጌነንተበእገ ኬኤን ዱአ አዕዬ» ዬሰ።<verse eid="LUK 22:46"/></para>
  <para style="s1">ኢስ አፈሙስ</para>
  <para style="r">(<ref loc="MAT 26:47-56">ማቶ. 26፥47-56</ref>፤ <ref loc="MRK 14:43-50">ማር. 14፥43-50</ref>፤ <ref loc="JHN 18:3-11">ያህ. 18፥3-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47"/>ኢስ ጠወአን ሄዕዮገን ቶና ለሞንከ አሳባች መቱስ «ይሁደ» ዬኖሁ አዎንሴሃን ልግቡ መኑ ህከ ቤቹ አሜቶኡ፤ ይሁድን ሱንቆተ ኢስቤቹ ሆንጠኮ። <verse eid="LUK 22:47"/><verse number="48" style="v" sid="LUK 22:48"/>ጠዉ እኮጎሬ ኢስ «ይሁደ! መንች ቤቱ ሱንቅት ህግስ ኣተንንዶ?» ዬስ።<verse eid="LUK 22:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49"/>እስ አሳበት እሀኖ ጠወ ለኦ ወክት «ቀርቾ! ብሲን ዎቀርኑንሰንዶ?» ይቶኡ። <verse eid="LUK 22:49"/><verse number="50" style="v" sid="LUK 22:50"/>ህትን እሳችን መቱስ ቂስ አዎንሳንች ካዲንቹ ዎቀር መኬ አድ መጨተ ሙሮ።<verse eid="LUK 22:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51"/>ጠዉ እኮጎሬ ኢስ «ካን አቶት!» ይ መንችስ መጨተ አፍ ፈይሾስ። <verse eid="LUK 22:51"/><verse number="52" style="v" sid="LUK 22:52"/>ህከኒች ኤተሮን ኢስ ህከ አፎስተ አሜቶ ቂስ አዎንሳኑተ፥ ዱእ ምኒ አገርታ ገሻኑተለከ ባድ ባልቀተ «ቆጥ ሽፍጠ አፌኖሀንገ ብሰለከ በርተ አፌን አሜቴንንዶ? <verse eid="LUK 22:52"/><verse number="53" style="v" sid="LUK 22:53"/>አን መገን ምኔን ጉዕመ በርንከ ክዕኔን ሜጡበ ሄዕዮም ወክት አፌንታኤበአ እቅ፤ ጠዉ እኮጎሬ ኩ ወክቱ ክዕኔሃለከ ቱንስች ሹምነቱ ዮስሀንሃን» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">22፥53 </char><char style="xt" closed="false"><ref loc="LUK 19:47">ሉቃ. 19፥47</ref>፤ <ref loc="LUK 21:37">21፥37</ref>።</char></note><verse eid="LUK 22:53"/></para>
  <para style="s1">ጴጥሮስ ኢሰ ለገኡስ</para>
  <para style="r">(<ref loc="MAT 26:57-58">ማቶ. 26፥57-58</ref>፤ 69-75፤ <ref loc="MRK 14:53-54">ማር. 14፥53-54</ref>፤ 66-72፤ <ref loc="JHN 18:12-18">ያህ. 18፥12-18</ref>፤ 25-27)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54"/>ህከኒች ኤተሮን ሁኩ መኑ ኢሰ አፍ ቂስ አዎንሳኖ ምኒ አዎንስት ኤቦኡ፤ ጴጥሮስን ቄዕራሻን ሃመን አዎነኖት እቅ። <verse eid="LUK 22:54"/><verse number="55" style="v" sid="LUK 22:55"/>ህትን እሰን ግቤ በላን ጊረተ ቡስተን ሜጡበ አፉዕልቶ ወክት ጴጥሮስ አሜች በለሰ አፉዕሌእ። <verse eid="LUK 22:55"/><verse number="56" style="v" sid="LUK 22:56"/>እስን ለለኖ አዲን አፉልዮሀኒን መት ገረድቹት ቱክ ይት ለእ «ኩ መንቹ ኢሲን ሜጡበ ሄዕዮ እቅ» ይቶኡ። <verse eid="LUK 22:56"/><verse number="57" style="v" sid="LUK 22:57"/>ጠው እኮጎሬ ጴጥሮስ «ቴ መንቾ! አን እሱ ደጋምበአ» ይ ለገዕዮ። <verse eid="LUK 22:57"/><verse number="58" style="v" sid="LUK 22:58"/>ህትን ቀዉ ጌሰ አገር ዎሉ መንቹ እሱ ለዕይ «አት እሳች መቶሃስ» ዬእ፤ ጠው እኮጎሬ ጴጥሮስ «ኮ መንቾ አኔበአ!» ዬእ።<verse eid="LUK 22:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59"/>ህትን መቶ ሳኣት ጌሰ አገሮች ኤተሮን ዎሉ መንቹ «ኩ መንቹ ገሊል ባድ መንቹ እኮቤቺሃ ሀንቅንከ እሲን ሜጡበ ሄዕዮ እቅ» ይ ጠራኝሽ ጠወዕዮ። <verse eid="LUK 22:59"/><verse number="60" style="v" sid="LUK 22:60"/>ጠው እኮጎሬ ጴጥሮስ «ኮ መንቾ አት ይታንቲሃ አን ደጋንስበአ» ዬእ፤ ህከ ወክት እስ ጠወአንን ሀንጠቦ ዎጆ። <verse eid="LUK 22:60"/><verse number="61" style="v" sid="LUK 22:61"/>ኢስን ኤተሩ ፈንቀል ጴጥሮሴ ለዕዮ፤ ጴጥሮስን «ከበር ሀንጠቦ ዎዶተ ኢለ ሰሶራ ለገኣንቴኤ» ዬስ ቀርች ላገተ ሰውዬእ። <verse eid="LUK 22:61"/><verse number="62" style="v" sid="LUK 22:62"/>ህካን እኮቤቺሃ አብል ፉል ቡብ ኦዕዮ።<verse eid="LUK 22:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63"/>ህከ ወክት ኢሰ አፎ መኑ ህንቃሲትለከ ዎቀርታሲት እቅ። <verse eid="LUK 22:63"/><verse number="64" style="v" sid="LUK 22:64"/>ህትን እልስ ጉንጉሽት ዎቀርተን «ዎቀሮሄሁ አዬት? ህንዴ ደግ» ይተን ጠዕምታሲት እቅ። <verse eid="LUK 22:64"/><verse number="65" style="v" sid="LUK 22:65"/>እሰን ዎሉ ልግብ ጠወ ጠወአን ቦሮርታሲት እቅ።<verse eid="LUK 22:65"/></para>
  <para style="s1">ኢሰ ፍርድ ባልቀቤቹ መሴመስገ</para>
  <para style="r">(<ref loc="MAT 26:59-66">ማቶ. 26፥59-66</ref>፤ <ref loc="MRK 14:55-64">ማር. 14፥55-64</ref>፤ <ref loc="JHN 18:19-24">ያህ. 18፥19-24</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66"/>ኡለት ሶዞ ወክት ባድ ባልቁ፥ ቂስ አዎንሳኑትለከ ሕግ አስተማረት ጭምይት ኢሰ ኦገትሰቤቹ መስቶኡ። <verse eid="LUK 22:66"/><verse number="67" style="v" sid="LUK 22:67"/>እሰን «አት መሲህ እኮንትጎሬ ኩልኔ» ይቶኡ፤ ጠው እኮጎሬ እስ «ኩሎንክዕኔ ጎሬ አመዕንቴነንተኤበአ። <verse eid="LUK 22:67"/><verse number="68" style="v" sid="LUK 22:68"/>ህትን አን ጠዕሜንክዕኔ ጎሬ ፈንቀሽቴነንተበአ። <verse eid="LUK 22:68"/><verse number="69" style="v" sid="LUK 22:69"/>ጠው እኮጎሬ ቴሶች ጀመር መንች ቤቱ ዎልቀት ዮሲ መገን መኬ አዲን አፉዕለኖ» ዬሰ። <verse eid="LUK 22:69"/><verse number="70" style="v" sid="LUK 22:70"/>እሰን ጉዕሙንከሰ «ህካን እኮች አት መገንየ ቤቱንዶ?» ይቶኡ፤ እስን «ኤ አዕኑ ይቴንተጋንት» ዬሰ። <verse eid="LUK 22:70"/><verse number="71" style="v" sid="LUK 22:71"/>ህካን እኮቤቺሃ እሰን «ነኡ ገዉንኩኔ ገይስ አፌች ሞጮጭኖምቤቺሃ ዎሉ ምስክር ሚሃት ሀንሳሚሁ» ይቶኡ።<verse eid="LUK 22:71"/></para>
  <chapter eid="LUK 22"/>
  <chapter number="23" style="c" sid="LUK 23"/>
  <para style="s1">ኢሰ ጵላጦሴቤቹ መሴመስገ</para>
  <para style="r">(ማቶ. 27፥1-2፤11-14፤ <ref loc="MRK 15:1-5">ማር. 15፥1-5</ref>፤ <ref loc="JHN 18:28-38">ያህ. 18፥28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1"/>ህከኒች ኤተሮን ሁኩ ኦገቾ መኑ ጉዕሙንኩ ሜጡበ እክ ኢሰ ጵለጦሴቤቹ ኤቦኡ። <verse eid="LUK 23:1"/><verse number="2" style="v" sid="LUK 23:2"/>እሰን «ኩ መንቹ መነኔ ሉሲሰን፥ ሮም ዎሚሃ ግብር ባታበእገ ከመንለከ ‹አን ዎመ መሲህት› የን ደንጎንስ» ይተን ኦደሙ ጀመርቶስ።<verse eid="LUK 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3"/>ጵላጦስን «አት ይሁድሃ ዎመንዶ?» ይ ጠዕሜስ፤ ኢስን «አት ይቶንትጋንት» ይ ፈንቀሼእ።<verse eid="LUK 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4"/>ህከኒች ኤተሮን ጵላጦስ ቂስ አዎንሳኖተለከ ህከን ልግቤ መኒሃ «ከን መንቾን መቱ ቤሱሃ ደጎምበአ» ዬእ።<verse eid="LUK 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 23:5"/>ጠው እኮጎሬ እሰን «ገሊላች ኬሽ ከኣጰ ኢለ ይሁድ ባዶን ጉዕማንን ተማርሰን ጨንጨነተ ኬሰኖት» ይተን ጠረኝስ ጠወኦኡ።<verse eid="LUK 23:5"/></para>
  <para style="s1">ጵላጦስ ኢሰ ሄሮድሴቤቹ ሶኮገ</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6"/>ጵላጦስን «ገሊለተ» ይተን ሞጮጬ ወክት «ገሊለ ባድሃ መንቹንዶ?» ይ ጠዕሜእ። <verse eid="LUK 23:6"/><verse number="7" style="v" sid="LUK 23:7"/>እስን ኢስ ሄሮድስ ገሸኖ ባዲሃ እሁስ ደጎ ወክት ኢሰ ሄሮድሴቤቹ ሶኮ፤ ሄሮድስ ህከ ወክት ዬሩሳሌማን ሄዕዮ እቅ። <verse eid="LUK 23:7"/><verse number="8" style="v" sid="LUK 23:8"/>ሄሮድስን ኢሰ ለዕዮ ወክት አበ ሙንደዕዮ፤ መሰንትስ እስተኔ ልግብ ጠወ ሞጮጭ ለኦስተ ልግብ ወክት ሄዕላተኖት እቅ፤ ህትን አጀብሲሰኖ ጠወ አአን ለኦተ ተብሳሃ አአኖት እቅ። <verse eid="LUK 23:8"/><verse number="9" style="v" sid="LUK 23:9"/>ህካን እኮቤቺሃ ሄሮድስ ኢሰ ልግብ ጠወ ጠዕሜስ፤ እኮጎሬ ኢስ መቱርቹሃ ፈንቀሽዮበአ። <verse eid="LUK 23:9"/><verse number="10" style="v" sid="LUK 23:10"/>ህትን ቂስ አዎንሳኑትለከ ሕግ አስተማረት ህከኔ ኡርት ጠረኝስ ኦዳሲት እቅ። <verse eid="LUK 23:10"/><verse number="11" style="v" sid="LUK 23:11"/>ህትን ሄሮድስ ወታደሪንከስን ሜጡበ ህንቆስ፤ ህከኒች ኤተሮን ቀለደን በለቃ ኦድኑተ ኦዲሽ ጵላጦሴቤቹ ፈንቀሽ ሶኮ። <verse eid="LUK 23:11"/><verse number="12" style="v" sid="LUK 23:12"/>ህከ በር ጵላጦስለከ ሄሮድስ ጃለተ እኮኡ፤ ህከኒች ብርተ ለሙንኩሰ ብታን ሄኦ እቅ።<verse eid="LUK 23:12"/></para>
  <para style="s1">ኢስ አሌን ሬሆ ፍርደ ፈረዴመገ</para>
  <para style="r">(<ref loc="MAT 27:15-26">ማቶ. 27፥15-26</ref>፤ <ref loc="MRK 15:6-15">ማር. 15፥6-15</ref>፤ <ref loc="JHN 18:39-40">ያህ. 18፥39-40</ref>፤ <ref loc="JHN 19:1-16">19፥1-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13"/>ህከኒች ኤተሮን ጵላጦስ ቂስ አዎንሳኑተ፥ ደኛኑተለከ ኡመት ሜጡበ ገኤእ <verse eid="LUK 23:13"/><verse number="14" style="v" sid="LUK 23:14"/>« ‹ኦመት አሌን ብተተ ኬሰኖ› ይቴን ከ መንቹ ኢቤቹ ኤቤንታአ፤ አንን ህትን አዕኑ ለኤነን መረመርስ ሆንጠህሴንተ ክሲች ጉዕሚችን ከን መንች አሌን መቱ ቤሱሃ ደጎምበአ። <verse eid="LUK 23:14"/><verse number="15" style="v" sid="LUK 23:15"/>ህትን ሄሮድስ መቱ ብድልሃ ደጉ ሆጎቤቺሃ ኒቤቹ ፈንቀሽ ሶኮስ፤ ከለዕዬ ሬሆተ ኢልሰኖስ መቱርቹሃ አዕዮበአ። <verse eid="LUK 23:15"/><verse number="16" style="v" sid="LUK 23:16"/>ህካን እኮቤቺሃ አን እሱ ገረፍ ገፈራም» ዬሰ። <verse eid="LUK 23:16"/><verse number="17" style="v" sid="LUK 23:17"/>[ዘማን ዘማኔን ጵላጦስ ኡሱረኚች መቱ መንቹ ሂር ገፈሩ ግዳስ እቅ።]<note caller="+" style="f"><char style="ft" closed="false">መት-መቱ ሉህ ክታበት ዎሊንሽ 17 ዮኢሃ በርግታበአ፤ ላገስ ማር. 15፥6 ዮኢሃ አጉደኖ።</char></note> <verse eid="LUK 23:17"/><verse number="18" style="v" sid="LUK 23:18"/>ጠዉ እኮጎሬ እሰ ጉዕሙንኩሰ ሜጡበ እክ «ከ መንቹ ሽ! ባርባኔ ሂር!» ይተን ጨንጭቶኡ። <verse eid="LUK 23:18"/><verse number="19" style="v" sid="LUK 23:19"/>ባርባን ከተም ኣዜን ጨንጨነተ ኬሰንለከ መነ ሸን ኡሱር ምኔን ኡሱረሞእሃ መንቹ እቅ።<verse eid="LUK 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20"/>ጵላጦስን ኢሰ ሂር ገፈሮስተ ሀሽ ለንኪሃ መኒሃ ጠወዕዮ። <verse eid="LUK 23:20"/><verse number="21" style="v" sid="LUK 23:21"/>ጠዉ እኮጎሬ እሰን «እሱ ሰቀል! እሱ ሰቀል!» ይተን ጨንጭቶኡ።<verse eid="LUK 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22"/>ሰቅ ወክት ጵላጦስ «ኩ መንቹ ሆሮን አዕዮ ጠዉ መርቹሃን? አን ሬሆተ ኢልሰኖስርቹ ደጎምበአ፤ ህካን እኮቤቺሃ ገረፍ ገፈራንስ» ዬሰ።<verse eid="LUK 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23"/>ጠዉ እኮጎሬ እሰ ላገሰ ጎት አት ሰቀል! ይተን ያርቶኡ፤ ኡመቲሁለከ ቂሰ አዎንሳኖ ላገንት በተኦኡ። <verse eid="LUK 23:23"/><verse number="24" style="v" sid="LUK 23:24"/>ህከን መሳን ጠዕምቶ ጠዉ እሆሰተ ጵላጦስ ፈረጆ። <verse eid="LUK 23:24"/><verse number="25" style="v" sid="LUK 23:25"/>እስን እሰ ጠዕምቶገን ህከ ርብሸተ አስለከ መነ ሺ ኡሱር ምኔን ኡሱረሞ መንቹ ሂር ገፈሮ፤ ጠዉ እኮጎሬ ኢሰ ተሽ የኖሰገ አቶተ ህግሽ ኣሴሰ።<verse eid="LUK 23:25"/></para>
  <para style="s1">ኢሰ ሰቀሌመገ</para>
  <para style="r">(<ref loc="MAT 27:32-44">ማቶ. 27፥32-44</ref>፤ <ref loc="MRK 15:21-32">ማር. 15፥21-32</ref>፤ <ref loc="JHN 19:17-27">ያህ. 19፥17-27</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26"/>ህከኒች ኤተሮን እሰን ኢሰ መስተን ሄኦገን ገጠሪች ከተመ አሜተኖት እቅ፤ «ስሞኔ» ዬኖ ቀሬን ባድ መንቹ አንገስ አፍ መስቀለ እጅሲስ ኢሰ አዎነኖገ አቶኡ።<verse eid="LUK 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 23:27"/>ልግቡ ኡመቱ «ኣዬ! ኣዬ!» ይተን እሰ በላንን ወዘነሰ ዎቀርተን ኦኣ ሜንቱ ኢሰ አዎንታሲት እቅ። <verse eid="LUK 23:27"/><verse number="28" style="v" sid="LUK 23:28"/>ጠዉ እኮጎሬ ኢስ እሰ አደ ፈንቀል «ዬሩሳሌም ሜንቶ! ኤሳሃ ኦኦኖቼ፤ እኮጎሬ ክዕኔሃ ገይሀክዕኔለከ እላተክዕኔ ኦዕዬ። <verse eid="LUK 23:28"/><verse number="29" style="v" sid="LUK 23:29"/>መሰንትስ ‹እልትበሩ፥ እልበ ጎደቡለከ ቀንስበ ኡኑኑ ማሰአሞእሃ› ዬኖ ወክቱ አሜተኖት። <verse eid="LUK 23:29"/><verse number="30" style="v" sid="LUK 23:30"/>ህከ ወክት መኑ ቆተተ ‹አሌኔ ኡቤ!› ህትን ቆሩንተ ‹ማጬኔ› የኖ።<note caller="-" style="x"><char style="xo" closed="false">23፥30 </char><char style="xt" closed="false"><ref loc="HOS 10:8">ሆሴ. 10፥8</ref>፤ <ref loc="REV 6:16">መና. 6፥16</ref>።</char></note> <verse eid="LUK 23:30"/><verse number="31" style="v" sid="LUK 23:31"/>እሰን ሙጠ ሀቅ አሌን ህካን አኤማሃ እኮች ሞሎ ሀቅ አሌን መ አኤኖሃ እሆታት?» ዬእ። <verse eid="LUK 23:31"/><verse number="32" style="v" sid="LUK 23:32"/>ህትን ጩብ አቶ ዎሉ ለም መናከተ ኢሲን ሜጡበ ሽቶተ መስቶኡ። <verse eid="LUK 23:32"/><verse number="33" style="v" sid="LUK 23:33"/>እሰን «ቡዕል ቁላ» ዬኖቤቹ ኢልቶ ወክት ህከን ቤቾን ኢሰ ሰቀልቶኡ፤ ህትን ጩብ አዕዮሃ መቱስ መኬ አዲን ዎሉስ ጉረስ አዲን ሰቀልቶኡ። <verse eid="LUK 23:33"/><verse number="34" style="v" sid="LUK 23:34"/>ኢስን «ኢ አነ! እሰ አታርቹ ደጋበእቤቺሃ መረርሲጭሰ» ዬእ፤ እሰን ኦድኑስ እጠ ኡጅት ቤቀንቶኡ።<note caller="-" style="x"><char style="xo" closed="false">23፥34 </char><char style="xt" closed="false"><ref loc="PSA 22:18">መዝ. 22፥18</ref>።</char></note> <verse eid="LUK 23:34"/><verse number="35" style="v" sid="LUK 23:35"/>ህትን ኡመቱ ኡር ለአኖት እቅ፤ ጠዉ እኮጎሬ ዳኛኑት «ዎሉ መነ ፌሾኡ፤ መጠረሞ መገን መሲህ እኮጎሬ ህንዴ ገዉስ ፌሱን!» ይተን ቀለዳሲት እቅ።<note caller="-" style="x"><char style="xo" closed="false">23፥35 </char><char style="xt" closed="false"><ref loc="PSA 22:7">መዝ. 22፥7</ref>።</char></note><verse eid="LUK 23:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 23:36"/>ህትን ዎታደሩ እስቤቹ ሆንጠክ ሆለጮ ዎይነ ቦበጤማሃ ኣትስ<note caller="-" style="x"><char style="xo" closed="false">23፥36 </char><char style="xt" closed="false"><ref loc="PSA 69:21">መዝ. 69፥21</ref>።</char></note> <verse eid="LUK 23:36"/><verse number="37" style="v" sid="LUK 23:37"/>«አት አይሁድ ዎመ እኮንትጎሬ ገዉክ ፌስ!» ይተን ቀለዳሲት እቅ።<verse eid="LUK 23:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38"/>ህትን «ኩን አይሁድያ ዎመ» ዬን ከተቤማሁ ቡዕልስ አሌ አዲን ሄዕዮ እቅ። <verse eid="LUK 23:38"/><verse number="39" style="v" sid="LUK 23:39"/>ሂለርቹ አታን ሰቀሌመሀኑኡች መቱስ «አት መሲህ በእንዶ? ህንዴ ገዉክለከ ኔሳሃ ፌስ» የን ቦሮሮስ።<verse eid="LUK 23:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40"/>ጠዉ እኮጎሬ ዎሉስ «አቲሁ መቴ ሬሆ ፍርድ ኣዜን ሄኦንትገን መገኑ ዋጅታንትበእንዶ? <verse eid="LUK 23:40"/><verse number="41" style="v" sid="LUK 23:41"/>ነኡዕኑ ሆጎኔተኔሃ ሀስሰኖኔ ፍርደ ኣእናምቤቺሃ ኒሁ ሀንቅሃ ፍርደ፤ እኮጎሬ ኩ መንቹ መቱ ሂለርቹ አዕዮበአ» ይ ኡሙዕሬስ። <verse eid="LUK 23:41"/><verse number="42" style="v" sid="LUK 23:42"/>ህትን «ኢሰ! አሜትክ ወክት ኪ ዎምነቴን ቃጌኤ» ዬእ።<verse eid="LUK 23:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43"/>ኢስን «ሀንቅንከ ያንኬ፤ ከበር ኢን ሜጡበ ጄነቴን እካንት» ዬስ።<verse eid="LUK 23:43"/></para>
  <para style="s1">ኢስ ሬዮገ</para>
  <para style="r">(<ref loc="MAT 27:45-56">ማቶ. 27፥45-56</ref>፤ <ref loc="MRK 15:33-41">ማር. 15፥33-41</ref>፤ <ref loc="JHN 19:28-30">ያህ. 19፥28-30</ref>)</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44"/>ሌሆ ሰኣት ጌሰ እኮች አሩ ቱንስሻን ኡለ አሌን ጉዕማንን ሆንሱ ሰኣት ኢለ ቱንስቹ እኮ፤ <verse eid="LUK 23:44"/><verse number="45" style="v" sid="LUK 23:45"/>ህከ ወክት ዱእ ምኒ መጋረጁ ቅጡ ለሙ ቤቹ እክ ፊልተዕዩ።<note caller="-" style="x"><char style="xo" closed="false">23፥45 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">ፉል. 26፥31-33</ref>።</char></note> <verse eid="LUK 23:45"/><verse number="46" style="v" sid="LUK 23:46"/>ኢስ ሎረ ላጋን ያር «ኢ አነ! ነብሴቹኤ አንጋተክ ኤገተ ኣሳም!» ዬእ፤ ህካን ዬች ኤተሮን ሬዮ።<note caller="-" style="x"><char style="xo" closed="false">23፥46 </char><char style="xt" closed="false"><ref loc="PSA 31:5">መዝ. 31፥5</ref>።</char></note><verse eid="LUK 23:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47"/>ጥቤ ሀለቅቹ ህከ እኮ ጠወ ለዕዮ ወክት «ሀንቅንከ ኩ መንቹ ፈየሃ እቅ» ይ መገኑ ሎርሴእ።<verse eid="LUK 23:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 23:48"/>ህካን ለኦተ ጭምይቶ መኑ ጉዕሙንኩ እኮ ጠወ ለኦ ወክት ሻዝ ዎዘነሰ ዎቀርተን ምነሰ ፈንቀልቶኡ። <verse eid="LUK 23:48"/><verse number="49" style="v" sid="LUK 23:49"/>ጠዉ እኮጎሬ ኢስን ኤንኬዕነንተ መኑ ጉዕሙንኩ፥ ገሊላች እሱ አዎንታሲት እቅ፤ ሜንቱሁ ቄዕራሻን ኡርት ህከ ጠወ ለኣኢት እቅ።<note caller="-" style="x"><char style="xo" closed="false">23፥49 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">ሉቃ. 8፥2-3</ref>።</char></note><verse eid="LUK 23:49"/></para>
  <para style="s1">ኢስ ሞገሙስ</para>
  <para style="r">(<ref loc="MAT 27:57-61">ማቶ. 27፥57-61</ref>፤ <ref loc="MRK 15:42-47">ማር. 15፥42-47</ref>፤ ያህ. 19፤38-42)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50"/>«አርማትየ» ዬኖ አይሁድ ከተማን ሄአኖ «ዩሱፈ» ዬኖ መንቹ ሄዕዮ እቅ፤ እስን ፈያለከ ጡመሃ መንቹ እቅ፤ ህትን እስን ኦገት ዳኛኖች መቶሃስ እቅ። <verse eid="LUK 23:50"/><verse number="51" style="v" sid="LUK 23:51"/>እኮጎሬ አማሌንከሰለከ ሆጎንከሰ ኢተቀሞበአ እቅ፤ ህትን መገን ዎምነቱ ተብሴን አገረኖሃ መንቹ እቅ። <verse eid="LUK 23:51"/><verse number="52" style="v" sid="LUK 23:52"/>ሁኩ መንቹንኩ ጵላጦሴቤቹ መርኬዕይ ኢስ ጀናዘተ ኣሶኖስተ ፍቃድ ጠዕሜእ። <verse eid="LUK 23:52"/><verse number="53" style="v" sid="LUK 23:53"/>ህከኒች ኤተሮን ጀናዘተ ጡመ ጥጥ ኦድኖን ከፈኞ፤ ህት አዕይ አዪሁ ሞገሞበእ ክኑ ሸሄን መክሴመ ሎዳን አፉሼእ። <verse eid="LUK 23:53"/><verse number="54" style="v" sid="LUK 23:54"/>ሁኩንን ፎሎጭ በሩ ኣጎተ ሆንጠካን ተቃጠቤኖ ጅዕማቴተ ሀዎሩ እቅ።<verse eid="LUK 23:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55"/>ገሊላች ኢሲን ሜጡበ አዎንተን አሜቶ ሜንቱ ሆንጠክ ሎደስለከ ጀናዘስ አፉሼመገ ለኦኡ። <verse eid="LUK 23:55"/><verse number="56" style="v" sid="LUK 23:56"/>እሰን ምነሰ ፈንቀልት አንጀኖርቹለከ ሽቱተ ቅጥአቶኡ፤ ሕግሰጊን ፎሎጭ በርንከ አዘዘሞገን ፎሎጭቶኡ።<note caller="-" style="x"><char style="xo" closed="false">23፥56 </char><char style="xt" closed="false"><ref loc="EXO 20:10">ፉል. 20፥10</ref>፤ <ref loc="DEU 5:14">ዘዳ. 5፥14</ref>።</char></note><verse eid="LUK 23:56"/></para>
  <chapter eid="LUK 23"/>
  <chapter number="24" style="c" sid="LUK 24"/>
  <para style="s1">ኢስ ሬሆች ኬኡስ</para>
  <para style="r">(<ref loc="MAT 28:1-10">ማቶ. 28፥1-10</ref>፤ <ref loc="MRK 16:1-8">ማር. 16፥1-8</ref>፤ <ref loc="JHN 20:1-10">ያህ. 20፥1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1"/>ሁኩ ሜንቱ ሳምንት ዎኔ በር ገስመ ሱጵተ ቅጥአቶ ሽቱተ አፍ ሎድቤቹ መርቶኡ። <verse eid="LUK 24:1"/><verse number="2" style="v" sid="LUK 24:2"/>እሰን ክኑ ሎድ አፌች ኮሎንኮዕልሃን ለኦኡ። <verse eid="LUK 24:2"/><verse number="3" style="v" sid="LUK 24:3"/>ጠዉ እኮጎሬ ሎድስ ኣዝ ኣጎ ወክት ቀርቾ ኢስ ጀናዘተ ደጎበአ። <verse eid="LUK 24:3"/><verse number="4" style="v" sid="LUK 24:4"/>እሰን ህከን ጠዋን አበ አጀብሲጭተን በለቃ ኦድኑተ ኦደኦ ለሙ መኑ ድንገቴን መዴንከሰ ኡርቶኡ። <verse eid="LUK 24:4"/><verse number="5" style="v" sid="LUK 24:5"/>ሜንቱንኩ አበ ዋጅት ሙግይት ለአን ለሙንኩ መንቹ «ፎሊን ዮኢሃ ሬቶሀኑኡ በላን ሚሃ ሀሴነንታት? <verse eid="LUK 24:5"/><verse number="6-7" style="v" sid="LUK 24:6-7"/>እስ ከበ ዮበአ፤ ኬዕዮኡ፤ ገሊለን ሄዕዮ ወክት ‹መንች ቤቱ ጩበኛኖ አንጋን ህግሴን ኣሱ፥ ሰቀለሙለከ ሰቅ በር ሬሆች ኬኡ ሀስሰኖስ› ይ ኩሎህዕኔገ ሰውይዬ» ይቶስ።<note caller="-" style="x"><char style="xo" closed="false">24፥6-7 </char><char style="xt" closed="false"><ref loc="MAT 10:33-34">ማቶ. 10፥33-34</ref>፤ <ref loc="LUK 9:22">ሉቃ. 9፥22</ref>፤ <ref loc="LUK 18:31-33">18፥31-33</ref>።</char></note><verse eid="LUK 24:6-7"/></para>
  <para style="p">
    <verse number="8-9" style="v" sid="LUK 24:8-9"/>ሜንቱንኩ ኢስ ጠወ ሰውይት ሎድቢች ፈንቀልት ህከ ጠወ ጉዕመንከ ቶና መቶሃንከ አሳባተለከ ፈቆሀኑኡተ ጉዕሚንከ ኩልቶኡ። <verse eid="LUK 24:8-9"/><verse number="10" style="v" sid="LUK 24:10"/>ህከ ጠወ አሳባተ ጠወኦእሩ መግደል ከተም መርየማት፥ ዮሃናት፥ ያቁብ አመት መርየማትለከ እሳንን ሜጡበ ሄኦ ዎሎሃ ሜንቱ እቅ። <verse eid="LUK 24:10"/><verse number="11" style="v" sid="LUK 24:11"/>ጠዉ እኮጎሬ ሜንቱ ጠወኦ ጠዉ ሀንቅ አጉጆሰበእቤቺሃ አሳበት አመዕንቶሰበአ። <verse eid="LUK 24:11"/><verse number="12" style="v" sid="LUK 24:12"/>ጴጥሮስ ኬዕይ ሎድቤቹ ደጉጆ፤ ህከን ቤቾን ሙግይ ከፈኔመ ጥጥ ኦድኑት ሄኦኢሃ ለዕይ ጠዋንከስ አጀብሲጨን ምኒ ፈንቀሎ።<verse eid="LUK 24:12"/></para>
  <para style="s1">ኢስ ለሞ አሳባተ ለሉስ</para>
  <para style="r">(<ref loc="MRK 16:12-13">ማር. 16፥12-13</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13"/>ህከ በርንከ ኢስ አሳባች ለሙ «ኤማሁሰ» ዬኖ ቀእተ መርታኢት እቅ፤ ሁኩቤቹንኩ ዬሩሳሌሚች ለሞ ሰኣት ጌሰ መሰኖሃ ዎቃ እቅ። <verse eid="LUK 24:13"/><verse number="14" style="v" sid="LUK 24:14"/>ህትን ገገዉንኩሰ ህከ እኮ ጉዕመንከ ጠውተኔሃ ሀሳውታኢት እቅ። <verse eid="LUK 24:14"/><verse number="15" style="v" sid="LUK 24:15"/>ጠራኝስ ሀሳውተንን ኢስ ገዉንኩስ ሆንጠክ እሳን ሜጡበ ሃመኖት እቅ። <verse eid="LUK 24:15"/><verse number="16" style="v" sid="LUK 24:16"/>ጠዉ እኮጎሬ እሱ ደግበገ እሌንከሰ ለአንን አጥራመቶበአ እቅ። <verse eid="LUK 24:16"/><verse number="17" style="v" sid="LUK 24:17"/>እስን «ሃንቴነን ገገዉክዕኔን ጠወኤነን ሄኤንተ ጠዉ መርቹሃን?» ዬሰ፤</para>
  <para style="p" vid="LUK 24:17">እሰን ሻዝ ጨለይት ኡርቶኡ። <verse eid="LUK 24:17"/><verse number="18" style="v" sid="LUK 24:18"/>ህከኒች ኤተሮን እሳችን መቱስ «ቀላዮጳ» ዬኖሁ «ከን ሳምንታን ህከኔ እኮ ጠወ ደግባሁ ዬሩሳሌም ከተማን ጠለዕል አት ኮህቹሃንዶ?» ይ ፈንቀሼስ።<verse eid="LUK 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19"/>ኢስን «መ ጠወ?» ዬሰ፤ እሰን «ሆጎንለከ ጠወኢን መንለከ መገን ብሬን ጠረኘ ነቢዬች ናዝሬት ኢስተኔሃት። <verse eid="LUK 24:19"/><verse number="20" style="v" sid="LUK 24:20"/>ቂስ አዎንሳኑትለከ ዳኛኑት ሬሆ ፍርዲሃ ህግስ ኣቶች ኤተሮን ሰቀልቶስ። <verse eid="LUK 24:20"/><verse number="21" style="v" sid="LUK 24:21"/>እኮጎሬ ነኡ ‹እስራኤለ ፌሰኖሁ እሶት› ይን ተቢሳሃ አዕኖም እቅ፤ ህትን ህከን ጉዕመንከ ጠው አሌንን ኩ ጠዉ እኮች ከበር ሰቅየ በር። <verse eid="LUK 24:21"/><verse number="22" style="v" sid="LUK 24:22"/>ዎሉንገ ህትን ኒ በሊች ሱጵተ ፉልት ሎድቤቹ መርቶ መት-መቱ ሜንቱ አጀብሲሶኔ። <verse eid="LUK 24:22"/><verse number="23" style="v" sid="LUK 24:23"/>ጠዉ እኮጎሬ እሰን ጀናዘስ ደጎተ አታልቶበአ፤ ህትን ‹እስ ፎሊን ዮኡ› ይታ መላይከተ ለዕኖም ይተን ፈንቀልት አሜቶኡ። <verse eid="LUK 24:23"/><verse number="24" style="v" sid="LUK 24:24"/>ህትን ኒን ሜጡበ ሄኦሀኑኡች መት-መቱ መኑ ሎድቤቹ መርት ሁኩ ሜንቱ ይቶገን እኮሃ ደጎኡ፤ እኮጎሬ እሱ ለኦስበአ» ይቶስ።<verse eid="LUK 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25"/>ኢስን «አዕኑ ኩ ገዋኑት፤ ነቢያኑት ጠወኦ ጠወ ጉዕመንከ ቀልቡክዕኔ ደዕል አመዕንዮበእሩ። <verse eid="LUK 24:25"/><verse number="26" style="v" sid="LUK 24:26"/>መሲሁ ከ ኦርሸተ ጉዕመንከ ቶጎተለከ ኬዕምኚን ኣጎተ ሀስሰኖስበእንዶ?» ዬሰ። <verse eid="LUK 24:26"/><verse number="27" style="v" sid="LUK 24:27"/>ህትን ሙሲችለከ ጉዕማንከ ነቢያኖች ኬሽ መጻፋን ጉዕማንን እስተኔሃ ከተበሞ ጉዕመንከ ቤቺች ቤቺች ኩሎሰ።<verse eid="LUK 24:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28"/>ህከኒች ኤተሮን እሰን መርታ ቀእተ ሆንጠካን እስ ቄዕራሻን ሃመኖሀንገ እኮ። <verse eid="LUK 24:28"/><verse number="29" style="v" sid="LUK 24:29"/>እሰን «ኡለት ሀዎርቶኡ፤ አሩ ኣጎተ እኮቤቺሃ ኒን ገል» ይት ጠራኝስ ኡጭቶስ፤ ህካን እኮቤቺሃ እሳንን ሜጡበ ገሎተ ኣጎ። <verse eid="LUK 24:29"/><verse number="30" style="v" sid="LUK 24:30"/>እስን እሳን ሜጡበ ማዳን አፉዕሌ ወክት ጦሮሹ ኣእ ዱአ አዕይ ቢጭ እሳሃ ኣሴእ። <verse eid="LUK 24:30"/><verse number="31" style="v" sid="LUK 24:31"/>ህከ ወክት እልሰ ፈንተኣን እሱ ደጎኡ፤ እስን ብሬችሰ ገበጭ ዬእ። <verse eid="LUK 24:31"/><verse number="32" style="v" sid="LUK 24:32"/>እሰን መት-መትሀሰ «ዎቃን ኒን ጠወአን መጻፈተ ሂር ኩሎኔ ወክት ቀልቡኔ ሙንዲኖን ተሽይበኔንዶ?» የቀንቶኡ።<verse eid="LUK 24:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 24:33"/>እሰን ህከ ሰኣትንከ ኬእ ዬሩሳሌመ ፈንቀልት አሜት ቶና መቱንኩ አሳበትለከ ዎሎ መኒን ጭምይት <verse eid="LUK 24:33"/><verse number="34" style="v" sid="LUK 24:34"/>«ቀርቹ ኢስ ሀንቅንከ ሬሆች ኬዕዮኡ፤ ስሞኔንከ ለልዮኡ» ይተን ደጎኡ።<verse eid="LUK 24:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 24:35"/>ለሙንኩ ህትን ዎቃን እኮ ጠውተኔሃ ጦሮሹ ቢጮ ወክት እሱ አጥራመቶስገ ኩልቶሰ።<verse eid="LUK 24:35"/></para>
  <para style="s1">ኢስ አሳባተስ ለሉስ</para>
  <para style="r">(<ref loc="MAT 28:16-20">ማቶ. 28፥16-20</ref>፤ <ref loc="MRK 16:14-18">ማር. 16፥14-18</ref>፤ <ref loc="JHN 20:19-23">ያህ. 20፥19-23</ref>፤ <ref loc="ACT 1:6-8">ሶቀ. 1፥6-8</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36"/>ህካን ጠወአንን ኢስ ገዉንኩስ በላንከሰ ኡር «ወገሬቱ ክዕኔሃ እሁን» ዬሰ።<verse eid="LUK 24:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37"/>ጠዉ እኮጎሬ እሰን አያነ ለኣኢሃ አጉጃንሰ ህልቅ ዋጅቶኡ። <verse eid="LUK 24:37"/><verse number="38" style="v" sid="LUK 24:38"/>እስን «ሚሃት ህልቄነንታሁ? ህትን ሚሃት ቀልቤንከክዕኔ ሸክቴነንታቲሁ? <verse eid="LUK 24:38"/><verse number="39" style="v" sid="LUK 24:39"/>ኤሳሃ ገዉእ እሁእ አንገእለከ ሎከእ ለእዬ፤ ህትን ለኤነንተኤገን ኤሳሃ ዮ ማሉ፥ ምቁለከ አያኑ ዮስበእቤቺሃ ኤሳሃ አፌን ለዕዬ» ዬሰ።<verse eid="LUK 24:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 24:40"/>ህካን ይኬይ አንገስለከ ሎከስ ለሊሾሰ። <verse eid="LUK 24:40"/><verse number="41" style="v" sid="LUK 24:41"/>እሰን አበ ሙንደእ አጀብሲጭቶቤቺሃ ጠወስ አመዕንቶበአ እቅ፤ ኢስን እሰተ «እቴኖርቹ ዮህዕኔንዶ?» ዬሰ። <verse eid="LUK 24:41"/><verse number="42" style="v" sid="LUK 24:42"/>እሰን ሬዕዮ ቀዉተ ቁርጩሜተ ኣቶስ። <verse eid="LUK 24:42"/><verse number="43" style="v" sid="LUK 24:43"/>እስን ኣእ ኬዕይ ብሬንከሰ እቾ።<verse eid="LUK 24:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44"/>ህከኒች ኤተሮን ኢስ «ክዕኔኤን ሜጡበ ሄዕዮም ወክት ‹ሙሲ ሕጋን፥ ነቢያኖለከ መዝሙር መጻፋን እተኔሃ ከተበሞሁ ጉዕሙንኩ እሁ ሀስሰኖስ› ይ ኩሎንክዕኔ ላገት ተኒት» ዬሰ።<verse eid="LUK 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45"/>ህከ ወክት ጠሊሉ መጻፉ የኖሃ ሰውይታገ ቀልብሰ ፈኞ። <verse eid="LUK 24:45"/><verse number="46" style="v" sid="LUK 24:46"/>ህትን « ‹መሲሁ ኦርሸተ ኣአኖ፤ ሰቅ በርንከ ሬሆች ኬአኖ፤ <verse eid="LUK 24:46"/><verse number="47" style="v" sid="LUK 24:47"/>ህትን ቶበቱለከ ጩብ አጉሩ ዬሩሳሌሚች ኬሽ ጉዕማንከ ኡመት በላን እስ ሱዕሚን ኩለመኖ› የመም ከተበሞኡ። <verse eid="LUK 24:47"/><verse number="48" style="v" sid="LUK 24:48"/>አዕኑ ከን ጉዕመንከ ጠዊሃ ምስክረታን። <verse eid="LUK 24:48"/><verse number="49" style="v" sid="LUK 24:49"/>አን አኑኤ ኣሴ ተብሳሃ ሶሃንክዕኔ፤ ጠዉ እኮጎሬ አሊች ዎልቀት ኣሰንቶህዕኔተ ኢለ ዬሩሳሌም ከተማን አገሬ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">24፥49 </char><char style="xt" closed="false"><ref loc="ACT 1:4">ሶቀ. 1፥4</ref>።</char></note><verse eid="LUK 24:49"/></para>
  <para style="s1">ኢስ ሰማ ኦሮኡስ</para>
  <para style="r">(<ref loc="MRK 16:19-20">ማር. 16፥19-20</ref>፤ <ref loc="ACT 1:9-11">ሶቀ. 1፥9-11</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50"/>ህከኒች ኤተሮን ኢስ አሳበስ ዬሩሳሌም ከተሚች ፉሽ «ቢታነ» ዬኖ ከተመ መሴሰ፤ ህከኔን አንገስ ሂር ማሰዕዮሰ። <verse eid="LUK 24:50"/><verse number="51" style="v" sid="LUK 24:51"/>ማሰአንን እሳች አደ እክ ሰማ ኦሮዕዮ።<note caller="-" style="x"><char style="xo" closed="false">24፥51 </char><char style="xt" closed="false"><ref loc="ACT 1:9-11">ሶቀ. 1፥9-11</ref>።</char></note> <verse eid="LUK 24:51"/><verse number="52" style="v" sid="LUK 24:52"/>እሰን እሲሃ ሰገድ ኬእ አበ ሙንዲኖን ዬሩሳሌም ከተመ ፈንቀልት <verse eid="LUK 24:52"/><verse number="53" style="v" sid="LUK 24:53"/>መገን ምኔን ጉዕመ ወክትንከ መገኑ ገለትጭተን ሄኣኢት እቅ።<verse eid="LUK 24:53"/></para>
  <chapter eid="LUK 24"/>
</usx>
