<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- HALABA NEW TESTAMENT</book>
  <para style="h">ፍልሞኒሃ</para>
  <para style="toc1">ጳዉሎስ ፍልሞኔሃ ከተቦ ሶህኑተ</para>
  <para style="toc2">ፍልሞኒሃ</para>
  <para style="toc3">ፍልሞ.</para>
  <para style="mt1">ጳዉሎስ ፍልሞኔሃ</para>
  <para style="mt2">ከተቦ ሶህኑተ</para>
  <para style="imt1">ኣጉስ</para>
  <para style="ip">ፊልሞን ኤንኬዕነሞሃ አመዕናንቹ እቅ፤ ቆላስያሲ ዱእ ምኒ መንቹ እሁስ መሌኖስ፤ ፍልሞን ኦኔሲሞሴ ዬኖ ሮስቹ ሄዕዮስ እቅ፤ ሁኩ ሮስቹንኩ ቀርቹስ ለገዕይ ኦሮዕዮ ወክት ኡሱር ምኔን ሄዕዮ ጳዉሎሴን ደቀሞ፤ ጳዉሎሴ መሳን ኦኔሲሞስ አመዕናንቹ እኮ፤ ጳዉሎስ ሶኮ ሶህኑት ፍልሞን እስቤቹ አሜተን ሄዕዮ ሮስቺንከስ ሀራዕረሞተ ቃግሳስተ፤ ጳዉሎስ ኦኔሲሞሴ ፍልሞኔን ሀራርሶተ ፈንቀሽ ሶሆተ ፍልሞን ሮስችገ አዕይ ቶጎተ እሁዕነ መሲህ ኢስ ሱዕሚን አመስቤቲገ አዕይ ቶጎተ ሶኮ። ት ሶኮ ሶህኑት አመዕኔ መኑ ኢታንለከ አጉሪን ሄኦተ ጡመተ ምሳል።</para>
  <para style="iot">መጻፉስ አፎሃ</para>
  <para style="io1">ኣጉስ <char style="ior">(<ref loc="PHM 1:1-3">1-3</ref>)</char></para>
  <para style="io1">ጳዉሎስ ፍልሞነ ገለትጩስ <char style="ior">(<ref loc="PHM 1:4-7">4-7</ref>)</char></para>
  <para style="io1">ጳዉሎስ ኦኔሲሞሴ ቶጎተ ፍልሞኒሃ ሆንጠህሾ ኡጭቱተ <char style="ior">(<ref loc="PHM 1:8-22">8-22</ref>)</char></para>
  <para style="io1">መጨረሸስ <char style="ior">(<ref loc="PHM 1:23-25">23-25</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1"/>መሲህ ኢስተኔሃ ኡሱረኛ እኮም ኢች ጳዉሎሴችለከ አመኔቤቲች ጢማቶሴች ኢተሞ አመኔቤቱለከ ሆጎኔ ጃለ እኮ ፍልሞኒሃ <verse eid="PHM 1:1"/><verse number="2" style="v" sid="PHM 1:2"/>አመኔቤቶተ አፍብያሃ፥ ኒን ሜጡበ መሲህ ኢስ ዎታደረ እኮ አርክጳሴለከ ህትን ምኔክ ጭምይቶ አመዕናኖተ፤<note caller="+" style="f"><char style="fqa" closed="false">ምኔንከክ ጭምይታ አመዕናኖተ፦ </char><char style="ft" closed="false">የኖሁ ግርክ አፎን «ምኔንከክ ጭምይታ መንተኔሃ» የኖ።</char></note><note caller="-" style="x"><char style="xo" closed="false">2 </char><char style="xt" closed="false"><ref loc="COL 4:17">ቆላ. 4፥17</ref>።</char></note><verse eid="PHM 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3"/>አንችኔ መገኒችለከ ቀርቾ መሲህ ኢሲች ኣስቱትለከ ወገሬቱ ክዕኔሃ እሁን።<verse eid="PHM 1:3"/></para>
  <para style="s1">ፍልሞኔ ኢተተለከ አመዕነቱ</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4"/>ዱአ አኣም ወክት ኬሳሃ ሰውየን መገኑኤ ጉዕመ ወክት ገለትጫሚት። <verse eid="PHM 1:4"/><verse number="5" style="v" sid="PHM 1:5"/>ቀርቾ ኢሳን ዮሄ አመዕነቱለከ ኢተተ ህትን አመዕናኖተ ዬሄ ኢተክ ሞጮጭዮም። <verse eid="PHM 1:5"/><verse number="6" style="v" sid="PHM 1:6"/>ኔሳሃ ሜጡ አዕዮኔ አመዕነቱ መሲህ ኢሲን ዮኔ ጡመ ጠወ ጉዕመንከ ብዝ አት አጥራመታንትገ አኦሄተ አን ኬሳሃ ዱአ አኣም። <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>ኢ አመቤቶ! ኪ መሳን አመዕናኖ ቀልብ ብዝ አዕይ ጠረኝሾቤቺሃ ኢተክ አበ ሙንዲኑተለከ ጠረኝመተ ኣቶኤ።<verse eid="PHM 1:7"/></para>
  <para style="s1">ጳዉሎስ አናስሞሴተኔሃ ሆንጠህሾ ዱአ</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8"/>ህካን እኮቤቺሃ አኡ ሀስሰኖኤሃ አእ ይ ኬሳሃ አዘዞተ መሲህ ኢሲን መለል ጠወኦተ አታላም እቅ። <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>እኮጎሬ ካን አኣምሀኒች መሲህ ኢስተኔሃ ኡሱረኛ እኮም አን ባሊቆም ጳዉሎስ ኢታን ኡጩ መጠሮም። <verse eid="PHM 1:9"/><verse number="10" style="v" sid="PHM 1:10"/>አን ኡሱር ምኔን ሄአን ቤቱእ እኮ ኦናሲሞሴተኔሃ ኬሳሃ ኡጫንኬ።<note caller="-" style="x"><char style="xo" closed="false">10 </char><char style="xt" closed="false"><ref loc="COL 4:9">ቆላ. 4፥9</ref>።</char></note> <verse eid="PHM 1:10"/><verse number="11" style="v" sid="PHM 1:11"/>አናሲሞስ ከኒች ብርተ ደግለሎሄበ እቅ፤ ቴሱ እኮጎር ኬሳሃ እኮ ኤሳሃ ደግለለኖኤ።<verse eid="PHM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12"/>ህትን እሱንከ ኪቤቹ ፈንቀሽ ሶኮም፤ እሱ ኪቤቹ ፈንቀሽ ሶሃም ወክት ገዉኤ አዕይ ኢታምሀንገ አዕይ ወለኣም። <verse eid="PHM 1:12"/><verse number="13" style="v" sid="PHM 1:13"/>ተሽት ላገ መሳን ከኔ ኡሱረሞምሀኔን ኪቤቾን እክ ሀዕሎኤተ እስ ኢን ሜጡበ እኮ እቅ ተሽ የኖኤ እቅ። <verse eid="PHM 1:13"/><verse number="14" style="v" sid="PHM 1:14"/>ጠዉ እኮጎሬ አት አታንት ጡመ ሆጉተ ግዳጂን እሁዕነ ኢታን እሆተ ኬሳሃ ጠዕሙዕነ መቱርቹሃ አኦተ ሀሾምበአ።<verse eid="PHM 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15"/>አናስሞስ ቀዎ ወክቲሃ ኪች አደ እኮጎሬሁ ከ ኤተሩ ልግብ ወክት ኪን ሜጡበ ሄኦተ አታለኖ። <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>ከኒች ኤተሮን ኪን ሜጡበ ሄአኖሁ ሮስችገ እሁዕነ ሮስቺች በተዕዮሃ እክ ኢተሞ አመቤትጋት፤ እስ ኤሳሃ ኢታም አመኤሃ ቤቱ፤ ጠዉ እኮጎሬ እስ ኤሳሃ ኢታም አመኤቤቱ እኮች በትሽን ኬሳሃ ደግለሸቀሜኖ ሄኦንለከ ቀርቺን ሀት ኢተሞ አመክቤቱ እሀኖበአ?<verse eid="PHM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17"/>ቴሱ ኤሳሃ አመክቤትገ አት ዎለኦንቴኤች ኢገ አት ቶግስ። <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>ኢልሾሄ ብድሉ ዮ ጎሬ ህከረንገ ኤዶ ዮስጎሬ ኢ አሌን ዎለእ። <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>አን ጳዉሎስ «ኤዳስ ባታም» ይ ገይኤ አንጋን ከተቦም፤ እኮጎሬ ኪ ሄእተኔሃ አት ገዉክ እኮንት እቃ ኢ ኤዶሁ ዮሄሃ እሁክ ቃግሱ ሀስሰኖበአ። <verse eid="PHM 1:19"/><verse number="20" style="v" sid="PHM 1:20"/>ቴሱ ኢ አመቤቶ! ቀርች ሱዕሚን ከ ጡመርቹ አቶኤተ ኡጫንኬ፤ ሀዕይ ቀልብኤ መሲህ ኢሲን ፎሎጨኖገ አኤኤ።<verse eid="PHM 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21"/>ካን አን ከተቦንኬሃ አታንትገ አመዕናም፤ ሆሮን አን ጠዕሜምሀኒች በትስ አታንትገ ደጋም። <verse eid="PHM 1:21"/><verse number="22" style="v" sid="PHM 1:22"/>ህትን መገኑ ዱአክዕኔ ሞጮጭ ክዕኔቤቹ አሜታምገ አአኖኤገ ተብሳሃ አኣምቤቺሃ ኤሳሃ ፎሎጫም ቤቹ ቅጥ አኤኤ።<verse eid="PHM 1:22"/></para>
  <para style="s1">ጎፍሜ ወገሬትተኔሃ</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23"/>ኢን ሜጡበ መሲህ ኢስተኔሃ ኡሱረሞ ኤጳፍረ «ወገሬት ዮንተንዶ?» የኖሄት።<note caller="-" style="x"><char style="xo" closed="false">23 </char><char style="xt" closed="false"><ref loc="COL 1:7">ቆላ. 1፥7</ref>፤ <ref loc="COL 4:12">4፥12</ref>።</char></note> <verse eid="PHM 1:23"/><verse number="24" style="v" sid="PHM 1:24"/>ህትን ሆጎእ ጃለተ ማርቆስ፥ አርስጥሮኮስ፥ ዴማስለከ ሉቃስ «ወገሬት ዮንትንዶ?» ይታሄት።<note caller="-" style="x"><char style="xo" closed="false">24 </char><char style="xt" closed="false"><ref loc="ACT 12:12">ሶቀ. 12፥12</ref>፤ <ref loc="ACT 25">25</ref>፤ <ref loc="ACT 13:13">13፥13</ref>፤ <ref loc="ACT 15:37-39">15፥37-39</ref>፤ <ref loc="ACT 19:29">19፥29</ref>፤ <ref loc="ACT 27:2">27፥2</ref>፤ <ref loc="COL 4:10-14">ቆላ. 4፥10-14</ref>፤ 2 ጢሞ. 4፥10፥11።</char></note><verse eid="PHM 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25"/>ቀርቾ መሲህ ኢስ ኣስቱት ክዕኔን ሜጡበ እኩን።<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
