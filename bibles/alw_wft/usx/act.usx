<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- HALABA NEW TESTAMENT</book>
  <para style="h">ሶቀማኖ ሆጉተ</para>
  <para style="toc1">ሶቀማኖ ሆጉተ</para>
  <para style="toc2">ሶቀማኖ ሆጉተ</para>
  <para style="toc3">ሶቀ.</para>
  <para style="mt">ሶቀማኖ ሆጉተ</para>
  <para style="imt1">ኣጉስ</para>
  <para style="ip">ሶቀማኖ ሆጎ መጻፉ ሉቃስ እንጂሊች ኤተሪን ዮእሃን፤ መጻፍስ ቡዕለ እኮ ጠዉ ዎዕኔ ኢስ አሳበት መገን አያኒን አዎንት እስተኔሃ ጠወአኖ ተሽት ላገተ «ዬሩሳሌማን፥ ይሁድ ባዶን ጉዕማን፥ ሰማርያንለከ ኡለ ገበለ ኢለ» (1፥8) እንጂለ ሀት አት እልሶጎሬ ኩሊሃት፤ መጻፉስ አመዕነቱ አይሁድ በላን ጀመር ጉዕመ ኣዱንያ አል ኡመት አመዕናኖ ሀይመኖተ እሆተ ኢለ ሀት እክ አልባዕሌጎሬ ጠወኣእተ ሄሱ። ከተቦሲሁ አመዕናኑት ሮም ዎመ ግብ ኣዚን ሂለ ጠወ አታ መነ እሁ ሆጉሰለከ አመዕናኖ ሀይመኖቱ አይሁድ ሀይማኖተ ዊመ አአኖሃ እሁስ ኩሎታት።</para>
  <para style="ip">ሶቀማኖ ሆጉት ኢስተኔሃ ጠወኣ ተሽት ላገት ኢልታ ቤቹ ወክቲን ወክቲን አልባዕለን መሩስለከ አመዕናኑት በተአን መሩሰ ለሊሳኢሁ ሰሱ ቡዕለ እኮ ጠዋኒት፦</para>
  <para style="ili">1. አመዕናኖ አመዕነቱ ኢስ ሰማሃ ኦሮዕዮች ኤተሮን ዬሩሳሌማን ጀመሩስ።</para>
  <para style="ili">2. አመዕናኖ አመዕነቱ እስራኤል ባዱ ጉዕመንከ ኢሉስ።</para>
  <para style="ili">3. አመዕናኖ አመዕነቱ ሮም ባዱ በርግ ሜድቴራን ባር አዝጋጌን ዮ ባዶን አልባዕሉስ።</para>
  <para style="ip">ሶቀማኖ ሆጎ መጻፍ ኣዜን ብዝ ይ ለለኖሁ ጠሊለ አያን ሆጉተ እሀን ጴንጤቆስጤ በር ዬሩሳሌማን ሄኦ አመዕናኖ አሌን ወልቃን ድሩስለከ ህትን መጻፍስ ኣዜን ጠወአሞ ጠዉ ጉዕሙንኩ ለሌ ጠሊለ አያንገ አመዕናኑተለከ አዎንሳኑት አዎንሱሰለከ ጠረኝሱስ በርገኖ። ዎዕኔ ዘማን ሆንጠሀኖ እቅ አመዕናኖ አመዕነት ሶህኑት አደደ ዱዱብስ ኣዜን ደግለለኖ ሃሊን ሆንጠኮኡ፤ ሶቀማኖ ሆጎ መጻፍ ኣዜን እኮ ጠው ሶህኑት አመዕናኖ ሄኦንለከ ሜጡ እሆን ሄኦ ወልቀት ሄንከ ሎረ እሁስ ኩለኖ።</para>
  <para style="iot">መጻፉስ አፎሃ</para>
  <para style="io1">ምስክርነትስ ተቃጠቡ <char style="ior">(<ref loc="ACT 1:1-26">1፥1-26</ref>)</char></para>
  <para style="io1">ኢስ መጨረሻን ኣሴ ትዛዝለከ ተብሳሃ <char style="ior">(<ref loc="ACT 1:1-14">1፥1-14</ref>)</char></para>
  <para style="io1">ይሁድ ቤቾን ኣጎ መንቹ <char style="ior">(<ref loc="ACT 1:15-26">1፥15-26</ref>)</char></para>
  <para style="io1">ዬሩሳሌማን ኢስተኔሃ ዱዱብሴመገ <char style="ior">(<ref loc="ACT 2:1-8:3">2፥1—8፥3</ref>)</char></para>
  <para style="io1">ይሁዳንለከ ሰማርያን ዱዱብሴመገ <char style="ior">(<ref loc="ACT 8:4-12:25">8፥4—12፥25</ref>)</char></para>
  <para style="io1">ጳዉሎሴ እንጂል ሶቀም ክድመተ <char style="ior">(<ref loc="ACT 13:1-28:31">13፥1—28፥31</ref>)</char></para>
  <para style="io1">ጳዉሎስ ወዕኔ ወክት እንጂለ ዱዱብሶተ ሃሙስ <char style="ior">(<ref loc="ACT 13:1-14:28">13፥1—14፥28</ref>)</char></para>
  <para style="io1">ዬሩሳሌም ኦገት <char style="ior">(<ref loc="ACT 15:1-35">15፥1-35</ref>)</char></para>
  <para style="io1">ጳዉሎስ ለምቅ ወክት እንጂለ ዱዱብሶተ ሃሙስ <char style="ior">(<ref loc="ACT 15:36-18:22">15፥36—18፥22</ref>)</char></para>
  <para style="io1">ጳዉሎስ ሰቅ ወክት እንጂለ ዱዱብሶተ ሃሙስ <char style="ior">(<ref loc="ACT 18:23-21:16">18፥23—21፥16</ref>)</char></para>
  <para style="io1">ጳዉሎስ ዬሩሳሌማን፥ ቂሳርያንለከ ሮም ባዶን ኡሱረሙስ <char style="ior">(<ref loc="ACT 21:17-28:31">21፥17—28፥31</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="ACT 1"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1"/>ቴዎፍሎሴ!<note caller="-" style="x"><char style="xo" closed="false">1፥1 </char><char style="xt" closed="false"><ref loc="LUK 1:1-4">ሉቃ. 1፥1-4</ref>።</char></note></para>
  <para style="p" vid="ACT 1:1">ዎኔኤ መጻፋን ኢስ አዕዮሀለከ ተማርሴኢሃ ጉዕመንከ ከተቦም። ከተቦሚንኩ ኢስ ሆጉስ ጀመሮ ወክቲች ኬሽ <verse eid="ACT 1:1"/><verse number="2" style="v" sid="ACT 1:2"/>ሰማሃ ኦሮዕዮ በር ኢለ አዕዮሃት፤ ሰማሃ ኦሮዕዮሁ መጠሮ አሳባተ ትዛዝስ ጠሊለ አያኒን ኣሴሳች ኤተሮኒት፤ <verse eid="ACT 1:2"/><verse number="3" style="v" sid="ACT 1:3"/>ልግብ ኦርሸተ ቶግ ሬዮች ኤተሮን ልግቤ ለልዮ ምስክርን ፎሊን እክ አሳባተ ገዉስ ለሊሾሰ፤ ሸይሉ በር ዊመ ለለንሰ መገን ዎምነትተኔሃ ጠወዕዮሰ። <verse eid="ACT 1:3"/><verse number="4" style="v" sid="ACT 1:4"/>መቱ ወክት እሳን ሜጡበ እተንለከ አገን ሄዕዮ ወክት ኢስ «አን ኩሎንክዕኔ አኑኤ ኣሴ ላገተ አገሬ ቤሉ ዬሩሳሌሚች ፉልቶኖቼ፤<note caller="-" style="x"><char style="xo" closed="false">1፥4 </char><char style="xt" closed="false"><ref loc="LUK 24:29">ሉቃ. 24፥29</ref>።</char></note> <verse eid="ACT 1:4"/><verse number="5" style="v" sid="ACT 1:5"/>መሰንትስ ያህይ ዊን ጠመቆ፤ እኮጎሬ አዕኑ ቀወ በሬች ኤተሮን ጠሊለ አያኒን ጠመቀንቴነንተ» ይ አዘዦሰ።<note caller="-" style="x"><char style="xo" closed="false">1፥5 </char><char style="xt" closed="false"><ref loc="MAT 3:11">ማቶ. 3፥11</ref>፤ <ref loc="MRK 1:8">ማር. 1፥8</ref>፤ <ref loc="LUK 3:16">ሉቃ. 3፥16</ref>፤ <ref loc="JHN 1:33">ያህ. 1፥33</ref>።</char></note><verse eid="ACT 1:5"/></para>
  <para style="s1">ኢስ ሰማ ኦሮኡስ</para>
  <para style="r">(<ref loc="MRK 16:19-20">ማር. 16፥19-20</ref>፤ <ref loc="LUK 24:50-53">ሉቃ. 24፥50-53</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6"/>እሰን ሜጡበ ጭምይቶሀኔን «ቀርቾ! ዎምነቱክ እስራኤሊሃ ፈንቀሽት ኣታንት ወክቱ ቴሶትንዶ?» ይት ጠዕምቶስ።<verse eid="ACT 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7"/>ኢስን ፈንቀሽ «አኑ መገኑ ገይስ ዎልቃን ዬ ወክትለከ በር አዕኑ ደጎኖተ አታልቴነንተበአ። <verse eid="ACT 1:7"/><verse number="8" style="v" sid="ACT 1:8"/>ጠዉ እኮጎሬ ጠሊሉ አያኑ ክዕኔ አሌን ድሬ ወክት ዎልቀተ ደእቴነንተ፤ ህከ ወክት ዬሩሳሌማን፥ ይሁድ ኡላን ጉዕማን፥ ሰማርያንለከ ኡለ ዳንገ ኢለ ምስክር እኬነንተ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">1፥8 </char><char style="xt" closed="false"><ref loc="MAT 28:19">ማቶ. 28፥19</ref>፤ <ref loc="MRK 16:15">ማር. 16፥15</ref>፤ <ref loc="LUK 24:47-48">ሉቃ. 24፥47-48</ref>።</char></note> <verse eid="ACT 1:8"/><verse number="9" style="v" sid="ACT 1:9"/>ህካን ጠወዕዮች ኤተሮን እሰን ለአንስ አሌ ዋል ሰማሃ ኦሮዕዮ፤ ጎመንት እሌችሰ ቴልቶቤቺሃ ለኦስበአ።<note caller="-" style="x"><char style="xo" closed="false">1፥9 </char><char style="xt" closed="false"><ref loc="MRK 16:19">ማር. 16፥19</ref>፤ <ref loc="LUK 24:50-51">ሉቃ. 24፥50-51</ref>።</char></note><verse eid="ACT 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10"/>እስን አሌ ዋል ኦሮአን እሰ ሰማሃ ቱክ ይት ለአንን ዋጁተ ኦድኑተ ኦደኦ ለም መናከት መዴሰ ኡርት፥ <verse eid="ACT 1:10"/><verse number="11" style="v" sid="ACT 1:11"/>«አዕኑ ገሊለ መኑ ሚሃት ሰማ ዋሽቴን ለኤነን ኡርቴንታአ? ኩ ሰማ ኦሮአን ለኤንተስ ኢስ ሰማ ኦሮአን ለኤነንስን ፈንቀል አሜተኖ» ይቶሰ።<verse eid="ACT 1:11"/></para>
  <para style="s1">ይሁድ ቤቾን ማትያስ መጠረሙስ</para>
  <para style="r">(<ref loc="PSA 109:8">መዝ. 109፥8</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12"/>ህከኒች ኤተሮን እሰ ደብረ ዘይተ ዬኖ ቆታች ዬሩሳሌም ከተመ ፈንቀልቶኡ፤ ሁኩንን ዬሩሳሌሚች አበ በሬን ሃሞኖተ አታሌኖ ዎቄሃ ጌሰ። <verse eid="ACT 1:12"/><verse number="13" style="v" sid="ACT 1:13"/>ዬሩሳሌመ አሜት ሄኣ ፉቅ ምኒ አሌ ክፍል ፉልቶኡ፤ እሰን «ጴጥሮሴት፥ ያህዪት፥ ያቁባት፥ እንድራሴት፥ ፍልጶሴት፥ ቶማሴት፥ በርቴሌሜዎሴት፥ ማቶሴት፥ እልፍዮሴሃ ቤቱ ያቁባት፥ ባዱስ ኢተኖ<note caller="+" style="f"><char style="fqa" closed="false">ባዱስ ኢተኖ፦ </char><char style="ft" closed="false">ማር. ፎሎጭ 3 ዎሊንሽ 18 ዮኢሃ ለዕዬ።</char></note> ስሞኔትለከ ያቁብሃ ቤቱ ይሁዳት።»<note caller="-" style="x"><char style="xo" closed="false">1፥13 </char><char style="xt" closed="false"><ref loc="MAT 10:2-4">ማቶ. 10፥2-4</ref>፤ <ref loc="MRK 3:16-19">ማር. 3፥16-19</ref>፤ <ref loc="LUK 6:14-16">ሉቃ. 6፥14-16</ref>።</char></note> <verse eid="ACT 1:13"/><verse number="14" style="v" sid="ACT 1:14"/>ሁኩ ጉዕሙንኩ ኢስ አማን መርየማን፥ ለቤ አመስ ኦሶንለከ ዎሎ ሜንቲን ሜጡበ መቶሃ ቀልቢን ኡርሱዕናን ዱአ አታኢት እቅ።<verse eid="ACT 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15"/>ህከ ወክት ጴጥሮስ መት ጥብተ ለሞድም ጌሰ እሀኖ አመዕናኖ ጭምት በላን ኡር <verse eid="ACT 1:15"/><verse number="16" style="v" sid="ACT 1:16"/>«አመኤ ኦሶ! ኢሰ አፎ መኒሃ አዎንሳንቹ እኮ ይሁድተኔሃ ጠሊሉ አያኑ ሄጭን ደዉዴ አፎን ጠወአንቶ ጠሊለ መጻፍ ላገት ዊሙ ሀስሰኖሴ። <verse eid="ACT 1:16"/><verse number="17" style="v" sid="ACT 1:17"/>ይሁድ ከን ሆጎ ቤቀማንቹ እሆተ ኒንን ሜጡበ ዎለአሞኡ እቅ። <verse eid="ACT 1:17"/><verse number="18" style="v" sid="ACT 1:18"/>ጠዉ እኮጎሬ ሁኩ መንቹ ሂለ ሆጎስ ብሪን ኡለተ ህዕሬእ፤ እስን ብርተ ዋል ጎምብሰም ኡባን ጎደቡስ ፍልተዕያን ህሌስ ፉልቶኡ።<note caller="-" style="x"><char style="xo" closed="false">1፥18 </char><char style="xt" closed="false"><ref loc="MAT 27:3-8">ማቶ. 27፥3-8</ref>።</char></note> <verse eid="ACT 1:18"/><verse number="19" style="v" sid="ACT 1:19"/>ሁኩ ጠዉንኩ ዬሩሳሌማን ሄአኖ መንቤቾን ጉዕማንን ለሌእ፤ ህካን እኮቤቺሃ ሁኩ ቤቹ እሰ አፎን ‹አኬልዳመ› ዬን ገኤመ፤ ፍሳረንትስ ‹ቄግ ኡለተ› ዩሃን።<verse eid="ACT 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20"/>ሁኩን እኮንኩ «ደውድ መጻፋን</para>
  <para style="q1" vid="ACT 1:20">«‹እስ ሄአኖ ቤቹ ኦነ እሁን፤</para>
  <para style="q1" vid="ACT 1:20">ህከን ቤቾን አዪሁ ሄኡንከ›</para>
  <para style="q1" vid="ACT 1:20">ህትን ‹እስ ሹምነትስ ሆጉተ ዎሉ መኑ ኣኡን›»<note caller="-" style="x"><char style="xo" closed="false">1፥20 </char><char style="xt" closed="false"><ref loc="PSA 69:25">መዝ. 69፥25</ref>፤ <ref loc="PSA 109:8">109፥8</ref>።</char></note></para>
  <para style="m" vid="ACT 1:20">የመም ከተበሞኡ።<verse eid="ACT 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 1:21"/>«ህካን እኮቤቺሃ ቀርቹ ኢስ ኒ በላን ፈንቀላመን ሄዕዮ ዘማን ጉዕመንከ ኒን ሜጡበ ሄኦሀኑኡች <verse eid="ACT 1:21"/><verse number="22" style="v" sid="ACT 1:22"/>ህትን ያህይ ጥምቀቲች ኬሽ ቀርቹ ኢስ ሰማሃ ኦሮዕዮ በር ኢለ ኒን ሜጡበ ህከን መኒች መቱስ ኒን ሜጡበ ኬእሀስ ምስክር እሆተ ሀስሰኖ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">1፥22 </char><char style="xt" closed="false"><ref loc="MAT 3:16">ማቶ. 3፥16</ref>፤ <ref loc="MRK 1:9">ማር. 1፥9</ref>፤ <ref loc="MRK 16:19">16፥19</ref>፤ <ref loc="LUK 3:21">ሉቃ. 3፥21</ref>፤ <ref loc="LUK 24:51">24፥51</ref>።</char></note><verse eid="ACT 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23"/>«ኢዮስጦሴ» ህከረንገ «በርሳባሴ» ዬኖ «ዩሱፈለከ» «ማትያሴ» ዬኖ ለሙ መንቹ ቅጥአቶኡ። <verse eid="ACT 1:23"/><verse number="24-25" style="v" sid="ACT 1:24-25"/>እሰን ዱአ አተን «መን ቀልብ ጉዕመንከ ደጋንት ቀርቾ! ከን ለምችሰ አዬስ መጠርቶንት ጎር ይሁድ አጉር ሬዮ ክድመተለከ ሶቀም ሆጉተ ቶግ ቤቾስ እሀኖሃ ለሊሶኔታት» ይቶኡ። <verse eid="ACT 1:24-25"/><verse number="26" style="v" sid="ACT 1:26"/>እጠ ኡጄናን እጡ ማትያሴሃ እሌእ፤ ህካን እኮቤቺሃ እስን ቶና መቶንከ አሳባን ሜጡበ ዎለአሞ።<verse eid="ACT 1:26"/></para>
  <chapter eid="ACT 1"/>
  <chapter number="2" style="c" sid="ACT 2"/>
  <para style="s1">ጠሊሉ አያኑ አሳበስ አሌን ድሩስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1"/>ጴንጤቆስጤ ከበጃት ዬን ከበጄኖ ከበጀ ወክቱ እሌ ወክት አሳበስ ጉዕሙንኩሰ መቶ ቤቾን ጭምይቶ እቅ።<note caller="-" style="x"><char style="xo" closed="false">2፥1 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">ሌዌ 23፥15-21</ref>፤ <ref loc="DEU 16:9-11">ዘዳ. 16፥9-11</ref>።</char></note> <verse eid="ACT 2:1"/><verse number="2" style="v" sid="ACT 2:2"/>ድንገቴን ጠረኘ ቦብርገ ዮ ላገት ሰሜች አሜት እሰ አፉዕልቶ ምኒ ዊሞ። <verse eid="ACT 2:2"/><verse number="3" style="v" sid="ACT 2:3"/>ህከንቤቾንን ጊረ ለበነተ አጉደኖ መት-መት አረብት ለልቶሰ፤ እሰን ቤቀንት መት-መትሰ አሌን አፉዕልቶኡ። <verse eid="ACT 2:3"/><verse number="4" style="v" sid="ACT 2:4"/>ጉዕሙንኩሰ ጠሊለ አያኒን ዊንቶኡ፤ እሰን ጠሊሉ አያኑ አዕዮሰገን ዎሎ አፎን ጠወኡ ጀመርቶኡ።<verse eid="ACT 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5"/>ኣዱንያ አሌን ዮ ኡመቲች ጉዕሚችን አሜቶ መገኑ ዋጅታ አይሁዱ ዬሩሳሌማን ሄኣኢት እቅ። <verse eid="ACT 2:5"/><verse number="6" style="v" sid="ACT 2:6"/>ህከ ላገተ ሞጮጭቶ ልግቡ መኑ ጭምይት አሜቶኡ፤ እሰን መት-መቱሰ ገይሰ አፎን ጠወአን ሞጮጭት አጀብሲጭቶኡ። <verse eid="ACT 2:6"/><verse number="7" style="v" sid="ACT 2:7"/>ሁኩ መኑንኩ አበ አጀብሲጭት «ኩሩ ህት ጠወኣእሩ ጉዕሙንኩ ገሊላ መነበእንዶ? <verse eid="ACT 2:7"/><verse number="8" style="v" sid="ACT 2:8"/>ነኡ ገዉኔ ከለቀሞም ባድ አፌን ጠወአን ሞጮጭናሚሁ ኩን መርቹሃን? <verse eid="ACT 2:8"/><verse number="9" style="v" sid="ACT 2:9"/>ነኡ ጳርቴ ባድ መኑሁ፥ ሜድ ባድ መኑሁ፥ ኤላሜ ባድ መኑሁ፥ መስጴጦም ባድ መኑሁ፥ ይሁድ ባድ መኑሁ፥ ቄጳዶቅ ባድ መኑሁ፥ ጳንጦስ ባድ መኑሁ፥ እስይ ባድ መኑሁ፥ <verse eid="ACT 2:9"/><verse number="10" style="v" sid="ACT 2:10"/>ፍርግ ባድ መኑሁ፥ ጵንፍል ባድ መኑሁ፥ ግብጽ ባድ መኑሁ፥ ሊብይ ባዶን ቄሬን ከተም መዴን ሄዕኖምሩ፥ ሮም ባዲች አሜንቶም አይሁዱለከ አይሁድ አዳ ዶረሞምሩ ዮም። <verse eid="ACT 2:10"/><verse number="11" style="v" sid="ACT 2:11"/>ህትን ቀርጤስለከ አረብ ባድ መኑሁ መገን ሎረ ሆጉተ ገይኔ አፎን ጠወአን ሞጮጭናሚት» ይቶኡ። <verse eid="ACT 2:11"/><verse number="12" style="v" sid="ACT 2:12"/>ህካን እኮቤቺሃ ጉዕሙንኩ አጀብሲጭትለከ ይታኢሃ ሆግ መት-መቱሰ «ኩ ጠዉ መርቹሃን?» የቀንታኢት እቅ።<verse eid="ACT 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 2:13"/>ጠዉ እኮጎሬ ዎሉሰ መኑ ቀለደን «ሰከርሰኖ አጌኖሃ አግ ሰከርቶኡ» ይቶኡ።<verse eid="ACT 2:13"/></para>
  <para style="s1">ጴጥሮስ ጠወዕዮገ</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14"/>ህከ ወክት ጴጥሮስ ቶነ መቶንከ አሳባን ሜጡበ ኡር ላገስ ጎት አዕይ «አዕኑ አይሁድ መኑለከ ዬሩሳሌማን ሄኤነንተሩ ጉዕሙንኩ ከ እኮ ጠወ ደጎኖተ ጠወኣሚሃ ሞጮጭዬ። <verse eid="ACT 2:14"/><verse number="15" style="v" sid="ACT 2:15"/>ክዕኔሃ አመሰሎህዕኔ ቤሉ ኩ መኑ ሰከሮበአ፤ መሰንትስ ቴሱ ገስሜ ሰሶሃ ሰኣት። <verse eid="ACT 2:15"/><verse number="16" style="v" sid="ACT 2:16"/>ጠዉ እኮጎሬ ኩን ነብዬቾ ኢዮኤላን ህት ይ ጠወአሞ ጠዉ ዊሞታት።<verse eid="ACT 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17"/>« ‹እስን መገኑ</para>
  <para style="q2" vid="ACT 2:17">መጨረሽ ዘመኔን ህት እሀኖ፤</para>
  <para style="q1" vid="ACT 2:17">መናን ጉዕማንን፤</para>
  <para style="q2" vid="ACT 2:17">ጠሊለ አያኒችኤ አሌሰ ዱናም፤</para>
  <para style="q2" vid="ACT 2:17">ጎኑለከ ሜኣ ኦሱክዕኔ ራገ ጠወኣአ፤</para>
  <para style="q2" vid="ACT 2:17">ዎደለት መናመተ ለኣአ፤</para>
  <para style="q2" vid="ACT 2:17">ባልቀንት ሀቄተ ሀቃቅታአ።<note caller="-" style="x"><char style="xo" closed="false">2፥17-21 </char><char style="xt" closed="false"><ref loc="JOL 2:28-32">ኢዩ. 2፥28-32</ref>።</char></note><verse eid="ACT 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18"/>ህትን ህከ ዘመን ለቤለከ ሜንት ካዲመኤ አሌን</para>
  <para style="q2" vid="ACT 2:18">ጠሊለ አያኒችኤ አሌሰ ዱናም፤</para>
  <para style="q2" vid="ACT 2:18">እሰን ራገ ጠወኣአ።<verse eid="ACT 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19"/>አን አጀብሲሰኖርቹ ሰሜ አሌን</para>
  <para style="q2" vid="ACT 2:19">መላተ ኡለ አሌን ለሊሳም፤</para>
  <para style="q2" vid="ACT 2:19">ቄጉ፥ ጊረትለከ ዉሊሌ ጎመት እካአ።<verse eid="ACT 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ACT 2:20"/>ሎሩለከ አጀብሲሰኖ ቀርች በሩ አሜቱዕናን ሄጭ</para>
  <para style="q2" vid="ACT 2:20">አሩ ቱንስቹ እሀኖ፤</para>
  <para style="q2" vid="ACT 2:20">አገንቹንኩ ቄጉ አጉደኖ።<verse eid="ACT 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21"/>ቀርች ሱዕመ ገአኖሁ አዪሁ ጡመኖ፤›<verse eid="ACT 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22"/>«እስራኤል መነ! ተ ላገተ ሞጮጭዬ፤ አዕኑ ገዉንኩክዕኔ ደጌነንተገን ናዝሬት ኢስ መገኑ በላንከክዕኔ እስ አዲን አዕዮ ሎርሎረ ሆጎን፥ አጀብሲሰኖ ጠዊንለከ መላን መገን አዲን ክዕኔሃ ለልዮእሃ መንቹ እቅ። <verse eid="ACT 2:22"/><verse number="23" style="v" sid="ACT 2:23"/>እሱንከ መገኑ ሰውይ ቅጥአዕዮ ሰውቲንለከ ዎዕናንከ ዮስ ኤንኬዕኒን ክዕኔሃ ህግሴን ኣሴመ፤ አዕኑን ሕጉ ዮበእ መን አንጋን ሰቀለመኖገለከ ሬሀኖገ አቴንተስ።<note caller="-" style="x"><char style="xo" closed="false">2፥23 </char><char style="xt" closed="false"><ref loc="MAT 27:35">ማቶ. 27፥35</ref>፤ <ref loc="MRK 15:24">ማር. 15፥24</ref>፤ <ref loc="LUK 23:33">ሉቃ. 23፥33</ref>፤ <ref loc="JHN 19:18">ያህ. 19፥18</ref>።</char></note> <verse eid="ACT 2:23"/><verse number="24" style="v" sid="ACT 2:24"/>ጠዉ እኮጎሬ መገኑ ሬሆ ኦርሸተ ቤሽ ሬሆች ኬሾስ፤ መሰንትስ ሬሁት እሱ አፍ ፌሶተ አታልቶበአ።<note caller="-" style="x"><char style="xo" closed="false">2፥24 </char><char style="xt" closed="false"><ref loc="MAT 28:5-6">ማቶ. 28፥5-6</ref>፤ <ref loc="MRK 16:6">ማር. 16፥6</ref>፤ <ref loc="LUK 24:5">ሉቃ. 24፥5</ref>።</char></note> <verse eid="ACT 2:24"/><verse number="25" style="v" sid="ACT 2:25"/>ደዉድ እስተኔሃ</para>
  <para style="q1" vid="ACT 2:25">« ‹ቀርቹኤ ጉዕመ ወክት ብሬንከኤ ለኣም፤</para>
  <para style="q2" vid="ACT 2:25">መሰንትስ ጨነቀምበገ እስ መኬንተኤ እኮቤቺሃ</para>
  <para style="q1" vid="ACT 2:25">አን ሌንቄቃምበአ።<verse eid="ACT 2:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26"/>ህካን እኮቤቺሃ ቀልቡኤ ሙንደዕዮ፤</para>
  <para style="q1" vid="ACT 2:26">አረብንትኤ ሙንደእ ጠወኣአ፤</para>
  <para style="q1" vid="ACT 2:26">ህትን ሬሀኖ ጅስሙኤ ተብሴን ፎሎጨኖ።<verse eid="ACT 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27"/>መሰንትስ ፎልኤ ሬዮ መን በላን ሎድ ኣዜን አጉርታንትበአ፤</para>
  <para style="q1" vid="ACT 2:27">ህትን ጠሊለ እኮሃ ሎዳን ሸም ፈቆተ አታንትበአ።<verse eid="ACT 2:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28"/>ቴሱ ሄእ ወቃሃ ለልሶንቴኤ፤</para>
  <para style="q1" vid="ACT 2:28">ኢን ሜጡ እሆንከክ ሙንዲኑኤ አበ እካአ፤›<verse eid="ACT 2:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29"/>«አመኤ ኦሶ! ወዕኔ አነ እኮ ደዉድ ሬዮገ፥ ሞገሞገለከ ሎዱንኩስ ከበሬ ኢለሬተ ኒቤቾን ሄኡስ ለሊሽ ኩላንክዕኔ። <verse eid="ACT 2:29"/><verse number="30" style="v" sid="ACT 2:30"/>ጠው እኮጎሬ ዳዉድ ካን ጠወዕዮንኩ ነብዬቹ እኮቤቺሃ መገኑ ‹ዘሬችክ መቱስ ኬዕምኝክ ቦርጭመ አሌን አፉሻም› ይ ጤሌዕል ኣሴ ተብሴ ላገተ ደገኖሃ እኮቤቺሃት እቅ።<note caller="-" style="x"><char style="xo" closed="false">2፥30 </char><char style="xt" closed="false"><ref loc="PSA 132:11">መዝ. 132፥11</ref>፤ <ref loc="2SA 7:12-13">2 ሳሙ. 7፥12-13</ref>።</char></note> <verse eid="ACT 2:30"/><verse number="31" style="v" sid="ACT 2:31"/>ህከን መሳን መሲሁ ሬዮ መን በላን ፈቀኖበእገለከ ማሉስ ሎዳን ሸም በእበገ ሄጭ ለዕይ መሲሁ ሬሆች ኬእተኔሃ ጠወዕዮ። <verse eid="ACT 2:31"/><verse number="32" style="v" sid="ACT 2:32"/>ህከ ኢሰንከ መገኑ ሬሆች ኬሾስ፤ ህከን ጠዊሃ ነኡ ጉዕሙንኩኔ ምስክረታን። <verse eid="ACT 2:32"/><verse number="33" style="v" sid="ACT 2:33"/>መገን መኬን አፉዕሎተ አሌ ዋል ጠሊለ አያን ተብሳሃ መገኒች ቶግ ከ ለኤነንተለከ ሞጮጭቴነንተ ጠሊለ አያነ ዱኞ። <verse eid="ACT 2:33"/><verse number="34-35" style="v" sid="ACT 2:34-35"/>ደዉድ ሰማሃ ኦሮዕዮበአ፤ ጠዉ እኮጎሬ እስ</para>
  <para style="q1" vid="ACT 2:34-35">« ‹ቀርቹ ቀርቺሃኤ</para>
  <para style="q2" vid="ACT 2:34-35">ባለጋረክ ሎካችክ ዎሮን አኦተ ኢለ</para>
  <para style="q2" vid="ACT 2:34-35">መኬንከኤ አፉዕል› » ይ ጠወዕዮኡ።<note caller="-" style="x"><char style="xo" closed="false">2፥34-35 </char><char style="xt" closed="false"><ref loc="PSA 110:1">መዝ. 110፥1</ref>።</char></note><verse eid="ACT 2:34-35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36"/>«ቴሱ መገኑ ከ አዕኑ ሰቀልቴንተ ኢሰ ቀርቹለከ ቡረሞኢሃ አዕዮስገ እስራኤል አድ ኡመቱ ጉዕሙንኩ ጠረኝሽ ደጉን» ዬእ።<verse eid="ACT 2:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37"/>እሰን ህካን ሞጮጭቶ ወክት ቀልቡሰ ሻዞን ዊማን ጴጥሮሴለከ ዎሉ ሶቀማኑተ «ኒ አመኦሶ! መ አዕኑ?» ይት ጠዕምቶኡ።<verse eid="ACT 2:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38"/>ጴጥሮስን «ጩቡክዕኔ አጉረሞተ ጩብክዕኔ ቶበቴን መት-መቱክዕኔ መሲህ ኢስ ሱዕሚን ጠመቀሜ፤ መገን ኣስቱተ እኮ ጠሊለ አያነ ቶጌነንተ። <verse eid="ACT 2:38"/><verse number="39" style="v" sid="ACT 2:39"/>ተብሴስ ላገት ክዕኔሃትለከ እላተክዕኔት፤ ህትን መገኑ ቄዕራሺች ገኤሀኑኡታት» ዬሰ።<verse eid="ACT 2:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40"/>ጴጥሮስን ዎሉ ልግብ ጠወ መሰከረን «ከን ሾከ ክልቀቲች ገዉክዕኔ ጡምሼ» የን ሸዦሰ። <verse eid="ACT 2:40"/><verse number="41" style="v" sid="ACT 2:41"/>ህካን እኮቤቺሃ ላገስ ቶጎእሩ ጠመቀንቶኡ፤ ህከ በር ሰሱ ኩምተ እካ መኑ እሳን ሜጡበ እኮ። <verse eid="ACT 2:41"/><verse number="42" style="v" sid="ACT 2:42"/>እሰን ሶቀማኑት ተማርስታኢሃ ሞጮጭተን ሜጡበ ሄአን እቸተ ሜጡበ እተንለከ ዱአ አተን ጠረኝታኢት እቅ።<verse eid="ACT 2:42"/></para>
  <para style="s1">አመዕናኑት ሜጡበ ሄኡሰ</para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43"/>ህከ ወክት አሳበ አንጋን ልግቡ አጅበተለከ መላት እካቤቺሃ መኑ ጉዕሙንኩ ዋጄእ። <verse eid="ACT 2:43"/><verse number="44" style="v" sid="ACT 2:44"/>አመዕናኑት ጉዕሙንኩ ዮሰርቹ ጉዕመንከ ሜጡበ አት ሄኣኢት እቅ።<note caller="-" style="x"><char style="xo" closed="false">2፥44 </char><char style="xt" closed="false"><ref loc="ACT 4:32-35">ሶቀ. 4፥32-35</ref>።</char></note> <verse eid="ACT 2:44"/><verse number="45" style="v" sid="ACT 2:45"/>ህትን ኡለሰለከ ዮሳሃ ጉዕመንከ ህርተን ብረሰ መት-መትንከ ሀስሰኖስ ጌሰ ቤካኢት እቅ። <verse eid="ACT 2:45"/><verse number="46" style="v" sid="ACT 2:46"/>ጉዕመንከ በር መቶ ቀልቢን መገን ምኔን ጭም ይተን መት-መትሰ ምናን እቴኖሃ ሙንዲኖንለከ ጡመ ቀልቢን ሜጡበ እታኢት እቅ። <verse eid="ACT 2:46"/><verse number="47" style="v" sid="ACT 2:47"/>እሰን መገኑ ገለትጭታኢት እቅ፤ ህትን ጉዕሙንኩ ከበጀኖሳት እቅ፤ ቀርቹንኩ በሬን በሬን አመዕንት ጡምታ መነሃ በርገኖሳት እቅ።<verse eid="ACT 2:47"/></para>
  <chapter eid="ACT 2"/>
  <chapter number="3" style="c" sid="ACT 3"/>
  <para style="s1">ናፉ መንቹ ፈዩስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1"/>መቱ በር ጴጥሮስለከ ያህይ ዱአ አኤኖ ወክቴን ዱእ ምኒ መርታኢት እቅ፤ ሁኩንን ሆንሶሃ ሰኣት እቅ። <verse eid="ACT 3:1"/><verse number="2" style="v" sid="ACT 3:2"/>ህከኔ «ምልካምተ» ዬኖ ዱእ ምኒ ኡሮን መኑ እጅ ጉዕመንከ በር ኤበኖ መቱ መንቹ ሄዕዮ እቅ፤ እስን አመስ ጎደቢች ኬሽ ናፈ እኮቤቺሃ አፉሼኖሲሁ ዱእ ምኒ ኣገኖ መኒች ሰደቀተ ኡጮታት እቅ። <verse eid="ACT 3:2"/><verse number="3" style="v" sid="ACT 3:3"/>እስን ጴጥሮስለከ ያህይ ዱእ ምኒ ኣጎተ አሜቱሰ ደጎ ወክት ሰደቀተ ኣቶስተ ኡጬሰ። <verse eid="ACT 3:3"/><verse number="4" style="v" sid="ACT 3:4"/>ጴጥሮስ ያህዪንን ሜጡበ ህከ መንቹ ቱክ ይ ለዕይ «ኒ አደ ለእ» ዬእ። <verse eid="ACT 3:4"/><verse number="5" style="v" sid="ACT 3:5"/>እስን ሰደቀተ ኣታሲሃ አጉጃንስ እሰበ ለዕዮ። <verse eid="ACT 3:5"/><verse number="6" style="v" sid="ACT 3:6"/>ጠዉ እኮጎሬ ጴጥሮስ «ብሩለከ ዎርቁ ዮኤበአ፤ እኮጎሬ ኤሳሃ ዮኤሃ ኣሳንኬ፤ ሁኩንን ናዝሬት መሲህ ኢስ ሱዕሚን ኬእ ሃም!» ዬስ። <verse eid="ACT 3:6"/><verse number="7" style="v" sid="ACT 3:7"/>እስን መኬስ አንገተ አፍ ኬሾስ፤ ህከ ወክት ሎከስለከ ሴዝ ምቁስ ጠረኜእ። <verse eid="ACT 3:7"/><verse number="8" style="v" sid="ACT 3:8"/>ሾት ይ ኡሬእ፤ ህትን ሃሙንከ ጀመሮ፤ ህትን ሃመን፥ ቱጵ-ቱጵ የንለከ መገኑ ገለትጨን እሳን ሜጡበ ዱእ ምኒ ኣጎ። <verse eid="ACT 3:8"/><verse number="9" style="v" sid="ACT 3:9"/>እስን መገኒሃ ገለት ኣሰንለከ ሃመን መኑ ጉዕሙንኩ ለዕዮስ። <verse eid="ACT 3:9"/><verse number="10" style="v" sid="ACT 3:10"/>ህትን «ምልካምተ ኡሩተ» ዬኖ ዱእ ምኒ ኡሮን አፉዕል ሰደቀተ ኡጨኖሃ እሁስ ደጎቤቺሃ እሲን እኮ ጠዊች ኬዕይ መኑ አበ አጀብሲጬእ።<verse eid="ACT 3:10"/></para>
  <para style="s1">ጴጥሮስ መገን ምኔን ጠወዕዮገ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11"/>ሁኩ ፈዬ መንቹንኩ ጴጥሮሴችለከ ያህዪች መለዕለሙ ግብ አንገሰ አፍ ሄዕዮገን መኑ ጉዕሙንኩ ሜጡበ እክ አጀብሲጨን እሰቤቹ ደጉደን «ሱለይማን ሃመኖ ዎቃሃ» ዬኖቤቹ አሜቶኡ። <verse eid="ACT 3:11"/><verse number="12" style="v" sid="ACT 3:12"/>ጴጥሮስ ህካን ለዕይ መኒሃ «እስራኤል መነ! ከኒን ሚሃ አጀብሲጭቴነንታት? ነኡ ህትን ገይኔ ዎልቃን ህከረንገ መገኑ ዋጅንከኔ ኩ መንቹ ሃመኖገ አዕኖምሀንገ አቴን ሚሃት ቱክ ይቴን ለኤነንታት? <verse eid="ACT 3:12"/><verse number="13" style="v" sid="ACT 3:13"/>እብራሂም፥ ኢሳቅለከ ያቁብ አናከኔ ሰገዳ መገኑ አዕኑ ህግሴን ኣቴንተለከ ጵላጦስ ሂሮስተ ሀሾ ወክት ጵላጦሴ ብሬን ለገኤንተ ቤቱስ ኢሰ ከበጄስ።<note caller="-" style="x"><char style="xo" closed="false">3፥13 </char><char style="xt" closed="false"><ref loc="EXO 3:15">ፉል. 3፥15</ref>።</char></note> <verse eid="ACT 3:13"/><verse number="14" style="v" sid="ACT 3:14"/>ጠዉ እኮጎሬ አዕኑ ጠሊለለከ ፈየ እኮሃ ግቤን መነ ሼ መንቹ ሂረሞህዕኔተ ኡጭቴንተ።<note caller="-" style="x"><char style="xo" closed="false">3፥14 </char><char style="xt" closed="false"><ref loc="MAT 27:15-23">ማቶ. 27፥15-23</ref>፤ <ref loc="MRK 15:6-14">ማር. 15፥6-14</ref>፤ <ref loc="LUK 23:13-23">ሉቃ. 23፥13-23</ref>፤ <ref loc="JHN 19:12-15">ያህ. 19፥12-15</ref>።</char></note> <verse eid="ACT 3:14"/><verse number="15" style="v" sid="ACT 3:15"/>ሄኡ ኣሰኖሃ ሽቴንተ፤ እኮጎሬ እሱ መገኑ ሬሆች ኬሾስ፤ ህከን ጠዊተኔሃ ነኡ ምስክርሃን። <verse eid="ACT 3:15"/><verse number="16" style="v" sid="ACT 3:16"/>ኩ ለኤነንተለከ ደጌነንተ መንቹ ፈይ ጠረኜኢሁ ኢስ ሱዕሚን ደገሞ አመዕነቲኒት፤ ኢስ ሱዕሚን አመዕኒከስ ጉዕሚክዕኔ ብሬንን ዊመ ፈይመተ ደኤእ።<verse eid="ACT 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17"/>«ቴሁ አመኤ ኦሶ! አዕኑ ኢስ አሌን አቴንተ ጠዉ ሹመክዕኔገን ደጉ ሆጊን አቴንተገ ደጋም። <verse eid="ACT 3:17"/><verse number="18" style="v" sid="ACT 3:18"/>ጠዉ እኮጎሬ መገኑ ሄጭ ነብያኖ አፎን ‹መሲሁ ኦርሸተ ቶገኖ› ዬ ላገት ከን ሃሊን ዊንታገ አዕዮ። <verse eid="ACT 3:18"/><verse number="19-20" style="v" sid="ACT 3:19-20"/>ቴሱ ቀርቺች ሃዕሮ ወገሬት ዘማኑ አሜቶተ ዎዕናንከ መጠሮ መሲሁ ሶሆተለከ ጩብክዕኔ መገኑ አጉሮተ ቶበቴን ፈንቀሌ። <verse eid="ACT 3:19-20"/><verse number="21" style="v" sid="ACT 3:21"/>መገኑ ወዕኔችን ኬሽ ጠሊላኖ ነብያኖስ አፎን ጠወዕዮገን ኣዱንያ አሉ ጉዕሙንኩ መኮተ ኢለ ኢስ ሰማን ዱንኩ ሀስሰኖስ። <verse eid="ACT 3:21"/><verse number="22" style="v" sid="ACT 3:22"/>ሙስ ‹ቀርቹ መገኑ ኤሳሃ ኬሾሀንገን አመክዕኔ ኦሶች ነብዬቹ ኬሰኖህዕኔ፤ እስ ኩለኖህዕኔሃ ጉዕመንከ ሞጮጭዬ።<note caller="-" style="x"><char style="xo" closed="false">3፥22 </char><char style="xt" closed="false"><ref loc="DEU 18:15">ዘዳ. 18፥15</ref>፤ <ref loc="DEU 18">18</ref>።</char></note> <verse eid="ACT 3:22"/><verse number="23" style="v" sid="ACT 3:23"/>ሁኩ ነብዬቹ የኖሃ ሞጮጩ ግበኖሁ ጉዕሙንኩ መኒች አደ እክ በአኖ› ዬእ።<note caller="-" style="x"><char style="xo" closed="false">3፥23 </char><char style="xt" closed="false"><ref loc="DEU 18:19">ዘዳ. 18፥19</ref>።</char></note> <verse eid="ACT 3:23"/><verse number="24" style="v" sid="ACT 3:24"/>ህትን ሳሜሊች ኬሽ እሲች ኤተሮን አሜቶ ነብያኑት ጉዕሙንኩ ከን ወክትተኔሃ ጠወኦኡ። <verse eid="ACT 3:24"/><verse number="25" style="v" sid="ACT 3:25"/>አዕኑ ነብያኖተ ረገኣኑታን፤ ህትን መገኑ እብራሂሚሃ ‹ኣዱንያ አል መኑ ጉዕሙንኩ ኪ ዘሬን ማሰአመኖ› ይ ወዕኔ አናካተክዕኔ ሜጡበ ኣጎ ወኣድ ላገተ ረገኤነንተረ።<note caller="-" style="x"><char style="xo" closed="false">3፥25 </char><char style="xt" closed="false"><ref loc="GEN 22:18">ክል. 22፥18</ref>።</char></note> <verse eid="ACT 3:25"/><verse number="26" style="v" sid="ACT 3:26"/>ህካን እኮቤቺሃ መገኑ ቤቱስ ኬሽ ሶኮሁ ሄጭ ክዕኔሃት እቅ፤ ህካን አዕዮሁ መት-መቱክዕኔ ሂለ ዎቄች ፈንቀልቴናን ማሰኦህዕኔታት» ዬእ።<verse eid="ACT 3:26"/></para>
  <chapter eid="ACT 3"/>
  <chapter number="4" style="c" sid="ACT 4"/>
  <para style="s1">ጴጥሮስለከ ያህይ አይሁድ ኦገት ባሊቀበ ሆንጠሁሰ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1"/>ጴጥሮስለከ ያህይ ኡመቲሃ ጠወአንን ቂሰትለከ ዱእ ምኒ ዘበኛኖ ሀለቅቹ ህትን ሰዱቃውት እሰቤቹ አሜት<note caller="+" style="f"><char style="fqa" closed="false">ቂሰ፦ </char><char style="ft" closed="false">የኖሁ መት-መቱ ሉህ ክታበት «ቂስ አዎንሳኑተ» ይታአ።</char></note> <verse eid="ACT 4:1"/><verse number="2" style="v" sid="ACT 4:2"/>ለሙንኩ አሳበት ኢስ ሬሆች ኬኡስ ኡመቲሃ ተማርሲንከሰለከ ህከኒንን ሬሆች ኬኡ ኩልቶቤቺሃ ኡሙዕርቶኡ። <verse eid="ACT 4:2"/><verse number="3" style="v" sid="ACT 4:3"/>ህካን እኮቤቺሃ አፍሰ ኡለት ሀዎርቶቤቺሃ ሶዞተ ኢለ ኡሱር ምኔን አገርታገ አቶሰ። <verse eid="ACT 4:3"/><verse number="4" style="v" sid="ACT 4:4"/>ጠዉ እኮጎሬ ላገሰ ሞጮጭቶ መኒች ልግቡሰ አመዕንቶኡ፤ አመዕንቶ ጎን ዎሊንሹ ኦንቶ ኩሜ ጌሰ በተዕዮ።<verse eid="ACT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5"/>ለንክስ በር ይሁድ ዳኛኑት፥ ባልቀትለከ ሕግ አስተማረት ዬሩሳሌም ከተማን ጭምይቶኡ። <verse eid="ACT 4:5"/><verse number="6" style="v" sid="ACT 4:6"/>ህከን ጭምይቶ መን በላን ሎሩ ቂስቹ ሃነ፥ ቀያፍ፥ ያህይ፥ እስክንድሮስለከ ሎረ ቂስች አበሮሱ ጉዕሙንኩሰ ሄኦኡ። <verse eid="ACT 4:6"/><verse number="7" style="v" sid="ACT 4:7"/>እሰን ጴጥርሴለከ ያህይ በላንከሰ ኡርስ «አዕኑ ከ ጠወ መ ወልቃን ህከረንገ አዬ ሱዕሚን አቴነንታት?» ይት ጠዕምቶኡ። <figure style="fig" alt="Part of the Sanhedrin council in session" file="LB00284B.tif" size="span" ref="4፥5">አይሁዱ ኦገታገ</figure><verse eid="ACT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8"/>ህከ ወክት ጴጥሮስ ጠሊለ አያኒን ዊም «አዕኑ ኡመት ገሻኑትለከ ባልቀት ሞጮጭዬ። <verse eid="ACT 4:8"/><verse number="9" style="v" sid="ACT 4:9"/>ኔሳሃ ከበር ጠዕሜኖኔሁ መቶ ናፎ መንቺሃ አኤመስ ጡመ ሆጎተኔሃለከ ኩ መንቹ ሀት እክ ፈዩሲት። <verse eid="ACT 4:9"/><verse number="10" style="v" sid="ACT 4:10"/>ኩ መንቹ ፈይ ብሬንከክዕኔ ኡሬኢሁ አዕኑ ሰቀልቴንተለከ መገኑንገ ሬሆች ኬሾ ናዝሬት መሲህ ኢስ ሱዕሚን እሁስ ክዕኔሃ ጉዕሚንከክዕኔለከ እስራኤል ኡመቲሃ ጉዕሚንከ ደገሞሃ እሁን። <verse eid="ACT 4:10"/><verse number="11" style="v" sid="ACT 4:11"/>አዕኑ ግምበ እጃርቴነንተሩ ህንቄን ኡጅቴንተ ክኑ ግምበስ ሙረበ ቡዕል ክኑ እኮ።<note caller="-" style="x"><char style="xo" closed="false">4፥11 </char><char style="xt" closed="false"><ref loc="PSA 118:22">መዝ. 118፥22</ref>።</char></note> <verse eid="ACT 4:11"/><verse number="12" style="v" sid="ACT 4:12"/>ህካን እኮቤቺሃ ጡሙ ዎሎን አዬኒ ዮበአ፤ ጡምኖተ መን በላን ኡለ አሌን ጉዕማንን ዎሉ ኣሰሞ ሱዕሙ ዮበአ» ይቶሰ።<verse eid="ACT 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13"/>ጴጥሮስለከ ያህይ መለልት ጠወኣገ ኦገት መኑ ለኦ ወክት ተማርቶበእ ገወ መነ እሁሰ ደግ አጀብሲጭቶኡ፤ እሰ ኢሲን ሜጡበ ሄኦእረ እሁሰ ደጎኡ። <verse eid="ACT 4:13"/><verse number="14" style="v" sid="ACT 4:14"/>ሁኩ ፈዬ መንቹ እሳን ሜጡበ ኡሬኢሃ ለእ እሰ አሌን ይታኢሃ ሆጎኡ። <verse eid="ACT 4:14"/><verse number="15" style="v" sid="ACT 4:15"/>ጠዉ እኮጎሬ ህከን ኦገት በሊች ፉልታገ አት ገገዉንኩሰን <verse eid="ACT 4:15"/><verse number="16" style="v" sid="ACT 4:16"/>«ከ መነ መ አዕኑ? ሎረ መላት እሰ አንጋን አሰንታኢሃ ዬሩሳሌም መኑ ሄኣ ጉዕመ ቤቾንን ደገሞቤቺሃ ካንዶተ አታልናምበአ። <verse eid="ACT 4:16"/><verse number="17" style="v" sid="ACT 4:17"/>ጠዉ እኮጎሬ ኡመት በላን አልባዕለን መረኖበእገ ከኒች ኤተሮን ከን ሱዕሚን አዬሃ ጠወኣበእገ ጠረኝንስ ዋጅሲንሶ» ይት አማዕለንቶኡ።<verse eid="ACT 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18"/>ህከኒች ኤተሮን እሰተ ገእት ኢስ ሱዕሚን ሆሮን ጠወኣበእገለከ ተማርስታበእገ አዘዞኡ። <verse eid="ACT 4:18"/><verse number="19" style="v" sid="ACT 4:19"/>ጠዉ እኮጎሬ ጴጥሮስለከ ያህይ ፈንቀሽት «መገን ትዛዝ ቶጉ ህከረንገ ክዕኔ ትዛዝ ቶጉ መገን አኔን ቆሀኖ እኮጎሬ ህንዴ አዕኑ ፈረጄ። <verse eid="ACT 4:19"/><verse number="20" style="v" sid="ACT 4:20"/>ነኡ ሞጮጭኖሚሃለከ ለዕኖሚሃ ጠወኡ አጉሩ አታልናምበአ» ይቶሰ። <verse eid="ACT 4:20"/><verse number="21" style="v" sid="ACT 4:21"/>እሰን ጴጥሮሴለከ ያህይ ቀጠእሲሰኖ ጠወ አሌሰ ሆጎቤቺሃ መነ ዋጅት ለንኪሃ ዋጅሲስ ገፈርቶሰ፤ መሰንትስ መኑ ጉዕሙንኩ እኮ ጠውተኔሃ መገኑ ገለትጭታኢት እቅ። <verse eid="ACT 4:21"/><verse number="22" style="v" sid="ACT 4:22"/>ከን አጀብሲሰኖ ዎቄን ፈዬ መንቹ እለሞች ሸይሎ ዘማኒች በተዕዮስ እቅ።<verse eid="ACT 4:22"/></para>
  <para style="s1">አሳበትለከ አመዕናኑት ሸረንቶ ወክት አቶ ዱአ</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23"/>ጴጥሮስለከ ያህይ ሂረንቶች ኤተሮን ጃለሰቤቹ መርት ቂስ አዎንሳኑትለከ ባልቁ ይቶሰ ጠወ ጉዕመንከ ኩልቶሰ። <verse eid="ACT 4:23"/><verse number="24" style="v" sid="ACT 4:24"/>እሰን ህከ ጠወ ሞጮጭቶ ወክት ቀልብሰ ሜጡ አት ላገሰ መገን ቤቹ ኬስ «ሰማሃ፥ ኡለተ፥ ባረለከ ኣዜንከስ ዮእረ ጉዕመንከ ከለቆንት ቀርቾ መገኖ!<note caller="-" style="x"><char style="xo" closed="false">4፥24 </char><char style="xt" closed="false"><ref loc="EXO 20:11">ፉል. 20፥11</ref>፤ <ref loc="NEH 9:6">ነህ. 9፥6</ref>፤ <ref loc="PSA 146:6">መዝ. 146፥6</ref>።</char></note> <verse eid="ACT 4:24"/><verse number="25" style="v" sid="ACT 4:25"/>ጠሊለ አያኒን ካዲንቾንተክ አናኔ ደዉዴ አፎን</para>
  <para style="q1" vid="ACT 4:25">« ‹መገኑ ደግቡ መኑ ሚሃ ኡሙዕሬእ?</para>
  <para style="q2" vid="ACT 4:25">መኑ ሚሃ ደግለልበ ጠወ አቶተ ሰውይቶኡ?<verse eid="ACT 4:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26"/>ኡለ አል ዎመት ኬእ</para>
  <para style="q2" vid="ACT 4:26">ህትን ገሻኑት ሜጡበ ጭምይት</para>
  <para style="q2" vid="ACT 4:26">ቀርችለከ መሲህ አሌን ኬኦኡ› ይት ጠወኦንት መገኑ አቴት።<note caller="-" style="x"><char style="xo" closed="false">4፥26 </char><char style="xt" closed="false"><ref loc="PSA 2:1-2">መዝ. 2፥1-2</ref>።</char></note><verse eid="ACT 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 4:27"/>«ሀንቅንከ ዎሙ ሄሮዲስለከ ጳንጦስ ባድ ጵላጦስ፥ አይሁደ እህበ መኒንለከ እስራኤል መኒን ሜጡበ ከን ከተማን ጭምይት መሲሁ ኣቶንት ጠሊለ ካዲንቾንተክ ኢስ አሌን ኬኦኡ።<note caller="-" style="x"><char style="xo" closed="false">4፥27 </char><char style="xt" closed="false"><ref loc="MAT 27:1-2">ማቶ. 27፥1-2</ref>፤ <ref loc="MRK 15:1">ማር. 15፥1</ref>፤ <ref loc="LUK 23:1">ሉቃ. 23፥1</ref>፤ <ref loc="LUK 7:11">7፥11</ref>፤ <ref loc="JHN 18:28-29">ያህ. 18፥28-29</ref>።</char></note> <verse eid="ACT 4:27"/><verse number="28" style="v" sid="ACT 4:28"/>ህት እኮሁ አት ሄጭት ገይክ ዎልቃንለከ ሃሽኣቶን ሰውይቶንቲሃ አቶታት፤ <verse eid="ACT 4:28"/><verse number="29" style="v" sid="ACT 4:29"/>ህትን ቀርቾ! ፎከሩሰ ለእ፤ ካዲመክ ላገክ ዋጅቱዕናን መለልት ጠወኣገ አእሰ፤ <verse eid="ACT 4:29"/><verse number="30" style="v" sid="ACT 4:30"/>ጠሊለ ቤትክ ኢስ ሱዕሚን ጥዘናመት ፈይቶተ፥ አጅበተለከ አጀብሲሰኖ ጠዉ አሰሞተ አንገክ ሂር» ይተን ዱአ አቶኡ።<verse eid="ACT 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31"/>እሰን ዱአ አቶች ኤተሮን ጭምይቶ ቤቹ ሌንቄቄእ፤ ጉዕሙንኩሰ መገን አያኒን ዊንቶኡ፤ መገን ላገተ ዋጅቱዕናን መለልት ጠወኦኡ።<verse eid="ACT 4:31"/></para>
  <para style="s1">ዎዕኔ አመዕናኖ ሄእተኔሃ</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32"/>መገን መኑ ጉዕሙንኩ መቶ ቀልብንለከ ሰውቲን ሄኦኡ፤ እኮስ መንቹሁ «ኩን ኢሃን» የኖርቹ ዮበአ እቅ፤ በላንከሰ ጉዕሙርቹንኩ ቅጤሳሃ እቅ፤<note caller="-" style="x"><char style="xo" closed="false">4፥32 </char><char style="xt" closed="false"><ref loc="ACT 2:44-45">ሶቀ. 2፥44-45</ref>።</char></note> <verse eid="ACT 4:32"/><verse number="33" style="v" sid="ACT 4:33"/>አሳበት ቀርቹ ኢስ ሬሆች ኬኡስ ሎረ ወልቃን መሰከርታኢት እቅ፤ ጉዕምሰ አሌኒን ሎረ መገን አያኑ ሄዕዮ እቅ። <verse eid="ACT 4:33"/><verse number="34" style="v" sid="ACT 4:34"/>እሰ በላን ኦርጨቀሞሁ መቱሁ ዮበአ፤ መሰንትስ ኡለት ዮሲሁ ህከረንገ ምኑ ዮሲሁ ጉዕሙንኩ ህረን ብረ ኤበኖት እቅ። <verse eid="ACT 4:34"/><verse number="35" style="v" sid="ACT 4:35"/>ህከ ብረ ኤበን ሶቀማኖ ብሬን አፉሽተን አዬሁ ሀስሰኖስ ጌሰ ቤሄነን ኣሴኖሲት እቅ።<verse eid="ACT 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36"/>«ቆጵሮሰ» ዬኖ ባድ መቱ መንቹ ሌዌ አዲሁ «ዩሱፈ» ዬኖሁ ሄዕዮ እቅ፤ እሱንከ ሶቀማኑት «በርናባሴ» ይት ገእታስ እቅ። ህት ዩሁ «ቦረሸተ ከመኖሃ» ዩሃን። <verse eid="ACT 4:36"/><verse number="37" style="v" sid="ACT 4:37"/>ሁኩ መንቹንኩ ኡለስ ህር ብረስ ሶቀማኖተ ቶግስሾሰ። <figure style="fig" alt="Jewish and Roman coins" file="HK00163B.tif" size="span" ref="4፥35">አይሁድለከ ሮማውያን ሰንትበ</figure><verse eid="ACT 4:37"/></para>
  <chapter eid="ACT 4"/>
  <chapter number="5" style="c" sid="ACT 5"/>
  <para style="s1">ሀናንየለከ ሰጲረተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1"/>መቱ «ሀናንየ» ዬኖ መንቹ «ሰጲረ» ዬኖ መንቾንከስን ሜጡበ ኡለተ ህሮ። <verse eid="ACT 5:1"/><verse number="2" style="v" sid="ACT 5:2"/>ጠዉ እኮጎሬ ምንስ መንቹስ ደገን ኡለስ ህሮ ብሪች መቱ ጌሰ ፌሽ ፈቆስ ጌሰ ኤብ አሳባተ ቶግስሾሰ። <verse eid="ACT 5:2"/><verse number="3" style="v" sid="ACT 5:3"/>ጴጥሮስን «ሀናንየ! ጠሊለ አያን አሌን ክዝቦተለከ ኡለተ ህርቶንት ብሪች መቱ ጌሰ ፌሶተ ሼይጣኑ ቀልቤንከክ ሚሃ ኣጎ? <verse eid="ACT 5:3"/><verse number="4" style="v" sid="ACT 5:4"/>ህርቱዕነ ዎዕናሃ ኪሃበእንዶ? ህርቶንቲች ኤተሮኒሁ ብሩስ ኪሃበእንዶ? ከ ጠወ ሚሃ ቀልቤንከክ ሰውይት? አት ክዝቦንቲሁ መነ እሁዕነ መገኑሃት» ዬስ። <verse eid="ACT 5:4"/><verse number="5-6" style="v" sid="ACT 5:5-6"/>ሀናንየን ህከ ላገተ ሞጮጬ ወክት ኡብ ሬዮ፤ ዎደለት ኬእ ከፈንት እጅት ፉሽት ሞጎስ፤ ህከ ጠወ ሞጮጭቶእሩ ጉዕሙንኩ አበ ዋጅቶኡ።<verse eid="ACT 5:5-6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7"/>ሰሱ ሰኣት እሀኖ ወክቲች ኤተሮን እኮ ጠወ ደጉዕነ መንቹስ አሜት ኣጎኡ። <verse eid="ACT 5:7"/><verse number="8" style="v" sid="ACT 5:8"/>ጴጥሮስን እሴተ «ህንዴ ኩሌኤ! ኡለክዕኔ ህርቴንታሁ ከን ጌሰ ብርሃትንዶ?» ዬሴ፤ እሴን «ኤ! ከን ጌሲሃንት ህርኖሚሁ» ይቶኡ።<verse eid="ACT 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9"/>ጠዉ እኮጎሬ ጴጥሮስ «ቀርች ጠሊለ አያኒን ፌተንቶኖተ ሚሃ አማዕለንቴን? ምንክ መንቹ ሞጎ መኑ ኡሮን ዮኡ፤ ኬሳሁ ፉሽት ሞጋሄ» ዬሴ። <verse eid="ACT 5:9"/><verse number="10" style="v" sid="ACT 5:10"/>ወክትንከስ ሎከስ መዴን ኡብ ሬቶኡ፤ ዎደለት ኣጋ ወክት ሬቶኢሃ ለእ መስት ምንሴ መንች ሎድ መዴን ሞጎሴ። <verse eid="ACT 5:10"/><verse number="11" style="v" sid="ACT 5:11"/>ህካን እኮቤቺሃ አመዕናኑት ጉዕሙንኩለከ ህከ ጠወ ሞጮጬ መኑ ጉዕሙንኩ አበ ዋጄእ።<verse eid="ACT 5:11"/></para>
  <para style="s1">አሳበት አቶ አጀብሲሰኖ ጠወለከ አጅበተ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12"/>አሳበት ልግብ አጅበተለከ አጀብሲሰኖ ጠወ መን በላን አታኢት እቅ፤ ጉዕሙንኩ መቶ ቀልቢን እክ «ሱላይማን ሃመኖ ዎቃሃ» ዬኖቤቾን ጭምይቶኡ። <verse eid="ACT 5:12"/><verse number="13" style="v" sid="ACT 5:13"/>ዎሉ አዪሁ እሳን በርገሞተ መለሎበአ፤ እኮጎሬ መኑ ከበጀኖሳት እቅ። <verse eid="ACT 5:13"/><verse number="14" style="v" sid="ACT 5:14"/>እሁን ቤሉ ቀርቾን አመዕንቶ ጎንለከ ሜንት ዎሊንሹ ብሬች አበ በተአን መረኖ እቅ። <verse eid="ACT 5:14"/><verse number="15" style="v" sid="ACT 5:15"/>አሳበት አቶሀኒች ኬዕዮሀኒን ጴጥሮስ ህገን ዎሉ ፈቅ ሀሎስ መት-መቶ መን አሌን ኢሎተ መኑ ጥዘናመተ ዎቃ ፉሸን መዕነ አሌንለከ ዴስ አሌን ኦሲሳኢት እቅ። <verse eid="ACT 5:15"/><verse number="16" style="v" sid="ACT 5:16"/>ህትን ዬሩሳሌም አዝጋጌን ሄኦ ከተሚች ጥዘናመተለከ ዶሮረኖ ዱሩ አፋንሰ ኦርጨቀንታእረ ኤቤናን ልግቡ መኑ ጭምየኖት እቅ፤ እሰ ጉዕሙንኩሰ ፈይታኢት እቅ።<verse eid="ACT 5:16"/></para>
  <para style="s1">አሳበተ ሸሬመሰገ</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17"/>ጠዉ እኮጎሬ ሎሩ ቂስቹለከ እሲን ሜጡበ ሄኦ ሰዱቃዌ አድ መኑ ምቀኝት አሌሰ ኬኦኡ። <verse eid="ACT 5:17"/><verse number="18" style="v" sid="ACT 5:18"/>አሳበተ አፍ ኡመት ኡሱር ምኒ ኣግሶኡ። <verse eid="ACT 5:18"/><verse number="19-20" style="v" sid="ACT 5:19-20"/>ጠዉ እኮጎሬ ቀርች መላይኬቹ ኡሱር ምኒ ኡሩተ ሀዎሮን ፈኝ እሰተ አብል ፉሽ «መሬ፤ መገን ምኔን ኡርቴን ኡመቲሃ ከ ሄእ ላገተ ሆርንተ ኩሌ» ዬሰ። <verse eid="ACT 5:19-20"/><verse number="21" style="v" sid="ACT 5:21"/>ህከ ላገተ ሞጮጭቶ ወክት ሶዘ ሱጵተ መገን ምኔን ኣግ ተማርስታኢት እቅ፤ ጠው እኮጎሬ ሎሩ ቂስቹለከ እሲን ሜጡበ ሄኦእሩ አሜት ኦገት መነለከ አይሁድ ባሊቅ ጉዕመንከ ሜጡበ ጭምአት ኡሱረንቶእረ ኤቦተ ኡሱር ምኒ ሶኮኡ። <verse eid="ACT 5:21"/><verse number="22" style="v" sid="ACT 5:22"/>ሶሄመ ዘበኙ አሜት አሳበተ ኡሱር ምኔን ደጎሰበአ፤ እሰን ፈንቀልት አሜት <verse eid="ACT 5:22"/><verse number="23" style="v" sid="ACT 5:23"/>«ኡሱር ምኑ ጠረኝ ቆለፈሞቤቺሃ አገርታእሩ ኡሮ ብሬን ኡርቶኢሃ ደንጎም፤ ኡሱር ምኒ ኡሩተ ፈኖም ወክት ኣዜንከስ አዬሁ ደንጎምበአ» ይቶኡ። <verse eid="ACT 5:23"/><verse number="24" style="v" sid="ACT 5:24"/>ዱእ ምኒ ዘብ ሀለቅቹለከ ቂስ አዎንሳኑት ህካን ሞጮጭቶ ወክት «ኩን መርቾሃን?» ይት ጉረተ አጎሰ። <verse eid="ACT 5:24"/><verse number="25" style="v" sid="ACT 5:25"/>ህከ ወክት መቱ መንቹ አሜች «ሁኩዕኑን! አዕኑ ኡሱር ምኒ ኣግሴንተ መኑ መገን ምኔን ኡርት ኡመት ተማርስታኢት» ይ ኩሎሰ። <verse eid="ACT 5:25"/><verse number="26" style="v" sid="ACT 5:26"/>ህከ ወክት ዱእ ምኒ ዘበኝ ሀለቁለከ ካዲመስ መርት ኤቦኡ፤ ኤቦሳንኩ ዎልቃንበአ፤ ህካን አቶኢንኩ ኡመቱ ክኒን ቀሰኖሰበእገ ዋጅቲት።<verse eid="ACT 5:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27"/>ኤቦሳች ኤተሮን ኦገት ብሬን ኡርሶሰ፤ ሎሩ ቂስቹንኩ <verse eid="ACT 5:27"/><verse number="28" style="v" sid="ACT 5:28"/>«ኢስ ሱዕሚን ተማርስቴነንተበእገ ጠረኚንስ አዘንዝበእንዶ? ሁኩዕኑን ዬሩሳሌም ከተመ ጉዕመንከ ትምርቲንከክዕኔ ዊንሽቴንታአ፤ ህትን ከን መንች ቄግ ኒ አሌን ኤቦኖተ ሀሴነንታት» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">5፥28 </char><char style="xt" closed="false"><ref loc="MAT 27:25">ማቶ. 27፥25</ref>።</char></note><verse eid="ACT 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29"/>ጠዉ እኮጎሬ ጴጥሮስለከ ዎሉ አሳበት ፈንቀሽት «መን ትዛዝ ቶጊች መገን ትዛዝ ቶጉ ሀስሰኖኔ። <verse eid="ACT 5:29"/><verse number="30" style="v" sid="ACT 5:30"/>አዕኑ መስቀል አሌን ሰቀልቴን ሽቴንተ ኢሰ አናከኔ መገኑ ሬሆች ኬሾስ። <verse eid="ACT 5:30"/><verse number="31" style="v" sid="ACT 5:31"/>እሱንከ መገኑ እስራኤል መኑ ቶበታን ጩቡሰ አጉረሞተ ቡዕለለከ ጡምሳንቹ መኬስ አዲን ኬዕምኚን አፉዕለኖገ አዕዮስ። <verse eid="ACT 5:31"/><verse number="32" style="v" sid="ACT 5:32"/>ነኡ ከን ጠዊሃ ምስክርሃን፤ መገኒሃ አዘዘንታሀኑኡተ ጉዕሚንከ ኣሴሰ ጠሊሉ አያኑ ምስክርሃን» ይቶኡ።<verse eid="ACT 5:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33"/>እሰን ህካን ሞጮጭቶ ወክት አበ ኡሙዕረንት ሽቶሰተ ሀሶኡ። <verse eid="ACT 5:33"/><verse number="34" style="v" sid="ACT 5:34"/>ጠዉ እኮጎሬ መኑ ጉዕሙንኩ ከበጀሞለከ መገን ሕገ ተማርሰኖ «ገማልያሌ» ዬኖ ፈርሳውቹ ኦገት በላን ኡር አሳበተ ቀዎ ወክቲሃ አብል ፉሽታሰገ አዘዦ። <verse eid="ACT 5:34"/><verse number="35" style="v" sid="ACT 5:35"/>እስን «እስራኤል መነ! ከን መን አሌን መ አቴነንተጎሬ ገዉክዕኔ አገዕርዬ። <verse eid="ACT 5:35"/><verse number="36" style="v" sid="ACT 5:36"/>መሰንትስ ከኒች ዎዕናሃ ‹ቴዎዳሴ› ዬኖ መንቹ ‹አን ሎረሃን› የን ኬዕዮ እቅ፤ ሾሌ ጥቤ ጌሱ መኑ እሲን ሜጡ እኮኡ፤ ጠዉ እኮጎሬ እሱሃ ሼመስ፤ ህትን እሱ አዎንቶእሩ ጉዕሙንኩ ብንት ተሰ እክ በኦኡ። <verse eid="ACT 5:36"/><verse number="37" style="v" sid="ACT 5:37"/>ህከኒች ኤተሮን መነ ዎለኤመ ዘማን ገሊለ ዬኖ ቤቺች ‹ይሁደ› ዬኖ መንቹ ኬዕዮ፤ ልግብ መነ ሽፍጠ አዕይ አዎንታስገ አዕዮ፤ እሲሁ ሬዮ፤ አዎንታስሩንኩ ብንይቶኡ። <verse eid="ACT 5:37"/><verse number="38" style="v" sid="ACT 5:38"/>ህካን እኮቤቺሃ ቴሁ አን ያንክዕኔሁ ከ መነ ኡልቶኖቼ፤ ኩ ሰውቱ ህከረንገ ኩ ሆጉት መኒች እኮጎሬ በኣአ። <verse eid="ACT 5:38"/><verse number="39" style="v" sid="ACT 5:39"/>ጠዉ እኮጎሬ ኩ ጠዉ መገኒች እኮጎሬ ቤሶኖተ አታልቴነንተበአ፤ ህከኒችን በትሽ ኩ ጠዉ መገኒን ብተሙ እሀኖህዕኔበእገ» ዬሰ፤ ህከን መንች ሸዘነተ ሞጮጭቶኡ።<verse eid="ACT 5:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 5:40"/>አሳበንተ እሰበ ገእት ገረፎሳች ኤተሮን ኢስ ሱዕሚን ለንኪሃ ጠወኣበእገ አዘዝ ሂርቶሰ። <verse eid="ACT 5:40"/><verse number="41" style="v" sid="ACT 5:41"/>እሰን እስ ሱዕሚን ህንቀሙ ሀስሰኖሃ እኮቤቺሃ ኦገቲች ሙንደአን ፉልቶኡ። <verse eid="ACT 5:41"/><verse number="42" style="v" sid="ACT 5:42"/>ህካን እኮቤቺሃ በሬን በሬን መገን ምኔንለከ ምኔንከሰ ኢስ መሲሁ እሁስ ተማርሱለከ ተሽት ላገተ ተማርሱ ሆሮ አጉርቶበአ እቅ።<verse eid="ACT 5:42"/></para>
  <chapter eid="ACT 5"/>
  <chapter number="6" style="c" sid="ACT 6"/>
  <para style="s1">ለመሉ ሆጉተ አታ መኑ መጠረሙሰ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1"/>ህከ ወክት አመዕናኖ ዎሊንሹ በተአን መረን ግሪክ አፎሃ ጠወኣ አይሁዱ እሰ አድ ምንሰ አናከት ሬቶ ሜንቲሃ በሬን በሬን ኣሴኖሰ እቸተ ብዝ አኤን ኣሴማሰበአ ይት እብራይስጥ አፎ ጠወኣ አይሁድ አሌን ቁንቁቶኡ። <verse eid="ACT 6:1"/><verse number="2" style="v" sid="ACT 6:2"/>ህካን እኮቤቺሃ ቶነ ለሙንኩ አሳበት ጉዕመንከ አመዕናኑተ ጭምአት «እቴኖርቹ ቤንኮተ ይን መገን ላገተ ተማርሱ አጉሩ ሀስሰኖበአ። <verse eid="ACT 6:2"/><verse number="3" style="v" sid="ACT 6:3"/>ህካን እኮቤቺሃ አመኤ ኦሶ! መኑ ‹ጡማኖተ› የኖሰ ለመለ መነ ጠሊሉ አያኑ ዊሞሰረ በሊችክዕኔ ሀይቹ መነ መጠሬ፤ ተን ሆጎንተ ሹምነቱ ኣስናንሰ። <verse eid="ACT 6:3"/><verse number="4" style="v" sid="ACT 6:4"/>ጠዉ እኮጎሬ ነኡ ዱአ አኦንለከ ላገስ ተማርሶን ጠረኝናም» ይቶኡ።<verse eid="ACT 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5"/>ሁኩ ጠዉንኩ ጉዕመንከሰ ሙንዲሲሾ፤ ህከኒች ኤተሮን አመዕነቲንለከ ጠሊለ አያኒን ዊሞ እስጥፋኖሴ መጠርቶኡ፤ ህትን ፍልጶሴ፥ ጵሮኮሮሴ፥ ንቃሮነ፥ ጢሞነ፥ ጰርሜነለከ አይሁድ አመዕነት ቶጎ አንጾክ ባድ መንቹ ኒቆላዎሴ መጠርቶኡ። <verse eid="ACT 6:5"/><verse number="6" style="v" sid="ACT 6:6"/>እሰንተ አሳበ ብሬን ኡርሶሰ፤ አሳበንት ዱአ አቶች ኤተሮን አንገሰ አሌሰ ኡጅቶኡ። <verse eid="ACT 6:6"/><verse number="7" style="v" sid="ACT 6:7"/>ከን ሃሌን መገን ላገት አልባዕልተን መርቶኡ፤ ህትን ዬሩሳሌማን አመዕናኖ ዎሊንሹ በተአን መሮ፤ አይሁድ ቂሳች መት-መቱሰ ኢሳን አመዕንት ትምርቲንከስ ቶጎኡ።<verse eid="ACT 6:7"/></para>
  <para style="s1">እስጥፋኖሴ አፌመስገ</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8"/>እስጥፋኖስን ኣስቶንለከ ጠሊለ አያንስ ዎልቃን ዊም መን በላን አጀብሲሰኖ ጠወለከ አጅበተ አአኖት እቅ። <verse eid="ACT 6:8"/><verse number="9" style="v" sid="ACT 6:9"/>ህከ ወክት «ሰዎልድማን ፉሎ መን ጭምት ምኒ» ዬኖ አይሁድ ጭምት ምኒ መኑ፥ ቄሬንለከ አለክሰንድር ከተም መኑ፥ ክልቅይለከ እስይ ባድ መኑ እስጥፋኖሴን ኦዳኢት እቅ። <verse eid="ACT 6:9"/><verse number="10" style="v" sid="ACT 6:10"/>ጠዉ እኮጎሬ እስጥፋኖስ ጠወአን ሄዕዮ ሀይመተለከ ጠሊለ አያነ ኦዶተ አታልቶበአ። <verse eid="ACT 6:10"/><verse number="11" style="v" sid="ACT 6:11"/>ህከ ወክት «ኩ መንቹ ሙሲንለከ መገን አሌን ቦሮር ላገተ ጠወአን ሞጮጭኖም» ይታ መነ ማጥ ኬሶኡ። <verse eid="ACT 6:11"/><verse number="12" style="v" sid="ACT 6:12"/>ከን ሃሊን ኡመት፥ ባልቅለከ ሕግ አስተማረተ ኬሶኡ፤ እስጥፋኖሴቤቹ መርት ኣእት ኦገትቤቹ ሆንጠህሶስ። <verse eid="ACT 6:12"/><verse number="13" style="v" sid="ACT 6:13"/>እስ አሌን ክዝብ መሰከርታ መት-መት መናከተ ኤቦኡ፤ ሁኩ መናከንት «ኩ መንቹ ከን መገኒሃ አደ እኮ ቤቾንለከ መገን ሕግ አሌን ቦሮር ላገተ ጠወኡ ሆሮ አጉሮበአ። <verse eid="ACT 6:13"/><verse number="14" style="v" sid="ACT 6:14"/>‹ኩ ናዝሬት ኢስ ከ ዱእ ምኒ ድጀኖ፤ ሙስን ኣሴኔ ሴረ ዶረኖ› የን ሞጮጭኖም» ይታ ክዝብ ምስክር ኬሶኡ። <verse eid="ACT 6:14"/><verse number="15" style="v" sid="ACT 6:15"/>ህከ ወክት ኦገቴን አፉዕልቶእሩ ጉዕሙንኩ እስጥፋኖሴ ቱክ ይት ለአን ሚኔስ አዱ መላይከ ሚንተ አጉጅ ለሌሰ።<verse eid="ACT 6:15"/></para>
  <chapter eid="ACT 6"/>
  <chapter number="7" style="c" sid="ACT 7"/>
  <para style="s1">እስጥፋኖስ ጠወዕዮገ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1"/>ሎሩ ቂስቹ እስጥፋኖሴ «ኩ የመሞ ጠዉ ሀንቅሃንዶ?» ይ ጠዕሜስ።<verse eid="ACT 7:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2"/>እስጥፋኖስን «አመኤ ኦሱትለከ አናከኤ! አን ያሚሃ ሞጮጭዬ!፤ አኑኔ እብራሂም ካራን ባዶን ሄኦተ መሩዕነ ብርተ መስጴጦምያን ሄአን ኬዕምኝ መገኑ እሲሃ ለልኬዕይ <verse eid="ACT 7:2"/><verse number="3" style="v" sid="ACT 7:3"/>‹ባዲችክለከ እሊችክ አደ እክ ፉልት አን ለሊሳንኬ ባዱ ኦሮእ› ዬስ።<note caller="-" style="x"><char style="xo" closed="false">7፥3 </char><char style="xt" closed="false"><ref loc="GEN 12:1">ክል. 12፥1</ref>።</char></note> <verse eid="ACT 7:3"/><verse number="4" style="v" sid="ACT 7:4"/>ህከ ወክት ከላድ ባዲች ፉል ‹ካራነ› ዬኖቤቾን አፉዕሌእ፤ አኑስ ሬዮች ኤተሮን ህከንቤቺች ከበር አዕኑ ሄኤነንተ ከ ባዱ መገኑ ኤቦስ።<note caller="-" style="x"><char style="xo" closed="false">7፥4 </char><char style="xt" closed="false"><ref loc="GEN 11:31">ክል. 11፥31</ref>፤ <ref loc="GEN 12:4">12፥4</ref>።</char></note> <verse eid="ACT 7:4"/><verse number="5" style="v" sid="ACT 7:5"/>ከን ባዶን መት ብኩታ እሀኖ ጌስ ኡለት ርስተ አዕይ ኣስዮስበአ፤ እብራሂምሃ እለት ሄእበስጎሬ እሲሃለከ እሲች ኤተሮን ዘሬተስ ርስተ አዕይ ኣሶተ ላገተ ኣጎ።<note caller="-" style="x"><char style="xo" closed="false">7፥5 </char><char style="xt" closed="false"><ref loc="GEN 12:7">ክል. 12፥7</ref>፤ <ref loc="GEN 13:15">13፥15</ref>፤ <ref loc="GEN 15:18">15፥18</ref>፤ <ref loc="GEN 17:8">17፥8</ref>።</char></note> <verse eid="ACT 7:5"/><verse number="6" style="v" sid="ACT 7:6"/>መገኑ እብራሂም ዘርት መን ባዶን ቶቸንት ሄአን ሮስ አኤን ሾሌ ጥቤ ዘማኒሃ አብዳዴኖሰገ ኩሎስ።<note caller="-" style="x"><char style="xo" closed="false">7፥6-7 </char><char style="xt" closed="false"><ref loc="GEN 15:13-14">ክል. 15፥13-14</ref>።</char></note> <verse eid="ACT 7:6"/><verse number="7" style="v" sid="ACT 7:7"/>ህትን መገኑ ‹ህከ ዘርክ ሮስ አት ጠቅታ ኡመት አሌን አን ፈረዳም፤ ህከኒች ኤተሮን ህከን ባዲች ሰዎልድማን ፉሼሃን ከንቤቾን ኤሳሃ ሰገዳኤ› ዬእ።<note caller="-" style="x"><char style="xo" closed="false">7፥7 </char><char style="xt" closed="false"><ref loc="EXO 3:12">ፉል. 3፥12</ref>።</char></note> <verse eid="ACT 7:7"/><verse number="8" style="v" sid="ACT 7:8"/>ጡርከም ወኣድ ሴረ መላተ እሆተ ኣሴስ፤ እብራሂም ኢሳቀ እሎ ህዜትቅ በር ጡርከሞስ፤ ህትን ኢሳቅን ጩልስ ያቁበ ጡርከሞ፤ ያቁብን ደቦተ ወዕኔ አናከተ እኮ ቶነ ለሙንከ እለስ ጡርከሞ።<note caller="-" style="x"><char style="xo" closed="false">7፥8 </char><char style="xt" closed="false"><ref loc="GEN 17:10-14">ክል. 17፥10-14</ref>፤ <ref loc="GEN 21:2-4">21፥2-4</ref>፤ <ref loc="GEN 25:26">25፥26</ref>፤ <ref loc="GEN 29:31-35:18">29፥31—35፥18</ref>።</char></note><verse eid="ACT 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9"/>«ያቁብ ኦሱት አመሰ ቤቱ ዩሱፈ ምቀኝት ግብጽ ባዶን ሮስ እሆተ ህርቶስ፤ ጠዉ እኮጎሬ መገኑ እሲን ሜጡበ ሄዕዮ እቅ።<note caller="-" style="x"><char style="xo" closed="false">7፥9 </char><char style="xt" closed="false"><ref loc="GEN 37:11">ክል. 37፥11</ref>፤ <ref loc="GEN 28">28</ref>፤ <ref loc="GEN 39:2">39፥2</ref>፤ <ref loc="GEN 21">21</ref>።</char></note> <verse eid="ACT 7:9"/><verse number="10" style="v" sid="ACT 7:10"/>ህካን እኮቤቺሃ ኦሪሻችስ ጉዕሚችን ፉሽ ግብጽ ባድ ዎም ፍራኦን ብሬን ኬዕምኝለከ ሀይመተ ኣሴስ፤ ዎሙንኩ ግብጽ ባዶንለከ ምኔንከስ ሹምነቱ ኣሴስ።<note caller="-" style="x"><char style="xo" closed="false">7፥10 </char><char style="xt" closed="false"><ref loc="GEN 41:39-41">ክል. 41፥39-41</ref>።</char></note> <verse eid="ACT 7:10"/><verse number="11" style="v" sid="ACT 7:11"/>ህከ ወክት ግብጻንለከ ከነኣን ባዶን አቡ ጎሩለከ ኦሪሸት እኮኡ፤ ወዕኔ አናከኔን እቸተ ደእቶተ አታልቶበአ። <verse eid="ACT 7:11"/><verse number="12" style="v" sid="ACT 7:12"/>ጠዉ እኮጎሬ ያቁብ ግብጽ ባዶን ዉጠት ሄኡስ ሞጮጬ ወክት ወዕኔ ወክት አናከኔ ህከቤቹ ሶኮ። <verse eid="ACT 7:12"/><verse number="13" style="v" sid="ACT 7:13"/>ለንኪሃ ፈንቀልት ግብጽ ባዱ መርቶ ወክት ዩሱፍ ገዉስ አመስ ኦሶተ ለልሾ፤ እሉስን ግብጽ ዎምቤቾን ኤንኬዕነንቶኡ።<note caller="-" style="x"><char style="xo" closed="false">7፥13 </char><char style="xt" closed="false"><ref loc="GEN 45:1">ክል. 45፥1</ref>፤ <ref loc="GEN 16">16</ref>።</char></note> <verse eid="ACT 7:13"/><verse number="14" style="v" sid="ACT 7:14"/>ህከኒች ኤተሮን ዩሱፍ አነስ ያቁበለከ እሉስ ጉዕመንከ እስቤቹ ሶክ ኤብሲሾ፤ እሉስ ጉዕሙንኩ ለመላይኔ ኦንቶ መነ እቅ።<note caller="-" style="x"><char style="xo" closed="false">7፥14 </char><char style="xt" closed="false"><ref loc="GEN 45:9-10">ክል. 45፥9-10</ref>፤ <ref loc="GEN 17:18">17፥18</ref>፤ <ref loc="GEN 46:27">46፥27</ref>።</char></note> <verse eid="ACT 7:14"/><verse number="15" style="v" sid="ACT 7:15"/>ህካን እኮቤቺሃ ያቁብ ግብጽ ባዱ ኦሮዕዮ፤ እስለከ ወዕኔ አናከኔ ህከን ቤቾን ሬቶኡ።<note caller="-" style="x"><char style="xo" closed="false">7፥15 </char><char style="xt" closed="false"><ref loc="GEN 46:1-7">ክል. 46፥1-7</ref>፤ <ref loc="GEN 49:33">49፥33</ref>።</char></note> <verse eid="ACT 7:15"/><verse number="16" style="v" sid="ACT 7:16"/>ምቀስ ሴኬመ ዬኖቤቹ ፈንቀሽት መስት እብራሂም ሴኬም ከተማን ኤሞሬ ኦሶች ብሪንከስ ህዕሬ ሎዳን ሞጎኡ።<note caller="-" style="x"><char style="xo" closed="false">7፥16 </char><char style="xt" closed="false"><ref loc="GEN 23:3-16">ክል. 23፥3-16</ref>፤ <ref loc="GEN 33:19">33፥19</ref>፤ <ref loc="GEN 50:7-13">50፥7-13</ref>፤ <ref loc="JOS 24:32">ኢያ. 24፥32</ref>።</char></note><verse eid="ACT 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17"/>«ጠዉ እኮጎሬ መገኑ እብራሂሚሃ ኣሴ ተብሳሃ ዊንሸኖ ወክቱ ሆንጠካን ግብጽ ባዶን ኡመትኔ ዎሊንሹ በተአን ኦሮዕዮ። <verse eid="ACT 7:17"/><verse number="18" style="v" sid="ACT 7:18"/>ህካን እኮንኩ ዩሱፈ ደግቡ ዎሉ ዎሙ ግብጽ ባዶን ኬኦተ ኢላት።<note caller="-" style="x"><char style="xo" closed="false">7፥18 </char><char style="xt" closed="false"><ref loc="EXO 1:7-8">ፉል. 1፥7-8</ref>።</char></note> <verse eid="ACT 7:18"/><verse number="19" style="v" sid="ACT 7:19"/>ሃዕሮ ዎሙንኩ ኡመቲኔ አሌን ተንኮን ኬዕይ ወዕኔ አናከኔ አብዳዱ ጀመሮ፤ ሰብያኑተ አብል ፉሼን ቶቼናን ሬታገ ወዕኔ አናከኔ ግዳጅሾሰ።<note caller="-" style="x"><char style="xo" closed="false">7፥19 </char><char style="xt" closed="false"><ref loc="EXO 1:10-11">ፉል. 1፥10-11</ref>፤ <ref loc="EXO 22">22</ref>።</char></note> <verse eid="ACT 7:19"/><verse number="20" style="v" sid="ACT 7:20"/>ህከ ወክት ሙስ እለሞ፤ እስን መገን ብሬን ምልካሙሃ ጩል እቅ፤ አንስ ምኔን ሰሱ አገነ ነጴእ።<note caller="-" style="x"><char style="xo" closed="false">7፥20 </char><char style="xt" closed="false"><ref loc="EXO 2:2">ፉል. 2፥2</ref>።</char></note> <verse eid="ACT 7:20"/><verse number="21" style="v" sid="ACT 7:21"/>ምኒች ፉሽት አብሌን ቶችቶስ ወክት ፍራኦኔ ቤቱት ኬስ ቤትሴገ አት ነስቶስ።<note caller="-" style="x"><char style="xo" closed="false">7፥21 </char><char style="xt" closed="false"><ref loc="EXO 2:3-10">ፉል. 2፥3-10</ref>።</char></note> <verse eid="ACT 7:21"/><verse number="22" style="v" sid="ACT 7:22"/>ሙስ ግብጽ ባድ ሀይመተ ጉዕመንከ ተማሮ፤ እስን ጠወአኖ ላጋንለከ ሆጎንተስ ጠረኘ እኮ።<verse eid="ACT 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23"/>«ጠዉ እኮጎሬ ሙስ ሸይሉ ዘማን እኮስ ወክት አመስ ኦሱተ እስራኤል መነ ለኦተ ቀልቤንከስ ሰውዬእ።<note caller="-" style="x"><char style="xo" closed="false">7፥23 </char><char style="xt" closed="false"><ref loc="EXO 2:11-15">ፉል. 2፥11-15</ref>።</char></note> <verse eid="ACT 7:23"/><verse number="24" style="v" sid="ACT 7:24"/>እስ እሊች መቱስ ግብጽ ባድ መንቹ ሚዕረንስ ለዕይ ሀዕሌስ፤ ህከን ሚርተዕዮ መንቺሃ ሀዕል ግብጽ ባድ መንቹ ዎቀር ሽ ገዱተ ፉሎ። <verse eid="ACT 7:24"/><verse number="25" style="v" sid="ACT 7:25"/>ሙሲን አመስ ኦሱንት መገኑ እስ አዲን ዎዥ ፉሸኖሰገ አጥራመታኢሃ አጉጆስ እቅ፤ ጠዉ እኮጎሬ እሰ ህካን አጥራመቶበአ። <verse eid="ACT 7:25"/><verse number="26" style="v" sid="ACT 7:26"/>ለንክ በር እስራኤል ኦሶች ለሙ ብተንተን ለዕዮ፤ ሀራርሶተ ሄዕላች ‹ኮ መነ! አዕኑ አመተ ኦሱ፤ ሚሃ መት-መቲንከክዕኔ ብተንቴነንታት?› ዬሰ። <verse eid="ACT 7:26"/><verse number="27" style="v" sid="ACT 7:27"/>ሁኩ ጃለስ ዎቀረን ሄዕዮ መንቹንኩ ሙሰ ካጳ ሀንበል ‹ኒ አሌን ኬሳሃ ገሻንቹለከ ፈረዳንቹ እኮተ ዳኘ አዕዮሄሁ አዬት? <verse eid="ACT 7:27"/><verse number="28" style="v" sid="ACT 7:28"/>ቤሬተ ግብጽ ባድ መንቹ ሽቶንትገን ኤሳሁ ሽቶኤተ ሄዕላቶንትንዶ?› ዬስ። <verse eid="ACT 7:28"/><verse number="29" style="v" sid="ACT 7:29"/>ሙስን ህካን ሞጮጬ ወክት ግብጽ ባዲች ሁኝ ሚድያም ባዶን ሄዕዮ፤ ህከኔን ለም ለቤ እለተ እሎ።<note caller="-" style="x"><char style="xo" closed="false">7፥29 </char><char style="xt" closed="false"><ref loc="EXO 18:3-4">ፉል. 18፥3-4</ref>።</char></note><verse eid="ACT 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30"/>«ህከኔን ሙስ ሸይሉ ዘማን ሄዕዮች ኤተሮን መገን መላይኬቹ ሲና ዬኖ ቆተ ኡድማን ሀቅ ሽፎ በላን ጊረ ለበነ ኣዜን እሲሃ ለሌስ። <verse eid="ACT 7:30"/><verse number="31" style="v" sid="ACT 7:31"/>ሙስን ህካን ለዕዮ ወክት ለዕዮርቾን አጀብሲጬእ፤ እስን ለኦተ መድ ሆንጠኮ ወክት ቀርቾሃ መገን ላገት <verse eid="ACT 7:31"/><verse number="32" style="v" sid="ACT 7:32"/>‹አን ወዕኔ አናከክሃ መገኑ፤ አን እብራሂሚሃ፥ ኢሳቅለከ ያቁብሃ መገኑ› ይተን ሞጮጬእ፤ ሙስን አበ ዋጄእ፤ ለኦንተ መለሎበአ። <verse eid="ACT 7:32"/><verse number="33" style="v" sid="ACT 7:33"/>ህትን ‹አት ኡርቶንት ቤቹ ጠሊለ እኮቤቺሃ ሎካችክ ጫዕመተ ፉሽ። <verse eid="ACT 7:33"/><verse number="34" style="v" sid="ACT 7:34"/>ሀንቅንከ ግብጽ ባዶን ሄኦ ኡመትኤ ኦርሸተ ለዕይ ያርታኢንከ ሞጮጭ ነጠ ፉሾህዕኔተ አሜቾም፤ ቴሁ አት ከቤቹ አም፤ አን ኬሳሃ ግብጽ ባዱ ሶሃንኬ› ይታ መገን ላገት እስቤቹ አሜቶኡ።<note caller="-" style="x"><char style="xo" closed="false">7፥34 </char><char style="xt" closed="false"><ref loc="EXO 2:14">ፉል. 2፥14</ref>።</char></note><verse eid="ACT 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35"/>«እስራኤል ኡመቱ ሙሰ ‹ገሻንቹለከ ፈረዳንቹሃ እኮተ ዳኘ አዕዮሄሁ አዬት?› ይት ለገኦስ ህከ ሙሰ ህከን ሽፎ ኣዜን ለሌስ መላይኬች አዲን መገኑ ገሻንቹለከ ፌሳንቹ አዕይ ሶኮስ። <verse eid="ACT 7:35"/><verse number="36" style="v" sid="ACT 7:36"/>ሁኩ ሙስ ግብጽ ባዶንለከ ቢሸ ባራን ሸይሉ ዘማን ኡለ ኡድማን አጅበተለከ አጀብሲሰኖ ጠወ አአን ግብጽ ባዲች አዎንስ ፉሼሰ።<note caller="-" style="x"><char style="xo" closed="false">7፥36 </char><char style="xt" closed="false"><ref loc="EXO 7:5">ፉል. 7፥5</ref>፤ <ref loc="EXO 14:21">14፥21</ref>፤ <ref loc="NUM 14:33">ዘኁ. 14፥33</ref>።</char></note> <verse eid="ACT 7:36"/><verse number="37" style="v" sid="ACT 7:37"/>‹ቀርቹ መገኑክዕኔ ኤሳሃ ኬሾገን ህትን አመክዕኔ ኦሶ በሊች ነብዬቹ ኬሰኖህዕኔ› ይ እስራኤል ኦሶተ ጠወዕዮሁ ህከን ሙሳንት።<note caller="-" style="x"><char style="xo" closed="false">7፥37 </char><char style="xt" closed="false"><ref loc="DEU 8:15">ዘዳ. 8፥15</ref>፤ <ref loc="DEU 18">18</ref>።</char></note> <verse eid="ACT 7:37"/><verse number="38" style="v" sid="ACT 7:38"/>ኡለ ኡድማን ጭምዬ ኡመቲን ሜጡበ ሲና ቆተ አሌን ጠወዕዮ መላይኬቺንለከ ህትን አናካንተክዕኔ ሜጡበ ሄዕዮሁ እሶት፤ መገን ሄእ ላገንተ ኔሳሃ ኣሴኔሁ ህከን ሙሳት።<note caller="-" style="x"><char style="xo" closed="false">7፥38 </char><char style="xt" closed="false"><ref loc="EXO 19:1-20">ፉል. 19፥1-20</ref>፤ <ref loc="EXO 17">17</ref>፤ <ref loc="DEU 5:1-33">ዘዳ. 5፥1-33</ref>።</char></note><verse eid="ACT 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39"/>«ወዕኔ አናከኔ ግቦስ ቤሉ ትዛዝስ ቶጎበአ፤ ቀልቤንከሰን ግብጽ ባዱ ፈንቀልቶተ ሰውይቶኡ። <verse eid="ACT 7:39"/><verse number="40" style="v" sid="ACT 7:40"/>ሀሩነን ‹ኩ ኔሳሃ ግብጽ ባዲች አዎንስ ፉሼኔ ሙሲሃ ም እሌስጎሬ ደንጋምበእቤቺሃ ብሬን ሃንተን አዎንስታኔ ሽርክተ መክስኔ› ይቶስ።<note caller="-" style="x"><char style="xo" closed="false">7፥40 </char><char style="xt" closed="false"><ref loc="EXO 32:1">ፉል. 32፥1</ref>።</char></note> <verse eid="ACT 7:40"/><verse number="41" style="v" sid="ACT 7:41"/>ህከ ወክት ወዕየ አጉደኖ ሽርክተ መክስ ክትም ሆንጠህሶኡ፤ አንገሰ ሆጎንን ሙንደኦኡ።<note caller="-" style="x"><char style="xo" closed="false">7፥41 </char><char style="xt" closed="false"><ref loc="EXO 32:2-6">ፉል. 32፥2-6</ref>።</char></note> <verse eid="ACT 7:41"/><verse number="42" style="v" sid="ACT 7:42"/>ጠዉ እኮጎሬ መገኑ እሳች አደ እኮ፤ ሰሜ ቤዜተ መገኑ አት ዱአ አታገ ህግሽ ኣሴሰ፤ ሁኩንን ነብያካን</para>
  <para style="q1" vid="ACT 7:42">« ‹አዕኑ እስረኤል መነ!</para>
  <para style="q2" vid="ACT 7:42">ሸይሉ ዘማን ኡለ ኡድማን</para>
  <para style="q2" vid="ACT 7:42">ጎረጤመ ግዘለከ ክትም ሆንጠህሴነንተኤትንዶ?<verse eid="ACT 7:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43"/>ሰገዶኖስተ መክሴንተ ምስልለከ</para>
  <para style="q2" vid="ACT 7:43">እሰን ሞሎከ ዬኖ መገንክዕኔ ዱካነለከ</para>
  <para style="q2" vid="ACT 7:43">ሬፋነ ዬኖ ቤዜ ክዝብ ሽርኬ ምስለ</para>
  <para style="q1" vid="ACT 7:43">እጅቴን ሃንቴንተ፤</para>
  <para style="q1" vid="ACT 7:43">አን ባብሎነ ዬኖ ባዲች</para>
  <para style="q1" vid="ACT 7:43">ካጵ አደ ቄርሳንክዕኔ› የመም ከተበሞቤቺሃት።<note caller="-" style="x"><char style="xo" closed="false">7፥43 </char><char style="xt" closed="false"><ref loc="AMO 5:25-27">አሞ. 5፥25-27</ref>።</char></note><verse eid="ACT 7:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44"/>«ወዕኔ አናከኔ ኡለ ኡድማን መገኑ ገዉስ ለሊሰኖ ዱካኑ ሄዕዮሰ እቅ፤ ሁኩ ዱካኑንኩ መገኑ ሙሲሃ ኩሎስለከ ለሊሾስ ሃሊን መክዮእሃ እቅ።<note caller="-" style="x"><char style="xo" closed="false">7፥44 </char><char style="xt" closed="false"><ref loc="EXO 25:9">ፉል. 25፥9</ref>፤ <ref loc="EXO 40">40</ref>።</char></note> <verse eid="ACT 7:44"/><verse number="45" style="v" sid="ACT 7:45"/>መገኑ ብሬችሰ ሸር ፉሼ አይሁደ እክቡ መን ኡለተ ኦለንት ረገኦ ወክት አናከኔን ተ ቶጎ ዱካንቹተ ኢያሱንን ሜጡበ ህከ ባዱ ኣግሶኡ፤ ደዉዴ ዘማን ኢለ ህከኔ ሄኦኡ።<note caller="-" style="x"><char style="xo" closed="false">7፥45 </char><char style="xt" closed="false"><ref loc="JOS 3:14-17">ኢያ. 3፥14-17</ref>።</char></note> <verse eid="ACT 7:45"/><verse number="46" style="v" sid="ACT 7:46"/>ደዉድን መገን ብሬን ኬዕምኝ ደእ ያቁብ ዘሬ በላን መገኑ ገለኖ ምኒ እጃሮተ ዱአ አዕዮ።<note caller="-" style="x"><char style="xo" closed="false">7፥46 </char><char style="xt" closed="false"><ref loc="2SA 7:1-16">2 ሳሙ. 7፥1-16</ref>፤ <ref loc="1CH 3:1-17">1 ዱዱ. 3፥1-17</ref>።</char></note> <verse eid="ACT 7:46"/><verse number="47" style="v" sid="ACT 7:47"/>ጠዉ እኮጎሬ ዱእ ምኒ እጃሮሁ ሱላይማናት።<note caller="-" style="x"><char style="xo" closed="false">7፥47 </char><char style="xt" closed="false"><ref loc="1KI 6:1-38">1 ነገ. 6፥1-38</ref>፤ <ref loc="2CH 3:1-17">2 ዱዱ. 3፥1-17</ref>።</char></note><verse eid="ACT 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48"/>«ጠዉ እኮጎሬ ሎሩ መገኑ መን አንገት እጃርቶ ምኔን ሄአኖበአ፤ ሁኩንን ነብዬቹ ጠወአን<verse eid="ACT 7:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49"/>« ‹ሰሞሁ ዎምነትኤተ ቦርጭመ፤</para>
  <para style="q2" vid="ACT 7:49">ኡለት ሎከእ ፎሎሲሳምሃ ቤቹ፤</para>
  <para style="q1" vid="ACT 7:49">ኤሳሃ ሀትኔ ምኒ እጃርቴነን?</para>
  <para style="q2" vid="ACT 7:49">ህከረ አን ፎሎጫም ቤቹ ሀትናሙሃን? የኖ ቀርቹ።<note caller="-" style="x"><char style="xo" closed="false">7፥49 </char><char style="xt" closed="false"><ref loc="ISA 66:1-2">ኢሳ. 66፥1-2</ref>።</char></note><verse eid="ACT 7:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50"/>ህካን ጉዕመንከ አንገእ አቶሃበእንዶ?› የኖ መገኑ።<verse eid="ACT 7:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51"/>አዕኑ «ጢቃመት ቀልቡክዕኔ ዱጆእሩ! መጨክዕኔ ሞጮጭትቡሩ! አናከክዕኔ ጠሊለ አያነ ቶጉ ግቦገን አዕኑሁ ቶጉ ግቤነንታት።<note caller="-" style="x"><char style="xo" closed="false">7፥51 </char><char style="xt" closed="false"><ref loc="ISA 63:10">ኢሳ. 63፥10</ref>።</char></note> <verse eid="ACT 7:51"/><verse number="52" style="v" sid="ACT 7:52"/>ነብያካች ወዕኔ አናከኔ ያይትቡ ነብዬቹ አዬት? እሰን ፈዩ አሜቱስ ሄጭት ኩልቶእረ ሽቶኡ፤ ህትን ህከ ፈየ ኢሰን ህግሴን ኣስቴን ሽቴንታስ። <verse eid="ACT 7:52"/><verse number="53" style="v" sid="ACT 7:53"/>ህትን መላይከ አዲን መገን ሕገ ቶጌንታ እቅ፤ እኮጎሬ አገርቴንታበአ» ዬሰ።<verse eid="ACT 7:53"/></para>
  <para style="s1">እስጥፋኖሴ ክኒን ቀሴን ሼመገ</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54"/>ኦገት መኑ ህካን ሞጮጭቶ ወክት አበ ኡሙዕርት እስጥፋኖሴ አሌን እንኩተ እጦኡ። <verse eid="ACT 7:54"/><verse number="55" style="v" sid="ACT 7:55"/>ጠዉ እኮጎሬ እስጥፋኖስ ጠሊለ አያኒን ዊም ሰማሃ ዋሽ ቱክ ይ ለአን መገን ኬዕምኝለከ መገን መኬ አዲን ኡሬ ኢሰ ለዕዮ፤ <verse eid="ACT 7:55"/><verse number="56" style="v" sid="ACT 7:56"/>«ሁኩዕኑን ሰሞሁ ፈንተዕያን መንች ቤቱ መገን መኬ አንገ አዲን ኡሬኢሃ ለኣሚት» ዬእ።<verse eid="ACT 7:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57"/>ጠዉ እኮጎሬ እሰ ሎረ ላጋን ያርተን መጨሰ እፍስ ሜጡበ እክ እስቤቹ ደጉዶኡ። <verse eid="ACT 7:57"/><verse number="58" style="v" sid="ACT 7:58"/>ከተሚች አብል ፉሽት ክኒን ቀሶስ፤ ምስክር እኮእሩ ኦድኑሰ «ሳኦሌ» ዬኖ መቱ ወደልቹ አገሮተ ሎከስቤቾን አፉሽቶኡ። <verse eid="ACT 7:58"/><verse number="59" style="v" sid="ACT 7:59"/>እሰን ክኒን ቀሰንን እስጥፋኖስ «ቀርቾ ኢሳ! ሩህኤ ቶግ» ይ ላገስ ጎት አዕይ ዱአ አዕዮ። <verse eid="ACT 7:59"/><verse number="60" style="v" sid="ACT 7:60"/>እስን ጉሉጵ «ቀርቾ! ጩብሰ አጉር» የን ሎረ ላጋን ያሮ፤ ህካን ይ ሬዮ።<verse eid="ACT 7:60"/></para>
  <chapter eid="ACT 7"/>
  <chapter number="8" style="c" sid="ACT 8"/>
  <para style="s1">ሳኦል አመዕናኑተ ያዩስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1"/>ሳኦል እስጥፋኖሴ ሼመ ወክት አማዕለሞ እቅ፤ ህከ በር ዬሩሳሌማን ሄኦ አመዕናኖ አሌን አቡ ያየሙ እኮ፤ ህከ ወክት አሳበ ቤሉ አመዕናኑት ጉዕሙንኩ ይሁድ ባዱለከ ሰማር ባዱ ብንይቶኡ። <verse eid="ACT 8:1"/><verse number="2" style="v" sid="ACT 8:2"/>አመዕነቶን ጠረኝቶ መት-መቱ መኑ እስጥፋኖሴ ሞግ ላገሰ ጎት አት ቡብ ኦኦኡ።<verse eid="ACT 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 8:3"/>ጠዉ እኮጎሬ ሳኦል አመዕናኑተ ቤሶተ አጰመኖት እቅ፤ ህትን ምኒች ምኒ ኣገን አመዕንቶ ሜንቱለከ ጎነ ጎሾሽ ፉሸን ኡሱር ምኒ ኣግሰኖሳት እቅ።<note caller="-" style="x"><char style="xo" closed="false">8፥3 </char><char style="xt" closed="false"><ref loc="ACT 22:4-5">ሶቀ. 22፥4-5</ref>፤ <ref loc="ACT 26:9-11">26፥9-11</ref>።</char></note><verse eid="ACT 8:3"/></para>
  <para style="s1">ተሽት ላገት ሰማር ባዶን ተማርሴመገ</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4"/>ሁኩ ብንይቶ አመዕናኑት ተሽት ላገተ ዘህተን ተማርስቶኡ። <verse eid="ACT 8:4"/><verse number="5" style="v" sid="ACT 8:5"/>ፍልጶስን ሰማር ከተመ ኦሮዕይ መሲህተኔሃ ተማርሰኖት እቅ። <verse eid="ACT 8:5"/><verse number="6" style="v" sid="ACT 8:6"/>መኑንኩ ፍልጶሴ ላገተ ሞጮጭትለከ አዕዮ አጅበተ ለኦ ወክት መቶ ሰውቲን ሞጮጭታኢት እቅ። <verse eid="ACT 8:6"/><verse number="7" style="v" sid="ACT 8:7"/>ዶሮረኖ ዱሩ አበ መኒች ሎረ ላጋን ያረን ፉለኖት እቅ፤ ህትን ልግቡ ናፎሩለከ ድናኑት ፈይቶኡ። <verse eid="ACT 8:7"/><verse number="8" style="v" sid="ACT 8:8"/>ህካን እኮቤቺሃ ህከን ከተማን አቡ ሙንዲኑት እኮኡ።<verse eid="ACT 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9"/>ጠዉ እኮጎሬ ህከን ከተማን ሄአኖ መቱ «ስሞኔ» ዬኖ መንቹ ሄዕዮ እቅ፤ እስን «አን ሎረሃን» የን ሲረ አአን ሰማር ባድ ኡመት አጀብሲሰኖት እቅ። <verse eid="ACT 8:9"/><verse number="10" style="v" sid="ACT 8:10"/>ከተምስ መኑ ሎሪች ቀዉ ኢለ ህከ መንቹ «ኩ መንቹ ሎረ ዬን ገኤኖሲሁ መገንተ ዎልቀ» ይተን ጉዕሙንኩ ሞጮጭታሲት እቅ። <verse eid="ACT 8:10"/><verse number="11" style="v" sid="ACT 8:11"/>ልግቤ ዘማኒች ኬሽ ሲርንከስ አጀብሲሾሰቤቺሃ የኖርቹ ሞጮጭታሲት እቅ። <verse eid="ACT 8:11"/><verse number="12" style="v" sid="ACT 8:12"/>ጠዉ እኮጎሬ ፍልጶስ መገን ዎምነትተኔሃለከ መሲህ ኢስ ሱዕምተኔሃ ዱዱብሴሰ ተሽት ላጋን አመዕንቶሀኒች ኤተሮን ጎኑለከ ሜንቱ ጠመቀንቶኡ። <verse eid="ACT 8:12"/><verse number="13" style="v" sid="ACT 8:13"/>ስሞን ገዉንኩስ አመዕን ጠመቀሞ፤ እስን ፍልጶሴን መለዕለሙ ግብ ሜጡበ እኮ፤ ህትን ፍልጶስ አአኖ መላተለከ አጀብሲሰኖ ጠወ ለአን አጀብሲጨኖት እቅ።<verse eid="ACT 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14"/>ህከ ወክት ዬሩሳሌማን ሄኦ ሶቀማኑት ሰማር ባድ መኑ መገን ላገተ ቶጎገ ሞጮጭት ጴጥሮሴለከ ያህይ እሰቤቹ ሶኮኡ። <verse eid="ACT 8:14"/><verse number="15" style="v" sid="ACT 8:15"/>ጴጥሮስለከ ያህይ ህከ ቤቹ ኢልቶ ወክት ሁኩ መኑ ጠሊለ አያነ ቶጎተ ዱአ አቶሰ። <verse eid="ACT 8:15"/><verse number="16" style="v" sid="ACT 8:16"/>መሰንትስ ሰማር መኑ ጉዕሙንኩ ቀርቾ ኢስ ሱዕሚን ጠለዕል ጠመቀንቶ ቤሉ እሳች መትሰ አሌኒ ጠሊሉ አያኑ ሜጦረ ሜጥሰ አሌን ድርዮሰበ እቅ። <verse eid="ACT 8:16"/><verse number="17" style="v" sid="ACT 8:17"/>ህካን እኮቤቺሃ ጴጥሮስለከ ያህይ እሰ አሌን አንገሰ አቶ ወክት ሁኩ መኑ ጠሊለ አያነ ቶጎኡ።<verse eid="ACT 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18"/>አሳበት አንገሰ መን አሌን አተን ጠሊሉ አያነ ኣሰመኖሰገ ስሞን ለዕዮ ወክት ብረ እሳሃ ኤብ <verse eid="ACT 8:18"/><verse number="19" style="v" sid="ACT 8:19"/>«አኒሁ አንገኤ አሌስ አኣሚሁ ጉዕሙንኩ ጠሊለ አያነ ቶጎተ ኤሳሃ ከ ወልቀተ ኣስዬ» ዬሰ።<verse eid="ACT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20"/>ጠዉ እኮጎሬ ጴጥሮስ «መገን ኣስቱተ ብሪን ደዕቶተ ሰውይቶንትቤቺሃ ብሩክ ኪን ሜጡበ በኡን። <verse eid="ACT 8:20"/><verse number="21" style="v" sid="ACT 8:21"/>ቀልቡክ መገን ብሬን ጌጥ ዬእሃ እህበቤቺሃ ከን ጠዋን ኬሳሃ ቤቀንሹ ህከረንገ ወጡ ዮሄበአ። <verse eid="ACT 8:21"/><verse number="22" style="v" sid="ACT 8:22"/>ቴሁ ከን ሂለ ሆጎተክ ሻዝ ቶበት፤ አይደጎ ቀልብክ ሂለ ሰዉትክ አጉረኖሄጎሬ ቀርችቤቹ ዱአ አእ። <verse eid="ACT 8:22"/><verse number="23" style="v" sid="ACT 8:23"/>መሰንትስ አት አበ ሂለ ምቀኝማንለከ ጩብ ኡሱሮን ሄኡክ ለለኖኤት» ዬስ።<verse eid="ACT 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24"/>ስሞን «ቴሁ ጠወኤንተሀኒች መቱርቹሁ አሌንከኤ ኢለኖበእገ አዕኑ ቀርችቤቹ ዱአ አዕዬ» ይ ፈንቀሼእ።<verse eid="ACT 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25"/>ጴጥሮስለከ ያህይ ቀርች ላገተ መሰከርትለከ ጠወኦኢች ኤተሮን ሰማር ባዶን ዮ ልግቤ ኦሎን እንጂለ ተማርስተን ዬሩሳሌመ ፈንቀልቶኡ።<verse eid="ACT 8:25"/></para>
  <para style="s1">ፊልጶስ መቱ እቶጵያውቹ ጠመቁስ</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26"/>መገን መላይኬቹ ፊልጶሴ «ኬእ ዬሩሳሌሚች ጋዛ መሰኖ ዎቄን ካአጳ ዋልት ኦሮእ» ዬስ፤ ሁኩ ዎቆንኩ ኡለ ኡድማን ዮእሃ እቅ። <verse eid="ACT 8:26"/><verse number="27" style="v" sid="ACT 8:27"/>እስን ህከንቤቺች ኬዕይ ኦሮዕዮ፤ «ሕንዳኬ» ዬኖ እቶጵየ ባድ ዎማን ዮሴ ዱንየ አሌን ጉዕማንን ሹመለከ ገሸኖሃ እኮ መቱ ቃሬመስ እቶጵያውቹ መንቹ መገኒሃ ሰገዶተ ዬሩሳሌመ ኦሮዕዮ። <verse eid="ACT 8:27"/><verse number="28" style="v" sid="ACT 8:28"/>እስን ፈንቀል ኦሮአን ኬዕምኝ ጋሬን<note caller="+" style="f"><char style="fqa" closed="false">ኬዕምኝ ጋርተ፦ </char><char style="ft" closed="false">ዩ ፋርሶ ጋርተ አጉደኖሃ እክ ጠረኘለከ እስራኤላውያኑት በገዚሃ ደግለሸቀንታእሃን።</char></note> አፉዕል ነብዬቾ እስያሴ መጻፈ አነበበኖት እቅ። <verse eid="ACT 8:28"/><verse number="29" style="v" sid="ACT 8:29"/>ህከ ወክት ጠሊሉ አያኑ ፍልጶሴ «መርት ህከ ኬዕምኝ ጋሬቤቹ ሆንጠክ ደቀም» ዬስ። <verse eid="ACT 8:29"/><verse number="30" style="v" sid="ACT 8:30"/>ህካን እኮቤቺሃ ፍልጶስ ህከ ቤቹ ደጉጅ መርክና ኢቶጵያውቹ ነብዬቾ ኢስያሴ መጻፈ አነበበኖሃ ሞጮጭ «አነበባንት ፍሳረስ ኣጋሄትንዶ?» ዬስ። <verse eid="ACT 8:30"/><verse number="31" style="v" sid="ACT 8:31"/>ኢትዮጵያውቹንኩ «ሮስሰኖኤ መንቹ ዮበኢሃ ሀት እክ ኣጎኤተ አታለኖ» ይክነ ፍልጶሴ «ኬዕምኝ ጋሬ አል ቆጵ ኢን ሜጡበ አፉዕል» ዬስ። <verse eid="ACT 8:31"/><verse number="32" style="v" sid="ACT 8:32"/>እስን አነበበን ሄዕዮ ጠሊለ መጻፍ ቤቹ</para>
  <para style="q1" vid="ACT 8:32">«እስን ጎረጢሃ መሴኖ ሆልችገ፤</para>
  <para style="q2" vid="ACT 8:32">ኦርዘስ ኣኢሃ ሆንጠኮ መን ብሬን ሰዕም የኖ ቆርባብገ</para>
  <para style="q2" vid="ACT 8:32">እስ ጠወኦተ አፎስ ፈኞበአ።<verse eid="ACT 8:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33"/>እስን ገዉስ ሆፍሾ፤</para>
  <para style="q2" vid="ACT 8:33">ሀንቅ ፍርዱ ኣሰሞስበአ፤</para>
  <para style="q2" vid="ACT 8:33">ሄኡስ ኡለ አሊች ኬዕዮቤቺሃ</para>
  <para style="q2" vid="ACT 8:33">ደቦስተኔሃ አይ ጠወኦተ አታለኖ?»<note caller="-" style="x"><char style="xo" closed="false">8፥33 </char><char style="xt" closed="false"><ref loc="ISA 53:7-8">ኢሳ. 53፥7-8</ref>።</char></note><verse eid="ACT 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34"/>ሁኩ ቃሬመሲንኩ ፊልጶሴ «ነብዬቹ ካን ጠወዕዮሁ አዬተኔሃት? ገይስተኔሃትንዶ ዎሎ መንተኔሃት? ሀዕይ ኩሌኤ» ዬእ። <verse eid="ACT 8:34"/><verse number="35" style="v" sid="ACT 8:35"/>ፊልጶስን ህከን ጠሊለ መጻፊች ኬሽ ኢስተኔሃ ተሽት ላገተ ኩሎስ። <verse eid="ACT 8:35"/><verse number="36" style="v" sid="ACT 8:36"/>ሀንተንን ዉሁ ዮ ቤቹ ኢልቶ ወክት ሁኩ ቃሬመሲሁ «ዉሁ ኩዕኑን፤ ኤሳሃ ጠመቀሙ ከመኖኤሁ መርቹሃን?» ዬእ።<verse eid="ACT 8:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 8:37"/>[ፊልጶስ «ዊመ ቀልብንከክ አመዕንቶንትጎር ጠመቀንቶተ አታልታንት» ዬእ፤ ሁኩ ቃሬመሲንኩ «መሲህ ኢስ መገን ቤቱ እሁስ አመዕናም» ዬእ።]<note caller="+" style="f"><char style="ft" closed="false">መት-መቱ ሉህ ክታበት ወልንሽ 37 ዮኢሃ በርግታበአ፤</char></note><verse eid="ACT 8:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 8:38"/>ሁኩ ቃሬመሲንኩ ኬዕምኝ ጋርተ ኡርሳገ አዘዦ፤ ለሙንኩሰ ዊቤቹ መርታን ፊልጶስ ህከ ቃሬመሲንከ ጠመቆስ። <verse eid="ACT 8:38"/><verse number="39" style="v" sid="ACT 8:39"/>ዊ ኣዚች ፉልቶች ኤተሮን ቀርች አያኑ ፊልጶሴ መሴስ፤ ሁኩ ቃሬመሲንኩ ለንኪሃ ፊልጶሴ ለዕዮስበአ፤ እኮጎሬ ሙንደአን ዎቃስ ኦሮዕዮ። <verse eid="ACT 8:39"/><verse number="40" style="v" sid="ACT 8:40"/>ጠዉ እኮጎሬ ፊልጶስ «አሽዶደ» ዬኖ ከተማን ደገሞ፤ እስን ቂሳር ከተመ ኢሎተ ኢለ ከተማን ጉዕማንን ሃመን ተሽት ላገተ ዱዱብሰኖት እቅ።<note caller="+" style="f"><char style="fqa" closed="false">አሽዶደ የመመኖሁ፦ </char><char style="ft" closed="false">አዞጦሰ ዬኖቤቺን ሜጡሃን።</char></note><verse eid="ACT 8:40"/></para>
  <chapter eid="ACT 8"/>
  <chapter number="9" style="c" sid="ACT 9"/>
  <para style="s1">ሳኦል መሲሂን አመዕኔገ</para>
  <para style="r">(<ref loc="ACT 22:6-16">ሶቀ. 22፥6-16</ref>፤ <ref loc="ACT 26:12-18">26፥12-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1"/>ህከ ወክት ሳኦል ቀርቾን አመዕንቶእረ ሾተ ፎከሮ፤ ሎረ ቂስችቤቹ ኦሮዕይ <verse eid="ACT 9:1"/><verse number="2" style="v" sid="ACT 9:2"/>ቀርች ዎቃሃ አዎንታ ጎነለከ ሜንቱ ደገኖረ ጉዕመንከ ኡሱረን ዬሩሳሌመ ኤቦተ አታልሲሰኖ ደብዳቤተ ደማስቆን ሄኣ ጭምት ምናተ ከተብ ኣሶተ ጠዕሜእ።<verse eid="ACT 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 9:3"/>ኦሮአንን ደማስቆ ኢሎተ ሆንጠኮ ወክቴን ድንገቴን እስ ዮቤቾን ሰሜች ኑሩ በለቆ። <verse eid="ACT 9:3"/><verse number="4" style="v" sid="ACT 9:4"/>ህከ ወክት ኡላን ኡቦ፤ «ሳኦሌ! ሳኦሌ! ሚ ሸርታንቴኤት?» ይታ ላገተ ሞጮጬእ።<verse eid="ACT 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5"/>ሳኦልን «ቀርቾ! አት አዬት?» ዬ ወክት «አን አት ሸርታንቴኤ ኢሳት፤ ቀሰኖ ብረት ሃንቶንት ጎሬ ሂለኖሄ ዬስ።<note caller="+" style="f"><char style="fqa" closed="false">መት መቶ ፈሰረንቶ ክታባን «እጳሸ ሲፍ አሌን ኡርቶንት ጎሬ ገዉክ ምርታንት» ይታአ፤፦ </char><char style="ft" closed="false">9፥6 ሳኦል ሁጠን ዋጅ ገረምሲጨን «ቀርቾ! መ አኦተ ኢትተን?» ዬስ ይታኢሃ በርግታአ፤ ሁኩንን ፎሎጭ 22፥10—26፥14 ኢለ ከተበሞኡ።</char></note> <verse eid="ACT 9:5"/><verse number="6" style="v" sid="ACT 9:6"/>ቴሱ ኬእ ከተመ ኣግ፤ ህከኔ መ አታንት ጎሬ ህከጴ ኩሌኖሄ» ዬስ።<verse eid="ACT 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7"/>እሲን ሜጡበ ሃንተን ሄኦ መኑ ጠወአኖሲሁ አዬት ጎሬ ለኡዕነ ጠለዕል ላገተ ሞጮጭተን ይታርቹ ሆግ ኡርቶ እቅ። <verse eid="ACT 9:7"/><verse number="8" style="v" sid="ACT 9:8"/>ሳኦል ኡቦቤቺች ኬዕይ ለአኖ ወክት እልስ መቱርቹሃ ለኦተ አታልቶበአ፤ እሲን ሜጡበ ሄኦ መኑ አንገስ አፍ መሰገን ደማስቆ ከተመ መስቶስ። <verse eid="ACT 9:8"/><verse number="9" style="v" sid="ACT 9:9"/>ህከኔን እልስ ለኡዕነ፥ እቱዕነለከ አጉዕነ ሰሱ በር ዱንኬእ።<verse eid="ACT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10"/>ደማስቆን «ሀናንየ» ዬኖ መቱ ቀርች አሳቤቹ ሄዕዮ እቅ፤ ቀርቹንኩ እሱ መናማን «ሀናንየ» ዬስ፤ እስን «ቀርቾ! አን ከቤቹ ዮም» ዬእ። <verse eid="ACT 9:10"/><verse number="11" style="v" sid="ACT 9:11"/>ቀርቹንኩ እሱ «ኬእ ‹ጌጥዬ› ዬኖ ዎቃሃ ኦሮእ፤ ህከኔን ይሁድ ምኔን ዮ ‹ሳኦሌ› ዬኖ ጠርሴስ ባድ መንቺን ደቀም፤ መሰንትስ ሁኩዕኑን! እስ ህከጴ ዱአ አአኖት። <verse eid="ACT 9:11"/><verse number="12" style="v" sid="ACT 9:12"/>እስን ለኡ አታሎተ ‹ሀናንየ› ዬኖ መንቹ ኣግ አሌስ አንገተ አአን መናማን ለዕዮ» ዬስ።<verse eid="ACT 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13"/>ጠዉ እኮጎሬ ሀናንይ ፈንቀሽ «ቀርቾ! ኩ መንቹ ዬሩሳሌመን ሄኣ አመዕናኖ አሌን ሄንከ ሂለ ሆጉተ አአኖት ጎሬ ልግብያ መኒች ሞጮጭዮም። <verse eid="ACT 9:13"/><verse number="14" style="v" sid="ACT 9:14"/>ከንቤቾን ሱዕመክ ገእታእረ ጉዕመንከ ኡሱሮተ ቂስ አዎንሳኖች ዳኞመት ኣሰንቶስ» ዬስ።<verse eid="ACT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15"/>ጠዉ እኮጎሬ ቀርቹ ሀናንየ «እስ ሱዕመኤ መገኑ አመዕንበ መኒሃ፥ ዎማተለከ እስራኤል ኦሶተ ደግሲሰኖ አን መጠሮንስ ኦዳተ እኮቤቺሃ እስቤቹ ኦሮእ። <verse eid="ACT 9:15"/><verse number="16" style="v" sid="ACT 9:16"/>መሰንትስ ሱዕምኤተኔሃ ሄንከ ኦርሸተ ቶጉ ሀስሰኖስገ አን እሲሃ ለሊሳንስ» ዬእ።<verse eid="ACT 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17"/>ህካን እኮቤቺሃ ሀናንየ ኦሮዕይ እስ ሄዕዮ ምኒ ኣጎ፤ አንገስ ሳኦሌ አሌን አዕይ «አመኤ ቤቶ ሳኦሌ! ሁኩ አሜተን ዎቃን ለሌሄ ቀርቹ ኢስ ለንኪሃ ፈንቀሽት ለኡ አታልቶተለከ ጠሊሉ አያኑ ዊሞሄተ ሶኮኤ» ዬእ። <verse eid="ACT 9:17"/><verse number="18" style="v" sid="ACT 9:18"/>ህከ ወክት እሌስ አሊች ኦሞለ አጉደኖርቹ ኡባን ወዕኔገን ለኦተ አታሎ፤ ኬዕይን ጠመቀሞ። <verse eid="ACT 9:18"/><verse number="19" style="v" sid="ACT 9:19"/>እቸተ እች ጠረኜእ፤ ደማስቆን ሄኣ አሳባን ሜጡበ ቀዉ በር ዱንኬእ።<verse eid="ACT 9:19"/></para>
  <para style="s1">ሳኦል ደማስቆ ከተማን ተማርሱስ</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 9:20"/>ወክትንከስ ሳኦል ደማስቆን «ኢስ መገንየ ቤቱ» የን አደደ አይሁድ ጭምት ምናን ተማርሱ ጀመሮ። <verse eid="ACT 9:20"/><verse number="21" style="v" sid="ACT 9:21"/>ሞጮጭቶሩ ጉዕሙንኩ «ኩ መንቹ ዬሩሳሌማን ከ ሱዕመ ገእታእረ ጉዕመንከ ቤሰን ሄዕዮሃበዕንዶ? ከ ቤቹንከ አሜቾሁ እሰተ ኡሱረን ቂስ አዎንሳኖቤቹ መሶታበእንዶ?» ይተን አጀብሲጭቶኡ።<verse eid="ACT 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 9:22"/>ጠው እኮጎሬ ሳኦል ወዕኔች በትሽ ጠረኘን ኦሮዕዮ፤ ኢስ መሲሁ እሁስ ደማስቆን ሄኣ አይሁዲሃ መስለ ከመኖሳት እቅ።<verse eid="ACT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23"/>ልግብያ በሬች ኤተሮን አይሁዱ ሳኦሌ ሽቶተ አማዕለንቶኡ።<note caller="-" style="x"><char style="xo" closed="false">9፥23-25 </char><char style="xt" closed="false"><ref loc="2CO 11:32-33">2 ቆሮ. 11፥32-33</ref>።</char></note> <verse eid="ACT 9:23"/><verse number="24" style="v" sid="ACT 9:24"/>ጠዉ እኮጎሬ ሳኦል ተንኮ አማልሰ ደጎ፤ እሰን ሳኦሌ ሽቶተ ከተሚች ሀንከዕርተለከ በራሃ ፉለኖ ኡሩተ ጉዕመንከ አገሩ ጀመርቶኡ። <verse eid="ACT 9:24"/><verse number="25" style="v" sid="ACT 9:25"/>ጠዉ እኮጎሬ አሳበት እሱ ቀርጫታን ዎርት ሀንከዕሬን መስት ግንብ ኦተ መስኮቲን ኤተሩ ዋሽት ፉሽቶስ።<verse eid="ACT 9:25"/></para>
  <para style="s1">ሳኦል ዬሩሳሌመ ኦሮዕዮገ</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26"/>ሳኦል ዬሩሳሌመ ኢሌ ወክት ህከኔ ሄኦ አሳባን ሜጡበ ሄኦተ ሀሾ፤ ጠዉ እኮጎሬ እሰ ጉዕሙንኩሰ እስ አሳቤቹ እሁስ አመዕንትበቤቺሃ ዋጅቶስ። <verse eid="ACT 9:26"/><verse number="27" style="v" sid="ACT 9:27"/>ጠዉ እኮጎሬ በርናባስ ሳኦሌ አሳበቤቹ ኣእ መር ዎቃን ቀርቹ ሀት እክ ለሌስገለከ ጠወዕዮስገ ህትን ደማስቆን ኢስ ሱዕሚን ሀት መለል ተማርሴገ ኩሎሰ። <verse eid="ACT 9:27"/><verse number="28" style="v" sid="ACT 9:28"/>ህካን እኮቤቺሃ ሳኦል እሳን ሜጡበ እክ ዬሩሳሌማን ሃመኖት እቅ፤ ቀርች ሱዕሚን መለል ተማርሰኖት እቅ። <verse eid="ACT 9:28"/><verse number="29" style="v" sid="ACT 9:29"/>ግርክ አፎ ጠወኣ አይሁዲን ጠወአን ኦደኖት እቅ፤ እኮጎሬ እሰ ሽቶስተ ሀሶኡ። <verse eid="ACT 9:29"/><verse number="30" style="v" sid="ACT 9:30"/>ህካን አመዕናኑት ደጎ ወክት ቂሳር ከተመ መስቶስ፤ ህከንቤቺች ተርሴስ ከተመ ኦሮአኖገ አቶስ።<verse eid="ACT 9:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31"/>ይሁድ ባዶን፥ ገሊለ ባዶንለከ ሰማር ባዶን ጉዕማንን አመዕናኑት ጠረኝት ወገሬቲን ሄኦኡ፤ ህትን መገኑ ዋጅተን ጠሊሉ አያኑ ጠረኝሰንሰ ዎሊንሺን በተአን መርቶኡ።<verse eid="ACT 9:31"/></para>
  <para style="s1">ጴጥሮስ ልዳለከ እዮጴ ከተመ ኦሮዕዮገ</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32"/>ጴጥሮስ ቤቺች ቤቹ ፈንቀላመን ልዳን ሄኣ አመዕናኖቤቹ ኦሮዕዮ። <verse eid="ACT 9:32"/><verse number="33" style="v" sid="ACT 9:33"/>ህከኔን ህዜቱ ዘመን ዊመ መዕናን ኦሰዕዮ ኤኒያ ዬኖ ናፈ መንቹ ደጎ። <verse eid="ACT 9:33"/><verse number="34" style="v" sid="ACT 9:34"/>ጴጥሮስን «ኤኒያ! መሲህ ኢስ ፈይሰኖሄ፤ ኬዕ መዕነክ ዌስ!» ዬስ፤ እስን ወክቲንከስ ኬዕዮ። <verse eid="ACT 9:34"/><verse number="35" style="v" sid="ACT 9:35"/>ልዳለከ ሳሮን ከተማን ሄዕዮ መኑ ጉዕሙንኩ እሱ ለእ ቀርች አደ ፈንቀልቶኡ።<verse eid="ACT 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36"/>እዮጴ ከተማን «ጠቢተ» ዬኖ መትት ኢሰ አዎንታእት ሄኦ እቅ፤ እሴን ግርክ መን አፎን «ዶርቃ» ዬኖ እቅ፤ ፍሳረስ «ጉሜተ» ዩሃን፤ እሴ ጡመተ ሆጉተ አታኢተለከ ቡጥቻኖተ ደግለልታእተ መንቹ እቅ። <verse eid="ACT 9:36"/><verse number="37" style="v" sid="ACT 9:37"/>ህከ ወክት እሴ ጥዝ ሬቶኡ፤ እሰን ጀናዘሴ አንሽት ፉቅ ምኔን አፉሽቶኡ። <verse eid="ACT 9:37"/><verse number="38" style="v" sid="ACT 9:38"/>ልዳ ከተሙ እዮጴ ከተሚሃ ግደኑ እኮቤቺሃ እዮጴ ከተማን ዮ ኢስ አሳበት ጴጥሮስ ልድ ከተማን ሄኡስ ሞጮጭት እስቤቹ ለሙ መነ «ኒቤቹ ደዕልት አም» ይት ሶኮኡ። <verse eid="ACT 9:38"/><verse number="39" style="v" sid="ACT 9:39"/>ጴጥሮስን ህከን ሶቀንቶሀኑኡንን ሜጡበ አሜቾ፤ እስን ኢሌ ወክት ፉቅ ምኒ ፉሽቶስ፤ ህከኔን ምንሰ አኑ ሬዮ ሜንቱ ጉዕሙንኩ ብሬስ ኡርት ዶርቃ እሳን ሜጡበ ሄኦ ወክት ደዶ ቀምብሰተለከ ኦድኑተ ቶገን ኦኦኡ። <verse eid="ACT 9:39"/><verse number="40" style="v" sid="ACT 9:40"/>ጠዉ እኮጎሬ ጴጥሮስ እሰተ ጉዕመንከ አብል ፉሽ ጉሉጵ ዱአ አዕዮ፤ እስን ጀናዘት ዮ አደ ፈንቀል «ጠብተ! ኬእ» ዬእ፤ እሴን እልሴ ፈንት ጴጥሮሴ ለእ ኬእ አፉዕልቶኡ። <verse eid="ACT 9:40"/><verse number="41" style="v" sid="ACT 9:41"/>እስን አንገስ ሂር አፍሴ ኬሾ፤ ምንሰ አኑ ሬዮ ሜንቱለከ ዎሉ አመዕናኑተ ገእ ሩሁሴ ፈንቀላን ኣሴሰ። <verse eid="ACT 9:41"/><verse number="42" style="v" sid="ACT 9:42"/>ሁኩ ጠዉ እዮጴ ከተማን ጉዕማንን ሞጮጨሞ፤ ልግቡ መኑንኩ ቀርቾን አመዕኔእ። <verse eid="ACT 9:42"/><verse number="43" style="v" sid="ACT 9:43"/>ጴጥሮስን እዮጴ ከተማን ጎገ ዙገኖ «ስሞኔ» ዬኖ መንቺን ሜጡበ ልግብ በር አፉዕሌእ።<verse eid="ACT 9:43"/></para>
  <chapter eid="ACT 9"/>
  <chapter number="10" style="c" sid="ACT 10"/>
  <para style="s1">ጴጥሮሴለከ ቆርኔሌዎስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1"/>ቄሳር ከተማን ሄአኖ «ቆርኔሎሴ» ዬኖ መቱ መንቹ ሄዕዮ እቅ፤ እስን ሮም በገዝ ጎጎት ኣዜን «ጣልያን ብርጌደ» ዬኖሀኒሃ ጥቤ ሀለቀ እቅ። <verse eid="ACT 10:1"/><verse number="2" style="v" sid="ACT 10:2"/>እስን ምንስ አበሮሲን ሜጡበ መገኒሃ ሰገደን መገኑ ዋጀኖ እቅ፤ ህትን ቡጥቻኖተ ሰደቀተ ኣሰኖ እቅ፤ መገን አደንከ ጉዕመ ወክት ዱአ አአኖ እቅ። <verse eid="ACT 10:2"/><verse number="3" style="v" sid="ACT 10:3"/>መቱ በር ሆንሶ ሰኣት ጌሳን መገን መላይኬቹ «ቆርኔሎሴ» የን እሱ ገአን መናማን ለሌስ።<verse eid="ACT 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4"/>እስን መላይኬቹ ቱክ ይ ለአን ዋጅ «ቀርቾ መርቹሃን?» ዬእ፤ መላይኬቹንኩ «ዱኡክለከ ቡጢቻኖተ ሰደቀ ሀዕልታንቲሁ መገንሀኔን ቃገንታንትገ አዕዮሄ። <verse eid="ACT 10:4"/><verse number="5" style="v" sid="ACT 10:5"/>ቴሁ እዮጴ ከተማን ሄዕዮ ጴጥሮሴ ዬኖ ስሞኔቤቹ መነ ሶክ ገእሲስ። <verse eid="ACT 10:5"/><verse number="6" style="v" sid="ACT 10:6"/>እስ ቴሱ ምኑስ ባር መዴን ሄዕዮ ጎገ ዙገኖ ስሞኔ ምኔን ኮህነቱ አፉዕልዮኡ» ዬስ። <verse eid="ACT 10:6"/><verse number="7" style="v" sid="ACT 10:7"/>እሲን ሜጡበ ጠወአን ሄዕዮ መላይኬቹ እሲች አደ እክ ኦሮዕዮች ኤተሮን ቆርኔሎስ እስ ካዲማች ለሙሰለከ ጉዕመ ወክት እሱ አገርታሀኑኡች መገኑ ዋጀኖ መቱ ወታደርቹ ገእ <verse eid="ACT 10:7"/><verse number="8" style="v" sid="ACT 10:8"/>ጉዕመንከ ጠወ ኩሎሳች ኤተሮን እዮጴ ከተመ ሶኮሰ።<verse eid="ACT 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9"/>ለንክ በር ገስመ እሰ መርት ከተመስ ሆንጠኮ ወክት ሌሆ ሰኣት ጌሰ ጴጥሮስ ዱአ አኦተ ሀንሸርገ ዮ ቤቹ ፉሎ። <verse eid="ACT 10:9"/><verse number="10" style="v" sid="ACT 10:10"/>እስን ጎሩ አፋንስ እቸተ እቶተ ሀሾ እቅ፤ እቸተ ቅጥ አኤነኒን መናመተ ለዕዮ። <verse eid="ACT 10:10"/><verse number="11" style="v" sid="ACT 10:11"/>ህከ ወክት ሰሞሁ ፈንተዕየን ሾሉ ሙረበስ ኡሱረሞ መጋረጀ አጉደኖርቹ ሰሜች ኡለተ ድረን ለዕዮ። <verse eid="ACT 10:11"/><verse number="12" style="v" sid="ACT 10:12"/>ህከን ኣዜንን አደዱ ሾል ሎከት ዮሰ ቡሳዉ፥ ወዘንከሰ ሹርይታ ክልቀቱለከ ሰማን ብርይታ ጪኡት ሄኦ እቅ። <verse eid="ACT 10:12"/><verse number="13" style="v" sid="ACT 10:13"/>ህከ ወክት «ጴጥሮሴ! ኬእ ካን ጎረጥ እት» ይታ ላገተ ሞጮጬእ።<verse eid="ACT 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14"/>ጠዉ እኮጎሬ ጴጥሮስ «ቀርቾ! እሀኖበአ፤ አን ህትኔ ንጃሾ ህከረንገ ነጠ እህባሃ እቾም በሩ ዮበአ» ዬእ።<verse eid="ACT 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15"/>ህትን ለንኪሃ «መገኑ ሙጩሩ አዕዮሃ አት ንጃስሶት» ይታ ላገት አሜቶኡ። <verse eid="ACT 10:15"/><verse number="16" style="v" sid="ACT 10:16"/>ሁኩን ሰሱ ወክት እኮች ኤተሮን ሁኩ መጋረጀ አጉደኖርቹ ሰማ ዋል ኦሮዕዮ።<verse eid="ACT 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17"/>ጴጥሮስ መናመገ ለዕዮ ጠወ «ኩን እኮሁ ሚሃት?» የን ቀልቤንከስ ጨነቀመን ቆርኔሌዎስ ሶኮ መኑ ስሞኔ ምኒ መነ ጠዕምት ደጎኢች ኤተሮን ኡሮን ኡርቶ እቅ። <verse eid="ACT 10:17"/><verse number="18" style="v" sid="ACT 10:18"/>እሰን ላገሰ ጎት አት « ‹ስሞኔ› ዬን ገኤኖ ጴጥሮስ ከበ ዮእንዶ?» ይት ጠዕምቶኡ።<verse eid="ACT 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19"/>ጴጥሮስን ህከን መናማን ለዕዮ ጠውተኔሃ ሰውየን ሄዕዮገን ጠሊሉ አያኑ «ሁኩዕን ሰስ መናከት ሀሳሄት። <verse eid="ACT 10:19"/><verse number="20" style="v" sid="ACT 10:20"/>እሰን አን ሶካንሰ አሜቶረ እኮቤቺሃ ኬእ ለሞሱዕናን እሳን ሜጡበ ኦሮእ» ዬእ። <verse eid="ACT 10:20"/><verse number="21" style="v" sid="ACT 10:21"/>ጴጥሮስን ህከን መንቤቹ ድር «አዕኑ ሀሴነንተ መንቹ አኔት፤ አሜቴንታሁ መ መሳኒት?» ዬሰ። <verse eid="ACT 10:21"/><verse number="22" style="v" sid="ACT 10:22"/>እሰን «አይሁድ መኑ ሎርሰኖ መገኑ ዋጀኖ ሀንቅ መንቹ ‹ቆርኔሌዎሴ› ዬኖ ጥቤ ሀለቁ ሶካኔት፤ ኬሳሃ ምንስ ገእሲሽ አት ይታንቲሃ ሞጮጮተ ጠሊሉ መላይኬቹ ኩሎስ» ይቶኡ። <verse eid="ACT 10:22"/><verse number="23" style="v" sid="ACT 10:23"/>ጴጥሮስን እሰተ ምኒ ኣግሽ ካደሞሰ፤ ለንክ በር ገስመንከ እሳን ሜጡበ ኦሮኦተ ፉሎ፤ እዮጴ ከተማን ዮ አመዕናኖች መት-መቱ እሲን ሜጡበ መርቶኡ።<verse eid="ACT 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 10:24"/>ለንክ በር ገስማን ቄሳር ከተመ ኢልታ ወክት ቆርኔሎሴ እሉስለከ ሆንጠካስ ጃለስ ገእ እሳን ሜጡበ አገረኖት እቅ። <verse eid="ACT 10:24"/><verse number="25" style="v" sid="ACT 10:25"/>ጴጥሮስን ህከ ቤቹ ኢል ምኒ ኣጎ ወክት ቆርኔሎስ ጴጥሮሴን ደቀም ሎከስ ኡብ ሰገጆስ። <verse eid="ACT 10:25"/><verse number="26" style="v" sid="ACT 10:26"/>እኮጎሬ ጴጥሮስ «ኬእ! አን ኪገን መንቹሃን» ይ ኬሾስ።<verse eid="ACT 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 10:27"/>ጴጥሮስ እሲን ጠወአንን ምኒ አገኖ ወክት ልግቡ መኑ ጭምዬኢሃ ለዕይ <verse eid="ACT 10:27"/><verse number="28" style="v" sid="ACT 10:28"/>«አይሁድ መንቹ አይሁደ እህባ ዎሎ ዘሬን ጭምዩ ህከረንገ ምኒ ኣጉ ሕጋን ፈቀደምባሃ እሁስ አዕኑ ገዉክዕኔን ደጌነንተ፤ እኮጎሬ ኤሳሃ አዬሁ ‹ነጠ እኮበእሃ ህከረንገ ንጃሾእሃ› ዩ ሀስሰኖኤበእገ መገኑ ለሊሾኤ። <verse eid="ACT 10:28"/><verse number="29" style="v" sid="ACT 10:29"/>ህካን እኮቤቺሃት እቤቹ ሶኬንተ ወክት ግቡዕነ አሜቾሚሁ፤ ‹ቴሱ ገእቴንተኤሁ ሚሃት?› ይ ጠዕማንክዕኔ» ዬሰ።<verse eid="ACT 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30"/>ቆርኔሌዎስ «ሾሎ በሬች ብርተ ህትኔ ወክቴን ሆንሶ ሳቴን ምኔንከኤ ዱአ አአን አበ በለቀ ኦድኑተ ኦደዕዮ መቱ መንቹ ብሬንከእ ኡር <verse eid="ACT 10:30"/><verse number="31" style="v" sid="ACT 10:31"/>‹ቆርኔሌዎሴ! ዱአክ መገኑ ሞጮጭዮኡ፤ ህትን ቡጢቻኖተ ኣቶንት ሰደቀተ መገኑ ቃጎኡ። <verse eid="ACT 10:31"/><verse number="32" style="v" sid="ACT 10:32"/>እዮጴ ከተመ መነ ሶክ «ጴጥሮሴ» ዬን ገኤኖ ስሞኔ ገእሲስ፤ እስን ጎገ ዙገኖ ስሞኔ ምኔን ኮህነቱ አፉዕልዮ፤ ስሞኔ ምኑ ባር መዴን ዮእሃን› ዬእ። <verse eid="ACT 10:32"/><verse number="33" style="v" sid="ACT 10:33"/>ህካን እኮቤቺሃ ህከ ወክትንከ ኪቤቹ ሶኮም፤ አት አሜቲንከክ ጡመ አቶንት፤ ቴሱ መገኑ አዘዦሄርቹ ጉዕመንከ ሞጮጭኖተ ጉዕሙንኩኔ ከንቤቾን መገን ብሬን ጭምይኖም» ዬእ።<verse eid="ACT 10:33"/></para>
  <para style="s1">ጴጥሮስ ጠወዕዮገ</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34"/>ጴጥሮስን «መገኑ መነ መኒች በትሽ ጎልባሃ እሁስ ሀንቅንከ ቴሱ ደጎም ዬእ።<note caller="-" style="x"><char style="xo" closed="false">10፥34 </char><char style="xt" closed="false"><ref loc="ACT 10:17">10፥17</ref>።</char></note> <verse eid="ACT 10:34"/><verse number="35" style="v" sid="ACT 10:35"/>ጠዉ እኮጎሬ ሀከን ደቦ ዘርተ እሁን መገኑ ከበጀኖ እኮች መገኑ ቶገኖስ። <verse eid="ACT 10:35"/><verse number="36" style="v" sid="ACT 10:36"/>መገኑ እስራኤል ኡመቲሃ ላገስ ሶኮ፤ ጉዕም ቀርቹ መሲህ ኢስ እስ አዲን አሜተኖ ወገሬት አዋጄሰ። <verse eid="ACT 10:36"/><verse number="37" style="v" sid="ACT 10:37"/>ያህይ ጥምቀትተኔሃ ተማርሴኢች ኤተሮን ገሊለ ባዲች ጀመር ይሁድ ባዶን ጉዕማንን እኮ ጠወ አዕኑ ደጌነንተ።<verse eid="ACT 10:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 10:38"/>«ህትን መገኑ ናዝሬት ኢሰ ጠሊለ አያኒን ቡር ወልቀተ ኣሴስገ ደጌነንተ፤ መገኑንኩ እሲን ሜጡበ ሄዕዮቤቺሃ እስ ጡመ ጠወ አአንለከ እልቢሱ አፎሃ ጉዕመንከ ፈይሰን ፈንቀላሞ።<verse eid="ACT 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 10:39"/>«እስን ይሁድ መን ባዶንለከ ዬሩሳሌም ከተማን አዕዮ ጠዊሃ ነኡ ምስክርሃን፤ እሱ መስቀል አሌን ሰቀልት ሽቶስ። <verse eid="ACT 10:39"/><verse number="40" style="v" sid="ACT 10:40"/>ጠዉ እኮጎሬ መገኑ ሰቅ በር ሬሆች ኬሽ ለለኖገ አዕዮስ። <verse eid="ACT 10:40"/><verse number="41" style="v" sid="ACT 10:41"/>ሁኩ እሲን ለሌኢሁ ሄጭ መገኑ መጠሮ ምስክር እንኮም ኔሳዪት ቤሉ መኒሃ ጉዕሚሃበአ፤ እስ ሬሆች ኬዕዮች ኤተሮን እስን ሜጡበ እንቶሚሁለከ አንጎሚሁ ነኦት። <verse eid="ACT 10:41"/><verse number="42" style="v" sid="ACT 10:42"/>ኢስን ሬቶሀኑኡንለከ ፎሊን ሄኣሀኑኡ አሌን ፈረዶተ መገኑ አዕዮሁ እሱ እሁስ መሰከርኖተለከ መኒሃ ጉዕሚንከ ተማርስኖተ አዘዦኔ። <verse eid="ACT 10:42"/><verse number="43" style="v" sid="ACT 10:43"/>እሲን አመዕነኖሁ ጉዕሙንኩ እስ ሱዕሚን ጩቡስ ፈቁን የመሞተ ነብያከት ጉዕሙንኩ መሰከርቶስ» ዬእ።<verse eid="ACT 10:43"/></para>
  <para style="s1">መገኑ አመዕንትቡ መኑ ጠሊለ አያነ ቶጉሰ</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44"/>ጴጥሮስ ህከ ጠወ ጠወአንን ላገስ ሞጮጭቶ መን አሌን ጉዕማንን ጠሊሉ አያኑ ድሬእ። <verse eid="ACT 10:44"/><verse number="45" style="v" sid="ACT 10:45"/>ጴጥሮሴን ሜጡበ አሜቶ ጡርከመንቶ አይሁድ አመዕናኑት አይሁደ እክበ መን አሌን ጠሊለ አያነ ኣሴሰገ ለኦ ወክት አጀብሲጭቶኡ። <verse eid="ACT 10:45"/><verse number="46-47" style="v" sid="ACT 10:46-47"/>አጀብሲጭቶኢሁ እሰ ዎሎ ላጋን ጠወአንለከ መገኑ ሎርስተን ሞጮጭቶቤቺሃት። ጴጥሮስን «ቴ ኒገን ጠሊለ አያነ ቶጎ መኑ ዊን ጠመቀንታበእገ ከመኖሳሁ አዬት?» ዬእ። <verse eid="ACT 10:46-47"/><verse number="48" style="v" sid="ACT 10:48"/>እሰን መሲህ ኢስ ሱዕሚን ጠመቀንታገ ጴጥሮስ አዘዦሰ፤ ህከኒች ኤተሮን ቀዉ ጌሰ እሳን ሜጡበ አገሮተ ኡጭቶስ።<verse eid="ACT 10:48"/></para>
  <chapter eid="ACT 10"/>
  <chapter number="11" style="c" sid="ACT 11"/>
  <para style="s1">ጴጥሮስ አይሁደ እኮበእ መን ምኒ ኣጉስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1"/>አሳበትለከ ይሁድ ባዶን ዮ መገኑ አመዕንቶ መኑሁ አይሁደ እህቡ መኑሁ መገን ላገተ ቶጎገ ሞጮጭቶኡ። <verse eid="ACT 11:1"/><verse number="2" style="v" sid="ACT 11:2"/>ህካን እኮቤቺሃ ጴጥሮስ ዬሩሳሌመ ፈንቀል መሮ ወክት ጡርከመንቶ አይሁድ አመዕናኑት <verse eid="ACT 11:2"/><verse number="3" style="v" sid="ACT 11:3"/>«ጡርከመንቶበእ መን ምኒ ኣግ እሳን ሜጡበ እቶንቲሁ ሚሃት?» ይት ዎቀሶኡ። <verse eid="ACT 11:3"/><verse number="4" style="v" sid="ACT 11:4"/>ጠዉ እኮጎሬ ጴጥሮስ ወዕኔችን ጀመር እኮ ጠወ ጉዕመንከ ሮስሾ።<verse eid="ACT 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 11:5"/>እስን «አን እዮጴ ከተማን ዱአ አአን ገዉእ ዛኛምገ አአኖ ሰዉት ኣዜን ሄዕዮምገ መናማን ለሌኤ፤ ሁኩንን መጋረጀ አጉደኖሁ ሾሉ ሙረበስ ኡሱሬማሁ ሰሜች ኢቤቹ አሜቾ። <verse eid="ACT 11:5"/><verse number="6" style="v" sid="ACT 11:6"/>ህካን ሆንጠክ ቱክ ይ ለኣም ወክት መጋረጅ አሌን ሾል ሎከት ዮስ ግዘ፥ ቆጥ ቡሳወ፥ ኡለ አሌን ወዘኒንከሰ ሹርይተን ሃንታ ክልቀቱለከ ሰማን ብርይታ ጪኡት ዮኢሃ ለዕዮም። <verse eid="ACT 11:6"/><verse number="7" style="v" sid="ACT 11:7"/>ህትን ‹ጴጥሮሴ! ኬእ ካን ጎረጥ እት› ይታ ላገተ ሞጮጬም። <verse eid="ACT 11:7"/><verse number="8" style="v" sid="ACT 11:8"/>ጠዉ እኮጎሬ አን ‹ቀርቾ! እሀኖበአ፤ ነጠሀ እኮበእሃ ህከረንገ ንጃስ እኮሃ ከበሬ ኢሎተ ኢለ አፎንከኤ አፎምበአ› ዬም። <verse eid="ACT 11:8"/><verse number="9" style="v" sid="ACT 11:9"/>ለንኪሃ ‹መገኑ ነጠ አዕዮሃ አት ንጃስሶት› ይታ ላገት ሰሜች አሜቶኡ። <verse eid="ACT 11:9"/><verse number="10" style="v" sid="ACT 11:10"/>ኩ ጠዉ ሰሱ ወክት ህት እኮች ኤተሮን ሁኩ መጋረጀ አጉደኖርቹ ሰማ ዋል ጣጠሞ። <verse eid="ACT 11:10"/><verse number="11" style="v" sid="ACT 11:11"/>ህከ ወክት ቄሳር ከተሚች ኢቤቹ ሶሀንቶ ሰስ መናከት አን ሄዕዮም ምኒ ኢልቶኡ። <verse eid="ACT 11:11"/><verse number="12" style="v" sid="ACT 11:12"/>ጠሊለ አያነ ሸኩዕናን እሳን ሜጡበ ኦሮኣምገ ኩሎኤ፤ ኩ ሌሁ መኑንኩ ኢን ሄኦኡ እቅ፤ እሳኒን ሜጡበ ቆርኔሌዎሴ ዬኖ መንች ምኒ ኣንጎም። <verse eid="ACT 11:12"/><verse number="13" style="v" sid="ACT 11:13"/>ቆርኔሎስን መላይኬቹ ምኔስ ኡር ለዕዮገለከ ‹እዮጴ ከተመ መነ ሶክ ጴጥሮሴ ዬኖ ስሞኔ ገእሲስ፤ <verse eid="ACT 11:13"/><verse number="14" style="v" sid="ACT 11:14"/>አትለከ ምንክ አበሮሱ ጉዕሙንኩ ጡምቴነንተ ጠወ ኩለኖሄ› ዩስ ኩሎኔ። <verse eid="ACT 11:14"/><verse number="15" style="v" sid="ACT 11:15"/>ህከኔን አን ጠወኡ ጀመሮም ወክት ጠሊሉ አያኑ ወዕና ኒ አሌን ድሬገን እሰ አሌን ድሬእ። <verse eid="ACT 11:15"/><verse number="16" style="v" sid="ACT 11:16"/>ህከ ወክት ‹ያህይ ዊን ጠመቆ፤ እኮጎሬ አዕኑ ጠሊለ አያኒን ጠመቀንቴነንተ› ዬ ቀርች ላገት ቃገንቶኤ።<note caller="-" style="x"><char style="xo" closed="false">11፥16 </char><char style="xt" closed="false"><ref loc="ACT 1:5">ሶቀ. 1፥5</ref>።</char></note> <verse eid="ACT 11:16"/><verse number="17" style="v" sid="ACT 11:17"/>ነኡ ቀርቾ መሲህ ኢሳን አመዕንኖም ወክት ኔሳሃ ኣሴ ህከ ኣስቱተ እሳሃ ኣሴሳች መገኒን ሀንበዕለሞተ አን አዬት?» ዬእ።<verse eid="ACT 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18"/>እሰን ህካን ሞጮጭቶ ወክት መስለ ሆግ ጨለ ይቶኡ፤ ህትን «መገኑ አይሁደ እህበ መኒሀ ነብሴሀሰ ቶበት ፈንቀልታገ አዕዮሰ» ይተን መገኑ ገለትጭቶኡ።<verse eid="ACT 11:18"/></para>
  <para style="s1">አመዕናኑተ አንጾካን «መሲሂን አመዕንቶ መነ» ዬማገ</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19"/>እስጥፋኖሴ ሼመች ኤተሮን ኬዕዮ ያህይ መሳን ብንይቶ አመዕናኑት ዎሎ መኒሃ እሁዕነ ጠለዕል አይሁድ መኒሃ መገን ላገተ ኩልተን ፍንቄ ባዱ፥ ዊን ረበንቶ «ቆጵሮሰ» ዬኖ ባዱለከ አንጾክ ከተመ ኢለ ዘህተን ኩልታኢት እቅ።<note caller="-" style="x"><char style="xo" closed="false">11፥19 </char><char style="xt" closed="false"><ref loc="ACT 8:1-4">ሶቀ. 8፥1-4</ref>።</char></note> <verse eid="ACT 11:19"/><verse number="20" style="v" sid="ACT 11:20"/>ጠዉ እኮጎሬ እሳች መት-መቱ ዊን ረበንቶ «ቆጵሮሰ» ዬኖ ባዱለከ ቀሬን ከተም መኑ አንጾከ መርቶ ወክት ቀርቾ ኢስ ተሽት ላገተ ግርክ ባድ መኒሃ በርግት ኩልተን ተማርስታኢት እቅ። <verse eid="ACT 11:20"/><verse number="21" style="v" sid="ACT 11:21"/>ቀርቹንኩ እሳንከ ደግለለን ሄዕዮቤቺሃ ልግቡ መኑ አመዕንት ቀርች አደ ፈንቀልቶኡ።<verse eid="ACT 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22"/>ህከን ጠው ዱዱቡንኩ ዬሩሳሌማን ሄኦ አመዕናኖተ ሞጮጨሞ፤ እሰን በርናባሴ አንጾክ ከተመ ሶኮኡ። <verse eid="ACT 11:22"/><verse number="23" style="v" sid="ACT 11:23"/>እስን መር መገን ኣስቱተ ለዕዮ ወክት አበ ሙንደዕዮ፤ ዊመ ቀልብንከሰ ቀርቾን ጠረኝት አመዕነንቶረ እክ ሄኣገ ሰዦሰ። <verse eid="ACT 11:23"/><verse number="24" style="v" sid="ACT 11:24"/>መሰንትስ እስ ጠሊሉ አያኑለከ አመዕነቱሁ ዊሞስቤቺሃ ጡመ መንቹ እቅ፤ ልግቡ መኑንኩ አመዕንት ቀርች አደ ፈንቀልቶኡ።<verse eid="ACT 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25"/>ህከኒች ኤተሮን በርናባስ ሳኦሌ ሀሶተ ተርሴስ ከተመ ኦሮዕዮ። <verse eid="ACT 11:25"/><verse number="26" style="v" sid="ACT 11:26"/>እስን ደጎስ ወክት አንጾክ ከተመ ኣእ ኦሮዕዮ፤ ለሙንኩ ዊመ ዘማን ህከኔ ሄኦ አመዕናኖን ሜጡበ ልግብ መነ ተማርስቶኡ፤ አሳበንት ዎኔሳንከ አንጾካን «ክርስታነ» ዬን ገኤመሰ።<verse eid="ACT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27"/>ህከ ወክት መት-መቱ ነብያኑት ዬሩሳሌሚች አንጾክ ከተመ መርቶኡ። <verse eid="ACT 11:27"/><verse number="28" style="v" sid="ACT 11:28"/>እሳችን መቱ «አጋቦሴ» ዬኖ መንቹ ኬዕይ ኡር ዱንየ አሌን ጉዕማንን ጎሩ እሀኖገ ጠሊሉ አያኑ ለሊሻንስ ኩሎ፤ ሁኩ ጎሩንኩ ሮም ባድ ዎም ዎማ ቀላዉዶሴ ዘማኔን እኮእሃ እቅ።<note caller="-" style="x"><char style="xo" closed="false">11፥28 </char><char style="xt" closed="false"><ref loc="ACT 21:10">ሶቀ. 21፥10</ref>።</char></note> <verse eid="ACT 11:28"/><verse number="29" style="v" sid="ACT 11:29"/>ህካን እኮቤቺሃ አንጾካን ሄኣ አመዕናኑት ገገዉንኩሰ ወልቀሰ ጌሰ ፉሽት ይሁድ ባዶን ዮ አመዕናኖተ ሶኮተ ሙርስጭቶኡ። <verse eid="ACT 11:29"/><verse number="30" style="v" sid="ACT 11:30"/>እሰን ብረ ጭምአት በርናባሴለከ ሳኦሌ አንጋን ዱእ ምነ ባልቀቤቹ ሶኮኡ።<verse eid="ACT 11:30"/></para>
  <chapter eid="ACT 11"/>
  <chapter number="12" style="c" sid="ACT 12"/>
  <para style="s1">አመዕናኖ አሌን እኮ አቡ ያየሙ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1"/>ህከ ዘማን ዎሙ ሄሮድስ መት-መቱ አመዕናኑተ ያዩ ጀመሮ። <verse eid="ACT 12:1"/><verse number="2" style="v" sid="ACT 12:2"/>እስን ያህይ አመቤቱ ያቁበ ሲፊን ሽሲሾስ። <verse eid="ACT 12:2"/><verse number="3" style="v" sid="ACT 12:3"/>ሁኩ ጠዉ አይሁደ ሙንደእሲሾገ ለዕዮ ወክት ጴጥሮሴ በርግ ኡሱርሲሾ፤ ሁኩን እኮሁ ጦሮሹ እቴነን ከበጄኖ ከበጃን ዊመ ሳምንት ኣዜን ዮ በሬኒት እቅ። <verse eid="ACT 12:3"/><verse number="4" style="v" sid="ACT 12:4"/>ሄሮድስ ጴጥሮሴ አፍ ኡሱር ምኒ ኣግሾስ፤ እስን ሻሽግ ከበጃቲች ኤተሮን መን ብርተ ፉሾተ ሰውይ ሾሉ-ሾሉ እክ ተሪን-ተሪን አገርታገ ቶነ ሌሆ ወታደሪሃ ህግስ ኣቶኡ።<note caller="-" style="x"><char style="xo" closed="false">12፥4 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">ፉል. 12፥1-27</ref>።</char></note> <verse eid="ACT 12:4"/><verse number="5" style="v" sid="ACT 12:5"/>ህካን እኮቤቺሃ ጴጥሮሴ ኡሱር ምኔን ጠረኜን አገሬኖት እቅ፤ ጠዉ እኮጎሬ አመዕናኑት ሜጡበ እክ እስተኔሃ ጠረኝት ዱአ አታኢት።<verse eid="ACT 12:5"/></para>
  <para style="s1">መላይኬቹ ጴጥሮሴ ኡሱር ምኒች ፉሼገ</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6"/>ሄሮድስ ጴጥሮሴ ኡመት ብርተ ገስመ ሆንጠህሶተ ሰውዬ በሬን ሀንከዕርተ ጴጥሮሴ ለሞ ሰንሰለቲን ኡሱሬናን ለሞ ዎታደር በላን ኦሰዕዮ እቅ፤ ዎሉ ዎታደሩ ኡሱር ምኒ ኡሮን ኡርት አገርታኢት እቅ። <verse eid="ACT 12:6"/><verse number="7" style="v" sid="ACT 12:7"/>ድንገቴን ቀርች መላይኬቹ ለሌእ፤ ምንስ ኣዙ አበ ዋቅ ዬእ፤ ጴጥሮሴ ምዛሹስ ኡል ኬሽ «ደዕልት ኬእ» ዬስ፤ ጴጥሮሴ አንገተ ኡሱሬመ ሰንሰለቱ አንጋችስ ኡቦ። <verse eid="ACT 12:7"/><verse number="8" style="v" sid="ACT 12:8"/>መላይኬቹንኩ «ቀበቱክ ቆዕር! ጫዕመክ ዎዕር!» ዬስ፤ እስን መላይኬቹ ዬስገ አዕዮ፤ መላይኬቹንኩ ቴሁ «ጋብክ ኦደእ አዎኔኤ» ዬስ። <verse eid="ACT 12:8"/><verse number="9" style="v" sid="ACT 12:9"/>ጴጥሮስን አብል ፉል አዎኞስ፤ ጠዉ እኮጎሬ ጴጥሮስ መናመተ ለአኖ አጉደኖሲት ቤሉ መላይኬቹ አአኖ ጠዉ ሀንቅ አጉጆስበአ። <verse eid="ACT 12:9"/><verse number="10" style="v" sid="ACT 12:10"/>ዎኔ አገሬኖቤቹለከ ለንክ አገሬኖቤቹ ህግ ከተመ ፉሸኖ ብረት ሳንቁ ዮ ቤቹ ኢልቶኡ፤ ሁኩ ብረት ሳንቁ ገዉንኩስ ፈንተዕዮ፤ እሰን ፉልት መቶ ሩካሸ ዎቄን ህጎኡ፤ ወክትንከስ መላይኬቹ እሲች አደ እክ ኦሮዕዮ።<verse eid="ACT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11"/>ጴጥሮስን ቀልቡስ ፈንቀላን «ቀርቹ መላይኬቹስ ሶክ ሄሮድሴ አንጋችለከ አይሁድ ኡመቱ አገርታ ጠዊች ጉዕሚችን ፌሾኤሃ እሁስ ቴ ደጎም» ዬእ።<verse eid="ACT 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12"/>እስን ህከ ጠወ አጥራመቾች ኤተሮን ልግቡ መኑ ሜጡበ ጭምይ ዱአ አአኖ መርየማ ምን ኦሮዕዮ፤ እሴን «ማርቆሴ» ዬኖ ያህዪሃ አመተ እቅ። <verse eid="ACT 12:12"/><verse number="13" style="v" sid="ACT 12:13"/>ጴጥሮስ አብል ሳንቀ ቆጬ ወክት «ሮደ» ዬኖ ህከን ምን ገረዴቹት ለኦተ ብትም ኡሩተ አሜቶኡ። <verse eid="ACT 12:13"/><verse number="14" style="v" sid="ACT 12:14"/>እሴን ጴጥሮሴ ላገተ እሁስ ደጎ ወክት አበ ሙንደኦቤቺሃ ሳንቀ ፈንቱዕናን ምን ደጉደን ኣግ ጴጥሮስ አብሌ ኡሩስ ኩልቶኡ። <verse eid="ACT 12:14"/><verse number="15" style="v" sid="ACT 12:15"/>እሰን እሴተ «በርገጎንት» ይቶሴ፤ ጠዉ እኮጎሬ እሴ «ሀንቅንከ እሶት» ይተን ጠረኝስ ኩልቶሰ፤ እሰን «ጴጥሮሴ አገረኖሃ መላይኬቹ» ይቶኡ።<verse eid="ACT 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16"/>ጠዉ እኮጎሮ ጴጥሮስ ሳንቀ ሰዕምይ ቆጬእ፤ እሰን ፈንት ለኦስ ወክት አበ ገረምሲጭቶኡ። <verse eid="ACT 12:16"/><verse number="17" style="v" sid="ACT 12:17"/>ጴጥሮስ እሰንተ አንጋን ቀቀሽ ጨለ ይታገ አዕይ መገኑ ኡሱር ምኒች ሀት አይ ፉሼስ ጎር ኩሎሰ፤ እስን «ከ ጠወ ያቁብለከ ፈቆ አመዕናኖተ ኩሌ» ይኬዕይ እሳች አደ እክ ዎሉቤቹ ኦሮዕዮ።<verse eid="ACT 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18"/>ኡለት ሶዞ ወክት ዎታደሩ «ጴጥሮስ መ እኮ?» ይተን አበ ጨነቀንቶኡ። <verse eid="ACT 12:18"/><verse number="19" style="v" sid="ACT 12:19"/>ሄሮድስን ጴጥሮሴ ሀሴኖገ አዕይ ሆጎች ኤተሮን ህከ ወክት አገርታ ዎታደረ መረመር ሹል ሾኖተ አዘዦ፤ ህከኒች ኤተሮን ሄሮድስ ይሁድ ባዲች ቄሳር ከተመ ኦሮዕይ ህከኔ አፉዕሌእ።<verse eid="ACT 12:19"/></para>
  <para style="s1">ሄሮድስ ሬዮገ</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20"/>ሄሮድስ ጢሮስለከ ሲዶን ባድ መኒን ኡሙዕርዮ እቅ፤ ሁኩ መኑንኩ ሜጡበ አሜት ዎም ምን ሀላፌቹ ብላስጦሴ ዎሚን እተቀንሶተ ኡጭቶኡ፤ መሰንትስ ባዱሰ እቸተ ደአኖ ህከን ዎም ባዲች እኮቤቺሃት።<verse eid="ACT 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21"/>ዝኜ በር ሄሮድስ ዎም ኦድኑተ ኦደዕይ ኬዕምኝ ቦርጭማን አፉዕል ኡመቲሃስ ጠወአኖሳት እቅ። <verse eid="ACT 12:21"/><verse number="22" style="v" sid="ACT 12:22"/>ኡመቱንኩ «ቲን መገንተ ላገ ቤሉ መንተ ላገበአ!» ይተን ጨንጭቶኡ። <verse eid="ACT 12:22"/><verse number="23" style="v" sid="ACT 12:23"/>ሄሮድስ መገኒሃ ኬዕምኝ ኣሱ ሆጎቤቺሃ ወክትንከስ ቀርች መላይኬቹ ዳፋን አሉስ ዘቡዕለዕይ ሬዮ።<verse eid="ACT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24"/>ጠዉ እኮጎሬ መገን ላገት ጉዕመ ወክት ነጵተንለከ አልባዕልተን መርታኢት እቅ። <verse eid="ACT 12:24"/><verse number="25" style="v" sid="ACT 12:25"/>ህከ ወክት በርናባስለከ ሳኦሊ ሆጉሰ ሹልት ዬሩሳሌሚች አንጾከ ዬኖቤቹ ፈንቀልቶኡ፤ እሰ ፈንቀልት አሜተን «ማርቆሴ» ዬኖ ያህዪ እሳንን ሜጡበ ኣእት አሜቶኡ።<verse eid="ACT 12:25"/></para>
  <chapter eid="ACT 12"/>
  <chapter number="13" style="c" sid="ACT 13"/>
  <para style="s1">በርናባሴለከ ሳኦሌ ተማርቶተ ሶሄመገ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1"/>«አንጾከ» ዬኖ ከተማን አመዕናኖ ኦገት በላን ነብያኑትለከ አስተማረት ሄኦ እቅ፤ እሰን በርናባስ፥ «ገንበለ» ዬኖ ስሞን፥ ቀሬን ባድ ሉክዮስ፥ ባድስ ሾልቅ አፎ ገሸኖ ሄሮድሴን ሜጡበ ነጴ ምናሔትለከ ሳኦሌት እቅ። <verse eid="ACT 13:1"/><verse number="2" style="v" sid="ACT 13:2"/>እሰን ቀርቹ ካደንተንለከ ሶመንተን ዮሀኔን ጠሊሉ አያኑ «በርናባሴለከ ሳኦሌ አን መጠሮም ሆጎተ አደ አዕዬ» ዬሰ።<verse eid="ACT 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 13:3"/>ህከኒች ኤተሮን ሶመንትለከ ዱአ አት አንገሰ አሌሰ አቶች ኤተሮን ሶኮሰ።<verse eid="ACT 13:3"/></para>
  <para style="s1">በርናባስለከ ሳኦል ዊን ረበንቶ «ቆጵሮሰ» ኢልቶገ</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4"/>በርናባስለከ ሳኦል ጠሊለ አያኒን ሶሀንት «ሴሌውቅያ» ዬኖ ከተመ ኢልቶኡ፤ ህከንቤቺች መርከባን ኣግ «ቆጵሮሰ» ዬኖ ባዱ ኢልቶኡ። <verse eid="ACT 13:4"/><verse number="5" style="v" sid="ACT 13:5"/>እሰን «ሰላሚሰ» ዬኖ ከተመ ኢልቶ ወክት አይሁድ ጭምት ምናን መገን ላገተ ተማርስታኢት እቅ፤ ያህይን እሳን ሜጡበ እክ ሀዕለኖሳት እቅ።<verse eid="ACT 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6"/>ህከ ዊን ረበንቶ ኡለተ ጉዕመንከስ ዘህተን «ጳፉ» ዬኖ ከተመ ኢልቶ ወክት «ባርየሱስ» ዬኖ መቱ አይሁድቹ ኪላንቹ ደጎኡ፤ ሁኩ መንቹንኩ ክዝብየ ነብዬቹ እቅ። <verse eid="ACT 13:6"/><verse number="7" style="v" sid="ACT 13:7"/>እስን «ሰርግዮስ ጰዉሎሴ» ዬኖ ገሻንቺን ሜጡበ ሄኣ እቅ፤ ሁኩ ገሻንቹንኩ መገን ላገተ ሞጮጮተ ሀሽ በርናባሴለከ ሳኦሌ እስቤቹ ገእሲሾ። <verse eid="ACT 13:7"/><verse number="8" style="v" sid="ACT 13:8"/>ጠዉ እኮጎሬ ግሪክ መን አፎን «ኤሊማሴ» ዬን ገኤኖ ኪላንቹ ባርየሱስ ሁኩ ገሻንቹ አመዕንበገ ሀሽ በርናበሴንለከ ሰኦሌን ሀንበዕለሙ ጀመሮ። <verse eid="ACT 13:8"/><verse number="9" style="v" sid="ACT 13:9"/>እኮጎሬ «ጰዉሎሴ» የመሞ ሳኦል ጠሊለ አያኒን ዊም ህከ መንቹ ቱክ ይ ለአን <verse eid="ACT 13:9"/><verse number="10" style="v" sid="ACT 13:10"/>«አት ተንኩትለከ ሂሉ ጠዉ ጉዕሙንኩ ዊሞሄ እልቢስ ቤቱ፤ ጡመርቺሃ ጉዕሚንከ ዲኑ፤ ቀርችኔ ጌጥዬ ዎቀሃ ሾክሱ አጉርታንትበእንዶ? <verse eid="ACT 13:10"/><verse number="11" style="v" sid="ACT 13:11"/>ቴሱ ሁኩዕኑን ቀርች አንገት ዎቀርታሄ፤ ህካን እኮቤቺሃ ቆቀ እክ ቀዎ ወክቲሃ አር ኑር ለኣንትበአ» ዬስ።</para>
  <para style="p" vid="ACT 13:11">ወክትንከስ ጉንጄገለከ ቱንስችገ ዮርቹ እልስ እፍሾ፤ እስን አንገስ አፍ መሰገኖስ መነ መዲስ ሀሱ ጀመሮ። <verse eid="ACT 13:11"/><verse number="12" style="v" sid="ACT 13:12"/>ሁኩ ገሻንቹንኩ ቀርችተኔሃ ተማርስቶ ትምርቲን አጀብሲጬቤቺሃ ህከ ጠወ ለዕዮ ወክት መገኖን አመዕኔእ።<verse eid="ACT 13:12"/></para>
  <para style="s1">በርናባስለከ ጳዉሎስ ጲስድያን ሄኣ «አንጾከ» ኦሮኡሰ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13"/>ህከኒች ኤተሮን ጰዉሎስለከ ጃለስ መርከባን ኣግ «ጳፎሰ» ዬኖ ከተሚች «ጵንፍልየ» ዬኖ ባዶን ሄኣ «ጴርጌ» ከተመ መርቶኡ፤ ያህይ እሳች አደ እክ ዬሩሳሌመ ፈንቀል ኦሮዕዮ። <verse eid="ACT 13:13"/><verse number="14" style="v" sid="ACT 13:14"/>እኮጎሬ እሰ ህከን ጴርጌ ከተሚች «ጵስድያ» ዬኖ ባዶን ሄዕዮ ዎሉ «አንጾከ» ዬኖ ከተመ ኢልቶኡ፤ ሰምበት በሬን መቶ አይሁድ ጭምት ምኒ ኣግ አፉዕልቶኡ።<note caller="+" style="f"><char style="fqa" closed="false">ሰንበት በር፦ </char><char style="ft" closed="false">ዩ አይሁዳን ሆፍቹተ ዩሃን።</char></note> <verse eid="ACT 13:14"/><verse number="15" style="v" sid="ACT 13:15"/>ሕግለከ ነብያኖ መጻፈ አነበቦች ኤተሮን ጭምት ምኒ ገሽታእሩ «አመኤ ኦሶ! መነ ሸዜነንተ ጠዉ ዮህዕኔ ጎር ኩሌ» ይት እሰቤቹ ሶኮኡ። <verse eid="ACT 13:15"/><verse number="16" style="v" sid="ACT 13:16"/>ህካን እኮቤቺሃ ጳዉሎስ ኬዕይ ኡር ኡመት አንጋንተስ ቀቀሽ ጨለየኖገ አዕይ «አዕኑ እስራኤል መኑለከ መገኑ ዋጅቴነንተ ኡመቱ! ከበ ሞጮጭዬ! <verse eid="ACT 13:16"/><verse number="17" style="v" sid="ACT 13:17"/>ከን እስራኤል ኡመት መገኑ ዎኔ አናኑኔ መጠር ግብጽ ባዶን ኮሀ እክ አፉዕልቶ ወክት ልግብ ኡመት አዕይ ሎረ ዎልቃንከስ ህከንቤቺች ፉሼእ።<note caller="-" style="x"><char style="xo" closed="false">13፥17 </char><char style="xt" closed="false"><ref loc="EXO 1:7">ፉል. 1፥7</ref>፤ <ref loc="EXO 12:51">12፥51</ref>።</char></note> <verse eid="ACT 13:17"/><verse number="18" style="v" sid="ACT 13:18"/>ሸይሉ ዘማን ኢለ ኡለ ኡድማን አታዕሌሰ።<note caller="+" style="f"><char style="fqa" closed="false">አታዕሌሰ የኖሁ፦ </char><char style="ft" closed="false">መት-መቱ ሉህ ክታበት «አገሮሰ» ይታአ።</char></note><note caller="-" style="x"><char style="xo" closed="false">13፥18 </char><char style="xt" closed="false"><ref loc="NUM 14:34">ዘኁ. 14፥34</ref>፤ <ref loc="DEU 1:31">ዘዳ. 1፥31</ref>።</char></note> <verse eid="ACT 13:18"/><verse number="19" style="v" sid="ACT 13:19"/>ህከኒች ኤተሮን ከነአን ባዶን ለመለ ደቦ ኡመት ቤሽ ኡለሰ እሳሃ ረገእሲሾ።<note caller="-" style="x"><char style="xo" closed="false">13፥19 </char><char style="xt" closed="false"><ref loc="DEU 7:1">ዘዳ. 7፥1</ref>፤ <ref loc="JOS 14:1">ኢያ. 14፥1</ref>።</char></note> <verse eid="ACT 13:19"/><verse number="20" style="v" sid="ACT 13:20"/>ህከኒች ኤተሮን ሾል ጥብተ ኦንታዮ ዘማን ጌሰ ነብዬቾ ሳሙኤሌ ወክቱ ኢሎተ ኢለ ዳኛኑት ገሽታገ አዕዮሰ።<note caller="-" style="x"><char style="xo" closed="false">13፥20 </char><char style="xt" closed="false"><ref loc="JDG 2:16">መሳ. 2፥16</ref>፤ <ref loc="1SA 3:20">1 ሳሙ. 3፥20</ref>።</char></note><verse eid="ACT 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 13:21"/>«እሰን ህከኒች ኤተሮን ዎመ ኣሶሰተ ጠዕምቶኡ፤ መገኑ ቢንያሜ ደቦች ቂስ ቤቱ ሳኦሌ ሸይሉ ዘመን ዎመ አዕዮሰ።<note caller="-" style="x"><char style="xo" closed="false">13፥21 </char><char style="xt" closed="false"><ref loc="1SA 8:5">1 ሳሙ. 8፥5</ref>፤ <ref loc="1SA 10:21">10፥21</ref>።</char></note> <verse eid="ACT 13:21"/><verse number="22" style="v" sid="ACT 13:22"/>ሳኦሌ ዎምነቲች ድሪሾች ኤተሮን ዳዉዴ ዎመ አዕዮሰ፤ መገኑ ዳዉዴተኔሃ ‹ገይኤ ቀልብገ ዮኢሃ አን ዬም ጠወ ጉዕመንከ አአኖ እሴዬ ቤቱ ደዉዴ ደኤም› ይ መሰከሮስ።<note caller="-" style="x"><char style="xo" closed="false">13፥22 </char><char style="xt" closed="false"><ref loc="1SA 13:14">1 ሳሙ. 13፥14</ref>፤ <ref loc="1SA 16:12">16፥12</ref>፤ <ref loc="PSA 89:20">መዝ. 89፥20</ref>።</char></note> <verse eid="ACT 13:22"/><verse number="23" style="v" sid="ACT 13:23"/>ህከን መንች ዘሬች መገኑ ተብሴስ ላገ ሃሊን እስራኤል መኒሃ ጡምሳንቹ ኢሰ ኤቦሰ። <verse eid="ACT 13:23"/><verse number="24" style="v" sid="ACT 13:24"/>ኢስ አሜቱዕነ ብርተ ጠመቃንቹ ያህይ እስራኤል መኒሃ ጉዕሚንከ ጩብ ቶበት ፈንቀልት ጠመቀንታገ ተማርስዮ እቅ።<note caller="-" style="x"><char style="xo" closed="false">13፥24 </char><char style="xt" closed="false"><ref loc="MRK 1:4">ማር. 1፥4</ref>፤ <ref loc="LUK 3:3">ሉቃ. 3፥3</ref>።</char></note> <verse eid="ACT 13:24"/><verse number="25" style="v" sid="ACT 13:25"/>ያህይ ሆጉስ ሹሎች ኤተሮን ‹ኤሳሃ አዬት ይቴን ሰውይቴነንታት? አን አሜተኖ ይቴን አገርቴነንታሃበአ፤ ጠዉ እኮጎሬ አን ጫመስ ወደሩ ሂሮተ በቀእባሃ ኢች ኤተሮን አሜተኖ› ዬእ።<note caller="-" style="x"><char style="xo" closed="false">13፥25 </char><char style="xt" closed="false"><ref loc="MAT 3:11">ማቶ. 3፥11</ref>፤ <ref loc="MRK 1:7">ማር. 1፥7</ref>፤ <ref loc="LUK 3:16">ሉቃ. 3፥16</ref>፤ <ref loc="JHN 1:20">ያህ. 1፥20</ref>፤ 27።</char></note><verse eid="ACT 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26"/>«አዕኑ እብረሂም ዘሬች ከለቀንቴንታ አመኔ ኦሱትለከ መገኑ ዋጅቴነንተ ኡመቱ! ጡም ሶህኑት ሶሃንቶኢሁ ኔሳህት። <verse eid="ACT 13:26"/><verse number="27" style="v" sid="ACT 13:27"/>ጠዉ እኮጎሬ ዬሩሳሌማን ሄኣእሩለከ ሀለቃሰ ኢስ ጡምሳንቹ እሁስ ደጎበአ፤ ሰምበት በሬን አነበቤኖ ነብያከ መጻፈተ አጥራመቱዕናን እስ አሌን ፈረዶ ወክት ራጉስ ዊመኖገ አቶኡ። <verse eid="ACT 13:27"/><verse number="28" style="v" sid="ACT 13:28"/>ኢሰ ሬሆተ ኢልሰኖስ መሰተ ደግባጎሬሁ ገሻንቹ ጵላጦስ ሾስተ ኡጭቶኡ።<note caller="-" style="x"><char style="xo" closed="false">13፥28 </char><char style="xt" closed="false"><ref loc="MAT 27:22-23">ማቶ. 27፥22-23</ref>፤ <ref loc="MRK 15:13-14">ማር. 15፥13-14</ref>፤ <ref loc="LUK 23:21-23">ሉቃ. 23፥21-23</ref>፤ <ref loc="JHN 19:15">ያህ. 19፥15</ref>።</char></note> <verse eid="ACT 13:28"/><verse number="29" style="v" sid="ACT 13:29"/>እስተኔሃ ከተበሞሃ ጉዕመንከ አት ሹልቶች ኤተሮን ሰቀለሞ መስቀሊች ድሪስ ሞጎኡ፤<note caller="-" style="x"><char style="xo" closed="false">13፥29 </char><char style="xt" closed="false"><ref loc="MAT 27:57-61">ማቶ. 27፥57-61</ref>፤ <ref loc="MRK 15:42-47">ማር. 15፥42-47</ref>፤ <ref loc="LUK 23:50-56">ሉቃ. 23፥50-56</ref>፤ <ref loc="JHN 19:38-42">ያህ. 19፥38-42</ref>።</char></note> <verse eid="ACT 13:29"/><verse number="30" style="v" sid="ACT 13:30"/>ጠዉ እኮጎሬ መገኑ እሱ ሬሆች ኬሾስ። <verse eid="ACT 13:30"/><verse number="31" style="v" sid="ACT 13:31"/>ኢስ እሲን ሜጡበ ገሊላች ዬሩሳሌመ አሜቶሀኑኡተ ልግብ በር ለሌሰ፤ እሰን ቴሱ ኡመት ብሬን እስተ ምስክረ።<note caller="-" style="x"><char style="xo" closed="false">13፥31 </char><char style="xt" closed="false"><ref loc="ACT 1:3">ሶቀ. 1፥3</ref>።</char></note> <verse eid="ACT 13:31"/><verse number="32" style="v" sid="ACT 13:32"/>ኣእን አሜንቶም ሃዕሮ ተሽት ላገት መገኑ አናካተኔ ኣጎ ተብሴ ላገት <verse eid="ACT 13:32"/><verse number="33" style="v" sid="ACT 13:33"/>ኢሰ ሬሆች ኬሲንከስ ህከ ተብሳሃ ኒን ኦሶንተሰ ዊንሽዮኡ፤ ሁኩንን ደውድ መጻፋን ለንክ መዝሙራን</para>
  <para style="q" vid="ACT 13:33">‹አት ቤቱሃኤ፤ አን ከበር እሎንኬ!›</para>
  <para style="m" vid="ACT 13:33">የመም ከተበሞጋት።<note caller="-" style="x"><char style="xo" closed="false">13፥33 </char><char style="xt" closed="false"><ref loc="PSA 2:7">መዝ. 2፥7</ref>።</char></note> <verse eid="ACT 13:33"/><verse number="34" style="v" sid="ACT 13:34"/>ህትን ሸሙዕነ መገኑ ሬሆች ኬሽ ለልሶተ</para>
  <para style="q1" vid="ACT 13:34">‹ጠሊለ አመዕነንቶ በረከተ</para>
  <para style="q1" vid="ACT 13:34">ደዉዴ ኣሴሚሃ ኣሳንክዕኔ› ይ ጠወዕዮኡ።<note caller="-" style="x"><char style="xo" closed="false">13፥34 </char><char style="xt" closed="false"><ref loc="ISA 55:3">ኢሳ. 55፥3</ref>።</char></note> <verse eid="ACT 13:34"/><verse number="35" style="v" sid="ACT 13:35"/>ህትን ደውድ መጻፋን ዎሎ ቤቾን</para>
  <para style="q1" vid="ACT 13:35">‹ኪ ጠሊሉ ካዲንቹክ ሎድ ኣዜን ሸሞተ ሰዕም ይታንትበአ› የኖ።<note caller="-" style="x"><char style="xo" closed="false">13፥35 </char><char style="xt" closed="false"><ref loc="PSA 16:10">መዝ. 16፥10</ref>።</char></note><verse eid="ACT 13:35"/></para>
  <para style="m">
    <verse number="36" style="v" sid="ACT 13:36"/>ጠዉ እኮጎሬ ደዉድ ሄዕዮ ዘማኔን መገኑ ኢተኖገ ሆጉስ ሹሎች ኤተሮን ሬይ አናካንተስን ሞገም ሸሞኡ። <verse eid="ACT 13:36"/><verse number="37" style="v" sid="ACT 13:37"/>እኮጎሬ መገኑ ሬሆች ኬሾሲሁ ሸሞበአ። <verse eid="ACT 13:37"/><verse number="38" style="v" sid="ACT 13:38"/>ህካን እኮቤቺሃ አመኤ ኦሶ! ጩብ አጉረሙ ደገሞሁ ህከን ኢሲን እሁስ ተማርሴማህዕኔገ ደጌ። <verse eid="ACT 13:38"/><verse number="39" style="v" sid="ACT 13:39"/>ህትን እሲን አመዕነኖሁ ጉዕሙንኩ ሙሲን ኣሰሞ ሕጊን ነጠ ፉሎተ አታልበ ጩቢች ጉዕሚችን ነጠ ፉለኖ። <verse eid="ACT 13:39"/><verse number="40" style="v" sid="ACT 13:40"/>ህካን እኮቤቺሃ ነብያኖን ህት የመም ጠወአሞሁ ኢለኖህዕኔበእገ አገዕርዬ፤<verse eid="ACT 13:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41"/>እስን</para>
  <para style="q1" vid="ACT 13:41">‹አዕኑ ቀለዴነንተሩ! ለዕዬ! ገረምሲጭዬ! በዕዬሁ!</para>
  <para style="q1" vid="ACT 13:41">መሰንትስ አይ ኩሎህዕኔጎሬ</para>
  <para style="q1" vid="ACT 13:41">አመዕንቴንበ ሆጉተ</para>
  <para style="q1" vid="ACT 13:41">ዘማኔንከክዕኔ አኣም›» የኖ ዬእ።<verse eid="ACT 13:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42"/>ጳዉሎስለከ በርናባስ ጭምት ምኒች ፉልተን ከ ጠወ አሜተኖ ሰምበት በሬተ ፈንቀሽት ኩልታገ መኑ ኡጭቶሰ። <verse eid="ACT 13:42"/><verse number="43" style="v" sid="ACT 13:43"/>ጭምት ምኒ መኑ ፉሎ ወክት ልግቡ አይሁዱሁ አይሁድ እምነቴን ፈንቀልቶእሩ ጳዉሎሴለከ በርናባሴ አዎንቶኡ፤ ጳዉሎስለከ በርናባስ ህከ መነ መገን ኣስቶን ጠረኝት ሄኣገ ሸዞሰ።<verse eid="ACT 13:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44"/>ሳምንትስ ሰንበት በር ከተማንከስ ሄአኖ መኒች ልግቡሰ ቀርች ላገተ ሞጮጮተ ጭምዬእ። <verse eid="ACT 13:44"/><verse number="45" style="v" sid="ACT 13:45"/>ጠዉ እኮጎሬ አይሁዱ ኡመትስ በትኝ ለኦ ወክት ጢቅስ ጳዉሎስ ጠወአኖ ጠወ ግብ ጳዉሎሴ ቦሮርቶኡ። <verse eid="ACT 13:45"/><verse number="46" style="v" sid="ACT 13:46"/>እኮጎሬ ጳዉሎስለከ በርናባስ መለልት «መገን ላገተ ሄጬን ክዕኔሃ ጠወኡ ሀስሰኖ፤ ጠዉ እኮጎሬ አዕኑ ‹ቶንጋምበአ› ይቴን ዘላለሚሃ ጉዕሚንከ ሄኤኖ ሄኡ ገበእባሃ አቴን ገጎንከክዕኔ ፈረዴንተቤቺሃ ነኡ ጌኝአዕን አይሁደ እህበ መንቤቹ መርናም። <verse eid="ACT 13:46"/><verse number="47" style="v" sid="ACT 13:47"/>መሰንትስ ቀርቹ ‹ኡለ ዳንገ ኢሎተ ኢለ ጡሙ ኤቦኖተ አይሁደ እህበ መኒሃ ኑሪ አዕዮንኬ›» ይ አዘዦኔ ይቶኡ።<verse eid="ACT 13:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48"/>አይሁደ እህበ መኑ ህካን ሞጮጭቶ ወክት ሙንደኦኡ፤ ቀርች ላገንተ ሎርስቶኡ፤ ዘላለሚም ሄኢሃ መጠረንቶእሩ ጉዕሙንኩ አመዕንቶኡ።<verse eid="ACT 13:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49"/>ቀርች ላገት ህከን ባዶን ጉዕማንን አልባዕልቶኡ። <verse eid="ACT 13:49"/><verse number="50" style="v" sid="ACT 13:50"/>አይሁድ አዎንሳኑት አይሁድ አመዕነቱ ቶጎ መገኑ ዋጅታ ቀባጣሙ ሜንቱለከ ሎርሎሩ መኑ አደሜኖገ አት ጳዉሎሴሃለከ በርናባሴሃ ኦርሸት ኢልታገ አት ህከን ባዲች ሸርት ፉሽቶኡ። <verse eid="ACT 13:50"/><verse number="51" style="v" sid="ACT 13:51"/>ጳዉሎስለከ በርናባስ ህከን መኒሃ ጡር እሆተ ሎከሰ ትበ ግግሽት እቆንዮም ከተመ መርቶኡ።<note caller="-" style="x"><char style="xo" closed="false">13፥51 </char><char style="xt" closed="false"><ref loc="MAT 10:14">ማቶ. 10፥14</ref>፤ <ref loc="MRK 6:11">ማር. 6፥11</ref>፤ <ref loc="LUK 9:5">ሉቃ. 9፥5</ref>፤ <ref loc="LUK 10:11">10፥11</ref>።</char></note> <verse eid="ACT 13:51"/><verse number="52" style="v" sid="ACT 13:52"/>አመዕናኑት ሙንዲኖንለከ ጠሊለ አያኒን ዊንቶኡ።<verse eid="ACT 13:52"/></para>
  <chapter eid="ACT 13"/>
  <chapter number="14" style="c" sid="ACT 14"/>
  <para style="s1">ጳዉሎስለከ በርናባስ «እቆንዮነ» ከተመ መርቶገ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1"/>ህከኒች ኤተሮን ወዕና ሮሶገን ጳዉሎስለከ በርናባስ እቆንዮናን ዮ አይሁድ ጭምት ምኒ ኣጎኡ፤ ህከን ቤቾን ልግቡ አይሁዱለከ ግሪክ መኑ አመዕንቶተ ኢለ ተማርስቶኡ። <verse eid="ACT 14:1"/><verse number="2" style="v" sid="ACT 14:2"/>ጠዉ እኮጎሬ አመዕንትበ አይሁዱ አይሁደ እህበ መነ ኬስ አመዕናኖ አሌን ብተተ ኬሶኡ። <verse eid="ACT 14:2"/><verse number="3" style="v" sid="ACT 14:3"/>ህካን እኮቤቺሃ ጳዉሎስለከ በርናባስ ቀርች ላገተ መለልት ጠወአን ልግብ ወክት ህከኔ አገርቶኡ፤ ቀርቹ አጅበተለከ አጀብሲሰኖ ጠወ አንጋንከሰ አታገ ወልቀተ ኣስ እስ አስቶ ላገት ሀንቅ እሁስ ለሊሰኖት እቅ። <verse eid="ACT 14:3"/><verse number="4" style="v" sid="ACT 14:4"/>ጠዉ እኮጎሬ ከተማንከስ ሄዕዮ መኑ ለሙ አደ እክ መቱስ አዱ አይሁድ አደለከ ደሩስ አዱ አሳበ አደ እኮኡ።<verse eid="ACT 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 14:5"/>ጠዉ እኮጎሬ አይሁዱለከ አይሁደ እህቡ ዎሉ መኑ ሀለቃንከሰ ሜጡበ እክ ጳዉሎሴለከ በርናባሴ አበ ኦሪሶተለከ ክኒን ቀሶተ ሀሶኡ። <verse eid="ACT 14:5"/><verse number="6" style="v" sid="ACT 14:6"/>ጳዉሎስለከ በርናባስ ህከ ጠወ ሞጮጭቶ ወክት «ልስጥረለከ ደርቤታ» ዬኖ ልቃኦን ባድ ከተመተለከ አዝጋጌንከስ ዮ ባዱ ሁንት መርቶኡ። <verse eid="ACT 14:6"/><verse number="7" style="v" sid="ACT 14:7"/>ህከን ቤቾን ተሽት ላገተ ዱዱብስቶኡ።<verse eid="ACT 14:7"/></para>
  <para style="s1">ጳዉሎስለከ በርናባስ ልስጥራንለከ ደርቤ ከተማን ተማርስቶገ</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8"/>ልስጥራን ሎከስ ናፎ መቱ መንቹ ሄዕዮ እቅ፤ ኩ መንቹ እለሞች ኬሽ ናፈ እኮቤቺሃ ሎካንከስ ሃም ደገኖበአ። <verse eid="ACT 14:8"/><verse number="9" style="v" sid="ACT 14:9"/>ኩ መንቹ ጳዉሎስ ጠወአኖሃ አፉዕል ሞጮጨኖት እቅ፤ ጳዉሎስ ህከ መንቹ ቱክ ይ ለዕይ ጡሞተ አታልሲሰኖ አመዕነቱ ዮስገ ለዕዮ ወክት <verse eid="ACT 14:9"/><verse number="10" style="v" sid="ACT 14:10"/>ሎረ ላጋን «ጌጥ ይት ሎካንከክ ኡር!» ዬ ወክት መንቹንኩ ኬዕይ ሃሙ ጀመሮ። <verse eid="ACT 14:10"/><verse number="11" style="v" sid="ACT 14:11"/>መኑ ጳዉሎስ አዕዮ ጠወ ለዕዮ ወክት ልቃኦን አፎን «ሽርኬ መገናከት መነ አጉድ ኒቤቹ ድርቶኡ» ይት ሎረ ላጋን ጠወኦኡ። <verse eid="ACT 14:11"/><verse number="12" style="v" sid="ACT 14:12"/>እሰን በርናባሴ «ድያ»<note caller="+" style="f"><char style="fqa" closed="false">ዲያ፦ </char><char style="ft" closed="false">«ድያ» ዬኖሁ ግሪክ መን አፎን ግሪክ ባዶን ሄኣ ልግብየ ኪላኖች ጉዕሚችሰን ሎረሃን። «ሄርሜነ» ዬኖሁ ግሪክ ባድ መን አፎን «ድያ» ዬኖ ሎረ ኪላንቺሃ ሶቀመኖሃ እቅ።</char></note> ይቶኡ፤ ህትን ልግብ ወክት ጠወአኖሃ እኮቤቺሃ ጳዉሎሴ «ሄርሜነ» ይቶስ። <verse eid="ACT 14:12"/><verse number="13" style="v" sid="ACT 14:13"/>ከተሚች አብሌን ሄዕዮ ድያ ሰገዴኖስ ምኒ ቂስቹ ዎርጃመተለከ ሸፎገ መክሴመ ቦብሉተ ከተመ ኣጌኖ ኡሮቤቹ ኤብ ኡመቲን ሜጡበ ጳዉሎሴሃለከ በርናባሴሃ ክትም ሆንጠህሶተ ሀሾ።<verse eid="ACT 14:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14"/>ጠዉ እኮጎሬ ጳዉሎስለከ በርናባስ ህከ ጠወ ሞጮጭቶ ወክት ህልቅ ኦድኑሰ ፊልት ያርተን መንቤቹ ደጉደን መርት <verse eid="ACT 14:14"/><verse number="15" style="v" sid="ACT 14:15"/>«ኮ መነ! ከ ጠወ ሚሃ አቴነንታት? ነኡ ክዕኔገን ዮምሃ መነ፤ ነኡ ከቤቹ አሜንቶሚሁ አዕኑ ከን ተሰ ጠዊች ገበላ ዋልቴን ሰማ፥ ኡለተ፥ ባረለከ ኣዜንከስ ዮርቹ ጉዕመንከ ከለቆለከ ሄአኖ ካሊቅ አደ ፈንቀልቴነንተገ ተሽት ላገተ ኩልኖህዕኔታት።<note caller="-" style="x"><char style="xo" closed="false">14፥15 </char><char style="xt" closed="false"><ref loc="EXO 20:11">ፉል. 20፥11</ref>፤ <ref loc="PSA 146:6">መዝ. 146፥6</ref>።</char></note> <verse eid="ACT 14:15"/><verse number="16" style="v" sid="ACT 14:16"/>ህጎ ዘማኔን ኡመቱ ጉዕሙንኩ ገይሰ ሃሽኣቶገ ሄኦተ መገኑ ጌኝ አዕይ አጉሮሰ። <verse eid="ACT 14:16"/><verse number="17" style="v" sid="ACT 14:17"/>እሁን ቤሉ እስ ጎደበ ላፈ መገኑ እሁስ መሰከረኖ ጡመ ሆጉተ አኡ አጉሮበአ፤ መሰንትስ ሰሜች ጤነ ኡበኖገ አዕዮህዕኔ፤ ጡመ አቶተ ኣሴህዕኔ፤ እቻንለከ ሙንዲኖን ቀልብክዕኔ ሰገብተ ዊንሼእ» ይቶኡ። <verse eid="ACT 14:17"/><verse number="18" style="v" sid="ACT 14:18"/>አሳበት ኬንከ ጠወኦጎሬሁ ኡመቱ እሳሃ ክትም ሆንጠህሳበእገ ከንቶኢሁ አበ ኦርጨቀንቲት።<verse eid="ACT 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19"/>እኮጎሬ አይሁዱ አንጾክለከ እቆንዮን ከተሚች ህከ ቤቹ አሜት ኡመት ሂለ አድመተ አማልሲስ ጳዉሎሴ ክኒን ቀስ ሬዮ አጉጃንሰ ጎሾሽት ከተሚች አብል ፉሽቶኡ። <verse eid="ACT 14:19"/><verse number="20" style="v" sid="ACT 14:20"/>ጠዉ እኮጎሬ አዎንታስሩ አሜት መዴስ ኡርቶ ወክት ኬዕይ ከተመ ኣጎ፤ ለንክ በር በርናባሴንን ሜጡበ «ደርቤ» ዬኖ ከተመ ኦሮዕዮ።<verse eid="ACT 14:20"/></para>
  <para style="s1">ጳዉሎስለከ በርናባስ ሶርይ ባዶን ዮ አንጾክ ከተመ ፈንቀልት መርቶገ</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21"/>ጳዉሎስለከ በርናባስ «ደርቤተ» ዬኖ ከተማን ተሽት ላገተ ተማርስ ልግብ መነ ኢሰ አዎንታረ አቶኡ፤ ህከኒች ኤተሮን ልስጥረለከ እቆንዮነ ህግ «አንጾከ» ዬኖ ከተመ ፈንቀልት መርቶኡ። <verse eid="ACT 14:21"/><verse number="22" style="v" sid="ACT 14:22"/>ህከን ከተማን ዮ አመዕናኖ ቀልብ ጠረኝሰን፥ አመዕነቶንከሰ ጠረኝት ሄኣገ ሸዘንለከ «መገን ዎምነቱ ኣጎኖተ ልግብ ኦርሸተ ቶጉ ሀስሰኖ» ይተን ተማርስታኢት እቅ። <verse eid="ACT 14:22"/><verse number="23" style="v" sid="ACT 14:23"/>እሰን ቤቾን ቤቾን ዮ አመዕናኖተ ባልቅ ሾንቶኡ፤ ሶመንቶችለከ ዱአ አቶች ኤተሮን እሰ አመዕንቶ ቀርቺሃ ኤገተ ህግስ ኣቶኡ።<verse eid="ACT 14:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24"/>እሰን «ጵስድየ» ዬኖ ባዲን ህግ «ጵንፍልየ» ዬኖ ባዱ አሜቶኡ። <verse eid="ACT 14:24"/><verse number="25" style="v" sid="ACT 14:25"/>«ጴርገ» ዬኖ ከተማን መገን ላገተ ተማርስቶች ኤተሮን «አጣልየ» ዬኖ ከተመ መርቶኡ። <verse eid="ACT 14:25"/><verse number="26" style="v" sid="ACT 14:26"/>ህከንቤቺች መርከባን ኣግ ሶርያን ዮ አንጾከ ፈንቀልቶኡ፤ ሁኩ አንጾክ ከተሙ ቴሱ አት ሹልቶ ሆጎተ ፉልቶ ወክት መገን ኣስቶተ ህግሴን ኤገተ ኣሴመሰሃ ቤቹ እቅ።<verse eid="ACT 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 14:27"/>ህከ ቤቹ ኢልቶ ወክት አመዕናኑተ ጉዕመንከ ሜጡበ ጭምአት መገኑ እሳን ሜጡበ አዕዮ ጠወ ጉዕመንከለከ አይሁደ እህቡ መኑ መገኑ አመዕንቶተ ሀት አዕይ ዎቃ ፈኞሰጎር ኩልቶኡ። <verse eid="ACT 14:27"/><verse number="28" style="v" sid="ACT 14:28"/>እሰን ህከኔ አመዕናኖን ሜጡበ ልግብ ወክት አፉዕልቶኡ።<verse eid="ACT 14:28"/></para>
  <chapter eid="ACT 14"/>
  <chapter number="15" style="c" sid="ACT 15"/>
  <para style="s1">ዬሩሳሌማን እኮ ኦገትተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1"/>መት-መቱ መኑ ይሁድ ባዲች አንጾክ ከተመ መርት «ሙስ ሕግገ ጡርከመንቴንበጎሬ ጡምቴነንተበአ» ይት አመዕናኑተ ተማርሱ ጀመርቶኡ።<note caller="-" style="x"><char style="xo" closed="false">15፥1 </char><char style="xt" closed="false"><ref loc="LEV 12:3">ሌዌ 12፥3</ref>።</char></note> <verse eid="ACT 15:1"/><verse number="2" style="v" sid="ACT 15:2"/>ጳዉሎስለከ በርናባስ ህከን ጠውተኔሃ መኒንከስ አበ ብተንት ኦደንቶቤቺሃ እሰለከ ህከን ባድ አመዕናኖች መት-መቱ ዬሩሳሌማን ዮ ሶቀማኖቤቹለከ ባልቅቤቹ መርታገ ወሰነሞ።<verse eid="ACT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3"/>ህካን እኮቤቺሃ እሳንከ አመዕናኑት ዎቄሃሰ ሽንቅተ ኣት ሶካንሰ አይሁደ እህቡ መኑ ኢስ አደ ፈንቀሉሰ ኩልተን ፍንቄንለከ ሰማርይ ባዲን ህጎኡ፤ ሁኩ ጠዉ አመዕናኑተ ጉዕመንከ አበ ሙንዲሲሾ። <verse eid="ACT 15:3"/><verse number="4" style="v" sid="ACT 15:4"/>እሰን ዬሩሳሌመ ኢልቶ ወክት አመዕናኑት፥ አሳበትለከ ባልቀት «ሀበይ ወገሬቲን አሜቴን» ይት ቶጎሰ፤ ህትን መገኑ እሳን ሜጡበ አዕዮ ጠወ ጉዕመንከ ዬሩሳሌማን ዮ መኒሃ ኩልቶኡ። <verse eid="ACT 15:4"/><verse number="5" style="v" sid="ACT 15:5"/>ጠዉ እኮጎሬ ፈርሳዌ አዲች አመዕንቶ መኒች መት-መቱ ኬእ «ህከ አይሁደ እህበ መነ ጡርከመንታገለከ ሙስ ሕገ አገርታገ አኡ ሀስሰኖኔ» ይቶኡ።<verse eid="ACT 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6"/>አሳበትለከ ባልቀት ህከን ጠውተኔሃ አማዕለንቶተ ጭምይቶኡ። <verse eid="ACT 15:6"/><verse number="7" style="v" sid="ACT 15:7"/>አበ ኦዶኢች ኤተሮን ጴጥሮስ ኬዕይ «አመኤ ኦሶ! አይሁደ እህቡ ኡመቱ ኢ አፌች ተሽት ላገተ ሞጮጭት አመዕንቶተ መገኑ ሄጭ ኤሳሃ ክዕኔ በሊች መጠሩስ ደጌነንተ። <verse eid="ACT 15:7"/><verse number="8" style="v" sid="ACT 15:8"/>መን ቀልብ ደገኖ መገኑ ጠሊለ አያኒን ኔሳሃ ኣሴ ሃሊን እሳሃ ኣሲን መሰከሮኡ።<note caller="-" style="x"><char style="xo" closed="false">15፥8 </char><char style="xt" closed="false"><ref loc="ACT 2:5">ሶቀ. 2፥5</ref>፤ <ref loc="ACT 10:44">10፥44</ref>።</char></note> <verse eid="ACT 15:8"/><verse number="9" style="v" sid="ACT 15:9"/>ቀልብሰ አመዕነቲን ነጠ አዕዮቤቺሃ እሰለከ ኒ በላን መት አደዶመታ አዕዮበአ። <verse eid="ACT 15:9"/><verse number="10" style="v" sid="ACT 15:10"/>ህካን እኮች አናከኔለከ ነኡ እጅኖተ አታልንበ እጅነተ አመዕናኖተ እጅሲሴነን ሚሃት መገኑ ፌተንቴነንታት? <verse eid="ACT 15:10"/><verse number="11" style="v" sid="ACT 15:11"/>ጠዉ እኮጎሬ ነኡ ጡምናሚሁ እሰገን ቀርቾ ኢስ አያኒን እሁስ አመዕንናም» ዬሰ።<verse eid="ACT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12"/>ህከ ወክት ጭምዬ መኑ ጉዕሙንኩ ጨለ ዬእ፤ ህትን በርናባስለከ ጳዉሎስ አይሁደ እኮበእ መን በላን እሰ አዲን መገኑ አዕዮ አጅበተለከ አጀብሲሰኖ ጠወ ጉዕመንከ ኩልተን ሞጮጭታኢት እቅ። <verse eid="ACT 15:12"/><verse number="13" style="v" sid="ACT 15:13"/>እሰን ጠወእ ሹልቶች ኤተሮን ያቁብ ፈንቀሽ «አመኤ ኦሶ! ህንዴ ሞጮጭዬ! <verse eid="ACT 15:13"/><verse number="14" style="v" sid="ACT 15:14"/>መገኑ አይሁደ እህበ መኒች ሱዕሚንከስ ገአመኖ ኡመት በሊችሰ መጠር ወዕና ዳንዴሰገ ስሞን ኩሎኡ። <verse eid="ACT 15:14"/><verse number="15" style="v" sid="ACT 15:15"/>ከን ሰውቲን ነብያከ ላገት መቱ እክ ኣገንቀንታአ፤ እስን ህት የመም ከተበሞሃን፦<verse eid="ACT 15:15"/></para>
  <para style="q1">
    <verse number="16-17" style="v" sid="ACT 15:16-17"/>«‹ከኒች ኤተሮን ፈቆ መኑለከ ሱዕሚንከኤ ገአንቶእሩ</para>
  <para style="q2" vid="ACT 15:16-17">አይሁደ እኮበእሩ ኡመቱ ጉዕሙንኩ ኤሳሃ ሀሳገ ፈንቀል አሜታም፤</para>
  <para style="q2" vid="ACT 15:16-17">ድጀሞ ደዉዴ ምኒ እጃራም፤</para>
  <para style="q2" vid="ACT 15:16-17">ድጀሞሲንከ ለንኪሃ ፈንቀሽ ኡርሳም።<verse eid="ACT 15:16-17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 15:18"/>ወዕኔችን ጀመር ካን ጉዕመንከ ለሊሾም አን መገኑ ህት ያሚት›።<note caller="-" style="x"><char style="xo" closed="false">15፥18 </char><char style="xt" closed="false">አሞጸ 9፥11-12።</char></note><verse eid="ACT 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19"/>«ህካን እኮቤቺሃ ኢ ሰውቱ መገን አደ ፈንቀልቶ አይሁደ እህበ መነ ኦርንሱንከ። <verse eid="ACT 15:19"/><verse number="20" style="v" sid="ACT 15:20"/>ህከን ወጥ ‹ሽርኬተ ክትሜመ እቸተ እቶኖቼ፤ ዝነተ አኢች፥ ለንገቅ ሬዮ ለል ማለ እቲችለከ ቄጉ አጊች አገዕርዬ› ይን ከተንባሰ።<note caller="-" style="x"><char style="xo" closed="false">15፥20 </char><char style="xt" closed="false"><ref loc="EXO 34:15-17">ፉል. 34፥15-17</ref>፤ <ref loc="LEV 17:10-16">ሌዌ 17፥10-16</ref>፤ <ref loc="LEV 18:6-23">18፥6-23</ref>።</char></note> <verse eid="ACT 15:20"/><verse number="21" style="v" sid="ACT 15:21"/>መሰንትስ ልግብያ ዘማኒች ኬሽ ሙሲ ሕጋን ሰምበት በር ጭምት ምናን አነበበመኖት እቅ፤ ከተማን ጉዕማንን ዱዱብሰመኖ» ዬእ።<verse eid="ACT 15:21"/></para>
  <para style="s1">አይሁደ እኮበእ አመዕናኖተ ሶሄመ ደብዳቤተ</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22"/>ህከኒች ኤተሮን አሳበትለከ ባልቀት አመዕናኖን ጉዕሚንን ሜጡበ ጭምይት በሊችሰ ቀዉ መነ መጠርት ጳዉሎሴንለከ በርናባሴን ሜጡበ አንጾክ ከተመ ሶኮተ አማዕለንቶኡ፤ ህካን እኮቤቺሃ አመዕናኖ በሊች ጡመ አዎንሳኖች «በርሳባሴ» ዬኖ ይሁደለከ ሲላሴ መጠርቶኡ። <verse eid="ACT 15:22"/><verse number="23" style="v" sid="ACT 15:23"/>ከተበንቶ ደብዳቤተ እሰ አንጋን ሶኮኡ፤ ደብዳቤስን «ነኡ አመክዕኔ ኦሱት አሳበትለከ ባልቁ፦ አንጾክ ከተማን፥ ሶርይለከ ክልቅይ ባዶን ሄኤነንተ አይሁድ እህቡ መን አድረ እኬንተ አመኔኦሱተ ወገሬቴ ይናንክዕኔ። <verse eid="ACT 15:23"/><verse number="24" style="v" sid="ACT 15:24"/>ኒ በሊች መት-መቱ መኑ ነኡ ሶንኩዕነ ክዕኔቤቹ መርት ኩልቶህዕኔ ላጋን ኦርሶህዕኔገለከ ሻዝሶህዕኔገ ሞጮጭኖም። <verse eid="ACT 15:24"/><verse number="25" style="v" sid="ACT 15:25"/>ህካን እኮቤቺሃ ሜጡበ ጭምይኖሚች ኤተሮን መጠርን ኢተንቶ አመኔኦሶች በርናባሴለከ ጳዉሎሴ ሜጡበ ክዕኔቤቹ ሶንኮተ ኢተቀሞም። <verse eid="ACT 15:25"/><verse number="26" style="v" sid="ACT 15:26"/>በርናባስለከ ጳዉሎስ ቀርቹሃኔ መሲህ ኢስ ሱዕምተኔሃ ገዉሰ ህግስ ኣቶእረ። <verse eid="ACT 15:26"/><verse number="27" style="v" sid="ACT 15:27"/>ይሁድለከ ስላስ ነኡ ከተንቦሚሃ ገይሰ አፎን ኩልታህዕኔገ ሶንኮም። <verse eid="ACT 15:27"/><verse number="28" style="v" sid="ACT 15:28"/>ህካን እኮቤቺሃ ከኒች ዎሮ አዲን ዮ ሀስሰኖ ጠወ ቤሉ ዎሉ ኬዕመኖ ጠወ እጅሲንሳንክዕኔበእገ ጠሊሉ አያኑለከ ነኡ ኢተቀሞም። <verse eid="ACT 15:28"/><verse number="29" style="v" sid="ACT 15:29"/>ሽርኬተ ክትሜመ ማለ እቶኖቼ፥ ዝናች፥ ለንገእ ሬዮ ለል ማለ እቲችለከ ቄጉ አጊች አገዕርዬ፤ ካን ጉዕመንከ አገዕርቴንተጎር ጡመሃን፤ ቴሱ ወገሬቲን ሄዕዬ» ይት ከተቦኡ።<verse eid="ACT 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30"/>ህከኒች ኤተሮን ሶሄመ መኑ ወገሬቲን ሄዕዬ ይት አንጾክ ከተመ መርቶኡ፤ እሰን አመዕናኑተ ጭምአት ደብዳቤተ ኣቶኡ። <verse eid="ACT 15:30"/><verse number="31" style="v" sid="ACT 15:31"/>አመዕናኑት ደብዳቤተ አነበቦ ወክት ሶሄመ ሸዘናን አበ ሙንደኦኡ። <verse eid="ACT 15:31"/><verse number="32" style="v" sid="ACT 15:32"/>ህትን ይሁድለከ ስላስ ነብያከተ እኮቤቺሃ አመዕናኑተ ልግብየ ጠዊን ሸዝ ጠረኝሶኡ። <verse eid="ACT 15:32"/><verse number="33" style="v" sid="ACT 15:33"/>እሰን ህከኔ ዮ አመዕናኖን ቀዉ በር ሜጡበ አፉዕልቶች ኤተሮን «ወገሬቲን ሄዕዬ» ይት ሶኮ መንቤቹ ፈንቀልት መርቶኡ።<note caller="+" style="f"><char style="ft" closed="false">መት-መቱ ሉህ ክታበት ዎሊንሽ 33 ዮኢሀ በርግታበአ።</char></note> <verse eid="ACT 15:33"/><verse number="34" style="v" sid="ACT 15:34"/>[ጠዉ እኮጎሬ ሲላስ ህከኔ ፈቆተ ሄዕላቾ።]<note caller="+" style="f"><char style="ft" closed="false">መት-መቱ ሉህ ክታበት ዎሊንሽ 34 ዮኢሀ በርግታበአ።</char></note> <verse eid="ACT 15:34"/><verse number="35" style="v" sid="ACT 15:35"/>እኮጎሬ ጳዉሎስለከ በርናባስ ቀዉ በር አንጾክ ከተማን ዱንክት ዎሎ ልግብየ አመዕናኖን ሜጡበ ቀርች ላገተ ተማርስተን ተሽት ላገተ ዱዱብስቶኡ።<verse eid="ACT 15:35"/></para>
  <para style="s1">ጳዉሎስለከ በርናባስ አደ እሁሰ</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36"/>ቀዎ በሬች ኤተሮን ጳዉሎስ በርናባሴ «አም ከኒች ብርተ ቀርች ላገተ ተማርስኖም ከተማን ጉዕማንን ዮ አመዕናኑት ሀት ዮ ጎሬ ዳንድኖ» ዬእ። <verse eid="ACT 15:36"/><verse number="37" style="v" sid="ACT 15:37"/>በርናባስ ህትን «ማርቆሴ» ዬኖ ያህይ እሳን ሜጡበ መሮተ ኢቴእ። <verse eid="ACT 15:37"/><verse number="38" style="v" sid="ACT 15:38"/>ጠዉ እኮጎሬ ጳዉሎስ እሳን ሜጡበ መሮተ ሀሾበአ፤ መሰንትስ እስ «ጵንፍልያ» ዬኖቤቾን እሳች አደ እክ ሆጎቤቹ መሩዕነ ፈቆቤቺሃት እቅ።<note caller="-" style="x"><char style="xo" closed="false">15፥38 </char><char style="xt" closed="false"><ref loc="ACT 13:13">ሶቀ. 13፥13</ref>።</char></note> <verse eid="ACT 15:38"/><verse number="39" style="v" sid="ACT 15:39"/>ህከን ጠዊን አበ ኦዶኢች ኤተሮን መለዕለንቶኡ፤ ህካን እኮቤቺሃ በርናባስ ማርቆሴ ኣእ መርከባን ኣግ ዊን ረበንቶ «ቆጵሮሰ» ዬኖ ባዱ መርቶኡ። <verse eid="ACT 15:39"/><verse number="40" style="v" sid="ACT 15:40"/>ጠዉ እኮጎሬ ጳዉሎስ ስላሴ መጠሮ፤ አመዕናኑት ጳዉሎሴ ቀርች ኣስቶተ ኤገተ ኣቶኢች ኤተሮን ኦሮዕዮ። <verse eid="ACT 15:40"/><verse number="41" style="v" sid="ACT 15:41"/>እስን «ሶርየለከ ክልቅየ» ዬኖቤቾን ዮ አመዕናኑተ ጠረኝሰን ሃመኖ እቅ።<verse eid="ACT 15:41"/></para>
  <chapter eid="ACT 15"/>
  <chapter number="16" style="c" sid="ACT 16"/>
  <para style="s1">ጥማቶስ ጳዉሎሴንለከ ስላሴን ሜጡበ እሁስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1"/>ጳዉሎስ «ደርቤተለከ ልስጥረ» ዬኖቤቹ አሜቾ፤ ህከኔን «ጥማቶሴ» ዬኖ አመዕናንቹ ሄዕዮ እቅ፤ አመስ አይሁድተ አመዕናንቹ እቅ፤ እኮጎሬ አኑስ ግርክቾሃ እቅ። <verse eid="ACT 16:1"/><verse number="2" style="v" sid="ACT 16:2"/>እሲንከ «ልስጥረለከ እቆንዮነ» ዬኖቤቾን ሄኣ አመዕናኖ አኔን ጡሙ ሱዕሙ ሄዕዮስ እቅ። <verse eid="ACT 16:2"/><verse number="3" style="v" sid="ACT 16:3"/>ጳዉሎስ ጥማቶሴ ኣእ ሃሞተ ሀሾቤቺሃ ጡርከሞስ፤ መሰንትስ ህከን ቤቾን ሄኣ አይሁዱ ጉዕሙንኩ ጥማቶሴ አኑ ግርክቹ እሁስ ደጋቤቺሃት እቅ። <verse eid="ACT 16:3"/><verse number="4" style="v" sid="ACT 16:4"/>ጳዉሎስለከ ሲላስ ከተመ ዘህተን ዬሩሳሌም ከተማን ዮ አሳበትለከ ባልቀተ ጠወእ ኡርሶ ትዛዝ አመዕናኑት አገርታገ ሸዛኢት እቅ። <verse eid="ACT 16:4"/><verse number="5" style="v" sid="ACT 16:5"/>ህካን እኮቤቺሃ አመዕናኑት ጠረኝተን በሬን በሬን ወሊንሹሰ በተአን መረኖት እቅ።<verse eid="ACT 16:5"/></para>
  <para style="s1">ጳዉሎስ መቄዶን ባዱ ኦሮኦተ ገአሙስ</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6"/>ህትን እሰ እስይ ባዶን መገን ላገተ ኩልታበእገ ጠሊሉ አያኑ ከማንሰ ፍርግይለከ ገለትይ ባዲን ህጎኡ። <verse eid="ACT 16:6"/><verse number="7" style="v" sid="ACT 16:7"/>«ሚስየ» ዬኖ ባዱ ኢልቶ ወክት ቢታንየ ባዱ መርቶተ ሰውይቶኡ፤ ጠዉ እኮጎሬ ኢስ አያኑ ህከበ መርታበእገ ከሞሰ። <verse eid="ACT 16:7"/><verse number="8" style="v" sid="ACT 16:8"/>ህካን እኮቤቺሃ እሰ ሚስይ ባዲን ህግ ጢሮኣድ ከተመ መርቶኡ። <verse eid="ACT 16:8"/><verse number="9" style="v" sid="ACT 16:9"/>ህካን እኮቤቺሃ ሀንከዕርተ መቱ መቄዶን መንቹ ኡር «መቄዶነ አሜት ሀዕልኔ» የን ኡጨኖሃ ጳዉሎስ መናማን ለዕዮ። <verse eid="ACT 16:9"/><verse number="10" style="v" sid="ACT 16:10"/>ጳዉሎስ መናማን ለዕዮች ኤተሮን ነኡ ህከ ወክትንከ መቄዶነ መርኖተ ቅጥይኖም፤ መሰንትስ ነኡ ህከኔ ዮ መኒሃ ተሽት ላገት ኩልኖተ መገኑ ገኡስ ደንጎምቤቺሃት እቅ።<verse eid="ACT 16:10"/></para>
  <para style="s1">«ሊድያ» ዬኖ መንቹት መሲሂን አመዕንቶገ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11"/>ጢሮአዲች መርከባን ኣንግ «ሳሞትራቄ» ዬኖቤቹ ኢልኖም፤ ለንክ በር «ናጱሌ» ዬኖቤቹ መርኖም። <verse eid="ACT 16:11"/><verse number="12" style="v" sid="ACT 16:12"/>ህከንቤቺች ኬዕን ፍልጵስዩስ ከተመ ኢልኖም፤ ፍልጵስዩሱ መቄዶን አዉራጂሃ ሎረ ከተመለከ ሮም ባድ ዎም አንጋን ጠገሞሃ እቅ፤ ነኡ ህከን ከተማን ቀዉ በር ዱንክኖም። <verse eid="ACT 16:12"/><verse number="13" style="v" sid="ACT 16:13"/>ህትን ሰምበት በር ከተሚች አብል ዱአ አቶተ ጭምይታቤቹ ዮኢሃ አጉጆኔቤቺሃ ፉልን ዛዘኖ ዊ መድ መርኖም፤ ህከኔ አፉዕልን ጭምይቶ ሜንቲሃ መገን ላገተ ተማርስኖም። <verse eid="ACT 16:13"/><verse number="14" style="v" sid="ACT 16:14"/>ህከኔ ሞጮጭታ ሜንቲች መት ትያጥሮን ከተሚች አሜቶ ሰመ አጉደኖ ብሸ ኦድኑተ ነገዳ መገኒሃ ሰገዳ «ሊድየ» ዬኖ መንቹተ እቅ፤ ጳዉሎስ ጠወአኖርቹ አጥራመቶተ መገኑ ቀልብሴ ፈኞ። <verse eid="ACT 16:14"/><verse number="15" style="v" sid="ACT 16:15"/>እሴን ምንሴ መኒን ጉዕሚንን ሜጡበ ጠመቀንቶች ኤተሮን «ቀርቾ መገኖን አመዕኔሚሃ እኮሚች ምኒኤ አሜቴን አፉዕልዬ» ይት ጠረኝስ ኡጭቶኔቤቺሃ መርኖም።<verse eid="ACT 16:15"/></para>
  <para style="s1">ጳዉሎስለከ ሲላስ ፍልጵስዩስ ከተማን ኡሱረንቶገ</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16"/>ነኡ መቱ በር ዱአ አኤኖ ቤቹ መርነኒን ኪልታገ አአኖ ዶሮረኖ ዱሩ ዮሴ መት ካዲንቹት ሀፍቱት ዎቃን ደቀንቶኔ፤ ህት ሀፍቱት ኪልተን ገሽታሴሀኑኡተ ልግብ ብረ ኤባእተ እቅ። <verse eid="ACT 16:16"/><verse number="17" style="v" sid="ACT 16:17"/>እሴን ጳዉሎሴለከ ኔሳሃ አዎንተን «ኩ መኑ ሎረ መገንተ ካዲመ፤ እሰ ጡሜኖ ዎቃሃ ክዕኔሃ ኩልታህዕኔረ» ይተን ያርታኢት እቅ። <verse eid="ACT 16:17"/><verse number="18" style="v" sid="ACT 16:18"/>ህካንን ልግብ በር አቶኡ፤ ጠዉ እኮጎሬ ጳዉሎስ ኡሙዕር ኤተሩ ፈንቀል ለዕይ ዶሮረኖ ዱሩ «መሲህ ኢስ ሱዕሚን እሴች ፉልቶተ አዘዛንኬ» ዬእ፤ ህከ ወክትንከ ዶሮረኖ ዱሩ ፉሎ።<verse eid="ACT 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19"/>እኮጎሬ ገሻኑሴ ብረ ደዕተ ዎቆሁ ሙርተኡስ ደጎ ወክት ጳዉሎሴለከ ሲላሴ አፍ ጌቤበ ጎሾሽተን መስት ሹመ ቤቹ ሆንጠህሶኡ። <verse eid="ACT 16:19"/><verse number="20" style="v" sid="ACT 16:20"/>እሰን ሮም ዳኛኖ ብርተ ሆንጠህስ «ኩ መኑ አይሁድ መነ እከን ከተማንከኔ ብተተ ኬሳኢት። <verse eid="ACT 16:20"/><verse number="21" style="v" sid="ACT 16:21"/>ነኡ ሮም ባድ መኑ ቶንጎተለከ አዕኖተ ሴሩኔ አዘዝባሃ ሮስሳኔት» ይቶኡ። <verse eid="ACT 16:21"/><verse number="22" style="v" sid="ACT 16:22"/>ኡመቱ እሰ አሌን ጭምይት ኬኦኡ፤ ዳኛኑት ጳዉሎሴለከ ስላሴ ኦድኑተ ቃርቶሳች ኤተሮን በርቲን ዎቀርታገ አዘዞኡ። <verse eid="ACT 16:22"/><verse number="23" style="v" sid="ACT 16:23"/>አበ ዎቀርቶች ኤተሮን ኡሱር ምኒ ኣግስ ኡሱር ምኒ ዘበኘ ጠረኝ አገረኖገ አዘዞኡ። <verse eid="ACT 16:23"/><verse number="24" style="v" sid="ACT 16:24"/>ሁኩ ኡሱር ምኒ ዘበኙ ትዛዝ ቶጎች ኤተሮን ኣዝ ክፍለ ኣግሽ ሎከሰ ሀቃን ኡሱሮ።<verse eid="ACT 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25"/>ሀንከዕሬ በላን ጳዉሎስለከ ስላስ ዱአ አተንለከ መዝሙረ ዘመርተን መገኑ ገለትጭታኢሃ ዎሉ ኡሱሬመ መኑ ሞጮጨኖሳት እቅ። <verse eid="ACT 16:25"/><verse number="26" style="v" sid="ACT 16:26"/>ድንገቴን ኡሱር ምኒ ቀበቡ ሌንቄቀኖ ኢለ አቡ ኡለ ሌንቄቁ እኮ፤ ህከ ወክት ኡሱር ምኒ ጡፉ ጉዕሙንኩ ሜጦረ ፈንተዕዮ፤ ህትን ጉዕምሰ ሰንሰለቱ ሂርተዕዮ። <verse eid="ACT 16:26"/><verse number="27" style="v" sid="ACT 16:27"/>ኡሱር ምኒ ዘበኙ ግሰኛች በቅይ ኡሱር ምኒ ጡፉ ፈንተዕያን ለዕዮ ወክት ኡሱረኙ ፉሸኢቶኢሃ አጉጃንስ ገዉስ ሾተ ብሰ ኬሾ። <verse eid="ACT 16:27"/><verse number="28" style="v" sid="ACT 16:28"/>ጠዉ እኮጎሬ ጳዉሎስ «ጉዕሙኩኔ ከኔ ዮምቤቺሃ ገዉክ ሚርቶት» ይ ሎረ ላጋን ያር ከሞስ።<verse eid="ACT 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29"/>ህትን እስ መብራት አፍሲሽ ኣእ ኣዝ ጠጡተ ደጉጅ ኣግ ሁጠን ጳዉሎሴለከ ስላሴ ብሬን ኡቦ። <verse eid="ACT 16:29"/><verse number="30" style="v" sid="ACT 16:30"/>እሰንተ አብል ፉሽ «ቀርቻኑኤ! አን ጡሞተ መ አኡ ሀስሰኖኤ?» ይ ጠዕሜሰ።<verse eid="ACT 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31"/>እሰን «ቀርቾ ኢሳን አመዕንቶንትጎር አትለከ ኪ ምኒ መኑሁ ጡምቴነንተ» ይቶስ። <verse eid="ACT 16:31"/><verse number="32" style="v" sid="ACT 16:32"/>ህትን እሰ ቀርች ላገተ እሲሃለከ ምኔስ ዮ አበሮሲሀስ ኩልቶኡ። <verse eid="ACT 16:32"/><verse number="33" style="v" sid="ACT 16:33"/>እስ ህከ ወክትንከ ሀንከዕሬን እሰተ መስኬዕይ ጡላሰ ኣንሽ አበሮስንከስ ሜጡበ ጠመቀሞ። <verse eid="ACT 16:33"/><verse number="34" style="v" sid="ACT 16:34"/>ህከኒች ኤተሮን ጳዉሎሴለከ ሲላሴ ምንስ ኤብ እቸተ ሆንጠህሾ፤ ህትን እስለከ ምንስ መኑ መገኖን አመዕንቶቤቺሃ ሙንደኦኡ።<verse eid="ACT 16:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35"/>ጠዉ እኮጎሬ ለንክ በሬ ሱጵተ ከተመስ ገሽታሩ «ህከ መነ መርቶተ ገፈሬ» ይት ፖሊሰተ ሶኮኡ።<verse eid="ACT 16:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 16:36"/>ኡሱር ምኒ ዘበኝቹ «አዕኑ ገፈረንቶኖተ ዳኛኑት መነ ሶኮኡ፤ ህካን እኮቤቺሃ አዕኑ ቴሱ ፉልቴን ወገሬቲን ኦሮዕዬ» ይ ጳዉሎሴሃ ኩሎ።<verse eid="ACT 16:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37"/>እኮጎሬ ጳዉሎስ «ነኡ ሮም ባድ መነ እንከን መቱርቹሃ ቤንሱዕነ ፍርድ ቤሉ ኡመት ብሬን ዎቀርት ኡሱር ምኒ ኣግሶኔ፤ ህትን ቴሱ ማጠም ፉልናምገ አታኔትንዶ? ፉልናምበአ! እሰ ገዉሰ አሜት ፉሽቱኔ» ዬሰ።<verse eid="ACT 16:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38"/>ፖሊሰት እሰ ይቶ ላገተ ዳኛኖተ ኩልታንሰ ዳኛኑት ጳዉሎስለከ ስላስ ሮም ባድ መነ እሁሰ ሞጮጭቶ ወክት ዋጅቶኡ። <verse eid="ACT 16:38"/><verse number="39" style="v" sid="ACT 16:39"/>ህካን እኮቤቺሃ ዳኛኑት አሜት «ቤንሶም» ይት ኡሱር ምኒች ፉሽት ከተሚች ፉልት መርታገ ኡጭቶኡ።<verse eid="ACT 16:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 16:40"/>ጳዉሎስለከ ስላስ ኡሱር ምኒች ፉልት ሊድያ ምኒ ኣጎኡ፤ ህከኔን አመዕናኑተ ሸዝ ጠረኝስ አጉርት መርቶኡ።<verse eid="ACT 16:40"/></para>
  <chapter eid="ACT 16"/>
  <chapter number="17" style="c" sid="ACT 17"/>
  <para style="s1">ተሰሎንቄን ኬኦ ብተተ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1"/>ህከኒች ኤተሮን እሰን «አንፊጶሊሰለከ አጶሎኖ» ዬኖ ከተሚን ህግ ተሰሎንቄ ከተመ አሜቶኡ፤ ህከኔን አይሁድ ጭምት ምኑ ሄዕዮ እቅ። <verse eid="ACT 17:1"/><verse number="2" style="v" sid="ACT 17:2"/>ጳዉሎስ ወዕና ሮሾገን አይሁድ ጭምት ምኒ ኣጎ፤ እስን እሳንከ ሰሱ ፎሎጭ በር መገን ላገተ ጠሊለ መጻፊ ኣዚች አነበበን እሳን ሜጡበ ኩለኖሳት እቅ። <verse eid="ACT 17:2"/><verse number="3" style="v" sid="ACT 17:3"/>ህትን መሲሁ ኦርሸተ ቶጉለከ ሬሆች ኬኡ ሀስሰኖስገ ሀንቅ እሁስ ለሊሽ ኩለን «ኩን አን ኩላንክዕኔ ኢስ መሲህት» የኖ እቅ። <verse eid="ACT 17:3"/><verse number="4" style="v" sid="ACT 17:4"/>ህካን እኮቤቺሃ አይሁዲች መት-መቱሰ ላገስ ኣጋንሰ አመዕንት ጳዉሎሴንለከ ሲላሴን ሜጡበ እኮኡ፤ ህትን መገኒሃ ሰገዳ ልግቡ ግሪክ ባድ መኑለከ ከተማንከስ ለሊቶ ሜንቱ ላገስ ሞጮጭት እሳን ሜጡበ እኮኡ።<verse eid="ACT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5"/>ጠዉ እኮጎሬ አመዕንትቡ አይሁዱ ምቀኝት ሆጉት ዮበእ መነ ዎቄች ጉዕሚችን ጭምአት ልግብ መነ ሂለ አማልተ አማልሲስ ከተማንከስ ብተት ኬኣገ አቶኡ፤ ጳዉሎሴለከ ሲላሴ ፉሽት ኡመቲሃ ኣቶተ ሀስ «ኢያሶን» ዬኖ መንች ምኒ ረቦኡ። <verse eid="ACT 17:5"/><verse number="6" style="v" sid="ACT 17:6"/>ጠዉ እኮጎሬ እሰተ ሀስ ሆጎ ወክት ኢያሶኔለከ መት-መቱ አመዕናኑተ ከተም ሹማተ ሆንጠህሶተ ጎሾሽተን መስቶኡ፤ ህትን «ኩ መኑ ጉዕመንከ ባዱ ኦርሳእረ፤ ህትን ቴሱ ኒ ከተመ አሜቶኡ። <verse eid="ACT 17:6"/><verse number="7" style="v" sid="ACT 17:7"/>ኢያሶንን ምኔንከስ ቶጎሰ፤ ህትን ‹ኢሰ ዬኖ ዎሉ ዎሙ ዮኔ› ይት ሮም ባድ ዎም ትዛዝ ግቦእረ» ይት ያርቶኡ። <verse eid="ACT 17:7"/><verse number="8" style="v" sid="ACT 17:8"/>ኡመቱለከ ከተም ሹመት ህከ ጠወ ሞጮጭቶ ወክት አበ ጨነቀንቶኡ። <verse eid="ACT 17:8"/><verse number="9" style="v" sid="ACT 17:9"/>እሰን ኢያሶኔለከ ዎሉ መነ ሩብት ገእሲስ ገፈርቶሰ።<verse eid="ACT 17:9"/></para>
  <para style="s1">ጳዉሎስለከ ሲላስ «ቤርየ» ዬኖ ከተማን ተማርስቶገ</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10"/>ህከ ወክት አመዕናኑት ጳዉሎሴለከ ሲላሴ ሀንከዕሬን «ቤርየ» ዬኖ ከተመ ህርሲሶኡ፤ እሰን ህከ ቤቹ ኢልቶገን አይሁድ ጭምት ምኒ ኣጎኡ። <verse eid="ACT 17:10"/><verse number="11" style="v" sid="ACT 17:11"/>ህከኔ ሄኦ አይሁዱ ተሰሎንቄ ከተማን ሄኣ አይሁዲች በትስ ጡሙ ቀልቡ ዮሰቤቺሃ ጳዉሎስ ዬ ጠዉ ሀንቅያ ጎሬ ደጎተ በሬን በሬን ጠሊለ መጻፈ መረመርተን ላገስ አበ ሙንዲኖን ቶጎኡ። <verse eid="ACT 17:11"/><verse number="12" style="v" sid="ACT 17:12"/>ህካን እኮቤቺሃ እሳች ልግቡሰ አመዕንቶኡ፤ ልግቡ ግሪክ ቀባጣሙ ሜንቱለከ ልግቡ ግሪክ ጎኑ አመዕንቶኡ። <verse eid="ACT 17:12"/><verse number="13" style="v" sid="ACT 17:13"/>ጠዉ እኮጎሬ ተሰሎንቄ ከተማን ሄኦ አይሁዱ ጳዉሎስ ቤርይ ከተም መኒሃ መገን ላገተ ኩሎገ ሞጮጭቶ ወክት ህከ ቤቹ አሜት መነ ሂለ አማልተ አማልሲስ ኡመቱ አሌሰ ኬአኖገ አቶኡ። <verse eid="ACT 17:13"/><verse number="14" style="v" sid="ACT 17:14"/>ህከ ወክትንከ አመዕናኑት ጳዉሎስ ደዕል ባር መድ ኦሮአኖገ አቶኡ፤ እኮጎሬ ሲላስለከ ጥማቶስ ቤርያን ፈቆኡ። <verse eid="ACT 17:14"/><verse number="15" style="v" sid="ACT 17:15"/>ጳዉሎሴ ህርሲስ አቴን ከተመ ኢልሶ መኑ «ስላስለከ ጥማቶስ ደዕልት ኢቤቹ አሜቱን» ዬ ጳዉሎሴ ሶህኑተ ኣእት ቤርየ ፈንቀልቶኡ።<verse eid="ACT 17:15"/></para>
  <para style="s1">ጳዉሎስ አቴን ከተም መኒሃ ጠወዕዮገ</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16"/>ጳዉሎስ አቴን ከተማን አፉዕል ሲላሴለከ ጥማቶሴ አገረን ከተማንከስ ሽርኬተ ሰገዴኖርቹ ዊሞሀ ለዕዮ ወክት ቀልቤንከስ አበ ኡሙዕሬእ። <verse eid="ACT 17:16"/><verse number="17" style="v" sid="ACT 17:17"/>ህካን እኮቤቺሃ ጭምት ምኔን አይሁዲንለከ መገኒሃ ሰገዳ መኒን ጉዕመ በር ጌባን ደቀመኖ መኒን ጠወአኖት እቅ። <verse eid="ACT 17:17"/><verse number="18" style="v" sid="ACT 17:18"/>«ኤፒኮሮሰለከ እስቶይኮ» ዬኖ ኤንኬዕናመት ጳዉሎሴቤቹ አሜተን ኦደንታኢት እቅ፤ መት-መቱሰ «ኩ ዛንቁራንቹ መ ዮተ ሀሾኡ?» ይታኢት እቅ፤ ህትን ዎሉሰ ፈንቀሽት «ደገሞበእ መገኒሃ ጠወአኖ አጉደኖት» ይታኢት እቅ፤ ህካን ይቶ መሰት ጳዉሎስ ኢስ ሬሆች ኬእ ጡመ ዱዱቡ ኩሎሰቤቺሃት እቅ። <verse eid="ACT 17:18"/><verse number="19" style="v" sid="ACT 17:19"/>እሰን ጳዉሎሴ ኣእት «አርዮስፋጎስ» ዬኖ ቆሮን ሄአኖ ኦገትቤቹ ኤብ «ኩ አት ኩልታንትኔ ሃዕሮ ጠዉ መርቹሃጎሬ ደንጎተ አታልናምንዶ? <verse eid="ACT 17:19"/><verse number="20" style="v" sid="ACT 17:20"/>ኩ አት መጫተኔ ሃዕሮ ጠወ ጠወአንቲሁ መሃጎሬ ደንጎተ ሀንሳምቤቺሃ መሃጎሬ ኩልኔ» ይቶኡ። <verse eid="ACT 17:20"/><verse number="21" style="v" sid="ACT 17:21"/>መሰንትስ አቴን ከተም ጉዕሙንኩ መኑለከ ህከን ቤቾን ሄኣ ዎሎ ባድ መኑ ሃዕሮ ጠወ ጠወአንለከ ሞጮጭተን ሆስ ቤሉ ዎሉ መቱርቹሃ አታበእረ እቅ።<verse eid="ACT 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22"/>ህካን እኮቤቺሃ ጳዉሎስ «አርዮስፋጎስ» ዬኖ ኦገት ብሬን ኡር «አቴን መነ! ጉዕማንከ አዲን ሀይማኖቱ ዮህዕኔ መነ እሁክዕኔ ደጎም። <verse eid="ACT 17:22"/><verse number="23" style="v" sid="ACT 17:23"/>ከተመክዕኔ ዘሀን አዕኑ ሰገዴነንተ ቤቹ ለዕዮም ወክት ‹ደገሞበእ መገኒሃ› የመም ከተበሞሃ ክትም ጠረጴዘ ደጎም፤ ቴሱ ህከ ደጎኑዕናን ሰገዴነንታሃ አን ኩላንክዕኔ። <figure style="fig" alt="Paul speaking to the Areopagus" file="cn01993b.tif" size="span" ref="17፥22">ጳዉሎስ አርዮስፋጎሳን ኡር ጠወኣን</figure><verse eid="ACT 17:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 17:24"/>«መገኑ ኡለተለከ ኡለ አሌን ዮኢሃ ጉዕመንከ ከለቆእሃን፤ እስን ሰሜለከ ኡለ ቀርቹ እኮቤቺሃ መኑ አንጋን እጃሮ ምኔን ሄአኖበአ። <verse eid="ACT 17:24"/><verse number="25" style="v" sid="ACT 17:25"/>እስን ነብሳለከ ፎገል ዎሉርቹ ጉዕመንከ መኒሃ ኣሰኖሃ እኮቤቺሃ መቱርቹሁ ሆፈዕዮስሀንገ መን አንገተ ሄዕላተኖበአ።<note caller="-" style="x"><char style="xo" closed="false">17፥25 </char><char style="xt" closed="false"><ref loc="1KI 8:27">1 ነገ. 8፥27</ref>፤ <ref loc="ISA 42:5">ኢሳ. 42፥5</ref>፤ ሶቀ. 8፥47።</char></note> <verse eid="ACT 17:25"/><verse number="26" style="v" sid="ACT 17:26"/>እሲን ኣዱንያ አሌን ሄኣ አደደ ኡመት ጉዕመንከ መቶ መንቺች ከለቆ፤ ኡለ አሌን ጉዕማንን ሄኣገ አዕዮሰ፤ እሳንከ ሄኣ ዘማንለከ ሄኣ ቤቹ መደቦሰ። <verse eid="ACT 17:26"/><verse number="27" style="v" sid="ACT 17:27"/>ህካን አዕዮንኩ መኑ መገኑ ሀሶተለከ መረመርት ሀስ እሱ ደጋጋት፤ እሁን ቤሉ እስ ኒች ጉዕሚችኔን ቄዕራሻበአ። <verse eid="ACT 17:27"/><verse number="28" style="v" sid="ACT 17:28"/>መሰንትስ ‹ሄኡ ደእናሚሁለከ ሌንቄቅናሚሁ</para>
  <para style="q2" vid="ACT 17:28">ህትን ሄዕናሚንኩ እሲኒት›</para>
  <para style="m" vid="ACT 17:28">ሁኩንን ክዕኔ መት-መቱ ሴነፋሩ</para>
  <para style="q1" vid="ACT 17:28">‹ነኡ ጉዕሙንኩኔ እስተ እለ› ይቶጋት።<verse eid="ACT 17:28"/></para>
  <para style="m">
    <verse number="29" style="v" sid="ACT 17:29"/>ቴሱ ነኡ መገን ኦሱተ እንኮምጎሬ ‹መገኑ መን ሀይማንለከ ሰውቲን ዎርቂን ህከረንገ ብሪን ህከረንገ ክኒን መክሴመ ምስለ አጉደኖ› ይን ሰውዩ ሀስሰኖኔበአ። <verse eid="ACT 17:29"/><verse number="30" style="v" sid="ACT 17:30"/>ህካን እኮቤቺሃ መኑ ወዕኔ ዘማን ደጉ ሆጊን አቶኢሃ መገኑ አጉሮሰ፤ እኮጎሬ ቴሱ ባዶን ጉዕማንን ዮ መኑ ጩቢች ቶበት ፈንቀልታገ አዘዦኡ። <verse eid="ACT 17:30"/><verse number="31" style="v" sid="ACT 17:31"/>መሰንትስ መገኑ መጠሮ መንች አዲን ጉዕማንከ መን አሌን ጌጥ አዕይ ፈረደኖ በር ወሰኞኡ፤ ህካን ሀንቅ እሁስ መን ጉዕሚንከ ለሊሾሁ ህከ እስ መጠሮ መንቹ ሬሆች ኬሲንከሲት» ዬእ።<verse eid="ACT 17:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32"/>እሰ «ሬሆች ኬኡ» ዬኖ ላገተ ሞጮጭቶ ወክት መት-መቱሰ ቀለዶኡ፤ መት-መቱሰ «ከን ጠውተኔሃ ዎሉ ወክት ሞጮጭናም» ይቶኡ። <verse eid="ACT 17:32"/><verse number="33" style="v" sid="ACT 17:33"/>ህከኒች ኤተሮን ጳዉሎስ ኦገቲችሰ ኬዕይ ኦሮዕዮ። <verse eid="ACT 17:33"/><verse number="34" style="v" sid="ACT 17:34"/>ጠዉ እኮጎሬ መት-መቱ መኑ አመዕንት እሲን ሜጡበ እኮኡ፤ እሳንን ሜጡበ «አርዮስፋጎስ» ዬኖ ኦገት መኒች መቱ «ዲዮናስዮስ» ዬኖ መንቹ፥ «ደማሪስ» ዬኖ መት መንቹትለከ ዎሉ ልግቡ መኑ ሄዕዮ እቅ።<verse eid="ACT 17:34"/></para>
  <chapter eid="ACT 17"/>
  <chapter number="18" style="c" sid="ACT 18"/>
  <para style="s1">ጳዉሎስ ቆሮንቶስ ከተመ ኦሮዕዮገ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1"/>ህከኒች ኤተሮን ጳዉሎስ «አቴና» ዬኖ ከተሚች ኬዕይ ቆሮንቶስ ከተመ ኦሮዕዮ። <verse eid="ACT 18:1"/><verse number="2" style="v" sid="ACT 18:2"/>ህከኔን ጳንጦስ ባዲሃ «አቂለ» ዬኖ መቱ አይሁድቹ ደጎ፤ እስን ቀዎ ወክቲች ብርተ መንቾንከስ ጵርስቅላን ሜጡበ ጣሊያን ከተሚች አሜቾሃ እቅ፤ መሰንትስ አይሁዱ ጉዕሙንኩ ከተሚችስ ፉልቶተ ሮም ባድ ዎመ ሀለቁ ዎሙ ቀላዉዴዎስ አዘዦቤቺሃት እቅ፤ ጳዉሎስን እሰንተ ለኦተ ኦሮዕዮ። <verse eid="ACT 18:2"/><verse number="3" style="v" sid="ACT 18:3"/>እስ ሆጉት እሰገን ዱካነ ጎቡ እኮቤቺሃ እሳንን ሜጡበ ሄአን እሲሁ ዱካነ ጎቡ ጀመሮ። <verse eid="ACT 18:3"/><verse number="4" style="v" sid="ACT 18:4"/>እስን ሰምበት በር ጉዕመንከ አይሁዲለከ ግሪክ መኒሃ ጭምት ምኔን ደገመን ተማርሰን አመንሲሰኖሳት እቅ።<verse eid="ACT 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5"/>ህከኒች ኤተሮን ጥማቶስለከ ሲላስ መቄዶን ባዲች አሜቶ ወክት ጳዉሎስ ኢስ መጠረሞ መሲሁ እሁስ አይሁዲሃ ጉዕመንከ ወክት ጠረኝሽ ኩለኖሳት እቅ። <verse eid="ACT 18:5"/><verse number="6" style="v" sid="ACT 18:6"/>ጠዉ እኮጎሬ አይሁድ መኑ እሱ ግቦስለከ ቦሮርቶስ ወክት ኦድኖስ ትበ ግግሽ «ቴሱ ፈረደሞህዕኔ ጎሬ ገይክዕኔ ቤሲን እኮቤቺሃ ኤሳሃ ከን ጠዊሃ ኣግሰኖኤበአ፤ ቴሱ አን አይሁደ እህበ መንቤቹ ኦሮኣም» ዬእ። <verse eid="ACT 18:6"/><verse number="7" style="v" sid="ACT 18:7"/>ህካን እኮቤቺሃ ጳዉሎስ ህከንቤቺች ኬዕይ መገኒሃ ሰገደኖ «ቲቶስ ኢዮስጦስ» ዬኖ መንች ምኒ ኦሮዕዮ፤ ምኑስ አይሁድ ጭምት ምኒሃ መድ እቅ። <verse eid="ACT 18:7"/><verse number="8" style="v" sid="ACT 18:8"/>አይሁድ ጭምት ምኒ ዳኙ «ቀረስጶስ» ዬኖ መንቹ ምንስ አበሮሲን ሜጡበ መገኑ አመዕኔእ፤ ህትን ልግቡ ቆሮንቶስ ከተም መኑ ጳዉሎሴች መገን ላገተ ሞጮጭት አመዕንት ጠመቀንቶኡ።<verse eid="ACT 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9"/>ቀርቹ መት ሀንከዕርተ መናማን ጳዉሎሴ «ዋጅቶት ሰዕምይት ጠወእ። <verse eid="ACT 18:9"/><verse number="10" style="v" sid="ACT 18:10"/>አን ኪኒት፤ አዪሁ ኬሳሃ ሚዕሮሄተ አታለኖበአ፤ መሰንትስ ከን ከተማን ኤሳሃ ልግቡ መኑ ዮኤ» ዬስ። <verse eid="ACT 18:10"/><verse number="11" style="v" sid="ACT 18:11"/>ህከን ቤቾን ጳዉሎስ መገን ላገተ ኡመቲሃ ተማርሰን መቱ ዘማን ደሬን እሰቤቾን ዱንኬእ።<verse eid="ACT 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12"/>ጠዉ እኮጎሬ «ጋልዮስ» ዬኖ መንቹ አካይ ባድ ሹመ እኮ ወክት አይሁድ መኑ ሜጡበ እክ ጳዉሎሴ አሌን ኬእ አፍ ፍርድ ምኒ መስቶኡ። <verse eid="ACT 18:12"/><verse number="13" style="v" sid="ACT 18:13"/>ህከን ቤቾን «ኩ መንቹ ሕጉ አዘዝበ ሃሌን መኑ መገኒሃ ሰገደኖገ አአኖት» ይቶኡ።<verse eid="ACT 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14"/>ጠዉ እኮጎሬ ጳዉሎስ ህከን ጠውተኔሃ መስለ ፈንቀሾተ ቅጥ ይዮሀኔን ጋልዮስ አይሁደ «አዕኑ አይሁድ መኑ! ክዕኔ አሌን ኬዕማሸ ጠወ ህከረንገ ሂለ አኤማህዕኔ እቃን ክሰክዕኔ አደቢን ሞጮጫም እቅ። <verse eid="ACT 18:14"/><verse number="15" style="v" sid="ACT 18:15"/>ጠዉ እኮጎሬ ኩ ጠዉ ጠለዕል ላገተኔሃ፥ ሱዕምተኔሃለከ ገይክዕኔ ሕግተኔሃ ኦዴነንታሃ እኮጎሬ ኤሳሃ ኣግሰኖኤበ፤ አን ከን ጠው አሌን ፈረዶተ ሀሳምበአ» ዬእ። <verse eid="ACT 18:15"/><verse number="16" style="v" sid="ACT 18:16"/>እስን ህት ይ ፍርድ ምኒች አብል ፉሼሰ። <verse eid="ACT 18:16"/><verse number="17" style="v" sid="ACT 18:17"/>ህከኒች ኤተሮን እሰ ጉዕሙንኩ ጭምት ምኒ ዳኛ «ሶስቴንሴ» ዬኖሃ አፍ ፍርድ ምኒ ኦገት ብሬን ኦልቶስ፤ እኮጎሬ ሁኩ ጠዉ ጋልዮሴሃ መቱርቹሃ አጉጆስበአ።<verse eid="ACT 18:17"/></para>
  <para style="s1">ጳዉሎስ አንጾክ ከተመ ፈንቀሉስ</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18"/>ጳዉሎስ ልግብ ወክት ቆሮንቶስ ከተማን ዱንኬእች ኤተሮን አመዕናኑተ «ወገሬቲን ሄእዬ» ይ ሶርይ ባዱ ኦሮዕዮ፤ ህትን ጵርስቅልለከ አቂል እሲን ሜጡበ ሄኦ እቅ፤ እኮጎሬ ሁንዱር ኣጎቤቺሃ ኦሮአኖሀኒች ሄጭ ሙምስ «ክንክሪያ» ዬኖቤቾን ሜጆ።<note caller="-" style="x"><char style="xo" closed="false">18፥18 </char><char style="xt" closed="false"><ref loc="NUM 6:18">ዘኁ. 6፥18</ref>።</char></note> <verse eid="ACT 18:18"/><verse number="19" style="v" sid="ACT 18:19"/>እሰን ኤፌሶን ከተመ ኢልቶ ወክት እስ ጵርስቅለለከ አቂለ ህከኔ አጉር አይሁድ ጭምት ምኒ ኣግ አይሁድ መኒሃ ጠወአኖት እቅ። <verse eid="ACT 18:19"/><verse number="20" style="v" sid="ACT 18:20"/>ጳዉሎስ ልግብ ወክት እሰቤቾን ዱንኮተ ኡጭቶስ ወክት ቶጉ ግቦሰ። <verse eid="ACT 18:20"/><verse number="21" style="v" sid="ACT 18:21"/>ጠዉ እኮጎሬ «መገኑ ዬጎሬ ዎሉ ወክት ክዕኔቤቹ ፈንቀል አሜታም»<note caller="+" style="f"><char style="fqa" closed="false">መገኑ ዬ ጎሬ ዎሉ ወክት ክዕኔቤቹ ፈንቀል አሜታም፦ </char><char style="ft" closed="false">የኖሁ መቱ-መቱ ክታበት አሜተኖ ከበጃት ዬሩሳሌማን ከበጅናም ይታ ላገተ በርግታአ።</char></note> ይ ኤፌሶኒች መርከባን ኣግ ኦሮዕዮ።<verse eid="ACT 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 18:22"/>እስ «ቂሳርያ» ዬኖ ከተመ ኢል ህከኒች ኤተሮን ዬሩሳሌመ ኦሮዕይ አመዕናኑተ ወገሬትሾች ኤተሮን ዘህ አንጾክ ከተመ ኦሮዕዮ። <verse eid="ACT 18:22"/><verse number="23" style="v" sid="ACT 18:23"/>እስን ቀዉ ወክት አንጾክ ከተማን ዱንኬች ኤተሮን ህከንቤቺች ኬዕይ «ገለትየለከ ፍርግየ» ዬኖ ባዶን ቤቺች ቤቹ ዘሀን አመዕናኑተ ጉዕመንከ ጠረኝሰኖሳት እቅ።<verse eid="ACT 18:23"/></para>
  <para style="s1">አጵሎስ ኤፌሶንለከ ቆሮንቶስ ከተማን ተማርሴገ</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24"/>«አጵሎሴ» ዬኖሁ አሌክሰንደር ከተማን እለሞ አይሁድቹ ኤፌሶን ከተመ አሜቾ፤ እስን ጡመገ ጠወአኖሃለከ ጠሊለ መጻፈ አጥራመች ደገኖሃ እቅ። <verse eid="ACT 18:24"/><verse number="25" style="v" sid="ACT 18:25"/>እስን ቀርች ዎቄተኔሃ ጡመገ ተማሮሃለከ ህትን አበ ቡብ ኢስ ሀንቅ ጠወ ጌጥ አዕይ ጠወአኖለከ ተማርሰኖ እቅ፤ እኮጎሬ እስ ጠለዕል ያህይ ጠመቆ ጥምቀት ደገኖ እቅ። <verse eid="ACT 18:25"/><verse number="26" style="v" sid="ACT 18:26"/>ህትን እስን መለል አይሁድ ጭምት ምኔን ጠወአኖሃ ጵርስቅልለከ አቂል ሞጮጭቶ ወክት ምንሰ መስት መገን ዎቃሃ ወዕኔች ባሰ ተማርስቶስ። <verse eid="ACT 18:26"/><verse number="27" style="v" sid="ACT 18:27"/>ህትን አጵሎስ አካይ ባዱ መሮተ ሀሾ ወክት አመዕናኑት ጠረኝሶስ፤ እሰን አካይ ባዶን ሄኦ አመዕናኑት ቶጎስተ ደብዳቤተ ከተቦስ፤ እስን ህከ ቤቹ ኢሌ ወክት መገን አያኒን አመዕንቶእረ አበ ሀዕለኖሳት እቅ። <verse eid="ACT 18:27"/><verse number="28" style="v" sid="ACT 18:28"/>ህካን እኮቤቺሃ ኢስ ቡረሞሃ እሁስ ጉዕማንከ መን ብሬን አይሁድ መኒሃ ጠሊለ መጻፊች አነበበን ጠረኝ ኦደን ገረኖሳት እቅ።<verse eid="ACT 18:28"/></para>
  <chapter eid="ACT 18"/>
  <chapter number="19" style="c" sid="ACT 19"/>
  <para style="s1">ጳዉሎስ ኤፌሶን ከተማን ተማርሴገ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1"/>አጵሎስ ቆሮንቶስ ከተማን ሄዕዮ ወክት ጳዉሎስ አል ባዲን ህግ ኤፌሶን ከተመ አሜቾ፤ እስን ህከን ቤቾን ቀዉ አመዕናኑተ ደግ <verse eid="ACT 19:1"/><verse number="2" style="v" sid="ACT 19:2"/>ጳዉሎስ «አመዕንቴንተ ወክት ጠሊለ አያነ ቶጌንታእቅንዶ?» ዬሰ፤ እሰን «ቶንጎምበአ፤ ጠሊለ አያነ ሄኡስ ሆሮ ሞጮጭን ደንጋምበአ» ይቶኡ።<verse eid="ACT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3"/>ህትን ጳዉሎስ «ህከረ ሀትኔ ጥምቀቲሃት ጠመቀንቴንታሁ?» ዬሰ፤ እሰን «ያህይ ጥምቀትኒት ጠመቀሞሚሁ» ይቶኡ።<verse eid="ACT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4"/>ጳዉሎስን «ያህይ ‹ኡመቲሃ ጩብክዕኔ ቶበቴን ፈንቀልቴን ኢች ኤተሮን አሜተኖ ኢሳን አመዕንቴን ጠመቀሜ› ዬእ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">19፥4 </char><char style="xt" closed="false"><ref loc="MAT 3:11">ማቶ. 3፥11</ref>፤ <ref loc="MRK 1:4">ማር. 1፥4</ref>፤ <ref loc="MRK 7-8">7—8</ref>፤ ሉቃ. 3፥4፥16፤ <ref loc="JHN 1:26-27">ያህ. 1፥26-27</ref>።</char></note><verse eid="ACT 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5"/>እሰን ህካን ሞጮጭቶ ወክት ቀርቾሃ ኢስ ሱዕሚን ጠመቀንቶኡ። <verse eid="ACT 19:5"/><verse number="6" style="v" sid="ACT 19:6"/>ህትን ጳዉሎስ አንገስ እሰ አሌን አዕዮ ወክት ጠሊለ አያነ እሰ አሌን አሜቻን አደደ አፎን ጠወኦኡ፤ ራገሃ ጠወኡ ጀመርቶኡ። <verse eid="ACT 19:6"/><verse number="7" style="v" sid="ACT 19:7"/>እሰ ጉዕሙንኩሰ ቶነ ለሞ መንየ ጌሰ እቅ።<verse eid="ACT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8"/>ጳዉሎስ አይሁድ ጭምት ምኒ መር ሰሶ አገን ጌሰ መገን ዎምነትተኔሃ ኦደን መለል መኒሃ ተማርሰኖት እቅ። <verse eid="ACT 19:8"/><verse number="9" style="v" sid="ACT 19:9"/>ጠዉ እኮጎሬ መት-መቱ ጢቃመተ እኮቤቺሃ ኢስ ዎቃሃ ኡመት ብሬን ቦሮርተን አመዕኑ ግቦ ወክት እሰንተ ጌኝ አዕዮ፤ እስን አመዕናኑተ አደ አዕይ እስቤቹ መስ «ጢራኖሴ» ዬኖ መንቹ ተማርሰኖ ቤቾን መኒሃ በሬን በሬን ተማርሰኖት እቅ። <verse eid="ACT 19:9"/><verse number="10" style="v" sid="ACT 19:10"/>እስይ ባዶን ሄኣ አይሁዱለከ ግርክ መኑ ጉዕሙንኩ ቀርች ላገተ ሞጮጭት ቶጎተ ኢለ ጳዉሎስ ህከን ቤቾን ለሙ ዘማን ተማርሴእ።<verse eid="ACT 19:10"/></para>
  <para style="s1">መገኑ ጳዉሎሴ አንጋን አዕዮ አጅበተ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11"/>ህትን መገኑ ጳዉሎሴ አንጋን አበ አጅበተ አአኖት እቅ። <verse eid="ACT 19:11"/><verse number="12" style="v" sid="ACT 19:12"/>ህካን እኮቤቺሃ ጳዉሎሴ ጅስመስ ኡልቶ ኦድኑተለከ ማረበ ኣኤን ጥዘናመ አሌን አኤኖ ወክት ጥዘናችሰ ፈይታ እቅ፤ ዶሮረኖ ዱሩንኩ ፉለኖት እቅ። <verse eid="ACT 19:12"/><verse number="13" style="v" sid="ACT 19:13"/>መኒች ሩሃንየንከ ፉሽተን ዘህታ አይሁዲች መት-መቱ ቀርቾሃ ኢስ ሱዕመ ገእተን «ጳዉሎስ ዱዱብሰኖ ቀርቾ ኢስ ሱዕሚን ፉልቶኖተ አዘንዛንክዕኔ» ይተን መኒች ሩሃንየ ፉሽቶተ አጰንታኢት እቅ። <verse eid="ACT 19:13"/><verse number="14" style="v" sid="ACT 19:14"/>አይሁድ ሎረ ቂሳች መቲሃስ አስቄዋ ዬኖሀኒሃ ህት አታ ለመል ለቤ እለት ሄኦስ እቅ።<verse eid="ACT 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 19:15"/>ጠዉ እኮጎሬ ዶሮረኖ ዱሩ ፈንቀሽ «ኢሰ ደጋም! ህትን ጳዉሎሴተኔሃ ደጋም፤ ህከረ አዕኑ አዬኤታን?» ዬሰ።<verse eid="ACT 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 19:16"/>ዶሮረኖ ዱሩ አፎስ መንቹንኩ እሰንተ ኬዕይ አለግሽ ጉዕመንከሰ ቄል ጡላይሽ ኦድኑሰ ፊላን ከልሰ ምኒች ሁንት ፉልቶኡ። <verse eid="ACT 19:16"/><verse number="17" style="v" sid="ACT 19:17"/>ሁኩ ጠዉ ኤፌሶን ከተማን ሄኣ አይሁድለከ ግርክ መኒሃ ጉዕሚንከ ሞጮጨሞ ወክት አበ ዋጅቶኡ፤ ህከንቤቾንን ቀርቾ ኢስ ሱዕሙ ሎረ እኮ። <verse eid="ACT 19:17"/><verse number="18" style="v" sid="ACT 19:18"/>አመዕንቶ መኒች ልግቡሰ አሜት ሂለ ሆጎችሰ ቶበታኢት እቅ። <verse eid="ACT 19:18"/><verse number="19" style="v" sid="ACT 19:19"/>ህትን አስማእ አታሩ አስማእ መጻፈተ ጭምአት ጉዕማንከ ኡመት ብሬን ቡስቶኡ፤ መጻፉስ ህሬማ እቃን ፉሸኖ ጌሰ ገመቴኖ ወክት አበ ጤአተ እኮ ብረቲን መክሴመ ኦንታሁ ኩሜ ጠገር ብር ጌሰ እኮ። <verse eid="ACT 19:19"/><verse number="20" style="v" sid="ACT 19:20"/>ህካን እኮቤቺሃ ቀርች ላገት አልባዕልተንለከ ነጵተን መርታኢት እቅ።<verse eid="ACT 19:20"/></para>
  <para style="s1">ኤፌሶን ከተማን ኬኦ ብተተኔሃ</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21"/>ሁኩን ጉዕሙንኩ እኮች ኤተሮን ጳዉሎስ ሜቄዶንለከ አካይ ባድ አዲን ህግ ዬሩሳሌም ከተመ መሮተ ጠሊለ አያኒን ሰውይኬእ «ህከ ቤቹ ኢሌምሀኒች ኤተሮን ህትን ሮም ከተመ መር ለኡ ሀስሰኖኤ» ዬእ። <verse eid="ACT 19:21"/><verse number="22" style="v" sid="ACT 19:22"/>ጳዉሎሴ ሀዕልታሀኑኡች ለሙ ጥማቶሴለከ ኤራስጦሴ ሜቄዶን ባዱ ሶክ እስ ገዉስ እስይ ባዶን ቀዉ ጌሰ ዱንኬእ።<verse eid="ACT 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23"/>ህከ ወክት ኢስ ዎቄተኔሃ ኤፌሶን ከተማን አቡ ብተት ኬኦኡ። <verse eid="ACT 19:23"/><verse number="24" style="v" sid="ACT 19:24"/>ህከኔ ብረ ሽልስ መክሰኖ «ድሜጥሮስ» ዬኖ መቱ መንቹ «አርጤምሴ»<note caller="+" style="f"><char style="fqa" closed="false">አርጤምሴ፦ </char><char style="ft" closed="false">ዩ ኤፌሶን ከተሚሃ ሽርኬተ መገንቹ።</char></note> ምኒሃ ምስለ ብሪን አሲሰን መክሳሀኑኡተ ልግብ ብረ ደእታገ አአኖት እቅ። <verse eid="ACT 19:24"/><verse number="25" style="v" sid="ACT 19:25"/>ህካን እኮቤቺሃ እሲን ህከ ብረ አታ መነለከ ህትን ሆጉተ አታእረ ጭምአዕይ «ኮ መነ! ነኡ ብረ ደእናሚሁ ከን ሆጎን እሁስ ደጌነንተ። <verse eid="ACT 19:25"/><verse number="26" style="v" sid="ACT 19:26"/>ህትን ኩ ጳዉሎስ መን አንጋን መኬ ምስለ ‹ሽርኬተበአ› የን ጠለዕል ኤፌሶን ከተማን እሁዕነ ቀዎ ባድ ቤሉ እስይ ባዶን ጉዕማንን ልግቡ መኑ አመዕነኖገ አኡስለከ ሉሲሱስ አዕኑን ገውንኩክዕኔ ለኤንታእሃለከ ሞጮጭቴንታእሃን። <verse eid="ACT 19:26"/><verse number="27" style="v" sid="ACT 19:27"/>ህካን እኮቤቺሃ ጠለዕል ኒ ሆጉት ህንቀንቶኢተ እኩዕነ እስይ ባድ መኑ ጉዕሙንኩ ኣዱንያ አል መኑ ሰገደኖ ሎረ ‹አርጤምሴ› ዬኖ ሜኣ መገን ምኑ ኦነ እክ ፈቀኖ፤ ህትን እሴ ኬዕምኙሴ ሻረሞንከስበእንዶ?» ዬሰ። <figure style="fig" alt="Goddess Diana or Artemis of the Ephesians" file="HK00286B.tif" size="span" ref="19፥28">አርጤሚሴ ሽርኬ ምስለ</figure><verse eid="ACT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28"/>እሰን ህካን ሞጮጭቶ ወክት አበ ኡሙዕርት «ኤፌሶን ከተም አርጤምስ ሎረታን» ይተን ያርቶኡ። <verse eid="ACT 19:28"/><verse number="29" style="v" sid="ACT 19:29"/>ህካን እኮቤቺሃ ኤፌሶን ከተማን ልግቡ ብተት እካን መቄዶን ባዲች አሜቶ ጳዉሎሴ ጃለተ ጋዮሴለከ አርስጣርኮሴ አፍ ጎሾሽተን ኡመቱ ጭምየኖ ቤቹ ሜጡበ እክ ደጉደን አሜቶኡ። <verse eid="ACT 19:29"/><verse number="30" style="v" sid="ACT 19:30"/>ጳዉሎስ ህከን ጭምዬ መንቤቹ መሮተ ሄዕላቾረ አሳበት ከንቶስ። <verse eid="ACT 19:30"/><verse number="31" style="v" sid="ACT 19:31"/>እስይ ባድ ገሻኖች ጳዉሎሴ ጃለተ እኮእሩ ጳዉሎሴቤቹ ሶክ መኑ ጭምዬ ቤቹ መረኖበእገ ኡጭቶኡ። <verse eid="ACT 19:31"/><verse number="32" style="v" sid="ACT 19:32"/>ኡመትስ በላን አበ ብተት እኮቤቺሃ መቱ መቱርቹንከ ህትን ዎሉንገ ዎሉርቹ የን ያረኖት፤ እኮጎሬ ልግቡሰ ሚሃ ጭምይቶ ጎሬ ደጎበአ እቅ። <verse eid="ACT 19:32"/><verse number="33" style="v" sid="ACT 19:33"/>መት-መቱ አይሁድ አድሩ «አለክሰንድሬ» ዬኖ መንቹ ኡመት በሊች ሀንበልተን መን ብርተ ፉሽቶኡ፤ ኡመት በሊች መት-መቱሰ ጡመገ ኦዶሰተ ሸዞስ፤ አለክሰንድርን ኡመቱ ጨለ ዮተ አንገስ ቀቀሽ ኦደኖ ጠወ ጠወኦተ ቅጥዬእ። <verse eid="ACT 19:33"/><verse number="34" style="v" sid="ACT 19:34"/>ጠዉ እኮጎሬ እስክንድር አይሁድቹ እሁስ እሰ ደጎ ወክት «ኤፌሶን ከተም አርጤምስ ሎረታን» ይተን ለሙ ሳኣት እሀኖ ጌሰ ጉዕሙንኩሰ ሜጡበ እክ ያርቶኡ።<verse eid="ACT 19:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35"/>ህትን ኤፌሶን ከተም ዋኑ ከተባንቹ ኡመት ሰዕምየኖገ አዕይ «ኤፌሶን ከተም መነ! ኤፌሶን ከተም መኑ ሎረ ‹አርጤምሴ› ሜኣ ሽርኬተ ሰገዴኖ ምኒለከ ሰሜች ድሬኢሃ ጠሊለ ክኑ አገርታእረ እሁሰ ጉዕመ ቤቾንን ደገሞኡ። <verse eid="ACT 19:35"/><verse number="36" style="v" sid="ACT 19:36"/>ህካን እኮቤቺሃ ካን ለገአኖሁ ሄዕባሃ እሁስ ደጌንታች ሰዕምይዬ ቤሉ መቱርቹሃ ደዕልቴን አቶኖቼ። <verse eid="ACT 19:36"/><verse number="37" style="v" sid="ACT 19:37"/>መሰንትስ አዕኑ አርጥምሴ ምኒ ኦዳተ ሞግትበረለከ እሴተ ቦሮርትበ መነ አፌን ከቤቹ አሜቴንታአ። <verse eid="ACT 19:37"/><verse number="38" style="v" sid="ACT 19:38"/>ህትን ዴሜጥሮስለከ እሲን ሜጡበ ብረ ሽልስ መክሰኖ መንቹ ዮ ጎሬ ኦዱን፤ ፈረዴኖ በሩለከ ኦዳገ አታ ዳኛኑት ህከኔ ዮቤቺሃ ኦዱን። <verse eid="ACT 19:38"/><verse number="39" style="v" sid="ACT 19:39"/>እኮጎሬ ዎሉ ሀሴነንተ ጠዉ ዮ ጎሬ ሕግ ኦገቴን ለኤኖ። <verse eid="ACT 19:39"/><verse number="40" style="v" sid="ACT 19:40"/>ህካን እህበጎሬ ነኡ ‹ከበር እኮ ጠዊ ብተተ ኬሶእረ› ዬን ኦዴኖኔበእገ ዋጅናም፤ መሰንትስ ‹ኩ ብተት ኬኦኢሁ መርቹሃን› ዬን ጠዕሜመኔ ጎሬ ይናምርቹ ዮበአ» ይቶኡ። <verse eid="ACT 19:40"/><verse number="41" style="v" sid="ACT 19:41"/>እስ ህካን ጠወዕዮች ኤተሮን ኦገቾ መኑ ብንየኖገ አዕዮ።<verse eid="ACT 19:41"/></para>
  <chapter eid="ACT 19"/>
  <chapter number="20" style="c" sid="ACT 20"/>
  <para style="s1">ጳዉሎስ መቄዶነለከ ግሪክ ባዱ ኦሮዕዮገ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1"/>ብተተ ኡርቶች ኤተሮን ጳዉሎስ አመዕናኑተ ሜጡበ ገእ ሸዥ «ወገሬቲን ሄዕዬ» ይ ሜቄዶን ባዱ ኦሮዕዮ። <verse eid="ACT 20:1"/><verse number="2" style="v" sid="ACT 20:2"/>እስን ህከን ባዲን ህገን አመዕናኑተ ልግቤ ሸዘናን ጠረኝሰን ግርክ ባዱ ኦሮዕዮ። <verse eid="ACT 20:2"/><verse number="3" style="v" sid="ACT 20:3"/>ህከንቤቾንን ጳዉሎስ ሰሱ አገነ ዱንኬች ኤተሮን መርከባን ሶርይ ባዱ መሮተ ሰውዬእ፤ እኮጎሬ አይሁድ መኑ እስ አሌን ተንኩተ አቶተ ሰውይቶገ ደጎ ወክት ሜቄዶን ባዲን ህጎተ ሰውዬእ።<verse eid="ACT 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 20:4"/>እሲን ሜጡበ ሄኦእሩ ቤርይ ከተም ጵርሁሴ ቤቱ ሶጳጥሮስ፥ ተሰሎንቄ ከተም መኒች አርስጥሮኮስለከ ስኮንዱስ፥ ደርቤ ከተሚች ጋይዮስ፥ እስይ ባድ ቲኪቆስለከ ጥሮፊሞስ ህትን ጢማቶስ እሳን ሜጡበ ሄዕዮ እቅ። <verse eid="ACT 20:4"/><verse number="5" style="v" sid="ACT 20:5"/>እሰን ብርተ ህግ ጢሮኣድ ከተማን አገርቶኡ። <verse eid="ACT 20:5"/><verse number="6" style="v" sid="ACT 20:6"/>ጠዉ እኮጎሬ ነኡ ጦሮሹ እቴነን ከበጄኖ ከበጀቲች ኤተሮን ፍልጵስዩስ ከተመ መርከባን ኣንግ ኦንትቅ በር ጢሮአድ ከተመ እሰቤቹ ኢልኖም፤ ህከን ቤቾን ለመለ በር ዱንክኖም።<verse eid="ACT 20:6"/></para>
  <para style="s1">ጳዉሎስ መጨረሻን ጥሮአደ ኦሮዕዮገ</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7"/>ሳምንት ወዕኔ በሬን<note caller="+" style="f"><char style="fqa" closed="false">እቸተ ሜጡበ እንቶተ፦ </char><char style="ft" closed="false">የኖሁ ግሪክ መጻፋን ጦሮሹ ቢጡ የኖ፤ ፍሳርስ ቀርች ሁርባት ዩ እሆተ አታለኖ።</char></note> ጭምይኖምሀኔን ጳዉሎስ ለንክ በር ገስመ ዎሉቤቹ መረኖቤቺሃ ህከኔ ሄዕዮ መኒሃ ጠወኡ ጀመሮ፤ እስ ጠወስ ጠወአንን ሀንከዕሬ ሜሬሩ እኮ። <verse eid="ACT 20:7"/><verse number="8" style="v" sid="ACT 20:8"/>ነኡ ጭምይኖም ፉቅ ምኔን ልግቡ መብራቱ ሄዕዮ እቅ። <verse eid="ACT 20:8"/><verse number="9" style="v" sid="ACT 20:9"/>ኤውጤኪስ ዬኖ መቱ ዎደልቹ መንቹ መስኮት አሌን አፉዕልዮ እቅ፤ ጳዉሎስ ጠወ ቅራርሴሃን ሁኩ ዎደልቹ አበ ግሾቤቺሃ ሰቅ ፉቂች ዎሮ ዋል ኡቦ፤ መኑ ኬሰኖ ወክት ሬዮ እቅ። <verse eid="ACT 20:9"/><verse number="10" style="v" sid="ACT 20:10"/>ጠዉ እኮጎሬ ጳዉሎስ ድር ዎደልች አሌን ሙግይ አንጋንከስ ሀንቀፍ «ህልቆኖቼ ፎሊን ዮኡ» ዬሰ። <verse eid="ACT 20:10"/><verse number="11" style="v" sid="ACT 20:11"/>ጳዉሎስ ፉቅ አል ፈንቀል ፉል እሳንን እቸተ ሜጡበ እች ኡለት ሶዞተ ኢለ ኩሎች ኤተሮን ኦሮዕዮ። <verse eid="ACT 20:11"/><verse number="12" style="v" sid="ACT 20:12"/>ህትን እሰ ፈዬ ዎደልቹ ምኒ ኣእት መርት አበ ሙንደእ መት-መቱሰ ጠረኝሶኡ።<verse eid="ACT 20:12"/></para>
  <para style="s1">ጳዉሎስ ጢሮኣዲች ሚሊጢተ ኦሮዕዮገ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13"/>ጳዉሎሴ ቶንግ ህርሲንሶተ ሄጭን መርከባን ኣንግ አሶሰ መርኖም፤ መሰንትስ እስ ህከ ከተመ ሎከ መሮተ ሀሽ ነኡ ህት አዕኖተ አዘዦኔቤቺሃት። <verse eid="ACT 20:13"/><verse number="14" style="v" sid="ACT 20:14"/>ህትን ነኡ እሲን አሶስ ከተማን ደቀም እሱ ቶንግ መርከባን ኣግንስ ሚጢሊኒ ከተመ መርኖም። <verse eid="ACT 20:14"/><verse number="15" style="v" sid="ACT 20:15"/>ነኡ ለንክ በር መርከባን ኣንግ ዊን ረበንቶ «ኪዮሴ» ዬኖቤቹ ኢልኖም፤ ህትን ለንክ በር «ሳሞሰ» መድን ህንግ ሰቅ በር ሚሊጢ ከተመ ኢልኖም። <verse eid="ACT 20:15"/><verse number="16" style="v" sid="ACT 20:16"/>ጳዉሎስ እስይ ባዶን ልግብ ወክት ዱንኩዕነ ኤፌሶን ከተመ አጉር ህጎተ ሀሾ፤ መሰንትስ አታልሲሾስጎሬ ጴንጠቆስጤ ከበጃት ዬሩሳሌም ከተማን ከበጆተ ሀሾቤቺሃት እቅ። <figure style="fig" alt="Boat" file="CN01719B.tif" size="span" ref="20፥13-15">መርከበ</figure><verse eid="ACT 20:16"/></para>
  <para style="s1">ኤፌሶን ከተም አመዕናኖ ባልቃተ ጳዉሎስ ጠወዕዮ መጨረሽ ጠውተኔሃ</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17"/>ጳዉሎስ ሚሊጢን ከተሚች መነ ሶክ ኤፌሶን አመዕናኖ ባልቀተ ገእሲሾ። <verse eid="ACT 20:17"/><verse number="18" style="v" sid="ACT 20:18"/>እሰን እስበ አሜቶ ወክት «አን እስይ ባዱ መር አፉዕሌም በሬች ጀመር ጉዕመ ወክትንከ በላንከክዕኔ ሀት እክ ሄዕዮምጎሬ አዕኑ ገዉክዕኔ ደጌነንተ። <verse eid="ACT 20:18"/><verse number="19" style="v" sid="ACT 20:19"/>ህትን አይሁድ ሂለ ሰውት መሳን ኦርጨቀሞምጎሬ ጉዕመንከ አታለን ገውእ ሙግ አዕይ እንጅጀአን ቀርቹ ካደማም እቅ። <verse eid="ACT 20:19"/><verse number="20" style="v" sid="ACT 20:20"/>ኦገትቤቾን እኮ ምኒች ምኒ ሃመን ተማርሳም ወክት ደግለለኖህዕኔሃ ጉዕመንከ ኩሎንክዕኔ ቤሉ መቱርቹሃ ኩሉዕነ ፌሾምበአ። <verse eid="ACT 20:20"/><verse number="21" style="v" sid="ACT 20:21"/>አይሁድ መኑለከ ግርክ መኑ ጩብችሰ ቶበት መገን አደ ፈንቀልት ቀርቾ ኢሳን አመዕንቶተ ኩሎንሰ። <verse eid="ACT 20:21"/><verse number="22" style="v" sid="ACT 20:22"/>ጠሊለ አያኒን አዘዘም ዬሩሳሌም ከተመ መራሚት፤ ህከን ቤቾን መ እሀም ጎሬ ደጎምበአ። <verse eid="ACT 20:22"/><verse number="23" style="v" sid="ACT 20:23"/>ጠዉ እኮጎሬ ኡሱረሙለከ ኦርሸት እልታኤገ ከተማን ጉዕማንን ጠሊሉ አያኑ ኩሎኤ እቅ። <verse eid="ACT 20:23"/><verse number="24" style="v" sid="ACT 20:24"/>እኮጎሬ አን ቀርቾ ኢሲች ቶጎም ሆጉተ ሹሎተ ኢለ ገይኤ ፎሊሃ አሙዛምበአ፤ እስን መገን ኣስቱተ ተሽት ላገተ ኩሉሃን።<note caller="-" style="x"><char style="xo" closed="false">20፥24 </char><char style="xt" closed="false"><ref loc="2TI 4:7">2 ጢሞ. 4፥7</ref>።</char></note><verse eid="ACT 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25"/>«ህትን ከበሬ ኢሎተ ኢለ ክዕኔ ጉዕምክዕኔ በላን ፈንቀላመን መገን ዎምነትተኔሃ ተማርሳንክዕኔ፤ ከኒች ኤተሮን ክዕኔ በሊች አዪሁ ለአኖኤበእገ ደጋም። <verse eid="ACT 20:25"/><verse number="26" style="v" sid="ACT 20:26"/>ህካን እኮቤቺሃ ክዕኔ በሊች መቱ መንቹ በዕዮ እቃ ሩበት እሀንክዕኔበእገ ኩላንክዕኔ። <verse eid="ACT 20:26"/><verse number="27" style="v" sid="ACT 20:27"/>መሰንትስ መገን ሰዉት ጉዕመንከ ኩሎንክዕኔ ቤሉ ኩሉዕነ ፌሾምርቹ መቱርቹሁ ዮበአ። <verse eid="ACT 20:27"/><verse number="28" style="v" sid="ACT 20:28"/>መገኑ ገይስ ቤት ቄጊን ዎዦህዕኔ አመዕናኖ ጭምት አገርቶኖተ ጠሊለ አያኒን ክዕኔተ ዜማንቹ አዕይ መጠሮህዕኔ መገን ሆለ ዜሜሃለከ ገይሃክዕኔ አገዕርዬ። <verse eid="ACT 20:28"/><verse number="29" style="v" sid="ACT 20:29"/>አን ኦሮዕዮሚች ኤተሮን መገን ሆለ ዜሜሃ አሙዝቡ ሆሌገ ጎደበ ጠረኛኑት ሂሉ መኑ አሜት ክዕኔ በለ ኣጋገ ደጋም። <verse eid="ACT 20:29"/><verse number="30" style="v" sid="ACT 20:30"/>ህትን መት-መቱ መኑ ክዕኔ ገይክዕኔ በሊች ኬእ ሉሲሰኖ ትምርት ተማርስተን ልግብ አመዕናኑተ እሰ አደ ፈንቀሽታአ። <verse eid="ACT 20:30"/><verse number="31" style="v" sid="ACT 20:31"/>ህካን እኮቤቺሃ አን ጉዕማንከ መኒሃ ሀንከዕርተለከ በራሃ እንጅጃተ ዱነን ሰሱ ዘማን ሸዦንክዕኔገ ቃጌነን አገዕርዬ።<verse eid="ACT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32"/>«ህትን ቴሁ መገኒሃለከ ጉዕመንከ ጠሊላኖ በላን ጠረኝሰኖህዕኔ መገን ርስተ ኣሶተ አታለኖ ኣስቶ ላጋተ ኤገተ ኣስዮንክዕኔ። <verse eid="ACT 20:32"/><verse number="33" style="v" sid="ACT 20:33"/>አን አዬ ብረ ህከረንገ ዎርቀ ህከረንገ ኦድኑተ ሄዕላቾምበአ። <verse eid="ACT 20:33"/><verse number="34" style="v" sid="ACT 20:34"/>ኤሳሃለከ ኢን ሜጡበ ዮሀኑኡተ ሀስሰኖርቹ አንጋንከኤ አአን ደግለሎምገ አዕኑ ገዉንኩክዕኔ ደጌነንተ። <verse eid="ACT 20:34"/><verse number="35" style="v" sid="ACT 20:35"/>‹ኣአኖሀኒች በትሽ ኣሰኖሁ ማሰአሞእሃን› ዬ ገይስ ቀርቾ ኢስ ላገተ ቃጊን አንጋንከኔ አዕነን ሆጎሀኑኡተ ደግለሉ ሀስሰኖ እሁስ ልግብያ ዎቄን ለሊሾንክዕኔ» ዬሰ።<verse eid="ACT 20:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36"/>ጳዉሎስ ህካን ጠወዕዮች ኤተሮን ጉዕሚንከሰ ጉሉጵ ዱአ አዕዮ። <verse eid="ACT 20:36"/><verse number="37" style="v" sid="ACT 20:37"/>እሰ ጉዕሙንኩሰ ኦአን ጳዉሎሴ ሀንቀፍ ሱንቅቶኡ። <verse eid="ACT 20:37"/><verse number="38" style="v" sid="ACT 20:38"/>በትስ አበ ሻዞ መሰት «ከኒች ኤተሮን ለንኪሃ እልኤ ለኦኖተ ሆሮን አታልቴነንተበአ» ዬሰቤቺሃት እቅ፤ እሰን መርከቡ ዮ ቤቹ ኢሎተ ኢለ ህርሲሶስ።<verse eid="ACT 20:38"/></para>
  <chapter eid="ACT 20"/>
  <chapter number="21" style="c" sid="ACT 21"/>
  <para style="s1">ጳዉሎስ ዬሩሳሌመ ኦሮዕዮገ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1"/>እሳች መለዕለሞሚች ኤተሮን መርከባን ኣንግ ጌጥይን «ቆስ» ዬኖ ባዱ መርኖም፤ ህትን ለንክስ በር ዊን ረበንቶ «ሩደ» ኢልኖም፤ ህከንቤቺች ኬዕን «ጳጥራ» ዬኖ ከተመ መርኖም። <verse eid="ACT 21:1"/><verse number="2" style="v" sid="ACT 21:2"/>ህከን ቤቾን ፍንቄ ባዱ ኦሮአኖ መርከበ ደእን እሲን ኣንግ መርኖም። <verse eid="ACT 21:2"/><verse number="3" style="v" sid="ACT 21:3"/>ዊን ረበንቶ «ቆጵሮሰ» ዬኖ ኡለተ ለእን ጉረ አዲን አጉርን ሶርይ ባዱ መርን «ጥሮሰ» ዬኖ ከተመ ኢልኖም፤ ሁኩ ቤቹ መርከቢች ኦደተ ድሪሴኖሃ ቤቹ እቅ። <verse eid="ACT 21:3"/><verse number="4" style="v" sid="ACT 21:4"/>ህከን ቤቾን አመዕናኑተ ሀንስ ደንጎም ወክት እሰቤቾን ለመለ በር ዱንክኖም፤ እሳንከ ጠሊሉ አያኑ ለሊሻንሰ «ጳዉሎሴ! ዬሩሳሌም ከተመ መርቶት» ይት ኩልቶስ። <verse eid="ACT 21:4"/><verse number="5" style="v" sid="ACT 21:5"/>እኮጎሬ ነኡ ህከን ቤቾን አገርናም ወክቱ ጎፋን ሃሞተ ኬዕኖም፤ እሰ ጉዕሙንኩሰ ሜንቲንከሰለከ እላንተሰ ሜጡበ ከተሚች አብል ኢሎተ ኢለ ህርሲሶኔ፤ ባር መዴን ጉሉጵን ዱአ አዕኖሚች ኤተሮን «ወገሬት ሄዕዬ» ይን አደ እንኮም። <verse eid="ACT 21:5"/><verse number="6" style="v" sid="ACT 21:6"/>ህከኒች ኤተሮን ነኡ መርከባን ኣንጎም፤ ህትን እሰን ምንሰ ፈንቀልት መርቶኡ።<verse eid="ACT 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7"/>ነኡ ጢሮሲች ኬዕን «ጴጤሌማይስ» ዬኖ ከተመ ኢልኖም፤ ህከን ቤቾን አመዕናኖን ደቀም ወገሬትጨቀሞሚች ኤተሮን እሳን መቱ በር አገርኖም። <verse eid="ACT 21:7"/><verse number="8" style="v" sid="ACT 21:8"/>ለንክስ በር እሳች መለዕለሞሚች ኤተሮን ቄሳር ከተመ ኢልኖም፤ ህከኔን መጠረንቶ ለመላ ዳቆናች «ፍልጶሴ» ዬኖ መንች ምኒ ኣንግ እሲን ሜጡበ አፉዕልኖም፤ ፍልጶስን መገን ላገተ ተማርሰኖ እቅ።<note caller="-" style="x"><char style="xo" closed="false">21፥8 </char><char style="xt" closed="false"><ref loc="ACT 6:5">ሶቀ. 6፥5</ref>፤ <ref loc="ACT 8:5">8፥5</ref>።</char></note> <verse eid="ACT 21:8"/><verse number="9" style="v" sid="ACT 21:9"/>እሲንከ ራገ ጠወኣ ሾልት ሀፍታኑት ሄኦስ እቅ። <verse eid="ACT 21:9"/><verse number="10" style="v" sid="ACT 21:10"/>ህከን ቤቾን ልግብ በር አፉዕልኖሚች ኤተሮን «አጋቦሴ» ዬኖ ነብዬቹ ይሁድ ባዲች አሜቾ። <verse eid="ACT 21:10"/><verse number="11" style="v" sid="ACT 21:11"/>ሁኩ ነብዬቹ ኒቤቹ አሜች ጳዉሎሴ ኢቱተ ኣእ ገይስ ሎከተለከ ገይስ አንገተ ኡሱር «ጠሊሉ አያኑ ‹ከን ኢቶ መንቹ ዬሩሳሌማን ዮ አይሁዱ ህት ኡሱርት አይሁደ እህበ መን አንጋን ህግስ ኣታአ› የኖት» ዬእ።<verse eid="ACT 21:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12"/>ህከ ጠወ ሞጮጭኖም ወክት ነኡለከ ህከኔ ሄኣ መኑሁ ጳዉሎሴ «ዬሩሳሌመ መርቶት» ይን ኡጭኖም። <verse eid="ACT 21:12"/><verse number="13" style="v" sid="ACT 21:13"/>እኮጎሬ ጳዉሎስ «ህት ኦኤነን ኢ ቀልብ ሚ ዶርቴነንታት? አን ቀርቾ ኢስተኔሃ ዬሩሳሌማን ኡሱረሙ እሁዕነ ሬሆታ ቅጥ ይዮም» ይ ፈንቀሼእ።<verse eid="ACT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 21:14"/>ጳዉሎስ ሸዘነኔ ቶጉ ግቦ ወክት «ቀርቹ ዬኢሁ እሁን» ይን አጉርኖም።<verse eid="ACT 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15"/>ህከኒች ኤተሮን ነኡ ኦዳኔ ቅጥ አዕን ዬሩሳሌመ መርኖም። <verse eid="ACT 21:15"/><verse number="16" style="v" sid="ACT 21:16"/>ህትን ቄሳር ከተማን ዮ አመዕናኑት መት-መቱ ኒን ሜጡበ እክ አሜቶኡ፤ እሰን ምናሶኔ ምኔን ፎሎጭኖተ እስ ምኒ መስቶኔ፤ ሁኩ መንቹ ዊ በላን ዮ «ቆጵሮሰ» ዬኖ ባዶን ዱንክዮእሃ አመዕናንቹ እቅ።<verse eid="ACT 21:16"/></para>
  <para style="s1">ጳዉሎስ ያቁበ ለኦተ ዬሩሳሌመ ኦሮዕዮገ</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17"/>ነኡ ዬሩሳሌመ ኢልኖም ወክት አመዕናኑት ሙንዲኖን ቶጎኔ። <verse eid="ACT 21:17"/><verse number="18" style="v" sid="ACT 21:18"/>ለንክስ በር ጳዉሎስ ኒን ሜጡበ እክ ያቁብቤቹ መርኖም ወክት ጉዕሙንኩ ጭምት ምኒ ባልቁ ህከኔ ሄኦ እቅ። <verse eid="ACT 21:18"/><verse number="19" style="v" sid="ACT 21:19"/>ጳዉሎስ እሰንተ ወገሬትሾች ኤተሮን መገኑ አይሁደ እህበ መን በላን እስ ክድማን አዕዮሃ መት-መቲን ኩሎሰ። <verse eid="ACT 21:19"/><verse number="20" style="v" sid="ACT 21:20"/>እሰን ህካን ሞጮጭት መገኑ ገለትጭት «ኒ አመቤቶ ጳዉሎሴ! አመዕንቶ ልግቡ ኩሜ መኑ አይሁድ በላን ሄኡሰለከ ጉዕሙንኩሰ ሕጊሃ አዘዘንታኢሃ እሁስ አትን ደጋንት። <verse eid="ACT 21:20"/><verse number="21" style="v" sid="ACT 21:21"/>እሰን አት ‹አይሁደ እህበ መን በላን ሄኣ አይሁዲ ጉዕሚንከ እለሰ ጡርከንትበገለከ ሴረ አገርትበገ ተማርስተን ሙስ ሕገ ሻርታገ አታንቲት› ዬኖ ጠወ ሞጮጭቶኡ።<note caller="-" style="x"><char style="xo" closed="false">21፥21 </char><char style="xt" closed="false"><ref loc="ACT 11:28">11፥28</ref>።</char></note> <verse eid="ACT 21:21"/><verse number="22" style="v" sid="ACT 21:22"/>ህከረ መ አዕኑ? እሰ አት አሜቱክ ሀንቅንከ ሞጮጭታአ። <verse eid="ACT 21:22"/><verse number="23" style="v" sid="ACT 21:23"/>ህካን እኮቤቺሃ ነኡ ይናሚሃ አእ፤ ኒ በላን ሁንዱር ኣጎ ሾሉ መኑ ዮኡ።<note caller="-" style="x"><char style="xo" closed="false">21፥23 </char><char style="xt" closed="false"><ref loc="NUM 6:13-21">ዘኁ. 6፥13-21</ref>።</char></note> <verse eid="ACT 21:23"/><verse number="24" style="v" sid="ACT 21:24"/>ከ መነ ኣእት መርት እሳንን መገን ብሬን ገዉክ ነጠ አእ፤ እሰን ነጠ እኮተ ብረ አት ባትሰ፤ ህከኒች ኤተሮን ሙምሰ ሜዳኣ፤ ህካን አቶንትጎሬ ኪተኔሃ ጠወአሞ ጠዉ ክዝብ እሁስለከ አት ገዉክ ሕገ አገርተን ሄኣንትገ ጉዕሙንኩሰ ደጋአ። <verse eid="ACT 21:24"/><verse number="25" style="v" sid="ACT 21:25"/>እኮጎሬ አይሁደ እህበ መን አዲች አመዕንቶእሩ ክትም ክትንታን ንጃሾ እቸተ እታንትበእገ፥ ቄጉ አጋንትበእገ፥ ለንገእ ሬዮ ለል ማላ እትበገለከ ዝነተ አትበገ አገዕርቶተ ኢተቀሞም ጠወሃ ደብዳቤን ከተንቦክዕኔ» ይቶስ።<note caller="-" style="x"><char style="xo" closed="false">21፥25 </char><char style="xt" closed="false"><ref loc="ACT 15:29">ሶቀ. 15፥29</ref>።</char></note><verse eid="ACT 21:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26"/>ህከኒች ኤተሮን ጳዉሎስ ለንክ በር ህከ መነ ኣእ እሳንን ሜጡበ ነጠ እኮ፤ እስን ሁኩ መኑ ሄንኩ በሩ ኢሎተ ኢለ ነጠ እክ አገርታጎሬ ህትን ገገዉሰ ኣታ ሰደቀተ መ ወክት ኣታጎሬ ኤንኬዕንሶተ ዱእ ምኒ ኣጎ።<verse eid="ACT 21:26"/></para>
  <para style="s1">ጳዉሎሴ መገን ምኔን አፌመገ</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27"/>ለመሉ በሩ ጎፎተ እካን እስይ ባዲች አሜቶእሩ አይሁዱ ጳዉሎሴ መገን ምኔን ለእ ኡመት ጉዕመንከ አድመተ አት አፎስ። <verse eid="ACT 21:27"/><verse number="28" style="v" sid="ACT 21:28"/>እሰን «እስራኤል መነ! ሀዕልዬኔ! ከለዕዬ ኩ መንቹ ኡመትኔ፥ ሕገኔለከ ዱእ ምኒ ጥቅሽ ጉዕመንከ ቤቹ መረን ኡመት ተማርሰኖሃን፤ ሁኩንን ሆፈዕያንስ ግሪክ ባድ መነ ዱእ ምኒ ኣግሽ ፈየ እኮቤቹ ንጃስሾእሃን» ይት ያርቶኡ። <verse eid="ACT 21:28"/><verse number="29" style="v" sid="ACT 21:29"/>እሰን ህካን ይቶኢሁ ሄጭት ጳዉሎሴ ኤፌሶን ከተም ጥሮፊሞሴንን ሜጡበ እክ ዬሩሳሌም ከተማን ዮኢሃ ለኦስቤቺሃ እሱ ዱእ ምኒ አፍ ኣጎሃ አጉጆሰቤቺሃት እቅ።<note caller="-" style="x"><char style="xo" closed="false">21፥29 </char><char style="xt" closed="false"><ref loc="ACT 20:4">ሶቀ. 20፥4</ref>።</char></note><verse eid="ACT 21:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30"/>ከተሙስ ጉዕሙንኩ ሌንቄቄእ፤ ህትን መኑ ጉዕሙንኩ ሜጡበ እክ ደጉደን አሜት ጳዉሎሴ ኣእት ጎሾሽተን ዱእ ምኒች አብል ፉሽቶስ፤ ህከ ወክትንከ ዱእ ምኒ ኡሩት ጡፈንቶኡ። <verse eid="ACT 21:30"/><verse number="31" style="v" sid="ACT 21:31"/>ህትን እሰ ጳዉሎሴ ሽቶተ ሀሶ ወክት ሮም ባድ በገዝ ሀለቂሃ «ዬሩሳሌም ከተሙ ጉዕሙንኩ ጨነቀንቶኡ» ዬኖ ዱዱቡ ሞጮጨሞ።<verse eid="ACT 21:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 21:32"/>እስን ህከ ወክት ወታደረለከ ጥቤ ሀለቀ ኣእ ደጉደን መንቤቹ ኢሌእ፤ ሁኩ ጳዉሎሴ ኦልታእሩ በገዝ ሀለቀለከ ዎታደረ ለኦ ወክት ዎቀሩ አጉርቶኡ። <verse eid="ACT 21:32"/><verse number="33" style="v" sid="ACT 21:33"/>ህከ ወክትንከ ሀለቁ ኢል ኬዕይ ጳዉሎሴ አፍሲሽ ለሞ ሰንሰለቲን ኡሱሬኖገ አዘዥ «ኩ መንቹ አዬት? ህትን መርቹሃን አዕዮሁ» ይ ጠዕሜእ። <verse eid="ACT 21:33"/><verse number="34" style="v" sid="ACT 21:34"/>መኒች ደሩስ መቱርቹ ደሩስ ህትን ዎሉርቹ ይተን ጨንጭቶቤቺሃ በገዝ ሀለቁ ሀንቅ እኮ ጠወ ደጎተ አታሉ ሆጎ ወክት ጳዉሎሴ ዎታደር ቀእተ መስታገ አዘዦ። <verse eid="ACT 21:34"/><verse number="35" style="v" sid="ACT 21:35"/>ህከቤቹንከ መሴነን ጳዉሎስ አል ፉሌኖ ቤቹ ኢሌ ወክት ኡመቱ አበ ኡሙዕር እስ አሌን አደገ ኢልሶተ ሀሶገ ደግ ዎታደሩ እሱ እጅት መስቶስ። <verse eid="ACT 21:35"/><verse number="36" style="v" sid="ACT 21:36"/>ሁኩ ልግቡ ኡመቱ «ሽዬ» ይተን ጨንጭተን ዘክሳሲት እቅ።<verse eid="ACT 21:36"/></para>
  <para style="s1">ጳዉሎስ ኡመት ብሬን ገይስተኔሃ ጠወዕዮገ</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37"/>ጳዉሎሴ ዎታደሩ ገልታቤቹ ኣግሶተ ሆንጠኮ ወክት ጳዉሎስ በገዝ ሀለቀ «አን መቱርቹ ኩሎሄተ ፈቀደዕኔንዶ?» ዬእ፤ ሁኩ በገዝ ሀለቁ «ግሪክ ባድ አፎሃ ደገንንዶ? <verse eid="ACT 21:37"/><verse number="38" style="v" sid="ACT 21:38"/>ግደኖ በሬን ብተተ ኬስለከ ሾሎ ኩሜ ሽብር ኬሶረ ኣእት ኡለ ኡድመ ሁንቶንቲ ግብጽ ባድ መንቹ አቴበእንዶ?» ዬስ።<verse eid="ACT 21:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39"/>ጳዉሎስ በገዝ ሀለቀ « ‹ኪልቅየ› ዬኖ ባዶን ኤንኬዕነንቶ ጠርሴስ ከተማን እለሞምየ አይሁድቹ፤ ሀዕይ ኡመቲሃ ጠወኦተ ወክት ኣሴኤ» ይ ኡጬስ።<verse eid="ACT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40"/>ህትን እስ ጠወኦተ ወክት ኣስያንስ ጳዉሎስ ጎትዬ ቤቾን ኡር መኑ ሰዕምዮተ አንጋንተስ ቀቀሽ መኑ ጨለ ዬ ወክት እብራዌ መን አፎን መኒሃ ጠወኡ ጀመሮ።<verse eid="ACT 21:40"/></para>
  <chapter eid="ACT 21"/>
  <chapter number="22" style="c" sid="ACT 22"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1"/>ጳዉሎስ «አመኤ ኦሱትለከ አናከኤ አን ኣሳንክዕኔ መስለ ሞጮጭዬ» ዬእ። <verse eid="ACT 22:1"/><verse number="2" style="v" sid="ACT 22:2"/>እሰን እስ እብራዌ መን አፎን ጠወአን ሞጮጭቶ ወክት ወዕኔችን በትስ ጨለ ይቶኡ፤ <verse eid="ACT 22:2"/><verse number="3" style="v" sid="ACT 22:3"/>እስን «አን ኪልቅይ ባዶን ዮ ተርሴስ ከተማን እለሞምሃ አይሁድቹ፤ ተማሮሚሁ ከን ዬሩሳሌም ከተማኒት፤ ተማርሴኤሁ ገማልያሌት፤ እሲች አናከኔ ሕገ ጠረኝሽ ተማሮሚሁለከ ከበር አዕኑ ጉዕሙንኩ ደጌነንተገን መገኒሃ ቡብ ገዉእ ኣስ ካደማሚሃ መንቹ እቅ።<note caller="-" style="x"><char style="xo" closed="false">22፥3 </char><char style="xt" closed="false"><ref loc="ACT 5:34-39">ሶቀ. 5፥34-39</ref>።</char></note> <verse eid="ACT 22:3"/><verse number="4" style="v" sid="ACT 22:4"/>ኢስ ዎቃሃ አዎንታ መነ ጉዕመንከ ሬታኢሃ ኢለ ሸረን ጎነለከ ሜንቱ አፈን ኡሱር ምኒ ኣግሾምሃ እቅ። <verse eid="ACT 22:4"/><verse number="5" style="v" sid="ACT 22:5"/>ኩን ሀንቅ እሁስ ቂስ አዎንሳኑትለከ አይሁድ ኦገት ባልቀት ጉዕሙንኩ ኤሳሃ ምስክረተ፤ ደማስቆ ከተማን ዮ ህከ መነ ኡሱር ዬሩሳሌመ ኤቦተለከ ቀጠእሲሶተ አታልሲሰኖኤ ደማስቆን ዮ አይሁዲሃ ከተቦ ደብዳቤተ ቶጎሚሁ እሳችት።<verse eid="ACT 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6"/>«አንን ደማስቆ ከተመ መረን ኢሎተ ሆንጠኮምሀኔን መቱ በር ሌሆ ሰኣት ጌሳን ድንገቴን ሰሜች ሎሩ ኑሩ አዳንከኤ በለቆ። <verse eid="ACT 22:6"/><verse number="7" style="v" sid="ACT 22:7"/>ህትን ኡለ ኡብ ኤሳሃ ‹ሳኦሌ! ሳኦሌ! ሚሃት ሸርታንቴኤት?› ይታ ላገት ሞጮጬም። <verse eid="ACT 22:7"/><verse number="8" style="v" sid="ACT 22:8"/>አንን ፈንቀሽ ‹ቀርቾ አት አዬት?› ዬም፤ እስን ‹አት ሸርታንቴኤ ናዝሬት ኢሳት› ዬኤ። <verse eid="ACT 22:8"/><verse number="9" style="v" sid="ACT 22:9"/>ኢን ሜጡበ ሄኦእሩ ኑርስ ለኦ ቤሉ አይ ጠወአኖኤት ጎሬ ላገስ ሞጮጭቶበአ። <verse eid="ACT 22:9"/><verse number="10" style="v" sid="ACT 22:10"/>አንን ‹ቀርቾ! መ አኡ?› ዬም፤ ቀርቹንኩ ‹ኬእ ደማስቆ ከተመ መር፤ አታንቲሁ ጉዕሙንኩ ህከን ቤቾን ኩለመኖሄ› ዬኤ። <verse eid="ACT 22:10"/><verse number="11" style="v" sid="ACT 22:11"/>ህከን ኑር በለቅ መሳን ለኦተ አታሉ ሆጎምቤቺሃ ኢን ሜጡበ ሄኦ መኑ አንገኤ አፍ መሰግ ደማስቆ ከተመ ኢልሶኤ።<verse eid="ACT 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12"/>«ህከን ከተማን ‹ሀናንየ› ዬኖ መቱ መንቹ ሄዕዮ እቅ፤ ህከ መንቹንከ ደማስቆ ከተማን ሄኣ አይሁዱ ጉዕሙንኩ ገለትጭታሲሁ ሕገ ጡመገ አገረኖለከ አያኑ ዮስየ መንቹ እቅ። <verse eid="ACT 22:12"/><verse number="13" style="v" sid="ACT 22:13"/>እስን ኢቤቹ አሜች መዴንከኤ ኡር ‹አመኤ ቤቶ ሳኦሌ! ቴሱ ለእ› ዬእ፤ አንን ህከ ወክትንከ ለኦተ አታሎም። <verse eid="ACT 22:13"/><verse number="14" style="v" sid="ACT 22:14"/>እስን ‹አናከኔ መገን ሰዉት አት ደጎተ፥ ፈየ ለኦተለከ ላገስ ሞጮጭቶተ ሄጭ መጠሮሄ። <verse eid="ACT 22:14"/><verse number="15" style="v" sid="ACT 22:15"/>እስን ለኦንትለከ ሞጮጭቶንት ጠወ ጉዕመንከ መን ብሬን እስተኔሃ ምስክር እኮታት። <verse eid="ACT 22:15"/><verse number="16" style="v" sid="ACT 22:16"/>ህከረ መ አገርታንቲት? ቴሱ ኬእ ሱዕመስ ገእት ጠመቀም፤ ጩብችክ ነጠ እህ› ይ ኩሎኤ።<verse eid="ACT 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17"/>«ህከኒች ኤተሮን ህከ ዬሩሳሌመ ፈንቀል አሜቾሚች ኤተሮን መገን ምኔን ዱአ አአን መናመተ ለዕዮም። <verse eid="ACT 22:17"/><verse number="18" style="v" sid="ACT 22:18"/>ቀርቹንኩ ኤሳሃ ለልኤ ‹አት ኢተኔሃ ጠወኣንት ጠወሃ እሰ ቶጋበእቤቺሃ ዬሩሳሌሚች ደዕልት ፉል› ዬኤ። <verse eid="ACT 22:18"/><verse number="19" style="v" sid="ACT 22:19"/>አንን ቀርቾ! ‹ጭምት ምኒ ጉዕመንከ መረን ኪን አመዕኔ መነ ኦላምገለከ ኡሱራምገ እሰ ገዉንኩሰ ደጋአ። <verse eid="ACT 22:19"/><verse number="20" style="v" sid="ACT 22:20"/>ኬሳሃ ምስክር እክ ሄዕዮ እስጥፋኖሴ ቄጉስ ዱንቶ ወክት አን ጠዋንከስ ኢተቀም ሽታ መን መዴን ኡር ኦድኑሰ አገራም እቅ› ዬእ።<note caller="-" style="x"><char style="xo" closed="false">22፥20 </char><char style="xt" closed="false"><ref loc="ACT 7:58">ሶቀ. 7፥58</ref>።</char></note> <verse eid="ACT 22:20"/><verse number="21" style="v" sid="ACT 22:21"/>ቀርቹንኩ ‹ቄዕራሸ ዮ አይሁደ እህበ መንቤቹ ሶሃንኬቤቺሃ ከንቤቺች ኬእ ኦሮእ› ይ ኩሎኤ» ዬእ።<verse eid="ACT 22:21"/></para>
  <para style="s1">ጳዉሎስ ሮም ባድ መንቹ እሁስ ኩሎገ</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22"/>እስ ከ ጠወ ኩሎተ ኢለ ሞጮጭታሲት እቅ፤ እሰ ላገሰ ጎት አት «ህትናሙ መንቹ ፎሊን ሄኡ ሀስሰኖስበእቤቺሃ ዱንየ አሊች ከም» ይት ያርቶኡ። <verse eid="ACT 22:22"/><verse number="23" style="v" sid="ACT 22:23"/>ህትን እሰን ያርተን ኦድኑሰ ኡጅተን ትበ ሰማ ዋሽት ብን አታኢት እቅ። <verse eid="ACT 22:23"/><verse number="24" style="v" sid="ACT 22:24"/>በገዝ ሀለቁንኩ ጳዉሎሴ ወታደሩ ገልታቤቹ መስታገ አዘዦ፤ ህትን እስ አሌን መኑ ሚሃ ጨንጨኖጎር ደጎተ «ኦልቴነን መረመሬ» ዬሰ። <verse eid="ACT 22:24"/><verse number="25" style="v" sid="ACT 22:25"/>ጠዉ እኮጎሬ እሰ ጠፍሪን ጠረኝስ ኡሱርቶ ወክት ጳዉሎስ መዴንከስ ዮ ጥቤ ሀለቅቹ «ሮም መንቹ ፍርዱ ዮበኢሃ ኦልቶኖተ ፈቀደሞህዕኔንዶ?» ዬስ።<verse eid="ACT 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26"/>ህከ ወክትንከ ጥቤ ሀለቁ ሞጮጭ በገዝ ሀለቅቤቹ መር «መ አቶታት? ኩ መንቹ ሮማውቹሃ» ዬእ።<verse eid="ACT 22:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27"/>ሁኩ በገዝ ሀለቁንኩ ጳዉሎሴቤቹ መር «ህንዴ ኩሌኤ! አት ሮማውቹሃ መንቹንዶ?» ይ ጠዕሜስ፤ እስን «ኤ! አን ሮማውቹሃ መንቹ» ዬእ።<verse eid="ACT 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28"/>በገዝ ሀለቁንኩ ፈንቀሽ «አን ከ ሮማውቹ እሆተ ህዕሬሚሁ አበ ብሪንት» ዬስ ወክት ጳዉሎስ ህትን «አን እለሞሚሁ ሮማውቹ እክት» ዬስ።<verse eid="ACT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29"/>ህካን እኮቤቺሃ ጳዉሎሴ መረመርቶተ ቅጥይቶሩ ህከ ወክትንከ እሲች አደ እኮኡ፤ በገዝ ሀለቁንኩ ጳዉሎስ ሮም ባድ መንቹ እሁስ ደጎ ወክት ኡሱርሲሾስቤቺሃ ዋጄእ።<verse eid="ACT 22:29"/></para>
  <para style="s1">ጳዉሎስ አይሁድ ኦገት ብርተ ሆንጠኮገ</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30"/>ለንክ በር ገስመ በገዝ ሀለቁንኩ አይሁዱ ጳዉሎሴ ከሰሶ መሰት መርቹሃጎሬ ጠውስ ሀንቅ ደጎተ ሀሾቤቺሃ ቂስ አዎንሳኑትለከ ኦገት መነ ጉዕመንከ ጭምይታገ አዘዦ፤ እስን ጳዉሎሴች ሰንሰለተ ሂር ኡሱሮ ምኒች ኤቤኖገ አዕይ ብሬንከሰ ኡርሾ።<verse eid="ACT 22:30"/></para>
  <chapter eid="ACT 22"/>
  <chapter number="23" style="c" sid="ACT 23"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1"/>ህከኒች ኤተሮን ጳዉሎስ አይሁድ ኦገት ባልቀተ ቱክ ይ ለዕይ «አመኤ ኦሶ! ከበሬ ኢሎተ ኢለ ጡመ ቀልቢን ጉዕሚንን መገን ብሬን ሄዕዮምሃን» ዬእ። <verse eid="ACT 23:1"/><verse number="2" style="v" sid="ACT 23:2"/>ህትን ሎሩ ቂስቹ «ሀናንየ» ዬኖሁ ጳዉሎሴ መዴን ኡርቶእረ ጳዉሎሴ አፎስ ዎቀርታገ አዘዦ። <verse eid="ACT 23:2"/><verse number="3" style="v" sid="ACT 23:3"/>ህከ ወክትንከ ጳዉሎስ ሀናንየ «አት ለኤኖሄረ ጡመ አጉዳንቲሁ ቀልቡክ ሂሉ! ኬሳሃ መገኑ ዎቀረኖሄ፤ ሕጊን ፈረዶተ አፉዕልት ሕጉ ዮበኢሃ ዎቀሮኖኤተ አዘዘንዶ?» ዬስ።<note caller="-" style="x"><char style="xo" closed="false">23፥3 </char><char style="xt" closed="false"><ref loc="MAT 23:27-28">ማቶ. 23፥27-28</ref>።</char></note><verse eid="ACT 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4"/>ህከኔ መዴንከስ ኡርቶእሩ ጳዉሎሴ «መገን ሎረ ቂስቹ ቦሮርተንንዶ?» ይቶስ።<verse eid="ACT 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5"/>ህትን ጳዉሎስ ፈንቀሽ «አመኤ ኦሶ! ሎረ ቂስቹ እሁስ ደጎምበአ እቅ፤ መሰንትስ ‹ኡመትክ ገሸኖሀን አሌን ሂለ ላገተ ጠወኦት› የመም ከተበሞኡ» ዬስ።<verse eid="ACT 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6"/>ጠዉ እኮጎሬ ጳዉሎስ ህከን መኒች መት-መቱሰ ሰዱቃውተ ህትን ዎሉሰ ፈርሳውተ እሁሰ ደግ «አመኤ ኦሶ! አን ፈርሳውቹሃን፤ አኑኤ ፈርሳውቹሃን፤ ቴሱ ፍርድቤቹ ሆንጠኮሚሁ ሬቶእሩ ሬሆች ኬኣገ ተብሳሃ አዕዮምቤቺሃት» ይ ላገስ ጎት አዕይ ኦገት ባልቃተ ጠወዕዮ።<note caller="-" style="x"><char style="xo" closed="false">23፥6 </char><char style="xt" closed="false"><ref loc="ACT 26:5">ሶቀ. 26፥5</ref>፤ <ref loc="EXO 3:5">ፉል. 3፥5</ref>።</char></note><verse eid="ACT 23:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7"/>ጳዉሎስ ህካን ጠወዕዮ ወክት ፈርሳዌለከ ሰዱቃዌ በላን ብተት ኬኣን ኦገቱስ ለሙ ቤቹ እኮ። <verse eid="ACT 23:7"/><verse number="8" style="v" sid="ACT 23:8"/>ሰዱቃውት «ሬዮ መኑ ሬሆች ኬአኖበአ፤ መላይከንት ዮበአ፤ አያኑንኩ ዮበአ» ይታእረ፤ ህትን ፈርሳውት «ሁኩን ጉዕሙንኩ ዮኡ» ይት አመዕንታእረ።<note caller="-" style="x"><char style="xo" closed="false">23፥8 </char><char style="xt" closed="false"><ref loc="MAT 22:23">ማቶ. 22፥23</ref>፤ <ref loc="MRK 2:18">ማር. 2፥18</ref>፤ <ref loc="LUK 20:27">ሉቃ. 20፥27</ref>።</char></note> <verse eid="ACT 23:8"/><verse number="9" style="v" sid="ACT 23:9"/>ህከ ወክት አበ ጨንጨነተ እኮ፤ ፈርሳዌ አዲች መገን ሕግ አስተማራች ኬእ «ነኡ ከን መንቾን ሂለ ጠወ መቱርቹሃ ደንጎምበአ፤ አያኑ ህከረንገ መላይከት ጠወኦሲሃ እሀኖ?» ይት ኦዶኡ።<verse eid="ACT 23:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10"/>ብተት በተአን መርቶ ወክት መኑ ጳዉሎሴ ሀንፈጣስበእገ በገዝ ሀለቁ ዋጅ ወታደረ «መርቴን ጳዉሎሴ መን በሊች ዎልቅሴን ዎታደሩ ገለኖቤቹ ኤቤ» ይ አዘዦ።<verse eid="ACT 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11"/>ለንክስ በር ሀንከዕርተ ቀርቹ ጳዉሎሴ መዴን ኡር «ዬሩሳሌም ከተማን ኢተኔሃ መሰከርቶንትገን ሮም ከተማኒ መሰከሩ ሀስሰኖቤቺሃ ዋጅቶት» ዬስ።<verse eid="ACT 23:11"/></para>
  <para style="s1">ጳዉሎሴ ሺቶተ አማዕለሙሰ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12"/>ለንክ በሬ ገስመ አይሁዱ ጭምይት አማዕለንትኬእ «ጳዉሎሴ ሽኖተ ኢለ እቸተ እንቱንከ፤ ዋሃ አንጉንከ» ይት ጤሌዕልቶኡ። <verse eid="ACT 23:12"/><verse number="13" style="v" sid="ACT 23:13"/>ህከን አድማን አማዕለንቶእሩ ሸይልች በተአኖሃ መነ እቅ። <verse eid="ACT 23:13"/><verse number="14" style="v" sid="ACT 23:14"/>ህትን እሰ ቂስ አዎንሳኖበለከ ባልቀቤቹ መርትኬእ « ‹ጳዉሎሴ ሽኑዕናን መቱርቹሃ እንታምበአ› ይን ጤሌዕልኖም። <verse eid="ACT 23:14"/><verse number="15" style="v" sid="ACT 23:15"/>ህከኒሃ ቴሱ አዕኑ ኦገት ባልቃን ሜጡበ አማዕለንቴን መረመርናም ጠዉ ዮኡ ይቴን ጳዉሎሴ ኦል ሀለቁ ክዕኔቤቹ ኤቦተ ጠዕምዬ፤ እኮጎሬ ነኡ ክዕኔቤቹ ኢሉዕነ ሄጭን ሽኖተ ቅጥይኖም» ይት ኩልቶሰ።<verse eid="ACT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16"/>ጠዉ እኮጎሬ ጳዉሎሴ አመቤቶ ቤቱ ህከ አማዕለንቶ ጠወ ሞጮጬ ወክት ዎታደሩ ገልታቤቹ መርኬዕይ ጳዉሎሴሃ ኩሎስ። <verse eid="ACT 23:16"/><verse number="17" style="v" sid="ACT 23:17"/>ህትን ጳዉሎስ ጥቤ ሀለቀ መቱ ገእ «ኩ ጩሉ በገዝ ሀለቂሃ ጠወአኖ ጠዉ ዮስቤቺሃ እስቤቹ መስ» ዬስ። <verse eid="ACT 23:17"/><verse number="18" style="v" sid="ACT 23:18"/>ጥቤ ሀለቅቹንኩ ጩልስ በገዝ ሀለቅቤቹ አፍ መር «ኩ ጩሉ ኩለኖ ጠዉ ዮስቤቺሃ ኡሱር ምኔን ዮ ጳዉሎሴ ኤሳሃ ገእ ከ ጩል ኪቤቹ ኤቦተ ኡጭዮኤ» ዬእ።<verse eid="ACT 23:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19"/>በገዝ ሀለቁንኩ ጩል አንገተ አፍ መድ ዋል «ኩልታንቴኤ ጠዉ መርቹሃን?» ይ ገበለ ዋሽ ጠዕሜስ።<verse eid="ACT 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20"/>ሁኩ ጩሉንኩ «አይሁድ አዎንሳኑት ጳዉሎሴ ዎዕኔችን ባሳ ጠረኝስ መረመርቶተ ጋቴተ ኦገትቤቹ ሆንጠህሶተ ኬሳሃ ጠዕምቶተ ኢተቀንቶኡ። <verse eid="ACT 23:20"/><verse number="21" style="v" sid="ACT 23:21"/>ጠዉ እኮጎሬ አት እሳሃ ኤኩ ይቶት፤ መሰንትስ እሰ ጳዉሎሴ ሽቶተ ኢለ እቸተ እታበእገለከ ዋሃ አጋበእገ ጤሌዕልት ሸይልች በተአ መኑ ማጠንት አገርታኢት፤ ቴሱ እሰ አገርታኢሁ ጠለዕል ኪ መስለህት» ዬእ። <verse eid="ACT 23:21"/><verse number="22" style="v" sid="ACT 23:22"/>በገዝ ሀለቁንኩ ህከ ጩል «ከ ጠወ ኤሳሃ ኩሉክ አዬሃ ጠወኦት» ይ ጩል ህርሲሾ።<verse eid="ACT 23:22"/></para>
  <para style="s1">«ፊልክሴ» ዬኖ ባዱ ገሸኖ መንች ብርተ ጳዉሎሴ ሆንጠህሴመገ</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23"/>ህከኒች ኤተሮን ኦል ሀለቁንኩ ጥቤ ሀለቃች ለሙ ገእ «ሀንከዕሬ ሰሶ ሳቴን ቂሳር ከተመ መርታ ለሜ ጥቤ ዎታደረ፥ ለመላዩ ፋሻንቹለከ ለሜ ጥቤ በገዝ መነ ቅጥአዕዬ። <verse eid="ACT 23:23"/><verse number="24" style="v" sid="ACT 23:24"/>ህትን ጳዉሎስ ቆጰኖ ገማሙ ቅጥ አቴን ባዱ ገሸኖ ፍልክሴበ ወገሬቲን ኢልሳስገ አዕዬ» ይ አዘዦ። <verse eid="ACT 23:24"/><verse number="25-26" style="v" sid="ACT 23:25-26"/>ህትን እስን «ቀላዶስ ሉስዩሲች፤ አበ ከበጀንቶንት ባዱ ገሽታንት ፊልክሴ! ወገሬቱ ኬሳሃ እሁን! <verse eid="ACT 23:25-26"/><verse number="27" style="v" sid="ACT 23:27"/>ከ መንቹ አይሁዱ አፍ ሽቶተ እከንን እስ ሮማውቹ እሁስ ደጎምቤቺሃ ዎታደርንከኤ መር ኢል ጡምሾንስ። <verse eid="ACT 23:27"/><verse number="28" style="v" sid="ACT 23:28"/>ህትን እሰን እሱ መ መሳን ከሰሳስጎሬ ደጎተ ኦገትሰቤቹ ሆንጠህሾም እቅ። <verse eid="ACT 23:28"/><verse number="29" style="v" sid="ACT 23:29"/>እሰን እሱ ከሰሶኢሁ ገይሰ ሕግተኔሃ እሁስ ደጎም፤ ጠዉ እኮጎሬ ሬሆተ ህከረንገ ኡሱረሚሃ ኢልሰኖ ጠዉ መቱርቹሁ ዮበአ። <verse eid="ACT 23:29"/><verse number="30" style="v" sid="ACT 23:30"/>አይሁዱ ከ መንቹ ሽቶተ አድመተ አት አማዕለንቶገ ህከ ወክትንከ ሞጮጭ ኪቤቹ ሶኮም፤ ኦደን ሄኦ መኑንኩ ኪ ብሬን ኦዳገ አዘዦም» ይ ሶኮ።<verse eid="ACT 23:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31"/>ህካን እኮቤቺሃ ዎታደሩ አዘዘንቶ ሃሌን ጳዉሎሴ አፍ ሀንከዕሬን መስት «አንቲጳጥርስ» ዬኖ ከተመ ኢልሶኡ። <verse eid="ACT 23:31"/><verse number="32" style="v" sid="ACT 23:32"/>ለንክ በሬ ገስማ ጳዉሎሴ ፋርሱተ ቆጶ መኒን ሜጡበ መረኖገ አት ወታደሩ አጉርት ገልታቤቹ ፈንቀልቶኡ። <verse eid="ACT 23:32"/><verse number="33" style="v" sid="ACT 23:33"/>ሁኩ ፋርሱተ ቆጶ መኑንኩ ቂሳር ከተመ ኢልሶ ወክት ደብዳቤተ ባዱ ገሸኖሀኒሃ ኣት ጳዉሎሴ ብሬንከስ ኡርሶኡ። <verse eid="ACT 23:33"/><verse number="34" style="v" sid="ACT 23:34"/>ባዱ ገሸኖንኩ ደብዳቤተ አነበቦች ኤተሮን ጳውሎሴ «አት ሀከን ባድየ?» ይ ጠዕሜስ፤ ኪልቅይ ባድ መንቹ እሁስ ደጎ ወክት <verse eid="ACT 23:34"/><verse number="35" style="v" sid="ACT 23:35"/>«ከሰሳሄሩ አሜቶ ወክት ጠወክ ሞጮጫም» ዬስ፤ ህትን ሄሮድስ ግንብሲሾ ዎም ግቤ ኣዜን አገርታስገ አዕዮ።<verse eid="ACT 23:35"/></para>
  <chapter eid="ACT 23"/>
  <chapter number="24" style="c" sid="ACT 24"/>
  <para style="s1">አይሁዱ ጳዉሎሴ ፍልክሴ ብሬን ኦዶገ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1"/>ኦንቶ በሬች ኤተሮን ሎሩ ቂስቹ ሀናንይ መት-መቶ ባልቃንለከ «ጠርጠሉሴ» ዬኖ ጠበቂን ሜጡበ ቄሳር ከተመ ኦሮዕዮ፤ እሰ ጳዉሎሴ ጠወ ባዱ ገሸኖ ፊልክሴ ብርተ ሆንጠህስ ከሰሶኡ። <verse eid="ACT 24:1"/><verse number="2-3" style="v" sid="ACT 24:2-3"/>ህትን ጳዉሎሴ ገኤን ኤቤመ ወክት ጠበቅቹ ጠርጠሉስ «ከበጀንቶንት ፊልክሴ! ኪ መሳን ልግብ ወገሬት ደእኖም፤ ጡመገ ገሽንተክ ገይሃኔ ሃዕሮ ጡመርቹ ደእኖም፤ ጡመ ሆጉክ ጉዕመ ወክት ቶንጋሚሁ አበ ገለትኒት። <verse eid="ACT 24:2-3"/><verse number="4" style="v" sid="ACT 24:4"/>ጠዉ እኮጎሬ ወክትክ ቤሱዕናን ገበንቾን ኩላንኬ ጠወ መረርሲጭት ሞጮጭቶተ ኡጫንኬ። <verse eid="ACT 24:4"/><verse number="5" style="v" sid="ACT 24:5"/>ኩ መንቹ ኔሳሃ ሂለ ጥዘነተ እክ ዱንየ አሌን ጉዕማንን ዮ አይሁድ በላን ብተተ ኬሰን ‹ናዝራውያኑተ› ዬኖ ክዝብ ትምርት አዎንሳኖች መቱስ እሁስ ደንጎም። <verse eid="ACT 24:5"/><verse number="6" style="v" sid="ACT 24:6"/>እስን ዱእ ምኒ ንጃሲሶተ ሰውየን ደንግ አንፍ [ሕግኔ ሃሊን ፈረንዶተ ሀንሶም እቅ። <verse eid="ACT 24:6"/><verse number="7" style="v" sid="ACT 24:7"/>ጠዉ እኮጎሬ በገዝ ሀለቁ ሉስዮስ አሜች አንጋችኔ ዎልቅሽ መሴእ። <verse eid="ACT 24:7"/><verse number="8" style="v" sid="ACT 24:8"/>ከሰሳሩ ኪቤቹ አሜቶተ አዘዦ] ኩ ነኡ ከሰንሶም ክሱ መርቹሃጎሬ አት ገዉክ እሱ መረመርት ደጎተ አታልታንት» ዬእ።<verse eid="ACT 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 24:9"/>አይሁዱ «ኩ ጠዉ ጉዕሙንኩ ሀንቅሃን» ይት ክሳንከስ ኢተቀንቶኡ።<verse eid="ACT 24:9"/></para>
  <para style="s1">ጳዉሎስ ፊልክሴ ብሬን ኦጆገ</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10"/>ገሻንቹ ፊልክስ አንገስ ቀቀሽ ጳዉሎስ ጠወአኖ ወክት ኣሴሃንስ ጳዉሎስ «ልግቤ ዘማኒች ኬሽ ከን ኡመት አሌን ፍርድ ዳኘ እሁክ ደጎምቤቺሃ ኤሳሃ ከሰሶኤ ክሲሃ መከላከየ ኪቤቹ ሆንጠህሳም ወክት አበት ሙንዲኑት ሞጮጨንታኤ። <verse eid="ACT 24:10"/><verse number="11" style="v" sid="ACT 24:11"/>አን ዬሩሰሌመ ሰገዶተ መሮሚች ቶነ ለሞ በሬች በተአኖበእገ አት ገዉንኩክ አጥራመቶተ አታልታንት። <verse eid="ACT 24:11"/><verse number="12" style="v" sid="ACT 24:12"/>እሰን ኤሳሃ መገን ምኔን ኦደንለከ ጭምት ምኔን ህከረንገ ከተማን ኡመት ጭምአዕይ ብተተ ኬሰን አፎኤበአ። <verse eid="ACT 24:12"/><verse number="13" style="v" sid="ACT 24:13"/>እኮጎሬ እሰ ኤሳሃ ኦደ ጠዊሃ ማስረጀ ሆንጠህሶሄተ አታልታበአ። <verse eid="ACT 24:13"/><verse number="14" style="v" sid="ACT 24:14"/>ጠዉ እኮጎሬ አን ካን ኩላንኬ፤ እሰ ክዝብየ ይታ አመዕነት ዎቃሃ አናኖኔ መገኒሃ ሰገዳም፤ ህትን ሕጋንለከ ነብያኖ መጻፋን ከተበሞሃ ጉዕመንከ አመዕናም። <verse eid="ACT 24:14"/><verse number="15" style="v" sid="ACT 24:15"/>እሰ ፈያኑትለከ ጩበኛኑት ሬሆች ኬኣአ ይት ተብሳሃ አታገን ኤሳሃ መገኖን ተብሶሁ ዮኤ። <verse eid="ACT 24:15"/><verse number="16" style="v" sid="ACT 24:16"/>ህካን እኮቤቺሃ አን መገንለከ መን ብሬን ነጡ ሰውቱ ሄኦኤተ ጉዕመ ወክት አጰማም። <verse eid="ACT 24:16"/><verse number="17" style="v" sid="ACT 24:17"/>ዬሩሳሌም ከተሚች ፉሎምች ልግብ ዘማን እኮች ኤተሮን ኢ ባድ መኒሃ ሀዕላም ብረለከ መገኒሃ ኣሰም ብረ አፍ ፈንቀል አሜቾም። <verse eid="ACT 24:17"/><verse number="18" style="v" sid="ACT 24:18"/>አን መገን ምኔን ነጠ እሄኖ ሴረ ሹሎሚሃ ለኦኤ ወክት ህከን ቤቾን ኢን ጭምዬ ኡመቱለከ ብተት ዮበአ እቅ።<note caller="-" style="x"><char style="xo" closed="false">24፥18 </char><char style="xt" closed="false"><ref loc="ACT 21:17-28">ሶቀ. 21፥17-28</ref>።</char></note> <verse eid="ACT 24:18"/><verse number="19" style="v" sid="ACT 24:19"/>ጠዉ እኮጎሬ እስየ ዬኖ ባዲች አሜቶ አይሁዱ ህከን ቤቾን ሄኦኡ፤ እሰ ኤሳሃ ከሰሳ ጠዉ ዮሰጎሬ ኪ ብርተ ሆንጠክ ጠወኡ አታልታአ። <verse eid="ACT 24:19"/><verse number="20" style="v" sid="ACT 24:20"/>ህከረንጋ ኦገት ብርተ ሆንጠኮም ወክት አዕዮንሰ ጠዉ ዮ ጎሬ ህንዴ ኩ መኑ ኩልቱን። <verse eid="ACT 24:20"/><verse number="21" style="v" sid="ACT 24:21"/>ሀንቅንከ በላንከሰ ኡር ሎረ ላጋን ‹ሬቶእሩ ሬሆች ኬኣአ ይ ጠወዕዮምሀኒሃ ከበር ብርክዕኔ ሆንጠኮም› ይ ጠወዕዮምቤሉ ዎሉ አዕዮም ጠዉ መቱርቹሁ ዮበአ።»<note caller="-" style="x"><char style="xo" closed="false">24፥21 </char><char style="xt" closed="false"><ref loc="ACT 23:6">ሶቀ. 23፥6</ref>።</char></note><verse eid="ACT 24:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22"/>ጠዉ እኮጎሬ ፍልክስ አመዕነት ዎቀሃ ደገኖቤቺሃ «በገዝ ሀለቁ ሉስዮስ አሜቾ ወክት አን ጠወክዕኔ ሹላም» ይ ዝኝተ ህግሾ። <verse eid="ACT 24:22"/><verse number="23" style="v" sid="ACT 24:23"/>እስ ጰዉሎሴ አገረኖ ጥቤ ሀለቀ «አበ ጨነቁዕነ አሙዘን ጡመገ አገርስ፤ ጃለስ ሀስሰኖስርቹ ኤባስ ወክት ከንቶትስ» ዬእ።<verse eid="ACT 24:23"/></para>
  <para style="s1">ጳዉሎስ ፊልክሴለከ ድሩሲላ ብርተ ሆንጠሁስ</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24"/>ቀወ በሬች ኤተሮን ፊልክስ «ዱሩሲላ» ዬኖ አይሁድቾ መንቾንተስን ሜጡበ እክ አሜቾ፤ እስ ጰዉሎሴ ገእሲሽ መሲህ ኢሳን አመዕንተኔሃ ጠወአንን ሞጮጬእ። <verse eid="ACT 24:24"/><verse number="25" style="v" sid="ACT 24:25"/>ህትን ጳዉሎስ ፈይመተኔሃ፥ ገዉ አገዕርተኔሃለከ አሜተኖ ፍርድተኔሃ ኩለኖ ወክት ፍልክስ ዋጅ «ቴሶተስ እሀኖኤ፤ ቴሱ መር! ሀሾም ወክት ገእሲሳንኬ» ዬእ። <verse eid="ACT 24:25"/><verse number="26" style="v" sid="ACT 24:26"/>ህከ ወክት ፍልክስ ጰዉሎሴች ጉቡተ ኣኦተ ተብሳሃ አአኖት እቅ፤ ህካን እኮቤቺሃ ልግብ ወክት ጰዉሎሴ እስቤቹ ገእሲሰን ጠዉሲሰኖስ እቅ። <verse eid="ACT 24:26"/><verse number="27" style="v" sid="ACT 24:27"/>እኮጎሬ ለሞ ዘማኒች ኤተሮን ጶርቅዮስ ፊስጦስ ፍልክሴ ቤቾን ገሸኖሃ እኮ፤ ፍልክስ አይሁደ ሙንዲሲሶተ ሀሾቤቺሃ ጰዉሎሴ ኡሱር ምኔን አጉሮስ።<verse eid="ACT 24:27"/></para>
  <chapter eid="ACT 24"/>
  <chapter number="25" style="c" sid="ACT 25"/>
  <para style="s1">ጳዉሎስ «ሮም ባድ ዎመቤቾን ይግባኘ» ዩስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1"/>ፊስጦስ ገይስ አዉራጃ አሜች ሰሶ በሬች ኤተሮን ቂሳርይ ከተሚች ዬሩሳሌመ ኦሮዕዮ። <verse eid="ACT 25:1"/><verse number="2" style="v" sid="ACT 25:2"/>ህከን ቤቾን ፊስጦሴ ብሬን ቂስ ሀለቀትለከ አይሁድ ምኒ ሎርሎሩ አዎንሳኑት ጳዉሎሴ ከሰሳ ጠወ ሆንጠህሶኡ። <verse eid="ACT 25:2"/><verse number="3" style="v" sid="ACT 25:3"/>እሰን ፍስጦስ ጳዉሎሴ ዬሩሳሌመ ፈንቀሾተ ኡጭቶኡ፤ ህካን ይቶ መሰት ዎቃን አገርት ሽቶተ ሀሶቤቺሃት። <verse eid="ACT 25:3"/><verse number="4" style="v" sid="ACT 25:4"/>ፍስጦስን «ጳዉሎስ ቂሳርየ ኡሱር ምኔን ዮኡ፤ አን ገዉእ ህከ ቤቹ ፈንቀል ደዕል መራም። <verse eid="ACT 25:4"/><verse number="5" style="v" sid="ACT 25:5"/>ሹመክዕኔ ኢን ሜጡበ ቂሳረየ መርቱን፤ ጳዉሎስ አዕዮ ሂሉርቹ ዮስጎሬ ህከን ቤቾን ከሰሱን» ዬሰ።<verse eid="ACT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6"/>ፊስጦስ ህዜቱ ህከረንገ ቶኑ በሩ ኢሎተ ኢለ እሰቤቾን አገሮች ኤተሮን ቂሳርየ ባዱ ኦሮዕዮ፤ ህከ ቤቹ ኢሌ ለንክ በር ፍርድ ቦርጭማን አፉዕል ጳዉሎሴ ሆንጠህሳገ አዘዦ። <verse eid="ACT 25:6"/><verse number="7" style="v" sid="ACT 25:7"/>ህትን ጳዉሎሴ ሮም ባድ ዎመ ሀለቅቤቹ ሆንጠህሴመ ወክት ዬሩሳሌሚች አሜቶ አይሁዱ ረብ ኡርት ምስክር ደጎተ አታልትበ ልግብ ጠረኘ ክሰ ሆንጠህሶኡ። <verse eid="ACT 25:7"/><verse number="8" style="v" sid="ACT 25:8"/>ጳዉሎስን «አን አይሁድ ሕጋን፥ መገን ምኔንለከ ሮም ዎመ አሌን አዕዮም ሂሉ ጠዉ መቱርቹሁ ዮኤበአ» ይ ጠዕሜእ።<verse eid="ACT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9"/>እኮጎሬ ፊስጦስ አይሁድ መነ ሙንዲሲሶተ ሀሽ ጳዉሎሴ «ዬሩሳሌመ መርት ከ ጠወ ኢ ብሬን ፍርደ አእቶተ ሀሰንንዶ?» ይ ጠዕሜስ። <verse eid="ACT 25:9"/><verse number="10" style="v" sid="ACT 25:10"/>ጳዉሎስ «አን ፍርደ አኦተ ሀስሰኖኤሃ ሮም ዎመ ሀለቅ አሌን ፍርድ ቦርጭመ ብሬን ኡርዮም፤ እኮጎሬ አት ገዉክ ጡመገ ደጋንትገን አይሁዲሃ አዕዮም ሂሉርቹ መቱርቹሁ ዮበአ። <verse eid="ACT 25:10"/><verse number="11" style="v" sid="ACT 25:11"/>ህትን አን ቤሾም ጠዉ ዮ ጎሬ ህከረንገ ሬሆተ ኢልሰኖኤ ብድል አዕዮምጎሬ ሬሆች ጡሞ ያምበአ፤ ጠዉ እኮጎሬ እሰ ከሰሳኤ ጠዉ ክዝብ እኮጎሬ አዪሁ ኤሳሃ ህግሽ ኣሶኤተ አታለኖበአ፤ ሮም ባድ ዎም አሌን ይግባኘ ይዮም» ዬእ።<verse eid="ACT 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12"/>ህከ ወክት ፊስጦስ እስ አማሌ መኒን አማዕለም «አት ሮም ባድ ዎም አሌን ይግባኘ ይቶንት ጎሬ ህከ ሮም ዎምቤቹንከ መርታንት» ዬስ።<verse eid="ACT 25:12"/></para>
  <para style="s1">ጳዉሎስ አግሪጵለከ በርኒቄ ብርተ ሆንጠኮገ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13"/>ቀዎ በሬች ኤተሮን ዎሙ አግርጵለከ በርኒቄ ፍስጦሴ «ሀበይ ወገሬቲን አሜት» ይቶተ ቂሳርየ መርቶኡ። <verse eid="ACT 25:13"/><verse number="14" style="v" sid="ACT 25:14"/>እሰን ህከን ቤቾን ልግብ በር አፉዕልቶቤቺሃ ፍስጦስ ጳዉሎሴ ጠወ ዎመ አግርጲሃ ኩለን «ፍልክስ ኡሱርሲሾ መቱ መንቹ ኡሱር ምኔን ዮኡ። <verse eid="ACT 25:14"/><verse number="15" style="v" sid="ACT 25:15"/>ህትን አን ዬሩሳሌመ ሄዕዮም ወክት ቂስ ሀለቀትለከ አይሁድ ባልቁ እስተኔሃ ኩልቶች ኤተሮን አሌንከስ ፈረዶተ ጠዕምቶኤ። <verse eid="ACT 25:15"/><verse number="16" style="v" sid="ACT 25:16"/>ጠዉ እኮጎሬ አን ‹ከሰሳም መንቹ ከሰሾ መን ብሬን ኡር ከሰሰሞ ጠዊሃ መከላከይ መስሉ ኣሰሙዕነ ከሰሰሞ መንቹ ህግሴን ኣሱ ሮም ባድ መኒሃ ሴረበአ› ይ ፈንቀሼም። <verse eid="ACT 25:16"/><verse number="17" style="v" sid="ACT 25:17"/>ህካን እኮቤቺሃ ከሰሶ መኑ ጭምይት ከቤቹ አሜቶ ወክት አን አገሩዕነ ለንክ በር ፍርድ ቦርጭመ አሌን ፈረዶተ አፉዕል ጳዉሎሴ ሆንጠህሳገ አዘዦም። <verse eid="ACT 25:17"/><verse number="18" style="v" sid="ACT 25:18"/>ሁኩ ከሰሶእሩ መዴስ ኡርቶ ወክት አን ኩ መንቹ ቤሾ ይ ሰውዬም ጌሰ እሱ ክሲሃ ኢልሰኖ ጠወ መቱርቹሃ ሆንጠህሶበአ። <verse eid="ACT 25:18"/><verse number="19" style="v" sid="ACT 25:19"/>ጠዉ እኮጎሬ እሰ እሲን ኦደን ሄኦ ጠዉ ገይሰ አመዕነትሰተኔሃለከ እኮጎሬ ሬዮ እቅ ጳዉሎስ ‹ፎልን ዮኡ› ዬ ኢስተኔሃት። <verse eid="ACT 25:19"/><verse number="20" style="v" sid="ACT 25:20"/>ህትናሙ ጠወ አጥራመች ደጉ ኤሳሃ ኦርሾኤቤቺሃ ጳዉሎሴ ‹ዬሩሳሌመ መርት ህከን ቤቾን ፍርደክ ለኦኖተ ሀሰንንዶ?› ይ ጠዕሜስ። <verse eid="ACT 25:20"/><verse number="21" style="v" sid="ACT 25:21"/>እኮጎሬ ጳዉሎስ ኦደን ሄዕዮ ጠወ ሮም ባድ ዎማን ለአሞተ ሀሽ ሮም ባድ ዎሚሃ ይግባኘ ዮንከስ ህካጰ ሶሆስተ ኢለ ኡሱር ምኔን አገረኖገ አዘዦም» ዬእ።<verse eid="ACT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22"/>ህትን አግርጵ «አን ገዉእ ኩ መንቹ ኩለን ሞጮጮተ ሀሳም» ዬ ወክት ፍስጦስ «ጋተ ሞጮጭታንት» ዬእ።<verse eid="ACT 25:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23"/>ለንክ በር ገስመ አግርጵለከ ቤርኒቅ ኬዕምኝ ኦድኑተ ኦደእ በገዝ ሀለቃኖንለከ ከተም ሎርሎረ መኒን ሜጡበ እክ ፍርድ ምኒ ኣጎኡ፤ ህከኒች ኤተሮን ፍስጦስ ጳዉሎሴ ገእሲሽ አሜተኖገ አዕዮ። <verse eid="ACT 25:23"/><verse number="24" style="v" sid="ACT 25:24"/>ፍስጦስን «ዎመ አግርጰ! አዕኑ ኒን ከንቤቾን ሜጡበ ዮንተ መኑ ጉዕሙንኩ! አይሁዱ ‹ኩ መንቹ ከኒች ኤተሮን ፎሊን ሄኡ ሀስሰኖስበአ› ይተን አሌስ ፈረዶተ ዬሩሳሌማንለከ ከኔ ቂሳርያን ኤሳሃ ጠዕምቶ መንቹ ከኒት። <verse eid="ACT 25:24"/><verse number="25" style="v" sid="ACT 25:25"/>አን ጳዉሎሴ አሌን ሬሆተ ኢልሰኖ ጠወ ደጎምበአ፤ እኮጎሬ እስ ገዉስ ‹ሮም ዎመ አለቂሃ ይግባኘ› ዬቤቺሃ ሶሆተ ወሰኞም። <verse eid="ACT 25:25"/><verse number="26" style="v" sid="ACT 25:26"/>እሁን ቤሉ እስተኔሃ ዎሚሃኤ ከተባም አጥራመቾም ጠዉ ዮበአ፤ ህካን እኮቤቺሃ መረመረሞች ኤተሮን ከተባም ጠወ ደኤም ጎሬ ይ ብሬንከክዕኔ በትሽን ዎመ አግርጰ! ብርክ ሆንጠህሾም። <verse eid="ACT 25:26"/><verse number="27" style="v" sid="ACT 25:27"/>መሰንትስ ኡሱረሞ መንቹ ዎመ ሀለቅቤቹ ሶሄኖ ወክት መንቹስ ኦደሞ ጠወ ከተቤን ኤንኬዕንሱ ሆጉሰ ገውመተ አጉጅ ለልዮኤ» ዬእ።<verse eid="ACT 25:27"/></para>
  <chapter eid="ACT 25"/>
  <chapter number="26" style="c" sid="ACT 26"/>
  <para style="s1">ጳዉሎስ ዎመ አግርጵ ብሬን ጠወዕዮገ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1"/>ዎሙ አግርጵ ጳዉሎሴ «ገይክ ጠወ ጠወኦተ ወክቱ ኣሰሞሄ» ዬስ፤ ህካን እኮቤቺሃ ጳዉሎስ አንገስ ሂር <verse eid="ACT 26:1"/><verse number="2" style="v" sid="ACT 26:2"/>«ዎመ አግርጳ! አይሁዱ ከሰሶኤ ጠዊ ጉዕሚንከ ከበር ኪ ብሬን መስለ ኣሳም ወክት አበ ተሽ የኖኤ። <verse eid="ACT 26:2"/><verse number="3" style="v" sid="ACT 26:3"/>መሰንትስ አት አደደ አይሁድ ወገለከ ኦደሰ ጉዕመንከ አጥራመት ደጋንት፤ ህካን እኮቤቺሃ ኢ ጠወ አደቢን ሞጮጭታንቴኤገ ኡጫንኬ።<verse eid="ACT 26:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4"/>«ኦስማችኤ ኬሽ ሀት እክ ሄዕዮምጎሬ አይሁዱ ጉዕሙንኩ ደጋአ፤ ወዕኔች ኬሽ ገይኤ ኡመት በላንለከ ዬሩሳሌማን ሀት እክ ሄዕዮምጎሬ ሄኡኤ ደጋአ። <verse eid="ACT 26:4"/><verse number="5" style="v" sid="ACT 26:5"/>ህትን እሰ ኢ ጠወ ኩልቶተ ሀሶ ጎሬ አመዕነትንከኔ ዎገ አገሪን አበ ጠረኘ እኮ ፈርሳዌ አዲሃ እሁኤ ወዕኔችን ኬስ ደጋኣ።<note caller="-" style="x"><char style="xo" closed="false">26፥5 </char><char style="xt" closed="false"><ref loc="ACT 23:6">ሶቀ. 23፥6</ref>፤ <ref loc="PHP 3:5">ፍልጵ. 3፥5</ref>።</char></note> <verse eid="ACT 26:5"/><verse number="6" style="v" sid="ACT 26:6"/>አን ቴሁ ከኔ አሌንከኤ ፈረደሞኤተ ኡራሚሁ መገኑ ኒ አበናኖተ ኣሴ ላገ ተብሴሃት። <verse eid="ACT 26:6"/><verse number="7" style="v" sid="ACT 26:7"/>ህከ ተብሳሃ ደኢሃ እስራኤል ቶነ ለሙንኩ ደቡኔ ሀንከዕርተለከ በራሃ መገኒሃ ጠረኝት ሰገዳኢት እቅ፤ ዎመ አግርጰ! አይሁዱ ኤሳሃ ከሰሳኤሁ ከን መሳኒት። <verse eid="ACT 26:7"/><verse number="8" style="v" sid="ACT 26:8"/>መገኑ ሬዮ መነ ሬሆች ኬሰኖ እሁስ ክዕኔሃ ሀት አመዕነቱ ሆፈዕዮህዕኔ?<verse eid="ACT 26:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9"/>«አን ገዉእ ናዝሬት ኢስ ሱዕመ አታሎም ጌሲን ቶጉ ግቡ ጡመሃን ይ ሰውያም እቅ።<note caller="-" style="x"><char style="xo" closed="false">26፥9 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ሶቀ. 8፥3</ref>፤ <ref loc="ACT 22:4-5">22፥4-5</ref>።</char></note> <verse eid="ACT 26:9"/><verse number="10" style="v" sid="ACT 26:10"/>አን ዬሩሳሌማን አዕዮሚሁ ከኒት፤ እስን ቂስ ሀለቃች ቶጎም ዳኞማን አመዕንቶ ወገሬት መነ ኡሱር ምኒ ኣግሾም፤ ህትን እሰንተ ሽተን ሽታሀኑኡን ሜጡበ አማዕለሞም። <verse eid="ACT 26:10"/><verse number="11" style="v" sid="ACT 26:11"/>አን ልግብ ወክት ጉዕመንከ ጭምት ምኒ መረን ኦሌኖሰገለከ ቀርች ሱዕመ ቦሮርታገ አዕዮም፤ ህትን እሰ አሌን ኡሙዕር ዎሎ ባድ ከተመ ኢሎተ ኢለ መረን ሸራንሳት እቅ።»<verse eid="ACT 26:11"/></para>
  <para style="s1">ጳዉሎስ መገን አደ ፈንቀሉስ ጠወዕዮገ</para>
  <para style="r">(<ref loc="ACT 9:1-19">ሶቀ. 9፥1-19</ref>፤ <ref loc="ACT 22:6-16">22፥6-16</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12"/>ህካን እኮቤቺሃ «አን ቂሰ ሀለቃች ዊመ ሹምነቱለከ ትዛዝ ቶግ ደማስቆ ከተመ ኦሮዕዮም። <verse eid="ACT 26:12"/><verse number="13" style="v" sid="ACT 26:13"/>ዎመ! አን ዎቃን ሃመን ዙር ሰኣት እኮ ወክቴን አር ኑሪች በተአኖ ኑር ለዕዮም፤ ሁኩ ኑሩንኩ ኢለ ኢን ሜጡበ ሃመን ሄዕዮ መን መዴን ሰሜች በለቆ። <verse eid="ACT 26:13"/><verse number="14" style="v" sid="ACT 26:14"/>ነኡ ጉዕሙንኩኔ ኡለ አሌን ኡንብ እብራዌ መን አፎን ‹ሳኦሌ! ሳኦሌ! ሚሃ ሸርታንቴኤት? ቦረተ አቡሬኖ ሱጠ ብረቲን<note caller="+" style="f"><char style="fqa" closed="false">ሱጠ ብረቲን፦ </char><char style="ft" closed="false">ኒ ሴሪን ቦረተ ጮርቄን ገረፌነን አቡሬኖሀንገን እስራኤል መኑ ቦረተ አቡርታኢሁ ሱጠ ብረቲን ቀሰኒት።</char></note> ቀሴነን ጌጥ ይት ሃንትበጎር ምርተኣንት› ይታ ላገተ ሞጮጬም። <verse eid="ACT 26:14"/><verse number="15" style="v" sid="ACT 26:15"/>አኒን ‹ቀርቾ! አት አዬት?› ዬም፤ ህትን ቀርቹንኩ ‹አን አት ሸርታንቴኤ ኢሳት። <verse eid="ACT 26:15"/><verse number="16" style="v" sid="ACT 26:16"/>እኮጎሬ ቴሱ ኬእ ሎካንከክ ኡር፤ አን ኬሳሃ ለሌንኬሁ ካዲንቹ እኮተ ህትን ለኦንት ጠዊሃለከ ብርተ ዋሽት ለኣንት ጠዊሃ ምስክር እኮተ ሾሞሄታት። <verse eid="ACT 26:16"/><verse number="17" style="v" sid="ACT 26:17"/>አን አይሁድ ኡመት አንጋችለከ ህትን አን ሶሃንኬ አይሁደ እክበ መን አንጋች ጡምሳንኬ። <verse eid="ACT 26:17"/><verse number="18" style="v" sid="ACT 26:18"/>እልሰ ፈንቶተለከ ቱንስቺች ኑርቤቹ ፉሽቶሰተ ሽይጣን ዎልቃች መገን አደ ፈንቀሽቶሰተ አኣንኬ፤ እሰን ጩቡሰ ፈቁን የመመኖሰ፤ ህትን ኢን አመዕንት ኢረ እኮ መን በሊች እሰ ርስት ቤቀንታአ› ዬእ።<verse eid="ACT 26:18"/></para>
  <para style="s1">ጳዉሎስ ሆጎስተኔሃ ጠወኡስ</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19"/>«ህካን እኮቤቺሃ ዎመ አግርጰ! ሰሜች ኣሰንቶኤ መናመተ ቶጉ ግቦምበአ። <verse eid="ACT 26:19"/><verse number="20" style="v" sid="ACT 26:20"/>ጠዉ እኮጎሬ አን ሄጭ ደማስቆ ከተማን ሄዕዮ መኒሃ፥ ህከኒች ኤተሮን ዬሩሳሌም ከተማንለከ ይሁድ ባዶን ሄኣእሩ ጉዕሙንኩ ህትን አይሁደ እህቡ መኑ ጩብሰ ቶበት መገን አደ ፈንቀልታገ ተማርሴንሰ፤ ህትን ጩብሰ ቶበት ፈንቀሉሰ ለሊሳ ሆጉተ አታገ ተማርሴንሰ።<note caller="-" style="x"><char style="xo" closed="false">26፥20 </char><char style="xt" closed="false"><ref loc="ACT 9:20">ሶቀ. 9፥20</ref>፤ 28-29።</char></note> <verse eid="ACT 26:20"/><verse number="21" style="v" sid="ACT 26:21"/>ህከን መሳን አይሁድ መኑ ኤሳሃ መገን ምኔን ሄዕዮምሀኔን አፍ ሽቶኤተ ሀሶኡ። <verse eid="ACT 26:21"/><verse number="22" style="v" sid="ACT 26:22"/>ጠዉ እኮጎሬ ከበሬ ኢለ መገን ሀዕለንሹ ኢች አደ እኮበአ፤ ህካን እኮቤቺሃ አን ሎሪሃለከ ቀዊሃ ተማርሰን ከንቤቾን ዮም፤ ሙሲለከ ነብያከት ሄጭት ህት እሀኖ ይቶኢሃ ጠወዕዮምሀንቤሉ ዎሉ መቱርቹሃ ጠወዕዮምበአ። <verse eid="ACT 26:22"/><verse number="23" style="v" sid="ACT 26:23"/>ሁኩ እሰ ጠወኦኢሁ ‹መሲሁ ኦርሸተ ቶገኖ፤ ህትን ሬሆች ኬኢን ዎኔሃ እክ ጡም ኑር እስራኤል መኒሃለከ አይሁደ እህቡ መኒሃ ለሊሰኖ ይቲት› » ዬእ።<note caller="-" style="x"><char style="xo" closed="false">26፥23 </char><char style="xt" closed="false"><ref loc="ISA 42:6">ኢሳ. 42፥6</ref>፤ <ref loc="ISA 49:6">49፥6</ref>፤ <ref loc="1CO 15:20">1 ቆሮ. 15፥20</ref>።</char></note><verse eid="ACT 26:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24"/>ጳዉሎስ ህት ጠወአንን ፍስጦስ «ጳዉሎሴ! ቴዕኑ በርገጎንት፤ ልግብ ተማሩክ በርገጋሸ አዕዮሄ» ይ ላገስ ጎት አዕይ ጠወዕዮ።<verse eid="ACT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25"/>ጠዉ እኮጎሬ ጳዉሎስ «ከበጀንቶንት ፍስጦሴ! አን ሀንቅለከ ሀቅቀተ እኮ ጠወ ጠወኣሚት ቤሉ በርገጎምበአ። <verse eid="ACT 26:25"/><verse number="26" style="v" sid="ACT 26:26"/>አን ብሬስ ለሊሽ ጠወዕዮሚሃ ዎሙ ህከ ጠወ ደገኖ፤ ሁኩንን ማጠም አሰምባሃ እኮቤቺሃ ዎሙ ደገኖገ ተሬገጮም። <verse eid="ACT 26:26"/><verse number="27" style="v" sid="ACT 26:27"/>ዎመ አግሪጳ! ነብያኑተ አመዕንታንትበእንዶ? አት አመዕንታንትገ ደጋም» ይ ፈንቀሼእ።<verse eid="ACT 26:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28"/>አግርጵ ጳዉሎሴ «አት ኤሳሃ ቀዎ ጌሳን መሲህ ኢሳን አመዕናምገ አቶኤተ ሰውይቶንት» ዬስ። <verse eid="ACT 26:28"/><verse number="29" style="v" sid="ACT 26:29"/>ህትን ጳዉሎስ «ገበንቾ ወክቴን እሁን ቄራዕሮ ወክቴን ኬሳሃ ጠለዕል እሁዕነ ከበር ኩላሚሃ ሞጮጨኖሁ ጉዕሙንኩ ከን ኡሱረምኤ ቤሉ ዎሎርቾን ጉዕማንን ኢገ እኮተ ዱአ አኣም» ዬእ።<verse eid="ACT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30"/>ህከኒች ኤተሮን ዎሙ፥ ባድ ገሻንቹለከ ቤርኒቅ እሳንን ሜጡበ አፉዕልቶእሩ ጉዕሙንኩ ኬኦኡ። <verse eid="ACT 26:30"/><verse number="31" style="v" sid="ACT 26:31"/>እሰን ህከንቤቺች ኬእ መርተን «ኩ መንቹ ሬሆተ ህከረንገ ኡሱረሞተ ኢልሰኖስ ጠወ መቱርቹሃ አዕዮበአ» የቀንቶኡ። <verse eid="ACT 26:31"/><verse number="32" style="v" sid="ACT 26:32"/>ህትን አግርጵ ፍስጦሴ «ኩ መንቹ ሮም ባድ ዎመ ዎም አሌን ይግባኘ ይዮበእቃን ህትን ገፈረመኖ እቅ» ዬእ።<verse eid="ACT 26:32"/></para>
  <chapter eid="ACT 26"/>
  <chapter number="27" style="c" sid="ACT 27"/>
  <para style="s1">ጳዉሎስ ሮም ከተመ መሮተ ኬኡስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1"/>ህከኒች ኤተሮን ጣልያን ባዱ መርከቢን መርኖተ ወሰነሞ ወክት እሰ ጳዉሎሴለከ ዎሉ መት-መቱ ኡሱረንቶእረ በርግት ሮም ወታደር ኣዜን ሄዕዮ ዩልዮሴ ዬኖ ጥቤ ሀለቅቺሃ ህግስ ኣቶሰ። <verse eid="ACT 27:1"/><verse number="2" style="v" sid="ACT 27:2"/>እስይ ባር መዴን ዮ ባዶን ሄዕዮ መርከበት ኡርታ ቤቹ መረኖ አድራሚጥዮን መርከባን ኣንግ መርኖም፤ ተሰሎንቄን ሄአኖ መቄዶን ባድ መንቹ አርስጥሮኮስ ኒን ሜጡበ ሄዕዮ እቅ። <verse eid="ACT 27:2"/><verse number="3" style="v" sid="ACT 27:3"/>ነኡ ለንክ በር ሲዶን ከተመ ኢልኖም፤ ዩልዮስ ጳዉሎስ አሙዦስቤቺሃ ጃለሰቤቹ መር እሳች ሀስሰኖርቹ ኤቦተ አዕዮስ። <verse eid="ACT 27:3"/><verse number="4" style="v" sid="ACT 27:4"/>ነኡ ለንክ በር ቦብሩ ጠረኝ ቦብርሰን ሃሙ ከሞኔቤቺሃ ዊን ረበንቶ «ቆጵሮሰ» ዬኖ ኡላን ቴዕልን ባር አሌን መርከባን ሃሙ ጃመርኖም። <verse eid="ACT 27:4"/><verse number="5" style="v" sid="ACT 27:5"/>ክልቅይለከ ጵንፍልየ መዴን ሄዕዮ ባረ ቶልኖሚች ኤተሮን ሊቅየ ባዶን ሄአኖ «ሙራ» ዬኖ ከተመ ኢልኖም። <verse eid="ACT 27:5"/><verse number="6" style="v" sid="ACT 27:6"/>ጥቤ ሀለቁ ጣልያን ባዱ መረኖ አለክሰንደሪ ከተም መርከበ ደግ እሶን ኣግሾኔ።<verse eid="ACT 27:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 27:7"/>ነኡ ልግብ በር ሎድ ይን መርነን አበ ኦርሻን ቀኒዶስ ከተም መድ ኢልኖም፤ ቦብሩ ብርተ ዋልን ሃሙ ከሞኔቤቺሃ «ሰልሞና» ዬኖቤቺን ህንግ ዊን ረበንቶ «ቀርጤሰ» ዬኖ ኡላን ማጠም ኦሮዕኖም። <verse eid="ACT 27:7"/><verse number="8" style="v" sid="ACT 27:8"/>ነኡ አበ አርሻን ገበል ገበለ ሃመን ህንግ «ላስየ» ዬኖ ከተም መዴን ሄኣ ጡመተ ዬኖ መርከቡ ኡረኖ ቤቹ ኢልኖም።<verse eid="ACT 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9"/>ዎቄኔ አሌን ልግቡ ወክቱ በዕዮቤቺሃለከ ሶመን በሩ<note caller="+" style="f"><char style="fqa" closed="false">ሶመን በሩ፦ </char><char style="ft" closed="false">አይሁድ ሶመን በሩ ከበጀመኖሁ ጥቅምት አገናኒት፤ ሜዴተራንያን ባር አዝጋጌን ቅዝለከ ጤን ወክቱ ጀመረኖሁ ህከን አገናን እኮቤቺሃ ሁኩ ወክቱ መርከባን ሃሚሃ አበ ኦርሰኖ።</char></note> ህጎቤቺሃ ህከን ወክቴን ባር አሌን ሃሙ አበ ኦርሰኖቤቺሃ <verse eid="ACT 27:9"/><verse number="10" style="v" sid="ACT 27:10"/>ጳዉሎስ «ኮ መነ! ከኒች ኤተሮን ዮኔ ዎቃን አበ ኦርሸት ዮኢሃ እሁስ ለለኖኤት፤ ሁኩንን ሆጎቦንለከ መርከባን ኢልታ ኦርሸተ ጠለዕለ እሁዕናን ኒ ገይኔ ነብሳን አቡ ኦርሸት ኢልቶተ አታልታአ» ይ ጠረኝሽ ጠወዕዮ። <verse eid="ACT 27:10"/><verse number="11" style="v" sid="ACT 27:11"/>ጠዉ እኮጎሬ ጥቤ ሀለቅቹ ጳዉሎስ ጠረኝሽ ጠወዕዮ ጠዊች በትሽ መርከበስ ኦተአኖሀንለከ መርከብስ አኑ የኖሃ ሞጮጨኖት እቅ። <verse eid="ACT 27:11"/><verse number="12" style="v" sid="ACT 27:12"/>ሁኩ መርከቡ ኡረኖ ቤቹ ከርም ህከኔ ህግሲሃ ጡመ እህበቤቺሃ መኒች ልግቡስ «ሃሚሃ አታልሲሾ ጎሬ ቅልብ ገርብንለከ ከኣጳ ገርብ ኡሮን ዮ ፊንቄ ዬኖ ዊን ረበሞ ቀርጤሳን ሄአኖ መርከቡ ኡረኖ ቤቹ ኢልን ከርም ህከኔ ህግንሶ» ይት አማልሰ ሆንጠህሶኡ።<verse eid="ACT 27:12"/></para>
  <para style="s1">ባር አሌን ኡንጉሉሎ ቦብሩ ኬኡስ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13"/>ከኣጳ አዲን ቦብሩ ሎድ ይ ቦብርሰን ለኦ ወክት እሰ ሰውይቶ ሃሊን እሀኖሃ አጉጃንሰ መልሕቀ ኬስ ሃንቶተ ኬኦኡ፤ ሁኩ መርከቡ ኡረኖቤቺች ኬእ ቀርጤስ ኡለ ለቾን ህጎኡ።<note caller="+" style="f"><char style="fqa" closed="false">መልሕቀ፦ </char><char style="ft" closed="false">ዩ መርከቡ ኡረኖ ወክት ኡላን ካሰም መርከቡስ ሃምበገ አአኖሃ ሎረ ብረት።</char></note> <verse eid="ACT 27:13"/><verse number="14" style="v" sid="ACT 27:14"/>ጠዉ እኮጎሬ ቀዎ ወክቲች ኤተሮን ቅልቢን ሸርቅ ኡንጉሉሉተ ዬኖ ጠረኙ ቦብሩ ዊን ረበንቶ ኡላች ኬዕይ እሰ ዮ ቤቹ አሜቾ። <verse eid="ACT 27:14"/><verse number="15" style="v" sid="ACT 27:15"/>መርከበ ቦብሩ ሀምበሎቤቺሃለከ ቦብረስ አታሉ ሆንጎምቤቺሃ ጨለ ይን ቦብሩ ሀንበለኔ መርኖም። <verse eid="ACT 27:15"/><verse number="16" style="v" sid="ACT 27:16"/>ቀዎ ዊን ረበንቶ ቄዳ ዬኖ ኡለ መዲን ህንግ መርከበ ሀዕለኖ ጀልበ አበ ኦርሻን ኡሱርን ኡርንሶተ አታልኖም። <verse eid="ACT 27:16"/><verse number="17" style="v" sid="ACT 27:17"/>መርከብ ኣዜን አታ መኑ ጀልበስ ኣዝ ኣግስ መርከበስ ዌደሪን ኡሱርቶኡ፤ ህትን መርከበስ ሊብየ ባዲች አል አዲን ሄአኖ ሱርቲሰ ዬኖ ሽፋሩ ዮቤቾን ኡባበእገ ዋጅት ሸረ ድሪስ ቦብሩ ሀምበለን መርቶኡ። <verse eid="ACT 27:17"/><verse number="18" style="v" sid="ACT 27:18"/>ኒ አሌን ኡንጉሉሎ ቦብሩ ጠረኘን መሮቤቺሃ መርከባን ሆጎበንቶ ኦዳተ መት-መቲን ለንክስ በር ድሪስ ባር ኣዜን ኡጁ ጀመርቶኡ። <verse eid="ACT 27:18"/><verse number="19" style="v" sid="ACT 27:19"/>እሰን ሰቅ በር መርከቢሃ ደግለልታ ኦዳተ ባር ዊ አሌን ኡጅቶኡ። <verse eid="ACT 27:19"/><verse number="20" style="v" sid="ACT 27:20"/>ልግብ በር ጠረኙ ቦብሩ ኬዕይ አሩለከ ቤዜተ ለኡ ከሞኔቤቺሃ ጡምናምበአ ይን ተብሳሃ ሙርኖም።<verse eid="ACT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21"/>መኑ እቸተ እቱዕነ ልግብ በር ዱንኬቤቺሃ ጳዉሎስ በለሰ ኡር «ኮ መነ! ከኒች ብርተ ሸዦንክዕኔ ሸዘነተ ሞጮጭቴን ዊን ረበንቶ ቀርጤሰ ዬኖ ቤቺች ኬኤንታበ እቃን ኩ ኦርሸትለከ በኡ ኢለኖህዕኔበአ እቅ። <verse eid="ACT 27:21"/><verse number="22" style="v" sid="ACT 27:22"/>ቴሁ መርከቡስ በአኖ ቤሉ ክዕኔች መትክዕኔ ነብሶሁ በአኖበአ፤ ዋጅቶኖቼ ይ ሸዛንክዕኔ። <verse eid="ACT 27:22"/><verse number="23" style="v" sid="ACT 27:23"/>መሰንትስ ህጎ ሀንከዕርተ አን እሲሃ ጠገም ሰገዳም መገኑ ሶኮስ መላይኬቹ መዴንከእ ኡር <verse eid="ACT 27:23"/><verse number="24" style="v" sid="ACT 27:24"/>‹ጳዉሎሴ ዋጅቶት! ሮም ባድ ዎም ብሬን ኡሩ ዮሄ፤ ህትን ኪን ሜጡበ እክ ሃንታ መነ ጉዕመንከ መገኑ ኪተኔሃ ይ ሬሆች ጡምሰኖ› ይ ኩሎኤ። <verse eid="ACT 27:24"/><verse number="25" style="v" sid="ACT 27:25"/>ህካን እኮቤቺሃ መነ ዋጅቶኖቼ፤ መገኑ ኤሳሃ ኩሎኤርቹ አአኖገ አመዕናም። <verse eid="ACT 27:25"/><verse number="26" style="v" sid="ACT 27:26"/>እኮጎሬ ቦብሩ ሀንበል መት ዊን ረበንቶ ኡለተ መሰኖኔ» ዬእ።<verse eid="ACT 27:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27"/>ቶነ ሾልቅ በሬ ሀንከዕሬን አድርያ ባር<note caller="+" style="f"><char style="fqa" closed="false">አድርያ ባረ፦ </char><char style="ft" closed="false">የኖሁ ሜድትራን ባሪች መቱሃስ አደ</char></note> አሌን ቦብሩ ሀምበለን ሀንከዕሬ በላን መርከበ ኦተኣእሩ ኡለተ ኢልቶኢሃ አጉጆሰ። <verse eid="ACT 27:27"/><verse number="28" style="v" sid="ACT 27:28"/>ህካን እኮቤቺሃ እሰ ህከን ቤቺ ጥዕላሽመተ ዎደሪን ክኑ ኡሱርት ኣዝ ዋሽት ብክታ ወክት ህዜታዩ ብኩተ እኮ፤ ህትን ቀወ ወክቲች ኤተሮን ለንኪሃ ብክቶ ወክት ሌሃዉ ብኩተ እኮ። <verse eid="ACT 27:28"/><verse number="29" style="v" sid="ACT 27:29"/>ህካን እኮቤቺሃ መርከቡ ባር መዴን ዮ ክኖን ዎቀዕርበገ ዋጅት መርከብ ኤተር አዲን ሾሉ «ማልሕቀ» ዬኖ ብረት ባር ኣዜን ኡርሶኡ፤ ህከኒች ኤተሮን ኡለት ሶዛገ ዱአ አቶኡ። <verse eid="ACT 27:29"/><verse number="30" style="v" sid="ACT 27:30"/>መርከበ ኦተኣ መኑ መርከቢች ፉልት ሁንቶተ ሄዕላት መርከብ ብሬ አዲን ዮ «መልሕቀ» ዬኖርቹ ኡጅታኢሃ አጉድ መርከብ አሌን ሄዕዮ ጀልበ ባር አሌን ኡጅቶኡ። <verse eid="ACT 27:30"/><verse number="31" style="v" sid="ACT 27:31"/>ጳዉሎስ ህካን ለዕዮ ወክት ጥቤ ሀለቅቺሃለከ ዎታደሪሃ «ኩ መርከበ ኦተኣእሩ መርከብ ኣዜን ረጀይት አፉዕልትባች አዕኑ ጡምቶኖተ አታልቴነንተበአ» ዬሰ። <verse eid="ACT 27:31"/><verse number="32" style="v" sid="ACT 27:32"/>ህካን እኮቤቺሃ ዎታደሩ ጀልበ ኡሱሬመ ዎደሩ ሙርት ባር አሊን ሃንታገ አቶኡ። <verse eid="ACT 27:32"/><verse number="33" style="v" sid="ACT 27:33"/>ኡለት ሶዞተ ሆንጠካን ጳዉሎስ ጉዕሙንኩሰ እቸተ እቶተ «አዕኑ መት-መቱክዕኔ አገርቴነን እቸተ እቶኑዕነ ዱንክቴንታች ከበር ቶነ ሾልቅየ በር። <verse eid="ACT 27:33"/><verse number="34" style="v" sid="ACT 27:34"/>ህካን እኮቤቺሃ አዕኑ እቸተ እቶኖተ ኡጫንክዕኔ፤ እቸት እቴንታች ጡምቴነንተ፤ ክዕኔ አሌን መት ኦርሸት እካህዕኔበአ» ይ ኡጬሰ። <verse eid="ACT 27:34"/><verse number="35" style="v" sid="ACT 27:35"/>እስ ህካን ዬች ኤተሮን ጣቢተ ኣእ ጉዕምሰ ብሬን ዱአ አዕይ ቢጭ እቱ ጀመሮ። <verse eid="ACT 27:35"/><verse number="36" style="v" sid="ACT 27:36"/>ህከኒች ኤተሮን ጉዕሙንኩሰ ነሻጥ እቸተ እቶኡ፤ ህትን እሰን ገይሰ አንጋን ጣቢተ ኣእት እቶኡ። <verse eid="ACT 27:36"/><verse number="37" style="v" sid="ACT 27:37"/>መርከብ ኣዜን ሄዕኖምሩ ጉዕሙንኩኔ ለም ጥብተ ለመላይኔ ሌሆ መነ እቅ። <verse eid="ACT 27:37"/><verse number="38" style="v" sid="ACT 27:38"/>እሰን እት ዱቦች ኤተሮን መርከቢሃ ኬዕመኖበእገ አለሱ ባራን ቶርቶኡ።<verse eid="ACT 27:38"/></para>
  <para style="s1">መርከቡ ቢጠሙስ</para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39"/>እሰን ኡለት ሶዘን ኢልቶ ቤቹ ደጎበአ፤ ጠዉ እኮጎሬ ባር መዴን ዮ ሽፋር ኡለተ ለኦኡ፤ አታልቶ እቃ መርከበ ህከ ቤቹ ሆንጠህሶተ ሰውይቶኡ። <verse eid="ACT 27:39"/><verse number="40" style="v" sid="ACT 27:40"/>ህካን እኮቤቺሃ እሰ መርከበ ኡርሳ መልሔቅ ዌደሩ ሙርት ኡጅቶኡ፤ ህትን መርከበስ ጉረለከ መኬ አደ አኢሃ ሀዕለኖ ዌደሩ ሂርቶኡ፤ ሸረስ አሌ ዋሽት ኡሱርታን ቦብሩ ብርተ ዋሽ ሃንሲሰን ባሪች ገበለ ዋል ሃመኖገ አቶኡ። <verse eid="ACT 27:40"/><verse number="41" style="v" sid="ACT 27:41"/>ጠዉ እኮጎሬ መርከቡ ናረሞ ሽፋራን ቆዕል ብሬ አዲን ኡላን ካሰሞቤቺሃ ሌንቄቅበገ እኮ፤ ህትን ኤተር አዲን ዊ ሁሉ አበ ሀምበለኖቤቺሃ ቢጠሙ ጀመሮ።<verse eid="ACT 27:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42"/>ኡሱረንቶሀኑኡች አዪሁ ባረ ዘከዕይ ፉሸዕበገ ዎታደሩ ሽቶተ አማዕለንቶኡ። <verse eid="ACT 27:42"/><verse number="43" style="v" sid="ACT 27:43"/>ጠዉ እኮጎሬ ጥቤ ሀለቅቹ ጳዉሎሴ ጡምሶተ ሀሾቤቺሃ ሰውትሰ ቶጎበአ፤ ህካን እኮቤቺሃ ዘከኡ አታለኖሁ አዪሁ መርከቢች ኮርጅ ድር ዘከዕይ ገበለ ፉለኖገ አዘዦ።<verse eid="ACT 27:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 27:44"/>ፈቆሀኑኡች መቱ ጌሱ መርከቢች ቢጠሞሀኒን ህከረንገ ዎሎርች አሌን እክ ፉልቶተ አዘዣን ጉዕሙንኩሰ ወገሬቲን ገበለ ፉልቶኡ።<verse eid="ACT 27:44"/></para>
  <chapter eid="ACT 27"/>
  <chapter number="28" style="c" sid="ACT 28"/>
  <para style="s1">ጳዉሎስ ዊን ረበንቶ «ማልተ» ኢሉስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1"/>ነኡ ዊን ረበንቶ ኡለቤቹ ወገሬቲን ኢልኖሚች ኤተሮን ሁኩ ኡለት «ማልተ» ዬን ገኤኖሃ እሁስ ደንጎም። <verse eid="ACT 28:1"/><verse number="2" style="v" sid="ACT 28:2"/>ህከ ወክት ጤነ ኡባን ቂዘ እኮቤቺሃ ህከን ዊን ረበንቶ ኡላን ሄአኖ መኑ ጉዕሙንኩ ጊረተ ቡስት ጡመገ አት ኮህሶኔ። <verse eid="ACT 28:2"/><verse number="3" style="v" sid="ACT 28:3"/>ጳዉሎስ ሁረ ጭምአዕይ ጊራን ዎሮ፤ ህከን ፋራን ኬዕዮ አኔን መቱ ዎሪቹ ፉል ጳዉሎሴ አንገስ ከሮ። <verse eid="ACT 28:3"/><verse number="4" style="v" sid="ACT 28:4"/>ማልተ ዬኖ ኡላን ሄኣ መኑ ዎሪቹ ጳዉሎሴ አንገተ ከሩስ ለኦ ወክት ገገዉንኩሰን «ኩ መንቹ ሀንቅንከ መነ ሽዮእሃን፤ ባሪች ወገሬቲን ፉሎጎሬሁ ፍርዲች ጡም ፎሊን ሄኦተ አታሎበአ» የቀንቶኡ። <verse eid="ACT 28:4"/><verse number="5" style="v" sid="ACT 28:5"/>ጠዉ እኮጎሬ አንጋችስ ዎሪቹ ግግሽ ጊራን ኡጅ ምርተኡዕነ ፈቆ። <verse eid="ACT 28:5"/><verse number="6" style="v" sid="ACT 28:6"/>እሰ «አንገላንገን አሉስ ደርሸኖ ህከረንገ ወክትንከስ ኡብ ሬሀኖ» ይት አገርታኢት እቅ፤ ጠዉ እኮጎሬ እሰ ልግብ ወክት አገርትኬእ ምርተኡ ሆጉስ ለእ ሰውትሰ ዶርት «ኩን መገኑሃን» ይቶኡ።<verse eid="ACT 28:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7"/>ህከን ሄዕኖም ቤቾን መዴን ዊን ረበሞ ባዱ ገሸኖ «ፑፕልዮሴ» ዬኖ መንቺሃ ኡለት ሄኦስ እቅ፤ እስን ምንስ መስ ሰሱ በር ጡመገ አዕይ ቶጎኔ። <verse eid="ACT 28:7"/><verse number="8" style="v" sid="ACT 28:8"/>ህከ ወክት ፑፕልዮሴ አነ ፋረትለከ ጎደበ ኦተዕይ ጥዣንስ ኦሰዕዮ እቅ፤ ህካን እኮቤቺሃ ጳዉሎስ እስ ምኒ ኦሮዕይ አንገስ አሌስ አዕይ ዱአ አዕያን ፈዬእ። <verse eid="ACT 28:8"/><verse number="9" style="v" sid="ACT 28:9"/>ሁኩን እኮች ኤተሮን ህከን ዊን ረበንቶ ባዶን ሄኣ መኒች ዎሉ ጥዘናመት አሜት ጥዘናችሰ ፈይቶኡ። <verse eid="ACT 28:9"/><verse number="10" style="v" sid="ACT 28:10"/>እሰ ኔሳሃ ልግብ ሽልማት ኤቦኔ፤ ከበጁሰ ለሊሶኔ፤ ነኡ መርከባን ኣንግ መርኖተ ኬዕኖም ወክት ኔሳሃ ሀስሰኖርቹ መርከባን ሆጎቦኔ።<verse eid="ACT 28:10"/></para>
  <para style="s1">ጳዉሎስ ማልታች ሮመ ኦሮዕዮገ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11"/>ሰሱ አገነ ዊ በላን «ማልተ» አገርኖሚች ኤተሮን ከርም ህከኔ ዊን ረበሞ ባዶን ዱንኬ አሌክሰንደር ከተም መርከባን ኣንግ ሃሞተ ኬዕኖም፤ መርከብስ አሌን «ዲዮስቆሮስ» ዬኖ መልተ ሽርኬሃ ለም መላት ሄኦስ እቅ። <verse eid="ACT 28:11"/><verse number="12" style="v" sid="ACT 28:12"/>«ስራኩሰ» ዬኖ ከተመ ኢልን ሰሱ በር አፉዕልኖም። <verse eid="ACT 28:12"/><verse number="13" style="v" sid="ACT 28:13"/>ህከንቤቺች ባር መዴን ዘህን «ሬጊዩም» ዬኖቤቹ ኢልኖም፤ መቶ በሬች ኤተሮን ከኣጵ አዲን ቦብረኖ ቦብሩ ቦብርሴቤቺሃ ለንክስ በር «ፑቲዮሉሰ» ዬኖቤቹ አሜንቶም። <verse eid="ACT 28:13"/><verse number="14" style="v" sid="ACT 28:14"/>ህከኔ ሄኦ አመዕናኖን ደቀም እሳንን ሜጡበ ለመለ በር ዱንክኖተ ኡጭቶኔ፤ ህከኒች ኤተሮን ሮም ከተመ መርኖም። <verse eid="ACT 28:14"/><verse number="15" style="v" sid="ACT 28:15"/>ሮም ባድ አመዕናኑት ኒተኔሃ ሞጮጭቶ ወክት «አፍዮስ» ዬኖ ጌቤበለከ «ሰሱ ኮሁ ገለኖ ምነት» ዬኖቤቹ ኢለ ኔሳሃ ቶጎተ አሜቶኡ፤ ህካን እኮቤቺሃ ጳዉሎስ እሰተ ለዕዮ ወክት መገኑ ገለትጭ ጠረኜእ።<verse eid="ACT 28:15"/></para>
  <para style="s1">ጳዉሎስ ሮም ከተመ ኢሌገ</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16"/>ነኡ ሮም ከተመ ኣንጎም ወክት ጳዉሎሴ ፉሸእበገ አገረኖ መቱ ዎታደርቹ ኣሴናንስ ሜጢሀስ ሄአኖገ አኤመስ።<verse eid="ACT 28:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17"/>ሰሶ በሬች ኤተሮን ጳዉሎስ ሮም ከተማን ሄኣ አይሁድ ሎርሎረ መነ ገእሲሾ፤ መኑስ ጭምይቶ ወክት «አመኤ ኦሶ! እስራኤል ኡመት አሌንለከ አናከኔ ሴር አሌን አዕዮም ብድሉ ዮበአ፤ እሁን ቤሉ ዬሩሳሌም ከተማን ኡሱረሞምቤቺች ሮም መኒሃ ህግሴን ኣሴመኤ። <verse eid="ACT 28:17"/><verse number="18" style="v" sid="ACT 28:18"/>ሮም ባድ መኑ መረመርቶች ኤተሮን ህትን ገፈርቶኤተ ሰውይቶኡ፤ መሰንትስ ኤሳሃ ሬሆተ ኢልሰኖኤ ጠወ ሆጎቤቺሃት። <verse eid="ACT 28:18"/><verse number="19" style="v" sid="ACT 28:19"/>ጠዉ እኮጎሬ አይሁዱ አን ህትን ገፈረሙ ግባ ወክት ሮም ባድ ዎም አሌን ይግባኘ ዩ ሀስሾኤ ቤሉ ኢ ኡመት ከሰሳም ጠዉ ዮኤበአ።<note caller="-" style="x"><char style="xo" closed="false">28፥19 </char><char style="xt" closed="false"><ref loc="ACT 25:11">ሶቀ. 25፥11</ref>።</char></note> <verse eid="ACT 28:19"/><verse number="20" style="v" sid="ACT 28:20"/>ህካን እኮቤቺሃ አን ክዕኔተ ለኦተለከ ክዕኔን ሜጡበ ጠወኦተ ጠዕምዮም፤ መሰንትስ አን ሰንሰለቲን ኡሱረሞሚሁ እስራኤልሃ ኣሰሞ ተብሴሃት» ዬሰ።<verse eid="ACT 28:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21"/>እሰ ጳዉሎሴ «ኪተኔሃ ኔሳሃ ይሁድ ባዲች ደብዳቤት ኢልቶኔበአ፤ ህትን ከበ አሜቶ መኒች አዪሁ ኪ ሂለ ጠወ ኩሎሁለከ ጠወዕዮሁ ዮበአ። <verse eid="ACT 28:21"/><verse number="22" style="v" sid="ACT 28:22"/>እኮጎሬ ነኡ አት አዎንታንት አመዕነቱ አደደ ቤቾን ዮ መኑ ቶጉ ግበኖገ ደንጋም፤ ህካን እኮቤቺሃ ኪ ሰውቱ መሃጎሬ ሞጮጭኖተ ሀንሳም» ይቶስ።<verse eid="ACT 28:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23"/>ህካን እኮቤቺሃ እሰ ዝኝተ አፎች ኤተሮን ልግቡ መኑ እስ ገለኖ ምንቤቹ አሜቶኡ፤ ጳዉሎስን ገስሜች ሀዎሩተ ኢለ መገን ዎምነትተኔሃ ዮስ ሰውት ጠወዕዮ፤ ሙስ ሕጊችለከ ነብያከ መጻፊች ኢስተኔሃ ኩሎሰ። <verse eid="ACT 28:23"/><verse number="24" style="v" sid="ACT 28:24"/>ህከኒች ኤተሮን መት-መቱሰ እስ ጠወዕዮሰ ላገተ አመዕንቶኡ፤ እኮጎሬ መት-መቱሰ አመዕንቶበአ። <verse eid="ACT 28:24"/><verse number="25" style="v" sid="ACT 28:25"/>ህካን እኮቤቺሃ ገገዉንኩሰን ኢተቀንቱዕነ አደ እኮገ ጳዉሎስ ለዕዮ ወክት «ጠሊሉ አያኑ ነብዬቾ እስያሴን አናካተክዕኔ ጠወዕዮሁ ሀንቅሃን።<verse eid="ACT 28:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 28:26"/>« ‹ህከ ኡመት ቤቹ መርትኬእ</para>
  <para style="q1" vid="ACT 28:26">ሞጮጩስ ሞጮጭቴነንተ</para>
  <para style="q1" vid="ACT 28:26">ሆሮን ቶጌነንተበአ።</para>
  <para style="q1" vid="ACT 28:26">ለኡስ ለኤነንተ እኮጎሬ ሆሮን አጥራመቴነንተበአ።<verse eid="ACT 28:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27"/>መሰንትስ ከን ኡመት ቀልቡ ዱጆኡ፤</para>
  <para style="q2" vid="ACT 28:27">መጨስ ዶንቅቶኡ፤ እልሰን ቆቆኡ፤</para>
  <para style="q1" vid="ACT 28:27">ህት እኮበእ እቃን</para>
  <para style="q2" vid="ACT 28:27">እሌንከሰ ለእ</para>
  <para style="q2" vid="ACT 28:27">መጫንከሰ ሞጮጭት</para>
  <para style="q1" vid="ACT 28:27">ቀልቤንከሰ ሰውይት</para>
  <para style="q1" vid="ACT 28:27">ኢቤቹ ፈንቀልቶ እቃን</para>
  <para style="q2" vid="ACT 28:27">አንን ፈይሳንሰ እቅ›</para>
  <para style="m" vid="ACT 28:27">ዬእ።<verse eid="ACT 28:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28"/>«ቴሁ መገን ጡምስ ሶህኑት አይሁደ እህበ መኒሃ ሶሀንቶእተ እሁስ ደጌ፤ ህትን እሰ ሞጮጭታአ» ዬእ። <verse eid="ACT 28:28"/><verse number="29" style="v" sid="ACT 28:29"/>[«ጳዉሎስ ህካን ጠወዕዮች ኤተሮን አይሁዱ አበ ኦደን ህከንቤቺች አጉርት ፉልቶኡ»]<note caller="+" style="f"><char style="ft" closed="false">ወዕኔ ሉህ መጻፋን ዎሊንሽ 29 ዮኢሃ በርግታበአ።</char></note><verse eid="ACT 28:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30"/>ጳዉሎስ ኬር ምኔን ለሙ ዘማን ዊመ አፉዕሌእ፤ እስቤቹ አሜተኖ መነ ጉዕመንከ ኮህኝተ ቶገኖ እቅ። <verse eid="ACT 28:30"/><verse number="31" style="v" sid="ACT 28:31"/>ጳዉሎስ መገን ዎምነትተኔሃ ኩለን ቀርቾ መሲህ ኢስተኔሃ አዪሁ ከሞስበኢሃ መለል ተማርሰኖት እቅ።<verse eid="ACT 28:31"/></para>
  <chapter eid="ACT 28"/>
</usx>
