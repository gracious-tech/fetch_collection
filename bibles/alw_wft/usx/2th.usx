<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TH" style="id">- HALABA NEW TESTAMENT</book>
  <para style="h">ለንክ ተሰሎንቄ</para>
  <para style="toc1">ጳዉሎስ ተሰሎንቄ መኒሃ ከተቦ ለንክ ሶህኑተ</para>
  <para style="toc2">ለንክ ተሰሎንቄ</para>
  <para style="toc3">2 ተሰ.</para>
  <para style="mt1">ጳዉሎስ ተሰሎንቄ መኒሃ</para>
  <para style="mt2">ከተቦ ሶህኑተ</para>
  <para style="imt1">ኣጉስ</para>
  <para style="ip">መሲህ ፈንቀል አሜትስ አሌን ኬኦ ጠዕምቱት ብተተ ኬሰን መሮቤቺሃ ተሰሎንቄ አመዕናኖ በላን ኬኦ ኦርሸት ባሰን መርቶኡ፤ ጳዉሎስ ተሰሎንቄ መኒሃ ከተቦ ለምቅ ሶህኑት «ቀርቹ ፈንቀል አሜተኖ በሩ ሆንጠኮኡ» የኖ ጠዋን ስመኞሃ እቅ፤ ጳዉሎስ መሲህ ፈንቀል አሜቱስ ሄጭ «ሾከ መንቹ» ዬኖ መሲህ ግበኖሁ አዎንሰን ኣዱንያ አሌን ሂሉለከ ሾኩ ጠዉ በተአን መረኖ የን እሰ አመዕነቱ መክሶተ ዎብ የኖ።</para>
  <para style="ip">ሶቀማንቹስ አነበባእሩ ኦርሸት በተኦ ጎሬሁ አመዕነቶንከሰ ጠረኝቶተ እስለከ ዎሉ ሆጉተ ሀዕልታስሩ አታ ደኒን ሄኢሀሰ ደግለለኖርቹ ደእቶተ ጠረኝት አቶተ ህትን ጡመ ሆጉተ አቶተ ጠረኝሽ ሸዘኖሰ።</para>
  <para style="iot">መጻፉስ አፎሃ</para>
  <para style="io1">ኣጉስ <char style="ior">(<ref loc="2TH 1:1-2">1፥1-2</ref>)</char></para>
  <para style="io1">መሲህ ፈንቀል አሜቶንከስ እሀኖ ፍርደ <char style="ior">(<ref loc="2TH 1:3-12">1፥3-12</ref>)</char></para>
  <para style="io1">መሲህ ፈንቀል አሜቱስ ኩለኖ ትምርት <char style="ior">(<ref loc="2TH 2:1-17">2፥1-17</ref>)</char></para>
  <para style="io1">አመዕነቲን ሀት ሄኤኖ ጎር ኩልታ ሸዘነተ <char style="ior">(<ref loc="2TH 3:1-15">3፥1-15</ref>)</char></para>
  <para style="io1">መጨረሸስ <char style="ior">(<ref loc="2TH 3:16-18">3፥16-18</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="2TH 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1"/>ጳዉሎስ፥ ስላስ፥ ጥማቶስ አናኔ መገንለከ ቀርቾሃ መሲህ ኢስረ እኮ ተሰሎንቄ ከተማን ዮንተ መገን አመዕናኖ ዱእ ምናተ ሶንኮምተ ሶህኑ።<note caller="-" style="x"><char style="xo" closed="false">1፥1 </char><char style="xt" closed="false"><ref loc="ACT 17:1">ሶቀ. 17፥1</ref>።</char></note><verse eid="2TH 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2"/>አና መገኒችለከ ቀርቾሃ መሲህ ኢሲች ኣስቱትለከ ወገሬቱ ክዕኔሃ እሁን።<verse eid="2TH 1:2"/></para>
  <para style="s1">መሲህ አሜቶን እሀኖ ፍርደ</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3"/>አመኤ ኦሶ! አመዕነቱክዕኔ ዎዕኔች በትሽ ነጰን አሜቾቤቺሃ መት-መቱክዕኔ ኢተቀንቴነንተ ኢተት በርግተን መርታቤቺሃ መገኑ ገለትጩ ሀስሰኖቤቺሃ ክዕኔ መሳን መገኑ ጉዕመ ወክትንከ ገለትጭናም። <verse eid="2TH 1:3"/><verse number="4" style="v" sid="2TH 1:4"/>ኢልቶህዕኔ ኦርሸተለከ ሸረሙ አታዕሊን አመዕነቲንከክዕኔ ጠረኝቴን ኡርቴንተቤቺሃ ክዕኔተኔሃ መገን አመዕናኖ ጭምት ዱእ ምናን ጉዕማን ጠወኢሃ ሙልናምበአ።<verse eid="2TH 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5"/>ኩ ጉዕሙንኩ ጠዉ ለሊሰኖሁ መገን ፍርዱ ሀንቅ እሁስለከ አዕኑ ኦርሸተ ቶጌንተሲሁ መገን ጄነትተኔሃ አበቀአኖህዕኔሃ እኮቤቺሃት። <verse eid="2TH 1:5"/><verse number="6" style="v" sid="2TH 1:6"/>መገኑ ሀንቅ ፍርደ ፈረደኖቤቺሃ ኦሪሸተ ኤባህዕኔሀኑኡ አሌን ፈንቀሽ ኦሪሸተ ኤበኖ። <verse eid="2TH 1:6"/><verse number="7" style="v" sid="2TH 1:7"/>ቀርቹ ኢስ ሎረ ወልቀት ዮሰ መላይካን ሜጡበ ሰሜች ጊረ ለበናን አሜተኖ ወክት ቴሱ ኦሪሸተ ቶጌነንተ ክዕኔሃ ኒንን ሜጡበ ፎሎጩ ኣሰኖህዕኔ። <verse eid="2TH 1:7"/><verse number="8" style="v" sid="2TH 1:8"/>መገኑ ደግበረለከ ቀርቹሃኔ ኢስ ተሽት ላጋተ አዘዘንትበረ ጊረ ለበናን ቀጠአኖሰ። <verse eid="2TH 1:8"/><verse number="9" style="v" sid="2TH 1:9"/>እሰ ቀርች ብሬችለከ ኬዕምኝስ ዎልቃች አደ እካን ዘላለሚሃ ቤሲን ቀጠአኖሰ።<note caller="-" style="x"><char style="xo" closed="false">1፥9 </char><char style="xt" closed="false"><ref loc="ISA 2:10">ኢሳ. 2፥10</ref>።</char></note> <verse eid="2TH 1:9"/><verse number="10" style="v" sid="2TH 1:10"/>እስ ህከ ወክት ኬዕምኚንከስ ፈንቀለኖ ወክት ኬዕምኝለከ ገለት ጉዕማንከ ጠሊላኖ ኡመቲችለከ አመዕንቶሀኑኡች ጉዕሚች ቶገኖ፤ አዕኑሁ እሲን ሜጡበ እኬነንተ፤ መሰንትስ ምስክርነቱኔ አመዕነቲን ቶጌንታአ።<verse eid="2TH 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11"/>ካን ሰው ይነን ክዕኔተኔሃ ሙርኑዕነ ዱአ አዕናሚሁ መገኑኔ ገኤኔሀኒሃ በቀዕናምረ አኦህዕኔተ ጡመ አኢሃ ዮህዕኔ ሀስሸተለከ አመዕነት ሆጉክዕኔ ጉዕመንከ ወልቃንተስ አኦህዕኔታት። <verse eid="2TH 1:11"/><verse number="12" style="v" sid="2TH 1:12"/>ህትን ቀርችኔ ኢስ ሱዕሙ ክዕኔን ከበጀሞተለከ አዕኑሁ መገንኔለከ ቀርቹሃኔ መሲህ ኢስ ኣስቶን እሶን ከበጀንቶኖተ ዱአ አዕናም።<verse eid="2TH 1:12"/></para>
  <chapter eid="2TH 1"/>
  <chapter number="2" style="c" sid="2TH 2"/>
  <para style="s1">ሾከ መነ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1"/>አመኤ ኦሶ ቀርቹሃኔ መሲህ ኢስ አሜትተኔሃለከ ነኡሁ እሲን ሜጡበ እንክ ጭምይናምቤቺሃ ዱአ አዕናሚሁ ህካኒት።<note caller="-" style="x"><char style="xo" closed="false">2፥1 </char><char style="xt" closed="false"><ref loc="1TH 4:15-17">1 ተሰ. 4፥15-17</ref>።</char></note> <verse eid="2TH 2:1"/><verse number="2" style="v" sid="2TH 2:2"/>ራጊን ህከረንገ ላጋን ጠወአሞሀንገ ህከረንገ ኒች ሶህኑተ እክ ከተበሞሀንገ አቴን «ቀርች በሩ አሜቾኡ» ዪን ደዕልቴን ቀልብክዕኔ ሆርጥቶኖቼ፤ ጨነቀንቶኖቼ። <verse eid="2TH 2:2"/><verse number="3" style="v" sid="2TH 2:3"/>አዪሁ ሀከን አዲን ሉሲሱንከህዕኔ፤ መሰንትስ ሄጭ ለግት አሜቱዕነ አዛብ ጊረት በቀኣስ፤ እስን ኤተር ለገኣንቹ አሜቶተ ኢለ ህከረንገ ሾኩ መንቹ እስን በኦተ ዮኢሁ ለሎተ ኢለ ሁኩ በሩ አሜተኖበአ። <verse eid="2TH 2:3"/><verse number="4" style="v" sid="2TH 2:4"/>ሁኩ ሾኩ መንቹ ሽርክተ ዬን ሰገዴኖሰሀኑኡች ጉዕሚች አሌን ገውስ ሎረ አአኖ፤ ህትን «አን መገኑሃን» የንን መገን ጠሊለ ምኔን ፈቁዕነ አፉዕሎተ መለለኖ።<note caller="-" style="x"><char style="xo" closed="false">2፥4 </char><char style="xt" closed="false"><ref loc="DAN 11:36">ዳን. 11፥36</ref>፤ <ref loc="EZK 28:2">ሕዝ. 28፥2</ref>።</char></note><verse eid="2TH 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5"/>ክዕኔን ሜጡበ ሄዕዮም ወክት ከ ጠወ ኩሎንክዕኔገ ሰውይቴነንተበእንዶ? <verse eid="2TH 2:5"/><verse number="6" style="v" sid="2TH 2:6"/>እስን ወክቱስ ኢልያን ለለኖሃ ኢለ ቴሱ ለሉ ከመኖሲሁ መሃጎር አዕኑ ደጌነንተ። <verse eid="2TH 2:6"/><verse number="7" style="v" sid="2TH 2:7"/>መሰንትስ ሂለ ሆጉተ ማጥ አታኢት፤ ሁኩንን ቴሱ ከሚሃ ዮ ሂለ ምስጥር ዎልቀት ቴሱ ሆጎ አሌኒት፤ ሁኩንን እሀኖሁ ዎቄች ሽቆተ ኢላት። <verse eid="2TH 2:7"/><verse number="8" style="v" sid="2TH 2:8"/>ህከኒች ኤተሮን ሁኩ ሂሉ መንቹ ለለኖ፤ እሱንከ ቀርቹ ኢስ አፌችስ ፉለኖ ፎገሊንለከ አሜትስ ኬዕምኚን ሸኖ።<note caller="-" style="x"><char style="xo" closed="false">2፥8 </char><char style="xt" closed="false"><ref loc="ISA 11:4">ኢሳ. 11፥4</ref>።</char></note> <verse eid="2TH 2:8"/><verse number="9" style="v" sid="2TH 2:9"/>ሁኩ ሂሉ መንቹ አሜተኖሁ ሻይጣን ዎልቃን ሉሲሰኖ አጀብሲሰኖ ጠወለከ መላተ ገረምሲጬኖርቹ ጉዕመንከ አኢኒት። <verse eid="2TH 2:9"/><verse number="10" style="v" sid="2TH 2:10"/>ህትን በኣ መነ ጣንስታኢሁ እኮስ ሂለርቹ አኢኒት፤ ሁኩ መኑ በኣኢሁ ጡምቶተ አበቀአኖሰ ሀንቅ ኢተተ ቶጉ ግባቤቺሃት። <verse eid="2TH 2:10"/><verse number="11" style="v" sid="2TH 2:11"/>ህካን እኮቤቺሃ ክዝቢን አመዕንቶተ መገኑ ሎረ ሉሲሳ ወልቀተ ሶሀኖሰ። <verse eid="2TH 2:11"/><verse number="12" style="v" sid="2TH 2:12"/>ሁኩን እሀኖሁ ሀንቂን አመዕኑ ግብ ጩብ አሌን ሙንደኣሀኑኡ አሌን ፈረደሞታት።<verse eid="2TH 2:12"/></para>
  <para style="s1">ጡሚሃ ዶዕሬሰ መነ</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13"/>ቀርቺን ኢተንቴንተ አመኤ ኦሶ! እኮጎሬ ነኡ ክዕኔ መሳን መገኑ ጉዕመ ወክት ገለት ኣሱ ሀስሰኖኔ፤ ገለት ኣስናሚሁ ክዕኔተ ጠሊለ አያኒን ጠሊልቴንተቤቺሃ ሀንቅ አመዕኖንከክዕኔ ጡምቶኖተ መገኑ ሄጭ ዶዕሬህዕኔቤቺሃት። <verse eid="2TH 2:13"/><verse number="14" style="v" sid="2TH 2:14"/>ነኡ ኩልኖንክዕኔ ተሽት ላገ አዲን ቀርቹሃኔ መሲህ ኢስ ኬዕምኝ ደእቶኖተ መገኑ ገኤህዕኔሁ ከኒሃት። <verse eid="2TH 2:14"/><verse number="15" style="v" sid="2TH 2:15"/>አመኤ ኦሶ! ህካን እኮቤቺሃ ቴሱ ጠረኝቴን ኡርዬ፤ አፌችኔ ፉልቶ ላጋን ህከረንገ ሶህኖን ተማርስኖንክዕኔ ሀንቅ ትምርት ሀቦኖቼ።<verse eid="2TH 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16"/>ቀርቹኔ መሲህ ኢስ ገውስለከ መገኑ አኑኔ ኢቴኔሁ ኣስቶንከስ ዘላለሚሃ እካ ጠረኝመተለከ ጡመ ተብሳሃ ኣሴኔ <verse eid="2TH 2:16"/><verse number="17" style="v" sid="2TH 2:17"/>ጡመ እኮ ጠወ ጉዕመንከ አቶኖተለከ ጠወኦኖተ ቀልብክዕኔ ሰበርሶህዕኔ፤ ጡመ ጠወ ጉዕመንከ አቶኖተለከ ጠወኦኖተ ጠረኝሶህዕኔ።<verse eid="2TH 2:17"/></para>
  <para style="b"/>
  <chapter eid="2TH 2"/>
  <chapter number="3" style="c" sid="2TH 3"/>
  <para style="s1">ዱአ አኡ ጉዕመርቺንከ ጡመ እሁስ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1"/>አመኤ ኦሶ! ክዕኔቤቾን እኮሀንገን ቀርች ላገት ደዕልት አልባዕልቶተለከ ኬዕምኚን ቶገሙ ደእቶተ ኒተኔሃ ዱአ አዕዬ። <verse eid="2TH 3:1"/><verse number="2" style="v" sid="2TH 3:2"/>ህትን መናን ጉዕማንን አመዕነቱ ሄእበቤቺሃ ሾከለከ ሂለ መኒች ጡምኖተ ዱአ አዕዬ።<verse eid="2TH 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 3:3"/>ጠዉ እኮጎሬ ጠረኝሰኖህዕኔለከ ሸይጣኒች አገረኖህዕኔ ቀርቹ አመዕነሞእሃን። <verse eid="2TH 3:3"/><verse number="4" style="v" sid="2TH 3:4"/>አዘንዛንክዕኔ ጠወ ቴሁ እኮ ከ ኤተሩ አቴነንተገ ቀርቺን አመዕንናንክዕኔ።<verse eid="2TH 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 3:5"/>ቀርቹ ቀልብክዕኔ መገን ኢተተ ደጎኖተለከ መሲህ አታዕሉ ደጎኖተ አዎንሱንክዕኔ።<verse eid="2TH 3:5"/></para>
  <para style="s1">ሆጉተ አኡ ሀስሰኖሃ እሁስ</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6"/>አመኤ ኦሶ! ኒች ተማርቴንተ ትምርቲን እሁዕነ ሆጉተ ኢትበ አመዕናንቺች አዬቺሁ አደ እኮኖተ ቀርቹሃ መሲህ ኢስ ሱዕሚን አዘንዛንክዕኔ። <verse eid="2TH 3:6"/><verse number="7" style="v" sid="2TH 3:7"/>ነኡ ክዕኔቤቾን ሄዕኖም ወክት ዋንክዕላመተ እሁ ሆጉኔ አዕኑሁ ደጌነንተቤቺሃ ኔሳሃ አጉዴን ሄኡ ሀስሰኖህዕኔገ ደጌነንተ። <verse eid="2TH 3:7"/><verse number="8" style="v" sid="2TH 3:8"/>አዬ አሌኒ እጅነተ እንካምበእገ ሀንከዕርተለከ በራሃ አጰመን ሆጉተ አዕነን ሄዕኖም ቤሉ አዬቺ ጣብተ ጠለዕለ እንቶምበአ። <verse eid="2TH 3:8"/><verse number="9" style="v" sid="2TH 3:9"/>ሁኩንን አዕኑ ኒ ምሳልተ አዎንቶኖተ ይኒት ቤሉ ሁኩን ኔሳሃ ሀዕለንሸ ደእኖተ መብትት ሄኡዕናኔ ፈንቅትበአ። <verse eid="2TH 3:9"/><verse number="10" style="v" sid="2TH 3:10"/>መሰንትስ ነኡ ክዕኔቤቾን ዮም ወክት «ሆጉተ አሲሃ ኢትቡ መንቹ እቱንከ» ይን ከ ትዛዝ ኣስኖንክዕኔ እቅ። <verse eid="2TH 3:10"/><verse number="11" style="v" sid="2TH 3:11"/>መሰንትስ መት-መቱ ሆጉተ አሲሃ ኢትቡ መኑ በላንከክዕኔ ሄኡሰ ሞጮጭኖም፤ እሰን ኣግስበሰ ጠዋን ኣገን መቱርቹሃ አቱዕነ ሄኣእራን። <verse eid="2TH 3:11"/><verse number="12" style="v" sid="2TH 3:12"/>ህትኔ መነ ረጀይት ሆጉተ አተን ገይሰ እቸተ እቶተ ቀርቹሃኔ መሲህ ኢስ ሱዕሚን አዘንዛንሰ፤ ሸንዛንሰ።<verse eid="2TH 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 3:13"/>አመኤ ኦሶ! አዕኑ እኮጎሬ ጡመ ሆጉተ አቶኖተ «ቆንዶድኖም» ይቶኖቼ።<verse eid="2TH 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TH 3:14"/>ተን ዳብዳቤን ክዕኔኤሃ ኩልኖም ሸዘነተ ሞጮጭቡ መንቹ ሄዕዮ ጎሬ ህትናሙ መንቹ አጥራመቴን ደጌ፤ እስን ሙሎተ እሲን ደቀንቶኖቼ። <verse eid="2TH 3:14"/><verse number="15" style="v" sid="2TH 3:15"/>ጠው እኮጎሬ አመቤትገ ኡሙዕርዬስ ቤሉ ዲንገ አቴን ለኦኖቼስ።<verse eid="2TH 3:15"/></para>
  <para style="s1">መጨረሽ ወገሬት</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16"/>ወገሬት ቀርቹ ገውንኩስ ጉዕመ ወክት ጉዕመ ጠዋንን ወገሬት ኣሱንክዕኔ፤ ቀርቹ ጉዕሚንከክዕኔ ሜጡበ እሁን።<verse eid="2TH 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17"/>ከ ወገሬት ገይኤ አንጋን ከተቦንክዕኔሁ አኔት ጳዉሎሴት፤ አን ሶኮም ዳብዳቤን ጉዕማንን ደገንታ መላት ተኒት፤ ከተባሚንኩ ህትጎታን።<verse eid="2TH 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2TH 3:18"/>ቀርቹሃኔ መሲህ ኢስ ኣስቱት ክዕኔን ጉዕሚንከክዕኔ ሜጡበ እኩን።<verse eid="2TH 3:18"/></para>
  <chapter eid="2TH 3"/>
</usx>
