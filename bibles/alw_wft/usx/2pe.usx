<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2PE" style="id">- HALABA NEW TESTAMENT</book>
  <para style="h">ለንክ ጴጥሮስ</para>
  <para style="toc1">ጴጥሮስ ከተቦሃ ለንክ ሶህኑተ</para>
  <para style="toc2">ለንክ ጴጥሮስ</para>
  <para style="toc3">2 ጴጥ.</para>
  <para style="mt1">ጴጥሮስ ከተቦሃ</para>
  <para style="mt2">ለንክ ሶህኑተ</para>
  <para style="imt1">ኣጉስ</para>
  <para style="ip">ለምቅ ሶቀማንቾ ጴጥሮሴ ሶህኑት ከተበንቶኢሁ አደደ ቤቾን ሄኣ ዎዕኔ ዘማን አመዕናኖታት። ሶህኖስ ቡዕለ እኮ ሰውቱ ክዝብ አስተማረ ሂለ ሆጉተለከ እሰ ትምርት መሳን ኬዕዮ ሂለ ሆጉሰ ግቡሃን። ኬኦ ኦርሻተ መለ እሀኖሁ ኢሰ እሌንከሰ ለኦእሩለከ ተማርሰን መጫንከሰ ሞጮጭቶ መኑ ተማርስቶ ትምርት መሳን መገንለከ ቀርቾ መሲህ ኢስተኔሃ ሀንቅ ኤንኬዕኑ ደኡሃን። ከተቦሲሁ በትሽ ጠረኝሾሁ «መሲሁ ፈንቀል አሜተኖበአ» የኖ ክዝብ ትምርቲች አገዕርተኔሃት፤ ህካንን ለሊሽ ጠወአን «መሲህ ፈንቀል አሜቱ ዱንከኖሁ መገኑ መኑ ጉዕሙንኩ ጩቢችስ ፈንቀሎታት ቤሉ አዪሁ በኦተ ሀሰኖበእቤቺሃት» የኖ።</para>
  <para style="iot">መጻፉስ አፎሃ</para>
  <para style="io1">ኣጉስ <char style="ior">(<ref loc="2PE 1:1-2">1፥1-2</ref>)</char></para>
  <para style="io1">አመዕናኖ ገአሙ <char style="ior">(<ref loc="2PE 1:3-21">1፥3-21</ref>)</char></para>
  <para style="io1">ክዝብ አስተማረተ <char style="ior">(<ref loc="2PE 2:1-22">2፥1-22</ref>)</char></para>
  <para style="io1">መሲህ ፈንቀል አሜቱስ <char style="ior">(<ref loc="2PE 3:1-18">3፥1-18</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="2PE 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1"/>መሲህ ኢስ ካዲንቹለከ አሳቤቹ እኮም ስሞን ጴጥሮሴች መገኑኔለከ ጡምሳንቾሃኔ መሲህ ኢሲን ደገመኖ ፈይመ መሳን ነኡ ደእኖም አመዕነትገ ዮ ከበጀሞ አመዕነት ደእቴንተሀኑኡተ፤<verse eid="2PE 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2"/>መገኑለከ ቀርቹኔ ኢሰ ደጊን ኣስቱትለከ ወገሬቱሁ በተኡንክዕኔ።<verse eid="2PE 1:2"/></para>
  <para style="s1">መገኑ መነ ገኡስለከ መጠሩስ</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3"/>ኬዕምኚንለከ ጡምማን ገኤኔ እሱ ደንጎንስቤቺሃ እስ መገኑ እህስ ዎልቃንተስ ሄኢሃለከ ጡመ ሄኢን ሄዕኖተ ሀስሰኖርቹ ጉዕመንከ ኣስዮኔ። <verse eid="2PE 1:3"/><verse number="4" style="v" sid="2PE 1:4"/>ኬዕምኚንከስለከ ጎደበ ላፍማን ከበጀሞ ዋጉ ዮስለከ አበ ሎረ እኮ ተብሴ ላገተ ደእኖም፤ እሰ አዲን አዕኑ ከን ኣዱንያ አሌን ዮ ሂለ ሄዕላቻች ፉሸእቴን መገን እህ ሃል ቤቀማኑተ እኬነንተ። <verse eid="2PE 1:4"/><verse number="5" style="v" sid="2PE 1:5"/>ከን መሳን ከኒች ዎሮን ዮ ጠዉ በርገሞህዕኔተ ጠረኝዬ፦ አመዕነት አሌን ጡምመተ፥ ጡምመ አሌን ኤንኬዕኑ፥ <verse eid="2PE 1:5"/><verse number="6" style="v" sid="2PE 1:6"/>ኤንኬዕን አሌን ገው አገዕሩ፥ ገው አገዕር አሌን አታዕሉ፥ አታዕል አሌን ጡመ ሃሊን ሄኡ። <verse eid="2PE 1:6"/><verse number="7" style="v" sid="2PE 1:7"/>ጡመ ሃሊን ሄእ አሌን አመኦሶ ኢተቀንሸ ኢተቀሙ፥ አመኦሶ ኢተቀንሽ አሌን ኢተተ በርግዬ፤ <verse eid="2PE 1:7"/><verse number="8" style="v" sid="2PE 1:8"/>ሁኩሩ በተእ ሄኦህዕኔጎሬ ቀርቹኔ መሲህ ኢሰ ደጎኖተ ደግለልቴንበረ አቶቱ ዮህኔበእረ እኬነንተበእገ አገርታህዕኔ። <verse eid="2PE 1:8"/><verse number="9" style="v" sid="2PE 1:9"/>እኮጎሬሁ ሁኩሩ ዮሰበእሩ ቄዕራሻን ዮርቹ ለኦተ አታልባ ቆቀሃን፤ ዎኔስ ጩቢች ነጠ እሁስ ሀቦኡ።<verse eid="2PE 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10"/>ህካን እኮቤቺሃ አመኤ ኦሶ! ገአሙክዕኔለከ መጠረሙክዕኔ አጥራመቲሃ በትሴን ሀሴነንተረ እኬ፤ ካን አቴንተጎር ሆሮ ቆዕልቴነንተበአ። <verse eid="2PE 1:10"/><verse number="11" style="v" sid="2PE 1:11"/>ከን ሃሌን ዘላለሚሃ ሄአኖ ቀርቹሃኔለከ ጡምሳንቹሃኔ መሲህ ኢስ ዎምነቴን ኣጌነንተገ ዊመ ዊሚን ኣሰመኖህዕኔ።<verse eid="2PE 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12"/>ከ ጠወ ደጌንተጎሬ፥ አፌንተ ሀንቂን ጠረኝቴን ሄኤንተ ጎሬ እሰተ ክዕኔሃ ቃግሱ አጉራምበአ። <verse eid="2PE 1:12"/><verse number="13" style="v" sid="2PE 1:13"/>ዱካንገ ድጀመኖ ከን ጅስሚንከኤ ፎሊን ዮም ጌሳን ክዕኔተ ጉዕመ ወክት ቃግሱ ሀንቅ አጉጅ ለልዮኤ። <verse eid="2PE 1:13"/><verse number="14" style="v" sid="2PE 1:14"/>ቀርቹኔ መሲህ ኢስ ለሊሾኤ ሃሊንን ዱካንገ ድጀመኖ ጅስሚችኤ ደዕል ሬሆን አደ እሃም። <verse eid="2PE 1:14"/><verse number="15" style="v" sid="2PE 1:15"/>አን ቴሱ አጰማምቲሁ ሬሆን አደ እኮሚች ኤተሮን ከ ጠወ ጉዕመ ወክትንከ ቃግሱ አታልቴነንተጋት።<verse eid="2PE 1:15"/></para>
  <para style="s1">መሲህ ኬዕምኝተኔሃ ለኦ ምስክር</para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16"/>ቀርችኔ መሲህ ኢስ ዎልቀስለከ ፈንቀል አሜትስተኔሃ ኩልኖክዕኔ ወክት ገዉኔ ኬዕምኝስ እሌንከኔ ለዕን መሰከርናምረ ቤሉ መን ተንኮን ያዴመ ማቁተ አዎኒበአ። <verse eid="2PE 1:16"/><verse number="17" style="v" sid="2PE 1:17"/>«እሲን ተሽ የኖኤ ኢታም ቤቱኤ ከኒት» ይታ ላገት ከበጀሞ መገኒች አሜቶስ ወክት አና መገኒች ኬዕምኝለከ ሎርመተ ኣኤእ። <verse eid="2PE 1:17"/><verse number="18" style="v" sid="2PE 1:18"/>እሲን ሜጡበ ጠሊለ ቆተ አሌን ሄዕኖም ወክት ህካን ሰሜች አሜቶ ላገተ ነኡ ገዉንኩኔ ሞጮጭኖም።<note caller="-" style="x"><char style="xo" closed="false">1፥17-18 </char><char style="xt" closed="false"><ref loc="MAT 17:1-5">ማቶ. 17፥1-5</ref>፤ <ref loc="MRK 9:2-7">ማር. 9፥2-7</ref>፤ <ref loc="LUK 9:28-35">ሉቃ. 9፥28-35</ref>።</char></note><verse eid="2PE 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19"/>ኩን ጉዕሙንኩ ነብያኑት ጠወኦኢሁ ሀንቅ እሁስ ተሬገጥሲስ ኩልታኔ፤ ህካን እኮቤቺሃ ቱንስቾን ዮ መብረቲሃ አገዕርቴነንተሀንገን ሱጵት ኣጎተ ኢለ ሶዝ ቡዕራትቹት ቀልቤንከክዕኔ ለልቶተ ኢለ ነብያከት ጠወኦ ላገተ ጥሽ አቴን አገዕርዬ። <verse eid="2PE 1:19"/><verse number="20" style="v" sid="2PE 1:20"/>ጉዕመርቺችን ሄጭቴን ሰውዩ ሀስሰኖህዕኔሁ ጠሊለ መጻፋን ዮ ሀከ ራገሃ አዪሁ ገይስ ሰውቲን ፈሰሮተ አታልባሃ እሁሲት።<note caller="+" style="f"><char style="fqa" closed="false">ሀኩ መንቹሁ ገይስ ሰውቲን ፈሰሮተ አታለኖበአ፦ </char><char style="ft" closed="false">የኖሁ «ሀኩ ነብዬቹሁ ገይስ ቀልቢን ጠወዕዮበአ» የኖ ሰውት ኣሶተ አታለኖ።</char></note> <verse eid="2PE 1:20"/><verse number="21" style="v" sid="2PE 1:21"/>ሀኩ ራጉሁ መን ሰውቲን ሆሮ አሜቾበአ፤ ጠዉ እኮጎሬ ራጉ መገን አያኒን አዎንቶ መኑ መገኒች ቶግ ጠወኦእሃን።<verse eid="2PE 1:21"/></para>
  <chapter eid="2PE 1"/>
  <chapter number="2" style="c" sid="2PE 2"/>
  <para style="s1">ክዝብ አስተማረተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1"/>ጠዉ እኮጎሬ ከኒች ብርተ ክዝብ ራጋኑት ኡመት በላን ሄኦሀንገን ህትን ክዕኔ በላኒ ክዝብ አስተማረት ሄኣአ፤ እሰን ቤሱ ኤበኖ ክዝብ ትምርት ሎድአት ኣግሳአ፤ እሰ ቤሱ ኤበኖ ክዝብ ትምርት ማጥቶን አልባዕለኖገ አታአ፤ ዎዦሰ ቀርቹንከ ለገእ ደዕለንሰኖ በኡ አሌሰ ኤባአ። <verse eid="2PE 2:1"/><verse number="2" style="v" sid="2PE 2:2"/>ከን ሃሌን ልግቡሰ እሰ ብልኝ ዎቃሃ አዎንታአ፤ እሰ አቶ ሂለ ሆጎች ኬዕዮሀኒን ሀንቅ ዎቆሁ ቦሮረመኖ። <verse eid="2PE 2:2"/><verse number="3" style="v" sid="2PE 2:3"/>ሁኩ ክዝብ አስተማረት ብሪሃ በትበት ዪች ኬዕዮሀኒን ገዉሰ ቅጥአቶ ሄሱተ ጠወአን ቦጋህዕኔ፤ አበ ዘማኒች ብርተ ጀመር ፍርዱ ቅጥይዮሰ፤ በኡ ሀንቂንከ አገረኖሰ!<verse eid="2PE 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4"/>መላይከት ባሽን ጩብ አቶ ወክት መገኑ መረርሲጩዕናንሰ ቱንስቾን ጥዕላሸ በዊ ኣዜን ኡሱረንት ፍርድ በር ኢለ አገርቶተ አዛብ አደ ዋሽ ኡጄሰ፤ <verse eid="2PE 2:4"/><verse number="5" style="v" sid="2PE 2:5"/>ህትን ፈይመ ዱዱብሳንቹ እኮ ኑሃ ዎሎ ለመለ መኒን ሜጡበ ጡምሽ መገኒሃ ሰገድቡ መኑ ሄኦ ኣዱንያ አሌን ቤስ ዋሃ ኤቦ ወክት ዎዕኔ ኣዱንያ አል አሙዥ መረርሲጭዮበአ።<note caller="-" style="x"><char style="xo" closed="false">2፥5 </char><char style="xt" closed="false"><ref loc="GEN 6:1-7:24">ክል. 6፥1—7፥24</ref>።</char></note> <verse eid="2PE 2:5"/><verse number="6" style="v" sid="2PE 2:6"/>ህትን መገኒሃ ጠገንትበረ ጉዕመንከ ቀጠኤኖ ምሳልተ እኮተ ሰዶምለከ ጎሞር ከተመ ጠበሩ እካኢሃ ኢለ ቡስ በኣገ ፈረጆሰ፤<note caller="-" style="x"><char style="xo" closed="false">2፥6 </char><char style="xt" closed="false"><ref loc="GEN 19:24">ክል. 19፥24</ref>።</char></note> <verse eid="2PE 2:6"/><verse number="7" style="v" sid="2PE 2:7"/>ጠዉ እኮጎሬ ሴረ አገርትቡሀኑኡ ቢልኝ ሆጎን ኦርጨቀመን ሄዕዮ ፈየ ሉጠ ጡምሾስ፤<note caller="-" style="x"><char style="xo" closed="false">2፥7 </char><char style="xt" closed="false"><ref loc="GEN 19:1-16">ክል. 19፥1-16</ref>።</char></note> <verse eid="2PE 2:7"/><verse number="8" style="v" sid="2PE 2:8"/>ሁኩ ፈዩ መንቹ በለሰ ሄዕዮ ወክት በሬን በሬን ለአንለከ ሞጮጨን ሄዕዮ ቢልኝ ሆጎንከሰ ፈዩ ነብሶስ ጨነቀመኖ እቅ። <verse eid="2PE 2:8"/><verse number="9" style="v" sid="2PE 2:9"/>ቴሱ ኩን ጉዕሙንኩ ህት እኮች ቀርቹ እሲሃ ጠገንተን ሄኣእረ ፌተናች ጡምሰኖሰገ ጩበኛኑንተ ሀት አዕይ ቀጠአኖጎሬለከ ፍርድ በሬተ ሀት አዕይ አገረኖሰገ ደገኖ ዩሃን። <verse eid="2PE 2:9"/><verse number="10" style="v" sid="2PE 2:10"/>በትሽን ከ ሂለ ማል ሄዕላቸተ አዎንታእረለከ መገን ሹምነቱ ህንቃእረ ፍርዱ አገረኖሰ፤</para>
  <para style="p" vid="2PE 2:10">ሁኩ ክዝብ አስተማረት መለልታእረለከ ቦንታእረ እኮቤቺሃ ሰሜ ሹምነቱ ዮሰረ ቦሮሩ ዋጅታበአ። <verse eid="2PE 2:10"/><verse number="11" style="v" sid="2PE 2:11"/>መላይከት እሳች ዎልቃመተለከ ጠረኛኑተ እኮጎሬሁ ቀርች ብሬን እሰ አሌን ቦሮዕረንሺን ዊንቶ ላጋን ክሰ ሆንጠህሳሰበአ። <verse eid="2PE 2:11"/><verse number="12" style="v" sid="2PE 2:12"/>እኮጎሬ ኩ ክዝብ አስተማረት አጥራመት ደግበርቹ ቦሮርታአ፤ እሰ ዎሻዳን ኣግሃለከ ሬቶተ ከለቀንቶ ሃሊን ሄኣ ቡዕሉ ዮስበእ ግዝጋት፤ ሁኩ ግዙ በአኖሀንገን እሳሁ ጡበንከ በኣአ።<verse eid="2PE 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2PE 2:13"/>ሾክመተ አቶቤቺሃ ዋገሰ ደእታአ፤ እሰ ሙንዲኑት ቡሰኖ አሮን ሰከሩሃለከ ጌሱ ዮበእሃ ጨፈሩ፤ ህከን ጌሱ ዮበእ ጨፈሮን ክዕኔን ሜጡበ ድግሲሃ ገኤኖ ወክት ጣንሰኖ ማል ሆጎንተሰ ኮፍ ይታእረለከ ሙልሲሳእረ። <verse eid="2PE 2:13"/><verse number="14" style="v" sid="2PE 2:14"/>ጩብ አኢች አጉርትቡ ዝናን ዊንቶ እልት ዮሰ፤ ጩብ አት ሆሮን ሰገብሰ ሙዕርታበአ፤ አመዕነቶን ጠረኝት ኡርትበ መነ ሉሲሳአ፤ ዱንያተ በትበት ይታአ፤ እሰን ቦሮረንቶእረ። <verse eid="2PE 2:14"/><verse number="15" style="v" sid="2PE 2:15"/>እሰ ሀንቅ ዎቃሃ አጉርት በኦኡ፤ ሂለ ሆጉተ አኢን ደገመኖ ዱንየተ ኢተኖ ቢኦሬ ቤት በለዓሜ ዎቃሃ አዎንት ሉሶኡ። <verse eid="2PE 2:15"/><verse number="16" style="v" sid="2PE 2:16"/>ጠዉ እኮጎሬ በለዓም ጩብስተኔሃ ዎቀሰሞኡ፤ ጠወኡ አታልትቡ ሀሩቹት መን አፎን ጠወእ በርገጋሽገ ዮ ነብዬች ሆጉተ ኡርሶኡ።<note caller="-" style="x"><char style="xo" closed="false">2፥15-16 </char><char style="xt" closed="false"><ref loc="NUM 22:4-35">ዘኁ. 22፥4-35</ref>።</char></note><verse eid="2PE 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17"/>ሁኩ መኑ ዉሁ ዮበእ ቡቆገ ዮእረ፤ ህትን ኡንጉሉሎን ሀንበለንት መርታ ጉንጄገ ዮእረ፤ ጭልመ ቱንስቹ አገረኖሰ። <verse eid="2PE 2:17"/><verse number="18" style="v" sid="2PE 2:18"/>ሉጨንሽ ኣዜን ሄኣ መን በሊች ፉሸእት አሜቶኢች ልግብ ዱንክትቡ መነ ተሰ እኮ ቦን ላገተ ጠወአን ማል ሄዕላቻንለከ ዝነተ አኢን ጣንስት ለንኪሃ ፈንቀሽት ጩብቤቹ አዎንስታሰ። <verse eid="2PE 2:18"/><verse number="19" style="v" sid="2PE 2:19"/>«እሰ ገውንኩሰ ሰዎልድማን ፉልቴነንተ» ይተን ተብሳ አታሰ፤ መኑ ቄለመኖረ ቄሎሀኒሃ ሮስ እክ ጠገመኖቤቺሃ እሰ ገዉንኩሰ ጩብተ ሮሰ። <verse eid="2PE 2:19"/><verse number="20" style="v" sid="2PE 2:20"/>ቀርቹኔለከ ጡምሳንቹኔ መሲህ ኢሰ ደግ ከን ኣዱንያ አል ንጃሲች ፉሸእቶች ኤተሮን ፈንቀልት ህከን ንጃሲን አፈንት ቄለንታረ ዎዕኔች በትሽ ኤተር ሄኡሰ ባሰ ሂለ እሀኖ። <verse eid="2PE 2:20"/><verse number="21" style="v" sid="2PE 2:21"/>ፈየ ዎቃሃ ደጎኢች ኤተሮን ኣሰሞሰ ጠሊለ ትዛዚች ኤተሩ ፈንቀልታሀኒች ፈየ ዎቃሃ ደጉዕና ፈቆ እቃን ቆሀኖሰ እቅ። <verse eid="2PE 2:21"/><verse number="22" style="v" sid="2PE 2:22"/>«ዉስቹ ሆቅ አዕዮሲሃ እቶተ ሆቅትስቤቹ ፈንቀለኖ» ህትን «ቦክት ኣዕልቶኢች ኤተሮን ፈንቀልት ጭቃን ብርቂቅታአ» ይታ ምሳልት እሰ አሌን ሀንቅ እኮኡ።<note caller="-" style="x"><char style="xo" closed="false">2፥22 </char><char style="xt" closed="false"><ref loc="PRO 26:11">ምሳ. 26፥11</ref>።</char></note><verse eid="2PE 2:22"/></para>
  <chapter eid="2PE 2"/>
  <chapter number="3" style="c" sid="2PE 3"/>
  <para style="s1">ቀርቹ ኢስ ፈንቀል አሜቱስ</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1"/>ኢ ጀላ! ኩ ቴሱ ከተቦንክዕኔሁ ለንክተ ሶህኑ፤ ለሙንከስ ሶህኑተ ከተቦንክዕኔሁ ከ ጡመ ሰውት ጡመገ ሰው ይቴነንተገ ጠረኝሶህዕኔታት። <verse eid="2PE 3:1"/><verse number="2" style="v" sid="2PE 3:2"/>ከኒች ብርተ ጠሊላኑት ነብያከት ጠወኦ ላገትለከ ክዕኔ አሳበ መሳን ደእቴንተ ቀርችኔለከ ጡምሳንችኔ ትዛዝ ቃጎኖተ ሀሳም። <verse eid="2PE 3:2"/><verse number="3" style="v" sid="2PE 3:3"/>ጉዕሚችን ሄጭቴን ካን ሰውይዬ፤ ኤተር በሬን ቀለዳሩለከ ሂለ ሄዕላቸሰ አዎንታሩ አሜታአ፤<note caller="-" style="x"><char style="xo" closed="false">3፥3 </char><char style="xt" closed="false"><ref loc="JUD 1:18">ይሁደ 18</ref>።</char></note> <verse eid="2PE 3:3"/><verse number="4" style="v" sid="2PE 3:4"/>እሰን «ቀርቹ ኢስ አሜተኖ ዬኖ ተብሶሁ ኣሰሞእቅበእንዶ? ህከረ ሀከቤቹ ዮኡ? ዎዕኔ ዘማን አናከኔ ሬቶ ወክቲች ኬሽ ጉዕሙንኩርቹ ክልቀቲች ብርንተ ሄዕዮጋት» ይታአ። <verse eid="2PE 3:4"/><verse number="5" style="v" sid="2PE 3:5"/>ሁኩ መኑንኩ አበ ዘማኒች ብርተ ሰሞሁ መገን ላጋን ከለቀሙስ ኡለንት መክቶኢሁ ዊችለከ ዊን እሁስ ጦንበ አት ካዳኣ።<note caller="-" style="x"><char style="xo" closed="false">3፥5 </char><char style="xt" closed="false"><ref loc="GEN 1:6-9">ክል. 1፥6-9</ref>።</char></note> <verse eid="2PE 3:5"/><verse number="6" style="v" sid="2PE 3:6"/>ህከ ወክት ኣዱንያ አሉ ዊን አጉዕመም በዕዮ።<note caller="-" style="x"><char style="xo" closed="false">3፥6 </char><char style="xt" closed="false"><ref loc="GEN 7:11">ክል. 7፥11</ref>።</char></note> <verse eid="2PE 3:6"/><verse number="7" style="v" sid="2PE 3:7"/>እኮጎሬ ቴሱ ዮ ሰሞለከ ኡለት መገኒሃ ጠገንትቡ መኑ በኣ ፍርድ በር ኢለ ጊራተ አገረንት አገዕርታአ።<verse eid="2PE 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8"/>ኢ ጃለ! መገን ቤቾን መቱ በሩ ኩሜ ዘማንገ እሁስለከ ኩሜ ዘማኑ መቶ በሬገ እሁስ ከ መቱ ጠወ ሀቦኖቼ።<note caller="-" style="x"><char style="xo" closed="false">3፥8 </char><char style="xt" closed="false"><ref loc="PSA 90:4">መዝ. 90፥4</ref>።</char></note> <verse eid="2PE 3:8"/><verse number="9" style="v" sid="2PE 3:9"/>መት-መቶ መኒሃ አጉደኖሰገ ቀርቹ ጠወዕዮ ተብሴ ላገተ ዊንሾተ ዱንከኖበአ፤ ጠዉ እኮጎሬ መኑ ጉዕሙንኩ ጩብ ቶበቶተለከ አዪሁ በኦተ ሀስበቤቺሃ ክዕኔተኔሃ አታዕለኖ።<verse eid="2PE 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10"/>ጠዉ እኮጎሬ ቀርች በሩ ሞጋንችገ ድንገቴ አሜተኖ፤ ህከ በር ሰሞሁ ሎረ ላጋን ህገኖ፤ ሰሜ ክልቀቱ ጉዕሙንኩ ጊራን ቡብ በአኖ፤ ኡለትለከ አሌሴ አኤመርቹ ጉዕሙንኩ ቡበኖ።<note caller="+" style="f"><char style="fqa" closed="false">ኡለትለከ አሌሴ አኤመርቹ ጉዕሙንኩ ቡበኖ፦ </char><char style="ft" closed="false">የኖሁ መት መቶ ሉህ ክታባን ኡለትለከ አሌሴ አኤመርቹ ጉዕሙንኩ ዋቅ ይ ኑር እክ ለለኖ» የኖ።</char></note><note caller="-" style="x"><char style="xo" closed="false">3፥10 </char><char style="xt" closed="false"><ref loc="MAT 24:43">ማቶ. 24፥43</ref>፤ <ref loc="LUK 12:39">ሉቃ. 12፥39</ref>፤ <ref loc="1TH 5:2">1 ተሰ. 5፥2</ref>፤ <ref loc="REV 16:15">መና. 16፥15</ref>።</char></note> <verse eid="2PE 3:10"/><verse number="11" style="v" sid="2PE 3:11"/>ቴሱ ኩ ጉዕሙርቹንኩ ከን ሃሌን በአኖሃ እኮች አዕኑ ጠሊልማን መገኑ አጉዲን ሄኡ ሀስሰኔህዕኔበእንዶ? <verse eid="2PE 3:11"/><verse number="12" style="v" sid="2PE 3:12"/>ቴሱ መገን በሩ አሜቱስ ሱንቴን አገርቴነንተረለከ ደዕል አሜቶተ አቴነንተረ እቅ፤ ህከ በር ሰሞሁ ጊራን ቡብ በአኖ፤ ክልቀቱንኩ ጊረ ፋራን ሺለኖ፤ <verse eid="2PE 3:12"/><verse number="13" style="v" sid="2PE 3:13"/>ጠዉ እኮጎሬ ነኡ እስ ኣሴ ተብሴ ሃሊን ፈይመ ሆጎተ ኡርታ ሃዕሮ ሰማለከ ሃዕሮ ኡለተ አገርናም።<note caller="-" style="x"><char style="xo" closed="false">3፥13 </char><char style="xt" closed="false"><ref loc="ISA 65:17">ኢሳ. 65፥17</ref>፤ <ref loc="ISA 66:22">66፥22</ref>፤ <ref loc="REV 21:1">መና. 21፥1</ref>።</char></note><verse eid="2PE 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14"/>ህካን እኮቤቺሃ ኢ ጃላ! ኩ ጉዕሙንኩ ጠዉ እሀኖ በር አገዕር አሌን ዮንተረ እኬንተቤቺሃ ቀርቹ ቀነጤኖርቹ ህከረንገ ኩሌኖርቹ ዮበኢሃ እኬን ወገሬቲን ደጎህዕኔተ ጠረኝቴን ሄዕዬ። <verse eid="2PE 3:14"/><verse number="15" style="v" sid="2PE 3:15"/>ቀርችኔ አታዕሉ አዕኑ ጡምቶኖተ እሁስ ደጌ፤ ኢተሞ አመኔቤቱ ጳዉሎስ ኣሰሞስ ሀይማን ከተቦህዕኔሁ ከኒት። <verse eid="2PE 3:15"/><verse number="16" style="v" sid="2PE 3:16"/>እስ ከን ጠውተኔሃ ከተበንቶ ሶህኖንከስ ጉዕማንን ከን ሃሊን ከተቦኡ፤ ከተበንቶ ሶህኖ ኣዜን መት-መቱ አጥራመቲሃ ኦርሰኖ ጠዉ ዮኡ፤ ኤንኬዕኑ ሆፈዕዮሰሩለከ ወለ እኮእሩ ዎልተ ጠሊለ መጻፈተ ሾክሳሀንገን ህከ ጠወሃ ሾክሳኢት፤ ህካን አታኢሁ በኢሃት። <verse eid="2PE 3:16"/><verse number="17" style="v" sid="2PE 3:17"/>ቴሱ አዕኑ ኢ ጃላ! ከ ጠወ ዎዕናንከ ደጌነንተቤቺሃ ሾከ መን ሉጨንሺን አገንቴን ጠረኝቴን ኡርቴንተቤቺች ኡቤነንተበእገ አገዕሪዬ። <verse eid="2PE 3:17"/><verse number="18" style="v" sid="2PE 3:18"/>ጠዉ እኮጎሬ ቀርቹሃኔለከ ጡምሳንቹሃኔ መሲህ ኢስ ኣስቶንለከ እሱ ደጊን ነጵዬ፤ እሲንከ ቴሁ ዘላለሚሃ ኬዕምኙ እሁን፤ ኣሚዕን!<verse eid="2PE 3:18"/></para>
  <chapter eid="2PE 3"/>
</usx>
