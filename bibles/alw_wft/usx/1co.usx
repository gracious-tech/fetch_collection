<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- HALABA NEW TESTAMENT</book>
  <para style="h">ዎኔ ቆሮንቶስ</para>
  <para style="toc1">ሶቀማንቾ ጳዉሎሴ ዎኔ ሶህኑተ ቆሮንቶስ መኒሃ</para>
  <para style="toc2">ዎኔ ቆሮንቶስ</para>
  <para style="toc3">1 ቆሮ.</para>
  <para style="mt1">ሶቀማንቾ ጳዉሎሴ ዎኔ ሶህኑተ</para>
  <para style="mt2">ቆሮንቶስ መኒሃ</para>
  <para style="imt1">ኣጉስ</para>
  <para style="ip">ጳዉሎስ ቆሮንቶስ መኒሃ ከተቦ ዎኔ ሶህኑት ከተበንቶኢሁ ቆሮንቶሳን ዱእ ምኒ ኣዜን አመዕነት ሄእ አሌን ኬዕዮ ኦርሻተ ሂሬኖ ዎቃሃ ደግሲስሃ ሰውዪኒት። ህከ ወክት ቆሮንቶስ ከተሙ ግሪክ ሀዕኑረ ከተመ እህችስ አበ አካይያ ዬኖ ሮም ባዲሃ ወኔሃ ከተመ እቅ። ሁኩ ከተሙ ሎሩ ንግዱ፥ አደዱ ሴሩ አልባዕሌቤቺሃ ሂሉ ኮፍአአኖ ጠዉ፥ አደደ ሀይማኖቲን ደገሞሃ ቤቹ እቅ።</para>
  <para style="ip">ሶቀማንቹ በትሽ መገኑ ኡጬኖ ዱእ ምኒ ኣዜን ሄኦ አደዶመተኔሃ፥ ሂለ ኮፍአአኖ ጠውተኔሃ፥ ዝነተ አዕለከ ጎጆሃ እህተኔሃ፥ አመዕናኖ ሴርተኔሃ፥ ጠሊለ አያን ኣስቶተኔሃለከ ሬሆች ኬኢተኔሃት እቅ፤ ህትን ሶቀማንቹ ተሽት ላገተ ከን ጠዕምቶ አሌን አዕይ አገዕሪን ሆንጠህሰኖ።</para>
  <para style="ip">«ኢተቀሙ» መገኑ መን እላተ ኣሴ ኣስቶች በተአኖሃ እሁስ ኩለኖሁ ቶነ ሰቅ ፎሎጩ ከን መጻፍ ኣዚች በትሽ ደገሞእሃን።</para>
  <para style="iot">መጻፉስ አፎሃ</para>
  <para style="io1">ኣጉስ <char style="ior">(<ref loc="1CO 1:1-9">1፥1-9</ref>) </char></para>
  <para style="io1">ዱእ ምነ በላን ኬኦ አደዶመተኔሃ <char style="ior">(<ref loc="1CO 1:10-4:21">1፥10—4፥21</ref>) </char></para>
  <para style="io1">ኮፍአአኖ ሀልለከ አበሮስ ሄኡ <char style="ior">(<ref loc="1CO 5:1-7:40">5፥1—7፥40</ref>) </char></para>
  <para style="io1">አመዕናኖለከ አመዕንበ መንተኔሃ <char style="ior">(<ref loc="1CO 8:1-11:1">8፥1—11፥1</ref>) </char></para>
  <para style="io1">አመዕነቱለከ መገኑ ኡጬኖ ሴረ <char style="ior">(<ref loc="1CO 11:2-14:40">11፥2—14፥40</ref>) </char></para>
  <para style="io1">መሲህ ኢስለከ አመዕናኖ ሬሆች ኬእተኔሃ <char style="ior">(<ref loc="1CO 15:1-58">15፥1-58</ref>) </char></para>
  <para style="io1">ይሁድ ባዶን ሄኦ ኦርጨቀንቶ አመዕናኑተ ሀዕሉ <char style="ior">(<ref loc="1CO 16:1-4">16፥1-4</ref>) </char></para>
  <para style="io1">መጨረሸስ <char style="ior">(<ref loc="1CO 16:5-24">16፥5-24</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="1CO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1"/>መሲህ ኢስ ሶቀማንቹ እሆተ መገን ሰውቲሃ ገአሞም አን ጰዉሎሴችለከ አመኔቤቲች ሶስቴኔሴች <verse eid="1CO 1:1"/><verse number="2" style="v" sid="1CO 1:2"/>መሲህ ኢስ ጠሊለ አዕዮሀኑኡተለከ ጠሊላኑተ እኮተ መገኑ ገኤሰ ቆሮንቶስ ከተማን መገን አመዕናኖ ጭምት ዱእ ምኒሃ፥ እሰለከ ኒ ቀርቹ እኮ ቀርቹሃኔ መሲህ ኢስ ሱዕመስ ጉዕመ ቤቾን ገአንቶሀኑኡተ ጉዕሚንከ ሶኮምተ ሶህኑ።<verse eid="1CO 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3"/>አንችኔ መገኒችለከ ቀርቹሃኔ መሲህ ኢሲች ኣስቱትለከ ወገሬቱ ክዕኔሃ እሁን።<verse eid="1CO 1:3"/></para>
  <para style="s1">ጳዉሎስ መገኑ ገለትጬገ</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4"/>መሲህ ኢስ አዲን ኣሰሞህዕኔ መገን ኣስቶተኔሃ ክዕኔ መሳን አን ጉዕመ ወክትንከ መገኑኤ ገለትጫም። <verse eid="1CO 1:4"/><verse number="5" style="v" sid="1CO 1:5"/>መሰንትስ አዕኑ ጠወኤነንተ ጠዊን፥ ኤንኬዕኒን ጉዕማንን መሲህ ኢስን ጉዕመ አዲንን ቀባጣመተ እኬንታአ። <verse eid="1CO 1:5"/><verse number="6" style="v" sid="1CO 1:6"/>ህትን ነኡ መሲህ ኢስተኔሃ ኩልኖንክዕኔ ጠዉ ክዕኔ በላን ጠረኝዮኡ። <verse eid="1CO 1:6"/><verse number="7" style="v" sid="1CO 1:7"/>ህከኒች ኤተሮን ቀርችኔ መሲህ ኢስ አሜቱ አገርቴነን መገን ኣስቶች መቱርቹሁ ሆፈአኖህዕኔበአ። <verse eid="1CO 1:7"/><verse number="8" style="v" sid="1CO 1:8"/>እስን ቀርቹኔ መሲህ ኢስ ፈንቀል አሜተኖ በር ህንቄኖህዕኔርቹ ዮህዕኔበእረ እኮኖተ መጨርሸ ኢለ ጠረኝቴን ሄኤነንተገ አሰኖህዕኔ። <verse eid="1CO 1:8"/><verse number="9" style="v" sid="1CO 1:9"/>መሰንትስ ቤትንከስ ቀርቹሃኔ መሲህ ኢሲን ሜጡበ እሁ ሄኦህዕኔተ ገኤህዕኔ መገኑ አመዕነሞእሃን።<verse eid="1CO 1:9"/></para>
  <para style="s1">አመዕናኖ በላን አደዶመት ሄኡ ሀስሰኖበኢሃ እሁስ</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10"/>አመኤ ኦሶ! መቱ ጠወ ጠወኦኖተ፥ መቱ ቀልቡለከ መቱ ሰውቱ ሄኡክዕኔ ቤሉ በላንከክዕኔ አደዶመት ሄኣበእገ ቀርቹሃኔ መሲህ ኢስ ሱዕሚን ኡጫንክዕኔ። <verse eid="1CO 1:10"/><verse number="11" style="v" sid="1CO 1:11"/>መሰንትስ አመኤ ኦሶ! በላንከክዕኔ ብተት ሄኡስ ቀሎኤ ምኒ መኑ ኩሎኤ። <verse eid="1CO 1:11"/><verse number="12" style="v" sid="1CO 1:12"/>ህካን ዩ መት-መቱክዕኔ «አን ጳዉሎሴሃ» ህከረንገ «አን አጵሎሴሃ» ህከረንገ «አን ጴጥሮሴሃ» ህከረንገ «አን መሲህረ» ይቴነንታት።<note caller="-" style="x"><char style="xo" closed="false">1፥12 </char><char style="xt" closed="false"><ref loc="ACT 18:2">ሶቀ. 18፥2</ref>።</char></note> <verse eid="1CO 1:12"/><verse number="13" style="v" sid="1CO 1:13"/>መሲህ ቤሀሞእንዶ? ህትን ጳዉሎስ ክዕኔተኔሃ ሰቀለሞእንዶ? ህከረንገ ጠመቀንቴንታሁ ጳዉሎሴ ሱዕሚንትንዶ? <verse eid="1CO 1:13"/><verse number="14" style="v" sid="1CO 1:14"/>አን ቀርስጶሴለከ ጋዮሴ ቤሉ ክዕኔተ መቱክዕኔ ጠመቆምበእቤቺሃ መገኑ ገለትጫም።<note caller="-" style="x"><char style="xo" closed="false">1፥14 </char><char style="xt" closed="false"><ref loc="ACT 18:8">ሶቀ. 18፥8</ref>፤ <ref loc="ACT 19:29">19፥29</ref>፤ <ref loc="ROM 16:23">ሮሜ 16፥23</ref>።</char></note> <verse eid="1CO 1:14"/><verse number="15" style="v" sid="1CO 1:15"/>ህካን እኮቤቺሃ አዪሁ ክዕኔተ «ጳዉሎሴ ሱዕሚን ጠመቀንቴንታእረ» ዮተ አታለኖበአ። <verse eid="1CO 1:15"/><verse number="16" style="v" sid="1CO 1:16"/>ህትን እስጥፋኖሴ ምኒ መነ ጠመቆም፤ ህከን ቤሉ ዎሉ መነ ጠመቆምጎር ደጎምበአ<note caller="-" style="x"><char style="xo" closed="false">1፥16 </char><char style="xt" closed="false"><ref loc="1CO 16:15">1 ቆሮ. 16፥15</ref>።</char></note> <verse eid="1CO 1:16"/><verse number="17" style="v" sid="1CO 1:17"/>መሰንትስ መሲህ ሶኮኤሁ ተሽት ላገተ ዱዱብሶታት ቤሉ ጠመቆታትበአ፤ ዱዱብሳሚንኩ መሲህ መስቀሉ ተሰ እሀኖበእገ መን ሀይማን ደገንቶ ላጋኒበአ።<verse eid="1CO 1:17"/></para>
  <para style="s1">መሲህ መገን ሀይመተለከ ወልቀተ እሁስ</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18"/>መስቀልተኔሃ ኩሌኖ ጠዉ በኣ መኒሃ ገዊመተ እኮጎሬ ኔሳሃ ጡምናም መኒሃ መገንተ ዎልቀ።<verse eid="1CO 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="1CO 1:19"/>መሰንትስ «ሀይቾ መን ሀይመንተ ቤሳም፤</para>
  <para style="q2" vid="1CO 1:19">ኤንኬዕናሞ መን ኤንኬዕኑ ከማም» የመም ከተበሞኡ።<note caller="-" style="x"><char style="xo" closed="false">1፥19 </char><char style="xt" closed="false"><ref loc="ISA 29:14">ኢሳ. 29፥14</ref>።</char></note><verse eid="1CO 1:19"/></para>
  <para style="m">
    <verse number="20" style="v" sid="1CO 1:20"/>ህካን እኮቤቺሃ ሀይቹ መንቹ አዬት? ሕግ አስተማርቹ አዬት? ከን ኣዱንያ አሌን አጥራመች ደገኖሁ አዬት? መገኑ ከን ኣዱንያ አል ሀይመተ ገዊመተ እሀኖገ አዕዮበእንዶ?<note caller="-" style="x"><char style="xo" closed="false">1፥20 </char><char style="xt" closed="false"><ref loc="JOB 12:17">አዩ. 12፥17</ref>፤ <ref loc="ISA 19:12">ኢሳ. 19፥12</ref>፤ <ref loc="ISA 33:18">33፥18</ref>፤ <ref loc="ISA 44:25">44፥25</ref>።</char></note><verse eid="1CO 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 1:21"/>መሰንትስ መገኑ ሀይማንከስ ከን ኣዱንያ አል መኑ ገይስ ሀይማን መገኑ ደጋበእገ ሀይማን አዕዮሰ፤ ጠዉ እኮጎሬ ገዊመገ ዎለአመኖ ነኡ ተማርስናም እንጂሉ አመዕንታእረ ጡምሶተ መገን አምሩ እኮኡ። <verse eid="1CO 1:21"/><verse number="22" style="v" sid="1CO 1:22"/>አይሁድ መኑ መላተ ለኡ ኢትታአ፤ ህትን ግሪክ መኑ ሀይመተ ሃሸኣአ። <verse eid="1CO 1:22"/><verse number="23" style="v" sid="1CO 1:23"/>ጠዉ እኮጎሬ ነኡ አይሁዲሃ ጉፍቹ እኮሃ አይሁደ እህበ መኒሃ ገዊመተ እኮ ሰቀለም ሬዮ መሲህ ዱዱብስናም። <verse eid="1CO 1:23"/><verse number="24" style="v" sid="1CO 1:24"/>ህትን ገአሞ መኒሃ አይሁዲሃ እካን ግሪክ አፎን ጠወአኖ መኒሃ መሲህ መገንተ ዎልቀተለከ መገንተ ሀይመ። <verse eid="1CO 1:24"/><verse number="25" style="v" sid="1CO 1:25"/>መሰንትስ መገን ገዊመት መን ሀይማች በተኣአ፤ ህትን መገን ላፍመት መን ዎልቃች በተኣአ።<verse eid="1CO 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26"/>አመኤ ኦሶ! ክዕኔተ መገኑ ገኤህዕኔ ወክት ሀትኔ መነ እኬንታጎሬ ሰውይዬ፤ መን ሰውቲን በላንከክዕኔ አኡ ሀይመተ ህከረንገ ልግቡ ጠረኙ ህከረንገ ልግቡ ሎርሎሩ መኑ ዮበአ። <verse eid="1CO 1:26"/><verse number="27" style="v" sid="1CO 1:27"/>ጠዉ እኮጎሬ ሀይመተ ሙልሶተ መገኑ ከን ኣዱንያ አል ገወ መነ መጠሮ፤ ህትን ዎልቃመተ ሙልሶተ መገኑ ከን ኣዱንያ አል ላፈ መነ መጠሮ። <verse eid="1CO 1:27"/><verse number="28" style="v" sid="1CO 1:28"/>ከን ኣዱንያ አል ሎረ ጠወ ሆፍሶተ መገኑ ከን ኣዱንያ አል ቀዉ ጠዋሃ፥ ህንቀሞ ጠወለከ ተሰ እኮ ጠወሃ መጠሮ። <verse eid="1CO 1:28"/><verse number="29" style="v" sid="1CO 1:29"/>ህካን አዕዮንኩ ማለ ኦደዕዮሁ ጉዕሙንኩ መገን ብሬን ቦነኖበእጋት። <verse eid="1CO 1:29"/><verse number="30" style="v" sid="1CO 1:30"/>እኮጎሬ ክዕኔተ መገኑ መሲህ ኢሲን ሜጡበ ሜጦመት ሄኣህዕኔገ አዕዮ፤ ህካን እኮቤቺሃ መገኑ መሲህ ኢሰ ሀይመኔ፥ ፈይመኔ፥ ጠሊልመኔለከ ወዝኑኔ እሀኖገ አዕዮስ። <verse eid="1CO 1:30"/><verse number="31" style="v" sid="1CO 1:31"/>ጠሊለ መጻፋን ከተበሞገን «ድከአኖሁ ቀርቾን ድከኡን።»<note caller="-" style="x"><char style="xo" closed="false">1፥31 </char><char style="xt" closed="false"><ref loc="JER 9:24">ኤር. 9፥24</ref>።</char></note><verse eid="1CO 1:31"/></para>
  <chapter eid="1CO 1"/>
  <chapter number="2" style="c" sid="1CO 2"/>
  <para style="s1">ሰቀለሞ ኢስተኔሃ ዱዱብሰሞገ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1"/>አመኤ ኦሶ! አን ክዕኔቤቹ አሜቾም ወክት መገንተኔሃ መሰከሩ<note caller="+" style="f"><char style="fqa" closed="false">መገንተኔሃ መሰከሩ፦ </char><char style="ft" closed="false">የኖሁ መት-መቱ ሉህ ክታበት «መገን ምስጥር ተማርሱ» ይታአ።</char></note> አን ጠወ ደጋምሀንገለከ ጡመገ አዕይ ጠወአሚሃ እሁኤ ለሊሶህዕኔተ አሜቾምበአ። <verse eid="1CO 2:1"/><verse number="2" style="v" sid="1CO 2:2"/>መሰንትስ አን ክዕኔን ሄዕዮም ወክት ሰቀለሞ መሲህ ኢስ ቤሉ ዎሉ መቱርቹሃ ደጋምበእገ ሙርሲጭዮም። <verse eid="1CO 2:2"/><verse number="3" style="v" sid="1CO 2:3"/>ህካን እኮቤቺሃ ክዕኔን ሜጡበ ሄዕዮም ወክት ላፈ እክ ዋጀን አበ ሁጠኛ አሌን ሄዕዮም እቅ። <verse eid="1CO 2:3"/><verse number="4" style="v" sid="1CO 2:4"/>ጠዉኤለከ ትምርቱኤ መን ሀይመተለከ ጠወ መክሲን እሁዕነ መገን አያነለከ ዎልቀተ ለልሲሃት እቅ። <verse eid="1CO 2:4"/><verse number="5" style="v" sid="1CO 2:5"/>ህካን አዕዮሚሁ አመዕነቱክዕኔ መን ሀይመ አሌን ኡሬኢሃ እሁዕነ መገን ዎልቃን ድከዕዮሃ እሆታት።<verse eid="1CO 2:5"/></para>
  <para style="s1">መገን ሀይመተ</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6"/>ጠዉ እኮጎሬ አመዕነቲን ጠረኝቶሀኑኡተ ሀይመ ላጋን ጠወዕናም፤ እሁን ቤሉ ጠወዕናሚሁ ከን ኣዱንያ አል ሀይመተ ህከረንገ መጨረሽ በኡ እሀኖ ከን ኣዱንያ አል ገሸኖ ሀይመተበአ። <verse eid="1CO 2:6"/><verse number="7" style="v" sid="1CO 2:7"/>ነኡ ጠወዕናሚሁ እኮጎሬ መገኑ ሄጭ ጉዕመ ዘማኒች ብርተ ኬዕምኚሃኔ ቅጥ አዕዮለከ ማጠሞ እቅ መገን ምስጥር ሀይመታት። <verse eid="1CO 2:7"/><verse number="8" style="v" sid="1CO 2:8"/>ከን ኣዱንያ አል ገሻኖ በላን ከ ሀይመተ አጥራመቾሁ አዪሁ ዮበአ፤ ደጎእቃኔተ ኬዕምኝ ቀርቹ ሰቀልታስበአ እቅ። <verse eid="1CO 2:8"/><verse number="9" style="v" sid="1CO 2:9"/>እሁን ቤሉ ጠሊለ መጻፋን ከተበሞገን</para>
  <para style="q1" vid="1CO 2:9">«መን እልት ለኦበኢሃ፥</para>
  <para style="q2" vid="1CO 2:9">መን መጨት ሞጮጭቶበኢሃ፥</para>
  <para style="q2" vid="1CO 2:9">መን ቀልቡ ሰውይዮበኢሃ፥</para>
  <para style="q2" vid="1CO 2:9">መገኑ ኢትታሀኑኡተ ቅጥ አዕዮኡ» የኖ።<note caller="-" style="x"><char style="xo" closed="false">2፥9 </char><char style="xt" closed="false"><ref loc="ISA 64:4">ኢሳ. 64፥4</ref>።</char></note><verse eid="1CO 2:9"/></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10"/>ኔሳሃ እኮጎሬ መገን አያን መሳን ምስጥርስ ለሊሾኔ፤ መገን አያኑ ጥዕላሸ እኮ መገን ሰውቱ ፈቁዕናን ጉዕመ ጠወንከ መረመረኖ። <verse eid="1CO 2:10"/><verse number="11" style="v" sid="1CO 2:11"/>መንተኔሃ እኮእቀ ገይስ አያን ቤሉ እሶን ሄዕዮ ሰውት ደገኖሁ አዬት? ህትን መገን አያን ቤሉ መገን ሰውት ደገኖሁ አዪሁ ዮበአ። <verse eid="1CO 2:11"/><verse number="12" style="v" sid="1CO 2:12"/>መገኒች ኣሰሞኔርቹ ደንጎተ መገን አያነ ቶንጎም ቤሉ ከን ኣዱንያ አል አያነ ቶንጎምበአ።<verse eid="1CO 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 2:13"/>ህካን እኮቤቺሃ ነኡ አመዕነት ጠወ አመዕንቶ መኒሃ ተማርስናሚሁ መኒች ደገመኖ ሀይማን እሁዕነ መገን አያኒች ደገመኖ ሀይማኒት። <verse eid="1CO 2:13"/><verse number="14" style="v" sid="1CO 2:14"/>አመዕነቱ ዮስበእ መንቹ መገን አያኒች ቶጎተ አታለኖበአ፤ መሰንትስ ህትኔ ጠው እሲሃ ገውመተ፤ አያኒን እክ መረመረመኖሃ እኮቤቺሃ ደጎተ አታለኖበአ። <verse eid="1CO 2:14"/><verse number="15" style="v" sid="1CO 2:15"/>መገን አያኑ ዮሲሁ እኮጎሬ ጉዕመ ጠወንከ መረመሮተ አታለኖ፤ እስ ገዉስ አዬኒ መረመረመኖበአ። <verse eid="1CO 2:15"/><verse number="16" style="v" sid="1CO 2:16"/>ሁኩንን፦</para>
  <para style="q1" vid="1CO 2:16">«ቀርች ሰውት አይ ደገኖ?</para>
  <para style="q2" vid="1CO 2:16">ሸዞስተ አታለኖሁ አዬት?» የመም ከተበሞጋት።</para>
  <para style="p" vid="1CO 2:16">ነኡ እኮጎሬ መሲህ ቀልቡ ዮኔ።<note caller="-" style="x"><char style="xo" closed="false">2፥16 </char><char style="xt" closed="false"><ref loc="ISA 40:13">ኢሳ. 40፥13</ref>።</char></note><verse eid="1CO 2:16"/></para>
  <chapter eid="1CO 2"/>
  <chapter number="3" style="c" sid="1CO 3"/>
  <para style="s1">ቆሮንቶስ አመዕናኖ ኣዜን ኬኦ ብተተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1"/>አመኤ ኦሶ! አን ከን ኣዱንያ አል ሰውቱ ዮህዕኔገለከ መሲሂን ጩለገ አዕዪት ቤሉ መገን አያኒን ዮ መንገ አዕይ ጠወኦተ አታሎምበአ። <verse eid="1CO 3:1"/><verse number="2" style="v" sid="1CO 3:2"/>ጠረኘ እቸተ እት አታልትቡ ጩለገ እኬንተቤቺሃ አን ኢትሾንክዕኔሁ አዙታት ቤሉ ጠረኘተ እቸበአ፤ ቴሁ እኮጎሬ ጠረኘ እቸተ እቶኖተ አታልቴነንተበአ።<note caller="-" style="x"><char style="xo" closed="false">3፥2 </char><char style="xt" closed="false"><ref loc="HEB 5:12-13">እብ. 5፥12-13</ref>።</char></note> <verse eid="1CO 3:2"/><verse number="3" style="v" sid="1CO 3:3"/>አዕኑ ቴሁ ከን ኣዱንያ አል መን ሰውቱ ዮህዕኔ፤ ገገዉንኩዕኔ መት-መቲንከክዕኔ ምቀኝቴነንተቤቺሃለከ ኦደንቴነንተቤቺሃ ከን ኣዱንያ አል ሰውትገ እሆንከክዕኔበእንዶ? ህት እሁክዕኔ ከን ኣዱንያ አል መን ሰውትገ እሆንከክዕኔበእንዶ? <verse eid="1CO 3:3"/><verse number="4" style="v" sid="1CO 3:4"/>ህትን መቱክዕኔ «አን ጳዉሎሴሃ» ዎሉዕኔንገ «አን አጵሎሴሃ» የኖሃ እኮች አመዕንበ መንገ እሆንከክዕኔበእንዶ?<note caller="-" style="x"><char style="xo" closed="false">3፥4 </char><char style="xt" closed="false"><ref loc="1CO 1:12">1 ቆሮ. 1፥12</ref>።</char></note><verse eid="1CO 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5"/>አጵሎስ መርቾሃን? ህትን ጳዉሎስ መሃን? እሰ አዕኑ አመዕንቶኖተ አቶህዕኔተ ካዲመ፤ መት-መቱንኩሰ ካደንታስ ቀርቹ መት-መቲሃሰ መደቦሰ ሆጎኒት፤ <verse eid="1CO 3:5"/><verse number="6" style="v" sid="1CO 3:6"/>አን ካሾም፤ አጵሎስ ዋሃ አግሾ፤ ነሴኢሁ እኮጎሬ መገኑሃን።<note caller="-" style="x"><char style="xo" closed="false">3፥6 </char><char style="xt" closed="false"><ref loc="ACT 18:4-11">ሶቀ. 18፥4-11</ref>፤ 24፥28።</char></note> <verse eid="1CO 3:6"/><verse number="7" style="v" sid="1CO 3:7"/>ህካን እኮቤቺሃ ሆጎተስ ቡዕለ እኮሁ ነሴ መገኑሃ ቤሉ ካሾሁ እኮ ዋሃ አግሾሁ መርቹሃስበኢሁ። <verse eid="1CO 3:7"/><verse number="8" style="v" sid="1CO 3:8"/>ካሾሁ እኮ ዋሃ አግሾሁ ለሙንኩ ቅጦሃን፤ መት-መቱስ ሆጎስ ወጥ ዋገ ቶገኖ። <verse eid="1CO 3:8"/><verse number="9" style="v" sid="1CO 3:9"/>ነኡ መገኒን ሜጡበ አዕናምረ ካዲመ፤ አዕኑሁ መገንተ አቡረለከ መገንየ ምኒ። <verse eid="1CO 3:9"/><verse number="10" style="v" sid="1CO 3:10"/>መገኑ ኣሴኤ ኣስቶ ጌሲን ኤንኬዕናሙ መንቹ ምኒ እጃረኖሀንገ ቀበበ መክሾም፤ ዎሉንገ አን መክሾም ቀበብ አሌን እጃረኖ፤ ጠዉ እኮጎሬ ገገዉንኩስ ከን ቀበብ አሌን ሀት አዕይ እጃረኖጎሬ አገዕሩ ሀስሰኖስ። <verse eid="1CO 3:10"/><verse number="11" style="v" sid="1CO 3:11"/>ሜጦረ መኬ ቀበብ ቤሉ አዪሁ ዎሉ ቀበበ መክሶተ አታለኖበአ፤ ሁኩ ቀበቡንኩ መሲህ ኢሳት። <verse eid="1CO 3:11"/><verse number="12" style="v" sid="1CO 3:12"/>ከን ቀበብ አሌን ዎርቂን፥ ብሪን፥ ጡመ ክኒን፥ ህከረንገ ሀቂን፥ ህጤንለከ ገለቢን ግንበ እጃረኖሁ ሄዕዮጎር <verse eid="1CO 3:12"/><verse number="13" style="v" sid="1CO 3:13"/>መት-መቶ መንች ሆጉት ለልታ ፍርድ በሩ አሜተኖ፤ ህከ በር ጉዕምስ ሆጉት መሃጎር ጊራን ፌተነም ለለኖ። <verse eid="1CO 3:13"/><verse number="14" style="v" sid="1CO 3:14"/>መቱ ግንበ እጃረኖ መንቹ ቀበብስ አሌን አዕዮ ሆጉት ጊራን ፌተነም ምርተኡዕነ ጠረኝ ኡሬጎር ግንበ እጃረኖሁ ዋገስ ደአኖ። <verse eid="1CO 3:14"/><verse number="15" style="v" sid="1CO 3:15"/>ሆጉስ ጊራን ቡብ በኦጎር ግንበ እጃረኖሀን ዋጉ ፈቀኖ፤ እሁን ቤሉ እስ ገዉስ ጊረ ኣዚን ህግ ቡቡዕነ ፈቆ መንችገ ጡመኖ።<verse eid="1CO 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16"/>መገን ጠሊለ ምኒ እሁክዕኔለከ መገን አያኑ ኣዜንከክዕኔ ሄኡስ ደጌነንተበእንዶ?<note caller="-" style="x"><char style="xo" closed="false">3፥16 </char><char style="xt" closed="false"><ref loc="1CO 6:19">1 ቆሮ. 6፥19</ref>፤ <ref loc="2CO 6:16">2 ቆሮ. 6፥16</ref>።</char></note> <verse eid="1CO 3:16"/><verse number="17" style="v" sid="1CO 3:17"/>ህካን እኮቤቺሃ አዪሁ ዱእ ምኒ ድጄጎር መገኑ ገዉንከስ ድጀኖ፤ መገን ፎሎጨኖ ምኑ ጠሊለሃን፤ ሁኩ መገን ምኑ አዕኖት።<verse eid="1CO 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18"/>አዪሁ ገዉስ ጣንሱንከ፤ ከን ኣዱንያ አሌን አዪሁ ክዕኔ በሊች ሀይቹ እኮሃ አጉጆስ ጎሬ ሀይቹ እሆተ ገዉስ ገወ አዕይ ዎለኡን። <verse eid="1CO 3:18"/><verse number="19" style="v" sid="1CO 3:19"/>ከን ኣዱንያ አል ሀይመት መገን ብሬን ገዊመተ፤ መሰንትስ «መገኑ ተንኮንተሰን አፈኖሰ» የመም ከተበሞጋት።<note caller="-" style="x"><char style="xo" closed="false">3፥19 </char><char style="xt" closed="false"><ref loc="JOB 5:1">አዩ. 5፥1</ref>።</char></note> <verse eid="1CO 3:19"/><verse number="20" style="v" sid="1CO 3:20"/>ህትን «ቀርቹ ሀይቻኖ ሰውቱ ተሰ እሁስ ደገኖ» የመም ከተበሞኡ።<note caller="-" style="x"><char style="xo" closed="false">3፥20 </char><char style="xt" closed="false"><ref loc="PSA 94:11">መዝ. 94፥11</ref>።</char></note><verse eid="1CO 3:20"/></para>
  <para style="m">
    <verse number="21" style="v" sid="1CO 3:21"/>ህካን እኮቤቺሃ ጉዕሙርቹንኩ ክዕኔሃ እኮቤቺሃ አዪሁ መናን ድከኡንከ። <verse eid="1CO 3:21"/><verse number="22" style="v" sid="1CO 3:22"/>ህትን ጳዉሎሴሃ እኮ አጵሎስ፥ ጴጥሮሴሃ እኮ እቃ፥ ኣዱንያ አል እኮ እቃ፥ ሄኡ እኮ እቃ፥ ሬሁተ እኮ እቃ፥ ቴሱ ዮኢሃ እኮ እቃ፥ ኤተሮን አሜተኖሃ እኮ እቃ ጉዕሙንኩ ክዕኔሃን። <verse eid="1CO 3:22"/><verse number="23" style="v" sid="1CO 3:23"/>አዕኑ እኮጎሬ መሲህተ እለ፤ መሲሁንገ መገንየን።<verse eid="1CO 3:23"/></para>
  <chapter eid="1CO 3"/>
  <chapter number="4" style="c" sid="1CO 4"/>
  <para style="s1">መሲህ አሳበተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1"/>ቴሱ መኑ ጉዕሙንኩ ኔሳሃ መሲህ አሳበተ እሁኔለከ መገን ማጠሞ ጠወ ለሊስ ኤገት ኣሰንቶኔ መንገ አዕይ ዎለኡ ሀስሰኖኔ። <verse eid="1CO 4:1"/><verse number="2" style="v" sid="1CO 4:2"/>ኤገተ ቶጎ መኑ አመዕነንቶእረ እክ ደገሙ ሀስሰኖሰ። <verse eid="1CO 4:2"/><verse number="3" style="v" sid="1CO 4:3"/>ኢተኔሃ እኮጎሬ አዕኑሁ ፈረዴንተጎሬ ህከረንገ ዎሉ መኑሁ መኑ ፈረደኖገ ፈረጆኤጎሬ ኦርሸት ዮኤበአ፤ ሀንቅንከ አን ገይኤ አሌን ፈረዶተ አታላምበአ። <verse eid="1CO 4:3"/><verse number="4" style="v" sid="1CO 4:4"/>አን ደጋምገን እኮጎር ሂሉርቹ ኢን መቱርቹሁ ዮበአ፤ ህካን ዩኤ አን «ነጠ እሁኤ ለሊሰኖ» ዩሃበአ፤ ጠዉ እኮጎሬ ኢ አሌን ፈረደኖሁ ጠለዕል ቀርቹሃን። <verse eid="1CO 4:4"/><verse number="5" style="v" sid="1CO 4:5"/>ህካን እኮቤቺሃ ወክቱስ ኢሉዕነ ቀርቹ አሜቱዕናን ሄጭቴን አዬ አሌን ፈረዶኖቼ፤ እስ አሜተኖ ወክት ቱንስቾን ማጠሞ ጠወ ፉሽ ለሊሰኖ፤ መን ቀልቤን ማጠሞ ሰውት ለሊሰኖ፤ ህከ ወክት ገገዉንኩስ መገኒች ሀስሰኖ ገለት ቶገኖ።<verse eid="1CO 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6"/>አመኤ ኦሶ! ክዕኔተ ደግለሎተ ይ ከን ጠዋን ኤሳለከ አጵሎሴ ምሳልተ አዕይ ጠወዕዮም፤ ህካንን አዕዮሚሁ «ከተበሞሀኒች ህጎት» ይታ ሸዘነ ፍሳረስ ኒች ተማርቶኖተ ይዪት፤ ህካን እኮቤቺሃ መቱ መንቹ መቶ መንቺች በትሴን ህከን መንቾን ድከኦኖቼ። <verse eid="1CO 4:6"/><verse number="7" style="v" sid="1CO 4:7"/>መሰንትስ አት ሚን በተአን? ህትን ኣእቶንትበእርቹ ም ዮኡ? ህከረ ኣእቶንቲሁ እኮጎሬ ኣእበ መንገ ሚሃ ገዎንከክ ድከአን?<verse eid="1CO 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8"/>ቴሱ ሀስሰኖህዕኔርቹ ጉዕመንከ ደእቴንታአ፤ ቴንገ ቀባጣመተ እኬንታአ፤ ኒች አደ እኬን ነገሴንታአ፤ ሀንቅንከ ነገሴንታ እቃን ነኡ ክዕኔን ሜጡበ ነገንሳምቤቺሃ ነገሱክዕኔ ጡመ እቅ፤ <verse eid="1CO 4:8"/><verse number="9" style="v" sid="1CO 4:9"/>ኣዱንያ አል ጉዕሚንከ መላይካንተ መኒንከ ሙሃሌኖኔሃ እንኮም፤ መሰንትስ መገኑ ኔሳሃ አሳበስ ሬሁት ፈረዴመሰ መንገ መኒች ጉዕሚችን ዎሮን አዕዮኔሃ አጉደኖኤ። <verse eid="1CO 4:9"/><verse number="10" style="v" sid="1CO 4:10"/>ነኡ መሲህሃ ይን ገዋኑተ እንኮም፤ አዕኑ እኮጎሬ መሲህ ሀይቻኑተ እኬንታአ፤ ህትን ነኡ ሆጎ መነ እንኮም፤ አዕኑ እኮጎሬ ጠረኛኑተ እኬንታአ፤ አዕኑ ኬዕምኛመተ እኬንታአ፤ ነኡ እኮጎሬ ሆፍኛመተ እንኮም። <verse eid="1CO 4:10"/><verse number="11" style="v" sid="1CO 4:11"/>ቴሁ እኮጎሬ ከ ሰኣት ኢለ ጎራይናም፤ ሰገምባም፥ ከልናም፥ ኦለማም፥ ምኒ ሆንግ ኦርጨቀማም። <verse eid="1CO 4:11"/><verse number="12" style="v" sid="1CO 4:12"/>ነኡ ገይኔ አንጋን አዕነን ቆንዶድናም፤ ቦሮሮኔ መነ ማሰዕናም፤ ሸርታኔ ወክት አታዕልናም።<note caller="-" style="x"><char style="xo" closed="false">4፥12 </char><char style="xt" closed="false"><ref loc="ACT 18:3">ሶቀ. 18፥3</ref>።</char></note> <verse eid="1CO 4:12"/><verse number="13" style="v" sid="1CO 4:13"/>ህትን ቦሮሬመኔለከ ሱዕመኔ ቤሴመ ወክት ገዉኔ ሆፍንስ ፈንቀሽናም፤ ቴሱ ኢለ ከን ኣዱንያ አል ሁረ እንኮም።<verse eid="1CO 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14"/>አን ከ ጠወ ከተባንክዕኔሁ ኢታም እለኤገ አዕይ ሸዞህዕኔታት ቤሉ ሙልሶህዕኔተ ይዪበአ። <verse eid="1CO 4:14"/><verse number="15" style="v" sid="1CO 4:15"/>መሃ እኮጎሬ መሲሂን ነስታህዕኔሩ ሄኦህዕኔጎሬ ልግቡ አነ እሀኖህዕኔሁ ዮበአ፤ መሰንትስ አን መሲህ ኢስ አዲን እንጂል ላጋን እሎንክዕኔ። <verse eid="1CO 4:15"/><verse number="16" style="v" sid="1CO 4:16"/>ህካን እኮቤቺሃ ኤሳሃ አጉዴን አዎንቶኖኤተ ኡጫንክዕኔ። <verse eid="1CO 4:16"/><verse number="17" style="v" sid="1CO 4:17"/>ህከን መሳን ኢተሞለከ አመዕነሞ ቀርቺን ቤቱኤ እኮ ጥማቶሴ ክዕኔቤቹ ሶኮም፤ ቤቾን ጉዕማንን አመዕናኑተ ተማርሴምሀንገ እስ አን መሲሂን ደኤም ሃዕሮ ሄእ ሸዘነተ ኩለኖሰ።<note caller="-" style="x"><char style="xo" closed="false">4፥16 </char><char style="xt" closed="false"><ref loc="1CO 11:1">1 ቆሮ. 11፥1</ref>፤ <ref loc="PHP 3:17">ፍልጵ. 3፥17</ref>።</char></note><verse eid="1CO 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18"/>ጠዉ እኮጎሬ ክዕኔች መት-መቱሰ አን ክዕኔተ ለኦተ አሜታምበኢሃ አጉጃንሰ ቦንታኢት። <verse eid="1CO 4:18"/><verse number="19" style="v" sid="1CO 4:19"/>እሁን ቤሉ ቀርቹ ዬጎሬ ግደኖ በሬን ክዕኔቤቹ አሜታም፤ ህከ ወክት ጠለዕል ህከን ቦንታ መን ጠወሰ እሁዕነ ዎልቀሳ ደጎተ ሀሳም። <verse eid="1CO 4:19"/><verse number="20" style="v" sid="1CO 4:20"/>መሰንትስ መገን ዎምነቱ ጠለዕል ጠዊን እሁዕነ መገን ዎልቃኒት። <verse eid="1CO 4:20"/><verse number="21" style="v" sid="1CO 4:21"/>አዕኑ ሀሴነንታሁ መርቾሃን? ቅጣት በርተ አፍ ክዕኔቤቹ አሜቶተ ሀሴነንንዶ? ህከረንገ ኢታንለከ ገዉ ሆፍስ አያኒን አሜቶተ ሀሴነን?<verse eid="1CO 4:21"/></para>
  <chapter eid="1CO 4"/>
  <chapter number="5" style="c" sid="1CO 5"/>
  <para style="s1">አመዕናኖ በላን እኮ ሂለ ጠወ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1"/>ክዕኔ በላን ሙልሳ ዝነት ሄኡስ ሞጮጭዮም፤ ህትኔ ዝነት አይሁደ እህበ መኑሁ አእበሃን፤ ሁኩንን አንስ ጫተ ገይስ ምኒ አመገ አዕይ ሄአኖሁ ዮኡ የመሞኡ።<note caller="-" style="x"><char style="xo" closed="false">5፥1 </char><char style="xt" closed="false"><ref loc="DEU 22:30">ዘዳ. 22፥30</ref>።</char></note> <verse eid="1CO 5:1"/><verse number="2" style="v" sid="1CO 5:2"/>ህካን እክ ህትኔ ሙልሲሰኖ ጠዉ በላንከክዕኔ ሄአን ሚሃት ቦንቴነንታሁ? ባሰንከ ከን ጠዋን ሻዙ ሀስሰኖህዕኔበእንዶ? ህትኔ ሆጉተ አዕዮ መንቹ በሊችክዕኔ ከሜ። <verse eid="1CO 5:2"/><verse number="3" style="v" sid="1CO 5:3"/>አን መሃ እኮ እቃን ሜጡበ ሄእበ ጎሬ ሰውቲን ክዕኔን ሜጡበ ዮም፤ ሜጡበ ሄዕዮምሀንገ እክ ህትኔ ሆጉተ አዕዮ መንች አሌን ቀርቾሃ ኢስ ሱዕሚን ፈረጆም፤ <verse eid="1CO 5:3"/><verse number="4" style="v" sid="1CO 5:4"/>ጭምይቴነንተ ወክት አኒሁ ቀርቹሃኔ ኢስ ዎልቃን በላንከክዕኔ ሰውቲን ሄኣምቤቺሃ <verse eid="1CO 5:4"/><verse number="5" style="v" sid="1CO 5:5"/>መሲህ ለምቅ አሜቶን ከን መንች ነብሶሁ ጡሞተ ህትናሞ መንች ማል ሰውቱ በኦተ ሸይጣኒሃ ህግሽ ኣሱ ሀስሰኖ ይ ፈረጆም።<verse eid="1CO 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6"/>ህካን እኮቤቺሃ ቦኑክዕኔ ጡመሃበአ፤ ቀቅቹ ራጭቱ አበ ቡኩተ አቦከኖገ ደጌነንተበእንዶ?<note caller="-" style="x"><char style="xo" closed="false">5፥6 </char><char style="xt" closed="false"><ref loc="GAL 5:9">ገላ. 5፥9</ref>።</char></note> <verse eid="1CO 5:6"/><verse number="7" style="v" sid="1CO 5:7"/>ቴሱ እኬንተሀንገ ራጭቱ ዮበእ ሃዕሮ ቡኮገ እኮኖተ ዱንኬ ራጭተ ክዕኔች ቄርስዬ፤ መሰንትስ ሻሽግ ሆልቹ እኮ መሲህ ኢስ ጎረጠሞኡ፤<note caller="-" style="x"><char style="xo" closed="false">5፥7 </char><char style="xt" closed="false"><ref loc="EXO 12:5">ፉል. 12፥5</ref>።</char></note> <verse eid="1CO 5:7"/><verse number="8" style="v" sid="1CO 5:8"/>ህካን እኮቤቺሃ ተንኩትለከ ሂሉ ጠዉሁ ዊሞ ዱንኬ ራጭቲን እሁዕነ ራጭቱ ዮበእ ነጠለከ ሀንቁ ዊሞ ጦሮሽ ከበጀኔ ከበጅኖ።<note caller="-" style="x"><char style="xo" closed="false">5፥8 </char><char style="xt" closed="false"><ref loc="EXO 13:3">ፉል. 13፥3</ref>፤ <ref loc="DEU 16:3">ዘዳ. 16፥3</ref>።</char></note><verse eid="1CO 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9"/>ከኒች ብርተ ከተቦንክዕኔ ሶህኖን ዝነተ አታ መኒን ሜጡ እኮኖቼ ይዮንክዕኔ እቅ። <verse eid="1CO 5:9"/><verse number="10" style="v" sid="1CO 5:10"/>ህካን ዩእ ጉዕመ ከን ኣዱንያ አሌን ሄኣ ዝነተ አታ ህከረንገ ጎራይታ መኒች ህከረንገ ሞጋኖች ህከረንገ ሽርከተ አታ መኒን ሜጡ እኮኖቼ ዩሃእበአ፤ ህካን እኮጎሬ ኣዱንያ አሊች ፉሉ ሀስሰኖኔ ዩሃን። <verse eid="1CO 5:10"/><verse number="11" style="v" sid="1CO 5:11"/>አን እኮጎሬ ከተቦንክዕኔሁ አመዕናኑተ እክ ዝነተ አታሀኑኡን፥ ህከረንገ ጎራይታሀኑኡን፥ ህከረንገ ሽርከተ አታሀኑኡን፥ ህከረንገ መን ሱዕመ ቤሳሀኑኡን፥ ህከረንገ ሰከርታሀኑኡን፥ ህከረንገ ሞግታሀኑኡን ሜጡ እኮኖቼ ይይት። ህትኔ መኒን ሜጡበ እቶኖቼ።<verse eid="1CO 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12"/>መገኑ አመዕኔ ጭምቲች አብሊን ዮ መን አሌን አን ፈረዶተ ም አግሾኤ? መገኑ አመዕኔ ጭምት ኣዜን ዮ መን አሌን አዕኑ ፈረዴነንተበእንዶ? <verse eid="1CO 5:12"/><verse number="13" style="v" sid="1CO 5:13"/>አመዕንትበ መን አሌን ፈረደኖሁ መገኑሃን፤ ህትን መጻፋን «ሂለ መንቹ በሊችክዕኔ ፉሽቴን ከሜ» ዬገን አዕዬ።<verse eid="1CO 5:13"/></para>
  <chapter eid="1CO 5"/>
  <chapter number="6" style="c" sid="1CO 6"/>
  <para style="s1">አመዕናኖ በሊች ብተተ ከሙ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1"/>ክዕኔች መቱ አመዕናንቹ እኮ አመስ ቤቲን ብተሞ ጎር ጠወስ አመዕናኑት ለኣገ አአኖ ወጥ መገኑ አመዕንቶበእ ዳኛኖበ መሮተ ሀት መለለኖ? <verse eid="1CO 6:1"/><verse number="2" style="v" sid="1CO 6:2"/>መገኑ አመዕንቶ መኑ ከን ኣዱንያ አሌን ሄኣ መን አሌን ፈረዳገ ደጌነንተበእንዶ? ህከረ ኣዱንያ አሌን ፈረዴነንታሃ እሀን ከን ቀዎ ጠው አሌን ፈረዱ ቄለኖህዕኔንዶ? <verse eid="1CO 6:2"/><verse number="3" style="v" sid="1CO 6:3"/>ህትን ነኡ መላይከ አሌን ፈረንዳምገ ደጌነንተበእንዶ? ህከረ ባሰንከስ ከን ኣዱንያ አል ጠዋን ፈረዱ ሀት አታልናምበአ? <verse eid="1CO 6:3"/><verse number="4" style="v" sid="1CO 6:4"/>ቴሱ ገገዉክዕኔ ብተንቴንተጎር አመዕንቶበእለከ ህንቀንቶ መን ብርተ ጠወክዕኔ ሀት ሆንጠህሴነን? <verse eid="1CO 6:4"/><verse number="5" style="v" sid="1CO 6:5"/>ካን ያሚሁ ሙልቶኖተ ይዪት፤ ሀት አመዕናኖ በላን ሀራርሶህዕኔተ አታለኖ ባልቁ ዮበእንዶ? <verse eid="1CO 6:5"/><verse number="6" style="v" sid="1CO 6:6"/>ህከረ መቱ አመዕኔ መንቹ ዎሉ አመዕኔ መንቹ ኦዶተ አመዕንትበ ዳኛኖበ መረኖንዶ?<verse eid="1CO 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7"/>ህትን ገገዉክዕኔ ከሰጨንቴን ኦደሙ ክዕኔሃ ቢልኝየ፤ ባሰንከስ አዕኑ ምርተኡክዕኔ ህከረንገ ጣንሰሙክዕኔ ቆሀኖበእንዶ? <verse eid="1CO 6:7"/><verse number="8" style="v" sid="1CO 6:8"/>እኮጎሬ አዕኑ አመዕንቶ አመክዕኔ ኦሱተ ምርቴነንታትለከ ጣንስቴነንታት። <verse eid="1CO 6:8"/><verse number="9" style="v" sid="1CO 6:9"/>ሾኩ መኑ መገን ዎምነቱ ዎረሳበእገ ደጌነንተበእንዶ? ከን ጠዋን ጣንሰንቶኖቼ፤ ፎኩተ አታእሩ፥ ህከረንገ ሽርኬተ ሰገዳእሩ፥ ህከረንገ ዝነተ አታእሩ፥ ህከረንገ ጎኑ ጎኒን ዝነተ አታእሩ <verse eid="1CO 6:9"/><verse number="10" style="v" sid="1CO 6:10"/>ህከረንገ ሞግታእሩ፥ ህከረንገ ጎራይታእሩ፥ ህከረንገ ሰከርታእሩ፥ ህከረንገ መን ሱዕመ ቤሳእሩ፥ ህከረንገ ዘረፋእሩ መገን ዎምነቱ ኣጋበአ። <verse eid="1CO 6:10"/><verse number="11" style="v" sid="1CO 6:11"/>ክዕኔች መት-መቱክዕኔ ህትናመተ እቅ፤ ቴሁ እኮጎሬ ቀርቾ መሲህ ኢስ ሱዕሚንለከ ኒ መገን አያኒን ጩቢች ነጠ እኬንታአ፤ መገኒሃ አደ እኮ ጠሊለ ኡመትለከ ፈየ እኬንታአ።<verse eid="1CO 6:11"/></para>
  <para style="s1">ጅስመኔ መገን ኬዕምኚሃ አኡ ሀስሰኖሃ እሁስ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12"/>«ጉዕሙርቹንኩ ፈቀደሞኤ» እኮጎሬ ጉዕሙርቹንኩ ደግለለኖኤ ዩሃበአ፤ ጉዕሙርቹንኩ ፈቀደሞኤ፤ እሁን ቤሉ እኮስ ጠዊሃ ሮስ እክ ጠገማምበአ።<note caller="-" style="x"><char style="xo" closed="false">6፥12 </char><char style="xt" closed="false"><ref loc="1CO 10:2">1 ቆሮ. 10፥2</ref>።</char></note> <verse eid="1CO 6:12"/><verse number="13" style="v" sid="1CO 6:13"/>ህትን «እቸት ጎዳቢሃ፥ ጎደቡንኩ እቻታት» እኮጎሬ መገኑ ለሙንከስ ቤሰኖ፤ ጠዉ እኮጎሬ ጅስሙኔ ቀርቾ ኢሲሃ፥ ቀርቹ ኢስን ጅስሚሃኔ እኮቤቺሃ ጅስመኔ ዝናተ ህግንስ ኣሱ ሀስሰኖኔበአ። <verse eid="1CO 6:13"/><verse number="14" style="v" sid="1CO 6:14"/>መገኑ ቀርቹ ኢሰ ሬሆች ኬሾስ፤ ኔሳሁ ዎልቃንከስ ሬሆች ኬሰኖኔ።<verse eid="1CO 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15"/>ጅስሙክዕኔ መሲህ ጅስመ እሁስ ደጌነንተበእንዶ? ህከረ አን መሲህ ጅስመ መስ ዝነተ አታ መንቾ ጅስመ አኡ ሀስሰኖንዶ? ሆሮ ሀስሰኖበአ! <verse eid="1CO 6:15"/><verse number="16" style="v" sid="1CO 6:16"/>ዝነተ አታ መንቾን ደቀመኖ መንቹ እሴን ሜጡ ጅስመ እሁስ ደጌነንተበእንዶ? «ለሙንኩሰ መቱ ጅስመ እካአ» የመም ከተበሞኡ።<note caller="-" style="x"><char style="xo" closed="false">6፥16 </char><char style="xt" closed="false"><ref loc="GEN 2:24">ክል. 2፥24</ref>።</char></note> <verse eid="1CO 6:16"/><verse number="17" style="v" sid="1CO 6:17"/>ቀርቺን ሜጡበ ገውስ መቱ አአኖ መንቹ እሲን ሜጡበ አያኒን መቱ እሀኖ።<verse eid="1CO 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18"/>ህካን እኮቤቺሃ ዝነተ አቶኖቼ፤ መኑ አአኖ ዎሉ ጩቡ ጅስሚችስ አብሊን እሀኖሃን፤ ጠዉ እኮጎሬ ዝነተ አአኖ መንቹ ገይስ ጅስም አሌን ጩብ አአኖ፤ <verse eid="1CO 6:18"/><verse number="19" style="v" sid="1CO 6:19"/>ጅስሙክዕኔ መገኒች ቶጌንታእለከ ኣዜንከክዕኔ ሄአኖ ጠሊሉ አያኑ ፎሎጨኖ ቤቹ እሁስ ደጌነንተበእንዶ? ቴሱ አዕኑ መገንረ ቤሉ ገይክዕኔረበአ።<note caller="-" style="x"><char style="xo" closed="false">6፥19 </char><char style="xt" closed="false"><ref loc="1CO 3:16">1 ቆሮ. 3፥16</ref>፤ <ref loc="2CO 6:16">2 ቆሮ. 6፥16</ref>።</char></note> <verse eid="1CO 6:19"/><verse number="20" style="v" sid="1CO 6:20"/>እስ ዋጊን ህዕርዮህዕኔ፤ ህካን እኮቤቺሃ ጅስምንከክዕኔ መገኑ ኬዕምሼ።<verse eid="1CO 6:20"/></para>
  <chapter eid="1CO 6"/>
  <chapter number="7" style="c" sid="1CO 7"/>
  <para style="s1">ጎጆሃ እህተኔሃ ኣሰንቶ ሸዘነተ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1"/>አዕኑ ከተቤንተኤ ጠዊተኔሃ እኮጎር መኑ ሜንቱ ኤቡዕነ ፈቆእቃ ጡመሃን። <verse eid="1CO 7:1"/><verse number="2" style="v" sid="1CO 7:2"/>ጠዉ እኮጎሬ ዝነተ አኢች አገዕርተኔሃ መት-መትሀስ ገይስ ጫት ሄኡንስ፤ ህትን ገዬተሴ ገይሴ ጨዉ ሄኡንሴ። <verse eid="1CO 7:2"/><verse number="3" style="v" sid="1CO 7:3"/>ምንሴ አኑ ገይስ ጫን ሜጡበ ኦሰአኖ ሀንቅሴ ከሙንከ፤ ህትን ጫንት ጨይንከሴ ሜጡበ ኦሰኣ ሀንቅስ ከንቱንከ። <verse eid="1CO 7:3"/><verse number="4" style="v" sid="1CO 7:4"/>ጫት ገይሴ ጅስም አሌን ሹምነቱ ዮሴበአ፤ እሴ ጅስም አሌን ሹምነቱ ዮሲሁ ጨዊሃሴት፤ ህትን ጨዉ ጅስምስ አሌን ሹምነቱ ዮስበአ፤ እስ ጅስም አሌን ሹምነቱ ዮሴሁ ጫታት።<verse eid="1CO 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 7:5"/>ህትን ዱአ አቶኖተ ኢተቀንቴን ቀዎ ወክቲሃ አገሩ እህባች ገገዉክዕኔ ከዕመቀንቶኖቼ፤ ህትን ገዉ አገዕሩ ሆግን ሼይጣኑ ሉሲሰኖህዕኔበእገ ፈንቀልቴን ሜጡበ እኬ። <verse eid="1CO 7:5"/><verse number="6" style="v" sid="1CO 7:6"/>ጠዉ እኮጎሬ አን ካን ያንክዕኔሁ ሸዘነገ ያንክዕኔ ቤሉ አዘዝጋበአ። <verse eid="1CO 7:6"/><verse number="7" style="v" sid="1CO 7:7"/>መኑ ጉዕሙንኩ ኢገ እኮ እቃን ኢታም እቅ፤ ጠዉ እኮጎሬ መገኑ መት-መትሀስ አደደ ኣስቱተ ኣሴእ፤ ህካን እኮቤቺሃ መትሀስ መቱ ኣስቱት ሄኣስ፤ ህትን ዎልሀስ ዎልት ኣስቱት ዮስ።<verse eid="1CO 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8"/>ምኒሃ እኮበእሩለከ ህትን ምንሰ አኑ ሬዮ ሜንቱሁ ኤቡዕነለከ ገልቱዕነ ኢገ እክ ሄኦ እቃን ጡመ እቅ። <verse eid="1CO 7:8"/><verse number="9" style="v" sid="1CO 7:9"/>ጠዉ እኮጎሬ ሄዕላቴነን ቡቢች ጎጆሃ እሁ ቆሀኖቤቺሃ ገዉሰ አታዕሉ ሆጋ ወክት ጎጆሃ እኩን።<verse eid="1CO 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10"/>ጎጆሃ እኮሀኑኡተ ኣሳም ትዛዙ ከኒት፤ ሁኩ ትዛዙንኩ ቀርቺሃ ቤሉ እሃበአ፤ ገልቶ ጫት ምንሴ አኒች መለዕለንቱንከ። <verse eid="1CO 7:10"/><verse number="11" style="v" sid="1CO 7:11"/>መለዕለንቶጎሬ ሜጥሃሴ ሄኡን ህከረንገ ጨይንከሴ ሀራዕረንት ሄኡን፤ ህትን ምንሴ አኑ ጫስ ገፈሩንከ።<note caller="-" style="x"><char style="xo" closed="false">7፥10-11 </char><char style="xt" closed="false"><ref loc="MAT 10:11-12">ማቶ. 10፥11-12</ref>፤ <ref loc="LUK 16:18">ሉቃ. 16፥18</ref>።</char></note><verse eid="1CO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12"/>ዎልሀስ ቀርቹ ኢስ እሁዕነ አን ያሚሁ መቶ አመዕኔ መንቺሃ አመዕንቶበእ መንቹት ዮስጎሬ እሴን ምንሴ አኒን ሜጡበ ሄኦተ ሀሶ ጎሬ ገፈሩንከ። <verse eid="1CO 7:12"/><verse number="13" style="v" sid="1CO 7:13"/>ህትን አመዕንዮበእ ምኒ አኑ ዮሴ መንቹት ምንሴ አኑ እሴን ሜጡበ ሄኦተ ሀሾ ጎሬ ገፈርቱንከ። <verse eid="1CO 7:13"/><verse number="14" style="v" sid="1CO 7:14"/>መሰንትስ አመዕንቡ ምኒ አኑ አመዕንቶ መንቾ መሳን መገኒሃ አደ እኮሃ እሀኖ፤ ህትን አመዕንቶበእ መንቹት አመዕንዮ ምንሴ መንች መሳን መገኒሃ አደ እኮሃ እካአ፤ ህካን እህባች እለክዕኔ መገኒሃ አደ እኮተ አታልታበአ፤ ጠዉ እኮጎሬ ከን ሃሊን ሄኤንተ ጎር ኦሱክዕኔ መገኒሃ አደ እኮሃ እካአ። <verse eid="1CO 7:14"/><verse number="15" style="v" sid="1CO 7:15"/>አመዕናንቹ እኮበእ አዱ አደ እሆተ ሀሾ ጎር አደ እሁን፤ ጠዉ እኮጎሬ ከን ወክቴን አመዕናንቹ እኮሁ ምኒ አነ እኮ ምኒ አመተ መቶርቾን ግዳጅሴኖሰበአ፤ መገኑ ገኤኔሁ ወገሬቲን ሄዕኖታት። <verse eid="1CO 7:15"/><verse number="16" style="v" sid="1CO 7:16"/>አት አመዕንቶንት ጫት አመዕንቡ ምንክ አነ ጡምሳንትጎር ሚን ደገን? ህትን አመዕንቶንት ምኒ አኑ! ምንክ አመተ አይደጎ ጡምሶተ አታልታ ጎሬ ሚን ደገን?<verse eid="1CO 7:16"/></para>
  <para style="s1">መገኑ ገአኖ ወክት ዮመ ሃሊን ተሬገጡ ሀሲሰኖ</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17"/>መት-መቱስ መገኑ ሄእ ዬስ ሃሊንለከ መገኑ ገኤስ ሃሊን ሄኡን፤ መገኑ አመዕኔ መን ጭምቲሃ ጉዕሚንከ ኣሴ ትዛዙ ከኒት። <verse eid="1CO 7:17"/><verse number="18" style="v" sid="1CO 7:18"/>ህትን ጡርከመሞች ኤተሮን አመዕኔ መንቹ አዪሁ ሄዕዮ ጎሬ ጡርከመሞበእሀንገ እሆተ ሰውዩንከ፤ ህትን ጡርከሙዕናን ሄጭ አመኔኢሁ ጡርከሚሃ ሀሱንከ። <verse eid="1CO 7:18"/><verse number="19" style="v" sid="1CO 7:19"/>መሰንትስ መገን ትዛዝ አገሩሃ ቤሉ ጡርከመሙ ህከረንገ ጡርከመሙ ሆጉ መቱርቹሃ ደግለለኖበአ። <verse eid="1CO 7:19"/><verse number="20" style="v" sid="1CO 7:20"/>ህካን እኮቤቺሃ ገገዉንኩስ መገኖን አመዕኔ ወክት ዮ ሃሌን ሄኡን። <verse eid="1CO 7:20"/><verse number="21" style="v" sid="1CO 7:21"/>ህትን አት መገኑ አመዕንቶንት ወክት ሮስቹሃ እቅንዶ? እኮንት እቃ ሆሮ ሰዉ ይቶት፤ እኮጎሬ ሰዎልድማን ፉልቶተ መኩተ ደእቶንት ጎር ሆሮ አጉርቶት። <verse eid="1CO 7:21"/><verse number="22" style="v" sid="1CO 7:22"/>መሰንትስ ሰዎልድማን ሄዕዮገ ቀርቹ አመዕኔ መንቹ ቀርቺን ሰዎልድቹሃን፤ ህትን አመዕነኖ ወክት ሰዎልድቹ እኮ መንቹ መሲህየ ሮስቹ። <verse eid="1CO 7:22"/><verse number="23" style="v" sid="1CO 7:23"/>አዕኑ መሲህ ኢስ ዋግን ህዕሬኔቤቺሃ መኒሃ ሮስ እኮኖቼ። <verse eid="1CO 7:23"/><verse number="24" style="v" sid="1CO 7:24"/>ህካን እኮቤቺሃ አመኤ ኦሶ! ጉዕሙንኩ መኑ ገአሞ ወክት ዮ ሀለቴን እክ መገኒን ሜጡበ ሄኡን።<verse eid="1CO 7:24"/></para>
  <para style="s1">ጎጆሃ እኮበእ መኒሃለከ ምንሰ አኑ ሬዮ ሜንቲሃ ሆንጠኮ ጠዕምቱተ</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25"/>ቴሱ ጎጆሃ እኮበእ መንተኔሃ ቀርቾ ኢሲች ቶጎም ትዛዙ ዮኤበአ፤ ጠዉ እኮጎሬ አመዕነሞሚሃ እሆተ መገኒች ማርቱተ ደኤም እኮቤቺሃ ገይኤ ሰዉት ኣሳንክዕኔ።<verse eid="1CO 7:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 7:26"/>ከን ዘማን ኦርሸተኔሃ መኑ ዮ ሃሌን ሄአኖረ ጡመ አጉደኖኤት። <verse eid="1CO 7:26"/><verse number="27" style="v" sid="1CO 7:27"/>ህካን እኮቤቺሃ ጎጆሃ እኮንትጎር ሸርቶተ ሀሶት፤ ጎጆሃ እኩዕነ ዮንት ጎር ኤቦተ ሀሶት። <verse eid="1CO 7:27"/><verse number="28" style="v" sid="1CO 7:28"/>ጠዉ እኮጎሬ አት ጎጆሃ እኮንትጎር ጩብ እሀኖ ዩሃበአ፤ ህትን መት ሀፍቱት ጎጆሃ እኮ እቃን ጩብ እሀኖሴ ዩሃበአ፤ እሁን ቤሉ ጎጆሃ እካ መኑ ከን ኣዱንያ አሌን አበ ኦርጨቀንታአ፤ አዕኑ ከኒች ፈቄንታ እቃን ኢታም እቅ። <verse eid="1CO 7:28"/><verse number="29" style="v" sid="1CO 7:29"/>አመኤ ኦሶ! ዘማኑ ገበንቹ እኮቤቺሃ ከን ወክቲች ጀመር ምኒ አመት ዮሲሁ ምኒ አመት ዮስበእሀንገ እክ ሄኡን፤ ምኒ አማኑት ዮሰሩ ዮሰበእሀንገ እክ ሄኡን። <verse eid="1CO 7:29"/><verse number="30" style="v" sid="1CO 7:30"/>ህትን ሻዛሩ ሻዛበእገ እክ ሄኡን፤ ሙንደኣእሩ ሙንደኣበእገ እክ ሄኡን፤ ኦዳተ ህዕርታሩ ኦዳተ ዮሰበእሀንገ እክ ሄኡን። <verse eid="1CO 7:30"/><verse number="31" style="v" sid="1CO 7:31"/>ህትን ከን ኣዱንያ አሌን ዮኢሃ ገይሳሃ አታሩ ጉዕሙንኩ ደግለሸቀንታበእገ እክ ሄኡን፤ መሰንትስ ከን ኣዱንያ አሌን ዮኢሁ ጉዕሙንኩ ህገኖሃን።<verse eid="1CO 7:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32"/>አዕኑ ሻዞኑዕናን ህከኒሃ ሄኦኖተ ኢታም፤ ጎጆሃ እኮበእ መንቹ ቀርቹ ሙንዲሲሰኖ ጠወሃ ሀሰኖቤቺሃ ቀርች ጠዊተኔሃ ሰዉ የኖ። <verse eid="1CO 7:32"/><verse number="33" style="v" sid="1CO 7:33"/>ጠዉ እኮጎሬ ጎጆሃ እኮ መንቹ ምንስ አመተ ሙንዲሲሰኖ ጠወ ሀሰኖቤቺሃ ከን ኣዱንያ አል ጠዊተኔሃ ሰውየኖ። <verse eid="1CO 7:33"/><verse number="34" style="v" sid="1CO 7:34"/>ህከን መንች ቀልቡንኩ ለሙ አደ እኮእሃን፤ ህትን ጎጆሃ እኮበእ መንቹት ህከረንገ ሀፍቱት ማሉሴለከ ሩሁሴ ጠሊለ እክ ቀርቺሃ እኮተ ሰዉ ይታቤቺሃ ሰውቱሴ ጉዕሙንኩ ቀርች ሆጎ አሌኒት፤ ጎጆሃ እኮ መንቹት ጫሴ ሙንዲሲሶተ ሀሳቤቺሃ ከን ኣዱንያ አል ጠዊተኔሃ ሰዉ ይታአ። <verse eid="1CO 7:34"/><verse number="35" style="v" sid="1CO 7:35"/>አን ህት ዬንክዕኔሁ ዎሻዲን አፎህዕኔተ እሁዕነ ክዕኔሃ ደግለለኖ ይዪት፤ ህትን ሀስሰኖ ሃሊን ሄኦኖታትለከ ሰዊቱክዕኔ ብንዩዕናን ዊመ ቀልቢን ቀርቾ ኢሳን ጠረኝቴን ሄኦኖታት።<verse eid="1CO 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36"/>መቱ መንቹ ኢተቀሞ ጩልተ መዕሲሰንታ ጌሰ እኮ ወክት ገዉስ አታዕሉ ሆጊን ኣኦተ ሀሾ ጎሬ ከመኖስ ጠዉ ዮበአ፤ እሴንተ ኣኡን፤ ሁኩን ጩብያበአ። <verse eid="1CO 7:36"/><verse number="37" style="v" sid="1CO 7:37"/>ጠዉ እኮጎሬ አዪሁ ኢተቀሞ ጩልተ ኣኦተ ግዳጅሰኖስ ጠዉ ዮስበእጎሬ ኣኡዕነ ዱንኮተ አታሎጎሬ ጠወስ ቀልቤንከስ ሙርሲጬኢች ሁኩ መንቹ ጡመ አዕዮኡ። <verse eid="1CO 7:37"/><verse number="38" style="v" sid="1CO 7:38"/>ህካን እኮቤቺሃ ጠዕሜ ጩልተ ኣኡስ ጡመ አዕዮኡ፤ ጠዉ እኮጎሬ አኡነ ፈቆሁ ቆሀኖሃ አዕዮኡ።<verse eid="1CO 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39"/>መት መንቹት ጨዉሴ ፎሊን ዮ ጌሳን ንክን ኡሱረንቶእተ፤ እኮጎሬ ምንሴ አኑ ሬዮ ወክት ገልታ መንቹ አመዕናንቹ እሁን ቤሉ ሀሶሀኒን ገልቶተ አታልታአ። <verse eid="1CO 7:39"/><verse number="40" style="v" sid="1CO 7:40"/>ጠዉ እኮጎሬ አን ሰውያም ሃሌን ህት ጫት ገልቱዕናን ሄኦ እቃን አበ ሙንዲኖን ሄኣ እቅ፤ ህትን ኤሳሃ መገን አያኑ ዮኤሃ አጉደኖኤት።<verse eid="1CO 7:40"/></para>
  <chapter eid="1CO 7"/>
  <chapter number="8" style="c" sid="1CO 8"/>
  <para style="s1">ሽርኬተ ክትመሞ ማልተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1"/>ሽርኬተ ክትመሞ ማልተኔሃ ጉዕሚንከኔ ኤንኬዕኑ ዮኔ፤ ኤንኬዕኑ ቦንሲሰኖ፤ እኮጎሬ ኢተት ጠረኝሳአ። <verse eid="1CO 8:1"/><verse number="2" style="v" sid="1CO 8:2"/>መቱ መንቹ «ኤንኬዕኑ ዮኤ» ይ ሰዉ ዬጎሬ ሁኩ መንቹ ደጉ ሀስሰኖስ ጌሰ ሆሮ ደጎበአ። <verse eid="1CO 8:2"/><verse number="3" style="v" sid="1CO 8:3"/>ጠዉ እኮጎሬ መቱ መንቹ መገኑ ኢቴስጎሬ ሁኩ መንቹ መገን ቤቾን ኤንኬዕነሞሃን።<verse eid="1CO 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4"/>ህካን እኮቤቺሃ ሽርኬተ ክትመሞ ማለ እትተኔሃ እኮጎሬ ሽርክተ ጉዕሙንኩ ከን ኣዱንያ አሌን ሄእባሃ እሁሰለከ መቶ መገን ቤሉ ዎሉ መገኑ ሄእባሃ እሁስ ደንጋም። <verse eid="1CO 8:4"/><verse number="5" style="v" sid="1CO 8:5"/>መሰንትስ ልግቡ ሽርክትለከ ልግቡ ቀርቹ እኮእሩ ዮኡ፤ ጠዉ እኮጎሬ ሄንከ ሰማንለከ ኡላን «መገኑ» ዬኖሰሩ ሄኦ ጎሬ <verse eid="1CO 8:5"/><verse number="6" style="v" sid="1CO 8:6"/>ጠዉ እኮጎሬ ኒ መገኑ ጉዕመርቹንከ ከለቆለከ ነኡሁ እሲሃ እንኮምሩ መቱ መገኑ አነ እኮኔሁ ዮኔ፤ ህትን ጉዕሙርቹንኩ እስ አዲን ከለቀሞለከ ነኡሁ እሲን ሄዕናም መቱ ቀርቹ መሲህ ኢስ ጠለዕል ዮኔ።<verse eid="1CO 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7"/>ጠዉ እኮጎሬ ካን ጉዕሙ መኑ ደገኖበአ፤ መት-መቱ ከበሬ እለ ሽርኬን ሮሰቀንቶቤቺሃ ማለ እታኢሁ ሽርኬተ ክትሜመሀኒገ አት ሰዉ ይታቤቺሃት፤ ህካን እኮቤቺሃ ቀልቡሰ ላፈ እኮቤቺሃ ንጃሳአ። <verse eid="1CO 8:7"/><verse number="8" style="v" sid="1CO 8:8"/>ኔሳሃ መገን አደ ሆንጠህሰኖኔሁ እቸተበአ፤ እንትበጎሬ ጤዕየኖኔርቹ ዮበአ፤ እንቶምእቃ በርገመኖኔርቹ ዮበአ። <verse eid="1CO 8:8"/><verse number="9" style="v" sid="1CO 8:9"/>ጠዉ እኮጎሬ ሁኩ ሰዎልድመኔ አመዕነቲን ጠረኝቶበእ መኒሃ ሉስሰኖሃ እሀኖሰበእገ አገዕርዬ። <verse eid="1CO 8:9"/><verse number="10" style="v" sid="1CO 8:10"/>መሰንትስ አዪሁ አት ኤንኬዕኑ ዮኤ ይታንቲሁ ሽርኬ ምኔን ማዳን አፉዕልት እተን አመዕነቲን ጠረኝቡ መንቹ ለዕዮሄጎሬ ሽርኬሃ ክትሜመ ማለ እቶተ መለለኖገ አታንትበእንዶ? «ኤንኬዕኑ ዮኤ» ይት ሽርኬተ ክትመሞ ማለ እተኖገ ሀንበለንሰኖስበእንዶ? <verse eid="1CO 8:10"/><verse number="11" style="v" sid="1CO 8:11"/>ህካን እኮቤቺሃ መሲህ እስተኔሃ ሬዮ ሁኩ አመዕነቲን ላፉ መንቹ ኪ ኤንኬዕኒን በአኖ ዩሃን። <verse eid="1CO 8:11"/><verse number="12" style="v" sid="1CO 8:12"/>ከን ሃሊን አመዕናኖ አሌን ጩብ አቴነንተለከ ላፈሰ ሰዉት ጡላይሴነንተ ወክት መሲህ አሌን ጩብ አቴነንታት ዩሃን። <verse eid="1CO 8:12"/><verse number="13" style="v" sid="1CO 8:13"/>ህካን እኮቤቺሃ እቸት አመዕናንቹ አመኤ ቤቲሃ ጉፍቹ እሀኖሃ እኮች አመኤቤቱ ሉስሳምሀኒች ማለ ሆሮ እታምበአ።<verse eid="1CO 8:13"/></para>
  <chapter eid="1CO 8"/>
  <chapter number="9" style="c" sid="1CO 9"/>
  <para style="s1">አሳበት አኡ ሀስሰኖ ጠውተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1"/>አን ሰዎልድቹሃበእንዶ? ህትን አን አሳቤቹሃበእንዶ? አን ቀርቹኔ ኢሰ ለእዮንስበእንዶ? አዕኑንገ ቀርቹሃ ኢሲን አዕዮም ሆጎእየ ላልቹበእንዶ? <verse eid="1CO 9:1"/><verse number="2" style="v" sid="1CO 9:2"/>ቀርቹሃ ኢሲን አዕኑ ኤሳሃ አሳቤቹ እህእ መላተ እኬንተቤቺሃ ዎሎ መኒሃ ሶቀማንቹ እህበጎሬ አን ክዕኔሃ ሀንቅንከ አሳቤቹሃን።<verse eid="1CO 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3"/>ሱዕመኤ ቤሳ መኒሃ ፈንቀሻም መስሉ ከኒት። <verse eid="1CO 9:3"/><verse number="4" style="v" sid="1CO 9:4"/>ኔሳሃ እቲሃለከ አጊሃ ሀንቁ ዮኔበእንዶ? <verse eid="1CO 9:4"/><verse number="5" style="v" sid="1CO 9:5"/>ዎሎ አሳበገለከ ቀርቹሃ ኢስ አመ ኦሶገ ህትን ጴጥሮሴገ መገኑ አመዕንቶ ምኒኔ አማኑተ አዎንስን ሜጡበ ሃሞተ ሀንቁ ዮኔበእንዶ? <verse eid="1CO 9:5"/><verse number="6" style="v" sid="1CO 9:6"/>ህከረንገ ሆጎን አጰመን ሄኡ ሀስሰኖኔሁ ጠለዕል አንለከ በርናባሴቲንዶ? <verse eid="1CO 9:6"/><verse number="7" style="v" sid="1CO 9:7"/>ገይስ ብሪን ዎታደርቹ እክ አአኖ መንቹ ሄአኖንዶ? ህትን ዎይን ሀቀ ካሽ ላልቹስ እትባሁ አዬት? ህትን ለሉ ጠቅ ለልስ አዙተ አገኖበእሁ አዬት?<verse eid="1CO 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 9:8"/>አን ከ ጠወ ጠወኣሚሁ መኑ ሰውየኖ ሃሊንትንዶ? ሕጉሁ ህት የኖበእንዶ? <verse eid="1CO 9:8"/><verse number="9" style="v" sid="1CO 9:9"/>መሰንትስ «ዉጠተ ዎቀሬኖ ቦር አፎስ ኡሱርቶት» የመም ሙሲ ሕጋን ከተበሞኡ፤ መገኑ ህካን ዬኢሁ ቦረተኔሃ ሰውየኖቤቺሃትንዶ?<note caller="-" style="x"><char style="xo" closed="false">9፥9 </char><char style="xt" closed="false"><ref loc="DEU 25:4">ዘዳ. 25፥4</ref>፤ <ref loc="1TI 5:18">1 ጢሞ. 5፥18</ref>።</char></note> <verse eid="1CO 9:9"/><verse number="10" style="v" sid="1CO 9:10"/>መገኑ ህካን ዬኢሁ ኒተኔሃበእንዶ? ለሙንኩ ዉጣች ወጥሰ ደእቶተ አቡረኖሁ ተብሴን አቡረኖቤቺሃ፥ ዉጠተ ዎቀረኖንኩ ተብሴን ዎቀረኖቤቺሃ ሁኩ ጠዉ ከተበሞሁ ሀንቅንከ ኒተኔሃት። <verse eid="1CO 9:10"/><verse number="11" style="v" sid="1CO 9:11"/>ነኡ ክዕኔ በላን መገን ጠወ ዉንጣምረ እንኮሚች ኔሳሃ ማሊሃ ደግለለኖርቹ ኣእኖም ጎሬ ሁኩን ሎረ ጠወንዶ?<note caller="-" style="x"><char style="xo" closed="false">9፥11 </char><char style="xt" closed="false"><ref loc="ROM 15:27">ሮሜ 15፥27</ref>።</char></note> <verse eid="1CO 9:11"/><verse number="12" style="v" sid="1CO 9:12"/>ዎሉ መኑ ክዕኔች ሀስሰኖሳሃ ኣእቶተ አታልታኢሃ እኮች ነኡ በትንስ ኣኡ ሀስሰኖኔበእንዶ? ጠዉ እኮጎሬ መሲህ ተሽት ላገት አልባዕልታቤቹ ከማምበእገ ይን ጉዕመ ጠወንከ አታዕልናም ቤሉ ኔሳሃ ሀስሰኖኔርቹሃ ኣእኖተ ሀንሶምበአ። <verse eid="1CO 9:12"/><verse number="13" style="v" sid="1CO 9:13"/>መገን ምኔን አታ መኑ እታኢሃ መገን ምኒች ደእታገለከ መገኒሃ ክትም ሆንጠህሴኖ ጠረጴዚች መኑ ክትሚሃ ሆንጠህሴመርቺች ቤቀንት እታኢሃ ደጌነንተበእንዶ?<note caller="-" style="x"><char style="xo" closed="false">9፥13 </char><char style="xt" closed="false"><ref loc="DEU 18:1">ዘዳ. 18፥1</ref>።</char></note> <verse eid="1CO 9:13"/><verse number="14" style="v" sid="1CO 9:14"/>ህከንገን ተሽት ላገተ ዱዱብስታ መኑ ተሽት ላገ ሆጎች ርስቀሰ ደእታገ ቀርቹ አዘዦኡ።<note caller="-" style="x"><char style="xo" closed="false">9፥14 </char><char style="xt" closed="false"><ref loc="MAT 10:10">ማቶ. 10፥10</ref>፤ <ref loc="LUK 10:7">ሉቃ. 10፥7</ref>።</char></note><verse eid="1CO 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15"/>እኮጎሬ አን ከን ጉዕማንከ ሀንቂች መቶንከስ ደግለሸቀሞምበአ፤ ቴሱ ከተባሚሁ ህትኔ ጠዉ እሆኤተ ሀሽበአ፤ መሰንትስ አን ድከኣም ጠወ አዪሁ ተሰ አአኖሀኒች ሬሁ ቆሀኖኤ። <verse eid="1CO 9:15"/><verse number="16" style="v" sid="1CO 9:16"/>ህትን ተሽት ላገተ ዱዱብሱ ኤሳሃ ግደ እኮቤቺሃ ተሽት ላገተ ዱዱብሲንከኤ ቦናምርቹ ዮኤበአ፤ ህካን እኮቤቺሃ ተሽት ላገተ ዱዱብስበጎሬ ኤሳሃ ኣዬ! <verse eid="1CO 9:16"/><verse number="17" style="v" sid="1CO 9:17"/>መሰንትስ አን ገዉእ ኢት እንጂለ ዱዱብሳሚሃ እኮምጎሬ ዋጉ ዮኤ፤ ጠዉ እኮጎሬ ግዲን አኣሚሃ እኮምጎሬ ኤገት ኣሰንቶኤቤቺሃ አኣሚት ዩሃን። <verse eid="1CO 9:17"/><verse number="18" style="v" sid="1CO 9:18"/>ህከረ ሆጎኤ ዋጉ መርቹሃን? ቴሱ ሆጎኤ ዋጉ ተሽት ላገተ ተማርሴምቤቺሃ ዮኤ ሀንቅ ደግለሸቀሙዕናን እንጂለ ተማርሳም ሆጉኤን ደሞዝ ቤሉ ተማርሱሃን።<verse eid="1CO 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19"/>መኒች ጉዕሚችን ሰዎልድቹ እኮምጎሬሁ ልግብ መነ ፈይሶተ ይ መኒሃ ጉዕሚንከ ገጉኤ ሮስቹ አዕዮም። <verse eid="1CO 9:19"/><verse number="20" style="v" sid="1CO 9:20"/>ህትን አይሁድ መነ ጡምሶተ ይ አይሁዲሃ አይሁድገን እኮም፤ ህትን ሕግ ኣዜን ሄዕበጎሬሁ ሕግ ኣዜን ሄኦእረ ጡምሶተ ይ ሕግ ኣዜን ዮ መንገ እኮም። <verse eid="1CO 9:20"/><verse number="21" style="v" sid="1CO 9:21"/>ህትን ሕጉ ዮበእ መነ ጡምሶተ ይ መገን ሕጉ ዮኤሃለከ መሲህ ሕግ ኣዜን ሄዕዮሚሃ እኮምገን ሕጉ ዮበእ አይሁደ እኮበእ መኒሃ ሕጉ ዮበእ መንገን እኮም። <verse eid="1CO 9:21"/><verse number="22" style="v" sid="1CO 9:22"/>ህትን አመዕነቲን ላፈ መነ ጡምሶተ ይ ላፈ መኒሃ ላፈ መንገን እኮም፤ አታልሲሾኤ ጌሲን ቀዉ መነ ጡምሶተ ይ ጠዋን ጉዕማንን መኒሃ እሰገን እኮም።<verse eid="1CO 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 9:23"/>አን ተሽት ላገ ማሰተ ቤቀማንቹ እሆተ ይ ተሽት ላገተኔሃ ህከ ጉዕመንከ ጠወ አዕዮም። <verse eid="1CO 9:23"/><verse number="24" style="v" sid="1CO 9:24"/>ሄጫቀሜኖቤቾን ደጉደኖሁ ጉዕሙንኩ ሄጫቀመኖገለከ ጠለዕል ሜጥቹስ ሽልማት ኣአኖገ ደጌነንተበእንዶ? ህትን ሽልማት ደእቶኖተ ሄጫቀሜ። <verse eid="1CO 9:24"/><verse number="25" style="v" sid="1CO 9:25"/>ሄጫቀመኖሁ ጉዕሙንኩ ጉዕመርቾንን ጅስመስ ጠረኝሽ ቅጥአአኖ፤ እሰን ህት ሆጋኢሁ በአኖሃለከ ወክቲሃስ እሀኖ ሽልማት ደኢሃት፤ እኮጎሬ ነኡ ሆንጋሚሁ በአኖበኢሃለከ ዘላለሚሃ እሀኖ ሽልማት ደኢሃት። <verse eid="1CO 9:25"/><verse number="26" style="v" sid="1CO 9:26"/>ህካን እኮቤቺሃ አን ሰውቱ ዮበእ መንገ ደጉዳምበአ፤ ህትን ቦብረ ጡንጤን ዎቀረኖ መንችገ ጠለዕለ አኣምበአ። <verse eid="1CO 9:26"/><verse number="27" style="v" sid="1CO 9:27"/>ጠዉ እኮጎሬ ዎሎ መኒሃ ዱዱብሴሚች ኤተሮን ገጉእ ኡቦሚሃ እሃምበእገ አልኤ ቀጠአን አዘዘመኖኤገ አኣም።<verse eid="1CO 9:27"/></para>
  <chapter eid="1CO 9"/>
  <chapter number="10" style="c" sid="1CO 10"/>
  <para style="s1">ሽርኬተ ሰገዱ ገበእባሃ እሁስ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1"/>አመኤ ኦሶ! አናከኔ ጉዕሙንኩ ጎመት አሊን እክ አዎንስተንሰ ጉዕሙንኩ ባረ ቶልቶገ ደጎኖተ ሀሳም።<note caller="-" style="x"><char style="xo" closed="false">10፥1 </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">ፉል. 13፥21-22</ref>፤ <ref loc="EXO 14:22-29">14፥22-29</ref>።</char></note> <verse eid="1CO 10:1"/><verse number="2" style="v" sid="1CO 10:2"/>እሰን ጉዕሙንኩሰ ሙሲን ሜጡ እኮተ ይት ጎማንለከ ባራን ጠመቀንቶኡ። <verse eid="1CO 10:2"/><verse number="3" style="v" sid="1CO 10:3"/>ህትን ጉዕሙንኩሰ መቱ ደነ ሰሜ እቸተ እቶኡ።<note caller="-" style="x"><char style="xo" closed="false">10፥3 </char><char style="xt" closed="false"><ref loc="EXO 16:35">ፉል. 16፥35</ref>።</char></note> <verse eid="1CO 10:3"/><verse number="4" style="v" sid="1CO 10:4"/>ህትን ጉዕሙንኩሰ መቱ ደነ ሰሜ አጌኖሃ አጎኡ፤ አጎኢንኩ አዎነንሰ ሄዕዮ ሰሜ ክኒች ቡቆኢሃ እቅ፤ ሁኩ ክኑንኩ መሲህት እቅ።<note caller="-" style="x"><char style="xo" closed="false">10፥4 </char><char style="xt" closed="false"><ref loc="EXO 17:6">ፉል. 17፥6</ref>፤ <ref loc="NUM 25:1-18">ዘኁ. 25፥1-18</ref>።</char></note> <verse eid="1CO 10:4"/><verse number="5" style="v" sid="1CO 10:5"/>እኮጎሬ እሰ ኡለ ኡዱማን ጎፎቤቺሃ መገኑ እሳች ልግብንከሰ ሙንደዕዮበአ።<note caller="-" style="x"><char style="xo" closed="false">10፥5 </char><char style="xt" closed="false"><ref loc="NUM 14:29-30">ዘኁ. 14፥29-30</ref>።</char></note><verse eid="1CO 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6"/>እሰ ሂለርቹ ሄዕላቶገን ነኡ ሂለርቹ ሄዕላንታምበእገ ኩ ጠዉ ጉዕሙንኩ አገዕርናምገ ምሳልተ እኮኔ።<note caller="-" style="x"><char style="xo" closed="false">10፥6 </char><char style="xt" closed="false"><ref loc="NUM 11:4">ዘኁ. 11፥4</ref>።</char></note> <verse eid="1CO 10:6"/><verse number="7" style="v" sid="1CO 10:7"/>መጻፋን «መኑ እቶተለከ አጎተ አፉዕልቶኡ፤ ቦሎቸ ከዲሃ ኬኦኡ»<note caller="+" style="f"><char style="fqa" closed="false">ዳንሰ ደነሲሃ፦ </char><char style="ft" closed="false">ዩ ግርክ መጻፋን አለሻተ የኖ፤ ህካን ዩ ሽርኬተ ሰገዱሰለከ ዝነተ አኡሰ ለሊሰኖ።</char></note> የመም ከተበሞገን እሳች መት-መቱሰ ሽርኬተ ሰገዳእረ እኮገን አዕኑሁ ሽርኬተ ሰገዴነንተረ እኮኖቼ።<note caller="-" style="x"><char style="xo" closed="false">10፥7 </char><char style="xt" closed="false"><ref loc="EXO 32:6">ፉል. 32፥6</ref>።</char></note> <verse eid="1CO 10:7"/><verse number="8" style="v" sid="1CO 10:8"/>እሳች መት-መቱሰ ዝነተ አት መቶ በሬን ለሞድምኔ ሰሶ ኩሜ መኑ ሬቶገን ነኡሁ ዝነተ አዕኑንከ።<note caller="-" style="x"><char style="xo" closed="false">10፥8 </char><char style="xt" closed="false"><ref loc="NUM 25:1-18">ዘኁ. 25፥1-18</ref>።</char></note> <verse eid="1CO 10:8"/><verse number="9" style="v" sid="1CO 10:9"/>ህትን እሳችን መት-መቱሰ ቀርቹ<note caller="+" style="f"><char style="fqa" closed="false">ቀርቹ፦ </char><char style="ft" closed="false">የኖሁ ግርክ መጻፉ «መሲህ» የኖ።</char></note> ፌተንቶገለከ ዎሪቹ ከር ሼሰገን ነኡሁ ቀርቹ ፌተኑንከ።<note caller="-" style="x"><char style="xo" closed="false">10፥9 </char><char style="xt" closed="false"><ref loc="NUM 21:5-6">ዘኁ. 21፥5-6</ref>።</char></note> <verse eid="1CO 10:9"/><verse number="10" style="v" sid="1CO 10:10"/>ህትን እሳች መት-መቱሰ ቁንቁቶገለከ ቤሳንቹ መላይኬቹ ቤሾሰገን አዕኑሁ ቁንቁቶኖቼ።<note caller="-" style="x"><char style="xo" closed="false">10፥10 </char><char style="xt" closed="false"><ref loc="NUM 16:41-49">ዘኁ. 16፥41-49</ref>።</char></note><verse eid="1CO 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11"/>ኩ ጉዕሙንኩ ጠዉ እሰ አሌን እሁስ መጨረሽ ዘማኔን ሄዕናም ነኡ አገዕርኖተ ትምርተ እክ ከተበሞኔ።<verse eid="1CO 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 10:12"/>ህካን እኮቤቺሃ ጠረኝ ኡሬኢሃ አጉደኖሲሁ አዪሁ ኡበኖበእገ ገውስ አገዕሩን። <verse eid="1CO 10:12"/><verse number="13" style="v" sid="1CO 10:13"/>መናን ኢለኖሀኒች አደ እኮ ኦርሸት ክዕኔ አሌን ኢልቶህዕኔበአ፤ መሰንትስ ዎልቃችክዕኔ ሎረ እኮ ዎቄን ኦርጨቀንቶኖተ ሰውየኖ መገኑ አመዕነሞእሃን፤ እስን ኦርሸስ አታዕል አታልቶኖተ ኦርሻንከስ ሜጡበ ኦርሻችስ ፉልቴነንተ ዎቃሃ ቅጥ አዕዮኡ።<verse eid="1CO 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14"/>ቴሱ ኢ ጃላ! ሽርኬተ ሰገዲች አገዕርዬ። <verse eid="1CO 10:14"/><verse number="15" style="v" sid="1CO 10:15"/>ህካንን ያሚሁ ዘህጭቴነንተረ እኬንተቤቺሃት፤ ህካን እኮቤቺሃ ጠወዕዮም ጠውተኔሃ አዕኑ ገዉክዕኔ ፈረጄ። <verse eid="1CO 10:15"/><verse number="16" style="v" sid="1CO 10:16"/>ነኡ መገኑ ገለትጭን አንጋም ማሰአሞ ጠበቴሁ መሲህ ቄጊን መቱሃበእንዶ? ህትን ሜጡበ እንታም ዳቡት መሲህ ጅስሚን መቱሃበእንዶ?<note caller="-" style="x"><char style="xo" closed="false">10፥16 </char><char style="xt" closed="false"><ref loc="MAT 26:26-28">ማቶ. 26፥26-28</ref>፤ <ref loc="MRK 14:22-24">ማር. 14፥22-24</ref>፤ <ref loc="LUK 22:19-20">ሉቃ. 22፥19-20</ref>።</char></note> <verse eid="1CO 10:16"/><verse number="17" style="v" sid="1CO 10:17"/>መሰንትስ ዳቡስ ሜጥተ እኮቤቺሃለከ ህከን መቴ ዳቦች ቤቀማምቤቺሃ መሃ ልግብ መነ እንኮምጎሬሁ ነኡ መቶሃ ጅስመ።<verse eid="1CO 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18"/>ህንዴ እስራኤል ኡመትተኔሃ ሰውይዬ፤ ክትሜኖርቹ እታ መኑ መገኒሃ ክትም ሆንጠህሴኖ ጠረጴዚን ሜጡበ ዮረበእንዶ?<note caller="-" style="x"><char style="xo" closed="false">10፥18 </char><char style="xt" closed="false"><ref loc="LEV 7:6">ሌዌ 7፥6</ref>።</char></note> <verse eid="1CO 10:18"/><verse number="19" style="v" sid="1CO 10:19"/>ህከረ ህካን ያም ወክት ሽርኬተ ክትሜመ ማሉ ቆሀኖርቹ ዩሃስንዶ? ህከረ ሽርክት ቆካአ ዩሃኤንዶ? <verse eid="1CO 10:19"/><verse number="20" style="v" sid="1CO 10:20"/>ህትጎተበአ፤ ሀንቅ መገኑ ደግቡ መኑ ክትም ሆንጠህሳኢሁ ሩሃንይሃት ቤሉ መገኒሃበአ፤ ህካን እኮቤቺሃ አዕኑ ሩሃንዪን ሜጡ እኮኖተ ሀሳምበአ።<note caller="-" style="x"><char style="xo" closed="false">10፥20 </char><char style="xt" closed="false"><ref loc="DEU 32:17">ዘዳ. 32፥17</ref>።</char></note> <verse eid="1CO 10:20"/><verse number="21" style="v" sid="1CO 10:21"/>ህትን አዕኑ ቀርች ጠበቴች አጌነን ሩሃንይ ጠበቴች አጎኖተ አታልቴነንተበአ፤ ህትን ቀርች ማዲችለከ ሩሃንይ ማዲች ቤቀንቶኖተ አታልቴነንተበአ። <verse eid="1CO 10:21"/><verse number="22" style="v" sid="1CO 10:22"/>ቴሱ ነኡ መገኑ ኡሙርሲንሱንዶ? ነኡ እሲች አበ ጠረኝናምንዶ?<note caller="-" style="x"><char style="xo" closed="false">10፥22 </char><char style="xt" closed="false"><ref loc="DEU 32:21">ዘዳ. 32፥21</ref>።</char></note><verse eid="1CO 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23"/>ጉዕሙርቹንኩ ፈቀደሞኡ፤ እኮጎሬ ጉዕሙርቹንኩ ደግለለኖበአ፤ ህትን ጉዕመ ጠወ አኢሃ አታሌኖ፤ እኮጎሬ ጉዕሙርቹንኩ ጠረኝሰኖበአ።<note caller="-" style="x"><char style="xo" closed="false">10፥23 </char><char style="xt" closed="false"><ref loc="1CO 6:12">1 ቆሮ. 6፥12</ref>።</char></note> <verse eid="1CO 10:23"/><verse number="24" style="v" sid="1CO 10:24"/>አዪሁ ገይስ መኩተ ጠለዕል እሁዕነ ዎሎ መን መኩተ ሀሱን።<verse eid="1CO 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25"/>ቀልቢችክዕኔ ኬኣ ሸክተ ከንቴን እኮስ ጌባን ህሬኖ ማላ ለሞሶኑዕናን እቼ። <verse eid="1CO 10:25"/><verse number="26" style="v" sid="1CO 10:26"/>መሰንትስ ዱንያ አሌንለከ ኣዜሴዮርቹ ጉዕሙንኩ ቀርችሃን።<note caller="-" style="x"><char style="xo" closed="false">10፥26 </char><char style="xt" closed="false"><ref loc="PSA 24:1">መዝ. 24፥1</ref>።</char></note><verse eid="1CO 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27"/>መገኑ አመዕንዮበእ መኒች መቱ እቴኖሃ ቅጥ አዕይ ገኤጎሬ አዕኑ መርቶኖተ ሀሴንተ ጎሬ ኣሴመህኔሃ ጉዕመንከ ቀልቤንከክዕኔ ለሞሶኑዕናን እቼ። <verse eid="1CO 10:27"/><verse number="28" style="v" sid="1CO 10:28"/>ጠዉ እኮጎሬ አዪሁ «ኩ ማሉ ሽርኬተ ክትመሞኢሃን» ዬህዕኔጎሬ ህከ ኩሎህዕኔ መንች መሳንለከ ቀልብ ዎቀሸ ሰውትተኔሃ እቶኖቼ። <verse eid="1CO 10:28"/><verse number="29" style="v" sid="1CO 10:29"/>ህካን ዬሚሁ መንች ቀልብ ሰውትተኔሃት ቤሉ ኪ ቀልብ ሰውትተኔሃትበአ፤</para>
  <para style="p" vid="1CO 10:29">መሰንትስ ዎሎ መን ቀልብ ሰውትተኔሃ ኢ ሰዎልድማን ፈረዴኖሁ ሚሃት? <verse eid="1CO 10:29"/><verse number="30" style="v" sid="1CO 10:30"/>ህትን አን መገኑ ገለትጨን እቾምጎሬ ህከ መገኒሃ ገለት ኣሳም ጠዋን ዎቀሸተ አኤኖኤሁ ሚሃት?<verse eid="1CO 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31"/>ቴሱ እቴንተጎሬ አጌንተጎሬ መሃ አቴንተጎሬ ጉዕመንከ መገን ኬዕምኚሃ አዕዬ። <verse eid="1CO 10:31"/><verse number="32" style="v" sid="1CO 10:32"/>አይሁደ እኮ፥ አይሁደ እኮበእ እኮ፥ አመናኖ ጭምት ምኒ እኮ፥ አዬሁ ቆዕለኖገ አቶኖቼ። <verse eid="1CO 10:32"/><verse number="33" style="v" sid="1CO 10:33"/>አን ጉዕሙንኩሰ ጡምቶተ ዎሎ መን ጥቅም ቤሉ ገይኤ ጥቅም ሀሱዕነ መነ ጉዕመንከ አኣም ጠዋን ጉዕማንን ሙንዲሲሳምገን አዕኑሁ ህትን አዕዬ።<verse eid="1CO 10:33"/></para>
  <chapter eid="1CO 10"/>
  <chapter number="11" style="c" sid="1CO 11"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1"/>አን መሲህ አጉዳምገን አዕኑሁ ኤሳሃ አጉጄ።<note caller="-" style="x"><char style="xo" closed="false">11፥1 </char><char style="xt" closed="false"><ref loc="1CO 4:16">1 ቆሮ. 4፥16</ref>፤ <ref loc="PHP 3:17">ፍልጵ. 3፥17</ref>።</char></note><verse eid="1CO 11:1"/></para>
  <para style="s1">ዱአ አኤኖ ወክት አኡ ሀስሰኖ ጠዊተኔሃ</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2"/>ጉዕመ ወክት ቃጌነንተኤቤቺሃለከ ክዕኔሃ ኣሴም ትምርተ ጠረኝቴን አፌነንተቤቺሃ ገለትጫንክዕኔ። <verse eid="1CO 11:2"/><verse number="3" style="v" sid="1CO 11:3"/>ጠዉ እኮጎሬ ጎንች ቡዕሉ መሲህ እሁሲ፥ መንቾ ቡዕሉ ምንሴ አነ እሁስለከ መሲህ ቡዕሉ መገኑ እሁስ አጥራመቴን ደጎኖተ ኢታም። <verse eid="1CO 11:3"/><verse number="4" style="v" sid="1CO 11:4"/>ህትን ጉንጉዕል ዱአ አአኖሁ ህከረንገ ራገ ጠወአኖሁ ጎንቹ አዪሁ ገይስ ቡዕለ እኮ መሲህ ሙልሰኖ። <verse eid="1CO 11:4"/><verse number="5" style="v" sid="1CO 11:5"/>ህትን ሻሸ ጣጡዕናን ዱአ አታኢሁ ህከረንገ ራገ ጠወአ መንቹት ሀቲንሴ ገይሴ ቡዕለ እኮ ምንሴ መንቹ ሙልሳአ፤ ሁኩንን ሙምሴ ሜዶገ ዎለአመኖ። <verse eid="1CO 11:5"/><verse number="6" style="v" sid="1CO 11:6"/>መንቹት ሻሸ ጣጥባች ሙምሴ ሙርሲሱን፤ ጠዉ እኮጎሬ ሙምሴ ሙርሲሱ ህከረንገ ሜዱ ሙልሰኖሴሃ እኮጎሬ ሻሸ ጣጡን። <verse eid="1CO 11:6"/><verse number="7" style="v" sid="1CO 11:7"/>ህትን ጎኑ መገን ደነለከ መገን ኬዕምኝ እኮቤቺሃ ጉንጉዕሉ ሀስሰኖስበአ፤ ጠዉ እኮጎሬ ሜንቱ ጎኒሃ ኬዕምኝሃን።<note caller="-" style="x"><char style="xo" closed="false">11፥7 </char><char style="xt" closed="false"><ref loc="GEN 1:26-27">ክል. 1፥26-27</ref>።</char></note> <verse eid="1CO 11:7"/><verse number="8" style="v" sid="1CO 11:8"/>መሰንትስ ሜንቱ ጎኒች ደገንቶ ቤሉ ጎኑ ሜንቲች ደገሞበአ። <verse eid="1CO 11:8"/><verse number="9" style="v" sid="1CO 11:9"/>ህትን ሜንቱ ጎኒሃ ከለቀንቶ ቤሉ ጎኑ ሜንቲሃ ከለቀሞበአ።<note caller="-" style="x"><char style="xo" closed="false">11፥8-9 </char><char style="xt" closed="false"><ref loc="GEN 2:18-23">ክል. 2፥18-23</ref>።</char></note> <verse eid="1CO 11:9"/><verse number="10" style="v" sid="1CO 11:10"/>ህከን መሳንለከ መገን መላይከት ለኣሴቤቺሃ መንቹት ምንሴ አን ሹምነት ኣዜን እሁሴ ለሊሶተ ቡዕለሴ ጣጡን። <verse eid="1CO 11:10"/><verse number="11" style="v" sid="1CO 11:11"/>ጠዉ እኮጎሬ ቀርችቤቾን ሜንቱ ጎኑ ዮበኢሃለከ ጎኑ ሜንቱ ዮበኢሃ ሄኦተ አታለኖበአ። <verse eid="1CO 11:11"/><verse number="12" style="v" sid="1CO 11:12"/>መሰንትስ ሜንቱ ጎኒች ከለቀንቶገን ጎኑ እለመኖሁ ሜንቲችት፤ ህትን ጉዕሙርቹንኩ ደገመኖሁ መገኒችት።<verse eid="1CO 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13"/>ህንዴ ገዉክዕኔ ፈረጄ፤ መት መንቹት ሻሸ ጣጡዕነ ዱአ አኡ ጡመሃንዶ? <verse eid="1CO 11:13"/><verse number="14" style="v" sid="1CO 11:14"/>ጎኑ ሙምስ ቅራርስ ነሴጎሬ ሁኩን እሲሃ ሙልሰኖሃ እሁስ ክልቀቲች ተማርቴነንተበእንዶ? <verse eid="1CO 11:14"/><verse number="15" style="v" sid="1CO 11:15"/>ጠዉ እኮጎሬ ሙሙ ኣሰሞሴሁ ቡዕለሴ ጣጦተ እኮቤቺሃ ሙምሴ ነስቶጎር እሴሃ ኬዕምኝያን። <verse eid="1CO 11:15"/><verse number="16" style="v" sid="1CO 11:16"/>ህካን እኮቤቺሃ አዪሁ ኦደሞተ ሀሾ ጎሬ ኔሳሃ እኮ መገኑ አመዕኔ መኒሃ ከኒች አደ እኮ ጠዉ ዮኔበአ።<verse eid="1CO 11:16"/></para>
  <para style="s1">መጨረሽ ጠሊለ ሁርባት ሴረ</para>
  <para style="r">(<ref loc="MAT 26:26-29">ማቶ. 26፥26-29</ref>፤ <ref loc="MRK 14:22-25">ማር. 14፥22-25</ref>፤ <ref loc="LUK 22:14-20">ሉቃ. 22፥14-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17"/>አዕኑ ጭምይቴነንተ ወክት ምዕረኖህዕኔ ቤሉ ደግለለኖህዕኔርቹ አቴነንተበእቤቺሃ ከኒች ዎሮን ዮ ትዛዝ ኣሳንክዕኔ ወክት አን ክዕኔተ ገለትጭህበአ። <verse eid="1CO 11:17"/><verse number="18" style="v" sid="1CO 11:18"/>መሰንትስ ጉዕመርቺችን ሄጭ መገኑ አመዕኔ መንቤቾን ጭምይቴነንተ ወክት በላንከክዕኔ አደዶመት ሄኡስ ሞጮጭዮም፤ ህከን ጠዊች ደሩስ ሀንቅ እሁስ አመዕናም። <verse eid="1CO 11:18"/><verse number="19" style="v" sid="1CO 11:19"/>ህካን እኮቤቺሃ ሀንቅ መኑ አዬኤታጎሬ መለዕለንት ለልቶተ በላንከክዕኔ አደዶመት ሄኡስ ግደሃን። <verse eid="1CO 11:19"/><verse number="20" style="v" sid="1CO 11:20"/>አዕኑ ሜጡበ ጭምይቴነንተ ወክት እቴነንታሁ ጠሊለ ቀርች ሁርባትሃበአ። <verse eid="1CO 11:20"/><verse number="21" style="v" sid="1CO 11:21"/>መሰንትስ እቴነንተ ወክት መቱ-መቱስ አገሩዕነ ሄጫቀንሺን ገይስ ሁርባት እተኖቤቺሃ መቱስ ጎራዬገን ፈቀኖ፤ ህትን ዎሉስ ሰከረኖ። <verse eid="1CO 11:21"/><verse number="22" style="v" sid="1CO 11:22"/>እቶኖተለከ አጎኖተ ምኑ ዮህዕኔበእንዶ? ህከረንገ መገኑ አመዕኔ ጭምት ዱእ ምኒ ህንቄነንንዶ? ህትን መቱርቹሁ ዮስበእ መነ ሙልሴነንንዶ? ቴሱ አን ክዕኔተ መ ዩ! ከን ጠውተኔሃ ገለትጮህዕኔንዶ? ሆሮ ገለትጫንክዕኔበአ።<verse eid="1CO 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23"/>ቀርቺች ቶጎሚሁለከ ክዕኔንከ ኣሴም ትምርቱ ከኒች ዎሮን ዮእሃን፤ ህግሴን ኣሴመ ሀንከዕርተ ቀርቹ ኢስ ዳቡተ ኬሽ <verse eid="1CO 11:23"/><verse number="24" style="v" sid="1CO 11:24"/>መገኑ ገለትጭ ቢጭ «[ህዕዬ እቼ] ኩን ክዕኔተኔሃ ኣሰሞ ጅስማኤ፤ ካን ኤሳሃ ቃጎኖተ አዕዬ» ዬእ። <verse eid="1CO 11:24"/><verse number="25" style="v" sid="1CO 11:25"/>ህትን ሁርባቲች ኤተሮን ጠበቴሃ ኬሽ «ኩ ጠበቴሁ ቄጊንከኤ እሀኖ ሃዕሮሃ ወኣድ፤ ህካን አጌነንተ ወክት ጉዕመንከ ካን ኤሳሃ ቃጎኖተ አዕዬ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">11፥25 </char><char style="xt" closed="false"><ref loc="EXO 24:6-8">ፉል. 24፥6-8</ref>፤ <ref loc="JER 31:31-34">ኤር. 31፥31-34</ref>።</char></note><verse eid="1CO 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 11:26"/>መሰንትስ ከ ዳቡተ እቴነንተ ወክትሃ ከ ጠበቴሃ አጌነንተ ወክት ጉዕመንከ ቀርቹ ኢስ ፈንቀል አሜቶተ ኢለ ሬሁስ ዱዱብስቴነንተ። <verse eid="1CO 11:26"/><verse number="27" style="v" sid="1CO 11:27"/>አዪሁ ኣጉዕናንስ ቀርች ሁርባቲሃ ኬዕምኝ ኣሱዕነ እቾጎሬለከ ቀርች ጠበቴሃ አጎጎሬ ቀርች ጅስሚሃለከ ቄጊሃ ኤዳሙ እሀኖ። <verse eid="1CO 11:27"/><verse number="28" style="v" sid="1CO 11:28"/>ህካን እኮቤቺሃ መቱ መንቹ ህከን ዳቦች እቶተ ብርተለከ ህከን ጠበቴሃ አጎተ ብርተ ገዉስ መረመሩን። <verse eid="1CO 11:28"/><verse number="29" style="v" sid="1CO 11:29"/>ሀኩ መንቹሁ ቀርች ጅስመ መሃጎሬ አደ አዕይ ደጉዕነ እተኖሁለከ ቀርች ጠበቴሃ አገኖሁ ጉዕሙንኩ ፍርደ ገይስ አሌን ኤበኖ። <verse eid="1CO 11:29"/><verse number="30" style="v" sid="1CO 11:30"/>ክዕኔ በሊች ልግቡ ሆጎኢሁለከ ጥዞኢሁ ህከኒሃት፤ ህትን ልግቡሰ ሬቶኢሁ ህከን መሳኒት። <verse eid="1CO 11:30"/><verse number="31" style="v" sid="1CO 11:31"/>ገይኔተኔሃ አጥራመንት ደንጎም እቃን አሌንከኔ ፈረደመኖበአ እቅ። <verse eid="1CO 11:31"/><verse number="32" style="v" sid="1CO 11:32"/>ጠዉ እኮጎሬ ከን ኣዱንያ አል መኒን ሜጡበ ኒ አሌን ፈረደመኖኔበእገ ቀርቹ ኒ አሌን ፈረደኖኔሁ ኔሳሃ ተማርሶኔታት።<verse eid="1CO 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33"/>ህካን እኮቤቺሃ አመኤ ኦሶ! ቀርች ጠሊለ ሁርባት እቶኖተ ጭምይቴንተ ወክት ገገዉክዕኔ አገዕራቀሜ። <verse eid="1CO 11:33"/><verse number="34" style="v" sid="1CO 11:34"/>ጭምይቴነንታሁ ፍርዲሃ እሀኖበእገ ጎራዬኢሁ ዮ ጎሬ ምኔንከስ እቱን፤ ፈቆ ጠውተኔሃ አኡ ሀስሰኖህዕኔሃ አሜቾም ወክት ኩላንክዕኔ።<verse eid="1CO 11:34"/></para>
  <chapter eid="1CO 11"/>
  <chapter number="12" style="c" sid="1CO 12"/>
  <para style="s1">ጠሊለ አያን ኣስቱተ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1"/>አመኤ ኦሶ! ጠሊለ አያን ኣስቶተኔሃ ደጎኖተ ሀሳም። <verse eid="1CO 12:1"/><verse number="2" style="v" sid="1CO 12:2"/>ሀንቅ መገኑ ደጎኑዕናን ሄኤንተ ወክት ደጌንቡ ጠወ አዎንቴን ጠወኢሃ አታልትበ ሽርኬቤቹ መርቴነንተገ ደጌነንተ። <verse eid="1CO 12:2"/><verse number="3" style="v" sid="1CO 12:3"/>ህካን እኮቤቺሃ ቴሱ አዪሁ መገን አያን ዎልቃን ጠወአን «ኢስ ቦሮረሞእሃን» የኖሁ ሆሮን ዮበእገለከ ጠሊለ አያን ዎልቃን እህባች «ኢስ ቀርቹሃን!» ዮተ ሜጡሁ አታልበገ አጥራመቴን ደጎኖተ ሀሳም።<verse eid="1CO 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4"/>አደዱ ጠሊለ አያን ኣስቱት ዮኡ፤ እኮጎሬ ጠሊሉ አያኑ ሜጥቹሃን። <verse eid="1CO 12:4"/><verse number="5" style="v" sid="1CO 12:5"/>ህትን አደዱ ክድመት ዮኡ፤ እኮጎሬ ቀርቹ ሜጥቹሃን። <verse eid="1CO 12:5"/><verse number="6" style="v" sid="1CO 12:6"/>ህትን ሆጉተ አኤኖ አደዱ ዎቆሁ ዮኡ፤ ጠዉ እኮጎሬ ህካን ጉዕመንከ ጉዕመ መን አዲን አአኖሁ መቱሃ መገኑ። <verse eid="1CO 12:6"/><verse number="7" style="v" sid="1CO 12:7"/>መት-መቲሃስ ጠሊሉ አያኑ መቱርቹ ለሊሰኖሁ ጉዕመንከ ደግለለኖ ጠዊሃት። <verse eid="1CO 12:7"/><verse number="8" style="v" sid="1CO 12:8"/>ጠሊሉ አያኑ መቶ መንቺሃ ሀይማን ጠወአኖ ላገተ ኣሰኖስ፤ ሁኩ ጠሊሉ አያኑንኩ ዎሊሀስ ኤንኬዕኒን ጠወኡ ኣሰኖስ። <verse eid="1CO 12:8"/><verse number="9" style="v" sid="1CO 12:9"/>ህትን ሁኩ ጠሊሉ አያኑ መቲሀስ አመዕነቱ ዎሊሀስንገ ጥዘናሙ ፈይሱ አታለኖ ኣስቱተ ኣሰኖ፤ <verse eid="1CO 12:9"/><verse number="10" style="v" sid="1CO 12:10"/>ህትን መቲሀስ አጀብሲሰኖ ጠወ አኡ ዎሊሀስንገ ራግ ላገተ ጠወኡ ህትን መቲሃ ሀንቅለከ ክዝብ አያነ አደ አኤን ደጌኖ ኤንኬዕኑ ዎሊሀስንገ ሮሰሞበእ አፌን ጠወኡ ህትን መቲሀስንገ አደደ አፌን ጠወኤማሀ ፈሰሬኖ ኣስቱተ ኣሰኖስ። <verse eid="1CO 12:10"/><verse number="11" style="v" sid="1CO 12:11"/>ጠዉ እኮጎሬ ህከ ጉዕመ ጠወንከ ሁኩ ሜጡ ጠሊሉ አያኑ ሃሸዕዮገ አነኒንከስ ቤክ ኣሰኖ።<note caller="-" style="x"><char style="xo" closed="false">12፥4-11 </char><char style="xt" closed="false"><ref loc="ROM 12:6-8">ሮሜ 12፥6-8</ref>።</char></note><verse eid="1CO 12:11"/></para>
  <para style="s1">መቶ መንች ጅስማን ልግቡ ብሊቱ ሄኡስ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12"/>ሜጥቾ ጅስማን ልግቡ ብሊቱ ሄአኖሀንገን መሃ ልግብ እኮጎሬ ጉዕሙንኩ ብሊቱ መቱ ጅስመ እኮሀንገን መሲህ ህትኒንት።<note caller="-" style="x"><char style="xo" closed="false">12፥12 </char><char style="xt" closed="false"><ref loc="1CO 12:4-5">12፥4-5</ref>።</char></note> <verse eid="1CO 12:12"/><verse number="13" style="v" sid="1CO 12:13"/>መሰንትስ አይሁደ እንኮምጎሬሁ ግሪክ አፎን ጠወዕናም መነ እንኮምጎሬሁ ሮስ እንኮምጎሬሁ ሰዎልድ እንኮምጎሬሁ ነኡ ጉዕሙንኩኔ ሜጡ ጅስማ እንኮተ መቶ ጠሊለ አያኒን ጠመቀሞም፤ ህትን ጉዕሙንኩኔ ህከን መቶ ጠሊለ አያኒች አንጎም።<verse eid="1CO 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14"/>ጅስሙ መኬኢሁ ልግቤ ብሊቲቺት ቤሉ መቶሃ ብሊቲቺበአ። <verse eid="1CO 12:14"/><verse number="15" style="v" sid="1CO 12:15"/>ህካን እኮቤቺሃ ሎከት «አን አንገተ እህበቤቺሃ ጅስሚሃ ብሊትሃበአ» ይቶጎሬ ህካን ይንከሴ ጅስሚች መቱ ብሊት እሁ ፈቃእንዶ? <verse eid="1CO 12:15"/><verse number="16" style="v" sid="1CO 12:16"/>መጨት «አን እልተ እህበቤቺሃ ጅስሚሃ ብሊትሃበአ» ይቶጎሬ ህካን ዪንከሴ ጅስሚች መቱ ብሊት እሁ ፈቃእንዶ? <verse eid="1CO 12:16"/><verse number="17" style="v" sid="1CO 12:17"/>ህካን እኮቤቺሃ ጅስሙ ጉዕሙንኩ ጠለዕል እልተ እኮ እቃን ሞጮጩ ሀከኔ ሄአኖ እቅ? ህትን ጅስሙ ጉዕሙንኩ መጨተ እኮ እቃን ሀንሱሱ ሀከኔ ሄአኖ እቅ? <verse eid="1CO 12:17"/><verse number="18" style="v" sid="1CO 12:18"/>ጠዉ እኮጎሬ መገኑ ኢቴ ሃሊን ብሊት ጉዕመንከ ጅስማን ሀሲሰኖ ቤቾን ሄአኖገ አዕዮ። <verse eid="1CO 12:18"/><verse number="19" style="v" sid="1CO 12:19"/>ህትን ጉዕሙንኩስ ጠለዕል መቱ ብሊት እኮ እቃን ጅስሙ ሀከኔ ሄአኖ እቅ? <verse eid="1CO 12:19"/><verse number="20" style="v" sid="1CO 12:20"/>ቴሱ ልግቡ ብሊቱ ሄዕዮ ጎሬሁ ጅስሙ ሜጦሃን።<verse eid="1CO 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21"/>ህካን እኮቤቺሃ እልት አንገተ «ሀሳንኬበአ» ይቶተ አታልታበአ፤ ቡዕሉንኩ ሎከተ «ሀሳንኬበአ» ዮተ አታለኖበአ። <verse eid="1CO 12:21"/><verse number="22" style="v" sid="1CO 12:22"/>ጠዉ እኮጎሬ ጅስማን ላፈ አጉደኖ ብሊቱ አበ ሀስሰኖሃን። <verse eid="1CO 12:22"/><verse number="23" style="v" sid="1CO 12:23"/>ህትን አሌንከኔ ኬዕምኙሰ ቀቅቹ አጉደኖኔ ብሊቲሃ ሎረ ኬዕምኝ ኣስናንሰ፤ ህትን ለኤንበገ ሙልናም ብሊቲሃ ሎረ ኬዕምኚን አገርናንሰ፤ <verse eid="1CO 12:23"/><verse number="24" style="v" sid="1CO 12:24"/>ብሬን እክ ለለኖ ጅስሚሃ ጉዕሚንከ ኩን ጉዕሙንኩ ሀሲሰኖሰበአ፤ እኮጎሬ መገኑ ለኢሃ ሙልሰኖ አጉጅ ለለኖ ጅስም ብሊተ ሎረ ኬዕምኚን አፌኖሰገ አዕይ ጅስመ ጉዕመንከ ሜጡ አዕይ አጳቀንሴሰ። <verse eid="1CO 12:24"/><verse number="25" style="v" sid="1CO 12:25"/>ካን አዕዮሁ ጅስመ ጉዕመንከ በላንከሰ አደዶመት ሄኣበእገ ገገዉንኩሰ መቱ መቲንከስ አጳቀንታጋት።<verse eid="1CO 12:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 12:26"/>ህካን እኮቤቺሃ ብሊቲች መቱስ ኦርጨመኖ ወክት ጉዕሙንኩ ብሊቱ ሜጡበ ኦርጨቀመኖ፤ ህትን መቱ ብሊቱ ኬዕምኛሙ እሀኖ ወክት ጉዕሙንኩ ብሊቱ ሜጡበ ሙንደአኖ።<verse eid="1CO 12:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27"/>ቴሱ አዕኑ መሲህሃ ጅስመ፤ መት-መቱክዕኔ ህከን ጅስምሃ ብሊተ። <verse eid="1CO 12:27"/><verse number="28" style="v" sid="1CO 12:28"/>ህካን እኮቤቺሃ መገኑ መት-መቱ መነ መገኑ አመዕኔ መን ጭምት ዱእ ምናን አደደ ሆጎን ሄኣገ አዕዮ፤ ከን ሃሌን ዎዕናሃ አሳበተ ለንኪሃ ነብያኑተ ሰቂሃ አስተማረተ ህከኒች ኤተሮን አጀብሲሰኖ ጠወ አታ መነ ህከኒች ኤተሮን ጥዘናመተ ፈይሳ መነ ህከኒች ኤተሮን መኒሃ ደግለልታ መነ ህከኒች ኤተሮን ገሻኑተ ህከኒች ኤተሮን ሮሰሞበእ አፌን ጠወኣ መነ አመዕናኖ ኣዜን ኡርሾኡ።<note caller="-" style="x"><char style="xo" closed="false">12፥28 </char><char style="xt" closed="false"><ref loc="EPH 4:11">ኤፌ. 4፥11</ref>።</char></note> <verse eid="1CO 12:28"/><verse number="29" style="v" sid="1CO 12:29"/>እሰ ጉዕሙንኩሰ አሳበተንዶ? ህትን ጉዕሙንኩሰ ነብያኖተንዶ? ህትን ጉዕሙንኩሰ አስተማረተንዶ? ህትን ጉዕሙንኩሰ አጀብሲሰኖ ጠወ አታእረንዶ? <verse eid="1CO 12:29"/><verse number="30" style="v" sid="1CO 12:30"/>ህትን ጉዕሚንከሰ ጥዘናመተ ፈይሳ ኣስቱት ዮሰረንዶ? ህትን ጉዕሙንኩሰ ሮሰሞበእ አፌን ጠወኣእረንዶ? አደደ አፌን ጠወኤማሃ ጉዕሙንኩሰ ፈሰርቶተ አታልታእረንዶ? <verse eid="1CO 12:30"/><verse number="31" style="v" sid="1CO 12:31"/>ጠው እኮጎሬ አዕኑ ጉዕሚችን በተኣ ኣስቱተ ደእቶኖተ ጠረኝቴን አጰሜ።</para>
  <para style="p" vid="1CO 12:31">ህትን አን ጉዕሚችን ቆሀኖ ዎቃሃ ለሊሳንክዕኔ።<verse eid="1CO 12:31"/></para>
  <chapter eid="1CO 12"/>
  <chapter number="13" style="c" sid="1CO 13"/>
  <para style="s1">ሀንቅ ኢተተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1"/>መንለከ መላይከ አፌን ጠወዕዮም እቃ ኢተት ሄእበኤች ወደኖ ብረትገለከ ዶልገ እኮም። <verse eid="1CO 13:1"/><verse number="2" style="v" sid="1CO 13:2"/>ህካን እኮቤቺሃ ራገ ጠወኣም ዎልቀት ሄኦኤ እቃ፥ ምስጥር ጉዕመንከ ደጎም እቃን፥ ኤንኬዕኑ ጉዕመንኩ ሄዕዮኤ እቃ፥ ቆተት ቤቺችሴ ኬእ ዎሉቤቹ መርታገ አኣም አመዕነቱ ሄዕዮኤ እቃ ኢተት ሄእበኤች አን ተሰሃን።<note caller="-" style="x"><char style="xo" closed="false">13፥2 </char><char style="xt" closed="false"><ref loc="MAT 17:20">ማቶ. 17፥20</ref>፤ <ref loc="MAT 21:21">21፥21</ref>፤ <ref loc="MRK 11:23">ማር. 11፥23</ref>።</char></note> <verse eid="1CO 13:2"/><verse number="3" style="v" sid="1CO 13:3"/>ህትን ዮኤሃ ጉዕመንከ ቡጥቻኖተ ቤኮም እቃ፥ ጅስመኤ ጊራን ቡቦተ<note caller="+" style="f"><char style="fqa" closed="false">ጊራን ቡቦተ፦ </char><char style="ft" closed="false">የኖሁ መት-መቱ ሉህ ክታበት «ቦኒሃ» ይታአ።</char></note> ህግሽ ኣስዮም እቃ ኢተት ሄእበኤች መቱርቹሃ ደግለለኖኤበአ።<verse eid="1CO 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4"/>ኢተት አታዕልሲሳእተ፤ ኢተት ጡመ ጠወ አታአ፤ ኢተት ምቀኝታበአ፤ ኢተት ዮሴሀኔን ድከኣበአ፤ ኢተት ቦንሲሳበአ። <verse eid="1CO 13:4"/><verse number="5" style="v" sid="1CO 13:5"/>ኢተት አለ ቅልበ እካበአ፤ ኢተት ጠለዕል ገይሀሴ ይታበአ፤ ኢተት ኡሙዕሪታበአ፤ ኢተት ዮስ መንቹ በደለሞ እቃን ብድልገ ዎለኣበአ። <verse eid="1CO 13:5"/><verse number="6" style="v" sid="1CO 13:6"/>ኢተት ሀንቅ ጠዋን ሙንደኣ ቤሉ ሂለ ጠዋን ሙንደኣበአ። <verse eid="1CO 13:6"/><verse number="7" style="v" sid="1CO 13:7"/>ኢተት ጉዕመ ጠወ አታዕልታአ፤ ኢተት ጉዕመርቹንከ አመዕንታአ፤ ኢተት ጉዕመርቹንከ ተብሴን አገዕርታአ፤ ኢተት ጉዕመ ጠዋን ጠረኝት ሄኣአ።<verse eid="1CO 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8"/>ኢተት ሆሮ በኣበአ፤ ራጉ እኮ እቃ ህገኖ፤ ሮሰሞበእ አፎን ጠወኡ እኮ እቃ ፈቀኖ፤ ኤንኬዕኑ እኮ እቃ ህገኖ። <verse eid="1CO 13:8"/><verse number="9" style="v" sid="1CO 13:9"/>መሰንትስ ነኡ ደንጋሚሁ ዊመ ዊሚንትበአ፤ ራገ ጠወዕናሚንኩ ዊመ ዊሚንትበአ። <verse eid="1CO 13:9"/><verse number="10" style="v" sid="1CO 13:10"/>ጠዉ እኮጎሬ ዊመ እኮ ጠዉ አሜቾ ወክት ደሩ እኮ ጠዉ ህገኖ።<verse eid="1CO 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 13:11"/>ጩል እክ ሄዕዮም ወክት ጩለገን ጠወኣም፥ ሰውያምለከ አጥራመታም እቅ፤ ቴሱ ኦስመኤ ሹሎም ወክት ጩል እክ ሄዕዮም ወክት አኣም ጠወ ጉዕመንከ አጉሮም። <verse eid="1CO 13:11"/><verse number="12" style="v" sid="1CO 13:12"/>መሰንትስ ቴሱ ለአቃንቺን ለኤኖሀንገ ቀቅቹንከ ለዕናም፤ ጠዉ እኮጎሬ ህከ ወክት ዊመ ዊሚን ለዕናም፤ ቴሱ አን ደጋሚሁ ደሩሲት፤ ጠዉ እኮጎሬ ህከ ወክት መገኑ ኤሳሃ ደጎኤ ጌሰንከ ዊሙ ኤንኬዕኑ ሄአኖኤ።<verse eid="1CO 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13"/>ህካን እኮቤቺሃ አመዕነቱ፥ ኢተትለከ ተብሶሁ ኩ ሰሱንኩ ጠረኝት ሄኣአ፤ ጠዉ እኮጎሬ ኢተት ህከኑኡች በተኣአ።<verse eid="1CO 13:13"/></para>
  <chapter eid="1CO 13"/>
  <chapter number="14" style="c" sid="1CO 14"/>
  <para style="s1">ሮሰሞበእ አፌን ጠወእ ኣስቱተ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1"/>ቴሱ ኢተተ አወኜ፤ ህትን ጠሊለ አያነ ኣስቱተ ጡመገ ሀሼ፤ በትሴን ራገ ጠወኢሃ አታሌኖ ኣስቱተ ሀሼ። <verse eid="1CO 14:1"/><verse number="2" style="v" sid="1CO 14:2"/>መሰንትስ ሮሰሞበእ አፌን ጠወአኖ መንቹ መገኒሃት ቤሉ መኒሃ ጠወአኖበአ፤ እስን ጠሊለ አያኒን ማጠሞ ጠወ ጠወአኖቤቺሃ ጠወአኖስርቹ ደገኖሁ አዪሁ ዮበአ። <verse eid="1CO 14:2"/><verse number="3" style="v" sid="1CO 14:3"/>ጠዉ እኮጎሬ ራገ ጠወአኖ መንቹ ዎሉ መነ ጠረኝሲሃ፥ ሸዚሃለከ ሰብር አአኖገ መኒሃ ጠወአኖ። <verse eid="1CO 14:3"/><verse number="4" style="v" sid="1CO 14:4"/>ህካን እኮቤቺሃ ሮሰሞበእ አፌን ጠወአኖ መንቹ ገዉስ ጠረኝሰኖ፤ ጠዉ እኮጎሬ ራገኖ መንቹ ዱእ ምነተ ጠረኝሰኖ።<verse eid="1CO 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5"/>ህትን ጉዕሙንኩክዕኔ ሮሰሞበእ አፎን ጠወኤንታ እቃን ኢታም እቅ፤ እኮጎሬ በትሽ ሀሳሚሁ ራጎኖታት፤ መሰንትስ ዱእ ምነት ደግለሸቀንቶተ ጠወዕዮሃ ሂር ኩለኖሁ ዮበእ ጎሬ ሮሰሞበእ አፎን ጠወአኖሀኒች ራገኖሁ በተአኖ። <verse eid="1CO 14:5"/><verse number="6" style="v" sid="1CO 14:6"/>ቴሱ አመኤ ኦሶ! ክዕኔቤቹ አሜቾም ወክት ሮሰሞበእ አፌን ጠወአን አሜቾም ጎር ክዕኔሃ መ ደገለለኖ? ህከን ወጥ ደግለለኖህዕኔ መገን ምስጥር ለሊሱ፥ ኤንኬዕኑ፥ ራገ ጠወኡለከ ትምርት አፍ አሜቾሚሁ ቆሀኖ።<verse eid="1CO 14:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 14:7"/>ዎሉ ፈቅ ሁሉሌገ ክራርጋ ሩሁ ዮሰበእ ኦዳታ እኮ እቃ ላገሰ አደ እክ ለልትባች ሁሉሌ ላገተ እሁስለከ ክራር ላገተ እሁስ ማን ደጌኖ? <verse eid="1CO 14:7"/><verse number="8" style="v" sid="1CO 14:8"/>ህትን ሞጮጨንቶበእ ላጋን ደገሞበእ ሃሊን ጡሩምበ ቡሴመጎሬ መርቺሃ ቡሴመገ መኑ ሀት አዕይ ደጎተ አታለኖ። <verse eid="1CO 14:8"/><verse number="9" style="v" sid="1CO 14:9"/>ህከንገን ሮሰሞበእ አፎን መኒሃ ኣግበገ ጠወኤንተጎሬ ቦብሪሃ ጠወኤነንተሀንገ እኬነንተ ቤሉ ጠወኤነንተርቹ አይ አጥራመች ደጎተ አታለኖ? <verse eid="1CO 14:9"/><verse number="10" style="v" sid="1CO 14:10"/>ከን ኣዱንያ አሌን አደዱ ልግቡ አፎሁ ዮኡ፤ ጠዉ እኮጎሬ ፍሳረት ዮበእ አፎሁ ዮበአ። <verse eid="1CO 14:10"/><verse number="11" style="v" sid="1CO 14:11"/>ቴሱ መቱ መንቹ ጠወአኖ አፌ ፍሳረተ ደግባች አን ጠወአኖሀኒሃ ኮህቹ እሃም፤ እስን ኤሳሃ ኮህቹ እሀኖ። <verse eid="1CO 14:11"/><verse number="12" style="v" sid="1CO 14:12"/>ህካን እኮቤቺሃ ጠሊለ አያን ኣስቱተ ሀሴነንተረ እኬንተጎሬ መገኑ አመዕኔ መነ ጠረኝሲሃ አታልቴነንተ ኣስቱተ በትሴን ሀሼ።<verse eid="1CO 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13"/>ህካን እኮቤቺሃ ሮሰሞበእ አፎን ጠወአኖ መንቹ ጠወአኖስርቹ ፈሰሮተ አታለኖ ዎልቀተ ደኦተ ዱአ አኡን። <verse eid="1CO 14:13"/><verse number="14" style="v" sid="1CO 14:14"/>መሰንትስ ሮሰሞበእ አፎን ዱአ አዕዮ ጎሬ አያኒን ዱአ አአኖ፤ ጠዉ እኮጎሬ ቡዕሉኤ መቱርቹሃ ሆጉተ አዕዮበአ። <verse eid="1CO 14:14"/><verse number="15" style="v" sid="1CO 14:15"/>ቴሱ አኡ ሀስሰኖኤርቹ መርቹሃን? አያኒንከኤ ዱአ አአን ሰውቲንከኤ ዱአ አኣም፤ ህትን ቀልቢንከኤ ዘመረን ሰውቲንከኤ ዘመራም። <verse eid="1CO 14:15"/><verse number="16" style="v" sid="1CO 14:16"/>ህካን እህባች አት አያኒንከክ ሮሰሞበእ አፎን መገኑ ገለትጭቶንትጎሬ መቱ ኮህቹ መንቹ ይቶንትርቹ ደግበቤቺሃ አት መገኑ ገለትጭቶንትሀኒሃ ሀት እክ «ኣሚዕን» የኖ? <verse eid="1CO 14:16"/><verse number="17" style="v" sid="1CO 14:17"/>መሰንትስ አት መገኑ ገለትጭቶንትጉ ጡመሃ እቅ፤ እኮጎሬ ሁኩን ዎሉ መንቹ ጠረኝሰኖበአ።<verse eid="1CO 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18"/>ጉዕሚችክዕኔን ሎረ ሮሰሞበእ አፎን ጠወኣምቤቺሃ መገኑ ገለትጫም። <verse eid="1CO 14:18"/><verse number="19" style="v" sid="1CO 14:19"/>ጠዉ እኮጎሬ ሮሰሞበእ አፎን ቶኑ ኩሜ ላገተ ጠወኢች ዎሉ መነ ተማርሲሃ ሮሰሞ አፎን መገኑ አመዕኔ ጭምት ዱእ ምናን ኦንት ላገተ ደጌኖ ላጋን ጠወኡ ኢታም።<verse eid="1CO 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20"/>አመኤ ኦሶ! ሂለ ጠዊሃ ጩለተ እኬ ቤሉ ሰውቲንከክዕኔ ጩለተ እኮኖቼ፤ ጠዉ እኮጎሬ ሰውቲንከክዕኔ አንጀ አጉዕምቴንታእረ እኬ። <verse eid="1CO 14:20"/><verse number="21" style="v" sid="1CO 14:21"/>ሕጋን፦</para>
  <para style="q1" vid="1CO 14:21">« ‹ሮሰሞበእ አፎን ጠወኣ መኒሃለከ</para>
  <para style="q2" vid="1CO 14:21">ዎሎ ባድ መን አፎን ከን መኒሃ ጠወኣንሰ፤</para>
  <para style="q2" vid="1CO 14:21">ጠወዕዮምጎሬሁ ሞጮጭታኤበአ› ይዮኡ ቀርቹ መገኑ»</para>
  <para style="m" vid="1CO 14:21">የመም ከተበሞኡ።<note caller="-" style="x"><char style="xo" closed="false">14፥21 </char><char style="xt" closed="false"><ref loc="ISA 28:11-12">ኢሳ. 28፥11-12</ref>።</char></note><verse eid="1CO 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22"/>ቴሱ ሮሰሞበእ አፎን ጠወኡ መላተ እሀኖሁ አመዕንበ መኒሃት ቤሉ አመዕኔ መኒሃበአ፤ ጠዉ እኮጎሬ ራገ ጠወኡ አመዕናኖታት ቤሉ አመዕንቡ መኒሃትበአ።<verse eid="1CO 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 14:23"/>አመዕናኑት ጉዕሙንኩ ጭምይታ ወክት ጉዕሙንኩ ሮሰሞበእ አፎን ጠወአን ደግቡ ህከረንገ አመዕንቡ መኑ ኣጎጎሬ «ኩ መኑ በርገጎኡ» የኖበእንዶ? <verse eid="1CO 14:23"/><verse number="24" style="v" sid="1CO 14:24"/>ጠዉ እኮጎሬ ጉዕሙንኩሰ ራገ ጠወአን ደግቡ ህከረንገ አመዕንቡ መንቹ ኣጎጎሬ ሞጮጬ ላገት ሆርንት ዎቀሳስ፤ ህትን ሞጮጬ ላጋት ሆርንትስ ፈረዳስ። <verse eid="1CO 14:24"/><verse number="25" style="v" sid="1CO 14:25"/>ቀልቤንከስ ቴለሞ ጠዉ ለለኖ፤ ህካን እኮቤቺሃ ሁኩ መንቹ ኡላን ኡብ «ሀንቅንከ መገኑ ክዕኔ በላን ዮኡ» የን መገኒሃ ሰገደኖ።<verse eid="1CO 14:25"/></para>
  <para style="s1">ዱአ አኤኖ ወክት ሄኡ ሀስሰኖ ሴርተኔሃ</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26"/>አመኤ ኦሶ! ቴሱ መ ይናም? አዕኑ ጭምይቴነንተ ወክት መት-መቲሃስ መዝሙሩ ዮሲሁ ዮኡ፤ ዎሉስ ተማርሰኖ፤ መቱስ ማጠሞርቹ ለሊሽ ኩለኖ፤ መቱስ ሮሰሞበእ አፎን ጠወአኖ፤ መቱስ ሮሰሞበእ አፎን ጠወኤማሃ ፈሰረኖሁ ዮኡ፤ እኮጎሬ ሁኩ ጉዕሙንኩ አመዕናኑተ ጠረኝሲሃ እሁን። <verse eid="1CO 14:26"/><verse number="27" style="v" sid="1CO 14:27"/>ህትን ሮሰሞበእ አፎን ጠወአኖሁ ሄዕዮ ጎሬ ለሙ ህከረንገ በተዕዮ ጎሬ ሰሱ እክ ተሪን ተሪን ጠወኡን፤ እሰ ጠወኣእንከ ዎሉ መኑ ፈሰሩን። <verse eid="1CO 14:27"/><verse number="28" style="v" sid="1CO 14:28"/>ጠዉ እኮጎሬ ፈሰሩ አታለኖ መንቹ ሄእባች መገኑ አመዕኔ ጭምት ምናን ሮሰሞበእ አፎን ጠወኡንከ፤ ህከን ወጥ ገይሃስለከ መገኒሃ ጠወኡን። <verse eid="1CO 14:28"/><verse number="29" style="v" sid="1CO 14:29"/>ራገ ጠወኣእሩ ለሙ ህከረንገ ሰሱ እክ ጠወኡን፤ ዎሉ መኑ ጠወአሞስ ጠወ አጥራመት አደ አት ደጉን። <verse eid="1CO 14:29"/><verse number="30" style="v" sid="1CO 14:30"/>ጠዉ እኮጎሬ አፉዕሌ መኒች መቲሀስ ሃሽኣቱት ለልቶስጎሬ ዎዕናሃ ጠወአኖሁ ጨለዩን። <verse eid="1CO 14:30"/><verse number="31" style="v" sid="1CO 14:31"/>መኑ ጉዕሙንኩ ተማሮተለከ ጠረኞተ ጉዕሙንኩክዕኔ ተሪን ተሪን ራገ ጠወኦኖተ አታልቴነንተ። <verse eid="1CO 14:31"/><verse number="32" style="v" sid="1CO 14:32"/>ህትን ነብያካ አያኑ ነብያካተ አዘዘመኖ። <verse eid="1CO 14:32"/><verse number="33" style="v" sid="1CO 14:33"/>መሰንትስ መገኑ ወገሬትየ መገኑ ቤሉ ጨንጨነሃ መገኑበአ። <verse eid="1CO 14:33"/><verse number="34" style="v" sid="1CO 14:34"/>ሜንቱ መገኑ አመዕኔ መን ዱእ ምኒ ኣዜን ጠወኡንከ፤ መሰንትስ ሕጉ የኖገን እሰ አዘዘንቶታት ቤሉ ጠወኢሃ ፈቀደሞሰበአ። <verse eid="1CO 14:34"/><verse number="35" style="v" sid="1CO 14:35"/>ህካን እኮቤቺሃ መት መንቹት መገኑ አመዕኔ መን ዱእ ምናን ጠወኡ ሙልሰኖሃ እኮቤቺሃ ሜንቱ ደጎተ ሀሳ ጠዉ ሄዕዮ ጎሬ ምንሰ አነ ምኔሰ ጠዕምቱን።<verse eid="1CO 14:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36"/>ህትን መገን ላገት አሜቶኢሁ ክዕኔቺትንዶ? ህከረንገ መገን ላገት እልቶኢሁ ጠለዕል ክዕኔቤቹሃትንዶ? <verse eid="1CO 14:36"/><verse number="37" style="v" sid="1CO 14:37"/>አዪሁ «አን ነብዬቹሃን» የኖሁ ህከረንገ «ኤሳሃ ጠሊለ አያን ኣስቱት ዮኤሃን» የኖሁ ሄዕዮ ጎሬ ኩ ከተቦንክዕኔሁ ቀርች ትዛዝ እሁስ ደጉን። <verse eid="1CO 14:37"/><verse number="38" style="v" sid="1CO 14:38"/>ጠዉ እኮጎሬ ካን ሞጮጫምበአ የኖ መንቹ ዮ ጎሬ እስ ጠወአኖሁ ሞጮጨሙንከ።<verse eid="1CO 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39"/>ህካን እኮቤቺሃ አመኤ ኦሶ! ራገ ጠወኢሃ ጠረኝቴን ሀሼ፤ ህትን ሮሰሞበእ አፌን ጠወኡሃ ከንቶኖቼ። <verse eid="1CO 14:39"/><verse number="40" style="v" sid="1CO 14:40"/>ጠዉ እኮጎሬ ጉዕሙንኩ ጠዉ ጡመ ሃሊንለከ ሴሪን እሁን።<verse eid="1CO 14:40"/></para>
  <chapter eid="1CO 14"/>
  <chapter number="15" style="c" sid="1CO 15"/>
  <para style="s1">መሲህ ሬሆች ኬእተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1"/>አመኤ ኦሶ! አዕኑ አን ተማርሲየንክዕኔ ኣእቴን ጠረኝቴን ኡርቴንተ ተሽት ላገተ ቃግሶህዕኔተ ሀሳም። <verse eid="1CO 15:1"/><verse number="2" style="v" sid="1CO 15:2"/>ህከ ተሽት ላገንተ ጠረኝሴን አፌንተጎሬ ህከን ላገ አዲን ፈቄነንተ፤ ህካን እህባች አመዕነቱክዕኔ ተሰሃን።<verse eid="1CO 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3"/>ጉዕመርቺችን በትሽ ሀስሰኖ ጠወ አንን ቶጎሚሃ ክዕኔኤ ህግሽ ኣሴም፤ ሁኩንን ጠሊለ መጻፋን የመሞገን መሲህ ጩብኔተኔሃ ሬዮኡ፥<note caller="-" style="x"><char style="xo" closed="false">15፥3 </char><char style="xt" closed="false"><ref loc="ISA 53:5-12">ኢሳ. 53፥5-12</ref>።</char></note> <verse eid="1CO 15:3"/><verse number="4" style="v" sid="1CO 15:4"/>ሞገሞ፤ ጠሊለ መጻፋን ከተበሞገን ሰቅ በር ሬሆች ኬዕዮ የኖሃን።<note caller="-" style="x"><char style="xo" closed="false">15፥4 </char><char style="xt" closed="false"><ref loc="PSA 16:8-10">መዝ. 16፥8-10</ref>፤ <ref loc="MAT 12:40">ማቶ. 12፥40</ref>፤ <ref loc="ACT 2:24-32">ሶቀ. 2፥24-32</ref>።</char></note> <verse eid="1CO 15:4"/><verse number="5" style="v" sid="1CO 15:5"/>እስን ጴጥሮሴሃ ለሌእ፤ ህከኒች ኤተሮን ቶና ለሞንከ አሳባተ ለሌእ፤<note caller="-" style="x"><char style="xo" closed="false">15፥5 </char><char style="xt" closed="false"><ref loc="MAT 28:16-17">ማቶ. 28፥16-17</ref>፤ <ref loc="MRK 16:14">ማር. 16፥14</ref>፤ <ref loc="LUK 24:36">ሉቃ. 24፥36</ref>፤ <ref loc="JHN 20:19">ያህ. 20፥19</ref>።</char></note> <verse eid="1CO 15:5"/><verse number="6" style="v" sid="1CO 15:6"/>ህትን ኦንቴ ጥቤች በተኣ አመዕናኖተ መቱ ወክት ለሌእ፤ እሳችን መቱ-መቱሰ ሬቶጎሬ ልግቡሰ ቴሁ ኢለ ፎሊን ዮኡ። <verse eid="1CO 15:6"/><verse number="7" style="v" sid="1CO 15:7"/>ህትን ኢስ ያቁቢሃ ለሌእ፤ ህከኒች ኤተሮን ጉዕማንከ አሳባተ ለሌእ።<verse eid="1CO 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 15:8"/>መጨረሻን ጉዕሚችን ሆፈኣም ኤሳሃ ለሌእ።<note caller="-" style="x"><char style="xo" closed="false">15፥8 </char><char style="xt" closed="false"><ref loc="ACT 9:3-6">ሶቀ. 9፥3-6</ref>።</char></note> <verse eid="1CO 15:8"/><verse number="9" style="v" sid="1CO 15:9"/>መሰንትስ መገን ዱእ ምነተ ሸረን ኦሪሳሚሃ እኮምቤቺሃ አን አሳባች ጉዕሚችን ሆፈኣሚሁለከ ሶቀማንቹ የመም ገአሙ ገበእበኤሃን።<note caller="-" style="x"><char style="xo" closed="false">15፥9 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ሶቀ. 8፥3</ref>።</char></note> <verse eid="1CO 15:9"/><verse number="10" style="v" sid="1CO 15:10"/>ጠዉ እኮጎሬ አን ቴሱ ሄኣም ሀለት ደኤሚሁ መገን ኣስቶቺት፤ ህትን ሁኩ ኣሰንቶኤ ኣስቱት ላልቹ ዮበኢሃ እኮበአ፤ አንን ዎሎ መኒች ጉዕሚችን በትሽ ጠረኝ አዕዮም፤ ጠዉ እኮጎሬ አዕዮሁ ኢን ሄአኖሃ መገንተ ኣስቱ ቤሉ አኔበአ። <verse eid="1CO 15:10"/><verse number="11" style="v" sid="1CO 15:11"/>አኒ እኮም እቃ እሳሁ ተማርስናሚሁ ከኒት፤ አዕኑሁ አመዕንቴንታሁ ከኒት።<verse eid="1CO 15:11"/></para>
  <para style="s1">ሬዮ መኑ ሬሆች ኬአኖሃ እሁስ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12"/>ቴሱ መሲህ ሬሆች ኬኡስ ተማርስናሚሃ እኮች ሀት ክዕኔች መት-መቱ «ሬቶ መኑ ሬሆች ኬኣበአ» ይታኢት? <verse eid="1CO 15:12"/><verse number="13" style="v" sid="1CO 15:13"/>ሬቶ መኑ ሬሆች ኬእባሃ እኮች መሲህ ሬሆች ኬዕዮበአ ዩሃን። <verse eid="1CO 15:13"/><verse number="14" style="v" sid="1CO 15:14"/>ህትን መሲህ ሬሆች ኬእባች ኒ ትምርቱለከ ክዕኔ አመዕነቱሁ ተሰሃን። <verse eid="1CO 15:14"/><verse number="15" style="v" sid="1CO 15:15"/>ህከኒችን በትሽ «መገኑ መሲህ ሬሆች ኬሾስ» ይን እስተኔሃ መሰከርኖምቤቺሃ መገኒሃ ክዝብ ምስክር እንኮም ዩሃን፤ ሬቶ መኑ ሬሆች ኬእባች መገኑ መሲሁ ሬሆች ኬሾስበአ ዮሃን። <verse eid="1CO 15:15"/><verse number="16" style="v" sid="1CO 15:16"/>መሰንትስ ሬቶ መኑ ሬሆች ኬእባሃ እኮች መሲህ ሬሆች ኬዕዮበአ ዩሃን። <verse eid="1CO 15:16"/><verse number="17" style="v" sid="1CO 15:17"/>ህትን መሲህ ሬሆች ኬእባች አመዕነቱክዕኔ ተሰሃን፤ አዕኑሁ ከበሬ ኢለ ጩቢንከክዕኔ ዮንተ ዩሃን። <verse eid="1CO 15:17"/><verse number="18" style="v" sid="1CO 15:18"/>መሲሂን አመዕንት ሬቶእሩ በኦኡ ዩሃን። <verse eid="1CO 15:18"/><verse number="19" style="v" sid="1CO 15:19"/>ነኡሁ መሲህ ተብሳሃ አዕናሚሁ ከን ዱንያ አሌን ሄዕናም ሄኢሃ ጠለዕል እኮጎሬ መኒች ጉዕሚችን በትሴን ሻዝንሳምረ እንኮም ዩሃን።<verse eid="1CO 15:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20"/>ጠዉ እኮጎሬ መሲህ ሬቶሀኑኡተ ዎዕኔሃ እክ ሀንቅንከ ሬሆች ኬዕዮኡ። <verse eid="1CO 15:20"/><verse number="21" style="v" sid="1CO 15:21"/>መሰንትስ ሬሁት መቶሃ መንች አዲን አሜቶገን ሬቶእሩ ሬሆች ኬኡሁ መቶ መንች አዲኒት። <verse eid="1CO 15:21"/><verse number="22" style="v" sid="1CO 15:22"/>መኑ ጉዕሙንኩ ኣደም መሳን ሬሀኖሀንገን መሲህ መሳን መኑ ጉዕሙንኩ ሄኡ ደአኖ። <verse eid="1CO 15:22"/><verse number="23" style="v" sid="1CO 15:23"/>ጠዉ እኮጎሬ መት-መቱንኩ ገገይስ ተሪን አሜተኖ፤ መሲህ ሬሆች ኬኢን ዎኔሃን፤ ህትን ኤተሮን መሲህ አሜቾ ወክት እሲሃ እኮእረ ሬሆች ኬሰኖ። <verse eid="1CO 15:23"/><verse number="24" style="v" sid="1CO 15:24"/>መሲህ ገሹ ጉዕመንከ፥ ደኝነቱ ጉዕመንከለከ ዎልቀተ ጉዕመንከ ቤሾች ኤተሮን ዎምነቱ አነ መገኒሃ ህግሽ ኣሰኖ ወክት ዘማን ጎፉ እሀኖ። <verse eid="1CO 15:24"/><verse number="25" style="v" sid="1CO 15:25"/>መገኑ ዲነስ ሎከስ ጫዕማች ዎሮን አኦተ ኢለ መሲህ ዎመ እሁ ሀስሰኖስ።<note caller="-" style="x"><char style="xo" closed="false">15፥25 </char><char style="xt" closed="false"><ref loc="PSA 110:1">መዝ. 110፥1</ref>።</char></note> <verse eid="1CO 15:25"/><verse number="26" style="v" sid="1CO 15:26"/>መጨረሻን ቄለም በአኖሁ ዲኑ ሬሁታን። <verse eid="1CO 15:26"/><verse number="27" style="v" sid="1CO 15:27"/>«መገኑ ጉዕመ ጠወንከ ሹምነቲችስ ዎሮን አዕዮኡ» የኖሁ ከተበሞኡ፤ ጠዉ እኮጎሬ «ጉዕሙ ጠዉንኩ ሹምነትችስ ዎሮን እኮኡ» የኖ ወክት ጉዕሙ ጠዉንኩ ሹምነቲች ዎሮን አዕዮ አነ መገኑ በርገኖበአ።<note caller="-" style="x"><char style="xo" closed="false">15፥27 </char><char style="xt" closed="false"><ref loc="PSA 8:6">መዝ. 8፥6</ref>።</char></note> <verse eid="1CO 15:27"/><verse number="28" style="v" sid="1CO 15:28"/>ጉዕሙርቹንኩ መሲህ ሹምነቲ ኣዚን እኮች ኤተሮን አኑ መገኑ ጉዕሙርቹንኩ ጠገመኖሃ እሆተ ህከ ወክት ቤቱ ገዉንኩስ ጠቀኖገ አዕዮ መገኒሃ ጠገመኖስ።<verse eid="1CO 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29"/>ህካን እህባች ሬዮ መን ወጥ ጠመቀመኖ መኑ መ አአኖት? ህትን ሬዮ መኑ ሆሮን ሬሆች ኬእባሃ እኮጎሬ መኑ እሰ ወጥ ጠመቀመኖሁ ሚሃት? <verse eid="1CO 15:29"/><verse number="30" style="v" sid="1CO 15:30"/>ነኡ ገዉንኩኔ ጉዕመ ወክት አደጊሃ ገውኔ ኣስነን ሄዕናሚሁ ሚሃት? <verse eid="1CO 15:30"/><verse number="31" style="v" sid="1CO 15:31"/>አመኤ ኦሶ! ኤሳሃ በሬን በሬን ሬሁት ገንበ ይታኤት፤ አንን ህካን ያሚሁ ቀርቹሃኔ መሲህ ኢስ አዲን ክዕኔኤን ዮኤ አመዕነቲንት። <verse eid="1CO 15:31"/><verse number="32" style="v" sid="1CO 15:32"/>ህትን አን ኤፌሶን ከተማን አብል ቡሳዊን ኡጀቀሜኖሀንገን ኡጀቀሞሚሁ መን ሰውቲን እኮጎሬ መ ደግለለኖኤ? ህትን ሬዮ መኑ ሬሆች ኬእባሃ እኮች «ጋቴተ ሬናምቤቺሃ አሜ እንቶለከ አንጎ» ይታገ እሁሃስ።<note caller="-" style="x"><char style="xo" closed="false">15፥32 </char><char style="xt" closed="false"><ref loc="ISA 22:13">ኢሳ. 22፥13</ref>።</char></note><verse eid="1CO 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33"/>አዕኑ ሉጨንቶኖቼ፤ «ሂሉ ጃሉ ጡመ አመል ቤሰኖ» የመሞኡ። <verse eid="1CO 15:33"/><verse number="34" style="v" sid="1CO 15:34"/>ቴሱ ቀልብ አዕዬ፤ ጩብ አኡ አጉሬ፤ መገኑ ደግቡ መኑ በላንከክዕኔ ዮኡ፤ አን ህካን ያሚሁ ሙልሶህዕኔተ ይዪት።<verse eid="1CO 15:34"/></para>
  <para style="s1">ሬሆች ኬዕዮ መንች ጅስሙ መ አጉደኖ?</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35"/>መቱ መንቹ «ሬቶ መኑ ኬኣኢሁ ሀት እኪት? ሬሆች ኬኣ ወክት ጅስሙሰ መ አጉደኖ?» ይ ጠዕመኖ መንቹ ሄኦተ አታለኖ። <verse eid="1CO 15:35"/><verse number="36" style="v" sid="1CO 15:36"/>አት ኩ ገዉ መንቹ! አት ዉጣንት ዉጠት ሸንትባች ሙታበአ። <verse eid="1CO 15:36"/><verse number="37" style="v" sid="1CO 15:37"/>አት ዉጣንት አለስ ህከረንገ ዎሎርች ዜሬተህቤሉ ኤተሮን ሙች ነጴኢሃበአ። <verse eid="1CO 15:37"/><verse number="38" style="v" sid="1CO 15:38"/>ጠዉ እኮጎሬ መገኑ ኢተኖ ሃሊን ገይስ ደነ ኣሰኖስ፤ ህትን መት-መቲሃስ ዘሬትስ ገይስ ደነንከ ኣሰኖስ።<verse eid="1CO 15:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 15:39"/>መሰንትስ ማሉ ጉዕሙንኩ ሜጦሃ ደነበአ፤ እኮጎሬ መን ማሉ ሜጦሃ ደነ፤ ግዝ ማሉሁ ዎሉሃ ደነ፤ ህትን ጭኦ ማሉ አደደ ደነ፤ ቁርጩሜ ማሉ ዎሉሃ ደነ።<verse eid="1CO 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40"/>ህትን ሰሜ ጅስሙ ዮኡ፤ ኡለ አል ጅስሙሁ ዮኡ፤ እኮጎሬ ሰሜ ጅስም ኬዕምኙ መቶሃ ደነ፤ ህትን ኣዱንያ አል ጅስም ኬዕምኙ ዎሉሃ ደነ። <verse eid="1CO 15:40"/><verse number="41" style="v" sid="1CO 15:41"/>ህትን አር ኬዕምኙ መቶሃ ደነ፤ አገንች ኬዕምኙንገ ዎሎሃ ደነ፤ ቤዜ ኬዕምኙሁ ዎሎሃ ደነ፤ መሰንትስ መቶሃ ቤዜ ኬዕምኙ ዎሊችስ አደደ።<verse eid="1CO 15:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42"/>ሬዮ መኑ ሬሆች ኬአኖሁ ህትዪት፤ ዉጠሞ ጅስሙ በአኖሃን፤ ሬሆች ኬዕዮ ጅስሙ በእበሃን። <verse eid="1CO 15:42"/><verse number="43" style="v" sid="1CO 15:43"/>ሁኩንን ሆፍኚን ዉጠም ኬዕምኚን ኬአኖ፤ ህትን ላፈ እክ ዉጠም ጠረኘ እክ ኬአኖ። <verse eid="1CO 15:43"/><verse number="44" style="v" sid="1CO 15:44"/>ህትን ማል ጅስሚን ዉጠም ጠሊሉ አያኑ ሄኡ ኣሴ ጅስመ እክ ኬአኖ፤ ማል ጅስሙ ሄኦች ጠሊሉ አያኑ ሄኡ ኣሴ ጅስሙ ዮኡ። <verse eid="1CO 15:44"/><verse number="45" style="v" sid="1CO 15:45"/>ህካን እኮቤቺሃ «ዎኔ መንቹ ኣደም ሄአኖ ክልቀት እኮ» የመም ከተበሞኡ፤ ኤተር ኣደም ሄኡ ኣሰኖ አያነ እኮ።<note caller="-" style="x"><char style="xo" closed="false">15፥45 </char><char style="xt" closed="false"><ref loc="GEN 2:7">ክል. 2፥7</ref>።</char></note> <verse eid="1CO 15:45"/><verse number="46" style="v" sid="1CO 15:46"/>ጠዉ እኮጎሬ ዎዕናሃ አሜቾሁ ጠሊለ አያኒን ሄኡ ኣሰሞሲሁ እሁዕነ ማል ጅስሙ አሜቾ፤ ጠሊለ አያኒን ሄኡ ኣሰሞስ ማል ጅስሚች ኤተሮን አሜቾ። <verse eid="1CO 15:46"/><verse number="47" style="v" sid="1CO 15:47"/>ዎዕኔ መንቹ ከለቀሞሁ ኡለ ትቢች እኮቤቺሃ ኡላሃን፤ ለንክ መንቹ አሜቾሁ ሰሜቺት። <verse eid="1CO 15:47"/><verse number="48" style="v" sid="1CO 15:48"/>ኡላች እኮእሩ ኡላች እኮሃ አጉዳአ፤ ሰሜች እኮእሩ ሰሜች እኮኢሃ አጉዳአ። <verse eid="1CO 15:48"/><verse number="49" style="v" sid="1CO 15:49"/>ነኡ ኡላ ትቢች ከለቀሞ መንች ደነ አጉንዶምገን መቱ በር ሰሜች አሜቾ መንች ደነ አጉንዳም።<verse eid="1CO 15:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50"/>አመኤ ኦሶ! መቱርቹ ኩላንክዕኔ፤ ማሉለከ ቄጉ መገን ዎምነቱ ዎረሶተ አታልታበአ፤ ህትን በአኖ ጅስሙ በእቡ ጅስመ ዎረሶተ አታለኖበአ።<verse eid="1CO 15:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="1CO 15:51"/>ቴሱ መቱ ማጠሞ ጠወ ኩላንክዕኔ፤ ነኡ ጉዕሙንኩኔ ሬናምበአ፤ ጠዉ እኮጎሬ ጉዕሙንኩኔ ዶረማም። <verse eid="1CO 15:51"/><verse number="52" style="v" sid="1CO 15:52"/>ዶረማሚንኩ መጨረሽ ጡሩምበ ቡሴኖ ወክት እሌ ገለብትገ መቶ ወክቴኒት፤ ጡሩምቡ ቡሰመኖ፤ ሬቶ መኑ በእበ መነ እክ ኬኣአ፤ ነኡሁ ዶረማም።<note caller="-" style="x"><char style="xo" closed="false">15፥51-52 </char><char style="xt" closed="false"><ref loc="1TH 4:15-17">1 ተሰ. 4፥15-17</ref>።</char></note> <verse eid="1CO 15:52"/><verse number="53" style="v" sid="1CO 15:53"/>መሰንትስ ኩ ሸመኖ ማሉ ሸምባሃ ኦደኡ ህትን ኩ ሬሀኖ ማሉ ሬህባሃ ኦደኡ ሀስሰኖስ። <verse eid="1CO 15:53"/><verse number="54" style="v" sid="1CO 15:54"/>ኩ በአኖ በእባሃ ኦደዕዮ ወክት ህትን ኩ ሬሀኖ ሬህባሃ ኦደአኖ ወክት «ሬሁት ቄለንት በኦኡ» የመም ከተበሞሁ ዊመኖ።<note caller="-" style="x"><char style="xo" closed="false">15፥54 </char><char style="xt" closed="false"><ref loc="ISA 25:8">ኢሳ. 25፥8</ref>።</char></note> <verse eid="1CO 15:54"/><verse number="55" style="v" sid="1CO 15:55"/>ህትን</para>
  <para style="q1" vid="1CO 15:55">«ሬሆ! ቄሉክ ሀከበ ዮኡ?</para>
  <para style="q2" vid="1CO 15:55">ሬሆ! መነ ምዕርታንት ዎልቀክ ሀከበ ዮኡ?» የመሞኡ።<note caller="-" style="x"><char style="xo" closed="false">15፥55 </char><char style="xt" closed="false"><ref loc="HOS 13:14">ሆሴ. 13፥14</ref>።</char></note><verse eid="1CO 15:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="1CO 15:56"/>ሬሆ ቄል ዎልቀት ጩብሃን፤ ጩብ ዎልቀት ሕገሃን። <verse eid="1CO 15:56"/><verse number="57" style="v" sid="1CO 15:57"/>ጠዉ እኮጎሬ ቀርቹሃኔ መሲህ ኢስ አዲን ቄሉ ኣሰኖኔ መገኒሃ ገለቱ እሁንስ!<verse eid="1CO 15:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58"/>ህካን እኮቤቺሃ ኢተንቴንተ አመኤ ኦሶ! ጠረኝቴን ኡርዬ፤ ቀርቾ ኢሲሃ አቴንተ ሆጉት ጠለዕለ እክበገ ደጌነንተቤቺሃ ሌንቄቅቶኑዕናን ቀርቾ ኢስ ሆጉተ ጉዕመንከ ወክት አዕዬ።<verse eid="1CO 15:58"/></para>
  <chapter eid="1CO 15"/>
  <chapter number="16" style="c" sid="1CO 16"/>
  <para style="s1">ዬሩሳሌማን ሄኣ አመዕናኖተ ሀዕሌኖ ብረ ጭም አኤመገ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1"/>አመዕናኑተ ሀዕላቀሜኖ ብረ ጭምአእተኔሃ ገለትይ ባዶን ሄኣ አመዕናኖተ ኩሎምገን አዕኑሁ ህት አዕዬ።<note caller="-" style="x"><char style="xo" closed="false">16፥1 </char><char style="xt" closed="false"><ref loc="ROM 15:25-26">ሮሜ 15፥25-26</ref>።</char></note> <verse eid="1CO 16:1"/><verse number="2" style="v" sid="1CO 16:2"/>ሁኩ ብረ ጭምአኤኖሁ አን አሜታም ወክት እሀኖበእገ መት-መቱክዕኔ ደእቴነንተሀኒች ዎልቀክዕኔ ጌሰ ጉዕመንከ ወክት ሳምንት ዎኔ በር አደ አቴን አፉሽዬ። <verse eid="1CO 16:2"/><verse number="3" style="v" sid="1CO 16:3"/>አን አሜቾም ወክት አዕኑ አመዕንቴነንተ መኑ ህከ ጭም አቴንተ ብረ ዬሩሳሌመ መስቶተ ደብደቤተ ከተብ ሜጡበ አዕይ ሶሃንሰ። <verse eid="1CO 16:3"/><verse number="4" style="v" sid="1CO 16:4"/>ኢ መሩ ሀስሾ ጎሬ እሰ ኢን ሜጡበ መርታአ።<verse eid="1CO 16:4"/></para>
  <para style="s1">ጳዉሎሴ ያደተ</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5"/>መቄዶን ባድ አዲን ህጎተ ሰውዬምቤቺሃ ህከኒን ህገን ክዕኔተ ለኦተ አሜታም።<note caller="-" style="x"><char style="xo" closed="false">16፥5 </char><char style="xt" closed="false"><ref loc="ACT 19:21">ሶቀ. 19፥21</ref>።</char></note> <verse eid="1CO 16:5"/><verse number="6" style="v" sid="1CO 16:6"/>አን ሀከቤቹሃ መሮም ጎር ዎቄሃእ እካ ሽንቅተ ኣቶኖኤተ ክዕኔቤቾን ቀዉ ጌሰ አፉዕላሚሃ እሀኖ፤ ህትን ከርም ክዕኔቤቾን አፉዕላሚሃ እሀኖ። <verse eid="1CO 16:6"/><verse number="7" style="v" sid="1CO 16:7"/>ህካን እኮቤቺሃ ህግኤ ዎቃን ለኦህዕኔተ ሀሳምበአ፤ መገኑ ዬጎር ክዕኔን ሜጡበ መቱ ጌሰ ዱንኮተ ተብሳሃ አኣም።<verse eid="1CO 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8"/>ጠዉ እኮጎሬ ጰንጠቆስጤ<note caller="+" style="f"><char style="fqa" closed="false">ጰንጠቆስጤ፦ </char><char style="ft" closed="false">ዩ አይሁዳውያኑ አዝመረሰ ጭምአቶች ኤተሮን ኦንታይቅ በሬን ከበጄኖሃ ከበጀት።</char></note> ከበጀት ኢለ ኤፌሶን ከተማን ዱንካም።<note caller="-" style="x"><char style="xo" closed="false">16፥8 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">ሌዌ 23፥15-21</ref>፤ <ref loc="DEU 16:9-11">ዘዳ. 16፥9-11</ref>።</char></note> <verse eid="1CO 16:8"/><verse number="9" style="v" sid="1CO 16:9"/>መሰንትስ ልግቡ ሆጉት ሄኦ አልባዕሉት ኡሩት ፈንተኦኤ፤ እኮጎሬ ኤሳሃ ግባኤ መኑ ልግብሃን።<note caller="-" style="x"><char style="xo" closed="false">16፥8-9 </char><char style="xt" closed="false"><ref loc="ACT 19:8-10">ሶቀ. 19፥8-10</ref>።</char></note><verse eid="1CO 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10"/>ጥማቶስ አሜቾ ወክት ዋጁዕናን በላንከክዕኔ አፉዕለኖገ አዕዬስ፤ መሰንትስ እሲሁ ኢገን ቀርች ሆጉተ አአኖሃን።<note caller="-" style="x"><char style="xo" closed="false">16፥10 </char><char style="xt" closed="false"><ref loc="1CO 4:17">1 ቆሮ. 4፥17</ref>።</char></note> <verse eid="1CO 16:10"/><verse number="11" style="v" sid="1CO 16:11"/>ህካን እኮቤቺሃ አዪሁ ህንቁንከስ፤ እኮጎሬ አመዕናኖን ሜጡበ አገራምቤቺሃ ኢቤቹ ወገሬቲን ፈንቀሎተ ዎቄሀስ እካ ሽንቅተ ኣቴን ህርሲሼስ።<verse eid="1CO 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12"/>አመኔቤቱ አጵሎስ ዎሎ አመኦሶን ሜጡበ ክዕኔቤቹ መሮተ አበ ኡጭዮንስ እቅ፤ እኮጎሬ እስ ቴሱ ክዕኔቤቹ አሜቶተ ሀሾበአ፤ መከኖስ ወክት ክዕኔቤቹ አሜተኖ።<verse eid="1CO 16:12"/></para>
  <para style="s1">ጎፍሜ ሸዘነተለከ ወገሬትሱ</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13"/>በቅይዬ፤ አመዕነቶንከክዕኔ ጠረኝቴን ኡርዬ፤ አጰሜ፤ ጠረኝዬ። <verse eid="1CO 16:13"/><verse number="14" style="v" sid="1CO 16:14"/>ህትን አቴነንታሃ ጉዕመንከ ኢታን አዕዬ።<verse eid="1CO 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15"/>አመኤ ኦሶ! አካይ ባዶን ሄጭት መገኑ አመዕንቶእሩ እስጥፋኖሴ አበሮስ እሁሰለከ እሰ አመዕናኑተ ሀዕልቶተ ገዉሰ ህግስ አቶገ ደጌነንተ።<note caller="-" style="x"><char style="xo" closed="false">16፥15 </char><char style="xt" closed="false"><ref loc="1CO 1:16">1 ቆሮ. 1፥16</ref>።</char></note> <verse eid="1CO 16:15"/><verse number="16" style="v" sid="1CO 16:16"/>እሰገ ዮ መኒሃለከ እሳንን ሜጡበ አተን ሆጋ መኒሃ ጉዕሚንከ አዘዘንቴነንተገ ጥሽ አዕይ ቃግሳንክዕኔ።<verse eid="1CO 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17"/>እስጥፋኖስ፥ ፈርዶናጢስለከ አካይቆስ ኢቤቹ አሜቶቤቺሃ ተሽ ይዮኤ፤ አዕኑ ኢን ሜጡበ ደገንቴንበቤቺሃ እሰ ክዕኔቤቾን ሆፈዕዮኤርቹ ዊንሽቶኤ። <verse eid="1CO 16:17"/><verse number="18" style="v" sid="1CO 16:18"/>እሰ ኢለ ክዕኔ ቀልብ ፎሎሲሶእረ፤ ህካን እኮቤቺሃ ህትኔ መነ ደጉ ሀስሰኖህዕኔ።<verse eid="1CO 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19"/>እስይ ባዶን ሄኣ አመዕናኑተ «ወገሬት ዮንተንዶ?» ይታህዕኔት፤ ህትን አቂልለከ ጵርስቅል ምኔንከሰ ጭምይታ አመዕናኖን ሜጡበ ቀርች ሱዕሚን «ጠረኘገ ወገሬት ዮንተንዶ?» ይታህዕኔት።<note caller="-" style="x"><char style="xo" closed="false">16፥19 </char><char style="xt" closed="false"><ref loc="ACT 18:2">ሶቀ. 18፥2</ref>።</char></note> <verse eid="1CO 16:19"/><verse number="20" style="v" sid="1CO 16:20"/>ህትን አመዕናኑት ጉዕሙንኩ «ወገሬት ዮንተንዶ?» ይቶህዕኔ፤ ገገዉንኩክዕኔ አመዕናኖተ ሀስሰኖ ነጠ እኮ ወገሬትጨቀሚን ዝያዕረቀሜ።<verse eid="1CO 16:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21"/>አን ጳዉሎስ ከ ወገሬት ገይእ አንጋን ከተቦንክዕኔ።<verse eid="1CO 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22"/>ቀርቹ መሲህ ኢሰ ኢትባሁ ሄዕዮ ጎሬ ቦሮረሞኢሃ እሁን፤ ኒ ቀርቾ አም!<note caller="+" style="f"><char style="fqa" closed="false">ኒ ቀርቾ አም፦ </char><char style="ft" closed="false">የኖሁ ግሪክ አፎን «ማራናታ» የኖ።</char></note> <verse eid="1CO 16:22"/><verse number="23" style="v" sid="1CO 16:23"/>ቀርቾሃ ኢስ ኣስቱት ክዕኔን ሜጡበ እኩን።<verse eid="1CO 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24"/>ኢ ኢተት መሲህ ኢስ አዲን ጉዕሚንከክዕኔን ሜጡበ እኩን! ኣሚዕን።<verse eid="1CO 16:24"/></para>
  <chapter eid="1CO 16"/>
</usx>
