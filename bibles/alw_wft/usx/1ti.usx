<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1TI" style="id">- HALABA NEW TESTAMENT</book>
  <para style="h">ዎኔ ጢሞትዎሴ</para>
  <para style="toc1">ጳዉሎስ ጥሞትዎሴሃ ከተቦ ዎኔ ሶህኑተ</para>
  <para style="toc2">ዎኔ ጢሞትዎሴ</para>
  <para style="toc3">1 ጢሞ.</para>
  <para style="mt1">ጳዉሎስ ጥሞትዎሴሃ</para>
  <para style="mt2">ከተቦ ሶህኑተ</para>
  <para style="imt1">ኣጉስ</para>
  <para style="ip">ጢሞትዮሴ ዬኖ አመዕናቹ ዎደልቹ ከለቀንሹስ ቀዉሃ እስይ ባዲች እሀን አመስ አዲን አይሁድቹለከ አንስ አዲን ግሪክቹሃ እቅ፤ ጳዉሎሴ ሆጎ ጃላለከ እንጂል ሆጎ ሶህኖን ሀዕለኖሲሃ እቅ፤ ጳዉሎስ ጢሞትዮሴ ከተቦ ዎኔ ሶህኑተ ሰሶ ቡዕለ እኮ ጠዋን እኮእሃን።</para>
  <para style="ip">ጉዕሚችን ሄጭ ሶህኑስ አመዕናኖ ኣዜን ኬዕዮ ክዝብ ትምህርተ አገዕርታገ አአኖ እቅ፤ ክዝብ ትምህርቱ ደሩስ አይሁዲሃለከ ደሩስንገ ዎሎ መን ጠወ አፎሃ እሀን «ኩ ኣዱንያ አሉ ጩቢን በዕዮሃ እኮቤቺሃ ጡሙ ደገሞተ አታለኖ አደ እኮ ምስጥር ኤንኬዕኒን መት-መቴ እቻቺለከ ቦለቺች አገዕረንት» የኖ ጠዋን ኡርዮእሃን እቅ። ቴሁንገ ሶህኑስ ዱእ ምኒ ገሹሃ፥ መገኑ ኡጬኖ ሴር ትምርተሃ፥ ህትን ዱእ ምኒ አዎንሳኑትለከ ሀዕልታሰሩ ሄኦሰተ ሀስሰኖ ጠወ አፎእሃን። መጨረሻን ጢሞትዎስ መሲህ ኢስ ጡመ ካድንቹ ሀት እክ እሆተ አታለኖ ጎር አደደ አመዕናኖ ኣዜን ሆጎ ወጥሃ ጳዉሎስ ኣሴ ሸዘነተ ደንጋም።</para>
  <para style="iot">መጻፉስ አፎሃ</para>
  <para style="io1">ኣጉስ <char style="ior">(<ref loc="1TI 1:1-2">1፥1-2</ref>)</char></para>
  <para style="io1">ዱእ ምንተኔሃለከ ክድመተኔሃ ኣሰሞ ትምርት <char style="ior">(<ref loc="1TI 1:3-3:16">1፥3—3፥16</ref>)</char></para>
  <para style="io1">ጢማትዎሴ ክድመተኔሃ ኣሰሞስ ትምህርተ <char style="ior">(<ref loc="1TI 4:1-6:21">4፥1—6፥21</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="1TI 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1"/>ፌሳንቹኔ እኮ መገንለከ ተቢሳሃ እኮ መሲህ ኢስ ትዛዚን መሲህ ኢስ አሳቤቹ እኮም ጳዉሎሴች፦<verse eid="1TI 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1TI 1:2"/>አመዕነቲን ሀንቅ ቤቱእ እኮ ጢማቶሴሃ ሶሃንቶእተ ሶህኑ፤</para>
  <para style="p" vid="1TI 1:2">አናኔ መገኒችለከ ቀርቹሃኔ መሲህ ኢሲች ኣስቱቲ፥ ማርቱትለከ ወገሬቱሁ ኪን እሁን።<note caller="-" style="x"><char style="xo" closed="false">1፥2 </char><char style="xt" closed="false"><ref loc="ACT 16:1">ሶቀ. 16፥1</ref>።</char></note><verse eid="1TI 1:2"/></para>
  <para style="s1">ክዝብ ትምርቲች አገዕርተኔሃ</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3"/>አን መቄዶን ባዱ መሮም ወክት መቱ-መቱ መኑ ክዝብ ትምህርት ተማርሲታበእገ፥ <verse eid="1TI 1:3"/><verse number="4" style="v" sid="1TI 1:4"/>ማቁተለከ ዎለኤናን ጎፍበ እለንሽ ዎሊንሽበ ፈንቀልታበእገ አዘዘን ኤፌሶን ከተማን አፉዕልቶተ ኤገተክ ያንኬ፤ ህትናሙ ጠዉንኩ ኦደተ ኤበኖ ቤሉ መገን አመዕነቲን ነጵኖተ ደግለለኖኔበአ። <verse eid="1TI 1:4"/><verse number="5" style="v" sid="1TI 1:5"/>ከን ትዛዚች መሰስ ጠሊለ ቀልብቺ፥ ጡመ ሰውቲችለከ ሀንቅ አመዕነቲች ደገንታእተ ኢተ። <verse eid="1TI 1:5"/><verse number="6" style="v" sid="1TI 1:6"/>መት-መቱ መኑንኩ ህትናሞ ጠዊች አደ እክ ደግለሊቶበእ ኦደበ ፈንቀልቶኡ። <verse eid="1TI 1:6"/><verse number="7" style="v" sid="1TI 1:7"/>እሰን ሕገ ሮስሳእራ እኮተ ሀሰን የኖስርቹ ደጋበአ፤ ህከረንገ «ደጊን ጠወዕናሚት» ይተን ጠወኣኢንከ አጥራመታበአ።<verse eid="1TI 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8"/>መኑ ሕገ ጡመ እሁስ ደግለሸቀሞ ጎሬ ጡመ እሁስ ደንጋም። <verse eid="1TI 1:8"/><verse number="9" style="v" sid="1TI 1:9"/>ህትን ሕጉ ኣሰሞሁ ሕገ ድጅታሀኑኡተለከ አዘዘንትበ መኒሃ፥ መገኑ ዮሰበእሀኑኡተለከ ጩበኛኖተ፥ ጠሊልመት ዮሰበእሀኑኡተለከ አመዕነት ጠወ ግባሀኑኡተ፥ አናኖተለከ አማኖተ፥ ሽታሀኑኡታትለከ ነቢሳሃ ቤሳሀኑኡተ <verse eid="1TI 1:9"/><verse number="10" style="v" sid="1TI 1:10"/>ዝነተ አታሀኑኡተለከ ለቦሁ ለቤን ዝነተ አታሀኑኡተ፥ መነ ነገዳሀኑኡተለከ ክዝባሀኑኡተ፥ ክዝቢን ጤሌዕሊታሀኑኡተለከ ሀንቅ ትምህርቲን ሀንበዕለመኖ ጠወ ጉዕመንከ አታሀኑኡታት፤ ጡመ ሴሪን ኦደንታ መኒሃት ቤሉ ጡመ መኒሃበአ። <verse eid="1TI 1:10"/><verse number="11" style="v" sid="1TI 1:11"/>ኩንን ሀንቅ ትምህርቱ ደገመኖሁ ገለትጨሞ መገን አዲች ዱዱብሰኖ ከበጀሞ እንጂሊቺት፤ ኩ እንጂሉ ኤሳሃ ኤገተ ኣሰሞኤሃን።<verse eid="1TI 1:11"/></para>
  <para style="s1">ጳዉሎስ መገኑ ገለትጩስ</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12"/>ኤሳሃ ሆጎሃስ ካዲንቹ መጠር አመዕነሞሚሃ አዕይ ዎለዕዮኤሁለከ ዎልቀተ ኣሴኤ ቀርቹኔ መሲህ ኢሰ ገለትጫም። <verse eid="1TI 1:12"/><verse number="13" style="v" sid="1TI 1:13"/>አንን ከኒች ብርተ ሸራሚሃ፥ መሲህ ኢሰ ቦሮሮሚሃለከ ሆፍሾሚሃ እኮምጎሬሁ ህካን ጉዕመንከ አዕዮሚሁ ደጉ ሆጊንለከ አመዕኑ ሆጊን እኮቤቺሃ ማርቱተ ደኤም።<note caller="-" style="x"><char style="xo" closed="false">1፥13 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ሶቀ. 8፥3</ref>፤ <ref loc="ACT 9:4-5">9፥4-5</ref>።</char></note> <verse eid="1TI 1:13"/><verse number="14" style="v" sid="1TI 1:14"/>ህትን መሲህ ኢሲን ደገመኖ አመዕነቲንለከ ኢታን ሜጡበ ቀርችኔ ኣስቱት በተእ ኣሰንቶኤ። <verse eid="1TI 1:14"/><verse number="15" style="v" sid="1TI 1:15"/>«ጩበኛኑተ ፌሶተ መሲህ ኢስ ከ ኣዱንያ አል አሜቾ» ይታ ላገት ሀንቅያለከ መኑ ጉዕሙንኩ ኣኡ ሀስሰኖሃን፤ አንን ጩበኛኖች ጉዕሚችን ዎዕኔስሃን። <verse eid="1TI 1:15"/><verse number="16" style="v" sid="1TI 1:16"/>ጠዉ እኮጎሬ መገኒች ማርቱተ ደኤም፤ ማርቱተ ደኤሚሁ መሲህ ኢስ ዳንጉ ዮበኢሃ አታዕሉስ ጉዕሚችን ባሾም ጩበኛ እኮም ኢ አሌን ለሊሽ እሲን አመዕንታሀኑኡተ ዘላለሚሃ ሄኡ ደእታሀኑኡተ ምሳልተ እሆታት። <verse eid="1TI 1:16"/><verse number="17" style="v" sid="1TI 1:17"/>ህካን እኮቤቺሃ ዘላለሚሃ ዎመ እክ ሬሀኖበእለከ ለለኖበእ ሜጦሃ መገኒሃ ሎርመትለከ ከበጁ ዘላለሚሃ እሁንስ፤ ኣሚዕን!<verse eid="1TI 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18"/>ኢ ቤቶ ጢሞቲዎሴ! ዎዕናንከ ኪተኔሃ ኩለሞ ራግገን ጡመ ኦለንሸ ኦለንቶተ፥ <verse eid="1TI 1:18"/><verse number="19" style="v" sid="1TI 1:19"/>አመዕነቱሁ ጡሙ ቀልቡሁ ሄኦሄተ ከ ትዛዝ ኤገተ ኣሳንኬት፤ መሰንትስ መት-መቱ መኑ መርከበ ሸረኖሁ ዮበእ ጎሬ በአኖሀንገን ቀልብ ሆጊን አመዕነቱሰ ቤሶኡ። <verse eid="1TI 1:19"/><verse number="20" style="v" sid="1TI 1:20"/>እሰ በላንን ሄሜኖስለከ እስክንድር ደገንታአ፤ እሰን መገን አሌን ቦሮር ላገተ ጠወኢች ተማርቶተ ሼይጣኒሃ አን ህግሽ ኣስዮንሰረ።<verse eid="1TI 1:20"/></para>
  <chapter eid="1TI 1"/>
  <chapter number="2" style="c" sid="1TI 2"/>
  <para style="s1">መገን ምኔን ዱአ አእተኔሃለከ ሴርተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1"/>መኑ ጉዕሙንኩ መገን አደ ኡጭቱተ፥ ዱአሃ፥ ዎሎ መኒሃ ዱአ አኡለከ ገለትጩሁ መኑ ጉዕሙንኩ አኦተ ሸዛም። <verse eid="1TI 2:1"/><verse number="2" style="v" sid="1TI 2:2"/>መገኑ ዋጂን ጡመ ሃሊን አዎነን ወገሬቲንለከ ጨለዪን ሄዕኖተ በትሽን ዎማተለከ አበ ሆጎ አሌን ዮሀኑኡተ ዱአ አዕዬ። <verse eid="1TI 2:2"/><verse number="3" style="v" sid="1TI 2:3"/>ሁኩንን ፌሳንቹሃኔ መገን ብሬን ጡማለከ ተሽ የኖሃ ጠወ። <verse eid="1TI 2:3"/><verse number="4" style="v" sid="1TI 2:4"/>መገን ሃሽኣቱት መኑ ጉዕሙንኩ ጡሞተለከ ሀንቅ ደጋጋት። <verse eid="1TI 2:4"/><verse number="5" style="v" sid="1TI 2:5"/>መገኑ ሜጥቹሃን፤ ህትን መገንለከ መን በላን እኮ መቱ መንቹ ዮኡ፤ እስን መንቹ እኮ መሲህ ኢሳት። <verse eid="1TI 2:5"/><verse number="6" style="v" sid="1TI 2:6"/>እስን መነ ጉዕመንከ ዎዞተ ገዉስ ዎዝኑተ አዕይ ኣሴእ፤ ሁኩንን መገኑ መነ ጡምሶተ ሀሾገ ሀስሰኖ ወክቴን ሀሴማእሃ ምስክር። <verse eid="1TI 2:6"/><verse number="7" style="v" sid="1TI 2:7"/>አን አይሁደ እህበ መኒሃ አመዕነቱለከ ሀንቅ ተማርሶተ ዱዱብሳንቹለከ አሳቤቹ እክ ሾመሞም፤ ህካን ያም ወክት ሀንቅ ጠወኣሚት ቤሉ ክዝቦምበአ።<note caller="-" style="x"><char style="xo" closed="false">2፥7 </char><char style="xt" closed="false"><ref loc="2TI 1:11">2 ጢሞ. 1፥11</ref>።</char></note><verse eid="1TI 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8"/>ቴሱ ጎኑ ቤቾን ጉዕማንን ኡሙዕርተለከ ብተት ዮበኢሃ ጠሊለተ አንገተ አሌ ኬስ ዱአ አቶተ ሀሳም። <verse eid="1TI 2:8"/><verse number="9" style="v" sid="1TI 2:9"/>ህትን ሜንቱ ሙምሰ ደደን ህከረንገ ወርቂን፥ ናሲን ህከረንገ ጤአተ እኮ ኦድኑተ ሹልምሰን እሁዕናን ማሌን ጡምማን ሀስሰኖጊን ጡመተ ኦድኑተ ኦደኡን፤<note caller="-" style="x"><char style="xo" closed="false">2፥9 </char><char style="xt" closed="false"><ref loc="1PE 3:3">1 ጴጥ. 3፥3</ref>።</char></note> <verse eid="1TI 2:9"/><verse number="10" style="v" sid="1TI 2:10"/>መገኒሃ ሰገንዳሚት ይታ ሜንቱ አኡ ሀስሰኖሰገ ጡመ ሆጉተ አቱን። <verse eid="1TI 2:10"/><verse number="11" style="v" sid="1TI 2:11"/>ህትን መንቹት ጉዕመ ጠዋን አዘዘሚን ሎድት ተማርቱን። <verse eid="1TI 2:11"/><verse number="12" style="v" sid="1TI 2:12"/>ህትን መንቹት ጨለ ይቱን ቤሉ ተማርስቶተ ህትን ጎን አሌን ሹመ እኩን ያምበአ። <verse eid="1TI 2:12"/><verse number="13" style="v" sid="1TI 2:13"/>መሰንትስ ሄጭ ከለቀሞሁ ኣደማት፤ ህከኒች ኤተሮን ሐዋ ከለቀንቶኡ።<note caller="-" style="x"><char style="xo" closed="false">2፥13 </char><char style="xt" closed="false"><ref loc="GEN 2:7">ክል. 2፥7</ref>፤ <ref loc="GEN 21:22">21፥22</ref>።</char></note> <verse eid="1TI 2:13"/><verse number="14" style="v" sid="1TI 2:14"/>ህትን ጣንሰንት መገን ሕገ ድጅቶኢት ሐዋት ቤሉ ኣደም ጣንሰሞበአ።<note caller="-" style="x"><char style="xo" closed="false">2፥14 </char><char style="xt" closed="false"><ref loc="GEN 3:1-6">ክል. 3፥1-6</ref>።</char></note> <verse eid="1TI 2:14"/><verse number="15" style="v" sid="1TI 2:15"/>ጠው እኮጎሬ መንቹት አመዕነቲኒ፥ ኢታኒ፥ ጠሊልማንለከ ገው አገዕርን ሄኦ ጎሬ እለተ እሊን ጡምታአ።<verse eid="1TI 2:15"/></para>
  <chapter eid="1TI 2"/>
  <chapter number="3" style="c" sid="1TI 3"/>
  <para style="s1">አመዕናኖ አዎንሳኖተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1"/>«አዪሁ አመዕናኖ አዎንሳንቹ እሆተ ሀሾ ጎር ሎረ ሆጉተ ሃሸአኖት» ይታ ላገት ሀንቅሃን። <verse eid="1TI 3:1"/><verse number="2" style="v" sid="1TI 3:2"/>አመዕናኖ አዎንሳንቹንኩ ኩሌኖስ ጠዉ ዮስበኢሃ፥ መቴ መንቾተ ምኒ አነ እኮሃ፥ ጌሲን ሄአኖሃ፥ ገዉስ አገዕረኖሃ፥ ኬዕምኝስ አገዕረኖሃ፥ ኮሀ ቶገኖሃ፥ ተማርሲሃ አታለኖሃ፥ <verse eid="1TI 3:2"/><verse number="3" style="v" sid="1TI 3:3"/>ሰከሪባሃ፥ ኡሙዕሪባሃ፥ ጎደበ ላፈ፥ ብተምባሃ፥ ብረ ኢትባሃ፥ <verse eid="1TI 3:3"/><verse number="4" style="v" sid="1TI 3:4"/>ገይስ ምኒ አበሮሱ ጡመገ ገሾተ አታለኖሃ፥ እለስ አዘዘንታሲሃ፥ ጉዕመንከ አዲን ኬዕምሳሲሃ እሁ ሀስሰኖስ። <verse eid="1TI 3:4"/><verse number="5" style="v" sid="1TI 3:5"/>መሰንትስ መቱ መንቹ ምንስ ገሾተ አታልባች መገኑ አመዕኔ መነ ገሾተ ሀት አታለኖ? <verse eid="1TI 3:5"/><verse number="6" style="v" sid="1TI 3:6"/>ህትን እልቢስ አሌን ፈረደሞገን ቦኝያን አሌስ ፈረደመኖበእገ ሃዕሮ አመዕኔ መንቹ አዎንሳንቹ እሁንከ። <verse eid="1TI 3:6"/><verse number="7" style="v" sid="1TI 3:7"/>ህትን ሆፍኚንለከ ሻይጣን ዎሻድን ኣገኖበእገ አመዕንበ መንቤቾን ገለትጨሞኢሃ እሁ ሀስሰኖስ።<note caller="-" style="x"><char style="xo" closed="false">3፥2-7 </char><char style="xt" closed="false"><ref loc="TIT 1:6-9">ቲቶ 1፥6-9</ref>።</char></note><verse eid="1TI 3:7"/></para>
  <para style="s1">ድያቆናከተኔሃ</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8"/>ህትን ድያቆናከተ<note caller="+" style="f"><char style="fqa" closed="false">ድያቆናከ ሆጉት፦ </char><char style="ft" closed="false">አመዕናኑተ አዎንስታ ባልቀተ ሀዕልታእራን።</char></note> ኬዕምኙ ሀስሰኖሰረ፥ ለሙ ጠወኣበእረ፥ ዎይን ጠጂን ሰከርታበእረ፥ ብሪሃ ጎራይትበረ እሁ ሀስሰኖሰ። <verse eid="1TI 3:8"/><verse number="9" style="v" sid="1TI 3:9"/>ህትን አመዕነቲን ለሌ ሀንቅ ነጠ ቀልቢን ጠረኝስ አፉ ሀስሰኖሰ። <verse eid="1TI 3:9"/><verse number="10" style="v" sid="1TI 3:10"/>እሰንተ ሄጬን ፌተኔን ለኡ ሀስሰኖ፤ ህከኒች ኤተሮን ኩሌኖሰ ጠዉ ዮበእራ እኮኢች ዲያቆነ እኮተ አታልታአ። <verse eid="1TI 3:10"/><verse number="11" style="v" sid="1TI 3:11"/>ህትን ምንሰ አማኑት ኬዕምሴኖሰረ፥ ሄዕምታበእረ፥ ገዉሰ አገዕርታእረለከ ጉዕመርቾንን አመዕነንቶእራ እሁ ሀስሰኖሰ። <verse eid="1TI 3:11"/><verse number="12" style="v" sid="1TI 3:12"/>ህትን ዲያቆነት መቴ መንቾ ምኒ አነ እኮረ፥ ኦሱሰለከ አበሮሱሰ ጡመገ ገሽታእረ እሁ ሀስሰኖሰ። <verse eid="1TI 3:12"/><verse number="13" style="v" sid="1TI 3:13"/>መሰንትስ ዲያቆነት ጡመገ ሆጉተ አታእሩ ገይሀሰ አበ ኬዕምኝ ደእታአ፤ ህትን መሲህ ኢሲን ዮሰ አመዕነትተኔ ልግብ መለሉ ደእታአ።<verse eid="1TI 3:13"/></para>
  <para style="s1">ማጠሞ ሎረ ምስጥርተኔሃ</para>
  <para style="p">
    <verse number="14-15" style="v" sid="1TI 3:14-15"/>ፎሊን ሄአኖ ዱእ ምኒ በላን መቱ መንቹ ሀት እክ ሄኡ ሀስሰኖሰ ጎሬ ሀት እክ ፈንቀላመኖ ጎር ደጋገ ከተቦንኬ፤ ሁኩ መገን ምኑንኩ ሀንቅ ቱቃለከ ቀበበ። <verse eid="1TI 3:14-15"/><verse number="16" style="v" sid="1TI 3:16"/>አመዕነትኔ ማጠሞ ጠዉ ሸክሲስበ ሎረሃን፤ እስን</para>
  <para style="q1" vid="1TI 3:16">መንቹ እክ ለልዮእሃ፤</para>
  <para style="q2" vid="1TI 3:16">ሀንቅ እሁስ ጠሊለ አያኒን አዋጀሞእሃ፤</para>
  <para style="q2" vid="1TI 3:16">መላይካተ ለልዮእሃ፤</para>
  <para style="q1" vid="1TI 3:16">መኒሃ ጉዕሚንከ ዱዱብሰሞእሃ፤</para>
  <para style="q2" vid="1TI 3:16">ከን ኣዱንያ አል መኑ አመዕንዮስሃ፤</para>
  <para style="q2" vid="1TI 3:16">ኬዕምኚን ሰማሃ ኦሮዕዮእሃ።<verse eid="1TI 3:16"/></para>
  <chapter eid="1TI 3"/>
  <chapter number="4" style="c" sid="1TI 4"/>
  <para style="s1">ክዝብ አስተማረተ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1"/>ጠሊሉ አያኑ ለሊሽ «ኤተር ዘማኔን መት-መቱ መኑ ሉሲሰኖ ሂለ አያነለከ ሩሃንይ ትምርት አዎንተን አመዕነቲች አደ እክ ቄዕርታአ» የኖ። <verse eid="1TI 4:1"/><verse number="2" style="v" sid="1TI 4:2"/>ሁኩ ትምርቱ አሜተኖሁ አታኢሁ ሀንቅ እሁስለከ ሀንቅ እሁ ሆጉስ ደገንን አመሰልታ ክዝበኛኖችት። <verse eid="1TI 4:2"/><verse number="3" style="v" sid="1TI 4:3"/>እሰን ኤበቀንሸ ከንታአ፤ አመዕንታለከ ሀንቅ ደጋ መኑ እሱ ገለትጭተን እታገ መገኑ ከለቆሰ እቸተ «እቶኖቼ» ይት ከንታአ። <verse eid="1TI 4:3"/><verse number="4" style="v" sid="1TI 4:4"/>ጠዉ እኮጎሬ መገን ክልቀቱ ጉዕሙንኩ ጡመ እኮቤቺሃ ገለትጬን ቶጌመጎሬ ኡጄኖሁ መቱሁ ዮበአ። <verse eid="1TI 4:4"/><verse number="5" style="v" sid="1TI 4:5"/>መሰንትስ ሁኩን መገን ላጋንለከ ዱአ አኢን ጠሊለ እሀኖ።<verse eid="1TI 4:5"/></para>
  <para style="s1">መሲህ ኢስ ጡመ ካድንቹ እህተኔሃ</para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6"/>ከ ትምህርት አመዕናኖተ ኣቶንትጎር አመዕነት ላገተለከ አዎንቶንት ጡመ ትምርተሃ እት ነጵቶንት ጡመ መሲህ ኢስ ካድንቹ እካንት። <verse eid="1TI 4:6"/><verse number="7" style="v" sid="1TI 4:7"/>ህትን ከን ኣዱንያ አሊች ደግለሊበ ጠዊችለከ ዱንየ አል ማቁተ አጉደኖ ጠዊች ሁን፤ ገዉክ መገን ጠዊሃ ሮስስ። <verse eid="1TI 4:7"/><verse number="8" style="v" sid="1TI 4:8"/>መሰንትስ ገዉ ጠረኝሰኖ ጠወ ሮስሱ ቀዉ ደግለለኖ፤ እኮጎሬ ገዉ መገን ጠዊ ሮስሱ ከን ሄኢሃለከ አሜተኖ ሄኢሃ ተቢሶሁ ዮስቤቺሃ ጉዕመ ጠዊንከ ደግለለኖ። <verse eid="1TI 4:8"/><verse number="9" style="v" sid="1TI 4:9"/>ህካን ዩ መኑ ጉዕሙንኩ ሹል ቶጉ ሀስሰኖሰ አመዕነሞሃ ጠወ። <verse eid="1TI 4:9"/><verse number="10" style="v" sid="1TI 4:10"/>ነኡን መነ ጉዕመንከ አደንከ አመዕንታሀኑኡተ ጡምሰኖለከ ሄአኖ መገኖን ተቢሳሃ አዕናምቤቺሃ ሆጎን ሆንጋሚሁለከ አጰማሚሁ<note caller="+" style="f"><char style="fqa" closed="false">አጰማም፦ </char><char style="ft" closed="false">የኖሁ መት-መቱ ኪታበት ቦሮረማሚት ይታአ።</char></note> ከ ጠወ ደኢሃት።<verse eid="1TI 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11"/>አት ከ ጠወ አዘዝለከ ተማርስ። <verse eid="1TI 4:11"/><verse number="12" style="v" sid="1TI 4:12"/>ህትን ጠወኦንት ጠዊን፥ ሃሊን፥ ኢታን፥ አመዕነቲንለከ ሙጩርማን አመዕናኖተ ምሳልተ እህ ቤሉ አዪሁ ኦስመክ ህንቁንከ። <verse eid="1TI 4:12"/><verse number="13" style="v" sid="1TI 4:13"/>ህትን አን አሜቶተ እለሬተ ጠልለ መጻፈ መኒሃ አነበቡ፥ ዱዱብሱለከ ተማርሱ ጠረኝ። <verse eid="1TI 4:13"/><verse number="14" style="v" sid="1TI 4:14"/>ህትን ባልቀት አሌንከክ አንገሰ አታን ራጉ ጠወአሞሄ ወክት ኣሰሞሄ ኪን ዮ ኣስቱት ህንቆት። <verse eid="1TI 4:14"/><verse number="15" style="v" sid="1TI 4:15"/>ነጱክ መኑ ጉዕሙንኩ ደጎተ ወክትክ ጉዕመንከ ከን ጠዊሃ አእ፤ ከ ጠወ ሆጎ አሌን ሆሲስ ገዉክ እሲሃ ኣስ። <verse eid="1TI 4:15"/><verse number="16" style="v" sid="1TI 4:16"/>ገይሃክለከ ተማርስታንት ትምርተክ አገዕር፤ ከ ጠወ አተን ጠረኝ፤ ህካን አቶንትጎር ገዉክለከ ኪች ሞጮጨኖ መነሃ ጡምሳንት።<verse eid="1TI 4:16"/></para>
  <chapter eid="1TI 4"/>
  <chapter number="5" style="c" sid="1TI 5"/>
  <para style="s1">መኒሃ ኣሰንቶ ሸዘነተ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1"/>ባሊቆ መንቹ አንክገ ሆንጠህ ቤሉ ሻቆት፤ ህትን ዎደልቹ አመክ ኦሱተ ጠውሲሳንትገ ጠውሲስ <verse eid="1TI 5:1"/><verse number="2" style="v" sid="1TI 5:2"/>ባሊቅ ሜንቱ አማኖገ ሀርድ ሜንቱ አመክ ኦሶገ አት ዊመ ሙጩርማን ለእ።<verse eid="1TI 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3"/>ሀንቅንከ ምንሰ አኑ ሬዮ ሜንቱ ሀዕልተን ከበጅሰ። <verse eid="1TI 5:3"/><verse number="4" style="v" sid="1TI 5:4"/>ጠዉ እኮጎሬ ምንሴ አኑ ሬዮ መንቾ እለት ህከረንገ እለ እለት ዮሴጎር ሁኩ እለት ሄጭት ምንሰ መነ ደግለሊን ኤዳሰ ፈንቀሽቱን፤ ህከን አመዕነቲን ሆጉተ ተማርቱን፤ መሰንትስ ሁኩን መገኑ ሙንዲሲሰኖሃ ጠወ። <verse eid="1TI 5:4"/><verse number="5" style="v" sid="1TI 5:5"/>ምንሴ አኑ ሬዮ ሀንቅ ህዬሸት ሜጢሃሴ ሄኣ መንቹት መገኖን ተቢሳሃ አታቤቺሃ ሀንከዕርተለከ በራሃ መገኑ ጠዕሚንለከ ዱአ አተን ጠረኝት ሄኣአ። <verse eid="1TI 5:5"/><verse number="6" style="v" sid="1TI 5:6"/>ጠለዕል ከን ዱንያ አል መኩተ ሀሳ ምንሴ አኑ ሬዮ መንቹት ነቢሴን ሄኦ ጎሬ ሬቶእታን። <verse eid="1TI 5:6"/><verse number="7" style="v" sid="1TI 5:7"/>እሰን ቀነጤኖሰርቹ ዮበእረ እኮተ ከ ትምርተ ኣስ። <verse eid="1TI 5:7"/><verse number="8" style="v" sid="1TI 5:8"/>ህካን እኮቤቺሃ እሊሃስ አደደንከ ምንስ መኒሃ ሰውየኖበእ መንቹ አዪሁ አመዕነቱስ ካጆእሃን፤ ህትን ሁኩ መንቹ አመዕንዮበእ መንቺች ባሰ ሂላን።<verse eid="1TI 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9"/>ዎዕነሃ መቶ መንቾን ገልት እለንቶች ሌሃዉ ዘማን ዊምበሴ ምንሴ አኑ ሬዮ መንቹት ምንሰ አኑ ሬዮሀኑኡ መዝገባን ከተበንቱንከ። <verse eid="1TI 5:9"/><verse number="10" style="v" sid="1TI 5:10"/>ህትን እለተ ነሲን፥ ኮሀ ቶጊን፥ አመዕናኖ ሎከተ ኣንሺን፥ ኦርጨሞ መነ ሀዕሊን፥ ጡመ ሆጉተ ጉዕመንተ አኢን ጡመ ሆጎንከሴ ገለትጨንቶኢተ እሁ ሀስሰኖሴ።<verse eid="1TI 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11"/>ጠዉ እኮጎሬ ምንሰ አኑ ሬዮ ሀርድ ሜንቱ ምንሰ አኑ ሬዮ ሜንት መዝገባን ከተቦት፤ መሰንትስ እሰ ማል ሄዕላቸት ቄልትየንሰ መሲህ ኢሳን ዮሰ ኢተት በአን ጎናን ገልቶተ ሀሳኢት። <verse eid="1TI 5:11"/><verse number="12" style="v" sid="1TI 5:12"/>ኩ ሜንቱ ዎዕነሃ ይቶ ላገተ ድጅቶቤቺሃ አሌንከሰ ፍርደ ኤባአ። <verse eid="1TI 5:12"/><verse number="13" style="v" sid="1TI 5:13"/>ህከኒችን አበንከ ሆጉተ ገፈሩለከ ምኒች ምኒ ዘሁ ሮሳአ፤ ህትን ሆጉተ ገፈሩ እሁዕናን ሄዕምታእረለከ መን ጠዋን ኣገን ጠወኡ ገበእበሳሃ ጠወኣራ እካአ። <verse eid="1TI 5:13"/><verse number="14" style="v" sid="1TI 5:14"/>ህካን እኮቤቺሃ አን ምንሰ አኑ ሬዮ ሀርዴ ሜንቱ ገልቶተ፥ እለተ እልቶተ፥ ምንሰ ጡመገ ገሽቶተ ሸዛም፤ ህት አኦን ዲኑኔ ቦሮረኖ ጠወ ሆገኖ። <verse eid="1TI 5:14"/><verse number="15" style="v" sid="1TI 5:15"/>መሰንትስ ከኒች ዎዕነሃ ምንሰ አኑ ሬዮ መት-መቱ ሜንቱ ሻይጣነ አዎንተን አመዕነት ዎቄች ፉልቶኡ። <verse eid="1TI 5:15"/><verse number="16" style="v" sid="1TI 5:16"/>መቴ አመዕናንቾ መንቾ ምኔን ምንሰ አኑ ሬዮ ሜንቱ ሄኦጎር አመዕናኖ ማበሪሃ ኬዕመኖበእገ እሴ ሀዕልቱንሰ፤ ከን ሃሊን አመዕናኖ ማበሩንኩ ሀዕለኖሳሁ ዮበእ ምንሰ አኑ ሬዮ ሜንቲሃ ሀዕለኖ።<verse eid="1TI 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17"/>አመዕናኖ ማበረ ጡመገ ገሽታ ባሊቀት ዱዱብሲንለከ ተማርሲን ጠረኝት አታሀኑኡተ ለሙ አፎሁ ኬዕምኙ ሀስሰኖሰ። <verse eid="1TI 5:17"/><verse number="18" style="v" sid="1TI 5:18"/>መሰንትስ ጠሊሉ መጻፉ «ውጠተ ዎቀርተን ቦር አፎ ኡሱርቶት» ህትን «ሆጉተ አአኖሀኒሃ ደሞዙ ሀስሰኖስ» የመሞኡ።<note caller="-" style="x"><char style="xo" closed="false">5፥8 </char><char style="xt" closed="false"><ref loc="DEU 25:4">ዘዳ. 25፥4</ref>፤ <ref loc="MAT 10:10">ማቶ. 10፥10</ref>፤ <ref loc="LUK 10:7">ሉቃ. 10፥7</ref>።</char></note> <verse eid="1TI 5:18"/><verse number="19" style="v" sid="1TI 5:19"/>ለሙ ህከረንገ ሰሱ መንቹ መሰከርትባች አመዕናኖ ማበር ባሊቅ አሌን ሆንጠህሴኖ ኦደተ ቶጎት።<note caller="-" style="x"><char style="xo" closed="false">5፥19 </char><char style="xt" closed="false"><ref loc="DEU 17:6">ዘዳ. 17፥6</ref>፤ <ref loc="DEU 19:15">19፥15</ref>።</char></note> <verse eid="1TI 5:19"/><verse number="20" style="v" sid="1TI 5:20"/>ህትን ዎሉ መኑ ዋጅታገ ጩብ አታ መነ ጉዕመንከ መን ብሬን ኡሙዕር።<verse eid="1TI 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1TI 5:21"/>ህትን መነ አደ አኡ ዮበኢሃ መቱ-መቲች በትሱዕናን ከ ኩሌመሄ ጠወ አገርቶተ መገን ብሬንለከ መሲህ ኢስ ብሬን መጠረንቶ መላይከ ብሬን ኤገተክ ያንኬ። <verse eid="1TI 5:21"/><verse number="22" style="v" sid="1TI 5:22"/>ህትን አንገክ አዬ አሌኒ ደዕልት አቶት፤ ዎሎ መን ጩብ ቤቀንቶት፤ ገዉክ ሙጩሩ አት አገዕር።<verse eid="1TI 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23"/>ልግብ ወክት ጎደበክ ጥዘኖሄቤቺሃለከ ጥዘነት ዮሄቤቺሃ ቀዉንከ ወይን ጠጀ አግ ቤሉ ከ ኤተሩ ጠለዕል ዋሃ አጎት።<verse eid="1TI 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24"/>መት-መቶ መን ጩቡ አገንቹ እክ ለለኖ፤ ሁኩንን ፍርድበ ኢልሰኖ፤ ህትን ዎሎ መን ጩቡ ዱንክ ለለኖ። <verse eid="1TI 5:24"/><verse number="25" style="v" sid="1TI 5:25"/>ህትን ጡመት ሆጉት ኑሪ እክ ለልታአ፤ ኑሪ እክ ለልትበጎሬ ማጠንቶገ ሄኣበአ።<verse eid="1TI 5:25"/></para>
  <chapter eid="1TI 5"/>
  <chapter number="6" style="c" sid="1TI 6"/>
  <para style="s1">ሮሳተ ኣሰንቶ ሸዘነተ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1"/>መገን ሱዕሙለከ ትምርቱ ቦሮረመኖበእገ ሮሶመ ኣዜን ሄኦሩ ጉዕሙንኩ ቀርቻኖተሰ ዊሙ ኬዕምኙ ሀስሰኖሰገ ደጉን። <verse eid="1TI 6:1"/><verse number="2" style="v" sid="1TI 6:2"/>ህትን አመዕናኖ ቀርቻኑት ዮሰ ሮሰት ቀርቾ መሲህ ኢሲን አመኦሱተ እኮቤቺሃ ቀርቻኑሰ ኬዕምስበረ እሁ ሀስሰኖሰበአ፤ ህከን ወጢ ጡመ ሆጎንከሰ ሀዕልታእረ አመዕናኑተለከ ኢተንቶእረ እኮቤቺሃ ዎዕኔች አበ አኡ ሀስሰኖሰ፤ ከ ጠወንከ ተማርስተን ሸዝ።<verse eid="1TI 6:2"/></para>
  <para style="s1">ክዝብ ትምርተለከ ሀንቅ ቀባጦተኔሃ</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3"/>አዪሁ ቀርቹሃኔ መሲህ ኢስ ላጋንለከ መገኑ አጉዲን ትምርታን ሀንበዕለመን ዎሉ ትምርተ ተማርሴጎሬ <verse eid="1TI 6:3"/><verse number="4" style="v" sid="1TI 6:4"/>ሁኩ መንቹ ቦኒን ቡሰሞሃ ቤሉ መቱርቹሃ ደግበሃን፤ ጠዉ እኮጎሬ ወገሬቱ ዮበእ ሄዕላቸት አፎስ፤ ሁኩንን ኤበኖሁ ምቀኝመተ፥ ብተተ፥ ቦሮዕረንሸለከ ሂለ ሸክተ <verse eid="1TI 6:4"/><verse number="5" style="v" sid="1TI 6:5"/>ቀልቡሰ በዕዮለከ ሀንቂች ፉልቶ መን በላን እኮ ተንቅታበእ ኦደተ ኤበኖሃን፤ እሳንከ መገኑ አመዕኑ ዱንያተ ደኤኖ ዎቃሃ አጉጆሰረን።<verse eid="1TI 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6"/>ጠዉ እኮጎሬ «ዮኤሁ እሀኖኤ» የኖ መንቺሃ መገኑ አጉጅ ሄኡ ትርፈ ደግሲሰኖ፤ አመዕነቶን ሀንቅንከ ልግቡ ትርፉ ዮስሃን። <verse eid="1TI 6:6"/><verse number="7" style="v" sid="1TI 6:7"/>መሰንትስ ነኡ ከን ኣዱንያ አል አሜንቶሚሁ መቱርቹሃ አንፉዕናንት፤ ህትን ከን ኣዱንያ አሊች መቱርቹሃ አንፍ መርኖተ አታልናምበአ። <verse eid="1TI 6:7"/><verse number="8" style="v" sid="1TI 6:8"/>ጠዉ እኮጎሬ እንታሚሁለከ ኦደዕናሚሁ ሄዕዮኔች ሁኩን እሀኖኔ። <verse eid="1TI 6:8"/><verse number="9" style="v" sid="1TI 6:9"/>ህትን ቀባጣሙ እህሃ ሀሳ መኑ ፌተናን፥ ዎሻዶንለከ መኒ በኡ ኤበኖ ገውሰኖለከ ምዕረኖ ልግቤ ሄዕላቶን ኡባአ። <verse eid="1TI 6:9"/><verse number="10" style="v" sid="1TI 6:10"/>መሰንትስ ብረ ኢቱ ልግቤ ሂልማተ ጉዕሚንከ ጠጳን፤ መት-መቱ መኑንኩ ብረ ደኢሃ አበ ሄዕላቶቤቺሃ አመዕነቲች ኡቦኡ፤ ልግቤ ሻዞን ቀልቡሰ ቢጠመኖገ አቶኡ።<verse eid="1TI 6:10"/></para>
  <para style="s1">ጳዉሎስ ጥማቶሴሃ ኣሴ ሸዘነተለከ ትዛዝተኔሃ</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11"/>ጠዉ እኮጎሬ አት መገን መንቾ! ከን ጉዕማንከ ጠዊች ሁን፤ ፈይመተ፥ መገን ጠወሃ፥ አመዕነቱሃ፥ ኢተታ፥ አታዕሉለከ ጎደበ ላፍመተ አኡሃን። <verse eid="1TI 6:11"/><verse number="12" style="v" sid="1TI 6:12"/>ጡመ አመዕነት ኦለንሸ ኦለም፤ ዘማን ጉዕሚንከ ሄኡ አፍ፤ ህከ ዘላለም ጉዕሚንከ ሄኢሃ ገአንት ልግብያ ምስክር ብሬን ጡመ ምስክርነቱ መሰከርቶንት። <verse eid="1TI 6:12"/><verse number="13" style="v" sid="1TI 6:13"/>ህትን ጉዕመርቺንከ ሄኡ ኣሰኖ መገንለከ ጴንጤናዌቾሃ ጵላጦሴ ብሬን ጡመ ምስክር መሰከሮ መሲህ ኢስ ብሬን<note caller="-" style="x"><char style="xo" closed="false">6፥13 </char><char style="xt" closed="false"><ref loc="JHN 18:37">ያህ. 18፥37</ref>።</char></note> <verse eid="1TI 6:13"/><verse number="14" style="v" sid="1TI 6:14"/>ቀርቹኔ መሲህ ኢስ ፈንቀል አሜቶተ እለ ከ ትዛዝ ሉጨንሹለከ ህንቄኖስ ጠዉ ዮበእገ እክ አገርቶተ አዘዛንኬ። <verse eid="1TI 6:14"/><verse number="15" style="v" sid="1TI 6:15"/>መሲህ ኢሲ አሜቱ ማሰአሞለከ ሜጥሃስ ገሻንቹ እኮ ዎመ ዎሙለከ ቀርቻኖ ቀርቹ መገኑ ለልሾ በሬን እሀኖ። <verse eid="1TI 6:15"/><verse number="16" style="v" sid="1TI 6:16"/>ህትን ጠለዕሉ እስ ሬሀኖበእሃን፤ አዪሁ ሆንጠሆተ አታለኖበእ ኑሬን ሄአኖሃን፤ እሱንከ አዪሁ ለዕይ ከሰበአ፤ ህትን አዪሁ ለኦስተ አታለኖበአ፤ እሲንከ ኬዕምኙለከ ዎልቀት ዘላለሚሃ እኩንስ፤ ኣሚዕን!<verse eid="1TI 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17"/>ነኡ ሙንደዕኖተ ጉዕመንከ በትሽ ኣሰኖ መገን ቤሉ ከን ኣዱንያ አሌን ዮ ቀባጣመት ቦንታበእገ ህከረንገ አመንስሾበእ ቀባጦን ተቢሳሃ አታበእገ አዘዝሰ። <verse eid="1TI 6:17"/><verse number="18" style="v" sid="1TI 6:18"/>ህትን ጡመተ ሆጉተ አቶተ፥ ጡመ ሆጎን ቀባጣመተ እኮተ፥ መኒሃ ሀዕሊሃ ዮሳሃ ቤኮተ ተቃጠባገ አዘዝሰ። <verse eid="1TI 6:18"/><verse number="19" style="v" sid="1TI 6:19"/>ህትንን ሀንቅ ሄኡ ደእቶተ ቀበቡሰ ጠረኘ እኮ ቀባጡተ አሜተኖ ዘማኒሃ ገይሃሰ ጭምአታአ።<verse eid="1TI 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20"/>ጥማቶሴ! ኣሰንቶሄ ኤገተ አገር፤ ህትን ገገይንከስ ሀንበእለንሺን ኤንኬዕኒን እሁዕነ መኑ ክዝብን «ኤንኬዕነኑሃን» ይት ገእታ ኤንኬዕኒችለከ ደግለለኖበእ ኣዱንያ አል ጠዊች ሁን። <verse eid="1TI 6:20"/><verse number="21" style="v" sid="1TI 6:21"/>መት-መቱ መኑ «ህትኔ ኤንኬዕኑ ዮኔ» ይተን አመዕነት ዎቃሃ ሉሶኡ፤ መገን ኣስቱት ክዕኔን እኩን!<verse eid="1TI 6:21"/></para>
  <chapter eid="1TI 6"/>
</usx>
