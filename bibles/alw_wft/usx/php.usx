<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- HALABA NEW TESTAMENT</book>
  <para style="h">ፍልጵስዩስ</para>
  <para style="toc1">ጳዉሎስ ፍልጵስዩስ መኒሃ ከተቦ ሶህኑተ</para>
  <para style="toc2">ፍልጵስዩስ</para>
  <para style="toc3">ፍልጵ.</para>
  <para style="mt1">ጳዉሎስ ፍልጵስዩስ መኒሃ</para>
  <para style="mt2">ከተቦ ሶህኑተ</para>
  <para style="imt1">ኣጉስ</para>
  <para style="ip">ጳዉሎስ ከ ሶህኑተ ከተቦሁ መቄዶንያ ዬኖ ሮም መንግስት ገሽ ኣዜን ዮ ፍልጵስዩሳን ሄኣ መገን አመዕናኖ ዱእ ምኒሃት፤ ሁኩ ዱእ ምኑ ጳዉሎስ አውሮፕ ባዶን ዎዕናሃ ኡርሾእታን፤ ሶህኑስ ከተበንቶኢሁ ጳዉሎስ ኡሱር ምኔን ሄዕዮ ወክት ዎሎ አመዕናኖን ግበሙ ኢሌስ ወክትለከ ፍልጵስዩስ መገን አመዕናኖ ዱእ ምነ በላን ኬዕዮ ክዝብ ትምርት መሳን ቀልቡስ አበ ሻዦ ወክትዪት። እሁን ቤሉ ጳዉሎስ መሲህ ኢሳን ዮሲ አመዕነቱ አበ እኮቤቺሃ ከን ሶህኖን በትሽ ለለኖሁ ሙንዲኖተለከ ዊመ አመዕነቱ።</para>
  <para style="ip">ጳዉሎስ ከ ሶህኑተ ከተቦ ዎኔ መሰት ኦርሸስ ወክት ሽልማት ሶኮሲሃ እኮቤቺሃ ፍልጵስዩስ አመዕናኑተ ገለትጮታት፤ እስለከ እሰ አሌን አደዱ ኦርሸት ኢልቶሳሃ እኮጎሬ መለሉለከ ዊሙ አመዕነቱ ሄኦሰተ ከን ገንባቴን ጠረኝሰኖሰ። ቦኑ አጉርት መሲህ ኢስገ ገዉ ሆፍሳረ እኮተ አበ ቃግሰኖሰ፤ መሲህ ኢስ አያኒን ሜጡበ እሂን ደእቶ ሄኡ መገን ኣስቶች አሜቾኢሃለከ አመዕነቲን ደእቶእሃ ቤሉ ሕገ አገሪን ደገሞእሃበአ የን ቃግሰኖሰ፤ መሲህ ኢሲን ሜጡበ እክ ሄኣሀኑኡ ጉዕሚንከ መገኑ ኣሰኖሰ ወገሬትለከ ሙንዲኑተ ከተበኖሰ።</para>
  <para style="ip">ኩ ሶህኑት ደገንታኢሁ ሙንዲኑተ፥ አመዕነሙ፥ ሜጡበ እሁለከ አመዕነት ሄኢን ጠረኙ በትሽ ለሊሶንከሲት፤ በርግን አሳቤቹ ጳዉሎስ ፍልጵስዩስ መገን አመዕናኖ ዱእ ምኒሃ ዮስ አበ ኢተተ ለሊሰኖ።</para>
  <para style="iot">መጻፉስ አፎሃ</para>
  <para style="io1">ኣጉስ <char style="ior">(<ref loc="PHP 1:1-11">1፥1-11</ref>)</char></para>
  <para style="io1">ጳውሎሴሃ ሀለኘስ ሀለት <char style="ior">(<ref loc="PHP 1:12-26">1፥12-26</ref>)</char></para>
  <para style="io1">አመዕነት ሄእ ምሳልተ <char style="ior">(<ref loc="PHP 1:27-2:18">1፥27—2፥18</ref>)</char></para>
  <para style="io1">ጢሞትዎሴለከ ኤጳፍሮዲቱሲሃ ያደተ <char style="ior">(<ref loc="PHP 2:19-30">2፥19-30</ref>)</char></para>
  <para style="io1">አመዕነቱ ግባሀኑኡሃ ኩለሞሰ ጠረኘ ጠወ <char style="ior">(<ref loc="PHP 3:1-4:9">3፥1—4፥9</ref>)</char></para>
  <para style="io1">ጳዎሎስ ፍልጵስዩስ አመዕናኖተ ሆንጠህሾ ገለትለከ ሸዘነተ <char style="ior">(<ref loc="PHP 4:10-20">4፥10-20</ref>)</char></para>
  <para style="io1">መጨረሸስ <char style="ior">(<ref loc="PHP 4:21-23">4፥21-23</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="PHP 1"/>
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1"/>ኩ ሶህኑት መሲህ ኢስ ካዲመተ እኮ ጳዉሎሴችለከ ጥማቶሴች ሶሀንቶእተ ሶህኑ፤ ሶሃሞንኩ «ፍልጵስዩስ» ዬኖ ከተማን ሄኣ አመዕናኖ ጭምት አዎንሳኖሃ፥ ድያቆናከተለከ<note caller="+" style="f"><char style="fqa" closed="false">ድያቆነ ሆጉት፦ </char><char style="ft" closed="false">ምኒ አኑ ሬዮ ሜንቱ ካደሙሃን።</char></note> መሲህ ኢሳን አመዕንት ጠሊላኑተ እኮሀኑኡሃ ጉዕሚንካት።<note caller="-" style="x"><char style="xo" closed="false">1፥1 </char><char style="xt" closed="false"><ref loc="ACT 16:12">ሶቀ. 16፥12</ref>።</char></note><verse eid="PHP 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 1:2"/>አናኔ መገኒቺ ቀርቹሃኔ መሲህ ኢሲች ኣስቱትለከ ወገሬቱ ክዕኔሃ እሁን።<verse eid="PHP 1:2"/></para>
  <para style="s1">ጳዉሎሴ ገለት ዱአ</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3"/>አን ክዕኔተ ቃጋም ወክት ጉዕመንከ መገኑኤ ገለትጫሚት። <verse eid="PHP 1:3"/><verse number="4" style="v" sid="PHP 1:4"/>አን ክዕኔተኔሃ ዱአ አኣም ወክት ጉዕመንከ ሙንዲኖን ዱአ አኣሚት። <verse eid="PHP 1:4"/><verse number="5" style="v" sid="PHP 1:5"/>ወዕኔ በሬች ጀመር ከበሬ ኢለ ተሽት ላገተ ኢን ሜጡበ እኬን አቴንተቤቺሃ መገኑ ገለትጫም። <verse eid="PHP 1:5"/><verse number="6" style="v" sid="PHP 1:6"/>ከ ጡመ ሆጉተ ክዕኔን አኦተ ጀመሮ መገኑ መሲህ ኢስ አሜተኖ በር ሹሎተ ኢለ አገረኖገ አመዕናም። <verse eid="PHP 1:6"/><verse number="7" style="v" sid="PHP 1:7"/>ቴሱ ኡሱር ምኔን ዮም ወክትለከ ኡሱረምችኤ ብርተ እንጂል ሀንቂሃ ከዕመቀሞተለከ እሱንከ ጠረኝሲሃ አኣም ወክት መገኑ ኣስቶንከስ ኣሴኤ ዕድሊን ጉዕሙንኩክዕኔ ቤቀማኑተ እኬንተቤቺሃ አዕኑ ጉዕመ ወክት ቀልቤንከኤ ዮንተ። ህካን እኮቤቺሃ ክዕኔተኔሃ ሞጮጨመኖኤሁ ሀንቅሃን። <verse eid="PHP 1:7"/><verse number="8" style="v" sid="PHP 1:8"/>መሲህ ኢስ ኢታን ጉዕመንከክዕኔ ሄንከ ሱናሚት ጎሬ መገኑ ደገኖ።<verse eid="PHP 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 1:9"/>ኢተክዕኔ ኤንኬዕኑለከ ሀይመተ ሰውዩ ዊሞሀ እክ ነጰን መረኖገ ዱአ አኣም። <verse eid="PHP 1:9"/><verse number="10" style="v" sid="PHP 1:10"/>እስን ጡመ ጠወ አጥራመቴን ደጎኖተለከ መሲህ ፈንቀል አሜተኖ በር ነጣኑተለከ ሙልሲሰኖ ጠዉ ዮህዕኔበእረ እኬን ደገንቶኖታት። <verse eid="PHP 1:10"/><verse number="11" style="v" sid="PHP 1:11"/>ህትን መሲህ ኢሲን ደገመኖ ፈይመ ላልቺን ዊንቴን መገኒሃ ኬዕምኝለከ ገለት ደግሲሴነንታሃ እኬነንተ።<verse eid="PHP 1:11"/></para>
  <para style="s1">ጳውሎሴ ኡሱረሙ እንጂሉ አልባዕሎተ መሰተ እሁስ</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12"/>አመኤ ኦሶ! ኢ አሌን ኢሌ ጠዉ ጉዕሙንኩ እንጂሉ አበ አልባዕለኖገ አኡስ ደጎኖተ ሀሳም። <verse eid="PHP 1:12"/><verse number="13" style="v" sid="PHP 1:13"/>ህካን እኮቤቺሃ አን ኡሱረሞሚሁ መሲህተኔሃ እሁስ ሮም ዎም ምኒ ዘበኛኑትለከ ዎሉ ህከኔ ዮ መኑ ጉዕሙንኩ ደጋአ።<note caller="-" style="x"><char style="xo" closed="false">1፥13 </char><char style="xt" closed="false"><ref loc="ACT 28:30">ሶቀ. 28፥30</ref>።</char></note> <verse eid="PHP 1:13"/><verse number="14" style="v" sid="PHP 1:14"/>ቀርቾን አመዕንቶ አመኦሶች ልግቡሰ ኢ ኡሱረምተኔሃ ቀርቾን አመዕነንት መገን ላገተ ዎዕኔች በትስ ዋጅቱዕነ መለልት ዱዱብስታኢት።<verse eid="PHP 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15"/>እኮጎሬ መት-መቱ መኑ መሲህተኔሃ ዱዱብስታኢሁ አቄሻንትለከ ዎሉሰ ጢቄኒት፤ ጠዉ እኮጎሬ ዎሉስ መኑ መሲህተኔሃ ጡመ ቀልቢን ዱዱብስታኢት። <verse eid="PHP 1:15"/><verse number="16" style="v" sid="PHP 1:16"/>እሰ ተሽት ላገተ ፈየ ቀልቢን ዱዱብስታኢሁ ኢታች ኬዕዮሀኒንት፤ መሰንትስ አን ኡሱረሞሚሁ ተሽት ላገተ ሀንቂን ሰበኮተ አጰማምገ ደጋቤቺሃት። <verse eid="PHP 1:16"/><verse number="17" style="v" sid="PHP 1:17"/>ጠዉ እኮጎሬ አቄሻንለከ ጢቄን መሲህ ዱዱብስታኢሁ ሀንቂን እሁዕነ ገዉሰ ኢቲንለከ ኡሱረምኤ አሌን ዎልት ኦርሸተ በርግታኢሃ አጉጆሰቤቺሃት።<verse eid="PHP 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PHP 1:18"/>መሃ እኮጎሬ ሀካንስ እኮጎሬ ጉዕማንከ ዎቄን አመሰሊን እኮ ሀንቂን እኮ እቃ መሲህተኔሃ ዱዱብሰመኖቤቺሃ ሙንደኣም። <verse eid="PHP 1:18"/><verse number="19" style="v" sid="PHP 1:19"/>ከኒች ኤተሪሃ ሙንደኣም፤ መሰንትስ ክዕኔ ዱኢንለከ መሲህ ኢስ ጠሊለ አያኒ ሀዕለንሺን ዮኤ ኦርሻች ፉላምገ ደጎምቤቺሃት። <verse eid="PHP 1:19"/><verse number="20" style="v" sid="PHP 1:20"/>ህካን እኮቤቺሃ መ ጠዊኒ ሙላምበእገ ዊሙ ሃሽኣቱትለከ ተብሶሁ ዮኤ፤ ጠዉ እኮጎሬ ጉዕመ ወክት አኣምሀንገን ቴሁ ሄዕዮምጎሬ ህከረንገ ሬዮምጎሬ መሲህ ዊመ ጅስምኤ አሌን ሎረ እሀኖገ ዊሙ መለሉ ዮኤ። <verse eid="PHP 1:20"/><verse number="21" style="v" sid="PHP 1:21"/>ህካን እኮቤቺሃ ኢ ሄኡ መሲሂን ሄኡሃን፤ ሬሁተ እኮጎሬ ኤሳሃ ደግለለኖኤሃን። <verse eid="PHP 1:21"/><verse number="22" style="v" sid="PHP 1:22"/>ጠዉ እኮጎሬ ፎሊን ሄዕዮምጎሬ ላልቹ ዮስ ሆጉተ ቀርቺሃ አኦተ አታላም፤ እኮጎሬ ሬሆችለከ ሄኢች ሀካንስ መጠራም ጎር ደጎምበአ። <verse eid="PHP 1:22"/><verse number="23" style="v" sid="PHP 1:23"/>ከን ለሞ ጠዋን ቀልቡኤ ለሙ ቤቹ እኮኡ፤ እስን መቶ አዲን ከን ሄኢች አደ እክ መሲህን እሆተ ሀሳም፤ መሰንትስ ሁኩን ጉዕመርቺችን በተአኖሃ እኮቤቺሃት። <verse eid="PHP 1:23"/><verse number="24" style="v" sid="PHP 1:24"/>ጠዉ እኮጎሬ አን ሬሁዕነ ፎሊን ሄዕዮምጎሬ ክዕኔሃ በትሽ ጡመሃን። <verse eid="PHP 1:24"/><verse number="25" style="v" sid="PHP 1:25"/>አን ከ ጠወ አመዕንዮም፤ ሁኩንን ሙንዲኑክዕኔለከ አመዕነቱክዕኔ ነጰኖገ ሬሁዕነ ፎሊን ሄኣምገ ደጎም። <verse eid="PHP 1:25"/><verse number="26" style="v" sid="PHP 1:26"/>ህካን እኮቤቺሃ አን ክዕኔኤን ለንኪሃ ደቀሞምጎር ኢ መሳን መሲህ ኢሳን ዮህዕኔ ቦኑ አበ እሀኖ።<verse eid="PHP 1:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27"/>ጉዕሚችን በትሴን መሲህ እንጅሊሃ ሀስሰኖገ ሄዕዬ፤ አሜች ለዕዮንክዕኔጎሬ ህከረንገ ክዕኔች ቄዕር ክዕኔተኔሃ ሞጮጬምጎሬ መቶ ቀልቢን እንጂል አመዕነትተኔሃ ሜጡበ እኬን አጰንቴነንተገ ደጋም። <verse eid="PHP 1:27"/><verse number="28" style="v" sid="PHP 1:28"/>ክዕኔተ ግባህዕኔረ መ ጠዋኒ ዋጅቶኖቼ፤ ኩንን እሳሃ በእሰተ መላ፤ ጠዉ እኮጎሬ ክዕኔሃ ጡምተ መላ፤ ሁኩንን መገን አዲቺት። <verse eid="PHP 1:28"/><verse number="29" style="v" sid="PHP 1:29"/>መሰንትስ መሲህን አመዕንቶኖተ ጠለዕል እሁዕነ እስተኔሃ ኦርሸተ ቶጎኖተ ኩን ኣሰሞህዕኔ። <verse eid="PHP 1:29"/><verse number="30" style="v" sid="PHP 1:30"/>ህካን እኮቤቺሃ አዕኑ ከኒች ብርተ አጰንሸኤ ለኤንታአ፤ ቴሁ ኢ አጰንሸ ለኤነንታት፤ አዕኑሁ ህትናሙ አጰንሸ አጰንቴነንተ።<note caller="-" style="x"><char style="xo" closed="false">1፥30 </char><char style="xt" closed="false"><ref loc="ACT 16:19-40">ሶቀ. 16፥19-40</ref>።</char></note><verse eid="PHP 1:30"/></para>
  <chapter eid="PHP 1"/>
  <chapter number="2" style="c" sid="PHP 2"/>
  <para style="s1">መሲህ ገዉስ ሆፍሾገ</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1"/>መሲህን እኬንተቤቺሃ መት-መቱክዕኔ ሸዜነን ጠረኝቴንታአ፤ ህትን እስ ኢታን ጠረኝጨቀንቴነንተ፤ ህትን ጠሊለ አያኒን ሜጡ እኬንታአ፤ ህትን መት-መቲሃክዕኔ ጡምመትለከ ጎደበ ላፍመተ ለሊሴንታች፥ <verse eid="PHP 2:1"/><verse number="2" style="v" sid="PHP 2:2"/>ህካን ሰውቲን፥ ኢታንለከ ቀልብን ሙርስጭቴን ሜጡ እኬን ሙንዲሲሼኤ። <verse eid="PHP 2:2"/><verse number="3" style="v" sid="PHP 2:3"/>ገዉ ኢቲን ህከረንገ ቦኒን መቱርቹ አቶኖቼ፤ ጠዉ እኮጎሬ ዎሉ መኑ ክዕኔች ቆሀኖገ ገዉ ሆፍሲን ዎለዕዬ፤ <verse eid="PHP 2:3"/><verse number="4" style="v" sid="PHP 2:4"/>ህትን ገገዉክዕኔ ዎሎ መን መኩተ ሀሼ ቤሉ ገይክዕኔ መኩተ ጠለዕል ሀሶኖቼ። <verse eid="PHP 2:4"/><verse number="5" style="v" sid="PHP 2:5"/>ህትን ኩ መሲህ ኢሳን ዮ ሰውቱ ክዕኔ በላን ሄኡን።<verse eid="PHP 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PHP 2:6"/>እስ መገኑ እኮጎሬ</para>
  <para style="q2" vid="PHP 2:6">መገኒን ቅጡ አአኖ ሀል አፍ አገሮተ ሀሾበአ<verse eid="PHP 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PHP 2:7"/>ጠዉ እኮጎሬ ሮስ ደነ አፎ</para>
  <para style="q2" vid="PHP 2:7">መነ እኮ</para>
  <para style="q2" vid="PHP 2:7">ገውስ ኦነ አዕዮ።<verse eid="PHP 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PHP 2:8"/>ገዉስ ሆፍሽ</para>
  <para style="q2" vid="PHP 2:8">ሬሆተ ኢለ</para>
  <para style="q2" vid="PHP 2:8">መስቀል አሌን ሰቀለም ሬሆተ ኢለ</para>
  <para style="q2" vid="PHP 2:8">አዘዘሞ።<verse eid="PHP 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PHP 2:9"/>ህካን እኮቤቺሃ መገኑ ጉዕሚችን አሌ ዋሽ</para>
  <para style="q2" vid="PHP 2:9">ኬዕምኝ ቤቾን አዕዮስ፤</para>
  <para style="q2" vid="PHP 2:9">ጉዕመ ሱዕሚችን ሎረ ሱዕመ ኣሴስ።<verse eid="PHP 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10"/>ህካን እኮቤቺሃ ኢስ ሱዕም ኬዕምኝተኔሃ</para>
  <para style="q2" vid="PHP 2:10">ኡላን፥ ሰማንንለከ ኡለ ኣዜን ዮሩ ጉዕሙንኩ</para>
  <para style="q2" vid="PHP 2:10">ጉሉቤንከሰ ጉሉጵታአ።<verse eid="PHP 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PHP 2:11"/>ህትን አረቤንከሰን</para>
  <para style="q2" vid="PHP 2:11">«መሲህ ኢስ ቀርቹሃን» ይት መሰከርት</para>
  <para style="q2" vid="PHP 2:11">አነ መገኒሃ ኬዕምኝ ኣታአ።<note caller="-" style="x"><char style="xo" closed="false">2፥10-11 </char><char style="xt" closed="false"><ref loc="ISA 45:23">ኢሳ. 45፥23</ref>።</char></note><verse eid="PHP 2:11"/></para>
  <para style="s1">ዱንያ አል መኒሃ ኑሪ እህተኔሃ</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12"/>ህካን እኮቤቺሃ ኢ ጃላ! ጉዕመ ወክት አዘዘንቴንተኤገን ክዕኔቤቾን ሄዕዮም ወክት ጠለዕል እሁዕነ በትሽን ቴሱ ክዕኔች ቄዕሬም ወክትሃ ጡሙክዕኔ ለሊሳ ሆጉተ ዋጅንለከ ሁጢን አዕዬ። <verse eid="PHP 2:12"/><verse number="13" style="v" sid="PHP 2:13"/>መሰንትስ እስ ጡመ ስውት ሀሶኖተለከ አቶኖተ ክዕኔ ኣዜን አአኖሁ መገኑሃን።<verse eid="PHP 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 2:14"/>ጉዕመንከ ሆጉተ አቴነንተ ወክት ቁንቁቶኖቼ፤ ህትን ኦዶኖቼ። <verse eid="PHP 2:14"/><verse number="15" style="v" sid="PHP 2:15"/>ህካን እኮቤቺሃ አዕኑ ከን ሂለ ክልቀት በላን ሆፍኙለከ ህንቄኖህዕኔርቹ ዮህዕኔበኢሃ ነጣኑተ መገን ኦሱተ እኬን ዱንያ አል መኒሃ ኑር እኬን ለሊሴነንተ።<note caller="-" style="x"><char style="xo" closed="false">2፥15 </char><char style="xt" closed="false"><ref loc="DEU 32:5">ዘዳ. 32፥5</ref>።</char></note> <verse eid="PHP 2:15"/><verse number="16" style="v" sid="PHP 2:16"/>ኩን እሀኖንኩ ሄኡ ደገመኖ ላገተ ሙርቶኑዕናን ጠረኝሴን አፊኒት፤ ከን ሃሌን ደጉዱኤ እኮ ሆጉኤ ተሰ እክ ፈቃበእቤቺሃ መሲህ ፈንቀል አሜተኖ ወክት ድከኣም ሄአኖኤ ዩሃን።<verse eid="PHP 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 2:17"/>አዕኑ መገኒሃ አመዕነቲን ሆንጠህሴንተ ክትምለከ ክድመ አሌን አኒሁ ዱንተአኖ ክትምገ ሆንጠኮምጎሬ ክዕኔን ጉዕሚንከክዕኔ ሜጡበ ተሽ የኖኤ። <verse eid="PHP 2:17"/><verse number="18" style="v" sid="PHP 2:18"/>ህትን አዕኑሁ ኢንን ሜጡበ ሙንደኤነንተ።<verse eid="PHP 2:18"/></para>
  <para style="s1">ጢሞቴዎሴለከ ኤጳፍሮዲቱሴ ክድመተ</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19"/>ቀርቹ ኢስ ዬጎሬ ክዕኔተኔሃ ሞጮጭ ሙንደኦተ ጢሞትዎሴ ደዕል ክዕኔቤቹ ሶሆተ ተብሳሃ አኣም። <verse eid="PHP 2:19"/><verse number="20" style="v" sid="PHP 2:20"/>ክዕኔተኔሃ ጡመ ቀልቢን ሰውየን ሻዘኖሁ ጢሞትዎሴገ ዮኢሁ አዪሁ ዮበአ። <verse eid="PHP 2:20"/><verse number="21" style="v" sid="PHP 2:21"/>ዎሉ ጉዕሙንኩ ገይሰ ጠው ቤሉ መሲህ ኢስ ሆጎተ ሰውይቶበአ። <verse eid="PHP 2:21"/><verse number="22" style="v" sid="PHP 2:22"/>ጠዉ እኮጎሬ ጢሞትዎስ ቤቱ አነስ ካደመኖሀንገን ኢን ሜጡበ እክ እንጂለ ካደሚንከስለከ አመዕነንሸስ መሰከርሲሱስ አዕኑሁ ደጌነንተ። <verse eid="PHP 2:22"/><verse number="23" style="v" sid="PHP 2:23"/>ኢ ጠዉ መ ደረጀተ ኢለኖ ጎሬ ለዕዮሚች ኤተሮን ጢሞትዎሴ ደዕል ክዕኔቤቹ ሶሆተ ተብሳሃ አኣም። <verse eid="PHP 2:23"/><verse number="24" style="v" sid="PHP 2:24"/>ህትን አን ገዉንኩእ ደዕል ክዕኔቤቹ አሜቶተ አታላምገ ቀርቹ ሀዕለኖኤገ አመዕናም።<verse eid="PHP 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25"/>ህትን ኤሳሃ ሀሲሰኖኤርቺን ጉዕሚን ሀዕሎኤተ ሶኬንተ አመኤቤቱ ኤጳፍሮዲቱሴ ክዕኔቤቹ ሶሁ ሀሲሰኖሃ እክ ደጎም፤ እስ ኢን ሜጡበ ኡሬ ዎታደርቹለከ ሆጎኤ ጃለ እክ አአን ዱንክዮሃን። <verse eid="PHP 2:25"/><verse number="26" style="v" sid="PHP 2:26"/>እሱ ክዕኔቤቹ ሶሃሚሁ ጉዕመንከክዕኔ ለኦተ ሱኞገለከ እስ ጥዙስ ሞጮጭቴንተቤቺሃ አበ ጨነቀሞኡ። <verse eid="PHP 2:26"/><verse number="27" style="v" sid="PHP 2:27"/>ሀንቅንከ እስ አበ ጥዥ ሬሆተ ሆንጠኮ እቅ፤ ጠዉ እኮጎሬ መገኑ መረርሲጭ ፈይሾስ፤ ጠለዕል እስ እሁዕነ ኤሳሃ መረርሲጬቤቺሃ ሻዙተ ሻዞ አሌን በርገመኖኤበእገ አዕዮ። <verse eid="PHP 2:27"/><verse number="28" style="v" sid="PHP 2:28"/>ህካን እኮቤቺሃ አዕኑ እሱ ለንኪሃ ለኤን ሙንደኦኖተለከ ኢ ጨነቀሙ ቢሎተ አን እሱ ክዕኔቤቹ ደዕል ሶሆተ አበ ሀሾም። <verse eid="PHP 2:28"/><verse number="29" style="v" sid="PHP 2:29"/>ቴሱ ቀርች ሱዕሚን አመዕናንቹ እኮቤቺሃ አበ ሙንዲኖን ቶጌስ፤ ህትን እስገ ዮ መነ ጉዕመንከ ከበጅዬሰ። <verse eid="PHP 2:29"/><verse number="30" style="v" sid="PHP 2:30"/>መሰንትስ አዕኑ ግደኖን ሄኤን አቶኖኤተ አታልቴንበ ሀዕለንሸ እስ ደግለሎኤተ መሲህ ሆጎተ ነብሳስ ህግሽ ኣሲን ሬሆተ ኢለ አጰሞኡ።<verse eid="PHP 2:30"/></para>
  <chapter eid="PHP 2"/>
  <chapter number="3" style="c" sid="PHP 3"/>
  <para style="s1">ሀንቅ ፈይመተ</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1"/>አመኤ ኦሶ! ቀርቾን ሙንደዕዬ፤ አን ከኒች ብርተ ከተቦንክዕኔሃ ፈንቀሽ ከተቦንክዕኔ ጎሬሁ ህፈትሰኖኤበአ፤ ሁኩንን ክዕኔተ አደጊች ጉዕሚችን አገሮህዕኔተ አታለኖ።<verse eid="PHP 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 3:2"/>ዉሸገ<note caller="+" style="f"><char style="fqa" closed="false">ዉሸተ፦ </char><char style="ft" closed="false">የኖሁ አይሁድ መኑ መገኑ አመዕንበ መነ «ዉሸተ» ይታቤቺሃት፤ ጠዉ እኮጎሬ ከንቤቾን ጳውሎስ «ዉሸተ የን ጠወአኖሁ «ነኡን አመዕናኖተ» ይተን ሃዕሮ አመዕንቶ መነ «ጡርከሙ ሀሲሰኖህዕኔ» ይተን ግዳጅሳ አይሁድተኔሃት።</char></note> ንጃስሳሀኑኡችለከ ሂለ ጠወ አታሀኑኡች አገዕርዬ፤ ህትን ህለተ ሆጉተ አታሀኑኡችለከ ክዝብ ጡርከመሚች አገዕርዬ። <verse eid="PHP 3:2"/><verse number="3" style="v" sid="PHP 3:3"/>ነኡ መገን ጠሊለ አያኒን ሰገንዳምረለከ መሲህ ኢሲን ድከዕናምረ እንኮምቤቺሃ ሀንቂን ጡርከመሞምረ፤ ጠዉ እኮጎሬ እሰ ህትናመተበአ። <verse eid="PHP 3:3"/><verse number="4" style="v" sid="PHP 3:4"/>ህትን አን ማሊን እኮ እቃ ድከኣሚሁ ዮኤ፤ አዪሁ ማሊን ድከአኖሁ ዮሲሃ አጉጆስእቃ አን ድከኣም ልግቡ ዎቆ ዮኤ። <verse eid="PHP 3:4"/><verse number="5" style="v" sid="PHP 3:5"/>አን እለሞም ህዜትቅ በር ጡርከመሞምየ፤ ቢንያሜ ደቦች እኮም እስራኤላውቹሃን፤ ከኒች ኬዕዮሀኒን ነጠ እኮም ዕብራውቹሃን፤ አይሁድ ሕገ አገዕሪን እኮ እቃ ፈርሳውቹሃን።<note caller="-" style="x"><char style="xo" closed="false">3፥5 </char><char style="xt" closed="false"><ref loc="ACT 23:6">ሶቀ. 23፥6</ref>፤ <ref loc="ACT 26:5">26፥5</ref>፤ <ref loc="ROM 11:1">ሮሜ 11፥1</ref>።</char></note> <verse eid="PHP 3:5"/><verse number="6" style="v" sid="PHP 3:6"/>ሀይማኖትሃኤ ይ መሲህ ኢሳን አመዕንቶረ ሸራምሃ እቅ፤ ህትን ሙስ ሕገ አገዕሪን ፈይተኔሃ እኮ እቃ ኩሌኖኤርቹ ዮኤበአ። <verse eid="PHP 3:6"/><verse number="7" style="v" sid="PHP 3:7"/>ጠዉ እኮጎሬ ከኒች ብርተ ኤሳሃ ደግለለኖኤ ዬሚሃ ጉዕመንከ መሲህተኔሃ ይ ተሰ ጠውገ አዕይ ዎለኣንሰ። <verse eid="PHP 3:7"/><verse number="8" style="v" sid="PHP 3:8"/>ጠለዕል ህካን እሁዕነ ቀርቹኤ መሲህ ኢሰ ደጉ ዎሎርቺች ጉዕሚችን በተአኖሃ እኮቤቺሃ ሁኩን ጉዕሙንኩ ክሳርገ ዎለኣንስ፤ እስተኔሃ ጉዕመርቹንከ አጉሮም፤ መሲሁ ደኦተ ጉዕመርቹንከ ቶሬመ ሁርገ ዎለኣም። <verse eid="PHP 3:8"/><verse number="9" style="v" sid="PHP 3:9"/>አን ሕገ አገሪን ደኣም ገይኤሃ እኮ ፈዩት ዮኤበአ፤ መሲህ አመዕኒንለከ እሲን ሜጡበ እሂን ደገንታ ፈዩት መገን ቤቺች አሜታ ፈዩት ቴሱ ዮኤ። <verse eid="PHP 3:9"/><verse number="10" style="v" sid="PHP 3:10"/>አን መሲህ ደጎተለከ ሬሆች ኬእስ ዎልቀተ ደጎተ ሀሳም፤ አን እስ ኦርሸተ ቤቀሞተለከ ሬሆንከስ እሱ አጉዶተ ሄዕላታም። <verse eid="PHP 3:10"/><verse number="11" style="v" sid="PHP 3:11"/>ህትን ሬሆች ኬኣምገ ተብሳሃ አኣም።<verse eid="PHP 3:11"/></para>
  <para style="s1">ኢሉ ሀስሰኖቤቹ ኢሊሃ ደጉዱ</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12"/>ህካን ጉዕመንከ ደእዮምበአ፤ ህከረንገ መገኑ ሀሰኖ ሃሊን ሆሮ አን ዊማበአ፤ ጠዉ እኮጎሬ መሲህ ኢስ ኤሳሃ ገይሲሃ አዕዮኤቤቺሃ ሽልማት ደኦተ ብርተ ዋሽ ደጉዱ አጉራምበአ። <verse eid="PHP 3:12"/><verse number="13" style="v" sid="PHP 3:13"/>አመኤ ኦሶ! አን ህካን ገይኤሃ አዕዮምሀንገ ዎለኣምበአ፤ ጠዉ እኮጎሬ መቱ ጠወ አኣም፤ ሁኩንን ኤተርንከኤ ዮኢሃ ሀበን ብሬንከኤ ዮኢሃ አፎተ ደጉዳም። <verse eid="PHP 3:13"/><verse number="14" style="v" sid="PHP 3:14"/>መገኑ መሲህ ኢስ አዲን ገኤኤሁ ሰሜች ደኣም ዋገ ዘማን ጉዕሚንከ ሄኡ ደኦተ ኢሉ ሀስሰኖኤቤቹ ኢሎተ ደጉዳም።<verse eid="PHP 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 3:15"/>ቴሱ አመዕነቲን ጠረኝኖምሩ ጉዕሙንኩ ካን አጉደኖ ሰውቱ ሄኦኔተ ሀስሰኖ፤ አዕኑ አደ እኮ ሃሊን ሰውይቴንተ ጎሬ መገኑ በራሃ አዕይ ለሊሰኖህዕኔ። <verse eid="PHP 3:15"/><verse number="16" style="v" sid="PHP 3:16"/>ህካን እኮቤቺሃ ቴሱ ኢለ ደዕኖም ሀንቅ ጠረኝንስ አንፎ።<verse eid="PHP 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17"/>አመኤ ኦሶ! ኤሳሃ አጉዴነንተረ እኬ፤ ነኡ ዎልሀስ ምሳልተ እንኮምገን ህካን አጉደን ሄኣረ አጥራመቴን ለዕዬ።<note caller="-" style="x"><char style="xo" closed="false">3፥17 </char><char style="xt" closed="false"><ref loc="1CO 4:16">1 ቆሮ. 4፥16</ref>፤ <ref loc="1CO 11:1">11፥1</ref>።</char></note> <verse eid="PHP 3:17"/><verse number="18" style="v" sid="PHP 3:18"/>መሰንትስ ከኒች ብርተ ልግብ ወክት ኩሎምገን ቴሁ ኦአን ኩላንክዕኔ፤ ልግቡ መኑ ሄእንከስ መሲህ መስቀሊሃ ዲነ እክ ሄኣገ አአኖሰ። <verse eid="PHP 3:18"/><verse number="19" style="v" sid="PHP 3:19"/>እሳሃ ጎደቡሰ መገኑዋሰ፤ ሙልሲሰኖርቹ እሳሃ ኬዕምኝየሰ፤ ሰውቱሰ ዱንየ አልየ ጠወ፤ እሰ ኤተሩሰ በኡሃ። <verse eid="PHP 3:19"/><verse number="20" style="v" sid="PHP 3:20"/>ጠዉ እኮጎሬ ኒ ባዱ ሰማሃን፤ ህከንቤቺች አሜተኖ ጡምሳንቹ ቀርቹኔ መሲህ ኢሰ አገርናሚት። <verse eid="PHP 3:20"/><verse number="21" style="v" sid="PHP 3:21"/>እስ ኒ ህከ ህንቀሞ ጅስመኔ ዶር እስ ኬዕምኝ ጅስመ አጉደኖገ አአኖ፤ ህካን አአኖሁ ጉዕሙንኩስ ገይሃስ ጠገመኖገ አአኖ ዎልቃንተሲት።<verse eid="PHP 3:21"/></para>
  <chapter eid="PHP 3"/>
  <chapter number="4" style="c" sid="PHP 4"/>
  <para style="s1">መጨረሽ ሸዘነ ላገተ</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1"/>አመኤ ኦሶ! ኢታንክዕኔሁለከ ሱናንክዕኔሩ ሙንዲኑኤ እኬንተሩ ሆጎተኤ አክሊለ እኬንተሩ ቴሱ ቀርቾን ጠረኝቴን ኡርዬ። <verse eid="PHP 4:1"/><verse number="2" style="v" sid="PHP 4:2"/>ኤዎድያለከ ሲንጢኪ ቀርቺን ሜጡ እኬን ሄኦኖተ ኡጫንክዕኔ። <verse eid="PHP 4:2"/><verse number="3" style="v" sid="PHP 4:3"/>አት አመዕነንቶንት ሆጎኤ ጃለ! ከ ሜንቱ ሀዕልቶተ ኡጫንኬ፤ መሰንትስ ኩ ሜንቱ ቀሌምንጦሴንለከ ሱዕሙሰ ሄእ መጻፋን ከተበሞ ሆጎ ጃላን ሜጡበ እንጂል ላገተ ኢልሶተ ደግለልቶኤረ።<verse eid="PHP 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4"/>ጉዕመንከ ወክት ቀርቾን ተሽ ዩንክዕኔ፤ ቴሁ ያንክዕኔ ተሽ ዩንክዕኔ።<verse eid="PHP 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 4:5"/>ጡምመክዕኔ ጉዕመንከ መንቤቾን ለልቶኢተ እኩን፤ ቀርቹንኩ አሜቶተ ሆንጠኮኡ። <verse eid="PHP 4:5"/><verse number="6" style="v" sid="PHP 4:6"/>ሀስሰኖህዕኔርቺሃ ጉዕሚንከ ሹኩሩ ዊሞ ዱኢን መገኑ ኡጭዬ ቤሉ መቶርቾን ሻዞኖቼ። <verse eid="PHP 4:6"/><verse number="7" style="v" sid="PHP 4:7"/>መን ኤንኬዕኒች ጉዕሚች ሎረ እኮ መገን ወገሬቱ መሲህ ኢሳን ዮንተቤቺሃ ቀልብክዕኔለከ ሰውትክዕኔ አገረኖህዕኔ።<verse eid="PHP 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8"/>መጨረሻንን አመኤ ኦሶ! ቀልቡክዕኔ ከኒች ጉዕሚችን በተአኖሃለከ ገለትጭሲሰኖ ጡመ ጠዊን ዊንቴንታረ እኬ፤ ሀንቅ እኮ ጠወ ጉዕመንከ፥ ኬዕምኙ ዮ ጠወ ጉዕመንከ፥ ሀቂቀተ እኮ ጠወ ጉዕመንከ፥ ነጠ እኮ ጠወ ጉዕመንከ፥ ኢቴኖ ጠውተኔሃ ጉዕሚንከለከ ሙንዲሲሰኖ ጠውተኔሃ ሰውይዬ፤ <verse eid="PHP 4:8"/><verse number="9" style="v" sid="PHP 4:9"/>ኢች ተማርቴንታሃለከ ቶጌንታሃ፥ ሞጮጭቴንታሃለከ ለኤንታሃ ጉዕመንከ አዕዬ፤ ወገሬት መገኑንኩ ክዕኔን ሜጡበ እሀኖ።<verse eid="PHP 4:9"/></para>
  <para style="s1">ጳዉሎስ ሶሄመስ ሽልማትተኔሃ ገለትጬገ</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10"/>ጠዉ እኮጎሬ ልግብ ወክቲች ኤተሮን ኦርሸኤተኔሃ ሰውዩ ጀመርቴንተቤቺሃ ቀርቾን አበ ሙንደኣም፤ ወክት ደእቴንታበአ ቤሉ ኢተኔሃ ሰውዩ አጉርቴንታበአ። <verse eid="PHP 4:10"/><verse number="11" style="v" sid="PHP 4:11"/>ህት ያም ወክት ሆፈዕዮኤርቺሃ ሻዥበአ፤ መሰንትስ «ዮኤ ጌሱ ኤሳሃ እሀኖኤ» ዩ ተማሮምቤቺሃ ዮኤሀኒን ሙንደኣምሃን። <verse eid="PHP 4:11"/><verse number="12" style="v" sid="PHP 4:12"/>ህካን እኮቤቺሃ ደኡለከ ደኡ ሆጉ ደጋም፤ ጉዕመንከ ጠዋን ጉዕመ ወክት ዱቢን እኮ ጎሪን ደእን እኮ ደኡ ሆግን «ዮኤሁ እሀኖኤ» ዩ ሮሾም። <verse eid="PHP 4:12"/><verse number="13" style="v" sid="PHP 4:13"/>ዎልቀተ ኣሰኖኤ መሲሂን ጉዕመንከ አኦተ አታላም።<verse eid="PHP 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14"/>እኮጎሬ አዕኑ ኦርሸኤ ቤቀማኑተ እኬን ጡመ ጠወ አቴንታኤ። <verse eid="PHP 4:14"/><verse number="15" style="v" sid="PHP 4:15"/>ፍልጵሱሳን ዮንተ መኑ! ወኔችን ኬሽ እንጂል ላገተ ተማርሰን መቄዶን ባዲች ፉሎም ወክት ክዕኔ ቤሉ ዎሉ አመዕናኑት ኣሲንለከ ቶጊን ኤሳሃ ሀዕሉ ሆጉሰ አዕኑ ገዉክዕኔ ደጌነንተ።<note caller="-" style="x"><char style="xo" closed="false">4፥15-16 </char><char style="xt" closed="false"><ref loc="2CO 11:9">2 ቆሮ. 11፥9</ref>።</char></note> <verse eid="PHP 4:15"/><verse number="16" style="v" sid="PHP 4:16"/>ህትን ተሰሎንቄ ከተማን ሄዕዮም ወክት ሀስሰኖኤርቹ ሶኬን ልግብ ወክት ሀዕልቴንታኤ።<note caller="-" style="x"><char style="xo" closed="false">4፥16 </char><char style="xt" closed="false"><ref loc="ACT 17:1">ሶቀ. 17፥1</ref>።</char></note> <verse eid="PHP 4:16"/><verse number="17" style="v" sid="PHP 4:17"/>አን ለኡ ሀሳሚሁ ከኒች ብርተ አቴንተሀኒች አበ ጡመ ሆጉት በርገንቶታት። <verse eid="PHP 4:17"/><verse number="18" style="v" sid="PHP 4:18"/>ኤሳሃ ሀስሰኖለከ ሀስሰኖሀኒች በትሽ እኮ ሽልማትክዕኔ ኤጳፍሮድቱ አንጋች ቶጎም፤ ሁኩ ክዕኔ ሽልማቱ ጡመ አንጀነተ ዊሞ ክትምገ መገኑ ሙንዲሲሰኖሃለከ መገኑ ቶገኖሃን።<note caller="-" style="x"><char style="xo" closed="false">4፥18 </char><char style="xt" closed="false"><ref loc="EXO 29:18">ፉል. 29፥18</ref>።</char></note> <verse eid="PHP 4:18"/><verse number="19" style="v" sid="PHP 4:19"/>ህካን እኮቤቺሃ ኢ መገኑ ዳንጉ ዮበእ ቀባጦችስ መሲህ ኢስ አዲን ሀስሰኖህዕኔ ጠወ ጉዕመንከ በትሽ ኣሶህዕኔ። <verse eid="PHP 4:19"/><verse number="20" style="v" sid="PHP 4:20"/>አናኔ መገኒሃ ዘላለሚሃ ኬዕምኙ እሁንስ፤ ኣሚዕን።<verse eid="PHP 4:20"/></para>
  <para style="s1">መጨረሽ ወገሬት</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21"/>መሲህ ኢሳን አመዕንቶ መኒሃ ጉዕሚንከ ወገሬት ኢልሼ፤ ኢን ሜጡበ ዮ አመኤ ኦሱት «ወገሬቴ» ይታህዕኔት። <verse eid="PHP 4:21"/><verse number="22" style="v" sid="PHP 4:22"/>ዎሉ አመዕናኑት ጉዕሙንኩ አደንከ ሮም ዎም ምኔን ካደንታ አመዕናኑንት «ወገሬቴ» ይታህዕኔት።<verse eid="PHP 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23"/>ቀርቾ መሲህ ኢስ ኣስቱት ጉዕሚንከክዕኔ ሜጡበ እኩን፤ ኣሚዕን።<verse eid="PHP 4:23"/></para>
  <chapter eid="PHP 4"/>
</usx>
