<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JUD" style="id">- HALABA NEW TESTAMENT</book>
  <para style="h">ይሁደ</para>
  <para style="toc1">ይሁድ ከተቦ ሶህኑተ</para>
  <para style="toc2">ይሁድ ከተቦ ሶህኑተ</para>
  <para style="toc3">ይሁደ</para>
  <para style="mt">ይሁድ ከተቦ ሶህኑተ</para>
  <para style="imt1">ኣጉስ</para>
  <para style="ip">ይሁድ ሶህኑት ከተበንቶኢሁ አመዕናኑተ እኩዕነ አመዕናኑተ አጉድ ክዝብ ትምርት ተማርስታ መኒች አመዕናኑት ገዉሰ አገዕርቶተ ቃግሲሃት። ኣዜስ ሀንቀፎ ጠዊን ለንክ ጴጥሮሴ ሶህኑተ አጉደኖ ከን ገበንቾ ሶህኖን ከተቦሲሁ «ለንኪሃ በርገምበ ሃሌን መገኑ ኡመቲሃስ ሜጡ ወክት ኣሴ አመዕነቲሃ ጠረኝት አጰንቶተ» አነበባሀዕኑኡተ ጠረኝሽ ኩለኖ።</para>
  <para style="iot">መጻፉስ አፎሃ</para>
  <para style="io1">ኣጉስ <char style="ior">(<ref loc="JUD 1:1-2">1-2</ref>)</char></para>
  <para style="io1">ክዝብ አስተማረ ትምርት ሃልለከ ኡቡስ <char style="ior">(<ref loc="JUD 1:3-16">3-16</ref>)</char></para>
  <para style="io1">አመዕነቱ አገርቶተ ኣሰንቶሰ ሸዘነተ <char style="ior">(<ref loc="JUD 1:17-23">17-23</ref>)</char></para>
  <para style="io1">ማሰተ <char style="ior">(<ref loc="JUD 1:24-25">24-25</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="JUD 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1"/>መሲህ ኢስ ካዲንቹለከ ያቁብ አመቤቱ እኮ ይሁዲች ገአንቴንተሀኑኡተ አኑ መገኑ ኢተኖህዕኔሀኑኡተለከ መሲህ ኢሲን አገረንቴንተሀኑኡተ ጉዕሚንከክዕኔ፥<note caller="-" style="x"><char style="xo" closed="false">1 </char><char style="xt" closed="false"><ref loc="MAT 13:55">ማቶ. 13፥55</ref>፤ <ref loc="MRK 6:3">ማር. 6፥3</ref>።</char></note><verse eid="JUD 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JUD 1:2"/>ማርቱት ወገሬቱለከ ኢተቀሙ በተኦህዕኔ።<verse eid="JUD 1:2"/></para>
  <para style="s1">ክዝብ አስተማረተ</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3"/>ኢ ጃላ! ጉዕሙንኩኔ ሜጡበ ጡምኔተኔሃ ከተቦህዕኔተ አበ ሀሾም እቅ፤ እኮጎሬ ቴሱ በርገምበ ሃሊን መገኑ ኡመቲሀስ ሜጥቾረን ኣሴ አመዕነቲሃ ጠረኝቴን አጰንቶኖተ ሸዞህዕኔተ ከተቡ ግደ እኮኤ። <verse eid="JUD 1:3"/><verse number="4" style="v" sid="JUD 1:4"/>ፈረደመኖሳሃ እሁስ ልግብየ ወክቲች ብርተ ከተበሞሰ መት-መቱ መናከት ክዕኔ በለ ሉኩት ኣጎኡ፤ እሰን መገን ኣስቱተ አለ ቅልቢን ዶርት መገኒሃ ጠገንቱዕናን ሄኣእረ፤ እስ ሜጡስ ገሻንቹኔለከ ቀርቹኔ እኮ መሲህ ኢሰ ለገኣአ።<verse eid="JUD 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5"/>ካን ጉዕመንከ ሄጭቴን ሜጦረ ደጌነንታሃ እኮ እቃ ቀርቹ ኡመትስ ግብጽ ባዲች ፉሽ ጡምሾገለከ አመዕንትበረ ኤተሮን ቤሾገ ቃግሶህዕኔተ ሀሳም።<note caller="-" style="x"><char style="xo" closed="false">5 </char><char style="xt" closed="false"><ref loc="EXO 12:51">ፉል. 12፥51</ref>፤ <ref loc="NUM 14:29-30">ዘኁ. 14፥29-30</ref>።</char></note> <verse eid="JUD 1:5"/><verse number="6" style="v" sid="JUD 1:6"/>ህትን ኣሰሞሰ ሹምነት ኣዜን እሁ ሆግ ቤቹሰ አጉርቶ መላይከተ ቃጌ፤ እሰተ ሎሩ ፍርድ በሩ ኢሎተ ኢለ ዘላለሚሃ ኡሱሮንለከ ጭልመ ቱንስች ኣዜን መገኑ አገርት ዱንክታገ አዕዮሰ። <verse eid="JUD 1:6"/><verse number="7" style="v" sid="JUD 1:7"/>ከን ሃሌን ሶዶሙለከ ጎሞሩ አዝጋጌንተስ ዮ ከተመት ዝነተ አታእረ እኮኡ፤ ክልቀት ሴሪች አደ እኮ ሃሊን ዝነተ አቶኡ<note caller="+" style="f"><char style="fqa" closed="false">ክልቀት ሴሪች አደ እኮ ሃሊን ዝነተ አቶኡ፦ </char><char style="ft" closed="false">የኖሁ ግርክ አፎን «ዎሎ ጅስሚን ዝነተ አቶኡ» የኖ።</char></note> ህካን እኮቤቺሃ እሰ ዘላለሚሃ ጠእትበ ጊራን ቀጠአንታሀኑኡተ ምሳልተ እኮኡ።<note caller="-" style="x"><char style="xo" closed="false">7 </char><char style="xt" closed="false"><ref loc="GEN 19:1-24">ክል. 19፥1-24</ref>።</char></note><verse eid="JUD 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8"/>ህትን ኩ መኑ ሀቄሰ አዎንተን ጅስመሰ ንጃስሳአ፤ ሹማንተ አዘዘንታበአ፤ ሰማን ኬዕምኙ ዮሰረ ቦሮርታአ። <verse eid="JUD 1:8"/><verse number="9" style="v" sid="JUD 1:9"/>መላይከ ሀለቁ ምካኤል ሙስ ጀናዘተኔሃ እብልሲን ኦጆ ወክት «ቀርቹ ሻቆሄ» ዬስ ቤሉ ሆሮን ቦሮር ላገተ ጠወዕዮበአ።<note caller="-" style="x"><char style="xo" closed="false">9 </char><char style="xt" closed="false"><ref loc="DAN 10:13">ዳን. 10፥13</ref>፡<ref loc="DAN 10:21">21</ref>፤ <ref loc="DAN 12:1">12፥1</ref>፤ <ref loc="REV 12:7">መና. 12፥7</ref>፤ <ref loc="DEU 34:6">ዘዳ. 34፥6</ref>፤ <ref loc="ZEC 3:2">ዘካ. 3፥2</ref>።</char></note> <verse eid="JUD 1:9"/><verse number="10" style="v" sid="JUD 1:10"/>ጠዉ እኮጎሬ ኩ መኑ አጥራመቲሃ አታልትበርቹ ጉዕመንከ ቦሮዕረንታአ፤ ቀልቡ ዮበእ ግዝገ ከለቀንሽሰ ሃልጊን ደጋ ጠዉ ሄዕዮሰጎሬሁ ህከን ጠዊንን በኣአ። <verse eid="JUD 1:10"/><verse number="11" style="v" sid="JUD 1:11"/>ቃኤሌ ዎቃሃ አዎንቶቤቺሃ፥ ዱንያተኔሃ ይት ባለኣሜ ሉጨንሺን ኡቦቤቺሃ፥ «ቆሬ» ዬኖ መንቹ መገኑ ግቦሀንገን መገኑ ግብ በኦቤቺሃ እሳሃ ቆሀኖሰ!<note caller="-" style="x"><char style="xo" closed="false">11 </char><char style="xt" closed="false"><ref loc="GEN 4:3-8">ክል. 4፥3-8</ref>፤ <ref loc="NUM 22:1-35">ዘኁ. 22፥1-35</ref>፤ <ref loc="NUM 16:1-35">16፥1-35</ref>።</char></note> <verse eid="JUD 1:11"/><verse number="12" style="v" sid="JUD 1:12"/>ኩ መኑ ማልት ዮበኢሃ ሹርተን ድግስ አሌን ሜጡበ ደገንታ ወክት ጉፊቹ እካህዕኔ፤ እሰ ሰውይታኢሁ ጠለዕል ገይሰተኔሃት፤ ቦብሪን ሀምበለመኖለከ ጤኑ ዮበእ ጎመጋት፤ አቶት አገናን አቶቱ ሄእበስሀንገለከ ጠጲን ቡቱከም ሞሎ ሀቅጋት። <verse eid="JUD 1:12"/><verse number="13" style="v" sid="JUD 1:13"/>እሰ አሙዕሬ ባር ሁልገ ሙልሲሳ ሆጎሰ ሁምብ ኩፍ አታእረ፤ ጭልመተ እኮ ቱንስቹ ዘላለሚሃ አገረኖሰገለከ ጀል ጀል ይታ ቤዜገ ዮእረ።<verse eid="JUD 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14"/>ኣደሚች ኬሽ ለመልቅ እለንሸ እኮ ሄኖክ «ሁኩዕኑን! ቀርቹ ልግቤ ኩሜ ጠሊላኖ መላይካን ሜጡበ እክ ጉዕም አሌንን ፈረዶተ አሜተኖ።<note caller="-" style="x"><char style="xo" closed="false">14 </char><char style="xt" closed="false"><ref loc="GEN 5:18">ክል. 5፥18</ref>፤ 21-24።</char></note> <verse eid="JUD 1:14"/><verse number="15" style="v" sid="JUD 1:15"/>ህከ ቀርቺሃ ጠገንትቡ መነ አቶ ሂለ ሆጎሰ መሳን ቀጠአኖሰ፤ ቀርቹ ሀንቅንከ ከን እሲሃ ጠገንትቡ ጩበኛኑት እስ አሌን ጠወኦ ሂለ ጠዊሃ ጉዕሚንከ ፈረደኖሰ» ይ ራገ ጠወዕዮኡ።<verse eid="JUD 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JUD 1:16"/>ሁኩ መናከት ጉዕመ ወክት ቁንቁታእረለከ መ ጠዋን ሙንደእበረ፤ ገይሰ ሂለ ሄዕላቸተ አዎንታእረ፤ አፎሰ ቦን ላጋን ዊሞእሃ፤ ገይሀሰ ደግለሸቀንቶተ ሀሰን መነ ቡልጥጭታአ።<verse eid="JUD 1:16"/></para>
  <para style="s1">ጠረኘ ሸዘነተኔሃ</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17"/>ጠዉ እኮጎሬ ኢ ጃለኤ! አዕኑ ቀርቹሃኔ መሲህ ኢስ አሳበት ከኒች ብርተ ጠወኦ ላገተ ቃጌ። <verse eid="JUD 1:17"/><verse number="18" style="v" sid="JUD 1:18"/>እሰ «ኤተር ዘማኔን መገን ሰውቲች ቄዕርቶ ገይሰ ሂለ ሄዕላቸተ አዎንተን ቀለዳ መኑ አሜታአ» ይቶህዕኔ እቅ።<note caller="-" style="x"><char style="xo" closed="false">18 </char><char style="xt" closed="false"><ref loc="2PE 3:3">2 ጴጥ. 3፥3</ref>።</char></note> <verse eid="JUD 1:18"/><verse number="19" style="v" sid="JUD 1:19"/>እሰን መነ አደ አታእረ፥ ማል ሄዕላቸተ አዎንታእረለከ ጠሊሉ አያኑ ዮሰበእራን። <verse eid="JUD 1:19"/><verse number="20" style="v" sid="JUD 1:20"/>ጠዉ እኮጎሬ ኢ ኢተኤ! አዕኑ ጉዕሚችን በተአኖ ጠሊሎ አመዕነቶንከክዕኔ ገዉክዕኔ ጠረኝሶኖተ አጰሜ፤ ጠሊለ አያን ወልቃን ዱአ አዕዬ። <verse eid="JUD 1:20"/><verse number="21" style="v" sid="JUD 1:21"/>ቀርቹኔ መሲህ ኢስን ማርቶንከስ ዘላለሚሃ ሄኡ ኢልሶህዕኔተ አገዕረቀንቴነን ገጉክዕኔ መገን ኢተ ኣዜን አገዕርዬ።<verse eid="JUD 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22"/>መት-መቶ ሸክታ መኒሃ መረርሲጭዬሰ፤ <verse eid="JUD 1:22"/><verse number="23" style="v" sid="JUD 1:23"/>መት-መቱ መነ ጊራች ፉሽቴን ጡምሼሰ፤ ዎሊሀሰ ዋጂን መረርሲጭዬሰ፤ እኮጎሬ ጩቢን ንጃሾ ጅስመሰ ኡልቶ ኦድኑተ ሆሮ ፈቁዕነ ግቤ።<verse eid="JUD 1:23"/></para>
  <para style="s1">ገለት ዱአ</para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24"/>ኡቤነንተበእገ አገሮህዕኔተለከ ሙልሰኖርቹ ዮበእረ አዕይ ሙንዲኖን ኬዕምኝስ ብሬን ሆንጠህሶህዕኔተ አታለኖሀኒሃ፥ <verse eid="JUD 1:24"/><verse number="25" style="v" sid="JUD 1:25"/>ጠለዕል እስ ዘቡኔ እኮ መገኒሃ ቀርቹሃኔ መሲህ ኢስ አዲን ዎዕኔችን ጀመር ቴሁ ዘላለሚሃ ኬዕምኙ፥ ሎርመት፥ ዎልቀትለከ ዳኞመት እሲሃ እኩንስ! ኣሚዕን!<verse eid="JUD 1:25"/></para>
  <chapter eid="JUD 1"/>
</usx>
