<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1PE" style="id">- HALABA NEW TESTAMENT</book>
  <para style="h">ዎኔ ጴጥሮሴ</para>
  <para style="toc1">ጴጥሮስ ከተቦ ዎኔ ሶህኑተ</para>
  <para style="toc2">ዎኔ ጴጥሮሴ</para>
  <para style="toc3">1 ጴጥ.</para>
  <para style="mt1">ጴጥሮስ ከተቦሃ</para>
  <para style="mt2">ዎኔ ሶህኑተ</para>
  <para style="imt1">ኣጉስ</para>
  <para style="ip">ዎኔ ሶቀማንቾ ጴጥሮሴ ሶህኑት ከተበንቶኢሁ ሶህኖስ ኣዜን «መገኑ መጠሮ ኡመቲሃ» የመም ገአመኖለከ ቀዎ እስይ ቅልብ አዲን ብንይቶ አመዕናኖታት፤ ሶህኖስ ቡዕለ እኮ ጠዉ አመዕነትሰ መሳን ሸረሙለከ ኦርሸት ኢልቶሰ አመዕናኑተ ጠረኝሲሃት፤ ከተቦሲሁ ህካን አዕዮሁ ሬሁስ፥ ሬሆች ኬኡስለከ ፈንቀል አሜትስ ተብሳሃ ኩለኖ፤ መሲህ ኢስ ተሽት ላገተ አነበባሀኑኡተ ቃግሲሃት፤ መሲህ ኢስ ሄዕዮ ሃል ምሳልተ አዕይ ኦሪሸተ አታዕሊን ቶጉ ሀስሰኖገ ቃግሰኖ፤ ህከኒንን በርግ ኦሪሸት አመዕነትሰ ጠረኝመተ ፌተንታኢሃ እሁስ «መሲህ ኢስ ለለኖ በር» ሀስሰኖ ወጥሰ ደእታኢሃ እሁስ ቃግሰኖሰ፤</para>
  <para style="ip">ከተቦሲሁ ኦሪሻን አታዕልቶተ ጠረኝሰኖሀኒች በትሽ አነበባእሩ መሲህ አዎንታስሩ ሄኡ ሀስሰኖሰ ሃሊን ሄኦተ ቃግሰኖሰ።</para>
  <para style="iot">መጻፉስ አፎሃ</para>
  <para style="io1">ኣጉስ <char style="ior">(<ref loc="1PE 1:1-2">1፥1-2</ref>)</char></para>
  <para style="io1">መገኑ ጡምሳንቹ እሁስ ቃግሰኖ ጠወ <char style="ior">(<ref loc="1PE 1:3-12">1፥3-12</ref>)</char></para>
  <para style="io1">ጠሊለ ሄኡ ሄኦኖተ ኣሰንቶ ሸዘነተ <char style="ior">(<ref loc="1PE 1:13-2:10">1፥13—2፥10</ref>)</char></para>
  <para style="io1">ኦርሸ ወክት አመዕናኑት አኡ ሀስሰኖሰ ጠወ <char style="ior">(<ref loc="1PE 2:11-4:19">2፥11—4፥19</ref>)</char></para>
  <para style="io1">አመዕናኖ ገዉ ሆፍሱለከ ክድመተ <char style="ior">(<ref loc="1PE 5:1-11">5፥1-11</ref>)</char></para>
  <para style="io1">መጨረሸስ <char style="ior">(<ref loc="1PE 5:12-14">5፥12-14</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="1PE 1"/>
  <para style="p">
    <verse number="1-2" style="v" sid="1PE 1:1-2"/>መሲህ ኢስ አሳቤቹ እኮም ጴጥሮሴች አኑ መገኑ ሄጭ ደግንከስ መጠሮህዕኔሀኑኡተ፥ መሲህ ኢሲሃ አዘዘንቶኖተለከ ቄጊንከስ ሄበ መራጨ አኤናን ነጠ እኮኖተ ጠሊለ አያኒን አደ እኬንተሀኑኡሃ ጳንጦስያን፥ ገላትያን፥ ቀጳዶቅያን፥ እስይ ባዶንለከ ቢታን ባዶን ኮሀ እኬን ብንይቴን ሄኤነንተሀኑኡተ ጉዕሚንከክዕኔ ሶሀንቶእተ ሶህኑ፤</para>
  <para style="p" vid="1PE 1:1-2">ክዕኔንከ መገን ኣስቱትለከ ወገሬቱ በተኡንክዕኔ።<verse eid="1PE 1:1-2"/></para>
  <para style="s1">ሄአኖ ተብሳሃ</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3"/>መሲህ ኢስ ሬሆች ኬእ መሳን ሄአኖ ተብሳ ኣሴኔሁ አበ አሙዚን ለንክ ሃዕሮ እለንሸ ኣሴኔ ቀርቹሃኔ መሲህ ኢስ አኑ መገኑ ገለትጨሙን። <verse eid="1PE 1:3"/><verse number="4" style="v" sid="1PE 1:4"/>እስን በእቡ፥ ሸምቡለከ ባልቅቡ እርስተ ሰማን ቅጥአዕዮህዕኔ። <verse eid="1PE 1:4"/><verse number="5" style="v" sid="1PE 1:5"/>አዕኑ ጎፍሜ በር ለለኖ ጡሚሃ አመዕነት መሳን መገን ዎልቃን አገረንቴንታአ። <verse eid="1PE 1:5"/><verse number="6" style="v" sid="1PE 1:6"/>ህካን እኮቤቺሃ ቀዎ ወክቲሃ አደደ ፌተነ ኣዜን ህጉክዕኔ ሻዝሰኖሃለከ ፈቅባሃ እኮጎሬሁ ጡሞንከክዕኔ ተሽ ዩንክዕኔ። <verse eid="1PE 1:6"/><verse number="7" style="v" sid="1PE 1:7"/>ሁኩ ፌተነት ኢልታህዕኔሁ አመዕነቱክዕኔ ሀንቅ እሁስ አጥራመትሃት፤ በአኖ ወርቁ ጊራን ፌተነመኖ፤ ሀንቅ አመዕነቱክዕኔ በአኖ ወርቂች በትሽ ዋጉ ዮሲሁ ህት ፌተነሙ ሀስሰኖስ፤ ሁኩ ሀንቅ አመዕነቱክዕኔ መሲህ ኢስ ፈንቀል አሜተኖ ወክት ገለት፥ ኬዕምኝለከ ናዱ ደግሲሰኖህዕኔ። <verse eid="1PE 1:7"/><verse number="8" style="v" sid="1PE 1:8"/>መሲህ ኢሰ ለኤንበጎሬሁ ኢትቴነንተስ፤ ቴሁ መሃ እሱ ለኤንበጎሬሁ እሶን አመዕንቴንታአ፤ ላጋን ኩሌን አታሌንበለከ ከበጀሞ ተሽቲን ተሽ የኖህዕኔ። <verse eid="1PE 1:8"/><verse number="9" style="v" sid="1PE 1:9"/>መሰንትስ አመዕነትክዕኔ ጎፍሞሃ እኮ ነብሴክዕኔ ጡሙ ደዕቴንተቤቺሃት።<verse eid="1PE 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10"/>ህካን እኮቤቺሃ ጡምተኔሃ ክዕኔሃ እሀኖ ኣስቱተ ራጎ ነብያከት አበ መረመርቶኡ። <verse eid="1PE 1:10"/><verse number="11" style="v" sid="1PE 1:11"/>እሰን ኣዜንከሰ ሄዕዮ መሲህ አያኑ መሲሁ አሌን ኢልታ ኦርሸተለከ ኦርሻች ኤተሮን አሜተኖ ኬዕምኝተኔሃ ሄጭ ለልሾ እቅ፤ እሰን ሁኩን ጉዕሙንኩ መ ወክትለከ ሀት እክ እሀኖጎሬ መረመርቶ እቅ። <verse eid="1PE 1:11"/><verse number="12" style="v" sid="1PE 1:12"/>ከን ጠውተኔሃ ነብያከት ካደንታ እቂሁ ክዕኔታት ቤሉ ገዉሰ እሁ ሆጉስ ለልዮሰ፤ ከ ጠወ ክዕኔሃ ዱዱብስቶኢሁ እንጂለ ክዕኔሃ ኤቦ መናከት ሰሜች ሶሀሞ ጠሊለ አያኒንት።<verse eid="1PE 1:12"/></para>
  <para style="s1">ጠሊለ እሄን ሄዕተኔሃ</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13"/>ህካን እኮቤቺሃ ቀልብክዕኔ ኬሴን ሆጎተ ቅጥ ይዬ፤ መሲህ ኢስ ፈንቀል አሜተኖ ወክት ደእቴነንተ መገን ኣስቱተ ዊመ ቀልቢን ተብሳሃ አዕዬ። <verse eid="1PE 1:13"/><verse number="14" style="v" sid="1PE 1:14"/>ትዛዝ ቶጋ እለገ እኬን ደጉ ሆጊን ዎዕነ ዮህዕኔ ሂለ ሄዕላቸተ አዎንቶኖቼ። <verse eid="1PE 1:14"/><verse number="15" style="v" sid="1PE 1:15"/>ጠዉ እኮጎሬ ገኤህዕኔ መገኑ ጠሊለ እኮገን አዕኑሁ ሄኦንከክዕኔ ጉዕማንን ጠሊላኑተ እኬ። <verse eid="1PE 1:15"/><verse number="16" style="v" sid="1PE 1:16"/>መሰንትስ «አን ጠሊለ እኮምቤቺሃ አዕኑሁ ጠሊላኑተ እኬ» የመም ከተበሞኡ።<note caller="-" style="x"><char style="xo" closed="false">1፥16 </char><char style="xt" closed="false"><ref loc="LEV 11:44-45">ሌዌ 11፥44-45</ref>፤ <ref loc="LEV 19:2">19፥2</ref>።</char></note><verse eid="1PE 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 1:17"/>አዬሃ ጎሉዕናን ጉዕሚንከስ ሆጎስገ ፈረደኖ መገኑ «ኒ አነ» ይቴን ገእቴነንታሃ እኮች ከን ኣዱንያ አሌን ኮሀ እኬን ዮንተ ጌሳን መገኑ ዋጅቴነን ሄዕዬ። <verse eid="1PE 1:17"/><verse number="18" style="v" sid="1PE 1:18"/>አዕኑ አናካችክዕኔ ረገኤንተ ተሰ ሄኢች ወዘንቴንታሁ በአኖ ብሪን ህከረንገ ዎርቂን እሁ ሆጉስ ደጌነንተ። <verse eid="1PE 1:18"/><verse number="19" style="v" sid="1PE 1:19"/>አዕኑ ወዘንቴንታሁ ጤዕየት ህከረንገ ኩሌኖስርቹ ዮበእ ነጠ ሆልቹ እኮ መሲህ ኬዕምኝ ቄጊኒት። <verse eid="1PE 1:19"/><verse number="20" style="v" sid="1PE 1:20"/>እስ ለሌኢሁ ኣዱንያ አሉ ከለቀሙዕነ ብሬን እሀን ቴሱ ጎፍሜ ዘማኔን ክዕኔተኔሃ ለልዮኡ። <verse eid="1PE 1:20"/><verse number="21" style="v" sid="1PE 1:21"/>አመዕነቱክዕኔለከ ተብሶክዕኔ መገኖን እክ መሲህ መሳን እሱ ሬሆች ኬሾስለከ ኬዕምኝ ኣሴ መገኖን አመዕነንቴነንተ።<verse eid="1PE 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22"/>አመዕናኖተ አጉጣቀንሱ ዮበእ ኢተት ሄኦህዕኔተ ሀንቂሃ አዘዘንቴን ነብሳክዕኔ ነጠ አቴንታአ፤ ህካን እኮቤቺሃ ዊመ<note caller="+" style="f"><char style="fqa" closed="false">ዊመ፦ </char><char style="ft" closed="false">የኖሁ መት-መቱ ሉህ ክታበት «ነጠ» ይታአ።</char></note> ቀልቢንከክዕኔ መት-መቲንከክዕኔ ጠረኝቴን ኢተቀሜ። <verse eid="1PE 1:22"/><verse number="23" style="v" sid="1PE 1:23"/>ለንኪሃ እለንቴንታሁ ሄአኖለከ ዘላለሚሃ ኡር ሄአኖ መገን ላጋን በእበ ዘሬቺት ቤሉ በኣ ዘሬቺበአ። <verse eid="1PE 1:23"/><verse number="24" style="v" sid="1PE 1:24"/>መሰንትስ</para>
  <para style="q1" vid="1PE 1:24">«መኑ ጉዕሙንኩ ህጤገ፤</para>
  <para style="q2" vid="1PE 1:24">ኬዕምኙስ ጉዕሙንኩ ቦብሎጋት፤</para>
  <para style="q2" vid="1PE 1:24">ህጥት ሞልታአ፤ ቦብሉንት ግግልታአ፤<verse eid="1PE 1:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="1PE 1:25"/>ጠዉ እኮጎሬ ቀርች ላገት</para>
  <para style="q2" vid="1PE 1:25">ዘላለሚሃ ጠረኚት ሄኣአ»</para>
  <para style="m" vid="1PE 1:25">ዱዱብሰንቶህዕኔ ተሽት ላገት ተኒት።<note caller="-" style="x"><char style="xo" closed="false">1፥24-25 </char><char style="xt" closed="false"><ref loc="ISA 40:6-8">ኢሳ. 40፥6-8</ref>።</char></note><verse eid="1PE 1:25"/></para>
  <chapter eid="1PE 1"/>
  <chapter number="2" style="c" sid="1PE 2"/>
  <para style="s1">ሄአኖ ክኑለከ ጠሊለ ኡመት</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1"/>ቴሱ ሾክመተ ጉዕመንከ፥ ጣንሱ ጉዕመንከ፥ ተስቄነጡ፥ አቄሸተለከ ሄምተ ጉዕመንከ ክዕኔች ቄርስዬ። <verse eid="1PE 2:1"/><verse number="2" style="v" sid="1PE 2:2"/>ሃዕሮ እለንቶ ሰብያኑት አዙተ ሄዕላታሀንገን አዕኑሁ ጡምቶኖተ ነጵቴነን መርቴነንተ ነጠ ትምርት ሄዕላቼ። <verse eid="1PE 2:2"/><verse number="3" style="v" sid="1PE 2:3"/>መሰንትስ ሄዕላቶኖተ አታልቴነንታንኩ «ጠለዕል ቀርቹ ጎደበ ላፈ እሁስ ደጌነንተራት።»<note caller="-" style="x"><char style="xo" closed="false">2፥3 </char><char style="xt" closed="false"><ref loc="PSA 34:8">መዝ. 34፥8</ref>።</char></note><verse eid="1PE 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 2:4"/>ህካን እኮቤቺሃ ሄአኖ ክኑ እኮ ቀርቾ ኢስቤቹ ሆንጠኬ፤ ሁኩ ክኑ መኑ ህንቅ አጉሮስ ጠዉ እኮጎሬ መገንሀኔን ዶዕርዮስሀለከ ከበጀሞ ዋጉ ዮስሃን። <verse eid="1PE 2:4"/><verse number="5" style="v" sid="1PE 2:5"/>ቀርቾሃ ኢስቤቹ ሆንጠኬነንታሁ ሄአኖ ክንገ እኬን መኪኒት፤ ከን ሃሌን መሲህ ኢስ መሳን ተሽ የኖ ክትመ መገኒሃ ሆንጠህሶኖተ ጠሊላኑተ ቂሰተ እኬነንተ። <verse eid="1PE 2:5"/><verse number="6" style="v" sid="1PE 2:6"/>ጠሊለ መጻፋን</para>
  <para style="q1" vid="1PE 2:6">«ሁኩንን ዶዕሬመስለከ ከበጀሞ</para>
  <para style="q2" vid="1PE 2:6">ሙረበ ቡዕል ክኑ ጽዮናን አፉሻም፤</para>
  <para style="q2" vid="1PE 2:6">እሶን አመዕነኖሁ ሆሮን ሙለኖበአ»</para>
  <para style="m" vid="1PE 2:6">ይታ ላገት ከተበንት ደገንታአ።<note caller="-" style="x"><char style="xo" closed="false">2፥6 </char><char style="xt" closed="false"><ref loc="ISA 28:16">ኢሳ. 28፥16</ref>።</char></note> <verse eid="1PE 2:6"/><verse number="7" style="v" sid="1PE 2:7"/>ቴሱ ክዕኔሃ አመዕንቴንተሀኑኡሃ ሁኩ ክኑ ኬዕምኙ ዮስሃን፤ ጠዉ እኮጎሬ አመዕንትቡሀኑኡሃ</para>
  <para style="q1" vid="1PE 2:7">«ግንበኛኑት ህንቅ ኡጅቶ ክኑ</para>
  <para style="q2" vid="1PE 2:7">እስ ሙረበ ቡዕል ክኑ እኮ።»<note caller="+" style="f"><char style="fqa" closed="false">ሙረበ ቡዕል ክኑ፦ </char><char style="ft" closed="false">የኖሁ ምኒ እጃሬነን ኡርሴኖ ቱቅገ ምኒ እጀኖሃን።</char></note><note caller="-" style="x"><char style="xo" closed="false">2፥7 </char><char style="xt" closed="false"><ref loc="PSA 118:22">መዝ. 118፥22</ref>።</char></note><verse eid="1PE 2:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="1PE 2:8"/>ህትን</para>
  <para style="q1" vid="1PE 2:8">«መኒሃ ጉፍቹ እሀኖ ክኑ</para>
  <para style="q2" vid="1PE 2:8">መኑ ቆዕል ኡበኖገ አአኖ ክኑ» የኖ።</para>
  <para style="m" vid="1PE 2:8">እሰ ላገስ አመዕኑ ሆጎቤቺሃ ቆዕልታአ። ሄጭትን ከኒሃ መጠረንቶእራን።<note caller="-" style="x"><char style="xo" closed="false">2፥8 </char><char style="xt" closed="false"><ref loc="ISA 8:14-15">ኢሳ. 8፥14-15</ref>።</char></note><verse eid="1PE 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9"/>ጠዉ እኮጎሬ አዕኑ ቱንስቺች አጀብሲሰኖ ኑሪሀስ ገኤህዕኔ መገኒሃ አጀብሲሳ ሆጉተ አዋጅቶኖተ መጠረንቴንተ ክልቀት፥ ዎመ ቂሰተለከ መገኑ ገይስሃ አዕዮ ጠሊለ ኡመት።<note caller="-" style="x"><char style="xo" closed="false">2፥9 </char><char style="xt" closed="false"><ref loc="EXO 19:5-6">ፉል. 19፥5-6</ref>፤ <ref loc="ISA 43:20-21">ኢሳ. 43፥20-21</ref>፤ <ref loc="DEU 4:20">ዘዳ. 4፥20</ref>፤ <ref loc="DEU 7:6">7፥6</ref>፤ <ref loc="DEU 14:2">14፥2</ref>፤ <ref loc="TIT 2:14">ቲቶ 2፥14</ref>፤ <ref loc="ISA 9:2">ኢሳ. 9፥2</ref>።</char></note> <verse eid="1PE 2:9"/><verse number="10" style="v" sid="1PE 2:10"/>አዕኑ ወዕና መገንየ ኡመትበአ እቅ፤ እኮጎሬ ቴሱ መገንየ ኡመት፤ ወዕና ማርቱተ ደእቴንበረ እቅ፤ ቴሱ ማርቱተ ደእቴንታአ።<note caller="-" style="x"><char style="xo" closed="false">2፥10 </char><char style="xt" closed="false"><ref loc="HOS 2:23">ሆሴ. 2፥23</ref>።</char></note><verse eid="1PE 2:10"/></para>
  <para style="s1">መገን ካዲመተ</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11"/>ኢ ጃላ! አዕኑ ከን ኣዱንያ አሌን ኮሀለከ መን ባዱ አሜቴንታሃ እኬንተቤቺሃ ነብሴንከክዕኔ ኦለመኖ ማል ሄዕላቻች አገዕርቶኖተ ኡጫንክዕኔ። <verse eid="1PE 2:11"/><verse number="12" style="v" sid="1PE 2:12"/>ሂለ ጠወ አቴነንተ ይት ሄዕምቶህዕኔጎሬ መገኑ ኔሳሃ ዳንዶተ አሜተኖ በር አመዕንትቡ መኑ ጡመ ሆጉክዕኔ ለእ መገኑ ገለትጭቶተ እሰ በላን ሄኤነን ጡሙ ሃሉ ሄኡንክዕኔ።<verse eid="1PE 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13"/>ቀርቾሃ ኢስተኔሃ ይቴን ሹምነቱ ዮስ መኒሃ ጉዕሚንከ አዘዘሜ፤ ጉዕመንከ መኒሃ ሀለቀተ እኮቤቺሃ ዎመ ዎሚሃ አዘዘሜ። <verse eid="1PE 2:13"/><verse number="14" style="v" sid="1PE 2:14"/>ባዱ ገሽታሀኑኡተ አዘዘሜ፤ እሰ ሂለ አታ መነ ቀጠኦተለከ ጡመ አታረ ገለትጭቶተ ዎመ ዎሚች ሶሀንቶእራን። <verse eid="1PE 2:14"/><verse number="15" style="v" sid="1PE 2:15"/>መሰንትስ ጡመ ጠወ አቴነን ገዉ መኑ ጠወኣ ጠወ ጨለ ይታገ አቶኖተ መገንተ ሃሽኣቱ። <verse eid="1PE 2:15"/><verse number="16" style="v" sid="1PE 2:16"/>መገን ካድመገ እኬን ሰዎልድማን ሄዕዬ ቤሉ ሰዎልድመክዕኔ ሂለ ጠወ ድቤነንታሃ አቶኖቼ። <verse eid="1PE 2:16"/><verse number="17" style="v" sid="1PE 2:17"/>መነ ጉዕመንከ ከበጅዬ፤ አመዕናኑተ ኢትዬ፤ መገኑ ዋጅዬ፤ ዎመ ከበጅዬ።<verse eid="1PE 2:17"/></para>
  <para style="s1">መሲህ ኦርሸ ምሳሌተኔሃ</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18"/>አዕኑ ካዲመት ቀርቻኖተክዕኔ ከበጃን ጠገሜ፤ አዘዘንቴነንታሁ ጡማኖተለከ ጎደበ ላፋኖተ ጠለዕል እሳሃ እሁዕነ ሂላኖተ አዘዘሜ። <verse eid="1PE 2:18"/><verse number="19" style="v" sid="1PE 2:19"/>መንቹ ገለትጨመኖሁ ኢሬን ኦርሸተ ቶገኖረ መገንተኔሃ ይ ፈረሀኖራት። <verse eid="1PE 2:19"/><verse number="20" style="v" sid="1PE 2:20"/>ሂለ ጠወ አቴን ህከን ጠውተኔሃ ቅጣት ቶጌን ፈረኬንተጎሬ ም ገለቱ ዮህዕኔ? ጠዉ እኮጎሬ ጡመ ጠወ አቴን ህከን ጠውተኔሃ ኦሪሸተ ቶጌን ፈረኬንተጎሬ መገኒች ገለት ደእቴነንተ። <verse eid="1PE 2:20"/><verse number="21" style="v" sid="1PE 2:21"/>ገአንቴንታሁ ከኒሃት፤ መሰንትስ እስ ዎቃሃ አዎንቶኖተ መሲህ ክዕኔተኔሃ ኦሪሸተ ቶጊን ምሳልተ እኮህዕኔ። <verse eid="1PE 2:21"/><verse number="22" style="v" sid="1PE 2:22"/>እስ ሆሮ ጩብ አዕዮበአ፤ አፎንከስ ክዝብ ላገት ደገንቶበአ።<note caller="-" style="x"><char style="xo" closed="false">2፥22 </char><char style="xt" closed="false"><ref loc="ISA 53:9">ኢሳ. 53፥9</ref>።</char></note> <verse eid="1PE 2:22"/><verse number="23" style="v" sid="1PE 2:23"/>ቦሮሬመስ ወክት ፈንቀሽ ቦሮሮበአ፤ ኦሪሸተ ቶጎ ወክት ፈየ ፈረደኖ መገኒሃ ገዉስ ህግሽ ኣሴ ቤሉ ፎከሮበአ።<note caller="-" style="x"><char style="xo" closed="false">2፥23 </char><char style="xt" closed="false"><ref loc="ISA 53:7">ኢሳ. 53፥7</ref>።</char></note> <verse eid="1PE 2:23"/><verse number="24" style="v" sid="1PE 2:24"/>ነኡ ሬሆን አደ እህ ጌሰ ጩቢች አደ እንክ ፈይማን ሄዕኖተ እስ ገዉንኩስ ጩብኔ ማሊንከስ መስቀል አሌን እጄእ፤ እስ ጡሌን አዕኑ ፈይቴንታአ።<note caller="-" style="x"><char style="xo" closed="false">2፥24 </char><char style="xt" closed="false"><ref loc="ISA 53:5">ኢሳ. 53፥5</ref>።</char></note> <verse eid="1PE 2:24"/><verse number="25" style="v" sid="1PE 2:25"/>አዕኑ በኦ ሆለገ ጀል ጀል ይቴነንታት እቅ፤ እኮጎሬ ቴሱ ነብሳክዕኔ አገረኖ ዜማንች አደ ፈንቀልቴንታአ።<note caller="-" style="x"><char style="xo" closed="false">2፥25 </char><char style="xt" closed="false"><ref loc="ISA 53:6">ኢሳ. 53፥6</ref>።</char></note><verse eid="1PE 2:25"/></para>
  <chapter eid="1PE 2"/>
  <chapter number="3" style="c" sid="1PE 3"/>
  <para style="s1">ምኒ አንለከ ምኒ አመተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1"/>ህትን ምኒ አማኖ! ምኒ አናኖተ አዘዘሜ፤ ከን ሃሌን መት-መቱ መገን ላጋን አመዕንትበረ እኮጎሬ ምንሰ አማኑት መቱርቹሃ ጠወኡዕናን ጠለዕል ምንሰ አማኖ ሃሊን አመዕንቶተ አታልታአ። <verse eid="1PE 3:1"/><verse number="2" style="v" sid="1PE 3:2"/>ክዕኔቤቹ አሜቶተ አታልታኢሁ ሙጩሩ እኮለከ መነ ከበጄኖሃ እሁክዕኔ ለአራት።<note caller="-" style="x"><char style="xo" closed="false">3፥1 </char><char style="xt" closed="false"><ref loc="EPH 5:22">ኤፌ. 5፥22</ref>፤ <ref loc="COL 3:18">ቆላ. 3፥18</ref>።</char></note> <verse eid="1PE 3:2"/><verse number="3" style="v" sid="1PE 3:3"/>ክዕኔ ደኑክዕኔ ሹሩበ ደዲን፥ ዎርቂን ሹልምሲንለከ ጤአተ ህዕሬን ኦደኤኖ ኦድኑተ ኦደኢን አብሌን ለኤኖ ሹልሚን እሁንከ።<note caller="-" style="x"><char style="xo" closed="false">3፥3 </char><char style="xt" closed="false"><ref loc="1TI 2:9">1 ጢሞ. 2፥9</ref>።</char></note> <verse eid="1PE 3:3"/><verse number="4" style="v" sid="1PE 3:4"/>ጠዉ እኮጎሬ ደኑክዕኔ መገን ብሬን ዋጉስ አበ ከበጀሞለከ በእበ ሹልሚን ጎደበ ላፍማንለከ ገዉ አገዕሪን ቀልቤን ኬዕምሰሞለከ በእቡ መክሲን ገዉ ሆፍሲንለከ አታዕሊን ሰውቲን ኣዝ ጅስሚን እሁን። <verse eid="1PE 3:4"/><verse number="5" style="v" sid="1PE 3:5"/>መሰንትስ ብሬ ዘማን መገኑ ተብሳ አታ ጠሊላኑ ሜንቱ መክጨንቶኢሁ ህትዪት እቅ፤ እሰን ምንሰ አናኖ ትዛዝ ቶጋ እቅ። <verse eid="1PE 3:5"/><verse number="6" style="v" sid="1PE 3:6"/>አዘዘንቶኢንኩ ሳረ እብራሂሚሃ «ኢ ቀርቾ» ይተን አዘዘንቶስ ደኒንት፤ አዕኑ ጡመ ጠወ አቴነንተረለከ መቱ ዋጅሲሰኖ ጠዉ ህልቅስባህዕኔጎሬ እሴተ እለ።<note caller="-" style="x"><char style="xo" closed="false">3፥6 </char><char style="xt" closed="false"><ref loc="GEN 18:12">ክል. 18፥12</ref>።</char></note><verse eid="1PE 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7"/>ህትን ምኒ አናኖ! ምኒክዕኔ አማኖን ሜጡበ አጥራመቲን ሄዕዬ፤ ክዕኔች በትስ ላፈ ክልቀት እኮቤቺሃለከ ክዕኔን ሜጡበ ሄእ ኣስቱተ ረገኣቤቺሃ ኬዕምሼሰ፤ ከን ሃሌን ዱእሃክዕኔ ጉፍቹ እሀኖርቹ ሄአኖበአ።<note caller="-" style="x"><char style="xo" closed="false">3፥7 </char><char style="xt" closed="false"><ref loc="EPH 5:25">ኤፌ. 5፥25</ref>፤ <ref loc="COL 3:19">ቆላ. 3፥19</ref>።</char></note><verse eid="1PE 3:7"/></para>
  <para style="s1">ጡመ አኢን ኦሪሸተ ቶጉ</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8"/>ጉዕሙንኩክዕኔ መት-መቲንከክዕኔ ኢታን ሄዕዬ፤ ዎሎ መን ኦሪሸተ ገይክዕኔሀንገ አቴን ሰውይዬ፤ አመኦሶገ እኬን ኢተቀሜ፤ ጎደበ ላፋኑተለከ ገዉክዕኔ ሆፍሴነንተረ እኬ። <verse eid="1PE 3:8"/><verse number="9" style="v" sid="1PE 3:9"/>ህትን ማሰዕዬ ቤሉ ሂለርቹ ሂለርቺንለከ ቦሮሩ ቦሮሪን ፈንቀሽቶኖቼ፤ መሰንትስ አዕኑ ገአንቴንታሁ ህካን አቶኖታት፤ ህካን አኦንከክዕኔ በረከተ ረገኤነንተ። <verse eid="1PE 3:9"/><verse number="10" style="v" sid="1PE 3:10"/>ጠሊለ መጻፋን</para>
  <para style="q1" vid="1PE 3:10">«ሙንዲኖን ዊሞ ሄኡ ሄኦተ ኢተኖሁለከ ጡመ በር ለኦተ ሀሰኖሁ</para>
  <para style="q2" vid="1PE 3:10">አረብስ ሂለ ጠወ ጠወኢች</para>
  <para style="q2" vid="1PE 3:10">አፎስ ሂለ ተንኩተ ጠወኢች ገዉስ አገዕሩን።<verse eid="1PE 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1PE 3:11"/>ህትን ሂለ ጠወ አኢች ገዉስ አገዕሩን፤ ጡመ ጠወ አኡን፤</para>
  <para style="q2" vid="1PE 3:11">ህትን ወገሬት ሀሱን፤ ወገሬትንከ አዎኑን፤<verse eid="1PE 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1PE 3:12"/>መሰንትስ ቀርች እልት</para>
  <para style="q2" vid="1PE 3:12">ጠሊላኑተ ለኣአ፤</para>
  <para style="q2" vid="1PE 3:12">መጨንትስ ዱአሰ ሞጮጭቶተ ፈንተኦእታን፤</para>
  <para style="q2" vid="1PE 3:12">ጠዉ እኮጎሬ ሂለ ጠወ አታ መን አሌን</para>
  <para style="q2" vid="1PE 3:12">ቀርቹ ኡሙዕሬ ሚኒተ ለሊሰኖ» የመሞኡ።<note caller="-" style="x"><char style="xo" closed="false">3፥10-12 </char><char style="xt" closed="false"><ref loc="PSA 34:12-16">መዝ. 34፥12-16</ref>።</char></note><verse eid="1PE 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13"/>ጡመርቹ አቶኖተ ሃሸኤንተጎሬ ምዕረተ ኢልሰኖህዕኔሁ አዬት? <verse eid="1PE 3:13"/><verse number="14" style="v" sid="1PE 3:14"/>ጠዉ እኮጎሬ ጡመ ጠወ አቴን ኦርሸተ ቶጌንተጎሬ በረከተ ደእቴነንተ፤ መን ፎከረተ ዋጅቶኖቼ፤ ጨነቀንቶኖቼ።<note caller="-" style="x"><char style="xo" closed="false">3፥14-15 </char><char style="xt" closed="false"><ref loc="MAT 5:10">ማቶ. 5፥10</ref>፤ <ref loc="ISA 8:12-13">ኢሳ. 8፥12-13</ref>።</char></note> <verse eid="1PE 3:14"/><verse number="15" style="v" sid="1PE 3:15"/>ቀርቹ መሲህ ቀልቤንከክዕኔ ከበጅዬስ፤ ሄእሃክዕኔ ቀርቹ አዕዬስ፤ ክዕኔን ዮ ተብሴሃ ጠዕመኖህዕኔሀኒሃ ጉዕሚንከ መስለ ኣቶኖተ ጉዕመ ወክት ተቃጠቤ። <verse eid="1PE 3:15"/><verse number="16" style="v" sid="1PE 3:16"/>ጠዉ እኮጎሬ መስሉክዕኔ ጎደበ ላፍማንለከ ከበጂን እሁን፤ መሲህሃ እኬንተቤቺሃ ዮህዕኔ ጡመ ሃል አሌን ሂለርቹ ጠወኣ መኑ ሂለ ጠወኢንከሰ ሙልቶተ ጡሙ ሰዉቱ ሄኡንክዕኔ። <verse eid="1PE 3:16"/><verse number="17" style="v" sid="1PE 3:17"/>መገኑ ዬጎሬ አዕኑ ሂለ ጠወ አቴን ኦሪሸተ ቶጌነንተሀኒች ጡመ ጠወ አቴን ኦሪሸተ ቶጉ ቆሀኖ። <verse eid="1PE 3:17"/><verse number="18" style="v" sid="1PE 3:18"/>መሲህ ገዉስ መገን ቤቹ ሆንጠህሶህዕኔተ እስ ፈየ እሀን ፈየ እንኮምበእ ኒ ጩብ መሳን መንተኔሃ ሜጦረን ሬዮኡ፤ እስ ማሊን ሬይ አያኒን ሄአኖሃ እኮ። <verse eid="1PE 3:18"/><verse number="19" style="v" sid="1PE 3:19"/>ህከን አያኒን ኡሱር ምኔን ዮ ነፍሴቤቹ መር ተሽት ለገተ ዱዱብሴሰ። <verse eid="1PE 3:19"/><verse number="20" style="v" sid="1PE 3:20"/>ሁኩ ኡሱር ምኔን ዮ ነብሴቤቹ ሄጭ ኑህ ዘማን መርከቡ ቅጥየን መገኑ አደቢን አገራንሰ ሄዕዮገን ትዛዝ ቶጉ ግቦእራን፤ ህከ መርከብ ኣዝ ኣግ ዊ መሳን ጡምቶእሩ ዎሊንሹሰ ህዜቱሃ መነ እቅ።<note caller="-" style="x"><char style="xo" closed="false">3፥20 </char><char style="xt" closed="false"><ref loc="GEN 6:1-7:24">ክል. 6፥1—7፥24</ref>።</char></note> <verse eid="1PE 3:20"/><verse number="21" style="v" sid="1PE 3:21"/>ሁኩ ዉሁ ቴሱ ክዕኔተ ፌሰኖ ጥምቀትተ ምሳል፤ ኩ ጥምቀቱ ጅስሚች ጡር ከሙ እሁዕነ ሙጩሩ ቀልብ ደኢሃ መገን ቤቹ ሆንጠህሰኖሃ ዱአ፤ ፌሰኖህዕኔንኩ መሲህ ኢስ ኬእ መሳኒት። <verse eid="1PE 3:21"/><verse number="22" style="v" sid="1PE 3:22"/>እስ ሰማ ኦሮዕይ መገን መኬን ዮኡ፤ እሲንከ መላይከት፥ ዳኛኑትለከ ዎልቀት ዮሰሩ ጉዕሙንኩ ጠገንቶስ።<verse eid="1PE 3:22"/></para>
  <chapter eid="1PE 3"/>
  <chapter number="4" style="c" sid="1PE 4"/>
  <para style="s1">ጠሊልማን ሄኡ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1"/>መሲህ ማሊንከስ ኦርሸተ ቶጎሃ እኮቤቺሃ አዕኑ በገዝ ኦዳተ ቆዕሬ መንገ ከን ሰውቲን ጠረኝቴን ተቃጠቤ፤ ማሊንከስ ኦርሸተ ቶጎ መንቹ ጩብ አኡ አጉሮኡ።<note caller="+" style="f"><char style="fqa" closed="false">ማሊንከስ ኦርሸተ ቶጎ መንቹ ጩብ አኡ አጉሮኡ፦ </char><char style="ft" closed="false">የኖሁ ካን ዎሉ ፍሳረት «መሲህ ማሊንከስ ኦርሸተ ቶጎቤቺሃ ጩቢሃ ዎልቀት ሄኣስበእገ አዕዮኡ» የኖሃን።</char></note> <verse eid="1PE 4:1"/><verse number="2" style="v" sid="1PE 4:2"/>ከኒች ኤተሮን ፈቆ ኣዱንያ አሌን ሄእንከክዕኔ ማል ሂለ ሄዕላቸተ አኢን እሁዕነ መገን ሰውት አቴነን ሄዕዬ። <verse eid="1PE 4:2"/><verse number="3" style="v" sid="1PE 4:3"/>አይሁደ እክበሩ አታሀንገ መጠረቁ ዮበኢ፥ ሂለ ሄዕላቻን፥ ሰከርን፥ ጌሱ ዮበእ ሙንዲኖን፥ ጌሱ ዮበኢሃ አጌን ቦሎቸ ከድችለከ ኮፍየኖ ሽርክተ አቴነን ሄኤንተ ዘማኑ እሀኖ። <verse eid="1PE 4:3"/><verse number="4" style="v" sid="1PE 4:4"/>እኮጎሬ ቴሱ ከን ጠዋን እኮበእጌሰ እሳን ሜጡበ ፍጭርቅ ዩ ሆጌንተቤቺሃ ናዳአ፤ ህትን ቦሮርታአ። <verse eid="1PE 4:4"/><verse number="5" style="v" sid="1PE 4:5"/>ጠዉ እኮጎሬ ፎሊን ዮሀኑኡንለከ ሬዮ መን አሌን ፈረዶተ ቅጥይዮ መስለ እሲሃ ኣታአ። <verse eid="1PE 4:5"/><verse number="6" style="v" sid="1PE 4:6"/>ከን ሃሌን ጉዕመ መንገን እሰን ማሊንከሰ ሬቶተ ፈረደሞሰ፤ ጠዉ እኮጎሬ አያኒንከሰ ዘላለሚሃ መገንገ ሄኦተ እንጂሉ ሬቶሀኑኡተ ዱዱብሰሞኡ።<verse eid="1PE 4:6"/></para>
  <para style="s1">መገን ኣስቶን ጡመገ አታ መንተኔሃ</para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7"/>ጉዕማንከ ጠዊሃ ጎፍሞስ ኢልዮኡ፤ ጠረኝቴን ዱአ አኢሃ አታልቴነንተ ተሬገጮ ቀልቡ ሄኡንክዕኔ፤ ህትን ገዉ አገዕሪን ሄዕዬ። <verse eid="1PE 4:7"/><verse number="8" style="v" sid="1PE 4:8"/>ኢተት ልግብ ጩብ ማጦተ አታልታቤቺሃ ጉዕመርቺችን በትሽ ገገዉክዕኔ ጠረኝቴን ኢተቀሜ።<note caller="-" style="x"><char style="xo" closed="false">4፥8 </char><char style="xt" closed="false"><ref loc="PRO 10:12">ምሳ. 10፥12</ref>።</char></note> <verse eid="1PE 4:8"/><verse number="9" style="v" sid="1PE 4:9"/>ህትን ቁንቁቶኑዕናን ገገዉክዕኔ ኮሀ ቶቃቀሜ። <verse eid="1PE 4:9"/><verse number="10" style="v" sid="1PE 4:10"/>አደደ እኮ መገን ኣስቶን ጡመ ሃሊን ገሽቶኖተ ክዕኔች መት-መቱስ ኣሰሞስ ኣስቶን ዎሉ ካደሙን። <verse eid="1PE 4:10"/><verse number="11" style="v" sid="1PE 4:11"/>ህካን እኮቤቺሃ ተማርሰኖሁ አዪሁ መገን ላገተ ተማርሰኖሀንገ ተማርሱን፤ ህትን ካደመኖሁ አዪሁ መገኑ ኣሴስ ዎልቃን ካደሙን፤ ከን ሃሌን መገኑ መሲህ ኢስ አዲን ጉዕማንከ ጠዋን ሎዕረኖ፤ ኬዕምኙለከ ዎልቀት ዘላለሚሃ እሲሃ እሁን፤ ኣሚዕን!<verse eid="1PE 4:11"/></para>
  <para style="s1">ኦርሸ ወክቴን ጠረኝተኔሃ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12"/>ኢ ጃላ! ጊረገ ፌተንታህዕኔ ኦርሸ ኣዜን እኬንተ ወክት ሮሰሞበእ ሃዕሮ ጠዉ አሌንከክዕኔ ኢሌሀንገ አቴን አጀብሲጭቶኖቼ። <verse eid="1PE 4:12"/><verse number="13" style="v" sid="1PE 4:13"/>ጠዉ እኮጎሬ መሲህ ኬዕምኙ ለለኖ ወክት አበ ሙንደኦኖተ እስ ኦርሸተ ቤቀንቴነንተረ እኬንተቤቺሃ ተሽ ዩንክዕኔ። <verse eid="1PE 4:13"/><verse number="14" style="v" sid="1PE 4:14"/>ህትን መሲህ ሱዕምተኔሃ ቦሮረንቴንተጎሬ ኬዕምኝ አያነ እኮ መገን አያኑ ክዕኔ አሌን ፎሎጨኖቤቺሃ ማሰአንቴንታእረ። <verse eid="1PE 4:14"/><verse number="15" style="v" sid="1PE 4:15"/>ጠዉ እኮጎሬ ክዕኔች አዪሁ ኦርሸተ ቶገን ነብሳ ሼሀንገ፥ ሞጋንችገ፥ ተንኩተ አአኖ መንችገለከ መን ጠዋን ገኦኑዕናንስ ኣገኖ መንችገ እሁንከ። <verse eid="1PE 4:15"/><verse number="16" style="v" sid="1PE 4:16"/>አመዕናንቹ እኮቤቺሃ ኦርሸተ ኢልታሲሁ ሄዕዮ ጎሬ አመዕናንቹ የመም ገአሞንከስ መገኑ ገለትጩን ቤሉ ሙሉንከ።<verse eid="1PE 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 4:17"/>መሰንትስ ፍርዱ ጀመረኖ ወክቱ ሆንጠኮኡ፤ ጀመረኖንኩ መገን መን አሌኒት፤ ህከረ ፍርዱስ ጀመረኖሁ ኒ አሌን እሀኖረ መገኒሃ እንጂሊሃ አዘዘንታበእ መኒች ኤተሩሰ መ እሀኖ? <verse eid="1PE 4:17"/><verse number="18" style="v" sid="1PE 4:18"/>ጠሊሉ መጻፉ</para>
  <para style="q1" vid="1PE 4:18">«ፈዩ መንቹ ጡመኖሁ አበ ጭንቃን እሀኖሃ እኮች</para>
  <para style="q2" vid="1PE 4:18">መገኒሃ ጠገንትበሩለከ ጩበኛኑት ሀት እካአ?» የኖ።<note caller="-" style="x"><char style="xo" closed="false">4፥8 </char><char style="xt" closed="false"><ref loc="PRO 11:31">ምሳ. 11፥31</ref>።</char></note><verse eid="1PE 4:18"/></para>
  <para style="m">
    <verse number="19" style="v" sid="1PE 4:19"/>ህካን እኮቤቺሃ መገን ሰውቲን ኦርሸተ ቶጋ መኑ ገዉሰ አመዕነሞ ካሊቂሃ ኤገተ ኣቱን፤ ጡመ ጠወ አኡ አጉርቱንከ።<verse eid="1PE 4:19"/></para>
  <chapter eid="1PE 4"/>
  <chapter number="5" style="c" sid="1PE 5"/>
  <para style="s1">መገን ኡመት ገሺታ መኒሃ ኣሰንቶ ሸዘነተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1"/>ቴሱ አን እሳንን ሜጡበ መገን አመዕናኖ ዱእ ምናተ ባልቅ እኮሚሁ፥ መሲህ ኦሪሸተኔሃ ምስክር እኮሚሁ፥ ከ ኤተሩ ለለኖ ኬዕምኝ ቤቀማም እኮሚሁ በላንከክዕኔ ዮ መገን አመዕናኖ ዱእ ምነ ባልቀተ ሸዛንሰ። <verse eid="1PE 5:1"/><verse number="2" style="v" sid="1PE 5:2"/>ኤገተ ኣሴመህዕኔ መገን ዜሞሀ አገሬ፤ ዜሞስ አገርቴነንታንኩ ዎልቃን እሁዕነ መገኑ ሀሰኖ ሃሊን ኢታን እሁን፤ ህትን ብረ ኢቲን እሁዕነ ሀዕልቶኖተ ዮህዕኔ ሃሽኣቶን እሁን።<note caller="-" style="x"><char style="xo" closed="false">5፥2 </char><char style="xt" closed="false"><ref loc="JHN 21:15-17">ያህ. 21፥15-17</ref>።</char></note> <verse eid="1PE 5:2"/><verse number="3" style="v" sid="1PE 5:3"/>ህትን ክዕኔ ሹምነት ኣዜን ዮ መነ ጭንፍቴን ጠቅቶኖተ እሁዕነ ዜሜሃስ ጡመ ምሳልተ ለሊሲን እሁን። <verse eid="1PE 5:3"/><verse number="4" style="v" sid="1PE 5:4"/>ህካን አቴንተጎሬ ሀንገፉ ዜማንቹ አሜተኖ ወክት በእቡ ኬዕምኝ አክሊለ ደእቴነንተ።<verse eid="1PE 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5"/>ህትን አዕኑ ዎደለት ባልቂሃ አዘዘሜ፤ ጉዕሙንኩክዕኔ ገው ሙግ አኡ ኦድኖገ ኦደኤን መቱ ዎሉስ ካደሙን፤</para>
  <para style="q1" vid="1PE 5:5">«መገኑ ቦነኖ መነ ግበኖ፤</para>
  <para style="q2" vid="1PE 5:5">እኮጎሬ ገዉሰ ሙግ አታ መኒሃ ኣስቱስ ኣሰኖ» የመም ከተበሞኡ።<note caller="-" style="x"><char style="xo" closed="false">5፥5 </char><char style="xt" closed="false"><ref loc="PRO 3:34">ምሳ. 3፥34</ref>።</char></note><verse eid="1PE 5:5"/></para>
  <para style="m">
    <verse number="6" style="v" sid="1PE 5:6"/>ቴሱ መገኑ ዬ ወክቴን ጎት ጎት አኦህዕኔተ መገን ዎልቃሜ አንጋች ዎሮን ገዉክዕኔ ሙግ ሙግ አዕዬ።<note caller="-" style="x"><char style="xo" closed="false">5፥6 </char><char style="xt" closed="false"><ref loc="MAT 23:12">ማቶ. 23፥12</ref>፤ <ref loc="LUK 14:11">ሉቃ. 14፥11</ref>፤ <ref loc="LUK 18:14">18፥14</ref>።</char></note> <verse eid="1PE 5:6"/><verse number="7" style="v" sid="1PE 5:7"/>ህትን መገኑ ክዕኔተኔሃ ሰውየኖቤቺሃ ሻዝሰኖህዕኔርቹ ጉዕመንከ እስ አሌን ኡጅዬ።<verse eid="1PE 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8"/>ህትን ጌሲን ሄዕዬ፤ በቅይዬሁ፤ ዲኑክዕኔ እልቢሱ አጉዕመኖሃ ሀሰን ዎደኖ ዞቤገ ዘሀኖት። <verse eid="1PE 5:8"/><verse number="9" style="v" sid="1PE 5:9"/>ከን ኣዱንያ አሌን ጉዕማንን ዮ አመዕናኑት አመክዕኔ ኦሱት ህትኔ ኦሪሸተ ቶጋኢሃ እሁስ ደጌን አመዕነቲን ጠረኝቴን እልቢሰ ግቤስ። <verse eid="1PE 5:9"/><verse number="10" style="v" sid="1PE 5:10"/>ቀዎ ወክቲሃ ኦርሸተ ቶጌንታች ኤተሮን መሲህ አዲን ዘላለሚሃ ኬዕምኝቤቹ ገኤህዕኔ ጉዕመ ኣስቶ መገኑ ገዉንኩስ ዊማኑተ አአኖህዕኔ፤ ድክሰኖህዕኔ፥ ጠረኝሰኖህዕኔ፥ ኡርሰኖህዕኔ። <verse eid="1PE 5:10"/><verse number="11" style="v" sid="1PE 5:11"/>ዘላለሚሃ ኢለ ዎልቀት እሲሃ እኩን! ኣሚዕን።<verse eid="1PE 5:11"/></para>
  <para style="s1">ኤተር ወገሬት</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12"/>አመዕነሞ አመኤቤቱ ይ ሰውያም ስላሴ አዲን ከ ሶህኑተ ገበንቾን ከተቦንክዕኔ፤ ከተቦንክዕኔንኩ ሸዞህዕኔተለከ ኩን ሀንቅ መገን ኣስቱተ እሁስ መሰከሮህዕኔተ ይዪት፤ ህካን እኮቤቺሃ ከን መገን ኣስቶን ጠረኝቴን ኡሪዬ።<note caller="-" style="x"><char style="xo" closed="false">5፥12 </char><char style="xt" closed="false">ሶቀ. 15፥22፥40።</char></note><verse eid="1PE 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13"/>ክዕኔገን መጠረንቶ ባብሎን ከተንቾን ሄኣ መገን አመዕናኖ ዱእ ምኒቹት ወገሬት ሆንጠህሳህዕኔት፤ ቤቱእ ማርቆሲሁ «ወገሬት ዮንተንዶ?» የኖህዕኔት።<note caller="-" style="x"><char style="xo" closed="false">5፥13 </char><char style="xt" closed="false"><ref loc="ACT 12:12">ሶቀ. 12፥12</ref>፤ <ref loc="ACT 25">25</ref>፤ <ref loc="ACT 13:13">13፥13</ref>፤ <ref loc="ACT 15:37-39">15፥37-39</ref>፤ <ref loc="COL 4:10">ቆላ. 4፥10</ref>፤ <ref loc="PHM 1:24">ፍልሞ. 24</ref>።</char></note> <verse eid="1PE 5:13"/><verse number="14" style="v" sid="1PE 5:14"/>አመዕናኖ ኢተ ሱንቃቀንሺን መት-መቱክዕኔ ዝያዕረሜ፤</para>
  <para style="p" vid="1PE 5:14">መሲህረ እኬንተሀኑኡ ጉዕሚንከክዕኔ ወገሬቱ እሁን።<verse eid="1PE 5:14"/></para>
  <chapter eid="1PE 5"/>
</usx>
