<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MRK" style="id">HALABA NEW TESTAMENT</book>
  <para style="h">ማርቆሴ እንጂለ</para>
  <para style="toc1">ማርቆስ ከተቦ ቀርችኔ መሲህ ኢስ እንጂለ</para>
  <para style="toc2">ማርቆስ እንጂለ</para>
  <para style="toc3">ማር.</para>
  <para style="mt1">ማርቆስ ከተቦሃ</para>
  <para style="mt2">ቀርችኔ መሲህ ኢስ እንጂለ</para>
  <para style="imt1">ኣጉስ</para>
  <para style="ip">ማርቆስ እንጂሉ «ኩን መገን ቤቲ መሲህ ኢስ ተሽት ላገ ዎኔሃን» የን ጀመረኖ፤ ከን እንጂል ኣዜን ኢስ ሆጎለከ ሹምነቱ ዮስ መንቹ እክ ሆንጠኮኡ፤ ሹምነቱስ ትምርቲንከሲ ሩሃንይ አሌን ዮስ ዎልቃንለከ መን ጩብ ፈቁን ዮንከስ ለልዮኡ። ኢስ «መነ ጩብ ሮስማች ነጠ ፉሾተ ነብሳኤ ህግሽ ኣሶተ አሜቾም መንችሃ ቤቱ» ይ ገዉንኩስ ጠወዕዮኡ።</para>
  <para style="ip">ማርቆስ ኢስ ሄሱተ ሆንጠህሾሁ ጌጥዬለከ ዎልቀተ ዊሞ ዎቄን እሀን ጠረኝሾንኩ ኢስ ላጋንለከ ትምርቴንከስ እሁዕነ አዕዮ አጀብሲሰኖ ጠዊንት እቅ። ጠመቃንቾ ያህይ ሄሱተ ኢስ ጠመቀሙስለከ ፌተነሙስ ገበንቹ ኣጉ አዕዮች ኤተሮን ከተቦሁ ኢስ ተማርስለከ ፈይስ ክድመተ ሂር ኩለኖ። ወክቲች ኤተሮን ኢስ አሳበት ኢሰ ዎዕኔች አበ ደገን መርቶ ቁድሬን ኢሰ ግባእሩ በትስ ግበንስ መርቶኡ። ጎፍሜ ፎሎጭ አሌን ኢስ ጎፍሜ ሳምንት ኣዜን እኮ ጠውተኔሃ በትሽ ሰቀለሙስለከ ኬኡስ ኩልታእራን።</para>
  <para style="ip">እንጂል ጎፍሞን ቀቦን ለልቶ ለሙ ክፍሉ መት-መቶ ከተበንቶ መጻፋን ጠለዕል ሄኣእራን።</para>
  <para style="iot">መጻፉስ አፎሃ</para>
  <para style="io1">እንጂልስ ዎኔሃ <char style="ior">(<ref loc="MRK 1:1-13">1፥1-13</ref>)</char></para>
  <para style="io1">ኢስ ክድመስ ገሊላን ጀመሩስ <char style="ior">(<ref loc="MRK 1:14-9:50">1፥14—9፥50</ref>)</char></para>
  <para style="io1">ዬሩሳሌማን ካደሙስ <char style="ior">(<ref loc="MRK 10:1-52">10፥1-52</ref>)</char></para>
  <para style="io1">ዬሩሳሌማንለከ አዝጋጌንከስ ጎፍሜ ሳምንተ <char style="ior">(<ref loc="MRK 11:1-15:47">11፥1—15፥47</ref>)</char></para>
  <para style="io1">ቀርቹ ሬሆች ኬኡስ <char style="ior">(<ref loc="MRK 16:1-8">16፥1-8</ref>)</char></para>
  <para style="io1">ሬሆች ኬዕዮ ቀርቹ ለሉስለከ ሰማ ኦሮኡስ <char style="ior">(<ref loc="MRK 16:9-20">16፥9-20</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="MRK 1"/>
  <para style="s1">ጠመቃንቹ ያህይ አዋጄገ</para>
  <para style="r">(<ref loc="MAT 3:1-12">ማቶ. 3፥1-12</ref>፤ <ref loc="LUK 3:1-18">ሉቃ. 3፥1-18</ref>፤ <ref loc="JHN 1:19-28">ያህ. 1፥19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1"/>ኩን መገን ቤቲ<note caller="+" style="f"><char style="ft" closed="false">መት-መቱ ክታበት «መገን ቤቱ» ይታ ላገተ በርግታበአ።</char></note> መሲህ ኢስ እንጂሊሃ ዎኔሃን። <verse eid="MRK 1:1"/><verse number="2" style="v" sid="MRK 1:2"/>ነብዬቾ እስያሴን</para>
  <para style="q1" vid="MRK 1:2">«መገኑ ‹አን ወዕቃክ ቅጥአአኖ</para>
  <para style="q2" vid="MRK 1:2">ሶቀማንቹኤ ብሬንከክ ሄጭ ሶሃም› ዬእ።<note caller="-" style="x"><char style="xo" closed="false">1፥2 </char><char style="xt" closed="false"><ref loc="MIC 3:1">ሚክ. 3፥1</ref>።</char></note><verse eid="MRK 1:2"/></para>
  <para style="m">
    <verse number="3" style="v" sid="MRK 1:3"/>ሁኩንን፦</para>
  <para style="q1" vid="MRK 1:3">‹ቀርች ወቃሃ ቅጥአዕዬ፤</para>
  <para style="q2" vid="MRK 1:3">ጭርቴን ጌጥ አዕዬ› የን</para>
  <para style="q2" vid="MRK 1:3">ኡለ ኡድማን ላገስ ጎት አዕይ ያረኖ መንች ላገተ»</para>
  <para style="m" vid="MRK 1:3">የመም ከተበሞጋት።<note caller="-" style="x"><char style="xo" closed="false">1፥3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">ኢሳ. 40፥3</ref>።</char></note><verse eid="MRK 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4"/>ህካን እኮቤቺሃ ጠመቃንቹ ያህይ «ጩብክዕኔ ፈቁን የመሞተ ቶበቴን ጠመቀሜ» የን አዋጀን ኡለ ኡድመ አሜቾ። <verse eid="MRK 1:4"/><verse number="5" style="v" sid="MRK 1:5"/>ይሁድ ባዶንለከ ዬሩሳሌም ከተማን ሄዕዮ መኑ ጉዕሙንኩ አሜት ጩብሰ ቶበተን ዮርዳኖስ ዛዘኖ ዋን ጠመቀኖሳት እቅ።<verse eid="MRK 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6"/>ህትን ያህይ ጋሜል ኦርዛች ደዴማ ኦድኑተ ኦደዕይ ረመዞንከስ ጠፍራ ቆዕረኖ እቅ፤ እስን ከንቸፈሩሃ፥ ኡድም ዳመ መለቡሃ እተኖ እቅ።<note caller="-" style="x"><char style="xo" closed="false">1፥6 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 ነገ. 1፥8</ref>።</char></note> <verse eid="MRK 1:6"/><verse number="7" style="v" sid="MRK 1:7"/>እስን «አን ሙግይ ጫዕመስ ወደሩ ሂሮተ በቀዕባሁ ኢች በተአኖሁ ኢች ኤተሪን አሜተኖ፤ <verse eid="MRK 1:7"/><verse number="8" style="v" sid="MRK 1:8"/>ህትን አን ዊን ጠመቆንክዕኔ፤ ጠዉ እኮጎሬ እስ ጠሊለ አያኒን ጠመቀኖህዕኔ» የን አዋጀኖ እቅ።<verse eid="MRK 1:8"/></para>
  <para style="s1">ኢስ ጠመቀሙስለከ ፌተነሙስ</para>
  <para style="r">(<ref loc="MAT 3:13-17">ማቶ. 3፥13-17</ref>፤ <ref loc="MAT 4:1-11">4፥1-11</ref>፤ <ref loc="LUK 3:21-22">ሉቃ. 3፥21-22</ref>፤ <ref loc="LUK 4:1-13">4፥1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9"/>ህከ ወክት ኢስ ገሊል ባዶን ሄዕዮ ናዝሬት ከተሚች አሜቻን ያህይ ዮርዳኖስ ዛዘኖ ዋን ጠመቆስ። <verse eid="MRK 1:9"/><verse number="10" style="v" sid="MRK 1:10"/>ወክትንከስ ኢስ ዊች ፉሎ ወክት ሰሞ ፊልተዕይ ፈንተዕያን ጠሊሉ አያኑ ሀንደዕሬገ እክ እስ አሌን ድረንስ ለዕዮ። <verse eid="MRK 1:10"/><verse number="11" style="v" sid="MRK 1:11"/>ህከ ወክት «ኢታንኬ ቤቱኤ አቴት ኪን ተሽ የኖኤ» ይታ ላገት ሰሜች አሜቶኡ።<note caller="-" style="x"><char style="xo" closed="false">1፥11 </char><char style="xt" closed="false"><ref loc="GEN 22:2">ክል. 22፥2</ref>፤ <ref loc="PSA 2:7">መዝ. 2፥7</ref>፤ <ref loc="ISA 2:1">ኢሳ. 2፥1</ref>፤ <ref loc="MAT 3:17">ማቶ. 3፥17</ref>፤ <ref loc="MAT 12:18">12፥18</ref>፤ <ref loc="MRK 9:7">ማር. 9፥7</ref>፤ <ref loc="LUK 3:22">ሉቃ. 3፥22</ref>።</char></note><verse eid="MRK 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12"/>ወክትንከስ መገን አያኑ ኢሰ ኡለ ኡድመ ኦሮአኖገ አዕዮስ። <verse eid="MRK 1:12"/><verse number="13" style="v" sid="MRK 1:13"/>ህከን ኡለ ኡድማን ሸይጣኑ ኢሰ ፌተኖተ አጰመን ሸይሉ በር ኢስ አብል ቡሳዊን ሜጡበ ዱንኬእ፤ ሰሜ መላይከንት ካደንቶስ።<verse eid="MRK 1:13"/></para>
  <para style="s1">ኢስ ተማርስ ሆጉተ ገሊላን ጀመሩስ</para>
  <para style="r">(<ref loc="MAT 4:14-17">ማቶ. 4፥14-17</ref>፤ <ref loc="LUK 4:14-15">ሉቃ. 4፥14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14"/>ያህይ ኡሱሬማች ኤተሮን ኢስ መገን ተሽት ላገተ አዋጀን ገሊለተ አሜቾ። <verse eid="MRK 1:14"/><verse number="15" style="v" sid="MRK 1:15"/>እስን «ዘማኑ ጎፎኡ፤ መገን ዎምነቱ ሆንጠኮቤቺሃ ጩብችክዕኔ ፈንቀልቴን ተሽት ላጋን አመዕንዬ» የኖት እቅ።<note caller="-" style="x"><char style="xo" closed="false">1፥15 </char><char style="xt" closed="false"><ref loc="MAT 3:2">ማቶ. 3፥2</ref>።</char></note><verse eid="MRK 1:15"/></para>
  <para style="s1">ኢስ ቁርጩሜተ ዎሻዳ ሾሉ መነ ገኡስ</para>
  <para style="r">(<ref loc="MAT 4:18-22">ማቶ. 4፥18-22</ref>፤ <ref loc="LUK 5:1-11">ሉቃ. 5፥1-11</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16"/>ኢስን «ገሊለ» ዬኖ ባር መዴን ህገን ስሞንለከ አመስቤቱ እንድርያሴን ቁርጩሜተ ዎሻዳእራ እኮቤቺሃ ዎሻደሳ ባር አሌን ኡጅተን ለዕዮሰ። <verse eid="MRK 1:16"/><verse number="17" style="v" sid="MRK 1:17"/>እሰንተ ኢስ «ኤሳሃ አዎኜ፤ አዕኑ ቁርጩሜተ ዎሻዴነንተገን መነ መገን አደ ኤቤነንተረ ኣሳንክዕኔ» ዬሰ። <verse eid="MRK 1:17"/><verse number="18" style="v" sid="MRK 1:18"/>ወክትንከስ ወሻደሰ ኡጅት አዎንቶስ።<verse eid="MRK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19"/>ኢስ ህከንቤቺች ቀውተ ህጎገን ዘብዴዎሴ ኦሱት ያቁቢለከ ያህይ ጀልብሰ አሌን አፉዕልት ወሻደሰ መክሰን ለዕዮ። <verse eid="MRK 1:19"/><verse number="20" style="v" sid="MRK 1:20"/>ኢስን ወክትንከስ ገኤሰ፤ እሰን ያቁብ ያህይ አነሰ ዘብድዎሴለከ አኒሃሰ ሆጉተ አአኖ መነሃ ጀልብ ኣዜን አጉርት ኢሰ አዎንቶስ።<verse eid="MRK 1:20"/></para>
  <para style="s1">ዱሩ አፎስ መንቹ ፈዩስ</para>
  <para style="r">(<ref loc="LUK 4:31-37">ሉቃ. 4፥31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21"/>ኢስ አሳባንተስን «ቅፍርናሆመ» ዬኖ ከተመ አሜች አበ በሬን ጭምት ምኒ<note caller="+" style="f"><char style="fqa" closed="false">ጭምት ምኒ፦ </char><char style="ft" closed="false">የኖሁ አይሁድ መኑ ዱአ አታእሃ ምኒ።</char></note> ኣግ ተማርሱ ጀመሮ። <verse eid="MRK 1:21"/><verse number="22" style="v" sid="MRK 1:22"/>ኢስ ሕገ ተማርስታሀኑኡገ እሁዕነ ሎሩ ሹምነቱ ዮስ መንችገ ተማርሰኖሃ ለእ ህከኔ ሄዕዮ መኑ ሞጮጭት ትምርቴንከስ አበ አጀብሲጭቶኡ።<note caller="-" style="x"><char style="xo" closed="false">1፥22 </char><char style="xt" closed="false"><ref loc="MAT 7:28">ማቶ. 7፥28</ref>።</char></note><verse eid="MRK 1:22"/></para>
  <para style="p">
    <verse number="23-24" style="v" sid="MRK 1:23-24"/>ጭምትሰ ምናንን መቱ ዶሮረኖ አያኑ አፎስ መንቹ ሄዕዮ እቅ፤ እስን «ናዝሬት ኢሰ! ኔሳለከ ኬሳሃ ም ደቀንሹ ዮኔ? ቤሶኔተ አሜትንዶ? አት አዬት ጎሬ አን ደጋንኬ፤ አት መገንያ ጠሊለ» የን ሎረ ላጋን ያሮ።<verse eid="MRK 1:23-24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25"/>ጠዉ እኮጎሬ ኢስን «ጨለይት እሲች ፉል» ይ ሻቆስ።<verse eid="MRK 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26"/>ሁኩ ዶሮረኖ አያኑ ህከ መንቹ መቱ ጌሰ ከጣቀንሴሲች ኤተሮን ሎረ ላጋን ያረን እሲችን ፉሎ። <verse eid="MRK 1:26"/><verse number="27" style="v" sid="MRK 1:27"/>ህከኔ ሄዕዮ መኑ ጉዕሙንኩ «ኩን መርቾሃን? ዶሮርታ ዱራከተ ሹምነቲንከስ ተማርስሃን አዘዘንታስ» ይተን አጀብሲጭት መቱ መቱሰ ጠዕምቶኡ።<verse eid="MRK 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28"/>ህከ ወክትንከ ዱዱቡስ ገሊላ ባዶን ጉዕማንን ሞጮጨሞ።<verse eid="MRK 1:28"/></para>
  <para style="s1">ኢስ ልግብ ጥዘናመተ ፈይሱስ</para>
  <para style="r">(<ref loc="MAT 8:14-17">ማቶ. 8፥14-17</ref>፤ <ref loc="LUK 4:38-41">ሉቃ. 4፥38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29"/>ህከኒች ኤተሮን ኢስ ያቁብንለከ ያህይን ሜጡበ ጭምት ምኒች ፉል ሲሞኔለከ እንድርያሴ ምኒ ኣጎ። <verse eid="MRK 1:29"/><verse number="30" style="v" sid="MRK 1:30"/>ህከኔን ስሞኔ በሉት ፋረ ደሙሜን አበ ጥዝ ኦሰኦ እቅ፤ እሴ ጥዞገ ወክትንከስ ኢሲሃ ኩለሞስ። <verse eid="MRK 1:30"/><verse number="31" style="v" sid="MRK 1:31"/>ኢስን አንገሴ አፍ ኬሻንሴ ፋረ ደሙሜ ጥዘናችሴ ፈይቶኡ፤ እሴን ኬእ እሰንተ ካደንቶሰ።<verse eid="MRK 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32"/>ህከ በር አሩ ኣገን ሀዎርዮ ወክቴን መኑ ጥዘናመተለከ ሩሃንዪን አፈንቶረ ጉዕመንከ ኢስበ ኤባኢት እቅ። <verse eid="MRK 1:32"/><verse number="33" style="v" sid="MRK 1:33"/>ከተምስ መኑ ጉዕሙንኩ ህከን ኡሮን ጭምይቶኡ። <verse eid="MRK 1:33"/><verse number="34" style="v" sid="MRK 1:34"/>ኢስን ልግብ መነ አደደ ጥዘናች ፈይሾ፤ ልግብ ሩሃንየንከ ፉሼእ፤ ልግቡ ሩሃንዩንኩ ኢስ አዬት ጎር ደጎስቤቺሃ ኢስ ጠወኦተ ፈቀጆሰበ እቅ።<verse eid="MRK 1:34"/></para>
  <para style="s1">ኢስ ገሊላን ተማርሱስ</para>
  <para style="r">(<ref loc="LUK 4:42-44">ሉቃ. 4፥42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35"/>ኢስ ሶዞተ ሆንጠኮ ወክቴን ኬዕይ መኑ ዮበእቤቹ መር ህከን ቤቾን ዱአ አዕዮ። <verse eid="MRK 1:35"/><verse number="36" style="v" sid="MRK 1:36"/>ጠዉ እኮጎሬ ስሞንለከ እሲን ሜጡበ ሄኦእሩ ኢሰ ሀሶተ ፉልቶኡ።<verse eid="MRK 1:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 1:37"/>እሰን ደጎስ ወክት «መኑ ጉዕሙንኩ ኬሳሃ ሀሰኖሄት» ይቶስ።<verse eid="MRK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38"/>ኢስን «ወዕናንከ አሜቾሚሁ ተማርሶተ እኮቤቺሃ ግደኖ ዮ ቀእተ መርን ህከኔ ተማርስኖ» ዬሰ።<verse eid="MRK 1:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39"/>ህካን እኮቤቺሃ ጭምትሰ ምናን ዱዱብሰንለከ ሩሃንየ ፉሸን ገሊለ ባዶን ዮ ጉዕመ ቤቹንከ ፈንቀላመኖ እቅ።<note caller="-" style="x"><char style="xo" closed="false">1፥39 </char><char style="xt" closed="false"><ref loc="MAT 4:23">ማቶ. 4፥23</ref>፤ <ref loc="MAT 9:35">9፥35</ref>።</char></note><verse eid="MRK 1:39"/></para>
  <para style="s1">ኢስ ጎግ አል ጥዘነተ ፈይሱስ</para>
  <para style="r">(<ref loc="MAT 8:1-4">ማቶ. 8፥1-4</ref>፤ <ref loc="LUK 5:12-17">ሉቃ. 5፥12-17</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40"/>ጎግ አል ጥዘነተ ጥዦ መንቹ ኢስበ አሜች ሎከስ አሌን ኡብ «ኢትቶንቴኤ ጎሬ ፈይሶኤተ አታልታንት» ይ ኡጬስ።<verse eid="MRK 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41"/>ኢስን አበ መረርስጭ አንገስ አሌስ አዕይ «ፈቀጆም ፈይ» ዬእ። <verse eid="MRK 1:41"/><verse number="42" style="v" sid="MRK 1:42"/>ወክትንከስ ጎግ አል ጥዘነት ገፈርታንስ ፈዬእ። <verse eid="MRK 1:42"/><verse number="43-44" style="v" sid="MRK 1:43-44"/>ኢስን ህከ መንቹ «ከ ጠወሃ አዬሃ ጠወኣንትበእገ አገዕር፤ ጠዉ እኮጎሬ ሎረ ቂስችበ መርት ጅስመክ ለሊስ፤ መሰንትስ አት ነጠ እክ ፈይቶንትገ መኑ ደጎተ ሙስ አዘዦገን መገኒሃ ክትም ሆንጠህስ» ይ አዘዦስ።<note caller="-" style="x"><char style="xo" closed="false">1፥43-44 </char><char style="xt" closed="false"><ref loc="LEV 4:1-32">ሌዌ 4፥1-32</ref>።</char></note><verse eid="MRK 1:43-44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45"/>ጠዉ እኮጎሬ ሁኩ መንቹ ጠወስ ወክትንከስ መኒሃ ጠወኡ ጀመሮ፤ ህከን መንች መሳን ኢስ ከተማን ለል ፈንቀላሞተ አታሉ ሆጎቤቺሃ ከተሚች አብሌን መኑ ዮበእቤቾን ሄአኖ እቅ፤ ህካን እኮቤቺሃ መኑ እስዮቤቹ ጉዕመ ቤቺችን አሜተኖ እቅ።<verse eid="MRK 1:45"/></para>
  <chapter eid="MRK 1"/>
  <chapter number="2" style="c" sid="MRK 2"/>
  <para style="s1">ኢስ ናፈ መንቹ ፈይሱስ</para>
  <para style="r">(<ref loc="MAT 9:1-8">ማቶ. 9፥1-8</ref>፤ <ref loc="LUK 5:17-26">ሉቃ. 5፥17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1"/>ቀዎ በሬች ኤተሮን ኢስ ቅፍርናሆም ከተመ ፈንቀል አሜቾ፤ ህከን ቤቾን «ኢስ ምኔን ዮኡ» ዬኖ ዱዱቡ ሞጮጨሞ። <verse eid="MRK 2:1"/><verse number="2" style="v" sid="MRK 2:2"/>ህከ ወክት ልግቡ መኑ ኢስ ዮ ምኒ ኡሩት ሩክታኢሃ ኢለ ጭምዬእ፤ ህከኔን ኢስ መገን ላገተ ተማርሰኖሳት እቅ። <verse eid="MRK 2:2"/><verse number="3" style="v" sid="MRK 2:3"/>ህከ ወክት መቱ ናፈ መንቹ ሾሉ መኑ እጅት ኤቦኡ። <verse eid="MRK 2:3"/><verse number="4" style="v" sid="MRK 2:4"/>ጠዉ እኮጎሬ መኑ በተዕዮቤቺሃ ህከ ናፈ መንቹ ኢስበ ሆንጠህሶተ ቤቹ ሩኬሰቤቺሃ ኢስ ዮ አዲን ምኒ እልተ ፈንት ናፈ ኦሰዕዮ ዴስንከስን ድርሶኡ። <verse eid="MRK 2:4"/><verse number="5" style="v" sid="MRK 2:5"/>ኢስን አመዕነቱሰ ለዕይ ናፈ መንቹ «ኢ ጩሌ ጩቡክ ፈቁን የማሞሄ» ዬስ። <figure style="fig" alt="Single story flat-roofed house" file="LB00234B.tif" size="span" ref="2፥4">አይሁድ ፉቅ ሚኒ </figure><verse eid="MRK 2:5"/></para>
  <para style="p">
    <verse number="6-7" style="v" sid="MRK 2:6-7"/>ህከኔ አፉዕልቶ ሕግ አስተማራች መት-መቱሰ ቀልቤንከሰ «ኩ መንቹ ሚሃት ህትኔ ቦሮር ላገተ መገን አሌን ጠወአኖሁ? ሜጡወ መገን ቤሉ ጩብ አጉሮተ አታለኖሁ አዬት?» ይት ሰውይቶኡ።<verse eid="MRK 2:6-7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8"/>ወክትንከስ ኢስ ቀልብሰ ጠወ አያኒንከስ ደግ «ሚሃት ቀልቤንከክዕኔ ካን ሰውይቴነንታሁ? <verse eid="MRK 2:8"/><verse number="9" style="v" sid="MRK 2:9"/>ናፈ መንቹ ‹ጩቡክ አጉረሞሄ› ዪቺለከ ‹ኬእ ዴሰክ እጅት ኦሮእ› ዪቺ ሀኩንስ ቆሀኖ? <verse eid="MRK 2:9"/><verse number="10" style="v" sid="MRK 2:10"/>ጠው እኮጎሬ መንች ቤቱ ኡለ አሌን ጩብ ፈቁን ዮተ ሹምነቱ ዮሲሃ እሁስ ደጌ» ይ ናፈ መንቹ <verse eid="MRK 2:10"/><verse number="11" style="v" sid="MRK 2:11"/>«ኬእ ዴሰክ እጅት ምንክ ኦሮእ ያንኬ» ዬስ።<verse eid="MRK 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12"/>ናፉንኩ ወክትንከስ ዴሰ እጅ መን ብሬን ፉሎ፤ ህካን እኮቤቺሃ መኑ ጉዕሙንኩ አጀብሲጭ «ህትኔ ጠወ ሆሮን ለዕኖምበአ» ይት መገኑ ገለትጭቶኡ።<verse eid="MRK 2:12"/></para>
  <para style="s1">ኢስ ማቶሴ ዬኖ ሌዊ ገኡስ</para>
  <para style="r">(<ref loc="MAT 9:9-13">ማቶ. 9፥9-13</ref>፤ <ref loc="LUK 5:27-32">ሉቃ. 5፥27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13"/>ኢስ ፈንቀል ገሊለ ባር መድ ኦሮዕዮ፤ ልግቡ መኑ እስበ አሜታን ተማርሴሰ። <verse eid="MRK 2:13"/><verse number="14" style="v" sid="MRK 2:14"/>ህከን አዲን ህገን እሊፍዮሴ ቤቱ ሌው ቀረጠ ሙረን ለዕይ «አዎኔኤ» ዬስ፤ እስን ኬዕይ አዎኞስ።<verse eid="MRK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15"/>ህከ ወክት ኢሰ አዎኞ መኒች ልግቡሰ ቀረጠ ሙርታሀኑኡንለከ ጩበኛኖን ጉዕሙንኩ ኢሲንለከ አሳባን ሜጡበ እክ ሌዌ ምኔን እቸተ እታኢት እቅ። <verse eid="MRK 2:15"/><verse number="16" style="v" sid="MRK 2:16"/>ፈሪሳዌ አዲች ሕግ አስተማረት ኢስ ቀረጠ ሙርታሀኑኡንለከ ጩበኛኖን ሜጡበ እተን ለእ «ጩበኛኖንለከ ቀረጠ ሙርታሀኑኡን እተኖሁ ሚሃት» ይት አሳበስ ጠዕምቶሰ።<verse eid="MRK 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17"/>ኢስን ህካን ሞጮጭ «ሀኪሙ ሀስሰኖሁ ጥዘናማታት ቤሉ ፈየ መኒሃበአ፤ አን አሜቾሚሁ ጠሊላኑተ እሁዕነ ጩበኛኑተ ገኦታት» ዬሰ።<verse eid="MRK 2:17"/></para>
  <para style="s1">ሶመንተኔሃ ኢሰ ጠዕሜመገ</para>
  <para style="r">(<ref loc="MAT 9:14-17">ማቶ. 9፥14-17</ref>፤ <ref loc="LUK 5:33-39">ሉቃ. 5፥33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18"/>ጠመቃንቹ ያህይ አዎንታእሩለከ ፈርሳውት ሶመንታ እቅ፤ ህካን እኮቤቺሃ መቱ-መቱ መኑ ኢስበ አሜት «ጠመቃንቾ ያህይለከ ፈርሳዊተ አዎንታእሩ ሶመንታ፤ ጠዉ እኮጎሬ ኪ አሳበት ሶመንታበኢሁ ሚሃት?» ይት ጠዕምቶኡ።<verse eid="MRK 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19"/>ህከ ወክት ኢስን ኢዜቹ እሳን ሜጡበ ሄአን ጃለስ ሶመንቶተ ሀስሰኖሰንዶ? ሀስሰኖሰበአ፤ እዜቹ እሳን ሜጡበ ሄዕዮገ ሶመንታበአ።<verse eid="MRK 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 2:20"/>ጠዉ እኮጎሬ «እዜቹ እሳች ኣኤኖ በሩ አሜተኖ፤ እሰን ህከ ወክት ሶመንታአ።<verse eid="MRK 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21"/>«ኑባጵቶ ኦድኖን ሃዕሮ ቃፈተ ቃፈኖሁ ዮበአ፤ ጠዉ እኮጎሬ ህካን አዕዮ ጎሬ ሃዕሮ ቃፈት ኑባጵቶ ኦድኑተ ሁዙዝ ፍልታአ፤ ሁኩ ፍልተዕዮ ቤቹንኩ ወዕኔች ባሰ እሀኖ። <verse eid="MRK 2:21"/><verse number="22" style="v" sid="MRK 2:22"/>ህትን ኑባቾ ሆቆማዶን ሃዕሮ ቃርቡተ ፉሸኖሁ ዮበአ፤ ህካን አኤመ ጎሬ ቃርቡት ሆቆማዱ ፊልታአ፤ ህትን ቃርቡንት ዱንተኣአ፤ ሆቆማዱንኩ ፊልተአኖ፤ ጠዉ እኮጎሬ ሃዕሮ ቃርቡተ ሃዕሮ ሆቆማዶን ዎሩ ሀሲሰኖ» ዬሰ።<verse eid="MRK 2:22"/></para>
  <para style="s1">አበ በሬተኔሃ ሆንጠኮ ጠዕምቱተ</para>
  <para style="r">(<ref loc="MAT 12:1-8">ማቶ. 12፥1-8</ref>፤ <ref loc="LUK 6:1-5">ሉቃ. 6፥1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23"/>አበ በሬን ኢሰ አዎንታእሩ አለስ ዉጠ በሊን ህገን አዎንታእሩ አለስ ሀማሙተ ተንቅሱ ጃመርቶኡ።<note caller="-" style="x"><char style="xo" closed="false">2፥23 </char><char style="xt" closed="false"><ref loc="DEU 23:25">ዘዳ. 23፥25</ref>።</char></note> <verse eid="MRK 2:23"/><verse number="24" style="v" sid="MRK 2:24"/>ህከ ወክት ፈርሳውት ኢሰ «ከ ለእ! ኬሳሃ አዎንታእሩ አበ በሬን አኡ ፈቀዴንባሃ ሚሃት አታኢሁ?» ይት ጠዕምቶኡ።<verse eid="MRK 2:24"/></para>
  <para style="p">
    <verse number="25-26" style="v" sid="MRK 2:25-26"/>ኢስን « ‹ኣብያተሬ› ዬኖ መንቹ ሎረ ቂስቹ እክ ሄዕዮ ወክት ደዉድለከ ደዉዴን ሜጡበ ሄኦ መኑ ጎሩ አፋንሰ ኦርጨቀንቶ ወክት ደዉድ ዱእ ምኒ ኣግ ሎረ ቂስ ቤሉ ዎሉ መኑ እቱ ፈቀደሞበእ መገን የመንቶ ዳቡተ እቾገለከ እሲን ሜጡበ ዮ መኒሃ ኣሴጋ አነበቤንታበእንዶ?<note caller="-" style="x"><char style="xo" closed="false">2፥25-26 </char><char style="xt" closed="false"><ref loc="LEV 24:9">ሌዌ 24፥9</ref>።</char></note> <verse eid="MRK 2:25-26"/><verse number="27" style="v" sid="MRK 2:27"/>ህትን አበ በሩ መኒሃ ከለቀሞ ቤሉ መኑ አበ በሬተ ከለቀሞበአ። <verse eid="MRK 2:27"/><verse number="28" style="v" sid="MRK 2:28"/>ህካን እኮቤቺሃ መንች ቤቱ አበ በሬተ ቀርቾሃ» ዬእ።<verse eid="MRK 2:28"/></para>
  <chapter eid="MRK 2"/>
  <chapter number="3" style="c" sid="MRK 3"/>
  <para style="s1">ኢስ አንገተ ናፈ መንቹ ፈይሱስ</para>
  <para style="r">(<ref loc="MAT 12:9-14">ማቶ. 12፥9-14</ref>፤ <ref loc="LUK 6:6-11">ሉቃ. 6፥6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1"/>ለንኪሃ ኢስ ጭምት ምኒ ኣጎ፤ ህከኔን አንገተ ናፉ መንቹ ሄዕዮ እቅ። <verse eid="MRK 3:1"/><verse number="2" style="v" sid="MRK 3:2"/>ጠዉ እኮጎሬ ኢሰ ከሰሶተ ሀሶ መኑ «አበ በሬን ፈይሰኖ ጎሬ ለዕናም» ይት አገርታኢት እቅ። <verse eid="MRK 3:2"/><verse number="3" style="v" sid="MRK 3:3"/>ኢስን ህከ አንገተ ናፈ መንቹ «አም ከን በላን ኡር» ዬስ። <verse eid="MRK 3:3"/><verse number="4" style="v" sid="MRK 3:4"/>ህከኒች ኤተሮን ኢስ «አበ በሬን ጡመ ህከረንገ ሂለ አኡ ፈቀደሞኡ? ፎል ጡምሱንዶ ህከረንገ ፎል ቤሱ?» ይ ጠዕሜሰ፤ ጠዉ እኮጎሬ እሰ ጨለ ይቶኡ። <verse eid="MRK 3:4"/><verse number="5" style="v" sid="MRK 3:5"/>ኢስን ቀልብሰ ዱድመተ ለዕይ አበ ሻዥ መዴስ ዮ መነ ኡሙዕሬን ለዕይ ህከ አንገተ ናፈ መንቹ «አንገክ ሂር» ዬስ፤ እስን አንገተ ሂሮ ወክት አንገስ ፈይቶኡ። <verse eid="MRK 3:5"/><verse number="6" style="v" sid="MRK 3:6"/>ወክትንከስ ፈሪሳውት ጭምት ምኒች ፉልት ኢሰ ሀት አት ሽቶተ አታልታ ጎሬ ሄሮድሴን ሜጡበ ዮ መኒን አማዕለንቶኡ።<verse eid="MRK 3:6"/></para>
  <para style="s1">ኡመቱ ባር መዴን ኢስበ ጭምይቶገ</para>
  <para style="p">
    <verse number="7-8" style="v" sid="MRK 3:7-8"/>ኢስ አሳባንተስን ሜጡበ ገሊለ ባርበ ኦሮዕዮ፤ ኢስ አዕዮ አጀብሲሰኖ ጠወ ሞጮጭቶ ወክት ልግቡ መኑ አዎኞስ፤ አዎንቶስሩንኩ ገሊል ባዲች፥ ይሁድ ባዲች፥ ኤዶምየ ባዲች፥ ዮርዳኖስ ዉድ አዲን ዮ ባዲች፥ ህትን ዬሩሰሌም ከተሚች፥ ጢሮስ ከተሚችለከ ስዶን ከተሚች አሜቶዕረ እቅ። <verse eid="MRK 3:7-8"/><verse number="9" style="v" sid="MRK 3:9"/>መኑ በተዕዮቤቺሃ ሀንበዕለመን ሃሙ ከመኖስበእገ ጀልበ ቅጥአቶተ አዎናኑስ ኣዘዦ።<note caller="-" style="x"><char style="xo" closed="false">3፥9 </char><char style="xt" closed="false"><ref loc="MRK 4:1">ማር. 4፥1</ref>፤ <ref loc="LUK 5:1-3">ሉቃ. 5፥1-3</ref>።</char></note> <verse eid="MRK 3:9"/><verse number="10" style="v" sid="MRK 3:10"/>ልግብ መነ ጥዘናች ፈይሾቤቺሃ ጥዘናን ኦርጨቀንታሩ ጉዕሙንኩ አንጋን አፎስተ ሀንበዕለንታ እቅ። <verse eid="MRK 3:10"/><verse number="11" style="v" sid="MRK 3:11"/>ዶሮርታ አያናከት እሱ ለኦ ወክት ብሬስ ኡብ «አት መገንያ ቤቱ» ይተን ያርታ እቅ።<verse eid="MRK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12"/>ጠዉ እኮጎሬ ኢስ ገዉስ አዬት ጎሬ ኩልታበእገ ጠረኝሽ አዘዦሰ።<verse eid="MRK 3:12"/></para>
  <para style="s1">ኢስ ቶነ ለሙ አሳበተ መጠሩስ</para>
  <para style="r">(<ref loc="MAT 10:1-4">ማቶ. 10፥1-4</ref>፤ <ref loc="LUK 6:12-16">ሉቃ. 6፥12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13"/>ኢስ ቆተ አል ፉሎ ወክት እስ ሀሾሰረ እስበ ገኤእ፤ እሰን እስበ አሜቶኡ። <verse eid="MRK 3:13"/><verse number="14-15" style="v" sid="MRK 3:14-15"/>እሰን እስን ሜጡበ ሄኦታ፥ ተሽት ላገተ ተማርስቶተ ሶሆሰተለከ ሩሃንየ ፉሽታ ሹምነቱ ኣሶተ ቶና ለሙንከሰ መጠር አሳበተ ይ ሱዕምሾሰ።<verse eid="MRK 3:14-15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16"/>እሰን መጠሮሰ ቶነ ለሙንኩ አሳበት ከኑኡታን «ጴጥሮሴ» ይ ሱዕመ ፉሼ ስሞኒ፥ <verse eid="MRK 3:16"/><verse number="17" style="v" sid="MRK 3:17"/>«ቦአርኔጌስ» ህከረንገ «ጉገኛ ኦሱተ» ይ ሱዕምሾሰ ዘብዴዎሴ ኦሱት ያቁባትለከ ያህይት፥ <verse eid="MRK 3:17"/><verse number="18" style="v" sid="MRK 3:18"/>እንድርያሴት፥ ፍልጶሴት፥ ባርቶሎሞሴት፥ ማቶሴት፥ ቶማሴት፥ እልፍዮሴ ቤቱ ያቁባት፥ ታዶሴት፥ ባዱስ ኢተኖ ስሞኔት፥ <verse eid="MRK 3:18"/><verse number="19" style="v" sid="MRK 3:19"/>ኢሰ ህግሽ ኣሴ አስቆሮቶ ይሁዳቲ እቅ።<verse eid="MRK 3:19"/></para>
  <para style="s1">ኢሰለከ ብዔልዘቡለ</para>
  <para style="r">(<ref loc="MAT 12:22-32">ማቶ. 12፥22-32</ref>፤ <ref loc="LUK 11:14-23">ሉቃ. 11፥14-23</ref>፤ <ref loc="LUK 12:10">12፥10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20"/>ኢስ ምኒ ኦሮዕያን ልግቡ መኑ ለንኪሃ ጭምይት አሜቶኡ፤ ህካን እኮቤቺሃ ኢስለከ አሳበት እቸተ እታ ወክቱ ዮሰበአ እቅ። <verse eid="MRK 3:20"/><verse number="21" style="v" sid="MRK 3:21"/>«ኢስ በርገጎኡ» ዬኖሃ እሉስ ሞጮጭቶ ወክት እሱ አፎተ አሜቶኡ።<verse eid="MRK 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22"/>ዬሩሳሌሚች አሜቶ ሕግ አስተማረት «እሱ ብዔልዘቡል አፎስ፤ እስ ሩሃንየ ፉሸኖሁ ህከን ሩሃንይ ዎመ ብዔልዘቡል ወልቃኒት» ይታ እቅ።<verse eid="MRK 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23"/>ኢስን እሰንተ እስበ ገእ ምሳሌን «ሼይጣኑ ሀት አዕይ ሼይጣን ፉሾተ አታለኖ?<note caller="-" style="x"><char style="xo" closed="false">3፥23 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቶ. 9፥34</ref>፤ <ref loc="MAT 10:25">10፥25</ref>።</char></note> <verse eid="MRK 3:23"/><verse number="24" style="v" sid="MRK 3:24"/>መቱ ዎሙ ገሸኖ መኑ ገገዉንኩስን አደ እክ ብተመኖሃ እኮች ሁኩ ዎሙ ሀት እክ ጠረኝ ኡሮተ አታለኖ? <verse eid="MRK 3:24"/><verse number="25" style="v" sid="MRK 3:25"/>ህትን መቶ ምኔን ሄአኖ መኑ ብተንት ሀት እክ ጠረኝት ሄኦተ አታልታአ? <verse eid="MRK 3:25"/><verse number="26" style="v" sid="MRK 3:26"/>ህካን እኮች ሼይጣኑ ገገዉስ አደ እክ ብተመኖሃ እኮች በአኖ ቤሉ ጠረኝ ሄኦተ አታለኖበአ።<verse eid="MRK 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27"/>«ህትን መቶ ጠረኘ መንች ምኒ ኣጌን ቦጎኖተ ሄጬን ህከ ጠረኘ መንቹ ኡሱሮኑዕነ ምንስ ኣጌን ቦጎኖተ አታሌኖበአ። <verse eid="MRK 3:27"/><verse number="28" style="v" sid="MRK 3:28"/>ሀንቅንከ ያንክዕኔ፤ ኡመቱ አታ ጩቡለከ ጠወኣ ቦሮር ላገት ጉዕሙንኩ ፈቁን የመመኖሰ። <verse eid="MRK 3:28"/><verse number="29" style="v" sid="MRK 3:29"/>ጠዉ እኮጎሬ ጠሊለ አያን አሌን ቦሮር ላገተ ጠወአኖሀን አሌን ጉዕማንን ዘላለሚሃ መገን ኡሙዕርት አሌስ እካ ቤሉ ጩቡስ ማረመኖስበአ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">3፥29 </char><char style="xt" closed="false"><ref loc="LUK 12:10">ሉቃ. 12፥10</ref>።</char></note> <verse eid="MRK 3:29"/><verse number="30" style="v" sid="MRK 3:30"/>ኢስ ህካን ጠወዕዮሁ «ዱሩ አፎስ» ይቶ መሳኒት እቅ።<verse eid="MRK 3:30"/></para>
  <para style="s1">ኢስ አመተለከ አመስ ኦሱተ</para>
  <para style="r">(<ref loc="MAT 12:46-50">ማቶ. 12፥46-50</ref>፤ <ref loc="LUK 8:19-21">ሉቃ. 8፥19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31"/>ኢስ አመትለከ አመስኦሱት አሜት አብሌን ኡርት እስበ መነ ሶክ ገእሲሶስ፤ <verse eid="MRK 3:31"/><verse number="32" style="v" sid="MRK 3:32"/>ኢስ መዴን ልግቡ መኑ አፉዕልዮ እቅ፤ እሰን «አመክለከ አመክ ኦሱት አብሌን ኡርት ኬሳሃ ሀሳሄት» ይት ኩልቶስ።<verse eid="MRK 3:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33"/>እስን «አመኤለከ አመኤ ኦሱት አዬኤታን?» ይ መስለ ፈንቀሼሰ። <verse eid="MRK 3:33"/><verse number="34" style="v" sid="MRK 3:34"/>ኢስን መዴስ አፉዕልቶሀኑ አደ ለአን «አመኤለከ አመኤ ኦሱት ከኑኡታን። <verse eid="MRK 3:34"/><verse number="35" style="v" sid="MRK 3:35"/>መገን ሰውት አአኖ አዪሁ እኮጎር ኤሳሃ አመዕያ ቤቱ፥ አመኤተ ቤቱለከ አመተኤ» ዬእ።<verse eid="MRK 3:35"/></para>
  <chapter eid="MRK 3"/>
  <chapter number="4" style="c" sid="MRK 4"/>
  <para style="s1">ዉጣንች ምሳልተ</para>
  <para style="r">(<ref loc="MAT 13:10-17">ማቶ. 13፥10-17</ref>፤ <ref loc="LUK 8:4-8">ሉቃ. 8፥4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1"/>ኢስ ለንኪሃ ገሊለ ባር መዴን ተማርሱ ጀመሮ፤ ልግቡ መኑ እስቤቾን ጭምይታን እስ ባር አሌን ዮ ጀልባን ኣግ አፉዕሌእ፤ ህትን ልግቡ መኑ ባር መዴን ሄዕዮ እቅ፤<note caller="-" style="x"><char style="xo" closed="false">4፥1 </char><char style="xt" closed="false"><ref loc="LUK 5:1-3">ሉቃ. 5፥1-3</ref>።</char></note> <verse eid="MRK 4:1"/><verse number="2" style="v" sid="MRK 4:2"/>ህከኔን ኢስ ምሳሌን ልግብርቹ ተማርሰኖት እቅ፤ ተማርሰንን <verse eid="MRK 4:2"/><verse number="3" style="v" sid="MRK 4:3"/>«ሞጮጭዬ! መቱ አቡራንቹ ዜሬተ አፍ ዉጦተ ፉሎ። <verse eid="MRK 4:3"/><verse number="4" style="v" sid="MRK 4:4"/>ዜሬተ ዉጠንን መት-መቱስ ዎቄ አሌን ኡባን ጪኡት ኣሜት እቶኡ። <verse eid="MRK 4:4"/><verse number="5" style="v" sid="MRK 4:5"/>ህትን ዎሉ ዜሬቱ ልግቡ ትቡ ዮበእቤቾን ክን ኣሌን ኡብ ደዕልን ሙቾ፤ መሰንትስ ቤቾንከስ ኣዝ ኢለ ልግቡ ትቡ ዮበአ እቅ። <verse eid="MRK 4:5"/><verse number="6" style="v" sid="MRK 4:6"/>ሁኩንን አሩ ፉል ቀሾረ ቆሮ፤ ህትን ሙቾንኩ ጠጱ ዮስበእቤቺሃ ሞሎ። <verse eid="MRK 4:6"/><verse number="7" style="v" sid="MRK 4:7"/>ዎሉስ ዜሬቱ ኡቱ ጭምዬ በላን ኡቦ፤ ኡቱንኩ ነጵ ለንግ አፎስቤቺሃ አቶተ አቶቱዕነ ፈቆ። <verse eid="MRK 4:7"/><verse number="8" style="v" sid="MRK 4:8"/>ህትን ዎሉስ ዜሬቱ ጡመ ኡላን ኡብ ሙቾ፤ ሙቾንኩ ነጵ አቶተ አቶቾ፤ ሁኩንን መቱስ ሰጁ ዎሉስንገ ሌሃዉ ፈቆሲሁ ጥብተ አቶቾ» ዬእ።<verse eid="MRK 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9"/>ኢስን «ሞጮጭታ መጨት ዮሲሁ ሞጮጩን!» ዬእ።<verse eid="MRK 4:9"/></para>
  <para style="s1">ኢስ ምሳሌን ሚሃ ጠወዕዮ ጎር</para>
  <para style="r">(<ref loc="MAT 13:10-17">ማቶ. 13፥10-17</ref>፤ <ref loc="LUK 8:9-10">ሉቃ. 8፥9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10"/>ኢስ ሜጥሀስ ሄዕዮ ወክት መዴንከስ ሄኦ መኑለከ ቶና ለሙንኩ አሳበት ሜጡበ ምሳሌስ ፍሳረተ ጠዕምቶስ። <verse eid="MRK 4:10"/><verse number="11" style="v" sid="MRK 4:11"/>እስን «ክዕኔሃ መገን ዎምነትስ ምስጥር ደጎኖተ ኣሰሞህዕኔ፤ ጠዉ እኮጎሬ አብሌን ዮሀኑኡተ ጉዕሙ ጠዉንኩ ምሳሌን ኩለመኖሰ። <verse eid="MRK 4:11"/><verse number="12" style="v" sid="MRK 4:12"/>ህካን እኮቤቺሃ</para>
  <para style="q1" vid="MRK 4:12">« ‹እሰ መገን አደ ፈንቀልቶ እቃ</para>
  <para style="q2" vid="MRK 4:12">መገኑ ጩብሰ አጉረኖሰ እቅ፤</para>
  <para style="q1" vid="MRK 4:12">ጠው እኮጎሬ እሰን ለአን ለኦኢሃ ደጋበአ፤</para>
  <para style="q2" vid="MRK 4:12">ህትን ሞጮጭተን ሰዉ ይት ኣእታበአ› » ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">4፥12 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">ኢሳ. 6፥9-10</ref>።</char></note><verse eid="MRK 4:12"/></para>
  <para style="s1">ዉጣንች ምሳሌ ፍሳረተ</para>
  <para style="r">(<ref loc="MAT 13:18-23">ማቶ. 13፥18-23</ref>፤ <ref loc="LUK 8:11-15">ሉቃ. 8፥11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13"/>ኢስን «ክዕኔሃ ት ምሳልት ኣጎህዕኔበእንዶ? ህከረ ዎልት ምሳልተ ሀት አቴን አጥራመቶኖተ አታልቴነን? <verse eid="MRK 4:13"/><verse number="14" style="v" sid="MRK 4:14"/>ዉጠኖሁ መገን ላገተ ኩለኖሃን። <verse eid="MRK 4:14"/><verse number="15" style="v" sid="MRK 4:15"/>ሁኩ ዎቄ ገበላን ኡቦ ዜሬቱ ለሊሰኖሁ ላገስ ሞጮጨኑሃ መነ፤ እሰን ሞጮጭቶ መገን ላገተ ሼይጣኑ አሜች ቀልብችሰ መጭ መሰኖ። <verse eid="MRK 4:15"/><verse number="16" style="v" sid="MRK 4:16"/>ህትን ሁኩ ክን አሌን ኡቦ ዜሬቱ መገን ላገት ኩለንታ ወክት ተሽቲን ደዕል ቶገኖ መነ አጉደኖ። <verse eid="MRK 4:16"/><verse number="17" style="v" sid="MRK 4:17"/>ጠዉ እኮጎሬ እሰን ወክትሃሲት ቤሉ ጠጱ ዮሰበእቤቺሃ ጠረኝት ኡርታበአ፤ ህከን ላገ መሳን መት ኦሪሸት ህከረንገ ቶቸሙ አሜቾ ወክት ደዕልት ቆዕልት ኡባአ። <verse eid="MRK 4:17"/><verse number="18" style="v" sid="MRK 4:18"/>ህትን ዎሉንገ ጭምዬ ኡት በላን ኡቦ ዜሬትጋት፤ እሰን ላገስ ሞጮጭታእሃ መነ፤ <verse eid="MRK 4:18"/><verse number="19" style="v" sid="MRK 4:19"/>ጠዉ እኮጎሬ ከን ኣዱንያ አል ሻዘነት፥ ዱንያተ ኢቱሁ ዎሉ ልግብርቹ ሄዕላቱ ቀልብሰ ኣዝ ኣግ ህከ መገን ላገተ ለንግ አፋን አቶቱዕነ ፈቆኡ። <verse eid="MRK 4:19"/><verse number="20" style="v" sid="MRK 4:20"/>ጠዉ እኮጎሬ ጡመ ኡላን ዉጠሞ ዜሬቱ ለሊሰኖሁ መገን ለገተ ሞጮጭት ቶጋእሃ መነ፤ ሁኩ መኑንኩ መቱስ ሰጁ መቱንገ ሌሃዉ ዎሉንገ ጥብተ አቶተኖ» ዬእ።<verse eid="MRK 4:20"/></para>
  <para style="s1">መብራቱ ለሊሰኖሁ ኑር ኣሲሃ እሁስ</para>
  <para style="r">(<ref loc="LUK 8:16-18">ሉቃ. 8፥16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21"/>ለንኪሃ ኢስ ፈንቀሽ «መኑ ኩራዘ አፍሲሽ ሰቀሌኖ ቤቾን አፉሹ አጉር ዛሌ ኣዜን ህከረንገ ሀንሸሪች ዎሮን አፉሸኖንዶ?<note caller="-" style="x"><char style="xo" closed="false">4፥21 </char><char style="xt" closed="false"><ref loc="MAT 5:15">ማቶ. 5፥15</ref>፤ <ref loc="LUK 11:33">ሉቃ. 11፥33</ref>።</char></note> <verse eid="MRK 4:21"/><verse number="22" style="v" sid="MRK 4:22"/>ህትን ሀኩ ማጠሞርቹ ለሉዕነ ህትን እፍሰሞርቹ ፈንተኡዕናን ፈቀኖበአ።<note caller="-" style="x"><char style="xo" closed="false">4፥22 </char><char style="xt" closed="false"><ref loc="MAT 10:26">ማቶ. 10፥26</ref>፤ <ref loc="LUK 12:2">ሉቃ. 12፥2</ref>።</char></note> <verse eid="MRK 4:22"/><verse number="23" style="v" sid="MRK 4:23"/>ሞጮጭታ መጨት ዮሲሁ ዮ ጎሬ ሞጮጩን» ዬሰ።<verse eid="MRK 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24"/>ኢስን «ሞጮጭቴነንታሃ ጉዕመንከ አገዕርዬ፤ አዕኑ ዎሎ መናን ፈረዴንተገን ክዕኔ አሌን ፈረደመኖ፤ በትሽን በርገመኖህዕኔ።<note caller="-" style="x"><char style="xo" closed="false">4፥24 </char><char style="xt" closed="false"><ref loc="MAT 7:2">ማቶ. 7፥2</ref>፤ <ref loc="LUK 6:38">ሉቃ. 6፥38</ref>።</char></note> <verse eid="MRK 4:24"/><verse number="25" style="v" sid="MRK 4:25"/>ዮስሀኒሃ ኣሰመኖስ፤ ጠዉ እኮጎሬ ዮስበእሀኒች ሁኩ ዮሲንኩ ኣአመኖስ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">4፥25 </char><char style="xt" closed="false"><ref loc="MAT 13:12">ማቶ. 13፥12</ref>፤ <ref loc="MAT 25:29">25፥29</ref>፤ <ref loc="LUK 19:26">ሉቃ. 19፥26</ref>።</char></note><verse eid="MRK 4:25"/></para>
  <para style="s1">ዜሬት ነጵ ምሳልተ</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26"/>ህከኒች ኤተሮን ኢስ «መገን ዎምነቱ ኡለ አሌን ዜሬተ ዉጦተ ፉሎ መንቹ አጉደኖ። <verse eid="MRK 4:26"/><verse number="27" style="v" sid="MRK 4:27"/>ሁኩ ዜሬተ ዉጮ መንቹንኩ ሀንከዕርተ ኦሰአኖ፤ ሶዦ ወክት ኦሶች ኬአኖ፤ ሁኩ ዉጠሞ ዜሬቱ ሀት እሀኖጎሬ ዳጎኑዕናን ሙች ነጰኖ። <verse eid="MRK 4:27"/><verse number="28" style="v" sid="MRK 4:28"/>ኡለት ገይንትሴ ህከ ሙተ ነስታአ፤ ህከኒች ኤተሮን ሀበረ ኤበኖገ አታአ፤ ህከ ሀበረ ነስቶች ኤተሮን አቶተ አቶተኖገ አታአ። <verse eid="MRK 4:28"/><verse number="29" style="v" sid="MRK 4:29"/>ዉጠት ኢልቶ ወክት ወክቱስ ዉጠተ ጭም አኤኖ ወክት እኮቤቺሃ መንቹስ ዘዘረተ ቅጥ አዕይ ምደኖ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">4፥29 </char><char style="xt" closed="false"><ref loc="JOL 3:13">ኢዩ. 3፥13</ref>።</char></note><verse eid="MRK 4:29"/></para>
  <para style="s1">ዎንጌ ዜሬት ምሳልተ</para>
  <para style="r">(<ref loc="MAT 13:31-34">ማቶ. 13፥31-34</ref>፤ <ref loc="LUK 13:18-19">ሉቃ. 13፥18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30"/>ኢስን «መገን ዎምነቱ መርቺን ቅጥ አዕናም? ህትን መ ምሳሌን ሂርን ጠወዕናም? <verse eid="MRK 4:30"/><verse number="31" style="v" sid="MRK 4:31"/>መገን ጄነቱ ዎንጌ እልተ አጉዳአ፤ እሴን ዉጠንታ ወክት ኡለ አሌን ዮ ዜሬቲች ጉዕሚችን በትስ ቀዎታን። <verse eid="MRK 4:31"/><verse number="32" style="v" sid="MRK 4:32"/>ጠዉ እኮጎሬ ሁኩ ዜሬቱንኩ ዉጠሞች ኤተሮን ነጵ ጋሮን ካሴመሀኒች ጉዕሚችን በተአኖሃ አሀኖ፤ ቅራዕሩ ሀመ ነሰኖ፤ ህካን እኮቤቺሃ ሰሜ ጪኡት ምኒ መክስ እስ አሌን ሄኣኣ» ዬሰ።<verse eid="MRK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33"/>ኢስን መኑ ሰውዩ አታልታገ ካን አጉዳ ልግቤ ምሳሌን ላገስ ኩለኖሳት እቅ። <verse eid="MRK 4:33"/><verse number="34" style="v" sid="MRK 4:34"/>እስን ምሳልት ዮበኢሃ መቱርቹሃ ጠወዕዮሰበአ፤ ጠዉ እኮጎሬ እስን አሳባን ሀለኘሰ ሄኦ ወክቴን ጉዕመርቹንከ ሂር ኩለኖሰ እቅ።<verse eid="MRK 4:34"/></para>
  <para style="s1">ኢስ ዊ ሁለ ጨለ አኡስ</para>
  <para style="r">(<ref loc="MAT 8:23-27">ማቶ. 8፥23-27</ref>፤ <ref loc="LUK 8:22-25">ሉቃ. 8፥22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35"/>ህከ በር ሀዎሬ ወክት ኢስ አሳበስ «ከን ሎረ ዊች ዉድ አደ ቶልኖ» ዬሰ። <verse eid="MRK 4:35"/><verse number="36" style="v" sid="MRK 4:36"/>እሰን ህከኔ ዮ መነ አጉርት ኢስ ዮ ጀልባን ኣግ ኢሰ ኣእት መርቶኡ፤ ህከ ወክትንከ ዎሉ ጀልቡ እሳን ሜጡበ ሄዕዮ እቅ። <verse eid="MRK 4:36"/><verse number="37" style="v" sid="MRK 4:37"/>ድንገቴን ጠረኙ ቦብሩ ዊ አሌን ኬዕዮ፤ ዊ ሁሉንኩ ጀልበ ካጰለከ ከበ ሀንበለን ዊ ጀልብ ኣዜን ዊሞተ እኮ። <verse eid="MRK 4:37"/><verse number="38" style="v" sid="MRK 4:38"/>ህከ ወክትንከ ኢስ ጀልብ ኣዜን ኤተር አዲን ቦርከዕይ ግሾ እቅ፤ አሳበስ እሱ ግሰኛች በቅአት «አስተማርቾ! ነኡ በዕነን አት ሀት ጨለ ይቶንት?» ይቶስ።<verse eid="MRK 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39"/>እስን ኬዕይ ቦብረንከ ሻቆ፤ ዊ ሁለንከ «ጨለይ» ዬእ፤ ቦብሩንኩ አጉሮ፤ አበንከ ጨለ ዬእ። <verse eid="MRK 4:39"/><verse number="40" style="v" sid="MRK 4:40"/>ኢስን «ሚሃት ዋጅቴነንታሁ? ቴሁ አመዕነቱ ዮህዕኔበእንዶ?» ዬሰ።<verse eid="MRK 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41"/>እሰን አበ ዋጅት መት-መቱሰ «ጠረኙ ቦብሩለከ ዊ ሁሉ አዘዘመኖሲሁ ኩን ሀትናሙወ መንቹ?» የቀንቶኡ።<verse eid="MRK 4:41"/></para>
  <chapter eid="MRK 4"/>
  <chapter number="5" style="c" sid="MRK 5"/>
  <para style="s1">ኢስ ዱሪን አፈንቶ ለሙ መነ ፈይሱስ</para>
  <para style="r">(<ref loc="MAT 8:28-34">ማቶ. 8፥28-34</ref>፤ <ref loc="LUK 8:26-39">ሉቃ. 8፥26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1"/>ህከኒች ኤተሮን ኢስ አሳባንተስን ገሊለ ባረ ቶልት «ጌርጌሴኖነ» ዬኖ ባዱ ኢልቶኡ። <verse eid="MRK 5:1"/><verse number="2" style="v" sid="MRK 5:2"/>ኢስ ጀልቢች ፉሎገን ዶሮረኖ አያኑ አፋንስ ሎደቤቾን ሄአኖ መንቹ ወክትንከስ ህከን አዲች ፉል ደቀሞስ። <verse eid="MRK 5:2"/><verse number="3" style="v" sid="MRK 5:3"/>ሁኩ መንቹንኩ ሎደ ኣዜን ሄአኖ እቅ፤ ህከ ወክት አዪሁ እሱ ሰንሰለቲን ኡሱሮተ አታለኖበአ እቅ። <verse eid="MRK 5:3"/><verse number="4" style="v" sid="MRK 5:4"/>ልግብ ወክት አንገስለከ ሎከስ ኡሱሬኖ ወክት እስ ህካን ጉዕመንከስ ሙረንሰኖ እቅ፤ ህካን እኮቤቺሃ አዪሁ እሱ አፍ ኡሱሮተ አታለኖበአ። <verse eid="MRK 5:4"/><verse number="5" style="v" sid="MRK 5:5"/>ህትን እስ ጉዕመ ወክት ሀዎሩተለከ በራሃ ሎዱለከ ቆተቲ ዮቤቾን ዘሀን አልስ ክኒን ሀንፈጠን ያረኖ እቅ።<verse eid="MRK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6"/>እስን ኢሰ ቄዕራሻን ለዕዮ ወክት ደጉጅ አሜች ብሬስ ጉልጵ ሰገጆ። <verse eid="MRK 5:6"/><verse number="7" style="v" sid="MRK 5:7"/>ህትን ሎረ ላጋን ያረን «አት ጉዕሚችን ሎረ መገን ቤቶ ኢሰ! ኤሳለከ ኬሳሃ ም ደቀንሹ ዮኔ? አን ኪች መገኖን መገኝዮንኬ ቤሶቴኤ» ዬእ። <verse eid="MRK 5:7"/><verse number="8" style="v" sid="MRK 5:8"/>ህት ዮተ አታሎንኩ ኢስ «ኩ ዶሮርታንት ዱሩ ከን መንቺች ፉል» ይ አዘዦቤቺሃት እቅ።<verse eid="MRK 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9"/>ኢስን ሱዕሙክ አዬት? ይ ጠዕሜስ፤ እስን «ናኡ ልግብ እንኮምቤቺሃ ሱዕሙኤ ሌጌዎኔት»<note caller="+" style="f"><char style="fqa" closed="false">ሌጌዎኔ፦ </char><char style="ft" closed="false">ዩ ጎጎተ ህከረንገ ልግብ ዩሃን።</char></note> ይ ፈንቀሼእ።<verse eid="MRK 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 5:10"/>እስን ህከን ባዲች ፉሽ ሸረኖሰበእገ ኢሰ ጠረኝሽ ኡጬስ።<verse eid="MRK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11"/>ህከን ቆሮ መዴን ልግቡ ቦኬ መሰረት ዘግ ይት እታኢት እቅ። <verse eid="MRK 5:11"/><verse number="12" style="v" sid="MRK 5:12"/>ሁኩ ዶሮረኖ አያኑንኩ «ሀዕይ ህከን ቦኬ መሰራን ኣንጋምገ አእኔ» ይት ኢሰ ኡጭቶስ። <verse eid="MRK 5:12"/><verse number="13" style="v" sid="MRK 5:13"/>ኢስ «መርቴን ኣጌ» ዬሰ፤ ሁኩ ዶሮረኖ አያኑ ህከን መንቺች ፉልት ቦኬ መሰራን ኣጎኡ፤ ህከኒች ኤተሮን ለምተ ኩምተ እካ ቦኬ መሰረት ቆሮ መዲች ደጉደን ሎረ ባራን ኣአንቶኡ።<verse eid="MRK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14"/>ህከን ቦኬ ዜማኑት ሁንት ከተማንለከ ህከን ባዶን ሄአኖ መኒሃ ጠወስ ኩልቶኡ፤ መኑንኩ እኮ ጠወ ለኦተ አሜቶኡ። <verse eid="MRK 5:14"/><verse number="15" style="v" sid="MRK 5:15"/>እሰን ኢስበ አሜት ዶሮረኖ አያኑ አፎስሃ፥ ሌጌዎንን ሄዕዮስ መንቹ ፈይ ኦድኑተ ኦደዕይ አፉዕልያን ለኦ ወክት ጉዕሙንኩሰ ዋጅቶኡ። <verse eid="MRK 5:15"/><verse number="16" style="v" sid="MRK 5:16"/>ኢስ ዶሮረኖ አያነ ህከን መንቺች ፉሸንለከ ዶሮረኖ አያኑንኩ ቦኬን ኣገን ወዕና ህከን ቤቾን ሄእ ለኦሩ እኮ ጠወ ጉዕመንከ መኒሃ ኩልቶኡ።<verse eid="MRK 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 5:17"/>ህካን እኮቤቺሃ ህከን ባድ መኑ ኢስ ህከን ባዲች ፉል ኦሮአኖገ ኡጭቶስ።<verse eid="MRK 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18"/>ኢስ ጀልባን ኣገን ሩሃንዩ አፋንስ ፈዬ መንቹ ኢሰ «አን ኪን ሜጡበ ኦሮኣም» ይ ኡጨስ።<verse eid="MRK 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 5:19"/>ጠዉ እኮጎሬ ኢስ «ኢን ሜጡበ መርታንትበአ፤ ምንክ መርት ቀርቹ ሄንከ ሎረ ጠወ አዕዮሄ ጎሬ ህትን ሀት አዕይ ፈይሾሄጎሬ ምንክ መኒሃለከ እልሀክ ጠወእ» ዬስ።<verse eid="MRK 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 5:20"/>ሁኩ መንቹ ኢስ አዕዮስ ጠወ «ቶኑ ከተመ» ዬኖ ባዶን ጉዕማንን አዋጁ ጃመሮ፤ ጠወስ ሞጮጭቶ መኑ ጉዕሙንኩ አጀብሲጭቶኡ።<verse eid="MRK 5:20"/></para>
  <para style="s1">ኢያኢሮሴ ጩልተለከ ኢስ ኦድኑተ ኡልቶ መንቹተ</para>
  <para style="r">(<ref loc="MAT 9:18-26">ማቶ. 9፥18-26</ref>፤ <ref loc="LUK 8:40-56">ሉቃ. 8፥40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21"/>ኢስ ጀልባን ኣግ ባር ዉድ አደ ፈንቀል ቶሎገን ልግቡ መኑ እስ መዴን ጭምዬእ፤ ህከ ወክት ኢስ ባር መዴን ሄዕዮ እቅ። <verse eid="MRK 5:21"/><verse number="22" style="v" sid="MRK 5:22"/>ህከኔ ጭምት ምኒ ገሽታሀኑኡች መቱስ «ኢያኢሮሴ» ዬኖ መንቹ አሜች ኢሰ ለዕዮ ወክት ሎከስ አሌን ኡብ <verse eid="MRK 5:22"/><verse number="23" style="v" sid="MRK 5:23"/>«ኢ ቀዉት ጩልኤ አበ ጥዞኡ፤ አት አሜት ጡምቶተለከ ፎልን ሄኦተ እሴ አሌን አንገክ አእ» ይ ኢሰ ጠረኝሽ ኡጨእ።<verse eid="MRK 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24"/>ኢስን እሲን ሜጡበ ኦሮዕዮ፤ ህከ ወክት ልግቡ መኑ ኢሰ አዎነን ከን አዲንለከ ካጵ አዲን ሀንበዕለንተን ሃሙ ከንት ጨነቃሲት እቅ።<verse eid="MRK 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25"/>ህከን መን በላን ቶነ ለሞ ዘማን ጌሰ ቄጉ ዱንተአንሴ ኦርጨቀንተን ሄኣ መት መንቹት ሄኦ እቅ። <verse eid="MRK 5:25"/><verse number="26" style="v" sid="MRK 5:26"/>እሴን ሐኪሚች ሐኪመ ልግብ ወክት ፈንቀላንት ዱንያሴ ጉዕመንከ ሹልቶ እቅ፤ ጠዉ እኮጎሬ ባሾሴ ቤሉ መቱርቹሃ ደግለሎሴበአ እቅ። <verse eid="MRK 5:26"/><verse number="27-28" style="v" sid="MRK 5:27-28"/>እሴን መኑ ኢስተኔሃ ጠወአኖ ዱዱቡ ሞጮጭቶቤቺሃ ሀንበዕለመኖ መን በሊን ኤተር አዲን አሜት ኦድኑስ ኡልቶኡ፤ ህካን አቶኢሁ ቀልቤንከሴ «አን እስ ኦድኑተ ኡሎም እቃ ፈያም» ይታ አመዕነቱ ሄዕዮሴ እቅ።<verse eid="MRK 5:27-28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29"/>ህከ ወክትንከ ቄጉ ዱንተኡ አጉሮሴ፤ እሴን ጥዘናችሴ ፈዩሴ ጅስሚንከሴ ደጎኡ። <verse eid="MRK 5:29"/><verse number="30" style="v" sid="MRK 5:30"/>ኢስን ወልቀት እሲች ፉልቶገ ደጎቤቺሃ መን አደ ዘህ ለዕይ «አዬት ኦድኑእ ኡሎሁ?» ይ ጠዕሜሰ።<verse eid="MRK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31"/>አሳበስ «አት ኬንኩ መኑ ሀንበዕለመን አዎነኖሄ ለአን ሀት ‹አዬት ኡሎኤሁ› ይተን» ይቶስ።<verse eid="MRK 5:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32"/>ጠዉ እኮጎሬ ኢስ ህካን አዕዮሁ አዬት ጎሬ ለኦተ ዘህ ለዕዮ። <verse eid="MRK 5:32"/><verse number="33" style="v" sid="MRK 5:33"/>ህት መንቹት እኮ ጠወ ደጎቤቺሃ ዋጅት ሁጠን ሎከስ ኡብ ክዝቡዕነ ሀንቅ እኮ ጠወ ጉዕመንከ ኩልቶኡ። <verse eid="MRK 5:33"/><verse number="34" style="v" sid="MRK 5:34"/>ኢስን እሴተ «ኢ ቤቶ አመዕነቱክ ፋይሾሄ ወገሬቲን መር፤ ጥዘናችክ ፈይ» ዬሴ።<verse eid="MRK 5:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35"/>ኢስ ህካን ጠወአን ሄዕዮገን ጭምት ምኒ ሀለቅች ምኒች ሶቀንት አሜቶ መናከት ጭምት ምኒ ሀለቅቹ «ጩልክ ሬቶኡ፤ ቴሱ አስተማርቹ ሚሃት ኦርሳንትሲሁ?» ይቶስ።<verse eid="MRK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36"/>ጠዉ እኮጎሬ ኢስ እሰ ይታ ጠወ ሞጮጭ ጭምት ምኒ ሀለቅቹ «አመዕን ቤሉ ዋጅቶት» ዬስ። <verse eid="MRK 5:36"/><verse number="37" style="v" sid="MRK 5:37"/>ህትን ኢስ ጴጥሮሴችለከ ያቁቢች፥ ያቁብ አመቤቱ ያህይ ቤሉ አዪሁ አዎኖስተ ፈቀጆበአ። <verse eid="MRK 5:37"/><verse number="38" style="v" sid="MRK 5:38"/>ኢስን ጭምት ምኒ ሀለቅች ኢያኢሮሴ ምኒ ኢሌ ወክት ህከን ምኔን መኑ ያረንለከ ኦአን ጨንጭተን ለዕዮ። <verse eid="MRK 5:38"/><verse number="39" style="v" sid="MRK 5:39"/>ኢስን ምኒ ኣግ «ሚሃት ያርቴነንታሁለከ ኦኤነንታሁ? ጩልት ግሶ ቤሉ ሬቶበአ» ዬሰ።<verse eid="MRK 5:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40"/>እሰን እሶን አበ ኦሰዕልቶኡ፤ ጠዉ እኮጎሬ እሰንተ አብል ፉሽ ጩሌ አነለከ አመተ እሲን ሜጡበ ሄኦእረ አዎንስ ጩልት ዮ ቤቹ ኣጎ። <verse eid="MRK 5:40"/><verse number="41" style="v" sid="MRK 5:41"/>ኢስን ህተን ጩሌ አንገተ አፍ «ጣሊታ ቁሚ!» ዬሴ፤ ፍሳረስ «ቴ ጩሌ ኬእ» ዩሃን።<verse eid="MRK 5:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42"/>ጩልንት ቶነ ለሞ ዘማንተ ጩል እቅ፤ ወክትንከስ ኡርት ከበለከ ካጰ እከን ፈንቀላንቶኡ፤ ህከኔ ሄኦ መኑ ከ ጠወ ለኦ ወክት አጀብሲጭቶኡ። <verse eid="MRK 5:42"/><verse number="43" style="v" sid="MRK 5:43"/>ህከ ወክት ኢስ ከ ጠወ አዬሃ ጠወኣበእገ ጠረኝሽ ኩል «ጩሌተ እታኢሃ ኣስዬ» ዬሰ።<verse eid="MRK 5:43"/></para>
  <chapter eid="MRK 5"/>
  <chapter number="6" style="c" sid="MRK 6"/>
  <para style="s1">ናዝሬት መኑ ኢሰ ቶጉ ግቡሰ</para>
  <para style="r">(<ref loc="MAT 13:53-58">ማቶ. 13፥53-58</ref>፤ <ref loc="LUK 4:16-30">ሉቃ. 4፥16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1"/>ኢስ ህከንቤቺች ፉል ገይስ ባዱ አሳባንተስን ሜጡበ አሜቾ። <verse eid="MRK 6:1"/><verse number="2" style="v" sid="MRK 6:2"/>ህከኔን ኢስ አበ በሬን ጭምት ምኔን ተማርሱ ጀመሮ፤ ህከኔ እስ ተማርሰኖሃ ሞጮጭቶ ኡመቱ አበ አጀብሲጭት ገገዉንኩሰን «ኩ መንቹ ከ ጠወሃ ጉዕመንከ ሀከኔ ደኤእ? ሀትኔ ሀይመት ኣሰንቶስ? ህትኔ አጀብሲሰኖ ጠወ አአኖሁ ሀትጎታን?» ይተን አጀብሲጭታ እቅ። <verse eid="MRK 6:2"/><verse number="3" style="v" sid="MRK 6:3"/>ህከኒች ኤተሮን «እስ ማይረመ ቤቱ አነጤቾሃበእንዶ? ያቁቤሃ፥ ዮሳ፥ ይሁዲለከ ስምዖኔሃ አመ ቤቱበእንዶ? ሜኣ አመስ ኦሱንት ከኔ ኒን ሜጡበ ዮእረበእንዶ?» ይተን ህንቅ ቶጉዕናንስ ፈቆኡ።<verse eid="MRK 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4"/>እኮጎሬ ኢስ እሰንተ «ነቢዬቹ ዎሎ ባዶን ኬዕምሴኖስ፤ ጠዉ እኮጎሬ ገይስ ባድ መኑሁ፥ ገይስ እሉለከ ገይስ ምኒ መኑ ህንቀኖስ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">6፥4 </char><char style="xt" closed="false"><ref loc="JHN 4:44">ያህ. 4፥44</ref>።</char></note><verse eid="MRK 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5"/>ህከኔ ሄኦ ቀዎ ጥዘናመ አሌን አንገተ አዕይ ፈይስቤሉ ዎሉ አጀብሲሰኖ ጠወሃ አኦተ አታሎበአ፤ <verse eid="MRK 6:5"/><verse number="6" style="v" sid="MRK 6:6"/>ጠዉ እኮጎሬ ኡመቱ አመዕንቱዕነ ፈቆቤቺሃ አበ ቦሮረንቶኡ፤ ህከኒች ኤተሮን ኢስ ቀኤች ቀእተ ዘሀን ተማርሰኖ እቅ።<verse eid="MRK 6:6"/></para>
  <para style="s1">ቶና ለሙንኩ አሳበት ተማርሲሃ ሶሀሙሰ</para>
  <para style="r">(<ref loc="MAT 10:5-15">ማቶ. 10፥5-15</ref>፤ <ref loc="LUK 9:1-6">ሉቃ. 9፥1-6</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7"/>እስን ቶነ ለሙንከ አሳበተ እስበ ገእ ለሙ ለሙ አዕይ ዶሮረኖ ዱር ፉሽታ ሹምነቱ ኣስ ሶኮሰ። <verse eid="MRK 6:7"/><verse number="8" style="v" sid="MRK 6:8"/>እስን እሰንተ «ዎቃ ሃንተን በርት ቤሉ እቴኖሃ እኮ ኢቶንከሰ ብረለከ ከረጥትተ አፋበእገ አዘዦሰ።<note caller="-" style="x"><char style="xo" closed="false">6፥8-11 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">ሉቃ. 10፥4-11</ref>።</char></note> <verse eid="MRK 6:8"/><verse number="9" style="v" sid="MRK 6:9"/>ሎካንከክዕኔ ጫዕመተ ወዕርዬ ቤሉ ለሙ ዎልት ኦድኑተ ኦደኦኖቼ» ዬሰ። <verse eid="MRK 6:9"/><verse number="10" style="v" sid="MRK 6:10"/>ህትን እስ «አዕኑ መርቴነንተ ቤቾን መቱ ምኒ ኣጌነንተ ወክት ህከ ቤቹ አጉርቴን ፉልቶኖተ ኢለ ህከን ምኔን አገሬ። <verse eid="MRK 6:10"/><verse number="11" style="v" sid="MRK 6:11"/>መርቴንተ ቤቾን ጉዕማንን ‹ሀበይ ወገሬቲን አሜቴን› ዬን ቶጉለከ ሞጮጩ ግቤመህዕኔጎሬ አዕኑ ሎከክዕኔ ትበ ህከኔ ግግሽቴን አጉርቴን ፉሌ፤ ሁኩ ትቡንኩ እሳሃ እማኘ እሀኖ» ይ ኩሎሰ።<note caller="+" style="f"><char style="ft" closed="false">ግዕዝ ሃዕሮ ወኣድ ላገት 1947 ማርቶ ዘማኔን ከተበሞሁ አማረኝ ጠሊሉ መጻፉ ከኒች ዎሮ አዲን ከተበሞሃ በርገኖ። «ሀንቅንከ ያንክዕኔ፤ ህከን ከተም ፍርዲች ሶዶምለከ ጎሞር ከተሚሃ ፍርድ በር ቆሀኖሰ።» ጠዉ እኮጎሬ ኩ ሰውቱ እኮስ ግሪክ መጻፍ ኣዜኒ ደገመኖበአ።</char></note><verse eid="MRK 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12"/>እሰን መርት መኑ ጩብችሰ ፈንቀልት ቶበታገ ዱዱብስቶኡ። <verse eid="MRK 6:12"/><verse number="13" style="v" sid="MRK 6:13"/>ህትን እሰን ልግብ ሩሃንየ ፉሽቶኡ፤ ጥዘናመ አሌን ዘይተ ቡርተን ልግብ ጥዘናመተ ፈይሶኡ።<note caller="-" style="x"><char style="xo" closed="false">6፥13 </char><char style="xt" closed="false"><ref loc="JAS 5:14">ያቁ. 5፥14</ref>።</char></note><verse eid="MRK 6:13"/></para>
  <para style="s1">ጠመቃንቹ ያህይ ሼመስገ</para>
  <para style="r">(<ref loc="MAT 14:1-12">ማቶ. 14፥1-12</ref>፤ <ref loc="LUK 9:7-9">ሉቃ. 9፥7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14"/>ኢስ ሱዕሙ ጉዕመ ባዶንን ደገሞቤቺሃ ዎሙ ሄሮድስ እስተኔሃ ሞጮጬእ፤ ህትን መት-መቱ መኑ «ጠመቃንቹ ያህይ ሬሆች ኬዕዮኡ፤ ህካን እኮቤቺሃ ከ አጀብሲሰኖ ጠወ አአኖ ወልቀተ ደኤእ» ይታ እቅ።<verse eid="MRK 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15"/>ዎሉ መኑ «እልያሴት» ይታኢት እቅ፤ ህትን ፈቆ መኑ «ሄጭት ሄኦ ነቢያኖች መትስጋት» ይታ እቅ።<note caller="-" style="x"><char style="xo" closed="false">6፥15 </char><char style="xt" closed="false"><ref loc="MAT 16:14">ማቶ. 16፥14</ref>፤ <ref loc="MRK 8:28">ማር. 8፥28</ref>፤ <ref loc="LUK 9:19">ሉቃ. 9፥19</ref>።</char></note><verse eid="MRK 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16"/>ጠዉ እኮጎሬ ሄሮድስ ህካን ጉዕመንከ ሞጮጭ «አን ጎበስ ሙርሲሾም ጠመቃንቹ ያህይ ሬሆች ኬዕዮኡ» ዬእ።<verse eid="MRK 6:16"/></para>
  <para style="p">
    <verse number="17-18" style="v" sid="MRK 6:17-18"/>ሄሮድስ አመስ ቤት ፍልጶሴ ጫተ ሄሮድያደ ኣኤቤቺሃ ያህይ «አመክ ቤት ጫተ አኡ ኬሳሃ ፈቀደሞሄበአ!» ይ ጠወዕዮቤቺሃ ሄሮድስ ሶክ አፍሲሽ ያህይ ኡሱርሲሾ እቅ።<note caller="-" style="x"><char style="xo" closed="false">6፥17-18 </char><char style="xt" closed="false"><ref loc="LUK 3:9-20">ሉቃ. 3፥9-20</ref>።</char></note><verse eid="MRK 6:17-18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19"/>ህካን እኮቤቺሃ ሄሮድያዳ ያህይን ገዱተ አፍ ሽሲሶስተ ሀሳኢት እቅ፤ ጠዉ እኮጎሬ ሽሲሶስተ አታልቶበአ። <verse eid="MRK 6:19"/><verse number="20" style="v" sid="MRK 6:20"/>መሰንትስ ያህይ ፈየ መንቹለከ ጠሊለ መገን መንቹ እሁስ ሄሮድስ ደገኖቤቺሃ ዋጅ አገረኖስ እቅ፤ ህትን እስን ያህይ ጠወአኖ ጠወ ሞጮጬ ወክት ባበኖ እቅ፤ ጠዉ እኮጎሬ ሙንደዕይ ሞጮጨኖስ እቅ።<verse eid="MRK 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21"/>ሄሮድስን እለሞ በሬ ከበጃት ከበጂሃ ባድ ገሻኑተለከ ገሊለ ሎርሎረ መነ ጉዕመንከ ድግሰ ድግሽ ገኤእ፤ ሁኩ በሩ ሄሮድያደ ያህይ ሽሲሶስተ መኩተ እኮሴ። <verse eid="MRK 6:21"/><verse number="22" style="v" sid="MRK 6:22"/>ህከ በርንከ ሄሮድያዳ ቤቱት መኑ ጭምዬ ምኒ ኣግ ቦሎቸ ከደን ሄሮድሴለከ እሲን ሜጡበ ሄዕዮ ኮሀ ሙንዲሲሶኡ፤ ህካን እኮቤቺሃ ዎሙ ህተ ጩልተ «አት ኢትታንት ጉዕመንከ ጠዕሜኤ፤ ኣሳንኬ» ዬሴ። <verse eid="MRK 6:22"/><verse number="23" style="v" sid="MRK 6:23"/>«ሆሮ ዎምነትኤ ደሩ እኮጎሬ አት ይቶንቲሃ ጉዕመንከ ኣሳንኬ» ይ ጤሌዕሌእ።<verse eid="MRK 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24"/>እሴን አመሴቤቹ መርት «መ ኣሴኤ ዩ?» ይት አመሴ ጠዕምቶ ወክት « ‹ጠመቃንቾ ያህይ ቡዕለ ኣሴኤ› ይ» ይቶሴ።<verse eid="MRK 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25"/>ጩልንት ደዕልት ወምበ ኣግ «ጠመቃንቾ ያህይ ቡዕለ ሳናን አኤን ቴሱ ኣሶኖኤተ ሀሳም» ይቶኡ።<verse eid="MRK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26"/>ዎሙ ህከን ጠዋን አበ ሻዦ፤ እሁን ቤሉ ጤሌዕሌቤቺሃለከ እሲን ሜጡበ ሄኦ ኮህተኔሃ ጠዕምቶኢሀ ከሞተ ሀሾበአ። <verse eid="MRK 6:26"/><verse number="27" style="v" sid="MRK 6:27"/>ህካን እኮቤቺሃ ህከ ወክት ዎሙ ወታደሪች መቱ ያህይ ቡዕለ ሙር ኤበኖገ ኡሱር ምኒ ሶኮ፤ ወታደርቹንኩ ኡሱር ምኒ መር ያህይ ቡዕለ ሙሮ። <verse eid="MRK 6:27"/><verse number="28" style="v" sid="MRK 6:28"/>ሙር ኤቦ ቡዕለንከ ጩሌተ ሳናን አዕይ ኣሴሴ። ጩልንት መስት አማተሴ ኣቶኡ። <verse eid="MRK 6:28"/><verse number="29" style="v" sid="MRK 6:29"/>ያህይ አዎንታእሩ ህከን ሞጮጭት ኡሱር ምኒ አሜት ጀናዘስ መስት ሞጎኡ።<verse eid="MRK 6:29"/></para>
  <para style="s1">ኢስ ኦንቶ ኩሜ መኒሃ እትሱስ</para>
  <para style="r">(<ref loc="MAT 14:13-21">ማቶ. 14፥13-21</ref>፤ <ref loc="LUK 9:10-17">ሉቃ. 9፥10-17</ref>፤ <ref loc="JHN 6:1-14">ያህ. 6፥1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30"/>ሶቀማኑት ሶሀንቶ አዲች ፈንቀልት ኢስ ብሬን ጭምይቶኡ፤ ተማርስቶኢሃለከ አቶኢሃ ጉዕመንከ እሲሃ ኩልቶኡ። <verse eid="MRK 6:30"/><verse number="31" style="v" sid="MRK 6:31"/>ኢስን እሰንተ «አዕኑ ሜጥሃክዕኔ መርቴን መኑ ዮበእቤቾን ቀዉ ጌሰ ፎሎጭዬ ዬሰ» ህካን ዬኢሁ እስበ አሜተኖሁለከ መረኖሁ ልግብ እኮቤቺሃ እቸተ እታ ወክቱ ዮሰበእቤቺሃት እቅ። <verse eid="MRK 6:31"/><verse number="32" style="v" sid="MRK 6:32"/>ህካን እኮቤቺሃ እሰ ሜጥሀሰ ጀልባን ኣግ መኑ ዮበእቤቹ መርቶኡ።<verse eid="MRK 6:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33"/>ጠዉ እኮጎሬ እሰ መርተንን ልግቡ መኑ ለዕይ እሰተ እሁሰ ደግ ከተሚች ጉዕሚችን ደዕልት ፉልት ሎካን ደጉደን ሄጭት ቤቹስ ኢልቶኡ። <verse eid="MRK 6:33"/><verse number="34" style="v" sid="MRK 6:34"/>ህከን ቤቾን ኢስ ጀልቢች ድረን ልግብ መነ ለዕዮ፤ መኑንኩ ዜማንቹ ዮሰበእ ሆለገ እካን ለዕይ አበ መረርሲጬሰ፤ ህከኔን ልግብ ጠወ ተማርሱ ጀመሮ።<note caller="-" style="x"><char style="xo" closed="false">6፥34 </char><char style="xt" closed="false"><ref loc="NUM 27:17">ዘኁ. 27፥17</ref>፤ <ref loc="1KI 22:17">1 ነገ. 22፥17</ref>፤ <ref loc="2CH 18:16">2 ዱዱ. 18፥16</ref>፤ <ref loc="EZK 34:5">ሕዝ. 34፥5</ref>፤ <ref loc="MAT 9:36">ማቶ. 9፥36</ref>።</char></note> <verse eid="MRK 6:34"/><verse number="35" style="v" sid="MRK 6:35"/>ህከኔን ኡለት ሀዎርቶቤቺሃ አሳበስ እስበ ሆንጠክ «ዮም ቤቹ ኡድመሃን፤ ወክቱስ ሀዎርዮኡ፤ <verse eid="MRK 6:35"/><verse number="36" style="v" sid="MRK 6:36"/>ህካን እኮቤቺሃ እታኢሁ ዮሰበእቤቺሃለከ ከን ቀኤን ዮ ገጠረለከ ኦሎሃ መርት እቸተ ገይሃሰ ህዕርታገ ከ መነ ህርሲስ» ይቶኡ።<verse eid="MRK 6:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37"/>ጠዉ እኮጎሬ ኢስ እሰንተ «ኩ መኑ እታኢሃ አዕኑ ኣስዬሰ» ዬሰ፤ እሰን «ህካን እኮች እታኢሃ ለሜ ጥቤ ዲናሪን<note caller="+" style="f"><char style="fqa" closed="false">መቱ ዲናሩ፦ </char><char style="ft" closed="false">መቶ በሬ ሆጉተ አኤን ደኤኖ ዋግሃ ጌሰ።</char></note> ህዕርን ኣስኖሰንዶ?» ይቶኡ።<verse eid="MRK 6:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38"/>ኢስን ፈንቀሽ «ህንዴ ሄንኩ ጣብቱ ዮህዕኔጎሬ መርቴን ለእዬ» ዬሰ፤ እሰን መርት ለእ «ኦንቱ ጣብቱለከ ለምት ቁርጩሜት ዮኔ» ይቶኡ።<verse eid="MRK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39"/>ኢስን አሳበስ መነ ለቶ ህጤ አሌን ቤቾን ቤቾን አፉሽታገ አዘዦሰ። <verse eid="MRK 6:39"/><verse number="40" style="v" sid="MRK 6:40"/>ህካን እኮቤቺሃ መኑስ መት መቶ ቤቾን ጥብተ ጥብተ ህትን መት-መቶ ቤቾን ኦንታሁ ኦንታሁ እክ አፉዕልቶኡ። <verse eid="MRK 6:40"/><verse number="41" style="v" sid="MRK 6:41"/>ኢስን ኦንቱ ጣብታለከ ለም ቁርጩሜተ ኣእ ሰማ ዋሽ ለዕይ መገኑ ገለትጬእ፤ ህከኒች ኤተሮን ጣብተንከ ቢጭ መኒሃ ሆንጠህሶተ አዎንታሀኑኡተ ኣሴእ፤ ህትን ለም ቁርጩሜተ መኒሃ ጉዕሚንከ ቤኮ። <verse eid="MRK 6:41"/><verse number="42" style="v" sid="MRK 6:42"/>መኑ ጉዕሙንኩ እች ዱቦ። <verse eid="MRK 6:42"/><verse number="43" style="v" sid="MRK 6:43"/>አሳበንት መን ብሬች ፈቆ ፉርፉሩለከ ቁርጩሜች ፈቆሃ ቶነ ለሙ ሳጠራ ዊሞሃ ኬሶኡ። <verse eid="MRK 6:43"/><verse number="44" style="v" sid="MRK 6:44"/>እቸተ እቾ ጎን ዎሊንሹ ኦንቶ ኩሜ መነ እቅ።<verse eid="MRK 6:44"/></para>
  <para style="s1">ኢስ ባር አሌን ሃሙስ</para>
  <para style="r">(<ref loc="MAT 14:22-33">ማቶ. 14፥22-33</ref>፤ <ref loc="JHN 6:15-21">ያህ. 6፥15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45"/>ህከ ወክት ኢስ መነ ህርሲሰን አሳበስ ጀልባን ኣግ ዉድ አደ «ቤተ ሳይዳ» ዬኖቤቹ እሱ ሄጭት መርቶተ አዘዦሰ። <verse eid="MRK 6:45"/><verse number="46" style="v" sid="MRK 6:46"/>እስ መነ ህርሲሾች ኤተሮን ዱአ አኦተ ቆተ አል ፉሎ። <verse eid="MRK 6:46"/><verse number="47" style="v" sid="MRK 6:47"/>ኡለት ሀዎርቶ ወክት ጀልቡንኩ ባር በላን ሄዕዮ እቅ፤ ጠዉ እኮጎሬ ኢስ ሜጥሀስ ኡለ አሌን ሄዕዮ እቅ። <verse eid="MRK 6:47"/><verse number="48" style="v" sid="MRK 6:48"/>አሳበስ ብሬን ዊ አሌን ጠረኙ ቦብሩ ኬዕይ ጀልበ ብሬ አደ ዋሽ ሃሙ ከማን ኦርጨቀንተንን ኢስ ለዕዮሰ፤ ሁኩንን ሆንሲች ቶና ለሞ ሳኣት ጌሳን ባር ኣሌን ሃመን እሰ አዲን አሜች አጉር ህጎታት እቅ። <verse eid="MRK 6:48"/><verse number="49" style="v" sid="MRK 6:49"/>ጠዉ እኮጎሬ እስ ባር አሌን ሃመን ለእ ሀብዙላት አጉጃንሰ ያርቶኡ። <verse eid="MRK 6:49"/><verse number="50" style="v" sid="MRK 6:50"/>ጉዕሙንኩ ለኦስ ወክት ህልቆኡ፤</para>
  <para style="p" vid="MRK 6:50">ህከ ወክት ኢስ «ጠረኝዬ! አኔት! ዋጅቶኖቼ!» ዬሰ። <verse eid="MRK 6:50"/><verse number="51" style="v" sid="MRK 6:51"/>እስን ጀልብ ኣዝ እሰበ ኣጎ ወክት ቦብሩንኩ አጉሮ፤ አሳበስ ህከን ጠዋን አበ አጀብሲጭቶኡ። <verse eid="MRK 6:51"/><verse number="52" style="v" sid="MRK 6:52"/>እሰ ቀልቡንኩ ዱጆሁ ወዕና ኢስ ኦንቶ ኩሜ መኒሃ ኦንቱ ጣብተ እትሾ ጠወ ሰውዩ ሆጎቤቺሃት እቅ።<verse eid="MRK 6:52"/></para>
  <para style="s1">ኢስ ጌንሴሬጣን ጥዘናመተ ፈይሱስ</para>
  <para style="r">(<ref loc="MAT 14:34-36">ማቶ. 14፥34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53"/>ባሪች ቶልት «ጌንሴሬጠ» ዬኖ ባዱ ኢልቶኡ፤ ጀልበንከ ዊ አሊች ኡለ መድ ሆንጠህስ ኡሱርቶኡ። <verse eid="MRK 6:53"/><verse number="54" style="v" sid="MRK 6:54"/>እሰ ጀልቢች ፉልቶገን ኢሰ እሁስ መኑ ደጎ። <verse eid="MRK 6:54"/><verse number="55" style="v" sid="MRK 6:55"/>ህካን እኮቤቺሃ መኑ ህከን ቀኤን ሄዕዮ ኦሎ ጉዕመንከ ደጉደን መርት ኢስ ዮኡ ዬመ ቤቹ ጥዘናመተ ዴሲን እጅት ኤባኢት እቅ። <verse eid="MRK 6:55"/><verse number="56" style="v" sid="MRK 6:56"/>ኢስ ኦሮዕዮ ቤቹ ጉዕመንከ ቀኤች፥ ከተሚችለከ ገጠሪች ጥዘናመተ ጉዕመንከ በነቻን ኢስ መድ ሆንጠህሰን ኦድኖስ ሰኑተ ኡልቶተ ኡጭታኢት እቅ፤ ህትን ኢስ ኦድኖ ሰኑተ ኡልቶእሩ ጉዕሙንኩ ጥዘናችሰ ፈይታኢት እቅ።<verse eid="MRK 6:56"/></para>
  <chapter eid="MRK 6"/>
  <chapter number="7" style="c" sid="MRK 7"/>
  <para style="s1">አናኖ ዎገ</para>
  <para style="r">(<ref loc="MAT 15:1-9">ማቶ. 15፥1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1"/>መት-መቱ ፈርሳውትለከ ዬሩሳሌሚች አሜቶ ሕግ አስተማረት ኢስበ አሜት ጭምይቶኡ። <verse eid="MRK 7:1"/><verse number="2" style="v" sid="MRK 7:2"/>እሰን ኢስ አሳበት መት-መቱሰ አንገሰ ነጠ አቱዕነ ዩ ኣዕልቱዕነ ጣብተ እተን ለኦኡ።<verse eid="MRK 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3"/>ፈርሳውትለከ ኣይሁዱ ጉዕሙንኩ ባልቅ ዎገ አገርቶተ አንገሰ ኣዕልቱዕናን እታበአ። <verse eid="MRK 7:3"/><verse number="4" style="v" sid="MRK 7:4"/>ህትን ጌቤች ፈንቀልት አሜታ ወክት ሄጭት ኣዕልቱዕናን እታበአ፤ ኩባየለከ ጆከ፥ ናስ ምዳኑተለከ መዕነተ፥ ልግብ ህትኔ ዎገ አገርታአ እቅ።<verse eid="MRK 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5"/>ህካን እኮቤቺሃ ፈርሳውትለከ ሕግ አስተማረቲ ኢሰ «አሳበክ ባልቅ ዎገ አገሩ ግብ አንገሰ ኣዕልቱዕናን ጣብተ እታኢሁ ሚሃት?» ይት ጠዕምቶስ።<verse eid="MRK 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6"/>ጠዉ እኮጎሬ ኢስ እሳንከ ፈንቀሽ «ክዕኔተኔሃ ራጎገን አዕኑ ኩ ለዕዬኔ ይቴነንተሀኑኡተ ነቢዬቹ እስያስ ጠወዕዮገን</para>
  <para style="q1" vid="MRK 7:6">« ‹ኩ መኑ አፎንከስ ኬዕምሰኖኤት ቤሉ</para>
  <para style="q2" vid="MRK 7:6">ቀልቡስ ኢች አበ ቄዕርዮእሃን!<verse eid="MRK 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7"/>መሰንትስ መን ትዛዝ ተማርስተን ኤሳሃ ህትን ሰገዳኤት›</para>
  <para style="m" vid="MRK 7:7">የመም ከተበሞ ራጉ ሀንቅሃን።<note caller="-" style="x"><char style="xo" closed="false">7፥7 </char><char style="xt" closed="false"><ref loc="ISA 29:13">ኢሳ. 29፥13</ref>።</char></note><verse eid="MRK 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MRK 7:8"/>አዕኑ መገን ትዛዝ አጉርቴን መን ዎገ ጠረኝሴን አገርቴንታአ» ዬሰ።<verse eid="MRK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9"/>ህትን ኢስ እሰንተ «አዕኑ ክዕኔ ዎገ አገርቶኖተ መገን ትዛዝ አጉርቴንታአ። <verse eid="MRK 7:9"/><verse number="10" style="v" sid="MRK 7:10"/>ሙስ ‹አነክለከ አመክ ከበጅ፤ ህትን አዪሁ አንስ ህከረንገ አመስ አሌን ሂለ ጠወ ጠወአኖኦሁ ሬሁን› ይ አዘዦ።<note caller="-" style="x"><char style="xo" closed="false">7፥10 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ፉል. 20፥12</ref>፤ <ref loc="EXO 21:17">21፥17</ref>፤ <ref loc="LEV 20:9">ሌዌ 20፥9</ref>፤ <ref loc="DEU 5:16">ዘዳ. 5፥16</ref>።</char></note> <verse eid="MRK 7:10"/><verse number="11" style="v" sid="MRK 7:11"/>ጠዉ እኮጎሬ አዕኑ መቱ መንቹ አነስ ህከረንገ አመስ ‹አኒሃስለከ አማተስ አኡ ሀስሰኖ ጠወ ጉዕመንከ መገኒሃ ኣስዮም› ዬህዕኔጎሬ <verse eid="MRK 7:11"/><verse number="12" style="v" sid="MRK 7:12"/>አነስ ህከረንገ አመስ ደግለሎበአ ዬን ጠዕሜኖስበአ። <verse eid="MRK 7:12"/><verse number="13" style="v" sid="MRK 7:13"/>ከን ሃሌን ገይክዕኔ ዎገ አገርቶኖተ መገን ላገተ ድጅቴነንታት፤ ህትን አዕኑ ህትኔ ልግብ ጠወ አቴነንታት» ዬሰ።<verse eid="MRK 7:13"/></para>
  <para style="s1">መነ ንጃስሰኖ ጠወ</para>
  <para style="r">(<ref loc="MAT 15:10-20">ማቶ. 15፥10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14"/>ኢስ ለንኪሃ ኡመትስ እስበ ገእ «አዕኑ ጉዕሙንኩክዕኔ አን ጠወአንክዕኔ ጠወ አጥራመቴን ቶጌ። <verse eid="MRK 7:14"/><verse number="15" style="v" sid="MRK 7:15"/>መንቹ ንጃስሰኖሁ ኣዚች ፉለኖሃ ጠወ ቤሉ አብሊች ኣዝ ኣገኖሁ መነ ንጃስሰኖበአ» <verse eid="MRK 7:15"/><verse number="16" style="v" sid="MRK 7:16"/>[ሞጮጭታ መጨት ዮሲሁ አዪሁ ሞጮጩን] ዬእ።<note caller="+" style="f"><char style="fqa" closed="false">ህትን ሞጮጭታ መጨት ዮሲሁ ዮ ጎሬ አዪሁ ሞጮጩን፦ </char><char style="ft" closed="false">የኖሃ ከ ዎልንሸ መት-መቱ ሉህ ክታበት ወሊንሽ 16 በርግታበአ፤ ላገስ 4፥23 ዮኢሃ አጉደኖ</char></note><verse eid="MRK 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17"/>ኢስ ኡመት አጉር ምኒ ኣጎ ወክት አሳበስ እስ ተማርሴ ምሳሌተኔሃ ሂር ኩሎሰተ ጠዕምቶስ። <verse eid="MRK 7:17"/><verse number="18" style="v" sid="MRK 7:18"/>ኢስ እሰንተ «አዕኑ ቴሁ ካን አጥራመቴን ቶጌነንተበእንዶ? አብሊች መን ጎደባን ኣገኖሁ ንጃስሰኖበእገ ደጌነንተበእንዶ? <verse eid="MRK 7:18"/><verse number="19" style="v" sid="MRK 7:19"/>መሰንትስ አፌች ጎደባን ኣግ ሹመተ እክ ፉለኖሀን ቤሉ ቀልብበ ኦሮአኖበአ» ዬሰ፤ ኢስ ህካን ዩስ እቸት ጉዕሙንኩ ነጠ ዩሃንስ።<verse eid="MRK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20"/>ለንኪሃ ኢስ «መነ ንጃስሰኖሁ መን ቀልቢች ፉለኖሃን። <verse eid="MRK 7:20"/><verse number="21" style="v" sid="MRK 7:21"/>ሁኩንን ሂሉ ሰውቱ፥ ሞጉ፥ ዝነት፥ መነ ሹ፥ <verse eid="MRK 7:21"/><verse number="22" style="v" sid="MRK 7:22"/>ጎራምመት፥ ሂለተ ሆጉተ አኡ፥ ጣንሱሁ፥ ሀሶገ እሁ፥ ምቀኞመት፥ ሄምት፥ ቦኑለከ ዋንክዕሉሁ <verse eid="MRK 7:22"/><verse number="23" style="v" sid="MRK 7:23"/>ኩን ጉዕሙንኩ ሂሉ ጠዉ መን ቀልቢች ፉለኖ፤ እስን መነ ንጃስሰኖሃን» ዬእ።<verse eid="MRK 7:23"/></para>
  <para style="s1">መቴ መንቾ አመዕነቱ</para>
  <para style="r">(<ref loc="MAT 15:21-28">ማቶ. 15፥21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24"/>ኢስ ህከንቤቺች ኬዕይ ህከ ጢሮስ ባዱ ኦሮዕዮ፤ ህከኔን መቱ ምኒ ኣግ ህከኔ ሄኡስ አዪሁ ሞጮጨኖበእገ ሀሾ፤ ጠዉ እኮጎሬ ህከኔ ማጠሞተ አታሎበአ። <verse eid="MRK 7:24"/><verse number="25" style="v" sid="MRK 7:25"/>ዶሮረኖ አያኑ አፋንሴ ጥዞ ጩልት ዮሴ መንቹት ኢስ ዱዱቡ ሞጮጭቶ ወክት እስበ አሜት ሎከስ ኡቦኡ። <verse eid="MRK 7:25"/><verse number="26" style="v" sid="MRK 7:26"/>መንቹንት ሲሮ ባዶን ፊንቃዌ አዲች ከለቀንቶእተ ግርካዊቾተ እቅ፤ እሴን ጩሌችሴ ዶሮረኖ ዱር ፉሾተ ኢሰ ኡጭቶስ። <verse eid="MRK 7:26"/><verse number="27" style="v" sid="MRK 7:27"/>ጠዉ እኮጎሬ ኢስ ህተን መንቾተ «ኦሶ እቸተ ዉሻተ ኣሱ ሀስሰኖበአ፤ ሄጭት ኦሱት እት ዱቡ ሀስሰኖ» ዬሴ።<verse eid="MRK 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28"/>ህት መንቹት ፈንቀሽት «ቀርቾ ሁኩን ሀንቅሃን፤ ጠዉ እኮጎሬ ዉሸት ኦሱት እቶ ቁኒች ኡቦ ፉርፉሩ እታአ» ይቶስ።<verse eid="MRK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29"/>ህካን እኮቤቺሃ ኢስ «ካን ጠወኦንተክ ጩሌችክ ዶሮረኖ አያኑ ፉሎኡ፤ ቴሱ ምንክ መር» ዬሴ።<verse eid="MRK 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30"/>እሴን ምንሴ ፈንቀልት መርቶ ወክት ጩሌችሴ ዶሮረኖ አያኑ ፉላን መዕነ አሌን ኦሰአን ደጎሴ።<verse eid="MRK 7:30"/></para>
  <para style="s1">ኢስ ዶንቀለከ ዱደ መንቹ ፈይሱስ</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31"/>ህትን ጢሮስ ባዲች ፉል ስዶን አዲን «ቶኑ ከተመ» ዬኖ ባዲን ህግ ገሊለ ባርበ አሜቾ። <verse eid="MRK 7:31"/><verse number="32" style="v" sid="MRK 7:32"/>ህከኔን መኑ መቱ ዶንቃለከ ዶንቀ እኮ መንቹ ኢስበ ኤቦኡ፤ እሰን ኢሰ ህከን መንች አሌን አንገስ አኦተ ኡጭቶስ። <verse eid="MRK 7:32"/><verse number="33" style="v" sid="MRK 7:33"/>ኢስ ህከ መንቹ መኒች አደ አዕይ ሜጥሀስ እሱ መስ ዙሩዕማስ ህከን መንች መጫን ኣግሾ፤ ህትን ኢስ አንጀስ ቱይ ህከን መንች አረብተ አንጋንከስ ሀጣዌእ። <verse eid="MRK 7:33"/><verse number="34" style="v" sid="MRK 7:34"/>ኢስ ሰማ ዋሽ ኦሎሽ ቀልቤስ ሻዥ ህከ መንቹ «ኤፍታህ!» ዬስ፤ ፍሳረንትስ «ሂርተእ» ዩሃን።<verse eid="MRK 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35"/>ህከ ወክትንከ መጨስ ፈንተኦኡ፤ ህትን አረብስ ሂርተኣን ጠሊሽ ጠወዕዮ። <verse eid="MRK 7:35"/><verse number="36" style="v" sid="MRK 7:36"/>ኢስን መኑ ህከ ጠወ አዬሃ ኩልታበእገ አዘዦሰ፤ እሁን ቤሉ ጠወኣበእገ ኩሎሰ ጌሰንከ ልግቤ መኒሃ ኩልቶኡ። <verse eid="MRK 7:36"/><verse number="37" style="v" sid="MRK 7:37"/>እሰን አበ አጀብሲጭት «ጉዕመንከ ጠወ ጡመገ አዕዮ፤ ዶንቃኑት ሞጮጭታገለከ ዱዳኑት ጠወኣገ አአኖ» ይቶኡ።<verse eid="MRK 7:37"/></para>
  <chapter eid="MRK 7"/>
  <chapter number="8" style="c" sid="MRK 8"/>
  <para style="s1">ኢስ ሾሌ ኩሜ መኒሃ እትሱስ</para>
  <para style="r">(<ref loc="MAT 15:32-39">ማቶ. 15፥32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1"/>ህከን ታቦን ልግቡ መኑ ጭምዬእ፤ ህከን መኒሃ እታኢሁ ዮሰበአ እቅ፤ ህካን እኮቤቺሃ ኢስ አሳበስ እስበ ገእ <verse eid="MRK 8:1"/><verse number="2" style="v" sid="MRK 8:2"/>«ኩ መኑ ኢን ሜጡበ ሰሱ በር አገርቶኡ፤ እሳንከ እታኢሁ ዮሰበእቤቺሃ አን አበ መረርሲጫንሰ። <verse eid="MRK 8:2"/><verse number="3" style="v" sid="MRK 8:3"/>ህት ጎራይቶገን ምንሰ መርታገ አዕዮንሰ ጎሬ ዎቃን አበ ሆጋአ፤ ህትን እሳችን መት-መቱሰ ቄዕራሺች አሜቶእራን» ዬሰ።<verse eid="MRK 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4"/>አሳበስ ፈንቀሽት «ህከረ ከን ኡለ ኡድማን ኬንከ መኒሃ እታኢሃ አይ ኣሶተ አታለኖ?» ይቶስ። <verse eid="MRK 8:4"/><verse number="5" style="v" sid="MRK 8:5"/>ኢስ አሳበስ ፈንቀሽ «ሄንኩ ጣብቱ ዮህዕኔ?» ይ ጠዕሜሰ፤</para>
  <para style="p" vid="MRK 8:5">እሰን ፈንቀሽት «ለመሉ ጣብቱ ዮኔ» ይቶስ።<verse eid="MRK 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6"/>ህከ ወክት ኢስ መኑ ኡለ አሌን አፉዕለኖገ አዘዦ፤ ለመለንከ ጣብተ ኣእ መገኑ ገለትጭ ቢጥ መኒሃ ሆንጠህሶተ አሳባተስ ኣሴእ፤ እሰን መኒሃ ሆንጠህሶኡ። <verse eid="MRK 8:6"/><verse number="7" style="v" sid="MRK 8:7"/>ህትን ቀዉት ቁርጩሜት ዮሰ እቅ፤ እሴንተ ኬሽ ኣእ መገኑ ገለትጭ አሳበስ መኒሃ ሆንጠህሶተ ኣሴእ። <verse eid="MRK 8:7"/><verse number="8" style="v" sid="MRK 8:8"/>መኑንኩ እት ዱባን ፈቆሃ አሳበስ ለመለ መሶበ ዊመ ፉርፉሩ ኬሶኡ። <verse eid="MRK 8:8"/><verse number="9" style="v" sid="MRK 8:9"/>ህካን እቾ መን ዎሊንሹ ሾሌ ኩሜሃ ጌሰ እቅ፤ እሰንተ ኢስ ህርስሾሰ። <verse eid="MRK 8:9"/><verse number="10" style="v" sid="MRK 8:10"/>ህከ መነ ህርሲሾች ኤተሮን ኢስ አሳባንን ሜጡበ እክ ጀልባን ኣግ «ደልማኑተ» ዬኖ ባዱ ኦሮዕዮ።<verse eid="MRK 8:10"/></para>
  <para style="s1">አጀብሲሰኖ ጠወ ለኢሃ ሆንጠኮ ጠዕምቱተ</para>
  <para style="r">(<ref loc="MAT 16:1-4">ማቶ. 16፥1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11"/>ፈርሳውት ኢስበ አሜት ሉሲሶተ «ሰሜች አጀብሲሰኖ ጠወ ለሊስኔ» ይት ኦዱ ጀመርቶኡ።<note caller="-" style="x"><char style="xo" closed="false">8፥11 </char><char style="xt" closed="false"><ref loc="MAT 12:38">ማቶ. 12፥38</ref>፤ <ref loc="LUK 11:16">ሉቃ. 11፥16</ref>።</char></note> <verse eid="MRK 8:11"/><verse number="12" style="v" sid="MRK 8:12"/>ህከ ወክት ኢስ ቀልቤስ ሻዥ «ከን ዘማን መኑ አጀብሲሰኖ ጠወ ሚሃ ሀሰኖት? ሀንቅንከ ያንክዕኔ፤ ከን ክልቀቲሃ አጀብሲሰኖ ጠዉ ኣሰመኖስበአ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">8፥12 </char><char style="xt" closed="false"><ref loc="MRK 12:39">12፥39</ref>፤ <ref loc="LUK 11:29">ሉቃ. 11፥29</ref>።</char></note> <verse eid="MRK 8:12"/><verse number="13" style="v" sid="MRK 8:13"/>እሰንተ አጉር ጀልባን ኣግ ዉድ አደ ቶሎ።<verse eid="MRK 8:13"/></para>
  <para style="s1">ፈርሳዌለከ ሄሮድሴ ራጭተ</para>
  <para style="r">(<ref loc="MAT 16:5-12">ማቶ. 16፥5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14"/>አሳበት እሀኖሰ ጌሰ ጣብተ አፉዕናን ሀብ መቱ ጣብታ አፍ ጀልብ ኣዜን ሄኦ እቅ። <verse eid="MRK 8:14"/><verse number="15" style="v" sid="MRK 8:15"/>ኢስን እሰንተ «ፈርሳዌለከ ሄሮድሴ ራጭቲች ጠረኝቴን አገዕርዬ» ይ አዘዦሰ።<note caller="-" style="x"><char style="xo" closed="false">8፥15 </char><char style="xt" closed="false"><ref loc="LUK 12:1">ሉቃ. 12፥1</ref>።</char></note><verse eid="MRK 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16"/>ህከ ወክት ገገዉንኩሰን «ህት ዩስ እቴኖሃ አንፉዕናን አሜንቶምቤቺሃት» ይት ገገዉንኩሰን ጠወኦኡ።<verse eid="MRK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17"/>ኢስን ሰውትሰ ደግ « ‹እቴኖሁ ዮኔበእቤቺሃት› ይቴን ሚሃት ሰውይቴነንታት? ቴሶ ኢለ መቱርቹሃ ደጌነንተበዕንዶ? ህከረንገ ኣገኖህዕኔበዕንዶ? ህትን ቀልቡክዕኔ ቴሶ ኢለ ዱጆዕትንዶ? <verse eid="MRK 8:17"/><verse number="18" style="v" sid="MRK 8:18"/>እልት ሄኦህዕኔገን ለኤነንተበእንዶ? ህትን መጨት ዮህዕኔገን ሞጮጭቴነንተበእንዶ? ሀት ሆሮን ሰውይቴነንተበአ?<note caller="-" style="x"><char style="xo" closed="false">8፥18 </char><char style="xt" closed="false"><ref loc="JER 5:21">ኤር. 5፥21</ref>፤ <ref loc="EZK 12:2">ሕዝ. 12፥2</ref>፤ <ref loc="MRK 4:12">ማር. 4፥12</ref>።</char></note> <verse eid="MRK 8:18"/><verse number="19" style="v" sid="MRK 8:19"/>አን ኦንቶ ኩሜ መኒሃ ኦንቱ ጣብተ ቢጭ ኣሰን ፈቆ ፉርፉሩ ሄንከ መሶበ ኬሴን?» ዬሰ፤ እሰን «ቶነ ለሞ መሶበ ዊመ» ይት ፈንቀሽቶኡ።<verse eid="MRK 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20"/>ህትን ኢስ «ለመለ ጣብተ ሾሌ ኩሜ መኒሃ ቢጭ ኣሴምሀኒች ፈቆ ፉርፉሩ ሄንከ መሶበ ኬሴን?» ዬሰ፤ እሰን «ለመለ መሶበ ዊመ» ይቶኡ።<verse eid="MRK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21"/>ህካን እኮቤቺሃ ኢስ ፈንቀሽ እሰንተ «ቴሁ አጥራመቴነንተበእንዶ?» ይ ጠዕሜሰ።<verse eid="MRK 8:21"/></para>
  <para style="s1">ኢስ ቤተ ሳይዳን ቆቀ መንቹ ፈይሱስ</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22"/>ኢስ አሳበት «ቤተ ሰይዳ» ዬኖቤቹ ኢልቶ ወክት መኑ መቱ ቆቀ መንቹ ኢስበ ኤብ አንገስ አሌስ አኦተ ኡጭቶስ። <verse eid="MRK 8:22"/><verse number="23" style="v" sid="MRK 8:23"/>እስን ህከ ቆቀ መንቹ አንገስ አፍ አዎንስ ቀኤች አብል ፉሼስ፤ ኢስን ህከን መንች እሌን አንጀ ቱይ እልስ አንጋን ሀጣው «ለአንትርቹ ዮዕንዶ» ይ ጠዕሜስ።<verse eid="MRK 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24"/>ሁኩ ቆቁንኩ ጌጥ ይ «ኤ! መነ ለኣሚት፤ ጠዉ እኮጎሬ ሃመኖ ሀቀ አጉደኖኤት» ዬእ።<verse eid="MRK 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25"/>ለንኪሃ ኢስ ህከን መንች እሌን አንገስ አዕዮ፤ ህከ ወክት መንቹስ አጥራመች ለዕዮ፤ ህትን ፈይ ጉዕመርቹንከ አጥራመች ለኡ ጀመሮ። <verse eid="MRK 8:25"/><verse number="26" style="v" sid="MRK 8:26"/>ህከኒች ኤተሮን ህከ መንቹ ኢስ «ከ ቀእተ ኣጎት<note caller="+" style="f"><char style="fqa" closed="false">ከ ቀእተ ኣጎት፦ </char><char style="ft" closed="false">የኖሃ ከ ጠወ አዬሃ ጠወኦት የኖ።</char></note> አዬሃ ከ ጠወ ጠወኦት» ዬስ።<verse eid="MRK 8:26"/></para>
  <para style="s1">ኢስ ቡረሞሃ እሁስ ጴጥሮስ ጠወኡስ</para>
  <para style="r">(<ref loc="MAT 16:13-20">ማቶ. 16፥13-20</ref>፤ <ref loc="LUK 9:18-21">ሉቃ. 9፥18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27"/>ኢስለከ አሳበስ «ፍልጶስ ቄሳረ» ዬኖ ባዶን ዮ ቀእተ መርታኢት እቅ፤ ዎቄ አሌን ሄኦገን ኢስ አሳበስ «መኑ ኤሳሃ አዬት የኖኤሁ?» ይ ጠዕሜሰ።<verse eid="MRK 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28"/>አሳበስ ፈንቀሽት «መት-መቱ መኑ ‹ጠመቃንቾ ያህዪት› የኖሄት፤ ዎሉሰንገ ‹ነብዬቹወ እልያሴት› የኖሄት፤ ህትን ዎሉ መኑ ‹ነብያኖች መቱሃስ› የኖሄት» ይቶስ።<note caller="-" style="x"><char style="xo" closed="false">8፥28 </char><char style="xt" closed="false"><ref loc="MRK 6:14-15">ማር. 6፥14-15</ref>፤ <ref loc="LUK 9:7-8">ሉቃ. 9፥7-8</ref>።</char></note><verse eid="MRK 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29"/>ኢስ ፈንቀሽ «አዕኑ ኤሳሃ አዬት ይቴነንታት?» ይ ጠዕሜሰ፤ ጴጥሮስን «አት መሲሂት» ዬስ።<note caller="-" style="x"><char style="xo" closed="false">8፥29 </char><char style="xt" closed="false"><ref loc="JHN 6:68-69">ያህ. 6፥68-69</ref>።</char></note><verse eid="MRK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30"/>ህከ ወክት ኢስ እሰንተ «አዕኑ ኢተኔሃ አዬሃ ጠወኦኖቼ» ይ ጠረኝሽ አዘዦሰ።<verse eid="MRK 8:30"/></para>
  <para style="s1">ኢስ ሬሁስለከ ኬኡስ ሄጭ ጠወኡስ</para>
  <para style="r">(<ref loc="MAT 16:21-28">ማቶ. 16፥21-28</ref>፤ <ref loc="LUK 9:22-27">ሉቃ. 9፥22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31"/>ኢስ አሳባተስ «መንች ቤቱ ልግብ ኦርሸተ ቶጉ ሀስሰኖስ፤ ህትን ባድ ባልቀት፥ ቂሳከ አዎንሳኑትለከ ሕግ አስተማረት ቶጉ ግብ ሽታስ፤ ጠዉ እኮጎሬ እስ ሰቅ በሬን ሬሆች ኬአኖ» የን ተማርሱ ጀመሮ። <verse eid="MRK 8:31"/><verse number="32" style="v" sid="MRK 8:32"/>ኢስ ህከ ጠወ ኣገኖሰገ ኩሎሰ፤ ህከ ወክት ጴጥሮስ ኢሰ መድ ዋሽ ኡሙዕሬስ። <verse eid="MRK 8:32"/><verse number="33" style="v" sid="MRK 8:33"/>ጠዉ እኮጎሬ ኢስ ኤተሩ ፈንቀል አሳበስ ለአን ጴጥሮሴ «አት ሸይጣንቹ ኢች ካጳ ቄዕር፤ አት መን ሰዉት ቤሉ መገን ሰዉት ደጋንትበአ» ይ ሻቆስ።<verse eid="MRK 8:33"/></para>
  <para style="s1">መሲህ አዎኑ ዋጋ ባትሲሰኖሃ እሁስ</para>
  <para style="r">(<ref loc="MAT 10:38-39">ማቶ. 10፥38-39</ref>፤ <ref loc="MAT 16:24-28">16፥24-28</ref>፤ <ref loc="LUK 9:23-27">ሉቃ. 9፥23-27</ref>፤ <ref loc="LUK 14:25-27">14፥25-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34"/>ህከኒች ኤተሮን ኢስ ልግብ መነ አሳባንተስን ሜጡበ እስበ ገእ «ኤሳሃ አዎኖተ ኢተኖሁ ዮ ጎሬ ገይስተኔሃ ሰውዩ አጉር መስቀለስ እጅ አዎኑዕኔ።<note caller="-" style="x"><char style="xo" closed="false">8፥34 </char><char style="xt" closed="false"><ref loc="MAT 10:38">ማቶ. 10፥38</ref>፤ <ref loc="LUK 14:27">ሉቃ. 14፥27</ref>።</char></note> <verse eid="MRK 8:34"/><verse number="35" style="v" sid="MRK 8:35"/>ነብሳስ ጡምሶተ ሀሰኖሁ ጉዕሙንኩ ነብሳስ ቤሰኖ፤ ኢተኔሃለከ ተሽት ላገተኔሃ ነብሳስ ህግሽ ኣሰኖሁ ነብሳስ ጡምሰኖ።<note caller="-" style="x"><char style="xo" closed="false">8፥35 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቶ. 10፥39</ref>፤ <ref loc="LUK 17:33">ሉቃ. 17፥33</ref>፤ <ref loc="JHN 12:25">ያህ. 12፥25</ref>።</char></note> <verse eid="MRK 8:35"/><verse number="36" style="v" sid="MRK 8:36"/>አዪሁ ኣዱንያ አሌን ዮኢሃ ጉዕመንከ ደእ ነብሳስ ቤሾ ጎሬ መ ደግለለኖስ? <verse eid="MRK 8:36"/><verse number="37" style="v" sid="MRK 8:37"/>ህትን መንቹ ነብሴስ ወጥ መ ባቶተ አታለኖ። <verse eid="MRK 8:37"/><verse number="38" style="v" sid="MRK 8:38"/>ከን ጩበኛኖንለከ ለገአኖ ክልቀት ብሬን ኢንለከ ኢ ላጋን ሙለኖ መንች ቤቱ አንስ ኬዕምኚን ጠሊላኖ መላይካን ሜጡበ አሜተኖ ወክት እሲን ሙለኖ» ዬሰ።<verse eid="MRK 8:38"/></para>
  <chapter eid="MRK 8"/>
  <chapter number="9" style="c" sid="MRK 9"/>
  <para style="s1">ኢስ ደኑ ዶረሙስ</para>
  <para style="r">(<ref loc="MAT 17:1-13">ማቶ. 17፥1-13</ref>፤ <ref loc="LUK 9:28-36">ሉቃ. 9፥28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1"/>ህከኒች ኤተሮን ኢስ «ሀንቅንከ ያንክዕኔ፤ ቴሱ ከኔ ኡርቶ መን በሊች መት-መቱሰ መገን ዎምነቱ ሎረ ወልቃን ገሸኖ ወክት ለኦተ ኢለ ሬታበእሩ ዮኡ» ዬሰ።<verse eid="MRK 9:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2"/>ሌሆ በሬች ኤተሮን ኢስ ጴጥሮሴ፥ ያቁበለከ ያህይ ሰሱንከሰ ኣእ ሎረ ቆተ አል ፉሎ፤ ህከኔን ኢስ ደኑ ብሬሰን ዶረሞ።<note caller="-" style="x"><char style="xo" closed="false">9፥2 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2 ጴጥ. 1፥17-18</ref>።</char></note> <verse eid="MRK 9:2"/><verse number="3" style="v" sid="MRK 9:3"/>ኢስ ኦድኑት ኣዱንያ አሌን አዪሁ ሜጭ ዋቅ አዕይ ዋጁ አአኖበእ ጌሰ ዋቅይት በለቆኡ። <verse eid="MRK 9:3"/><verse number="4" style="v" sid="MRK 9:4"/>ህከ ወክት እልያስለከ ሙስ አሜት ኢሲን ሜጡበ ጠወአንን ሰሱንኩ አሳበት ለኦስ። <verse eid="MRK 9:4"/><verse number="5" style="v" sid="MRK 9:5"/>ጴጥሮስ ኢሰ «አስተማርቾ! ከኔ ሄኡ ኔሳሃ አበ ጡመሃን፤ ህካን እኮቤቺሃ መቱ ኬሳሃ፥ መቱ ሙሲሃለከ መቱንገ እልያሴሃ ዳሰ እጃርኖ» ዬእ። <verse eid="MRK 9:5"/><verse number="6" style="v" sid="MRK 9:6"/>ህከ ወክት ሰሱንኩ አሳበት አበ ዋጅቶቤቺሃ ጴጥሮስ ጠወአኖሃ ደገኖበአ እቅ።<verse eid="MRK 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7"/>ጎመንት አሜት ቴልታን ጎማች ኣዚን «ኢታም ቤቱኤ ከኒት፤ እሱንከ ሞጮጭዬ» ይታ ላገተ ሞጮጨንቶኡ።<note caller="-" style="x"><char style="xo" closed="false">9፥7 </char><char style="xt" closed="false"><ref loc="MAT 3:17">ማቶ. 3፥17</ref>፤ <ref loc="MRK 1:11">ማር. 1፥11</ref>፤ <ref loc="LUK 3:22">ሉቃ. 3፥22</ref>።</char></note> <verse eid="MRK 9:7"/><verse number="8" style="v" sid="MRK 9:8"/>ወክትንከስ ሰሱንኩ አሳበት አደሰ ዘህት ለኣ ወክት እሳን ሜጡበ ኢስ ቤሉ አዪሁ ዮበአ እቅ።<verse eid="MRK 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9"/>ቆተ አሊች ድርተን ኢስ «መንች ቤቱ ሬሆች ኬኦተ ኢለ ከ ለኤንተ ጠወ አዬሃ ጠወኦኖቼ» ይ አዘዦሰ።<verse eid="MRK 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10"/>እስን ዬሰ ጠወ ቀልቤሰ አፍ «ኩ ‹ሬሆች ኬኡ› ዩ መ ዩሀን» ይት ጠዕምቶኡ። <verse eid="MRK 9:10"/><verse number="11" style="v" sid="MRK 9:11"/>እሰን ኢሰ «ሕግ አስተማረት ‹ሄጭ አሜቱ ሀስሰኖሲሁ እልያሴት› ይታኢሁ ሚሃት?» ይት ጠዕምቶስ።<note caller="-" style="x"><char style="xo" closed="false">9፥11 </char><char style="xt" closed="false"><ref loc="MAL 4:5">ሚል. 4፥5</ref>፤ <ref loc="MAT 11:14">ማቶ. 11፥14</ref>።</char></note><verse eid="MRK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12"/>እስን «ሁኩን ሀንቅሃን፤ እልያስ ሄጭ አሜች ጉዕመርቹንከ መክሰኖ፤ ጠዉ እኮጎሬ መንች ቤቱ አበ ኦርሸተ ቶገኖገለከ ህንቀመኖሃ እሁስ ጠሊለ መጻፋን ከተበሞሁ ሀትጎታን? <verse eid="MRK 9:12"/><verse number="13" style="v" sid="MRK 9:13"/>ጠዉ እኮጎሬ አን ያንክዕኔ፤ እልያስ ሄጭ አሜቾኡ፤ እስተኔንከ ጠሊለ መጻፋን ከተበሞገን መኑ ሀሶገ አቶስ» ዬሰ።<verse eid="MRK 9:13"/></para>
  <para style="s1">ዱሩ አፎስ ጩል ኢስ ፈይሱስ</para>
  <para style="r">(<ref loc="MAT 17:14-21">ማቶ. 17፥14-21</ref>፤ <ref loc="LUK 9:37-43">ሉቃ. 9፥37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14"/>ኢስለከ እሲን ሜጡበ ሄኦ ሰሱንኩ አሳበስ ፈንቀልት አሜቶ ወክት ልግቡ መኑ ፈቆ አሳባን ጭምይሃን ህከኔን መት-መቱ ሕግ አስተማረት ኢስ አሳባን ኦዳኢት እቅ። <verse eid="MRK 9:14"/><verse number="15" style="v" sid="MRK 9:15"/>መኑ ጉዕሙንኩ ኢሰ ለኦ ወክት አበ አጀብሲጭቶኡ፤ ህትን እስበ ደጉድ መርት ዝያርቶስ። <verse eid="MRK 9:15"/><verse number="16" style="v" sid="MRK 9:16"/>ኢስን አሳበስ «መ ጠዋኒት ኦዴነንታሁ?» ይ ጠዕሜሰ።<verse eid="MRK 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17"/>ህከን ልግብያ ኡመቲች መቱ መንቹ «አስተማርቾ! ዱሩ አፍ ጠወኡ ከሞ ጩልኤ ኪቤቹ ኤቦም። <verse eid="MRK 9:17"/><verse number="18" style="v" sid="MRK 9:18"/>ሁኩ ዱሩ ኬዕዮስ ወክት ኡጀኖስ፤ ህትን አፌን ሁንብ ኩፍ አአን እንኩተ እጥሲሰኖ፤ አልስ ክቺች አዕይ ሞሸኖስ፤ ህካን እኮቤቺሃ ህከ ዶሮረኖ አያነ ፉሽቶተ አሳበክ ጠዕምዮም እቅ፤ ጠዉ እኮጎሬ እሰ ፉሽቶተ አታልቶበአ» ዬእ።<verse eid="MRK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19"/>ኢስ እሰንተ «አዕኑ አመዕነቱ ዮህዕኔበእ መኑ፤ ሄንከ በር ኢለ ክዕኔን ሜጡበ ሄኣም? ሀከ በር ኢለ አታላንክዕኔ? ህንዴ ጩል ኢበ ኤቤ» ዬሰ። <verse eid="MRK 9:19"/><verse number="20" style="v" sid="MRK 9:20"/>እሰን ጩል እስበ ኤቦኡ፤ ሁኩ ዶሮረኖ ዱሩ ኢሰ ለዕዮ ወክት ጩል ኡለ አሌን ኡጅ ከጣቀንሴስ፤ ጩሉንኩ ኡለ አሌን ኮሎንኮዕለን አፎንከስ ሁንብ ኩፍ አኡ ጀመሮ። <verse eid="MRK 9:20"/><verse number="21" style="v" sid="MRK 9:21"/>ኢሲን ህከን ጩል አነ «ኩ ጥዘነት አፎሲች ሄንከ ዘማን እኮስ?» ይ ጠዕሜስ፤ እስን ፈንቀሽ «ኦስማችስ ኬሺት። <verse eid="MRK 9:21"/><verse number="22" style="v" sid="MRK 9:22"/>ኩ ዶሮረኖ ዱሩ ሾተ ሀሽ ልግብ ወክት ጊራንለከ ዋን ኡጀኖስ፤ ጠዉ እኮጎሬ መቱርቹ አኡ አታልታንት ጎር መረርሲጭኔ! ሀዕልኔሁ» ዬእ።<verse eid="MRK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23"/>ኢስን «ሀት አታልታንት ጎሬ ይታንቴኤት? አመዕነኖሀኒሃ ጉዕሙርቹንኩ አታለመኖስ» ዬስ።<verse eid="MRK 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24"/>ህከ ወክት ጩል አኑ ኢሰ «አመዕኑ አመዕናም፤ ጠዉ እኮጎሬ አመዕኑ ሆጋም ጠዊሃ ጉዕሚንከስ ቴሁ አት ሀዕሌኤ!» የን ያሮ።<verse eid="MRK 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25"/>ኢስን መኑ ደጉደን አሜተኖገ ለዕዮ ወክት ህከ ዶሮረኖ ዱር «አት ዱዱለከ ዶንቁ ዱሩ ከን ጩሊች ፉልት ለንኪ እስበ ፈንቀልት አሜታንትበእገ አዘዦንኬ» ይ ሻቆስ።<verse eid="MRK 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26"/>ሁኩ ዶሮረኖ ዱሩ ሎረ ላጋን ያር ጩል መቱ ጌሰ ኡጅ ከጣቀንሴሲች ኤተሮን ፉሎ፤ ህከ ወክት ጩሉስ ደሜቤቺሃ መኑ «ሬዮ» ይ ሰውዬእ። <verse eid="MRK 9:26"/><verse number="27" style="v" sid="MRK 9:27"/>ጠዉ እኮጎሬ ኢስ ጩል አንገተ አፍ ኬሻንስ ኬዕይ ኡሬእ።<verse eid="MRK 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28"/>ኢስ ምኒ ኣጎ ወክት አሳበስ «ነኡ ከ ዶሮረኖ ዱር ፉሽኖተ አታልናምበኢሁ ሚሃት?» ይት ሜጡስ ጠዕምቶኡ።<verse eid="MRK 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29"/>ኢስን እሰንተ «ህትናሙርቹ ዱኢንለከ ሶመኒን እህባች ዎሎርቺን ሆሮን ፉሎተ አታለኖበአ» ይ ፈንቀሼሰ።<verse eid="MRK 9:29"/></para>
  <para style="s1">ኢስ ሬሁስለከ ሬሆች ኬኡስ ለንኪሃ ጠወኡስ</para>
  <para style="r">(<ref loc="MAT 17:22-23">ማቶ. 17፥22-23</ref>፤ <ref loc="LUK 9:43-45">ሉቃ. 9፥43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30"/>ኢስለከ አሳበስ ህከ ቤቹ ጌኝአት ገሊለ አዲን ህጎኡ፤ ኢስ ዮቤቹንከ አዪሁ ደጎተ ሀሾበ እቅ፤ <verse eid="MRK 9:30"/><verse number="31" style="v" sid="MRK 9:31"/>ሁኩን እኮሁ ኢስ አሳበስ «መንች ቤቱ መን አንጋን ህግሴን ኣሴኖስ፤ እሰን ሽታስ፤ ጠዉ እኮጎሬ ሬሆች ሰቅ በር ኬአኖ» የን ተማርሴሰ።<verse eid="MRK 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32"/>አሳበስ ኩ ጠዉ ኣጎሰበአ፤ ጠዉ እኮጎሬ ጠዕምቶስተ ዋጅቶኡ።<verse eid="MRK 9:32"/></para>
  <para style="s1">ጉዕሚችን በተአኖሁ አዬት?</para>
  <para style="r">(<ref loc="MAT 18:1-5">ማቶ. 18፥1-5</ref>፤ <ref loc="LUK 9:46-48">ሉቃ. 9፥46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33"/>ኢስለከ አሳበስ ቅፍርናሆም ከተመ አሜቶኡ፤ ኢስ ምኒ ኣጎች ኤተሮን አሳበስ «ዎቃን ሄኤንተ ወክት ኦዴነንተ ጠዉ መርቹሃን?» ይ ጠዕሜሰ።<verse eid="MRK 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34"/>ጠዉ እኮጎሬ እሰ ዎቃን «ጉዕሚችኔ በተአኖሁ አዬት?» የቀንቶቤቺሃ መስለ ኣቶስበአ።<note caller="-" style="x"><char style="xo" closed="false">9፥34 </char><char style="xt" closed="false"><ref loc="LUK 22:24">ሉቃ. 22፥24</ref>።</char></note> <verse eid="MRK 9:34"/><verse number="35" style="v" sid="MRK 9:35"/>እስን አፉዕሌኢች ኤተሮን ቶነ ለሙንከ አሳበስ እስበ ገእ «ዎኔሃ እሆተ ሀሰኖሁ ጉዕሙንኩ ጉዕሚንከ ካድመለከ ጉዕሚችን ቀዉ እሁ ሀስሰኖስ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">9፥35 </char><char style="xt" closed="false"><ref loc="MAT 20:26-27">ማቶ. 20፥26-27</ref>፤ <ref loc="MAT 23:11">23፥11</ref>፤ <ref loc="MRK 10:43-44">ማር. 10፥43-44</ref>፤ <ref loc="LUK 22:26">ሉቃ. 22፥26</ref>።</char></note> <verse eid="MRK 9:35"/><verse number="36" style="v" sid="MRK 9:36"/>መቱ ቀዉ ጩል ኤብ በላንከሰ ኡርሾ፤ ህከ ጩልንከ ሀንቀፍ <verse eid="MRK 9:36"/><verse number="37" style="v" sid="MRK 9:37"/>«ከን ጩልገ ዮኢሃ ሱዕሚንከኤ ቶገኖሁ ኤሳሃ ቶገኖኤ፤ ኤሳሃ ቶገኖሁ ጉዕሙንኩ ጠለዕል ኤሳሃ ቶጉ እሁዕነ ኤሳሃ ሶኮንከ ሜጡበ ቶገኖ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">9፥37 </char><char style="xt" closed="false"><ref loc="MAT 10:40">ማቶ. 10፥40</ref>፤ <ref loc="LUK 10:16">ሉቃ. 10፥16</ref>፤ <ref loc="JHN 13:20">ያህ. 13፥20</ref>።</char></note><verse eid="MRK 9:37"/></para>
  <para style="s1">ግብበኔሁ ጉዕሙንኩ ኒንት።</para>
  <para style="r">(<ref loc="LUK 9:49-50">ሉቃ. 9፥49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38"/>ጠዉ እኮጎሬ ያህይን ኢሲሃ ፈንቀሽ «አስተማርቾ መቱ መንቹ ሱዕሚንከክ ሩሃንየ ፉሸን ለዕን ኒን ሜጡበ እክ አዎንበኔቤቺሃ ከሞንስ» ዬስ።<verse eid="MRK 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39"/>ጠዉ እኮጎሬ ኢስ «ሱዕሚንከኤ አጀብሲሰኖ ጠወ አአን ወክትንከስ ኢ አሌን ሂለርቹ ጠወአኖሁ ዮበእቤቺሃ አጉሬ፤ ከንቶኖቼስ። <verse eid="MRK 9:39"/><verse number="40" style="v" sid="MRK 9:40"/>መሰንትስ ኒን ሀንበዕለምባሁ ጉዕሙንኩ ኒንት።<note caller="-" style="x"><char style="xo" closed="false">9፥40 </char><char style="xt" closed="false"><ref loc="MAT 12:30">ማቶ. 12፥30</ref>፤ <ref loc="LUK 11:23">ሉቃ. 11፥23</ref>።</char></note> <verse eid="MRK 9:40"/><verse number="41" style="v" sid="MRK 9:41"/>ሀንቅንከ ያንክዕኔ፤ መሲህሃ እኬንተቤቺሃ ሱዕሚንከኤ መቶ ቡርጩቆ ዋሃ አጎተ ኣሰኖሁ አዪሁ ወጥስ ደአኖ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">9፥41 </char><char style="xt" closed="false"><ref loc="MAT 10:42">ማቶ. 10፥42</ref>።</char></note><verse eid="MRK 9:41"/></para>
  <para style="s1">መነ ሉስሲች ገዉ አገዕሩ</para>
  <para style="r">(<ref loc="MAT 18:6-9">ማቶ. 18፥6-9</ref>፤ <ref loc="LUK 17:1-2">ሉቃ. 17፥1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42"/>ኢስ «ኢን አመዕንቶ ከን ማዕናኖች መቱስ ሉሲሰኖ መንቹ ሎረ ሪትም ክኑ ጎባንከስ ኡሱሬን ባራን ቶረሙስ ቆሀኖ። <verse eid="MRK 9:42"/><verse number="43" style="v" sid="MRK 9:43"/>ህካን እኮቤቺሃ አንገክ ሉሲሳሄትጎሬ ሙርት ኡጅ፤ መሰንትስ ለምት አንገት ሄኣንኬ አዛቤን ዘላለሚሃ ጠዕትበ ጊራን ኣጊች አንገክ ሙርተኣን ነብሴን ሄኤን ሄኡ ደኡ ቆሀኖ። <verse eid="MRK 9:43"/><verse number="44" style="v" sid="MRK 9:44"/>ህከን ቤቾን እሰተ እታ ዘቡዕሉት ሬታበአ፤ ህትን ጊረሲ ሆሮ ጠእታበአ።<note caller="+" style="f"><char style="fqa" closed="false">አዛቡ ዘቡዕሉት ሬታበኢሁለከ ጊረስ ጠዕታበኢሃ ቤቹ፦ </char><char style="ft" closed="false">መት-መቱ ሉህ ክታበት ዎሊንሽ 44 ዮኢሃ በርግታበአ። ላገንትስ ዎሊንሽ 48 ዮኢሃ አጉዳአ</char></note><note caller="-" style="x"><char style="xo" closed="false">9፥44 </char><char style="xt" closed="false"><ref loc="MAT 5:30">ማቶ. 5፥30</ref>።</char></note> <verse eid="MRK 9:44"/><verse number="45" style="v" sid="MRK 9:45"/>ህትን ሎከክ ሉሲሳሄትጎሬ ሙርት ኡጅ፤ ለም ሎከት ሄኣንኬ አዛቤን ዘላለሚሃ ጠዕትበ ጊራን ቶሬኖሄሀኒች ድኑ እክ ነብሴን ሄኡ ደኡ ቆሀኖሄ። <verse eid="MRK 9:45"/><verse number="46" style="v" sid="MRK 9:46"/>ህከን ቤቾን እሰተ እታ ዘቡዕሉት ሬታበአ፤ ህትን ጊረሲ ሆሮ ጠእታበአ። <verse eid="MRK 9:46"/><verse number="47" style="v" sid="MRK 9:47"/>ህትን እልክ ሉሲሳሄትጎሬ ፉሽት ኡጅ፤ መሰንትስ ለም እልት ሄኣንኬ ዘላለሚሃ ጠእትቡ ጊራን ቶሬኖሄሀኒች መት እላሙ እክ መገን ዎምነቴን ሄኡ ቆሀኖሄ።<note caller="-" style="x"><char style="xo" closed="false">9፥47 </char><char style="xt" closed="false"><ref loc="MAT 5:29">ማቶ. 5፥29</ref>።</char></note> <verse eid="MRK 9:47"/><verse number="48" style="v" sid="MRK 9:48"/>ህከን አዛቤን እሰተ እታ ዘቡዕሉት ሆሮን ሬታበአ፤ ህትን ጊረንት ሆሮን ጠእታበአ።<note caller="-" style="x"><char style="xo" closed="false">9፥48 </char><char style="xt" closed="false"><ref loc="ISA 66:24">ኢሳ. 66፥24</ref>።</char></note><verse eid="MRK 9:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49"/>«ክትሙ መጥኔን ነጠ እሀኖ<note caller="+" style="f"><char style="fqa" closed="false">መጥንትለከ ጊረት ሀት እክ ነጠ እካገ፦ </char><char style="ft" closed="false">ሌዌ 2፥13 ሚል. 3፥2-3 ፊል. 3፥17 ዮኢሃ ለኡ ሀስሰኖ።</char></note> ሀንገን <verse eid="MRK 9:49"/><verse number="50" style="v" sid="MRK 9:50"/>መጥንት ጡመተ፤ እሁን ቤሉ መጥንት እሁሴ ጤእባች ሀት አቴን ጤኣገ አቴነን? ክዕኔንከ መጥኔ ጤዕንሹ ሄኡንክዕኔ፤ ገገዉንኩክዕኔ ኢተቀንቴን ወገሬቲን ሄዕዬ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">9፥50 </char><char style="xt" closed="false"><ref loc="MAT 5:13">ማቶ. 5፥13</ref>፤ <ref loc="LUK 14:34-35">ሉቃ. 14፥34-35</ref>።</char></note><verse eid="MRK 9:50"/></para>
  <chapter eid="MRK 9"/>
  <chapter number="10" style="c" sid="MRK 10"/>
  <para style="s1">ኢስ ጎጆሃ እህተኔሃ ተማርሱስ</para>
  <para style="r">(<ref loc="MAT 19:1-12">ማቶ. 19፥1-12</ref>፤ <ref loc="LUK 16:18">ሉቃ. 16፥18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1"/>ኢስ ህከንቤቺች ኬዕይ ይሁድ ባዱ ህግ ዮርዳኖስ ዛዘኖ ዊች ገርብ አዲን ቶል ኦሮዕዮ፤ ልግቡ መኑ ለንኪሃ እስበ ጭምይታን ወዕና ሮሾገን ተማርሰኖሳት እቅ።<verse eid="MRK 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2"/>ፈርሳዌች መት-መቱሰ ኢሰ ሉሲሶተ ሀስ አሜት «መቱ መንቹ ጫስ ገፈሮተ ሕግን ፈቀደመኖስንዶ?» ይት ጠዕምቶስ።<verse eid="MRK 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3"/>ኢስን ፈንቀሽ «ሙስ ከን ጠዊሃ መ አዘዦህዕኔ?» ዬሰ።<verse eid="MRK 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4"/>እሰን «ሙስ ‹እሴንከ ንከሴ ሂር ሸሩን› ይ አዘዦኔ» ይቶኡ።<note caller="-" style="x"><char style="xo" closed="false">10፥4 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">ዘዳ. 24፥1-4</ref>፤ <ref loc="MAT 5:31">ማቶ. 5፥31</ref>።</char></note><verse eid="MRK 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5"/>እኮጎሬ ኢስ እሳሃ ፈንቀሽ «ሙስዕኑ ከ ትዛዝ ከተቦተ አታሎሁ ቀልቡክዕኔ ዱጃን ሞጮጭቴነንተበእቤቺሃት ዬሰ። <verse eid="MRK 10:5"/><verse number="6" style="v" sid="MRK 10:6"/>ጠዉ እኮጎሬ መገኑ ወዕና ክልቀት ከለቆ ወክት ለባለከ ሜኣተ አዕይ ከለቆ።<note caller="-" style="x"><char style="xo" closed="false">10፥6 </char><char style="xt" closed="false"><ref loc="GEN 1:27">ክል. 1፥27</ref>፤ <ref loc="GEN 5:2">5፥2</ref>።</char></note> <verse eid="MRK 10:6"/><verse number="7" style="v" sid="MRK 10:7"/>ህካን እኮቤቺሃ መኑ አነስለከ አመስ አጉረኖ ምንስ አማን ሜጡ እሀኖ። <verse eid="MRK 10:7"/><verse number="8" style="v" sid="MRK 10:8"/>ህትን ለሙንኩሰ ሜጡ ጅስመ እካኣ፤ ህከኒች ኤተሮን እሰ ሜጡ ጅስመ እካ ቤሉ ለሙ ጅስመ እካበአ።<note caller="-" style="x"><char style="xo" closed="false">10፥8 </char><char style="xt" closed="false"><ref loc="GEN 2:24">ክል. 2፥24</ref>።</char></note> <verse eid="MRK 10:8"/><verse number="9" style="v" sid="MRK 10:9"/>ህካን እኮቤቺሃ መገኑ ሜጡ አዕዮሃ መኑ መለሉንከሰ» ዬእ።<verse eid="MRK 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10"/>እሰን ምኒ ፈንቀልት አሜቶ ወክት አሳበስ ህከን ጠውተኔሃ ፈንቀልት ኢሰ ጠዕምቶስ። <verse eid="MRK 10:10"/><verse number="11" style="v" sid="MRK 10:11"/>እስን «ጫስ ገፈር ዎሉ ሜንቱ ኣአኖሁ ጉዕሙንኩ እሴ አሌን ዝነተ አዕዮኡ።<note caller="-" style="x"><char style="xo" closed="false">10፥11 </char><char style="xt" closed="false"><ref loc="MAT 5:32">ማቶ. 5፥32</ref>፤ <ref loc="1CO 7:10-11">1 ቆሮ. 7፥10-11</ref>።</char></note> <verse eid="MRK 10:11"/><verse number="12" style="v" sid="MRK 10:12"/>ህትን ምንሴ መንቺች ፉልት ዎሉ ጎነ ኣግሶ ጎሬ እሴሁ ዝነተ አቶኡ ዩሃን» ዬእ።<verse eid="MRK 10:12"/></para>
  <para style="s1">ኢስ ኦሱተ ማሰዕዮገ</para>
  <para style="r">(<ref loc="MAT 19:13-15">ማቶ. 19፥13-15</ref>፤ <ref loc="LUK 18:15-17">ሉቃ. 18፥15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13"/>መት-መቱ መኑ እለሰ አሌን አንገተ አዕይ ማሰኦሰተ ኢስበ ኤቦኡ፤ ጠዉ እኮጎሬ አሳበስ ህከ ኦሱተ ኤቦ መነ ሻቆኡ። <verse eid="MRK 10:13"/><verse number="14" style="v" sid="MRK 10:14"/>ኢስን ህካን ለዕዮ ወክት አሳበስ ኡሙዕር «መገን ዎምነቱ ከኑኡገ ዮሀኑኡተ እኮቤቺሃ ኦሱት ኢበ አሜቱን ከንቶኖቼ» ዬሰ። <verse eid="MRK 10:14"/><verse number="15" style="v" sid="MRK 10:15"/>ኢስ «ሀንቅንከ ያንክኔ፤ መገን ዎምነቱ ኦሶገ እክ ቶግባሁ መገን ዎምነቱ ኣጎተ ሆሮ አታለኖበአ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">10፥15 </char><char style="xt" closed="false"><ref loc="MAT 18:3">ማቶ. 18፥3</ref>።</char></note> <verse eid="MRK 10:15"/><verse number="16" style="v" sid="MRK 10:16"/>ህከኒች ኤተሮን ኦሱተ ሀንቀፍ አንገስ አሌሰ አዕይ ማሰዕዮሰ።<verse eid="MRK 10:16"/></para>
  <para style="s1">ዱንያ አል ቀባጡተለከ መገን ዎምነቱ</para>
  <para style="r">(<ref loc="MAT 19:16-30">ማቶ. 19፥16-30</ref>፤ <ref loc="LUK 18:18-30">ሉቃ. 18፥18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17"/>ኢስ ህከን አዲች ፉል ሃመን ሄዕዮገን መቱ መንቹ እስበ ደጉደን አሜች ብሬስ ጉሉጵ «መረርሲጭታንት አስተማርቾ! ጉዕመ ዘማን ሄኡ ደኦተ መ አኡ ሀስሰኖኤ?» ይ ጠዕሜስ። <verse eid="MRK 10:17"/><verse number="18" style="v" sid="MRK 10:18"/>ኢስን ፈንቀሽ «ሚሃት መረርሲጫንቾ ይታንቴኤሁ? ሜጦ መገን ቤሉ መረርሲጫንቹ አዪሁ ዮበአ። <verse eid="MRK 10:18"/><verse number="19" style="v" sid="MRK 10:19"/>ትዛዝ ደጋንት፤ ትዛዙንኩ ‹ሽቶት፥ ዝነተ አቶት፥ ሞግቶት፥ ጩብ መሰከርቶት፥ ጣንስቶት፥ አነክለከ አመክ ከበጅ› የኖሃን» ዬስ።<note caller="-" style="x"><char style="xo" closed="false">10፥19 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">ፉል. 20፥12-16</ref>፤ <ref loc="DEU 5:16-20">ዘዳ. 5፥16-20</ref>።</char></note><verse eid="MRK 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20"/>ሁኩ መንቹንኩ ፈንቀሽ «አስተማርቾ! አን ከ ትዛዝ ጉዕመንከ ኦስማችኤ ኬሽ አገሮም» ዬእ።<verse eid="MRK 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21"/>ኢስን ህከ መንቹ ለዕይ እሱንከ ኢቴስ፤ «መቱ ጠዉ ጠለዕሉ ፈቆሄ፤ እስን መርት ዮሄ ዱንያክ ጉዕመንከ ህርት ብረስ ቡጥቻኖተ ኣስ፤ አት ሰማን ጭምይቶ ዱንያተ ደእታንት፤ ህከኒች ኤተሮን አሜት ኤሳሃ አዎንት ኢች ተማር» ዬስ። <verse eid="MRK 10:21"/><verse number="22" style="v" sid="MRK 10:22"/>መንቹንኩ ከ ጠወ ሞጮጬ ወክት ልግቡ ዱንያት ዮስቤቺሃ ሚንተ በዕይ ሻዘን ኦሮዕዮ።<verse eid="MRK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23"/>ህከ ወክት ኢስ አሳበስ ዘህ ለዕይ «ቀባጣሙ መኑ መገን ዎምነቱ ኣጉ ሀትኔታ ኦርሸ» ዬሰ።<verse eid="MRK 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24"/>አሳበስ ላጋንተስ አጀብሲጭቶኡ። ኢስን ፈንቀሽ «ኢ ኦሶ መገን ዎምነቱ ኣጉ ሀት ኦርሰኖሃን? <verse eid="MRK 10:24"/><verse number="25" style="v" sid="MRK 10:25"/>ቀባጣሙ መገን ዎምነቱ ኣገኖ ዪች ጋሜሉ መርፌ ጠላዕላን ህገኖ ዩ ቆሀኖ» ዬሰ።<verse eid="MRK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26"/>ህከን ጠዋን አሳበስ አበ አጀብሲጭት ገገዉንኩሰን «ከን ሃሌን አይ ጡሞተ አታለኖ?» የቀንቶኡ።<verse eid="MRK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27"/>ኢስን እሰ አደ ለዕይ «መኒሃ አታለምቡ መገኒሃ አታለመኖ፤ መሰንትስ መገኒሃ ጉዕሙርቹንኩ አታለመኖስ» ዬሰ።<verse eid="MRK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28"/>ጴጥሮስን «ነኡ ጉዕመርቹንከ አጉርን አዎኖንኬ» ዬእ።<verse eid="MRK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29"/>ኢስን «ሀንቅንከ ያንክዕኔ፤ ኢተኔሃለከ እንጂልተኔሃ ምንስለከ አመስ ኦሱተ፥ ላባኑተለከ ሜኣኑተ፥ አመስለከ አነስ፥ እለስለከ ኡለስ አጉረኖሁ በትሽ አበ ደአኖ። <verse eid="MRK 10:29"/><verse number="30" style="v" sid="MRK 10:30"/>ከን ዘማኔን ሆሮ ምንስለከ አመስ ኦሱታ፥ አማኑስለከ እለስ፥ ኡለስ አመዕነትተኔሃ ያየም ኦርጨቀሞጎሬ ጥቤ ለሙ አፎ ደአኖ፤ ህትን አሜተኖ ኣኬሩ ዘማኔን ጉዕማን ጎፍበ ሄኡ ደአኖ። <verse eid="MRK 10:30"/><verse number="31" style="v" sid="MRK 10:31"/>ጠዉ እኮጎሬ ልግቡ ብሬሩ ኤተርረ ህትን ልግቡ ኤተርሩ ብሬረ እካአ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">10፥31 </char><char style="xt" closed="false"><ref loc="MAT 20:16">ማቶ. 20፥16</ref>።</char></note><verse eid="MRK 10:31"/></para>
  <para style="s1">ኢስ ሬሆስተኔሃ ሰቅ ወክት ጠወኡስ</para>
  <para style="r">(<ref loc="MAT 20:17-19">ማቶ. 20፥17-19</ref>፤ <ref loc="LUK 18:31-34">ሉቃ. 18፥31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32"/>ኢስለከ አሳበስ ዬሩሳሌመ መሰኖ ዎቃን ሜጡበ ሄኦገን ኢስ እሰ ብሬን ሃመኖ እቅ፤ አሳበስ አጀብሲጭቶኡ፤ ህትን ኤተርስ አዲን አዎንተን ሄኦ መኑ ዋጅቶ እቅ፤ ኢስ ቶነ ለሙንከ አሳበስ ለንኪሃ እስበ ሆንጠህሽ ኢልታሰ ኦርሸተ ኩሎሰ። <verse eid="MRK 10:32"/><verse number="33" style="v" sid="MRK 10:33"/>ኢስን እሰንተ «ሁኩዕኑን! ቴሱ ዬሩሳሌመ መርናሚት፤ ህከንቤቾንን መንች ቤቱ ቂስ አዎንሳኖተለከ ሕግ አስተማረተ ህግሴን ኣሴኖስ፤ እሰን ሬሆ ፍርደ ፈረድ አይሁደ እህበ መኒሃ ህግስ ኣታአ። <verse eid="MRK 10:33"/><verse number="34" style="v" sid="MRK 10:34"/>እሰን ቀለዳስ፤ አንጀ ቱ ይታስ፤ ኦልታስ፤ ሽታስ፤ ጠዉ እኮጎሬ እስ ሰቅ በር ሬሆች ኬአኖ» ዬሰ።<verse eid="MRK 10:34"/></para>
  <para style="s1">ያቁብለከ ያህይ ኡጭቱተ</para>
  <para style="r">(<ref loc="MAT 20:20-28">ማቶ. 20፥20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35"/>ዜብዴዎሴ ኦሱት ያቁብለከ ያህይ ኢስበ ሆንጠክ «አስተማርቾ! ኡጭናንኬ ጉዕመርቹንከ ኣቶኔተ ሀንሳም» ይቶኡ።<verse eid="MRK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36"/>ኢስን «መ አኦህዕኔተ ኢትቴነን?» ዬሰ።<verse eid="MRK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37"/>እሰን «ኬዕምኝክ ዎምነቴን መቱኔ መኬ አዲን መቱኔ ጉረ አዲን አፉዕልናምገ አእኔ» ይቶኡ።<verse eid="MRK 10:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38"/>ጠዉ እኮጎሬ ኢስ እሰንተ «ኡጭቴነንታሃ ደጌነንተበአ፤ አን ቶጋም ኦርሸ ጠበትተ ቶጎኖተ አታልቴነንንዶ? ህትን አን ጠመቀማም ጥምቀት ጠመቀሙ አታልቴነንንዶ?» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">10፥38 </char><char style="xt" closed="false"><ref loc="LUK 12:50">ሉቃ. 12፥50</ref>።</char></note><verse eid="MRK 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39"/>እሰን ፈንቀሽት «ኤ አታልናም» ይቶኡ፤ ህትን ኢስ ፈንቀሽ «አን ቶጋም ኦርሸ ጠበቴሃ አዕኑ ቶጎኖተ አታልቴነንተ፤ ህትን አን ጠመቀማም ጥምቀት ጠመቀንቴነንተ። <verse eid="MRK 10:39"/><verse number="40" style="v" sid="MRK 10:40"/>እኮጎሬ ኢ መኬ አዲንለከ ጉረ አዲን አፉዕሌኖገ አኣሚሁ አኔበአ፤ ጠዉ እኮጎሬ ሁኩ ቤቹ መገኑ ቅጥ አዕዮሰሀኑኡሃ ኣሰመኖሃን» ዬሰ።<verse eid="MRK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41"/>ፈቆ ቶኑንኩ አሳበት ህካን ሞጮጭቶ ወክት ያቁበለከ ያህይ ኡሙዕርቶኡ። <verse eid="MRK 10:41"/><verse number="42" style="v" sid="MRK 10:42"/>ህከ ወክት ኢስ እሰንተ እስበ ገእ «አይሁደ እህበ ኡመቲሃ ዬን ገኤኖሰገለከ አዎንሳኑሰን እሰ አሌን ሹምነቱ ዮሳሃ እሁስ ደጌነንተ።<note caller="-" style="x"><char style="xo" closed="false">10፥42 </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">ሉቃ. 22፥25-26</ref>።</char></note> <verse eid="MRK 10:42"/><verse number="43" style="v" sid="MRK 10:43"/>ጠዉ እኮጎሬ ክዕኔቤቾን ህት እሁ ሀስሰኖበአ፤ አዪሁ ክዕኔ በላን ሎረ እሆተ ኢተኖሁ ሄዕዮ ጎሬ ክዕኔንከ ካዲንቹ እሁ ሀስሰኖስ።<note caller="-" style="x"><char style="xo" closed="false">10፥43 </char><char style="xt" closed="false"><ref loc="MAT 23:11">ማቶ. 23፥11</ref>፤ <ref loc="MRK 9:35">ማር. 9፥35</ref>፤ <ref loc="LUK 22:60">ሉቃ. 22፥60</ref>።</char></note> <verse eid="MRK 10:43"/><verse number="44" style="v" sid="MRK 10:44"/>ህትን ክዕኔ በላን ዎኔሃ እሆተ ሀሰኖሁ ጉዕሚንከክዕኔ ሮስቹ እሁን። <verse eid="MRK 10:44"/><verse number="45" style="v" sid="MRK 10:45"/>ህትን መንች ቤቱ ካደሞተለከ ነብሳስ ልግብያ መኒሃ ዎዥ ኣሶተ አሜቾ ቤሉ እስ ካደሞኖስተ አሜቾበአ» ዬሰ።<verse eid="MRK 10:45"/></para>
  <para style="s1">ኢስ እልተ ቆቀ በርጤሞሴ ፈይሱስ</para>
  <para style="r">(<ref loc="MAT 20:29-34">ማቶ. 20፥29-34</ref>፤ <ref loc="LUK 18:35-43">ሉቃ. 18፥35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46"/>ህከኒች ኤተሮን እሰን ኢያርኮ ከተመ አሜቶኡ፤ ኢስ አሳበስ ልግብያ መኒን ሜጡበ ኢያርኮ ከተሚች ፉለንን ጤሞሴ ቤቱ «በርጤሞሴ» ዬኖ ቆቁ ዎቄ መዴን አፉዕል ኡጨኖት እቅ። <verse eid="MRK 10:46"/><verse number="47" style="v" sid="MRK 10:47"/>ህከን አዲን ህገኖሁ ነዝሬት ኢሰ እሁስ ሞጮጬ ወክት «ደዉዴ ቤቶ ኢሰ! ሀዕይ መረርሲጬኤ» የን ያሩ ጀመሮ። <verse eid="MRK 10:47"/><verse number="48" style="v" sid="MRK 10:48"/>ኢሰ አዎንተን ሄኦ መኑ «ጨለይ» ይት ኡሙዕርቶስ፤ ጠዉ እኮጎሬ እስ «ደዉዴ ቤቶ ሀዕይ መረርሲጬኤ» የን ወዕኔች በትሽ ያሮ።<verse eid="MRK 10:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49"/>ኢስን ኡር «ገእዬስ» ዬእ፤ እሰን ህከ ቆቀ መንቹ «ቴ ጠረኝ ኬእ፤ ኢስ ገአኖሄት» ይት ገእቶስ። <verse eid="MRK 10:49"/><verse number="50" style="v" sid="MRK 10:50"/>እስን ኦደዕዮ ኦድኑስ ኡጅ ኡር ኮርጀን ኬዕይ ኢስበ አሜቾ።<verse eid="MRK 10:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51"/>ኢስን «መ አኦሄተ ሀሰን?» ይ ጠዕሜስ።</para>
  <para style="p" vid="MRK 10:51">ሁኩ ቆቁንኩ መንቹ «አስተማርቾ! ሀዕይ እልኤ ለኣገ አኤኤ» ዬስ።<verse eid="MRK 10:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52"/>ኢስን «ቴ ኦሮእ፤ አመዕነቱክ ፈይሾሄ» ዬስ፤</para>
  <para style="p" vid="MRK 10:52">ወክትንከስ እልስ ፈንተኣን ለዕይ ኢሰ አዎኞ።<verse eid="MRK 10:52"/></para>
  <chapter eid="MRK 10"/>
  <chapter number="11" style="c" sid="MRK 11"/>
  <para style="s1">ኢስ ሎረ ኬዕምኚን ዬሩሳሌመ ኣጉስ</para>
  <para style="r">(<ref loc="MAT 21:1-11">ማቶ. 21፥1-11</ref>፤ <ref loc="LUK 19:28-40">ሉቃ. 19፥28-40</ref>፤ <ref loc="JHN 12:12-19">ያህ. 12፥12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1"/>ኢስለከ አሳበስ ዬሩሳሌመ ሆንጠኮ ወክት ቤተ ፋጌለከ ቢታን ከተም አዲን ዘይት ሀቁ ነጰኖ ቆተበ ኢልቶኡ፤ ህከንቤቺች ኢስ አሳባች ለሙሰ <verse eid="MRK 11:1"/><verse number="2" style="v" sid="MRK 11:2"/>«ብሬ አዲን ዮ ቀዕየተ መሬ፤ ህከ ቤቹ እልቴንተ ወክት አዪሁ ሆሮን ቆጶበእ ወተረ ኡሱረሞሃ ደጌነንተ፤ እሱንከ ሂርቴን ኤቤኤ። <verse eid="MRK 11:2"/><verse number="3" style="v" sid="MRK 11:3"/>አይደጎ አዪሁ ‹ካን ሚሃ አቴነንታት?› ዬህዕኔጎሬ ‹ቀርቹ ሀሾቤቺሃት፤ እስን ደዕል ፈንቀሽ ሶሀኖህዕኔ› ይዬ» ይ ሶኮሰ።<verse eid="MRK 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4"/>እሰን መርት ዎተሩስ ዎቄ መዴን ኡሮ ቀፈቴን አሱረሞሃ ደግ ህርቶኡ። <verse eid="MRK 11:4"/><verse number="5" style="v" sid="MRK 11:5"/>ህከ ወክት ህከኔ ኡሬ መኒች መት-መቱሰ «ከ ዎተረ ሂርቴነንታሁ ሚሃት?» ይት ጠዕምቶሰ።<verse eid="MRK 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6"/>እሰን ኢስ እሳሃ ዬገን ይት ኩልቶኡ፤ ሁኩ መኑንኩ «መስዬ» ይቶኡ። <verse eid="MRK 11:6"/><verse number="7" style="v" sid="MRK 11:7"/>አሳበስ ዎተረ ኢስበ ኤብ ኦድኑሰ ዎተር ጉጅ አሌን አታን ኢስ ቆጶ። <verse eid="MRK 11:7"/><verse number="8" style="v" sid="MRK 11:8"/>ልግቡ መኑ ኦድኑሰ ዎቃን ዌሳኢት እቅ፤ ዎሉሰንገ ቆጢች ሀቅ ሀበረ ተንቅሰን ዌሳእት እቅ። <verse eid="MRK 11:8"/><verse number="9" style="v" sid="MRK 11:9"/>ብሬ አዲን ሃንተን ሄኦእሩለከ ኤተር አዲን አዎንተን ሄኦ ጉዕሙንኩ «መገኒሃ ኬዕምኙ እሁን! ቀርች ሱዕሚን አሜተኖሁ ማሰአሞሃን።<note caller="-" style="x"><char style="xo" closed="false">11፥9 </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">መዝ. 118፥25-26</ref>።</char></note> <verse eid="MRK 11:9"/><verse number="10" style="v" sid="MRK 11:10"/>አሜተኖ አንኔ ደዉዴ ዎምነቱ ማሰአሞሃን፤ መገኒሃ ኬዕምኙ አሌ ሰማን እሁን» ይተን ሎረ ላጋን ገለትጭታኢት እቅ።<verse eid="MRK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11"/>ኢስ ዬሩሳሌመ ኢሌ ወክት ዱአ አኤኖ ምኒ ኣጎ፤ እስን ህከኔ ዮ ጉዕመርቹንከ ለዕዮ፤ ጠዉ እኮጎሬ ኡለት ሀዎርቶቤቺሃ ቶነ ለሞንከ አሳባን ቢታን ከተመ ኦሮዕዮ።<verse eid="MRK 11:11"/></para>
  <para style="s1">ኢስ ቦሮሮ ኦዴቹተ</para>
  <para style="r">(<ref loc="MAT 21:18-19">ማቶ. 21፥18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12"/>ለንክ በር ቢታን ከተሚች አሜተንን ኢሰ ጎሩ አፎስ። <verse eid="MRK 11:12"/><verse number="13" style="v" sid="MRK 11:13"/>እስን ሀበረ ለቶ ኦድ ሀቁቹተ ቄዕራሻን ለዕይ «አይደጎ ላልቹ ዮሴ ጎሬ» ይ እሴበ ኦሮዕዮ፤ ጠዉ እኮጎሬ ህከ ኦድ ሀቁቾበ ሆንጠኮ ወክት ኦዱ ላለኖ ወክቱ ኢልዮበእቤቺሃ ሀበር ቤሉ ላልቹ ዮሴበ እቅ። <verse eid="MRK 11:13"/><verse number="14" style="v" sid="MRK 11:14"/>ህካን እኮቤቺሃ ኢስ ኦድ ሀቁቹተ «አዪሁ ከኒች ኤተሮን ኪች ላልቹ እቱንከ» ዬሴ። ህካን ጠወአንን አሳበንት ሞጮጭቶኡ።<verse eid="MRK 11:14"/></para>
  <para style="s1">ኢስ ዱአ አኤኖ ምናን ጌባ አታእረ ፉሹስ</para>
  <para style="r">(<ref loc="MAT 21:12-17">ማቶ. 21፥12-17</ref>፤ <ref loc="LUK 19:45-48">ሉቃ. 19፥45-48</ref>፤ <ref loc="JHN 2:13-22">ያህ. 2፥13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15"/>እሰን ዬሩሳሌመ ኢልቶ ወክት ኢስ ዱአ አኤኖ ምኒ ኣግ ምንስ ኣዜን ህርታእረለከ ህዕርታእረ ፉሼእ፤ ብረ ዶርተ መን ጠረጴዘተለከ ሀንደዕርተ ህርታ መን ቦርጭመተ ገለበጮ። <verse eid="MRK 11:15"/><verse number="16" style="v" sid="MRK 11:16"/>ኢስ አዪሁ ዱአ አኤኖ ምኒ ግቤ ኣዚን መቱርቹሃ እጅ ህገኖበእገ አዘዦ። <verse eid="MRK 11:16"/><verse number="17" style="v" sid="MRK 11:17"/>ህትን ኢስ እሳሃ « ‹ምኑኤ ኡመቱ ጉዕሙንኩ መገኑ ኡጨኑወ ምኒ› የመም ጠሊለ መጻፋን ከተበሞበእንዶ? እኮጎሬ አዕኑ ሽፍጥ ቆጠ አቴንታአ» ይ ተማርሴሰ።<note caller="-" style="x"><char style="xo" closed="false">11፥17 </char><char style="xt" closed="false"><ref loc="ISA 56:7">ኢሳ. 56፥7</ref>፤ <ref loc="JER 7:11">ኤር. 7፥11</ref>።</char></note><verse eid="MRK 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18"/>ቂስ ሀለቀትለከ ሕግ አስተማረት ህካን የን ሞጮጭቶ ወክት እሱ ሽታ ዎቃሃ ሀሶኡ፤ እኮጎሬ እስ ተማርሰን መኑ ጉዕሙንኩ ትምርቴንከስ አጀብሲጬቤቺሃ ዋጅቶኡ።<verse eid="MRK 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19"/>ኢስለከ አሳበስ ኡለት ሀዎርቶ ወክት ከተሚች አብል ፉልቶኡ።<verse eid="MRK 11:19"/></para>
  <para style="s1">ኦድ ሀቁቾች ደገሞ ትምርት</para>
  <para style="r">(<ref loc="MAT 21:20-22">ማቶ. 21፥20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20"/>እሰን ለንክ በር ሱጵተ ዎቄን ህገን ኦድ ሀቁቹት ጠጰሴ ኢለ ሞልቶኢሃ ለኦኡ። <verse eid="MRK 11:20"/><verse number="21" style="v" sid="MRK 11:21"/>ጴጥሮስን ጠወስ ሰውይ ኢሰ «አስተማርቾ ከለእ! አት ቦሮርቶንትሴ ኦድ ሀቁቹት ሞልቶኡ» ዬእ።<verse eid="MRK 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22"/>ኢስን እሰንተ «መገኖን አመዕንዬ። <verse eid="MRK 11:22"/><verse number="23" style="v" sid="MRK 11:23"/>ሀንቅንከ ያንክዕኔ፤ አዪሁ ቀልቤንከስ ሸኩዕናን ዬኢሁ ጉዕሙንኩ እሀኖገ አመዕን ከ ቆተተ ‹ከንቢች ኬእ ባራን ኡብ› ዬጎሬ እሀኖስ።<note caller="-" style="x"><char style="xo" closed="false">11፥23 </char><char style="xt" closed="false"><ref loc="MAT 17:20">ማቶ. 17፥20</ref>፤ <ref loc="1CO 13:2">1 ቆሮ. 13፥2</ref>።</char></note> <verse eid="MRK 11:23"/><verse number="24" style="v" sid="MRK 11:24"/>ህካን እኮቤቺሃ አን ኩላንክዕኔ፤ አዕኑ መገኑ ኡጭቴነንተርቹ ጉዕሙንኩ ክዕኔሃ ኣሰመኖህዕኔገ አመዕንቴንተጎሬ ክዕኔሃ ኣሰመኖህዕኔ። <verse eid="MRK 11:24"/><verse number="25" style="v" sid="MRK 11:25"/>አዕኑ ዱአ አኢሃ ኡርቴነንተ ወክት አዬ አሌኒ አፌንተ ገዱተ አጉሬ፤ ህካን እኮቤቺሃ ሰማን ዮ አኑክዕኔ ጩብክዕኔ አጉረኖህዕኔ።<note caller="-" style="x"><char style="xo" closed="false">11፥25 </char><char style="xt" closed="false"><ref loc="MAT 6:14-15">ማቶ. 6፥14-15</ref>።</char></note> <verse eid="MRK 11:25"/><verse number="26" style="v" sid="MRK 11:26"/>ጠዉ እኮጎሬ አዕኑ መኑ በደሎህዕኔሃ አጉርቴንበጎሬ ሰማን ዮ አኑክዕኔ ክዕኔ ብድልሃ አጉረኖበአ» ዬሰ።<note caller="+" style="f"><char style="ft" closed="false">መት-መቱ ሉህ ክታበት ዎሊንሽ 26 ዮኢሃ በርግታበአ፤ ላገስ ማቶ. 6፥15 ዮኢሃ አጉደኖ።</char></note><verse eid="MRK 11:26"/></para>
  <para style="s1">ኢሰ መ ሹምነቲን አአኖጎሬ ጠዕሜመገ</para>
  <para style="r">(<ref loc="MAT 21:23-27">ማቶ. 21፥23-27</ref>፤ <ref loc="LUK 20:1-8">ሉቃ. 20፥1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27"/>ኢስለከ አሳበስ ለንኪሃ ዬሩሳሌመ መርቶኡ፤ ህከኔ ኢስ ዱአ አኤኖ ምኔን ፈንቀላመን ቂስ አዎንሳኑት፥ ሕግ አስተማረትለከ ባድ ባልቀት እስበ አሜት <verse eid="MRK 11:27"/><verse number="28" style="v" sid="MRK 11:28"/>«ከ ጠወ አታንቲሁ መ ሹምነቲንት? ህከረንገ ካን አታንት ወልቀተ ኣሴሄሁ አዬት?» ይት ጠዕምቶስ።<verse eid="MRK 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29"/>ኢስን እሳንከ ፈንቀሽ «አን መቱ ጠወ ጠዕማንክዕኔ፤ አዕኑ አን ጠዕሜምርቹ ፈንቀሽቴንተጎሬ አን መ ወልቃን ከ ጠወ አኣሚት ጎሬ ኩላንክዕኔ። <verse eid="MRK 11:29"/><verse number="30" style="v" sid="MRK 11:30"/>ህንዴ ኩሌኤ፤ ያህይ ጠመቀኖ ጥምቀቱ መገኒችትንዶ ህከረንገ መኒችት?» ዬሰ።<verse eid="MRK 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31"/>ህከ ወክትንከ እሰን «መ ይኑ?» ይት ገገዉንኩሰን አማዕለንት « ‹መገኒችት› ይኖምጎሬ ‹ሚሃ ያህይን አመዕንቴነንተበአ?› የኖኔ። <verse eid="MRK 11:31"/><verse number="32" style="v" sid="MRK 11:32"/>‹መኒችት› ይኑንዶ?» ይቶኡ፤ ህካን ይታበእገ ኡመቱ ጉዕሙንኩ ያህይ «ነብዬቹወ» የኖቤቺሃ መነ ዋጅቶኡ። <verse eid="MRK 11:32"/><verse number="33" style="v" sid="MRK 11:33"/>ህካን እኮቤቺሃ እሰን ኢስሃ «ነኡ ደንጋምበአ» ይት ፈንቀሽቶኡ፤ ኢስን እሰንተ «አን ካን መ ወልቃን አኣሚት ጎሬ ኩላንክዕኔበአ» ዬሰ።<verse eid="MRK 11:33"/></para>
  <chapter eid="MRK 11"/>
  <chapter number="12" style="c" sid="MRK 12"/>
  <para style="s1">ወይን ላሉተ አገርታ መንተኔሃ</para>
  <para style="r">(<ref loc="MAT 21:33-46">ማቶ. 21፥33-46</ref>፤ <ref loc="LUK 20:9-19">ሉቃ. 20፥9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1"/>ኢስ እሳንከ ማቆን መቱ ወክት መቱ መንቹ ወይነ ዬኖ ላልቹ ካሾ፤ ህከቤቹንከ ዘህሽ ኦች ላልቹስ ጩንሼኖ ኤሎ እም ወይነ አገረኖሀኒሃ ሀንሸሩ እጃር መክሾ፤ ህከኒች ኤተሮን ሁኩ መንቹ ወይነስ ቀባኖተ ኣስ ቄዕራሸ ባዱ ኦሮዕዮ። <verse eid="MRK 12:1"/><verse number="2" style="v" sid="MRK 12:2"/>ወይኑስ ላለኖ ወክት ካድንቹስ መር ላልቺችስ ኤቦተ ቀባኖበ ሶኮ። <verse eid="MRK 12:2"/><verse number="3" style="v" sid="MRK 12:3"/>እሰን ህከ ሶሄመ ካድንቹ አፍ ኦልት መቱርቹሃ ኣቱዕናን ኦነስ ሸርቶኡ። <verse eid="MRK 12:3"/><verse number="4" style="v" sid="MRK 12:4"/>ለንኪሃ ወይንስ አኑ ዎሉ ካድንቹ ሶኮ፤ ቀባኑስ ህከ ካድንቹ ቡዕለስ ፍልት ጡላይስ ሆፍስስ ሸርቶኡ። <verse eid="MRK 12:4"/><verse number="5" style="v" sid="MRK 12:5"/>ህትን ወይንስ አኑ ዎሉስ ሶኮረ ሽቶኡ፤ ህትን ልግብ መነ ሶኮረ መት-መቱሰ ዎቃርቶኡ፤ ዎሉሰንገ ሽቶኡ። <figure style="fig" alt="Woman with child bringing grapes to wine press" file="LB00106B.tif" size="span" ref="12፥2">ወይነ ጩንሼኖቤቹ</figure><verse eid="MRK 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6"/>ቴሁ መንቺሀስ ፈቆሁ ኢተኖ ቤቱስ ሶኋን፤ ህካን እኮቤቺሃ «ኢ ቤቱ ከበጅታስ» ይ ሰውይ ኤተሮን ቤቱስ ቀባኖስበ ሶኮ። <verse eid="MRK 12:6"/><verse number="7" style="v" sid="MRK 12:7"/>ጠዉ እኮጎሬ ሁኩ ቀባኑት ገገዉንኩሰን «ከለዕዬ! ኡለስ ረገአኖሁ ከኒት፤ ህካን እኮቤቺሃ አሜ እሱ ሽኖ፤ ነኡ ኡለስ ረገዕናም» የቀንቶኡ። <verse eid="MRK 12:7"/><verse number="8" style="v" sid="MRK 12:8"/>እሰን እሱ አፍ ሽት ወይን አቡረ ኣዚች አብል ፉሽት ቶርቶኡ።<verse eid="MRK 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9"/>ህካን እኮቤቺሃ ሁኩ ወይንስ አኑ መ አአኖ? አሜች ህከ ቀባኑስ ሽ ወይነስ ዎሎ መኒሃ ኣሰኖ። <verse eid="MRK 12:9"/><verse number="10" style="v" sid="MRK 12:10"/>ጠሊለ መጻፋን</para>
  <para style="q1" vid="MRK 12:10">«ግንበኛኑት ህንቆ ክኑ</para>
  <para style="q2" vid="MRK 12:10">እስ ሙረበ ቡዕል ክኑ እኮ።<note caller="-" style="x"><char style="xo" closed="false">12፥10-11 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">መዝ. 118፥22-23</ref>።</char></note><verse eid="MRK 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11"/>ሁኩንን ቀርችተ ሆጉ፤</para>
  <para style="q2" vid="MRK 12:11">ሁኩ ሆጉንት እሌተኔ አጀብሲሳእታን</para>
  <para style="q2" vid="MRK 12:11">የመም ከተበሞሃ አነበቤንታበእንዶ?» ዬእ።<verse eid="MRK 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12"/>አይሁድ ሀለቀት ኢስ ጠወዕዮ ምሳልተ እሰንተ ለአኖሃ እሁስ ደጎቤቺሃ አፎተ ሀሶ እቅ፤ ጠዉ እኮጎሬ ኡመት ዋጅቶቤቺሃ አጉርት መርቶኡ።<verse eid="MRK 12:12"/></para>
  <para style="s1">ግብር ባቲሃ ኢሰ ጠዕሜመገ</para>
  <para style="r">(<ref loc="MAT 22:15-22">ማቶ. 22፥15-22</ref>፤ <ref loc="LUK 20:20-26">ሉቃ. 20፥20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13"/>ጠወአኖ ጠዊን ሉሲሶተ መት-መቱ ፈርሳውትለከ ሄሮድሴሃ እሉ እሀኖ መነ ኢስበ ሶኮኡ። <verse eid="MRK 12:13"/><verse number="14" style="v" sid="MRK 12:14"/>እሰን እስበ አሜት «አስተማርቾ! መቱ አደ ጎልቱዕናን ሀንቅ መገን ዎቃሃ ተማርሲታንትሃን፤ አት ሀንቅ አታንቲሃ እሁክ ደንጋም፤ ሮም ዎሚሃ ግብር ባቱ ገበአኑሃንዶ ገበእበሃን? ግብር ባንቱንዶ ህከረንገ ባንቱንከ?» ይቶኡ።<verse eid="MRK 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15"/>ኢስን እሰ ሂለ ጠወ ደግ «ሚሃ ሉስሶኖኤተ ሀሴነንታት? ህንዴ ዲናረ ኤቤ ለኣም» ዬሰ።<verse eid="MRK 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16"/>እሰን መቱ ዲናረ ኤቦኡ፤ እስን እሰንተ «ከን ዲናር አሌን ዮ ፎቱትለከ ከተበሞ ሱዕሙሁ አዬሃን?» ዬሰ፤</para>
  <para style="p" vid="MRK 12:16">እሰን «ቄሳርየ» ይቶኡ።<verse eid="MRK 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17"/>ኢስን ፈንቀሽ «ህካን እኮች ዎሚሃ ዎሚንከ ህትን መገኒሃ መገኒንከ ኣስዬ» ዬሰ፤ እሰን ጠዋንከስ አጀብሲጭቶኡ።<verse eid="MRK 12:17"/></para>
  <para style="s1">ሬዮ መኑ ኬእሃስ ሆንጠኮ ጠዕምቱተ</para>
  <para style="r">(<ref loc="MAT 22:23-33">ማቶ. 22፥23-33</ref>፤ <ref loc="LUK 20:27-40">ሉቃ. 20፥27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18"/>«ሬዮ መኑ ሬሆች ኬአኖበአ» ይታ ሰዱቃውት ኢስበ አሜት፤<note caller="-" style="x"><char style="xo" closed="false">12፥18 </char><char style="xt" closed="false"><ref loc="ACT 23:8">ሶቀ. 23፥8</ref>።</char></note> <verse eid="MRK 12:18"/><verse number="19" style="v" sid="MRK 12:19"/>«አስተማርቾ! ሙስ ‹መቱ መንቹ እለተ እሉዕናን ሬዮ ጎሬ ህከን ሬዮ መንች አመስቤቱ ጫስ ረገዕይ ህከን ሬዮ መንቺሃ እለተ እሉን› ይ ከተቦኔ።<note caller="-" style="x"><char style="xo" closed="false">12፥19 </char><char style="xt" closed="false"><ref loc="DEU 25:5">ዘዳ. 25፥5</ref>።</char></note> <verse eid="MRK 12:19"/><verse number="20" style="v" sid="MRK 12:20"/>መቱ ወክት ለመሉ አመኦሱት ሄኦ እቅ፤ እሳችን ሀንገፉስ ጫተ ኤብ እለተ እሉዕናን ሬዮ። <verse eid="MRK 12:20"/><verse number="21" style="v" sid="MRK 12:21"/>ህትን ለንክሁ ህተ ጫተ ረገዕይ እሉዕነ ሬዮ፤ ሰቂሁ ህትን እኮ። <verse eid="MRK 12:21"/><verse number="22" style="v" sid="MRK 12:22"/>ከን ሃሌን ለመሉንኩ ህተ ጫተ ረገእ እልቱዕናን ሬቶኡ፤ ህከኒች ኤተሮን ጫንትስ ሬቶኡ። <verse eid="MRK 12:22"/><verse number="23" style="v" sid="MRK 12:23"/>ህካን እኮቤቺሃ ለመሉንኩ አመኦሱት ተሪን ተሪን ረገኦሴቤቺሃ ሬዮ መኑ ሬሆች ኬአኖ በር ህት ጫት አዬተ እካአ?» ይት ጠዕምቶኡ።<verse eid="MRK 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24"/>ኢስን እሳንከ ፈንቀሽ «አዕኑ ህት ሉሴነንታሁ ጠሊለ መጻፈተለከ መገን ዎልቀተ ደጉ ሆጌንተቤቺሃትበእንዶ? <verse eid="MRK 12:24"/><verse number="25" style="v" sid="MRK 12:25"/>ሁኩ ሬቶ መኑ ሬሆች ኬኣ ወክት መላይከገ እካ ቤሉ ኣኢታበኢሁ፤ ኣአቀንታበኢሁ። <verse eid="MRK 12:25"/><verse number="26" style="v" sid="MRK 12:26"/>ጠዉ እኮጎሬ ሬቶሀኑኡተ ኬእተኔሃ መገኑ ቡበኖ ሽፎ ኣዜን ሙሰ ‹አን እብራሂሚሃ፥ ኢሳቅለከ ያቁብሃ መገኑ› የኖሃ ጠሊለ መጻፊች አነበቤንታበእንዶ?<note caller="-" style="x"><char style="xo" closed="false">12፥26 </char><char style="xt" closed="false"><ref loc="EXO 3:6">ፉል. 3፥6</ref>።</char></note> <verse eid="MRK 12:26"/><verse number="27" style="v" sid="MRK 12:27"/>ህካን እኮቤቺሃ መገኑ ፎሉ ዮ መኒሃ መገኑዋ ቤሉ ሬዮ መኒሃ መገኑሃበአ፤ ጠዉ እኮጎሬ አዕኑ ሉሴነንታት» ዬእ።<verse eid="MRK 12:27"/></para>
  <para style="s1">ጉዕሚችን በተአኖ ትዛዝ</para>
  <para style="r">(<ref loc="MAT 22:34-40">ማቶ. 22፥34-40</ref>፤ <ref loc="LUK 10:25-28">ሉቃ. 10፥25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28"/>ህከን ቤቾን ሕግ አስተማራች መቱ ኦደንታኢሃ ሞጮጨኖት እቅ፤ እስን ኢስ ሁኩ ሬዮ መኑ ኬአኖበአ ይታ ሰዱቃዌተ ጡመገ ፈንቀሼገ ለዕይ ኢስበ ሆንጠክ «ትዛዚች ጉዕሚችን በተአኖ ሎረሃን?» ይ ጠዕሜእ።<note caller="-" style="x"><char style="xo" closed="false">12፥28-34 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">ሉቃ. 10፥25-28</ref>።</char></note><verse eid="MRK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29"/>ኢስን እሲሃ ፈንቀሽ «ጉዕሚችን በተአኖ ትዛዝ ‹እስራኤል መኑ ሞጮጭዬ! ቀርቹ መገኑኔ ሜጦሃ ቀርቹ። <verse eid="MRK 12:29"/><verse number="30" style="v" sid="MRK 12:30"/>አቲሁ ቀርቹ መገኑክ ዊመ ቀልብንከክ፥ ዊመ ነብሴንከክ፥ ዊመ ሰውቲንከክለከ ዊመ ወልቃንከኪ ኢት› የኖሃን።<note caller="-" style="x"><char style="xo" closed="false">12፥30 </char><char style="xt" closed="false"><ref loc="DEU 6:4-5">ዘዳ. 6፥4-5</ref>።</char></note> <verse eid="MRK 12:30"/><verse number="31" style="v" sid="MRK 12:31"/>ህትን ካን አጉደኖ ለንክ ትዛዙ ‹ዎሉ መነ ገይክገ አት ኢት› የኖሃን፤ ከን ለሞ ትዛዚች በተአኖ ዎሉ ትዛዙ ዮበአ» ይ መስለ ፈንቀሼእ።<note caller="-" style="x"><char style="xo" closed="false">12፥31 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ሌዌ 19፥18</ref>።</char></note><verse eid="MRK 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32"/>ሁኩ ሕግ አስተማርቹንኩ «አስተማርቾ! ጡመሃን! ‹መገኑ ሜጥቹሃን፤ እስ ቤሉ ዎሉ መገኑ ዮበአ› ይት ጠወኦንቲሁ ሀንቅሃን።<note caller="-" style="x"><char style="xo" closed="false">12፥32 </char><char style="xt" closed="false"><ref loc="DEU 4:35">ዘዳ. 4፥35</ref>።</char></note> <verse eid="MRK 12:32"/><verse number="33" style="v" sid="MRK 12:33"/>ህካን እኮቤቺሃ መኑ ዊመ ቀልብንከስ፥ ዊመ ሰውትንከስ፥ ዊመ ወልቃንከስ መገኑ ኢቱ ሀስሰኖስ፤ ህትን ዎሉ መነ ገይስገ ኢቱ ሀስሰኖስ፤ ጭንጭ ክትመለከ ዎሉ ክትመ ጉዕመንከ መገኒሃ ኣሲች ከ ለሙ ትዛዝ አገዕሩ በተአኖ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">12፥33 </char><char style="xt" closed="false"><ref loc="HOS 6:6">ሆሴ. 6፥6</ref>።</char></note><verse eid="MRK 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34"/>ኢስን ሁኩ ሕግ አስተማርቹ ሀይማንከስ ፈንቀሼገ ለዕይ «አት መገን ዎምነቲች ቄዕርትበሃን» ዬስ፤ ህከኒች ኤተሮን ኢሰ ጠዕሞተ መለሎሁ አዪሁ ዮበአ።<verse eid="MRK 12:34"/></para>
  <para style="s1">መሲህተኔሃ ሆንጠኮ ጠዕምቱተ</para>
  <para style="r">(<ref loc="MAT 22:41-46">ማቶ. 22፥41-46</ref>፤ <ref loc="LUK 20:41-46">ሉቃ. 20፥41-46</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35"/>ኢስ ዱእ ምኔን ተማርሰን «ሕግ አስተማረት ‹ፌሳንቹ መሲህ ደዉዴሃ ቤቱ› ምሀ ይታአ? ይ ጠዕሜሰ። <verse eid="MRK 12:35"/><verse number="36" style="v" sid="MRK 12:36"/>ዳዉድ ገዉንኩስ መሲህተኔሃ መገን ጠሊሉ አያኑ አዎንሴሃንስ</para>
  <para style="q1" vid="MRK 12:36">« ‹መገኑ ኢ ቀርቺሃ</para>
  <para style="q2" vid="MRK 12:36">አን ባለጋራክ ሎካችክ ዎሮን አኦሄተ ኢለሬተ</para>
  <para style="q2" vid="MRK 12:36">መኬኤ አዲን አፉዕል ዬእ› ይዮስ።<note caller="-" style="x"><char style="xo" closed="false">12፥36 </char><char style="xt" closed="false"><ref loc="PSA 110:1">መዝ. 110፥1</ref>።</char></note><verse eid="MRK 12:36"/></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37"/>ዳዉድ ገዉንኩስ ‹ቀርቾ› ይ ገኤሲች መሲህ ሀት እክ ደዉዴ ቤቱ እሀኖ?» ህከኔን ልግቡ መኑ ኢስ ጠወአኖሃ ተሽቲን ሞጮጭታኢት እቅ።<verse eid="MRK 12:37"/></para>
  <para style="s1">ሕግ አስተማረተለከ ፈርሳውያኑት ዎቀሰንቶገ</para>
  <para style="r">(<ref loc="MAT 23:1-36">ማቶ. 23፥1-36</ref>፤ <ref loc="LUK 20:45-47">ሉቃ. 20፥45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38"/>ኢስ ተማርሰን እሰንተ «ሕግ አስተማራች አገዕርዬ፤ እሰ ቅራዕሩ ኦድኑተ ኦደእ ሃንተን ጌቤ ኣዜን ኬዕምኚን ጠዉሲሶኖሰተ ኢትታአ። <verse eid="MRK 12:38"/><verse number="39" style="v" sid="MRK 12:39"/>እሰን ጭምት ምናን ኬዕምኝ ቦርጭማን አፉዕሉለከ ድግሳኒን ኬዕምኝ ቤቾን አፉዕሉ ኢትታአ። <verse eid="MRK 12:39"/><verse number="40" style="v" sid="MRK 12:40"/>አመሰልት ቅራርስት ዱአ አተን ምንሰ አኑ ሬዮ ሜንቱ ጣንስተን እታአ፤ ህካን እኮቤቺሃ እሳሃ በተአኖ ፍርዱ አሌሰ እሀኖ» ዬእ።<verse eid="MRK 12:40"/></para>
  <para style="s1">ምንሴ አኑ ሬዮ መንቾ ኣስቱተ</para>
  <para style="r">(<ref loc="LUK 21:1-4">ሉቃ. 21፥1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41"/>ኢስ ዱአ አኤኖ ምኔን ሰደቀ ብረ ዎሬኖ ቀዎ ሳጥን መዴን ኣፉዕል ኡመቱ ብረ ኣሰኖሃ ለአኖት እቅ፤ ህከኔን ልግቡ ቀባጣሙ መኑ ልግብ ብረ ኣሰኖት እቅ። <verse eid="MRK 12:41"/><verse number="42" style="v" sid="MRK 12:42"/>ህከ ወክት መት ቡጥቹት ምንሴ አኑ ሬዮ መንቹት አሜት ለሙ ሳንትበ እሀኖ ናስ ብረ ኣቶኡ። <verse eid="MRK 12:42"/><verse number="43" style="v" sid="MRK 12:43"/>ኢስ አሳበስ እስበ ገእ «ሀንቅንከ ያንክዕኔ፤ ከን ሳጥን ኣዜን ብረ ዎርቶሀኑኡች ጉዕሚችን ምንሴ አኑ ሬዮ ቡጥቹት መንቹት በትስ ኣቶኡ። <verse eid="MRK 12:43"/><verse number="44" style="v" sid="MRK 12:44"/>መሰንትስ ዎሉ ጉዕሙንኩ ኣቶኢሁ ዮሰ ቀባጦች ፈቆሰሃን፤ ጠዉ እኮጎሬ ት ቡጥቹት መቱርቹሃ ፌሱዕናን ዮሴሃ ጉዕመንከ ኣቶኡ» ዬሰ።<verse eid="MRK 12:44"/></para>
  <chapter eid="MRK 12"/>
  <chapter number="13" style="c" sid="MRK 13"/>
  <para style="s1">ዱእ ምኑ ድጀመኖገ ኢስ ራጎገ</para>
  <para style="r">(<ref loc="MAT 24:1-44">ማቶ. 24፥1-44</ref>፤ <ref loc="LUK 21:5-33">ሉቃ. 21፥5-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1"/>ኢስ ዱእ ምኒች ፉለንን አሳባች መቱ «አስተማርቾ! ከ አጀብሲሰኖ ዱእ ምኒ ክኑለከ ግምብ ምነታ ለእ» ዬእ። <verse eid="MRK 13:1"/><verse number="2" style="v" sid="MRK 13:2"/>ኢስ «ከ ሎረ ምኒ ለኣንቲትንዶ? ኩ ክኑ ድጀሙዕናን መቱ ክኑ መቶ ክን አሌን ግምበሞገ ፈቀኖበአ» ይ ፈንቀሼእ።<verse eid="MRK 13:2"/></para>
  <para style="s1">አኬሩ ዘማን መላተ</para>
  <para style="r">(<ref loc="MAT 24:3-14">ማቶ. 24፥3-14</ref>፤ <ref loc="LUK 21:7-19">ሉቃ. 21፥7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3"/>ኢስ ዱአ አኤኖ ምኒች ብሬ አዲን ዘይት ሀቁ ነጰኖ ቆተ አሌን አፉዕልዮሀኔን ጴጥሮስ፥ ያቁቢ፥ ያህይለከ እንድራስ ሜጡበ ኢስበ መርት <verse eid="MRK 13:3"/><verse number="4" style="v" sid="MRK 13:4"/>«ኩን እሀኖሁ መ ወክትዪት? ህትን ሁኩ ጠዉ ጉዕሙንኩ እሆተ ሆንጠኮ ወክት መላስ መሃጎር ኩልኔ» ይት ጠዕምቶስ።<verse eid="MRK 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5"/>ኢስ እሰንተ «አዪሁ ሉስሰኖህዕኔበእገ አገዕርዬ። <verse eid="MRK 13:5"/><verse number="6" style="v" sid="MRK 13:6"/>ልግቡ መኑ ‹አን መሲህት› ይተን ኢ ሱዕሚን አሜት ልግብ መነ ሉሲሳአ። <verse eid="MRK 13:6"/><verse number="7" style="v" sid="MRK 13:7"/>አዕኑ በገዝ ዱዱቡለከ በገዙሃ ሞጮጭቴነንተ ወክት ህልቆኖቼ፤ ሁኩን ሆሮ እሁዕነ ፈቀኖበአ፤ ጠዉ እኮጎሬ ሁኩንን ኣዱንያ ጎፊሃ መጨረሸስበአ። <verse eid="MRK 13:7"/><verse number="8" style="v" sid="MRK 13:8"/>ህካን እኮቤቺሃ መኑ መን አሌን ዎሙ ዎም አሌን ኬአኖ፤ ህትን አደደ ቤቾን ኡለ ሌንቄቁለከ ጎሩ እሀኖ፤ እኮጎሬ ሁኩን ኒጠና ኦርሻተ ወኔሃን።<verse eid="MRK 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9"/>«መኑ አፍ ዳኛኖተ ኣሰኖህዕኔ፤ ህትን ጭምት ምኔን ዎቀርታህዕኔ፤ ህካን እኮቤቺሃ አዕኑ ገዉክዕኔ አገዕርዬ፤ ኢ ሱዕምተኔሃ ምስክር እኮኖተ ሹመለከ ዎመ ብሬን ፍርዲሃ ኡርቴነንተ።<note caller="-" style="x"><char style="xo" closed="false">13፥9 </char><char style="xt" closed="false"><ref loc="MAT 10:17-20">ማቶ. 10፥17-20</ref>።</char></note> <verse eid="MRK 13:9"/><verse number="10" style="v" sid="MRK 13:10"/>ሄጭ ተሽት ላገት ኡመቲሃ ጉዕሚንከ ዱዱብሰሙ ሀስሰኖ። <verse eid="MRK 13:10"/><verse number="11" style="v" sid="MRK 13:11"/>መኑ አፍ ዳኛኖበ ሆንጠህሰኖህዕኔ ወክት ‹መ ይናም?› ህከረንገ መ ጠወዕናም?» ይቴነን ጨነቀንቶኖቼ፤ እኮጎሬ ህከ ወክት ኣሰንታህዕኔ ላገተ ጠወዕዬ፤ መሰንትስ ህከ ወክት ጠወአኖሁ ጠሊለ አያነ ቤሉ አዕኖበአ። <verse eid="MRK 13:11"/><verse number="12" style="v" sid="MRK 13:12"/>ህከ ወክት አመቤቱ አመስቤቱ፥ አኑሁ ቤቱስ ሾኖተ ህግሽ ኣሰኖ፤ ህትን ኦሱት አንለከ አመ አሌን ዲኖማን ኬእ ሽታሰ። <verse eid="MRK 13:12"/><verse number="13" style="v" sid="MRK 13:13"/>ኢ ሱዕምተኔሃ ጉዕሙንኩ መኑ ግበኖህዕኔ፤ ጠዉ እኮጎሬ መጨረሸ ኢለ አደቢን አታዕለኖሁ ጡመኖ።<note caller="-" style="x"><char style="xo" closed="false">13፥13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">ማቶ. 10፥22</ref>።</char></note><verse eid="MRK 13:13"/></para>
  <para style="s1">ጨነቃ ኦርሸተ</para>
  <para style="r">(<ref loc="MAT 24:15-28">ማቶ. 24፥15-28</ref>፤ <ref loc="LUK 21:20-24">ሉቃ. 21፥20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14"/>ኮፍየኖ ሂሉርቹ እሁ ገበእበቤቾን እሀኖሃ ለኤነንተ፤ ህከ ወክት ህካን አነበበኖሁ ሰውዩን፤<note caller="+" style="f"><char style="fqa" closed="false">አነበበኖሁ ሰውዩን፦ </char><char style="ft" closed="false">ዬኢሁ ኢሰ እሁዕነ ማርቆሴህት።</char></note> ህካን እኮቤቺሃ ይሁድ ባዶን ዮ መኑ ቆተተ ሁንቱን።<note caller="-" style="x"><char style="xo" closed="false">13፥14 </char><char style="xt" closed="false"><ref loc="DAN 9:27">ዳን. 9፥27</ref>፤ <ref loc="DAN 11:31">11፥31</ref>፤ <ref loc="DAN 12:11">12፥11</ref>።</char></note> <verse eid="MRK 13:14"/><verse number="15" style="v" sid="MRK 13:15"/>ምኒ እሌ አሌን ዮ መንቹ ምኒች መቱርቹ ኣኣም የን ድረን ወክት ቤሱንከ።<note caller="-" style="x"><char style="xo" closed="false">13፥15 </char><char style="xt" closed="false"><ref loc="LUK 17:31">ሉቃ. 17፥31</ref>።</char></note> <verse eid="MRK 13:15"/><verse number="16" style="v" sid="MRK 13:16"/>ህትን አቡረ ቤቾን ዮኢሁ ኦድኑስ ኣኦተ ኤተሩ ዋል ምንስ ፈንቀሉንከ። <verse eid="MRK 13:16"/><verse number="17" style="v" sid="MRK 13:17"/>ህከ ወክት ላፈ ሜንቲሃለከ ቀንስታ ሜንቲሃ ኦርሸት በተኣሰ። <verse eid="MRK 13:17"/><verse number="18" style="v" sid="MRK 13:18"/>ሁኩን ጉዕሙንኩ ከርሜን እሀኖበዕገ ዱአ አዕዬ። <verse eid="MRK 13:18"/><verse number="19" style="v" sid="MRK 13:19"/>ህከ ወክት መገኑ ክልቀት ከለቆች ከበሬ ኢለ እኮበእ ኦርሸት እካአ፤ ህትን ህትኔ ጭንቀት ከ ኤተሩ እካበአ።<note caller="-" style="x"><char style="xo" closed="false">13፥19 </char><char style="xt" closed="false"><ref loc="DAN 12:1">ዳን. 12፥1</ref>፤ <ref loc="REV 7:14">መና. 7፥14</ref>።</char></note> <verse eid="MRK 13:19"/><verse number="20" style="v" sid="MRK 13:20"/>ቀርቹ ህከ በራከተ ገቦትሾበዕቃኔተ መኑ ጉዕሙንኩ ጡመኖበአ እቅ፤ ጠዉ እኮጎሬ እስ መጠሮ መንተኔሃ በራከስ ገበንቹ አአኖ።<verse eid="MRK 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21"/>ህከ ወክት አዪሁ «መሲህ ሁኩዕኑን ከበ ዮኡ» ህከረንገ «ሁኩዕኑን ካጳ ዮኡ» ዬህዕኔጎሬ አመዕንቶኖቼ። <verse eid="MRK 13:21"/><verse number="22" style="v" sid="MRK 13:22"/>ክዝብ መሲሁለከ ክዝብ ነብያኑት አሜታአ፤ እሰን አታለሞሰ ጎሬ መገኑ መጠሮ መነ ሉሲሶተ አጀብሲሰኖ ጠወ አታአ። <verse eid="MRK 13:22"/><verse number="23" style="v" sid="MRK 13:23"/>እኮጎሬ ኩ ጠዉ እሆተ ሄጭ ጉዕመርቹንከ ኩሎንክዕኔቤቺሃ አገዕርዬ።<verse eid="MRK 13:23"/></para>
  <para style="s1">መሲህ ፈንቀል አሜቱስ</para>
  <para style="r">(<ref loc="MAT 24:29-31">ማቶ. 24፥29-31</ref>፤ <ref loc="LUK 21:25-28">ሉቃ. 21፥25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24"/>ህከ ወክት ኦርሻች ኤተሮን አርቹት ቱንስቹ እካአ፤ ህትን አገንቹ ለሊሰኖበአ። <verse eid="MRK 13:24"/><verse number="25" style="v" sid="MRK 13:25"/>ቤዜት ሰሜች ኡባአ፤ ህትን ሰማን ዮ ዎልቀት ጉዕሙርቹንኩ ሌንቄቀኖ።<note caller="-" style="x"><char style="xo" closed="false">13፥25 </char><char style="xt" closed="false"><ref loc="ISA 34:4">ኢሳ. 34፥4</ref>፤ <ref loc="JOB 2:10">አዩ. 2፥10</ref>፤ <ref loc="REV 6:13">መና. 6፥13</ref>።</char></note> <verse eid="MRK 13:25"/><verse number="26" style="v" sid="MRK 13:26"/>ህከኒች ኤተሮን እሰን መንች ቤቱ ሎረ ወልቃንለከ ኬዕምኝን ጎመ ኣዚን አሜተን ለኣአ።<note caller="-" style="x"><char style="xo" closed="false">13፥26 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳን. 7፥13</ref>፤ <ref loc="REV 1:7">መና. 1፥7</ref>።</char></note> <verse eid="MRK 13:26"/><verse number="27" style="v" sid="MRK 13:27"/>ህከኒች ኤተሮን እስ መላይከተ ሶክ ሾሎንከ አዲን ሰሜች ዎሮን ኡለ ዳንጊች ዳንገ ኢለ መገኑ መጠሮ መነ ጭምአአኖ።<verse eid="MRK 13:27"/></para>
  <para style="s1">ቀርቹ አሜተኖገ ለሊሰ ኦድ ሀቁቾ ምሳልተ</para>
  <para style="r">(<ref loc="MAT 24:32-35">ማቶ. 24፥32-35</ref>፤ <ref loc="LUK 21:29-33">ሉቃ. 21፥29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28"/>ኦድ ሀቁቾ ምሳልት ተማርስቱንክዕኔ፤ ሀሙንኩሴ ቀንሰንለከ ሀበረ ኤብ ለተኖ ወክት ሀጎ ሆንጠሁስ ደጌነንተ። <verse eid="MRK 13:28"/><verse number="29" style="v" sid="MRK 13:29"/>ህትን አዕኑ ሁኩ ጉዕሙንኩ ጠዉ እሀን ለኤንተ ወክት ኡሮን ሆንጠኮሃ እሁስ ደጌ። <verse eid="MRK 13:29"/><verse number="30" style="v" sid="MRK 13:30"/>ሀንቅንከ ያንክዕኔ፤ ከን ዘማን መኑ ኩ ጠዉ እሁዕነ ሄጭ ህገኖበአ። <verse eid="MRK 13:30"/><verse number="31" style="v" sid="MRK 13:31"/>ሰሞሁለከ ኡለት ህጋአ፤ ጠዉ እኮጎሬ ላገኤ ሆሮን ህጋበአ።<verse eid="MRK 13:31"/></para>
  <para style="s1">ቀርቹ አሜተኖ በር አዪሁ ደገኖበአ</para>
  <para style="r">(<ref loc="MAT 24:36-44">ማቶ. 24፥36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32"/>ህከ በርለከ ህከ ወክት መገን ቤሉ አዪሁ ደጎተ አታለኖበአ፤ ህትን ሆሮን ሰሜ መላይከትለከ ቤቱሁ ደገኖበአ።<note caller="-" style="x"><char style="xo" closed="false">13፥32 </char><char style="xt" closed="false"><ref loc="MAT 24:36">ማቶ. 24፥36</ref>።</char></note> <verse eid="MRK 13:32"/><verse number="33" style="v" sid="MRK 13:33"/>አዕኑ ወክቱስ መ ወክት እሀኖጎሬ ደጌነንተበእቤቺሃ ጠረኝቴን አገዕርዬ። <verse eid="MRK 13:33"/><verse number="34" style="v" sid="MRK 13:34"/>ሁኩንን መቱ ዎቃ ሃመኖ መንቹ አጉደኖ፤ እስን ምንስ አጉር ሃመን ካዲመስ እስገ እክ ሆጉተ አታገ መት-መትሃሰ ሆጉተ ኣሴእ፤ ህትን አገራንቹንከ ጠረኝት አገር ይ አዘዦ።<note caller="-" style="x"><char style="xo" closed="false">13፥34 </char><char style="xt" closed="false"><ref loc="LUK 12:36-38">ሉቃ. 12፥36-38</ref>።</char></note> <verse eid="MRK 13:34"/><verse number="35" style="v" sid="MRK 13:35"/>ህካን እኮቤቺሃ ምንስ አኑ መ ወክት አሜተኖጎሬ ደጌነንተበእቤቺሃ ጠረኝቴን አገዕርዬ፤ መሰንትስ እስ ሀዎሩተ ህከረንገ ሀንከዕሬ በላን ህከረንገ ሀንጠቦ ወደን ህከረንገ ሱጵተ አሜቱስ ደጌነንተበአ። <verse eid="MRK 13:35"/><verse number="36" style="v" sid="MRK 13:36"/>ህካን እኮቤቺሃ ድንገቴን ኦሳኤናን አሜተኖበዕገ ጠረኝቴን አገርዕዬ።<verse eid="MRK 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 13:37"/>«ክዕኔሃ ኩሎምገን ዎሎ መኒሃ ጉዕሚንከ ጠረኝቴን አገዕርዬ! ያም» ይ ተማርሴእ።<verse eid="MRK 13:37"/></para>
  <chapter eid="MRK 13"/>
  <chapter number="14" style="c" sid="MRK 14"/>
  <para style="s1">ኢስ አሌን አድመ አኤመገ</para>
  <para style="r">(<ref loc="MAT 26:1-5">ማቶ. 26፥1-5</ref>፤ <ref loc="MAT 22:1-2">22፥1-2</ref>፤ <ref loc="JHN 11:45-53">ያህ. 11፥45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1"/>ሻሽገለከ ራጭቱ ዮበኢሃ ጨልሰሞ እቸተ እቴነን ከበጄኖ ከበጀ በሪሃ ለሙ በሩ ፈቆስ እቅ፤ ቂስ አዎንሳኑትለከ ሕግ አስተማረት ኢሰ መኑ ደጉዕነ አፍ ሽቶተ እሳሃ ቆሀኖ ዎቃሃ ሀሳኢት እቅ።<note caller="-" style="x"><char style="xo" closed="false">14፥1 </char><char style="xt" closed="false"><ref loc="DEU 12:1-7">ዘዳ. 12፥1-7</ref>።</char></note> <verse eid="MRK 14:1"/><verse number="2" style="v" sid="MRK 14:2"/>ጠዉ እኮጎሬ እሰን «ከን ከበጀ በሬን አፎኑንከ፤ መሰንትስ መኑ ብተተ ኬሰኖ» ይቶኡ።<verse eid="MRK 14:2"/></para>
  <para style="s1">ኢሲሃ ሽቱተ ቡርቶ መንቹተ</para>
  <para style="r">(<ref loc="MAT 26:6-13">ማቶ. 26፥6-13</ref>፤ <ref loc="JHN 12:1-8">ያህ. 12፥1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3"/>ጎግ አሌን ፉልታ ጥዘነት አፎስ «ስሞኔ» ዬኖ መንች ምኔን ብታን ከተማን ኢስ ማዳን አፉዕልዮ እቅ፤ ህከ ወክት መት መንቹት «አልባስጥሮሰ» ዬኖ ክኒች መክሴመ ብልቃጣን «ናርዶሰ» ዬኖ ሽቱት ዊንቶኢሃ አፍ አሜቶኡ፤ ሽቱስን አበ ጤአተ እቅ፤ እሴን ብልቃጥ እፈ ብጥ ሽቱስ ኢስ ቡዕላን ዱንቶኡ።<note caller="-" style="x"><char style="xo" closed="false">14፥3 </char><char style="xt" closed="false"><ref loc="LUK 7:37-38">ሉቃ. 7፥37-38</ref>።</char></note> <verse eid="MRK 14:3"/><verse number="4" style="v" sid="MRK 14:4"/>ህከኔ ሄዕዮ መኒች መት-መቱሰ ኡሙዕርት «ኩ ሽቱት ተሳን በኣኢሁ ሚሃት? <verse eid="MRK 14:4"/><verse number="5" style="v" sid="MRK 14:5"/>ኩ ሽቱት ሰሴ ጥቤ ዲናረ ህሬን ብረስ ቡጥቻኖተ ኣሴመ እቃን ጡመሃበእንዶ?» ይተን መንቹተ ቀነጦሴ። <figure style="fig" alt="Alabaster jars" file="HK00142B.tif" size="span" ref="14፥3">አልባስጥሮስ ብልቃጠ</figure><verse eid="MRK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6"/>ጠው እኮጎሬ ኢስን «እሴተ ሚሃት ኦርሴነንተሴሁ? አጉሬሴ፤ እሴ ኤሳሃ ጡመርቹ አቶኤ። <verse eid="MRK 14:6"/><verse number="7" style="v" sid="MRK 14:7"/>ቡጥቻኑት ጉዕመ ወክትንከ ክዕኔን ሜጡበ ሄኣቤቺሃ ሀሴንተ ወክት ሀዕልቶኖሰተ አታልቴነንተ፤ ጠዉ እኮጎሬ አን ክዕኔን ጉዕመ ወክት ከኔ ሄኣምበአ።<note caller="-" style="x"><char style="xo" closed="false">14፥7 </char><char style="xt" closed="false"><ref loc="DEU 15:11">ዘዳ. 15፥11</ref>።</char></note> <verse eid="MRK 14:7"/><verse number="8" style="v" sid="MRK 14:8"/>እሴ አቶተ አታልቶኢሃ አቶኤ፤ አን ሞገሙዕናን ሄጭት አሌንከኤ ሽቱተ ቡርቶኤ። <verse eid="MRK 14:8"/><verse number="9" style="v" sid="MRK 14:9"/>ሀንቅንከ ያንክዕኔ፤ ኡለ አሌን ተሽት ላገተ ዱዱብሴኖ ቤቾን ጉዕማንን እሴ አቶርቹ እሴተ ቃጎኖተ ኩለመኖሴ» ዬሰ።<verse eid="MRK 14:9"/></para>
  <para style="s1">ይሁድ ኢሰ ህግሽ ኣሶተ አማዕለሙስ</para>
  <para style="r">(<ref loc="MAT 26:14-16">ማቶ. 26፥14-16</ref>፤ <ref loc="LUK 22:3-6">ሉቃ. 22፥3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10"/>ህከኒች ኤተሮን ቶነ ለሞንከ አሳባች መቱስ አስቆሮንቶ ይሁድ ኢሰ ህግሽ ኣሶተ ቂስ አዎንሳኖቤቹ ኦሮዕዮ። <verse eid="MRK 14:10"/><verse number="11" style="v" sid="MRK 14:11"/>እሰን ህካን ሞጮጭቶ ወክት ሙንደእ እሲሃ ብረ ኣቶተ ላገተ ኣጎኡ፤ ይሁድን ህከን ወክቲች ኬሽ ኢሰ ህግሽ ኣሶሰተ ጡመ ወክት ሀሰኖት እቅ።<verse eid="MRK 14:11"/></para>
  <para style="s1">ኢስ ሻሽግ ሁርባት አሳባንተስን እቱስ</para>
  <para style="r">(<ref loc="MAT 26:17-25">ማቶ. 26፥17-25</ref>፤ <ref loc="LUK 22:7-14">ሉቃ. 22፥7-14</ref>፤ <ref loc="LUK 21:23">21፥23</ref>፤ <ref loc="JHN 13:21-30">ያህ. 13፥21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12"/>ሻሽግ ሆልቹ ጎራጤን ጦሮሹ እቴነን ከበጄኖ ከበጀ ዎኔ በሬን አሳበስ ኢስበ አሜት «ሻሽግ ሁርባት እቶተ ሀከቤቹ መርን ቅጥ አዕኖሄተ ሀሰን?» ይት ጠዕምቶስ።<verse eid="MRK 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13"/>እስን አሳባችስ ለሙሰ «ከተመ መርቴን ዊ ኮሩ እጄ መንቺን ደቀንቴንስ ህከ መንቹንከ አዎኜ። <verse eid="MRK 14:13"/><verse number="14" style="v" sid="MRK 14:14"/>እስ ኣገኖ ምኒ መርቴን ምንስ አነ ‹አስተማርቹ አሳባንን ሻሽግ ሁርባት እታም ኮህ ምኑ ሀከንቤቾንት? የኖት› ይዬ ይ ሶኮሰ። <verse eid="MRK 14:14"/><verse number="15" style="v" sid="MRK 14:15"/>እስን ሎረ አልባዕሎ ፉቅ ምኔን ሀስሰኖህዕኔርቹ ጉዕሙንኩ ቅጠሞኢሃ ለሊሰኖህኔ፤ ህከን ቤቾን ቅጥአዕዬ» ዬሰ።<verse eid="MRK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16"/>ለሙንኩ አሳበንት ህከንቤቺች ፉልት ከተመ መርቶኡ፤ እሳንከ ኢስ ዬገን ጉዕሙርቹንኩ እኮ፤ ህካን እኮቤቺሃ እሰን ሻሽግ ሁርባት ህከን ቤቾን ቅጥአቶኡ።<verse eid="MRK 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17"/>ኡለት ሀዎርቶ ወክት ኢስ ቶና ለሞንከ አሳባን ሜጡበ አሜቾ። <verse eid="MRK 14:17"/><verse number="18" style="v" sid="MRK 14:18"/>ህከን ቤቾን ጉዕሙንኩሰ ማዳን አፉዕልት እተንን ኢስ «ሀንቅንከ ያንክዕኔ፤ ክዕኔች መቱ ኢን ከኔ ቴሱ ሁርባት እተኖሁ ኤሳሃ ህግሽ ኣሰኖ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">14፥18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">መዝ. 41፥9</ref>።</char></note><verse eid="MRK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19"/>እሰን ህከ ወክት አበ ሻዝ ተሪን ተሪን ኢሰ «አኔትንዶ?» ይተን ጠዕምቶኡ።<verse eid="MRK 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20"/>ኢስን ፈንቀሽ «ህካን አአኖሁ ቶነ ለሚችክዕኔ መቱሃስ፤ እስን ኢን ሜጡበ ብጥራን አንገተ ወር እተኖሃን። <verse eid="MRK 14:20"/><verse number="21" style="v" sid="MRK 14:21"/>መንች ቤቱዕኑ እስተኔሃ ከተበሞገን ሬሁዕናን ፈቀኖበአ፤ ጠው እኮጎሬ መንች ቤቱ ህግሽ ኣሰኖሀኒሃ ቆሀኖስ፤ ሁኩ መንቹ ሄጭ ከለቀሞበእቀ ቆሀኖስ እቅ» ዬእ።<verse eid="MRK 14:21"/></para>
  <para style="s1">ጠሊለ ቁርባን ሴራ</para>
  <para style="r">(<ref loc="MAT 26:26-30">ማቶ. 26፥26-30</ref>፤ <ref loc="LUK 22:14-20">ሉቃ. 22፥14-20</ref>፤ <ref loc="1CO 11:23-25">1 ቆሮ. 11፥23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22"/>እሰን ሜጡበ እተንን ኢስ ጦሮሹ ኬሽ ዱአ አዕይ ብጭ አሳባተ «ሂዕዬ፤ ኩን ማላኤ» ይ ኣሴሰ።<verse eid="MRK 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23"/>ጠበቴሃ ኬሽ ዱአ አዕይ አሳባተስ ኣሴእ፤ ጉዕሙንኩሰ ህከን ጠበቴች አጎኡ። <verse eid="MRK 14:23"/><verse number="24" style="v" sid="MRK 14:24"/>ህትን ኢስ እሳሃ «ኩን ልግብያ መኒሃ ዱንተአኖሃ ወኣድ ቄጓኤ።<note caller="-" style="x"><char style="xo" closed="false">14፥24 </char><char style="xt" closed="false"><ref loc="EXO 24:8">ፉል. 24፥8</ref>፤ <ref loc="JER 31:31-34">ኤር. 31፥31-34</ref>።</char></note> <verse eid="MRK 14:24"/><verse number="25" style="v" sid="MRK 14:25"/>ሀንቅንከ ያንክዕኔ፤ መገን ዎምነቴን ሃዕሮ ሃሌን አጋሚሃ ኢለ ከን ወይን ላልቺች ጩንሸሞሃ ለንኪሃ አጋምበአ» ዬሰ።<verse eid="MRK 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26"/>ህከኒች ኤተሮን መዝሙረ ዘመርት ዘይት ሀቁ ነጰኖ ቆተተ ፉልቶኡ።<verse eid="MRK 14:26"/></para>
  <para style="s1">ጴጥሮስ ለገአኖስገ ኢስ ሄጭ ጠወኡስ</para>
  <para style="r">(<ref loc="MAT 26:31-35">ማቶ. 26፥31-35</ref>፤ <ref loc="LUK 22:31-34">ሉቃ. 22፥31-34</ref>፤ <ref loc="JHN 13:36-38">ያህ. 13፥36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27"/>ኢስን አሳባስ « ‹ዜማንቹ ዎቀር ሻም፤ ሆለንትስ ብን ይታአ› የመም ከተበሞቤቺሃ ጉዕሙንኩክዕኔ ኤሳሃ ለገኤን አጉርቴን ሁንቴነንተ።<note caller="-" style="x"><char style="xo" closed="false">14፥27 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">ዘካ. 13፥7</ref>።</char></note> <verse eid="MRK 14:27"/><verse number="28" style="v" sid="MRK 14:28"/>ጠዉ እኮጎሬ ሬሆች ኬዕዮሚች ኤተሮን ገሊለተ ክዕኔተ ሄጭ መራም» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">14፥28 </char><char style="xt" closed="false"><ref loc="MAT 28:16">ማቶ. 28፥16</ref>።</char></note><verse eid="MRK 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29"/>ህከ ወክት ጴጥሮስ ፈንቀሽ «ዎሉ መኑ ጉዕሙንኩ ለገዕዮሄ ጎሬ አን ሆሮን ለገኣንኬበአ» ዬእ።<verse eid="MRK 14:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30"/>ኢስን ጴጥሮሴ ፈንቀሽ «ሀንቅንከ ያንኬ፤ ከበሬ ሀንከዕርተ ሀንጠቦ ለሞረ ወዱዕናን ሄጭት ሰሶረ ለገኣንቴኤ» ዬእ።<verse eid="MRK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31"/>ጠው እኮጎሬ ጴጥሮስ «አን ኪን ሜጡበ ሬሀም ጎሬሁ ለገኣንኬበአ» የን ጠረኝሽ ጠወዕዮ፤</para>
  <para style="p" vid="MRK 14:31">ፈቆ አሳበንት ጉዕሙንኩ ህትን ይቶኡ።<verse eid="MRK 14:31"/></para>
  <para style="s1">ኢስ ጌቴሴማኔን ዱአ አኡስ</para>
  <para style="r">(<ref loc="MAT 26:36-46">ማቶ. 26፥36-46</ref>፤ <ref loc="LUK 22:39-46">ሉቃ. 22፥39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32"/>ህከኒች ኤተሮን «ጌቴሴማኔ» ዬኖቤቹ መርቶኡ፤ ህከን ቤቾን ኢስ አሳባንተስን «አን ዱአ አኦተ ኢለ ከንቤቾን አገሬ» ዬሰ። <verse eid="MRK 14:32"/><verse number="33" style="v" sid="MRK 14:33"/>እስን ጴጥሮሴ፥ ያቁበለከ ያህይ አዎንስ ኦሮዕዮ፤ ህከን ቤቾን እስን አበ ሻዘን ጨነቀሙ ጀመሮ። <verse eid="MRK 14:33"/><verse number="34" style="v" sid="MRK 14:34"/>እሳንከ «ነብሴቹኤ ሬቶተ ኢለ አበ ሻዞኡ፤ አዕኑ ከኔ ግሶኑዕናን አገሬ» ዬሰ። <verse eid="MRK 14:34"/><verse number="35" style="v" sid="MRK 14:35"/>እሳችን ቀው ቄዕር ኦሮዕዮ፤ ሚኔንከስ ኡላን ጎምብሰም ኡብ አታለመኖሄ ጎሬ ሁኩ ኦርሸ ወክቱ እሲች ህጎተ ዱአ አዕዮ። <verse eid="MRK 14:35"/><verse number="36" style="v" sid="MRK 14:36"/>እስን «ኢ አነ! ጉዕሙርቹንኩ አታለመኖሄ፤ ከ ኦርሸ ጠበቴሃ ኢች መስ፤ ጠዉ እኮጎሬ አን ዬምገ እሁዕነ አት ኢትቶንትገ እሁን?» ይ ዱአ አዕዮ።<verse eid="MRK 14:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37"/>ህከኒች ኤተሮን ሰሶንከ አሳበስበ ፈንቀል አሜተኖ ወክት እሰን ግሶ እቅ፤ ህካን እኮቤቺሃ ጴጥሮሴ «ስሞኔ! ግሶንትዶ? ሆሮን መቱ ሳኣቲሃ በቅ ይት አገሩ አታልቶንትበዕንዶ?» ዬስ። <verse eid="MRK 14:37"/><verse number="38" style="v" sid="MRK 14:38"/>ህትን «ፌተናን ኣጌነንተበእገ ጠራኝቴን ዱአ አዕዬ፤ አያኑ ቅጥ ይዮኡ፤ ጠዉ እኮጎሬ ማሉ ላፈሃን» ዬእ።<verse eid="MRK 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39"/>ለንኪሃ ኦሮዕይ ወዕና ጠወዕዮ ላገንተ ጠወአን ዱአ አዕዮ። <verse eid="MRK 14:39"/><verse number="40" style="v" sid="MRK 14:40"/>ህከኒች ኤተሮን አሳበስበ ፈንቀል አሜተኖ ወክት ግሰኛት ኬዕምታንሰ ግሶ እቅ፤ ጠዕመኖ ወክትንከ ፈንቀሽቶተ አታልቶበአ እቅ።<verse eid="MRK 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41"/>ለንኪሃ እሰበ ፈንቀል አሜች «ቴሁ ግሴንተገለከ ፎሎጭቴንተገን ዮንተንዶ? ቴሱ እሀኖ፤ ወክቱ ኢልዮኡ፤ መንች ቤቱ ጩበኛኖ አንጋን ህግሴን ኣሴኖ። <verse eid="MRK 14:41"/><verse number="42" style="v" sid="MRK 14:42"/>ቴሱ ኬዕዬ መርኖ፤ ኤሳሃ ህግሽ ኣሰኖኤሁ ሁኩዕኑ ሆንጠኮኡ» ዬእ።<verse eid="MRK 14:42"/></para>
  <para style="s1">ኢሰ ህግሴን አሴመገለከ አፌመገ</para>
  <para style="r">(<ref loc="MAT 26:47-56">ማቶ. 26፥47-56</ref>፤ <ref loc="LUK 22:47-53">ሉቃ. 22፥47-53</ref>፤ <ref loc="JHN 18:3-12">ያህ. 18፥3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43"/>ወክትንከስ ኢስ ካን ጠወአን ሄዕዮገን ቶነ ለምችሰ መቱስ «ይሁደ» ዬኖሁ አሜቾ፤ እሲን ሜጡበ በርተለከ ብሰ አፎ ልግቡ መኑ ሄዕዮ እቅ፤ እሰን ቂስ አዎንሳኑትለከ ሕግ አስተማረት ባድ ባልቃች ሶሀንቶእረ እቅ። <verse eid="MRK 14:43"/><verse number="44" style="v" sid="MRK 14:44"/>ህግሽ ኣሰኖ ይሁድን እሰንተ አዕኑ «አን ሱንቃንሲሃ ጠረኝሴን አፌን መስዬ» ይ መላተ ኩሎሰ እቅ።<verse eid="MRK 14:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45"/>ወክትንከስ ይሁድ ደዕል አሜች ኢስበ ሆንጠክ «አስተማርቾ!» ይ ሱንቄስ። <verse eid="MRK 14:45"/><verse number="46" style="v" sid="MRK 14:46"/>ህከኒች ኤተሮን ሁኩ መኑ ኢሰ አፎኡ። <verse eid="MRK 14:46"/><verse number="47" style="v" sid="MRK 14:47"/>መዴንከስ ኡርቶሀኑኡች መቱስ ብሰ ኮብ ኣዚች ፉሽ ሎረ ቂስች ካዲንቹ መጨስ ሙሮ። <verse eid="MRK 14:47"/><verse number="48" style="v" sid="MRK 14:48"/>ህከ ወክት ኢስ «ብሰለከ በርተ አፌን አሜቴንታሁ ሽፍጥገ አፎኖኤታትንዶ? <verse eid="MRK 14:48"/><verse number="49" style="v" sid="MRK 14:49"/>ጉዕመንከ በር ዱእ ምኔን ተማርሰን ክዕኔን ሜጡበ ሄአን አፌንታኤበ እቅ፤ ጠዉ እኮጎሬ ኩን እኮሁ ጠሊለ መጻፋን ከተበሞሁ ዊሞታት» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">14፥49 </char><char style="xt" closed="false"><ref loc="LUK 19:47">ሉቃ. 19፥47</ref>፤ <ref loc="LUK 21:37">21፥37</ref>።</char></note><verse eid="MRK 14:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50"/>አሳበስ ጉዕሙንኩ እሱ አጉርት ሁንቶኡ።<verse eid="MRK 14:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51"/>ነጠለ ኦደዕዮ መቱ ዎደልቹ አዎነኖሲት እቅ፤ እሱንከ ሁኩ መኑ አፎኡ። <verse eid="MRK 14:51"/><verse number="52" style="v" sid="MRK 14:52"/>አፎስ ወክት ነጠለስ ኡጅ ከልስ ሁኝ ፉሸኤእ።<verse eid="MRK 14:52"/></para>
  <para style="s1">ኢሰ ይሁድ ፍርድ ኦገትበ መሴመስገ</para>
  <para style="r">(<ref loc="MAT 26:57-68">ማቶ. 26፥57-68</ref>፤ <ref loc="LUK 22:54-55">ሉቃ. 22፥54-55</ref>፤ 63-71፤ ያህ. 18፥13-14፤19-24)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53"/>ህትን ኢሰ ሎረ ቂሲች ምኒ መስቶስ፤ ህከን ቤቾን ቂስ አዎንሳኑት፥ ባድ ባልቀትለከ ሕግ አስተማረት ጉዕሙንኩ ጭምይቶኡ እቅ። <verse eid="MRK 14:53"/><verse number="54" style="v" sid="MRK 14:54"/>ጴጥሮስን ኢሰ ቂስ አዎንሳንች ምኒ ኡሮ ብትም ኣዝ ኢለ ቄዕራሻን አዎነኖሲት እቅ፤ ህከኔን እስ ዘበኝን ሜጡበ ጊረተ ኢብጨኖት። <verse eid="MRK 14:54"/><verse number="55" style="v" sid="MRK 14:55"/>ቂስ አዎንሳኑትለከ ኦገት ደኛኑት ጉዕሙንኩ ኢሰ ሽሲሶተ ምስክር ሀሳኢት እቅ፤ ጠዉ እኮጎሬ መቱርቹሃ ደጎበአ። <verse eid="MRK 14:55"/><verse number="56" style="v" sid="MRK 14:56"/>መሰንትስ ልግቡ ክዝብ ምስክሩ ልግብ ጠወ አሌስ መሰከርቶ እቅ፤ እኮጎሬ አሌስ መሰከርቶ ላገት አደደ እኮኡ።<verse eid="MRK 14:56"/></para>
  <para style="p">
    <verse number="57-58" style="v" sid="MRK 14:57-58"/>መቱ-መቱ መኑ ኬእ « ‹አን ከን መን አንጋን እጃረሞ ዱእ ምኒ ድጅ ዎሉ መን አንጋን እጀረሞበኢሃ ሰሶ በሬች ኤተሮን እጃራም› የን ሞጮጭኖም» ይተን ክዝብ ኢስ አሌን መሰከርቶኡ።<note caller="-" style="x"><char style="xo" closed="false">14፥57-58 </char><char style="xt" closed="false"><ref loc="JHN 2:19">ያህ. 2፥19</ref>።</char></note> <verse eid="MRK 14:57-58"/><verse number="59" style="v" sid="MRK 14:59"/>ህት ይቶ ጎሬሁ ምስክሩ ጠወዕዮ ላገት ሜጡ እኮበአ።<verse eid="MRK 14:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60"/>ሎሩ ቂስቹንኩ ብሬንከሰ ኡር ኢሰ «ጠወአንትርቹ ዮበእንዶ? ኩ መኑ ኪ አሌን መሰከርታኢሁ መርቹሃን?» ይ ጠዕሜእ።<verse eid="MRK 14:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61"/>ጠዉ እኮጎሬ ኢስ መቱርቹሃ ጠወኡናን ጨለ ዬእ፤ ሎሩ ቂስቹንኩ ኢሰ ፈንቀሽ «ማሰአሞ መገን ቤቱ መሲሁ አቴትንዶ?» ይ ጠዕሜስ።<verse eid="MRK 14:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62"/>ኢስን «ኤ አኔት፤ መንች ቤቱ ጉዕመንከ አታለኖ መገን መኬ አዲን አፉዕል ሰሜ ጎማን አሜተን ለኤነንተ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">14፥62 </char><char style="xt" closed="false"><ref loc="DAN 7:3">ዳን. 7፥3</ref>።</char></note> <verse eid="MRK 14:62"/><verse number="63" style="v" sid="MRK 14:63"/>ሎሩ ቂስቹንኩ ኦድኑስ ፊል «ዎሉ ምስክሩ ሚሃ ሀስሰኖኔ? <verse eid="MRK 14:63"/><verse number="64" style="v" sid="MRK 14:64"/>አዕኑ እስ ቦሮር ላገተ መገን አሌን ጠወአን ሞጮጭቴንታአ፤ ህካን እኮቤቺሃ ኩ ጠዉ ክዕኔሃ መ አጉደኖህዕኔ?» ዬእ፤ ህከ ወክት እሰ ጉዕሙንኩሰ መቴ ላጋን «ሬሁት ገበኣስ» ይት ፈረዶኡ።<note caller="-" style="x"><char style="xo" closed="false">14፥64 </char><char style="xt" closed="false"><ref loc="LEV 24:6">ሌዌ 24፥6</ref>።</char></note><verse eid="MRK 14:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65"/>መት-መቱ መኑ አሌስ አንጀ ቱ ዩ ጀመርቶኡ፤ እልስ ኦድኖን ድብ ኡሱርት መጫለ ዎቀርተን «ህንዴ አዬት ዎቀሮሄሁ? ደግ! ራገ ጠወእ» ይታሲት እቅ፤ ህትን አገርታሩንኩ ኦልተን መስቶስ።<verse eid="MRK 14:65"/></para>
  <para style="s1">ጴጥሮስ ኢሰ ለገኡስ</para>
  <para style="r">(<ref loc="MAT 26:69-75">ማቶ. 26፥69-75</ref>፤ <ref loc="LUK 22:56-62">ሉቃ. 22፥56-62</ref>፤ <ref loc="JHN 18:15-18">ያህ. 18፥15-18-25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66"/>ጴጥሮስን ቂስ አዎንሳንች ምኒ ዎሮ አዲን ግቤ ኣዜን ሄዕዮገን ቂስ አዎንሳንች መት ገረድቹት አሜቶኡ። <verse eid="MRK 14:66"/><verse number="67" style="v" sid="MRK 14:67"/>እሴን ጴጥሮስ ጊረተ ኢብጨን ቱክ ይት ለእ እሱ «አት ነዝሬት ኢስን ሜጡበ ሄኦንት እቅ» ይቶስ።<verse eid="MRK 14:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68"/>ጠዉ እኮጎሬ ጴጥሮስ «አን ደጋንስበአ፤ አት ይታንትንኩ ኣጎኤበአ» ይ ለገዕዮ፤ ህካን ይ አብል ፉሎገን ሀንጠቦ ዎጆ።<verse eid="MRK 14:68"/></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69"/>ህት ገረዴቹንት ጴጥሮሴ ለእ ህከኔ ኡሬ መኒሃ «ኩን እሳች መቱሃስ» ይቶኡ። <verse eid="MRK 14:69"/><verse number="70" style="v" sid="MRK 14:70"/>ጠዉ እኮጎሬ እስ ቴሁ ለገዕዮ፤ ህትን ቀዉ ጌሰ አገርት ህከኔ ኡርቶ መኑ «አት ገሊለ መንቹ እኮንትቤቺሃ ሀንቅንከ አት እሳች መቱሃስ» ይቶስ።<verse eid="MRK 14:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71"/>ጠዉ እኮጎሬ ጴጥሮስ «አዕኑ ከ ይቴነንተ መንቹ ደጋንስበአ» የን ገውስ ቦሮሩለከ ጤሌዕሉ ጀመሮ።<verse eid="MRK 14:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72"/>ህከ ወክት ሀንጠቦ ለንኪሃ ዎጆ፤ ጴጥሮስን «ሀንጠቦ ለሞረ ወዱዕነ አት ኤሳሃ ሰሶራ ለገኣንት» ዬ ኢስ ጠወዕዮ ጠወ ሰዉ ይ ቡብ ኦዕዮ።<verse eid="MRK 14:72"/></para>
  <chapter eid="MRK 14"/>
  <chapter number="15" style="c" sid="MRK 15"/>
  <para style="s1">ኢሰ ጵላጦሴበ መሴመገ</para>
  <para style="r">(ማቶ. 27፥1-2፤11-14፤ <ref loc="LUK 23:1-5">ሉቃ. 23፥1-5</ref>፤ <ref loc="JHN 18:28-38">ያህ. 18፥28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1"/>ገስመ ሱጵተ ቂስ አዎንሳኑት፥ ባድ ባልቀትለከ ሕግ አስተማረት ኦገት ደኛኖን ሜጡበ ጉዕሙንኩ ደቀንት አማዕለንቶኡ፤ ህከኒች ኤተሮን ኢሰ ኡሱርት መስት ገሻንቾ ጵላጦሴሃ ህግስ ኣቶስ። <verse eid="MRK 15:1"/><verse number="2" style="v" sid="MRK 15:2"/>ጵላጦስን ኢሰ «አት አይሁድያ ዎመንዶ?» ይ ጠዕሜስ።</para>
  <para style="p" vid="MRK 15:2">ኢስን ፈንቀሽ «አት ይቶንትጋንት» ዬስ።<verse eid="MRK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3"/>ህትን ቂስ አዎንሳኑት ኢሰ አበ ጠዊን ኦዳሲት እቅ። <verse eid="MRK 15:3"/><verse number="4" style="v" sid="MRK 15:4"/>ጠዉ እኮጎሬ ጵላጦስ ኢሰ «ሄንከ ጠዊን ኦደሄት ከ ለእ! ከን መኒሃ መቱርቹሃ ፈንቀሽታንትበዕንዶ?» ይ ለንኪሃ ጠዕሜስ።<verse eid="MRK 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5"/>ጵላጦስ አበ አጀብሲጮተ ኢለ ኢስ መቱርቹሃ ፈንቀሽዮበአ።<verse eid="MRK 15:5"/></para>
  <para style="s1">ኢስ አሌን ሬሆ ፍርደ ፈረዴመስገ</para>
  <para style="r">(<ref loc="MAT 27:15-26">ማቶ. 27፥15-26</ref>፤ <ref loc="LUK 23:13-25">ሉቃ. 23፥13-25</ref>፤ <ref loc="JHN 18:39-40">ያህ. 18፥39-40</ref>፤ <ref loc="JHN 19:1-16">19፥1-16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6"/>ጵላጦስ ዘማን ዘማኔ አይሁድ ሻሽግ ከበጀ ወክት ሂሮኖተ መኑ ሀሶኢሃ ኡሱሬመ መኒች መቱ መንቹ ሂረኖ እቅ። <verse eid="MRK 15:6"/><verse number="7" style="v" sid="MRK 15:7"/>ህከ ወክት ዎምነቱክ ግብ መነ ሽት ኡሱረንቶ መን በሊች «ባርባኔ» ዬኖ መንቹ ሄዕዮ እቅ። <verse eid="MRK 15:7"/><verse number="8" style="v" sid="MRK 15:8"/>መኑንኩ ጵላጦሴበ አሜት ሮሾገን መቱ መንቹ ሂሮተ ጠዕምቶስ። <verse eid="MRK 15:8"/><verse number="9" style="v" sid="MRK 15:9"/>እስን «አይሁድ ዎመ ሂሮህዕኔተ እትቴነንንዶ?» ይ ጠዕሜሰ። <verse eid="MRK 15:9"/><verse number="10" style="v" sid="MRK 15:10"/>ህካን ዬኢሁ ቂስ አዎንሳኑት ኢሰ ህግስ ኣቶኢሁ ጢቄን እሁስ ደጎቤቺሃት እቅ።<verse eid="MRK 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11"/>ጠዉ እኮጎሬ ቂስ አዎንሳኑት «ባርባን ሂረሙኔ ቤሉ ኢስ ሂረሙንከ» ይት መኑ ጵላጦሴ ጠዕመኖገ መነ ኬሰንስቶኡ። <verse eid="MRK 15:11"/><verse number="12" style="v" sid="MRK 15:12"/>ጵላጦስ ለንኪሃ ፈንቀሽ «ህካን እኮች ከ አዕኑ ‹አይሁድ ዎመ› ይቴነንታሃ መ አኡ?» ይ ጠዕሜእ።<verse eid="MRK 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13"/>እሰን «ሰቀል» ይተን ላገሰ ጎት አት ጨንጭቶኡ።<verse eid="MRK 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14"/>ጵላጦስን «ሚሃት? እስ አዕዮ ሂሉርቹ መርቹሃን?» ዬሰ፤</para>
  <para style="p" vid="MRK 15:14">ጠዉ እኮጎሬ እሰን «ሰቀል» ይተን ወዕኔች በትስ ጨንጭቶኡ።<verse eid="MRK 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15"/>ጵላጦስ መነ ሙንዲሲሶተ ይ ባርባኔ ሂር ገፈሮ፤ ህከኒች ኤተሮን ኢሰ ገረፍ ሰቀልቶተ ህግሽ ኣሴእ።<verse eid="MRK 15:15"/></para>
  <para style="s1">ወታደሩ ኢሳን ቀለዱሰ</para>
  <para style="r">(<ref loc="MAT 27:27-31">ማቶ. 27፥27-31</ref>፤ <ref loc="JHN 19:2-3">ያህ. 19፥2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16"/>ሮም ዎታደሩ ኢሰ ጵላጦሴ ግብተ መስቶኡ፤ ፈቆ ወታደረ ጉዕመንከ ገእቶኡ። <verse eid="MRK 15:16"/><verse number="17" style="v" sid="MRK 15:17"/>ሰመ አጉደኖ ብሸ ኦድኑተ ኢሲሃ ኦዲስ ኡት አክሊለ መክስ ቡዕለስ አቶኡ። <verse eid="MRK 15:17"/><verse number="18" style="v" sid="MRK 15:18"/>ህካን አቶች ኤተሮን «አይሁድ ዎመ! ወገሬቱ ኬሳሃ እሆሄ!» ይተን ቀለዳሲት እቅ። <verse eid="MRK 15:18"/><verse number="19" style="v" sid="MRK 15:19"/>እሰን ሾምቦቆን ቡዕለስ ዎቀርተን አንጀ አሌስ ቱ ይታኢት እቅ፤ ህትን እሰን ቀለደን ብሬስ ጉሉጵት ሰገዶስ። <verse eid="MRK 15:19"/><verse number="20" style="v" sid="MRK 15:20"/>እሰን እሲን ቀለዶች ኤተሮን ህከ ሰመ አጉደኖ ቢሸ ኦድኑተ ፉሽት ገይስ ኦድኑተ ኦድስ ሰቀልቶስተ ኣእት መርቶኡ።<verse eid="MRK 15:20"/></para>
  <para style="s1">ኢስ ሰቀለሙስ</para>
  <para style="r">(<ref loc="MAT 27:32-44">ማቶ. 27፥32-44</ref>፤ <ref loc="LUK 23:26-43">ሉቃ. 23፥26-43</ref>፤ <ref loc="JHN 19:17-27">ያህ. 19፥17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21"/>መርተንን እስክንድርለከ ሩፎሴ አኑ ቀሬን ባድ «ስሞኔ» ዬኖ መንቹ ገጠሪች ከተመ አሜተን ደቀንት ኢስ መስቀለ እጆተ ግዳጅሶስ።<note caller="-" style="x"><char style="xo" closed="false">15፥21 </char><char style="xt" closed="false"><ref loc="ROM 16:3">ሮሜ 16፥3</ref>።</char></note> <verse eid="MRK 15:21"/><verse number="22" style="v" sid="MRK 15:22"/>እሰን ኢሰ «ጎልጎተ» ዬኖቤቹ መስቶስ፤ «ጎልጎተ» ዩ ቡዕል ቁላሃ ዩሃን። <verse eid="MRK 15:22"/><verse number="23" style="v" sid="MRK 15:23"/>እሰን ኢሲሃ «ከርቤተ» ዬኖ ዘቢን ልቀለቀሞ ወይን ጠጀ አጎተ ኣቶስ፤ ጠው እኮጎሬ ኢስ አጎበአ። <verse eid="MRK 15:23"/><verse number="24" style="v" sid="MRK 15:24"/>ህከኒች ኤተሮን እሱ ሰቀልቶኡ፤ ህትን ሀኩንስ አዬሃ ኢለኖ ጎሬ ደጎተ ኦድኑስ እጠ ኡጅት ቤቀንቶኡ።<note caller="-" style="x"><char style="xo" closed="false">15፥24 </char><char style="xt" closed="false"><ref loc="PSA 22:18">መዝ. 22፥18</ref>።</char></note> <verse eid="MRK 15:24"/><verse number="25" style="v" sid="MRK 15:25"/>እሰን ኢሰ ሰቀልቶ ወክቱ ገስሜ ሰሶሃ ሳኣት እቅ። <verse eid="MRK 15:25"/><verse number="26" style="v" sid="MRK 15:26"/>ህትን ወንጀልስ ለልሶተ «አይሁድ ዎመ» የኖ ከተበሞ እቅ። <verse eid="MRK 15:26"/><verse number="27" style="v" sid="MRK 15:27"/>እሰን ኢሲን ሜጡበ ለሙ ሽፍጠ መቱ መኬ አዲን መቱስ ጉረ አዲን ሰቀልቶኡ። <verse eid="MRK 15:27"/><verse number="28" style="v" sid="MRK 15:28"/>[ከን ሃሌን «ሾከ መኒን ዎለአሞ» የመሞ ራግ ላገት ዊንቶኡ።]<note caller="-" style="x"><char style="xo" closed="false">15፥28 </char><char style="xt" closed="false"><ref loc="ISA 53:12">ኢሳ. 53፥12</ref>።</char></note><note caller="+" style="f"><char style="ft" closed="false">መት-መቱ ሉህ ክታበት ወሊንሽ 28 በርግታበአ፤ ላገንትስ ሉቃስ 22፥37 ዮኢሃ አጉደኖ።</char></note> <figure style="fig" alt="Myrrh bush, man tapping myrrh, jars, bowl" file="BK00119B.tif" size="span" ref="15፥24">ከርቤ ሀቃ</figure><verse eid="MRK 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29"/>እስ መዲን ህገኖ መኑ እሱ ህንቅ ቡዕለሰ ሌንቄቅሰን «ለዕዬስ! አት ዱእ ምኒ ድጅት ሰሶ በሬን እጃርታንቲሁ!<note caller="-" style="x"><char style="xo" closed="false">15፥29 </char><char style="xt" closed="false"><ref loc="PSA 22:7">መዝ. 22፥7</ref>፤ <ref loc="PSA 109:25">109፥25</ref>፤ <ref loc="MRK 14:58">ማር. 14፥58</ref>፤ <ref loc="JHN 2:19">ያህ. 2፥19</ref>።</char></note> <verse eid="MRK 15:29"/><verse number="30" style="v" sid="MRK 15:30"/>ህንዴ ቴሱ መስቀሊች ድርት ገውክ ፌስ» ይታሲት እቅ።<verse eid="MRK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31"/>ህትን ቂስ አዎንሳኑትለከ ሕግ አስተማረት ገገዉንኩሰን «እስ ዎሉ መነ ፌሾኡ፤ እኮጎሬ ገውስ ፌሶተ አታሎበአ። <verse eid="MRK 15:31"/><verse number="32" style="v" sid="MRK 15:32"/>እስ ፌሳንቹ መሲሁ እስራኤል ዎመ እኮጎሬ ህንዴ ቴሱ ከን መስቀሊች ድሩን፤ ነኡን ለዕን አመዕንናም» ይተን ህንቃሲት እቅ፤</para>
  <para style="p" vid="MRK 15:32">ህትን እሲን ሰቀለንቶእሩ ህትን ይተን ቦሮርታሲት እቅ።<verse eid="MRK 15:32"/></para>
  <para style="s1">ኢስ ሬሁስ</para>
  <para style="r">(<ref loc="MAT 27:45-56">ማቶ. 27፥45-56</ref>፤ <ref loc="LUK 23:44-49">ሉቃ. 23፥44-49</ref>፤ <ref loc="JHN 19:28-30">ያህ. 19፥28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33"/>ህከ በር ሌሆ ሳቲች ኬሽ ሆንሱ ሳት ኢለ ኡለ አሌን ጉዕማንን ቱንስቹ እኮ። <verse eid="MRK 15:33"/><verse number="34" style="v" sid="MRK 15:34"/>ሆንሱ ሳት እኮ ወክት ኢስ «ኤሎሄ! ኤሎሄ! ላማ ሰበቅታኒ» ይ ሎረ ላጋን ያሮ፤ ፍሳረንትስ «ኢ መገኖ! ኢ መገኖ! ሚሃ አጉርቴኤ» ዩሃን።<note caller="-" style="x"><char style="xo" closed="false">15፥34 </char><char style="xt" closed="false"><ref loc="PSA 22:1">መዝ. 22፥1</ref>።</char></note><verse eid="MRK 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35"/>ህከኔ ኡርቶ መኒች መት-መቱሰ እስ ያረኖሃ ሞጮጭት «እልያሴ ገአኖት» ይቶኡ፤ <verse eid="MRK 15:35"/><verse number="36" style="v" sid="MRK 15:36"/>እሳችን መቱስ ደጉጅ መር ሆለጮ ወይነ ጠጀ ሰፍነገ<note caller="+" style="f"><char style="fqa" closed="false">ሰፍነገ፦ </char><char style="ft" closed="false">ዩ ኳሰ አጉደኖርቹ እክ ባር ኣዜን ሙተኖ ሙተ፥ ዊሙ አሉስ እልት ዮሲሃለከ ዋሃ ሙጭ አፈኖሃ ባር ኡንጉዳይተ አጉደኖሃን።</char></note> ዬኖሀኒን ዊንሽ ጬፍ ሾንቦቆ ሰኖን አዕይ ኢሲሃ ኣስ «ህንዴ አገሬ፤ እልያስ አሜች ድርሰኖስ ጎር ለዕናም» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">15፥36 </char><char style="xt" closed="false"><ref loc="PSA 69:21">መዝ. 69፥21</ref>።</char></note><verse eid="MRK 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37"/>ህከኒች ኤተሮን ኢስ ሎረ ላጋን ያር ሬዮ።<verse eid="MRK 15:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38"/>ህከ ወክት ዱእ ምኒ መጋረጁ አሌች ወሮ ኢለ ለሙበ እክ ፊልተዕዮ።<note caller="-" style="x"><char style="xo" closed="false">15፥38 </char><char style="xt" closed="false"><ref loc="EXO 26:1-33">ፉል. 26፥1-33</ref>።</char></note> <verse eid="MRK 15:38"/><verse number="39" style="v" sid="MRK 15:39"/>ኢስ ሰቀለሞ መስቀል ብሬን ኡርዮ መቱ ጥቤ ሀለቅቹ ኢስ እክ ሬዮገ ለዕይ «ሀንቅንከ ኩን መገንያ ቤቱ እቅ» ዬእ።<verse eid="MRK 15:39"/></para>
  <para style="s1">ጎልጎታን ሄኦ ሜንቱ</para>
  <para style="r">(<ref loc="MAT 27:55-56">ማቶ. 27፥55-56</ref>፤ <ref loc="JHN 19:25-27">ያህ. 19፥25-27</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40"/>ቄዕራሻን ኡርት ለአን ሄኦ መት-መቱ ሜንቱ ህከኔ ሄኦ እቅ፤ እሰ በላን መግደል ከተም መርየማ፥ ማዕነ ያቆቤለከ ዮሲ አመት መርየማ፥ ሰሎሚ ሄኦ እቅ። <verse eid="MRK 15:40"/><verse number="41" style="v" sid="MRK 15:41"/>እሰን ኢስ ገሊላን ሄዕዮ ወክት አዎንተን ካደንታስረ እቅ፤ ህትን ኢሲን ሜጡበ የሩሳሌመ አሜቶ ልግቡ ሜንቱ ሄኦ እቅ።<note caller="-" style="x"><char style="xo" closed="false">15፥41 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">ሉቃ. 8፥2-3</ref>።</char></note><verse eid="MRK 15:41"/></para>
  <para style="s1">ኢስ ሞገሙስ</para>
  <para style="r">(<ref loc="MAT 27:57-61">ማቶ. 27፥57-61</ref>፤ <ref loc="LUK 23:50-56">ሉቃ. 23፥50-56</ref>፤ <ref loc="JHN 19:38-42">ያህ. 19፥38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42"/>በሩስ ተቃጠቤኖ በር እኮቤቺሃ ሀዎሬ ወክት ፎሎጭ በሬች ብርተ እኮ። <verse eid="MRK 15:42"/><verse number="43" style="v" sid="MRK 15:43"/>አይሁድ ኦገት ደኛኖች መቱ ጡመገ ኤንኬዕነሞ አርማትያስ ከተም ዩሱፍ መገን ዎምነቱ ተቢሴን አገዕረኖሁ ጵላጦሴበ መር መለል ኢስ ጀናዘተ ኣሶኖስተ ኡጨእ። <verse eid="MRK 15:43"/><verse number="44" style="v" sid="MRK 15:44"/>ጠው እኮጎሬ ጵላጦስ «ሀት ደዕል ሬዮ?» ይ አጀብሲጭ ጥቤ ሀለቅቹ ገእ «ሀንቅንከ ሬዮች ዱንክዮእንዶ?» ይ ጠዕሜእ። <verse eid="MRK 15:44"/><verse number="45" style="v" sid="MRK 15:45"/>እስን ኢስ ሬሁስ ጥቤ ሀለቅቹ ሞጮጬች ኤተሮን ጀናዘስ ዩሱፍ መሰኖገ ፈቀጆስ። <verse eid="MRK 15:45"/><verse number="46" style="v" sid="MRK 15:46"/>ዩሱፍን ሃዕሮ ከፈን ኦድኑተ ህዕር ኢስ ጀናዘተ መስቀል አሊች ድሪሽ ከፈኞ፤ ህከኒች ኤተሮን ክኒች ሸሄን መክሴመ ሎድ ኣዜን አፉሼእ፤ ሎረ ክኑ ኮሎንኮዕልሽ ኤብ ሎድስ ኡሩተ ጡፎ። <verse eid="MRK 15:46"/><verse number="47" style="v" sid="MRK 15:47"/>መግደል ከተም መርየመለከ ዮሳ አመት መርየማ ኢስ ጀናዘተ ሀከኔ አፉሼኖ ጎሬ ለኣኢት እቅ።<verse eid="MRK 15:47"/></para>
  <chapter eid="MRK 15"/>
  <chapter number="16" style="c" sid="MRK 16"/>
  <para style="s1">ኢስ ሬሆች ኬኡስ</para>
  <para style="r">(<ref loc="MAT 28:1-8">ማቶ. 28፥1-8</ref>፤ <ref loc="LUK 24:1-12">ሉቃ. 24፥1-12</ref>፤ <ref loc="JHN 20:1-10">ያህ. 20፥1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1"/>ፎሎጭ በሩ ህጎች ኤተሮን መግደል ከተም መርየማ፥ ያቁብ አመት መርየመለከ ሰሎሚ ኢስ ጀናዛን ቡርቶተ ሽቱተ ህዕርቶኡ። <verse eid="MRK 16:1"/><verse number="2" style="v" sid="MRK 16:2"/>አበ በር ገስመ ሱጴን አሩ ፉለንን ሎድበ መርቶኡ። <verse eid="MRK 16:2"/><verse number="3" style="v" sid="MRK 16:3"/>ገገዉንኩሰ «አይ ሎድ ኡሮች ክኑ ኮሎንኮልሽ ፈነኖኔ?» ይተን ጠወአን ሃንታኢት እቅ። <verse eid="MRK 16:3"/><verse number="4" style="v" sid="MRK 16:4"/>ህካን ይቶኢንኩ ክኑስ ሎረ እኮቤቺሃት፤ እሰን ህት ይተን ሎድበ ኦሎስ ለኣ ወክት ክኑስ ሎድ ኡሮች መቱ አደ ዋል ኮሎንኮዕልዮ እቅ። <verse eid="MRK 16:4"/><verse number="5" style="v" sid="MRK 16:5"/>ህትን ሎድ ኣዝ ኣጎ ወክት ዋጁ ኦድኑተ ኦደዕዮ ወደልቹ መኬ አዲን አፉዕሌኢሃ ለኦቤቺሃ ህልቆኡ።<verse eid="MRK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6"/>ጠው እኮጎሬ እስ እሰንተ «ህልቆኖቼ፤ አዕኑ ሀሴነንታሁ ሰቀሌመ ናዝሬት ኢሰ እሁስ አን ደጋም፤ እስ ሬሆች ኬዕዮኡ፤ ከንቤቾን ዮበአ፤ ከለዕዬ! እሱ ሞጌማ ቤቹንኩ ኩዕኑን። <verse eid="MRK 16:6"/><verse number="7" style="v" sid="MRK 16:7"/>ቴሱ መርቴን አሳባተለከ ጴጥሮሴሃ ‹ከኒች ብርተ እስ ዬህዕኔገን ክዕኔንተ ሄጭ ገሊለ መረኖ፤ ህከኔን ለኤነንተስ› ይቴን ኩሌ» ዬሰ።<note caller="-" style="x"><char style="xo" closed="false">16፥7 </char><char style="xt" closed="false"><ref loc="MAT 26:32">ማቶ. 26፥32</ref>፤ <ref loc="MRK 14:28">ማር. 14፥28</ref>።</char></note><verse eid="MRK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8"/>ሁኩ ሜንቱንኩ ዋጅት ሁጠን ሎድቢች ፉልት ሁንቶኡ፤ እሰን አበ ዋጅቶቤቺሃ መቱርቹሃ መቶ መንቺሃ ጠወኦበ እቅ።<note caller="+" style="f"><char style="fqa" closed="false">መት-መቶ ሄጭት ሄኦ መጻፋን ከን ፎሎጮን ዎሊንሽ ሄዜት አሌን ዮ ላገት በርገንቶኡ።፦ </char><char style="ft" closed="false">ሜንቱ ጴጥሮሴለከ ጃለስበ መርት መላይኬቹ ኩሎሰ ጠወ ጉዕመንከ ጠወኦኡ፤ ህከኒች ኤተሮን ኢስ ገዉንኩስ ዘላለሚሃ ጡሙ እኮ ዶረሞበእ ጠሊለ እንጂለ ሸርቂች ኬሽ ገርበ ኢለ አዎንታስሀኑኡ መሳን ሶኮ።</char></note></para>
  <para style="s1" vid="MRK 16:8">ኢስ መግደል ከተም መርየማሃ ለሉስ</para>
  <para style="r" vid="MRK 16:8">(<ref loc="MAT 28:9-10">ማቶ. 28፥9-10</ref>፤ <ref loc="JHN 20:11-18">ያህ. 20፥11-18</ref>)<note caller="+" style="f"><char style="ft" closed="false">ሄጭት ሄኦ መት-መቱ ሉህ ክታበት ዎሊንሽ 9-20 ኢለ ዮኢሃ በርግታበአ።</char></note></para>
  <para style="p" vid="MRK 16:8">[ <verse eid="MRK 16:8"/><verse number="9" style="v" sid="MRK 16:9"/>ኢስ አበ በር ገስመ ሱጵተ ሬሆች ኬዕዮች ኤተሮን ወዕና ለመሉ ሩሃንዩ ፉሎሴ መግደል መርየማን ሄጭ ደቀሞ። <verse eid="MRK 16:9"/><verse number="10" style="v" sid="MRK 16:10"/>እሴን መርት ሻዘናንለከ አልፋቴን ሄኦ አሳባተስ ኩልቶኡ። <verse eid="MRK 16:10"/><verse number="11" style="v" sid="MRK 16:11"/>እሴን «ኢስ ሬሆች ኬዕዮኡ እስን ፎሊን ዮኡ፤ አንን እሌንከኤ ለዕዮም» ይት ኩልቶሰ፤ ጠዉ እኮጎሬ እሰ ጠወስ አመዕንቶበአ።<verse eid="MRK 16:11"/></para>
  <para style="s1">ኢስ ለሞ አሳባተስ ለሉስ</para>
  <para style="r">(<ref loc="MAT 28:16-20">ማቶ. 28፥16-20</ref>፤ <ref loc="LUK 24:13-35">ሉቃ. 24፥13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12"/>ህከኒች ኤተሮን ኢስ ከተሚች ገጠረ መርተን ሄኦ ለሞንከ አሳባንተ ዎሎ ደኒን ለሌእ። <verse eid="MRK 16:12"/><verse number="13" style="v" sid="MRK 16:13"/>እሰን ፈንቀልት መርት ፈቆ አሳባተ ኩልቶኡ፤ ጠዉ እኮጎሬ እሰንተ አመዕንቶበአ።<verse eid="MRK 16:13"/></para>
  <para style="s1">ኢስ ቶነ መቶንከ አሳባተስ ለሉስ</para>
  <para style="r">(<ref loc="MAT 28:16-20">ማቶ. 28፥16-20</ref>፤ <ref loc="LUK 24:36-49">ሉቃ. 24፥36-49</ref>፤ <ref loc="JHN 20:19-23">ያህ. 20፥19-23</ref>፤ <ref loc="ACT 1:6-8">ሶቀ. 1፥6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14"/>ህከኒች ኤተሮን ቶነ መቶንከ አሳባተስ ማድ አሌን እተን ሄኦገን ኢስ ለሌሰ፤ እስን «ኢስ ሬሆች ኬዕይ ፎልን ዮኡ፤ ነኡን ለዕኖም» ይቶ ጠወ ቀልቡሰ ዱጃን አመዕኑ ሆጎቤቺሃ ዎቀሾሰ። <verse eid="MRK 16:14"/><verse number="15" style="v" sid="MRK 16:15"/>ኢስን «ጉዕማንከ ኣዱንያ አል ባዱ መሬ፤ መኒሃ ጉዕሚንከ ተሽት ላገተ ተማርስዬ፤<note caller="-" style="x"><char style="xo" closed="false">16፥15 </char><char style="xt" closed="false"><ref loc="ACT 1:8">ሶቀ. 1፥8</ref>።</char></note> <verse eid="MRK 16:15"/><verse number="16" style="v" sid="MRK 16:16"/>አመዕን ጠመቀሞሁ ፈቀኖ፤ እኮጎሬ አመዕንበሀኒሃ ፈረደመኖስ። <verse eid="MRK 16:16"/><verse number="17" style="v" sid="MRK 16:17"/>ኢን አመዕንቶሀኑኡተ ጉዕሚንከ አጀብሲሰኖ ጠወ አታ ወልቀት ኣሰንታሰ፤ ኢ ሱዕሚን ሩሃንየ ፉሽታአ፤ ህትን ወዕና ጠወእበ ሃዕሮ ላጋን ጠወኣአ። <verse eid="MRK 16:17"/><verse number="18" style="v" sid="MRK 16:18"/>ወሪቹንከ አፎእቀ ህከረንገ ሸኖ ዘቡ አጎእቀ ምረኖሰበአ፤ እሰን ጥዘናመ አሌን አንገተ አቶእቃ ጥዘናችሰ ፈይታአ» ዬእ።<verse eid="MRK 16:18"/></para>
  <para style="s1">ኢስ ሰማሃ ኦሮኡስ</para>
  <para style="r">(<ref loc="LUK 24:50-53">ሉቃ. 24፥50-53</ref>፤ <ref loc="ACT 1:9-11">ሶቀ. 1፥9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19"/>ህካን ቀርቹ ኢስ ጠወዕይ ሹሎች ኤተሮን መገኑ ሰማሃ መሴሃንስ መገን መኬ አዲን አፉዕሌእ።<note caller="-" style="x"><char style="xo" closed="false">16፥19 </char><char style="xt" closed="false"><ref loc="ACT 1:9-11">ሶቀ. 1፥9-11</ref>።</char></note> <verse eid="MRK 16:19"/><verse number="20" style="v" sid="MRK 16:20"/>አሳበንት ጉዕመ ቤቹንከ መርት ተሽት ላገተ ተማርስቶኡ፤ ቀርቹንኩ እሳን ሜጡበ አአኖት እቅ፤ አጀብሲሰኖ ጠወ አታ ወልቀተ ኣሲን ተማርስታ ጠዉ ሀንቅ እሁስ ሆጎን ለሊሰኖት እቅ።]<verse eid="MRK 16:20"/></para>
  <chapter eid="MRK 16"/>
</usx>
