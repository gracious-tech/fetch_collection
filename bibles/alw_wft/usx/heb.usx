<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- HALABA NEW TESTAMENT</book>
  <para style="h">እብራውያን</para>
  <para style="toc1">እብራውያን መኒሃ ከተበንቶ ሶህኑተ</para>
  <para style="toc2">እብራውያን</para>
  <para style="toc3">እብ.</para>
  <para style="mt1">እብራውያን መኒሃ</para>
  <para style="mt2">ከተበሞ ሶህኑተ</para>
  <para style="imt1">ኣጉስ</para>
  <para style="ip">ት ሶህኑት ከተበንቶኢሁ አቡ ኦደንሹ እሌሰቤቺሃ አመዕነቱሰ አጉርቶተ ሆንጠንኮ አመዕናኖታት እቅ፤ ከተቦሲሁ እብራውያኖ አመዕናኖተ ተሬገጥሲሳንክዕኔሁ መሲህ ኢስ ሀንቀኘለከ መጨረሽ መገን ለሉ እሁስ ለሊሲኒት። ሁኩ አመዕናኑት አመዕነቲንከሰ ጠረኝታገ አአኖሰ፤ ህካን አአኖ ወክት ሰሱ ሀንቅ እኮ ጠወ ጌጥ አዕይ ለሊሰኖ፦</para>
  <para style="ili">1. ቶጎ ኦርሻን አኒሃስ መገኒሃ ሀንቅንከ አዘዘሞ ኢስ ጉዕመ ዘማኒንከ መገንየ ቤቱ፤ መገን ቤቱ እሆንከስ ኑባቾ ወኣድ ላገ ነብያኖች፥ ሙሲችለከ መላይካች ሎረሃን።</para>
  <para style="ili">2. ኢስ ኑባቾ ወኣድ ላገ ቂሳች በትሽ ጉዕመ ዘማን ቂስቹ እሁስ መገኑ ገውንኩስ ጠወዕዮኡ።</para>
  <para style="ili">3. ኢስ አዲን አመዕናኑት ጩብቺ፥ ዋጅችለከ ሬሆች ጡምታአ፤ ኢስ ሎረ ቂስቹ እሆንከስ እብራውያኖ አፎ ጠወኣ አመዕናኖ ሴሪንለከ ግዝ ክትመ ሆንጠህሱ ሀሌገ ለለኖ ጡሙ ሀንቅ እሀኖገ አዕዮእ።</para>
  <para style="ip">ከተቦሁ እስረኤል ሄሶን ሱዕመንቶ መናከተ አመዕነቱሰ ምሳልተ አዕይ (ፎሎ. 11) አነበባእሩ አመዕነቶንከሰ ጠረኝቶተ ቃግሰኖሰ፤ ህትን ፎሎ. 12 አነበባእሩ እልሰ ኢስ አሌን ቱክ ይት አመዕነቶንከሰ ጠረኝቶተለከ እኮስ ኦርሸቲ እልቶሰጎሬ አደጵቶተ ሸዘኖሰ፤ መጨረሻን ሸዘነተለከ አገዕር ላገተ ኣሲ ጡፈኖ።</para>
  <para style="iot">መጻፉስ አፎሃ</para>
  <para style="io1">መሲህ መገኑ ኑር አዕይ ለሊሰኖሃ እሁስ <char style="ior">(<ref loc="HEB 1:1-3">1፥1-3</ref>)</char></para>
  <para style="io1">መሲህ መላይካች ሎረ እሁስ <char style="ior">(<ref loc="HEB 1:4-2:18">1፥4—2፥18</ref>)</char></para>
  <para style="io1">መሲህ ሙሲችለከ ኢያሶች ሎረ እሁስ <char style="ior">(<ref loc="HEB 3:1-4:13">3፥1—4፥13</ref>)</char></para>
  <para style="io1">መሲህ ቂሲች በተኡስ <char style="ior">(<ref loc="HEB 4:14-7:28">4፥14—7፥28</ref>)</char></para>
  <para style="io1">መሲህ ወኣድ ላገት ሎረ እሁስ <char style="ior">(<ref loc="HEB 8:1-9:22">8፥1—9፥22</ref>)</char></para>
  <para style="io1">መሲህ ክትመ ሆንጠህሲች በተአኖሃ እሁስ <char style="ior">(<ref loc="HEB 9:23-10:39">9፥23—10፥39</ref>)</char></para>
  <para style="io1">አመዕነት ሎርመተ <char style="ior">(<ref loc="HEB 11:1-12:29">11፥1—12፥29</ref>)</char></para>
  <para style="io1">መገኑ ሙንዲስሱ <char style="ior">(<ref loc="HEB 13:1-19">13፥1-19</ref>)</char></para>
  <para style="io1">መጨረሽ ዱአ <char style="ior">(<ref loc="HEB 13:20-21">13፥20-21</ref>)</char></para>
  <para style="io1">መጨረሸስ <char style="ior">(<ref loc="HEB 13:22-25">13፥22-25</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="HEB 1"/>
  <para style="s1">መገኑ ቤትስ አዲን ጠወዕዮገ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1"/>ብሬ ዘማኔን መገኑ ልግብ አደደ እኮ ዎቃን አበናኖተኔ ነብያኖ አዲን ልግብ ወክት ጠወዕዮ እቅ። <verse eid="HEB 1:1"/><verse number="2" style="v" sid="HEB 1:2"/>እኮጎሬ ከን መጨረሽ ዘማኔን ጉዕመንከ ረገአኖሃ አዕዮስ ቤትስ አዲን ኔሳሃ ጠወዕዮኔ። ህትን ጉዕመንከ ከለቆሁ እስ አዲንት። <verse eid="HEB 1:2"/><verse number="3" style="v" sid="HEB 1:3"/>ቤቱስ መገን ኬዕምኝ ለሊሰኖሃን፤ እስን ዊመ ዊሚን መገኑ አጉደኖሃን፤ ወልቀት ዮ ላጋንከስ ጉዕመንከ ድክሽ አፎኡ፤ ህትን መነ ጩቢች ነጠ አዕዮች ኤተሮን ሎረ መገን መኬ አዲን ሰማን አፉዕልዮኡ።<verse eid="HEB 1:3"/></para>
  <para style="s1">ኢስ መላይካች ሎረ እሁስ</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4"/>መገን ቤቱ መላይከ ሱዕሚች ሎሩ ሱዕሙ ኣሰሞስ ሃሊን እሳች በትሽ በተዕዮሃ እኮ።<note caller="-" style="x"><char style="xo" closed="false">1፥5 </char><char style="xt" closed="false"><ref loc="GEN 2:7">ክል. 2፥7</ref>፤ <ref loc="2SA 7:14">2 ሳሙ. 7፥14</ref>፤ <ref loc="1CH 17:13">1 ዱዱ. 17፥13</ref>።</char></note><verse eid="HEB 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HEB 1:5"/>መሰንትስ መገኑ መላይካችስ መቲሀሲ</para>
  <para style="q1" vid="HEB 1:5">«አት ቤቱሃኤ፤ አን አናክ»</para>
  <para style="q1" vid="HEB 1:5">ህከረንገ</para>
  <para style="q1" vid="HEB 1:5">«አን አነ እሃንስ፤ እሲሁ ቤቱእ እሀኖ»</para>
  <para style="q2" vid="HEB 1:5">ዬኢሁ አዬህት?<verse eid="HEB 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 1:6"/>ህትን ሀንገፈ ቤቱስ ኣዱንያ አል ኤቦ ወክት</para>
  <para style="q1" vid="HEB 1:6">«መገን መላይከት ጉዕሙንኩ እሲሃ ሰገዶስተ» ሀስሰኖ።<note caller="-" style="x"><char style="xo" closed="false">1፥6 </char><char style="xt" closed="false"><ref loc="DEU 32:43">ዘዳ. 32፥43</ref>።</char></note><verse eid="HEB 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 1:7"/>እኮጎሬ መላይከተኔሃ ጠወአን</para>
  <para style="q2" vid="HEB 1:7">«መላይከስ ቦብረ፥ ካዲመተ ጊረ ለበነተ አአኖ» የኖ።<note caller="-" style="x"><char style="xo" closed="false">7፥1 </char><char style="xt" closed="false">ክል. 104፥4።</char></note><verse eid="HEB 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 1:8"/>ጠው እኮጎሬ ቤትስተኔሃ፤</para>
  <para style="q1" vid="HEB 1:8">«መገኖ! ዳኞመክ ቦርጭመት ዘላለሚሃ ሄኣአ።</para>
  <para style="q2" vid="HEB 1:8">ዎምነቶንከክ ጡመገ አት ገሽታንት፤<verse eid="HEB 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9"/>አት ፈዩተ ኢትት ሂለ ጠወ ግቦንት፤</para>
  <para style="q1" vid="HEB 1:9">ህከን መሳን መገኑ መጠሮሄ፤</para>
  <para style="q1" vid="HEB 1:9">ሙንዲኑተ ኣሰኖ ዘይተ ቡር ጃላችክ በትሽ ኢቴሄ» የኖ።<note caller="-" style="x"><char style="xo" closed="false">1፥8-9 </char><char style="xt" closed="false"><ref loc="PSA 45:6-7">መዝ. 45፥6-7</ref>።</char></note><verse eid="HEB 1:9"/></para>
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10"/>ቴሁ ቤትስተኔሃ ህት የኖ፤</para>
  <para style="q1" vid="HEB 1:10">«ቀርቾ! አት ሄጭት ኡለተ ከለቆንት፤</para>
  <para style="q2" vid="HEB 1:10">ሰሞንኩ አንገክተ ሆጉ።<verse eid="HEB 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11"/>እሰ ጉዕሙንኩሰ በኣአ፤</para>
  <para style="q1" vid="HEB 1:11">እኮጎሬ አት ሄኣንት፤</para>
  <para style="q2" vid="HEB 1:11">እሰ ጉዕሙንኩሰ ኦድኖገ ኑባጵታአ።<verse eid="HEB 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12"/>ቡሉኮገን ጣጣንትሰ፤</para>
  <para style="q2" vid="HEB 1:12">እሰ ኦድኖገን ዶረንታአ።</para>
  <para style="q1" vid="HEB 1:12">2 አት ጉዕመ ወክትንከ አቴት፤</para>
  <para style="q1" vid="HEB 1:12">ዘማኑክ ሆሮ ጎፈኖበአ» የኖ።<note caller="-" style="x"><char style="xo" closed="false">1፥10-12 </char><char style="xt" closed="false"><ref loc="PSA 102:25-27">መዝ. 102፥25-27</ref>።</char></note><verse eid="HEB 1:12"/></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13"/>ጠው እኮጎሬ መገኑ መላይከ በሊች፤</para>
  <para style="q1" vid="HEB 1:13">«ባለጋረክ ሎካችክ ዎሮን አኦተ ኢለ</para>
  <para style="q1" vid="HEB 1:13">መኬእ አዲን አፉዕል» ዬኢሁ አዬት?<note caller="-" style="x"><char style="xo" closed="false">1፥13 </char><char style="xt" closed="false"><ref loc="PSA 110:1">መዝ. 110፥1</ref>።</char></note><verse eid="HEB 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HEB 1:14"/>ህከረ መላይከት ጉዕሙንኩ ጡሙ ደእታ መነ ካደንቶተ ሶሀንቶ አያናከተበእንዶ?<verse eid="HEB 1:14"/></para>
  <chapter eid="HEB 1"/>
  <chapter number="2" style="c" sid="HEB 2"/>
  <para style="s1">ቀርቾን አመዕኔን ጡምተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1"/>አይደጎ ነኡ ሞጮጭኖም ጠዊች ኤተሩ ዋልን ኡምባምበእገ አገዕሩ ሀስሰኖኔ። <verse eid="HEB 2:1"/><verse number="2" style="v" sid="HEB 2:2"/>መላይከ አዲን ኩለንቶ ላገት ሀንቂተ እኮጎሬ ህተ ላገተ ቶጉ ግበኖ መንቹ ሀስሰኖ ሃሊን ቀጠአመኖሃ እኮጎሬ <verse eid="HEB 2:2"/><verse number="3" style="v" sid="HEB 2:3"/>ነኡ ህከ ሎረ ጡሙ ሀምቦምጎሬ ሀት እንክ ፉሸእኖተ አታልናም? ከ ጡሙኔ ወዕና ኩሎኔሁ ቀርቹ ገዋስ፤ ህካን ጠረኝስ ኩልቶኔሩ እሲች ሞጮጭቶእሃ መነ። <verse eid="HEB 2:3"/><verse number="4" style="v" sid="HEB 2:4"/>ህትን መገኑሁ ህከን ጡምተኔሃ መላተ፥ አበ አጀብሲሰኖ ሆጎን፥ አደደ ገረምሲጬኖ ጠዊን፥ እስ ሀሾ ሃሊን ኣሴ ጠሊለ አያን ኣስቶን መሰከሮኡ።<verse eid="HEB 2:4"/></para>
  <para style="s1">መን ዘሬተ ጡምሳንቹ ኢሰ እሁስ</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5"/>ነኡ «ከ ኤተሩ አሜታአ» ይን ጠወዕናም ኣዱንያ አል መገኑ መላይከስ ጠቅቶተ ኣስዮበአ። <verse eid="HEB 2:5"/><verse number="6" style="v" sid="HEB 2:6"/>መጻፍ ኣዜን መቶ ቤቾን መቱ መንቹ</para>
  <para style="q1" vid="HEB 2:6">«አት እሱ ሰው ይቶተ መኑ መርቾሃን?</para>
  <para style="q2" vid="HEB 2:6">ህትን ጨነቀንቶስተ መን እለት መርቾሃን? <verse eid="HEB 2:6"/><verse number="7" style="v" sid="HEB 2:7"/>እሱንከ መላይካች ቀዎ ወክቲሃ ሆፍሶንትስ፤</para>
  <para style="q1" vid="HEB 2:7">ኬዕምኝለከ ገለት ዘዉደሃ ዎርቶንትስ፤</para>
  <para style="q2" vid="HEB 2:7">አንገክ ሆጎ አሌንን መክሶንትስ፤<note caller="+" style="f"><char style="ft" closed="false">መት-መቱ ፍሳረት «አንገክ ሆጎን ዳኛ አቶንት» የኖሃ በርግታአ።</char></note><verse eid="HEB 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 2:8"/>መገኑ ጉዕመርቹንከ ሹምነቲችስ ዎሮን አቶንት» ህት ይ መሰከሮኡ።<note caller="-" style="x"><char style="xo" closed="false">2፥6-8 </char><char style="xt" closed="false"><ref loc="PSA 8:4-6">መዝ. 8፥4-6</ref>።</char></note></para>
  <para style="m" vid="HEB 2:8">ጉዕመርቹንከ ደኞመስ ኣዜን አአኖረ፤ ዳኞማስ ኣዜን አኡዕነ ፌሾርቹ መቱርቹሁ ዮበአ። እኮጎሬ ቴሱ ጉዕሙርቹንኩ እስ ሹምነት ኣዜን እሁስ ለዕኖምበአ። <verse eid="HEB 2:8"/><verse number="9" style="v" sid="HEB 2:9"/>ጠው እኮጎሬ መገን ኣስቶን ጉዕማንከ መንተኔ ሬሁተ ለዕኖተ ቀዎ ወክቴን መላይካች ዎሮ አዲን እክ ለሌ ኢስ ሬሆ ኦርሸተ ቶጎቤቺሃ ኬዕምኝለከ ገለት ዘውደ ዎሮሃ ለዕናም። እስ መገን ኣስቶን ጉዕምኔተኔሃ ሬዮኡ። <verse eid="HEB 2:9"/><verse number="10" style="v" sid="HEB 2:10"/>መገኑ ጉዕመርቹንከ ከለቆ፤ ጉዕሙርቹንኩ ህትን ሄኦተ አዕዮ፤ ኢሰ ኦርሸ ኣዜን ህግሲን ጉዕመርቺሃ በቀዕዮሃ እሀኖገ አኡ እሲሃ ገበአኑሃን፤ መነ ጡምቤቹ አዎንሰኖሁለከ ልግብ ኦሱተ መገን ኬዕምኝ ቤቀንታገ አአኖሁ ኢሳት።<verse eid="HEB 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11"/>መነ ጠሊላኑተ አአኖሳሁለከ እሶን ጠሊላኑተ እኮ መኑ መቶ አንተ ኦሱ፤ ህከን መሳን ኢስ እሰንተ «አመኤ ኦሶ» ይ ገኦተ ሙለኖበአ። <verse eid="HEB 2:11"/><verse number="12" style="v" sid="HEB 2:12"/>ህካን እኮቤቺሃ አን መገኒሃ</para>
  <para style="q1" vid="HEB 2:12">«ሱዕመክ አመኤ ኦሶተ ኩላም፤</para>
  <para style="q1" vid="HEB 2:12">አመዕናኖ ጭምት በላን ኬሳሃ ገለትጫንኬ» የኖ።<verse eid="HEB 2:12"/></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13"/>ህትን «አመዕነቱኤ እስ አሌን አኣም»<note caller="-" style="x"><char style="xo" closed="false">2፥13 </char><char style="xt" closed="false"><ref loc="ISA 8:17-18">ኢሳ. 8፥17-18</ref>።</char></note></para>
  <para style="m" vid="HEB 2:13">ህትን «አንለከ መገኑ ኣሴኤ ኦሱት ሁኩዕኑን» የኖ።<verse eid="HEB 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14"/>ኦሱት ማሉለከ ቄጉ ዮእረ እኮገን ኢስሁ እሰገን መንቹ እኮ፤ ሁኩንን ሬሆንከስ ሬሆ አሌን ወልቀት ዮስ እልቢስ ቤሶታት። <verse eid="HEB 2:14"/><verse number="15" style="v" sid="HEB 2:15"/>ህትን ሄአኖ ዘማኔን ጉዕማንን ሬሆገ ዋጄኖ ሮሶመ ኣዜን ጠገንቶረ ጉዕመንከ ዎዝሃት። <verse eid="HEB 2:15"/><verse number="16" style="v" sid="HEB 2:16"/>ሀንቅ እሀኖረ ኢስ ሀሾ መላይከተ ሀዕሎተ እሁዕነ እብራሂም ዘርተ ሀዕሎታት። <verse eid="HEB 2:16"/><verse number="17" style="v" sid="HEB 2:17"/>ህካን እኮቤቺሃ ማርቱተ አአኖለከ አመዕነሞ ሎረ ቂስቹ እክ መገኒሃ አኦተለከ መን ጩብ አጉሮተ መ ጠዋኒ አመስ ኦሱተ አጉዱ ገበዕዮስ። <verse eid="HEB 2:17"/><verse number="18" style="v" sid="HEB 2:18"/>እስ ገዉንኩስ ፌተነም ኦርሸተ ቶጎቤቺሃለከ ፌተነሞቤቺሃ ፌተናን ኣጋእረ ሀዕሎተ አታለኖ።<verse eid="HEB 2:18"/></para>
  <para style="b"/>
  <chapter eid="HEB 2"/>
  <chapter number="3" style="c" sid="HEB 3"/>
  <para style="s1">ኢስ ሙሲች ሎረ እሁስ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1"/>ህካን እኮቤቺሃ ሰሜ ጄነትሃ ገአንቴን ቤቀማኑተ እኬንተ ጠሊላኑት አመኤ ኦሶ! ጠወዕናም አመዕነት ሎረ ቂስቹ እሆተ መገኒን ሶሀሞ ኢሰ ሰዉ ይዬ። <verse eid="HEB 3:1"/><verse number="2" style="v" sid="HEB 3:2"/>ሙስ ዱእ ምኒ ሆጎን ጉዕማን አመዕነሞኢሃ እኮገን ኢሲሁ እሱ ሾሞስ መገኒሃ አመዕነሞእሃ እቅ። <verse eid="HEB 3:2"/><verse number="3" style="v" sid="HEB 3:3"/>ምኒ እጃረኖሁ ምኒች ሎሩ ኬዕምኙ ሄአኖስሀንገን ኢሲሃ ሙስ ኬዕምኚች በተአኖ ኬዕምኙ ሀስሰኖስ።<note caller="-" style="x"><char style="xo" closed="false">3፥2 </char><char style="xt" closed="false">ዘኁኡ. 12፥7።</char></note> <verse eid="HEB 3:3"/><verse number="4" style="v" sid="HEB 3:4"/>መሰንትስ ምኒሃ ጉዕሚንከ መቱ እጃረኖሁ ሄአኖ፤ ጠዉ እኮጎሬ ጉዕመርቹንከ እጃሮሁ መገኑሃን። <verse eid="HEB 3:4"/><verse number="5" style="v" sid="HEB 3:5"/>ሙስ ከ ኤተሩ ኩለመኖ ጠዊሃ ምስክር እሆተ መገን ምኔን ጉዕማን ካድንችገ እክ አመዕነሞእሃ እቅ። <verse eid="HEB 3:5"/><verse number="6" style="v" sid="HEB 3:6"/>መሲህ መገን ምኔን ጉዕማን ሹምነቱ ኣሰሞስ ቤትገ አመዕነሞሃ እቅ፤ ነኡን አመዕንናምለከ ድከዕናም ተብሳሃ ኤተሩ ኢለ ጠረኝንስ አንፎምጎሬ እስ ምኒ እንካም።<verse eid="HEB 3:6"/></para>
  <para style="s1">መገን ኡመቲሃ ኣሰሞ አገዕርተኔሃ</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7"/>ህካን እኮቤቺሃ ጠሊሉ አያኑ</para>
  <para style="q1" vid="HEB 3:7">«ከበር ላገስ ሞጮጭቴነን<note caller="-" style="x"><char style="xo" closed="false">3፥7-11 </char><char style="xt" closed="false"><ref loc="PSA 95:7-11">መዝ. 95፥7-11</ref>።</char></note><verse eid="HEB 3:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8"/>አዕኑ ኡለ ኡድማን ፌተንቴንተኤ ወክት አበናኑክዕኔ ሾክቶኤገን</para>
  <para style="q2" vid="HEB 3:8">ቀልብክዕኔ ዱድሶኖቼ።<verse eid="HEB 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9"/>ህከኔን አበናኑክዕኔ ፌተንቶኤሁ፥ አሙዕርሲሶኤሁ፤</para>
  <para style="q2" vid="HEB 3:9">አዕዮምርቹንከ ሸይሉ ዘማን ለኦኡ» የኖ መገኑ።<verse eid="HEB 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10"/>«ህካን እኮቤቺሃ አን ህከን ዘማን መናን ኡሙዕሬም፤</para>
  <para style="q2" vid="HEB 3:10">‹ጉዕመ ወክት ቀልቡሰ ሉጨሞእሃ፥</para>
  <para style="q2" vid="HEB 3:10">ዎቃንከኤ ደግበረሁ› ዬም።»<verse eid="HEB 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11"/>አንን አሙዕሬን</para>
  <para style="q1" vid="HEB 3:11">«‹እሰ ኢ ፎሎጭቤቹ ሆሮ ኣጋባአ› ይ</para>
  <para style="q2" vid="HEB 3:11">ጤሌዕሌም።»<verse eid="HEB 3:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="HEB 3:12"/>ኢ ጃላ! ዘላለሚሃ ሄአኖ መገኑ ለገእሲሰኖ ሂሉ አመዕንቡ ቀልቡ ክዕኔኤች አዬሃ ሄአኖበእገ አገዕርዬ። <verse eid="HEB 3:12"/><verse number="13" style="v" sid="HEB 3:13"/>እኮጎሬ ክዕኔኤች አዪሁ ጩቢን ጣንሰም ቀልብስ ዱድሱዕነ «ከበር» የመሞ በሩ ጎፉዕነ ጉዕመ ወክት ገገዉክዕኔ አማዕለሜ። <verse eid="HEB 3:13"/><verse number="14" style="v" sid="HEB 3:14"/>ወዕና ሄዕዮኔ አመዕነቱ መጨረሸ ኢለ ጠረኝንስ አንፎምጎሬ መሲህን ሜጡበ ቤቀማምረ እንካም።<verse eid="HEB 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 3:15"/>ከኒች ብርተ</para>
  <para style="q2" vid="HEB 3:15">«ከበር ላገስ ሞጮጭቴነን</para>
  <para style="q2" vid="HEB 3:15">ህከ ወክት አበናኑክዕኔ ሾክማን አቶገን ቀልብክዕኔ ዱድሶኖቼ»</para>
  <para style="m" vid="HEB 3:15">የመም ከተበሞጋት።<verse eid="HEB 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16"/>ላገስ ሞጮጭት ሾክቶእሩ አዬኤታን? ሙስ አዎንስ ግብጽ ባዲች ፉሼሰሩ ጉዕማንከሰበእንዶ? <verse eid="HEB 3:16"/><verse number="17" style="v" sid="HEB 3:17"/>ሸይሉ ዘማን ዊመ መገኑ አሙዕርስሶሩ አዬኤታን? ጩብ አቶቤቺሃ ጀናዘሰ ኡለ ኡድማን ፈቆእረበእንዶ? <verse eid="HEB 3:17"/><verse number="18" style="v" sid="HEB 3:18"/>ህካን እኮቤቺሃ አዘዘንቶበእ መን ቤሉ «ፎሎጭኤ ቤቹ ኣጌነንተበአ» ይ መገኑ ጠሌዕሌሰሩ አዬኤታን? <verse eid="HEB 3:18"/><verse number="19" style="v" sid="HEB 3:19"/>ቴሁ እሰ አመዕኑ ሆጎ መሳን ፎሎጭቤቹ ኣጎተ አታሉ ሆጉሰ ደንጋም።<verse eid="HEB 3:19"/></para>
  <para style="b"/>
  <chapter eid="HEB 3"/>
  <chapter number="4" style="c" sid="HEB 4"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1"/>ህካን እኮቤቺሃ ኣሰኖኔ ፎሎጭቤቹ ኣጊሃ ላገተ አጎኔሁ ጠረኘ እኮቤቺሃ ክዕኔች አዪሁ ህከ ፎሎጭቤቹ ኣገኖ ሳመ ደኡዕነ ፈቀኖበእገ ጉዕሙንኩኔ አገዕርኖ። <verse eid="HEB 4:1"/><verse number="2" style="v" sid="HEB 4:2"/>እሳሃ እንጂል ላገት ኩለንቶገን ኔሳሃ ኩለንቶኔ፤ ጠዉ እኮጎሬ እሰ ሞጮጭቶ ላገተ አመዕነቲን ቶጉሆጎቤቺሃ ደግለሎሰበአ። <verse eid="HEB 4:2"/><verse number="3" style="v" sid="HEB 4:3"/>ነኡ አመዕንኖም መኑ ህከ መገኑ ኣሰኖኔ ፎሎጭቤቹ አንጋም፤ እስን « ‹እሰ ፎሎጭቤቹ ሆሮ ኣጋበአ› ይ ኡሙዕሬን ጤሌዕሌም» ዬሀንገን ት ሆጉት ኣዱንያት ከለቀንቶች ኬሽ እክ ጎፎኡ።<note caller="-" style="x"><char style="xo" closed="false">4፥3 </char><char style="xt" closed="false"><ref loc="PSA 95:11">መዝ. 95፥11</ref>።</char></note> <verse eid="HEB 4:3"/><verse number="4" style="v" sid="HEB 4:4"/>ቴሁ ጠሊለ መጻፍ ኣዜን መቶ ቤቾን ለመልቅ በርተኔሃ «መገኑ ለመልቅ በር ሆጎችስ ጉዕሚችን ፎሎጬእ» የመም ከተበሞኡ።<note caller="-" style="x"><char style="xo" closed="false">4፥4 </char><char style="xt" closed="false"><ref loc="GEN 2:2">ክል. 2፥2</ref>።</char></note> <verse eid="HEB 4:4"/><verse number="5" style="v" sid="HEB 4:5"/>ህትን ወዕና የመሞገን ለንኪሃ</para>
  <para style="q1" vid="HEB 4:5">«ፎሎጭኤቤቹኤ ሆሮ ኣጋበአ» የኖ።<note caller="-" style="x"><char style="xo" closed="false">4፥5 </char><char style="xt" closed="false"><ref loc="PSA 95:11">መዝ. 95፥11</ref>።</char></note><verse eid="HEB 4:5"/></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 4:6"/>ሁኩ ዎዕነ እንጂል ላገት ዱዱብሰንታንሰ አዘዘሙ ግቦእሩ ፎሎጭኤ ቤቹ ኣጎበአ፤ ጠዉ እኮጎሬ ህከ ቤቹ ኣጋ መት-መቱ መኑ ሄኡሰ ሀንቅሃን። <verse eid="HEB 4:6"/><verse number="7" style="v" sid="HEB 4:7"/>ሁኩን ሄጭ የመሞገን</para>
  <para style="q1" vid="HEB 4:7">«ከበር ላገስ ሞጮጭቴነን</para>
  <para style="q2" vid="HEB 4:7">ቀልብክዕኔ ዱድሶኖቼ»</para>
  <para style="m" vid="HEB 4:7">ይ መገኑ አበ ዘማኒች ኤተሮን ደዉዴን ጠወዕዮ ላገት «ከበር» ዬኖ መቱ በር ወሰኞኡ።<note caller="-" style="x"><char style="xo" closed="false">4፥7 </char><char style="xt" closed="false"><ref loc="PSA 95:7-8">መዝ. 95፥7-8</ref>።</char></note><verse eid="HEB 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8"/>ኢያሱ ፎሎጭሾሰ እቃን መገኑ ለንኪሃ ዎሎ በርተኔ ጠወአኖበአ እቅ።<note caller="-" style="x"><char style="xo" closed="false">4፥8 </char><char style="xt" closed="false"><ref loc="DEU 31:7">ዘዳ. 31፥7</ref>፤ <ref loc="JOS 22:4">ኢያ. 22፥4</ref>።</char></note> <verse eid="HEB 4:8"/><verse number="9" style="v" sid="HEB 4:9"/>መገን ኡመቲሃ አበ በሬ ፎሎጩ አጉደኖ ፎሎጩ ከ ኤተሩ እሀኖ። <verse eid="HEB 4:9"/><verse number="10" style="v" sid="HEB 4:10"/>ህትን መገን ፎሎጭቤቹ ኣገኖሁ አዪሁ መገኑ ሆጎችስ ፎሎጬገን እሲሁ ሆጎችስ ፎሎጨኖ።<note caller="-" style="x"><char style="xo" closed="false">4፥10 </char><char style="xt" closed="false"><ref loc="GEN 2:2">ክል. 2፥2</ref>።</char></note> <verse eid="HEB 4:10"/><verse number="11" style="v" sid="HEB 4:11"/>ህካን እኮቤቺሃ ነኡ ብሬ ዘማን መኒሃ አዘዘሙ ግብ ምሳልተ አዎኒን ኡምባምበእገ ህከን ፎሎጮን ኣንጎተ ጠረኝኖ።<verse eid="HEB 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12"/>መገን ላገት ፎሊን ሄኣኢተለከ ሆጉተ አታእታን፤ ለሞ አዲን ሙረኖ ብሲች አበ እጳሸታን፤ ነቢሳለከ አያነ መላይመተለከ ሀምቡተ አደ አኦተ ኢለ ሙረንስታእታን፤ ቀልብ ኣዜን ማጠሞ ሰውትለከ ሄዕላቸተ አደ አት ደጋእታን። <verse eid="HEB 4:12"/><verse number="13" style="v" sid="HEB 4:13"/>ከለቀሞርቹ ጉዕሙንኩ መገን ብሬች ማጠመኖበአ፤ እስ ብሬን ጉዕሙርቹንኩ ግልጠለከ ከል እክ ለለኖሃን፤ ነኡን መስለ ኣስናሚሁ እስ ብሬኒት።<verse eid="HEB 4:13"/></para>
  <para style="s1">ኢስ ሎረ ቂሰ ሀለቀ እሁስ</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14"/>መገኑ ዮ ቤቹ ሰማሃ ኦሮዕዮ ሎሩ ቂስቹ መገን ቤቱ ኢስ ዮኔቤቺሃ አመዕነቱኔ ጠረኝንስ አንፎ። <verse eid="HEB 4:14"/><verse number="15" style="v" sid="HEB 4:15"/>መሰንትስ ኔሳሃ ዮ ሎሩ ቂስቹ ሆንጋምረ መረርሲጨኖኔሃን፤ ጉዕመ ጠዋንን ኒገ ፌተነሞኢሃን፤ እኮጎሬ ጩብ አዕዮበእሃን። <verse eid="HEB 4:15"/><verse number="16" style="v" sid="HEB 4:16"/>መገኒች ማርቱተ ቶንጎተለከ ሀዕለንሹ ሀስሰኖኔ ወክት ኣስቱተ ኣእኖተ ማረኖ መገን ብርተ አመዕነቲን ሆንጠንኮ።<verse eid="HEB 4:16"/></para>
  <para style="b"/>
  <chapter eid="HEB 4"/>
  <chapter number="5" style="c" sid="HEB 5"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1"/>ጉዕሙንኩ ሎሩ ቂሰት መን በሊች መጠረንታአ፤ ጩብ አቶ መን ወጥ መገኒሃ ክትምለከ ሰደቀ ሆንጠህሲሃ መገኒን መጠረንቶእረ። <verse eid="HEB 5:1"/><verse number="2" style="v" sid="HEB 5:2"/>ሁኩ ቂስቹንኩ ሆጎሃ እኮቤቺሃ ገዋኑተለከ ሉሳእረ መረርስጮተ አታለኖ። <verse eid="HEB 5:2"/><verse number="3" style="v" sid="HEB 5:3"/>እስ ገውንኩስ ሆጎሃ እኮቤቺሃ ኡመት ጩቢሃ ጠለዕል እሁዕናን ገይስ ጩቢሃለከ መን ጩቢሃ ክትመ ሆንጠህሱ ሀስሰኖስ።<note caller="-" style="x"><char style="xo" closed="false">5፥3 </char><char style="xt" closed="false"><ref loc="LEV 9:7">ሌዌ 9፥7</ref>።</char></note> <verse eid="HEB 5:3"/><verse number="4" style="v" sid="HEB 5:4"/>ሀሩንገ መገኒን ገአምባች ሎረ ቂሰ እህ ኬዕምኝ አዪሁ ደኦተ አታለኖበአ።<note caller="-" style="x"><char style="xo" closed="false">5፥4 </char><char style="xt" closed="false"><ref loc="EXO 28:1">ፉል. 28፥1</ref>።</char></note><verse eid="HEB 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5"/>ህትን መሲህ ሎረ ቂስቹ እሆተ ገዉስ ሎሪስዮበአ፤ ጠዉ እኮጎሬ ህከ ሎርመተ ደኤኢሁ</para>
  <para style="q1" vid="HEB 5:5">«አት ኢሃ ቤቱ፤</para>
  <para style="q2" vid="HEB 5:5">አንን ከበር እሎንኬ» ዬ መገኒችት።<note caller="-" style="x"><char style="xo" closed="false">5፥5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">መዝ. 2፥7</ref>።</char></note><verse eid="HEB 5:5"/></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6"/>ህትን መገኑ ዎሎ ቤቾን</para>
  <para style="q1" vid="HEB 5:6">«አት መልከ-ጼዴቄገ ቂሶመ ሹምነትገ</para>
  <para style="q2" vid="HEB 5:6">ዘላለሚሃ ቂሰሃን» የኖ።<note caller="-" style="x"><char style="xo" closed="false">5፥6 </char><char style="xt" closed="false"><ref loc="PSA 110:4">መዝ. 110፥4</ref>።</char></note><verse eid="HEB 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7"/>ኢስን መንቹ እክ ዱንያ አሌን ሄዕዮ ዘማኔን ሬሆች ፌሶስተ አታለኖ መገን ቤቹ አበ ያረናንለከ እንጂጃን አበ ዱአ አዕዮ፤ ኢስን መገኑ ዋጀኖሃ እኮቤቺሃ ዱኡስ ሞጮጨሞ።<note caller="-" style="x"><char style="xo" closed="false">5፥7 </char><char style="xt" closed="false"><ref loc="MAT 26:36-46">ማቶ. 26፥36-46</ref>፤ <ref loc="MRK 14:32-42">ማር. 14፥32-42</ref>፤ <ref loc="LUK 22:39-46">ሉቃ. 22፥39-46</ref>።</char></note> <verse eid="HEB 5:7"/><verse number="8" style="v" sid="HEB 5:8"/>እስን መገን ቤቱ እክ ኦርሸ ኣዝን ህጎጎሬሁ ህከ ቶጎ ኦርሻች አዘዘሙ ተማሮ። <verse eid="HEB 5:8"/><verse number="9" style="v" sid="HEB 5:9"/>እስን ኩሌኖስርቹ ዮበኢሃ እክ አዘዘንታስሀኑኡተ ጉዕሚንከ ዘላለም ጡሚሃ መሰተ እኮሰ። <verse eid="HEB 5:9"/><verse number="10" style="v" sid="HEB 5:10"/>መገኑ ኢሰ መልከ-ጼዴቄ ቂሶማ ሹምነትገ ሎረ ቂስቹ አዕዮስ።<verse eid="HEB 5:10"/></para>
  <para style="s1">መኑ አመዕነቱሰ አጉርታበእገ ኣሰንቶ ሸዘነተ</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11"/>ከን ጠውተኔሃ ልግቡ ጠወዕናም ጠዉ ዮኔ፤ ጠዉ እኮጎሬ ቴሱ ገበንቺን ተማሩ ሆጌንተቤቺሃ ሂሬን ክዕኔሃ ኩሉ ኦርሸተ። <verse eid="HEB 5:11"/><verse number="12" style="v" sid="HEB 5:12"/>ከ ወክት ኢለ አስተማረተ እኬንታ እቅ፤ እኮጎሬ መቱ መንቹ መገን ላገ ዎኔ ትምርቲሃ ክዕኔሃ ለንኪሃ ተማርሱ ሀስሰኖ፤ ህትን እሰገን ጠረኘ እቸተ እሁዕነ አዙት ሀስሳህዕኔ። <verse eid="HEB 5:12"/><verse number="13" style="v" sid="HEB 5:13"/>መሰንትስ አዙተ አዎንሱ ጉዕሙንኩ ኦሶተ እኮቤቺሃ ጡመርቹ ሂለርቺች አደ አዕይ ደገኖበአ።<note caller="-" style="x"><char style="xo" closed="false">5፥12-13 </char><char style="xt" closed="false"><ref loc="1CO 3:2">1 ቆሮ. 3፥2</ref>።</char></note> <verse eid="HEB 5:13"/><verse number="14" style="v" sid="HEB 5:14"/>ጠረኘት እቸት ሀሲሳኢሁ ጡመለከ ሂለ አደ አዕይ ደገኖ ሎርሎረ መኒሃት።<verse eid="HEB 5:14"/></para>
  <para style="b"/>
  <chapter eid="HEB 5"/>
  <chapter number="6" style="c" sid="HEB 6"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1"/>መሲህተኔሃ ዎዕና ኩለሞ ትምርተ አጉርን ጠረኘ ትምህርትበ ህንጎ፤ ሂለ ሆጉተ አጉርን ቶበንት መገኖን አመዕን ቀበበ ለንኪሃ እጃርኑንከ። <verse eid="HEB 6:1"/><verse number="2" style="v" sid="HEB 6:2"/>ህትን ጠመቀምተኔሃ፥ መን አሌን አንገተ አኤን ዱአ አእተኔሃ፥ ሬዮ መን ኬእተኔሃለከ ጉዕመ ዘማንከ እሀኖ ፍርድተኔሃ ኩለሞ ትምህተ ለንኪሃ እጃርኑንከ። <verse eid="HEB 6:2"/><verse number="3" style="v" sid="HEB 6:3"/>ህካን አጉርን መገኑ ዬጎሬ ብርተ ዋልን መርኖ።<verse eid="HEB 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4"/>አመዕነቱሰ ካዶ መኑ ቶበት ሀት እክ ፈንቀልቶተ አታልታአ? ኩ መኑ ከኒች ብርተ ኑሩ ለልዮሰ እቅ፤ ሰሜ ሽልማት ቀመሶ እቅ፤ ጠሊለ አያኒን ሜጡበ ቤቀማኑተ እኮ እቅ። <verse eid="HEB 6:4"/><verse number="5" style="v" sid="HEB 6:5"/>መገን ጡመ ላገተለከ አሜተኖ ኣዱንያ አል ዎልቀተ ቀመሶ እቅ፤ <verse eid="HEB 6:5"/><verse number="6" style="v" sid="HEB 6:6"/>ፈንቀልት ካዶ ጎሬ ጩብ አጉርታቤቹ እሰተ ፈንቀሹ አታልሲስበሃን፤ መሰንትስ እሰ ገውንኩሰ ገይሰ ቤሲሃ መገን ቤቱ ለንኪሃ ሰቀልቶእረለከ ሆፍሶእረ።<verse eid="HEB 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7"/>ልግብ ወክት መቱ መንቹ ኡለስ አሌን ኡቦ ጤነ አጋን አቡረኖሴ መንቺሃ ውጠተ ኣታ ኡለት መገኒች ማሰተ ደእታ ኡለተ አጉዳአ። <verse eid="HEB 6:7"/><verse number="8" style="v" sid="HEB 6:8"/>እኮጎሬ ህት ኡለት ኡተለከ ሽርፍቱተ ነስቶጎሬ ሀሴንባተ እካአ፤ ደዕልት ቦሮሪሃ እካአ፤ መጨረሹስ ግራን ቡባአ።<note caller="-" style="x"><char style="xo" closed="false">6፥8 </char><char style="xt" closed="false"><ref loc="GEN 3:17-18">ክል. 3፥17-18</ref>።</char></note><verse eid="HEB 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9"/>ኢተንቴንተ አመኤ ኦሶ! መሃ ክዕኔተኔሃ ህትን ጠወዕኖምጎሬ ጡሚሃ ሀዕለኖሁ ቆሀኖ ጠው ዮህዕኔገ ደንጋም። <verse eid="HEB 6:9"/><verse number="10" style="v" sid="HEB 6:10"/>መገን ሱዕምተኔሃ ይቴን ጠሊላኑተ ሀዕሎተ ዎዕነሃ እኮ ቴሁ አቴንተ ሆጉተለከ ለሊሴንተ ኢተተ ሀቦተ መገኑ ሾካበአ። <verse eid="HEB 6:10"/><verse number="11" style="v" sid="HEB 6:11"/>አዕኑ ጉዕሙንኩክዕኔ ተብሴን አገዕርቴነንተረ አፎኖተ ኢለ ጠረኝመክዕኔ መጨረሸ ኢለ ለሊሶኖተ ሄዕላንታም። <verse eid="HEB 6:11"/><verse number="12" style="v" sid="HEB 6:12"/>ነኡ ሄዕላንታሚንኩ አመዕነቲንለከ አታዕሊን ተብሳሃ ኣሰሞሰ ጠወ ረገኣ መነ አጉዶኖታት ቤሉ ዋንክዕላሙ መነ እኮኖታበአ።<verse eid="HEB 6:12"/></para>
  <para style="s1">መገን ተብሶሁ ሀንቂሃ እኮገ</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13"/>መገኑ እብራሂሚሃ ተብሳሃ ኣሴ ወክት ገዪችስ ሎሩ ጤሌዕለኖርቹ ዮስበእቤቺሃ እስ ገዎንከስ ጤሌዕለን <verse eid="HEB 6:13"/><verse number="14" style="v" sid="HEB 6:14"/>«ሀንቅንከ አን ማሰኣንኬ፤ ዘርክን በትሳንኬ» ዬስ።<note caller="-" style="x"><char style="xo" closed="false">6፥14 </char><char style="xt" closed="false"><ref loc="GEN 22:16-17">ክል. 22፥16-17</ref>።</char></note> <verse eid="HEB 6:14"/><verse number="15" style="v" sid="HEB 6:15"/>እብራሂምን አታዕል አበ ዘማን አገሮቤቺሃ ተብሳሃ ኣሰሞስርቹ ደኤእ። <verse eid="HEB 6:15"/><verse number="16" style="v" sid="HEB 6:16"/>መኑ ጤሌዕለን ገይችስ በተአኖርቾን ጤሌዕለኖ፤ ሀሳወሰ ቦሮርን ኡርስ በለሰ ዮ ኦደተ ጉዕመንከ በሊችሰ ከንታአ። <verse eid="HEB 6:16"/><verse number="17" style="v" sid="HEB 6:17"/>ህትን መገኑ እስ አላመት እኩዕነ ፈቅባሃ እሁስ ለሊሶተ ሀሾቤቺሃ ተብሳስ ቶጋ መኒሃ ቦሮርን ጠረኝሾ። <verse eid="HEB 6:17"/><verse number="18" style="v" sid="HEB 6:18"/>እስ ዶረንትበለከ ክዝቤንበ ለሙ ጠወ ኣስዮኔ፤ እሰን ተብሳለከ ጤሌዕሉሃን፤ ከን ለሞ ጠዊ መሳን ብሬንከኔ ዮ ተብሳሃ ጠረኝንስ አፉ አታልኖተ ሆቀንሸ ደእኖተ እስቤቹ ሁኖምሩ ነኡ አበ ጠረኝመተ ደእናም። <verse eid="HEB 6:18"/><verse number="19" style="v" sid="HEB 6:19"/>ኩ ተብሶሁ ዌደሩ ኒ አሌን ኡሱሬን ዎሎ ዌደር ሰኑት መጋረጀ ህግ መገኑ ደገመኖ ኣዝ ጠሊለ ቤቹ ኣገኖ።<note caller="-" style="x"><char style="xo" closed="false">6፥19 </char><char style="xt" closed="false"><ref loc="LEV 16:2">ሌዌ 16፥2</ref>።</char></note> <verse eid="HEB 6:19"/><verse number="20" style="v" sid="HEB 6:20"/>ሁኩ መልከ-ጼዴቄ ቂስ ሹምነትገ ዘላለሚሃ ሎረ ቂስቹ እኮ ኢስ ኒተኔሃ ዎዕኔሃ እክ ኣጎእሃን።<verse eid="HEB 6:20"/></para>
  <para style="b"/>
  <chapter eid="HEB 6"/>
  <chapter number="7" style="c" sid="HEB 7"/>
  <para style="s1">ቂስቹ መልከ-ጼዴቄ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1"/>ኩ «ሳሌመ» ዬኖ ባድ ዳኘለከ ጉዕሚችን ሎረ ቂስቹ እኮ መልከ-ጼዴቅ እብራሂም ዎመተ ቄል ፈንቀሎ ወክት እሲን ዎቃን ደቀም ማሰዕዮስ። <verse eid="HEB 7:1"/><verse number="2" style="v" sid="HEB 7:2"/>እብራሂምን እሲሃ አግ አፎርቺች ጉዕሚቺን ቶኒች መቱስ ኣሴስ፤ መልከ ጼዴቄ ሱዕምስ ፍሳረት ወዕናሃ «ፈየ ዎመ» ዩሃን፤ ህትን ዎሉስ «ሳሌም ዎመ» ህከረንገ «ወገሬት ዎመ» ዩሃን። <verse eid="HEB 7:2"/><verse number="3" style="v" sid="HEB 7:3"/>መልከ-ጼዴቂሃ አኑለከ አመት ዮስበአ፤ እለንሽ ዘርት ዮስበአ፤ ዘማንሀስ ብርት ሄእሀስ ኤተሩ ዮስበአ፤ ጠዉ እኮጎሬ መገን ቤት ምሳልተ እክ ዘላለሚሃ ቂስቹ እክ ሄአኖ።<verse eid="HEB 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4"/>ወዕኔ አኑ እብራሂም አግ ኤቦሀኒች ቶኒች መቱስ ኣሴስ ኩ መንቹ ሄንከ ሎረ ጎር ለዕዬ! <verse eid="HEB 7:4"/><verse number="5" style="v" sid="HEB 7:5"/>ሌዌ ዘሬች ቂሰ እኮእሩ ኡመቲችስ እብራሂም ዘርተ እኮ አመሰ ኦሶች ቶኒች መቱ ኣእታገ ትዛዙ ሕጊን አዘዘሞሰ።<note caller="-" style="x"><char style="xo" closed="false">7፥5 </char><char style="xt" closed="false"><ref loc="NUM 18:21">ዘኁ. 18፥21</ref>።</char></note> <verse eid="HEB 7:5"/><verse number="6" style="v" sid="HEB 7:6"/>ሁኩ መልከ-ጼዴቅ ሌዋውያን ዘርተ እህበጎሬ እብራሂሚች ቶኒች መቱ ኣኤእ፤ ተብሴ ላገተ ኣሰሞስ እብራሂመ ማሰዕዮስ። <verse eid="HEB 7:6"/><verse number="7" style="v" sid="HEB 7:7"/>ህካን እኮቤቺሃ ማዕኑ ሀንገፊች ማሰተ ኣአኖገ ሸክት ዮስበአ። <verse eid="HEB 7:7"/><verse number="8" style="v" sid="HEB 7:8"/>መቶ አዲን ቶኒች መቱ ቶጋዕሩ ሬታእሃ መነ፤ ህትን ዎሎ አዲን ቶኒች መቱ ቶገኖሁ ህትን ሄአኖሃ እክ መሰከረሞሲሁ ጠሊለ መጻፋን ከተበሞገን መልከ ጼዴቄት። <verse eid="HEB 7:8"/><verse number="9" style="v" sid="HEB 7:9"/>ቴሁ ቶኒች መቱ ጭምአአኖ ሌዊ ገውንኩስ እብራሂም አዲን ቶኒች መቱስ ባቾ ዩሃን። <verse eid="HEB 7:9"/><verse number="10" style="v" sid="HEB 7:10"/>መሰንትስ መልኬ-ጼዴቄ እብራሂምን ዎቄ አሌን ደቀሞ ወክት ሌዊ እብራሂሚች ከለቀሞበአ እቅ።<verse eid="HEB 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11"/>ቴሁ ሕጉ እስረኤል ኡመቲሃ ኣሰሞሁ ሌዌ ቂሶመ አዲኒት፤ ህትን ቂሶማን ጉዕሙርቹንኩ ዊመ እክ ደገሞ እቃን ሀሩንገ እሁዕነ መልከ-ጼዴቄገ ዮእ ዎሉ ቂስቹ ሚ ሀስሰኖ እቅ? <verse eid="HEB 7:11"/><verse number="12" style="v" sid="HEB 7:12"/>መሰንትስ ቂሶመት ዶረንቶች ህትን ቂሶመ ሕጉ ዶረሙ ሀስሰኖስ። <verse eid="HEB 7:12"/><verse number="13" style="v" sid="HEB 7:13"/>ኩ ጠው እስተኔ ኩለሞ ቂስቹ ዎሎ ደቦቺት፤ ህከን ደቦችን አዪሁ መገኒሃ ክትም ሆንጠህሴኖ ጠረጴዝበ ሆንጠክ ካደሞሁ ዮበአ። <verse eid="HEB 7:13"/><verse number="14" style="v" sid="HEB 7:14"/>መሰንትስ ቀርቹ እለሞሁ አይሁድ ደቦች እሁስ ለልዮእሃ ጠወ፤ ሙስን አይሁድ ዘሬ ቂሰተኔሃ መቱርቹሃ ኩሎበአ።<verse eid="HEB 7:14"/></para>
  <para style="b"/>
  <para style="s1">መሲህ መልኬ-ጼዴቄገ ዮ ቂስቹ እሁስ</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15"/>መልኬ-ጼዴቄገ ዮ ዎሉ ቂስቹ አሜቾ ወክት ኩ ጠው ኑር እክ ለለኖ። <verse eid="HEB 7:15"/><verse number="16" style="v" sid="HEB 7:16"/>እስ ቂሶመ ሹምነቱ መን ዘሬችስ አሜቾ ሴሪን አሜቶእተ እኩዕናን ህግበ ሄእ ወልቃን አሜቶእታን። <verse eid="HEB 7:16"/><verse number="17" style="v" sid="HEB 7:17"/>መሰንትስ «አት መልከ-ጼዴቅ ቂሶመገ ጉዕመ ዘማኒንከ ቂስቹሃን» የመም ጠሊለ መጻፋን መሰከረሞስ።<note caller="-" style="x"><char style="xo" closed="false">7፥17 </char><char style="xt" closed="false"><ref loc="PSA 110:4">መዝ. 110፥4</ref>።</char></note> <verse eid="HEB 7:17"/><verse number="18" style="v" sid="HEB 7:18"/>ህካን እኮቤቺሃ ወዕኔ ዘማን ሕጉ ላፈለከ ደግለልባሃ እኮቤቺሃ ድጀሞኡ። <verse eid="HEB 7:18"/><verse number="19" style="v" sid="HEB 7:19"/>እኮጎሬ ነኡ መገን ቤቹ ሆንጠንካም ቆሀኖ ተብሶሁ አሜቾኡ፤ መሰንትስ ሙስ ሕግ አዲን ሀኩ መንቹሁ መገን ብሬን ነጠ እሆተ አታሎበአ።<verse eid="HEB 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20"/>ኩ ቂሶመት አሜቶኢሁ መገን ወኣድ ቤሉ እኮበአ፤ እኮጎሬ ዎሉሰ ቂሰ እኮኢሁ ወኣድ ቤሉሃት። <verse eid="HEB 7:20"/><verse number="21" style="v" sid="HEB 7:21"/>እኮጎሬ እስ ቂሶመት ወኣዲን እኮእታን፤ መሰንትስ</para>
  <para style="q1" vid="HEB 7:21">«መገኑ ‹አት ዘላለሚሃ ቂስቹሃን› ይ ወኣድ ኣጎቤቺሃ ሰጨኖበአ»</para>
  <para style="q2" vid="HEB 7:21">የመም እስተኔ ጠወአሞኡ።<note caller="-" style="x"><char style="xo" closed="false">7፥21 </char><char style="xt" closed="false"><ref loc="PSA 110:4">መዝ. 110፥4</ref>።</char></note><verse eid="HEB 7:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="HEB 7:22"/>ህከን ወኣድ መሳን ኬዕዮሀኒን ኢስ ቆሀኖ ወኣዲሃ ሩበታስንቹ እኮኡ።<verse eid="HEB 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23"/>ዎኔ ዘማን ቂሰት ሆጉሰ አጉርቱዕናን አታበእገ ሬሁት ከንቶቤቺሃ እሰ ወሊንሹ ልግብያ እቅ። <verse eid="HEB 7:23"/><verse number="24" style="v" sid="HEB 7:24"/>እኮጎሬ ኢስ ዘላለሚሃ ሄአኖሃ እኮቤቺሃ ዶረንትበ ቂሶመት ዮስ። <verse eid="HEB 7:24"/><verse number="25" style="v" sid="HEB 7:25"/>ኢስ እሰተኔሃ መገኑ ኡጮሰተ ጉዕመ ወክትንከ ሄአኖሃ እኮቤቺሃ እስ አዲን መገንበ ሆንጠካረ ዘላለሚሃ ጡምሶሰተ አታለኖ። <verse eid="HEB 7:25"/><verse number="26" style="v" sid="HEB 7:26"/>ኔሳሃ ህትናሙ ጠሊሉ፥ ኩሌኖስርቹ ዮስበኢሁ፥ ነጠ፥ ጩበኛኖች አደ እኮሃ፥ ሰሜች አሌ ዋል ጎት ዬኢሁ ሎሩ ቂሰ ሀለቁ ሀስሰኖኔ። <verse eid="HEB 7:26"/><verse number="27" style="v" sid="HEB 7:27"/>እስን ዎሎ ሎረ ቂስገ ሄጭ ገይስ ጩብተኔሃ ኤተሮን ኡመት ጩብተኔሃ በሬን በሬን ክትም ሆንጠህሱ ሀስሰኖስበአ፤ ገውስ ክትም አዕይ ሆንጠህሾ ወክት ለንኪሃ በርጌኖበእገ ሜጥቾረን ሹል ቅጥ አዕዮኡ።<note caller="-" style="x"><char style="xo" closed="false">7፥21 </char><char style="xt" closed="false"><ref loc="LEV 9:7">ሌዌ 9፥7</ref>።</char></note> <verse eid="HEB 7:27"/><verse number="28" style="v" sid="HEB 7:28"/>ሙስ ሕጉ ላፈ መነ ሎረ ቂሰ አዎንሳኑተ አዕይ ሾመኖሰ፤ እኮጎሬ ሕጊች ኤተሮን አሜቾሁ ወኣድ ላጋን እኮጎሬ ዘላለሚሃ ኩሌኖስርቹ ዮበኢሃ መገን ቤቱ ሹመ አዕዮስ።<verse eid="HEB 7:28"/></para>
  <para style="b"/>
  <chapter eid="HEB 7"/>
  <chapter number="8" style="c" sid="HEB 8"/>
  <para style="s1">ኢስ ሃዕሮ ወኣድ ላገ ሎረ ቂሰ ሀለቀ እሁስ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1"/>ቴሁ ጠወዕኖም ጠዊች ቡዕሉስ ከኒት፤ ሁኩንን ጉዕሚች ሎረ እኮ መገን ዎመ ቦርጭመ መኬ አዲን ሰማን አፉዕሌ ህትናሙ ሎሩ ቂሰ ሀለቁ ዮኔ።<note caller="-" style="x"><char style="xo" closed="false">8፥1 </char><char style="xt" closed="false"><ref loc="PSA 110:1">መዝ. 110፥1</ref>።</char></note> <verse eid="HEB 8:1"/><verse number="2" style="v" sid="HEB 8:2"/>እስ ሀንቅ ዱካነ እኮ ዱእ ምኒ ኣዜን ቂሰ ሀለቀ እክ ካደመኖሃን፤ ዱካኑስ መን አንጋን እሁዕነ ቀርች አንጋን ካሰሞእሃን። <verse eid="HEB 8:2"/><verse number="3" style="v" sid="HEB 8:3"/>ሎሩ ቂሰ ሀለቀት ጉዕሙንኩ ሾመንታኢሁ መገኒሃ ሰደቀለከ ክትመ ሆንጠህሲሃት፤ ህካን እኮቤቺሃ ከን ቂስቺሃ ክትሚ ሆንጠህሴኖ መቱርቹ ሄኡ ሀስሰኖስ። <verse eid="HEB 8:3"/><verse number="4" style="v" sid="HEB 8:4"/>እስ ኣዱንያ አሌን ሄዕዮእቃን ቂስቹ እሀኖበአ እቅ፤ ሁኩንን ሕግጊን መገኒሃ አኤኖርቹ ሆንጠህሳ ዎሉ ቂሰት ሄኦቤቺሃት። <verse eid="HEB 8:4"/><verse number="5" style="v" sid="HEB 8:5"/>እሰ አቶኢሁ ሰማን ዮኢሃ ምሳልተለከ ሀላሃ እኮሀን ኣዜኒት እቅ፤ ሁኩን እኮሁ ሙስ ዱካነ መክሶተ ቅጥዬ ወክት መገኑ «ቆተ አሌን ለሌሄ ሃሊን ጉዕመርቹንከ አገርት አእ» ይ አዘዦስጋት። <verse eid="HEB 8:5"/><verse number="6" style="v" sid="HEB 8:6"/>ቴሱ እኮጎሬ ኢስ በል መንቹ እኮ ወኣድ ላገተ ኑባቾ ወኣድ ላጋች ሎረ እኮቤቺሃለከ ቆሀኖ ወኣድ ላጋን ጀመረሞሃ እኮቤቺሃ እሲሃ ኣሰንቶ ሆጉት ሎረታን።<verse eid="HEB 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7"/>ዎዕኔ ወኣዴን ሉጨንሹ ዮበእቃን ለንክ ወኣድ ላገት ሀሲሳሰበአ እቅ። <verse eid="HEB 8:7"/><verse number="8" style="v" sid="HEB 8:8"/>መሰንትስ ቀርቹ መገኑ እሳን ሉጨንሸ ደግ</para>
  <para style="q1" vid="HEB 8:8">«ቴሱ አን እስራኤልለከ አይሁድ ባድ መኒን</para>
  <para style="q2" vid="HEB 8:8">ሃዕሮ ወኣድ ላገተ ኣጋም ወክቱ አሜተኖ» የኖ ቀርቹ።<note caller="-" style="x"><char style="xo" closed="false">8፥8-12 </char><char style="xt" closed="false"><ref loc="JER 31:31-34">ኤር. 31፥31-34</ref>።</char></note><verse eid="HEB 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 8:9"/>ኩ ወኣድ ላገተ አን ግብጽ ባዲች ፉሾሰተ አንገሰ አፎም በር አበናኖንከሰ ኣጎም ወኣድ ላጋ ደነበአ፤ መሰንትስ እሰ ኢ ወኣድ ላገተ ጠረኝት ሄኡ ሆጎቤቺሃ አጉሮንሰ።<verse eid="HEB 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10"/>«ህከን ዘማኒች ኤተሮን እስረኤል መኒሃ</para>
  <para style="q2" vid="HEB 8:10">ኣጋም ወኣድ ላገት ተኔት ይ ጠወዕዮ ቀርቹ፤</para>
  <para style="q1" vid="HEB 8:10">ኢ ሕገንከ ቀልቤንከሰ አኣም፤</para>
  <para style="q2" vid="HEB 8:10">ወዘናንከሰን ከተባም፤</para>
  <para style="q2" vid="HEB 8:10">አነሰ መገኑ እሃም፤</para>
  <para style="q2" vid="HEB 8:10">እሰን ኢ ኡመት እካአ።<verse eid="HEB 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11"/>እሳችን አዪሁ ዎሉ መነሃ</para>
  <para style="q2" vid="HEB 8:11">አመስቤቱ ‹መገኑ ደግ› ይ ተማርሰኖስበአ፤</para>
  <para style="q1" vid="HEB 8:11">መሰንትስ ቀዊች ኬሽ ሎረ ኢለ ጉዕሙንኩ</para>
  <para style="q2" vid="HEB 8:11">ኤሳሃ ደጋኤ።<verse eid="HEB 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12"/>አን እሰ ሂልመተ አጉረንሰ፤</para>
  <para style="q2" vid="HEB 8:12">ጩብሰን ለንኪሃ ሰውያምበአ» የኖ ቀርቹ።<verse eid="HEB 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13"/>ቴሱ «ሃዕሮ ወአድ ላገተ» የኖ ወክት ወዕኔ ወኣድ ላገተ ኑባቹ አዕዮኡ ዩሃን፤ ህካን እኮቤቺሃ ኑባጴኢሁ በአኖ ወክቱ ኢልዮኡ ዩሃን።<verse eid="HEB 8:13"/></para>
  <para style="b"/>
  <chapter eid="HEB 8"/>
  <chapter number="9" style="c" sid="HEB 9"/>
  <para style="s1">ኣዱንያ አሌን ዱአ አኤኖ ምኒ ክድመተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1"/>ዎዕኔ ወኣድ ላገ ሰገዴኖ ሴሩለከ መን አንጋን እጃረሞ መገኒሃ ሰገዴኖ ምኑ ዮስሃ እቅ። <verse eid="HEB 9:1"/><verse number="2" style="v" sid="HEB 9:2"/>ለሙ ክፍሉ ዮስ ዱካኑ ቅጥይዮ እቅ፤ ወዕኔ አብል ክፍሉ ኩራዘ አፉሼኖሁለከ ጠረጴዙ፥ ክትም ዳቡቲ ሄኦ ዎዕኔ ክፍሉ «ጠሊለተ» የመንታ እቅ።<note caller="-" style="x"><char style="xo" closed="false">9፥2 </char><char style="xt" closed="false"><ref loc="EXO 26:1-30">ፉል. 26፥1-30</ref>፤ <ref loc="EXO 25:31-40">25፥31-40</ref>።</char></note> <verse eid="HEB 9:2"/><verse number="3" style="v" sid="HEB 9:3"/>ለንክ መጋረጂች ኤተር አዲን ደገመኖሁ ኣዝ ክፍሉ «ጠሊልች ጠሊለ» ዬኖቤቹ ሄዕዮ እቅ።<note caller="-" style="x"><char style="xo" closed="false">9፥3 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">ፉል. 26፥31-33</ref>።</char></note> <verse eid="HEB 9:3"/><verse number="4" style="v" sid="HEB 9:4"/>ህከን ክፍል ኣዜን ዎርቂን መክሴመ ህጣነ አጪሴኖ ጠረጴዙለከ ጉዕመንከስ ቤቹ ዎርቀ ቡሬን መክሴመ ወኣድ ላገ ሳጥኑ ሄዕዮ እቅ፤ ህከን ሳጥን ኣዜን «መና» ዬኖ እቸት ሄኦ ዎርቅ መሶቡ፥ ለቶ ሀሩን በርትቹትለከ ቶኑ ትዛዙ ከተበሞ ክኑ ሄዕዮ እቅ።<note caller="-" style="x"><char style="xo" closed="false">9፥4 </char><char style="xt" closed="false"><ref loc="EXO 30:1-6">ፉል. 30፥1-6</ref>፤ <ref loc="EXO 25:10-16">25፥10-16</ref>፤ <ref loc="EXO 16:33">16፥33</ref>፤ <ref loc="NUM 17:8-10">ዘኁ. 17፥8-10</ref>፤ <ref loc="EXO 25:16">ፉል. 25፥16</ref>፤ <ref loc="DEU 10:3-5">ዘዳ. 10፥3-5</ref>።</char></note> <verse eid="HEB 9:4"/><verse number="5" style="v" sid="HEB 9:5"/>ታቦት አሌን ዮ ጩቡ አጉረመኖ ቤቹ ቴለኖ መዴንከሰ ጌረዳ ጎንት ዮሰ መገን ኬዕምኝ ለሊሳ ክልቀቱ ሄኦ እቅ፤ ጠዉ እኮጎሬ ከን ጠውተኔሃ ጉዕሚንከ ቴሱ መቱርቹሃ ጠወዕኖተ አታልናምበአ።<note caller="-" style="x"><char style="xo" closed="false">9፥5 </char><char style="xt" closed="false"><ref loc="EXO 25:18-22">ፉል. 25፥18-22</ref>።</char></note><verse eid="HEB 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6"/>ጉዕሙርቹንኩ ህት ቅጥ ዬች ኤተሮን ቂሰት ሆጉሰ አቶተ ዱካን ዎኔ ክፍል ኣዝ ጉዕመ ወክት ኣጋ እቅ።<note caller="-" style="x"><char style="xo" closed="false">9፥6 </char><char style="xt" closed="false"><ref loc="NUM 18:2-6">ዘኁ. 18፥2-6</ref>።</char></note> <verse eid="HEB 9:6"/><verse number="7" style="v" sid="HEB 9:7"/>ጠዉ እኮጎሬ ዎዕኔ ኣዝ ክፍል ጠለዕል ሎሩ ቂስቹ ዘማኔን መቱ ወክት ኣገኖ፤ እስን ገይስለከ መኑ ደጉዕነ አቶ ጩብሃ ቄጉ አፉዕነ ህከ ቤቹ ኣገኖበአ።<note caller="-" style="x"><char style="xo" closed="false">9፥7 </char><char style="xt" closed="false"><ref loc="LEV 16:2-34">ሌዌ 16፥2-34</ref>።</char></note> <verse eid="HEB 9:7"/><verse number="8" style="v" sid="HEB 9:8"/>ዎዕኔ ዱካኑ ሄከን ቤቾን ኡር ሄአንን ጠሊልች ጠሊለ ቤቹ መሰኖ ዎቆሁ ፈንተኡ ሆጉስ ጠሊሉ አያኑ ኩለኖ። <verse eid="HEB 9:8"/><verse number="9" style="v" sid="HEB 9:9"/>ኩ ጠው ከን ዘማኒሃ ምሳልተ እሀኖ፤ ኩንን ለሊሰኖሁ ሰደቀተለከ ክትመ ሆንጠህሰኖስ መንች ቀልብ መገን ብሬን ነጠ አኦስተ አታለኖበአ። <verse eid="HEB 9:9"/><verse number="10" style="v" sid="HEB 9:10"/>ጉዕሙንኩ ጠዉ መገኑ ጉዕመርቹንከ ሃዕሮ አኦተ ኢለ ጠለዕል ሆጎ አሌን ዱንክታ እትለከ አግ ህትን ዊን ኣዕሌን ነጠ እሄኖ ሴሪን እኮእራን።<verse eid="HEB 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11"/>ጠው እኮጎሬ መሲህ ቴሱ እሀኖ ጡመ ጠዊሃ ሎረ ቂስቹ እክ አሜቾኡ፤ እስ ኣጎ መገን ዱካኑ ሎረለከ ዊመ ዊሚን እክ መክዮእሃን፤ ሁኩ ዱካኑ መን አንጋን መክዮበኢሃለከ ከን ኣዱንያ አሌን ዮበእሃ። <verse eid="HEB 9:11"/><verse number="12" style="v" sid="HEB 9:12"/>ጠሊልች ጠሊለ ቤቹ ሜጦረን ገይስ ቄጊን ኣጎ ቤሉ ፌላእለከ ዎርጀመ ቄጉ አፍ ኣጎበአ፤ ህትን ዘማን ጉዕመንከ ሄኣ ዎዝኑተ ኣሴኔ። <verse eid="HEB 9:12"/><verse number="13" style="v" sid="HEB 9:13"/>ፌዕላእለከ ዎርጃመ ቄጉ፥ ህትን ክትሚሃ ቡሴመ ሱሉም ጠበሩ ንጃሶ መን አሌን ብን አኤኖረ ማል ንጃሲች ነጠ አዕይ ጠሊለ አሰኖሳሃ እኮች፥<note caller="-" style="x"><char style="xo" closed="false">9፥13 </char><char style="xt" closed="false"><ref loc="LEV 16:15-16">ሌዌ 16፥15-16</ref>፤ <ref loc="NUM 19:9">ዘኁ. 19፥9</ref>፤ 17-19።</char></note> <verse eid="HEB 9:13"/><verse number="14" style="v" sid="HEB 9:14"/>ጉዕመ ዘማኒሃ ሄአኖ ጠሊለ አያን አዲን ገውስ ህንቄኖርቹ ዮበእ ክትም አዕይ መገኒሃ ሆንጠህሾ መሲህ ቄጉ ሄአኖ መገኒሃ ካደሞተ ቀልብኔ ሄንከ ሬሁተ ኤበኖ ሂለ ሆጎች ነጠ አአኖ?<verse eid="HEB 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15"/>መገኑ ገኤሰሩ እስ ተብሴን ኣሴሰ ዘላለሚሃ ጎፍበ ኡለተ ረገኦተ መሲህ ሃዕሮ ወኣድ ላገ በል መንቹ እኮ፤ ሁኩንን መኑ ዎዕኔ ወኣድ ላጋ ኣዜን ጠገም ሄዕዮ ወክት አዕዮ ጩቢች ገይስ ሬሆን ጡምሶታት።<verse eid="HEB 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16"/>ሬሀኖ መንቹ ወስያተ ኩዕሌርቹ ሄዕዮ ጎሬ መንችስ ሬሁተ አጥራመቴን ደጉ ሀስሰኖ። <verse eid="HEB 9:16"/><verse number="17" style="v" sid="HEB 9:17"/>መሰንትስ ሬሀኖ መንቹ ኩዕሌርቹ ዊመኖሁ ሬዮች ኤተሮንት፤ ጠው እኮጎሬ ኩዕሌስ መንቹ ሬህባች ጠውስ ዊሞተ አታለኖበአ። <verse eid="HEB 9:17"/><verse number="18" style="v" sid="HEB 9:18"/>ህካን እኮቤቺሃ ዎዕኔስ ወኣድ ላጋ ቄጉ ዱንተኡዕነ ህትን ጠረኝዮበአ እቅ። <verse eid="HEB 9:18"/><verse number="19" style="v" sid="HEB 9:19"/>ሙስን ሕግ ትዛዝ ኡመቲሃ ኩሎች ኤተሮን ዎርጃምለከ ፌዕላእ ቄጉ ዊን ልቀለቅ ቢሸ ሆለ ኦርዛንለከ «ህሶጰ» ዬኖ ሀሚን ሕግ መጻፋንለከ ኡመት አሌን ኪፎ። <verse eid="HEB 9:19"/><verse number="20" style="v" sid="HEB 9:20"/>ህካን ኪፎንኩ «ኩን መገኑ አገርቶኖተ አዘዦህዕኔ ወኣድ ላጋ ቄጉ ከኒት» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">9፥19-20 </char><char style="xt" closed="false"><ref loc="EXO 24:6-8">ፉል. 24፥6-8</ref>።</char></note> <verse eid="HEB 9:20"/><verse number="21" style="v" sid="HEB 9:21"/>ህትን ሙስ ዱካናንለከ ኣዜንከስ ሄኦ ጉዕማንከ ደግለሸቀሜኖ ኦዳ አሌን ቄጉ ኪፎ።<note caller="-" style="x"><char style="xo" closed="false">9፥21 </char><char style="xt" closed="false"><ref loc="LEV 8:15">ሌዌ 8፥15</ref>።</char></note> <verse eid="HEB 9:21"/><verse number="22" style="v" sid="HEB 9:22"/>ሀንቅንከ ሙስ ሕግ ሃሊን ቀዎርች ቤሉ ጉዕሙርቹንኩ ቄጊን ነጠ እሀኖ፤ ቄጉ ዱንተኡዕነ ጩቡ አጉረመኖበአ።<note caller="-" style="x"><char style="xo" closed="false">9፥22 </char><char style="xt" closed="false"><ref loc="LEV 17:11">ሌዌ 17፥11</ref>።</char></note><figure style="fig" alt="Hyssop" file="HK00114B.tif" size="span" ref="9፥19">ህሶጵ ሀበረ</figure><verse eid="HEB 9:22"/></para>
  <para style="s1">መሲህ ሬሁት ጩብ ቤሳኢሃ እሁስ</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23"/>ቴሁ ኩ ሰማን ዮ ምሳልተ እኮ ኦዳት ጉዕሙንኩ ከን ክትሚን ነጠ እካአ፤ እኮጎሬ ሰማን ዮ ምሳልት ከኒች በተአኖ ክትሚን ነጠ እሁ ሀስሰኖሰ። <verse eid="HEB 9:23"/><verse number="24" style="v" sid="HEB 9:24"/>መሲህ ሀንቅ ምሳልተ እኮ መን አንጋን እጃረሞ ጠሊልች ጠሊለ ቤቹ ኣጎበአ፤ ጠው እኮጎሬ ኒተኔሃ ይ መገን ብሬን ለሎተ እስ ሰማሃ ኣጎ። <verse eid="HEB 9:24"/><verse number="25" style="v" sid="HEB 9:25"/>አይሁድ ሎረ ቂሰ ሀለቁንኩ ዘማን ዘማኔን ገይሲሃ እህበ ቄጉ አፍ ጠሊልች ጠሊለ ቤቹ ኣገኖገን መሲህ ገዉስ ልግብ ወክት ክትሚ አዕይ ሆንጠህሶተ ኣጎበአ። <verse eid="HEB 9:25"/><verse number="26" style="v" sid="HEB 9:26"/>ህት እኮች ኣዱንያት ከለቀንቶች ኬሽ ልግብ ወክት ኦርሸተ ቶጉ ሀስሰኖስ እቅ፤ ቴሱ እኮጎሬ ዘማን መጨረሻን እስ ገዉስ ክትም አዕይ ሆንጠህሽ ጩብ ቤሶተ በረገምበ ሃሊን ለልዮኡ። <verse eid="HEB 9:26"/><verse number="27" style="v" sid="HEB 9:27"/>መኒሃ መቶረ ሬሁ ሀስሰኖስ፤ ህትን ሬሆች ኤተሮን ፍርዱ ዮኡ። <verse eid="HEB 9:27"/><verse number="28" style="v" sid="HEB 9:28"/>ህትን መሲህ ልግብ መን ጩብ ቤሶተ መቶረ ክትመሞኡ፤ ህትን ጩብ እጂሃ እሁዕነ እሱ አገርታእረ ጡምሶተ ለምቅ ወክት ለለኖ።<note caller="-" style="x"><char style="xo" closed="false">9፥28 </char><char style="xt" closed="false"><ref loc="ISA 53:12">ኢሳ. 53፥12</ref>።</char></note><verse eid="HEB 9:28"/></para>
  <chapter eid="HEB 9"/>
  <chapter number="10" style="c" sid="HEB 10"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1"/>ቴሱ ሕጉ ከ ኤተሩ አሜተኖሁ ጡመ ጠዊሃ ሀላሃ ቤሉ ሀንቅ ደናስበአ እቅ፤ ህካን እኮቤቺሃ ጉዕመ ወክትንከ ዘማን ዘማኔን ክትመንታ ክትመተ አፍ መገን ቤቹ ሆንጠካ መነ ሆሮን ነጣኑተ አኦተ ሆሮ አታለኖበአ። <verse eid="HEB 10:1"/><verse number="2" style="v" sid="HEB 10:2"/>አታሎሃ እኮ እቃን ሁኩ ክትም ሆንጠህሳ መኑ መቶረ ጩብችሰ ነጠ እኮች ኤተሮን ነጠ እኮገ ቀልቡሰ ደገኖቤቺሃ ክትምስ ሆንጠህሱ አጉርታ እቅ። <verse eid="HEB 10:2"/><verse number="3" style="v" sid="HEB 10:3"/>ጠዉ እኮጎሬ ሁኩ ክትመት ዘማን ዘማኔን ጩብ ቃግሳእራን። <verse eid="HEB 10:3"/><verse number="4" style="v" sid="HEB 10:4"/>መሰንትስ ዎርጃመለከ ፌዕላእ ቄጉ ጩብ ቤሶተ አታለኖበአ።<verse eid="HEB 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HEB 10:5"/>ህካን እኮቤቺሃ መሲህ ከ ኣዱንያ አል አሜቾ ወክት</para>
  <para style="q1" vid="HEB 10:5">«ክትመለከ መገን ምኒሃ ሆንጠህሴኖርቹ ሀሶንትበአ፤</para>
  <para style="q2" vid="HEB 10:5">ጠዉ እኮጎሬ ጅስመ ቅጥ አቶንቴኤ፤<note caller="-" style="x"><char style="xo" closed="false">10፥5-7 </char><char style="xt" closed="false"><ref loc="PSA 40:6-8">መዝ. 40፥6-8</ref>።</char></note><verse eid="HEB 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6"/>ህትን ጉዕመንከስ ቡሴኖ ክትምለከ</para>
  <para style="q1" vid="HEB 10:6">ጩብ ነጠ አአኖ ክትሜን</para>
  <para style="q1" vid="HEB 10:6">ሙንደኦንትበአ።<verse eid="HEB 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7"/>ህከ ወክት መጻፋን፥</para>
  <para style="q1" vid="HEB 10:7">‹ኢተኔሃ ከተበሞገን ሁኩዕኑን ኢ መገኖ!</para>
  <para style="q2" vid="HEB 10:7">አን ኪ ሙራድ ዊንሾተ ከቤቹ አሜቾም› ዬም» ዬእ።<verse eid="HEB 10:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8"/>ወዕናሃ «ክትመለከ ሰደቀተ፥ ቡሴኖ ክትመለከ ጩብተኔሃ ክትሜኖ ክትም ሀሶንትበአ፤ እሶኒን ሙንደኦንትበአ» ኩሩኡት ሕግገ ሆንጠካእረ ዬእ። <verse eid="HEB 10:8"/><verse number="9" style="v" sid="HEB 10:9"/>ህከኒች ኤተሮን «ኢ መገኖ! አን ኪ ሙራድክ ዊንሾተ አሜቾም» ዬእ፤ ህትን ዎኔሲሃ ክትመ ከም ቤቾንከስ ለምቅ ክትም ጠረኝሾ። <verse eid="HEB 10:9"/><verse number="10" style="v" sid="HEB 10:10"/>ህካን እኮቤቺሃ መሲህ ኢስ መገን ሰውት አኢን ሜጦረ ሹል ማለስ ክትም አዕይ ሆንጠህሲንከስ ነኡ ጩብችኔ ጠሊላኑተ እንኮም።<verse eid="HEB 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11"/>ሁኩ ሎሩ ቂሰት ጉዕሙንኩ ህከ ጩብ ቤሶተ ሆሮን አታልትቡ ህከ ክትማከተ ልግብ ወክት ሆንጠህሰን በሬን በሬን ኡር ካደመኖ።<note caller="-" style="x"><char style="xo" closed="false">10፥11 </char><char style="xt" closed="false"><ref loc="EXO 29:38">ፉል. 29፥38</ref>።</char></note> <verse eid="HEB 10:11"/><verse number="12" style="v" sid="HEB 10:12"/>ጠዉ እኮጎሬ መሲህ ዘላለሚሃ መቱ ክትመ ሆንጠህሾች ኤተሮን መገን መኬ አዲን አፉዕልዮኡ። <verse eid="HEB 10:12"/><verse number="13" style="v" sid="HEB 10:13"/>ከኒች ኤተሮን ዲነስ ሎካችስ ዎሮን እኮተ ኢለ አገረኖት።<note caller="-" style="x"><char style="xo" closed="false">10፥12-13 </char><char style="xt" closed="false"><ref loc="PSA 110:1">መዝ. 110፥1</ref>።</char></note> <verse eid="HEB 10:13"/><verse number="14" style="v" sid="HEB 10:14"/>መሰንትስ መገኒሃ አደ እኮሁ ሜጦረ ሆንጠህሾ ክትሚን ዘማኒሃ ጉዕሚሃ ሹል ነጣኑተ አዕዮሰቤቺሃት።<verse eid="HEB 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15"/>ሄጭ ጠሊሉ አያኑ ከን ጠዋን መሰከረኖኔ፤<verse eid="HEB 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16"/>«ህከን ዘመኒች ኤተሮን</para>
  <para style="q1" vid="HEB 10:16">እሳን ኣጋም ወኣድ ላገት ተኒት የኖ ቀርቹ፤</para>
  <para style="q1" vid="HEB 10:16">ቀልቤንከሰ ኢ ሕገ አፉሻም፤</para>
  <para style="q2" vid="HEB 10:16">ቡዕልሰ ኣዜን ከተቦም» ዬእ፤<note caller="-" style="x"><char style="xo" closed="false">10፥16 </char><char style="xt" closed="false"><ref loc="JER 31:33">ኤር. 31፥33</ref>።</char></note><verse eid="HEB 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HEB 10:17"/>ህትን «ጩብሰለከ ሂለ ሆጉሰ</para>
  <para style="q2" vid="HEB 10:17">ሆሮ ሰውያምበአ» የኖ።<note caller="-" style="x"><char style="xo" closed="false">10፥17 </char><char style="xt" closed="false"><ref loc="JER 31:34">ኤር. 31፥34</ref>።</char></note><verse eid="HEB 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 10:18"/>ህካን እኮቤቺሃ ጩቡ ጉዕሙንኩ አጉረሞች ኤተሮን ጩብተኔሃ ሆንጠህሴኖ ክትሙ ሆሮን ሄአኖበአ።<verse eid="HEB 10:18"/></para>
  <para style="s1">መገን አደ ሆንጠሁ ሀስሰኖሃ እሁስ</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19"/>አመኤ ኦሶ! ኢስ ቄግ መሳን ጠሊልች ጠሊለ ቤቹ ኣንጎተ አታልሲሰኖኔ መለልመተ ደእኖም። <verse eid="HEB 10:19"/><verse number="20" style="v" sid="HEB 10:20"/>ኣንጋሚንኩ መጋረጅ አዲን ሁኩንን ገይስ ጅስም አዲን ፈኞኔ ሃዕሮ ዘመኒሃ ጉዕሚንከ ሄአኖ ዎቄኒት። <verse eid="HEB 10:20"/><verse number="21" style="v" sid="HEB 10:21"/>መገን ምኔን ሹምነቱ ዮስ ሎሩ ቂስቹ ዮኔ። <verse eid="HEB 10:21"/><verse number="22" style="v" sid="HEB 10:22"/>ህካን እኮቤቺሃ ሂለ ጠዊች ነጠ እንኮተ ቀልብኔ መሲህ ኢስ ቄጊን ነጠ አዕን ጅስመኔ ነጠ ዊን ኣዕልን ሀንቅ አመዕነቲንለከ ነጠ ቀልቢን መገን ቤቹ ሆንጠንኮ።<note caller="-" style="x"><char style="xo" closed="false">10፥22 </char><char style="xt" closed="false"><ref loc="LEV 8:30">ሌዌ 8፥30</ref>፤ <ref loc="EZK 36:25">ሕዝ. 36፥25</ref>።</char></note> <verse eid="HEB 10:22"/><verse number="23" style="v" sid="HEB 10:23"/>ከ ወኣድ ላገተ ኣሴኔሁ አመዕነሞኢሃ እኮቤቺሃ ከን አመዕንን መሰከርናም ተብሳሃ ለሞንሱዕነ ጠረኝንስ አንፎ። <verse eid="HEB 10:23"/><verse number="24" style="v" sid="HEB 10:24"/>ኢታንለከ ጡመ ሆጎን መት-መቱኔ ጠረኝጨቀሞ ቤሉ ሀበቀሙንከ። <verse eid="HEB 10:24"/><verse number="25" style="v" sid="HEB 10:25"/>ጉዕመ ወክትንከ ደቀመን መት-መቱኔ ጠረኝንሶ ቤሉ መት-መቱ መኑ ጭምዩ ሮሶገን ጭምዩ አጉርኑንከ፤ ዎዕኔች ባሰንከስ ቀርች አሜት በሩ ሆንጠኮገ ሰውይቴነን ከ ጠወ አዕዬ።<verse eid="HEB 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26"/>ነኡ ሀንቅ ደእኖሚች ኤተሮን ኢትን ጩብ አዕኖምጎሬ ጩብሃኔ እሀኖ ዎሉ ክትሙ ሄአኖበአ። <verse eid="HEB 10:26"/><verse number="27" style="v" sid="HEB 10:27"/>ጠዉ እኮጎሬ ከ ኤተሩ አገረመኖሁ ዋጅሲሰኖ ፍርድ በሩለከ መገኑ ግባ መነ እታ ጠረኘት ጊረት ዮኡ።<note caller="-" style="x"><char style="xo" closed="false">10፥27 </char><char style="xt" closed="false"><ref loc="ISA 26:11">ኢሳ. 26፥11</ref>።</char></note> <verse eid="HEB 10:27"/><verse number="28" style="v" sid="HEB 10:28"/>ሙሲ ሕገ ህንቆ መንቹ ለሙ ህከረንገ ሰሱ ምስክሩ አሌስ መሰከሮች መረርሲጩ ዮበኢሃ ሬሀኖ።<note caller="-" style="x"><char style="xo" closed="false">10፥28 </char><char style="xt" closed="false"><ref loc="DEU 17:6">ዘዳ. 17፥6</ref>፤ <ref loc="DEU 19:15">19፥15</ref>።</char></note> <verse eid="HEB 10:28"/><verse number="29" style="v" sid="HEB 10:29"/>ህከረ መገን ቤቱ ህንቆሁ፥ ገዉንከስ ጠሊለ አዕዮስ ወኣድ ላገ ቄጉ ንጀስሾሁለከ መገን ኣስቶ አያነ ቦሮሮሁ ሄንከ ጠረኘገ ቀጠአመኖሃ አጉደኖህዕኔ?<note caller="-" style="x"><char style="xo" closed="false">10፥29 </char><char style="xt" closed="false"><ref loc="EXO 24:8">ፉል. 24፥8</ref>።</char></note> <verse eid="HEB 10:29"/><verse number="30" style="v" sid="HEB 10:30"/>መሰንትስ «ገዱተ ፉላሚሁለከ ሀስሰኖ ኤዳሃ ባታሚሁ አኔት» ህትን «መገኑንኩ ኡመትስ አሌን ፈረደኖ» ዬኢሁ አዬት ጎር ደንጋም።<note caller="-" style="x"><char style="xo" closed="false">10፥30 </char><char style="xt" closed="false"><ref loc="DEU 32:35-36">ዘዳ. 32፥35-36</ref>።</char></note> <verse eid="HEB 10:30"/><verse number="31" style="v" sid="HEB 10:31"/>ህካን እኮቤቺሃ ሄአኖ መገን አንጋን ኡቡ አበ ዋጅሲሰኖሃን።<verse eid="HEB 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32"/>መሲህ ኑር ቶጌንታች ኤተሮን ልግብ ኦርሸተ ኣእቴን ጠረኘ አጰንሺን እጅቴንተ ዎኔ ዘማን ሰውይዬ። <verse eid="HEB 10:32"/><verse number="33" style="v" sid="HEB 10:33"/>መት-መቱ ወክት መን ብሬን ቦሮሬማህዕኔ እቅ፤ ጀልጀልይቴንታአ እቅ፤ መት-መቱ ወክት ህትናሙ ኦርሸት ኢሌሰሀኑኡን ሜጡበ አዕኑሁ መዲንከሰ እኬን ኦሪሸተ ቶጌንታአ። <verse eid="HEB 10:33"/><verse number="34" style="v" sid="HEB 10:34"/>አዕኑ ኡሱረሞ መኒሃ አሙዜነንታ፤ ቆሀኖለከ ጎፊበ ዱንያት ሰማን ዮህዕኔገ ደጌነንተቤቺሃ ዱንያክዕኔን ዘረፈንቶ ጎሬ ፈረኬን ጠወስ ሙንዲኖን ቶጌንታአ። <verse eid="HEB 10:34"/><verse number="35" style="v" sid="HEB 10:35"/>ቴሱ ሎረ ሽልማት ደእቴነንተገ አአኖ አመዕነሙክዕኔ ኡጅቶኖቼ። <verse eid="HEB 10:35"/><verse number="36" style="v" sid="HEB 10:36"/>መገኑ ኢተኖርቹ አቴን ሹልቴንታች ኤተሮን መገኑ ኣሶህዕኔተ ወኣድ ኣጎርቹ ደእቶኖተ ፈረኬን አገሩ ሀስሰኖህዕኔ። <verse eid="HEB 10:36"/><verse number="37" style="v" sid="HEB 10:37"/>መሰንትስ</para>
  <para style="q1" vid="HEB 10:37">«ሁኩ አሜተኖሁ ቀዎ ወክቲች ኤተሮን አሜተኖ፤</para>
  <para style="q2" vid="HEB 10:37">ዱንከኖበአ፤<verse eid="HEB 10:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38"/>ኢሀ እኮ ፈዩ መንቹ አመዕነትን ሄኡ ደአኖ፤</para>
  <para style="q2" vid="HEB 10:38">ጠዉ እኮጎሬ ኤተሩ ዋል ፈንቀሎ ጎሬ</para>
  <para style="q2" vid="HEB 10:38">አን እሲን ሙንደኣምበአ» የመም ከተበሞኡ።<note caller="-" style="x"><char style="xo" closed="false">10፥37-38 </char><char style="xt" closed="false"><ref loc="HAB 2:3-4">ዕን. 2፥3-4</ref>።</char></note><verse eid="HEB 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 10:39"/>ነኡ እኮጎሬ አመዕነቲን ጡምታሀኑኡኒት ቤሉ ኤተሩ ዋልት በኣሀዕኑኒበአ።<verse eid="HEB 10:39"/></para>
  <chapter eid="HEB 10"/>
  <chapter number="11" style="c" sid="HEB 11"/>
  <para style="s1">አመዕነትተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1"/>አመዕነቱ ዩ ተብሴን አገዕርናምረ ደእናምገለከ ለዕንበርቹ ሄኡስ አጥራመች ኩለኖኔሃን። <verse eid="HEB 11:1"/><verse number="2" style="v" sid="HEB 11:2"/>ዎዕኔ ዘማን መኑ መሰከረሞሳሁ አመዕነትሰ መሳኒት።<verse eid="HEB 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3"/>ከለቀሞርቹ ጉዕሙንኩስ መገን ላጋን ከለቀሞገለከ ለዕናምርቹ ጉዕሙንኩ ለዕንበርቺች እሁስ አመዕነቲን ደንጋም።<verse eid="HEB 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4"/>አቤል ቃኤሌ ክትሚች በተአኖ መገኑ ሙንዲሲሰኖ ክትም አመዕነቲን ሆንጠህሾ፤ እስ ሆንጠህሾ ክትም መገኑ ኢት ቶጎ ወክት ኣቤል አመዕነትስ መሳን ፈየ እኮገ መገኑ መሰከሮስ፤ ኣቤል ሬዮ ጎሬ አመዕነቲንከስ አዕዮ ሆጎን ከበሬ ኢለ ጠወአመኖት።<note caller="-" style="x"><char style="xo" closed="false">11፥4 </char><char style="xt" closed="false"><ref loc="GEN 4:3-10">ክል. 4፥3-10</ref>።</char></note><verse eid="HEB 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5"/>ሄኖክ ሬሁተ ለኡዕነ ሰማሃ ኦሮዕዮሁ አመዕነቲኒት፤ እስን መገኑ መሴስቤቺሃ ደገሞበአ፤ ሄኖክን መገኑ መሱዕናንስ ሄጭ መገኑ ሙንደእሲሾጉ መሰከረሞስ።<note caller="-" style="x"><char style="xo" closed="false">11፥5 </char><char style="xt" closed="false"><ref loc="GEN 5:21-24">ክል. 5፥21-24</ref>።</char></note> <verse eid="HEB 11:5"/><verse number="6" style="v" sid="HEB 11:6"/>ህትን አመዕነቱ ዮበኢሃ መገኑ ሙንዲሲሱ አታለመኖበአ፤ መሰንትስ መገን ቤቹ ሆንጠሀኖሁ ጉዕሙንኩ መገን ሄኡስለከ እሱ ሀሳሀኑኡተ ሽልማት ኣሰኖ እሁስ አመዕኑ ሀስሰኖስ።<verse eid="HEB 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7"/>ኑህ እሌን ለእባንከ እሀኖሃ እሁስ መገኑ ኩላንስ መገኑ ዋጅ ምንስ አበሮሱ ጡምሶተ መርከበ መክሾሁ አመዕነቲኒት፤ ኑህ አመዕነት መሳን ኣዱንያ አሉ ጩበኘ እክ ደገሞቤቺሃ ፈረደሞሰ፤ ኑህ አመዕነቲን ደኤኖ ፈይመተ ደእቶ መን በሊች መቱስ እኮ።<note caller="-" style="x"><char style="xo" closed="false">11፥7 </char><char style="xt" closed="false"><ref loc="GEN 6:13-22">ክል. 6፥13-22</ref>።</char></note><verse eid="HEB 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8"/>እብራሂም እርስተ አዕይ አፈኖበ መሮተ ገአሞ ወክት መረኖስቤቹ ሀከንቤቹጎር ደጉዕናን ትዛዝ ቶግ መሮሁ አመዕነቲንት።<note caller="-" style="x"><char style="xo" closed="false">11፥8 </char><char style="xt" closed="false"><ref loc="GEN 12:1-5">ክል. 12፥1-5</ref>።</char></note> <verse eid="HEB 11:8"/><verse number="9" style="v" sid="HEB 11:9"/>እስገን ተብሴ ላገተ ረገኣኑተ እኮሀኑኡች ይሳቂንለከ ያቁቢን ተቢሴን ኣሰሞ ባዶን ሆቀንሸ ኣግ ዱካናን ሄዕዮሁ አመዕነቲንት።<note caller="-" style="x"><char style="xo" closed="false">11፥9 </char><char style="xt" closed="false"><ref loc="GEN 35:27">ክል. 35፥27</ref>።</char></note> <verse eid="HEB 11:9"/><verse number="10" style="v" sid="HEB 11:10"/>መሰንትስ እብራሂም መገኑ አቀጆሁለከ ጠረኝሽ እጃሮ ጠረኙ ቀበቡ ዮ ዘላለም ከተመ አገዕረኖሴቤቺሃት እቅ።<verse eid="HEB 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11"/>ህትን ሳራሃ ተቢሳ ኣሴ መገኑ አመዕነሞሃ እኮገ ደጎቤቺሃ ሄንከሃ ኑባቹተ እሆንከሴ እሉ አታልትባተ እኮጎሬ ላፈተ እኮተ አታልታ ወልቀተ ደእቶኢሁ አመዕነቲኒት። <verse eid="HEB 11:11"/><verse number="12" style="v" sid="HEB 11:12"/>ህካን እኮቤቺሃ ሬዮ መንገ ዎለአመኖ መቲች እብራሂሚች ሰሜ ቤዜገ በተዕዮለከ ባር ሽፋርገ ዎለኤንቡ ዘርት ደገንቶኡ።<verse eid="HEB 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13"/>ሁኩ መኑ ጉዕሙንኩ ሬቶተ ኢለ አመዕነቱሰ አገርት ሄኦኡ፤ እሰን ኣሰሞሰ ተብሳሃ ደእቶበአ፤ ጠው እኮጎሬ ህካንን ቄዕራሻን ለእ ሙንዲኖን ኣእቶኡ፤ እሰን ኣዱንያ አሌን ኮሃለከ ዎሎ ባዲች አሜቶረ እሁሰ ጠወኦኡ።<note caller="-" style="x"><char style="xo" closed="false">11፥13 </char><char style="xt" closed="false"><ref loc="GEN 23:4">ክል. 23፥4</ref>፤ <ref loc="1CH 29:15">1 ዱዱ. 29፥15</ref>፤ <ref loc="PSA 39:12">መዝ. 39፥12</ref>።</char></note> <verse eid="HEB 11:13"/><verse number="14" style="v" sid="HEB 11:14"/>ህት ጠወኣ መኑ ሀንቅ እኮ ገይሰ እሀኖ ባዱ አገርታገ ግልጠ አት ለሊሳአ። <verse eid="HEB 11:14"/><verse number="15" style="v" sid="HEB 11:15"/>ህከ አጉርት ፉልቶ ባዱ ቃጎእቃኔተ ህከ ቤቹ ፈንቀልቶተ አታልታ እቅ። <verse eid="HEB 11:15"/><verse number="16" style="v" sid="HEB 11:16"/>ቴሱ እኮጎሬ በተአኖሲሃ ሰማን ዮ ባዱ ሱንታአ፤ ህካን እኮቤቺሃ መገኑ ከተመ ቅጥ አዕዮሰቤቺሃ «መገኑኔ» ይት ገእቶጎሬ ሙልሰኖስበአ።<verse eid="HEB 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17"/>እብራሂም ፌተነሞ ወክት አመዕነቲን ኢሳቀ ክትሚሃ ሆንጠህሾ፤ ተቢሴ ላገተ ኣኤ እብራሂምን ሜጥቹስ ቤቱ ክትሞተ ተቃጠቦ እቅ።<note caller="-" style="x"><char style="xo" closed="false">11፥17 </char><char style="xt" closed="false"><ref loc="GEN 22:1-14">ክል. 22፥1-14</ref>።</char></note> <verse eid="HEB 11:17"/><verse number="18" style="v" sid="HEB 11:18"/>ሁኩንን መገኑ «ዘርክ ኢሳቂን ገአንታአ» ይዮስ እቅ።<note caller="-" style="x"><char style="xo" closed="false">11፥8 </char><char style="xt" closed="false"><ref loc="GEN 21:12">ክል. 21፥12</ref>።</char></note><verse eid="HEB 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 11:19"/>እብራሂምን መገኑ ሬሆች ኬሶተ አታለኖገ ደጎቤቺሃ ሬሆች ኬዕዮሀንገ ዎለዕይ ቤቱስ ኢሳቀ ደኤእ። <verse eid="HEB 11:19"/><verse number="20" style="v" sid="HEB 11:20"/>ኢሳቅን ብርተ ዋሽ አሜተኖ ጠወ ሰውይ ያቁበለከ ኤሳ ማሰዕዮሳሁ አመዕነቲንት።<note caller="-" style="x"><char style="xo" closed="false">11፥20 </char><char style="xt" closed="false"><ref loc="GEN 27:27-29">ክል. 27፥27-29</ref>፤ 39-40።</char></note><verse eid="HEB 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21"/>ያቁብ ሬሀኖ ወክቱ ኢሌ ወክት ዩሱፍ እለተ መት-መቱሰ ማሰዕዮሁለከ ሽካንከስ ሽከዕይ መገኒሃ ሰገጆሁ አመዕነቲንት።<note caller="-" style="x"><char style="xo" closed="false">11፥21 </char><char style="xt" closed="false"><ref loc="GEN 47:31-48:20">ክል. 47፥31—48፥20</ref>።</char></note><verse eid="HEB 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22"/>ዩሱፍን ኤተሮን ሬሆተ ሆንጠኮ ወክት እስራኤል ኦሱት ግብጽ ባዲች ፉልታገ ጠወዕዮሁለከ ምቀስ አጉርት መርታበእገ አዘዦሳሁ አመዕነቲንት።<note caller="-" style="x"><char style="xo" closed="false">11፥22 </char><char style="xt" closed="false"><ref loc="GEN 50:24-25">ክል. 50፥24-25</ref>፤ <ref loc="EXO 13:19">ፉል. 13፥19</ref>።</char></note><verse eid="HEB 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23"/>ሙስ እለሞ ወክት አበ ተሽ የኖ ጩል እሁስ ሙስ አመስለከ አኑስ ለኦቤቺሃ ዎም ትዛዝ ዋጅቱዕናን አመዕነቲን ሰሱ አገነ ገበጭ አቶስ።<note caller="-" style="x"><char style="xo" closed="false">11፥23 </char><char style="xt" closed="false"><ref loc="EXO 2:2">ፉል. 2፥2</ref>፤ <ref loc="EXO 1:22">1፥22</ref>።</char></note><verse eid="HEB 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24"/>ሙስን ነጴ ወክት «ፍራኦኔ ቤቶ ቤቱ» ዬን ገኤኖስበእገ አመዕነቲን ግቦ።<note caller="-" style="x"><char style="xo" closed="false">11፥24 </char><char style="xt" closed="false"><ref loc="EXO 2:10-12">ፉል. 2፥10-12</ref>።</char></note> <verse eid="HEB 11:24"/><verse number="25" style="v" sid="HEB 11:25"/>መሰንትስ ጩቢን ቀዎ ወክቲሃ ደኤኖ ሙንዲኖች አበ መገን ኡመቲን ሜጡበ እክ ኦርሸተ ቶጉ መጠሮቤቺሃት። <verse eid="HEB 11:25"/><verse number="26" style="v" sid="HEB 11:26"/>ሙስ ብርተ ዋሽ አገረኖስ ሽልማት ደአኖገ መገኑ ቱክ ይ ለዕይ አመዕኔቤቺሃ ግብጽ ባድ ቀባጦች በትሽ መሲህተኔሃ ህንቀሙ አበ እሁስ ሰውዬእ።<verse eid="HEB 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27"/>እስን ዎም ኡሙዕርተ ዋጁዕነ ግብጽ ባዲች አመዕነቲን ፉሎ፤ እሌን ለኤንበ መገኑ ለዕዮሀንገ አዕይ አላማንተስ ጠረኝ ኡሬእ።<note caller="-" style="x"><char style="xo" closed="false">11፥27 </char><char style="xt" closed="false"><ref loc="EXO 2:15">ፉል. 2፥15</ref>።</char></note> <verse eid="HEB 11:27"/><verse number="28" style="v" sid="HEB 11:28"/>ሀንገፈ እለተ ቤሰኖ መላይኬቹ እስራኤል ሀንገፈ እለተ ኡለኖበእገ ሻሽግለከ ጡፋን ቄጉ ክፍ ሴረ አመዕነቲን አዕዮ።<note caller="-" style="x"><char style="xo" closed="false">11፥28 </char><char style="xt" closed="false"><ref loc="EXO 12:21-30">ፉል. 12፥21-30</ref>።</char></note><verse eid="HEB 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29"/>እስራኤል መኑ ሞልቶ ኡላን ቶልታሀንገ እክ አመዕነቲን ኤርትር ባረ ቶልቶኡ፤ እኮጎሬ ግብጽ ባድ መኑ «እሰገን ቶልናም» ይት ኬኦ ወክት ባር ዋን ኣአንቶኡ።<note caller="-" style="x"><char style="xo" closed="false">11፥29 </char><char style="xt" closed="false"><ref loc="EXO 14:21-31">ፉል. 14፥21-31</ref>።</char></note><verse eid="HEB 11:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30"/>ህትን ኢያሪኮ ከተም ግንቡ እስራኤል ኦሱት ለመለ በር አመዕነቲን ዘህቶች ኤተሮን ድጀም ኡቦ።<note caller="-" style="x"><char style="xo" closed="false">11፥30 </char><char style="xt" closed="false"><ref loc="JOS 6:12-21">ኢያ. 6፥12-21</ref>።</char></note> <verse eid="HEB 11:30"/><verse number="31" style="v" sid="HEB 11:31"/>ዝነተ አተ ረኣብ ኡለተ ዳንድታ መነ ወገሬቲን ቶጎቤቺሃ ህከ መገኒሃ አዘዘንቶበእ መኒን ሜጡበ በኡዕነ ሬሆች ጡምቶኢሁ አመዕነቲንት።<note caller="-" style="x"><char style="xo" closed="false">11፥31 </char><char style="xt" closed="false"><ref loc="JOS 2:1-21">ኢያ. 2፥1-21</ref>፤ <ref loc="JOS 6:22-25">6፥22-25</ref>።</char></note><verse eid="HEB 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32"/>ቴሱ ዎሉ መ ያም? መሰንትስ ጌድዎኔተኔሃ፥ ባረቄተኔሃ፥ ሶምሶኔተኔሃ፥ ዩፍታሄተኔሃ፥ ደዉዴተኔሃ፥ ሳሙኤሌተኔሃለከ ነቢያከተኔሃ ኩላምበኢሁ ወክቱ ሄዕበኤቤቺሃት።<note caller="-" style="x"><char style="xo" closed="false">11፥32 </char><char style="xt" closed="false"><ref loc="JDG 6:11-8:32">መሳ. 6፥11—8፥32</ref>፤ <ref loc="JDG 4:6-5:31">4፥6—5፥31</ref>፤ <ref loc="JDG 13:2-16:31">13፥2—16፥31</ref>፤ <ref loc="JDG 11:1-12:7">11፥1—12፥7</ref>፤ <ref loc="1SA 16:1">1 ሳሙ. 16፥1</ref>፤ <ref loc="1KI 2:11">1 ነገ. 2፥11</ref>፤ <ref loc="1SA 1:1-25:1">1 ሳሙ. 1፥1—25፥1</ref>።</char></note> <verse eid="HEB 11:32"/><verse number="33" style="v" sid="HEB 11:33"/>እሰን አመዕነቲን ዎመተ ቄልቶኡ፤ ጡመ ሆጉተ አቶኡ፤ መገኑ ኣሴሰ ተብሴ ላገተ ደእቶኡ፤ ዞቤ አፎንከ ጡፎኡ።<note caller="-" style="x"><char style="xo" closed="false">11፥33 </char><char style="xt" closed="false"><ref loc="DAN 6:1-27">ዳን. 6፥1-27</ref>።</char></note> <verse eid="HEB 11:33"/><verse number="34" style="v" sid="HEB 11:34"/>ህትን ጊረ ዎልቀተ ቤሶኡ፤ ገመጠሞ ሲፍችን ፉሸእቶኡ፤ ላፍማች ጠረኝማን ህጎኡ፤ በገዞንን ጠረኝቶኡ፤ አብል ዲን በገዙንከ ሸርቶኡ።<note caller="-" style="x"><char style="xo" closed="false">11፥34 </char><char style="xt" closed="false"><ref loc="DAN 3:1-30">ዳን. 3፥1-30</ref>።</char></note> <verse eid="HEB 11:34"/><verse number="35" style="v" sid="HEB 11:35"/>ሜንቱንኩ ሬቶ እሉሰ ሬሆች ኬኣን ደእቶኡ፤ ዎሉሰንገ ቆሀኖ ኬኡ ደእቶተ ሰውይት ሬቶተ ኢለ ኦለንቶኡ፤ ኡሱሮችን ሂረሙ ግቦኡ።<note caller="-" style="x"><char style="xo" closed="false">11፥35 </char><char style="xt" closed="false"><ref loc="1KI 17:17-24">1 ነገ. 17፥17-24</ref>፤ <ref loc="2KI 4:25-37">2 ነገ. 4፥25-37</ref>።</char></note> <verse eid="HEB 11:35"/><verse number="36" style="v" sid="HEB 11:36"/>ህትን ዎሉሰንገ ህንቄን ኦሌመሰ፤ ህከኒችን አበ ሰንሰለቲን ኡሱሬን ኡሱር ምኒ ኣግሴመሰ።<note caller="-" style="x"><char style="xo" closed="false">11፥36 </char><char style="xt" closed="false"><ref loc="1KI 22:26-27">1 ነገ. 22፥26-27</ref>፤ <ref loc="2CH 18:25-26">2 ዱዱ. 18፥25-26</ref>፤ <ref loc="JER 20:2">ኤር. 20፥2</ref>፤ <ref loc="JER 37:15">37፥15</ref>፤ <ref loc="JER 38:6">38፥6</ref>።</char></note> <verse eid="HEB 11:36"/><verse number="37" style="v" sid="HEB 11:37"/>ህትን ክኒን ቀሴናንሰ ሬቶኡ፤ መጋዚን ለሙ ቤቹ ፊሌመሰ፤ ሲፍን ሼመ፤ ጉዕመርቹንከ ሆግ ሸረንተንለከ ጨነቀንተን ሆለ ጎገለከ ፌዕላእ ጎገ ኦደእ ዞህቶኡ፤ ቡጥቻኑተለከ ሸሬመሰ መነ እክ ኦርጨቀንተን ሄኦኡ።<note caller="-" style="x"><char style="xo" closed="false">11፥37 </char><char style="xt" closed="false"><ref loc="2CH 24:21">2 ዱዱ. 24፥21</ref>።</char></note> <verse eid="HEB 11:37"/><verse number="38" style="v" sid="HEB 11:38"/>እሳንከ ኩ ኣዱንያ አሉ ገበእበሰቤቺሃ ኡለ ኡድማን፥ ቆታን፥ ሻንቃንለከ ክን ረባን ዘህተን ሄኦኡ።<verse eid="HEB 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39"/>ኩ ጉዕሙንኩ መኑ አመዕነትሰተኔሃ መሰከረሞሰጎሬ ኣሰሞሰ ተቢሳሃ ደእቶበአ። <verse eid="HEB 11:39"/><verse number="40" style="v" sid="HEB 11:40"/>መገኑ ኔሳሃ ጉዕመ ቆሀኖርቹ ቅጥአዕዮቤቺሃ ሁኩ መኑ ነኡ ሄዕንባሃ ዊመ እኮተ አታልቶበአ።<verse eid="HEB 11:40"/></para>
  <chapter eid="HEB 11"/>
  <chapter number="12" style="c" sid="HEB 12"/>
  <para style="s1">መገኑ አነኔ እሁስ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1"/>ህካን እኮቤቺሃ ጎመገ አደንከኔ ረብ ዮ ሁኩ ጉዕሙንኩ ምስክሩ ዮኔቤቺሃ እጅነገ ኬዕመኖርቹ ጉዕመንከለከ ኡሱር አፎኔ ጩብ አሊችኔ ከም ብሬንከኔ ዮ ሄጫቀንሸ ጠረኝን ደጉንዶ። <verse eid="HEB 12:1"/><verse number="2" style="v" sid="HEB 12:2"/>ደጉንዳሚንኩ አመዕነቲሃኔ ቡዕለለከ ዊንሸኖሃ እኮ ኢሰ ለዕኒት፤ እስን ብሬንከስ ዮ ሙንዲኖተኔሃ ይ መስቀል አሌን ሬሀኖ ሬሆ ሆፍኝ መቱርቹሃ ዎለኡዕነ አታዕል መገን ዳኝነት ቦርጭማን መኬ አዲን አፉዕልዮኡ።<verse eid="HEB 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3"/>ህትን አዕኑ ህፈቶኑዕናንለከ ተቢሳሃ ሙርቶኑዕናን ጩበኛኖ ኦደተ አታሎ ኢሰ ሰውይዬ። <verse eid="HEB 12:3"/><verse number="4" style="v" sid="HEB 12:4"/>አዕኑ ጩቢን አጰንቴነን ቄጉክዕኔ ዱንተኦተ ኢለ ግቤንታበአ። <verse eid="HEB 12:4"/><verse number="5" style="v" sid="HEB 12:5"/>መገኑ ክዕኔተ ገይስ እለገ</para>
  <para style="q1" vid="HEB 12:5">«ኢ ቤቶ! ቀርች ሸዘነተ ህንቆት፤</para>
  <para style="q2" vid="HEB 12:5">ቀጠአኖሄ ወክትንከ ተቢሳሃ ሙርቶት።<verse eid="HEB 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6"/>መሰንትስ ቀርቹ ኢተኖሲሃ ሻቀኖስ፤</para>
  <para style="q2" vid="HEB 12:6">ቤትስገ አዕይ ለአኖሃ ጉዕመንከ ቀጠአኖ» ዬ ሸዘነተ ሀቤንንዶ?<note caller="-" style="x"><char style="xo" closed="false">2፥5-6 </char><char style="xt" closed="false">ኢያ. 5፥17፤ <ref loc="PRO 3:11-12">ምሳ. 3፥11-12</ref>።</char></note><verse eid="HEB 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7"/>አኑ ሻቅ ሸዝበስ ቤቱ አዬት? መገኑ ክዕኔተ እለስገ አዕይ ለአኖህዕኔቤቺሃ ሻቅ ሸዦህዕኔጎሬ አታዕልዬ። <verse eid="HEB 12:7"/><verse number="8" style="v" sid="HEB 12:8"/>ህትን እለስ እኮእሩ ጉዕሙንኩ ቀጠአንተ ቅጣቲሃ አዕኑ ቀጠአንቶኑዕናን ፈቄንተጎሬ ህንጨረባሃ ቤሉ እለተስበአ። <verse eid="HEB 12:8"/><verse number="9" style="v" sid="HEB 12:9"/>ማሊን እልቶህዕኔ አናኑት ቀጠኦህዕኔ እቅ፤ እኮጎሬ ነኡ እሰተ ኬዕምንሳንሰ እቅ፤ ህካን እኮች ሄኢሃ ጉዕሚንከ አነ እኮ መገኒሃ ሄንከ በትንስ ጠገሙለከ ሄኡ ሀስሰኖኔ? <verse eid="HEB 12:9"/><verse number="10" style="v" sid="HEB 12:10"/>አናከክዕኔ ቀዎ ወክቲሃ ጡመ አጉጅ ለሌሰገ ቀጠኦኔ እቅ፤ እኮጎሬ እስ ጠሊለ እኮገን ጠሊላኑተ እንኮተ ኒ መኮተ ይ ቀጠአኖኔ። <verse eid="HEB 12:10"/><verse number="11" style="v" sid="HEB 12:11"/>ቅጣቱ ጉዕሙንኩ ወክቲሃስ ሻዝሰኖ ቤሉ ሙንዲሲስበሃን፤ ኤተሮንገ ሮሶ መኒሃ ወገሬትለከ ፈይመ ላልቹ ላልታገ አአኖ።<verse eid="HEB 12:11"/></para>
  <para style="b"/>
  <para style="s1">ሸዘነተኔሃ</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12"/>ህካን እኮቤቺሃ ናፎ አንገክዕኔለከ ሆጎ ጉበክዕኔ ጠረኝሼ።<note caller="-" style="x"><char style="xo" closed="false">12፥12 </char><char style="xt" closed="false"><ref loc="ISA 35:3">ኢሳ. 35፥3</ref>።</char></note> <verse eid="HEB 12:12"/><verse number="13" style="v" sid="HEB 12:13"/>አዕኑ ድኑ እኮ ሎከክዕኔ ፈይቶታት ቤሉ ባሰንከ ቡቱከንታበእገ ሎካተክዕኔ ጡመ ዎቃሃ መክሼ።<note caller="-" style="x"><char style="xo" closed="false">12፥13 </char><char style="xt" closed="false"><ref loc="PRO 4:26">ምሳ. 4፥26</ref>።</char></note><verse eid="HEB 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14"/>መኒን ጉዕሚንን ወገሬቲን ሄኢሃለከ ጠሊልማን ሄኢሃ ጠረኝዬ፤ መሰንትስ ጠሊልመት ዮበኢሃ አዪሁ ቀርቹ ለኦተ አታለኖበአ። <verse eid="HEB 12:14"/><verse number="15" style="v" sid="HEB 12:15"/>ክዕኔኤች አዬሃ መገን ኣስቱት ሆፈኣስበእገለከ ልግብ መነ ንጃሲሰኖ ቀራረኖ ጠጱ በላንከክዕኔ ሙች ኦርሰኖህዕኔበእገ አገዕርዬ።<note caller="-" style="x"><char style="xo" closed="false">12፥15 </char><char style="xt" closed="false"><ref loc="DEU 29:18">ዘዳ. 29፥18</ref>።</char></note> <verse eid="HEB 12:15"/><verse number="16" style="v" sid="HEB 12:16"/>ህትን ሀንገፎመስ መቶ ወክት እቻተ ይ ህሮ ኤስገ መገኑ ዋጅበለከ ዝነተ አአኖ መንቹ ደገመኖበእገ አገዕርዬ።<note caller="-" style="x"><char style="xo" closed="false">12፥16 </char><char style="xt" closed="false"><ref loc="GEN 25:29-34">ክል. 25፥29-34</ref>።</char></note> <verse eid="HEB 12:16"/><verse number="17" style="v" sid="HEB 12:17"/>ኤስ አንስ ማሰተ ደኦተ ኤተሮን መሃ ኦዕይ ደኦተ አታሉ ሆጎገ ደጌነንተ።<note caller="+" style="f"><char style="fqa" closed="false">ደኦተ አታሉ ሆጎገ ደጌነንተ፦ </char><char style="ft" closed="false">ቶበቶተ ወክት ደእዮበአ ዩሃን</char></note> ቶበቶተ ዕድል ደእዮበአ።<note caller="-" style="x"><char style="xo" closed="false">12፥17 </char><char style="xt" closed="false"><ref loc="GEN 27:30-40">ክል. 27፥30-40</ref>።</char></note><verse eid="HEB 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18"/>አዕኑ አንጋን አፊሃ አታሌኖ ሲና ቆተበ ኢልቴንታበአ፤ ህት ቆተት ቡባኢት እቅ፤ ህከንቤቾንን ጭልመ ቱንስቹለከ ኡንጉሉሎ ቦብሩሁ፥ <verse eid="HEB 12:18"/><verse number="19" style="v" sid="HEB 12:19"/>ጡሩምቡለ ሞጮጪሃ ዋጅሲሳ ላገቲ ሄኦ እቅ፤ ህተ ላገተ ሞጮጭቶ እስራኤል መኑ ዎልት ላገት በርገንት ኩለንታሰበእገ ኡጭቶኡ።<note caller="-" style="x"><char style="xo" closed="false">12፥18-19 </char><char style="xt" closed="false"><ref loc="EXO 19:16-22">ፉል. 19፥16-22</ref>፤ <ref loc="EXO 20:18-21">20፥18-21</ref>፤ <ref loc="DEU 4:11-12">ዘዳ. 4፥11-12</ref>፤ <ref loc="DEU 5:22-27">5፥22-27</ref>።</char></note><verse eid="HEB 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="HEB 12:20"/>መሰንትስ «ዎሉ ፈቅ ግዙ ህከ ቆተተ ኡሎጎር</para>
  <para style="q2" vid="HEB 12:20">ክኒን ቀሴናን ሬሁን»</para>
  <para style="m" vid="HEB 12:20">የኖ ትዛዝ እጅቶተ ኬዕሜሰቤቺሃ አታልቶበአ።<note caller="-" style="x"><char style="xo" closed="false">12፥20 </char><char style="xt" closed="false"><ref loc="EXO 19:12-13">ፉል. 19፥12-13</ref>።</char></note> <verse eid="HEB 12:20"/><verse number="21" style="v" sid="HEB 12:21"/>ለሌኢሁ አበ ዋጅሲሰኖሃ እኮቤቺሃ ሙስ</para>
  <para style="q1" vid="HEB 12:21">«አን አበ ዋጄም፤ ሁጮሚሁ» ዬእ።<note caller="-" style="x"><char style="xo" closed="false">12፥21 </char><char style="xt" closed="false"><ref loc="DEU 9:19">ዘዳ. 9፥19</ref>።</char></note><verse eid="HEB 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22"/>አዕኑ እኮጎሬ ጽኦን ቆተተ፥ ሄእ መገን ከተመ ሰማን ዮ ዬሩሳሌመለከ ሙንዲኖን ጭምይቶ ዎሊንሹ ዮበኢ መገን መላይከበ ሆንጠኬንታአ። <verse eid="HEB 12:22"/><verse number="23" style="v" sid="HEB 12:23"/>ሱዕሙሰ ሰማን ከተበንቶ መገን ሀንገፈ ኦሱተ እኮ አመዕናኖ ጭምትበለከ ዊመ ዊሚን ፈየ እኮ መን ነብሴበ ሆንጠኬንታአ፥ <verse eid="HEB 12:23"/><verse number="24" style="v" sid="HEB 12:24"/>ሃዕሮ ወኣድ በል መንቹ እኮ ኢሲበ፥ ኣቤሌ ቄጊች ቆህሽ ጠወአኖለከ ጩቢች ነጠ አኦኔተ ኪፈሞ ቄግቤቹ ሆንጠኬንታአ።<note caller="-" style="x"><char style="xo" closed="false">12፥24 </char><char style="xt" closed="false"><ref loc="GEN 4:10">ክል. 4፥10</ref>።</char></note><verse eid="HEB 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25"/>ከ ጠወ ኩለኖሃ ግቤነንተበእገ አገዕርዬ፤ መሰንትስ መገኑ ሙስ አዲን ኣዱንያ አሌን ኩለንሰ ሞጮጭናምበአ ይቶሩ ሁንት ፉሸእትባች ህከረ ሰማን እክ ጠወአኖሀኒች ገበጭ ይናም ነኡ ሀት እንክ ፉሸእኖተ አታልናም?<note caller="-" style="x"><char style="xo" closed="false">12፥25 </char><char style="xt" closed="false"><ref loc="EXO 20:22">ፉል. 20፥22</ref>።</char></note> <verse eid="HEB 12:25"/><verse number="26" style="v" sid="HEB 12:26"/>ህከ ወክት ላገስ ኡለተ ሌንቄቅሶኡ፤ እኮጎሬ ቴሱ እስ «ህትን መቶረ ጠለዕል ኡለተ እሁዕነ ሰማሃ ሌንቄቅሳም» ይ ላገተ ኣጎኡ።<note caller="-" style="x"><char style="xo" closed="false">12፥26 </char><char style="xt" closed="false"><ref loc="HAG 2:6">ሐጌ 2፥6</ref>።</char></note> <verse eid="HEB 12:26"/><verse number="27" style="v" sid="HEB 12:27"/>ጠው እኮጎሬ ኩ «መቱ ወክት በርግ» ይታ ላገት ሌንቄቅትበ ጠውንኩ ጠረኝ ሄአኖገለከ ሌንቄቀኖ ህከረንገ ከለቀሞ ጠዉ በአኖ።<verse eid="HEB 12:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28"/>ህካን እኮቤቺሃ ነኡ ሌንቄቀኖበእ ዎምነቱ ረገዕናምቤቺሃ መገኑ ገለትጭኖ፤ እስ ሙንደዕዮገን ዋጅነንለከ ከበጅነን መገኒሃ ሰገንዶ። <verse eid="HEB 12:28"/><verse number="29" style="v" sid="HEB 12:29"/>መሰንትስ ኒ መገኑ ቡስታ ጊረጋት።<note caller="-" style="x"><char style="xo" closed="false">12፥29 </char><char style="xt" closed="false"><ref loc="DEU 4:24">ዘዳ. 4፥24</ref>።</char></note><verse eid="HEB 12:29"/></para>
  <chapter eid="HEB 12"/>
  <chapter number="13" style="c" sid="HEB 13"/>
  <para style="s1">መገኑ ሙንዲሲሳ ክድመተ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1"/>አመኦሶ ኢተት ጉዕመ ወክትንከ በላንከክዕኔ ሄኡን። <verse eid="HEB 13:1"/><verse number="2" style="v" sid="HEB 13:2"/>ኮሀ ቶጌን ካደሙ ሀቦኖቼ፤ ካን አኦንከሰ መት-መቱ መኑ ደጉዕነ መገን መላይከተ ኮህነቱ ቶጎኡ።<note caller="-" style="x"><char style="xo" closed="false">13፥2 </char><char style="xt" closed="false"><ref loc="GEN 18:1-8">ክል. 18፥1-8</ref>፤ <ref loc="GEN 19:1-3">19፥1-3</ref>።</char></note> <verse eid="HEB 13:2"/><verse number="3" style="v" sid="HEB 13:3"/>ኡሱረንቶሀኑኡገን እሳንን ሜጡበ ኡሱረንቴንተሀንገን ዎለኤን ሰውይዬሰ፤ አዕኑሁ እሰገን ማሊንከሰ ኦርሸተ ቶጌነንተ ጌሰ እኬን ኦርሸተ ቶጋእረ ሰውይዬ።<verse eid="HEB 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4"/>ቤቱተ ኤቡ ጉዕመንከ መንቤቾን ኬዕምኙ ዮሲሃ እሁን፤ ምኒ አኑ ምንስ አማተ ህትን ምንስ አመንት ምንሴ አኒሃ አመዕነቀንቶረ እኩን፤ መሰንትስ ገይሰ ምኒ አኒች ህከረንገ ምንስ አመ ቤሉ ዎሎ መኒን ዝነተ አታሀኑኡ አሌን መገኑ ፈረደኖ።<verse eid="HEB 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5"/>ብረ ኢቲች ገዉክዕኔ አገዕርዬ፤ ዮህዕኔሁ እሁንክዕኔ፤ መሰንትስ መገኑ ገዉንኩስ «አን ሆሮ ኡጃንኬበአ፤ አጉራንኬበአ» ይዮኡ።<note caller="-" style="x"><char style="xo" closed="false">13፥5 </char><char style="xt" closed="false"><ref loc="DEU 31:6">ዘዳ. 31፥6</ref>፤ <ref loc="DEU 8">8</ref>፤ <ref loc="JOS 1:5">ኢያ. 1፥5</ref>።</char></note> <verse eid="HEB 13:5"/><verse number="6" style="v" sid="HEB 13:6"/>ህካን እኮቤቺሃ ነኡ መለልን</para>
  <para style="q1" vid="HEB 13:6">«ቀርቹ ሀዕለኖኤ፤</para>
  <para style="q1" vid="HEB 13:6">አን ዋጃምበአ፤ መኑ መ አአኖኤ?» ይናም።<note caller="-" style="x"><char style="xo" closed="false">13፥6 </char><char style="xt" closed="false"><ref loc="PSA 118:6">መዝ. 118፥6</ref>።</char></note><verse eid="HEB 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7"/>መገን ላገተ ኩልቶህዕኔ አዎንሳኑክዕኔ ሰውይዬሰ፤ እሰ ሀት እክ ሄኦገለከ ሬቶገ ለኤነን እሰ አመዕነትገ ዮ አመዕነቱ አዎኜ። <verse eid="HEB 13:7"/><verse number="8" style="v" sid="HEB 13:8"/>መሲህ ኢስ ቤሬተለከ ከበር ዘላለሚሃ ሄአኖሃን፤ ሆሮ ዶረመኖበአ። <verse eid="HEB 13:8"/><verse number="9" style="v" sid="HEB 13:9"/>አደደ እኮ ሂለ ትምርቲን አገንቶኖቼ፤ ቀልቡክዕኔ መገን ኣስቶን ጠረኙን ቤሉ ደግለለኖበእ እቸ ሴረ አገሪን እሁንከ፤ እቸ ሴረ አዎንቶ መኑ መቱርቹሃ ደእቶበአ።<verse eid="HEB 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10"/>ኔሳሃ መገኒሃ ክትም ሆንጠህሴኖ ጠረጴዙ ዮኔ፤ እኮጎሬ መገኑ ደገመኖ ዱካን ኣዜን ሆጉተ አታ ቂሳከት መገኒሃ ክትም ሆንጠህሴኖ ጠረጴዚች ኣእት እቱ ፈቀዴኖሰበአ እቅ። <verse eid="HEB 13:10"/><verse number="11" style="v" sid="HEB 13:11"/>መሰንትስ ሎሩ አይሁድ ቂሰ ሀለቁ ጩብተኔሃ ክትመሞ ግዝ ቄጉ ጠሊልች ጠሊለ ቤቹ ሆንጠህሰኖ፤ እኮጎሬ ግዝስ ማለ ቀኤች ገበለ ፉሼን ቡሴኖ እቅ።<note caller="-" style="x"><char style="xo" closed="false">13፥11 </char><char style="xt" closed="false"><ref loc="LEV 16:27">ሌዌ 16፥27</ref>።</char></note> <verse eid="HEB 13:11"/><verse number="12" style="v" sid="HEB 13:12"/>ህትን ኢስ ገይስ ቄጊን ኡመት ጠሊላኑተ አኦተ ከተሚች ኡሮ ገበላን ኦርሸተ ቶግ ሬዮ። <verse eid="HEB 13:12"/><verse number="13" style="v" sid="HEB 13:13"/>ህካን እኮቤቺሃ ነኡ ከተሚች ገበለ ፉልን እስን ሜጡበ ህንቀሞ። <verse eid="HEB 13:13"/><verse number="14" style="v" sid="HEB 13:14"/>መሰንትስ ኔሳሃ ከን ኣዱንያ አሌን ዘላለሚሃ ሄአኖ ከተሙ ዮኔበአ፤ ጠዉ እኮጎሬ ከ ኤተሩ አሜተኖ ከተመ አገዕርናም። <verse eid="HEB 13:14"/><verse number="15" style="v" sid="HEB 13:15"/>ህትን ነኡ ሆሮን ሙረሞበእ ገለት ክትመ ኢስ አዲን መገኒሃ ሆንጠህንሶ፤ ሁኩንን ሱዕሚሀስ መሰከርታ አፌሃ ላልቹ። <verse eid="HEB 13:15"/><verse number="16" style="v" sid="HEB 13:16"/>ጡመ ጠወ አኡለከ ዮህዕኔርቹ ዎሎ መኒን ቤቀሙ ሀቦኖቼ፤ መሰንትስ ህትኔ ክትሙ መገኑ ሙንዲሲሰኖሃን።<verse eid="HEB 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17"/>አዕኑ አዎንስታህዕኔሀኑኡተ አዘዘሜ፤ ሹምነትሃሰ ጠገሜ፤ መሰንትስ እሰ ፎልክዕኔተኔሃ መስለ ኣታእራ እኮቤቺሃ ጠረኝት ክዕኔተ አገርታህዕኔ፤ አዘዘንቴንተሰጎር ሆጉሰ ሙንዲኖን አታአ፤ አዘዘንቴንባች ሆጉሰ ሙንዲኖን አታበአ፤ ሁኩንን ክዕኔሃ ጡመሃበአ።<verse eid="HEB 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18"/>አዕኑ ኔሳሃ ዱአ አዕዬኔ፤ ነኡ ነጠ ቀልቢን ሄኡኔ አጥራመንት ደንጋም፤ ህትን ጉዕመ ጠዋንን ጡመገ ሄኢሃ ሄዕላንታም። <verse eid="HEB 13:18"/><verse number="19" style="v" sid="HEB 13:19"/>ክዕኔቤቹ ደዕል ፈንቀሎተ በትሴን ዱአ አቶኖተ ጠረኝሽ ኩላንክዕኔ።<verse eid="HEB 13:19"/></para>
  <para style="s1">መጨረሽ ዱአለከ ወገሬት</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20"/>ዘላለሚሃ እሀኖ ወኣድ ላገ ቄጊን ሆላተስ ሎረ ዜማንቹ እኮ ቀርቹ ኢሰ ሬሆች ኬሾ ወገሬት መገኑ <verse eid="HEB 13:20"/><verse number="21" style="v" sid="HEB 13:21"/>ሰውትስ ዊንሽቴነንተረ እኮኖተ ጡመ ጠዊሃ ጉዕሚንከ ቅጥአኡንክዕኔ፤ እሱ ሙንዲሲሰኖርቹ መሲህ ኢስ አዲን ክዕኔኤን አኡን፤ መሲህ ኢሲንከ ዘላለሚች ዘላለመ ኢለ ኬዕምኙ እሁን፤ ኣሚዕን።<verse eid="HEB 13:21"/></para>
  <para style="s1">መጨረሸ</para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22"/>አመኤ ኦሶ! ኩ ከተቦንክዕኔ ሶህኑት ገበንቹ እኮቤቺሃ ሸዘነእ ላገተ አታዕሊን ቶጎኖተ ኡጫንክዕኔ። <verse eid="HEB 13:22"/><verse number="23" style="v" sid="HEB 13:23"/>አመኔቤቱ ጥማቶስ ኡሱርች ገፈረሙስ ደጎኖተ ሀሳም፤ እስን ደዕል ኢቤቹ አሜቾጎር አኒሁ እሲንን ሜጡበ ክዕኔተ ለኦተ አሜታም።<verse eid="HEB 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24"/>አዎንስታህዕኔሀኑኡተለከ አመዕናኖተ ጉዕሚንከ ወገሬትኤ ኩሌሰ፤ ጣሊያን ባዲች አሜቶ አመዕናኑት ወገሬትሰ ሶኮህዕኔ።<verse eid="HEB 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25"/>መገን ኣስቱት ጉዕሚንከክዕኔ እኩን፤ ኣሚዕን!<verse eid="HEB 13:25"/></para>
  <chapter eid="HEB 13"/>
</usx>
