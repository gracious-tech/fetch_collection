<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- HALABA NEW TESTAMENT</book>
  <para style="h">ኤፌሶን</para>
  <para style="toc1">ጳዉሎስ ኤፌሶን መኒሃ ከተቦ ሶህኑተ</para>
  <para style="toc2">ኤፌሶን</para>
  <para style="toc3">ኤፌ.</para>
  <para style="mt1">ጳዉሎስ ኤፌሶን መኒሃ</para>
  <para style="mt2">ከተቦ ሶህኑተ</para>
  <para style="imt1">ኣጉስ</para>
  <para style="ip">ጳዉሎስ ኤፌሶን መኒሃ ከተቦ ሶህኑተ ጉዕሚችን ሄጭ ለለኖሁ «መገኑ ያጆሁ እሆተ ሰማንለከ ኡለን ዮ ከልቁ ጉዕሙንኩ ጭምይ ሜጥቾ መሲህ ኢስ ዳኝነት ኣዜን እሀኖ ወክቱ ኢሌእቺት» (1፥10) የኖ ሰውት አሌኒት። ዎሉንገ መሲህ ኢስን ሜጡበ እሁ መጠሮ መኑ ጉዕሙንኩ ሜጡበ እኮተ ይት ከ አበ ያደተ ሆጎ አሌን ሆስሶተ መገን ኡመት ቃግሰኖሃን።</para>
  <para style="ip">ኤፌሶን ዎዕኔ ሶህኑተ ከተቦሁ ሜጦመተኔሃ ዎኔስ ኣጉ አልባሽተኔሃት፤ አኑ መገኑ ኡመትስ ሀት መጠሮጎሬ፥ ቤትንከስ መሲህ ኢሲን ጩብሀሰ ፈቁን ዩ ደእት ሀት ነጠ እሁሰለከ መገን ሎረ ተብሴ ላገት ጠሊለ አያኒን ሀት አጥራመቱስ ኩለኖ፤ ለንክ ክፍላን ህትን ከተቦሲሁ አነበባእሩ ሜጡበ ሄእንከሰ መሲህ ኢሲን ዮሰ ሜጡ እሁ ሀንቅ እሆተ ሀት ሄኡ ሀስሰኖሰ ጎሬ ኩለኖ።</para>
  <para style="ip">መኑ መሲህ ኢሲን ዮሰ ሜጡ እሁ ሀት ሄአኖሰ ጎሬ ዎሎ አደደ ምሳልት ዮ ጠዊን ኩለኖ፤ መገን አመዕናኖ ዱእ ምኒ ጅስመ እከን መሲህ ኢስ ጅስሚሃ ቡዕለሃን፤ አመዕናኖ ዱእ ምኑ ግንበ እሀን መሲህ ኢስ ሙረበስየ ክኑ፤ አመዕናኖ ዱእ ምኑ ምኒ አመገ እሀን መሲህ ኢስ ምኒ አንጋት፤ ከተቦሲሁ መሲህ ኢስ አዲን ለሌ መገን ኣስቱተ አበ ገለትጨን ጠወአኖ ወክት ጠወአኖሁ አበ ጥዕላሻ እኮ ጠዊንት፤ ጉዕሙ ጠዉንኩ ለለኖሁ መሲህ ኢስ ኢታን፥ ገዉስ ህግሽ ኣሲን፥ ፈቁን ዪኒ፥ ኣስቶንለከ ወገሬት አዲኒት።</para>
  <para style="iot">መጻፉስ አፎሃ</para>
  <para style="io1">ኣጉስ <char style="ior">(<ref loc="EPH 1:1-2">1፥1-2</ref>)</char></para>
  <para style="io1">መሲህ ኢሰለከ አመዕናኑተ <char style="ior">(<ref loc="EPH 1:3-3:21">1፥3—3፥21</ref>)</char></para>
  <para style="io1">መሲህ ኢሲን ሃዕሮ ሄኡ <char style="ior">(<ref loc="EPH 4:1-6:20">4፥1—6፥20</ref>)</char></para>
  <para style="io1">መጨረሸስ <char style="ior">(<ref loc="EPH 6:21-24">6፥21-24</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="EPH 1"/>
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1"/>መገን ሰውቲን መሲህ ኢስ አሳቤቹ እኮ ጳዉሎሴችለከ መሲህ ኢሲን አመዕነንቶሀኑኡተ፥<note caller="-" style="x"><char style="xo" closed="false">1፥1 </char><char style="xt" closed="false"><ref loc="ACT 18:19-21">ሶቀ. 18፥19-21</ref>።</char></note></para>
  <para style="p" vid="EPH 1:1">ኤፌሶናን ሄኣ ጠሊላኖ አመዕናኖተ፥<verse eid="EPH 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2"/>አናኔ መገኒችለከ ቀርቾሃ መሲህ ኢሲች ኣስቱትለከ ወገሬቱሁ ክዕኔሃ እሁን።<verse eid="EPH 1:2"/></para>
  <para style="s1">መሲሂን ደገንታ በረከተ</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3"/>ሰሜ ቤቾን ጠሊለ አያኒን ደገንታ በረካን ጉዕሚንን መሲህ አዲን ማሰዕዮኔ ቀርችኔ መሲህ ኢሲን አኑኔ መገኑ ማሰአሙን። <verse eid="EPH 1:3"/><verse number="4" style="v" sid="EPH 1:4"/>ጠሊላኑተለከ ኩሌኖርቹ ዮበእረ እንክ ብሬስ ደገሞተ ኣዱንያት ከለቀንቱዕነ ሄጭ መሲሂን መጠሮኔ።<verse eid="EPH 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 1:5"/>መገኑ ሀሰኖ ሃሊን መሲህ ኢስ መሳን እለስ እንኮተ ሄጭ ኢታንከስ መጠሮኔ። <verse eid="EPH 1:5"/><verse number="6" style="v" sid="EPH 1:6"/>መገኑ ህካንን አዕዮሁ ኢተሞ ቤትስ መሳን ኔሳሃ ነጣን ኣሴኔ ኬዕምኝ ኣስቶተ እሱ ገለትጭኖታት። <verse eid="EPH 1:6"/><verse number="7" style="v" sid="EPH 1:7"/>መገን ኣስቶ ዊምማች ኬሽ ቤትስ ቄጊን ዎዝኑተ ደእን ጩብሃኔ ማርቱተ ደዕኖም።<note caller="-" style="x"><char style="xo" closed="false">1፥7 </char><char style="xt" closed="false"><ref loc="COL 1:14">ቆላ. 1፥14</ref>።</char></note> <verse eid="EPH 1:7"/><verse number="8" style="v" sid="EPH 1:8"/>ኣስቱስ በትሾኔ። ሀይማንለከ ኤንኬዕኒን <verse eid="EPH 1:8"/><verse number="9" style="v" sid="EPH 1:9"/>መገኑ ጎደበ ላፍማንከስ መሲህ መሳን ሄጭ ያጆገ ምስጥር ደንጋምገ አዕዮኔ። <verse eid="EPH 1:9"/><verse number="10" style="v" sid="EPH 1:10"/>ወክቱስ ኢለኖ ወክት መገኑ ሆጎን ሆስሰኖ ኩ ያደስ ሰማንለከ ኡላን ዮ ክልቀቱ ጉዕሙንኩ ሜጡበ መቶ መሲህ ሹምነት ኣዜን እካጋት።<verse eid="EPH 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11"/>ጉዕመ ጠወንከ ገይስ ሰውቲን አአኖ መገኑ ሄጭ ያጆ ሃሊን መሲህ መሳን እስ ወገነ እንኮተ መጠሮኔ። <verse eid="EPH 1:11"/><verse number="12" style="v" sid="EPH 1:12"/>ሁኩንን እኮሁ መሲህ ተብሳሃ አኢን ዎኔሃ እንኮምሩ መገን ኬዕምኝ ገለቲን ለሊንሶታት።<verse eid="EPH 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 1:13"/>አዕኑ ህትን ሀንቅ ላገተ ኩንን ጡምቴንተ እንጂለ ሞጮጭቴንተ ወክት መሲሂን በርገንቴንታአ፤ አመዕንቴን እስን እህን ተብሳሃ እክ ኣሰሞ ጠሊለ አያን ማተቢን ዎቀረንቴንታአ። <verse eid="EPH 1:13"/><verse number="14" style="v" sid="EPH 1:14"/>ሁኩ ጠሊሉ አያኑ መገኑ ገይስረ እኮረ ጉዕመንከ ዎዞተ ኢለ ርስቲሀኔ ሩብት እሀኖሃ ቀብደ፤ ሁኩንን ክዕምኚሀስ ገለትሃን።<verse eid="EPH 1:14"/></para>
  <para style="s1">ጳዉሎስ ኤፌሶን መኒሃ ዱአ አዕዮገ</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15"/>ህካን እኮቤቺሃ ቀርቾ ኢሳን ዮህዕኔ አመዕነትለከ አመዕናኖተ ጉዕሚንከ ዮህዕኔ ኢተተ ሞጮጬም ወክቲች ኬሽ <verse eid="EPH 1:15"/><verse number="16" style="v" sid="EPH 1:16"/>ክዕኔተ ዱኢን ቃገን ክዕኔ መሳን መገኒሃ ገለት ሆንጠህሱኤ አጉራምበአ። <verse eid="EPH 1:16"/><verse number="17" style="v" sid="EPH 1:17"/>ኬዕምኙ ሀስሰኖስ ቀርችሃኔ መሲህ ኢስ አነ መገኑ በትሴን ደጎኖተ ሀይመ አያነ ኣሶህዕኔተለከ ገውስ ለሊሶህዕኔተ ዱአ አኣም። <verse eid="EPH 1:17"/><verse number="18" style="v" sid="EPH 1:18"/>ሀትኔ ተብሴሃ ገአንቴንታጎሬ ጠሊላኑት ረገኣ ኬዕምኝ ርስቱ ሄንከ ልግብየ ጎሬ ደጎኖተ ቀልብክዕኔ እልት ፈንተኦተ ዱአ አኣም። <verse eid="EPH 1:18"/><verse number="19" style="v" sid="EPH 1:19"/>ዎለአንትበ ሎረ ዎልቀስ ኔሳሃ አመዕንናምሀኑኡተ ሄንከ ሎረሃ ጎሬ ደጎኖተ ዱአ አኣም፤ <verse eid="EPH 1:19"/><verse number="20" style="v" sid="EPH 1:20"/>ህከ ሎረ ዎልቀስ ሆጎን ለሊሾሁ ሬሆች ኬሽ ሰማን መኬንከስ አፉሼ መሲህ አዲንት።<note caller="-" style="x"><char style="xo" closed="false">1፥20 </char><char style="xt" closed="false"><ref loc="PSA 110:1">መዝ. 110፥1</ref>።</char></note> <verse eid="EPH 1:20"/><verse number="21" style="v" sid="EPH 1:21"/>አኑ መገኑ መሲህ ሰማን መኬንከስ አፉሼኢሁ ጉዕመ ዳኝነቲችለከ ዎልቃች ቀርቻኖች ሎረ ህትን ከን ኣዱንያ አሌን ጠለዕል እሁዕነ አሜተኖ ኣዱንያ አሌን ሱዕሚች ጉዕሚችን ሎረ እኮ ኬዕምኝ ሱዕመ ኣሲንት። <verse eid="EPH 1:21"/><verse number="22" style="v" sid="EPH 1:22"/>ጉዕመ ጠወንከ ዳኝነትስ ኣዜን አዕይ ጠገመኖገ አዕዮስ፤ መገን አመዕናኖ ዱእ ምኒ ጉዕመርቾንን ቡዕለ አዕዮስ።<note caller="-" style="x"><char style="xo" closed="false">1፥22 </char><char style="xt" closed="false"><ref loc="PSA 8:6">መዝ. 8፥6</ref>።</char></note> <verse eid="EPH 1:22"/><verse number="23" style="v" sid="EPH 1:23"/>መገን አመዕናኖ ዱእ ምኑ መሲህሃ ጅስመሃን፤ መገን አመዕናኖ ዱእ ምኑ ጉዕመ ጠዋን ዊመ አአኖሴ እሲን ዊመ እኮእተ።<note caller="-" style="x"><char style="xo" closed="false">1፥23 </char><char style="xt" closed="false"><ref loc="COL 1:18">ቆላ. 1፥18</ref>።</char></note><verse eid="EPH 1:23"/></para>
  <chapter eid="EPH 1"/>
  <chapter number="2" style="c" sid="EPH 2"/>
  <para style="s1">ሬሆች ሄእቤቹ ቶሉ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1"/>አዕኑ ቤሲክዕኔለከ ጩብክዕኔ መሳን ሬቴንታእረ እቅ፤ <verse eid="EPH 2:1"/><verse number="2" style="v" sid="EPH 2:2"/>ህከ ወክት ከን ኣዱንያ አል ሂለ ዎቃሃ አዎንቴነንተ እቅ፤ ህትን ቦብር አሌን ሄኣ ሂለ አያን ቀርቻኖተ ጠገንቴነንተ እቅ፤ እስን መገኒሃ አዘዘንታበእ መን አሌን አአኖሃ ሂለ አያነ። <verse eid="EPH 2:2"/><verse number="3" style="v" sid="EPH 2:3"/>ነኡ ጉዕሙንኩኔ ከኒች ብርተ እሰ በላን ማልኔ ያደተለከ ቀልብኔ ሰውት አዎነን ማልኔ ሄዕላቻን ሄዕናምረ እቅ፤ ዎሎ አዘዘንትበ መንገን ክልቀትንከኔ መገን ኡሙዕሬ ኣዜን ሄዕናምረ እቅ።<verse eid="EPH 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 2:4"/>ጠዉ እኮጎሬ መገን ማርቱት አበ እህንከስለከ ኔሳሃ ዮስ ኢተት ሎረ እህንከስ <verse eid="EPH 2:4"/><verse number="5" style="v" sid="EPH 2:5"/>ቤስንከኔ ሬኖምረ እንኮም እቃ መገኑ መሲሂን ፎሊን ሄዕኖተ አዕዮኔ፤ አዕኑሁ ጡሚቴንታሁ ኣስቶንከሲት።<note caller="-" style="x"><char style="xo" closed="false">2፥1-5 </char><char style="xt" closed="false"><ref loc="COL 2:14">ቆላ. 2፥14</ref>።</char></note> <verse eid="EPH 2:5"/><verse number="6" style="v" sid="EPH 2:6"/>መገኑ መሲህ ኢስ አዲን እሲንን ሬሆች ኬሽ ሰማን እሲን ሜጡበ አፉሼኔ። <verse eid="EPH 2:6"/><verse number="7" style="v" sid="EPH 2:7"/>ህካንን አዕዮሁ መሲህ ኢሲን ኔሳሃ ለልሾ ማርቱስለከ ዎሊንሹ ዮበእ ኣስቶ ቀባጡተ አሜተኖ ዘማን ለሊሶኔተ ይይት። <verse eid="EPH 2:7"/><verse number="8" style="v" sid="EPH 2:8"/>መሰንትስ አዕኑ ጡምቴንታሁ አመዕነት መሳን ኣስቶንከስት፤ ሁኩንን መገንተ ኣስቱ ቤሉ ክዕኔ ሆጎን ደገሞበእሃን። <verse eid="EPH 2:8"/><verse number="9" style="v" sid="EPH 2:9"/>አዪሁ ድከአኖበእገ ጡሙ ደገመኖሁ ሆጎኒበአ፤ <verse eid="EPH 2:9"/><verse number="10" style="v" sid="EPH 2:10"/>ነኡ መገኑ ሄጭ ቅጥአዕዮ ጡመ ሆጉተ አዕኖተ መሲህ ኢስ አዲን ለንኪሃ ከለቀሞምሃ መገኒሃ ክልቀት።<verse eid="EPH 2:10"/></para>
  <para style="s1">መሲህ ኢሲን ደገንታ ሜጦመተ</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11"/>ህካን እኮቤቺሃ አዕኑ ዎዕናሃ ክልቀቲንከክዕኔ አይሁደ እኬንበሩ፥ አይሁድ መኑ መን አንጋን ጡርከመንት ሄኦገን ክዕኔተ ጡርከመንቴንታበእሩ ይተን ቦሮርተንክዕኔ ሄኦገ ቃጌ። <verse eid="EPH 2:11"/><verse number="12" style="v" sid="EPH 2:12"/>አዕኑ እስራኤል መነ እኬንበሩ ተብሴ ላገ ወኣዲሃ ኮህቹ እኬንተሩ፥ ከን ኣዱንያ አሌኒ መቱ ተብሶሁ ዮህዕኔበእሩ፥ መገኒች አደ ሄኤነንተሩለከ መሲህች አደ እኬንተረ እሁክኔ ቃጌ። <verse eid="EPH 2:12"/><verse number="13" style="v" sid="EPH 2:13"/>ቴሱ እኮጎሬ አዕኑ ከኒች ብርተ ቄዕርቴን ሄኤንተሩ መሲህ ኢሲረ እኬን እስ ቄጊን ሆንጠኬንታአ። <verse eid="EPH 2:13"/><verse number="14" style="v" sid="EPH 2:14"/>መሰንትስ አደ አዕዮኔ ብተ ግድግደ ድጄኢሁ፥ አይሁደለከ አይሁደ እክበረ ሜጡ አዕዮ ወገሬቱኔ መሲህት። <verse eid="EPH 2:14"/><verse number="15" style="v" sid="EPH 2:15"/>ለሞንከ ኡመቲች እሲን ሜጡ እኮ መቱ ሃዕሮ ኡመት ከለቆተ አይሁድ ሕግ ትዛዝለከ ሴራ ማሊንከስ ሻር ወገሬት አዕዮ። <verse eid="EPH 2:15"/><verse number="16" style="v" sid="EPH 2:16"/>እስን መስቀል አሌን ሬሆንከስ ድኖመተ ቤሾ፤ ለሙንከስ ሜጡ ጅስመ አዕይ መገኒን ሀራርሴሰ።<note caller="-" style="x"><char style="xo" closed="false">2፥16 </char><char style="xt" closed="false"><ref loc="COL 1:20">ቆላ. 1፥20</ref>።</char></note> <verse eid="EPH 2:16"/><verse number="17" style="v" sid="EPH 2:17"/>አሜች ክዕኔሃ ቄዕርቴን ሄኤነንተሀኑኡተለከ ሆንጠክ ሄኦ አይሁዲሃ ወገሬት ተማርሴእ።<note caller="-" style="x"><char style="xo" closed="false">2፥17 </char><char style="xt" closed="false"><ref loc="ISA 57:19">ኢሳ. 57፥19</ref>።</char></note> <verse eid="EPH 2:17"/><verse number="18" style="v" sid="EPH 2:18"/>እስ አዲን ጉዕሙንኩኔ መቶሃ አያኒን አዎን መገን ቤቹ ሆንጠንካም።<verse eid="EPH 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19"/>ህካን እኮቤቺሃ አዕኑ መገኒሃ አደ እኮሀኑኡን መቶሃ ባድሃ መነለከ መገንየ አበሮስ ቤሉ ከኒች ኤተሮን ኮህቻኑተለከ ዎሎ ቤቺች አሜቴንታእራበአ። <verse eid="EPH 2:19"/><verse number="20" style="v" sid="EPH 2:20"/>አሳበለከ ነቢያኖ ቀበብ አሌን እጃረንቴንታእራን፤ ሙረበ ቡዕል ክኑ መሲህ ኢሳት። <verse eid="EPH 2:20"/><verse number="21" style="v" sid="EPH 2:21"/>ግንቡስ ጉዕሙንኩ እሲን መክ ቀርች ጠሊለ ምኒ እሆተ ነጰኖ። <verse eid="EPH 2:21"/><verse number="22" style="v" sid="EPH 2:22"/>መገኑ አያኒንከስ ገለኖ ግንበ እኮኖተ አዕኑሁ በርገንቴን መሲህን መክቴነንተ።<verse eid="EPH 2:22"/></para>
  <chapter eid="EPH 2"/>
  <chapter number="3" style="c" sid="EPH 3"/>
  <para style="s1">ጳዉሎስ አይሁደ እኮበእ መንቤቾን አዕዮ ሆጉተ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1"/>ህካን እኮቤቺሃ አን ጳዉሎስ ክዕኔሃ አይሁደ እኬንበሀኑኡተ ይ መሲህ ኢስ ካዲንቹ እህንከኤ ኡሱረኘሃን። <verse eid="EPH 3:1"/><verse number="2" style="v" sid="EPH 3:2"/>ክዕኔሃ ደግለለኖገ አኦተ መገኑ ኣስቶንከስ ካደሞስተ እድል ኣሴኤገ ሀንቂንከ ሞጮጭቴንታአ። <verse eid="EPH 3:2"/><verse number="3" style="v" sid="EPH 3:3"/>አን ሄጭ ገበንቹ አዕይ ከተቦክዕኔገን መገኑ ማጠሞርቹ ለልሾኤ። <verse eid="EPH 3:3"/><verse number="4" style="v" sid="EPH 3:4"/>ህካን እኮቤቺሃ ካን አነበቤነንተ ወክት መሲህ ማጠሞርቹ ሚ ጌሰ ኣጎኤ ጎር ደጎኖተ አታልቴነንተ። <verse eid="EPH 3:4"/><verse number="5" style="v" sid="EPH 3:5"/>ኩ ማጠሞርቹ መገን አያኒን ጠሊላኖ አሳባተስለከ ነብያኖተስ ቴሱ ለሌ ሃሊን ህጎ ዘማኔን ሄኦ መኒሃ ለልዮበአ። <verse eid="EPH 3:5"/><verse number="6" style="v" sid="EPH 3:6"/>ኩን ለሊሰኖሁ አይሁደ እህቡ መኑ አይሁዲን ሜጡበ ርስተ ረገኣእረለከ መቶ ጅስም ብሊተ እክ መገኑ ኣሴ ተብሳሃ እንጂል አዲን መሲህ ኢስ ቤቀማኑተ እሁሳት።<note caller="-" style="x"><char style="xo" closed="false">3፥4-6 </char><char style="xt" closed="false"><ref loc="COL 1:26-27">ቆላ. 1፥26-27</ref>።</char></note><verse eid="EPH 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7"/>መገኑ ዎልቃንከስ ኣሴኤ ኣስቶን አኒሁ ከን እንጂል ካዲንቹ እኮም። <verse eid="EPH 3:7"/><verse number="8" style="v" sid="EPH 3:8"/>አን ጠሊላኖች ጉዕሚችን ሆፈኣሚሃ እኮምጎሬሁ ዳንጉ ዮበእ መሲህ ቀባጦ እንጂለ አይሁደ እህበ መኒሃ ዱዱብሶተ መገን ኣስቶን ኩ ዕድሉ ኣሰሞኤ። <verse eid="EPH 3:8"/><verse number="9" style="v" sid="EPH 3:9"/>ህትን ህጎ ዘማኔን ጉዕመንከ ከለቆ መገኒን ማጠም ሄዕዮ ምስጥር መገን ያደት መሃጎር ጉዕሚንከ ለሊሶተ ኣስቱት ኣሰንቶኤ። <verse eid="EPH 3:9"/><verse number="10" style="v" sid="EPH 3:10"/>ሁኩንን እኮሁ ከን ዘማኔን አመዕናኖ ዱእ ምኒ አዲን ሰማን ሄኣ ሹመትለከ ሀለቀት መገን ኤንኬዕኑ አደደ ደኒን ደጋገት። <verse eid="EPH 3:10"/><verse number="11" style="v" sid="EPH 3:11"/>መገኑ ቀርቹሃኔ መሲህ ኢሲን ካን አዕዮሁ አበ ዘማኒች ብርተ ያጆ ሃሊኒት። <verse eid="EPH 3:11"/><verse number="12" style="v" sid="EPH 3:12"/>መሲህረ እህንከኔለከ እሲን አመዕኒንከኔ መገን ብሬን መለልን አመዕነትን ሆንጠሁ አታልናም። <verse eid="EPH 3:12"/><verse number="13" style="v" sid="EPH 3:13"/>አን ክዕኔተኔሃ ቶጋም ኦርሸት ኬዕምኝክዕኔ እኮቤቺሃ ኦርሸኤ መሳን ተብሳሃ ሙርቶኖቼ ይ ኡጫንክዕኔ።<verse eid="EPH 3:13"/></para>
  <para style="s1">መሲህ ኢተተ</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14"/>ቴሁ አነ መገን ብሬን ጉሉቤንከኤ ጉሉጵ ዱአ አኣሚሁ ከን መሳኒት። <verse eid="EPH 3:14"/><verse number="15" style="v" sid="EPH 3:15"/>ሰማንለከ ኡላን ዮ ጉዕሙንኩ አበሮሱ ሱዕመስ ደአኖሁ መገኒችት። <verse eid="EPH 3:15"/><verse number="16" style="v" sid="EPH 3:16"/>መገኑ ኣዝ ጅስመክዕኔ ጠረኝሰኖ ዎልቀተ አያንስ መሳን ኬዕምኝስ ሎርመተ ኣሶህዕኔተ ዱአ አኣም። <verse eid="EPH 3:16"/><verse number="17" style="v" sid="EPH 3:17"/>ህትን መሲህ አመዕነቲን ቀልቤንከክዕኔ ሄኦተለከ አዕኑሁ ጠጰ አቴን ኢታን ጠረኝቴንተረ እኮኖተ ዱአ አኣም። <verse eid="EPH 3:17"/><verse number="18" style="v" sid="EPH 3:18"/>ቴሁ መሲህ ኢተት አልባዕልመስለከ ቄዕራሽመስ፥ ጎቴመስለከ ጥዕላሽመስ ሄንከ ጎሬ ጠሊላኖን ሜጡበ ሰውዩ አታልቶኖተለከ <verse eid="EPH 3:18"/><verse number="19" style="v" sid="EPH 3:19"/>መን ኤንኬዕኒች በተኣ መሲህ ኢተተ ደጎኖተ መገን ዊምማን ዊመ እኮኖተ ዱአ አኣም።<verse eid="EPH 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20"/>ህካን እኮቤቺሃ ኒ ኣዜን አታ ዎልቀስ መሳን ኡጭናምለከ ሰውይናምሀኒች በትሽ ደፈፍሽ ኣሶተ አታለመኖስ መገኒሃ <verse eid="EPH 3:20"/><verse number="21" style="v" sid="EPH 3:21"/>እሲሃ አመዕናኖ ዱእ ምኒ መሲህ ኢስ አዲን ዘማኔን ጉዕማን ዘላለሚች ዘላለሚሃ ኬዕምኙ እሲሃ እሁን፤ ኣሚዕን።<verse eid="EPH 3:21"/></para>
  <chapter eid="EPH 3"/>
  <chapter number="4" style="c" sid="EPH 4"/>
  <para style="s1">መሲሂን ዮ ሜጦመተ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1"/>ቀርቹ ካደሞንከኤ ኡሱረኛ እኮም አን ገአንቴንተ ገአሚሃክዕኔ ሀስሰኖ ሄኡ ሄኦኖተ ኡጫንክዕኔ። <verse eid="EPH 4:1"/><verse number="2" style="v" sid="EPH 4:2"/>ኢታንለከ ገገዊንከክዕኔ አታዕሊን ጉዕመ ወክት ገዉ ሆፍሲንለከ ጎደብ ላፍማን መት-መቱ አታዕለቀሚን ሄዕዬ።<note caller="-" style="x"><char style="xo" closed="false">4፥2 </char><char style="xt" closed="false"><ref loc="COL 3:12-13">ቆላ. 3፥12-13</ref>።</char></note> <verse eid="EPH 4:2"/><verse number="3" style="v" sid="EPH 4:3"/>ወገሬቲን ሜጡ እኬን መገን አያኒን ደገመኖ ሜጦመተ ጠረኝሴን አገሬ። <verse eid="EPH 4:3"/><verse number="4" style="v" sid="EPH 4:4"/>አዕኑ መቶ ተብሴሃ ገአንቴንተሀንገን መቱ ጅስሙለከ መቱ አያኑ ዮኡ። <verse eid="EPH 4:4"/><verse number="5" style="v" sid="EPH 4:5"/>ህትን መቱ ቀርቹ፥ መቱ አመዕነቱለከ መቱ ጠመቀሙ ዮኡ። <verse eid="EPH 4:5"/><verse number="6" style="v" sid="EPH 4:6"/>ጉዕሚችን ሎረ እኮሁ፥ ጉዕማንን አአኖሁ፥ ጉዕማንን ሄአኖሁ፥ ጉዕሚንከ አነ እኮሁ መቱ መገኑ ዮኡ።<verse eid="EPH 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7"/>ጠዉ እኮጎሬ መሲህ ኣሶተ ሀሾ ጌሲን መት-መትሃኔ መገን ኣስቱት ኣሰንቶኔ። <verse eid="EPH 4:7"/><verse number="8" style="v" sid="EPH 4:8"/>ሁኩንን</para>
  <para style="q1" vid="EPH 4:8">«አሌ ፉሎ ወክት ልግብ አገንቶእረ አእ ኦሮዕዮ፤</para>
  <para style="q2" vid="EPH 4:8">መኒሃ ሽልማት ኣሴእ» የመሞጋት።<note caller="-" style="x"><char style="xo" closed="false">4፥8 </char><char style="xt" closed="false"><ref loc="PSA 68:18">መዝ. 68፥18</ref>።</char></note><verse eid="EPH 4:8"/></para>
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9"/>ህከረ ሁኩ «አሌ ፉሎ» ይታ ላገት ሄጭ ኡላችን አበ ጥዕላሸ ቤቹ ድሩ እህባች ዎሉ መ እሆተ አታለኖ? <verse eid="EPH 4:9"/><verse number="10" style="v" sid="EPH 4:10"/>ኩን ጥዕላሸ ቤቹ ድሬኢሁ ህትን ጉዕመንከ ዊመ አኦተ ሰሜች ጉዕሚችን አሌ ዋል ፉሎሁ እሶት። <verse eid="EPH 4:10"/><verse number="11" style="v" sid="EPH 4:11"/>እስን መት-መቱሰ አሳበተ፥ መት-መቱሰንገ ነብያኑተ፥ መት-መቱሰ እንጂለ ዱዱብስታእረ፥ መት-መቱሰንገ አመዕናኖ ዜማኑተ፥ መት-መቱሰንገ አስተማረተ እካገ ሽልማት ኣሴሰ። <verse eid="EPH 4:11"/><verse number="12" style="v" sid="EPH 4:12"/>ካን አዕዮንኩ መሲህ ጅስመ እኮእ አመዕናኖ ዱእ ምኒ ነሲሃ አመዕናኑተ አመዕነት ክድማተ ቅጥ አእሃት። <verse eid="EPH 4:12"/><verse number="13" style="v" sid="EPH 4:13"/>ህትን መገን ቤቱ ደጊን አመዕነቲን ደገመኖ ሜጦመተ ኢልን መሲህ ዊመ እኮገን ነኡሁ ዊመ መነ እንክ ነጵኖታት። <verse eid="EPH 4:13"/><verse number="14" style="v" sid="EPH 4:14"/>ከኒች ኤተሮን መን ተንኮ ክዝቢንለከ ጣንሲን ቅጠሞ ክዝብ ትምርቲን ቦብሩለከ ዊ ሁሉ ከበሃ ካጰ ሀንበለንት መርታ ጩለገ እንካምበአ። <verse eid="EPH 4:14"/><verse number="15" style="v" sid="EPH 4:15"/>በትሽን ሀንቅ ኢታን ጠወዕነን ጉዕመ ጅስሚሃ ቡዕለ እኮ መሲህበ ጉዕመርቺን ነጵናም። <verse eid="EPH 4:15"/><verse number="16" style="v" sid="EPH 4:16"/>አደዱ መኖመ ጅስሙ መቱ እሀኖሁ መሲሂንት፤ ጅስሙ ጉዕሙንኩ ሜጡ እኮሁ መኖመት ደቀንታ ቤቾኒት፤ ህካን እኮቤቺሃ መት-መቱ ጅስም ብሊቱ ኣሰሞስ ሆጉተ ብዝ አዕይ አአኖ ወክት ጅስሙ ጉዕሙንኩ ነጰኖ፤ ገውስ ኢታን ነሰኖ።<note caller="-" style="x"><char style="xo" closed="false">4፥16 </char><char style="xt" closed="false"><ref loc="COL 2:19">ቆላ. 2፥19</ref>።</char></note><verse eid="EPH 4:16"/></para>
  <para style="s1">መሲሂን ደገመኖ ሃዕሮ ሄኡ</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17"/>ከኒች ኤተሮን ሰውቱሰ ተሰ እኮ አይሁደ እክበ መንገ ሄኦኖቼ ይ ቀርች ሱዕሚን ጠረኝሽ ኩላንክዕኔ፤ <verse eid="EPH 4:17"/><verse number="18" style="v" sid="EPH 4:18"/>እሰ ቀልቡ ቱንስዮኡ፤ ህትን ቀልብ ዱድማች ኬዕዮሀኒንለከ ኤንኬዕኑ ሆግሰ መሳን መገኑ ኣሰኖ ሄኢች አደ እኮኡ። <verse eid="EPH 4:18"/><verse number="19" style="v" sid="EPH 4:19"/>ሙልት ሰውቱሰ በዕዮቤቺሃ ንጃስ እኮ ጠወ ጉዕመንከ አኢሃ ገዉሰ ሙልሰኖ ማልሰ ሄዕላቻተ ህግስ ኣቶኡ።<verse eid="EPH 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20"/>አዕኑ እኮጎሬ መሲህ ደጌንታሁ ህትናሞ ዎቄንበአ። <verse eid="EPH 4:20"/><verse number="21" style="v" sid="EPH 4:21"/>ሀንቅንከ እስተኔሃ ሞጮጭቴንታአ፤ ህትን እሲሃ እኬንተቤቺሃ ሀንቁንኩ ኢሳን ሄኡስ ተማርቴንታአ። <verse eid="EPH 4:21"/><verse number="22" style="v" sid="EPH 4:22"/>ህካን እኮቤቺሃ ጣንስ ጩብቤቹ አዎንሰኖ ሄዕላቻን በዕዮ ዎዕናሃ ሄኤነንተ ኑባጴ ሃለት ከሜ።<note caller="-" style="x"><char style="xo" closed="false">4፥22 </char><char style="xt" closed="false"><ref loc="COL 3:9">ቆላ. 3፥9</ref>።</char></note> <verse eid="EPH 4:22"/><verse number="23" style="v" sid="EPH 4:23"/>ቀልብክዕኔ ሰውቱ ሃዕሮ እሁን። <verse eid="EPH 4:23"/><verse number="24" style="v" sid="EPH 4:24"/>ሀንቅ ፈይማንለከ ጠሊልማን መገን ምሳሌን ከለቀሞ ሃዕሮ ክልቀት ኦደዕዬ።<note caller="-" style="x"><char style="xo" closed="false">4፥24 </char><char style="xt" closed="false"><ref loc="GEN 1:26">ክል. 1፥26</ref>፤ <ref loc="COL 3:10">ቆላ. 3፥10</ref>።</char></note><verse eid="EPH 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25"/>ህካን እኮቤቺሃ ክዝብ ጠወኦኖቼ፤ ጉዕሙንኩኔ መቱ ጅስመ እንኮምቤቺሃ ገገዉንኩኔ ሀንቅ ጠወዕኖ።<note caller="-" style="x"><char style="xo" closed="false">4፥25 </char><char style="xt" closed="false"><ref loc="ZEC 8:16">ዘካ. 8፥16</ref>።</char></note> <verse eid="EPH 4:25"/><verse number="26" style="v" sid="EPH 4:26"/>ኡሙዕርዬ! ኡሙዕርቴንተጎሬሁ ጩብ አቶኖቼ፤ ህትን ኡሙዕርቴንተገን አሩ ኣጉንከ።<note caller="-" style="x"><char style="xo" closed="false">4፥26 </char><char style="xt" closed="false"><ref loc="PSA 4:4">መዝ. 4፥4</ref>።</char></note> <verse eid="EPH 4:26"/><verse number="27" style="v" sid="EPH 4:27"/>ህትን እልብሲሃ ሆሮን ቤቹ ኣቶኖቼ። <verse eid="EPH 4:27"/><verse number="28" style="v" sid="EPH 4:28"/>ህትን ሞገኖሁ ከ ኤተሩ ሞጉንከ፤ ጠዉ እኮጎሬ ህከን ወጥ ኦርጨቀሞሀኒሃ ኣሶተ ገይስ አንጋን ጡመርቹ አኡን። <verse eid="EPH 4:28"/><verse number="29" style="v" sid="EPH 4:29"/>ሆሮ አፌችክዕኔ ሂለ ላገት ፉልቱንከ፤ ጠው እኮጎሬ ሞጮጨኖሀኒሃ ተሽየኖለከ ጠረኝሲሃ ደግለለኖ ጠወ ጠወዕዬ። <verse eid="EPH 4:29"/><verse number="30" style="v" sid="EPH 4:30"/>ህትን ዎዘንቴነንተ በሬተ ዊመ እሆህዕኔተ አሌክዕኔ መተብገ ዎቀረሞ ጠሊለ መገን አያነ ሻዝሶኖቼ። <verse eid="EPH 4:30"/><verse number="31" style="v" sid="EPH 4:31"/>ህትን ቀራርስጩ፥ ንዴት፥ ኡሙዕርት፥ ጨንጨነተ፥ ያርት፥ ቦሮዕረንሹለከ ሂሉ ጠዉ ጉዕሙንኩ ክዕኔች ካጰ ሽቁን። <verse eid="EPH 4:31"/><verse number="32" style="v" sid="EPH 4:32"/>ህትን መት-መቲሃክዕኔ ጡማኑተለከ አሙዜነንተረ፥ ጎደበ ላፋኑተለከ መረርሲጫኑተ እኬ፤ መገኑ መሲሂን አጉሮህዕኔገን ገገዊንከክዕኔ አጉዕራቀሜ።<note caller="-" style="x"><char style="xo" closed="false">4፥32 </char><char style="xt" closed="false"><ref loc="COL 3:13">ቆላ. 3፥13</ref>።</char></note><verse eid="EPH 4:32"/></para>
  <chapter eid="EPH 4"/>
  <chapter number="5" style="c" sid="EPH 5"/>
  <para style="s1">ኑር ኣዜን ሄእተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1"/>ኢቴኖ ኦሶገ አዕኑሁ መገኑ አዎንቴነንተረ እኬ። <verse eid="EPH 5:1"/><verse number="2" style="v" sid="EPH 5:2"/>መሲህ ኢቴኔገን መገኑ ተሽ አአኖ ጡሙ ሽቱት ዮስ ክትም አዕይ ገውስ ኒተኔሃ ህግሽ ኣሴገን አዕኑሁ እስ ኢታን ሄዕዬ።<verse eid="EPH 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3"/>ህትኔ ጠዉ መገን ኡመቲሃ ሀሲሰኖበእቤቺሃ ዝነት ህከረንገ ዎሉ ንጃስ እኮ ጠወ አኡ ህከረንገ ጎራሜቹ እሁ ፈቅ ሞጮጩሁ ሀስሰኖበአ። <verse eid="EPH 5:3"/><verse number="4" style="v" sid="EPH 5:4"/>ህከን ወጥ መገኒሃ ሹኩሪ ሆንጠህሼ ቤሉ ሂለለከ ገወ ጠወ ህከረንገ ሂለ ቀልድ ጠወ ጠወኡ ሀስሰኖህዕኔበአ፤ ህትኔ ጠዉ ክዕኔሃ መከኖበአ። <verse eid="EPH 5:4"/><verse number="5" style="v" sid="EPH 5:5"/>ዝነተ ህከረንገ ጉዕመ ንጃስ አኡ ህከረንገ ሽርኬሃ ሰገድገ ዮ ጎራምመተ መሲሂንለከ መገን ዎምነቴን ቤቹ ደአኖበእገ ደጌ።<verse eid="EPH 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6"/>ከን ጠው መሳን አዘዘንታበእ መን አሌን መገን ኡሙዕርት አሜታቤቺሃ አዪሁ ተሰ ጠዊን ጣንሱንከህዕኔ። <verse eid="EPH 5:6"/><verse number="7" style="v" sid="EPH 5:7"/>ህካን እኮቤቺሃ ከን አዘዘንታበእ መኒን ሜጡ እኮኖቼ፤ <verse eid="EPH 5:7"/><verse number="8" style="v" sid="EPH 5:8"/>ዎዕናሃ አዕኑ ቱንስቹሃን እቅ፤ እኮጎሬ ቴሱ ቀርችረ እኬንተቤቺሃ ኑርሃን፤ ህካን እኮቤቺሃ ኑር ኣዜን ሄአኖ መኒገ ሄዕዬ። <verse eid="EPH 5:8"/><verse number="9" style="v" sid="EPH 5:9"/>መሰንትስ ጡሙ ጠዉ ጉዕሙንኩ ፈይመለከ ሀንቅ ላልቹ ደገመኖሁ ኑርቺት። <verse eid="EPH 5:9"/><verse number="10" style="v" sid="EPH 5:10"/>ህካን እኮቤቺሃ ቀርቺሃ ተሽ አአኖስ ጠዉ መሃጎሬ መረመርቴን ደጌ። <verse eid="EPH 5:10"/><verse number="11" style="v" sid="EPH 5:11"/>አዕኑ ህከ ላልቹ ዮበእ ቱንስች ሆጉተ ፉሽቴን ለሊሼ ቤሉ ህከን ሆጎን ሀዕላቀንቶኖቼ። <verse eid="EPH 5:11"/><verse number="12" style="v" sid="EPH 5:12"/>ቱንስቾን ሄኣ መኑ ማጥ አታ ጠወ ጠወኡ ሙልሲሰኖ። <verse eid="EPH 5:12"/><verse number="13" style="v" sid="EPH 5:13"/>ጉዕሙርቹንኩ ኑርቤቹ ፉለኖረ በራ እክ ለለኖ። <verse eid="EPH 5:13"/><verse number="14" style="v" sid="EPH 5:14"/>በራ እክ ለለኖ ጠዉ ጉዕሙንኩ ኑርሃን፤ ህካን እኮቤቺሃ</para>
  <para style="q1" vid="EPH 5:14">«አት ኩ ግሳንቲሁ በቅይ! ሬሆች አደ እክ ኬእ!</para>
  <para style="q2" vid="EPH 5:14">መሲህ ኑር ለሊሰኖሄ» የመሞኡ።<verse eid="EPH 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15"/>ቴሱ ሀት እኬን ሄኤነንተጎሬ አጥራመቴን ሰውይዬ፤ ሀይቾ መንጋት ቤሉ ገዋኖገ ሄኦኖቼ። <verse eid="EPH 5:15"/><verse number="16" style="v" sid="EPH 5:16"/>ኩ ዘማኑ ሂለ እኮቤቺሃ ወክትክዕኔ ከልባን ቤሶኖቼ።<note caller="-" style="x"><char style="xo" closed="false">5፥16 </char><char style="xt" closed="false"><ref loc="COL 4:5">ቆላ. 4፥5</ref>።</char></note> <verse eid="EPH 5:16"/><verse number="17" style="v" sid="EPH 5:17"/>ህካን እኮቤቺሃ ቀርች ያደት መሃጎር ሰውይዬ ቤሉ ገዋኑተ እኮኖቼ።<verse eid="EPH 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 5:18"/>ህትን ጠሊለ አያኒን ዊሜ ቤሉ ሂለ ዎቃሃ መሰኖህዕኔቤቺሃ ወይን ጠጂን ሰከርቶኖቼ። <verse eid="EPH 5:18"/><verse number="19" style="v" sid="EPH 5:19"/>ህትን መዝሙራን ገለቲን አመዕናኑት ዘመርታ ሃሊን ገገዊንከክዕኔ ጠወዕዬ፤ ገለቲንለከ መዝሙርን ዊመ ቀልቢንከክዕኔ ቀርቹ ገለትጭዬ፤ <verse eid="EPH 5:19"/><verse number="20" style="v" sid="EPH 5:20"/>ቀርቹሃኔ መሲህ ኢስ ሱዕሚን ጉዕመ ጠዊንከ አነ መገኑ ጉዕመ ወክት ገለትጭዬ።<note caller="-" style="x"><char style="xo" closed="false">5፥19-20 </char><char style="xt" closed="false"><ref loc="COL 3:16-17">ቆላ. 3፥16-17</ref>።</char></note><verse eid="EPH 5:20"/></para>
  <para style="s1">ምኒ አንለከ ምኒ አመተኔሃ</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21"/>መሲህ ከበጂሃ ዮህዕኔ ዋጃቶች ኬዕዮሀኒን ገገዉንኩክዕኔ መት-መትክዕኔ ትዛዝ ቶጌ።<verse eid="EPH 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22"/>ምኒ አማኖ! ቀርቾሃ ኢሲሃ አዘዘንቴነንተሀንገን ምኒክዕኔ አናኖተ አዘዘሜ፤<note caller="-" style="x"><char style="xo" closed="false">5፥22 </char><char style="xt" closed="false"><ref loc="COL 3:18">ቆላ. 3፥18</ref>፤ <ref loc="1PE 3:1">1 ጴጥ. 3፥1</ref>።</char></note> <verse eid="EPH 5:22"/><verse number="23" style="v" sid="EPH 5:23"/>መሲህ አመዕናኖ ዱእ ምኒሃ ቡዕለ እኮገን ምኒ አኑሁ ምንስ አማተ ቡዕለሃን፤ ህትን መሲህ ጅስመ እኮ መገን አመዕናኖ ዱእ ምኒሃ ጡምሳንቹሃን። <verse eid="EPH 5:23"/><verse number="24" style="v" sid="EPH 5:24"/>አመዕናኖ ዱእ ምኑንኩ መሲህሃ አዘዘንታገን ህትን ምኒ አማኑት ምኒ አናኖተሰ ጉዕመ ጠዋንን አዘዘንቱን።<verse eid="EPH 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25"/>ምኒ አናኖ! መሲህ አመዕናኖ ዱእ ምኒ ኢቴገለከ ገዉስ ህግሽ ኣሴገን አዕኑሁ ምኒክዕኔ አማኑተ ኢትዬ፤<note caller="-" style="x"><char style="xo" closed="false">5፥25 </char><char style="xt" closed="false"><ref loc="COL 3:19">ቆላ. 3፥19</ref>፤ <ref loc="1PE 3:7">1 ጴጥ. 3፥7</ref>።</char></note> <verse eid="EPH 5:25"/><verse number="26" style="v" sid="EPH 5:26"/>መሲህ ህካን አዕዮሁ አመዕናኖ ዱእ ምኒ ጠሊለተ አኦተ ሀሽት፤ ነጠ አዕዮሴንኩ ላገስ መሳን ዊን ኣንሽንት። <verse eid="EPH 5:26"/><verse number="27" style="v" sid="EPH 5:27"/>ከን ሃሌን ጡሩ ህከረንገ ሚንተ ኡሱሩ ህከረንገ ካን አጉደኖ ደገሙዕነ ጠሊለተ፥ ኩሌኖርቹ ዮበኢተለከ ምልካምተ አዕይ ገይስቤቹ ሆንጠህሰኖ። <verse eid="EPH 5:27"/><verse number="28" style="v" sid="EPH 5:28"/>ህትን ምኒ አናከት ገይሰ ጅስመ ኢትታሀንገ ምንሰ አማኑተ ኢቱ ሀስሰኖሰ፤ ምንስ አመተ ኢተኖሁ ገዉስ ኢተኖ። <verse eid="EPH 5:28"/><verse number="29" style="v" sid="EPH 5:29"/>ገይስ ጅስመ ግበኖሁ አዪሁ ዮበአ፤ ህከን ወጥ መሲህ መገን አመዕናኖ ዱእ ምኒ አአኖ ሃሊን ገዉስ እትሰኖ፤ አገረኖሁ። <verse eid="EPH 5:29"/><verse number="30" style="v" sid="EPH 5:30"/>ነኡ መሲህ ጅስምሃ ብልት፤ <verse eid="EPH 5:30"/><verse number="31" style="v" sid="EPH 5:31"/>«ከን መሳን መኑ አነስለከ አመስ አጉር ምንስ አማን ሜጡ እሀኖ፤ ለሙንኩሰ መቱ ጅስመ እካአ» የመሞኡ።<note caller="-" style="x"><char style="xo" closed="false">5፥31 </char><char style="xt" closed="false"><ref loc="GEN 2:24">ክል. 2፥24</ref>።</char></note> <verse eid="EPH 5:31"/><verse number="32" style="v" sid="EPH 5:32"/>ኩ ምስጥሩ ሎረሃን፤ ካን ያሚሁ መሲህተኔሃለከ መገኑ አመዕንቶ ዱእ ምኒ ምሳልተ አዕዪት። <verse eid="EPH 5:32"/><verse number="33" style="v" sid="EPH 5:33"/>ጠዉ እኮጎሬ ኩ ጠዉ ክዕኔንተ ለአኖ፤ ህካን እኮቤቺሃ ምኒ አኑ ምንስ አማተ ገይስገ አዕይ ኢቱን፤ ምኒ አመት ምንሴ አነ ኬዕምሱን።<verse eid="EPH 5:33"/></para>
  <chapter eid="EPH 5"/>
  <chapter number="6" style="c" sid="EPH 6"/>
  <para style="s1">አናከተ፥ አማኖተለከ ኦሶተኔሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1"/>ኦሶ! ሀስሰኖ ጠወ እኮቤቺሃ ቀርቺን አናኖተክዕኔለከ አማኖተክዕኔ አዘዘሜ።<note caller="-" style="x"><char style="xo" closed="false">6፥1 </char><char style="xt" closed="false"><ref loc="COL 3:20">ቆላ. 3፥20</ref>።</char></note> <verse eid="EPH 6:1"/><verse number="2" style="v" sid="EPH 6:2"/>«ህትን አነክለከ አመክ ኬዕምስ» የኖ ትዛዙ ተብሴ ላገት ዮስ ዎኔሃ ትዛዝ፤ <verse eid="EPH 6:2"/><verse number="3" style="v" sid="EPH 6:3"/>ካን አቶንትጎሬ «ጉዕሙ ጠዉንኩ ጡመ እሀኖሄ፤ ከን ኣዱንያ አሌኒ ኡሙሩክ ዱንከኖ» ይታእታን።<note caller="-" style="x"><char style="xo" closed="false">6፥2-3 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ፉል. 20፥12</ref>፤ <ref loc="DEU 5:16">ዘዳ. 5፥16</ref>።</char></note><verse eid="EPH 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4"/>አዕኑ አናከትለከ አማኑት! ቀርቾ ኢሲን ጡመ ዎቃሃ ተማርስቴነን፥ ሸዜነንለከ ሻቄነን ነስዬሰ ቤሉ እለክዕኔ ኡሙርሲሶኖቼ።<note caller="-" style="x"><char style="xo" closed="false">6፥4 </char><char style="xt" closed="false"><ref loc="COL 3:22-25">ቆላ. 3፥22-25</ref>።</char></note><verse eid="EPH 6:4"/></para>
  <para style="s1">ቀርቻኖተለከ ሮሰተኔሃ</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5"/>አዕኑ ሮሰት! ዱንየ አል ቀርቻኑተ እኮህዕኔሀኑኡተ ዋጂንለከ ሁጢን አዘዘሜ፤ መሲህ ካደንቴነንተ ሃሊን ጡመ ቀልቢን አዘዘሜሰ። <verse eid="EPH 6:5"/><verse number="6" style="v" sid="EPH 6:6"/>አዘዘንቴነንታሁ መገን ሰውት ቀልቢች አታ መሲህ አሳበገ እኬኒት ቤሉ መነ ሙንደእስሲሃ ይቴን ለልጪሃ እሁንከ። <verse eid="EPH 6:6"/><verse number="7" style="v" sid="EPH 6:7"/>መነ እሁዕነ ቀርቹ ካደንቴነንተገ አቴን ጡመ ቀልቢን ካደሜ። <verse eid="EPH 6:7"/><verse number="8" style="v" sid="EPH 6:8"/>ሮስ እኮ ሰዎልድቹ ገገዉሰ አቶ ጡመ ሆጎን ቀርቺች ዋጋ ቶጋኢሃ እሁሰ ደጌነንተ።<verse eid="EPH 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9"/>ህትን ቀርቻኑት! መን ሚንተ ለዕይ ጎልበ ክዕኔለከ እሰ ቀርቹ ሰማን ሄኡስ ሰውይቴን ዋጅሲሱክዕኔ አጉርቴን ሮሳተክዕኔ ጡመ አዕዬ።<note caller="-" style="x"><char style="xo" closed="false">6፥9 </char><char style="xt" closed="false"><ref loc="DEU 10:17">ዘዳ. 10፥17</ref>፤ <ref loc="COL 3:25">ቆላ. 3፥25</ref>፤ <ref loc="COL 4:1">4፥1</ref>።</char></note><verse eid="EPH 6:9"/></para>
  <para style="s1">መገኑ ኣሰኖኔ በገዝ ኦዳተ</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10"/>ቀርቾንለከ እስ ሎረ ዎልቃን ጠረኝዬ፤ <verse eid="EPH 6:10"/><verse number="11" style="v" sid="EPH 6:11"/>ሻይጣን ሂለ ሆጉተ ግቦኖተ አታልቴነንተ መገኑ ኣሰኖህዕኔ በገዝ ኦዳተ ጉዕመንከ ኦደዕዬ። <verse eid="EPH 6:11"/><verse number="12" style="v" sid="EPH 6:12"/>ኒ ኦሉ መኒን እሁዕነ ከን ኣዱንያ አሌን አታ ገሻኖኒ፥ ሹማን፥ ከን ኣዱንያ አል ዎልቃንለከ ኡላች አሌን ሄኣ ሂለ አያኒ ዎታደርኒት። <verse eid="EPH 6:12"/><verse number="13" style="v" sid="EPH 6:13"/>ህካን እኮቤቺሃ ሂለ በር ባለጋር ዎልቀተ ፈንቀሽቶኖተ አታልቴነንተለከ ጉዕመንከስ ሹልቴን ጠረኝቴን ኡሪሃ አታልቶኖተ መገን በገዝ ኦዳተ ጉዕመንከ ቆዕርዬ! <figure style="fig" alt="Roman soldier in armor" file="LB00196B.tif" size="span" ref="6፥18">ሮም ወታደርቹ ዊመ በገዝ ኦዳንከስ</figure><verse eid="EPH 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 6:14"/>ቴሱ ሀንቅ ዝናርገ ረመዞንከክዕኔ ቆዕርቴን ወዘናን ኦደኤኖ በገዝ ኦድኖገ ፈይመ በገዝ ኦዳተ ኦደኤን፥<note caller="-" style="x"><char style="xo" closed="false">6፥4 </char><char style="xt" closed="false"><ref loc="ISA 11:5">ኢሳ. 11፥5</ref>፤ <ref loc="ISA 59:17">59፥17</ref>።</char></note> <verse eid="EPH 6:14"/><verse number="15" style="v" sid="EPH 6:15"/>ወገሬት እንጂለ ዱዱብሲሃ ተቃጠቡክዕኔ ጫዕመገ ሎካንከክዕኔ ዎዕርቴን ኡርዬ።<note caller="-" style="x"><char style="xo" closed="false">6፥15 </char><char style="xt" closed="false"><ref loc="ISA 52:7">ኢሳ. 52፥7</ref>።</char></note> <verse eid="EPH 6:15"/><verse number="16" style="v" sid="EPH 6:16"/>ከኒች ጉዕሚችን አበ ጊረ ለበነገ ቡበኖ እልብስ በገዙ ጉዕመንከ አሊችክዕኔ ከዕሙ አታልቴነንተ አመዕነቱ ጌሬንጌርገ አፌ። <verse eid="EPH 6:16"/><verse number="17" style="v" sid="EPH 6:17"/>ጡሙክዕኔ ብረት ቆሜገ ቡዕላንከክዕኔ ወዕርዬ፤ ህትን ጠሊለ አያኒች ደገመኖ ሲፈ ሁኩንን መገን ላገተ አፌ።<note caller="-" style="x"><char style="xo" closed="false">6፥17 </char><char style="xt" closed="false"><ref loc="ISA 59:17">ኢሳ. 59፥17</ref>።</char></note> <verse eid="EPH 6:17"/><verse number="18" style="v" sid="EPH 6:18"/>ጉዕመ ወክት ጠሊለ አያነ አዎንቴነን ዱአ አዕዬ፤ ከን ሃሊን መገኑ መጠሮሰ መኒሃ በቅ ይቴንለከ ጠረኝቴን ዱአ አዕዬ። <verse eid="EPH 6:18"/><verse number="19" style="v" sid="EPH 6:19"/>እንጂል ምስጥር መለል ኩሎተ ጠወኣም ወክት ሀስሳ ላገት ኣሰንታኤገ ኤሳሃ ዱአ አዕዬ። <verse eid="EPH 6:19"/><verse number="20" style="v" sid="EPH 6:20"/>ቴሁ ሰንሰለቲን ኡሱረም ከን እንጂሊሃ አሳቤቹሃን፤ ህካን እኮቤቺሃ ሀስሰኖገ መለል ጠወኦተ ዱአ አዕዬ።<verse eid="EPH 6:20"/></para>
  <para style="s1">መጨረሽ ወገሬት</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21"/>ኢተሞ አመኔቤቱለከ ቀርች ሆጎን አመዕነሞ ካድንቹ ቲኪቆስ አን ሀት ዮም ጎሬ መ አኣም ጎሬ ጉዕመርቹንከ ኩለኖህዕኔ።<note caller="-" style="x"><char style="xo" closed="false">6፥21 </char><char style="xt" closed="false"><ref loc="ACT 20:4">ሶቀ. 20፥4</ref>፤ <ref loc="2TI 4:12">2 ጢሞ. 4፥12</ref>።</char></note> <verse eid="EPH 6:21"/><verse number="22" style="v" sid="EPH 6:22"/>ህካን እኮቤቺሃ ነኡ ሀት እንኮምጎር ደጎኖተለከ ክዕኔተ ጠረኝሶህዕኔተ ይ እሱ ክዕኔቤቹ ሶኮም።<note caller="-" style="x"><char style="xo" closed="false">6፥21-22 </char><char style="xt" closed="false"><ref loc="COL 4:7-8">ቆላ. 4፥7-8</ref>።</char></note><verse eid="EPH 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23"/>አነ መገንለከ ቀርቾሃ መሲህ ኢስን ወገሬቱለከ ኢተት አመዕነቲን ሜጡበ አመ ኦሶተ እሁን። <verse eid="EPH 6:23"/><verse number="24" style="v" sid="EPH 6:24"/>ሙርተእበ ኢታን ቀርቹኔ መሲህ ኢሰ ኢትታሀኑኡተ ጉዕሚንከ ኣስቱት እኩንሰ።<verse eid="EPH 6:24"/></para>
  <chapter eid="EPH 6"/>
</usx>
