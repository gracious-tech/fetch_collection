<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Romani Gurbet Bible (GSP)</book>
  <para style="h">Matej</para>
  <para style="toc1">Lačho Lafi taro Matej</para>
  <para style="toc2">Matej</para>
  <para style="toc3">Mt</para>
  <para style="mt">Lačho Lafi taro Matej</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Spisko tare Isusese kuštika</para>
  <para style="r">(<ref loc="LUK 3:23-38">Lk 3,23–38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Kava si spisko tare kuštika e Isusese savo si Hrist, savo sasa potomko e Davideso thaj potomko e Avraameso.<verse eid="MAT 1:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="MAT 1:2" />E Avraamese bijandilo o Isaak.</para>
  <para style="li1" vid="MAT 1:2">A e Isaakose bijandilo o Jakov.</para>
  <para style="li1" vid="MAT 1:2">A e Jakovese bijandile o Juda thaj lese phrala.<verse eid="MAT 1:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="MAT 1:3" />A e Judase i Tamara bijanda e Farese thaj e Zare.</para>
  <para style="li1" vid="MAT 1:3">A e Faresese bijandilo o Esrom.</para>
  <para style="li1" vid="MAT 1:3">A e Esromese bijandilo o Aram.<verse eid="MAT 1:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="MAT 1:4" />A e Aramese bijandilo o Aminadav.</para>
  <para style="li1" vid="MAT 1:4">A e Aminadavese bijandilo o Naason.</para>
  <para style="li1" vid="MAT 1:4">A e Naasonese bijandilo o Salmon.<verse eid="MAT 1:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="MAT 1:5" />A e Salmonese i Raava bijanda e Vooze.</para>
  <para style="li1" vid="MAT 1:5">A e Voozese i Ruta bijanda e Jovide.</para>
  <para style="li1" vid="MAT 1:5">A e Jovidese bijandilo o Jesej.<verse eid="MAT 1:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="MAT 1:6" />A e Jesejese bijandilo o caro o David.</para>
  <para style="li1" vid="MAT 1:6">A e Davidese, e Urijasi romni bijanda e Solomone.<verse eid="MAT 1:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="MAT 1:7" />A e Solomonese bijandilo o Rovoam.</para>
  <para style="li1" vid="MAT 1:7">A e Rovoamese bijandilo o Avija.</para>
  <para style="li1" vid="MAT 1:7">A e Avijase bijandilo o Asaf.<verse eid="MAT 1:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="MAT 1:8" />A e Asafese bijandilo o Josafat.</para>
  <para style="li1" vid="MAT 1:8">A e Josafatese bijandilo o Joram.</para>
  <para style="li1" vid="MAT 1:8">A e Joramese bijandilo o Ozija.<verse eid="MAT 1:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="MAT 1:9" />A e Ozijase bijandilo o Joatam.</para>
  <para style="li1" vid="MAT 1:9">A e Joatamese bijandilo o Ahaz.</para>
  <para style="li1" vid="MAT 1:9">A e Ahazese bijandilo o Ezekija.<verse eid="MAT 1:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="MAT 1:10" />A e Ezekijase bijandilo o Manasija.</para>
  <para style="li1" vid="MAT 1:10">A e Manasijase bijandilo o Amos.</para>
  <para style="li1" vid="MAT 1:10">A e Amosese bijandilo o Josija.<verse eid="MAT 1:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="MAT 1:11" />A e Josijase bijandile o Jehonija thaj lese phrala. Sasa gova ano vreme kana e Izraelcuren inđarde ano Vavilon.<verse eid="MAT 1:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="MAT 1:12" />A palo džajipe ko ropstvo ano Vavilon, e Jehonijase bijandilo o Salatiilo.</para>
  <para style="li1" vid="MAT 1:12">A e Salatiilose bijandilo o Zorovavel.<verse eid="MAT 1:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="MAT 1:13" />A e Zorovavelese bijandilo o Avijud.</para>
  <para style="li1" vid="MAT 1:13">E Avijudase bijandilo o Elijakim.</para>
  <para style="li1" vid="MAT 1:13">A e Elijakimese bijandilo o Azor.<verse eid="MAT 1:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="MAT 1:14" />A e Azorese bijandilo o Sadok.</para>
  <para style="li1" vid="MAT 1:14">A e Sadokese bijandilo o Ahim.</para>
  <para style="li1" vid="MAT 1:14">A e Ahimese bijandilo o Elijud.<verse eid="MAT 1:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="MAT 1:15" />A e Elijudase bijandilo o Eleazar.</para>
  <para style="li1" vid="MAT 1:15">A e Eleazarese bijandilo o Matan.</para>
  <para style="li1" vid="MAT 1:15">A e Matanese bijandilo o Jakov.<verse eid="MAT 1:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="MAT 1:16" />A e Jakovese bijandilo o Josif, o rom e Marijako, savi bijanda e Isuse akhardo Hrist.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Gija si e kuštika taro Avraam dži o David dešuštar (14), a taro David dži ko džajipe ko ropstvo ano Vavilon, dešuštar (14) kuštika, a taro džajipe ano Vavilon dži o Hrist, dešuštar (14) kuštika.<verse eid="MAT 1:17" /></para>
  <para style="s">Bijandipe e Isuseso e Hristeso</para>
  <para style="r">(<ref loc="LUK 2:1-7">Lk 2,1–7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />A o bijandipe e Isuseso e Hristeso sasa gija: Kana i Marija lesi dej sasa mangli romnjaće taro Josif thaj vadži ni lije pe thaj voj sasa čhej, ačhili khamni taro Sveto Duxo. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />A o Josif lako rom, golese so sasa pravedno manuš thaj golese so ni manglja te ladžarol la, manglja čorale te ačhavol la.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />Thaj kana gija dija gođi golestar, zasuta thaj ano suno iklilo lese o anđelo e Gospodeso savo vaćarda: “Josife, čhaveja e Davideso! Ma te dara te le e Marija romnjaće. O čhavoro save voj ađućarol si taro Sveto Duxo. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Ka bijanol čhave, a tu de le alav Isus<note caller="+" style="f"><char style="fr" closed="false">1,21 </char><char style="ft" closed="false">so značil: “O Gospod spasil.” </char></note> golese so ka spasil pe manušen tare lenđe grehura.”<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />A sa kava sasa te ćerdol kova so o Dol vaćarda prekalo proroko:<verse eid="MAT 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="MAT 1:23" />“Akh, i čhej ka ačhol khamni,</para>
  <para style="q2" vid="MAT 1:23">thaj ka bijanol čhave thaj von ka den le alav Emanuel”</para>
  <para style="q1" vid="MAT 1:23">so značil: “O Dol si amencar.”<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Kana o Josif uštilo taro sojipe, ćerda sar so vaćarda lese o anđelo e Gospodeso – anda e Marija pe ćhereste thaj lija la romnjaće. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Al vov ni suta lasa sa dži kaj ni bijanda murše čhave thaj dija le alav Isus.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">E mudrakura peren ke koča anglo čhavoro o Isus</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />A kana bijandilo o Isus ano Vitlejem ani regija i Judeja, ko vreme e caroso e Irodeso, gothe avile e mudrakura taro istok ano Jerusalim, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />thaj pučlje: “Kaj si o jevrejsko caro savo tek bijandilo? Golese so dikhljam lesi čereni kaj iklili ko istok thaj aviljam te pera lese ke koča.”<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Kana gova šunda o caro o Irod, vov but uznemirisajlo thaj savore ano Jerusalim. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Golese akharda sa e bare sveštenikuren thaj e učiteljuren e narodose tare Mojsijaso zakon thaj pučlja len: “Kaj trubul te bijandol o Hrist?” <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />A von vaćarde lese: “Ano Vitlejem o Judejsko, golese so o proroko pisisada:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />‘A tu Vitlejeme, ani phuv e Judaći,</para>
  <para style="q2" vid="MAT 2:6">naj san nevažno maškar e Judejska thana,</para>
  <para style="q1" vid="MAT 2:6">golese so tutar ka ikljol vladari</para>
  <para style="q2" vid="MAT 2:6">savo ka inđarol pe manušen ano Izrael, sar o pastiri pe bakren.’”<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Thaj o Irod čorale bičhalda te den vika e mudrakuren thaj pučlja len kana tačno iklili i čereni.<verse eid="MAT 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 2:8" />Tegani bičhalda len ano Vitlejem, vaćarindoj: “Džan tumen thaj pučen šukar bašo čhavoro. Kana ka araćhen le, aven vaćaren manđe, te džav i me te perav angle leste ke me koča.”<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Von šunde e caro thaj đele. Thaj akh, i čereni sava dikhlje sar ikljol đeli angle lende sa dži kaj ni ačhili upreder o than kaj sasa o čhavoro. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Kana dikhlje i čereni, sesa baxtale, a lenđe ile sesa pherde. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Đele andre ano ćher, dikhlje e čhavore thaj lesa sasa lesi dej i Marija. Pele tele ke pe koča thaj poklonisajle lese. Pale gova putarde pe kutije thaj dije le pe darura: zlato, tamjano thaj smirna. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Thaj ano suno upozorisada len o Dol te ma irin pe ko Irod, golese avere dromesa đele ani piri phuv.<verse eid="MAT 2:12" /></para>
  <para style="s">O Josif, i Marija thaj o Isus našen ano Egipat</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Kana đele e mudrakura, dikh, avilo o anđelo e Gospodeso e Josifese ano suno thaj vaćarda lese: “Ušti, le e čhave thaj lese da, thaj naš ano Egipat thaj av odori dok me ni vaćarav tuće, golese so o Irod ka rodol e čhavore te mudarol le.”<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />Vov uštilo goja rat lija e čhavore thaj lese da, thaj našlo ano Egipat. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />Thaj odori ačhilo dži o meripe e Irodeso, te bi pherdola so o Gospod vaćarda prekalo proroko:</para>
  <para style="m" vid="MAT 2:15">“Taro Egipat dijem vika me čhave.”<verse eid="MAT 2:15" /></para>
  <para style="s">O Irod mudarol e muršane čhavoren ano Vitlejem</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Kana o Irod dikhlja so e mudrakura xoxade le, holajlo but thaj bičhalda e vojnikuren te mudaren ano Vitlejem thaj ane pašutne thana e muršane čhavoren dži e duj berš, palo vreme kana iklili i čereni tare savi dodžanglja tare mudrakura. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Gija pherdilo kova so vaćarda o proroko o Jeremija:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />“O glaso ano foro Rama šundilo,</para>
  <para style="q2" vid="MAT 2:18">o rojipe thaj o kukipe baro.</para>
  <para style="q1" vid="MAT 2:18">Gova i Rahilja rovol pe čhavoren,</para>
  <para style="q2" vid="MAT 2:18">thaj našti te ačhol laći dukh,</para>
  <para style="q1" vid="MAT 2:18">golese so naj la vadži čhave.”<verse eid="MAT 2:18" /></para>
  <para style="s">O Josif, i Marija thaj o Isus irin pe ano Izrael</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />A palo meripe e Irodeso, avilo o anđelo e Gospodeso e Josifese ano Egipat ko suno <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />thaj vaćarda lese: “Ušti, le e čhave thaj lese da, pa dža ani phuv i Izraelsko, golese so mule kola save manglje te mudaren e čhavore.”<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />O Josif uštilo, lija e čhavore thaj lese da, pa avilo ani phuv i Izraelsko. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />A kana o Josif šunda so o Arhelaj, o čhavo e Irodeso vladil ani Judeja umesto leso dad, darajlo te džal odori. Tegani ano suno upozorisada le o Dol, te džal ani phuv i Galilejsko. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />Thaj kana avilo odori pe familijasa, ačhilo te bešol ano foro savo akhardola Nazaret. Gija pherdilo gova so e prorokura vaćarde: “Ka akharen e Hriste Nazarećanino.”<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">O Jovane o Krstitelj pripremil o drom e Isusese</para>
  <para style="r">(<ref loc="MRK 1:1-8">Mk 1,1–8</ref>; <ref loc="LUK 3:1-9">Lk 3,1–9</ref>, <ref loc="LUK 3:15-17">15–17</ref>; <ref loc="JHN 1:19-28">Jn 1,19–28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />A ane gola đivesa avilo o Jovane o Krstitelj thaj propovedila ani Judejsko pustinja. <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />Thaj vaćarda: “Pokajin tumen, golese so sigate avol o Carstvo e neboso!”<verse eid="MAT 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 3:3" />Golese so si o Jovane gova kastar vaćarda o proroko Isaija:</para>
  <para style="q1" vid="MAT 3:3">“Vov si glaso so dol vika ani pustinja:</para>
  <para style="q2" vid="MAT 3:3">‘Pripremin o drom e Gospodese!</para>
  <para style="q2" vid="MAT 3:3">Ravnin lese o drom!’”<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />A po Jovane sesa šeja khuvde tare kamilaće bala thaj kuštik tari morčhi, a leso xape sesa e skakavcura thaj divljo avđin. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />But manuša avena ke leste taro Jerusalim thaj tari sa i phuv i Judeja thaj tare trujale thana paši len o Jordan, <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />vaćarena pe grehura, a o Jovane krstila len ani Jordansko len.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Al kana dikhlja o Jovane bute farisejen thaj e sadukejen so avena te krstin pe, vaćarda lenđe: “Tumen e sapese čhave! Ko vaćarda tumenđe kaj šaj te našen tare Devlesi holi so avol? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Sikaven tumare džuvdimasa thaj tumare bućencar kaj irisaljen taro greh thaj aviljen anglo Dol! <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Ma mislin kaj si dovoljno te phenen: ‘Amaro paradad si o Avraam!’ Golese vaćarav tumenđe kaj o Dol šaj tare kala bara te vazdol čhaven e Avraamese. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Golese so o tover tare Devleso sudo ačhol pašo koreno e kašteso thaj dži jekh kaš savo ni bijanol šukar bijanipe ka čhinol pe thaj ani jag ka čhudol pe.<verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />Me tumen krstiv pajesa te bi sikavena tumaro pokajanje. Al kova savo avol pale mande, po baro si mandar – me naj sem dostojno ni lese sandale ke pingre te inđarav. Vov ka krstil tumen e Svetone Duxosa thaj jagasa. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Le isi vila ane vasta thaj ka čistil o gumno i ka ćidol o điv ane piro ambari, a i pleva ka phabarol jagasa savi ka phabol thaj ni ka ačhol.”<verse eid="MAT 3:12" /></para>
  <para style="s">O Jovane krstil e Isuse</para>
  <para style="r">(<ref loc="MRK 1:9-11">Mk 1,9–11</ref>; <ref loc="LUK 3:21-22">Lk 3,21–22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Tegani o Isus tari Galileja avilo ki len o Jordan te bi krstila le o Jovane.<verse eid="MAT 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 3:14" />O Jovane ni manglja thaj vaćarda lese: “Tu trubul man te krsti, a tu aviljan mande?”<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />A o Isus vaćarda lese: “Ačhav akana gova, golese so gija trubul te phera sa o pravednost.”</para>
  <para style="m" vid="MAT 3:15">Tegani o Jovane krstisada le.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Thaj kana o Isus krstisajlo, iklilo sigate andaro paj, thaj dikh, o nebo putajlo thaj dikhlja sar e Devleso Duxo uljol sar golubo thaj mukhlja pe pe leste.<verse eid="MAT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 3:17" />Thaj dikh, o glaso taro nebo vaćarda: “Kava si mo Čhavo o manglo, savo si palo mingro manglipe!”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">O beng iskušil e Isuse</para>
  <para style="r">(<ref loc="MRK 1:12-13">Mk 1,12–13</ref>; <ref loc="LUK 4:1-13">Lk 4,1–13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Tegani o Sveto Duxo inđarda e Isuse ani pustinja, te iskušil le o beng. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Thaj postisada o Isus saranda (40) đive thaj raća thaj ko krajo bokhajlo.<verse eid="MAT 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 4:3" />Thaj avilo paše leste o beng savo iskušil thaj vaćarda lese: “Te san e Devleso Čhavo, vaćar kale barenđe te aven mangre.” <verse eid="MAT 4:3" /><verse number="4" style="v" sid="MAT 4:4" />A o Isus phenda lese: “Ano Sveto lil si pisimo:</para>
  <para style="q1" vid="MAT 4:4">‘O manuš ni ka avol džuvdo samo taro mangro,</para>
  <para style="q2" vid="MAT 4:4">nego tare dži jekh lafi savo ikljol taro muj e Devleso.’”<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Tegani o beng inđarda le ano sveto foro o Jerusalim thaj čhuta le ko emupruno than e Hrameso <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />pa vaćarda lese: “Te san e Devleso Čhavo, čhude tut katar tele, golese so si pisimo:</para>
  <para style="q1" vid="MAT 4:6">‘E anđelurenđe ka naredil baše tute,</para>
  <para style="q2" vid="MAT 4:6">thaj ka len tut ke vasta</para>
  <para style="q2" vid="MAT 4:6">te ma čalave tut ko bar će pingresa.’”<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />O Isus vaćarda lese: “Ano Sveto lil si pisimo: ‘Ma iskuši e Gospode, e Devle ćire!’”<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Pale gova o beng inđarda le upre ko but učo brego thaj sikada lese sa e carstvura tare kava sveto thaj lenđi slava <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />thaj vaćarda lese: “Sa ka dav tut kava ako pere ke koča thaj pokloni tut manđe.”<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Tegani vaćarda lese o Isus: “Dža mandar, Satano! Golese so ano Sveto lil ačhol: ‘Pokloni tut e Gospodese e Devlese ćirese thaj lese jekhese služi.’”<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Tegani o beng ačhada e Isuse, a sigate e anđelura avile thaj služisade le.<verse eid="MAT 4:11" /></para>
  <para style="s">O Isus lija te propovedil</para>
  <para style="r">(<ref loc="MRK 1:14-15">Mk 1,14–15</ref>; <ref loc="LUK 4:14-15">Lk 4,14–15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Kana šunda o Isus kaj si o Jovane o Krstitelj ano phanglipe, đelo ani Galileja. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Tegani ačhada o Nazaret pa đelo thaj bešlo ano Kafarnaum, pašo Galilejsko jezero ke Zavuloneso thaj e Neftalimeso krajo, <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />te bi pherdola kova so vaćarda o proroko o Isaija:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />“Ani phuv e Zavulonesi thaj ani phuv e Neftalimesi,</para>
  <para style="q2" vid="MAT 4:15">o drom savo inđarol pašo more, tari aver rig e Jordanesi,</para>
  <para style="q2" vid="MAT 4:15">ani Galileja ani phuv savi si e abandžijenđi,<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />manuša save bešen ano kalipe</para>
  <para style="q2" vid="MAT 4:16">ka dićhen svetlost baro,</para>
  <para style="q1" vid="MAT 4:16">e manuša save bešen ano mrako,</para>
  <para style="q2" vid="MAT 4:16">o svetlost pe lende ka sijajil.”<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Tare gova vreme o Isus lija te propovedil thaj te vaćarol: “Pokajin tumen, golese so si paše o Carstvo e neboso.”<verse eid="MAT 4:17" /></para>
  <para style="s">O Isus akharol e anglune sikaden</para>
  <para style="r">(<ref loc="MRK 1:16-20">Mk 1,16–20</ref>; <ref loc="LUK 5:1-11">Lk 5,1–11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Thaj dži kaj o Isus phirda pašo Galilejsko more, dikhlja duje phralen, e Simone kas akharen Petar thaj e Andrija lese phrale, sar čhuden e mreže ano more, golese so sesa ribara. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Thaj vaćarda lenđe: “Aven mancar thaj ka ćerav tumen ribara e manušenđe.”<verse eid="MAT 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 4:20" />Von sigate ačhade e mreže thaj đele pale leste.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Gothar kana đelo po dur zala, dikhlja avere dujen phralen, e Jakove thaj e Jovane e Zevedejese čhaven, sar pe dadesa e Zevedejesa ano čamco prećeren pe mreže thaj dija len vika. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Von sigate ačhade o čamco thaj pe dade thaj đele palo Isus.<verse eid="MAT 4:22" /></para>
  <para style="s">O Isus sastarol e nasvalen</para>
  <para style="r">(<ref loc="LUK 6:17-19">Lk 6,17–19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />O Isus phirda ani sa i Galileja, sikada ane jevrejska sinagoge thaj vaćarda o Lačho Lafi taro Carstvo e neboso thaj sastarda dži jekh nasvalipe thaj bilačhipe so sasa ano narodo. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Thaj sa gova so ćerola šundilo ani sa i Sirija thaj angle leste ande e nasvalen tare dži jekh nasvalipe thaj muke, e manušen ane save sesa e bilačhe duxura, kolen so sasa paraliza, kola so naštine te phiren thaj vov sastarda len. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Pale leste phirena but džene tari Galileja, taro Dekapolis, taro Jerusalim, tari Judeja thaj tari phuv savi si ki aver rig e Jordanesi.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Vaćaripe ko brego tare blagoslovura</para>
  <para style="r">(<ref loc="LUK 6:20-23">Lk 6,20–23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Kana o Isus dikhlja so ćidije pe but manuša, iklilo ko brego, bešlo thaj avile lese sikade paše leste. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />A vov lija te sikavol len, vaćarindoj:<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />“Blagoslovime si kola save si čorore duxosa,</para>
  <para style="q2" vid="MAT 5:3">golese so si lengo o Carstvo e neboso.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Blagoslovime si kola save roven,</para>
  <para style="q2" vid="MAT 5:4">golese so ka utešin pe.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Blagoslovime si e kovle ilenđe,</para>
  <para style="q2" vid="MAT 5:5">golese so von ka nasledin i phuv.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Blagoslovime si e bokhale thaj e trošale bašo pravednost,</para>
  <para style="q2" vid="MAT 5:6">golese so von ka čaljon.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Blagoslovime si e milostiva,</para>
  <para style="q2" vid="MAT 5:7">golese so o Dol ka smiluilpe pe lende.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Blagoslovime si kola save si čistone ilencar,</para>
  <para style="q2" vid="MAT 5:8">golese so e Devle ka dićhen.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Blagoslovime si kola save ćeren mir,</para>
  <para style="q2" vid="MAT 5:9">golese so ka akhardon e Devlese čhave.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Blagoslovime si kola save si tradime bašo pravednost,</para>
  <para style="q2" vid="MAT 5:10">golese so si lengo o Carstvo e neboso.<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />Blagoslovime sen kana baše mande ka ladžaren tumen thaj traden tumen thaj xoxavne bilačhe buća čhuven pe tumende! <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Radujin tumen thaj aven baxtale, golese so tumari plata si bari ko nebo, golese so gija e prorokuren tradije angleder tumende!”<verse eid="MAT 5:12" /></para>
  <para style="s">E Isusese sikade si lon thaj svetlo</para>
  <para style="r">(<ref loc="MRK 9:50">Mk 9,50</ref>; <ref loc="LUK 14:34-35">Lk 14,34–35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />O Isus vadži vaćarda: “Tumen sen sar lon e manušenđe ki phuv, te nakhlo leso londipe, sose šaj te koristil pe? Naj khančese, samo te čhudol pe thaj avral te uštaven e manuša pe leste.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />Tumen sen o svetlo kale svetoso. Našti garavol pe o foro savo si ko brego. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Ni phabaren i svetiljka te bi čhuvena la talo čaro, nego čhuvol la ko than e svetiljkako te svetlil savorenđe ano ćher. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Gija te svetlil tumaro svetlost angle manuša, te dićhen tumare šukar buća thaj te slavin tumare Dade savo si ano nebo.”<verse eid="MAT 5:16" /></para>
  <para style="s">O Isus sikavol tare Mojsijaso zakon thaj tare prorokura</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />O Isus vadži vaćarda: “Ma te den gođi kaj me aviljem te čhinavav e Mojsijaso zakon thaj o vaćaripe e prorokurengo. Na, ni aviljem te čhinavav, nego aviljem te pherav len. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Golese čače vaćarav tumenđe dži kaj ačhen o nebo thaj i phuv, ni ka naćhol ni emcikno slovo il nesavi crtica tare Mojsijaso zakon dži kaj sa ni avol gija. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Golese, te phaglja khoni jekh tare emcikne zapovestura i gija sikavol, emcikno ka avol ano Carstvo e neboso. A ko sikavol len thaj ćerol gija, ka avol baro ano Carstvo e neboso. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Golese, vaćarav tumenđe: ako tumaro pravednost ni avol pobaro tare učiteljengo tare Mojsijaso zakon thaj tare fariseja, našti te den ano Carstvo e neboso.”<verse eid="MAT 5:20" /></para>
  <para style="s">O Isus sikavol tari holi</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />O Isus vadži vaćarda: “Šunden sar si vaćardo amare puranenđe: ‘Ma mudar’, golese ko mudarol, mora te ikljol ko sudo. <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />A me vaćarav tumenđe: Ko holjavol pe piro phral, mora te ikljol ko sudo. A savo vaćarol pe phralese ‘Budalo’, mora te ikljol anglo Baro sudo, a savo vaćarol pe phralese ‘Dileja’, zaslužil te phabol ani jag savi ni ačhol.<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />Gija, kana ačhe anglo žrtveniko ano Hram te ane žrtva thaj tari jekh drom dijan tut gođi kaj si nesavo phral protiv tute, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />ačhav gothe e žrtva anglo žrtveniko thaj angleder pomiri tut ćire phralesa, tegani av thaj de e žrtva e Devlese.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />Dikh sigate te miri tut ćire dušmanesa dok phire lesa po drom, te ma dol tut e sudijase, a o sudija te dol tut e slugase, savo ka čhudol tut ano phanglipe. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Čače vaćarav tuće: ni ka iklje gothar dok ni poćine dži i zadnjo parava.”<verse eid="MAT 5:26" /></para>
  <para style="s">O Isus sikavol tari preljuba</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />O Isus vadži vaćarda: “Šunden sar si vaćardo: ‘Ma ćeren preljuba!’ <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Al me vaćarav tumenđe ko dićhol ani aver džuvli te bi sovola lasa, već ćerda preljuba ano po ilo lasa. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Ako inđarol tut ano greh ćiri desno jakh, ikal la thaj čhude la tutar. Po šukar si te hasare jekh kotor tutar, nego sa ćiro telo te avol čhudimo ani jag savi ni ačhol. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Ako inđarol tut ćiro desno va ano greh, čhin le thaj čhude le tutar. Po šukar si te hasare jekh kotor tutar, nego sa ćiro telo te džal ani jag savi ni ačhol.”<verse eid="MAT 5:30" /></para>
  <para style="s">O Isus sikavol taro razvod</para>
  <para style="r">(<ref loc="MAT 19:9">Mt 19,9</ref>; <ref loc="MRK 10:11-12">Mk 10,11–12</ref>; <ref loc="LUK 16:18">Lk 16,18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />O Isus vadži vaćarda: “Gija šunden: ‘Ako neko mućhol pe romnja, nek dol la lil kaj ačhada la.’ <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Al me vaćarav tumenđe: sa ko mućhol pe romnja – sem te voj ćerda blud – čhuvol la te ćerol blud. Thaj savo lol ačhade džuvlja, ćerol blud.”<verse eid="MAT 5:32" /></para>
  <para style="s">O Isus sikavol tari sovli</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />O Isus vaćarda: “Vadži šunden sar si vaćardo amare puranenđe: ‘Ma phag i sovli thaj ćer okova so e Gospodese xaljan sovli.’ <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Al me vaćarav tumenđe: Ma xan sovli nisar! Ma xan sovli ni e nebosa, golese so si presto e Devleso, <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />ni phuvasa, golese so si tale pingre lese, ni e Jerusalimesa, golese so gova foro preperol e Devlese, e bare carose. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Ni ćire šoresa ma xa sovli, golese so nijekh bal našti ćere parno il kalo. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Gija, tumaro ‘Va’ čače te avol ‘Va’, tumaro ‘Na’ čače te avol ‘Na’. Thaj so si pobut taro kava, taro bilačho si.”<verse eid="MAT 5:37" /></para>
  <para style="s">O Isus sikavol tari osveta</para>
  <para style="r">(<ref loc="LUK 6:29-30">Lk 6,29–30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />O Isus vadži vaćarda: “Šunden sar si vaćardo: ‘Jakh jakhaće, dand dandese!’ <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Al me vaćarav tumenđe: Ma brani tut taro bilačho manuš. Ako ko čalavol tut tari desno čham, iri lese i aver čham. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Thaj ko manđol te sudil pe tusa thaj manđol te lol ćiro fostano, de le i ćiro ogrtači. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Thaj ako čhuven tut e rimska vojnikura te inđare lenđi oprema jekh kilometro, inđar la duj. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Ko rodol tutar, de le thaj ma iri ćiro dumo taro okova so rodol tutar.”<verse eid="MAT 5:42" /></para>
  <para style="s">O Isus sikavol te manga amare dušmanuren</para>
  <para style="r">(<ref loc="LUK 6:27-28">Lk 6,27–28</ref>, <ref loc="LUK 6:32-36">32–36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />O Isus vadži vaćarda: “Šunden sar si vaćardo: ‘Mang ćire pašutne’ thaj ma mang ćire dušmane! <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Al me vaćarav tumenđe: manđen tumare dušmanuren thaj molin tumen baše kola save tumen progonin! <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />Ako ćeren kava ka aven sar prava čhave tumare Dadese savo si ko nebo, golese so pe khamesa tatarol e bilačhen thaj e šukaren thaj bičhalol bršnd kolenđe save si čačutne thaj nepravedna. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Thaj ako manđen samo kolen save tumen manđen, savi plata isi tumen? Ni li ćeren gova e carincura? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Thaj ako pozdravin samo tumare phralen, so ćere po šukar averendar? Ni li ćeren gova e manuša save ni pačan e Devle? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Thaj tumen aven gija savršena, sar so si tumaro Dad ko nebo savršeno.”<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">O Isus sikavol te da taro ilo</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />O Isus vadži vaćarda: “Pazin te ma ćeren tumare buća taro pravednost angle manuša von te dićhen tumen thaj te divin pe tumenđe. Te ćerden kava, ni ka avol tumen plata ke tumaro Dad savo si ko nebo.<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />Golese kana de e čororenđe, ma galami angle tute, sar so ćeren e dujemujenđe ani sinagoga thaj pe droma te bi hvalina len e manuša. Čače vaćarav tumenđe, aver nagrada ni ka dobin sem goja tare manuša. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Thaj kana de e čororenđe, te ni džanol ćo levo va so ćerol o desno. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Gija te de e čororenđe garandoj thaj ćo Dad te dićhol kaj gova ćere čorale, a vov ka poćinol tuće.”<verse eid="MAT 6:4" /></para>
  <para style="s">O Isus sikavol e sikaden sar te molin pe</para>
  <para style="r">(<ref loc="LUK 11:2-4">Lk 11,2–4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />O Isus vadži vaćarda: “Thaj kana molin tumen, ma te aven sar kola dujemujenđe, save but manđen te ačhen ke sinagoge thaj ke anglune droma te molin pe thaj te dićhen len e manuša. Čače vaćarav tumenđe, aver nagrada ni ka dobin sem goja tare manuša. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />A tu, kana moli tut, dža ani ći soba kaj ka ave korkoro, phande ćo vudar thaj moli tut će Devlese savo si ano garajipe thaj ćo Dad savo dićhol ano garajipe, ka poćinol tuće.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />Thaj kana molin tumen, ma vaćaren but lafura sar kola save ni džanen e Devlese, golese so von den gođi kaj ka aven uslišime baše but lafura. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Ma aven sar von, golese so tumaro Dad džanol so trubul tumenđe i angleder nego so molin le.<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />Gija molin tumen:</para>
  <para style="q1" vid="MAT 6:9">‘Dade amareja, savo san ano nebo,</para>
  <para style="q2" vid="MAT 6:9">nek svetil pe ćo alav.<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Te avol ćiro Carstvo.</para>
  <para style="q2" vid="MAT 6:10">Te avol ćiri volja,</para>
  <para style="q2" vid="MAT 6:10">sar ko nebo, gija ki phuv.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Mangro savo trubul amen,</para>
  <para style="q2" vid="MAT 6:11">de amen avđive<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />thaj oprosti amare grehura,</para>
  <para style="q2" vid="MAT 6:12">sar amen so oprosti kolenđe</para>
  <para style="q2" vid="MAT 6:12">so grešin premal amende.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />Thaj crde amen taro iskušenje,</para>
  <para style="q2" vid="MAT 6:13">al ikal amen taro bilačhipe.</para>
  <para style="q1" vid="MAT 6:13">[Golese so si ćiro Carstvo,</para>
  <para style="q2" vid="MAT 6:13">thaj zor, thaj i slava ane sa e đivesa. Amin.]’<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />Golese ako oprostin e manušenđe save grešin premal tumende, i o Dad tumaro o nebesko ka oprostil tumenđe. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Al ako ni oprostin e manušenđe lenđe grehura, ni o Dad tumaro e grehura tumare ni ka oprostil.”<verse eid="MAT 6:15" /></para>
  <para style="s">O Isus sikavol taro post</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />O Isus vadži vaćarda: “Thaj kana postin, ma aven sar e dujemujenđe so ćeren pe žalosna, golese so von ćeren žalosna muja te dićhen len e manuša kaj postin. Čače vaćarav tumenđe kaj aver nagrada ni ka dobin sem goja tare manuša. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Al tu kana posti, makh ćo šoro uljesa thaj thov ćo muj, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />te ni dićhen e manuša kaj posti, nego samo ćiro Dad, savo si ano garajipe. Thaj ćo Dad savo dićhol ano garajipe, ka poćinol tuće.”<verse eid="MAT 6:18" /></para>
  <para style="s">O Isus sikavol taro barvalipe</para>
  <para style="r">(<ref loc="LUK 12:33-34">Lk 12,33–34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />O Isus vadži vaćarda: “Ma ćiden tumenđe barvalipe kate ki phuv, kaj o moljco thaj i rđa rumil thaj kaj e čora ka uljen thaj ka čoren. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Ćiden tumenđe barvalipe ko nebo, kaj ni o moljco ni i rđa ni rumil thaj kaj e čora ni uljen thaj ni čoren. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Golese, kaj si ćo barvalipe, gothe ka avol ćo ilo.”<verse eid="MAT 6:21" /></para>
  <para style="s">O svetlo thaj kalipe e teloso</para>
  <para style="r">(<ref loc="LUK 11:34-36">Lk 11,34–36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />“I jakh si sar i svetiljka e telose. Ako si gija ćiri jakh sasti, sa ćo telo ka avol pherdo svetlosa. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Te si ći jakh bilačhi, sa ćo telo ka avol ano kalipe. Gijate, ako si o svetlost ane tute kalipe, tegani o kalipe ka avol but po baro ane tute!”<verse eid="MAT 6:23" /></para>
  <para style="s">O Dol thaj o barvalipe</para>
  <para style="r">(<ref loc="LUK 16:13">Lk 16,13</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />“Nijekh našti služil tari jekh drom dujen gospodaren. Il jekhe ka mrzil, a e dujtone ka manđol, il jekhe ka šunol, a e dujtone ni ka podnosil. Našti služin e Devle thaj o barvalipe.”<verse eid="MAT 6:24" /></para>
  <para style="s">Ma brinin tumen!</para>
  <para style="r">(<ref loc="LUK 12:22-34">Lk 12,22–34</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />O Isus vadži vaćarda: “Golese vaćarav tumenđe: Ma brinin tumen baše tumaro džuvdipe, dal ka avol tumen so te xan il so te pijen, ni tumare telose so ka uraven! Naj li o džuvdipe po važno taro xape a o telo tare šeja? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Dićhen e čirikljen ko nebo! Ni sejin, ni ćiden thaj ni čhuven ane ambara thaj tumaro Dad ko nebo parvarol len. Naj li sen tumen po vredna lendar? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />A šaj li neko tumendar golesa so brinil pe te baravol po džuvdipe bašo jekh đive?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />Thaj sose brinin tumen šejenđe? Dićhen šukar e luluđa ko polje sar baron. Khanči ni ćeren thaj ni suven šeja. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />A vaćarav tumenđe kaj ni o Solomon ani pi slava ni inđarda gija lačhe šeja sar kala luluđa. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />A ako o Dol uravol e biljke ko polje, so avđive si gothe, a theara ani kubava čhuden pe, kobor tek tumen ka uravol? Sose gaći zala pačan? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />Golese, ma vaćaren ki dar: ‘So ka xa?’ il ‘So ka pija?’ il ‘So ka urava?’ <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Gija roden e manuša save ni džanen e Devlese, a tumaro Dad ano nebo džanol kaj sa kava trubul tumenđe. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Golese angleder tare sa roden o Carstvo thaj o pravednost e Devleso thaj o Dol sa kava ka dol tumen.<verse eid="MAT 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 6:34" />Ma brinin tumen e thearaće, i thearin nek brinil pe pese. Avđivesutni muka si dovoljno za avđive.”<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">O Isus sikavol amen te ma sudi averen</para>
  <para style="r">(<ref loc="LUK 6:37-38">Lk 6,37–38</ref>, <ref loc="LUK 6:41-42">41–42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />A o Isus vadži vaćarda: “Ma sudin, te ma aven sudime. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Golese so o Dol ka sudil tumen sar so tumen sudin averen. Thaj save merasa ka merin averen, gasava merasa tumen ka meril o Dol.<verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />Sose dićhe i treska ane će phralesi jakh, a o kaš ani ćiri jakh ni dićhe? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Thaj sar šaj vaćare će phralese: ‘Ačh te ikalav i treska tar ćiri jakh’, a dikh, ćiro kaš ani jakh si po baro. <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Dujemujengo! Ikal angleder ćiro kaš andari ćiri jakh, tegani po šukar ka dićhe te ikale će phralese i treska andari jakh.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />Ma den o svetipe e džuklenđe, golese so e džukle ka irin pe, pa ka pharaven tumen ke kotora! Thaj ma čhuden e bisera angle bale, te ma uštaven len.”<verse eid="MAT 7:6" /></para>
  <para style="s">O Isus sikavol kaj o Dol odgovoril ke molitve</para>
  <para style="r">(<ref loc="LUK 11:9-13">Lk 11,9–13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />O Isus vadži vaćarda: “Manđen thaj ka dol pe tumenđe! Roden thaj ka araćhen! Maren thaj ka putavol tumenđe! <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Golese so savore save manđen, dol pe lenđe, save roden araćhen, save maren, putavol pe lenđe.<verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />Ko tumendar pe čhavese ka dol bar kana bi rodola mangro? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />A te manglja mačhe dal ka dol le sape? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Kana tumen, bišukar manuša, džanen šukaripe te den tumare čhaven, kobor tumaro Dad savo si ko nebo ka dol šukaripe pobut kolenđe save manđen lestar.”<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />“Gija, sa so manđen e manuša te ćeren tumenđe, tumen ćeren lenđe, golese so gova si o sikajipe tare sa e Mojsijaso zakon thaj e lila save pisisade e prorokura.”<verse eid="MAT 7:12" /></para>
  <para style="s">O Isus sikavol kaj o drom dži o nebo si pharo</para>
  <para style="r">(<ref loc="LUK 13:24">Lk 13,24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />O Isus vadži vaćarda: “Den ko tesno vudar! Golese so o bulo vudar thaj o bulo drom inđarol ano propast thaj but džene džan gole dromesa. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />But si tesno o vudar thaj o drom savo inđarol ano džuvdipe thaj zala si gola save araćhen le!”<verse eid="MAT 7:14" /></para>
  <para style="s">O Isus sikavol sar te pindžara e xoxavne prorokuren</para>
  <para style="r">(<ref loc="LUK 6:43-44">Lk 6,43–44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />O Isus vadži vaćarda: “Araćhen tumen tare xoxavne prorokura, save aven urade ane bakresi morčhi, al andral ane ile si divlja ruva save manđen te xan tumen. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Palo lengo bijanipe ka pindžaren len. Dal tare kangre šaj ćide drakha il tare čičke šaj ćide smokve? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Ke gasavo način e lačhe kašta bijanen lačho bijanipe, a e bilačhe kašta bijanen bilačho bijanipe. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Našti e šukar kašta te bijanen bilačho bijanipe thaj bilačhe kašta te bijanen lačho bijanipe. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Gija, sa e kašta save ni bijanen lačho bijanipe, čhinen pe thaj čhuden pe ani jag. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Gijate, pale lengo bijanipe ka pindžaren e xoxavne prorokuren.”<verse eid="MAT 7:20" /></para>
  <para style="s">O Isus sikavol kaj si o nebesko Carstvo baše poslušna sikade</para>
  <para style="r">(<ref loc="LUK 13:25-27">Lk 13,25–27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />O Isus vadži vaćarda: “Ni ka dol dži jekh savo vaćarol ‘Gospode, Gospode’, ano Carstvo e neboso, nego ka den samo kola save šunen thaj ćeren o manglipe me Dadeso. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />But ka vaćaren ane gova đive ko sudo: ‘Gospode, Gospode! Na li ane ćo alav prorokuisadam? Ćire alavesa e benđen ikaldam thaj ćire alavesa but čuda ćerdam?’ <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />I tegani me ka phenav lenđe: ‘Nikad ni džangljem tumen. Džan mandar tumen save phađen e Devleso zakon.’”<verse eid="MAT 7:23" /></para>
  <para style="s">O Isus vaćarol tare duj manuša save ćeren ćhera</para>
  <para style="r">(<ref loc="LUK 6:47-49">Lk 6,47–49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />O Isus vadži vaćarda: “Golese, dži jekh savo šunol kala mingre lafura thaj ćerol len, vov si but džanglo, sar manuš savo ćerol po ćher ko temelji taro bar. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Golese kana perol o bršnd thaj aven e paja thaj phurden e balvalja thaj čalaven ane gova ćher, vov ni perol, golese so si o temelji po bar. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />A dži jekh savo šunol kala mingre lafura, a ni ćerol len, vov si sar dilo manuš, savo ćerol po ćher pi pošik. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Golese kana perol o bršnd thaj aven e paja thaj phurden e balvalja thaj čalaven ane gova ćher thaj o ćher perol dži ko temelji.”<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Kana završisada kava vaćaripe o Isus, but manuša čudisajle so šunde leso sikajipe, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />golese so sikada sar kova savo isi le zuralipe, a na sar e učitelja tare Mojsijaso zakon.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">O Isus sastarol e gubavco</para>
  <para style="r">(<ref loc="MRK 1:40-45">Mk 1,40–45</ref>; <ref loc="LUK 5:12-16">Lk 5,12–16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />A kana o Isus ulilo taro brego, pale leste phirena but manuša.<verse eid="MAT 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 8:2" />Tari jekh drom o gubavo manuš avilo thaj pelo ke pe koča thaj vaćarda: “Gospode! Ako manđe, šaj te sastare man!”<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />O Isus vazdija po va, dolda le thaj phenda: “Mangav. Av thodo!” Thaj o manuš sigate thodilo tari guba.<verse eid="MAT 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 8:4" />Tegani vaćarda lese o Isus: “Dikh te ma vaćare khanikase, nego tu dža i sikav tut e sveštenikose. Inđar žrtva sar so zapovedisada o Mojsije ano zakon bašo ćiro thodipe, te bi avola tut svedočanstvo angle lende.”<verse eid="MAT 8:4" /></para>
  <para style="s">O kapetano sikavol pozuralo pačajipe ano Isus</para>
  <para style="r">(<ref loc="LUK 7:1-10">Lk 7,1–10</ref>; <ref loc="JHN 4:43-54">Jn 4,43–54</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />A kana o Isus avilo ano Kafarnaum, avilo paše leste jekh rimsko kapetano thaj rodija lestar pomoć. <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />Vaćarda lese: “Gospode, mo sluga pašljol paralizovano ćhere thaj but mučil pe!”<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />A o Isus phenda lese: “Me ka avav te sastarav le.”<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Thaj o kapetano vaćarda: “Gospode! Naj sem dostojno te ave tali mi streja. Samo vaćar jekh lafi thaj mo sluga ka sastol. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Golese so sem i me manuš tale nekaso autoritet thaj isi man tale mande vojnikura. Kana vaćarav jekhese: ‘Dža’, thaj džal. Kana vaćarav dujtonese: ‘Av’, thaj avol. Kana vaćarav mingre slugase: ‘Ćer’, thaj vov ćerol gova.”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />A kana o Isus šunda kava, čudisajlo taro kapetano thaj vaćarda kolenđe so džana pale leste: “Čače vaćarav tumenđe, ni arakhljem nijekhe ano Izrael kas isi gaći pačajipe. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />A vaćarav tumenđe, kaj but manuša taro sa o sveto, taro istok thaj taro zapad, ka aven thaj ka bešen ko astali ki bari gozba e Avraamesa, e Isaakosa thaj e Jakovesa ano Carstvo e neboso, <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />a e čhave taro Carstvo ka aven čhudime avral thaj dur ano embaro mrako, gothe but ka roven thaj ka škripin dandencar.”<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />E kapetanose vaćarda o Isus: “Dža! Nek avol gija sar pačajan!” Thaj o sluga e kapetanoso ane gova sato sastilo.<verse eid="MAT 8:13" /></para>
  <para style="s">O Isus sastarol bute dženen</para>
  <para style="r">(<ref loc="MRK 1:29-34">Mk 1,29–34</ref>; <ref loc="LUK 4:38-41">Lk 4,38–41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Thaj kana avilo o Isus ano ćher e Petreso, dikhlja e Petrese sasuja sar pašljol thaj tresil la i groznica. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />O Isus dolda la taro va thaj tari jekh drom e Petrese sasuja i jag mukhlja. Voj uštili thaj služisada e Isuse.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />A kana peli i rat, anglo Isus ande pherdo manušen ane kaste sesa e bilačhe duxura. A vov pe lafesa tradija e bilačhe duxuren thaj sastarda sa e nasvalen, <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />te pherdol kova so vaćarda o proroko Isaija:</para>
  <para style="q1" vid="MAT 8:17">“Vov e slabostura amare lija</para>
  <para style="q1" vid="MAT 8:17">thaj sa amaro nasvalipe inđarda.”<verse eid="MAT 8:17" /></para>
  <para style="s">O Isus sikavol kobor si pharo te džal pe lese dromesa</para>
  <para style="r">(<ref loc="LUK 9:57-62">Lk 9,57–62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Thaj kana dikhlja bute manušen paše peste, o Isus vaćarda pe sikadenđe te naćhen ki aver rig taro jezero.<verse eid="MAT 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 8:19" />Thaj avilo jekh učitelji taro Mojsijaso zakon thaj phenda: “Učitelju, ka džav tusa kaj tu ka dža.”<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Thaj o Isus vaćarda lese: “E lisicen isi jazbine thaj e čiriklja e nebeska isi len gnezdura: Me o Čhavo e manušeso naj man kaj mo šoro te pašljarav.”<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />A jekh aver sikado vaćarda lese: “Gospode! Mukh ma angleder te džav te prahov me dade.”<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />A o Isus vaćarda lese: “Av pale mande, a ačhav e mule, nek prahon pe mulen!”<verse eid="MAT 8:22" /></para>
  <para style="s">O Isus ačhavol i bari balval</para>
  <para style="r">(<ref loc="MRK 4:35-41">Mk 4,35–41</ref>; <ref loc="LUK 8:22-25">Lk 8,22–25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Tegani đelo o Isus ano čamco thaj pale leste đele lese sikade. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Bari balval tari jekh drom phurdija ko jezero thaj e talasura pherde o čamco pajesa. A o Isus suta.<verse eid="MAT 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 8:25" />A e sikade avile paše leste, vazdije le taro sojipe thaj vaćarde lese: “Gospode! Ikal amen! Ka tasiva!”<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />O Isus vaćarda lenđe: “Sose but daraljen, sose gaći zala pačan?” Tegani uštilo thaj naredisada e balvaljaće thaj e pajenđe thaj avilo baro bišundipe.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />A e manuša čudisajle thaj vaćarde: “Savo si kava so šunen le e balvalja thaj e paja?”<verse eid="MAT 8:27" /></para>
  <para style="s">O Isus sastarol duje manušen, ane kaste si e benga</para>
  <para style="r">(<ref loc="MRK 5:1-20">Mk 5,1–20</ref>; <ref loc="LUK 8:26-39">Lk 8,26–39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />A kana avilo ki aver rig e jezerosi ani phuv i gadarinsko, arakhlje e Isuse duj manuša ane kaste sesa e bilačhe duxura, save ikljona andare limora. Sesa gaći opasna te naštine khoni te naćhol gole dromestar. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Gola duj džene dije vika: “So manđe amendar, Čhaveja e Devleso? Akari aviljan angleder o vreme te muči amen?”<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />A po dur lendar čarona pherdo bale. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Thaj e benga molisade e Isuse vaćarindoj: “Te tradijan amen, bičhal amen ane kola pherdo bale.”<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />A o Isus vaćarda lenđe: “Džan!”</para>
  <para style="m" vid="MAT 8:32">Thaj e benga iklile tare kala duj džene thaj đele ane bale. Thaj tari jekh drom sa e bale taro brego čhudije pe ano jezero thaj sa tasile. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />A e manuša save araćhena e balen našle, avile ano foro thaj vaćarde sa so dikhlje odori thaj so sasa e manušencar ane save sesa e bilačhe duxura. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Thaj savore andaro foro avile pašo Isus, pa kana dikhlje le, molisade le te džal andaro lengo than.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">O Isus sastarol e manuše savo našti phirol</para>
  <para style="r">(<ref loc="MRK 2:1-12">Mk 2,1–12</ref>; <ref loc="LUK 5:17-26">Lk 5,17–26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Tegani o Isus dija ano čamco thaj nakhlo ki aver rig e jezerosi thaj irisajlo ane piro foro. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Tegani nesave murša ande anglo Isus e manuše savo pašljola, golese so naštine te phirol.</para>
  <para style="m" vid="MAT 9:2">Thaj kana dikhlja o Isus lengo pačajipe, vaćarda e manušese savo pašljol: “Ma dara, mo čhavo, oprostin pe će grehura.”<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Tegani nesave učitelja tare Mojsijaso zakon vaćarde ane peste: “Kava manuš hulil po Dol.”<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />O Isus džanglja so mislin thaj vaćarda lenđe: “Sose mislin bilačhe ane tumare ile? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Gija, so si polokho te phenol pe: ‘Oprostime si ćire grehura’, il te phenol pe: ‘Ušti thaj phir’? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Ka sikavav tumenđe mi zor, te džanen kaj isi man vlast, me o Čhavo e manušeso, ki phuv te oprostiv e grehura.” Irisajlo premalo manuš savo našti phirol thaj phenda lese: “Ušti, le ćo than kaj pašljiljan thaj dža tuće ćhere.” <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Thaj o manuš savo naštine te phirol uštilo thaj đelo pese ćhere. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />A kana gova dikhlje e manuša, but darajle thaj lije te hvalin e Devle, so dija gasavo vlast e manušenđe.<verse eid="MAT 9:8" /></para>
  <para style="s">O Isus akharol e Mateje</para>
  <para style="r">(<ref loc="MRK 2:13-17">Mk 2,13–17</ref>; <ref loc="LUK 5:27-32">Lk 5,27–32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Sar đelo o Isus gothar, dikhlja jekhe manuše sar bešlo ki carina, kaso alav sasa Matej thaj vaćarda lese: “Av pale mande!” O Matej uštilo thaj đelo pale leste.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Thaj kana o Isus xalja mangro ano ćher e Matejeso, but carincura thaj grešnikura avile thaj xalje mangro e Isusesa thaj lese sikadencar.<verse eid="MAT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 9:11" />Kana gova dikhlje e fariseja vaćarde lese sikadenđe: “Sose tumaro učitelji xal e carincurencar thaj e grešnikurencar?”<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />A o Isus šunda gova thaj vaćarda: “Ni trubul e sastenđe doktori, al e nasvalenđe trubul. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Nego dićhen te sikljon so značil: ‘O milosrđe mangav a na samo žrtva.’ Golese, ni aviljem te akharav e pravednikuren nego e grešnikuren.”<verse eid="MAT 9:13" /></para>
  <para style="s">O Isus sikavol taro post</para>
  <para style="r">(<ref loc="MRK 2:18-22">Mk 2,18–22</ref>; <ref loc="LUK 5:33-39">Lk 5,33–39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Tegani avile e Jovanese e Krstiteljese sikade pašo Isus thaj pučlje: “Sose ćire sikade ni postin sar so posti amen thaj e fariseja?”<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />O Isus lenđe vaćarda: “Šaj li kola so avile ko abav te aven žalna kana si lencar o džamutro? Al ka avol o đive kana ka len lendar e džamutre thaj tegani ka postin. <verse eid="MAT 9:15" /><verse number="16" style="v" sid="MAT 9:16" />Khoni ni suvol nevo kotor e šejengo te učharol i rupa ko purano fostano. Golese so ka ćidol pe kana ka thovol pe thaj pobari rupa ka avol pale gova. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Thaj khoni ni čhorol nevi mol ane purane mehura, golese so e mehura ka pharadon a i mol ka čhordol. Nego nevi mol čhuvol pe ane neve mehura i gija i mol thaj e mehura ka araćhen pe.”<verse eid="MAT 9:17" /></para>
  <para style="s">O Jair thaj i džuvli tare savi thavdol rat</para>
  <para style="r">(<ref loc="MRK 5:21-43">Mk 5,21–43</ref>; <ref loc="LUK 8:40-56">Lk 8,40–56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Dok gija o Isus vaćarda lencar, jekh šorutno e sinagogako avilo paše leste thaj pelo ke pe koča thaj vaćarda lese: “Mi čhej akana muli, al tu av, čhuv ćo va pe late thaj voj ka avol džuvdi.”<verse eid="MAT 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19" />Tegani uštilo o Isus thaj đelo palo šorutno pe sikadencar.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />A nesavi džuvli savi dešuduj (12) berš sasa nasvali taro thavdipe o rat, nakhli pale Isuseso dumo thaj dolda le taro teluno kotor taro fostano. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Golese so vaćarda ane peste: “Samo te dolav man pe leso fostano, ka sastivav.”<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />A o Isus irisajlo, dikhlja e džuvlja thaj vaćarda laće: “Ma dara, mi čhej, ćo pačajipe sastarda tut.”</para>
  <para style="m" vid="MAT 9:22">Thaj i džuvli sastili ane gova sato.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Kana avilo o Isus ane šorutneso ćher, dikhlja e bašalnen thaj e manušen save den vika zurale. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Thaj vaćarda: “Crden tumen! Golese so i čhejori ni muli, nego sovol.”</para>
  <para style="m" vid="MAT 9:24">Al von marde muj lesa.<verse eid="MAT 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 9:25" />Kana tradija e manušen avral, o Isus đelo andre, dolda la taro va thaj voj uštili. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />A tare gova so sasa šundilo o lafi ani sa goja phuv.<verse eid="MAT 9:26" /></para>
  <para style="s">O Isus sastarol duje kore manušen</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Kana o Isus đelo gothar, pale leste đele duj kore manuša thaj dije vika: “Smilui tu pe amende, Čhaveja e Davideso!”<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />A kana avilo ano ćher, avile paše leste e kore thaj pučlja len o Isus: “Pačan li kaj me šaj te ćerav gova?”</para>
  <para style="m" vid="MAT 9:28">A von vaćarde lese: “Va, Gospode.”<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Tegani dolda lenđe jakha thaj vaćarda: “Palo tumaro pačajipe nek avol tumenđe!”<verse eid="MAT 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 9:30" />Thaj putajle lenđe jakha.</para>
  <para style="m" vid="MAT 9:30">Thaj o Isus zurale pretisada len: “Dićhen te ma vaćaren khanikase.”<verse eid="MAT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 9:31" />Al von kana iklile, vaćarde savorenđe ani sa goja phuv.<verse eid="MAT 9:31" /></para>
  <para style="s">O Isus sastarol e lalore</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Kana von iklile, ande anglo Isus manuše lalore ane savo sasa o bilačho duxo. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Thaj o Isus ikalda e benđe, tegani lija te vaćarol o laloro. Thaj but džene sesa oduševime thaj vaćarde: “Kava ni dikhljam vadži ano Izrael.”<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />A e fariseja vaćarena: “Vov tradol e benđen ano pomoć e šorutnesa tare benga.”<verse eid="MAT 9:34" /></para>
  <para style="s">O Isus dićhol e manušen ani potreba</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />O Isus đelo pe sa e forura thaj e gava thaj sikada e manušen ane lenđe sinagoge. Sikada taro Lačho Lafi taro Carstvo thaj sastarda tare svako nasvalipe thaj bizuralipe ane manuša. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />A kana dićhola e manušen sasa le žal lenđe, golese so sesa hasarde thaj mukhle sar bakre bizo pastiri. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Tegani vaćarda pe sikadenđe: “Ćidipe si but baro al bućarne si zala. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Molin tumen e gospodarese taro ćidipe te bičhalol bute bućarnen ke piro ćidipe.”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">O Isus bičhalol e dešudujen</para>
  <para style="r">(<ref loc="MRK 3:13-19">Mk 3,13–19</ref>; <ref loc="MRK 6:7-13">6,7–13</ref>; <ref loc="LUK 6:12-16">Lk 6,12–16</ref>; <ref loc="LUK 9:1-6">9,1–6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />O Isus dija vika pe dešuduje (12) sikaden thaj dija len zuralipe te traden e bilačhe duxuren, te sastaren sa o nasvalipe thaj sa o bizuralipe.<verse eid="MAT 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2" />A kava si e alava tare dešuduj apostolura:</para>
  <para style="li1" vid="MAT 10:2">Angluno o Simon savo akharol pe Petar</para>
  <para style="li1" vid="MAT 10:2">thaj o Andrija leso phral,</para>
  <para style="li1" vid="MAT 10:2">o Jakov e Zevedejeso čhavo</para>
  <para style="li1" vid="MAT 10:2">thaj leso phral o Jovan,<verse eid="MAT 10:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="MAT 10:3" />o Filip</para>
  <para style="li1" vid="MAT 10:3">thaj o Vartolomej,</para>
  <para style="li1" vid="MAT 10:3">o Toma</para>
  <para style="li1" vid="MAT 10:3">thaj o Matej o carinco,</para>
  <para style="li1" vid="MAT 10:3">o Jakov e Alfejeso čhavo</para>
  <para style="li1" vid="MAT 10:3">thaj o Tadej,<verse eid="MAT 10:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="MAT 10:4" />o Simon o Zilot</para>
  <para style="li1" vid="MAT 10:4">thaj o Juda o Iskariotsko, so izdajisada e Isuse.<verse eid="MAT 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Bičhalda o Isus kale dešudujen sikaden thaj naredisada lenđe: “Ma džan ke abandžije thaj ma džan ane nijekh Samarijansko foro. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Nego džan ke hasarde bakre tare Izraelska manuša. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Džan thaj propovedin: ‘Sigate avol o Carstvo e neboso.’ <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />E nasvalen sastaren, e mulen vazden, e gubavonen thoven, e benđen traden. Badava dobisaden, badava den. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Ma inđaren tumencar ni zlatna, ni srebrna, ni bakarna parave ane tumare kuštika, <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />ni trasta ko drom, ni dujto gad ni duj para sandale, ni rovli, golese so si o bućarno dostojno pe plataće.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />Ane savo foro il gav aven, roden ko ka primil tumen, gothe ačhen sa dži kaj ni džan tar gova than. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />A kana džan ano ćher, vaćaren: ‘Mir kale ćhereste.’ <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Thaj te primisade tumen, ka avol tumaro mir ane gova ćher. Te ni primisade tumen, o mir tumaro ka iril pe tumenđe. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />A kaj ni manđen tumen, niti šunen tumen so phenen lenđe, ikljen taro gova ćher il foro em tresin o praho tare tumare pingre, te ma bi avola tumen khanči lencar. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Čače vaćarav tumenđe, ko Sudnjo đive polokho ka avol e manušenđe ani Sodoma thaj ani Gomora nego e manušenđe ane thana save ni šunde tumen!”<verse eid="MAT 10:15" /></para>
  <para style="s">O Isus vaćarol tare progonstvura</para>
  <para style="r">(<ref loc="MRK 13:9-13">Mk 13,9–13</ref>; <ref loc="LUK 21:12-17">Lk 21,12–17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />O Isus vadži vaćarda: “Dićhen, me bičhalav tumen sar bakren maškare ruva. Golese aven but džangle sar sapa, a birumime sar o golubo. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Araćhen tumen, golese so nesave manuša ka den tumen ke sudura thaj ke sinagoge ka aven bičujime. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Baše mande ka ikalen tumen angle vladara thaj angle carura te bi svedočina lenđe thaj kolenđe save si abandžije. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />A kana ka phanden tumen, ma daran tegani sar thaj so ka vaćaren, golese so ane gova sato ka dol pe tumenđe so te vaćaren. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Golese so tumen ni ka vaćaren, nego ka vaćarol andar tumende o Duxo tumare Dadeso savo si ko nebo!<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />O phral e phrale ka dol te mudarol pe thaj o dad e čhave. E čhave ka ušten pe dada thaj pe deja, a von ka den te mudaren len. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Thaj khoni ni ka manđol tumen me alavese, a ko ačhol dži ko krajo pačavno, ka spasil pe. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Thaj kana traden tumen ane jekh foro, našen ane aver! Golese so vaćarav tumenđe čače: Ni ka resen te ćeren tumari bući ane sa e forura ano Izrael dok ni avav me, o Čhavo e manušeso.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />Nijekh sikado naj po baro tare po učitelji, ni sluga upreder po gospodari. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Dosta si e sikadese te avol sar po učitelji thaj o sluga sar po gospodari. Kana man e šorutne e ćhereso akharen ‘Veelzevul’<note caller="+" style="f"><char style="fr" closed="false">10,25 </char><char style="ft" closed="false">Satana</char></note>, kobor po bilačhe ka akharen tumen, mingre ćherutnen?”<verse eid="MAT 10:25" /></para>
  <para style="s">Kastar trubul te daral pe</para>
  <para style="r">(<ref loc="LUK 12:2-7">Lk 12,2–7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />O Isus vadži vaćarda: “Ma daran tare manuša, golese so naj gova so si garado a so ni ka avol putardo thaj naj gova so si čorale so ni ka šundol. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />So vaćarav tumenđe ano mrako, vaćaren ano svetlo. Thaj so vaćarav tumenđe po zala ko kan, tumen vaćaren zurale pe krovura. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Ma daran kolendar so mudaren o telo a i duša našti mudaren. Daran kolestar sostar šaj i duša thaj o telo te uništil pe ani jag savi ni ačhol. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Ni li bićindol i čirikli emcikne paraće? Thaj nijekh našti perol ki phuv bizo dopuštenje tumare Dadeso savo si ko nebo. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />A tumare sa e bala ko šoro si đinde. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Ma daran, golese so sen tumen but po vredna tare čiriklja.”<verse eid="MAT 10:31" /></para>
  <para style="s">E sikade ka priznajin e Isuse angle manuša</para>
  <para style="r">(<ref loc="LUK 12:8-9">Lk 12,8–9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />O Isus vadži vaćarda: “Gija, ko man priznajil angle manuša kate ki phuv, me ka priznajiv le anglo mo Dad savo si ano nebo. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />A ko odreknil pe mandar angle manuša kate ki phuv, me ka odrekniv man lestar anglo mo Dad savo si ko nebo.”<verse eid="MAT 10:33" /></para>
  <para style="s">Sar e manuša trubun te služin e Isuse</para>
  <para style="r">(<ref loc="LUK 12:51-53">Lk 12,51–53</ref>; <ref loc="LUK 14:26-27">14,26–27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />O Isus vadži vaćarda: “Ma te den gođi kaj me aviljem te anav mir ki phuv. Ni aviljem te anav mir nego mačo. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Aviljem te ulavav:</para>
  <para style="q1" vid="MAT 10:35">‘e manuše taro dad leso</para>
  <para style="q2" vid="MAT 10:35">thaj e čheja tari dej laći</para>
  <para style="q1" vid="MAT 10:35">thaj e bora tari sasuj laći.<verse eid="MAT 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 10:36" />E manušese dušmanura ka aven e ćherutne lese.’<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />Ko pobut manđol pe dade thaj pe da mandar, naj dostojno te avol mo sikado. Thaj ko manđol pe čhave il pe čheja pobut mandar, naj dostojno te avol mo sikado. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Ko ni lol po krsto i ni džal pale mande, naj dostojno te avol mo sikado. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Ko manđol te araćhol piro džuvdipe, ka hasarol le, al ko hasarol piro džuvdipe baše mande, ka araćhol le.”<verse eid="MAT 10:39" /></para>
  <para style="s">Nagrada kolenđe so primin e sikaden</para>
  <para style="r">(<ref loc="MRK 9:41">Mk 9,41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />O Isus vadži vaćarda: “Ko tumen primil, man primil, a ko primil man, primil e Devle so man bičhalda. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Ko primil e proroko golese so si proroko, plata proročko ka primil. Ko primil e pravedniko golese so si pravedno, pravedničko plata ka primil. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Ko dol samo jekh tahtaj šudre pajesa emcikne manuše golese so si mingro sikado, čače vaćarav tumenđe, lesi nagrada ni ka hasardol.”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">O Isus thaj o Jovan o Krstitelj</para>
  <para style="r">(<ref loc="LUK 7:18-35">Lk 7,18–35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Kana o Isus završisada te sikavol pe dešuduje (12) sikaden, đelo gothar te sikavol thaj te vaćarol e Devleso Lafi ane forura e Galilejska.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />A kana o Jovan o Krstitelj sasa phanglo, šunda e Hristese buća thaj bičhalda pe sikaden <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />te pučen le: “Tu li san gova savo trubul te avol, il te ađućara avere?”<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />A o Isus vaćarda e Jovanese sikadenđe: “Džan i vaćaren e Jovanese so šunen thaj so dićhen: <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />‘E kore dićhen, e banđe phiren, e gubava thodon, e kašuće šunen, e mule ušten, a e čororenđe vaćarol pe o Lačho Lafi. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Blago kolese savo ni sablaznil pe mandar!’ ”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />A kana e Jovanese sikade đele, lija o Isus te vaćarol e manušenđe taro Jovane: “So ikliljen te dićhen ki pustinja? I trska, savi banđol ki balval? Na. <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Il so ikliljen te dićhen? Manuše savo urado ane barvale šeja. Na, kola save inđaren barvale šeja bešen ke carska ćhera. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Il so ikliljen te dićhen? E proroko? Va, me vaćarav tumenđe, pobut taro proroko. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Golese so si o Jovane manuš kastar o Dol vaćarda ane piro Sveto lil:</para>
  <para style="q1" vid="MAT 11:10">‘Akh, me bičhalav angle tute me glasniko,</para>
  <para style="q2" vid="MAT 11:10">savo ka pripremil tuće o drom.’<verse eid="MAT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11" />Čače vaćarav tumenđe: nijekh maškare sa save si bijande naj po baro taro Jovane o Krstitelj, a emcikno ano Carstvo e neboso si po baro lestar! <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />A taro vreme e Jovaneso e Krstiteljeso dži akana, o Carstvo e neboso trpil nasilje thaj e nasilna manuša grabin te len le. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Golese so sa e prorokura thaj e Mojsijaso zakon prorokujisade taro Carstvo dži o Jovane. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Thaj te mangljen te pačan, vov si kova Ilija savo trubuja te avol. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Kas isi kana te šunol nek šunol.”<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />“A kasa te uporediv e avđivesutne manušen? Von si sar čhavore save bešen ko trgo e foroso thaj den vika jekh avere:<verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />‘Bašaldam tumenđe vesela đilja,</para>
  <para style="q2" vid="MAT 11:17">a tumen ni ćhelden.</para>
  <para style="q1" vid="MAT 11:17">Đilabijam tumenđe žalna đilja,</para>
  <para style="q2" vid="MAT 11:17">a tumen ni rujen.’<verse eid="MAT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 11:18" />Golese so, avilo o Jovane, savo ni xalja thaj ni pilja sar avera, a von vaćaren: ‘O beng si ane leste.’ <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Tegani aviljem me, o Čhavo e manušeso, savo xav thaj pijav sar sa avera, a tumen vaćaren: ‘Dikh manuš xalano thaj mato! Amal e carincurengo thaj avere grešnikurengo!’ Al e Devleso mudrost ka opravdilpe pe bućencar.”<verse eid="MAT 11:19" /></para>
  <para style="s">O Isus koril e bipačavnen</para>
  <para style="r">(<ref loc="LUK 10:13-15">Lk 10,13–15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Tegani lija o Isus te koril e manušen ane forura ane save ćerda embare čudura, golese so von ni pokaisajle: <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />“Pharo tumenđe manušalen taro Horazin! Pharo tumenđe manušalen, tari Vitsaida! Golese so te avena gasave čudesura e Tirose thaj e Sidonese manušenđe sar ke tumende, odavno bi pokajina pe thaj bi uravena pe ane pokajnička šeja thaj pe po šoro bi čhorena pese praho bašo pokajipe. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />A vaćarav tumenđe, polokho ka avol e manušenđe taro Tir thaj e manušenđe taro Sidon ko đive e bare sudose nego tumenđe. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />A tumen manušalen taro Kafarnaum! Dži o nebo li ka ušten? Na! Dži o than kaj si e mule ka peren. Golese te avena gaći čudura ani Sodoma kobor sesa maškar tumende thaj von bi pokajina pe, pa bi ačhola i Sodoma sa dži avđive. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />A vaćarav tumenđe kaj polokho ka avol e manušenđe tari phuv i Sodoma ko đive e bare sudose nego tumenđe!”<verse eid="MAT 11:24" /></para>
  <para style="s">E Isusesi molitva thaj akhardipe</para>
  <para style="r">(<ref loc="LUK 10:21-22">Lk 10,21–22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Ane gova vreme vaćarola o Isus: “Hvaliv tut, Dade, Gospode taro nebo thaj tari phuv, so kava garadan tare but gođavera thaj tare haljarde a sikadan gova e ciknenđe. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Va, Dade, gova sasa ćiro manglipe te ćere gija.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />Manđe mo Dad dija sa. Khoni ni džanol e Čhave dži o Dad, ni e Dade ni džanol khoni dži o Čhavo thaj kase o Čhavo manđol te sikadol.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />Aven mande savore save sen umorna thaj tovarime, me ka odmoriv tumen. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Len mingro jaram pe tumende thaj sikljon mandar golese so sem kovlo thaj ponizno ano ilo thaj ka araćhen mir ane tumare duše. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Golese so mingro jaram si lokho thaj mo pharipe naj pharo.”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">O Isus isi le vlast po savato</para>
  <para style="r">(<ref loc="MRK 2:23-28">Mk 2,23–28</ref>; <ref loc="LUK 6:1-5">Lk 6,1–5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Ane gova vreme phirola o Isus pe sikadencar ko savato maškaro điv, a lese sikade bokhajle thaj lije te čhinen o điv thaj te xan.<verse eid="MAT 12:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 12:2" />A nesave fariseja dikhlje gova thaj vaćarde lese: “Dićhe, e sikade ćire ćeren so naj dozvolimo ko savato!”<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />A o Isus vaćarda lenđe: “Džanav kaj čitisaden so ćerda o David, kana bokhajlo vov thaj lese amala. <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Kana đelo andre ano Ćher e Devleso, e mangre save čhuvena pe sar žrtva von xalje, a ni sasa šukar te xan ni vov ni kola so sesa lesa. Gola mangre šajine te xan samo e sveštenikura. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Džanav kaj čitisaden ane Mojsijaso zakon so e sveštenikura ano Hram o savato savo si sveto phađen, gija so služin ane gova đive a palem naj banđe. <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Me vaćarav tumenđe kaj si kate kova savo si po baro taro Hram! <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Kana bi samo džanena so si gova: ‘O milosrđe mangav a na samo žrtva’, nikad ne bi osudina kolen save naj grešna. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Golese so man, e Čhave e manušese, isi vlast po savato.”<verse eid="MAT 12:8" /></para>
  <para style="s">O Isus sastarol ko savato</para>
  <para style="r">(<ref loc="MRK 3:1-6">Mk 3,1–6</ref>; <ref loc="LUK 6:6-11">Lk 6,6–11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Pale gova đelo o Isus gothar thaj avilo ane lenđi sinagoga. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />A sasa gothe manuš šuće vastesa.</para>
  <para style="m" vid="MAT 12:10">E fariseja pučlje e Isuse: “Šaj li ko savato te sastarol pe?” Gija von rodije khanči te tužin e Isuse.<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />A vov vaćarda lenđe: “Savo tumendar ako isi le jekh bakri pa ako voj ko savato perol ani rupa ni ka lol te ikalol la? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />A kobor si o manuš po baro taro bakro! Gija si mukhlo ko savato šukar te ćerol pe.”<verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />Tegani o Isus vaćarda gole manušese: “Pruži ćiro va!”</para>
  <para style="m" vid="MAT 12:13">I vov pružisada piro va thaj leso va sastilo sar o dujto va. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />A e fariseja iklile te dogovorin pe sar te mudaren le.<verse eid="MAT 12:14" /></para>
  <para style="s">O Isus si e Devleso birime sluga</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />A o Isus gova dodžanglja thaj đelo gothar. Pale leste đele but manuša thaj e nasvalen maškar lende sastarda. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />A naredisada lenđe te ma vaćaren ko si vov. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Gija pherdilo kova so vaćarda o proroko o Isaija:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“Dikh, kava si mingro manglo Sluga,</para>
  <para style="q1" vid="MAT 12:18">save me birisadem.</para>
  <para style="q1" vid="MAT 12:18">Mingro manglo,</para>
  <para style="q1" vid="MAT 12:18">Vov si mo radujipe.</para>
  <para style="q1" vid="MAT 12:18">Mo Duxo ka čhuvav pe leste.</para>
  <para style="q1" vid="MAT 12:18">Vov ka objavil i pravda sa e manušenđe.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Ni ka ćerol čingara, ni ka vazdol po glaso,</para>
  <para style="q1" vid="MAT 12:19">ke droma khoni ni ka šunol leso glaso.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Ni uštadi trska ni ka phađol,</para>
  <para style="q1" vid="MAT 12:20">ni ka ačhavol o žaro savo pozala phabol,</para>
  <para style="q1" vid="MAT 12:20">sa dži kaj ni anol i pravda dži ki pobeda.<verse eid="MAT 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21" />Ane leso alav ka avol nada sa e manušenđe.”<verse eid="MAT 12:21" /></para>
  <para style="s">E Isuseso zuralipe si taro Dol</para>
  <para style="r">(<ref loc="MRK 3:20-30">Mk 3,20–30</ref>; <ref loc="LUK 11:14-23">Lk 11,14–23</ref>; <ref loc="LUK 12:10">12,10</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Tegani ande angle leste manuše ane kaste sasa bilačho duxo thaj gova manuš sasa koro thaj laloro. O Isus sastarda le, gija gova manuš lija te vaćarol thaj te dićhol. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Sa e manuša so gova dikhlje, sesa zadivime thaj pučlje pe: “Naj li gova o Čhavo e Davideso?”<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />A kana gova šunde e fariseja, vaćarde: “Kava tradol e benđe ano pomoć e Veelzevuleso, savo si šorutno tare bilačhe duxura.”<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />A o Isus džanglja so mislin thaj vaćarda: “Dži jekh carstvo savo ulavol pe korkoro pestar, ka ačhol pusto thaj svako foro il familija savi ulavol pe korkori pestar, ka properol. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Te o Satana tradol e Satane thaj korkoro pes ulavol, sar ka ačhol o carstvo leso? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Thaj čače, te Veelzevulesa tradav e benđen, kasa traden tumare čhave e benđen? Golese von ka aven sudije tumare. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Al ako li me e Devlese Duxosa tradav e benđen, tegani o Carstvo e neboso avilo maškar tumende.<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />Il sar šaj khoni te avol ano ćher e zurale manušese thaj te čorol leso barvalipe, te angleder ni phandol e zurale manuše? Thaj tegani sa andaro ćher šaj te čorol.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />Savo naj mancar, protiv mande si. Savo ni ćidol mancar, čhorol. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Golese vaćarav tumenđe, sa e grehura thaj i hula šaj oprostil pe e manušenđe, al i hula po Sveto Duxo ni ka oprostil pe e manušenđe. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Thaj savo vaćarol bilačho lafi po Čhavo e manušeso, šaj oprostil pe lese, a savo vaćarol bilačhe po Sveto Duxo ni ka oprostil pe lese, ni ke kava ni ko aver sveto.”<verse eid="MAT 12:32" /></para>
  <para style="s">O kaš thaj leso bijanipe</para>
  <para style="r">(<ref loc="LUK 6:43-45">Lk 6,43–45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />O Isus vadži vaćarda: “Sadi lačho kaš thaj leso bijanipe ka avol šukar thaj te sadisadan kaš bilačho, leso bijanipe ka avol bilačho. Golese so palo bijanipe pindžarol pe o kaš. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Tumen, e sapese čhave! Sar šaj te vaćaren šukar, kana sen bilačhe? Golese so o muj vaćarol sosa si pherdo o ilo. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Šukar manuš tari šukar riznica e ilesi ikalol šukaripe, a bilačho manuš tari bilačhi riznica e ilesi ikalol bilačhipe. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />A phenav tumenđe: e manuša, baše dži jekh bikorisno lafi savo vaćaren, ka den računo ko sudnjo Đive. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Čače, će lafesa ka ave opravdime il će lafura ka osudin tut.”<verse eid="MAT 12:37" /></para>
  <para style="s">E Jonaso znako</para>
  <para style="r">(<ref loc="MRK 8:11-12">Mk 8,11–12</ref>; <ref loc="LUK 11:29-32">Lk 11,29–32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Pale gova nesave učitelja tare Mojsijaso zakon thaj e fariseja vaćarde: “Učitelju! Amen manga te dikha tutar nesavo znako.”<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />A vov vaćarda lenđe: “O bilačho thaj preljubničko bijandipe rodol znako thaj ni ka dol pe aver znako samo o znako savo sasa e prorokose e Jonase. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Sar o Jona so sasa ano vođi e bare mačheso trin đive thaj trin raća, gija i me, o Čhavo e manušeso, ka avav ani phuv trin đive thaj trin raća. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />E murša tari Niniva ka ušten ko Sudo kale bijandimasa thaj ka osudin len, golese so pokaisajle kana šunde e Jonaso sikajipe. Thaj dikh, kate tumencar si po baro taro Jona! <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />I Carica taro Jug ka uštol ko Sudo kale bijandimasa thaj ka osudil len, golese so avili voj tari aver rig e phuvaći odural te šunol o mudrost e Solomoneso. Thaj dikh, kate tumencar si po baro taro Solomon!”<verse eid="MAT 12:42" /></para>
  <para style="s">O Isus upozoril o bipačavno bijandipe</para>
  <para style="r">(<ref loc="LUK 11:24-26">Lk 11,24–26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />“Kana o bilačho duxo ikljol andaro manuš, džal ke šuće thana te rodol than bašo odmor thaj ni araćhol le. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Tegani vaćarol: ‘Ka irima ano ćher kotar ikliljem.’ Kana avol, dićhol o ćher kaj si čučo, šulado thaj lačhardo. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Tegani o bilačho duxo džal thaj anol pesa efta averen duxuren po bilačhe pestar. Savore aven andre te bešen thaj e manušese kastar iklilo o bilačho duxo, akana si but po bilačhe nego so sasa lese. Gijate ka avol e bilačhe bijandimasa.”<verse eid="MAT 12:45" /></para>
  <para style="s">E Isusesi čačukani familija</para>
  <para style="r">(<ref loc="MRK 3:31-35">Mk 3,31–35</ref>; <ref loc="LUK 8:19-21">Lk 8,19–21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Dži kaj o Isus vaćarola e manušenđe, lesi dej thaj lese phrala avile, ačhile avral thaj manglje te vaćaren lesa.<verse eid="MAT 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 12:47" />Thaj khoni vaćarda lese: “Akh ći dej thaj će phrala ačhen avral. Manđen te vaćaren tusa.”<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />A vov vaćarda kolese so phenda lese: “Ko si mi dej? Ko si me phrala?”<verse eid="MAT 12:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 12:49" />Thaj sikada vastesa premal pe sikade thaj vaćarda: “Akh mi dej thaj me phrala. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Dži jekh savo ćerol o manglipe me Dadeso savo si ko nebo, vov si mo phral, mi phen thaj mi dej.”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">O Isus vaćarol taro manuš savo čhudol o seme ki phuv</para>
  <para style="r">(<ref loc="MRK 4:1-9">Mk 4,1–9</ref>; <ref loc="LUK 8:4-8">Lk 8,4–8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Ane gova đive iklilo o Isus taro ćher thaj bešlo pašo jezero te sikavol. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />But manuša ćidije pe paše leste, golese đelo ano čamco, bešlo a von ačhile ki obala. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Thaj but vaćarda lenđe ane paramiča sar kaja:</para>
  <para style="p" vid="MAT 13:3">“Dikh, iklilo o manuš savo sejil. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Thaj kana sejisada, nesave semenura pele ko drom, thaj avile e čiriklja thaj sa xalje len. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />A avera pele pe barale thana, kaj ni sasa but phuv thaj o seme sigate barilo, golese so ni sasa duboko phuv. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Thaj kana o kham sasa zuralo, i biljka phabili thaj šućili golese so ni sasa la duboko koreno. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Nesavo seme pelo ane kangre, al barile kangre thaj i biljka tasadili. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />A nesavo seme pelo ki šukar phuv thaj anda bijandipe savo sasa tranda (30), šovardeš (60) thaj šel (100) droma po baro taro kova so sejisade. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Kas isi kana te šunol nek šunol.”<verse eid="MAT 13:9" /></para>
  <para style="s">Sose o Isus vaćarol ane paramiča</para>
  <para style="r">(<ref loc="MRK 4:10-12">Mk 4,10–12</ref>; <ref loc="LUK 8:9-10">Lk 8,9–10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Tegani avile pašo Isus lese sikade thaj pučlje le: “Sose tu vaćare lenđe ane paramiča?”<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />A vov vaćarda: “Tumenđe dija pe te džanen so si garajipe taro Carstvo e neboso, a lenđe ni dija pe. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Golese, kas isi džanglipe ka dol pe lese thaj ka avol le pobut. A kas naj džanglipe, ka lol pe i kova so isi le. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Golese me vaćarav lenđe ane paramiča, golese so e manuša dićhen a ni dićhen thaj šunen a ni šunen thaj ni haljaren.<verse eid="MAT 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 13:14" />Thaj gija pherdol o proroštvo savo o Dol dija e Isaijase, savo vaćarol:</para>
  <para style="q1" vid="MAT 13:14">‘Ka šunen thaj ka šunen,</para>
  <para style="q2" vid="MAT 13:14">al ni ka haljaren,</para>
  <para style="q1" vid="MAT 13:14">ka dićhen thaj ka dićhen,</para>
  <para style="q2" vid="MAT 13:14">al ni ka shvatin.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Golese so zurajle e ile kale manušenđe,</para>
  <para style="q2" vid="MAT 13:15">phareste šunen pe kanencar,</para>
  <para style="q1" vid="MAT 13:15">thaj phanglje pe jakha,</para>
  <para style="q2" vid="MAT 13:15">te ni dićhen jakhencar,</para>
  <para style="q1" vid="MAT 13:15">thaj kanencar te ni šunen,</para>
  <para style="q2" vid="MAT 13:15">thaj ilesa te ni haljaren,</para>
  <para style="q1" vid="MAT 13:15">thaj te ni irin pe premal mande</para>
  <para style="q2" vid="MAT 13:15">te sastarav len.’<verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />A blago tumare jakhenđe golese so dićhen thaj tumare kanenđe so šunen. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Čače vaćarav tumenđe, but prorokura thaj čačutne sa e ilesa manglje te dićhen so tumen dićhen, a ni dikhlje thaj te šunen so tumen šunen, a ni šunde.<verse eid="MAT 13:17" /></para>
  <para style="s">O Isus sikavol i paramič taro seme</para>
  <para style="r">(<ref loc="MRK 4:13-20">Mk 4,13–20</ref>; <ref loc="LUK 8:11-15">Lk 8,11–15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />Šunen akana, so značil i paramič taro manuš savo sejil. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Kana khoni šunol o Lafi taro Carstvo thaj ni haljarol, avol o beng thaj čorol so si sejimo ano leso ilo. Gova si o seme so si po drom sejimo. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />A o seme savo si sejimo ko baralo than si gova savo šunol o Lafi e Devleso thaj sigate ano radujipe lol pese gova. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Al naj le koreno ane peste thaj ni ačhol but. Kana avol o bilačhipe il traden le bašo Lafi, sigate perol. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Kova seme savo si sejimo ane kangre si gova savo šunol o Lafi, al e brige kale svetose thaj o xoxaipe e barvalimaso tasaven o Lafi thaj ačhol bizo bijanipe. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />A o seme savo si sejimo ki lačhi phuv si gova savo šukar šunol o Lafi thaj haljarol le. Tegani čače anol šukar bijanipe a jekh seme anol po šel (100) semenura, nesavo seme anol po šovardeš (60) semenura thaj nesavo seme bijanol po tranda (30) semenura.”<verse eid="MAT 13:23" /></para>
  <para style="s">O Isus vaćarol i paramič taro điv thaj taro kukolj</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />O Isus vaćarda lenđe aver paramič: “O Carstvo e neboso si sar manuš savo sejisada lačho seme ane po polje. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />A kana e manuša sute, avilo leso dušmano, sejisada kukolj maškaro điv thaj đelo. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Kana barilo o điv thaj anda bijanipe, sikadilo thaj o kukolj. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Tegani avile e manuša save služin e manuše kaso sasa o polje thaj vaćarde lese: ‘Gospodarona, na li šukar seme tu sejisadan ani ćiri njiva? Kotar akana kukolj?’<verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />A vov vaćarda lenđe: ‘O dušmano gova ćerda.’</para>
  <para style="p" vid="MAT 13:28">A e manuša save služin vaćarde lese: ‘Manđe li akana te dža te ikala o kukolj?’<verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />A vov vaćarda: ‘Na, te ikalden o kukolj, šaj te ikalen o điv. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Ačhaven nek baron katane dži ko ćidipe thaj ko vreme e ćidimaso ka vaćarav kolenđe so ćiden: Ćiden angleder o kukolj thaj phanden le ke snopura te phabarav le, a o điv čhuven ano than kaj čhuvav mingro điv.’”<verse eid="MAT 13:30" /></para>
  <para style="s">O Isus vaćarol i paramič taro seme e gorušicako</para>
  <para style="r">(<ref loc="MRK 4:30-34">Mk 4,30–34</ref>; <ref loc="LUK 13:18-21">Lk 13,18–21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />O Isus vaćarda lenđe vadži jekh paramič: “O Carstvo e neboso si sar jekh seme tari gorušica, savo lol o manuš thaj sejil ki piri njiva. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />A vov si čače emcikno tare sa e semenura, al kana barol, po baro si tare sa e biljke ano vrt thaj kana ćerdol kaš, e čiriklja e nebose aven thaj ćeren gnezdura thaj bešen pe lese granke.”<verse eid="MAT 13:32" /></para>
  <para style="s">O Isus vaćarol i paramič taro kvasco</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Pale gova vaćarda vadži jekh paramič: “O Carstvo e neboso si sar kvasco savo lol i džuvli thaj čhuvol ane biš (20) kile aro sa dži kaj ni uštol o humer.”<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Sa kava o Isus vaćarola e manušenđe ane paramiča. Thaj bize paramiča khanči ni vaćarda lenđe. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Gijate pherdilo gova so o proroko vaćarda:</para>
  <para style="q1" vid="MAT 13:35">“Ka putrav ane paramiča mo muj,</para>
  <para style="q2" vid="MAT 13:35">ka vaćarav kova so si garado taro postanko e svetoso.”<verse eid="MAT 13:35" /></para>
  <para style="s">O Isus sikavol so si i paramič taro điv thaj o kukolj</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />O Isus ačhada e manušen thaj đelo ano ćher. Avile paše leste lese sikade thaj vaćarde: “Sikav amen so si i paramič taro kukolj ani njiva.”<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />A vov vaćarda lenđe: “Gova savo sejil lačho seme si o Čhavo e manušeso <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />thaj i njiva si o sveto. Lačho seme si e čhave e Devlese carstvose, a o kukolj si e čhave e benđese. <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />A o dušmano savo sejisada len si o beng, a o ćidipe si o kraj e svetoso, a kola so ćiden si e anđelura. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Sar o kukolj ćidol pe thaj jagasa phabarol pe, gija ka avol ko krajo e svetoso. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Me o Čhavo e manušeso ka bičhalav me anđeluren thaj von ka ćiden tare mingro Carstvo sa e manušen save čhuvena averen pe grehura thaj save phađena e Devleso zakon. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Thaj ka čhuden len ani jagali kubava. Thaj gothe but ka roven thaj ka škripin dandencar. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Tegani e pravedna manuša ka sijajin sar o kham ano Carstvo pe Dadeso. Kas isi kana nek šunol.”<verse eid="MAT 13:43" /></para>
  <para style="s">O Isus vaćarol i paramič taro garado barvalipe</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />O Isus vadži vaćarda: “O Carstvo e neboso si sar barvalipe garado ano polje. Kana o manuš arakhlja le, palem garada le thaj radosno džal thaj biknol sa so isi le te bi ćinola gova polje.”<verse eid="MAT 13:44" /></para>
  <para style="s">O Isus vaćarol i paramič taro manuš e biserencar</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />O Isus vaćarda: “Vadži si o Carstvo e neboso sar trgovco savo rodol šukar bisera. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Pa kana araćhol jekh but kuč biseri, džal sa biknol so isi le thaj ćinol le.”<verse eid="MAT 13:46" /></para>
  <para style="s">O Isus vaćarol i paramič tari mreža savasa dolen pe mačhe</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />O Isus vaćarda: “Vadži o Carstvo e neboso si sar mreža savi čhudol pe ano more thaj dolol tare sa e vrste mačhe. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Kana pherdol, ikalen i mreža upre pi obala thaj bešen. E lačhe mačhen save ikalde čhuven ane čare, a e bilačhen čhuden palal.<verse eid="MAT 13:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 13:49" />Gija ka avol ko krajo e svetoso. Ka ikljen e anđelura, ka crden e bilačhe manušen tare čačutne <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />thaj ka čhuden len ani jagali kubava. Gothe but ka roven thaj ka škripin dandencar.”<verse eid="MAT 13:50" /></para>
  <para style="s">Nevo thaj purano barvalipe</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Pučlja len o Isus: “Haljarden li sa kava?”</para>
  <para style="m" vid="MAT 13:51">Vaćarde lese: “Va, Gospode.”<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />A vov vaćarda lenđe: “Golese svako učitelji taro Mojsijaso zakon savo avol sikado taro Carstvo e neboso, ka avol sar ćherutno savo ikalda andari pi riznica o nevo thaj o purano barvalipe.”<verse eid="MAT 13:52" /></para>
  <para style="s">E Isuse ni manđen ano Nazaret</para>
  <para style="r">(<ref loc="MRK 6:1-6">Mk 6,1–6</ref>; <ref loc="LUK 4:16-30">Lk 4,16–30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Thaj kana o Isus vaćarda sa kala paramiča, đelo gothar. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Đelo ano than kaj barilo, sikada ani lenđi sinagoga a e manuša sesa but zadivime thaj vaćarde: “Kotar lese gasavo džanglipe thaj zuralipe? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Naj li kava e kaštunaleso čhavo? Naj li lesi dej i Marija thaj lese phrala o Jakov, o Josif, o Simon thaj o Juda? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Lese pheja naj li akate maškar amende? Kotar lese sa kava?”<verse eid="MAT 13:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 13:57" />Thaj golese ni prihvatisade le.</para>
  <para style="m" vid="MAT 13:57">A o Isus vaćarda lenđe: “O proroko si bizo čast samo ano than kaj barilo thaj ano ćher piro.”<verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />Thaj ni ćerda but čudura gothe golese so sesa bipačavne.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Meripe e Jovaneso e Krstiteljeso</para>
  <para style="r">(<ref loc="MRK 6:14-29">Mk 6,14–29</ref>; <ref loc="LUK 9:7-9">Lk 9,7–9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Ane gova vreme avilo o glaso dži ko vladari o Irod o Antipa taro Isus, <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />thaj vaćarda pe manušenđe save služin le: “Gova si o Jovane o Krstitelj; vov uštilo tare mule thaj golese šaj ćerol kala čudesura.”<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Golese o Irod čhuta angleder te dolen e Jovane, phanglja le thaj čhudija le ano phanglipe baši Irodijada i romni e Filipesi savo sasa e Irodeso phral, <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />golese so o Jovane but droma vaćarda lese: “Premalo zakon, našti la te le romnjaće.”<verse eid="MAT 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 14:5" />O Irod manglja te mudarol e Jovane, al darajlo tare manuša golese so smatrisade le sar proroko.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />A kana sasa bijandođive e Irodeso, ćhelda i čhej e Irodijaći angle leste thaj angle gostura. E Irodese sasa šukar. <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />Golese xalja sovli kaj ka dol la sa so manđol.<verse eid="MAT 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 14:8" />A voj, sikadi tari pi dej vaćarda: “Dema ko čaro o šoro e Jovaneso e Krstiteljeso.”<verse eid="MAT 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9" />Thaj o caro sasa ožalostime, al golese so ni manglja te phađol i sovli savi dija angle gostura, naredisada pe slugenđe te ćeren sa so voj manđol. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Thaj bičhalda te čhinen e Jovaneso šoro ano phanglipe. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />E sluge ande e Irodese e Jovaneso šoro ko čaro, dije le e čhejaće thaj voj dija le pe daće. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Pale gova avile e sikade e Jovanese, lije leso telo thaj prahosade le. Tegani avile thaj vaćarde gova e Isusese.<verse eid="MAT 14:12" /></para>
  <para style="s">O Isus parvarol pobut tare pandž milje dženen</para>
  <para style="r">(<ref loc="MRK 6:30-44">Mk 6,30–44</ref>; <ref loc="LUK 9:10-17">Lk 9,10–17</ref>; <ref loc="JHN 6:1-14">Jn 6,1–14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Kana šunda o Isus so sasa e Jovanesa e Krstiteljesa, đelo gothar čamcosa ko pusto than, te bi avola korkoro. Thaj kana gova šunde e manuša, đele pale leste phirindoj tare forura. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Kana o Isus iklilo andaro čamco, dikhlja bute manušen, pelo lese žal lenđe thaj sastarda lenđe nasvalen.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Angli rat avile lese sikade thaj vaćarde lese: “Kava si pusto than, a akana si kasno. Mukh e manušen, nek džan ane gava te ćinen pese xamase!”<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />A o Isus vaćarda lenđe: “Ni trubun te džan. Den len tumen te xan!”<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />A von vaćarde lese: “Akate isi amen samo pandž mangre thaj duj mačhe!”<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />A vov vaćarda lenđe: “Anen manđe gova akari!” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Thaj e manušenđe vaćarda te bešen ki čar.</para>
  <para style="m" vid="MAT 14:19">Lija kola pandž mangre thaj e duj mačhe, dikhlja ano nebo, zahvalisada e Devlese bašo xape thaj phaglja o mangro. Tegani o Isus dija len e mangre a e sikade ulade e manušenđe te xan. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Savore xalje thaj čalile. A pale gova e sikade ćidije dešuduj (12) korpe pherde kotora so ačhile. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />A kola so xalje sesa pandž milje (5 000) manuša, a gothe ni sesa đinde e romnja thaj e čhavore.<verse eid="MAT 14:21" /></para>
  <para style="s">O Isus phirol po paj</para>
  <para style="r">(<ref loc="MRK 6:45-52">Mk 6,45–52</ref>; <ref loc="JHN 6:16-21">Jn 6,16–21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Pale gova sigate, terisada o Isus pe sikaden te den ano čamco thaj te džan angle leste ki aver rig e jezerosi, dži kaj vov mućhol e manušen te džan pe dromesa. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Kana mukhlja e manušen, uštilo ko brego te avol korkoro te molil pe. Thaj ki rat gothe sasa korkoro. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />A o čamco e sikadencar sasa dur tari obala thaj e talasura čalade ano čamco, golese so premal leste phurdija bari balval.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />A maškare trin em šov o sato sabalje, đelo o Isus premal lende phirindoj po paj. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Thaj kana dikhlje e sikade sar phirol po jezero premal lende, darajle thaj vaćarde: “Gova si omaja!” Darajle thaj lije te den vika.<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />A o Isus sigate phenda lenđe: “Šukar si! Me sem, ma daran!”<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />A o Petar vaćarda lese: “Gospode! Ako san tu, vaćar manđe te phirav po paj!”<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />A o Isus vaćarda lese: “Phir!” O Petar iklilo taro čamco thaj phirda po paj thaj đelo premalo Isus.<verse eid="MAT 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 14:30" />Al kana dikhlja i bari balval, darajlo thaj lija te properol ano paj thaj dija vika: “Gospode, pomoži manđe!”<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Thaj sigate o Isus pružisada po va te dolol e Petre thaj vaćarda lese: “Sose gaći zala pača, sose sumnjisadan?”<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />Thaj kana dije ano čamco, i balval ačhili.<verse eid="MAT 14:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 14:33" />Kola save sesa ano čamco, pele ke pe koča thaj vaćarde: “Čače tu san o Čhavo e Devleso!”<verse eid="MAT 14:33" /></para>
  <para style="s">O Isus sastarol ani Genisaretsko phuv</para>
  <para style="r">(<ref loc="MRK 6:53-56">Mk 6,53–56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Thaj kana nakhle o paj, avile ani phuv i Genisaretsko. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Kana pindžarde le e manuša tare gova than, vaćarde ani sa goja phuv kaj avilo o Isus thaj ande paše leste e nasvalen. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Thaj molisade le samo te dolen pe taro teluno kotor tare leso fostano. Thaj savore save dolde le, sastile.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">O Isus vaćarol sar te aven thode anglo Dol</para>
  <para style="r">(<ref loc="MRK 7:1-23">Mk 7,1–23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Tegani avile ko Isus e fariseja thaj e učitelja tare Mojsijaso zakon taro Jerusalim thaj pučlje le: <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“Sose ćire sikade phađen e adetura tare amare purane? Ni ićaren o adeti te thoven pe vasta angleder so ka xan mangro!”<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />A o Isus vaćarda lenđe: “Sose tumen baše tumare adetura phađen e Devleso zakon? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Golese so o Dol vaćarda: ‘Poštuji će dade thaj će da,’ thaj ‘ko akušol pe dade il pe da te avol kaznimo merimasa!’ <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />A tumen vaćaren: ‘Vaćarol li khoni pe dadese il pe daće: O pomoć mandar so trubul te dav tumen, xaljem sovli, kaj ka dav sar daro e Devlese,’ <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />naj dužno te sikavol poštujipe gija so ka dićhol so trubul e dade em e deja. Gija zanemarin e Devleso Lafi paše tumare adetura. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Dujemujenđe! Šukar prorokujisada tumendar o Isaija, kana vaćarda:<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />‘Kala manuša poštujin man samo vuštencar,</para>
  <para style="q1" vid="MAT 15:8">a lenđe ile si dur mandar.<verse eid="MAT 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 15:9" />Džabe poštujin man</para>
  <para style="q1" vid="MAT 15:9">golese so si lengo sikajipe manušikane pravilura.’”<verse eid="MAT 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Pale gova o Isus dija vika e manušen thaj vaćarda lenđe: “Šunen thaj haljaren, <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />ni meljarol e manuše anglo Dol kova so dol lese ano muj, nego e manuše meljarol kova so ikljol lese andaro muj.”<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Tegani avile lese sikade thaj phende: “Džane li kana šunde e fariseja gova lafi, uvredisajle?”<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />A vov phenda lenđe: “Svako biljka savi ni sadisada o Dad mingro ko nebo, ka ikalol pe andari phuv. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Mućhen len! Von si kore manuša thaj vodin e koren. A o koro našti inđarol e kore, golese so solduj ka peren ani rupa.” <verse eid="MAT 15:14" /><verse number="15" style="v" sid="MAT 15:15" />A o Petar vaćarda lese: “Vaćar amenđe so mangljan te vaćare kale paramičasa taro kova so meljarol e manuše.” <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />A o Isus vaćarda: “Tumen li sen vadži bihaljarde? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Ni li džanen, so dol ano muj, ano vođi džal thaj ikljol avral? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />A e lafura save ikljen andaro muj, ikljen andaro ilo thaj gova meljarol e manuše anglo Dol. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Andaro ilo ikljol bilačho gođaveripe, mudaripe, preljube, blud, čoripe, xoxavno svedočanstvo thaj vređipe. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Gova meljarol e manuše, a te xal pe bithode vastencar ni meljarol e manuše anglo Dol.”<verse eid="MAT 15:20" /></para>
  <para style="s">I džuvli savi naj Jevrejka sikavol baro pačajipe</para>
  <para style="r">(<ref loc="MRK 7:24-30">Mk 7,24–30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />O Isus iklilo andari Galileja thaj crdija pe ane tirska thaj sidonska thana.<verse eid="MAT 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 15:22" />Thaj dikh, i džuvli i Hanaanejka savi bešola ane gola thana, avili ko Isus thaj pobut droma dija vika: “Smilui tut pe mande, Gospode, Čhaveja e Davideso! Me čheja but mučil o bilačho duxo thaj but patil!”<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />A vov khanči ni vaćarda e Hanaanejkaće. Gija avile lese sikade paše leste thaj molisade le vaćarindoj: “Mukh la te džal, golese so bizo ačhipe dol vika pale amende.”<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />A vov vaćarda lenđe: “Me sem bičhaldo te pomoživ samo e hasarde bakrenđe tare Izraelska manuša.”<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />A voj avili, peli angle leste ke koča thaj vaćarda:</para>
  <para style="m" vid="MAT 15:25">“Gospode, pomogni manđe!”<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />A o Isus vaćarda laće: “Naj šukar te lol pe o mangro tare čhave thaj te dol pe e džuklorenđe.”<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />A voj vaćarda: “Va, Gospode, golese so i e džuklore xan e troške so peren taro astali lenđe gospodarenđe.”<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Tegani o Isus vaćarda laće: “O, džuvlije, baro si ćiro pačajipe! Nek avol sar so tu manđe!”</para>
  <para style="m" vid="MAT 15:28">Thaj sastili laći čhej ane gova sato.<verse eid="MAT 15:28" /></para>
  <para style="s">O Isus sastarol bute nasvalen</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />O Isus đelo gothar thaj avilo pašo more o Galilejsko. Uštilo ko brego thaj bešlo gothe te sikavol. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Avile pašo Isus but manuša thaj ande pesa banđen, koren, sakatonen, laloren thaj bute avere nasvalen. Siđarde te čhuven e nasvalen paše Isusese pingre thaj vov savoren sastarda. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Gijate e manuša sesa zadivime, kaj dikhlje e lalore so vaćaren, e sakata so saston, e banđe so šukar phiren thaj e kore so dićhen thaj hvalisade e Devle e Izraelese.<verse eid="MAT 15:31" /></para>
  <para style="s">O Isus parvarol pobut tare štar milje džene</para>
  <para style="r">(<ref loc="MRK 8:1-10">Mk 8,1–10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />O Isus akharda pe sikaden thaj phenda lenđe: “Žal manđe kale manušenđe golese so trin đive si kate paše mande thaj naj len so te xan. Ni mangav te mukhav len te džan bokhale te ma malaksin ko drom.”<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />A e sikade vaćarde lese: “Kotar amenđe ke kava than gaći mangro te čaljon kala manuša?”<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Thaj o Isus pučlja: “Kobor mangre isi tumen?”</para>
  <para style="p" vid="MAT 15:34">A von vaćarde lese: “Efta mangre thaj zala mačhe.”<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />A o Isus vaćarda e manušenđe te bešen ki phuv. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Lija kola efta mangre thaj e mačhen, dija hvala e Devlese, phaglja thaj dija pe sikadenđe a e sikade dije e manušenđe. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Savore xalje thaj čalile. E sikade pale gova lije so ačhilo thaj pherde efta bare korpe. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Xalje štar milje (4 000) murša, a gothe ni sesa đinde e džuvlja thaj e čhavore. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Tegani o Isus mukhlja e manušen, čhuta pe ano čamco thaj avilo pašo than o Magadansko.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">E fariseja thaj e sadukeja roden znako taro Isus</para>
  <para style="r">(<ref loc="MRK 8:11-13">Mk 8,11–13</ref>; <ref loc="LUK 12:54-56">Lk 12,54–56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Avile pašo Isus e fariseja thaj e sadukeja thaj manglje te iskušin le. Thaj rodije te sikavol lenđe nesavo znako taro nebo.<verse eid="MAT 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2" />A o Isus vaćarda lenđe: “Džanen te vaćaren kana perol i rat: ‘Ka avol lačho vreme, golese so si o nebo lolo.’ <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />A ki sabalin vaćaren: ‘Avđive ka avol o bilačho vreme, golese so si o nebo lolo thaj mutno.’ Znakura e nebose šaj tumačin, a e znakura kale đivesenđe našti te tumačin? <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />O bilačho thaj preljubničko bijandipe rodol znako thaj aver znako ni ka dol pe lenđe, samo o znako savo sasa e prorokoso e Jonaso.”</para>
  <para style="m" vid="MAT 16:4">Pale gova o Isus ačhada len thaj đelo pese.<verse eid="MAT 16:4" /></para>
  <para style="s">O Isus upozoril ko farisejsko thaj o sadukejsko kvasco</para>
  <para style="r">(<ref loc="MRK 8:14-21">Mk 8,14–21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Thaj kana nakhlje ki aver rig e jezerosi, e sikade bistarde te anen pesa o mangro. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />O Isus vaćarda lenđe: “Araćhen tumen taro kvasco o farisejsko thaj o sadukejsko!”<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />A von maškar peste vaćarde: “Gova si golese so ni andam mangro.”<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />A o Isus džanglja sostar vaćaren thaj phenda lenđe: “Sose gaći zala pačan? So vaćaren maškar tumende, so naj tumen mangro? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Vadži li ni haljarden? Ni li den tumen gođi baše pandž mangre ke pandž milje (5 000) džene thaj kobor korpe pherden tare kova so ačhilo? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Ni baše efta mangre ke štar milje (4 000) džene thaj kobor bare korpe pherden? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Sar ni haljaren kaj ni vaćardem tumenđe baše mangre? Araćhen tumen taro kvasco o farisejsko thaj o sadukejsko?”<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />Tegani haljarde kaj ni vaćarda lenđe te araćhen pe taro kvasco e mangreso, nego taro farisejsko thaj o sadukejsko sikajipe.<verse eid="MAT 16:12" /></para>
  <para style="s">O Petar priznajil kaj si o Isus o Hrist</para>
  <para style="r">(<ref loc="MRK 8:27-30">Mk 8,27–30</ref>; <ref loc="LUK 9:18-21">Lk 9,18–21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Kana avilo o Isus ane krajura trujal i Kesarija e Filipesi, pučlja pe sikaden: “So vaćaren e manuša, ko sem me, o Čhavo e manušeso?”<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />E sikade vaćarde lese: “Jekh vaćarol kaj san o Jovane o Krstitelj, avera o Ilija, a nesave o Jeremija, il jekh tare avera prorokura.”<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />O Isus vaćarda lenđe: “A tumen so phenen: ko sem me?”<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />A o Simon o Petar vaćarda lese: “Tu san o Hrist, Čhavo e džuvde Devleso!”<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Thaj vaćarda lese o Isus: “Blagoslovime san, Simone, čhaveja e Jonaso! Golese so ni sikada tuće gova o manuš, nego mo Dad savo si ko nebo. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />A me vaćarav tuće: Tu san o Petar i ke kava bar ka vazdav mi Khanđiri thaj e vudara e Hadese<note caller="+" style="f"><char style="fr" closed="false">16,18 </char><char style="ft" closed="false">so značil “than e mulengo”</char></note> našti nadvladil la. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Thaj ka dav tut e ključura taro Carstvo e neboso: i so phande ki phuv, ka avol phanglo ko nebo thaj so putre ki phuv ka avol putardo ko nebo.”<verse eid="MAT 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20" />Tegani o Isus pretisada pe sikaden ma khanikase te vaćaren kaj si vov o Hrist.<verse eid="MAT 16:20" /></para>
  <para style="s">O Isus vaćarol tare piro meripe thaj uštipe tare mule</para>
  <para style="r">(<ref loc="MRK 8:31-9:1">Mk 8,31–9,1</ref>; <ref loc="LUK 9:22-27">Lk 9,22–27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Od tegani o Isus lija te vaćarol pe sikadenđe putarde, kaj trubul te džal ano Jerusalim thaj but te patil tare starešine, tare šorutne sveštenikura thaj tare učitelja tare Mojsijaso zakon thaj trubul te avol mudardo em o trito đive te uštol.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />A o Petar crdija le ki rig thaj lija te vaćarol lese: “Gospode, nek smiluil pe tuće o Dol! Gova ni trubul te avol tuće!”<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />A o Isus irisajlo thaj vaćarda e Petrese: “Dža mandar, Satano! Tu ačhe manđe ko drom, golese so tuće ani gođi naj e Devleso, nego o manušikano.”<verse eid="MAT 16:23" /></para>
  <para style="s">Save trubun te aven e Isusese sikade</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Tegani o Isus vaćarda pe sikadenđe: “Ko manđol te džal pale mande, trubul te ačhavol korkoro pes, trubul te lol o krsto piro thaj tegani te avol pale mande. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Golese ko manđol piro džuvdipe te araćhol, ka hasarol le, a ko hasarol piro džuvdipe baše mande, ka araćhol le. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Savo šukaripe ka avol e manuše savo sa o sveto dobil a hasarol po džuvdipe? So šaj o manuš te dol ani zamena baše piro džuvdipe? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Golese so me, o Čhavo e manušeso, sigate ka avav mingre anđelurencar ani slava mingre Dadesi, tegani ka nagradiv thaj ka kazniv dži jekhe pale lese buća. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Čače vaćarav tumenđe: nesave kate save si maškar tumende ni ka okusin o meripe sa dok ni dićhen man, e Čhave e manušese, sar avav mingre Carstvosa.”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">O Mojsije thaj o Ilija sikadile e Isusese</para>
  <para style="r">(<ref loc="MRK 9:2-13">Mk 9,2–13</ref>; <ref loc="LUK 9:28-36">Lk 9,28–36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Pale šov đive inđarda o Isus e Petre, e Jakove thaj e Jovane lese phrale upre ko baro brego, kaj sesa korkore. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Gothe angle lende menjisada pe thaj leso muj sijajisada sar o kham a lese šeja sesa parne sar o svetlo. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Thaj dikh, sikadilo lenđe o Mojsije thaj o Ilija, save lije te vaćaren lesa.<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />A o Petar vaćarda e Isusese: “Gospode! Šukar kaj sam kate. Ako manđe te ćerav trin senice, jekh tuće, jekh e Mojsijase a jekh e Ilijase.”<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />I dok vov vaćarda, dikh, sjajno oblako učharda len thaj taro oblako šunde glaso: “Kava si mingro Čhavo o manglo, savo si palo mingro manglipe! Le šunen!”<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Kana kava šunde e sikade, pele mujesa dži i phuv thaj darajle but.<verse eid="MAT 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 17:7" />A o Isus avilo, dolda len thaj vaćarda lenđe: “Ušten! Ma daran!” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Kana von vazdije pe jakha, ni dikhlje khanika sem e Isuse.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Thaj kana ulile taro brego, o Isus naredisada lenđe: “Ma vaćaren khanikase so dikhljen sa dok me, o Čhavo e manušeso, ni uštav tare mule.”<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />E sikade pučlje e Isuse: “Sose tegani e učitelja tare Mojsijaso zakon vaćaren kaj angleder trubul te avol o Ilija?”<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />A o Isus vaćarda lenđe: “O Ilija čače ka avol angleder thaj sa ka čhuvol ke po than. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Al me vaćarav tumenđe kaj o Ilija već avilo, a von ni pindžarde le, nego ćerde pese lesa so manglje. Gija i me, o Čhavo e manušeso, ka pativ lendar.” <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Tegani haljarde e sikade kaj vaćarol lenđe taro Jovane o Krstitelj.<verse eid="MAT 17:13" /></para>
  <para style="s">O Isus sastarol e čhavore</para>
  <para style="r">(<ref loc="MRK 9:14-29">Mk 9,14–29</ref>; <ref loc="LUK 9:37-43">Lk 9,37–43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />A kana avile paše but manuša, avilo nesavo manuš anglo Isus, pelo angle leste ke koča <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />thaj vaćarda lese: “Gospode! Smilui tut me čhavese, golese so isi le padavica thaj but patil. But droma perol ani jag thaj ano paj. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Andem le ke će sikade, a naštine te sastaren le.”<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />A o Isus vaćarda lenđe: “Tumen, o bipačavno thaj rumimo bijandipe! Dži kana ka avav tumencar? Dži kana ka trpiv tumen? Anen le akari!” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Gija o Isus naredisada e bilačhe duxose thaj vov sigate iklilo andro čhavoro, a vov sastilo ane gova sato.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Tegani avile e sikade dži ko Isus thaj korkore pučlje le: “Sose amen naštine te trada e bilačhe duxo?”<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />O Isus vaćarda lenđe: “Golese so isi tumen zala pačajipe. Čače vaćarav tumenđe, ako isi tumen pačajipe sar o seme tari gorušica, šaj vaćaren kale bregose: ‘Nakh akatar odori’, thaj ka naćhol. Khanči ni ka avol tumenđe nemoguće. <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />[Al kaja vrsta tare bilačhe duxura šaj tradol pe samo e molitvasa thaj e postimasa.]”<verse eid="MAT 17:21" /></para>
  <para style="s">O Isus palem vaćarol tare piro meripe thaj uštipe tare mule</para>
  <para style="r">(<ref loc="MRK 9:30-32">Mk 9,30–32</ref>; <ref loc="LUK 9:43-45">Lk 9,43–45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Kana e sikade ćidije pe ani Galileja, vaćarda lenđe o Isus: “Me, o Čhavo e manušeso, sigate ka avav predajimo ane vasta e manušikane, <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />ka mudaren man, a trito đive ka uštav tare mule.” Thaj e sikade sesa but bibaxtale.<verse eid="MAT 17:23" /></para>
  <para style="s">O Isus sikavol taro Hrameso porezi</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Kana e sikade avile ano Kafarnaum, avile pašo Petar e poreznikura taro hram, save ćiden po duj drahme thaj vaćarde e Petrese: “Na li tumaro učitelji poćinol o hramsko porezi?”<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />O Petar vaćarda: “Poćinol.” Thaj kana dija ano ćher, o Isus angleder pučlja le: “So misli, Simone? Kastar e carura e phuvaće ćiden i carina thaj o porezi? Tare pire čhave il tare avera čhave?”<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />A o Petar vaćarda lese: “Tare avera.”</para>
  <para style="p" vid="MAT 17:26">A o Isus vaćarda lese: “Gija, e čhave ni poćinen. Von si oslobodime. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Al te ma uvredi len, dža thaj čhude i udica ano paj. Save mačhe angleder dole, putar leso muj thaj ka araćhe štar drahme. Le thaj poćin o porezi manđe em tuće.”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Ko si embaro ano Carstvo e neboso?</para>
  <para style="r">(<ref loc="MRK 9:33-37">Mk 9,33–37</ref>; <ref loc="MRK 9:42-48">9,42–48</ref>; <ref loc="LUK 9:46-48">Lk 9,46–48</ref>; <ref loc="LUK 17:1-2">17,1–2</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Ane gova sato avile dži ko Isus lese sikade thaj pučlje le: “Ko si embaro ano Carstvo e neboso?” <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />O Isus dija vika jekhe cikne čhavore, čhuta le maškare lende <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />thaj vaćarda lenđe: “Čače vaćarav tumenđe, ako ni promenin tumen thaj ni aven sar cikne čhavore, nisar našti džan ano Carstvo e neboso! <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Savo gija ponizil pe sar gova čhavoro, vov si embaro ano Carstvo e neboso. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Thaj ko primil jekhe gasave čhave zbog mande, man primil. <verse eid="MAT 18:5" /><verse number="6" style="v" sid="MAT 18:6" />Te khoni inđarda ano greh jekhe tare kala cikne save pačan ane mande, pošukar si lese te phanden baro bar tari vodenica ke lesi kor thaj te avol tasado ani dubina e moresi.<verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />Pharo e manušenđe ano sveto golese so ćeren te perol pe ano greh! Golese so trubul te aven e iskušenjura save inđaren ano greh, al pharo kole manušese pe kaste e iskušenjura aven. <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Ako ćo va il ćo pingro inđarol tut ane grehura, čhin le thaj čhude le tutar. Pošukar si tuće te ulje ano džuvdipe bizo meripe sakato il bango, nego duje vastencar thaj duje pingrencar te čhuden tut ani jag savi ni ačhol. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Thaj ako ći jakh inđarol tut ano greh, ikal la thaj čhude la tutar. Pošukar si tuće te ulje ano životo jekhe jakhasa, nego duje jakhencar te čhuden tut ani jag savi ni ačhol.<verse eid="MAT 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />Pazin te ma dićhen barikane nijekhe tare kala ciknen, golese me vaćarav tumenđe kaj e anđelura lenđe ko nebo stalno ačhen anglo mo Dad savo si ko nebo. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />[Golese so me o Čhavo e manušeso aviljem te rodav thaj te spasiv e hasarden.]”<verse eid="MAT 18:11" /></para>
  <para style="s">O Isus vaćarol paramič tari hasardi bakri</para>
  <para style="r">(<ref loc="LUK 15:3-7">Lk 15,3–7</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />“So den gođi? Ako e manuše isi šel bakre thaj jekha hasarol, ni li ačhavol vov enjavardeš thaj enja po brego thaj džal te rodol kola so hasardili? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Thaj ako araćhol la, čače vaćarav tumenđe, vov pobut radujil pe kala jekha so arakhlja, nego kolenđe enjavardeš thaj enja so ni hasajle. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Gijate ni manđol tumaro Dad ko nebo te hasarol nijekhe tare kala cikne.”<verse eid="MAT 18:14" /></para>
  <para style="s">Opomena avere pačavnenđe save grešin</para>
  <para style="r">(<ref loc="LUK 17:3">Lk 17,3</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />“Ako ćerol greh ćiro phral, dža thaj ukori le kana sen korkore. Ako šunol tut, palem dobisadan ćire phrale. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Ako ni šunol tut, le tusa vadži jekhe il dujen, ‘palo svedočanstvo duje il trine svedokurengo te dokažil pe svako optužba.’ <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />A ako i len ni šunol, vaćar e khanđiraće. A ako odbil te šunol e khanđira, te avol tuće sar o bipačavno thaj carinco.<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />Čače vaćarav tumenđe, sa so phanden ki phuv, ka avol phanglo ko nebo thaj sa so putren ki phuv, ka avol putardo ko nebo.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />Čače vaćarav tumenđe vadži, ako duj džene tumendar ki phuv katane molin pe thaj roden bilo so, ka dol len o Dad mingro savo si ko nebo. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Golese kaj si duj il trin ćidime ane mingro alav, me sem gothe maškar lende.”<verse eid="MAT 18:20" /></para>
  <para style="s">O Isus vaćarol paramič taro bilačho manuš savo dugujil</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Tegani avilo o Petar pašo Isus thaj vaćarda: “Gospode! Ako mo phral grešil premal mande, kobor droma te oprostiv lese? Dži efta droma li?”<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />O Isus lese vaćarda: “Ni vaćarav tuće samo efta, nego eftavardeš droma po efta.<verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />Golese vaćarav kava, o Carstvo e neboso si sar caro savo manglja te ravnil po računo e manušencar save služisade le. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Kana lija te đinol, ande angle leste manuše savo dugujil lese deš milje (10 000) kese zlatosa. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Sar vov naštine te iril gola pare, o caro vaćarda te biknen le, lese romnja, lese čhaven thaj sa so sasa le, te bi poćinola o dugo.<verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />O manuš savo služila le, pelo angle leste mujesa premali phuv thaj molisada le: ‘Ađućar man thaj sa ka poćinav tuće.’ <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />E carose pelo žal, oprostisada gole slugase o dugo thaj mukhlja le.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />A kana iklilo o manuš savo služil, arakhlja pe amale, avere sluga, savo dugujisada lese šel grošura. Dolda le, lija te tasavol le thaj vaćarda lese: ‘Iri so duguji manđe!’ <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />Pelo leso amal, aver sluga, angle leste mujesa premali phuv thaj molisada le thaj vaćarda lese: ‘Ađućar man thaj ka poćinav tuće!’ <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />A vov ni manglja te ađućarol le, inđarda le thaj čhudija le ano phanglipe sa dok ni ka poćinol o dugo.<verse eid="MAT 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 18:31" />Kana kava dikhlje avera amala, avera sluge, uznemirisajle but. Đele thaj javisade e carose sa kava so dikhlje. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Tegani o caro leso dija vika e sluga kase oprostisada o dugo thaj vaćarda lese: ‘Bilačheja slugo! Sa o dugo me oprostisadem tuće, golese so molisadan ma. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Na li trubujan i tu te smilui tut ćire amalese, e slugase, sar me so smiluisaljem tuće?’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />O caro leso holajlo thaj dija le ke mučitelja sa dži kaj ni ka poćinol o dugo.<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />Gija i mo Dad ko nebo ka ćerol tumencar, ako ni ka oprostin tumare phralese andare tumare ile.”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">O Isus sikavol taro razvod</para>
  <para style="r">(<ref loc="MRK 10:1-12">Mk 10,1–12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Kana o Isus završisada kava vaćaripe, đelo andari Galileja thaj avilo ane Judejska krajura ki aver rig e Jordanesi. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Đele pale leste but manuša thaj vov gothe sastarda e nasvalen.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Thaj avile dži ko Isus e fariseja te iskušin le thaj pučlje le: “Šaj li o manuš te mućhol pe romnja baše bilo so?”<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />O Isus phenda lenđe: “Džanav kaj čitisaden ano Sveto lil kaj o Stvoritelji ko anglunipe ‘stvorisada murše thaj džuvlja’. <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />Thaj vadži vaćarda: ‘Golese o manuš ka ačhavol pe dade thaj pe da thaj ka phandol pe pe romnjasa thaj duj ka aven jekh telo.’ <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Gijate naj akana duj, nego jekh telo. So o Dol phanglja o manuš te ma ulavol!”<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Pe gova von pučlje le: “Pa, sose o Mojsije zapovedisada o rom te dol pe romnja rastavimaso lil kaj mućhol la?”<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />O Isus vaćarda lenđe: “O Mojsije ačhada tumenđe te mućhen e romnjen pale tumare zurale ile, al ko anglunipe ni sasa gija. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />A me vaćarav tumenđe: Te khoni mućhol pe romnja, sem baše lako blud, a lol avera, ćerol preljuba [thaj ko lol raspuštenica romnjaće ćerol preljuba].”<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />E sikade lese vaćarde: “Te si gija maškar o rom thaj i romni, tegani po šukar si te ma ženil pe!”<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />A o Isus vaćarda e sikadenđe: “Našti savore te prihvatin kava akana so vaćarden, sem kola kase dija pe. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Golese so isi murša saven taro lengo bijandipe našti te aven len čhave, a isi kola saven avera ćeren te aven gasave. A isi nesave save ni manđen te len romnjen zbog o Carstvo e neboso. Ko šaj te prihvatil, nek prihvatil!”<verse eid="MAT 19:12" /></para>
  <para style="s">O Isus blagoslovil e čhaven</para>
  <para style="r">(<ref loc="MRK 10:13-16">Mk 10,13–16</ref>; <ref loc="LUK 18:15-17">Lk 18,15–17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Tegani anglo Isus e manuša ande čhavoren te čhuvol po va pe lende thaj te molil pe. A e sikade branisade len. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />A o Isus vaćarda: “Mućhen e čhavoren thaj ma ačhaven len te aven ke mande, golese so gasavenđe si o Carstvo e neboso!” <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Gija čhuta po va pe lende, a pale gova đelo gothar.<verse eid="MAT 19:15" /></para>
  <para style="s">O Isus thaj o barvalo</para>
  <para style="r">(<ref loc="MRK 10:17-31">Mk 10,17–31</ref>; <ref loc="LUK 18:18-30">Lk 18,18–30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Thaj dikh, nesavo terno manuš avilo pašo Isus thaj pučlja le: “Učitelju! Savo šukaripe te ćerav te avol ma džuvdipe bizo meripe?”<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />A o Isus vaćarda lese: “Sose puče man bašo šukaripe? Samo jekh si šukar, o Dol! Ako manđe te de ano džuvdipe bizo meripe, ićar tut ke zapovestura!”<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />O terno pučlja le: “Save zapovestura?”</para>
  <para style="p" vid="MAT 19:18">A o Isus vaćarda: “Kala zapovestura: ‘Ma mudar, ma ćher preljuba, ma čor, ma svedoči xoxavne, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />poštuji ćire dade thaj ćire da,’ thaj ‘mang ćire pašutne sar korkore tut.’”<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />O terno phenda lese: “Pe sa kava ićardem man. So vadži trubul?”<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />O Isus vaćarda lese: “Ako manđe savršeno te ave, dža bićin sa so isi tut, e pare de e čororenđe thaj ka avol tu barvalipe ko nebo. Tegani av thaj dža pale mande.” <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />Kana šunda gola lafura o terno, đelo gothar bibaxtalo, golese so ni manglja te biknol sa so sasa le taro baro barvalipe.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Tegani o Isus vaćarda pe sikadenđe: “Čače phenav tumenđe, but pharo ka avol e barvalese te džal ano Carstvo e neboso!” <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Pale vaćarav tumenđe: “Po loćhe si e kamilaće te naćhol maškare suvaće kana, nego o barvalo te avol ano Carstvo e Devleso!”<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Kana šunde gova lese sikade, but čudisajle thaj pučlje: “Pa ko šaj onda te spasil pe?”<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />O Isus dikhlja šukar premal lende thaj vaćarda lenđe: “So si nemoguće e manušenđe, gova si e Devlese moguće.”<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Tegani o Petar phenda: “Akh, amen ačhadam sa thaj pale tute đeljam. So golesa ka dobi?”<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />A o Isus vaćarda lenđe: “Čače vaćarav tumenđe ano sveto savo ka obnovil pe, kana me, o Čhavo e manušeso, ka bešav ke mingro slavno presto, a tumen save džan pale mande ka bešen ke dešuduj (12) prestola thaj ka sudin pe dešuduj plemenura e Izraelese. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Thaj dži jekh, savo zbog mo alav ačhavol po ćher, il pe phralen, il pe phejen, il pe dade, il pe da, [il pe romnja,] pe čhaven, il pi phuv, ka lol šel (100) droma gaći thaj ka nasledil džuvdipe bizo meripe. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Al, kola so si akana anglal odori ka aven empalal, a kola save si empalal odori ka aven emanglal.”<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">O Isus vaćarol paramič tare Devleso darežljivost</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />“Golese o Carstvo e neboso si sar vlasniko savo ki sabalin rano uštol te rodol bućarnen te ćeren bući ane leso vinograd. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Pazarisajlo e bućarnencar po jekh dinari, so sasa dnevnica jekhe đivesesi thaj bičhalda len ane po vinograd.<verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />Kana sasa paše enja o sato, pale iklilo thaj dikhlja averen sar ačhen ko trgo bibućako. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Vaćarda lenđe: ‘Džan i tumen ane mo vinograd thaj ćeren bući, a kobor si pravedno me ka poćinav tumen.’ <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Thaj von đele.</para>
  <para style="p" vid="MAT 20:5">Palem iklilo paše ke dešuduj (12) o sato. Poslepodne ke trin o sato ćerda isto gova. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Kana iklilo paše o pandžto sato poslepodne, arakhlja averen sar ačhen bibućako thaj pučlja len: ‘Sose ačhen celo đive gothe bizi bući?’<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />Von vaćarde lese: ‘Golese so khoni ni dija amen bući.’</para>
  <para style="p" vid="MAT 20:7">Gija phenda lenđe: ‘Džan i tumen ane mo vinograd thaj ćeren bući.’<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />Kana pelo o mrako, vaćarda o gospodari e vinogradeso pe anglune slugase: ‘De vika sa e bućarnen thaj poćin angleder kolen save avile empalune dži kola so avile te ćeren bući angleder.’ <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Gija avile angleder kola so avile te ćeren bući ko pandžto sato thaj lije po jekh dinari. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Thaj kana avile kola save angleder lije te ćeren bući, dije gođi kaj ka len pobut, al i von lije po jekh dinari. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Kana lije e pare, lije te bunin pe po vlasniko e vinogradeso. <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />Phende: ‘Amen ćerdam bući celo đive thaj mučisaljam thaj phabiljam, al kola so avile emposlednja save ćerde bući samo jekh sato thaj i len poćindan sar amen!’<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />A vov vaćarda jekhese lendar: ‘Manušeja! Me tuće ni ćerav nisavi nepravda. Na li pazarisaljem tusa jekh dinari? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Le so si ćiro thaj dža. Me mangav te dav kole empalune sar so poćinav i tut. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Naj li man pravo te ćerav so me mangav me parencar? Il si ći jakh bilačhi so sem me šukar premal lende?’<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />Gija, kola so si akana empalal odori ka aven anglal, a kola save si anglal odori ka aven empalal.”<verse eid="MAT 20:16" /></para>
  <para style="s">O Isus palem vaćarol tare piro meripe</para>
  <para style="r">(<ref loc="MRK 10:32-34">Mk 10,32–34</ref>; <ref loc="LUK 18:31-34">Lk 18,31–34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Kana đelo o Isus ano Jerusalim, lija pe dešuduje (12) sikaden korkoren thaj odrumal vaćarda lenđe: <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“Akh dža ano Jerusalim thaj man, e Čhave e manušese, ka den e šorutne sveštenikurenđe thaj e učiteljenđe tare Mojsijaso zakon a von ka osudin man ko meripe. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />Ka den man e abandžijenđe, te maren muj mancar, te bičujin man thaj te čhuven man ko krsto thaj o trito đive ka uštav tare mule.”<verse eid="MAT 20:19" /></para>
  <para style="s">Trubul te služi averen</para>
  <para style="r">(<ref loc="MRK 10:35-45">Mk 10,35–45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Tegani avili dži ko Isus i dej e Zevedejese čhavenđi, katane pe čhavencar thaj peli mujesa premali phuv angle leste te šaj khanči manđol. <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />O Isus pučlja la: “So manđe?”</para>
  <para style="p" vid="MAT 20:21">Voj phenda lese: “Obeći manđe kaj me duj čhave ka bešen ke ćire duj riga, ane ćiro Carstvo, jekh tari ći desno rig, a dujto tari ći levo rig.”<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />A o Isus vaćarda: “Ni džanen so manđen. Šaj li pijen o tahtaj so me ka pijav? [Thaj šaj li aven krstime krstimasa savesa sem me krstimo?]”</para>
  <para style="p" vid="MAT 20:22">Vaćarde lese: “Šaj.”<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />O Isus vaćarda lenđe: “Čače, o tahtaj e patimaso savo me pijav ka pijen [thaj e krstimasa savesa me sema krstimo, ka aven krstime i tumen], al te bešen manđe ki desno thaj ki levo rig našti dav me. Gola thana preperen kolenđe kase pripremisada mo Dad.”<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Kana šunde avera deš sikade, holajle pe kala duj phrala. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />O Isus akharda len paše peste thaj phenda: “Džanen kaj e abandžijenđe vladara isi len zuralipe pe manuša thaj e gospodara manđen te vladin pe lende. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Al maškar tumende te ma avol gijate! Ko manđol te avol embaro maškar tumende, nek služil tumen. <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />Thaj ko manđol te avol emangluno, nek avol tumaro robo. <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />Golese ni me, o Čhavo e manušeso, ni aviljem te služin man, nego aviljem te služiv tumen thaj mo džuvdipe te dav te bi poćinava butenđe.”<verse eid="MAT 20:28" /></para>
  <para style="s">O Isus sastarol e koren ano Jerihon</para>
  <para style="r">(<ref loc="MRK 10:46-52">Mk 10,46–52</ref>; <ref loc="LUK 18:35-43">Lk 18,35–43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Kana iklilo o Isus thaj lese sikade andaro foro o Jerihon, đele pale leste but manuša. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Thaj dikh, duj kore bešle pašo drom. Kana šunde kaj naćhol o Isus, vaćarde: “Smilui tut amenđe, Gospode, Čhaveja e Davideso!” <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />A e manuša dije vika pe lende te ma bi vaćarena khanči, al von po zurale dije vika pale leste: “Smilui tut amenđe Gospode, Čhaveja e Davideso!”<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />O Isus ačhilo, dija len vika thaj pučlja len: “So manđen te ćerav tumenđe?”<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />Phende lese: “Gospode, manga te dikha.”<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />E Isusese pelo žal thaj dolda lenđe jakha. Tari jekh drom dikhlje thaj đele pale leste.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">O Isus avol ano Jerusalim</para>
  <para style="r">(<ref loc="MRK 11:1-11">Mk 11,1–11</ref>; <ref loc="LUK 19:28-38">Lk 19,28–38</ref>; <ref loc="JHN 12:12-19">Jn 12,12–19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Kana avile pašo Jerusalim thaj avile anglo gav i Vitfaga ki Maslinsko gora, o Isus bičhalda anglal duje sikaden <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />thaj vaćarda lenđe: “Džan ano gav angle tumende, ka araćhen hernja kaj si phangli thaj terne here lasa. Putaren len thaj anen len mande. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Te pučlja tumen khoni bilo so, vaćaren: ‘Trubun e Gospodese’ thaj sigate ka mućhen len.” <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />A kava sasa te bi pherdola so vaćarda o proroko:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />“Vaćaren e manušenđe ano Jerusalim:</para>
  <para style="q1" vid="MAT 21:5">‘Ake, ćiro Caro avol tute,</para>
  <para style="q1" vid="MAT 21:5">ponizno thaj uklilo po her,</para>
  <para style="q1" vid="MAT 21:5">thaj po terno her, po čhavo e hernjako.’”<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Thaj e sikade đele, i ćerde sar vaćarda lenđe o Isus. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Ande lese e hernja em e terne here thaj čhute pe fostanura pe lende te šaj o Isus te bešol. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />But manuša buljarde pe fostanura, a avera čhinde cikne raja thaj buljarde po drom. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />A e manuša save đele angle leste thaj pale leste, dije vika vaćarindoj:</para>
  <para style="q1" vid="MAT 21:9">“Hosana e Čhavese e Davideso!</para>
  <para style="q1" vid="MAT 21:9">Blagoslovimo si kova savo avol ano alav e Gospodeso!</para>
  <para style="q1" vid="MAT 21:9">Hosana e Devlese ko učipe!”<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Kana o Isus dija ano Jerusalim, uzbunisajle sa e manuša ano foro thaj pučlje: “Ko si kava?”<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />A pherdo manuša vaćarde: “Kava si o proroko o Isus taro Nazaret ani Galileja.”<verse eid="MAT 21:11" /></para>
  <para style="s">O Isus tradol e trgovcuren andaro Hram</para>
  <para style="r">(<ref loc="MRK 11:15-19">Mk 11,15–19</ref>; <ref loc="LUK 19:45-48">Lk 19,45–48</ref>; <ref loc="JHN 2:13-22">Jn 2,13–22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />O Isus dija ano Hram thaj tradija savoren so bićinena thaj ćinena ano Hram. Perada e astalura kolenđe so menjina e pare thaj e klupe kolenđe kaj bićinde goluburen.<verse eid="MAT 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 21:13" />Thaj vaćarda lenđe: “Ano Sveto lil ačhol: ‘O ćher mingro nek akhardol ćher e molitvako’, a tumen lestar ćerden ‘ćher kaj garaven pe e čora.’”<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Thaj avile ano Hram pašo Isus e kore thaj e banđe thaj vov sastarda len.<verse eid="MAT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 21:15" />Kana dikhlje e šorutne sveštenikura thaj e učitelja tare Mojsijaso zakon e čudura save vov ćerda thaj šunde e čhaven kaj den vika ano Hram: “Hosana e Čhavese e Davideso,” holajle but <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />thaj phende lese: “Šune li kala so vaćaren?”</para>
  <para style="p" vid="MAT 21:16">A o Isus vaćarda lenđe: “Va! Džanav kaj čitisaden ano Sveto lil: ‘Ćerdan te slavin tut e čhavore thaj e cikne čhave save pijen čuči?’”<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Pale gova ačhada len, iklilo taro foro ani Vitanija thaj presuta gothe.<verse eid="MAT 21:17" /></para>
  <para style="s">I smokva šućol sar so vaćarda o Isus</para>
  <para style="r">(<ref loc="MRK 11:12-14">Mk 11,12–14</ref>, <ref loc="MRK 11:20-24">20–24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Kana o Isus sabalje irisajlo ano Jerusalim, bokhajlo. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Thaj dikhlja jekh smokva pašo drom, avilo paše late, al ni arakhlja khanči, samo patrna.</para>
  <para style="m" vid="MAT 21:19">Golese phenda laće: “Nikad vadži ma te avol bijanipe pe tute ko džuvdipe.”</para>
  <para style="m" vid="MAT 21:19">Sigate i smokva šućili.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Kana gova dikhlje e sikade, čudisajle thaj vaćarde: “Sar gija sigate šućili i smokva?”<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />A o Isus phenda lenđe: “Čače vaćarav tumenđe, ako pačan thaj ni sumnjin, ka ćeren na samo kava so me ćerdem e smokvasa, nego te vaćarden kale bregose te čhudol pe ano more, gija ka avol. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Te pačajen, ka dol pe tumenđe sa so ka manđen ani molitva.”<verse eid="MAT 21:22" /></para>
  <para style="s">Kotar e Isusese vlast?</para>
  <para style="r">(<ref loc="MRK 11:27-33">Mk 11,27–33</ref>; <ref loc="LUK 20:1-8">Lk 20,1–8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Kana o Isus đelo ano Hram, lija te sikavol. Avile leste e šorutne sveštenikura thaj e starešine e narodose thaj pučlje le: “Save vlastesa kava ćere? Ko dija tut kava autoritet?”<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />A o Isus phenda lenđe: “Thaj me ka pučav tumen khanči. Te vaćarden manđe, i me ka vaćarav tumenđe save vlastesa kava ćerav. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />O Dol li vaćarda e Jovanese te krstil e manušen, il e manuša vaćarde lese gova te ćerol?”</para>
  <para style="m" vid="MAT 21:25">A von dije pe gođi maškar peste vaćarindoj: “Te vaćardam: ‘O Dol vaćarda lese,’ ka pučol amen: ‘Sose ni pačajen e Jovane?’ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Al te vaćardam: ‘E manuša vaćarde lese gova te ćerol’, ka dara tare manuša, golese so savore dikhlje e Jovane sar proroko.”<verse eid="MAT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27" />Thaj irisade vaćarindoj e Isusese: “Ni džana.”</para>
  <para style="m" vid="MAT 21:27">Tegani o Isus vaćarda lenđe: “Ni me onda ni vaćarav tumenđe save vlastesa me ćerav kava.”<verse eid="MAT 21:27" /></para>
  <para style="s">O Isus vaćarol paramič tare duj čhave</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />“So den gođi tare kava? Jekh manuš sasa le duj čhave. Avilo ki jekh thaj vaćarda lese: ‘Mo čhavo! Dža thaj ćer bući avđive ane mo vinograd.’ <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />A vov vaćarda lese: ‘Ni mangav.’ Al pale gova predomislisajlo thaj đelo. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Avilo e dujtonese thaj vaćarda isto gova. A vov vaćarda: ‘Mangav, gospodarona.’ Al ni đelo. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />Savo tare kala duj ćerda o manglipe e dadeso?”</para>
  <para style="m" vid="MAT 21:31">A von vaćarde lese: “O angluno.”</para>
  <para style="p" vid="MAT 21:31">O Isus vaćarda: “Čače vaćarav tumenđe, kaj e carincura thaj e bludnice angleder tumendar ka džan ano Carstvo e Devleso. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Golese so avilo o Jovane o Krstitelj te sikavol tumenđe o pravedno drom taro džuvdipe, a ni pačajen le, al e carincura thaj e bludnice pačaje le. Tumen gova dikhljen, al ni predomislisaljen thaj ni pačajen le.”<verse eid="MAT 21:32" /></para>
  <para style="s">O Isus vaćarol paramič tare bilačhe vinogradara</para>
  <para style="r">(<ref loc="MRK 12:1-12">Mk 12,1–12</ref>; <ref loc="LUK 20:9-19">Lk 20,9–19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />“Šunen i dujto paramič: Sasa manuš ćherutno savo sadisada po vinograd, nakhada le ke riga ogradasa, honda than kaj gazil pe i drakh thaj vazdija stražarsko kula. Tegani dija le ano zakup e vinogradarenđe thaj đelo ko drom. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Kana avilo o vreme te ćidol pe i drakh, bičhalda e slugen te len leso kotor taro bijanipe e drakhako. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />E vinogradara dolde e slugen thaj jekhe marde, avere mudarde, a pi jekh čhudije bara thaj mudarde le. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Tegani bičhalda averen slugen, po bute dženen nego angleder, a gija i lenđe ćerde. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Ko krajo bičhalda lenđe pe čhave vaćarindoj: ‘Ka poštujin me čhave.’<verse eid="MAT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38" />Al kana e manuša save ćerde bući ano vinograd dikhlje lese čhave, phende maškar peste: ‘Kava si o nasledniko. Aven te mudara le thaj sa amenđe te ačhol.’ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Thaj dolde le, ikalde le taro vinograd avral thaj mudarde le.”<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />Tegani o Isus pučlja: “Kana ka avol o manuš kaso sasa o vinograd, so ka ćerol kolenđe so ćerde bući ano vinograd?”<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />Vaćarde lese: “Ka mudarol len bizo milost golese so sesa bilačhe thaj o vinograd ka dol ano zakup avere vinogradarenđe, save ka den o bijanipe ano vreme e ćidimaso.”<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Vaćarda lenđe o Isus: “Džanav kaj čitisaden ano Sveto lil:</para>
  <para style="q1" vid="MAT 21:42">‘O bar savo čhudije e manuša save vazden e duvara</para>
  <para style="q2" vid="MAT 21:42">ćerdilo emglavno bar taro ćher.</para>
  <para style="q1" vid="MAT 21:42">Gova ćerda o Dol</para>
  <para style="q2" vid="MAT 21:42">thaj čudesno si ane amare jakha.’<verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />Golese phenav tumenđe kaj tumendar ka lol pe o Carstvo e Devleso thaj ka dol pe manušenđe save ka anen čačukano bijanipe. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Thaj ko perol ke gova bar ka phađol; a pe kaste gova bar perol, ka zgnječil le.”<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Kana šunde e šorutne sveštenikura thaj e fariseja lese paramiča, haljarde kaj kava lendar vaćarol. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Thaj dikhlje sar te dolen le, al darajle tare manuša, golese so dikhlje e Isuse sar proroko.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">O Isus vaćarol paramič taro abav</para>
  <para style="r">(<ref loc="LUK 14:15-24">Lk 14,15–24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />O Isus vaćarda lenđe palem ane paramiča: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“O Carstvo e neboso si sar kana nesavo caro ćerda abav pe čhavese. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />O caro bičhalda pe slugen te den vika kolen so sesa akharde ko abav, al khoni ni manglja te avol.<verse eid="MAT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4" />Palem bičhalda avere slugen thaj vaćarda lenđe: Phenen e akhardenđe: ‘Akh o xape ćerdilo, čhindem e guruven thaj me tovime stoka thaj sa si ćerdo. Aven ko abav.’<verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />A von ni šunde thaj đele jekh ki pi njiva a aver đelo te biknol. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Avera dolde lese slugen, marde len thaj mudarde len.<verse eid="MAT 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 22:7" />Thaj o caro holajlo, bičhalda pe vojska te mudaren gole ubicen thaj te phabaren lengo foro.<verse eid="MAT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8" />Tegani vaćarda pe slugenđe: ‘Akh, o abav si ćerdo, a e akharde ni sesa dostojna te aven. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Golese, džan ke droma save ikljen taro foro thaj kas araćhen, akharen ko abav!’ <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />E sluge đele pe droma thaj ćidije sa kas arakhlje, bilačhen thaj šukaren, gija i dvorana e abavesi pherdili.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />Kana avilo o caro te dićhol e gosturen, dikhlja manuše savo ni sasa urado ane abavese šeja. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Pučlja le: ‘Amala, sar aviljan akari bize abavese šeja?’ Al vov khanči ni vaćarda.<verse eid="MAT 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13" />Tegani vaćarda o caro pe slugenđe: ‘Phanden lese vasta thaj lese pingre thaj čhuden le avral em dur ano embaro mrako, gothe but ka roven thaj ka škripin dandencar.’<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />Golese so but si akharde a zala odabirime.”<verse eid="MAT 22:14" /></para>
  <para style="s">O Isus vaćarol taro porezi e carose</para>
  <para style="r">(<ref loc="MRK 12:13-17">Mk 12,13–17</ref>; <ref loc="LUK 20:20-26">Lk 20,20–26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Tegani e fariseja đele thaj dogovorisajle sar te dolen e Isuse ano lafi. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Bičhalde ko Isus pe sikaden thaj e Irodese manušen thaj phende lese: “Učitelju! Džana kaj vaćare čačipe thaj sikave e Devleso drom ano čačipe, ni obaziri tu pe khanikaste, golese so ni dićhe ko si ko. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Vaćar amenđe so tu misli: Trubul li te da porezi amen e Jevreja e rimskone carose il na?”<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Haljarda o Isus so von bilačhe dije gođi thaj phenda lenđe: “Tumen dujemujenđe! Sose ćeren manđe zamka? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Sikaven manđe i poresko parava.”</para>
  <para style="m" vid="MAT 22:19">Thaj von ande lese dinari. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />O Isus pučlja len: “Kaso si muj thaj alav ke kala pare?”<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />Vaćarde lese: “E caroso.”</para>
  <para style="p" vid="MAT 22:21">Tegani vov vaćarda lenđe: “Den e carose so si e caroso, a e Devlese so si e Devleso.”<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Kana šunde le, divisajle, ačhade le thaj đele.<verse eid="MAT 22:22" /></para>
  <para style="s">E sadukeja pučen e Isuse taro uštipe tare mule</para>
  <para style="r">(<ref loc="MRK 12:18-27">Mk 12,18–27</ref>; <ref loc="LUK 20:27-40">Lk 20,27–40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Gova đive avile paše leste e sadukeja save vaćaren kaj naj uštipe tare mule thaj pučlje le: <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />“Učitelju! O Mojsije amenđe dija zakon: Ako merol murš kas sasa romni a naj len čhave, trubul te lol o phral lese romnja thaj te bi voj bijanola murše savo ka nasledil pe dade thaj te inđarol leso alav. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Ke amende sasa efta phrala. Angluno lija romnja thaj mulo thaj golese so naj sasa le čhave, ačhada pe romnja pe phralese. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Gija mulo i o dujto pa i o trito, sa dži ko eftato phral. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Thaj ko krajo i romni muli. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Ko uštipe tare mule, kasi romni ka avol tare efta phrala, golese so savorenđi sasa romni?”<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />O Isus vaćarda lenđe: “Ano xoxaipe sen, golese so ni haljarden o Sveto lil ni o zuralipe e Devleso! <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Ane aver džuvdipe, kana ka ušten tare mule e manuša, ni ka len pe niti ka den pe, al ka aven sar anđelura ano nebo. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />A bašo uštipe tare mule, džanav kaj čitisaden ano Sveto lil so vaćarda tumenđe o Dol: <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘Me sem Dol e Avraameso, Dol e Isaakoso thaj Dol e Jakoveso’ a von mule odavno. O Dol naj Dol e mulengo, al vov si Dol e džuvdengo!”<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Kana šunde kava e but manuša, čudisajle lese sikajimasa.<verse eid="MAT 22:33" /></para>
  <para style="s">O Isus sikavol tare emvažna zapovestura</para>
  <para style="r">(<ref loc="MRK 12:28-34">Mk 12,28–34</ref>; <ref loc="LUK 10:25-28">Lk 10,25–28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Kana e fariseja šunde kaj o Isus phanglja e muja e sadukejenđe, ćidije pe katane. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Jekh tare učitelja taro Mojsijaso zakon manglja te ćerol lese zamka thaj pučlja le: <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“Učitelju! Savo si emvažno zapovest ano zakon?”<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />O Isus vaćarda: “‘Mang e Gospode, ćire Devle sa ćire ilesa, sa ćire dušasa thaj sa ćire gođasa!’ <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Kava si angluno thaj emvažno zapovest. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />A o dujto si slično sar angluno zapovest: ‘Mang ćire pašutne sar korkore tut!’ <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Pe kala duj zapovestura ačhen sa avera zapovestura ano zakon thaj ane lila save pisisade e prorokura.”<verse eid="MAT 22:40" /></para>
  <para style="s">O Hrist si po baro taro caro o David</para>
  <para style="r">(<ref loc="MRK 12:35-37">Mk 12,35–37</ref>; <ref loc="LUK 20:41-44">Lk 20,41–44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Dži kaj sesa e fariseja katane, pučlja len o Isus: <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />“So den gođi bašo Hrist? Kaso si čhavo?”</para>
  <para style="p" vid="MAT 22:42">E fariseja vaćarde lese: “E Davideso.”<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />A vov phenda lenđe: “Sose o David ano Duxo akharol e Hriste, pe Gospode kana vaćarol:<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />‘Vaćarda o Gospod e Gospodese mingrese:</para>
  <para style="q2" vid="MAT 22:44">Beš manđe ki desno rig,</para>
  <para style="q2" vid="MAT 22:44">sa dži kaj ni čhuvav ćire dušmajen tale pingre’?<verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Gija kana o David akharol le ‘Gospode’, sar šaj te avol leso čhavo?”<verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />Thaj khoni naštine te iril lese ke kava pučipe. Thaj tare gova đive ni tromaje te pučen le khanči.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Efta prekora e učiteljenđe taro Zakon thaj e farisejenđe</para>
  <para style="r">(<ref loc="MRK 12:38-40">Mk 12,38–40</ref>; <ref loc="LUK 11:37-52">Lk 11,37–52</ref>; <ref loc="LUK 20:45-47">20,45–47</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Tegani o Isus vaćarda e manušenđe thaj pe sikadenđe: <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />“E učitelja tare Mojsijaso zakon thaj e fariseja bešle ko than e Mojsijaso te tumačin o zakon. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Golese, aven pažljiva te ćeren sa so vaćaren tumenđe. Al ma ćeren kova so von ćeren, golese so von ni ćeren so vaćaren. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Phanden but baro pharipe savo jedva šaj inđaren thaj čhuven e manušenđe pe dume, a najesa ni manđen te mrdin te pomožin lenđe.<verse eid="MAT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5" />Gija, sa so ćeren, ćeren te bi dićhena len e manuša. Bararen pe e kutijice e lafurencar taro Sveto lil ko čikat thaj ke vasta a ćeren bare rese pe pe fostanura. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Manđen počasna thana ke abava thaj anglune thana ke sinagoge. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />Manđen e manuša sa poštovanje te pozdravin len ke javna thana thaj te akharen len ‘Učitelju!’<verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />Ma tumen te akhardon ‘učitelj,’ golese so isi tumen samo jekh Učitelji, a tumen sen sa phrala thaj pheja. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Thaj ‘Dade’ ma akharen nikas ki phuv, golese so isi tumen samo jekh Dad, savo si ko nebo. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Ma tumen te akhardon ‘vođa’, golese so isi tumen samo jekh Vođa, o Hrist. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />A embaro maškare tumende te avol kova savo služil! <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Golese so, ko pes vazdol, ka avol ponizimo, thaj ko pes ponizil, ka avol vazdimo.<verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />Pharo tumenđe učiteljuralen tare Mojsijaso zakon thaj farisejalen, dujemujenđe! Golese so phanden e vudara e manušenđe taro Carstvo e neboso. Korkore ni den andre, niti den avera te džan save manđen. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />[Pharo tumenđe učiteljuralen taro Mojsijaso zakon thaj farisejalen, dujemujenđe! Golese so xan e ćhera e udovicenđe thaj molin tumen but te bi ačhavena lačho utisko pe manuša. Golese o Dol ka osudil tumen pobut.] <verse eid="MAT 23:14" /><verse number="15" style="v" sid="MAT 23:15" />Pharo tumenđe učiteljuralen tare Mojsijaso zakon thaj farisejalen, dujemujenđe! Golese so naćhen o more thaj i phuv te bi prelena jekhe manuše ani tumari vera, savo ka džal pale tumende thaj kana len le, ćeren le te avol čhavo taro pakao duj droma po bilačho nego so sen tumen!<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />Pharo tumenđe! Tumen, e kore vođe save vaćaren: ‘Ako khoni xal sovli e Hramesa gova naj khanči. A ako khoni xal sovli ano zlato e Hrameso, dužno si te ićarol goja sovli.’ <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Tumen e dile thaj e kore! So si po baro, o zlato il o Hram, savo ćerol o zlato te avol sveto? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Thaj vaćaren: ‘Ako khoni xal sovli po žrtveniko, gova naj khanči. A ako khoni xal sovli e darosa so anol pe ko žrtveniko, dužno si te ićarol goja sovli.’ <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Tumen e kore! So si po baro, o daro il o žrtveniko ke savo ćerol pe o sveto daro? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Ko xal sovli e žrtvenikosa, xal sovli e žrtvenikosa thaj sa so si pe leste. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Thaj ko xal sovli e Hramesa, xal sovli e Hramesa thaj e Devlesa savo bešol ane leste. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Thaj ko xal sovli e nebosa, xal sovli ko presto e Devleso thaj e Devlesa so bešol pe leste.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />Pharo tumenđe učiteljuralen tare Mojsijaso zakon thaj farisejalen, dujemujenđe! Golese so den dešto kotor tari nana, tari mirođija thaj taro kimo, a ačhaden so si emvažno ano Zakon: i pravda, o milosrđe thaj o pačajipe. Trubul te den dešto kotor, al ni trubun te ačhaven e považna buća. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Kore vođe! Cedin o paj te ma bi pijena e komarco, a e kamila gutin!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />Pharo tumenđe učiteljuralen tare Mojsijaso zakon thaj farisejalen, dujemujenđe! Golese so halaven avral o tahtaj thaj o čaro, a izandral pherden le grabipe thaj pohlepa. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Koreja farisejona! Thov angleder o tahtaj thaj o čaro andral, te ave i avral thodo.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />Pharo tumenđe učiteljuralen tare Mojsijaso zakon thaj farisejalen, dujemujenđe! Golese so sen sar makhle limora ano parno, save avral dićhen pe lačhe a andre si pherde kokala mulikane thaj but melalipe! <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Gijate i tumen dićhon avral sar pravedna, a izandral sen pherde dujemujencar thaj bizakonesa.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />Pharo tumenđe učiteljuralen tare Mojsijaso zakon thaj farisejalen, dujemujenđe! Golese so ćeren limora e prorokurenđe thaj lačharen e spomenikura e čačutnenđe. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Thaj vaćaren: ‘Te avasa amen ano vreme amare paradadengo, ne bi učestvujisa lencar ane gova o rat e prorokurengo te thavdol.’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Gijate svedočin tumenđe kaj sen čhave kolendar save mudarde e prorokuren. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Dovršin, gija, kova so tumare paradada počnisade!<verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />Tumen sapalen thaj otrovno bijandipe! Sar ka našen tari kazna savasa sen osudime ki jag savi ni ačhol? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Golese akh, me ka bičhalav tumenđe prorokuren, mudrakuren thaj učiteljuren tare Mojsijaso zakon. Tumen jekhen ka mudaren thaj ka čhuven ko krsto, a dujtonen ka maren bičosa ane tumare sinagoge thaj ka traden len taro foro dži ko foro, <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />golese ka aven banđe bašo mudaripe sa e nedužna manuša ki phuv – taro mudaripe e Aveljeso e pravednikoso, dži o mudaripe e Zaharijaso o čhavo e Varahijaso, kas tumen, e Jevreja, mudarden maškaro sveto than e hrameso thaj o žrtveniko. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Čače vaćarav tumenđe, kaj sa kaja kazna bašo mudaripe ka perol pe kava bijandipe!”<verse eid="MAT 23:36" /></para>
  <para style="s">O Isus rovol e Jerusalimese</para>
  <para style="r">(<ref loc="LUK 13:34-35">Lk 13,34–35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />O Isus vadži vaćarda: “Jerusalime, Jerusalime, savo mudare e prorokuren thaj čhude bara pe kola saven bičhalda o Dol tuće! Kobor droma mangljem te ćidav ćire čhavoren, sar i khanji pe pujoren tale pe phaka, al ni mangljen! <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Akh, tumaro ćher ka ačhol pusto thaj čučo. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Golese so phenav tumenđe: Ni ka dićhen man vadži, sa dok ni vaćaren: ‘Blagoslovimo si kova savo avol ano alav e Gospodeso!’”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">O Isus vaćarol tare Hrameso peraipe thaj taro početno bilačhipe</para>
  <para style="r">(<ref loc="MRK 13:1-2">Mk 13,1–2</ref>; <ref loc="MRK 13:3-13">13,3–13</ref>; <ref loc="LUK 21:5-6">Lk 21,5–6</ref>; <ref loc="LUK 21:7-19">21,7–19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Thaj kana iklilo o Isus andaro Hram, đelo gothar thaj avile paše leste lese sikade te sikaven lese e zgrade taro Hram.<verse eid="MAT 24:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 24:2" />A o Isus pučlja len: “Dićhen li sa kava? Čače vaćarav tumenđe, ni ka ačhol ni bar po bar. Dži jekh ka avol perado.”<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />A kana o Isus bešlo ko Maslinsko brego, avile e sikade korkore thaj pučlje le: “Phen amenđe, kana gova ka avol? Thaj savo znako ka phenol tare ćiro avipe thaj o kraj e svetoso?”<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Thaj o Isus vaćarda lenđe: “Araćhen tumen khoni te ma xoxavol tumen. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Golese so but džene ka aven thaj ka vaćaren: ‘Me sem o Hrist’. Thaj buten ka xoxaven. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Ka šunen paše tumende si maripe thaj glasura taro maripe save si dur. Dićhen te ma daran, golese so trubul gijate te avol, al gova vadži naj krajo. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Golese so ka uštol o narodo pe narodura thaj o carstvo pe carstvura. Thaj ka avol bokhalipe, i phuv ka tresil pe ke but thana. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />A gova sa si samo anglunipe tare bare muke, sar kana i romni trubul te bijanol.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />Tegani ka den tumen te aven mučime, ka mudaren tumen thaj sa e manuša ka mrzin tumen, golese so sen mingre. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Tegani but ka peren taro pačajipe, jekh avere ka izdol thaj jekh avere ka mrzil. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Ka ikljen but xoxavne prorokura thaj ka xoxaven pherdonen. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Golese, sa so ka avol po baro bizakono, o manglipe ka šudrol ke butende, <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />al savo trpil dži ko kraj, ka spasil pe. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Thaj ka vaćarol pe taro Lačho Lafi ke sa o sveto za ko svedočanstvo taro Carstvo e neboso sa e narodurenđe thaj tegani ka avol o kraj.<verse eid="MAT 24:14" /></para>
  <para style="s">Baro bilačhipe</para>
  <para style="r">(<ref loc="MRK 13:14-23">Mk 13,14–23</ref>; <ref loc="LUK 21:20-24">Lk 21,20–24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />Gija, kana dićhen e ‘grozote save anen uništipe’, taro savo vaćarol o proroko Danilo, sar ačhon ko sveto than ano Hram (savo čitil kava, nek haljarol), <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />tegani kola save ka aven ani Judeja te našen pe bregura. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Thaj ko si po ćher ma te uljol tele te bi lola khanči andaro ćher! <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Thaj ko si ano polje ma te iril pe te bi lola po fostano! <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Pharo e khamnjenđe thaj kole džuvljenđe save den čuči ane gola đivesa! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Molin tumen te ma avol tumaro našipe ano jevend niti ko savato! <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Golese so ka avol gasavo bilačhipe savo ni sasa taro anglunipe e svetoso pa i ni ka avol posle. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Thaj o Dol te ma skratila o đinipe gole đivesengo, nijekh manuš ne bi spasila pe, al baše kola saven o Dol birisada ka kratin pe gola đivesa.”<verse eid="MAT 24:22" /></para>
  <para style="s">O Isus vaćarol tare piro iripe</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />“Tegani te khoni phenda: ‘Akh kate si o Hrist!’, il ‘Ektalo odori!’, ma pačan. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Golese so ka ikljen xoxavne hristura thaj xoxavne prorokura thaj ka sikaven bare znakura thaj čudesura te bi xoxavena, te šaj, čak i e Devlese birimen. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Akh, vaćarav tumenđe angleder so ka avol!<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />A te vaćarde tumenđe: ‘Ektalo ani pustinja’, ma ikljen, a te vaćarde: ‘Aktalo ane garade thana’, ma pačan. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Golese, ka dićhol sar i munja so ikljol ko istok thaj svetlil ko zapad, gasavo ka avol o sikajipe mingro, e Čhaveso e manušeso. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Gova ka avol jasno gija sar kana e lešinara ćiden pe odori kaj si o mulo telo.”<verse eid="MAT 24:28" /></para>
  <para style="s">Taro dujto avipe e Isuseso</para>
  <para style="r">(<ref loc="MRK 13:24-31">Mk 13,24–31</ref>; <ref loc="LUK 21:25-33">Lk 21,25–33</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />“A sigate palo bilačhipe gole đivesengo,</para>
  <para style="q1" vid="MAT 24:29">‘o kham ka kaljol,</para>
  <para style="q2" vid="MAT 24:29">thaj o čhon ka hasarol po svetlost,</para>
  <para style="q1" vid="MAT 24:29">thaj e čerenja ka peren taro nebo,</para>
  <para style="q2" vid="MAT 24:29">thaj e zora e nebose ka tresin pe.’<verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />Tegani ka sikadol o znako e Čhaveso e manušeso ko nebo thaj but ka roven sa e plemenura ki phuv thaj ka dićhen e Čhave e manušese sar avol pe oblakura e zuralimasa thaj e bara slavasa. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Vov ka bičhalol pe anđeluren bare glasosa tare trube thaj ka ćiden e birimen tare štar balvalja, taro jekh krajo dži o dujto krajo e neboso.”<verse eid="MAT 24:31" /></para>
  <para style="s">O Isus vaćarol o sikajipe tari smokva</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />O Isus vadži vaćarol: “Sikljon kaja paramič tari smokva: Kana pe laće raja ikljen pupoljkura thaj mućhen patrna, džanen kaj si o milaj paše. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Gija i tumen kana ka dićhen sa kava so phendem tumenđe, te džanen kaj si o vreme paše, anglo vudar. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Čače vaćarav tumenđe: Kava bijandipe ni ka naćhol, dži kaj sa kava ni avol. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />O nebo thaj i phuv ka naćhol, al me lafura ni ka naćhen.”<verse eid="MAT 24:35" /></para>
  <para style="s">Khoni ni džanol o đive thaj o sato kana ka sikadol o Isus</para>
  <para style="r">(<ref loc="MRK 13:32-37">Mk 13,32–37</ref>; <ref loc="LUK 17:26-30">Lk 17,26–30</ref>, <ref loc="LUK 17:34-36">34–36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />“Al khoni gova đive thaj gova sato ni džanol kana gova ka avol. Ni džanen ni e anđelura taro nebo, pa ni me, o Čhavo. Džanol samo o Dad. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Golese sar so sasa ano vreme e Nojaso, gija ka avol kana me, o Čhavo e manušeso, ka avav. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Golese, sar so ane gola đivesa anglo potop e manuša xalje thaj pilje, lije pe thaj dije pe dži kova đive kana o Noja đelo ano brodo <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />thaj ni džanglje khanči so ka avol dži kaj ni avilo o potop thaj inđarda sa, gija ka avol i kana me, o Čhavo e manušeso, ka avav. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Tegani duj ka aven ki njiva, jekh ka lol pe, a jekh ka ačhol. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Tare duj džuvlja katane so meljin ko mlin, jekh ka lol pe a jekh ka ačhol.<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />Aven džungade, golese so ni džanen ane savo đive ka avol tumaro Gospod. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Al kava te džanen: Kana bi džanola o ćherutno ane savo sato ka avol o čor, vov bi avola džungado te ne bi dola te avol andre ano ćher. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Gija i tumen aven pripravna, golese so me, o Čhavo e manušeso, ka avav kana ni ađućaren man.”<verse eid="MAT 24:44" /></para>
  <para style="s">O Isus vaćarol paramič taro verno sluga</para>
  <para style="r">(<ref loc="LUK 12:41-48">Lk 12,41–48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />O Isus vadži vaćarol: “Verno thaj džanglo sluga si kova kas o gospodari čhuta pe sa aver sluge te dol len xamase ane šukar vreme. <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Blago gole slugase, kana avol leso gospodari e ćhereso thaj araćhol le kaj gija ćerol!<verse eid="MAT 24:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 24:47" />Čače vaćarav tumenđe: Ka čhuvol le te upravil sa kolesa so isi le. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Ako si gova sluga bilačho ka vaćarol ane peste: ‘Ni ka avol mo gospodari e ćhereso vadži but vreme’, <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />thaj lol te marol avere slugen thaj xal thaj pijol e matencar, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />ka avol o gospodari e ćhereso gole slugaso ano đive kana vov ni ađućarol le thaj ano sato kana vov ni ka džanol. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Ka čhinol le ke opaš, ka dol le plata sar kole dujemujenđe, gothe but ka roven thaj ka škripin dandencar.”<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">O Isus vaćarol paramič tare deš čheja</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />O Isus vadži vaćarda: “Tegani o Carstvo e neboso ka avol sar deš čheja save lije pe lampe thaj iklile anglo mladoženja. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Pandž sesa bigođaver a pandž gođaver. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />E bigođaver lije e lampe al inđarde pesa zala ulje <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />a e gođaver lije pesa ulje ane čare pe lampencar. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />A sar o mladoženja kasnisada, e čhejenđe jakha phanglile thaj gija zasute.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />A ki opaš i rat šundilo: ‘Ek avol o mladoženja! Ikljen angle leste!’<verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />Tegani uštile sa e čheja thaj lije te lačharen pe lampe.<verse eid="MAT 25:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 25:8" />E bigođaver čheja vaćarde e gođaverenđe: ‘Den amen zala ulje tumaro, golese so amare lampe ka ačhadon.’<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />A e gođavera čheja vaćarde lenđe: ‘Našti! Te ma bi ačhasa i amen i tumen, pošukar džan ke manuša save biknen thaj ćinen tumenđe ulje.’<verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />A kana e bigođaver čheja đele te ćinen ulje, avilo o mladoženja thaj e čheja save sesa spremna đele lesa andre ko abav, a e vudara phanglile. <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" />Posle avile i avera čheja vaćarindoj: ‘Gospodarona! Gospodarona! Putar amenđe!’<verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />A o mladoženja phenda e bigođaverenđe: ‘Čače phenav tumenđe: Ni pindžarav tumen.’<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />Golese, aven džungade, kaj ni džanen o đive thaj o sato kana me, o Čhavo e manušeso, ka avav!”<verse eid="MAT 25:13" /></para>
  <para style="s">O Isus vaćarol paramič tare kese e zlatosa</para>
  <para style="r">(<ref loc="LUK 19:11-27">Lk 19,11–27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />“O nebesko carstvo si sar o manuš savo pojdisada ko drom thaj dija vika pe slugen thaj mukhlja lenđe po barvalipe te araćhen le. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Thaj jekhese mukhlja pandž kese zlatosa, dujtonese duj, a e tritonese jekh, svakonese pale leso sposobnost. Pale gova, đelo ko drom. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Kova so lija pandž kese zlatosa, đelo sigate thaj ćerda bući lencar thaj zaradisada vadži pandž. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Gija i kava so lija duj zaradisada vadži duj. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />A savo lija jekh kesa zlatosa, đelo thaj honda rupa ani phuv thaj garada o zlato pe gospodareso.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />Pale but đivesa avilo o gospodari gole slugengo thaj manglja te dićhol so ćerde lese parencar. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Thaj avilo kova so lija pandž kese zlatosa, anda vadži pandž thaj vaćarda: ‘Gospodarona! Dijan man pandž kese zlatosa. Akh, me zaradisadem tuće vadži pandž.’<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />A o gospodari vaćarda lese: ‘Šukar, slugo šukareja thaj pačavneja! Ane cikno sana manđe verno, golese ka čhuvav tut te upravi ke but. Av te raduji tut će gospodaresa.’<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />Avilo i kova so lija duj kese zlatosa thaj vaćarda: ‘Gospodarona! Dijan man duj kese zlatosa. Akh, me zaradisadem tuće vadži duj.’ <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />A o gospodari vaćarda lese: ‘Šukar, slugo šukareja thaj pačavneja! Ane cikno sana manđe verno, golese ka čhuvav tut te upravi ke but. Av te raduji tut će gospodaresa.’<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />Avilo kova so lija jekh kesa zlatosa thaj vaćarda: ‘Gospodarona! Džanav kaj san tu zuralo manuš, ćide kaj ni sejisadan, a le kaj ni vejisadan. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Golese daraljem thaj đeljem thaj garadem ći kesa e zlatosa ani phuv. Ake tuće ći kesa!’<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />A o gospodari leso vaćarda: ‘Bilačheja thaj bibućarneja slugo! Džangljan kaj ćidav kaj ni sejisadem thaj lav kaj ni vijisadem? <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Golese trubujan me pare te de e manušenđe save menjin e pare, a me kana ka avav, lava bi mingro zlato kamatasa.<verse eid="MAT 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28" />Golese, len lestar goja kesa zlatosa thaj den kolese so isi le deš! <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Golese so, svakone kas isi, ka dol pe lese vadži thaj ka avol le ano izobilje, a kole so naj le, ka lol pe i gova so isi le. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Thaj o sluga savo naj korisno čhuden avral emdur, ano embaro mrako. Gothe but ka roven thaj ka škripin dandencar.’”<verse eid="MAT 25:30" /></para>
  <para style="s">O Isus vaćarol taro đive e Sudoso</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />“Kana ka avol o Čhavo e manušeso ani pi slava thaj lese anđelura, tegani ka bešol ke piro slavno presto. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Thaj ka ćiden pe angle leste sa e narodura, a vov ka crdol e manušen jekh averendar, sar o pastiri so crdol e bakren tare buznja. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Thaj ka čhuvol e bakren ki desno rig, a e buzen ki levo rig.<verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />Tegani o Caro ka vaćarol kolenđe save ačhen ki desno rig: ‘Tumen, saven blagoslovisada mo Dad, len o Carstvo savo si tumenđe ćerdo taro postanko e svetoso! <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Golese so, dijen man te xav kana bokhalo sema; dijen man te pijav kana trošalo sema; mukhljen ma andre kana abandžija sema. <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Nango sema thaj uraden man; nasvalo sema thaj aviljen te dićhen man; ano phanglipe sema, aviljen mande.’<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />Tegani ka phenen lese e čačutne: ‘Gospode! Kana gova dikhljam tut bokhale, parvardam tut, il trošale, dijam tut te pije? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Kana gova dikhljam tut sar abandžija, mukhljam tut andre, il nanđe thaj uradam tut? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Kana gova dikhljam tut nasvale il ano phanglipe, aviljam li ke tute?’<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />A o Caro ka vaćarol lenđe: ‘Čače phenav tumenđe, kana ćerden gova jekhese tar me emcikne phralenđe, manđe ćerden!’<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />Tegani ka vaćarol kalenđe kaj si tari levo rig: ‘Džan mandar, prokletonalen, ani jag savi ni ačhol, so si ćerdi e benđese thaj lese anđelurenđe! <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Golese so me sema bokhalo, thaj ni dijen man te xav, sema trošalo, ni dijen man te pijav. <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Abandžija sema, ni mukhljen man andre, nango sema, ni uraden man, nasvalo thaj ano phanglipe sema thaj ni aviljen te dićhen man.’<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />Tegani i von ka vaćaren lese: ‘Gospode! Kana gova dikhljam tut bokhale il trošale, abandžija il nanđe, nasvale il ano phanglipe, a te ni pomožisadam tut?’<verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />Tegani vov ka vaćarol lenđe: ‘Čače vaćarav tumenđe, kana ni ćerden kava i emciknese tar me phrala, ni ćerden ni manđe!’<verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />Thaj kala ka džan ani večno kazna, a e čačutne ano džuvdipe savo ni ačhol.”<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">E jevrejska starešine planirin te mudaren e Isuse</para>
  <para style="r">(<ref loc="MRK 14:1-2">Mk 14,1–2</ref>; <ref loc="LUK 22:1-2">Lk 22,1–2</ref>; <ref loc="JHN 11:45-53">Jn 11,45–53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Kana o Isus završisada sa kava vaćaripe, phenda pe sikadenđe: <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“Džanen kaj baše duj đive si i Pasha. Tegani man, e Čhave e manušese, ka den man thaj ka čhuven ko krsto.”<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Tegani ćidije pe e šorutne sveštenikura thaj e starešine e narodose ani avlin e embare sveštenikosi savo akharda pe Kajafa. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Dogovorisajle sar te dolen e Isuse ko xoxaipe thaj te mudaren le.<verse eid="MAT 26:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 26:5" />A phende: “Na ko prazniko, te ne bi o narodo bunila pe.”<verse eid="MAT 26:5" /></para>
  <para style="s">O Isus pomazimo ani Vitanija</para>
  <para style="r">(<ref loc="MRK 14:3-9">Mk 14,3–9</ref>; <ref loc="JHN 12:1-8">Jn 12,1–8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Kana sasa o Isus ani Vitanija ano ćher e Simoneso o gubavo, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />avili ke leste jekh džuvli thaj sasa la šiši taro mermerno bar ane savo sasa jekh mirisno ulje savo sasa but kuč thaj gova miris čhorda lese po šoro dži kaj bešlo pašo astali.<verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />Kana dikhlje lese sikade gova, holajle but thaj pučlje: “Sose ćerol pe gasavi šteta? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Šajine kava te biknol pe bute parenđe thaj e pare te den pe e čororenđe.”<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />A o Isus džanglja so vaćaren thaj vaćarda lenđe: “So manđen latar? Ćerda manđe šukar bući! <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Golese so čorore ka aven uvek maškar tumende, a me ni ka avav uvek tumencar. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Voj čhorda o mirisno ulje pe mo telo thaj ćerda gova te pripremil man bašo mingro prahope. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Čače vaćarav tumenđe: Dži kaj ka vaćarol pe kava Lačho Lafi pe sa o sveto, ka vaćarol pe za ko spomen thaj voj so ćerda.”<verse eid="MAT 26:13" /></para>
  <para style="s">O Juda planiril te izdajil e Isuse</para>
  <para style="r">(<ref loc="MRK 14:10-11">Mk 14,10–11</ref>; <ref loc="LUK 22:3-6">Lk 22,3–6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Tegani jekh tare Dešuduj (12) apostolura, savo akhardilo Juda Iskariotsko, đelo ke šorutne sveštenikura <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />thaj pučlja len: “Kobor ka den ma ako izdajiv e Isuse?”</para>
  <para style="m" vid="MAT 26:15">A von dije le tranda (30) srebrenjakura. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Tare gova vreme o Juda rodija lačhi prilika sar te izdol e Isuse.<verse eid="MAT 26:16" /></para>
  <para style="s">O Isus bičhalol e sikaden te pripremin i Pasha</para>
  <para style="r">(<ref loc="MRK 14:12-21">Mk 14,12–21</ref>; <ref loc="LUK 22:7-14">Lk 22,7–14</ref>, <ref loc="LUK 22:21-23">21–23</ref>; <ref loc="JHN 13:21-30">Jn 13,21–30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Ko angluno đive taro prazniko e bikvasacose mangrengo avile e sikade ko Isus thaj pučlje le: “Kaj manđe te ćera tuće pashalno večera te xa?”<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Vov vaćarda lenđe: “Džan ano Jerusalim koleste thaj koleste thaj vaćaren lese: ‘O učitelji amaro vaćarol: Mo vreme si paše. Ane ćiro ćher ka slavi i pasha mingre sikadencar.’”<verse eid="MAT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19" />E sikade ćerde sar so o Isus vaćarda thaj pripremisade i pasha.<verse eid="MAT 26:19" /></para>
  <para style="s">O Isus džanol so o Juda ka izdajil le</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Kana peli i rat, o Isus bešlo pašo astali pe Dešuduje (12) apostolurencar.<verse eid="MAT 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 26:21" />Kana xalje, vaćarda lenđe: “Čače vaćarav tumenđe, jekh tumendar ka izdajil man!”<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Von sesa dukhade but thaj jekh pale avereste lije te pučen le: “Te naj sem me gova, Gospode?”<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />O Isus vaćarda: “Ka izdol man kova so bolda mangro mancar ano čaro. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Čače me, o Čhavo e manušeso, mora te merav sar so si pisimo mandar ano Sveto lil, al but pharo kolese ko izdol e Čhave e manušese! Pošukar bi avola lese te ma bijandol!”<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Tegani o Juda, o izdajniko leso, pučlja: “Naj li sem gova me, učitelju?”</para>
  <para style="m" vid="MAT 26:25">O Isus vaćarda lese: “Tu vaćardan korkoro.”<verse eid="MAT 26:25" /></para>
  <para style="s">I Gospodnjo večera</para>
  <para style="r">(<ref loc="MRK 14:22-26">Mk 14,22–26</ref>; <ref loc="LUK 22:15-20">Lk 22,15–20</ref>; <ref loc="1CO 11:23-25">1. Kor 11,23–25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Thaj kana xalje, lija o Isus o mangro, dija hvala, phaglja le thaj dija e sikadenđe vaćarindoj: “Len i xan! Kava si o telo mingro.” <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />Pale gova lija o tahtaj, dija hvala thaj dija len vaćarindoj: “Pijen savore lestar! <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Golese so kava si mingro rat taro Savez, savo ka čhordol bašo oprostipe e grehura bute manušenđe. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Vaćarav tumenđe: Od akana ni ka pijav mol dži kova đive, kana ka pijav tumencar nevi mol ano Carstvo mingre Dadeso.” <verse eid="MAT 26:29" /><verse number="30" style="v" sid="MAT 26:30" />Pale gova đilabije psalmura thaj đele ko Maslinsko brego.<verse eid="MAT 26:30" /></para>
  <para style="s">O Isus phenol kaj savore ka ačhaven le</para>
  <para style="r">(<ref loc="MRK 14:27-31">Mk 14,27–31</ref>; <ref loc="LUK 22:31-34">Lk 22,31–34</ref>; <ref loc="JHN 13:36-38">Jn 13,36–38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Tegani vaćarda lenđe o Isus: “Savore tumen ka ačhaven man kaja rat, golese so ano Sveto lil ačhol:</para>
  <para style="q1" vid="MAT 26:31">‘Ka čalavav e pastire</para>
  <para style="q1" vid="MAT 26:31">thaj e bakre taro stado ka našen.’<verse eid="MAT 26:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />A palo mo uštipe tare mule ka džav angle tumende ani Galileja.”<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />A o Petar vaćarda lese: “Te ačhade tut savore, me ni ka ačhavav tut!”<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />O Isus vaćarda lese: “Čače vaćarav tuće: Ki akaja rat angleder so o bašno ka đilabol, trin droma ka vaćare kaj ni pindžare man.”<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />A o Petar vaćarda lese: “Te trubuja te merav tusa, ni ka vaćarav kaj ni pindžarav tut!”</para>
  <para style="m" vid="MAT 26:35">A gijate vaćarde sa e sikade.<verse eid="MAT 26:35" /></para>
  <para style="s">O Isus molil pe ano Getsimansko vrt</para>
  <para style="r">(<ref loc="MRK 14:32-42">Mk 14,32–42</ref>; <ref loc="LUK 22:39-46">Lk 22,39–46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Tegani avilo o Isus pe sikadencar ano than savo akhardol Getsimanija thaj vaćarda lenđe: “Bešen gothe, dok me džav odori te molima!” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Lija pesa e Petre thaj solduje čhaven e Zevedejese thaj dolda le o žalostipe thaj pharipe. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Tegani vaćarda o Isus: “Mi duša si dži o meripe žalosno. Ađućaren kate thaj aven džungade mancar.”<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Thaj đelo po dur, pelo mujesa dži i phuv thaj molisajlo: “Dade mingreja, te šaj te nakhavol man kava tahtaj tari patnja! Al gija te ma avol so me mangav nego sar so tu manđe.”<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Kana o Isus irisajlo ke pe trin sikade, dikhlja len sar soven. Gija vaćarda e Petrese: “Pa naštine li nijekh sato mancar te aven džungade? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Aven džungade thaj molin tumen te ma peren ano iskušenje, golese so o duxo tumaro manđol te ćerol so si šukar, al o telo tumaro si slabo.”<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Palem o dujto drom đelo thaj molisajlo: “Dade mingreja, te našti te nakhavol man kava tahtaj te ma pijav lestar, nek avol ćiro manglipe!” <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Kana irisajlo, palem arakhlja lese sikade sar soven, golese so lenđe jakha korkore phanglile. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Gija ačhada len, palem đelo thaj trito drom molisajlo vaćarindoj ista lafura.<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />Tegani irisajlo paše pe sikade thaj vaćarda lenđe: “Vadži soven thaj odmorin? Akh, avilo o sato thaj me, o Čhavo e manušeso, ka avav predajimo ane vasta e grešnikurenđe. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Ušten te dža! Akh, kate si mo izdajniko!”<verse eid="MAT 26:46" /></para>
  <para style="s">E Isuse phanden</para>
  <para style="r">(<ref loc="MRK 14:43-50">Mk 14,43–50</ref>; <ref loc="LUK 22:47-53">Lk 22,47–53</ref>; <ref loc="JHN 18:3-12">Jn 18,3–12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Thaj dži kaj o Isus vaćarda, avilo o Juda, jekh tare Dešuduj (12) sikade thaj lesa pherdo manuša čhurencar thaj kaštencar, save sesa bičhalde tare šorutne sveštenikura thaj tare starešine e Jevrejenđe.<verse eid="MAT 26:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 26:48" />A o izdajniko e Isuseso dija len znako vaćarindoj: “Kas čumidav, gova si. Dolen le!”<verse eid="MAT 26:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49" />Thaj sigate avilo pašo Isus thaj phenda lese: “Zdravo, učitelju!” Thaj čumidija le.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />O Isus phenda lese: “Amala! Ćer kova, sose aviljan kate!”</para>
  <para style="p" vid="MAT 26:50">Tegani kola manuša avile, grabisade thaj dolde e Isuse. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Tari jekh drom jekh savo sasa e Isusesa, dolda pe tari bari čhuri, ikalda la thaj čhinda o kan jekhese tare sluge e bare sveštenikose.<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />O Isus tegani vaćarda lese: “Iri i bari čhuri ko than lako, golese ko dolol pe pi čhuri, tari čhuri ka merol. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Dal de gođi kaj me našti te moliv me Dade, te bičhalol manđe sigate pobut tare dešuduj (12) vojske e anđelurenđe? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Al te ćerdem gova, sar bi pherdona e Sveta lila save vaćaren kaj mora gija te avol?”<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Ane gova sato vaćarda o Isus e manušenđe: “Sar palo razbojniko ikliljen čhurencar thaj kaštencar te dolen man? Svako đive bešljem thaj sikadem ano Hram thaj ni dolden man. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Al sa kava sasa te bi pherdona e Sveta lila e prorokurenđe.”</para>
  <para style="m" vid="MAT 26:56">Tegani sa e sikade ačhade le thaj našle.<verse eid="MAT 26:56" /></para>
  <para style="s">O Isus anglo baro sudo</para>
  <para style="r">(<ref loc="MRK 14:53-65">Mk 14,53–65</ref>; <ref loc="LUK 22:54-55">Lk 22,54–55</ref>, <ref loc="LUK 22:63-71">63–71</ref>; <ref loc="JHN 18:13-14">Jn 18,13–14</ref>, <ref loc="JHN 18:19-24">19–24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Kola so dolde e Isuse inđarde le ko baro svešteniko, ko Kajafa, kaj ćidije pe e učitelja tare Mojsijaso zakon thaj e starešine e Jevrejenđe. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />O Petar odural pratisada e Isuse, dži ki avlin e bare sveštenikosi. Dija andre thaj bešlo e stražarencar te bi dićhola so ka avol.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />E šorutne sveštenikura thaj sa o Baro Sudo rodije xoxavne svedočanstvura po Isus te bi mudarena le. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Al ni arakhlje len, iako avile but xoxavne svedokura.</para>
  <para style="m" vid="MAT 26:60">Thaj arakhlje nesar duje xoxavne svedokuren <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />save vaćarde: “Kava manuš phenda: ‘Me šaj phagav o Hram e Devleso thaj baše trin đive te vazdav le.’”<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Pale gova uštilo o baro svešteniko thaj pučlja le: “Sose khanči ni odgovori pe kava so kala manuša svedočin tutar?”<verse eid="MAT 26:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MAT 26:63" />A o Isus khanči ni vaćarda.</para>
  <para style="p" vid="MAT 26:63">O baro svešteniko vaćarda lese: “Xav tut sovli po džuvdo Dol te vaćare amenđe tu li san o Hrist, Čhavo e Devleso?”<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />O Isus vaćarda lese: “Tu vaćardan korkoro. Al me vaćarav tumenđe: Od akana ka dićhen man, e Čhave e manušese, sar bešav ki desno rig ko počasno than e Zurale Devlese thaj avav pe oblakura taro nebo.”<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Tegani o baro svešteniko pharada pe fostanura thaj vaćarda: “Hulil po Dol! So trubun amen avera svedokura? Akana šunden lesi hula. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />So den gođi?”</para>
  <para style="p" vid="MAT 26:66">A von irisade lese vaćarindoj: “Trubul te merol!”<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Tegani čhungarde le po muj thaj čalade le dumukhencar. A avera šamarisade le <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />thaj vaćarde lese: “Prorokuji amenđe, Hriste, ko čalada tut!”<verse eid="MAT 26:68" /></para>
  <para style="s">O Petar vaćarol kaj ni pindžarol e Isuse</para>
  <para style="r">(<ref loc="MRK 14:66-72">Mk 14,66–72</ref>; <ref loc="LUK 22:56-62">Lk 22,56–62</ref>; <ref loc="JHN 18:15-18">Jn 18,15–18</ref>, <ref loc="JHN 18:25-27">25–27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />O Petar bešlo avral ani avlin. Avili paše leste jekh sluškinja thaj vaćarda: “I tu sana e Isusesa tari Galileja!”<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />A vov odreknisajlo angle savorende: “Ni džanav sostar vaćare.”<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />Kana o Petar avilo paši kapija, dikhlja le aver sluškinja thaj vaćarda kolenđe so sesa gothe: “I kava sasa e Isusesa taro Nazaret!”<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Thaj palem odreknisajlo thaj xalja sovli: “Ni pindžarav gole manuše!”<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Pale gova avile manuša save ačhena gothe thaj vaćarde e Petrese: “Čače tu san jekh lendar. Ćo vaćaripe gova sikavol!”<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Tegani o Petar lija te dol pe armaja thaj te xal sovli: “Me ni džanav gole manuše!”</para>
  <para style="m" vid="MAT 26:74">Thaj sigate đilabija o bašno. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Tegani dija pe gođi o Petar e lafurenđe so vaćarda lese o Isus: “Angleder so o bašno ka đilabol, trin droma ka vaćare kaj ni pindžare man.” Iklilo avral andari avlin thaj lija zurale te rovol.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">O Isus anglo baro Sudo</para>
  <para style="r">(<ref loc="ACT 1:18-19">Buća 1,18–19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />A rano sabalje dogovorisajle e šorutne sveštenikura thaj e starešine e narodose sar te mudaren e Isuse. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Gija phanglje le, inđarde le thaj predije le ko rimsko upravitelji o Pontije Pilat.<verse eid="MAT 27:2" /></para>
  <para style="s">O Juda mudarol pe</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Kana dikhlja o Juda, kova so izdajisada e Isuse, kaj osudisade le ko mudaripe, pokajisajlo thaj irisada e tranda (30) srebrenjakura e šorutne sveštenikurenđe thaj e starešinenđe. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />Vaćarda: “Grešisadem! Izdajisadem e nevinone manuše!”</para>
  <para style="m" vid="MAT 27:4">Von phende lese: “So amenđe tičil pe gova? Pe tute ačhol gova odgovornost.”<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Vov čhudija e srebrenjakura ano sveto than e hrameso thaj iklilo. Tegani đelo thaj obesisada pe.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />E šorutne sveštenikura lije e srebrenjakura thaj phende: “Naj šukar te čhuva len ani hramsko kasa, golese so si kale parencar poćindo o rat.”<verse eid="MAT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 27:7" />Dogovorisajle te ćinen gole srebrenjakurencar i njiva e lončaresi thaj gothe te aven limora baše abandžije. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Golese i njiva dži avđive akhardol “Ratvali njiva”. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Gija pherdilo kova so vaćarda o proroko Jeremija:</para>
  <para style="q1" vid="MAT 27:9">“Lije e tranda (30) srebrenjakura,</para>
  <para style="q2" vid="MAT 27:9">gaći e Izraelcura odlučisade te poćinen baše leso džuvdipe,<verse eid="MAT 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 27:10" />thaj dije len baši njiva e grnčaresi,</para>
  <para style="q2" vid="MAT 27:10">sar so zapovedisada manđe o Gospod.”<verse eid="MAT 27:10" /></para>
  <para style="s">O Isus anglo Pilat</para>
  <para style="r">(<ref loc="MRK 15:2-5">Mk 15,2–5</ref>; <ref loc="LUK 23:3-5">Lk 23,3–5</ref>; <ref loc="JHN 18:33-38">Jn 18,33–38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />O Isus ačhilo anglo rimsko upravitelji o Pilat savo pučlja le: “Tu li san o caro e Jevrejengo?”</para>
  <para style="m" vid="MAT 27:11">O Isus vaćarda lese: “Tu vaćare korkoro.”<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Kana tužisade le e šorutne sveštenikura thaj e starešine, o Isus khanči ni vaćarda.<verse eid="MAT 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13" />Tegani pučlja le o Pilat: “Šune li so vaćaren protiv tute?”<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />A o Isus ni vaćarda nijekh lafi, gija o rimsko upravitelji o Pilat but čudisajlo.<verse eid="MAT 27:14" /></para>
  <para style="s">E Varava mućhen, a e Isuse čhuven ko krsto</para>
  <para style="r">(<ref loc="MRK 15:6-15">Mk 15,6–15</ref>; <ref loc="LUK 23:13-25">Lk 23,13–25</ref>; <ref loc="JHN 18:39-19:16">Jn 18,39–19,16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Ko prazniko i Pasha sasa adeti o upravitelji te mućhol andaro phanglipe po jekhe phangle save e manuša manđen. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />E Isusesa sasa jekh phanglo so akhardola Varava kas savore džanen.<verse eid="MAT 27:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 27:17" />Kana e manuša ćidije pe, o Pilat pučlja len: “Kas manđen te mukhav tumenđe? E Varava il e Isuse so si akhardo Hrist?”<verse eid="MAT 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 27:18" />Vov džanglja kaj dije le e Isuse tari ljubomora.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Kana o Pilat bešlo ki sudsko stolica, e Pilatesi romni bičhalda haberi lese: “Ačhav tut taro sudo gole pravednikostar, golese so erat ano suno but mučisaljem baše leste!”<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />A e šorutne sveštenikura thaj e starešine pherde e manušen te roden te mućhol e Varava a e Isuse te mudarol.<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />O Pilat pučlja: “Kas manđen te mukhav tumenđe tare kala duj džene?”</para>
  <para style="p" vid="MAT 27:21">Von phende: “E Varava!”<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />A o Pilat pučlja len: “A so te ćerav e Isusesa so si akhardo Hrist?”</para>
  <para style="p" vid="MAT 27:22">Savore vaćarde: “Čhuv le ko krsto!”<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />A o Pilat pučlja: “Sose? Savo bilačhipe ćerda?”</para>
  <para style="p" vid="MAT 27:23">Von andare sa o glaso dije vika: “Čhuv le ko krsto.”<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Al kana dikhlja o Pilat kaj khanči ni pomožil thaj sa pobut bunin pe, lija o paj thaj thoda pe vasta angle manuša vaćarindoj: “Me naj sem bango bašo rat kale manušeso! Pe tumende ačhol gova odgovornost.”<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Sa e manuša phende lese: “Leso rat nek perol pe amende thaj pe amare čhave!”<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Tegani mukhlja lenđe o Pilat e Varava, a e Isuse dija te šibin thaj dija te čhuven le ko krsto.<verse eid="MAT 27:26" /></para>
  <para style="s">E vojnikura maren muj e Isusesa</para>
  <para style="r">(<ref loc="MRK 15:16-20">Mk 15,16–20</ref>; <ref loc="JHN 19:2-3">Jn 19,2–3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Tegani e vojnikura e Pilatese inđarde e Isuse ke upraviteljesi palata thaj trujal leste ćidije celo četa vojnikura. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Von uljarde le thaj učharde le ano lolo ogrtači, <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />khuvde lese venco tare kangre thaj čhute lese po šoro. Dije le trska ano desno va, pele ke koča angle leste thaj marde muj lesa vaćarindoj: “Te ave sasto, carona e Jevrejengo!”<verse eid="MAT 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 27:30" />Čhungarde le, lije i trska thaj marde le po šoro. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Kana ačhade te maren muj lesa, uljarde lestar o lolo ogrtači thaj urade le ane leso fostano. Tegani inđarde le te čhuven le ko krsto.<verse eid="MAT 27:31" /></para>
  <para style="s">E Isuse čhuven ko krsto</para>
  <para style="r">(<ref loc="MRK 15:21-32">Mk 15,21–32</ref>; <ref loc="LUK 23:26-43">Lk 23,26–43</ref>; <ref loc="JHN 19:17-27">Jn 19,17–27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Kana iklile, resle jekhe manuše andari Kirina savo akhardola Simon thaj terisade le te inđarol o krsto e Isuseso. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Avile dži ko than so akhardola Golgota, so si “Kokalo e šoreso.” <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Dije le te pijol mol mešimo khančesa so si ćerko. Al kana probisada, ni manglja te pijol.<verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />Kana čhute le ko krsto, [čhudije kocka te bi ulavena lese fostanura maškar peste.] <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Tegani bešle gothe te araćhen le.<verse eid="MAT 27:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 27:37" />Upral pe leso šoro čhute tabla kaj pisil lesi krivica: “Kava si o Isus, o Caro e Jevrejengo.”<verse eid="MAT 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 27:38" />Tegani čhute lesa dujen razbojnikuren, jekhe tari desno rig thaj dujtone tari levo.<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />E manuša save nakhle, vređisade le thaj vrtisade šorencar <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />vaćarindoj: “Tu so phađe o Hram thaj baše trin đive vazde le, spasi korkoro tut! Te san Čhavo e Devleso, ulji taro krsto!”<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />A gijate marde muj e Isusesa i e šorutne sveštenikura, e učitelja tare Mojsijaso zakon thaj e starešine. Vaćarde: <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“Averen spasisada a korkore pes našti? Vov si o caro e Izraeleso! Nek uljol akana taro krsto thaj ka pača ane leste! <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Pouzdisajlo ano Dol, akana vov nek spasil le, te manglja le. Golese so phenda: ‘Me sem e Devleso Čhavo!’”<verse eid="MAT 27:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44" />Gijate vređisade le i e razbojnikura save sesa lesa ke krstura.<verse eid="MAT 27:44" /></para>
  <para style="s">E Isuseso meripe</para>
  <para style="r">(<ref loc="MRK 15:33-41">Mk 15,33–41</ref>; <ref loc="LUK 23:44-49">Lk 23,44–49</ref>; <ref loc="JHN 19:28-30">Jn 19,28–30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />A tare opaš o đive dži ke trin o sato ki sa i phuv učharda o kalipe. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />A paše o trito sato dija vika o Isus andaro baro glaso: “Eli! Eli! Lama sabahtani?” (So značil: “Devla mingreja! Devla mingreja! Sose mukhljan man?”)<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Kana nesave save ačhile gothe šunde gova, phende: “Vov akharol e proroko e Ilija!” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Thaj sigate jekh lendar prastija thaj lija o sunđeri, bolda le ano šut, čhuta pi trska thaj kanisada e Isuse te pijol.<verse eid="MAT 27:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 27:49" />A avera vaćarde: “Ačh te dikha, da li ka avol o Ilija te spasil le.”<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />A o Isus vadži jekh drom dija vika andaro baro glaso thaj mukhlja pi duša.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Thaj tari jekh drom i zavesa pharadili ano sveto than e hrameso, ke opaš odupral natele. I phuv tresisada thaj e stene pharile. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />E limora putajle thaj but telura e Devlese manušenđe uštile andare mule. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Thaj kana iklile andare limora palo uštipe e Isuseso, avile ano sveto foro o Jerusalim thaj sikadile pherdonenđe.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Kana o rimsko kapetano thaj kola so lesa arakhlje e Isuse dikhlje kaj i phuv tresil pe thaj sa so sasa, darajle but thaj vaćarde: “Čače kava manuš sasa Čhavo e Devleso!”<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Gothe sesa but džuvlja, save gova dikhlje odural. Von džana palo Isus tari Galileja thaj služina le. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Maškare lende sesa i Marija Magdalena, i Marija i dej e Jakovesi thaj e Josifesi thaj i dej e Zevedejese čhavenđi.<verse eid="MAT 27:56" /></para>
  <para style="s">E Isuseso prahope</para>
  <para style="r">(<ref loc="MRK 15:42-47">Mk 15,42–47</ref>; <ref loc="LUK 23:50-56">Lk 23,50–56</ref>; <ref loc="JHN 19:38-42">Jn 19,38–42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Kana peli i rat, avilo jekh barvalo manuš taro foro Arimateja, so akhardola Josif, savo i korkoro sasa sikado e Isuseso. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Vov đelo ko Pilat thaj molisada le bašo telo e Isuseso. Tegani o Pilat naredisada te den le o telo. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />O Josif lija o telo, paćarda le ano nevo laneno čaršafi <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />thaj čhuta le ano piro nevo limori savo sasa čhindo ani stena. Phanglja o vudar taro limori bare baresa thaj đelo. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Gothe sesa i Marija Magdalena thaj i dujto Marija, save bešle anglo limori.<verse eid="MAT 27:61" /></para>
  <para style="s">I straža araćhol o limori</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />A theara đive, ko savato, ćidije pe e šorutne sveštenikura thaj e fariseja ko Pilat <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />thaj phende lese: “Gospodarona! Dijam amen gođi kaj kava xoxavno dok sasa džuvdo, vaćarda: ‘Pale trin đive ka uštav tare mule.’ <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Golese vaćar te araćhol pe o limori dži ko trito đive, te ma aven lese sikade, te čoren le thaj te vaćaren e manušenđe kaj uštilo tare mule. Te gova desisajlo o poslednjo xoxaipe ka avol po baro taro angluno!”<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />O Pilat vaćarda lenđe: “Isi tumen stražara! Džan thaj araćhen o limori sar džanen.”<verse eid="MAT 27:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66" />Von đele thaj osigurisade o limori gija so čhute pečato po bar thaj čhute stražaren.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">O Isus uštol tare mule</para>
  <para style="r">(<ref loc="MRK 16:1-8">Mk 16,1–8</ref>; <ref loc="LUK 24:1-12">Lk 24,1–12</ref>; <ref loc="JHN 20:1-10">Jn 20,1–10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Palo savato, rano sabalin ko angluno đive ko kurko avili i Marija Magdalena thaj i dujto Marija te dićhen o limori.<verse eid="MAT 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2" />Tari jekh drom i phuv tresisajli but, golese so o anđelo e Gospodeso ulilo taro nebo. Avilo, crdija o bar tare vudara e limoreso thaj bešlo pe leste. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Vov sijajisada sar munja a lese šeja sesa parne sar iv. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />E stražara tresisade tari dar e anđelosi thaj sesa sar mule.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />A o anđelo phenda e džuvljenđe: “Tumen ma daran! Džanav kaj roden e Isuse save čhute ko krsto. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Naj kate, golese so uštilo tare mule, sar so vaćarda. Aven dićhen o than kaj pašlilo. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Sigate džan te vaćaren lese sikadenđe: ‘Uštilo tare mule thaj akana angle tumende džal ani Galileja. Odori ka dićhen le.’ Akh, gova sasa man te vaćarav tumenđe!”<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Gija e džuvlja sigate iklile andaro limori, darandoj thaj bare radujimasa siđarde te vaćaren gova e sikadenđe. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Tari jekh drom avilo lenđe o Isus thaj phenda lenđe: “Zdravo!”</para>
  <para style="p" vid="MAT 28:9">A von avile, dolde le tare pingre lese thaj pele ke pe koča.<verse eid="MAT 28:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 28:10" />Tegani vaćarda lenđe o Isus: “Ma daran. Džan vaćaren mingre phralenđe te džan ani Galileja. Odori ka dićhen man.”<verse eid="MAT 28:10" /></para>
  <para style="s">E sveštenikura poćinen e stražaren te xoxaven</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Kana e džuvlja đele dromesa, nesave tare stražara avile ano foro thaj vaćarde e šorutne sveštenikurenđe sa so sasa. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Gija von ćidije pe e starešinencar thaj dogovorisajle te den e vojnikuren but pare.<verse eid="MAT 28:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 28:13" />Phende lenđe: “Vaćaren, ‘E sikade lese avile raćasa thaj čorde e Isuseso telo kana amen sutam.’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Thaj te šunda gova o Pilat, amen ka vaćara lesa a tumenđe khanči ni ka avol.”<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />Gija e vojnikura lije e pare thaj ćerde sar si lenđe phendo. Gija kaja paramič vaćarol pe svugde maškar e Jevreja thaj trajil dži avđive.<verse eid="MAT 28:15" /></para>
  <para style="s">O Isus bičhalol e sikaden te vaćaren o Lačho Lafi</para>
  <para style="r">(<ref loc="MRK 16:14-18">Mk 16,14–18</ref>; <ref loc="LUK 24:36-49">Lk 24,36–49</ref>; <ref loc="JHN 20:19-23">Jn 20,19–23</ref>; <ref loc="ACT 1:6-8">Buća 1,6–8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Tegani e Dešujekh (11) sikade đele ani Galileja ko brego kaj zapovedisada lenđe o Isus. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Kana dikhlje le, pele pe koča, al nesave posumnjisade.<verse eid="MAT 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 28:18" />O Isus avilo paše lende vaćarindoj: “Dija pe manđe sa o vlast ko nebo thaj ki phuv. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Džan gija thaj ćeren e manušen tare sa e nacije te aven mingre sikade, krstin len ko alav e Dadeso thaj e Čhaveso thaj e Svetone Duxoso <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />thaj sikaven len te ićaren sa so zapovedisadem tumenđe! Te džanen, me sem tumencar ane sa e đivesa dži ko kraj e svetoso.”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>