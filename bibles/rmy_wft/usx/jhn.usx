<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Romani Gurbet Bible (GSP)</book>
  <para style="h">Jovan</para>
  <para style="toc1">Lačho Lafi taro Jovan</para>
  <para style="toc2">Jovan</para>
  <para style="toc3">Jn</para>
  <para style="mt">Lačho Lafi taro Jovan</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">O Lafi ćerdol telo</para>
  <para style="q1">
    <verse number="1" style="v" sid="JHN 1:1" />Ko anglunipe sasa o Lafi,</para>
  <para style="q2" vid="JHN 1:1">thaj o Lafi sasa e Dеvlesa,</para>
  <para style="q2" vid="JHN 1:1">thaj o Lafi sasa o Dol.<verse eid="JHN 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JHN 1:2" />Vov sasa e Devlesa ko anglunipe.<verse eid="JHN 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JHN 1:3" />Sa sasa stvorimo prekale leste</para>
  <para style="q2" vid="JHN 1:3">thaj ni postojil khanči so sasa stvorimo bize leste.<verse eid="JHN 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JHN 1:4" />Ane leste sasa o džuvdipe,</para>
  <para style="q2" vid="JHN 1:4">thaj o džuvdipe sasa o svetlo e manušenđe.<verse eid="JHN 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JHN 1:5" />O svetlo svetlil ano kalipe</para>
  <para style="q2" vid="JHN 1:5">thaj o kalipe našti nadvladil o svetlo.<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />Sasa manuš kas bičhalda o Dol. Leso alav sasa Jovan savo krstila. <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />Avilo sar svedoko, te svedočil bašo Svetlo, prekale leste savore te pačan. <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />O Jovane korkoro ni sasa svetlo, nego avilo te svedočil taro Svetlo.<verse eid="JHN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 1:9" />O čačukano Svetlo avilo ko sveto thaj svetlil svakone manuše.<verse eid="JHN 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JHN 1:10" />Vov sasa ko sveto,</para>
  <para style="q2" vid="JHN 1:10">o sveto sasa stvorimo prekale leste,</para>
  <para style="q2" vid="JHN 1:10">al o sveto ni pindžarda le.<verse eid="JHN 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JHN 1:11" />Avilo ano sveto savo sasa leso,</para>
  <para style="q2" vid="JHN 1:11">al lese manuša ni prihvatisade le.<verse eid="JHN 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JHN 1:12" />A dija pravo savoren kolen save prihvatisade le, save pačan ane leso alav,</para>
  <para style="q2" vid="JHN 1:12">te aven e čhave e Devlese.<verse eid="JHN 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JHN 1:13" />Gasave ni bijandile taro prirodno bijandipe,</para>
  <para style="q2" vid="JHN 1:13">ni tari požuda e telosi,</para>
  <para style="q2" vid="JHN 1:13">ni taro manglipe e manušeso, samo taro Dol.<verse eid="JHN 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JHN 1:14" />O Lafi ćerdilo manuš thaj bešlo maškar amende.</para>
  <para style="q2" vid="JHN 1:14">Dikhljam lesi slava,</para>
  <para style="q2" vid="JHN 1:14">savi isi le, sar jekhbijando Čhavo savo avilo taro Dad,</para>
  <para style="q2" vid="JHN 1:14">a vov si pherdo milost thaj čačipe.<verse eid="JHN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />O Jovane o Krstitelj svedočisada lestar thaj dija vika: “Kava si gova savestar vaćardem: ‘Kova savo pale mande avol, po baro si mandar, golese so sasa angleder mande!’”<verse eid="JHN 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16" />Vov si pherdo milost thaj čačipe thaj lestar primisadam blagoslov palo blagoslov. <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />Golese, o Zakon dija pe prekalo Mojsije thaj e Devleso milost thaj o čačipe avile prekalo Isus Hrist. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />Khoni nikad ni dikhlja e Devle, al o jekhbijando Čhavo savo si i korkoro Dol, savo si e Dadese empaše, sikada le amenđe.<verse eid="JHN 1:18" /></para>
  <para style="s">O svedočanstvo e Jovaneso e Krstiteljeso</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mt 3,1–12</ref>; <ref loc="MRK 1:2-8">Mk 1,2–8</ref>; <ref loc="LUK 3:15-17">Lk 3,15–17</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />Kava sasa e Jovaneso svedočanstvo kana e Jevreja taro Jerusalim bičhalde e sveštenikuren thaj e Levituren te pučen e Jovane: “Ko san tu?”<verse eid="JHN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20" />O Jovane phenda putarde, ni garada khanči, al priznajisada: “Me naj sem o Hrist.”<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />Gija pučlje le: “Pa ko san onda? Naj li san o proroko o Ilija?”</para>
  <para style="p" vid="JHN 1:21">A vov phenda: “Naj sem.”</para>
  <para style="p" vid="JHN 1:21">“Tu li san kova Proroko save ađućara?”</para>
  <para style="p" vid="JHN 1:21">O Jovane vaćarda: “Na.”<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />Tegani pučlje le: “Pa ko san tu? Te šaj vaćara gova kolenđe so bičhalde amen. So šaj vaćare korkoro tutar?”<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />O Jovane vaćarda lenđe gija sar so pisisada o proroko o Isaija:</para>
  <para style="q1" vid="JHN 1:23">“Me sem ‘glaso so dol vika ani pustinja:</para>
  <para style="q2" vid="JHN 1:23">Ravnin o drom e Gospodese!’”<verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />A nesave tare bičhalde sesa fariseja. <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />Von pučlje le: “Kana naj san o Hrist, ni o Ilija, ni kova Proroko save ađućara, sose onda krsti?”<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />O Jovane vaćarda lenđe: “Me krstiv pajesa, al maškare tumende ačhol kova kas tumen ni pindžaren. <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />Vov avol pale mande, al me naj sem dostojno ni te putrav e dora tar lese sandale.”<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />Kava sasa ani Vitanija, ki istočno rig tari len o Jordan, kaj o Jovane krstila e manušen.<verse eid="JHN 1:28" /></para>
  <para style="s">O Isus si e Devleso Bakroro</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />Theara đive o Jovane dikhlja e Isuse sar avol premal leste thaj vaćarda: “Dićhen, e Devlese Bakrore! Vov crdol e grehura kale svetose! <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />Kava si kova kastar me vaćardem: ‘Pale mande avol manuš savo si po baro mandar golese so sasa angleder mande!’ <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />Me ni pindžardem le, al me aviljem thaj krstiv pajesa, te bi e manuša taro Izrael šajine te dićhen ko si vov.”<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />Tegani o Jovane svedočisada vaćarindoj: “Dikhljem o Sveto Duxo sar avol tele taro nebo sar golubo thaj ačhilo pe leste. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />Me ni pindžardem le, al o Dol so bičhalda man te krstiv pajesa vaćarda manđe: ‘Kana dićhe e manuše pe kaste perol thaj ačhol o Sveto Duxo, te džane kaj gova si manuš savo ka krstil e Svetone Duxosa.’ <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />Thaj me gova dikhljem thaj golese svedočiv kaj kava si o Čhavo e Devleso.”<verse eid="JHN 1:34" /></para>
  <para style="s">E Isusese anglune sikade</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />Theara đive palem sasa odori o Jovane pe duje sikadencar. <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />Kana dikhlje e Isuse kaj naćhol gothar o Jovane vaćarda: “Dićhen, e Devlese Bakrore!”<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />Kana šunde e duj sikade e Jovanese so phenda o Jovane, đele palo Isus.<verse eid="JHN 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 1:38" />O Isus irindoj dikhlja kaj aven pale leste thaj pučlja len: “So manđen?”</para>
  <para style="p" vid="JHN 1:38">Von vaćarde lese: “Rabbi” (so si: Učitelju), “kaj beše?”<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />O Isus phenda lenđe: “Aven thaj ka dićhen.”</para>
  <para style="p" vid="JHN 1:39">Gija đele dikhlje kaj bešol thaj gova đive ačhile lesa. Sasa paše štar o sato ko đive.<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />Jekh tare kala duj, save šunde e Jovanese lafura thaj đelo palo Isus, sasa o Andrija, o phral e Simoneso e Petreso. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />Vov sigate rodija pe phrale e Simone thaj vaćarda lese: “Amen arakhljam e Mesija” (so značil o Hrist).<verse eid="JHN 1:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 1:42" />O Andrija anda e Simone ko Isus. Thaj o Isus dikhlja pe leste thaj vaćarda: “Tu san o Simon, a ćo dad akhardol Jovan. Tu ka akhardo Kifa” (so značil Petar, “baro bar”).<verse eid="JHN 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />Theara đive o Isus odlučisada te džal ki regija i Galileja. Arakhlja e Filipe thaj vaćarda lese: “Phir pale mande!”<verse eid="JHN 1:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 1:44" />O Filip sasa tari Vitsaida, taro foro e Andrijaso thaj e Petreso.<verse eid="JHN 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 1:45" />O Filip arakhlja e Natanaile thaj vaćarda lese: “Arakhljam kole kastar pisisade o Mojsija ano Zakon thaj e Prorokura – e Isuse, e Josifese čhave, taro foro Nazaret.”<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />Tegani o Natanail pučlja le: “Šaj li avol khanči šukar taro Nazaret?”</para>
  <para style="m" vid="JHN 1:46">O Filip vaćarda lese: “Av thaj dikh!”<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />Kana o Isus dikhlja e Natanailo sar avol premal leste, vaćarda lestar: “Akh čačukano Izraelco, ane savo naj prevara!”<verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />Pučlja le o Natanailo: “Kotar pindžare ma?”</para>
  <para style="p" vid="JHN 1:48">O Isus vaćarda lese: “Angleder so o Filip akharda tut, dikhljem sar beše tali smokva.”<verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />Tegani o Natanailo phenda lese: “Rabbi! Tu san Čhavo e Devleso! Tu san o caro e Izraeleso!”<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />O Isus pučlja le: “Pača golese so vaćardem tuće kaj dikhljem tut tali smokva? Ka dićhe po bare buća tare kava.”<verse eid="JHN 1:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 1:51" />Pale gova o Isus vadži vaćarda: “Čače, čače vaćarav tumenđe: ka dićhen o nebo putardo thaj e Devlese anđeluren sar ušten thaj uljen po Čhavo e Manušeso.”<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">Abav ani Kana</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />Ko trito đive sasa abav ano gav savo akhardol Kana ani Galileja. Gothe sasa thaj e Isusesi dej. <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />Ko abav sesa akharde o Isus thaj lese sikade. <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />Kana ni ačhili mol, e Isusesi dej vaćarda lese: “Naj len mol.”<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />O Isus vaćarda laće: “So isi man golesa, džuvlije? Mingro vreme vadži ni avilo.”<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />Lesi dej vaćarda e slugenđe: “Ćeren sa so vaćarol tumenđe!”<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />Gothe sesa šov bare barale khore. E Jevrejenđe sesa gola khore baše jevrejska adetura e thodimase thaj ane dži jekh khoro šajine te ačhol ohtovardeš (80) dži ke šelubiš (120) litra paj.<verse eid="JHN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 2:7" />O Isus vaćarda e slugenđe: “Pheren e khore pajesa!” Gija pherde len dži upre.<verse eid="JHN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 2:8" />Pale gova vaćarda lenđe: “Akana len thaj inđaren e glavnone trpezarese.” Von ćerde gija.<verse eid="JHN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 2:9" />O trpezari pilja o paj savo ćerdilo mol. Vov ni džanglja kotar si, al e sluge so ande gova paj džanglje. Tegani akharda o trpezari e mladoženja <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />thaj vaćarda lese: “Sa e manuša angleder anen i lačhi mol ko abav, a kana e gostura maton, anol i bilačhi mol. Al tu garadan i lačhi mol dži akana.”<verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />Gija, ani Kana i Galilejsko, ćerda o Isus piro angluno čudesno znako thaj sikada pi slava thaj lese sikade pačaje ane leste.<verse eid="JHN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />Pale gova đelo o Isus pe dasa, pe phralencar thaj pe sikadencar ano foro Kafarnaum. Gothe ačhile nekobor đive.<verse eid="JHN 2:12" /></para>
  <para style="s">O Isus tradol e trgovcuren andaro Hram</para>
  <para style="r">(<ref loc="MAT 21:12-13">Mt 21,12–13</ref>; <ref loc="MRK 11:15-17">Mk 11,15–17</ref>; <ref loc="LUK 19:45-46">Lk 19,45–46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />Paše sasa o vreme taro prazniko e Jevrejengo – Pasha thaj o Isus đelo ano Jerusalim. <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />Ane Hramesi avlin arakhlja kolen save bićinena guruven, bakren thaj goluburen. Arakhlja i kolen so menjina e pare, sar bešen gothe. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />Gija o Isus ćerda bičo tare dorika thaj sa kolen save bićinen lija te tradol andaro Hram, sa lenđe bakrencar thaj e guruvencar. E manušenđe so menjina e pare čhudija e srebrnjakura thaj irisada e astalura. <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />Kolenđe save bićinena goluburen vaćarda: “Inđaren gova katar! Ma ćeren pijaco taro Ćher mingre Dadeso.”<verse eid="JHN 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 2:17" />Thaj lese sikade dije pe gođi kaj si pisimo ano Sveto lil:</para>
  <para style="q1" vid="JHN 2:17">“O manglipe baše ćiro ćher ka phabol ane mande sar jag.”<verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />Tegani e Jevrejska šorutne pučlje e Isuse: “Savo čudesno znako ka sikave amenđe kaj tu troma kava te ćere?”<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />O Isus vaćarda lenđe: “Phađen kava Hram a me baše trin đive ka vazdav le.”<verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />Al e Jevreja vaćarde lese: “Kava Hram sasa ćerdo saranda thaj šov (46) berš a tu baše trin đive ka vazde le?”<verse eid="JHN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21" />Al o Hram savestar vaćarda o Isus, sasa leso telo. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />Kana uštilo tare mule, dije pe gođi lese sikade kaj gova phenda thaj pačaje ano Sveto lil thaj ane lafura so o Isus vaćarda.<verse eid="JHN 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />A dži kaj sasa ano Jerusalim ko prazniko e Jevrejengo – Pasha, but manuša dikhlje e čudesna znakura save ćerda thaj pačaje ane leso alav. <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />Al korkoro o Isus ni pačaja lenđe, golese so pindžarda sa e manušen. <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />Ni trubuja te vaćarol lese khoni bašo manuš, golese so korkoro džanglja so si ano manuš.<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">O Isus thaj o Nikodim</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />Maškare fariseja sasa jekh manuš, savo akhardola Nikodim. Vov sasa jekh tare šorutne e Jevrejenđe.<verse eid="JHN 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 3:2" />Jekh rat avilo ko Isus thaj phenda: “Rabbi! Amen džana kaj san tu učitelji bičhaldo taro Dol, golese so khoni našti ćerol gasave čudesna znakura save tu ćere, a te naj o Dol lesa.”<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />O Isus phenda lese: “Čače, čače vaćarav tuće: khoni našti avol ano Carstvo e Devleso, ako ni bijandol palem.”<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />O Nikodim pučlja le: “Sar šaj manuš bijandol ako si purano? Šaj li dujto drom te džal ane pe dako vođi thaj te bijandol?”<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />O Isus vaćarda lese: “Čače, čače vaćarav tuće: te o manuš ni bijandilo pajesa thaj Duxosa, našti džal ano Carstvo e Devleso! <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />Kova so si bijando taro manuš, manuš si, a so si bijando taro Duxo, duxo si.<verse eid="JHN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 3:7" />Ma čudi tut so vaćarav tuće kaj trubul palem te bijandon.<verse eid="JHN 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 3:8" />I balval phurdol kaj manđol. Šaj šune la, al ni džane kotar avol ni kaj džal. Gija si kolesa kas o Duxo bijanol.”<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />O Nikodim pučlja le: “Sar šaj gova te avol?”<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />O Isus vaćarda lese: “Tu san poštujimo učitelji e Izraeleso a gova ni džane? <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />Čače, čače vaćarav tuće: amen vaćara tare kova so džana thaj svedoči za kova so dikhljam, al tumen ni prihvatin amaro svedočanstvo. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />Te ni pačajen man kana vaćarav tumenđe tare kova so ćerol pe ki phuv, sar ka pačan man te vaćardem tumenđe tare kova so ćerol pe ko nebo? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />Khoni ni uštilo ko nebo thaj irisajlo ki phuv, sem o Čhavo e Manušeso, kova savo ulilo taro nebo. <verse eid="JHN 3:13" /><verse number="14" style="v" sid="JHN 3:14" />Thaj sar o Mojsije so vazdija e sape tari bronza ki pustinja, gija o Čhavo e Manušeso trubul te avol vazdimo <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />te šaj dži jekh savo pačal ane mande te avol le džuvdipe bizo meripe.”<verse eid="JHN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 3:16" />Golese so, o Dol gaći manglja o sveto kaj dija pe jekhebijande Čhave te ma bi merola khoni savo pačal ane leste, nego te avol le džuvdipe bizo meripe. <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />O Dol ni bičhalda ko sveto pe Čhave te sudil o sveto, nego o sveto prekale leste te spasil pe. <verse eid="JHN 3:17" /><verse number="18" style="v" sid="JHN 3:18" />Ko ane leste pačal, naj osudimo, a ko ni pačal već si osudimo, golese so ni pačaja ano alav e Devlese jekhebijande Čhaveso. <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />A osudime si paše kava: o svetlo avilo ko sveto, al e manuša manglje o kalipe, a na o svetlo, golese so lenđe buća sesa bilačhe. <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />Dži jekh savo ćerol bilačhipe, mrzil o svetlo thaj ni džal ko svetlo te ma pučardon lese buća. <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />Al savo ćerol kova so si čačukanipe, džal ko svetlo te dićhol pe kaj lese buća si ćerde ano sklad e Devlesa.<verse eid="JHN 3:21" /></para>
  <para style="s">O Isus thaj o Jovane o Krstitelj</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />Pale gova đelo o Isus pe sikadencar ane Judejska gava. Odori sasa lencar thaj krstisada. <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />A i o Jovane krstisada ano than Enon pašo gav Salim, golese so sasa gothe but paja. E manuša avena ke leste te krstil len. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />Gova sasa angleder so e Jovane čhute ano phanglipe.<verse eid="JHN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />Tegani maškare sikade e Jovanese sasa aver Jevrejo savesa lije te ćeren čingara bašo adeti e thodimaso.<verse eid="JHN 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 3:26" />E sikade avile ko Jovane thaj vaćarde lese: “Rabbi, kova so sasa tusa ki istočno rig e Jordanesi thaj kastar tu svedočisadan, dikh, krstil thaj savore džan leste.”<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />O Jovane vaćarda lenđe: “O manuš našti te lol khanči ako naj lese gova dindo taro Dol savo si ko nebo. <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />Korkore sen svedokura kaj vaćardem: ‘Me naj sem o Hrist, nego sem bičhaldo angle leste.’ <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />Ko abav samo o mladoženja ženil pe. A e mladoženjaso amal savo ađućarol te šunol kaj avol o mladoženja, pherdo si radost kana šunol e mladoženjaso glaso. Golese gova radost si mingro thaj akana si pherdo. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />Vov trubul pobut te barol, a me sa pobut te ciknjivav.”<verse eid="JHN 3:30" /></para>
  <para style="s">Kova savo avol taro nebo</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />Kova savo avol odupral taro nebo, pe savorende si. Kova savo si tari phuv, phuvako si thaj vaćarol sar khoni tari phuv. Kova savo avol taro nebo, pe savorende si. <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />Vov svedočil baše kova so dikhlja thaj so šunda, al khoni ni prihvatil leso svedočanstvo. <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />A ko prihvatil leso svedočanstvo, potvrdil kaj si o Dol čačukano. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />Kova kas bičhalda o Dol, vaćarol e Devlese lafura, golese so o Dol dol po Duxo ano izobilje. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />O Dad manđol e Čhave thaj sa dija le ane vasta. <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />Ko pačal ano Čhavo, isi le džuvdipe bizo meripe. Al ko ni šunol e Čhave, ni ka dićhol o džuvdipe, nego i holi e Devlesi ačhol pe leste.<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">O Isus thaj i Samarijanka</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />Kana o Isus dodžanglja kaj e fariseja šunde so vov pridobil thaj krstil pobut sikaden nego o Jovane <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />– iako o Isus korkoro ni krstila, nego lese sikade gova ćerena – <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />đelo andari phuv i Judeja thaj irisajlo ani phuv i Galileja.<verse eid="JHN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 4:4" />Ko drom trubuja te naćhol tari Samarija. <verse eid="JHN 4:4" /><verse number="5" style="v" sid="JHN 4:5" />Gija avilo ano samarijansko gav savo akhardola Sihar, paši phuv savi dija o Jakov pe čhavese e Josifese. <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />Gothe sasa o bunari e Jakoveso. O Isus čhindilo taro baro drom thaj bešlo pašo bunari. Sasa paše dešuduj (12) o sato.<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />Kana gothe avili jekh Samarijanka te dolol paj, o Isus vaćarda laće: “De ma te pijav!” <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />(Tegani sasa o Isus korkoro, golese so lese sikade đele ano gav te ćinen xamase.)<verse eid="JHN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />Vaćarda e Isusese i Samarijanka: “Sar tu, savo san Jevrejo, šaj te manđe mandar tari Samarijanka te dav tut te pije paj?” Golese so e Jevreja naj ano amalipe e Samarijancurencar.<verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />O Isus vaćarda laće: “Kana bi samo džanesa e Devleso daro! Tu ni džane ko si kova so vaćarol tuće: ‘De ma te pijav paj!’ Te džane, tu bi mandar manđesa thaj me bi dava tut paj savo dol džuvdipe.”<verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />I džuvli phenda lese: “Gospodarona! Naj tut ni čaro te dole o paj, a o bunari si xor. Kotar ka le paj savo dol džuvdipe? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />Tu li misli kaj san po baro tare amaro paradad o Jakov savo dija amen kava bunari savestar pilja vov, lese čhave thaj lesi stoka?”<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />O Isus vaćarda laće: “Dži jekh savo pijol tare kava paj, palem ka trošavol. <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />Al ko pijol paj savo me ka dav le, ni ka avol trošalo dži kaj si džuvdo. Paj savo me ka dav le ka avol ane leste izvor e pajeso savo ka dol le džuvdipe bizo meripe.”<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />I džuvli vaćarda lese: “Gospodarona! De ma gova paj te ma trošavav vadži ni te avav kate ko bunari te dolav paj!”<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />O Isus vaćarda laće: “Dža akhar ćire rome thaj iri tut akari!”<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />Tegani vaćarda lese i romni: “Naj man rom.”</para>
  <para style="p" vid="JHN 4:17">Tegani phenda o Isus: “Šukar phendan kaj naj tut rom! <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />Golese so sasa tut pandž roma thaj kova so isi tut akana naj ćiro rom. Gova so vaćardan si čače.”<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />I romni vaćarda lese: “Gospodarona! Dikhav kaj san proroko. <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />Amare paradada slavina e Devle ke kava brego. Al tumen e Jevreja vaćaren kaj ano Jerusalim si than kaj trubul te slavil pe o Dol.”<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />O Isus vaćarda laće: “Džuvlije! Pača man, ka avol o vreme kaj ni ka slavin e Dade na samo kate ko brego thaj na samo ano Jerusalim. <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />Tumen e Samarijancura ni džanen kas slavin. Amen e Jevreja džana kas slavi golese so o spasenje avol tare Jevreja. <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />Al avol o vreme kana e čačukane slavljenikura ka slavin e Dade ano Duxo thaj ano čačipe. O Dad manđol gasave pačavnen. A gova vreme već avilo. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />O Dol si Duxo thaj kola save slavin le, mora te slavin le ano Duxo thaj ano čačipe.”<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />I džuvli phenda lese: “Džanav kaj ka avol o Mesija, savo akhardol Hrist. Kana ka avol vov, sa ka objasnil amenđe.”<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />O Isus vaćarda laće: “Vov akana vaćarol tusa. Me sem o Mesija.”<verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />Ane gova časo lese sikade irisade pe andaro foro thaj čudisajle so o Isus vaćarol e džuvljasa. Al nijekh ni pučlja le: “So manđe latar?”, il “Sose vaćare lasa?”<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />Tegani i džuvli ačhada gothe po khoro, irisajli ano gav thaj vaćarda e manušenđe: <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />“Aven te dićhen e manuše savo manđe vaćarda sa so ćerdem. Šaj si vov o Hrist?” <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />Gija e manuša avile andaro gav thaj đele te dićhen e Isuse.<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />Ane gova vreme e sikade molisade e Isuse: “Rabbi! Xa khanči!”<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />Al vov phenda lenđe: “Man isi xape savestar tumen ni džanen.”<verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />Tegani e sikade vaćarde maškare peste: “Te ni anda lese khoni khanči xamase?”<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />A o Isus vaćarda lenđe: “Mingro xape si te ćerav so si volja kolesi savo bičhalda man thaj te dovršiv lesi bući. <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />Na li vaćaren kana sejin: ‘Vadži štar čhon thaj ka avol o ćidipe?’ Al me phenav tumenđe, putren tumare jakha thaj dićhen e poljura resle ćidimase. <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />Kova savo ćidol već prihvatil i plata thaj ćidol o bijanipe bašo džuvdipe bizo meripe, te šaj radujin pe katane kova so sejil thaj kova so ćidol. <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />Gija čače avol i poslovica: ‘Jekh sejil, dujto ćidol.’ <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />Me bičhalav tumen te ćiden kaj ni ćerden bući. Avera trudisajle, a tumen ćidijen o bijanipe tari lenđi bući.”<verse eid="JHN 4:38" /></para>
  <para style="s">E Samarijancura pačaje ano Isus</para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />But Samarijancura tare gova foro pačaje ane leste zbog o lafi e džuvljako savi phenda o svedočanstvo: “Vaćarda manđe sa so ćerdem.” <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />Kana avile e Samarijancura paše leste, molisade le te ačhol lencar. Thaj vov ačhilo gothe duj đive. <verse eid="JHN 4:40" /><verse number="41" style="v" sid="JHN 4:41" />Tegani vadži pobut manuša pačaje zbog lese lafura.<verse eid="JHN 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 4:42" />Vaćarde e džuvljaće: “Akana više ni pača samo zbog gova so tu vaćardan, golese so amen korkore šundam thaj džana kaj si čače kava manuš o Spasitelji e svetoso!”<verse eid="JHN 4:42" /></para>
  <para style="s">O Isus sastarol e carose službenikose čhave</para>
  <para style="r">(<ref loc="MAT 8:5-13">Mt 8,5–13</ref>; <ref loc="LUK 7:1-10">Lk 7,1–10</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />Pale duj đive, o Isus đelo tari Samarija ani Galileja. <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />Korkoro o Isus svedočisada kaj e proroko ni poštujin ano than kaj barilo. <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />Kana reslo ani Galileja, e Galilejcura lačhe prihvatisade le samo golese so dikhlje sa e čudesura save ćerda ano Jerusalim, golese so i von sesa odori ko prazniko Jevrejengo – Pasha.<verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />Gija o Isus đelo palem ani Kana i Galilejsko, kaj sasa ćerdo o paj ani mol. Sasa jekh službeniko e caroso andaro Kafarnaum, kas sasa nasvalo čhavo. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />Kana šunda kaj o Isus andari Judeja avilo ani Galileja, đelo ke leste ani Kana thaj molisada le te avol ano Kafarnaum thaj te sastarol lese čhave golese so si ko meripe.<verse eid="JHN 4:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 4:48" />A o Isus phenda lese: “Gasave sen tumen manuša! Dži kaj ni dićhen znakura thaj čudesura, ni pačan.”<verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />E caroso službeniko vaćarda lese: “Gospode! Moliv tut, av sar ni mulo mingro čhavo.”<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />O Isus vaćarda lese: “Dža ćhere, ćiro čhavo sastilo!”</para>
  <para style="p" vid="JHN 4:50">O manuš pačaja ane Isusese lafura thaj đelo ćhere.<verse eid="JHN 4:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 4:51" />Kana sasa vadži ko drom, arakhlja pe slugen save ande lese haberi kaj leso čhavo sastilo. <verse eid="JHN 4:51" /><verse number="52" style="v" sid="JHN 4:52" />Vov pučlja len kana sastilo thaj von phende lese: “Eraći ko jekh o sato ko đive ačhada le i groznica.”<verse eid="JHN 4:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 4:53" />Tegani haljarda o dad kaj gova sasa ane kova sato kana vaćarda lese o Isus: “Ćiro čhavo sastilo.”</para>
  <para style="m" vid="JHN 4:53">Thaj pačaje vov thaj savore ane leso ćher.<verse eid="JHN 4:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54" />Gova sasa dujto čudesno znako savo ćerda o Isus ani Galileja kana irisajlo tari Judeja.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">O Isus sastarol ko savato ani banja Vitezda</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />Pale gova sasa o prazniko e Jevrejengo thaj o Isus đelo ano Jerusalim. <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />Ano Jerusalim paše Bakresi kapija isi banja, savi akhardol jevrejsko Vitezda thaj gothe sesa pandž učharde terase. <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />Odori pašljona but nasvale manuša, kore, banđe thaj šuće. [Von ađućarena o paj te tresil, <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />golese so o anđelo e Gospodeso uljola ano određeno vreme ani banja thaj tresila o paj. Ko angleder bi džala andre kana o paj tresila, vov bi sastola taro po nasvalipe savo sasa le.]<verse eid="JHN 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 5:5" />Gothe pašo paj sasa jekh manuš savo tranda thaj ohto (38) berš sasa nasvalo.<verse eid="JHN 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 5:6" />Kana o Isus dikhlja le sar pašljol, a sar džanglja kaj si but berša nasvalo, pučlja le: “Manđe li te ave sasto?”<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />O nasvalo phenda lese: “Gospode, naj man khoni te mućhol man ani banja kana o paj tresil. Kana me džav premalo paj, khoni aver uljol angleder mande.”<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />O Isus vaćarda lese: “Ušti, le ćiro than kaj pašljiljan thaj phir!”<verse eid="JHN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 5:9" />A tari jekh drom kova manuš sastilo, lija po than kaj pašlilo thaj phirda. Al gova đive sasa savato <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />golese e Jevrejska šorutne vaćarde kalese save o Isus sastarda: “Avđive si savato! Phađe o zakon, golese so inđare ćiro than kaj pašljiljan ko savato!”<verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />Al vov phenda lenđe: “Kova manuš savo sastarda man, phenda manđe: ‘Le ćiro than kaj pašljiljan thaj phir!’”<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />Von pučlje le: “Ko si gova manuš savo vaćarda tuće: ‘Le ćiro than kaj pašljiljan thaj phir?’”<verse eid="JHN 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13" />Al o sastardo ni džanglja ko si, golese so o Isus crdija pe maškare but manuša save sesa gothe.<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />Pale gova, o Isus arakhlja ane hramesi avlin kole manuše save sastarda thaj vaćarda lese: “Akh, sastiljan! Ma vadži ćer greh, te ma avol tuće pobilačhe!”<verse eid="JHN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15" />Tegani o manuš đelo thaj vaćarda e Jevrejskone šorutnenđe kaj si gova o Isus savo sastarda le.<verse eid="JHN 5:15" /></para>
  <para style="s">O Isus vaćarol kaj si vov e Devleso Čhavo</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 5:16" />Gija, e Jevrejska šorutne lije te progonin e Isuse golese so sastarda e manuše ko savato.<verse eid="JHN 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 5:17" />Al o Isus vaćarda lenđe: “Mingro Dad uvek ćerol bući. Gija i me ćerav.”<verse eid="JHN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18" />Gola lafura sesa povod e Jevrejskone šorutnenđe te dićhen pobut te mudaren le golese so na samo so phaglja o zakon taro savato, nego so e Devle čak akharol Dade thaj gija vov ćerda pe isto sar o Dol.<verse eid="JHN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />Golese o Isus phenda lenđe: “Čače, čače vaćarav tumenđe: o Čhavo korkoro pestar našti khanči te ćerol, već samo so dićhol so ćerol o Dad. Sa so o Dad ćerol, gova ćerol i o Čhavo. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />Golese so o Dad manđol e Čhave thaj sikavol lese sa so korkoro ćerol. A ka sikavol lese i pobare buća tare kala so sastarda akale manuše, te aven zadivime i tumen. <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />Golese so, sar so o Dad vazdol e mulen thaj dol len džuvdipe, gija i o Čhavo dol džuvdipe kase manđol. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />Golese so, o Dad khanikase ni sudil, nego dija o pravo pe Čhavese te anol o sudo, <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />te bi savore poštujina e Čhave sar so poštujin e Dade. Ko ni poštujil e Čhave, ni poštujil ni e Dade savo bičhalda le.<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />Čače, čače vaćarav tumenđe: ko mingre lafura šunol thaj pačal kole savo man bičhalda, isi le džuvdipe bizo meripe thaj ni ka avol osudimo nego nakhlo andaro meripe ano džuvdipe. <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />Čače, čače vaćarav tumenđe: avol o sato – thaj već avilo – kana e mule ka šunen o glaso e Devlese Čhaveso thaj kola save šunen, ka aven džuvde. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />Sar so si o Dad izvor taro džuvdipe, gija pe Čhave ćerda izvor taro džuvdipe. <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />Thaj dija le vlast te sudil golese so si Čhavo e Manušeso.<verse eid="JHN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 5:28" />Ma čudin tumen kalese! Golese so avol o vreme kana sa e mule ka šunen o glaso e Devlese Čhaveso <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />thaj ka ikljen andare pumare limora – kola save ćerde šukar, ka ušten te prihvatin o džuvdipe bizo meripe, a kola save ćerde bilačhe, ka ušten te aven osudime. <verse eid="JHN 5:29" /><verse number="30" style="v" sid="JHN 5:30" />Me korkoro mandar khanči našti ćerav. Sudiv ko temelji so šundem tare mo Dad. A mingri presuda si pravedno golese so ni rodav te ćerav mingri volja, nego i volja kolesi savo bičhalda man.”<verse eid="JHN 5:30" /></para>
  <para style="s">Svedočanstvura taro Isus</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />“Te svedočisadem korkoro mandar, gova svedočanstvo naj dovoljno. <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />Al isi jekh aver savo svedočil mandar thaj me džanav kaj si gova svedočanstvo mandar dovoljno. <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" />Tumen bičhalden e manušen ko Jovane o Krstitelj thaj vov svedočisada tumenđe taro čačipe. <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />Manđe naj potrebno o manuš te svedočil mandar, al sa kava vaćarav tumenđe taro Jovane, te bi spasina tumen. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />O Jovane sasa sar svetiljka savi phabola thaj dola svetlost, a tumen mangljen zala vreme te uživin ane leso svetlost.<verse eid="JHN 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 5:36" />Al man isi po baro svedočanstvo tare Jovaneso. Golese so e buća save dija man mo Dad te ćerav – gola čudesna znakura save akana ćerav, svedočin mandar thaj dokažin kaj bičhalda man o Dad. <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />Thaj o Dad, savo bičhalda man, svedočisada mandar. Tumen nikad ni šunden leso glaso niti dikhljen leso muj. <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />Leso Lafi naj džuvdo ane tumende golese so ni manđen te pačan ane Koleste savo bičhalda man. <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />Tumen šukar sikljon e Sveta lila, golese so den gođi kaj šaj araćhen ane lende džuvdipe bizo meripe, a gola Sveta lila svedočin mandar. <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />Al tumen ni manđen te aven mande te avol tumen džuvdipe bizo meripe.<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />Me ni prihvativ slava tare manuša. <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />Al me pindžarav tumen thaj džanav kaj ane tumende naj e Devleso manglipe. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />Me aviljem ano alav mingre Dadeso, a ni manđen te prihvatin man. Te avol khoni aver ane piro alav, le bi prihvatina. <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />Sar šaj pačan, tumen, save prihvatin i slava jekh averestar, al i slava savi si taro jekh Dol ni roden?<verse eid="JHN 5:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 5:45" />Ma te den gođi kaj me ka tuživ tumen angle mingro Dad. Tumen ka tužil o Mojsije, ane kaste čhuten tumari nada. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />Kana bi čače pačana e Mojsijase, pačana bi i manđe. Golese so o Mojsije pisisada mandar. <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />Al te ni pačajen kova so pisisada vov, sar ka pačan ane mingre lafura!”<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">O Isus parvarol pobut tare pandž milje manušen</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mt 14,13–21</ref>; <ref loc="MRK 6:30-44">Mk 6,30–44</ref>; <ref loc="LUK 9:10-17">Lk 9,10–17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />Pale gova o Isus irisada pe ani Galileja thaj đelo ki istočno rig taro Galilejsko more, savo akhardol i Tiverijadsko more. <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />Pale leste đele but manuša, golese so dikhlje e čudesna znakura save ćerda pe nasvale manuša. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />O Isus đelo upre ko brego thaj gothe bešlo pe sikadencar. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />Sasa paše i Pasha, o prazniko e Jevrejengo.<verse eid="JHN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 6:5" />Kana vazdija o Isus pe jakha thaj dikhlja kaj aven paše leste but manuša, pučlja e Filipe: “Kaj šaj te ćina mangro kale manušenđe te xan?”<verse eid="JHN 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 6:6" />Kava pučlja te bi iskušila le, golese so već džanglja so ka ćerol.<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />O Filip vaćarda lese: “Ni dujšel (200) srebrnjakura ne bi avola dovoljno savore te xan mangro bar zala.”<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />Vaćarda lese aver tare lese sikade, o Andrija, o phral e Simoneso e Petreso: <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />“Kate isi amen jekh čhavoro kas isi pandž mangre taro ječam thaj duj cikne mačhe. Al so si gova baše gaći manuša!”<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />O Isus phenda: “Vaćaren e manušenđe te bešen!”</para>
  <para style="m" vid="JHN 6:10">Ke gova than sasa but čar thaj e manuša gothe bešle. Sesa paše pandž milja (5 000) murša.<verse eid="JHN 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 6:11" />Tegani o Isus lija kola mangre, zahvalisada e Devlese thaj dija e manušenđe save bešle gothe. Gija ćerda thaj e mačhencar, a savore xalje kobor manglje.<verse eid="JHN 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 6:12" />Kana čalile, o Isus vaćarda pe sikadenđe: “Ćiden e kotora so ačhile te ma čhudol pe.” <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />Gija ćidije dešuduj (12) korpe so ačhile tare pandž ječmena mangre, save e manuša xalje.<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />Kana e manuša dikhlje o čudesno znako savo ćerda o Isus, vaćarde: “Kava si čače kova Proroko savo trubul te avol ke kava sveto!”<verse eid="JHN 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 6:15" />A kana o Isus haljarda kaj manđen e manuša te aven thaj ki sila te ćeren le caro, đelo palem ko brego, korkoro.<verse eid="JHN 6:15" /></para>
  <para style="s">O Isus phirol po paj</para>
  <para style="r">(<ref loc="MAT 14:22-27">Mt 14,22–27</ref>; <ref loc="MRK 6:45-52">Mk 6,45–52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />Kana peli i rat, ulile lese sikade pašo more. <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />Čhute pe ano čamco thaj plovisade ki aver rig premalo Kafarnaum. Al već peli i rat, a o Isus vadži ni irisajlo premal lende. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />Tegani o more lija te vazdol pe tari bari balval. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />Kana nakhle paše pandž il šov kilometra, dikhlje e Isuse sar phirol po paj thaj sar avol pašo čamco. E sikade but darajle.<verse eid="JHN 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 6:20" />Al vov vaćarda lenđe: “Me sem, ma daran!”<verse eid="JHN 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 6:21" />Tegani lije le pesa andre ano čamco thaj o čamco tari jekh drom avilo dži ki obala kaj plovisade.<verse eid="JHN 6:21" /></para>
  <para style="s">O Isus si mangro so dol džuvdipe</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />Theara đive e manuša save ačhile ki aver rig taro Galilejsko more, primetisade kaj odori sasa samo jekh čamco thaj o Isus ni čhutape pe sikadencar ano čamco, nego kaj e sikade đele korkore. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />Tegani taro foro Tiverijada avile avera čamcura paše kova than kaj e manuša xalje mangro, baše savo o Gospod dija hvala e Devlese. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />Kana kala but manuša dikhlje kaj gothe naj ni o Isus ni lese sikade, čhute pe ane čamcura thaj đele ano Kafarnaum te roden e Isuse.<verse eid="JHN 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />Kana nakhle ki goja rig e moresi, arakhlje e Isuse thaj pučlje le: “Rabbi, kana aviljan akari?”<verse eid="JHN 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26" />A o Isus vaćarda lenđe: “Čače, čače vaćarav tumenđe: tumen roden man na golese so haljarden e čudesna znakura, nego golese so xaljen mangro thaj čaljiljen. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />Ma ćeren bući bašo xape savo naćhol, nego bašo xape savo ačhol ano džuvdipe bizo meripe. Gova xape ka dav tumen me, o Čhavo e Manušeso, golese so o Dol, o Dad mingro, ovlastisada man.”<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />Von pučlje le: “So trubul te ćera te bi ćerasa e buća save o Dol rodol amendar?”<verse eid="JHN 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29" />O Isus vaćarda lenđe: “Kava si i bući savi o Dol rodol tumendar – te pačan ane kova kas vov bičhalda.”<verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />Gija pučlje le: “Savo čudesno znako tu ka ćere te šaj dikha thaj te pača ane tute? So ka ćere? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />Amare paradada xalje mangro savo akhardola ‘mana’ ani pustinja, sar so si pisimo ane Sveta lila:</para>
  <para style="q1" vid="JHN 6:31">‘Parvarda len mangresa taro nebo.’”<verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />O Isus phenda lenđe: “Čače, čače vaćarav tumenđe: ni dija tumen o Mojsije mangro taro nebo, nego mingro Dad. Akana Vov dol tumen čačukano mangro taro nebo. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />Golese so si o mangro e Devleso kova savo uljol taro nebo thaj dol džuvdipe e svetose.”<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />Pe gova phende lese: “Gospode, de amen uvek kava mangro!”<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />O Isus vaćarda lenđe: “Me sem o mangro so dol o džuvdipe. Ko avol mande, ni ka bokhavol thaj ko pačal ane mande, ni ka avol nikad trošalo. <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />Al sar so vaćardem tumenđe: dikhljen man, al ni pačajen. <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />Dži jekhe manuše save dol manđe o Dad, avol mande; thaj kole savo avol mande ni ka tradav le avral. <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />Golese so me ni uljiljem taro nebo te ćerav mingri volja, nego i volja Kolesi savo bičhalda man. <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />A kava si i volja e Devlesi savo bičhalda man kaj kolen so dija man te ma hasarav, nego te vazdav len tare mule ko poslednjo đive. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />Golese so kava si i volja mingre Dadesi: dži jekh savo dićhol e Čhave thaj pačal ane leste, te avol le džuvdipe bizo meripe thaj me te vazdav le tare mule ko poslednjo đive.”<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />Tegani e Jevreja lije te mrmljin protiv leste golese so phenda: “Me sem mangro savo ulilo taro nebo.”<verse eid="JHN 6:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 6:42" />Thaj vaćarde: “Naj li kava o Isus, e Josifeso čhavo? Amen pindžara lese dade thaj lese da. Sar šaj vov vaćarol: ‘Me uljiljem taro nebo’?”<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />Tegani o Isus irisada lenđe vaćarindoj: “Ma mrmljin maškar tumende! <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />Našti khoni te avol mande te ni anda le mingro Dad savo bičhalda man. A me ka vazdav le tare mule ko poslednjo đive. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />Sar so ačhol ane proročka lila: ‘Savoren o Dol ka sikavol.’ Dži jekh savo šunol e Dade thaj sikljol lestar, ka avol mande. <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />Khoni ni dikhlja e Dade, sem kova savo avol taro Dol. Vov dikhlja e Dade. <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />Čače, čače vaćarav tumenđe: ko pačal ane mande, isi le džuvdipe bizo meripe! <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />Me sem mangro so dol o džuvdipe. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />Tumare paradada xalje mana ani pustinja thaj mule. <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />Al o mangro savo avol taro nebo si gasavo kaj ko xal lestar, ni ka merol. <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />Me sem kova mangro e džuvdimaso savo ulilo taro nebo. Ko xal tare kava mangro, ka avol džuvdo ane sa e đivesa. O mangro savo me dav si mingro telo, te bi e manuša kale svetoso šajine te živin.”<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />Tegani e Jevreja lije te ćeren čingara maškar peste pučindoj: “Sar šaj kava manuš te dol amen po telo xamase?”<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />A o Isus phenda lenđe: “Čače, čače vaćarav tumenđe: te ni xaljen o telo e Čhaveso e Manušeso thaj te ni piljen leso rat, naj ane tumende džuvdipe bizo meripe! <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />Ko xal mingro telo thaj pijol mingro rat, isi le džuvdipe bizo meripe thaj me ka vazdav le tare mule ko poslednjo đive. <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />Golese so mingro telo si čačukano xape thaj mingro rat si čačukano pijipe. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />Ko xal mingro telo thaj pijol mingro rat, ačhol ane mande thaj me ane leste. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />Sar so bičhalda man o džuvdo Dad thaj me sem džuvdo pašo mingro Dad, gijate kova savo xal man, ka avol džuvdo baše mande. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />Kava si kova mangro savo ulilo taro nebo, al na gasavo savo xalje tumare paradada thaj mule. Ko xal kava mangro, ka avol džuvdo ane sa e đivesa.”<verse eid="JHN 6:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59" />Sa kava o Isus vaćarda kana sikada ani sinagoga ano Kafarnaum.<verse eid="JHN 6:59" /></para>
  <para style="s">E lafura taro džuvdipe bizo meripe</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />Tegani but tare lese sikade save šunde kava, vaćarde: “Kava si but pharo vaćaripe! Ko šaj te prihvatil lese lafura?”<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />Al o Isus džanglja kaj lese sikade maškar peste mrmljin baše kala lafura thaj phenda lenđe: “Dal kava sikajipe uznemiril tumen? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />A so ka phenen ako dićhen e Čhave e Manušese sar džal upre ano nebo, odori kaj sasa angleder? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />O Sveto Duxo dol o džuvdipe, a o telo naj khančese. E lafura save me vaćardem tumenđe, si o Duxo thaj džuvdipe. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />Al si maškare tumende nesave save ni pačan.” Golese so o Isus džanglja taro anglunipe save lendar ni pačan ane leste thaj ko ka izdajil le.<verse eid="JHN 6:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="JHN 6:65" />Thaj vadži vaćarda: “Golese vaćardem tumenđe kaj khoni našti avol mande, ako naj lese dindo taro Dad.”<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />Tegani but tare lese sikade ačhade le thaj ni đele vadži pale leste.<verse eid="JHN 6:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="JHN 6:67" />A o Isus pučlja pe dešuduje (12) sikaden: “Te ni manđen te džan i tumen?”<verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />Tegani vaćarda lese o Simon o Petar: “Gospode! Kaste te dža? Samo tut isi lafura save den džuvdipe bizo meripe. <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />Amen pača thaj džana kaj tu san o Sveco e Devleso.”<verse eid="JHN 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70" />Tegani o Isus phenda lenđe: “Na li me izaberisadem tumen, e dešudujen (12)? Al ipak, jekh tumendar si beng!”<verse eid="JHN 6:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="JHN 6:71" />Gova vaćarda bašo Juda, o čhavo e Simoneso o Iskariotsko, jekh tare dešuduj (12) sikade, golese so vov si gova so ka izdajil le.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">E Isusese phrala ni pačan</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />Pale gova phirda o Isus ani Galileja. Vov ni manglja te džal ani Judejsko phuv golese so e jevrejska šorutne dikhlje te mudaren le.<verse eid="JHN 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 7:2" />Al sasa paše o prazniko e Jevrejengo kana slavina e Senice. <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />Tegani lese phrala phende lese: “Dža katar thaj dža ani Judeja, te dićhen ćire sikade e čudura save ćere! <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />Golese so nijekh ni ćerol e čudura garandoj, a manđol te džanol pe lestar. Kana već ćere gola čudura, sikav tut e svetose!”<verse eid="JHN 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 7:5" />Golese, čak ni lese phrala ni pačaje ane leste.<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />Pe gova vaćarda lenđe o Isus: “Mingro vreme vadži ni avilo, al tumenđe sa o vreme si pogodno. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />Tumen o sveto našti mrzil, al man mrzil, golese so vaćarav e manušenđe tare kava sveto, kaj si bilačhe lenđe buća. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />Tumen džan te slavin o prazniko. Al me vadži ni džav odori golese so mingro vreme vadži ni avilo.”<verse eid="JHN 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 7:9" />Gova vaćarda lenđe thaj ačhilo ani Galileja.<verse eid="JHN 7:9" /></para>
  <para style="s">O Isus sikavol ano Hram</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />Kana đele lese phrala odori te slavin o prazniko, đelo i vov, al na te dićhen le, nego garandoj.<verse eid="JHN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 7:11" />E jevrejska šorutne rodije e Isuse ko prazniko thaj pučlje: “Kaj si kova manuš?”<verse eid="JHN 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12" />I but manuša so gothe sesa, čorale vaćarde taro Isus. Nesave phende: “Vov si šukar manuš!” A e dujta vaćarde: “Naj, xoxavol e manušen!” <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />Al khoni ni vaćarda putarde lestar, golese so darajle tare jevrejska šorutne.<verse eid="JHN 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />Ko opaš taro prazniko, o Isus đelo ano Hram thaj lija te sikavol e manušen.<verse eid="JHN 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 7:15" />E jevrejska šorutne čudisajle thaj pučlje pe: “Sar kava džanol e Sveta lila, a ni sasa ane amare škole?”<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />Pe gova o Isus vaćarda lenđe: “Mingro sikajipe naj mingro, nego avol tare Kova savo bičhalda man. <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />Ko manđol te ćerol e Devlesi volja, ka pindžarol, dal si gova sikajipe taro Dol il me vaćarav korkoro mandar. <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />Ko korkoro pestar vaćarol, slava pese rodol. Al ko rodol i slava kolesi savo bičhalda le, gova si čačukano thaj naj ane leste nepravda. <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />Ni li dija tumen o Mojsije o Zakon? Thaj khoni tumendar ni ićarol pe po Zakon! Sose roden te mudaren man?”<verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />E manuša phende: “O bilačho duxo si ane tute! Ko rodol te mudarol tut?”<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />O Isus vaćarda lenđe: “Ko savato ćerdem čudo thaj savore divisaljen. <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />O Mojsije dija tumen o obrezanje thaj tumen obrezin tumare čhaven i ko savato. Iako ni avol gova adeti taro Mojsije, nego tare tumare paradada. <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />Te o manuš šaj avol obrezimo ko savato, te ma bi phađola pe o Zakon, sose tegani gaći holjavon pe mande so sastardem celone manuše ko savato? <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />Ma sudin pale kova so dićhen avral, nego sudin pravedno!”<verse eid="JHN 7:24" /></para>
  <para style="s">O Isus si o Hrist</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />Tegani vaćarde nesave manuša taro Jerusalim: “Naj li kava kova kas roden te mudaren? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />Thaj dikh, sar vaćarol putarde thaj khanči ni vaćaren lese. Te na li pindžarde i e šorutne kaj si vov čače o Hrist? <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />Al savore amen džana kotar si kava manuš, a kana ka avol o Hrist, khoni ni ka džanol kotar si!”<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />Dži kaj o Isus sikada ano Hram, zurale phenda: “Va, pindžaren man! Thaj džanen kotar sem! Al me ni aviljem korkoro mandar. Kova savo bičhalda man si čačukano. Le ni pindžaren. <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />Me pindžarav le, golese so sem lestar thaj Vov bičhalda man.”<verse eid="JHN 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30" />Tegani dikhlje te dolen le, al khoni ni čhuta po va pe leste, golese so vadži ni avilo o vreme.<verse eid="JHN 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 7:31" />A but džene tare manuša pačaje ane leste thaj phende: “Kana ka avol o Hrist, dal ka ćerol pobut čudesna znakura nego kava manuš?”<verse eid="JHN 7:31" /></para>
  <para style="s">E Jevreja manđen te dolen e Isuse</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />E fariseja šunde so e manuša garandoj phenen lestar. Gijate, von thaj e šorutne sveštenikura bičhalde e stražaren te dolen le.<verse eid="JHN 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 7:33" />Tegani o Isus vaćarda: “Vadži zala vreme ka avav tumencar, pa džav Koleste savo bičhalda man. <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />Ka roden man, al ni ka araćhen man. Tumen našti aven odori kaj sem me.”<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />Tegani e jevrejska šorutne pučlje pe maškare peste: “Kaj kava manuš manđol te džal kaj amen našti te arakha le? Šaj manđol te džal ke amare so živin maškare Grkura thaj te sikavol e Grkuren? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />So si kava lafi so vaćarda: ‘Ka roden man, al ni ka araćhen man’, thaj: ‘Tumen našti aven odori kaj sem me’?”<verse eid="JHN 7:36" /></para>
  <para style="s">O Isus sikavol tare leja e džuvde pajese</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />Ko poslednjo thaj emvažno đive taro prazniko, ačhilo o Isus thaj dija vika vaćarindoj: “Ko si trošalo, nek avol mande thaj nek pijol! <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />Ko pačal ane mande, sar so o Sveto lil vaćarol, e leja džuvde pajese ka thavden andar leste!”<verse eid="JHN 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 7:39" />O Isus gova vaćarda taro Sveto Duxo save trubul te prihvatin kola save ka pačan ane leste. Tegani vadži naj sasa dindo o Sveto Duxo golese so o Isus naj sasa vadži proslavimo.<verse eid="JHN 7:39" /></para>
  <para style="s">Ulaipe maškare manuša</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />Kana nesave džene tare but manuša šunde gola lafura, vaćarde: “Kava si čače kova Proroko save ađućara.”<verse eid="JHN 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41" />Avera vaćarde: “Kava si čače o Hrist.”</para>
  <para style="p" vid="JHN 7:41">Al sesa i kola save vaćarde: “Na. Vov našti te avol o Hrist. Dal o Hrist ka avol andari Galileja? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />Ni li sikavol o Sveto lil kaj o Hrist ka avol taro bijandipe e Davideso thaj andaro gav o Vitlejem kaj o David živisada?”<verse eid="JHN 7:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 7:43" />Gija paše leste ane manuša ćerdilo ulaipe. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />Nesave lendar dikhlje te dolen le, al khoni ni čhuta pe vasta pe leste.<verse eid="JHN 7:44" /></para>
  <para style="s">E jevrejska šorutne ni pačan</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />Kana e stražara palem avile ke šorutne sveštenikura thaj ke fariseja, von pučlje len: “Sose ni anden le?”<verse eid="JHN 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />E stražara phende lenđe: “Khoni nikad gija ni vaćarda sar kava manuš.”<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />Pe gova e fariseja vaćarde lenđe: “Dal i tumen diljarda? <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />Na li khoni tare šorutne il tare fariseja pačaje ane leste? Na. <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />Nego, kala manuša si prokleta, golese so ni pindžaren o Zakon!”<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />Tegani o Nikodim, jekh tare fariseja, gova savo angleder avilo ko Isus ki rat, pučlja: <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />“Dal amaro Zakon šaj osudil e manuše ako angleder naj gova manuš šundo thaj ni džanol pe so ćerda?”<verse eid="JHN 7:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52" />A von phende lese: “Naj li san i tu tari Galileja? Pošukar rode ano Sveto lil thaj ka dićhe kaj nijekh proroko ni ka avol andari Galileja.”<verse eid="JHN 7:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 7:53" />[Tegani, savore đele pese ćhere.<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s">Džuvli sava dolde ki preljuba</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />O Isus đelo ko Maslinsko brego. <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />A sabalin palem avilo ano Hram thaj sa e manuša ćidije pe paše leste. Vov bešlo thaj lija te sikavol len. <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />Tegani e učitelja tare Mojsijaso zakon thaj e fariseja ande ke leste džuvlja savi sasa doldi ani preljuba. Čhute la maškar e manuša <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />thaj vaćarde lese: “Učitelju! Kaja džuvli si doldi kana ćerda preljuba. <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />O Mojsije ano Zakon naredisada gasave džuvljen te mudara barencar. So vaćare tu?”<verse eid="JHN 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 8:6" />Kava vaćarde te bi iskušina le, sar te avol len paše so te banđaren le.</para>
  <para style="p" vid="JHN 8:6">Al o Isus čučnisada tele thaj pisisada najesa pi phuv.<verse eid="JHN 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 8:7" />A sar ni ačhade e učitelja tare Mojsijaso zakon thaj e fariseja te pučen le, vov uspravisajlo thaj vaćarda lenđe: “Ko si maškar tumende bizo greh, angleder nek čhudol pe late o bar.”<verse eid="JHN 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 8:8" />Palem čučnisada thaj pisisada ki phuv.<verse eid="JHN 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 8:9" />Kana von gova šunde, lije te džan gothar jekh pale avereste. Angleder lije te džan e po purane. Gija gothe ačhilo samo o Isus e džuvljasa so sasa ko maškar.<verse eid="JHN 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 8:10" />Tegani o Isus uspravisajlo thaj pučlja la: “Džuvlije! Kaj si kala? Nijekh ni osudisada tut?”<verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />Voj phenda: “Nijekh, Gospode!”</para>
  <para style="p" vid="JHN 8:11">Gija o Isus vaćarda laće: “Ni me ni osudiv tut. Dža thaj vadži ma greši!”]<note caller="+" style="f"><char style="fr" closed="false">8,11 </char><char style="ft" closed="false">Najranija rukopisura naj len e stihura tare 7,53 dži o 8,11. </char></note><verse eid="JHN 8:11" /></para>
  <para style="s">O Isus si svetlo e svetoso</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />Pale gova o Isus pale phenda e manušenđe: “Me sem svetlo e svetoso. Ko džal pale mande, nikad ni ka phirol ano kalipe, al ka avol le svetlost savo inđarol ano džuvdipe.”<verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />Tegani vaćarde lese e fariseja: “Tu korkoro tuće svedoči. Ćiro svedočanstvo naj dovoljno.”<verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />O Isus phenda lenđe: “Thaj te svedočiv korkoro mandar, dovoljno si mingro svedočanstvo, golese so džanav kotar avav thaj kaj džav. Al tumen ni džanen kotar avav thaj kaj džav. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />Tumen sudin palo manušikano merilo, al me ni sudiv khanikase. <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />Al čak i te sudisadem, mingro sudo si čačukano, golese so ni sudiv korkoro, nego si mancar o Dad savo bičhalda man. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />A i ane tumaro Zakon ačhol pisimo kaj o svedočanstvo si dovoljno ako duj svedokura vaćarde isto. <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />Me svedočiv korkoro mandar thaj manđe svedočil o Dad savo bičhalda man.”<verse eid="JHN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19" />Tegani pučlje le: “Kaj si ćiro dad?”</para>
  <para style="p" vid="JHN 8:19">O Isus phende lenđe: “Tumen ni džanen ko sem me, pa ni džanen ni ko si mingro Dad. Kana bi džanena man, bi džanena i le.”<verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />Kala lafura o Isus vaćarda kana sikada e manušen ano Hram paše kutije kaj ćidena pe e pare. Thaj khoni ni dolda le golese so vadži ni avilo leso sato.<verse eid="JHN 8:20" /></para>
  <para style="s">E Jevreja ni pačan e Isuse</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />O Isus palem vaćarda lenđe: “Me džav thaj tumen ka roden man thaj ka meren ane tumaro greh. Kaj me džav, odori tumen našti aven.”<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />Tegani e Jevrejska šorutne lije te pučen pe: “Te ni manđol te mudarol pe kana gija vaćarol: ‘Kaj me džav, odori tumen našti aven’?”<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />O Isus vaćarda lenđe: “Tumen sen tare telune, a me sem tare uprune. Tumen sen tare kava sveto, al me naj sem tare kava sveto. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />Golese vaćardem tumenđe kaj ka meren ane tumare grehura. Ako ni ka pačan kaj Me Sem, ka meren ane tumare grehura.”<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />Tegani pučlje le: “Ko san tu?”</para>
  <para style="p" vid="JHN 8:25">O Isus vaćarda lenđe: “Me sem kova so taro anglunipe vaćarav tumenđe. <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />But isi man so bi šajine te vaćarav tumendar pe tumari osuda. Kova savo bičhalda man si čačukano thaj me vaćarav samo kale svetose so šundem Lestar.”<verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />Al von ni haljarde kaj vaćarda lenđe taro Dad.<verse eid="JHN 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 8:28" />Golese o Isus vaćarda lenđe: “Kana ka vazden e Čhave e Manušese, tegani ka džanen kaj Me Sem thaj korkoro mandar khanči ni ćerav, nego vaćarav gija sar sikada man o Dad. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />Thaj Kova so bičhalda man si mancar. Ni ačhada man korkore, golese so me ćerav kova so si lese šukar.”<verse eid="JHN 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30" />Kana kava o Isus vaćarda, but džene pačaje ane leste.<verse eid="JHN 8:30" /></para>
  <para style="s">O čačipe ka oslobodil tumen</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />Tegani vaćarda o Isus kole Jevrejenđe save pačaje ane leste: “Ako tumen ačhen ano mingro sikajipe, čače sen mingre sikade. <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />Thaj ka pindžaren o čačipe thaj o čačipe ka oslobodil tumen.”<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />A e Jevreja phende lese: “Amen sam potomkura e Avraamese thaj nikase nikad ni sama robura. Sar šaj te vaćare: ‘Ka aven oslobodime’?”<verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />O Isus phenda lenđe: “Čače, čače, vaćarav tumenđe: dži jekh ko ćerol greh, si robo e grehose. <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />O robo ni ačhol ani familija zauvek, al o čhavo ačhol zauvek. <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />Te oslobodisada tumen o Čhavo, čače ka aven oslobodime. <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />Džanav kaj sen potomkura e Avraamese. Al tumen dićhen te mudaren man, golese so ane tumare ile naj than mingre lafese. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />Me vaćarav gova so sikada manđe o Dad thaj tumen ćeren kova so phenda tumenđe tumaro dad.”<verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />Von vaćarde lese: “Amaro dad si o Avraam.”</para>
  <para style="p" vid="JHN 8:39">O Isus phenda lenđe: “Te aven čhave e Avraamese, bi ćerena gova so ćerda o Avraam. <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />Al umesto gova tumen akana dićhen te mudaren man, samo golese so vaćardem tumenđe čačipe savo šundem taro Dol. O Avraam nikad ni ćerda gija! <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />Tumen ćeren e buća tumare dadese.”</para>
  <para style="p" vid="JHN 8:41">Tegani vaćarde lese: “Amen naj sam bijande tari preljuba. Jekh dad isi amen, o Dol!”<verse eid="JHN 8:41" /></para>
  <para style="s">E benđese čhave</para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />O Isus vaćarda lenđe: “Kana bi avola o Dol tumaro dad, manđena bi i man golese so me ikliljem taro Dol thaj akana sem akari. Me ni aviljem korkoro mandar, nego vov bičhalda man. <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />Sose našti haljaren so vaćarav tumenđe? Golese so našti trpin mingro lafi. <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />Tumaro dad si o beng thaj tumen manđen te ćeren kova so vov manđol. Vov sasa taro anglunipe kova savo mudarol thaj ni ićarol pe po čačipe, golese so ane leste naj khanči čačipe. Kana xoxavol, vov sikavol piro čačukano muj golese so si xoxavno thaj si dad e xoxaimaso. <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />Al golese so me čačipe vaćarav, tumen ni pačan man. <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />Ko tumendar šaj dokažil manđe jekh greh? Te vaćardem čačipe, sose ni pačan man? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />Ko si taro Dol, šunol e Devlese lafura. Tumen ni šunen golese so naj sen taro Dol.”<verse eid="JHN 8:47" /></para>
  <para style="s">O Isus thaj o Avraam</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />E Jevreja pučlje le: “Ni li šukar vaćara kaj san Samarijanco thaj o beng si ane tute?”<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />O Isus vaćarda: “Ane mande naj beng, nego me poštujiv mingre Dade a tumen man ni poštujin. <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />Me ni rodav slava manđe – isi khoni savo rodol la thaj savo sudil. <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />Čače, čače vaćarav tumenđe: ko ićarol pe ke mingro lafi, nikad ni ka dićhol o meripe.”<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />Tegani vaćarde lese e Jevreja: “Akana džana kaj si o beng ane tute. O Avraam mulo thaj gija i e prorokura, a tu vaćare: ‘Ko ićarol pe ke mingro lafi, nikad ni ka dićhol o meripe.’ <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />Tu li san po baro tare amaro dad o Avraam, savo mulo? Thaj e prorokura mule. So tu misli, ko san tu?”<verse eid="JHN 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54" />O Isus phenda lenđe: “Te slavisadem man korkore, mingri slava khanči ni vredil. Al man proslavil mingro Dad, savese tumen vaćaren kaj si tumaro Dol. <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />Iako tumen ni pindžaren le, me pindžarav le. Te vaćardem kaj ni pindžarav le, bi avava xoxavno sar tumen. Al me pindžarav le thaj ke leso Lafi ićarav man. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />O Avraam, tumaro dad, radujisajlo so ka dićhol mingro avipe. Thaj dikhlja le thaj radujisada pe.”<verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />Tegani e Jevreja vaćarde lese: “Vadži naj tut pinda (50) berš, a vaćare kaj dikhljan e Avraame?”<verse eid="JHN 8:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58" />O Isus phenda lenđe: “Čače, čače vaćarav tumenđe: angleder nego so bijandilo o Avraam, Me Sem!”<verse eid="JHN 8:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59" />Tegani lije e bara thaj manglje te čhuden len pe leste, al o Isus garadilo thaj iklilo taro Hram.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">O Isus sastarol e kore manuše</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />Dži kaj o Isus nakhlo, dikhlja jekhe manuše savo sasa koro taro leso bijandipe.<verse eid="JHN 9:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 9:2" />Lese sikade pučlje le: “Rabbi! Ko ćerda greh pa bijandilo koro? Vov, il leso dad il lesi dej?”<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />O Isus vaćarda: “Naj koro golese so grešisada vov, il leso dad il lesi dej. Bijandilo koro te dićhol pe e Devlesi zor pe leste. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />A dok si đive, amen mora te ćera e buća Kolese savo bičhalda man. Ka perol i rat, kana khoni našti ćerol bući. <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />Dok sem ko sveto, me sem svetlo e svetoso.”<verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />Kana vaćarda kava, čhungarda ki phuv thaj ćerda taro čhungaripe čik, thaj makhlja e čikasa e korese jakha.<verse eid="JHN 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 9:7" />Thaj vaćarda lese: “Dža thov tut ani banja Siloam.” (Siloam značil “Bičhaldo”.)</para>
  <para style="m" vid="JHN 9:7">Gija kova manuš đelo thaj thoda pe thaj irisajlo ćhere dikhljindoj.<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />A lese komšije thaj kola save dikhlje le angleder sar prosila, vaćarde: “Naj li kava savo bešola pašo drom thaj prosila?”<verse eid="JHN 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 9:9" />Nesave vaćarde: “Va, vov si.”</para>
  <para style="p" vid="JHN 9:9">Al avera: “Naj, samo ličil pe leste.”</para>
  <para style="p" vid="JHN 9:9">A vov korkoro phenda: “Me sem gova manuš.”<verse eid="JHN 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10" />Tegani pučlje le: “Sar putajle ćire jakha thaj akana dićhe?”<verse eid="JHN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11" />Vov vaćarda lenđe: “Manuš savo akhardol Isus, ćerda tari phuv čik, makhlja mingre jakha thaj vaćarda: ‘Dža ani banja Siloam thaj thov tut.’ Gija đeljem thaj thodem ma, thaj lijem te dikhav.”<verse eid="JHN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12" />Von pučlje le: “Kaj si vov?”</para>
  <para style="p" vid="JHN 9:12">Vov phenda: “Ni džanav.”<verse eid="JHN 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />Tegani kale manuše so sasa angleder koro inđarde ke fariseja. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />Al gova đive kana ćerda o Isus i čik thaj putarda lese jakha, sasa savato. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />Golese pučlje le e fariseja sar putardile lese jakha.</para>
  <para style="m" vid="JHN 9:15">Vov vaćarda lenđe: “Ke mingre jakha čhuta čik, thodem ma thaj akana dikhav!”<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />Tegani vaćarde nesave tare fariseja: “Kava manuš naj taro Dol, golese so ćerol bući ko savato.”</para>
  <para style="m" vid="JHN 9:16">Al avera phende: “Sar o grešno manuš šaj ćerol gasave čudesna znakura?”</para>
  <para style="m" vid="JHN 9:16">Thaj gija sasa maškar lende čingara.<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />Tegani e fariseja palem pučlje e manuše savo sasa angleder koro: “So tu vaćare baše kava manuš so putarda ćire jakha?”</para>
  <para style="m" vid="JHN 9:17">Vov vaćarda: “Proroko si.”<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />Al e jevrejska šorutne ni pačaje kaj sasa koro thaj kaj putajle lese jakha, sa dži kaj ni akharde lese dade thaj lese da, <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />thaj pučlje len: “Kava li tumaro čhavo tare savo vaćaren kaj bijandilo koro? Tegani, sar akana dićhol?”<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />Leso dad thaj lesi dej vaćarde: “Džana kaj si kava amaro čhavo savo bijandilo koro. <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />Al sar akana dićhol thaj ko putarda lese jakha, amen ni džana. Pučen le! Barilo thaj šaj te vaćarol korkoro pestar.”<verse eid="JHN 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 9:22" />Kava vaćarde leso dad thaj lesi dej, golese so darajle tare jevrejska šorutne. Golese kaj e jevrejska šorutne angleder odlučisade kaj zauvek ka ikalen tari sinagoga dži jekhe ko priznajil e Isuse sar e Hriste. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />Golese phende leso dad thaj lesi dej: “Pherda pe berša. Le pučen!”<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />Tegani palo dujto drom akharde e manuše savo sasa koro thaj vaćarde lese: “De e Devlese čast! Priznaji o čačipe! Amen džana kaj kova manuš, savo putarda ćire jakha, si grešniko.”<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />Al vov phenda lenđe: “Grešno li si, ni džanav, al džanav kaj sema koro thaj akana dikhav!”<verse eid="JHN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26" />A pučlje le: “So ćerda tuće? Sar putarda ćire jakha?”<verse eid="JHN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27" />O manuš savo sasa koro vaćarda lenđe: “Me već vaćardem gova tumenđe, al tumen ni mangljen te šunen. Sose palem manđen te šunen? I tumen li manđen te aven lese sikade?”<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />Tegani von lije te vređin le thaj vaćarde lese: “Tu san leso sikado, al amen sam sikade e Mojsijase. <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />Amen džana kaj o Dol vaćarola e Mojsijasa. Al kalese ni džana ni kotar avol.”<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />Kova sastardo manuš vaćarda lenđe: “Gova si čače čudo! Tumen ni džanen kotar si, al putarda mingre jakha. <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />Amen džana kaj o Dol ni šunol e grešnikuren, al šunol kole savo si devlikano thaj ko lesi volja ćerol. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />Od kana si o sveto, vadži ni šundilo kaj khoni putarda e jakha kolese so bijandilo koro. <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />Te ne bi avola kava taro Dol, khanči ne bi šajine te ćerol.”<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />Von phende lese: “Pherdo san grehura taro ćiro bijandipe thaj tu bi khanči sikavesa amen!”</para>
  <para style="m" vid="JHN 9:34">Thaj tradije le andari sinagoga.<verse eid="JHN 9:34" /></para>
  <para style="s">Duxovno koripe</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />O Isus šunda kaj tradije le andari sinagoga thaj kana arakhlja le, pučlja le: “Pača li tu ano Čhavo e Manušeso?”<verse eid="JHN 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36" />Vov pučlja le: “Ko si gova, gospodarona, te pačav ane leste?”<verse eid="JHN 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37" />O Isus phenda lese: “Dikhljan le! Gova si kova so vaćarol tusa!”<verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />Tegani vov vaćarda: “Va, pačav, Gospode!” Thaj pelo pe koča angle leste.<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />O Isus vaćarda: “Me aviljem ke kava sveto te sudiv. Aviljem te šaj dićhen kola save ni dikhlje thaj te sikavav kolenđe save den gođi kaj dićhen kaj si kore.”<verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />Nesave fariseja save sesa lesa, gova šunde thaj vaćarde lese:</para>
  <para style="m" vid="JHN 9:40">“Te naj sam i amen kore?”<verse eid="JHN 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41" />O Isus vaćarda lenđe: “Kana bi priznajina kaj sen kore, ne bi avena kriva pašo greh al golese so phenen: ‘Dikha’, gija tumari krivica ačhol.”<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">O Isus si o šukar pastiri</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />O Isus vadži vaćarda: “Čače, čače vaćarav tumenđe: ko ni uljol ko vudar ano tor e bakrengo nego hutol čorale prekalo duvari, vov si čor thaj razbojniko. <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />Al ko uljol ko vudar, vov si pastiri e bakrengo. <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />Lese o stražari putrol o vudar thaj e bakre šunen leso glaso. Vov pe bakren akharol ko alav thaj ikalol len avral. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />Kana ikalol sa pe bakren, džal angle lende thaj e bakre džan pale leste, golese so pindžaren leso glaso. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />Palo kova kas ni pindžaren, ni ka džan, nego ka našen lestar golese so leso glaso ni pindžaren.”<verse eid="JHN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6" />O Isus vaćarda lenđe kaja paramič, al von ni haljarde so manglja te vaćarol lenđe.<verse eid="JHN 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />Golese o Isus vadži phenda lenđe: “Čače, čače vaćarav tumenđe: Me sem vudar e bakrenđe. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />Savore save avile angleder mande si čora thaj razbojnikura, al e bakre ni šunde len. <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />Me sem vudar. Ko dol maškar mande ka avol spasimo. Ka džal andre thaj ka ikljol thaj ka araćhol lačho pašnjako. <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />O čor avol te čorol, te čhinol thaj te mudarol. Me aviljem te avol len džuvdipe thaj gova ano izobilje.<verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />Me sem šukar pastiri. Šukar pastiri dol po džuvdipe pe bakrenđe. <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />O manuš savo si poćindo te araćhol e bakren. Vov naj pastiri, gola bakre naj lese – kana dićhol e ruve kaj avol, ačhavol e bakren thaj našol. A o ruv napadil len thaj e bakre našen ke sa e riga. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />Golese so vov si samo poćindo manuš thaj ni ačhilo lese dži e bakre.<verse eid="JHN 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 10:14" />Me sem šukar pastiri. Me pindžarav mingre bakren thaj von man pindžaren. <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />Sar so o Dad pindžarol man, i me gija pindžarav e Dade. Me mingro džuvdipe dav me bakrenđe. <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />Isi man i avera bakre save naj tare kava tor thaj len trubul te anav. Von ka šunen mingro glaso thaj ka aven jekh stado jekhe pastiresa.<verse eid="JHN 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17" />Mingro Dad manđol man, golese so dav mingro džuvdipe te bi lava le palem. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />Khoni ni lol o džuvdipe mandar, nego me dav le korkoro mandar. Vlast isi man te dav mingro džuvdipe thaj vlast isi man i te lav le palem. Kava zapovest lijem tare mingro Dad.”<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />Tegani palem putajle čingara maškare Jevreja baše kala lafura. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />But lendar vaćarde: “Ane leste si o beng thaj dilajlo. Sose šunen le?”<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />Al avera phende: “Kala lafura našti aven taro kova ane kaste si o beng. Šaj li o beng e korenđe jakha te putrol?”<verse eid="JHN 10:21" /></para>
  <para style="s">O Isus phenol kaj si e Devleso Čhavo</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />Tegani ano Jerusalim slavila pe o Prazniko Hanuka, o svetipe e Hrameso, a sasa jevend.<verse eid="JHN 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 10:23" />O Isus phirda ano Hram ki terasa e Solomonesi. <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />A e Jevrejska šorutne okolisade le thaj pučlje le: “Dži kana ka garave amendar ko san tu? Te san o Hrist, vaćar amenđe putarde!”<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />O Isus phenda lenđe: “Me vaćardem tumenđe, al ni pačajen. Buća save ćerav ano alav mingre Dadeso, svedočin mandar. <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />Al tumen ni pačan, golese so naj sen tare mingre bakre. <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />Mingre bakre šunen mingro glaso. Me pindžarav len thaj von džan pale mande. <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />Me dav len džuvdipe bizo meripe thaj von nikad ni ka mudardon. Khoni ni ka crdol len tare mingre vasta. <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />Mingro Dad savo dija len manđe, pozuralo si savorendar thaj khoni našti crdol len tare vasta mingre Dadese. <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />Me thaj mingro Dad sam jekh.”<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />Tegani e Jevreja palem lije bara thaj manglje te čhuden len pe leste. <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />O Isus vaćarda lenđe: “But lačhe buća sikadem tumenđe tare mingro Dad. Za ke save lačhe buća manđen te čhuden bara pe mande?”<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />E Jevreja phende lese: “Ni manga te čhuda pe tute bara baše šukar buća, nego so huli po Dol. Ćere tut Dol, al samo san manuš!”<verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />O Isus vaćarda lenđe: “Ni li ačhol ano tumaro Zakon: ‘Me phendem: tumen sen dolura’? <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />Te akharda dolura gasaven savenđe avilo o Lafi e Devleso – thaj o Sveto lil našti promenil pe – <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />sar šaj tumen te vaćaren kolese kas o Dad svetisada thaj bičhalda le ki phuv: ‘Huli’, golese so vaćardem: ‘Me sem Čhavo e Devleso’? <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />Te ni ćerav e buća mingre Dadese, ma pačan man. <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />Al te ćerav, i te ane mande ni pačan, gole bućenđe pačan, te bi pindžarena thaj te bi džanena kaj si o Dad ane mande thaj me ano Dad.”<verse eid="JHN 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39" />Pale gova von palem dikhlje te dolen le, al vov crdija pe lenđe andare vasta.<verse eid="JHN 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40" />Tegani o Isus palem đelo ke aver rig tari len o Jordan, ko than kaj angleder krstila o Jovane. Thaj ačhilo gothe.<verse eid="JHN 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 10:41" />A but manuša avile leste thaj vaćarde: “O Jovane ni ćerda nijekh čudesno znako, al avilo čače sa so vaćarda kale manušestar.”<verse eid="JHN 10:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 10:42" />Thaj but džene gothe pačaje ano Isus.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">E Lazareso meripe</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />Nesavo manuš savo akhardola Lazar sasa nasvalo. Vov sasa tari Vitanija, taro gav kaj bešle i Marija thaj laći phen i Marta. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />(I Marija si koja savi ka čhorol o miris po Gospod thaj ka kosol lese pingre pe balencar. Lako phral o Lazar sasa nasvalo.)<verse eid="JHN 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 11:3" />E pheja golese bičhalde palo Isus vaćarindoj: “Gospode! Ćiro manglo amal si nasvalo.”<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />Kana o Isus gova šunda, phenda: “Kava nasvalipe ni ka anol meripe, već slava e Devlese, te bi prekal kava nasvalipe proslavila pe o Čhavo e Devleso.”<verse eid="JHN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5" />O Isus manglja e Marta thaj laće pheja e Marija thaj e Lazare. <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />Gija, kana šunda bašo nasvalipe e Lazareso, ačhilo vadži duj đive odori kaj sasa, <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />thaj pale gova vaćarda pe sikadenđe: “Ajde te dža palem ani Judeja!”<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />E sikade phende lese: “Rabbi! Okova đive e jevrejska šorutne manglje te mudaren tut barencar, a tu palem manđe odori te dža?”<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />O Isus vaćarda: “Dal o đive naj le dešuduj (12) satura? Ko phirol ko đive, našti perol, golese so dićhol o svetlo kale svetoso. <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />Al ko džal ki rat, perol, golese so naj videlo ane leste.”<verse eid="JHN 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 11:11" />Kava vaćarda thaj vadži phenda: “O Lazar, amaro amal zasuta, a me džav te džungavav le.”<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />Tegani phende lese e sikade: “Gospode! Te zasuta, ka sastol!”<verse eid="JHN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13" />Al o Isus vaćarda bašo meripe e Lazareso, a von dije gođi kaj o Lazar čače sovol.<verse eid="JHN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 11:14" />Tegani o Isus putarde vaćarda lenđe: “O Lazar mulo. <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />Zbog tumende raduji man so ni sema odori, te bi šaj pačana. Al, ajde ka dža ke leste.”<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />Tegani o Tomo, savo akhardola Bliznako, phenda avere sikadenđe: “Ajde te dža i amen te mera lesa.”<verse eid="JHN 11:16" /></para>
  <para style="s">O Isus si uštipe tare mule thaj džuvdipe</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />Kana o Isus avilo odori, dodžanglja kaj čhute e Lazare ano limori angleder štar đive. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />I Vitanija sasa pašo Jerusalim paše trin kilometra. <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />Tegani gothar but Jevreja avile ki Marta thaj ki Marija te kovljaren i dukh pale lengo phral. <verse eid="JHN 11:19" /><verse number="20" style="v" sid="JHN 11:20" />Kana i Marta šunda so o Isus avilo, iklili angle leste, a i Marija ačhili ćhere.<verse eid="JHN 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 11:21" />I Marta vaćarda e Isusese: “Gospode! Te avesa kate, ne bi merola mingro phral! <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />Al me i akana džanav kaj sa so ka rode taro Dol, ka dol tut!”<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />O Isus vaćarda laće: “Ćiro phral ka uštol tare mule.”<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />I Marta phenda lese: “Džanav kaj ka uštol tare mule kana savore ka ušten, ano poslednjo đive.”<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />O Isus vaćarda laće: “Me sem uštipe tare mule thaj džuvdipe. Ko pačal ane mande, i te mulo, ka avol džuvdo. <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />Dži jekh savo si džuvdo thaj pačal ane mande, nikad ni ka merol. Pača li ane kava, Marto?”<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />Voj phenda lese: “Va, Gospode! Me pačav kaj tu san o Hrist, o Čhavo e Devleso, savo trubuja te avol ki phuv.”<verse eid="JHN 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />Kana kava vaćarda, đeli te akharol pe pheja thaj po zala vaćarda laće: “O učitelji avilo thaj manđol te dićhol tut.” <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />Kana i Marija gova šunda, uštili sigate thaj đeli ke leste. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />O Isus vadži ni sasa ano gav, nego vadži sasa ko than kaj reslja le i Marta. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />Kana e Jevreja save sesa e Marijasa ano ćher thaj kovljarde lenđi dukh, dikhlje kaj i Marija sigate uštili thaj iklili avral, i von đele pale late golese so dije gođi kaj džal ko limori te rovol odoringate.<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />Kana i Marija resli ko than kaj sasa o Isus thaj dikhlja le, peli angle lese pingre thaj vaćarda lese: “Gospode! Te avesa kate, ne bi merola mingro phral!”<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />Kana o Isus dikhlja kaj i Marija lija te rovol thaj kaj roven i e Jevreja save avile lasa, but potresisajlo ano duxo thaj žal sasa lese. <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />O Isus pučlja: “Kaj čhuten le?”</para>
  <para style="p" vid="JHN 11:34">Vaćarde lese: “Gospode, av te dićhe.”<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />A o Isus lija te rovol.<verse eid="JHN 11:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 11:36" />Tegani e Jevreja phende: “Dikh kobor manglja le!”<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />Al nesave lendar vaćarde: “Naštine li kava savo putarda e jakha e korese, te ćerol kava manuš te ni merol?”<verse eid="JHN 11:37" /></para>
  <para style="s">O Isus vazdol e Lazare tare mule</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />O Isus tegani palem potresisajlo thaj đelo ko limori. Gova sasa pećina kaso ulaz phanglje bare baresa.<verse eid="JHN 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 11:39" />O Isus phenda: “Crden o bar!”</para>
  <para style="m" vid="JHN 11:39">I Marta, i phen koleso so mulo, vaćarda lese: “Gospode! Vov već khandol, golese so nakhle štar đive sar mulo.”<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />Tegani o Isus vaćarda laće: “Na li phendem tuće kaj ka dićhe i slava e Devlesi te pačajan?”<verse eid="JHN 11:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 11:41" />Sigate crdije o bar. Tegani o Isus vazdija pe jakha upre premalo nebo thaj phenda: “Dade! Hvala tuće so šundan man. <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />Me džanav kaj uvek šune man, al kava vaćardem zbog e manuša save ačhen kate, te pačan kaj tu bičhaldan man.”<verse eid="JHN 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 11:43" />Kana phenda kava, dija vika andare sa o glaso: “Lazare, iklji avri!” <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />Thaj iklilo o mulo. Lese vasta thaj lese pingre sesa paćarde čaršafesa thaj leso muj sasa phanglo kotoresa.</para>
  <para style="p" vid="JHN 11:44">O Isus vaćarda lenđe: “Putren le thaj mućhen le te džal!”<verse eid="JHN 11:44" /></para>
  <para style="s">E jevrejska šorutne planirin te mudaren e Isuse</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mt 26,1–5</ref>; <ref loc="MRK 14:1-2">Mk 14,1–2</ref>; <ref loc="LUK 22:1-2">Lk 22,1–2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />Tegani but Jevreja save avile ki Marija thaj dikhlje so ćerda o Isus, pačaje ane leste. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />Al nesave lendar đele ke fariseja thaj vaćarde lenđe so ćerda o Isus.<verse eid="JHN 11:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 11:47" />Golese e šorutne sveštenikura thaj e fariseja ćidije e manušen andaro Baro sudo thaj vaćarde: “So ka ćera? Kava manuš ćerol but čudesna znakura. <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />Te ačhadam le gija, savore ka pačan ane leste. Pale gova ka aven e Rimljanura thaj ka len amaro Hram thaj amare narodo.”<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />Tegani o Kajafa, jekh lendar, savo gova berš sasa baro svešteniko, vaćarda: “Tumen khanči ni džanen! <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />Ni den gođi kaj si tumenđe pošukar jekh manuš te merol baše manuša, te ma bi sa o narodo properola.”<verse eid="JHN 11:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 11:51" />O Kajafa ni vaćarda kava korkoro pestar, nego, sar baro svešteniko gole beršeso, prorokujisada kaj o Isus trubul te merol bašo sa o narodo. <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />Thaj na samo bašo narodo, nego te bi ćidola katane sa e strvime čhaven e Devlese thaj te aven sar jekh.<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />Gija gova đive dogovorisajle e jevrejska šorutne te mudaren e Isuse. <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />Golese o Isus vadži ni phirda putarde maškare jevrejska šorutne, al gothar đelo ani phuv paši pustinja, ano gav savo akhardol Efrem thaj gothe sasa pe sikadencar.<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />A sasa paše o prazniko e Jevrejengo – Pasha thaj but Jevreja tari sa i phuv avile ano Jerusalim angleder i Pasha, te ćeren o adeti e thodimaso. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />Tegani rodije e Isuse thaj kana ačhile ano Hram, pučlje jekh avere: “So den gođi? Ka avol li vov ki Pasha?”<verse eid="JHN 11:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 11:57" />Gija, e šorutne sveštenikura thaj e fariseja već dije naredba, ko ka dodžanol kaj si o Isus, te prijavil le, sar bi dolena e Isuse.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">E Isuseso pomazanje ani Vitanija</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mt 26,6–13</ref>; <ref loc="MRK 14:3-9">Mk 14,3–9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />Šov đive angleder o prazniko i Pasha avilo o Isus ano gav i Vitanija, kaj bešlo o Lazar, manuš kas o Isus vazdija tare mule. <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />Gothe ćerde e Isusese večera. I Marta služisada, a o Lazar sasa maškare kola so bešle pašo astali e Isusesa. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />Tegani i Marija lija paše opaš litra skupoceno mirisno ulje taro čisto nardo, makhlja e Isusese pingre thaj koslja len pe balencar. A o ćher pherdilo lačho miris.<verse eid="JHN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 12:4" />Tegani jekh tare Isusese sikade, o Juda o Iskariotsko savo pale gova izdajisada le, vaćarda: <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />“Sose kava mirisno ulje ni bićinda pe baše trišel (300) srebrenjakura, a e pare te den pe e čororenđe?”<verse eid="JHN 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 12:6" />Al vov kava ni vaćarda golese so ačhilo lese dži ke čore, nego golese so sasa čor. Leste sasa i kesa e parencar thaj vov lola pese gothar kova so čhuvola pe gothe.<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />Tegani o Isus vaćarda: “Ačhav la! Gova ćerda te pripremil man bašo đive za ko mingro prahope! <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />Čore uvek ka aven maškar tumende, al me ni ka avav uvek tumencar.”<verse eid="JHN 12:8" /></para>
  <para style="s">E šorutne sveštenikura dićhen te mudaren e Lazare</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />But Jevreja dodžanglje kaj si o Isus ani Vitanija. Al ni đele odori samo te dićhen e Isuse, nego te dićhen i e Lazare kas o Isus vazdija tare mule. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />Gija e šorutne sveštenikura dogovorisajle te mudaren e Lazare <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />golese so zbog leste but Jevreja ačhade len thaj lije te pačan ano Isus.<verse eid="JHN 12:11" /></para>
  <para style="s">O Isus avol ano Jerusalim sar caro</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mt 21,1–11</ref>; <ref loc="MRK 11:1-11">Mk 11,1–11</ref>; <ref loc="LUK 19:28-40">Lk 19,28–40</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />Theara đive but džene save avile ki Pasha, šunde kaj o Isus avol ano Jerusalim. <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />Lije e palmaće raja, iklile angle leste thaj dije vika:</para>
  <para style="q1" vid="JHN 12:13">“Hosana!</para>
  <para style="q2" vid="JHN 12:13">Blagoslovimo si kova savo avol ano alav e Gospodeso!</para>
  <para style="q2" vid="JHN 12:13">Blagoslovimo si o Caro e Izraeleso!”<verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />A o Isus arakhlja terne here thaj bešlo pe leste sar so si pisimo ano Sveto lil:<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />“Ma daran, manušalen ano Jerusalim!</para>
  <para style="q1" vid="JHN 12:15">Akh, ćiro Caro avol bešindoj po terno her!”<verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />Lese sikade tegani gova ni haljarde, al kana o Isus sasa vazdimo ani piri slava, dije gođi kaj sasa gija pisimo ano Sveto lil taro Isus thaj gija i ćerde lese.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />E manuša save sesa e Isusesa kana akharda e Lazare te ikljol taro limori thaj vazdija le tare mule, širisade o lafi golestar. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />Golese iklile angle leste but manuša golese so šunde kaj ćerda gova čudesno znako.<verse eid="JHN 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 12:19" />Tegani e fariseja vaćarde jekh averese: “Dićhen kaj khanči našti ćera. Ek, sa o sveto đelo pale leste!”<verse eid="JHN 12:19" /></para>
  <para style="s">O Isus vaćarol tare piro meripe</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />A maškare manuša sesa Grkura save avile te peren ke koča anglo Dol, ki Pasha. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />Von avile pašo Filip savo sasa tari Galilejsko Vitsaida pa molisade le: “Gospodarona, amen manga te dikha e Isuse!”<verse eid="JHN 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22" />O Filip đelo thaj vaćarda gova e Andrijase thaj zajedno đele te vaćaren gova e Isusese. <verse eid="JHN 12:22" /><verse number="23" style="v" sid="JHN 12:23" />O Isus vaćarda lenđe: “Avilo o sato te primil i slava o Čhavo e Manušeso. <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />Čače, čače vaćarav tumenđe: te i o seme taro điv ni perol ki phuv thaj ni merol, ačhol samo jekh zrno. Al te mulo, anol barvalo bijanipe. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />Ko manđol piro džuvdipe, ka hasarol le. A ko mrzil piro džuvdipe ki kaja phuv, ka araćhol le bašo džuvdipe bizo meripe. <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />Ko služil man, mora te phirol pale mande. Kaj sem me, gothe ka avol i mingro sluga. Mingro Dad ka dol čast kolese savo man služil.<verse eid="JHN 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />Mingri duša si akana uznemirimi. So me te vaćarav? Te vaćarav li: ‘Dade, arakh ma tari patnja’? Al baš golese i aviljem! <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />Dade! Proslavi ćiro alav!”</para>
  <para style="m" vid="JHN 12:28">Tegani šundilo o glaso taro nebo: “Već proslavisadem le thaj palem ka proslaviv le!”<verse eid="JHN 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29" />Kana gova šunde e manuša save odori ačhile, vaćarde: “Grmisada.” <verse eid="JHN 12:29" /><verse number="30" style="v" sid="JHN 12:30" />Al avera phende: “O anđelo vaćarda lesa.”</para>
  <para style="m" vid="JHN 12:30">A o Isus pe gova vaćarda lenđe: “Kava glaso ni šundilo baše mande, nego baše tumende. <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />Akana si o vreme kale svetose te avol sudimo! Akana o vladari kale svetoso ka avol čhudimo avral. <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />A me, kana ka avav vazdimo tari phuv, sa e manušen ka crdav paše mande.”<verse eid="JHN 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 12:33" />Gova vaćarda te sikavol save merimasa ka merol.<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />E manuša phende lese: “Šundam taro Zakon kaj o Hrist ka ačhol ane sa e đivesa. Sar tu šaj vaćare kaj o Čhavo e Manušeso trubul te avol vazdimo te merol? Ko si gova ‘Čhavo e Manušeso’?”<verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />Tegani o Isus vaćarda lenđe: “O svetlo ni ka avol vadži but vreme maškar tumende. Phiren dži kaj isi tumen svetlo, te ni nadvladil tumen o kalipe. Golese so, ko phirol ano kalipe, ni džanol kaj džal. <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />Dži kaj isi tumen svetlo, pačan e svetlose, te šaj aven e čhave e svetlose!”</para>
  <para style="m" vid="JHN 12:36">Kana gova o Isus phenda, đelo thaj garadilo lendar.<verse eid="JHN 12:36" /></para>
  <para style="s">Pačajipe thaj bipačajipe e Jevrejengo</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37" />Iako gaći čudesna znakura ćerda angle lende o Isus, von palem ni pačaje ane leste. <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />Gova sasa te bi pherdola kova so vaćarda o proroko o Isaija:</para>
  <para style="q1" vid="JHN 12:38">“Gospode, ko pačaja amare haberese?</para>
  <para style="q1" vid="JHN 12:38">Kase sikadilo o zuralo va e Gospodeso?”<verse eid="JHN 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39" />Golese naštine te pačan, golese so o Isaija vadži vaćarda:<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />“O Dol korada lenđe jakha,</para>
  <para style="q2" vid="JHN 12:40">thaj zurada lengo ilo,</para>
  <para style="q1" vid="JHN 12:40">jakhencar te ni dićhen,</para>
  <para style="q2" vid="JHN 12:40">thaj ilesa te ni haljaren,</para>
  <para style="q1" vid="JHN 12:40">te ni irin pe premal mande</para>
  <para style="q2" vid="JHN 12:40">te sastarav len.”<verse eid="JHN 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41" />Kava phenda o Isaija, golese so dikhlja e Isusesi slava thaj vaćarda lestar.<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />A čak i but džene tare jevrejska šorutne pačaje ane leste, nego zbog e fariseja ni priznajisade le javno, te ma bi ikalena len zauvek tari sinagoga. <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />Golese, po šukar sasa lenđe o čast savo avol tare manuša nego o čast savo dol o Dol.<verse eid="JHN 12:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />Tegani o Isus dija vika andare sa o glaso: “Ko pačal ane mande, ni pačal samo ane mande, nego i ane Koleste savo bičhalda man. <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />Thaj ko dićhol man, dićhol i Kole savo bičhalda man. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />Me – o Svetlost – aviljem ki phuv, ma te ačhol ano kalipe nijekh ko ane mande pačal. <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />Te khoni šunol mingre lafura al ni ićarolpe pe lende, me ni sudiv le. Golese so, me ni aviljem te sudiv o sveto, nego te spasiv o sveto. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />Ko odbacil man thaj ni lol mingre lafura, isi le leso sudija. O Lafi savo me vaćardem ka sudil le ko poslednjo đive. <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />Golese so, me ni vaćardem korkoro mandar, nego o Dad, savo bičhalda man, zapovedisada manđe so te vaćarav thaj so te phenav. <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />Thaj me džanav kaj leso zapovest anol džuvdipe bizo meripe. Gija, so me vaćarav, vaćarav gija sar so o Dad phenda manđe.”<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">O Isus thovol e sikadenđe pingre</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />Angleder o prazniko i Pasha, džanglja o Isus kaj avol o sato te naćhol tare kava sveto ko Dad. O Isus dži o krajo sikavola kobor manđol kolen so preperen lese ke kava sveto.<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />Avilo vreme za ki večera. O beng e Judase, e čhavese e Simonese o Iskariotsko, već čhuta ano ilo te izdajil e Isuse. <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />O Isus džanglja kaj o Dad dija le sa o vlast ane vasta thaj kaj taro Dol iklilo thaj ko Dol iril pe. <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />Uštilo tari večera, uljarda po ogrtači, lija o peškiri thaj phanglja pe lesa. <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />Pale gova čhorda paj ano lavori thaj lija te thovol e sikadenđe pingre thaj te kosol len e peškiresa savesa phanglja pe.<verse eid="JHN 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 13:6" />Kana avilo dži o Simon Petar, vov vaćarda lese: “Gospode! Tu li mingre pingre ka thove?”<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />O Isus vaćarda lese: “So me ćerav akana tu ni džane, al jekh đive ka džane.”<verse eid="JHN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8" />O Petar vaćarda lese: “Nikad tu ni ka thove mingre pingre!”</para>
  <para style="m" vid="JHN 13:8">O Isus vaćarda lese: “Te ni thodem tut, našti ave jekh tare mingre.”<verse eid="JHN 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9" />O Simon Petar phenda lese: “Gospode, onda thov na samo mingre pingre, nego i mingre vasta thaj mingro šoro!”<verse eid="JHN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10" />O Isus vaćarda lese: “Kolese savo si najardo, trubul te thoven pe samo lese pingre, golese so si leso telo sa thodo! Thaj tumen sen thode, al na savore.”<verse eid="JHN 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 13:11" />O Isus džanglja ko ka izdajil le, pa golese vaćarda: “Naj sen savore thode.”<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />Kana o Isus thoda lenđe pingre, čhuta pe peste o ogrtači, pale bešlo ke piro than pašo astali thaj pučlja len: “Džanen li so ćerdem tumenđe? <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />Tumen man akharen Učitelji thaj Gospod thaj šukar vaćaren, golese so me sem gova. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />Te me, tumaro Gospod thaj Učitelji, thodem tumare pingre, tegani i tumen trubun te thoven jekh averenđe pingre. <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />Dijem tumen primer i tumen gija te ćeren sar so me ćerdem tumenđe. <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />Čače, čače vaćarav tumenđe: o sluga naj po baro taro piro gospodari, ni o bičhaldo naj po baro tare kova savo bičhalda le. <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />Golese so kava džanen, blagoslovime sen ako gova ćeren.”<verse eid="JHN 13:17" /></para>
  <para style="s">O Isus vaćarol tare leso izdajniko</para>
  <para style="r">(<ref loc="MAT 26:20-25">Mt 26,20–25</ref>; <ref loc="MRK 14:17-21">Mk 14,17–21</ref>; <ref loc="LUK 22:21-23">Lk 22,21–23</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />“Ni vaćarav savorenđe tumenđe. Me džanav kolen kas birisadem! Al trubul te pherdol gova so si pisimo ano Sveto lil: ‘Kova savo xal mangro mancar, iril manđe po dumo.’ <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />Vaćarav tumenđe akana, angleder nego so ka avol, gija kana gova ka avol, te pačan kaj Me Sem. <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />Čače, čače vaćarav tumenđe: ko primil kole kas me bičhalav, man primil thaj ko primil man, primil kole so man bičhalda.”<verse eid="JHN 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />Kana vaćarda kava o Isus, leso duxo sasa uznemirimo, golese putarde vaćarda: “Čače, čače vaćarav tumenđe: jekh tumendar ka izdol man.”<verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />Tegani e sikade dikhlje pe maškar peste, golese so ni džanglje kastar gova vaćarol. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />Jekh tare lese sikade, kas o Isus but manglja, bešlo pašo Isus. <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />O Simon Petar dija le znako thaj vaćarda: “Puč le kastar gova vaćarol.”<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />Kava so bešlo pašo Isus, nakhlo popaše paše leste thaj pučlja le: “Gospode, ko si gova?”<verse eid="JHN 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26" />O Isus phenda: “Kova kase bolav o mangro ano čaro thaj dav le.”</para>
  <para style="m" vid="JHN 13:26">Tegani bolda o mangro ano čaro thaj dija e Judase, e čhavese e Simonese e Iskariotskonese. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />Kana o Juda xalja, o Satana ulilo ane leste.</para>
  <para style="m" vid="JHN 13:27">Tegani o Isus lese vaćarda: “Gova so manđe te ćere, ćer akana.”<verse eid="JHN 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 13:28" />Khoni kolendar so bešle lesa pašo astali, ni haljarda sose o Isus vaćarda lese gova. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />Golese so ko Juda sasa i kesa e parencar, nesave dije gođi kaj o Isus phenol lese te džal te ćinol khanči xamase bašo prazniko, il te dol khanči e čororenđe. <verse eid="JHN 13:29" /><verse number="30" style="v" sid="JHN 13:30" />Pale gova so o Juda xalja o mangro, iklilo sigate. A sasa rat.<verse eid="JHN 13:30" /></para>
  <para style="s">Nevo zapovest</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />Kana o Juda iklilo, o Isus phenda: “Akana ka proslavil pe o Čhavo e Manušeso thaj o Dol ka proslavil pe ane leste. <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />Ako o Dol ka proslavil pe ane leste, o Dol le ka proslavil ane peste thaj ka proslavil le sigate. <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" />Čhavoralen mingralen, vadži zala ka avav tumencar! Ka roden man, al sar so vaćardem e jevrejskone šorutnenđe, gija akana vaćarav i tumenđe: ‘Kaj me džav, tumen našti aven odori.’ <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" />Nevo zapovest dav tumen: Manđen jekh avere. Sar so me mangljem tumen, gija i tumen te manđen jekh avere. <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />Pale gova savore ka pindžaren kaj tumen sen mingre sikade, te isi tumen o manglipe jekh averese.”<verse eid="JHN 13:35" /></para>
  <para style="s">O Isus vaćarol kaj o Petar ka odreknil pe lestar</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mt 26,31–35</ref>; <ref loc="MRK 14:27-31">Mk 14,27–31</ref>; <ref loc="LUK 22:31-34">Lk 22,31–34</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />O Simon Petar pučlja e Isuse: “Gospode, kaj dža?”</para>
  <para style="m" vid="JHN 13:36">O Isus vaćarda lese: “Kaj me džav, tu akana našti dža pale mande, al pale gova ka dža.”<verse eid="JHN 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37" />O Petar pučlja le: “Gospode, sose akana našti džav pale tute? Me tuće ka dav i mingro džuvdipe!”<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />O Isus pučlja le: “Ka de ćo džuvdipe manđe? Čače, čače vaćarav tuće, angleder so ka đilabol o bašno, trin droma ka vaćare kaj ni pindžare man.”<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">O Isus si o drom dži ko Dad</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />O Isus vaćarda: “Te ma aven žalna tumare ile! Pačan ano Dol thaj pačan ane mande. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />Ano ćher mingre Dadeso isi but thana. Te ma avol gija, ne bi vaćarava tumenđe: ‘Džav te pripremiv tumenđe than.’ <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />Kana ka džav thaj pripremiv tumenđe than, palem ka avav thaj ka lav tumen mande te bi tumen avena kaj sem me. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />A tumen džanen o drom kaj me džav.”<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />O Tomo phenda: “Gospode, ni džana kaj dža. Sar šaj džana o drom?”<verse eid="JHN 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6" />O Isus vaćarda lese: “Me sem o drom, o čačipe thaj o džuvdipe. Khoni ni ka avol ko Dad, sem prekal mande. <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />Kana bi man pindžarena, ka pindžaren i mingre Dade. Od akana tumen džanen le thaj dikhljen le.”<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />O Filip vaćarda lese: “Gospode, sikav amenđe e Dade thaj dosta ka avol amenđe!”<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />Pe gova phenda lese o Isus: “Gaći vreme sem tumencar, Filipe, thaj tu vadži ni džane ko sem me? Ko dikhlja man, dikhlja e Dade. Sar onda šaj phene: ‘Sikav amenđe e Dade’? <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />Ni li pača kaj me sem ano Dad thaj o Dad si ane mande? Lafura save vaćarav tumenđe ni vaćarav korkoro mandar, nego o Dad savo si džuvdo ane mande, ćerol pe buća. <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />Pačan man kaj me sem ano Dad thaj o Dad si ane mande. Te na, pačan zbog e buća save ćerdem. <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />Čače, čače vaćarav tumenđe: ko pačal ane mande, ka ćerol buća save me ćerav, pa i pobare buća ka ćerol, golese so me džav ko Dad. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />Sa so ka roden ane mingro alav, me ka ćerav, te proslavil pe o Dad ano Čhavo. <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />Bilo so te roden ane mingro alav, ka ćerav.”<verse eid="JHN 14:14" /></para>
  <para style="s">O Isus obećil kaj ka bičhalol e Svetone Duxo</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />“Te man mangljen, ka ićaren mingre zapovestura. <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />A me ka moliv mingre Dade thaj vov ka bičhalol tumenđe avere Zastupniko te avol tumencar ane sa e đivesa: <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />o Duxo e čačimaso save o sveto našti primil, golese so ni dićhen le thaj ni pindžaren le. Al tumen pindžaren le, golese so živil tumencar thaj ka avol ane tumende. <verse eid="JHN 14:17" /><verse number="18" style="v" sid="JHN 14:18" />Ni ka ačhavav tumen sar čororen. Palem ka irima tumende. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />Vadži zala, o sveto man ni ka dićhol, al tumen ka dićhen man. Golese so sem me džuvdo thaj i tumen ka aven džuvde. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />Ane gova đive ka pindžaren kaj me sem ane mingro Dad thaj tumen sen ane mande thaj me ane tumende. <verse eid="JHN 14:20" /><verse number="21" style="v" sid="JHN 14:21" />Ko prihvatisada mingre zapovestura thaj ićarol len, gova manđol man. A ko manđol man, le ka manđol i mingro Dad. I me ka mangav le thaj me ka sikadivav lese.”<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />O Juda (na o Iskariotsko) vaćarda lese: “Gospode, sar gova kaj ka sikave tu samo amenđe, a na e svetose?”<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />O Isus phenda lese: “Te khoni manglja man, ka ićarol pe ko mingro lafi thaj mingro Dad ka manđol le. Leste ka ava, mingro Dad thaj me thaj lesa ka beša. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />Ko ni manđol man, ni ićarol pe ko mingro lafi. A o lafi so šunen, naj mingro, nego taro Dad savo bičhalda man.<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />Kava vaćardem tumenđe kana vadži sema tumencar. <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />Al o Zastupniko, o Sveto Duxo, kas o Dad ka bičhalol te zastupil man, ka sikavol tumen tare sa thaj ka dol tumen gođi sa so vaćardem tumenđe.<verse eid="JHN 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />Ačhavav tumenđe mir, mingro mir dav tumen. Al me ni dav tumen gova mir sar so dol tumen o sveto. Te ma uznemirin pe tumare ile thaj te ma daran. <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />Šunden kaj vaćardem tumenđe: ‘Džav thaj palem ka avav tumende.’ Te manđen man, bi avena radosna so džav ko Dad golese so si o Dad po baro mandar.<verse eid="JHN 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 14:29" />Vaćarav tumenđe gova akana, angleder so gova ka avol, te pačan kaj gova ka avol. <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />Ni ka vaćarav tumenđe vadži but, golese so avol o vladari kale svetoso. Le naj vlast pe mande. <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />Al, te bi o sveto dodžanola sar mangav e Dade, ćerav baš sar so naredisada manđe o Dad.</para>
  <para style="m" vid="JHN 14:31">A akana, ajde ušten ka dža katar!”<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">O Isus si čačukano čokot</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />“Me sem čačukano čokot thaj mingro Dad si vinogradari. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />Vov čhinol dži jekh loza pe mande savi ni anol bijanipe. Thaj rezil dži jekh savi anol bijanipe, te bi anola pobut bijanipe. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />Tumen sen već rezime thaj thode lafesa savo me vaćardem tumenđe. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />Ačhen tumen ane mande thaj me ka ačhav ane tumende! Sar so i loza našti anol bijanipe korkori pestar te ni ačhili po čokot, gija i tumen našti aven kola save šaj anen bijanipe te ni ačhiljen ane mande.<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />Me sem o čokot, a tumen loze. Ko ačhol ane mande thaj me ane leste, anol but bijanipe, golese so bize mande khanči našti te ćeren. <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />Ko ane mande ni ačhol, ka čhudol pe avri sar i čhindi loza thaj ka šućhol. Tegani ka ćiden gasave loze thaj ka čhuden len ani jag kaj ka phabaren len. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />Te ačhiljen ane mande thaj mingre lafura ane tumende, roden sa so manđen thaj ka dol pe tumenđe. <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />Mingro Dad ka proslavil pe gija so ka anol but bijanipe thaj so ka aven mingre sikade.<verse eid="JHN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 15:9" />Sar so o Dad manglja man, gija i me mangljem tumen. Ačhen ane mingro manglipe! <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />Te ićarden tumen pe mingre zapovestura, ka ačhen ane mingro manglipe, sar so i me ićardem ma ke zapovestura mingre Dadese thaj ačhav ane leso manglipe.<verse eid="JHN 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 15:11" />Gova vaćardem tumenđe te avol mingro radujipe ane tumende thaj tumaro radujipe te avol pherdo. <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />Kava si mingro zapovest: manđen jekh avere sar so me mangljem tumen. <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />Po baro manglipe naj tare kava nego kana khoni dol piro džuvdipe pe amalenđe. <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />Tumen sen mingre amala te ćerden kova so zapovediv tumenđe. <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />Ni akharav tumen više sluge golese so o sluga ni džanol so ćerol leso gospodari. Akana akharav tumen mingre amala golese so vaćardem tumenđe sa so phenda manđe mingro Dad. <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />Ni birisaden tumen man, nego me birisadem tumen thaj čhutem tumen te džan thaj te anen bijanipe savo ka ačhol thaj te dol tumen mingro Dad sa so ka roden ane mingro alav. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />Kava zapovediv tumenđe: manđen jekh avere!”<verse eid="JHN 15:17" /></para>
  <para style="s">O sveto ni manđol e sikaden</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />“Te mrzil tumen o sveto, džanen kaj man mrzisada angleder tumende. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />Kana bi preperena e svetose, o sveto bi manđola tumen. Al, golese so ni preperen kale svetose, nego me birisadem tumen taro sveto, golese o sveto mrzil tumen. <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />Den tumen gođi so vaćardem tumenđe: ‘O sluga naj po baro taro piro gospodari.’ Te man progonisade, ka progonin i tumen. Te ićarde pe ke mingro lafi, ka ićaren pe i ke tumaro. <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />A sa gova von ka ćeren tumenđe baše mande, golese so ni džanen Kole savo bičhalda man. <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />Te ni aviljem thaj ni vaćardem lenđe, ne bi avena banđe. Al akana naj len so te vaćaren baše pe grehura. <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />Ko man mrzil, mrzil i mingre Dade. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />Te ma ćerava maškar lende buća save khoni aver ni ćerda, ne bi avena banđe. Al von dikhlje buća save ćerdem a palem mrzisade i man thaj mingre Dade. <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />Al trubul te pherdol o lafi savo si pisimo ane lengo Zakon: ‘Mrzisade man nisose.’<verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />A kana ka avol o Zastupniko, save ka bičhalav tumenđe taro mingro Dad – o Duxo e čačimaso savo ikljol taro Dad – vov ka svedočil mandar. <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />Thaj i tumen ka svedočin mandar, golese so taro anglunipe sen mancar.”<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />O Isus vaćarda: “Kava vaćardem tumenđe te ma peren taro pačajipe. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />Ka ikalen tumen zauvek tari sinagoga, a avol o vreme kana dži jekh savo ka mudarol tumen ka dol gođi kaj golesa služil e Devle. <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />A gova ka ćeren, golese so ni pindžarde ni e Dade ni man. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />Kava vaćardem tumenđe, kana ka avol o vreme, te den tumen gođi kava so phendem tumenđe golestar.” Thaj vadži vaćarda o Isus: “Ni vaćardem tumenđe kava ko anglunipe, golese so sema tumencar.<verse eid="JHN 16:4" /></para>
  <para style="s">Bući e Svetone Duxosi</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5" />Al akana džav Koleste ko bičhalda man thaj khoni tumendar ni pučol man: ‘Kaj dža?’ <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />Nego, golese so vaćardem gova tumenđe, tumare ile pherdile žal. <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />Al me vaćarav tumenđe o čačipe: pošukar tumenđe me te džav. Golese so, te me ni đeljem, o Zastupniko ni ka avol. Al te đeljem, ka bičhalav le tumenđe. <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />A kana vov ka avol, ka dokažil e manušenđe ano sveto so si čače o greh, o pravednost thaj o sudo. <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />Vov ka dokažil e manušenđe ano sveto kaj si ano greh golese so ni pačan ane mande. <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />Ka dokažil lenđe kaj grešin ano dićhipe taro pravednost golese so džav ko Dad thaj odori vadži ni ka dićhen man. <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />Thaj ka dokažil lenđe ko sudo e Devleso golese so o vladari e svetoso si već osudimo.<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />Vadži but isi man so te vaćarav tumenđe, al akana gova našti inđaren. <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />Al kana ka avol vov, o Duxo e čačimaso, ka inđarol tumen ke sa o čačipe. Golese so ni ka vaćarol korkoro pestar, nego ka vaćarol kova so šunol. Vov ka objavil tumenđe i gova so ka avol. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />Vov ka proslavil man golese so ka lol so si mingro thaj ka objavil tumenđe. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />Sa so isi e Dade, mingro si. Golese vaćardem tumenđe kaj ka lol so si mingro thaj ka objavil tumenđe.”<verse eid="JHN 16:15" /></para>
  <para style="s">I žal ka naćhol ano radujipe</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />O Isus vadži phenda: “Vadži zala thaj ni ka dićhen man. Thaj vadži zala thaj palem ka dićhen man.”<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />Tegani nesave tare lese sikade lije te pučen jekh avere: “So značil gova so vaćarol amenđe: ‘Vadži zala thaj ni ka dićhen man. Thaj vadži zala thaj palem ka dićhen man’ thaj: ‘Me džav ko Dad’?”<verse eid="JHN 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 16:18" />Pale gova vaćarde: “So značil gova so vaćarol: ‘Vadži zala’? Ni džana so manđol te phenol.”<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />O Isus džanglja so manglje te pučen le, golese vaćarda lenđe: “Pučen tumen jekh avere so značil gova so vaćardem: ‘Vadži zala thaj ni ka dićhen man. Thaj vadži zala thaj palem ka dićhen man’? <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />Čače, čače vaćarav tumenđe: tumen ka roven thaj ka tugujin, al o sveto ka radujil pe. Tumen ka aven žalna, al tumari žal ka ćerdol radujipe. <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />I džuvli si žalosno kana bijanol golese so avilo o vreme tare laće dukha. Al kana bijandol o čhavoro, bistrol o pharipe golese so radujil pe so anda e manuše ko sveto. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />Gija i tumen sen akana ani žal, al me ka dikhav tumen palem thaj tumare ile ka radujin pe. Thaj khoni našti te lol tumendar tumaro radujipe. <verse eid="JHN 16:22" /><verse number="23" style="v" sid="JHN 16:23" />Ane gova đive khanči ni ka pučen man. Čače, čače vaćarav tumenđe: sa so ka roden taro Dad ane mingro alav, vov ka dol tumenđe. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />Dži akana khanči ni rodijen ane mingro alav. Roden thaj ka dobin, gija tumaro radujipe te avol pherdo!”<verse eid="JHN 16:24" /></para>
  <para style="s">O Isus pobedisada o sveto</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />“Gova vaćardem tumenđe ane slike. Al avol o vreme kana vadži ni ka vaćarav tumenđe ane slike, nego putarde ka vaćarav tumenđe taro Dad. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />Ane gova đive ka roden e Dade ane mingro alav. Ni vaćarav tumenđe kaj me ka moliv e Dade tumenđe. <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />Golese so o Dad korkoro manđol tumen golese so tumen mangljen man thaj pačajen kaj me ikliljem taro Dol. <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />Me ikliljem taro Dad thaj aviljem ke kava sveto. Akana ačhavav kava sveto thaj džav ko Dad.”<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />Tegani lese sikade vaćarde: “Akh, akana vaćare putarde thaj ni phene ane slike. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />Akana džana kaj naj potreba khoni te pučol tut khanči golese so tu angleder sa džane. Golese pača kaj ikliljan taro Dol.”<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />O Isus vaćarda lenđe: “Akana pačan? <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />Akh, avol o vreme – thaj akana avilo – kana dži jekh tumendar ka našol ko kaj dićhol, a man ka ačhaven korkore. Al me naj sem korkoro, golese so o Dad si mancar. <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />Kava vaćardem tumenđe, te avol tumen ane mande mir. Ano sveto ka avol tumen patnje, al ohrabrin tumen – me pobedisadem o sveto!”<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">E Isusesi molitva</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />Kana kava vaćarda o Isus, vazdija pe jakha premal o nebo thaj vaćarda: “Dade, avilo o vreme! Proslavi ćire Čhave, te šaj o Čhavo proslavil tut. <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />Golese so, tu dijan le vlast pe sa e manuša, te dol džuvdipe bizo meripe, savoren saven tu dijan le. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />A o džuvdipe bizo meripe si kava: te pindžaren tut, jekhe čačukane Devle thaj e Isuse Hriste kas bičhaldan. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />Me tut proslavisadem ki phuv gija so završisadem i bući savi dijan man te ćerav. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />Akana, Dade, proslavi man ke tute, slavasa savi sasa man ke tute angleder so ćerdilo o sveto.”<verse eid="JHN 17:5" /></para>
  <para style="s">O Isus molil pe pe sikadenđe</para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />“Objavisadem ćiro alav kolenđe saven dijan man tare kava sveto. Sesa ćire thaj tu dijan len manđe thaj von ićarde ćiro Lafi. <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />Akana džanen kaj sa so dijan man avol tutar. <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />Golese so dijem len ćire lafura save tu dijan man, a von len prihvatisade thaj pindžarde kaj si čače kaj me aviljem tutar thaj pačaje kaj tu bičhaldan man.<verse eid="JHN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9" />Lenđe me moliv. Ni moliv bašo sveto, nego baše kola saven tu dijan man golese so si ćire. <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />Sa so si mingro, si ćiro thaj sa so si ćiro si mingro, a me ane lende proslavisaljem. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />Me naj sem vadži ko sveto, al von si ano sveto thaj me avav tute. Dade Svetoneja, arakh len ane ćiro alav savo dijan man, te aven jekh sar so sam i amen jekh. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />Dži kaj sema lencar, arakhljem len ane ćiro alav, savo dijan man. Arakhljem len thaj nijekh lendar ni hasajlo, osim kova so sasa osudimo za ko propast, te bi pherdola o Sveto lil.<verse eid="JHN 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 17:13" />Akana avav ke tute, al kava vaćarav dži kaj sem vadži ano sveto, te bi i len avola pherdo radost savo man isi. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />Me dijem len ćiro Lafi thaj o sveto zamrzisada len golese so ni pripadin e svetose, sar so me ni pripadiv e svetose. <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />Ni moliv tut te le len taro sveto, nego te araćhe len taro Bilačho. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />Von ni pripadin e svetose, sar so me naj sem taro sveto. <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />Posveti len ćire čačimasa – ćiro Lafi si čačipe. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />Sar so tu man bičhaldan ano sveto, gija i me len bičhalav ano sveto. <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />Predav man te služiv tut baše lende, te bi i von avena posvetime te služin tut ano čačipe.”<verse eid="JHN 17:19" /></para>
  <para style="s">O Isus molil pe savorenđe save pačan</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />“Al ni moliv man samo lenđe, nego thaj sa kolenđe save ka pačan prekalo lengo haberi ane mande, <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />te bi avena savore jekh. Sar so san tu Dade ane mande thaj me ane tute, gija von nek aven ane amende, o sveto te bi pačala kaj tu bičhaldan man. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />Me predijem lenđe i slava, savi tu dijan man, te aven jekh sar so sam amen jekh – <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />me ane lende thaj tu ane mande – te aven savršeno katane, te bi o sveto džanola kaj tu man bičhaldan thaj kaj len mangljan sar so man mangljan.<verse eid="JHN 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24" />Dade, mangav, i kolen so dijan man te aven mancar gothe kaj sem me, thaj te dićhen mingri slava, savi dijan man, golese so tu mangljan man angleder nego so ćerdilo o sveto. <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />Dade pravednoneja, o sveto ni pindžarol tut, al me pindžarav tut. Thaj i kala pindžarde kaj tu bičhaldan man. <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />Me lenđe objavisadem ćiro alav thaj ka objaviv le vadži, te bi o manglipe savesa mangljan man avola ane lende thaj me ane lende.”<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">E Isuse izdajin thaj phanden</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mt 26,47–56</ref>; <ref loc="MRK 14:43-50">Mk 14,43–50</ref>; <ref loc="LUK 22:47-53">Lk 22,47–53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />Kana o Isus završisada i molitva, nakhlo pe sikadencar ki dujto rig tari Kedronesi dolina. Gothe sasa vrt thaj đele ane leste. <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />Al kava than džanglja i o Juda leso izdajniko, golese so o Isus but droma ćidija pe gothe pe sikadencar. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />Tegani o Juda lija e rimskone četa thaj e hramese stražaren save sesa bičhalde tare šorutne sveštenikura thaj tare fariseja thaj avile ano vrt. Pesa ande svetiljke, baklje thaj oružje.<verse eid="JHN 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 18:4" />O Isus, golese so džanglja sa so ka avol lesa, iklilo thaj vaćarda lenđe: “Kas roden?”<verse eid="JHN 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5" />Vaćarde lese: “E Isuse taro Nazaret.”</para>
  <para style="m" vid="JHN 18:5">O Isus vaćarda lenđe: “Me sem!”</para>
  <para style="m" vid="JHN 18:5">Ačhilo gothe lencar o Juda leso izdajniko. <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />Kana o Isus phenda: “Me sem!”, crdije pe palal thaj pele ki phuv.<verse eid="JHN 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 18:7" />Tegani o Isus pučlja len palem: “Kas roden?”</para>
  <para style="m" vid="JHN 18:7">Von vaćarde lese: “E Isuse taro Nazaret.”<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />O Isus phenda lenđe: “Phendem tumenđe: Me sem. Te rodijen man, mućhen kala avera nek džan!” <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />Kava vaćarda te pherdol gova so angleder vaćarda: “Dade, ni hasardem nijekhe kolendar so dijan man.”<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />Tegani o Simon Petar savo sasa le čhuri, ikalda la thaj čalada e sluga e bare sveštenikose thaj čhinda leso desno kan. E slugaso alav sasa Malho.<verse eid="JHN 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 18:11" />O Isus vaćarda e Petrese: “Iri i čhuri palal! O tahtaj e patimaso savo dija man mingro Dad te ma li pijav?”<verse eid="JHN 18:11" /></para>
  <para style="s">E Isuse ande anglo Ana</para>
  <para style="r">(<ref loc="MAT 26:57-58">Mt 26,57–58</ref>; <ref loc="MRK 14:53-54">Mk 14,53–54</ref>; <ref loc="LUK 22:54">Lk 22,54</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />Tegani i rimsko četa, lengo šorutno thaj e hramese stražara dolde e Isuse thaj phanglje le <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />thaj inđarde le ko Ana, o sastro e Kajafaso savo sasa baro svešteniko gova berš. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />O Kajafa sasa kova savo angleder sikada e Jevrejskone šorutnenđe kaj si pošukar jekh manuš te merol bašo sa o narodo.<verse eid="JHN 18:14" /></para>
  <para style="s">O Petar odreknil pe taro Isus</para>
  <para style="r">(<ref loc="MAT 26:69-70">Mt 26,69–70</ref>; <ref loc="MRK 14:66-68">Mk 14,66–68</ref>; <ref loc="LUK 22:55-57">Lk 22,55–57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />Palo Isus đele o Simon Petar thaj jekh aver sikado. Gova o dujto sikado džanglja pe e bare sveštenikosa, golese šajine te džal ani avlin katane e Isusesa. <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />Al gothar o Petar ačhilo avral angli kapija. Tegani iklilo kova dujto sikado kas o baro svešteniko džanglja thaj vaćarda kole sluškinjaće te mućhol andre e Petre.<verse eid="JHN 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 18:17" />Tegani pučlja i sluškinja e Petre: “Naj li san tu jekh tare sikade kole manušese?”</para>
  <para style="p" vid="JHN 18:17">O Petar vaćarda: “Naj sem!”<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />A e sluge thaj e stražara phabarde jag taro angar thaj ačhile gothe te taton, golese so sasa šul. Thaj o Petar ačhilo lencar te tatol.<verse eid="JHN 18:18" /></para>
  <para style="s">O baro svešteniko pučol e Isuse</para>
  <para style="r">(<ref loc="MAT 26:59-66">Mt 26,59–66</ref>; <ref loc="MRK 14:55-64">Mk 14,55–64</ref>; <ref loc="LUK 22:66-71">Lk 22,66–71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />O baro svešteniko pučlja e Isuse baše lese sikade thaj tare leso sikajipe.<verse eid="JHN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 18:20" />O Isus vaćarda lese: “Me vaćardem putarde sa e manušenđe. Uvek sikadem ane sinagoge thaj ano Hram, kaj ćiden pe sa e Jevreja thaj khanči ni vaćardem garandoj. <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />Sose puče man? Puč kolen save šunde so vaćardem lenđe. Von džanen so vaćardem!”<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />Kana o Isus kava vaćarda, jekh tare stražara savo gothe ačhilo, čalada le ki čham thaj vaćarda: “Gija li vaćarol pe e bare sveštenikosa?”<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />O Isus irisada lese vaćarindoj: “Te vaćardem khanči bilačhe, dokaži manđe so si gova! Al te vaćardem čačipe, sose čalave man?”<verse eid="JHN 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24" />Tegani o Ana bičhalda e phangle Isuse ko Kajafa, savo sasa baro svešteniko.<verse eid="JHN 18:24" /></para>
  <para style="s">O Petar dujto thaj trito drom odreknil pe taro Isus</para>
  <para style="r">(<ref loc="MAT 26:71-75">Mt 26,71–75</ref>; <ref loc="MRK 14:69-72">Mk 14,69–72</ref>; <ref loc="LUK 22:58-62">Lk 22,58–62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />O Simon Petar ačhilo gothe thaj tatilo. Avera pučlje le: “Naj li san i tu jekh tare lese sikade?”</para>
  <para style="m" vid="JHN 18:25">Vov xoxada thaj vaćarda: “Naj sem!”<verse eid="JHN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26" />Jekh sluga taro baro svešteniko savo sasa familija kolese kaso kan o Petar čhinda, vaćarda: “Ni li dikhljem tut lesa ano vrt?”<verse eid="JHN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 18:27" />A o Petar palem xoxada thaj sigate o bašno đilabija.<verse eid="JHN 18:27" /></para>
  <para style="s">E Isuse anen anglo Pilat</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mt 27,1–2</ref>, <ref loc="MAT 27:11-14">11–14</ref>; <ref loc="MRK 15:1-5">Mk 15,1–5</ref>; <ref loc="LUK 23:1-5">Lk 23,1–5</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />Tegani e Isuse inđarde tare Kajafaso ćher ani palata e rimskone upraviteljesi. Sasa rano sabalje. Al von ni đele ani palata e rimskone upraviteljesi te ma bi meljarena pe palo adeti, a te bi šajine te xan i pashalno večera.<verse eid="JHN 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 18:29" />O Pilat tegani iklilo angle lende thaj pučlja: “Za ke so optužin kale manuše?”<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />Phende e Pilatese: “Kana ne bi ćerola bilačhipe, ne bi anasa le tute.”<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />O Pilat vaćarda lenđe: “Len le tumen thaj sudin le pale tumaro zakon.”</para>
  <para style="m" vid="JHN 18:31">E Jevreja vaćarde lese: “Amen našti khanika te mudara!” <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />Kava sasa te bi pherdona e Isusese lafura, save vaćarda angleder, save merimasa ka merol.<verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />Tegani irisajlo o Pilat andre ani pi palata, akharda e Isuse andre thaj pučlja le: “Tu li san o caro e Jevrejengo?”<verse eid="JHN 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34" />O Isus vaćarda lese: “Vaćare li gova korkoro tutar, il avera gova vaćarde tuće mandar?”<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />O Pilat palem pučlja le: “Me li sem Jevrejo? Ćiro narodo thaj e šorutne sveštenikura dije tut mande. So ćerdan?”<verse eid="JHN 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36" />O Isus vaćarda: “Mingro Carstvo naj tare kava sveto. Kana bi mingro Carstvo avola tare kava sveto, tegani bi mingre sluge branina man te ma dolen man e Jevrejska šorutne. Al mingro Carstvo naj katar.”<verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />Pe gova vaćarda lese o Pilat: “Znači gija, tu san caro?”</para>
  <para style="m" vid="JHN 18:37">O Isus vaćarda lese: “Tu vaćare kaj me sem caro. Me golese bijandiljem thaj aviljem ko sveto te svedočiv taro čačipe. Dži jekh savo si taro čačipe šunol mingro glaso.”<verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />O Pilat pučlja le: “So si čačipe?”</para>
  <para style="s" vid="JHN 18:38">O Isus osudimo ko meripe</para>
  <para style="r" vid="JHN 18:38">(<ref loc="MAT 27:15-31">Mt 27,15–31</ref>; <ref loc="MRK 15:6-20">Mk 15,6–20</ref>; <ref loc="LUK 23:13-25">Lk 23,13–25</ref>)</para>
  <para style="m" vid="JHN 18:38">Kana vaćarda kava o Pilat, iklilo palem angle Jevrejska šorutne thaj vaćarda lenđe: “Me ni arakhav khanči sose bi optuživa le. <verse eid="JHN 18:38" /><verse number="39" style="v" sid="JHN 18:39" />Al tumende si adeti te mukhav tumenđe jekhe phangle ki Pasha. Manđen li te mukhav tumenđe e caro e Jevrejengo?”<verse eid="JHN 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40" />Al von pe gova dije vika: “Na le! Mukh e Varava!”</para>
  <para style="m" vid="JHN 18:40">Al o Varava sasa razbojniko.<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />Tegani o Pilat naredisada te šibin e Isuse. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />E vojnikura khuvde venco tare kangre thaj čhute e Isusese ko šoro thaj učharde le purpurno ogrtači. <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />Tegani lije te aven angle leste thaj vaćarde: “Te ave sasto, carona e Jevrejengo!” Thaj čalade le pe čhama.<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />Pale gova o Pilat palem iklilo thaj vaćarda kole manušenđe: “Akh, akana ka ikalav le avral ke tumende, te džanen kaj me pe leste ni arakhav khanči sose bi optuživa le.”<verse eid="JHN 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 19:5" />Tegani o Isus iklilo avri, urado ano purpurno ogrtači thaj pe leso šoro sasa venco tare kangre, a o Pilat vaćarda lenđe: “Akh, o manuš!”<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />Kana dikhlje le e šorutne sveštenikura thaj e stražara, lije te den vika: “Čhuv le ko krsto! Čhuv le ko krsto!”</para>
  <para style="m" vid="JHN 19:6">Al o Pilat vaćarda lenđe: “Len le tumen thaj čhuven le ko krsto, golese so me pe leste ni arakhav khanči sose bi optuživa le.”<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />E Jevrejska šorutne irisade lese: “Amen isi Zakon thaj palo gova Zakon trubul te merol, golese so vaćarda kaj si Čhavo e Devleso.”<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />Kana o Pilat šunda kava, darajlo vadži pobut. <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />Palem đelo ani palata thaj pučlja e Isuse: “Kotar san tu?”</para>
  <para style="m" vid="JHN 19:9">Al o Isus khanči ni phenda.<verse eid="JHN 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 19:10" />Tegani o Pilat pučlja le: “Dal khanči ni manđe te vaćare? Džane li kaj isi man vlast te mukhav tut il te čhuvav tu ko krsto?”<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />O Isus phenda lese: “Ne bi avola tut nisavo vlast pe mande te ni dol pe tuće odupral. Golese, po baro greh isi kole savo dija man tute.”<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />Od tegani o Pilat dikhlja pobut te mućhol e Isuse, al e Jevrejska šorutne dije vika: “Te mukhljan kale, naj san amal e rimskone carose! Dži jekh savo pes ćerol caro protivil pe e rimskone carose.”<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />Kana kava šunda o Pilat, ikalda e Isuse avral, bešlo ki sudsko stolica, ko than savo si taro bar thaj akhardol Litostrotos, jevrejski Gavata. <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />A sasa đive baše pripreme angli Pasha pašo dešuduj (12) o sato.</para>
  <para style="m" vid="JHN 19:14">O Pilat vaćarda e Jevrejenđe: “Akh, tumaro caro!”<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />Pe gova e Jevreja lije te den vika: “Inđaren le! Inđaren le! Čhuven le ko krsto!”</para>
  <para style="m" vid="JHN 19:15">O Pilat phenda lenđe: “So manđen, tumare caro te čhuvav ko krsto?”</para>
  <para style="m" vid="JHN 19:15">E šorutne sveštenikura vaćarde lese: “Amen naj caro sem o rimsko caro.”<verse eid="JHN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16" />Tegani dija o Pilat e Isuse ke vojnikura te čhuven le ko krsto. E vojnikura tegani lije e Isuse.<verse eid="JHN 19:16" /></para>
  <para style="s">E Isuse čhuven ko krsto</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mt 27,32–44</ref>; <ref loc="MRK 15:21-32">Mk 15,21–32</ref>; <ref loc="LUK 23:26-43">Lk 23,26–43</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17" />O Isus korkoro inđarda po krsto ko than savo akhardola Kokalo e šoreso, jevrejski Golgota. <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />Gothe čhute e Isuse ko krsto thaj lesa i averen dujen – jekhe tari jekh rig thaj avere tari dujto rig, a e Isuse maškaral.<verse eid="JHN 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 19:19" />O Pilat pisisada ki ploča thaj dija te čhuven gova ko krsto. Pi ploča sasa pisimo: “O Isus taro Nazaret, caro e Jevrejengo.” <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />But Jevreja čitisade o pisipe pi ploča, golese so o than kaj čhute e Isuse ko krsto sasa pašo foro. Gova sasa pisimo ki jevrejsko, ki latinsko thaj ki grčko čhib.<verse eid="JHN 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 19:21" />E jevrejska šorutne sveštenikura phende e Pilatese: “Ma pisi ‘caro e Jevrejengo’, nego ‘kava manuš phenda me sem caro e Jevrejengo.’”<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />Al o Pilat phenda: “So pisisadem, pisisadem.”<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />Kana e vojnikura čhute e Isuse ko krsto, lije lese šeja thaj ulade len maškar peste ke štar kotora, so štarenđe po jekh kotor. Lije i leso gad savo naj sasa suvdo, nego sasa khuvdo ane jekh kotor odupral natele. <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />Golese phende maškar peste: “Pošukar ma te pharava le! Ajde ka čhuda kocka baše kava gad. Ko pobedil, leso ka avol.” Kava sasa te bi pherdola kova so si pisimo ano Sveto lil:</para>
  <para style="q1" vid="JHN 19:24">“Mingre šeja ulade maškar peste,</para>
  <para style="q2" vid="JHN 19:24">thaj baše mingro gad čhudije kocka.”</para>
  <para style="m" vid="JHN 19:24">Thaj e vojnikura ćerde gija.<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />Pašo krsto e Isuseso ačhile lesi dej, i phen lese daći i Marija e Kleopesi romni thaj i Marija Magdalena.<verse eid="JHN 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 19:26" />Kana o Isus dikhlja pe da thaj paše late e sikade save but manglja, phenda pe daće: “Džuvlije, ake tuće čhavo.”<verse eid="JHN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27" />Pale gova phenda e sikadese: “Ake tuće dej!”</para>
  <para style="m" vid="JHN 19:27">Thaj tare gova sato o sikado lija la ane po ćher.<verse eid="JHN 19:27" /></para>
  <para style="s">E Isuseso meripe</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mt 27,45–56</ref>; <ref loc="MRK 15:33-41">Mk 15,33–41</ref>; <ref loc="LUK 23:44-49">Lk 23,44–49</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />Pale gova, o Isus džanglja kaj pherdilo sa so trubuja te avol pa vaćarda te bi pherdola o Sveto lil: “Trošalo sem!”<verse eid="JHN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 19:29" />Gothe sasa jekh čaro pherdo šut. Gija e vojnikura čhute ke izopeso kaš o sunđeri ćinđardo šutesa thaj čhute le paše leso muj.<verse eid="JHN 19:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 19:30" />Kana pilja o Isus o šut, vaćarda: “Sa si ćerdo!” Tegani perada po šoro thaj mukhlja po duxo.<verse eid="JHN 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />Golese so sasa đive baše pripreme, e Jevrejska šorutne molisade e Pilate te phađen e pingre kolenđe save sesa ko krsto thaj te bi uljarena len tare krstura te ma bi ačhola o telo ko krsto ko savato, golese so gova savato sasa Prazniko – Pasha. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />Tegani avile e vojnikura thaj phaglje e pingre anglune manušese thaj pale gova i e dujtone manušese, save sesa ko krsto pašo Isus. <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />Al kana avile dži ko Isus thaj dikhlje kaj mulo, ni phaglje lese pingre. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />Umesto gova, jekh tare vojnikura e kopljesa pusada lese pašavre. Gothar sigate thavdija rat thaj paj.<verse eid="JHN 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 19:35" />Kova so gova dikhlja, svedočil tare gova thaj leso svedočanstvo si čačukano. Vov džanol kaj vaćarol čačipe thaj svedočil te bi i tumen pačana. <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />Kava sasa te bi pherdola kova so si pisimo ano Sveto lil:</para>
  <para style="q1" vid="JHN 19:36">“Nijekh kokalo leso ni ka phađol.”<verse eid="JHN 19:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 19:37" />A ko aver than o Sveto lil phenol:</para>
  <para style="q1" vid="JHN 19:37">“Ka dićhen kole save pusade.”<verse eid="JHN 19:37" /></para>
  <para style="s">E Isuseso prahope</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mt 27,57–61</ref>; <ref loc="MRK 15:42-47">Mk 15,42–47</ref>; <ref loc="LUK 23:50-56">Lk 23,50–56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />Pale gova o Josif tari Arimateja rodija taro Pilat te uljarol taro krsto e Isuseso telo. O Josif sasa e Isuseso sikado, al na javno, golese so darajlo tare Jevrejska šorutne. O Pilat mukhlja le te lol e Isuseso telo. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />Lesa avilo i o Nikodim, savo angleder avilo ko Isus raćasa. Vov pesa anda paše tranda (30) kila mešime smirna thaj aloja. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />Lije e Isuseso telo thaj paćarde le čaršafesa savo makhle mirisesa, sar si o adeti ke Jevreja kana prahon. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />A paše gova than kaj sasa o Isus čhuto ko krsto, sasa jekh vrt thaj ane gova vrt sasa jekh nevo limori, ane savo khoni vadži naj sasa prahome. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />A sar sasa jevrejsko đive tare pripreme, trubuje te siđaren, a gova limori sasa paše, pa čhute e Isuseso telo ane gova than.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">O Isus uštol tare mule</para>
  <para style="r">(<ref loc="MAT 28:1-10">Mt 28,1–10</ref>; <ref loc="MRK 16:1-8">Mk 16,1–8</ref>; <ref loc="LUK 24:1-12">Lk 24,1–12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />Sabalin rano ko angluno đive ano kurko, kana vadži ni đivesajlo, avili ko limori i Marija taro gav i Magdala thaj dikhlja kaj si o bar crdimo taro ulaz e limoreso. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />Tegani prastija thaj avili ko Simon Petar thaj ke aver sikado kas o Isus but manglja thaj vaćarda lenđe: “Inđarde e Gospode andaro limori thaj ni džana kaj čhute le!”<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3" />Gija o Petar thaj kova aver sikado iklile thaj đele premalo limori. <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />Solduj džene prastije katane thaj o dujto sikado prastija posigate taro Petar thaj avilo ko limori angleder. <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />Banđilo thaj dikhlja andre e čaršafura taro lan kaj pašljon odori, al ni đelo andre. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />Tegani avilo pale leste i o Simon Petar thaj đelo andre ano limori thaj dikhlja e čaršafura kaj pašljon odori, <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />thaj o kotor savo učharda e Isuseso šoro. Al gova kotor ni pašljola e čaršafurencar, al sasa čhuto ki rig paćardo. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />Tegani andre avilo i o dujto sikado, kova so reslo ko limori angleder thaj dikhlja thaj pačaja. <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />Golese so vadži ni haljarde e Sveta lila kaj o Isus trubul te uštol tare mule. <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />Pale gova e sikade irisajle ke avera sikade.<verse eid="JHN 20:10" /></para>
  <para style="s">O Isus ikljol angli Marija Magdalena</para>
  <para style="r">(<ref loc="MRK 16:9-11">Mk 16,9–11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />A i Marija ačhola avral pašo limori thaj ruja. Thaj sar ruja, čhudija pe jakha andre ano limori <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />thaj dikhlja duje anđeluren urade ane parne fostanura sar bešen po than kaj angleder sasa o telo e Isuseso – jekh kaj trubuja te avol leso šoro, dujto kaj sesa lese pingre.<verse eid="JHN 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 20:13" />E anđelura pučlje la:</para>
  <para style="p" vid="JHN 20:13">“Džuvlije, sose rove?”</para>
  <para style="m" vid="JHN 20:13">Voj phenda lenđe: “Lije mingre Gospode thaj ni džanav kaj čhute le.” <verse eid="JHN 20:13" /><verse number="14" style="v" sid="JHN 20:14" />Kana gova vaćarda, irisajli thaj dikhlja e Isuse sar gothe ačhol, al ni pindžarda kaj si gova o Isus.<verse eid="JHN 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 20:15" />Pučlja la o Isus: “Džuvlije, sose rove? Kas rode?”</para>
  <para style="m" vid="JHN 20:15">I Marija dija gođi kaj si gova o manuš savo ćerol bući ano vrt, golese vaćarda lese: “Manušeja, te inđardan le tu, phen manđe kaj čhutan le thaj me ka lav le.”<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />O Isus phenda laće: “Marijo!”</para>
  <para style="m" vid="JHN 20:16">Voj irisajli thaj jevrejski vaćarda lese: “Rabbuni!” (So značil “Učitelju”.)<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />Vaćarda laće o Isus: “Ma but zadrži man, golese so vadži ni đeljem ke mingro Dad. Nego dža ke mingre phrala thaj vaćar lenđe: ‘Džav upre ke mingro Dad thaj ke tumaro Dad, ke mingro Dol thaj ke tumaro Dol.’”<verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />I Marija Magdalena đeli ke sikade thaj phenda lenđe: “Dikhljem e Gospode.”</para>
  <para style="m" vid="JHN 20:18">Thaj vaćarda lenđe sa so o Isus phenda laće.<verse eid="JHN 20:18" /></para>
  <para style="s">O Isus sikadol e sikadenđe</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mt 28,16–20</ref>; <ref loc="MRK 16:14-18">Mk 16,14–18</ref>; <ref loc="LUK 24:36-49">Lk 24,36–49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />Ki rat ko angluno đive taro kurko, kana e sikade sesa katane thaj o vudar sasa phanglo golese so e sikade darana tare Jevrejska šorutne, tari jekh drom avilo o Isus thaj ačhilo maškar lende thaj vaćarda lenđe: “Mir tumenđe!”<verse eid="JHN 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 20:20" />Kana kava vaćarda, sikada lenđe e ožiljkura ke vasta thaj ke pašavre. Tegani e sikade sesa radosna so dikhlje e Gospode.<verse eid="JHN 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 20:21" />A palem o Isus phenda lenđe: “Mir tumenđe! Sar so o Dad bičhalda man, gija i me bičhalav tumen.”<verse eid="JHN 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 20:22" />Thaj sar kava vaćarda, phurdija ane lende thaj vaćarda lenđe: “Primin o Sveto Duxo! <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />Kase tumen ka oprostin e grehura, lenđe si oprostime, a kase tumen ni ka oprostin e grehura, lenđe naj oprostime e grehura.”<verse eid="JHN 20:23" /></para>
  <para style="s">O Isus sikadol anglo Toma</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />O Tomo kas akharde Bliznako, jekh tare Dešuduj (12) sikade, ni sasa lencar kana avilo o Isus.<verse eid="JHN 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 20:25" />Avera sikade vaćarde lese: “Dikhljam e Gospode!”</para>
  <para style="m" vid="JHN 20:25">Al vov phenda lenđe: “Ni ka pačav dži kaj ni dikhav e ožiljkura tare eksera ke lese vasta thaj dži kaj čhuvav me naja ane lende, thaj dži kaj ni čhuvav mingre naja pe lese ožiljkura ke pašavre.”<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />Pale ohto đive, palem sesa e sikade katane andre ano ćher thaj sasa lencar i o Tomo. Iako o vudar sasa phanglo, avilo o Isus andre thaj ačhilo maškar lende thaj vaćarda: “Mir tumenđe!”<verse eid="JHN 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 20:27" />Pale gova phenda e Tomose: “Čhuv ćiro naj kate thaj dikh mingre vasta. Ispruži ćiro va thaj čhuv ane mingre pašavre. Ma vadži te sumnji, nego pača.”<verse eid="JHN 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28" />O Tomo phenda lese: “Mingro Gospod thaj mingro Dol!”<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />O Isus vaćarda lese: “Golese so dikljan man, pačajan. Blagoslovime si kola save ni dićhen, a pačan.”<verse eid="JHN 20:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />Thaj but avera čudesna znakura ćerda o Isus angle pe sikade save naj pisime ane kava lil. <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />Al kava si pisime te bi pačana kaj o Isus si o Hrist, o Čhavo e Devleso thaj pačajindoj te šaj avol tumen džuvdipe ane leso alav.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">O Isus ikljol angle efta sikade</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />Pale gova palem sikadilo o Isus pe sikadenđe ko Tiverijadsko more. A sikadilo gija: <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />Sesa katane o Simon Petar, o Tomo kas akharde Bliznako, o Natanailo tari Kana i Galilejsko, e čhave e Zevedejese thaj avera duj džene tare lese sikade.<verse eid="JHN 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 21:3" />O Simon Petar phenda lenđe: “Džav te dolav mačhen.”</para>
  <para style="m" vid="JHN 21:3">Von vaćarde lese: “Ka dža i amen tusa.” Tegani iklile thaj bešle ano čamco, al ane goja rat khanči ni dolde.<verse eid="JHN 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 21:4" />Kana sasa rano sabalje, ačhilo o Isus ki obala, al e sikade ni pindžarde kaj si gova o Isus.<verse eid="JHN 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 21:5" />Tegani o Isus pučlja len: “Amalalen, isi li tumen mačhe xamase?”</para>
  <para style="m" vid="JHN 21:5">Phende lese: “Naj amen.”<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />A vov vaćarda lenđe: “Čhuden i mreža ki desno rig taro čamco thaj ka dolen mačhe.” Gija i ćerde. Al naštine te ikalen i mreža tare but mačhe save dolde.<verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />Tegani o sikado, save o Isus but manglja, phenda e Petrese: “Kava si o Gospod!”</para>
  <para style="m" vid="JHN 21:7">Kana o Simon Petar šunda kaj gova si o Gospod, phanglja pe zurale e fostanesa, golese so ni sasa but urado thaj hutija ano more. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />I avera sikade avile e čamcosa, golese so ni sesa dur tari obala, paše šel (100) metra thaj crdije i mreža pale peste e mačhencar. <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />Kana iklile ki phuv, dikhlje phabardi jag taro angar thaj pe late pećona e mačhe thaj o mangro.<verse eid="JHN 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 21:10" />O Isus vaćarda lenđe: “Anen zala tare gola mačhen saven dolden.” <verse eid="JHN 21:10" /><verse number="11" style="v" sid="JHN 21:11" />Tegani o Simon Petar đelo ano čamco thaj ikalda ki obala i mreža pherdi bare mačhencar thaj ane late sesa šelupinda thaj trin (153) mačhe. Thaj iako sesa gaći mačhe, i mreža ni pharadili.<verse eid="JHN 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 21:12" />O Isus phenda lenđe: “Aven te xan.”</para>
  <para style="m" vid="JHN 21:12">Al nijekh sikado ni tromaja te pučol le: “Ko san tu?” Golese so džanglje kaj si gova o Gospod.<verse eid="JHN 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 21:13" />Tegani avilo o Isus, lija o mangro thaj dija len, a gija ćerda i e mačhencar. <verse eid="JHN 21:13" /><verse number="14" style="v" sid="JHN 21:14" />Kava sasa trito drom kana o Isus sikadilo pe sikadenđe sar uštilo tare mule.<verse eid="JHN 21:14" /></para>
  <para style="s">O Isus vaćarol e Petresa</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />Kana xalje, pučlja o Isus e Simone Petre: “Simone, čhaveja e Jovaneso, manđe li man pobut tare kala aver manuša?”</para>
  <para style="m" vid="JHN 21:15">O Petar vaćarda lese: “Va, Gospode, tu džane kaj mangav tut.”</para>
  <para style="m" vid="JHN 21:15">O Isus phenda lese: “Čarav mingre bakroren.”<verse eid="JHN 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 21:16" />Tegani pučlja le o Isus dujto drom: “Simone, čhaveja e Jovaneso, manđe li man?”</para>
  <para style="m" vid="JHN 21:16">Phenda lese o Petar: “Va Gospode. Tu džane kaj mangav tut.”</para>
  <para style="m" vid="JHN 21:16">O Isus vaćarda lese: “Arakh mingre bakren.”<verse eid="JHN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 21:17" />Tegani pučlja le o Isus trito drom: “Simone, čhaveja e Jovaneso, manđe li man?”</para>
  <para style="p" vid="JHN 21:17">O Petar sasa žalno so pučol le o Isus trito drom: “Manđe li man?” Golese vaćarda lese: “Gospode, tu džane sa. Tu džane kaj me mangav tut.”</para>
  <para style="m" vid="JHN 21:17">O Isus phenda lese: “Čarav mingre bakren. <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />Čače, čače vaćarav tuće: kana sana terno, korkoro phangljan ći kuštik thaj phirdan kaj mangljan. Al kana ka phuravo, ka ispruži ćire vasta thaj avera ka phanden tut thaj ka inđaren tut kaj ni manđe.”<verse eid="JHN 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 21:19" />Kava vaćarda lese te sikavol lese save merimasa o Petar ka proslavil e Devle. Kana vaćarda kava, phenda lese: “Av pale mande!”<verse eid="JHN 21:19" /></para>
  <para style="s">O sikado kas o Isus manglja</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />O Petar irisajlo thaj dikhlja kaj džal pale leste kova kas o Isus but manglja thaj savo ki večera nakhlo po paše pašo Isus thaj pučlja le: “Gospode, ko ka izdajil tut?”<verse eid="JHN 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 21:21" />Kana dikhlja le o Petar, pučlja e Isuse: “Gospode, so ka avol kale manušesa?”<verse eid="JHN 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22" />O Isus phenda lese: “Te mangljem vov te ačhol sa dok me ni avav, so isi tut golesa? Tu av pale mande!”<verse eid="JHN 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23" />Golese iklilo lafi maškare phrala kaj kava sikado ni ka merol. Al o Isus ni vaćarda kaj kava sikado ni ka merol, nego vaćarda: “Te mangljem vov te ačhol sa dok me ni avav, so isi tut golesa?”<verse eid="JHN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />Kava si gova sikado savo svedočil tare sa thaj sa kava pisisada. Amen džana kaj si čačukano leso svedočipe.<verse eid="JHN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />Al isi vadži but so ćerda o Isus thaj kana bi sa redasa pisila pe, misliv kaj bi celo sveto avola cikno paše lila ane save bi avola pisimo sa gova!<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>