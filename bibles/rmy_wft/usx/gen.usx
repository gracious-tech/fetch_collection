<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GEN" style="id" />
  <para style="h">1. Mojsije</para>
  <para style="toc1">Angluno lil e Mojsijaso</para>
  <para style="toc2">1. Mojsije</para>
  <para style="toc3">1. Mojs</para>
  <para style="mt">Angluno lil e Mojsijaso</para>
  <para style="mt2">savo akhardol Ćeripe</para>
  <chapter number="1" style="c" sid="GEN 1" />
  <para style="s">Ćeripe e neboso thaj e phuvako</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 1:1" />Ko anglunipe ćerda o Dol o nebo thaj i phuv. <verse eid="GEN 1:1" /><verse number="2" style="v" sid="GEN 1:2" />I phuv sasa bizo oblik thaj čuči. Učharenasa la duboka paja prekale save sasa o kalipe, a e Devleso Duxo lebdila prekale paja.<verse eid="GEN 1:2" /></para>
  <para style="s">Angluno đive</para>
  <para style="s2">O svetlost</para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 1:3" />Tegani vaćarda o Dol: “Nek avol svetlost!”</para>
  <para style="p" vid="GEN 1:3">Thaj sasa svetlost. <verse eid="GEN 1:3" /><verse number="4" style="v" sid="GEN 1:4" />Dikhlja o Dol kaj si o svetlost šukar thaj ulada o svetlost taro kalipe. <verse eid="GEN 1:4" /><verse number="5" style="v" sid="GEN 1:5" />O Dol akharda o svetlost “đive”, a o kalipe akharda “rat”.</para>
  <para style="p" vid="GEN 1:5">Thaj sasa rat, pa sabalin, o angluno đive.<verse eid="GEN 1:5" /></para>
  <para style="s">Dujto đive</para>
  <para style="s2">O nebo</para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 1:6" />Tegani vaćarda o Dol: “Nek avol svod maškare paja, te ulavol e paja save si upre, tare paja save si tele!”<verse eid="GEN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 1:7" />O Dol ćerda o svod thaj ulada e paja talo svod tare paja upreder o svod. Thaj gija sasa. <verse eid="GEN 1:7" /><verse number="8" style="v" sid="GEN 1:8" />A o Dol akharda o svod “nebo”.</para>
  <para style="p" vid="GEN 1:8">Thaj sasa rat, pa sabalin, dujto đive.<verse eid="GEN 1:8" /></para>
  <para style="s">Trito đive</para>
  <para style="s2">O kopno thaj e biljke</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 1:9" />Tegani vaćarda o Dol: “Nek e paja talo nebo ćiden pe ki jekh than thaj nek sikadol o kopno!”</para>
  <para style="p" vid="GEN 1:9">Thaj gija sasa. <verse eid="GEN 1:9" /><verse number="10" style="v" sid="GEN 1:10" />O Dol akharda o kopno “phuv”, a e ćidime paja “more”. Thaj dikhlja o Dol kaj si gova šukar.<verse eid="GEN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 1:11" />Tegani vaćarda o Dol: “Nek andari phuv ikljon biljke save den semenura thaj e kašta save bijanen bijandipe e semesa premale sa pire vrste.”</para>
  <para style="p" vid="GEN 1:11">Thaj gija sasa. <verse eid="GEN 1:11" /><verse number="12" style="v" sid="GEN 1:12" />Andari phuv iklile e biljke save den semenura premale pire vrste thaj e kašta save bijanen bijandipe e semesa, premale pire vrste. Thaj dikhlja o Dol kaj si gova šukar.<verse eid="GEN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 1:13" />Gija sasa rat, pa sabalin, trito đive.<verse eid="GEN 1:13" /></para>
  <para style="s">Štarto đive</para>
  <para style="s2">O kham, o čhon thaj e čerenja</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 1:14" />Tegani vaćarda o Dol: “Nek aven svetiljke ko nebesko svod, te ulaven o đive tari rat thaj te aven znakura save sikaven e vremenska doba, e đivesa thaj e berša! <verse eid="GEN 1:14" /><verse number="15" style="v" sid="GEN 1:15" />Nek e svetiljke ko nebesko svod den svetlo ki phuv.”</para>
  <para style="p" vid="GEN 1:15">Thaj gija sasa. <verse eid="GEN 1:15" /><verse number="16" style="v" sid="GEN 1:16" />O Dol ćerda duj bare svetlura: o pobaro svetlo te vladil đivesesa thaj o pocikno te vladil e raćasa. Thaj ćerda i e čerenja. <verse eid="GEN 1:16" /><verse number="17" style="v" sid="GEN 1:17" />Thaj o Dol čhuta len ko nebesko svod te osvetlin i phuv, <verse eid="GEN 1:17" /><verse number="18" style="v" sid="GEN 1:18" />te vladin e đivesesa thaj e raćasa thaj te ulaven o svetlo taro kalipe. Thaj dikhlja o Dol kaj si gova šukar.<verse eid="GEN 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 1:19" />Thaj sasa rat, pa sabalin, štarto đive.<verse eid="GEN 1:19" /></para>
  <para style="s">Pandžto đive</para>
  <para style="s2">E mačhe thaj e čiriklja</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 1:20" />Tegani vaćarda o Dol: “E paja nek aven pherde e džuvde bićurencar thaj e čiriklja nek letin upreder i phuv, talo nebesko svod.”<verse eid="GEN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 1:21" />Thaj ćerda o Dol bare morska životinje, sa e džuvde bićura save plivin ano paj thaj savencar si pherde e paja, pale lenđe vrste thaj sa e phakale čiriklja pale lenđe vrste. Thaj o Dol dikhlja kaj si gova šukar.<verse eid="GEN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 1:22" />O Dol blagoslovisada len thaj phenda: “Anen bijandipe thaj množin tumen thaj pheren e paja e morese. Thaj e čiriklja nek množin pe ki phuv!” <verse eid="GEN 1:22" /><verse number="23" style="v" sid="GEN 1:23" />Thaj sasa rat, pa sabalin, pandžto đive.<verse eid="GEN 1:23" /></para>
  <para style="s">Šovto đive</para>
  <para style="s2">E životinje ki phuv thaj o manuš</para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 1:24" />Tegani o Dol vaćarda: “I phuv nek mućhol andar peste džuvde bićura pale lenđe vrste: e stoka, e stvorenjura save lazin ki phuv thaj divlja životinje pale lenđe vrste!”</para>
  <para style="p" vid="GEN 1:24">Thaj gija sasa. <verse eid="GEN 1:24" /><verse number="25" style="v" sid="GEN 1:25" />Thaj o Dol ćerda e divlja životinjen pale lenđe vrste, e stoka pale lenđe vrste thaj e stvorenjura save lazin ki phuv, pale lenđe vrste. Thaj dikhlja o Dol kaj si gova šukar.<verse eid="GEN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 1:26" />Tegani o Dol vaćarda: “Te ćera manuše ki amari slika, te avol sar so sam amen. Te avol e manušen vlast pe mačhe ano more thaj pe čiriklja ko nebo, pi stoka, pi sa i phuv thaj pe sa e stvorenjura save lazin ki phuv!”<verse eid="GEN 1:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="GEN 1:27" />Thaj o Dol ćerda e manuše</para>
  <para style="q2" vid="GEN 1:27">ki piri slika.</para>
  <para style="q1" vid="GEN 1:27">Ke Devlesi slika</para>
  <para style="q2" vid="GEN 1:27">ćerda le.</para>
  <para style="q1" vid="GEN 1:27">E murše thaj e džuvlja</para>
  <para style="q2" vid="GEN 1:27">ćerda len.<verse eid="GEN 1:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="GEN 1:28" />Blagoslovisada len o Dol thaj phenda lenđe: “Anen bijandipe thaj množin tumen, pheren i phuv thaj aven vladara pe late. Vladin e mačhencar ano more thaj e čirikljencar ko nebo thaj sa e džuvde stvorenjurencar save lazin ki phuv.”<verse eid="GEN 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 1:29" />Tegani o Dol vaćarda: “Akh, dav tumen pi sa i phuv dži jekh biljka savi dol seme thaj dži jekh kaš savo bijanol bijandipe, ano savo isi seme. Gova ka avol tumenđe xamase. <verse eid="GEN 1:29" /><verse number="30" style="v" sid="GEN 1:30" />A sa e divljone životinjenđe pi phuv, sa e čirikljenđe po nebo thaj sa e stvorenjurenđe save lazin ki phuv – sa so ane peste isi le daxo e džuvdimaso – dav sa e zelena biljke xamase.”</para>
  <para style="p" vid="GEN 1:30">Thaj gija sasa.<verse eid="GEN 1:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 1:31" />Tegani dikhlja o Dol sa so ćerda thaj dikhlja kaj si gova but šukar.</para>
  <para style="p" vid="GEN 1:31">Thaj sasa rat, pa sabalin, šovto đive.<verse eid="GEN 1:31" /></para>
  <chapter eid="GEN 1" />
  <chapter number="2" style="c" sid="GEN 2" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 2:1" />Gija sasa završimo o nebo thaj i phuv thaj sa pe lende.<verse eid="GEN 2:1" /></para>
  <para style="s">Eftato đive</para>
  <para style="s2">Odmor</para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 2:2" />Dži o eftato đive o Dol završisada pi bući thaj eftato đive odmorisajlo tare sa e buća. <verse eid="GEN 2:2" /><verse number="3" style="v" sid="GEN 2:3" />O Dol blagoslovisada o eftato đive thaj ćerda le te avol sveto, golese kaj odmorisajlo eftato đive tare sa e buća save ćerda.<verse eid="GEN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 2:4" />Gija sasa ćerde o nebo thaj i phuv.</para>
  <para style="s" vid="GEN 2:4">Edensko vrt</para>
  <para style="p" vid="GEN 2:4">Sar o GOSPOD, o Dol, ćerda i phuv thaj o nebo, <verse eid="GEN 2:4" /><verse number="5" style="v" sid="GEN 2:5" />vadži ni barile nisave divlje ni poljska biljke, golese so o GOSPOD, o Dol, vadži ni mukhlja o bršnd ki phuv thaj ni sasa ni manuš te obradil i phuv. <verse eid="GEN 2:5" /><verse number="6" style="v" sid="GEN 2:6" />Al o paj ikljola andari phuv thaj ćinđarola o muj e phuvako.<verse eid="GEN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 2:7" />Tegani oblikujisada o GOSPOD, o Dol, e manuše taro praho e phuvako thaj phurdija lese ano nak duxo e džuvdimaso thaj gija postanisada o manuš džuvdo biće. <verse eid="GEN 2:7" /><verse number="8" style="v" sid="GEN 2:8" />Pale gova o GOSPOD, o Dol, sadisada vrt ano Eden ko istok thaj čhuta gothe e manuše save oblikujisada. <verse eid="GEN 2:8" /><verse number="9" style="v" sid="GEN 2:9" />Thaj ćerda o GOSPOD, o Dol, andari phuv te baron sa e vrste kašta šukar dićhimase thaj šukar xamase. Ko maškar ano vrt sasa o kaš e džuvdimaso thaj o kaš e džanglimaso taro šukaripe thaj taro bilačhipe.<verse eid="GEN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 2:10" />Andaro Eden ikljola len savi ćinđarola o vrt, a gothar ulavola pe ane štar bare leja. <verse eid="GEN 2:10" /><verse number="11" style="v" sid="GEN 2:11" />I angluni len dija pe vika Pišon, voj thavdola trujal sa i phuv i Havilsko, ane savi isi zlato. <verse eid="GEN 2:11" /><verse number="12" style="v" sid="GEN 2:12" />O zlato gole phuvako si but šukar, a gothe si i mirisno smola thaj kučale bara oniks. <verse eid="GEN 2:12" /><verse number="13" style="v" sid="GEN 2:13" />I dujto len dija pe vika Gihon, voj thavdol trujal sa i phuv i Kuš. <verse eid="GEN 2:13" /><verse number="14" style="v" sid="GEN 2:14" />I trito len dija pe vika Tigar, a voj thavdol istočno tari Asirija. I štarto len si o Eufrat.<verse eid="GEN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 2:15" />O GOSPOD, o Dol, lija e manuše thaj čhuta le ano edensko vrt te ćerol bući gothe thaj te araćhol le.<verse eid="GEN 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 2:16" />O GOSPOD, o Dol, zapovedisada e manušese: “Šaj te xa slobodno tare sa e kašta ano vrt, <verse eid="GEN 2:16" /><verse number="17" style="v" sid="GEN 2:17" />al taro kaš e džanglimaso taro šukaripe thaj taro bilačhipe, lestar ma xa! Golese so, ane gova đive kana ka xa tare gova kaš, čače ka mere.”<verse eid="GEN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 2:18" />Tegani vaćarda o GOSPOD, o Dol: “Naj šukar o manuš te avol korkoro. Ka ćerav lese khanika, ko ka avol lese šukar pomoćniko.”<verse eid="GEN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 2:19" />Tegani o GOSPOD, o Dol, tari phuv oblikujisada sa e divljone životinjen thaj e čirikljen ko nebo thaj anda len anglo manuš te dićhol sar ka dol len alava. Thaj sar bi o manuš dola alav dži jekhe džuvdone bićese, gija bi avola leso alav. <verse eid="GEN 2:19" /><verse number="20" style="v" sid="GEN 2:20" />Gija o manuš dija alav sa e stokaće, e čirikljenđe thaj e divljone životinjenđe.</para>
  <para style="p" vid="GEN 2:20">Al e manušese ni arakhadilo khoni ko bi avola lese šukar pomoćniko. <verse eid="GEN 2:20" /><verse number="21" style="v" sid="GEN 2:21" />Golese o GOSPOD, o Dol, mukhlja po manuš zuralo sojipe. Thaj dži kaj sovola, lija lestar jekh pašavro thaj gova than phanglja masesa. <verse eid="GEN 2:21" /><verse number="22" style="v" sid="GEN 2:22" />O GOSPOD, o Dol, taro pašavro savo lija taro manuš, ćerda džuvlja thaj anda la anglo manuš.<verse eid="GEN 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 2:23" />Tegani o manuš phenda:</para>
  <para style="b" vid="GEN 2:23" />
  <para style="q1" vid="GEN 2:23">“Akh, kava si kokalo tare mingre kokala</para>
  <para style="q2" vid="GEN 2:23">thaj telo tare mingro telo!</para>
  <para style="q1" vid="GEN 2:23">Nek akhardol džuvli,</para>
  <para style="q2" vid="GEN 2:23">golese kaj lija pe taro manuš.”<verse eid="GEN 2:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="GEN 2:24" />Golese o manuš ka ačhavol pe dade thaj pe da thaj ka avol katane pe romnjasa thaj duj ka aven jekh telo.<verse eid="GEN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 2:25" />A solduj sesa nanđe, o manuš thaj lesi romni thaj ni ladžajle.<verse eid="GEN 2:25" /></para>
  <chapter eid="GEN 2" />
  <chapter number="3" style="c" sid="GEN 3" />
  <para style="s">O Adam thaj i Eva ni šunde e Devleso zapovest</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1" />O sap sasa emlukavo maškare sa e divlja životinje save ćerda o GOSPOD, o Dol. O sap pučlja e džuvlja: “Čače li o Dol vaćarda kaj ni troman te xan taro nijekh kaš ano vrt?”<verse eid="GEN 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 3:2" />I džuvli phenda e sapese: “Amen troma te xa o bijandipe tare sa e kašta ano vrt, <verse eid="GEN 3:2" /><verse number="3" style="v" sid="GEN 3:3" />al pašo bijandipe e kašteso savo si ano vrt ko maškar, vaćarda o Dol: ‘Ma xan lestar ni ma dolen tumen lestar, te na meren!’”<verse eid="GEN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 3:4" />Tegani o sap phenda e džuvljaće: “Na, tumen ni ka meren. <verse eid="GEN 3:4" /><verse number="5" style="v" sid="GEN 3:5" />Nego, džanol o Dol kaj ano đive kana ka xan tare gova kaš ka putavon tumare jakha thaj ka aven sar o Dol – ka džanen so si o šukaripe, a so si o bilačhipe.”<verse eid="GEN 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 3:6" />Kana i džuvli dikhlja kaj si o bijandipe taro kaš šukar xamase, primamljivo jakhenđe thaj poželjno te dobil pe gođaveripe, ćidija o bijandipe taro kaš thaj xalja. Pale gova dija i pe rome, savo sasa lasa, pa i vov xalja. <verse eid="GEN 3:6" /><verse number="7" style="v" sid="GEN 3:7" />Tegani soldujenđe putajle lenđe jakha thaj dodžanglje kaj si nanđe. Golese khuvde e smokvaće patrna thaj lendar ćerde pese učharipe.<verse eid="GEN 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 3:8" />Tegani, angli rat kana po zala phurdola i balval, o manuš thaj lesi romni šunde sar o GOSPOD, o Dol phirol ano vrt thaj garadile lestar maškare kašta.<verse eid="GEN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 3:9" />O GOSPOD, o Dol, akharda e manuše thaj pučlja: “Kaj san?”<verse eid="GEN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 3:10" />O manuš phenda: “Šundem sar phire ano vrt thaj daraljem, golese kaj sem nango, pa garadiljem.”<verse eid="GEN 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 3:11" />Tegani o Dol pučlja le: “Ko vaćarda tuće kaj san nango? Dal xaljan tare kova kaš paše savo zapovedisadem tuće te ma xa lestar?”<verse eid="GEN 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 3:12" />O manuš phenda: “I džuvli sava tu čhutan te avol mancar, dija man o bijandipe taro kaš thaj me xaljem.”<verse eid="GEN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 3:13" />Tegani o GOSPOD, o Dol, pučlja e džuvlja: “So ćerdan gova?”</para>
  <para style="p" vid="GEN 3:13">A i džuvli phenda: “O sap xoxada man thaj golese xaljem.”<verse eid="GEN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14" />Tegani o GOSPOD, o Dol, phenda e sapese:</para>
  <para style="b" vid="GEN 3:14" />
  <para style="q1" vid="GEN 3:14">“Golese so gova ćerdan,</para>
  <para style="q2" vid="GEN 3:14">harami te ave maškari sa i stoka</para>
  <para style="q2" vid="GEN 3:14">thaj maškare sa e divlja životinje!</para>
  <para style="q1" vid="GEN 3:14">Ko vođi ka vuci tut,</para>
  <para style="q2" vid="GEN 3:14">thaj praho ka xa ane sa e đivesa ćire džuvdimaso.<verse eid="GEN 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 3:15" />A me ka čhuvav dušmanluko</para>
  <para style="q2" vid="GEN 3:15">maškar tute thaj maškar i džuvli</para>
  <para style="q2" vid="GEN 3:15">thaj maškar ćiro pleme thaj lako pleme.</para>
  <para style="q1" vid="GEN 3:15">Lako pleme ka gazil ćo šoro,</para>
  <para style="q2" vid="GEN 3:15">a tu ka xa le za ki patum.”<verse eid="GEN 3:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="GEN 3:16" />A e džuvljaće phenda:</para>
  <para style="b" vid="GEN 3:16" />
  <para style="q1" vid="GEN 3:16">“Kana ka ave khamni, ka baravav ćo pharipe</para>
  <para style="q2" vid="GEN 3:16">thaj ane dukha ka bijane e čhavoren.</para>
  <para style="q1" vid="GEN 3:16">Ka žudi pale ćo rom,</para>
  <para style="q2" vid="GEN 3:16">al vov ka vladil tusa.”<verse eid="GEN 3:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="GEN 3:17" />Pale gova phenda e manušese:</para>
  <para style="b" vid="GEN 3:17" />
  <para style="q1" vid="GEN 3:17">“Golese so šundan će romnja,</para>
  <para style="q2" vid="GEN 3:17">thaj xaljan taro kaš</para>
  <para style="q1" vid="GEN 3:17">baše savo zapovedisadem tuće:</para>
  <para style="q2" vid="GEN 3:17">‘Ma te xa lestar!’,</para>
  <para style="q1" vid="GEN 3:17">i phuv te avol harami zbog tute.</para>
  <para style="q2" vid="GEN 3:17">Mukasa ka xa latar</para>
  <para style="q2" vid="GEN 3:17">ane sa e đivesa ćire džuvdimaso.<verse eid="GEN 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="GEN 3:18" />Kangre thaj korov ka bijanol tuće,</para>
  <para style="q2" vid="GEN 3:18">a tu ka xa e poljska biljke.<verse eid="GEN 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="GEN 3:19" />Ano znoj ćire mujeso ka xa mangro,</para>
  <para style="q2" vid="GEN 3:19">sa dok ni iri tut ani phuv,</para>
  <para style="q1" vid="GEN 3:19">golese so san ćerdo tari phuv,</para>
  <para style="q2" vid="GEN 3:19">praho san, ano praho ka iri tut.”<verse eid="GEN 3:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="GEN 3:20" />O manuš dija pe romnja alav Eva, golese kaj si dej sa e manušenđe.<verse eid="GEN 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 3:21" />O GOSPOD, o Dol, ćerda e manušese thaj lese romnjaće šeja tari morčhi thaj urada len.<verse eid="GEN 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 3:22" />Pale gova vaćarda o GOSPOD, o Dol: “Akh, o manuš ćerdilo jekh sar amen – džanol so si o šukaripe thaj so si o bilačhipe. Al akana, ni troma te mukha e manuše te pružil po va thaj te ćidol taro kaš e džuvdimaso, te ma bi xala thaj gija te avol džuvdo ane sa e đivesa!”<verse eid="GEN 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 3:23" />Golese o GOSPOD, o Dol, tradija le andaro edensko vrt, te ćerol bući ki phuv tare savi sasa ćerdo. <verse eid="GEN 3:23" /><verse number="24" style="v" sid="GEN 3:24" />Kana tradija e manuše, čhuta ki istočno rig taro edensko vrt e heruvimen thaj jagalo mačo, savo vrtila pe ke sa e riga, te bi araćhena o drom premalo kaš e džuvdimaso.<verse eid="GEN 3:24" /></para>
  <chapter eid="GEN 3" />
  <chapter number="4" style="c" sid="GEN 4" />
  <para style="s">O Kain thaj o Avelj</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1" />O Adam pašlilo pe romnjasa e Evasa thaj voj ačhili khamni thaj bijanda e Kajine. Golese i Eva vaćarda: “Ano pomoć e GOSPODESO dobisadem murše čhave.”<verse eid="GEN 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 4:2" />Pale gova bijanda lese phrale e Avelje. Thaj o Avelj ćerdilo pastiri, a Kajin ratari.<verse eid="GEN 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 4:3" />Pale nesavo vreme o Kajin anda e GOSPODESE žrtva taro bijandipe e phuvako. <verse eid="GEN 4:3" /><verse number="4" style="v" sid="GEN 4:4" />A o Avelj anda sar žrtva e emšukar kotora tare anglune životinje save bijandile ano stado. A o GOSPOD prihvatisada e Aveljesi žrtva, <verse eid="GEN 4:4" /><verse number="5" style="v" sid="GEN 4:5" />al e Kajinesi žrtva ni prihvatisada. Golese o Kajin but holajlo thaj mukhlja po muj.<verse eid="GEN 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 4:6" />O GOSPOD phenda e Kajinese: “Sose holaljan thaj sose mukhljan ćo muj? <verse eid="GEN 4:6" /><verse number="7" style="v" sid="GEN 4:7" />Te ćerdan šukar, ka prihvativ tut. A te ni ćerdan šukar, o greh si anglo ćiro vudar, vov dićhol te dolol tut, al tu moraš te pobedi le.”<verse eid="GEN 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 4:8" />Pale gova o Kajin vaćarda pe phralese e Aveljese: “Ajde ka dža ko polje!” Al kana sesa ano polje, hutija o Kajin pe po phral o Avelj thaj mudarda le.<verse eid="GEN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 4:9" />Pale gova o GOSPOD pučlja e Kajine: “Kaj ćo phral o Avelj?”</para>
  <para style="p" vid="GEN 4:9">O Kajin phenda: “Ni džanav. Me li sem čuvari me phraleso?”<verse eid="GEN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 4:10" />O GOSPOD phenda: “So ćerdan? Akh, o rat ćire phraleso dol vika andari phuv premal mande. <verse eid="GEN 4:10" /><verse number="11" style="v" sid="GEN 4:11" />Golese, akana te ave harami thaj ikaldo tari phuv, savi putarda po muj te pijol o rat će phraleso andare ćire vasta. <verse eid="GEN 4:11" /><verse number="12" style="v" sid="GEN 4:12" />Kana ka ćere bući pi phuv, voj te ma dol tut po bijandipe. Ka ave lutalica thaj begunco pi phuv.”<verse eid="GEN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 4:13" />O Kajin phenda e GOSPODESE: “Mi kazna si but po bari nego so šaj te inđarav! <verse eid="GEN 4:13" /><verse number="14" style="v" sid="GEN 4:14" />Akh, avđive trade man tare kaja phuv thaj mora te garavav man tare ćiro muj. Ka avav lutalica thaj begunco ki phuv, a dži jekh savo ka araćhol man, ka mudarol man.”<verse eid="GEN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 4:15" />Al o GOSPOD phenda lese: “Na! Te khoni mudarol e Kajine, ka resol le efta droma pobari osveta.”</para>
  <para style="p" vid="GEN 4:15">Thaj čhuta o GOSPOD znako po Kajin te ma mudarol le khoni kana ka araćhol le.<verse eid="GEN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 4:16" />Tegani đelo o Kajin taro muj e GOSPODESO, thaj đelo te bešol ani phuv i Nod, istočno taro Eden.<verse eid="GEN 4:16" /></para>
  <para style="s">E Kajinese potomkura</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17" />O Kajin pašlilo pe romnjasa, voj ačhili khamni thaj bijanda e Enohe. Tegani o Kajin vazdija foro savo akharda Enoh, pale po čhavo. <verse eid="GEN 4:17" /><verse number="18" style="v" sid="GEN 4:18" />E Enohese bijandilo o Irad, e Iradese bijandilo o Malaleil, e Malaleilese bijandilo o Metušael, a e Metušaelese bijandilo o Lameh.<verse eid="GEN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 4:19" />O Lameh lija duje romnjen: jekhako sasa alav Ada a e dujtonako Cila. <verse eid="GEN 4:19" /><verse number="20" style="v" sid="GEN 4:20" />I Ada bijanda e Javale. Lestar bijandile kola save bešen ke šatora thaj araćhen stoka. <verse eid="GEN 4:20" /><verse number="21" style="v" sid="GEN 4:21" />Lese phraleso alav sasa Juval thaj lestar bijandile kola save bašalen harfa thaj duduko. <verse eid="GEN 4:21" /><verse number="22" style="v" sid="GEN 4:22" />I Cila bijanda e Tuval-Kajine, savo sasa kovači thaj ćerola alati taro bakar thaj sastren. E Tuval-Kajinesi phen akhardola Naama.<verse eid="GEN 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 4:23" />O Lameh vaćarda pe romnjenđe:</para>
  <para style="q1" vid="GEN 4:23">“Ado thaj Cilo, šunen o glaso mingro,</para>
  <para style="q2" vid="GEN 4:23">e romnja e Lamehese, šunen o lafi mingro!</para>
  <para style="q1" vid="GEN 4:23">Mudardem e manuše savo ranisada man,</para>
  <para style="q2" vid="GEN 4:23">terne čhave savo čalada man.<verse eid="GEN 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 4:24" />Ako o Kain ka avol osvetimo efta droma,</para>
  <para style="q2" vid="GEN 4:24">tegani o Lameh eftavardeš thaj efta (77) droma.”<verse eid="GEN 4:24" /></para>
  <para style="s">O Sit thaj o Enos</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25" />O Adam palem pašlilo pe romnjasa. Voj bijanda lese murše thaj dija le alav Sit, golese so vaćarda: “O Dol dija man avere čhave umesto o Avelj kas mudarda o Kajin.”<verse eid="GEN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 4:26" />Thaj e Sitese bijandilo čhavo, kase dija alav Enos.</para>
  <para style="p" vid="GEN 4:26">Od tegani e manuša lije te slavin o alav e GOSPODESO.<verse eid="GEN 4:26" /></para>
  <chapter eid="GEN 4" />
  <chapter number="5" style="c" sid="GEN 5" />
  <para style="s">E potomkura taro Adam dži ko Noja</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1" />Kava si lil taro pleme e Adameso:</para>
  <para style="p" vid="GEN 5:1">Kana o Dol ćerda e manuše, ćerda le ki piri slika. <verse eid="GEN 5:1" /><verse number="2" style="v" sid="GEN 5:2" />Ćerda e murše thaj e džuvlja thaj blagoslovisada len. A kana ćerda len, akharda len “manuš”.<verse eid="GEN 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 5:3" />Kana e Adame sesa šelutranda (130) berš, bijandilo lese čhavo ki lesi slika, savo ličisada pe leste thaj dija le alav Sit. <verse eid="GEN 5:3" /><verse number="4" style="v" sid="GEN 5:4" />A kana bijandilo o Sit, o Adam sasa džuvdo vadži ohtošel (800) berš thaj sasa le vadži čhave thaj čheja. <verse eid="GEN 5:4" /><verse number="5" style="v" sid="GEN 5:5" />Gija o Adam sasa džuvdo enjašel thaj tranda (930) berš thaj mulo.<verse eid="GEN 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 5:6" />Kana e Site sasa šelupandž (105) berš, bijandilo lese o Enos. <verse eid="GEN 5:6" /><verse number="7" style="v" sid="GEN 5:7" />A kana bijandilo o Enos, o Sit sasa džuvdo vadži ohtošel thaj efta (807) berš thaj sasa le vadži čhave thaj čheja. <verse eid="GEN 5:7" /><verse number="8" style="v" sid="GEN 5:8" />Gija o Sit sasa džuvdo enjašel thaj dešuduj (912) berš thaj mulo.<verse eid="GEN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 5:9" />Kana e Enose sasa enjavardeš (90) berš, bijandilo lese o Kajinam. <verse eid="GEN 5:9" /><verse number="10" style="v" sid="GEN 5:10" />A kana bijandilo o Kajinam, o Enos sasa džuvdo vadži ohtošel thaj dešupandž (815) berš thaj sasa le vadži čhave thaj čheja. <verse eid="GEN 5:10" /><verse number="11" style="v" sid="GEN 5:11" />Gija o Enos sasa džuvdo enjašel thaj pandž (905) berš thaj mulo.<verse eid="GEN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 5:12" />Kana e Kajiname sasa eftavardeš (70) berš, bijandilo lese o Malaleil. <verse eid="GEN 5:12" /><verse number="13" style="v" sid="GEN 5:13" />A kana bijandilo o Malaleil, o Kajinam sasa džuvdo vadži ohtošel thaj saranda (840) berš thaj sasa le vadži čhave thaj čheja. <verse eid="GEN 5:13" /><verse number="14" style="v" sid="GEN 5:14" />Gija o Kajinam sasa džuvdo enjašel thaj deš (910) berš thaj mulo.<verse eid="GEN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 5:15" />Kana e Malaleile sasa šovardeš thaj pandž (65) berš, bijandilo lese o Jaret. <verse eid="GEN 5:15" /><verse number="16" style="v" sid="GEN 5:16" />A kana bijandilo o Jaret, o Malaleil sasa džuvdo vadži ohtošel thaj tranda (830) berš thaj sasa le vadži čhave thaj čheja. <verse eid="GEN 5:16" /><verse number="17" style="v" sid="GEN 5:17" />Gija o Malaleil sasa džuvdo ohtošel thaj enjavardeš thaj pandž (895) berš thaj mulo.<verse eid="GEN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 5:18" />Kana e Jarete sasa šelušovardeš thaj duj (162) berš, bijandilo lese o Enoh. <verse eid="GEN 5:18" /><verse number="19" style="v" sid="GEN 5:19" />A kana bijandilo lese o Enoh, o Jaret sasa džuvdo vadži ohtošel (800) berš thaj sasa le vadži čhave thaj čheja. <verse eid="GEN 5:19" /><verse number="20" style="v" sid="GEN 5:20" />Gija o Jaret sasa džuvdo enjašel thaj šovardeš thaj duj (962) berš thaj mulo.<verse eid="GEN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 5:21" />Kana e Enohe sasa šovardeš thaj pandž (65) berš, bijandilo lese o Matusala. <verse eid="GEN 5:21" /><verse number="22" style="v" sid="GEN 5:22" />A kana bijandilo lese o Matusala, o Enoh sasa džuvdo trišel (300) berš, živisada pali Devlesi volja<note caller="+" style="f"><char style="fr" closed="false">5,22 </char><char style="fq" closed="false">živisada pali Devlesi volja </char><char style="ft" closed="false">Ano original ačhol: “phirda e Devlesa.”</char></note> thaj sasa le vadži čhave thaj čheja. <verse eid="GEN 5:22" /><verse number="23" style="v" sid="GEN 5:23" />Gija o Enoh sasa džuvdo trišel thaj šovardeš thaj pandž (365) berš. <verse eid="GEN 5:23" /><verse number="24" style="v" sid="GEN 5:24" />O Enoh živisada pali Devlesi volja, a tari jekh drom hasajlo, golese so lija le o Dol.<verse eid="GEN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 5:25" />Kana e Matusale sasa šelohtovardeš thaj efta (187) berš, bijandilo lese o Lameh. <verse eid="GEN 5:25" /><verse number="26" style="v" sid="GEN 5:26" />A kana bijandilo lese o Lameh, o Matusala sasa džuvdo vadži eftašel thaj ohtovardeš thaj duj (782) berš thaj sasa le vadži čhave thaj čheja. <verse eid="GEN 5:26" /><verse number="27" style="v" sid="GEN 5:27" />Gija o Matusala sasa džuvdo enjašel thaj šovardeš thaj enja (969) berš thaj mulo.<verse eid="GEN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 5:28" />Kana e Lamehe sasa šeluohtovardeš thaj duj (182) berš, bijandilo lese čhavo. <verse eid="GEN 5:28" /><verse number="29" style="v" sid="GEN 5:29" />Dija le alav Noja thaj phenda: “Kava ka anol amenđe uteha ani amari phari bući savi mora te ćera amare vastencar ki phuv, pe savi o Dol ačhada o harami.” <verse eid="GEN 5:29" /><verse number="30" style="v" sid="GEN 5:30" />A kana bijandilo lese o Noja, o Lameh sasa džuvdo vadži pandžšel thaj enjavardeš thaj pandž (595) berš thaj sasa le vadži čhave thaj čheja. <verse eid="GEN 5:30" /><verse number="31" style="v" sid="GEN 5:31" />Gija o Lameh sasa džuvdo eftašel thaj eftavardeš thaj efta (777) berš thaj mulo.<verse eid="GEN 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 5:32" />Kana e Noja sasa pandžšel (500) berš, bijandile lese o Sim, o Ham thaj o Jafet.<verse eid="GEN 5:32" /></para>
  <chapter eid="GEN 5" />
  <chapter number="6" style="c" sid="GEN 6" />
  <para style="s">E manušengo bilačhipe</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1" />Kana ki phuv e manuša lije te množin pe thaj bijandile lenđe čheja, <verse eid="GEN 6:1" /><verse number="2" style="v" sid="GEN 6:2" />dikhlje e čhave e Devlese<note caller="+" style="f"><char style="fr" closed="false">6,2 </char><char style="fq" closed="false">čhave e Devlese </char><char style="ft" closed="false">Kava šaj te tumačil pe sar: “Nebeska bićura, anđelura il čhave e carurenđe.”</char></note> kaj si e manušikane čheja lačhe, thaj sava manglje, lije romnjaće.<verse eid="GEN 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 6:3" />Tegani o GOSPOD phenda: “Mo Duxo ni ka ačhol ano manuš ane sa e đivesa golese so si samo telo. Nek avol džuvdo šelubiš (120) berš.”<verse eid="GEN 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 6:4" />Ane gova vreme ki phuv, a i pale gova, gola čhave e Devlese pašljona e manušikane čhejencar a von bijanena lenđe čhaven save akhardona Nefilimura. Von sesa junakura, taro purano vreme ko šukar glaso.<verse eid="GEN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 6:5" />O GOSPOD dikhlja kobor si baro o bilačhipe e manušengo ki phuv thaj kaj sa so dena gođi e manuša ane po ilo uvek si bilačhe. <verse eid="GEN 6:5" /><verse number="6" style="v" sid="GEN 6:6" />Golese, e GOSPODESE pelo žal so ćerda e manuše ki phuv thaj sasa lese pharo ano ilo.<verse eid="GEN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 6:7" />Golese o GOSPOD phenda: “Ka kosav tari phuv e manušen saven ćerdem, katane e životinjencar, čirikljencar thaj e stvorenjurencar so lazin ki phuv, golese kaj sem žalosno so ćerdem len.”<verse eid="GEN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 6:8" />Al o Noja arakhlja milost ane GOSPODESE jakha.<verse eid="GEN 6:8" /></para>
  <para style="s">O Noja thaj o potop</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9" />Kava si pisimo taro Noja:</para>
  <para style="p" vid="GEN 6:9">O Noja sasa manuš pravedno thaj besprekorno maškare sa e manuša ane gova vreme. O Noja živisada pale Devlesi volja.<verse eid="GEN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 6:10" />E Noja sesa trin čhave: o Sim o Ham thaj o Jafet. <verse eid="GEN 6:10" /><verse number="11" style="v" sid="GEN 6:11" />Al i phuv rumisajli anglo Dol thaj sasa pherdi nasilje.<verse eid="GEN 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 6:12" />O Dol dikhlja so i phuv rumisajli, golese so sa e manuša pi phuv rumisajle. <verse eid="GEN 6:12" /><verse number="13" style="v" sid="GEN 6:13" />Golese vaćarda o Dol e Nojase: “Odlučisadem te uništiv sa e manušen ki phuv, golese so i phuv pherdili nasilje. Akh, ka uništiv len sa e phuvasa. <verse eid="GEN 6:13" /><verse number="14" style="v" sid="GEN 6:14" />Golese ćer tuće brodo taro goferi kaš thaj ćer pregrade ano brodo thaj makh le e smolasa andral thaj avral. <verse eid="GEN 6:14" /><verse number="15" style="v" sid="GEN 6:15" />O brodo ćer gija: baro te avol šelutranda thaj pandž (135) metra, bulo bišteduj tepaš (22,5) metra thaj učo dešutrin tepaš (13,5) metra.<note caller="+" style="f"><char style="fr" closed="false">6,15 </char><char style="ft" closed="false">Ano original akala mere sesa računime ane kuja. Jekh kuj si saranda thaj pandž (45) cm. </char></note> <verse eid="GEN 6:15" /><verse number="16" style="v" sid="GEN 6:16" />Ko brodo ćer krovo gija te ačhave opašo metro prostori taro vrho. Ki jekh rig ćer vudar, a andral o brodo ćer te avol teluno, dujto thaj trito sprato.<verse eid="GEN 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 6:17" />Akh, ka mukhav bare paja pi phuv te uništil talo nebo sa ane soste isi daxo e džuvdimaso. Ka merol sa so si ki phuv. <verse eid="GEN 6:17" /><verse number="18" style="v" sid="GEN 6:18" />Al tusa ka ćerav mo savez. Ka den ano brodo tu, ći romni, će čhave thaj lenđe romnja. <verse eid="GEN 6:18" /><verse number="19" style="v" sid="GEN 6:19" />Ano brodo an tare sa e džuvde stvorenjura po jekh paro, murše thaj džuvlja, tusa te ačhen džuvde. <verse eid="GEN 6:19" /><verse number="20" style="v" sid="GEN 6:20" />Tare sa e čiriklja, tare sa e životinje, tare sa e stvorenjura save lazin ki phuv pale lenđe vrste, te aven tusa po duj, te ačhen džuvde. <verse eid="GEN 6:20" /><verse number="21" style="v" sid="GEN 6:21" />Le tusa dži jekh xape savo šaj te xal pe, thaj arakh ke tute, te avol xamase tuće thaj lenđe.”<verse eid="GEN 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 6:22" />Thaj o Noja ćerda sa sar so zapovedisada lese o Dol.<verse eid="GEN 6:22" /></para>
  <chapter eid="GEN 6" />
  <chapter number="7" style="c" sid="GEN 7" />
  <para style="s">O potop</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1" />O GOSPOD phenda e Nojase: “De andre ano brodo tu thaj sa ćire ćherutne, golese kaj dikhljem kaj san samo tu pravedno angle mande ani kaja generacija. <verse eid="GEN 7:1" /><verse number="2" style="v" sid="GEN 7:2" />Le tusa tare sa e thode životinje po efta parura, murše thaj džuvlja, al tare melale životinje le samo po jekh paro, murše thaj džuvlja, <verse eid="GEN 7:2" /><verse number="3" style="v" sid="GEN 7:3" />thaj efta parura tare čiriklja, murše thaj džuvlja, te bi arakhadola lengo potomstvo ki phuv. <verse eid="GEN 7:3" /><verse number="4" style="v" sid="GEN 7:4" />Golese so, baše efta đive ka mukhav bršnd ki phuv te perol saranda (40) đive thaj saranda raća thaj ka kosav taro muj e phuvako dži jekh džuvdo stvorenje savo ćerdem.”<verse eid="GEN 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 7:5" />Thaj o Noja ćerda sa so o GOSPOD zapovedisada lese.<verse eid="GEN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 7:6" />E Noja sasa šovšel (600) berš kana avilo o potop ki phuv. <verse eid="GEN 7:6" /><verse number="7" style="v" sid="GEN 7:7" />Thaj o Noja đelo andre ano brodo pe romnjasa, pe čhavencar thaj lenđe romnjencar, te bi spasina pe taro potop. <verse eid="GEN 7:7" /><verse number="8" style="v" sid="GEN 7:8" />Tare thode thaj e melale životinje, tare čiriklja thaj tare sa e stvorenjura save lazin ki phuv, <verse eid="GEN 7:8" /><verse number="9" style="v" sid="GEN 7:9" />đele ano brodo ko Noja, duj po duj, murš thaj džuvli, gija sar so o Dol zapovedisada lese.<verse eid="GEN 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 7:10" />Efta đive pale gova, o potop avilo ki phuv.<verse eid="GEN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 7:11" />Kana sasa e Noja šovšel berš (600), ko dešeftato (17․) đive ko dujto čhon, pharile sa e izvora tare bare dubine thaj putajle e brane ko nebo. <verse eid="GEN 7:11" /><verse number="12" style="v" sid="GEN 7:12" />Thaj o bršnd pelo ki phuv saranda (40) đive thaj saranda raća.<verse eid="GEN 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 7:13" />Gova isto đive dije andre ano brodo o Noja, lese čhave o Sim, o Ham thaj o Jafet, e Nojasi romni thaj e trin romnja lese čhavenđe, <verse eid="GEN 7:13" /><verse number="14" style="v" sid="GEN 7:14" />a lencar sa e vrste tare divlja životinje, sa e vrste tari stoka, sa e vrste tare stvorenjura save lazin ki phuv, sa e vrste tare čiriklja. <verse eid="GEN 7:14" /><verse number="15" style="v" sid="GEN 7:15" />Tare sa e stvorenjura saven isi o daxo e džuvdimaso, dije andre ano brodo ko Noja duj po duj. <verse eid="GEN 7:15" /><verse number="16" style="v" sid="GEN 7:16" />Đele murš thaj džuvli tare sa e džuvde stvorenjura, sar so o Dol zapovedisada e Nojase.</para>
  <para style="p" vid="GEN 7:16">Tegani o GOSPOD phanglja o vudar pale leste.<verse eid="GEN 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 7:17" />Saranda (40) đive o potop ćinđarda i phuv thaj sar o paj barola, gija inđarda o brodo thaj vazdija le učeste prekali phuv. <verse eid="GEN 7:17" /><verse number="18" style="v" sid="GEN 7:18" />O paj vazdola pe thaj barola učeste prekali phuv, a o brodo plovilasa po paj. <verse eid="GEN 7:18" /><verse number="19" style="v" sid="GEN 7:19" />Gaći zurale vazdija pe o paj upreder i phuv, kaj učharda sa e embare planine talo nebo. <verse eid="GEN 7:19" /><verse number="20" style="v" sid="GEN 7:20" />O paj vazdija pe paše efta metra prekale embare planine. <verse eid="GEN 7:20" /><verse number="21" style="v" sid="GEN 7:21" />Mudardile sa e džuvde stvorenjura ki phuv: e čiriklja, i stoka, e divlja životinje, sa e stvorenjura save lazin pi phuv thaj sa e manuša. <verse eid="GEN 7:21" /><verse number="22" style="v" sid="GEN 7:22" />Sa so ačhilo ki phuv mudardilo, sa so ano nakh sasa le daxo e džuvdimaso. <verse eid="GEN 7:22" /><verse number="23" style="v" sid="GEN 7:23" />Gija o Dol koslja taro muj e phuvako dži jekh džuvdo stvorenje: e manušen, e životinjen, e stvorenjuren save lazin ki phuv thaj e čirikljen. Ačhile samo o Noja thaj kola so sesa lesa ano brodo.<verse eid="GEN 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 7:24" />O paj učharda i phuv šelupinda (150) đive.<verse eid="GEN 7:24" /></para>
  <chapter eid="GEN 7" />
  <chapter number="8" style="c" sid="GEN 8" />
  <para style="s">O Dol ačhavol o potop</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1" />O Dol dija pe gođi taro Noja, tare sa e divlja životinje thaj tari sa i stoka savi sasa lesa ano brodo. Golese bičhalda balval te phurdol ki phuv thaj o paj lije te crdol pe. <verse eid="GEN 8:1" /><verse number="2" style="v" sid="GEN 8:2" />Phanglile e izvora tare bare dubine thaj e nebose brane, thaj o bršnd ačhilo te perol taro nebo. <verse eid="GEN 8:2" /><verse number="3" style="v" sid="GEN 8:3" />O paj lija te crdol pe tari phuv thaj pale šelupinda (150) đive lija gaći te šućol <verse eid="GEN 8:3" /><verse number="4" style="v" sid="GEN 8:4" />kaj dešeftato (17․) đive ano eftato čhon o brodo ačhilo ko brego Ararat. <verse eid="GEN 8:4" /><verse number="5" style="v" sid="GEN 8:5" />O paj crdola pe thaj šućola sa dži ko dešto (10․) čhon thaj ano angluno đive ko dešto čhon sikadile e vrhura tare planine.<verse eid="GEN 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 8:6" />A pale saranda (40) đive, putarda o Noja o džamo ko brodo savo ćerda <verse eid="GEN 8:6" /><verse number="7" style="v" sid="GEN 8:7" />thaj mukhlja avri e gavrano. O gavrano letila avri thaj irila pe ko brodo, sa dži kaj ni šućilo o paj pi phuv. <verse eid="GEN 8:7" /><verse number="8" style="v" sid="GEN 8:8" />Tegani o Noja mukhlja e golubica te dićhol dal crdija pe o paj tari phuv. <verse eid="GEN 8:8" /><verse number="9" style="v" sid="GEN 8:9" />Al i golubica ni arakhlja than pe savo bi mućhola pe, golese kaj o paj vadži sasa ki sa i phuv, pa irisajli ko Noja ano brodo. Vov pružisada po va, dolda e golubica thaj irisada la ano brodo. <verse eid="GEN 8:9" /><verse number="10" style="v" sid="GEN 8:10" />Ađućarda o Noja vadži efta đive thaj palem mukhlja e golubica taro brodo. <verse eid="GEN 8:10" /><verse number="11" style="v" sid="GEN 8:11" />Angleder nego te perol i rat, i golubica irisajli ko Noja, thaj ano muj anda tek čhindi patrn tari maslina. Gija o Noja džanglja kaj crdija pe o paj tari phuv. <verse eid="GEN 8:11" /><verse number="12" style="v" sid="GEN 8:12" />Tegani ađućarda vadži efta đive, thaj palem mukhlja e golubica, al voj ni irisajli lese.<verse eid="GEN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 8:13" />Kana sasa e Noja šovšel thaj jekh (601) berš, ko angluno đive ano angluno čhon šućilo o paj tari phuv. O Noja putarda o krovo taro brodo thaj dikhlja kaj i phuv šućola. <verse eid="GEN 8:13" /><verse number="14" style="v" sid="GEN 8:14" />Dži ke bište eftato (27․) đive ko dujto čhon sasa sa i phuv šući.<verse eid="GEN 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 8:15" />Tegani o Dol phenda e Nojase: <verse eid="GEN 8:15" /><verse number="16" style="v" sid="GEN 8:16" />“Iklji taro brodo tu, ći romni, će čhave thaj lenđe romnja. <verse eid="GEN 8:16" /><verse number="17" style="v" sid="GEN 8:17" />Ikal sa e vrste tare džuvde stvorenjura save si tusa: e čirikljen, e životinjen thaj sa e stvorenjuren save lazin ki phuv. Nek i phuv pherdol lencar, nek množin pe thaj nek bijandon ki phuv!”<verse eid="GEN 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 8:18" />Tegani iklile o Noja, lesi romni, lese čhave thaj lenđe romnja. <verse eid="GEN 8:18" /><verse number="19" style="v" sid="GEN 8:19" />Sa e životinje, sa e stvorenjura save lazin ki phuv, sa e čiriklja – sa so phirol pi phuv – sa pale pe vrste iklile andaro brodo.<verse eid="GEN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 8:20" />Tegani ćerda o Noja žrtveniko e GOSPODESE, lija tare sa e thode životinje thaj tare sa e thode čiriklja, thaj phabarda len ko žrtveniko sar phabardi žrtva.<verse eid="GEN 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 8:21" />O GOSPOD mirišisada gova lačho miris thaj vaćarda ane po ilo: “Ni ka dav vadži armaja i phuv bašo manuš, iako taro ternipe dol gođi bilačhe ane po ilo. Ni ka mudarav vadži sa e džuvde stvorenjuren, sar so ćerdem.<verse eid="GEN 8:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="GEN 8:22" />Sa dži kaj si i phuv,</para>
  <para style="q2" vid="GEN 8:22">sejipe thaj ćidipe,</para>
  <para style="q1" vid="GEN 8:22">šul thaj tatipe,</para>
  <para style="q2" vid="GEN 8:22">milaj thaj jevend,</para>
  <para style="q1" vid="GEN 8:22">o đive thaj i rat</para>
  <para style="q2" vid="GEN 8:22">ni ka ačhon.”<verse eid="GEN 8:22" /></para>
  <chapter eid="GEN 8" />
  <chapter number="9" style="c" sid="GEN 9" />
  <para style="s">O Dol ćerol savez e Nojasa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1" />Tegani o Dol blagoslovisada e Noja thaj lese čhaven, vaćarindoj: “Množin tumen, bijandon thaj pheren i phuv! <verse eid="GEN 9:1" /><verse number="2" style="v" sid="GEN 9:2" />Nek daran tumendar sa e životinje ki phuv, sa e čiriklja ko nebo, sa e stvorenjura save puzin ki phuv thaj sa e mačhe ano more – ane tumare vasta si predajime. <verse eid="GEN 9:2" /><verse number="3" style="v" sid="GEN 9:3" />Sa so phirol thaj si džuvdo, nek avol tumenđe xamase. Sar so dijem tumen e zelena biljke, gija akana dav tumen sa.<verse eid="GEN 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 9:4" />Al ma xan mas ane savo si vadži o rat, gova značil kaj si ane leste vadži o džuvdipe. <verse eid="GEN 9:4" /><verse number="5" style="v" sid="GEN 9:5" />Baše tumaro rat thaj tumaro džuvdipe, ka mangav te dol pe računo. Ka mangav gova tare dži jekh životinja savi lol e manušeso džuvdipe. Thaj ka mangav o džuvdipe tare dži jekh manuš savo lol avere manušeso džuvdipe.<verse eid="GEN 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 9:6" />‘Ko čhorol o rat e manušeso,</para>
  <para style="q2" vid="GEN 9:6">leso rat ka čhorol o manuš,</para>
  <para style="q1" vid="GEN 9:6">golese kaj o Dol ćerda</para>
  <para style="q2" vid="GEN 9:6">e manuše pe piro oblik.’<verse eid="GEN 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 9:7" />Množin tumen thaj bijandon. Pheren i phuv thaj množin tumen pe late.”<verse eid="GEN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8" />Tegani o Dol phenda e Nojase thaj lese čhavenđe: <verse eid="GEN 9:8" /><verse number="9" style="v" sid="GEN 9:9" />“Akh, phandav mingro savez tumencar thaj tumare potomkurencar, <verse eid="GEN 9:9" /><verse number="10" style="v" sid="GEN 9:10" />thaj svakone džuvde bićesa savo si tumencar – e čirikljencar, e stokasa thaj sa e divljone životinjencar, sa kolesa so iklilo andaro brodo tumencar – svakone džuvde bićesa ki phuv. <verse eid="GEN 9:10" /><verse number="11" style="v" sid="GEN 9:11" />Phandav mingro savez tumencar: Nikad vadži o potop ni ka uništil sa e džuvde bićura. Nikad ni ka avol gasavo potop te uništil sa pi phuv.”<verse eid="GEN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 9:12" />Thaj phenda o Dol: “Kava si o znako taro savez savo phandav maškare mande thaj tumende thaj maškar dži jekh džuvdo biće savo si tumencar, savo si baše sa e generacije save ka aven: <verse eid="GEN 9:12" /><verse number="13" style="v" sid="GEN 9:13" />Čhuvav i duga mingri ane oblakura, voj ka avol znako taro savez maškare mande thaj maškari phuv. <verse eid="GEN 9:13" /><verse number="14" style="v" sid="GEN 9:14" />Kana god ka čhuvav e oblakura pi phuv thaj kana ka sikadol i duga ke oblakura, <verse eid="GEN 9:14" /><verse number="15" style="v" sid="GEN 9:15" />ka dav man gođi pe mingro savez savo si maškar mande thaj tumende thaj dži jekh džuvdo biće. Thaj nikad vadži taro paj ni ka ćerdol potop savo ka uništil sa e džuvde stvorenjura. <verse eid="GEN 9:15" /><verse number="16" style="v" sid="GEN 9:16" />Kana i duga sikadol ane oblakura, ka dikhav la thaj ka dav man gođi po večno savez maškar mande thaj maškare sa e džuvde stvorenjura ki phuv.”<verse eid="GEN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 9:17" />Tegani vaćarda o Dol e Nojase: “Gova si o znako taro savez savo phangljem maškare mande thaj maškare džuvde stvorenjura ki phuv.”<verse eid="GEN 9:17" /></para>
  <para style="s">E Nojase čhave</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18" />E Nojase čhave save iklile taro brodo sesa o Sim, o Ham thaj o Jafet. (O Ham sasa dad e Hanaaneso.) <verse eid="GEN 9:18" /><verse number="19" style="v" sid="GEN 9:19" />Gova si trin čhave e Nojase, a lendar bijandile potomkura save raširisajle pi sa i phuv.<verse eid="GEN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 9:20" />A o Noja lija te ćerol bući pi phuv thaj sadisada vinograd. <verse eid="GEN 9:20" /><verse number="21" style="v" sid="GEN 9:21" />Jekh drom pilja mol, matilo thaj pašlilo nango ane po šatori. <verse eid="GEN 9:21" /><verse number="22" style="v" sid="GEN 9:22" />O Ham, o dad e Hanaaneso, dikhlja pe dadeso nanđipe thaj vaćarda gova solduje phralenđe save sesa avral. <verse eid="GEN 9:22" /><verse number="23" style="v" sid="GEN 9:23" />Tegani o Sim thaj o Jafet lije o ogrtači, čhute le pe phiće thaj đele irime dumesa te učharen o nanđipe pe dadeso. Lenđe muja sesa irime te ma dićhen o nanđipe pe dadeso.<verse eid="GEN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 9:24" />Kana o Noja treznisajlo tari mol thaj dodžanglja so ćerda leso emterno čhavo, <verse eid="GEN 9:24" /><verse number="25" style="v" sid="GEN 9:25" />phenda:</para>
  <para style="q1" vid="GEN 9:25">“Harami te avol o Hanaan!</para>
  <para style="q2" vid="GEN 9:25">Emteluno robo maškare robura</para>
  <para style="q2" vid="GEN 9:25">ka ave će phralenđe!”<verse eid="GEN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 9:26" />Thaj vadži phenda:</para>
  <para style="q1" vid="GEN 9:26">“Blagoslovimo te avol o GOSPOD, o Dol e Simoso!</para>
  <para style="q2" vid="GEN 9:26">O Hanaan te avol robo e Simoso!<verse eid="GEN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 9:27" />O Dol te dol e Jafete pobut phuv</para>
  <para style="q1" vid="GEN 9:27">te bešol ane šatora e Simose!</para>
  <para style="q2" vid="GEN 9:27">O Hanaan te avol leso robo!”<verse eid="GEN 9:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="GEN 9:28" />O Noja sasa džuvdo vadži trišel thaj pinda (350) berš palo potop. <verse eid="GEN 9:28" /><verse number="29" style="v" sid="GEN 9:29" />Gija o Noja sasa džuvdo enjašel thaj pinda (950) berš thaj mulo.<verse eid="GEN 9:29" /></para>
  <chapter eid="GEN 9" />
  <chapter number="10" style="c" sid="GEN 10" />
  <para style="s">E Nojase čhave</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1" />Kava si e Nojase čhavenđe potomkura: e Simose, e Hamese thaj e Jafetese, savenđe bijandile čhave palo potop.<verse eid="GEN 10:1" /></para>
  <para style="s2">E Jafetese potomkura</para>
  <para style="li">
    <verse number="2" style="v" sid="GEN 10:2" />E Jafetese čhave sesa:</para>
  <para style="li" vid="GEN 10:2">o Gomer, o Magog, o Madaj, o Javan, o Tuval, o Mešeh thaj o Tiras.<verse eid="GEN 10:2" /></para>
  <para style="li">
    <verse number="3" style="v" sid="GEN 10:3" />E Gomerese čhave sesa:</para>
  <para style="li" vid="GEN 10:3">o Aškenaz, o Rifat thaj o Togarma.<verse eid="GEN 10:3" /></para>
  <para style="li">
    <verse number="4" style="v" sid="GEN 10:4" />E Javanese čhave sesa:</para>
  <para style="li" vid="GEN 10:4">o Eliša, o Taršiš, o Kitim thaj o Rodanim.<verse eid="GEN 10:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="GEN 10:5" />Lendar uladile e manuša save bešen pašo more thaj ke ostrvura premale pire phuva, premal pire plemenura thaj narodura, dži jekh premal pumari čhib.<verse eid="GEN 10:5" /></para>
  <para style="s2">E Hamese potomkura</para>
  <para style="li1">
    <verse number="6" style="v" sid="GEN 10:6" />E Hamese čhave sesa:</para>
  <para style="li2" vid="GEN 10:6">o Kuš, o Micrajim<note caller="+" style="f"><char style="fr" closed="false">10,6 </char><char style="fq" closed="false">Micrajim </char><char style="ft" closed="false">Kava si o Egipat.</char></note>, o Put thaj o Hanaan.<verse eid="GEN 10:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="GEN 10:7" />E čhave e Kušase sesa:</para>
  <para style="li2" vid="GEN 10:7">o Seva, o Havila, o Savta, o Raama thaj o Savteha.</para>
  <para style="li1" vid="GEN 10:7">E Raamese čhave:</para>
  <para style="li2" vid="GEN 10:7">o Ševa thaj o Dedan.<verse eid="GEN 10:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="GEN 10:8" />E Kušese bijandilo o Nimrod. Vov sasa angluno baro junako ki phuv. <verse eid="GEN 10:8" /><verse number="9" style="v" sid="GEN 10:9" />Vov sasa zuralo lovco anglo GOSPOD. Golese phenol pe: “Zuralo lovco anglo GOSPOD sar o Nimrod.” <verse eid="GEN 10:9" /><verse number="10" style="v" sid="GEN 10:10" />Leso angluno carstvo sasa o Vavilon, o Ereh, o Akad thaj o Kalna ani phuv i Šinar. <verse eid="GEN 10:10" /><verse number="11" style="v" sid="GEN 10:11" />Tari goja phuv đelo ano Asirija, odori vazdija i Niniva, o Rehovot Ir, o Kalah, <verse eid="GEN 10:11" /><verse number="12" style="v" sid="GEN 10:12" />thaj o Resen savo si maškar i Niniva thaj o baro foro o Kalah.<verse eid="GEN 10:12" /></para>
  <para style="b" />
  <para style="li">
    <verse number="13" style="v" sid="GEN 10:13" />Taro Micrajim postanisade kala plemenura:</para>
  <para style="li" vid="GEN 10:13">e Ludijcura, e Anamcura, e Lehavcura, e Naftuhejcura,<verse eid="GEN 10:13" /></para>
  <para style="li">
    <verse number="14" style="v" sid="GEN 10:14" />e Patruscura, e Kasluhejcura (kastar postanisade e Filistejcura) thaj e Kaftovcura.<verse eid="GEN 10:14" /></para>
  <para style="li">
    <verse number="15" style="v" sid="GEN 10:15" />Taro Hanaan postanisade kala plemenura:</para>
  <para style="li" vid="GEN 10:15">e Sidoncura, save sesa tare leso angluno čhavo o Sidon, thaj e Hetitura,<verse eid="GEN 10:15" /></para>
  <para style="li">
    <verse number="16" style="v" sid="GEN 10:16" />pale gova e Jevusejcura, e Amorejcura, e Girgašanura,<verse eid="GEN 10:16" /></para>
  <para style="li">
    <verse number="17" style="v" sid="GEN 10:17" />e Hivijcura, e Arkijcura, e Sinijcura,<verse eid="GEN 10:17" /></para>
  <para style="li">
    <verse number="18" style="v" sid="GEN 10:18" />e Arvađanura, e Cemarcura thaj e Hamaćanura.</para>
  <para style="m" vid="GEN 10:18">Pale gova e hanaanska plemenura rasejisajle. <verse eid="GEN 10:18" /><verse number="19" style="v" sid="GEN 10:19" />Gija o područje e Hanaancurengo sasa taro Sidon premalo Gerar sa dži ki Gaza, pa premali Sodoma, i Gomora, i Adma thaj o Cevoim, sa dži ki Laša.<verse eid="GEN 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 10:20" />Gova si e Hamese čhave pale pire plemenura, čhiba, phuva thaj narodura.<verse eid="GEN 10:20" /></para>
  <para style="s2">E Simose potomkura</para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 10:21" />O Sim sasa phureder phral e Jafetoso. I e Simose bijandile čhave; vov sasa paradad sa e Everovijase<note caller="+" style="f"><char style="fr" closed="false">10,21 </char><char style="fq" closed="false">Everovijase </char><char style="ft" closed="false">Lestar aven e Jevreja.</char></note> potomkurenđe.<verse eid="GEN 10:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="GEN 10:22" />E Simose čhave sesa:</para>
  <para style="li2" vid="GEN 10:22">o Elam, o Ašur, o Arfaksad, o Lud thaj o Aram.<verse eid="GEN 10:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 10:23" />E Aramese čhave sesa:</para>
  <para style="li2" vid="GEN 10:23">O Uc, o Hul, o Geter thaj o Maš.<verse eid="GEN 10:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 10:24" />E Arfaksadese bijandilo o Sala,</para>
  <para style="li2" vid="GEN 10:24">a e Salase bijandilo o Ever.<verse eid="GEN 10:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 10:25" />A e Everese bijandile duj čhave:</para>
  <para style="li2" vid="GEN 10:25">Jekheso alav sasa Falek, golese so ane leso vreme uladile e manuša ki phuv, a lese phraleso alav sasa Joktan.<verse eid="GEN 10:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 10:26" />E Joktanese bijandile:</para>
  <para style="li2" vid="GEN 10:26">o Almodad, o Šelef, o Hacarmavet, o Jerah,<verse eid="GEN 10:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="GEN 10:27" />o Hadoram, o Uzal, o Dikla,<verse eid="GEN 10:27" /></para>
  <para style="li2">
    <verse number="28" style="v" sid="GEN 10:28" />o Oval, o Avimael, o Ševa,<verse eid="GEN 10:28" /></para>
  <para style="li2">
    <verse number="29" style="v" sid="GEN 10:29" />o Ofir, o Havila thaj o Jovav.</para>
  <para style="m" vid="GEN 10:29">Savore sesa e Joktanese čhave. <verse eid="GEN 10:29" /><verse number="30" style="v" sid="GEN 10:30" />Von bešle ko područje tari Meša pa dži ko Sefar, phuv ane bregura ko istok.<verse eid="GEN 10:30" /></para>
  <para style="b" />
  <para style="p">
    <verse number="31" style="v" sid="GEN 10:31" />Gova si e Simose čhave pale pire plemenura, čhiba, phuva thaj narodura.<verse eid="GEN 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 10:32" />Gova si e Nojase čhavenđe potomkura pale lenđe plemenura ane lenđe narodura. Lendar uladile sa e narodura pi phuv palo potop.<verse eid="GEN 10:32" /></para>
  <chapter eid="GEN 10" />
  <chapter number="11" style="c" sid="GEN 11" />
  <para style="s">I Vavilonsko kula</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1" />Tegani ke sa o sveto e manuša vaćarena jekhe čhibasa thaj sasa len ista lafura. <verse eid="GEN 11:1" /><verse number="2" style="v" sid="GEN 11:2" />Sar e manuša džana ko istok, avile dži ki jekh dolina ani Šinarsko phuv thaj gothe ačhile te bešen.<verse eid="GEN 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 11:3" />Tegani vaćarde maškar peste: “Ajde te ćera tugle thaj te peka len šukar ani jag, te bi zuravona.”</para>
  <para style="p" vid="GEN 11:3">Gija koristisade tugle umesto bara, a o katrano sar malteri.<verse eid="GEN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 11:4" />Tegani phende: “Ajde te ćera amenđe foro thaj kula kaso upruno kotor ka avol dži ko nebo, te bi avola amen slavno alav thaj te ne bi avasa rasejime ane sa o sveto.”<verse eid="GEN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 11:5" />Al o GOSPOD ulilo te dićhol o foro thaj i kula savi e manuša ćerde.<verse eid="GEN 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 11:6" />O GOSPOD vaćarda: “Čače von si jekh narodo thaj savore vaćaren jekha čhibasa. Kava si tek anglunipe tare lenđe buća. Sa so ka den gođi te ćeren, ni ka avol lenđe nemoguće. <verse eid="GEN 11:6" /><verse number="7" style="v" sid="GEN 11:7" />Ajde te ulja tele thaj te ćera zabuna ani lenđi čhib, te ma haljaren jekh avere.”<verse eid="GEN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 11:8" />Gija o GOSPOD gothar rasejisada len ke sa o sveto, thaj von ačhade te zidin o foro. <verse eid="GEN 11:8" /><verse number="9" style="v" sid="GEN 11:9" />Kava foro dol pe vika Vavilon, golese kaj o GOSPOD gothar ćerda zabuna ani čhib ke sa o sveto. Gothar o GOSPOD rasejisada len te džan ane sa e phuva.<verse eid="GEN 11:9" /></para>
  <para style="s">E Simose potomkura</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10" />Kava si lil taro pleme e Simoso:</para>
  <para style="p" vid="GEN 11:10">Duj berš palo potop, kana e Sime sasa šel (100) berš, bijandilo lese o Arfaksad. <verse eid="GEN 11:10" /><verse number="11" style="v" sid="GEN 11:11" />A kana bijandilo o Arfaksad, o Sim sasa džuvdo vadži pandžšel (500) berš thaj bijandile lese vadži čhave thaj čheja.<verse eid="GEN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 11:12" />Kana e Arfaksade sasa tranda thaj pandž (35), bijandilo lese o Sala. <verse eid="GEN 11:12" /><verse number="13" style="v" sid="GEN 11:13" />A kana bijandilo o Sala, o Arfaksad sasa džuvdo vadži štaršel thaj trin (403) berš thaj bijandile lese vadži čhave thaj čheja.<verse eid="GEN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 11:14" />Kana e Sala sasa tranda (30) berš, bijandilo lese o Ever. <verse eid="GEN 11:14" /><verse number="15" style="v" sid="GEN 11:15" />A kana bijandilo o Ever, o Sala sasa džuvdo vadži štaršel thaj trin (403) berš thaj bijandile lese vadži čhave thaj čheja.<verse eid="GEN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 11:16" />Kana e Evere sasa tranda thaj štar (34) berš, bijandilo lese o Falek. <verse eid="GEN 11:16" /><verse number="17" style="v" sid="GEN 11:17" />A kana bijandilo o Falek, o Ever sasa džuvdo vadži štaršel thaj tranda (430) berš thaj bijandile lese vadži čhave thaj čheja.<verse eid="GEN 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 11:18" />Kana e Faleke sasa tranda (30) berš, bijandilo lese o Ragav. <verse eid="GEN 11:18" /><verse number="19" style="v" sid="GEN 11:19" />A kana bijandilo o Ragav, o Falek sasa džuvdo vadži dujšel thaj enja (209) berš thaj bijandile lese vadži čhave thaj čheja.<verse eid="GEN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 11:20" />Kana e Ragave sasa tranda thaj duj (32) berš, bijandilo lese o Seruh. <verse eid="GEN 11:20" /><verse number="21" style="v" sid="GEN 11:21" />A kana bijandilo o Seruh, o Ragav sasa džuvdo vadži dujšel thaj efta (207) berš thaj bijandile lese vadži čhave thaj čheja.<verse eid="GEN 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 11:22" />Kana e Seruhe sasa tranda (30) berš, bijandilo lese o Nahor. <verse eid="GEN 11:22" /><verse number="23" style="v" sid="GEN 11:23" />A kana bijandilo o Nahor, o Seruh sasa džuvdo vadži dujšel (200) berš thaj bijandile lese vadži čhave thaj čheja.<verse eid="GEN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 11:24" />Kana e Nahore sasa biš thaj enja (29) berš, bijandilo lese o Tara. <verse eid="GEN 11:24" /><verse number="25" style="v" sid="GEN 11:25" />A kana bijandilo o Tara, o Nahor sasa džuvdo vadži šeludešenja (119) berš thaj bijandile lese vadži čhave thaj čheja.<verse eid="GEN 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 11:26" />Kana e Tara sasa eftavardeš (70) berš, bijandile lese o Avram, o Nahor thaj o Haran.<verse eid="GEN 11:26" /></para>
  <para style="s">E Avramesi familija</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27" />Kava si potomkura e Tarese:</para>
  <para style="p" vid="GEN 11:27">E Tarese bijandile o Avram, o Nahor thaj o Haran.</para>
  <para style="p" vid="GEN 11:27">E Haranese bijandilo o Lot. <verse eid="GEN 11:27" /><verse number="28" style="v" sid="GEN 11:28" />O Haran mulo angleder leso dad o Tara ani phuv kaj bijandilo, ano Ur Haldejsko.<verse eid="GEN 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 11:29" />O Avram thaj o Nahor lije romnjen. E Avramese romnjako alav sasa Saraja, a e Nahorese romnjako alav sasa Milka, čhej e Haranesi. I Milka thaj i Jiska sesa čheja e Haranese. <verse eid="GEN 11:29" /><verse number="30" style="v" sid="GEN 11:30" />E Saraja ni sesa čhave, golese so naštine te ačhol khamni.<verse eid="GEN 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 11:31" />O Tara lija pe čhave e Avrame thaj pe unuko e Lote, e Haranese čhave, thaj pe bora e Saraja, e Avramese romnja, thaj katane lencar đele taro Ur Haldejsko ani phuv Hanaan. Al kana resle ano Haran, ačhile gothe te bešen.<verse eid="GEN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 11:32" />O Tara sasa džuvdo dujšel thaj pandž (205) berš thaj mulo ano Haran.<verse eid="GEN 11:32" /></para>
  <chapter eid="GEN 11" />
  <chapter number="12" style="c" sid="GEN 12" />
  <para style="s">O GOSPOD akharol e Avrame</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1" />O GOSPOD vaćarda e Avramese: “Dža andari ći phuv, tari ćiri familija thaj taro ćher će dadeso, thaj dža ani phuv savi me ka sikavav tuće.<verse eid="GEN 12:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="GEN 12:2" />‘Ka ćerav tutar bare narodo</para>
  <para style="q2" vid="GEN 12:2">thaj ka blagosloviv tut.</para>
  <para style="q1" vid="GEN 12:2">Ćo alav ka ćerav baro</para>
  <para style="q2" vid="GEN 12:2">thaj tu korkoro ka ave blagoslov!<verse eid="GEN 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 12:3" />Ka blagosloviv sa kolen</para>
  <para style="q2" vid="GEN 12:3">save tut blagoslovin,</para>
  <para style="q1" vid="GEN 12:3">armaja ka dav sa kolen</para>
  <para style="q2" vid="GEN 12:3">save tut den armaja.</para>
  <para style="q1" vid="GEN 12:3">Prekal tute ka aven blagoslovime</para>
  <para style="q2" vid="GEN 12:3">sa e narodura ki phuv.’”<verse eid="GEN 12:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="GEN 12:4" />Tegani o Avram đelo, sar so vaćarda lese o GOSPOD, a lesa đelo i o Lot. E Avrame sasa eftavardeš thaj pandž (75) berš kana pojdisada andaro Haran. <verse eid="GEN 12:4" /><verse number="5" style="v" sid="GEN 12:5" />O Avram lija pesa pe romnja e Saraja, pe phralese čhave e Lote, sa o barvalipe thaj e roburen saven steknisade ano Haran. Pojdisade ani phuv i Hanaansko thaj avile ane late. <verse eid="GEN 12:5" /><verse number="6" style="v" sid="GEN 12:6" />O Avram nakhlo i phuv sa dži ko than o Sihem, dži ko baro kaš o Morea. Ani goja phuv tegani bešena e Hanaancura.<verse eid="GEN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 12:7" />O GOSPOD sikadilo e Avramese thaj phenda: “Kaja phuv ka dav ćire potomstvose.”</para>
  <para style="m" vid="GEN 12:7">Gija o Avram gothe ćerda žrtveniko e GOSPODESE, savo sikadilo lese. <verse eid="GEN 12:7" /><verse number="8" style="v" sid="GEN 12:8" />Gothar đelo ke bregura save si istočno taro Betel, gothe putarda po šatori. O Betel sasa lese taro zapad a o Aj taro istok. Gothe o Avram ćerda žrtveniko e GOSPODESE thaj slavisada o alav e GOSPODESO. <verse eid="GEN 12:8" /><verse number="9" style="v" sid="GEN 12:9" />Pale gova putujisada o Avram taro than dži ko than premalo Negev.<verse eid="GEN 12:9" /></para>
  <para style="s">O Avram ano Egipat</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10" />Al kana avilo o bokhalipe ani goja phuv, o Avram ulilo ko Egipat te bešol odori nesavo vreme, golese kaj o bokhalipe sasa baro.<verse eid="GEN 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 12:11" />Al angleder te avol ano Egipat, vaćarda pe romnjaće e Sarajaće: “Šun, džanav kaj san but lačhi džuvli. <verse eid="GEN 12:11" /><verse number="12" style="v" sid="GEN 12:12" />Kana ka dićhen tut e Egipćanura, ka phenen: ‘Kava si lesi romni.’ Gija man ka mudaren, al tut ka ačhaven ko džuvdipe. <verse eid="GEN 12:12" /><verse number="13" style="v" sid="GEN 12:13" />Golese moliv tut, vaćar kaj san mi phen, te bi šukar mancar postupina baše tute thaj te araćhen mo džuvdipe.”<verse eid="GEN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 12:14" />Kana avilo o Avram ano Egipat, dikhlje e Egipćanura kaj si i Saraja but lačhi džuvli. <verse eid="GEN 12:14" /><verse number="15" style="v" sid="GEN 12:15" />Dikhlje la i e faraonese službenikura, pa hvalisade la anglo faraon. Gija e Saraja ande ane faraoneso dvor, te avol jekh tare faraonese romnja. <verse eid="GEN 12:15" /><verse number="16" style="v" sid="GEN 12:16" />O faraon šukar postupisada e Avramesa zbog i Saraja, pa o Avram steknisada bakren, guruven, heren, roburen, ropkinjen, hernjen thaj kamilen.<verse eid="GEN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 12:17" />Al o GOSPOD čalada nasvalimasa po faraon thaj pe savorende ano leso ćher baši Saraja, i romni e Avramesi. <verse eid="GEN 12:17" /><verse number="18" style="v" sid="GEN 12:18" />Tegani o faraon akharda e Avrame thaj pučlja le: “So ćerdan manđe? Sose ni vaćardan kaj voj si ći romni? <verse eid="GEN 12:18" /><verse number="19" style="v" sid="GEN 12:19" />Sose phendan: ‘Voj si mi phen,’ pa me lijem la romnjaće? Akh tuće akana ći romni, le la thaj dža!”<verse eid="GEN 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 12:20" />Tegani o faraon dija naredba pe manušenđe, a von ispratisade e Avrame lese romnjasa thaj sa lese barvalimasa.<verse eid="GEN 12:20" /></para>
  <chapter eid="GEN 12" />
  <chapter number="13" style="c" sid="GEN 13" />
  <para style="s">O Avram thaj o Lot ulaven pe</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1" />Gija o Avram đelo taro Egipat upre ano Negev pe romnjasa thaj sa pe barvalimasa, a lesa đelo thaj o Lot. <verse eid="GEN 13:1" /><verse number="2" style="v" sid="GEN 13:2" />A sasa o Avram but barvalo stokasa, srebrosa thaj zlatosa. <verse eid="GEN 13:2" /><verse number="3" style="v" sid="GEN 13:3" />Andaro Negev putujisada taro than dži o than sa dži o Betel, dži kova than maškaro Betel thaj o Aj kaj angleder sasa le šatori <verse eid="GEN 13:3" /><verse number="4" style="v" sid="GEN 13:4" />thaj kaj angleder ćerda o žrtveniko. Gothe o Avram slavisada o alav e GOSPODESO.<verse eid="GEN 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 13:5" />A i o Lot putujisada e Avramesa thaj sasa le bakre, guruva thaj robura. <verse eid="GEN 13:5" /><verse number="6" style="v" sid="GEN 13:6" />Goja phuv naštine te izdržil soldujen, golese kaj sasa len gaći but barvalipe kaj naštine te bešen katane. <verse eid="GEN 13:6" /><verse number="7" style="v" sid="GEN 13:7" />A avola dži e čingara maškar e čobanura e Avramese thaj e Lotese. Ane gova vreme ani goja phuv bešle i e Hanaancura thaj Perižanura.<verse eid="GEN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 13:8" />Golese o Avram phenda e Lotese: “Amen sam familija, golese ma te ćera čingara me thaj tu, ćire čobanura thaj mingre. <verse eid="GEN 13:8" /><verse number="9" style="v" sid="GEN 13:9" />Sa i phuv si tuće ko raspolaganje. Ulav tut mandar. Te đeljan levo, me ka džav desno. Te đeljan desno, me ka džav levo.”<verse eid="GEN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 13:10" />O Lot vazdija pe jakha thaj dikhlja kaj i dolina tari len o Jordan premali Coara si šukar natopime pajesa, sar o vrt e GOSPODESO il sar o Egipat. Kava sasa angleder so o GOSPOD uništisada i Sodoma thaj i Gomora. <verse eid="GEN 13:10" /><verse number="11" style="v" sid="GEN 13:11" />Golese o Lot birisada pese dolina i Jordansko thaj đelo ko istok. Gija uladile jekh averestar.<verse eid="GEN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 13:12" />O Avram živisada ani phuv i Hanaansko, a o Lot bešlo maškare forura ani dolina thaj buljarola pe šatora sa dži ki Sodoma. <verse eid="GEN 13:12" /><verse number="13" style="v" sid="GEN 13:13" />A e manuša ani Sodoma sesa but bilačhe thaj sesa bare grešnikura anglo GOSPOD.<verse eid="GEN 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14" />Kana o Lot ulada pe taro Avram, o GOSPOD phenda e Avramese: “Dikh tare kava than ko sever thaj ko jug, ko istok thaj ko zapad. <verse eid="GEN 13:14" /><verse number="15" style="v" sid="GEN 13:15" />Sa i phuv so dićhe, ka dav tuće thaj ćire potomkurenđe ane sa e đivesa. <verse eid="GEN 13:15" /><verse number="16" style="v" sid="GEN 13:16" />Ka ćerav će potomkura te aven sar o praho ki phuv. Ako šaj đinol pe o praho ki phuv, onda ka šaj đinen pe i ćire potomkura. <verse eid="GEN 13:16" /><verse number="17" style="v" sid="GEN 13:17" />Dža thaj nakh i phuv ke sa e riga, golese kaj ka dav la tuće.”<verse eid="GEN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 13:18" />Gija o Avram crdija piro šatori thaj đelo te bešol paše bare kašta e Mamrese, ano Hevron, thaj gothe ćerda žrtveniko e GOSPODESE.<verse eid="GEN 13:18" /></para>
  <chapter eid="GEN 13" />
  <chapter number="14" style="c" sid="GEN 14" />
  <para style="s">O Avram spasil e Lote</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1" />Ane gova vreme o Amrafel, caro taro Šinar, o Arioh, caro taro Elasar, o Kedarlaomer, caro taro Elam thaj o Tidal, caro taro Gojim, <verse eid="GEN 14:1" /><verse number="2" style="v" sid="GEN 14:2" />đele ano maripe protiv o Bera, caro tari Sodoma, o Birša, caro tari Gomora, o Šinar, caro tari Adma, o Šemever, caro taro Cevoim thaj protiv o caro tari Bela, savo si akana o Coar. <verse eid="GEN 14:2" /><verse number="3" style="v" sid="GEN 14:3" />Sa kala pandž carura ćidije pe ani dolina i Sidimsko, kaj si akana o Londo more. <verse eid="GEN 14:3" /><verse number="4" style="v" sid="GEN 14:4" />Von služisade e Kedarlaomere dešuduj (12) berš, al o dešutrito (13․) berš pobunisajle.<verse eid="GEN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 14:5" />Ko dešuštarto (14․) berš, o Kedarlaomer thaj e carura so sesa lesa ano savez, pobedisade e Rafajcuren ano Aštarot-Karnajim, e Zuzejcuren ano Ham, e Emijcuren ko polje Šava-Kirjatajim, <verse eid="GEN 14:5" /><verse number="6" style="v" sid="GEN 14:6" />thaj e Horejcuren ano gorsko krajo o Seir, sa dži ko El-Paran paši pustinja. <verse eid="GEN 14:6" /><verse number="7" style="v" sid="GEN 14:7" />Gothar okrenisajle thaj đele ano En-Mišpat, savo si Kadeš, pobedisade i phuv e Amalečanurenđi thaj e Amorejcuren save živisade ano Hacecon-Tamar.<verse eid="GEN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 14:8" />Tegani o caro tari Sodoma, o caro tari Gomora, o caro tari Adma, o caro taro Cevoim thaj o caro tari Bela, savi si Coar, iklile angle lende ani dolina i Sidimsko thaj lije te maren pe <verse eid="GEN 14:8" /><verse number="9" style="v" sid="GEN 14:9" />protiv o Kedarlaomer, caro taro Elam, protiv o Tidal, caro taro Gojim, protiv o Amrafel, caro taro Šinar, thaj protiv o Arioh, caro taro Elasar. Štar carura protiv pandž carura. <verse eid="GEN 14:9" /><verse number="10" style="v" sid="GEN 14:10" />Ani dolina i Sidimsko sesa but jame save sesa pherde katranesa, pa kana našle e carura tari Sodoma thaj i Gomora, pele ane lende, al avera našle ane bregura. <verse eid="GEN 14:10" /><verse number="11" style="v" sid="GEN 14:11" />E štar carura save pobedisade, lije sa o barvalipe tari Sodoma thaj tari Gomora, thaj sa lengo xape. Pale gova đele. <verse eid="GEN 14:11" /><verse number="12" style="v" sid="GEN 14:12" />A golese kaj o Lot, e Avramese phraleso čhavo, živisada ani Sodoma, zarobisade i le, sa kolesa so sasa le.<verse eid="GEN 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 14:13" />Jekh savo našlo, avilo thaj vaćarda e Avramese e Jevrejese, savo bešlo paše bare kašta e Mamrese. O Mamre sasa Amorejco, e Eškoleso thaj e Anereso phral. Von sesa ano savez e Avramesa. <verse eid="GEN 14:13" /><verse number="14" style="v" sid="GEN 14:14" />Kana šunda o Avram kaj zarobisade lese phralese čhave, ćidija bašo maripe pe vežbime manušen, trišel thaj dešohto (318) dženen save sesa bijande ane leso ćher, thaj đelo ani potera pale kola štar carura sa dži ko foro Dan. <verse eid="GEN 14:14" /><verse number="15" style="v" sid="GEN 14:15" />Prekali rat, o Avram lačharda pe manušen bašo napad thaj pobedisada pe dušmanuren. Tradija len sa dži ki Hova, savo si ki severno rig taro Damask.<verse eid="GEN 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 14:16" />Gija irisada sa o barvalipe. Irisada thaj e Lote, pe phralese čhave, lese barvalimasa, katane avere manušencar thaj e džuvljencar.<verse eid="GEN 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17" />Dži kaj o Avram irila pe pale gova so pobedisada e Kedarlaomere thaj e caruren save sesa lesa ano savez, o caro tari Sodoma iklilo angle leste ani dolina Šave, savi akhardol e Caresi dolina. <verse eid="GEN 14:17" /><verse number="18" style="v" sid="GEN 14:18" />Tegani o Melhisedek, caro taro Salim, ikalda mangro thaj mol. Vov sasa svešteniko e Embare Devleso <verse eid="GEN 14:18" /><verse number="19" style="v" sid="GEN 14:19" />thaj blagoslovisada e Avrame, vaćarindoj:</para>
  <para style="b" vid="GEN 14:19" />
  <para style="q1" vid="GEN 14:19">“Te blagoslovil e Avrame o Embaro Dol!</para>
  <para style="q2" vid="GEN 14:19">Kova so ćerda o nebo thaj i phuv.<verse eid="GEN 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="GEN 14:20" />Blagoslovimo te avol o Embaro Dol,</para>
  <para style="q2" vid="GEN 14:20">savo dija tut e dušmajen ane ćire vasta!”</para>
  <para style="b" vid="GEN 14:20" />
  <para style="m" vid="GEN 14:20">Tegani o Avram dija e Melhisedekese dešto kotor tare sa.<verse eid="GEN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 14:21" />O caro tari Sodoma vaćarda e Avramese: “De man e manušen, a o barvalipe ačhav tuće.”<verse eid="GEN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 14:22" />Al o Avram phenda lese: “Xav sovli anglo GOSPOD, anglo Embaro Dol, savo ćerda o nebo thaj i phuv, <verse eid="GEN 14:22" /><verse number="23" style="v" sid="GEN 14:23" />kaj ni ka lav ni thav, ni dorik tari obuća, ni khanči so si ćiro, te ma phene: ‘Me ćerdem e Avrame barvale.’ <verse eid="GEN 14:23" /><verse number="24" style="v" sid="GEN 14:24" />Manđe ni mangav khanči, sem kova so xalje mingre manuša thaj o kotor savo preperol e manušenđe save đele mancar – o Aner, o Eškol thaj o Mamre. Von nek len piro kotor.”<verse eid="GEN 14:24" /></para>
  <chapter eid="GEN 14" />
  <chapter number="15" style="c" sid="GEN 15" />
  <para style="s">E Devleso savez e Avramesa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1" />Pale kava sa so sasa, avilo e Avramese o lafi e GOSPODESO ani vizija:</para>
  <para style="b" vid="GEN 15:1" />
  <para style="q1" vid="GEN 15:1">“Ma dara, Avrame,</para>
  <para style="q2" vid="GEN 15:1">me sem ćo štit,</para>
  <para style="q1" vid="GEN 15:1">ka dav tut bari nagrada.”<verse eid="GEN 15:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="GEN 15:2" />Al o Avram phenda: “GOSPODE, Devla, so ka de man? Naj man čhave thaj mo nasledniko ka avol o Eliezer taro Damask.”<verse eid="GEN 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 15:3" />Vadži phenda o Avram: “Akh, manđe ni dijan čhaven, pa mo nasledniko ka avol robo savo bijandilo ane mo ćher.”<verse eid="GEN 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 15:4" />Tegani avilo lese o lafi e GOSPODESO: “Ni ka avol vov ćiro nasledniko, nego ćo bijando čhavo ka avol ćiro nasledniko.”<verse eid="GEN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 15:5" />Tegani ikalda e Avrame avral thaj phenda lese: “Dikh ano nebo thaj đin e čerenja, ako šaj te đine len. Gaći ka avol ćo potomstvo.”<verse eid="GEN 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 15:6" />O Avram pačaja e GOSPODESE thaj o Dol đinda leso pačajipe sar pravednost.<verse eid="GEN 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 15:7" />O GOSPOD phenda lese: “Me sem o GOSPOD, savo ikalda tut andaro Ur Haldejsko te dav tut kaja phuv te avol ćiri.”<verse eid="GEN 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 15:8" />Al vov pučlja le: “GOSPODE, Devla, sar ka džanav kaj ka avol kaja phuv mingri?”<verse eid="GEN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 15:9" />O GOSPOD phenda lese: “An manđe guruvnja tare trin berš, buznja tare trin berš, bakre tare trin berš, jekhe grlica thaj jekhe terne golubo.”<verse eid="GEN 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 15:10" />Vov sa gova lija, čhinda ke opaš thaj čhuta jekh prema aver. Samo e čirikljen ni čhinda ke opaš. <verse eid="GEN 15:10" /><verse number="11" style="v" sid="GEN 15:11" />Tegani e grabljivice lije te aven premale mule životinje, a o Avram tradija len.<verse eid="GEN 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 15:12" />Kana o kham lija te perol, e Avrame dolda zuralo sojipe, bari dar thaj jezivo kalipe.<verse eid="GEN 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 15:13" />Tegani o GOSPOD vaćarda e Avramese: “Te džane kaj ćire potomkura ka aven abandžije ane averenđi phuv. Ka postanin robura thaj ka aven zlostavime štaršel (400) berš. <verse eid="GEN 15:13" /><verse number="14" style="v" sid="GEN 15:14" />Al me ka kazniv e narodo kase von ka aven robura. Pale gova von gothar ka ikljen bare barvalimasa. <verse eid="GEN 15:14" /><verse number="15" style="v" sid="GEN 15:15" />Al tu ka ave džuvdo but berša, ka mere ano mir thaj ka ave prahome. <verse eid="GEN 15:15" /><verse number="16" style="v" sid="GEN 15:16" />Tek štarto kuštik tare ćire potomkura ka iril pe akari, golese kaj e grehura e Amorejska vadži ni barile gaći te bi šajine te aven kaznime.”<verse eid="GEN 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 15:17" />Kana o kham nakhlja thaj o kalipe pelo, tari jekh drom pojavisajlo čaro ane savo čurisade e angara thaj phabardi baklja, save nakhle maškare životinje save sesa čhinde ke opaš.<verse eid="GEN 15:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 15:18" />Ane gova đive o GOSPOD ćerda savez e Avramesa thaj vaćarda: “Će potomkurenđe ka dav kaja phuv, tari Egipatsko len dži ki bari len o Eufrat, <verse eid="GEN 15:18" /><verse number="19" style="v" sid="GEN 15:19" />i phuv i Kenejsko, i Kenezejsko, i Kadmonejsko, <verse eid="GEN 15:19" /><verse number="20" style="v" sid="GEN 15:20" />i Hetitejsko, i Perizejsko, i Refajsko, <verse eid="GEN 15:20" /><verse number="21" style="v" sid="GEN 15:21" />i Amorejsko, i Hanaansko, i Girgašansko thaj i Jevusejsko.”<verse eid="GEN 15:21" /></para>
  <chapter eid="GEN 15" />
  <chapter number="16" style="c" sid="GEN 16" />
  <para style="s">I Agara thaj o Jišmael</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1" />E Avramesi romni i Saraja ni bijanda lese čhaven. Al sasa la jekh ropkinja, Egipćanka, savi akhardola Agara. <verse eid="GEN 16:1" /><verse number="2" style="v" sid="GEN 16:2" />I Saraja phenda e Avramese: “Akh, o GOSPOD ni dija te aven man čhave. Dža ki mi ropkinja thaj sov lasa. Šaj ka aven man prekale late čhave.”</para>
  <para style="m" vid="GEN 16:2">Thaj o Avram šunda e Saraja. <verse eid="GEN 16:2" /><verse number="3" style="v" sid="GEN 16:3" />Tegani i Saraja lija pe ropkinja e Agara thaj dija la pe romese e Avramese te avol lesi romni. Gova sasa kana o Avram bešlo ani phuv i Hanaansko deš berš. <verse eid="GEN 16:3" /><verse number="4" style="v" sid="GEN 16:4" />Gija o Avram pašlilo e Agarasa thaj voj ačhili khamni. Kana i Agara dodžanglja kaj ačhili khamni, lija te avol barikani thaj te dićhol po tele pi Saraja.<verse eid="GEN 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 16:5" />Gija i Saraja phenda e Avramese: “Tu san bango baši kaja nepravda savi arakhlja man. Me andem me ropkinja ani ćiri angali, a voj, kana dikhlja kaj si khamni lija te dićhol po tele pe mande. O GOSPOD nek sudil maškare mande thaj tute.”<verse eid="GEN 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 16:6" />O Avram phenda e Sarajaće: “Akh, ći ropkinja si ane ćire vasta, ćer lasa so si ćiro manglipe.”</para>
  <para style="m" vid="GEN 16:6">I Saraja lija te ćerol e Agarasa bilačhe thaj voj našli latar.<verse eid="GEN 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 16:7" />Al o anđelo e GOSPODESO arakhlja e Agara ani pustinja pašo izvori e pajeso savo ikljol ko drom ano Šur <verse eid="GEN 16:7" /><verse number="8" style="v" sid="GEN 16:8" />thaj pučlja la: “Agaro, ropkinjo e Sarajaći, katar ave thaj kaj dža?”</para>
  <para style="m" vid="GEN 16:8">Voj phenda: “Našav tari Saraja, mi gospodarica.”<verse eid="GEN 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 16:9" />O anđelo e GOSPODESO phenda e Agaraće: “Iri tut ki ći gospodarica thaj pokori tut laće!” <verse eid="GEN 16:9" /><verse number="10" style="v" sid="GEN 16:10" />Thaj vadži vaćarda: “Ka ćerav ćire potomkuren te aven gaći but kaj ni ka šaj te đinen pe.” <verse eid="GEN 16:10" /><verse number="11" style="v" sid="GEN 16:11" />Thaj vadži phenda laće o anđelo e GOSPODESO:</para>
  <para style="q1" vid="GEN 16:11">“Akh, tu san khamni</para>
  <para style="q2" vid="GEN 16:11">thaj ka bijane čhave.</para>
  <para style="q1" vid="GEN 16:11">Ka de le alav Jišmael,</para>
  <para style="q2" vid="GEN 16:11">golese kaj o Dol šunda baše ćiro pharipe.<verse eid="GEN 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 16:12" />Vov ka avol sar divljo her,</para>
  <para style="q2" vid="GEN 16:12">ka vazdol po va pe svakoneste</para>
  <para style="q1" vid="GEN 16:12">thaj svako ka vazdol po va pe leste,</para>
  <para style="q2" vid="GEN 16:12">sa pe phralencar ka živil ano dušmanluko.”<verse eid="GEN 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 16:13" />Tegani i Agara e GOSPODE, savo vaćarda lasa, dija vika El Roi<note caller="+" style="f"><char style="fr" closed="false">16,13 </char><char style="fq" closed="false">El Roi </char><char style="ft" closed="false">Akava značil: “Dol savo dićhol man”.</char></note>, golese so phenda: “Akate dikhljem kole savo man dićhol.” <verse eid="GEN 16:13" /><verse number="14" style="v" sid="GEN 16:14" />Golese kava bunari akhardol Beer-Lahaj-Roi<note caller="+" style="f"><char style="fr" closed="false">16,14 </char><char style="fq" closed="false">Beer-Lahaj-Roi </char><char style="ft" closed="false">Akava značil: “Bunari e Džuvdeso, savo dićhol man”.</char></note>. Gova bunari si maškaro Kadeš thaj o Bered.<verse eid="GEN 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 16:15" />Gija i Agara bijanda e Avramese čhave thaj o Avram dija le alav Jišmael. <verse eid="GEN 16:15" /><verse number="16" style="v" sid="GEN 16:16" />E Avrame sasa ohtovardeš thaj šov (86) berš kana i Agara bijanda lese e Jišmaele.<verse eid="GEN 16:16" /></para>
  <chapter eid="GEN 16" />
  <chapter number="17" style="c" sid="GEN 17" />
  <para style="s">Obrezanje – znako taro Savez</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1" />Kana sasa e Avrame enjavardeš thaj enja (99) berš, o GOSPOD sikadilo lese thaj vaćarda: “Me sem o Emzuralo Dol<note caller="+" style="f"><char style="fr" closed="false">17,1 </char><char style="ft" closed="false">Ano original si: “El Šadaj.”</char></note>. Živi pale mingro manglipe thaj av besprekorno. <verse eid="GEN 17:1" /><verse number="2" style="v" sid="GEN 17:2" />Ka phandav savez maškar mande thaj tute, thaj ka dav tut but potomkura.”<verse eid="GEN 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 17:3" />O Avram pelo mujesa dži i phuv, a o Dol phenda lese: <verse eid="GEN 17:3" /><verse number="4" style="v" sid="GEN 17:4" />“Kava si mingro savez tusa: Ka ave dad bute narodurenđe. <verse eid="GEN 17:4" /><verse number="5" style="v" sid="GEN 17:5" />Golese ćo alav ni ka avol vadži Avram, nego ćo alav ka avol Avraam, golese kaj ćerdem tut dad bute narodurengo. <verse eid="GEN 17:5" /><verse number="6" style="v" sid="GEN 17:6" />Ka dav tut but potomkura, tutar ka postanin narodura thaj ka aven tutar e carura. <verse eid="GEN 17:6" /><verse number="7" style="v" sid="GEN 17:7" />Ka ćerav savez tusa thaj će potomkurencar tari koč dži i koč, savez ane sa e đivesa, thaj ka avav o Dol ćiro thaj o Dol ćire potomkurengo. <verse eid="GEN 17:7" /><verse number="8" style="v" sid="GEN 17:8" />Ane sa e đivesa ka dav tuće thaj će potomkurenđe i phuv i Hanaansko, ani savi tu akana beše sar abandžija, thaj ka avav lengo Dol.”<verse eid="GEN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 17:9" />Tegani o Dol phenda e Avraamese: “A tu ićar tut pe mingro savez, tu, ćire potomkura tari koč dži ki koč! <verse eid="GEN 17:9" /><verse number="10" style="v" sid="GEN 17:10" />Kava si mingro savez tusa thaj ćire potomkurencar, savez pe savo ka ićaren tumen: nek avol obrezimo svako murš maškar tumende. <verse eid="GEN 17:10" /><verse number="11" style="v" sid="GEN 17:11" />Obrezin tumen thaj gova ka avol znako taro savez maškar mande thaj tumende. <verse eid="GEN 17:11" /><verse number="12" style="v" sid="GEN 17:12" />Dži jekh murš čhavoro maškar tumende nek avol obrezimo ko ohtoto đive palo bijandipe, tari koč dži ki koč, a gija thaj dži jekh robo savo si bijando ano tumaro ćher, il si ćindo tare abandžije, savo naj ćiro potomko. <verse eid="GEN 17:12" /><verse number="13" style="v" sid="GEN 17:13" />Dal si bijando ano ćiro ćher il ćindo parencar, mora te avol obrezimo. Gija pe tumaro telo ka avol znako kaj mingro savez si ane sa e đivesa. <verse eid="GEN 17:13" /><verse number="14" style="v" sid="GEN 17:14" />Dži jekh biobrezimo murš, savo ni ćerol obrezanje, nek avol čhudimo tare ćiro narodo, golese kaj phaglja mingro savez.”<verse eid="GEN 17:14" /></para>
  <para style="s">O Dol obećil e Isaako</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 17:15" />Thaj vadži o Dol phenda e Avraamese: “Će romnja ma akhar vadži Saraja, lako alav ka avol Sara.<verse eid="GEN 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 17:16" />Me ka blagosloviv la thaj ka dav tut čhave latar. Ka blagosloviv la thaj voj ka postanil dej e narodurenđe. Latar ka ikljon e carura e manušenđe.”<verse eid="GEN 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 17:17" />Tegani o Avraam pelo mujesa dži ki phuv, asaja thaj dija gođi: “Dal e manušese tare šel (100) berš ka bijandol čhavoro? Dal i Sara ka bijanol čhavore ane enjavardeš (90) berš?”<verse eid="GEN 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 17:18" />O Avraam vaćarda e Devlese: “Nek o Jišmael lol gova blagoslov!”<verse eid="GEN 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 17:19" />Al o Dol phenda: “Na, ći romni i Sara ka bijanol tuće murše čhave, a tu ka de le alav Isaak. Ka phandav lesa thaj lese potomkurencar savez ane sa e đivesa. <verse eid="GEN 17:19" /><verse number="20" style="v" sid="GEN 17:20" />Šundem so rodijan zako Jišmael. Akh, ka blagosloviv le, ka dav le but potomkura thaj ka ćerav len te aven but. Ka bijandon lese dešuduj (12) vladara thaj ka ćerav lestar baro narodo. <verse eid="GEN 17:20" /><verse number="21" style="v" sid="GEN 17:21" />Al mingro savez ka phandav e Isaakosa, kas ka bijanol i Sara aver berš ane kava vreme.”<verse eid="GEN 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 17:22" />Kana završisada o Dol te vaćarol e Avraamesa, o Dol vazdija pe lestar.<verse eid="GEN 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 17:23" />Gova đive lija o Avraam e Jišmaele pe čhave thaj sa e roburen save sesa bijande ane leso ćher thaj saven ćinda parenđe, sa e muršen tare po ćher, thaj ćerda obrezanje lencar, gija sar so vaćarda lese o Dol. <verse eid="GEN 17:23" /><verse number="24" style="v" sid="GEN 17:24" />A e Avraame sasa enjavardeš thaj enja (99) berš kana sunetisajlo, <verse eid="GEN 17:24" /><verse number="25" style="v" sid="GEN 17:25" />a lese čhave, e Jišmaele, sasa dešutrin (13) berš. <verse eid="GEN 17:25" /><verse number="26" style="v" sid="GEN 17:26" />Gija o Avraam thaj leso čhavo o Jišmael, sunetisajle ano isto đive, <verse eid="GEN 17:26" /><verse number="27" style="v" sid="GEN 17:27" />a lencar sa e murša save sesa bijande ane Avraameso ćher thaj i kola save sesa ćinde parencar tare abandžije.<verse eid="GEN 17:27" /></para>
  <chapter eid="GEN 17" />
  <chapter number="18" style="c" sid="GEN 18" />
  <para style="s">Trin anđelura posetin e Avraame</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1" />O GOSPOD sikadilo e Avraamese paše bare kašta e Mamrese, kana bešlo anglo vudar e šatoreso ko opašo đive kana si embaro tatipe.<verse eid="GEN 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 18:2" />O Avraam vazdija pe jakha thaj dikhlja trin džene sar ačhen po dur lestar. Kana dikhlja len, prastija taro vudar e šatoreso premale lende, thaj pelo mujesa dži ki phuv angle lende. <verse eid="GEN 18:2" /><verse number="3" style="v" sid="GEN 18:3" />Phenda: “Gospode, te arakhljem milost ane će jakha, ma te naćhe paše ćiro sluga, a te ma iri ke mande. <verse eid="GEN 18:3" /><verse number="4" style="v" sid="GEN 18:4" />Te anol pe tumenđe zala paj, te thoven tumare pingre, thaj te navalin tumen tale kava kaš. <verse eid="GEN 18:4" /><verse number="5" style="v" sid="GEN 18:5" />Ka anav zala mangro, te šaj zuravon thaj tegani ka džan. Golese aviljen ke tumaro sluga.”</para>
  <para style="m" vid="GEN 18:5">Von phende lese: “Šukar, ćer sar so vaćardan.”<verse eid="GEN 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 18:6" />O Avraam siđarda ano šatori ki Sara thaj phenda: “Sigate le dešupandž (15) kila aro, ćer humer thaj pek pogače.”<verse eid="GEN 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 18:7" />Pale gova prastija dži e guruva thaj dolda terne thule guruve, thaj dija le e slugase sigate te spremin le xamase. <verse eid="GEN 18:7" /><verse number="8" style="v" sid="GEN 18:8" />Tegani ikalda ćiral, thud thaj e terne guruve save spremisada, thaj čhuta angle lende. O Avraam ačhilo angle lende talo kaš sa dži kaj xalje.<verse eid="GEN 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 18:9" />Pale gova pučlje le: “Kaj ći romni i Sara?”</para>
  <para style="p" vid="GEN 18:9">Vov phenda: “Ek, ano šatori.”<verse eid="GEN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 18:10" />A jekh maškare lende, o Gospod, phenda: “Aver berš ane kava vreme palem ka avav tute, a i Sara ći romni ka avola čhavo.”</para>
  <para style="p" vid="GEN 18:10">I Sara šunda gova palo vudar e šatoreso savo sasa pale leste. <verse eid="GEN 18:10" /><verse number="11" style="v" sid="GEN 18:11" />O Avraam thaj i Sara sesa purane thaj bute beršenđe. Thaj ani Sara ačhilo kova so avol pe late svako čhon.<verse eid="GEN 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 18:12" />Golese i Sara asaja ane peste thaj dija gođi: “Akana li ka avol manđe o radost, kana phuraljem? A i mo rom si purano.”<verse eid="GEN 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 18:13" />Tegani o GOSPOD pučlja e Avraame: “Sose asal i Sara vaćarindoj: ‘Čače li kaj ka bijanav akana kana phuraljem?’ <verse eid="GEN 18:13" /><verse number="14" style="v" sid="GEN 18:14" />Isi li khanči pharo e GOSPODESE? Aver berš ane kava vreme ka avav tute, a e Sara ka avol čhavo.”<verse eid="GEN 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 18:15" />Al i Sara xoxada vaćarindoj: “Ni asajem,” golese so darajli.</para>
  <para style="p" vid="GEN 18:15">A o GOSPOD phenda: “Va, čače, asajan.”<verse eid="GEN 18:15" /></para>
  <para style="s">O GOSPOD vaćarol e Avraamesa tari Sodoma</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16" />Kana gola manuša uštile te džan gothar, dikhlje premali Sodoma, a o Avraam pojdisada lencar te ispratil len.<verse eid="GEN 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 18:17" />O GOSPOD phenda ane peste: “Dal taro e Avraam te garavav so ka ćerav? <verse eid="GEN 18:17" /><verse number="18" style="v" sid="GEN 18:18" />Taro Avraam ka avol baro thaj zuralo narodo thaj prekal leste ka aven blagoslovime sa e narodura ki phuv. <verse eid="GEN 18:18" /><verse number="19" style="v" sid="GEN 18:19" />Golese so, me birisadem le te sikavol pe čhaven thaj pe potomkuren te ićaren pe po drom e GOSPODESO thaj te ćeren sar so si ispravno thaj pravedno. Gija me, o GOSPOD, ka ćerav sa so obećisadem e Avraamese.”<verse eid="GEN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 18:20" />Tegani o GOSPOD phenda: “Bare si tužbe protiv i Sodoma thaj i Gomora, thaj lenđe grehura si but bare. <verse eid="GEN 18:20" /><verse number="21" style="v" sid="GEN 18:21" />Ka uljav odori te dikhav čače li si gova so šundem, ćeren li gova il na. Mangav te džanav.”<verse eid="GEN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 18:22" />Pale gova e duj džene gothar pojdisade premal i Sodoma, al o Avraam vadži ačhilo anglo GOSPOD.<verse eid="GEN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 18:23" />Tegani avilo paše leste o Avraam thaj pučlja le: “Čače li ka mudare e pravednonen katane e grešnikurencar? <verse eid="GEN 18:23" /><verse number="24" style="v" sid="GEN 18:24" />So ako isi pinda (50) pravednikura ano foro? Čače li ka uništi gova than? Ni li ka oprosti gole thanese baše gola pinda (50) pravednikura so si ane leste? <verse eid="GEN 18:24" /><verse number="25" style="v" sid="GEN 18:25" />Pa ne bi ćeresa gija khanči. Ne bi mudaresa e pravednikuren katane e grešnikurencar, pa isto te naćhen e pravednikura thaj e grešnikura. Sigurno ni ka ćere gova! Dal o Sudija celone svetoso ni ka postupil pravedno?”<verse eid="GEN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 18:26" />O GOSPOD phenda: “Te arakhljem pinda (50) pravednikura ani Sodoma, zbog lende ka oprostiv celone forose.”<verse eid="GEN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 18:27" />Tegani o Avraam phenda: “Džanav kaj sem prašina thaj praho thaj usudiv man te vaćarav e Gospodese. <verse eid="GEN 18:27" /><verse number="28" style="v" sid="GEN 18:28" />So te si pravednikura pandž po zala tare pinda? Ka uništi li sa o foro zbog kala saranda thaj pandž (45)?”</para>
  <para style="p" vid="GEN 18:28">O GOSPOD irisada lese: “Na, te arakhljem saranda thaj pandž pravednikuren, ni ka uništiv o foro.”<verse eid="GEN 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 18:29" />O Avraam pale pučlja: “A te šaj araćhen pe odori samo saranda (40)?”</para>
  <para style="p" vid="GEN 18:29">O GOSPOD vaćarda: “Ni ka uništiv le zbog kola saranda.”<verse eid="GEN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 18:30" />Tegani phenda o Avraam: “Ma te holjavol o Gospod so ka pučav le. So te šaj araćhen pe odori samo tranda (30)?”</para>
  <para style="p" vid="GEN 18:30">O GOSPOD phenda e Avraamese: “Ni ka uništiv le, te arakhljem tranda.”<verse eid="GEN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 18:31" />Tegani phenda o Avraam: “Akh, usudiv man te vaćarav e Gospodese. So te šaj araćhen pe odori samo biš (20)?”</para>
  <para style="p" vid="GEN 18:31">O GOSPOD vaćarda: “Ni ka uništiv le zbog kola biš.”<verse eid="GEN 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 18:32" />O Avraam palem phenda: “Ma te holjavol o Gospod, nek mućhol man vadži jekh drom te pučav. So te šaj araćhen pe odori samo deš (10)?”</para>
  <para style="p" vid="GEN 18:32">O GOSPOD phenda lese: “Ni ka uništiv gova foro zbog kola deš pravednikura.”<verse eid="GEN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 18:33" />Kana o GOSPOD završisada te vaćarol e Avraamesa, đelo thaj o Avraam irisajlo ćhere.<verse eid="GEN 18:33" /></para>
  <chapter eid="GEN 18" />
  <chapter number="19" style="c" sid="GEN 19" />
  <para style="s">E Sodomako thaj e Gomorako uništipe</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1" />Tegani ani rat avile kola duj anđelura ani Sodoma. O Lot bešlo ke forosi kapija, thaj kana dikhlja len, uštilo, đelo te resol len thaj pelo angle lende mujesa dži ki phuv.<verse eid="GEN 19:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 19:2" />O Lot phenda: “Moliv tumen, gospodaralen, aven ano ćher tumare slugaso te raćaren thaj te thoven tumare pingre, a theara ko sabalje nastavin tumaro drom.”</para>
  <para style="p" vid="GEN 19:2">Von phende lese: “Na, ka raćara ko trgo.”<verse eid="GEN 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 19:3" />Al o Lot sasa gaći uporno kaj đele leste. Dije ane leso ćher thaj vov ćerda lenđe xape. Peklja bikvascose mangre thaj xalje.<verse eid="GEN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 19:4" />Angleder nego te džan te soven, sa e murša tari Sodoma, tare sa e kotora e forose, e purane thaj e terne, avile trujal e Loteso ćher. <verse eid="GEN 19:4" /><verse number="5" style="v" sid="GEN 19:5" />Dije vika e Lote thaj pučlje le: “Kaj e murša so avile erat tute? Ikal len amenđe te sova lencar!”<verse eid="GEN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 19:6" />Tegani o Lot iklilo angle lende, phanglja o vudar pale peste <verse eid="GEN 19:6" /><verse number="7" style="v" sid="GEN 19:7" />thaj phenda: “Moliv tumen, amalalen, ma ćeren kava bilačhipe! <verse eid="GEN 19:7" /><verse number="8" style="v" sid="GEN 19:8" />Akh, isi man duj čheja, save vadži ni džanen muršese. Len ka ikalav tumenđe thaj ćeren lencar so manđen. Al kale muršenđe ma ćeren khanči bilačhe, golese so si talo mingro krovo thaj tali mingri zaštita.”<verse eid="GEN 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 19:9" />Al e manuša dije vika pe leste: “Crde tut gothar! Tu aviljan kate sar abandžija, a već manđe te ave amaro sudija! Akana amen ka ćera tusa pobilačhe nego lencar!”</para>
  <para style="p" vid="GEN 19:9">Thaj zurale gurisade e Lote thaj lije te phađen o vudar. <verse eid="GEN 19:9" /><verse number="10" style="v" sid="GEN 19:10" />Al kola duj anđelura pružisade pe vasta avri, dolde e Lote, crdije le andre ano ćher thaj phanglje o vudar. <verse eid="GEN 19:10" /><verse number="11" style="v" sid="GEN 19:11" />A e muršen so sesa anglo vudar, e ternen thaj e puranen, ćerde te aven kore, pa gija naštine te araćhen o vudar.<verse eid="GEN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 19:12" />Tegani kola duj anđelura pučlje e Lote: “Isi li tut vadži khoni akate? Džamutren, čhaven il čhejen, il khanika avere savo si ćiro ane kava foro? Ikal len akatar! <verse eid="GEN 19:12" /><verse number="13" style="v" sid="GEN 19:13" />Golese so amen ka uništi kava than. I tužba protiv kala manuša barili gaći anglo GOSPOD kaj bičhalda amen te uništi len.”<verse eid="GEN 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 19:14" />Tegani iklilo o Lot te vaćarol e muršencar save trubuje te aven lese džamutre thaj phenda lenđe: “Sigate! Ikljen tare kava than, golese kaj o GOSPOD ka uništil le!” Al lese džamutre dije gođi kaj o Lot šalil pe.<verse eid="GEN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 19:15" />Kana đivesajlo, e anđelura dije zor e Lote te siđarol vaćarindoj: “Sigate! Ikal će romnja thaj će duje čhejen save si akate, te ma aven uništime i tumen kana ka avol kaznimo kava foro.”<verse eid="GEN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 19:16" />Al o Lot ađućarda. Golese kola duj anđelura lije tare vasta e Lote, lese romnja thaj lese duje čhejen thaj ikalde len andaro foro, golese kaj o GOSPOD lenđe smiluisajlo. <verse eid="GEN 19:16" /><verse number="17" style="v" sid="GEN 19:17" />Kana ikalde len andaro foro, jekh lendar phenda: “Našen te bi spasina tumen! Ma irin tumen palal, ni ma ačhen khatinde ani dolina! Našen ane bregura, te ma aven uništime!”<verse eid="GEN 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 19:18" />Al o Lot phenda: “Na, moliv tut, gospodarona! <verse eid="GEN 19:18" /><verse number="19" style="v" sid="GEN 19:19" />Me, ćiro sluga, arakhljem baro manglipe ane ćire jakha thaj tu sikadan manđe baro manglipe kana spasisadan mo džuvdipe. Al, me našti našav ane bregura, kava bilačhipe ka resol man thaj ka mudardivav. <verse eid="GEN 19:19" /><verse number="20" style="v" sid="GEN 19:20" />Nego, eke odori foro savo si paše, te šaj našav ane leste, kova foro si čače cikno. De man te našav odori te spasiv mo džuvdipe!”<verse eid="GEN 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 19:21" />Vov phenda lese: “Šukar, ka uslišiv tuće i kaja molba thaj ni ka uništiv o foro taro savo vaćare. <verse eid="GEN 19:21" /><verse number="22" style="v" sid="GEN 19:22" />Sigate! Naš odori, golese kaj našti ćerav khanči dok ni rese odori.” Golese gova foro dol pe vika Coar.<verse eid="GEN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23" />Kana o Lot dija ano Coar, o kham već iklilo. <verse eid="GEN 19:23" /><verse number="24" style="v" sid="GEN 19:24" />Tegani o GOSPOD čhorda taro nebo pi Sodoma thaj pi Gomora sumpor thaj jag. <verse eid="GEN 19:24" /><verse number="25" style="v" sid="GEN 19:25" />Uništisada gola forura thaj sa goja dolina, sa e manušen ane gola forura thaj sa so barilo andari phuv.<verse eid="GEN 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 19:26" />Al i romni e Lotesi irisajli palal te dićhol, thaj ćerdili ano stubo taro lon.<verse eid="GEN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 19:27" />Ki sabalin uštilo rano o Avraam thaj đelo ko than kaj angleder ačhola anglo GOSPOD. <verse eid="GEN 19:27" /><verse number="28" style="v" sid="GEN 19:28" />Dikhlja premal i Sodoma thaj i Gomora thaj sa trujal i dolina, thaj dikhlja sar vazdol pe čuro tari phuv sar čuro tari bari kubava.<verse eid="GEN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 19:29" />Gija, kana o Dol uništisada e forura ani dolina, dija gođi po obećanje savo dija e Avraamese thaj ikalda e Lote angleder nego so sesa uništime gola forura kaj bešola.<verse eid="GEN 19:29" /></para>
  <para style="s">E Lotese čheja</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30" />Pale gova o Lot iklilo taro Coar pe duje čhejencar thaj đelo te bešol ane bregura, golese kaj darajlo te ačhol ano Coar. Vov bešlo ani pećina pe duje čhejencar.<verse eid="GEN 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 19:31" />Jekh đive, i phureder phenda e ternjaće: “Amaro dad si purano, a naj khatinde murša te aven amare roma thaj te aven amen čhave lencar, sar so si adeti ano sa o sveto. <verse eid="GEN 19:31" /><verse number="32" style="v" sid="GEN 19:32" />Ajde te matara e dade e moljasa, pa ka sova lesa, te arakha o potomstvo amare dadeso.” <verse eid="GEN 19:32" /><verse number="33" style="v" sid="GEN 19:33" />Gija, goja rat matarde pe dade moljasa. Pale gova avili i phureder thaj suta lesa. Al o Lot ni džanglja ni kana pašlili lesa ni kana uštili.<verse eid="GEN 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 19:34" />Theara đive i phureder phenda e ternjaće: “Dikh, erat sutem amare dadesa me. Ajde erat palem te matara amare dade, thaj tu ka dža te sove lesa, te bi arakhasa o potomstvo amare dadeso.”<verse eid="GEN 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 19:35" />Gija i goja rat dije mol pe dade. Uštili i poterni čhej thaj suta lesa. Al o Lot ni džanglja ni kana pašlili lesa ni kana uštili.<verse eid="GEN 19:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 19:36" />Gija solduj čheja e Lotese ačhile khamne tare po dad. <verse eid="GEN 19:36" /><verse number="37" style="v" sid="GEN 19:37" />I phureder bijanda čhave thaj dija le alav Moav. Vov si paradad tare avđivesutne Moavcura. <verse eid="GEN 19:37" /><verse number="38" style="v" sid="GEN 19:38" />Thaj i poterni čhej bijanda čhave thaj dija le alav Ben-Ami. Vov si paradad tare avđivesutne Amoncura.<verse eid="GEN 19:38" /></para>
  <chapter eid="GEN 19" />
  <chapter number="20" style="c" sid="GEN 20" />
  <para style="s">O Avraam thaj o Avimeleh</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1" />O Avraam đelo gothar ani pustinja Negev thaj bešlo maškaro Kadeš thaj o Šur. Nesavo vreme bešola sar abandžija ano Gerar. <verse eid="GEN 20:1" /><verse number="2" style="v" sid="GEN 20:2" />Tegani, e manušenđe vaćarda baši pi romni i Sara: “Mi phen si.” Gija o Avimeleh, o caro taro Gerar, bičhalda pali Sara thaj lija la romnjaće.<verse eid="GEN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 20:3" />Al raćasa avilo o Dol ko suno e Avimelehese thaj phenda lese: “Ka mere zbog kaja romni sava lijan, golese kaj isi la rom.”<verse eid="GEN 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 20:4" />O Avimeleh vadži ni suta lasa, golese phenda: “Gospode, me ni ćerdem khanči bilačhe! Dal ka mudare man thaj me narodo? <verse eid="GEN 20:4" /><verse number="5" style="v" sid="GEN 20:5" />Na li o Avraam korkoro phenda: ‘Mi phen si’? Ni li voj korkori phenda: ‘Mo phral si’? Ćerdem gova taro thodo savest thaj ni meljardem me vasta.”<verse eid="GEN 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 20:6" />Tegani o Dol phenda e Avimelehese ano suno: “Va, džanav kaj ćerdan gova thode savestesa, golese arakhljem tut te ma greši protiv mande, thaj golese ni dijem te dole tut pe late. <verse eid="GEN 20:6" /><verse number="7" style="v" sid="GEN 20:7" />Akana iri gole manušese lese romnja. Vov si proroko thaj ka molil pe tuće te ačhe džuvdo. Al te ni irisadan la, te džane kaj ka mere tu thaj i sa ćire manuša.”<verse eid="GEN 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 20:8" />O Avimeleh sabalin uštilo rano thaj dija vika sa pe službenikuren. Kana phenda lenđe sa so sasa, von but darajle.<verse eid="GEN 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 20:9" />Tegani o Avimeleh akharda e Avraame thaj pučlja le: “So ćerdan amenđe? So ćerdem tuće te čhuve gasavo baro greh pe mande thaj pe mo carstvo? Ćerdan manđe kova so ni trubul te ćere!”<verse eid="GEN 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 20:10" />Thaj vadži o Avimeleh pučlja e Avraame: “Sose ćerdan gova?”<verse eid="GEN 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 20:11" />O Avraam phenda lese: “Dijem gođi: ‘Ane kava than sigurno ni daran taro Dol thaj ka mudaren man zbog mi romni.’ <verse eid="GEN 20:11" /><verse number="12" style="v" sid="GEN 20:12" />A i čače si mi phen, čhej me dadesi, al naj čhej me daći. Thaj postanisada mi romni. <verse eid="GEN 20:12" /><verse number="13" style="v" sid="GEN 20:13" />Kana o Dol phenda te ikljav andaro ćher me dadeso, me phendem laće: ‘Gija ka sikave ćo manglipe premal mande: Bilo kaj dža, vaćar kaj sem ćo phral.’”<verse eid="GEN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 20:14" />Tegani o Avimeleh e Avraamese dija bakren, guruven, roburen thaj ropkinjen. Irisada lese i lese romnja e Sara. <verse eid="GEN 20:14" /><verse number="15" style="v" sid="GEN 20:15" />Thaj o Avimeleh phenda e Avraamese: “Akh, mi phuv si tuće putardi, beš kaj manđe.” <verse eid="GEN 20:15" /><verse number="16" style="v" sid="GEN 20:16" />A e Saraće phenda: “Akh, dijem će phralese milja (1 000) srebrenjakura. Gova ka avol dokaz savorenđe save si tusa kaj san nedužno. Slobodno san tare bilo savi optužba.”<verse eid="GEN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 20:17" />Tegani o Avraam molisajlo e Devlese thaj o Dol sastarda e Avimelehe, lese romnja thaj lese ropkinjen, te šaj pale bijanen. <verse eid="GEN 20:17" /><verse number="18" style="v" sid="GEN 20:18" />Golese kaj o GOSPOD dži jekha džuvlja ane Avimeleheso ćher phanglja te našti bijanen zbog e Avraamesi romni i Sara.<verse eid="GEN 20:18" /></para>
  <chapter eid="GEN 20" />
  <chapter number="21" style="c" sid="GEN 21" />
  <para style="s">Bijandilo o Isaak</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1" />O GOSPOD blagoslovisada e Sara, thaj ćerda laće sar so obećisada. <verse eid="GEN 21:1" /><verse number="2" style="v" sid="GEN 21:2" />I Sara ačhili khamni thaj bijanda e Avraamese čhave ane leso phuripe thaj ane gova vreme kana o Dol phenda lese. <verse eid="GEN 21:2" /><verse number="3" style="v" sid="GEN 21:3" />E čhavese save bijanda i Sara, o Avraam dija alav Isaak.<verse eid="GEN 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 21:4" />Kana o Isaak pherda ohto đive, o Avraam ćerda lese obrezanje, sar so zapovedisada lese o Dol. <verse eid="GEN 21:4" /><verse number="5" style="v" sid="GEN 21:5" />E Avraame sesa šel (100) berš kana bijandilo leso čhavo o Isaak.<verse eid="GEN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 21:6" />I Sara phenda: “O Dol ćerda te asav, thaj savore save šunen tare kava, ka asan mancar.” <verse eid="GEN 21:6" /><verse number="7" style="v" sid="GEN 21:7" />Thaj vadži phenda: “Ko šajine te phenol e Avraamese kaj i Sara ka dol e čhavoren te pijen čuči? Al ake, bijandem lese čhave ane leso phuripe.” <verse eid="GEN 21:7" /><verse number="8" style="v" sid="GEN 21:8" />O čhavo barilo thaj ačhada te pijol čuči. Thaj ane gova đive, kana o Isaak ačhada te pijol čuči, o Avraam ćerda bari gozba.<verse eid="GEN 21:8" /></para>
  <para style="s">I Agara thaj o Jišmael</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 21:9" />Tegani i Sara dikhlja sar o Jišmael, save bijanda i Agara i Egipćanka e Avraamese, marol muj e Isaakosa, <verse eid="GEN 21:9" /><verse number="10" style="v" sid="GEN 21:10" />thaj phenda e Avraamese: “Trade kala ropkinja thaj laće čhave, golese kaj lako čhavo našti avol nasledniko me čhavesa e Isaakosa!”<verse eid="GEN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 21:11" />Gova ćerda bari dukh ano ilo e Avraamese, golese so o Jišmael sasa leso čhavo. <verse eid="GEN 21:11" /><verse number="12" style="v" sid="GEN 21:12" />Al o Dol phenda e Avraamese: “Ma te avol tut dukh ano ilo bašo čhavoro thaj baši ćiri ropkinja. Šun sa so ka phenol tuće i Sara, golese so taro Isaak ka đinol pe ćiro potomstvo. <verse eid="GEN 21:12" /><verse number="13" style="v" sid="GEN 21:13" />Al i taro čhavo e ropkinjako ka ćerav narodo, golese so i vov si ćiro potomko.”<verse eid="GEN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 21:14" />O Avraam uštilo rano ki sabalin, lija xape thaj morčhi pajesa thaj dija e Agaraće. Gova čhuta laće ko dumo thaj mukhlja la te džal e čhavesa. Voj đeli thaj phirola akari okori maškari pustinja i Beer-Ševa. <verse eid="GEN 21:14" /><verse number="15" style="v" sid="GEN 21:15" />Kana ni sasa vadži paj ani morčhi, voj čhuta e čhave talo jekh žbuno. <verse eid="GEN 21:15" /><verse number="16" style="v" sid="GEN 21:16" />Tegani đeli te bešol podur lestar, paše šel (100) metra, golese kaj dija gođi: “Našti te dikhav sar ka merol o čhavoro.” Thaj sar bešli gija, lija zurale te rovol.<verse eid="GEN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 21:17" />Al o Dol šunda sar o čhavoro rovol, thaj o anđelo e Devleso dija vika taro nebo e Agara thaj phenda: “So si, Agaro? Ma dara, golese kaj o Dol šunda sar o čhavoro rovol odori. <verse eid="GEN 21:17" /><verse number="18" style="v" sid="GEN 21:18" />Ušti, vazde e čhavore thaj uteši le, golese kaj ka ćerav bare narodo lestar.” <verse eid="GEN 21:18" /><verse number="19" style="v" sid="GEN 21:19" />Tegani o Dol putarda laće jakha thaj voj dikhlja izvori e pajesa. Đeli te pherol i morčhi pajesa thaj dija e čhave te pijol.<verse eid="GEN 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 21:20" />O Dol sasa e čhavesa sar vov barola. O čhavo živila ani pustinja thaj postanisada strelco. <verse eid="GEN 21:20" /><verse number="21" style="v" sid="GEN 21:21" />Dok živisada ani pustinja Paran, lesi dej lese anda romnja taro Egipat.<verse eid="GEN 21:21" /></para>
  <para style="s">O Avraam ćerol savez e Avimelehesa</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22" />Ane gova vreme avilo o caro o Avimeleh thaj o zapovedniko tari lesi vojska o Pihol. O Avimeleh phenda e Avraamese: “O Dol si tusa ane sa so ćere. <verse eid="GEN 21:22" /><verse number="23" style="v" sid="GEN 21:23" />Golese xa sovli kate anglo Dol, kaj ni ka xoxave man, ni me čhaven ni me potomkuren. Nego kaj ka ćere šukar mancar thaj e phuvasa ani savi san abandžija, sar so i me ćerdem šukar tusa.”<verse eid="GEN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 21:24" />O Avraam phenda: “Xav sovli.”<verse eid="GEN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 21:25" />Tegani o Avraam žalisajlo e Avimelehese thaj phenda kaj lese sluge zorasa lije o bunari e pajesa.<verse eid="GEN 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 21:26" />O Avimeleh phenda: “Ni džanav ko ćerda gova. Tu ni vaćardan manđe golestar. Me tek avđive šunav baše gova.”<verse eid="GEN 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 21:27" />Tegani o Avraam lija nesave bakren thaj guruven, dija len e Avimelehese thaj gija solduj džene phanglje savez maškar peste.<verse eid="GEN 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 21:28" />Pale gova o Avraam crdija ki rig efta bakrijen taro stado <verse eid="GEN 21:28" /><verse number="29" style="v" sid="GEN 21:29" />thaj o Avimeleh pučlja e Avraame: “So značin gola efta bakrija saven crdijan ki rig?”<verse eid="GEN 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 21:30" />Vov phenda lese: “Le kale efta bakrijen mandar, te avol sar svedočanstvo kaj me hundem kava bunari.”<verse eid="GEN 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 21:31" />I gija gova than akhardol Beer-Ševa<note caller="+" style="f"><char style="fr" closed="false">21,31 </char><char style="fq" closed="false">Beer-Ševa </char><char style="ft" closed="false">So značil: “Bunari tari sovli”. Thaj gijate o jevrejsko lafi “Ševa” savo koristil pe baši sovli, šundol sar o brojo efta.</char></note>, golese kaj gothe von duj džene xalje sovli. <verse eid="GEN 21:31" /><verse number="32" style="v" sid="GEN 21:32" />Kana o Avimeleh thaj o Avraam phanglje savez ani Beer-Ševa, o Avimeleh thaj o Pihol, o zapovedniko tari lesi vojska, irisajle ani phuv i Filistejsko. <verse eid="GEN 21:32" /><verse number="33" style="v" sid="GEN 21:33" />O Avraam pale gova sadisada tamarisko kaš ani Beer-Ševa thaj gothe slavisada o alav e GOSPODESO, e Devleso savo si ane sa e đivesa.<verse eid="GEN 21:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 21:34" />O Avraam vadži but berša živila ani phuv i Filistejsko sar abandžija.<verse eid="GEN 21:34" /></para>
  <chapter eid="GEN 21" />
  <chapter number="22" style="c" sid="GEN 22" />
  <para style="s">O Dol iskušil e Avraame</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1" />Pale nesavo vreme manglja o Dol te iskušil e Avraame.</para>
  <para style="m" vid="GEN 22:1">Akharda le: “Avraame!”</para>
  <para style="p" vid="GEN 22:1">O Avraam phenda: “Aktaljem!”<verse eid="GEN 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 22:2" />Tegani o Dol phenda: “Le će čhave, će jekhore čhave e Isaako, save but manđe, thaj dža ani phuv i Morija. An le odori sar phabardi žrtva ko jekh brego baše savo me ka phenav tuće.”<verse eid="GEN 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 22:3" />Theara đive rano ki sabalin o Avraam uštilo, čhuta o samari pe piro her thaj lija pesa duje slugen thaj pe čhave e Isaako. Kana čhinda kašta baši žrtva, pojdisada ko than baše savo phenda lese o Dol.<verse eid="GEN 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 22:4" />Trito đive o Avraam vazdija pe jakha thaj dikhlja gova than odural. <verse eid="GEN 22:4" /><verse number="5" style="v" sid="GEN 22:5" />Tegani phenda pe slugenđe: “Ačhen kate e heresa, a me thaj mo čhavo ka dža te pera ke koča anglo Dol, pa ka iri amen tumende.”<verse eid="GEN 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 22:6" />Gija o Avraam lija kašta baši phabardi žrtva, čhuta po dumo pe čhaveso e Isaakoso, a vov korkoro lija ane pe vasta i jag thaj i čhuri thaj đele katane solduj.<verse eid="GEN 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 22:7" />Tegani phenda o Isaak e Avraamese pe dadese: “Dade!”</para>
  <para style="p" vid="GEN 22:7">Vov phenda lese: “So, mo čhavo?”</para>
  <para style="p" vid="GEN 22:7">O Isaak phenda: “Akh, isi amen jag thaj kašta, al kaj o bakro baši phabardi žrtva?”<verse eid="GEN 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 22:8" />O Avraam phenda lese: “Mo čhavo, o Dol ka brinil pe baše po bakro, baši phabardi žrtva.”</para>
  <para style="p" vid="GEN 22:8">Thaj solduj đele katane po dur. <verse eid="GEN 22:8" /><verse number="9" style="v" sid="GEN 22:9" />A kana avile ko than baše savo o Dol phenda lese, o Avraam ćerda gothe žrtveniko thaj čhuta kašta pe leste. Pale gova phanglja pe čhave e Isaako thaj pašljarda le po žrtveniko, prekale kašta. <verse eid="GEN 22:9" /><verse number="10" style="v" sid="GEN 22:10" />Tegani o Avraam lija i čhuri ano va te mudarol pe čhave. <verse eid="GEN 22:10" /><verse number="11" style="v" sid="GEN 22:11" />Al o anđelo e GOSPODESO dija vika taro nebo, vaćarindoj: “Avraame! Avraame!”</para>
  <para style="p" vid="GEN 22:11">Vov phenda: “Aktaljem!”<verse eid="GEN 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 22:12" />O anđelo phenda: “Ma vazde ćo va po čhavo! Ma ćer lese khanči, golese so akana džanav kaj dara taro Dol, kana ni žalisadan će jekhore čhave baše mande.”<verse eid="GEN 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 22:13" />Tegani o Avraam vazdija pe jakha, thaj dikhlja pale peste e bakre savo pe šingencar doldape pe ano žbuno. Đelo o Avraam, lija e bakre thaj phabarda le sar phabardi žrtva umesto pe čhave. <verse eid="GEN 22:13" /><verse number="14" style="v" sid="GEN 22:14" />Gija akharda o Avraam kava than “o GOSPOD ka brinil pe.” Golese i dži avđive phenol pe: “Ko brego e GOSPODESO vov ka brinil pe<note caller="+" style="f"><char style="fr" closed="false">22,14 </char><char style="fq" closed="false">Ko brego e GOSPODESO vov ka brinil pe </char><char style="ft" closed="false">Ano original ačhol: “Jireh.”</char></note>.”<verse eid="GEN 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 22:15" />O anđelo e GOSPODESO palem dija vika e Avraame taro nebo <verse eid="GEN 22:15" /><verse number="16" style="v" sid="GEN 22:16" />thaj phenda: “Xaljem sovli korkoro mancar, vaćarol o GOSPOD, kana gija ćerdan thaj ni žalisadan će jekhore čhave, <verse eid="GEN 22:16" /><verse number="17" style="v" sid="GEN 22:17" />čače ka blagosloviv tut thaj ka dav tut gaći but potomkura kobor si e čerenja ko nebo thaj i pošik ki morsko obala. Će potomkura ka nasledin e forura lenđe dušmanurenđe. <verse eid="GEN 22:17" /><verse number="18" style="v" sid="GEN 22:18" />Prekal ćire potomkura ka aven blagoslovime sa e narodura ki phuv, golese so šundan man.”<verse eid="GEN 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 22:19" />Tegani o Avraam irisajlo ke pe sluge thaj katane đele ani Beer-Ševa, thaj o Avraam ačhilo odori te bešol.<verse eid="GEN 22:19" /></para>
  <para style="s">E Nahorese potomkura</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20" />Pale nesavo vreme phende e Avraamese kaj i Milka bijanda čhaven lese phralese e Nahorese: <verse eid="GEN 22:20" /><verse number="21" style="v" sid="GEN 22:21" />e emphuredere e Uco, lese phrale e Buze, e Kemuele (e Aramese dade), <verse eid="GEN 22:21" /><verse number="22" style="v" sid="GEN 22:22" />e Kesede, e Haze, e Pildaše, e Jidlafe thaj e Betuele. <verse eid="GEN 22:22" /><verse number="23" style="v" sid="GEN 22:23" />E Betuelese bijandili i Reveka. Kale ohtone čhaven bijanda i Milka e Avraamese phralese e Nahorese. <verse eid="GEN 22:23" /><verse number="24" style="v" sid="GEN 22:24" />E Nahore sasa romni-ropkinja savi akharda pe Reuma. Voj bijanda e Tevahe, e Gahame, e Tahaše thaj e Maahu.<verse eid="GEN 22:24" /></para>
  <chapter eid="GEN 22" />
  <chapter number="23" style="c" sid="GEN 23" />
  <para style="s">E Sarako meripe</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1" />I Sara sasa džuvdi šelubištefta (127) berš. <verse eid="GEN 23:1" /><verse number="2" style="v" sid="GEN 23:2" />Voj muli ano Kirjat-Arba, gova si o Hevron, ani phuv i Hanaansko. O Avraam đelo te žalil e Sara thaj te rovol la.<verse eid="GEN 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 23:3" />Tegani uštilo o Avraam tari pi muli romni thaj phenda e Hetiturenđe: <verse eid="GEN 23:3" /><verse number="4" style="v" sid="GEN 23:4" />“Me sem abandžija thaj manuš savo avilo te bešol maškare tumende. Bićinen manđe nesavo than bašo limori me familijaće, te šaj te prahov me romnja odori.”<verse eid="GEN 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 23:5" />E Hetitura phende e Avraamese: <verse eid="GEN 23:5" /><verse number="6" style="v" sid="GEN 23:6" />“Šun amen, gospodarona. Tu san amenđe sar poglavari e Devleso. Praho će romnja ane amaro emlačho limori. Khoni amendar ni ka phandol piro limori te praho će romnja.”<verse eid="GEN 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 23:7" />Tegani o Avraam uštilo, pelo ke koča angle manuša tari goja phuv, angle Hetitura, <verse eid="GEN 23:7" /><verse number="8" style="v" sid="GEN 23:8" />thaj phenda: “Ako manđen te den man akate te prahov me romnja, tegani šunen man thaj molin baše mande e Efrone, e Coharese čhave, <verse eid="GEN 23:8" /><verse number="9" style="v" sid="GEN 23:9" />te bićinol manđe i pećina ani Mahpela, savi preperol lese thaj si ko krajo ane leso polje. Nek bićinol la manđe pali pherdi cena, te avol manđe than bašo prahope me familijaće maškar tumende.”<verse eid="GEN 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 23:10" />O Efron bešola maškare avera Hetitura thaj vaćarda e Avraamese angle sa e Hetitura, save avile angli kapija lese forosi: <verse eid="GEN 23:10" /><verse number="11" style="v" sid="GEN 23:11" />“Na, gospodarona. Šun tu man! Me dav tut gova polje thaj i pećina savi si pe leste. Dav tut gova angle manuša save si akana kate. Praho će mule romnja odori.”<verse eid="GEN 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 23:12" />O Avraam palem pelo ke koča angle manuša tari goja phuv, <verse eid="GEN 23:12" /><verse number="13" style="v" sid="GEN 23:13" />thaj phenda e Efronese angle sa e manuša: “Moliv tut, šun man. Ka poćinav tuće pherdi cena baše gova polje. Le mandar kava so dav tut, te šaj odori te prahov me mule romnja.”<verse eid="GEN 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 23:14" />O Efron vaćarda e Avraamese: <verse eid="GEN 23:14" /><verse number="15" style="v" sid="GEN 23:15" />“Šun man, gospodarona. Goja phuv si vredno štaršel (400) srebrnjakura, a gova naj but ni manđe ni tuće. Praho gothe će mule romnja.”<verse eid="GEN 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 23:16" />O Avraam šunda e Efrone thaj dija le gaći kobor vov phenda angle avera Hetitura: štaršel (400) srebrnjakura, pali standardno mera e trgovcurenđi.<verse eid="GEN 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 23:17" />Gija e Efroneso polje ani Mahpela pašo Mamre – o polje thaj i pećina savi si pe leste thaj sa e kašta ke lesi međa – <verse eid="GEN 23:17" /><verse number="18" style="v" sid="GEN 23:18" />postanisade e Avraamese angle sa e Hetitura save avile angli forosi kapija. <verse eid="GEN 23:18" /><verse number="19" style="v" sid="GEN 23:19" />Pale gova prahosada o Avraam pe romnja e Sara ani pećina ko polje ani Mahpela paši Mamrija, gova si o Hevron, ani phuv i Hanaansko.<verse eid="GEN 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 23:20" />Gija, gova polje thaj i pećina pe leste save sesa e Hetiturenđi, postanisade e Avraamese sar than bašo prahope lese familijaće.<verse eid="GEN 23:20" /></para>
  <chapter eid="GEN 23" />
  <chapter number="24" style="c" sid="GEN 24" />
  <para style="s">O Isaak thaj i Reveka</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1" />O Avraam već but phurajlo thaj o GOSPOD blagoslovisada le ane sa.<verse eid="GEN 24:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 24:2" />O Avraam phenda pe empurane slugase ane leso ćher, savo brinisada pe tare sa leso barvalipe: “Čhuv ćo va pe me čanga <verse eid="GEN 24:2" /><verse number="3" style="v" sid="GEN 24:3" />thaj xa sovli e GOSPODESA, e Devlesa e nebose thaj e phuvaće, kaj me čhavese ni ka ane romnja tare čheja e Hanaancurenđe, maškare save bešav, <verse eid="GEN 24:3" /><verse number="4" style="v" sid="GEN 24:4" />nego ka dža ane mingri phuv, kaj si mingri familija, thaj gothar ka ane romnja me čhavese e Isaakose.”<verse eid="GEN 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 24:5" />O sluga pučlja le: “So te goja romni ni manglja te avol mancar ane kaja phuv? Tegani trubul li te inđarav će čhave ani phuv katar tu aviljan?”<verse eid="GEN 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 24:6" />O Avraam phenda lese: “Na! Nisar ma inđar me čhave odori! <verse eid="GEN 24:6" /><verse number="7" style="v" sid="GEN 24:7" />O GOSPOD, o Dol e neboso, savo inđarda man taro ćher me dadeso thaj tari phuv kaj si mingri familija, vaćarda mancar thaj xalja sovli: ‘Će potomkurenđe ka dav kaja phuv.’ Vov ka bičhalol pe anđelo angle tute, te bi šajine gothar te ane romnja me čhavese. <verse eid="GEN 24:7" /><verse number="8" style="v" sid="GEN 24:8" />A te goja romni ni manglja te avol tusa, tegani ka ave oslobodimo tari sovli savi dijan man. Al me čhave nisar ma inđar odori!”<verse eid="GEN 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 24:9" />Tegani o sluga čhuta po va ke čanga pire gospodarese e Avraamese thaj xalja lese sovli.<verse eid="GEN 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 24:10" />Pale gova o sluga lija deš kamile taro krdo e Avraameso thaj đelo. Inđarda pesa emšukar darura taro blago pe gospodareso thaj đelo ano Aram-Naharajim, ano foro e Nahoreso. <verse eid="GEN 24:10" /><verse number="11" style="v" sid="GEN 24:11" />Kana reslja anglo foro, mukhlja e kamilen te pašljon pašo jekh bunari. Gova sasa angli rat, kana e džuvlja ikljen te dolen paj.<verse eid="GEN 24:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 24:12" />Tegani o sluga phenda: “GOSPODE, Devla mingre gospodareso e Avraameso! Pomogni manđe avđive te avav uspešno thaj tu sikav baro manglipe me gospodarese e Avraamese. <verse eid="GEN 24:12" /><verse number="13" style="v" sid="GEN 24:13" />Akh, me ačhav paše kava bunari, a e čheja e manušenđe kale forose ikljen te dolen paj. <verse eid="GEN 24:13" /><verse number="14" style="v" sid="GEN 24:14" />I čhej savaće phenav: ‘Moliv tut, mukh ćo khoro te pijav paj,’ a voj phenol: ‘Le pi, a ka dav paj thaj će kamilenđe,’ nek avol goja savi odredisadan će slugase e Isaakose. Pale gova ka džanav kaj tu sikadan baro manglipe me gospodarese.”<verse eid="GEN 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 24:15" />Angleder nego so vov završisada i molitva, iklili i Reveka e khoresa ko piko. Voj sasa čhej e Betuelesi, savo sasa čhavo e Milkako thaj e Nahoreso, e Avraamese phraleso. <verse eid="GEN 24:15" /><verse number="16" style="v" sid="GEN 24:16" />I čhej sasa but lačhi thaj vadži ni suta khanikasa. Voj đeli tele ko bunari, pherda o khoro thaj palem avili upre.<verse eid="GEN 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 24:17" />O sluga prastaja angle late thaj phenda laće: “Moliv tut, de ma zala paj te pijav andar ćo khoro.”<verse eid="GEN 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 24:18" />“Pi, gospodarona,” phenda i Reveka thaj sigate mukhlja o khoro tar po piko thaj dija le te pijol.<verse eid="GEN 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 24:19" />Kana o sluga pilja, i Reveka phenda: “Ka dav paj thaj će kamilenđe te pijen.”<verse eid="GEN 24:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 24:20" />Gija voj sigate čhorda po khoro ani balija kaj pijol i stoka, thaj sigate đeli palem ko bunari te pherol vadži paj. Gija dolda paj baše sa lese kamile. <verse eid="GEN 24:20" /><verse number="21" style="v" sid="GEN 24:21" />O sluga samo dikhlja la thaj khanči ni phenda, te dićhol dal o GOSPOD ćerda te avol leso drom uspešno, il na.<verse eid="GEN 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 24:22" />Kana e kamile pilje paj, o sluga ikalda thaj dija e Reveka kučali zlatno angrustik savi čhuvol pe ko nakh, a baše laće vasta duj bare zlatna grivne. <verse eid="GEN 24:22" /><verse number="23" style="v" sid="GEN 24:23" />Tegani pučlja la: “Kasi san čhej? Phen manđe, isi li than ke će dadeso ćher te sova erat?”<verse eid="GEN 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 24:24" />Voj phenda: “Me sem čhej e Betuelesi, a vov si čhavo e Milkako thaj e Nahoreso.” <verse eid="GEN 24:24" /><verse number="25" style="v" sid="GEN 24:25" />Thaj vadži phenda lese: “Amende isi pherdo phus thaj xape e kamilenđe, a isi i than soimase tumenđe.”<verse eid="GEN 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 24:26" />Tegani o sluga pelo ke koča thaj slavisada e GOSPODE <verse eid="GEN 24:26" /><verse number="27" style="v" sid="GEN 24:27" />vaćarindoj: “Blagoslovimo te avol o GOSPOD, o Dol me gospodareso e Avraameso, so ni ačhada po manglipe thaj po vernost premal mo gospodari. O GOSPOD anda man ko drom dži ko ćher me gospodarese familijako.”<verse eid="GEN 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 24:28" />Tegani i čhej prastija thaj sa kava phenda savorenđe ano ćher pe dako. <verse eid="GEN 24:28" /><verse number="29" style="v" sid="GEN 24:29" />E Reveka sasa phral kaso alav sasa Lavan. Vov prastija dži ko sluga e Avraameso savo sasa ko bunari, <verse eid="GEN 24:29" /><verse number="30" style="v" sid="GEN 24:30" />golese kaj dikhlja i angrustik ko nakh thaj e grivne ke vasta pe phejaće e Revekaće, a šunda so vaćarda laće gova manuš. Kana reslo dži ke Avraameso sluga, arakhlja le sar ačhol e kamilencar pašo bunari. <verse eid="GEN 24:30" /><verse number="31" style="v" sid="GEN 24:31" />O Lavan phenda lese: “Av, tu save blagoslovisada o GOSPOD. Sose ačhe avri? Me već spremisadem o than tuće thaj e kamilenđe.”<verse eid="GEN 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 24:32" />Gija o sluga e Avraameso avilo ano ćher. E Lavanese sluge uljarde o pharipe tare kamile thaj dije len phus thaj xape, a e slugase thaj lese manušenđe ande paj te thoven pe pingre.<verse eid="GEN 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 24:33" />Al kana čhute lese te xal, vov phenda: “Ni ka xav sa dži kaj ni phenav sose aviljem.”</para>
  <para style="p" vid="GEN 24:33">O Lavan phenda lese: “Vaćar.”<verse eid="GEN 24:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 24:34" />Tegani vaćarda: “Me sem sluga e Avraameso. <verse eid="GEN 24:34" /><verse number="35" style="v" sid="GEN 24:35" />O GOSPOD but blagoslovisada me gospodare thaj vov but barvajlo. Dija e Avraame bakren thaj guruven, srebro thaj zlato, roburen thaj ropkinjen, kamilen thaj heren. <verse eid="GEN 24:35" /><verse number="36" style="v" sid="GEN 24:36" />A i Sara, i romni me gospodaresi, bijanda čhave me gospodarese ane leso phuripe thaj mo gospodari dija le sa so isi le. <verse eid="GEN 24:36" /><verse number="37" style="v" sid="GEN 24:37" />A mandar mo gospodari manglja te xav sovli vaćarindoj: ‘Ma te ane me čhavese romnja tare Hanaanska čheja, maškare save bešav. <verse eid="GEN 24:37" /><verse number="38" style="v" sid="GEN 24:38" />Nego dža ane mingri phuv, kaj si mingri familija thaj gothar ka ane romnja me čhavese.’ <verse eid="GEN 24:38" /><verse number="39" style="v" sid="GEN 24:39" />Me tegani pučljem me gospodare: ‘A so te ni manglja goja čhej te avol mancar?’ <verse eid="GEN 24:39" /><verse number="40" style="v" sid="GEN 24:40" />Vov phenda manđe: ‘O GOSPOD, pale kaso manglipe živiv, ka bičhalol pe anđelo tusa thaj ka ćerol ćo drom uspešno pa ka ane romnja me čhavese tari mingri familija, taro ćher mingre dadeso. <verse eid="GEN 24:40" /><verse number="41" style="v" sid="GEN 24:41" />Kana ka ave ki mi familija, ka ave oslobodime tari sovli. Čak i te ni dije la tuće, palem ka ave oslobodime tari sovli mingri.’<verse eid="GEN 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 24:42" />Al kana aviljem ko bunari avđive, phendem: ‘GOSPODE, Devla mingre gospodareso e Avraameso, te mangljan, moliv tut de man o drom ke savo pojdisadem te avol uspešno. <verse eid="GEN 24:42" /><verse number="43" style="v" sid="GEN 24:43" />Akh, me ka ačhav pašo bunari. Te avili nesavi čhej te pherol paj thaj me phenav laće: “De ma te pijav zala paj taro ćiro khoro.” <verse eid="GEN 24:43" /><verse number="44" style="v" sid="GEN 24:44" />A te voj phenol manđe: “Pi tu, thaj će kamilenđe ka dolav paj,” gova nek avol romni savi o GOSPOD birisada me gospodarese čhavese.’ <verse eid="GEN 24:44" /><verse number="45" style="v" sid="GEN 24:45" />Thaj me vadži ni završisadem kaja molitva, iklili i Reveka e khoresa ke po piko thaj ulili ko bunari. Kana dolda paj, me phendem laće: ‘De man te pijav paj.’ <verse eid="GEN 24:45" /><verse number="46" style="v" sid="GEN 24:46" />A voj sigate uljarda o khoro pestar thaj phenda: ‘Le pi, thaj će kamilenđe ka dolav paj.’ Gija me piljem, a voj dija paj i me kamilenđe. <verse eid="GEN 24:46" /><verse number="47" style="v" sid="GEN 24:47" />Tegani me pučljem la: ‘Kasi san tu čhej?’ A voj phenda manđe: ‘Me sem čhej e Betuelesi, savo si čhavo e Nahoreso thaj e Milkako.’ Tegani čhutem laće i angrustik ko nakh thaj e grivne ke vasta. <verse eid="GEN 24:47" /><verse number="48" style="v" sid="GEN 24:48" />Pale gova, peljem ke koča thaj slavisadem e GOSPODE. Blagoslovisadem e GOSPODE, e Devle mingre gospodarese e Avraamese, so anda man ko šukar drom te anav e čheja taro phral mingre gospodareso baše leso čhavo. <verse eid="GEN 24:48" /><verse number="49" style="v" sid="GEN 24:49" />A akana, te mangljen te sikaven baro manglipe thaj pačajipe me gospodarese, vaćaren manđe. Al i te ni mangljen, vaćaren manđe, te bi džanava so te ćerav.”<verse eid="GEN 24:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 24:50" />Tegani o Lavan thaj o Betuel phende: “Pošto kava avol taro GOSPOD, amen našti vaćara tuće ni va, ni na. <verse eid="GEN 24:50" /><verse number="51" style="v" sid="GEN 24:51" />Akh, i Reveka angle tute. Le la thaj dža. Nek avol romni ćire gospodarese čhavesi, sar so phenda o GOSPOD!”<verse eid="GEN 24:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="GEN 24:52" />Kana šunda o sluga e Avraameso so vaćarde, pelo mujesa anglo GOSPOD dži i phuv. <verse eid="GEN 24:52" /><verse number="53" style="v" sid="GEN 24:53" />Tegani ikalda srebrno thaj zlatno nakit, fostanura thaj dija e Revekaće. I laće phralese thaj laće daće dija kučale poklonura. <verse eid="GEN 24:53" /><verse number="54" style="v" sid="GEN 24:54" />Pale gova vov thaj e manuša save sesa lesa xalje thaj pilje, a ačhile odori thaj te soven.</para>
  <para style="p" vid="GEN 24:54">Kana uštile ki sabalin, o sluga vaćarda: “Mućhen man te iriv man me gospodarese.”<verse eid="GEN 24:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 24:55" />Al e Revekako phral thaj laći dej phende: “Nek ačhol i čhej amencar vadži deš (10) đive, tegani nek džal.”<verse eid="GEN 24:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 24:56" />Al o sluga phenda lenđe: “Ma ićaren man akana kana o GOSPOD ćerda mingro drom te avol uspešno. Mućhen man te iriv man me gospodarese.”<verse eid="GEN 24:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="GEN 24:57" />Tegani von phende lese: “Ka da vika e čheja te dikha so ka phenol voj.”<verse eid="GEN 24:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="GEN 24:58" />Gija akharde e Reveka thaj pučlje la: “Manđe li te dža kale manušesa?”</para>
  <para style="p" vid="GEN 24:58">Voj phenda: “Mangav.”<verse eid="GEN 24:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="GEN 24:59" />Tegani von mukhlje pe pheja e Reveka te džal, thaj lasa e džuvlja savi barada la, e Avraamese slugasa thaj lese manušencar.<verse eid="GEN 24:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="GEN 24:60" />Blagoslovisade e Reveka thaj phende laće:</para>
  <para style="b" vid="GEN 24:60" />
  <para style="q1" vid="GEN 24:60">“Phene amarije,</para>
  <para style="q2" vid="GEN 24:60">av dej milja thaj miljenđe,</para>
  <para style="q1" vid="GEN 24:60">thaj će potomkura nek prelen</para>
  <para style="q2" vid="GEN 24:60">e forura pe dušmanurenđe!”<verse eid="GEN 24:60" /></para>
  <para style="b" />
  <para style="p">
    <verse number="61" style="v" sid="GEN 24:61" />Tegani i Reveka thaj laće sluškinje spremisajle, bešle ke kamile thaj đele palo sluga e Avraameso. Gija o sluga lija e Reveka thaj đele.<verse eid="GEN 24:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="GEN 24:62" />O Isaak irisajlo taro Beer-Lahaj-Roi, golese so bešola ani pustinja Negev. <verse eid="GEN 24:62" /><verse number="63" style="v" sid="GEN 24:63" />Jekh rat o Isaak iklilo ano polje te phirol, thaj kana vazdija pe jakha, dikhlja sar aven e kamile.<verse eid="GEN 24:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="GEN 24:64" />Thaj i Reveka vazdija pe jakha thaj dikhlja e Isaako. Ulili tari kamila <verse eid="GEN 24:64" /><verse number="65" style="v" sid="GEN 24:65" />thaj pučlja e Avraamese sluga: “Ko si kava manuš ano polje savo avol premal amende?”</para>
  <para style="p" vid="GEN 24:65">O sluga phenda: “Gova si mo gospodari.”</para>
  <para style="p" vid="GEN 24:65">Voj lija po dikhlo thaj učharda po muj.<verse eid="GEN 24:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="GEN 24:66" />Tegani o sluga vaćarda e Isaakose sa so ćerda. <verse eid="GEN 24:66" /><verse number="67" style="v" sid="GEN 24:67" />Pale gova o Isaak inđarda e Reveka ano šatori pe dako e Sarako thaj voj postanisada lesi romni. Gija ano manglipe premali Reveka o Isaak arakhlja uteha pale gova so muli lesi dej.<verse eid="GEN 24:67" /></para>
  <chapter eid="GEN 24" />
  <chapter number="25" style="c" sid="GEN 25" />
  <para style="s">E Avraamese avera potomkura</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1" />O Avraam lija pese avere romnja savi akhardola Hetura.<verse eid="GEN 25:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 25:2" />Voj bijanda lese e Zomrane, e Joksane, e Madane, e Madijame, e Jesvoke thaj e Soijene.<verse eid="GEN 25:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 25:3" />E Joksanese bijandile o Savan thaj o Dedan.</para>
  <para style="p" vid="GEN 25:3">E Dedanese potomkura si e Asurimcura, e Latusimcura thaj e Laomimcura.<verse eid="GEN 25:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 25:4" />E Madijamese čhave sesa o Efa, o Efer, o Enoh, o Avida thaj o Eldaa. Sa kala manuša sesa e Heturaće potomkura.<verse eid="GEN 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 25:5" />Sa o barvalipe so sasa e Avraame dija e Isaakose, <verse eid="GEN 25:5" /><verse number="6" style="v" sid="GEN 25:6" />al pe čhavenđe tare avera romnja-ropkinje dija darura, dok vadži sasa džuvdo, thaj bičhalda len ko istok – dur tare leso čhavo o Isaak.<verse eid="GEN 25:6" /></para>
  <para style="s">E Avraameso meripe</para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7" />O Avraam sasa džuvdo šelueftavardeš thaj pandž (175) berš. <verse eid="GEN 25:7" /><verse number="8" style="v" sid="GEN 25:8" />Mulo ane emšukar berša thaj sasa prahome ano baro phuripe. <verse eid="GEN 25:8" /><verse number="9" style="v" sid="GEN 25:9" />Lese čhave o Isaak thaj o Jišmael prahosade le ani pećina Mahpela pašo Mamre, ko polje e Efroneso, e čhaveso e Cohareso e Hetiteso, <verse eid="GEN 25:9" /><verse number="10" style="v" sid="GEN 25:10" />ko polje savo ćinda o Avraam tare Hetitura. Odori prahosade e Avraame paši lesi romni i Sara.<verse eid="GEN 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 25:11" />Palo meripe e Avraameso, o Dol blagoslovisada lese čhave e Isaako, savo tegani živisada pašo Beer-Lahaj-Roi.<verse eid="GEN 25:11" /></para>
  <para style="s">E Ismailese potomkura</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12" />Kava si o lil taro pleme e Ismaileso, e Avraameso čhaveso, kas bijanda lese i Egipćanka i Agara, sluškinja e Saraći. <verse eid="GEN 25:12" /><verse number="13" style="v" sid="GEN 25:13" />E Ismailese čhavenđe alava palo redo sar bijandile si:</para>
  <para style="p" vid="GEN 25:13">E Ismaileso emphureder čhavo sasa o Navajot, pa o Kidar, o Navdeilo, o Masam, <verse eid="GEN 25:13" /><verse number="14" style="v" sid="GEN 25:14" />o Masma, o Duma, o Masa, <verse eid="GEN 25:14" /><verse number="15" style="v" sid="GEN 25:15" />o Hadar, o Teman, o Jetur, o Nafes thaj o Kedma.<verse eid="GEN 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 25:16" />Gova si e Ismailese čhave, dešuduj plemenska šorutne, pale kaste si akharde e gava thaj e logora. <verse eid="GEN 25:16" /><verse number="17" style="v" sid="GEN 25:17" />O Jišmael sasa džuvdo šelutranda thaj efta (137) berš thaj mukhlja pi duša. Mulo thaj sasa prahome. <verse eid="GEN 25:17" /><verse number="18" style="v" sid="GEN 25:18" />Lese potomkura bešle taro Evilat dži ko Šur, taro istočno Egipat premali Asirija, a živisade ano dušmanluko e Avraamese avere potomkurencar.<verse eid="GEN 25:18" /></para>
  <para style="s">O Isav thaj o Jakov</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19" />Kava si o lil taro pleme e Isaakoso, e Avraamese čhaveso.</para>
  <para style="p" vid="GEN 25:19">E Avraamese bijandilo o Isaak. <verse eid="GEN 25:19" /><verse number="20" style="v" sid="GEN 25:20" />E Isaako sasa saranda (40) berš kana lija e Reveka romnjaće, čhej e Betuelesi, e Aramejcosi taro Padan-Aram, phen e Aramejcosi e Lavanesi.<verse eid="GEN 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 25:21" />O Isaak molisajlo e GOSPODESE baši pi romni, golese so naštine te aven la čhave. O GOSPOD šunda lesi molitva thaj i Reveka lesi romni ačhili khamni.<verse eid="GEN 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 25:22" />E čhave ane lako vođi gurina jekh avere thaj golese voj pučlja: “So si mancar kava?”</para>
  <para style="p" vid="GEN 25:22">Golese đeli te pučol e GOSPODE.<verse eid="GEN 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 25:23" />A o GOSPOD phenda laće:</para>
  <para style="b" vid="GEN 25:23" />
  <para style="q1" vid="GEN 25:23">“Duj narodura si ane tute;</para>
  <para style="q2" vid="GEN 25:23">duj narodura ka ulaven pe andaro ćo vođi.</para>
  <para style="q1" vid="GEN 25:23">Jekh ka avol po zuralo taro aver,</para>
  <para style="q2" vid="GEN 25:23">thaj o phureder ka služil e ciknjedere.”<verse eid="GEN 25:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="GEN 25:24" />Kana avilo o vreme e bijanimaso, ane lako vođi sesa duj čhave. <verse eid="GEN 25:24" /><verse number="25" style="v" sid="GEN 25:25" />O angluno čhavo savo bijandilo sasa sa lolo thaj pherdo bala sar ogrtači. Golese dije le alav Isav<note caller="+" style="f"><char style="fr" closed="false">25,25 </char><char style="fq" closed="false">Isav </char><char style="ft" closed="false">Kava alav značil “balalo.”</char></note>. <verse eid="GEN 25:25" /><verse number="26" style="v" sid="GEN 25:26" />A pale gova bijandilo leso phral savo ićarola vastesa e Isavesi patum, golese dije le alav Jakov<note caller="+" style="f"><char style="fr" closed="false">25,26 </char><char style="fq" closed="false">Jakov </char><char style="ft" closed="false">Kava alav značil “ićarol tari patum” il “varalica.”</char></note>. E Isaako sasa šovardeš (60) berš kana i Reveka bijanda lese čhaven.<verse eid="GEN 25:26" /></para>
  <para style="s">O Isav biknol po pravo taro phurederipe</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27" />E čhavore barile. O Isav ćerdilo šukar lovco, manuš savo manđol te avol avri ani pustinja, a o Jakov sasa manuš savo sasa krotko thaj pobut bešola ano šatori. <verse eid="GEN 25:27" /><verse number="28" style="v" sid="GEN 25:28" />O Isaak manglja pobut e Isave, golese so manglimasa xalja o mas savo o Isav dolola, a i Reveka pobut manglja e Jakove.<verse eid="GEN 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 25:29" />Jekh đive kana o Jakov ćirada nesavi zumi, o Isav avilo andari pustinja but bokhalo, <verse eid="GEN 25:29" /><verse number="30" style="v" sid="GEN 25:30" />pa phenda e Jakovese: “De ma te xav goja loli zumi, golese kaj muljem tari bokh!” Gija dije le alav Edom.<verse eid="GEN 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 25:31" />Al o Jakov phenda lese: “Angleder bićin manđe ćo pravo savo tut isi sar phureder čhavo!”<verse eid="GEN 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 25:32" />A o Isav phenda lese: “Akh, samo so ni muljem tari bokh, so trubul man gova pravo taro phurederipe?”<verse eid="GEN 25:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 25:33" />O Jakov tegani phenda lese: “Angleder xa tu sovli!”</para>
  <para style="p" vid="GEN 25:33">O Isav xalja sovli thaj gija bićinda e Jakovese piro pravo taro phurederipe.<verse eid="GEN 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 25:34" />Tegani o Jakov dija e Isave mangro thaj ćiradi zumi tari leća. Vov xalja thaj pilja, pale gova uštilo thaj đelo.</para>
  <para style="p" vid="GEN 25:34">Gija o Isav ni marisada za ke piro pravo savo sasa le sar phureder čhavo.<verse eid="GEN 25:34" /></para>
  <chapter eid="GEN 25" />
  <chapter number="26" style="c" sid="GEN 26" />
  <para style="s">O Isaak ano Gerar</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1" />Ani phuv avilo bokhalipe, al na sar so sasa ano vreme e Avraameso, golese o Isaak đelo te bešol ani phuv Gerar ko Avimeleh, ko filistejsko caro.<verse eid="GEN 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 26:2" />O GOSPOD sikadilo e Isaakose thaj phenda lese: “Ma dža tele ano Egipat, nego beš ani phuv baši savi ka phenav tuće. <verse eid="GEN 26:2" /><verse number="3" style="v" sid="GEN 26:3" />Beš nesavo vreme ane goja phuv sar abandžija. Me ka avav tusa thaj ka blagosloviv tut. Golese kaj tuće thaj će potomkurenđe ka dav sa kala phuva, thaj ka pherav i sovli savi xaljem će dadese e Avraamese. <verse eid="GEN 26:3" /><verse number="4" style="v" sid="GEN 26:4" />Ka ćerav će potomkura te aven gaći kobor isi čerenja ko nebo thaj ka dav će potomkurenđe sa kala phuva. Sa e narodura ki phuv ka aven blagoslovime prekal ćire potomkura, <verse eid="GEN 26:4" /><verse number="5" style="v" sid="GEN 26:5" />golese so o Avraam šunda mo glaso thaj ićarda me propisura, naredbe, zapovestura thaj zakonura.”<verse eid="GEN 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 26:6" />Gija ačhilo o Isaak te bešol ano Gerar.<verse eid="GEN 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 26:7" />E murša ane gova than pučlje baši lesi romni, a o Isaak phenda: “Mi phen si,” golese kaj darajlo te phenol: “Mi romni si.” Dija gođi: “E murša kale forose bi šajine te mudaren man baši Reveka, golese kaj si but lačhi.”<verse eid="GEN 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 26:8" />Kana sasa but vreme ano Gerar, o Avimeleh, o filistejsko caro, dikhlja taro džamo sar o Isaak grlil thaj čumidol e Reveka, pe romnja.<verse eid="GEN 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 26:9" />O Avimeleh akharda e Isaako thaj phenda: “Gova si ći romni! Sose phendan kaj si ći phen?”</para>
  <para style="p" vid="GEN 26:9">O Isaak vaćarda: “Golese so dijem gođi kaj bi šajine te mudaren man baše late.”<verse eid="GEN 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 26:10" />O Avimeleh phenda: “So ćerdan amenđe gova? Šajine khoni te sovol će romnjasa thaj gija bi čhuvesa i krivica pe amende!”<verse eid="GEN 26:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 26:11" />Tegani o Avimeleh naredisada sa e manušenđe: “Ko ćerol khanči bilačhe kale manušese il lese romnjaće, ka avol mudardo!”<verse eid="GEN 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 26:12" />O Isaak tegani sejisada e njive ani goja phuv thaj ćidija šel (100) drom po baro bijandipe, golese so blagoslovisada le o GOSPOD. <verse eid="GEN 26:12" /><verse number="13" style="v" sid="GEN 26:13" />Gija vov barvajlo, thaj nastavisada te barvavol, sa dži kaj ni sasa but barvalo. <verse eid="GEN 26:13" /><verse number="14" style="v" sid="GEN 26:14" />Sasa le gaći bakre thaj stoka, thaj gaći sluge, kaj e Filistejcura sesa ljubomorna pe leste. <verse eid="GEN 26:14" /><verse number="15" style="v" sid="GEN 26:15" />Golese e Filistejcura pherde phuvasa sa e bunara save honde e sluge e Avraamese, e Isaakose dadese, dži kaj sasa o Avraam džuvdo.<verse eid="GEN 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 26:16" />Tegani o Avimeleh phenda e Isaakose: “Dža amendar, golese kaj san akana but pozuralo amendar.”<verse eid="GEN 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 26:17" />O Isaak đelo gothar thaj putarda pe šatora ani Gerarsko dolina, thaj bešlo gothe. <verse eid="GEN 26:17" /><verse number="18" style="v" sid="GEN 26:18" />Vov palem hondo e bunara save sesa honde ano vreme lese dadeso e Avraameso thaj save e Filistejcura pherde phuvasa pale Avraameso meripe. Dija len ista alava sar so dijasa len leso dad.<verse eid="GEN 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 26:19" />Kana e Isaakose sluge honde ani dolina, arakhlje bunari lačhe šudre pajesa. <verse eid="GEN 26:19" /><verse number="20" style="v" sid="GEN 26:20" />E gerarska pastira lije te ćeren čingara e Isaakose pastirencar vaćarindoj: “Gova si amaro paj!”</para>
  <para style="p" vid="GEN 26:20">O Isaak dija alav gole bunarese Esek<note caller="+" style="f"><char style="fr" closed="false">26,20 </char><char style="fq" closed="false">Esek </char><char style="ft" closed="false">Esek značil “čingar.”</char></note>, golese so ćerde čingara lesa. <verse eid="GEN 26:20" /><verse number="21" style="v" sid="GEN 26:21" />Pale gova honde lese sluge dujto bunari, al i baše leste ćerde čingara. Golese o Isaak dija le alav Sitna<note caller="+" style="f"><char style="fr" closed="false">26,21 </char><char style="fq" closed="false">Sitna </char><char style="ft" closed="false">Sitna značil “dušmanluko.”</char></note>. <verse eid="GEN 26:21" /><verse number="22" style="v" sid="GEN 26:22" />Tegani o Isaak đelo gothar thaj hondo vadži jekh bunari, al baše leste khoni ni ćerda čingara. O Isaak dija le alav Rehovot<note caller="+" style="f"><char style="fr" closed="false">26,22 </char><char style="fq" closed="false">Rehovot </char><char style="ft" closed="false">Rehovot značil “Baro than.”</char></note>, vaćarindoj: “Akana o GOSPOD dija amen kava baro than te bariva ani kaja phuv.”<verse eid="GEN 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 26:23" />Gothar o Isaak đelo ani Beer-Ševa.<verse eid="GEN 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 26:24" />Goja rat o GOSPOD sikadilo lese thaj phenda: “Me sem o Dol e Avraameso će dadeso. Ma dara, golese kaj sem me tusa! Ka blagosloviv tut thaj ka ćerav te avol tut but potomkura, baše mingro sluga o Avraam.”<verse eid="GEN 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 26:25" />O Isaak odori ćerda žrtveniko thaj slavisada o alav e GOSPODESO. Gothe putarda po šatori, a lese sluge honde bunari.<verse eid="GEN 26:25" /></para>
  <para style="s">O Isaak ćerol savez e Avimelehesa</para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26" />Tegani e Isaakose avilo taro Gerar o Avimeleh pe savetnikosa e Ahuzatesa thaj e Piholesa, e zapovednikosa tare lesi vojska.<verse eid="GEN 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 26:27" />O Isaak pučlja len: “Sose aviljen mande, kana tumen mrzin man thaj tradijen man tumendar?”<verse eid="GEN 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 26:28" />Von phende: “Dikhljam kaj si o GOSPOD tusa. Golese dijam gođi kaj amen trubul maškar amende thaj tute te ćera savez sovljasa, <verse eid="GEN 26:28" /><verse number="29" style="v" sid="GEN 26:29" />kaj ni ka ćere amenđe bilačhipe, sar so ni amen tuće ni ćerdam bilačhipe, nego tusa uvek sama šukar thaj ano mir mukhljam tut te dža. A akana o GOSPOD blagoslovisada tut.”<verse eid="GEN 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 26:30" />Tegani o Isaak ćerda lenđe xamase thaj von xalje thaj pilje.<verse eid="GEN 26:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 26:31" />Theara đive uštile rano ki sabalin thaj ćerde savez sovljasa jekh averesa. O Isaak tegani mukhlja len te džan lestar ano mir.<verse eid="GEN 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 26:32" />Gova isto đive avile e sluge e Isaakose thaj phende lese bašo bunari savo honde: “Arakhljam paj!” <verse eid="GEN 26:32" /><verse number="33" style="v" sid="GEN 26:33" />O Isaak dija le alav Šiva. Golese o foro akhardol Beer-Ševa dži avđive.<verse eid="GEN 26:33" /></para>
  <para style="s">E Isavese romnja</para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34" />Kana sasa e Isave saranda (40) berš, lija duje Hetitskone romnjen: e Judita, e Beerijase čheja, thaj e Bosmata, e Elonese čheja. <verse eid="GEN 26:34" /><verse number="35" style="v" sid="GEN 26:35" />Von ćerde e Isaakose thaj e Revekaće bare muke.<verse eid="GEN 26:35" /></para>
  <chapter eid="GEN 26" />
  <chapter number="27" style="c" sid="GEN 27" />
  <para style="s">O Jakov xoxaimasa lol e Isaveso blagoslov</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1" />Kana o Isaak phurajlo thaj lese jakha oslabisade gaći kaj naštine te dićhol, akharda e Isave, pe phuredere čhave, thaj phenda lese: “Mo čhavo!”</para>
  <para style="p" vid="GEN 27:1">Vov phenda: “Aktaljem!”<verse eid="GEN 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 27:2" />O Isaak vaćarda: “Akh, phuraljem, thaj ni džanav o đive kana ka merav. <verse eid="GEN 27:2" /><verse number="3" style="v" sid="GEN 27:3" />Golese le ći džitka thaj će strele. Dža ani pustinja te astare manđe nesava divljone životinja. <verse eid="GEN 27:3" /><verse number="4" style="v" sid="GEN 27:4" />Tegani ćer manđe ukusno xape, savo me but mangav, thaj an manđe te xav, te bi šajine te blagosloviv tut sar ni muljem.”<verse eid="GEN 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 27:5" />I Reveka šunda so o Isaak phenda pe čhavese e Isavese, thaj kana o Isav đelo ani pustinja te astarol e divljone životinja thaj te anol la, <verse eid="GEN 27:5" /><verse number="6" style="v" sid="GEN 27:6" />phenda pe čhavese e Jakovese: “Akh, akana šundem sar ćo dad phenda će phralese e Isavese: <verse eid="GEN 27:6" /><verse number="7" style="v" sid="GEN 27:7" />‘Dža te astare manđe nesava divljona životinja thaj ćer manđe nesavo ukusno xape te xav thaj te blagosloviv tut anglo GOSPOD sar ni muljem.’ <verse eid="GEN 27:7" /><verse number="8" style="v" sid="GEN 27:8" />Golese akana šun man, mo čhavo, thaj ćer sa so ka phenav tuće! <verse eid="GEN 27:8" /><verse number="9" style="v" sid="GEN 27:9" />Dža dži ko stado thaj an duje cikne buzoren. Ka ćerav lendar ukusno xape će dadese savo vov but manđol. <verse eid="GEN 27:9" /><verse number="10" style="v" sid="GEN 27:10" />Pale gova ka inđare će dadese te xal thaj te blagoslovil tut sar ni mulo.”<verse eid="GEN 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 27:11" />Al o Jakov phenda pe daće e Revekaće: “Al mo phral si balalo manuš, a me najsem. <verse eid="GEN 27:11" /><verse number="12" style="v" sid="GEN 27:12" />So te dolda man mo dad? Ka dol gođi kaj mangav te xoxavav le, thaj gija pe mande ka anav harami, a na blagoslov.”<verse eid="GEN 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 27:13" />Lesi dej phenda: “Mo čhavo, nek o harami perol pe mande. Samo šun man, dža thaj an manđe e buzoren!”<verse eid="GEN 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 27:14" />O Jakov đelo, dolda e buzoren lija thaj anda pe daće. Lesi dej ćerda ukusno xape savo but manglja leso dad. <verse eid="GEN 27:14" /><verse number="15" style="v" sid="GEN 27:15" />Tegani i Reveka lija emlačhe šeja taro Isav, tare po phureder čhavo, save sesa ke late ano ćher thaj urada e Jakove, pe ciknjedere čhave. <verse eid="GEN 27:15" /><verse number="16" style="v" sid="GEN 27:16" />E buzorenđe morčhencar učharda lese vasta thaj lesi kor kaj ni sasa le bala. <verse eid="GEN 27:16" /><verse number="17" style="v" sid="GEN 27:17" />Pale gova dija pe čhavese e Jakovese ane vasta o ukusno xape thaj o mangro savo peklja.<verse eid="GEN 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 27:18" />Tegani o Jakov đelo ke po dad thaj phenda: “Dade!”</para>
  <para style="p" vid="GEN 27:18">O Isaak phenda: “Aktaljem. Savo san tu tare me čhave?”<verse eid="GEN 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 27:19" />O Jakov phenda pe dadese: “Me sem o Isav, ćiro emphureder čhavo. Ćerdem sar so phendan manđe. Akana, moliv tut, podušti thaj beš te xa tari divljo životinja sava astardem, pa te blagoslovi man.”<verse eid="GEN 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 27:20" />O Isaak pučlja pe čhave: “Sar gaći sigate arakhljan la, mo čhavo?”</para>
  <para style="p" vid="GEN 27:20">Vov phenda: “Golese kaj pomožisada manđe o GOSPOD, ćiro Dol.”<verse eid="GEN 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 27:21" />Tegani phenda o Isaak e Jakovese: “Av po paše, mo čhavo, te pipiv tut čače li san mo čhavo o Isav il naj san.”<verse eid="GEN 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 27:22" />O Jakov avilo popaše paše po dad o Isaak, savo pipisada le thaj phenda: “O glaso si e Jakoveso, al e vasta e Isavese.”<verse eid="GEN 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 27:23" />O Isaak ni pindžarda le, golese kaj e vasta e Jakovese sesa balale sar lese phralese e Isavese. Kana manglja te blagoslovil le, <verse eid="GEN 27:23" /><verse number="24" style="v" sid="GEN 27:24" />pučlja vadži jekh drom: “Tu li san čače o Isav?”</para>
  <para style="p" vid="GEN 27:24">O Jakov phenda: “Me sem.”<verse eid="GEN 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 27:25" />Tegani o Isaak phenda: “Mo čhavo, an manđe te xav tari divljo životinja sava astardan, pa te blagosloviv tut.”</para>
  <para style="p" vid="GEN 27:25">Gija o Jakov dija le thaj o Isaak xalja. Thaj anda lese mol, a vov pilja.<verse eid="GEN 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 27:26" />Pale gova leso dad o Isaak phenda lese: “Av popaše mo čhavo, thaj čumide man!”<verse eid="GEN 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 27:27" />O Jakov avilo thaj čumidija le. Kana o Isaak osetisada o miris tare lese šeja, blagoslovisada le vaćarindoj:</para>
  <para style="b" vid="GEN 27:27" />
  <para style="q1" vid="GEN 27:27">“O miris me čhaveso</para>
  <para style="q2" vid="GEN 27:27">si sar o miris taro polje</para>
  <para style="q1" vid="GEN 27:27">savo blagoslovisada o GOSPOD.<verse eid="GEN 27:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 27:28" />O Dol te dol tut e nebosi rosa</para>
  <para style="q2" vid="GEN 27:28">thaj plodno phuv,</para>
  <para style="q1" vid="GEN 27:28">but điv thaj terni mol.<verse eid="GEN 27:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 27:29" />E narodura te služin tut</para>
  <para style="q2" vid="GEN 27:29">thaj e plemenura te peren tuće ke koča!</para>
  <para style="q1" vid="GEN 27:29">Vladi pe će phrala</para>
  <para style="q2" vid="GEN 27:29">thaj te peren tuće ke koča</para>
  <para style="q2" vid="GEN 27:29">e potomkura će daće!</para>
  <para style="q1" vid="GEN 27:29">Harami te avol savo dol tut armaja,</para>
  <para style="q2" vid="GEN 27:29">a blagoslovimo te avol savo tut blagoslovil!”<verse eid="GEN 27:29" /></para>
  <para style="b" />
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30" />Samo so o Jakov đelo tare po dad o Isaak pale gova so vov blagoslovisada le, irisajlo leso phral o Isav andaro lov. <verse eid="GEN 27:30" /><verse number="31" style="v" sid="GEN 27:31" />Thaj i o Isav ćerda ukusno xape, anda pe dadese thaj phenda: “Dade, moliv tut, podušti thaj beš te xa tari divljo životinja sava astardem, pa te blagoslovi man.”<verse eid="GEN 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 27:32" />Leso dad o Isaak pučlja le: “Ko san tu?”</para>
  <para style="p" vid="GEN 27:32">Vov phenda: “Me sem ćo emphureder čhavo o Isav.”<verse eid="GEN 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 27:33" />Tegani but darajlo o Isaak thaj phenda: “Pa ko sasa kova so astarda e divljona životinja thaj anda manđe? Xaljem angleder so tu aviljan. Blagoslovisadem le thaj vov ka ačhol blagoslovime.”<verse eid="GEN 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 27:34" />Kana šunda o Isav e lafura pe dadese, zurale thaj ćerče ruja thaj phenda pe dadese: “Blagoslovi i man, dade!”<verse eid="GEN 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 27:35" />Al o Isaak phenda lese: “Ćo phral avilo thaj xoxaimasa lija ćo blagoslov.”<verse eid="GEN 27:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 27:36" />Tegani o Isav phenda: “Naj ni čudno so leso alav si Jakov, golese kaj već dujto drom xoxada man. Lija mo phurederipe, a akana lija thaj mo blagoslov.”</para>
  <para style="p" vid="GEN 27:36">Pale gova pučlja: “Dal ni ačhadan manđe nijekh blagoslov?”<verse eid="GEN 27:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 27:37" />O Isaak vaćarda lese: “Le postavisadem sar ćiro gospodari thaj sa lese phralen dijem te aven lese sluge. Blagoslovisadem le đivesa thaj terne moljasa. Akana naj khanči so te ćerav tuće, mo čhavo!”<verse eid="GEN 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 27:38" />O Isav phenda pe dadese: “Pa jekh li blagoslov isi tut, dade? Blagoslovi i man, dade mingreja!”</para>
  <para style="p" vid="GEN 27:38">Tegani o Isav lija ano glaso te rovol.<verse eid="GEN 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 27:39" />A leso dad o Isaak vaćarda lese:</para>
  <para style="b" vid="GEN 27:39" />
  <para style="q1" vid="GEN 27:39">“Dur tari plodno phuv ka avol ćo ćher,</para>
  <para style="q2" vid="GEN 27:39">dur tari rosa e nebosi.<verse eid="GEN 27:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 27:40" />Ka ave džuvdo tare ćiro mačo</para>
  <para style="q2" vid="GEN 27:40">thaj će phralese ka služi.</para>
  <para style="q1" vid="GEN 27:40">Al kana ka buni tut,</para>
  <para style="q2" vid="GEN 27:40">leso jaram ka crde tare ćiri kor.”<verse eid="GEN 27:40" /></para>
  <para style="b" />
  <para style="p">
    <verse number="41" style="v" sid="GEN 27:41" />O Isav zamrzisada e Jakove bašo blagoslov savo o dad dija le, pa phenda pese: “Sigate ka merol mo dad. Tegani ka mudarav me phrale e Jakove.”<verse eid="GEN 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 27:42" />Kana vaćarde e Revekaće so lako emphureder čhavo o Isav manđol te ćerol, voj bičhalda te akharen laće čhave e Jakove thaj phenda lese: “Ćo phral o Isav dol gođi te mudarol tut! <verse eid="GEN 27:42" /><verse number="43" style="v" sid="GEN 27:43" />Golese, mo čhavo, šun man! Sigate naš ke mo phral o Lavan ano Haran. <verse eid="GEN 27:43" /><verse number="44" style="v" sid="GEN 27:44" />Ačh ke leste nesavo vreme, dži kaj i holi ćire phralesi ni naćhol. <verse eid="GEN 27:44" /><verse number="45" style="v" sid="GEN 27:45" />Kana ka naćhol i holi će phralesi thaj kana ka zabistrol so ćerdan lese, ka bičhalav nekas pale tute te iri tut. Sose solduje čhaven te hasarav ano jekh đive?”<verse eid="GEN 27:45" /></para>
  <para style="s">O Jakov našol ano Padan-Aram</para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 27:46" />Pale gova i Reveka phenda e Isaakose: “Mo džuvdipe smučisajlo tare kala Hetitkinje. Te i o Jakov lija romnja tare Hetitkinje save si tari kaja phuv, so trubul man kava džuvdipe!”<verse eid="GEN 27:46" /></para>
  <chapter eid="GEN 27" />
  <chapter number="28" style="c" sid="GEN 28" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1" />Tegani o Isaak akharda e Jakove, blagoslovisada le thaj zapovedisada lese: “Ma le romnja maškare hanaanska čheja! <verse eid="GEN 28:1" /><verse number="2" style="v" sid="GEN 28:2" />Sigate dža ano Padan-Aram, ano ćher e Betuileso, ko dad ćire dako, thaj odori arakh tuće romnja, jekha tare čheja e Lavanese, će ujkose. <verse eid="GEN 28:2" /><verse number="3" style="v" sid="GEN 28:3" />O Emzuralo Dol te blagoslovil tut thaj te ćerol tutar bute manušen thaj tutar te ćerdon but narodura. <verse eid="GEN 28:3" /><verse number="4" style="v" sid="GEN 28:4" />Nek pe tute thaj pe ćire potomkura avol o blagoslov e Avraameso, te prele i phuv ane savi akana beše sar abandžija, a savi o Dol dija e Avraamese.”<verse eid="GEN 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 28:5" />Gija o Isaak bičhalda e Jakove ano Padan-Aram thaj vov đelo ko Lavan, čhavo e Betuileso o Aramejcoso, phral e Revekako, Jakovese thaj e Isavese dejako.<verse eid="GEN 28:5" /></para>
  <para style="s">O Isav palem ženil pe</para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 28:6" />O Isav dodžanglja kaj blagoslovisada o Isaak e Jakove thaj bičhalda le ano Padan-Aram te araćhol odori pese romnja, vaćarindoj: “Ma le romnja maškare hanaanska čheja,” <verse eid="GEN 28:6" /><verse number="7" style="v" sid="GEN 28:7" />thaj kaj o Jakov šunda pe dade thaj pe da thaj đelo ano Padan-Aram. <verse eid="GEN 28:7" /><verse number="8" style="v" sid="GEN 28:8" />Gija o Isav shvatisada kobor si e hanaanska čheja bimangle lese dadese e Isaakose, <verse eid="GEN 28:8" /><verse number="9" style="v" sid="GEN 28:9" />pa đelo o Isaak ko Jišmael thaj paše romnja so sasa le, lija romnjaće e Mahalata. Voj sasa čhej e Jišmaelesi, unuka e Avraamesi, thaj sasa phen e Nevajotesi.<verse eid="GEN 28:9" /></para>
  <para style="s">E Jakoveso suno ano Betel</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10" />O Jakov andari Beer-Ševa đelo ano Haran. <verse eid="GEN 28:10" /><verse number="11" style="v" sid="GEN 28:11" />Kana avilo dži ko nesavo than gothe suta, golese kaj o kham nakhlo. Lija jekh bar tare gova than, čhuta le talo šoro thaj ke gova than pašlilo te sovol. <verse eid="GEN 28:11" /><verse number="12" style="v" sid="GEN 28:12" />Ano suno dikhlja sluba sar ačhol ki phuv, savi pe vrhosa sasa dži ko nebo. E Devlese anđelura pe lende uštena thaj uljena. <verse eid="GEN 28:12" /><verse number="13" style="v" sid="GEN 28:13" />A upreder i sluba sasa o GOSPOD thaj phenda: “Me sem o GOSPOD, Dol e Avraameso thaj e Isaakoso. I phuv kaj pašljo ka dav tuće thaj će potomkurenđe. <verse eid="GEN 28:13" /><verse number="14" style="v" sid="GEN 28:14" />Ćire potomkura ka aven sar praho ki phuv. Ka širin tumen ko zapad thaj ko istok, ko sever thaj ko jug. Prekal tute thaj će potomkura ka blagosloviv sa e naroduren ki phuv. <verse eid="GEN 28:14" /><verse number="15" style="v" sid="GEN 28:15" />Me sem tusa thaj ka arakhav tut kaj dža. Ka anav tut palal ki kaja phuv. Ni ka ačhavav tut sa dži kaj ni pherav kova so obećisadem tuće.”<verse eid="GEN 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 28:16" />Kana o Jakov uštilo taro sojipe, phenda: “Čače o GOSPOD si ke kava than, a me ni džangljem!” <verse eid="GEN 28:16" /><verse number="17" style="v" sid="GEN 28:17" />Thaj ani dar phenda: “Sar si kava than strašno! Kava naj aver nego e Devleso ćher! Kava si i kapija e nebosi!”<verse eid="GEN 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 28:18" />O Jakov uštilo rano ki sabalin, lija kova bar savo čhuta talo šoro, vazdija le sar stubo thaj pe leste čhorda ulje. <verse eid="GEN 28:18" /><verse number="19" style="v" sid="GEN 28:19" />Gova than akharda Betel<note caller="+" style="f"><char style="fr" closed="false">28,19 </char><char style="ft" closed="false">Gova značil: “E Devleso ćher.”</char></note>. (Gova foro angleder akhardilo Luz.)<verse eid="GEN 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 28:20" />Tegani o Jakov xalja sovli: “Ako ka avol o Dol mancar, ako ka araćhol man ke kava drom kaj džav, ako ka dol man mangro xamase thaj šeja urajimase, <verse eid="GEN 28:20" /><verse number="21" style="v" sid="GEN 28:21" />pa džuvdo thaj sasto iriv man ano ćher me dadeso, tegani tu GOSPODE ka ave mo Dol. <verse eid="GEN 28:21" /><verse number="22" style="v" sid="GEN 28:22" />A kava bar savo vazdijem sar stubo ka avol e Devleso ćher. A tare sa so de man, Devla, ka dav tuće dešto kotor.”<verse eid="GEN 28:22" /></para>
  <chapter eid="GEN 28" />
  <chapter number="29" style="c" sid="GEN 29" />
  <para style="s">O Jakov reslo ano Haran</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1" />O Jakov nastavisada o drom thaj reslo ani phuv ke istočna narodura. <verse eid="GEN 29:1" /><verse number="2" style="v" sid="GEN 29:2" />Tari jekh drom dikhlja ano polje bunari paše savo pašljon trin stadura bakre. Tare gova bunari dena gole bakren te pijen paj, thaj po bunari sasa čhuto baro bar. <verse eid="GEN 29:2" /><verse number="3" style="v" sid="GEN 29:3" />Kana bi ćidena pe sa e stadura ke gova than, e čobanura bi crdena o bar taro bunari thaj e bakre bi pijena. Pale gova bi palem irina o bar ke leso than.<verse eid="GEN 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 29:4" />O Jakov pučlja len: “Katar sen, phralalen?”</para>
  <para style="p" vid="GEN 29:4">Von vaćarde lese: “Taro Haran.”<verse eid="GEN 29:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 29:5" />Tegani o Jakov pučlja len: “Pindžaren li e Lavane, e Nahorese unuko?”</para>
  <para style="p" vid="GEN 29:5">Von phende lese: “Pindžara.”<verse eid="GEN 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 29:6" />O Jakov palem pučlja: “Sar si vov?”</para>
  <para style="p" vid="GEN 29:6">E čobanura irisade lese: “Šukar si. Akh, baš lesi čhej i Rahilja avol lese bakrencar.”<verse eid="GEN 29:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 29:7" />Tegani o Jakov phenda: “Akh, o kham si vadži učo. Vadži naj vreme te ćiden pe e bakre te soven. Den e bakren te pijen pa tegani mućhen len te čaren.”<verse eid="GEN 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 29:8" />Von lese phende: “Našti gova te ćera dži kaj ni ćiden pe sa e stadura e bakrencar thaj dži kaj ni crda o bar taro bunari. Tegani šaj da e bakren te pijen paj.”<verse eid="GEN 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 29:9" />Dži kaj o Jakov vadži vaćarola lencar, i Rahilja avili pe dadese bakrencar, golese kaj voj sasa čobanica. <verse eid="GEN 29:9" /><verse number="10" style="v" sid="GEN 29:10" />Kana o Jakov dikhlja e Rahilja, e čheja pe ujkose e Lavanese, thaj e Lavanese bakren, avilo dži o bunari, crdija o bar thaj dija pe ujkose bakren te pijen paj. <verse eid="GEN 29:10" /><verse number="11" style="v" sid="GEN 29:11" />Tegani o Jakov čumidija e Rahilja, thaj zurale lija te rovol. <verse eid="GEN 29:11" /><verse number="12" style="v" sid="GEN 29:12" />Pale gova o Jakov phenda e Rahiljaće kaj si vov laće dadese phejako čhavo, čhavo e Revekako. I Rahilja prastija thaj gova vaćarda pe dadese.<verse eid="GEN 29:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 29:13" />Kana šunda o Lavan o haberi kaj avilo o Jakov, lese phejako čhavo, prastija angle leste. Grlisada le, čumidija le thaj inđarda le ane po ćher.</para>
  <para style="p" vid="GEN 29:13">Kana o Jakov vaćarda e Lavanese sa so sasa lesa, <verse eid="GEN 29:13" /><verse number="14" style="v" sid="GEN 29:14" />o Lavan phenda: “Čače san mingro rat thaj mingro telo!”</para>
  <para style="s" vid="GEN 29:14">O Jakov lol romnjaće e Lija thaj e Rahilja</para>
  <para style="p" vid="GEN 29:14">Kana ačhilo o Jakov ko Lavan čhon đive, <verse eid="GEN 29:14" /><verse number="15" style="v" sid="GEN 29:15" />o Lavan phenda e Jakovese: “Dal ka služi man bizi plata golese kaj san me phejako čhavo? Phen manđe sar manđe te poćinav tut?”<verse eid="GEN 29:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 29:16" />E Lavane sesa duj čheja. I phureder akhardola Lija a i poterni Rahilja. <verse eid="GEN 29:16" /><verse number="17" style="v" sid="GEN 29:17" />E Lija sesa lačhe jakha, al e Rahilja sasa lačho telo thaj sasa but lačhi. <verse eid="GEN 29:17" /><verse number="18" style="v" sid="GEN 29:18" />A golese kaj o Jakov manglja e Rahilja, phenda: “Ka služiv tut efta berš će pocikne čhejaće e Rahiljaće.”<verse eid="GEN 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 29:19" />O Lavan phenda: “Pošukar te dav la tuće nego nesave averese. Ačh ke mande!”<verse eid="GEN 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 29:20" />Gija o Jakov služisada e Rahiljaće efta berš, al ćerdilo lese taro manglipe premale late kaj nakhle nekobor đivesa.<verse eid="GEN 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 29:21" />Tegani o Jakov phenda e Lavanese: “De man me romnja, te lav la romnjaće, golese kaj o vreme me služimaso nakhlo.”<verse eid="GEN 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 29:22" />O Lavan ćidija sa e manušen andar gova than thaj ćerda bari gozba. <verse eid="GEN 29:22" /><verse number="23" style="v" sid="GEN 29:23" />Al kana peli i rat, lija pe phuredere čheja e Lija thaj la inđarda e Jakovese thaj vov suta lasa. <verse eid="GEN 29:23" /><verse number="24" style="v" sid="GEN 29:24" />O Lavan dija pe čhejaće e Lijaće e robinja e Zilpa, te avol laći sluškinja. <verse eid="GEN 29:24" /><verse number="25" style="v" sid="GEN 29:25" />Kana avili i sabalin, o Jakov dikhlja kaj suta e Lijasa!</para>
  <para style="p" vid="GEN 29:25">Tegani o Jakov phenda e Lavanese: “Sose gova ćerdan? Na li služisadem tut e Rahiljaće? Sose xoxadan man?”<verse eid="GEN 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 29:26" />O Lavan phenda: “Akate amende naj o adeti i poterni čhej te lol rome angleder i phureder. <verse eid="GEN 29:26" /><verse number="27" style="v" sid="GEN 29:27" />Nakhav e abaveso kurko e Lijasa, pa tegani ka dav tut i e dujtona, savaće ka služi man vadži aver efta berš.” <verse eid="GEN 29:27" /><verse number="28" style="v" sid="GEN 29:28" />O Jakov gija ćerda. Nakhada e abaveso kurko e Lijasa, pa tegani o Lavan dija le pe čheja e Rahilja romnjaće. <verse eid="GEN 29:28" /><verse number="29" style="v" sid="GEN 29:29" />O Lavan dija pe čhejaće e Rahilja e robinja e Bilha, te avol laći sluškinja. <verse eid="GEN 29:29" /><verse number="30" style="v" sid="GEN 29:30" />Gija o Jakov suta i e Rahiljasa thaj la manglja pobut nego e Lija. Pale gova e Lavane služisada vadži efta berš.<verse eid="GEN 29:30" /></para>
  <para style="s">E Jakovese čhave</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31" />O GOSPOD dikhlja kaj i Lija naj mangli taro Jakov, golese putarda lako vođi te ačhol khamni, al i Rahilja naštine te ačhol khamni.<verse eid="GEN 29:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 29:32" />I Lija ačhili khamni thaj bijanda čhave. Dija le alav Ruvim<note caller="+" style="f"><char style="fr" closed="false">29,32 </char><char style="fq" closed="false">Ruvim </char><char style="ft" closed="false">Značil: “Dikh, muršoro.”</char></note>, a gova si sar voj so phenda: “O GOSPOD dikhlja mo pharipe, akana mo rom ka manđol man.”<verse eid="GEN 29:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 29:33" />I Lija palem ačhili khamni, bijanda čhave thaj phenda: “O GOSPOD šunda kaj mo rom ni manđol man, golese dija man i kale čhave.” Golese dija le alav Simeon<note caller="+" style="f"><char style="fr" closed="false">29,33 </char><char style="fq" closed="false">Simeon </char><char style="ft" closed="false">Značil: “Te šunol.”</char></note>.<verse eid="GEN 29:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 29:34" />Gija pale ačhili khamni, bijanda čhave thaj phenda: “Akana mo rom ka sikavol manđe manglipe, golese so bijandem lese trine murše čhaven.” Golese dija le alav Levije<note caller="+" style="f"><char style="fr" closed="false">29,34 </char><char style="fq" closed="false">Levi </char><char style="ft" closed="false">Značil: “Te phandol katane.”</char></note>.<verse eid="GEN 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 29:35" />A kana vadži jekh drom ačhili khamni thaj bijanda čhave, phenda: “Kava drom ka zahvaliv e GOSPODESE.” Golese akharda e čhave Juda<note caller="+" style="f"><char style="fr" closed="false">29,35 </char><char style="fq" closed="false">Juda </char><char style="ft" closed="false">Značil: “Te zahvalil.”</char></note>.</para>
  <para style="p" vid="GEN 29:35">Pale gova i Lija ačhada te bijanol.<verse eid="GEN 29:35" /></para>
  <chapter eid="GEN 29" />
  <chapter number="30" style="c" sid="GEN 30" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1" />Kana dikhlja i Rahilja kaj naštine te ačhol khamni, postanisada ljubomorno pe piri phen i Lija thaj phenda e Jakovese: “De ma čhaven, il ka merav.”<verse eid="GEN 30:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 30:2" />O Jakov holjajlo pi Rahilja thaj vaćarda laće: “Me li sem o Dol, savo ni dija tut čhaven?”<verse eid="GEN 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 30:3" />Tegani voj phenda: “Akh, mi sluškinja i Bilha. Sov lasa, te bijanol manđe ke koča, gija man te aven čhave prekal late.”<verse eid="GEN 30:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 30:4" />Gija dija le pe sluškinja e Bilha romnjaće thaj o Jakov suta lasa. <verse eid="GEN 30:4" /><verse number="5" style="v" sid="GEN 30:5" />Voj ačhili khamni thaj bijanda lese čhave. <verse eid="GEN 30:5" /><verse number="6" style="v" sid="GEN 30:6" />Tegani i Rahilja phenda: “O Dol presudisada ane mingro korist. Šunda mi molitva thaj dija man čhave.” Gija dija le alav Dan<note caller="+" style="f"><char style="fr" closed="false">30,6 </char><char style="fq" closed="false">Dan </char><char style="ft" closed="false">Značil: “Te presudil.”</char></note>.<verse eid="GEN 30:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 30:7" />E Rahiljaći sluškinja i Bilha palem ačhili khamni thaj bijanda e Jakovese dujtone čhave. <verse eid="GEN 30:7" /><verse number="8" style="v" sid="GEN 30:8" />Tegani i Rahilja phenda: “Bari sasa mi borba me phejasa, al me pobedisadem.” Gija dija alav e čhave Neftalim<note caller="+" style="f"><char style="fr" closed="false">30,8 </char><char style="fq" closed="false">Neftalim </char><char style="ft" closed="false">Značil: “Mi borba.”</char></note>.<verse eid="GEN 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 30:9" />Kana dikhlja i Lija kaj ačhili te bijanol, lija pe sluškinja e Zilpa thaj dija la e Jakovese te avol lesi romni. <verse eid="GEN 30:9" /><verse number="10" style="v" sid="GEN 30:10" />Thaj e Lijaći sluškinja i Zilpa bijanda e Jakovese čhave. <verse eid="GEN 30:10" /><verse number="11" style="v" sid="GEN 30:11" />Tegani lesi romni i Lija vaćarda: “Savi bax!” Gija dija le alav Gad<note caller="+" style="f"><char style="fr" closed="false">30,11 </char><char style="fq" closed="false">Gad </char><char style="ft" closed="false">Značil: “Bax.”</char></note>.<verse eid="GEN 30:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 30:12" />E Lijaći sluškinja i Zilpa e Jakovese bijanda vadži jekhe murše. <verse eid="GEN 30:12" /><verse number="13" style="v" sid="GEN 30:13" />Tegani i Lija vaćarda: “Čače sem baxtali! E džuvlja ka akharen man baxtali!” Gija dija le alav Asir<note caller="+" style="f"><char style="fr" closed="false">30,13 </char><char style="fq" closed="false">Asir </char><char style="ft" closed="false">Značil: “Baxtalo.”</char></note>.<verse eid="GEN 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 30:14" />Jekh drom, ano vreme kana ćidol pe o điv, đelo o Ruvim ko polje. Gothe arakhlja biljke mandragore<note caller="+" style="f"><char style="fr" closed="false">30,14 </char><char style="fq" closed="false">mandragore </char><char style="ft" closed="false">Ane gova vreme smatrisada pe kaj goja biljka zuravol o bijandipe ke romnja.</char></note> thaj inđarda pe daće e Lijaće. I Rahilja phenda e Lijaće: “Moliv tut, de ma zala mandragore će čhavese.”<verse eid="GEN 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 30:15" />I Lija phenda laće: “Naj li tuće zala so lijan me rome, akana manđe te le e mandragore me čhavestar?”</para>
  <para style="p" vid="GEN 30:15">I Rahilja phenda laće: “Šukar. Nek o Jakov pašljol erat tusa ani zamena baše gola mandragore će čhavese.”<verse eid="GEN 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 30:16" />Kana ki rat o Jakov avilo taro polje, i Lija iklili angle leste thaj phenda lese: “Erat ka sove mancar, golese kaj poćindem tut me čhavese mandragorencar.” Gija o Jakov suta goja rat e Lijasa.<verse eid="GEN 30:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 30:17" />O Dol šunda e Lijaći molitva, voj ačhili khamni thaj e Jakovese bijanda pandžtone murše. <verse eid="GEN 30:17" /><verse number="18" style="v" sid="GEN 30:18" />Tegani i Lija phenda: “O Dol dija man nagrada golese so dijem me romese me sluškinja.” Gija dija e čhavese alav Isahar<note caller="+" style="f"><char style="fr" closed="false">30,18 </char><char style="fq" closed="false">Isahar </char><char style="ft" closed="false">Značil: “Nagrada.”</char></note>.<verse eid="GEN 30:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 30:19" />I Lija pale ačhili khamni thaj e Jakovese bijanda šovtone čhave. <verse eid="GEN 30:19" /><verse number="20" style="v" sid="GEN 30:20" />Tegani i Lija phenda: “O Dol dija man but dragoceno daro. Akana mo rom ka poštujil man, golese kaj bijandem lese šov čhave.” Gija dija le alav Zavulon<note caller="+" style="f"><char style="fr" closed="false">30,20 </char><char style="fq" closed="false">Zavulon </char><char style="ft" closed="false">Značil: “Poštujipe.”</char></note>.<verse eid="GEN 30:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 30:21" />Pale gova bijanda čheja thaj dija la alav Dina.<verse eid="GEN 30:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 30:22" />Tegani o Dol dija pe gođi e Rahiljaće, šunda laći molitva thaj putarda lako vođi te ačhol khamni. <verse eid="GEN 30:22" /><verse number="23" style="v" sid="GEN 30:23" />Gija ačhili khamni, bijanda čhave thaj phenda: “O Dol crdija mingri ladž!” <verse eid="GEN 30:23" /><verse number="24" style="v" sid="GEN 30:24" />Dija le alav Josif<note caller="+" style="f"><char style="fr" closed="false">30,24 </char><char style="fq" closed="false">Josif </char><char style="ft" closed="false">Značil: “Nek dol vadži.”</char></note>, vaćarindoj: “O GOSPOD nek dol man vadži jekhe čhave!”<verse eid="GEN 30:24" /></para>
  <para style="s">O Jakov thaj o Lavan</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25" />Kana bijanda i Rahilja e Josife, o Jakov phenda e Lavanese: “Mukh man te džav ćhere, ano than kaj bijandiljem! <verse eid="GEN 30:25" /><verse number="26" style="v" sid="GEN 30:26" />De man me romnjen thaj mingre čhaven, baše save služisadem tut, pa te šaj džav. Golese kaj tu šukar džane kobor bući ćerdem tuće.”<verse eid="GEN 30:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 30:27" />Al o Lavan phenda lese: “Te arakhljem milost ane ćire jakha, ma dža khatinde! Dikhljarimasa dodžangljem kaj o GOSPOD blagoslovisada man baše tute.” <verse eid="GEN 30:27" /><verse number="28" style="v" sid="GEN 30:28" />Thaj vadži phenda: “Rode plata savi manđe, thaj me ka dav tut.”<verse eid="GEN 30:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 30:29" />O Jakov phenda lese: “Tu šukar džane sar služisadem tut thaj sar sasa će stokaće dži kaj dikhljem la. <verse eid="GEN 30:29" /><verse number="30" style="v" sid="GEN 30:30" />Kova zala so sasa tut angleder so aviljem, akana but barilo, golese kaj o GOSPOD blagoslovisada kaj god čhutem mo pingro. Naj li vreme te počniv te ćerav bući mingre familijaće?”<verse eid="GEN 30:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 30:31" />O Lavan pučlja: “Sar te poćinav tuće?”</para>
  <para style="p" vid="GEN 30:31">O Jakov phenda lese: “Ma poćin manđe khanči! Al ka ačhav te arakhav će bakren thaj te inđarav len te čaron, ako ka ćere manđe kava: <verse eid="GEN 30:31" /><verse number="32" style="v" sid="GEN 30:32" />Mukh ma te džav avđive maškar će sa e stadura e bakrenđe thaj te ikalav sa e pegavone thaj e šarime bakren, sa e kale bakroren, thaj dži jekha šarime il pegavona buznja. Gova nek avol mi plata! <verse eid="GEN 30:32" /><verse number="33" style="v" sid="GEN 30:33" />Kana ka ave te dićhe e stoka sava lijem sar plata, nek mingro poštenje svedočil manđe. Dži jekh buzni savi naj šarimi thaj pegavo thaj dži jekh bakroro savo naj kalo, a arakhadol mande, nek avol kaj si čordano.”<verse eid="GEN 30:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 30:34" />O Lavan phenda: “Šukar. Nek avol sar so phendan.” <verse eid="GEN 30:34" /><verse number="35" style="v" sid="GEN 30:35" />Al gova isto đive o Lavan crdija sa e prugastone thaj e šarime buzen, i sa e pegavone thaj e šarime buznjen. Thaj dija sa save sasa len zala parno thaj sa e kale bakren ke pe čhave te araćhen len. <verse eid="GEN 30:35" /><verse number="36" style="v" sid="GEN 30:36" />Tegani gothar đelo dur trin đive phiripe taro Jakov, dži kaj o Jakov ačhilo te čaravol avera e Lavanese stadura.<verse eid="GEN 30:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 30:37" />O Jakov lija zelena kašta tari topola, taro bademo thaj taro kesteno, pa ane lende urezisada parne pruge gija so ranglja i kora dži kaj ni dićhilo o parnipe taro kaš. <verse eid="GEN 30:37" /><verse number="38" style="v" sid="GEN 30:38" />Tegani e rangle raja čhuta ane balije, te aven angli stoka kana bi avena te pijen paj. Gothe i stoka bi parila pe, kana bi avena te pijen paj. <verse eid="GEN 30:38" /><verse number="39" style="v" sid="GEN 30:39" />Gija bi i stoka parila pe angle raja. A sa so bijandona sesa prugasta, pegava thaj šarime.<verse eid="GEN 30:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 30:40" />O Jakov crdija e terne životinjen, al averen irisada te dićhen ane prugasta thaj ane kale životinje save preperena e Lavanese. Gija o Jakov pese dobisada odvojime stadura thaj ni mešisada len e Lavanese stokasa. <verse eid="GEN 30:40" /><verse number="41" style="v" sid="GEN 30:41" />Kana e zurale životinje taro stado parina pe, o Jakov bi čhuvola e rangle raja ane balije angle životinje te bi parina pe angle lende. <verse eid="GEN 30:41" /><verse number="42" style="v" sid="GEN 30:42" />Al angle slaba životinje o Jakov ni čhuvola e granke. Gija e slaba bi preperena e Lavanese, a e zurale e Jakovese. <verse eid="GEN 30:42" /><verse number="43" style="v" sid="GEN 30:43" />O Jakov gija but barvajlo, thaj steknisada but stoka, sluškinjen thaj slugen, kamilen thaj heren.<verse eid="GEN 30:43" /></para>
  <chapter eid="GEN 30" />
  <chapter number="31" style="c" sid="GEN 31" />
  <para style="s">O Jakov našol taro Lavan</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1" />O Jakov šunda sar maškar peste e Lavanese čhave vaćaren: “Sa so sasa amare dade, lija o Jakov. Sa kava barvalipe steknisada pe kova so preperola amare dadese.”<verse eid="GEN 31:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 31:2" />Thaj o Jakov primetisada kaj o Lavan naj le gova amalipe sar angleder premal leste.<verse eid="GEN 31:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 31:3" />Tegani o GOSPOD phenda e Jakovese: “Iri tut ani phuv će paradadenđi, ki ćiri familija. Me ka avav tusa.”<verse eid="GEN 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 31:4" />Tegani, o Jakov bičhalda te vaćaren e Rahiljaće thaj e Lijaće te aven ano polje, kaj sesa lese bakre, <verse eid="GEN 31:4" /><verse number="5" style="v" sid="GEN 31:5" />thaj phenda lenđe: “Me primetisadem kaj tumaro dad o Lavan naj le gova amalipe sar angleder premal mande. Al o Dol me dadeso sasa mancar. <verse eid="GEN 31:5" /><verse number="6" style="v" sid="GEN 31:6" />Tumen džanen kaj služisadem tumare dade sa me zuralimasa, <verse eid="GEN 31:6" /><verse number="7" style="v" sid="GEN 31:7" />a vov ipak xoxada man, deš droma mi plata menjisada. Al o Dol ni dija te ćerol manđe bilačhipe. <verse eid="GEN 31:7" /><verse number="8" style="v" sid="GEN 31:8" />Kana god phenda manđe: ‘Sa e pegava te aven ći plata’, tegani bi ane sa e stadura e terne bijandona pegava. A kana god phenda: ‘Sa e prugasta te aven ći plata’, tegani bi ane sa e stadura bijandona prugasta. <verse eid="GEN 31:8" /><verse number="9" style="v" sid="GEN 31:9" />Gija o Dol lija e stoka tumare dadestar thaj dija la manđe.<verse eid="GEN 31:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 31:10" />Jekh drom, ano vreme kana parila pe o stado, ano suno dikhljem kaj e buze save parina pe e buznjenca, sesa prugasta, pegava il šarime. <verse eid="GEN 31:10" /><verse number="11" style="v" sid="GEN 31:11" />O anđelo e Devleso phenda manđe ano suno: ‘Jakove!’ Me phendem: ‘Aktaljem!’ <verse eid="GEN 31:11" /><verse number="12" style="v" sid="GEN 31:12" />A o anđelo phenda manđe: ‘Vazde će jakha thaj ka dićhe kaj e buze save parin pe e buznjenca si prugasta, pegava thaj šarime. Golese kaj, dikhljem sa so o Lavan ćerol tusa. <verse eid="GEN 31:12" /><verse number="13" style="v" sid="GEN 31:13" />Me sem o Dol taro Betel, kaj e uljesa makhljan o stubo thaj kaj xaljan sovli. Akana ušti thaj dža tare kaja phuv thaj iri tut ane ćo bijando than!’ ”<verse eid="GEN 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 31:14" />Pe gova phende e Jakovese i Rahilja thaj Lija: “Isi li amen vadži nesavo kotor taro nasledstvo ano ćher amare dadeso? <verse eid="GEN 31:14" /><verse number="15" style="v" sid="GEN 31:15" />Na li amaro dad dićhol amen sar abandžiken? Na samo kaj bićinda amen, nego i trošisada sa kova so sasa lese poćindo amenđe! <verse eid="GEN 31:15" /><verse number="16" style="v" sid="GEN 31:16" />Sa gova barvalipe so o Dol lija amare dadestar, čače si amaro thaj amare čhavengo. Golese ćer sa so o Dol phenda tuće!”<verse eid="GEN 31:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 31:17" />Pe gova o Jakov čhuta ke kamile pe čhaven thaj pe romnjen, <verse eid="GEN 31:17" /><verse number="18" style="v" sid="GEN 31:18" />angle peste čhuta pe stoka, sa po barvalipe so steknisada ano Padan-Aram, pa pojdisada ani phuv i Hanaansko, ke po dad o Isaak.<verse eid="GEN 31:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 31:19" />Kana o Lavan đelo te randol e bakren, i Rahilja čorda e idoluren andar pe dadeso ćher. <verse eid="GEN 31:19" /><verse number="20" style="v" sid="GEN 31:20" />O Jakov xoxada e Lavane e Aramejco golese kaj ni phenda lese kaj ka džal. <verse eid="GEN 31:20" /><verse number="21" style="v" sid="GEN 31:21" />Gija našlo sa pe barvalimasa. Kana nakhlo i len o Eufrat, pojdisada premalo bregalo krajo o Gilad.<verse eid="GEN 31:21" /></para>
  <para style="s">O Lavan džal palo Jakov</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22" />O trito đive phende e Lavanese kaj našlo o Jakov. <verse eid="GEN 31:22" /><verse number="23" style="v" sid="GEN 31:23" />O Lavan lija e muršen andari piri familija, pa jurisada e Jakove efta đive angleder so reslja le ko bregalo krajo o Gilad.<verse eid="GEN 31:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 31:24" />Al o Dol sikadilo e Aramejcose e Lavanese prekali rat ano suno thaj phenda lese: “Dikh te ma phene khanči e Jakovese, ni šukar ni bilačhe!”<verse eid="GEN 31:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 31:25" />Kana o Lavan reslja e Jakove, o Jakov putarda po šatori ko bregalo krajo o Gilad, pa i o Lavan gothe bešlo e muršencar andari piri familija.<verse eid="GEN 31:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 31:26" />Tegani o Lavan phenda e Jakovese: “So ćerdan kava? Xoxadan man thaj inđardan me čhejen sar zarobljenice ano maripe! <verse eid="GEN 31:26" /><verse number="27" style="v" sid="GEN 31:27" />Sose čorale našljan? Sose xoxadan man thaj ni phendan manđe khanči? Isprativa bi tut veseljesa thaj điljencar, dairencar thaj harfencar? <verse eid="GEN 31:27" /><verse number="28" style="v" sid="GEN 31:28" />Ni dijan man te čumidav me unukuren thaj me čhejen? Naj šukar gova so ćerdan! <verse eid="GEN 31:28" /><verse number="29" style="v" sid="GEN 31:29" />Isi man zor te ćerav tuće bilačhipe, al o Dol ćire dadeso erat vaćarda manđe: ‘Dikh te ma phene khanči e Jakovese, ni šukar ni bilačhe!’ <verse eid="GEN 31:29" /><verse number="30" style="v" sid="GEN 31:30" />Džanav kaj đeljan golese so but mangljan te iri tut ane će dadeso ćher, al sose čordan me idoluren?”<verse eid="GEN 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 31:31" />O Jakov phenda e Lavanese: “Daraljem thaj dijem gođi kaj zorasa ka le će čhejen mandar. <verse eid="GEN 31:31" /><verse number="32" style="v" sid="GEN 31:32" />Al kaste ka araćhe će idoluren, kova ma te ačhol džuvdo. Korkoro dikh angle amare phrala isi li khanči ćiro ke mande, te isi, le gova!” Golese kaj o Jakov ni džanglja so i Rahilja čorda e idoluren.<verse eid="GEN 31:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 31:33" />Gija đelo o Lavan ano šatori e Jakoveso, ano šatori e Lijako thaj ano šatori e duje sluškinjengo, al khanči ni arakhlja. Kana iklilo andaro šatori e Lijako, đelo ano šatori e Rahiljako. <verse eid="GEN 31:33" /><verse number="34" style="v" sid="GEN 31:34" />Al i Rahilja lija e idoluren thaj garada len ano samari e kamilako thaj bešli pe leste. O Lavan rodija ke sa o šatori, al khanči ni arakhlja.<verse eid="GEN 31:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 31:35" />I Rahilja phenda pe dadese: “Ma holjavo pe mande, gospodarona mingreja, so našti uštav angle tute, golese kaj akana si pe mande kova so avol pe džuvlja svako čhon.”</para>
  <para style="p" vid="GEN 31:35">Gija o Lavan rodija thaj ni arakhlja pe idoluren.<verse eid="GEN 31:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 31:36" />Tegani o Jakov holajlo thaj lija te dol vika po Lavan, vaćarindoj: “Savo bilačhipe ćerdem tuće? Savo greh ćerdem so gaći but juri man? <verse eid="GEN 31:36" /><verse number="37" style="v" sid="GEN 31:37" />Akana kana rodijan ane sa so isi man, arakhljan li khanči so si ćiro? Čhuv gova angle mingre thaj ćire phrala, pa von nek aven sudije maškar amende dujende! <verse eid="GEN 31:37" /><verse number="38" style="v" sid="GEN 31:38" />Baše kala biš (20) berš so sema ke tute ni ćire bakre ni ćire buznja ni sesa bizo bijandipe, ni e bakren taro ćiro stado ni xaljem. <verse eid="GEN 31:38" /><verse number="39" style="v" sid="GEN 31:39" />So xalje e divlja zverura, ni andem tuće, nego poćindem tuće korkoro mandar baše gova. Tu mandar rodijan te poćinav tuće sa so čorda pe ko đive il ki rat. <verse eid="GEN 31:39" /><verse number="40" style="v" sid="GEN 31:40" />Akh sar sasa manđe: but droma ko đive sasa manđe tatipe, a ki rat sasa manđe but šul. O suno našlo tare mingre jakha. <verse eid="GEN 31:40" /><verse number="41" style="v" sid="GEN 31:41" />Biš berš služisadem tuće. Dešuštar (14) berš služisadem tut baše će čheja, a šov berš baši ći stoka, al tu deš droma menjisadan mi plata. <verse eid="GEN 31:41" /><verse number="42" style="v" sid="GEN 31:42" />Te ma avola mancar o Dol me dadeso, o Dol e Avraameso thaj o Dol e Isaakoso kas vov but poštujil, čače bi mučhesa man čuče vastencar. Al o Dol dikhlja mi muka thaj o trud me vastengo thaj erat ukorisada tut.”<verse eid="GEN 31:42" /></para>
  <para style="s">O Jakov thaj o Lavan phanden savez</para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43" />Pe gova o Lavan phenda e Jakovese: “Kala džuvlja si mingre čheja, kala čhave si mingre čhave, kala stadura si mingre stadura. Sa so dićhe si mingro. Al so avđive šaj ćerav kale mingre čhejenđe il lenđe čhavenđe saven bijande? <verse eid="GEN 31:43" /><verse number="44" style="v" sid="GEN 31:44" />Golese ajde te phanda savez, tu thaj me, gija te avol svedočanstvo maškare amende.”<verse eid="GEN 31:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 31:45" />Tegani o Jakov lija jekh bar thaj vazdija le sar stubo. <verse eid="GEN 31:45" /><verse number="46" style="v" sid="GEN 31:46" />Thaj phenda pe phralenđe: “Ćiden bara!”</para>
  <para style="m" vid="GEN 31:46">Gija von lije e bara, ćerde kupa thaj xalje paše late. <verse eid="GEN 31:46" /><verse number="47" style="v" sid="GEN 31:47" />O Lavan akharda goja kupa Jegar Sahaduta<note caller="+" style="f"><char style="fr" closed="false">31,47 </char><char style="fq" closed="false">Jegar Sahadut </char><char style="ft" closed="false">Kava ko aramejski značil: “Bara ki kupa sar svedočanstvo.”</char></note>, a o Jakov akharda la Galed<note caller="+" style="f"><char style="fr" closed="false">31,47 </char><char style="fq" closed="false">Galed </char><char style="ft" closed="false">Kava ko jevrejski značil: “Bara ki kupa sar svedočanstvo.”</char></note>.<verse eid="GEN 31:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="GEN 31:48" />Tegani o Lavan phenda: “Kaja kupa si avđive svedočanstvo maškar amende.”</para>
  <para style="m" vid="GEN 31:48">Golese dije la alav Galed.<verse eid="GEN 31:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="GEN 31:49" />A akharde la thaj Micpa<note caller="+" style="f"><char style="fr" closed="false">31,49 </char><char style="ft" closed="false">Micpa značil: “Kula stražara.”</char></note>, golese kaj o Lavan phenda: “Nek o GOSPOD stražaril maškar amende, kana ka ava dur jekh averestar. <verse eid="GEN 31:49" /><verse number="50" style="v" sid="GEN 31:50" />Ako ka ćere bilačhe me čhejencar il ako ka le avere romnjen paše lende, pa čak i te me ni džanav, de gođi kaj si o Dol svedoko maškar amende!”<verse eid="GEN 31:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="GEN 31:51" />O Lavan vadži phenda e Jakovese: “Dikh kaja kupa thaj kava stubo taro bar savo čhutem maškar amende. <verse eid="GEN 31:51" /><verse number="52" style="v" sid="GEN 31:52" />Kaja kupa thaj kava stubo si svedočanstvo kaj me ni ka nakhav prekali kaja kupa ki ćiri rig te ćerav tuće bilačhipe thaj kaj ni tu ni ka naćhe prekali kaja kupa ki mingri rig te ćere manđe bilačhipe. <verse eid="GEN 31:52" /><verse number="53" style="v" sid="GEN 31:53" />Nek o Dol e Avraameso thaj o Dol e Nahoreso, o Dol lenđe dadengo, sudil maškare amende.”</para>
  <para style="m" vid="GEN 31:53">Tegani o Jakov xalja sovli e Devlesa, kas leso dad o Isaak but poštujisada. <verse eid="GEN 31:53" /><verse number="54" style="v" sid="GEN 31:54" />O Jakov odori ko brego anda žrtva thaj dija vika pe muršen andari piri familija te xan. Kana xalje, gothe i sute.<verse eid="GEN 31:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 31:55" />Rano sabalje uštilo o Lavan, čumidija pe unukuren thaj pe čhejen, blagoslovisada len thaj irisajlo ćhere.<verse eid="GEN 31:55" /></para>
  <chapter eid="GEN 31" />
  <chapter number="32" style="c" sid="GEN 32" />
  <para style="s">O Jakov spremil pe te resol pe e Isavesa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1" />O Jakov đelo pe dromesa thaj resle le e anđelura e Devlese.<verse eid="GEN 32:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 32:2" />Kana dikhlja len o Jakov, vaćarda: “Kava si e Devleso tabori!” Golese gova than akharda Mahanajim.<verse eid="GEN 32:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 32:3" />O Jakov angle peste bičhalda glasnikuren ke po phral o Isav, ano seirsko krajo ano Edom, <verse eid="GEN 32:3" /><verse number="4" style="v" sid="GEN 32:4" />thaj naredisada lenđe: “Vaćaren me gospodarese e Isavese gijate: ‘Gija vaćarol ćiro sluga o Jakov: Bešljem ko Lavan i gothe sema sa dži akana. <verse eid="GEN 32:4" /><verse number="5" style="v" sid="GEN 32:5" />Isi man guruva, hera, bakre, sluge thaj sluškinje. Bičhalav kava haberi tuće, gospodarona, thaj nadiv man kaj ka arakhav milost ane će jakha.’”<verse eid="GEN 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 32:6" />Kana e glasnikura irisajle ko Jakov, phende lese: “Sama ke ćo phral o Isav. Vov avol ke tute thaj lesa vadži štaršel (400) murša.”<verse eid="GEN 32:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 32:7" />Tegani o Jakov but darajlo thaj zabrinisajlo, golese e manušen save sesa lesa thaj e bakren, e guruven thaj e kamilen podelisada ke duj tabora. <verse eid="GEN 32:7" /><verse number="8" style="v" sid="GEN 32:8" />Dija gođi: “Ako o Isav avol ke jekh tabori thaj napadil le, o dujto tabori ka šaj našol.”<verse eid="GEN 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 32:9" />Tegani o Jakov molisajlo: “Devla mingre paradadeso e Avraameso, Devla mingre dadeso e Isaakoso, GOSPODE, savo phendan manđe: ‘Iri tut ani ći phuv thaj ki ći familija. Me ka ćerav te avol tuće šukar.’<verse eid="GEN 32:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 32:10" />Nedostojno sem baše sa o manglipe thaj vernost savo sikadan manđe, ćire slugase. Samo jekh rovli sasa man kana nakhljem prekali len o Jordan, a akana isi man duj tabora. <verse eid="GEN 32:10" /><verse number="11" style="v" sid="GEN 32:11" />Moliv tut, ikal ma tare vasta me phralese e Isavese, golese so darav kaj ka avol thaj ka mudarol amen savoren, čak e dejen sa e čhavorencar. <verse eid="GEN 32:11" /><verse number="12" style="v" sid="GEN 32:12" />Al tu vaćardan: ‘Ka ćerav te avol tuće šukar thaj te aven tut potomkura sar pošik ko more, savi našti đinol pe.’ ”<verse eid="GEN 32:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 32:13" />O Jakov gothe nakhada i rat thaj tare kova so sasa le pripremisada daro pe phralese e Isavese: <verse eid="GEN 32:13" /><verse number="14" style="v" sid="GEN 32:14" />Dujšel (200) buznjen thaj biš (20) buzen, dujšel bakra (200) thaj biš (20) bakre, <verse eid="GEN 32:14" /><verse number="15" style="v" sid="GEN 32:15" />tranda (30) kamile thaj lenđe terne, saranda (40) guruvnja, deš (10) guruva, biš (20) hernja thaj deš (10) hera.<verse eid="GEN 32:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 32:16" />Tegani e stadura dija pe slugenđe, dži jekhese posebno, thaj phenda lenđe: “Džan angle mande, al mućhen than maškare stadura.”<verse eid="GEN 32:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 32:17" />E anglune slugase zapovedisada: “Kana ka resol tut mo phral o Isav thaj pučol tut: ‘Kaso san thaj kaj dža? Kase si kala životinje angle tute?’, <verse eid="GEN 32:17" /><verse number="18" style="v" sid="GEN 32:18" />tu vaćar: ‘Kava si ćire slugase e Jakovese. Kava si daro savo vov bičhalol pe gospodarese e Isavese. Thaj vov avol pale amende.’ ”<verse eid="GEN 32:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 32:19" />Gija zapovedisada te ćeren i o dujto thaj i o trito sluga thaj savore save pratisade e stadura, vaćarindoj: “Gija phenen i tumen e Isavese kana ka resen le. <verse eid="GEN 32:19" /><verse number="20" style="v" sid="GEN 32:20" />Thaj dićhen te vaćaren: ‘Akh, ćiro sluga o Jakov avol pale amende.’ ”</para>
  <para style="p" vid="GEN 32:20">Golese so o Jakov dija gođi: “Ka kovljarav e Isave kale darurencar save bičhalav angle mande, thaj kana ka resa amen, šaj ka primil man šukar.”<verse eid="GEN 32:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 32:21" />Gijate o daro e Jakoveso đelo angle leste, al vov goja rat ačhilo ano tabori. <verse eid="GEN 32:21" /><verse number="22" style="v" sid="GEN 32:22" />Ani goja isto rat o Jakov uštilo, lija pe duje romnjen, pe duje sluškinjen thaj pe dešujekhe (11) čhaven, thaj nakhlo prekalo potoko Jabok. <verse eid="GEN 32:22" /><verse number="23" style="v" sid="GEN 32:23" />A kana len nakhada prekalo potoko, nakhada i sa so sasa le.<verse eid="GEN 32:23" /></para>
  <para style="s">O Jakov peravol pe e Devlesa</para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 32:24" />Gija o Jakov ačhilo korkoro. Tegani jekh manuš perada pe lesa dži kaj ni đivesajlo. <verse eid="GEN 32:24" /><verse number="25" style="v" sid="GEN 32:25" />Kana o manuš dikhlja kaj našti te savladil e Jakove, čalada le ko zglobo e kukoso, gija dži kaj o Jakov perada pe manušesa, e Jakoveso kuko premestisajlo.<verse eid="GEN 32:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 32:26" />Tegani o manuš vaćarda: “Mukh ma, golese kaj đivesajlo!”</para>
  <para style="p" vid="GEN 32:26">O Jakov vaćarda: “Ni mukhav tut sa dži kaj ni blagoslovi man!”<verse eid="GEN 32:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 32:27" />O manuš pučlja le: “Sar si ćo alav?”</para>
  <para style="p" vid="GEN 32:27">Vov vaćarda: “Jakov.”<verse eid="GEN 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 32:28" />O manuš vaćarda: “Ćo alav ni ka avol vadži Jakov, nego Izrael<note caller="+" style="f"><char style="fr" closed="false">32,28 </char><char style="fq" closed="false">Izrael </char><char style="ft" closed="false">Kava značil: “O Dol boril pe” il “boril pe e Devlesa”.</char></note>, golese so mardan tut e Devlesa thaj e manušencar, thaj pobedisadan.”<verse eid="GEN 32:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 32:29" />Tegani o Jakov pučlja: “Vaćar manđe, moliv tut, ćo alav?”</para>
  <para style="p" vid="GEN 32:29">Vov vaćarda: “Sose puče man me alavese?”</para>
  <para style="p" vid="GEN 32:29">Tegani gothe blagoslovisada le.<verse eid="GEN 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 32:30" />Gova than o Jakov dija vika Peniel<note caller="+" style="f"><char style="fr" closed="false">32,30 </char><char style="fq" closed="false">Peniel </char><char style="ft" closed="false">Kava značil: “E Devleso muj.”</char></note>, golese so phenda: “Dikhljem e Devle muj mujesa, a ačhiljem džuvdo.” <verse eid="GEN 32:30" /><verse number="31" style="v" sid="GEN 32:31" />Kana o Jakov nakhlo o Penuel, o kham iklilo. Tegani o Jakov lija te banđarol baše po kuko. <verse eid="GEN 32:31" /><verse number="32" style="v" sid="GEN 32:32" />Golese e Izraelcura dži avđivesutno đive ni xan i tetiva savi si phangli po zglobo e kukoso, golese kaj e Jakoveso zglobo sasa čalado.<verse eid="GEN 32:32" /></para>
  <chapter eid="GEN 32" />
  <chapter number="33" style="c" sid="GEN 33" />
  <para style="s">O Jakov resolpe pe phralesa e Isavesa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1" />O Jakov vazdija po šoro thaj dikhlja e Isave sar avol štaršele (400) muršencar, pa ulada e čhaven e Lijaće, e Rahiljaće thaj pe duje sluškinjenđe. <verse eid="GEN 33:1" /><verse number="2" style="v" sid="GEN 33:2" />Anglal čhuta e sluškinjen thaj lenđe čhaven, a pale lende e Lija thaj laće čhaven, a e Rahilja thaj e Josife empalal. <verse eid="GEN 33:2" /><verse number="3" style="v" sid="GEN 33:3" />Vov đelo korkoro angle lende thaj efta droma pelo dži i phuv te poklonil pe, sa dži kaj ni avilo paše po phral.<verse eid="GEN 33:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 33:4" />Al o Isav prastija angle leste, zagrlisada le, čhuta pe vasta trujal lesi kor thaj čumidija le. Tegani solduj džene lije te roven.<verse eid="GEN 33:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 33:5" />Tegani o Isav vazdija pe jakha thaj dikhlja e romnjen thaj e čhaven, pa pučlja: “Ko si kala tusa?”</para>
  <para style="p" vid="GEN 33:5">O Jakov phenda: “Čhave saven o Dol milostivno dija manđe, ćire slugase.”<verse eid="GEN 33:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 33:6" />Tegani e sluškinje thaj lenđe čhave avile thaj pele ke koča anglo Isav. <verse eid="GEN 33:6" /><verse number="7" style="v" sid="GEN 33:7" />Pale lende avile i Lija thaj laće čhave thaj pele ke koča. Ko krajo avili i Rahilja thaj o Josif, pa i von pele ke koča angle leste.<verse eid="GEN 33:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 33:8" />O Isav pučlja: “A so mangljan te ćere kole stadurencar saven arakhljem ko drom?”</para>
  <para style="p" vid="GEN 33:8">O Jakov phenda: “Te arakhav milost ane ćire jakha, gospodarona.”<verse eid="GEN 33:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 33:9" />Al o Isav phenda: “Man isi već pherdo, mo phral. Ačhav len tuće.”<verse eid="GEN 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 33:10" />O Jakov phenda: “Na! Moliv tut, te arakhljem milost ane ćire jakha, primi kava daro mandar. Golese kaj, kana dikhljem ćo muj, te phene dikhljem o muj e Devleso, akana kana milostivo primisadan man. <verse eid="GEN 33:10" /><verse number="11" style="v" sid="GEN 33:11" />Moliv tut, le mo daro savo andem tuće, golese kaj o Dol sasa milostivo premal mande, pa isi man sa so trubul man.” A sar o Jakov gaći dija zor, o Isav prihvatisada o daro.<verse eid="GEN 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 33:12" />Tegani o Isav phenda: “Ajde te dža po drumo. I me ka džav tusa.”<verse eid="GEN 33:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 33:13" />Al o Jakov phenda lese: “Gospodarona, tu džane kaj si e čhave slaba, a trubul te paziv i pe bakre thaj pe guruvnja save den thud pe ciknen. Te dijem len zor te džan po sigate samo jekh đive, sa ka meren. <verse eid="GEN 33:13" /><verse number="14" style="v" sid="GEN 33:14" />Golese, gospodarona, dža angle mande, angle ćiro sluga, a me ka avav pozala, sigate kobor i stoka savi si angle mande thaj e čhave šaj phiren, dži kaj ni resav tute, gospodarona, ano Seir.”<verse eid="GEN 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 33:15" />O Isav phenda: “Mukh bar te ačhavav nekobor mingre manušen tusa.”</para>
  <para style="p" vid="GEN 33:15">O Jakov phenda lese: “Ni trubul, gospodarona, me samo mangav te arakhav milost ane ćire jakha.”<verse eid="GEN 33:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 33:16" />Gija o Isav gova đive irisajlo palal ano Seir. <verse eid="GEN 33:16" /><verse number="17" style="v" sid="GEN 33:17" />Al o Jakov đelo ano Sukot thaj gothe pese vazdija ćher, a baši stoka kolibe. Golese gova than akhardol Sukot.<verse eid="GEN 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 33:18" />Kana o Jakov avilo andaro Padan-Aram, baxtalo avilo dži o Sihem ani phuv i Hanaansko thaj vazdija šatora pašo foro. <verse eid="GEN 33:18" /><verse number="19" style="v" sid="GEN 33:19" />I phuv kaj vazdija pe šatora ćinda baše šel (100) srebrenjakura tare čhave e Hamorese, o dad e Sihemeso. <verse eid="GEN 33:19" /><verse number="20" style="v" sid="GEN 33:20" />Gothe o Jakov vazdija žrtveniko thaj akharda le El Elohe Izrael<note caller="+" style="f"><char style="fr" closed="false">33,20 </char><char style="fq" closed="false">El Elohe Izrael </char><char style="ft" closed="false">Kava značil: “O Dol si Dol e Izraeleso.”</char></note>.<verse eid="GEN 33:20" /></para>
  <chapter eid="GEN 33" />
  <chapter number="34" style="c" sid="GEN 34" />
  <para style="s">I Dina thaj o Sihem</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1" />Jekh đive i Dina, i čhej sava bijanda i Lija e Jakovese, iklili te džal ke nesave džuvlja tare goja phuv. <verse eid="GEN 34:1" /><verse number="2" style="v" sid="GEN 34:2" />Kana dikhlja la o Sihem, dolda la thaj suta lasa ki zor. (O Sihem sasa čhavo e Hamoreso e Hivijcoso savo sasa vladari gole phuvako.) <verse eid="GEN 34:2" /><verse number="3" style="v" sid="GEN 34:3" />O Sihem but manglja e Dina, e Jakovese čheja, thaj voj sasa lese ano ilo, gija vov trudisajlo te dobil lako manglipe.<verse eid="GEN 34:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 34:4" />Tegani vaćarda o Sihem pe dadese e Hamorese: “Le manđe romnjaće kale čheja.”<verse eid="GEN 34:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 34:5" />Kana o Jakov šunda kaj si lesi čhej i Dina ladžardi, lese čhave sesa ano polje e stokasa, thaj o Jakov ni manglja te ćerol khanči dži kaj von ni irin pe.<verse eid="GEN 34:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 34:6" />Tegani o Hamor, o dad e Sihemeso, avilo te vaćarol e Jakovesa. <verse eid="GEN 34:6" /><verse number="7" style="v" sid="GEN 34:7" />Kana avile e Jakovese čhave taro polje thaj šunde so sasa, uznemirisajle but thaj sesa but holjame, golese so o Sihem, kana suta e Jakovese čhejasa, ćerda so ni smil te ćerol pe thaj anda bari ladž e Izraelese.<verse eid="GEN 34:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 34:8" />Tegani phenda lenđe o Hamor: “Mo čhavo o Sihem but manđol tumare čheja. Moliv tumen te den la te avol lesi romni. <verse eid="GEN 34:8" /><verse number="9" style="v" sid="GEN 34:9" />Aven hanamika amencar – tumare čhejen den te aven amare romnja thaj tumen len amare čhejen. <verse eid="GEN 34:9" /><verse number="10" style="v" sid="GEN 34:10" />Živin maškar amende thaj i phuv ka avol tumenđe putardi. Ane late živin, biknen thaj ćinen, thaj steknin tumenđe barvalipe kate.”<verse eid="GEN 34:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 34:11" />Pale gova phenda o Sihem e Dinaće dadese thaj laće phralenđe: “Sikaven manđe milost thaj ka dav tumen sa so manđen. <verse eid="GEN 34:11" /><verse number="12" style="v" sid="GEN 34:12" />Vaćaren i cena kobor manđen baši Dina thaj savo god daro manđen, thaj me ka dav tumen kobor ka manđen – samo den man la romnjaće.”<verse eid="GEN 34:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 34:13" />Al sar o Sihem ladžarda lenđe pheja e Dina, e čhave e Jakovese ki prevara vaćarde e Sihemese thaj lese dadese e Hamorese, <verse eid="GEN 34:13" /><verse number="14" style="v" sid="GEN 34:14" />golese gija phende lenđe: “Našti gova te ćera. Našti te da amare pheja biobrezime manušese, golese kaj gova bi avola bari ladž amenđe. <verse eid="GEN 34:14" /><verse number="15" style="v" sid="GEN 34:15" />Amen ka ćera sar so mangljen, te postanisaden sar amen, gija so ka obrezin džijekhe murše maškar tumende. <verse eid="GEN 34:15" /><verse number="16" style="v" sid="GEN 34:16" />Tegani ka da amare čhejen tumenđe, thaj amen ka la tumare čhejen amenđe. Ka živi maškar tumende thaj ka ava jekh narodo. <verse eid="GEN 34:16" /><verse number="17" style="v" sid="GEN 34:17" />Al te ni šunden amen thaj te ni obrezisaljen, tegani ka la amare pheja thaj ka dža.”<verse eid="GEN 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 34:18" />E Hamorese thaj lese čhavese e Sihemese kava predlog sasa šukar. <verse eid="GEN 34:18" /><verse number="19" style="v" sid="GEN 34:19" />O Sihem sasa empoštujimo maškare sa ane po ćher pe dadeso, thaj ni ađućarda but te ćerol gova so rodije, golese so but manglja e Jakovese čheja. <verse eid="GEN 34:19" /><verse number="20" style="v" sid="GEN 34:20" />Gija đele o Hamor thaj o Sihem ki kapija lenđe forosi, te vaćaren pe manušencar so bešena gothe:<verse eid="GEN 34:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 34:21" />“Kala manuša manđen te aven šukar amencar. Te mukha len te bešen kate maškar amende ani amari phuv, te šaj ćinen thaj biknen ane late. Isi than lenđe ki kaja phuv. Amen ka šaj te la lenđe čhejen thaj von šaj len amare čhejen. <verse eid="GEN 34:21" /><verse number="22" style="v" sid="GEN 34:22" />Al kala manuša ka živin amencar sar jekh narodo, samo ako dži jekh murš maškar amende obrezil pe, sar so si von obrezime. <verse eid="GEN 34:22" /><verse number="23" style="v" sid="GEN 34:23" />Na li lenđi stoka, lengo barvalipe thaj sa lenđe životinje ka aven amare? Golese, te ćera kova so von manđen thaj gija ka živin maškar amende.”<verse eid="GEN 34:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 34:24" />Sa e murša save avile angli forosi kapija manglje te ćeren gija sar so phende o Hamor thaj leso čhavo o Sihem, thaj tegani obrezisajle sa e murša ane gova foro.<verse eid="GEN 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 34:25" />O trito đive, kana len vadži sesa dukha, o Simeon thaj o Levi, e duj čhave e Jakovese thaj e phrala e Dinaće, lije pe mačura, čorale đele ano foro thaj mudarde dži jekhe murše. <verse eid="GEN 34:25" /><verse number="26" style="v" sid="GEN 34:26" />Mačosa mudarde e Hamore thaj lese čhave e Siheme, lije e Dina taro ćher e Sihemeso thaj đele. <verse eid="GEN 34:26" /><verse number="27" style="v" sid="GEN 34:27" />Tegani avile avera čhave e Jakovese ko than kaj sasa kava mudardipe, thaj čorde sa andaro foro golese kaj lenđi phen sasa ladžardi. <verse eid="GEN 34:27" /><verse number="28" style="v" sid="GEN 34:28" />Lije lenđe cikne thaj bare stoka, e heren thaj sa lengo so sasa ano foro thaj so sasa ano polje. <verse eid="GEN 34:28" /><verse number="29" style="v" sid="GEN 34:29" />Inđarde sa lengo barvalipe, sa lenđe romnjen thaj lenđe čhaven, thaj čorde sa so sasa ane ćhera.<verse eid="GEN 34:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 34:30" />Tegani o Jakov vaćarda e Simeonese thaj e Levijase: “Čhuten man ano bilačhipe, golese so e manuša tare kala phuva, e Hanaanejcura thaj e Perižanura, ka zamrzin man. Amen sam zala manuša, thaj te von ćidije pe katane protiv mande thaj te čalade pe mande, ka ava mudarde me thaj me ćherutne.”<verse eid="GEN 34:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 34:31" />Al von phende: “Našti vov amare phejasa te ćerol sar e bludnicasa!”<verse eid="GEN 34:31" /></para>
  <chapter eid="GEN 34" />
  <chapter number="35" style="c" sid="GEN 35" />
  <para style="s">O Jakov palem ano Betel</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1" />O Dol phenda e Jakovese: “Ušti, dža upre ano Betel thaj odori beš. Gothe ćer žrtveniko e Devlese savo sikadilo tuće, kana našljan tare ćiro phral o Isav.”<verse eid="GEN 35:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 35:2" />Gija o Jakov phenda pe ćherutnenđe thaj savorenđe save sesa lesa: “Čhuden e abandžijenđe devlen save si tumencar, thodon thaj uraven tumen. <verse eid="GEN 35:2" /><verse number="3" style="v" sid="GEN 35:3" />Pa ajde ka dža upre ano Betel. Odori ka ćerav žrtveniko e Devlese savo šunda man ano đive kana sasa manđe pharo thaj sasa mancar ko drom ke savo đeljem.”<verse eid="GEN 35:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 35:4" />Gija von dije e Jakovese sa e abandžijskone devlen save sesa len, thaj e čeja save sasa len ke kana, a o Jakov prahosada len talo hrasto<note caller="+" style="f"><char style="fr" closed="false">35,4 </char><char style="fq" closed="false">hrasto </char><char style="ft" closed="false">Ano original ačhol: “Terebint.”</char></note> ko Sihem. <verse eid="GEN 35:4" /><verse number="5" style="v" sid="GEN 35:5" />Pale gova đele. A i dar taro Dol dolda sa e manušen tare pašutne forura, thaj khoni ni đelo ani potera pale čhave e Jakovese.<verse eid="GEN 35:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 35:6" />O Jakov thaj sa e manuša save sasa lesa, avile ano Luz, ani phuv i Hanaansko, a gova si o Betel. <verse eid="GEN 35:6" /><verse number="7" style="v" sid="GEN 35:7" />Gothe ćerda žrtveniko thaj akharda gova than El Betel<note caller="+" style="f"><char style="fr" closed="false">35,7 </char><char style="fq" closed="false">El Betel </char><char style="ft" closed="false">Kava značil: O Dol taro Betel.</char></note>, golese kaj gothe sikadilo lese o Dol, kana našlo tare po phral.<verse eid="GEN 35:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 35:8" />Tegani muli i Devora, i džuvli savi dija čuči e Reveka, thaj prahosade la pašo Betel talo hrast, savo o Jakov akharda “e Rojimaso Hrast”.<verse eid="GEN 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 35:9" />Pale gova so irisajlo o Jakov andaro Padan-Aram, o Dol palem sikadilo e Jakovese thaj blagoslovisada le.<verse eid="GEN 35:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 35:10" />O Dol lese phenda: “Ćo alav si Jakov, al od akana ni ka akhardo Jakov, nego ćo alav ka avol Izrael.”</para>
  <para style="p" vid="GEN 35:10">Gija o Dol dija le alav Izrael.<verse eid="GEN 35:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 35:11" />Thaj vadži phenda lese o Dol: “Me sem o Emzuralo Dol. Av plodno thaj množi tu. Tutar ka avol narodo thaj but narodura, maškar ćire potomkura ka aven carura. <verse eid="GEN 35:11" /><verse number="12" style="v" sid="GEN 35:12" />Thaj ka dav tut i phuv savi dijem e Avraamese thaj e Isaakose, ka dav la thaj će potomkurenđe.”<verse eid="GEN 35:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 35:13" />Tegani o Dol đelo lestar taro than kaj vaćarda lesa.<verse eid="GEN 35:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 35:14" />O Jakov vazdija jekh bar sar stubo ke gova than kaj o Dol ćerda lesa lafi, thaj ko stubo čhorda mol thaj ulje sar žrtva e Devlese. <verse eid="GEN 35:14" /><verse number="15" style="v" sid="GEN 35:15" />Thaj o Jakov akharda gova than kaj o Dol vaćarda lesa Betel.<verse eid="GEN 35:15" /></para>
  <para style="s">I Rahilja merol</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16" />Tegani o Jakov thaj lesi familija đele taro Betel. A kana ačhilo vadži zala dži i Efrata, i Rahilja lija te bijanol, a sasa la bare dukha. <verse eid="GEN 35:16" /><verse number="17" style="v" sid="GEN 35:17" />Dži kaj sasa la dukha, i babica phenda laće: “Ma dara, Rahiljo, ka avol tut vadži jekh murš čhavo.” <verse eid="GEN 35:17" /><verse number="18" style="v" sid="GEN 35:18" />Thaj angleder so ka merol, i Rahilja dija le alav Ben-Oni<note caller="+" style="f"><char style="fr" closed="false">35,18 </char><char style="fq" closed="false">Ben-Oni </char><char style="ft" closed="false">Kava značil: “O čhavo taro mo pharipe.”</char></note>, al o dad dija le alav Venijamin<note caller="+" style="f"><char style="fr" closed="false">35,18 </char><char style="fq" closed="false">Venijamin </char><char style="ft" closed="false">Kava značil: “O čhavo tare mingro desno va.”</char></note>.<verse eid="GEN 35:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 35:19" />Gija i Rahilja muli, pa prahosade la ko drom savo džal ani Efrata, a gova si o Vitlejem. <verse eid="GEN 35:19" /><verse number="20" style="v" sid="GEN 35:20" />O Jakov čhuta bar ke lako limori, thaj gova bar si sar spomeniko ko limori dži avđivesutno đive. <verse eid="GEN 35:20" /><verse number="21" style="v" sid="GEN 35:21" />Gothar đelo o Izrael thaj putarda po šatori pali kula Eder.<verse eid="GEN 35:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 35:22" />Kana o Izrael bešlo ane goja phuv, leso čhavo o Ruvim đelo thaj pašlilo e Bilhasa, savi sasa romni-ropkinja e Izraelesi, a o Izrael gova dodžanglja.</para>
  <para style="s" vid="GEN 35:22">E Jakovese čhave</para>
  <para style="p" vid="GEN 35:22">E Jakove sesa dešuduj (12) čhave.<verse eid="GEN 35:22" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="23" style="v" sid="GEN 35:23" />Čhave e Lijaće sesa: o Ruvim, emphureder čhavo e Jakoveso, o Simeon, o Levi, o Juda, o Isahar thaj o Zavulon.<verse eid="GEN 35:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 35:24" />Čhave e Rahiljaće sesa: o Josif thaj o Venijamin.<verse eid="GEN 35:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 35:25" />Čhave e Rahiljaće sluškinjaće e Bilhaće sesa: o Dan thaj o Neftalim.<verse eid="GEN 35:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 35:26" />Čhave e Lijaće sluškinjaće e Zilpaće sesa: o Gad thaj o Asir.</para>
  <para style="b" vid="GEN 35:26" />
  <para style="m" vid="GEN 35:26">Gola si e čhave e Jakovese, save bijandile lese ano Padan-Aram.<verse eid="GEN 35:26" /></para>
  <para style="s">E Isaakoso meripe</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27" />O Jakov avilo ko Isaak ke po dad ani Mamrija ano Kirjat-Arba, savo si o Hevron, kaj bešena o Avraam thaj o Isaak. <verse eid="GEN 35:27" /><verse number="28" style="v" sid="GEN 35:28" />O Isaak živisada šel ohtovardeš (180) berš. <verse eid="GEN 35:28" /><verse number="29" style="v" sid="GEN 35:29" />Mulo ano šukar phuripe thaj sasa le but berša. Lese čhave o Isav thaj o Jakov prahosade le.<verse eid="GEN 35:29" /></para>
  <chapter eid="GEN 35" />
  <chapter number="36" style="c" sid="GEN 36" />
  <para style="s">E Isavese potomkura</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1" />Kava si o potomstvo e Isaveso, savo akhardol thaj Edom.<verse eid="GEN 36:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 36:2" />O Isav lija trine romnjen tare hanaanska čheja: e Ada, čhej e Elonesi e Hetitesi, e Oholivama, čhej e Anasi, saveso dad sasa o Civon o Hivijco, <verse eid="GEN 36:2" /><verse number="3" style="v" sid="GEN 36:3" />thaj e Bosmata, čhej e Jišmaelesi, phen e Nevajotonesi.<verse eid="GEN 36:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 36:4" />I Ada bijanda e Isavese e Elifaze, a i Bosmata bijanda e Reuele. <verse eid="GEN 36:4" /><verse number="5" style="v" sid="GEN 36:5" />I Oholivama bijanda e Jeuše, e Jaalame thaj e Koreje.</para>
  <para style="p" vid="GEN 36:5">Gola si čhave e Isavese, save bijandile lese ani phuv i Hanaansko.<verse eid="GEN 36:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 36:6" />Pale gova o Isav lija pe romnjen, pe čhaven, pe čhejen, thaj sa pe ćherutnen, pe stoka thaj sa avere životinjen thaj sa po barvalipe savo steknisada ani phuv i Hanaansko, thaj đelo ani aver phuv podur tare po phral o Jakov, <verse eid="GEN 36:6" /><verse number="7" style="v" sid="GEN 36:7" />golese so o barvalipe lengo sasa but baro thaj ne bi šajine te živin katane. I phuv ane savi živisade sasa cikni baši sa lenđi stoka. <verse eid="GEN 36:7" /><verse number="8" style="v" sid="GEN 36:8" />Gija o Isav, kas akharena thaj Edom, đelo te bešol ani bregali phuv Seir.<verse eid="GEN 36:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 36:9" />Kava si potomstvo e Isaveso, savo si o paradad e Edomcurengo ani bregali phuv Seir.<verse eid="GEN 36:9" /></para>
  <para style="b" />
  <para style="li">
    <verse number="10" style="v" sid="GEN 36:10" />Kala si e alava e Isavese čhavenđe: o Elifaz, čhavo e Adako, e Isavese romnjako, thaj o Reuel, čhavo e Bosmatako, e Isavese romnjako.<verse eid="GEN 36:10" /></para>
  <para style="li">
    <verse number="11" style="v" sid="GEN 36:11" />E Elifazese čhave sesa: o Teman, o Omar, o Cefo, o Gaatam thaj o Kenaz.<verse eid="GEN 36:11" /></para>
  <para style="li">
    <verse number="12" style="v" sid="GEN 36:12" />I Timna, savi sasa romni-ropkinja e Elifazesi, e Isavese čhavesi, bijanda e Elifazese e Amaleko.</para>
  <para style="li" vid="GEN 36:12">Gola si čhave e Adaće, e Isavese romnjaće.<verse eid="GEN 36:12" /></para>
  <para style="li">
    <verse number="13" style="v" sid="GEN 36:13" />E Reuelese čhave sesa: o Nahat, o Zara, o Šama thaj o Miza.</para>
  <para style="li" vid="GEN 36:13">Gova si unukura e Bosmataće, e Isavese romnjaće.<verse eid="GEN 36:13" /></para>
  <para style="li">
    <verse number="14" style="v" sid="GEN 36:14" />I Oholivama, e Isavesi romni, čhej e Anasi thaj unuka e Civonesi, bijanda: e Jeuše, o Jaalame thaj e Koreje.<verse eid="GEN 36:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="GEN 36:15" />Kala si plemenska vođe save avile tare Isavese potomkura:</para>
  <para style="li" vid="GEN 36:15">Taro Elifaz, taro emphureder čhavo e Isaveso: o Teman, o Omar, o Cefo, o Kenaz, <verse eid="GEN 36:15" /><verse number="16" style="v" sid="GEN 36:16" />o Korej, o Gaatam, thaj o Amalek.</para>
  <para style="li" vid="GEN 36:16">Gola sesa e Elifazose plemenska vođe tari phuv i Edom. Gola sesa unukura e Adaće.<verse eid="GEN 36:16" /></para>
  <para style="li">
    <verse number="17" style="v" sid="GEN 36:17" />Taro Reuel, taro čhavo e Isaveso: o Nahat, o Zara, o Šama thaj o Miza.</para>
  <para style="li" vid="GEN 36:17">Gola sesa e Reuelese plemenska vođe tari phuv i Edom. Gola sesa e unukura e Bosmataće, e Isavese romnjaće.<verse eid="GEN 36:17" /></para>
  <para style="li">
    <verse number="18" style="v" sid="GEN 36:18" />E čhave e Oholivamaće, e Isavese romnjaće, sesa: o Jeuš, o Jaalam thaj o Korej.</para>
  <para style="li" vid="GEN 36:18">Gova si e Isavese plemenura save avile tari Oholivama, i čhej e Anasi.<verse eid="GEN 36:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="GEN 36:19" />Gola sesa potomkura e Isavese, kas akharena thaj Edom, thaj lenđe plemenska vođe.<verse eid="GEN 36:19" /></para>
  <para style="s">E Seirese potomkura</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 36:20" />Kala si čhave e Seirese e Horijcose, savo bešola ano Edom:</para>
  <para style="li" vid="GEN 36:20">O Lotan, o Šoval, o Civon, o Ana, <verse eid="GEN 36:20" /><verse number="21" style="v" sid="GEN 36:21" />o Dišon, o Ecer thaj o Dišan. Gola si e plemenura e Horijcurenđe, čhave e Seirese ani phuv i Edom.<verse eid="GEN 36:21" /></para>
  <para style="li">
    <verse number="22" style="v" sid="GEN 36:22" />Čhave e Lotanese: o Hori thaj o Heman. I Timna sasa e Lotanesi phen.<verse eid="GEN 36:22" /></para>
  <para style="li">
    <verse number="23" style="v" sid="GEN 36:23" />Čhave e Šovalese: o Alvan, o Manahat, o Eval, o Šefo thaj o Onam.<verse eid="GEN 36:23" /></para>
  <para style="li">
    <verse number="24" style="v" sid="GEN 36:24" />Čhave e Civonese: O Aja thaj o Ana. A gova Ana si kova so arakhlja e thana katar ikljol o tato paj ani pustinja, dži kaj čarada e heren e Civonese, pe dadese.<verse eid="GEN 36:24" /></para>
  <para style="li">
    <verse number="25" style="v" sid="GEN 36:25" />Čhave e Anase: o Dišon thaj i Oholivama, i čhej e Anasi.<verse eid="GEN 36:25" /></para>
  <para style="li">
    <verse number="26" style="v" sid="GEN 36:26" />Čhave e Dišonese: o Hemdad, o Ešban, o Jitran thaj o Keran.<verse eid="GEN 36:26" /></para>
  <para style="li">
    <verse number="27" style="v" sid="GEN 36:27" />Čhave e Ecerese: o Bilhan, o Zaavan thaj o Akan.<verse eid="GEN 36:27" /></para>
  <para style="li">
    <verse number="28" style="v" sid="GEN 36:28" />Čhave e Dišanese: o Uc thaj o Haran.<verse eid="GEN 36:28" /></para>
  <para style="p">
    <verse number="29-30" style="v" sid="GEN 36:29-30" />Gola si e plemenura e Horejincurenđe pale lenđe vođe ani phuv o Seir: o Lotan, o Šoval, o Civon, o Ana, o Dišon, o Ecer thaj o Dišan.<verse eid="GEN 36:29-30" /></para>
  <para style="s">E carura ano Edom</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 36:31" />Kala si e carura save caruisade ani phuv i Edom angleder nego so caruisada bilo savo izraelsko caro:<verse eid="GEN 36:31" /></para>
  <para style="b" />
  <para style="li">
    <verse number="32" style="v" sid="GEN 36:32" />O Bela, o čhavo e Beoreso, postanisada caro ano Edom. Leso foro akhardilo Dinhava.<verse eid="GEN 36:32" /></para>
  <para style="li">
    <verse number="33" style="v" sid="GEN 36:33" />Kana mulo o Bela, caruisada ke leso than o Jovav, čhavo e Zareso andari Bocra.<verse eid="GEN 36:33" /></para>
  <para style="li">
    <verse number="34" style="v" sid="GEN 36:34" />Kana mulo o Jovav, caruisada ke leso than o Hušam tari phuv e Temancurenđi.<verse eid="GEN 36:34" /></para>
  <para style="li">
    <verse number="35" style="v" sid="GEN 36:35" />Kana mulo o Hušam, caruisada ke leso than o Hadad, čhavo e Bedadeso, savo pobedisada e Midjancuren ani phuv i Moav. Leso foro akhardola Avit.<verse eid="GEN 36:35" /></para>
  <para style="li">
    <verse number="36" style="v" sid="GEN 36:36" />Kana mulo o Hadad, caruisada ke leso than o Samla andar i Masreka.<verse eid="GEN 36:36" /></para>
  <para style="li">
    <verse number="37" style="v" sid="GEN 36:37" />Kana mulo o Samla, caruisada ke leso than o Saul andaro Rehovot paši len o Eufrat.<verse eid="GEN 36:37" /></para>
  <para style="li">
    <verse number="38" style="v" sid="GEN 36:38" />Kana mulo o Saul, caruisada ke leso than o Vaal-Hanan, čhavo e Ahboreso.<verse eid="GEN 36:38" /></para>
  <para style="li">
    <verse number="39" style="v" sid="GEN 36:39" />Kana mulo o Vaal-Hanan, o čhavo e Ahboreso, caruisada ke leso than o Hadad. Leso foro akhardola Pau. Lese romnjako alav sasa Mehetavel, savi sasa čhej e Matredesi, unuka e Me-Zahavesi.<verse eid="GEN 36:39" /></para>
  <para style="b" />
  <para style="p">
    <verse number="40" style="v" sid="GEN 36:40" />Kala si alava tare plemenska vođe taro Isav premale lenđe familije thaj premale lenđe područja: o Timna, o Alva, o Jetet, <verse eid="GEN 36:40" /><verse number="41" style="v" sid="GEN 36:41" />o Oholivama, o Ela, o Pinon, <verse eid="GEN 36:41" /><verse number="42" style="v" sid="GEN 36:42" />o Kenaz, o Teman, o Mivcar, <verse eid="GEN 36:42" /><verse number="43" style="v" sid="GEN 36:43" />o Magdiel thaj o Iram.</para>
  <para style="p" vid="GEN 36:43">Gola si plemenska vođe taro Isav, savo si o paradad e Edomcurengo, pale lenđe thana ani phuv savi osvojisade.<verse eid="GEN 36:43" /></para>
  <chapter eid="GEN 36" />
  <chapter number="37" style="c" sid="GEN 37" />
  <para style="s">O Josif thaj lese phrala</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1" />O Jakov bešlo ani phuv i Hanaansko, kaj leso dad bešola sar abandžija.<verse eid="GEN 37:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 37:2" />Kava si so sasa e Jakovese familijasa.</para>
  <para style="p" vid="GEN 37:2">Kana sasa o Josif terno čhavo tare dešefta (17) berš, čaravola e stoka kole phralencar saven bijande i Bilha thaj i Zilpa, e romnja lese dadese. O Josif anola bilačhe lafura lendar pe dadese.<verse eid="GEN 37:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 37:3" />O Izrael tare sa pe čhave embut manglja e Josife, golese kaj bijandilo lese ano puranipe. Golese ćerda lese but lačho šarimo ogrtači. <verse eid="GEN 37:3" /><verse number="4" style="v" sid="GEN 37:4" />Kana e Josifese phrala dikhlje kaj lengo dad embut manđol e Josife tare sa lese čhave, tegani von lije te mrzin le gaći kaj naštine te vaćaren lese nijekh šukar lafi.<verse eid="GEN 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 37:5" />Jekh drom o Josif dikhlja suno thaj phenda le pe phralenđe. Thaj von vadži pobut mrzisade le, <verse eid="GEN 37:5" /><verse number="6" style="v" sid="GEN 37:6" />golese so phenda lenđe: “Šunen savo suno dikhljem: <verse eid="GEN 37:6" /><verse number="7" style="v" sid="GEN 37:7" />Phandasa e snopura ko polje thaj tari jekh drom mingro snopo uštilo thaj uspravisajlo. Tumare snopura ćidije pe trujal mingro snopo thaj poklonisajle lese.”<verse eid="GEN 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 37:8" />Tegani lese phrala phende: “Te ni ka ave caro pe amende thaj ka vladi amencar?”</para>
  <para style="p" vid="GEN 37:8">Pale gova pobut mrzisade le baše lese sune thaj baše lafura save vaćarda lendar.<verse eid="GEN 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 37:9" />Pale gova o Josif dikhlja vadži jekh suno thaj phenda le pe phralenđe: “Šunen. Palem dikhljem suno. Dikhljem sar o kham thaj o čhon thaj dešujekh (11) čerenja poklonisajle manđe.”<verse eid="GEN 37:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 37:10" />Kana gova phenda pe dadese thaj pe phralenđe, o dad korisada le thaj phenda: “Savo si gova suno so dikhljan? Dal ći dej thaj me thaj će phrala ka ava thaj ka pokloni amen angle tute dži i phuv?”<verse eid="GEN 37:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 37:11" />Thaj dži kaj e phrala sesa pe leste zavidna, leso dad tare kala sune dija gođi ane peste.<verse eid="GEN 37:11" /></para>
  <para style="s">O Josif bićindo ano Egipat</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12" />Kana e Josifese phrala đele te čaraven pe dadese bakren pašo Sihem, <verse eid="GEN 37:12" /><verse number="13" style="v" sid="GEN 37:13" />phenda o Izrael e Josifese: “Džane kaj će phrala čaraven e stoka pašo Sihem. Ajde, ka bičhalav tut ke lende.”</para>
  <para style="p" vid="GEN 37:13">Vov phenda: “Ako dade, ka džav.”<verse eid="GEN 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 37:14" />O Izrael phenda lese: “Dža thaj dikh sar si će phrala thaj sar si i stoka. Pale gova av te phene manđe.” Gija bičhalda le tari Hevronsko dolina.</para>
  <para style="p" vid="GEN 37:14">Kana o Josif reslo ano Sihem, <verse eid="GEN 37:14" /><verse number="15" style="v" sid="GEN 37:15" />jekh manuš dikhlja le sar phirol akari okori thaj pučlja le: “So rode?”<verse eid="GEN 37:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 37:16" />O Josif phenda: “Rodav me phralen. Phen manđe, moliv tut, kaj čaraven e stoka?”<verse eid="GEN 37:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 37:17" />O manuš phenda: “Đele katar. Al šundem sar phenen: ‘Ajde te dža ano Dotan.’”</para>
  <para style="p" vid="GEN 37:17">Gija đelo o Josif pale pe phrala thaj arakhlja len ano Dotan. <verse eid="GEN 37:17" /><verse number="18" style="v" sid="GEN 37:18" />Al von dikhlje le odural, thaj vadži ni avilo paše dži lende, lije te vaćaren jekh averese te mudaren le.<verse eid="GEN 37:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 37:19" />Phende jekh averese: “Dikh, ektalo o gospodari tare sune! <verse eid="GEN 37:19" /><verse number="20" style="v" sid="GEN 37:20" />Ajde te mudara le thaj te čhuda le ani jekh tare kala bare rupe<note caller="+" style="f"><char style="fr" closed="false">37,20 </char><char style="fq" closed="false">bare rupe </char><char style="ft" closed="false">Kala bare rupe sesa ćerde sar bi ćidola pe o paj taro bršnd kana perola thaj služisade sar bunara.</char></note>. Ka phena kaj xalja le nesavi divljo životinja. Tegani ka dikha so ka avol lese sunencar!”<verse eid="GEN 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 37:21" />Kana o Ruvim šunda gova, dikhlja nesar te ikalol e Josife andare lenđe vasta thaj vaćarda: “Ma te mudara le! <verse eid="GEN 37:21" /><verse number="22" style="v" sid="GEN 37:22" />Ma čhoren o rat! Čhuden le ani kaja bari rupa kate ani pustinja, al ma vazden tumare vasta pe leste.” O Ruvim gova phenda te bi ikalola e Josife andare lenđe vasta thaj te bi irila le pe dadese.<verse eid="GEN 37:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 37:23" />Kana reslo o Josif ke pe phrala, von uljarde lestar kova but lačho šarimo ogrtači savo sasa pe leste, <verse eid="GEN 37:23" /><verse number="24" style="v" sid="GEN 37:24" />dolde le thaj čhudije le ani bari rupa ani savi ni sasa paj.<verse eid="GEN 37:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 37:25" />Kana bešle te xan, vazdije pe jakha thaj dikhlje e trgovcuren, e Jišmaelcuren, save džana taro Gilad ano Egipat. Pe lenđe kamile sesa tovarime začinura, balsamura thaj smirne.<verse eid="GEN 37:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 37:26" />Tegani o Juda phenda pe phralenđe: “So isi amen tare gova, te mudara amare phrale thaj te garava leso meripe? <verse eid="GEN 37:26" /><verse number="27" style="v" sid="GEN 37:27" />Ajde te bikna le kale Jišmaelcurenđe, te ma vazda amaro va pe leste, golese kaj si amaro phral, amaro rat.” Thaj lese phrala šunde le.<verse eid="GEN 37:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 37:28" />Kana nakhle paše lende e midjanska trgovcura, e phrala ikalde e Josife andari rupa, thaj bićinde le e Jišmaelcurenđe baše biš (20) srebrenjakura, thaj von inđarde e Josife ano Egipat.<verse eid="GEN 37:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 37:29" />Kana irisajlo o Ruvim paši rupa thaj dikhlja kaj o Josif ni sasa gothe, pharada pe šeja tari žal. <verse eid="GEN 37:29" /><verse number="30" style="v" sid="GEN 37:30" />Tegani irisajlo ke pe phrala thaj phenda: “Naj o čhavoro! So ka ćerav akana?”<verse eid="GEN 37:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 37:31" />Tegani e phrala lije o ogrtači e Josifeso, čhinde jekhe buzore thaj makhlje e ratesa leso ogrtači, <verse eid="GEN 37:31" /><verse number="32" style="v" sid="GEN 37:32" />pa inđarde o ogrtači pe dadese, vaćarindoj: “Dikh, arakhljam kava, dal si kava će čhaveso ogrtači, il na?”<verse eid="GEN 37:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 37:33" />O Jakov pindžarda le thaj phenda: “Va, me čhaveso ogrtači! Nesavi divljo životinja xalja le! O Josif si sigurno čhindo ke kotora!”<verse eid="GEN 37:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 37:34" />Tegani pharada o Jakov pe šeja tari žal, urada pe ano kostret<note caller="+" style="f"><char style="fr" closed="false">37,34 </char><char style="fq" closed="false">kostret </char><char style="ft" closed="false">Šeja tare buznjaće bala, save uravena pe kana si neko ano žalost il ano pokajanje.</char></note> thaj but đivesa ruja pale po čhavo.<verse eid="GEN 37:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 37:35" />Sa lese čhave thaj e čheja avena te tešin le, al vov ni manglja te utešil pe, nego phenda: “Ka rovav pale mo čhavo, sa dži kaj i me ni merav.” Gija leso dad ruja pale leste.<verse eid="GEN 37:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 37:36" />Ane gova vreme, kola Midjancura bićinde e Josife ano Egipat e Potifarese, jekhese tare šorutne faraonese službenikura, zapovedniko e stražarengo.<verse eid="GEN 37:36" /></para>
  <chapter eid="GEN 37" />
  <chapter number="38" style="c" sid="GEN 38" />
  <para style="s">O Juda thaj i Tamara</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1" />Ane gova vreme o Juda đelo tare pe phrala thaj avilo ko nesavo manuš kaso alav sasa Hira, taro foro Adulam. <verse eid="GEN 38:1" /><verse number="2" style="v" sid="GEN 38:2" />Gothe dikhlja o Juda e čheja nesave Hanaanejcose, leso alav sasa Šua. Lija la romnjaće thaj suta lasa. <verse eid="GEN 38:2" /><verse number="3" style="v" sid="GEN 38:3" />Voj ačhili khamni thaj bijanda čhave. O Juda dija le alav Ir. <verse eid="GEN 38:3" /><verse number="4" style="v" sid="GEN 38:4" />Voj palem ačhili khamni thaj bijanda čhave, kase dija alav Onan. <verse eid="GEN 38:4" /><verse number="5" style="v" sid="GEN 38:5" />Pale gova bijanda vadži jekhe čhave thaj dija le alav Sala. Kana bijanda le, o Juda sasa ano Keziv.<verse eid="GEN 38:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 38:6" />O Juda arakhlja romnja pe phuredere čhavese e Erese. Lako alav sasa Tamara. <verse eid="GEN 38:6" /><verse number="7" style="v" sid="GEN 38:7" />Al o Ir, o emphureder čhavo e Judaso, sasa bilačho angle jakha e GOSPODESE, golese o GOSPOD lija lestar o džuvdipe.<verse eid="GEN 38:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 38:8" />Tegani o Juda phenda e Onanese: “Sov će phralese romnjasa thaj gija pher ćo dužnost sar devero premale late, će phralese te ačhave potomkuren.”<verse eid="GEN 38:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 38:9" />Al o Onan džanglja so gova potomstvo ni ka avol leso, golese kana bi sovola pe phralese romnjasa dićhola bi te ma ačhol i Tamara khamni, sar ne bi ačhavola pe phralese potomkuren. <verse eid="GEN 38:9" /><verse number="10" style="v" sid="GEN 38:10" />Gova so ćerda ni sasa šukar e GOSPODESE, golese o GOSPOD i lestar lija o džuvdipe.<verse eid="GEN 38:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 38:11" />Tegani o Juda phenda pe boraće e Tamaraće: “Dža thaj beš ano ćher će dadeso sar udovica, dži kaj ni barol o Sala, mo čhavo.” Golese kaj o Juda dija gođi: “Šajine bi i o Sala te merol sar lese phrala.”</para>
  <para style="p" vid="GEN 38:11">Gija đeli i Tamara te bešol ano ćher pe dadeso.<verse eid="GEN 38:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 38:12" />Kana nakhlo but vreme muli i romni e Judasi, i čhej e Šuasi. Kana nakhlo o vreme tare Judaso žalipe pale late, o Juda pe amalesa e Hiresa e Adulamcosa đelo ani Timna ke manuša save randena lese bakren.<verse eid="GEN 38:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 38:13" />Kana e manuša phende e Tamaraće: “Ek, ćo sastro džal ani Timna te randol pe bakren,” <verse eid="GEN 38:13" /><verse number="14" style="v" sid="GEN 38:14" />voj uljarda pestar e šeja save sikavena kaj si udovica, učharda po muj dikhlesa thaj paćarda pe, pa bešli ko ulaz ano Enajim, savo si ko drom za ki Timna. Golese kaj dikhlja so o Sala barilo, al vadži ni dije la romnjaće lese.<verse eid="GEN 38:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 38:15" />Kana o Juda dikhlja la, dija gođi kaj si bludnica, golese kaj lako muj sasa učhardo.<verse eid="GEN 38:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 38:16" />Pa đelo taro drom ke late. A golese kaj vov ni pindžarda kaj si lesi bori, phenda laće: “Ajde, de man te sovav tusa.”</para>
  <para style="p" vid="GEN 38:16">Voj pučlja: “So ka de man, te bi sovava tusa?”<verse eid="GEN 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 38:17" />O Juda phenda: “Ka bičhalav tuće buzore andar mo stado.”</para>
  <para style="p" vid="GEN 38:17">Voj phenda lese: “Šukar, al de man khanči ano zalog, dok ni bičhale e buzore.”<verse eid="GEN 38:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 38:18" />Vov pučlja la: “So manđe te dav tut?”</para>
  <para style="p" vid="GEN 38:18">Voj phenda: “Akh, i angrustik e pečatosa savi si phangli e dorikasa ki ći kor, thaj i rovli so si tuće ane va.”</para>
  <para style="p" vid="GEN 38:18">Thaj vov dija la. Tegani suta lasa thaj voj ačhili khamni lesa. <verse eid="GEN 38:18" /><verse number="19" style="v" sid="GEN 38:19" />Pale gova uštili i Tamara thaj đeli ćhere. Uljarda o dikhlo pestar thaj palem urada e šeja save sikavena kaj si udovica.<verse eid="GEN 38:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 38:20" />O Juda bičhalda pale po amal o Hira e buzore, te bi lola tari bludnica kova so dija laće sar zalog. Al vov ni arakhlja la.<verse eid="GEN 38:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 38:21" />Vov pučlja e manušen save bešena gothe, vaćarindoj: “Kaj koja hramsko bludnica so sasa pašo drom bašo Enajim?”</para>
  <para style="p" vid="GEN 38:21">Von phende lese: “Ni sasa kate nisavi hramsko bludnica.”<verse eid="GEN 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 38:22" />Vov irisajlo ko Juda thaj phenda lese: “Ni arakhljem la. Thaj e manuša tare gova than vaćarde manđe: ‘Ni sasa kate nisavi hramsko bludnica.’”<verse eid="GEN 38:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 38:23" />Tegani o Juda phenda: “Nek ačhol late kova so dijem la, ma te maren muj amencar. A ko krajo, me bičhaldem laće buzore, al tu ni arakhljan la.”<verse eid="GEN 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 38:24" />Kana nakhle paše trin čhon, phende e Judase: “Ći bori i Tamara mukhlja pe ani preljuba, i čak ačhili khamni.”</para>
  <para style="p" vid="GEN 38:24">O Juda phenda: “Ikalen la thaj phabaren la!”<verse eid="GEN 38:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 38:25" />A dži kaj ande la, i Tamara bičhalda haberi pe sastrese: “Ačhiljem khamni e manušesa kaso si kava.” Thaj vadži phenda: “Dikh, pindžare li kaso si o pečato, i dori thaj i rovli?”<verse eid="GEN 38:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 38:26" />O Juda pindžarda sa thaj phenda: “Po pravedno si mandar, golese so ni dijem la me čhave e Sale.”</para>
  <para style="p" vid="GEN 38:26">Tegani o Juda ni suta vadži lasa.<verse eid="GEN 38:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 38:27" />Kana avilo o vreme i Tamara te bijanol, sikadilo kaj isi la bliznakura ane lako vođi.<verse eid="GEN 38:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 38:28" />Thaj dži kaj bijanola, jekh čhavo ikalda po va, a i babica phanglja lese lolo thav ko va thaj phenda: “Kava iklilo angleder.”<verse eid="GEN 38:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 38:29" />Al vov crdija po va thaj iklilo angleder leso phral. Tegani i babica phenda: “Sar li tu nakhljan!?” Golese dije le alav Fares<note caller="+" style="f"><char style="fr" closed="false">38,29 </char><char style="fq" closed="false">Fares </char><char style="ft" closed="false">Kava alav značil: “Te naćhol pe.”</char></note>.<verse eid="GEN 38:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 38:30" />Pale gova iklilo leso phral, kase sasa ko va lolo thav, pa dije le alav Zara<note caller="+" style="f"><char style="fr" closed="false">38,30 </char><char style="fq" closed="false">Zara </char><char style="ft" closed="false">Kava alav značil: “Lolo sar i sabalin kana ikljol o kham.”</char></note>.<verse eid="GEN 38:30" /></para>
  <chapter eid="GEN 38" />
  <chapter number="39" style="c" sid="GEN 39" />
  <para style="s">O Josif ko Potifar</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1" />E Jišmaelcura inđarde e Josife ano Egipat thaj bićinde le e Egipćanese e Potifarese, jekhese tare šorutne faraonese službenikura, o zapovedniko e stražarengo.<verse eid="GEN 39:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 39:2" />Al o GOSPOD sasa e Josifesa, thaj golese vov sasa uspešno. Bešlo ano ćher pe gospodareso e Egipćanoso. <verse eid="GEN 39:2" /><verse number="3" style="v" sid="GEN 39:3" />Leso gospodari dikhlja kaj si o GOSPOD e Josifesa thaj dol le te avol uspešno ane sa so ćerol. <verse eid="GEN 39:3" /><verse number="4" style="v" sid="GEN 39:4" />O Josif arakhlja milost ane jakha pe gospodarese thaj postanisada leso lično sluga. O Potifar čhuta le te avol upravitelji lese ćherese thaj dija le te brinil pe tare sa so sasa le. <verse eid="GEN 39:4" /><verse number="5" style="v" sid="GEN 39:5" />Od kana čhuta o Potifar e Josife te avol upravitelji pe leso ćher thaj pe sa so sasa le, o GOSPOD zbog o Josif blagoslovisada e Egipćaneso ćher. E GOSPODESO blagoslov sasa pe sa so sasa e Potifare ano ćher thaj ano polje. <verse eid="GEN 39:5" /><verse number="6" style="v" sid="GEN 39:6" />O Potifar ačhada ane Josifese vasta te brinil pe tare sa so sasa le, gija o Potifar ni brinisajlo khančese sem bašo xape savo xala.</para>
  <para style="p" vid="GEN 39:6">O Josif sasa učo thaj lačho. <verse eid="GEN 39:6" /><verse number="7" style="v" sid="GEN 39:7" />Pale nesavo vreme, i romni lese gospodaresi čhudija pi jakh po Josif thaj phenda: “Sov mancar.”<verse eid="GEN 39:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 39:8" />Al vov ni manglja, nego phenda: “Akh, mo gospodari ni brinil pe baše khanči ano ćher, nego dija sa manđe ane vasta me te briniv man. <verse eid="GEN 39:8" /><verse number="9" style="v" sid="GEN 39:9" />Ane kava ćher naj pobaro mandar. Mo gospodari dija man vlast pe sa, sem pe tute, golese kaj san lesi romni. Sar onda te ćerav gasavo bilačhipe thaj te grešiv protiv o Dol?”<verse eid="GEN 39:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 39:10" />Gija voj taro đive ko đive nagovorila le, al vov ni manglja te sovol lasa, pa čak ni te avol paše late.<verse eid="GEN 39:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 39:11" />Jekh đive kana o Josif avilo ano ćher te ćerol pi bući, ano ćher ni sasa khoni tare sluge.<verse eid="GEN 39:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 39:12" />Voj dolda le taro ogrtači thaj vaćarda lese: “Sov mancar!”</para>
  <para style="p" vid="GEN 39:12">Al vov ačhada laće ane vasta po ogrtači thaj našlo avri andaro ćher.<verse eid="GEN 39:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 39:13" />Kana voj dikhlja kaj ačhada ane laće vasta o ogrtači thaj našlo avral, <verse eid="GEN 39:13" /><verse number="14" style="v" sid="GEN 39:14" />dija vika pe slugen thaj phenda: “Dićhen, kale Jevreje ande amenđe te ladžarol amen! Avilo mande te sovol mancar, al me dijem vika andare sa o glaso. <verse eid="GEN 39:14" /><verse number="15" style="v" sid="GEN 39:15" />A kana šunda kaj me dav vika, ačhada po ogrtači thaj našlo avral.”<verse eid="GEN 39:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 39:16" />Voj ićarda e Josifeso ogrtači paše peste sa dži kaj ni irisajlo ćhere leso gospodari. <verse eid="GEN 39:16" /><verse number="17" style="v" sid="GEN 39:17" />Tegani i lese phenda gija: “Kova sluga o Jevrejo, kas andan amenđe, avilo te ladžarol man. <verse eid="GEN 39:17" /><verse number="18" style="v" sid="GEN 39:18" />Al kana me lijem te dav vika andare sa o glaso, vov ačhada po ogrtači ke mande thaj našlo avri.”<verse eid="GEN 39:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 39:19" />Kana o gospodari leso šunda e lafura pe romnjaće, savi phenda lese: “Gija ćerda ćo sluga mancar,” but holajlo. <verse eid="GEN 39:19" /><verse number="20" style="v" sid="GEN 39:20" />Tegani dolda e Josife thaj čhudija le ano phanglipe, odori kaj sesa phangle e carose phangle manuša.</para>
  <para style="p" vid="GEN 39:20">Dži kaj o Josif sasa ano phanglipe, <verse eid="GEN 39:20" /><verse number="21" style="v" sid="GEN 39:21" />o GOSPOD sasa lesa. Sikada lese po baro manglipe thaj dija le te araćhol milost ane jakha e upraviteljese taro phanglipe. <verse eid="GEN 39:21" /><verse number="22" style="v" sid="GEN 39:22" />A gova upravitelji čhuta e Josife te brinil pe tare sa e phangle manuša, thaj gija o Josif sasa odgovorno baše sa so ćerda pe odori. <verse eid="GEN 39:22" /><verse number="23" style="v" sid="GEN 39:23" />O upravitelji taro phanglipe ni brinisajlo khanči baše so o Josif brinisajlo, golese so o GOSPOD sasa e Josifesa thaj dija le te avol uspešno ane sa so ćerola.<verse eid="GEN 39:23" /></para>
  <chapter eid="GEN 39" />
  <chapter number="40" style="c" sid="GEN 40" />
  <para style="s">O sluga savo čhorola mol e carose thaj o pekari</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1" />Palo nesavo vreme o peharniko, sluga savo čhorola mol e carose, thaj o pekari holjarde pumare gospodare, e caro taro Egipat. <verse eid="GEN 40:1" /><verse number="2" style="v" sid="GEN 40:2" />O faraon holajlo pe kala duj službenikura, po šorutno peharniko thaj po šorutno pekari. <verse eid="GEN 40:2" /><verse number="3" style="v" sid="GEN 40:3" />Čhudija len ano ćher taro zapovedniko e stražarengo, ano isto phanglipe kaj sasa phanglo o Josif. <verse eid="GEN 40:3" /><verse number="4" style="v" sid="GEN 40:4" />A o zapovedniko e stražarengo čhuta e Josife te služil len.</para>
  <para style="p" vid="GEN 40:4">Pale gova von sesa phangle but vreme. <verse eid="GEN 40:4" /><verse number="5" style="v" sid="GEN 40:5" />Ani jekh rat o peharniko thaj o pekari dikhlje sune thaj dži jekh suno sasa le piro značenje.<verse eid="GEN 40:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 40:6" />Kana theara đive ko sabalje avilo o Josif ke lende, dikhlja kaj von sesa zabrinime, <verse eid="GEN 40:6" /><verse number="7" style="v" sid="GEN 40:7" />thaj pučlja len: “Sose sen avđive zabrinime?”<verse eid="GEN 40:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 40:8" />Von phende lese: “Dikhljam sune, al naj khoni ko te vaćarol amenđe so značin.”</para>
  <para style="p" vid="GEN 40:8">Tegani o Josif phenda lenđe: “Dal o Dol ni džanol so značil gova? Vaćaren manđe save sune dikhljen.”<verse eid="GEN 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 40:9" />Gija o šorutno peharniko vaćarda po suno e Josifese: “Ano suno dikhljem angle mande čokot <verse eid="GEN 40:9" /><verse number="10" style="v" sid="GEN 40:10" />thaj pe leste sesa trin loze. Samo so iklile e pupoljkura, procvetisade thaj e drakha pe leste zrelisade. <verse eid="GEN 40:10" /><verse number="11" style="v" sid="GEN 40:11" />Ane mo va ićardem o pehari e faraoneso. Lijem kola drakha, ćićidijem len ano pehari thaj čhutem lese o pehari ano va.”<verse eid="GEN 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 40:12" />O Josif phenda lese: “Akh so značil gova suno: Trin loze si trin đivesa. <verse eid="GEN 40:12" /><verse number="13" style="v" sid="GEN 40:13" />Vadži trin đive thaj o faraon ka vazdol ćo šoro thaj ka iril tut ke ćo than. Palem ka čhuve o pehari lese ano va sar angleder, kana sana leso peharniko. <verse eid="GEN 40:13" /><verse number="14" style="v" sid="GEN 40:14" />A kana ka avol tuće šukar, de tu gođi mandar. Av ljubazno, vaćar e faraonese mandar, te ikalol man tare kava phanglipe. <verse eid="GEN 40:14" /><verse number="15" style="v" sid="GEN 40:15" />Golese kaj ki zor man inđarde andari phuv e Jevrejenđi, a ni kate khanči ni ćerdem sose bi zasluživa te čhuden man ano phanglipe.”<verse eid="GEN 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 40:16" />Kana dikhlja o šorutno pekari sar o Josif šukar tumačisada o suno, phenda lese: “I me dikhljem suno: Ko šoro sasa man trin korpe mangrenđe. <verse eid="GEN 40:16" /><verse number="17" style="v" sid="GEN 40:17" />Ani upruni korpa sasa but vrste pecivura zako faraon, al xana len e čiriklja andari korpa savi sasa ko mo šoro.”<verse eid="GEN 40:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 40:18" />O Josif vaćarda: “Akh so značil gova suno: Trin korpe si trin đive. <verse eid="GEN 40:18" /><verse number="19" style="v" sid="GEN 40:19" />Vadži trin đive thaj o faraon ka čhinol ćo šoro thaj ka umlavol tut ko kaš, thaj e čiriklja ka xan tutar o mas.”<verse eid="GEN 40:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 40:20" />Pale trin đive sasa e faraoneso bijando đive. Tegani o faraon ćerda baro xape sa pe službenikurenđe thaj ikalda angle lende e šorutne peharniko thaj e šorutne pekare. <verse eid="GEN 40:20" /><verse number="21" style="v" sid="GEN 40:21" />E šorutne peharniko irisada ke leso than thaj vov palem čhuvola o pehari ane faraoneso va, <verse eid="GEN 40:21" /><verse number="22" style="v" sid="GEN 40:22" />a e šorutne pekare obesisada. Sasa gija sar so o Josif tumačisada lenđe e sune.<verse eid="GEN 40:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 40:23" />Al o šorutno peharniko ni dija pe gođi e Josifese. Bistarda pe leste.<verse eid="GEN 40:23" /></para>
  <chapter eid="GEN 40" />
  <chapter number="41" style="c" sid="GEN 41" />
  <para style="s">E faraonese sune</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1" />Pale duj berš o faraon dikhlja suno: Ačhilo paši len o Nil <verse eid="GEN 41:1" /><verse number="2" style="v" sid="GEN 41:2" />thaj dikhlja sar andaro Nil iklile efta lačhe thaj thule guruvnja save lije te čaron maškari trska. <verse eid="GEN 41:2" /><verse number="3" style="v" sid="GEN 41:3" />Pale lende andaro Nil iklile aver efta guruvnja, bilačhe thaj šuće, thaj ačhile ki obala e Nilesi paše kola avera guruvnja. <verse eid="GEN 41:3" /><verse number="4" style="v" sid="GEN 41:4" />Tegani kola efta bilačhe thaj šuće guruvnja xalje kole lačhe thaj thule guruvnjen. Pale gova o faraono uštilo taro sojipe.<verse eid="GEN 41:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 41:5" />Kana palem zasuta, dikhlja aver suno: Efta pherde thaj lačhe klasura điv barile ki jekh stabiljka. <verse eid="GEN 41:5" /><verse number="6" style="v" sid="GEN 41:6" />Pale lende barile efta aver šuće klasura điv, phabarde istočnone balvaljasa. <verse eid="GEN 41:6" /><verse number="7" style="v" sid="GEN 41:7" />Tegani kola šuće klasura xalje kole efta lačhe thaj thule klasuren. Pale gova o faraon uštilo thaj haljarda kaj dikhlja samo suno.<verse eid="GEN 41:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 41:8" />Sabalin o faraon sasa uznemirimo, pa bičhalda te anen sa e egipatskone čarobnjakuren thaj sa e mudrakuren. Phenda lenđe pe sune, al khoni naštine te phenol so značin gola sune.<verse eid="GEN 41:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 41:9" />Tegani phenda o šorutno peharniko: “Avđive dijem gođi kaj ćerdem jekh bilačhipe. <verse eid="GEN 41:9" /><verse number="10" style="v" sid="GEN 41:10" />Jekh drom holaljan pe ćire sluge, man thaj e šorutne pekare čhutan ano phanglipe ano ćher e zapovednikoso e stražarengo. <verse eid="GEN 41:10" /><verse number="11" style="v" sid="GEN 41:11" />Solduj džene dikhljam sune ani jekh rat thaj svako suno sasa le piro značenje. <verse eid="GEN 41:11" /><verse number="12" style="v" sid="GEN 41:12" />Gothe amencar sasa jekh terno Jevrejo, sluga e zapovednikoso e stražarengo. Vaćardam lese amare sune thaj vov phenda svakonese amendar so značil leso suno. <verse eid="GEN 41:12" /><verse number="13" style="v" sid="GEN 41:13" />Thaj sa avilo sar so vov vaćarda. Man irisade ke mingro than thaj kole avere umlade.”<verse eid="GEN 41:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 41:14" />Tegani o faraon bičhalda palo Josif thaj sigate ande le andaro phanglipe. Kana vov ranglja pe thaj urada pe, iklilo anglo faraon.<verse eid="GEN 41:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 41:15" />O faraon phenda e Josifese: “Dikhljem suno thaj khoni naštine te phenol manđe so značil. Al šundem kaj tu šaj te vaćare so značil gova suno čim šune le.”<verse eid="GEN 41:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 41:16" />O Josif phenda e faraonese: “Gova naj mandar, o Dol ka dol pravo odgovor e faraonese.”<verse eid="GEN 41:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 41:17" />Tegani phenda o faraon e Josifese: “Ano suno ačhiljem ki obala e Nilesi <verse eid="GEN 41:17" /><verse number="18" style="v" sid="GEN 41:18" />thaj andaro Nil iklile efta thule thaj lačhe guruvnja save lije te čaron maškari trska. <verse eid="GEN 41:18" /><verse number="19" style="v" sid="GEN 41:19" />Pale lende iklile efta avera guruvnja, bilačhe thaj šuće. Nikad ni dikhljem ane sa o Egipat gaći bilačhe guruvnjen.<verse eid="GEN 41:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 41:20" />Tegani kola bilačhe thaj šuće guruvnja xalje kole thule guruvnjen, save iklile angleder. <verse eid="GEN 41:20" /><verse number="21" style="v" sid="GEN 41:21" />Al kana xalje len, ni pindžardilo lenđe kaj xalje len, vadži sesa gasave bilačhe sar angleder. Tegani uštiljem taro sojipe.<verse eid="GEN 41:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 41:22" />Ane aver suno dikhljem efta klasura save barile ki jekh stabiljka, pherda thaj lačhe. <verse eid="GEN 41:22" /><verse number="23" style="v" sid="GEN 41:23" />Pale lende iklile avera efta šuće klasura, phabarde istočnone balvaljasa. <verse eid="GEN 41:23" /><verse number="24" style="v" sid="GEN 41:24" />Tegani e šuće klasura xalje kola efta šukar klasura. Gova phendem e čarobnjakurenđe, al nijekh ni džanglja te vaćarol manđe so značin gola sune.”<verse eid="GEN 41:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 41:25" />Tegani o Josif phenda e faraonese: “Solduj sune e faraonese isi len jekh isto značenje. O Dol sikada e faraonese so ka ćerol. <verse eid="GEN 41:25" /><verse number="26" style="v" sid="GEN 41:26" />Kola efta lačhe guruvnja si efta berša thaj i kola efta lačhe klasura si efta berša. Gola sune si jekh isto značenje. <verse eid="GEN 41:26" /><verse number="27" style="v" sid="GEN 41:27" />Efta šuće thaj bilačhe guruvnja, so iklile pale kola thule guruvnja, thaj i efta šuće klasura phabarde istočnone balvaljasa, značin efta berš bokhalipe.<verse eid="GEN 41:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 41:28" />Gija si sar so phenav e faraonese: O Dol sikada e faraonese so ka ćerol. <verse eid="GEN 41:28" /><verse number="29" style="v" sid="GEN 41:29" />Aven efta berš kana ka avol baro izobilje ano sa o Egipat, <verse eid="GEN 41:29" /><verse number="30" style="v" sid="GEN 41:30" />al pale lende ka aven efta berš kana ka avol baro bokhalipe. Tegani sa o izobilje ane sa o Egipat ka zabistrol pe thaj o bokhalipe ka uništil i phuv. <verse eid="GEN 41:30" /><verse number="31" style="v" sid="GEN 41:31" />Khoni ni ka dol pe gođi taro vreme kana sasa izobilje ani phuv, golese so ka avol but baro bokhalipe. <verse eid="GEN 41:31" /><verse number="32" style="v" sid="GEN 41:32" />Thaj o faraon dikhlja gola sune duj drom, golese kaj o Dol zurale odlučisada kaj gova vreme sigate ka avol. <verse eid="GEN 41:32" /><verse number="33" style="v" sid="GEN 41:33" />Golese nek rodol o faraon sposobnone thaj gođavere manuše, save ka čhuvol te avol upravitelji pe sa o Egipat. <verse eid="GEN 41:33" /><verse number="34" style="v" sid="GEN 41:34" />Nek čhuvol o faraon upraviteljen pi phuv, save ka ćiden tari žetva ano Egipat pandžto kotor ane gola efta berš kana ka avol izobilje. <verse eid="GEN 41:34" /><verse number="35" style="v" sid="GEN 41:35" />Nek ćiden sa o xape ane plodna berša save aven, thaj nek ovlastil o faraon e upraviteljen te garaven o điv ane forura thaj te araćhen le xamase. <verse eid="GEN 41:35" /><verse number="36" style="v" sid="GEN 41:36" />Gova xape te garavol pe baše kola efta berša kana ka avol o bokhalipe ano Egipat, thaj gija e manuša ni ka meren bokhale.”<verse eid="GEN 41:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37" />Kala lafura e Josifese sesa šukar e faraonese thaj lese službenikurenđe.<verse eid="GEN 41:37" /></para>
  <para style="s">O Josif postanil upravitelji po Egipat</para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 41:38" />Tegani pučlja o faraon pe službenikuren: “Šaj li arakha manuše sar so si kava, ane kaste si e Devleso Duxo?”<verse eid="GEN 41:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 41:39" />Tegani o faraon vaćarda e Josifese: “Golese kaj tuće o Dol sa kava sikada, naj khoni gaći sposobno thaj gođaver sar so san tu. <verse eid="GEN 41:39" /><verse number="40" style="v" sid="GEN 41:40" />Tu ka ave upravitelji taro mingro dvor thaj sa mingro narodo ka šunol ćire zapovestura. Samo me, golese kaj sem ko presto, ka avav upreder tute.”<verse eid="GEN 41:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 41:41" />O faraon vadži vaćarda e Josifese: “Akh, čhuvav tut te ave upravitelji pe sa o Egipat.”<verse eid="GEN 41:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 41:42" />Tegani uljarda pi pečatno angrustik tare po va thaj čhuta la e Josifese po va. Urada le šeja taro sano lan thaj pi kor čhuta lese zlatno lanco. <verse eid="GEN 41:42" /><verse number="43" style="v" sid="GEN 41:43" />Dija le te vozil pe ano vordon pale leste sar leso zameniko thaj e manuša anglo Josif dena vika: “Peren ke koča!” Gija čhuta le te avol upravitelji pe sa o Egipat.<verse eid="GEN 41:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="GEN 41:44" />O faraon vaćarda e Josifese: “Me sem faraon, al dži kaj tu ni vaćare, khoni ano Egipat khanči ni ka ćerol.”<verse eid="GEN 41:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 41:45" />Pale gova o faraon dija e Josifese alav Cofnat Paaneah thaj dija le romnjaće e Osnata, e čheja e sveštenikosi e Potiferesi taro foro On. Gija o Josif dobisada vlast pe sa o Egipat.<verse eid="GEN 41:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 41:46" />E Josife sasa tranda (30) berš kana dija ani služba ko faraon, ko caro e Egipateso. Tegani o Josif đelo taro faraon thaj lija te džal ano sa o Egipat. <verse eid="GEN 41:46" /><verse number="47" style="v" sid="GEN 41:47" />Ane efta berša kana sasa izobilje i phuv but bijanola <verse eid="GEN 41:47" /><verse number="48" style="v" sid="GEN 41:48" />a o Josif ćidola sa o xape savo bijandilo ane gola efta berš ano Egipat, thaj garavola le ane forura. Ane dži jekh foro garavola o xape tare pašutne poljura. <verse eid="GEN 41:48" /><verse number="49" style="v" sid="GEN 41:49" />Gija o Josif ćidija gaći but điv sar i pošik e moresi, čak ačhada i te meril le, golese kaj naštine ni te meril pe.<verse eid="GEN 41:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 41:50" />Dži kaj ni avile e berša taro bokhalipe, i Osnata, i čhej e sveštenikosi e Potiferesi taro foro On, bijanda e Josifese duje čhaven.<verse eid="GEN 41:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="GEN 41:51" />E anglune bijande čhavese o Josif dija alav Manasija<note caller="+" style="f"><char style="fr" closed="false">41,51 </char><char style="fq" closed="false">Manasija </char><char style="ft" closed="false">Značil: “Te bistrol.”</char></note>, golese so phenda: “O Dol ćerda te bistrav sa mo pharipe thaj sa me dadese familija.”<verse eid="GEN 41:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="GEN 41:52" />Dujtone čhavese dija alav Efrem<note caller="+" style="f"><char style="fr" closed="false">41,52 </char><char style="fq" closed="false">Efrem </char><char style="ft" closed="false">Značil: “Te avol plodno duj droma.”</char></note>, golese so phenda: “O Dol ćerda te avav plodno ani phuv kaj sasa man baro pharipe.”<verse eid="GEN 41:52" /></para>
  <para style="s">Bokhalipe</para>
  <para style="p">
    <verse number="53" style="v" sid="GEN 41:53" />Kana nakhle efta berš kana sasa izobilje ano Egipat, <verse eid="GEN 41:53" /><verse number="54" style="v" sid="GEN 41:54" />avile efta berš bokhalipe, gija sar so angleder phenda o Josif. Sasa bokhalipe ane sa e phuva, al ano sa o Egipat sasa xape. <verse eid="GEN 41:54" /><verse number="55" style="v" sid="GEN 41:55" />Kana i ano Egipat lija te avol o bokhalipe, o narodo lija rojindoj te manđol xape taro faraon.</para>
  <para style="p" vid="GEN 41:55">Tegani o faraon vaćarda sa e Egipćanurenđe: “Džan ko Josif thaj ćeren sa so ka vaćarol tumenđe.”<verse eid="GEN 41:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 41:56" />Kana o bokhalipe barilo maškari sa i phuv, o Josif putarda e thana kaj garada o điv thaj lija te biknol o điv e Egipćanurenđe, golese so ano Egipat sasa but baro bokhalipe.<verse eid="GEN 41:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="GEN 41:57" />Thaj e manuša andaro sa o sveto avena ano Egipat te ćinen điv taro Josif, golese so o bokhalipe ano sa o sveto sasa but baro.<verse eid="GEN 41:57" /></para>
  <chapter eid="GEN 41" />
  <chapter number="42" style="c" sid="GEN 42" />
  <para style="s">E Josifese phrala aven ano Egipat</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1" />Kana o Jakov dodžanglja kaj ano Egipat isi điv, pučlja pe čhaven: “Sose samo bešen thaj dićhen jekh avere?” <verse eid="GEN 42:1" /><verse number="2" style="v" sid="GEN 42:2" />Tegani vaćarda: “Šundem kaj ano Egipat isi điv. Džan odori thaj ćinen amenđe, te bi ačhasa džuvde thaj te ma bi merasa bokhatar!”<verse eid="GEN 42:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 42:3" />Tegani e deš phrala e Josifese đele ano Egipat te ćinen điv. <verse eid="GEN 42:3" /><verse number="4" style="v" sid="GEN 42:4" />Al e Venijamine, e Josifese phrale, o dad avere phralencar ni bičhalda, golese so darajlo te ma avol nesavo bilačhipe pe leste. <verse eid="GEN 42:4" /><verse number="5" style="v" sid="GEN 42:5" />Gija e Izraelese čhave sesa maškare kola save đele ano Egipat te ćinen điv, golese so o bokhalipe avilo thaj ani phuv i Hanaansko.<verse eid="GEN 42:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 42:6" />O Josif sasa o egipatsko upravitelji, kova savo bićinda o điv sa e manušenđe ki phuv.</para>
  <para style="p" vid="GEN 42:6">Lese phrala avile angle leste thaj pele ke koča mujesa dži ki phuv. <verse eid="GEN 42:6" /><verse number="7" style="v" sid="GEN 42:7" />Kana o Josif dikhlja pe phralen, pindžarda len, al ćerda pe premal lende sar abandžija thaj holjame pučlja len: “Katar aviljen?”</para>
  <para style="p" vid="GEN 42:7">Von phende lese: “Andari phuv i Hanaansko te ćina xamase.”<verse eid="GEN 42:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 42:8" />O Josif gija pindžarda pe phralen, al von le ni pindžarde. <verse eid="GEN 42:8" /><verse number="9" style="v" sid="GEN 42:9" />Vov dija gođi tare sune so dikhlja, thaj phenda: “Tumen sen špijunura! Aviljen te dićhen e slaba thana kale phuvaće.”<verse eid="GEN 42:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 42:10" />Von phende lese: “Na, gospodarona, amen sam ćire sluge thaj aviljam te ćina xamase. <verse eid="GEN 42:10" /><verse number="11" style="v" sid="GEN 42:11" />Savore sam čhave jekhe manušese thaj sam poštena manuša. Ćire sluge naj špijunura.”<verse eid="GEN 42:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 42:12" />O Josif phenda pe phralenđe: “Na, tumen aviljen te dićhen e slaba thana kale phuvaće.”<verse eid="GEN 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 42:13" />Von irisade: “Amen, ćire sluge, sama dešuduj (12) phrala, čhave jekhe dadese tari phuv i Hanaansko. O emcikno akana si amare dadesa thaj jekh naj vadži džuvdo.”<verse eid="GEN 42:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 42:14" />Al o Josif vadži phenda lenđe: “Gija si sar so phendem tumenđe: Tumen sen špijunura! <verse eid="GEN 42:14" /><verse number="15" style="v" sid="GEN 42:15" />Gija ka iskušiv tumen: Xav sovli po faraon, akatar ni ka ikljen dži kaj tumaro terno phral ni avol akari! <verse eid="GEN 42:15" /><verse number="16" style="v" sid="GEN 42:16" />Bičhalen jekhe tumendar te anol tumare phrale. Avera phrala ka ačhen kate ano phanglipe! Gija ka proveriv tumare lafura thaj ka dikha dal vaćaren čačipe. Te ni vaćarden čačipe, xav sovli po faraon, tegani sen špijunura!”<verse eid="GEN 42:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 42:17" />Pale gova čhuta len ano phanglipe trin đive.<verse eid="GEN 42:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 42:18" />Trito đive phenda o Josif: “Ćeren gija thaj ka ačhen džuvde, golese kaj sem manuš savo daral e Devlestar. <verse eid="GEN 42:18" /><verse number="19" style="v" sid="GEN 42:19" />Te sen poštena, nek ačhol jekh tumendar ano phanglipe. Avera džan thaj inđaren o điv tumare bokhale familijaće. <verse eid="GEN 42:19" /><verse number="20" style="v" sid="GEN 42:20" />Pale gova anen mande tumare emterne phrale, gija te dikhav kaj si čačukane tumare lafura thaj te ma mudardon.” Thaj von složisajle golesa.<verse eid="GEN 42:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 42:21" />Pale gova jekh averese phende: “Sigurno reslja amen i kazna baše amaro phral. Dikhljam lesi muka dži kaj molisada amen baše piro džuvdipe, al ni šundam le, golese kava baro pharipe arakhlja amen.”<verse eid="GEN 42:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 42:22" />O Ruvim phenda lenđe: “Ni li phendem tumenđe ma te grešin protiv o čhavo? Al tumen ni mangljen te šunen man. Akana rodol pe računo lese ratese.”<verse eid="GEN 42:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 42:23" />Al von ni džanglje kaj o Josif haljarol len, golese kaj vov lencar vaćarda prekalo tumači. <verse eid="GEN 42:23" /><verse number="24" style="v" sid="GEN 42:24" />O Josif irisajlo lendar thaj lija te rovol. Tegani palem irisajlo thaj vaćarda lencar. Pale gova crdija e Simeone lendar thaj phenda te phanden le angle lenđe jakha.<verse eid="GEN 42:24" /></para>
  <para style="s">E Josifese phrala irin pe ano Hanaan</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 42:25" />Pale gova zapovedisada o Josif te pheren lenđe traste đivesa, thaj dži jekhese te irin lese pare ane traste thaj te den len sa so trubul dromese. Gija i ćerde. <verse eid="GEN 42:25" /><verse number="26" style="v" sid="GEN 42:26" />Von čhute o điv pe pumare hera thaj đele gothar.<verse eid="GEN 42:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 42:27" />Kana ko drom ačhile te soven, jekh lendar putarda pi trasta te parvarol pe here, dikhlja kaj odupral ani trasta sesa e pare.<verse eid="GEN 42:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 42:28" />Tegani phenda pe phralenđe: “E pare irisade manđe! Aktale ani mi trasta!”</para>
  <para style="p" vid="GEN 42:28">Tegani von lije te tresin tari dar, pa pučlje jekh avere: “So ćerda amenđe o Dol?”<verse eid="GEN 42:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 42:29" />Kana resle ke po dad o Jakov ano Hanaan, phende pe dadese sa so sasa, <verse eid="GEN 42:29" /><verse number="30" style="v" sid="GEN 42:30" />vaćarindoj: “O manuš savo si gospodari gole phuvako, holjame vaćarda amencar thaj phenda kaj aviljam ane goja phuv sar špijunura. <verse eid="GEN 42:30" /><verse number="31" style="v" sid="GEN 42:31" />Al amen phendam lese: ‘Poštena sam manuša, naj sam špijunura. <verse eid="GEN 42:31" /><verse number="32" style="v" sid="GEN 42:32" />Sama dešuduj phrala, čhave jekhe dadese tari phuv i Hanaansko. O emcikno akana si amare dadesa thaj jekh naj vadži džuvdo.’ <verse eid="GEN 42:32" /><verse number="33" style="v" sid="GEN 42:33" />Tegani kova gospodari ani goja phuv vaćarda amenđe: ‘Gija ka džanav dal sen poštena manuša: Ačhaven jekhe phrale ke mande, len xamase baše tumari bokhali familija, pa džan! <verse eid="GEN 42:33" /><verse number="34" style="v" sid="GEN 42:34" />Tegani anen manđe tumare emcikne phrale, gija te džanav kaj naj sen špijunura, nego poštena manuša. Pale gova ka iriv tumare phrale, thaj tumen šaj slobodno te phiren ane kaja phuv.’”<verse eid="GEN 42:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 42:35" />Sar čučarde pumare traste, dži jekh lendar arakhlja pe pare ane kese. Kana von katane lenđe dadesa dikhlje e kese e parencar, darajle.<verse eid="GEN 42:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 42:36" />Lengo dad o Jakov phenda: “Tumendar ka ačhav bize čhave! O Josif najstalo, najstalo ni o Simeon, a akana manđen te len mandar thaj e Venijamine. Sa ćidija pe protiv mande!”<verse eid="GEN 42:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 42:37" />Tegani phenda o Ruvim pe dadese: “Šaj mudare mingre duje muršen te ni andem e Venijamine palal. De le mande, a me ka iriv le tuće palal.”<verse eid="GEN 42:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 42:38" />Al o Jakov phenda: “Mo čhavo ni ka džal tumencar, golese so leso phral mulo thaj samo vov ačhilo. Ko drom šaj araćhol tumen nesavo bilačhipe. Me sem purano manuš, thaj i žal palo Venijamin savi bi ćerena manđe, bi mudarola man.”<verse eid="GEN 42:38" /></para>
  <chapter eid="GEN 42" />
  <chapter number="43" style="c" sid="GEN 43" />
  <para style="s">E Josifese phrala irin pe ano Egipat</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1" />Ani phuv i Hanaansko o bokhalipe sasa but baro.<verse eid="GEN 43:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 43:2" />Kana xalje sa o điv savo ande taro Egipat, vaćarda lenđe lengo dad: “Džan ano Egipat thaj ćinen amenđe vadži zala xape.”<verse eid="GEN 43:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 43:3" />Al o Juda vaćarda lese: “Kova manuš zurale upozorisada amen: ‘Ma ikljen manđe angle jakha bizo tumaro phral.’ <verse eid="GEN 43:3" /><verse number="4" style="v" sid="GEN 43:4" />Ako manđe te bičhale amare phrale amencar, ka dža thaj ka ćina tuće xape. <verse eid="GEN 43:4" /><verse number="5" style="v" sid="GEN 43:5" />Al ako ni manđe te bičhale le, ni ka dža, golese so kova manuš vaćarda: ‘Ma ikljen manđe angle jakha bizo tumaro phral.’ ”<verse eid="GEN 43:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 43:6" />Tegani o Izrael pučlja: “Sose čhuten man ane kava bilačhipe gija so vaćarden gole manušese kaj isi tumen vadži jekh phral?”<verse eid="GEN 43:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 43:7" />Von vaćarde: “Gova manuš odural raspučlja pe amendar thaj tari amari familija. Pučlja: ‘Džuvdo li si tumaro dad vadži? Isi li tumen vadži jekh phral?’ Thaj amen vaćardem lese sa so pučlja. Kotar šajine te džana kaj ka phenol: ‘Anen tumare phrale’?”<verse eid="GEN 43:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 43:8" />Tegani o Juda vaćarda pe dadese e Izraelese: “Bičhal e čhave e Venijamine mancar thaj amen odma ka dža. Gija ka ačha džuvde thaj ni ka mera ni amen ni tu ni amare čhave. <verse eid="GEN 43:8" /><verse number="9" style="v" sid="GEN 43:9" />Me garantujiv tuće baše leste, man dikh sar odgovorno. Te ni irisadem le tuće saste, ane sa e đivesa mingre džuvdimase ka avav bango angle tute. <verse eid="GEN 43:9" /><verse number="10" style="v" sid="GEN 43:10" />Te ni ađućarasa gaći, šajine dži akana duj droma te iri amen.”<verse eid="GEN 43:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 43:11" />Tegani lengo dad o Izrael phenda: “Te gijate trubul te avol, ćeren sar so phenav tumenđe: Čhuven ane traste emšukar bijandipe tari kaja phuv thaj inđaren len kole manušese sar daro: zala balsam, zala avđin, začinura thaj smirna, pistaćura thaj bademura. <verse eid="GEN 43:11" /><verse number="12" style="v" sid="GEN 43:12" />Thaj inđaren duj drom pobut pare, golese so trubul te irin e pare save sesa tumenđe čhute palem ane traste. Šaj khoni grešisada. <verse eid="GEN 43:12" /><verse number="13" style="v" sid="GEN 43:13" />Inđaren tumare phrale thaj odma džan ke gova manuš. <verse eid="GEN 43:13" /><verse number="14" style="v" sid="GEN 43:14" />O Emzuralo Dol nek ćerol kova manuš te smiluil pe tumenđe, te mućhol tumare phralen e Simeone thaj e Venijamine te irin pe tumencar. A me, te ačhiljem bize čhave, nek ačhav.”<verse eid="GEN 43:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 43:15" />Gija e phrala lije e darura thaj duj droma pobut pare, thaj lije i e Venijamine. Sigate đele ano Egipat thaj ačhile anglo Josif.<verse eid="GEN 43:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 43:16" />Kana o Josif dikhlja e Venijamine lencar, vaćarda e upraviteljese tare leso ćher: “Inđar kale manušen ane mo ćher, čhin jekhe životinja thaj ćer xape, golese kaj von ka xan o ručko mancar.”<verse eid="GEN 43:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 43:17" />O upravitelji ćerda gija sar so vaćarda lese o Josif thaj inđarda e phralen ane Josifeso ćher. <verse eid="GEN 43:17" /><verse number="18" style="v" sid="GEN 43:18" />Von darajle kana inđarde len ane Josifeso ćher. Dije gođi: “Ande amen kate baše pare save sesa amenđe čhute ane traste. Ka čalaven pe amende thaj ka peraven amen. Ka ćeren amendar roburen thaj ka len amare heren.”<verse eid="GEN 43:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 43:19" />Golese e phrala avile anglo vudar paše Josifeso ćher thaj vaćarde lese upraviteljesa. <verse eid="GEN 43:19" /><verse number="20" style="v" sid="GEN 43:20" />Phende lese: “Moli tut, gospodarona, amen aviljam angleder te ćina xamase, <verse eid="GEN 43:20" /><verse number="21" style="v" sid="GEN 43:21" />al kana ačhiljam ko jekh than te raćara, putardam amare traste. Dži jekh amendar arakhlja sa pe pare odupral ane piri trasta. Akana andam amencar gola pare te iri len palal. <verse eid="GEN 43:21" /><verse number="22" style="v" sid="GEN 43:22" />Andam vadži pare palem te ćina xamase. Ni džana ko čhuta amenđe amare pare ane traste.”<verse eid="GEN 43:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 43:23" />O upravitelji vaćarda: “Ma čhuven tumenđe ano ilo, ma daran. Tumaro Dol, o Dol tumare dadeso, čhuta gola pare ane tumare traste. Tumare pare avile dži mande.”</para>
  <para style="p" vid="GEN 43:23">Tegani anda lenđe e Simeone. <verse eid="GEN 43:23" /><verse number="24" style="v" sid="GEN 43:24" />Pale gova o upravitelji inđarda len ane Josifeso ćher, dija len paj te thoven pumare pingre, a lenđe herenđe dija te xan. <verse eid="GEN 43:24" /><verse number="25" style="v" sid="GEN 43:25" />Von lije te spremin e darura bašo Josif kana ka avol ke opašo đive, golese kaj šunde so gothe ka xan. <verse eid="GEN 43:25" /><verse number="26" style="v" sid="GEN 43:26" />Kana o Josif avilo ćhere, von dije le e darura save inđarde lese ano ćher, thaj pele ke koča anglo Josif mujesa dži i phuv.<verse eid="GEN 43:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 43:27" />Vov pučlja len sar si, pa vaćarda: “Sar si tumaro purano dad, tare savo vaćarden manđe? Džuvdo li si vadži?”<verse eid="GEN 43:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 43:28" />Von vaćarde: “Ćo sluga, amaro dad, vadži si džuvdo thaj sasto.” Pale gova pele ke koča angle leste mujesa dži i phuv.<verse eid="GEN 43:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 43:29" />Kana o Josif dikhlja maškar lende pe phrale e Venijamine, pe daće čhave, pučlja: “Kava li si tumaro emterno phral, tare savo vaćarden manđe?”</para>
  <para style="p" vid="GEN 43:29">Tegani phenda: “O Dol te avol milostivo tusa, mo čhavo.”<verse eid="GEN 43:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 43:30" />O Josif sigate iklilo avri golese so but potresisajlo kana dikhlja pe phrale thaj samo so ni lija te rovol. Đelo ani aver soba thaj odori lija te rovol.<verse eid="GEN 43:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 43:31" />Kana thoda po muj, iklilo, ićarda pe te ni rovol thaj phenda: “Anen xamase!”<verse eid="GEN 43:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 43:32" />E Josifese čhute o xape ko jekh astali, lese phralenđe ko aver a e Egipćanurenđe save xalje lesa, čhute ko aver astali. E Egipćanura naštine te xan e Jevrejencar, golese kaj sasa lenđe odvratno.<verse eid="GEN 43:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 43:33" />E phrala sesa čhute te bešen angle leste pale lengo phurederipe, taro emphureder dži ko emterno. Golese samo dićhena jekh avere ano čudo. <verse eid="GEN 43:33" /><verse number="34" style="v" sid="GEN 43:34" />Kana anena lenđe xape tare Josifeso astali, e Venijamineso xape sasa pandž droma pobaro tare savorengo. Gija e phrala xalje e Josifesa thaj but pilje.<verse eid="GEN 43:34" /></para>
  <chapter eid="GEN 43" />
  <chapter number="44" style="c" sid="GEN 44" />
  <para style="s">Srebrno tahtaj ani trasta</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1" />Tegani o Josif zapovedisada e upraviteljese tare po ćher: “Pher e traste kale manušenđe xamasa kobor šaj inđaren, a dži jekhese iri odupral ki trasta lese pare. <verse eid="GEN 44:1" /><verse number="2" style="v" sid="GEN 44:2" />Pale gova čhuv ani trasta e emternesi mingro srebrno tahtaj katane lese parencar savesa poćinda o điv.”</para>
  <para style="p" vid="GEN 44:2">Vov ćerda sar so zapovedisada lese o Josif.<verse eid="GEN 44:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 44:3" />Kana đivesajlo, bičhalde e phralen thaj lenđe heren ko drom.<verse eid="GEN 44:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 44:4" />Thaj samo so iklile andaro foro thaj ni đele dur, o Josif phenda e upraviteljese tare po ćher: “Sigate dža pale kola manuša! Kana ka rese len, puč len: ‘Sose irin bilačhe bašo šukaripe? Sose čorden o srebrno tahtaj me gospodareso? <verse eid="GEN 44:4" /><verse number="5" style="v" sid="GEN 44:5" />Gova si tahtaj andare savo mo gospodari pijol thaj andare leste dikhljarol. Ćerden baro bilačhipe!’”<verse eid="GEN 44:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 44:6" />Kana reslja len o upravitelji, vaćarda lenđe sa kala lafura. <verse eid="GEN 44:6" /><verse number="7" style="v" sid="GEN 44:7" />Al von pe gova pučlje: “Sose gospodarona gija phene? Dur golestar, amen, ćire sluge, te ćera gijate khanči! <verse eid="GEN 44:7" /><verse number="8" style="v" sid="GEN 44:8" />Dikhljan kaj e pare so arakhljam ane amare traste, andam tuće palal andari phuv i Hanaansko. Sose bi tegani čorasa srebro il zlato andaro ćher ćire gospodareso? <verse eid="GEN 44:8" /><verse number="9" style="v" sid="GEN 44:9" />Te arakhlja pe gova ke jekh ćiro sluga, mudaren le, a amen avera ka ava robura će gospodarese.”<verse eid="GEN 44:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 44:10" />O upravitelji phenda: “Šukar vaćaren, al nek avol gijate: ‘Kaste araćhol pe o srebrno tahtaj, ka avol mingro robo, a tumen avera ka aven slobodna.’”<verse eid="GEN 44:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 44:11" />Tegani dži jekh lendar mukhlja pi trasta ki phuv thaj putarda la. <verse eid="GEN 44:11" /><verse number="12" style="v" sid="GEN 44:12" />O upravitelji lija te rodol ane traste, taro emphureder dži ko emterno. O tahtaj arakhlja pe ani trasta e Venijaminesi. <verse eid="GEN 44:12" /><verse number="13" style="v" sid="GEN 44:13" />Tegani von pharade pe fostanura thaj savore čhute pe traste pe hera thaj irisajle ano foro.<verse eid="GEN 44:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 44:14" />Kana avilo o Juda pe phralencar ane Josifeso ćher, o Josif vadži sasa gothe. Tegani e phrala pele ke koča angle leste, <verse eid="GEN 44:14" /><verse number="15" style="v" sid="GEN 44:15" />a o Josif phenda lenđe: “So gova ćerden? Ni li džanen kaj manuš sar me dikhljarol?”<verse eid="GEN 44:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 44:16" />Tegani phenda o Juda: “So te phena tuće, gospodarona? So te vaćara? Sar te opravdi amen kaj naj sam banđe? O Dol sikada o bilačhipe amaro, ćire slugengo. Akh, amen savore sam akana će robura, gospodarona, amen thaj kova kaste arakhlja pe ćiro srebrno tahtaj.”<verse eid="GEN 44:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 44:17" />O Josif phenda lenđe: “Dur te avol mandar te ćerav gija khanči! Kaste arakhlja pe o tahtaj, vov ka avol mo robo, a tumen savore šaj džan ano mir tumare dadese.”<verse eid="GEN 44:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18" />O Juda avilo ke leste thaj phenda lese: “Moliv tu, gospodarona, mukh će slugase te phenol tuće khanči thaj ma av holjavo pe mande, pe ćo sluga, golese kaj tu san sar o faraon. <verse eid="GEN 44:18" /><verse number="19" style="v" sid="GEN 44:19" />Tu gospodarona mingreja pučljan će slugen: ‘Isi li tumen dad il phral?’ <verse eid="GEN 44:19" /><verse number="20" style="v" sid="GEN 44:20" />A amen phendam amare gospodarese: ‘Isi amen purano dad thaj emterno phral, savo bijandilo lese ano puranipe. Leso phral mulo thaj samo vov ačhilo tare čhave pe daće, thaj mo dad but manđol le.’ <verse eid="GEN 44:20" /><verse number="21" style="v" sid="GEN 44:21" />Tegani tu phendan amenđe, ćire slugenđe: ‘Anen le te dikhav le.’ <verse eid="GEN 44:21" /><verse number="22" style="v" sid="GEN 44:22" />Thaj amen phendam amare gospodarese: ‘Našti o čhavo te ačhavol pe dade, golese kaj te ačhada le, tegani bi o dad merola.’ <verse eid="GEN 44:22" /><verse number="23" style="v" sid="GEN 44:23" />Al tu phendan amenđe, će slugenđe: ‘Te ni avilo tumencar tumaro emterno phral, ma ikljen manđe angle jakha!’ <verse eid="GEN 44:23" /><verse number="24" style="v" sid="GEN 44:24" />Kana irisaljam ke ćo sluga, ke amaro dad, phendam lese so tu gospodarona vaćardan. <verse eid="GEN 44:24" /><verse number="25" style="v" sid="GEN 44:25" />Tegani amaro dad phenda te iri amen palem te ćinen amenđe vadži zala xamase. <verse eid="GEN 44:25" /><verse number="26" style="v" sid="GEN 44:26" />Al amen phendam: ‘Našti dža, sem te ni avilo amencar amaro emterno phral. Našti iklja angle jakha kole manušese bizo amaro emterno phral.’ <verse eid="GEN 44:26" /><verse number="27" style="v" sid="GEN 44:27" />Ćiro sluga, amaro dad, vaćarda amenđe: ‘Tumen džanen kaj mi romni bijanda manđe samo duje muršen. <verse eid="GEN 44:27" /><verse number="28" style="v" sid="GEN 44:28" />Jekh đelo mandar thaj me phendem: “Sigurno si čhindo ke kotora,” thaj nikad vadži ni dikhljem le. <verse eid="GEN 44:28" /><verse number="29" style="v" sid="GEN 44:29" />Te lijen mandar i kale čhave, thaj ako avol lese khanči bilačhe, i žal savi bi ćerena manđe bi mudarola man, golese so me sem purano manuš.’<verse eid="GEN 44:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 44:30" />Te irisaljem akana me dadese, ćire slugase, thaj mo dad kaso džuvdipe si zurale phanglo e čhavoresa, <verse eid="GEN 44:30" /><verse number="31" style="v" sid="GEN 44:31" />dićhol kaj o čhavoro naj amencar, ka merol. Gija amen, ćire sluge, ka trada amare dade, tumare sluga, purane thaj bibaxtale ano limori. <verse eid="GEN 44:31" /><verse number="32" style="v" sid="GEN 44:32" />Me, ćiro sluga, garantujisadem me dadese bašo čhavoro. Vaćardem: ‘Te ni irisadem le tuće saste, ane sa e đivesa mingre džuvdimase ka avav bango angle tute!’ <verse eid="GEN 44:32" /><verse number="33" style="v" sid="GEN 44:33" />Golese, gospodarona, moliv tut, mukh te ačhav kate umesto o čhavoro me sar ćiro robo, a tu mukh e čhavore te iril pe pe phralencar. <verse eid="GEN 44:33" /><verse number="34" style="v" sid="GEN 44:34" />Golese, sar te iriv man me dadese, te o čhavoro naj mancar? Našti dikhav e dukha save bi araćhena me dade.”<verse eid="GEN 44:34" /></para>
  <chapter eid="GEN 44" />
  <chapter number="45" style="c" sid="GEN 45" />
  <para style="s">O Josif vaćarol pe phralenđe ko si vov</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1" />Tegani o Josif naštine vadži te kontrolišil pe angle pe sluge thaj dija vika: “Ikljen savore!” Gija khoni ni sasa e Josifesa kana vaćarda pe phralenđe ko si vov. <verse eid="GEN 45:1" /><verse number="2" style="v" sid="GEN 45:2" />Al o Josif gaći zurale ruja kaj šunde le čak i e Egipćanura thaj gova dodžanglja pe i ke faraoneso dvor.<verse eid="GEN 45:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 45:3" />O Josif vaćarda pe phralenđe: “Me sem o Josif! Džuvdo li si mo dad vadži?”</para>
  <para style="p" vid="GEN 45:3">Al lese phrala gaći darajle kaj naštine nijekh lafi te vaćaren lese.<verse eid="GEN 45:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 45:4" />Tegani o Josif vaćarda lenđe: “Aven po paše.”</para>
  <para style="p" vid="GEN 45:4">Kana avile po paše, vaćarda o Josif: “Me sem tumaro phral o Josif, kas bićinden ano Egipat! <verse eid="GEN 45:4" /><verse number="5" style="v" sid="GEN 45:5" />Al akana ma daran thaj ma holjavon pe tumende so bićinden man kate, golese so o Dol bičhalda man angle tumende, te bi araćhola pe o džuvdipe pi phuv. <verse eid="GEN 45:5" /><verse number="6" style="v" sid="GEN 45:6" />Već duj berš vladil o bokhalipe ani phuv, thaj vadži pandž berš ni ka oril pe thaj ni ka avol žetva. <verse eid="GEN 45:6" /><verse number="7" style="v" sid="GEN 45:7" />O Dol bičhalda man angle tumende, te bi čudesno spasila tumaro džuvdipe thaj te bi šajine te avol tumen potomstvo pi phuv. <verse eid="GEN 45:7" /><verse number="8" style="v" sid="GEN 45:8" />Gija, ni bičhalden man tumen akate, nego o Dol. Vov čhuta man te avav embaro e faraoneso službeniko, gospodari pe sa leso ćher thaj vladari pe sa o Egipat.<verse eid="GEN 45:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 45:9" />Akana siđaren palal ke mo dad thaj vaćaren lese: ‘Ćo čhavo o Josif vaćarol gija: O Dol čhuta man te avav gospodari pe sa o Egipat. Av mande thaj ma ađućar. <verse eid="GEN 45:9" /><verse number="10" style="v" sid="GEN 45:10" />Ka beše ani phuv Gošen thaj ka ave manđe paše – tu, će čhave thaj će unukura, ćiri cikni thaj bari stoka, thaj sa so isi tut. <verse eid="GEN 45:10" /><verse number="11" style="v" sid="GEN 45:11" />Me ka briniv man tutar odori, golese so aven vadži pandž berš bokhalipe. Gija ni ka ave bokhalo ni tu, ni će ćherutne ni savore ćire.’”<verse eid="GEN 45:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 45:12" />O Josif vadži vaćarda: “Tumen thaj mingro phral o Venijamin šaj tumare jakhencar te dićhen, kaj čače gova sem me savo vaćarav tumencar. <verse eid="GEN 45:12" /><verse number="13" style="v" sid="GEN 45:13" />Vaćaren me dadese baše sa o čast savo si manđe sikado ano Egipat, thaj baše sa so dikhljen. Thaj sigate anen me dade kate!”<verse eid="GEN 45:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 45:14" />Tegani o Josif zagrlisada pe phrale e Venijamine thaj i vov zagrlisada le, pa solduj džene lije te roven. <verse eid="GEN 45:14" /><verse number="15" style="v" sid="GEN 45:15" />Gija rojindoj grlisada thaj čumidija sa pe phralen. Pale gova lese phrala lije te vaćaren lesa.<verse eid="GEN 45:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 45:16" />Kana dodžanglja pe ke faraoneso dvor kaj avile e Josifese phrala, o faraon thaj lese službenikura radujisajle.<verse eid="GEN 45:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 45:17" />O faraon vaćarda e Josifese: “Vaćar će phralenđe: ‘Ćeren gija: Tovarin pe tumare životinje o xape thaj irin tumen ano Hanaan. <verse eid="GEN 45:17" /><verse number="18" style="v" sid="GEN 45:18" />Pale gova anen tumare dade thaj tumare familija, a aven mande. Me ka dav tumen emšukar phuv ano Egipat thaj ka uživin ano lačhipe kale phuvako.’”<verse eid="GEN 45:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 45:19" />O faraon vadži vaćarda: “Thaj narediv tuće te vaćare lenđe: ‘Ćeren gija: Len tumenđe nekobor vordona taro Egipat baše tumare čhave thaj tumare romnja, anen tumare dade thaj aven. <verse eid="GEN 45:19" /><verse number="20" style="v" sid="GEN 45:20" />Ma žalin baše khanči so ka ačhaven odori, golese kaj sa so si emšukar ano Egipat ka avol tumaro.’”<verse eid="GEN 45:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 45:21" />Tegani e Izraelese čhave ćerde gija. O Josif dija len e vordona thaj xape dromese, sar so naredisada o faraon. <verse eid="GEN 45:21" /><verse number="22" style="v" sid="GEN 45:22" />Svakonese lendar o Josif dija nevo fostano, al e Venijaminese dija trišel (300) srebrenjakura thaj pandž fostanura. <verse eid="GEN 45:22" /><verse number="23" style="v" sid="GEN 45:23" />Thaj kava bičhalda pe dadese: deše heren tovarime kolesa so si emšukar ano Egipat, deše hernjen tovarime đivesa, mangresa thaj sa so trubuja e dadese bašo drom.<verse eid="GEN 45:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 45:24" />Tegani bičhalda pe phralen ko drom thaj kana đele, phenda lenđe: “Ma ćeren čingara odrumal!”<verse eid="GEN 45:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 45:25" />Gija von pojdisade taro Egipat thaj avile ani phuv i Hanaansko ke po dad o Jakov.<verse eid="GEN 45:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 45:26" />Phende lese: “O Josif si vadži džuvdo! Thaj si gospodari pe sa o Egipat!” Al e Jakoveso ilo ćerdilo sar bar thaj ni pačaja len. <verse eid="GEN 45:26" /><verse number="27" style="v" sid="GEN 45:27" />Al kana vaćarde lese sa so o Josif phenda thaj kana o Jakov dikhlja e vordona save o Josif bičhalda te anen le ano Egipat, o duxo ane leste džuvdilo.<verse eid="GEN 45:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 45:28" />Tegani phenda o Izrael: “Akana uverisaljem! Mo čhavo o Josif si džuvdo! Ka džav te dikhav le angleder so merav.”<verse eid="GEN 45:28" /></para>
  <chapter eid="GEN 45" />
  <chapter number="46" style="c" sid="GEN 46" />
  <para style="s">O Jakov džal ano Egipat</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1" />Gija o Izrael pojdisada po drom sa kolesa so sasa le. Kana reslo ani Beer-Ševa, anda žrtva e Devlese, kase služisada leso dad o Isaak.<verse eid="GEN 46:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 46:2" />O Dol akharda e Izraele ani vizija raćasa, vaćarindoj: “Jakove! Jakove!”</para>
  <para style="p" vid="GEN 46:2">Vov phenda: “Aktaljem!”<verse eid="GEN 46:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 46:3" />O Dol phenda lese: “Me sem o Dol, o Dol će dadeso. Ma te dara te dža ano Egipat, golese kaj odori ka ćerav tutar baro narodo. <verse eid="GEN 46:3" /><verse number="4" style="v" sid="GEN 46:4" />Ka džav tusa ano Egipat thaj palem ka iriv tut palal. O Josif ka avol tusa kana ka mere.”<verse eid="GEN 46:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 46:5" />Tegani o Jakov pojdisada tari Beer-Ševa. E Izraelese čhave bešljarde pe dade e Jakove, pe čhaven thaj pe romnjen pe vordona save bičhalda o faraon pale lende, te anen len ano Egipat. <verse eid="GEN 46:5" /><verse number="6" style="v" sid="GEN 46:6" />Gija o Jakov thaj sa leso potomstvo đele ano Egipat. Inđarde pesa pe stoka thaj po barvalipe so steknisade ani phuv i Hanaansko. <verse eid="GEN 46:6" /><verse number="7" style="v" sid="GEN 46:7" />O Jakov inđarda ano Egipat pe čhaven thaj pe unukuren, pe čhejen thaj pe unuken – sa piro potomstvo.<verse eid="GEN 46:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 46:8" />Kala si e alava e Izraelcurenđe čhavenđe – e Jakovese thaj lese potomkurenđe save đele ano Egipat:</para>
  <para style="b" vid="GEN 46:8" />
  <para style="li" vid="GEN 46:8">O Ruvim e Jakoveso angluno bijando čhavo. <verse eid="GEN 46:8" /><verse number="9" style="v" sid="GEN 46:9" />E Ruvimese čhave:</para>
  <para style="li" vid="GEN 46:9">O Hanoh, o Palu, o Esrom thaj o Karmi.<verse eid="GEN 46:9" /></para>
  <para style="li">
    <verse number="10" style="v" sid="GEN 46:10" />E Simeonese čhave:</para>
  <para style="li" vid="GEN 46:10">O Jemuel, o Jamin, o Ohad, o Jahin, o Cohar thaj o Saul savo sasa čhavo jekha Hanaankako.<verse eid="GEN 46:10" /></para>
  <para style="li">
    <verse number="11" style="v" sid="GEN 46:11" />E Levijase čhave:</para>
  <para style="li" vid="GEN 46:11">O Geršon, o Kehat thaj o Merari.<verse eid="GEN 46:11" /></para>
  <para style="li">
    <verse number="12" style="v" sid="GEN 46:12" />E Judase čhave:</para>
  <para style="li" vid="GEN 46:12">O Er, o Onan, o Sala, o Fares thaj o Zara. Al o Er thaj o Onan mule ani phuv i Hanaansko.</para>
  <para style="li" vid="GEN 46:12">E Faresese čhave sesa o Esrom thaj o Hamul.<verse eid="GEN 46:12" /></para>
  <para style="li">
    <verse number="13" style="v" sid="GEN 46:13" />E Isaharese čhave:</para>
  <para style="li" vid="GEN 46:13">O Tola, o Pua, o Jašuv thaj o Šimron.<verse eid="GEN 46:13" /></para>
  <para style="li">
    <verse number="14" style="v" sid="GEN 46:14" />E Zavulonese čhave:</para>
  <para style="li" vid="GEN 46:14">O Sered, o Elon o Jahleel.<verse eid="GEN 46:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="GEN 46:15" />Kala si čhave e Lijaće, saven bijanda e Jakovese ano Padan-Aram. Voj odori bijanda lese thaj e čheja e Dina. Kala lese čhave thaj čheja sesa tranda thaj trin (33) džene.<verse eid="GEN 46:15" /></para>
  <para style="b" />
  <para style="li">
    <verse number="16" style="v" sid="GEN 46:16" />E Gadese čhave:</para>
  <para style="li" vid="GEN 46:16">O Cifjon, o Hagi, o Šuni, o Ecbon, o Eri, o Arodi thaj o Areli.<verse eid="GEN 46:16" /></para>
  <para style="li">
    <verse number="17" style="v" sid="GEN 46:17" />E Asirese čhave:</para>
  <para style="li" vid="GEN 46:17">O Jimna, o Jišva, o Jišvi thaj o Berija. Lenđi phen sasa i Serah.</para>
  <para style="li" vid="GEN 46:17">E Berijase čhave: o Hever thaj o Malkijel.<verse eid="GEN 46:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="GEN 46:18" />Kala si čhave saven bijanda e Jakovese i Zilpa, sava dija o Lavan pe čhejaće e Lijaće. Von sesa dešušov (16) džene.<verse eid="GEN 46:18" /></para>
  <para style="b" />
  <para style="li">
    <verse number="19" style="v" sid="GEN 46:19" />E čhave e Jakovese romnjaće e Rahiljaće:</para>
  <para style="li" vid="GEN 46:19">O Josif thaj o Venijamin.<verse eid="GEN 46:19" /></para>
  <para style="li">
    <verse number="20" style="v" sid="GEN 46:20" />Ano Egipat e Josifese bijandile o Manasija thaj o Efrem tari Osnata, tari čhej e Potiferesi, e sveštenikosi taro foro On.<verse eid="GEN 46:20" /></para>
  <para style="li">
    <verse number="21" style="v" sid="GEN 46:21" />E Venijaminese čhave:</para>
  <para style="li" vid="GEN 46:21">O Bela, o Beher, o Ašbel, o Gera, o Neman, o Ehi, o Roš, o Mupim, o Hupim thaj o Ard.<verse eid="GEN 46:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="GEN 46:22" />Kala si čhave e Rahiljaće save bijandile e Jakovese. Von sesa dešuštar (14) džene.<verse eid="GEN 46:22" /></para>
  <para style="b" />
  <para style="li">
    <verse number="23" style="v" sid="GEN 46:23" />E Daneso čhavo:</para>
  <para style="li" vid="GEN 46:23">O Hušim.<verse eid="GEN 46:23" /></para>
  <para style="li">
    <verse number="24" style="v" sid="GEN 46:24" />E Neftalimese čhave:</para>
  <para style="li" vid="GEN 46:24">O Jahceel, o Guni, o Jecer thaj o Šilem.<verse eid="GEN 46:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="GEN 46:25" />Kala si čhave e Bilhaće, sava dija o Lavan pe čhejaće e Rahiljaće thaj voj bijanda e Jakovese eftanen čhaven.<verse eid="GEN 46:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 46:26" />Sa e manuša so avile e Jakovesa ano Egipat, lese potomkura, sesa šovardeš thaj šov (66), a kate naj đinde e Jakovese bora. <verse eid="GEN 46:26" /><verse number="27" style="v" sid="GEN 46:27" />Te đindam thaj e Josifese duje čhaven save bijandile lese ano Egipat, bi avena eftavardeš (70) džene tare Jakovese potomkura save đele ano Egipat.<verse eid="GEN 46:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28" />O Jakov bičhalda e Juda anglal ko Josif, te phenol e Josifese te araćhol pe lencar ano Gošen. Kana von resle odori, <verse eid="GEN 46:28" /><verse number="29" style="v" sid="GEN 46:29" />o Josif naredisada te spremin lese o vordon, pa đelo ano Gošen te resol pe pe dadesa e Izraelesa. Samo so ačhilo angle po dad, zagrlisada le zurale thaj but vreme ačhilo gija rojindoj.<verse eid="GEN 46:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 46:30" />O Izrael phenda e Josifese: “Akana šaj te merav, kana dikhljem me jakhencar kaj san vadži džuvdo.”<verse eid="GEN 46:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 46:31" />Tegani o Josif vaćarda pe phralenđe thaj sa pe dadese familijaće: “Džav te vaćarav e faraonesa. Ka vaćarav lese: ‘Tari phuv i Hanaansko avile me phrala thaj aver familija me dadesi. <verse eid="GEN 46:31" /><verse number="32" style="v" sid="GEN 46:32" />Gola manuša si pastira. Von araćhen stoka thaj lencar ande pe cikne thaj bare stoka thaj sa so isi len.’ <verse eid="GEN 46:32" /><verse number="33" style="v" sid="GEN 46:33" />Kana ka akharol tumen o faraon thaj pučol: ‘Savi bući ćeren?’, <verse eid="GEN 46:33" /><verse number="34" style="v" sid="GEN 46:34" />tumen phenen: ‘Amen, ćire sluge, arakha stoka tare amaro ternipe, sar so gova ćerde i amare paradada.’ Vaćaren gija te bi mućhola tumen te bešen ano Gošen, golese so si sa e pastira odvratna e Egipćanurenđe.”<verse eid="GEN 46:34" /></para>
  <chapter eid="GEN 46" />
  <chapter number="47" style="c" sid="GEN 47" />
  <para style="s">O Jakov blagoslovil e faraone</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 47:1" />O Josif đelo thaj vaćarda e faraonese: “Mo dad thaj me phrala, pire cikne thaj e bare stokasa thaj sa kolesa so isi len, resle taro Hanaan thaj akana si ano Gošen.”<verse eid="GEN 47:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 47:2" />Tegani lija pandžen tare pire phrala thaj anda len anglo faraon.<verse eid="GEN 47:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 47:3" />O faraon pučlja e Josifese phralen: “Savi bući ćeren?”</para>
  <para style="p" vid="GEN 47:3">Von vaćarde: “Amen, ćire sluge, arakha stoka sar so gova ćerde i amare paradada.” <verse eid="GEN 47:3" /><verse number="4" style="v" sid="GEN 47:4" />Thaj vadži phende e faraonese: “Aviljam te beša nesavo vreme ane kaja phuv sar abandžije, golese kaj si but baro bokhalipe ani phuv i Hanaansko thaj naj so te čaron e stadura ćire slugenđe. Golese, moli tut, mukh amen, ćire slugen, te beša ano Gošen.”<verse eid="GEN 47:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 47:5" />O faraon vaćarda e Josifese: “Avile tuće ćo dad thaj će phrala. <verse eid="GEN 47:5" /><verse number="6" style="v" sid="GEN 47:6" />O Egipat si tuće putardo. Inđar će dade thaj će phralen ano emšukar kotor kale phuvako. Nek živin ano Gošen. A te džangljan kaj isi maškar lende sposobna manuša, čhuv len te aven nadglednikura pe mi stoka.”<verse eid="GEN 47:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 47:7" />Tegani o Josif anda ano dvor pe dade e Jakove thaj inđarda le anglo faraon. O Jakov blagoslovisada e faraone <verse eid="GEN 47:7" /><verse number="8" style="v" sid="GEN 47:8" />thaj o faraon pučlja e Jakove: “Kobor berš isi tut?”<verse eid="GEN 47:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 47:9" />O Jakov phenda lese: “Phirav šelutranda (130) berš ki kaja phuv. Naj man but berša thaj sesa phare. Mingre berša naj ni paše e beršenđe mingre paradadenđe.”<verse eid="GEN 47:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 47:10" />Gija o Jakov blagoslovisada e faraone thaj đelo lestar.<verse eid="GEN 47:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 47:11" />Gija o Josif inđarda pe dade thaj pe phralen ani Ramzesesi phuv, ani emšukar phuv ano Egipat, thaj odori dija len imanje, sar so zapovedisada o faraon. <verse eid="GEN 47:11" /><verse number="12" style="v" sid="GEN 47:12" />O Josif anola xape pe dadese, pe phralenđe thaj sa lese dadese familijaće, premal gova kobor čhavore sesa len.<verse eid="GEN 47:12" /></para>
  <para style="s">O bokhalipe ano Egipat</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13" />Ani sa i phuv ni sasa xape, golese so o bokhalipe sasa but pharo, pa e manuša taro Egipat thaj tari phuv i Hanaansko oslabisade taro baro bokhalipe. <verse eid="GEN 47:13" /><verse number="14" style="v" sid="GEN 47:14" />O Josif ćidija sa e pare savencar e manuša taro Egipat thaj tari phuv i Hanaansko ćinena điv, thaj o Josif anola e pare ane faraoneso dvor.<verse eid="GEN 47:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 47:15" />Kana ni ačhilo vadži pare ano Egipat thaj ani phuv i Hanaansko, sa e Egipćanura avile ko Josif thaj molisade le: “De amen xape. Sose te mera tuće angle jakha? Naj amen vadži pare.”<verse eid="GEN 47:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 47:16" />O Josif vaćarda: “Golese so ačhiljen bize pare, anen tumare stoka. Ka dav tumen xape ani zamena baši tumari stoka.”<verse eid="GEN 47:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 47:17" />Tegani von ande e Josifese pe stoka, a vov dija len xape ani zamena baše lenđe grasta, bakre, buze, guruva thaj hera. Gova berš dija len xape ani zamena paši lenđi stoka.<verse eid="GEN 47:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 47:18" />Kana gova berš nakhlo, aver berš e manuša palem avile ko Josif thaj vaćarde: “Našti garava tutar, gospodarona, kaj naj amen vadži pare thaj i amari stoka si akana ćiri. Naj vadži khanči so ačhilo te da tut, gospodarona, sem te da tut amen korkoren thaj amare njive. <verse eid="GEN 47:18" /><verse number="19" style="v" sid="GEN 47:19" />Sose te mera angle ćire jakha thaj te ačhen pusta amare njive? Ćin amen thaj amare njive ani zamena xamase, thaj amen katane amare njivencar ka ava e faraonese robura. De amen semenura, te ačha džuvde, te ni mera thaj e njive te ni ačhen pusta.”<verse eid="GEN 47:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 47:20" />Gija o Josif ćinda e faraonese sa i phuv ano Egipat. Sa e Egipćanura bićinde pumare njive, golese so o bokhalipe sasa but baro. Gija sa i phuv postanisada e faraonesi, <verse eid="GEN 47:20" /><verse number="21" style="v" sid="GEN 47:21" />thaj gija e manuša taro Egipat, taro jekh krajo dži ko aver, postanisade e faraonese robura. <verse eid="GEN 47:21" /><verse number="22" style="v" sid="GEN 47:22" />Ni ćinda samo e sveštenikurenđe njive, golese so o faraon redovno brinila pe lendar thaj sasa len sa so trubula len džuvdimase. Golese e sveštenikura ni bićinde pumare njive.<verse eid="GEN 47:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 47:23" />O Josif vaćarda e manušenđe: “Avđive ćindem e faraonese tumen thaj tumare njive. Len o seme thaj sejin e njive. <verse eid="GEN 47:23" /><verse number="24" style="v" sid="GEN 47:24" />Al kana ka ćiden o bijanipe so sejisaden, den e faraonese o pandžto kotor, a kola aver štar kotora te ačhol tumenđe sar seme baše njive thaj sar xamase tumenđe, baše tumari familija thaj tumare čhave.”<verse eid="GEN 47:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 47:25" />Von phende: “Tu spasisadan amaro džuvdipe. Arakhljam milost ane ćire jakha gospodarona, golese ka ava robura e faraonese.”<verse eid="GEN 47:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 47:26" />Gija o Josif anda naredba baše egipatske njive, savo važil dži avđive: o pandžto kotor si e faraoneso. Samo e sveštenikurenđe njive ni preperena e faraonese.<verse eid="GEN 47:26" /></para>
  <para style="s">E Jakovesi poslednjo želja</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27" />E čhave e Izraelese bešle ano Egipat, ani phuv o Gošen. Odori barvajle thaj but množisajle.<verse eid="GEN 47:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 47:28" />O Jakov bešlo ano Egipat vadži dešefta (17) berš, gija sasa le šelusaranda thaj efta (147) berš.<verse eid="GEN 47:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 47:29" />Al kana avilo o vreme o Izrael te merol, vov akharda pe čhave e Josife thaj phenda lese: “Te arakhljem milost ane ćire jakha, čhuv ćo va pe me čanga thaj obeći manđe kaj ka sikave manđe baro manglipe thaj vernost: Ma te praho man ano Egipat. <verse eid="GEN 47:29" /><verse number="30" style="v" sid="GEN 47:30" />Kana ka merav, inđar man andaro Egipat thaj praho man odori kaj si prahome i mingre dada.”</para>
  <para style="p" vid="GEN 47:30">O Josif vaćarda lese: “Ka ćerav sar vaćare manđe!”<verse eid="GEN 47:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 47:31" />O Jakov phenda lese: “Xa tut manđe sovli!” Thaj o Josif xalja sovli.</para>
  <para style="p" vid="GEN 47:31">Tegani o Izrael poklonisajlo thaj dija slava e Devlese ke po than e sojimaso.<verse eid="GEN 47:31" /></para>
  <chapter eid="GEN 47" />
  <chapter number="48" style="c" sid="GEN 48" />
  <para style="s">O Jakov blagoslovil e Efreme thaj e Manasija</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1" />Pale nesavo vreme phende e Josifese: “Ćo dad si nasvalo.” Tegani o Josif lija pesa pe duje čhaven, e Manasija thaj e Efreme, thaj đele te dićhen e Jakove.<verse eid="GEN 48:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 48:2" />Kana phende e Jakovese: “Avilo ćo čhavo o Josif tute,” o Izrael ćidija zuralipe thaj bešlo ke po than e sojimaso.<verse eid="GEN 48:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 48:3" />O Jakov phenda e Josifese: “O Emzuralo Dol sikadilo manđe ano Luz, ani phuv i Hanaansko, thaj odori blagoslovisada man. <verse eid="GEN 48:3" /><verse number="4" style="v" sid="GEN 48:4" />Phenda manđe: ‘Tutar ka ćerav baro narodo thaj ka dav tut bute potomkuren. Kaja phuv ka dav ano nasledstvo će potomkurenđe ane sa e đivesa.’ <verse eid="GEN 48:4" /><verse number="5" style="v" sid="GEN 48:5" />Gija akana, ćire duj čhave save bijandile tuće ano Egipat angleder so aviljem tute kate, nek aven mingre. O Efrem thaj o Manasija nek aven mingre sar o Ruvim thaj o Simeon. <verse eid="GEN 48:5" /><verse number="6" style="v" sid="GEN 48:6" />A čhave save ka bijandon tuće pale lende, nek aven ćire. Lengo nasledstvo nek vodil pe talo alav lenđe phralengo, e Efremeso thaj e Manasijaso. <verse eid="GEN 48:6" /><verse number="7" style="v" sid="GEN 48:7" />Kava ćerav baše ći dej i Rahilja. Ki mingri žal, voj muli ani phuv i Hanaansko, ko drom paši Efrata kana irisaljem andaro Padan. Prahosadem la odori pašo drom ani Efrata.” (Gova si avđive o Vitlejem.)<verse eid="GEN 48:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 48:8" />Kana o Izrael dikhlja e Josifese čhaven, pučlja: “Ko si kala?”<verse eid="GEN 48:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 48:9" />O Josif phenda pe dadese: “Kala si me čhave, saven o Dol dija man kate.”</para>
  <para style="p" vid="GEN 48:9">Vov phenda lese: “An len mande, te blagosloviv len.”<verse eid="GEN 48:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 48:10" />O Izrael naštine taro phuripe šukar te dićhol. Kana anda len o Josif paše leste, leso dad čumidija len thaj grlisada len.<verse eid="GEN 48:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 48:11" />Pale gova o Izrael phenda e Josifese: “Dijem gođi kaj nikad ni ka dikhav tut, al akana o Dol dija man te dikhav thaj će čhaven.”<verse eid="GEN 48:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 48:12" />Tegani o Josif crdija len tare koča e Izraelese thaj pelo mujesa dži ki phuv. <verse eid="GEN 48:12" /><verse number="13" style="v" sid="GEN 48:13" />O Josif lija len soldujen, e Efreme pese tari desno rig, premalo Izraeleso levo va, thaj e Manasija pese tari levo rig, premalo Izraeleso desno va, thaj gija anda len popaše lese. <verse eid="GEN 48:13" /><verse number="14" style="v" sid="GEN 48:14" />Al o Izrael čhuta po desno va ko šoro e Efremeso, iako sasa ciknjeder, a po levo va po šoro e Manasijaso. Gija prekrstisada pe vasta iako sasa o Manasija phureder.<verse eid="GEN 48:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 48:15" />Tegani blagoslovisada e Josife vaćarindoj:</para>
  <para style="b" vid="GEN 48:15" />
  <para style="q1" vid="GEN 48:15">“O Dol, kase ano pačajipe služisade</para>
  <para style="q2" vid="GEN 48:15">me dada o Avraam thaj o Isaak,</para>
  <para style="q1" vid="GEN 48:15">o Dol, savo sasa mo pastiri</para>
  <para style="q2" vid="GEN 48:15">tare mo ternipe dži avđivesutno đive,<verse eid="GEN 48:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="GEN 48:16" />o anđelo savo ikalda man tare dži jekh bilačhipe,</para>
  <para style="q2" vid="GEN 48:16">nek blagoslovil kale čhaven.</para>
  <para style="q1" vid="GEN 48:16">Pale lende te dol pe gođi pe mingro alav</para>
  <para style="q2" vid="GEN 48:16">thaj pe alava me dadenđe, e Avraameso thaj Isaakoso,</para>
  <para style="q2" vid="GEN 48:16">thaj te aven len but čhave ki sa i phuv!”<verse eid="GEN 48:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="GEN 48:17" />Kana o Josif dikhlja kaj o Izrael čhuta po desno va po šoro e Efremeso, ni sasa lese sa jekh, pa lija o va pe dadeso thaj manglja te crdol le taro šoro e Efremeso ko šoro e Manasijaso.<verse eid="GEN 48:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 48:18" />O Josif phenda pe dadese: “Na gija, dade, kava si phureder, lese čhuv ćo desno va ko šoro.”<verse eid="GEN 48:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 48:19" />Al leso dad ni manglja, nego phenda: “Džanav, čhaveja mingreja, džanav. Thaj tare potomkura e Manasijase ka avol narodo. O Manasija ka avol baro, al leso ciknjeder phral, o Efrem, ka avol pobaro lestar thaj tare Efremese potomkura ka aven but bare narodura.”<verse eid="GEN 48:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 48:20" />Gija o Izrael blagoslovisada len ane gova đive thaj phenda:</para>
  <para style="b" vid="GEN 48:20" />
  <para style="q1" vid="GEN 48:20">“Tumare alavencar e Izraelcura ka blagoslovin gija:</para>
  <para style="q1" vid="GEN 48:20">O Dol te ćerol tut sar e Efreme thaj e Manasija!”</para>
  <para style="b" vid="GEN 48:20" />
  <para style="p" vid="GEN 48:20">Gija o Jakov čhuta e Efreme anglo Manasija.<verse eid="GEN 48:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 48:21" />Pale gova o Izrael phenda e Josifese: “Akh, me sigate ka merav, al o Dol ka avol tumencar thaj palem ka inđarol tumen ani phuv tumare paradadenđi. <verse eid="GEN 48:21" /><verse number="22" style="v" sid="GEN 48:22" />A tuće dav jekh kotor phuv pobut nego će phralen: o plodno krajo Sihem, savo prelijem tare Amorejcura me mačosa thaj džitkasa.”<verse eid="GEN 48:22" /></para>
  <chapter eid="GEN 48" />
  <chapter number="49" style="c" sid="GEN 49" />
  <para style="s">O Jakov blagoslovil pe čhaven</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1" />Tegani o Jakov akharda sa pe čhaven thaj vaćarda lenđe: “Ćiden tumen trujal mande, te vaćarav tumenđe so ka avol tumencar ano budućnost.<verse eid="GEN 49:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="GEN 49:2" />Ćiden tumen thaj šunen, čhave e Jakovese,</para>
  <para style="q2" vid="GEN 49:2">šunen tumare dade e Izraele!”<verse eid="GEN 49:2" /></para>
  <para style="s2">O Ruvim</para>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 49:3" />“Ruvime, tu san mo emphureder čhavo,</para>
  <para style="q2" vid="GEN 49:3">tu san mingri zor,</para>
  <para style="q1" vid="GEN 49:3">bijandiljan kana sema terno thaj zuralo.</para>
  <para style="q2" vid="GEN 49:3">Tu san emčasno thaj emzuralo maškar me čhave.<verse eid="GEN 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="GEN 49:4" />Al nestabilno san sar o paj savo našti ačhavol pe</para>
  <para style="q2" vid="GEN 49:4">thaj ni ka ave vadži emčasno,</para>
  <para style="q1" vid="GEN 49:4">golese so sutan će dadese romnjasa,</para>
  <para style="q2" vid="GEN 49:4">thaj meljardan mo than e sojimaso.”<verse eid="GEN 49:4" /></para>
  <para style="s2">O Simeon thaj o Levi</para>
  <para style="q1">
    <verse number="5" style="v" sid="GEN 49:5" />“Simeone thaj Levi, tumen sen phrala;</para>
  <para style="q2" vid="GEN 49:5">tumare mačura si oružje taro nasilje.<verse eid="GEN 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 49:6" />Ke tumare sastankura me ni ka avav,</para>
  <para style="q2" vid="GEN 49:6">ke tumaro ćidinipe me ni ka džav,</para>
  <para style="q1" vid="GEN 49:6">golese so ani tumari holi mudarden e manušen</para>
  <para style="q2" vid="GEN 49:6">thaj ane tumaro dilipe sakatisaden e guruven.<verse eid="GEN 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="GEN 49:7" />Harami te avol tumari holi, gaći bari,</para>
  <para style="q2" vid="GEN 49:7">thaj tumaro dilipe, gaći divljo.</para>
  <para style="q1" vid="GEN 49:7">Ka ulavav tumare potomkuren pe Jakovesi phuv,</para>
  <para style="q2" vid="GEN 49:7">ka aven rasejime maškare manuša e Izraelese.”<verse eid="GEN 49:7" /></para>
  <para style="s2">O Juda</para>
  <para style="q1">
    <verse number="8" style="v" sid="GEN 49:8" />“Judo, tut ka hvalin ćire phrala,</para>
  <para style="q2" vid="GEN 49:8">će vastesa ka ićare će dušmanurenđi kor.</para>
  <para style="q1" vid="GEN 49:8">E čhave će dadese ka poklonin pe angle tute.<verse eid="GEN 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="GEN 49:9" />Judo, mingro čhavo, tu san sar terno lavo,</para>
  <para style="q2" vid="GEN 49:9">savo iril pe taro pleno piro.</para>
  <para style="q1" vid="GEN 49:9">Sar lavo thaj lavica odmoril thaj pašljol.</para>
  <para style="q2" vid="GEN 49:9">Ko tromal te holjarol le?<verse eid="GEN 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="GEN 49:10" />Taro Juda ni ka crdol pe o žezlo,</para>
  <para style="q2" vid="GEN 49:10">ni i vladarsko rovli tare lese pingre,</para>
  <para style="q1" vid="GEN 49:10">dži kaj ni avol kova kase goja rovli ka preperol,</para>
  <para style="q2" vid="GEN 49:10">kase ka pokorin pe e narodura.<verse eid="GEN 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="GEN 49:11" />Vov ka phandol e here ko čokot,</para>
  <para style="q2" vid="GEN 49:11">e terne here ki emšukar loza.</para>
  <para style="q1" vid="GEN 49:11">Pe šeja ka thovol ani mol,</para>
  <para style="q2" vid="GEN 49:11">po fostano ka thovol ano rat tari mol.<verse eid="GEN 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 49:12" />Gaći mol ka pijol,</para>
  <para style="q2" vid="GEN 49:12">kaj lese jakha ka ljoljon,</para>
  <para style="q1" vid="GEN 49:12">gaći thud ka pijol</para>
  <para style="q2" vid="GEN 49:12">kaj lese danda ka parnjon.”<verse eid="GEN 49:12" /></para>
  <para style="s2">O Zavulon</para>
  <para style="q1">
    <verse number="13" style="v" sid="GEN 49:13" />“Zavulone, tu ka beše ki obala e moresi,</para>
  <para style="q2" vid="GEN 49:13">ka ave utočište e čamcurenđe,</para>
  <para style="q1" vid="GEN 49:13">i phuv ćiri ka avol dži o Sidon.”<verse eid="GEN 49:13" /></para>
  <para style="s2">O Isahar</para>
  <para style="q1">
    <verse number="14" style="v" sid="GEN 49:14" />“Isahare, tu san sar zuralo terno her</para>
  <para style="q2" vid="GEN 49:14">savo pašljol maškar leso teret.<verse eid="GEN 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 49:15" />Kana ka dićhe kaj si o than bašo odmor šukar,</para>
  <para style="q2" vid="GEN 49:15">kaj si i phuv lačhi,</para>
  <para style="q1" vid="GEN 49:15">ćo dumo ka čhuve talo pharipe</para>
  <para style="q2" vid="GEN 49:15">thaj ka ave čhuto zorasa te ćere bući sar robo.”<verse eid="GEN 49:15" /></para>
  <para style="s2">O Dan</para>
  <para style="q1">
    <verse number="16" style="v" sid="GEN 49:16" />“Dane, tu ka ane pravda ćire narodose</para>
  <para style="q2" vid="GEN 49:16">sar jekh tare plemenura e Izraelese.<verse eid="GEN 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="GEN 49:17" />Ka ave opasno sar sap pašo drom,</para>
  <para style="q2" vid="GEN 49:17">sar poskok paši staza.</para>
  <para style="q1" vid="GEN 49:17">Ka dandare e graste za ki patum,</para>
  <para style="q2" vid="GEN 49:17">thaj o manuš po gra ka perol ko dumo.”<verse eid="GEN 49:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="GEN 49:18" />“GOSPODE mingreja, ađućarav ćo spasenje!”<verse eid="GEN 49:18" /></para>
  <para style="s2">O Gad</para>
  <para style="q1">
    <verse number="19" style="v" sid="GEN 49:19" />“Gade, tut ka napadin e razbojnikura,</para>
  <para style="q2" vid="GEN 49:19">al von ka našen angle tute.”<verse eid="GEN 49:19" /></para>
  <para style="s2">O Asir</para>
  <para style="q1">
    <verse number="20" style="v" sid="GEN 49:20" />“Asire, ćiri phuv ka bijanol but xamase,</para>
  <para style="q2" vid="GEN 49:20">savo ka avol šukar xape e carurenđe.”<verse eid="GEN 49:20" /></para>
  <para style="s2">O Neftalim</para>
  <para style="q1">
    <verse number="21" style="v" sid="GEN 49:21" />“Neftalime, tu san sar košuta, mukhli ki sloboda,</para>
  <para style="q2" vid="GEN 49:21">savi anol lačhe terne jelenuren ko sveto.”<verse eid="GEN 49:21" /></para>
  <para style="s2">O Josif</para>
  <para style="q1">
    <verse number="22" style="v" sid="GEN 49:22" />“Josife, tu san plodno čokot,</para>
  <para style="q2" vid="GEN 49:22">plodno čokot pašo izvori,</para>
  <para style="q2" vid="GEN 49:22">ćire loze barile prekalo duvari.<verse eid="GEN 49:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="GEN 49:23" />Zurale napadisade tut e dušmanura,</para>
  <para style="q2" vid="GEN 49:23">pe tute čhudije e holjame strele pire,<verse eid="GEN 49:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 49:24" />al ćiri džitka ačhili spremno</para>
  <para style="q2" vid="GEN 49:24">thaj ćire vasta zurajle,</para>
  <para style="q1" vid="GEN 49:24">bašo Silno Dol e Jakoveso,</para>
  <para style="q2" vid="GEN 49:24">bašo Pastiri, i Stena e Izraelesi,<verse eid="GEN 49:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="GEN 49:25" />Nek pomožil tuće o Dol ćire dadeso,</para>
  <para style="q2" vid="GEN 49:25">nek blagoslovil tut o Emzuralo Dol</para>
  <para style="q1" vid="GEN 49:25">bršndesa odupral taro nebo,</para>
  <para style="q2" vid="GEN 49:25">pajesa andari phuv,</para>
  <para style="q2" vid="GEN 49:25">stokasa thaj čhavencar.<verse eid="GEN 49:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="GEN 49:26" />E blagoslovura će dadese si pobare</para>
  <para style="q1" vid="GEN 49:26">tare blagoslovura e purane planinenđe,</para>
  <para style="q2" vid="GEN 49:26">taro obilje but purane bregurenđe.</para>
  <para style="q1" vid="GEN 49:26">Nek uljen po šoro e Josifeso,</para>
  <para style="q2" vid="GEN 49:26">ko čikat koleso savo si princo maškar pe phrala.”<verse eid="GEN 49:26" /></para>
  <para style="s2">O Venijamin</para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 49:27" />“Venijamine, tu san grabljivo ruv,</para>
  <para style="q2" vid="GEN 49:27">ki sabalin xa o pleno ćiro,</para>
  <para style="q1" vid="GEN 49:27">a ki rat ulave kova so ačhol.”<verse eid="GEN 49:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="GEN 49:28" />Sa kala si dešuduj (12) plemenura e Izraelese thaj kava vaćarda lenđe lengo dad kana blagoslovisada len. Dži jekhe dija posebno blagoslov.<verse eid="GEN 49:28" /></para>
  <para style="s">E Jakoveso meripe thaj prahope</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29" />Tegani o Jakov zapovedisada lenđe gija: “Sigate ka merav. Prahon man me dadencar ani pećina savi si ko polje e Efroneso e Hetiteso, <verse eid="GEN 49:29" /><verse number="30" style="v" sid="GEN 49:30" />ani pećina ko polje i Mahpela, pašo Mamre ani phuv i Hanaansko. Gova polje ćinda o Avraam taro Efron o Hetito, te avol lese gova than bašo prahope. <verse eid="GEN 49:30" /><verse number="31" style="v" sid="GEN 49:31" />Odori si prahome o Avraam thaj lesi romni i Sara, o Isaak thaj lesi romni i Reveka, a odori me prahosadem e Lija. <verse eid="GEN 49:31" /><verse number="32" style="v" sid="GEN 49:32" />O polje thaj i pećina sesa ćinde tare Hetitura.”<verse eid="GEN 49:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 49:33" />Kana o Jakov zapovedisada gova pe čhavenđe, pašlilo ke po than e sojimaso, mukhlja pi duša thaj mulo.<verse eid="GEN 49:33" /></para>
  <chapter eid="GEN 49" />
  <chapter number="50" style="c" sid="GEN 50" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1" />Pale gova o Josif pelo mujesa pe po dad, ruja pe leste thaj čumidija le. <verse eid="GEN 50:1" /><verse number="2" style="v" sid="GEN 50:2" />Tegani o Josif phenda e doktorenđe, pe slugenđe, te maćhen mirisurencar lese dade e Izraele, thaj von ćerde gija. <verse eid="GEN 50:2" /><verse number="3" style="v" sid="GEN 50:3" />Gova ćerde saranda (40) đive, golese kaj si gaći o maćhipe e mirisurencar. E Egipćanura ruje pale leste eftavardeš (70) đive.<verse eid="GEN 50:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 50:4" />Kana nakhle e đivesa tari žal, o Josif phenda e faraonese službenikurenđe: “Te arakhljem milost ane tumare jakha, vaćaren e faraonesa ane mingro alav: <verse eid="GEN 50:4" /><verse number="5" style="v" sid="GEN 50:5" />‘Mo dad rodija te xav sovli vaćarindoj: “Akh, me sigate ka merav, praho man ane mo limori, savo pripremisadem manđe ani phuv i Hanaansko.” Mukh man te džav te prahov me dade. Pale gova ka avav palem.’ ”<verse eid="GEN 50:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 50:6" />O faraon phenda lese: “Dža, praho će dade sar so xaljan lese sovli.”<verse eid="GEN 50:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 50:7" />Gija o Josif đelo thaj prahosada pe dade. Lesa đele sa e faraonese službenikura, e ugledna manuša tare leso dvor thaj sa e ugledna manuša taro Egipat. <verse eid="GEN 50:7" /><verse number="8" style="v" sid="GEN 50:8" />Đele i sa e Josifese ćherutne, lese phrala thaj sa e ćherutne lese dadese. Ani phuv o Gošen ačhile samo e čhavore thaj lenđi bari thaj cikni stoka. <verse eid="GEN 50:8" /><verse number="9" style="v" sid="GEN 50:9" />Lencar pojdisade manuša pe vordona thaj manuša pe grasta. E Josifesa sesa čače but manuša.<verse eid="GEN 50:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 50:10" />Kana avile ko gumno e Atadeso, savo si tari istočno rig e Jordanesi, lije gothe but žalno te roven. O Josif ićarda gothe žal pale po dad efta đive.<verse eid="GEN 50:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 50:11" />Kana dikhlje e Hanaancura, save bešen ane goja phuv, o žalipe ko gumno e Atadeso, phende: “Ani bari žal si e Egipćanura!” Golese akharde gova than pašo Jordan Avel-Micrajim<note caller="+" style="f"><char style="fr" closed="false">50,11 </char><char style="fq" closed="false">Avel-Micrajim </char><char style="ft" closed="false">E Egipćanurengo žal.</char></note>.<verse eid="GEN 50:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 50:12" />Pale gova e Jakovese čhave ćerde sar so lengo dad manglja. <verse eid="GEN 50:12" /><verse number="13" style="v" sid="GEN 50:13" />Inđarde le lese čhave ani pećina ko polje i Mahpela, pašo Mamre ani phuv i Hanaansko, polje savo ćinda o Avraam taro Efron o Hetito, te avol lese gova than bašo prahope. <verse eid="GEN 50:13" /><verse number="14" style="v" sid="GEN 50:14" />Kana prahosada pe dade, irisajlo o Josif ano Egipat sa lese phralencar thaj savorencar save iklile lesa te prahon lese dade.<verse eid="GEN 50:14" /></para>
  <para style="s">O Josif utešil pe phralen</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15" />Sar mulo lengo dad, e Josifese phrala phende: “So ako o Josif avol holjamo pe amende thaj iril amenđe baše sa o bilačhipe savo ćerdam lese?”<verse eid="GEN 50:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 50:16" />Golese bičhalde haberi e Josifese: “Ćo dad phenda angle po meripe: <verse eid="GEN 50:16" /><verse number="17" style="v" sid="GEN 50:17" />‘Gija phenen e Josifese: Moliv tut, oprosti će phralenđe lengo bilačhipe thaj lengo greh so gija bilačhe ćerde tuće.’ Golese, moli tut, oprosti gova bilačhipe e slugenđe će dadese Devlese.”</para>
  <para style="p" vid="GEN 50:17">Kana o Josif šunda kala lafura, lija te rovol.<verse eid="GEN 50:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 50:18" />Tegani avile leste lese phrala, pele pe koča angle leste thaj phende: “Akh, amen sam će robura.”<verse eid="GEN 50:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 50:19" />Al o Josif phenda lenđe: “Ma daran, dal sem me ke Devleso than? <verse eid="GEN 50:19" /><verse number="20" style="v" sid="GEN 50:20" />Tumen mangljen te ćeren manđe bilačhipe, al o Dol irisada gova ko šukaripe, te spasil bute manušen, sar so dićhen avđive. <verse eid="GEN 50:20" /><verse number="21" style="v" sid="GEN 50:21" />Gija ma daran! Me ka briniv man tumendar thaj tare tumare čhave.”</para>
  <para style="p" vid="GEN 50:21">Gija utešisada len šukare lafurencar.<verse eid="GEN 50:21" /></para>
  <para style="s">E Josifeso meripe</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22" />O Josif ačhilo te bešol ano Egipat pe dadese familijasa thaj sasa džuvdo šeludeš (110) berš. <verse eid="GEN 50:22" /><verse number="23" style="v" sid="GEN 50:23" />Dikhlja i trito kuštik tare Efremese čhave. Thaj e čhaven e Mahirese, e čhavese e Manasijase, o Josif prihvatisada sar pire čhaven.<verse eid="GEN 50:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 50:24" />Tegani phenda o Josif pe phralenđe: “Me sigate ka merav, al o Dol ka avol te pomožil tumenđe thaj ka inđarol tumen tari kaja phuv ani phuv baše savi xalja sovli e Avraamese, e Isaakose thaj e Jakovese.”<verse eid="GEN 50:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 50:25" />O Josif xalja sovli e Izraelcuren: “Kana ka avol o Dol te pomožil tumenđe, inđaren me kokala katar!”<verse eid="GEN 50:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 50:26" />O Josif mulo kana sasa le šeludeš berš. Makhle le mirisurencar thaj čhute le ano sanduko ano Egipat.<verse eid="GEN 50:26" /></para>
  <chapter eid="GEN 50" />
</usx>