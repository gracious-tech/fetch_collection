<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id" />
  <para style="h">العِبْرَانِيِّينْ</para>
  <para style="toc1">الرِّسَالَة لِلعِبْرَانِيِّينْ</para>
  <para style="toc2">العِبْرَانِيِّينْ</para>
  <para style="toc3">العِبْرَانِيِّينْ</para>
  <para style="mt">الرِّسَالَة لِلعِبْرَانِيِّينْ</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s">اللَّهْ كَلَّمْنَا عْلَى طْرِيقْ إِبْنُو</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />مِنْ قْدِيمْ الزْمَانْ وفِي بَرْشَة مَرَّاتْ، كَانْ اللَّهْ يْكَلِّمْ فِي جْدُودْنَا عْلَى لْسَانْ الأَنْبِيَاءْ، وكُلْ مَرَّة بْطَرِيقَة. <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />آمَا تَوَّا، فِي آخِرْ الزْمَانْ، كَلَّمْنَا عْلَى طْرِيقْ إِبْنُو، الِّي خَلَّاهْ وَارِثْ لْكُلْ شَيْ، وبِيهْ خْلَقْ الدِّنْيَا الكُلْ. <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />هُوَّ نُورْ مَجْدْ اللَّهْ والتَّعْبِيرْ الكَامِلْ عْلَى شَخْصُو. وهُوَّ الِّي يَحْفِظْ الدِّنْيَا الكُلْ بْكِلْمْتُو القْوِيَّة. ولِّي، بَعْدْمَا طَهَّرْنَا مِنْ ذْنُوبْنَا، قْعَدْ عْلَى يْمِينْ اللَّهْ العْظِيمْ فِي السْمَاء.<verse eid="HEB 1:3" /></para>
  <para style="s">الإِبْنْ مْقَامُو أَعْظِمْ مِالمْلَايْكَة</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4" />وهَكَّا وَلَّى مْقَامُو أَعْظِمْ مِنْ مْقَامْ المْلَايْكَة، ووْرِثْ إِسْمْ أَعْظِمْ مِنْ أَسَامِيهُمْ الكُلْ.<verse eid="HEB 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 1:5" />عْلَى خَاطِرْ، اللَّهْ مَا قَالْ لْحَتَّى وَاحِدْ مِالمْلَايْكَة:</para>
  <para style="b" vid="HEB 1:5" />
  <para style="q1" vid="HEB 1:5">«إِنْتِ إِبْنِي،</para>
  <para style="q2" vid="HEB 1:5">وآنَا اليُومْ جِبْتِكْ»</para>
  <para style="b" vid="HEB 1:5" />
  <para style="m" vid="HEB 1:5">ولَا قَالْ:</para>
  <para style="b" vid="HEB 1:5" />
  <para style="q1" vid="HEB 1:5">«آنَا نْكُونْلُو بُو،</para>
  <para style="q2" vid="HEB 1:5">وهُوَّ يْكُونْلِي إِبْنْ».<verse eid="HEB 1:5" /></para>
  <para style="b" />
  <para style="m">
    <verse number="6" style="v" sid="HEB 1:6" />آمَا وَقْتِلِّي بْعَثْ إِبْنُو البِكْرْ لِلدِّنْيَا هَاذِي قَالْ:</para>
  <para style="b" vid="HEB 1:6" />
  <para style="q1" vid="HEB 1:6">«لَازِمْ مْلَايِكْةْ اللَّهْ الكُلْ يِسْجْدُولُو».<verse eid="HEB 1:6" /></para>
  <para style="b" />
  <para style="m">
    <verse number="7" style="v" sid="HEB 1:7" />وقَالْ عَالمْلَايْكَة:</para>
  <para style="b" vid="HEB 1:7" />
  <para style="q1" vid="HEB 1:7">«يْرُدْ مْلَايِكْتُو أَرْيَاحْ،</para>
  <para style="q2" vid="HEB 1:7">وخُدَّامُو لْهِيبْ نَارْ».<verse eid="HEB 1:7" /></para>
  <para style="b" />
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />آمَا عَالإِبْنْ يْقُولْ:</para>
  <para style="b" vid="HEB 1:8" />
  <para style="q1" vid="HEB 1:8">«عَرْشِكْ يَا اللَّهْ يَبْقَى ثَابِتْ لِلْأَبَدْ،</para>
  <para style="q2" vid="HEB 1:8">والعَدْلْ يْكُونْ سَاسْ مُلْكِكْ.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />تْحِبْ الحَقْ وتَكْرَهْ الشَّرْ،</para>
  <para style="q2" vid="HEB 1:9">هَاذَاكَا عْلَاشْ اللَّهْ إِلَاهِكْ، دِهْنِكْ بِزِيتْ الفَرْحَة،</para>
  <para style="q1" vid="HEB 1:9">أَكْثِرْ مِنْ اصْحَابِكْ».<verse eid="HEB 1:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10" />وقَالْ زَادَا:</para>
  <para style="b" vid="HEB 1:10" />
  <para style="q1" vid="HEB 1:10">«إِنْتِ يَا رَبْ،</para>
  <para style="q2" vid="HEB 1:10">مِنْ أَوِّلْ الدِّنْيَا، حَطِّيتْ سَاسْ الأَرْضْ،</para>
  <para style="q1" vid="HEB 1:10">وعْمَلْتْ السْمَاوَاتْ بِيدِيكْ.<verse eid="HEB 1:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="HEB 1:11" />هُومَا بِشْ يِفْنَاوْ،</para>
  <para style="q1" vid="HEB 1:11">آمَا إِنْتِ تَبْقَى،</para>
  <para style="q2" vid="HEB 1:11">يِتْهَرَّاوْ كِيفْ مَا تِتْهَرَّى الحْوَايِجْ،<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />بِشْ تِطْوِيهُمْ كِي اللْحَافْ،</para>
  <para style="q2" vid="HEB 1:12">وبِشْ تْبَدَّلْهُمْ كِي اللِّبْسَة،</para>
  <para style="q1" vid="HEB 1:12">آمَا إِنْتِ مَا تِتْبَدِّلْشْ،</para>
  <para style="q2" vid="HEB 1:12">وسْنِينْ عُمْرِكْ مَا تُوفَاشْ».<verse eid="HEB 1:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="HEB 1:13" />وعُمْرُوشْ اللَّهْ قَالْ لْوَاحِدْ مِالمْلَايْكَة:</para>
  <para style="b" vid="HEB 1:13" />
  <para style="q1" vid="HEB 1:13">«أُقْعُدْ عْلَى يْمِينِي،</para>
  <para style="q2" vid="HEB 1:13">حَتَّى لِينْ نْحُطْ أَعْدَائِكْ تَحْتْ سَاقِيكْ»؟<verse eid="HEB 1:13" /></para>
  <para style="b" />
  <para style="m">
    <verse number="14" style="v" sid="HEB 1:14" />لَا، المْلَايْكَة مَا هِي إِلَّا أَرْوَاحْ تِخْدِمْ فِي اللَّهْ ويَبْعَثْهُمْ بَاشْ يِخْدْمُوا النَّاسْ الِّي بِشْ يُورْثُوا النْجَاةْ.<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s">شِدُّوا صْحِيحْ فِي التَّعْلِيمْ الِّي خْذِيتُوهْ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />هَاذَاكَا عْلَاشْ يِلْزِمْنَا نْشِدُّوا صْحِيحْ فِي التَّعْلِيمْ الِّي سْمَعْنَاهْ بَاشْ مَا نْضِيعُوشْ. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />وأَحْنَا نَعْرْفُوا الِّي الرِّسَالَة الِّي تْقَالِتْ عْلَى لْسَانْ المْلَايْكَة ثِبْتِتْ صِحِّتْهَا، وكُلْ مِنْ خَالِفْهَا وعْصَاهَا خْذَا العِقَابْ العَادِلْ الِّي يِسْتْحَقُّو. <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />مَالَا كِيفَاشْ أَحْنَا بِشْ نِمْنْعُوا مِالعِقَابْ إِذَا مَا نَعْطِيوِشْ قِيمَة لِلنْجَاةْ العْظِيمَة هَاذِي الِّي الرَّبْ كَانْ أَوِّلْ مِنْ خَبَّرْ بِيهَا، وزَادُوا أَكْدُوهَالْنَا النَّاسْ الِّي سَمْعُوهْ؟ <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />واللَّهْ أَكِّدْ شْهَادِتْهُمْ بَعْجَايِبْ وعَلَامَاتْ وبَرْشَة مُعْجْزَاتْ، وبْهِيبَاتْ الرُّوحْ القُدُسْ الِّي يْفَرَّقْهَا كِيفْ مَا يْحِبْ.<verse eid="HEB 2:4" /></para>
  <para style="s">يَسُوعْ وَلَّى بَشَرْ بَاشْ يْنَجِّينَا</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />والآخْرَة الِّي نَحْكِيوْ عْلِيهَا مَا حَطْهَاشْ اللَّهْ تَحْتْ سُلْطِةْ المْلَايْكَة، <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />بِالعَكْسْ، فَمَّة شْكُونْ شْهِدْ فِي الكْتُبْ المُقَدْسَة وقَالْ:</para>
  <para style="b" vid="HEB 2:6" />
  <para style="q1" vid="HEB 2:6">«شْنُوَّة هُوَّ الإِنْسَانْ حَتَّى تْفَكِّرْ فِيهْ؟</para>
  <para style="q2" vid="HEB 2:6">وَلَّا البَشَرْ بَاشْ تِتِلْهَى بِيهْ؟<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />خَلِّيتُو أَقَلْ مِالمْلَايْكَة لْمُدَّة قْصِيرَة،</para>
  <para style="q2" vid="HEB 2:7">آمَا مْبَعِّدْ عْطِيتُو مَجْدْ وكَرَامَة.<verse eid="HEB 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 2:8" />وحَطِّيتْ كُلْ شَيْ تَحْتْ سَاقِيهْ».</para>
  <para style="b" vid="HEB 2:8" />
  <para style="m" vid="HEB 2:8">ومَادَامْ اللَّهْ حَطْ كُلْ شَيْ تَحْتْ سُلْطْتُو، مَعْنَاهَا مَا خَلَّى حَتَّى شَيْ مُشْ خَاضِعْلُو. آمَا تَوَّا مَزِّلْنَا مَا نْشُوفُوشْ فِي كُلْ شَيْ خَاضِعْلُو. <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />ويَسُوعْ الِّي خَلَّاهْ اللَّهْ أَقَلْ مِالمْلَايْكَة مُدَّة قْصِيرَة، نْشُوفُوهْ تَوَّا وفُوقْ رَاسُو تَاجْ المَجْدْ والكَرَامَة، عْلَى خَاطْرُو تْحَمِّلْ وْجَايَعْ المُوتْ. واللَّهْ بْنِعْمْتُو خَلَّاهْ يْذُوقْ المُوتْ فِي بْلَاصِةْ النَّاسْ الكُلْ.<verse eid="HEB 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 2:10" />اللَّهْ الِّي خْلَقْ كُلْ شَيْ بْقُوْتُو ولْمَجْدُو، كِي حَبْ يْجِيبْ بَرْشَة مِنْ وْلَادُو لِلْمَجْدْ، إِخْتَارْ إِنُّو الِّي بِشْ يْقُودْهُمْ لِلنْجَاةْ يْوَلِّي مُؤَهَّلْ بِالكَامِلْ عْلَى طْرِيقْ الوْجَايَعْ. <verse eid="HEB 2:10" /><verse number="11" style="v" sid="HEB 2:11" />عْلَى خَاطِرْ المَسِيحْ الِّي يْقَدِّسْ والمُؤْمْنِينْ الِّي تْقَدْسُوا عَنْدْهُمْ نَفْسْ البُو، هَاذَاكَا عْلَاشْ مَا يِحْشِمْشْ بَاشْ يْسَمِّي المُؤْمْنِينْ بِيهْ خْوَاتُو، <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />ويْقُولْ:</para>
  <para style="b" vid="HEB 2:12" />
  <para style="q1" vid="HEB 2:12">«بِشْ نْبَشِّرْ خْوَاتِي بْإِسْمِكْ،</para>
  <para style="q2" vid="HEB 2:12">ونْسَبْحِكْ فِي وِسْطْ الِّي يِعْبْدُوا».<verse eid="HEB 2:12" /></para>
  <para style="b" />
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />ويْقُولْ زَادَا:</para>
  <para style="b" vid="HEB 2:13" />
  <para style="q1" vid="HEB 2:13">«آنَا نِتْوَكِّلْ عْلَى اللَّهْ».</para>
  <para style="b" vid="HEB 2:13" />
  <para style="m" vid="HEB 2:13">وزَادَا:</para>
  <para style="b" vid="HEB 2:13" />
  <para style="q1" vid="HEB 2:13">«هَانِي مْعَ الأَوْلَادْ الِّي وهِبْهُمْلِي اللَّهْ».<verse eid="HEB 2:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />ومَادَامْ الأَوْلَادْ هَاذُومَا هُومَا بَشَرْ مِنْ لْحَمْ ودَمْ، يَسُوعْ زَادَا وَلَّى بَشَرْ مِنْ لْحَمْ ودَمْ كِيفْهُمْ، بَاشْ يَقْضِي بْمُوتُو عَلِّي عَنْدُو سُلْطِةْ المُوتْ، الِّي هُوَّ إِبْلِيسْ، <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />ويْحَرَّرْ النَّاسْ الِّي خُوفْهُمْ مِالمُوتْ إِسْتَعْبِدْهُمْ طُولْ حْيَاتْهُمْ. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />مَالَا وَاضِحْ إِنُّو مَا جَاشْ بَاشْ يْعَاوِنْ المْلَايْكَة، آمَا جَاء بَاشْ يْعَاوِنْ ذُرِّيِّةْ إِبْرَاهِيمْ. <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />وهَاذَاكَا عْلَاشْ كَانْ لَازْمُو يْشَبَّهْ لِخْوَاتُو فِي كُلْ شَيْ، بَاشْ يْكُونْ الكَاهِنْ الكْبِيرْ الرَّحِيمْ والأَمِينْ فِي خِدْمِةْ اللَّهْ ويْكَفِّرْ عْلَى ذْنُوبْ الشَّعْبْ. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />وعْلَى خَاطِرْ هُوَّ بِيدُو تْعَذَّبْ وتْعَدَّى بْتَجْرْبَة، هُوَّ قَادِرْ يْعَاوِنْ الِّي هُومَا فِي تَجْرْبَة.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s">يَسُوعْ أَعْظِمْ مِنْ مُوسَى</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />مَالَا، يَا خْوَاتِي القِدِّيسِينْ الِّي دْعَاهُمْ اللَّهْ، خَمْمُّوا فِي يَسُوعْ، الكَاهِنْ الكْبِيرْ ورَسُولْ الإِيمَانْ الِّي نِعْتَرْفُوا بِيهْ، <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />الِّي كَانْ أَمِينْ لِلَّهْ الِّي اخْتَارُو، كِيمَا كَانْ مُوسَى أَمِينْ فِي خِدْمِةْ بِيتْ اللَّهْ الكُلْ. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />آمَا يَسُوعْ يِسْتْحَقْ مَجْدْ أَكْثِرْ مِنْ مُوسَى، كِيمَا البَنَّايْ الِّي بْنَى دَارْ يَاخِذْ مَجْدْ أَكْثِرْ مِالدَّارْ بِيدْهَا. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />وبِالطْبِيعَة كُلْ دَارْ عَنْدْهَا حَدْ يِبْنِيهَا، آمَا الِّي يِبْنِي كُلْ شَيْ هُوَّ اللَّهْ. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />ومُوسَى كَانْ أَمِينْ فِي خِدْمِةْ بِيتْ اللَّهْ الكُلْ بْصِيفْتُو خَادِمْ، يِشْهِدْ عَلِّي بِشْ يْقُولُو اللَّهْ فِي المُسْتَقْبِلْ. <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />آمَا المَسِيحْ، هُوَّ أَمِينْ بْصِيفْتُو إِبْنْ مَسْؤُولْ عْلَى بِيتْ اللَّهْ. والبِيتْ هَاذَا هُوَّ أَحْنَا، هَاذَا إِذَا كَانْ شَدِّينَا صْحِيحْ فِي الثِّيقَة الِّي عَنْدْنَا والرْجَى الِّي نِتْفَخْرُوا بِيهْ.<verse eid="HEB 3:6" /></para>
  <para style="s">كَانْ سْمَعْتُوا صُوتُو مَا تْكَسْحُوشْ قْلُوبْكُمْ</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />هَاذَاكَا عْلَاشْ، كِيمَا يْقُولْ الرُّوحْ القُدُسْ:</para>
  <para style="b" vid="HEB 3:7" />
  <para style="q1" vid="HEB 3:7">«اليُومْ، إِذَا سْمَعْتُوا صُوتْ اللَّهْ،<verse eid="HEB 3:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8" />مَا تْكَسْحُوشْ قْلُوبْكُمْ كِيمَا عَمْلُوا جْدُودْكُمْ،</para>
  <para style="q1" vid="HEB 3:8">نْهَارِةْ الِّي عْصَاوْنِي،</para>
  <para style="q2" vid="HEB 3:8">نْهَارِةْ الِّي جَرْبُونِي فِي الصَّحْرَاء.<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />النْهَارْ هَاذَاكَا جَرْبُونِي جْدُودْكُمْ،</para>
  <para style="q2" vid="HEB 3:9">رَغْمِلِّي شَافُوا أَعْمَالِي لْمُدِّةْ 40 سْنَة.<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />هَاذَاكَا عْلَاشْ غْضُبْتْ عَالجِّيلْ هَاذَاكَا وقُلْتْ:</para>
  <para style="q2" vid="HEB 3:10">قْلُوبْهُمْ دِيمَا ضَايْعَة،</para>
  <para style="q1" vid="HEB 3:10">ومَا عَرْفُوشْ يْتَبْعُوا طْرِيقِي،<verse eid="HEB 3:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="HEB 3:11" />وكِي غْضُبْتْ حْلِفْتْ،</para>
  <para style="q1" vid="HEB 3:11">إِنْهُمْ مَا يُدْخْلُوشْ لْرَاحْتِي».<verse eid="HEB 3:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />مَالَا يَا خْوَاتِي، رُدُّوا بَالْكُمْ لَا يْكُونْ فِيكُمْ وَاحِدْ قَلْبُو شِرِّيرْ ومَافِيهِشْ إِيمَانْ، يْخَلِّيهْ يِبْعِدْ عْلَى اللَّهْ الحَيْ، <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />آمَا مَادَامْ «اليُومْ» الِّي تْقُولْ عْلِيهْ الكْتُبْ المُقَدْسَة مَزَّالْ مَوْجُودْ، شَجْعُوا بْعَضْكُمْ كُلْ يُومْ، بَاشْ حَتَّى وَاحِدْ فِيكُمْ مَا تْغُرُّو الخَطِيئَة وتْكَسَّحْلُو قَلْبُو. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />رَانَا الكُلْنَا مِتْشَارْكِينْ مْعَ المَسِيحْ، إِذَا نْشِدُّوا صْحِيحْ لِلِّخِّرْ فِي الثِّيقَة الِّي عَنْدْنَا مِالأُوِّلْ. <verse eid="HEB 3:14" /><verse number="15" style="v" sid="HEB 3:15" />كِيمَا تْقُولْ الكْتُبْ المُقَدْسَة:</para>
  <para style="b" vid="HEB 3:15" />
  <para style="q1" vid="HEB 3:15">«اليُومْ، إِذَا سْمَعْتُوا صُوتْ اللَّهْ،</para>
  <para style="q2" vid="HEB 3:15">مَا تْكَسْحُوشْ قْلُوبْكُمْ كِيمَا عَمْلُوا جْدُودْكُمْ،</para>
  <para style="q1" vid="HEB 3:15">نْهَارِةْ الِّي عْصَاوْنِي».<verse eid="HEB 3:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />وشْكُونْهُمْ الِّي تْمَرْدُوا عْلِيهْ بَعْدْمَا سَمْعُوا صُوتُو؟ مُشْ كُلْ الِّي خَرِّجْهُمْ مُوسَى مِنْ مَصْرْ؟ <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />وعْلَى شْكُونْ غْضُبْ اللَّهْ لْمُدِّةْ 40 سْنَة؟ مُشْ عَلِّي عَمْلُوا الذْنُوبْ ومَاتُوا فِي الصَّحْرَاء؟ <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />وعْلَى شْكُونْ حْلِفْ إِنْهُمْ مُشْ بِشْ يُدْخْلُوا لْرَاحْتُو؟ مُشْ عَلِّي عْصَاوِهْ؟ <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />وهَكَّا نْشُوفُوا الِّي هُومَا مَا نَجْمُوشْ يُدْخْلُوا عْلَى خَاطِرْهُمْ مَا أَمْنُوشْ.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="s">رَاحَة لْشَعْبْ اللَّهْ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />ومَادَامْ مَزَالْ عَنْدْنَا الوَعْدْ بِالدْخُولْ لْرَاحِةْ اللَّهْ ، مَالَا نْرُدُّوا بَالْنَا بَاشْ حَتَّى حَدْ مِنْكُمْ مَا يِتِحْرِمْ مِنُّو. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />عْلَى خَاطِرْنَا سْمَعْنَا البْشَارَة كِيمَا سَمْعُوهَا هُومَا. آمَا البْشَارَة الِّي سَمْعُوهَا مَا نَفْعِتْهُمْشْ، عْلَى خَاطِرْهُمْ مَا أَمْنُوشْ بِيهَا. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />آمَا أَحْنَا الِّي أَمَّنَّا بِالبْشَارَة، نُدْخْلُوا لْرَاحِةْ اللَّهْ الِّي قَالْ عْلِيهَا:</para>
  <para style="b" vid="HEB 4:3" />
  <para style="q1" vid="HEB 4:3">«كِي غْضُبْتْ حْلِفْتْ</para>
  <para style="q2" vid="HEB 4:3">إِنْهُمْ مَا يُدْخْلُوشْ لْرَاحْتِي!»</para>
  <para style="b" vid="HEB 4:3" />
  <para style="m" vid="HEB 4:3">رَغْمِلِّي أَعْمَالُو تَمِّتْ مِلِّي تْخَلْقِتْ الدِّنْيَا. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />وقَالْ فِي بْلَاصَة مِالكْتُبْ المُقَدْسَة عَالنْهَارْ السَّابَعْ:</para>
  <para style="b" vid="HEB 4:4" />
  <para style="q1" vid="HEB 4:4">«وبَعْدْهَا إِرْتَاحْ اللَّهْ مِلِّي يَعْمِلْ فِيهْ الكُلْ، فِي النْهَارْ السَّابَعْ».<verse eid="HEB 4:4" /></para>
  <para style="b" />
  <para style="m">
    <verse number="5" style="v" sid="HEB 4:5" />وقَالْ زَادَا:</para>
  <para style="b" vid="HEB 4:5" />
  <para style="q1" vid="HEB 4:5">«مَا يُدْخْلُوشْ لْرَاحْتِي».<verse eid="HEB 4:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6" />ومَادَامْ الِّي سَمْعُوا البْشَارَة فِي الأُوِّلْ مَا دَخْلُوشْ لِلرَّاحَة بِسْبَبْ عِصْيَانْهُمْ، وَاضَحْ إِنُّو فَمَّة أُخْرِينْ بِشْ يُدْخْلُولْهَا. <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />هَاذَاكَا عْلَاشْ اللَّهْ حَدِّدْ نْهَارْ آخَرْ إِسْمُو «اليُومْ» وتْكَلَّمْ عْلِيهْ بَعْدْ زْمَانْ طْوِيلْ عْلَى لْسَانْ دَاوِدْ، كِيمَا سْبَقْ وقُلْنَا:</para>
  <para style="b" vid="HEB 4:7" />
  <para style="q1" vid="HEB 4:7">«اليُومْ، إِذَا سْمَعْتُوا صُوتْ اللَّهْ،</para>
  <para style="q2" vid="HEB 4:7">مَا تْكَسْحُوشْ قْلُوبْكُمْ».<verse eid="HEB 4:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />كَانْ جَاء يَشُوعْ دَخَّلْهُمْ لِلرَّاحَة، رَاوْ اللَّهْ مَا حْكَاشْ مْبَعِّدْ عْلَى يُومْ آخِرْ. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />مَالَا، مَزَّالِتْ فَمَّة رَاحَة لْشَعْبْ اللَّهْ، كِيفْ رَاحَةْ اللَّهْ فِي اليُومْ السَّابَعْ. <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />عْلَى خَاطِرْ الِّي يُدْخُلْ لْرَاحِةْ اللَّهْ، يَرْتَاحْ زَادَا مِلِّي يَعْمِلْ فِيهْ، كِيمَا إِرْتَاحْ اللَّهْ مِنْ أَعْمَالُو. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />خَلِّينَا نَعْمْلُوا مَجْهُودْنَا الكُلْ بَاشْ نُدْخْلُوا لِلرَّاحَة هَاذِيكَا، بَاشْ حَتَّى وَاحِدْ مِنَّا مَا يْطِيحْ كِيمَا طَاحُوا الِّي عْصَاوْ.<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />رَاهِي كِلْمِةْ اللَّهْ حَيَّة وفَاعْلَة، وأَمْضَى مِنْ كُلْ سِيفْ مَاضِي مِالجِيهْتِينْ. تُدْخُلْ مَا بِينْ النَّفْسْ والرُّوحْ، ومَا بِينْ المْفَاصِلْ والنْخَاعْ، وتُحْكُمْ عْلَى نِيِّةْ القَلْبْ وأَفْكَارُو. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />ومَا فَمَّة حَتَّى مَخْلُوقْ يَخْفَى عْلَى اللَّهْ، آمَا كُلْ شَيْ عِرْيَانْ ومَكْشُوفْ قُدَّامْ عِينِيهْ، وهُوَّ الِّي بِشْ نَعْطِيوِهْ حْسَابْ.<verse eid="HEB 4:13" /></para>
  <para style="s">يَسُوعْ الكَاهِنْ الكْبِيرْ</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />ومَادَامْ عَنْدْنَا كَاهِنْ كْبِيرْ، يَسُوعْ إِبْنْ اللَّهْ الِّي طْلَعْ ودْخَلْ السْمَاء، خَلِّينَا نْشِدُّوا صْحِيحْ فِي إِيمَانَّا الِّي نِشْهْدُوا بِيهْ. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />والكَاهِنْ الكْبِيرْ مْتَاعْنَا قَادِرْ يِفْهِمْ ضُعْفْنَا، عْلَى خَاطْرُو تْجَرَّبْ فِي كُلْ شَيْ كِيفْنَا آمَا مَا عْمَلْ حَتَّى ذَنْبْ. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />مَالَا خَلِّينَا نُقْرْبُوا بْثِيقَة لْعَرْشْ إِلَاهْ النِّعْمَة، بَاشْ نَاخْذُوا رَحْمَة ونَلْقَاوْ نِعْمَة تْعَاوِنَّا فِي وَقْتْ الحَاجَة.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />رَاهُو كُلْ كَاهِنْ كْبِيرْ يِخْتَارُوهْ مِنْ بِينْ النَّاسْ، ويِتْحَطْ بَاشْ يْنُوبْهُمْ قُدَّامْ اللَّهْ، ويْقَدِّمْ القَرَابِينْ والذْبَايِحْ بَاشْ يْكَفِّرْ عْلَى ذْنُوبْهُمْ. <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />وعْلَى خَاطْرُو يَعْرِفْ الِّي هُوَّ بِيدُو ضْعِيفْ، يْنَجِّمْ زَادَا يِرْفَقْ بِالجُهَّالْ والضَّايْعِينْ. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />وبِسْبَبْ ضُعْفُو هَاذَا كَانْ لَازْمُو يْقَدِّمْ ضْحِيَّة عْلَى ذْنُوبُو هُوَّ، كِيمَا يْقَدِّمْ ضْحِيَّة عْلَى ذْنُوبْ الشَّعْبْ.<verse eid="HEB 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 5:4" />وحَتَّى حَدْ مَا يْنَجِّمْ يْنَصِّبْ رُوحُو فِي مْقَامْ الكَاهِنْ الكْبِيرْ، آمَا لَازِمْ يْكُونْ اللَّهْ هُوَّ الِّي دْعَاهْ، كِيمَا دْعَى هَارُونْ. <verse eid="HEB 5:4" /><verse number="5" style="v" sid="HEB 5:5" />المَسِيحْ زَادَا مَا نَصِّبْشْ رُوحُو فِي مْقَامْ الكَاهِنْ الكْبِيرْ، آمَا اللَّهْ هُوَّ الِّي قَالُّو:</para>
  <para style="b" vid="HEB 5:5" />
  <para style="q1" vid="HEB 5:5">«إِنْتِ إِبْنِي،</para>
  <para style="q2" vid="HEB 5:5">وآنَا اليُومْ جِبْتِكْ».<verse eid="HEB 5:5" /></para>
  <para style="b" />
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />وقَالُّو فِي بْلَاصَة أُخْرَى:</para>
  <para style="b" vid="HEB 5:6" />
  <para style="q1" vid="HEB 5:6">«إِنْتِ كَاهِنْ لِلْأَبَدْ</para>
  <para style="q2" vid="HEB 5:6">كِيمَا مَلْكِيصَادِقْ».<verse eid="HEB 5:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />والمَسِيحْ، وَقْتِلِّي كَانْ عَايِشْ عَالأَرْضْ، صَلَّى بْصُوتْ عَالِي ودْمُوعْ وطْلَبْ اللَّهْ القَادِرْ يْمَنْعُو مِالمُوتْ، واللَّهْ سْمَعْلُو عْلَى خَاطْرُو تَقِيْ. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />ورَغْمِلِّي هُوَّ الإِبْنْ، تْعَلَّمْ الطَّاعَة عْلَى طْرِيقْ الوْجَايَعْ الِّي عَانَاهَا. <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />ووَقْتِلِّي وَلَّى مُؤَهَّلْ بِالكَامِلْ بَاشْ يْقُومْ بْمُهِمْتُو، وَلَّى هُوَّ مَصْدِرْ النْجَاةْ الأَبَدِيَّة لِلِّي يْطِيعُوهْ الكُلْ، <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />واللَّهْ عَيْنُو كَاهِنْ كْبِيرْ كِيمَا مَلْكِيصَادِقْ.<verse eid="HEB 5:10" /></para>
  <para style="s">إِنْتُومَا أَوْلَادْ صْغَارْ</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />وعَنْدْنَا بَرْشَة كْلَامْ نْقُولُوهْ فِي المَوْضُوعْ هَاذَا، آمَا صْعِيبْ نْفَسْرُوهْ، عْلَى خَاطِرْ فَهْمْكُمْ وَلَّى رْزِينْ. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />كَانْ المَفْرُوضْ بَعْدْ الوَقْتْ هَاذَا الكُلْ تْوَلِّيوْ مُعَلْمِينْ، آمَا إِنْتُومَا مَزِّلْتُوا مِحْتَاجِينْ لِشْكُونْ يْعَلَّمْكُمْ أَسَاسِيَّاتْ كْلَامْ اللَّهْ. إِنْتُومَا مِحْتَاجِينْ لِلْحْلِيبْ، مُشْ لِلْمَاكْلَة القْوِيَّة. <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />الِّي عَايِشْ عَالحْلِيبْ، مَزَّالْ طْفُلْ صْغِيرْ ومَا عَنْدُوشْ خِبْرَة فِي التَّعْلِيمْ الصْحِيحْ. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />آمَا المَاكْلَة القْوِيَّة، رَاهِي لِلنَّاضْجِينْ الِّي دَرْبُوا رْوَاحْهُمْ حَتَّى لِينْ وَلَّاوْ يْفَرْقُوا مَا بِينْ الخِيرْ والشَّرْ.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="s">مَا تَرْجْعُوشْ بِالتْوَالِي</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />مَالَا خَلِّينَا نْقَدْمُوا ونُنْضْجُوا ونْفُوتُوا التَّعَالِيمْ الأَسَاسِيَّة عَالمَسِيحْ، ومَا نِرْجْعُوشْ نَحْكِيوْ عَالتَّوْبَة مِالأَعْمَالْ الِّي تْهِزْ لِلْمُوتْ، وعَالإِيمَانْ بِاللَّهْ، <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />والتَّعْلِيمْ عَالمَعْمُودِيَّاتْ، وحَطَّانْ اليْدِينْ، وقْيَامِةْ المُوتَى، وعِقَابْ الآخْرَة. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />وبْقُدْرِةْ رَبِّي، بِشْ نْقَدْمُوا.<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />رَاهُمْ الِّي سْبَقْ وتْنَوْرُوا مَرَّة، وذَاقُوا هِيبِةْ السْمَاء، ووَلَّاوْ مْشَارْكِينْ فِي الرُّوحْ القُدُسْ، <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />وذَاقُوا كِلْمِةْ اللَّهْ الصَّالْحَة، وشَافُوا مُعْجْزَاتْ الزْمَانْ الجَّايْ، <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />ومْبَعِّدْ إِرْتَدُّوا، يَسْتَحِيلْ إِنْهُمْ يِرْجْعُوا يْتُوبُوا مِنْ جْدِيدْ. هُومَا جْنَاوْ عْلَى رْوَاحْهُمْ عْلَى خَاطِرْهُمْ يُصْلْبُوا فِي إِبْنْ اللَّهْ مَرَّة أُخْرَى، ويْهِينُوا فِيهْ جْهَارْ. <verse eid="HEB 6:6" /><verse number="7" style="v" sid="HEB 6:7" />رَاهُو اللَّهْ يْبَارِكْ الأَرْضْ الِّي تِتْرْوَى مِالمْطَرْ الِّي تْصُبْ عْلِيهَا بَرْشَة مَرَّاتْ، وتْجِيبْ صَابَة بَاهْيَة لِلِّي فَلْحُوهَا. <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />آمَا وَقْتِلِّي تْجِيبْ شُوكْ وحْشِيشْ، مَا عَنْدْهَاشْ حَتَّى قِيمَة وتِسْتَاهِلْ اللَّعْنَة، وعَاقْبِتْهَا الحَرْقَانْ.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />يَا خْوَاتِي الغَالِينْ، أَحْنَا نْقُولُوا فِي هَاذَا بَاشْ إِنَّبْهُوكُمْ، آمَا رَانَا مِتْأَكْدِينْ الِّي حَالِتْكُمْ خِيرْ مِنْ هَكَّا، ولِّي إِنْتُومَا فِي طْرِيقْكُمْ لِلنْجَاةْ. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />رَاهُو اللَّهْ مُشْ ظَالِمْ بَاشْ يِنْسَى الِّي عْمَلْتُوهْ ويِنْسَى مْحَبِّتْكُمْ لِيهْ، الِّي ظَهَّرْتُوهَا وَقْتِلِّي خْدِمْتُوا القِدِّيسِينْ ومَزِّلْتُوا تِخْدْمُوا فِيهُمْ. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />آمَا مَذَابِينَا كَانْ كُلْ وَاحِدْ فِيكُمْ يْظَهَّرْ نَفْسْ الإِجْتِهَادْ حَتَّى لِلِّخِّرْ، ويْكُونْ مِتْأَكِّدْ إِنُّو رْجَاهْ بِشْ يِتْحَقَّقْ فِي الإِخِّرْ. <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />ومَا تْكُونُوشْ بُخْلِيِّينْ، آمَا تَبْعُوا النَّاسْ الِّي بِالإِيمَانْ والصَّبْرْ يُورْثُوا الِّي وْعِدْ بِيهْ اللَّهْ.<verse eid="HEB 6:12" /></para>
  <para style="s">وَعْدْ اللَّهْ صَادِقْ</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />رَاهُو اللَّهْ وَقْتِلِّي عْطَى وَعْدْ لْإِبْرَاهِيمْ، حْلِفْ بْرُوحُو، عْلَى خَاطِرْ مَا فَمَّاشْ شْكُونْ أَعْظَمْ مِنُّو يِحْلِفْ بِيهْ، <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />وقَالُّو:</para>
  <para style="b" vid="HEB 6:14" />
  <para style="q1" vid="HEB 6:14">«أَكِيدْ بِشْ نْبَارْكِكْ</para>
  <para style="q2" vid="HEB 6:14">ونْكَثِّرْ ذُرِّيتِكْ».<verse eid="HEB 6:14" /></para>
  <para style="b" />
  <para style="m">
    <verse number="15" style="v" sid="HEB 6:15" />وهَكَّا، كِي صْبَرْ إِبْرَاهِيمْ نَالْ الِّي وِعْدُو بِيهْ اللَّهْ. <verse eid="HEB 6:15" /><verse number="16" style="v" sid="HEB 6:16" />والنَّاسْ يِحْلْفُوا بِشْكُونْ أَعْظَمْ مِنْهُمْ، والحَلْفَانْ يْأَكْدُوا بِيهْ كْلَامْهُمْ ويْوَقْفُوا بِيهْ المَشَاكِلْ. <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />وبْنَفْسْ الطَّرِيقَة، اللَّهْ كِي حَبْ يْأَكِّدْ لِلِّي بِشْ يُورْثُوا الوَعْدْ إِنُّو مَا يِرْجَعْشْ فِي كْلَامُوا أَكِّدْهُولْهُمْ بِالحَلْفَانْ. <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />اللَّهْ إِسْتَعْمِلْ حَاجْتِينْ ثَابْتِينْ مُشْ مُمْكِنْ يِكْذِبْ فِيهُمْ، وهُومَا الوَعْدْ والحَلْفَانْ، الِّي شَجْعُونَا بَرْشَة، أَحْنَا الِّي لْقِينَا مَلْجَأْ فِي الرْجَى الِّي عْطَاهُولْنَا وشَدِّينَا فِيهْ صْحِيحْ. <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />والرْجَى هَاذَا هُوَّ بِالنِّسْبَة لِينَا كِيمَا المِرْسَاةْ الثَّابْتَة والآمْنَة، وهُوَّ يُدْخُلْ لِوْرَاء الحِجَابْ، لْقُدْسْ الأَقْدَاسْ، <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />وِينْ سْبَقْنَا يَسُوعْ ودْخَلْ عْلَى خَاطِرْنَا، ووَلَّى كَاهِنْ كْبِيرْ لِلْأَبَدْ كِيمَا مَلْكِيصَادِقْ.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s">مَلْكِيصَادِقْ المَلِكْ والكَاهِنْ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />ومَلْكِيصَادِقْ هَاذَا كَانْ مَلِكْ مْدِينِةْ سَالِيمْ وكَاهِنْ لِلَّهْ العَالِي. وهُوَّ الِّي قَابِلْ إِبْرَاهِيمْ وبَارْكُو، وَقْتِلِّي إِبْرَاهِيمْ كَانْ رَاجَعْ بَعْدْمَا غْلِبْ المُلُوكْ. <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />وإِبْرَاهِيمْ عْطَاهْ العْشُرْ مِلِّي رَبْحُو فِي الحَرْبْ الكُلْ. ومَعْنَى إِسْمْ مَلْكِيصَادِقْ هُوَّ «مَلِكْ العَدْلْ»، وهُوَّ زَادَا مَلِكْ سَالِيمْ، الِّي مَعْنَاهْ «مَلِكْ السَّلَامْ». <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />وأَحْنَا مَا نَعْرْفُولُوشْ لَا بُو لَا أُمْ لَا نْسَبْ، ولَا كِيفَاشْ بْدَاتْ حْيَاتُو ولَا كِيفَاشْ وْفَاتْ. آمَا هُوَّ كِيمَا إِبْنْ اللَّهْ، يَبْقَى كَاهِنْ لِلْأَبَدْ.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />شُوفُوا قَدَّاشُو عْظِيمْ! بُونَا إِبْرَاهِيمْ بِيدُو، عْطَاهْ العْشُرْ مِالحَاجَاتْ الِّي رْبَحْهُمْ فِي الحَرْبْ. <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />والشَّرِيعَة تُأْمُرْ الكَهَنَة مِنْ ذُرِّيِّةْ لَاوِي بَاشْ يَاخْذُوا العْشُرْ مِالشَّعْبْ، يَعْنِي مِنْ خْوَاتْهُمْ، رَغْمِلِّي هُومَا زَادَا مِنْ ذُرِّيِّةْ إِبْرَاهِيمْ. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />ومَلْكِيصَادِقْ مَا كَانِشْ مِنْ ذُرِّيِّةْ لَاوِي، آمَا خْذَا العْشُرْ مِنْ عَنْدْ إِبْرَاهِيمْ وبَارْكُو، رَغْمِلِّي إِبْرَاهِيمْ هُوَّ الِّي خْذَى الوَعْدْ مِنْ عَنْدْ اللَّهْ. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />ومِنْ غِيرْ حَتَّى شَكْ الكْبِيرْ هُوَّ الِّي يْبَارِكْ الصْغِيرْ. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />وزِيدْ عْلَى هَاذَا، الكَهَنَة الِّي يَاخْذُوا العْشُرْ هُومَا بَشَرْ يْمُوتُوا، آمَا مَلْكِيصَادِقْ الِّي خْذَى العْشُرْ مِنْ عَنْدْ إِبْرَاهِيمْ، تِشْهِدْلُو الكْتُبْ المُقَدْسَة الِّي هُوَّ حَيْ. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />وانَّجْمُوا نْقُولُوا إِنُّو لَاوِي، الِّي يَاخِذْ العْشُرْ، هُوَّ بِيدُو دْفَعْ العْشُرْ عْلَى طْرِيقْ إِبْرَاهِيمْ، <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />عْلَى خَاطِرْ لَاوِي كَانْ فِي صُلْبْ جَدُّو إِبْرَاهِيمْ وَقْتِلِّي قَابْلُو مَلْكِيصَادِقْ.<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />وخِدْمِةْ الكَهَنَة اللَّاوِيِّينْ، كَانِتْ هِيَّ سَاسْ الشَّرِيعَة الِّي تِعْطَاتْ لِلشَّعْبْ. وكَانْ جَاتْ الخِدْمَة هَاذِي وَصْلِتْ النَّاسْ لِلْكَمَالْ، مَالَا عْلَاشْ بَعْدْهَا كَانْ لَازِمْ يُظْهُرْ كَاهِنْ آخَرْ كِيمَا مَلْكِيصَادِقْ ومُشْ كِيمَا هَارُونْ؟ <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />عْلَى خَاطِرْ، وَقْتِلِّي يْصِيرْ تَبْدِيلْ فِي خِدْمِةْ الكَهَنَة، لَازِمْ يْصِيرْ تَبْدِيلْ فِي الشَّرِيعَة زَادَا.<verse eid="HEB 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 7:13" />ورَبْنَا، الِّي تْقَالْ عْلِيهْ الكْلَامْ هَاذَا، مُشْ مِنْ عَرْشْ لَاوِي، آمَا مِنْ عَرْشْ آخِرْ لَا عُمْرُو وَاحِدْ فِيهُمْ خْدِمْ كَاهِنْ. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />ومَعْرُوفْ إِنُّو هُوَّ جَاء مِنْ عَرْشْ يَهُوذَا، ومُوسَى عُمْرُو مَا قَالْ إِنُّو العَرْشْ هَاذَا يْجِيوْ مِنُّو كَهَنَة.<verse eid="HEB 7:14" /></para>
  <para style="s">يَسُوعْ كَاهِنْ كِيمَا مَلْكِيصَادِقْ</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15" />ولِّي يْخَلِّي الحْكَايَة أَوْضَحْ، هُوَّ إِنُّو الكَاهِنْ الآخِرْ يْجِي كِيمَا مَلْكِيصَادِقْ، <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />الِّي مَا وَلَّاشْ كَاهِنْ عْلَى أَسَاسْ قَانُونْ يُشْرُطْ نْسَبْ مُعَيِّنْ، آمَا عْلَى أَسَاسْ قُوِّةْ حَيَاةْ مَا تِفْنَاشْ. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />والكْتُبْ المُقَدْسَة تِشْهِدْلُو:</para>
  <para style="b" vid="HEB 7:17" />
  <para style="q1" vid="HEB 7:17">«إِنْتِ كَاهِنْ لِلْأَبَدْ</para>
  <para style="q2" vid="HEB 7:17">كِيمَا مَلْكِيصَادِقْ».<verse eid="HEB 7:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="HEB 7:18" />وهَكَّا بْطُلْ نِظَامْ الكَهَنَة القْدِيمْ عْلَى خَاطْرُو ضْعِيفْ وبْلَا فَايْدَة. <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />ومَادَامْ شَرِيعِةْ مُوسَى مَا نَجْمِتْشْ تْوَصِّلْ لِلْكَمَالْ، جَاء فِي بْلَاصِتْهَا رْجَى مَا خِيرْ، انَّجْمُوا نُقْرْبُوا بِيهْ لِلَّهْ.<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />وهَاذَا مَا صَارِشْ مِنْ غِيرْ مَا اللَّهْ يِحْلِفْ. آمَا اللَّاوِيينْ وَلَّاوْ كَهَنَة مِنْ غِيرْ حِلْفَانْ، <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />واللَّهْ حَطْ يَسُوعْ كَاهِنْ كِي حْلِفْ وقَالْ:</para>
  <para style="b" vid="HEB 7:21" />
  <para style="q1" vid="HEB 7:21">«الرَّبْ حْلِفْ، ومُشْ بِشْ يِرْجَعْ فِي كْلَامُو:</para>
  <para style="q2" vid="HEB 7:21">"إِنْتِ كَاهِنْ لِلْأَبَدْ"».<verse eid="HEB 7:21" /></para>
  <para style="b" />
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />وهَكَّا وَلَّى يَسُوعْ ضَامِنْ لْعَهْدْ خِيرْ مِالعَهْدْ الأُوِّلْ.<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />وزِيدْ عْلَى هَاذَا، الكَهَنَة قْبَلْ كَانْ عْدَدْهُمْ كْبِيرْ، عْلَى خَاطِرْهُمْ يْمُوتُوا ولَازِمْهُمْ يِتْعَوْضُوا. <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />آمَا يَسُوعْ هُوَّ كَاهِنْ مَا يْعَوْضُو حَدْ، عْلَى خَاطْرُو حَيْ لِلْأَبَدْ. <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />هَاذَاكَا عْلَاشْ هُوَّ قَادِرْ يْنَجِّي بِالكَامِلْ الِّي يِتْقَرْبُوا بِيهْ لِلَّهْ، عْلَى خَاطْرُو دِيمَا حَيْ بَاشْ يِشْفَعْ فِيهُمْ.<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />مَالَا يَسُوعْ هُوَّ الكَاهِنْ الكْبِيرْ الِّي يِلْزِمْنَا. هُوَّ قُدُّوسْ، مَا عْمَلْ حَتَّى شَرْ وحَتَّى ذَنْبْ، مَاهُوشْ مِالمُذْنْبِينْ، ومَرْفُوعْ أَعْلَى مِالسْمَاوَاتْ. <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />وهُوَّ مُشْ مِحْتَاجْ يْقَدِّمْ ذْبَايِحْ كُلْ يُومْ بَاشْ يْكَفِّرْ عْلَى ذْنُوبُو هُوَّ فِي الأُوِّلْ، كِيمَا كَانُوا يَعْمْلُوا كْبَارْ الكَهَنَة قْبَلْ مَا يْقَدْمُوا ذْبَايَحْ عْلَى ذْنُوبْ الشَّعْبْ، آمَا هُوَّ كَفِّرْ عْلَى ذْنُوبْهُمْ مَرَّة وَحْدَة، وَقْتِلِّي قَدَّمْ رُوحُو ضْحِيَّة. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />وكْبَارْ الكَهَنَة الِّي تْحُطْهُمْ الشَّرِيعَة هُومَا بَشَرْ ضْعَافْ، آمَا الِّي حَطُّو اللَّهْ كَاهِنْ كْبِيرْ بِالكِلْمَة الِّي حْلِفْ بِيهَا ولِّي جَاتْ بَعْدْ الشَّرِيعَة، هُوَّ الإِبْنْ الكَامِلْ الِّي تَمِّمْ الخِدْمَة الِّي عْطَاهَالُو اللَّهْ.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s">العَهْدْ الجْدِيدْ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />وأَهَمْ حَاجَة نْحِبْ نْقُولْهَا هِيَّ، إِنُّو عَنْدْنَا كَاهِنْ كْبِيرْ بِالأَوْصَافْ هَاذِي، قَاعِدْ عْلَى يْمِينْ عَرْشْ اللَّهْ العْظِيمْ فِي السْمَاء، <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />يِخْدِمْ فِي أَقْدِسْ بْلَاصَة، فِي الخِيمَة الحَقِيقِيَّة الِّي نْصَبْهَا الرَّبْ مُشْ الإِنْسَانْ.<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />والكَاهِنْ الكْبِيرْ مَجْعُولْ بَاشْ يْقَدِّمْ القَرَابِينْ والذْبَايِحْ، هَاذَاكَا عْلَاشْ كَاهِنَّا الكْبِيرْ يِلْزِمْ هُوَّ زَادَا يْكُونْ عَنْدُو مَا يْقَدِّمْ . <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />وكَانْ جَاء المَسِيحْ مَوْجُودْ هُونِي عَالأَرْضْ، رَاهُو مَا تْحَطِّشْ كَاهِنْ، عْلَى خَاطِرْ فَمَّة كَهَنَة يْقَدْمُوا فِي القَرَابِينْ حَسْبْ الشَّرِيعَة، <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />وهُومَا يَعْمْلُوا فِي خِدْمَة فِي خِيمَة، مَاهِي إِلَّا نُسْخَة وظِلْ لِلِّي يِتَعْمَلْ فِي السْمَاء. وهَاذَا وَاضِحْ مِلِّي وْحَاهْ اللَّهْ لْمُوسَى، وَقْتِلِّي جَاء بَاشْ يَعْمِلْ خِيمِةْ العِبَادَة وقَالُّو: «أَحْرِصْ بَاشْ تَعْمِلْ كُلْ شَيْ حَسْبْ المِثَالْ الِّي وَرِّيتْهُولِكْ فِي الجْبَلْ». <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />آمَا المَسِيحْ خْذَا خِدْمَة أَهَمْ مِلِّي خْذَاوْهَا الكَهَنَة الِّي قَبْلُو، عْلَى خَاطْرُو وَاسْطَة لْعَهْدْ مَا خِيرْ، والعَهْدْ هَاذَا مَبْنِي عْلَى وُعُودْ مَا خِيرْ.<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />وكَانْ جَاء العَهْدْ الأُوِّلْ مَا فِيهْ حَتَّى عِيبْ، رَانَا مَا اسْتْحَقِّينَاشْ لْعَهْدْ آخِرْ يْجِي فِي بْلَاصْتُو. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />آمَا اللَّهْ يْلُومْ فِي شَعْبُو وَقْتِلِّي يْقُولْ:</para>
  <para style="b" vid="HEB 8:8" />
  <para style="q1" vid="HEB 8:8">«هَاذَا كْلَامْ الرَّبْ: بِشْ يْجِي وَقْتْ،</para>
  <para style="q2" vid="HEB 8:8">نَعْمِلْ فِيهْ عَهْدْ جْدِيدْ مْعَ بَنِي إِسْرَائِيلْ</para>
  <para style="q2" vid="HEB 8:8">ومْعَ بَنِي يَهُوذَا.<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />العَهْدْ هَاذَا مُشْ كِي العَهْدْ الِّي عْمَلْتُو مْعَ جْدُودْهُمْ،</para>
  <para style="q2" vid="HEB 8:9">وَقْتِلِّي شَدِّيتْهُمْ مِنْ يْدِيهُمْ وخَرَّجْتْهُمْ مِنْ مَصْرْ.</para>
  <para style="q1" vid="HEB 8:9">آمَا هُومَا خَانُوا عَهْدِي،</para>
  <para style="q2" vid="HEB 8:9">هَاذَاكَا عْلَاشْ مَا تِلْهِيتِشْ بِيهُمْ، يْقُولْ الرَّبْ.<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />وهَاذَا هُوَّ العَهْدْ الِّي نَعْمْلُو مْعَ بَنِي إِسْرَائِيلْ</para>
  <para style="q2" vid="HEB 8:10">بَعْدْ الوَقْتْ هَاذَاكَا، يْقُولْ الرَّبْ:</para>
  <para style="q1" vid="HEB 8:10">بِشْ نْحُطْ شَرِيعْتِي فِي عْقُولْهُمْ،</para>
  <para style="q2" vid="HEB 8:10">ونِكْتِبْهَا فِي قْلُوبْهُمْ.</para>
  <para style="q1" vid="HEB 8:10">وآنَا نْكُونْ إِلَاهْهُمْ،</para>
  <para style="q2" vid="HEB 8:10">وهُومَا يْكُونُوا شَعْبِي.<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />ومَا عَادْ حَتَّى وَاحِدْ يْعَلِّمْ قْرِيبُو وَلَّا خُوهْ ويْقُلُّو:</para>
  <para style="q2" vid="HEB 8:11">"أَعْرِفْ الرَّبْ"،</para>
  <para style="q1" vid="HEB 8:11">عْلَى خَاطِرْهُمْ بِشْ يَعْرْفُونِي الكُلْ،</para>
  <para style="q2" vid="HEB 8:11">مِنْ صْغِيرْهُمْ لِكْبِيرْهُمْ،<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />وبِشْ نْسَامِحْهُمْ عْلَى مْعَاصِيهُمْ،</para>
  <para style="q2" vid="HEB 8:12">ومَا عَادِشْ بِشْ نِتْذَكِّرْ ذْنُوبْهُمْ».<verse eid="HEB 8:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13" />ومَادَامْ اللَّهْ يْسَمِّي العَهْدْ هَاذَا «جْدِيدْ» مَعْنَاهَا رَدْ العَهْدْ الأُوِّلْ قْدِيمْ، وكُلْ مَاهُو قْدِيمْ وعُمْرُو كْبِيرْ رَاهُو مْصِيرُو يِفْنَى.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s">العْبَادَة فِي العَهْدْ الأُوِّلْ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />والعَهْدْ الأُوِّلْ كَانِتْ عَنْدُو فْرَايِضْ لِلْعْبَادَة، وبْلَاصَة مُقَدْسَة فِي الأَرْضْ. <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />وكَانِتْ فَمَّة خِيمَة مَنْصُوبَة، ومْقَسْمَة عْلَى اثْنِينْ وبِينَاتْهُمْ حْجَابْ. البْلَاصَة الِّي مِنْ قُدَّامْ تِتْسَمَّى القُدْسْ، وفِيهَا فْنَارْ الشْمَعْ، والطَّاوْلَة والخُبْزْ الِّي يِتْقَدِّمْ قُرْبَانْ لِلَّهْ. <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />والبْلَاصَة الِّي مِنْ تَالِي وْرَاء الحْجَابْ، تِتْسَمَّى قُدْسْ الأَقْدَاسْ، <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />وفِيهَا المَبْخْرَة الذْهَبْ، وصَنْدُوقْ العَهْدْ المْغَلِّفْ بِالذْهَبْ، وفِي الصَّنْدُوقْ فَمَّة جَرَّة ذْهَبْ فِيهَا المَنْ، وعْصَاةْ هَارُونْ الِّي نَبْتِتْ أَوْرَاقْ، ولَوْحْتِينْ حْجَرْ مَكْتُوبْ عْلِيهُمْ وْصَايَا العَهْدْ. <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />وكَانْ فُوقْ صَنْدُوقْ العَهْدْ تِمْثَالِينْ لْزُوزْ مْلَايْكَة كَارُوبِيمْ يُرْمْزُوا لْمَجْدْ اللَّهْ، وعَنْدْهُمْ جْوَانَحْ يْضَلَلُوا بِيهُمْ عْلَى غْطَى الصَّنْدُوقْ. آمَا مُشْ وَقْتُو نْزِيدْ نُدْخُلْ فِي التَّفَاصِيلْ تَوَّا.<verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />وبَعْدْمَا تِتْحَطْ كُلْ حَاجَة فِي بْلَاصِتْهَا، يُدْخْلُوا الكَهَنَة فِي كُلْ وَقْتْ لِلْبْلَاصَة الأُولَى الِّي مِنْ قُدَّامْ، ويَعْمْلُوا فْرَايِضْ العْبَادَة. <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />آمَا البْلَاصَة الثَّانْيَة، مَا يُدْخْلِلْهَا كَانْ الكَاهِنْ الكْبِيرْ، مَرَّة وَحْدَة فِي العَامْ، ومَا يُدْخُلْهَا كَانْ مَا يْهِزْ مْعَاهْ الدَّمْ الِّي يِلْزِمْ يْقَدْمُو بَاشْ يْكَفِّرْ عْلَى ذْنُوبُو هُوَّ وعَالذْنُوبْ الِّي عْمَلْهَا الشَّعْبْ مِنْ غِيرْ مَا يُقْصِدْ. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />وبْهَاذَا يْوَرِّي الرُّوحْ القُدُسْ إِنُّو الطْرِيقْ لْقُدْسْ الأَقْدَاسْ مَزَّالْ مُشْ مَحْلُولْ، مَادَامْ الخِيمَة الأُولَى مَزَّالِتْ مَوْجُودَة. <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />وهَاذَا الكُلْ مِثَالْ لِلْوَقْتْ الحَاضِرْ، ويْوَرِّي إِنُّو القَرَابِينْ والذْبَايَحْ الِّي تِتْقَدِّمْ لِلَّهْ، مَا تْنَجَّمْشْ اطَّهِّرْ ضَمِيرْ الِّي يْقَدِّمْ فِيهُمْ. <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />عْلَى خَاطِرْ مَاهُمْ إِلَّا فَرَايِضْ يْخُصُّوا البْدَنْ، ومَحْصُورِينْ فِي المَاكْلَة والشْرَابْ وطُقُوسْ التَّطْهِيرْ. وكَانُوا مَفْرُوضِينْ حَتَّى لِينْ يْجِي الوَقْتْ الِّي يْصَلَّحْ فِيهْ اللَّهْ كُلْ شَيْ.<verse eid="HEB 9:10" /></para>
  <para style="s">المَسِيحْ هُوَّ وَاسْطَة لْعَهْدْ جْدِيدْ</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />آمَا المَسِيحْ جَاء بِٱعْتِبَارُو الكَاهِنْ الكْبِيرْ، بَاشْ يِخْدِمْ البَرَكَاتْ الجْدِيدَة، ودْخَلْ لْخِيمَة أَعْظِمْ وأَكْثِرْ كَمَالْ مِالخِيمَة الأُولَى، مَا تْصَنْعِتْشْ بِيدِينْ النَّاسْ ومَاهِيشْ مِالدِّنْيَا هَاذِي. <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />ودْخَلْ لْقُدْسْ الأَقْدَاسْ مَرَّة وَحْدَة، مُشْ بْدَمْ بْرَاشِنْ وعْجُولْ، آمَا بْدَمُّو هُوَّ، وهَكَّا فْدَانَا لِلْأَبَدْ. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />إِذَا كَانْ رَشَّانْ دَمْ البْرَاشِنْ والثِّيرَانْ، ورْمَادْ عِجْلَة يْقَدِّسْ المَنْزُوسِينْ ويْطَهْرِلْهُمْ بْدَنَّاتْهُمْ، <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />مَالَا بِالأَوْلَى دَمْ المَسِيحْ، عْلَى خَاطِرْ المَسِيحْ قَدِّمْ رُوحُو لِلَّهْ ضْحِيَّة مَا فِيهَا حَتَّى عِيبْ، بْرُوحْ مَوْجُودْ مِنْ أُوِّلْ الدِّنْيَا، مَالَا دَمُّو قَادِرْ يْطَهِّرْ ضْمَايِرْنَا مِالأَعْمَالْ الِّي تْهِزْ لِلْمُوتْ، بَاشْ انَّجْمُوا نِعْبْدُوا اللَّهْ الحَيْ.<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />هَاذَاكَا عْلَاشْ المَسِيحْ هُوَّ وَاسْطَة لْعَهْدْ جْدِيدْ، وبِيهْ النَّاسْ الِّي دْعَاهُمْ اللَّهْ وَلَّاوْ يْنَجْمُوا يَاخْذُوا الوَرْثَة الأَبَدِيَّة الِّي وْعِدْهُمْ بِيهَا. عْلَى خَاطْرُو مَاتْ بَاشْ يِفْدِي الشَّعْبْ مِالذْنُوبْ الِّي عَمْلُوهَا أَيَّامَاتْ العَهْدْ الأُوِّلْ.<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />كِي يْمُوتْ وَاحِدْ ويْخَلِّي وْصِيَّة، لَازِمْ نُثْبْتُوا الِّي هُوَّ مَاتْ. <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />عْلَى خَاطِرْ الوْصِيَّة مَا يْوَلِّي مَعْمُولْ بِيهَا كَانْ مَا يْمُوتْ مُولَاهَا، آمَا طُولْ مَا هُوَّ حَيْ مَا عَنْدْهَاشْ حَتَّى مَفْعُولْ. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />هَاذَاكَا عْلَاشْ حَتَّى العَهْدْ الأُوِّلْ زَادَا مَا وَلَّى مَعْمُولْ بِيهْ كَانْ بِالدَّمْ. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />عْلَى خَاطِرْ مُوسَى بَعْدْمَا قْرَى وْصَايَا الشَّرِيعَة الكُلْ لِلشَّعْبْ، خْذَا دَمْ عْجُولْ وبْرَاشِنْ ومْعَاهْ مَاء، وصُوفْ أَحْمَرْ وزُوفَا، ورَشْ بِيهُمْ كْتَابْ الشَّرِيعَة والشَّعْبْ الكُلْ. <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />وقَالْ: «هَاذَا هُوَّ دَمْ العَهْدْ الِّي وَصَّاكُمْ اللَّهْ بَاشْ إِطِّيعُوهْ». <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />وبْنَفْسْ الطَّرِيقَة، رَشْ مُوسَى الخِيمَة ومَاعُونْ العْبَادَة الِّي فِيهَا بِالدَّمْ. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />وحَسْبْ الشَّرِيعَة، حَتَّى شَيْ تَقْرِيبًا مَا يْوَلِّي طَاهِرْ كَانْ بِالدَّمْ، ومَا فَمَّة غُفْرَانْ كَانْ مَا يْسِيلْ الدَّمْ.<verse eid="HEB 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />إِذَا كَانْ الأُمُورْ الِّي تُرْمُزْ لِلْحَاجَاتْ الِّي فِي السْمَاء يِلْزِمْهَا تِطَّهِّرْ بِالطَّرِيقَة هَاذِي، مَالَا الحَاجَاتْ بِيدْهَا الِّي فِي السْمَاء يِلْزِمْهَا تِطَّهِّرْ بْذْبَايَحْ مَا خِيرْ. <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />عْلَى خَاطِرْ المَسِيحْ مَا دْخَلْشْ لْقُدْسْ الأَقْدَاسْ الِّي عَمْلُوهْ البَشَرْ ولِّي مَاهُو إِلَّا مِثَالْ لِلْحَقَيقِي، آمَا دْخَلْ لِلسْمَاء بِيدْهَا، بَاشْ يَاقِفْ قُدَّامْ اللَّهْ عْلَى خَاطِرْنَا. <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />وكَانْ الكَاهِنْ الكْبِيرْ يُدْخُلْ لْقُدْسْ الأَقْدَاسْ مَرَّة كُلْ عَامْ بْدَمْ مُشْ دَمُّو، آمَا المَسِيحْ مَا دْخَلْشْ بَاشْ يْقَدِّمْ رُوحُو ذْبِيحَة بَرْشَة مَرَّاتْ، <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />وَلَّا رَاهُو كَانْ لَازْمُو يِتْعَذَّبْ بَرْشَة مَرَّاتْ مِلِّي تْخَلْقِتْ الدِّنْيَا. آمَا تَوَّا ظْهُرْ مَرَّة وَحْدَة، فِي آخِرْ الزْمَانْ، بَاشْ يْنَحِّي الذْنُوبْ وَقْتِلِّي قَدِّمْ رُوحُو ذْبِيحَة لِلَّهْ. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />وكِيمَا البَشَرْ مْصِيرْهُمْ يْمُوتُوا مَرَّة وَحْدَة، ومْبَعِّدْ يِتْحَاسْبُوا، <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />المَسِيحْ زَادَا ضَحَّى بْرُوحُو مَرَّة وَحْدَة بَاشْ يْنَحِّي ذْنُوبْ بَرْشَة نَاسْ. وبِشْ يِرْجَعْ مَرَّة ثَانْيَة، مُشْ عْلَى خَاطِرْ الذْنُوبْ، آمَا بَاشْ يْنَجِّي الِّي يِسْتَنَّاوْ فِيهْ.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="s">ذْبِيحَة وَحْدَة عَالذْنُوبْ الكُلْ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />ومَادَامْ الشَّرِيعَة مَاهِي إِلَّا ظِلْ البَرَكَاتْ الِّي بِشْ تْجِي، ومَا تْمَثَّلْشْ حْقِيقِةْ البَرَكَاتْ هَاذِي، مَالَا مَا تْنَجَّمْشْ تْخَلِّي الِّي يِتْقَرْبُوا بِيهَا لِلَّهْ يْوَلِّيوْ كَامْلِينْ، بْتَقْدِيمْ نَفْسْ الذْبَايَحْ عَامْ بَعْدْ عَامْ. <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />وكَانْ جَاتْ تْنَجِّمْ، رَاهُمْ بَطْلُوا مَا عَادِشْ يْقَدْمُوهَا. وكَانْ جَاوْ الِّي يِعْبْدُوا اللَّهْ بِالطَّرِيقَة هَاذِي وَلَّاوْ طَاهْرِينْ بِالكَامِلْ، رَاهِي ضْمَايِرْهُمْ مَا عَادِشْ تْحِسْ بِالذَّنْبْ، ومَا عَادِشْ تِسْتْحَقْ بَاشْ تِطَّهِّرْ مَرَّة أُخْرَى. <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />آمَا فِي الحْقِيقَة، الذْبَايَحْ هَاذِيكَا تْذَكِّرْهُمْ بِذْنُوبْهُمْ عَامْ بَعْدْ عَامْ، <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />عْلَى خَاطِرْ دَمْ العْجُولْ والبْرَاشِنْ مُسْتَحِيلْ يْنَحِّي الذْنُوبْ.<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />هَاذَاكَا عْلَاشْ وَقْتِلِّي جَاء المَسِيحْ لِلْأَرْضْ هَاذِي قَالْ لِلَّهْ:</para>
  <para style="b" vid="HEB 10:5" />
  <para style="q1" vid="HEB 10:5">«إِنْتِ لَا حَبِّيتْ لَا عْلَى ذْبِيحَة ولَا عْلَى قُرْبَانْ،</para>
  <para style="q2" vid="HEB 10:5">آمَا حَضَّرْتْلِي بْدَنْ،<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />ولَا كُنْتْ تَرْضَى بِالقُرْبَانْ الِّي يِتْحْرَقْ،</para>
  <para style="q2" vid="HEB 10:6">ولَا بِالقُرْبَانْ الِّي يْكَفِّرْ عَالذْنُوبْ.<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />يَاخِي قُتْلِكْ: "هَانِي جِيتْ يَا اللَّهْ، بَاشْ نَعْمِلْ مَشِيئْتِكْ،</para>
  <para style="q2" vid="HEB 10:7">كِيمَا مَكْتُوبْ عْلِيَّا فِي الكْتَابْ"».<verse eid="HEB 10:7" /></para>
  <para style="b" />
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8" />مَالَا المَسِيحْ مِالأُوِّلْ قَالْ: «إِنْتِ لَا حَبِّيتْ لَا ذْبَايَحْ ولَا قْرَابِينْ، ولَا القُرْبَانْ الِّي يِتْحْرَقْ ولَا القُرْبَانْ الِّي يْكَفِّرْ عَالذْنُوبْ، ولَا رْضِيتْ بِيهُمْ»، رَغْمِلِّي كَانِتْ تِتْقَدِّمْ كِيمَا تْقُولْ الشَّرِيعَة. <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />ومْبَعِّدْ قَالْ: «هَانِي جِيتْ بَاشْ نَعْمِلْ مَشِيئْتِكْ»، وهَكَّا بَطِّلْ النِّظَامْ القْدِيمْ بَاشْ يْحُطْ النِّظَامْ الجْدِيدْ. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />وأَحْنَا تْقَدَّسْنَا، عْلَى خَاطِرْ يَسُوعْ المَسِيحْ عْمَلْ مَشِيئِةْ اللَّهْ كِي قَدِّمْ بَدْنُو ضْحِيَّة مَرَّة وَحْدَة.<verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />وقْبَلْ، كَانْ كُلْ كَاهِنْ يَاقِفْ بَاشْ يِخْدِمْ خِدْمْتُو يُومْ بَعْدْ يُومْ، ويْقَدِّمْ نَفْسْ الذْبَايَحْ مَرَّة بَعْدْ مَرَّة، رَغْمِلِّي هِيَّ مَا تْنَجِّمْشْ تْنَحِّي الذْنُوبْ. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />آمَا المَسِيحْ قَدِّمْ ذْبِيحَة مَرَّة وَحْدَة عَالذْنُوبْ الكُلْ، وقْعَدْ عْلَى يْمِينْ اللَّهْ لِلْأَبَدْ، <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />وهُوَّ تَوَّا يِسْتَنَّى حَتَّى لِينْ اللَّهْ يْحُطْلُو الأَعْدَاءْ مْتَاعُو تَحْتْ سَاقِيهْ. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />وبِضْحِيَّة وَحْدَة، رَدْ الِّي قَدِّسْهُمْ الكُلْ كَامْلِينْ لِلْأَبَدْ.<verse eid="HEB 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />والرُّوحْ القُدُسْ زَادَا يِشْهْدِلْنَا بِالحْقِيقَة هَاذِي ويْقُولْ فِي الأُوِّلْ:<verse eid="HEB 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />«هَاذَا هُوَّ العَهْدْ الِّي بِشْ نَعْمْلُو مْعَاهُمْ</para>
  <para style="q2" vid="HEB 10:16">بَعْدْ الأَيَّامَاتْ هَاذُوكُمْ، يْقُولْ الرَّبْ:</para>
  <para style="q1" vid="HEB 10:16">بِشْ نْحُطْ شَرِيعْتِي فِي قْلُوبْهُمْ،</para>
  <para style="q2" vid="HEB 10:16">ونِكْتِبْهَا فِي عْقُولْهُمْ».<verse eid="HEB 10:16" /></para>
  <para style="b" />
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17" />ومْبَعِّدْ يْقُولْ:</para>
  <para style="b" vid="HEB 10:17" />
  <para style="q1" vid="HEB 10:17">«ومَا عَادِشْ نِتْذَكِّرْ ذْنُوبْهُمْ وأَغْلَاطْهُمْ».<verse eid="HEB 10:17" /></para>
  <para style="b" />
  <para style="m">
    <verse number="18" style="v" sid="HEB 10:18" />وكِي تَبْدَى فَمَّة مَغْفْرَة لِلذْنُوبْ والأَغْلَاطْ هَاذُومَا الكُلْ، مَا عَادِشْ نِسْتْحَقُّوا ضْحِيَّة أُخْرَى.<verse eid="HEB 10:18" /></para>
  <para style="s">شِدُّوا صْحِيحْ فِي الرْجَى</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />هَاذَاكَا عْلَاشْ يَا خْوَاتِي، انَّجْمُوا نُدْخْلُوا بْثِيقَة لْقُدْسْ الأَقْدَاسْ بْدَمْ يَسُوعْ، <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />عْلَى خَاطْرُو حَلِّلْنَا طْرِيقْ جْدِيدْ وحَيْ، وَقْتِلِّي تْشَقْ الحْجَابْ، يَعْنِي بَدْنُو. <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />ومَادَامْ عَنْدْنَا كَاهِنْ عْظِيمْ مَسْؤُولْ عْلَى بِيتْ اللَّهْ، <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />خَلِّينَا نُقْرْبُوا لِلَّهْ بْقَلْبْ صَادِقْ وبْإِيمَانْ ثَابِتْ، بَعْدْمَا قْلُوبْنَا إِطَّهْرِتْ مِالإِحْسَاسْ بِالذَّنْبْ وبْدَنَّاتْنَا إِتْغَسْلِتْ بْمَاء طَاهِرْ. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />وخَلِّينَا نْشِدُّوا صْحِيحْ فِي الرْجَى الِّي نِعْتَرْفُوا بِيهْ، عْلَى خَاطِرْ اللَّهْ الِّي وْعِدْ هُوَّ أَمِينْ. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />ونْرُدُّوا بَالْنَا عْلَى بْعَضْنَا، ونْشَجْعُوا بْعَضْنَا عَالمْحَبَّة والأَعْمَالْ الصَّالْحَة. <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />ومَا نْبَطّْلُوشْ لَمِّتْنَا مْعَ بْعَضْنَا كِيمَا وَلَّاتْ عَادَة عَنْدْ جْمَاعَة. آمَا شَجْعُوا بْعَضْكُمْ، خَاصَّةً إِنْكُمْ تْشُوفُوا الِّي نْهَارْ رْجُوعْ الرَّبْ قْرُبْ.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />إِذَا كَانْ، بَعْدْمَا عْرَفْنَا الحَقْ، نُذْنْبُوا بِالعَانِي وأَحْنَا قَاصْدِينْ، رَاهِي مَا عَادِشْ فَمَّة ذْبِيحَة تْكَفِّرْ عَالذْنُوبْ، <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />آمَا بِشْ نَبْقَاوْ نِسْتَنَّاوْ بْخُوفْ نْهَارْ الحْسَابْ والنَّارْ الشَاعْلَة الِّي بِشْ تَاكِلْ العَاصِينْ. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />الِّي يْخَالِفْ شَرِيعِةْ مُوسَى، ويِشْهْدُوا عْلِيهْ زُوزْ وَلَّا ثْلَاثَة شْهُودْ، كَانْ يِتْقْتَلْ مِنْ غِيرْ رَحْمَة. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />مَالَا حَسْبْ رَايْكُمْ، قَدَّاشْ بِشْ يْكُونْ العِقَابْ أَقْوَى لِلِّي حْقَرْ إِبْنْ اللَّهْ، ومَا عْطَاشْ قِيمَة لْدَمْ العَهْدْ الِّي تْقَدِّسْ بِيهْ، وهَانْ رُوحْ النِّعْمَة؟ <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />أَحْنَا نَعْرْفُوا شْكُونْ الِّي قَالْ: «آنَا الِّي نِنْتَقِمْ، وآنَا الِّي نْجَازِي». وقَالْ زَادَا: «الرَّبْ بِشْ يُحْكُمْ عْلَى شَعْبُو». <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />يَا وِيلُو الِّي يْطِيحْ فِي يْدِينْ اللَّهْ الحَيْ!<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />تْذَكْرُوا الأَيَّامَاتْ الأُولَى مْتَاعْ إِيمَانْكُمْ، بَعْدْمَا تْنَوَّرْتُوا، قَدَّاشْ تْحَمَّلْتُوا تَجَارِبْ قْوِيَّة وصْعِيبَة، <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />مَرَّاتْ وَقْتِلِّي عَايْرُوكُمْ وعَذْبُوكُمْ قُدَّامْ النَّاسْ، ومَرَّاتْ وَقْتِلِّي وْقِفْتُوا مْعَ الِّي صَارْ مْعَاهُمْ نَفْسْ الشَّيْ. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />إِنْتُومَا شَارِكْتُوا المَرْبُوطِينْ وحَسِّيتُوا بِعْذَابْهُمْ، وقْبِلْتُوا إِنُّو تِتْفَكِّلْكُمْ أَمْلَاكُّمْ وإِنْتُومَا فَرْحَانِينْ، عْلَى خَاطِرْ كُنْتُوا تَعْرْفُوا الِّي عَنْدْكُمْ فِي السْمَاء أَمْلَاكْ أَحْسِنْ ومَا تِفْنَاشْ. <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />مَالَا مَا تْسَلْمُوشْ فِي ثِيقِتْكُمْ فِي الرَّبْ، رَاكُمْ بِشْ تَاخْذُوا عْلِيهَا جَايْزَة كْبِيرَة. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />إِنْتُومَا مِحْتَاجِينْ لِلصَّبْرْ بَاشْ تْنَجْمُوا تَعْمْلُوا مَشِيئِةْ اللَّهْ، وتَاخْذُوا الِّي وْعِدْكُمْ بِيهْ.<verse eid="HEB 10:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="HEB 10:37" />«مَزَّالْ شْوَيَّة وَقْتْ، شْوَيَّة بِالكُلْ،</para>
  <para style="q2" vid="HEB 10:37">ويْجِي الِّي وْعِدْ إِنُّو يْجِي، ومَاهُوشْ بِشْ يَبْطَى.<verse eid="HEB 10:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38" />الصَّالَحْ فِي عِينَيَّا يَحْيَا بِالإِيمَانْ،</para>
  <para style="q2" vid="HEB 10:38">آمَا كَانْ رْجَعْ بِالتْوَالِي، مَانِيشْ بِشْ نَرْضَى عَلِيهْ».<verse eid="HEB 10:38" /></para>
  <para style="b" />
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />آمَا أَحْنَا مَانَاشْ مِلِّي يِرْجْعُوا بِالتْوَالِي ويِمْشِيوْ لِلْهْلَاكْ، آمَا مِلِّي عَنْدْهُمْ الإِيمَانْ ويِنْجَاوْ.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s">بِالإِيمَانْ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />الإِيمَانْ هُوَّ الثِيقَة الِّي رْجَانَا بِشْ يِتْحَقَّقْ، والتَّصْدِيقْ إِنُّو الِّي مَانَاشْ نْشُوفُوا فِيهْ هُوَّ مَوْجُودْ بِالحَقْ. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />وبِالإِيمَانْ هَاذَا، رْضَى اللَّهْ عْلَى جْدُودْنَا. <verse eid="HEB 11:2" /><verse number="3" style="v" sid="HEB 11:3" />بِالإِيمَانْ نِفْهْمُوا الِّي الدِّنْيَا ومَا فِيهَا تْخَلْقِتْ بْكِلْمَة مِنْ عَنْدْ اللَّهْ، والحَاجَاتْ الِّي تِتْشَافْ تْوِجْدِتْ مِنْ حَاجَاتْ مَا تِتْشَافِشْ.<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />بِالإِيمَانْ قَدِّمْ هَابِيلْ لِلَّهْ ذْبِيحَة مَقْبُولَة أَكْثِرْ مِلِّي قَدِّمْهَا قَايِينْ. وعْلَى خَاطِرْ إِيمَانُو، قْبِلْ اللَّهْ ذْبِيحْتُو وشْهِدْلُو الِّي هُوَّ صَالَحْ. وبِالرَّغْمْ الِّي هُوَّ مَاتْ، مَزِّلْنَا نِتْعَلْمُوا مِنْ إِيمَانُو.<verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />بِالإِيمَانْ تِرْفَعْ أَخْنُوخْ مِنْ غِيرْ مَا شَافْ المُوتْ، ومَا لْقَاهْ حَدْ عَالأَرْضْ عْلَى خَاطِرْ اللَّهْ رَفْعُو لِيهْ. وقْبَلْ مَا يِتْرْفَعْ تِشْهِدْلُو الِّي هُوَّ رَضَّى اللَّهْ. <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />ومِنْ غِيرْ إِيمَانْ مُسْتَحِيلْ نْرَضِّيوْ اللَّهْ. عْلَى خَاطِرْ أَيْ وَاحِدْ يْحِبْ يِتْقَرِّبْلُو لَازْمُو يَمِّنْ الِّي هُوَّ مَوْجُودْ، وإِنُّو يْجَازِي الِّي يْلَوْجُوا عْلِيهْ.<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />بِالإِيمَانْ، نُوحْ وَقْتِلِّي نَبْهُو اللَّهْ لْحَاجَاتْ مَزَّالِتْ مَا تْشَافِتْشْ، خَافْ وبْنَى السْفِينَة بَاشْ يْمَنَّعْ عَايِلْتُو. وهَكَّا حْكُمْ عَالعَالِمْ، ووَلَّى وَارِثْ لِلصَّلَاحْ الِّي يْجِي بِالإِيمَانْ.<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />بِالإِيمَانْ، إِبْرَاهِيمْ وَقْتِلِّي اللَّهْ طْلَبْ مِنُّو بَاشْ يُخْرُجْ ويِمْشِي لِلْأَرْضْ الِّي كَانْ بِشْ يُورِثْهَا، طَاعْ وخْرَجْ وهُوَّ مَا يَعْرِفْشْ لْوِينْ مَاشِي. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />بِالإِيمَانْ عَاشْ فِي الأَرْضْ الِّي وِعْدُو بِيهَا اللَّهْ، كَايِنُّو غْرِيبْ فِي أَرْضْ غْرِيبَة. وسْكِنْ فِي خْيِمْ كِيمَا عَمْلُوا بَعْدُو إِسْحَاقْ ويَعْقُوبْ الِّي وَارْثِينْ نَفْسْ الوَعْدْ مْعَاهْ. <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />عْلَى خَاطْرُو كَانْ يِسْتَنَّى فِي المْدِينَة الِّي سَاسَاتْهَا ثَابْتَة، ولِّي مُهَنْدِسْهَا وبَانِيهَا هُوَّ اللَّهْ.<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />بِالإِيمَانْ، سَارَّة الِّي كَانِتْ مَا تْجِيبِشْ صْغَارْ وَلَّاتْ تْنَجِّمْ تِحْبِلْ، رَغْمِلِّي فَاتِتْ العْمُرْ الِّي تْنَجِّمْ تْجِيبْ فِيهْ، عْلَى خَاطِرْهَا أَمْنِتْ إِنُّو الِّي وْعِدْهَا أَمِينْ ومَا يِخْلِفِشْ بْوَعْدُو. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />وهَكَّا، مِنْ رَاجِلْ وَاحِدْ، كْبِيرْ بَرْشَة فِي العْمُرْ، جَاتْ ذُرِّيَّة كْبِيرَة قَدْ نْجُومْ السْمَاء، وقَدْ رْمَلْ البْحَرْ الِّي مَا يِتْعَدِّشْ.<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />وهَاذُومَا الكُلْ شَدُّو فِي إِيمَانْهُمْ حَتَّى الإِخِّرْ، ومَاتُوا مِنْ غِيرْ مَا خْذَاوْ الحَاجَاتْ الِّي اللَّهْ وْعِدْهُمْ بِيهَا، آمَا شَافُوهَا مِنْ بْعِيدْ، وصَدْقُوا الِّي هِيَّ بِشْ تِتْحَقِّقْ فِي المُسْتَقْبِلْ. وإِعْتَرْفُوا الِّي هُومَا كَانُوا بْرَايْنِيَّة وزُوَّارْ فِي الأَرْضْ هَاذِي. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />ولِّي يْقُولُوا هَاذَا، يْبَيْنُوا الِّي هُومَا يْلَوْجُوا عْلَى وَطَنْ حَقِيقِي. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />وكَانْ جَاوْ حَنُّوا لِلْوَطَنْ الِّي خَرْجُوا مِنُّو، رَاهُمْ رَجْعُولُو، عْلَى خَاطِرْ كَانِتْ عَنْدْهُمْ الفُرْصَة. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />آمَا هُومَا كَانُوا مِتْشَوْقِينْ لْوَطَنْ مَا خِيرْ، وَطَنْ سْمَاوِيْ. هَاذَاكَا عْلَاشْ اللَّهْ مَا يِحْشِمْشْ بْإِنُّو يِتْسَمَّى إِلَاهْهُمْ، عْلَى خَاطْرُو حَضْرِلْهُمْ مْدِينَة.<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />بِالإِيمَانْ، إِبْرَاهِيمْ وَقْتِلِّي إِمْتَحْنُو اللَّهْ قَدِّمْ إِسْحَاقْ ضْحِيَّة. وهُوَّ الِّي خْذَا الوَعْدْ، كَانْ مُسْتْعَدْ بَاشْ يْقَدِّمْ الوْلَيِّدْ الوَحِيدْ الِّي عَنْدُو، <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />رَغْمْ الِّي اللَّهْ قَالُّو: «بِشْ تْكُونْ عَنْدِكْ ذُرِّيَّة عْلَى طْرِيقْ إِسْحَاقْ». <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />إِبْرَاهِيمْ أَمَّنْ إِنُّو اللَّهْ يْنَجِّمْ يْقَيِّمْ المُوتَى. هَاذَاكَا عْلَاشْ اللَّهْ رَجَّعْلُو وِلْدُو إِسْحَاقْ، ولِّي صَارْ هَاذَا فِيهْ رَمْزْ.<verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />بِالإِيمَانْ، إِسْحَاقْ بَارِكْ يَعْقُوبْ وعِيسُو لْأُمُورْ بِشْ تَاقَعْ فِي المُسْتَقْبِلْ.<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />بِالإِيمَانْ، يَعْقُوبْ وَقْتِلِّي قْرِيبْ يْمُوتْ، بَارِكْ وْلَادْ يُوسِفْ الزُّوزْ، وسْجِدْ لِلَّهْ وهُوَّ سَانِدْ رُوحُو عْلَى رَاسْ عُكَّازُو.<verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />بِالإِيمَانْ، يُوسِفْ فِي آخِرْ أَيَّامَاتُو، حْكَى عْلَى خْرُوجْ بَنِي إِسْرَائِيلْ مِنْ مَصْرْ، ووَصَّاهُمْ آشْ يَعْمْلُوا بَعْظَامُو.<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />بِالإِيمَانْ، مُوسَى خَبَّاوِهْ أُمُّو وبُوهْ ثْلَاثَة شْهُرْ بَعْدْمَا تُولِدْ، عْلَى خَاطِرْ شَافُوا الِّي هُوَّ مِزْيَانْ، ومَا خَافُوشْ مِنْ أَمْرْ المَلِكْ.<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />بِالإِيمَانْ مُوسَى وَقْتِلِّي كْبِرْ مَا حَبِّشْ يِتْسَمَّى وِلْدْ بِنْتْ فَرْعُونْ، <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />وخَيِّرْ بَاشْ يِتْذَلْ مْعَ شَعْبْ اللَّهْ، عْلَى إِنُّو يِتْمَتَّعْ بْشِيخَاتْ الذْنُوبْ الِّي مَا تْدُومِشْ، <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />وحْسِبْ العَارْ الِّي يْعَانِي فِيهْ عْلَى خَاطِرْ المَسِيحْ ثَرْوَة أَعْظِمْ مِنْ كْنُوزْ مَصْرْ، عْلَى خَاطْرُو كَانْ حَاطِطْ عِينِيهْ عَالجَايْزَة الِّي بِشْ يَاخُذْهَا فِي المُسْتَقْبِلْ. <verse eid="HEB 11:26" /><verse number="27" style="v" sid="HEB 11:27" />بِالإِيمَانْ، مُوسَى خْرَجْ مِنْ مَصْرْ وهُوَّ مُشْ خَايِفْ مِنْ غَضَبْ المَلِكْ، وشَدْ صْحِيحْ وكَمِّلْ، كَايِنُّو يْشُوفْ فِي اللَّهْ الِّي مَا يْشُوفُو حَدْ. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />بِالإِيمَانْ، عْمَلْ الفِصْحْ ورَشْ الدَّمْ، بَاشْ مَلَاكْ المُوتْ مَا يْمِسْ حَتَّى بِكْرْ مِنْ وْلَادْ بَنِي إِسْرَائِيلْ.<verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />بِالإِيمَانْ، تْعَدَّاوْ بَنِي إِسْرَائِيلْ فِي البْحَرْ الأَحْمَرْ كَايِنْهُمْ يِمْشِيوْ فِي البَرْ، آمَا وَقْتِلِّي المَصْرِيِّينْ حَبُّوا يَعْمْلُوا كِيفْهُمْ غُرْقُوا.<verse eid="HEB 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30" />بِالإِيمَانْ، طَاحِتْ أَسْوَارْ أَرِيحَا بَعْدْمَا دَارُوا بِيهَا بَنِي إِسْرَائِيلْ سَبْعَة أَيَّامْ.<verse eid="HEB 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="HEB 11:31" />بِالإِيمَانْ، رَاحَابْ العَاهْرَة مَا مَاتِتْشْ مْعَ العَاصِينْ، عْلَى خَاطِرْهَا ضَيْفِتْ الزُّوزْ جَوَاسِيسْ.<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />وآشْ بِشْ نْقُولْ آخَرْ؟ الوَقْتْ مَا يِكْفِينِيشْ بَاشْ نَحْكِي عْلَى جِدْعُونْ وبَارَاقْ وشَمْشُونْ ويَفْتَاحْ ودَاوِدْ وصَمُوئِيلْ والأَنْبِيَاءْ، <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />الِّي بِالإِيمَانْ غِلْبُوا مَمَالِكْ، وحُكْمُوا بِالعَدْلْ، وخْذَاوْ الِّي اللَّهْ وْعِدْهُمْ بِيهْ، وسَكْرُوا أَفَّامْ الصْيُودَا، <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />وطَفَّاوْ قُوِّةْ النَّارْ، ونْجَاوْ مِالمُوتْ بِالسْيُوفَة. وتْقَوَّاوْ بَعْدْمَا كَانُوا ضْعَافْ ووَلَّاوْ أَبْطَالْ فِي الحَرْبْ، وغِلْبُوا جْيُوشْ البْرَايْنِيَّة. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />ونْسَاء رَجْعُولْهُمْ الِّي مَاتُولْهُمْ بَعْدْمَا قَامُوا مِالمُوتْ، ونَاسْ أُخْرِينْ قَاسَاوْ العْذَابْ حَتَّى لِلْمُوتْ ورَفْضُوا يْمَنْعُوا رْوَاحْهُمْ عْلَى خَاطِرْهُمْ يَعْرْفُوا إِنْهُمْ بِشْ يْقُومُوا لِحْيَاةْ مَا خِيرْ، <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />وغِيرْهُمْ عَانَاوْ مِالتْمَسْخِيرْ والجَلْدْ، وعَانَاوْ حَتَّى مِالرَّبْطَانْ بِالسْلَاسِلْ والحَبْسْ. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />مِنْهُمْ الِّي تْرَجْمُوا، ومِنْهُمْ الِّي قَصُّوهُمْ بِالمُنْشَارْ، ومِنْهُمْ الِّي تْقَتْلُوا بِالسْيُوفَا. وفَمَّة الِّي تْشَرْدُوا ولِبْسُوا جْلُودْ غْنَمْ ومْعِيزْ، وعَانَاوْ مِالحِرْمَانْ والقَهْرْ والظُّلْمْ. <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />والعَالِمْ مَا كَانِشْ يِسْتَاهِلْهُمْ. وكَانُوا هَايْمِينْ فِي الخْلَاء والجْبَالْ والمْغَاغِرْ ودْوَامِسْ الأَرْضْ.<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />وهَاذُومَا الكُلْ مَا وِصْلُوشْ خْذَاوْ الِّي وْعِدْهُمْ بِيهْ اللَّهْ، رَغْمِلِّي كَانْ مَشْهُودِلْهُمْ عْلَى إِيمَانْهُمْ، <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />عْلَى خَاطِرْ اللَّهْ حَضْرِلْنَا حَاجَة مَا خِيرْ، ومَا حَبْهُمْشْ يُوصْلُوا لِلْكَمَالْ مِنْ غِيرْنَا.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s">تَأْدِيبْ الرَّبْ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />هَاذَاكَا عْلَاشْ مَادَامْ عَنْدْنَا هَا العْدَدْ الكْبِيرْ مِالشْهُودْ الِّي دَايْرِينْ بِينَا، خَلِّينَا نَرْمِيوْ كُلْ حْمِلْ يْعَطَّلْنَا مِنْ إِنَّا نْقَدْمُوا، وكُلْ ذَنْبْ إِنَّجْمُو نْطِيحُوا فِيهْ بِسْهُولَة، وخَلِّينَا نِجْرِيوْ بْعَزِيمَة فِي السِّبَاقْ الِّي قُدَّامْنَا، <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />ونْرَكْزُوا عِينِينَا عْلَى يَسُوعْ، الِّي يْقُودْ إِيمَانَّا ويْوَصْلُو لِلْكَمَالْ، ولِّي عْلَى خَاطِرْ الفَرْحَة الِّي تِسْتَنَّى فِيهْ، تْحَمِّلْ الصَّلِيبْ ومَا هَمُّوشْ العَارْ، وقْعَدْ عْلَى يْمِينْ عَرْشْ اللَّهْ. <verse eid="HEB 12:2" /><verse number="3" style="v" sid="HEB 12:3" />فَكْرُوا فِلِّي تْحَمِّلْ كُلْ هَا العْدَاوَة مِالمُذْنْبِينْ، بَاشْ مَا تِفْشْلُوشْ ومَا تْأَيْسُوشْ.<verse eid="HEB 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 12:4" />إِنْتُومَا لْتَوَّا مَزِّلْتُوا مَا قَاوِمْتُوشْ حَتَّى لِينْ دَمْكُمْ يْسِيلْ فِي حَرْبْكُمْ ضِدْ الذْنُوبْ. <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />يَاخِي نْسِيتُوا كْلَامْ التَّشْجِيعْ الِّي يْكَلِّمْكُمْ بِيهْ اللَّهْ بْصِيفِتْكُمْ وْلَادُو وَقْتِلِّي يْقُولْ:</para>
  <para style="b" vid="HEB 12:5" />
  <para style="q1" vid="HEB 12:5">«يَا وِلْدِي، مَا تَحْقِرْشْ تَأْدِيبْ الرَّبْ،</para>
  <para style="q2" vid="HEB 12:5">ومَا تِفْشِلْشْ وَقْتِلِّي يْلُومْ عْلِيكْ،<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />رَاهُو الِّي يْحِبُّو الرَّبْ يْأَدْبُو،</para>
  <para style="q2" vid="HEB 12:6">ويْعَاقِبْ كُلْ وَاحِدْ يِحْسْبُو وِلْدُو».<verse eid="HEB 12:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />مَالَا تْحَمْلُوا التَّأْدِيبْ عْلَى خَاطِرْ اللَّهْ يْعَامِلْ فِيكُمْ كِيمَا وْلَادُو. وأَنَاهُو الوْلِدْ الِّي بُوهْ مَا يْأَدْبُوشْ؟ <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />إِذَا كَانْ اللَّهْ مَا يْأَدِّبْكُمْشْ كِيمَا يْأَدِّبْ أَوْلَادُو الكُلْ، مَعْنَاهَا إِنْتُومَا مَاكُمْشْ وْلَادُو بِالحَقْ. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />وزَادَا، أَحْنَا كُنَّا نِحْتَرْمُوا آبَاءْنَا الِّي مِنْ لْحَمْ ودَمْ وَقْتِلِّي أَدْبُونَا… مُشْ بِالأَوْلَى يِلْزِمْنَا نِخْضْعُوا لْبُونَا الرُّوحِي أَكْثِرْ، بَاشْ نَحْيَاوْ؟ <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />وهُومَا أَدْبُونَا مُدَّة قْصِيرَة وحَسْبْ مَا ظْهُرِّلْهُمْ، آمَا اللَّهْ يْأَدِّبْنَا لْمَصِلْحِتْنَا بَاشْ نْكُونُوا مْشَارْكِينُو فِي قَدَاسْتُو. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />وبِالطْبِيعَة كُلْ تَأْدِيبْ يُظْهُرْ مِالأُوِّلْ الِّي هُوَّ سْبَبْ حُزْنْ مُشْ فَرْحَة، آمَا فِي الإِخِّرْ يَعْطِي ثَمْرِةْ الصَّلَاحْ والسَّلَامْ فِي حْيَاةْ الِّي يِتْعَلْمُوا مِنُّو. <verse eid="HEB 12:11" /><verse number="12" style="v" sid="HEB 12:12" />هَاذَاكَا عْلَاشْ إِكْبْسُوا يْدِيكُمْ المِرْخِيَّة، ورْكَايِبْكُمْ التَّاعْبَة، <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />حَضْرُوا لْسَاقِيكُمْ ثْنَايَا مِسْتْوِيَّة، بَاشْ العَايِبْ مَا تْزِيدِشْ سَاقُو تِتْعَوِّجْ، آمَا يِتْشْفَى.<verse eid="HEB 12:13" /></para>
  <para style="s">أَبْقَاوْ ثَابْتِينْ</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />أَعْمْلُوا كُلْ مَا تْنَجْمُوا بَاشْ تْكُونُوا فِي سَلَامْ مْعَ النَّاسْ الكُلْ. وعِيشُوا حْيَاةْ القَدَاسَة، رَاهُو مِنْ غِيرْهَا مَا يْنَجِّمْ حَدْ يْشُوفْ الرَّبْ. <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />رُدُّوا بَالْكُمْ لَا وَاحِدْ مِنْكُمْ يِحْرِمْ رُوحُو مِنْ نِعْمِةْ اللَّهْ، بَاشْ مَا يِنْبِتْشْ عِرْقْ حِقْدْ فِي وِسْطْكُمْ، يِتْسَبِّبْ فِي مَشَاكِلْ، ويْنَجِّسْ بَرْشَة نَاسْ. <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />ورُدُّوا بَالْكُمْ لَا يْكُونْ وَاحِدْ فِيكُمْ زَانِي وَلَّا مُسْتَهْتِرْ كِيفْ عِيسُو الِّي عْلَى خَاطِرْ فْطُورْ وَاحِدْ، سَلِّمْ فِي بَرَكَاتْ البِكْرْ الِّي كَانِتْ مِنْ حَقُّو. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />وإِنْتُومَا تَعْرْفُوا الِّي مْبَعِّدْ وَقْتِلِّي حَبْ يُورِثْ البَرْكَة، تِرْفَضْ، رَغْمِلِّي طْلَبْهَا وهُوَّ يِبْكِي بِالدْمُوعْ، عْلَى خَاطِرْ مَا عَادِشْ عَنْدُو فُرْصَة يْصَلَّحْ بِيهَا الِّي عَمْلُو.<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />إِنْتُومَا مَا جِيتُوشْ لِجْبَلْ يْنَجِّمْ يِتْمَسْ، وِينْ فَمَّة نَارْ شَاعْلَة وظْلَامْ وضْبَابْ وعَاصْفَة، <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />وحِسْ بُوقْ، وصُوتْ يِتْكَلِّمْ، خَلَّى الِّي يِسْمْعُوا فِيهْ يُطْلْبُوا بَاشْ مَا عَادْ تِتْقَالِلْهُمْ حَتَّى كِلْمَة أُخْرَى. <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />عْلَى خَاطِرْهُمْ مَا نَجْمُوشْ يِتْحَمْلُوا الأَمْرْ الِّي تِعْطَالْهُمْ: «حَتَّى لَوْ حَيَوَانْ مَسْ الجْبَلْ، لَازِمْ يِتِرْجَمْ حَتَّى لِينْ يْمُوتْ». <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />والمَنْظِرْ كَانْ يِرْعِبْ لْدَرْجِةْ إِنُّو مُوسَى قَالْ: «آنَا نُرْعُشْ مِالخُوفْ».<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />آمَا إِنْتُومَا جِيتُوا لِجْبَلْ صِهْيَوْنْ، لِمْدِينِةْ اللَّهْ الحَيْ، أُورْشَلِيمْ الِّي فِي السْمَاء، ولْآلَافْ مِالمْلَايْكَة المَلْمُومِينْ والمُحْتَفْلِينْ، <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />جِيتُوا لْلَمِّةْ جْمَاعَة أَسَامِيهُمْ مَكْتُوبَة فِي السْمَاء، هُومَا أَوِّلْ المَوْلُودِينْ مِنْ اللَّهْ. جِيتُوا لِلَّهْ الِّي يُحْكُمْ عَالنَّاسْ الكُلْ، ولْأَرْوَاحْ النَّاسْ الِّي إِعْتَبِرْهُمْ اللَّهْ صَالْحِينْ الِّي وِصْلُوا لِلْكَمَالْ، <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />وجِيتُوا لْيَسُوعْ الِّي هُوَّ وَاسْطِةْ العَهْدْ الجْدِيدْ، ولْدَمُّو المَرْشُوشْ الِّي عْطَانَا غُفْرَانْ الذْنُوبْ، مُشْ كِيفْ دَمْ هَابِيلْ الِّي طْلَبْ الإِنْتِقَامْ.<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />مَالَا رُدُّوا بَالْكُمْ لَا تْسَكْرُوا وِذْنِيكُمْ عْلَى اللَّهْ الِّي يْكَلِّمْ فِيكُمْ. إِذَا كَانْ الِّي مَا حَبُّوشْ يِسْمْعُوا الِّي نَبَّهُّمْ فِي الأَرْضْ مَا مَنْعُوشْ مِالعِقَابْ، زَعْمَة بِشْ نَمْنْعُوا أَحْنَا كَانْ مَا سْمَعْنَاشْ الِّي يْنَبَّهْ فِينَا مِالسْمَاء؟ <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />وفِي الوَقْتْ هَاذَاكَا، صُوتُو زَلْزِلْ الأَرْضْ، آمَا تَوَّا وْعِدْ: «مَرَّة أُخْرَى، مَانِيشْ بِشْ نْزَلْزِلْ الأَرْضْ أَكَهَوْ، آمَا بَاشْ نْزَلْزِلْ السْمَاءْ زَادَا». <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />وكِي يْقُولْ «مَرَّة أُخْرَى»، يْوَرِّي إِنُّو الحَاجَاتْ المَخْلُوقَة بِشْ تِتْزَعْزَعْ ومَا عَادِشْ بِشْ تَبْقَى مَوْجُودَة، ومَا تَبْقَى مَا تِتْزَعْزَعْشْ كَانْ الحَاجَاتْ الثَّابْتَة. <verse eid="HEB 12:27" /><verse number="28" style="v" sid="HEB 12:28" />ومَادَامْ خْذِينَا مَمْلْكَة ثَابْتَة مَا تِتْزَعْزَعْشْ، يِلْزِمْنَا نُشْكْرُوا اللَّهْ، ونِعْبْدُوهْ بِالطَّرِيقَة الِّي تْرَضِّيهْ، بْكُلْ إِحْتِرَامْ وخُشُوعْ. <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />رَاهُو «إِلَاهْنَا نَارْ تَاكِلْ».<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s">وْصَايَا</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />حَافْظُوا عْلَى مْحَبِّتْكُمْ لِبْعَضْكُمْ بْصِيفِتْكُمْ إِخْوَة. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />ومَا تَنْسَاوِشْ تْضَيْفُوا النَّاسْ الغْرَابْ عْلِيكُمْ، رَاهُو فَمَّة شْكُونْ ضَيْفُوا مْلَايْكَة وهُومَا مَا فِي بَالْهُمْشْ. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />تْذَكْرُوا المَرْبُوطِينْ فِي الحَبْسْ كَايِنْكُمْ مَرْبُوطِينْ مْعَاهُمْ، والمْعَذْبِينْ كَايِنْكُمْ تِتْعَذْبُوا مْعَاهُمْ.<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />إِحْتَرْمُوا الحْيَاةْ الزَّوْجِيَّة، وخَلِّيوْ العَلَاقَة الزَّوْجِيَّة تْكُونْ طَاهْرَة، رَاهُو اللَّهْ بِشْ يُحْكُمْ عَالفُجَّارْ والزَّانِينْ. <verse eid="HEB 13:4" /><verse number="5" style="v" sid="HEB 13:5" />عِيشُوا بْعَادْ عْلَى مْحَبِّةْ الفْلُوسْ، وإِسْتَكْفَاوْ بِلِّي عَنْدْكُمْ. عْلَى خَاطِرْ اللَّهْ قَالْ: «عُمْرِي مَا نْهَمْلِكْ ولَا نْخَلِّيكْ». <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />عْلَى هَاذَاكَا انَّجْمُوا نْقُولُوا بْكُلْ ثِيقَة:</para>
  <para style="b" vid="HEB 13:6" />
  <para style="q1" vid="HEB 13:6">«الرَّبْ يْعَاوِنِّي، هَاذَاكَا عْلَاشْ مَا نْخَافِشْ.</para>
  <para style="q2" vid="HEB 13:6">شْنُوَّة يْنَجِّمْ يَعْمَلِّي البَشَرْ؟».<verse eid="HEB 13:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />تْذَكْرُوا قَادِتْكُمْ الِّي وَجْهُوكُمْ بْكِلْمِةْ اللَّهْ. شُوفُوا كِيفَاشْ عَاشُوا حْيَاتْهُمْ حَتَّى لِلِّخِّرْ، وخَلِّيوْ إِيمَانْهُمْ يْكُونْ مِثَالْ لِيكُمْ. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />يَسُوعْ المَسِيحْ هُوَّ هُوَّ، البَارِحْ واليُومْ ولِلْأَبَدْ. <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />رُدُّوا بَالْكُمْ لَا تِتْغَرُّوا وإِتَّبْعُوا أَيْ تَعْلِيمْ غْرِيبْ عَلِّي نَمْنُوا بِيهْ. رَاهُو بَاهِي كَانْ القَلْبْ يِتْقَوَّى بِالنِّعْمَة، مُشْ بِفْرَايِضْ تْخُصْ المَاكْلَة مَا نَفْعِتْشْ الِّي طَبْقُوهَا.<verse eid="HEB 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10" />أَحْنَا عَنْدْنَا مَذْبَحْ، والكَهَنَة الِّي يِخْدْمُوا فِي الخِيمَة الأَرْضِيَّة مَا عَنْدْهُمْشْ الحَقْ يَاكْلُوا مِالقَرَابِينْ الِّي تِتْقَدِّمْ فُوْقُو. <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />وكَانْ الكَاهِنْ الكْبِيرْ يُدْخُلْ بْدَمْ الحَيَوَانَاتْ لْقُدْسْ الأَقْدَاسْ ويْقَدْمُو قُرْبَانْ بَاشْ يْكَفِّرْ بِيهْ عَالذْنُوبْ، آمَا الحَيَوَانَاتْ بِيدْهَا كَانِتْ تِتْحْرَقْ لْبَرَّة مِالمُخَيِّمْ الِّي سَاكْنِينْ فِيهْ. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />هَاذَاكَا عْلَاشْ يَسُوعْ مَاتْ لْبَرَّة مِالمْدِينَة، بَاشْ يْقَدِّسْ الشَّعْبْ بْدَمُّو. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />مَالَا خَلِّينَا نُخْرْجُولُو لْبَرَّا مِالمُخَيِّمْ، ونِتْحَمْلُوا العَارْ مْعَاهْ. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />عْلَى خَاطِرْ مَا عَنْدْنَاشْ فِي الدِّنْيَا هَاذِي مْدِينَة دَايْمَة، آمَا نَسْعَاوْ لِلْمْدِينَة الِّي بِشْ تْجِي فِي المُسْتَقْبِلْ.<verse eid="HEB 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 13:15" />مَالَا خَلِّينَا نْقَدْمُوا فِي كُلْ وَقْتْ بِالمَسِيحْ ذْبِيحِةْ الحَمْدْ لِلَّهْ، الِّي هِيَّ تَسْبِيحْ يُنْطُقْ بِيهْ الفُمْ الِّي يَعْتَرِفْ بْإِسْمُو. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />مَا تَنْسَاوِشْ بَاشْ تَعْمْلُوا الخِيرْ، وتْعَاوْنُوا المُحْتَاجِينْ بِلِّي عَنْدْكُمْ، عْلَى خَاطِرْ الذْبَايَحْ الِّي كِيمَا هَاذِي تْرَضِّي اللَّهْ. <verse eid="HEB 13:16" /><verse number="17" style="v" sid="HEB 13:17" />طِيعُوا قَادِتْكُمْ وإِسْمْعُوا كْلَامْهُمْ، عْلَى خَاطِرْهُمْ لَاهِينْ بِحْيَاتْكُمْ الرُّوحِيَّة، ومَسْؤُولِينْ عْلِيهَا قُدَّامْ اللَّهْ. وهَكَّا يِخْدْمُوكُمْ وهُومَا فَرْحَانِينْ مُشْ مَهْمُومِينْ، مَا كَانِشْ رَاكُمْ إِنْتُومَا الخَاسْرِينْ.<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />إِدْعِيوْلْنَا، عْلَى خَاطِرْ أَحْنَا مِتْأَكْدِينْ الِّي ضَمِيرْنَا صَالَحْ، ونْحِبُّوا نِتْصَرْفُوا بِالڨْدَا فِي كُلْ شَيْ. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />وبِالأَخَصْ إِدْعِيوْلِي بَاشْ إِنَّجِّمْ نَرْجْعِلْكُمْ فِيسَعْ. <verse eid="HEB 13:19" /><verse number="20" style="v" sid="HEB 13:20" />وإِلَاهْ السَّلَامْ، الِّي قَيِّمْ مِالمُوتْ رَبْنَا يَسُوعْ، الِّي هُوَّ رَاعِي الغْنَمْ العْظِيمْ، ولِّي بْدَمُّو عْمَلْ عَهْدْ جْدِيدْ يَبْقَى لِلْأَبَدْ، <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />يْكَمِّلْكُمْ بْكُلْ مَاهُو صَالَحْ، بَاشْ تْنَجْمُوا تَعْمْلُوا مَشِيئْتُو ويَعْمِلْ فِينَا الِّي يْرَضِّيهْ بْيَسُوعْ المَسِيحْ الِّي لِيهْ المَجْدْ لِلْأَبَدْ. آمِينْ.<verse eid="HEB 13:21" /></para>
  <para style="s">خَاتْمَة</para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />نُطْلُبْ مِنْكُمْ يَا خْوَاتِي، بَاشْ تِتْقَبْلُوا كْلَامْ التَّشْجِيعْ هَاذَا، ورَانِي كْتِبْتْهُولْكُمْ بْإِخْتِصَارْ. <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />ونْحِبْ نِعْلِمْكُمْ الِّي خُونَا تِيمُوثَاوِسْ خْرَجْ مِالحَبْسْ. وكَانْ يْجِينِي عْلَى قْرِيبْ، تَوَّا نْزُورْكُمْ آنَا وَيَّاهْ.<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />سَلْمُوا عَالقَادَة مْتَاعْكُمْ وعَالقِدِّيسِينْ الكُلْ. يْسَلْمُوا عْلِيكُمْ خْوَاتْنَا الِّي مِنْ إِيطَالْيَا. <verse eid="HEB 13:24" /><verse number="25" style="v" sid="HEB 13:25" />النِّعْمَة مْعَاكُمْ الكُلْ.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>