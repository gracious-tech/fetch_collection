<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id" />
  <para style="h">أَفَسُسْ</para>
  <para style="toc1">رِسَالِةْ بُولِسْ لِلْمُؤْمْنِينْ الِّي فِي أَفَسُسْ</para>
  <para style="toc2">أَفَسُسْ</para>
  <para style="toc3">أَفَسُسْ</para>
  <para style="mt">رِسَالِةْ بُولِسْ لِلْمُؤْمْنِينْ الِّي فِي أَفَسُسْ</para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />مِنْ بُولِسْ رَسُولْ يَسُوعْ المَسِيحْ بْحَسْبْ قَصْدْ اللَّهْ، لِلْقِدِّيسِينْ الأُمَنَاءْ التَّابْعِينْ لْيَسُوعْ المَسِيحْ، السَّاكْنِينْ فِي أَفَسُسْ.<verse eid="EPH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2" />النِّعْمَة والسَّلَامْ لِيكُمْ مِنْ عَنْدْ اللَّهْ بُونَا والرَّبْ يَسُوعْ المَسِيحْ.<verse eid="EPH 1:2" /></para>
  <para style="s">بَرَكَاتْ اللَّهْ الِّي فِي المَسِيحْ</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />مُبَارَكْ اللَّهْ بُو رَبْنَا يَسُوعْ المَسِيحْ، الِّي بَارِكْنَا عْلَى طْرِيقْ المَسِيحْ بْكُلْ بَرْكَة رُوحِيَّة فِي السْمَاوَاتْ، <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />ولِّي إِخْتَارْنَا فِيهْ قْبَلْ مَا تِتْخْلَقْ الدِّنْيَا، بَاشْ نْكُونُوا قِدِّيسِينْ ومَا عْلِينَاشْ لُومْ قُدَّامُو فِي المْحَبَّة. <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />هُوَّ سْبَقْ وإِخْتَارْ يِتْبَنَّانَا فِي يَسُوعْ المَسِيحْ، حَسْبْ قَصْدُو الِّي يْرَضِّيهْ، <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />بَاشْ نَمْدْحُوا نِعْمْتُو المَجِيدَة، الِّي نْعِمْ بِيهَا عْلِينَا فِي إِبْنُو المَحْبُوبْ.<verse eid="EPH 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 1:7" />وبْدَمْ المَسِيحْ تِفْدِينَا وتْغَفْرِتْ ذْنُوبْنَا، وهَاذَا بْنِعْمِةْ اللَّهْ الغْنِيَّة، <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />الِّي فَاضْ بِيهَا عْلِينَا بْكُلْ مَا فِيهَا مِنْ حِكْمَة وفَهْمْ، <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />وبِالمَسِيحْ كْشِفِّلْنَا سِرْ خُطْتُو، الِّي هِيَّ بْحَسْبْ مَا يْرَضِّي قَلْبُو. <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />واللَّهْ بِشْ يْتَمِّمْ الخُطَّة هَاذِي فِي الوَقْتْ المُنَاسِبْ، وَقْتِلِّي يِجْمَعْ كُلْ شَيْ فِي السْمَاء وعَالأَرْضْ تَحْتْ سُلْطِةْ المَسِيحْ.<verse eid="EPH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11" />وفِي المَسِيحْ زَادَا خْذِينَا وَرْثَة، سْبَقْ اللَّهْ وكْتِبْهَالْنَا حَسْبْ قَصْدْ الِّي يَعْمِلْ كُلْ شَيْ كِيمَا يْحِبْ، <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />بَاشْ أَحْنَا الِّي سْبَقْ وحَطِّينَا رْجَانَا فِي المَسِيحْ نَمْدْحُوا مَجْدُو. <verse eid="EPH 1:12" /><verse number="13" style="v" sid="EPH 1:13" />وفِي المَسِيحْ إِنْتُومَا زَادَا، كِي سْمَعْتُوا كِلْمِةْ الحَقْ، البْشَارَة الِّي فِيهَا نْجَاتْكُمْ وأَمَّنْتُوا، حَطْ اللَّهْ عْلِيكُمْ طَابَعْ المِلْكِيَّة مْتَاعُو كِي عْطَاكُمْ الرُّوحْ القُدُسْ الِّي وْعِدْ بِيهْ. <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />الرُّوحْ القُدُسْ هُوَّ عَرْبُونْ وَرْثِتْنَا، حَتَّى لِينْ يْكَمِّلْ يِفْدِي شَعْبُو، وهَاذَا الكُلْ بَاشْ نَمْدْحُوا مَجْدُو.<verse eid="EPH 1:14" /></para>
  <para style="s">الشُّكْرْ عْلَى مُؤْمْنِينْ أَفَسُسْ</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />هَاذَاكَا عْلَاشْ آنَا كِي سْمَعْتْ بْإِيمَانْكُمْ بِالرَّبْ يَسُوعْ ومْحَبِّتْكُمْ لِلْقِدِّيسِينْ الكُلْ، <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />بْقِيتْ دِيمَا نُشْكُرْ فِي اللَّهْ عْلَى خَاطِرْكُمْ ونُذْكُرْكُمْ فِي صْلَاتِي، <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />ونُطْلُبْ مِنْ الآبْ المَجِيدْ، إِلَاهْ رَبْنَا يَسُوعْ المَسِيحْ، إِنُّو يَعْطِيكُمْ رُوحْ حِكْمَة يْنَوْرِلْكُمْ عْقُولْكُمْ وقْلُوبْكُمْ، بَاشْ تُوصْلُوا تَعْرْفُوهْ مَعْرْفَة كَامْلَة، <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />ويْحِلِّلْكُمْ قْلُوبْكُمْ بَاشْ تِفْهْمُوا الرْجَى الِّي دْعَاكُمْ لِيهْ، وتِفْهْمُوا قَدَّاشْ وَرْثِةْ القِدِّيسِينْ غْنِيَّة ومَجِيدَة، <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />وتِفْهْمُوا قَدَّاشْ عْظِيمَة قُوِّةْ اللَّهْ الِّي عْلَى ذِمِّتْنَا أَحْنَا المُؤْمْنِينْ، ولِّي هِيَّ قُدْرْتُو الهَايْلَة، <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />الِّي بِيهَا قَيِّمْ المَسِيحْ مِالمُوتْ وقَعْدُو عْلَى يْمِينُو فِي السْمَاوَاتْ، <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />فُوقْ كُلْ رِئَاسَة وسُلْطَة وقُوَّة وسْيَادَة وكُلْ إِسْمْ يِتْسَمَّى، مُشْ فِي الزْمَانْ هَاذَا بَرْكْ، آمَا فِي الآخْرَة زَادَا، <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />واللَّهْ حَطْ كُلْ شَيْ تَحْتْ سَاقِيهْ، وعْطَاهْ لِلْكْنِيسَة سِيدْ فُوقْ كُلْ شَيْ، <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />الكْنِيسَة الِّي هِيَّ بَدْنُو وكَمَالُو هُوَّ الِّي يْكَمِّلْ الكُلْ فِي كُلْ شَيْ.<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s">كُنْتُوا مُوتَى وحْيِيتُوا مْعَ المَسِيحْ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />وإِنْتُومَا قْبَلْ، كُنْتُوا مُوتَى بِسْبَبْ مْعَاصِيكُمْ وذْنُوبْكُمْ، <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />الِّي كُنْتُوا عَايْشِينْ فِيهَا بْحَسْبْ شْهَاوِي الدِّنْيَا هَاذِي، واتَّبْعُوا فِي رَئِيسْ قُوَّاتْ الشَّرْ الرُّوحِيَّة، مَعْنَاهَا الرُّوحْ الِّي يِتْحَكِّمْ تَوَّا فِي النَّاسْ الِّي مَا يْطِيعُوشْ اللَّهْ. <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />وأَحْنَا زَادَا كُنَّا مِالنَّاسْ الِّي تَبْعُوا شْهَاوِي وأَفْكَارْ طْبِيعِتْهُمْ البَشَرِيَّة الفَاسْدَة. وبِالطْبِيعَة هَاذِي الِّي فِينَا نِسْتَاهْلُوا غَضَبْ اللَّهْ كِيمَا بْقِيِّةْ النَّاسْ.<verse eid="EPH 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 2:4" />آمَا اللَّهْ الِّي رَحْمْتُو وَاسْعَة، وعْلَى خَاطِرْ مْحَبْتُو العْظِيمَة الِّي حَبْنَا بِيهَا، <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />حْيَانَا مْعَ المَسِيحْ بَعْدْمَا كُنَّا مُوتَى بِسْبَبْ ذْنُوبْنَا، رَاكُمْ بِالنِّعْمَة إِنْتُومَا نْجِيتُوا، <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />وقَوَّمْنَا مْعَاهْ وقَعَّدْنَا مْعَاهْ فِي السْمَاوَاتْ فِي يَسُوعْ المَسِيحْ، <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />بَاشْ يْظَهِّرْ فِي الأَجْيَالْ الجَايَة الكُلْ نِعْمْتُو العْظِيمَة الِّي بْلَاشْ حْدُودْ، كِي لْطُفْ بِينَا فِي يَسُوعْ المَسِيحْ.<verse eid="EPH 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EPH 2:8" />رَاكُمْ بِالنِّعْمَة نْجِيتُوا، بِالإِيمَانْ، وهَاذَا مُشْ بْمَجْهُودْكُمْ، آمَا هْدِيَّة مِنْ عَنْدْ اللَّهْ، <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />ومُشْ عْلَى أَسَاسْ الأَعْمَالْ، بَاشْ حَتَّى حَدْ مَا يِتْفُوخِرْ. <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />أَحْنَا مِنْ صُنْعْ اللَّهْ، وخْلَقْنَا فِي يَسُوعْ المَسِيحْ بَاشْ نْعِيشُوا وأَحْنَا نَعْمْلُوا فِي الأَعْمَالْ الصَّالْحَة الِّي حَضَّرْهُمْلْنَا مِنْ قْبَلْ.<verse eid="EPH 2:10" /></para>
  <para style="s">المُؤْمْنِينْ الكُلْ شَعْبْ وَاحِدْ فِي المَسِيحْ</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />مَالَا، اتْذَكْرُوا حَالِتْكُمْ قْبَلْ، إِنْتُومَا الِّي فِي الأَصْلْ مَاكُمْشْ يْهُودْ، ولِّي اليْهُودْ «المْطَهْرِينْ» يْعَيْطُولْكُمْ «يَلِّي مَاكُمْشْ مْطَهْرِينْ»، رَغْمِلِّي الطْهُورْ هَاذَا أَصْلًا مَعْمُولْ بِاليِدْ فِي البْدَنْ، <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />إِتْذَكْرُوا الِّي إِنْتُومَا وَقْتْهَا مَا كَانِتْ تُرْبُطْكُمْ حَتَّى عَلَاقَة بِالمَسِيحْ، مُشْ تَابْعِينْ بَنِي إِسْرَائِيلْ، ومَا عَنْدْكُمْشْ الحَقْ فِي وْعُودُو. وكُنْتُوا تْعِيشُوا فِي الدِّنْيَا هَاذِي مِنْ غِيرْ رْجَى، ومِنْ غِيرْ إِلَاهْ. <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />آمَا تَوَّا، فِي يَسُوعْ المَسِيحْ، إِنْتُومَا الِّي كُنْتُوا بْعَادْ وَلِّيتُوا قْرَابْ بْدَمْ المَسِيحْ. <verse eid="EPH 2:13" /><verse number="14" style="v" sid="EPH 2:14" />عْلَى خَاطْرُو هُوَّ سَلَامْنَا. وهُوَّ الِّي رَدْ الإِثْنِينْ شَعْبْ وَاحِدْ، وهَدْ حِيطْ العْدَاوَة الِّي كَانْ يُفْصُلْ بِينَاتْهُمْ. <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />بْمُوتُو، نَحَّى أَحْكَامْ وفْرَايِضْ الشَّرِيعَة، بَاشْ يَخْلَقْ مِنْهُمْ الإِثْنِينْ شَعْبْ وَاحِدْ جْدِيدْ تَابْعُو هُوَّ. وهَكَّا حَقَّقْ السَّلَامْ بِينَاتْهُمْ. <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />وبْمُوتُو عَالصَّلِيبْ زَادَا يْصَالَحْهُمْ الإِثْنِينْ مْعَ اللَّهْ ويْوَلِّيوْ بْدَنْ وَاحِدْ، ويَقْضِي عَالعْدَاوَة الِّي بِينَاتْهُمْ. <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />وجَاء وبَشِّرْ بْسَلَامْ لِيكُمْ إِنْتُومَا الِّي كُنْتُوا بْعَادْ، ولِّي كَانُوا قْرَابْ زَادَا. <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />وبِالمَسِيحْ وَلِّينَا الكُلْ انَّجْمُوا نُقْرْبُوا لِلْآبْ بْرُوحْ وَاحِدْ.<verse eid="EPH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />مَالَا إِنْتُومَا مَا عَادِشْ بْرَايْنِيَّة وَلَّا أَجَانِبْ، آمَا وَلِّيتُوا شَعْبْ وَاحِدْ مْعَ القِدِّيسِينْ وتَابْعِينْ عَايِلْةْ اللَّهْ، <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />مِبْنِيِّينْ عْلَى السَّاسْ الِّي حَطُّوهْ الرُّسُلْ والأَنْبِيَاءْ، ويَسُوعْ المَسِيحْ هُوَّ بِيدُو حَجْرِةْ السَّاسْ <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />الِّي بِيهْ البَنِيْ الكُلْ يْشِدْ فِي بَعْضُو، ويَعْلَى لِينْ يْوَلِّي هَيْكِلْ مُقَدَّسْ فِي الرَّبْ. <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />وبِيهْ إِنْتُومَا زَادَا تِبْنِيتُوا مْعَ بْعَضْكُمْ ووَلِّيتُوا بَنْيَة يُسْكُنْ فِيهَا اللَّهْ بِالرُّوحْ.<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s">بُولِسْ رَسُولْ لِلِّي مُشْ يْهُودْ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />هَاذَاكَا عْلَاشْ، آنَا بُولِسْ، المَرْبُوطْ عْلَى خَاطِرْ يَسُوعْ المَسِيحْ فِي صَالَحْكُمْ إِنْتُومَا الِّي مَاكُمْشْ يْهُودْ… <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />وأَكِيدْ رَاكُمْ سْمَعْتُوا الِّي اللَّهْ بْنِعْمْتُو عْطَانِي المَسْؤُولِيَّة هَاذِي لِيكُمْ، <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />وكِيفَاشْ بِالوَحْيْ كْشِفْلِي السِّرْ هَاذَا، كِيمَا كْتِبْتِلْكُمْ قْبَلْ بِإِخْتِصَارْ. <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />وكِي تَقْرَاوْ الِّي كْتِبْتُو، تِفْهْمُوا مَعْرِفْتِي الكْبِيرَة بْسِرْ المَسِيحْ. <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />السِّرْ هَاذَا، مَا كِشْفُوشْ اللَّهْ لْحَتَّى حَدْ فِي الأَجْيَالْ الِّي قْبَلْنَا، آمَا تَوَّا كِشْفُو بْرُوحُو لِلرُّسُلْ القِدِّيسِينْ والأَنْبِيَاءْ مْتَاعُو. <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />والسِّرْ هُوَّ إِنُّو بِالبْشَارَة، الِّي مَاهُمْشْ يْهُودْ وَلَّاوْ مْشَارْكِينْ اليْهُودْ فِي الوَرْثَة، وأَعْضَاءْ مْعَاهُمْ فِي بْدَنْ وَاحِدْ، وعَنْدْهُمْ الحَقْ يِسْتْفَادُوا بِالوَعْدْ، وهَاذَا الكُلْ فِي يَسُوعْ المَسِيحْ.<verse eid="EPH 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7" />وآنَا، بْنِعْمِةْ اللَّهْ الِّي عْطَاهَالِي بْقُدْرْتُو، وَلِّيتْ خَادِمْ لِلْبْشَارَة هَاذِي. <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />رَغْمِلِّي آنَا أَقَلْ وأَصْغِرْ وَاحِدْ فِي القِدِّيسِينْ، عْطَانِي اللَّهْ نِعْمَة بَاشْ نْبَشِّرْ الِّي مَاهُمْشْ يْهُودْ بْبَرَكَاتْ المَسِيحْ الغْنِيَّة الِّي مَا عَنْدْهَاشْ حْدُودْ، <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />ونْوَضَّحْ لِلنَّاسْ الكُلْ كِيفَاشْ اللَّهْ حَقَّقْ السِّرْ هَاذَا. عْلَى خَاطِرْ اللَّهْ الِّي خْلَقْ كُلْ شَيْ، خَلَّاهْ مَكْتُومْ مِنْ أُوِّلْ الدِّنْيَا. <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />وتَوَّا الحُكَّامْ والسْلَاطِينْ الِّي فِي السْمَاوَاتْ، يْنَجْمُوا يَعْرْفُوا حِكْمِةْ اللَّهْ المِتْنَوْعَة، عْلَى طْرِيقْ الكْنِيسَة، <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />وهَاذَا كَانْ قَصْدْ اللَّهْ مِنْ أُوِّلْ الزْمَانْ، ولِّي تَمْمُو فِي يَسُوعْ المَسِيحْ رَبْنَا. <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />وبْإِيمَانَّا بِالمَسِيحْ، وَلِّينَا انَّجْمُوا نُقْرْبُوا لِلَّهْ بْحُرِيَّة وبْثِيقَة. <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />هَاذَاكَا عْلَاشْ نُطْلُبْ مِنْكُمْ بَاشْ مَا تْأَيْسُوشْ بِسْبَبْ المَشَاكِلْ الِّي نْعَانِي فِيهَا عْلَى خَاطِرْكُمْ، رَاهِي لْمَجْدْكُمْ.<verse eid="EPH 3:13" /></para>
  <para style="s">بُولِسْ يُطْلُبْ قُوَّة لْمُؤْمْنِينْ أَفَسُسْ</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />وهَاذَاكَا عْلَاشْ نِرْكَعْ قُدَّامْ الآبْ، <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />الِّي تِتْسَمَّى عْلِيهْ كُلْ عَايْلَة فِي السْمَاء وفِي الأَرْضْ، <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />ونُطْلُبْ إِنُّو يَعْطِيكُمْ بْرُوحُو قُوَّة فِي نْفُوسْكُمْ مِنْ دَاخِلْ، حَسْبْ مَجْدُو الغْنِيْ، <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />وإِنُّو المَسِيحْ يُسْكُنْ فِي قْلُوبْكُمْ بِالإِيمَانْ، لِينْ تْوَلِّيوْ مَغْرُوسِينْ ومِبْنِييِّنْ فِي المْحَبَّة، <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />بَاشْ إِنْتُومَا وبْقِيِّةْ القِدِّيسِينْ تْكُونْ عَنْدْكُمْ القُدْرَة إِنْكُمْ تِفْهْمُوا شْنُوَّة هُوَّ العُرْضْ والطُّولْ والعِلْوْ والغُرْقْ مْتَاعْ مْحَبِّةْ المَسِيحْ، <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />وتَعْرْفُوا المْحَبَّة هَاذِي رَغْمِلِّي هِيَّ تْفُوتْ كُلْ مَعْرْفَة، وهَكَّا تِتْمْلَاوْ بْكُلْ كَمَالْ اللَّهْ.<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />هُوَّ بْقُدْرْتُو الِّي تِخْدِمْ فِينَا، يْنَجِّمْ يَعْمِلْ أَكْثِرْ بَرْشَة مِلِّي نُطُلْبُوا وَلَّا حَتَّى نِتْصَوْرُوا. <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />لِيهْ المَجْدْ فِي الكْنِيسَة وفِي يَسُوعْ المَسِيحْ، فِي كُلْ الأَجْيَالْ ولِلْأَبَدْ. آمِينْ.<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s">بْدَنْ المَسِيحْ يِكْبِرْ ويِتِبْنَى فِي المْحَبَّة</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />وآنَا المَرْبُوطْ عْلَى خَاطِرْ الرَّبْ، نْوَصِّيكُمْ بَاشْ تْعِيشُوا عِيشَة تْلِيقْ بِلِّي دْعَاكُمْ لِيهْ اللَّهْ، <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />بْكُلْ تَوَاضُعْ وسْيَاسَة ووِسْعْ بَالْ، مِسْتَحْمْلِينْ بْعَضْكُمْ بِمْحَبَّة. <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />أَعْمْلُوا مَجْهُودْ بَاشْ تُقْعْدُوا دِيمَا وَاحِدْ فِي الرُّوحْ، بِالسَّلَامْ الِّي يُرْبُطْكُمْ بِبْعَضْكُمْ. <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />عْلَى خَاطِرْ فَمَّة بْدَنْ وَاحِدْ ورُوحْ وَاحِدْ، كِيفْ مَا دْعَاكُمْ اللَّهْ لِرْجَى وَاحِدْ. <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />وفَمَّة رَبْ وَاحِدْ وإِيمَانْ وَاحِدْ ومَعْمُودِيَّة وَحْدَة <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />وإِلَاهْ وَاحِدْ، هُوَّ بُو النَّاسْ الكُلْ، وفُوقْ الكُلْ، ويِخْدِمْ فِي قْلُوبْهُمْ الكُلْ ويُسْكُنْ فِيهُمْ الكُلْ.<verse eid="EPH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7" />آمَا كُلْ وَاحِدْ مِنَّا خْذَا نِعْمَة عْلَى قَدْ مَا عْطَاهْ المَسِيحْ. <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />هَاذَاكَا عْلَاشْ يْقُولْ الكْتَابْ:</para>
  <para style="b" vid="EPH 4:8" />
  <para style="q1" vid="EPH 4:8">«وَقْتِلِّي طْلَعْ لِلسْمَاء،</para>
  <para style="q1" vid="EPH 4:8">هَزْ مَسْبِيِّينْ،</para>
  <para style="q1" vid="EPH 4:8">وعْطَى لِلنَّاسْ هِيبَاتْ».<verse eid="EPH 4:8" /></para>
  <para style="b" />
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9" />ومَادَامُو قَالْ «طْلَعْ» مَعْنَاهَا رَاهُو قْبَلْهَا هْبَطْ لْأَوطَى بْلَاصَة فِي الأَرْضْ. <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />وهَاذَا الِّي هْبَطْ، هُوَّ بِيدُو الِّي طْلَعْ فُوقْ السْمَاوَاتْ، بَاشْ يِمْلَا كُلْ شَيْ. <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />وهُوَّ الِّي عْطَى لِلنَّاسْ بَاشْ يْكُونُوا رُسُلْ، ونَاسْ أُخْرِينْ أَنْبِيَاءْ، وأُخْرِينْ مُبَشْرِينْ، وأُخْرِينْ يَرْعَاوْ النَّاسْ ويْعَلْمُوهُمْ. <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />وهَكَّا يْرُدْ المُؤْمْنِينْ قَادْرِينْ يْقُومُوا بِالخِدْمَة بَاشْ يِبْنِيوْ بْدَنْ المَسِيحْ، <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />لِينْ نْوَلِّيوْ الكُلْنَا وَاحِدْ فِي الإِيمَانْ ومَعْرْفَة إِبْنْ اللَّهْ، ونَوَلِّيوْ نَاضْجِينْ لْدَرْجِةْ الكَمَالْ المَوْجُودْ فِي المَسِيحْ، <verse eid="EPH 4:13" /><verse number="14" style="v" sid="EPH 4:14" />بَاشْ مَا نْكُونُوشْ كِيفْ الأَوْلَادْ الصْغَارْ الِّي هَازِّتْهُمْ الأَمْوَاجْ ويْمِيحُوا مْعَ كُلْ رِيحْ تَعْلِيمْ يْغُرْ بِالنَّاسْ، مِبْنِي عَالخُبْثْ والتَّحَيُّلْ. <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />آمَا بِالعَكْسْ، نْقُولُوا الحَقْ بِمْحَبَّة، وهَكَّا نِكْبْرُوا فِي كُلْ شَيْ ونْوَلِّيوْ كِيفْ المَسِيحْ، الِّي هُوَّ الرَّاسْ، <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />ولِّي بِيهْ البْدَنْ الكُلْ شَادِدْ فِي بَعْضُو وكُلْ عُضُوْ لَاحِمْ فِي الآخِرْ بِالمْفَاصِلْ. وكِي كُلْ عُضُوْ يِخْدِمْ خِدِمْتُو، يِكْبِرْ البْدَنْ ويِتْبْنَى فِي المْحَبَّة.<verse eid="EPH 4:16" /></para>
  <para style="s">الحَيَاةْ الجْدِيدَة فِي المَسِيحْ</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />هَاذَا الِّي نْقُولْهُولْكُمْ ونْلِحْ عْلِيهْ بْإِسْمْ الرَّبْ: إِنُّو مَا عَادِشْ تْعِيشُوا كِيفْ مَا يْعِيشُوا الِّي مَاهُمْشْ يْهُودْ بْأَفْكَارْ بَاطْلَة، <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />وعْقُولْ ظَلْمَة، وبْعَادْ عَالحَيَاةْ الِّي يَعْطِيهَا اللَّهْ، بِسْبَبْ جَهْلْهُمْ وقْسَاوِةْ قْلُوبْهُمْ. <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />وبِمَا إِنْهُمْ مَا عَادْ يْهِمْهُمْ فِي شَيْ، سَيْبُوا رْوَاحْهُمْ لْكُلْ أَنْوَاعْ الفْسَادْ والنْجَاسَة بْلَهْفَة مَا عَنْدْهَاشْ حْدُودْ.<verse eid="EPH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20" />آمَا إِنْتُومَا مُشْ هَاذَا الِّي تْعَلَّمْتُوهْ مِالمَسِيحْ، <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />هَاذَا كَانْ بِالحَقْ سْمَعْتُوهْ، وخْذِيتُوا تَعْلِيمْ يْوَافِقْ الحَقْ الِّي فِي يَسُوعْ. <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />مَالَا نَحِّيوْ عْلِيكُمْ العِيشَة الِّي كُنْتُوا تْعِيشُوا فِيهَا بْحَسْبْ الطْبِيعَة البَشَرِيَّة القْدِيمَة الِّي فِسْدِتْ بِالشْهَاوِي الخَدَّاعَة، <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />وخَلِّيوْ اللَّهْ يْجَدِّدْ الطَّرِيقَة الِّي تْفَكْرُوا بِيهَا فِي قْلُوبْكُمْ مِنْ دَاخِلْ، <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />وإِلْبْسُوا الطْبِيعَة الجْدِيدَة الِّي خْلَقْهَا اللَّهْ بَاشْ تْعِيشُوا عِيشِةْ الصَّلَاحْ والقَدَاسَة الِّي بْحَسْبْ الحَقْ.<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />مَالَا، بَطْلُوا الكِذْبْ، وتْكَلْمُوا مْعَ بْعَضْكُمْ بِالصِّدْقْ، عْلَى خَاطِرْنَا الكُلْ أَعْضَاءْ تَابْعِينْ بْعَضْنَا. <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />وكَانْ تْغَشَّشْتُوا مَا تَعْمْلُوشْ ذْنُوبْ، ومَا تْخَلِّيوِشْ الشَّمْسْ تُغْرُبْ وإِنْتُومَا مَزِّلْتُوا مِتْغَشِّينْ، <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />ومَا تَعْطِيوِشْ فُرْصَة لْإِبْلِيسْ. <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />والسَّارِقْ يْبَطِّلْ السِّرْقَة، ويِخْدِمْ بِيدِيهْ بْشَرَفْ ويِتْعِبْ، بَاشْ يْكُونْ عَنْدُو مَا يَعْطِي لِلْمِحْتَاجِينْ.<verse eid="EPH 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EPH 4:29" />مَا تْخَرْجُوشْ كِلْمَة خَايْبَة مِنْ أَفَّامْكُمْ، آمَا تْكَلْمُوا بِكْلَامْ بَاهِي يْقَوِّي الأُخْرِينْ حَسْبْ الحَاجَة، ويَعْطِي نِعْمَة لِلِّي يِسْمْعُوا. <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />ومَا تْحَزْنُوشْ رُوحْ اللَّهْ القُدُّوسْ، الِّي هُوَّ طَابَعْ المِلْكِيَّة الِّي حَطُّو اللَّهْ عْلِيكُمْ لِلنْهَارْ الِّي تِكْمِلْ فِيهْ الفِدْيَة. <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />نَحِّيوْ عْلِيكُمْ كُلْ حِقْدْ ونِقْمَة وغُشْ وعْيَاطْ وسَبَّانْ وكُلْ مَاهُو شَرْ. <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />وكُونُوا سِيْسِينْ مْعَ بْعَضْكُمْ وأَرْحْمُوا وسَامْحُوا بْعَضْكُمْ كِيمَا سَامَحْكُمْ اللَّهْ فِي المَسِيحْ.<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="s">عِيشُوا فِي النُّورْ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />خَلِّيوْ اللَّهْ يْكُونْ قُدْوِتْكُمْ مَادَامْكُمْ أَوْلَادُو المَحْبُوبِينْ، <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />وعِيشُوا فِي المْحَبَّة، كِيمَا حَبْنَا المَسِيحْ الِّي عْلَى خَاطِرْنَا سَلِّمْ رُوحُو قُرْبَانْ لِلَّهْ وذْبِيحَة رِيحِتْهَا طَيْبَة.<verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />آمَا الزْنَى وكُلْ أَنْوَاعْ النْجَاسَة والطْمَعْ، مَا تُذْكْرُوشْ حَتَّى إِسْمْهَا بِينَاتْكُمْ، عْلَى خَاطِرْهَا مَا تْلِيقِشْ بِالقِدِّيسِينْ، <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />وحَتَّى القْبَاحَة وكْلَامْ السْفَاهَة والتْمَسْخِيرْ، مَا يْلِيقِشْ بِيكُمْ، وفِي عُوضْ هَاذَا أُشْكْرُوا اللَّهْ. <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />وتْأَكْدُوا إِنُّو الزَّانِي والمَنْزُوسْ والطَّمَّاعْ، مَا عَنْدْهُمْشْ وِرْثْ فِي مَمْلَكْةْ المَسِيحْ واللَّهْ، عْلَى خَاطِرْ كِيفْهُمْ كِيفْ الِّي يِعْبِدْ فِي الصْنَبْ.<verse eid="EPH 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6" />مَا يْغُرْكُمْ حَدْ بِكْلَامْ بَاطِلْ، عْلَى خَاطِرْ الأُمُورْ هَاذِي تْخَلِّي اللَّهْ يَغْضِبْ عَالنَّاسْ الِّي مَا يْطِيعُوشْ. <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />مَا تْشَارْكُوهُمْشْ فِلِّي يَعْمْلُوا فِيهْ. <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />صْحِيحْ قْبَلْ كُنْتُوا تَابْعِينْ الظْلَامْ، آمَا تَوَّا وَلِّيتُوا نُورْ فِي الرَّبْ. مَالَا عِيشُوا كِيمَا يْلِيقْ بْأَوْلَادْ النُّورْ. <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />عْلَى خَاطِرْ النُّورْ يُثْمِرْ كُلْ مَاهُو خِيرْ وصَلَاحْ وحَقْ. <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />وهَكَّا تْوَلِّيوْ تَعْرْفُوا الأُمُورْ الِّي تْرَضِّي الرَّبْ. <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />مَا تْشَارْكُوشْ فِي أَعْمَالْ الظْلَامْ الِّي مَا عَنْدْهَا حَتَّى فَايْدَة آمَا بِالعَكْسْ أَفْضْحُوهَا. <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />عْلَى خَاطِرْ الِّي يَعْمْلُوا فِيهْ النَّاسْ هَاذُمْ فِي السِّرْ، يِحْشِمْ الوَاحِدْ حَتَّى بِشْ يَحْكِي عْلِيهْ. <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />آمَا كُلْ حَاجَة تُظْهُرْ عْلَى حْقِيقِتْهَا وَقْتِلِّي تِتْكْشِفْ لِلنُّورْ، <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />عْلَى خَاطِرْ النُّورْ هُوَّ الِّي يْظَهِّرْ كُلْ شَيْ. هَاذَاكَا عْلَاشْ يْقُولُوا:</para>
  <para style="b" vid="EPH 5:14" />
  <para style="q1" vid="EPH 5:14">«فِيقْ يَا رَاقِدْ،</para>
  <para style="q2" vid="EPH 5:14">وقُومْ مِنْ بِينْ المُوتَى،</para>
  <para style="q1" vid="EPH 5:14">بَاشْ يِضْوِي عْلِيكْ نُورْ المَسِيحْ».<verse eid="EPH 5:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />مَالَا رُدُّوا بَالْكُمْ مْلِيحْ فِي كُلْ حَاجَة تَعْمْلُوهَا، ومَا تْكُونُوشْ كِيفْ الِّي نَاقْصِينْ عْقَلْ، آمَا كُونُوا حُكَمَاءْ. <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />واسْتْغَلُّوا الوَقْتْ أَحْسِنْ إِسْتِغْلَالْ، عْلَى خَاطِرْ نْعِيشُوا فِي أَيَّامْ شِرِّيرَة. <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />هَاذَاكَا عْلَاشْ مَا تْكُونُوشْ قْلَالْ فَهْمْ، بِالعَكْسْ إِفْهْمُوا شْنُوَّة يْحِبْ الرَّبْ. <verse eid="EPH 5:17" /><verse number="18" style="v" sid="EPH 5:18" />ومَا تِسْكْرُوشْ بِالشْرَابْ، رَاهُو هَاذَا يْخَلِّيكُمْ إِدَّمْرُوا رْوَاحْكُمْ، آمَا تِمْلَاوْ بِالرُّوحْ <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />وأَحْكِيوْ مْعَ بْعَضْكُمْ بِالمَزَامِيرْ والتَّسَابِيحْ والأَنَاشِيدْ الرُّوحِيَّة وغَنِّيوْ وسَبْحُوا الرَّبْ مِنْ كُلْ قْلُوبْكُمْ <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />وأُشْكْرُوا اللَّهْ الآبْ فِي كُلْ وَقْتْ وعْلَى كُلْ شَيْ بْإِسْمْ رَبْنَا يَسُوعْ المَسِيحْ.<verse eid="EPH 5:20" /></para>
  <para style="s">العَايْلَة المَسِيحِيَّة</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21" />كُونُوا خَاضْعِينْ لِبْعَضْكُمْ مِنْ بَابْ الإِحْتِرَامْ لِلْمَسِيحْ <verse eid="EPH 5:21" /><verse number="22" style="v" sid="EPH 5:22" />والنْسَاء لِرْجَالْهُمْ كِيمَا لِلرَّبْ. <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />عْلَى خَاطِرْ الرَّاجِلْ هُوَّ رَاسْ المْرَا كِيمَا المَسِيحْ هُوَّ رَاسْ الكْنِيسَة، الِّي هِيَّ بَدْنُو وهُوَّ مُنَجِّيهَا. <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />وكِيفْ مَا تِخْضَعْ الكْنِيسَة لِلْمَسِيحْ، لَازِمْ النْسَاء زَادَا يِخْضْعُوا لِرْجَالْهُمْ فِي كُلْ شَيْ.<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25" />وإِنْتُومَا يَا رْجَالْ، حِبُّوا نْسَاكُمْ كِيمَا حَبْ المَسِيحْ الكْنِيسَة وضَحَّى بْرُوحُو عْلَى خَاطِرْهَا، <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />بَاشْ يْقَدِّسْهَا ويْطَهِّرْهَا بِالمَاء عْلَى طْرِيقْ كِلْمْتُو، <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />بَاشْ يْجِيبْهَا قُدَّامُو كْنِيسَة مْجِيدَة، لَا فِيهَا عْيُوبْ ولَا تَشْوِيهْ ومَا نَاقِصْهَا شَيْ، بِالعَكْسْ تْكُونْ مُقَدْسَة وبْلَاشْ عْيُوبْ. <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />وهَكَّا الرْجَالْ زَادَا يِلْزِمْهُمْ يْحِبُّوا نْسَاهُمْ كِيمَا يْحِبُّوا بْدَنَّاتْهُمْ. الِّي يْحِبْ مَرْتُو يْحِبْ رُوحُو. <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />عْلَى خَاطِرْ مَا فَمَّة حَتَّى حَدْ يَكْرَهْ بَدْنُو، بِالعَكْسْ يْوَكْلُو ويِتْلْهَى بِيهْ، كِيفْ مَا يَعْمِلْ المَسِيحْ مْعَ الكْنِيسَة، <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />بْإِعْتِبَارْهَا بَدْنُو وأَحْنَا الأَعْضَاءْ. <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" />«هَاذَاكَا عْلَاشْ الرَّاجِلْ يْخَلِّي بُوهْ وأُمُّو ويِتْرْبَطْ بْمَرْتُو ويْوَلِّيوْ الإِثْنِينْ بْدَنْ وَاحِدْ». <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />هَاذَا السِّرْ عْظِيمْ، ونُقْصُدْ سِرْ المَسِيحْ والكْنِيسَة. <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />آمَا إِنْتُومَا يِلْزِمْ كُلْ وَاحِدْ فِيكُمْ يْحِبْ مَرْتُو كِيمَا يْحِبْ رُوحُو والمْرَا يِلْزِمْهَا تْقَدِّرْ رَاجِلْهَا.<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s">الوَالْدِينْ والأَوْلَادْ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />يَا وْلَادْ، يِلْزِمْكُمْ إِطِّيعُوا وَالْدِيكُمْ عْلَى خَاطِرْ الرَّبْ، وهَاذَا هُوَّ الصْحِيحْ. <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />«إِكْرِمْ بُوكْ وأُمُّكْ»، هِيَّ أَوِّلْ وْصِيَّة جَاء مْعَاهَا وَعْدْ، ولِّي هُوَّ: <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />«بَاشْ تَلْقَى الخِيرْ ويْطُولْ عُمْرُكْ فِي الأَرْضْ».<verse eid="EPH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4" />وإِنْتُومَا يَا آبَاءْ، مَا تْغَزْلُوشْ أَوْلَادْكُمْ، آمَا رَبِّيوْهُمْ وأَنْصْحُوهُمْ حَسْبْ وْصَايَا الرَّبْ.<verse eid="EPH 6:4" /></para>
  <para style="s">العَبِيدْ والأَسْيَادْ</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />يَا عَبِيدْ، طِيعُوا أَسْيَادْكُمْ الِّي فِي الدِّنْيَا بِاحْتِرَامْ وخُوفْ وبْقَلْبْ صَادِقْ، كِيمَا إِطِّيعُوا المَسِيحْ. <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />وبِاعْتِبَارْكُمْ عَبِيدْ لِلْمَسِيحْ، إِخْدْمُوهُمْ بْكُلْ قْلُوبْكُمْ بَاشْ تْرَضِّيوْ اللَّهْ، مُشْ كَانْ كِي تِبْدَى العِينِينْ عْلِيكُمْ كَايِنْكُمْ تْرَضِّيوْ فِي النَّاسْ. <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />إِخْدْمُوهُمْ بْنِيَّة صَادْقَة كَايِنْكُمْ تِخْدْمُوا فِي الرَّبْ مُشْ فِي النَّاسْ. <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />وكِيمَا تَعْرْفُوا إِنُّو سِوَى كَانْ الإِنْسَانْ عَبْدْ وَلَّا حُرْ، الرَّبْ بِشْ يْجَازِيهْ خِيرْ عْلَى أَعْمَالُو الصَّالْحَة.<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />وإِنْتُومَا يَا أَسْيَادْ، عَامْلُوهُمْ بْنَفْسْ المَبَادِئْ ومَا تِسْتَعْمْلُوشْ مْعَاهُمْ التَّهْدِيدْ، وتْذَكْرُوا الِّي سِيدْكُمْ وسِيدْهُمْ مَوْجُودْ فِي السْمَاء، وهُوَّ مَا يْخَيِّرْ حَدْ عْلَى حَدْ.<verse eid="EPH 6:9" /></para>
  <para style="s">سْلَاحْ اللَّهْ الكَامِلْ</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />وفِي الإِخِّرْ يَا خْوَاتِي، تْقَوَّاوْ بِالرَّبْ وبْقُدْرْتُو العْظِيمَة. <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />وإِلْبْسُوا سْلَاحْ اللَّهْ الكَامِلْ، بَاشْ تْنَجْمُوا تْقَاوْمُوا خُطَطْ إِبْلِيسْ. <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />رَاهِي حَرْبْنَا مُشْ مْعَ بَشَرْ لْحَمْ ودَمْ، آمَا مْعَ حُكَّامْ وسْلَاطِينْ، مْعَ أَسْيَادْ عَالِمْ الظْلَامْ الِّي نْعِيشُوا فِيهْ، وضِدْ قُوَّاتْ الشَّرْ الرُّوحِيَّة الِّي فِي السْمَاوَاتْ. <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />هَاذَاكَا عْلَاشْ تْسَلْحُوا بِسْلَاحْ اللَّهْ الكَامِلْ، بَاشْ تْنَجْمُوا تْقَاوْمُوا نْهَارِةْ الِّي يْهَاجِمْكُمْ الشَّرْ، وبَعْدْمَا تَعْمْلُوا اللَّازِمْ الكُلْ إِثْبْتُوا لِلِّخِّرْ. <verse eid="EPH 6:13" /><verse number="14" style="v" sid="EPH 6:14" />مَالَا إِثْبْتُوا بَعْدْمَا تِتْحَزْمُوا بِحْزَامْ الحَقْ، وتِلْبْسُوا دِرْعْ الصَّلَاحْ عْلَى صْدُورْكُمْ. <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />وخَلِّيوْ سَاقِيكُمْ دِيمَا حَاضْرَة بَاشْ تِمْشِي تُنْشِرْ بْشَارِةْ السَّلَامْ. <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />وفِي الحَالَاتْ الكُلْ، هِزُّوا تُرْسْ الإِيمَانْ، بَاشْ تْنَجْمُوا تِطْفِيوْ بِيهْ سْهَامْ الشِّرِّيرْ الشَّاعْلَة. <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />وإِلْبْسُوا خَوْذِةْ النْجَاةْ فُوقْ رْيُوسْكُمْ، وتْسَلْحُوا بْسِيفْ الرُّوحْ الِّي هُوَّ كِلْمِةْ اللَّهْ. <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />وصَلِّيوْ بِالرُّوحْ فِي كُلْ وَقْتْ بْكُلْ أَنْوَاعْ الصَّلَوَاتْ والطِّلْبَاتْ، خَلِّيكُمْ مِتْيَقْضِينْ ودَاوْمُوا عْلَى هَاذَا، وإِدْعِيوْ لِلْقِدِّيسِينْ الكُلْ، <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />ولِيَّا آنَا زَادَا، بَاشْ كُلْ مَا نِتْكَلِّمْ يَعْطِينِي اللَّهْ الكْلَامْ اللَّازِمْ، بَاشْ إِنَّجِّمْ نَحْكِي بْشَجَاعَة عْلَى سِرْ البْشَارَة، <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />الِّي آنَا سَفِيرْهَا المَرْبُوطْ بِالسْلَاسِلْ. إِدْعِيوْلِي بَاشْ إِنَّجِّمْ نَحْكِي عْلِيهَا بْشَجَاعَة كِيمَا يِلْزِمْ.<verse eid="EPH 6:20" /></para>
  <para style="s">سْلَامْ</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />وبِالنِّسْبَة لْأَحْوَالِي وأَخْبَارْ خِدْمْتِي، تَوْ يَحْكِيلْكُمْ عْلِيهَا تِيخِيكُسْ، الخُو المَحْبُوبْ والخَادِمْ الأَمِينْ فِي الرَّبْ، <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />الِّي بْعَثْتْهُولْكُمْ بِالذِّمَة، بَاشْ يِعْلِمْكُمْ بْأَخْبَارْنَا ويْشَجَّعْكُمْ.<verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />سَلَامْ ومْحَبَّة وإِيمَانْ لِلْإِخْوَة، مِنْ عَنْدْ اللَّهْ الآبْ والرَّبْ يَسُوعْ المَسِيحْ. <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />نِعْمِةْ اللَّهْ تْكُونْ مْعَ الِّي يْحِبُّوا رَبْنَا يَسُوعْ المَسِيحْ مْحَبَّة مَا تِفْنَاشْ.<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>