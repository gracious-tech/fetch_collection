<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TH" style="id" />
  <para style="h">تْسَالُونِيكِي الثَّانْيَة</para>
  <para style="toc1">رِسَالِةْ بُولِسْ الثَّانْيَة لِلْمُؤْمْنِينْ الِّي فِي تْسَالُونِيكِي</para>
  <para style="toc2">تْسَالُونِيكِي الثَّانْيَة</para>
  <para style="toc3">تْسَالُونِيكِي الثَّانْيَة</para>
  <para style="mt">رِسَالِةْ بُولِسْ الثَّانْيَة لِلْمُؤْمْنِينْ الِّي فِي تْسَالُونِيكِي</para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1" />مِنْ بُولِسْ وسِلْوَانُسْ وتِيمُوثَاوُسْ لِكْنِيسِةْ تْسَالُونِيكِي، المُؤْمْنِينْ بِاللَّهْ بُونَا وبِالرَّبْ يَسُوعْ المَسِيحْ.<verse eid="2TH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2" />النِّعْمَة والسَّلَامْ لِيكُمْ مِنْ اللَّهْ بُونَا ومِالرَّبْ يَسُوعْ المَسِيحْ.<verse eid="2TH 1:2" /></para>
  <para style="s">شُكْرْ وتَشْجِيعْ</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />يَا خْوَاتْنَا، لَازِمْ نُشْكْرُوا اللَّهْ دِيمَا عْلَى خَاطِرْكُمْ. وهَاذَا حَقْ، عْلَى خَاطِرْ إِيمَانْكُمْ قَاعِدْ يِكْبِرْ بَرْشَة، ومْحَبِّتْكُمْ لِبْعَضْكُمْ قَاعْدَة تْزِيدْ، <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />حَتَّى وَلِّينَا نِتْفَخْرُوا بِيكُمْ فِي كْنَايِسْ اللَّهْ عْلَى صَبْرْكُمْ وإِيمَانْكُمْ فِي الإِضْطِهَادَاتْ والأَوْقَاتْ الصْعِيبَة.<verse eid="2TH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5" />وهَاذَا يْدُلْ إِنُّو اللَّهْ حْكُمْ بِالعَدْلْ، وهَكَّا تْكُونُوا تِسْتَاهْلُوا مَمْلِكْةْ اللَّهْ الِّي قَاعْدِينْ تِتْعَذْبُوا عْلَى خَاطِرْهَا. <verse eid="2TH 1:5" /><verse number="6" style="v" sid="2TH 1:6" />وبِمَا إِنُّو اللَّهْ عَادِلْ بِشْ يْضَيِّقْ عَالنَّاسْ الِّي يْضَيْقُوا عْلِيكُمْ، <verse eid="2TH 1:6" /><verse number="7" style="v" sid="2TH 1:7" />وبِشْ يَعْطِيكُمْ إِنْتُومَا الِّي قَاعْدِينْ تِتْعَذْبُوا ولِينَا أَحْنَا زَادَا رَاحَة، وَقْتِلِّي يِرْجَعْ الرَّبْ يَسُوعْ مِالسْمَاء مْعَ مْلَايِكْتُو القْوِيِّينْ <verse eid="2TH 1:7" /><verse number="8" style="v" sid="2TH 1:8" />فِي وِسْطْ نَارْ شَاعْلَة، بَاشْ يْعَاقِبْ الِّي مَا يْحِبُّوشْ يَعْرْفُوا اللَّهْ، ولِّي مَا يْطِيعُوشْ بْشَارِةْ رَبْنَا يَسُوعْ. <verse eid="2TH 1:8" /><verse number="9" style="v" sid="2TH 1:9" />وعِقَابْهُمْ هُوَّ الهْلَاكْ لِلْأَبَدْ، بْعَادْ عْلَى وِجْهْ الرَّبْ وعْلَى مَجْدْ قُوْتُو. <verse eid="2TH 1:9" /><verse number="10" style="v" sid="2TH 1:10" />وهَاذَا بِشْ يْصِيرْ وَقْتِلِّي يْجِي الرَّبْ فِي النْهَارْ هَاذَاكَا بَاشْ القِدِّيسِينْ مْتَاعُو يْمَجْدُوهْ، ويِنْبَهْرُوا بِيهْ الِّي أَمْنُوا بِيهْ، ومْعَاهُمْ إِنْتُومَا زَادَا، عْلَى خَاطِرْكُمْ صَدِّقْتُوا شْهَادِتْنَا.<verse eid="2TH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11" />هَاذَاكَا عْلَاشْ نِدْعِيوِلْكُمْ فِي كُلْ وَقْتْ، طَالْبِينْ مِنْ إِلَاهْنَا بَاشْ يْرُدْكُمْ تِسْتَاهْلُوا الِّي دْعَاكُمْ لِيهْ، وإِنُّو يْتَمِّمْ بْقُوْتُو كُلْ الحَاجَاتْ الصَّالْحَة الِّي تْحِبُّوا عْلِيهَا وكُلْ الِّي تَعْمْلُوا فِيهْ بِالإِيمَانْ، <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" />بَاشْ يِتْمَجِّدْ إِسْمْ رَبْنَا يَسُوعْ فِيكُمْ، وإِنْتُومَا تِتْمَجْدُوا فِيهْ، بْنِعْمَةْ إِلَاهْنَا والرَّبْ يَسُوعْ المَسِيحْ.<verse eid="2TH 1:12" /></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="s">آشْ بِشْ يْصِيرْ قْبَلْ مَا يِرْجَعْ الرَّبْ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />آمَا فِي مَا يْخُصْ رْجُوعْ رَبْنَا يَسُوعْ المَسِيحْ الِّي بِشْ يَجْمَعْنَا بِيهْ، نُطْلْبُوا مِنْكُمْ يَا إِخْوَة <verse eid="2TH 2:1" /><verse number="2" style="v" sid="2TH 2:2" />بَاشْ مَا تُدْخْلُوشْ بْعَضْكُمْ فِيسَعْ ومَا تِتْرِعْبُوشْ مِنْ حَتَّى نُبُوَّةْ ولَا كِلْمَة ولَا رِسَالَة نِسْبُوهَا لِينَا تْقُولْ إِنُّو النْهَارْ الِّي يِرْجَعْ فِيهْ الرَّبْ جَاء. <verse eid="2TH 2:2" /><verse number="3" style="v" sid="2TH 2:3" />مَا تْخَلِّيوْ حَتَّى حَدْ يْغَلِّطْكُمْ بْأَيْ طَرِيقَة! رَاهُو النْهَارْ الِّي يِرْجَعْ فِيهْ الرَّبْ مَا يْجِي كَانْ بَعْدْمَا النَّاسْ يُرْفْضُوا اللَّهْ، ويُظْهُرْ الشَّخْصْ الِّي يِتْجَسِّدْ فِيهْ الشَّرْ الكُلْ، ولِّي مْصِيرُو الهْلَاكْ، <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" />هُوَّ العْدُوْ الِّي بِشْ يْحُطْ رُوحُو فُوقْ كُلْ مَا يِتْسَمَّى إِلَاهْ وكُلْ مَا هُوَّ مَعْبُودْ، حَتَّى إِنُّو يُقْعُدْ فِي هَيْكِلْ اللَّهْ، ويْقُولْ الِّي هُوَّ اللَّهْ نَفْسُو.<verse eid="2TH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5" />يَاخِي مَا تِتْذَكْرُوشْ إِنِّي قُلْتِلْكُمْ هَاذَا بَرْشَة مَرَّاتْ وَقْتِلِّي كُنْتْ عَنْدْكُمْ؟ <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />وإِنْتُومَا تَعْرْفُوا شْنُوَّة الِّي شَادُّو تَوَّا، بَاشْ مَا يُظْهُرْ كَانْ مَا يْجِي وَقْتُو. <verse eid="2TH 2:6" /><verse number="7" style="v" sid="2TH 2:7" />وقُوِّةْ الشَّرْ قَاعْدَة تِخْدِمْ تَوَّا فِي السِّرْ، عْلَى خَاطِرْ فَمَّة حَاجِزْ مَانِعْهَا، آمَا وَقْتِلِّي الحَاجِزْ هَاذَا يِتْنَّحَى، <verse eid="2TH 2:7" /><verse number="8" style="v" sid="2TH 2:8" />يِتْكْشِفْ الشَّخْصْ الِّي يِتْجَسِّدْ فِيهْ الشَّرْ الكُلْ، والرَّبْ يَسُوعْ يَقْضِي عْلِيهْ بْنَفْخَة مِنْ فُمُّو ويِمْحِيهْ بْظْهُورُو المَجِيدْ.<verse eid="2TH 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2TH 2:9" />والشِّرِّيرْ هَاذَا يْجِي بْقُوَّة مِالشِّيطَانْ، ويَعْمِلْ مُعْجْزَاتْ وعَلَامَاتْ وعْجَايِبْ مَاهُمْشْ بِالحَقْ، <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />ويِسْتَعْمِلْ كُلْ أَنْوَاعْ الشَّرْ بَاشْ يْغَلِّطْ الِّي مْصِيرْهُمْ الهْلَاكْ، عْلَى خَاطِرْهُمْ مَا قِبْلُوشْ ومَا حَبُّوشْ الحَقْ الِّي يْنَجِّيهُمْ. <verse eid="2TH 2:10" /><verse number="11" style="v" sid="2TH 2:11" />هَاذَاكَا عْلَاشْ اللَّهْ يْغَرِّقْهُمْ فِي الضْلَالْ، حَتَّى يْوَلِّيوْ يْصَدْقُوا الكِذْبْ، <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />ويُحْكُمْ عْلَى كُلْ الِّي مَا أَمْنُوشْ بِالحَقْ وفَرْحُوا بِالشَّرْ.<verse eid="2TH 2:12" /></para>
  <para style="s">إِثْبْتُوا فِي الإِيمَانْ</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />آمَا أَحْنَا يَا خْوَاتِي الِّي يْحِبْهُمْ الرَّبْ، يِلْزِمْنَا نُشْكْرُوا اللَّهْ فِي كُلْ وَقْتْ عْلَى خَاطِرْكُمْ، عْلَى خَاطْرُو إِخْتَارْكُمْ مِالأُوِّلْ بَاشْ تِنْجَاوْ بِالرُّوحْ الِّي يْقَدِّسْكُمْ وبْإِيمَانْكُمْ بِالحَقْ. <verse eid="2TH 2:13" /><verse number="14" style="v" sid="2TH 2:14" />وهُوَّ دْعَاكُمْ لْهَاذَا بِالبْشَارَة الِّي وَصِّلْنَاهَالْكُمْ، بَاشْ تْكُونُوا مْشَارْكِينْ فِي مَجْدْ رَبْنَا يَسُوعْ المَسِيحْ. <verse eid="2TH 2:14" /><verse number="15" style="v" sid="2TH 2:15" />مَالَا إِثْبْتُوا يَا خْوَاتِي، وحَافْظُوا عْلَى الوْصَايَا الِّي عَلَّمْنَاهَالْكُمْ، سِوَى قُلْنَاهَا وَلَّا كْتِبْنَاهَا فِي رِسَالَة.<verse eid="2TH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16" />ونُطْلْبُوا مِنْ رَبْنَا يَسُوعْ المَسِيحْ بِيدُو، واللَّهْ بُونَا الِّي حَبْنَا ونْعِمْ عْلِينَا بْتَشْجِيعْ أَبَدِي وبِرْجَى أَكِيدْ، <verse eid="2TH 2:16" /><verse number="17" style="v" sid="2TH 2:17" />بَاشْ يْشَجْعُوا قْلُوبْكُمْ ويْثَبْتُوكُمْ بَاشْ دِيمَا تْقُولُوا وتَعْمْلُوا كُلْ مَا هُوَّ صَالَحْ.<verse eid="2TH 2:17" /></para>
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="s">إِدْعِيوْلْنَا</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />وفِي الإِخِّرْ، يَا خْوَاتِي، إِدْعِيوْلْنَا بَاشْ كِلْمِةْ الرَّبْ تِتَعْرَفْ فِيسَعْ وتِتْكَرِّمْ كِيفْ مَا صَارْ عَنْدْكُمْ، <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />وزَادَا بَاشْ اللَّهْ يْنَجِّينَا مِالنَّاسْ الضَّالِّينْ الأَشْرَارْ، عْلَى خَاطِرْ مُشْ النَّاسْ الكُلْ عَنْدْهُمْ إِيمَانْ. <verse eid="2TH 3:2" /><verse number="3" style="v" sid="2TH 3:3" />آمَا الرَّبْ أَمِينْ، وهُوَّ بِشْ يْقَوِّيكُمْ ويَحْفِظْكُمْ مِالشِّرِّيرْ. <verse eid="2TH 3:3" /><verse number="4" style="v" sid="2TH 3:4" />وعَنْدْنَا ثِيقَة فِي الرَّبْ الِّي إِنْتُومَا قَاعْدِينْ تَعْمْلُوا، وبِشْ تُقْعْدُوا تَعْمْلُوا الِّي وَصِّينَاكُمْ بِيهْ. <verse eid="2TH 3:4" /><verse number="5" style="v" sid="2TH 3:5" />ونُطْلْبُوا مِالرَّبْ بِشْ يِهْدِي قْلُوبْكُمْ لِمْحَبَّةْ اللَّهْ ولْصَبْرْ المَسِيحْ.<verse eid="2TH 3:5" /></para>
  <para style="s">بُولِسْ يْنَبَّهْ عَالبُخْلِيِّينْ</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />يَا خْوَاتْنَا، نْوَصِّيوْكُمْ، بْإِسْمْ رَبْنَا يَسُوعْ المَسِيحْ، بَاشْ تِتْجَنْبُوا كُلْ خُو مَا يْحِبِّشْ يِخْدِمْ عْلَى رُوحُو ومُشْ قَاعِدْ يْعِيشْ بْحَسْبْ التَعْلِيمْ الِّي عَلِّمْنَاهُولْكُمْ. <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />إِنْتُومَا تَعْرْفُوا كِيفَاشْ يِلْزِمْكُمْ تِعْتَبْرُونَا قُدْوَة. وأَحْنَا مَا كُنَّاشْ بَطَّالَة وَقْتِلِّي كُنَّا مْعَاكُمْ، <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />ومَا كْلِينَاشْ الخُبْزْ بْلَاشْ مِنْ عَنْدْ حَدْ، آمَا خْدِمْنَا لِيلْ ونْهَارْ وتْعِبْنَا وشْقِينَا بَاشْ مَا نْثَقْلُوشْ عْلَى حَتَّى وَاحِدْ فِيكُمْ. <verse eid="2TH 3:8" /><verse number="9" style="v" sid="2TH 3:9" />مُشْ عْلَى خَاطِرْ مَا عَنْدْنَاشْ الحَقْ بَاشْ تْعَاوْنُونَا، آمَا بَاشْ نْكُونُوا قُدْوَة لِيكُمْ ومِثَالْ إِتَّبْعُوهْ. <verse eid="2TH 3:9" /><verse number="10" style="v" sid="2TH 3:10" />ووَقْتِلِّي كُنَّا بَحْذَاكُمْ عْطِينَاكُمْ الوْصِيَّة هَاذِي: «الِّي مَا يْحِبِّشْ يِخْدِمْ، مَالَا خَلِّيهْ زَادَا مَا يَاكِلْشْ».<verse eid="2TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11" />عْلَى خَاطِرْ سْمَعْنَا الِّي فَمَّة بِينَاتْكُمْ جْمَاعَة بُخْلِيِّينْ مَا يِخْدْمُوشْ، آمَا يِدَّخْلُوا فِي أُمُورْ غِيرْهُمْ. <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />النَّاسْ هَاذُومَا نْوَصِّيوْهُمْ ونُطْلْبُوا مِنْهُمْ بْسُلْطِةْ الرَّبْ يَسُوعْ المَسِيحْ، بَاشْ يِخْدْمُوا بِرْيَاضْ، ويِكْسْبُوا رِزْقْهُمْ بِعْرَقْ جْبِينْهُمْ.<verse eid="2TH 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 3:13" />آمَا إِنْتُومَا، يَا خْوَاتِي، مَا تْمِلُّوشْ مِنْ فِعْلْ الخِيرْ. <verse eid="2TH 3:13" /><verse number="14" style="v" sid="2TH 3:14" />وكَانْ فَمَّة شْكُونْ مَا يْطِيعِشْ الِّي قُلْنَاهْ فِي الرِّسَالَة هَاذِي، إِكْشْفُوهْ ومَا تِتْعَامْلُوشْ مْعَاهْ بَاشْ يِحْشِمْ عْلَى رُوحُو. <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />ومَا تْعَامْلُوهُوشْ كِيمَا العْدُو، آمَا أَنْصْحُوهْ كِيمَا الخُو.<verse eid="2TH 3:15" /></para>
  <para style="s">سْلَامْ</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />ونُطْلْبُوا مِنْ رَبْ السَّلَامْ بِيدُو يَعْطِيكُمْ سَلَامْ، فِي كُلْ وَقْتْ وفِي كُلْ حَالْ. والرَّبْ يْكُونْ مْعَاكُمْ الكُلْ.<verse eid="2TH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17" />آنَا بُولِسْ نِكْتْبِلْكُمْ السْلَامْ هَاذَا بْخَطْ يِدِّي: وهَاذِي تُصْحَاحْتِي فِي رْسَايْلِي الكُلْ، بَاشْ تَعْرْفُوا الِّي آنَا كْتِبْتْهَا. <verse eid="2TH 3:17" /><verse number="18" style="v" sid="2TH 3:18" />ونِعْمِةْ رَبْنَا يَسُوعْ المَسِيحْ تْكُونْ مْعَاكُمْ الكُلْ.<verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>