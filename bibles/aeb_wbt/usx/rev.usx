<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="REV" style="id" />
  <para style="h">الرُّؤْيَا</para>
  <para style="toc1">كْتَابْ الرُّؤْيَا</para>
  <para style="toc2">الرُّؤْيَا</para>
  <para style="toc3">الرُّؤْيَا</para>
  <para style="mt">كْتَابْ الرُّؤْيَا</para>
  <chapter number="1" style="c" sid="REV 1" />
  <para style="s">سْلَامْ لِلْكْنَايِسْ السَّبْعَة</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1" />هَاذِي هِيَّ الرُّؤْيَا الِّي عْطَاهَا اللَّهْ لْيَسُوعْ المَسِيحْ، بَاشْ يْوَرِّي لْخُدَّامُو الحَاجَاتْ الِّي لَازِمْ تْصِيرْ عْلَى قْرِيبْ، ويَسُوعْ كْشِفْهَا لْخَادْمُو يُوحَنَّا عْلَى طْرِيقْ مَلَاكُو. <verse eid="REV 1:1" /><verse number="2" style="v" sid="REV 1:2" />ويُوحَنَّا شْهِدْ عْلَى كِلْمِةْ اللَّهْ وشْهَادِةْ يَسُوعْ المَسِيحْ وعْلَى كُلْ شَيْ شَافُو. <verse eid="REV 1:2" /><verse number="3" style="v" sid="REV 1:3" />صَحَّة لِيهْ الِّي يَقْرَى كْلَامْ النُّبُوءَة هَاذِي لِلنَّاسْ، وصَحَّة لِيهُمْ الِّي يِسْمْعُوهَا ويْطِيعُوا المَكْتُوبْ فِيهَا، عْلَى خَاطِرْ الوَقْتْ قْرُبْ.<verse eid="REV 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 1:4" />مِنْ يُوحَنَّا لِلْكْنَايِسْ السَّبْعَة الِّي فِي مَنْطَقْةْ آسِيَّا: النِّعْمَة والسَّلَامْ عْلِيكُمْ مِنْ عَنْدْ المَوْجُودْ تَوَّا ولِّي كَانْ مَوْجُودْ ولِّي هُوَّ بِشْ يْجِي، ومِنْ عَنْدْ الأَرْوَاحْ السَّبْعَة الِّي قُدَّامْ عَرْشُو، <verse eid="REV 1:4" /><verse number="5" style="v" sid="REV 1:5" />ومِنْ عَنْدْ يَسُوعْ المَسِيحْ الشَّاهِدْ الأَمِينْ، أَوِّلْ وَاحِدْ قَامْ مِالمُوتْ، ومَلِكْ مُلُوكْ الأَرْضْ. هُوَّ الِّي حَبْنَا وحَرَّرْنَا مِنْ ذْنُوبْنَا بْدَمُّو، <verse eid="REV 1:5" /><verse number="6" style="v" sid="REV 1:6" />ورَدْنَا شَعْبْ مُلُوكْ وكَهَنَة لِلَّهْ بُوهْ، لِيهْ المَجْدْ والسُّلْطَة لْأَبَدْ الآبِدِينْ. آمِينْ.<verse eid="REV 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 1:7" />هَاوْ جَايْ عَالسْحَابْ! وبِشْ تْشُوفُو كُلْ عِينْ، حَتَّى الِّي ضَرْبُوهْ بِالرُّمْحْ، وبِشْ تْنَوَّحْ عْلَى خَاطْرُو قْبَايِلْ الأَرْضْ الكُلْ. إِيْ نْعَمْ، آمِينْ.<verse eid="REV 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8" />«آنَا الأَلِفْ واليَاءْ، البِدَايَة والنِّهَايَة» يْقُولْ الرَّبْ الإِلَاهْ، المَوْجُودْ تَوَّا، ولِّي كَانْ مَوْجُودْ، ولِّي بِشْ يْجِي، القَادِرْ عْلَى كُلْ شَيْ.<verse eid="REV 1:8" /></para>
  <para style="s">يُوحَنَّا يْشُوفْ رُؤْيَا</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9" />آنَا يُوحَنَّا، خُوكُمْ وشْرِيكُّمْ فِي المِحْنَة وفِي المَمْلْكَة والثَّبَاتْ فِي يَسُوعْ، كُنْتْ مِنْفِي فِي الجَزِيرَة الِّي إِسْمْهَا بَطْمُسْ، عْلَى خَاطِرْنِي شْهِدِتْ لْكِلْمِةْ اللَّهْ ولْيَسُوعْ. <verse eid="REV 1:9" /><verse number="10" style="v" sid="REV 1:10" />مْلَانِي الرُّوحْ فِي يُومْ الرَّبْ، يَاخِي سْمَعْتْ صُوتْ وْرَايَا، قْوِيْ كِيفْ صُوتْ البُوقْ <verse eid="REV 1:10" /><verse number="11" style="v" sid="REV 1:11" />يْقُولْ: «إِكْتِبْ الِّي تْشُوفُو فِي كْتَابْ، وأَبْعْثُو لِلْكْنَايِسْ السَّبْعَة الِّي فِي أَفَسُسْ وسِمِيرْنَا وبَرْغَامُسْ وثِيَاتِيرَا وسَارْدِسْ وفِيلَادِلْفْيَا ولَاوْدُكِيَّة». <verse eid="REV 1:11" /><verse number="12" style="v" sid="REV 1:12" />تْلَفَّتْ بَاشْ نْشُوفْ شْكُونْ يْكَلَّمْ فِيَّا، يَاخِي شُفْتْ سَبْعَة فْنَارَاتْ ذْهَبْ <verse eid="REV 1:12" /><verse number="13" style="v" sid="REV 1:13" />فِي وِسْطْهُمْ وَاحِدْ يْشَبَّهْ لْإِبْنْ الإِنْسَانْ، لَابِسْ جِبَّة طْوِيلَة، ولَافِفْ صِدْرُو بِحْزَامْ ذْهَبْ، <verse eid="REV 1:13" /><verse number="14" style="v" sid="REV 1:14" />وشْعَرْ رَاسُو أَبْيِضْ كِي الصُّوفْ وَلَّا كِي الثِّلْجْ، وعِينِيهْ كِي النَّارْ الشَّاعْلَة، <verse eid="REV 1:14" /><verse number="15" style="v" sid="REV 1:15" />وسَاقِيهْ يِلْمْعُوا كِي النْحَاسْ الصَّافِي المَصْقُولْ بِالنَّارْ، وصُوتُو كِي صُوتْ المَاء الهَرْهَارْ القْوِيْ. <verse eid="REV 1:15" /><verse number="16" style="v" sid="REV 1:16" />وفِي يِدُّو اليْمِينْ سَبْعَة نْجُومْ، وخَارِجْ مِنْ فُمُّو سِيفْ مَاضِي مِالشِّيرْتِينْ، ووِجْهُو كِي الشَّمْسْ فِي عِزْ القَايْلَة.<verse eid="REV 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 1:17" />ووَقْتِلِّي شُفْتُو طُحْتْ عَنْدْ سَاقِيهْ كِي المِيِّتْ. يَاخِي حَطْ يِدُّو اليْمِينْ عْلِيَّا وقَالْ: «مَا تْخَافِشْ، آنَا الأُوِّلْ والإِخِّرْ، <verse eid="REV 1:17" /><verse number="18" style="v" sid="REV 1:18" />آنَا الحَيْ! كُنْتْ مِيِّتْ، آمَا تَوَّا آنَا حَيْ لِلْأَبَدْ. عَنْدِي مْفَاتَحْ المُوتْ والهَاوْيَة. <verse eid="REV 1:18" /><verse number="19" style="v" sid="REV 1:19" />مَالَا إِكْتِبْ الِّي شُفْتُو، ولِّي صَايِرْ تَوَّا، ولِّي بِشْ يْصِيرْ مْبَعِّدْ. <verse eid="REV 1:19" /><verse number="20" style="v" sid="REV 1:20" />وهَاذَا هُوَّ سِرْ السَّبْعَة نْجُومْ الِّي شُفْتْهَا فِي يِدِّي اليْمِينْ والسَّبْعَة فْنَارَاتْ الذْهَبْ: السَّبْعَة نْجُومْ هُومَا مْلَايِكْةْ الكْنَايِسْ السَّبْعَة، والسَّبْعَة فْنَارَاتْ هُومَا الكْنَايِسْ السَّبْعَة بِيدْهَا».<verse eid="REV 1:20" /></para>
  <chapter eid="REV 1" />
  <chapter number="2" style="c" sid="REV 2" />
  <para style="s">رِسَالَة لِكْنِيسِةْ أَفَسُسْ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1" />«إِكْتِبْ لْمَلَاكْ الكْنِيسَة الِّي فِي أَفَسُسْ: "هَاذَا آشْ يْقُولْ الِّي شَادِدْ فِي يِدُّو اليْمِينْ السَّبْعَة نْجُومْ ويِمْشِي مَا بِينْ السَّبْعَة فْنَارَاتْ الذْهَبْ: <verse eid="REV 2:1" /><verse number="2" style="v" sid="REV 2:2" />آنَا نَعْرِفْ أَعْمَالِكْ وتَعْبِكْ وصَبْرِكْ، ونَعْرِفْ الِّي إِنْتِ مَا تِحْمِلْشْ النَّاسْ الِّي تَعْمِلْ فِي الشَّرْ، وجَرَّبْتْ الِّي يْسَمِّيوْ فِي رْوَاحْهُمْ رُسُلْ، وظْهُرْ الِّي هُومَا يِكْذْبُوا ومَاهُمْشْ رُسُلْ. <verse eid="REV 2:2" /><verse number="3" style="v" sid="REV 2:3" />إِنْتِ صْبَرْتْ بَرْشَة، جَاهِدْتْ عْلَى خَاطِرْ إِسْمِي ومَا كَلِّيتِشْ.<verse eid="REV 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 2:4" />«"آمَا نْلُومْ عْلِيكْ الِّي إِنْتِ سَلَّمْتْ فِي مْحَبْتِكْ الأُوْلَى. <verse eid="REV 2:4" /><verse number="5" style="v" sid="REV 2:5" />اتْذَكِّرْ مِنْ وِينْ طُحْتْ وتُوبْ، وإِرْجَعْ لْأَعْمَالِكْ الِّي كُنْتْ تَعْمَلْهُمْ فِي الأُوِّلْ، وكَانْ مَا اتُّوبِشْ، رَانِي نْجِيكْ ونْقَلَّعْ فْنَارْتِكْ مِنْ بْلَاصِتْهَا. <verse eid="REV 2:5" /><verse number="6" style="v" sid="REV 2:6" />آمَا الحَاجَة البَاهْيَة فِيكْ، إِنِّكْ تِكْرَهْ أَعْمَالْ النِّيقُولَاوِيِّينْ كِيفْ مَا آنَا نِكْرَهْ أَعْمَالْهُمْ. <verse eid="REV 2:6" /><verse number="7" style="v" sid="REV 2:7" />الِّي عَنْدُو وِذْنِينْ تِسْمَعْ خَلِّيهْ يِسْمَعْ آشْ يْقُولْ الرُّوحْ لِلْكْنَايِسْ: الِّي يِغْلِبْ نَعْطِيهْ يَاكِلْ مِنْ شَجْرِةْ الحَيَاةْ الِّي فِي فِرْدَوْسْ اللَّهْ".<verse eid="REV 2:7" /></para>
  <para style="s">رِسَالَة لِكْنِيسِةْ سِمِرْنَا</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8" />«وإِكْتِبْ لْمَلَاكْ الكْنِيسِة الِّي فِي سِمِيرْنَا: "هَاذَا الِّي يْقُولُو الأُوِّلْ والإِخِّرْ، الِّي مَاتْ ورْجَعْ حَيْ: <verse eid="REV 2:8" /><verse number="9" style="v" sid="REV 2:9" />آنَا نَعْرِفْ الِّي تْقَاسِي فِيهْ مِنْ ضِيقْ وفَقْرْ، وإِنْتِ فِي الحْقِيقَة غْنِيْ. ونَعْرِفْ كِيفَاشْ يِتْبَلَّاوْ عْلِيكْ الجْمَاعَة الِّي يْقُولُوا عْلَى رْوَاحْهُمْ يْهُودْ آمَا هُومَا مَاهُمْشْ يْهُودْ: هُومَا مَجْمَعْ الشِّيطَانْ. <verse eid="REV 2:9" /><verse number="10" style="v" sid="REV 2:10" />مَا تْخَافِشْ مِالعْذَابْ الِّي يِسْتَنَّى فِيكْ، عْلَى خَاطِرْ إِبْلِيسْ بِشْ يْحُطْ جْمَاعَة مِنْكُمْ فِي الحَبْسْ بَاشْ يْجَرَّبْكُمْ، وبِشْ تِتْعَذْبُوا عَشْرَة أَيَّامْ. كُونْ أَمِينْ حَتَّى لِلْمُوتْ، وآنَا نَعْطِيكْ تَاجْ الحَيَاةْ. <verse eid="REV 2:10" /><verse number="11" style="v" sid="REV 2:11" />الِّي عَنْدُو وِذْنِينْ تِسْمَعْ خَلِّيهْ يِسْمَعْ آشْ يْقُولْ الرُّوحْ لِلْكْنَايِسْ: الِّي يِغْلِبْ مَا يِتْضَرِّشْ بِالمُوتْ الثَّانِي".<verse eid="REV 2:11" /></para>
  <para style="s">رِسَالَة لِكْنِيسِةْ بَرْغَامُسْ</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12" />«وإِكْتِبْ لْمَلَاكْ الكْنِيسَة فِي بَرْغَامُسْ: "هَاذَا آشْ يْقُولْ الِّي عَنْدُو سِيفْ مَاضِي مِالشِّيرْتِينْ: <verse eid="REV 2:12" /><verse number="13" style="v" sid="REV 2:13" />آنَا نَعْرِفْ الِّي إِنْتِ تُسْكُنْ وِينْ عَرْشْ الشِّيطَانْ. آمَا إِنْتِ شَدِّيتْ فِيَّا صْحِيحْ ومَا نْكَرْتِشْ إِيمَانِكْ بِيَّا حَتَّى فِي الأَيَّامَاتْ الِّي تِقْتَلْ فِيهَا أَنْتِيبَاسْ، الِّي شْهِدْلِي بْأَمَانَة ولِّي تِقْتَلْ فِي وِسْطْكُمْ، وِينْ يُسْكُنْ الشِّيطَانْ.<verse eid="REV 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 2:14" />«"آمَا عَنْدِي عْلِيكْ لُومْ، عْلَى خَاطِرْ خَلِّيتْ عَنْدِكْ جْمَاعَة يْتَبْعُوا فِي تَعْلِيمْ بَلْعَامْ، الِّي وَرَّى المَلِكْ بَالَاقْ كِيفَاشْ يْحَصِّلْ بَنِي إِسْرَائِيلْ ويْخَلِّيهُمْ يَاكْلُوا مِالمَاكْلَة الِّي تِتْعْطَى لِلصْنَبْ، ويِزْنَاوْ، <verse eid="REV 2:14" /><verse number="15" style="v" sid="REV 2:15" />وإِنْتِ زَادَا عَنْدِكْ شْكُونْ يْتَبَّعْ فِي تَعْلِيمْ النِّيقُولَاوِيِّينْ. <verse eid="REV 2:15" /><verse number="16" style="v" sid="REV 2:16" />مَالَا تُوبْ، وَلَّا رَانِي نْجِيكْ فِيسَعْ، ونْحَارِبْهُمْ بِالسِّيفْ الِّي فِي فُمِّي. <verse eid="REV 2:16" /><verse number="17" style="v" sid="REV 2:17" />الِّي عَنْدُو وِذْنِينْ تِسْمَعْ خَلِّيهْ يِسْمَعْ آشْ يْقُولْ الرُّوحْ لِلْكْنَايِسْ. الِّي يِغْلِبْ بِشْ نَعْطِيهْ مِالمَنْ المْخُبِّي، وبِشْ نَعْطِيهْ حَجْرَة بِيضَة مَنْقُوشْ عْلِيهَا إِسْمْ جْدِيدْ مَا يَعْرْفُو كَانْ الِّي يَاخْذُو".<verse eid="REV 2:17" /></para>
  <para style="s">رِسَالَة لِكْنِيسِةْ ثِياتِيرَا</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18" />«وإِكْتِبْ لْمَلَاكْ الكْنِيسَة فِي ثِيَاتِيرَا: "هَاذَا شْنُوَّة يْقُولْ إِبْنْ اللَّهْ، الِّي عِينِيهْ كِي النَّارْ الشَّاعْلَة وسَاقِيهْ كِيفْ النْحَاسْ الصَّافِي: <verse eid="REV 2:18" /><verse number="19" style="v" sid="REV 2:19" />آنَا نَعْرِفْ أَعْمَالِكْ ومْحَبْتِكْ وإِيمَانِكْ وخِدْمْتِكْ وصَبْرِكْ، وإِنُّو أَعْمَالِكْ الإِخْرَانِيَّة أَكْثِرْ مِنْ أَعْمَالِكْ الأُوْلَى.<verse eid="REV 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 2:20" />«"آمَا عَنْدِي عْلِيكْ لُومْ ، إِنِّكْ مِتْسَاهِلْ مْعَ إِيزَابِيلْ المْرَا الِّي عَامْلَة رُوحْهَا نَبِيَّة، ومْخَلِّيهَا تْحَصِّلْ فِي خُدَّامِي وتْعَلَّمْ فِيهُمْ يِزْنَاوْ ويَاكْلُوا مِالمَاكْلَة الِّي تِتْعْطَى لِلصْنَبْ. <verse eid="REV 2:20" /><verse number="21" style="v" sid="REV 2:21" />وعْطِيتْهَا مُدَّة بَاشْ اتُّوبْ آمَا هِيَّ مَا حَبِّتْشْ اتُّوبْ عْلَى زْنَاهَا. <verse eid="REV 2:21" /><verse number="22" style="v" sid="REV 2:22" />هَاذَاكَا عْلَاشْ بِشْ نْخَلِّيهَا مْرِيضَة مُرْمِيَّة فِي فَرْشْ، ونْعَدِّي الِّي يِزْنَاوْ مْعَاهَا فِي مِحْنَة كْبِيرَة، كَانْ مَا يْتُوبُوشْ عْلَى عْمَايِلْهُمْ، <verse eid="REV 2:22" /><verse number="23" style="v" sid="REV 2:23" />ونُقْتُلْ وْلَادْهَا، وهَكَّا تَعْرِفْ الكْنَايِسْ الكُلْ الِّي آنَا هُوَّ الِّي نَفْحِصْ الأَفْكَارْ والقْلُوبْ، ونْجَازِي كُلْ وَاحِدْ حَسْبْ فِعْلُو.<verse eid="REV 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 2:24" />«"آمَا إِنْتُومَا البْقِيَّة الِّي فِي ثِيَاتِيرَا، الِّي مَا تَبَّعْتُوشْ التَّعْلِيمْ هَاذَا، ومَا تْعَلَّمْتُوشْ الِّي يْسَمِّيوِهْ أَسْرَارْ الشِّيطَانْ الكْبِيرَة، رَانِي نْقُلْكُمْ الِّي مَانِيشْ بِشْ نْحُطْ عْلِيكُمْ حْمِلْ آخِرْ. <verse eid="REV 2:24" /><verse number="25" style="v" sid="REV 2:25" />آمَا خَلِّيكُمْ شَادِّينْ صْحِيحْ فِلِّي عَنْدْكُمْ حَتَّى لِينْ نْجِي. <verse eid="REV 2:25" /><verse number="26" style="v" sid="REV 2:26" />الِّي يِغْلِبْ ويُقْعُدْ يَعْمِلْ فِلِّي يْرَضِّينِي حَتَّى لِلِّخِّرْ، نَعْطِيهْ سُلْطَة عَالشُّعُوبْ، <verse eid="REV 2:26" /><verse number="27" style="v" sid="REV 2:27" />كِيمَا السُّلْطَة الِّي عْطَاهَالِي بَابَا.</para>
  <para style="b" vid="REV 2:27" />
  <para style="q1" vid="REV 2:27">بِشْ يْقُودْهُمْ بِعْصَى مِنْ حْدِيدْ،</para>
  <para style="q2" vid="REV 2:27">ويِكَسَّرْهُمْ كِيفْ الفُخَّارْ.<verse eid="REV 2:27" /></para>
  <para style="b" />
  <para style="m">
    <verse number="28" style="v" sid="REV 2:28" />«"ونَعْطِيهْ زَادَا نِجْمِةْ الصْبَاحْ. <verse eid="REV 2:28" /><verse number="29" style="v" sid="REV 2:29" />الِّي عَنْدُو وِذْنِينْ تِسْمَعْ خَلِّيهْ يِسْمَعْ آشْ يْقُولْ الرُّوحْ لِلْكْنَايِسْ".<verse eid="REV 2:29" /></para>
  <chapter eid="REV 2" />
  <chapter number="3" style="c" sid="REV 3" />
  <para style="s">رِسَالَة لِكْنِيسِةْ سَارْدِسْ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1" />«وإِكْتِبْ لْمَلَاكْ الكْنِيسَة الِّي فِي سَارْدِسْ: "هَاذَا شْنُوَّة يْقُولْ الِّي لِيهْ أَرْوَاحْ اللَّهْ السَّبْعَة والنْجُومْ السَّبْعَة: آنَا نَعْرِفْ أَعْمَالِكْ. إِنْتِ حَيْ بِالإِسْمْ آمَا رَاكْ فِي الحْقِيقَة مِيِّتْ. <verse eid="REV 3:1" /><verse number="2" style="v" sid="REV 3:2" />فِيقْ، وقَوِّي الِّي مَزَّالْ حَيْ فِيكْ، قْبَلْ مَا يْكَمِّلْ يْمُوتْ. عْلَى خَاطِرْ لْقِيتْ أَعْمَالِكْ مَاهِيشْ كَامْلَة قُدَّامْ إِلَاهِي. <verse eid="REV 3:2" /><verse number="3" style="v" sid="REV 3:3" />تْذَكِّرْ الِّي تْعَلَّمْتُو وسْمَعْتُو مِنْ قْبَلْ، وشِدْ صْحِيحْ فِي الحَاجَاتْ هَاذِي الِّي أَمَّنْتْ بِيهَا وتُوبْ. رَاهُو كَانْ مَا تْكُونِشْ فَايِقْ، نْجِيكْ كِيمَا يْجِي السَّارِقْ، ومَاكِشْ بِشْ تَعْرِفْ السَّاعَة الِّي بِشْ نْجِيكْ فِيهَا. <verse eid="REV 3:3" /><verse number="4" style="v" sid="REV 3:4" />آمَا عَنْدِكْ شْوَيَّة نَاسْ فِي سَارْدِسْ مَا مَسْخُوشْ حْوَايِجْهُمْ، بِشْ يِمْشِيوْ مْعَايَا، لَابْسِينْ حْوَايِجْ بْيُضْ عْلَى خَاطِرْهُمْ يِسْتَاهْلُوا. <verse eid="REV 3:4" /><verse number="5" style="v" sid="REV 3:5" />الِّي يِغْلِبْ، بِشْ يِلْبِسْ لِبْسَة بِيضَة، ومَا نْفَسَّخْلُوشْ إِسْمُو مِنْ كْتَابْ الحَيَاةْ، وبِشْ نَعْتَرِفْ بْإِسْمُو قُدَّامْ بَابَا وقُدَّامْ مْلَايِكْتُو. <verse eid="REV 3:5" /><verse number="6" style="v" sid="REV 3:6" />الِّي عَنْدُو وِذْنِينْ تِسْمَعْ خَلِّيهْ يِسْمَعْ آشْ يْقُولْ الرُّوحْ لِلْكْنَايِسْ".<verse eid="REV 3:6" /></para>
  <para style="s">رِسَالَة لِكْنِيسِةْ فِيلَادِلْفْيَا</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7" />«وإِكْتِبْ لْمَلَاكْ الكْنِيسَة فِي فِيلَادِلْفْيَا: "هَاذَا شْنُوَّة يْقُولْ القُدُّوسْ، الحَقْ، الِّي عَنْدُو مِفْتَاحْ دَاوِدْ، الِّي كِي يْحِلْ مَا يْنَجِّمْ حَدْ يْسَكِّرْ، وكِي يْسَكِّرْ مَا يْنَجِّمْ حَدْ يْحِلْ: <verse eid="REV 3:7" /><verse number="8" style="v" sid="REV 3:8" />آنَا نَعْرِفْ أَعْمَالِكْ. ورَغْمِلِّي مَا عَنْدِكْشْ بَرْشَة قُوَّة، سْمَعْتْ كْلَامِي ومَا نْكَرْتِشْ فِي إِسْمِي. هَاذَاكَا عَلَاشْ حَلِّيتْلِكْ بَابْ مَا يْنَجِّمْ حَدْ يْسَكْرُو. <verse eid="REV 3:8" /><verse number="9" style="v" sid="REV 3:9" />آمَا الِّي هُومَا مِنْ مَجْمَعْ إِبْلِيسْ، ومْسَمِّينْ رْوَاحْهُمْ يْهُودْ وهُومَا يِكْذْبُوا، بِشْ نْخَلِّيهُمْ يْجِيوْ ويِسْجْدُوا قُدَّامْ سَاقِيكْ، ويَعْرْفُوا الِّي آنَا حَبِّيتِكْ. <verse eid="REV 3:9" /><verse number="10" style="v" sid="REV 3:10" />وعْلَى خَاطْرِكْ حْفَظْتْ كْلَامِي وصْبَرْتْ، بِشْ نِحْمِيكْ فِي سَاعِةْ المِحْنَة الِّي بِشْ تْجِي عَالعَالِمْ الكُلْ، وتْكُونْ إِمْتِحَانْ لِلنَّاسْ الكُلْ. <verse eid="REV 3:10" /><verse number="11" style="v" sid="REV 3:11" />هَانِي جَايْ عْلَى قْرِيبْ، شِدْ صْحِيحْ فِلِّي عَنْدِكْ، بَاشْ حَتَّى حَدْ مَا يْفُكْلِكْ تَاجِكْ. <verse eid="REV 3:11" /><verse number="12" style="v" sid="REV 3:12" />الِّي يِغْلِبْ نْرُدُّو عُرْصَة فِي هَيْكِلْ إِلَاهِي، وعُمْرُو مَا يُخْرُجْ مِنُّو. ونُنْقُشْ عْلِيهْ إِسْمْ إِلَاهِي وإِسْمْ مْدِينِةْ إِلَاهِي، الِّي هِيَّ أُورْشَلِيمْ الجْدِيدَة الِّي إِلَاهِي بِشْ يْهَبَّطْهَا مِالسْمَاء. ولِّي يِغْلِبْ بِشْ نُنْقُشْ عْلِيهْ إِسْمِي الجْدِيدْ زَادَا. <verse eid="REV 3:12" /><verse number="13" style="v" sid="REV 3:13" />الِّي عَنْدُو وِذْنِينْ تِسْمَعْ خَلِّيهْ يِسْمَعْ آشْ يْقُولْ الرُّوحْ لِلْكْنَايِسْ!".<verse eid="REV 3:13" /></para>
  <para style="s">رِسَالَة لِكْنِيسِةْ لَاوْدُكِيَّة</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14" />«وإِكْتِبْ لْمَلَاكْ الكْنِيسَة فِي لَاوْدُكِيَّة: "هَاذَا شْنُوَّة يْقُولْ الآمِينْ، الشَّاهِدْ الأَمِينْ الصَّادِقْ، الِّي مِنُّو جَاء الِّي خَلْقُو اللَّهْ الكُلْ: <verse eid="REV 3:14" /><verse number="15" style="v" sid="REV 3:15" />آنَا نَعْرِفْ أَعْمَالِكْ، ونَعْرِفْ الِّي إِنْتِ لَاكْ بَارِدْ ولَاكْ سْخُونْ، ويَا لِيتِكْ جِيتْ بَارِدْ وَلَّا سْخُونْ! <verse eid="REV 3:15" /><verse number="16" style="v" sid="REV 3:16" />وعْلَى خَاطْرِكْ لَاكْ بَارِدْ ولَاكْ سْخُونْ، بِشْ نِتْقَيَّاكْ مِنْ فُمِّي. <verse eid="REV 3:16" /><verse number="17" style="v" sid="REV 3:17" />إِنْتِ تْقُولْ: آنَا غْنِي ولَابَاسْ عْلِيَّا ومَا نِحْتَاجْ لْشَيْ. ومَاكْشْ عَارِفْ الِّي إِنْتِ تَعِيسْ ومِسْكِينْ وفْقِيرْ وأَعْمَى وعِرْيَانْ. <verse eid="REV 3:17" /><verse number="18" style="v" sid="REV 3:18" />هَاذَاكَا عْلَاشْ نَنْصْحِكْ تِشْرِي مِنْ عِنْدِي ذْهَبْ مْصَفِّي بِالنَّارْ بَاشْ تِسْتَغْنَى بِالحَقْ، ولِبْسَة بِيضَة تِلْبِسْهَا تُسْتُرْ عْرَاكْ الِّي يْحَشِّمْ، وكْحُلْ تْكَحِّلْ بِيهْ عِينِيكْ بَاشْ تْوَلِّي تْشُوفْ.<verse eid="REV 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 3:19" />«"رَانِي الِّي نْحِبُّو نْلُومْ عْلِيهْ ونْأَدْبُو، مَالَا كُونْ مِتْحَمِّسْ وتُوبْ. <verse eid="REV 3:19" /><verse number="20" style="v" sid="REV 3:20" />هَانِي وَاقِفْ قُدَّامْ البَابْ ونْدُقْ، إِذَا كَانْ وَاحِدْ سْمَعْ صُوتِي وحَلْ البَابْ، نُدْخُلْ بَحْذَاهْ ونِتْعَشَّى مْعَاهْ وهُوَّ يِتْعَشَّى مْعَايَا. <verse eid="REV 3:20" /><verse number="21" style="v" sid="REV 3:21" />الِّي يِغْلِبْ بِشْ نْقَعْدُو مْعَايَا عْلَى عَرْشِي، كِيمَا غْلِبْتْ آنَا وقْعَدْتْ مْعَ بَابَا عْلَى عَرْشُو. <verse eid="REV 3:21" /><verse number="22" style="v" sid="REV 3:22" />الِّي عَنْدُو وِذْنِينْ تِسْمَعْ خَلِّيهْ يِسْمَعْ آشْ يْقُولْ الرُّوحْ لِلْكْنَايِسْ"».<verse eid="REV 3:22" /></para>
  <chapter eid="REV 3" />
  <chapter number="4" style="c" sid="REV 4" />
  <para style="s">العَرْشْ الِّي فِي السْمَاء</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1" />بَعْدْهَا شُفْتْ بَابْ مَحْلُولْ فِي السْمَاءْ، وسْمَعْتْ الصُّوتْ الِّي كَلَّمْنِي قْبَلْ كَايِنُّو صُوتْ بُوقْ، يْقُلِّي: «إِطْلَعْ هُونِي بَاشْ نْوَرِّيكْ شْنُوَّة لَازِمْ يْصِيرْ مْبَعِّدْ». <verse eid="REV 4:1" /><verse number="2" style="v" sid="REV 4:2" />وبِالوَقْتْ تِمْلِيتْ بِالرُّوحْ، وشُفْتْ عَرْشْ فِي السْمَاء ووَاحِدْ قَاعِدْ عْلِيهْ. <verse eid="REV 4:2" /><verse number="3" style="v" sid="REV 4:3" />ولِّي قَاعِدْ عْلِيهْ، الكُلُّو يُلْصُفْ كِيفْ حَجْرِةْ اليَشْبْ والعْقِيقْ الأَحْمَرْ. والعَرْشْ دَايِرْ بِيهْ قَوْسْ قُزَحْ يِلْمَعْ كِي الزْمُرُّدْ. <verse eid="REV 4:3" /><verse number="4" style="v" sid="REV 4:4" />وكَانْ دَايِرْ بِالعَرْشْ 24 عَرْشْ، قَاعْدِينْ عْلِيهُمْ 24 شِيخْ، لَابْسِينْ لِبْسَة بِيضَة وعْلَى رُوسْهُمْ تِيجَانْ ذْهَبْ. <verse eid="REV 4:4" /><verse number="5" style="v" sid="REV 4:5" />والعَرْشْ كَانْ خَارِجْ مِنُّو بْرَقْ ورْعَدْ وأَصْوَاتْ، وقُدَّامُو سَبْعَة فْنَارَاتْ تِشْعِلْ، هُومَا أَرْوَاحْ اللَّهْ السَّبْعَة. <verse eid="REV 4:5" /><verse number="6" style="v" sid="REV 4:6" />وقُدَّامْ العَرْشْ فَمَّة كِيمَا البْحَرْ، شَفَّافْ كَايِنُّو بِلَّارْ، وفِي وِسْطْ العَرْشْ ودَايِرْ بِيهْ أَرْبْعَة مَخْلُوقَاتْ مْعَبِّينْ بِالعِينِينْ مِنْ قُدَّامْ ومِنْ تَالِي: <verse eid="REV 4:6" /><verse number="7" style="v" sid="REV 4:7" />المَخْلُوقْ الأُوِّلْ يْشَبَّهْ لِلصِّيدْ، والثَّانِي يْشَبَّهْ لِلْعْجِلْ، والثَّالِثْ وِجْهُو كِيفْ وِجْهْ الإِنْسَانْ، والرَّابَعْ يْشَبَّهْ لِلنِّسْرْ الطَّايِرْ. <verse eid="REV 4:7" /><verse number="8" style="v" sid="REV 4:8" />وكُلْ وَاحِدْ مِالمَخْلُوقَاتْ الأَرْبْعَة هَاذُومَا عَنْدُو سِتَّة جْوَانَحْ، مْعَبِّينْ بِالعِينِينْ مِالبَرَّة ومِنْ دَاخِلْ. ولِيلْ ونْهَارْ وهُومَا يْسَبْحُوا مِنْ غِيرْ مَا يَاقْفُوا:</para>
  <para style="b" vid="REV 4:8" />
  <para style="q1" vid="REV 4:8">«قُدُّوسْ! قُدُّوسْ! قُدُّوسْ! الرَّبْ الإِلَاهْ،</para>
  <para style="q2" vid="REV 4:8">القَادِرْ عْلَى كُلْ شَيْ،</para>
  <para style="q1" vid="REV 4:8">الِّي كَانْ مَوْجُودْ ولِّي مَوْجُودْ تَوَّا،</para>
  <para style="q2" vid="REV 4:8">ولِّي بِشْ يْجِي».<verse eid="REV 4:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="REV 4:9" />وكُلْ مَرَّة يْقَدْمُوا فِيهَا المَخْلُوقَاتْ الأَرَبْعَة المَجْدْ والكَرَامَة والشُّكْرْ لِلِّي قَاعِدْ عَالعَرْشْ، الحَيْ لِلْأَبَدْ، <verse eid="REV 4:9" /><verse number="10" style="v" sid="REV 4:10" />يِرْكْعُوا الـ24 شِيخْ قُدَّامْ القَاعِدْ عَالعَرْشْ، ويِسْجْدُوا لِلْحَيْ لِلْأَبَدْ، ويِرْمِيوْ تِيجَانْهُمْ قُدَّامْ عَرْشُو وهُومَا يْقُولُوا:<verse eid="REV 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11" />«تِسْتْحَقْ يَا رَبْنَا وإِلَاهْنَا،</para>
  <para style="q2" vid="REV 4:11">المَجْدْ والجَلَالْ والقُدْرَة،</para>
  <para style="q1" vid="REV 4:11">عْلَى خَاطْرِكْ خْلَقْتْ كُلْ شَيْ،</para>
  <para style="q2" vid="REV 4:11">وكُلْ شَيْ مَخْلُوقْ ومَوْجُودْ</para>
  <para style="q1" vid="REV 4:11">كِيمَا إِنْتِ حَبِّيتْ».<verse eid="REV 4:11" /></para>
  <para style="b" />
  <chapter eid="REV 4" />
  <chapter number="5" style="c" sid="REV 5" />
  <para style="s">الكْتَابْ المَخْتُومْ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1" />وشُفْتْ فِي اليِدْ اليْمِينْ مْتَاعْ القَاعِدْ عَالعَرْشْ، كْتَابْ مَكْتُوبْ مِنْ دَاخِلْ ومِنْ بَرَّا، ومَخْتُومْ بْسَبْعَة خْتُومْ، <verse eid="REV 5:1" /><verse number="2" style="v" sid="REV 5:2" />وشُفْتْ مَلَاكْ قْوِي يْعَيِّطْ بْصُوتْ عَالِي: «شْكُونُو الِّي يِسْتَاهِلْ إِنُّو يْحِلْ الكْتَابْ ويْنَحِّي خْتُومُو؟». <verse eid="REV 5:2" /><verse number="3" style="v" sid="REV 5:3" />آمَا مَا نَجِّمْ حَتَّى حَدْ، لَا فِي السْمَاءْ، ولَا عَالأَرْضْ، ولَا تَحْتْ الأَرْضْ، يْحِلْ الكْتَابْ ويْشُوفْ الِّي فِيهْ. <verse eid="REV 5:3" /><verse number="4" style="v" sid="REV 5:4" />يَاخِي إِطَّرْشَقْتْ بِالبْكَاءْ عْلَى خَاطِرْ مَا كَانِشْ فَمَّة حَتَّى حَدْ يِسْتَاهِلْ بَاشْ يْحِلْ الكْتَابْ ويْشُوفْ الِّي فِيهْ. <verse eid="REV 5:4" /><verse number="5" style="v" sid="REV 5:5" />آمَا وَاحِدْ مِالشْيُوخْ قَلِّي: «مَا تِبْكِيشْ! الصِّيدْ الِّي مِنْ عَرْشْ يَهُوذَا ومِنْ سْلَالِةْ دَاوِدْ غْلِبْ، وهُوَّ الِّي بِشْ يْحِلْ الكْتَابْ ويْنَحِّي خْتُومُو السَّبْعَة».<verse eid="REV 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6" />وبَعْدْ شُفْتْ خَرُوفْ فِي الوِسْطْ، مَا بِينْ العَرْشْ والمَخْلُوقَاتْ الأَرْبْعَة والشْيُوخْ، وَاقِفْ كَايِنُّو مَذْبُوحْ. عَنْدُو سَبْعَة ڨْرُونْ وسَبْعَة عِينِينْ الِّي هُومَا أَرْوَاحْ اللَّهْ السَّبْعَة الِّي بْعَثْهُمْ لِلْأَرْضْ الكُلْ. <verse eid="REV 5:6" /><verse number="7" style="v" sid="REV 5:7" />قَدِّمْ، وخْذَا الكْتَابْ مِاليِدْ اليْمِينْ مْتَاعْ القَاعِدْ عَالعَرْشْ. <verse eid="REV 5:7" /><verse number="8" style="v" sid="REV 5:8" />ووَقْتِلِّي خْذَا الكْتَابْ، سِجْدُوا المَخْلُوقَاتْ الأَرْبْعَة والشْيُوخْ الـ24 قُدَّامْ الخَرُوفْ. وكَانْ كُلْ وَاحِدْ فِيهُمْ عَنْدُو قِيثَارَة وكِيسَانْ ذْهَبْ مِلْيَانِينْ بِالبْخُورْ، الِّي هُوَّ صْلَاوَاتْ القِدِّيسِينْ. <verse eid="REV 5:8" /><verse number="9" style="v" sid="REV 5:9" />وكَانُوا يْغَنِّيوْ فِي تَرْنِيمَة جْدِيدَة ويْقُولُوا:</para>
  <para style="b" vid="REV 5:9" />
  <para style="q1" vid="REV 5:9">«إِنْتِ تِسْتَاهِلْ بَاشْ تَاخِذْ الكْتَابْ،</para>
  <para style="q2" vid="REV 5:9">وتْنَحِّي الخْتُومْ!</para>
  <para style="q1" vid="REV 5:9">عْلَى خَاطْرِكْ تِذْبَحْتْ،</para>
  <para style="q2" vid="REV 5:9">وبْدَمِّكْ شْرِيتْ ورَجَّعْتْ لِلَّهْ نَاسْ،</para>
  <para style="q1" vid="REV 5:9">مِنْ كُلْ عَرْشْ ولُوغَة وشَعْبْ وأُمَّة،<verse eid="REV 5:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="REV 5:10" />ورَدِّيتْهُمْ شَعْبْ مُلُوكْ وكَهَنَة لْإِلَاهْنَا،</para>
  <para style="q1" vid="REV 5:10">وبِشْ يِمْلْكُوا عَالأَرْضْ».<verse eid="REV 5:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11" />وبَعْدْ خْزَرْتْ، وسْمَعْتْ أَصْوَاتْ بَرْشَة مْلَايْكَة دَايْرِينْ بِالعَرْشْ وبِالمَخْلُوقَاتْ الأَرْبْعَة والشْيُوخْ، وعْدَدْهُمْ كَانْ بِالمْلَايِنْ، مَا يِتْحِسْبُوشْ مِنْ كُثْرِتْهُمْ، <verse eid="REV 5:11" /><verse number="12" style="v" sid="REV 5:12" />وهُومَا يْقُولُوا بْصُوتْ عَالِي:</para>
  <para style="b" vid="REV 5:12" />
  <para style="q1" vid="REV 5:12">«الخَرُوفْ المَذْبُوحْ يِسْتَاهِلْ القُدْرَة والثَّرْوَة،</para>
  <para style="q2" vid="REV 5:12">والحِكْمَة والقُوَّة والجَلَالْ والمَجْدْ والبَرْكَة».<verse eid="REV 5:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="REV 5:13" />وسْمَعْتْ المَخْلُوقَاتْ الكُلْ، الِّي فِي السْمَاء ولِّي عَالأَرْضْ ولِّي تَحْتْ الأَرْضْ ولِّي فِي البْحَرْ ولِّي فِي الكَوْنْ الكُلْ، يْقُولُوا:</para>
  <para style="b" vid="REV 5:13" />
  <para style="q1" vid="REV 5:13">«البَرْكَة والكَرَامَة والجَلَالْ والقُوَّة،</para>
  <para style="q2" vid="REV 5:13">لِلْقَاعِدْ عَالعَرْشْ ولِلْخَرُوفْ،</para>
  <para style="q1" vid="REV 5:13">لِلْأَبَدْ».<verse eid="REV 5:13" /></para>
  <para style="b" />
  <para style="m">
    <verse number="14" style="v" sid="REV 5:14" />والمَخْلُوقَاتْ الأَرْبْعَة جَاوْبُوا: «آمِينْ!» والشْيُوخْ رَكْعُوا وسِجْدُوا.<verse eid="REV 5:14" /></para>
  <chapter eid="REV 5" />
  <chapter number="6" style="c" sid="REV 6" />
  <para style="s">الخْتُومْ السَّبْعَة</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1" />وشُفْتْ الخَرُوفْ يْحِلْ فِي أَوِّلْ خِتْمْ مِالخْتُومْ السَّبْعَة، وسْمَعْتْ وَاحِدْ مِالمَخْلُوقَاتْ الأَرْبْعَة يْقُولْ بْصُوتْ كِيفْ الرْعَدْ: «إِيجَا شُوفْ!» <verse eid="REV 6:1" /><verse number="2" style="v" sid="REV 6:2" />وخْزَرْتْ وإِذَا بِيهْ حْصَانْ أَبْيِضْ قُدَّامِي، ولِّي رَاكِبْ عْلِيهْ هَازِزْ قُوسْ، وتِعْطَالُو تَاجْ، وخْرَجْ غَالِبْ وبَاشْ يْزِيدْ يِغْلِبْ.<verse eid="REV 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3" />ووَقْتِلِّي حَلْ الخَرُوفْ الخِتْمْ الثَّانِي، سْمَعْتْ المَخْلُوقْ الثَّانِي يْقُولْ: «إِيجَا شُوفْ!» <verse eid="REV 6:3" /><verse number="4" style="v" sid="REV 6:4" />وخْرَجْ حْصَانْ آخِرْ، لُونُو أَحْمَرْ، ولِّي رَاكِبْ عْلِيهْ تِعْطَاتْلُو القُدْرَة بَاشْ يْنَحِّي السَّلَامْ مِالأَرْضْ، ويْخَلِّي النَّاسْ يُقْتْلُوا بْعَضْهُمْ، وتِعْطَالُو سِيفْ كْبِيرْ.<verse eid="REV 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5" />وكِي حَلْ الخَرُوفْ الخِتْمْ الثَّالِثْ، سْمَعْتْ المَخْلُوقْ الثَّالِثْ يْقُولْ: «إِيجَا شُوفْ!» وخْزَرْتْ وإِذَا بِيهْ حْصَانْ أَكْحَلْ ولِّي رَاكِبْ عْلِيهْ شَادِدْ مِيزَانْ. <verse eid="REV 6:5" /><verse number="6" style="v" sid="REV 6:6" />وسْمَعْتْ كِيمَا صُوتْ خَارِجْ مِنْ بِينْ المَخْلُوقَاتْ الأَرْبْعَة يْقُولْ: «حَفْنِةْ قَمْحْ بْحَقْ نْهَارْ خِدْمَة، وثْلَاثَة حَفْنَاتْ شْعِيرْ بْنَفْسْ السُّومْ، آمَا الزِّيتْ والشْرَابْ مَا تْفَسَّدْهُمْشْ».<verse eid="REV 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7" />وكِي حَلْ الخَرُوفْ الخِتْمْ الرَّابَعْ، سْمَعْتْ صُوتْ المَخْلُوقْ الرَّابِعْ يْقُولْ: «إِيجَا شُوفْ!» <verse eid="REV 6:7" /><verse number="8" style="v" sid="REV 6:8" />وخْزَرْتْ وإِذَا بِيهْ حْصَانْ أَخْضِرْ، ولِّي رَاكِبْ عْلِيهْ إِسْمُو المُوتْ، والهَاوِيَة اتَّبَّعْ فِيهْ، وتِعْطَالْهُمْ سُلْطَة بَاشْ يُقْتْلُوا رْبُعْ سُكَّانْ الأَرْضْ بِالسْيُوفَا وبِالجُّوعْ والوْبَاء وبِالحَيَوَانَاتْ المِتْوَحْشَة.<verse eid="REV 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9" />وكِي حَلْ الخَرُوفْ الخِتْمْ الخَامِسْ، شُفْتْ تَحْتْ المَذْبَحْ أَرْوَاحْ الِّي تْقَتْلُوا عْلَى خَاطِرْ كِلْمِةْ اللَّهْ، ولِّي شِهْدُوا بِيهْ. <verse eid="REV 6:9" /><verse number="10" style="v" sid="REV 6:10" />وهُومَا يْصِيحُوا بْصُوتْ عَالِي: «يَا سِيدْنَا القُدُّوسْ الحَقْ، وَقْتَاشْ بِشْ تْحَاكِمْ سُكَّانْ الأَرْضْ، وتِنْتَقِمْ مِنْهُمْ عْلَى خَاطِرْ قَتْلُونَا؟». <verse eid="REV 6:10" /><verse number="11" style="v" sid="REV 6:11" />وتِعْطَى لْكُلْ وَاحِدْ فِيهُمْ جِبَّة بِيضَة، وتْقَالِلْهُمْ بَاشْ يُصْبْرُوا شْوَيَّة حَتَّى يِكْمِلْ عْدَدْ الخُدَّامْ وخْوَاتْهُمْ الِّي بِشْ يِتْقَتْلُوا كِيفْهُمْ.<verse eid="REV 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12" />وخْزَرْتْ وَقْتِلِّي حَلْ الخَرُوفْ الخِتْمْ السَّادِسْ، وإِذَا بْزِلْزَالْ كْبِيرْ يْصِيرْ، والشَّمْسْ وَلَّاتْ كَحْلَة كِيمَا لِبْسِةْ العْزَاء، والڨَمْرَة حْمَارِتْ ووَلَّاتْ كِيفْ الدَّمْ، <verse eid="REV 6:12" /><verse number="13" style="v" sid="REV 6:13" />وبْدَاتْ نْجُومْ السْمَاء اطِّيحْ عَالأَرْضْ، كِيمَا يْطِيحْ الكَرْمُوسْ مِالشَّجْرَة وَقْتِلِّي تْهِبْ رِيحْ قْوِيَّة، <verse eid="REV 6:13" /><verse number="14" style="v" sid="REV 6:14" />وتِطْوَاتْ السْمَاء كِيمَا تِتْلَفْ الوَرْقَة، وتْزَحْزْحِتْ الجْبَالْ والجُزُرْ الكُلْ مِنْ بْلَايِصْهَا.<verse eid="REV 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 6:15" />ومُلُوكْ الأَرْضْ والعُظَمَاءْ والحُكَّامْ والغْنِيِّينْ والقْوِيِّينْ والنَّاسْ الكُلْ، عَبِيدْ وأَحْرَارْ، الكُلْهُمْ تْخَبَّاوْ فِي المْغَاغِرْ وبِينْ حْجَرْ الجْبَالْ، <verse eid="REV 6:15" /><verse number="16" style="v" sid="REV 6:16" />وهُومَا يْقُولُوا لِلجْبَالْ والحْجَرْ: «طِيحُوا عْلِينَا وخَبِّيوْنَا مِنْ وِجْهْ القَاعِدْ عَالعَرْشْ ومِنْ غَضَبْ الخَرُوفْ. <verse eid="REV 6:16" /><verse number="17" style="v" sid="REV 6:17" />رَاهُو جَاء يُومْ غَضَبْهُمْ العْظِيمْ، وشْكُونُو الِّي يْنَجِّمْ يِبْقَى وَاقِفْ؟»<verse eid="REV 6:17" /></para>
  <chapter eid="REV 6" />
  <chapter number="7" style="c" sid="REV 7" />
  <para style="s">المَخْتُومِينْ مِنْ عْرُوشَاتْ إِسْرَائِيلْ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1" />وبَعْدْهَا شُفْتْ أَرْبْعَة مْلَايْكَة وَاقْفِينْ فِي أَطْرَافْ الأَرْضْ الأَرْبْعَة، شَادِّينْ أَرْيَاحْ الأَرْضْ الأَرْبْعَة بَاشْ مَا يْقُومْ حَتَّى رِيحْ عَالبَرْ ولَا عَالبْحَرْ ولَا عَالشْجَرْ. <verse eid="REV 7:1" /><verse number="2" style="v" sid="REV 7:2" />ومْبَعِّدْ شُفْتْ مَلَاكْ آخِرْ جَايْ مِالشَّرْقْ هَازِزْ خِتْمْ اللَّهْ الحَيْ، وعَيِّطْ بْصُوتْ عَالِي لِلأَرْبْعَة مْلَايْكَة الِّي مِتْكَلْفِينْ بَاشْ يْضُرُّوا البَرْ والبْحَرْ، <verse eid="REV 7:2" /><verse number="3" style="v" sid="REV 7:3" />وقَالِلْهُمْ: «مَا تْضُرُّوشْ البَرْ وَلَا البْحَرْ وَلَا الشْجَرْ حَتَّى لِينْ نْحُطُّوا الخِتْمْ عْلَى جْبِينْ خُدَّامْ إِلَاهْنَا». <verse eid="REV 7:3" /><verse number="4" style="v" sid="REV 7:4" />وسْمَعْتْ الِّي عْدَدْ المَخْتُومِينْ 144 000، مِنْ عْرُوشَاتْ إِسْرَائِيلْ الكُلْ:<verse eid="REV 7:4" /></para>
  <para style="li">
    <verse number="5" style="v" sid="REV 7:5" />12 000 مَخْتُومِينْ مِنْ عَرْشْ يَهُوذا،</para>
  <para style="li" vid="REV 7:5">و12 000 مِنْ عَرْشْ رَأُوبَيْنْ،</para>
  <para style="li" vid="REV 7:5">و12 000 مِنْ عَرْشْ جَادْ،<verse eid="REV 7:5" /></para>
  <para style="li">
    <verse number="6" style="v" sid="REV 7:6" />و12 000 مِنْ عَرْشْ أَشِيرْ،</para>
  <para style="li" vid="REV 7:6">و12 000 مِنْ عَرْشْ نَفْتَالِي،</para>
  <para style="li" vid="REV 7:6">و12 000 مِنْ عَرْشْ مَنَسَّى،<verse eid="REV 7:6" /></para>
  <para style="li">
    <verse number="7" style="v" sid="REV 7:7" />و12 000 مِنْ عَرْشْ شَمْعُونْ،</para>
  <para style="li" vid="REV 7:7">و12 000 مِنْ عَرْشْ لَاوِي،</para>
  <para style="li" vid="REV 7:7">و12 000 مِنْ عَرْشْ يَسَّاكَرْ،<verse eid="REV 7:7" /></para>
  <para style="li">
    <verse number="8" style="v" sid="REV 7:8" />و12 000 مِنْ عَرْشْ زَبُولُونْ،</para>
  <para style="li" vid="REV 7:8">و12 000 مِنْ عَرْشْ يُوسِفْ،</para>
  <para style="li" vid="REV 7:8">و12 000 مِنْ عَرْشْ بِنْيَامِينْ.<verse eid="REV 7:8" /></para>
  <para style="s">بَرْشَة نَاسْ قُدَّامْ العَرْشْ</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9" />ومْبَعِّدْ خْزَرْتْ يَاخِي لْقِيتْ بَرْشَة نَاسْ مَا يِتْحِسْبُوشْ مِنْ كُثْرِتْهُمْ، مِنْ كُلْ أُمَّة وقَبِيلَة وشَعْبْ ولُوغَة، وكَانُوا وَاقْفِينْ قُدَّامْ العَرْشْ وقُدَّامْ الخَرُوفْ، لَابْسِينْ جْبَايِبْ بْيُضْ وهَازِّينْ فِي يْدِيهُمْ سْعَفْ النْخَلْ، <verse eid="REV 7:9" /><verse number="10" style="v" sid="REV 7:10" />وهُومَا يْصِيحُوا بْصُوتْ عَالِي: «النْجَاةْ مِنْ عَنْدْ إِلَاهْنَا القَاعِدْ عَالعَرْشْ ومِنْ عَنْدْ الخَرُوفْ!». <verse eid="REV 7:10" /><verse number="11" style="v" sid="REV 7:11" />ودَارُوا المْلَايْكَة الكُلْ بِالعَرْشْ ومْعَاهُمْ الشْيُوخْ والمَخْلُوقَاتْ الأَرْبْعَة، ورَكْعُوا قُدَّامْ العَرْشْ وسِجْدُوا لِلَّهْ، <verse eid="REV 7:11" /><verse number="12" style="v" sid="REV 7:12" />وقَالُوا:</para>
  <para style="b" vid="REV 7:12" />
  <para style="q1" vid="REV 7:12">«آمِينْ! الحَمْدْ والجَلَالْ والحِكْمَة</para>
  <para style="q2" vid="REV 7:12">والشُّكْرْ والكَرَامَة والقُوَّة والقُدْرَة</para>
  <para style="q1" vid="REV 7:12">لْإِلَاهْنَا لِلْأَبَدْ. آمِينْ!».<verse eid="REV 7:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13" />وَقْتْهَا سْإِلْنِي وَاحِدْ مِالشْيُوخْ: «شْكُونْهُمْ هَاذُومَا الِّي لَابْسِينْ جْبَايِبْ بْيُضْ؟ ومْنِينْ جَاوْ؟». <verse eid="REV 7:13" /><verse number="14" style="v" sid="REV 7:14" />جَاوِبْتُو: «يَا سِيدِي، إِنْتِ تَعْرِفْ». يَاخِي قَلِّي: «هَاذُومَا الِّي جَاوْ مِالمِحْنَة العْظِيمَة، ولِّي غَسْلُوا جْبَايِبْهُمْ ورَدُّوهُمْ بْيُضْ بْدَمْ الخَرُوفْ.<verse eid="REV 7:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="REV 7:15" />هَاذَاكَا عْلَاشْ هُومَا مَوْجُودِينْ قُدَّامْ عَرْشْ اللَّهْ</para>
  <para style="q2" vid="REV 7:15">ويِعْبْدُوهْ لِيلْ ونْهَارْ فِي الهَيْكِلْ مْتَاعُو،</para>
  <para style="q1" vid="REV 7:15">ولِّي قَاعِدْ عَالعَرْشْ يِحْمِيهُمْ بِحْضُورُو.<verse eid="REV 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="REV 7:16" />ومَا عَادِشْ بِشْ يْجُوعُوا ولَا يُعْطْشُوا،</para>
  <para style="q2" vid="REV 7:16">ومُشْ بِشْ تَضْرَبْهُمْ الشَّمْسْ ولَا تَحْرَقْهُمْ السْخَانَة<verse eid="REV 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 7:17" />عْلَى خَاطِرْ الخَرُوفْ الِّي فِي وِسْطْ العَرْشْ يِتْلْهَى بِيهُمْ كِيمَا الرَّاعِي،</para>
  <para style="q2" vid="REV 7:17">ويْوَصَّلْهُمْ لِعْيُونْ المَاء الحَيْ،</para>
  <para style="q1" vid="REV 7:17">واللَّهْ بِشْ يِمْسَحْ كُلْ دَمْعَة مِنْ عِينِيهُمْ».<verse eid="REV 7:17" /></para>
  <para style="b" />
  <chapter eid="REV 7" />
  <chapter number="8" style="c" sid="REV 8" />
  <para style="s">الخِتْمْ السَّابَعْ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1" />وكِي حَلْ الخَرُوفْ الخِتْمْ السَّابَعْ، صَارْ سْكَاتْ فِي السْمَاء قْرِيبْ النُّصْ سَاعَة. <verse eid="REV 8:1" /><verse number="2" style="v" sid="REV 8:2" />وشُفْتْ المْلَايْكَة السَّبْعَة الِّي وَاقْفِينْ قُدَّامْ اللَّهْ، تِعْطَالْهُمْ سَبْعَة أَبْوَاقْ. <verse eid="REV 8:2" /><verse number="3" style="v" sid="REV 8:3" />وجَاء مَلَاكْ آخِرْ هَازِزْ مَبْخْرَة ذْهَبْ ووْقِفْ بَحْذَا المَذْبَحْ، وتِعْطَالُو بَرْشَة بْخُورْ بَاشْ يْقَدْمُو مْعَ صْلَاوَاتْ القِدِّيسِينْ عْلَى مَذْبَحْ الذَهَّبْ الِّي قُدَّامْ العَرْشْ. <verse eid="REV 8:3" /><verse number="4" style="v" sid="REV 8:4" />يَاخِي طْلَعْ مِنْ يِدْ المَلَاكْ دُخَّانْ البْخُورْ ومْعَاهْ صْلَاوَاتْ القِدِّيسِينْ قُدَّامْ اللَّهْ. <verse eid="REV 8:4" /><verse number="5" style="v" sid="REV 8:5" />ومْبَعِّدْ هَزْ المَلَاكْ المَبْخْرَة، وعَبَّاهَا بِجْمَرْ مِالمَذْبَحْ، ورْمَاهَا عَالأَرْضْ، يَاخِي صَارِتْ أَصْوَاتْ وبَرْشَة بْرَقْ ورْعَدْ وزْلَازِلْ.<verse eid="REV 8:5" /></para>
  <para style="s">الأَبْوَاقْ السَّبْعَة</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6" />والسَّبْعَة مْلَايْكَة، الِّي عَنْدْهُمْ الأَبْوَاقْ السَّبْعَة، حَضّْرُوا رْوَاحْهُمْ بَاشْ يُنْفْخُوا فِيهَا.<verse eid="REV 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7" />نْفَخْ المَلَاكْ الأُوِّلْ فِي بُوقُو يَاخِي هْبَطْ عَالأَرْضْ تَبْرُورِي ونَارْ مْخَلْطِينْ بِالدَّمْ، وتِحْرَقْ ثْلُثْ الأَرْضْ وثْلُثْ الشْجَرْ والحْشِيشْ الأَخْضِرْ الكُلْ.<verse eid="REV 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8" />ونْفَخْ المَلَاكْ الثَّانِي فِي بُوقُو، وحَاجَة كَايِنْهَا جْبَلْ عْظِيمْ شَاعِلْ بِالنَّارْ طَاحِتْ فِي البْحَرْ، وثْلُثْ البْحَرْ وَلَّى دَمْ، <verse eid="REV 8:8" /><verse number="9" style="v" sid="REV 8:9" />ومَاتِتْ ثْلُثْ المَخْلُوقَاتْ الِّي فِي البْحَرْ، وادَّمْرِتْ ثْلُثْ البَابُورَاتْ.<verse eid="REV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10" />ونْفَخْ المَلَاكْ الثَّالِثْ فِي بُوقُو يَاخِي طَاحِتْ مِالسْمَاء نِجْمَة كْبِيرَة كَايِنْهَا مِشْعَلْ مِنْ نَارْ، وطَاحِتْ عْلَى ثْلُثْ الوِدْيَانْ وعْيُونْ المَاء. <verse eid="REV 8:10" /><verse number="11" style="v" sid="REV 8:11" />والنِّجْمَة اسْمْهَا عَلْقَمْ. يَاخِي ثْلُثْ المَاء وَلَّى مُرْ كِيفْ العَلْقَمْ، وبَرْشَة نَاسْ مَاتُوا مِنْ مْرَارِةْ المَاء.<verse eid="REV 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12" />ونْفَخْ المَلَاكْ الرَّابَعْ فِي بُوقُو، يَاخِي تِضْرَبْ ثْلُثْ الشَّمْسْ وثْلُثْ الڨَمْرَة وثْلُثْ النْجُومْ، حَتَّى لِينْ ظَلِّمْ ثْلُثْ ضَوْهُمْ، ووَلَّى ثْلُثْ النْهَارْ ظْلَامْ وثْلُثْ اللِّيلْ زَادَا.<verse eid="REV 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13" />وشُفْتْ وسْمَعْتْ نِسْرْ طَايِرْ فِي قَلْبْ السْمَاء يْصِيحْ بْصُوتْ عَالِي: «يَا وِيلْهُمْ! يَا وِيلْهُمْ! يَا وِيلْهُمْ سُكَّانْ الأَرْضْ مِلِّي يِسْتَنَّى فِيهُمْ وَقْتِلِّي يُنْفْخُوا المْلَايْكَة الثْلَاثَة الِّي مَزَّالُوا فِي أَبْوَاقْهُمْ».<verse eid="REV 8:13" /></para>
  <chapter eid="REV 8" />
  <chapter number="9" style="c" sid="REV 9" />
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1" />ونْفَخْ المَلَاكْ الخَامِسْ فِي بُوقُو، وشُفْتْ نِجْمَة طَايْحَة مِالسْمَاء لِلْأَرْضْ، وتِعْطَالْهَا مِفْتَاحْ بِيرْ الهَاوْيَة. <verse eid="REV 9:1" /><verse number="2" style="v" sid="REV 9:2" />ووَقْتِلِّي النِّجْمَة حَلِّتْ البِيرْ، خْرَجْ دُخَّانْ كَايِنُّو دُخَّانْ حْرِيقَة كْبِيرَة، وظْلَامُو الشَّمْسْ والهْوَاء مِالدُّخَّانْ الِّي طَالَعْ. <verse eid="REV 9:2" /><verse number="3" style="v" sid="REV 9:3" />وخْرَجْ مِالدُّخَّانْ جْرَادْ غَطَّى وِجْهْ الأَرْضْ، وتِعْطَاتْلُو قُوَّة بَاشْ يَلْدِغْ كِي العْقَارِبْ، <verse eid="REV 9:3" /><verse number="4" style="v" sid="REV 9:4" />وتِعْطَالُو أَمْرْ بَاشْ مَا يْضُرِّشْ حْشِيشْ الأَرْضْ والزَّرْعْ والشْجَرْ، آمَا يْضُرْ كَانْ النَّاسْ الِّي مَا عَنْدْهُمْشْ خِتْمْ اللَّهْ عْلَى جْبِينْهُمْ، <verse eid="REV 9:4" /><verse number="5" style="v" sid="REV 9:5" />وتِعْطَاتْلُو زَادَا سُلْطَة بَاشْ يْعَذَّبْهُمْ خَمْسَة شْهُورْ بِوْجَايَعْ كِيمَا وجَايَعْ لَدْغِةْ العَقْرِبْ، آمَا مَا يُقْتُلْهُمْشْ. <verse eid="REV 9:5" /><verse number="6" style="v" sid="REV 9:6" />وفِي النْهَارَاتْ هَاذُوكُمْ النَّاسْ بِشْ يُطْلْبُوا المُوتْ آمَا مَا يْرَاوْهَاشْ، وبِشْ يِتْمَنَّاوْ يْمُوتُوا والمُوتْ بِشْ تُهْرُبْ مِنْهُمْ.<verse eid="REV 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7" />والجْرَادْ يُظْهُرْ كَايِنُّو حْصُنَّة حَاضْرَة لِلْحَرْبْ، فُوقْ رْيُوسْهُمْ حَاجَة تْشَبَّهْ لْتِيجَانْ ذْهَبْ، ووْجُوهْهُمْ كِيفْ وْجُوهْ البَشَرْ، <verse eid="REV 9:7" /><verse number="8" style="v" sid="REV 9:8" />عَنْدْهُمْ شْعَرْ كِي شْعَرْ النْسَاء وسِنِّيهُمْ كِي سِنِّينْ الصْيُودَا، <verse eid="REV 9:8" /><verse number="9" style="v" sid="REV 9:9" />صْدُورَاتْهُمْ كَايِنْهَا دْرُوعْ مِالحْدِيدْ، وحِسْ جْوَانَحْهُمْ كِي حِسْ بَرْشَة كَرُّوسَاتْ تِجْرِي بِيهُمْ الحْصُنَّة لِلْحَرْبْ، <verse eid="REV 9:9" /><verse number="10" style="v" sid="REV 9:10" />وذْيُولْهُمْ فِيهَا أَبَارِي كِيمَا ذْيُولْ العْقَارِبْ، عَنْدْهُمْ القُدْرَة يْضُرُّوا بِيهَا النَّاسْ لْمُدِّةْ خَمْسَة شْهُرْ. <verse eid="REV 9:10" /><verse number="11" style="v" sid="REV 9:11" />ومَلِكْهُمْ هُوَّ مَلَاكْ الهَاوْيَة، وإِسْمُو بِالعِبْرِيَّة «أَبَدُّونْ»، وبِاليُونَانِي «أَبُولِّيُونْ».<verse eid="REV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12" />وتْعَدَّى الوِيلْ الأُوِّلْ، ومَزَّالُوا وِيلِينْ أُخْرِينْ خَالْطِينْ بَعْدُو!<verse eid="REV 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13" />ونْفَخْ المَلَاكْ السَّادِسْ فِي بُوقُو، وسْمَعْتْ صُوتْ خَارِجْ مِالأَرْبْعَة ڨْرُونْ مْتَاعْ مَذْبَحْ الذْهَبْ الِّي قُدَّامْ اللَّهْ، <verse eid="REV 9:13" /><verse number="14" style="v" sid="REV 9:14" />قَالْ لِلْمَلَاكْ السَّادِسْ الِّي عَنْدُو البُوقْ: «سَيِّبْ الأَرْبْعَة مْلَايْكَة الِّي مَرْبُوطِينْ فِي نَهْرْ الفُرَاتْ الكْبِيرْ». <verse eid="REV 9:14" /><verse number="15" style="v" sid="REV 9:15" />وتْسَيْبُوا المْلَايْكَة الأَرْبْعَة الِّي كَانُوا مُسْتْعَدِّينْ لِلسَّاعَة واليُومْ والشْهَرْ والعَامْ، بَاشْ يُقْتْلُوا ثْلُثْ البَشَرْ. <verse eid="REV 9:15" /><verse number="16" style="v" sid="REV 9:16" />وسْمَعْتْ الِّي عْدَدْ الفُرْسَانْ كَانْ 200 مَلْيُونْ. <verse eid="REV 9:16" /><verse number="17" style="v" sid="REV 9:17" />وفِي الرُّؤْيَا، شُفْتْ الحْصُنَّة والفُرْسَانْ الرَّاكْبِينْ عْلِيهُمْ لَابْسِينْ دْرُوعْ لُونْهُمْ أَحْمِرْ كِي النَّارْ وأَزْرَقْ كِي اليَاقُوتْ وأَصْفِرْ كِي الكِبْرِيتْ. والحْصُنَّة رْيُوسْهُمْ كِي رْيُوسْ الصْيُودَا، وتْخَرِّجْ مِنْ أَفَّامْهَا فِي نَارْ ودُخَّانْ وكِبْرِيتْ. <verse eid="REV 9:17" /><verse number="18" style="v" sid="REV 9:18" />ومَاتُوا ثْلُثْ النَّاسْ بِالبْلَاوَاتْ الثْلَاثَة الخَارْجَة مِنْ أَفَّامْ الحْصُنَّة: النَّارْ والدُّخَّانْ والكِبْرِيتْ. <verse eid="REV 9:18" /><verse number="19" style="v" sid="REV 9:19" />وقُوِّةْ الحْصُنَّة كَانِتْ فِي أَفَّامْهُمْ وفِي ذْيُولْهُمْ. وكَانِتْ ذْيُولْهُمْ تْشَبَّهْ لِلْحْنُوشَة، وعَنْدْهَا رْيُوسْ ضَارَّة.<verse eid="REV 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20" />آمَا بْقِيِّةْ النَّاسْ الِّي مَا مَاتُوشْ بِالبْلَاوَاتْ هَاذُومَا، مَا تَابُوشْ عَلِّي عَمْلُوهْ، وقَعْدُوا يِعْبْدُوا فِي الشْوَاطِنْ والصْنَبْ الِّي صَنْعُوهَا مِالذْهَبْ والفِضَّة والنْحَاسْ والحْجَرْ واللُّوحْ، وهِيَّ لَا تْشُوفْ ولَا تِسْمَعْ ولَا تِمْشِي! <verse eid="REV 9:20" /><verse number="21" style="v" sid="REV 9:21" />ومَا تَابُوشْ عْلَى قَتْلْهُمْ وسِحْرْهُمْ وزْنَاهُمْ وسِرْقِتْهُمْ.<verse eid="REV 9:21" /></para>
  <chapter eid="REV 9" />
  <chapter number="10" style="c" sid="REV 10" />
  <para style="s">المَلَاكْ والكْتَابْ الصْغِيرْ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1" />ومْبَعِّدْ شُفْتْ مَلَاكْ آخِرْ قْوِيْ هَابِطْ مِالسْمَاء مَلْفُوفْ بْغِيمَة، وفُوقْ رَاسُو قَوْسْ قُزَحْ، ووِجْهُو كِيفْ الشَّمْسْ، وسَاقِيهْ كِي زُوزْ عْرُصْ نَارْ، <verse eid="REV 10:1" /><verse number="2" style="v" sid="REV 10:2" />وفِي يِدُّو كْتَابْ صْغِيرْ مَحْلُولْ. وحَطْ سَاقُو اليْمِينْ عَالبْحَرْ واليْسَارْ عَالبَرْ. <verse eid="REV 10:2" /><verse number="3" style="v" sid="REV 10:3" />وصَاحْ صِيحَة كْبِيرَة كَايِنُّو صِيدْ يِزْئِرْ، بَعْدْهَا تِسْمَعّْ صُوتْ الرْعُودْ السَّبْعَة. <verse eid="REV 10:3" /><verse number="4" style="v" sid="REV 10:4" />ووَقْتِلِّي نَطْقُوا الرْعُودْ السَّبْعَة، حَضَّرْتْ رُوحِي بَاشْ نِكْتِبْ، يَاخِي سْمَعْتْ صُوتْ مِالسْمَاء يْقُلِّي: «مَا تِكْتِبْشْ الِّي نَطْقِتْ بِيهْ الرْعُودْ السَّبْعَة، خَلِّيهْ سِرْ».<verse eid="REV 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5" />والمَلَاكْ الِّي شُفْتُو وَاقِفْ عَالبْحَرْ والبَرْ هَزْ يِدُّو اليْمِينْ لِلسْمَاء <verse eid="REV 10:5" /><verse number="6" style="v" sid="REV 10:6" />وحْلِفْ بِالحَيْ لِلْأَبَدْ خَالِقْ السْمَاء ولِّي فِيهَا، والأَرْضْ ولِّي فِيهَا، والبْحَرْ ولِّي فِيهْ، وقَالْ مَا عَادِشْ فَمَّة حَتَّى مُهْلَة. <verse eid="REV 10:6" /><verse number="7" style="v" sid="REV 10:7" />آمَا كِي يْجِي الوَقْتْ، ويُنْفُخْ المَلَاكْ السَّابَعْ فِي بُوقُو، وَقْتْهَا سِرْ اللَّهْ يْتِمْ، كِيمَا بَشْرُوا بِيهْ عْبِيدُو الأَنْبِيَاءْ.<verse eid="REV 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8" />والصُّوتْ الِّي سْمَعْتُو مِالسْمَاء، كَلَّمْنِي مَرَّة أُخْرَى وقَالِّي: «إِمْشِي خُوذْ الكْتَابْ الصْغِيرْ المَحْلُولْ، الِّي فِي يِدْ المَلَاكْ الوَاقِفْ عَالبْحَرْ والبَرْ». <verse eid="REV 10:8" /><verse number="9" style="v" sid="REV 10:9" />ومْشِيتْ لِلْمَلَاكْ وطْلَبْتْ مِنُّو بَاشْ يَعْطِينِي الكْتَابْ الصْغِيرْ، يَاخِي قَالِّي: «خُوذُو وكُولُو، بِشْ يْكُونْ مُرْ فِي مَعْدْتِكْ، آمَا حْلُوْ كِي العْسَلْ فِي فُمِّكْ!». <verse eid="REV 10:9" /><verse number="10" style="v" sid="REV 10:10" />وخْذِيتْ الكْتَابْ الصْغِيرْ مِنْ يِدْ المَلَاكْ وكْلِيتُو، وكَانْ حْلُوْ فِي فُمِّي كِي العْسَلْ، آمَا بَعْدْمَا كْلِيتُو، مَعْدْتِي تِمْلَاتْ بِالمْرَارَة. <verse eid="REV 10:10" /><verse number="11" style="v" sid="REV 10:11" />وقَالُولِي: «لَازْمِكْ تِتْنَبَّأْ مَرَّة أُخْرَى عْلَى بَرْشَة شْعُوبْ وأُمَمْ ولُوغَاتْ ومُلُوكْ».<verse eid="REV 10:11" /></para>
  <chapter eid="REV 10" />
  <chapter number="11" style="c" sid="REV 11" />
  <para style="s">الزُّوزْ شْهُودْ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1" />وفَمَّة شْكُونْ عْطَانِي عْصَا يْقِيسُو بِيهَا وقَالِّي: «قُومْ! قِيسْ هَيْكِلْ اللَّهْ والمَذْبَحْ، وإِحْسِبْ قَدَّاشْ فَمَّة سَاجْدِينْ غَادِي. <verse eid="REV 11:1" /><verse number="2" style="v" sid="REV 11:2" />آمَا سَاحِةْ الهَيْكِلْ البَرَّانِيَّة خَلِّيهَا مَا تْقِيسْهَاشْ، عْلَى خَاطِرْهَا تِعْطَاتْ لِلشُّعُوبْ الأُخْرِينْ، وهُومَا بِشْ يْعَفْسُوا المْدِينَة المُقَدْسَة لْمُدِّةْ 42 شْهَرْ. <verse eid="REV 11:2" /><verse number="3" style="v" sid="REV 11:3" />وبِشْ نِبْعَثْ شْهُودِي الزُّوزْ، وبِشْ يِتْنَبْؤُوا 1 260 يُومْ، وهُومَا لَابْسِينْ خْيِشْ».<verse eid="REV 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4" />والزُّوزْ شْهُودْ هُومَا الزُّوزْ زِيتُونَاتْ والزُّوزْ فْنَارَاتْ الوَاقْفِينْ قُدَّامْ رَبْ الأَرْضْ. <verse eid="REV 11:4" /><verse number="5" style="v" sid="REV 11:5" />إِذَا حَاوِلْ حَدْ يْضُرْهُمْ، تُخْرُجْ مِنْ أَفَّامْهُمْ نَارْ وتَاكِلْ أَعْدَاهُمْ. كُلْ مِنْ يْحَاوِلْ يْضُرْهُمْ، يِتْقْتَلْ بْنَفْسْ الطَرِيقَة. <verse eid="REV 11:5" /><verse number="6" style="v" sid="REV 11:6" />وعَنْدْهُمْ السُّلْطَة بَاشْ يْسَكْرُوا السْمَاء ومَا يْخَلِّيوِشْ المْطَرْ تْصُبْ طُولْ المُدَّة الِّي يِتْنَبْؤُوا فِيهَا، وبَاشْ يْخَلِّيوْ المَاء يْوَلِّي دَمْ، ويْهَبْطُوا البْلَاوَاتْ بْأَنْوَاعْهَا عَالأَرْضْ، وَقْتِلِّي يْحِبُّوا.<verse eid="REV 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7" />وكِي يْكَمْلُوا شْهَادِتْهُمْ، الوَحْشْ الطَّالَعْ مِالهَاوْيَة بِشْ يِحَارِبْهُمْ ويِغْلِبْهُمْ ويُقْتُلْهُمْ. <verse eid="REV 11:7" /><verse number="8" style="v" sid="REV 11:8" />وتِبْقَى جُثَثْهُمْ مْطَيْشَة فِي سَاحِةْ المْدِينَة العْظِيمَة وِينْ تِصْلَبْ رَبْهُمْ، الِّي تْسَمَّاتْ عْلَى سَدُومْ وَلَّا مَصْرْ الِّي هُومَا رَمْزْ لِيهَا. <verse eid="REV 11:8" /><verse number="9" style="v" sid="REV 11:9" />وبِشْ يْرَاوْهُمْ نَاسْ مِنْ كُلْ شَعْبْ وعَرْشْ ولُوغَة وأُمَّة، لْمُدِّةْ ثْلَاثَة أَيَّامْ ونُصْ، ومُشْ بِشْ يْخَلِّيوْ حَتَّى حَدْ يِدْفِنْهُمْ. <verse eid="REV 11:9" /><verse number="10" style="v" sid="REV 11:10" />وبِشْ يِتْشَمْتُوا فِيهُمْ سُكَّانْ الأَرْضْ، ويِفْرْحُوا كَايِنُّو عَنْدْهُمْ عِيدْ، ويِهْدِيوْ لِبْعَضْهُمْ هْدَايَا، عْلَى خَاطِرْ الزُّوزْ أَنْبِيَاءْ هَاذُومَا عَذْبُوهُمْ بَرْشَة.<verse eid="REV 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 11:11" />وبَعْدْ ثْلَاثَة أَيَّامْ ونُصْفْ، رَجَّعْ اللَّهْ الرُّوحْ فِي الزُّوزْ أَنْبِيَاءْ، ووِقْفُوا عْلَى سَاقِيهُمْ. ولِّي شَافُوهُمْ مْكِنْهُمْ خُوفْ كْبِيرْ. <verse eid="REV 11:11" /><verse number="12" style="v" sid="REV 11:12" />وسَمْعُوا الزُّوزْ أَنْبِيَاءْ صُوتْ عَالِي مِالسْمَاء يْقُولِلْهُمْ: «إِطْلْعُوا لَهْنَا»، يَاخِي طَلْعُوا لِلسْمَاء فِي سْحَابَة قُدَّامْ عِينِينْ أَعْدَاهُمْ.<verse eid="REV 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 11:13" />وفِي نَفْسْ الوَقْتْ، صَارْ زِلْزَالْ كْبِيرْ، وادَّمِّرْ عْشُرْ المْدِينَة، ومَاتُو 7 000 وَاحِدْ، ولِّي مَنْعُوا تْرِعْبُوا وبْدَاوْ يْمَجْدُوا فِي إِلَاهْ السْمَاء.<verse eid="REV 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14" />تْعَدَّى الوِيلْ الثَّانِي، والوِيلْ الثَّالِثْ هَاوْ جَايْ فِيسَعْ.<verse eid="REV 11:14" /></para>
  <para style="s">البُوقْ السَّابَعْ</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15" />ونْفَخْ المَلَاكْ السَّابَعْ فِي بُوقُو، وتْسَمْعِتْ أَصْوَاتْ عَالْيَة فِي السْمَاء تْقُولْ:</para>
  <para style="b" vid="REV 11:15" />
  <para style="q1" vid="REV 11:15">«مُلْكْ العَالِمْ وَلَّى</para>
  <para style="q2" vid="REV 11:15">لْرَبْنَا ومَسِيحُو.</para>
  <para style="q1" vid="REV 11:15">هُوَّ بِشْ يِمْلِكْ لْأَبَدْ الآبِدِينْ».<verse eid="REV 11:15" /></para>
  <para style="b" />
  <para style="m">
    <verse number="16" style="v" sid="REV 11:16" />ورَكْعُوا الـ24 شِيخْ الِّي قَاعْدِينْ عْلَى عْرُوشَاتْهُمْ قُدَّامْ اللَّهْ وسِجْدُولُو <verse eid="REV 11:16" /><verse number="17" style="v" sid="REV 11:17" />وقَالُوا:</para>
  <para style="b" vid="REV 11:17" />
  <para style="q1" vid="REV 11:17">«نُشْكْرُوكْ يَا رَبْنَا، يَا إِلَاهْنَا القَادِرْ عْلَى كُلْ شَيْ،</para>
  <para style="q2" vid="REV 11:17">المَوْجُودْ تَوَّا ولِّي مَوْجُودْ مِنْ قْبَلْ،</para>
  <para style="q1" vid="REV 11:17">عْلَى خَاطْرِكْ وَرِّيتْ قُدْرْتِكْ العْظِيمَة ومْلِكْتْ.<verse eid="REV 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18" />الشُّعُوبْ تْغَشْشُوا عْلِيكْ، آمَا هَاوْ جَاء وَقْتْ غُشِّكْ عْلِيهُمْ.</para>
  <para style="q2" vid="REV 11:18">جَاء الوَقْتْ الِّي تُحْكُمْ فِيهْ عَلِّي مَاتُوا،</para>
  <para style="q1" vid="REV 11:18">وتْجَازِي عَبِيدِكْ الأَنْبِيَاءْ والقِدِّيسِينْ</para>
  <para style="q2" vid="REV 11:18">ولِّي خَافُوا إِسْمِكْ كْبَارْ وصْغَارْ،</para>
  <para style="q1" vid="REV 11:18">وتِهْلِكْ الِّي كَانُوا يِهْلْكُوا فِي الأَرْضْ!».<verse eid="REV 11:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19" />وتْحَلْ هَيْكِلْ اللَّهْ فِي السْمَاء، وظْهُرْ تَابُوتْ العَهْدْ فِي الهَيْكِلْ، وصَارْ بَرْشَة بْرَقْ وأَصْوَاتْ وبَرْشَة رْعَدْ وزِلْزَالْ، وتَبْرُورِي قْوِيْ.<verse eid="REV 11:19" /></para>
  <chapter eid="REV 11" />
  <chapter number="12" style="c" sid="REV 12" />
  <para style="s">المْرَا والتِّنِّينْ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1" />وظُهْرِتْ أَمَارَة عْجِيبَة فِي السْمَاء: مْرَا لَابْسَة الشَّمْسْ، والڨَمْرَة تَحْتْ سَاقِيهَا، وفُوقْ رَاسْهَا تَاجْ فِيهْ أَثْنَاشِنْ نِجْمَة. <verse eid="REV 12:1" /><verse number="2" style="v" sid="REV 12:2" />والمْرَا كَانِتْ حِبْلَى، وتْصِيحْ مِالوْجَايَعْ عْلَى خَاطِرْ شَدْهَا الحِسْ. <verse eid="REV 12:2" /><verse number="3" style="v" sid="REV 12:3" />وظُهْرِتْ أَمَارَة أُخْرَى فِي السْمَاء: تِنِّينْ أَحْمِرْ عْظِيمْ عَنْدُو سَبْعَة رْيُوسْ وعَشْرَة ڨْرُونْ، وعْلَى كُلْ رَاسْ تَاجْ، <verse eid="REV 12:3" /><verse number="4" style="v" sid="REV 12:4" />جْبِدْ بْذِيلُو ثْلُثْ نْجُومْ السْمَاء، ورْمَاهُمْ عَالأَرْضْ. ووْقِفْ التِّنِّينْ قُدَّامْ المْرَا الِّي شَادْهَا الحِسْ بَاشْ يِبْلَعْ صْغِيرْهَا دُوبْ مَا يِتْوْلِدْ. <verse eid="REV 12:4" /><verse number="5" style="v" sid="REV 12:5" />وجَابِتْ وْلَيِّدْ، وهُوَّ الِّي بِشْ يُحْكُمْ فِي الشُّعُوبْ الكُلْ بِعْصَا حْدِيدْ، آمَا تِخْطَفْ الوْلَيِّدْ وتْهَزْ بَحْذَا اللَّهْ وعَرْشُو. <verse eid="REV 12:5" /><verse number="6" style="v" sid="REV 12:6" />وهَرْبِتْ المْرَا لِلصَّحْرَاء وِينْ اللَّهْ حَضْرِلْهَا بْلَاصَة وِينْ بِشْ يِتْلْهَى بِيهَا لْمُدِّةْ 1 260 يُومْ.<verse eid="REV 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7" />وصَارِتْ حَرْبْ فِي السْمَاء: مِيخَائِيلْ ومْلَايِكْتُو حَارْبُوا التِّنِّينْ، والتِّنِّينْ حَارِبْهُمْ مْعَ مْلَايِكْتُو، <verse eid="REV 12:7" /><verse number="8" style="v" sid="REV 12:8" />آمَا التِّنِّينْ ومْلَايِكْتُو خَسْرُوا، وخَسْرُوا بْلَاصِتْهُمْ فِي السْمَاء. <verse eid="REV 12:8" /><verse number="9" style="v" sid="REV 12:9" />واطَّيِّشْ التِّنِّينْ العْظِيمْ لِلْأَرْضْ. هَاذَا هُوَّ اللَّفْعَى القْدِيمَة، ويِتْسَمَّى إِبْلِيسْ وَلَّا الشِّيطَانْ، الِّي يْغُرْ بِالعَالِمْ الكُلْ. واطَّيْشِتْ مْعَاهْ مْلَايِكْتُو. <verse eid="REV 12:9" /><verse number="10" style="v" sid="REV 12:10" />وبَعْدْ سْمَعْتْ صُوتْ عَالِي فِي السْمَاء يْقُولْ: «اليُومْ تَمِّتْ النْجَاةْ، القُوَّة والمُلْكْ لْإِلَاهْنَا، والسُّلْطَة لْمَسِيحُو، عْلَى خَاطِرْ الِّي كَانْ يِتْهِمْ فِي خْوَاتْنَا قُدَّامْ إِلَاهْنَا لِيلْ ونْهَارْ إِطَّيِّشْ. <verse eid="REV 12:10" /><verse number="11" style="v" sid="REV 12:11" />وهُومَا غِلْبُوهْ بْدَمْ الخَرُوفْ، وبِشْهَادِتْهُمْ لِيهْ، ومَا كَانِتْشْ حْيَاتْهُمْ عْزِيزَة عْلِيهُمْ، حَتَّى قُدَّامْ المُوتْ. <verse eid="REV 12:11" /><verse number="12" style="v" sid="REV 12:12" />مَالَا إِفْرَحْ يَا سْمَاء وإِفْرْحُوا يَلِّي سَاكْنِينْ فِيهَا! ويَا وِيلُكُمْ يَا أَهْلْ البَرْ والبْحَرْ. رَاهُو إِبْلِيسْ هْبَطِّلْكُمْ وهُوَّ مِتْغَشِّشْ بَرْشَة عْلَى خَاطْرُو يَعْرِفْ الِّي أَيَّامَاتُو مَحْسُوبَة».<verse eid="REV 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13" />وكِي شَافْ التِّنِّينْ الِّي هُوَّ إِطَّيِشْ لِلْأَرْضْ، وَلَّى يْحَاوِزْ فِي المْرَا الِّي جَابِتْ الوْلَيِّدْ، <verse eid="REV 12:13" /><verse number="14" style="v" sid="REV 12:14" />آمَا المْرَا تِعْطَاوْلْهَا جْوَانَحْ نِسْرْ كْبِيرْ بَاشْ اطِّيرْ بِيهُمْ لِلصَّحْرَاء، وِينْ بِشْ يِتْلْهَاوْ بِيهَا لْمُدِّةْ ثْلَاثَة سْنِينْ ونُصْ بْعِيدْ عَاللَّفْعَى. <verse eid="REV 12:14" /><verse number="15" style="v" sid="REV 12:15" />وخَرّْجِتْ اللَّفْعَى مِنْ فُمْهَا مَاء كِيفْ الوَادْ جْرَى وْرَاء المْرَا بَاشْ يْغَرَّقْهَا. <verse eid="REV 12:15" /><verse number="16" style="v" sid="REV 12:16" />آمَا الأَرْضْ عَاوْنِتْ المْرَا، وحَلِّتْ فُمْهَا وبَلْعِتْ الوَادْ الِّي خَرْجُو التِّنِّينْ مِنْ فُمُّو. <verse eid="REV 12:16" /><verse number="17" style="v" sid="REV 12:17" />يَاخِي تْغَشِّشْ التِّنِّينْ عَالمْرَا، ومْشَى يْحَارِبْ فِي بَاقِي ذُرِّيِّتْهَا الِّي يْطِيعُوا فِي وْصَايَا اللَّهْ ويِشْهْدُوا لْيَسُوعْ.<verse eid="REV 12:17" /></para>
  <chapter eid="REV 12" />
  <chapter number="13" style="c" sid="REV 13" />
  <para style="s">الوَحْشْ الخَارِجْ مِالبْحَرْ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1" />ومْبَعِّدْ وْقُفْتْ عْلَى شَطْ البْحَرْ، وشُفْتْ وَحْشْ خَارِجْ مِالبْحَرْ عَنْدُو عَشْرَة ڨْرُونْ وسَبْعَة رُيُوسْ، عْلَى كُلْ ڨَرْنْ تَاجْ، وكُلْ رَاسْ مَكْتُوبْ عْلِيهْ إِسْمْ يْهِينْ اللَّهْ. <verse eid="REV 13:1" /><verse number="2" style="v" sid="REV 13:2" />والوَحْشْ الِّي شُفْتُو كَانْ يْشَبَّهْ لِلنِّمْرْ، وسَاقِيهْ كِي سَاقِينْ الدِّبْ وفُمُّو كِي فُمْ الصِّيدْ. وعْطَاهْ التِّنِّينْ قُوْتُو وعَرْشُو وسُلْطَة كْبِيرَة. <verse eid="REV 13:2" /><verse number="3" style="v" sid="REV 13:3" />وظْهُرْ رَاسْ مِنْ رْيُوسْ الوَحْشْ كَايِنُّو مَجْرُوحْ جُرْحْ مْتَاعْ مُوتْ، آمَا الجُرْحْ بْرَا، يَاخِي تْبَهْرُوا سُكَّانْ الأَرْضْ الكُلْ، وتَبْعُوا الوَحْشْ. <verse eid="REV 13:3" /><verse number="4" style="v" sid="REV 13:4" />والنَّاسْ سِجْدُوا لِلتِّنِّينْ عْلَى خَاطْرُو عْطَى سُلْطَتُو لِلْوَحْشْ، وعِبْدُوا الوَحْشْ وقَالُوا: «شْكُونْ كِيفْ هَا الوَحْشْ؟ وشْكُونْ يْنَجِّمْ يْحَارْبُو؟».<verse eid="REV 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5" />وتِعْطَى لِلْوَحْشْ فُمْ يَنْطَقْ بِكْلَامْ التَّكَبُّرْ والكُفْرْ، وسُلْطَة بَاشْ يَعْمِلْ الِّي يْحِبْ لْمُدِّةْ 42 شْهَرْ. <verse eid="REV 13:5" /><verse number="6" style="v" sid="REV 13:6" />وبْدَا يَكْفِرْ عْلَى اللَّهْ، ويْسِبْ فِي إِسْمُو ووِينْ يُسْكُنْ، وفِي السَّاكْنِينْ فِي السْمَاء. <verse eid="REV 13:6" /><verse number="7" style="v" sid="REV 13:7" />وتِعْطَاتْلُو قُوَّة بَاشْ يْحَارِبْ القِدِّيسِينْ ويِغْلِبْهُمْ، وتِعْطَاتْلُو سُلْطَة عْلَى كُلْ عَرْشْ وشَعْبْ ولُوغَة وأُمَّة، <verse eid="REV 13:7" /><verse number="8" style="v" sid="REV 13:8" />ويِسْجْدُولُو السَّاكْنِينْ فِي الأَرْضْ الكُلْ، الِّي أَسَامِيهُمْ مَا تْكِتْبِتْشْ فِي كْتَابْ الحَيَاةْ مِلِّي تْخَلْقِتْ الدِّنْيَا، كْتَابْ الخَرُوفْ الِّي تِذْبَحْ. <verse eid="REV 13:8" /><verse number="9" style="v" sid="REV 13:9" />الِّي عَنْدُو وِذْنِينْ تِسْمَعْ خَلِّيهْ يِسْمَعْ:<verse eid="REV 13:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="REV 13:10" />الِّي مْصِيرُو الحَبْسْ</para>
  <para style="q2" vid="REV 13:10">بِشْ يِتْحْبِسْ،</para>
  <para style="q1" vid="REV 13:10">ولِّي مْصِيرُو السِّيفْ</para>
  <para style="q2" vid="REV 13:10">بِشْ يْمُوتْ بْسِيفْ!</para>
  <para style="b" vid="REV 13:10" />
  <para style="m" vid="REV 13:10">هْنَا يُظْهُرْ صَبْرْ القِدِّيسِينْ وإِيمَانْهُمْ.<verse eid="REV 13:10" /></para>
  <para style="s">الوَحْشْ الطَّالَعْ مِالأَرْضْ</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11" />ومْبَعِّدْ شُفْتْ وَحْشْ آخِرْ طَالَعْ مِالأَرْضْ، عَنْدُو زُوزْ ڨْرُونْ كِيمَا خَرُوفْ، آمَا يِتْكَلِّمْ كِيفْ التِّنِّينْ. <verse eid="REV 13:11" /><verse number="12" style="v" sid="REV 13:12" />وإِسْتَعْمِلْ سُلْطِةْ الوَحْشْ الأُوِّلْ الكُلْ فِي حْضُورُو، وجْبَرْ سُكَّانْ الأَرْضْ بَاشْ يِسْجْدُوا لِلْوَحْشْ الأُوِّلْ الِّي بْرَا مِنْ جُرْحُو الِّي يُقْتِلْ. <verse eid="REV 13:12" /><verse number="13" style="v" sid="REV 13:13" />وعْمَلْ مُعْجْزَاتْ كْبِيرَة وخَلَّى حَتَّى النَّارْ تَهْبِطْ مِالسْمَاء عَالأَرْضْ قُدَّامْ عِينِينْ النَّاسْ، <verse eid="REV 13:13" /><verse number="14" style="v" sid="REV 13:14" />وعَدَّاهَا عْلَى سُكَّانْ الأَرْضْ بِالمُعْجْزَاتْ الِّي تِعْطَاتْلُو القُدْرَة بَاشْ يَعْمِلْهَا فِي حْضُورْ الوَحْشْ الأُوِّلْ. وعْطَاهُمْ أَمْرْ بَاشْ يَعْمْلُوا تِمْثَالْ لِلْوَحْشْ الِّي جَرْحُو السِّيفْ ومْعَ هَاذَا قْعَدْ حَيْ. <verse eid="REV 13:14" /><verse number="15" style="v" sid="REV 13:15" />وتِعْطَاتْلُو السُّلْطَة بَاشْ يَبْعَثْ الرُّوحْ فِي تِمْثَالْ الوَحْشْ ويْخَلِّي التِمْثَالْ يَنْطَقْ، ويُقْتُلْ الِّي مَا حَبُّوشْ يِسْجْدُولُو الكُلْ. <verse eid="REV 13:15" /><verse number="16" style="v" sid="REV 13:16" />والوَحْشْ الثَّانِي جْبَرْ النَّاسْ الكُلْ، صْغَارْ وكْبَارْ، غُنْيَا وفْقَارَى، عَبِيدْ وأَحْرَارْ، بَاشْ يْحُطُّوا أَمَارَة عْلَى يِدْهُمْ اليْمِينْ وَلَّا عْلَى جْبِينْهُمْ، <verse eid="REV 13:16" /><verse number="17" style="v" sid="REV 13:17" />بَاشْ مَا يْنَجِّمْ حَتَّى حَدْ لَا يْبِيعْ ولَا يِشْرِي إِلَّا إِذَا كَانْ عَنْدُو الأَمَارَة، الِّي هِيَّ إِسْمْ الوَحْشْ، وَلَّا الرَّقْمْ الِّي يُرْمُزْ لْإِسْمُو! <verse eid="REV 13:17" /><verse number="18" style="v" sid="REV 13:18" />وهُونِي الحِكْمَة لَازْمَة: الِّي ذْكِيْ يِحْسِبْ رَقْمْ الوَحْشْ. عْلَى خَاطْرُو رَقْمْ إِنْسَانْ، وهُوَّ 666.<verse eid="REV 13:18" /></para>
  <chapter eid="REV 13" />
  <chapter number="14" style="c" sid="REV 14" />
  <para style="s">تَرْنِيمِةْ المِفْدِيِّيِنْ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1" />ومْبَعِّدْ خْزَرْتْ، وشُفْتْ الخَرُوفْ وَاقِفْ فُوقْ جْبَلْ صِهْيَوْنْ، ومْعَاهْ 144 000، مَكْتُوبْ عْلَى جْبِينْهُمْ إِسْمُو وإِسْمْ بُوهْ. <verse eid="REV 14:1" /><verse number="2" style="v" sid="REV 14:2" />وسْمَعْتْ مِالسْمَاء صُوتْ كَايِنُّو صُوتْ شَلَّالْ كْبِيرْ وَلَّا صُوتْ رْعَدْ قْوِيْ. وكَانْ الصُّوتْ الِّي سْمَعْتُو يْشَبَّهْ لْمُوسِيقِةْ الِّي يَعْزْفُوا عَالقِيثَارَاتْ، <verse eid="REV 14:2" /><verse number="3" style="v" sid="REV 14:3" />وكَانُوا يْرَنْمُوا فِي تَرْنِيمَة جْدِيدَة قُدَّامْ العَرْشْ وقُدَّامْ المَخْلُوقَاتْ الحَيَّة الأَرْبْعَة وقُدَّامْ الشْيُوخْ. وحَتَّى حَدْ مَا نَجِّمْ يِتْعَلَّمْ التَّرْنِيمَة هَاذِيكَا كَانْ الـ144 000 الِّي تِفْدَاوْ مِالأَرْضْ. <verse eid="REV 14:3" /><verse number="4" style="v" sid="REV 14:4" />هَاذُومَا مَا نَجْسُوشْ رْوَاحْهُمْ مْعَ النْسَاء، وبْقَاوْ طَاهْرِينْ، ويْتَبْعُوا فِي الخَرُوفْ وِينْ مَا يِمْشِي. هُومَا المِفْدِيِّيِنْ مِنْ بِينْ النَّاسْ، وكَانُوا كِيمَا أَوِّلْ قُرْبَانْ يِتْقَدِّمْ لِلَّهْ ولِلْخَرُوفْ. <verse eid="REV 14:4" /><verse number="5" style="v" sid="REV 14:5" />أَفَّامْهُمْ مَا نَطْقِتْشْ بِالكِذْبْ، مَا فِيهُمْ حَتَّى عِيبْ.<verse eid="REV 14:5" /></para>
  <para style="s">المْلَايْكَة الثْلَاثَة</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6" />مْبَعِّدْ شُفْتْ مَلَاكْ آخِرْ طَايِرْ فِي قَلْبْ السْمَاء، عَنْدُو بْشَارَة ادُّومْ لِلْأَبَدْ، يْبَشَّرْ بِيهَا فِي سُكَّانْ الأَرْضْ، مِنْ كُلْ أُمَّة وعَرْشْ ولُوغَة وشَعْبْ. <verse eid="REV 14:6" /><verse number="7" style="v" sid="REV 14:7" />وقَالْ بْصُوتْ عَالِي: «خَافُوا اللَّهْ ومَجْدُوهْ، خَاطِرْ جَاتْ سَاعِةْ الحْسَابْ. إِسْجْدُوا لِلِّي خْلَقْ السْمَاء والأَرْضْ والبْحَرْ وعْيُونْ المَاء». <verse eid="REV 14:7" /><verse number="8" style="v" sid="REV 14:8" />وتَبْعُو مَلَاكْ ثَانِي وقَالْ: «طَاحِتْ! طَاحِتْ مْدِينِةْ بَابِلْ العْظِيمَة! الِّي سْقَاتْ الشُّعُوبْ الكُلْ مِنْ شْرَابْ زْنَاهَا الِّي يْجِيبْ الغَضَبْ!».<verse eid="REV 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9" />وتَبَّعْهُمْ مَلَاكْ ثَالِثْ يْقُولْ بْصُوتْ عَالِي: «الِّي يِسْجِدْ لِلْوَحْشْ وتِمْثَالُو، ويِقْبِلْ يْحُطْ أَمَارْتُو عْلَى يِدُّو وَلَّا عْلَى جْبِينُو، <verse eid="REV 14:9" /><verse number="10" style="v" sid="REV 14:10" />بِشْ يُشْرُبْ مِنْ شْرَابْ غَضَبْ اللَّهْ الِّي يْصُبْهُولُو شْرَابْ صَافِي فِي كَاسْ الغَضَبْ مْتَاعُو، وبِشْ يِتْعَذَّبْ بِالنَّارْ والكِبْرِيتْ قُدَّامْ المْلَايْكَة القِدِّيسِينْ والخَرُوفْ، <verse eid="REV 14:10" /><verse number="11" style="v" sid="REV 14:11" />ودُخَّانْ عْذَابْهُمْ بِشْ يُقْعُدْ طَالَعْ لْأَبَدْ الآبِدِينْ. مَا فَمَّاشْ رَاحَة لَا فِي اللِّيلْ ولَا فِي النْهَارْ لِلِّي عِبْدُوا الوَحْشْ وسِجْدُوا لْتِمْثَالُو وقِبْلُوا أَمَارِةْ إِسْمُو». <verse eid="REV 14:11" /><verse number="12" style="v" sid="REV 14:12" />هُونِي يُظْهُرْ صَبْرْ القِدِّيسِينْ الِّي يْحَافْظُوا عْلَى وْصَايَا اللَّهْ وعْلَى إِيمَانْهُمْ بْيَسُوعْ.<verse eid="REV 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13" />ومْبَعِّدْ سْمَعْتْ صُوتْ مِالسْمَاء يْقُولْ: «إِكْتِبْ: صَحَّة لِيهُمْ المُوتَى الِّي يْمُوتُوا مِنْ تَوَّا وهُومَا تَابْعِينْ الرَّبْ!». ويْجَاوِبْ الرُّوحْ: «إِيْ نْعَمْ! بِشْ يِرْتَاحُوا مِنْ تْعَبْهُمْ عْلَى خَاطِرْ أَعْمَالْهُمْ بِشْ تِشْهْدِلْهُمْ».<verse eid="REV 14:13" /></para>
  <para style="s">جَاء وَقْتْ الحْصَادْ</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14" />ومْبَعِّدْ خْزَرْتْ، يَاخِي شُفْتْ غِيمَة بِيضَة قَاعِدْ عْلِيهَا وَاحِدْ يْشَبَّهْ لْإِبْنْ إِنْسَانْ، فُوقْ رَاسُو تَاجْ ذْهَبْ وفِي يِدُّو مِنْجِلْ مَاضِي. <verse eid="REV 14:14" /><verse number="15" style="v" sid="REV 14:15" />وخْرَجْ مَلَاكْ آخِرْ مِالهَيْكِلْ يْعَيِّطْ بْصُوتْ عَالِي لِلِّي قَاعِدْ فُوقْ الغِيمَة: «هِزْ المِنْجِلْ مْتَاعِكْ وأَحْصِدْ، رَاهُو وَقْتْ الحْصَادْ جَاء! وصَابِةْ الأَرْضْ حَاضْرَة!». <verse eid="REV 14:15" /><verse number="16" style="v" sid="REV 14:16" />يَاخِي رْمَى الِّي قَاعِدْ فُوقْ الغِيمَة مِنْجْلُو عَالأَرْضْ، والأَرْضْ تْحَصْدِتْ.<verse eid="REV 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17" />وخْرَجْ مَلَاكْ آخِرْ مِالهَيْكِلْ الِّي فِي السْمَاء وهُوَّ زَادَا عَنْدُو مِنْجِلْ مَاضِي. <verse eid="REV 14:17" /><verse number="18" style="v" sid="REV 14:18" />ومْبَعِّدْ، خْرَجْ مَلَاكْ آخِرْ مِالمَذْبَحْ عَنْدُو سُلْطَة عَالنَّارْ، وعَيِّطْ بْصُوتْ عَالِي لِلْمَلَاكْ الِّي عَنْدُو المِنْجِلْ المَاضِي وقَالْ: «هِزْ مِنْجْلِكْ المَاضِي وأَحْصِدْ عْنَاقِدْ عْنِبْ الأَرْضْ، رَاهُو عْنِبْهَا طَابْ». <verse eid="REV 14:18" /><verse number="19" style="v" sid="REV 14:19" />يَاخِي رْمَى المَلَاكْ مِنْجْلُو عَالأَرْضْ، ولَمْ عْنَاقِدْ العْنِبْ، ورْمَاهَا فِي مَعْصَرْةْ غَضَبْ اللَّهْ العْظِيمَة. <verse eid="REV 14:19" /><verse number="20" style="v" sid="REV 14:20" />وتْغَفِّصْ العْنِبْ بِالسَّاقِينْ لْبَرَّا مِالمْدِينَة، وجْرَى الدَّمْ مِالمَعْصْرَة عْلَى عُلْوْ مِيتْرُو ونُصْ، وعْلَى طُولْ 320 كِيلُومَاتِرْ (عْلَى حَسْبْ التَّقْرِيبْ).<verse eid="REV 14:20" /></para>
  <chapter eid="REV 14" />
  <chapter number="15" style="c" sid="REV 15" />
  <para style="s">السَّبْعَة مْلَايْكَة والسَّبْعَة بْلَاوَاتْ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1" />ومْبَعِّدْ شُفْتْ فِي السْمَاء أَمَارَة أُخْرَى عْظِيمَة وعْجِيبَة: سَبْعَة مْلَايْكَة هَازِّينْ البْلَاوَاتْ السَّبْعَة الإِخْرَانِينْ الِّي بِيهُمْ يِكْمِلْ غَضَبْ اللَّهْ. <verse eid="REV 15:1" /><verse number="2" style="v" sid="REV 15:2" />وشُفْتْ زَادَا حَاجَة تْشَبَّهْ لِبْحَرْ مِنْ بِلَّارْ مْخَلِّطْ بِالنَّارْ، وَاقْفِينْ عْلِيهْ النَّاسْ الِّي غِلْبُوا الوَحْشْ وتِمْثَالُو ورَقْمْ إِسْمُو، وهَازِّينْ فِي يْدِيهُمْ قِيثَارَاتْ اللَّهْ، <verse eid="REV 15:2" /><verse number="3" style="v" sid="REV 15:3" />ويْغَنِّيوْ فِي تَرْنِيمِةْ مُوسَى عَبْدْ اللَّهْ وتَرْنِيمِة الخَرُوفْ ويْقُولُوا:</para>
  <para style="b" vid="REV 15:3" />
  <para style="q1" vid="REV 15:3">«عْظِيمَة وعْجِيبَة أَعْمَالِكْ</para>
  <para style="q2" vid="REV 15:3">يَا رَبْ إِلَاهْنَا القَادِرْ عْلَى كُلْ شَيْ!</para>
  <para style="q1" vid="REV 15:3">عَادْلَة ومِسْتْوِيَّة الثْنَايَا مْتَاعِكْ،</para>
  <para style="q2" vid="REV 15:3">يَا مَلِكْ الشُّعُوبْ.<verse eid="REV 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4" />شْكُونْ الِّي مَا يْخَافِكْشْ</para>
  <para style="q2" vid="REV 15:4">ومَا يْمَجِّدْشْ إِسْمِكْ يَا رَبْ؟</para>
  <para style="q1" vid="REV 15:4">رَاكْ إِنْتِ وَحْدِكْ قُدُّوسْ!</para>
  <para style="q2" vid="REV 15:4">وكُلْ الأُمَمْ بِشْ يْجِيوْ ويِسْجْدُولِكْ،</para>
  <para style="q1" vid="REV 15:4">عْلَى خَاطِرْ أَحْكَامِكْ العَادْلَة ظُهْرِتْ لِلْكُلْ».<verse eid="REV 15:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5" />ومْبَعِّدْ شُفْتْ هَيْكِلْ خِيمِةْ الشْهَادَة فِي السْمَاء يِتْحَلْ، <verse eid="REV 15:5" /><verse number="6" style="v" sid="REV 15:6" />وخَرْجُوا مِنُّو المْلَايْكَة السَّبْعَة الِّي هَازِّينْ مْعَاهُمْ البْلَاوَاتْ السَّبْعَة، لَابْسِينْ قْمَاشْ كِتَّانْ صَافِي يُبْرُقْ بَرْقَانْ، وصْدُورْهُمْ مَشْدُودَة بِحْزَامَاتْ ذْهَبْ. <verse eid="REV 15:6" /><verse number="7" style="v" sid="REV 15:7" />وعْطَى وَاحِدْ مِالمَخْلُوقَاتْ الحَيَّة الأَرْبْعَة سَبْعَة كِيسَانْ ذْهَبْ لِلْمْلَايْكَة السَّبْعَة، كِيسَانْ مِلْيَانِينْ بْغَضَبْ اللَّهْ الحَيْ لْأَبَدْ الآبِدِينْ. <verse eid="REV 15:7" /><verse number="8" style="v" sid="REV 15:8" />وتِمْلَى الهَيْكِلْ بِالدُّخَّانْ مِنْ مَجْدْ اللَّهْ وقُدْرْتُو، ومَا نَجِّمْ حَدْ يُدْخُلُّو، حَتَّى لِينْ كِمْلِتْ البْلَاوَاتْ السَّبْعَة مْتَاعْ المْلَايْكَة السَّبْعَة.<verse eid="REV 15:8" /></para>
  <chapter eid="REV 15" />
  <chapter number="16" style="c" sid="REV 16" />
  <para style="s">كِيسَانْ غَضَبْ اللَّهْ السَّبْعَة</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1" />ومْبَعِّدْ سْمَعْتْ صُوتْ عَالِي جَايْ مِالهَيْكِلْ يْقُولْ لِلْمْلَايْكَة السَّبْعَة: «إِمْشِيوْ وصُبُّوا كِيسَانْ غَضَبْ اللَّهْ السَّبْعَة عَالأَرْضْ».<verse eid="REV 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2" />مْشَى المَلَاكْ الأُوِّلْ وصَبْ كَاسُو عَالأَرْضْ، يَاخِي النَّاسْ الِّي عْلِيهُمْ أَمَارِةْ الوَحْشْ ولِّي سِجْدُوا لْتِمْثَالُو طَلْعُولْهُمْ دْمَامِلْ مْقَيْحَة تُوجَعْ بَرْشَة.<verse eid="REV 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3" />وصَبْ المَلَاكْ الثَّانِي كَاسُو فِي البْحَرْ، يَاخِي المَاء وَلَّى دَمْ، كِيفْ دَمْ المِيِّتْ، ومَاتِتْ المَخْلُوقَاتْ الحَيَّة الِّي فِيهْ الكُلْ.<verse eid="REV 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4" />وصَبْ المَلَاكْ الثَّالِثْ كَاسُو فِي الوِدْيَانْ وعْيُونْ المَاء، يَاخِي وَلَّاوْ الكُلْهُمْ دَمْ. <verse eid="REV 16:4" /><verse number="5" style="v" sid="REV 16:5" />وسْمَعْتْ مَلَاكْ المَاء يْقُولْ:</para>
  <para style="b" vid="REV 16:5" />
  <para style="q1" vid="REV 16:5">«إِنْتِ عَادِلْ فِي أَحْكَامِكْ،</para>
  <para style="q2" vid="REV 16:5">يَا إِلَاهْنَا القُدُّوسْ، المَوْجُودْ تَوَّا، ولِّي مَوْجُودْ مِنْ قْبَلْ.<verse eid="REV 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 16:6" />عْلَى خَاطِرْ الِّي سَيْحُوا دَمْ القِدِّيسِينْ والأَنْبِيَاءْ،</para>
  <para style="q2" vid="REV 16:6">إِنْتِ عْطِيتْهُمْ دَمْ بَاشْ يُشْرْبُوهْ!</para>
  <para style="q1" vid="REV 16:6">وهَاذَا الِّي يِسْتَاهْلُوهْ!».<verse eid="REV 16:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="REV 16:7" />وسْمَعْتْ صُوتْ مِالمَذْبَحْ يْقُولْ:</para>
  <para style="b" vid="REV 16:7" />
  <para style="q1" vid="REV 16:7">«إِيْ نْعَمْ، أَحْكَامِكْ صْحِيحَة وعَادْلَة</para>
  <para style="q2" vid="REV 16:7">يَا رَبْ إِلَاهْنَا القَادِرْ عْلَى كُلْ شَيْ».<verse eid="REV 16:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8" />وصَبْ المَلَاكْ الرَّابَعْ كَاسُو عَالشَّمْسْ يَاخِي خْذَاتْ السُّلْطَة بَاشْ تَحْرَقْ النَّاسْ بِالنَّارْ، <verse eid="REV 16:8" /><verse number="9" style="v" sid="REV 16:9" />وتْحَرْقُوا النَّاسْ مِنْ قُوِّةْ السْخَانَة. ومَا تَابُوشْ ومَا مَجْدُوشْ اللَّهْ، آمَا كَفْرُوا بْإِسْمْ اللَّهْ الِّي عَنْدُو سُلْطَة عْلَى هَا البْلَاوَاتْ.<verse eid="REV 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10" />وبَعْدْ صَبْ المَلَاكْ الخَامِسْ كَاسُو عْلَى عَرْشْ الوَحْشْ الأُوِّلْ، يَاخِي ظْلَامِتْ مَمْلَكْتُو، ووَلَّاوْ النَّاسْ يِڨْدِمُوا فِي لْسَانَاتْهُمْ مِالوْجِيعَة. <verse eid="REV 16:10" /><verse number="11" style="v" sid="REV 16:11" />آمَا مَا تَابُوشْ عْلَى عْمَايِلْهُمْ، بِالعَكْسْ سَبُّوا إِلَاهْ السْمَاءْ بِسْبَبْ وْجَايَعْهُمْ والدْمَامِلْ الِّي طَلْعِتِّلْهُمْ.<verse eid="REV 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12" />وصَبْ المَلَاكْ السَّادِسْ كَاسُو عْلَى وَادْ الفُرَاتْ الكْبِيرْ يَاخِي مَاهْ شَاحْ، بَاشْ يِتْحَلْ الطْرِيقْ لِلْمُلُوكْ الجَايِينْ مِالشَّرْقْ. <verse eid="REV 16:12" /><verse number="13" style="v" sid="REV 16:13" />وشُفْتْ ثْلَاثَة أَرْوَاحْ شِرِّيرَة يْشَبْهُوا لِلجْرَانْ خَارْجِينْ مِنْ فُمْ التِّنِّينْ، ومِنْ فُمْ الوَحْشْ، ومِنْ فُمْ النَّبِيْ الكَذَّابْ. <verse eid="REV 16:13" /><verse number="14" style="v" sid="REV 16:14" />هُومَا أَرْوَاحْ شْوَاطِنْ يَعْمْلُوا فِي مُعْجْزَاتْ، ويِمْشِيوْ لْمُلُوكْ العَالِمْ الكُلْ يْلِمُّوهُمْ لِلْحَرْبْ الِّي بِشْ تْصِيرْ فِي هَاكِ النْهَارْ العْظِيمْ، نْهَارْ اللَّهْ القَادِرْ عْلَى كُلْ شَيْ. <verse eid="REV 16:14" /><verse number="15" style="v" sid="REV 16:15" />وسْمَعْتْ الرَّبْ يْقُولْ: «هَانِي جَايْ كِيفْ السَّارِقْ! صَحَّة لِيهْ الِّي يَسْهِرْ ويْعِسْ عْلَى دَبْشُو بَاشْ مَا يِمْشِيشْ عِرْيَانْ ويِتْفْضَحْ قُدَّامْ النَّاسْ». <verse eid="REV 16:15" /><verse number="16" style="v" sid="REV 16:16" />والأَرْوَاحْ الشِّرِّيرَة الثْلَاثَة لَمُّوا المُلُوكْ فِي بْلَاصَة تِتْسَمَّى بِالعِبْرِيَّة هَرْمَجَدُّونْ.<verse eid="REV 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17" />وصَبْ المَلَاكْ السَّابَعْ كَاسُو فِي الهْوَاء، وخْرَجْ صُوتْ عَالِي مِالعَرْشْ فِي الهَيْكِلْ يْقُولْ: «وْفَى!». <verse eid="REV 16:17" /><verse number="18" style="v" sid="REV 16:18" />وصَارِتْ أَصْوَاتْ وبَرْشَة بْرَقْ ورْعَدْ وزِلْزَالْ قْوِيْ بَرْشَة مَا صَارِشْ كِيفُو مِلِّي تُوجِدْ الإِنْسَانْ عَالأَرْضْ. <verse eid="REV 16:18" /><verse number="19" style="v" sid="REV 16:19" />وتْقِسْمِتْ المْدِينَة العْظِيمَة عْلَى ثْلَاثَة، وادَّمْرِتْ مُدُنْ الأُمَمْ. ومَا نْسَاشْ اللَّهْ بَاشْ يْشَرَّبْ بَابِلْ العْظِيمَة الكَاسْ المْعَبْيَة بِشْرَابْ الغَضَبْ مْتَاعُو. <verse eid="REV 16:19" /><verse number="20" style="v" sid="REV 16:20" />والجُزُرْ الكُلْ هَرْبِتْ والجْبَالْ تْنَحَّاتْ، <verse eid="REV 16:20" /><verse number="21" style="v" sid="REV 16:21" />وهْبَطْ تَبْرُورِي كْبِيرْ مِالسْمَاء عَالنَّاسْ، الكَعْبَة مِنُّو تُوزِنْ قْرِيبْ الخَمْسِينْ كِيلُو، يَاخِي سَبُّوا اللَّهْ بِسْبَبْ هَا البَلْوَة الكْبِيرَة بَرْشَة.<verse eid="REV 16:21" /></para>
  <chapter eid="REV 16" />
  <chapter number="17" style="c" sid="REV 17" />
  <para style="s">الزَّانْيَة الكْبِيرَة والوَحْشْ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1" />ومْبَعِّدْ جَانِي وَاحِدْ مِالسَّبْعَة مْلَايْكَة الِّي هَازِّينْ الكِيسَانْ السَّبْعَة وقَالِّي: «إِيجَا نْوَرِّيكْ عِقَابْ الزَّانْيَة الكْبِيرَة القَايْمَة عْلَى بَرْشَة مَاء، <verse eid="REV 17:1" /><verse number="2" style="v" sid="REV 17:2" />الِّي زْنَاوْ مْعَاهَا مُلُوكْ الدِّنْيَا، وسِكْرُوا بِشْرَابْ زْنَاهَا سُكَّانْ الأَرْضْ».<verse eid="REV 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3" />وهَزْنِي المَلَاكْ بِالرُّوحْ لِلصَّحْرَاء، وشُفْتْ مْرَا رَاكْبَة عْلَى وَحْشْ أَحْمِرْ عَنْدُو سَبْعَة رْيُوسْ وعَشْرَة ڨْرُونْ ومَكْتُوبْ عْلِيهْ أَسَامِي كُفْرْ. <verse eid="REV 17:3" /><verse number="4" style="v" sid="REV 17:4" />والمْرَا كَانِتْ لَابْسَة بِالبَنَفْسَجِي والأَحْمِرْ ومْزَيْنَة بِالذْهَبْ والحْجَرْ الكْرِيمْ واللُّولِي، وهَازَّة فِي يِدْهَا كَاسْ ذْهَبْ مِلْيَانْ بِالفْسَادْ والنْجَاسَة مِنْ زْنَاهَا، <verse eid="REV 17:4" /><verse number="5" style="v" sid="REV 17:5" />ومَكْتُوبْ عْلَى جْبِينْهَا إِسْمْ عَنْدُو مَعْنَى سِرِّي: «بَابِلْ العْظِيمَة، أُمْ كُلْ زَانْيَة وكُلْ نْجَاسَة فِي الأَرْضْ». <verse eid="REV 17:5" /><verse number="6" style="v" sid="REV 17:6" />ورِيتْ المْرَا سُكْرَانَة مِنْ كُثْرْ مَا شَرْبِتْ مِنْ دَمْ القِدِّيسِينْ، ودَمْ الِّي إِسْتَشْهْدُوا عْلَى خَاطِرْ يَسُوعْ. وقْعَدْتْ بَاهِتْ كِي شُفْتْهَا.<verse eid="REV 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 17:7" />يَاخِي قَالِّي المَلَاكْ: «آشْبِيكْ بَاهِتْ؟ هَاوْ بِشْ نِكْشِفْلِكْ سِرْ المْرَا والوَحْشْ الِّي هَازِزْهَا، الِّي عَنْدُو سَبْعَة رْيُوسْ وعَشْرَة ڨْرُونْ. <verse eid="REV 17:7" /><verse number="8" style="v" sid="REV 17:8" />هَا الوَحْشْ كَانْ مَوْجُودْ، وتَوَّا مَا عَادِشْ مَوْجُودْ، آمَا عْلَى قْرِيبْ بِشْ يِطْلَعْ مِالهَاوْيَة ويِمْشِي لِلْهْلَاكْ. وسُكَّانْ الأَرْضْ الِّي أَسَامِيهُمْ مَاهِيشْ مَكْتُوبَة فِي كْتَابْ الحَيَاةْ مِلِّي تْخَلْقِتْ الدِّنْيَا، بِشْ تَضْرَبْهُمْ الدَّهْشَة وَقْتِلِّي يْشُوفُوهْ، عْلَى خَاطْرُو كَانْ مَوْجُودْ ومْبَعِّدْ مَا عَادِشْ مَوْجُودْ، وبِشْ يُظْهُرْ مَرَّة أُخْرَى! <verse eid="REV 17:8" /><verse number="9" style="v" sid="REV 17:9" />وهْنَا لَازِمْ حِكْمَة وفَهْمْ: الرْيُوسْ السَّبْعَة هُومَا السَّبْعَة جْبَالْ الِّي قَاعْدَة عْلِيهُمْ المْرَا، وهُومَا زَادَا سَبْعَة مُلُوكْ، <verse eid="REV 17:9" /><verse number="10" style="v" sid="REV 17:10" />خَمْسَة مِنْهُمْ طَاحُوا، والسَّادِسْ يُحْكُمْ تَوَّا، والسَّابَعْ مَزَّالْ مَا جَاشْ، وكِي يْجِي مُشْ بِشْ يْطَوِّلْ. <verse eid="REV 17:10" /><verse number="11" style="v" sid="REV 17:11" />آمَا الوَحْشْ الِّي كَانْ مَوْجُودْ وتَوَّا مَا عَادِشْ مَوْجُودْ، هُوَّ مَلِكْ ثَامِنْ، رَغْمِلِّي هُوَّ وَاحِدْ مِالسَّبْعَة، وبِشْ يِمْشِي لِلْهْلَاكْ. <verse eid="REV 17:11" /><verse number="12" style="v" sid="REV 17:12" />والعَشْرَة ڨْرُونْ الِّي شُفْتْهُمْ هُومَا عَشْرَة مُلُوكْ مَزَّالُوا مَا مِلْكُوشْ، آمَا بِشْ يِمْلْكُوا مْعَ الوَحْشْ سَاعَة وَحْدَة. <verse eid="REV 17:12" /><verse number="13" style="v" sid="REV 17:13" />هَاذُومَا تْفَاهْمُوا بَاشْ يَعْطِيوْ لِلْوَحْشْ قُوِّتْهُمْ وسُلْطِتْهُمْ. <verse eid="REV 17:13" /><verse number="14" style="v" sid="REV 17:14" />وبِشْ يْحَارْبُوا الخَرُوفْ، آمَا هُوَّ بِشْ يِغْلِبْهُمْ، عْلَى خَاطْرُو رَبْ الأَرْبَابْ ومَلِكْ المُلُوكْ، وبِشْ يِغْلْبُوا مْعَاهْ الأُمَنَاءْ الِّي دْعَاهُمْ واخْتَارْهُمْ».<verse eid="REV 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15" />وقَالِّي المَلَاكْ: «المَاء الِّي شُفْتُو وِينْ قَايْمَة الزَّانْيَة، هُوَّ شْعُوبْ وجَمَاهِيرْ وأُمَمْ ولُوغَاتْ. <verse eid="REV 17:15" /><verse number="16" style="v" sid="REV 17:16" />آمَا العَشْرَة ڨْرُونْ الِّي شُفْتْهُمْ والوَحْشْ، بِشْ يِكْرْهُوا الزَّانْيَة، ويْعَرِّيوْهَا ويْخَلِّيوْهَا خِرْبَة، وبَعْدْ يَاكْلُوا لْحَمْهَا ويَحْرْقُوهَا بِالنَّارْ. <verse eid="REV 17:16" /><verse number="17" style="v" sid="REV 17:17" />عْلَى خَاطِرْ اللَّهْ حَطِّلْهُمْ فِي قْلُوبْهُمْ بَاشْ يَعْمْلُوا الِّي يْحِبْ عْلِيهْ هُوَّ، وبَاشْ يْكُونُوا رَايْ وَاحِدْ ويَعْطِيوْ مُلْكْهُمْ لِلْوَحْشْ، حَتَّى لِينْ يِتْحَقَّقْ كْلَامْ اللَّهْ. <verse eid="REV 17:17" /><verse number="18" style="v" sid="REV 17:18" />والمْرَا هَاذِيكَا الِّي شُفْتْهَا، هِيَّ المْدِينَة العْظِيمَة الِّي تُحْكُمْ فِي مُلُوكْ الأَرْضْ».<verse eid="REV 17:18" /></para>
  <chapter eid="REV 17" />
  <chapter number="18" style="c" sid="REV 18" />
  <para style="s">طَاحِتْ بَابِلْ العْظِيمَة</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1" />بَعْدْ هَاذَا شُفْتْ مَلَاكْ آخِرْ هَابِطْ مِالسْمَاء، عَنْدُو سُلْطَة عْظِيمَة، والأَرْضْ ضْوَاتْ مِنْ نُورُو. <verse eid="REV 18:1" /><verse number="2" style="v" sid="REV 18:2" />وصَاحْ بْأَعْلَى صُوتُو:</para>
  <para style="b" vid="REV 18:2" />
  <para style="q1" vid="REV 18:2">«طَاحِتْ! طَاحِتْ بَابِلْ العْظِيمَة!</para>
  <para style="q2" vid="REV 18:2">ووَلَّاتْ وَكْرْ لِلشْوَاطِنْ والأَرْوَاحْ الشِّرِّيرَة والطْيُورْ المَنْجُوسَة المَكْرُوهَة!<verse eid="REV 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="REV 18:3" />عْلَى خَاطِرْ الشُّعُوبْ الكُلْ شَرْبُوا مِنْ شْرَابْ زْنَاهَا،</para>
  <para style="q2" vid="REV 18:3">ومْلُوكْ الأَرْضْ زْنَاوْ مْعَاهَا،</para>
  <para style="q1" vid="REV 18:3">وتُجَّارْ الدِّنْيَا إِسْتِغْنَاوْ مِنْ كُثْرْ مَا صَرْفِتْ!».<verse eid="REV 18:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4" />وسْمَعْتْ صُوتْ آخِرْ مِالسْمَاء يْقُولْ:</para>
  <para style="b" vid="REV 18:4" />
  <para style="q1" vid="REV 18:4">«يَا شَعْبِي أُخْرْجُوا مِنْهَا!</para>
  <para style="q2" vid="REV 18:4">بَاشْ مَا تْشَارْكُوشْ فِي ذْنُوبْهَا</para>
  <para style="q1" vid="REV 18:4">ومَا تَهْبِطْشْ عْلِيكُمْ بْلَاوَاتْهَا.<verse eid="REV 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5" />رَاهِي ذْنُوبْهَا تْكَدْسِتْ لِينْ وِصْلِتْ لِلسْمَاء،</para>
  <para style="q2" vid="REV 18:5">واللَّهْ مَا نْسَاشْ الشَّرْ الِّي عَمْلِتُّو الكُلْ.<verse eid="REV 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6" />أَعْمْلُوا مْعَاهَا كِيمَا عَمْلِتْ مْعَاكُمْ،</para>
  <para style="q2" vid="REV 18:6">وجَازِيوْهَا بْمَرْتِينْ قَدْ الِّي عَمْلِتُّو.</para>
  <para style="q1" vid="REV 18:6">وفِي الكَاسْ صَبِّتْ فِيهْ لِلْأُخْرِينْ،</para>
  <para style="q2" vid="REV 18:6">صُبُّولْهَا بَايْ مْتَاعْ إِثْنِينْ.<verse eid="REV 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 18:7" />عَذْبُوهَا وشَقِّيوْهَا عْلَى قَدْ مَا مَجْدِتْ رُوحْهَا وشَاخِتْ.</para>
  <para style="q1" vid="REV 18:7">هِيَّ تْقُولْ فِي قَلْبْهَا: "آنَا مَلِكَة عَالعَرْشْ!</para>
  <para style="q2" vid="REV 18:7">ومَانِيشْ هَجَّالَة، وعُمْرِي مَا بِشْ نْذُوقْ الحُزْنْ".<verse eid="REV 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8" />هَاذَاكَا عْلَاشْ بِشْ تَهْبِطْ عْلِيهَا البْلَاوَاتْ فِي نْهَارْ وَاحِدْ:</para>
  <para style="q2" vid="REV 18:8">مُوتْ وحُزْنْ وجُوعْ</para>
  <para style="q1" vid="REV 18:8">وبِشْ تِتْحْرَقْ بِالنَّارْ،</para>
  <para style="q2" vid="REV 18:8">عْلَى خَاطِرْ الرَّبْ الإِلَاهْ الِّي يُحْكُمْ عْلِيهَا هُوَّ قَادِرْ».<verse eid="REV 18:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9" />وبِشْ يِبْكِيوْ عْلِيهَا مُلُوكْ الأَرْضْ الِّي زْنَاوْ مْعَاهَا وشَاخُوا فِي جُرِّتْهَا، وبِشْ يْنَوْحُوا وَقْتِلِّي يْشُوفُوا دُخَّانْ حْرِيقِتْهَا، <verse eid="REV 18:9" /><verse number="10" style="v" sid="REV 18:10" />ويَاقْفُوا بْعِيدْ عْلِيهَا خَايْفِينْ مِنْ عْذَابْهَا ويْقُولُوا:</para>
  <para style="b" vid="REV 18:10" />
  <para style="q1" vid="REV 18:10">«يَا وِيلِكْ! يَا وِيلِكْ، يَا بَابِلْ المْدِينَة العْظِيمَة، يَا بَابِلْ القْوِيَّة!</para>
  <para style="q2" vid="REV 18:10">عِقَابِكْ جَاء فِي سَاعَة وَحْدَة!».<verse eid="REV 18:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11" />وبِشْ يِبْكِيوْ عْلِيهَا ويْنَوْحُوا تُجَّارْ الدِّنْيَا، عْلَى خَاطِرْ سِلْعِتْهُمْ مَا عَادْ بِشْ يِشْرِيهَا حَدْ: <verse eid="REV 18:11" /><verse number="12" style="v" sid="REV 18:12" />الذْهَبْ والفِضَّة والحْجَرْ الكْرِيمْ واللُّولِي، والكِتَّانْ والقْمَاشْ البَنَفْسَجِي والحْرِيرْ والقِرْمِزْ، وأَعْوَادْ النَّدْ الِّي رِيحِتْهُمْ فَاوْحَة وكُلْ مَا هُوَّ مَصْنُوعْ مِالعَاجْ ومِاللُّوحْ الغَالِي والنْحَاسْ والحْدِيدْ والرْخَامْ، <verse eid="REV 18:12" /><verse number="13" style="v" sid="REV 18:13" />وزَادَا القِرْفَة والأُفَّاحَاتْ، والبْخُورْ والعْطُورَاتْ واللُّوبَانْ والشْرَابْ والزِيتْ والدْقِيقْ والقَمْحْ، والبْڨَرْ والغْنَمْ والحْصُنَّة والكَرُّوسَاتْ، والعْبِيدْ والمْرَابِيطْ. <verse eid="REV 18:13" /><verse number="14" style="v" sid="REV 18:14" />وبِشْ يْقُولُوا:</para>
  <para style="b" vid="REV 18:14" />
  <para style="q1" vid="REV 18:14">«الغَلَّة البَاهْيَة الِّي نَفْسِكْ اشْتْهَاتْهَا ضَاعِتْ عْلِيكْ،</para>
  <para style="q2" vid="REV 18:14">والضْخَامَاتْ والنَّعِيمْ مْشَاوْ عْلِيكْ ومَا عَادِشْ بِشْ يِرْجْعُوا!».<verse eid="REV 18:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="REV 18:15" />التُّجَّارْ هَاذُومَا الِّي إِسْتَغْنَاوْ فِي جُرِّتْهَا بِشْ يَاقْفُوا بْعِيدْ عْلِيهَا، خَايْفِينْ مِنْ عْذَابْهَا ويِبْكِيوْ ويْنَوْحُوا <verse eid="REV 18:15" /><verse number="16" style="v" sid="REV 18:16" />ويْقُولُوا:</para>
  <para style="b" vid="REV 18:16" />
  <para style="q1" vid="REV 18:16">«يَا وِيلِكْ! يَا وِيلِكْ!</para>
  <para style="q2" vid="REV 18:16">المْدِينَة العْظِيمَة الِّي كَانِتْ تِلْبِسْ</para>
  <para style="q1" vid="REV 18:16">فِي الكَتَّانْ والقْمَاشْ البَنَفْسَجِي والأَحْمِرْ،</para>
  <para style="q2" vid="REV 18:16">وتْزَيِّنْ فِي رُوحْهَا بِالذْهَبْ والحْجَرْ الكْرِيمْ واللُّولِي،<verse eid="REV 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 18:17" />فِي سَاعَة مِالزْمَانْ</para>
  <para style="q2" vid="REV 18:17">ضَاعِتْ الثَّرْوَة هَاذِي الكُلْ!».</para>
  <para style="b" vid="REV 18:17" />
  <para style="p" vid="REV 18:17">كُلْ رُيَّاسْ البَابُورَاتْ ورُكَّابْهَا وبَحَّارِتْهَا ولِّي يِسْتَرْزْقُوا مِالبْحَرْ الكُلْ وِقْفُوا بْعِيدْ عْلِيهَا، <verse eid="REV 18:17" /><verse number="18" style="v" sid="REV 18:18" />وصَاحُوا وهُومَا يْشُوفُوا فِي الدُّخَّانْ وهِيَّ تِتْحْرَقْ وقَالُوا:</para>
  <para style="b" vid="REV 18:18" />
  <para style="q1" vid="REV 18:18">«آنَاهِي المْدِينَة الِّي كِيفْ هَا المْدِينَة العْظِيمَة؟».<verse eid="REV 18:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="REV 18:19" />وحَطُّوا التْرَابْ عْلَى رْيُوسْهُمْ وبْكَاوْ ونَوْحُوا وصَاحُوا:</para>
  <para style="b" vid="REV 18:19" />
  <para style="q1" vid="REV 18:19">«يَا وِيلْهَا! يَا وِيلْهَا! المْدِينَة العْظِيمَة</para>
  <para style="q2" vid="REV 18:19">الِّي مِنْ ثَرْوِتْهَا إِسْتَغْنَاوْ إِمَّالِي البَابُورَاتْ الكُلْ!</para>
  <para style="q1" vid="REV 18:19">فِي سَاعَة وَحْدَة تْخِرْبِتْ!<verse eid="REV 18:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="REV 18:20" />إِفْرَحْ لِخْرَابْهَا يَا سْمَاء!</para>
  <para style="q2" vid="REV 18:20">إِفْرْحُوا يَا قِدِّيسِينْ ويَا رُسُلْ ويَا أَنْبْيَاءْ،</para>
  <para style="q1" vid="REV 18:20">عْلَى خَاطِرْ اللَّهْ عَاقِبْهَا عَلِّي عَمْلِتُو فِيكُمْ».<verse eid="REV 18:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21" />وهَزْ مَلَاكْ قْوِيْ حَجْرَة كَايِنْهَا حَجْرِةْ رْحَى كْبِيرَة ولَوَّحْهَا فِي البْحَرْ وقَالْ:</para>
  <para style="b" vid="REV 18:21" />
  <para style="q1" vid="REV 18:21">«هَكَّا تِطَّيِشْ وتِتْرْمَى بَابِلْ المْدِينَة العْظِيمَة،</para>
  <para style="q2" vid="REV 18:21">ومَا عَادِشْ تْقُومِلْهَا قَايْمَة بِالكُلْ!<verse eid="REV 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="REV 18:22" />ومَا عَادِشْ يِتْسْمَعْ فِيكْ لَا قِيثَارَة</para>
  <para style="q2" vid="REV 18:22">ولَا مُوسِيقَى أُخْرَى، لَا نَايْ ولَا بُوقْ.</para>
  <para style="q1" vid="REV 18:22">ومُشْ بِشْ يُقْعُدْ فِيكْ حَتَّى صْنَايْعِي.</para>
  <para style="q2" vid="REV 18:22">ولَا يِتْسْمَعْ فِيكْ صُوتْ رْحَى،<verse eid="REV 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="REV 18:23" />ضَوْء الفْنَارْ مَا عَادِشْ بِشْ يِضْوِي فِيكْ.</para>
  <para style="q2" vid="REV 18:23">وصُوتْ عْرِيسْ وعْرُوسَة مَا عَادِشْ بِشْ يِتْسْمَعْ فِيكْ.</para>
  <para style="q1" vid="REV 18:23">عْلَى خَاطِرْ تُجَّارِكْ كَانُوا أَعْظِمْ نَاسْ فِي الأَرْضْ،</para>
  <para style="q2" vid="REV 18:23">والأُمَمْ الكُلْ تْغَرُّوا بْسِحْرِكْ.<verse eid="REV 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="REV 18:24" />وفِيكْ سَالْ دَمْ الأَنْبِيَاءْ والقِدِّيسِينْ</para>
  <para style="q2" vid="REV 18:24">ولِّي اتْقَتْلُوا فِي الأَرْضْ الكُلْ».<verse eid="REV 18:24" /></para>
  <para style="b" />
  <chapter eid="REV 18" />
  <chapter number="19" style="c" sid="REV 19" />
  <para style="s">تَسْبِيحْ فِي السْمَاء</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1" />بَعْدْ هَاذَا، سْمَعْتْ صُوتْ عَالِي كَايِنُّو صُوتْ جُمْهُورْ كْبِيرْ فِي السْمَاء يْقُولْ:</para>
  <para style="b" vid="REV 19:1" />
  <para style="q1" vid="REV 19:1">«هَلِّلُويَا!</para>
  <para style="q2" vid="REV 19:1">النْجَاةْ والمَجْدْ والقُدْرَة لْإِلَاهْنَا،<verse eid="REV 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="REV 19:2" />عْلَى خَاطِرْ أَحْكَامُو صْحِيحَة وعَادْلَة.</para>
  <para style="q2" vid="REV 19:2">حْكُمْ عَالزَّانْيَة الكْبِيرَة،</para>
  <para style="q1" vid="REV 19:2">الِّي فَسْدِتْ الأَرْضْ بِزْنَاهَا،</para>
  <para style="q2" vid="REV 19:2">وإِنْتَقَمْ مِنْهَا عْلَى خَاطِرْ دَمْ عَبِيدُو».<verse eid="REV 19:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="REV 19:3" />وقَالُوا مَرَّة أُخْرَى:</para>
  <para style="b" vid="REV 19:3" />
  <para style="q1" vid="REV 19:3">«هَلِّلُويَا!</para>
  <para style="q2" vid="REV 19:3">دُخَّانْ حْرِيقِتْهَا بِشْ يِبْقَى طَالَعْ لْأَبَدْ الآبِدِينْ».<verse eid="REV 19:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="REV 19:4" />وهَبْطُوا الـ24 شِيخْ والمَخْلُوقَاتْ الحَيَّة الأَرْبْعَة عْلَى رْكَايِبْهُمْ وسِجْدُوا لِلَّهْ القَاعِدْ عَالعَرْشْ وهُومَا يْقُولُوا: «آمِينْ. هَلِّلُويَا!».<verse eid="REV 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5" />وخْرَجْ صُوتْ مِالعَرْشْ يْقُولْ:</para>
  <para style="b" vid="REV 19:5" />
  <para style="q1" vid="REV 19:5">«سَبْحُوا إِلَاهْنَا يَا كُلْ عَبِيدُو</para>
  <para style="q2" vid="REV 19:5">الِّي تْخَافُوهْ، الصْغَارْ والكْبَارْ».<verse eid="REV 19:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="REV 19:6" />ومْبَعِّدْ سْمَعْتْ صُوتْ يْشَبَّهْ لْصُوتْ جُمْهُورْ كْبِيرْ، وَلَّا شَلَّالْ مَاءْ هَرْهَارْ، وَلَّا رْعَدْ قْوِيْ، يْقُولْ:</para>
  <para style="b" vid="REV 19:6" />
  <para style="q1" vid="REV 19:6">«هَلِّلُويَا!</para>
  <para style="q2" vid="REV 19:6">المُلْكْ لِلرَّبْ الإِلَاهْ القَادِرْ عْلَى كُلْ شَيْ،<verse eid="REV 19:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 19:7" />هَيَّا نِفْرْحُوا ونَزْهَاوْ ونْمَجْدُوهْ،</para>
  <para style="q2" vid="REV 19:7">عْلَى خَاطِرْ وَقْتْ عِرْسْ الخَرُوفْ جَاء،</para>
  <para style="q1" vid="REV 19:7">وعْرُوسْتُو حَضّْرِتْ رُوحْهَا،<verse eid="REV 19:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="REV 19:8" />وتِعْطَالْهَا بَاشْ تِلْبِسْ الكِتَّانْ الأَبْيِضْ الصَّافِي!»</para>
  <para style="b" vid="REV 19:8" />
  <para style="m" vid="REV 19:8">والكِتَّانْ هُوَّ رَمْزْ لْأَعْمَالْ القِدِّيسِينْ الصَّالْحَة.<verse eid="REV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9" />وقَالِّي المَلَاكْ: «إِكْتِبْ: صَحَّة لِيهُمْ المِسْتَدْعِينْ لْحَفْلِةْ عْشَاء عِرْسْ الخَرُوفْ!». وقَالْ زَادَا: «هَاذَا كْلَامْ اللَّهْ بِيدُو، كْلَامْ الحَقْ». <verse eid="REV 19:9" /><verse number="10" style="v" sid="REV 19:10" />يَاخِي تِرْمِيتْ قُدَّامْ سَاقِيهْ بَاشْ نِسْجِدْلُو، آمَا هُوَّ قَالِّي: «لَا! رُدْ بَالِكْ! آنَا خْدِيمْ كِيفِكْ وكِيفْ خْوَاتِكْ المُؤْمْنِينْ الِّي شَادِّينْ صْحِيحْ فِي شْهَادِةْ يَسُوعْ. إِسْجِدْ لِلَّهْ! عْلَى خَاطِرْ شْهَادِةْ يَسُوعْ هِيَّ وَحْيْ لِلنُّبُوَّة».<verse eid="REV 19:10" /></para>
  <para style="s">الرَّاكِبْ عَالحْصَانْ الأَبْيِضْ</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11" />وبَعْدْ شُفْتْ السْمَاء مَحْلُولَة، وإِذَا بِيهْ حْصَانْ أَبْيِضْ ولِّي رَاكِبْ عْلِيهْ إِسْمُو الأَمِينْ والصَّادَقْ، الِّي يُحْكُمْ ويْحَارِبْ بِالعَدْلْ. <verse eid="REV 19:11" /><verse number="12" style="v" sid="REV 19:12" />عِينِيهْ تِشْعِلْ كِي النَّارْ اللَّهْبَة، وفُوقْ رَاسُو بَرْشَة تِيجَانْ، وعَنْدُو إِسْمْ مَكْتُوبْ مَا يَعْرْفُو كَانْ هُوَّ. <verse eid="REV 19:12" /><verse number="13" style="v" sid="REV 19:13" />ولَابِسْ لِبْسَة مْغَطْسَة فِي الدَّمْ، وإِسْمُو كِلْمِةْ اللَّهْ. <verse eid="REV 19:13" /><verse number="14" style="v" sid="REV 19:14" />وجْيُوشْ السْمَاء يْتَبْعُوا فِيهْ عْلَى حْصُنَّة بْيُضْ، لَابْسِينْ كِتَّانْ أَبْيِضْ صَافِي. <verse eid="REV 19:14" /><verse number="15" style="v" sid="REV 19:15" />وخَارِجْ مِنْ فُمُّو سِيفْ مَاضِي بَاشْ يَضْرِبْ بِيهْ الأُمَمْ. وبِشْ يُحْكُمْهُمْ بِعْصَا حْدِيدْ، ويْغَفَّصْهُمْ فِي مَعْصْرِةْ غَضَبْ اللَّهْ الكْبِيرْ، القَادِرْ عْلَى كُلْ شَيْ. <verse eid="REV 19:15" /><verse number="16" style="v" sid="REV 19:16" />ومَكْتُوبْ عْلَى جِبْتُو وعْلَى فَخْذُو: «مَلِكْ المُلُوكْ ورَبْ الأَرْبَابْ».<verse eid="REV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17" />وشُفْتْ مَلَاكْ وَاقِفْ فِي الشَّمْسْ، يْعَيِّطْ لِلطْيُورْ الطَّايْرَة فِي قَلْبْ السْمَاءْ بْصُوتْ عَالِي: «لِمُّوا بْعَضْكُمْ وإِيجَاوْ لِعْشَاء اللَّهْ العْظِيمْ <verse eid="REV 19:17" /><verse number="18" style="v" sid="REV 19:18" />بَاشْ تَاكْلُوا لْحَمْ المُلُوكْ والقَادَة والأَبْطَالْ، ولْحَمْ الحْصُنَّة وفُرْسَانْهَا ولْحَمْ النَّاسْ الكُلْ، عَبِيدْ وأَحْرَارْ، كْبَارْ وصْغَارْ».<verse eid="REV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19" />وشُفْتْ الوَحْشْ ومُلُوكْ الأَرْضْ وجْيُوشْهُمْ، تْلَمُّوا بَاشْ يْحَارْبُوا الفَارِسْ هَاذَا وجَيْشُو. <verse eid="REV 19:19" /><verse number="20" style="v" sid="REV 19:20" />وتْشَدْ الوَحْشْ هُوَّ والنَّبِيْ الكَذَّابْ الِّي عْمَلْ قُدَّامُو مُعْجْزَاتْ وغَرْ بِيهُمْ النَّاسْ الِّي قِبْلُوا أَمَارِةْ الوَحْشْ وسِجْدُوا لْتِمْثَالُو. واطَّيْشُوا الزُّوزْ حَيِّينْ فِي بُحَيْرِةْ النَّارْ الشَاعْلَة بِالكِبْرِيتْ. <verse eid="REV 19:20" /><verse number="21" style="v" sid="REV 19:21" />والبْقِيَّة تْقَتْلُوا بِالسِّيفْ الخَارِجْ مِنْ فُمْ الفَارِسْ، وشَبْعِتْ الطْيُورْ بِلْحَمْهُمْ.<verse eid="REV 19:21" /></para>
  <chapter eid="REV 19" />
  <chapter number="20" style="c" sid="REV 20" />
  <para style="s">الأَلْفْ سْنَة</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1" />ومْبَعِّدْ شُفْتْ مَلَاكْ هَابِطْ مِالسْمَاء، فِي يِدُّو مِفْتَاحْ الهَاوْيَة وسَلْسْلَة كْبِيرَة. <verse eid="REV 20:1" /><verse number="2" style="v" sid="REV 20:2" />ورْبَطْ التِّنِّينْ، الِّي هُوَّ اللَّفْعَى القْدِيمَة، وهُوَّ بِيدُو إِبْلِيسْ وَلَّا الشِّيطَانْ، وحَبْسُو لْمُدِّةْ 1 000 سْنَة. <verse eid="REV 20:2" /><verse number="3" style="v" sid="REV 20:3" />ورْمَاهْ فِي الهَاوْيَة وسَكَّرْهَا عْلِيهْ وخْتِمْهَا، بَاشْ مَا عَادِشْ يْغَلِّطْ الشُّعُوبْ، حَتَّى لِينْ يُوفَاوْ الـ1 000 سْنَة. بَعْدْهَا لَازْمُو يِتْسَيِّبْ مُدَّة قْصِيرَة.<verse eid="REV 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4" />ومْبَعِّدْ شُفْتْ عْرُوشْ، وتِعْطَاتْ لِلِّي قَاعْدِينْ عْلِيهُمْ السُّلْطَة بَاشْ يُحْكْمُوا. ورِيتْ زَادَا نْفُوسْ الِّي تْقَتْلُوا عْلَى خَاطِرْ شْهَادِتْهُمْ لْيَسُوعْ وعْلَى خَاطِرْ كِلْمِةْ اللَّهْ ولِّي مَا سِجْدُوشْ لِلْوَحْشْ وتِمْثَالُو ومَا قِبْلُوشْ أَمَارْتُو عْلَى جْبِينْهُمْ ويْدِيهُمْ. هَاذُوكُمْ رَجْعُوا حَيِّينْ ومِلْكُوا مْعَ المَسِيحْ 1 000 سْنَة. <verse eid="REV 20:4" /><verse number="5" style="v" sid="REV 20:5" />آمَا بْقِيِّةْ الِّي مَاتُوا مَا رَجْعُوشْ حَيِّينْ حَتَّى لِينْ وْفَاوْ الـ1 000 سْنَة. هَاذِي هِيَّ القْيَامَة الأُولَى. <verse eid="REV 20:5" /><verse number="6" style="v" sid="REV 20:6" />صَحَّة لِيهُمْ الِّي عَنْدْهُمْ بَايْ فِي القْيَامَة الأُولَى! وقَدَّاشْ هُومَا مِتْقَدْسِينْ! ومُشْ بِشْ يْكُونْ لِلْمُوتْ الثَّانِي سُلْطَة عْلِيهُمْ، آمَا بِشْ يْكُونُوا كَهَنَة لِلَّهْ والمَسِيحْ ويِمْلْكُوا مْعَاهْ 1 000 سْنَة.<verse eid="REV 20:6" /></para>
  <para style="s">عِقَابْ إِبْلِيسْ</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7" />ووَقْتِلِّي تِكْمِلْ الـ1 000 سْنَة، الشِّيطَانْ بِشْ يِتْسَيِّبْ مِنْ حَبْسُو، <verse eid="REV 20:7" /><verse number="8" style="v" sid="REV 20:8" />وبِشْ يْغُرْ بِالأُمَمْ الِّي فِي الأَرْضْ الكُلْ، جُوجْ ومَاجُوجْ، الِّي عْدَدْهُمْ كْبِيرْ كِي رْمَلْ البْحَرْ، ويْلِمْهُمْ لِلْحَرْبْ. <verse eid="REV 20:8" /><verse number="9" style="v" sid="REV 20:9" />يَاخِي زَحْفُوا عَالأَرْضْ الكُلْ، وحَصْرُوا جَيْشْ القِدِّيسِينْ والمْدِينَة المَحْبُوبَة مِنْ كُلْ شِيرَة، آمَا هَبْطِتْ عْلِيهُمْ نَارْ مِالسْمَاء كْلَاتْهُمْ. <verse eid="REV 20:9" /><verse number="10" style="v" sid="REV 20:10" />وبَعْدْ اطَّيِّشْ إِبْلِيسْ الِّي غَرْ بِيهُمْ، فِي بُحَيْرِةْ النَّارْ والكِبْرِيتْ، وِينْ فَمَّة الوَحْشْ والنَّبِيْ الكَذَّابْ. وبِشْ يِتْعَذْبُوا غَادِي لِيلْ ونْهَارْ، لْأَبَدْ الآبِدِينْ.<verse eid="REV 20:10" /></para>
  <para style="s">يُومْ الحْسَابْ</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11" />ومْبَعِّدْ شُفْتْ عَرْشْ عْظِيمْ أَبْيِضْ، وشُفْتْ الِّي قَاعِدْ عْلِيهْ، هُوَّ الِّي هَرْبُوا مِنْ قُدَّامُو السْمَاء والأَرْضْ ومَا بْقَالْهُمْ حَتَّى أَثَرْ. <verse eid="REV 20:11" /><verse number="12" style="v" sid="REV 20:12" />وشُفْتْ المُوتَى كْبَارْ وصْغَارْ وَاقْفِينْ قُدَّامْ العَرْشْ. وتْحَلِّتْ الكْتُبْ، ومْبَعِّدْ تْحَلْ كْتَابْ آخِرْ الِّي هُوَّ كْتَابْ الحَيَاةْ. وتِحْكُمْ عَالمُوتَى بِلِّي مْسَجَّلْ فِي الكْتُبْ هَاذُوكُمْ، كُلْ وَاحِدْ حَسْبْ فِعْلُو. <verse eid="REV 20:12" /><verse number="13" style="v" sid="REV 20:13" />والبْحَرْ خَرِّجْ المُوتَى الِّي فِيهْ، والمُوتْ والهَاوْيَة خَرْجُوا المُوتَى الِّي فِيهُمْ. وكُلْ وَاحِدْ تْحَاسِبْ عَلِّي عَمْلُو. <verse eid="REV 20:13" /><verse number="14" style="v" sid="REV 20:14" />ومْبَعِّدْ اطَّيْشُوا المُوتْ والهَاوْيَة فِي بُحَيْرِةْ النَّارْ، الِّي هِيَّ المُوتْ الثَّانِي. <verse eid="REV 20:14" /><verse number="15" style="v" sid="REV 20:15" />واطَّيِّشْ مْعَاهُمْ كُلْ وَاحِدْ إِسْمُو مَا كَانِشْ مَوْجُودْ فِي كْتَابْ الحَيَاةْ.<verse eid="REV 20:15" /></para>
  <chapter eid="REV 20" />
  <chapter number="21" style="c" sid="REV 21" />
  <para style="s">سْمَاء جْدِيدَة وأَرْضْ جْدِيدَة</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1" />ومْبَعِّدْ شُفْتْ سْمَاء جْدِيدَة وأَرْضْ جْدِيدَة، عْلَى خَاطِرْ السْمَاء والأَرْضْ الأُوْلَانِينْ تْنَحَّاوْ والبْحَرْ مَا عَادِشْ مَوْجُودْ، <verse eid="REV 21:1" /><verse number="2" style="v" sid="REV 21:2" />وشُفْتْ المْدِينَة المُقَدْسَة، الِّي هِيَّ أُورْشَلِيمْ الجْدِيدَة، هَابْطَة مِالسْمَاء مِنْ عَنْدْ اللَّهْ، حَاضْرَة كَايِنْهَا عْرُوسَة تْزَيْنِتْ لَعْرِيسْهَا. <verse eid="REV 21:2" /><verse number="3" style="v" sid="REV 21:3" />وسْمَعْتْ صُوتْ عَالِي جَايْ مِالعَرْشْ يْقُولْ: «أُخْزْرُوا! تَوَّا اللَّهْ بِشْ يُسْكُنْ مْعَ النَّاسْ. هُوَّ بِشْ يُسْكُنْ مْعَاهُمْ وهُومَا بِشْ يْكُونُوا شَعْبُو. واللَّهْ بِيدُو بِشْ يْكُونْ مْعَاهُمْ ويْكُونْ إِلَاهُّمْ، <verse eid="REV 21:3" /><verse number="4" style="v" sid="REV 21:4" />وبِشْ يِمْسَحْ كُلْ دَمْعَة مِنْ عِينِيهُمْ. ولَا عَادْ فَمَّة لَا مُوتْ لَا حُزْنْ لَا بْكَاءْ ولَا وْجِيعَة، عْلَى خَاطِرْ الأُمُورْ القْدِيمَة الكُلْ تْنَحَّاتْ!».<verse eid="REV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5" />وقَالْ الِّي قَاعِدْ عَالعَرْشْ: «هَانِي بِشْ نَصْنَعْ كُلْ شَيْ جْدِيدْ». وزَادْ قَالِّي: «إِكْتِبْ، عْلَى خَاطِرْ الِّي نْقُولُو هُوَّ الصِّدْقْ والحَقْ». <verse eid="REV 21:5" /><verse number="6" style="v" sid="REV 21:6" />وقَالِّي: «كْمِلْ كُلْ شَيْ! آنَا الأَلِفْ واليَاءْ، البِدَايَة والنِّهَايَة. آنَا نِرْوِي العُطْشَانْ مِنْ مَنْبَعْ مَاء الحَيَاةْ بْلَاشْ. <verse eid="REV 21:6" /><verse number="7" style="v" sid="REV 21:7" />الِّي يِغْلِبْ، يُورِثْ هَاذَا الكُلْ، وآنَا نْكُونْ إِلَاهُو، وهُوَّ يْكُونْ وِلْدِي. <verse eid="REV 21:7" /><verse number="8" style="v" sid="REV 21:8" />آمَا الجُبَنَاءْ ولِّي مُشْ مُؤْمْنِينْ والفُسَّادْ وقَتَّالِينْ الأَرْوَاحْ والفُجَّارْ والسَّحَّارَة ولِّي يِعْبْدُوا فِي الصْنَبْ والكَذَّابِينْ الكُلْ، بِشْ يْكُونْ مَصِيرْهُمْ البُحَيْرَة الشَّاعْلَة بِالنَّارْ والكِبْرِيتْ. وهَاذَا هُوَّ المُوتْ الثَّانِي».<verse eid="REV 21:8" /></para>
  <para style="s">أُورْشَلِيمْ الجْدِيدَة</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9" />ومْبَعِّدْ، جَانِي وَاحِدْ مِالمْلَايْكَة السَّبْعَة الِّي عَنْدْهُمْ السَّبْعَة كِيسَانْ المِلْيَانِينْ بِالسَّبْعَة بْلَاوَاتْ الإِخْرَانِينْ، وقَالِّي: «إِيجَا نْوَرِّيكْ العْرُوسَة، الِّي بِشْ تْكُونْ مَرْتْ الخَرُوفْ». <verse eid="REV 21:9" /><verse number="10" style="v" sid="REV 21:10" />هَزْنِي فِي الرُّوحْ لِبْعِيدْ، لِجْبَلْ كْبِيرْ وعَالِي ووَرَّانِي أُورْشَلِيمْ المْدِينَة المُقَدْسَة هَابْطَة مِالسْمَاء مِنْ عَنْدْ اللَّهْ، <verse eid="REV 21:10" /><verse number="11" style="v" sid="REV 21:11" />تِضْوِي بْمَجْدْ اللَّهْ، وتِلْمَعْ كِي الحْجَرْ الكْرِيمْ وتْشَبَّهْ لِلْيَشْبْ الصَّافِي كِي البِلَّارْ، <verse eid="REV 21:11" /><verse number="12" style="v" sid="REV 21:12" />وفِيهَا سُورْ كْبِيرْ وعَالِي فِيهْ أَثْنَاشِنْ بَابْ، والبِيبَانْ يْعِسْ عْلِيهُمْ أَثْنَاشِنْ مَلَاكْ، ومَكْتُوبْ عْلِيهُمْ أَسَامِي عْرُوشَاتْ إِسْرَائِيلْ الأَثْنَاشْ. <verse eid="REV 21:12" /><verse number="13" style="v" sid="REV 21:13" />وكَانْ فَمَّة ثْلَاثَة بِيبَانْ مِالشَّرْقْ، وثْلَاثَة مِالشَّمَالْ، وثْلَاثَة مِالجَنُوبْ، وثْلَاثَة مِالغَرْبْ. <verse eid="REV 21:13" /><verse number="14" style="v" sid="REV 21:14" />وسُورْ المْدِينَة فِيهْ أَثْنَاشِنْ سَاسْ، مَكْتُوبْ عْلِيهُمْ أَسَامِي رُسُلْ الخَرُوفْ الأَثْنَاشْ.<verse eid="REV 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 21:15" />والمَلَاكْ الِّي كَلَّمْنِي كَانْ عَنْدُو عْصَا ذْهَبْ، بَاشْ يْقِيسْ بِيهَا المْدِينَة وبِيبَانْهَا وسُورْهَا. <verse eid="REV 21:15" /><verse number="16" style="v" sid="REV 21:16" />وكَانِتْ المْدِينَة مْرَبْعَة، كِي طُولْهَا كِي عُرْضْهَا. يَاخِي قَاسْهَا بِالعْصَا ولْقَاهَا قَدْ طُولْهَا قَدْ عُرْضْهَا وقَدْ عِلْوْهَا: 12 000 وِحْدَةْ قْيَاسْ (2 200 كِيلُومَاتِرْ عْلَى حَسْبْ التَّقْرِيبْ)، <verse eid="REV 21:16" /><verse number="17" style="v" sid="REV 21:17" />ومْبَعِّدْ قَاسْ السُّورْ مْتَاعْهَا، لْقَاهْ 144 ذْرَاعْ، عْلَى خَاطِرْ المَلَاكْ إِسْتَعْمِلْ مِقْيَاسْ بْطُولْ ذْرَاعْ الإِنْسَانْ.<verse eid="REV 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 21:18" />المْدِينَة كَانِتْ مِبْنِيَّة بِالذْهَبْ الخَالِصْ كَايِنُّو بِلَّارْ صَافِي، وسُورْهَا كَانْ مِاليَشْبْ. <verse eid="REV 21:18" /><verse number="19" style="v" sid="REV 21:19" />وسَاسَاتْ السُّورْ مْزَيْنِينْ بْأَنْوَاعْ الحْجَرْ الكْرِيمْ الكُلْ:</para>
  <para style="li" vid="REV 21:19">السَّاسْ الأُوِّلْ يَشْبْ،</para>
  <para style="li" vid="REV 21:19">والثَّانِي يَاقُوتْ أَزْرَقْ،</para>
  <para style="li" vid="REV 21:19">والثَّالِثْ عْقِيقْ أَبْيِضْ،</para>
  <para style="li" vid="REV 21:19">والرَّابَعْ زْمُرُّدْ،<verse eid="REV 21:19" /></para>
  <para style="li">
    <verse number="20" style="v" sid="REV 21:20" />والخَامِسْ عْقِيقْ غَامَقْ،</para>
  <para style="li" vid="REV 21:20">والسَّادِسْ عْقِيقْ أَحْمِرْ،</para>
  <para style="li" vid="REV 21:20">والسَّابَعْ زْبَرْجِدْ،</para>
  <para style="li" vid="REV 21:20">والثَّامِنْ جْزَعْ،</para>
  <para style="li" vid="REV 21:20">والتَّاسَعْ يَاقُوتْ أَصْفِرْ،</para>
  <para style="li" vid="REV 21:20">والعَاشِرْ عْقِيقْ أَخْضِرْ،</para>
  <para style="li" vid="REV 21:20">والحْدَاشْ فَيْرُوزْ،</para>
  <para style="li" vid="REV 21:20">والأَثْنَاشْ جَمَشْتْ.<verse eid="REV 21:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="REV 21:21" />والأَثْنَاشِنْ بَابْ كَانُوا أَثْنَاشِنْ كَعْبَة لُولِي، كُلْ بَابْ مَصْنُوعْ مِنْ كَعْبَة وَحْدَة. وسَاحِةْ المْدِينَة ذْهَبْ صَافِي كِيمَا البِلَّارْ الشَّفَّافْ.<verse eid="REV 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22" />ومَا شُفْتِشْ هَيْكِلْ فِي المْدِينَة، عْلَى خَاطِرْ الرَّبْ الإِلَاهْ القَادِرْ عْلَى كُلْ شَيْ والخَرُوفْ هُومَا هَيْكِلْهَا. <verse eid="REV 21:22" /><verse number="23" style="v" sid="REV 21:23" />والمْدِينَة مَاهِيشْ مِحْتَاجَة لَا لْضَوْ الشَمْسْ ولَا الڨَمْرَة، عْلَى خَاطِرْ مَجْدْ اللَّهْ يْنَوِّرْهَا، والخَرُوفْ هُوَّ فْنَارِتْهَا. <verse eid="REV 21:23" /><verse number="24" style="v" sid="REV 21:24" />الأُمَمْ بِشْ يِمْشِيوْ فِي نُورْهَا، ومْلُوكْ الأَرْضْ بِشْ يْجِيبُولْهَا كْنُوزْهُمْ. <verse eid="REV 21:24" /><verse number="25" style="v" sid="REV 21:25" />وبِيبَانْهَا مَا تِتْسَكَّرْشْ نْهَارْ كَامِلْ، عْلَى خَاطِرْ اللِّيلْ مَا يْجِيهَاشْ! <verse eid="REV 21:25" /><verse number="26" style="v" sid="REV 21:26" />ويْجِيبُولْهَا كْنُوزْ الأُمَمْ وعِزْهُمْ. <verse eid="REV 21:26" /><verse number="27" style="v" sid="REV 21:27" />ومَا يُدْخْلِلْهَا حَتَّى شَيْ مَنْجُوسْ، ولَا الِّي يْعِيشُوا فِي النْجَاسَة وَلَا الِّي يِكْذْبُوا، مَا يُدْخْلُولْهَا كَانْ الِّي أَسَامِيهُمْ مَكْتُوبَة فِي كْتَابْ الحَيَاةْ، كْتَابْ الخَرُوفْ.<verse eid="REV 21:27" /></para>
  <chapter eid="REV 21" />
  <chapter number="22" style="c" sid="REV 22" />
  <para style="s">وَادْ مَاء الحَيَاةْ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1" />ومْبَعِّدْ وَرَّانِي المَلَاكْ وَادْ مَاء الحَيَاةْ صَافِي كِي البِلَّارْ، المَنْبَعْ مْتَاعُو عَرْشْ اللَّهْ والخَرُوفْ، <verse eid="REV 22:1" /><verse number="2" style="v" sid="REV 22:2" />يِجْرِي فِي وِسْطْ سَاحِةْ المْدِينَة. وعَالشِّيرْتِينْ شَجْرِةْ الحَيَاةْ الِّي تَعْطِي غَلِّتْهَا أَثْنَاشِنْ مَرَّة، كُلْ شْهَرْ مَرَّة. وأَوْرَاقْهَا دْوَاء يِشْفِي الأُمَمْ. <verse eid="REV 22:2" /><verse number="3" style="v" sid="REV 22:3" />ومَا عَادِشْ فَمَّة لَعْنَة بِالكُلْ. آمَا عَرْشْ اللَّهْ والخَرُوفْ بِشْ يْكُونُوا فِي المْدِينَة، وِينْ عَبِيدُو يِسْجْدُولُو <verse eid="REV 22:3" /><verse number="4" style="v" sid="REV 22:4" />ويْشُوفُوا وِجْهُو، وإِسْمُو يْكُونْ عْلَى جْبِينْهُمْ. <verse eid="REV 22:4" /><verse number="5" style="v" sid="REV 22:5" />ومَا عَادِشْ بِشْ يْكُونْ فَمَّة لِيلْ، ومُشْ بِشْ يِسْتْحَقُّوا لْضَوْء فْنَارْ وَلَّا شَمْسْ، عْلَى خَاطِرْ الرَّبْ الإِلَاهْ يْضَوِّي عْلِيهُمْ. وهُومَا بِشْ يِمْلْكُوا لْأَبَدْ الآبِدِينْ.<verse eid="REV 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6" />وقَالِّي المَلَاكْ: «الكْلَامْ هَاذَا صْحِيحْ وحَقْ. الرَّبْ الإِلَاهْ الِّي يُوحِي لِلْأَنْبِيَاءْ، بْعَثْ مَلَاكُو بَاشْ يْوَرِّي لْعَبِيدُو شْنُوَّة الِّي لَازِمْ يْصِيرْ عْلَى قْرِيبْ».<verse eid="REV 22:6" /></para>
  <para style="s">المَسِيحْ جَايْ عْلَى قْرِيبْ</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7" />«هَانِي جَايْ فِيسَعْ! صَحَّة لِيهْ الِّي يَعْمِلْ بِكْلَامْ النُّبُوَّة الِّي فِي الكْتَابْ هَاذَا!».<verse eid="REV 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8" />وآنَا يُوحَنَّا، شُفْتْ وسْمَعْتْ الحَاجَاتْ هَاذِي الكُلْ. وَقْتِلِّي شُفْتْهُمْ وسْمَعْتْهُمْ، تِرْمِيتْ قُدَّامْ سَاقِينْ المَلَاكْ الِّي وَرَّاهُمْلِي بَاشْ نِسْجِدْلُو، <verse eid="REV 22:8" /><verse number="9" style="v" sid="REV 22:9" />يَاخِي قَالِّي: «لَا! رُدْ بَالِكْ! آنَا خْدِيمْ كِيفِكْ وكِيفْ خْوَاتِكْ الأَنْبِيَاءْ وكُلْ الِّي يَعْمْلُوا بِكْلَامْ الكْتَابْ هَاذَا. إِسْجِدْ لِلَّهْ!».<verse eid="REV 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 22:10" />وقَالِّي: «مَا تْخَلِّيشْ كْلَامْ النُّبُوَّة الِّي فِي الكْتَابْ هَاذَا سِرْ، عْلَى خَاطِرْ الوَقْتْ الِّي بِشْ تْصِيرْ فِيهْ الحَاجَاتْ هَاذِي قْرُبْ. <verse eid="REV 22:10" /><verse number="11" style="v" sid="REV 22:11" />خَلِّي يْكَمِّلْ الشِّرِّيرْ فِي شَرُّو، والمَنْجُوسْ فِي نْجَاسْتُو، آمَا خَلِّي الصَّالَحْ يْكَمِّلْ فِي صَلَاحُو، والقِدِّيسْ فِي قَدَاسْتُو».<verse eid="REV 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12" />«هَانِي جَايْ فِيسَعْ ومْعَايَا الجَايْزَة الِّي نْجَازِي بِيهَا كُلْ وَاحِدْ بْحَسْبْ فِعْلُو. <verse eid="REV 22:12" /><verse number="13" style="v" sid="REV 22:13" />آنَا الأَلِفْ واليَاءْ، الأُوِّلْ والإِخِّرْ، البِدَايَة والنِّهَايَة». <verse eid="REV 22:13" /><verse number="14" style="v" sid="REV 22:14" />صَحَّة لِلِّي يَغْسْلُوا حْوَايِجْهُمْ، بِشْ يْكُونْ عَنْدْهُمْ الحَقْ فِي شَجْرِةْ الحَيَاةْ، والحَقْ فِي دْخُولْ المْدِينَة مِنْ بِيبَانْهَا. <verse eid="REV 22:14" /><verse number="15" style="v" sid="REV 22:15" />آمَا الكْلَابْ والسَّحَّارِينْ والفُجَّارْ وقَتَّالِينْ الأَرْوَاحْ ولِّي يِعْبْدُوا فِي الصْنَبْ وكُلْ الِّي يِكْذِبْ ويْحِبْ الكِذْبْ، هُومَا لْبَرَّة مِالمْدِينَة.<verse eid="REV 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16" />«آنَا يَسُوعْ بْعَثْتْ مَلَاكِي بَاشْ يِشْهْدِلْكُمْ بِالأُمُورْ هَاذِي فِي الكْنَايِسْ. آنَا أَصْلْ دَاوِدْ ومِنْ ذُرِّيْتُو. آنَا نِجْمِةْ الصْبَاحْ الضَّاوْيَة».<verse eid="REV 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17" />الرُّوحْ والعْرُوسَة يْقُولُوا: «إِيجَا!» ولِّي يِسْمَعْ خَلِّيهْ يْقُولْ: «إِيجَا!». العُطْشَانْ خَلِّيهْ يْجِي! ولِّي يْحِبْ خَلِّيهْ يُشْرُبْ بْلَاشْ مِنْ مَاء الحَيَاةْ.<verse eid="REV 22:17" /></para>
  <para style="s">خَاتْمَة</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18" />وآنَا انَّبَّهْ عْلَى كُلْ الِّي يِسْمَعْ كْلَامْ النُّبُوَّة المَوْجُودَة فِي الكْتَابْ هَاذَا، إِذَا وَاحِدْ يْزِيدْ عْلِيهْ حَاجَة، اللَّهْ بِشْ يْزِيدُو مِالبْلَاوَاتْ المَكْتُوبَة فِيهْ. <verse eid="REV 22:18" /><verse number="19" style="v" sid="REV 22:19" />ولِّي يْنَحِّي مِنْ كْلَامْ النُّبُوَّة الِّي فِي هَا الكْتَابْ، اللَّهْ بِشْ يْنَحِّيلُو بَايُو مِنْ شَجْرِةْ الحَيَاةْ ومِالمْدِينَة المُقَدْسَة، المَذْكُورِينْ فِي هَا الكْتَابْ.<verse eid="REV 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20" />ولِّي يِشْهِدْ بِالأُمُورْ هَاذِي يْقُولْ: «إِيْ نْعَمْ! آنَا جَايْ فِيسَعْ». آمِينْ! إِيجَا يَا الرَّبْ يَسُوعْ! <verse eid="REV 22:20" /><verse number="21" style="v" sid="REV 22:21" />نِعْمِةْ رَبْنَا يَسُوعْ المَسِيحْ مْعَاكُمْ.<verse eid="REV 22:21" /></para>
  <chapter eid="REV 22" />
</usx>