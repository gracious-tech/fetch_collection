<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id" />
  <para style="h">فِلِيمُونْ</para>
  <para style="toc1">رِسَالِةْ بُولِسْ لْفِلِيمُونْ</para>
  <para style="toc2">فِلِيمُونْ</para>
  <para style="toc3">فِلِيمُونْ</para>
  <para style="mt">رِسَالِةْ بُولِسْ لْفِلِيمُونْ</para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />مِنْ بُولِسْ المَرْبُوطْ فِي الحَبْسْ عْلَى خَاطِرْ يَسُوعْ المَسِيحْ، ومِنْ خُونَا تِيمُوثَاوُسْ، لْفِلِيمُونْ حْبِيبْنَا وشْرِيكْنَا فِي الخِدْمَة، <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />ولِلْكْنِيسَة الِّي فِي دَارِكْ، ولْأُخْتْنَا أَبْفِيَّة ولْأَرْخِبُّوسْ الِّي يْجَاهِدْ مْعَانَا فِي الخِدْمَة.<verse eid="PHM 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3" />النِّعْمَة والسَّلَامْ لِيكُمْ مِنْ عَنْدْ اللَّهْ بُونَا والرَّبْ يَسُوعْ المَسِيحْ.<verse eid="PHM 1:3" /></para>
  <para style="s">بُولِسْ يُشْكُرْ اللَّهْ عْلَى إِيمَانْ ومْحَبِّةْ فِلِيمُونْ</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />كُلْ مَا نِتْذَكْرِكْ فِي صْلَاتِي نُشْكُرْ اللَّهْ <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />عَلِّي سْمَعْتُو عْلَى مْحَبْتِكْ وإِخْلَاصِكْ لِلرَّبْ يَسُوعْ ولِلْقِدِّيسِينْ الكُلْ. <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />ونُطْلُبْ مِنْ اللَّهْ بَاشْ الإِيمَانْ الِّي تْشَارِكْنَا فِيهْ يْكُونْ مُثْمِرْ ويْخَلِّيكْ تَعْرِفْ كُلْ حَاجَة صَالْحَة وَلَّاتْ فِينَا عْلَى خَاطِرْ المَسِيحْ. <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />يَا خُويَا رَانِي فْرَحْتْ وتْشَجَّعْتْ بَرْشَة بِمْحَبْتِكْ عْلَى خَاطْرِكْ رَتَّحْتْ قْلُوبْ القِدِّيسِينْ.<verse eid="PHM 1:7" /></para>
  <para style="s">بُولِسْ يُطْلُبْ مِنْ فِلِيمُونْ يِقْبِلْ أُونِسِيمُوسْ</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />هَاذَاكَا عْلَاشْ نْحِبْ نُطْلُبْ مِنِّكْ حَاجَة، رَغْمِلِّي عَنْدِي الحَقْ فِي المَسِيحْ بَاشْ نُأْمْرِكْ تَعْمِلْ اللَّازِمْ، <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />آمَا إِخْتَرْتْ نُطْلُبْهَا مِنِّكْ بْإِسْمْ المْحَبَّة، بْصِيفْتِي آنَا بُولِسْ الرَّاجِلْ الكْبِيرْ، المَرْبُوطْ فِي الحَبْسْ عْلَى خَاطِرْ يَسُوعْ المَسِيحْ، <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />وهِيَّ فِي مَا يْخُصْ وِلْدِي أُونِسِيمُوسْ، الِّي وَلَّى وِلْدِي وآنَا فِي الحَبْسْ. <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />هُوَّ قْبَلْ مَا كَانِشْ نَافَعْ لِيكْ، آمَا تَوَّا وَلَّى نَافَعْ لِيكْ ولِيَّا.<verse eid="PHM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12" />هَانِي مْرَجَّعْهُولِكْ وهُوَّ رَاهُو قَطْعَة مِنِّي. <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />وحَبِّيتْ نْخَلِّيهْ بَحْذَايَا بَاشْ يِخْدِمْنِي فِي عُوضِكْ وآنَا مَرْبُوطْ عْلَى خَاطِرْ البْشَارَة <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />آمَا مَا حَبِّيتْ نَعْمِلْ حَتَّى شَيْ مِنْ غِيرْ مَا نْشَاوْرِكْ، بَاشْ تَعْمِلْ المْزِيَّة هَاذِي بِرْضَاكْ مُشْ عْلَى خَاطِرْهَا مَفْرُوضَة عْلِيكْ.<verse eid="PHM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15" />مُمْكِنْ هَاذَاكَا عْلَاشْ بْعِدْ عْلِيكْ مُدَّة قْصِيرَة بَاشْ مْبَعِّدْ يِرْجَعْلِكْ عْلَى طُولْ، <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />مَا عَادِشْ بْصِيفْتُو عَبْدْ، آمَا خِيرْ مِالعَبْدْ، بْصِيفْتُو خُو مَحْبُوبْ، خَاصَّةً عَنْدِي آنَا، فَمَا بَالِكْ عَنْدِكْ إِنْتِ، ومُشْ فِي العَلَاقَة البَشَرِيَّة بَرْكْ، آمَا فِي الرَّبْ زَادَا.<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />وكَانْ إِنْتِ حَاسِبْنِي شْرِيكِكْ، إِقْبْلُو كِيمَا تِقْبِلْنِي آنَا. <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />وإِذَا كَانْ ضَرِّكْ، وَلَّا تْسَالُو حَاجَة، إِحْسِبْهَا دِينْ عْلِيَّا آنَا. <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />وآنَا بُولِسْ نِكْتِبْلِكْ بْخَطْ يِدِّي ونُضْمُنْلِكْ إِنِّي نْخَلْصِكْ. ومِنْ غِيرْ مَا نْقُلِّكْ هُونِي الِّي إِنْتِ بْكُلِّكْ مَدْيُونْ لِيَّا. <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />مَالَا يَا خُويَا، أَعْمِلْ عْلِيَّا هَا المْزِيَّة عْلَى خَاطِرْ الرَّبْ، ورَتَّحْ قَلْبِي فِي المَسِيحْ.<verse eid="PHM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21" />كْتِبْتْلِكْ الرِّسَالَة هَاذِي وآنَا مِتْأَكِّدْ الِّي إِنْتِ بِشْ تِسْمَعْ كْلَامِي وعَارِفْ الِّي بِشْ تَعْمِلْ أَكْثِرْ مِلِّي نُطْلْبُو مِنِّكْ. <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />ومَاذَبِيَّا تْحَضَّرْلِي وِينْ نُسْكُنْ عْلَى خَاطِرْ نِتْمَنَّى إِنُّو اللَّهْ يَسْتَجِيبْ لِصْلَاتْكُمْ ويْرَجَّعْنِي لِيكُمْ.<verse eid="PHM 1:22" /></para>
  <para style="s">سْلَامْ</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />يْسَلَّمْ عْلِيكُمْ أَبَفْرَاسْ المَرْبُوطْ مْعَايَا فِي الحَبْسْ عْلَى خَاطِرْ يَسُوعْ المَسِيحْ، <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />وزَادَا مُرْقُسْ وأَرِسْتَرْخُسْ ودِيمَاسْ ولُوقَا الِّي هُومَا مْعَايَا فِي الخِدْمَة.<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />ونِعْمِةْ رَبْنَا يَسُوعْ المَسِيحْ تْكُونْ مْعَاكُمْ.<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>