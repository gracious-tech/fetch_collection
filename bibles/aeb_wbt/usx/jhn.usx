<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id" />
  <para style="h">يُوحَنَّا</para>
  <para style="toc1">بْشَارِةْ يُوحَنَّا</para>
  <para style="toc2">يُوحَنَّا</para>
  <para style="toc3">يُوحَنَّا</para>
  <para style="mt">بْشَارِةْ يُوحَنَّا</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">الكِلْمَة وَلَّى بَشَرْ</para>
  <para style="q1">
    <verse number="1" style="v" sid="JHN 1:1" />فِي الأُوِّلْ بِالكُلْ كَانْ الكِلْمَة،</para>
  <para style="q2" vid="JHN 1:1">والكِلْمَة كَانْ عَنْدْ اللَّهْ،</para>
  <para style="q1" vid="JHN 1:1">والكِلْمَة كَانْ هُوَّ اللَّهْ.<verse eid="JHN 1:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="JHN 1:2" />هُوَّ كَانْ فِي الأُوِّلْ عَنْدْ اللَّهْ،<verse eid="JHN 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JHN 1:3" />واللَّهْ خْلَقْ كُلْ شَيْ بِيهْ،</para>
  <para style="q2" vid="JHN 1:3">ومِنْ غِيرُو مَا تِخْلَقّْ حَتَّى شَيْ.<verse eid="JHN 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JHN 1:4" />فِيهْ كَانِتْ الحَيَاةْ،</para>
  <para style="q2" vid="JHN 1:4">والحَيَاةْ هَاذِي كَانِتْ النُّورْ لِلنَّاسْ.<verse eid="JHN 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JHN 1:5" />والنُّورْ يِضْوِي فِي الظْلَامْ،</para>
  <para style="q2" vid="JHN 1:5">والظْلَامْ مَا غِلْبُوشْ.<verse eid="JHN 1:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />بْعَثْ اللَّهْ رَاجِلْ إِسْمُو يُوحَنَّا، <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />ويُوحَنَّا جَاء شَاهِدْ بَاشْ يِشْهِدْ لِلنُّورْ، بَاشْ عْلَى طْرِيقُو هُوَّ يَمْنُوا النَّاسْ الكُلْ. <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />مَا كَانِشْ هُوَّ النُّورْ، آمَا جَاء بَاشْ يِشْهِدْ لِلنُّورْ.<verse eid="JHN 1:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="JHN 1:9" />والكِلْمَة هُوَّ النُّورْ الحَقِيقِي الِّي جَاء لِلْعَالِمْ،</para>
  <para style="q2" vid="JHN 1:9">بَاشْ يْنَوَّرْ كُلْ إِنْسَانْ.<verse eid="JHN 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JHN 1:10" />هُوَّ كَانْ فِي العَالِمْ،</para>
  <para style="q2" vid="JHN 1:10">وبِيهْ تِخْلَقّْ العَالِمْ، آمَا العَالِمْ مَا عَرْفُوشْ.<verse eid="JHN 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JHN 1:11" />جَاء لْشَعْبُو،</para>
  <para style="q2" vid="JHN 1:11">آمَا شَعْبُو مَا قِبْلُوشْ.<verse eid="JHN 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JHN 1:12" />آمَا النَّاسْ الِّي قِبْلُوهْ الكُلْ، مَعْنِتْهَا الِّي أَمْنُوا بْإِسْمُو،</para>
  <para style="q2" vid="JHN 1:12">عْطَاهُمْ الحَقْ بَاشْ يْوَلِّيوْ وْلَادْ اللَّهْ.<verse eid="JHN 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JHN 1:13" />هُومَا الِّي تْوِلْدُوا، لَا مِنْ بَشَرْ ولَا مِنْ شَهْوِةْ بْدَنْ ولَا مِنْ قَرَارْ إِنْسَانْ،</para>
  <para style="q2" vid="JHN 1:13">آمَا تْوِلْدُوا مِنْ اللَّهْ.<verse eid="JHN 1:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JHN 1:14" />والكِلْمَة وَلَّى بَشَرْ،</para>
  <para style="q2" vid="JHN 1:14">وعَاشْ بِينَاتْنَا</para>
  <para style="q1" vid="JHN 1:14">مِلْيَانْ بِالنِّعْمَة والحَقْ.</para>
  <para style="q2" vid="JHN 1:14">وشُفْنَا مَجْدُو،</para>
  <para style="q1" vid="JHN 1:14">المَجْدْ الِّي خْذَاهْ مِنْ عَنْدْ الآبْ،</para>
  <para style="q2" vid="JHN 1:14">بِإِعْتِبَارُو إِبْنُو الوَحِيدْ.<verse eid="JHN 1:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />وشْهِدْلُو يُوحَنَّا وقَالْ: «هَاذَا هُوَّ الِّي قُلْتْ عْلِيهْ: الِّي جَايْ بَعْدِي هُوَّ أَعْظَمْ مِنِّي عْلَى خَاطْرُو كَانْ قَبْلِي». <verse eid="JHN 1:15" /><verse number="16" style="v" sid="JHN 1:16" />وأَحْنَا الكُلْنَا خْذِينَا مِنْ نِعْمْتُو الفَايْضَة، نِعْمَة فُوقْ نِعْمَة، <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />عْلَى خَاطِرْ اللَّهْ عْطَانَا الشَّرِيعَة عْلَى طْرِيقْ مُوسَى، آمَا الحَقْ والنِّعْمَة جَاوْ عْلَى طْرِيقْ يَسُوعْ المَسِيحْ. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />حَتَّى حَدْ مَا شَافْ اللَّهْ. آمَا الإِبْنْ الوَحِيدْ الِّي هُوَّ عَنْدْ الآبْ، عَرَّفْنَا بِيهْ.<verse eid="JHN 1:18" /></para>
  <para style="s">يَسُوعْ خَرُوفْ اللَّهْ الِّي يْنَحِّي ذْنُوبْ العَالِمْ</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />وهَاذِي هِيَّ الشْهَادَة الِّي شْهِدْ بِيهَا يُوحَنَّا، وَقْتِلِّي اليْهُودْ الِّي فِي أُورْشَلِيمْ بَعْثُولُوا كَهَنَة ولَاوِيِّينْ بَاشْ يِسْأْلُوهْ: «شْكُونِكْ إِنْتِ؟». <verse eid="JHN 1:19" /><verse number="20" style="v" sid="JHN 1:20" />مَا نْكَرْشْ وقَالِلْهُمْ جْهَارْ: «مَانِيشْ آنَا المَسِيحْ». <verse eid="JHN 1:20" /><verse number="21" style="v" sid="JHN 1:21" />وَلَّاوْ سِأْلُوهْ: «مَالَا شْكُونِكْ؟ إِنْتِ إِيلِيَّا؟». قَالِلْهُمْ: «لَا». «إِنْتِ النَّبِيْ؟». جَاوِبْهُمْ زَادَا: «لَا». <verse eid="JHN 1:21" /><verse number="22" style="v" sid="JHN 1:22" />قَالُولُو: «مَالَا شْكُونِكْ إِنْتِ؟ آشْ نْقُولُوا لِلنَّاسْ الِّي بَعْثُونَا؟ شُنُوَّة تْقُولْ عْلَى رُوحِكْ؟». <verse eid="JHN 1:22" /><verse number="23" style="v" sid="JHN 1:23" />قَالْ: «كِيمَا قَالْ النَّبِيْ إِشَعْيَاءْ:</para>
  <para style="b" vid="JHN 1:23" />
  <para style="q1" vid="JHN 1:23">"آنَا صُوتْ يْعَيِّطْ فِي الخْلَاء:</para>
  <para style="q2" vid="JHN 1:23">حَضّْرُوا طْرِيقْ الرَّبْ"».<verse eid="JHN 1:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />وبِينْ المَبْعُوثِينْ كَانْ فَمَّة فِرِّيسِيِّينْ، <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />سِأْلُوهْ: «عْلَاشْ تْعَمِّدْ إِذَا كَانْ مَاكِشْ المَسِيحْ ولَا إِيلِيَّا ولَا النَّبِيْ؟». <verse eid="JHN 1:25" /><verse number="26" style="v" sid="JHN 1:26" />جَاوِبْهُمْ يُوحَنَّا: «آنَا نْعَمِّدْ فِي المَاء، آمَا بِينَاتْكُمْ وَاحِدْ مَا تَعْرْفُوهِشْ، <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />هُوَّ يْجِي بَعْدِي، ويْكُونْ أَعْظَمْ مِنِّي، وآنَا مَا نِسْتَاهِلْشْ نْكُونْ الخْدِيمْ الِّي يْحِلُّو رْبَايِطْ صَنْدَالُو». <verse eid="JHN 1:27" /><verse number="28" style="v" sid="JHN 1:28" />هَاذَا الكُلْ صَارْ فِي دَشْرِةْ بِيتْ عَنْيَا، فِي شَرْقْ نَهْرْ الأُرْدُنْ، وِينْ كَانْ يُوحَنَّا يْعَمِّدْ.<verse eid="JHN 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />مِنْ غُدْوَة شَافْ يُوحَنَّا يَسُوعْ جَايُو، يَاخِي قَالْ: «هَاذَا هُوَّ خَرُوفْ اللَّهْ الِّي يْنَحِّي ذْنُوبْ العَالِمْ. <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />هَاذَا هُوَّ الِّي قُلْتْ عْلِيهْ: فَمَّة شْكُونْ يْجِي بَعْدِي، وهُوَّ أَعْظَمْ مِنِّي، عْلَى خَاطْرُو كَانْ قَبْلِي. <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />وآنَا بِيدِي مَا كُنْتِشْ نَعْرْفُو. آمَا جِيتْ نْعَمِّدْ فِي المَاء بَاشْ بَنِي إِسْرَائِيلْ يَعْرْفُوهْ».<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />وشْهِدْ يُوحَنَّا، وقَالْ: «آنَا شُفْتْ الرُّوحْ هَابِطْ مِالسْمَاء كِالحْمَامَة وحَطْ فُوقُو. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />وآنَا مَا كُنْتِشْ نَعْرْفُو، آمَا الِّي بْعَثْنِي بَاشْ نْعَمِّدْ فِي المَاء قَالِّي: "الِّي تْشُوفْ الرُّوحْ يَهْبِطْ ويْحُطْ فُوقُو، هَاذَاكَا هُوَّ الِّي بَاشْ يْعَمِّدْ فِي الرُّوحْ القُدُسْ". <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />وآنَا شُفْتْ هَاذَا بْعِينِي، هَاذَاكَا عْلَاشْ نِشْهِدْ الِّي هُوَّ إِبْنْ اللَّهْ».<verse eid="JHN 1:34" /></para>
  <para style="s">تْلَامْذِةْ يَسُوعْ الأُولَانِينْ</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />مِنْ غُدْوَة كَانْ يُوحَنَّا وَاقِفْ مْعَ زُوزْ مِنْ تْلَامِذْتُو. <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />شَافْ يَسُوعْ مِتْعَدِّي يَاخِي قَالْ: «هَاذَا هُوَّ خَرُوفْ اللَّهْ». <verse eid="JHN 1:36" /><verse number="37" style="v" sid="JHN 1:37" />وكِي سَمْعُوا التْلَامْذَة الزُّوزْ الكْلَامْ هَاذَا، مْشَاوْ وتَبْعُوا يَسُوعْ. <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />ووَقْتِلِّي تْلَفِّتْ يَسُوعْ وشَافْهُمْ يْتَبْعُوا فِيهْ، سْإِلْهُمْ: «آشْ تْحِبُّوا؟». قَالُولُو: «يَا رَابِّي، (الِّي مَعْنَاهْ يَا مُعَلِّمْ)، وِينْ تُسْكُنْ؟» <verse eid="JHN 1:38" /><verse number="39" style="v" sid="JHN 1:39" />قَالِلْهُمْ: «إِيجَاوْ شُوفُوا». يَاخِي مْشَاوْ وشَافُوهْ وِينْ يُسْكُنْ، وعَدَّاوْ مْعَاهْ بْقِيِّة النْهَارْ، ووَقْتْهَا كَانِتْ الأَرْبْعَة مْتَاعْ العْشِيَّة. <verse eid="JHN 1:39" /><verse number="40" style="v" sid="JHN 1:40" />أَنْدَرَاوُسْ خُو سِمْعَانْ بُطْرُسْ، كَانْ وَاحِدْ مِالزُّوزْ الِّي سَمْعُوا آشْ قَالْ يُوحَنَّا، وتَبْعُوا يَسُوعْ. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />لْقَى أَنْدَرَاوُسْ خُوهْ سِمْعَانْ، وقَالُّو: «لْقِينَا المَسِيَّا»، الِّي مَعْنَاهْ المَسِيحْ، <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />وهَزُّو مْعَاهْ لْيَسُوعْ. غْزَرْلُوا يَسُوعْ وقَالُّو: «إِنْتِ سِمْعَانْ وِلْدْ يُونَا. بِشْ يْوَلِّي إِسْمِكْ صَفَا، الِّي مَعْنَاهْ "بُطْرُسْ"».<verse eid="JHN 1:42" /></para>
  <para style="s">فِيلِۑُّسْ ونَثَنَائِيلْ</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />مِنْ غُدْوَة قَرِّرْ يَسُوعْ يِمْشِي لْمَنْطَقْةْ الجَلِيلْ، يَاخِي لْقَى فِيلِۑُّسْ وقَالُّو: «تَبَّعْنِي». <verse eid="JHN 1:43" /><verse number="44" style="v" sid="JHN 1:44" />وفِيلِۑُّسْ كَانْ مِنْ بِيتْ صَيْدَا، مْدِينِةْ أَنْدَرَاوُسْ وبُطْرُسْ. <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />لْقَى فِيلِۑُّسْ نَثَنَائِيلْ، وقَالُّو: «لْقِينَا الِّي كْتِبْ عْلِيهْ مُوسَى فِي التَّوْرَاةْ، وكِتْبُوا عْلِيهْ الأَنْبِيَاءْ، يَسُوعْ وِلْدْ يُوسِفْ الِّي مِنْ مْدِينِةْ النَّاصْرَة». <verse eid="JHN 1:45" /><verse number="46" style="v" sid="JHN 1:46" />قَالُّو نَثَنَائِيلْ: «يَاخِي تُخْرُجْ مِالنَّاصْرَة حَاجَة تُصْلُحْ؟» جَاوْبُو فِيلِۑُّسْ: «إِيجَا وشُوفْ!». <verse eid="JHN 1:46" /><verse number="47" style="v" sid="JHN 1:47" />شَافْ يَسُوعْ نَثَنَائِيلْ جَايُّو، يَاخِي قَالْ عْلِيهْ: «هَاذَا إِسْرَائِيلِي بِالحَقْ، ومَا فِيهِشْ شَكْ!» <verse eid="JHN 1:47" /><verse number="48" style="v" sid="JHN 1:48" />قَالُّو نَثَنَائِيلْ: «كِيفَاشْ عْرَفْتْنِي؟» جَاوْبُو يَسُوعْ: «قْبَلْ مَا يْعَيِّطْلِكْ فِيلِۑُّسْ رِيتِكْ قَاعِدْ تَحْتْ الكَرْمَة». <verse eid="JHN 1:48" /><verse number="49" style="v" sid="JHN 1:49" />جَاوْبُو نَثَنَائِيلْ: «يَا مُعَلِّمْ إِنْتِ هُوَّ إِبْنْ اللَّهْ. إِنْتِ هُوَّ مَلِكْ إِسْرَائِيلْ!» <verse eid="JHN 1:49" /><verse number="50" style="v" sid="JHN 1:50" />جَاوْبُو يَسُوعْ: «يَاخِي أَمَّنْتْ عْلَى خَاطِرْ قُتْلِكْ الِّي آنَا شُفْتِكْ قَاعِدْ تَحْتْ الكَرْمَة؟ رَاكْ بَاشْ تْشُوفْ حَاجَاتْ أَعْظِمْ مِنْ هَاذِي». <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />وزَادْ قَالُّو: «الحَقْ الحَقْ نْقُولِلْكُمْ: بِشْ تْشُوفُوا السْمَاء مَحْلُولَة، ومْلَايِكْةْ اللَّهْ طَالْعِينْ هَابْطِينْ عْلَى إِبْنْ الإِنْسَانْ».<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">مُعْجْزِةْ عِرْسْ قَانَا</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />وفِي النْهَارْ الثَّالِثْ كَانْ فَمَّة عِرْسْ فِي مْدِينِةْ قَانَا الِّي فِي مَنْطَقْةْ الجَلِيلْ، وكَانِتْ أُمْ يَسُوعْ حَاضْرَة فِيهْ. <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />ويَسُوعْ وتْلَامِذْتُو كَانُوا زَادَا مِسْتَدْعِينْ. <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />وَقْتِلِّي وْفَى الشْرَابْ، قَالِتْلُو أُمُّو: «رَاهُو مَا عَادِشْ عَنْدْهُمْ شْرَابْ». <verse eid="JHN 2:3" /><verse number="4" style="v" sid="JHN 2:4" />قَالِلْهَا يَسُوعْ: «عْلَاشْ تْحِبْنِي نِدَّخِّلْ يَا مْرَا؟ رَاهُو وَقْتِي مَزَّالْ مَا جَاشْ!». <verse eid="JHN 2:4" /><verse number="5" style="v" sid="JHN 2:5" />قَالِتْ أُمُّو لِلْخُدَّامْ: «الِّي يْقُلْكُمْ عْلِيهْ أَعْمْلُوهْ». <verse eid="JHN 2:5" /><verse number="6" style="v" sid="JHN 2:6" />وكَانِتْ فَمَّة سِتَّة قْلَالْ حْجَرْ مِلِّي يِسْتَعْمْلُوهُمْ اليْهُودْ بِشْ يِطَّهْرُوا بْمَاهُمْ، حَسْبْ عَادَاتْهُمْ. كُلْ وَحْدَة مِنْهُمْ تَرْفَعْ مَا بِينْ 80 و120 إِيتْرَا. <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />قَالْ يَسُوعْ لِلْخُدَّامْ: «عَبِّيوْ القْلَالْ بِالمَاء» يَاخِي عَبَّاوْهُمْ لِلْفُمْ. <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />وقَالِلْهُمْ: «تَوَّا أُغْرْفُوا مِنْهَا وأَعْطِيوْ لِلْمَسْؤُولْ عَالسَّهْرِيَّة». وهَاذَاكَا آشْ عَمْلُوا. <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />ووَقْتِلِّي ذَاقْ المَسْؤُولْ عَالسَّهْرِيَّة المَاء الِّي وَلَّى شْرَابْ، مَا كَانِشْ يَعْرِفْ عْلِيهْ مْنِينْ جَاء. آمَا الخُدَّامْ الِّي جَابُوهُولُو كَانُوا يَعْرْفُوا. يَاخِي عَيِّطْ لِلْعْرُوسْ <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />وقَالُّو: «النَّاسْ الكُلْ يَعْطِيوْ الشْرَابْ البَاهِي فِي الأُوِّلْ، وبَعْدْمَا يِسْكْرُوا الضْيُوفْ، يَعْطِيوْهُمْ الشْرَابْ العَادِي. آمَا إِنْتِ خَلِّيتْ الشْرَابْ البَاهِي لِلِّخِّرْ!». <verse eid="JHN 2:10" /><verse number="11" style="v" sid="JHN 2:11" />وهَاذِي أَوِّلْ مُعْجْزَة يَعْمَلْهَا يَسُوعْ، وكَانِتْ فِي مْدِينِةْ قَانَا فِي الجَلِيلْ. وهَكَّا ظَهِّرْ مَجْدُو، يَاخِي أَمْنُوا بِيهْ تْلَامِذْتُو. <verse eid="JHN 2:11" /><verse number="12" style="v" sid="JHN 2:12" />وبَعْدْهَا، هْبَطْ لْكَفْرْنَاحُومْ هُوَّ وأُمُّو وخْوَاتُو وتْلَامِذْتُو، وقَعْدُوا فِيهَا أَيَّامَاتْ.<verse eid="JHN 2:12" /></para>
  <para style="s">يَسُوعْ يْطَرِّدْ البَيَّاعَة مِالهَيْكِلْ</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />وكِي قْرُبْ عِيدْ الفِصْحْ اليْهُودِي، طْلَعْ يَسُوعْ لْأُورْشَلِيمْ. <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />ولْقَى فِي الهَيْكِلْ بَيَّاعِةْ البْڨَرْ والغْنَمْ والحْمَامْ، ولِّي يْصَرْفُوا فِي الفْلُوسْ حَاطِّينْ طْوَاوِلْهُمْ وقَاعْدِينْ. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />يَاخِي عْمَلْ سُوطْ مِنْ حْبَالْ، وطَرِّدْهُمْ الكُلْ مِالهَيْكِلْ، هُومَا وغْنَمْهُمْ وبْڨَرْهُمْ. وقْلِبْ طْوَاوِلْ النَّاسْ الِّي يْصَرْفُوا فِي الفْلُوسْ وفَرْتِلْهُمْ فْلُوسْهُمْ. <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />وقَالْ لْبَيَّاعِةْ الحْمَامْ: «هِزُّوا حْمَامْكُمْ مِنْ هُونِي! مَا تْرُدُّوشْ دَارْ بَابَا سُوقْ لِلْبِيعْ والشْرَى». <verse eid="JHN 2:16" /><verse number="17" style="v" sid="JHN 2:17" />يَاخِي تْذَكْرُوا تْلَامِذْتُو المَكْتُوبْ فِي الكْتُبْ المُقَدْسَة: «الغِيرَة عْلَى دَارِكْ كْلَاتْنِي».<verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />قَالُولُو اليْهُودْ: «أَعْمْلِلْنَا مُعْجْزَة تْوَرِّينَا الِّي عَنْدِكْ الحَقْ بَاشْ تَعْمِلْ الِّي عْمَلْتُو». <verse eid="JHN 2:18" /><verse number="19" style="v" sid="JHN 2:19" />جَاوِبْهُمْ يَسُوعْ: «هِدُّوا الهَيْكِلْ هَاذَا، وآنَا نْعَاوِدْ نِبْنِيهْ فِي ثْلَاثَة أَيَّامْ». <verse eid="JHN 2:19" /><verse number="20" style="v" sid="JHN 2:20" />قَالُولُو اليْهُودْ: «الهَيْكِلْ هَاذَا قْعَدْ 46 سْنَة بَاشْ يِتِبْنَى، وإِنْتِ بَاشْ تِبْنِيهْ فِي ثْلَاثَة أَيَّامْ؟» <verse eid="JHN 2:20" /><verse number="21" style="v" sid="JHN 2:21" />آمَا الهَيْكِلْ الِّي كَانْ يُقْصُدْ فِيهْ هُوَّ بَدْنُو. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />هَاذَاكَا عْلَاشْ، وَقْتِلِّي قَامْ مِالمُوتْ، تْذَكْرُوا تْلَامِذْتُو آشْ قَالْ، وأَمْنُوا بِالكْتُبْ المُقَدْسَة وبِالكْلَامْ الِّي قَالُّو يَسُوعْ.<verse eid="JHN 2:22" /></para>
  <para style="s">يَسُوعْ يَعْرِفْ قْلُوبْ النَّاسْ</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />وَقْتِلِّي كَانْ فِي أُورْشَلِيمْ فِي عِيدْ الفِصْحْ، أَمْنُوا بِيهْ بَرْشَة نَاسْ كِي شَافُوا المُعْجْزَاتْ الِّي عْمَلْهُمْ. <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />آمَا هُوَّ مَا سْتَأْمِنْهُمْشْ عْلَى رُوحُو، عْلَى خَاطْرُو كَانْ يَعْرِفْ النَّاسْ الكُلْ بِالڨْدَا، <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />ومَا يِحْتَاجِشْ لِشْكُونْ يَحْكِيلُو عْلِيهُمْ. عْلَى خَاطْرُو يَعْرِفْ شْنُوَّة فِي قَلْبْ كُلْ إِنْسَانْ.<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">يِلْزْمِكُمْ تِتْوِلْدُوا مِنْ جْدِيدْ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />كَانْ فَمَّة رَاجِلْ فِرِّيسِي إِسْمُو نِيقُودِيمُوسْ، وَاحِدْ مِنْ قَادِةْ اليْهُودْ، <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />جَاء لْيَسُوعْ فِي اللِّيلْ وقَالُّو: «يَا مُعَلِّمْ، نَعْرْفُوا الِّي إِنْتِ مُعَلِّمْ جِيتْ مِنْ عَنْدْ اللَّهْ. عْلَى خَاطِرْ حَتَّى حَدْ مَا يْنَجِّمْ يَعْمِلْ المُعْجْزَاتْ الِّي تَعْمِلْ فِيهُمْ، إِلَّا إِذَا كَانْ اللَّهْ مْعَاهْ». <verse eid="JHN 3:2" /><verse number="3" style="v" sid="JHN 3:3" />يَاخِي جَاوْبُو يَسُوعْ: «الحَقْ الحَقْ نْقُلِّكْ: حَتَّى حَدْ مَا يْنَجِّمْ يْشُوفْ مَمْلَكْةْ اللَّهْ إِلَّا إِذَا كَانْ يْعَاوِدْ يِتْوْلِدْ مِنْ جْدِيدْ». <verse eid="JHN 3:3" /><verse number="4" style="v" sid="JHN 3:4" />سِأْلُو نِيقُودِيمُوسْ: «كِيفَاشْ الوَاحِدْ يْنَجِّمْ يِتْوْلِدْ بَعْدْمَا شَابْ؟ يَاخِي يْنَجِّمْ يُدْخُلْ لْكِرْشْ أُمُّو مَرَّة أُخْرَى ويِتْوْلِدْ مِنْ جْدِيدْ؟».<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />جَاوْبُو يَسُوعْ: «الحَقْ الحَقْ نْقُلِّكْ: إِذَا كَانْ وَاحِدْ مَا يِتْوْلِدْشْ مِالمَاء ومِالرُّوحْ، مَا يْنَجِّمْشْ يُدْخُلْ لْمَمْلِكْةْ اللَّهْ. <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />المَوْلُودْ مِنْ لْحَمْ ودَمْ هُوَّ لْحَمْ ودَمْ، والمَوْلُودْ مِنْ رُوحْ اللَّهْ هُوَّ تَابَعْ لْرُوحْ اللَّهْ. <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />مَا تِسْتَغْرَبْشْ الِّي قُتْلِكْ: يِلْزْمِكُمْ تِتْوِلْدُوا مِنْ جْدِيدْ. <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />الرِّيحْ تْهِبْ كِيفْ مَا تْحِبْ، وتِسْمَعْ صُوتْهَا، آمَا مَا تَعْرِفْهَاشْ مْنِينْ جَاتْ ولَا لْوِينْ مَاشْيَة: ونَفْسْ الشَّيْ بِالنِّسْبَةْ لْكُلْ وَاحِدْ يِتْوْلِدْ مِالرُّوحْ».<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />قَالُّو نِيقُودِيمُوسْ: «كِيفَاشْ يْنَجِّمْ يْصِيرْ هَاذَا؟». <verse eid="JHN 3:9" /><verse number="10" style="v" sid="JHN 3:10" />جَاوْبُو يَسُوعْ: «إِنْتِ تْعَلِّمْ فِي بَنِي إِسْرَائِيلْ ومَا تَعْرَفْشْ هَاذَا! <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />الحَقْ الحَقْ نْقُلِّكْ: أَحْنَا نَحْكِيوْ عَلِّي نَعْرْفُوهْ، ونِشْهْدُوا عَلِّي شُفْنَاهْ، آمَا إِنْتُومَا مَا تِقْبْلُوشْ شْهَادِتْنَا. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />حْكِيتِلْكُمْ عْلَى أُمُورْ الدِّنْيَا هَاذِي ومَا صَدَّقْتُونِيشْ. مَالَا كِيفَاشْ بِشْ تْصَدْقُوا كِي نَحْكِيلْكُمْ عْلَى أُمُورْ السْمَاء؟ <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />حَتَّى حَدْ مَا طْلَعْ لِلسْمَاء إِلَّا إِبْنْ الإِنْسَانْ الِّي هْبَطْ مِالسْمَاء.<verse eid="JHN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14" />«وكِيمَا عَلَّقْ مُوسَى اللَّفْعَى فِي الصَّحْرَاء، هَكَّا إِبْنْ الإِنْسَانْ لَازِمْ يِتْعَلَّقْ زَادَا، <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />بَاشْ كُلْ وَاحِدْ يَمِّنْ بِيهْ يَاخِذْ الحَيَاةْ الأَبَدِيَّة. <verse eid="JHN 3:15" /><verse number="16" style="v" sid="JHN 3:16" />اللَّهْ حَبْ النَّاسْ الكُلْ، لْدَرْجِةْ إِنُّو ضَحَّى بْإِبْنُو الوَحِيدْ، بَاشْ كُلْ مِنْ يَمِّنْ بِيهْ، مَا يِمْشِيشْ لِلْهْلَاكْ، آمَا يَاخُو الحَيَاةْ الأَبَدِيَّة. <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />عْلَى خَاطِرْ اللَّهْ مَا بْعَثْشْ إِبْنُو لِلنَّاسْ بَاشْ يُحْكُمْ عْلِيهُمْ، آمَا بَاشْ يْنَجِّيهُمْ. <verse eid="JHN 3:17" /><verse number="18" style="v" sid="JHN 3:18" />الِّي يَمِّنْ بِيهْ مَا يِتْحَاسِبْشْ، ولِّي مَا يَمِّنْشْ رَاهُو تَحْكَمْ عْلِيهْ بِالمْسَبَّقْ، عْلَى خَاطْرُو مَا أَمَّنْشْ بْإِبْنْ اللَّهْ الوَحِيدْ.<verse eid="JHN 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 3:19" />«وهَاذَا هُوَّ الحُكْمْ: النُّورْ جَاء لِلْعَالِمْ، آمَا النَّاسْ حَبُّوا الظْلَامْ أَكْثِرْ مِالنُّورْ، عْلَى خَاطِرْهُمْ يَعْمْلُوا فِي الشَّرْ. <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />كُلْ وَاحِدْ يَعْمِلْ الشَّرْ يَكْرَهْ النُّورْ ومَا يُقْرُبْلُوشْ بَاشْ أَعْمَالُو مَا تِتْكْشِفْشْ. <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />آمَا الِّي يْتَبَّعْ الحَقْ، يُقْرُبْ لِلنُّورْ، بَاشْ يُظْهُرْ الِّي أَعْمَالُو تْعَمْلِتْ بْقُوِّةْ اللَّهْ».<verse eid="JHN 3:21" /></para>
  <para style="s">يُوحَنَّا يِشْهِدْ لْيَسُوعْ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />ومْبَعِّدْ مْشَى يَسُوعْ وتْلَامِذْتُو لْمَنْطَقْةْ اليَهُودِيَّة، وقْعَدْ مْعَاهُمْ غَادِي، وبْدَا يْعَمِّدْ فِي النَّاسْ. <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />وكَانْ يُوحَنَّا زَادَا يْعَمِّدْ فِي مَنْطَقْةْ عِينْ نُونْ، بَحْذَا مْدِينِةْ سَالِيمْ، عْلَى خَاطِرْ كَانْ فِيهَا بَرْشَة مَاء. وكَانُوا النَّاسْ يْجِيوْ بَاشْ يْعَمِّدْهُمْ. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />وهَاذَا الكُلْ صَارْ قْبَلْ مَا يِتِرْمَى يُوحَنَّا فِي الحَبْسْ.<verse eid="JHN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />وصَارْ نِقَاشْ بِينْ تْلَامِذْةْ يُوحَنَّا ووَاحِدْ مِاليْهُودْ فِي مَوْضُوعْ التَّطْهِيرْ. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />يَاخِي جَاوْ لْيُوحَنَّا وقَالُولُو: «يَا مُعَلِّمْ، الرَّاجِلْ الِّي كَانْ مْعَاكْ فِي الشِّيرَة الأُخْرَى مْتَاعْ نَهْرْ الأُرْدُنْ ولِّي إِنْتِ شْهِدْتْلُو، رَاهُو تَوْ قَاعِدْ يْعَمِّدْ والنَّاسْ الكُلْ يِمْشِيوْلُو».<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />جَاوِبْهُمْ يُوحَنَّا: «حَتَّى حَدْ مَا يْنَجِّمْ يَاخُذْ حَاجَة إِلَّا إِذَا كَانْ عْطَاهَالُو اللَّهْ. <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />وإِنْتُومَا بِيدْكُمْ تِشْهْدُوا الِّي آنَا قُلْتْ: "مَانِيشْ آنَا المَسِيحْ، آمَا اللَّهْ بْعَثْنِي قَبْلُو بَاشْ نْحَضَّرْلُو الطْرِيقْ". <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />العْرُوسَة رَاهِي لِلْعْرُوسْ وَحْدُو، آمَا صَاحِبْ العْرُوسْ، يَاقِفْ بَحْذَاهْ ويِتْصَنِّتْ ويِفْرَحْ كِي يِسْمَعْ صُوتُو. وآنَا زَادَا نِفْرَحْ كِيفُو، وتَوَّا فَرْحْتِي كِمْلِتْ. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />عْلَى خَاطِرْ لَازْمُو هُوَّ يْزِيدْ، وآنَا نُنْقُصْ.<verse eid="JHN 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />«الِّي يْجِي مِالفُوقْ، هُوَّ فُوقْ الكُلْ. ولِّي هُوَّ مِالأَرْضْ، هُوَّ تَابَعْ لِلْأَرْضْ ويِتْكَلِّمْ بِكْلَامْ الأَرْضْ. الِّي يْجِي مِالسْمَاء، هُوَّ فُوقْ الكُلْ، <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />ويِشْهِدْ عَلِّي شَافُو وعَلِّي سَمْعُو وحَتَّى حَدْ مَا يِقْبِلْ شْهَادْتُو، <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />ولِّي قْبِلْ شْهَادْتُو، يِشْهِدْ الِّي اللَّهْ صَادِقْ. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />الِّي بَعْثُو اللَّهْ يِتْكَلِّمْ بِكْلَامْ اللَّهْ، عْلَى خَاطِرْ اللَّهْ يَعْطِي الرُّوحْ بْلَاشْ حْسَابْ. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />الآبْ يْحِبْ الإِبْنْ وحَطْ كُلْ شَيْ بِينْ يْدِيهْ. <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />الِّي يَمِّنْ بِالإِبْنْ، عَنْدُو الحَيَاةْ الأَبَدِيَّة. ولِّي مَا يَأَمَّنْشْ بِالإِبْنْ، مَا يْشُوفِشْ الحَيَاةْ، آمَا يُقْعِدْ تَحْتْ غَضَبْ اللَّهْ».<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">يَسُوعْ يْقَابِلْ مْرَا سَامِرِيَّة</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />وَعْرَفْ يَسُوعْ الِّي الفِرِّيسِيِّينْ سَمْعُوا الِّي عْدَدْ تْلَامِذَتُو قَاعِدْ يْزِيدْ أَكْثِرْ مِنْ يُوحَنَّا ولِّي هُوَّ يْعَمِّدْ فِيهُمْ، <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />رَغْمِلِّي مُشْ يَسُوعْ بِيدُو الِّي كَانْ يْعَمِّدْ آمَا تْلَامِذْتُو، <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />وَلَّى خْرَجْ مِنْ مَنْطَقْةْ اليَهُودِيَّة ورْجَعْ لْمَنْطَقْةْ الجَلِيلْ. <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />وكَانْ لَازْمُو يِتْعَدَّى عْلَى مَنْطَقْةْ السَّامْرَة. <verse eid="JHN 4:4" /><verse number="5" style="v" sid="JHN 4:5" />وْصُلْ لِمْدِينَة فِي السَّامْرَة إِسْمْهَا سُوخَارْ، قْرِيبَة مِنْ قَطْعِةْ الأَرْضْ الِّي عْطَاهَا يَعْقُوبْ لْوِلْدُو يُوسِفْ، <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />وِينْ فَمَّة بِيرْ يَعْقُوبْ. تْعِبْ يَسُوعْ مِالمَشِي يَاخِي قْعَدْ بَحْذَا البِيرْ. وكَانْ وَقْتْهَا ظُهْرْ.<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />جَاتْ مْرَا سَامِرِيَّة بَاشْ تْعَبِّي المَاء، قَالِلْهَا يَسُوعْ: «أَعْطِينِي نُشْرُبْ». <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />وكَانُوا تْلَامِذْتُو فِي المْدِينَة يِشْرِيوْ فِي المَاكْلَة. <verse eid="JHN 4:8" /><verse number="9" style="v" sid="JHN 4:9" />قَالِتْلُو المْرَا السَّامْرِيَّة: «إِنْتِ يْهُودِي وآنَا سَامْرِيَّة، كِيفَاشْ تُطْلُبْ مِنِّي بَاشْ نَعْطِيكْ تُشْرُبْ؟» قَالِتْلُو الكْلَامْ هَاذَا عْلَى خَاطِرْ اليْهُودْ مَا كَانُوشْ يِتْعَامْلُوا مْعَ السَّامِرِيِّينْ. <verse eid="JHN 4:9" /><verse number="10" style="v" sid="JHN 4:10" />جَاوِبْهَا يَسُوعْ: «كَانْ جِيتْ تَعْرِفْ آشْ يَعْطِي اللَّهْ، وشْكُونْ الِّي قَلِّكْ "أَعْطِينِي نُشْرُبْ"، رَاكْ إِنْتِ تُطْلِبْ مِنُّو، وهُوَّ يَعْطِيكْ المَاء الحَيْ». <verse eid="JHN 4:10" /><verse number="11" style="v" sid="JHN 4:11" />قَالِتْلُو المْرَا: «يَا سِيدِي، مْنِينْ جَاكْ المَاء الحَيْ، وإِنْتِ مَا عَنْدِكْشْ سْطَلْ، والبِيرْ غَارِقْ؟ <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />يَاخِي إِنْتِ أَعْظَمْ مِنْ بُونَا يَعْقُوبْ الِّي عْطَانَا البِيرْ هَاذَا، وشْرَبْ مِنُّو هُوَّ وأَوْلَادُو والغْنَمْ مْتَاعُو؟» <verse eid="JHN 4:12" /><verse number="13" style="v" sid="JHN 4:13" />جَاوِبْهَا يَسُوعْ: «كُلْ وَاحِدْ يُشْرُبْ مِالمَاء هَاذَا يْزِيدْ يُعْطِشْ مَرَّة أُخْرَى، <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />آمَا الِّي يُشْرُبْ مِالمَاء الِّي نَعْطِيهُولُو آنَا، عُمْرُو مَا عَادْ يُعْطِشْ. المَاء الِّي نَعْطِيهُولُو، يْوَلِّي فِيهْ مِنْ دَاخِلْ عِينْ تْفِيضْ وتَعْطِي الحَيَاةْ الأَبَدِيَّة». <verse eid="JHN 4:14" /><verse number="15" style="v" sid="JHN 4:15" />قَالِتْلُو المْرَا: «يَا سِيدِي، أَعْطِينِي مِالمَاء هَاذَا، بَاشْ مَا عَادِشْ نُعْطِشْ، ومَا عَادِشْ نِرْجَعْ نْعَبِّي المَاء مِنْ هْنَا».<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />قَالِلْهَا: «إِمْشِي عَيِّطْ لْرَاجْلِكْ وإِرْجَعْ». <verse eid="JHN 4:16" /><verse number="17" style="v" sid="JHN 4:17" />جَاوْبِتُّو المْرَا: «مَا عَنْدِيشْ رَاجِلْ». قَالِلْهَا يَسُوعْ: «قُلْتْ الحَقْ وَقْتِلِّي قُلْتْ "مَا عَنْدِيشْ رَاجِلْ"، <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />عْلَى خَاطِرْ عَرِّسْتْ بْخَمْسَة رْجَالْ، والرَّاجِلْ الِّي عَايْشَة مْعَاهْ تَوَّا مُشْ رَاجْلِكْ. كْلَامِكْ صْحِيحْ».<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />قَالِتْلُوا المْرَا: «يَا سِيدِي، يُظْهُرْلِي فِيكْ نَبِيْ! <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />جْدُودْنَا عِبْدُوا اللَّهْ فِي الجْبَلْ هَاذَا، وإِنْتُومَا اليْهُودْ تْقُولُوا الِّي لَازِمْ النَّاسْ يِعْبْدُوهْ فِي أُورْشَلِيمْ». <verse eid="JHN 4:20" /><verse number="21" style="v" sid="JHN 4:21" />جَاوِبْهَا يَسُوعْ: «صَدَّقْنِي يَا مْرَا، بِشْ يْجِي وَقْتْ تِعْبْدُوا فِيهْ الآبْ، لَا فِي الجْبَلْ هَاذَا ولَا فِي أُورْشَلِيمْ. <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />إِنْتُومَا السَّامِرِيِّينْ تِعْبْدُوا فِلِّي مَا تَعْرْفُوهِشْ، وأَحْنَا اليْهُودْ نِعْبْدُوا فِلِّي نَعْرْفُوهْ. عْلَى خَاطِرْ النْجَاةْ تْجِي مِنْ عَنْدْ اليْهُودْ. <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />آمَا بِشْ يْجِي وَقْتْ ورَاهُو تَوَّا جَاء، الِّي فِيهْ النَّاسْ الِّي يِعْبْدُوا بِحْقِيقَة بِشْ يِعْبْدُوا الآبْ بِالرُّوحْ والحَقْ. والآبْ يْلَوِّجْ عْلَى نَاسْ كِيمَا هَاذُومَا. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />اللَّهْ رُوحْ. هَاذَاكَا عْلَاشْ الِّي يِعْبْدُوهْ، لَازِمْهُمْ يِعْبْدُوهْ بِالرُّوحْ وبِالحَقْ». <verse eid="JHN 4:24" /><verse number="25" style="v" sid="JHN 4:25" />قَالِتْلُو المْرَا: «آنَا نَعْرِفْ الِّي المَسِيَّا، الِّي يْقُولُولُو المَسِيحْ، بِشْ يْجِي. ووَقْتِلِّي يْجِي بِشْ يْقُولِلْنَا عْلَى كُلْ شَيْ». <verse eid="JHN 4:25" /><verse number="26" style="v" sid="JHN 4:26" />قَالِلْهَا يَسُوعْ: «آنَا هُوَّ، آنَا الِّي قَاعِدْ نْكَلِّمْ فِيكْ».<verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />وفِي الوَقْتْ هَاذَاكَا، رَجْعُوا تْلَامِذْتُو وتْعَجْبُوا كِي لْقَاوَهْ يَحْكِي مْعَ مْرَا. آمَا حَتَّى حَدْ مِنْهُمْ مَا قَالُّو: «آشْ تْحِبْ مِنْهَا؟» وَلَّا «عْلَاشْ تْكَلِّمْ فِيهَا؟». <verse eid="JHN 4:27" /><verse number="28" style="v" sid="JHN 4:28" />يَاخِي المْرَا خَلَّاتْ قُلِّتْهَا، ورَجْعِتْ لِلْمْدِينَة، وقَالِتْ لِلنَّاسْ: <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />«إِيجَاوْ شُوفُوا رَاجِلْ قَلِّي عَلِّي عْمَلْتُو الكُلْ. زَعْمَة يْكُونِشْ هُوَّ المَسِيحْ؟» <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />وَلَّاوْ خَرْجُوا مِالمْدِينَة ومْشَاوْلُو.<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />وفِي الوَقْتْ هَاذَاكَا، قَالُولُو تْلَامِذْتُو: «يَا مُعَلِّمْ، كُولْ». <verse eid="JHN 4:31" /><verse number="32" style="v" sid="JHN 4:32" />آمَا هُوَّ قَالِلْهُمْ: «آنَا عَنْدِي مَاكْلَة نَاكِلْهَا، إِنْتُومَا مَا تَعْرْفُوهَاشْ». <verse eid="JHN 4:32" /><verse number="33" style="v" sid="JHN 4:33" />بْدَاوْ التْلَامْذَة يِسْأْلُوا فِي بْعَضْهُمْ: «يَاخِي فَمَّة شْكُونْ جَابْلُو مَاكْلَة؟» <verse eid="JHN 4:33" /><verse number="34" style="v" sid="JHN 4:34" />وقَالِلْهُمْ يَسُوعْ: «مَاكِلْتِي هِيَّ إِنِّي نَعْمِلْ آشْ يْحِبْ الِّي بْعَثْنِي، ونْكَمِّلْ خِدْمْتُو. <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />يَاخِي مُشْ تْقُولُوا: "الحْصَادْ يْجِي بَعْدْ أَرْبْعَة شْهُرْ؟" آمَا آنَا نْقُلْكُمْ، حِلُّوا عِينِيكُمْ وشُوفُوا الزَّرْعْ كِيفَاشْ بْيَاضْ وحْضَرْ لِلْحْصَادْ. <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />وبْدَا الِّي يَحْصِدْ يَاخُذْ فِي أُجْرْتُو، ويْلِمْ صَابَة لِلْحَيَاةْ الأَبَدِيَّة، وهَكَّا الِّي يَزْرَعْ ولِّي يَحْصِدْ يِفْرْحُوا مْعَ بْعَضْهُمْ. <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />ويُصْدُقْ المَثَلْ الِّي يْقُولْ: "وَاحِدْ يَزْرَعْ والآخِرْ يَحْصِدْ". <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />وآنَا بْعَثْتْكُمْ تَحْصْدُوا زَرْعْ مَا تْعِبْتُوشْ عْلِيهْ. غِيرْكُمْ تْعِبْ وإِنْتُومَا تِسْتَنْفْعُوا مِنْ تْعَبْهُمْ».<verse eid="JHN 4:38" /></para>
  <para style="s">بَرْشَة سَامِرِيِّينْ يَمْنُوا</para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />وأَمْنُوا بِيهْ بَرْشَة سَامِرِيِّينْ مِالمْدِينَة هَاذِيكَا، عْلَى خَاطِرْ المْرَا شِهْدِتْلُو وقَالِتْ: «قَالِّي عَلِّي عْمَلْتُو الكُلْ». <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />ووَقْتِلِّي جَاوَهْ السَّامِرِيِّينْ، لَحُّوا عْلِيهْ بَاشْ يُقْعُدْ بَحْذَاهُمْ. يَاخِي قْعَدْ عَنْدْهُمْ نْهَارِينْ. <verse eid="JHN 4:40" /><verse number="41" style="v" sid="JHN 4:41" />وزَادُوا كُثْرُوا الِّي أَمْنُوا بِيهْ وَقْتِلِّي سَمْعُوهْ يِتْكَلِّمْ، <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />وقَالُوا لِلْمْرَا: «أَحْنَا تَوَّا نَمْنُوا بِيهْ، مُشْ عْلَى خَاطِرْ كْلَامِكْ، آمَا عْلَى خَاطِرْ أَحْنَا بِيدْنَا سْمَعْنَاهْ، وعْرَفْنَا إِنُّو بِالحَقْ هُوَّ الِّي يْنَجِّي العَالِمْ».<verse eid="JHN 4:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />وبَعْدْ نْهَارِينْ، مْشَى يَسُوعْ لْمَنْطَقْةْ الجَلِيلْ، <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />رَغْمِلِّي هُوَّ بِيدُو قَالْ: «حَتَّى نَبِيْ مَا عَنْدُو قْدَرْ فِي بْلَادُو». <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />وَقْتِلِّي وْصُلْ لِلْجَلِيلْ، رَحْبُوا بِيهْ إِمَّالِيهَا، عْلَى خَاطِرْهُمْ شَافُوا الِّي عْمَلُو الكُلْ، وَقْتِلِّي كَانُوا فِي أُورْشَلِيمْ فِي عِيدْ الفِصْحْ.<verse eid="JHN 4:45" /></para>
  <para style="s">يَسُوعْ يِشْفِي طْفُلْ صْغِيرْ</para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />ومْشَى مَرَّة أُخْرَى لْقَانَا فِي الجَلِيلْ، وِينْ بَدَّلْ المَاء لِشْرَابْ. وكَانْ فَمَّة فِي كَفْرْنَاحُومْ، رَاجِلْ تَابَعْ المَلِكْ، وِلْدُو مْرِيضْ. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />وَقْتِلِّي سْمَعْ الِّي يَسُوعْ جَاء مِاليَهُودِيَّة لِلْجَلِيلْ، مْشَالُو وطْلَبْ مِنُّو بَاشْ يِمْشِي مْعَاهْ ويِشْفِيلُو وِلْدُو، الِّي كَانْ قْرِيبْ يْمُوتْ. <verse eid="JHN 4:47" /><verse number="48" style="v" sid="JHN 4:48" />قَالُّو يَسُوعْ: «إِنْتُومَا مَا تَمْنُوا كَانْ مَا تْشُوفُوا عْجَايِبْ ومُعْجْزَاتْ!». <verse eid="JHN 4:48" /><verse number="49" style="v" sid="JHN 4:49" />قَالُّو الرَّاجِلْ: «يَا سِيدِي، إِيجَا مْعَايَا قْبَلْ مَا وِلْدِي يْمُوتْ». <verse eid="JHN 4:49" /><verse number="50" style="v" sid="JHN 4:50" />قَالُّو يَسُوعْ: «إِمْشِي! رَاهُو وِلْدِكْ حَيْ». صَدِّقْ الرَّاجِلْ الكِلْمَة الِّي قَالْهَالُو يَسُوعْ ومْشَى.<verse eid="JHN 4:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 4:51" />وهُوَّ رَاجِعْ، عُرْضُوهْ الخُدَّامْ مْتَاعُو وبَشْرُوهْ بِلِّي وِلْدُو حَيْ. <verse eid="JHN 4:51" /><verse number="52" style="v" sid="JHN 4:52" />سْإِلْهُمْ: «وَقْتَاشْ بْرَا؟» قَالُولُو: «تْنَحَّاتْ عْلِيهْ السْخَانَة البَارِحْ مْعَ مَاضِي سَاعَة». <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />وفْهِمْ البُو الِّي هَاذَاكَا نَفْسْ الوَقْتْ الِّي قَالُّو فِيهْ يَسُوعْ: «وِلْدِكْ حَيْ»، يَاخِي أَمَّنْ هُوَّ وعَايِلْتُو الكُلْ. <verse eid="JHN 4:53" /><verse number="54" style="v" sid="JHN 4:54" />وهَاذِي المُعْجْزَة الثَّانْيَة الِّي عْمَلْهَا يَسُوعْ، وَقْتِلِّي مْشَى مِاليَهُودِيَّة لِلْجَلِيلْ.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">يَسُوعْ يِشْفِي مَشْلُولْ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />ومْبَعْدْهَا، جَاء عِيدْ مِنْ أَعْيَادْ اليْهُودْ، يَاخِي طْلَعْ يَسُوعْ لْأُورْشَلِيمْ. <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />وفِي المْدِينَة هَاذِيكَا كَانِتْ فَمَّة جَابْيَة، بَحْذَا بَابْ الغْنَمْ، دَايِرْ بِيهَا خَمْسَة أَقْوَاسْ، ويْسَمِّيوْهَا بِالعِبْرِيَّة «بِيتْ حَسْدَا». <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />وكَانُوا جْمَاعَة عِمْيَانْ وعِيَّابْ ومُعَاقِينْ، مَمْدُودِينْ تَحْتْ الأَقْوَاسْ، يِسْتَنَّاوْ حَتَّى المَاء يِتْحَرِّكْ، <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />عْلَى خَاطِرْ كَانْ فَمَّة مَلَاكْ يْجِي سَاعَة سَاعَة ويْحَرِّكْ المَاءْ، ولِّي يَهْبِطْ فِيهْ الأُوِّلْ، يِتْشْفَى مَهْمَا كَانْ مَرْضُو. <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />وكَانْ فَمَّة رَاجِلْ لِيهْ 38 سْنَة مْرِيضْ. <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />وَقْتِلِّي شَافُو يَسُوعْ مَمْدُودْ، عْرَفْ الِّي عَنْدُو مُدَّة طْوِيلَة عَالحَالَة هَاذِيكَا، يَاخِي قَالُّو: «تْحِبِّشْ تَبْرَى؟». <verse eid="JHN 5:6" /><verse number="7" style="v" sid="JHN 5:7" />جَاوْبُو المْرِيضْ: « يَا سِيدِي، مَا عَنْدِيشْ شْكُونْ يَرْمِينِي فِي الجَابْيَة وَقْتِلِّي يِتْحَرِّكْ المَاء. وكُلْ مَا نْحَاوِلْ نَهْبِطْ، غِيرِي يِسْبِقْنِي». <verse eid="JHN 5:7" /><verse number="8" style="v" sid="JHN 5:8" />قَالُّو يَسُوعْ: «قُومْ هِزْ فَرْشِكْ وإِمْشِي». <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />وبِالوَقْتْ، تِشْفَى الرَّاجِلْ، وهَزْ فَرْشُو ومْشَى. وكَانْ نْهَارِتْهَا نْهَارْ السِّبْتْ.<verse eid="JHN 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 5:10" />قَالُوا اليْهُودْ لِلرَّاجِلْ الِّي تِشْفَى: «اليُومْ سِبْتْ. مَا عَنْدِكْشْ الحَقْ تْهِزْ فَرْشِكْ». <verse eid="JHN 5:10" /><verse number="11" style="v" sid="JHN 5:11" />جَاوِبْهُمْ: «الِّي شْفَانِي هُوَّ الِّي قَلِّي: هِزْ فَرْشِكْ وإِمْشِي». <verse eid="JHN 5:11" /><verse number="12" style="v" sid="JHN 5:12" />يَاخِي سِأْلُوهْ: «شْكُونُو الِّي قَلِّكْ هِزْ فَرْشِكْ وإِمْشِي؟». <verse eid="JHN 5:12" /><verse number="13" style="v" sid="JHN 5:13" />والرَّاجِلْ الِّي تِشْفَى مَا كَانِشْ يَعْرِفْ شْكُونْ الِّي شْفَاهْ، عْلَى خَاطِرْ يَسُوعْ بْعِدْ، وضَاعْ عْلِيهْ فِي وِسْطْ النَّاسْ.<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />مْبَعِّدْ، لْقَاهْ يَسُوعْ فِي الهَيْكِلْ وقَالُّو: «هَاكْ بْرِيتْ، مَالَا مَا تِرْجَعْشْ لِلذْنُوبْ، بَاشْ مَا يْصِيرْلِكْشْ مَا أَتْعِسْ». <verse eid="JHN 5:14" /><verse number="15" style="v" sid="JHN 5:15" />مْشَى الرَّاجِلْ وقَالْ لِلْيْهُودْ الِّي يَسُوعْ هُوَّ الِّي شْفَاهْ. <verse eid="JHN 5:15" /><verse number="16" style="v" sid="JHN 5:16" />يَاخِي بْدَاوْ اليْهُودْ يِضْطَهْدُوا فِي يَسُوعْ عْلَى خَاطْرُو عْمَلْ هَاذَا نْهَارْ السِّبْتْ.<verse eid="JHN 5:16" /></para>
  <para style="s">يَسُوعْ عَنْدُو سُلْطَة</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 5:17" />قَالِلْهُمْ يَسُوعْ: «مَزَّالْ بَابَا يِخْدِمْ حَتَّى لْتَوَّا، وآنَا زَادَا قَاعِدْ نِخْدِمْ». <verse eid="JHN 5:17" /><verse number="18" style="v" sid="JHN 5:18" />هَاذَاكَا عْلَاشْ اليْهُودْ شَدُّوا صْحِيحْ يْحِبُّوا يُقْتْلُوهْ، مُشْ عْلَى خَاطْرُو خَالِفْ وْصِيِّةْ السِّبْتْ بَرْكْ، آمَا زَادَا عْلَى خَاطْرُو قَالْ الِّي اللَّهْ بُوهْ، وهَكَّا سَاوَى رُوحُو بِاللَّهْ.<verse eid="JHN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />قَالِلْهُمْ يَسُوعْ: «الحَقْ الحَقْ نْقُلْكُمْ: الإِبْنْ مَا يْنَجِّمْ يَعْمِلْ حَتَّى شَيْ مِنْ رَاسُو، آمَا يَعْمِلْ الِّي يْشُوفْ الآبْ يَعْمِلْ فِيهْ. الِّي يَعْمْلُو الآبْ الكُلْ يَعْمْلُو الإِبْنْ زَادَا. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />عْلَى خَاطِرْ الآبْ يْحِبْ الإِبْنْ، ويْوَرِّيهْ الِّي يَعْمْلُو الكُلْ، وبِشْ يْوَرِّيهْ حَاجَاتْ أَعْظَمْ مِنْ هَاذِي، وإِنْتُومَا بِشْ تِتْعَجْبُوا. <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />وكِيمَا الآبْ يْقَوِّمْ المُوتَى ويِحْيِيهُمْ، الإِبْنْ زَادَا يِحْيِي الِّي يْحِبْ. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />الآبْ مَا يُحْكُمْ عْلَى حَتَّى حَدْ، آمَا عْطَى الحُكْمْ الكُلُّو لِلْإِبْنْ، <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />بَاشْ النَّاسْ الكُلْ يِكْرْمُوا الإِبْنْ، كِيفْ مَا يِكْرْمُوا الآبْ. ولِّي مَا يِكْرِمْشْ الإِبْنْ، مَا يِكْرِمْشْ الآبْ الِّي بَعْثُو.<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />«الحَقْ الحَقْ نْقُلْكُمْ: الِّي يِسْمَعْ كْلَامِي ويْأَمِّنْ بِلِّي بْعَثْنِي عَنْدُو الحَيَاةْ الأَبَدِيَّة، ومَا يِتْعَاقِبْشْ فِي يُومْ الحْسَابْ، عْلَى خَاطِرْ تْعَدَّى مِالمُوتْ لِلْحَيَاةْ. <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />الحَقْ الحَقْ نْقُلْكُمْ: بَاشْ يْجِي وَقْتْ، ورَاهُو تَوَّا جَاء، الِّي فِيهْ المُوتَى يِسْمْعُوا صُوتْ إِبْنْ اللَّهْ، ولِّي يِسْمْعُوهْ يَحْيَاوْ. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />وكِيمَا الآبْ هُوَّ مَصْدَرْ الحَيَاةْ، عْطَى لِلْإِبْنْ بَاشْ يْكُونْ هُوَّ زَادَا مَصْدَرْ الحَيَاةْ، <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />وعْطَاهْ السُّلْطَة بَاشْ يُحْكُمْ عْلَى خَاطْرُو إِبْنْ الإِنْسَانْ. <verse eid="JHN 5:27" /><verse number="28" style="v" sid="JHN 5:28" />مَا تِسْتَغْرْبُوشْ مِنْ هَاذَا، عْلَى خَاطِرْ بِشْ يْجِي وَقْتْ، يِسْمْعُوا فِيهْ صُوتُو الِّي فِي القْبُورَاتْ الكُلْ <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />ويُخْرْجُوا مِنْهَا: العَامْلِينْ الخِيرْ يْقُومُوا لِلْحَيَاةْ، والعَامْلِينْ الشَّرْ يْقُومُوا بَاشْ يِتْحَاسْبُوا. <verse eid="JHN 5:29" /><verse number="30" style="v" sid="JHN 5:30" />مَا انَّجِّمْ نَعْمِلْ حَتَّى شَيْ مِنْ رَاسِي. آنَا نْحَاسِبْ كِيمَا يْقُلِّي الآبْ. وحُكْمِي عَادِلْ عْلَى خَاطِرْنِي مَانِيشْ نَسْعَى بَاشْ نْحَقِّقْ مَشِيئْتِي، آمَا مَشِيئِةْ الِّي بْعَثْنِي.<verse eid="JHN 5:30" /></para>
  <para style="s">الآبْ يِشْهِدْ لْيَسُوعْ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />«كَانْ نِشْهِدْ لْرُوحِي، رَاهِي شْهَادْتِي بَاطْلَة. <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />آمَا فَمَّة شْكُونْ آخِرْ يِشْهِدْلِي، وآنَا نَعْرِفْ الِّي شْهَادْتُو صْحِيحَة. <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" />إِنْتُومَا بْعَثْتُوا نَاسْ لْيُوحَنَّا، وهُوَّ شْهِدْ لِلْحَقْ. <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />آنَا مَا نِحْتَاجِشْ لِشْهَادِةْ بَشَرْ، آمَا نْقُلْكُمْ فِي الكْلَامْ هَاذَا بَاشْ تِنْجَاوْ. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />يُوحَنَّا كَانْ فْنَارْ يِشْعِلْ ويِضْوِي وإِنْتُومَا حَبِّيتُوا تِفْرْحُوا بِالنُّورْ مْتَاعُو شْوَيَّة وَقْتْ. <verse eid="JHN 5:35" /><verse number="36" style="v" sid="JHN 5:36" />آمَا آنَا عَنْدِي شْهَادَة أَعْظَمْ مِنْ شْهَادِةْ يُوحَنَّا: الأَعْمَالْ الِّي كَلَّفْنِي بِيهَا الآبْ، ولِّي قَاعِدْ نَعْمِلْ فِيهَا، هِيَّ تِشْهِدْ الِّي الآبْ بْعَثْنِي، <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />والآبْ الِّي بْعَثْنِي هُوَّ بِيدُو يِشْهِدْلِي. وإِنْتُومَا عْمُرْكُمْ لَا سْمَعْتُوا صُوتُو، ولَا شُفْتُوا وِجْهُو، <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />وكْلَامُو مَا يِثْبِتْشْ فِيكُمْ، عْلَى خَاطِرْكُمْ مَا تْأَمْنُوشْ بِلِّي بَعْثُو. <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />تْثَبْتُوا فِي الكْتُبْ المُقَدْسَة، مَاشِي فِي بَالْكُمْ بِشْ تَلْقَاوْ فِيهَا الحَيَاةْ الأَبَدِيَّة، والكْتُبْ هَاذِي بِيدْهَا تِشْهِدْلِي، <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />آمَا إِنْتُومَا، مَا تْحِبُّوشْ تْجِيوْنِي بَاشْ تَاخْذُوا الحَيَاةْ.<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />«آنَا مَا نِحْتَاجِشْ لْمَجْدْ مِنْ عَنْدْ النَّاسْ، <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />آمَا آنَا نَعْرِفْكُمْ، ونَعْرِفْ الِّي مْحَبِّةْ اللَّهْ مَاهِيشْ فِي قْلُوبْكُمْ. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />آنَا جِيتْ بْإِسْمْ بَابَا، ومَا قْبِلْتُونِيشْ. وكَانْ وَاحِدْ آخَرْ يْجِيكُمْ بْإِسْمْ رُوحُو، تِقْبْلُوهْ. <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />وكِيفَاشْ تْنَجْمُوا تَمْنُوا وإِنْتُومَا تِسْتَنَّاوْ بَاشْ تَاخْذُوا المَجْدْ مِنْ عَنْدْ بْعَضْكُمْ، ومَا تُطْلْبُوشْ المَجْدْ الِّي يَعْطِيهْ اللَّهْ وَحْدُو؟ <verse eid="JHN 5:44" /><verse number="45" style="v" sid="JHN 5:45" />مَا يِمْشِيشْ فِي بَالْكُمْ الِّي آنَا نِشْكِي بِيكُمْ لِلْآبْ. الِّي يِشْكِي بِيكُمْ هُوَّ مُوسَى الِّي حَاطِّينْ فِيهْ رْجَاكُمْ. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />وكَانْ جِيتُوا صَدَّقْتُوا مُوسَى رَاكُمْ صَدَّقْتُونِي، عْلَى خَاطْرُو هُوَّ كْتِبْ عْلِيَّا. <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />وإِذَا كَانْ مَا تْصَدْقُوشْ الِّي كِتْبُو عْلِيَّا، مَالَا كِيفَاشْ بِشْ تْصَدْقُوا كْلَامِي؟».<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">يَسُوعْ يْوَكِّلْ 5 000 رَاجِلْ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />وبَعْدْهَا شَقْ يَسُوعْ بُحَيْرِةْ الجَلِيلْ، الِّي يْسَمِّيوْهَا بُحَيْرِةْ طَبَرِيَّة. <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />وتَبْعُوهْ بَرْشَة نَاسْ، عْلَى خَاطِرْهُمْ شَافُوا مُعْجْزَاتُو كِي شْفَى المُرْضَى. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />يَاخِي طْلَعْ يَسُوعْ لِلجْبَلْ مْعَ تْلَامِذْتُو وقَعْدُوا. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />ووَقْتْهَا قْرُبْ عِيدْ الفِصْحْ مْتَاعْ اليْهُودْ.<verse eid="JHN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 6:5" />هَزْ يَسُوعْ عِينِيهْ وشَافْ بَرْشَة نَاسْ جَايِينُوا، يَاخِي قَالْ لْفِيلِۑُّسْ: «مْنِينْ نِشْرِيوْلْهُمْ خُبْزْ بَاشْ يَاكْلُوا؟». <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />قَالْ الكْلَامْ هَاذَا بَاشْ يْجَرَّبْ فِيلِۑُّسْ، آمَا هُوَّ كَانْ يَعْرِفْ رُوحُو آشْ بِشْ يَعْمِلْ. <verse eid="JHN 6:6" /><verse number="7" style="v" sid="JHN 6:7" />جَاوْبُو فِيلِۑُّسْ: «حَتَّى كَانْ نِشْرِيوْ خُبْزْ بِفْلُوسْ ثْمَنْيَة شْهُورْ خِدْمَة، هَاذَا مَا يِكْفِيشْ بَاشْ كُلْ وَاحِدْ مِنْهُمْ يَاخِذْ ڨِدْمَة صْغِيرَة!» <verse eid="JHN 6:7" /><verse number="8" style="v" sid="JHN 6:8" />قَالُّو أَنْدَرَاوُسْ، خُو سِمْعَانْ بُطْرُسْ، الِّي هُوَّ وَاحِدْ مِنْ تْلَامِذْتُو: <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />«هَاوْ فَمَّة وْلَيِّدْ عَنْدُو خَمْسَة خُبْزَاتْ شْعِيرْ وحُوتِّينْ: آمَا آشْ يْنَجْمُوا يَعْمْلُوا لِلنَّاسْ هَاذُومَا الكُلْ؟».<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />وكَانْ فَمَّة بَرْشَة حْشِيشْ فِي البُقْعَة هَاذِيكَا، يَاخِي قَالْ يَسُوعْ: «قَعّْدُوا النَّاسْ!»، وَلَّاوْ قَعْدُوا، وكَانُوا وقْتْهَا 5 000 رَاجِلْ. <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />خْذَا يَسُوعْ الخُبْزَاتْ وشْكَرْ اللَّهْ، وعْطَى لِلْمَوجُودِينْ الكُلْ قَدْ مَا حَبُّوا. وعْمَلْ نَفْسْ الشَّيْ بِالحُوتِّينْ. <verse eid="JHN 6:11" /><verse number="12" style="v" sid="JHN 6:12" />ووَقْتِلِّي شَبْعُوا، قَالْ لِتْلَامِذْتُو: «لِمُّوا الِّي فْضُلْ الكُلْ بَاشْ مَا يْضِيعْ مِنُّو حَتَّى شَيْ». <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />وَلَّاوْ لَمُّوهْ، وعَبَّاوْ أَثْنَاشِنْ قُفَّة بِالخُبْزْ الِّي فْضُلْ بَعْدْمَا كْلَاوْ النَّاسْ مِالخَمْسَة خُبْزَاتْ شْعِيرْ. <verse eid="JHN 6:13" /><verse number="14" style="v" sid="JHN 6:14" />ووَقْتِلِّي شَافُوا النَّاسْ المُعْجْزَة الِّي عْمَلْهَا يَسُوعْ قَالُوا: «بِالحَقْ، هَاذَا هُوَّ النَّبِيْ الِّي جَايْ لِلْعَالِمْ!» <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />وعْرَفْ يَسُوعْ الِّي هُومَا يْحِبُّوا يَخْطْفُوهْ ويْنَصْبُوهْ مَلِكْ، يَاخِي بْعِدْ عْلِيهُمْ ورْجَعْ وَحْدُو لِلجْبَلْ.<verse eid="JHN 6:15" /></para>
  <para style="s">يَسُوعْ يِمْشِي فُوقْ المَاء</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />ومْعَ المُغْرُبْ، هَبْطُوا تْلَامِذْتُو لِلْبُحَيْرَة، <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />ورِكْبُوا فِي فْلُوكَة، قَاصْدِينْ مْدِينِةْ كَفْرْنَاحُومْ فِي الشِّيرَة الأُخْرَى مْتَاعْ البُحَيْرَة. وظْلَامِتْ الدِّنْيَا ويَسُوعْ مَزَّالْ مَا خْلَطْشْ عْلِيهُمْ. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />وهَبِّتْ رِيحْ قْوِيَّة، هَيْجِتْ البُحَيْرَة. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />وبَعْدْمَا بِعْدُوا فِي البُحَيْرَة خَمْسَة وَلَّا سِتَّة كِيلُومِيتْرَاتْ، شَافُوا يَسُوعْ يُقْرُبْ لِلْفْلُوكَة وهُوَّ مَاشِي فُوقْ المَاء، يَاخِي خَافُوا. <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />آمَا هُوَّ قَالِلْهُمْ: «آنَا هُوَّ، مَا تْخَافُوشْ!». <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />وحَبُّوا يْطَلْعُوهْ مْعَاهُمْ فِي الفْلُوكَة، آمَا بِالوَقْتْ وِصْلِتْ الفْلُوكَة لِلْبْلَاصَة الِّي كَانُوا مَاشِينْ لِيهَا.<verse eid="JHN 6:21" /></para>
  <para style="s">يَسُوعْ خُبْزْ الحَيَاةْ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />ومِنْ غُدْوَة، النَّاسْ الِّي قَعْدُوا فِي الشِّيرَة الأُخْرَى مْتَاعْ البُحَيْرَة، تْذَكْرُوا الِّي هُومَا شَافُوا فْلُوكَة وَحْدَة، ولِّي يَسُوعْ مَا طْلَعْشْ فِيهَا مْعَ تْلَامِذْتُو، ولِّي تْلَامِذْتُو مْشَاوْ وَحَّدْهُمْ. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />وجَاوْ فْلَايِكْ أُخْرِينْ مِنْ طَبَرِيَّة، لِلشَّطْ الِّي قْرِيبْ مِالبْلَاصَة الِّي كْلَاوْ فِيهَا الخُبْزْ، بَعْدْمَا الرَّبْ يَسُوعْ شْكَرْ اللَّهْ عْلِيهْ. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />وَقْتِلِّي شَافُوا النَّاسْ الِّي لَا يَسُوعْ ولَا تْلَامِذْتُو مَوْجُودِينْ غَادِي، وَلَّاوْ رِكْبُوا فِي الفْلَايِكْ ومْشَاوْ لْكَفْرْنَاحُومْ يْلَوْجُوا عْلِيهْ. <verse eid="JHN 6:24" /><verse number="25" style="v" sid="JHN 6:25" />وكِي لْقَاوِهْ فِي الشِّيرَة الأُخْرَى مْتَاعْ البُحَيْرَة قَالُولُو: «يَا مُعَلِّمْ، وَقْتَاشْ وْصِلْتْ لَهْنَا؟». <verse eid="JHN 6:25" /><verse number="26" style="v" sid="JHN 6:26" />جَاوِبْهُمْ يَسُوعْ: «الحَقْ الحَقْ نْقُلْكُمْ: إِنْتُومَا تْلَوْجُوا عْلِيَّا، مُشْ عْلَى خَاطِرْكُمْ شُفْتُوا مُعْجْزَاتْ، آمَا عْلَى خَاطِرْكُمْ كْلِيتُوا مِالخُبْزْ وشْبَعْتُوا. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />إِسْعَاوْ وْرَاء المَاكْلَة الِّي تْدُومْ لِلْحَيَاةْ الأَبَدِيَّة، مُشْ وْرَاء المَاكْلَة الِّي تِفْنَى. المَاكْلَة هَاذِي يَعْطِيهَالْكُمْ إِبْنْ الإِنْسَانْ الِّي خِتْمُو اللَّهْ الآبْ».<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />قَالُولُو: «شْنُوَّة الِّي يْحِبْنَا اللَّهْ نَعْمْلُوهْ؟». <verse eid="JHN 6:28" /><verse number="29" style="v" sid="JHN 6:29" />جَاوِبْهُمْ يَسُوعْ: «الِّي يُطْلْبُو مِنْكُمْ اللَّهْ هُوَّ إِنْكُمْ تَمْنُوا بِلِّي بَعْثُو». <verse eid="JHN 6:29" /><verse number="30" style="v" sid="JHN 6:30" />قَالُولُو: «شْنِيَّة المُعْجْزَة الِّي تَعْمِلْهَا بَاشْ نْشُوفُوهَا ونَمْنُوا بِيكْ؟ <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />جْدُودْنَا كْلَاوْ المَنْ فِي الصَّحْرَاء، كِيمَا تْقُولْ الكْتُبْ المُقَدْسَة: "عْطَاهُمْ خُبْزْ مِالسْمَاء بَاشْ يَاكْلُوا"». <verse eid="JHN 6:31" /><verse number="32" style="v" sid="JHN 6:32" />يَاخِي قَالِلْهُمْ يَسُوعْ: «الحَقْ الحَقْ نْقُلْكُمْ: مُشْ مُوسَى الِّي عْطَاكُمْ الخُبْزْ مِالسْمَاء، آمَا بَابَا هُوَّ الِّي يَعْطِيكُمْ الخُبْزْ الحَقِيقِي مِالسْمَاء. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />عْلَى خَاطِرْ خُبْزْ اللَّهْ هُوَّ الِّي يَهْبِطْ مِالسْمَاء ويَعْطِي الحَيَاةْ لِلنَّاسْ».<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />قَالُولُو: «يَا سِيدْنَا، دِيمَا أَعْطِينَا مِالخُبْزْ هَاذَا». <verse eid="JHN 6:34" /><verse number="35" style="v" sid="JHN 6:35" />قَالِلْهُمْ يَسُوعْ: «آنَا هُوَّ خُبْزْ الحَيَاةْ. الِّي يْجِينِي عُمْرُو مَا يْجُوعْ، ولِّي يَمِّنْ بِيَّا عُمْرُو مَا يُعْطِشْ. <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />آمَا آنَا قُلْتِلْكُمْ: إِنْتُومَا شُفْتُونِي، آمَا مَا تْأَمْنُوشْ بِيَّا. <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />الِّي يَعْطِيهُمْلِي الآبْ الكُلْهُمْ يْجِيوْنِي، ولِّي يْجِينِي عُمْرِي مَا نْطَرْدُو. <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />رَانِي مَا هْبَطِّشْ مِالسْمَاء بَاشْ نَعْمِلْ الِّي نْحِبْ عْلِيهْ آنَا، آمَا بَاشْ نَعْمِلْ الِّي يْحِبْ عْلِيهْ الِّي بْعَثْنِي. <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />ولِّي بْعَثْنِي، يْحِبْنِي مَا نْضَيَّعْ حَتَّى وَاحِدْ مِلِّي عْطَاهُمْلِي، آمَا نْقَيِّمْهُمْ مِالمُوتْ فِي نْهَارْ الحْسَابْ. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />وهَاذَا آشْ يْحِبْ بَابَا: كُلْ وَاحِدْ يْشُوفْ الإِبْنْ ويْأَمِّنْ بِيهْ يَاخُو الحَيَاةْ الأَبَدِيَّة. وآنَا نْقَيْمُو مِالمُوتْ فِي نْهَارْ الحْسَابْ».<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />وتْشَكَّاوْ اليْهُودْ عْلَى يَسُوعْ عْلَى خَاطْرُو قَالْ: «آنَا هُوَّ الخُبْزْ الِّي هْبَطْ مِالسْمَاء». <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />وقَالُوا: «يَاخِي مُشْ هَاذَا يَسُوعْ وِلْدْ يُوسِفْ؟ أَحْنَا نَعْرْفُوا بُوهْ وأُمُّو، مَالَا كِيفَاشْ يْقُولْ الِّي هُوَّ هْبَطْ مِالسْمَاء؟». <verse eid="JHN 6:42" /><verse number="43" style="v" sid="JHN 6:43" />جَاوِبْهُمْ يَسُوعْ: «مَا تِتْشَكَّاوِشْ بِينْ بْعَضْكُمْ. <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />حَتَّى حَدْ مَا يْنَجِّمْ يْجِينِي إِلَّا إِذَا كَانْ الآبْ الِّي بْعَثْنِي يِجْبْدُو، وآنَا نْقَوْمُو مِالمُوتْ فِي نْهَارْ الحْسَابْ. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />مَكْتُوبْ فِي كْتُبْ الأَنْبِيَاءْ: "النَّاسْ الكُلْ بِشْ يِتْعَلْمُوا مِنْ اللَّهْ". وكُلْ الِّي يِسْمَعْ الآبْ ويِتْعَلِّمْ مِنُّو، يْجِينِي. <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />حَتَّى حَدْ مَا شَافْ الآبْ كَانْ الِّي جَاء مِنْ عَنْدْ اللَّهْ: هَاذَاكَا الوَحِيدْ الِّي شَافْ الآبْ. <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />الحَقْ الحَقْ نْقُلْكُمْ: الِّي يَمِّنْ بِيَّا، عَنْدُو الحَيَاةْ الأَبَدِيَّة. <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />آنَا هُوَّ خُبْزْ الحَيَاةْ. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />جْدُودْكُمْ كْلَاوْ المَنْ فِي الصَّحْرَاء، ورَغْمْ هَاذَاكَا مَاتُوا، <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />آمَا الِّي يَاكِلْ الخُبْزْ الِّي هْبَطْ مِالسْمَاء، مَا يْمُوتِشْ. <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />آنَا هُوَّ الخُبْزْ الحَيْ الِّي هْبَطْ مِالسْمَاء. الِّي يَاكِلْ مِالخُبْزْ هَاذَا يَحْيَا لِلْأَبَدْ. والخُبْزْ هَاذَا هُوَّ بْدَنِي، الِّي نَعْطِيهْ بَاشْ النَّاسْ يَحْيَاوْ».<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />وتْعَارْكُوا اليْهُودْ بِينْ بْعَضْهُمْ وقَالُوا: «كِيفَاشْ يْنَجِّمْ الرَّاجِلْ هَاذَا يَعْطِينَا بْدْنُو بَاشْ نَاكْلُوهْ؟» <verse eid="JHN 6:52" /><verse number="53" style="v" sid="JHN 6:53" />يَاخِي جَاوِبْهُمْ يَسُوعْ: «الحَقْ الحَقْ نْقُلْكُمْ: إِذَا مَا تَاكْلُوشْ بْدَنْ إِبْنْ الإِنْسَانْ ومَا تُشْرْبُوشْ دَمُّو، مُشْ بَاشْ تْكُونْ فِيكُمْ الحَيَاةْ. <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />الِّي يَاكِلْ بَدْنِي ويُشْرُبْ دَمِّي عَنْدُو الحَيَاةْ الأَبَدِيَّة، وآنَا نْقَوْمُو مِالمُوتْ فِي نْهَارْ الحْسَابْ. <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />عْلَى خَاطِرْ بَدْنِي هُوَّ المَاكْلَة الحَقِيقِيَّة، ودَمِّي هُوَّ الشْرَابْ الحَقِيقِي. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />الِّي يَاكِلْ مِنْ بَدْنِي ويُشْرُبْ مِنْ دَمِّي، يِثْبِتْ فِيَّا، وآنَا نِثْبِتْ فِيهْ. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />وكِيمَا الآبْ الِّي هُوَّ حَيْ بْعَثْنِي وآنَا نَحْيَا بِيهْ، الِّي يَاكِلْنِي زَادَا يَحْيَا بِيَّا. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />هَاذَا هُوَّ الخُبْزْ الِّي هْبَطْ مِالسْمَاء، ورَاهُو مُشْ كِيفْ المَنْ الِّي كْلَاوَهْ جْدُودْكُمْ ومَاتُوا. الِّي يَاكِلْ مِالخُبْزْ هَاذَا يَحْيَا لِلْأَبَدْ». <verse eid="JHN 6:58" /><verse number="59" style="v" sid="JHN 6:59" />قَالْ يَسُوعْ الكْلَامْ هَاذَا وَقْتِلِّي كَانْ يْعَلِّمْ فِي مَعْبِدْ اليْهُودْ فِي كَفْرْنَاحُومْ.<verse eid="JHN 6:59" /></para>
  <para style="s">كْلَامْ الحَيَاةْ الأَبَدِيَّة</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />وَقْتِلِّي سَمْعُوهْ، بَرْشَة مِنْ تْلَامِذْتُو قَالُوا: «مَا اصْعْبُو الكْلَامْ هَاذَا، شْكُونْ يْنَجِّمْ يِقْبْلُو؟». <verse eid="JHN 6:60" /><verse number="61" style="v" sid="JHN 6:61" />وعْرَفْ يَسُوعْ فِي قَلْبُو الِّي تْلَامِذْتُو يِتْشَكَّاوْ، وَلَّى سْإِلْهُمْ: «يَاخِي صْدَمْكُمْ الكْلَامْ هَاذَا؟ <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />مَالَا آشْ بِشْ تَعْمْلُوا كَانْ تْشُوفُوا إِبْنْ الإِنْسَانْ طَالِعْ لْفِينْ كَانْ قْبَلْ؟ <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />الرُّوحْ هُوَّ الِّي يَعْطِي الحَيَاةْ، آمَا الإِنْسَانْ وَحْدُو مَا يِنْفَعْ لْحَتَّى شَيْ. والكْلَامْ الِّي قُلْتْهُولْكُمْ رَاهُو رُوحْ وحَيَاةْ. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />آمَا فِيكُمْ الِّي مَا يْأَمْنُوشْ». قَالْ يَسُوعْ هَاذَا عْلَى خَاطْرُو كَانْ يَعْرِفْ مِالأُوِّلْ شْكُونْهُمْ الِّي مَا يْأَمْنُوشْ بِيهْ، وشْكُونُو الِّي بِشْ يْخُونُو. <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />وقَالْ: «هَاذَاكَا عْلَاشْ قُلْتِلْكُمْ: مَا يْنَجِّمْ حَتَّى حَدْ يْجِينِي إِلَّا إِذَا كَانْ الآبْ خَلَّاهْ يْجِينِي».<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />مِنْ وَقْتْهَا، بَرْشَة مِنْ تْلَامِذْتُو خَلَّاوَهْ وبَطْلُوا مَا عَادِشْ يْتَبْعُوا فِيهْ. <verse eid="JHN 6:66" /><verse number="67" style="v" sid="JHN 6:67" />يَاخِي دَارْ لِلتْلَامْذَة الأَثْنَاشْ وقَالِلْهُمْ: «إِنْتُومَا زَادَا تْحِبُّوا تِمْشِيوْ كِيفْهُمْ؟». <verse eid="JHN 6:67" /><verse number="68" style="v" sid="JHN 6:68" />جَاوْبُو سِمْعَانْ بُطْرُسْ: «يَا رَبْ، لِشْكُونْ بِشْ نِمْشِيوْ؟ إِنْتِ الِّي عَنْدِكْ كْلَامْ الحَيَاةْ الأَبَدِيَّة، <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />وأَحْنَا أَمَّنَّا وعْرَفْنَا الِّي إِنْتِ القُدُّوسْ الِّي بَعْثُو اللَّهْ». <verse eid="JHN 6:69" /><verse number="70" style="v" sid="JHN 6:70" />جَاوِبْهُمْ يَسُوعْ: «مُشْ آنَا الِّي خْتَرْتْكُمْ إِنْتُومَا الأَثْنَاشْ؟ ومْعَ هَاذَا وَاحِدْ مِنْكُمْ شِيطَانْ!» <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />وِقْصَدْ بِكْلَامُو هَاذَا، يَهُوذَا وِلْدْ سِمْعَانْ الإِسْخَرْيُوطِي، الِّي بِشْ يْخُونُو، رَغْمِلِّي هُوَّ وَاحِدْ مِنْ الأَثْنَاشْ.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">يَسُوعْ وخْوَاتُو</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />ومْبَعِّدْ هَاذَاكَا بْدَا يَسُوعْ يْدُورْ فِي الجَلِيلْ، ومَا حَبِّشْ يِمْشِي لْمَنْطَقْةْ اليَهُودِيَّة عْلَى خَاطِرْ اليْهُودْ كَانُوا يْحِبُّوا يُقْتْلُوهْ. <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />ووَقْتِلِّي قْرُبْ عِيدْ الخْيَامْ اليْهُودِي، <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />قَالُولُو خْوَاتُو: «أُخْرُجْ مِالمَنْطْقَة هَاذِي وإِمْشِي لِلْيَهُودِيَّة، بَاشْ تْلَامِذْتِكْ زَادَا يْشُوفُوا أَعْمَالِكْ، <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />رَاهُو الِّي يْحِبْ يِتْشْهَرْ مَا يِلْزْمُوشْ يِخْدِمْ فِي السِّرْ. مَادَامِكْ تَعْمِلْ فِي الأَعْمَالَ هَاذِي، ظَهِّرْ رُوحِكْ لِلنَّاسْ». <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />قَالُوا الكْلَامْ هَاذَا عْلَى خَاطِرْ حَتَّى خْوَاتُو بِيدْهُمْ مَا كَانُوشْ يَمْنُوا بِيهْ.<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />يَاخِي قَالِلْهُمْ يَسُوعْ: «وَقْتِي مَزَّالْ مَا جَاشْ، آمَا إِنْتُومَا الوَقْتْ دِيمَا مُنَاسِبْ لِيكُمْ. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />العَالِمْ مَا يْنَجِّمْشْ يَكْرَهْكُمْ إِنْتُومَا، آمَا يَكْرَهْنِي آنَا عْلَى خَاطِرْنِي نِشْهِدْ عْلِيهْ الِّي أَعْمَالُو شِرِّيرَة. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />إِمْشِيوْ إِنْتُومَا لِلْعِيدْ، آمَا آنَا مَانِيشْ مَاشِي تَوَّا لِلْعِيدْ هَاذَا عْلَى خَاطِرْ وَقْتِي مَزَّالْ مَا جَاشْ». <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />قَالِلْهُمْ الكْلَامْ هَاذَا وقْعَدْ فِي الجَلِيلْ.<verse eid="JHN 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />آمَا بَعْدْمَا مْشَاوْ خْوَاتُو لِلْعِيدْ، مْشَى هُوَّ زَادَا، آمَا فِي السِّرْ مِنْ غِيرْ مَا يْظَهِّرْ رُوحُو. <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />وكَانُوا اليْهُودْ يْلَوْجُوا عْلِيهْ فِي العِيدْ ويِسْأْلُوا: «وِينُو هَاكَا الرَّاجِلْ؟» <verse eid="JHN 7:11" /><verse number="12" style="v" sid="JHN 7:12" />وكَانُوا النَّاسْ يِوَشْوْشُوا بِينَاتْ بْعَضْهُمْ عْلِيهْ، فَمَّة شْكُونْ قَالْ: «رَاهُو رَاجِلْ صَالَحْ». وفَمَّة شْكُونْ قَالْ: «لَا، رَاهُو يْغَلِّطْ فِي النَّاسْ». <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />آمَا حَتَّى حَدْ مَا حْكَى عْلِيهْ جْهَارْ، عْلَى خَاطِرْ كَانُوا خَايْفِينْ مِنْ قَادِةْ اليْهُودْ.<verse eid="JHN 7:13" /></para>
  <para style="s">يَسُوعْ يْعَلِّمْ فِي الهَيْكِلْ</para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />وفِي وِسْطْ أَيَّامَاتْ العِيدْ، طْلَعْ يَسُوعْ لِلْهَيْكِلْ وبْدَا يْعَلِّمْ. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />يَاخِي إِتْعَجْبُوا قَادِةْ اليْهُودْ وقَالُوا: «كِيفَاشْ هَاذَا يَعْرِفْ الكْتُبْ المُقَدْسَة بِالڨْدَا، وهُوَّ مَا تَعَلَّمْهُمْشْ؟» <verse eid="JHN 7:15" /><verse number="16" style="v" sid="JHN 7:16" />جَاوِبْهُمْ يَسُوعْ: «الِّي نْعَلِّمْ فِيهْ مُشْ مِنْ عَنْدِي آمَا مِنْ عَنْدْ الِّي بْعَثْنِي. <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />كَانْ وَاحِدْ يْحِبْ يَعْمِلْ مَشِيئِةْ اللَّهْ، تَوْ يَعْرِفْ كَانْ تَعْلِيمِي هَاذَا مِنْ عَنْدْ اللَّهْ وَلَّا مِنْ عَنْدِي آنَا. <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />الِّي يْقُولْ كْلَامْ مِنْ عَنْدُو رَاهُو يُطْلُبْ المَجْدْ لْرُوحُو، آمَا الِّي يُطْلُبْ المَجْدْ لِلِّي بَعْثُو، رَاهُو صَادِقْ ومَا فِيهْ حَتَّى غَشَّة. <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />يَاخِي مُشْ مُوسَى عْطَاكُمْ الشَّرِيعَة؟ آمَا حَتَّى وَاحِدْ مِنْكُمْ مَاهُو يْطَبَّقْ فِيهَا! مَالَا عْلَاشْ تْحِبُّوا تُقْتْلُونِي؟». <verse eid="JHN 7:19" /><verse number="20" style="v" sid="JHN 7:20" />جَاوْبُوهْ النَّاسْ: «إِنْتِ سَاكْنِكْ شِيطَانْ، شْكُونُو الِّي يْحِبْ يُقْتْلِكْ؟» <verse eid="JHN 7:20" /><verse number="21" style="v" sid="JHN 7:21" />جَاوِبْهُمْ يَسُوعْ: «آنَا مَا عْمَلْتْ كَانْ حَاجَة وَحْدَة نْهَارْ السِّبْتْ، وإِنْتُومَا الكُلْكُمْ إِسْتَغْرَبْتُوا. <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />والطْهُورْ مُشْ مُوسَى الِّي جَابُو، كَانْ عَنْدْ الجْدُودْ مِنْ قْبَلْ. آمَا مُوسَى وَصَّاكُمْ بِيهْ، هَاذَاكَا عْلَاشْ إِنْتُومَا اطَّهْرُوا العْبَادْ حَتَّى لَوْ كَانْ نْهَارْ السِّبْتْ. <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />إِذَا كَانْ إِنْتُومَا اطَّهْرُوا النَّاسْ نْهَارْ السِّبْتْ بَاشْ مَا تْخَالْفُوشْ شَرِيعِةْ مُوسَى، مَالَا عْلَاشْ تِتْغَشْشُوا عْلِيَّا عْلَى خَاطِرْنِي شْفِيتْ إِنْسَانْ بْكُلُّو نْهَارْ السِّبْتْ؟ <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />مَا تُحْكْمُوشْ عَالظَّاهِرْ، آمَا أُحْكْمُوا بِالعَدْلْ».<verse eid="JHN 7:24" /></para>
  <para style="s">يَسُوعْ هُوَّ المَسِيحْ</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />وَقْتْهَا فَمَّة جْمَاعَة مِنْ أُورْشَلِيمْ قَالُوا: «يَاخِي مُشْ هَاذَا الِّي يْحِبُّوا يُقْتْلُوهْ؟ <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />هَاوْ يِتْكَلِّمْ جْهَارْ ومَا قَالُولُو حَتَّى شَيْ. يَاخِي القَادَة إِقْتَنْعُوا الِّي هُوَّ المَسِيحْ بِالحَقْ؟ <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />وَقْتِلِّي يْجِي المَسِيحْ، حَدْ مَا بِشْ يَعْرِفْ عْلِيهْ مْنِينْ جَاء، آمَا هَاذَا أَحْنَا نَعْرْفُوهْ مْنِينْ». <verse eid="JHN 7:27" /><verse number="28" style="v" sid="JHN 7:28" />يَاخِي قَالْ يَسُوعْ عْلَى طُولْ صُوتُو وهُوَّ يْعَلِّمْ فِي الهَيْكِلْ: «إِنْتُومَا تَعْرْفُونِي، وتَعْرْفُوا آنَا مْنِينْ. آنَا مَا جِيتِشْ مِنْ رُوحِي، ولِّي بْعَثْنِي رَاهُو صَادِقْ، وإِنْتُومَا مَا تَعْرْفُوهِشْ. <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />آمَا آنَا رَانِي نَعْرْفُو، عْلَى خَاطِرْنِي مِنُّو، وهُوَّ الِّي بْعَثْنِي». <verse eid="JHN 7:29" /><verse number="30" style="v" sid="JHN 7:30" />وَقْتْهَا حَبُّوا يْشِدُّوهْ، آمَا حَتَّى حَدْ مَا نَجِّمْ يْحُطْ يِدُّو عْلِيهْ، عْلَى خَاطِرْ سَاعْتُو مَزَّالِتْ مَا جَاتِشْ. <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />آمَا بَرْشَة نَاسْ مِلِّي كَانُوا حَاضْرِينْ أَمْنُوا بِيهْ وقَالُوا: «زَعْمَة وَقْتِلِّي يْجِي المَسِيحْ بَاشْ يَعْمِلْ مُعْجْزَاتْ أَكْثِرْ مِلِّي عْمَلْهُمْ الرَّاجِلْ هَاذَا؟».<verse eid="JHN 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />وسَمْعُوا الفِرِّيسِيِّينْ آشْ كَانُوا النَّاسْ يْوَشْوْشُو عْلِيهْ بِينْ بْعَضْهُمْ. وَلَّاوْ هُومَا وكْبَارْ الكَهَنَة بَعْثُوا حُرَّاسْ بَاشْ يْشِدُّوهْ. <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />وقَالْ يَسُوعْ: «بِشْ نْزِيدْ نُقْعُدْ مْعَاكُمْ مُدَّة قْصِيرَة، ومْبَعِّدْ نِرْجَعْ لِلِّي بْعَثْنِي. <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />بَاشْ تْلَوْجُوا عْلِيَّا ومَا تَلْقَاوْنِيشْ، والبْلَاصَة الِّي بِشْ نْكُوْنْ فِيهَا، مَا تْنَجْمُوشْ تِمْشِيوْلْهَا». <verse eid="JHN 7:34" /><verse number="35" style="v" sid="JHN 7:35" />قَالُوا اليْهُودْ بِينْ بْعَضْهُمْ: «يَاخِي وِينْ نَاوِي يِمْشِي حَتَّى مَا نَلْقَاوْهِشْ؟ زَعْمَة بَاشْ يِمْشِي لِلْمُدُنْ اليُونَانِيَّة المِتْفَرْقِينْ فِيهَا اليْهُودْ، ويْعَلِّمْ اليُونَانِيِّينْ؟ <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />آشْ يُقْصُدْ كِي قَالْ: "بِشْ تْلَوْجُوا عْلِيَّا ومَا تَلْقَاوْنِيشْ، والبْلَاصَة الِّي بَاشْ نْكُوْنْ فِيهَا، مَا تْنَجْمُوشْ تِمْشِيوْلْهَا"؟».<verse eid="JHN 7:36" /></para>
  <para style="s">وِدْيَانْ مَاء حَيْ</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />وفِي آخِرْ نْهَارْ فِي العِيدْ، ولِّي هُوَّ أَهَمْ نْهَارْ، وْقِفْ يَسُوعْ وقَالْ بْصُوتْ عَالِي: «كَانْ وَاحِدْ عْطُشْ، خَلِّيهْ يْجِينِي ويُشْرُبْ. <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />ولِّي يَمِّنْ بِيَّا، كِيمَا قَالِتْ الكْتُبْ المُقَدْسَة: "تِجْرِي مِنُّو وِدْيَانْ مَاء حَيْ"». <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />وقَالْ هَاذَا عَالرُّوحْ الِّي المُؤْمْنِينْ بِيهْ بِشْ يِقْبْلُوهْ، ووَقْتْهَا الرُّوحْ القُدُسْ مَزَّالْ مَا تِعْطَاشْ، عْلَى خَاطِرْ يَسُوعْ مَزَّالْ مَا تْمَجِّدْشْ.<verse eid="JHN 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />وفَمَّة بَرْشَة مِلِّي كَانُوا حَاضْرِينْ سَمْعُوا الكْلَامْ هَاذَا قَالُوا: «بِالحَقْ هَاذَا هُوَّ النَّبِيْ». <verse eid="JHN 7:40" /><verse number="41" style="v" sid="JHN 7:41" />وفَمَّة نَاسْ أُخْرِينْ قَالُوا: «هَاذَا هُوَّ المَسِيحْ!» وأُخْرِينْ زَادَا قَالُوا: «يَاخِي المَسِيحْ بِشْ يْجِي مِالجَلِيلْ؟ <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />يَاخِي مُشْ قَالِتْ الكْتُبْ المُقَدْسَة الِّي المَسِيحْ بِشْ يْجِي مِنْ ذُرِّيِّةْ دَاوِدْ، ومِنْ بِيتْ لَحْمْ، المْدِينَة الِّي جَاء مِنْهَا دَاوِدْ؟». <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />يَاخِي تْخَالْفُوا النَّاسْ بِينْ بْعَضْهُمْ عْلَى خَاطْرُو. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />وفَمَّة جْمَاعَة مِنْهُمْ حَبُّوا يْشِدُّوهْ، آمَا حَتَّى وَاحِدْ مَا حَطْ يِدُّو عْلِيهْ.<verse eid="JHN 7:44" /></para>
  <para style="s">قَادِةْ اليْهُودْ مَا يَمْنُوشْ بْيَسُوعْ</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />ووَقْتِلِّي رَجْعُوا حُرَّاسْ الهَيْكِلْ، سِأْلُوهُمْ كْبَارْ الكَهَنَة والفِرِّيسِيِّينْ: «عْلَاشْ مَا جِبْتُوهِشْ؟». <verse eid="JHN 7:45" /><verse number="46" style="v" sid="JHN 7:46" />جَاوْبُوهُمْ الحُرَّاسْ: «عْمُرْنَا مَا سْمَعْنَا وَاحِدْ يِتْكَلِّمْ كِيمَا الرَّاجِلْ هَاذَا!». <verse eid="JHN 7:46" /><verse number="47" style="v" sid="JHN 7:47" />قَالُولْهُمْ الفِرِّيسِيِّينْ: «يَاخِي إِنْتُومَا زَادَا غَلَّطْكُمْ؟ <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />شُفْتُوشْ وَاحِدْ مِنْ كْبَارْ الكَهَنَة وَلَّا الفِرِّيسِيِّينْ أَمَّنْ بِيهْ؟ <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />آمَا عَامِّةْ الشَّعْبْ الِّي مَا يَعْرْفُوشْ الشَّرِيعَة، هَاذُوكُمْ مَلْعُونِينْ!» <verse eid="JHN 7:49" /><verse number="50" style="v" sid="JHN 7:50" />آمَا نِيقُودِيمُوسْ الِّي هُوَّ وَاحِدْ مِالفِرِّيسِيِّينْ، وهُوَّ الِّي مْشَى لْيَسُوعْ فِي اللِّيلْ، قَالِلْهُمْ: <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />«يَاخِي شَرِيعِتْنَا تُحْكُمْ عْلَى وَاحِدْ قْبَلْ مَا تِسْمْعُوا وتَعْرِفْ آشْ عْمَلْ؟». <verse eid="JHN 7:51" /><verse number="52" style="v" sid="JHN 7:52" />جَاوْبُوهْ: «تِطْلَعْشْ إِنْتِ زَادَا مِالجَلِيلْ؟ ثَبِّتْ فِي الكْتُبْ المُقَدْسَة، تَوْ تَلْقَى الِّي حَتَّى نَبِيْ مَا يْجِيْ مِالجَلِيلْ».<verse eid="JHN 7:52" /></para>
  <para style="s">يَسُوعْ والمْرَا الِّي شَدُّوهَا تَزْنَى</para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 7:53" />ومْبَعِّدْ كُلْ وَاحِدْ رَوِّحْ لْدَارُو.<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="nb">
    <verse number="1" style="v" sid="JHN 8:1" />آمَا يَسُوعْ طْلَعْ لِجْبَلْ الزِّيتُونْ. <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />وفِي الفَجْرْ رْجَعْ لِلْهَيْكِلْ، وجَاوُوهْ النَّاسْ الكُلْ، يَاخِي قْعَدْ وبْدَا يْعَلِّمْ فِيهُمْ. <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />وجَابُولُو عُلَمَاءْ الشَّرِيعَة والفِرِّيسِيِّينْ مْرَا شَدُّوهَا تَزْنَى، ووَقْفُوهَا فِي الوِسْطْ، <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />وقَالُولُو: «يَا مُعَلِّمْ، المْرَا هَاذِي شَدُّوهَا تَزْنَى، <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />ومُوسَى وَصَّانَا فِي الشَّرِيعَة إِنُّو الِّي كِيفْهَا لَازِمْ يِتْرِجْمُوا. وإِنْتِ، آشْ تْقُولْ؟». <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />قَالُولُو الكْلَامْ هَاذَا بَاشْ يْحَصْلُوهْ ويَلْقَاوْلُو تُهْمَة. آمَا يَسُوعْ طَبِّسْ، وبْدَا يِكْتِبْ بْصُبْعُو فِي التْرَابْ. <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />وكِي شَدُّوا صْحِيحْ فِي سُؤَالْهُمْ، وْقِفْ يَسُوعْ وقَالِلْهُمْ: «الِّي فِيكُمْ عُمْرُو مَا عْمَلْ ذَنْبْ، خَلِّيهْ يْكُونْ أَوِّلْ وَاحِدْ يَرْمِي عْلِيهَا حَجْرَة». <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />وطَبِّسْ مَرَّة أُخْرَى ورْجَعْ يِكْتِبْ فِي التْرَابْ. <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />ووَقْتِلِّي سَمْعُوا الكْلَامْ هَاذَا، بْدَاوْ يِجْبْدُوا فِي رْوَاحْهُمْ بِالوَاحِدْ بِالوَاحِدْ، كْبَارْهُمْ قْبَلْ صْغَارْهُمْ. وقْعَدْ يَسُوعْ وَحْدُو والمْرَا وَاقْفَة فِي بْلَاصِتْهَا. <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />وْقِفْ يَسُوعْ وقَالِلْهَا: «وِينْهُمْ يَا مْرَا؟ يَاخِي حَتَّى وَاحِدْ مِنْهُمْ مَا حْكُمْ عْلِيكْ؟». <verse eid="JHN 8:10" /><verse number="11" style="v" sid="JHN 8:11" />قَالِتْ: «حَتَّى حَدْ، يَا سِيدِي». قَالِلْهَا يَسُوعْ: «وآنَا زَادَا مَا نُحْكُمْشْ عْلِيكْ. إِمْشِي عْلَى رُوحِكْ ومَا تِرْجَعْشْ لِلذْنُوبْ!».<verse eid="JHN 8:11" /></para>
  <para style="s">يَسُوعْ هُوَّ نُورْ العَالِمْ</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />وزَادْ يَسُوعْ كَلِّمْ النَّاسْ وقَالِلْهُمْ: «آنَا نُورْ العَالِمْ. الِّي يْتَبَّعْنِي مَا يِمْشِيشْ فِي الظْلَامْ، آمَا يْكُونْ عَنْدُو نُورْ الحَيَاةْ». <verse eid="JHN 8:12" /><verse number="13" style="v" sid="JHN 8:13" />يَاخِي قَالُولُو الفِرِّيسِيِّينْ: «إِنْتِ تِشْهِدْ لْرُوحِكْ، هَاذَاكَا عْلَاشْ شْهَادْتِكْ بَاطْلَة». <verse eid="JHN 8:13" /><verse number="14" style="v" sid="JHN 8:14" />جَاوِبْهُمْ يَسُوعْ: «حَتَّى كَانْ نِشْهِدْ لْرُوحِي شْهَادْتِي صْحِيحَة، عْلَى خَاطِرْ نَعْرِفْ رُوحِي مْنِينْ جِيتْ ولْوِينْ مَاشِي. آمَا إِنْتُومَا، مَا تَعْرْفُونِيشْ مْنِينْ جِيتْ ولَا لْوِينْ مَاشِي. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />إِنْتُومَا تُحْكْمُوا كِيفْ مَا يُحْكْمُوا البَشَرْ، آمَا آنَا مَا نُحْكُمْ عْلَى حَتَّى حَدْ. <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />وحَتَّى كَانْ حْكُمْتْ، حُكْمِي صْحِيحْ، عْلَى خَاطِرْنِي مَانِيشْ نُحْكُمْ وَحْدِي، نُحْكُمْ آنَا والآبْ الِّي بْعَثْنِي. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />مَكْتُوبْ فِي شَرِيعِتْكُمْ الِّي شْهَادِةْ زُوزْ مِنْ نَاسْ تْصُحْ. <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />آنَا نِشْهِدْ لْرُوحِي، والآبْ الِّي بْعَثْنِي هُوَّ زَادَا يِشْهِدْلِي». <verse eid="JHN 8:18" /><verse number="19" style="v" sid="JHN 8:19" />يَاخِي قَالُولُو: «وِينُو بُوكْ؟». جَاوِبْهُمْ يَسُوعْ: «إِنْتُومَا لَا تَعْرْفُونِي ولَا تَعْرْفُوا بَابَا. كَانْ جِيتُوا عْرَفْتُونِي، رَاكُمْ عْرَفْتُوا بَابَا».<verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />قَالْ يَسُوعْ الكْلَامْ هَاذَا بَحْذَا صَنْدُوقْ التَّبَرُّعَاتْ، وَقْتِلِّي كَانْ يْعَلِّمْ فِي الهَيْكِلْ. وحَتَّى حَدْ مَا شَدُّو، عْلَى خَاطِرْ وَقْتُو مَزَّالْ مَا جَاشْ.<verse eid="JHN 8:20" /></para>
  <para style="s">يَسُوعْ يْنَبَّهْ اليْهُودْ</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />وزَادْ قَالِلْهُمْ: «آنَا مَاشِي وبِشْ تْلَوْجُوا عْلِيَّا، آمَا بِشْ تْمُوتُوا فِي ذْنُوبْكُمْ. البْلَاصَة الِّي آنَا مَاشِيلْهَا مَا تْنَجْمُوشْ تْجِيوْهَا». <verse eid="JHN 8:21" /><verse number="22" style="v" sid="JHN 8:22" />قَالُوا اليْهُودْ: «زَعْمَة بِشْ يُقْتُلْ رُوحُو، هَاذَاكَا عْلَاشْ قَالْ: "إِنْتُومَا مَا تْنَجْمُوشْ تْجِيوْ لِلْبْلَاصَة الِّي آنَا مَاشِيلْهَا"؟». <verse eid="JHN 8:22" /><verse number="23" style="v" sid="JHN 8:23" />قَالِلْهُمْ: «إِنْتُومَا مِاللُّوطَة آمَا آنَا مِالفُوقْ. إِنْتُومَا مِالعَالِمْ هَاذَا آمَا آنَا مَانِيشْ مِالعَالِمْ هَاذَا. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />هَاذَاكَا عْلَاشْ قُلْتِلْكُمْ بِشْ تْمُوتُوا فِي ذْنُوبْكُمْ. إِذَا كَانْ مَا تَمْنُوشْ الِّي آنَا هُوَّ، رَاكُمْ بِشْ تْمُوتُوا فِي ذْنُوبْكُمْ». <verse eid="JHN 8:24" /><verse number="25" style="v" sid="JHN 8:25" />قَالُولُو: «شْكُونِكْ إِنْتِ؟». جَاوِبْهُمْ يَسُوعْ: «آنَا هُوَّ الِّي قُلْتِلْكُمْ عْلِيهْ مِالأُوِّلْ. <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />عَنْدِي بَرْشَة حَاجَاتْ نْقُولْهَا عْلِيكُمْ، وبَرْشَة حَاجَاتْ نُحْكُمْ بِيهَا عْلِيكُمْ. آمَا الِّي بْعَثْنِي رَاهُو صَادِقْ، ولِّي سْمَعْتُو مِنُّو نْقُولُو لِلْعَالِمْ». <verse eid="JHN 8:26" /><verse number="27" style="v" sid="JHN 8:27" />ومَا فِهْمُوشْ الِّي هُوَّ كَانْ يَحْكِيلْهُمْ عَالآبْ. <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />قَالِلْهُمْ يَسُوعْ: «وَقْتِلِّي تْعَلْقُوا إِبْنْ الإِنْسَانْ، تَوْ تَعْرْفُوا الِّي آنَا هُوَّ، ولِّي آنَا مَا نَعْمِلْ حَتَّى شَيْ مِنْ رَاسِي، آمَا نْقُولْ الِّي عَلِّمْهُولِي الآبْ. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />والآبْ الِّي بْعَثْنِي هُوَّ مْعَايَا ومَا يْخَلِّينِيشْ وَحْدِي، عْلَى خَاطِرْنِي دِيمَا نَعْمِلْ الِّي يْرَضِّيهْ». <verse eid="JHN 8:29" /><verse number="30" style="v" sid="JHN 8:30" />وهُوَّ قَاعِدْ يْقُولْ فِي الكْلَامْ هَاذَا، أَمْنُوا بِيهْ بَرْشَة نَاسْ.<verse eid="JHN 8:30" /></para>
  <para style="s">أَوْلَادْ إِبْرَاهِيمْ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />وقَالْ يَسُوعْ لِلْيْهُودْ الِّي أَمْنُوا بِيهْ: «إِذَا كَانْ تِثْبْتُوا فِي كْلَامِي، تْوَلِّيوْ بِالحَقْ تْلَامِذْتِي، <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />وتَعْرْفُوا الحَقْ والحَقْ يْحَرِّرْكُمْ». <verse eid="JHN 8:32" /><verse number="33" style="v" sid="JHN 8:33" />جَاوْبُوهْ: «أَحْنَا ذُرِّيِّةْ إِبْرَاهِيمْ وعْمُرْنَا مَا كُنَّا عَبِيدْ لْحَتَّى حَدْ! كِيفَاشْ تْقُلْنَا: "بِشْ تْوَلِّيوْ أَحْرَارْ"؟».<verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />جَاوِبْهُمْ يَسُوعْ: «الحَقْ الحَقْ نْقُلْكُمْ: الِّي يَعْمِلْ الذْنُوبْ هُوَّ عَبْدْ لِلذْنُوبْ. <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />والعَبْدْ مَا يُقْعُدْشْ فِي دَارْ سِيدُو لِلْأَبَدْ، آمَا الإِبْنْ يِبْقَى لِلْأَبَدْ. <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />إِذَا حَرَّرْكُمْ الإِبْنْ رَاكُمْ تْوَلِّيوْ بِالحَقْ أَحْرَارْ. <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />آنَا نَعْرِفْ الِّي إِنْتُومَا ذُرِّيِّةْ إِبْرَاهِيمْ، آمَا تْحِبُّوا تُقْتْلُونِي، عْلَى خَاطِرْ كْلَامِي مَا عَنْدْوشْ بْلَاصَة فِي قْلُوبْكُمْ. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />آنَا نَحْكِي عَلِّي شُفْتُو عَنْدْ بَابَا، وإِنْتُومَا تَعْمْلُوا فِلِّي سْمَعْتُوهْ مِنْ بُوكُمْ».<verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />قَالُولُو: «بُونَا هُوَّ إِبْرَاهِيمْ». جَاوِبْهُمْ يَسُوعْ: «كَانْ جِيتُوا وْلَادْ إِبْرَاهِيمْ، رَاكُمْ تَعْمْلُوا أَعْمَالْ إِبْرَاهِيمْ. <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />آمَا هَاكُمْ تْحِبُّوا تُقْتْلُونِي، آنَا الِّي كَلِّمْتْكُمْ بِالحَقْ الِّي سْمَعْتُو مِنْ عَنْدْ اللَّهْ. إِبْرَاهِيمْ مَا عْمَلْشْ هَاذَا. <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />إِنْتُومَا تَعْمْلُوا فِي أَعْمَالْ بُوكُمْ». قَالُولُو: «أَحْنَا مَانَاشْ أَوْلَادْ حْرَامْ. عَنْدْنَا بُو وَاحِدْ، هُوَّ اللَّهْ».<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />يَاخِي قَالِلْهُمْ يَسُوعْ: «كَانْ جَاء اللَّهْ بُوكُمْ رَاكُمْ تْحِبُّونِي، عْلَى خَاطِرْنِي خْرَجْتْ وجِيتْ مِنْ عَنْدْ اللَّهْ. مَا جِيتِشْ وَحْدِي، آمَا هُوَّ الِّي بْعَثْنِي. <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />وعْلَاشْ مَا تِفْهْمُوشْ آشْ قَاعِدْ نْقُولْ؟ عْلَى خَاطِرْكُمْ مَا اطِّيقُوشْ تِسْمْعُوا كْلَامِي. <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />إِنْتُومَا وْلَادْ إِبْلِيسْ، وتْحِبُّوا تَعْمْلُوا شْهَاوِي بُوكُمْ. هُوَّ كَانْ قَتَّالْ أَرْوَاحْ مِنْ أُوْلُو. مَا ثْبِتْشْ فِي الحَقْ، عْلَى خَاطِرْ مَافِيهِشْ حَقْ. وهُوَّ يِكْذِبْ والكِذِبْ فِي طْبِيعْتُو، عْلَى خَاطْرُو كَذَّابْ وبُو الكِذْبْ. <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />آمَا آنَا، عْلَى خَاطِرْ نْقُولْ فِي الحَقْ، إِنْتُومَا مَا تْصَدْقُونِيشْ. <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />شْكُونْ فِيكُمْ يْشِدْ عْلِيَّا ذَنْبْ؟ ومَادَامْنِي نْقُولْ فِي الحَقْ، عْلَاشْ مَا تْصَدْقُونِيشْ؟ <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />الِّي هُوَّ تَابَعْ اللَّهْ يِسْمَعْ كْلَامْ اللَّهْ، وإِنْتُومَا مَا تِسْمْعُوشْ، عْلَى خَاطِرْكُمْ مَاكُمْشْ تَابْعِينْ اللَّهْ».<verse eid="JHN 8:47" /></para>
  <para style="s">يَسُوعْ وإِبْرَاهِيمْ</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />جَاوْبُوهْ اليْهُودْ: «مُشْ عَنْدْنَا الحَقْ كِي نْقُولُوا الِّي إِنْتِ سَامْرِي وسَاكْنِكْ شِيطَانْ؟» <verse eid="JHN 8:48" /><verse number="49" style="v" sid="JHN 8:49" />جَاوِبْهُمْ يَسُوعْ: «مُشْ سَاكِنِّي شِيطَانْ، آمَا آنَا نِكْرِمْ فِي بَابَا، وإِنْتُومَا مَاكُمْشْ تِكْرْمُوا فِيَّا. <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />آنَا مَا نُطْلُبْشْ المَجْدْ لْرُوحِي، آمَا فَمَّة شْكُونْ يُطْلُبْهُولِي، وهُوَّ الِّي يُحْكُمْ. <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />الحَقْ الحَقْ نْقُلْكُمْ: الِّي يْطِيعْ كْلَامِي، عُمْرُو مَا يْشُوفْ المُوتْ». <verse eid="JHN 8:51" /><verse number="52" style="v" sid="JHN 8:52" />قَالُولُو اليْهُودْ: «تَوَّا بِالحَقْ عْرَفْنَا الِّي سَاكْنِكْ شِيطَانْ. إِبْرَاهِيمْ مَاتْ والأَنْبِيَاءْ مَاتُوا، وإِنْتِ تْقُولْ: "الِّي يْطِيعْ كْلَامِي عُمْرُو مَا يْشُوفْ المُوتْ"! <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />يَاخِي إِنْتِ أَعْظَمْ مِنْ بُونَا إِبْرَاهِيمْ الِّي مَاتْ؟ وحَتَّى الأَنْبِيَاءْ مَاتُوا، يَاخِي شْكُونْ حَاسِبْ رُوحِكْ؟». <verse eid="JHN 8:53" /><verse number="54" style="v" sid="JHN 8:54" />جَاوِبْ يَسُوعْ: «كَانْ جِيتْ نْمَجِّدْ فِي رُوحِي، رَاهُو مَجْدِي بَاطِلْ. آمَا بَابَا هُوَّ الِّي يْمَجِّدْنِي، وإِنْتُومَا تْقُولُوا عْلِيهْ الِّي هُوَّ إِلَاهْكُمْ . <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />إِنْتُومَا مَا تَعْرْفُوهِشْ، آمَا آنَا نَعْرْفُو. كَانْ نْقُولْ الِّي آنَا مَا نَعْرْفُوشْ، نْكُونْ كَذَّابْ كِيفْكُمْ. آمَا آنَا نَعْرْفُو ونْطِيعْ كْلَامُو. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />بُوكُمْ إِبْرَاهِيمْ كَانْ مِتْشَوَّقْ يْشُوفْ نْهَارِي، وشَافُو وفْرَحْ». <verse eid="JHN 8:56" /><verse number="57" style="v" sid="JHN 8:57" />قَالُولُو اليْهُودْ: «كِيفَاشْ شُفْتْ إِبْرَاهِيمْ، وإِنْتِ عُمْرِكْ أَقَلْ مِالخَمْسِينْ؟». <verse eid="JHN 8:57" /><verse number="58" style="v" sid="JHN 8:58" />جَاوِبْهُمْ يَسُوعْ: «الحَقْ الحَقْ نْقُلْكُمْ: قْبَلْ مَا يِتْوْجِدْ إِبْرَاهِيمْ، آنَا مَوْجُودْ». <verse eid="JHN 8:58" /><verse number="59" style="v" sid="JHN 8:59" />يَاخِي هَزُّوا الحْجَرْ بَاشْ يُرْجْمُوهْ، آمَا يَسُوعْ تْخَبَّى وخْرَجْ مِالهَيْكِلْ.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">يَسُوعْ يِشْفِي المَوْلُودْ أَعْمَى</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />ووَقْتِلِّي كَانْ يَسُوعْ مِتْعَدِّي، شَافْ رَاجِلْ أَعْمَى مِلِّي تُولِدْ. <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />سِأْلُوهْ تْلَامِذْتُو: «يَا مُعَلِّمْ، شْكُونُو المُذْنِبْ: هُوَّ وَلَّا وَالْدِيهْ، حَتَّى تُولِدْ أَعْمَى؟». <verse eid="JHN 9:2" /><verse number="3" style="v" sid="JHN 9:3" />جَاوِبْهُمْ يَسُوعْ: «لَا هُوَّ ولَا وَالْدِيهْ أَذْنْبُوا، آمَا تُولِدْ أَعْمَى بَاشْ النَّاسْ يْشُوفُوا فِيهْ آشْ يْنَجِّمْ يَعْمِلْ اللَّهْ. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />يِلْزِمْنِي نَعْمِلْ أَعْمَالْ الِّي بْعَثْنِي، مَادَامْ الدِّنْيَا نْهَارْ، رَاهُو بَاشْ يْجِي اللِّيلْ وحَتَّى حَدْ مَا عَادْ يْنَجِّمْ يَعْمِلْ حَاجَة. <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />مَادَامْنِي فِي العَالِمْ، آنَا نُورْ العَالِمْ». <verse eid="JHN 9:5" /><verse number="6" style="v" sid="JHN 9:6" />قَالْ الكْلَامْ هَاذَا وبْزَقْ فِي التْرَابْ، وعْمَلْ مِنُّو طِينْ وحَطُّو عْلَى عِينِينْ الأَعْمَى <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />وقَالُّو: «إِمْشِي وأَغْسِلْ رُوحِكْ فِي جَابِيَةْ سِلْوَامْ» الِّي مَعْنَاهَا مَبْعُوثْ. يَاخِي مْشَى، وغْسَلْ، ورْجَعْ مِنْ غَادِي وهُوَّ يْشُوفْ.<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />الجِيرَانْ والنَّاسْ الِّي شَافُوهْ قْبَلْ يُطْلُبْ قَالُوا: «يَاخِي مُشْ هَاذَا الِّي كَانْ دِيمَا يُقْعُدْ ويُطْلُبْ؟» <verse eid="JHN 9:8" /><verse number="9" style="v" sid="JHN 9:9" />فَمَّة الِّي قَالُوا: «أَيْ هَاذَاكَا هُوَّ». وفَمَّة الِّي قَالُوا: «لَا، يِشَبَّهْلُو». آمَا هُوَّ كَانْ يْقُولْ: «آنَا هُوَّ!». <verse eid="JHN 9:9" /><verse number="10" style="v" sid="JHN 9:10" />يَاخِي سِأْلُوهْ: «كِيفَاشْ عِينِيكْ تْحَلِّتْ؟». <verse eid="JHN 9:10" /><verse number="11" style="v" sid="JHN 9:11" />جَاوِبْ: «الرَّاجِلْ الِّي إِسْمُو يَسُوعْ عْمَلْ طِينْ وحَطُّو عْلَى عِينَيَّا وقَالِّي: "إِمْشِي أَغْسِلْ فِي جَابِيَةْ سِلْوَامْ". مْشِيتْ وغْسَلْتْ، ووَلِّيتْ نْشُوفْ». <verse eid="JHN 9:11" /><verse number="12" style="v" sid="JHN 9:12" />قَالُولُو: «وهُوَّ وِينُو؟» قَالْ: «مَا نَعْرِفْشْ».<verse eid="JHN 9:12" /></para>
  <para style="s">الفِرِّيسِيِّينْ يِسْتَجُوبُوا فِي الرَّاجِلْ</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />يَاخِي هَزُّوا الرَّاجِلْ الِّي كَانْ أَعْمَى لِلْفِرِّيسِيِّينْ. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />والنْهَارْ الِّي عْمَلْ فِيهْ يَسُوعْ الطِّينْ وحَلْ عِينِينْ الأَعْمَى كَانْ نْهَارْ سِبْتْ. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />زَادُوا الفِرِّيسِيِّينْ سِأْلُوهْ كِيفَاشْ وَلَّى يْشُوفْ، جَاوِبْهُمْ: «حَطْلِي طِينْ عْلَى عِينَيَّا وغْسَلْتْ وَلِّيتْ نْشُوفْ». <verse eid="JHN 9:15" /><verse number="16" style="v" sid="JHN 9:16" />فَمَّة فِرِّيسِيِّينْ قَالُوا: «مَا يْنَجِّمْشْ يْكُونْ الرَّاجِلْ هَاذَا جَايْ مِنْ عَنْدْ اللَّهْ عْلَى خَاطْرُو مَا احْتَرِمْشْ السِّبْتْ». وفَمَّة نَاسْ أُخْرِينْ قَالُوا: «كِيفَاشْ يْنَجِّمْ وَاحِدْ مُذْنِبْ يَعْمِلْ المُعْجْزَاتْ هَاذِي؟» وتْخَالْفُوا بِينْ بْعَضْهُمْ. <verse eid="JHN 9:16" /><verse number="17" style="v" sid="JHN 9:17" />وزَادُوا سِأْلُو الأَعْمَى: «وإِنْتِ شْنُوَّة تْقُولْ عْلِيهْ بَعْدْمَا حَلِّكْ عِينِيكْ؟». جَاوِبْهُمْ: «هُوَّ نَبِيْ!». <verse eid="JHN 9:17" /><verse number="18" style="v" sid="JHN 9:18" />وقَادِة اليْهُودْ مَا صَدْقُوشْ الِّي هُوَّ كَانْ أَعْمَى ووَلَّى يْشُوفْ، وَلَّاوْ إِسْتَدْعَاوْ أُمُّو وبُوهْ <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />وسِأْلُوهُمْ: «يَاخِي مُشْ هَاذَا وِلْدْكُمْ الِّي تْقُولُو إِنُّو تُولِدْ أَعْمَى؟ مَالَا كِيفَاشْ وَلَّى يْشُوفْ؟». <verse eid="JHN 9:19" /><verse number="20" style="v" sid="JHN 9:20" />أُمُّو وبُوهْ قَالُوا: «أَحْنَا نَعْرْفُوا الِّي هَاذَا وِلْدْنَا، ولِّي هُوَّ تُولِدْ أَعْمَى <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />آمَا كِيفَاشْ تَوَّا وَلَّى يْشُوفْ وشْكُونْ حَلُّو عِينِيهْ، مَا نَعْرْفُوشْ. هُوَّ بَالِغْ، إِسْأْلُوهْ، تَوْ يْجَاوِبْكُمْ». <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />ووَالْدِيهْ قَالُوا هَاذَا عْلَى خَاطِرْهُمْ خَايْفِينْ مِنْ قَادِةْ اليْهُودْ، الِّي تْفَاهْمُوا بَاشْ يْطَرْدُوا مِالمَعْبِدْ أَيْ وَاحِدْ يْقُولْ الِّي يَسُوعْ هُوَّ المَسِيحْ. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />هَاذَاكَا عْلَاشْ وَالْدِيهْ قَالُوا: «هُوَّ بَالِغْ، إِسْأْلُوهْ».<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />ومْبَعِّدْ سْتَدْعَاوْا الفِرِّيسِيِّينْ الرَّاجِلْ الِّي كَانْ أَعْمَى مَرَّة أُخْرَى وقَالُولُو: «قُولْ الحَقْ قُدَّامْ اللَّهْ! أَحْنَا نَعْرْفُوا الِّي الرَّاجِلْ هَاذَا مُذْنِبْ». <verse eid="JHN 9:24" /><verse number="25" style="v" sid="JHN 9:25" />جَاوِبْ: «مَا نَعْرِفْشْ هُوَّ مُذْنِبْ وَلَّا لَا، آمَا نَعْرِفْ حَاجَة وَحْدَة: كُنْتْ أَعْمَى وتَوَّا وَلِّيتْ نْشُوفْ». <verse eid="JHN 9:25" /><verse number="26" style="v" sid="JHN 9:26" />وَلَّاوْ سِأْلُوهْ مَرَّة أُخْرَى: «آشْ عْمَلِّكْ؟ كِيفَاشْ حَلِّكْ عِينِيكْ؟». <verse eid="JHN 9:26" /><verse number="27" style="v" sid="JHN 9:27" />جَاوِبْهُمْ: «قُلْتِلْكُمْ ومَا سْمَعْتُونِيشْ، عْلَاشْ تْحِبُّوا تِسْمْعُوا مَرَّة أُخْرَى؟ يَاخِي إِنْتُومَا زَادَا تْحِبُّوا تْوَلِّيوْ تْلَامِذْتُو؟». <verse eid="JHN 9:27" /><verse number="28" style="v" sid="JHN 9:28" />يَاخِي سَبُّوهْ وقَالُولُو: «إِنْتِ تِلْمِيذُو! آمَا أَحْنَا رَانَا تْلَامِذْةْ مُوسَى. <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />أَحْنَا نَعْرْفُوا الِّي اللَّهْ كَلَّمْ مُوسَى، آمَا هَاذَا مَا نَعْرْفُوشْ عْلِيهْ حَتَّى مْنِينْ جَاء». <verse eid="JHN 9:29" /><verse number="30" style="v" sid="JHN 9:30" />جَاوِبْهُمْ الرَّاجِلْ: «غْرِيبَة! كِيفَاشْ مَا تَعْرْفُوهِشْ مْنِينْ جَاء وهُوَّ حَلِّي عِينَيَّا؟ <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />أَحْنَا نَعْرْفُوا الِّي اللَّهْ مَا يَسْتَجِيبِشْ لِلْمُذْنْبِينْ، آمَا يَسْتَجِيبْ لِلنَّاسْ الِّي يْخَافُوهْ ويَعْمْلُوا مَشِيئْتُو. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />وعْمُرْنَا مَا سْمَعْنَا بْوَاحِدْ حَلْ عِينِينْ إِنْسَانْ مَوْلُودْ أَعْمَى. <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />لَوْ كَانْ مَا جَاشْ الرَّاجِلْ هَاذَا مِنْ عَنْدْ اللَّهْ، مَا كَانْ يْنَجِّمْ يَعْمِلْ حَتَّى شَيْ». <verse eid="JHN 9:33" /><verse number="34" style="v" sid="JHN 9:34" />قَالُولُو: «إِنْتِ بْكُلِّكْ تُولِدْتْ فِي الذْنُوبْ وتْحِبْ تْعَلَّمْنَا؟» وطَرْدُوهْ مِالمَعْبِدْ.<verse eid="JHN 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />وسْمَعْ يَسُوعْ الِّي هُومَا طَرْدُوهْ، يَاخِي وَقْتِلِّي قَابْلُو سِأْلُو: «إِنْتِ تَمِّنْ بِإِبْنْ الإِنْسَانْ؟». <verse eid="JHN 9:35" /><verse number="36" style="v" sid="JHN 9:36" />جَاوْبُو: «شْكُونُو هُوَّ يَا سِيدِي بَاشْ نَمِّنْ بِيهْ؟». <verse eid="JHN 9:36" /><verse number="37" style="v" sid="JHN 9:37" />قَالُّو يَسُوعْ: «إِنْتِ شُفْتُو، وهُوَّ قَاعِدْ يَحْكِي مْعَاكْ تَوَّا!». <verse eid="JHN 9:37" /><verse number="38" style="v" sid="JHN 9:38" />قَالْ: «آنَا نَمِّنْ، يَا سِيدِي!» وسْجِدْلُو. <verse eid="JHN 9:38" /><verse number="39" style="v" sid="JHN 9:39" />وقَالْ يَسُوعْ: «جِيتْ لِلْعَالِمْ هَاذَا بَاشْ نُحْكُمْ، بَاشْ الِّي مَا يْشُوفُوشْ يْوَلِّيوْ يْشُوفُوا، ولِّي يْشُوفُوا يْوَلِّيوْ مَا يْشُوفُوشْ».<verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />سَمْعُوهْ جْمَاعَة مِالفِرِّيسِيِّينْ الِّي كَانُوا حَاضْرِينْ، قَالُولُو: «يَاخِي أَحْنَا زَادَا عِمْيَانْ؟». <verse eid="JHN 9:40" /><verse number="41" style="v" sid="JHN 9:41" />جَاوِبْهُمْ يَسُوعْ: «كَانْ جِيتُوا عِمْيَانْ بِالحَقْ، رَاهُو مَا عْلِيكُمِشْ ذَنْبْ. آمَا إِنْتُومَا تْقُولُوا إِنْكُمْ تْشُوفُوا، هَاذَاكَا عْلَاشْ إِنْتُومَا مَسْؤُولِينْ عْلَى ذَنْبْكُمْ».<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">يَسُوعْ هُوَّ الرَّاعِي الصَّالَحْ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />«الحَقْ الحَقْ نْقُلْكُمْ: الِّي مَا يُدْخُلْشْ لْكُورِي الغْنَمْ مِالبَابْ، آمَا يِطْلَعْلُو مِنْ شِيرَة أُخْرَى، رَاهُو سَارِقْ وخَطَّافْ. <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />آمَا الِّي يُدْخُلْ مِالبَابْ رَاهُو رَاعِي الغْنَمْ. <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />والعَسَّاسْ يْحِلُّو، والغْنَمْ تِسْمَعْ صُوتُو، ويْعَيِّطْ لِلْغْنَمْ مْتَاعُو كُلْ وَاحِدْ بْإِسْمُو ويْخَرِّجْهُمْ لْبَرَّا مِالكُورِي. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />ووَقْتِلِّي يْخَرِّجْهُمْ الكُلْ، يِمْشِي قُدَّامْهُمْ وهُومَا يْتَبْعُوهْ عْلَى خَاطِرْهُمْ يَعْرْفُوا صُوتُو. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />آمَا البَرَّانِي يُهْرْبُوا مِنُّو مَا يْتَبْعُوهِشْ، عْلَى خَاطِرْهُمْ مَا يَعْرْفُوشْ صُوتْ البْرَايْنِيَّة». <verse eid="JHN 10:5" /><verse number="6" style="v" sid="JHN 10:6" />قَالِلْهُمْ يَسُوعْ المَثَلْ هَاذَا، آمَا هُومَا مَا فَهْمُوشْ شْنُوَّة يُقْصُدْ.<verse eid="JHN 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />يَاخِي زَادْ قَالِلْهُمْ : «الحَقْ الحَقْ نْقُولِلْكُمْ: آنَا هُوَّ بَابْ الغْنَمْ. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />الِّي جَاوْ قَبْلِي الكُلْهُمْ سُرَّاقْ وخَطَّافِينْ، آمَا الغْنَمْ مَا سَمْعُولْهُمْشْ. <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />آنَا هُوَّ البَابْ. الِّي يُدْخُلْ مِنِّي يِنْجَى، ويُدْخُلْ ويُخْرُجْ ويَلْقَى آشْ يَاكِلْ. <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />السَّارِقْ مَا يْجِي كَانْ بَاشْ يِسْرِقْ ويِذْبِحْ وْيِهْلِكْ. آمَا آنَا جِيتْ بَاشْ نَعْطِيهُمْ حَيَاةْ، حَيَاةْ عَنْدْهَا مَعْنَى.<verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />«آنَا هُوَّ الرَّاعِي الصَّالَحْ، والرَّاعِي الصَّالَحْ يْضَحِّي بْرُوحُو عْلَى خَاطِرْ الغْنَمْ مْتَاعُو. <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />والخَدَّامْ مُشْ كِيفْ الرَّاعِي، عْلَى خَاطِرْ الغْنَمْ مُشْ مْتَاعُو، وَقْتِلِّي يْشُوفْ الذِّيبْ جَايْ، يْخَلِّي الغْنَمْ ويُهْرُبْ، والذِّيبْ يَخْطِفْهَا ويْفَرَّقْهَا. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />والخَدَّامْ يُهْرُبْ عْلَى خَاطْرُو خَدَّامْ، ومَا يْهِمُّوشْ فِي الغْنَمْ. <verse eid="JHN 10:13" /><verse number="14" style="v" sid="JHN 10:14" />آمَا آنَا الرَّاعِي الصَّالَحْ، ونَعْرِفْ الغْنَمْ مْتَاعِي والغْنَمْ مْتَاعِي تَعْرَفْنِي، <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />كِيفْ مَا الآبْ يَعْرِفْنِي وآنَا نَعْرِفْ الآبْ. وآنَا نْضَحِّي بْرُوحِي عْلَى خَاطِرْ الغْنَمْ مْتَاعِي. <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />وعَنْدِي غْنَمْ أُخْرِينْ مَاهُمْشْ مِالكُورِي هَاذَا، لَازِمْنِي نْجِيبْهُمْ، وهُومَا بِشْ يِسْمْعُوا صُوتِي، ويْوَلِّي فَمَّة رَعِيَّة وَحْدَة وْرَاعِي وَاحِدْ. <verse eid="JHN 10:16" /><verse number="17" style="v" sid="JHN 10:17" />هَاذَاكَا عْلَاشْ الآبْ يْحِبْنِي، عْلَى خَاطِرْنِي نَعْطِي حْيَاتِي بَاشْ نْعَاوِدْ نَاخِذْهَا. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />حَتَّى حَدْ مَا يَاخِذْلِي حْيَاتِي بِالقُوَّة، آمَا آنَا الِّي نْضَحِّي بِيهَا بِرْضَايَا. عَنْدِي السُّلْطَة بِشْ نَعْطِيهَا، وعَنْدِي السُّلْطَة بِشْ نْرَجَّعْهَا. هَاذِي الوْصِيَّة الِّي خْذِيتْهَا مِنْ عَنْدْ بَابَا».<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />وتْخَالْفُوا اليْهُودْ مَرَّة أُخْرَى عْلَى خَاطِرْ الكْلَامْ هَاذَا. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />بَرْشَة مِنْهُمْ قَالُوا: «رَاهُو سَاكْنُو شِيطَانْ ويْخَرِّفْ، عْلَاشْ تِسْمْعُوا فِيهْ؟». <verse eid="JHN 10:20" /><verse number="21" style="v" sid="JHN 10:21" />ونَاسْ أُخْرِينْ قَالُوا: «الكْلَامْ هَاذَا مُشْ مْتَاعْ وَاحِدْ سَاكْنُو شِيطَانْ. يَاخِي الشِّيطَانْ يْنَجِّمْ يْحِلْ عِينِينْ العِمْيَانْ؟».<verse eid="JHN 10:21" /></para>
  <para style="s">اليْهُودْ يُرْفْضُوا يَسُوعْ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />وجَاء عِيدْ تَجْدِيدْ الهَيْكَلْ فِي أُورْشَلِيمْ، وكَانْ الوَقْتْ فِي الشْتَاء. <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />وكَانْ يَسُوعْ يْدُورْ فِي الهَيْكِلْ فِي البْلَاصَة الِّي مْسَمِّينْهَا أَقْوَاسْ سُلَيْمَانْ، <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />دَارُوا بِيهْ اليْهُودْ وقَالُولُو: «لْوَقْتَاشْ بَاشْ تْخَلِّينَا حَايْرِينْ فِيكْ؟ قُلْنَا بْصَرَاحَة: يَاخِي إِنْتِ هُوَّ المَسِيحْ؟». <verse eid="JHN 10:24" /><verse number="25" style="v" sid="JHN 10:25" />جَاوِبْهُمْ يَسُوعْ: «قُلْتِلْكُمْ، آمَا إِنْتُومَا مَا تْصَدْقُوشْ. الأَعْمَالْ الِّي نَعْمِلْ فِيهَا بْإِسْمْ بَابَا هِيَّ تِشْهِدْلِي. <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />آمَا إِنْتُومَا مَا تْصَدْقُونِيشْ عْلَى خَاطِرْكُمْ مَاكُمْشْ مِالغْنَمْ مْتَاعِي. <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />الغْنَمْ مْتَاعِي يِسْمْعُوا صُوتِي، وآنَا نَعْرِفْهُمْ وهُومَا يْتَبْعُونِي. <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />وآنَا نَعْطِيهُمْ الحَيَاةْ الأَبَدِيَّة، وعْمُرْهُمْ مَا يِمْشِيوْ لِلْهْلَاكْ، وحَتَّى حَدْ مَا يْنَجِّمْ يْفُكْهُمْ مِنْ يِدِّي. <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />بَابَا الِّي عْطَاهُمْلِي هُوَّ أَعْظِمْ مِالكُلْ، وحَتَّى حَدْ مَا يْنَجِّمْ يْفُكْهُمْ مِنْ يِدْ الآبْ. <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />آنَا والآبْ وَاحِدْ».<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />وهَزُّوا اليْهُودْ الحْجَرْ مَرَّة أُخْرَى بَاشْ يُرْجْمُوهْ. <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />قَالِلْهُمْ يَسُوعْ: «آنَا وَرِّيتْكُمْ بَرْشَة أَعْمَالْ صَالْحَةْ مِنْ عَنْدْ الآبْ، عْلَى آنَا وَحْدَة مِنْهُمْ بَاشْ تُرْجْمُونِي؟». <verse eid="JHN 10:32" /><verse number="33" style="v" sid="JHN 10:33" />جَاوْبُوهْ اليْهُودْ: «مَانَاشْ بَاشْ نُرْجْمُوكْ عْلَى حَاجَة صَالْحَة عْمَلْتْهَا، آمَا عْلَى كُفْرِكْ. عْلَى خَاطْرِكْ رَدِّيتْ رُوحِكْ اللَّهْ، وإِنْتِ مَاكْ إِلَّا بَشَرْ». <verse eid="JHN 10:33" /><verse number="34" style="v" sid="JHN 10:34" />جَاوِبْهُمْ يَسُوعْ: «يَاخِي مُشْ فِي شَرِيعِتْكُمْ اللَّهْ قَالْ: "إِنْتُومَا آلْهَة"؟ <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />إِذَا كَانْ شَرِيعِتْكُمْ تْسَمِّي النَّاسْ الِّي جَاتْهُمْ كِلْمِةْ اللَّهْ آلْهَة، والكْتُبْ المُقَدْسَة دِيمَا صَادْقَة، <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />كِيفَاشْ تْقُولُو لِلِّي قَدْسُو الآبْ وبَعْثُو لِلْعَالِمْ "إِنْتِ تَكْفِرْ"، عْلَى خَاطِرْنِي قُلْتْ: "آنَا إِبْنْ اللَّهْ"؟ <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />إِذَا كَانْ مَانِيشْ نَعْمِلْ فِي أَعْمَالْ بَابَا، مَا تْصَدْقُونِيشْ. <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />آمَا إِذَا كُنْتْ نَعْمِلْ فِيهَا، عْلَى الأَقَلْ صَدْقُواهَا هِيَّ، كِي مَاكُمْشْ مْصَدْقِينِّي آنَا. ووَقْتْهَا تَعْرْفُوا وتِتْأَكْدُوا الِّي الآبْ فِيَّا وآنَا فِيهْ». <verse eid="JHN 10:38" /><verse number="39" style="v" sid="JHN 10:39" />وحَاوْلُوا مَرَّة أُخْرَى بَاشْ يْشِدُّوهْ، آمَا هُوَّ فْلِتْ مِنْ بِينْ يْدِيهُمْ.<verse eid="JHN 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40" />ورْجَعْ لِلشِّيرَة الأُخْرَى مْتَاعْ نَهْرْ الأُرْدُنْ وِينْ كَانْ يُوحَنَّا يْعَمِّدْ فِي النَّاسْ قْبَلْ، وقْعَدْ غَادِي. <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />وجَاوَهْ بَرْشَة نَاسْ وقَالُوا: «يُوحَنَّا مَا عْمَلْ حَتَّى مُعْجْزَة، آمَا الِّي قَالُّو عَالرَّاجِلْ هَاذَا الكُلُّو صْحِيحْ». <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />وغَادِي أَمْنُوا بِيهْ بَرْشَة نَاسْ.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">مُوتْ لِعَازَرْ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />وكَانْ فَمَّة رَاجِلْ مْرِيضْ إِسْمُو لِعَازَرْ، مِنْ دَشْرِةْ بِيتْ عَنْيَا الِّي تُسْكُنْ فِيهَا مَرْيِمْ وأُخْتْهَا مَرْثَى. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />ومَرْيِمْ هَاذِي هِيَّ الِّي دِهْنِتْ سَاقِينْ الرَّبْ بِالعِطْرْ ومَسْحِتْهُمْ بِشْعَرْهَا، وهِيَّ أُخْتْ لِعَازَرْ المْرِيضْ. <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />بَعْثُوا الإِخْوَاتْ لْيَسُوعْ شْكُونْ يْقُّلُو: «يَا سِيدِي، رَاهُو الِّي تْحِبُّو مْرِيضْ». <verse eid="JHN 11:3" /><verse number="4" style="v" sid="JHN 11:4" />ووَقْتِلِّي سْمَعْ يَسُوعْ قَالْ: «المْرَضْ هَاذَا مُشْ بِشْ يْوَصِّلْ لِلْمُوتْ، آمَا بِشْ يِتْمَجِّدْ بِيهْ اللَّهْ، وهَكَّا يِتْمَجِّدْ بِيهْ إِبْنْ اللَّهْ».<verse eid="JHN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5" />وكَانْ يَسُوعْ يْحِبْ مَرْثَا وأُخْتْهَا ولِعَازَرْ، <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />ورَغْمْ هَاذَا، وَقْتِلِّي سْمَعْ بْلِعَازَرْ مْرِيضْ، زَادْ قْعَدْ نْهَارِينْ فِي البْلَاصَة الِّي هُوَّ فِيهَا. <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />ومْبَعِّدْ قَالْ لِتْلَامْذَتُو: «هَيَّا نِرْجْعُوا لْمَنْطَقْةْ اليَهُودِيَّة». <verse eid="JHN 11:7" /><verse number="8" style="v" sid="JHN 11:8" />يَاخِي قَالُولُو التْلَامْذَة: «يَا مُعَلِّمْ، قْبِيلَة شْوَيَّة اليْهُودْ كَانُوا يْحِبُّوا يُرْجْمُوكْ، وإِنْتِ تْحِبْ تِرْجَعْ الغَادِي؟». <verse eid="JHN 11:8" /><verse number="9" style="v" sid="JHN 11:9" />جَاوِبْ يَسُوعْ: «يَاخِي النْهَارْ مُشْ فِيهْ أَثْنَاشِنْ سَاعَة؟ الِّي يِمْشِي فِي النْهَارْ مَا يِدَّعْثِرْشْ، عْلَى خَاطِرْ فِي النْهَارْ الدِّنْيَا ضَاوْيَة، ويْنَجِّمْ يْشُوفْ. <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />آمَا الِّي يِمْشِي فِي اللِّيلْ يِدَّعْثِرْ، عْلَى خَاطْرُو مَافِيهِشْ نُورْ». <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />وبَعْدْ زَادْ قَالِلْهُمْ: «صَاحِبْنَا لِعَازَرْ رْقَدْ، آمَا آنَا بِشْ نِمْشِي نْقَيْمُو». <verse eid="JHN 11:11" /><verse number="12" style="v" sid="JHN 11:12" />قَالُولُو التْلَامْذَة: «يَا سِيدْنَا، كَانُو رَاقِدْ، تَوْ يْقُومْ لَابَاسْ». <verse eid="JHN 11:12" /><verse number="13" style="v" sid="JHN 11:13" />وكَانْ يَسُوعْ يَحْكِي عْلَى مُوتْ لِعَازَرْ، آمَا هُومَا مْشَى فِي بَالْهُمْ يَحْكِي عَالنُّومْ العَادِي. <verse eid="JHN 11:13" /><verse number="14" style="v" sid="JHN 11:14" />وَلَّى قَالِلْهُمْ يَسُوعْ بْوْضُوحْ: «لِعَازَرْ مَاتْ. <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />وعْلَى خَاطِرْكُمْ آنَا فَرْحَانْ الِّي مَاكُنْتِشْ غَادِي، بَاشْ إِنْتُومَا تَمْنُوا. أَيَّا بَرَّى نِمْشِيوْلُو». <verse eid="JHN 11:15" /><verse number="16" style="v" sid="JHN 11:16" />يَاخِي تُومَا الِّي يْسَمِّيوَهْ التُّومِي قَالْ لِلتْلَامْذَة الأُخْرِينْ: «هَيَّا أَحْنَا زَادَا نِمْشِيوْ ونْمُوتُوا مْعَاهْ».<verse eid="JHN 11:16" /></para>
  <para style="s">يَسُوعْ يْقَيِّمْ لِعَازَرْ مِالمُوتْ</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />ووَقْتِلِّي وْصُلْ يَسُوعْ، لْقَى الِّي لِعَازَرْ عَنْدُو أَرْبْعَة أَيَّامْ فِي القْبَرْ. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />وكَانِتْ بِيتْ عَنْيَا مَا تِبْعِدْ عْلَى أُورْشَلِيمْ كَانْ حْكَايِةْ ثْلَاثَة كِيلُومَاتِرْ. <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />وبَرْشَة يْهُودْ جَاوْ لْمَرْثَا ومَرْيِمْ بَاشْ يْعَزِّيوْهُمْ فِي خُوهُمْ. <verse eid="JHN 11:19" /><verse number="20" style="v" sid="JHN 11:20" />وَقْتِلِّي سَمْعِتْ مَرْثَا الِّي يَسُوعْ جَايْ، خَرْجِتْ بَاشْ تْعَرِّضْلُو، آمَا مَرْيِمْ بْقَاتْ فِي الدَّارْ. <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />قَالِتْ مَرْثَا لْيَسُوعْ: «يَا سِيدِي، كَانْ جِيتْ إِنْتِ هْنَا، رَاهُو خُويَا مَا مَاتِشْ. <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />آمَا حَتَّى تَوَّا نَعْرِفْ الِّي أَيْ حَاجَة تُطْلُبْهَا مِنْ عَنْدْ اللَّهْ، يَعْطِيهَالِكْ». <verse eid="JHN 11:22" /><verse number="23" style="v" sid="JHN 11:23" />قَالِلْهَا يَسُوعْ: «خُوكْ بِشْ يْقُومْ». <verse eid="JHN 11:23" /><verse number="24" style="v" sid="JHN 11:24" />قَالِتْلُو مَرْثَا: «آنَا نَعْرِفْ الِّي هُوَّ بِشْ يْقُومْ فِي يُومْ القْيَامَة، فِي نْهَارْ الحْسَابْ». <verse eid="JHN 11:24" /><verse number="25" style="v" sid="JHN 11:25" />يَاخِي قَالِلْهَا يَسُوعْ: «آنَا هُوَّ القْيَامَة والحَيَاةْ. الِّي يَمِّنْ بِيَّا بِشْ يَحْيَا حَتَّى لَوْ كَانْ مَاتْ. <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />ولِّي هُوَّ حَيْ ويَمِّنْ بِيَّا عُمْرُو مَا يْمُوتْ. إِنْتِ تَمِّنْ بْهَاذَا؟». <verse eid="JHN 11:26" /><verse number="27" style="v" sid="JHN 11:27" />قَالِتْلُو: «إِيْ نْعَمْ يَا سِيدِي، آنَا نَمِّنْ الِّي إِنْتِ هُوَّ المَسِيحْ إِبْنْ اللَّهْ الِّي جَايْ لِلْعَالِمْ».<verse eid="JHN 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />وبَعْدْمَا قَالِتْ الكْلَامْ هَاذَا، رَجْعِتْ مَرْثَا لِلدَّارْ وعَيْطِتْ لِأُخْتْهَا مَرْيِمْ وقَالْتِلْهَا فِي وْذِنْهَا: «المُعَلِّمْ هْنَا، ويْعَيِّطْلِكْ». <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />ودُوبْ مَا سَمْعِتْ مَرْيِمْ، قَامِتْ فِيسَعْ ومْشَاتْلُو، <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />عْلَى خَاطِرْ يَسُوعْ مَزَّالْ مَا وْصِلْشْ لِلْقَرْيَة، آمَا قْعَدْ فِي البْلَاصَة الِّي عُرْضُتُّو فِيهَا مَرْثَا. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />اليْهُودْ الِّي كَانُوا فِي الدَّارْ يْعَزِّيُوا فِي مَرْيِمْ، شَافُوا الِّي هِيَّ قَامِتْ فِيسَعْ وخَرْجِتْ، يَاخِي تَبْعُوهَا، عْلَى خَاطِرْ مْشَى فِي بَالْهُمْ الِّي هِيَّ مَاشْيَة لِلْقْبَرْ بَاشْ تِبْكِي غَادِي. <verse eid="JHN 11:31" /><verse number="32" style="v" sid="JHN 11:32" />وكِي وِصْلِتْ مَرْيِمْ لِلْبْلَاصَة الِّي فِيهَا يَسُوعْ، تِرْمَاتْ عَنْدْ سَاقِيهْ دُوبْ مَا شَافِتُّو وقَالِتْلُو: «يَا سِيدِي، كَانْ جِيتْ هْنَا، رَاهُو خُويَا مَا مَاتِشْ». <verse eid="JHN 11:32" /><verse number="33" style="v" sid="JHN 11:33" />ووَقْتِلِّي شَافْهَا يَسُوعْ تِبْكِي، واليْهُودْ الِّي جَاوْ مْعَاهَا يِبْكِيُوا، تْنَهِّدْ بِالقْوِيْ وظْهُرْ عْلِيهْ الحُزْنْ، <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />وقَالْ: «وِينْ دْفِنْتُوهْ؟» قَالُولُو: «يَا سِيدْنَا، إِيجَا وشُوفْ». <verse eid="JHN 11:34" /><verse number="35" style="v" sid="JHN 11:35" />ووَقْتْهَا بْكَى يَسُوعْ. <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />يَاخِي اليْهُودْ قَالُوا: «شُوفُوا قَدَّاشْ كَانْ يْحِبُّو!». <verse eid="JHN 11:36" /><verse number="37" style="v" sid="JHN 11:37" />آمَا فَمَّة مِنْهُمْ الِّي قَالُوا: «هَاذَا الِّي حَلْ عِينِينْ الأَعْمَى، مَا كَانِشْ يْنَجِّمْشْ يْمَنَّعْ لِعَازَرْ مِالمُوتْ؟».<verse eid="JHN 11:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />وتْنَهِّدْ يَسُوعْ مِالحُزْنْ مَرَّة أُخْرَى. وبَعْدْ وْصُلْ لِلْقْبَرْ الِّي كَانْ عِبَارَة عْلَى مْغَارَة مْسَكْرَة بْحَجْرَة. <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />قَالِلْهُمْ يَسُوعْ: «نَحِّيوْ الحَجْرَة!». قَالِتْلُو مَرْثَا أُخْتْ المَيِّتْ: «يَا سِيدِي، رَاهُو نْتِنْ عْلَى خَاطِرْ عَنْدُو أَرْبْعَة أَيَّامْ فِي القْبَرْ». <verse eid="JHN 11:39" /><verse number="40" style="v" sid="JHN 11:40" />جَاوِبْهَا يَسُوعْ: «مُشْ قُتْلِكْ إِذَا كَانْ تَمِّنْ تْشُوفْ مَجْدْ اللَّهْ؟». <verse eid="JHN 11:40" /><verse number="41" style="v" sid="JHN 11:41" />نَحَّاوْ الحَجْرَة، وهَزْ يَسُوعْ عِينِيهْ لِلسْمَاء وقَالْ: «يَا بَابَا، نُشْكْرِكْ عْلَى خَاطْرِكْ سْمَعْتْنِي. <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />نَعْرِفْ الِّي إِنْتِ دِيمَا تِسْمَعْ صْلَاتِي، آمَا رَانِي قُلْتْ الكْلَامْ هَاذَا عْلَى خَاطِرْ النَّاسْ الِّي دَايْرِينْ بِيَّا، بَاشْ يَمْنُوا الِّي إِنْتِ بْعَثْتْنِي». <verse eid="JHN 11:42" /><verse number="43" style="v" sid="JHN 11:43" />وبَعْدْمَا قَالْ هَاذَا، عَيِّطْ بْصُوتْ عَالِي: «لِعَازَرْ، أُخْرُجْ!». <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />وخْرَجْ المَيِّتْ ويْدِيهْ وسَاقِيهْ مْقَمْطِينْ، ووِجْهُو مَلْفُوفْ بْمَنْدِيلَة، يَاخِي قَالِلْهُمْ يَسُوعْ: «نَحِّيوْلُو قْمَايِطْ الكْفَنْ وخَلِّيوَهْ يِمْشِي!».<verse eid="JHN 11:44" /></para>
  <para style="s">مُؤَامْرَة لْقَتْلْ يَسُوعْ</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />وبَرْشَة مِاليْهُودْ الِّي جَاوْ بَاشْ يْعَزِّيْوْ مَرْيِمْ، وشَافُوا شَعْمَلْ يَسُوعْ، أَمْنُوا بِيهْ. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />آمَا فَمَّة شْكُونْ مِنْهُمْ مْشَاوْ لِلْفِرِّيسِيِّينْ وحْكَاوْلْهُمْ عَلِّي عَمْلُو يَسُوعْ. <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />وعَمْلُوا كْبَارْ الكَهَنَة والفِرِّيسِيِّينْ إِجْتِمَاعْ المَجْلِسْ الأَعْلَى، وقَالُوا: «شْنَعْمْلُوا؟ الرَّاجِلْ هَاذَا قَاعِدْ يَعْمِلْ فِي بَرْشَة مُعْجْزَاتْ. <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />إِذَا كَانْ نْخَلِّيوْهْ هَكَّا، النَّاسْ الكُلْ بِشْ يَمْنُوا بِيهْ، ويْجِيوْ الرُّومَانْ ويِخْرْبُولْنَا الهَيْكِلْ وأُمِّتْنَا». <verse eid="JHN 11:48" /><verse number="49" style="v" sid="JHN 11:49" />وقَالْ وَاحِدْ مِنْهُمْ ولِّي هُوَّ قَيَافَا الِّي كَانْ الكَاهِنْ الكْبِيرْ فِي العَامْ هَاذَاكَا: «إِنْتُومَا مَا تَعْرْفُوا حَتَّى شَيْ! <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />ومَاكُمْشْ فَاهْمِينْ الِّي كِي يْمُوتْ وَاحِدْ بَرْكْ فِي عُوضْ الشَّعْبْ، خِيرْ مِلِّي تِدَّمِّرْ الأُمَّة الكُلْ». <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />ومَا قَالِشْ الكْلَامْ هَاذَاكَا مِنْ رَاسُو، آمَا قَالُّو عْلَى خَاطْرُو كَانْ الكَاهِنْ الكْبِيرْ فِي العَامْ هَاذَاكَا، وتْنَبَّأْ الِّي يَسُوعْ بِشْ يْمُوتْ فِي عُوضْ الأُمَّة، <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />ومُشْ فِي عُوضْ الأُمَّة هَاذِيكَا أَكَهَوْ، آمَا بَاشْ يْلِمْ وْلَادْ اللَّهْ المْفَرْقِينْ ويْرُدْهُمْ شَعْبْ وَاحِدْ. <verse eid="JHN 11:52" /><verse number="53" style="v" sid="JHN 11:53" />ومِنْ نْهَارِتْهَا قَرْرُوا قَادِةْ اليْهُودْ بَاشْ يُقْتْلُوهْ.<verse eid="JHN 11:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 11:54" />يَاخِي يَسُوعْ بَطِّلْ مَا عَادِشْ يِمْشِي فِي وِسْطْ اليْهُودْ جْهَارْ، ومْشَى لِبْلَاصَة قْرِيبَة مِالصَّحْرَاء، لِمْدِينَة إِسْمْهَا أَفْرَايِمْ، وقْعَدْ غَادِي هُوَّ وتْلَامِذْتُو.<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />وقْرُبْ عِيدْ الفِصْحْ اليْهُودِي، وطَلْعُوا بَرْشَة نَاسْ مِالأَرْيَافْ لِمْدِينِةْ أُورْشَلِيمْ بَاشْ يَعْمْلُوا فْرَايِضْ التَّطْهِيرْ قْبَلْ مَا يْجِي العِيدْ. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />وكَانُوا يْلَوْجُوا عْلَى يَسُوعْ، ويِسِأْلُوا فِي بْعَضْهُمْ وهُومَا فِي الهَيْكِلْ: «شْنُوَّة رَايْكُمْ؟ زَعْمَة يْجِي لِلْعِيدْ وَلَّا لَا؟». <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />وكْبَارْ الكَهَنَة والفِرِّيسِيِّينْ سْبَقْ وعْطَاوْا أَمْرْ بَاشْ الِّي يَعْرِفْ يَسُوعْ وِينْ، يِعْلِمْ عْلِيهْ، بَاشْ يْشِدُّوهْ.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">عِطْرْ مَرْيِمْ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />قْبَلْ العِيدْ الفِصْحْ بْسِتَّة أَيَّامْ، جَاء يَسُوعْ لْبِيتْ عَنْيَا، وِينْ يُسْكُنْ لِعَازَرْ الِّي قَيْمُو مِالمُوتْ، <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />يِاخِي حَضّْرُولُو العْشَاء. وكَانِتْ مَرْثَا لَاهْيَة بِيهُمْ فِي العْشَاء، وكَانْ لِعَازَرْ وَاحِدْ مِلِّي قَاعْدِينْ يِتْعَشَّاوْ مْعَاهْ. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />وخْذَاتْ مَرْيِمْ نُصْفْ إِيتْرَا مِنْ عِطْرْ النَّارْدِينْ الصَّافِي والغَالِي، ودَهْنِتْ بِيهْ سَاقِينْ يَسُوعْ، ومَسْحِتْهُمْ بِشْعَرْهَا. يَاخِي فَاحِتْ الرِّيحَة فِي الدَّارْ الكُلْ. <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />آمَا وَاحِدْ مِنْ تْلَامِذْتُو الِّي هُوَّ يَهُوذَا الإِسْخَرْيُوطِي الِّي بِشْ يْخُونُو مْبَعِّدْ قَالْ: <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />«عْلَاشْ هَكَّا! كَانْ يْنَجِّمْ يِتْبَاعْ العِطْرْ هَاذَا بْشَهْرِيِّةْ عَامْ كَامِلْ، ويِتِعْطَى لِلْفْقَارَى!». <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />قَالْ الكْلَامْ هَاذَا مُشْ عْلَى خَاطْرُو يْحِنْ عَالفْقَارَى، آمَا عْلَى خَاطْرُو كَانْ سَارِقْ، وصَنْدُوقْ الفْلُوسْ عَنْدُو، وكَانْ يِسْرِقْ مِلِّي يِتْحَطْ فِيهْ. <verse eid="JHN 12:6" /><verse number="7" style="v" sid="JHN 12:7" />قَالْ يَسُوعْ: «أَخْطَاهَا! رَاهِي اسْتَحْفْظِتْ عَالعِطْرْ هَاذَا لِلنْهَارْ الِّي بِشْ يِدْفْنُونِي فِيهْ. <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />الفْقَارَى دِيمَا مْعَاكُمْ، آمَا آنَا مَانِيشْ بِشْ نَبْقَى دِيمَا مْعَاكُمْ».<verse eid="JHN 12:8" /></para>
  <para style="s">مُؤَامْرَة لْقَتْلْ لِعَازَرْ</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />وسَمْعُوا بَرْشَة يْهُودْ الِّي هُوَّ مَوْجُودْ فِي بِيتْ عَنْيَا، وَلَّاوْ جَاوْ مُشْ عْلَى خَاطْرُو هُوَّ أَكَهَوْ، آمَا زَادَا بِشْ يْشُوفُوا لِعَازَرَ الِّي قَيْمُو مِالمُوتْ. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />يَاخِي كْبَارْ الكَهَنَة قَرْرُوا بَاشْ يُقْتْلُوا لِعَازَرَ زَادَا، <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />عْلَى خَاطِرْ فِي جُرْتُو هُوَّ بَرْشَة يْهُودْ بْدَاوْ يِبْعْدُوا عْلِيهُمْ ويَمْنُوا بْيَسُوعْ.<verse eid="JHN 12:11" /></para>
  <para style="s">يَسُوعْ يُدْخُلْ لْأُورْشَلِيمْ</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />ومِنْ غُدْوَة، النَّاسْ الِّي جَاوْ لْعِيدْ الفِصْحْ ولِّي كَانْ عْدَدْهُمْ كْبِيرْ، سَمْعُوا إِنُّو يَسُوعْ فِي طْرِيقُو لْأُورْشَلِيمْ. <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />يَاخِي هَزُّوا سْعَفْ النْخَلْ وخَرْجُوا بَاشْ يِسْتَقْبْلُوهْ، وكَانُوا يْعَيْطُوا:</para>
  <para style="b" vid="JHN 12:13" />
  <para style="q1" vid="JHN 12:13">«أُوصَنَّا!</para>
  <para style="q1" vid="JHN 12:13">مُبَارَكْ الِّي جَايْ بْإِسْمْ الرَّبْ!</para>
  <para style="q2" vid="JHN 12:13">ومُبَارَكْ مَلِكْ إِسْرَائِيلْ!»<verse eid="JHN 12:13" /></para>
  <para style="b" />
  <para style="m">
    <verse number="14" style="v" sid="JHN 12:14" />ولْقَى يَسُوعْ جَحْشْ، ورْكِبْ عْلِيهْ كِيفْ مَاهُو مَكْتُوبْ:<verse eid="JHN 12:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />«مَا تْخَافِشْ يَا بِنْتْ صِهْيَوْنْ،</para>
  <para style="q2" vid="JHN 12:15">المَلِكْ مْتَاعِكْ جَايِكْ رَاكِبْ عْلَى جَحْشْ وِلْدْ بْهِيمَة».<verse eid="JHN 12:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />فِي وَقْتْهَا، التْلَامْذَة مَا فِهْمُوشْ آشْ قَاعِدْ يْصِيرْ. آمَا بَعْدْمَا تْمَجِّدْ يَسُوعْ، تْذَكْرُوا الِّي الآيَة هَاذِي تْكِتْبِتْ عْلِيهْ، ولِّي النَّاسْ عَمْلُوا هَاذَا عْلَى خَاطْرُو. <verse eid="JHN 12:16" /><verse number="17" style="v" sid="JHN 12:17" />والنَّاسْ الِّي كَانُوا مْعَاهْ وَقْتِلِّي قَيِّمْ لِعَازَرَ مِالمُوتْ وخَرْجُو مِالقْبَرْ شِهْدُوا بِلِّي صَارْ. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />وبَرْشَة نَاسْ خَرْجُوا بَاشْ يِسْتَقْبْلُوهْ، عْلَى خَاطِرْهُمْ سَمْعُوا الِّي هُوَّ عْمَلْ المُعْجْزَة هَاذِيكَا. <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />يَاخِي قَالُوا الفِرِّسِيِّينْ لِبْعَضْهُمْ: «شُفْتُوا! هَانَا مَا وْصِلْنَا لْشَيْ. أَهَوْكَا النَّاسْ الكُلْ وَلَّاوْ يْتَبْعُوا فِيهْ!».<verse eid="JHN 12:19" /></para>
  <para style="s">يَسُوعْ يِتْنَبَّأْ بْمُوتُو وقْيَامْتُو</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />وكَانْ مِنْ بِينْ الِّي جَاوْ لْأُورْشَلِيمْ بَاشْ يِعْبْدُوا اللَّهْ فِي العِيدْ نَاسْ مُشْ يْهُودْ، <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />مْشَاوْ لْفِيلِۑُّسْ، الِّي كَانْ مِنْ بِيتْ صَيْدَا فِي مَنْطَقْةْ الجَلِيلْ وقَالُولُو: «يَا سِيدْنَا نْحِبُّوا نْشُوفُوا يَسُوعْ». <verse eid="JHN 12:21" /><verse number="22" style="v" sid="JHN 12:22" />مْشَى فِيلِۑُّسْ وقَالْ لْأَنْدَرَاوُسْ، ومْشَاوْ مْعَ بْعَضْهُمْ وقَالُوا لْيَسُوعْ. <verse eid="JHN 12:22" /><verse number="23" style="v" sid="JHN 12:23" />جَاوِبْهُمْ يَسُوعْ: «جَاء الوَقْتْ الِّي بِشْ يِتْمَجِّدْ فِيهْ إِبْنْ الإِنْسَانْ. <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />الحَقْ الحَقْ نْقُولِلْكُمْ: إِذَا كَانْ القَمْحَةْ مَا اطِّيحِشْ فِي الأَرْضْ وتْمُوتْ، رَاهِي تِبْقَى وَحَّدْهَا. آمَا إِذَا كَانْ مَاتِتْ، رَاهِي تْجِيبْ بَرْشَة قَمْحَاتْ أُخْرِينْ. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />الِّي يْحِبْ حْيَاتُو يِخْسِرْهَا، ولِّي يُنْكُرْهَا فِي الدِّنْيَا هَاذِي رَاهُو يَحْفِظْهَا لِلْحَيَاةْ الأَبَدِيَّة. <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />الِّي يْحِبْ يِخْدِمْنِي يْتَبَّعْنِي، ووِينْ نْكُونْ آنَا يْكُونْ هُوَّ زَادَا. ولِّي يِخْدِمْنِي يِكْرْمُو الآبْ».<verse eid="JHN 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />«آنَا تَوَّا مْشَوِّشْ. آشْ بِشْ نْقُولْ؟ "يَا بَابَا، نَجِّينِي مِالسَّاعَة هَاذِي"؟ لَا! تِي آنَا جِيتْ بِالذِّمَة عْلَى خَاطِرْ السَّاعَة هَاذِي. <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />يَا بَابَا مَجِّدْ إِسْمِكْ!». يَاخِي صُوتْ مِالسْمَاء قَالْ: «مَجِّدْتُو، وبِشْ نْزِيدْ نْمَجْدُو!». <verse eid="JHN 12:28" /><verse number="29" style="v" sid="JHN 12:29" />النَّاسْ الِّي كَانُوا غَادِي وسَمْعُوا الصُّوتْ قَالُوا: «هَاذَا صُوتْ رْعَدْ!» وجْمَاعَة أُخْرِينْ قَالُوا: «كَلْمُو مَلَاكْ!». <verse eid="JHN 12:29" /><verse number="30" style="v" sid="JHN 12:30" />جَاوِبْ يَسُوعْ وقَالْ: «الصُّوتْ هَاذَا مَا جَاشْ لِيَّا آنَا، آمَا لِيكُمْ إِنْتُومَا. <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />تَوَّا جَاء وَقْتْ الحُكْمْ عَالعَالِمْ. تَوَّا بِشْ يِطَّرِّدْ الِّي يُحْكُمْ فِي العَالِمْ هَاذَا. <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />وَقْتِلِّي يِرْفْعُونِي مِالأَرْضْ ونِتْعَلِّقْ، بِشْ نْقَرِّبْ النَّاسْ الكُلْ لِيَّا». <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />قَالْ الكْلَامْ هَاذَا، وكَانْ يُقْصُدْ بِيهْ الطَّرِيقَة الِّي بِشْ يْمُوتْ بِيهَا.<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />جَاوْبُوهْ النَّاسْ: «نَعْرْفُوا مِالشَرِيعَة الِّي المَسِيحْ يِبْقَى حَيْ لِلْأَبَدْ. مَالَا كِيفَاشْ إِنْتِ تْقُولْ: "يِلْزِمْ إِبْنْ الإِنْسَانْ يِتْعَلَّقْ؟" يَاخِي شْكُونُو إِبْنْ الإِنْسَانْ هَاذَا؟». <verse eid="JHN 12:34" /><verse number="35" style="v" sid="JHN 12:35" />قَالِلْهُمْ يَسُوعْ: «النُّورْ بِشْ يْزِيدْ يِبْقَى مْعَاكُمْ مُدَّة قْصِيرَة، مَالَا إِمْشِيوْ مَادَامْ عَنْدْكُمْ النُّورْ، بَاشْ مَا يَهْبِطْشْ عْلِيكُمْ الظْلَامْ. خَاطِرْ الِّي يِمْشِي فِي الظْلَامْ مَا يَعْرِفْشْ عْلَى رُوحُو وِينْ مَاشِي. <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />مَادَامْ النُّورْ مْعَاكُمْ، أَمْنُوا بِالنُّورْ، بَاشْ تْوَلِّيوْ وْلَادْ النُّورْ».</para>
  <para style="p" vid="JHN 12:36">وبَعْدْمَا قَالِلْهُمْ يَسُوعْ الكْلَامْ هَاذَا، مْشَى وتْخَبَّى عْلِيهُمْ.<verse eid="JHN 12:36" /></para>
  <para style="s">اليْهُودْ مَا يَمْنُوشْ بْيَسُوعْ</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37" />ورَغْمِلِّي عْمَلْ بَرْشَة مُعْجْزَاتْ قُدَّامْ عِينِيهُمْ، مَا أَمْنُوشْ بِيهْ، <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />وهَكَّا تْحَقَّقْ الِّي قَالُّو النَّبِيْ إِشَعْيَاءْ:</para>
  <para style="b" vid="JHN 12:38" />
  <para style="q1" vid="JHN 12:38">«يَا رَبْ، شْكُونْ الِّي أَمَّنْ بِكْلَامْنَا؟</para>
  <para style="q2" vid="JHN 12:38">ولِشْكُونْ ظُهْرِتْ قُوِّةْ الرَّبْ؟».<verse eid="JHN 12:38" /></para>
  <para style="b" />
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39" />ومَا نَجْمُوشْ يَمْنُوا، عْلَى خَاطِرْ إِشَعْيَاءْ قَالْ زَادَا:<verse eid="JHN 12:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />«عْمَالْهُمْ عِينِيهُمْ،</para>
  <para style="q2" vid="JHN 12:40">وقَسَّالْهُمْ قْلُوبْهُمْ،</para>
  <para style="q1" vid="JHN 12:40">بَاشْ مَا يْشُوفُوشْ بْعِينِيهُمْ،</para>
  <para style="q2" vid="JHN 12:40">ومَا يِفْهْمُوشْ بِقْلُوبْهُمْ،</para>
  <para style="q1" vid="JHN 12:40">ومَا يْتُوبُوشْ بَاشْ نِشْفِيهُمْ».<verse eid="JHN 12:40" /></para>
  <para style="b" />
  <para style="m">
    <verse number="41" style="v" sid="JHN 12:41" />قَالْ إِشَعْيَاءْ الكْلَامْ هَاذَا وَقْتِلِّي شَافْ مَجْدْ يَسُوعْ وحْكَى عْلِيهْ.<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />بِالرَّغْمْ مِنْ هَاذَا الكُلْ، بَرْشَة مِنْ قَادِةْ اليْهُودْ أَمْنُوا بْيَسُوعْ. آمَا مَا اعْتَرْفُوشْ بِيهْ جْهَارْ، عْلَى خَاطِرْهُمْ خَايْفِينْ لَا الفِرِّيسِيِّينْ يْطَرْدُوهُمْ مِالمَعْبِدْ. <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />وحَبُّوا يْرَضِّيوْ النَّاسْ أَكْثِرْ مِلِّي يْرَضِّيوْ اللَّهْ.<verse eid="JHN 12:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />يَاخِي قَالْ يَسُوعْ بْصُوتْ عَالِي: «الِّي يَمِّنْ بِيَّا، مَا يَمِّنْشْ بِيَّا آنَا بَرْكْ، آمَا يَمِّنْ بِلِّي بْعَثْنِي زَادَا. <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />ولِّي يْرَانِي يْرَى الِّي بْعَثْنِي. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />آنَا جِيتْ نُورْ لِلْعَالِمْ، بَاشْ الِّي يَمِّنْ بِيَّا مَا يَبْقَاشْ فِي الظْلَامْ. <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />ولِّي يِسْمَعْ كْلَامِي ومَا يْطَبْقُوشْ، مَا نُحْكُمْشْ عْلِيهْ، عْلَى خَاطِرْ جِيتْ بِشْ نْجِّي العَالِمْ، مُشْ بَاشْ نُحْكُمْ عْلِيهْ. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />الِّي مَا يِقْبِلْنِيشْ ومَا يِقْبِلْشْ كْلَامِي، عَنْدُو شْكُونْ يُحْكُمْ عْلِيهْ: الكْلَامْ الِّي قُلْتُو هُوَّ الِّي يُحْكُمْ عْلِيهْ نْهَارْ الحْسَابْ، <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />عْلَى خَاطِرْ آنَا مَا قُلْتْ حَتَّى شَيْ مِنْ عَنْدِي، آمَا الآبْ الِّي بْعَثْنِي وَصَّانِي آشْ بَاشْ نْقُولْ ونِتْكَلِّمْ. <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />وآنَا نَعْرِفْ الِّي وْصِيْتُو تَعْطِي الحَيَاةْ الأَبَدِيَّة. والكْلَامْ الِّي نْقُولْ فِيهْ آنَا، هُوَّ كِيمَا قَالْهُولِي الآبْ».<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">يَسُوعْ يَغْسِلْ سَاقِينْ تْلَامِذْتُو</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />قْبَلْ عِيدْ الفِصْحْ، يَسُوعْ الِّي كَانْ يَعْرِفْ إِنُّو سَاعْتُو جَاتْ بَاشْ يِمْشِي مِالدِّنْيَا هَاذِي لِلْآبْ، حَبْ الِّي تَابْعِينُو فِي الدِّنْيَا هَاذِي، حَبْهُمْ لْأَقْصَى دَرْجَة. <verse eid="JHN 13:1" /><verse number="2" style="v" sid="JHN 13:2" />ووَقْتِلِّي كَانْ يِتْعَشَّى مْعَ تْلَامِذْتُو، إِبْلِيسْ كَانْ حَاطِطْ فِي قَلْبْ يَهُوذَا وِلْدْ سِمْعَانْ الإِسْخَرْيُوطِي إِنُّو يْخُونُو. <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />ويَسُوعْ كَانْ يَعْرِفْ الِّي الآبْ عْطَاهْ سُلْطَة عْلَى كُلْ شَيْ، وإِنُّو جَاء مِنْ عَنْدْ اللَّهْ وبِشْ يِرْجَعْ لِلَّهْ. <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />وَلَّا قَامْ عَالعْشَاء، ونَحَّى بَرْنُوسُو، وخْذَا مَنْشْفَة واتْحَزِّمْ بِيهَا، <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />وصَبْ مَاء فِي بَانُو، وبْدَا يَغْسِلْ فِي سَاقِينْ التْلَامْذَة ويْنَشِّفْ فِيهُمْ بِالمَنْشْفَة المِتْحَزِّمْ بِيهَا. <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />وَقْتِلِّي وْصُلْ لْسِمْعَانْ بُطْرُسْ، قَالُّو سِمْعَانْ: «يَاسِيدِي، إِنْتِ تَغْسَلِّي سَاقَيَّا؟». <verse eid="JHN 13:6" /><verse number="7" style="v" sid="JHN 13:7" />جَاوْبُو يَسُوعْ: «إِنْتِ تَوَّا مَاكِشْ فَاهِمْ آشْ قَاعِدْ نَعْمِلْ، آمَا تَوْ تِفْهِمْ مْبَعِّدْ». <verse eid="JHN 13:7" /><verse number="8" style="v" sid="JHN 13:8" />قَالُّو بُطْرُسْ: «مُسْتَحِيلْ تَغْسِلِّي سَاقَيَّا». جَاوْبُو يَسُوعْ: «إِذَا مَا نَغْسِلِّكْشْ سَاقِيكْ مُشْ بِشْ تْكُونْ فَمَّة حَاجَة تُرْبْطِكْ بِيَّا». <verse eid="JHN 13:8" /><verse number="9" style="v" sid="JHN 13:9" />يَاخِي قَالُّو سِمْعَانْ بُطْرُسْ: «مَالَا يَا سِيدِي، مُشْ كَانْ سَاقَيَّا بَرْكْ، آمَا يْدَيَّا ورَاسِي زَادَا». <verse eid="JHN 13:9" /><verse number="10" style="v" sid="JHN 13:10" />قَالُّو يَسُوعْ: «الِّي يَغْسِلْ بَدْنُو يْوَلِّي الكُلُّو طَاهِرْ، ومَا يِسْتْحَقْ كَانْ لِغْسِيلْ سَاقِيهْ. إِنْتُومَا طَاهْرِينْ، آمَا مُشْ الكُلْكُمْ». <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />ويَسُوعْ كَانْ يَعْرِفْ شْكُونْ الِّي بِشْ يْخُونُو. هَاذَاكَا عْلَاشْ قَالْ: «مَاكُمْشْ الكُلْكُمْ طَاهْرِينْ».<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />وبَعْدْمَا غْسَلِّلْهُمْ سَاقِيهُمْ، لْبِسْ بَرْنُوسُو ورْجَعْ لِبْلَاصْتُو، وقَالِلْهُمْ: «يَاخِي فَاهْمِينْ الِّي عْمَلْتْهُولْكُمْ؟ <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />إِنْتُومَا تْنَادِيوْلِي يَا مُعَلِّمْ ويَا سِيدِي، وعَنْدْكُمْ الحَقْ عْلَى خَاطِرْنِي آنَا مُعَلِّمْ وسَيِّدْ. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />إِذَا كَانْ آنَا المُعَلِّمْ والسَيِّدْ غْسَلْتِلْكُمْ سَاقِيكُمْ، مَالَا إِنْتُومَا زَادَا يِلْزِمْكُمْ تَغْسْلُوا سَاقِينْ بْعَضْكُمْ. <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />وهَانِي كُنْتِلْكُمْ مِثَالْ بَاشْ اتَّبْعُوهْ، وتَعْمْلُوا إِنْتُومَا زَادَا كِيمَا عْمَلْتِلْكُمْ. <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />الحَقْ الحَقْ نْقُولِلْكُمْ: العَبْدْ مُشْ أَعْظِمْ مِنْ سِيدُو، ولَا المَرْسُولْ أَعْظِمْ مِلِّي بَعْثُو. <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />مَادَامْكُمْ عْرَفْتُوا هَاذَا، صَحَّة لِيكُمْ كَانْ اطَّبْقُوهْ.<verse eid="JHN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />«آنَا مَانِيشْ نَحْكِي عْلِيكُمْ الكُلْ، آنَا نَعْرِفْ الِّي اخْتَرْتْهُمْ. آمَا لَازِمْ يْتِمْ الِّي قَالِتُّو الكْتُبْ المُقَدْسَة: "الِّي كْلَا خُبْزِي، دَارْ عْلِيَّا".<verse eid="JHN 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 13:19" />«نْقُولِلْكُمْ هَاذَا تَوَّا قْبَلْ مَا يْصِيرْ، بَاشْ وَقْتِلِّي يْصِيرْ تَمْنُوا الِّي آنَا هُوَّ. <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />الحَقْ الحَقْ نْقُولِلْكُمْ: الِّي يِقْبِلْ الِّي نَبْعْثُو يِقْبِلْنِي، ولِّي يِقْبِلْنِي، يِقْبِلْ الِّي بْعَثْنِي».<verse eid="JHN 13:20" /></para>
  <para style="s">يَسُوعْ يِتْنَبَّأْ الِّي يَهُوذَا بِشْ يْخُونُو</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />وبَعْدْمَا قَالْ يَسُوعْ الكْلَامْ هَاذَا، تْقَلِّقْ وقَالْ: «الحَقْ الحَقْ نْقُولِلْكُمْ: وَاحِدْ مِنْكُمْ بِشْ يْخُونِّي».<verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />يَاخِي خَزْرُوا التْلَامْذَة لِبْعَضْهُمْ وهُومَا حَايْرِينْ مُشْ عَارْفِينْ فِي شْكُونْ كَانْ يُقْصُدْ بِكْلَامُو. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />ووَاحِدْ مِالتْلَامْذَة، الِّي يَسُوعْ يْحِبُّو، كَانْ مِتَّكِّي بْجَنْبُو. <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />هْمِزْلُو سِمْعَانْ بُطْرُسْ بَاشْ يِسْأْلُو فِي شْكُونْ كَانْ يُقْصُدْ. <verse eid="JHN 13:24" /><verse number="25" style="v" sid="JHN 13:25" />ومَالْ التِّلْمِيذْ عْلَى صْدِرْ يَسُوعْ وسِأْلُو: «شْكُونُو هُوَّ، يَا سِيدِي؟» <verse eid="JHN 13:25" /><verse number="26" style="v" sid="JHN 13:26" />جَاوِبْ يَسُوعْ: «هُوَّ الِّي نْغَطِّسْلُو اللُّقْمَة ونَعْطِيهَالُو!» وغَطِّسْ يَسُوعْ ڨِدْمِةْ الخُبْزْ وعْطَاهَا لْيَهُوذَا وِلْدْ سِمْعَانْ الإِسْخَرْيُوطِي. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />وبَعْدْمَا كْلَاهَا دْخَلْ فِيهْ الشِّيطَانْ. يَاخِي قَالُّو يَسُوعْ: «الِّي نَاوِي تَعْمْلُو، أَعْمْلُو فِيسَعْ». <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />ومَا فْهِمْ حَتَّى وَاحِدْ مِلِّي يِتْعَشَّاوْ مْعَاهْ عْلَاشْ قَالُّو الكْلَامْ هَاذَاكَا. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />وعْلَى خَاطِرْ يَهُوذَا كَانْ مَسْؤُولْ عْلَى صَنْدُوقْ الفْلُوسْ، مْشَى فِي بَالْهُمْ الِّي يَسُوعْ وَصَّاهْ بَاشْ يِشْرِي الِّي يِسْتْحَقُّوهْ لِلْعِيدْ، وَلَّا بَاشْ يَعْطِي حَاجَة لِلْفْقَارَى. <verse eid="JHN 13:29" /><verse number="30" style="v" sid="JHN 13:30" />وكْلَا يَهُوذَا الڨِدْمَة وخْرَجْ بِالوَقْتْ. وكَانِتْ الدِّنْيَا لِيلْ.<verse eid="JHN 13:30" /></para>
  <para style="s">حِبُّوا بْعَضْكُمْ كِيفْ مَا آنَا حَبِّيتْكُمْ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />ووَقْتِلِّي خْرَجْ يَهُوذَا قَالْ يَسُوعْ: «تَوَّا تْمَجِّدْ إِبْنْ الإِنْسَانْ، وتْمَجِّدْ اللَّهْ فِيهْ. <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />ومَادَامْ اللَّهْ تْمَجِّدْ فِيهْ، رَاهُو اللَّهْ بِيدُو بِشْ يْمَجِّدْ إِبْنْ الإِنْسَانْ زَادَا، وبِشْ يْمَجْدُو عْلَى قْرِيبْ. <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" />يَا وْلَادِي، آنَا بِشْ نْزِيدْ نَبْقَى مْعَاكُمْ مُدَّة قْصِيرَة. بِشْ تْلَوْجُوا عْلِيَّا، آمَا الِّي قُلْتُو لِلْيْهُودْ نْقُولْهُولْكُمْ إِنْتُومَا تَوَّا: "رَاكُمْ مَا تْنَجْمُوشْ تْجِيوْ لِلْبْلَاصَة الِّي آنَا مَاشِيلْهَا". <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" />نْوَصِّيكُمْ وْصِيَّة جْدِيدَة: حِبُّوا بْعَضْكُمْ. كِيفْ مَا آنَا حَبِّيتْكُمْ إِنْتُومَا زَادَا حِبُّوا بْعَضْكُمْ. <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />إِذَا كَانْ عَنْدْكُمْ مْحَبَّة لِبْعَضْكُمْ، النَّاسْ الكُلْ بِشْ يَعْرْفُوا الِّي إِنْتُومَا تْلَامِذْتِي».<verse eid="JHN 13:35" /></para>
  <para style="s">يَسُوعْ يِتْنَبَّأْ الِّي بُطْرُسْ بِشْ يُنْكْرُو</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />قَالُّو سِمْعَانْ بُطْرُسْ: «يَا سِيدِي، إِنْتِ وِينْ مَاشِي؟». جَاوْبُو يَسُوعْ: « تَوَّا مَا تْنَجِّمْشْ اتَّبَّعْنِي لِلْبْلَاصَة الِّي مَاشِيلْهَا، آمَا يْجِيكْ نْهَارْ واتَّبَّعْنِي». <verse eid="JHN 13:36" /><verse number="37" style="v" sid="JHN 13:37" />يَاخِي قَالُّو بُطْرُسْ: «يَا سِيدِي، عْلَاشْ مَا انَّجَّمْشْ نْتَبْعِكْ تَوَّا؟ آنَا مُسْتْعَدْ نْمُوتْ عْلَى خَاطْرِكْ». <verse eid="JHN 13:37" /><verse number="38" style="v" sid="JHN 13:38" />جَاوْبُو يَسُوعْ: « إِنْتِ مُسْتْعَدْ بَاشْ تْمُوتْ عْلَى خَاطْرِي؟ الحَقْ الحَقْ نْقُلِّكْ: مَا يْصِيحْ السَّرْدُوكْ كَانْ مَا تْكُونْ نْكَرْتْنِي ثْلَاثَة مَرَّاتْ».<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">يَسُوعْ هُوَّ الطْرِيقْ والحَقْ والحَيَاةْ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />«مَا تْخَلِّيوْشْ قْلُوبْكُمْ تِتْحَيِّرْ. إِنْتُومَا تَمْنُوا بِاللَّهْ، مَالَا أَمْنُوا بِيَّا زَادَا. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />عَنْدْ بَابَا فَمَّة بَرْشَة دْيَارْ. كَانْ جَاء مُشْ بِالحَقْ، رَانِي قُلْتِلْكُمْ. وآنَا مَاشِي بَاشْ نْحَضْرِلْكُمْ بْلَاصَة. <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />وكِي نِمْشِي نْحَضْرِلْكُمْ بْلَاصَة، نِرْجَعْ ونْهِزْكُمْ، بَاشْ تْكُونُوا وِينْ مَا نْكُونْ آنَا. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />وإِنْتُومَا تَعْرْفُوا الطْرِيقْ الِّي يْوَصِّلْ لِلْبْلَاصَة الِّي آنَا مَاشِيلْهَا». <verse eid="JHN 14:4" /><verse number="5" style="v" sid="JHN 14:5" />قَالُّو تُومَا: «يَا سِيدِي، أَحْنَا مَا نَعْرْفُوكْشْ لْوِينْ مَاشِي، كِيفَاشْ تْحِبْنَا نَعْرْفُوا الطْرِيقْ؟». <verse eid="JHN 14:5" /><verse number="6" style="v" sid="JHN 14:6" />قَالُّو يَسُوعْ: «آنَا هُوَّ الطْرِيقْ والحَقْ والحَيَاةْ، حَتَّى حَدْ مَا يْجِي لِلْآبْ إِلَّا عْلَى طْرِيقِي. <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />كَانْ عْرَفْتُونِي رَاكُمْ عْرَفْتُوا بَابَا زَادَا. ومِنْ تَوَّا إِنْتُومَا تَعْرْفُوهْ وزَادَا شُفْتُوهْ».<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />قَالُّو فِيلِۑُّسْ: «يَا سِيدِي، وَرِّينَا الآبْ وهَاذَا يِكْفِينَا». <verse eid="JHN 14:8" /><verse number="9" style="v" sid="JHN 14:9" />قَالُّو يَسُوعْ: «آنَا مْعَاكُمْ الوَقْتْ هَاذَا الكُلْ، ومَا عْرَفْتْنِيشْ يَا فِيلِۑُّسْ؟ الِّي شَافْنِي رَاهُو شَافْ الآبْ، مَالَا كِيفَاشْ تْقُولْ "وَرِّينَا الآبْ"؟ <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />يَاخِي مَا تَمِّنْشْ الِّي آنَا فِي الآبْ والآبْ فِيَّا؟ الكْلَامْ الِّي نْقُلْكُمْ فِيهْ مُشْ مِنْ عَنْدِي، والأَعْمَالْ الِّي نَعْمِلْهَا رَاهُو يَعْمِلْ فِيهَا الآبْ الِّي فِيَّا. <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />صَدْقُونِي كِي نْقُلْكُمْ: آنَا فِي الآبْ والآبْ فِيَّا. وَلَّا عَالأَقَلْ صَدْقُونِي عْلَى خَاطِرْ الأَعْمَالْ الِّي عْمَلْتْهَا. <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />الحَقْ الحَقْ نْقُلْكُمْ: الِّي يَمِّنْ بِيَّا هُوَّ زَادَا يَعْمِلْ الأَعْمَالْ الِّي نَعْمِلْ فِيهَا، ويَعْمِلْ حَتَّى أَعْظِمْ مِنْهَا، عْلَى خَاطِرْنِي مَاشِي لْبَابَا. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />كُلْ مَا تُطْلْبُوهْ بْإِسْمِي نَعْمْلُو، بَاشْ يِتْمَجِّدْ الآبْ عْلَى طْرِيقْ الإِبْنْ. <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />وكَانْ تُطْلْبُوا مِنِّي حَاجَة بْإِسْمِي، نَعْطِيهَالْكُمْ».<verse eid="JHN 14:14" /></para>
  <para style="s">الرُّوحْ القُدُسْ المُعِينْ</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />«كَانْ تْحِبُّونِي، تَوَّا اطَّبْقُوا الِّي وَصِّيتْكُمْ بِيهْ <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />وآنَا بِشْ نُطْلُبْ مِالآبْ يَعْطِيكُمْ وَاحِدْ آخَرْ يْعَاوِنْكُمْ، ويِبْقَى مْعَاكُمْ لِلْأَبَدْ. <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />هُوَّ رُوحْ الحَقْ الِّي نَاسْ العَالِمْ هَاذَا مَا يْنَجْمُوشْ يِقْبْلُوهْ. عْلَى خَاطِرْ مَا يْشُوفُوهِشْ ومَا يَعْرْفُوهِشْ. آمَا إِنْتُومَا تَعْرْفُوهْ عْلَى خَاطْرُو مْعَاكُمْ وبِشْ يْكُونْ فِيكُمْ. <verse eid="JHN 14:17" /><verse number="18" style="v" sid="JHN 14:18" />مَانِيشْ بِشْ نْخَلِّيكُمْ يْتَامَى آمَا تَوَّا نَرْجْعِلْكُمْ. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />بَعْدْ شْوَيَّة، النَّاسْ الِّي فِي العَالِمْ هَاذَا مَا عَادِشْ بِشْ يْشُوفُونِي، آمَا إِنْتُومَا تْشُوفُونِي. وعْلَى خَاطِرْنِي آنَا حَيْ، إِنْتُومَا زَادَا بِشْ تَحْيَاوْ. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />وفِي النْهَارْ هَاذَاكَا بِشْ تَعْرْفُوا الِّي آنَا فِي بَابَا، ولِّي إِنْتُومَا فِيَّا وآنَا فِيكُمْ. <verse eid="JHN 14:20" /><verse number="21" style="v" sid="JHN 14:21" />الِّي يِقْبِلْ الوْصَايَا مْتَاعِي ويَعْمِلْ بِيهَا، هَاذَاكَا هُوَّ الِّي يْحِبْنِي. ولِّي يْحِبْنِي يْحِبُّو بَابَا، وآنَا زَادَا نْحِبُّو ونْظَهَّرْلُو رُوحِي».<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />يَاخِي قَالُّو يَهُوذَا آخِرْ، مُشْ يَهُوذَا الإِسْخَرْيُوطِي: «يَا سِيدِي، كِيفَاشْ تْظَهْرِلْنَا رُوحِكْ ومَا تْظَهَّرْهَاشْ لِلْعَالِمْ؟». <verse eid="JHN 14:22" /><verse number="23" style="v" sid="JHN 14:23" />جَاوْبُو يَسُوعْ: «الِّي يْحِبْنِي يْطِيعْ كْلَامِي، وبَابَا زَادَا يْحِبُّو، ونْجِيُوهْ ونُسْكْنُوا مْعَاهْ. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />ولِّي مَا يْحِبْنِيشْ مَا يِسْمَعْشْ كْلَامِي. والكْلَامْ الِّي سْمَعْتُوهْ مُشْ مِنْ عَنْدِي، آمَا مِنْ عَنْدْ الآبْ الِّي بْعَثْنِي.<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />«قُلْتِلْكُمْ هَاذَا الكُلْ وآنَا مَزِّلْتْ مْعَاكُمْ. <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />آمَا المُعِينْ، الِّي هُوَّ الرُّوحْ القُدُسْ الِّي بِشْ يَبْعْثُو الآبْ بْإِسْمِي، هُوَّ الِّي بِشْ يْعَلِّمْكُمْ كُلْ شَيْ، ويْذَكَّرْكُمْ بِلِّي قُلْتْهُولْكُمْ الكُلْ.<verse eid="JHN 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />«نْخَلِّيلْكُمْ سَلَامْ، نَعْطِيكُمْ سَلَامِي. السَّلَامْ الِّي نَعْطِيهُولْكُمْ آنَا، مُشْ كِيفْ الِّي يَعْطِيهْ العَالِمْ. مَالَا مَا تْخَلِّيوْشْ قْلُوبْكُمْ تِتْحَيِّرْ وتْخَافْ. <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />إِنْتُومَا سْمَعْتُونِي كِي قُلْتِلْكُمْ: آنَا مَاشِي وبِشْ نَرْجْعِلْكُمْ. كَانْكُمْ تْحِبُّونِي تَوَّا تِفْرْحُوا الِّي آنَا مَاشِي لِلْآبْ، عْلَى خَاطِرْ الآبْ أَعْظِمْ مِنِّي. <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />قُلْتِلْكُمْ الحَاجَاتْ هَاذِي قْبَلْ مَا تْصِيرْ، بَاشْ وَقْتِلِّي تْصِيرْ تَمْنُوا. <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />مَا عَادِشْ بِشْ نِتْكَلَّمْ مْعَاكُمْ بَرْشَة، عْلَى خَاطِرْ الِّي يُحْكُمْ فِي العَالِمْ هَاذَا، بِشْ يْجِي. ومَا عَنْدُو حَتَّى سُلْطَة عْلِيَّا، <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />آمَا لَازِمْ النَّاسْ الِّي فِي العَالِمْ هَاذَا يَعْرْفُوا الِّي آنَا نْحِبْ الآبْ ونَعْمِلْ الِّي وَصَّانِي عْلِيهْ. قُومُوا نِمْشِيوْ مِنْ هْنَا!»<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">يَسُوعْ هُوَّ العِنْبَة الحَقِيقِيَّة</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />«آنَا هُوَّ العِنْبَة الحَقِيقِيَّة وبَابَا هُوَّ الِّي لَاهِي بِالعْنِبْ. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />كُلْ عُرْفْ فِيَّا مَا يْجِيبِشْ غَلَّة يْقُصُّو، ولِّي يْجِيبْ غَلَّة يُزْبْرُو بَاشْ يْجِيبْ غَلَّة أَكْثِرْ. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />إِنْتُومَا تَوَّا طَاهْرِينْ عْلَى خَاطِرْ الكْلَامْ الِّي قُلْتْهُولْكُمْ. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />إِثْبْتُوا فِيَّا كِيمَا نِثْبِتْ فِيكُمْ. وكِيمَا العُودْ مَا يْنَجِّمْ يْجِيبْ غَلَّة كَانْ مَا يِثْبِتْ فِي العِنْبَة، إِنْتُومَا زَادَا مَا تْنَجْمُوا تْجِيبُوا غَلَّة كَانْ مَا تِثْبْتُوا فِيَّا.<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />«آنَا العِنْبَة وإِنْتُومَا الأَعْرَافْ، الِّي يِثْبِتْ فِيَّا وآنَا نِثْبِتْ فِيهْ، يْجِيبْ بَرْشَة غَلَّة. عْلَى خَاطِرْ، بْلَاشْ بِيَّا مَا تْنَجْمُوا تَعْمْلُوا حَتَّى شَيْ. <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />الِّي مَا يِثْبِتْشْ فِيَّا، يِتْرْمَى لْبَرَّا كِالعُرْفْ اليَابِسْ. والأَعْرَافْ اليَابْسَة تِتْلَمْ وتِتْرْمَى فِي النَّارْ بَاشْ تِتْحْرَقْ. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />كَانْ تِثْبْتُوا فِيَّا ويِثْبِتْ كْلَامِي فِيكُمْ، تُطْلْبُوا الِّي تْحِبُّوا عْلِيهْ تَاخْذُوهْ. <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />وَقْتِلِّي تْجِيبُوا بَرْشَة غَلَّة، هَاذَا يْمَجِّدْ بَابَا، وهَكَّا تْوَرِّيوْا الِّي إِنْتُومَا تْلَامِذْتِي بِالحَقْ.<verse eid="JHN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 15:9" />«كِيفْ مَا حَبْنِي الآبْ آنَا زَادَا حَبِّيتْكُمْ، مَالَا إِثْبْتُوا فِي مْحَبْتِي. <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />كَانْ اطِّيعُوا الوْصَايَا مْتَاعِي، تِثْبْتُوا فِي مْحَبْتِي، كِيفْ مَا آنَا عْمَلِتْ بِالوْصَايَا مْتَاعْ بَابَا، ونِثْبِتْ فِي مْحَبْتُو. <verse eid="JHN 15:10" /><verse number="11" style="v" sid="JHN 15:11" />قُلْتِلْكُمْ هَاذَا بَاشْ تْدُومْ فَرْحْتِي فِيكُمْ، وتْكُونْ فَرْحِتْكُمْ كَامْلَة. <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />هَاذِي هِيَّ وْصِيْتِي: حِبُّوا بْعَضْكُمْ كِيفْ مَا آنَا حَبِّيتْكُمْ. <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />مَا فَمَّاشْ مْحَبَّة أَكْبِرْ مِنْ إِنُّو الوَاحِدْ يْضَحِّي بِحْيَاتُو عْلَى خَاطِرْ حْبَابُو. <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />إِنْتُومَا حْبَابِي كَانْ تَعْمْلُوا الِّي نْوَصِّيكُمْ بِيهْ. <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />مَا عَادِشْ نْسَمِّيكُمْ عَبِيدْ، عْلَى خَاطِرْ العَبْدْ مَا يَعْرِفْشْ آشْ يَعْمِلْ سِيدُو. آمَا سَمِّيتْكُمْ حْبَابِي، عْلَى خَاطِرْنِي حْكِيتِلْكُمْ عَلِّي سْمَعْتُو مِنْ عَنْدْ بَابَا الكُلْ. <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />مُشْ إِنْتُومَا الِّي خْتَرْتُونِي، آنَا الِّي خْتَرْتْكُمْ وكَلَّفْتْكُمْ بَاشْ تِمْشِيوْ وتُثْمْرُوا وثْمَرْكُمْ يْدُومْ. وَقْتْهَا يَعْطِيكُمْ الآبْ كُلْ مَا تُطْلْبُوهْ بْإِسْمِي. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />وهَاذِي هِيَّ وْصِيْتِي: حِبُّوا بْعَضْكُمْ».<verse eid="JHN 15:17" /></para>
  <para style="s">يَسُوعْ يْنَبَّهْ تْلَامِذْتُو</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />«وكَانْ كْرَهْكُمْ العَالِمْ، أَعْرْفُوا الِّي هُوَّ كْرَهْنِي قْبَلْكُمْ. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />كَانْ جِيتُوا مِالعَالِمْ، رَاهُو العَالِمْ يْحِبْكُمْ كِيمَا يْحِبْ الِّي تَابْعِينُو، آمَا عْلَى خَاطِرْ آنَا خْتَرْتْكُمْ مِالعَالِمْ، إِنْتُومَا مَا عَادِشْ تَابْعِينُو، هَاذَاكَا عْلَاشْ هُوَّ يَكْرَهْكُمْ. <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />تْذَكْرُوا الكْلَامْ الِّي قُلْتْهُولْكُمْ: "العَبْدْ مُشْ أَعْظِمْ مِنْ سِيدُو". كَانْ إِضْطَهْدُونِي رَاهُمْ بِشْ يِضْطَهْدُوكُمْ، وكَانْ سَمْعُوا كْلَامِي، رَاهُمْ بِشْ يِسْمْعُوا كْلَامْكُمْ. <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />هُومَا بِشْ يَعْمْلُوا فِيكُمْ هَاذَا الكُلْ عْلَى خَاطِرْ إِسْمِي، خَاطِرْهُمْ مَا يَعْرْفُوشْ الِّي بْعَثْنِي. <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />كَانْ مَا جِيتِشْ وكَلِّمْتْهُمْ، رَاهُو مَا عْلِيهُمْ حَتَّى ذَنْبْ. آمَا تَوَّا مَا عَنْدْهُمْ حَتَّى عُذْرْ عْلَى ذْنُوبْهُمْ. <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />الِّي يَكْرَهْنِي يَكْرَهْ بَابَا زَادَا. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />كَانْ مَا جِيتِشْ عْمَلْتْ قُدَّامْهُمْ مُعْجْزَاتْ الِّي حَتَّى حَدْ مَا عْمَلْهَا، رَاهُو مَا عْلِيهُمْ حَتَّى ذَنْبْ. آمَا هُومَا شَافُوا، ومْعَ هَاذَا كَرْهُونِي وكَرْهُوا بَابَا. <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />آمَا هَاذَا صَارْ بَاشْ يْتِمْ المَكْتُوبْ فِي الشَّرِيعَة مْتَاعْهُمْ: "كَرْهُونِي مِنْ غِيرْ سْبَبْ".<verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />«ووَقْتِلِّي يْجِي المُعِينْ الِّي بَاشْ نَبْعَثْهُولْكُمْ مِنْ عَنْدْ الآبْ، يَعْنِي رُوحْ الحَقْ الِّي يْجِي مِنْ عَنْدْ الآبْ، هُوَّ يِشْهِدْلِي. <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />وإِنْتُومَا زَادَا بِشْ تِشْهْدُولِي، عْلَى خَاطِرْكُمْ مْعَايَا مِالأُوِّلْ».<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="s">الرُّوحْ القُدُسْ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />«قُلْتِلْكُمْ الكْلَامْ هَاذَا بَاشْ مَا تِتْصَدْمُوشْ وبَاشْ إِيمَانْكُمْ مَا يُضْعُفْشْ. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />بِشْ يْطَرْدُوكُمْ مِنْ مْعَابِدْ اليْهُودْ. وبِشْ يْزِيدْ يْجِي وَقْتْ، يِمْشِي فِي بَالْ الِّي يُقْتُلْكُمْ الِّي هُوَّ قَاعِدْ يْرَضِّي فِي اللَّهْ. <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />وهُومَا يَعْمْلُوا فِي هَاذَا عْلَى خَاطِرْهُمْ لَا عَرْفُوا بَابَا ولَا عَرْفُونِي. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />آمَا هَانِي قُلْتِلْكُمْ عْلَى هَاذَا، بَاشْ كِي يْصِيرْ، تِتْذَكْرُوا كَلَامِي. مَا قُلْتْهُولْكُمْشْ مِالأُوِّلْ عْلَى خَاطِرْنِي كُنْتْ مْعَاكُمْ. <verse eid="JHN 16:4" /><verse number="5" style="v" sid="JHN 16:5" />آمَا تَوَّا، آنَا رَاجَعْ لِلِّي بْعَثْنِي، وحَتَّى حَدْ مِنْكُمْ مَا سْأَلْنِي: "وِينْ مَاشِي؟". <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />آمَا وَقْتِلِّي قُلْتِلْكُمْ الكْلَامْ هَاذَا، قْلُوبْكُمْ تِمْلَاتْ بِالحُزْنْ. <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />نْقُولِلْكُمْ الحَقْ، كَانْ نِمْشِي خِيرِلْكُمْ. عْلَى خَاطِرْ كَانْ مَا نِمْشِيشْ، مَا يْجِيكُمْشْ المُعِينْ. آمَا كَانْ نِمْشِي نَبْعَثْهُولْكُمْ. <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />ووَقْتِلِّي يْجِي، يْبَيِّنْ لْنَاسْ العَالِمْ الِّي هُومَا غَالْطِينْ فِي مَا يْخُصْ الذْنُوبْ والصَّلَاحْ والحْسَابْ: <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />فِي مَا يْخُصْ الذْنُوبْ، رَاهُو عْلَى خَاطِرْهُمْ مَا يَمْنُوشْ بِيَّا، <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />وفِي مَا يْخُصْ الصَّلَاحْ، رَاهُو عْلَى خَاطِرْنِي رَاجَعْ لِلْآبْ ومَا عَادِشْ بِشْ تْشُوفُونِي، <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />وفِي مَا يْخُصْ الحْسَابْ، رَاهُو عْلَى خَاطِرْ الِّي يُحْكُمْ فِي العَالِمْ هَاذَا مَحْكُومْ عْلِيهْ.<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />«مَزَّالْ عَنْدِي بَرْشَة كْلَامْ نْحِبْ نْقُولْهُولْكُمْ، آمَا رَاكُمْ تَوَّا مَا تْنَجْمُوشْ تِتْحَمْلُوهْ. <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />ووَقْتِلِّي يْجِي رُوحْ الحَقْ، بِشْ يْدِلْكُمْ لِلْحَقْ الكُلْ، عْلَى خَاطْرُو مُشْ بِشْ يْقُولْ حَتَّى شَيْ مِنْ عَنْدُو، آمَا بِشْ يِتْكَلِّمْ بِلِّي يِسْمْعُو وبِشْ يَحْكِيلْكُمْ عَالحَاجَاتْ الِّي بِشْ تْصِيرْ. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />وبِشْ يْمَجِّدْنِي عْلَى خَاطِرْ الكْلَامْ الِّي بِشْ يْقُولْهُولْكُمْ جَايْ مِنْ عَنْدِي. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />الِّي عَنْدْ الآبْ الكُلْ هُوَّ لِيَّا. هَاذَاكَا عْلَاشْ قُلْتِلْكُمْ: الكْلَامْ الِّي بِشْ يْقُولْهُولْكُمْ جَايْ مِنْ عَنْدِي.<verse eid="JHN 16:15" /></para>
  <para style="s">حُزْنْ التْلَامْذَة بِشْ يْوَلِّي فَرْحَة</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />«بَعْدْ شْوَيَّة، مَاكُمْشْ بِشْ تْشُوفُونِي، ومْبَعْدْهَا بِشْوَيَّة، تِرْجْعُوا تْشُوفُونِي». <verse eid="JHN 16:16" /><verse number="17" style="v" sid="JHN 16:17" />وفَمَّة جْمَاعَة مِالتْلَامْذَة سِأْلُوا بْعَضْهُمْ: «شْنُوَّة يُقْصُدْ كِي قَالْ: "بَعْدْ شْوَيَّة مَاكُمْشْ بِشْ تْشُوفُونِي، ومْبَعْدْهَا بِشْوَيَّة بِشْ تْشُوفُونِي"، وزَادَا كِي قَالْ "آنَا رَاجَعْ لِلْآبْ"؟». <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />وقَالُوا: «آشْ مَعْنَاهَا "بَعْدْ شْوَيَّة"؟ مَانَاشْ فَاهْمِينْ آشْ قَاعِدْ يْقُولْ».<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />وعْرَفْ يَسُوعْ الِّي هُومَا يْحِبُّوا يِسْأْلُوهْ، يَاخِي قَالِلْهُمْ: «تِسْأْلُوا فِي بْعَضْكُمْ شْنُوَّة نُقْصُدْ كِي قُلْتْ: "بَعْدْ شْوَيَّة مَاكُمْشْ بِشْ تْشُوفُونِي، ومْبَعْدْهَا بِشْوَيَّة بِشْ تْشُوفُونِي؟" <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />الحَقْ الحَقْ نْقُولِلْكُمْ، إِنْتُومَا بِشْ تِبْكِيوْ وتْنَوْحُوا، والعَالِمْ بِشْ يِفْرَحْ. إِنْتُومَا بِشْ تَحْزْنُوا، آمَا رَاهُو حُزْنْكُمْ بِشْ يْوَلِّي فَرْحَة. <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />المْرَا تَحْزِنْ وَقْتِلِّي يْجِي وَقْتْهَا بِشْ تُوْلِدْ. آمَا بَعْدْمَا تُولِدْ تِنْسَى وجَايَعْهَا الكُلْ، عْلَى خَاطِرْهَا فَرْحَانَة الِّي جَابِتْ إِنْسَانْ لِلدِّنْيَا. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />إِنْتُومَا زَادَا بِشْ تَحْزْنُوا تَوَّا، آمَا رَانِي بِشْ نِرْجَعْ ونْشُوفْكُمْ، وقْلُوبْكُمْ بِشْ تِفْرَحْ وحَتَّى حَدْ مَا بِشْ يْنَحِّيلْكُمْ فَرْحِتْكُمْ. <verse eid="JHN 16:22" /><verse number="23" style="v" sid="JHN 16:23" />وفِي النْهَارْ هَاذَاكَا، مَا عَادْشْ بِشْ تِسْأْلُونِي عْلَى حَتَّى شَيْ. الحَقْ الحَقْ نْقُلْكُمْ: الِّي تُطْلْبُوهْ مِنْ الآبْ بْإِسْمِي، يَعْطِيهُولْكُمْ. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />حَتَّى لْتَوَّا مَا طْلَبْتُوا حَتَّى شَيْ بْإِسْمِي. أُطْلْبُوا تَاخْذُوا، بَاشْ تِكْمِلْ فَرْحِتْكُمْ».<verse eid="JHN 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />«كَلَّمْتْكُمْ عَالأُمُورْ هَاذِي بِالأَمْثَالْ. آمَا بِشْ يْجِي الوَقْتْ الِّي نَحْكِيلْكُمْ فِيهْ عَالآبْ بِكْلَامْ وَاضَحْ مِنْ غِيرْ أَمْثَالْ. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />وفِي النْهَارْ هَاذَاكَا، إِنْتُومَا بِشْ تُطْلْبُوا مِالآبْ بْإِسْمِي، وْمَانِيشْ قَاعِدْ نْقُلْكُمْ الِّي آنَا بِشْ نُطْلْبُو فِي عُوضْكُمْ. <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />رَاهُو الآبْ بِيدُو يْحِبْكُمْ عْلَى خَاطِرْكُمْ حَبِّيتُونِي وأَمَّنْتُوا الِّي آنَا جِيتْ مِنْ عَنْدْ اللَّهْ. <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />إِيْ نْعَمْ، آنَا خْرَجْتْ مِنْ عَنْدْ الآبْ وجِيتْ لِلدِّنْيَا هَاذِي، وتَوَّا بِشْ نْخَلِّي الدِّنْيَا ونِرْجَعْ لِلْآبْ».<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />قَالُولُو تْلَامِذْتُو: «إِنْتِ تَوَّا تِتْكَلَّمْ بِكْلَامْ وَاضِحْ، مُشْ بِالأَمْثَالْ. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />وأَحْنَا تَوَّا نَعْرْفُوا الِّي إِنْتِ تِعْلِمْ بْكُلْ شَيْ، ومَا تِحْتَاجْ لْحَتَّى حَدْ بِشْ يِسْأْلِكْ. هَاذَاكَا عْلَاشْ أَحْنَا نَمْنُوا الِّي إِنْتِ جِيتْ مِنْ عَنْدْ اللَّهْ». <verse eid="JHN 16:30" /><verse number="31" style="v" sid="JHN 16:31" />جَاوِبْهُمْ يَسُوعْ: «تَوَّا أَمَّنْتُوا؟ <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />آمَا بِشْ يْجِي وَقْتْ، وهَاوْ تَوَّا جَاء، الِّي فِيهْ بِشْ تِتْفَرْقُوا، وكُلْ وَاحِدْ يِمْشِي عْلَى رُوحُو وتْخَلِّيُونِي وَحْدِي. آمَا رَانِي مَانِيشْ وَحْدِي، عْلَى خَاطِرْ الآبْ مْعَايَا. <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />قُلْتِلْكُمْ الكْلَامْ هَاذَا بَاشْ يْوَلِّي عَنْدْكُمْ السَّلَامْ فِيَّا. فِي العَالِمْ بِشْ تْعَانِيوْ مِالمْحَايِنْ، آمَا تْشَجْعُوا، رَانِي آنَا غْلِبْتْ العَالِمْ».<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">صْلَاةْ يَسُوعْ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />بَعْدْمَا قَالْ الكْلَامْ هَاذَا، هَزْ يَسُوعْ عِينِيهْ لِلسْمَاء وقَالْ: «يَا بَابَا الوَقْتْ جَاء: مَجِّدْ إِبْنِكْ بَاشْ إِبْنِكْ يْمَجْدِكْ <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />عْلَى خَاطِرْ عْطِيتُو سُلْطَة عَالبَشَرْ الكُلْ، بَاشْ يَعْطِي الحَيَاةْ الأَبَدِيَّة لِلنَّاسْ الِّي عْطِيتْهُمْلُو الكُلْ. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />والحَيَاةْ الأَبَدِيَّة هِيَّ إِنْهُمْ يَعْرْفُوكْ إِنْتِ وَحْدِكْ الإِلَاهْ الحَقِيقِي، ويَعْرْفُوا يَسُوعْ المَسِيحْ الِّي بْعَثْتُو. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />آنَا مَجَّدْتِكْ فِي الأَرْضْ، كِي كَمَّلْتْ الخِدْمَة الِّي كَلَّفْتْنِي بِيهَا. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />وتَوَّا يَا بَابَا، مَجِّدْنِي بِالمَجْدْ الِّي كَانْ عَنْدِي وَقْتِلِّي كُنْتْ مْعَاكْ قْبَلْ مَا تْخَلْقِتْ الدِّنْيَا.<verse eid="JHN 17:5" /></para>
  <para style="s">صْلَاةْ يَسُوعْ لِتْلَامِذْتُو</para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />«ولِّي عْطِيتْهُمْلِي مِالعَالِمْ خَلِّيتْهُمْ يَعْرْفُوكْ. هُومَا كَانُوا مْتَاعِكْ، وإِنْتِ عْطِيتْهُمْلِي وطَاعُوا كْلَامِكْ. <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />وتَوَّا يَعْرْفُوا إِنُّو الِّي عْطِيتْهُولِي الكُلْ هُوَّ مِنْ عَنْدِكْ. <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />آنَا وصَّلْتِلْهُمْ الكْلَامْ الِّي عْطِيتْهُولِي، وهُومَا قِبْلُوهْ وعَرْفُوا بِالحَقْ الِّي آنَا جِيتْ مِنْ عَنْدِكْ، وصَدْقُوا إِنِّكْ إِنْتِ الِّي بْعَثْتْنِي. <verse eid="JHN 17:8" /><verse number="9" style="v" sid="JHN 17:9" />آنَا نِدْعِيلْهُمْ فِي صْلَاتِي. مَا نِدْعِيشْ لِلْعَالِمْ، آمَا نِدْعِي لِلِّي عْطِيتْهُمْلِي عْلَى خَاطِرْهُمْ مْتَاعِكْ. <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />كُلْ مَا هُوَّ لِيَّا رَاهُو لِيكْ، ولِّي لِيكْ هُو لِيَّا، وآنَا نِتْمَجِّدْ فِيهُمْ. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />مَانِيشْ بِشْ نُقْعُدْ فِي العَالِمْ هَاذَا، آنَا رَاجِعْلِكْ، آمَا هُومَا قَاعْدِينْ فِي العَالِمْ. يَا بَابَا القُدُّوسْ، أَحْفِظْهُمْ بْقُوِّةْ إِسْمِكْ الِّي عْطِيتْهُولِي، بَاشْ يْكُونُوا وَاحِدْ كِيفْ مَا آنَا وإِنْتِ وَاحِدْ. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />وَقْتِلِّي كُنْتْ مْعَاهُمْ حَافِظْتْ عْلِيهُمْ بْقُوِّةْ إِسْمِكَ الِّي عْطِيتْهُولِي. حْمِيتْهُمْ ومَا ضَاعْ مِنْهُمْ حَتَّى وَاحِدْ، إِلَّا الِّي مْصِيرُو الهْلَاكْ، بَاشْ يْتِمْ الِّي تْقَالْ فِي الكْتُبْ المُقَدْسَة.<verse eid="JHN 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 17:13" />«وآنَا تَوَّا رَاجَعْلِكْ. آمَا نْقُولْ الكْلَامْ هَاذَا وآنَا مَزِّلْتْ فِي العَالِمْ بَاشْ فَرْحْتِي الكَامْلَة تْوَلِّي فِيهُمْ. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />آنَا وَصَّلْتِلْهُمْ كْلَامِكْ والعَالِمْ كْرَهْهُمْ عْلَى خَاطِرْهُمْ مَاهُمْشْ مِالعَالِمْ، كِيمَا آنَا مَانِيشْ مِالعَالِمْ. <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />مَا نُطْلُبْشْ بَاشْ تْخَرِّجْهُمْ مِالعَالَمْ، آمَا نُطْلُبْ مِنِّكْ بَاشْ تَحْفِظْهُمْ مِالشِّيطَانْ. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />هُومَا مُشْ مِالعَالِمْ، كِيمَا آنَا مَانِيشْ مِالعَالِمْ. <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />قَدِّسْهُمْ فِي الحَقْ، كْلَامِكْ هُوَّ الحَقْ. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />كِيمَا بْعَثْتْنِي لِلْعَالِمْ، آنَا زَادَا بْعَثْتْهُمْ لِلْعَالِمْ. <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />وعْلَى خَاطِرْهُمْ آنَا نْقَدِّسْ رُوحِي، بَاشْ هُومَا زَادَا يِتْقَدْسُوا فِي الحَقْ.<verse eid="JHN 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />«ومَا نُطْلُبْشْ عْلَى خَاطِرْهُمْ هُومَا بَرْكْ، آمَا زَادَا عْلَى خَاطِرْ الِّي بِشْ يَمْنُوا بِيَّا بِسْبَبْ كْلَامْهُمْ، <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />بَاشْ يْكُونُوا وَاحِدْ يَا بَابَا، كِيفْ مَا إِنْتِ فِيَّا وآنَا فِيكْ. خَلِّيهُمْ هُومَا زَادَا يْكُونُوا وَاحِدْ فِينَا، بَاشْ يْصَدَّقْ العَالِمْ الِّي إِنْتِ بْعَثْتْنِي. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />وآنَا عْطِيتْهُمْ المَجْدْ الِّي عْطِيتْهُولِي، بَاشْ يْكُونُوا وَاحِدْ كِيمَا آنَا وإِنْتِ وَاحِدْ. <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />آنَا فِيهُمْ وإِنْتِ فِيَّا بَاشْ وِحْدِتْهُمْ تْكُونْ كَامْلَة، ويَعْرِفْ العَالِمْ الِّي إِنْتِ بْعَثْتْنِي ولِّي إِنْتِ تْحِبْهُمْ كِيمَا حَبِّيتْنِي.<verse eid="JHN 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24" />«يَا بَابَا، نْحِبْ الِّي عْطِيتْهُمْلِي يْكُونُوا مْعَايَا وِينْ مَا آنَا مَوْجُودْ، بَاشْ يْشُوفُوا المَجْدْ الِّي عْطِيتْهُولِي، عْلَى خَاطْرِكْ حَبِّيتْنِي مِنْ قْبَلْ مَا تْخَلْقِتْ الدِّنْيَا. <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />يَا بَابَا الصَّالَحْ، العَالِمْ مَا عَرْفِكْشْ، آمَا آنَا عْرَفْتِكْ، وهَاذُومَا عَرْفُوا الِّي إِنْتِ بْعَثْتْنِي. <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />وخَلِّيتْهُمْ يَعْرْفُوكْ، وبِشْ نْخَلِّيهُمْ يَعْرْفُوكْ أَكْثِرْ، بَاشْ مْحَبْتِكْ لِيَّا تْكُونْ فِيهُمْ، ونْكُونْ آنَا زَادَا فِيهُمْ».<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">يَسُوعْ يِتْشَدّْ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />وبَعْدْمَا كَمِّلْ يَسُوعْ صْلَاتُو، مْشَى هُوَّ وتْلَامِذْتُو وشَقُّوا وَادْ قَدْرُونْ. وغَادِي، كَانِتْ فَمَّة سَانْيَة، دَخْلُولْهَا هُوَّ وتْلَامِذْتُو. <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />ويَهُوذَا الِّي بِشْ يْخُونُو كَانْ يَعْرِفْ البْلَاصَة هَاذِيكَا، عْلَى خَاطِرْ يَسُوعْ تْقَابِلْ مْعَ تْلَامِذْتُو غَادِي، بَرْشَة مَرَّاتْ. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />جَاء يَهُوذَا وجَابْ مْعَاهْ عَسْكِرْ وحُرَّاسْ المَعْبِدْ الِّي بَعْثُوهُمْ كْبَارْ الكَهَنَة والفِرِّيسِيِّينْ، ودَخْلُوا لِلسَّانْيَة هَازِّينْ فْنَارَاتْ ومْشَاعِلْ وسْلَاحْ.<verse eid="JHN 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 18:4" />وكَانْ يَسُوعْ يَعْرِفْ الِّي بِشْ يْصِيرْلُو الكُلْ، يَاخِي مْشَالْهُمْ وقَالِلْهُمْ: «عْلَى شْكُونْ تْلَوْجُوا؟». <verse eid="JHN 18:4" /><verse number="5" style="v" sid="JHN 18:5" />جَاوْبُوهْ: «يَسُوعْ النَّاصْرِي». قَالِلْهُمْ: «آنَا هُوَّ!» وكَانْ يَهُوذَا الِّي خَانُو وَاقِفْ مْعَاهُمْ. <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />ووَقْتِلِّي قَالِلْهُمْ يَسُوعْ: «آنَا هُوَّ» وَخْرُوا لْتَالِي وطَاحُوا عَالقَاعَة. <verse eid="JHN 18:6" /><verse number="7" style="v" sid="JHN 18:7" />يَاخِي عَاوِدْ يَسُوعْ سْأَلْهُمْ: «عْلَى شْكُونْ تْلَوْجُوا؟». قَالُوا: «يَسُوعْ النَّاصْرِي». <verse eid="JHN 18:7" /><verse number="8" style="v" sid="JHN 18:8" />جَاوِبْهُمْ يَسُوعْ: «قُلْتِلْكُمْ آنَا هُوَّ. إِذَا كَانْكُمْ تْلَوْجُوا عْلِيَّا آنَا، خَلِّيوْ هَاذُومَا يِمْشِيوْ عْلَى رْوَاحُهُمْ». <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />وهَكَّا تْحَقَّقْ الِّي قَالُّو يَسُوعْ: «مَا ضَيَّعْتْ حَتَّى وَاحِدْ مِلِّي عْطِيتْهُمْلِي». <verse eid="JHN 18:9" /><verse number="10" style="v" sid="JHN 18:10" />وكَانْ سِمْعَانْ بُطْرُسْ عَنْدُو سِيفْ، جِبْدُو وضْرَبْ خْدِيمْ الكَاهِنْ الكْبِيرْ وقَصْلُو وذْنُو اليْمِينْ. والخْدِيمْ كَانْ إِسْمُو مَلْخُسْ. <verse eid="JHN 18:10" /><verse number="11" style="v" sid="JHN 18:11" />قَالْ يَسُوعْ لْبُطْرُسْ: «رَجَّعْ سِيفِكْ لِبْلَاصْتُو! يَاخِي مُشْ لَازِمْنِي نُشْرُبْ كَاسْ الوْجَايَعْ الِّي عْطَاهَولِي الآبْ؟».<verse eid="JHN 18:11" /></para>
  <para style="s">يَسُوعْ قُدَّامْ حَنَّانْ</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />بِالوَقْتْ، العَسْكِرْ وقَايِدْهُمْ وحُرَّاسْ الهَيْكِلْ، شَدُّوا يَسُوعْ وكَتْفُوهْ، <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />وهَزُّوهْ فِي الأُوِّلْ لْحَنَّانْ حْمُو قَيَافَا. وقَيَافَا كَانْ هُوَّ الكَاهِنَ الكْبِيرْ فِي العَامْ هَاذَاكَا. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />وقَيَافَا هُوَّ الِّي نْصَحْ اليْهُودْ وقَالْهُمْ «أَحْسْنِلْكُمْ كَانْ يْمُوتْ رَاجِلْ وَاحِدْ فِي بْلَاصِةْ الشَّعْبْ الكُلْ».<verse eid="JHN 18:14" /></para>
  <para style="s">بُطْرُسْ يُنْكُرْ يَسُوعْ</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />سِمْعَانْ بُطْرُسْ وتِلْمِيذْ آخَرْ تَبْعُوا يَسُوعْ. دْخَلْ التِّلْمِيذْ الآخِرْ لْوِسْطْ الدَّارْ كْبِيرْ الكَهَنَة مْعَ يَسُوعْ عْلَى خَاطِرْ كْبِيرْ الكَهَنَة كَانْ يَعْرْفُو، <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />آمَا بُطْرُسْ قْعَدْ وَاقِفْ لْبَرَّا بَحْذَا البَابْ. خْرَجْ التِّلْمِيذْ الآخِرْ، الِّي يَعْرْفُو كْبِيرْ الكَهَنَة، وكَلِّمْ الِّي تْعِسْ فِي البَابْ، ودَخِّلْ بُطْرُسْ. <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />يَاخِي الخْدِيمَة الِّي تْعِسْ فِي البَابْ سِأْلِتْ بُطْرُسْ: «مُشْ إِنْتِ وَاحِدْ مِنْ تْلَامِذْةْ الرَّاجِلْ هَاذَا؟». جَاوِبْهَا بُطْرُسْ: «لَا، مَانِيشْ مِنْهُمْ». <verse eid="JHN 18:17" /><verse number="18" style="v" sid="JHN 18:18" />كَانِتْ الدِّنْيَا بَارْدَة بَرْشَة، وكَانُوا الخُدَّامْ وحُرَّاسْ الهَيْكِلْ مْشَعْلِينْ نَارْ ووَاقْفِينْ يِدَّفَّاوْ. وكَانْ بُطْرُسْ وَاقِفْ يِدَّفَّى مْعَاهُمْ.<verse eid="JHN 18:18" /></para>
  <para style="s">كْبِيرْ الكَهَنَة يِسْتَجْوِبْ يَسُوعْ</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />سْأَلْ كْبِيرْ الكَهَنَة يَسُوعْ عْلَى تْلَامِذْتُو وعْلَى تَعْلِيمُو. <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />جَاوْبُو يَسُوعْ: «كَلَّمْتْ النَّاسْ الكُلْ جْهَارْ. كُنْتْ دِيمَا نْعَلِّمْ فِي المْعَابِدْ وفِي الهَيْكِلْ وِينْ يِتْلَمُّوا اليْهُودْ الكُلْ، ومَا قُلْتْ حَتَّى شَيْ فِي السِّرْ. <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />مَالَا عْلَاشْ تِسْإِلْ فِيَّا آنَا؟ إِسْإِلْ النَّاسْ الِّي سَمْعُونِي عَلِّي قُلْتْهُولْهُمْ. هُومَا يَعْرْفُونِي آشْ قُلْتْ». <verse eid="JHN 18:21" /><verse number="22" style="v" sid="JHN 18:22" />وَقْتِلِّي قَالْ يَسُوعْ الكْلَامْ هَاذَا، وَاحِدْ مِالحُرَّاسْ الِّي بْجَنْبُو ضَرْبُو بْكَفْ وقَالُّو: «هَكَّا تْجَاوِبْ كْبِيرْ الكَهَنَة؟». <verse eid="JHN 18:22" /><verse number="23" style="v" sid="JHN 18:23" />جَاوْبُو يَسُوعْ: «كَانْ قُلْتْ كْلَامْ غَالِطْ، قُلِّي. وكَانْ قُلْتْ الحَقْ، عْلَاشْ تَضْرِبْ فِيَّا؟». <verse eid="JHN 18:23" /><verse number="24" style="v" sid="JHN 18:24" />ومْبَعِّدْ حَنَّانْ بْعَثْ يَسُوعْ مْكَتِّفْ، لْقِيَافَا كْبِيرْ الكَهَنَة.<verse eid="JHN 18:24" /></para>
  <para style="s">بُطْرُسْ يْعَاوِدْ يُنْكُرْ يَسُوعْ</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />فِي الوَقْتْ هَاذَاكَا، كَانْ سِمْعَانْ بُطْرُسْ وَاقِفْ يِدَّفَّى. يَاخِي سِأْلُوهْ: «مُشْ إِنْتِ وَاحِدْ مِنْ تْلَامِذْتُو؟». نْكَرْ بُطْرُسْ وقَالْ: «مَانِيشْ مِنْهُمْ!». <verse eid="JHN 18:25" /><verse number="26" style="v" sid="JHN 18:26" />يَاخِي قَالُّو وَاحِدْ مِنْ خُدَّامْ كْبِيرْ الكَهَنَة، وهُوَّ نْسِيبْ الخْدِيمْ الِّي بُطْرُسْ قَصْلُو وِذْنُو: «مُشْ شُفْتِكْ مْعَاهْ فِي السَّانْيَة؟» <verse eid="JHN 18:26" /><verse number="27" style="v" sid="JHN 18:27" />زَادْ بُطْرُسْ نْكَرْ مَرَّة أُخْرَى. وبِالوَقْتْ، فَمَّة سَرْدُوكْ صَاحْ.<verse eid="JHN 18:27" /></para>
  <para style="s">يَسُوعْ قُدَّامْ الوَالِي الرُّومَانِي بِيلَاطُسْ</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />ومْبَعِّدْ هَزُّوا يَسُوعْ مِنْ دَارْ قَيَافَا لْدَارْ الوِلَايَة. ووَقْتْهَا كَانْ صْبَاحْ. مَا حَبُّوشْ اليْهُودْ يُدْخْلُوا لْدَارْ الوِلَايَة بَاشْ مَا يِتْنَجْسُوشْ، وبَاشْ يْنَجْمُوا يَاكْلُوا مِنْ مَاكْلَة عِيدْ الفِصْحْ. <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />وَلَّى خَرَجِّلْهُمْ بِيلَاطُسْ وسْإِلْهُمْ: «بَاشْ تَاهْمِينُو الرَّاجِلْ هَاذَا؟» <verse eid="JHN 18:29" /><verse number="30" style="v" sid="JHN 18:30" />جَاوْبُوهْ: «كَانْ مَا جَاشْ مُجْرِمْ، رَانَا مَا جِبْنَاهُولِكْشْ». <verse eid="JHN 18:30" /><verse number="31" style="v" sid="JHN 18:31" />قَالِلْهُمْ بِيلَاطُسْ: «هِزُّوهْ إِنْتُومَا وأُحْكْمُوا عْلِيهْ بِلِّي مَوْجُودْ فِي شَرِيعِتْكُمْ». جَاوْبُوهْ اليْهُودْ: «مَا عَنْدْنَاشْ الحَقْ نُقْتْلُوا حَتَّى حَدْ». <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />هَاذَا صَارْ بَاشْ يِتْحَقَّقْ الِّي قَالُّو يَسُوعْ عَالطَّرِيقَة الِّي بَاشْ يْمُوتْ بِيهَا.<verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />يَاخِي بِيلَاطُسْ رْجَعْ دْخَلْ لْدَارْ الوِلَايَة وعَيِّطْ لْيَسُوعْ وسِأْلُو: «يَاخِي إِنْتِ مَلِكْ اليْهُودْ؟» <verse eid="JHN 18:33" /><verse number="34" style="v" sid="JHN 18:34" />جَاوْبُو يَسُوعْ: «الكْلَامْ هَاذَا مِنْ عَنْدِكْ وَلَّا النَّاسْ قَالُوهُولِكْ عْلِيَّا؟». <verse eid="JHN 18:34" /><verse number="35" style="v" sid="JHN 18:35" />جَاوِبْ بِيلَاطُسْ: «يَاخِي آنَا يْهُودِي؟ شَعْبِكْ وكْبَارْ الكَهَنَة هُومَا الِّي جَابُوكْ لِيَّا. شْنُوَّة عْمَلْتْ؟». <verse eid="JHN 18:35" /><verse number="36" style="v" sid="JHN 18:36" />جَاوِبْ يَسُوعْ: «مَمْلْكَتِي مَاهِيشْ مِالعَالِمْ هَاذَا. وكَانْ جَاتْ مَمْلِكْتِي مِالعَالِمْ هَاذَا، رَاهُمْ خُدَّامِي حَارْبُوا بَاشْ اليْهُودْ مَا يْشِدُّونِيشْ. آمَا مَمْلِكْتِي مُشْ مِالعَالِمْ هَاذَا». <verse eid="JHN 18:36" /><verse number="37" style="v" sid="JHN 18:37" />قَالُّو بِيلَاطُسْ: «مَالَا، إِنْتِ مَلِكْ؟». جَاوْبُو يَسُوعْ: «إِنْتِ بِيدِكْ قُلْتْ الِّي آنَا مَلِكْ. آنَا تُولِدْتْ وجِيتْ لِلْعَالِمْ بَاشْ نِشْهِدْ لِلْحَقْ. وكُلْ وَاحِدْ تَابَعْ لِلْحَقْ يِسْمَعْ الكْلَامْ الِّي نْقُولْ فِيهْ». <verse eid="JHN 18:37" /><verse number="38" style="v" sid="JHN 18:38" />يَاخِي قَالُّو بِيلَاطُسْ: «شْنُوَّة هُوَّ الحَقْ؟». بَعْدْمَا قَالْ هَاذَا، خْرَجْ مَرَّة أُخْرَى لِلْيْهُودْ وقَالِلْهُمْ: «مَا لْقِيتْ حَتَّى سْبَبْ يْخَلِّينِي نُحْكُمْ عْلِيهْ. <verse eid="JHN 18:38" /><verse number="39" style="v" sid="JHN 18:39" />آمَا فِي العَادَة نْسَيْبِلْكُمْ وَاحِدْ مِالمْرَابِيطْ فِي عِيدْ الفِصْحْ. تْحِبُّوشْ نْسَيْبِلْكُمْ مَلِكْ اليْهُودْ؟». <verse eid="JHN 18:39" /><verse number="40" style="v" sid="JHN 18:40" />يَاخِي صَاحُوا: «هَاذَاكَا لَا. سَيْبِلْنَا بَارَابَاسْ». وبَارَابَاسْ هَاذَا كَانْ مُجْرِمْ.<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="s">بِيلَاطُسْ يُحْكُمْ بْصَلْبْ يَسُوعْ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />يَاخِي بِيلَاطُسْ عْطَى أَمْرْ بَاشْ يْهِزُّوا يَسُوعْ ويَضْرْبُوهْ بِالسُّوطْ. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />وضَفْرُوا الجُنُودْ تَاجْ مِالشُّوكْ وحَطُّوهُولُو فُوقْ رَاسُو، ولَبْسُوهْ لِبْسَة فِي لُونْ البَنَفْسَجْ، <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />ودَارُوا بِيهْ وبْدَاوْ يَضْرْبُوا فِيهْ بِالكَفْ ويْقُولُوا: «سَلَامْ يَا مَلِكْ اليْهُودْ!». <verse eid="JHN 19:3" /><verse number="4" style="v" sid="JHN 19:4" />وخْرَجْ بِيلَاطُسْ مَرَّة أُخْرَى لِلنَّاسْ وقَالِلْهُمْ: «هَانِي بِشْ نْخَرِّجْهُولْكُمْ، بَاشْ تَعْرْفُوا الِّي آنَا مَا لْقِيتْ حَتَّى سْبَبْ يْخَلِّينِي نُحْكُمْ عْلِيهْ». <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />خْرَجْ يَسُوعْ وهُوَّ لَابِسْ تَاجْ الشُّوكْ واللِّبْسَة البَنَفْسَجِيَّة. يَاخِي قَالِلْهُمْ بِيلَاطُسْ: «أَهَوَّا الرَّاجِلْ!». <verse eid="JHN 19:5" /><verse number="6" style="v" sid="JHN 19:6" />وَقْتِلِّي شَافُوهْ كْبَارْ الكَهَنَة والحُرَّاسْ، صَاحُوا: «أُصْلْبُو! أُصْلْبُو!». قَالِلْهُمْ بِيلَاطُسْ: «هِزُّوهْ إِنْتُومَا وأُصْلْبُوهْ، آنَا مَا لْقِيتْ حَتَّى سْبَبْ يْخَلِّينِي نُحْكُمْ عْلِيهْ». <verse eid="JHN 19:6" /><verse number="7" style="v" sid="JHN 19:7" />جَاوْبُوهْ اليْهُودْ: «أَحْنَا عَنْدْنَا شَرِيعَة، والشَّرِيعَة تْقُولْ الِّي لَازْمُو يْمُوتْ، عْلَى خَاطِرْ قَالْ عْلَى رُوحُو الِّي هُوَّ إِبْنْ اللَّهْ». <verse eid="JHN 19:7" /><verse number="8" style="v" sid="JHN 19:8" />وَقْتِلِّي سْمَعْ بِيلَاطُسْ كْلَامْهُمْ، زَادْ خَافْ. <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />وعَاوِدْ دْخَلْ لْدَارْ الوِلَايَة وقَالْ لْيَسُوعْ: «إِنْتِ مْنِينْ؟». آمَا يَسُوعْ مَا جَاوْبُوشْ بِالكُلْ. <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />قَالُّو بِيلَاطُسْ: «مَا تْحِبِّشْ تْكَلِّمْنِي؟ يَاخِي مَا تَعْرَفْشْ الِّي عَنْدِي السُّلْطَة بَاشْ نْسَيْبِكْ، وعَنْدِي السُّلْطَة بَاشْ نُصْلْبِكْ؟». <verse eid="JHN 19:10" /><verse number="11" style="v" sid="JHN 19:11" />جَاوْبُو يَسُوعْ: «مَا عَنْدِكْ عْلِيَّا حَتَّى سُلْطَة كَانْ مُشْ اللَّهْ عْطَاهَالِكْ. هَاذَاكَا عْلَاشْ، الِّي سَلَّمْنِي لِيكْ ذَنْبُو أَعْظِمْ مِنْ ذَنْبِكْ».<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />ومِنْ وَقْتْهَا، حَاوِلْ بِيلَاطُسْ يْسَيْبُو، آمَا اليْهُودْ صَاحُوا: «كَانْ تْسَيْبُو، مَعْنَاهَا إِنْتِ مَا تْحِبِّشْ القَيْصِرْ، عْلَى خَاطِرْ الِّي يْقُولْ عْلَى رُوحُو مَلِكْ، هُوَّ عْدُو لِلْقَيْصَرْ».<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />وَقْتِلِّي سْمَعْ بِيلَاطُسْ الكْلَامْ هَاذَا، خَرِّجْ يَسُوعْ وقْعَدْ عْلَى كُرْسِي الحُكْمْ فِي بْلَاصَة إِسْمْهَا البْلَاطْ، وبِالعِبْرِيَّة إِسْمْهَا «جَبَّاثَا». <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />وهَاذَا صَارْ مْعَ الظُّهْرْ، فِي النْهَارْ الِّي يْحَضْرُوا فِيهْ لِلْفِصْحْ. قَالْ بِيلَاطُسْ لِلْيْهُودْ: «هَا هُوَّ المَلِكْ مْتَاعْكُمْ!». <verse eid="JHN 19:14" /><verse number="15" style="v" sid="JHN 19:15" />يَاخِي صَاحُوا: «أُقْتْلُو! أُقْتْلُو! أُصْلْبُو!». قَالِلْهُمْ بِيلَاطُسْ: «تْحِبُّونِي نُصْلُبْ المَلِكْ مْتَاعْكُمْ؟». جَاوْبُوهْ كْبَارْ الكَهَنَة: «مَا عَنْدْنَاشْ مَلِكْ آخِرْ بْخَلَافْ القَيْصِرْ!». <verse eid="JHN 19:15" /><verse number="16" style="v" sid="JHN 19:16" />وَلَّا بِيلَاطُسْ سَلَّمْهُولْهُمْ بَاشْ يُصْلْبُوهْ.</para>
  <para style="s" vid="JHN 19:16">صَلْبْ يَسُوعْ</para>
  <para style="p" vid="JHN 19:16">يَاخِي هَزُّوا يَسُوعْ. <verse eid="JHN 19:16" /><verse number="17" style="v" sid="JHN 19:17" />وخْرَجْ يَسُوعْ وهُوَّ هَازِزْ صْلِيبُو، مَاشِي لْبُقْعَة تِتْسَمَّى الجُمْجْمَة، ولِّي يْقُولُولْهَا بِالعِبْرِيَّة «الجُلْجْثَة». <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />وغَادِي صَلْبُوهْ وصَلْبُوا مْعَاهْ زُوزْ رْجَالْ، وَاحِدْ عْلَى يْمِينُو ووَاحِدْ عْلَى يْسَارُو ويَسُوعْ فِي الوُسْطْ. <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />وعَلِّقْ بِيلَاطُسْ بْلَاكَة عَالصَّلِيبْ مَكْتُوبْ عْلِيهَا: «يَسُوعْ النَّاصْرِي، مَلِكْ اليْهُودْ». <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />بَرْشَة يْهُودْ قْرَاوْ البْلَاكَة، عْلَى خَاطِرْ البْلَاصَة الِّي تِصْلَبْ فِيهَا يَسُوعْ كَانِتْ قْرِيبَة مِالمْدِينَة. والكْتِيبَة كَانِتْ بِالعِبْرِيَّة واللَّاتِينِيَّة واليُونَانِيَّة. <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />يَاخِي قَالُوا كْبَارْ الكَهَنَة لْبِيلَاطُسْ: «مَا تِكْتِبْشْ "مَلِكْ اليْهُودْ" آمَا إِكْتِبْ "الرَّاجِلْ هَاذَا قَالْ: آنَا مَلِكْ اليْهُودْ!"». <verse eid="JHN 19:21" /><verse number="22" style="v" sid="JHN 19:22" />جَاوِبْهُمْ بِيلَاطُسْ: «الِّي كْتِبْتُو، كْتِبْتُو».<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />وبَعْدْمَا العَسْكَرْ صَلْبُوا يَسُوعْ، قَسْمُوا حْوَايْجُو عْلَى أَرْبْعَة، وكُلْ عَسْكْرِي خْذَا بَايْ. وخْذَاوْ جُبْتُو زَادَا، وكَانِتْ لْكُلْهَا قَطْعَة وَحْدَة مَنْسُوجَة، مَا فِيهَاشْ خْيَاطَة. <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />قَالُوا العَسْكَرْ لِبْعَضْهُمْ: «مُشْ لَازِمْ نْقَطْعُوهَا. خَلِّينَا نَعْمْلُوا عْلِيهَا قُرْعَة، ونْشُوفُوا شْكُونْ يِرْبِحْهَا». هَاذَاكَا صَارْ بَاشْ يِتْحَقَّقْ الِّي تْقَالْ فِي الكْتُبْ المُقَدْسَة:</para>
  <para style="b" vid="JHN 19:24" />
  <para style="q1" vid="JHN 19:24">«قَسْمُوا حْوَايْجِي مَا بِينَاتْهُمْ،</para>
  <para style="q2" vid="JHN 19:24">وعَمْلُوا قُرْعَة عْلَى جُبْتِي».</para>
  <para style="b" vid="JHN 19:24" />
  <para style="m" vid="JHN 19:24">وهَاذَا هُوَّ الِّي عَمْلُوهْ العَسْكِرْ.<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />وكَانِتْ مَرْيِمْ أُمْ يَسُوعْ وَاقْفَة بَحْذَا صَلِيبُو، ومْعَاهَا أُخْتْهَا، ومَرْيِمْ مَرْتْ كِلُوبَا، ومَرْيِمْ المَجْدَلِيَّة. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />وَقْتِلِّي يَسُوعْ شَافْ أُمُّو والتِّلْمِيذْ الِّي يْحِبُّو وَاقِفْ بَحْذَاهَا، قَالْ لْأُمُّو: «يَا مْرَا، هَاذَا وِلْدِكْ». <verse eid="JHN 19:26" /><verse number="27" style="v" sid="JHN 19:27" />وقَالْ لِلتِّلْمِيذْ: «هَاذِي أُمِّكْ!». ومِنْ وَقْتْهَا، هَزْهَا التِّلْمِيذْ لْدَارُو.<verse eid="JHN 19:27" /></para>
  <para style="s">مُوتْ يَسُوعْ</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />وبَعْدْ هَاذَا، شَافْ يَسُوعْ الِّي كُلْ شَيْ كْمِلْ. يَاخِي قَالْ: «آنَا عُطْشَانْ»، بَاشْ يِتْحَقَّقْ الِّي تْقَالْ فِي الكْتُبْ المُقَدْسَة. <verse eid="JHN 19:28" /><verse number="29" style="v" sid="JHN 19:29" />وكَانْ فَمَّة سْطَلْ مَلْيَانْ بِالخَلْ، غَطْسُوا فِيهْ شِيفُونَة وحَطُّوهَا عْلَى عُودْ رِيحَانْ وطَلْعُوهَا لْفُمُّو. <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />ووَقْتِلِّي ذَاقْ يَسُوعْ الخَلْ قَالْ: «كُلْ شَيْ كْمِلْ!» وهَبَّطْ رَاسُو وطَلَّعْ الرُّوحْ.<verse eid="JHN 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />والنْهَارْ هَاذَاكَا كَانْ يُومْ التَّحْضِيرْ لِلسِّبْتْ. وَلَّاوْ اليْهُودْ طَلْبُوا مِنْ بِيلَاطُسْ بَاشْ يَعْطِي أَمْرْ لِلْعَسْكِرْ يْكَسْرُوا سَاقِينْ المَصْلُوبِينْ ويْهَبْطُوهُمْ. وهَكَّا مَا يْبَاتُوشْ عَالصَّلِيبْ لِنْهَارْ السِّبْتْ، بِالأَخَصْ الِّي السِّبْتْ هَاذَاكَا كَانْ نْهَارْ عْظِيمْ. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />وَلَّاوْ العَسْكِرْ جَاوْ وكَسْرُوا سَاقِينْ الرَّاجِلْ الأَوِّلْ وبَعْدْ سَاقِينْ الرَّاجِلْ الثَّانِي الِّي تْصَلْبُوا مْعَ يَسُوعْ. <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />ووَقْتِلِّي وُصْلُوا لْيَسُوعْ، لْقَاوْهْ مَاتْ. يَاخِي مَا كَسْرُولُوشْ سَاقِيهْ. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />آمَا وَاحِدْ مِالعَسْكِرْ ضَرْبُو بْرُمْحْ فِي جَنْبُو، وبِالوَقْتْ خْرَجْ مِنُّو دَمْ ومَاء. <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />ولِّي شَافْ هَاذَا، يِشْهِدْ بِيهْ وشْهَادْتُو صْحِيحَة. ويَعْرِفْ الِّي هُوَّ يْقُولْ فِي الحَقْ، بَاشْ إِنْتُومَا زَادَا تَمْنُوا. <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />هَاذَا صَارْ بَاشْ يِتْحَقَّقْ الِّي قَالِتُّو الكْتُبْ المُقَدْسَة: «مَا يِتْكَسَّرْلُو حَتَّى عْظَمْ». <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />ومَكْتُوبْ فِي بْلَاصْة أُخْرَى فِي الكْتُبْ المُقَدْسَة: «بِشْ يُخْزْرُوا لِلشَّخْصْ الِّي دَغْرُوهْ».<verse eid="JHN 19:37" /></para>
  <para style="s">يُوسِفْ يِدْفِنْ يَسُوعْ</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />وبَعْدْ هَاذَا جَاء يُوسِفْ الِّي أَصْلُو مِنْ مْدِينِةْ الرَّامَة. وهُوَّ كَانْ تِلْمِيذْ يَسُوعْ فِي السِّرْ، عْلَى خَاطْرُو كَانْ خَايِفْ مِاليْهُودْ. وطْلَبْ مِنْ بِيلَاطُسْ بَاشْ يْخَلِّيهْ يْهِزْ جُثِّةْ يَسُوعْ، وبِيلَاطُسْ وَافَقْ. يَاخِي جَاء وهَزْهَا. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />وجَاء زَادَا نِيقُودِيمُوسْ، الِّي قْبَلْ بْمُدَّة مْشَى لْيَسُوعْ فِي اللِّيلْ. وجَابْ مْعَاهْ قْرَابِةْ 34 كِيلُو مُرْ وعُودْ مْخَلْطِينْ. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />وهَزُّوا جُثِّةْ يَسُوعْ، وفَوْحُوهَا بِالعِطْرْ ولَفُّوهَا فِي قْمَايِطْ، كِيفْ مَا كَانِتْ عْوَايِدْ اليْهُودْ فِي الدْفِينَة. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />وكَانِتْ فَمَّة سَانْيَة فِي البْلَاصَة الِّي تِصْلَبْ فِيهَا يَسُوعْ، والسَّانْيَة هَاذِيكَا فِيهَا قْبَرْ جْدِيدْ مَا تْحَطْ فِيهْ حَتَّى حَدْ قْبَلْ. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />وَلَّاوْ حَطُّوا يَسُوعْ فِي القْبَرْ هَاذَاكَا عْلَى خَاطْرُو كَانْ قْرِيبْ، وعْلَى خَاطِرْ كَانْ النْهَارْ هَاذَاكَا عَنْدْ اليْهُودْ، نْهَارْ التَّحْضِيرْ لِلسِّبْتْ.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">يَسُوعْ يْقُومْ مِالمُوتْ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />نْهَارْ الأَحَدْ الصْبَاحْ بِكْرِي، جَاتْ مَرْيِمْ المَجْدَلِيَّة لِلْقْبَرْ والدِّنْيَا مَزَّالِتْ ظَلْمَة، يَاخِي شَافِتْ الحَجْرَة الِّي مْسَكْرِينْ بِيهَا القْبَرْ مْنِحْيَة. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />مْشَاتْ تِجْرِي لْسِمْعَانْ بُطْرُسْ والتِّلْمِيذْ الآخِرْ الِّي يْحِبُّو يَسُوعْ وقَالْتِلْهُمْ: «هَزُّوا سِيدْنَا مِالقْبَرْ، ومَا نَعْرْفُوشْ وِينْ حَطُّوهْ». <verse eid="JHN 20:2" /><verse number="3" style="v" sid="JHN 20:3" />يَاخِي مْشَى بُطْرُسْ والتِّلْمِيذْ الآخِرْ لِلْقْبَرْ، <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />وكَانُوا الإِثْنِينْ يِجْرِيوْ مْعَ بْعَضْهُمْ، آمَا التِّلْمِيذْ الآخِرْ سْبِقْ بُطْرُسْ ووْصِلْ قَبْلُو لِلْقْبَرْ. <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />طَبِّسْ، شَافْ القْمَايِطْ فِي القَاعَة، آمَا مَا دْخَلْشْ. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />خْلَطْ عْلِيهْ سِمْعَانْ بُطْرُسْ، ودْخَلْ لِلْقْبَرْ وشَافْ القْمَايِطْ طَايْحِينْ فِي القَاعَة، <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />والمَنْدِيلَة الِّي كَانِتْ مَحْطُوطَة عْلَى رَاسْ يَسُوعْ، لْقَاهَا مَلْفُوفَة وَحَّدْهَا، فِي بْلَاصَة بْعِيدَة عْلَى القْمَايِطْ. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />وَقْتْهَا دْخَلْ التِّلْمِيذْ الآخِرْ الِّي سْبَقْ بُطْرُسَ لِلْقْبَرْ، يَاخِي شَافْ وأَمَّنْ، <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />عْلَى خَاطِرْ، حَتَّى لِلْوَقْتْ هَاذَاكَا، مَا كَانُوشْ التْلَامْذَة فَاهْمِينْ الِّي يَسُوعْ لَازِمْ يْقُومْ مِالمُوتْ كِيمَا قَالِتْ الكْتُبْ المُقَدْسَة. <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />ومْبَعِّدْ، رَوْحُوا التْلَامْذَة لِدْيَارْهُمْ.<verse eid="JHN 20:10" /></para>
  <para style="s">يَسُوعْ يُظْهُرْ لْمَرْيِمْ المَجْدَلِيَّة</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />آمَا مَرْيِمْ المَجْدَلِيَّة، وِقْفِتْ بَحْذَا القْبَرْ تِبْكِي. وهِيَّ تِبْكِي، طَبْسِتْ بَاشْ تْطُلْ عَالقْبَرْ. <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />يَاخِي شَافِتْ زُوزْ مْلَايْكَة لَابْسِينْ بِالأَبْيِضْ وقَاعْدِينْ فِي البْلَاصَة الِّي كَانِتْ مَحْطُوطَة فِيهَا جُثَّةْ يَسُوعْ، وَاحِدْ عَنْدْ رَاسُو ووَاحِدْ عَنْدْ سَاقِيهْ. <verse eid="JHN 20:12" /><verse number="13" style="v" sid="JHN 20:13" />قَالُولْهَا: «يَا مْرَا، عْلَاشْ تِبْكِي؟». جَاوْبِتْ: «هَزُّوا سِيدِي ومَا نَعْرَفْشْ وِينْ حَطُّوهْ!». <verse eid="JHN 20:13" /><verse number="14" style="v" sid="JHN 20:14" />قَالِتْ هَاذَا وتْلَفْتِتْ، يَاخِي شَافِتْ يَسُوعْ وَاقِفْ، آمَا مَا عَرْفِتُّوشْ. <verse eid="JHN 20:14" /><verse number="15" style="v" sid="JHN 20:15" />قَالِلْهَا يَسُوعْ: «يَا مْرَا، عْلَاشْ تِبْكِي؟ عْلَى شْكُونْ تْلَوِّجْ؟». مْشَى فِي بَالْهَا الِّي هُوَّ الجَنَّانْ يَاخِي قَالِتْلُو: «يَا سِيدِي، كَانِكْ إِنْتِ هَزِّيتُو، قُلِّي وِينْ حَطِّيتُو بَاشْ نِمْشِي نْهِزُّو». <verse eid="JHN 20:15" /><verse number="16" style="v" sid="JHN 20:16" />قَالِلْهَا يَسُوعْ: «يَا مَرْيِمْ». تْلَفْتِتْلُو وقَالِتْلُو بِالعِبْرِيَّة: «رَبُّونِي!» (الِّي مَعْنَاهَا يَا مُعَلِّمْ). <verse eid="JHN 20:16" /><verse number="17" style="v" sid="JHN 20:17" />قَالِلْهَا: «مَا تْشِدْنِيشْ، عْلَى خَاطِرْنِي مَزِّلْتْ مَا طْلَعْتِشْ لِلْآبْ، آمَا إِمْشِي لِخْوَاتِي وقُولِلْهُمْ رَانِي بَاشْ نِطْلَعْ لْبَابَا وبُوكُمْ، إِلَاهِي وإِلَاهْكُمْ». <verse eid="JHN 20:17" /><verse number="18" style="v" sid="JHN 20:18" />رَجْعِتْ مَرْيِمْ المَجْدَلِيَّة وقَالِتْ لِلتْلَامْذَة الِّي هِيَّ شَافِتْ الرَّبْ يَسُوعْ، وحْكَاتِلْهُمْ عَلِّي قَالْهُولْهَا الكُلْ.<verse eid="JHN 20:18" /></para>
  <para style="s">يَسُوعْ يُظْهُرْ لِتْلَامِذْتُو</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />وفِي عْشِيَّةْ النْهَارْ هَاذَاكَا، الِّي هُوَّ نْهَارْ الأَحَدْ، كَانُوا التْلَامْذَة مَلْمُومِينْ فِي دَارْ وقَافْلِينْ البِيبَانْ عْلَى خَاطِرْهُمْ كَانُوا خَايْفِينْ مِاليْهُودْ. وإِذَا بِيهْ، جَاء يَسُوعْ، ووْقِفْ فِي وُسْطْهُمْ وقَالِلْهُمْ: «السَّلَامْ لِيكُمْ». <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />وبَعْدْمَا قَالْ هَاذَا، وَرَّاهُمْ يْدِيهْ وجَنْبُو، يَاخِي فَرْحُوا التْلَامْذَة عْلَى خَاطِرْ شَافُوا الرَّبْ. <verse eid="JHN 20:20" /><verse number="21" style="v" sid="JHN 20:21" />قَالِلْهُمْ يَسُوعْ مَرَّة أُخْرَى: «السَّلَامْ لِيكُمْ! كِيمَا بْعَثْنِي الآبْ، آنَا زَادَا نِبْعَثْكُمْ». <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />قَالْ هَاذَا ونْفَخْ عْلِيهُمْ وقَالِلْهُمْ: «إِقْبْلُوا الرُّوحْ القُدُسْ. <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />الِّي تِغْفْرُولْهُمْ إِنْتُومَا ذْنُوبْهُمْ، تِتْغْفَرِّلْهُمْ، ولِّي مَا تِغْفْرُولْهُمْشْ ذْنُوبْهُمْ مَا يِتْغْفَرِّلْهُمْشْ».<verse eid="JHN 20:23" /></para>
  <para style="s">يَسُوعْ يُظْهُرْ لْتُومَا</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />وتُومَا، الِّي هُوَّ وَاحِدْ مِالتْلَامْذَة الأَثْنَاشْ ولِّي كَانُوا يْعَيْطُولُو التُّومِي، مَا كَانِشْ مْعَاهُمْ وَقْتِلِّي جَاء يَسُوعْ. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />قَالُولُو التْلَامْذَة الأُخْرِينْ: «أَحْنَا شُفْنَا الرَّبْ!» قَالِلْهُمْ: «آنَا مَا نْصَدَّقْ كَانْ مَا نْشُوفْ أَمَارِةْ المْسَامِرْ فِي يْدِيهْ، ونْحُطْ صُبْعِي فِي بْلَاصِةْ المْسَامِرْ ونْحُطْ يِدِّي فِي جَنْبُو».<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />وبَعْدْ ثْمَنْيَة أَيَّامْ، كَانُوا التْلَامْذَة فِي الدَّارْ مَرَّة أُخْرَى، ومْعَاهُمْ تُومَا. جَاء يَسُوعْ رَغْمِلِّي كَانِتْ البِيبَانْ مَقْفُولَة، ووْقِفْ فِي وُسْطْهُمْ وقَالْ: «السَّلَامْ لِيكُمْ». <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />ومْبَعِّدْ قَالْ لْتُومَا: «حُطْ صُبْعِكْ هُونِي وشُوفْ يْدَيَّا، وهَاتْ يِدِّكْ وحُطْهَا فِي جَنْبِي. مَا عَادِشْ تْشِكْ، آمَا أَمَّنْ!» <verse eid="JHN 20:27" /><verse number="28" style="v" sid="JHN 20:28" />جَاوْبُو تُومَا: « رَبِّي وإِلَاهِي!» <verse eid="JHN 20:28" /><verse number="29" style="v" sid="JHN 20:29" />قَالُّو يَسُوعْ: «أَمَّنْتْ عْلَى خَاطْرِكْ رِيتْنِي! صَحَّة لِيهُمْ الِّي يَمْنُوا مِنْ غِيرْ مَا يْشُوفُوا».<verse eid="JHN 20:29" /></para>
  <para style="s">الهَدَفْ مِالكْتَابْ هَاذَا</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />وعْمَلْ يَسُوعْ قُدَّامْ تْلَامِذْتُو بَرْشَة مُعْجْزَاتْ أُخْرَى مَا تْكِتْبِتْشْ فِي الكْتَابْ هَاذَا. <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />آمَا هَاذِي تْكِتْبِتْ، بَاشْ تَمْنُوا الِّي يَسُوعْ هُوَّ المَسِيحْ إِبْنْ اللَّهْ، وبَاشْ تْكُونْ عَنْدْكُمْ حَيَاةْ بِالإِيمَانْ بْإِسْمُو.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">يَسُوعْ يُظْهُرْ لْسَبْعَة مِنْ تْلَامِذْتُو</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />وزَادْ يَسُوعْ ظْهُرْ مَرَّة أُخْرَى لِتْلَامِذْتُو عْلَى شَطْ بُحَيْرَةْ طَبَرِيَّة. وهَاوْ كِيفَاشْ ظْهُرِّلْهُمْ. <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />كَانْ سِمْعَانْ بُطْرُسْ، وتُومَا الِّي يْعَيْطُولُو التُّومِي، ونَثَنَائِيلْ الِّي مِنْ مَنْطَقْةْ قَانَا الجَلِيلْ، ووْلَادْ زَبَدِي، وزُوزْ تْلَامْذَة أُخْرِينْ مِنْ تْلَامِذْةْ يَسُوعْ مَلْمُومِينْ. <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />قَالِلْهُمْ سِمْعَانْ بُطْرُسْ: «آنَا مَاشِي نِصْطَادْ». قَالُولُو: «أَحْنَا زَادَا نِمْشِيوْ مْعَاكْ». خَرْجُوا وطَلْعُوا فِي الفْلُوكَة، آمَا اللِّيلَة هَاذِيكَا مَا صْطَادُوا شَيْ.<verse eid="JHN 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 21:4" />وَقْتِلِّي طْلَعْ النْهَارْ كَانْ يَسُوعْ وَاقِفْ عَالشَّطْ، آمَا التْلَامْذَة مَا عَرْفُوهِشْ. <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />يَاخِي قَالِلْهُمْ: «يَا شَبَابْ، مَا صْطَدْتُوا شَيْ؟» جَاوْبُوهْ: «لَا». <verse eid="JHN 21:5" /><verse number="6" style="v" sid="JHN 21:6" />قَالِلْهُمْ: «إِرْمِيوْ الشَّبْكَة عْلَى يْمِينْ الفْلُوكَة وتَوَّا تَلْقَاوْ الحُوتْ». رْمَاوْ الشَّبْكَة ومِنْ كُثْرِةْ مَا كَانِتْ مْعِبْيَة بِالحُوتْ، مَا نَجْمُوشْ يْخَرْجُوهَا. <verse eid="JHN 21:6" /><verse number="7" style="v" sid="JHN 21:7" />قَالْ التِّلْمِيذْ الِّي يْحِبُّو يَسُوعْ لْبُطْرُسْ: «رَاهُو الرَّبْ يَسُوعْ!». كِي سْمَعْ سِمْعَانْ بُطْرُسْ كِلْمِةْ: «رَاهُو الرَّبْ يَسُوعْ»، لْبِسْ بَرْنُوسُو عْلَى خَاطْرُو كَانْ مْنَحِّيهْ، وتِرْمَى فِي المَاء. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />والتْلَامْذَة الأُخْرِينْ وُصْلُوا لِلشَّطْ بِالفْلُوكَة، وهِيَّ تْكَرْكِرْ فِي الشَّبْكَة المْعِبْيَة بِالحُوتْ، عْلَى خَاطِرْهُمْ كَانُوا بْعَادْ عَالشَّطْ قْرَابِةْ المْيَاةْ مِيتْرُو أَكَهَوْ. <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />ووَقْتِلِّي خَرْجُوا لِلشَّطْ، شَافُوا حُوتْ يْطِيبْ عَالجْمَرْ، وخُبْزْ. <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />قَالِلْهُمْ يَسُوعْ: «جِيبُوا مِالحُوتْ الِّي شَدِّيتُوهْ تَوَّا». <verse eid="JHN 21:10" /><verse number="11" style="v" sid="JHN 21:11" />طْلَعْ سِمْعَانْ بُطْرُسْ فِي الفْلُوكَة، وكَرْكِرْ الشَّبْكَة المِلْيَانَة لِلشَّطْ. وكَانِتْ فِيهَا 153 حُوتَة كْبِيرَة. ورَغْمِلِّي كَانِتْ مْعِبْيَة، مَا تْقَطْعِتْشْ. <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />قَالِلْهُمْ يَسُوعْ: «إِيجَاوْ كُولُوا!» وحَتَّى وَاحِدْ مِالتْلَامْذَة مَا تْجَرَّأْ يِسْأْلُو «إِنْتِ شْكُونْ؟»، عْلَى خَاطِرْ عَرْفُوا الِّي هُوَّ الرَّبْ يَسُوعْ. <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />يَاخِي قْرُبِّلْهُمْ يَسُوعْ، وعْطَاهُمْ الخُبْزْ، وزَادْ مَدِّلْهُمْ الحُوتْ. <verse eid="JHN 21:13" /><verse number="14" style="v" sid="JHN 21:14" />هَاذِي كَانِتْ المَرَّة الثَّالْثَة الِّي ظْهُرْ فِيهَا يَسُوعْ لِتْلَامِذْتُو بَعْدْمَا قَامْ مِالمُوتْ.<verse eid="JHN 21:14" /></para>
  <para style="s">يَسُوعْ وبُطْرُسْ</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />وبَعْدْمَا كْلَاوْ، قَالْ يَسُوعْ لْسِمْعَانْ بُطْرُسْ: «يَا سِمْعَانْ وِلْدْ يُونَا، يَاخِي تْحِبْنِي أَكْثِرْ مِلِّي يْحِبُّونِي هَاذُومَا الكُلْ؟». جَاوْبُو: «إِيْ نْعَمْ، يَا رَبْ. إِنْتِ تَعْرِفْ الِّي آنَا نْحِبِّكْ». قَالُّو: «أَرْعَى الغْنَمْ مْتَاعِي». <verse eid="JHN 21:15" /><verse number="16" style="v" sid="JHN 21:16" />وقَالُّو يَسُوعْ مَرَّة أُخْرَى: «يَا سِمْعَانْ وِلْدْ يُونَا، يَاخِي تْحِبْنِي؟». جَاوْبُو: «إِيْ نْعَمْ، يَا رَبْ، إِنْتِ تَعْرِفْ الِّي آنَا نْحِبِّكْ». قَالُّو: «تِلْهَا بِالغْنَمْ مْتَاعِي». <verse eid="JHN 21:16" /><verse number="17" style="v" sid="JHN 21:17" />وسِأْلُو مَرَّة ثَالْثَة: «يَا سِمْعَانْ يَا وِلْدْ يُونَا، يَاخِي تْحِبْنِي؟». حْزِنْ بُطْرُسْ عْلَى خَاطِرْ يَسُوعْ سِأْلُو مَرَّة ثَالْثَة: «يَاخِي تْحِبْنِي؟». قَالُّو: «يَا رَبْ، إِنْتِ تَعْرِفْ كُلْ شَيْ، وتَعْرِفْ الِّي آنَا نْحِبِّكْ». قَالُّو يَسُوعْ: «أَرْعَى الغْنَمْ مْتَاعِي. <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />الحَقْ الحَقْ نْقُلِّكْ: وَقْتِلِّي كُنْتْ صْغِيرْ، كُنْتْ تِلْبِسْ حْوَايْجِكْ وَحْدِكْ وتِمْشِي وِينْ تْحِبْ. آمَا وَقْتِلِّي تْوَلِّي شَايِبْ، تْمِدْ يْدِيكْ ووَاحِدْ آخَرْ يْلَبْسِكْ ويْهِزِّكْ وِينْ مَا تْحِبِّشْ تِمْشِي». <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />لَمَّحْ يَسُوعْ بِالكْلَامْ هَاذَا لِلطَّرِيقَة الِّي بِشْ يْمُوتْ بِيهَا بُطْرُسْ ولِّي بِشْ يِتْمَجِّدْ بِيهَا اللَّهْ. ومِنْ بَعْدْهَا قَالُّو: «تَبَّعْنِي!».<verse eid="JHN 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />تْلَفِّتْ بُطْرُسْ، وشَافْ التِّلْمِيذْ الِّي يْحِبُّو يَسُوعْ يْتَبَّعْ فِيهُمْ، وهُوَّ الِّي إِتَّكَّى عْلَى صْدِرْ يَسُوعْ وَقْتْ العْشَاء وقَالُّو: «يَا سِيدِي، شْكُونُو الِّي بَاشْ يْخُونِكْ؟». <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />وَقْتِلِّي شَافُو بُطْرُسْ قَالْ لْيَسُوعْ: «وهَاذَا يَا رَبْ، آشْ بَاشْ يْصِيرْلُو؟». <verse eid="JHN 21:21" /><verse number="22" style="v" sid="JHN 21:22" />قَالُّو يَسُوعْ: «إِذَا كَانْ نْحِبُّو يُقْعُدْ حَيْ حَتَّى لِينْ نِرْجَعْ، هَاذَا مَا يْخُصِّكْشْ. إِنْتِ، تَبَّعْنِي!». <verse eid="JHN 21:22" /><verse number="23" style="v" sid="JHN 21:23" />يَاخِي طَلْعِتْ إِشَاعَة بِينْ المُؤْمْنِينْ الِّي التِّلْمِيذْ هَاذَاكَا مُشْ بِشْ يْمُوتْ. آمَا يَسُوعْ مَا قَالِشْ لْبُطْرُسْ الِّي هُوَّ مُشْ بِشْ يْمُوتْ. قَالُّو: «إِذَا كَانْ نْحِبُّو يُقْعُدْ حَيْ حَتَّى لِينْ نِرْجَعْ، هَاذَا مَا يْخُصِّكْشْ». <verse eid="JHN 21:23" /><verse number="24" style="v" sid="JHN 21:24" />والتِّلْمِيذْ هَاذَا هُوَّ الِّي يِشْهِدْ بِالأُمُورْ هَاذِي، وهُوَّ الِّي كْتِبْهَا. وأَحْنَا نَعْرْفُوا الِّي شْهَادْتُو صْحِيحَة.<verse eid="JHN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />وفَمَّة بَرْشَة حَاجَاتْ أُخْرِينْ عْمَلْهُمْ يَسُوعْ. كَانْ تِتْكْتِبْ بِالوَحْدَة بِالوَحْدَة، مَا نْظُنِّشْ الِّي العَالِمْ كَامِلْ بِشْ يَرْفَعْ الكْتُبْ الِّي بِشْ تِتْكْتِبْ عْلِيهَا.<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>