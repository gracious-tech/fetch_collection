<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JUD" style="id" />
  <para style="h">يَهُوذَا</para>
  <para style="toc1">رِسَالِةْ يَهُوذَا</para>
  <para style="toc2">يَهُوذَا</para>
  <para style="toc3">يَهُوذَا</para>
  <para style="mt">رِسَالِةْ يَهُوذَا</para>
  <chapter number="1" style="c" sid="JUD 1" />
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1" />مِنْ يَهُوذَا، خَادِمْ يَسُوعْ المَسِيحْ، وخُو يَعْقُوبْ، لِلِّي دْعَاهُمْ اللَّهْ الآبْ وحَبْهُمْ وحْفَظْهُمْ لْيَسُوعْ المَسِيحْ.<verse eid="JUD 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JUD 1:2" />يْزِيدْكُمْ اللَّهْ رَحْمَة وسَلَامْ ومْحَبَّة.<verse eid="JUD 1:2" /></para>
  <para style="s">رُدُّوا بَالْكُمْ مِالمُعَلْمِينْ الكَذَّابِينْ</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3" />يَا حْبَابِي، كُنْتْ نِتْمَنَّى نِكْتْبِلْكُمْ عَالنْجَاةْ الِّي نِتْشَارْكُوا فِيهَا أَحْنَا الكُلْ، آمَا حَسِّيتْ الِّي يِلْزِمْنِي نْشَجَّعْكُمْ بَاشْ ادَّافْعُوا عَالإِيمَانْ الِّي عْطَاهْ اللَّهْ لِلْقِدِّيسِينْ مَرَّة وَحْدَة بِالكَامِلْ. <verse eid="JUD 1:3" /><verse number="4" style="v" sid="JUD 1:4" />عْلَى خَاطِرْ فَمَّة نَاسْ دَخْلُوا بِينَاتْكُمْ بِالسِّرْقَة، وهُومَا نَاسْ فَاسْدِينْ، يِسْتْغَلُّوا فِي نِعْمِةْ اللَّهْ بَاشْ يَعْمْلُوا المْعَاصِي الكُلْ ويُنْكْرُوا سِيدْنَا ورَبْنَا الوَحِيدْ يَسُوعْ المَسِيحْ. وهَاذُومَا عِقَابْهُمْ مَعْرُوفْ مِنْ قْدِيمْ الزْمَانْ.<verse eid="JUD 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5" />وتَوَّا نْحِبْ نْذَكَّرْكُمْ بْحَاجَاتْ رَغْمِلِّي إِنْتُومَا تَعْرْفُوهَا مْلِيحْ. نْذَكَّرْكُمْ إِنُّو الرَّبْ بَعْدْمَا نَجَّى شَعْبْ إِسْرَائِيلْ مِنْ مَصْرْ، هْلِكْ مِنْهُمْ الِّي مَا أَمْنُوشْ. <verse eid="JUD 1:5" /><verse number="6" style="v" sid="JUD 1:6" />والمْلَايْكَة الِّي مَا حَافْظُوشْ عْلَى مْقَامْهُمْ العَالِي وسَلْمُوا فِي البْلَاصَة الِّي كَانُوا سَاكْنِينْ فِيهَا، خَلَّاهُمْ اللَّهْ مَرْبُوطِينْ بِسْلَاسِلْ فِي قَلْبْ الظْلَامْ حَتَّى لِينْ يْحَاسِبْهُمْ فِي النْهَارْ العْظِيمْ، <verse eid="JUD 1:6" /><verse number="7" style="v" sid="JUD 1:7" />كِيمَا صَارْ بِالضَّبْطْ لْمُدُنْ سَدُومْ وعَمُورَة والبْلَايِصْ الدَّايْرَة بِيهُمْ، الِّي كَانُوا غَاطْسِينْ فِي الفْسَادْ ويْتَبْعُوا فِي شْهَاوِي الجِنْسْ بْطَرِيقَة تْخَالِفْ الطَّبِيعَة، يَاخِي عَاقِبْهُمْ الرَّبْ بْنَارْ أَبَدِيَّة، ووَلَّاوْ عِبْرَة لْغِيرْهُمْ.<verse eid="JUD 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8" />ومْعَ هَاذَا، النَّاسْ الِّي دَخْلُوا بِينَاتْكُمْ قَاعْدِينْ يَعْمْلُوا كِيفْهُمْ. هُومَا يْنَجْسُوا فِي بْدَنَّاتْهُمْ بْأَحْلَامْهُمْ ومَا يِحْتَرْمُوشْ سُلْطِةْ اللَّهْ، ويْهِينُوا فِي المَخْلُوقَاتْ السْمَاوِيَّة العْظِيمَة. <verse eid="JUD 1:8" /><verse number="9" style="v" sid="JUD 1:9" />حَتَّى مِيخَائِيلْ رَئِيسْ المْلَايْكَة، كِي تْعَارِكْ مْعَ إِبْلِيسْ عْلَى جُثِّةْ مُوسَى، مَا سْمَحْشْ لْرُوحُو بَاشْ يُحْكُمْ عْلِيهْ بْكِلْمَة تْهِينُو، آمَا قَالُّو: «حْسِيبِكْ رَبِّي!». <verse eid="JUD 1:9" /><verse number="10" style="v" sid="JUD 1:10" />آمَا النَّاسْ هَاذُومَا يِتْكَلْمُوا بْإِهَانَة عْلَى حَاجَاتْ مَا يِفْهْمُوهَاشْ، آمَا الحَاجَاتْ الِّي يِفْهْمُوهَا بِالغَرِيزَة، كِيمَا الحَيَوَانَاتْ الِّي بْلَا عْقَلْ، هَاذِيكَا هِيَّ الِّي يْدَمْرُوا بِيهَا فِي رْوَاحْهُمْ. <verse eid="JUD 1:10" /><verse number="11" style="v" sid="JUD 1:11" />يَا وِيلْهُمْ! عْلَى خَاطِرْهُمْ مْشَاوْ فِي طْرِيقْ قَايِينْ وعَمْلُوا غَلْطِةْ بَلْعَامْ كِي طَمْعُوا فِي الفْلُوسْ، وتْمَرْدُوا كِيمَا قُورَحْ، يَاخِي إِدَّمْرُوا. <verse eid="JUD 1:11" /><verse number="12" style="v" sid="JUD 1:12" />وَقْتِلِّي تَعْمْلُوا لَمَّاتْ الإِخْوَة، النَّاسْ هَاذُومَا يَاكْلُوا مْعَاكُمْ مِنْ غِيرْ حِشْمَة ومَا تْهِمْهُمْ كَانْ رْوَاحْهُمْ. هُومَا خْطَرْ عْلِيكُمْ. هُومَا كِي السْحَابْ الِّي بْلَا مْطَرْ وهَازُّو الرِّيحْ، وكِي شْجَرْ الخْرِيفْ الِّي بْلَا غَلَّة، تْقَلَّعْ مِنْ عْرُوقُو، يَاخِي مَاتْ مَرْتِينْ. <verse eid="JUD 1:12" /><verse number="13" style="v" sid="JUD 1:13" />يِطْلَعْ مِنْهُمْ العَارْ كِيمَا مُوجْ البْحَرْ الهَايِجْ يْطَلَّعْ الوْسَخْ. هُومَا كِيمَا نْجُومْ ضَايْعَة فِي السْمَاء، مْصِيرْهَا فِي قَلْبْ الظْلَامْ لِلْأَبَدْ.<verse eid="JUD 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14" />وأَخْنُوخْ، الِّي هُوَّ مِالجِيلْ السَّابَعْ بَعْدْ آدَمْ، تْنَبَّأْ زَادَا عَالنَّاسْ هَاذُومَا وقَالْ: «شُوفُوا! هَاوْ الرَّبْ جَايْ مْعَ آلَافْ القِدِّيسِينْ، <verse eid="JUD 1:14" /><verse number="15" style="v" sid="JUD 1:15" />بَاشْ يْحَاسِبْ النَّاسْ الكُلْ، ويْعَاقِبْ الأَشْرَارْ الكُلْ عَالعْمَايِلْ الفَاسْدَة الِّي عَمْلُوهَا، وعَالكْلَامْ الِّي قَالُوهْ عْلِيهْ وهَانُوهْ بِيهْ المُذْنْبِينْ والفُجَّارْ». <verse eid="JUD 1:15" /><verse number="16" style="v" sid="JUD 1:16" />هُومَا دِيمَا يِتْشَكَّاوْ ويِتْبَكَّاوْ، ويْتَبْعُوا شْهَاوِيهُمْ. يِتْكَلْمُوا كْلَامْ كْبِيرْ بْفُخْرَة، ويْجَامْلُوا النَّاسْ بَاشْ يَقْضِيوْ بِيهُمْ مْصَالَحْهُمْ.<verse eid="JUD 1:16" /></para>
  <para style="s">أَحْفْظُوا رْوَاحْكُمْ فِي مْحَبِّةْ اللَّهْ</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17" />آمَا إِنْتُومَا يَا حْبَابِي، تْذَكْرُوا الِّي سْبَقْ وقَالُوهْ رُسُلْ رَبْنَا يَسُوعْ المَسِيحْ، <verse eid="JUD 1:17" /><verse number="18" style="v" sid="JUD 1:18" />إِنُّو فِي آخِرْ الزْمَانْ بِشْ يِطْلْعُوا نَاسْ يِتْمَسْخْرُوا عْلَى الرَّبْ ويْتَبْعُوا شْهَاوِيهُمْ الفَاسْدَة، <verse eid="JUD 1:18" /><verse number="19" style="v" sid="JUD 1:19" />ويِتْسَبْبُوا فِي الإِنْقِسَامَاتْ، ويِجْرِيوْ وْرَاء شْهَاوِي البْدَنْ ومَا فِيهُمْشْ الرُّوحْ القُدُسْ.<verse eid="JUD 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JUD 1:20" />آمَا إِنْتُومَا يَا حْبَابِي، إِبْنِيوْ حْيَاتْكُمْ عْلَى إِيمَانْكُمْ الطَّاهِرْ، وإِنْتُومَا تْصَلِّيوْ بِالرُّوحْ القُدُسْ، <verse eid="JUD 1:20" /><verse number="21" style="v" sid="JUD 1:21" />وأَحْفْظُوا رْوَاحْكُمْ فِي مْحَبِّةْ اللَّهْ، مِسْتَنِّينْ رَحْمِةْ رَبْنَا يَسُوعْ المَسِيحْ الِّي بِشْ تْعِيشُوا مْعَاهْ الحَيَاةْ الأَبَدِيَّة. <verse eid="JUD 1:21" /><verse number="22" style="v" sid="JUD 1:22" />أَرْحْمُوا النَّاسْ الِّي مَزَّالْ عَنْدْهُمْ شَكْ، <verse eid="JUD 1:22" /><verse number="23" style="v" sid="JUD 1:23" />ونَجِّيوْ الِّي قْرِيبْ يْطِيحُوا فِي النَّارْ وأَخْطْفُوهُمْ. إِسْخْفُوا عَالنَّاسْ الأُخْرِينْ، آمَا رُدُّوا بَالْكُمْ مِنْهُمْ وأَكْرْهُوا حَتَّى حْوَايِجْهُمْ الِّي نَجْسُوهَا بِفْسَادْهُمْ.<verse eid="JUD 1:23" /></para>
  <para style="s">حَمْدْ</para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24" />واللَّهْ هُوَّ الِّي قَادِرْ يَحْفَظْكُمْ بَاشْ مَا اطِّيحُوشْ فِي الذْنُوبْ، ويْجِيبْكُمْ قُدَّامُو فِي المَجْدْ، فَرْحَانِينْ ومَا عْلِيكُمْشْ لُومْ، <verse eid="JUD 1:24" /><verse number="25" style="v" sid="JUD 1:25" />هُوَّ وَحْدُو الإِلَاهْ الحْقِيقِي الِّي نَجَّانَا بْرَبْنَا يَسُوعْ المَسِيحْ. لِيهْ المَجْدْ والقُدْرَة والسْيَادَة والسُّلْطَة مِالأَزَلْ، وفِي الوَقْتْ الحَاضِرْ، ولِلْأَبَدْ. آمِينْ.<verse eid="JUD 1:25" /></para>
  <chapter eid="JUD 1" />
</usx>