<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id" />
  <para style="h">أَعْمَالْ</para>
  <para style="toc1">كْتَابْ أَعْمَالْ الرُّسُلْ</para>
  <para style="toc2">أَعْمَالْ</para>
  <para style="toc3">أَعْمَالْ</para>
  <para style="mt">كْتَابْ أَعْمَالْ الرُّسُلْ</para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="s">الوَعْدْ بِالرُّوحْ القُدُسْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />حْكِيتْلِكْ فِي كْتَابِي الأُوِّلْ، يَا ثَاوْفِيلُسْ، عْلَى كُلْ الحَاجَاتْ الِّي عْمَلْهَا يَسُوعْ وعَلِّمْهَا، مِالأُوِّلْ <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />حَتَّى لِلنْهَارْ الِّي تِرْفَعْ فِيهْ لِلسْمَاء، بَعْدْمَا عْطَى الوْصَايَا مْتَاعُو بِالرُّوحْ القُدُسْ لِلرُّسُلْ الِّي سْبَقْ واخْتَارْهُمْ، <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />وهُومَا الِّي ظْهُرِّلْهُمْ بَرْشَة مَرَّاتْ بَعْدْ مَا مَاتْ ولْمُدِّةْ أَرْبْعِينْ يُومْ، ووَرَّاهُمْ إِبَّرْشَة أَمَارَاتْ الِّي هُوَّ حَيْ، وحْكَالْهُمْ عْلَى مَمْلَكْةْ اللَّهْ. <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" />ومَرَّة، وَقْتِلِّي كَانْ يَاكِلْ مْعَاهُمْ، قَالِلْهُمْ: «مَا تِمْشِيوِشْ مِنْ أُورْشَلِيمْ، آمَا إِسْتَنَّاوْ حَتَّى يْتِمْ وَعْدْ الآبْ الِّي سْمَعْتُوهْ مِنْ عَنْدِي. <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />يُوحَنَّا عَمِّدْ النَّاسْ بِالمَاء آمَا إِنْتُومَا بِشْ تِتْعَمْدُوا بَعْدْ أَيَّامَاتْ بِالرُّوحْ القُدُسْ».<verse eid="ACT 1:5" /></para>
  <para style="s">يَسُوعْ يِطْلَعْ لِلسْمَاء</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />يَاخِي سِأْلُوهْ الِّي كَانُوا مْعَاهْ وَقْتْهَا: «يَا رَبْ، زَعْمَة فِي الوَقْتْ هَاذَا بِشْ تْرَجَّعْ المَمْلْكَة لْإِسْرَائِيلْ؟». <verse eid="ACT 1:6" /><verse number="7" style="v" sid="ACT 1:7" />جَاوِبْهُمْ يَسُوعْ: «مُشْ مَسْؤُولِيِّتْكُمْ بَاشْ تَعْرْفُوا الوَقْتْ والزْمَانْ الِّي حَطْهُمْ الآبْ بْسُلْطْتُو. <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />آمَا وَقْتِلِّي يَهْبِطْ عْلِيكُمْ الرُّوحْ القُدُسْ، بِشْ تَاخْذُوا قُوَّة، وتْكُونُولِي شْهُودْ فِي أُورْشَلِيمْ واليَهُودِيَّة الكُلْ وفِي السَّامْرَة وحَتَّى لْآخِرْ الأَرْضْ».<verse eid="ACT 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 1:9" />وكِي قَالْ الكْلَامْ هَاذَا، تِرْفَعْ لِلسْمَاء وهُومَا يُخْزْرُولُو، ومْبَعِّدْ، جَاء سْحَابْ وحِجْبُو مِنْ قُدَّامْ عِينِيهُمْ. <verse eid="ACT 1:9" /><verse number="10" style="v" sid="ACT 1:10" />ووَقْتِلِّي كَانُوا يُخْزْرُوا لِلسْمَاء وهُوَّ طَالْعِلْهَا، جَاوْ زُوزْ رْجَالْ لَابْسِينْ بِالأَبْيِضْ وِقْفُوا بَحْذَاهُمْ. <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />وقَالُولْهُمْ: «يَا رْجَالْ الجَلِيلْ، شْبِيكُمْ وَاقْفِينْ تُخْزْرُوا لِلسْمَاء؟ يَسُوعْ هَاذَا الِّي تِرْفَعْ لِلسْمَاء، بِشْ يِرْجَعْ مِنْهَا بْنَفْسْ الطَّرِيقَة الِّي شُفْتُوهْ طَالْعِلْهَا».<verse eid="ACT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />ومْبَعِّدْ، رَجْعُوا الرُّسُلْ لْأُورْشَلِيمْ مِالجْبَلْ المَعْرُوفْ بِجْبَلْ الزِّيتُونْ، الِّي هُوَّ قْرِيبْ مِنْ أُورْشَلِيمْ مْسَافِةْ كِيلُومَاتِرْ. <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />وَقْتِلِّي وُصْلُوا، طَلْعُوا لِلْعْلِي الِّي كَانُوا سَاكْنِينْ فِيهْ. وكَانُوا غَادِي بُطْرُسْ ويُوحَنَّا، ويَعْقُوبْ، وأَنْدَرَاوُسْ، وفِيلِۑُّسْ، وتُومَا، وبَرْثُلْمَاوُسْ، ومَتَّى، ويَعْقُوبْ وِلْدْ حَلْفَى، وسِمْعَانْ الِّي يْغِيرْ عْلَى بْلَادُو، ويَهُوذَا وِلْدْ يَعْقُوبْ. <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />وكَانُوا الكُلْهُمْ يْدَاوْمُوا عَالصَّلَاةْ بْقَلْبْ وَاحِدْ، ومْعَاهُمْ النْسَاء، ومَرْيِمْ أُمْ يَسُوعْ، وأَخْوْتُو.<verse eid="ACT 1:14" /></para>
  <para style="s">إِخْتِيَارْ مَتِّيَاسْ فِي بْلَاصِةْ يَهُوذَا</para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />وفِي الأَيَّامَاتْ هَاذُوكُمْ، وْقِفْ بُطْرُسْ قُدَّامْ أَخْوْتُو المُؤْمْنِينْ، الِّي كَانْ عْدَدْهُمْ قْرِيبْ لْـ120، وقَالِلْهُمْ: <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />«يَا خْوَاتِي، كَانْ لَازِمْ تِتْحَقَّقْ النُّبُوَّة الِّي قَالْهَا الرُّوحْ القُدُسْ عْلَى لْسَانْ النَّبِيْ دَاوِدْ، فِي مَا يْخُصْ يَهُوذَا الِّي دَلْ النَّاسْ عْلَى يَسُوعْ بَاشْ يْشِدُّوهْ. <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />هُوَّ كَانْ وَاحِدْ مِنَّا، وشَارِكْنَا فِي الخِدْمَة.<verse eid="ACT 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 1:18" />«وبَعْدْمَا شْرَى أَرْضْ بِالفْلُوسْ الِّي خْذَاهَا عَالشَّرْ الِّي عَمْلُو، طَاحْ فِيهَا عْلَى وِجْهُو، وتْشَقِّتْ كِرْشُو، وخَرْجِتْ مْصَارْنُو الكُلْ. <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />وسُكَّانْ أُورْشَلِيمْ الكُلْ عَرْفُوا الحْكَايَة، يَاخِي سَمَّاوْ السَّانْيَة بْلُوغِتْهُمْ "حَقْلْ دَمَخْ"، ومَعْنَاهَا سَانِيةْ الدَّمْ.<verse eid="ACT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20" />«ومَكْتُوبْ فِي كْتَابْ المَزَامِيرْ:</para>
  <para style="b" vid="ACT 1:20" />
  <para style="q1" vid="ACT 1:20">"خَلِّي دَارُو تْوَلِّي خِرْبَة،</para>
  <para style="q2" vid="ACT 1:20">ومَا يُسْكُنْهَا حَدْ".</para>
  <para style="b" vid="ACT 1:20" />
  <para style="m" vid="ACT 1:20">«وزَادَا:</para>
  <para style="b" vid="ACT 1:20" />
  <para style="q1" vid="ACT 1:20">"خَلِّي خِدْمْتُو يَاخِذْهَا غِيرُو".<verse eid="ACT 1:20" /></para>
  <para style="b" />
  <para style="m">
    <verse number="21" style="v" sid="ACT 1:21" />«مَالَا يِلْزِمْنَا نِخْتَارُوا وَاحِدْ مِالرْجَالْ الِّي رَافْقُونَا طُولْ المُدَّة الِّي عَدَّاهَا مْعَانَا الرَّبْ يَسُوعْ، <verse eid="ACT 1:21" /><verse number="22" style="v" sid="ACT 1:22" />مِاليُومْ الِّي تْعَمِّدْ فِيهْ عْلَى يْدِينْ يُوحَنَّا لِلْيُومْ الِّي تِرْفَعْ فِيهْ لِلسْمَاء، بَاشْ يْكُونْ شَاهِدْ مْعَانَا عْلَى قْيَامِةْ يَسُوعْ».<verse eid="ACT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />يَاخِي الإِخْوَة الحَاضْرِينْ إِقْتَرْحُوا زُوزْ رْجَالْ: يُوسِفْ المَعْرُوفْ بْإِسْمْ بَارْسَابَا ويْعَيْطُولُوا زَادَا يُوسْتُسْ، ومَتِّيَاسْ. <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />مْبَعِّدْ صَلَّاوْ وقَالُوا: «يَا رَبْ، إِنْتِ تَعْرِفْ قْلُوبْ النَّاسْ الكُلْ، وَرِّينَا أَنَاهُو الِّي اخْتَرْتُو مِالزُّوزْ رْجَالْ هَاذُومَا <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />بَاشْ يْشَارِكْنَا فِي الخِدْمَة ويْكُونْ رَسُولْ فِي عُوضْ يَهُوذَا الِّي مْشَى لِلبْلَاصَة الِّي يِسْتَاهِلْهَا». <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />وبَعْدْهَا عَمْلُوا قُرْعَة، طَاحِتْ عْلَى مَتِّيَاسْ، يَاخِي تْزَادْ لِلرُّسُلْ الحْدَاشْ.<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s">ظْهُورْ الرُّوحْ القُدُسْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />وَقْتِلِّي جَاء العِيدْ الِّي يْسَمْيوَهْ يُومْ الخَمْسِينْ، كَانُوا المُؤْمْنِينْ الكُلْ مُجْتَمْعِينْ مْعَ بْعَضْهُمْ فِي بُقْعَة وَحْدَة. <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />وإِذَا بْحِسْ جَاء مِالسْمَاء كَايِنُّو صُوتْ رِيحْ قْوِيْ، ومْلَى البِيتْ الِّي كَانُوا قَاعْدِينْ فِيهَا. <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />وظُهْرِتِّلْهُمْ لْسَانَاتْ كَايِنْهَا مِنْ نَارْ، تْفَرْقِتْ وحَطِّتْ عْلَى كُلْ وَاحِدْ فِيهُمْ. <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />وتِمْلَاوْ الكُلْ بِالرُّوحْ القُدُسْ، وبْدَاوْ يِتْكَلْمُوا بْلُوغَاتْ أُخْرَى، كِيمَا عْطَاهُمْ الرُّوحْ بَاشْ يَنْطْقُوا.<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />وفِي الوَقْتْ هَاذَاكَا، كَانُوا فِي أُورْشَلِيمْ جْمَاعَة مِاليْهُودْ الِّي يْخَافُوا اللَّهْ، ولِّي جَاوْ مِنْ كُلْ أُمَّة فِي الأَرْضْ. <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />وَقْتِلِّي سَمْعُوا الحِسْ هَاذَاكَا، تْلَمُّوا النَّاسْ عْلِيهُمْ وكَانُوا مِتْعَجْبِينْ، عْلَى خَاطِرْ كُلْ وَاحِدْ كَانْ يِسْمَعْ فِيهُمْ يِتْكَلْمُوا بْلُوغْتُو هُوَّ. <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />وبِهْتُوا وإِحْتَارُوا ووَلَّاوْ يِسْأْلُوا فِي بْعَضْهُمْ: «مُشْ الِّي قَاعْدِينْ يِتْكَلْمُوا الكُلْهُمْ مِالجَلِيلْ؟ <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />مَالَا كِيفَاشْ كُلْ وَاحِدْ مِنَّا قَاعِدْ يِسْمَعْ فِي لُوغِةْ البْلَادْ الِّي تُولِدْ فِيهَا؟ <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />مِنَّا بَرْثِيِّينْ ومَادِيِّينْ وعِيلَامِيِّينْ ومِنَّا مِنْ سُكَّانْ مَنْطَقْةْ مَا بِينْ النَّهْرِينْ واليَهُودِيَّة وكَبَّدُوكِيَّة، وبُنْطُسْ وآسِيَّا <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />وفَرِيجِيَّة وبَمْفِيلِيَّة ومَصْرْ ومِنْ بْقَايَعْ مِنْ لِيبْيَا مِنْ مَنْطَقْةْ قِيرِينَا ومْعَانَا بَرْشَة زُوَّارْ مِنْ رُومَا، <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />يْهُودْ أَصْلِيِّينْ ولِّي وَلَّاوْ يْهُودْ وكَرِيتِيِّينْ وعْرَبْ. وهَانَا الكُلْنَا نِسْمْعُوا فِيهُمْ يْكَلْمُوا فِينَا بْلُوغَاتْنَا عْلَى أَعْمَالْ اللَّهْ العْظِيمَة». <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />وبْدَاوْ الكُلْهُمْ يِسْأْلُوا فِي بْعَضْهُمْ وهُومَا مِسْتَغْرْبِينْ وحَايْرِينْ: «شْنِيَّة الحْكَايَة؟». <verse eid="ACT 2:12" /><verse number="13" style="v" sid="ACT 2:13" />آمَا نَاسْ أُخْرِينْ تْمَسْخْرُوا عْلِيهُمْ وقَالُوا: «النَّاسْ هَاذُومَا سْكَارَا».<verse eid="ACT 2:13" /></para>
  <para style="s">بُطْرُسْ يُخْطُبْ قُدَّامْ الحَاضْرِينْ</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />يَاخِي وْقِفْ بُطْرُسْ مْعَ الرُّسُلْ الحْدَاشْ، وقَالْ لِلْحَاضْرِينْ بْصُوتْ عَالِي: «يَا أَهْلْ اليَهُودِيَّة، ويَلِّي سَاكْنِينْ فِي أُورْشَلِيمْ الكُلْ، إِسْمْعُوا مْلِيحْ الكْلَامْ الِّي بِشْ نْقُولْهُولْكُمْ وأَعْرْفُوا حْقِيقِةْ الِّي قَاعِدْ يْصِيرْ. <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />هَاذُومَا مَاهُمْشْ سْكَارَا كِيمَا تْظُنُّوا، مَزَّالِتْ التِّسْعَة مْتَاعْ الصْبَاحْ! <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />آمَا هَاذَا هُوَّ الِّي قَالْ عْلِيهْ النَّبِيْ يُوئِيلْ: <verse eid="ACT 2:16" /><verse number="17" style="v" sid="ACT 2:17" />"يْقُولْ اللَّهْ:</para>
  <para style="b" vid="ACT 2:17" />
  <para style="q1" vid="ACT 2:17">فِي آخِرْ الزْمَانْ</para>
  <para style="q2" vid="ACT 2:17">بِشْ نْفِيضْ مِنْ رُوحِي عَالنَّاسْ الكُلْ،</para>
  <para style="q1" vid="ACT 2:17">ويِتْنَبْؤُوا وْلَادْكُمْ وبْنَاتْكُمْ،</para>
  <para style="q2" vid="ACT 2:17">ويْشُوفُوا شَبَابْكُمْ رُؤَى،</para>
  <para style="q1" vid="ACT 2:17">ويِحْلْمُوا كْبَارْكُمْ أَحْلَامْ.<verse eid="ACT 2:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ACT 2:18" />فِي الأَيَّامَاتْ هَاذُوكُمْ،</para>
  <para style="q1" vid="ACT 2:18">نْفِيضْ مِنْ رُوحِي عْلَى كُلْ خْدِيمَة وخْدِيمْ عَنْدِي،</para>
  <para style="q2" vid="ACT 2:18">ويِتْنَبْؤُوا.<verse eid="ACT 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19" />وبِشْ نَعْمِلْ عْجَايِبْ لْفُوقْ فِي السْمَاء،</para>
  <para style="q2" vid="ACT 2:19">وعَلَامَاتْ لُوطَا عَالأَرْضْ</para>
  <para style="q1" vid="ACT 2:19">دَمْ ونَارْ وبَرْشَة دُخَّانْ.<verse eid="ACT 2:19" /></para>
  <para style="q2">
    <verse number="20" style="v" sid="ACT 2:20" />وقْبَلْ مَا يْجِي يُومْ الرَّبْ،</para>
  <para style="q1" vid="ACT 2:20">هَاكْ النْهَارْ العْظِيمْ المَجِيدْ،</para>
  <para style="q2" vid="ACT 2:20">الشَّمْسْ تْوَلِّي ظْلَامْ،</para>
  <para style="q1" vid="ACT 2:20">والڨَمْرَة تْوَلِّي كِي الدَّمْ<verse eid="ACT 2:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="ACT 2:21" />وَقْتْهَا كُلْ مِنْ يُطْلُبْ إِسْمْ الرَّبْ يِنْجَى".<verse eid="ACT 2:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />«يَا رْجَالْ إِسْرَائِيلْ، إِسْمْعُوا الكْلَامْ هَاذَا: يَسُوعْ النَّاصْرِي، رَاجِلْ عْطَاهْ اللَّهْ مُعْجْزَاتْ وعْجَايِبْ وعَلَامَاتْ، عْمَلْهَا عْلَى يِدُّو قُدَّامْكُمْ، كِيمَا تَعْرْفُوا. <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />ومْعَ هَاذَا، سْمَحِّلْكُمْ اللَّهْ، حَسْبْ خُطْتُو المَرْسُومَة وعِلْمُو السَّابَقْ، بَاشْ تْشِدُّوهْ وتُصْلْبُوهْ وتُقْتْلُوهْ عْلَى يْدِينْ الأَشْرَارْ. <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />آمَا اللَّهْ قَيْمُو حَيْ، وكَسِّرْ سْلَاسِلْ المُوتْ، عْلَى خَاطِرْ مَا كَانِتْشْ المُوتْ تْنَجِّمْ تْشِدُّو. <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />وقَالْ عْلِيهْ دَاوِدْ:</para>
  <para style="b" vid="ACT 2:25" />
  <para style="q1" vid="ACT 2:25">"كُنْتْ نْشُوفْ فِي الرَّبْ دِيمَا قُدَّامِي،</para>
  <para style="q2" vid="ACT 2:25">هُوَّ دِيمَا مْعَايَا، بَاشْ مَنْخَافِشْ،<verse eid="ACT 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26" />هَاذَاكَا عْلَاشْ فْرَحْ قَلْبِي ولْسَانِي سَبَّحْ،</para>
  <para style="q2" vid="ACT 2:26">وحَتَّى بَدْنِي عَنْدُو رْجَى بَعْدْ المُوتْ،<verse eid="ACT 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27" />عْلَى خَاطِرْ مَاكِشْ بِشْ تْخَلِّينِي فِي الهَاوْيَة</para>
  <para style="q2" vid="ACT 2:27">ومَاكِشْ بِشْ تْخَلِّي قُدُّوسِكْ يِفْسِدْ فِي القْبَرْ.<verse eid="ACT 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28" />هْدِيتْنِي لِطْرِيقْ الحَيَاةْ،</para>
  <para style="q2" vid="ACT 2:28">وتِمْلَانِي بِالفَرْحَة وَقْتِلِّي نْكُونْ مْعَاكْ".<verse eid="ACT 2:28" /></para>
  <para style="b" />
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />«يَا خْوَاتِي، خَلِّينِي نْقُولِلْكُمْ بْصَرَاحَة، بُونَا دَاوِدْ مَاتْ وتِدْفِنْ، وقَبْرُو مَوْجُودْ عَنْدْنَا حَتَّى لِلْيُومْ. <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />وهُوَّ كَانْ نَبِيْ ويَعْرِفْ الِّي اللَّهْ حْلِفْلُو بِاليْمِينْ الِّي وَاحِدْ مِنْ ذُرِّيتُو بِشْ يُقْعُدْ عْلَى عَرْشُو. <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />وشَافْ قْيَامِةْ المَسِيحْ قْبَلْ مَا تْصِيرْ، وتْكَلَّمْ عْلِيهَا كِي قَالْ الِّي اللَّهْ مُشْ بِشْ يْخَلِّيهْ فِي الهَاوْيَة، ومُشْ بِشْ يْخَلِّي بَدْنُو يِفْسِدْ فِي القْبَرْ. <verse eid="ACT 2:31" /><verse number="32" style="v" sid="ACT 2:32" />يَسُوعْ هَاذَا قَوْمُو اللَّهْ مِالمُوتْ، وأَحْنَا الكُلْ شْهُودْ عْلَى هَاذَا. <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />وكِي رَفْعُو اللَّهْ بْقُدْرْتُو، خْذَا الرُّوحْ القُدُسْ الِّي وْعِدْ بِيهْ الآبْ، وفَاضْ بِيهْ عْلِينَا. ولِّي قَاعْدِينْ تْشُوفُوا فِيهْ وتِسْمْعُوا فِيهْ تَوَّا، هُوَّ النْتِيجَة. <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />ودَاوِدْ مَا طْلَعْشْ لِلسْمَاء، آمَا هُوَّ بِيدُو يْقُولْ:</para>
  <para style="b" vid="ACT 2:34" />
  <para style="q1" vid="ACT 2:34">"قَالْ اللَّهْ لْرَبِّي:</para>
  <para style="q2" vid="ACT 2:34">أُقْعُدْ عْلَى يْمِينِي،<verse eid="ACT 2:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ACT 2:35" />حَتَّى لِينْ نْحُطْ أَعْدَائِكْ</para>
  <para style="q2" vid="ACT 2:35">تَحْتْ سَاقِيكْ".<verse eid="ACT 2:35" /></para>
  <para style="b" />
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36" />«هَاذَاكَا عْلَاشْ، لَازِمْ بَنِي إِسْرَائِيلْ الكُلْ يَعْرْفُوا ويِتْأَكْدُوا الِّي اللَّهْ جْعَلْ يَسُوعْ هَاذَا، الِّي إِنْتُومَا صْلَبْتُوهْ، رَبْ ومَسِيحْ!»<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />وَقْتِلِّي سَمْعُوا الحَاضْرِينْ الكْلَامْ هَاذَا، ضَمِيرْهُمْ أَنَّبْهُمْ، وسِأْلُوا بُطْرُسْ وبْقِيِّةْ الرُّسُلْ: «يَا خْوَاتِي، آشْ نَعْمْلُوا؟». <verse eid="ACT 2:37" /><verse number="38" style="v" sid="ACT 2:38" />جَاوِبْهُمْ بُطْرُسْ: «تُوبُوا وخَلِّي كُلْ وَاحِدْ فِيكُمْ يِتْعَمِّدْ بْإِسْمْ يَسُوعْ المَسِيحْ، بَاشْ تِتْغْفَرْ ذْنُوبْكُمْ وهَكَّا تَاخْذُوا هِيبِةْ الرُّوحْ القُدُسْ. <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />عْلَى خَاطِرْ الوَعْدْ هَاذَا لِيكُمْ ولِوْلَادْكُمْ ولِلنَّاسْ البْعَادْ الكُلْ، لْكُلْ وَاحِدْ يَسْتَدْعِيهْ الرَّبْ إِلَاهْنَا».<verse eid="ACT 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40" />وكَانْ بُطْرُسْ يِشْهْدِلْهُمْ ويْشَجَّعْ فِيهُمْ إِبَّرْشَة كْلَامْ آخِرْ ويْقُولِلْهُمْ: «مَنّْعُوا رْوَاحْكُمْ مِالجِيلْ الفَاسِدْ هَاذَا». <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />ولِّي قِبْلُوا كْلَامُو تْعَمْدُوا. وتْزَادُوا لْمَجْمُوعِةْ المُؤْمْنِينْ فِي النْهَارْ هَاذَاكَا قْرَابِة الـ3 000 وَاحِدْ. <verse eid="ACT 2:41" /><verse number="42" style="v" sid="ACT 2:42" />وكَانُوا دِيمَا يِسْمْعُوا التَّعْلِيمْ الِّي يْعَلْمُوهْ الرُّسُلْ، ودِيمَا يِتْلَمُّوا مْعَ بْعَضْهُمْ ويِتْشَارْكُوا فِي كُلْ شَيْ، ويَقْسْمُوا الخُبْزْ ويِصَلِّيوْ. <verse eid="ACT 2:42" /><verse number="43" style="v" sid="ACT 2:43" />وصَارِتْ بَرْشَة مُعْجْزَاتْ وعْجَايِبْ عْلَى يْدِينْ الرُّسُلْ، خَلَّاتْ النَّاسْ الكُلْ بَاهْتِينْ ودَاهْشِينْ . <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />وكَانُوا المُؤْمْنِينْ الكُلْ مْعَ بْعَضْهُمْ، يِتْشَارْكُوا فِي كُلْ شَيْ: <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />يْبِيعُوا أَمْلَاكْهُمْ ولِّي يِكْسْبُوهْ، ويَقْسْمُوا الفْلُوسْ بِينَاتْهُمْ عْلَى قَدْ مَا يِحْتَاجْ كُلْ وَاحِدْ مِنْهُمْ. <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />وكَانُوا مْوَاظْبِينْ عَالحْضُورْ فِي الهَيْكِلْ كُلْ يُومْ بْقَلْبْ وَاحِدْ، ويَقْسْمُوا الخُبْزْ فِي الدْيَارْ، ويَاكْلُوا مْعَ بْعَضْهُمْ بْفَرْحَة وبْنِيَّة صَافْيَة. <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />وكَانُوا يْسَبْحُوا اللَّهْ، ولَاقِينْ القْبُولْ عَنْدْ النَّاسْ الكُلْ. وكَانْ الرَّبْ كُلْ يُومْ يْزِيدْ لِلْمَجْمُوعَة النَّاسْ الِّي يِنْجَاوْ بْإِيمَانْهُمْ بِالمَسِيحْ.<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s">المَشْلُولْ يِتْشْفَى</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />نْهَارْ مِالنْهَارَاتْ، مْشَى بُطْرُسْ ويُوحَنَّا لِلْهَيْكِلْ فِي وَقْتْ صْلَاةْ الثْلَاثَة مْتَاعْ العْشِيَّة. <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />وكَانْ بَحْذَا بَابْ الهَيْكِلْ الِّي يِتْسَمَّى بَابْ جْمِيلْ، رَاجِلْ مَشْلُولْ مِلِّي تُولِدْ، يْجِيبُوهْ النَّاسْ كُلْ يُومْ ويْحُطُّوهْ غَادِي ويُقْعُدْ يُطْلُبْ فِي الصَّدْقَة مِنْ عَنْدْ النَّاسْ الدَّاخْلِينْ. <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />ووَقْتِلِّي شَافْ بُطْرُسْ ويُوحَنَّا دَاخْلِينْ لِلْهَيْكِلْ، طْلَبْ مِنْهُمْ صَدْقَة. <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />يَاخِي خَزْرُولُوا بُطْرُسْ ويُوحَنَّا بِالڨْدَا وقَالُّو بُطْرُسْ: «أُخْزْرِلْنَا!». <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />خْزَرِّلْهُمْ، مَاشِي فِي بَالُو بِشْ يَاخِذْ مِنْهُمْ حَاجَة. <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />يَاخِي قَالُّو بُطْرُسْ: «لَا عَنْدِي فُضَّة ولَا ذْهَبْ، آمَا الِّي عَنْدِي نَعْطِيهُولِكْ: بْإِسْمْ يَسُوعْ المَسِيحْ النَّاصْرِي قُومْ وامْشِي!». <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />وشَدُّو مِنْ يِدُّو اليْمِينْ وقَوْمُو. وبِالوَقْتْ رَجْعِتْ القُوَّة فِي سَاقِيهْ وقْدَامُو. <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />ونَڨِّزْ ووْقِفْ وبْدَا يِمْشِي. ودْخَلْ مْعَاهُمْ لِلْهَيْكِلْ وهُوَّ يِمْشِي ويْنَڨِّزْ وطَايِرْ مِالفَرْحَة ويِحْمِدْ فِي اللَّهْ. <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />والحَاضْرِينْ الكُلْ شَافُوهْ يِمْشِي ويِحْمِدْ فِي اللَّهْ. <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />وعَرْفُوهْ الِّي هُوَّ الرَّاجِلْ المَشْلُولْ الِّي مِسْتَانِسْ يُقْعُدْ يُطْلُبْ قُدَّامْ بَابْ جْمِيلْ مْتَاعْ الهَيْكِلْ، يَاخِي بِهْتُوا وتْعَجْبُوا مِلِّي صَارْلُو.<verse eid="ACT 3:10" /></para>
  <para style="s">بُطْرُسْ يُخْطُبْ فِي الهَيْكِلْ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />وفِي الوَقْتْ الِّي كَانْ فِيهْ الرَّاجِلْ المَشْلُولْ شَادِدْ جْنَبْ بُطْرُسْ ويُوحَنَّا فِي أَقْوَاسْ الهَيْكِلْ المَعْرُوفَة بْأَقْوَاسْ سُلَيْمَانْ، تْلَمُّوا عْلِيهُمْ بَرْشَة نَاسْ وكَانُوا بَاهْتِينْ. <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />وَقْتِلِّي شَافْ بُطْرُسْ هَاذَا، قَالِلْهُمْ: «يَا بَنِي إِسْرَائِيلْ، عْلَاشْ بَاهْتِينْ مِلِّي صَارْ؟ وعْلَاشْ تُخْزْرُولْنَا تْقُولِشْ عْلِينَا أَحْنَا بْقُدْرِتْنَا وَلَّا بِالتَّقْوَى مْتَاعْنَا رَدِّينَا الرَّاجِلْ هَاذَا يِمْشِي؟ <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />رَاهُو إِلَاهْ إِبْرَاهِيمْ وإِسْحَاقْ ويَعْقُوبْ، إِلَاهْ جْدُودْنَا، هُوَّ الِّي مَجِّدْ خَادْمُو يَسُوعْ، الِّي إِنْتُومَا سَلَّمْتُوهْ لِلْمُوتْ ونْكَرْتُوهْ قُدَّامْ بِيلَاطُسْ رَغْمِلِّي كَانْ يْحِبْ يْسَيْبُو. <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" />إِنْتُومَا نْكَرْتُوا القُدُّوسْ الصَّالَحْ، وطْلَبْتُوا مِنْ بِلَاطُسْ بَاشْ يْسَامَحْ وَاحِدْ قَاتِلْ. <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />قْتَلْتُوا مَنْبَعْ الحَيَاةْ، آمَا اللَّهْ قَوْمُو مِالمُوتْ، وأَحْنَا شْهُودْ عْلَى هَاذَا. <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />والرَّاجِلْ هَاذَا الِّي تْشُوفُوا فِيهْ ولِّي تَعْرْفُوهْ رَجْعِتْلُو صَحْتُو عْلَى خَاطِرْ إِيمَانَّا بْإِسْمْ يَسُوعْ. الإِيمَانْ بْيَسُوعْ هُوَّ الِّي عْطَاهْ الصَّحَّة الكَامْلَة قُدَّامْكُمْ الكُلْ.<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />«آنَا نَعْرِفْ يَا خْوَاتِي، الِّي جَهْلْكُمْ هُوَّ الِّي خَلَّاكُمْ إِنْتُومَا وشْيُوخْكُمْ تِتْصَرْفُوا هَكَّا مْعَ المَسِيحْ. <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />آمَا هَكَّا، تَمِّمْ اللَّهْ الِّي وْحَى بِيهْ مِنْ قْبَلْ لِلأَنْبِيَاءْ الكُلْ، الِّي المَسِيحْ بِشْ يِتْعَذَّبْ. <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />مَالَا تُوبُوا وإِرْجْعُوا لِلَّهْ بَاشْ يِغْفْرِلْكُمْ ذْنُوبْكُمْ. <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />وتْجِيكُمْ أَيَّامَاتْ الفْرَجْ مِنْ عَنْدُو، ويَبْعْثِلْكُمْ مَرَّة أُخْرَى يَسُوعْ المَسِيحْ الِّي اخْتَارْهُولْكُمْ مِنْ قْبَلْ. <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />آمَا تَوَّا، لَازْمُو يُقْعُدْ فِي السْمَاء حَتَّى يْجِي الوَقْتْ الِّي يِتْصَلَّحْ فِيهْ كُلْ شَيْ، كِيمَا وْحَى اللَّهْ لِلأَنْبِيَاءْ الصَّالْحِينْ، مِنْ قْدِيمْ الزْمَانْ. <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />ومُوسَى قَالْ: "الرَّبْ إِلَاهْكُمْ بِشْ يِبْعْثِلْكُمْ نَبِيْ كِيفِي مِنْ بِينْ خْوَاتْكُمْ. إِسْمْعُوا كْلَامُو فِلِّي يْقُلْكُمْ عْلِيهْ الكُلْ. <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />آمَا الِّي مَا يِسْمَعْشْ كْلَامُو رَاهُو بِشْ يِتِمْحَى مِالشَّعْبْ". <verse eid="ACT 3:23" /><verse number="24" style="v" sid="ACT 3:24" />وزَادَا الأَنْبِيَاءْ الكُلْ، مِنْ صَمُوئِيلْ حَتَّى لِلِّي جَاوْ بَعْدُو، تْنَبْؤُوا عَالأَيَّامْ هَاذِي. <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />وإِنْتُومَا وْلَادْ الأَنْبِيَاءْ هَاذُومَا ووْلَادْ العَهْدْ الِّي عَمْلُو اللَّهْ مْعَ جْدُودْنَا، وَقْتِلِّي قَالْ لْإِبْرَاهِيمْ: "بِشْ نْبَارِكْ شْعُوبْ الأَرْضْ الكُلْ عْلَى طْرِيقْ ذِرِّيتِكْ". <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />واللَّهْ قَيِّمْ خَادْمُو وبْعَثْهُولْكُمْ لِيكُمْ إِنْتُومَا الأُولَانِينْ، بَاشْ يْبَارِكُّمْ ويْخَلِّي كُلْ وَاحِدْ فِيكُمْ يِرْجَعْ عَالشَّرْ الِّي يَعْمِلْ فِيهْ».<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s">بُطْرُسْ ويُوحَنَّا قُدَّامْ المَجْلِسْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />وَقْتِلِّي كَانْ بُطْرُسْ ويُوحَنَّا يْكَلْمُوا فِي الحَاضْرِينْ، جَاوْهُمْ الكَهَنَة وقَايِدْ حَرَسْ الهَيْكِلْ وجْمَاعَة مِالصَّدُّوقِيِّينْ. <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />وكَانُوا مِتْغَشْشِينْ مِنْ بُطْرُسْ ويُوحَنَّا عْلَى خَاطِرْ كَانُوا يْعَلْمُوا فِي النَّاسْ ويْقُولُوا الِّي المُوتَى بِشْ يْقُومُوا مِالمُوتْ مَادَامْ يَسُوعْ قَامْ. <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />يَاخِي شَدُّوهُمْ، وعْلَى خَاطِرْ الدِّنْيَا ظْلَامِتْ، حَطُّوهُمْ فِي الحَبْسْ حَتَّى لْغُدْوَة. <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />آمَا، بَرْشَة مِلِّي سَمْعُوا الكْلَامْ الِّي قَالُوهْ بُطْرُسْ ويُوحَنَّا أَمْنُوا. ووَلَّى عْدَدْ الرْجَالْ الِّي أَمْنُوا قْرَابِةْ الـ5 000.<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />ومِنْ غُدْوَة، تْلَمُّوا قَادِةْ اليْهُودْ والشْيُوخْ وعُلَمَاءْ الشَّرِيعَة فِي أُورْشَلِيمْ، <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />ومْعَاهُمْ حَنَّانْ الكَاهِنْ الكْبِيرْ، وقِيَافَا، ويُوحَنَّا، والإِسْكَنْدَرْ، وامَّالِي كْبَارْ الكَهَنَة الكُلْ. <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />وجَابُوا بُطْرُسْ ويُوحَنَّا فِي الوِسْطْ وسِأْلُوهُمْ: «بَانَا قُوَّة، وبِاسْمْ شْكُونْ عْمَلْتُوا هَاذَا؟». <verse eid="ACT 4:7" /><verse number="8" style="v" sid="ACT 4:8" />يَاخِي تِمْلَى بُطْرُسْ بِالرُّوحْ القُدُسْ وجَاوِبْهُمْ: «يَا قَادِةْ الشَّعْبْ وإِنْتُومَا يَا شْيُوخُو، <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />إِذَا كَانْكُمْ تِسْتَجْوْبُوا فِينَا اليُومْ عْلَى خَاطِرْ عْمَلْنَا الخِيرْ مْعَ وَاحِدْ مْرِيضْ، وتْحِبُّوا تَعْرْفُوا كِيفَاشْ بْرَا، <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />مَالَا أَعْرْفُوا، وخَلِّي شَعْبْ إِسْرَائِيلْ الكُلُّو يَعْرِفْ، الِّي المَشْلُولْ هَاذَا وَاقِفْ قُدَّامْكُمْ لَابَاسْ عْلِيهْ بْقُوِّةْ إِسْمْ يَسُوعْ المَسِيحْ النَّاصْرِي، الِّي صْلَبْتُوهْ ولِّي اللَّهْ قَوْمُو مِالمُوتْ. <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />يَسُوعْ هَاذَا:</para>
  <para style="b" vid="ACT 4:11" />
  <para style="q1" vid="ACT 4:11">هُوَّ الحَجْرَة الِّي رْفَضْتُوهَا إِنْتُومَا البَنَّايَا،</para>
  <para style="q2" vid="ACT 4:11">ولِّي وَلَّاتْ حَجْرِةْ السَّاسْ.<verse eid="ACT 4:11" /></para>
  <para style="b" />
  <para style="m">
    <verse number="12" style="v" sid="ACT 4:12" />«مَا فَمَّة نْجَاةْ كَانْ عْلَى طْرِيقُو هُوَّ، عْلَى خَاطِرْ مَا فَمَّة حَتَّى إِسْمْ آخِرْ عْطَاهْ اللَّهْ لِلنَّاسْ انَّجْمُوا نِنْجَاوْ بِيهْ».<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />وَقْتِلِّي شَافُوا الحَاضْرِينْ فِي المَجْلِسْ شَجَاعِةْ بُطْرُسْ ويُوحَنَّا، وعَرْفُوا الِّي هُومَا نَاسْ عَادِيِّينْ ومُشْ مِتْعَلْمِينْ، تْعَجْبُوا. وَقْتْهَا عَرْفُوا الِّي هُومَا كَانُوا مْعَ يَسُوعْ. <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />آمَا كِي شَافُوا المَشْلُولْ الِّي بْرَا وَاقِفْ مْعَاهُمْ، مَا لْقَاوْ مَا يْقُولُوا. <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />وَلَّاوْ أَمْرُوهُمْ بَاشْ يُخْرْجُوا مِالمَجْلِسْ، وقَعْدُوا يِتْشَاوْرُوا مْعَ بْعَضْهُمْ. <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />وقَالُوا: «آشْ نَعْمْلُوا مْعَ الزُّوزْ رْجَالْ هَاذُومَا؟ سُكَّانْ أُورْشَلِيمْ الكُلْ يَعْرْفُوا الِّي مُعْجْزَة كْبِيرَة صَارِتْ عْلَى يْدِيهُمْ، ومَا انَّجْمُوشْ نُنْكْرُوهَا. <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />آمَا بَاشْ الخْبَرْ مَا يْزِيدِشْ يِتِنْشَرْ، لَازِمْ نْهَدْدُوهُمْ بَاشْ مَا عَادِشْ يَحْكِيوْ لْحَتَّى حَدْ آخِرْ عَالإِسْمْ هَاذَا».<verse eid="ACT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18" />يَاخِي عَيْطُولْهُمْ وأَمْرُوهُمْ بَاشْ مَا عَادِشْ يَنْطْقُوا ولَا يْعَلْمُوا النَّاسْ بْإِسْمْ يَسُوعْ. <verse eid="ACT 4:18" /><verse number="19" style="v" sid="ACT 4:19" />آمَا بُطْرُسْ ويُوحَنَّا قَالُولْهُمْ: «أُحْكْمُوا إِنْتُومَا! شْنُوَّة الصْحِيحْ عَنْدْ اللَّهْ؟ نْطِيعُوكُمْ إِنْتُومَا وَلَّا نْطِيعُوا اللَّهْ؟ <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />وأَحْنَا، مَا انَّجْمُوشْ نُسْكْتُوا ومَا نَحْكِيوِشْ عَلِّي رِينَاهْ وسْمَعْنَاهْ». <verse eid="ACT 4:20" /><verse number="21" style="v" sid="ACT 4:21" />يَاخِي هَدْدُوهُمْ مَرَّة أُخْرَى، ومَا لْقَاوِشْ كِيفَاشْ يْعَاقْبُوهُمْ. وَلَّاوْ سَيْبُوهُمْ عْلَى خَاطِرْ خَافُوا مِالشَّعْبْ، الِّي كَانْ الكُلُّو يْمَجِّدْ فِي اللَّهْ عَلِّي صَارْ. <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />والرَّاجِلْ الِّي تِشْفَى بِالمُعْجْزَة كَانْ عُمْرُو فُوقْ الـ40 سْنَة.<verse eid="ACT 4:22" /></para>
  <para style="s">المُؤْمْنِينْ يْصَلِّيوْ</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />بَعْدْمَا تْسَيْبُوا، رَجْعُوا بُطْرُسْ ويُوحَنَّا لِصْحَابْهُمْ، وحْكَاوِلْهُمْ عْلَى كُلْ الِّي قَالُوهُولْهُمْ كْبَارْ الكَهَنَة والشْيُوخْ. <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />وكِي سَمْعُوا هَاذَا، بْدَاوْ يْصَلِّيوْ بْقَلْبْ وَاحِدْ قَالُوا: «يَا رَبْ، يَا خَالِقْ السْمَاء والأَرْضْ والبْحَرْ وكُلْ مَا فِيهُمْ، <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />إِنْتِ الِّي قُلْتْ بِالرُّوحْ القُدُسْ عْلَى لْسَانْ بُونَا وعَبْدِكْ دَاوِدْ:</para>
  <para style="b" vid="ACT 4:25" />
  <para style="q1" vid="ACT 4:25">"عْلَاشْ الأُمَمْ هَاجُوا؟</para>
  <para style="q2" vid="ACT 4:25">وتْآمْرُوا الشُّعُوبْ مِنْ غِيرْ فَايْدَة؟<verse eid="ACT 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26" />تْلَمُّوا مُلُوكْ الأَرْضْ ورُؤَسَاءْهَا،</para>
  <para style="q2" vid="ACT 4:26">وتْحَالْفُوا ضِدْ الرَّبْ ومَسِيحُو!".<verse eid="ACT 4:26" /></para>
  <para style="b" />
  <para style="m">
    <verse number="27" style="v" sid="ACT 4:27" />«وبِالفِعْلْ، الكْلَامْ هَاذَا تْحَقَّقْ، كِي تْحَالِفْ هِيرُودُسْ، وبِيلَاطُسْ البُنْطِي، واليْهُودْ والشُّعُوبْ الأُخْرِينْ، ضِدْ عَبْدِكْ القُدُّوسْ يَسُوعْ، الِّي إِنْتِ اخْتَرْتُو بَاشْ يْكُونْ المَسِيحْ. <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />وعَمْلُوا كُلْ الِّي إِنْتِ سْبَقْتْ وقَرَّرْتُو بْقُدْرْتِكْ وحِكْمْتِكْ. <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />وتَوَّا يَا رَبْ، شُوفْ كِيفَاشْ يْهَدْدُوا فِينَا، واعْطِينَا أَحْنَا عَبِيدِكْ القُوَّة بَاشْ نِتْكَلْمُوا بِكْلَامِكْ مِنْ غِيرْ خُوفْ. <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />ومِدْ يِدِّكْ واشْفِي، وخَلِّي مُعْجْزَاتْ وعْجَايِبْ تْصِيرْ بْإِسْمْ عَبْدِكْ القُدُّوسْ يَسُوعْ».<verse eid="ACT 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31" />وكِي كَمْلُوا الصْلَاةْ، تْزَلْزْلِتْ البْلَاصَة الِّي كَانُوا مَلْمُومِينْ فِيهَا، وتِمْلَاوْ الكُلْهُمْ بِالرُّوحْ القُدُسْ وبْدَاوْ يِتْكَلْمُوا بِكْلَامْ اللَّهْ مِنْ غِيرْ خُوفْ.<verse eid="ACT 4:31" /></para>
  <para style="s">المُؤْمْنِينْ يِتْشَارْكُوا فِي كُلْ شَيْ</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />والمُؤْمْنِينْ كَانُوا قَلْبْ وَاحِدْ ونَفْسْ وَحْدَة، ولِّي عَنْدُو حَاجَة مَا كَانِشْ يْقُولْ «هَاذِي مْتَاعِي وَحْدِي»، آمَا كَانُوا يِتْشَارْكُوا فِي كُلْ شَيْ عَنْدْهُمْ. <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />وكَانُوا الرُّسُلْ يِشْهْدُوا عْلَى قْيَامِةْ الرَّبْ يَسُوعْ بْقُوَّة كْبِيرَة، ونِعْمِةْ اللَّهْ العْظِيمَة كَانِتْ عْلِيهُمْ الكُلْ، <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />ومَا كَانْ حَدْ فِيهُمْ مُحْتَاجْ، عْلَى خَاطِرْ الِّي كَانُوا عَنْدْهُمْ دْيَارْ وَلَّا أَرَاضِي كَانُوا يْبِيعُوهُمْ ويْجِيبُوا فْلُوسْهُمْ، <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />ويْحُطُّوهُمْ عَنْدْ الرُّسُلْ، وهُومَا يْفَرْقُوا بْحَسْبْ حَاجِةْ كُلْ وَاحِدْ.<verse eid="ACT 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36" />وهَكَّا عْمَلْ يُوسِفْ، الِّي الرُّسُلْ سَمَّاوَهْ بَرْنَابَا (مَعْنَاهَا وِلْدْ التَّشْجِيعْ) وهُوَّ مِنْ عْشِيرِةْ لَاوِي، ومَوْلُودْ فِي قُبْرُصْ. <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />بَاعْ الأَرْضْ مْتَاعُو، وجَابْ فْلُوسْهَا وحَطْهُمْ عَنْدْ الرُّسُلْ.<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s">حَنَانْيَا وسَفِيرَة</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />وكَانْ فَمَّة رَاجِلْ إِسْمُو حَنَانْيَا، تْفَاهِمْ مْعَ مَرْتُو سَفِيرَة، وبَاعْ أَرْضْ كَانْ يِمْلِكْهَا، <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />ونَحَّى مِنْ فْلُوسْ البِيعَة وخَلَّاهُمْ لْرُوحُو، وكَانِتْ مَرْتُو فِي بَالْهَا. ومْبَعِّدْ جَابْ البَاقِي وحَطُّو قُدَّامْ الرُّسُلْ. <verse eid="ACT 5:2" /><verse number="3" style="v" sid="ACT 5:3" />يَاخِي قَالُّو بُطْرُسْ: «يَا حَنَانْيَا! عْلَاشْ خَلِّيتْ الشِّيطَانْ يَمْلَالِكْ قَلْبِكْ، وخَلَّاكْ تِكْذِبْ عَالرُّوحْ القُدُسْ، وتْخَبِّي لْرُوحِكْ فْلُوسْ مِنْ سُومْ الأَرْضْ؟ <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />يَاخِي مَا كَانِتْشْ بِشْ تِبْقَالِكْ لَوْ كَانْ مَا بِعْتْهَاشْ؟ وكِي بَعْتْهَا كُنْتْ تْنَجِّمْ تِتْصَرِّفْ فِي فْلُوسْهَا كِيمَا يُظْهُرْلِكْ. عْلَاشْ نْوِيتْ بَاشْ تْغُشْ؟ إِنْتِ مَا كْذِبْتِشْ عَالنَّاسْ آمَا كْذِبْتْ عْلَى اللَّهْ!». <verse eid="ACT 5:4" /><verse number="5" style="v" sid="ACT 5:5" />دُوبْ مَا سْمَعْ حَنَانْيَا الكْلَامْ هَاذَا، طَاحْ ومَاتْ عَالبْلَاصَة، والنَّاسْ الِّي سَمْعُوا بِيهْ خَافُوا بَرْشَة. <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />وجَاوْ شَبَابْ وكَفْنُوهْ، وهَزُّوا دِفْنُوهْ.<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />وبَعْدْ قْرَابِةْ ثْلَاثَة سْوَايَعْ، دَخْلِتْ مَرْتْ حَنَانْيَا، وهِيَّ مَا تَعْرَفْشْ الِّي صَارْ. <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />سْإِلْهَا بُطْرُسْ: «قُلِّي، يَاخِي بِالسُّومْ هَاذَا بَعْتُوا الأَرْضْ؟». جَاوْبِتُو: «إِيْ نْعَمْ، بِالسُّومْ هَاذَا». <verse eid="ACT 5:8" /><verse number="9" style="v" sid="ACT 5:9" />قَالِلْهَا بُطْرُسْ: «عْلَاشْ تْفَاهِمْتْ مْعَ رَاجْلِكْ بَاشْ تْجَرْبُوا رُوحْ الرَّبْ؟ آهُومَا الشَّبَابْ الِّي دِفْنُوا رَاجْلِكْ وَاقْفِينْ فِي البَابْ، وبِشْ يْهِزُّوكْ إِنْتِ زَادَا». <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />وبِالوَقْتْ طَاحِتْ عَنْدْ سَاقِينْ بُطْرُسْ ومَاتِتْ. كِي دَخْلُوا الشَّبَابْ لْقَاوْهَا مِيتَة، هَزُّوهَا ودِفْنُوهَا بَحْذَا رَاجِلْهَا. <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />وخَافُوا المُؤْمْنِينْ الكُلْ، وزَادَا النَّاسْ الِّي سَمْعُوا الخْبَرْ.<verse eid="ACT 5:11" /></para>
  <para style="s">مُعْجْزَاتْ وعْجَايِبْ فِي وِسْطْ الشَّعْبْ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />وصَارِتْ عْلَى يْدِينْ الرُّسُلْ بَرْشَة مُعْجْزَاتْ وعْجَايِبْ فِي وِسْطْ الشَّعْبْ. وكَانُوا الكُلْهُمْ يِتْلَمُّوا بْقَلْبْ وَاحِدْ فِي الهَيْكِلْ وِينْ أَقْوَاسْ سُلَيْمَانْ. <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />وحَتَّى حَدْ مِلِّي مَا كَانُوشْ تَابْعِينْهُمْ مَا تْشَجَّعْ بَاشْ يْوَلِّي مْعَاهُمْ. آمَا الشَّعْبْ كَانْ يْقَدِّرْهُمْ. <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />وكَانْ عْدَدْ الِّي يَمْنُوا بِالرَّبْ مِالرْجَالْ والنْسَاء يِمْشِي ويْزِيدْ. <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />وكَانُوا النَّاسْ يْهِزُّوا المُرْضَى ويْحُطُّوهُمْ عْلَى فْرُوشَاتْ وحْصُرْ فِي الشَّارَعْ وَقْتِلِّي يِتْعَدَّى بُطْرُسْ، فَمَّاشْ مَا يْجِي ظِلُّو عْلَى جْمَاعَة مِنْهُمْ، ويِبْرَاوْ. <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />وبَرْشَة نَاسْ مِالدْشُرْ القْرِيبَة لْأُورْشَلِيمْ كَانُوا يْجِيبُوا المُرْضَى ولِّي مْعَذْبِتْهُمْ الأَرْوَاحْ الشِّرِّيرَة، وكَانُوا الكُلْهُمْ يِبْرَاوْ.<verse eid="ACT 5:16" /></para>
  <para style="s">اليْهُودْ يِضْطَهْدُوا فِي الرُّسُلْ</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />يَاخِي الكَاهِنْ الكْبِيرْ وجْمَاعْتُو التَّابْعِينْ لْمَذْهِبْ الصَّدُّوقِيِّينْ كْلَاتْهُمْ الغِيرَة مِالرُّسُلْ. <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />وَلَّاوْ شَدُّوهُمْ وحَطُّوهُمْ فِي الحَبْسْ. <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />آمَا مَلَاكْ مِنْ عَنْدْ الرَّبْ حَلْ بِيبَانْ الحَبْسْ فِي اللِّيلْ، وسَيَّبْهُمْ وقَالِلْهُمْ: <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />«إِمْشِيوْ آقْفُوا فِي الهَيْكِلْ، وأَحْكِيوْ لِلنَّاسْ عْلَى بْشَارِةْ الحَيَاةْ الجْدِيدَة كَامْلَة». <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />سَمْعُوا كْلَامُو، ومْشَاوْ لِلْهَيْكِلْ مْعَ الفَجْرْ وبْدَاوْ يْعَلْمُوا.</para>
  <para style="p" vid="ACT 5:21">وجَاء الكَاهِنْ الكْبِيرْ وجْمَاعْتُو، وعْمَلْ إِجْتِمَاعْ مْعَ المَجْلِسْ الأَعْلَى، حَضْرُوا فِيهْ شْيُوخْ إِسْرَائِيلْ الكُلْ، وأَمْرُوا بَاشْ يْجِيبُوا الرُّسُلْ مِالحَبْسْ. <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />آمَا كِي وِصْلُوا الِّي بَعْثُوهُمْ لِلحَبْسْ مَا لْقَاوْهُمْشْ، وَلَّاوْ رَجْعُوا لِلمَجْلِسْ وقَالُوا: <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />«لْقِينَا بِيبَانْ الحَبْسْ مْسَكْرَة بِالڨْدَا، والعَسَّاسَة وَاقْفِينْ قُدَّامْهُمْ. آمَا وَقْتِلِّي حَلِّينَاهُمْ مَا لْقِينَا حَتَّى حَدْ لْدَاخِلْ». <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />وَقْتِلِّي سْمَعْ قَايِدْ حَرَسْ الهَيْكِلْ، وكْبَارْ الكَهَنَة الكْلَامْ هَاذَا، بِهْتُوا وبْدَاوْ يِسْأْلُوا فِي بْعَضْهُمْ: «زَعْمَة شْنُوَّة الِّي صَارْ؟». <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />وجَاء رَاجِلْ وقَالِلْهُمْ: «الرْجَالْ الِّي حَطِّيطُوهُمْ فِي الحَبْسْ وَاقْفِينْ فِي الهَيْكِلْ يْعَلْمُوا فِي النَّاسْ!».<verse eid="ACT 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 5:26" />وَلَّى مْشَى قَايِدْ حَرَسْ الهَيْكِلْ هُوَّ والحَرَسْ، وجَابُوا الرُّسُلْ بِالسْيَاسَة، عْلَى خَاطِرْ خَافُوا لَا الشَّعْبْ يُرْجُمْهُمْ كَانْ جَابُوهُمْ بِالقُوَّة. <verse eid="ACT 5:26" /><verse number="27" style="v" sid="ACT 5:27" />وَقْتِلِّي دَخّْلُوهُمْ قُدَّامْ المَجْلِسْ، قَالِلْهُمْ الكَاهِنْ الكْبِيرْ: <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />«نَبَّهْنَا عْلِيكُمْ بَاشْ مَا تْعَلْمُوشْ بِالإِسْمْ هَاذَا، آمَا إِنْتُومَا مْلِيتُوا أُورْشَلِيمْ بْتَعْلِيمْكُمْ، وتْحِبُّوا تْحَمْلُونَا أَحْنَا مَسْؤُولِيِّةْ قَتْلَانْ الرَّاجِلْ هَاذَا!». <verse eid="ACT 5:28" /><verse number="29" style="v" sid="ACT 5:29" />يَاخِي بُطْرُسْ والرُّسُلْ جَاوْبُوا: «لَازِمْنَا نْطِيعُوا اللَّهْ مُشْ النَّاسْ. <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />إِلَاهْ جْدُودْنَا قَيِّمْ يَسُوعْ الِّي إِنْتُومَا عَلَّقْتُوهْ عْلَى لُوحَة وقْتَلْتُوهْ. <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />واللَّهْ كِرْمُو وحَطُّو عْلَى يْمِينُو، بَاشْ يْكُونْ هُوَّ المَلِكْ والمُنَجِّي، بَاشْ يَعْطِي لْبَنِي إِسْرَائِيلْ التَّوْبَة وغُفْرَانْ الذْنُوبْ. <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />وأَحْنَا شْهُودْ عْلَى هَاذَا، والرُّوحْ القُدُسْ الِّي عْطَاهْ اللَّهْ لِلنَّاسْ الِّي يْطِيعُوهْ، يِشْهِدْ زَادَا».<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />وكِي سَمْعُوا الِّي فِي المَجْلِسْ الكْلَامْ هَاذَا تْغَشْشُوا بَرْشَة وحَبُّوا يُقْتْلُوا الرُّسُلْ. <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />آمَا وْقِفْ وَاحِدْ مِنْهُمْ إِسْمُو غَمَالَائِيلْ، وهُوَّ فِرِّيسِي مِلِّي يْعَلْمُوا فِي الشَّرِيعَة، والنَّاسْ الكُلْ تِحْتَرْمُو، وأْمَرْ بَاشْ يْخَرْجُوا الرُّسُلْ شْوَيَّة. <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />ومْبَعِّدْ قَالْ لِلمَجْلِسْ: «يَا بَنِي إِسْرَائِيلْ، رُدُّوا بَالْكُمْ تَعْمْلُوا الِّي نَاوِينْ تَعْمْلُوهْ فِي الرْجَالْ هَاذُمْ. <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />رَاهُو قْبَلْ بْمُدَّة، جَاء وَاحِدْ إِسْمُو ثُودَاسْ وعْمَلْ رُوحُو زَعْمَة إِنْسَانْ عْظِيمْ، وتَبْعُوهْ 400 رَاجِلْ. آمَا نْهَارِةْ الِّي تِقْتَلْ، الِّي تَبْعُوهْ الكُلْ تْفَرْقُوا، ووْفَاتْ حْكَايْتُو. <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />وبَعْدُو، فِي وَقْتْ حِسْبَانْ الشَّعْبْ، جَاء يَهُوذَا الجَلِيلِي ومْشَاوْ فِي جُرْتُو بَرْشَة نَاسْ. آمَا هُوَّ زَادَا تِقْتَلْ، وتْفَرْقُوا الِّي تَبْعُوهْ الكُلْ. <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />وآنَا نَنْصَحْكُمْ بَاشْ تِبْعْدُوا عْلَى الرْجَالْ هَاذُومَا ومَا تِهْتَمُّوشْ بِيهُمْ. وإِذَا كَانِتْ أَفْكَارْهُمْ وأَعْمَالْهُمْ مِنْ عَنْدْ النَّاسْ، رَاهِي بِشْ تِفْشِلْ. <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />آمَا إِذَا كَانِتْ بِالحَقْ مِنْ عَنْدْ اللَّهْ، رَاكُمْ مَا تْنَجْمُوشْ تْوَقْفُوهُمْ، والَّا تْوَلِّيوْ إِنْتُومَا أَعْدَاءْ لِلَّهْ زَادَا».<verse eid="ACT 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 5:40" />يَاخِي عْمَلْ المَجْلِسْ بِنْصِيحْتُو واسْتَدْعَاوْ الرُّسُلْ وجِلْدُوهُمْ وأَمْرُوهُمْ بَاشْ مَا عَادِشْ يْعَلْمُوا بْإِسْمْ يَسُوعْ، وبَعْدْ سَيْبُوهُمْ. <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />وخَرْجُوا الرُّسُلْ مِالمَجْلِسْ فَرْحَانِينْ عْلَى خَاطِرْ اللَّهْ اعْتَبَرْهُمْ أَهْلْ بَاشْ يِتْهَانُوا فِي جُرِّةْ إِسْمْ يَسُوعْ. <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />وكَانُوا كُلْ يُومْ فِي الهَيْكِلْ وفِي الدْيَارْ، يْعَلْمُوا ويْبَشْرُوا الِّي يَسُوعْ هُوَّ المَسِيحْ.<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s">الرُّسُلْ يِخْتَارُوا شْكُونْ يْعَاوِنْهُمْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />وفِي الأَيَّامَاتْ هَاذُوكُمْ، كِي زَادُوا كُثْرُوا التْلَامْذَة، تْشَكَّاوْ المُؤْمْنِينْ اليُونَانِيِّينْ مِالمُؤْمْنِينْ العِبْرَانِيِّينْ، عْلَى خَاطِرْ هَجَّالَاتْهُمْ مَا كَانُوشْ يَاخْذُوا فِي بَايْهُمْ مِالإِعَانَاتْ الِّي تِتْفَرَّقْ كُلْ يُومْ. <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />يَاخِي الرُّسُلْ الأَثْنَاشْ اسْتَدْعَاوْ التْلَامْذَةْ وقَالُولْهُمْ: «مَا يْجِيشْ نْسَلْمُوا فِي تَعْلِيمْ كِلْمِةْ اللَّهْ ونِتِلْهَاوْ نْفَرْقُوا فِي المَاكْلَة. <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />مَالَا، إِخْتَارُوا مِنْكُمْ سَبْعَة رْجَالْ، سُمْعِتْهُمْ بَاهْيَة ومِلْيَانِينْ بِالرُّوحْ القُدُسْ والحِكْمَة، خَلِّي نْكَلْفُوهُمْ بِالخِدْمَة هَاذِي. <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />وأَحْنَا نْرَكْزُوا عَالصْلَاةْ وخِدْمِةْ الكِلْمَة». <verse eid="ACT 6:4" /><verse number="5" style="v" sid="ACT 6:5" />الإِقْتِرَاحْ هَاذَا عْجِبْ التْلَامْذَة الكُلْ، واخْتَارُوا اسْتِفَانُوسْ، رَاجِلْ مِلْيَانْ بِالإِيمَانْ وبِالرُّوحْ القُدُسْ، وفِيلِۑُّسْ، وبُرُوخُورُسْ ونِيكَانُورْ، وتِيمُونْ، وبَرْمِينَاسْ ونِيقُولَاوُسْ الأَنْطَاكِي الِّي وَلَّى يْهُودِي قْبَلْ مَا يْوَلِّي مَسِيحِي. <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />وجَابُوهُمْ ووَقْفُوهُمْ قُدَّامْ الرُّسُلْ. يَاخِي صَلَّاوْ وحَطُّوا عْلِيهُمْ يْدِيهُمْ.<verse eid="ACT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7" />وكَانِتْ كِلْمِةْ اللَّهْ تِنْتَشِرْ فِيسَعْ، وعْدَدْ التْلَامْذَةْ فِي أُورْشَلِيمْ يْزِيدْ، وبَرْشَة كَهَنَة طَاعُوا وأَمْنُوا بْيَسُوعْ المَسِيحْ.<verse eid="ACT 6:7" /></para>
  <para style="s">اسْتِفَانُوسْ يِتْشَدْ</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />وكَانْ اسْتِفَانُوسْ مِلْيَانْ بِالنِّعْمَة والقُوَّة، وكَانْ يَعْمِلْ فِي عْجَايِبْ ومُعْجْزَاتْ كْبِيرَة وِسْطْ الشَّعْبْ. <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />يَاخِي جَاوْ ضِدُّو جْمَاعَة مِالمَعْبِدْ الِّي مْسَمِّينُو مَعْبِدْ العَبِيدْ الِّي تْحَرْرُوا، ومْعَاهُمْ يْهُودْ مِنْ قِيرِينَا والإِسْكَنْدَرِيَّة ومِنْ مَنْطَقْةْ كِيلِيكِيَّا وآسِيَّا، وبْدَاوْ يْنَاقْشُوا فِي اسْتِفَانُوسْ. <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />آمَا مَا نَجْمُوشْ يِغْلْبُوا الحِكْمَة الِّي عْطَاهَالُو الرُّوحْ القُدُسْ فِي الكْلَامْ. <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />وَلَّاوْ رْشَاوْ جْمَاعَة بَاشْ يْقُولُوا: «سْمَعْنَا اسْتِفَانُوسْ يْقُولْ كْلَامْ كُفْرْ عْلَى مُوسَى وعْلَى اللَّهْ». <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />وهَكَّا هَيْجُوا الشَّعْبْ والشْيُوخْ وعُلَمَاءْ الشَّرِيعَة عْلَى اسْتِفَانُوسْ، وشَدُّوهْ وجَابُوهْ قُدَّامْ المَجْلِسْ الأَعْلَى، <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />وجَابُوا شْهُودْ زُورْ يْقُولُوا: «الرَّاجِلْ هَاذَا دِيمَا يِتْكَلَّمْ ضِدْ الهَيْكِلْ وضِدْ الشَّرِيعَة. <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />وسْمَعْنَاهْ يْقُولْ الِّي يَسُوعْ النَّاصْرِي بَاشْ يِهِدْ الهَيْكِلْ ويْبَدِّلْ العَادَاتْ الِّي خْذِينَاهَا مِنْ عَنْدْ مُوسَى». <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />وَقْتِلِّي النَّاسْ الِّي فِي المَجْلِسْ خَزْرُوا لِاسْتِفَانُوسْ، شَافُوا وِجْهُو كَايِنُّو وِجْهْ مْلَايْكَة.<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s">اسْتِيفَانُوسْ يُخْطُبْ قُدَّامْ المَجْلِسْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />يَاخِي سِأْلُو الكَاهِنْ الكْبِيرْ: «صْحِيحْ الِّي مِتَّهْمِينِكْ بِيهْ؟». <verse eid="ACT 7:1" /><verse number="2" style="v" sid="ACT 7:2" />جَاوْبُو: «يَا خْوَاتِي ويَا شْيُوخْنَا، إِسْمْعُونِي! إِلَاهْ المَجْدْ ظْهُرْ لْبُونَا إِبْرَاهِيمْ وهُوَّ فِي بْلَادْ مَا بِينْ النَّهْرِينْ، قْبَلْ مَا يُسْكُنْ فِي مْدِينِةْ حَارَانْ، <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />وقَالُّو: "خَلِّي أَرْضِكْ وأَهْلِكْ وامْشِي لِلْأَرْضْ الِّي بِشْ نْوَرِّيهَالِكْ". <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />ورْحَلْ مِنْ بْلَادْ الكِلْدَانِيِّينْ وسْكِنْ فِي حَارَانْ لِينْ مَاتْ بُوهْ، وبَعْدْ جَابُو اللَّهْ لِلبْلَادْ هَاذِي الِّي تُسْكْنُوا فِيهَا تَوَّا. <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />ومَا وَرّْثُو شَيْ مِنْهَا ولَا حَتَّى شْبِرْ. آمَا وِعْدُو بِشْ يَعْطِيهَالُو لِيهْ ولْذُرِّيتُو مِنْ بَعْدُو، رَغْمِلِّي وَقْتْهَا مَا كَانِشْ عَنْدُو وْلَادْ.<verse eid="ACT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 7:6" />«واللَّهْ قَالُّو: "ذُرِّيتِكْ بِشْ يِتْغَرْبُوا فِي بْلَادْ مَاهِيشْ بْلَادْهُمْ، وامَّالِيهَا بِشْ يِسْتَعِبْدُوهُمْ ويْذِلُّوهُمْ مُدِّةْ 400 سْنَة. <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />آمَا آنَا بِشْ نْعَاقِبْ الشَّعْبْ الِّي يِسْتَعْبِدْهُمْ. وبَعْدْهَا، يُخْرْجُوا مِالبْلَادْ هَاذِيكَا ويْجِيوْ يِعْبْدُونِي فِي البْلَاصَة هَاذِي". <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />وطْلَبْ اللَّهْ مِنْ إِبْرَاهِيمْ بَاشْ يْطَهِّرْ الذْكُورَة الِّي فِي عَايِلْتُو عَلَامَة لِلعَهْدْ الِّي عَمْلُو مْعَاهْ. وهَكَّا وَقْتِلِّي تُولِدْ إِسْحَاقْ، طَهْرُو فِي النْهَارْ الثَّامِنْ، وإِسْحَاقْ طَهِّرْ وِلْدُو يَعْقُوبْ، ويَعْقُوبْ طَهِّرْ ولَادُو الأَثْنَاشْ، الِّي هُومَا جْدُودْنَا الأُولَانِينْ.<verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />«وجْدُودْنَا الأُولَانِينْ حِسْدُوا يُوسِفْ وبَاعُوهْ، ووَلَّى عَبْدْ فِي مَصْرْ. آمَا اللَّهْ كَانْ مْعَاهْ، <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />ومَنّْعُو مِالمَشَاكِلْ الِّي صَارِتْلُو الكُلْ، وعْطَاهْ نِعْمَة وحِكْمَة قُدَّامْ فَرْعُونْ مَلِكْ مَصْرْ. يَاخِي رَدُّو فَرْعُونْ مَسْؤُولْ عْلَى مَصْرْ وعْلَى قَصْرُو.<verse eid="ACT 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 7:11" />«وصَارِتْ بَعْدْهَا مَجَاعَة فِي مَصْرْ الكُلْ وفِي أَرْضْ كَنْعَانْ، وعَانَاوْ جْدُودْنَا مِنْ ضِيقْ كْبِيرْ ومَا لْقَاوْ مَا يَاكْلُوا. <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />وكِي سْمَعْ يَعْقُوبْ الِّي فَمَّة قَمْحْ فِي مَصْرْ، بْعَثِّلْهَا جْدُودْنَا المَرَّة الأُولَى. <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />وفِي المَرَّة الثَّانْيَة، يُوسِفْ عَرِّفْهُمْ بْرُوحُو، وهَكَّا فَرْعُونْ وَلَّى يَعْرِفْ أَصْلْ يُوسِفْ مْنِينْ. <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />وبْعَثْ يُوسِفْ جَابْ بُوهْ يَعْقُوبْ، وجَابْ أَهْلُو وامَّالِيهْ الكُلْ لْمَصْرْ، وكَانُوا 75 وَاحِدْ. <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />وهْبَطْ يَعْقُوبْ وجْدُودْنَا لْمَصْرْ، وقَعْدُوا فِيهَا حَتَّى لِينْ مَاتُوا. <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />ونَقّْلُوهُمْ لْمَنْطَقْةْ شَكِيمْ، ودِفْنُوهُمْ غَادِي، فِي القْبَرْ الِّي شْرَاهْ إِبْرَاهِيمْ مِنْ أَوْلَادْ حَمُورْ بِشْوَيَّة فُضَّة.<verse eid="ACT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />«وكِي قْرُبْ الوَقْتْ الِّي بِشْ يْتَمِّمْ فِيهْ اللَّهْ وَعْدُو لِإِبْرَاهِيمْ، كَانْ شَعْبْنَا فِي مَصْرْ يُكْثُرْ ويْزِيدْ فِي العْدَدْ. <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />مْبَعِّدْ جَاء مَلِكْ جْدِيدْ عْلَى مَصْرْ، مَا كَانِشْ يَعْرِفْ حْكَايِةْ يُوسِفْ. <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />يَاخِي دَارْ عْلَى شَعْبْنَا وذَلْ جْدُودْنَا، ولَزْهُمْ بَاشْ يْسَلْمُوا فِي وْلَادْهُمْ ويْخَلِّيوْهُمْ يْمُوتُوا. <verse eid="ACT 7:19" /><verse number="20" style="v" sid="ACT 7:20" />وفِي الوَقْتْ هَاذَاكَا تُولِدْ مُوسَى، وكَانْ مِزْيَانْ بَرْشَة، وتْرَبَّى مْعَ أُمُّو وبُوهْ لْمُدِّةْ ثْلَاثَة شْهُورْ. <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />آمَا وَقْتِلِّي تْلَزُّوا بَاشْ يْسَلْمُوا فِيهْ، بِنْتْ فَرْعُونْ مَنْعِتُّو ورَبَّاتُو كِي وِلْدْهَا. <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />وتْعَلِّمْ مُوسَى كُلْ حِكْمِةْ المَصْرِيِّينْ، حَتَّى وَلَّى عْظِيمْ فِي القَوْلْ والفِعْلْ.<verse eid="ACT 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23" />«وَقْتِلِّي وَلَّى عُمْرُو أَرْبْعِينْ سْنَة، جَاء عْلَى بَالُو بَاشْ يْزُورْ خْوَاتُو الِّي هُومَا بَنِي إِسْرَائِيلْ. <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />وشَافْ مَصْرِي قَاعِدْ يُضْرِبْ فِي وَاحِدْ مِنْهُمْ، حَبْ يْحَامِي عْلِيهْ ويَاخُولُو حَقُّو، يَاخِي قْتَلْ المَصْرِي. <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />ومْشَى فِي بَالُو خْوَاتُو بِشْ يِفِهْمُوا الِّي اللَّهْ يْحِبْ يْنَجِّيهُمْ عْلَى طْرِيقُو، آمَا هُومَا مَا فِهْمُوشْ. <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />ومِنْ غُدْوَة، لْقَى زُوزْ مِنْ خْوَاتُو يِتْعَارْكُوا، وحَبْ يْصَلَّحْ بِينَاتْهُمْ، يَاخِي قَالِلْهُمْ: "رَاكُمْ خْوَاتْ، عْلَاشْ تَعْمْلُوا هَكَّا فِي بْعَضْكُمْ؟" <verse eid="ACT 7:26" /><verse number="27" style="v" sid="ACT 7:27" />وإِذَا بِالرَّاجِلْ الظَّالِمْ دَزْ مُوسَى وقَالُّو: "شْكُونْ حَطِّكْ حَاكِمْ وقَاضِي عْلِينَا؟ <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />تْحِبْ تُقْتُلْنِي كِيمَا قْتَلْتْ المَصْرِي البَارَحْ؟". <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />كِي سْمَعْ مُوسَى الكْلَامْ هَاذَا، هْرَبْ وتْغَرِّبْ فِي أَرْضْ مِدْيَانْ، وجَابْ فِيهَا زُوزْ وْلَادْ.<verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />«وبَعْدْ 40 سْنَة، فِي صَحْرِةْ جْبَلْ سِينَاءْ، ظْهُرْلُو مَلَاكْ فِي وِسْطْ نَارْ شَاعْلَة فِي شَجْرِةْ عِلِّيقْ. <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />تْعَجِّبْ مُوسَى مِالمَنْظِرْ هَاذَا، وبْدَا يُقْرُبْ بَاشْ يْثَبِّتْ، وسْمَعْ صُوتْ الرَّبْ يْقُلُّو: <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />"آنَا إِلَاهْ جْدُودِكْ، إِلَاهْ إِبْرَاهِيمْ وإِسْحَاقْ ويَعْقُوبْ". يَاخِي مُوسَى تِرْعِبْ ومَا نَجَّمْشْ حَتَّى يُغْزِرْ، <verse eid="ACT 7:32" /><verse number="33" style="v" sid="ACT 7:33" />قَالُّو الرَّبْ: "نَحِّي صَنْدَالِكْ، رَاهِي البْلَاصَة الِّي إِنْتِ وَاقِفْ فِيهَا أَرْضْ مُقَدْسَة. <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />آنَا رِيتْ ذُلْ شَعْبِي فِي مَصْرْ، وسْمَعْتْ تَنْهِيدْهُمْ، وهْبَطْتْ بَاشْ نْمَنَّعْهُمْ. وتَوَّا، إِيجَا نِبَعْثِكْ لْمَصْرْ".<verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />«مُوسَى هَاذَا الِّي شَعْبُو رَفْضُو وقَالُّو: "شْكُونْ حَطِّكْ حَاكِمْ وقَاضِي عْلِينَا؟" هُوَّ الِّي اللَّهْ بَعْثُو عْلَى طْرِيقْ المَلَاكْ الِّي ظْهُرْلُو فِي العُلِّيقَة بَاشْ يْقُودْهُمْ ويْحَرِّرْهُمْ. <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />وهُوَّ الِّي خَرِّجْهُمْ مِنْ مَصْرْ بَعْدْمَا عْمَلْ عْجَايِبْ ومُعْجْزَاتْ فِيهَا وفِي البْحَرْ الأَحْمَرْ وفِي الصَّحْرَاء لْمُدِّةْ 40 سْنَة. <verse eid="ACT 7:36" /><verse number="37" style="v" sid="ACT 7:37" />وهَاذَا هُوَّ مُوسَى الِّي قَالْ لْبَنِي إِسْرَائِيلْ: "اللَّهْ بِشْ يِبْعْثِلْكُمْ نَبِيْ كِيفِي مِنْ بِينْ خْوَاتْكُمْ". <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />وهُوَّ الِّي كَانْ مْعَ الشَّعْبْ فِي الصَّحْرَاء، وكَانْ وَاسْطَة بِينْ المَلَاكْ الِّي كَلْمُو فِي جْبَلْ سِينَاءْ وجْدُودْنَا. وهُوَّ الِّي خْذَا الكْلَامْ الِّي يَعْطِي الحَيَاةْ بَاشْ يْوَصَّلْهُولْنَا.<verse eid="ACT 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39" />«آمَا جْدُودْنَا مَا حَبُّوشْ يْطِيعُوهْ ورَفْضُوهْ، وحَنِّتْ قْلُوبْهُمْ لِلرْجُوعْ لْمَصْرْ. <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />وقَالُوا لْهَارُونْ: "أَعْمْلِلْنَا آلْهَة تْوَرِّينَا الطْرِيقْ، عْلَى خَاطِرْ مَا نَعْرْفُوشْ آشْ صَارْ لْمُوسَى الِّي خَرَّجْنَا مِنْ أَرْضْ مَصْرْ". <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />وفِي الوَقْتْ هَاذَاكَا، صَنْعُوا صَنْبَة كِيمَا العْجِلْ، وذَبْحُولْهَا ضْحِيَّة، وفَرْحُوا بِلِّي عَمْلُوهْ. <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />يَاخِي اللَّهْ بْعِدْ عْلِيهُمْ وخَلَّاهُمْ يِعْبْدُوا فِي نْجُومْ السْمَاء، كِيمَا جَاء فِي كْتَابْ الأَنْبِيَاءْ:</para>
  <para style="b" vid="ACT 7:42" />
  <para style="q1" vid="ACT 7:42">"يَا بَنِي إِسْرَائِيلْ! يَاخِي جِبْتُولِي ذْبِيحَة وَلَّا قُرْبَانْ</para>
  <para style="q2" vid="ACT 7:42">فِي الـ40 سْنَة الِّي عَدِّيتُوهُمْ فِي الصَّحْرَاء؟<verse eid="ACT 7:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43" />لَا، آمَا هَزِّيتُوا خِيمِةْ الإِلَاهْ مُولُوكْ</para>
  <para style="q2" vid="ACT 7:43">ونِجْمِةْ الإِلَاهْ رَمْفَانْ،</para>
  <para style="q2" vid="ACT 7:43">الِّي هُومَا صْنَبْ صْنَعْتُوهَا بَاشْ تِعْبْدُوهَا.</para>
  <para style="q1" vid="ACT 7:43">هَاذَاكَا عْلَاشْ بِشْ نِنْفِيكُمْ لْأَبْعِدْ مِنْ بْلَادْ بَابِلْ".<verse eid="ACT 7:43" /></para>
  <para style="b" />
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />«وَقْتِلِّي كَانُوا جْدُودْنَا فِي الصَّحْرَاء، هَزُّوا مْعَاهُمْ خِيمِةْ العَهْدْ الِّي اللَّهْ أْمَرْ مُوسَى بَاشْ يَصْنَعْهَا كِيمَا وَرَّاهَالُو بِالضَّبْطْ. <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />ومْبَعِّدْ، خْذَاوْهَا جْدُودْنَا وهَزُّوهَا لِلْبْلَادْ الِّي إِحْتَلُّوهَا مْعَ يَشُوعْ بَعْدْمَا طَرِّدْ اللَّهْ مِنْ قُدَّامْهُمْ الشُّعُوبْ الِّي كَانُوا سَاكْنِينْ فِيهَا. وقَعْدِتْ الخِيمَة غَادِي حَتَّى لْوَقْتْ دَاوِدْ، <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />الِّي كَانْ اللَّهْ رَاضِي عْلِيهْ. طْلَبْ دَاوِدْ مِنْ اللَّهْ بَاشْ يْخَلِّيهْ يِبْنِي هَيْكِلْ لْإِلَاهْ يَعْقُوبْ، <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />آمَا سُلَيْمَانْ هُوَّ الِّي بْنَى الهَيْكِلْ. <verse eid="ACT 7:47" /><verse number="48" style="v" sid="ACT 7:48" />فِي الحْقِيقَة، اللَّهْ العَالِي مَا يُسْكُنْشْ فِي بَنْيْ صَنْعِتُّو يْدِينْ البَشَرْ، كِيفْ مَا قَالْ النْبِي:<verse eid="ACT 7:48" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49" />"الرَّبْ يْقُولْ:</para>
  <para style="q2" vid="ACT 7:49">السْمَاء عَرْشِي، والأَرْضْ وِينْ نْحُطْ سَاقَيَّا.</para>
  <para style="q1" vid="ACT 7:49">آنَا هُو البِيتْ الِّي بِشْ تِبْنِيوْهُولِي؟</para>
  <para style="q2" vid="ACT 7:49">وآنَا هِيَّ البُقْعَة الِّي بِشْ نِرْتَاحْ فِيهَا؟<verse eid="ACT 7:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50" />مُشْ آنَا الِّي صْنَعْتْ الحَاجَاتْ هَاذِي الكُلْ بِيْدَيَّا؟".<verse eid="ACT 7:50" /></para>
  <para style="b" />
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />«يَلِّي رُوسْكُمْ صْحِيحَة، وقْلُوبْكُمْ كَاسْحَة ووِذْنِيكُمْ مْسَكْرَة، إِنْتُومَا دِيمَا تْقَاوْمُوا فِي الرُّوحْ القُدُسْ كِيمَا عَمْلُوا جْدُودْكُمْ. <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />فَمَّاشْ نَبِيْ مَا اضْطَهْدُوهِشْ جْدُودْكُمْ؟ وحَتَّى الِّي تْنَبْؤُوا عَالصَّالِحْ الِّي بِشْ يْجِي قَتْلُوهُمْ، ولِّي إِنْتُومَا سَلِّمْتُوهْ وقْتَلْتُوهْ. <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />إِنْتُومَا يَلِّي خْذِيتُوا الشَّرِيعَة عْلَى طْرِيقْ المْلَايْكَة آمَا مَا طَبَّقْتُوهَاشْ!».<verse eid="ACT 7:53" /></para>
  <para style="s">مُوتْ اسْتِيفَانُوسْ</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />وَقْتِلِّي الحَاضْرِينْ سَمْعُوا كْلَامْ اسْتِفَانُوسْ، تِمْلَاتْ قْلُوبْهُمْ بِالحِقْدْ وتْغَشْشُوا بَرْشَة عْلِيهْ وتْحَلْفُوا فِيهْ. <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />آمَا هُوَّ هَزْ عِينِيهْ لِلسْمَاء وهُوَّ مَلْيَانْ بِالرُّوحْ القُدُسْ، وشَافْ مَجْدْ اللَّهْ ويَسُوعْ وَاقِفْ عْلَى يْمِينْ اللَّهْ. <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />وقَالْ: «آنَا نْشُوفْ فِي السْمَاء مَحْلُولَة، وإِبْنْ الإِنْسَانْ وَاقِفْ عْلَى يْمِينْ اللَّهْ». <verse eid="ACT 7:56" /><verse number="57" style="v" sid="ACT 7:57" />يَاخِي صَاحُوا بْصُوتْ عَالِي، وسَدُّوا وذْنِيهُمْ، وهِجْمُوا عْلِيهْ الكُلْ فَرْدْ مَرَّة. <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />وخَرْجُوهْ لْبَرَّا مِالمْدِينَة وبْدَاوْ يُرْجْمُوا فِيهْ بِالحْجَرْ. ونَحَّاوْ الشْهُودْ جْبَايِبْهُمْ وخَلَّاوْهُمْ عَنْدْ سَاقِينْ وَاحِدْ اسْمُو شَاوُلْ بَاشْ يْعِسْ عْلِيهُمْ.<verse eid="ACT 7:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="ACT 7:59" />وهُومَا يُرْجْمُوا فِيهْ، كَانْ اسْتِفَانُوسْ يِدْعِي: «يَا الرَّبْ يَسُوعْ، إِقْبِلْ رُوحِي!». <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />ومْبَعِّدْ، هْبَطْ عْلَى رْكَايْبُو وصَاحْ بْصُوتْ عَالِي: «يَا رَبْ مَا تْحَاسِبْهُمْشْ عَالذَّنْبْ هَاذَا!». وبَعْدْمَا قَالْ الكْلَامْ هَاذَا، مَاتْ.<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="s">شَاوُلْ يِضْطَهِدْ المُؤْمْنِينْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />وكَانْ شَاوُلْ مْوَافِقْ عْلَى قَتْلَانْ اسْتِفَانُوسْ. وفِي النْهَارْ هَاذَاكَا، بْدَا إِضْطِهَادْ كْبِيرْ عَالكْنِيسَة الِّي فِي أُورْشَلِيمْ، وتْفَرْقُوا المُؤْمْنِينْ الكُلْ فِي اليَهُودِيَّة والسَّامْرَة. ومَا قَعْدُوا فِي أُورْشَلِيمْ كَانْ الرُّسُلْ. <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />وفَمَّة نَاسْ يْخَافُوا رَبِّي هَزُّوا اسْتِفَانُوسْ ودِفْنُوهْ وبْكَاوْ عْلِيهْ بَرْشَة. <verse eid="ACT 8:2" /><verse number="3" style="v" sid="ACT 8:3" />وكَانْ شَاوُلْ يْحَاوِلْ بَاشْ يَقْضِي عَالكْنِيسَة. كَانْ يْدُورْ مِنْ دَارْ لْدَارْ، يْكَرْكِرْ فِي الرْجَالْ والنْسَاء ويِرْمِي فِيهُمْ فِي الحَبْسْ.<verse eid="ACT 8:3" /></para>
  <para style="s">فِيلِۑُّسْ يْبَشِّرْ فِي السَّامْرَة</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />آمَا المُؤْمْنِينْ الِّي تْفَرْقُوا كَانُوا يِمْشِيوْ مِنْ بُقْعَة لْبُقْعَة يْوَصْلُوا فِي البْشَارَة. <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />ومْشَى فِيلِۑُّسْ لِمْدِينَة فِي السَّامْرَة، وبْدَا يْبَشِّرْ بِالمَسِيحْ. <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />والنَّاسْ الكُلْ، كِي سَمْعُوا بِالمُعْجْزَاتْ الِّي عْمَلْهَا وكِي شَافُوهَا، رَكْزُوا أَكْثِرْ عَلِّي كَانْ يْقُولْ فِيهْ. <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />عْلَى خَاطِرْ الأَرْوَاحْ الشِّرِّيرَة كَانُوا يْصِيحُوا بْصُوتْ عَالِي ويُخْرْجُوا مِالنَّاسْ الِّي سَاكْنِينْهُمْ، وزَادَا، بَرْشَة مَشْلُولِينْ وعَايْبِينْ بْرَاوْ. <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />وتِمْلَاتْ المْدِينَة بِالفَرْحَة.<verse eid="ACT 8:8" /></para>
  <para style="s">سِيمُونْ السَّحَّارْ</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />وفِي الوَقْتْ هَاذَاكَا، كَانْ فَمَّة سَحَّارْ فِي المْدِينَة إِسْمُو سِيمُونْ، وكَانُوا السَّامِرِيِّينْ مَبْهُورِينْ بِيهْ، وكَانْ يْقُولْ عْلَى رُوحُو الِّي هُوَّ رَاجِلْ عْظِيمْ. <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />وكَانُوا الكُلْ بِصْغِيرْهُمْ بِكْبِيرْهُمْ يِسْمْعُوا فِي كْلَامُو ويْقُولُوا: «الرَّاجِلْ هَاذَا هُوَّ قُوِّةْ اللَّهْ الِّي تِتْسَمَّى العْظِيمَة». <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />وكَانُوا يِسْمْعُوا كْلَامُو، عْلَى خَاطِرْ فْتِنْهُمْ بْسِحْرُو مُدَّة طْوِيلَة. <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />آمَا وَقْتِلِّي بَشِّرْهُمْ فِيلِۑُّسْ بْمَمْلِكْةْ اللَّهْ وبْقُوِّةْ إِسْمْ يَسُوعْ المَسِيحْ، أَمْنُوا وتْعَمْدُوا رْجَالْ ونْسَاء. <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />وسِيمُونْ بِيدُو أَمَّنْ وتْعَمِّدْ، وكَانْ شَادْ جْنَبْ فِيلِۑُّسْ وبَاهِتْ فِي العْجَايِبْ والمُعْجْزَاتْ الكْبِيرَة الِّي كَانْ يَعْمِلْ فِيهُمْ.<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />وكِي سَمْعُوا الرُّسُلْ فِي أُورْشَلِيمْ الِّي السَّامِرِيِّينْ قِبْلُوا كِلْمِةْ اللَّهْ، بَعْثُولْهُمْ بُطْرُسْ ويُوحَنَّا. <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />وَقْتِلِّي وُصْلُوا، طَلْبُوا مِنْ اللَّهْ بَاشْ يَعْطِي الرُّوحْ القُدُسْ لِلسَّامِرِيِّينْ، <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />عْلَى خَاطِرْ حَتَّى لْوَقْتْهَا مَزَّالْ حَتَّى وَاحِدْ فِيهُمْ مَا خْذَاهْ، بِخْلَافْ إِنْهُمْ تْعَمْدُوا بْإِسْمْ الرَّبْ يَسُوعْ أَكَهَوْ. <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />وَلَّاوْ بُطْرُسْ ويُوحَنَّا حَطُّوا يْدِيهُمْ عْلِيهُمْ، وقِبْلُوا الرُّوحْ القُدُسْ.<verse eid="ACT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18" />وكِي شَافْ سِيمُونْ الِّي اللَّهْ عْطَى الرُّوحْ القُدُسْ لِلْمُؤْمْنِينْ وَقْتِلِّي حَطُّوا الرُّسُلْ يْدِيهُمْ عْلِيهُمْ، مَدْ لْبُطْرُسْ ويُوحَنَّا فْلُوسْ، <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />وقَالِلْهُمْ: «أَعْطِيوْنِي آنَا زَادَا السُّلْطَة هَاذِي بَاشْ أَيْ وَاحِدْ نْحُطْ يْدَيَّا عْلِيهْ يَاخِذْ الرُّوحْ القُدُسْ». <verse eid="ACT 8:19" /><verse number="20" style="v" sid="ACT 8:20" />قَالُّو بُطْرُسْ: «اللَّهْ يِهْلْكِكْ إِنْتِ وفْلُوسِكْ، عْلَى خَاطِرْ مْشَى فِي بَالِكْ تْنَجِّمْ تِشْرِي الهِيبَة الِّي عْطَاهَا اللَّهْ بِالفْلُوسْ! <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />لَا عَنْدِكْ لَا قَسْمْ ولَا بَايْ فِي الخِدْمَة هَاذِي، عْلَى خَاطِرْ قَلْبِكْ مُشْ صَادِقْ مْعَ اللَّهْ. <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />تُوبْ عْلَى شَرِّكْ وأُطْلُبْ الرَّبْ، بَالِكْشِي يِغْفِرْلِكْ الِّي نْوِيتُو فِي قَلْبِكْ، <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />عْلَى خَاطِرْ نْشُوفْ فِيكْ مِلْيَانْ بِمْرَارِةْ الحُسْدْ ومَرْبُوطْ بِالذْنُوبْ». <verse eid="ACT 8:23" /><verse number="24" style="v" sid="ACT 8:24" />يَاخِي جَاوِبْ سِيمُونْ: «أُطْلْبُوا إِنْتُومَا الرَّبْ بَاشْ مَا يْصِيرْلِي شَيْ مِلِّي قُلْتُوهْ». <verse eid="ACT 8:24" /><verse number="25" style="v" sid="ACT 8:25" />وبَعْدْمَا عْطَاوْ بُطْرُسْ ويُوحَنَّا شْهَادِتْهُمْ وتْكَلْمُوا بْكِلْمِةْ الرَّبْ، رَجْعُوا لْأُورْشَلِيمْ وهُومَا يْبَشْرُوا فِي بَرْشَة دْشُرْ فِي السَّامْرَة.<verse eid="ACT 8:25" /></para>
  <para style="s">وْزِيرْ مِالحَبَشَة يَمِّنْ بِالمَسِيحْ</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />وكَلِّمْ مَلَاكْ مِنْ عَنْدْ الرَّبْ فِيلِۑُّسْ وقَالُّو: «قُومْ وشِدْ ثْنِيِّةْ الجَنُوبْ، عَالطْرِيقْ الصَّحْرَاوِي الِّي بِينْ أُورْشَلِيمْ وغَزَّة». <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />وَلَّى قَامْ ومْشَى. فِي الطْرِيقْ، قَابِلْ رَاجِلْ مَخْصِي مِالحَبَشَة، جَاء لْأُورْشَلِيمْ بَاشْ يِعْبِدْ اللَّهْ. وهُوَّ وزِيرْ المَالِيَّة عَنْدْ كِنْدَاكَة، مَلِكَةْ الحَبَشَة. <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />وكَانْ مْرَوَّحْ لِبْلَادُو، قَاعِدْ فِي كَرُّوسْتُو، يَقْرَى فِي كْتَابْ النَّبِيْ إِشَعْيَاءْ. <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" />يَاخِي قَالْ الرُّوحْ لْفِيلِۑُّسْ: «قَدِّمْ وامْشِي بِجْنَبْ الكَرُّوسَة هَاذِي». <verse eid="ACT 8:29" /><verse number="30" style="v" sid="ACT 8:30" />مْشَالْهَا فِيلِۑُّسْ يِجْرِي، وسْمَعْ الرَّاجِلْ يَقْرَى فِي كْتَابْ النَّبِيْ إِشَعْيَاءْ، وسِأْلُو: « يَاخِي قَاعِدْ تِفْهِمْ فِلِّي تَقْرَى فِيهْ؟». <verse eid="ACT 8:30" /><verse number="31" style="v" sid="ACT 8:31" />جَاوْبُو: «كِيفَاشْ بِشْ نِفْهِمْ إِذَا مَا فَمَّة حَدْ يْفَسَّرْلِي؟» وطْلَبْ مِنْ فِيلِۑُّسْ بَاشْ يِرْكِبْ بَحْذَاهْ. <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />وكَانْ الوْزِيرْ وْصُلْ لْوِينْ الكْتَابْ يْقُولْ:</para>
  <para style="b" vid="ACT 8:32" />
  <para style="q1" vid="ACT 8:32">«كَانْ كِيمَا النَّعْجَة الِّي يْهِزُّوهَا تِتِذْبَحْ،</para>
  <para style="q2" vid="ACT 8:32">وكِيمَا العَلُّوشْ السَّاكِتْ بِينْ يْدِينْ الِّي يْجِزْ فِيهْ،</para>
  <para style="q2" vid="ACT 8:32">مَا حَلِّشْ فُمُّو.<verse eid="ACT 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33" />ذَلُّوهْ وظَلْمُوهْ.</para>
  <para style="q2" vid="ACT 8:33">شْكُونْ بِشْ يَحْكِي عْلَى ذُرِّيتُو؟</para>
  <para style="q1" vid="ACT 8:33">عْلَى خَاطِرْ حْيَاتُو تْسِلْبِتْ!».<verse eid="ACT 8:33" /></para>
  <para style="b" />
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34" />وسْإِلْ الوْزِيرْ فِيلِۑُّسْ: «عْلَى شْكُونْ يَحْكِي النَّبِيْ هْنَا؟ يَحْكِي عْلَى رُوحُو وَلَّا عْلَى حَدْ آخِرْ؟». <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />يَاخِي تْكَلِّمْ فِيلِۑُّسْ وبْدَا يْبَشِّرْ فِيهْ بْيَسُوعْ مِنْ الآيَاتْ هَاذُوكُمْ. <verse eid="ACT 8:35" /><verse number="36" style="v" sid="ACT 8:36" />وهُومَا فِي الطْرِيقْ، وُصْلُوا لْبُقْعَة فِيهَا مَاء، يَاخِي قَالْ الوْزِيرْ: «شُوفْ! هَاوْ فَمَّة مَاء، شْنُوَّة الِّي يِمْنَعْنِي بَاشْ نِتْعَمِّدْ؟» <verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" />جَاوْبُو فِيلِۑُّسْ: «كَانْ تَمِّنْ مِنْ كُلْ قَلْبِكْ، تْنَجِّمْ تِتْعَمِّدْ». يَاخِي قَالُّو: «آنَا نَمِّنْ الِّي يَسُوعْ المَسِيحْ هُوَّ إِبْنْ اللَّهْ». <verse eid="ACT 8:37" /><verse number="38" style="v" sid="ACT 8:38" />وأْمَرْ بَاشْ يْوَقْفُوا الكَرُّوسَة، وهَبْطُوا مْعَ بْعَضْهُمْ لِلمَاءْ، وعَمْدُو فِيلِۑُّسْ. <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />وكِي خَرْجُوا مِالمَاء، خْطَفْ رُوحْ الرَّبْ فِيلِۑُّسْ، والوْزِيرْ مَا عَادِشْ شَافُو، يَاخِي كَمِّلْ طْرِيقُو وهُوَّ فَرْحَانْ. <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />آمَا فِيلِۑُّسْ لْقَى رُوحُو فِي مْدِينِةْ أَشْدُودْ. وبْدَا يِمْشِي ويْبَشِّرْ فِي كُلْ مْدِينَة يِتْعَدَّى عْلِيهَا، لِينْ وْصُلْ لْقَيْصَرِيَّة.<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s">شَاوُلْ يَمِّنْ بِالمَسِيحْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />وكَانْ شَاوُلْ مَزَّالْ يِتْحَلِّفْ فِي تْلَامِذْةْ الرَّبْ يَسُوعْ ويْهَدِّدْ فِيهُمْ بِالقَتْلْ، ومْشَى لِلكَاهِنْ الكْبِيرْ، <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />وطْلَبْ مِنُّو رَسَايِلْ لْمْعَابِدْ اليْهُودْ الِّي فِي دِمَشْقْ، بَاشْ يْنَجِّمْ يْشِدْ الرْجَالْ والنْسَاء الِّي يْتَبْعُوا فِي المَذْهَبْ الِّي يِتْسَمَّى الطْرِيقْ، ويْهِزْهُمْ مْكَتْفِينْ لْأُورْشَلِيمْ.<verse eid="ACT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 9:3" />وهُوَّ مَاشِي فِي الطْرِيقْ، وَقْتِلِّي قْرِيبْ يُوصِلْ لْدِمَشْقْ، إِذَا بْنُورْ مِالسْمَاء يِضْوِي عْلِيهْ مِنْ كُلْ شِيرَة. <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />يَاخِي طَاحْ فِي القَاعَة، وسْمَعْ صُوتْ يْقُلُّو: «شَاوُلْ! شَاوُلْ! عْلَاشْ تِضْطَهِدْ فِيَّا؟». <verse eid="ACT 9:4" /><verse number="5" style="v" sid="ACT 9:5" />سِأْلُو شَاوُلْ: «شْكُونِكْ إِنْتِ يَا رَبْ؟». جَاوْبُو: «آنَا يَسُوعْ الِّي إِنْتِ تِضْطَهِدْ فِيهْ. صْعِيبْ عْلِيكْ تْقَاوِمْنِي». <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />قَالُّو شَاوُلْ وهُوَّ خَايِفْ وْمَرْعُوبْ: «يَا رَبْ آشْ تْحِبْنِي نَعْمِلْ؟». قَالُّو الرَّبْ: «قُومْ وأُدْخُلْ لِلْمْدِينَة وتَوَّا يْقُولُولِكْ شْنُوَّة يِلْزْمِكْ تَعْمِلْ».<verse eid="ACT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7" />آمَا الرْجَالْ الِّي كَانُوا مْسَافْرِينْ مْعَ شَاوُلْ، وِقْفُوا بَاهْتِينْ ومَا نَجْمُوا يَنْطْقُوا بْحَتَّى كِلْمَة، يِسْمْعُوا فِي الصُّوتْ، آمَا مَا يْشُوفُوا فِي حَتَّى حَدْ. <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />وقَامْ شَاوُلْ مِالقَاعَةْ، وبِالرَّغْمْ الِّي كَانِتْ عِينِيهْ مَحْلُولَة، مَا كَانْ يْرَى فِي شَيْ. وَلَّاوْ شَدُّوهْ مِنْ يِدُّو ودَخْلُوهْ لْدِمَشْقْ. <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />وقْعَدْ ثْلَاثَة أَيَّامْ مَا يْشُوفِشْ، لَا كْلَا ولَا شْرَبْ.<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />وكَانْ فِي دِمَشْقْ تِلْمِيذْ إِسْمُو حَنَانِيَّا، عَيَّطْلُو الرَّبْ فِي رُؤْيَا: «حَنَانِيَّا!». قَالُّو: «نْعَمْ يَا رَبْ». <verse eid="ACT 9:10" /><verse number="11" style="v" sid="ACT 9:11" />قَالُّو الرَّبْ: «قُومْ وامْشِي فِي الشَّارِعْ المَعْرُوفْ بِالطْرِيقْ المِسْتْوِي، واسْإِلْ فِي دَارْ يَهُوذَا عْلَى رَاجِلْ مِنْ طَرْسُوسْ إِسْمُو شَاوُلْ. هُوَّ تَوَّا قَاعِدْ يْصَلِّي. <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />ورَاهُو شَافْ فِي رُؤْيَا رَاجِلْ إِسْمُو حَنَانِيَّا جَاهْ وحَطْ عْلِيهْ يْدِيهْ بَاشْ يِرْجَعْ يْشُوفْ». <verse eid="ACT 9:12" /><verse number="13" style="v" sid="ACT 9:13" />جَاوْبُو حَنَانِيَّا: «آمَا آنَا يَا رَبْ سْمَعْتْ مِنْ بَرْشَة نَاسْ عَالشَّرْ الِّي عَمْلُو الرَّاجِلْ هَاذَا فِي القِدِّيسِينْ التَّابْعِينِكْ الِّي فِي أُورْشَلِيمْ. <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />وهَاوْ جَاء لْهُونِي وعَنْدُو سُلْطَة مِنْ عَنْدْ كْبَارْ الكَهَنَة بَاشْ يْشِدْ النَّاسْ الِّي يَمْنُوا بِيكْ». <verse eid="ACT 9:14" /><verse number="15" style="v" sid="ACT 9:15" />آمَا الرَّبْ قَالُّو: «إِمْشِي! عْلَى خَاطِرْ آنَا اخْتَرْتْ الرَّاجِلْ هَاذَا بَاشْ يَحْكِي عْلِيَّا لِلشُّعُوبْ الِّي مُشْ يْهُودْ ولِلْمُلُوكْ ولْبَنِي إِسْرَائِيلْ. <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />وبِشْ نْوَرِّيهْ قَدَّاشْ لَازْمُو يِتْعَذَّبْ عْلَى خَاطِرْ إِسْمِي».<verse eid="ACT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17" />مْشَى حَنَانِيَّا ودْخَلْ لِلدَّارْ وحَطْ يْدِيهْ عْلَى شَاوُلْ وقَالْ: «يَا خُويَا شَاوُلْ، بْعَثْنِي لِيكْ الرَّبْ يَسُوعْ الِّي ظْهُرْلِكْ فِي الثْنِيَّة الِّي جِيتْ مِنْهَا بَاشْ يِرَجَّعْلِكْ نَظْرِكْ وتِتِمْلَى بِالرُّوحْ القُدُسْ». <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />وبِالوَقْتْ طَاحُوا مِنْ عِينِيهْ حَاجَاتْ كِيمَا القْشُورْ، ورْجَعْ يْشُوفْ، يَاخِي قَامْ وتْعَمِّدْ. <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />وبَعْدْ كْلَا، يَاخِي رَجْعِتْلُو قُوْتُو. وعَدَّى أَيَّامَاتْ مْعَ التْلَامْذَة فِي دِمَشْقْ.<verse eid="ACT 9:19" /></para>
  <para style="s">شَاوُلْ فِي دِمَشْقْ</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 9:20" />وبِالوَقْتْ بْدَا يْبَشِّرْ فِي مْعَابِدْ اليْهُودْ بِلِّي يَسُوعْ هُوَّ إِبْنْ اللَّهْ. <verse eid="ACT 9:20" /><verse number="21" style="v" sid="ACT 9:21" />ولِّي سَمْعُوهْ الكُلْ بِهْتُوا وقَالُوا: «مُشْ هَاذَا الِّي كَانْ يْحَاوِلْ يَقْضِي عَلِّي يَمْنُوا بْيَسُوعْ فِي أُورْشَلِيمْ؟ يَاخِي مُشْ جَاء لَهْنَا بَاشْ يْشِدْ المُؤْمْنِينْ يْهِزْهُمْ مْكَتْفِينْ لِكْبَارْ الكَهَنَة؟». <verse eid="ACT 9:21" /><verse number="22" style="v" sid="ACT 9:22" />آمَا شَاوُلْ كَانِتْ قُوْتُو فِي التَبْشِيرْ قَاعْدَة تْزِيدْ، وكَانْ يْحَيِّرْ اليْهُودْ السَّاكْنِينْ فِي دِمَشْقْ بِالأَدِلَّة الِّي تْوضَّحْ الِّي يَسُوعْ هُوَّ المَسِيحْ.<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />وبَعْدْ مُدَّة، تْفَاهْمُوا اليْهُودْ مْعَ بْعَضْهُمْ بَاشْ يُقْتْلُوا شَاوُلْ، <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />آمَا هُوَّ سْمَعْ بِيهُمْ. وكَانُوا يْعِسُّوا عْلَى بِيبَانْ المْدِينَة لِيلْ ونْهَارْ، بَاشْ يُقْتْلُوهْ وَقْتِلِّي يُخْرُجْ. <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />يَاخِي هَزُّوهْ التْلَامْذَة فِي اللِّيلْ، وحَطُّوهْ فِي قُفَّة وهَبْطُوهْ بِالحْبَالْ مِنْ فُوقْ سُورْ المْدِينَة.<verse eid="ACT 9:25" /></para>
  <para style="s">شَاوُلْ فِي أُورْشَلِيمْ</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />وَقْتِلِّي وْصُلْ شَاوُلْ لْأُرْشَلِيمْ، حَبْ يْوَلِّي مْعَ التْلَامْذَة، آمَا الكُلْ خَافُوا مِنُّو، ومَا صَدْقُوشْ الِّي هُوَّ وَلَّى وَاحِدْ مِنْ تْلَامِذْةْ الرَّبْ. <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />يَاخِي بَرْنَابَا هَزُّو مْعَاهْ لِلرُّسُلْ، وَحْكَالْهُمْ كِيفَاشْ الرَّبْ ظْهُرْلُو فِي الطْرِيقْ وكَلْمُو، وكِيفَاشْ بَشِّرْ بِاسِمْ يَسُوعْ بْشَجَاعَة فِي دِمَشْقْ. <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />وقْعَدْ شَاوُلْ يِمْشِي ويْجِي مْعَاهُمْ فِي أُورْشَلِيمْ، وكَانْ يْبَشِّرْ بْإِسْمْ الرَّبْ مِنْ غِيرْ خُوفْ. <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />وكَانْ يِتْنَاقِشْ مْعَ اليْهُودْ الِّي يِتْكَلْمُوا بِاليُونَانِيَّة ويْحَاجِجْ فِيهُمْ. وكَانُوا يْحَاوْلُوا يُقْتْلُوهْ. <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />وكِي سَمْعُوا الإِخْوَة بْهَاذَا، هَزُّوهْ لِمْدِينِةْ قَيْصَرِيَّة، ومِنْ غَادِي بَعْثُوهْ لْطَرْسُوسْ.<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />وكَانِتْ الكْنِيسَة فِي مَنَاطِقْ اليَهُودِيَّة والجَلِيلْ والسَّامْرَة عَايْشَة فِي سَلَامْ، وقَاعْدَة تِكْبِرْ فِي الإِيمَانْ وفِي طَاعَةْ الرَّبْ، وتْزِيدْ فِي العْدَدْ بْتَشْجِيعْ الرُّوحْ القُدُسْ.<verse eid="ACT 9:31" /></para>
  <para style="s">إِينِيَاسْ يِتْشْفَى</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />وَقْتِلِّي بُطْرُسْ كَانْ يِمْشِي مِنْ بُقْعَة لْبُقْعَة، زَارْ القِدِّيسِينْ السَّاكْنِينْ فِي مْدِينِةْ لُدَّة. <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />ولْقَى غَادِي رَاجِلْ مَشْلُولْ إِسْمُو إِينِيَاسْ، عَنْدُو ثْمَنْيَة سْنِينْ مَا قَامِشْ مِالفَرْشْ. <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />قَالُّو بُطْرُسْ: «يَا إِينْيَاسْ، يَسُوعْ المَسِيحْ يِشْفِيكْ، قُومْ وڨِدْ فَرْشِكْ بِيدِكْ». وبِالوَقْتْ قَامْ. <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />وشَافُوهْ الِّي يُسْكْنُوا فِي لُدَّة وفِي أَرْضْ شَارُونْ الكُلْ، وأَمْنُوا بِالرَّبْ.<verse eid="ACT 9:35" /></para>
  <para style="s">طَابِيثَا تْقُومْ مِالمُوتْ</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />وكَانِتْ فِي مْدِينِةْ يَافَا تِلْمِيذَة اسْمْهَا طَابِيثَا، الِّي مَعْنَاهْ غْزَالَة، دِيمَا تَعْمِلْ فِي الخِيرْ وتْعَاوِنْ فِي الفْقَارَى. <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />وفِي الوَقْتْ هَاذَاكَا مُرْضِتْ ومَاتِتْ. يَاخِي غَسّْلُوهَا وحَطُّوهَا فِي بَيْتْ فِي العْلِيْ. <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />سَمْعُوا التْلَامْذَة فِي يَافَا الِّي بُطْرُسْ مَوْجُودْ فِي لُدَّة، بِمَا إِنْهَا قْرِيبَة مِنْ يَافَا، يَاخِي بَعْثُولُو زُوزْ رْجَالْ يْلِحُّوا عْلِيهْ ويْقُولُولُو: «إِيجَانَا فِيسَعْ ومَا تَبْطَاشْ عْلِينَا».<verse eid="ACT 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 9:39" />يَاخِي قَامْ بُطْرُسْ مْشَى مْعَاهُمْ. وكِي وْصُلْ، طَلْعُوهْ لِلْعْلِيْ. ودَارُوا بِيهْ النْسَاء الهَجَّالَاتْ، يِبْكِيوْ ويْوَرِّيوْ فِيهْ فِي اللِّبْسَة والحْوَايِجْ الِّي خَيْطِتْهُمْ غْزَالَة كِي كَانِتْ حَيَّة. <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />خَرِّجْ بُطْرُسْ النَّاسْ الكُلْ مِالبِيتْ، وهْبَطْ عْلَى رْكَايْبُو وصَلَّى. وبَعْدْ تْلَفِّتْ لِلجُثَّة وقَالْ: «يَا طَابِيثَا، قُومْ!»، يَاخِي حَلِّتْ عِينِيهَا، وَقْتِلِّي شَافِتْ بُطْرُسْ، قَعْدِتْ. <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />مَدْ بُطْرُسْ يِدُّو وقَوَّمْهَا، ومْبَعِّدْ عَيِّطْ لِلْقِدِّيسِينْ والهَجَّالَاتْ ووَرَّهَالْهُمْ حَيَّة. <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />وتِنْشَرْ الخْبَرْ فِي يَافَا الكُلْ. وبَرْشَة نَاسْ أَمْنُوا بِالرَّبْ. <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />وقْعَدْ بُطْرُسْ أَيَّامَاتْ فِي يَافَا عَنْدْ وَاحِدْ دَبَّاغْ إِسْمُو سِمْعَانْ.<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s">بُطْرُسْ فِي دَارْ كُرْنِيلْيُوسْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />وكَانْ فَمَّة فِي قَيْصَرِيَّة ضَابِطْ رُومَانِي إِسْمُو كُرْنِيلْيُوسْ، تَابَعْ لْفِرْقِةْ الجَيْشْ الِّي تِتْسَمَّى الإِيطَالِيَّة. <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />كَانْ تَقِيْ ويْخَافْ رَبِّي هُوَّ وعَايِلْتُو الكُلْ، ويِتْصَدِّقْ بَرْشَة عْلَى عَالفْقَارَى ودِيمَا يْصَلِّي لِلَّهْ.<verse eid="ACT 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 10:3" />فِي نْهَارْ مِالنْهَارَاتْ، مْعَ مَاضِي ثْلَاثَة مْتَاعْ العْشِيَّة، شَافْ كُرْنِيلْيُوسْ فِي رُؤْيَا وَاضْحَة، مَلَاكْ مِنْ عَنْدْ اللَّهْ دْخَلُّو وقَالُّو: «يَا كُرْنِيلْيُوسْ!». <verse eid="ACT 10:3" /><verse number="4" style="v" sid="ACT 10:4" />خْزَرْ لِلْمَلَاكْ وهُوَّ خَايِفْ وسِأْلُو: «آشْ فَمَّة يَا سِيدِي؟». قَالُّو المَلَاكْ: «صْلَاتِكْ وصَدْقَاتِكْ وُصْلُوا لِلَّهْ، ورَاهُو مُشْ نَاسِيكْ. <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />أَبْعِثْ تَوَّا رْجَالْ لْيَافَا، واسْتَدْعِي سِمْعَانْ الِّي يْعَيْطُولُو بُطْرُسْ. <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />هُوَّ يُسْكُنْ عَنْدْ سِمْعَانْ الدَّبَّاغْ الِّي دَارُو قْرِيبَة لِلبْحَرْ». <verse eid="ACT 10:6" /><verse number="7" style="v" sid="ACT 10:7" />وبَعْدْمَا مْشَى المَلَاكْ الِّي كَانْ يْكَلِّمْ فِيهْ، عَيِّطْ كُرْنِيلْيُوسْ لِثْنِينْ مِنْ خُدَّامُو، وجُنْدِي يْخَافْ رَبِّي مِالحُرَّاسْ التَّابْعِينُو. <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />وحْكَالْهُمْ الِّي صَارْ الكُلْ، وبْعَثْهُمْ لْيَافَا.<verse eid="ACT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />ومِنْ غُدْوَة، وَقْتِلِّي بْدَاوْ الرْجَالْ الثْلَاثَة يُقْرْبُوا لْيَافَا، طْلَعْ بُطْرُسْ لِلسْطَحْ مْعَ نُصْفْ النْهَارْ بَاشْ يْصَلِّي. <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />جَاعْ بَرْشَة، واشْتْهَى يَاكِلْ. وهُومَا يْحَضْرُولُو فِي الفْطُورْ، شَافْ رُؤْيَا، <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />وشَافْ السْمَاء مَحْلُولَة، وحَاجَة كِيمَا مَلْحْفَة كْبِيرَة مَرْبُوطَة مِنْ أَطْرَافْهَا الأَرْبْعَة هَابْطَة تِدَّلْدِلْ لِلقَاعَة. <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />وكَانْ فِيهَا أَنْوَاعْ الحَيَوَانَاتْ الكُلْ: الِّي تِمْشِي، ولِّي تَزْحِفْ، ولِّي اطِّيرْ فِي السْمَاء. <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />وجَاهْ صُوتْ يْقُلُّو: «يَا بُطْرُسْ، قُومْ اذْبَحْ وكُولْ!». <verse eid="ACT 10:13" /><verse number="14" style="v" sid="ACT 10:14" />آمَا بُطْرُسْ جَاوْبُو: «لَا يَا رَبْ! آنَا عُمْرِي مَا كْلِيتْ شَيْ مَنْزُوسْ وَلَّا مْحَرَّمْ». <verse eid="ACT 10:14" /><verse number="15" style="v" sid="ACT 10:15" />يَاخِي الصُّوتْ قَالُّو مَرَّة أُخْرَى: «الِّي طَهْرُو اللَّهْ، مَا تِحْسْبُوشْ إِنْتِ مَنْزُوسْ». <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />وتْعَاوِدْ هَاذَا ثْلَاثَة مَرَّاتْ، وبَعْدْهَا تْهَزِّتْ المَلْحْفَة لِلسْمَاء.<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />قْعَدْ بُطْرُسْ حَايِرْ ويِسْإِلْ فِي رُوحُو عْلَى مَعْنَى الرُّؤْيَا الِّي شَافْهَا. هُوَّ هَكَّاكَا، والرْجَالْ الِّي بْعَثْهُمْ كُرْنِيلْيُوسْ وُصْلُوا قُدَّامْ البَابْ، بَعْدْمَا سِأْلُوا عْلَى دَارْ سِمْعَانْ الدَّبَّاغْ. <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />وسِأْلُوا: «سِمْعَانْ الِّي يِتْسَمَّى بُطْرُسْ مَوْجُودْ هْنَا؟». <verse eid="ACT 10:18" /><verse number="19" style="v" sid="ACT 10:19" />وفِي الوَقْتْ هَاذَاكَا، كَانْ بُطْرُسْ مَزَّالْ يْفَكِّرْ فِي مَعْنَى الرُّؤْيَا، يَاخِي قَالُّو الرُّوحْ: «فَمَّة ثْلَاثَة رْجَالْ قُدَّامْ البَابْ يْلَوْجُوا عْلِيكْ. <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />أَهْبِطْ وامْشِي مْعَاهُمْ ومَا تِتْرَدِّدَشْ، عْلَى خَاطِرْ آنَا الِّي بْعَثْتْهُمْ».<verse eid="ACT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 10:21" />هْبَطِّلْهُمْ بُطْرُسْ وقَالْ: «آنَا هُوَّ الِّي تْلَوْجُوا عْلِيهْ، عْلَاشْ جِيتُوا؟». <verse eid="ACT 10:21" /><verse number="22" style="v" sid="ACT 10:22" />جَاوْبُوهْ: «بْعَثْنَا الضَّابِطْ كُرْنِيلْيُوسْ، وهُوَّ رَاجِلْ صَالَحْ ويْخَافْ اللَّهْ، واليْهُودْ الكُلْ يِشْهْدُولُو بِهَاذَا، أَوْحَالُو اللَّهْ عْلَى طْرِيقْ مَلَاكْ طَاهِرْ بَاشْ يِسْتَدْعَاكْ لْدَارُو ويِسْمَعْ الكْلَامْ الِّي عَنْدِكْ». <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />دَخَّلْهُمْ بُطْرُسْ وضَيَّفْهُمْ لِيلِتْهَا بَحْذَاهْ، ومِنْ غُدْوَة مْشَى مْعَاهُمْ، ومْشَاوْ مْعَاهْ إِخْوَة مِنْ يَافَا.<verse eid="ACT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 10:24" />ووُصْلُوا لْقَيْصَرِيَّة مِنْ غُدْوَة. وكَانْ كُرْنِيلْيُوسْ يِسْتَنَّى فِيهُمْ، واسْتَدْعَى امَّالِيهْ وأَصْحَابُو القْرَابْ. <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />وَقْتِلِّي دْخَلْ بُطْرُسْ، إِسْتَقْبْلُو كُرْنِيلْيُوسْ وسْجِدْلُو. <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />يَاخِي قَوْمُو بُطْرُسْ وقَالُّو: «قُومْ، مَانِي إِلَّا إِنْسَانْ كِيفِي كِيفِكْ». <verse eid="ACT 10:26" /><verse number="27" style="v" sid="ACT 10:27" />ودْخَلْ بُطْرُسْ وهُوَّ يَحْكِي مْعَاهْ، ولْقَى بَرْشَة نَاسْ مَلْمُومِينْ. <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />يَاخِي قَالِلْهُمْ: «إِنْتُومَا تَعْرْفُوا الِّي مْحَرَّمْ عَاليْهُودِي يِتْعَامِلْ مْعَ الِّي مُشْ يْهُودِي وَلَّا حَتَّى يْزُورُو فِي دَارُو. آمَا اللَّهْ وَرَّانِي الِّي مَا يِلْزِمْنِيشْ نْقُولْ عْلَى حَتَّى حَدْ إِنُّو مَنْزُوسْ وَلَّا مُشْ طَاهِرْ. <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />هَاذَاكَا عْلَاشْ وَقْتِلِّي اسْتَدْعِيتُونِي جِيتْ طُولْ، عْلَاشْ اسْتَدْعِيتُونِي؟».<verse eid="ACT 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30" />جَاوِبْ كُرْنِيلْيُوسْ: « تَوَّا أَرْبْعَة أَيَّامْ لْتَالِي، كُنْتْ نْصَلِّي فِي دَارِي مْعَ مَاضِي ثْلَاثَة، وإِذَا بِيهْ ظْهُرْ قُدَّامِي رَاجِلْ لِبْسْتُو تِلْمَعْ. <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />وقَالِّي: "يَا كُرْنِيلْيُوسْ! اللَّهْ سْمَعْ صْلَاتِكْ وتْذَكِّرْ صَدْقَاتِكْ. <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />أَبْعِثْ رْجَالْ لْيَافَا، واسْتَدْعِي سِمْعَانْ الِّي يْعَيْطُولُو بُطْرُسْ، رَاهُو سَاكِنْ فِي دَارْ سِمْعَانْ الدَّبَّاغْ القْرِيبَة مِالبْحَرْ". <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />يَاخِي بْعَثْتْلِكْ بِالوَقْتْ، وإِنْتِ مَا قَصَّرْتِشْ كِي جِيتْ. وأَحْنَا تَوَّا حَاضْرِينْ الكُلْ قُدَّامْ اللَّهْ بَاشْ نِسْمْعُوا كُلْ الِّي أَمْرِكْ بِيهْ الرَّبْ بَاشْ تْقُولُو».<verse eid="ACT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />بْدَا بُطْرُسْ يِتْكَلِّمْ وقَالْ: « آنَا بِالحَقْ تْأَكَّدِتْ الِّي اللَّهْ مَا يْمَيِّزْ حَدْ عْلَى حَدْ. <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />وهُوَّ يِقْبِلْ كُلْ وَاحِدْ يِتَّقِيهْ ويَعْمِلْ الصَّلَاحْ، مَهْمَا كَانِتْ جِنْسِيتُو. <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />وبْعَثْ كِلْمْتُو لْبَنِي إِسْرَائِيلْ، وبَشَّرْهُمْ بِالسَّلَامْ الِّي يْجِي عْلَى طْرِيقْ يَسُوعْ المَسِيحْ، الِّي هُوَّ رَبْ الكُلْ. <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />وإِنْتُومَا لَازِمْ سْمَعْتُوا بِالحَاجَاتْ الِّي صَارِتْ فِي مَنْطَقْةْ اليَهُودِيَّة، ولِّي بْدَاتْ فِي الجَلِيلْ بَعْدْ المَعْمُودِيَّة الِّي نَادَى بِيهْ يُوحَنَّا، <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />وكِيفَاشْ اللَّهْ مْلَى يَسُوعْ النَّاصْرِي بِالرُّوحْ القُدُسْ وبِالقُوَّة، وكِيفَاشْ كَانْ يِمْشِي مِنْ بُقْعَة لْبُقْعَة يَعْمِلْ فِي الخِيرْ ويِشْفِي الِّي تْسَلِّطْ عْلِيهُمْ إِبْلِيسْ الكُلْ، عْلَى خَاطِرْ اللَّهْ كَانْ مْعَاهْ. <verse eid="ACT 10:38" /><verse number="39" style="v" sid="ACT 10:39" />وأَحْنَا شْهُودْ عْلَى كُلْ الِّي عَمْلُو فِي بْلَادْ اليْهُودْ وفِي أُورْشَلِيمْ. وبِالحَقْ صَلْبُوهْ وقَتْلُوهْ. <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />آمَا اللَّهْ قَوْمُو مِالمُوتْ فِي النْهَارْ الثَّالِثْ، وخَلَّاهْ يُظْهُرْ، <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />مُشْ لِلنَّاسْ الكُلْ، آمَا لِلشْهُودْ الِّي إِخْتَارْهُمْ اللَّهْ مِنْ قْبَلْ، مَعْنَاهَا لِينَا أَحْنَا الِّي كْلِينَا وشْرَبْنَا مْعَاهْ بَعْدْمَا قَامْ مِالمُوتْ. <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />ووَصَّانَا نْوَصْلُوا البْشَارَة لِلنَّاسْ، ونِشْهْدُوا الِّي اللَّهْ حَطُّو هُوَّ بَاشْ يْحَاسِبْ الحَيِّينْ والمُوتَى. <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />والأَنْبِيَاءْ الكُلْ يِشْهْدُولُو الِّي كُلْ وَاحِدْ يَأَمِّنْ بِيهْ تِتْغْفِرْ ذْنُوبُو بْإِسْمُو».<verse eid="ACT 10:43" /></para>
  <para style="s">الرُّوحْ القُدُسْ يَهْبِطْ عَلِّي مَاهُمْشْ يْهُودْ</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />وَقْتِلِّي كَانْ بُطْرُسْ يْقُولْ فِي الكْلَامْ هَاذَا، هْبَطْ الرُّوحْ القُدُسْ عَلِّي كَانُوا يِسْمْعُوا فِيهْ الكُلْ. <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />يَاخِي تْعَجْبُوا المُؤْمْنِينْ اليْهُودْ الِّي جَاوْا مْعَ بُطْرُسْ، عْلَى خَاطِرْ اللَّهْ عْطَى هِيبِةْ الرُّوحْ القُدُسْ لِلنَّاسْ الِّي مَاهُمْشْ يْهُودْ زَادَا. <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />وسَمْعُوهُمْ يِتْكَلْمُوا بْلُوغَاتْ أُخْرَى ويْسَبْحُوا فِي اللَّهْ. يَاخِي بُطْرُسْ قَالْ: <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />«النَّاسْ هَاذُومَا خْذَاوْ الرُّوحْ القُدُسْ كِيفْنَا، مَالَا يْنَجِّمْشْ وَاحِدْ يَمْنَعْ إِنْهُمْ يِتْعَمْدُوا بِالمَاء؟». <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />وأْمَرْ بَاشْ يِتْعَمْدُوا بْإِسْمْ يَسُوعْ المَسِيحْ، ومْبَعِّدْ طَلْبُوا مِنُّو بَاشْ يْزِيدْ يُقْعُدْ مْعَاهُمْ أَيَّامَاتْ أُخْرِينْ.<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s">بُطْرُسْ يْفَسِّرْ فِلِّي صَارْ فِي يَافَا</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />وسَمْعُوا الرُّسُلْ والإِخْوَة الِّي فِي اليَهُودِيَّة، الِّي الشُّعُوبْ الأُخْرِينْ زَادَا قِبْلُوا كِلْمِةْ اللَّهْ. <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />وَقْتِلِّي رْجَعْ بُطْرُسْ لْأُورْشَلِيمْ، المُؤْمْنِينْ اليْهُودْ المْطَهْرِينْ لَامُوا عْلِيهْ وقَالُولُو: <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />«كِيفَاشْ دْخَلْتْ لْدَارْ نَاسْ مُشْ مْطَهْرِينْ وكْلِيتْ مْعَاهُمْ؟».<verse eid="ACT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 11:4" />يَاخِي بْدَى بُطْرُسْ يْفَسْرِلْهُمْ فِلِّي صَارْ بِالتَّفْصِيلْ، وقَالْ: <verse eid="ACT 11:4" /><verse number="5" style="v" sid="ACT 11:5" />«كُنْتْ نْصَلِّي فِي يَافَا، يَاخِي شُفْتْ فِي رُؤْيَا حَاجَة كِالمَلْحْفَة الكْبِيرَة مَرْبُوطَة مِالأَرْبْعَة شِيرَاتْ هَابْطَة مِالسْمَاء حَتَّى لِينْ وِصْلِتْلِي. <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />وَقْتِلِّي ثَبَّتّْ مْلِيحْ، لْقِيتْ فِيهَا أَنْوَاعْ الحَيَوَانَاتْ الِّي تِمْشِي ولِّي تَزْحِفْ ولِّي اطِّيرْ والحَيَوَانَاتْ المِتْوَحْشَةْ. <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />وسْمَعْتْ صُوتْ يْقُلِّي: "يَا بُطْرُسْ، قُومْ اذْبَحْ وكُولْ!". <verse eid="ACT 11:7" /><verse number="8" style="v" sid="ACT 11:8" />آمَا آنَا جَاوِبْتْ: "لَا يَا رَبْ! رَانِي عُمْرِي مَا حَطِّيتْ فِي فُمِّي حَاجَة مَنْزُوسَة ولَا مْحَرْمَة". <verse eid="ACT 11:8" /><verse number="9" style="v" sid="ACT 11:9" />يَاخِي الصُّوتْ جَاوِبْنِي مَرَّة أُخْرَى مِالسْمَاء: "الِّي طَهْرُو اللَّهْ مَا تِحْسْبُوشْ إِنْتِ مَنْزُوسْ". <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />وتْعَاوِدْ هَاذَا ثْلَاثَة مَرَّاتْ، وبَعْدْ تْهَزَ كُلْ شَيْ لِلسْمَاء. <verse eid="ACT 11:10" /><verse number="11" style="v" sid="ACT 11:11" />وفِي لَحْظِتْهَا، وُصْلُوا لِلدَّارْ الِّي كُنْتْ فِيهَا، ثْلَاثَة رْجَالْ مَبْعُوثِينْ لِيَّا مِنْ مْدِينِةْ قَيْصَرِيَّة. <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />وأْمَرْنِي الرُّوحْ بَاشْ نِمْشِي مْعَاهُمْ مِنْ غِيرْ مَا نِتْرَدِّدْ. يَاخِي مْشِيتْ ومْعَايَا السِّتَّة أَخْوَة هَاذُومَا. ودْخَلْنَا لْدَارْ الرَّاجِلْ، <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />حْكَالْنَا كِيفَاشْ شَافْ المَلَاكْ وَاقِفْ فِي دَارُو ويْقُلُّو: "أَبْعِثْ رْجَالْ لْيَافَا يْجِيبُوا سِمْعَانْ الِّي يْعَيْطُولُو بُطْرُسْ. <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />وهُوَّ بِشْ يْكَلْمِكْ بِكْلَامْ تِنْجَى بِيهْ إِنْتِ وعَايِلْتِكْ الكُلْ". <verse eid="ACT 11:14" /><verse number="15" style="v" sid="ACT 11:15" />وَقْتِلِّي بْدِيتْ نِتْكَلِّمْ هْبَطْ عْلِيهُمْ الرُّوحْ القُدُسْ كِيمَا هْبَطْ عْلِينَا أَحْنَا فِي الأُوِّلْ. <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />وتْذَكَّرْتْ الِّي قَالْهُولْنَا الرَّبْ: "يُوحَنَّا عَمِّدْ بِالمَاءْ، آمَا إِنْتُومَا بِشْ تِتْعَمْدُوا بِالرُّوحْ القُدُسْ". <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />إِذَا كَانْ اللَّهْ عْطَاهُمْ نَفْسْ الهِيبَة الِّي عْطَاهَالْنَا كِي أَمَّنَّا بِالرَّبْ يَسُوعْ المَسِيحْ، شْكُونْ آنَا بَاشْ نَمْنْعُو؟».<verse eid="ACT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18" />وَقْتِلِّي الحَاضْرِينْ سَمْعُوا الكْلَامْ هَاذَا، سِكْتُوا وحَمْدُوا اللَّهْ وقَالُوا: «مَالَا اللَّهْ نْعِمْ زَادَا عَلِّي مَاهُمْشْ يْهُودْ بَاشْ يْتُوبُوا ويِنْجَاوْ».<verse eid="ACT 11:18" /></para>
  <para style="s">المُؤْمْنِينْ فِي أَنْطَاكْيَة</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />آمَا المُؤْمْنِينْ الِّي تْفَرْقُوا بِسْبَبْ الإِضْطِهَادْ الِّي صَارِلْهُمْ بَعْدْمَا مَاتْ اسْتِفَانُوسْ، وِصْلُوْا حَتَّى لْفِينِيقْيَة وقُبْرُصْ وأَنْطَاكْيَة ومَا بَشْرُوا بِكِلْمَةْ اللَّهْ كَانْ اليْهُودْ. <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />آمَا كَانْ فَمَّة شْكُونْ مِنْهُمْ أَصْلْهُمْ مِنْ قُبْرُصْ وقِيرِينَا، كِي وُصْلُوا لْأَنْطَاكْيَة، بْدَاوْ يَحْكِيوْ مْعَ اليُونَانِيِّينْ ويْبَشْرُوا فِيهُمْ بِالرَّبْ يَسُوعْ. <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />وكَانْ الرَّبْ مْعَاهُمْ، يَاخِي أَمْنُوا بَرْشَة نَاسْ، ورَجْعُوا لِلرَّبْ.<verse eid="ACT 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22" />ووْصِلْ الخْبَرْ لِلكْنِيسَة المَوْجُودَة فِي أُورْشَلِيمْ، يَاخِي بَعْثُوا بَرْنَابَا لْأَنْطَاكْيَة. <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />وَقْتِلِّي وْصُلْ وشَافْ كِيفَاشْ اللَّهْ نْعِمْ عْلِيهُمْ، فْرَحْ بَرْشَة، ووَصَّاهُمْ بَاشْ يْشِدُّوا صْحِيحْ فِي الرَّبْ، مِنْ كُلْ قْلُوبْهُمْ. <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />وكَانْ بَرْنَابَا رَاجِلْ صَالَحْ، مِلْيَانْ بِالرُّوحْ القُدُسْ والإِيمَانْ، وبَرْشَة نَاسْ أَمْنُوا بِالرَّبْ.<verse eid="ACT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />ومْبَعِّدْ، مْشَى بَرْنَابَا لْطَرْسُوسْ يْلَوِّجْ عْلَى شَاوُلْ. <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />وَقْتِلِّي لْقَاهْ، رَجّْعُو مْعَاهْ لْأَنْطَاكْيَة، وقَعْدُوا عَامْ كَامِلْ وهُومَا يِتْلَمُّوا مْعَ الكْنِيسَة، ويْعَلْمُوا فِي بَرْشَة نَاسْ. وفِي أَنْطَاكْيَة، كَانِتْ أَوِّلْ مَرَّة يِتْسَمَّاوْ فِيهَا تْلَامِذْةْ الرَّبْ «المَسِيحِيِّينْ».<verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />وفِي الوَقْتْ هَاذَاكَا، جَاوْ أَنْبِيَاءْ مِنْ أُورْشَلِيمْ لْأَنْطَاكْيَة. <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />وْقِفْ وَاحِدْ مِنْهُمْ إِسْمُو أَغَابُوسْ، وتْنَبَّأْ بِالرُّوحْ الِّي بِشْ تْصِيرْ مَجَاعَة كْبِيرَة فِي العَالِمْ الكُلْ. والمَجَاعَة هَاذِي صَارِتْ بِالحَقْ فِي زْمَانْ القَيْصِرْ كْلُودْيُوسْ. <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />يَاخِي قَرْرُوا التْلَامْذَة بِشْ يِتْبَرَّعْ كُلْ وَاحِدْ مِنْهُمْ بِلِّي يَقْدِرْ عْلِيهْ ويِبْعْثُوا التَّبَرُّعَاتْ لِلْإِخْوَة السَّاكْنِينْ فِي مَنْطَقْةْ اليَهُودِيَّة. <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />وهَاذَا الِّي عَمْلُوهْ بِالضَّبْطْ، بَعْثُوا تَبَرُّعَاتْهُمْ لِشْيُوخْ الكْنِيسَة مْعَ بَرْنَابَا وشَاوُلْ.<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s">بُطْرُسْ يِمْنَعْ مِالحَبْسْ بْمُعْجْزَة</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />فِي الوَقْتْ هَاذَاكَا بْدَا المَلِكْ هِيرُودُسْ يِضْطَهِدْ فِي جْمَاعَة مِالمُؤْمْنِينْ الِّي فِي الكْنِيسَة. <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />وقْتَلْ يَعْقُوبْ خُو يُوحَنَّا بْسِيفْ. <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />وَقْتِلِّي شَافْ الِّي هَاذَا يْرَضِّي اليْهُودْ، قَرِّرْ بَاشْ يْشِدْ بُطْرُسْ زَادَا. وكَانْ هَاذَا فِي أَيَّامَاتْ عِيدْ الفْطِيرْ. <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />وَقْتِلِّي شَدُّو، حَطُّو فِي الحَبْسْ، وحَطْ أَرْبْعَة فِرَقْ عَسْكِرْ يْعِسُّوا عْلِيهْ، كُلْ فِرْقَةْ فِيهَا أَرْبْعَة، وكَانْ نَاوِي يُحْكُمْ عْلِيهْ قُدَّامْ الشَّعْبْ بَعْدْ عِيدْ الفِصْحْ. <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />هَاذَاكَا عْلَاشْ خَلَّاهْ فِي الحَبْسْ، آمَا الكْنِيسَة كَانِتْ تْصَلِّي لِلَّهْ بْقُوَّة عْلَى خَاطْرُو.<verse eid="ACT 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />وقْبَلْ مَا يُحْكُمْ عْلِيهْ هِيرُودُسْ بْلِيلَة، كَانْ بُطْرُسْ رَاقِدْ بِينْ زُوزْ عَسْكِرْ ومَرْبُوطْ بْزُوزْ سْلَاسِلْ، وكَانُوا الحُرَّاسْ قُدَّامْ البَابْ يْعِسُّوا عَالحَبْسْ. <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />وإِذَا بِيهْ ظْهُرْ مَلَاكْ مِنْ عَنْدْ الرَّبْ، والبِيتْ الِّي كَانْ مَرْبُوطْ فِيهَا الكُلْهَا ضْوَاتْ. وهْمِزْ المَلَاكْ بُطْرُسْ فِي جَنْبُو وفَيْقُو وقَالُّو: «قُومْ فِيسَعْ!». يَاخِي طَاحُوا السْلَاسِلْ الزُّوزْ مِنْ يْدِيهْ. <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />وقَالُّو المَلَاكْ: «إِلْبِسْ حْزَامِكْ وصَنْدَالِكْ». وعْمَلْ بُطْرُسْ كِيمَا قَالُّو، مْبَعِّدْ زَادْ قَالُّو: «إِلْبِسْ بَرْنُوسِكْ وتَبَّعْنِي!». <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />وخْرَجْ بُطْرُسْ يْتَبَّعْ فِي المَلَاكْ، ومَا كَانِشْ يَعْرِفْ إِنُّو الِّي عَمْلُو المَلَاكْ حْقِيقَة، مَاشِي فِي بَالُو قَاعِدْ يْشُوفْ فِي رُؤْيَا. <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />وَقْتِلِّي تْعَدَّاوْ عْلَى فِرْقِةْ العَسْكَرْ الأُولَى والثَّانِيَة ووُصْلُوا لْبَابْ الحَبْسْ الحْدِيدْ الِّي يْهِزْ لِلْمْدِينَة، تْحَلِّلْهُمْ البَابْ وَحْدُو، وخَرْجُوا. وبَعْدْمَا مْشَاوْ فِي أَوِّلْ النَهْجْ، خَلَّاهْ المَلَاكْ ومْشَى بِالوَقْتْ.<verse eid="ACT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11" />وَقْتْهَا فْطُنْ بُطْرُسْ وقَالْ: «تَوْ تْأَكِّدْتْ الِّي الرَّبْ بْعَثْ مَلَاكُو ومَنَّعْنِي مِنْ يِدْ هِيرُودُسْ ومِلِّي كَانُوا اليْهُودْ يِتْوَقْعُوهْ بِشْ يَعْمْلُوا فِيَّا». <verse eid="ACT 12:11" /><verse number="12" style="v" sid="ACT 12:12" />وَقْتِلِّي فْهِمْ هَاذَا، مْشَى لْدَارْ مَرْيِمْ أُمْ يُوحَنَّا الِّي يْسَمِّيوَهْ مُرْقُسْ، وِينْ كَانُوا بَرْشَة مُؤْمْنِينْ مَلْمُومِينْ يْصَلِّيوْ. <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />دَقْ عَالبَابْ البَرَّانِي، يَاخِي جَاتْ خْدِيمَة اسْمْهَا رُودَة بَاشْ تْشُوفْ شْكُونْ. <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />وكِي سَمْعِتْ صُوتْ بُطْرُسْ عَرْفِتُّو. يَاخِي مِنْ فَرْحِتْهَا نْسَاتْ بَاشْ تْحِلْ البَابْ ودَخْلِتْ تِجْرِي وقَالْتِلْهُمْ: «رَاهُو بُطْرُسْ وَاقِفْ قُدَّامْ البَابْ!». <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />قَالُولْهَا: «إِنْتِ تْهَتْرِي!». آمَا هِيَّ شَدِّتْ صْحِيحْ فِي كْلَامْهَا، يَاخِي قَالُوا: «مَالَا هَاذَا مَلَاكُو!». <verse eid="ACT 12:15" /><verse number="16" style="v" sid="ACT 12:16" />وقْعَدْ بُطْرُسْ يْدُقْ فِي البَابْ حَتَّى لِينْ حَلُّولُو، وكِيفْ شَافُوهْ بِهْتُوا. <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />وهَزْ يِدُّو بَاشْ يُسْكْتُوا، وحْكَالْهُمْ كِيفَاشْ الرَّبْ خَرّْجُو مِالحَبْسْ. وقَالِلْهُمْ: «قُولُوا لْيَعْقُوبْ ولِلإِخْوَة المُؤْمْنِينْ عَلِّي صَارْ». ومْبَعِّدْ خْرَجْ ومْشَى لِبْلَاصَة أُخْرَى.<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />وَقْتِلِّي طْلَعْ النْهَارْ، الحُرَّاسْ دَخْلُوا بْعَضْهُمْ، وبْدَاوْ يِسْأْلُوا: «زَعْمَة آشْ صَارْ لْبُطْرُسْ؟». <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />وكِي طْلَبْ هِيرُودُسْ بَاشْ يْجِيبُوهْ ومَا لْقَاوُوهِشْ، إِسْتَجْوِبْ الحُرَّاسْ، وحْكُمْ عْلِيهُمْ بِالإِعْدَامْ. مْبَعِّدْ مْشَى هِيرُودُسْ مِنْ مَنْطَقْةْ اليَهُودِيَّة لْقَيْصَرِيَّة وقْعَدْ غَادِي.<verse eid="ACT 12:19" /></para>
  <para style="s">مُوتْ هِيرُودُسْ</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />وكَانْ هِيرُودُسْ نَاقِمْ عْلَى سُكَّانْ صُورْ وصَيْدَا. يَاخِي تْفَاهْمُوا مْعَ بْعَضْهُمْ وبَعْثُوا جْمَاعَة لِبْلَاسْتُسْ حَاجِبْ المَلِكْ وتْشَحْتُوهْ بَاشْ يِتْوَسْطِلْهُمْ، فَمَّاشْ مَا تِتْصَلَّحْ الأُمُورْ مْعَ هِيرُودُسْ، عْلَى خَاطِرْهُمْ كَانُوا يِسْتَرْزْقُوا مِنْ مَمْلِكْتُو. <verse eid="ACT 12:20" /><verse number="21" style="v" sid="ACT 12:21" />وفِي النْهَارْ الِّي بِشْ يْقَابِلْهُمْ فِيهْ، لْبِسْ هِيرُودُسْ لِبْسَة خَاصَّة بِالمُلُوكْ، وقْعَدْ عَالعَرْشْ وبْدَا يُخْطُبْ عْلِيهُمْ. <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />يَاخِي صَاحْ الشَّعْبْ: «هَاذَا صُوتْ إِلَاهْ، مُشْ صُوتْ إِنْسَانْ!». <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />وبِالوَقْتْ ضَرْبُو مَلَاكْ مِنْ عَنْدْ الرَّبْ عْلَى خَاطْرُو مَا عْطَاشْ المَجْدْ لِلَّهْ، يَاخِي كْلَاهْ الدُّودْ ومَاتْ.<verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />آمَا كَانِتْ كِلْمِةْ اللَّهْ مَاشْيَة وتِتِّنْشَرْ، وعْدَدْ المُؤْمْنِينْ مَاشِي ويُكْثُرْ. <verse eid="ACT 12:24" /><verse number="25" style="v" sid="ACT 12:25" />ورَجْعُوا بَرْنَابَا وشَاوُلْ مِنْ أُورْشَلِيمْ بَعْدْمَا كَمْلُوا مُهِمِّتْهُمْ، وجَابُوا مْعَاهُمْ يُوحَنَّا الِّي يْسَمِّيوَهْ مُرْقُسْ.<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s">بَرْنَابَا وشَاوُلْ يِتْفِرْزُوا لِلْخِدْمَة</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />وكَانْ فَمَّة فِي كْنِيسِةْ أَنْطَاكْيَة جْمَاعَة مِالأَنْبِيَاءْ والمُعَلْمِينْ، ومِنْهُمْ بَرْنَابَا، وسِمْعَانْ الِّي يْعَيْطُولُو لَسْوِدْ، ولُوكْيُوسْ مِنْ قِيرِينَا، ومَنَايَنْ الِّي تْرَبَّى مْعَ الوَالِي هِيرُودُسْ وَقْتِلِّي كَانْ صْغِيرْ، وشَاوُلْ. <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />وَقْتِلِّي كَانُوا يِعْبْدُوا فِي الرَّبْ وصَايْمِينْ، قَالِلْهُمْ الرُّوحْ القُدُسْ: «إِفْرْزُولِي بَرْنَابَا وشَاوُلْ لِلْخِدْمَة الِّي دْعِيتْهُمْ لِيهَا». <verse eid="ACT 13:2" /><verse number="3" style="v" sid="ACT 13:3" />بَعْدْمَا صَامُوا وصَلَّاوْ، حَطُّوا عْلِيهُمْ يْدِيهُمْ وخَلَّاوْهُمْ يِمْشِيوْ.<verse eid="ACT 13:3" /></para>
  <para style="s">بَرْنَابَا وشَاوُلْ فِي قُبْرُصْ</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />وكِي بْعَثْهُمْ الرُّوحْ القُدُسْ، مْشَاوْ بَرْنَابَا وشَاوُلْ لْبُرْطْ سَلُوكِيَة، ومِنْ غَادِي سَافْرُوا لْجَزِيرِةْ قُبْرُصْ عْلَى طْرِيقْ البْحَرْ. <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />وَقْتِلِّي وُصْلُوا لِمْدِينِةْ سَلَامِيسْ، بْدَاوْ يْبَشْرُوا بْكِلْمِةْ اللَّهْ فِي مْعَابِدْ اليْهُودْ وكَانْ يُوحَنَّا يْعَاوِنْ فِيهُمْ.<verse eid="ACT 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6" />وسَافْرُوا فِي جَزِيرِةْ قُبْرُصْ الكُلْ حَتَّى لِينْ وُصْلُوا لِمْدِينِةْ بَافُوسْ. وغَادِي لْقَاوْ سَحَّارْ يْهُودِي، نَبِيْ كَذَّابْ، إِسْمُو بَارْيَشُوعْ. <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />وكَانْ مِالمُقَرْبِينْ لْسَرْجِيُوسْ بُولُسْ وَالِي قُبْرُصْ. وكَانْ الوَالِي هَاذَا إِنْسَانْ ذْكِي. اسْتَدْعَى بَرْنَابَا وشَاوُلْ بَاشْ يِسْمَعْ مِنْهُمْ كِلْمِةْ اللَّهْ. <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />يَاخِي عَلِيمْ السَّحَّارْ (وهَاذَا مَعْنَى إِسْمُو)، جَاء ضِدْهُمْ وحَاوِلْ مَا يْخَلِّيشْ الوَالِي يَمِّنْ. <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />آمَا شَاوُلْ الِّي إِسْمُو بُولِسْ زَادَا تِمْلَى بِالرُّوحْ القُدُسْ، وخْزَرْ لِلسَّحَّارْ <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />وقَالُّو: «يَا وِلْدْ إِبْلِيسْ، يَا عْدُوْ الحَقْ، يَا غَشَّاشْ ويَا خْبِيثْ، مَاكِشْ بِشْ تْبَطِّلْ مِنْ تَعْوِيجْ الحْقِيقَة الِّي تْخُصْ الرَّبْ؟ <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />تَوَّا الرَّبْ بِشْ يْمِدْ عْلِيكْ يِدُّو وتْوَلِّي أَعْمَى، ومَا عَادِشْ تْشُوفْ الضَّوْ لْمُدَّة مِالزْمَانْ». وبِالوَقْتْ هَبْطِتْ عْلَى عِينِيهْ ضْبَابَة كَحْلَة، وبْدَا يْدُورْ ويْلَوِّجْ عْلَى شْكُونْ يْشِدُّو مِنْ يِدُّو ويْقُودُو. <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />وكِي شَافْ الوَالِي آشْ صَارْ تِبْهَرْ بْتَعْلِيمْ الرَّبْ وأَمِّنْ .<verse eid="ACT 13:12" /></para>
  <para style="s">فِي أَنْطَاكْيَة بِيسِيدِيَّة</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />وسَافِرْ بُولِسْ والزُّوزْ الِّي مْعَاهْ عْلَى طْرِيقْ البْحَرْ مِنْ بَافُوسْ لِمْدِينِةْ بَرْجَة الِّي فِي مَنْطَقْةْ بَمْفِيلِيَّة، وغَادِي خَلَّاهُمْ يُوحَنَّا ورْجَعْ لْأُورْشَلِيمْ. <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />آمَا هُومَا سَافْرُوا مِنْ بَرْجَة لِمْدِينِةْ أَنْطَاكْيَة الِّي فِي مَنْطَقْةْ بِيسِيدِيَّة، وفِي نْهَارْ السِّبْتْ دَخْلُوا لْمَعْبِدْ اليْهُودْ وقَعْدُوا. <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />وبَعْدْمَا تِقْرَى مِالتَّوْرَاةْ وكْتُبْ الأَنْبِيَاءْ، بَعْثُولْهُمْ رُؤَسَاءْ المَعْبِدْ وقَالُوا: «يَا خْوَاتْنَا، إِذَا كَانْ عَنْدْكُمْ كْلَامْ تْشَجْعُوا بِيهْ المَوْجُودِينْ، اتْفَضْلُوا».<verse eid="ACT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16" />وْقِفْ بُولِسْ وهَزْ يِدُّو سَكِّتْهُمْ وقَالْ: «يَا بَنِي إِسْرَائِيلْ، ويَلِّي تْخَافُوا اللَّهْ إِسْمْعُوا: <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />إِلَاهْ شَعْبْ إِسْرَائِيلْ إِخْتَارْ جْدُودْنَا، وزَادْ فِي عْدَدْ شَعْبْنَا وَقْتِلِّي كَانُوا مِتْغَرْبِينْ فِي مَصْرْ، ومْبَعِّدْ خَرِّجْهُمْ مِنْهَا بْقُدْرْتُو العْظِيمَة. <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />وتْحَمِّلْهُمْ لْمُدِّةْ أَرْبْعِينْ سْنَة فِي الصَّحْرَاء. <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />وفْنَى سَبْعَة شْعُوبْ فِي أَرْضْ كَنْعَانْ، وعْطَى أَرْضْهُمْ وَرْثَة لْشَعْبُو. <verse eid="ACT 13:19" /><verse number="20" style="v" sid="ACT 13:20" />وبَعْدْ مُدِّةْ 450 سْنَة، عْطَاهُمْ قُضَاةْ حَتَّى لْوَقْتْ النَّبِيْ صَمُوئِيلْ. <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />ومْبَعِّدْ، الشَّعْبْ طْلَبْ مَلِكْ. يَاخِي اللَّهْ حَطْ شَاوُلْ وِلْدْ قَيْسْ مِنْ عَرْشْ بِنْيَامِينْ مَلِكْ عْلِيهُمْ لْمُدِّةْ 40 سْنَة. <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />ومْبَعِّدْ نَحَّاهْ وحَطْ دَاوِدْ مَلِكْ عْلِيهُمْ، وشْهِدْلُو وقَالْ: "لْقِيتْ دَاوِدْ وِلْدْ يَسَّى رَاجِلْ يَرْضَى عْلِيهْ قَلْبِي، وبِشْ يَعْمِلْ الِّي نْحِبْ عْلِيهْ". <verse eid="ACT 13:22" /><verse number="23" style="v" sid="ACT 13:23" />ومِنْ ذُرِّيِّةْ دَاوِدْ، بْعَثْ اللَّهْ مُنَجِّي لْشَعْبْ إِسْرَائِيلْ كِيفْ مَا وعِدْهُمْ. والمُنَجِّي هَاذَا هُوَّ يَسُوعْ.<verse eid="ACT 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 13:24" />«وقْبَلْ مَا يْجِي يَسُوعْ، دْعَى يُوحَنَّا شَعْبْ إِسْرَائِيلْ الكُلْ بَاشْ يْتُوبُوا ويِتْعَمْدُوا. <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />وَقْتِلِّي قْرِيبْ يْكَمِّلْ مُهِمْتُو قَالْ: "شْكُونْ تِسْخَايْلُونِي؟ مَانِيشْ آنَا المُنَجِّي! آمَا هَاوْ بِشْ يْجِي بَعْدِي، وآنَا مَا نِسْتَاهِلْشْ حَتَّى بَاشْ نْحِلُّو رْبَايِطْ صَنْدَالُو".<verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />«يَا خْوَاتِي، إِنْتُومَا يَا وْلَادْ إِبْرَاهِيمْ وإِنْتُومَا يَلِّي تْخَافُوا اللَّهْ مِالحَاضْرِينْ، رَاهِي رِسَالِةْ النْجَاةْ تْبَعْثِتْ لِينَا أَحْنَا. <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />آمَا أَهْلْ أُورْشَلِيمْ ورُؤَسَاءْهُمْ مَا عَرْفُوشْ يَسُوعْ يَاخِي حُكْمُوا عْلِيهْ بِالمُوتْ. وهَكَّا تَمُّوا كْلَامْ الأَنْبِيَاءْ الِّي يَقْرَاوَهْ كُلْ نْهَارْ سِبْتْ. <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />ورَغْمِلِّي مَا لْقَاوْ حَتَّى سْبَبْ يِسْتَاهِلْ عْلِيهْ المُوتْ، طَلْبُوا مِنْ بِيلَاطُسْ بَاشْ يُقْتْلُو. <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />وبَعْدْمَا عَمْلُوا فِيهْ كُلْ الِّي كِتْبُوهْ عْلِيهْ الأَنْبِيَاءْ، هَبْطُوهْ مِنْ فُوقْ الصَّلِيبْ وحَطُّوهْ فِي القْبَرْ. <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />آمَا اللَّهْ قَوْمُو مِالمُوتْ. <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />ظْهُرْ مُدَّة لِلِّي مْشَاوْ مْعَاهْ مِالجَلِيلْ لْأُورْشَلِيمْ. وهُومَا تَوَّا يِشْهْدُولُو قُدَّامْ الشَّعْبْ.<verse eid="ACT 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 13:32" />«وأَحْنَا تَوَّا نْبَشْرُوكُمْ إِنُّو الوَعْدْ الِّي عْطَاهْ اللَّهْ لِجْدُودْنَا، <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />حَقْقُو لِوْلَادْهُمْ الِّي هُومَا أَحْنَا، وَقْتِلِّي قَوِّمْ يَسُوعْ مِالمُوتْ، كِيمَا مَكْتُوبْ فِي المَزْمُورْ الثَّانِي:</para>
  <para style="b" vid="ACT 13:33" />
  <para style="q1" vid="ACT 13:33">"إِنْتِ إِبْنِي،</para>
  <para style="q2" vid="ACT 13:33">وآنَا اليُومْ جِبْتِكْ".<verse eid="ACT 13:33" /></para>
  <para style="b" />
  <para style="m">
    <verse number="34" style="v" sid="ACT 13:34" />«واللَّهْ قَوْمُو مِالمُوتْ ومَا عَادِشْ بِشْ يِرْجَعْ يْمُوتْ بِالكُلْ، وهَاذَا آشْ قَالْ اللَّهْ فِي الكْتُبْ المُقَدْسَة:</para>
  <para style="b" vid="ACT 13:34" />
  <para style="q1" vid="ACT 13:34">"بِشْ نَعْطِيكُمْ البَرَكَاتْ المُقَدْسَة والصَّادْقَة،</para>
  <para style="q2" vid="ACT 13:34">الِّي وْعِدْتْ بِيهَا دَاوِدْ".<verse eid="ACT 13:34" /></para>
  <para style="b" />
  <para style="m">
    <verse number="35" style="v" sid="ACT 13:35" />«ويْقُولْ دَاوِدْ فِي مَزْمُورْ آخِرْ:</para>
  <para style="b" vid="ACT 13:35" />
  <para style="q1" vid="ACT 13:35">"مَاكِشْ بِشْ تْخَلِّي قُدُّوسِكْ يِفْسِدْ فِي القْبَرْ".<verse eid="ACT 13:35" /></para>
  <para style="b" />
  <para style="m">
    <verse number="36" style="v" sid="ACT 13:36" />«آمَا دَاوِدْ مَاتْ بَعْدْمَا خْدِمْ شَعْبُو بْحَسْبْ قَصْدْ اللَّهْ، وتِدْفِنْ مْعَ جْدُودُو وبَدْنُو تْعَفِّنْ. <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />آمَا الِّي قَوْمُو اللَّهْ مِالمُوتْ، بَدْنُو مَا فْسِدْشْ. <verse eid="ACT 13:37" /><verse number="38" style="v" sid="ACT 13:38" />مَالَا يْكُونْ فِي عِلْمْكُمْ يَا خْوَاتِي، الِّي أَحْنَا نْبَشْرُوا فِيكُمْ إِنُّو غُفْرَانْ الذْنُوبْ يْكُونْ عْلَى طْرِيقْ يَسُوعْ. <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />وكُلْ وَاحِدْ يَأَمِّنْ بِيهْ، يِتْحَرَّرْ مِنْ ذْنُوبُو الكُلْ. وهَاذَا شَرِيعِةْ مُوسَى مَا تْنَجَّمْشْ تَعْمْلُو. <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />مَالَا رُدُّوا بَالْكُمْ لَا يَجْرَالْكُمْ الِّي تْقَالْ فِي كْتُبْ الأَنْبِيَاءْ:<verse eid="ACT 13:40" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41" />"أُخْزْرُوا يَلِّي تِتْمَسْخْرُوا،</para>
  <para style="q2" vid="ACT 13:41">اتْعَجْبُوا وافْنَاوْ!</para>
  <para style="q1" vid="ACT 13:41">عْلَى خَاطِرْ فِي زْمَانْكُمْ بِشْ نَعْمِلْ شَيْ عْمُرْكُمْ لَا بِشْ تْصَدْقُوهْ</para>
  <para style="q2" vid="ACT 13:41">حَتَّى لَوْ حَدْ حْكَالْكُمْ عْلِيهْ"».<verse eid="ACT 13:41" /></para>
  <para style="b" />
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />ووَقْتِلِّي كَانُوا بُولِسْ وبَرْنَابَا خَارْجِينْ مِنْ مَعْبِدْ اليْهُودْ، لَحُّوا عْلِيهُمْ النَّاسْ بَاشْ يِرْجْعُوا السِّبْتْ الِّي بَعْدُو ويْكَلْمُوهُمْ فِي نَفْسْ المَوْضُوعْ. <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />وبَعْدْمَا وْفَى الإِجْتِمَاعْ، تَبْعُوهُمْ بَرْشَة مِاليْهُودْ ومِالمِتْهَوْدِينْ الِّي يْخَافُوا رَبِّي، يَاخِي بْدَاوْ بُولِسْ وبَرْنَابَا يْكَلْمُوا فِيهُمْ ويْشَجْعُوا فِيهُمْ بَاشْ يِثْبْتُوا فِي نِعْمِةْ اللَّهْ.<verse eid="ACT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />والسِّبْتْ الِّي مْبَعْدُو تْلَمُّوا تَقْرِيبْ إِمَّالِي البْلَادْ الكُلْ بَاشْ يِسْمْعُوا كِلْمِةْ اللَّهْ. <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />وكِي اليْهُودْ شَافُوا عْدَدْ النَّاسْ المَلْمُومِينْ، تِمْلَاتْ قْلُوبْهُمْ بِالغِيرَة وبْدَاوْ يْعَارْضُوا فِي بُولِسْ ويْسِبُّوا فِيهْ. <verse eid="ACT 13:45" /><verse number="46" style="v" sid="ACT 13:46" />يَاخِي كَلْمُوهُمْ بُولِسْ وبَرْنَابَا بْكُلْ ثِيقَة وقَالُوا: «كَانْ لَازِمْ نْوَصْلُوا كِلْمِةْ اللَّهْ لِيكُمْ إِنْتُومَا الأُولَانِينْ، آمَا كِي رْفَضْتُوهَا، وحْكُمْتُوا عْلَى رْوَاحْكُمْ بِلِّي إِنْتُومَا مَا تِسْتَاهْلُوشْ الحَيَاةْ الأَبَدِيَّة، هَانَا تَوَّا مَاشْيِنْ بَاشْ نْوَصْلُوهَا لِلِّي مَاهُمْشْ يْهُودْ. <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />والرَّبْ أَمَرْنَا وقَالْ:</para>
  <para style="b" vid="ACT 13:47" />
  <para style="q1" vid="ACT 13:47">"خَلِّيتِكْ نُورْ لِلشُّعُوبْ الأُخْرَى،</para>
  <para style="q2" vid="ACT 13:47">بَاشْ تْوَصِّلْ النْجَاةْ لِخِّرْ الأَرْضْ"».<verse eid="ACT 13:47" /></para>
  <para style="b" />
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />وكِي سَمْعُوا الِّي مَاهُمْشْ يْهُودْ الكْلَامْ هَاذَا، فَرْحُوا بَرْشَة، ومَجْدُوا كِلْمِةْ الرَّبْ. وأَمْنُوا كُلْ الِّي إِخْتَارْهُمْ اللَّهْ لِلحَيَاةْ الأَبَدِيَّة. <verse eid="ACT 13:48" /><verse number="49" style="v" sid="ACT 13:49" />وانْتَشْرِتْ كِلْمِةْ الرَّبْ فِي المَنْطْقَة الكُلْ.<verse eid="ACT 13:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="ACT 13:50" />آمَا اليْهُودْ حَرْشُوا النْسَاء المِتْدَيْنِينْ الِّي مْقَامْهُمْ عَالِي وأَعْيَانْ لِمْدِينَة. يَاخِي اتْسَبْبُّوا فِي اضْطِهَادْ ضِدْ بُولِسْ وبَرْنَابَا، حَتَّى طَرْدُوهُمْ مِنْ مَنْطْقِتْهُمْ. <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />يَاخِي نَفْضُوا التْرَابْ مِنْ سَاقِيهُمْ، أَمَارَة ضِدْهُمْ، ومْشَاوْ لْمَنْطَقْةْ إِيقُونْيَة. <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />وكَانُوا التْلَامْذَة مِلْيَانِينْ بِالفَرْحَة وبِالرُّوحْ القُدُسْ.<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s">فِي إِقُونْيَة</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />وفِي إِيقُونْيَة، دَخْلُوا بُولِسْ وبَرْنَابَا لْمَعْبِدْ اليْهُودْ كِالعَادَة، وقَالُوا كْلَامْ خَلَّى بَرْشَة يْهُودْ ولِّي مَاهُمْشْ يْهُودْ يَمْنُوا. <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />آمَا اليْهُودْ الِّي مَا أَمْنُوشْ، حَرْشُوا النَّاسْ الِّي مَاهُمْشْ يْهُودْ عَالإِخْوَة، وعَمْرُولْهُمْ مْخَاخْهُمْ عْلِيهُمْ. <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />آمَا بُولِسْ وبَرْنَابَا قَعْدُوا غَادِي مُدَّة طْوِيلَة يْبَشْرُوا بِالرَّبْ بْكُلْ ثِيقَة. وكَانْ الرَّبْ يْأَكِّدْ فِي كْلَامْهُمْ عْلَى نِعْمْتُو بْمُعْجْزَاتْ وعْجَايِبْ عْمَلْهَا عْلَى يْدِيهُمْ.<verse eid="ACT 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 14:4" />يَاخِي اتْقِسْمُوا أَهْلْ المْدِينَة: جْمَاعَة مْعَ اليْهُودْ، وجْمَاعَة مْعَ الرُّسُلْ الزُّوزْ. <verse eid="ACT 14:4" /><verse number="5" style="v" sid="ACT 14:5" />وكِي قَرْرُوا اليْهُودْ وشْيُوخْهُمْ والنَّاسْ الِّي مَاهُمْشْ يْهُودْ بَاشْ يْهِينُوا الرُّسُلْ ويُرْجْمُوهُمْ، <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />عَرْفُوا الرُّسُلْ الحْكَايَة، يَاخِي هَرْبُوا لْمُدُنْ لِسْتْرَة ودَرْبَة الِّي فِي مَنْطَقْةْ لِيقُونِيَة ولِلْبْلَايِصْ الدَّايْرَة بِيهُمْ <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />وكَمْلُوا يْبَشْرُوا غَادِي.<verse eid="ACT 14:7" /></para>
  <para style="s">فِي لِسْتْرَة ودَرْبَة</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />وفِي لِسْتْرَة، كَانْ فَمَّة رَاجِلْ قَاعِدْ، مَشْلُولْ مِلِّي تُولِدْ، وعُمْرُو مَا مْشَى بِالكُلْ . <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />وكَانْ يِسْمَعْ فِي كْلَامْ بُولِسْ، يَاخِي ثَبِّتْ فِيهْ بُولِسْ وشَافْ الِّي كَانْ عَنْدُو إِيمَانْ الِّي هُوَّ بِشْ يَبْرَى. <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />قَالُّو بْصُوتْ عَالِي: «قُومْ آقِفْ عْلَى سَاقِيكْ!». يَاخِي نَڨِّزْ الرَّاجِلْ وبْدَا يِمْشِي.<verse eid="ACT 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 14:11" />وكِي شَافُوا الحَاضْرِينْ الِّي عَمْلُو بُولِسْ، صَاحُوا بِاللُّوغَة اللِّيقُونِيَّة: «هَاوْ الآلْهَة ظُهْرُوا فِي شَكْلْ عْبَادْ وجَاوْ بَحْذَانَا!». <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />وسَمَّاوْ بَرْنَابَا «زَفْسَ»، وبُولِسْ «هَرْمَسَ» عْلَى خَاطْرُو هُوَّ الِّي كَانْ يِتْكَلِّمْ. <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />وكَانْ فِي مَدْخِلْ المْدِينَة مَعْبِدْ الإِلَاهْ زَفْسَ، جَاء الكَاهِنْ مْتَاعُو ووْرَاهْ نَاسْ أُخْرِينْ فِي يْدِيهُمْ تِيجَانْ مِالنَوَّارْ وجَايْبِينْ ثِيرَانْ بَاشْ يْقَدْمُوهُمْ ذْبِيحَة لْبُولِسْ وبَرْنَابَا. <verse eid="ACT 14:13" /><verse number="14" style="v" sid="ACT 14:14" />وَقْتِلِّي سَمْعُوا الرُّسُلْ بِالحْكَايَة، قَطْعُوا حْوَايِجْهُمْ، ومْشَاوْ لِلنَّاسْ يِجْرِيوْ ويْعَيْطُوا: <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />«يَا نَاسْ، عْلَاشْ تَعْمْلُوا هَكَّا؟ رَانَا بَشَرْ ضْعَافْ كِيفْنَا كِيفْكُمْ، جِينَا نْبَشْرُوا فِيكُمْ بَاشْ تْبَطْلُوا الحَاجَاتْ الفَارْغَة هَاذِي، وتِرْجْعُوا لِلَّهْ الحَيْ الِّي خْلَقْ الأَرْضْ والسْمَاء والبْحَرْ وكُلْ الِّي فِيهُمْ. <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />فِي الأَجْيَالْ السَّابْقَة الكُلْ اللَّهْ خَلَّى الشُّعُوبْ يِمْشِيوْ فِي الطْرِيقْ الِّي اخْتَارُوهْ، <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />آمَا فِي نَفْسْ الوَقْتْ كَانْ دِيمَا يَعْطِيهُمْ دَلِيلْ الِّي هُوَّ مَوْجُودْ بِالخِيرْ الِّي يَعْمْلُو، وهُوَّ مَزَّالْ يَعْطِيكُمْ المْطَرْ مِالسْمَاء، والصَّابَة فِي وَقْتْهَا، ويْشَبَّعْكُمْ بِالمَاكْلَة ويْفَرَّحْ قْلُوبْكُمْ». <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />وحَتَّى كِي قَالُولْهُمْ الكْلَامْ هَاذَا، مَا نَجْمُوا يَقْنْعُوهُمْ بَاشْ مَا يْقَدْمُولْهُمْشْ ذْبَايِحْ كَانْ بِالسِّيفْ.<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />وجَاوْ جْمَاعَة يْهُودْ مِنْ أَنْطَاكْيَة وإِيقُونْيَة ودَوْرُوا النَّاسْ عْلَى بُولِسْ، يَاخِي رُجْمُوهْ وكَرْكْرُوهْ لْبَرَّة مِالمْدِينَة، مَاشِي فِي بَالْهُمْ الِّي هُوَّ مَاتْ. <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />آمَا كِي دَارُوا بِيهْ التْلَامْذَة، قَامْ ودْخَلْ لِلْمْدِينَة. ومِنْ غُدْوَة سَافِرْ مْعَ بَرْنَابَا لْدَرْبَة.<verse eid="ACT 14:20" /></para>
  <para style="s">بُولِسْ وبَرْنَابَا يِرْجْعُوا لْأَنْطَاكْيَة</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />وبَشْرُوا أَهْلْ دَرْبَة وبَرْشَة مِنْهُمْ وَلَّاوْ تْلَامْذَة لِلْمَسِيحْ، ومْبَعِّدْ رَجْعُوا لِلسْتْرَة، ومِنْ لِسْتْرَة تْعَدَّاوْ لْإِيقُونِيَّة، وفِي الإِخِّرْ لْأَنْطَاكْيَة. <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />وكَانُوا يْقَوِّيوْ فِي عَزِيمِةْ التْلَامْذَة ويْشَجْعُوا فِيهُمْ بَاشْ يِثْبْتُوا فِي الإِيمَانْ ويْقُولُولْهُمْ: «لَازِمْ نْعَانِيوْ ونِتْعَذْبُوا بَاشْ نُدْخْلُوا لْمَمْلَكْةْ اللَّهْ». <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />وعَيْنُوا شْيُوخْ فِي كُلْ كَنِيسَة، وبَعْدْمَا صَلَّاوْ وصَامُوا، خَلَّاوْهُمْ فِي وْدِيعِةْ الرَّبْ الِّي أَمْنُوا بِيهْ.<verse eid="ACT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24" />ومْبَعِّدْ تْعَدَّاوْ عْلَى بِيسِيدِيَّة ووُصْلُوا لْمَنْطَقْةْ بَمْفِيلِيَّة. <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />وبَشْرُوا بْكِلْمِةْ اللَّهْ فِي بَرْجَة، ومْبَعِّدْ هَبْطُوا لِمْدِينِةْ أَتَّالِيَة. <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />ومِنْهَا رَجْعُوا عْلَى طْرِيقْ البْحَرْ لْأَنْطَاكْيَة، وهِيَّ المْدِينَة الِّي بَعْثُوهُمْ مِنْهَا الإِخْوَةْ فِي وْدِيعِةْ رَبِّي، لِلخِدْمَةْ الِّي كَمْلُوهَا.<verse eid="ACT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 14:27" />وَقْتِلِّي وُصْلُوا لْأَنْطَاكْيَة، اسْتَدْعَاوْ الكْنِيسَة، وحْكَاوْلْهُمْ عَلِّي عَمْلُو اللَّهْ مْعَاهُمْ، وكِيفَاشْ حَلْ بَابْ الإِيمَانْ لِلِّي مَاهُمْشْ يْهُودْ. <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />وقَعْدُوا مْعَ التْلَامْذَة مُدَّة طْوِيلَة.<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s">مَجْلِسْ أُورْشَلِيمْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />وجَاوْ جْمَاعَة مِاليَهُودِيَّة لْأَنْطَاكْيَة، وبْدَاوْا يْعَلْمُوا فِي الإِخْوَة ويْقُولُولْهُمْ: «كَانْ مَا تِطَّهْرُوشْ كِيفْ مَا تْقُولْ شَرِيعِةْ مُوسَى، مَاكُمْشْ بِشْ تِنْجَاوْ». <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />يَاخِي تْخَالْفُوا بُولِسْ وبَرْنَابَا مْعَاهُمْ وصَارِتْ بِينَاتْهُمْ نِقَاشَاتْ كْبِيرَة. وَلَّاوْ الكُلْ قَرْرُوا بِشْ يَبْعْثُوا بُولِسْ وبَرْنَابَا ومْعَاهُمْ مُؤْمْنِينْ أُخْرِينْ بَاشْ يْقَابْلُوا الرُّسُلْ وشْيُوخْ الكْنِيسَة الِّي فِي أُورْشَلِيمْ ويِتْشَاوْرُوا فِي المَوْضُوعْ هَاذَا.<verse eid="ACT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3" />وبَعْدْمَا عْطَاتْهُمْ الكْنِيسَة الِّي يِحْتَاجُوهْ لِلسْفَرْ، مْشَاوْ وتْعَدَّاوْ عْلَى فِينِيقْيَة والسَّامْرَة، وحْكَاوْ لِلْمُؤْمْنِينْ غَادِي كِيفَاشْ الِّي مَاهُمْشْ يْهُودْ زَادَا أَمْنُوا بِالمَسِيحْ. والإِخْوَة الكُلْ فَرْحُوا فَرْحَة كْبِيرَة بِالخْبَرْ هَاذَا. <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />وَقْتِلِّي وُصْلُوا لْأُورْشَلِيمْ، فَرْحُوا بِيهُمْ الرُّسُلْ والشْيُوخْ والكَنِيسَة الكُلْ، يَاخِي حْكَاوْلْهُمْ عَلِّي عَمْلُو اللَّهْ عْلَى يْدِيهُمْ. <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />آمَا فَمَّة شْكُونْ مِالمُؤْمْنِينْ الِّي كَانُوا قْبَلْ فِرِّيسِيِّينْ وِقْفُوا وقَالُوا: «المُؤْمْنِينْ الِّي مَاهُمْشْ يْهُودْ يِلْزِمْهُمْ يْطَهْرُوا، ولَازِمْ تُؤْمْرُوهُمْ بَاشْ يْطَبْقُوا شَرِيعِةْ مُوسَى».<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />وتْلَمُّوا الرُّسُلْ والشْيُوخْ بَاشْ يْنَاقْشُوا المَوْضُوعْ هَاذَا. <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />وبَعْدْ نِقَاشَاتْ طْوِيلَة، وْقِفْ بُطْرُسْ وقَالْ: «يَا خْوَاتِي، إِنْتُومَا تَعْرْفُوا الِّي اللَّهْ اخْتَارْنِي مِالأُوِّلْ بَاشْ النَّاسْ الِّي مَاهُمْشْ يْهُودْ يِسْمْعُوا البْشَارَة مِنِّي ويَمْنُوا. <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />واللَّهْ الِّي يَعْرِفْ القْلُوبْ، ظَهِّرْ الِّي هُوَّ قْبِلْهُمْ وَقْتِلِّي عْطَاهُمْ الرُّوحْ القُدُسْ كِيفْنَا أَحْنَا. <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />ومَا فَرِّقْشْ بِينَّا وبِينْهُمْ فِي حَتَّى شَيْ، عْلَى خَاطْرُو طَهِّرْ قْلُوبْهُمْ بِالإِيمَانْ. <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />مَالَا عْلَاشْ تْعَارْضُوا فِي اللَّهْ وتْحُطُّوا عَالتْلَامْذَةْ فِي حِمْلْ لَا نَجَّمْنَا نْهِزُّوهْ لَا جْدُودْنَا ولَا أَحْنَا؟ <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />بِالعَكْسْ أَحْنَا نَمْنُوا الِّي نِعْمِةْ الرَّبْ يَسُوعْ هِيَّ الِّي تْنَجِّينَا كِيمَا يِنْجَاوْ هُومَا زَادَا».<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />يَاخِي سِكْتُوا النَّاسْ الكُلْ، وبْدَاوْ يِسْمْعُوا فِي بَرْنَابَا وبُولِسْ يَحْكِيوْلْهُمْ عَالمُعْجْزَاتْ والعْجَايِبْ الِّي عْمَلْهَا اللَّهْ عْلَى يْدِيهُمْ بِينْ النَّاسْ الِّي مَاهُمْشْ يْهُودْ. <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />وبَعْدْمَا كَمْلُوا كْلَامْهُمْ، قَالْ يَعْقُوبْ: «يَا خْوَاتِي، إِسْمْعُونِي: <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />سِمْعَانْ حْكَالْكُمْ كِيفَاشْ اللَّهْ حْرَصْ مِالأُوِّلْ بَاشْ يِخْتَارْ مِنْ بِينْ الشُّعُوبْ شَعْبْ يْكُونْ خَاصْ لِيهْ . <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />وهَاذَا يْوَافِقْ كْلَامْ الأَنْبِيَاءْ كِيفْ مَا هُوَّ مَكْتُوبْ فِي الكْتُبْ المُقَدْسَةْ:<verse eid="ACT 15:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16" />"بَعْدْ هَاذَا بِشْ نِرْجَعْ،</para>
  <para style="q2" vid="ACT 15:16">ونِبْنِي خِيمِةْ دَاوِدْ الطَّايْحَة،</para>
  <para style="q1" vid="ACT 15:16">نِبْنِي الِّي بْقَى مِنْهَا</para>
  <para style="q2" vid="ACT 15:16">ونْوَقِّفْهَا مِنْ جْدِيدْ.<verse eid="ACT 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17" />بَاشْ هَكَّا، بْقِيِّةْ النَّاسْ يْنَجْمُوا يُطْلْبُوا الرَّبْ،</para>
  <para style="q2" vid="ACT 15:17">وزَادَا الشُّعُوبْ الِّي مَاهُمْشْ يْهُودْ الِّي دْعِيتْهُمْ بَاشْ يِتْسَمَّاوْ بِاسْمِي،</para>
  <para style="q1" vid="ACT 15:17">يْقُولْ الرَّبْ الِّي يَعْمِلْ الأُمُورْ هَاذِي،<verse eid="ACT 15:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ACT 15:18" />ولِّي يَعْرَفْهَا مِنْ أَوِّلْ الدِّنْيَا".<verse eid="ACT 15:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />«هَاذَاكَا عْلَاشْ نْرَى إِنُّو مَا لَازِمْنَاشْ نْثَقْلُوا عَالنَّاسْ الِّي رَجْعُوا لِلَّهْ مِلِّي مَاهُمْشْ يْهُودْ. <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />آمَا نِكْتْبُولْهُمْ ونْوَصِّيوْهُمْ بَاشْ مَا عَادِشْ يَاكْلُوا مِالذْبَايَحْ المَنْجُوسَة المَذْبُوحَة لِلأَصْنَامْ، وبَاشْ مَا عَادِشْ يَزْنَاوْ، ومَا عَادِشْ يَاكْلُوا لْحَمْ الحَيَوَانَاتْ المَخْنُوقَة، ولَا الدَّمْ. <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />عْلَى خَاطِرْ مِنْ قْدِيمْ الزْمَانْ مُوسَى كَانْ عَنْدُو نَاسْ تِشْهِدْلُو فِي كُلْ مْدِينَة، وشَرِيعْتُو تِتْقْرَى فِي المْعَابِدْ كُلْ نْهَارْ سِبْتْ».<verse eid="ACT 15:21" /></para>
  <para style="s">جَوَابْ المَجْلِسْ لْمُؤْمْنِينْ أَنْطَاكْيَة</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />يَاخِي قَرْرُوا الرُّسُلْ والشْيُوخْ والنَّاسْ الكُلْ الِّي فِي الكْنِيسَة بَاشْ يِخْتَارُوا زُوزْ رْجَالْ مِالإِخْوَة ويَبْعْثُوهُمْ مْعَ بُولِسْ وبَرْنَابَا لْأَنْطَاكْيَة. وَلَّاوْ إِخْتَارُوا يَهُوذَا الِّي يْعَيْطُولُو بَارْسَابَا وسِيلَا، الِّي كَانُوا يِعْتَبْرُوهُمْ مِالقَادَة. <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />وعْطَاوْهُمْ رِسَالَة مَكْتُوبْ فِيهَا:</para>
  <para style="pi" vid="ACT 15:23">«مِنْ خْوَاتْكُمْ الرُّسُلْ والشْيُوخْ.</para>
  <para style="pi" vid="ACT 15:23">«سَلَامْ لِلإِخْوَة المُؤْمْنِينْ الِّي مَاهُمْشْ يْهُودْ فِي أَنْطَاكْيَة وسُورْيَة وكِيلِيكِيَّة:<verse eid="ACT 15:23" /></para>
  <para style="pi">
    <verse number="24" style="v" sid="ACT 15:24" />«سْمَعْنَا الِّي فَمَّة نَاسْ جَاوْكُمْ مِنْ عَنْدْنَا مِنْ غِيرْ مَا فَوِّضْنَاهُمْ، وقَالُولْكُمْ كْلَامْ قَلَّقْكُمْ وخَلَّاكُمْ حَايْرِينْ، <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />هَاذَاكَا عْلَاشْ تْفَاهِمْنَا بَاشْ نِخْتَارُوا زُوزْ رْجَالْ ونَبْعْثُوهُمْلْكُمْ مْعَ خْوَاتْنَا الِّي يْعِزُّوا عْلِينَا بَرْنَابَا وبُولِسْ، <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />الِّي خَاطْرُوا بِحْيَاتْهُمْ بَاشْ يْبَشْرُوا بْإِسْمْ رَبْنَا يَسُوعْ المَسِيحْ. <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />وبْعَثْنَالْكُمْ يَهُوذَا وسِيلَا، بَاشْ تِسْمْعُوا مِنْهُمْ نَفْسْ الكْلَامْ الِّي كْتِبْنَاهُولْكُمْ. <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />عْلَى خَاطِرْ بِالنِّسْبَة لِلرُّوحْ القُدُسْ وبِالنِّسْبَة لِينَا أَحْنَا زَادَا، مُشْ لَازِمْ نْثَقْلُوا عْلِيكُمْ بْأَكْثِرْ مِالحَاجَاتْ الِّي لَا بُدَّا مِنْهَا ولِّي هِيَّ: <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />تْبَطْلُوا مَاكِلْةْ الذْبَايِحْ المَذْبُوحَة لِلصْنَبْ، والدَّمْ ولْحَمْ الحَيَوَانَاتْ المَخْنُوقَة والزْنَى. بَاهِي كَانْ تِبْعْدُوا عَالحَاجَاتْ هَاذِي.</para>
  <para style="pi" vid="ACT 15:29">«وتَوَّا نْخَلِيوْكُمْ فِي وْدِيعِةْ رَبِّي».<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />ومْشَاوْ الِّي إِخْتَارُوهُمْ لْأَنْطَاكْيَة، وغَادِي لَمُّوا المُؤْمْنِينْ الكُلْ، وعْطَاوْهُمْ الرِّسَالَة. <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />وكِي قْرَاوْهَا فَرْحُوا بَرْشَة عْلَى خَاطِرْ تْشَجْعُوا بِيهَا. <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />ويَهُوذَا وسِيلَا كَانُوا زَادَا أَنْبِيَاءْ، وقَالُوا بَرْشَة حَاجَاتْ شَجْعِتْ الإِخْوَة وقَوَّاتْهُمْ. <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />وبَعْدْمَا قَعْدُوا مُدَّة غَادِي، سَلْمُوا عْلِيهُمْ الإِخْوَة وخَلَّاوْهُمْ يِرْجْعُوا لِلِّي بَعْثُوهُمْ. <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />آمَا سِيلَا حَبْ يِبْقَى غَادِي، ولَّى يَهُوذَا رْجَعْ وَحْدُو. <verse eid="ACT 15:34" /><verse number="35" style="v" sid="ACT 15:35" />وقَعْدُوا بُولِسْ وبَرْنَابَا مُدَّة فِي أَنْطَاكْيَة، يْعَلْمُوا ويْبَشْرُوا بْكِلْمِةْ الرَّبْ وكَانُوا مْعَاهُمْ بَرْشَة نَاسْ أُخْرِينْ يْعَاوْنُوا فِيهُمْ.<verse eid="ACT 15:35" /></para>
  <para style="s">بُولِسْ وبَرْنَابَا يِتْفَارْقُوا</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />وبَعْدْ أَيَّامَاتْ، قَالْ بُولِسْ لْبَرْنَابَا: «هَيَّا نِرْجْعُوا ونْزُورُوا الإِخْوَة فِي كُلْ مْدِينَة بَشِّرْنَا فِيهَا بْكِلْمِةْ الرَّبْ، ونِطْمَانُوا عْلِيهُمْ». <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />وحَبْ بَرْنَابَا يْهِزُّوا مْعَاهُمْ يُوحَنَّا الِّي يْعَيْطُولُو مُرْقُسْ. <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />آمَا بُولِسْ مَا حَبِّشْ، عْلَى خَاطْرُو فِي بَمْفِيلِيَّة خَلَّاهُمْ، ومَا كَمَّلْشْ مْعَاهُمْ الخِدْمَة. <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />وتْعَارْكُوا حَتَّى لِينْ تْفَارْقُوا عَالحْكَايَة هَاذِي، وَهَزْ بَرْنَابَا مُرْقُسْ مْعَاهْ وسَافْرُوا لْقُبْرُصْ عْلَى طْرِيقْ البْحَرْ . <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />آمَا بُولِسْ اخْتَارْ سِيلَا. بَعْدْمَا الإِخْوَة سَلْمُوهْ فِي وْدِيعِةْ رَبِّي، <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />سَافْرُوا فِي سُورْيَة وكِيلِيكِيَّة، يْشَجْعُوا فِي الكْنَايِسْ فِي كُلْ بْلَاصَة.<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s">بُولِسْ يْهِزْ مْعَاهْ تِيمُوثَاوُسْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />ووْصِلْ بُولِسْ لْدَرْبَة ولِسْتْرَة، وكَانْ فِيهَا تِلْمِيذْ إِسْمُو تِيمُوثَاوُسْ، أُمُّو كَانِتْ يْهُودِيَّة وأَمْنِتْ بِالمَسِيحْ وبُوهْ كَانْ يُونَانِي. <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />وكَانِتْ عَنْدُو سُمْعَةْ بَاهْيَة عَنْدْ الإِخْوَة فِي إِيقُونْيَة ولِسْتْرَة. <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />وحَبْ بُولِسْ يِهِزُّو مْعَاهْ. وَلَّى طَهَّرْلُو، عْلَى خَاطِرْ اليْهُودْ الِّي سَاكْنِينْ غَادِي، يَعْرْفُوا الِّي بُوهْ يُونَانِي. <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />ومْشَاوْ بُولِسْ وصْحَابُو مِنْ بْلَادْ لِبْلَادْ يْوَصْلُوا فِي القَرَارَاتْ الِّي خْذَاوْهُمْ الرُّسُلْ والشْيُوخْ فِي أُورْشَلِيمْ لِلْمُؤْمْنِينْ بَاشْ يْطَبْقُوهَا. <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />وكَانِتْ الكْنَايِسْ تِتْقَوَّى فِي الإِيمَانْ، وعْدَدْ المُؤْمْنِينْ يْزِيدْ نْهَارْ بَعْدْ نْهَارْ.<verse eid="ACT 16:5" /></para>
  <para style="s">بُولِسْ يْشُوفْ رُؤْيَا</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />بَعْدْمَا مْنَعْهُمْ الرُّوحْ القُدُسْ بَاشْ يْبَشْرُوا فِي آسِيَّا، تْعَدَّاوْ لْمَنَاطِقْ فَرِيجِيَّة وغَلَاطْيَة. <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />وكِي وُصْلُوا لِحْدُودْ مْدِينِةْ مِيسِيَّا، حَاوْلُوا بَاشْ يُدْخْلُوا لْمَنْطَقْةْ بِثِينِيَّة، آمَا رُوحْ يَسُوعْ مَا خَلَّاهُمْشْ. <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />وَلَّاوْ تْعَدَّاوْ عْلَى مِيسِيَّة ومْشَاوْ لِمْدِينِةْ تَرُوَاسْ. <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />وفِي اللِّيلَة هَاذِيكَا شَافْ بُولِسْ فِي رُؤْيَا، رَاجِلْ مِنْ مَقْدُونِيَّة يِتْشَحِّتْ فِيهْ ويْقُولْ: «تْعَدَّى لْمَقْدُونِيَّة وعَاوِنَّا!». <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />وَقْتْهَا تْأَكِّدْنَا الِّي اللَّهْ يْحِبْنَا نْبَشْرُوا بِالبْشَارَة فِي مَقْدُونِيَّة. يَاخِي مْشِينَالْهَا بِالوَقْتْ.<verse eid="ACT 16:10" /></para>
  <para style="s">لِيدْيَّة تَمِّنْ وتِتْعَمِّدْ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />وسَافِرْنَا مِنْ بُرْطْ تَرُوَاسْ لْجَزِيرِةْ سَامُوثْرَاكِي. ومِنْ غُدْوَة كَمِّلْنَا سْفَرْنَا لِمْدِينِةْ نِيَاۑُولِيسْ. <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />ومِنْ غَادِي مْشِينَا لْفِيلِۑِّي، وهِيَّ أَكْبِرْ مْدِينَة إِسْتَعْمْرُوهَا الرُّومَانْ فِي وِلَايِةْ مَقْدُونِيَّة. وقْعَدْنَا فِيهَا أَيَّامَاتْ. <verse eid="ACT 16:12" /><verse number="13" style="v" sid="ACT 16:13" />ونْهَارْ السِّبْتْ خْرَجْنَا مِنْ بَابْ المْدِينَة ومْشِينَا لِبْلَاصَة قْرِيبْ الوَادْ، كَانُوا اليْهُودْ مِسْتَانْسِينْ يْصَلِّيوْ فِيهَا. يَاخِي قْعَدْنَا نِتْكَلْمُوا مْعَ النْسَاء المَلْمُومِينْ غَادِي. <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />وكَانِتْ بِينَاتْهُمْ مْرَا تَقِيَّة اسْمْهَا لِيدِيَّة مِنْ مْدِينِةْ ثِيَاتِيرَا، اتَّاجِرْ فِي القْمَاشَاتْ الغَالْيَة. وَقْتِلِّي كَانِتْ تِسْمَعْ فِي بُولِسْ، اللَّهْ حَلْ قَلْبْهَا بَاشْ تِقْبِلْ كْلَامُو، <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />وكِي تَعَمْدِتْ هِيَّ وعَايْلِتْهَا، شَدِّتْ فِينَا صْحِيحْ وقَالْتِلْنَا: «إِذَا كَانْ تِعْتَبْرُونِي مُؤْمْنَة بِالرَّبْ، إِيجَاوْ لْدَارِي وأُقْعْدُوا عَنْدِي». ولَزْمِتْ عْلِينَا.<verse eid="ACT 16:15" /></para>
  <para style="s">بُولِسْ وسِيلَا فِي الحَبْسْ</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />وفِي نْهَارْ مِنْ النْهَارَاتْ كُنَّا مَاشِينْ نْصَلِّيوْ، عُرْضِتْنَا خْدِيمَة سَاكِنْهَا رُوحْ يْخَلِّيهَا تْنَجِّمْ ادَّڨِّزْ. وكَانِتْ بِالدْڨَازَة هَاذِي تْجِيبْ لَسْيَادْهَا بَرْشَة فْلُوسْ. <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />يَاخِي بْدَاتْ اتَّبَّعْ فِينَا وفِي بُولِسْ وتْصِيحْ: «النَّاسْ هَاذُمْ يِخْدْمُوا فِي اللَّهْ العَالِي، ويْخَبْرُوا فِيكُمْ عْلَى طْرِيقْ النْجَاةْ!». <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />وقَعْدِتْ بَرْشَة أَيَّامَاتْ وهِيَّ تَعْمِلْ فِي نَفْسْ الحَاجَة حَتَّى لِينْ بُولِسْ تْقَلَّقْ، يَاخِي تْلَفِّتْ وقَالْ لِلرُّوحْ: «نُأْمْرِكْ بْإِسْمْ يَسُوعْ المَسِيحْ بَاشْ تُخْرُجْ مِنْهَا». وبِالوَقْتْ خْرَجْ مِنْهَا. <verse eid="ACT 16:18" /><verse number="19" style="v" sid="ACT 16:19" />وَقْتِلِّي أَسْيَادْهَا شَافُوا الِّي بَابْ رِزْقْهُمْ تْسَكِّرْ، شَدُّوا بُولِسْ وسِيلَا، وكَرْكْرُوهُمْ لْسَاحِةْ المْدِينَة بَاشْ يْحَاكْمُوهُمْ. <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />وَقْفُوهُمْ قُدَّامْ الحُكَّامْ وقَالُوا: «الرْجَالْ هَاذُومَا الزُّوزْ يَعْمْلُوا فِي بَلْبْلَةْ فِي البْلَادْ، وهُومَا يْهُودْ <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />يْحِبُّوا يْدَخْلُولْنَا عَادَاتْ أَحْنَا الرُّومَانِيِّينْ مَمْنُوعْ عْلِينَا نِقْبْلُوهَا وَلَّا نَعْمْلُوهَا». <verse eid="ACT 16:21" /><verse number="22" style="v" sid="ACT 16:22" />يَاخِي هَاجُوا عْلِيهُمْ النَّاسْ، والحُكَّامْ عْطَاوْ أَمْرْ بَاشْ يْقَطْعُولْهُمْ حْوَايِجْهُمْ، ويَضْرْبُوهُمْ بِالعْصِيْ. <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />وبَعْدْمَا ضَرْبُوهُمْ بَرْشَة، رْمَاوْهُمْ فِي الحَبْسْ، ووَصَّاوْ السَّجَّانْ بَاشْ يْعِسْ عْلِيهُمْ بِالڨْدَا. <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />وبَاشْ يَعْمِلْ الِّي وَصَّاوَهْ عْلِيهْ، حَطْهُمْ فِي الحَبْسْ الدَّخْلَانِي، ورَبْطِّلْهُمْ سَاقِيهُمْ فِي قَالِبْ لُوحْ.<verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />ومْعَ نُصْفْ اللِّيلْ، كَانُوا بُولِسْ وسِيلَا يْصَلِّيوْ ويْسَبْحُوا فِي اللَّهْ بِالتَّرَانِيمْ، والمَرْبُوطِينْ الأُخْرِينْ يِسْمْعُوا فِيهُمْ. <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />وإِذَا بِيهْ زِلْزَالْ قْوِيْ زَعْزَعْ سِيسَانْ الحَبْسْ، وبِالوَقْتْ تْحَلِّتْ البِيبَانْ وتْخَلْعِتْ سْلَاسِلْ المْرَابِيطْ الكُلْ. <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />وقَامْ السَّجَّانْ مِالنُّومْ، وشَافْ بِيبَانْ الحَبْسْ مَحْلُولَة، يَاخِي جْبِدْ سِيفُو بَاشْ يُقْتُلْ رُوحُو عْلَى خَاطِرْ مْشَى فِي بَالُو الِّي المْرَابِيطْ هَرْبُوا. <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />آمَا بُولِسْ عَيِّطْ عْلَى طُولْ صُوتُو: «رُدْ بَالِكْ تْضُرْ رُوحِكْ! أَحْنَا الكُلْ هْنَا». <verse eid="ACT 16:28" /><verse number="29" style="v" sid="ACT 16:29" />وطْلَبْ السَّجَّانْ يْجِيبُولُو ضَوْ، ودْخَلْ يِجْرِي لْدَاخِلْ وهُوَّ يُرْعِشْ بِالخُوفْ، وتِرْمَى عَنْدْ سَاقِينْ بُولِسْ وسِيلَا. <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />مْبَعِّدْ خَرِّجْهُمْ لْبَرَّة وسْإِلْهُمْ: «يَا سْيَادِي، آشْ لَازِمْنِي نَعْمِلْ بَاشْ نِنْجَى؟». <verse eid="ACT 16:30" /><verse number="31" style="v" sid="ACT 16:31" />جَاوْبُوهْ: «أَمِّنْ بِالرَّبْ يَسُوعْ، تَوْ تِنْجَى إِنْتِ وعَايِلْتِكْ». <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />وبَشْرُوهْ هُوَّ وعَايِلْتُو الكُلْ بْكِلْمِةْ الرَّبْ.<verse eid="ACT 16:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 16:33" />وفِي نَفْسْ اللَّحْظَة فِي اللِّيلَة هَاذِيكَا بِيدْهَا هَزْهُمْ ونَظْفِلْهُمْ جْرُوحْهُمْ وبِالوَقْتْ تْعَمِّدْ هُوَّ وعَايِلْتُو الكُلْ. <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />وبَعْدْ هَزْهُمْ لْدَارُو، وحَطِّلْهُمْ المَاكْلَة، وفْرَحْ مْعَ عَايِلْتُو الكُلْ، عْلَى خَاطْرُو أَمَّنْ بِاللَّهْ.<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />ووَقْتِلِّي طْلَعْ النْهَارْ، بَعْثُوا الحُكَّامْ مَجْمُوعَة مِالحَرَسْ بَاشْ يْقُولُوا لِلْسَّجَّانْ: «سَيِّبْ الزُّوزْ رْجَالْ». <verse eid="ACT 16:35" /><verse number="36" style="v" sid="ACT 16:36" />وعَاوِدْ السَّجَّانْ كْلَامْهُمْ لْبُولِسْ وقَالُّو: «الحُكَّامْ أَمْرُونِي بَاشْ نْسَيِّبْكُمْ، أُخْرْجُوا تَوَّا وإِمْشِيوْ فِي آمَانْ اللَّهْ». <verse eid="ACT 16:36" /><verse number="37" style="v" sid="ACT 16:37" />آمَا بُولِسْ قَالِلْهُمْ: «كِيفَاشْ! ضَرْبُونَا قُدَّامْ النَّاسْ مِنْ غِيرْ مَا يْحَاكْمُونَا ورْمَاوْنَا فِي الحَبْسْ رَغْمِلِّي عَنْدْنَا الجِنْسِيَّة الرُّومَانِيَّة، وتَوَّا يْحِبُّوا يْسَيْبُونَا بِالسِّرْقَة. لَا! لَازِمْ يْجِيوْ هُومَا بِيدْهُمْ ويْسَيْبُونَا!». <verse eid="ACT 16:37" /><verse number="38" style="v" sid="ACT 16:38" />وَصّْلُوا الحَرَسْ كْلَامْهُمْ لِلحُكَّامْ. وَقْتِلِّي سَمْعُوا الِّي هُومَا رُومَانْ خَافُوا، <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />يَاخِي جَاوْ وطَلْبُوا مِنْهُمْ السْمَاحْ وسَيْبُوهُمْ، وطَلْبُوا مِنْهُمْ يُخْرْجُوا مِالمْدِينَة. <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />وكِي خْرَجْ بُولِسْ وسِيلَا مِالحَبْسْ، مْشَاوْ لْدَارْ لِيدِيَّة، وغَادِي قَابْلُوا الإِخْوَة وشَجْعُوهُمْ. ومْبَعِّدْ مْشَاوْ عْلَى رْوَاحْهُمْ.<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s">اليْهُودْ يْعَارْضُوا بُولِسْ فِي تْسَالُونِيكِي</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />وبَعْدْمَا تْعَدَّاوْ عْلَى مُدُنْ أَمْفِيۑُولِيسْ وأَۑُولُونِيَّة، وُصْلُوا لِمْدِينِةْ تْسَالُونِيكِي. وكَانْ فِيهَا مَعْبِدْ لِلْيْهُودْ. <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />وكِيمَا عَادْتُو، دْخَلْ بُولِسْ لِلمَعْبِدْ وقْعَدْ يْنَاقِشْ فِيهُمْ مِالكْتُبْ المُقَدْسَةْ لْمُدِّةْ ثْلَاثَة أَسْبَاتْ. <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />وفَسْرِلْهُمْ ووَرَّاهُمْ الِّي المَسِيحْ كَانْ لَازْمُو يْمُوتْ ويْقُومْ مِنْ بِينْ المُوتَى، وقَالِلْهُمْ: «يَسُوعْ الِّي آنَا تَوَّا قَاعِدْ نْبَشِّرْ فِيكُمْ بِيهْ هُوَّ المَسِيحْ». <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />يَاخِي اقْتَنْعُوا جْمَاعَة مِنْهُمْ ووَلَّاوْ مْعَ بُولِسْ وسِيلَا، ومْعَاهُمْ بَرْشَة يُونَانِيِّينْ مِلِّي يِعْبْدُوا فِي رَبِّي، وبَرْشَة نْسَاء مِنْ أَعْيَانْ البْلَادْ.<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />يَاخِي اليْهُودْ كْلَاتْهُمْ الغِيرَة، وَلَّاوْ لَمُّوا نَاسْ أَشْرَارْ مِنْ وْلَادْ الشَّارِعْ وكَوْنُوا عِصَابَة وعَمْلُوا خُوضَة فِي البْلَادْ، ومْبَعِّدْ هِجْمُوا عْلَى دَارْ يَاسُونْ، يْلَوْجُوا عْلَى بُولِسْ وسِيلَا بَاشْ يْخَرْجُوهُمْ لِلشَّعْبْ. <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />وكِي مَا لْقَاوْهُمْشْ جَابُوا يَاسُونْ وجْمَاعَة مِالإِخْوَة وهَزُّوهُمْ لْحُكَّامْ المْدِينَة، وهُومَا يْصِيحُوا: «النَّاسْ هَاذُمْ هُومَا الِّي قِلْبُوا الدِّنْيَا الكُلْ، وهَاهُمْ جَاوْ لِمْدِينِتْنَا أَحْنَا زَادَا. <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />ويَاسُونْ مْضَيِّفْهُمْ فِي دَارُو. والكُلْهُمْ قَاعْدِينْ يْخَالْفُوا فِي أَوَامِرْ القَيْصِرْ، ويْقُولُوا الِّي فَمَّة مَلِكْ آخِرْ إِسْمُو يَسُوعْ». <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />يَاخِي تْقَلْقُوا النَّاسْ والحُكَّامْ كِي سَمْعُوا الكْلَامْ هَاذَا. <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />ومَا سَيْبُوا يَاسُونْ وبْقِيِّة الإِخْوَة كَانْ مَا خْذَاوْ كَفَالَة.<verse eid="ACT 17:9" /></para>
  <para style="s">المُعَارْضَة فِي بِيرِيَّة</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />وبِالوَقْتْ، دُوبْ مَا طَاحْ اللِّيلْ، بَعْثُوا الإِخْوَة بُولِسْ وسِيلَا لِمْدِينِةْ بِيرِيَّة. وَقْتِلِّي وُصْلُوا، مْشَاوْ لْمَعْبِدْ اليْهُودْ الِّي فِيهَا. <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />ويْهُودْ بِيرِيَّة كَانُوا مِتْجَاوْبِينْ أَكْثِرْ مِنْ يْهُودْ تْسَالُونِيكِي، وقِبْلُوا كِلْمِةْ الرَّبْ بْحَمَاسْ، وكَانُوا يَقْرَاوْ فِي الكْتُبْ المُقَدْسَة كُلْ يُومْ بَاشْ يِتْأَكْدُوا إِنُّو التَّعْلِيمْ الِّي كَانُوا يِسْمْعُوا فِيهْ صْحِيحْ. <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />هَاذَاكَا عْلَاشْ أَمْنُوا بَرْشَة يْهُودْ، وبَرْشَة يُونَانِيِّينْ، مِنْهُمْ نْسَاء مِنْ أَعْيَانْ البْلَادْ ومِنْهُمْ رْجَالْ.<verse eid="ACT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 17:13" />وكِي عَرْفُوا اليْهُودْ الِّي فِي تْسَالُونِيكِي الِّي بُولِسْ يْبَشِّرْ بْكِلْمِةْ اللَّهْ فِي بِيرِيَّة، خَلْطُوا وْرَاهْ، وبْدَاوْ يْهَيْجُوا عْلِيهْ فِي النَّاسْ. <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />يَاخِي بِالوَقْتْ بَعْثُوا الإِخْوَة بُولِسْ لِلبْحَرْ بَاشْ يْسَافِرْ، وبْقَاوْ سِيلَا وتِيمُوثَاوُسْ غَادِي. <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />والمُؤْمْنِينْ الِّي مْشَاوْ مْعَ بُولِسْ وَصْلُوهْ لْأَثِينَا، ورَجْعُوا بَعْدْمَا وَصَّاهُمْ بُولِسْ بَاشْ يَبْعْثُولُو سِيلَا وتِيمُوثَاوُسْ فِي أَقْرِبْ وَقْتْ مُمْكِنْ.<verse eid="ACT 17:15" /></para>
  <para style="s">بُولِسْ يُخْطُبْ فِي النَّاسْ فِي أَثِينَا</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />وَقْتِلِّي بُولِسْ كَانْ يِسْتَنَّى فِيهُمْ فِي أَثِينَا، شَافْ الِّي المْدِينَة مِلْيَانَة بِالأَصْنَامْ. يَاخِي تْقَلَّقْ بَرْشَة. <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />وبْدَا يْنَاقِشْ فِي النَّاسْ الِّي يِعْبْدُوا رَبِّي فِي المَعْبِدْ مِاليْهُودْ وغِيرْهُمْ، ويْنَاقِشْ زَادَا فِي النَّاسْ الِّي يُعْرْضُوهْ كُلْ يُومْ فِي السُّوقْ. <verse eid="ACT 17:17" /><verse number="18" style="v" sid="ACT 17:18" />وصَارْ نِقَاشْ مْعَ الفَلَاسْفَة الأَبِيقُورِيِّينْ والرِّوَاقِيِّينْ، يَاخِي جْمَاعَة مِنْهُمْ قَالُوا: «آشْ يْحِبْ يْقُولْ هَلِّي يَحْكِي بَرْشَة؟». أُخْرِينْ قَالُوا: «ظَاهِرْ إِنُّو يَحْكِي عْلَى آلْهَة غْرِيبَة»، عْلَى خَاطِرْ بُولِسْ كَانْ يْبَشِّرْ بْيَسُوعْ والقْيَامَة مِالمُوتْ. <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />يَاخِي هَزُّوهْ لْمَجْلِسْ المْدِينَة الِّي يِتْسَمَّى الأَرْيُوبَاغُوسْ وقَالُولُو: «نْحِبُّوا نَعْرْفُوا التَّعْلِيمْ الجْدِيدْ الِّي تَحْكِي عْلِيهْ. <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />أَحْنَا قَاعْدِينْ نِسْمْعُوا فِي كْلَامْ غْرِيبْ، ونْحِبُّوا نَعْرْفُوا آشْ مَعْنَاهْ». <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />وكَانُوا أَهْلْ أَثِينَا والبْرَايْنِيَّة السَّاكْنِينْ فِيهَا يْعَدِّيوْ مُعْظِمْ وَقْتْهُمْ يِتْنَاقْشُوا فِي الأَفْكَارْ الجْدِيدَة.<verse eid="ACT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />ووْقِفْ بُولِسْ فِي وُسْطْ المَجْلِسْ وقَالْ: «يَا أَهْلْ أَثِينَا، ظَاهِرْينْ الِّي إِنْتُومَا مِدَّيْنِينْ بَرْشَة، وفِي كُلْ شَيْ. <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />عْلَى خَاطِرْ وَقْتِلِّي كُنْتْ نْدُورْ فِي مْدِينِتْكُمْ ونُخْزُرْ لِلْمْعَابِدْ مْتَاعْكُمْ، لْقِيتْ مَذْبَحْ مَكْتُوبْ عْلِيهْ: "لِلإِلَاهْ المَجْهُولْ". وآنَا رَانِي قَاعِدْ نْبَشِّرْ فِيكُمْ بِالإِلَاهْ المَجْهُولْ هَاذَا الِّي تِعْبْدُوا فِيهْ مِنْ غِيرْ مَا تَعْرْفُوهْ. <verse eid="ACT 17:23" /><verse number="24" style="v" sid="ACT 17:24" />اللَّهْ الِّي خْلَقْ العَالِمْ وكُلْ مَا فِيهْ، رَبْ السْمَاء والأَرْضْ، الِّي مَا يُسْكُنْشْ فِي مَعَابِدْ بْنَاوْهَا البَشَرْ، <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />مَا يِسْتْحَقِّشْ لِلنَّاسْ بَاشْ تِخْدْمُو، عْلَى خَاطْرُو هُوَّ الِّي يَعْطِيهُمْ الكُلْ الحَيَاةْ والنْفَسْ ويَعْطِيهُمْ كُلْ شَيْ. <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />خْلَقْ الشُّعُوبْ الكُلْ مِنْ إِنْسَانْ وَاحِدْ، بَاشْ يُسْكْنُوا فِي الأَرْضْ الكُلْ، وحَدِدِّلْهُمْ مِنْ قَبْلْ مُدِّةْ وُجُودْهُمْ والبْلَايِصْ الِّي بِشْ يْعِيشُوا فِيهَا. <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />عْلَى خَاطْرُو يْحِبْهُمْ يْلَوْجُوا عْلِيهْ، فَمَّاشْ مَا يِتَهْدَاوْ ويَلْقَاوَهْ، رَغْمِلِّي هُوَّ مُشْ بْعِيدْ عْلَى كُلْ وَاحِدْ فِينَا. <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />رَانَا نَحْيَاوْ ونِتْحَرْكُوا ونِتْوِجْدُوا بِيهْ هُوَّ. وكِيمَا قَالْ وَاحِدْ مِنْ شُعَرَاءْكُمْ:</para>
  <para style="b" vid="ACT 17:28" />
  <para style="q1" vid="ACT 17:28">"أَحْنَا زَادَا ذُرِّيتُو".<verse eid="ACT 17:28" /></para>
  <para style="b" />
  <para style="p">
    <verse number="29" style="v" sid="ACT 17:29" />«ومَادَامْنَا ذُرِّيِّةْ اللَّهْ، مَالَا مَا يِلْزِمْنَاشْ نْفَكْرُوا الِّي الإِلَاهْ هُوَّ صَنْبَة مِالذْهَبْ وَلَّا مِالفِضَّة وَلَّا مِالحْجَرْ يَصْنَعْهَا الإِنْسَانْ كِيفْ مَا يْحِبْ. <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />وإِذَا كَانْ اللَّهْ عَدَّى أَيَّامَاتْ الجَهْلْ الِّي فَاتِتْ، رَاهُو اليُومْ يُأْمُرْ النَّاسْ الكُلْ فِي كُلْ بْلَاصَة بَاشْ يْتُوبُوا. <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />عْلَى خَاطْرُو حَدِّدْ نْهَارْ بَاشْ يْحَاسِبْ فِيهْ العَالِمْ بِالعَدْلْ عْلَى يِدْ رَاجِلْ إِخْتَارُو، وبَيِّنْ لِلنَّاسْ الِّي هُوَّ إِخْتَارُو كِي قَوْمُو مِالمُوتْ».<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />كِي سَمْعُوهْ يَحْكِي عَالقْيَامِة مِالمُوتْ، فَمَّة شْكُونْ مِنْهُمْ بْدَاوْ يِتْمَسْخْرُوا. آمَا فَمَّة نَاسْ أُخْرِينْ قَالُولُو: «مَذَابِينَا كَانْ تْزِيدْ تَحْكِيلْنَا عَالمَوْضُوعْ هَاذَا مَرَّة أُخْرَى». <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />وَلَّى خْرَجْ بُولِسْ مِنْ بَحْذَاهُمْ. <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />آمَا فَمَّة جْمَاعَة مِنْهُمْ وَلَّاوْ مْعَاهْ وأَمْنُوا، مِنْهُمْ دْيُونِيسْيُوسْ الِّي كَانْ عُضُوْ فِي مَجْلِسْ المْدِينَة، ومْرَا إِسْمْهَا دَامَارِيسْ، وبَرْشَة نَاسْ أُخْرِينْ.<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s">بُولِسْ يُقْعُدْ يْعَلِّمْ فِي كُورِنْثُوسْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />وبَعْدْ هَاذَا، سَافِرْ بُولِسْ مِنْ أَثِينَا لِمْدِينِةْ كُورِنْثُوسْ. <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />وقَابِلْ يْهُودِي إِسْمُو أَكِيلَا، مَوْلُودْ فِي مَنْطَقْةْ بُنْطُسْ، مَزَّالْ كِي جَاء مِنْ إِيطَالْيَا مْعَ مَرْتُو بْرِيسْكِلَّا، عْلَى خَاطِرْ القَيْصِرْ كْلُودْيُوسْ طَرِّدْ اليْهُودْ الكُلْ مِنْ رُومَا. يَاخِي مْشَى بُولِسْ يْشُوفْ فِيهُمْ. <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />وعْلَى خَاطِرْهُمْ كَانُوا يَصْنْعُوا فِي الخْيِمْ كِيفُو، قْعَدْ عَنْدْهُمْ وخْدِمْ مْعَاهُمْ. <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />وكَانْ كُلْ نْهَارْ سِبْتْ يِتْنَاقِشْ مْعَ النَّاسْ الِّي يْجِيوْ لِلمَعْبِدْ، ويْحَاوِلْ يَقْنَعْ اليْهُودْ ولِّي مُشْ يْهُودْ .<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />ووَقْتِلِّي وُصْلُوا سِيلَا وتِيمُوثَاوُسْ مِنْ مَقْدُونِيَّة، خَصِّصْ بُولِسْ وَقْتُو الكُلْ لِلتَّبْشِيرْ، وكَانْ يِشْهِدْ لِلْيْهُودْ الِّي يَسُوعْ هُوَّ المَسِيحْ. <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />آمَا هُومَا عَارْضُوهْ وبْدَاوْا يْسِبُّوا فِيهْ، يَاخِي نْفَضْ حْوَايْجُو وقَالِلْهُمْ: «ذَنْبْكُمْ فِي رَقْبِتْكُمْ، آنَا بَرِيءْ مِنْكُمْ. ومِنْ تَوَّا بِشْ نِمْشِي لِلِّي مَاهُمْشْ يْهُودْ». <verse eid="ACT 18:6" /><verse number="7" style="v" sid="ACT 18:7" />ومْشَى مِنْ غَادِي لْدَارْ رَاجِلْ مُشْ يْهُودِي يِعْبِدْ فِي اللَّهْ، إِسْمُو تِيطُسْ يُوسْتُسْ. دَارُو كَانِتْ لَاصْقَة المَعْبِدْ. <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />وأَمِّنْ كْرِيسْبُسْ رَئِيسْ المَعْبِدْ بِالرَّبْ هُوَّ وعَايِلْتُو الكُلْ، وبَرْشَة مِنْ أَهْلْ كُورِنْثُوسْ الِّي سَمْعُوا تَبْشِيرْ بُولِسْ أَمْنُوا وتْعَمْدُوا.<verse eid="ACT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />وفِي لِيلَة مِاليَالِي، قَالْ الرَّبْ لْبُولِسْ فِي رُؤْيَا: «مَا تْخَافِشْ! تْكَلِّمْ ومَا تُسْكُتْشْ، <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />آنَا مْعَاكْ وحَتَّى حَدْ مَا يْنَجِّمْ يْضُرِّكْ، عْلَى خَاطِرْ عَنْدِي بَرْشَة نَاسْ فِي المْدِينَة هَاذِي هُومَا شَعْبِي». <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />وقْعَدْ بُولِسْ فِي كُورِنْثُوسْ عَامْ وسِتَّة شْهُرْ يْعَلِّمْ فِي النَّاسْ كِلْمِةْ اللَّهْ.<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />وَقْتِلِّي كَانْ غَالْيُونْ حَاكِمْ عْلَى مَنْطَقْةْ أَخَائِيَة، لَمُّوا اليْهُودْ بْعَضْهُمْ وهِجْمُوا عْلَى بُولِسْ وهَزُّوهْ لِلمَحْكْمَة <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />وقَالُوا: «الرَّاجِلْ هَاذَا يَقْنَعْ فِي النَّاسْ بَاشْ يِعْبْدُوا اللَّهْ بْطَرِيقَة تْخَالِفْ شَرِيعِتْنَا». <verse eid="ACT 18:13" /><verse number="14" style="v" sid="ACT 18:14" />وَقْتِلِّي جَاء بُولِسْ بَاشْ يِتْكَلِّمْ، قَالْ غَالْيُونْ لِلْيْهُودْ: «يَا يْهُودْ، كَانْ جَاتْ القَضِيَّة هَاذِي فِيهَا جْرِيمَة وَلَّا ذَنْبْ، رَانِي بِالحَقْ سْمَعْتْ شْكَايِتْكُمْ. <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />آمَا مَادَامْهَا قَضِيِّةْ كِلْمَاتْ وأَسَامِي وحَاجَاتْ تْخُصْ شَرِيعِتْكُمْ، مَا عْلِيكُمْ كَانْ تْحِلُّوهَا مَا بِينَاتْكُمْ. آنَا مَا نْحِبِّشْ نُحْكُمْ فِي القَضَايَا هَاذُمْ». <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />وطَرِّدْهُمْ مِالمَحْكْمَة. <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />يَاخِي هَزُّوا سُوسْتَانِيسْ رَئِيسْ المَعْبِدْ، وضَرْبُوهْ قُدَّامْ المَحْكْمَة، وغَالْيُونْ مَا عَبَّرْهُمْشْ.<verse eid="ACT 18:17" /></para>
  <para style="s">بْرِيسْكِيلَا وأَكِيلَا وأَبُلُّوسْ</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />وقْعَدْ بُولِسْ فِي كُورِنْثُوسْ مُدَّة طْوِيلَة. ومِنْ بَعْدْهَا وَدَّعْ الإِخْوَة وسَافِرْ لْسُورْيَة عْلَى طْرِيقْ البْحَرْ ومْعَاهْ بْرِيسْكِيلَا وأَكِيلَا، بَعْدْمَا حَجِّمْ شَعْرُو فِي مْدِينِةْ كَنْخَرِيَّة عْلَى خَاطْرُو كَانْ وَاعِدْ وَعْدَة لْرَبِّي. <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />وَقْتِلِّي وُصْلُوا لْأَفَسُسْ خَلَّاهُمْ بُولِسْ غَادِي، ودْخَلْ لِلمَعْبِدْ يْنَاقِشْ فِي اليْهُودْ. <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />يَاخِي طَلْبُوا مِنُّو بَاشْ يُقْعُدْ مْعَاهُمْ مُدَّة أَطْوِلْ، آمَا هُوَّ مَا قْبِلْشْ. <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />ووَقْتِلِّي وَدَّعْهُمْ قَالِلْهُمْ: « تَوَّا نَرْجْعِلْكُمْ كَانْ حَبْ رَبِّي». ومْبَعِّدْ سَافِرْ مِنْ مْدِينِةْ أَفَسُسْ عْلَى طْرِيقْ البْحَرْ.<verse eid="ACT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 18:22" />وْصُلْ لْبُرْطْ قَيْصَرِيَّة وطْلَعْ سَلِّمْ عَالكْنِيسَة فِي أُورْشَلِيمْ، مْبَعِّدْ مْشَى لْأَنْطَاكْيَة. <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />وبَعْدْمَا عَدَّى فِيهَا مُدَّة، سَافِرْ لْمَنَاطِقْ غَلَاطْيَة وفَرِيجِيَّة، ودَارْهُمْ بْلَاصَة بْلَاصَة وهُوَّ يْقَوِّي ويْشَجَّعْ فِي التْلَامْذَة الكُلْ.<verse eid="ACT 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />وجَاء لْأَفَسُسْ رَاجِلْ يْهُودِي إِسْمُو أَبُلُّوسْ، أَصْلُو مِنْ مْدِينِةْ الإِسْكَنْدَرِيَّة، يَعْرِفْ يِتْكَلَّمْ، ويَعْرِفْ الكْتُبْ المُقَدْسَةْ بِالڨْدَا. <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />وكَانْ مِتْمَكِّنْ مِنْ تَعْلِيمْ المَذْهَبْ الِّي يْسَمِّيوِهْ طْرِيقْ الرَّبْ، وكَانْ يِتْكَلِّمْ بْحَمَاسْ كْبِيرْ، وِيْعَلِّمْ فِي تَعْلِيمْ صْحِيحْ عْلَى يَسُوعْ، آمَا مَا كَانْ يَعْرِفْ كَانْ مَعْمُودِيَّةْ يُوحَنَّا. <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />وبْدَا يِتْكَلِّمْ بْشَجَاعَة وثِيقَةْ فِي المَعْبِدْ. آمَا كِي سَمْعُوهْ أَكِيلَا وبْرِيسْكِلَّا، هَزُّوهْ لْدَارْهُمْ، وزَادُوا فَسْرُولُو ووَضْحُولُو تَعْلِيمْ اللَّهْ أَكْثِرْ. <verse eid="ACT 18:26" /><verse number="27" style="v" sid="ACT 18:27" />وقَرِّرْ أَبُلُّوسْ يْسَافِرْ لْأَخَائِيَة، يَاخِي شَجْعُوهْ الإِخْوَة وكِتْبُوا لِلتْلَامْذَة الِّي غَادِي بَاشْ يِسْتَقْبْلُوهْ بِالڨْدَا. ووَقْتِلِّي وْصُلْ، عَاوِنْ بَرْشَة الِّي وَلَّاوْ مُؤْمْنِينْ عْلَى خَاطِرْ نِعْمِةْ اللَّهْ. <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />عْلَى خَاطْرُو كَانْ يْسَكِّتْ اليْهُودْ بْقُوِّةْ الحُجَجْ مْتَاعُو قُدَّامْ النَّاسْ الكُلْ ويْبَيْنِلْهُمْ مِالكْتُبْ المُقَدْسَةْ الِّي يَسُوعْ هُوَّ المَسِيحْ.<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s">بُولِسْ يْبَشِّرْ تْلَامِذْةْ يُوحَنَّا فِي أَفَسُسْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />وَقْتِلِّي أَبُلُّوسْ كَانْ فِي كُورِنْثُوسْ، سَافِرْ بُولِسْ عْلَى طْرِيقْ البَرْ فِي المَنَاطِقْ العَالْيَة حَتَّى وْصُلْ لْأَفَسُسْ. وغَادِي لْقَى شْوَيَّة تْلَامْذَة. <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />سْإِلْهُمْ: «يَاخِي خْذِيتُوا الرُّوحْ القُدُسْ وَقْتِلِّي أَمَّنْتُوا؟». جَاوْبُوهْ: «لَا! ولَا حَتَّى سْمَعْنَا إِنُّو الرُّوحْ القُدُسْ مَوْجُودْ». <verse eid="ACT 19:2" /><verse number="3" style="v" sid="ACT 19:3" />يَاخِي سْإِلْهُمْ: «مَالَا بَانَا مَعْمُودِيَّة تْعَمَّدْتُوا؟». جَاوْبُوا: «بْمَعْمُودِيِّةْ يُوحَنَّا». <verse eid="ACT 19:3" /><verse number="4" style="v" sid="ACT 19:4" />قَالْ بُولِسْ: «مَعْمُودِيِّةْ يُوحَنَّا كَانِتْ لِلتُّوبَة، وهُوَّ كَانْ يِدْعِي الشَّعْبْ بَاشْ يَمْنُوا بِلِّي يْجِي بَعْدُو، يَعْنِي بْيَسُوعْ». <verse eid="ACT 19:4" /><verse number="5" style="v" sid="ACT 19:5" />وكِي سَمْعُوا الكْلَامْ هَاذَا، تْعَمْدُوا بْإِسْمْ الرَّبْ يَسُوعْ. <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />ووَقْتِلِّي حَطْ بُولِسْ عْلِيهُمْ يْدِيهْ، هْبَطْ عْلِيهُمْ الرُّوحْ القُدُسْ، وبْدَاوْ يِتْكَلْمُوا بْلُوغَاتْ أُخْرَى ويِتْنَبْؤُوا. <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />وكَانُوا قْرَابِةْ أَثْنَاشِنْ رَاجِلْ.<verse eid="ACT 19:7" /></para>
  <para style="s">بُولِسْ يْعَلِّمْ فِي مَدْرَسْةْ تِيرَانُّوسْ</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />وقْعَدْ بُولِسْ يِمْشِي لْمَعْبِدْ اليْهُودْ لْمُدِّةْ ثْلَاثَة شْهُرْ، وكَانْ يِتْكَلِّمْ جْهَارْ عْلَى مَمْلِكْةْ اللَّهْ، ويْنَاقِشْ فِي الحَاضْرِينْ ويْحَاوِلْ يَقْنَعْهُمْ. <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />آمَا فَمَّة الِّي عَانْدُوا ومَا حَبُّوشْ يَمْنُوا، وبْدَاوْ يْسِبُّوا فِي المَذْهَبْ الِّي يِتْسَمَّى طْرِيقْ الرَّبْ قُدَّامْ النَّاسْ الكُلْ. يَاخِي خَلَّاهُمْ بُولِسْ وهَزْ التْلَامْذَة وَحَّدْهُمْ، وبْدَا يِتْنَاقِشْ مْعَاهُمْ ويْعَلِّمْ فِيهُمْ كُلْ يُومْ، فِي مَدْرَسْةْ وَاحِدْ إِسْمُو تِيرَانُّوسْ. <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />ودَاوِمْ عْلَى هَاذَا لْمُدِّةْ عَامِينْ، حَتَّى وِصْلِتْ كِلْمِةْ الرَّبْ لِلْيْهُودْ ولِلِّي مُشْ يْهُودْ الكُلْ الِّي يُسْكْنُوا فِي آسِيَّا.<verse eid="ACT 19:10" /></para>
  <para style="s">مُعْجْزَاتْ فِي أَفَسُسْ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />وكَانْ اللَّهْ يَعْمِلْ فِي مُعْجْزَاتْ كْبِيرَة عْلَى يْدِينْ بُولِسْ، <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />حَتَّى وَلَّاوْ النَّاسْ يْهِزُّوا المْنَادِلْ والفْوُطْ الِّي مَسُّوا بْدَنْ بُولِسْ، ويْحُطُّوهُمْ عَالمُرْضَى، والمُرْضَى يَبْرَاوْ وتُخْرُجْ مِنْهُمْ الأَرْوَاحْ الشِّرِّيرَة.<verse eid="ACT 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 19:13" />وكَانْ فَمَّة يْهُودْ رَحَّالَة خِدْمِتْهُمْ تَخْرِيجْ الأَرْوَاحْ الشِّرِّيرَة، حَاوْلُوا يِسْتَعْمْلُوا إِسْمْ الرَّبْ يَسُوعْ بَاشْ يِطَرْدُوهَا. كَانُوا يْقُولُوا لِلأَرْوَاحْ: «بْإِسْمْ يَسُوعْ الِّي يْبَشِّرْ بِيهْ بُولِسْ نُأْمْرِكْ بَاشْ تُخْرُجْ». <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />وكَانْ مْعَ الجْمَاعَة هَاذُمْ سَبْعَة مِنْ وْلَادْ وَاحِدْ مِنْ كْبَارْ الكَهَنَةْ إِسْمُو سَكَاوَا. <verse eid="ACT 19:14" /><verse number="15" style="v" sid="ACT 19:15" />يَاخِي جَاوِبْهُمْ الرُّوحْ الشِّرِّيرْ: «يَسُوعْ نَعْرْفُو وبُولِسْ زَادَا نَعْرْفُو، آمَا إِنْتُومَا شْكُونْكُمْ؟». <verse eid="ACT 19:15" /><verse number="16" style="v" sid="ACT 19:16" />وهْجِمْ عْلِيهُمْ الرَّاجِلْ الِّي فِيهْ الرُّوحْ الشِّرِّيرْ وتْمَكِّنْ مِنْهُمْ وغْلِبْهُمْ، يَاخِي هَرْبُوا مِالدَّارْ عِرْيَانِينْ ومَجْرُوحِينْ.<verse eid="ACT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 19:17" />اليْهُودْ ولِّي مُشْ يْهُودْ السَّاكْنِينْ فِي أَفَسُسْ الكُلْ سَمْعُوا بِلِّي صَارْ، وخَافُوا بَرْشَة، وهَكَّا تْمَجِّدْ إِسْمْ الرَّبْ يَسُوعْ. <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />وجَاوْ بَرْشَة مِلِّي أَمْنُوا، واعْتَرْفُوا بِالأَعْمَالْ الشِّرِّيرَة الِّي عَمْلُوهَا. <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />وبَرْشَة مِلِّي كَانُوا يِسِحْرُوا لَمُّوا كْتُبِّتْهُمْ وهَزُّوا حَرْقُوهَا قُدَّامْ النَّاسْ الكُلْ. وكِي حِسْبُوا سُومْهَا لْقَاوْهَا تَسْوَى 50 000 قَطْعَة مِالفِضَّة. <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />وهَكَّا كَانِتْ كِلْمِةْ الرَّبْ تِتِنْشَرْ وتَأْثِيرْهَا يَقْوَى.<verse eid="ACT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />وبَعْدْ الحَاجَاتْ الِّي صَارِتْ هَاذِي الكُلْ، قَرِّرْ بُولِسْ بَاشْ يْسَافِرْ لْأُورْشَلِيمْ ويِتْعَدَّى عْلَى مَقْدُونِيَّة وأَخَائِيَة، وقَالْ: «بَعْدْمَا نِمْشِي غَادِي، لَازِمْنِي نْزُورْ رُومَا زَادَا». <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />وبْعَثْ لْمَقْدُونِيَّة زُوزْ مِلِّي يْعَاوْنُوا فِيهْ، وهُومَا تِيمُوثَاوُسْ وأَرَسْطُوسْ، آمَا هُوَّ زَادْ قْعَدْ مُدَّة فِي آسِيَّا.<verse eid="ACT 19:22" /></para>
  <para style="s">خُوضَة فِي أَفَسُسْ</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />وفِي المُدَّة هَاذِيكَا وُقْعِتْ مُشْكْلَة كْبِيرَة فِي أَفَسُسْ بِسْبَبْ الطْرِيقْ هَاذَا. <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />عْلَى خَاطِرْ فَمَّة صَايْغِي إِسْمُو دِيمِتْرِيُوسْ كَانْ يَصْنَعْ فِي مْعَابِدْ صْغِيرَة مِالفِضَّة كِيمَا مَعْبِدْ الإِلَاهَة أَرْطَامِيسْ، وكَانُوا الصُّنَّاعْ يِرْبْحُوا فِي بَرْشَة فْلُوسْ مِالخِدْمَة هَاذِي. <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />يَاخِي لَمْ صُنَّاعُو وأَصْحَابْ صَنْعْتُو وقَالِلْهُمْ: «يَا رْجَالْ، إِنْتُومَا تَعْرْفُوا الِّي الخِيرْ الِّي عَايْشِينْ فِيهْ، وَاقِفْ عْلَى صَنْعِتْنَا هَاذِي. <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />وإِنْتُومَا شُفْتُوا وسْمَعْتُوا الِّي بُولِسْ هَاذَا أَثِّرْ عْلَى بَرْشَة نَاسْ، مُشْ فِي أَفَسُسْ بَرْكْ، آمَا تَقْرِيبْ فِي آسِيَّا الكُلْ، وقْنَعْهُمْ الِّي الآلْهَة الِّي تِتْصْنَعْ بِاليِدْ مَاهِيشْ آلْهَة. <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />وهَاذَا مُشْ بِشْ يْنَقِّصْ مِنْ قِيمِةْ صَنْعِتْنَا أَكَهَوْ، آمَا بِشْ يْطَيِّحْ قِيمِةْ مَعْبِدْ الإِلَاهَة العْظِيمَة أَرْطَامِيسْ، ويْنَقْصِلْهَا مِنْ هِيبِتْهَا، وهِيَّ الِّي يِعْبْدُوهَا النَّاسْ فِي آسِيَّا الكُلْ وفِي بْقِيِّةْ العَالِمْ».<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />وكِي سَمْعُوا الصُّنَّاعْ الكْلَامْ هَاذَا، تْغَشْشُوا بَرْشَة وبْدَاوْ يْصِيحُوا: «عْظِيمَة أَرْطَامِيسْ، آلِهِةْ أَفَسُسْ!». <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />وصَارِتْ خُوضَة كْبِيرَة فِي المْدِينَة الكُلْ، وهِجْمُوا بَرْشَة نَاسْ عْلَى غَايُوسْ وأَرِسْتَرْخُسْ الِّي مِنْ مَقْدُونِيَّة ولِّي كَانُوا مْسَافْرِينْ مْعَ بُولِسْ، وهَزُّوهُمْ بِالقُوَّة لْمَسْرَحْ المْدِينَة. <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />وحَبْ بُولِسْ يْوَاجِهْ النَّاسْ، آمَا التْلَامْذَة مَا خَلَّاوْهِشْ. <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />وحَتَّى صْحَابُو مِالمَسْؤُولِينْ الِّي فِي آسِيَّا بَعْثُولُو، وتْشَحْتُوهْ بَاشْ مَا يْخَاطِرْشْ بْرُوحُو ويِمْشِي لِلمَسْرَحْ. <verse eid="ACT 19:31" /><verse number="32" style="v" sid="ACT 19:32" />وكَانُوا النَّاسْ دَاخْلِينْ بْعَضْهُمْ، فَمَّة الِّي يْصِيحُوا عْلَى حَاجَة وأُخْرِينْ يْصِيحُوا عْلَى حَاجَة أُخْرَى، وأَغْلَبِيِّتْهُمْ مَا كَانُوشْ يَعْرْفُوا عْلَاشْ هُومَا غَادِي. <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />وكَانْ بِينَاتْهُمْ رَاجِلْ يْهُودِي إِسْمُو إِسْكَنْدَرْ، دَزُّوهْ اليْهُودْ القُدَّامْ وطَلْبُوا مِنُّو بَاشْ يِتْكَلِّمْ، يَاخِي هَزْ يِدُّو بَاشْ النَّاسْ يُسْكْتُوا ويِسْمْعُوا الدِّفَاعْ مْتَاعُو. <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />آمَا كِي عَرْفُوا الِّي هُوَّ يْهُودِي، بْدَاوْ يْصِيحُوا الكُلْ بْصُوتْ وَاحِدْ ولْمُدِّةْ سَاعْتِينْ: «عْظِيمَة أَرْطَامِيسْ، آلِهِةْ أَفَسُسْ!».<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />وفِي الإِخِّرْ، نَجِّمْ كَاتِبْ حَاكِمْ المْدِينَة يْرَيِّضْهُمْ وقَالِلْهُمْ: «يَا أَهْلْ أَفَسُسْ! شْكُونْ مَا يَعْرِفْشْ الِّي أَفَسُسْ هِيَّ المْدِينَة الِّي تُحْرُسْ فِي مَعْبِدْ أَرْطَامِيسْ العْظِيمَة، وفِي تِمْثَالْهَا الِّي هْبَطْ مِالسْمَاء؟ <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />هَاذِي حَاجَة مَعْرُوفَة ومَا فِيهَاشْ كْلَامْ، مَالَا رِيضُوا ومَا تِتْسَرْعُوشْ. <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />إِنْتُومَا جِبْتُوا الزُّوزْ رْجَالْ هَاذُمْ لَهْنَا، رَغْمِلِّي لَا سِرْقُوا المَعْبِدْ ولَا سَبُّوا إِلَاهِتْنَا. <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />وإِذَا كَانْ دِيمِتْرِيُوسْ ولِّي يِخْدْمُوا مْعَاهْ يْحِبُّوا يِشْكِيوْ بْحَدْ، رَاهُو عَنَّا مْحَاكِمْ وقُضَاةْ يْنَجْمُوا يِشْكِيوْلْهُمْ. <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />وإِذَا كَانْ عَنْدْكُمْ شْكَايَة أُخْرَى، لَازِمْنَا نُحْكْمُوا فِيهَا فِي جَلْسَة قَانُونِيَّة. <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />آمَا هَكَّا، مُمْكِنْ يِتْهْمُونَا بِالفِتْنَة بِسْبَبْ الِّي صَارْ اليُومْ. ومَا عَنْدْنَا حَتَّى عُذْرْ نْفَسْرُوا بِيهْ الخُوضَةْ هَاذِي». <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />وبَعْدْمَا قَالْ الكْلَامْ هَاذَا، بْعَثْهُمْ يْرَوْحُوا.<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s">بُولِسْ فِي مَقْدُونْيَا واليُونَانْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />بَعْدْمَا وْفَاتْ الخُوضَة، عَيِّطْ بُولِسْ لِلتْلَامْذَة وشَجِّعْهُمْ، ومْبَعِّدْ وَدَّعْهُمْ وسَافِرْ لْمَقْدُونْيَا. <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />وقْعَدْ يْدُورْ فِيهَا ويْشَجَّعْ بَرْشَة فِي المُؤْمْنِينْ فِي كُلْ بْلَاصَة. ومْبَعِّدْ وْصُلْ لِليُونَانْ، <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />وقْعَدْ فِيهَا ثْلَاثَة شْهُرْ. وَقْتِلِّي كَانْ يْحَضِّرْ فِي رُوحُو بَاشْ يْسَافِرْ لْسُورْيَة عْلَى طْرِيقْ البْحَرْ، كَانُوا اليْهُودْ يْخَطِطُوا بَاشْ يُقْتْلُوهْ، يَاخِي قَرِّرْ بَاشْ يِرْجَعْ عْلَى طْرِيقْ مَقْدُونِيَّة. <verse eid="ACT 20:3" /><verse number="4" style="v" sid="ACT 20:4" />وسَافِرْ مْعَاهْ سُوبَاتْرُسْ وِلْدْ بِرُّسْ مِنْ بِيرِيَّة، وأَرِسْتَرْخُسْ وسَكُونْدُسْ مِنْ تْسَالُونِيكِي، وغَايُوسْ وتِيمُوثَاوُسْ مِنْ مْدِينِةْ دَرْبَة، وتِيخِيكُسْ وتُرُوفِيمُسْ مِنْ آسِيَّا. <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />هَاذُومَا سِبْقُونَا وقَعْدُوا يِسْتَنَّاوْ فِينَا فِي تَرُوَاسْ. <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />آمَا أَحْنَا سَافِرْنَا عْلَى طْرِيقْ البْحَرْ مِنْ فِيلِپِّي بَعْدْ عِيدْ الفْطِيرْ، وبَعْدْ خَمْسَة أَيَّامْ خْلَطْنَا عْلِيهُمْ لْتَرُوَاسْ، وقْعَدْنَا غَادِي سَبْعَة أَيَّامْ.<verse eid="ACT 20:6" /></para>
  <para style="s">بُولِسْ يْقَيِّمْ مِيِّتْ</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />ونْهَارْ الأَحَدْ، كُنَّا مَلْمُومِينْ بَاشْ نِقْسْمُوا الخُبْزْ ونَاكْلُوا. بْدَا بُولِسْ يُوعِظْ فِي الحَاضْرِينْ، وطَوِّلْ فِي الكْلَامْ حَتَّى لْنُصْفْ اللِّيلْ عْلَى خَاطْرُو كَانْ نَاوِي يْسَافِرْ مِنْ غُدْوَة. <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />والبِيتْ الِّي تْلَمِّينَا فِيهَا فِي الطَّاقْ الفُوقَانِي كَانْ فِيهَا بَرْشَة فْنَارَاتْ. <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />وكَانْ فَمَّة وْلِدْ إِسْمُو أَفْتِيخُوسْ قَاعِدْ عْلَى حَرْفْ الشِّبَّاكْ. كِي بُولِسْ طَوِّلْ فِي الكْلَامْ، غِلْبُو النُّومْ يَاخِي طَاحْ مِالطَّاقْ الثَّالِثْ، وهَزُّوهْ مِيِّتْ. <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />يَاخِي هْبَطْ بُولِسْ وطَبِّسْ عْلِيهْ وعَنْقُو وقَالْ: «مَا تْخَافُوشْ! رَاهُو حَيْ». <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />وبَعْدْهَا طْلَعْ لِلطَّاقْ الفُوقَانِي، وقْسِمْ الخُبْزْ وكْلَا، وبْقَى يِتْكَلِّمْ حَتَّى لِلفَجْرْ، ومْبَعِّدْ مْشَى. <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />ورَوْحُوا بِالوْلِدْ حَيْ، وهَاذَا شَجَّعْهُمْ بَرْشَة.<verse eid="ACT 20:12" /></para>
  <para style="s">بُولِسْ يْوَدَّعْ شْيُوخْ أَفَسُسْ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />آمَا أَحْنَا سْبِقْنَا بُولِسْ ورْكِبْنَا فِي سْفِينَةْ لْأَسُّوسْ، واسْتَنِّينَاهْ بَاشْ يْجِي يِرْكِبْ مْعَانَا مِنْ غَادِي، عْلَى خَاطْرُو حَبْ يِمْشِي لْأَسُّوسْ عْلَى سَاقِيهْ. <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />وَقْتِلِّي خْلَطْ عْلِينَا، طَلَّعْنَاهْ مْعَانَا فِي السْفِينَة ومْشِينَا لِمْدِينِةْ مِيتِيلِينِي. <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />ومِنْ غُدْوَة كَمِّلْنَا السْفَرْ ووْصُلْنَا قُدَّامْ جَزِيرِةْ خِيُوسْ. وفِي النْهَارْ الثَّالِثْ تْعَدِّينَا بِجْنَبْ جَزِيرِةْ سَامُوسْ. ووْصُلْنَا لْمْدِينِةْ مِيلِيتُسْ فِي النْهَارْ الرَّابَعْ. <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />وكَانْ بُولِسْ مْقَرِّرْ إِنُّو مَا يَاقِفْشْ فِي أَفَسُسْ بَاشْ مَا يْضَيَّعْشْ الوَقْتْ فِي آسِيَّا، فَمَّاشْ مَا يَخْلِطْ عْلَى عِيدْ يُومْ الخَمْسِينْ فِي أُورْشَلِيمْ.<verse eid="ACT 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />ومِنْ مِيلِيتُسْ، بْعَثْ بُولِسْ يِسْتَدْعَى فِي شْيُوخْ كْنِيسِةْ أَفَسُسْ. <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />وكِي وُصْلُوا قَالِلْهُمْ: «إِنْتُومَا تَعْرْفُوا كِيفَاشْ كُنْتْ نِتْصَرِّفْ مْعَاكُمْ طُولْ الوَقْتْ الِّي عَدِّيتُو بِينَاتْكُمْ، مِالنْهَارْ الأُوِّلْ الِّي عْفَسْتْ فِيهْ آسِيَّا. <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />وكُنْتْ نِخْدِمْ فِي الرَّبْ بْكُلْ تَوَاضُعْ وبَرْشَة دْمُوعْ، ونْقَاسِي فِي المْحَايِنْ فِي جُرِّتْ مُؤَامْرَاتْ اليْهُودْ. <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />ومَا قَصِّرْتِشْ فِي حَتَّى حَاجَة تْفِيدْكُمْ. بِالعَكْسْ، كُنْتْ نْشَجَّعْ فِيكُمْ ونْعَلِّمْ فِيكُمْ قُدَّامْ النَّاسْ ومِنْ دَارْ لْدَارْ. <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />وكُنْتْ نْشَجَّعْ فِي اليْهُودْ ولِّي مُشْ يْهُودْ بَاشْ يْتُوبُوا ويِرْجْعُوا لِلَّهْ، ويَمْنُوا بْرَبْنَا يَسُوعْ. <verse eid="ACT 20:21" /><verse number="22" style="v" sid="ACT 20:22" />وآنَا تَوَّا بِشْ نْطِيعْ الرُّوحْ القُدُسْ ونِمْشِي لْأُورْشَلِيمْ، ومَا نَعْرِفْشْ شْنُوَّة الِّي يِسْتَنَّى فِيَّا غَادِي. <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />آمَا فِي كُلْ مْدِينَة نِمْشِيلْهَا، الرُّوحْ القُدُسْ يْقُلِّي إِنُّو الحَبْسْ والمَشَاكِلْ يِسْتَنَّاوْ فِيَّا غَادِي. <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />آنَا حْيَاتِي مَا تْهِمْنِيشْ، الِّي يْهِمْنِّي هُوَّ إِنِّي نْقُومْ بْمُهِمْتِي ونْكَمِّلْ الخِدْمَة الِّي كَلَّفْنِي بِيهَا الرَّبْ يَسُوعْ، وهِيَّ إِنِّي نْخَبِّرْ بِبْشَارِة نِعْمِةْ اللَّهْ. <verse eid="ACT 20:24" /><verse number="25" style="v" sid="ACT 20:25" />وآنَا نَعْرِفْ إِنْكُمْ إِنْتُومَا الِّي كُنْتْ فِي وِسْطْكُمْ نْبَشِّرْ بْمَمْلِكْةْ اللَّهْ مَا عَادِشْ بِشْ تْشُوفُوا وِجْهِي مَرَّة أُخْرَى. <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />هَاذَاكَا عْلَاشْ نْقُلْكُمْ اليُومْ بِلِّي آنَا بَرِيءْ مِنْ دَمْكُمْ، كَانْ وَاحِدْ مِنْكُمْ مَا يِنْجَاشْ، <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />عْلَى خَاطِرْنِي مَا خَبِّيتْ عْلِيكُمْ شَيْ مِنْ خُطِّةْ اللَّهْ. <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />مَالَا رُدُّوا بَالْكُمْ عْلَى رْوَاحْكُمْ وعْلَى شَعْبْ اللَّهْ الكُلْ الِّي حَطْكُمْ الرُّوحْ القُدُسْ مَسْؤُولِينْ عْلِيهْ، بَاشْ تِتْلْهَاوْ بِكْنِيسِةْ اللَّهْ الِّي شْرَاهَا بْدَمُّو.<verse eid="ACT 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 20:29" />«وآنَا نَعْرِفْ الِّي بَعْدْمَا نِمْشِي بِشْ يُدْخْلُوا بِينَاتْكُمْ نَاسْ كِالذْيُوبَة المِتْوَحْشَة ومُشْ بِشْ يِرْفْقُوا بْشَعْبْ اللَّهْ. <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />ويُخْرْجُوا مِنْكُمْ نَاسْ يْبَدْلُوا الحَقْ فِي تَعْلِيمْهُمْ بَاشْ يْجُرُّوا التْلَامْذَة وْرَاهُمْ. <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />مَالَا رُدُّوا بَالْكُمْ، وتْذَكْرُوا كِيفَاشْ قْعَدْتْ ثْلَاثَة سْنِينْ وآنَا انَّبَّهْ فِي كُلْ وَاحِدْ فِيكُمْ نْهَارْ ولِيلْ وآنَا نِبْكِي بِالدْمُوعْ.<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />«وتَوَّا نْخَلِّيكُمْ فِي وْدِيعِةْ رَبِّي، وكِلْمِةْ نِعْمْتُو القَادْرَة بَاشْ تِبْنِيكُمْ وتُضِمْنِلْكُمْ مِيرَاثْ مْعَ قِدِّيسِينْ اللَّهْ الكُلْ. <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />آنَا عُمْرِي مَا اشْتْهِيتْ لَا فُضَّة ولَا ذْهَبْ ولَا لِبْسَة حَدْ. <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />وإِنْتُومَا تَعْرْفُوا الِّي آنَا خْدِمْتْ بِيدَيَّا هَاذُمْ بَاشْ نُصْرُفْ عْلَى رُوحِي وعَالنَّاسْ الِّي مْعَايَا. <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />ووَرِّيتْكُمْ كِيفَاشْ يِلْزِمْنَا نِخْدْمُوا ونِتْعْبُوا بَاشْ نْعَاوْنُوا المِحْتَاجِينْ. اتْفَكْرُوا كْلَامْ الرَّبْ يَسُوعْ وَقْتِلِّي قَالْ: "الِّي يَعْطِي يِتْبَارِكْ أَكْثِرْ مِلِّي يَاخُذْ"».<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />وبَعْدْمَا قَالْ الكْلَامْ هَاذَا، رْكَعْ مْعَاهُمْ الكُلْ وصَلَّى. <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />واطَّرْشْقُوا الكُلْ بِالبْكَاء، وتِرْمَاوْ عْلَى بُولِسْ يْعَنْقُوا ويْبُوسُوا فِيهْ. <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />وأَكْثِرْ حَاجَة حَزْنِتْهُمْ كِي قَالِلْهُمْ الِّي مَا عَادِشْ بِشْ يْشُوفُوهْ مَرَّة أُخْرَى. ومْبَعِّدْ شَيْعُوهْ لِلسْفِينَة.<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s">بُولِسْ يْسَافِرْ لْأُورْشَلِيمْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />وبَعْدْمَا تْفَارِقْنَا، سَافِرْنَا طُولْ لْجَزِيرِةْ لْكُوسْ عْلَى طْرِيقْ البْحَرْ، ومِنْ غُدْوَة وْصِلْنَا لْجَزِيرِةْ رُودُسْ ومِنْ غَادِي كَمَّلْنَا لْبُرْطْ بَاتَرَا، <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />وِينْ لْقِينَا سْفِينَة مَاشْيَة لْفِينِيقْيَة، رْكِبْنَا فِيهَا وشَقِّينَا البْحَرْ. <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />وكِي رِينَا جَزِيرِةْ قُبْرُصْ، خَلِّينَاهَا عْلَى يْسَارْنَا وكَمِّلْنَا السْفَرْ لْسُورْيَة. وهْبَطْنَا فِي بُرْطْ صُورْ، عْلَى خَاطِرْ السْفِينَة كَانْ لَازِمْ تْهَبِّطْ السِّلْعَة الِّي فِيهَا. <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />ولْقِينَا غَادِي تْلَامْذَة، ضَيْفُونَا عَنْدْهُمْ سَبْعَة أَيَّامْ. وعْلَى خَاطِرْ الرُّوحْ وحَالْهُمْ، كَانُوا يِنْصْحُوا فِي بُولِسْ بَاشْ مَا يِمْشِيشْ لْأُورْشَلِيمْ. <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />كِي وْفَاتْ الزْيَارَة، خْرَجْنَا بَاشْ نْكَمْلُوا سْفَرْنَا. يَاخِي شَيْعُونَا هُومَا ونْسَاهُمْ ووْلَادْهُمْ حَتَّى لِينْ خْرَجْنَا البَرَّة مِالمْدِينَة، وعَالشَّطْ هْبَطْنَا عْلَى رْكَايِبْنَا وصَلِّينَا. <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />وبَعْدْ سَلَّمْنَا عْلَى بْعَضْنَا ورْكِبْنَا فِي السْفِينَة، وهُومَا رَجْعُوا لِدْيَارْهُمْ.<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />وكَمِّلْنَا سَفْرِتْنَا مِنْ صُورْ لِمْدِينِةْ بْتُولِمَايِسْ، وسَلِّمْنَا عَالإِخْوَة الِّي غَادِي وعَدِّينَا مْعَاهُمْ نْهَارْ وَاحِدْ. <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />ومِنْ غُدْوَة وْصِلْنَا لْقَيْصَرِيَّة، ومْشِينَا لْدَارْ فِيلِۑُّسْ المُبَشِّرْ، وهُوَّ وَاحِدْ مِالسَّبْعَة الِّي إِخْتَارُوهُمْ فِي أُورْشَلِيمْ، وقْعَدْنَا عَنْدُو. <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />وكَانْ عَنْدُو أَرْبْعَة بْنَاتْ صْبَايَا يِتْنَبْؤُوا.<verse eid="ACT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 21:10" />وبَعْدْمَا تْعَدَّاتْ أَيَّامَاتْ وأَحْنَا عَنْدُو، جَاء نَبِيْ إِسْمُو أَغَابُوسْ مِنْ مَنْطَقْةْ اليَهُودِيَّة. <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />جَانَا، وخْذَا حْزَامْ بُولِسْ ورْبَطْ رُوحُو بِيهْ مِنْ يْدِيهْ وسَاقِيهْ وقَالْ: «الرُّوحْ القُدُسْ يْقُولْ: "مُولَى الحْزَامْ هَاذَا بِشْ يُرْبْطُوهْ اليْهُودْ كِيمَا هَكَّا فِي أُورْشَلِيمْ، ويْسَلْمُوهْ لِلِّي مَاهُمْشْ يْهُودْ"». <verse eid="ACT 21:11" /><verse number="12" style="v" sid="ACT 21:12" />وكِي سْمَعْنَا الكْلَامْ هَاذَا، وَلِّينَا أَحْنَا والنَّاسْ الِّي كَانُوا غَادِي الكُلْ نِتْشَحْتُوا فِي بُولِسْ بَاشْ مَا يِمْشِيشْ لْأُورْشَلِيمْ. <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />آمَا بُولِسْ قَالِلْنَا: «عْلَاشْ تِبْكِيوْ وتْوَجْعُولِي فِي قَلْبِي؟ آنَا مُسْتْعَدْ مُشْ بَاشْ يُرْبْطُونِي بَرْكَا فِي أُورْشَلِيمْ، آنَا مُسْتْعَدْ حَتَّى بَاشْ نْمُوتْ عْلَى خَاطِرْ إِسْمْ الرَّبْ يَسُوعْ». <verse eid="ACT 21:13" /><verse number="14" style="v" sid="ACT 21:14" />وكِي مَا نَجِّمْنَاشْ نَقْنْعُوهْ، سْكِتْنَا وقُلْنَا: «خَلِّي الِّي يْحِبُّو الرَّبْ، هُوَّ الِّي يْصِيرْ».<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />وبَعْدْ أَيَّامَاتْ، حَضَّرْنَا رْوَاحْنَا ومْشِينَا لْأُورْشَلِيمْ. <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />ومْشَاوْ مْعَانَا تْلَامْذَة مِنْ قَيْصَرِيَّة، وهَزُّونَا لْدَارْ تِلْمِيذْ قْدِيمْ مِنْ قُبْرُصْ إِسْمُو مَنَاسُونْ، بَاشْ نُقْعْدُوا عَنْدُو.<verse eid="ACT 21:16" /></para>
  <para style="s">بُولِسْ يْزُورْ يَعْقُوبْ فِي أُورْشَلِيمْ</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />ووَقْتِلِّي وْصِلْنَا لْأُورْشَلِيمْ، فَرْحُوا بِينَا الإِخْوَة بَرْشَة. <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />ومِنْ غُدْوَة مْشَى مْعَانَا بُولِسْ لْدَارْ يَعْقُوبْ، وكَانُوا شْيُوخْ الكْنِيسَة الكُلْ مَلْمُومِينْ عَنْدُو. <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />سَلِّمْ عْلِيهُمْ بُولِسْ وبْدَا يَحْكِيلْهُمْ بِالتَّفْصِيلْ كِيفَاشْ اللَّهْ اسْتَخْدْمُو بِينْ النَّاسْ الِّي مَاهُمْشْ يْهُودْ.<verse eid="ACT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 21:20" />كِي سَمْعُوا الأَخْبَارْ هَاذِي، مَجْدُوا اللَّهْ وقَالُوا لْبُولِسْ: «هَاكْ تْشُوفْ يَا خُونَا بُولِسْ الِّي فَمَّة آلَافْ مِاليْهُودْ أَمْنُوا بِالرَّبْ، وهُومَا شَادِّينْ فِي الشَّرِيعَة. <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />وسَمْعُوا الِّي إِنْتِ تْعَلِّمْ فِي اليْهُودْ الِّي يُسْكْنُوا فِي الغُرْبَة بَاشْ مَا عَادِشْ يْتَبْعُوا شَرِيعِةْ مُوسَى، وتْوَصِّي فِيهُمْ بَاشْ مَا يْطَهْرُوشْ وْلَادْهُمْ ومَا يْتَبْعُوشْ العَادَاتْ المَوْرُوثَة. <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />مَالَا آشْ نَعْمْلُوا تَوَّا؟ أَكِيدْ بِشْ يِسْمْعُوا الِّي إِنْتِ جِيتْ. <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />مَالَا أَعْمِلْ الِّي بِشْ نْقُولُولِكْ عْلِيهْ: عَنْدْنَا أَرْبْعَة رْجَالْ وَاعْدِينْ وِعْدَة. <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />هِزْهُمْ لِلْهَيْكِلْ وطَبَّقْ إِنْتِ ويَّاهُمْ شَرِيعِةْ التَّطْهِيرْ، وأَعْطِيهُمْ فْلُوسْ بَاشْ يْحَجْمُوا شْعُورَاتْهُمْ، وهَكَّا النَّاسْ الكُلْ يْوَلِّيوْ يَعْرْفُوا إِنُّو الِّي سَمْعُوهْ عْلِيكْ مُشْ صْحِيحْ ولِّي إِنْتِ قَاعِدْ تْطَبَّقْ فِي الشَّرِيعَة كِيفْهُمْ. <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" />آمَا الِّي أَمْنُوا وهُومَا مُشْ يْهُودْ، آهَاوْكَا بْعَثْنَالْهُمْ ووَصِّينَاهُمْ بَاشْ مَا يَاكْلُوشْ مِالذْبَايَحْ المَذْبُوحَة لِلأَصْنَامْ، الدَّمْ، لْحَمْ الحَيَوَانَاتْ المَخْنُوقَة، ويِبْعْدُوا عَالزْنَى». <verse eid="ACT 21:25" /><verse number="26" style="v" sid="ACT 21:26" />ومِنْ غُدْوَة هَزْ بُولِسْ الأَرْبْعَة رْجَالْ وعَمْلُوا الحَاجَاتْ اللَّازْمَة لِلتَّطْهِيرْ، ودْخَلْ لِلْهَيْكِلْ بَاشْ يْقَيِّدْ وَقْتَاشْ يُوفَى التَّطْهِيرْ، ويْقَدَّمْ كُلْ وَاحِدْ فِيهُمْ القُرْبَانْ.<verse eid="ACT 21:26" /></para>
  <para style="s">بُولِسْ يِتْشَدْ</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />وكِي قْرِيبْ تُوفَى السَّبْعَة أَيَّامْ، جْمَاعَة مِنْ يْهُودْ آسِيَّا شَافُوا بُولِسْ فِي الهَيْكِلْ. يَاخِي هَيْجُوا عْلِيهْ النَّاسْ وشَدُّوهْ <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />وهُومَا يْصِيحُوا: «إِجْرِيوْلْنَا يَا بَنِي إِسْرَائِيلْ، هَاذَا هُوَّ الرَّاجِلْ الِّي يْعَلِّمْ فِي النَّاسْ فِي كُلْ بُقْعَة فِي تَعْلِيمْ ضِدْ شَعْبْنَا وشَرِيعِتْنَا وضِدْ البْلَاصَة هَاذِي زَادَا، حَتَّى إِنُّو دَخِّلْ الِّي مَاهُمْشْ يْهُودْ لِلْهَيْكِلْ ونَجِّسْ البْلَاصَة المُقَدْسَة هَاذِي». <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" />قَالُوا هَاذَا عْلَى خَاطِرْهُمْ شَافُوا تُرُوفِيمُسْ الِّي مِنْ أَفَسُسْ مْعَ بُولِسْ فِي المْدِينَة، يَاخِي مْشَى فِي بَالْهُمْ الِّي هُوَّ دَخْلُو مْعَاهْ لِلْهَيْكِلْ.<verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />وَقْتْهَا هَاجِتْ المْدِينَة الكُلْ، وبْدَاوْ النَّاسْ يِجْرِيوْ مِنْ كُلْ بْلَاصَةْ، وهِجْمُوا عْلَى بُولِسْ وكَرْكْرُوهْ لْبَرَّة مِالهَيْكِلْ، وتْسَكْرِتْ بِيبَانْ الهَيْكِلْ بِالوَقْتْ. <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />وهُومَا شَادِّينُو بَاشْ يُقْتْلُوهْ، وْصُلْ الخْبَرْ لْقَايِدْ العَسْكِرْ الرُّومَانِي بِلِّي أُورْشَلِيمْ الكُلْهَا خَايْضَة. <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />بِالوَقْتْ هَزْ مْعَاهْ عَسْكِرْ وضُبَّاطْ ومْشَالْهُمْ يِجْرِي. كِي شَافُوهُمْ اليْهُودْ جَايِينْ، وَقْفُوا الضَّرْبْ وسَيْبُوا بُولِسْ . <verse eid="ACT 21:32" /><verse number="33" style="v" sid="ACT 21:33" />وقْرُبْ القَايِدْ وشَدْ بُولِسْ، وأْمَرْ بَاشْ يُرْبْطُوهْ بْزُوزْ سْلَاسِلْ، وبْدَا يِسْإِلْ: «شْكُونُو هَاذَا، وشَعْمَلْ؟». <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />يَاخِي بْدَاوْ جْمَاعَة مِنْهُمْ يْعَيْطُوا ويْقُولُوا فِي شَيْ، وجْمَاعَة يْقُولُوا فِي شَيْ آخِرْ. وكِي مَا نَجِّمْشْ يَعْرِفْ شْنُوَّة الِّي صَارْ بِالضَّبْطْ بِسْبَبْ الخُوضَةْ، أْمَرْ بَاشْ يْهِزُّوا بُولِسْ لِلثَّكْنَةْ. <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />وَقْتِلِّي وُصْلُوا بِيهْ لِلدْرُوجْ، تْلَزُّوا العَسْكِرْ بَاشْ يْهِزُّوهْ مْحَمِّلْ ويْمَنْعُوهْ مِنْ عُنْفْ النَّاسْ. <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />عْلَى خَاطِرْهُمْ كَانُوا يْتَبْعُوا فِيهْ وهُومَا يْعَيْطُوا: «أُقْتْلُوهْ!».<verse eid="ACT 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />وكِي قْرِيبْ يُدْخُلْ بُولِسْ لِلثَّكْنَةْ قَالْ لِلقَايِدْ بِاللُّوغَة اليُونَانِيَّة: «انَّجِّمْ نْقُلِّكْ حَاجَة؟». قَالْ القَايِدْ: «تِتْكَلِّمْ بِاليُونَانِيَّة؟ <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />مُشْ إِنْتِ المَصْرِي الِّي عْمَلْ ثَوْرَة فِي المْدِينَة المُدَّة الِّي فَاتِتْ، وخَرِّجْ مْعَاهْ 4 000 قَتَّالِةْ أَرْوَاحْ لِلصَّحْرَاء، وحَطْ رُوحُو قَايِدْ عْلِيهُمْ؟». <verse eid="ACT 21:38" /><verse number="39" style="v" sid="ACT 21:39" />يَاخِي بُولِسْ جَاوْبُو: «آنَا يْهُودِي مِنْ طَرْسُوسْ المْدِينَة المَشْهُورَة الِّي فِي كِيلِيكِيَّة. مِنْ فَضْلِكْ، خَلِّينِي نْكَلِّمْ الشَّعْبْ». <verse eid="ACT 21:39" /><verse number="40" style="v" sid="ACT 21:40" />يَاخِي القَايِدْ خَلَّاهْ. ووْقِفْ بُولِسْ فُوقْ الدْرُوجْ وشَاوِرْ بِيِدُّو لِلشَّعْبْ. وَقْتِلِّي سِكْتُوا، بْدَا يْكَلِّمْ فِيهُمْ بِاللُّوغَة العِبْرِيَّة وقَالْ:<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="s">بُولِسْ يُخْطُبْ فِي الشَّعْبْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />«يَا خْوَاتِي ويَا شْيُوخْنَا، إِسْمْعُونِي نْدَافِعْ عْلَى رُوحِي». <verse eid="ACT 22:1" /><verse number="2" style="v" sid="ACT 22:2" />وكِي سَمْعُوهْ يْكَلِّمْ فِيهُمْ بِاللُّوغَة العِبْرِيَّة، سِكْتُوا جِمْلَا. يَاخِي قَالْ: <verse eid="ACT 22:2" /><verse number="3" style="v" sid="ACT 22:3" />«آنَا يْهُودِي تُولِدْتْ فِي طَرْسُوسْ الِّي فِي كِيلِيكِيَّة، آمَا تْرَبِّيتْ هُونِي فِي أُورْشَلِيمْ وكُنْتْ تِلْمِيذْ عَنْدْ غَمَالَائِيلْ وتْعَلِّمْتْ شَرِيعِةْ جْدُودْنَا عْلَى قَاعْدَة صْحِيحَة. وكُنْتْ مِتْحَمِّسْ لْخِدْمِةْ اللَّهْ، كِيفْ مَا إِنْتُومَا اليُومْ. <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" />واضْطَهِدْتْ النَّاسْ الِّي يْتَبْعُوا فِي الطْرِيقْ هَاذَا لْحَدْ المُوتْ، وكُنْتْ نْشِدْ فِيهُمْ رْجَالْ ونْسَاء، ونَرْمِي فِيهُمْ فِي الحَبْسْ. <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />والكَاهِنْ الكْبِيرْ والشْيُوخْ الكُلْ شَاهْدِينْ عْلَى كْلَامِي. آنَا هَزِّيتْ مِنْ عَنْدْهُمْ جْوَابَاتْ لِخْوَاتْهُمْ فِي دِمَشْقْ بَاشْ يْعَاوْنُونِي نْشِدْ النَّاسْ الِّي غَادِي، ونْرَجَّعْهُمْ مْسَلْسْلِينْ لْأُورْشَلِيمْ بَاشْ يِتْعَاقْبُوا.<verse eid="ACT 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />«وفِي الظُّهْرْ، وَقْتِلِّي قْرِيبْ نُوصِلْ لْدِمَشْقْ، ضْوَى عْلِيَّا نُورْ عْظِيمْ مِالسْمَاء. <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />يَاخِي طُحْتْ عَالقَاعَةْ، وسْمَعْتْ صُوتْ يْقُلِّي: "شَاوُلْ! شَاوُلْ! عْلَاشْ تِضْطَهِدْ فِيَّا؟". <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />جَاوِبْتْ: "شْكُونْ إِنْتِ يَا رَبْ؟". قَالْ: "آنَا يَسُوعْ النَّاصْرِي الِّي إِنْتِ تِضْطَهِدْ فِيهْ". <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />ولِّي كَانُوا مْعَايَا شَافُوا النُّورْ، آمَا مَا سَمْعُوشْ صُوتْ الِّي يْكَلِّمْ فِيَّا. <verse eid="ACT 22:9" /><verse number="10" style="v" sid="ACT 22:10" />يَاخِي قُلْتْ: "آشْ نَعْمِلْ يَا رَبْ؟". جَاوِبْنِي الرَّبْ: "قُومْ وإِمْشِي لْدِمَشْقْ، وغَادِي يْقُولُولِكْ آشْ يِلْزْمِكْ تَعْمِلْ".<verse eid="ACT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 22:11" />«ووَصْلُونِي الِّي مْعَايَا لْدِمَشْقْ وهُومَا شَادِّينِي مِنْ يْدَيَّا، عْلَى خَاطِرْنِي مَا عَادِشْ نْشُوفْ مِنْ قُوِّةْ النُّورْ الِّي عْمَانِي. <verse eid="ACT 22:11" /><verse number="12" style="v" sid="ACT 22:12" />وكَانْ فِيهَا رَاجِلْ يْخَافْ رَبِّي إِسْمُو حَنَانِيَّا عَايِشْ حَسْبْ الشَّرِيعَة، ومَشْهُودْلُو مِاليْهُودْ الِّي فِي دِمَشْقْ الكُلْ. <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />جَانِي ووْقِفْ بْجَنْبِي وقَالْ: "يَا خُويَا شَاوُلْ، شُوفْ!". يَاخِي رْجَعْتْ نْشُوفْ بِالوَقْتْ، ورِيتُو. <verse eid="ACT 22:13" /><verse number="14" style="v" sid="ACT 22:14" />وقَالْ: "إِلَاهْ جْدُودْنَا اخْتَارِكْ بَاشْ تَعْرْفُو آشْ يْحِبْ، وبَاشْ تْشُوفْ الصَّالَحْ وتِسْمَعْ كْلَامْ مِنْ فُمُّو. <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />وإِنْتِ بِشْ تْكُونْ شَاهِدْ لِيهْ قُدَّامْ النَّاسْ الكُلْ بِلِّي رِيتُو وسْمَعْتُو. <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />وتَوَّا فَاشْ تِسْتَنَّى؟ قُومْ تْعَمِّدْ وتِغْسَلْ مِنْ ذْنُوبِكْ وادْعِي بْإِسْمْ الرَّبْ".<verse eid="ACT 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />«وبَعْدْ رْجَعْتْ لْأُورْشَلِيمْ. وآنَا نْصَلِّي فِي الهَيْكِلْ، شُفْتْ رُؤْيَا، <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />وشُفْتْ الرَّبْ يْقُلِّي: "إِزْرِبْ! وأُخْرُجْ تَوَّا مِنْ أُورْشَلِيمْ، عْلَى خَاطِرْ نَاسْهَا مَاهُمْشْ بِشْ يِقْبْلُوا شْهَادْتِكْ لِيَّا". <verse eid="ACT 22:18" /><verse number="19" style="v" sid="ACT 22:19" />يَاخِي قُلْتْ: "يَا رَبْ، رَاهُمْ يَعْرْفُوا الِّي آنَا كُنْتْ نُدْخُلْ لِلمْعَابِدْ الكُلْ بَاشْ نْشِدْ الِّي يَمْنُوا بِيكْ ونْحُطْهُمْ فِي الحَبْسْ ونَضْرَبْهُمْ. <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />وكُنْتْ حَاضِرْ وَقْتِلِّي سَيْلُو دَمْ شَهِيدِكْ اسْتِفَانُوسْ، وكُنْتْ مْوَافِقْ عْلَى قَتْلَانُو، ونْعِسْ عْلَى حْوَايِجْ الِّي قَتْلُوهْ". <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />يَاخِي قَالِّي: "إِمْشِي، بِشْ نِبْعْثِكْ بْعِيدْ لِلنَّاسْ الِّي مَاهُمْشْ يْهُودْ"».<verse eid="ACT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />وقَعْدُوا النَّاسْ يِسْمْعُوا فِيهْ حَتَّى لِينْ قَالْ الكِلْمَة هَاذِي، يَاخِي صَاحُوا بْأَعْلَى صُوتْهُمْ: «إِمْحِيوْ الرَّاجِلْ هَاذَا مِالأَرْضْ. هَاذَا مَا يِسْتَاهِلْشْ يْعِيشْ». <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />وبْدَاوْ يْصِيحُوا ويَرْمِيوْ فِي حْوَايِجْهُمْ، ويْذَرِّيوْ فِي التْرَابْ فِي الهْوَاء. <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />يَاخِي أْمَرْ القَايِدْ بَاشْ يْدَخْلُوا بُولِسْ لِلثَّكْنَة، ويِسْتَجْوْبُوهْ بِالضَّرْبْ، بَاشْ يَعْرِفْ شْنُوَّة الِّي خَلَّى النَّاسْ يْهِيجُوا عْلِيهْ. <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />ووَقْتِلِّي كَتْفُوهْ بَاشْ يِجِلْدُوهْ، قَالْ لِلضَّابِطْ الِّي كَانْ وَاقِفْ بْجَنْبُو: «يَاخِي القَانُونْ يِسْمْحِلْكُمْ بَاشْ تِجِلْدُوا مُوَاطِنْ رُومَانِي قْبَلْ مَا تْحَاكْمُوهْ؟». <verse eid="ACT 22:25" /><verse number="26" style="v" sid="ACT 22:26" />وكِي سْمَعْ الضَّابِطْ الكْلَامْ هَاذَا، مْشَى لِلقَايِدْ وخَبْرُو وقَالْ: «فِي بَالِكْ آشْ كُنْتْ بِشْ تَعْمِلْ؟ الرَّاجِلْ هَاذَا رُومَانِي!». <verse eid="ACT 22:26" /><verse number="27" style="v" sid="ACT 22:27" />يَاخِي مْشَى القَايِدْ لْبُولِسْ وسِأْلُو: «قُلِّي، بِالحَقْ إِنْتِ مُوَاطِنْ رُومَانِي؟». جَاوْبُو: «إِيْ نْعَمْ». <verse eid="ACT 22:27" /><verse number="28" style="v" sid="ACT 22:28" />قَالْ القَايِدْ: «آنَا دْفَعْتْ بَرْشَة فْلُوسْ بَاشْ نَاخُو الجِنْسِيَّة الرُّومَانِيَّة». قَالْ بُولِسْ: «آمَا آنَا تُولِدْتْ بِيهَا».<verse eid="ACT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29" />وبِالوَقْتْ وَخْرُوا الِّي كَانُوا بِشْ يِسْتَجْوْبُوهْ. والقَايِدْ خَافْ بَرْشَة كِي عْرَفْ الِّي هُوَّ كَتِّفْ مُوَاطِنْ رُومَانِي.<verse eid="ACT 22:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />ومِنْ غُدْوَة حَبْ القَايِدْ يَعْرِفْ حْقِيقِةْ التُّهْمَة الِّي تَاهْمِينُوا بِيهَا اليْهُودْ، يَاخِي نَحَّالُو السْلَاسِلْ واسْتَدْعَى كْبَارْ الكَهَنَةْ والمَجْلِسْ الأَعْلَى. وبَعْدْ جَابْ بُولِسْ ووَقْفُو قُدَّامْهُمْ.<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="s">بُولِسْ يُخْطُبْ قُدَّامْ المَجْلِسْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />خْزَرْ بُولِسْ لِلمَجْلِسْ وقَالْ: «يَا خْوَاتِي، آنَا عِشْتْ حْيَاتِي قُدَّامْ اللَّهْ بْضَمِيرْ مِرْتَاحْ حَتَّى لِلْيُومْ». <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />آمَا حَنَانِيَّا الكَاهِنْ الكْبِيرْ، عْطَى أَمْرْ لِلوَاقْفِينْ بِجْنَبْ بُولِسْ بَاشْ يُضْرْبُوهْ عْلَى فُمُّو. <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />يَاخِي بُولِسْ قَالُّو: «اللَّهْ بِشْ يُضْرْبِكْ يَا مُنَافِقْ! قَاعِدْ تُحْكُمْ عْلِيَّا حَسْبْ الشَّرِيعَة، ومْبَعِّدْ تْخَالِفْهَا وتُأْمُرْ بَاشْ يَضْرْبُونِي؟». <verse eid="ACT 23:3" /><verse number="4" style="v" sid="ACT 23:4" />والنَّاسْ الوَاقْفِينْ بْجَنْبُو قَالُولُو: «يَاخِي تْسِبْ فِي كْبِيرْ كَهَنَةْ اللَّهْ؟». <verse eid="ACT 23:4" /><verse number="5" style="v" sid="ACT 23:5" />جَاوِبْ بُولِسْ وقَالْ: «يَا خْوَاتِي، مَا كُنْتِشْ نَعْرِفْ الِّي هُوَّ الكَاهِنْ الكْبِيرْ، عْلَى خَاطِرْ مَكْتُوبْ فِي الكْتُبْ المُقَدْسَةْ: "مَا تْسِبِّشْ رَئِيسْ شَعْبِكْ"».<verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />وكِي عْرَفْ بُولِسْ الِّي المَجْلِسْ فِيهْ جْمَاعَة صَدُّوقِيِّينْ وجْمَاعَة فِرِّيسِيِّينْ، صَاحْ وقَالْ: «يَا خْوَاتِي، آنَا فِرِّيسِي وِلْدْ فِرِّيسِي، وقَاعِدْ نِتْحَاكِمْ تَوَّا عْلَى خَاطِرْ عَنْدِي رْجَى فِي قْيَامَة المُوتَى». <verse eid="ACT 23:6" /><verse number="7" style="v" sid="ACT 23:7" />ودُوبْ مَا قَالْ الكْلَامْ هَاذَا، تْعَارْكُوا الفِرِّيسِيِّينْ والصَّدُّوقِيِّينْ، وتِقْسِمْ المَجْلِسْ، <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />عْلَى خَاطِرْ الصَّدُّوقِيِّينْ مَا يْأَمْنُوشْ بِقْيَامَة المُوتَى ولَا بِالمْلَايْكَة ولَا بِالأَرْوَاحْ، آمَا الفِرِّيسِيِّينْ يَمْنُوا بْهَاذُمْ الكُلْ.<verse eid="ACT 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 23:9" />وعْلَا صْيَاحْهُمْ، ووِقْفُوا جْمَاعَة مِنْ عُلَمَاءْ الشَّرِيعَةْ التَّابْعِينْ لِلْفِرِّيسِيِّينْ وبْدَاوْا يَحْتَجُّوا بْقُوَّة وقَالُوا: «الرَّاجِلْ هَاذَا مَا لْقِينَالُو حَتَّى عِيبْ، بَالِكْشِي كَلْمُو رُوحْ وَلَّا مَلَاكْ؟». <verse eid="ACT 23:9" /><verse number="10" style="v" sid="ACT 23:10" />والمُشْكُلْ زَادْ كْبِرْ، لْدَرْجِةْ إِنُّو القَايِدْ خَافْ لَا يْقَطْعُوا بُولِسْ طْرُوفْ. يَاخِي أْمَرْ العَسْكِرْ بَاشْ يَهْبْطُوهْ ويْهِزُّوهْ مِنْ بِينَاتْهُمْ ويْرَجْعُوهْ لِلثَّكْنَة. <verse eid="ACT 23:10" /><verse number="11" style="v" sid="ACT 23:11" />واللِّيلَة الِّي بَعْدْهَا، ظْهُرْ الرَّبْ لْبُولِسْ وقَالُّو: «اتْشَجَّعْ! كِيمَا شْهِدْتْلِي فِي أُورْشَلِيمْ، بِشْ تِشْهِدْلِي فِي رُومَا زَادَا».<verse eid="ACT 23:11" /></para>
  <para style="s">مُؤَامْرَة بَاشْ يُقْتْلُوا بُولِسْ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />وَقْتِلِّي طْلَعْ النْهَارْ تْفَاهْمُوا اليْهُودْ عْلَى بُولِسْ، وحِلْفُوا بِشْ لَا يَاكْلُوا ولَا يُشْرْبُوا حَتَّى لِينْ يُقْتْلُوهْ. <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />وكَانُوا أَكْثِرْ مِنْ 40 وَاحِدْ. <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />مْشَاوْ لْكْبَارْ الكَهَنَة والشْيُوخْ وقَالُوا: «تُحْرِمْ عْلِينَا المَاكْلَة والشْرَابْ حَتَّى لِينْ نُقْتْلُوا بُولِسْ. <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />إِنْتُومَا بْصِيفِتْكُمْ أَعْضَاءْ مَجْلِسْ الأَعْلَى، أُطْلْبُوا مِالقَايِدْ بَاشْ يْجِيبْ بُولِسْ، بْحُجِّةْ إِنْكُمْ تْزِيدُوا تْحَقْقُوا مْعَاهْ، وأَحْنَا نْكُونُوا مُسْتْعَدِّينْ بَاشْ نُقْتْلُوهْ قْبَلْ مَا يُوصْلِلْكُمْ».<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />آمَا وِلْدْ أُخْتْ بُولِسْ سْمَعْ بِالخُطَّة، يَاخِي مْشَالُو لِلثَّكْنَةْ وحْكَالُو كُلْ شَيْ. <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />ولَّى بُولِسْ اسْتَدْعَى وَاحِدْ مِالضُبَّاطْ وقَالُّو: « هِزْ الطْفُلْ هَاذَا لِلقَايِدْ، عْلَى خَاطِرْ عَنْدُو حَاجَة بِشْ يْقُولْهَالُو». <verse eid="ACT 23:17" /><verse number="18" style="v" sid="ACT 23:18" />وهَزُّو الضَّابِطْ لِلقَايِدْ وقَالْ: «رَاهُو المَرْبُوطْ بُولِسْ عَيِّطْلِي، وِطْلَبْ مِنِّي بَاشْ نْجِيبْلِكْ الطْفُلْ هَاذَا عْلَى خَاطِرْ عَنْدُو مَا يْقُلِّكْ». <verse eid="ACT 23:18" /><verse number="19" style="v" sid="ACT 23:19" />يَاخِي جِبْدُو القَايِدْ عْلَى جْنَبْ مِنْ يِدُّو وسِأْلُو: «شْنُوَّة تْحِبْ تْقُلِّي؟». <verse eid="ACT 23:19" /><verse number="20" style="v" sid="ACT 23:20" />قَالُّو: «اليْهُودْ تْفَاهْمُوا بَاشْ يُطْلْبُوا مِنِّكْ تْجِيبْ بُولِسْ غُدْوَة لِلمَجْلِسْ، بْحُجِّة إِنْهُمْ بَاشْ يْزِيدُوا يْحَقِّقُوا فِي حْكَايْتُو أَكْثِرْ. <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />مَا تْصَدَّقْهُمْشْ، رَاهُو فَمَّة أَكْثِرْ مِنْ 40 رَاجِلْ مْحَضْرِينْلُوا كَمِينْ وحَرْمُوا عْلَى رْوَاحْهُمْ المَاكْلَة والشْرَابْ حَتَّى يُقْتْلُوهْ، وهُومَا تَوَّا حَاضْرِينْ، وقَاعْدِينْ يِسْتَنَّاوْ فِيكْ بَاشْ تْوَافِقْ». <verse eid="ACT 23:21" /><verse number="22" style="v" sid="ACT 23:22" />يَاخِي قَالُّو القَايِدْ: «مَا تْقُولْ لْحَدْ الِّي إِنْتِ عْلِمْتْنِي» وخَلَّاهْ يِمْشِي.<verse eid="ACT 23:22" /></para>
  <para style="s">القَايِدْ الرُّومَانِي يِبْعَثْ بُولِسْ لِلقَيْصَرِيَّة</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />وعَيِّطْ القَايِدْ لْزُوزْ مِنْ ضُبَّاطُو وقَالِلْهُمْ: «حَضّْرُوا 200 عَسْكْرِي و70 فَارِسْ و200 جُنْدِي هَازِّينْ الأَرْمَاحْ بَاشْ يِمْشِيوْ اليُومْ التِّسْعَة مْتَاعْ اللِّيلْ لْقَيْصَرِيَّة. <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />وحَضّْرُوا زَادَا حْصُنَّة بَاشْ تْهِزْ بُولِسْ وتْوَصْلُو سَالِمْ لِلوَالِي فِيلِكْسْ». <verse eid="ACT 23:24" /><verse number="25" style="v" sid="ACT 23:25" />وكْتِبْ رِسَالَة لِلوَالِي يْقُولْ فِيهَا:<verse eid="ACT 23:25" /></para>
  <para style="pi">
    <verse number="26" style="v" sid="ACT 23:26" />«مِنْ كْلُودْيُوسْ لِيسْيَاسْ لْفَخَامِةْ الوَالِي فِيلِكْسْ، تَحِيَّاتِي:<verse eid="ACT 23:26" /></para>
  <para style="pi">
    <verse number="27" style="v" sid="ACT 23:27" />«الرَّاجِلْ هَاذَا شَدُّوهْ اليْهُودْ وزَعْمَةْ لَا قَتْلُوهْ. وكِي عْرَفْتْ الِّي هُوَّ مُوَاطِنْ رُومَانِي، مْشِيتْلُو فِيسَعْ مْعَ العَسْكِرْ ومَنَّعْتُو. <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />وحَبِّيتْ نَعْرِفْ بَاشْ تَاهْمِينُو، يَاخِي هَزِّيتُو لْمَجْلِسْهُمْ، <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />ولْقِيتْ الِّي تَاهْمِينُو بْمَسَائِلْ تْخُصْ الشَّرِيعَة مْتَاعْهُمْ، وحَتَّى شَيْ مِلِّي تَاهْمِينُو بِيهْ مَا يِسْتْحَقْ المُوتْ ولَا حَتَّى الحَبْسْ. <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />وبَعْدْ عْرَفْتْ الِّي هُومَا تْآمْرُوا عْلِيهْ بَاشْ يُقْتْلُوهْ، ولِّيتْ بْعَثْتْهُولِكْ بِالوَقْتْ، وعْطِيتْ أَمْرْ لِلشَّاكْيِينْ بِيهْ بَاشْ يْجِيوْكْ إِنْتِ ويِشْكِيوْلِكْ».<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />ونَفْذُوا العَسْكِرْ أَوَامِرْ قَايِدْهُمْ وهَزُّوا بُولِسْ فِي اللِّيلْ ووُصْلُوا بِيهْ لِمْدِينِةْ أَنْتِيبَاتْرِيسْ، <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />ومِنْ غُدْوَة رَجْعُوا لِلثَّكْنَةْ، وخَلَّاوْ الفُرْسَانْ يِمْشِيوْ مْعَ بُولِسْ. <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />وكِي وُصْلُوا الفُرْسَانْ لْقَيْصَرِيَّة، عْطَاوْ الرِّسَالَة لِلْوَالِي وسَلْمُولُو بُولِسْ. <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />قْرَى الوَالِي الرِّسَالَة، وسْإِلْ بُولِسْ عْلَى أَصْلُو مْنِينْ . وكِي عْرَفْ الِّي هُوَّ مِنْ كِيلِيكِيَّة، <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />قَالُّو: «تَوْ نْشُوفْلِكْ القَضِيَّة مْتَاعِكْ كِي يَحْضْرُوا الشَّاكْيِينْ بِيكْ». وعْطَى أَمْرْ بَاشْ يِبْقَى بُولِسْ تَحْتْ الحِرَاسَةْ فِي دَارْ الوِلَايَة التَّابْعَة لْهِيرُودُسْ.<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s">بُولِسْ قُدَّامْ الحَاكِمْ فِيلِكْسْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />وبَعْدْ خَمْسَة أَيَّامْ، جَاء حَنَانِيَّا الكَاهِنْ الكْبِيرْ وجْمَاعَة مِالشْيُوخْ ومُحَامِي إِسْمُو تَرْتُلُّسْ لْقَيْصَرِيَّة، وشْكَاوْا بْبُولِسْ لِلْوَالِي. <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />وجَابُوا بُولِسْ وبْدَا تَرْتُلُّسْ يِتْهِمْ فِيهْ قُدَّامْ فِيلِكْسْ وقَالْ: «الفَضْلْ يِرْجَعْ لِيكْ إِنْتِ فِي السَّلَامْ الِّي مِتْمَتْعِينْ بِيهْ أَحْنَا، والإِصْلَاحَاتْ الِّي تْعَمْلِتْ لْشَعْبْنَا هَاذَا نَتِيجِةْ حِكْمْتِكْ، <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />وأَحْنَا يَا حَضْرِةْ الوَالِي فِيلِكْسْ فَرْحَانِينْ بْهَاذَا، وشَاكْرِينِكْ فِي كُلْ وَقْتْ وفِي كُلْ بْلَاصَة. <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />وبَاشْ مَا نْطَوِّلْشْ عْلِيكْ أَكْثِرْ، مَذَابِيكْ تِتْكَرِّمْ عْلِينَا، وتْوَسَّعْ بَالِكْ وتِسْمَعْنَا. <verse eid="ACT 24:4" /><verse number="5" style="v" sid="ACT 24:5" />أَحْنَا فِقْنَا الِّي الرَّاجِلْ هَاذَا يِتْسَبِّبْ فِي المَشَاكِلْ، ويَعْمِلْ فِي فِتْنَة بِينْ اليْهُودْ فِي العَالِمْ الكُلْ، وهُوَّ زَعِيمْ مَذْهَبْ النَّاصِرِيينْ. <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />وحَاوِلْ يْنَجِّسْ الهَيْكِلْ مْتَاعْنَا. وَلِّينَا شَدِّينَاهْ وحَبِّينَا نُحْكْمُوا عْلِيهْ حَسْبْ شَرِيعِتْنَا. <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />آمَا القَايِدْ لِيسْيَاسْ جَاء وفَكُّو مِنْ يْدِينَا بِالقُوَّة، <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />وعْطَى أَمْرْ لِلِّي تَاهْمِينُو بَاشْ يْجِيوْ يِشْكِيوْ لِيكْ إِنْتِ، وكِي تِسْتَجْوْبُو تَوَّا تِتْأَكِّدْ إِنُّو كُلْ المُتَّهْمِينُو بِيهْ صْحِيحْ». <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />واليْهُودْ الكُلْ وَافْقُوهْ وقَالُوا الِّي هَاذَا صْحِيحْ.<verse eid="ACT 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />وطْلَبْ الوَالِي مِنْ بُولِسْ بَاشْ يِتْكَلِّمْ، يَاخِي قَالْ: «آنَا نَعْرِفْ الِّي عَنْدِكْ سْنِينْ تُحْكُمْ فِي قَضَايَا شَعْبْنَا، هَاذَاكَا عْلَاشْ بِشْ نْدَافِعْ عْلَى رُوحِي قُدَّامِكْ وآنَا مُطْمَانْ. <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />وتْنَجِّمْ تِتْأَكِّدْ الِّي مَا عَنْدِيشْ حَتَّى أَثْنَاشِنْ يُومْ مِلِّي وْصِلْتْ لْأُورْشَلِيمْ بَاشْ نِعْبِدْ رَبِّي. <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />وحَتَّى وَاحِدْ مَا لْقَانِي انَّاقِشْ فِي حَدْ فِي الهَيْكِلْ، ولَا فِي المَعَابِدْ ولَا فِي حَتَّى بْلَاصَة فِي المْدِينَة، ولَا نْهَيِّجْ فِي الشَّعْبْ. <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />وهُومَا مَا يْنَجْمُوشْ يَعْطِيوِكْ الدَّلِيلْ عَلِّي مُتَّهْمِينِي بِيهْ. <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />آمَا نِعْتَرِفْلِكْ الِّي آنَا نِعْبِدْ فِي إِلَاهْ جْدُودْنَا حَسْبْ المَذْهَبْ الِّي يِتْسَمَّى الطْرِيقْ ولِّي يْقُولُوا عْلِيهْ إِنُّو بِدْعَة، ونَمِّنْ بْكُلْ الِّي مَكْتُوبْ فِي الشَّرِيعَة وكْتُبْ الأَنْبِيَاءْ. <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />وعَنْدِي رْجَى فِي اللَّهْ كِيفْهُمْ، إِنُّو بِشْ تْكُونْ فَمَّة قْيَامَةْ مِالمُوتْ لِلصَّالْحِينْ والأَشْرَارْ. <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />هَاذَاكَا عْلَاشْ نْجَاهِدْ بَاشْ يْكُونْ ضَمِيرِي طَاهِرْ قُدَّامْ اللَّهْ والنَّاسْ.<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />«وبَعْدْمَا غِبْتْ سْنِينْ عْلَى أُورْشَلِيمْ، رْجَعْتِلْهَا بَاشْ نْجِيبْ شْوَيَّة تَبَرُّعَاتْ لْشَعْبِي ونْقَدِّمْ قْرَابِينْ. <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />شَافُونِي جْمَاعَة يْهُودْ مِنْ آسِيَّا فِي الهَيْكِلْ. وَقْتْهَا مَزِّلْتْ كِي كَمَّلْتْ شَرِيعِة التَّطْهِيرْ، ولَا كُنْتْ مْدَوِّرْ بِيَّا نَاسْ ولَا نَعْمِلْ فِي فَوْضَى. <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />وكَانْ لَازِمْ يْجِيوِكْ هُومَا بِيدْهُمْ ويِشْكِيوْلِكْ كَانْ جَاء عَنْدْهُمْ حَاجَة ضِدِّي. <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />وَلَّا خَلِّي النَّاسْ المَوْجُودِينْ هُونِي يْقُولُولِكْ شْنُوَّة الذَّنْبْ الِّي شَدُّوهْ عْلِيَّا، وَقْتِلِّي تْحَاكِمْتْ قُدَّامْ المَجْلِسْ الأَعْلَى. <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />إِلَّا إِذَا كَانْ عْلَى خَاطِرْ الجُمْلَةْ الوَحِيدَةْ الِّي نْطَقْتْ بِيهَا وآنَا وَاقِفْ قُدَّامْهُمْ: "آنَا قَاعِدْ نِتْحَاكِمْ تَوَّا عْلَى خَاطِرْنِي نَمِّنْ بِقْيَامِةْ المُوتَى"».<verse eid="ACT 24:21" /></para>
  <para style="s">بُولِسْ يُقْعُدْ تَحْتْ العَسَّة</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />وفِيلِكْسْ الِّي كَانْ يَعْرِفْ بَرْشَة حَاجَاتْ عَلِّي يْسَمِّيوُهْ الطْرِيقْ، أَجِّلْ الجَلْسَةْ وقَالْ: «وَقْتِلِّي يْجِي القَايِدْ لِيسْيَاسْ، تَوْ نُحْكُمْ فِي القَضِيَّة مْتَاعْكُمْ». <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />وأْمَرْ الضَّابِطْ بَاشْ يْحُطُّوا بُولِسْ تَحْتْ العَسَّة، آمَا تْكُونْ عَنْدُو شْوَيِّةْ حُرِّيَّة ويْخَلِّيوْ صْحَابُو يْزُورُوهْ ويِتِلْهَاوْ بِيهْ.<verse eid="ACT 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />وبَعْدْ أَيَّامَاتْ جَاء فِيلِكْسْ ومْعَاهْ مَرْتُو دْرُوسِيلَا، وكَانِتْ يْهُودِيَّة، يَاخِي اسْتَدْعَى بُولِسْ وسَمْعُو يَحْكِي عَالإِيمَانْ بِالمَسِيحْ يَسُوعْ. <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />وَقْتِلِّي بْدَا بُولِسْ يَحْكِي عَالصَّلَاحْ والرْزَانَةْ ويُومْ الحْسَابْ، خَافْ فِيلِكْسْ وقَالُّو: «إِمْشِي تَوَّا، وكِي يِبْدَا عَنْدِي وَقْتْ تَوْ نْعَيِّطْلِكْ». <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />وكَانْ عَنْدُو أَمَلْ إِنُّو بُولِسْ يَعْطِيهْ فْلُوسْ فَمَّاشْ مَا يْسَيْبُو. هَاذَاكَا عْلَاشْ كَانْ يْمَشِّي فِيهْ ويْجِيبْ بَاشْ يَحْكِي مْعَاهْ .<verse eid="ACT 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27" />وبَعْدْ عَامِينْ عَالحَالَة هَاذِي، خْذَى بُورْكِيُوسْ فَسْتُوسْ بُقْعِةْ فِيلِكْسْ. وعْلَى خَاطِرْ فِيلِكْسْ حَبْ يْرَضِّي اليْهُودْ، خَلَّى بُولِسْ فِي الحَبْسْ.<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s">بُولِسْ قُدَّامْ الحَاكِمْ فَسْتُوسْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />ثْلَاثَة أَيَّامْ بَعْدْمَا وَلَّى فَسْتُوسْ وَالِي، مْشَى مِنْ قَيْصَرِيَّة لْأُورْشَلِيمْ. <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />وجَاوْهْ كْبَارْ الكَهَنَةْ وأَعْيَانْ اليْهُودْ وشْكَاوْ بْبُولِسْ، <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />وطَلْبُوا مِنُّوا بَاشْ يَعْمِلْ عْلِيهُمْ مْزِيَّةْ ويْرَجَّعْ بُولِسْ لْأُورْشَلِيمْ، عْلَى خَاطِرْهُمْ كَانُوا عَامْلِينْلُو خُطَّة بَاشْ يُقْتْلُوهْ فِي الثْنِيَّة. <verse eid="ACT 25:3" /><verse number="4" style="v" sid="ACT 25:4" />جَاوِبْهُمْ فَسْتُوسْ بِلِّي بُولِسْ بِشْ يِبْقَى تَحْتْ الحِرَاسَةْ فِي قَيْصَرِيَّة، ولِّي هُوَّ بِيدُو بِشْ يِرْجْعِلْهَا عْلَى قْرِيبْ. <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />وقَالْ: «خَلِّي قَادِتْكُمْ يِمْشِيوْ مْعَايَا. وإِذَا كَانْ الرَّاجِلْ هَاذَا مُذْنِبْ مَا عْلِيهُمْ كَانْ يِشْكِيوْ بِيهْ قُدَّامِي».<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />وعَدَّى فَسْتُوسْ مْعَاهُمْ يْجِي ثْمَنْيَة وَلَّا عَشْرَة أَيَّامْ، ورْجَعْ لْقَيْصَرِيَّة. ومِنْ غُدْوَة قْعَدْ عْلَى كُرْسِيهْ فِي المَحْكْمَة، وعْطَى أَمْرْ بَاشْ يْجِيبُوا بُولِسْ. <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />ووَقْتِلِّي جَاء، دَارُوا بِيهْ اليْهُودْ الِّي جَاوْ مِنْ أُورْشَلِيمْ، وتِهْمُوهْ بْبَرْشَة تُهَمْ خْطِيرَة مَا نَجْمُوشْ يِثْبْتُوهَا عْلِيهْ. <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />ودَافِعْ بُولِسْ عْلَى رُوحُو وقَالْ: «آنَا مَا عْمَلْتْ حَتَّى ذَنْبْ فِي حَقْ شَرِيعِةْ اليْهُودْ، ولَا فِي حَقْ الهَيْكِلْ ولَا القَيْصِرْ». <verse eid="ACT 25:8" /><verse number="9" style="v" sid="ACT 25:9" />لَكِنْ فَسْتُوسْ حَبْ يْرَضِّي اليْهُودْ، يَاخِي سْإِلْ بُولِسْ: «تْحِبْشِي تِمْشِي لْأُورْشَلِيمْ، وتِتْحَاكِمْ قُدَّامِي عَالتُّهَمْ هَاذُمْ؟». <verse eid="ACT 25:9" /><verse number="10" style="v" sid="ACT 25:10" />جَاوِبْ بُولِسْ: «آنَا وَاقِفْ فِي مَحْكْمِةْ القَيْصِرْ، ويِلْزِمْ نِتْحَاكِمْ فِيهَا. آنَا مَا غْلُطِّشْ فِي حَقْ اليْهُودْ وإِنْتِ تَعْرِفْ هَاذَا مْلِيحْ. <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />كَانْ جِيتْ عْمَلْتْ جْرِيمَةْ تِسْتْحَقْ الإِعْدَامْ، مَا كُنْتِشْ بِشْ نِتْهَرِّبْ مِالمُوتْ. آمَا مَادَامْ التُّهَمْ مْتَاعْ النَّاسْ هَاذُومْ مَاهِيشْ صْحِيحَة، مَالَا حَتَّى حَدْ مَا عَنْدُو الحَقْ يْسَلِّمْنِي لِيهُمْ بَاشْ يْحَاكْمُونِي. آنَا بِشْ نِسْتِينِفْ دَعْوْتِي لِلْقَيْصِرْ». <verse eid="ACT 25:11" /><verse number="12" style="v" sid="ACT 25:12" />وتْشَاوِرْ فَسْتُوسْ مْعَ المُسْتَشَارِينْ مْتَاعُو وقَالُّو: «طْلَبْتْ بَاشْ تِسْتِينِفْ لِلْقَيْصِرْ، مَالَا بِشْ تِمْشِي لِلْقَيْصِرْ».<verse eid="ACT 25:12" /></para>
  <para style="s">أَغْرِيبَاسْ وبَرْنِيكِي</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />وبَعْدْ أَيَّامَاتْ، جَاء المَلِكْ أَغْرِيبَاسْ وأُخْتُو بَرْنِيكِي لْقَيْصَرِيَّة بَاشْ يْسَلْمُوا عْلَى فَسْتُوسْ. <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />بَعْدْمَا قَعْدُوا مُدَّة، حْكَى فَسْتُوسْ لِلمَلِكْ عْلَى قَضِيَّة بُولِسْ وقَالْ: «فَمَّة رَاجِلْ خَلَّاهْ فِيلِكْسْ فِي الحَبْسْ. <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />وآنَا فِي أُورْشَلِيمْ، شْكَاوْ بِيهْ كْبَارْ الكَهَنَةْ وشْيُوخْ اليْهُودْ، وطَلْبُوا مِنِّي بَاشْ نُحْكُمْ عْلِيهْ. <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />وقُلْتِلْهُمْ الِّي مُشْ مِنْ عَادِةْ الرُّومَانْ يُحْكْمُوا عْلَى وَاحِدْ، قْبَلْ مَا يِتْوَاجَهْ مْعَ الِّي شَاكِينْ بِيهْ، بَاشْ تْكُونْ عَنْدُو فُرْصَة يْدَافِعْ عْلَى رُوحُو. <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />ووَقْتِلِّي جَاوْ مْعَايَا لْهُونِي، مَا ضَيَّعْتِشْ الوَقْتْ ومِنْ غُدْوَة عْمَلْتْ جَلْسَة فِي المَحْكْمَة، وعْطِيتْ الأَمْرْ بَاشْ يْجِيبُوهْ. <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />وَقْتِلِّي قَابْلُوهْ الِّي شَاكِينْ بِيهْ، مَا قَالُوا حَتَّى تُهْمَة مِالتُّهَمْ الِّي كُنْتْ مِتْوَقَّعْهُمْ. <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />آمَا نَاقْشُوهْ فِي حَاجَاتْ تْخُصْ دِينْهُمْ، وتْخُصْ رَاجِلْ إِسْمُو يَسُوعْ، مَاتْ وبُولِسْ يْقُولْ الِّي هُوَّ حَيْ. <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />يَاخِي حِرْتْ كِيفَاشْ نُحْكُمْ فِي القَضِيَّة هَاذِي، وسْإِلْتْ بُولِسْ إِذَا كَانْ يْحِبْ يِمْشِي لْأُورْشَلِيمْ بَاشْ يِتْحَاكِمْ غَادِي. <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />آمَا بُولِسْ طْلَبْ بَاشْ يِسْتِينِفْ قَضِيَّتُو قُدَّامْ القَيْصِرْ، وَلِّيتْ أْمَرْتْ بَاشْ يِبْقَى تَحْتْ الحِرَاسَةْ حَتَّى لِينْ نَبْعَثْهُولُو». <verse eid="ACT 25:21" /><verse number="22" style="v" sid="ACT 25:22" />يَاخِي قَالْ أَغْرِيبَاسْ لْفَسْتُوسْ: «مَذَابِيَّا نِسْمْعُوا الرَّاجِلْ هَاذَا». جَاوْبُو: «غُدْوَة تِسْمْعُو».<verse eid="ACT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />ومِنْ غُدْوَة، جَاء المَلِكْ أَغْرِيبَاسْ وبَرْنِيكِي فِي مَوْكِبْ عْظِيمْ، ودَخْلُوا لِلمَحْكْمَةْ دَايْرِينْ بِيهُمْ قَادِةْ العَسْكِرْ وأَعْيَانْ المْدِينَة. وفَسْتُوسْ عْطَى الأَمْرْ بَاشْ يْجِيبُوا بُولِسْ. <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />وقَالْ فَسْتُوسْ: «يَا أَغْرِيبَاسْ المَلِكْ، ويَلِّي حَاضْرِينْ مْعَانَا الكُلْ، قُدَّامْكُمْ الرَّاجِلْ الِّي شْكَاوْ بِيهْ اليْهُودْ الكُلْ فِي أُورْشَلِيمْ وهْنَا، وكَانُوا يْصِيحُوا: "مَا يِلْزْمُوشْ يِبْقَى حَيْ". <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />آمَا آنَا شُفْتْ الِّي هُوَّ مَا عْمَلْ حَتَّى شَيْ يِسْتْحَقْ عْلِيهْ المُوتْ. آمَا هُوَّ اسْتِينِفْ دَعْوْتُو لْجَلَالِةْ القَيْصِرْ، وآنَا قَرَّرْتْ نَبْعِثْهُولُو. <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />آمَا مَا عَنْدِيشْ حَاجَة وَاضْحَة نِكْتِبْهَا لِلْقَيْصِرْ. هَاذَاكَا عْلَاشْ جِبْتُو قُدَّامْكُمْ وبِالأَخَصْ قُدَّامِكْ إِنْتِ يَا المَلِكْ أَغْرِيبَاسْ، بَاشْ نَلْقَى شْنُوَّة نِكْتِبْ بَعْدْمَا يِتْحَقِّقْ مْعَاهْ. <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />عْلَى خَاطِرْ مُشْ مَعْقُولْ نِبْعَثْ مَرْبُوطْ، مِنْ غِيرْ مَا نِكْتِبْ بَاشْ تَاهْمِينُو بِالضَّبْطْ».<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s">بُولِسْ قُدَّامْ المَلِكْ أَغْرِيبَاسْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />وقَالْ أَغْرِيبَاسْ لْبُولِسْ: «مَسْمُوحْلِكْ بَاشْ ادَّافِعْ عْلَى رُوحِكْ». يَاخِي مَدْ بُولِسْ يِدُّو وِبْدَا يْدَافِعْ وقَالْ: <verse eid="ACT 26:1" /><verse number="2" style="v" sid="ACT 26:2" />«يَا حَضْرِةْ المَلِكْ أَغْرِيبَاسْ! آنَا فَرْحَانْ الِّي بِشْ نْدَافِعْ عْلَى رُوحِي قُدَّامِكْ ضِدْ التُّهَمْ الِّي تِهْمُونِي بِيهَا اليْهُودْ، <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />خَاصَّةً إِنِّكْ تَعْرِفْ بِالڨْدَا عَادَاتْهُمْ والحَاجَاتْ الِّي يِتْخَالْفُوا فِيهَا. وآنَا نِتْمَنَّى إِنِّكْ تْوَسَّعْ بَالِكْ وتِسْمَعْنِي لِلِّخِّرْ.<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />«اليْهُودْ الكُلْ يَعْرْفُوا سِيرْتِي مِلِّي آنَا صْغِيرْ، ويَعْرْفُوا الِّي آنَا تْرَبِّيتْ بِينْ شَعْبِي فِي أُورْشَلِيمْ. <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />وهُومَا يَعْرْفُونِي مِنْ وَقْتْ طْوِيلْ، وكَانْ حَبُّوا، يْنَجْمُوا يِشْهْدُوا الِّي آنَا كُنْتْ فِرِّيسِي تَابَعْ لْأَكْثِرْ مَذْهَبْ مِتْشَدِّدْ فِي دِينْنَا. <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />وآنَا اليُومْ قَاعِدْ نِتْحَاكِمْ عْلَى خَاطِرْ عَنْدِي رْجَى فِي الوَعْدْ الِّي اللَّهْ وْعِدْ بِيهْ جْدُودْنَا. <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />وعْرُوشَاتْ شَعْبْنَا الأَثْنَاشْ عَنْدْهُمْ رْجَى إِنُّو الوَعْدْ هَاذَا بِشْ يِتْحَقِّقْ، هَاذَاكَا عْلَاشْ مَزَّالُوا يْدَاوْمُوا عَالعِبَادَة لِيلْ مْعَ نْهَارْ. واليْهُودْ، يَا سِيدْنَا المَلِكْ، قَاعْدِينْ يِتْهْمُوا فِيَّا وبِسْبَبْ الرْجَى هَاذَا. <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />مَالَا عْلَاشْ مَا تْصَدْقُوشْ الِّي اللَّهْ يْقَوِّمْ المُوتَى؟<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />«آنَا بِيدِي كُنْتْ مُقْتَنَعْ الِّي يِلْزِمْنِي نَعْمِلْ كُلْ جِهْدِي بَاشْ نْقَاوِمْ إِسْمْ يَسُوعْ النَّاصْرِي. <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />وهَاذَا آشْ عْمَلْتْ فِي أُورْشَلِيمْ. حَطِّيتْ بَرْشَة قِدِّيسِينْ فِي الحَبْسْ بْتَفْوِيضْ مِنْ كْبَارْ الكَهَنَةْ، وكُنْتْ دِيمَا نْوَافِقْ وَقْتِلِّي يِتْحْكَمْ عْلِيهُمْ بِالإِعْدَامْ. <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />وعَذَّبْتْهُمْ بَرْشَة فِي المْعَابِدْ الكُلْ فَمَّاشْ مَا يَكْفْرُوا، وكُنْتْ نَاقِمْ عْلِيهُمْ لْدَرْجِة إِنِّي وَلِّيتْ شَادِدْ جُرِّتْهُمْ حَتَّى لْبَرَّا مِالبْلَادْ».<verse eid="ACT 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />«وفِي سَفْرَة مِالسَّفْرَاتْ هَاذُوكُمْ، كُنْتْ فِي طْرِيقِي لْدِمَشْقْ بَعْدْمَا خْذِيتْ سُلْطَةْ وتَفْوِيضْ مِنْ عَنْدْ كْبَارْ الكَهَنَة. <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />مْعَ نُصْ النْهَارْ وآنَا فِي الطْرِيقْ، شُفْتْ يَا سِيدْنَا المَلِكْ، نُورْ سَاطَعْ مِالسْمَاء أَقْوَى مِنْ نُورْ الشَّمْسْ، دَايِرْ بِيَّا وبِلِّي مْعَايَا. <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />يَاخِي طُحْنَا الكُلْ فِي القَاعَة، وسْمَعْتْ صُوتْ يْقُلِّي بِاللُّوغَة العِبْرِيَّة: "شَاوُلْ! شَاوُلْ! عْلَاشْ تِضْطَهِدْ فِيَّا؟ كِي تْقَاوِمْنِي رَاكْ تَاذِي فِي رُوحِكْ!". <verse eid="ACT 26:14" /><verse number="15" style="v" sid="ACT 26:15" />يَاخِي سْإِلْتْ: "شْكُونْ إِنْتِ يَا رَبْ؟". جَاوِبْنِي الرَّبْ: "آنَا يَسُوعْ الِّي إِنْتِ تِضْطَهِدْ فِيهْ. <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />قُومْ آقِفْ عْلَى سَاقِيكْ، آنَا ظْهُرْتْلِكْ بَاشْ نْرُدِّكْ خَادِمْ لِيَّا وشَاهِدْ عَالرُّؤْيَا الِّي رِيتْنِي فِيهَا تَوَّا، ولْغِيرْهَا مِلِّي بِشْ نْوَرِّيهُمْلِكْ مْبَعِّدْ، <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />وبِشْ نْمَنْعِكْ مِنْ شَعْبِكْ ومِالشُّعُوبْ الأُخْرَى الِّي بِشْ نِبْعْثِكْ لِيهُمْ، <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />بَاشْ تْحِلِّلْهُمْ عِينِيهُمْ وتْخَرِّجْهُمْ مِالظْلَامْ لِلنُّورْ، ومِنْ سُلْطِةْ الشِّيطَانْ لْسُلْطِةْ اللَّهْ بَاشْ تِتْغْفِرْ ذْنُوبْهُمْ، ويُورْثُوا مْعَ القِدِّيسِينْ المُؤْمْنِينْ بِيَّا".<verse eid="ACT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />«ومِنْ وَقْتْهَا، يَا حَضْرِةْ المَلِكْ أَغْرِيبَاسْ، مَا جِيتِشْ ضِدْ الرُّؤْيَا الِّي مِالسْمَاء. <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />وبَشِّرْتْ فِي الأُوِّلْ فِي دِمَشْقْ، ومْبَعِّدْ فِي أُورْشَلِيمْ واليَهُودِيَّة ولِّي مَاهُمْشْ يْهُودْ، وشَجَّعْتْهُمْ بَاشْ يْتُوبُوا ويِرْجْعُوا لِلَّهْ ويْخَلِّيوْ تُوبِتْهُمْ تُظْهِرْ فِي أَفْعَالْهُمْ. <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />هَاذَاكَا عْلَاشْ شَدُّونِي اليْهُودْ فِي الهَيْكِلْ وحَبُّوا يُقْتْلُونِي. <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />آمَا اللَّهْ حْفَظْنِي حَتَّى لِلْيُومْ، وعَاوِنِّي بَاشْ نَاقِفْ نِشْهِدْلُو قُدَّامْ الصْغِيرْ والكْبِيرْ، ومَا نْقُولْ كَانْ الِّي تْنَبَّأْ بِيهْ مُوسَى والأَنْبِيَاءْ، <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />وهُوَّ إِنُّو المَسِيحْ بِشْ يِتْعَذَّبْ، ويْكُونْ أَوِّلْ وَاحِدْ يْقُومْ مِالمُوتْ، ويْبَشِّرْ بِالنُّورْ شَعْبْنَا والشْعُوبْ الأُخْرَى».<verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />ودُوبْ مَا قَالْ بُولِسْ الكْلَامْ هَاذَا، قَصْ عْلِيهْ فَسْتُوسْ وقَالْ بْصُوتْ عَالِي: «إِنْتِ هْبِلْتْ يَا بُولِسْ! كَثْرِةْ العِلْمْ الِّي عَنْدِكْ هَبْلِتِّكْ!». <verse eid="ACT 26:24" /><verse number="25" style="v" sid="ACT 26:25" />جَاوْبُو بُولِسْ: «آنَا مَانِيشْ مَهْبُولْ يَا حَضْرِةْ الحَاكِمْ فَسْتُوسْ. آنَا نْقُولْ فِي كْلَامْ صْحِيحْ ومَعْقُولْ. <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />والمَلِكْ الِّي آنَا نْكَلِّمْ فِيهْ تَوَّا بْصَرَاحَة، يَعْرِفْ الأُمُورْ هَاذِي، وآنَا مِتْأَكِّدْ الِّي مَا يَخْفَى عْلِيهْ شَيْ مِنْهَا، عْلَى خَاطِرْهَا مَا صَارِتْشْ فِي التْرَاكِنْ المْخُبْيَةْ. <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />يَا حَضْرِةْ المَلِكْ أَغْرِيبَاسْ، يَاخِي إِنْتِ تَمِّنْ بِالأَنْبِيَاءْ؟ آنَا نَعْرِفْ الِّي إِنْتِ تَمِّنْ بِيهُمْ». <verse eid="ACT 26:27" /><verse number="28" style="v" sid="ACT 26:28" />جَاوِبْ أَغْرِيبَاسْ بُولِسْ: «يَاخِي فِي الوَقْتْ القْصِيرْ هَاذَا تْحِبْ تَقْنَعْنِي بَاشْ نْوَلِّي مَسِيحِي!». <verse eid="ACT 26:28" /><verse number="29" style="v" sid="ACT 26:29" />قَالْ بُولِسْ: «وَقْتْ طْوِيلْ وَلَّا قْصِيرْ، آنَا رَانِي نُطْلُبْ فِي رَبِّي بَاشْ إِنْتِ ولِّي يِسْمْعُوا فِيَّا الكُلْ تْوَلِّيوْ كِيفِي، آمَا مِنْ غِيرْ السْلَاسِلْ هَاذِي». <verse eid="ACT 26:29" /><verse number="30" style="v" sid="ACT 26:30" />يَاخِي قَامْ المَلِكْ والحَاكِمْ وبَرْنِيكِي ولِّي كَانُوا قَاعْدِينْ مْعَاهُمْ. <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />وقَالُوا لِبْعَضْهُمْ وهُومَا خَارْجِينْ: «الرَّاجِلْ هَاذَا مَا عْمَلْ حَتَّى شَيْ يِسْتْحَقْ عْلِيهْ المُوتْ وَلَّا الحَبْسْ». <verse eid="ACT 26:31" /><verse number="32" style="v" sid="ACT 26:32" />وقَالْ أَغْرِيبَاسْ لْفَسْتُوسْ: «لَوْ كَانْ مَا اسْتِينِفْشْ لِلْقَيْصِرْ، الرَّاجِلْ هَاذَا كَانْ يْنَجِّمْ يِمْشِي عْلَى رُوحُو».<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s">بُولِسْ يْسَافِرْ لْرُومَا</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />وكِي تْقَرَّرْ إِنُّو نْسَافْرُوا لْإِيطَالْيَا عْلَى طْرِيقْ البْحَرْ، سَلْمُوا بُولِسْ ومْعَاهْ مْرَابِيطْ أُخْرِينْ لْضَابِطْ إِسْمُو يُولْيُوسْ تَابَعْ لْفِرْقِةْ أُوغُسْطُسْ. <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />ورْكِبْنَا فِي سْفِينَة جَايَة مِنْ بُرْطْ أَدْرَامِيتْ ومَاشْيَة لِلمَوَانِي الِّي عْلَى شْطُوطْ آسِيَّا، وكَانْ مْعَانَا أَرِسْتَرْخُسْ مِنْ تْسَالُونِيكِي الِّي فِي مَنْطَقْةْ مَقْدُونِيَّة.<verse eid="ACT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 27:3" />ومِنْ غُدْوَة وْصِلْنَا لْصَيْدَا. وكَانْ يُولْيُوسْ يْعَامِلْ فِي بُولِسْ بِالبَاهِي، وخَلَّاهْ يْزُورْ صْحَابُو بَاشْ يَاخُذْ مِنْ عَنْدْهُمْ الِّي يِحْتَاجُو. <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />وبَحَّرْنَا مِنْ غَادِي، وجِبْنَا عْلَى شْطُوطْ قُبْرُصْ، خَاطِرْ الرِّيحْ كَانِتْ عَكْسْنَا. <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />وتْعَدِّينَا فِي البْحَرْ بِجْنَبْ كِيلِيكِيَّة وبَمْفِيلِيَّة، ووْصُلْنَا لْبُرْطْ مِيرَا فِي مَنْطَقْةْ لِيكِيَّة. <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />ولْقَى الضَّابِطْ غَادِي سْفِينَة جَايَة مِالإِسْكَنْدَرِيَّة ومَاشْيَة لْإِيطَالْيَا، يَاخِي طْلَعْنَا فِيهَا. <verse eid="ACT 27:6" /><verse number="7" style="v" sid="ACT 27:7" />وقَعْدِتْ السْفِينَة مُدَّة وهِيَّ تِمْشِي بِينَا بِالشْوَيَّة بِالشْوَيَّة. تْعِبْنَا بَرْشَةْ بَاشْ وْصِلْنَا لِمْدِينِةْ كِنِيدُسْ، وكِيفْ الرِّيحْ مَا خَلَّاتْنَاشْ نُدْخْلُوا لِلبُرْطْ، وَلِّينَا سَافِرْنَا قْرِيبْ مِنْ شْطُوطْ جَزِيرِةْ كْرِيتْ وتْعَدِّينَا مِنْ بَحْذَا رَاسْ سَلْمُونِي. <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />وبِصْعُوبَة كْبِيرَة وْصِلْنَا لْبُقْعَة تِتْسَمَّى المَوانِي الجْمِيلَة، قْرِيبَة مِنْ مْدِينِةْ لَسَائِيَّة.<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />وضَاعْ عْلِينَا بَرْشَة وَقْتْ، وحَتَّى مِنْ وَقْتْ الصْيَامْ تْعَدَّى ووَلَّى السْفَرْ فِي البْحَرْ مُخْطِرْ، يَاخِي بُولِسْ نَبَّهُّمْ <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />وقَالْ: «يَا رْجَالْ، آنَا نْرَى الِّي السْفَرْ تَوَّا مُخْطِرْ، وفِيهْ خْسَارَة كْبِيرَة، مُشْ عَالسْفِينَة ولِّي فِيهَا بَرْكْ، آمَا زَادَا عْلَى حْيَاتْنَا». <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />آمَا الضَّابِطْ إِقْتَنَعْ بِكْلَامْ رَايِّسْ السْفِينَة وبِكْلَامْ مُولَاهَا أَكْثِرْ مِنْ كْلَامْ بُولِسْ. <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />وبِمَا إِنُّو البُرْطْ مَا يُصْلُحْشْ بَاشْ نْشَتِّيوْ فِيهْ، الأَكْثَرِيَّةْ قَرْرُوا يْكَمْلُوا يْسَافْرُوا فَمَّاشْ مَا يُوصْلُوا لْبُرْطْ فِينِكْسْ ويْعَدِّيوْ الشْتَاء غَادِي، والبُرْطْ هَاذَا كَانْ فِي جَزِيرِةْ كْرِيتْ مْقَابِلْ الجَنُوبْ الغَرْبِي والشَّمَالْ الْغَرْبِي.<verse eid="ACT 27:12" /></para>
  <para style="s">العَاصْفَة</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />وكِي هَبِّتْ رِيحْ خْفِيفَة مِالجَنُوبْ، مْشَى فِي بَالْهُمْ إِنُّو الِّي حَبُّوا عْلِيهْ صَارْ، يَاخِي طَلّْعُوا مَرْسَاةْ السْفِينَة وبَحْرُوا بِجْنَبْ جَزِيرَةْ كْرِيتْ. <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />آمَا بَعْدْهَا بِشْوَيَّة هَبِّتْ مِالجَزِيرَة رِيحْ قْوِيَّة يْسَمِّيوْهَا الشَّمَالِيَّة الشَّرْقِيَّة. <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />وضَرْبِتْ السْفِينَة حَتَّى لِينْ مَا عَادِشْ تْنَجِّمْ تْقَاوِمْهَا. يَاخِي سَلِّمْنْا وخَلِّينَا الرِّيحْ تْهِزْنَا. <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />وتْعَدِّينَا قْرِيبْ مِنْ جَزِيرَة صْغِيرَة إِسْمْهَا كُودَا. وبِالسِّيفْ مَا نَجِّمْنَا نْطَلْعُوا فْلُوكِةْ النَّجْدَةْ فُوقْ السْفِينَة. <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />وبَعْدْ فِيسَعْ خْذَاوْ الإِحْتِيَاطَاتْ اللَّازْمَة ورَبْطُوا السْفِينَة مِالوِسْطْ بِالحْبَالْ. وعْلَى خَاطِرْهُمْ خَافُوا لَا يُصْدْمُوا فِي رْمَلْ شَطْ سِيرْتِسْ، هَبّْطُوا القْلَاعَاتْ وخَلَّاوْ السْفِينَة هَازِزْهَا الرِّيحْ. <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />وفِي النْهَارْ الثَّانِي قْوَاتْ عْلِينَا الرِّيحْ، وبْدَاوْ يْنَقْصُوا مِالسِّلْعَة الِّي هَازِّتْهَا السْفِينَة. <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />وفِي النْهَارْ الثَّالِثْ، هُومَا بِيدِيهُمْ رْمَاوْ مَاعُونْ السْفِينَة فِي البْحَرْ. <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />تْعَدَّاتْ أَيَّامَاتْ، مَا رِينَا فِيهَا لَا شَمْسْ ولَا نْجُومْ، والعَاصْفَةْ مَاشْيَة وتَقْوَى، ومَا عَادْ عَنْدْنَا حَتَّى أَمَلْ بَاشْ نَمْنْعُوا.<verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />وكَانُوا المْسَافْرِينْ مْبَطْلِينْ المَاكْلَة مِنْ مُدِّة طْوِيلَة، وْقِفْ بُولِسْ فِي وُسْطْهُمْ وقَالْ: «يَا رْجَالْ، كَارْكُمْ سْمَعْتُوا كْلَامِي ومَا سَافِرْتُوشْ مِنْ كْرِيتْ، وَلَّا رَاكُمْ مْنَعْتُوا مِالخْطَرْ والخْسَايِرْ هَاذُمْ. <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />آمَا تَوَّا نُطْلُبْ مِنْكُمْ بَاشْ تِتْشَجْعُوا. رَاهُو حَتَى وَاحِدْ فِيكُمْ مَا بِشْ يِخْسِرْ حْيَاتُو. آمَا بِشْ نِخْسْرُوا السْفِينَة. <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />عْلَى خَاطِرْ فِي اللِّيلَة الِّي فَاتِتْ ظْهُرْلِي مَلَاكْ مِنْ عَنْدْ إِلَاهِي الِّي آنَا نِعْبِدْ فِيهْ، <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />وقَالِّي: "مَا تْخَافِشْ يَا بُولِسْ. رَاكْ لَازْمِكْ تَاقِفْ قُدَّامْ القَيْصِرْ. وعْلَى خَاطْرِكْ، اللَّهْ بَاشْ يْمَنَّعْ المْسَافْرِينْ الِّي مْعَاكْ الكُلْ". <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />مَالَا تْهَنَّاوْ يَا رْجَالْ، عْلَى خَاطِرْ عَنْدِي إِيمَانْ بِاللَّهْ ولِّي قَالْهُولِي بِشْ يْصِيرْ. <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />عْلَى خَاطِرْ أَكِيدْ السْفِينَة تِصْطَعْ فِي جَزِيرَة مِالجُزُرْ».<verse eid="ACT 27:26" /></para>
  <para style="s">السْفِينَة تْكَسْرِتْ</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />وفِي لِيلِةْ أَرْبَعْطَاشْ، كُنَّا ضَايْعِينْ والرِّيحْ تْهِزْ فِينَا وتْجِيبْ فِي بْحَرْ أَدْرِيَا. ومْعَ نُصْ اللِّيلْ، البَحَّارَة مْشَى فِي بَالْهُمْ الِّي هُومَا قُرْبُوا مِالبَرْ. <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />قَاسُوا غُرْقْ المَاء لْقَاوْهْ 37 مِيتْرُو، وبَعْدْ شْوَيَّة قَاسُوا مَرَّة أُخْرَى لْقَاوْهْ 28 مِيتْرُو. <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />وخَافُوا لَا السْفِينَة تُصْدُمْ فِي الحْجَرْ، وَلَّاوْ رْمَاوْ أَرْبْعَة مْخَاطِفْ مِنْ تَالِي، وقَعْدُوا يِسْتَنَّاوْ فِي طْلُوعْ النْهَارْ بِالدْقِيقَة والدْرَجْ. <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />وحَاوْلُوا البَحَّارَة بَاشْ يُهْرْبُوا مِالسْفِينَة، يَاخِي هَبّْطُوا فْلُوكِةْ النَّجْدَةْ زَعْمَة زَعْمَة بَاشْ يَرْمِيوْ المْخَاطِفْ مِالقُدَّامْ. <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />يَاخِي قَالْ بُولِسْ لِلضَّابِطْ ولِلْعَسْكَرْ: «إِذَا كَانْ هَاذُمْ مَا يَبْقَاوِشْ فِي السْفِينَة، رَاكُمْ مَاكُمْشْ بِشْ تَمْنْعُوا». <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />يَاخِي قَصُّوا العَسْكِرْ حْبَالْ الفْلُوكَة وخَلَّاوْهَا اطِّيحْ فِي المَاء. <verse eid="ACT 27:32" /><verse number="33" style="v" sid="ACT 27:33" />وكِي قْرِيبْ يِطْلَعْ النْهَارْ، طْلَبْ بُولِسْ مِالنَّاسْ الكُلْ بَاشْ يَاكْلُوا وقَالْ: «تْعَدَّاوْ أَرْبَعْطَاشِنْ يُومْ وإِنْتُومَا تِسْتَنَّاوْ مِنْ غِيرْ مَا كْلِيتُوا شَيْ. <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />وآنَا نُطْلُبْ مِنْكُمْ بَاشْ تَاكْلُوا، عْلَى خَاطِرْ هَاذَا يْعَاوِنْكُمْ بَاشْ تِمْنْعُوا، ومُشْ بِشْ تِتْمَسْ حَتَّى شَعْرَة مِنْ رَاسْ حَتَّى وَاحِدْ مِنْكُمْ». <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />مْبَعِّدْ خْذَا الخُبْزْ وشْكَرْ اللَّهْ قُدَّامْ النَّاسْ الكُلْ، وقَسْمُو وبْدَا يَاكِلْ. <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />يَاخِي الكُلْهُمْ طْمَانُوا وكْلَاوْ. <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />وكُنَّا 276 وَاحِدْ فِي السْفِينَة. <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />وبَعْدْمَا شَبْعُوا، رْمَاوْ القَمْحْ فِي البْحَرْ بَاشْ يْخَفْفُوا عَالسْفِينَة.<verse eid="ACT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />وكِي طْلَعْ النْهَارْ، مَا عَرْفُوشْ البَحَّارَة الْأَرْضْ الِّي وِصْلُولْهَا، آمَا شَافُوا خَلِيجْ فِيهْ شَطْ رْمَلْ، يَاخِي قَرْرُوا بِشْ يِرْسِيوْ السْفِينَة فِيهْ كَانْ يْنَجْمُوا. <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />وقَصُّوا المْخَاطِفْ وخَلَّاوْهُمْ يُغْرْقُوا. وحَلُّوا الحْبَالْ الِّي تُرْبِطْ الدَّفَّة، وطَلّْعُوا القْلَاعْ القُدَّامِي وقَبّْلُوهْ لِلرِّيحْ وقَصْدُوا الشَّطْ. <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />آمَا السْفِينَةْ صُدْمِتْ فِي بْلَاصَة فِي البْحَرْ رْمَلْهَا عَالِي. وْحِلْ نُصْهَا القُدَّامِي فِي الرْمَلْ ومَا عَادِشْ يِتْحَرِّكْ، ونُصْهَا التِّيلَانِي قْعَدْ يِتْكَسِّرْ مِنْ قُوِّةْ المُوجْ.<verse eid="ACT 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42" />والعَسْكِرْ حَبُّوا يُقْتْلُوا المْرَابِيطْ بَاشْ حَتَّى وَاحِدْ مِنْهُمْ مَا يْعُومْ لِلشَّطْ ويُهْرُبْ. <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />آمَا الضَّابِطْ كَانْ يْحِبْ يْمَنَّعْ بُولِسْ، وَلَّى مَا خَلَّاهُمْشْ يَعْمْلُوا الِّي فِي بَالْهُمْ. وعْطَى أَمْرْ لِلِّي يَعْرْفُوا يْعُومُوا بَاشْ يْنَڨْزُوا هُومَا الأُولَانِينْ ويْعُومُوا لِلشَطْ قْبَلْ الأُخْرِينْ، <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />والبْقِيَّة يْحَاوْلُوا بَاشْ يَخْلْطُوا عْلِيهُمْ عَاللُّوحْ وَلَّا عْلَى قْطَايِعْ السْفِينَة. وهَكَّا وُصْلُوا الكُلْ سَالْمِينْ لِلبَرْ.<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s">بُولِسْ فِي مَالْطَة</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />وبَعْدْمَا مْنَعْنَا، عْرَفْنَا الِّي الجَزِيرَةْ الِّي وْصِلْنَالْهَا هِيَّ جَزِيرِةْ مَالْطَة. <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />وامَّالِيهَا كَانُوا بَاهِينْ مْعَانَا بَرْشَة. فَرْحُوا بِينَا وشَعْلُولْنَا النَّارْ عْلَى خَاطِرْ الطَّقْسْ كَانْ بَارِدْ والمْطَرْ تْصُبْ. <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />ولَمْ بُولِسْ حِزْمَةْ حْطَبْ ورْمَاهَا فِي النَّارْ، يَاخِي بِالسْخَانَة خَرْجِتْلُو لَفْعَى وتْلَفِّتْ عْلَى يِدُّو. <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />وكِي شَافُوا الِّي يُسْكْنُوا فِي مَالْطَة اللَّفْعَى شَادَّة فِي يِدُّو، قَالُوا لِبْعَضْهُمْ: «الرَّاجِلْ هَاذَا مَا يْكُونْ كَانْ قَاتِلْ رُوحْ، حَتَّى بَعْدْمَا مْنَعْ مِالبْحَرْ، العَدَالَةْ مَا خَلَّاتُوشْ يْعِيشْ». <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />آمَا بُولِسْ رْمَى اللَّفْعَى فِي النَّارْ مِنْ غِيرْ مَا عَمْلِتْلُو حَتَّى شَيْ. <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />وقَعْدُوا يِسْتَنَّاوْ فِيهْ بَاشْ يِتْنْفَخْ وَلَّا يْطِيحْ يْمُوتْ. آمَا كِي سْتَنَّاوْ وَقْتْ طْوِيلْ ومَا جْرَالُو شَيْ، بَدْلُوا رَايْهُمْ وقَالُوا: «هَاذَا إِلَاهْ».<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />وقْرِيبْ مِنْ البُقْعَة هَاذِيكَا كَانْ فَمَّة سْوَانِي تَابْعَة لْحَاكِمْ الجَزِيرَة بُوبْلْيُوسْ، الِّي فْرَحْ بِينَا فِي دَارُو وضَيَّفْنَا ثْلَاثَة أَيَّامْ. <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />وكَانْ بُوبْلْيُوسْ رَاقِدْ فِي الفَرْشْ مْرِيضْ بِالسْخَانَة وعَنْدُو جَرْيَانْ جُوفْ قْوِيْ، يَاخِي مْشَالُو بُولِسْ وصَلَّى، وحَطْ عْلِيهْ يْدِيهْ وشْفَاهْ. <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />وكِي صَارْ هَاذَا، جَاوَهْ المُرْضَى الِّي فِي الجَزِيرَة الكُلْ وتِشْفَاوْ. <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />وفَرْحُوا بِينَا بِالڨْدَا، وكِي جِينَا مْسَافْرِينْ، عْطَاوْنَا كُلْ الِّي نِسْتْحَقُّولُو فِي سْفَرْنَا.<verse eid="ACT 28:10" /></para>
  <para style="s">بُولِسْ يْسَافِرْ مِنْ مَالْطَة لْرُومَا</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />وبَعْدْ ثْلَاثَة شْهُرْ، رْكِبْنَا فِي سْفِينَة مِالإِسْكَنْدَرِيَّة، عَدَّاتْ شْتَاءْ كَامِلْ فِي مَالْطَة، وكَانِتْ عْلِيهَا عَلَامِةْ الآلْهَة التْوَامَة. <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />وكِي وْصِلْنَا لْسِرَاكُوسَا قْعَدْنَا فِيهَا ثْلَاثَة أَيَّامْ. <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />مْبَعِّدْ قَعْدِتْ السْفِينَة تِمْشِي قْرِيبْ مِالشَّطْ حَتَّى لِينْ وْصِلْنَا لِمْدِينِةْ رِيغِيُونْ. مِنْ غُدْوَة هَبِّتْ رِيحْ جَنُوبِيَّة دَزِّتْ السْفِينَة، وفِي نْهَارِينْ وْصِلْنَا لِمْدِينِةْ بُوطْيُولِي. <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />وغَادِي قَابِلْنَا جْمَاعَة مِالإِخْوَة، طَلْبُوا مِنَّا بَاشْ نُقْعْدُوا عَنْدْهُمْ سَبْعَة أَيَّامْ. وهَكَّا وْصِلْنَا لْرُومَا. <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />كِي سَمْعُوا بِينَا الإِخْوَة جِينَا، سَافْرُوا حَتَّى لْسُوقْ أَبِيُّوسْ ولِبْلَاصِةْ الثْلَاثَة وِكَالَاتْ بَاشْ يِسْتَقْبْلُونَا. ووَقْتِلِّي شَافْهُمْ بُولِسْ شْكَرْ اللَّهْ وتْشَجَّعْ. <verse eid="ACT 28:15" /><verse number="16" style="v" sid="ACT 28:16" />كِي وْصِلْنَا لْرُومَا، الضَّابِطْ خَلَّى بُولِسْ يُسْكُنْ فِي دَارْ وَحْدُو ومْعَاهْ العَسْكْرِي الِّي يْعِسْ عْلِيهْ.<verse eid="ACT 28:16" /></para>
  <para style="s">بُولِسْ يِشْهِدْ لِلْمَسِيحْ فِي رُومَا</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />وبَعْدْ ثْلَاثَة أَيَّامْ اسْتَدْعَى بُولِسْ قَادِةْ اليْهُودْ وقَالِلْهُمْ: «يَا خْوَاتِي، آنَا مَا عْمَلْتْ حَتَّى شَيْ ضِدْ الشَّعْبْ ولَا ضِدْ عَادَاتْ جْدُودْنَا، ورَغْمْ هَاذَاكَا شَدُّونِي فِي أُورْشَلِيمْ وسَلْمُونِي لِلرُّومَانْ. <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />وبَعْدْمَا الرُّومَانْ إِسْتَجْوْبُونِي، حَبُّوا يْسَيْبُونِي عْلَى خَاطِرْنِي مَا عْمَلْتْ شَيْ نِسْتْحَقْ عْلِيهْ المُوتْ. <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />آمَا اليْهُودْ مَا وَافْقُوشْ، وتْلَزِّيتْ بَاشْ نَرْفَعْ قَضِيْتِي لِلْقَيْصِرْ. آمَا هَاذَا مَا يِعْنِيشْ الِّي آنَا قَاعِدْ نِشْكِي بْشَعْبِي. <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />هَاذَاكَا عْلَاشْ حَبِّيتْ نْشُوفْكُمْ ونَحْكِي مْعَاكُمْ، وآنَا رَانِي مَرْبُوطْ بِالسِّلْسْلَة هَاذِي عْلَى خَاطِرْ رْجَى بَنِي إِسْرَائِيلْ».<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />يَاخِي قَالُولُو: «مَا جَاتْنَا فِيكْ حَتَّى رِسَالَةْ مِاليَهُودِيَّة، وحَتَّى وَاحِدْ مِالإِخْوَةْ الِّي جَاوْنَا مِنْ غَادِي مَا قَالْ عْلِيكْ حَاجَة خَايْبَةْ. <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />آمَا أَحْنَا نْحِبُّوا نِسْمْعُوا رَايِكْ إِنْتِ، عْلَى خَاطِرْ نَعْرْفُوا الِّي النَّاسْ فِي كُلْ بْلَاصَةْ يْعَارْضُوا فِي المَذْهِبْ هَاذَا».<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />وتْفَاهْمُوا عْلَى نْهَارْ آخِرْ بَاشْ يِتْقَابْلُوا فِيهْ. وجَاوْ لْدَارُو مْعَ بَرْشَة نَاسْ، وقْعَدْ بُولِسْ مِالصْبَاحْ لِلعْشِيَّة وهُوَّ يْفَسْرِ ويِشْهِدْ عْلَى مَمْلِكْةْ اللَّهْ، ويِقْنَعْ فِيهُمْ بَحْقِيقِةْ يَسُوعْ مِنْ شَرِيعَةْ مُوسَى وكْتُبْ الأَنْبِيَاءْ. <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />فَمَّة الِّي مِنْهُمْ إِقْتَنَعْ بِكْلَامُو، وفَمَّة الِّي مَا حَبِّشْ يَمِّنْ. <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />ومَا تْفَاهْمُوشْ بِينَاتْ بْعَضْهُمْ وقْبَلْ مَا يِمْشَيوْ قَالِلْهُمْ بُولِسْ: «صْدُقْ الرُّوحْ القُدُسْ وَقْتِلِّي قَالْ لِجْدُودْكُمْ عْلَى لْسَانْ النَّبِيْ إِشَعْيَاءْ:<verse eid="ACT 28:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="ACT 28:26" />"إِمْشِي لِلشَّعْبْ هَاذَا وقُلُّو:</para>
  <para style="q1" vid="ACT 28:26">مَهْمَا سْمَعْتُوا،</para>
  <para style="q2" vid="ACT 28:26">مَاكُمْشْ بِشْ تِفِهْمُوا،</para>
  <para style="q1" vid="ACT 28:26">ومَهْمَا خْزَرْتُوا،</para>
  <para style="q2" vid="ACT 28:26">مَاكُمْشْ بِشْ تْشُوفُوا.<verse eid="ACT 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27" />عْلَى خَاطِرْ الشَّعْبْ هَاذَا قَلْبُو كْسَاحْ،</para>
  <para style="q2" vid="ACT 28:27">وسَمْعْهُمْ ثْقُلْ،</para>
  <para style="q1" vid="ACT 28:27">وغَمْضُوا عِينِيهُمْ،</para>
  <para style="q2" vid="ACT 28:27">بَاشْ مَا يْشُوفُوشْ بْعِينِيهُمْ،</para>
  <para style="q1" vid="ACT 28:27">ومَا يِسْمْعُوشْ بْوِذْنِيهُمْ،</para>
  <para style="q2" vid="ACT 28:27">ومَا يِفْهْمُوشْ بِقْلُوبْهُمْ</para>
  <para style="q1" vid="ACT 28:27">ومَا يْتُوبُوشْ بَاشْ نِشْفِيهُمْ".<verse eid="ACT 28:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28" />«ويْكُونْ فِي عِلْمْكُمْ الِّي اللَّهْ وَصِّلْ بْشَارِةْ النْجَاةْ لِلِّي مَاهُمْشْ يْهُودْ، وهُومَا بِشْ يِسْمْعُوهَا».<verse eid="ACT 28:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 28:29" />ووَقْتِلِّي سَمْعُوا اليْهُودْ الكْلَامْ هَاذَا، خَرْجُوا وهُومَا يِتْنَاقْشُوا بْقُوَّة.<verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />وسْكِنْ بُولِسْ عَامِينْ كَامْلِينْ فِي الدَّارْ الِّي كْرَاهَا، وكَانْ يِفْرَحْ بِلِّي يْجِيوْ يْزُورُوهْ الكُلْ. <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />وكَانْ يْبَشِّرْ بْمَمْلِكْةْ اللَّهْ، ويْعَلِّمْ عَالرَّبْ يَسُوعْ المَسِيحْ بِالجْهَارْ مِنْ غِيرْ مَا يْعَطْلُو حَدْ.<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>