<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id" />
  <para style="h">غَلَاطْيَة</para>
  <para style="toc1">رِسَالِةْ بُولِسْ لِلْمُؤْمْنِينْ الِّي فِي غَلَاطْيَة</para>
  <para style="toc2">غَلَاطْيَة</para>
  <para style="toc3">غَلَاطْيَة</para>
  <para style="mt">رِسَالِةْ بُولِسْ لِلْمُؤْمْنِينْ الِّي فِي غَلَاطْيَة</para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />مِنْ بُولِسْ، الِّي هُوَّ رَسُولْ، مُشْ مِنْ عَنْدْ النَّاسْ وَلَّا عْلَى طْرِيقْ إِنْسَانْ، آمَا مِنْ عَنْدْ يَسُوعْ المَسِيحْ، ومِنْ عَنْدْ اللَّهْ الآبْ الِّي قَيِّمْ يَسُوعْ مِالمُوتْ. <verse eid="GAL 1:1" /><verse number="2" style="v" sid="GAL 1:2" />ومِنْ الإِخْوَة الِّي مْعَايَا الكُلْ، لِلْكْنَايِسْ الِّي فِي مَنْطَقْةْ غَلَاطْيَة.<verse eid="GAL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3" />النِّعْمَة والسَّلَامْ لِيكُمْ مِنْ عَنْدْ اللَّهْ بُونَا والرَّبْ يَسُوعْ المَسِيحْ، <verse eid="GAL 1:3" /><verse number="4" style="v" sid="GAL 1:4" />الِّي ضَحَّى بْنَفْسُو عْلَى خَاطِرْ ذْنُوبْنَا، بَاشْ يْمَنَّعْنَا مِالعَالِمْ الشِّرِّيرْ هَاذَا، كِيفْ مَا حَبْ إِلَاهْنَا وبُونَا، <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />لِيهْ المَجْدْ لِلْأَبَدْ. آمِينْ.<verse eid="GAL 1:5" /></para>
  <para style="s">مَا فَمَّاشْ بْشَارَة أُخْرَى</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />آنَا مِتْعَجِّبْ كِيفَاشْ فِيسَعْ تْسَلْمُوا فِلِّي دْعَاكُمْ بْنِعْمِةْ المَسِيحْ، واتَّبْعُوا بْشَارَة أُخْرَى! <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />فِي الحْقِيقَة، مَا فَمَّاشْ بْشَارَة أُخْرَى، آمَا فَمَّة نَاسْ قَاعْدِينْ يَعْمْلُوا فِي بَلْبْلَة بِينَاتْكُمْ، ويْحِبُّوا يْبَدْلُوا بْشَارِةْ المَسِيحْ. <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />وكَانْ بَشَّرْنَاكُمْ أَحْنَا، وَلَّا حَتَّى كَانْ مَلَاكْ مِالسْمَاء بَشَّرْكُمْ بِبْشَارَة غِيرْ الِّي بَشَّرْنَاكُمْ بِيهَا، خَلِّيهْ يْكُونْ مَلْعُونْ. <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />وكِيمَا قُلْنَا قْبَلْ، نْعَاوِدْ نْقُولْ تَوَّا زَادَا: إِذَا كَانْ وَاحِدْ يْبَشَّرْكُمْ بِبْشَارَة غِيرْ الِّي قْبِلْتُوهَا، خَلِّيهْ يْكُونْ مَلْعُونْ.<verse eid="GAL 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10" />يَاخِي نْرَضِّي النَّاسْ وَلَّا نْرَضِّي اللَّهْ؟ وَلَّا نْحِبْ النَّاسْ يْكُونُوا فِي صَفِّي؟ إِذَا كَانْ مَزِّلْتْ نْحِبْ نْرَضِّي النَّاسْ، رَانِي مَانِيشْ خَادِمْ لِلْمَسِيحْ.<verse eid="GAL 1:10" /></para>
  <para style="s">بُولِسْ رَسُولْ بَعْثُو اللَّهْ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />ونِعْلِمْكُمْ يَا خْوَاتِي الِّي البْشَارَة الِّي بَشَّرْتْكُمْ بِيهَا مَاهِيشْ بْشَارَة مِنْ عَنْدْ البَشَرْ. <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />وآنَا، مَا خْذِيتْهَاشْ ومَا تْعَلَّمْتْهَاشْ مِنْ عَنْدْ إِنْسَانْ، آمَا بْوَحِيْ مِنْ يَسُوعْ المَسِيحْ.<verse eid="GAL 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13" />وإِنْتُومَا سْمَعْتُوا كِيفَاشْ كُنْتْ نِتْصَرِّفْ قْبَلْ،كِي كُنْتْ فِي الدِّينْ اليْهُودِي، وكِيفَاشْ كُنْتْ نَضْطَهِدْ فِي كْنِيسِةْ اللَّهْ بْقُوَّة، ونْحِبْ نْدَمَّرْهَا، <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" />وكِيفَاشْ كُنْتْ مِتْقَدِّمْ عْلَى انْدَادِي فِي الدِّينْ اليْهُودِي، وكُنْتْ نْغِيرْ أَكْثِرْ مِنْهُمْ عْلَى تَقَالِيدْ جْدُودْنَا. <verse eid="GAL 1:14" /><verse number="15" style="v" sid="GAL 1:15" />آمَا اللَّهْ إِخْتَارْنِي وآنَا مَزِّلْتْ فِي كِرْشْ أُمِّي، ودْعَانِي بْنِعْمْتُو بَاشْ نِخْدْمُو. <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />ووَقْتِلِّي ظَهِّرْلِي إِبْنُو بَاشْ نْبَشِّرْ بِيهْ الشُّعُوبْ الِّي مَاهُمْشْ يْهُودْ، مَا شَاوِرْتْ حَتَّى حَدْ. <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />ومَا طْلَعْتِشْ لْأُورْشَلِيمْ بَاشْ نْقَابِلْ الرُّسُلْ الِّي كَانُوا قَبْلِي، آمَا مْشِيتْ طُولْ لِبْلَادْ العْرَبْ، وبَعْدْ رْجَعْتْ لْدِمَشْقْ. <verse eid="GAL 1:17" /><verse number="18" style="v" sid="GAL 1:18" />وبَعْدْ ثْلَاثَة سْنِينْ طْلَعْتْ لْأُورْشَلِيمْ بَاشْ نِتْعَرِّفْ عْلَى بُطْرُسْ، وقْعَدْتْ عَنْدُو 15 يُومْ. <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />آمَا بِخْلَافُو، مَا قَابِلْتْ حَتَّى وَاحِدْ مِالرُّسُلْ، كَانْ يَعْقُوبْ خُو الرَّبْ. <verse eid="GAL 1:19" /><verse number="20" style="v" sid="GAL 1:20" />واللَّهْ يِشْهِدْ الِّي مَا كْذِبْتْ فِي حَتَّى شَيْ مِلِّي كْتِبْتْهُولْكُمْ.<verse eid="GAL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21" />وبَعْدْهَا مْشِيتْ لْمَنْطَقْةْ سُورْيَة ولْمَنْطَقْةْ كِيلِيكِيَّة. <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />آمَا حَتَّى لْوَقْتْهَا، مَا كَانُوشْ المُؤْمْنِينْ بِالمَسِيحْ فِي مَنْطَقْةْ اليَهُودِيَّة يَعْرْفُونِي بِالوِجْهْ. <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />آمَا كَانُوا يِسْمْعُوا عْلِيَّا فِي الكْلَامْ هَاذَا: «الرَّاجِلْ الِّي كَانْ قْبَلْ يِضْطَهِدْ فِينَا، قَاعِدْ تَوَّا يْبَشِّرْ بِالإِيمَانْ الِّي كَانْ يْحِبْ يَقْضِي عْلِيهْ». <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />وكَانُوا يِحْمْدُوا فِي اللَّهْ عْلَى خَاطْرِي.<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s">بُولِسْ رَسُولْ لِلِّي مَاهُمْشْ يْهُودْ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />وبَعْدْ 14 عَامْ، طْلَعْتْ مَرَّة أُخْرَى لْأُورْشَلِيمْ مْعَ بَرْنَابَا، وهَزِّيتْ مْعَايَا تِيطُسْ زَادَا. <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />واللَّهْ هُوَّ الِّي وْحَالِي بَاشْ نِمْشِي. وغَادِي، تْقَابِلْتْ كَانْ مْعَ الإِخْوَة الِّي عَنْدْهُمْ إِعْتِبَارْ وعَرَّفْتْهُمْ بِالبْشَارَة الِّي نْبَشِّرْ بِيهَا الشُّعُوبْ الِّي مَاهُمْشْ يْهُودْ، بَاشْ التْعَبْ الِّي تْعِبْتُو فِي خِدْمْتِي قْبَلْ ولِّي قَاعِدْ نِتْعِبْ فِيهْ تَوَّا، مَا يْكُونِشْ بْلَا فَايْدَة. <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />وحَتَّى مِنْ تِيطُسْ الِّي كَانْ مْعَايَا وهُوَّ يُونَانِي، مَا جَبْرُوهِشْ عَالطْهُورْ، <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />رَغْمِلِّي فَمَّة جْمَاعَة عَامْلِينْ رْوَاحْهُمْ خْوَاتْنَا حَبُّوهْ يِطَّهِّرْ. هَاذُومَا دَخْلُوا بِينَاتْنَا بِالسِّرْقَة بَاشْ يِتْجَسْسُوا عَالحُرِّيَّة الِّي عَنْدْنَا فِي يَسُوعْ المَسِيحْ، يْحِبُّوا يْرَجْعُونَا عَبِيدْ مَرَّة أُخْرَى. <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />آمَا أَحْنَا، وَلَا لَحْظَة إِسْتَسْلِمْنَالْهُمْ وَلَّا تْنَازِلْنَالْهُمْ، بَاشْ تِثْبِتْ عَنْدْكُمْ البْشَارَة الصْحِيحَة.<verse eid="GAL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6" />وبِالنِّسْبَة لِلْإِخْوَة الِّي حَاسْبِينْهُمْ عَنْدْهُمْ إِعْتِبَارْ، وفِي الحْقِيقَة مَرْكَزْهُمْ مُشْ مُهِمْ عَنْدِي، عْلَى خَاطِرْ اللَّهْ مَا يْحَايِلْشْ والكُلْ قُدَّامُو مِتْسَاوِينْ، رَاهُمْ مَا زَادُوا حَتَّى شَيْ عَلِّي نْبَشِّرْ بِيهْ. <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />بِالعَكْسْ، شَافُوا الِّي اللَّهْ أَمَّنِّي عْلَى تَوْصِيلْ البْشَارَة لْغِيرْ اليْهُودْ، كِيمَا أَمَّنْ بُطْرُسْ عْلَى تَبْشِيرْ اليْهُودْ. <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />واللَّهْ الِّي خَلَّا بُطْرُسْ يْوَلِّي رَسُولْ لِلْيْهُودْ، هُوَّ الِّي خَلَّانِي نْوَلِّي رَسُولْ لْغِيرْ اليْهُودْ. <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />يَعْقُوبْ وبُطْرُسْ ويُوحَنَّا، الِّي عَنْدْهُمْ كِلْمِتْهُمْ بِينْ المُؤْمْنِينْ ويَعْتَبْرُوهُمْ سَاسْ الكْنِيسَة، عَرْفُوا الِّي اللَّهْ عْطَانِي النِّعْمَة هَاذِي، وَلَّاوْ حَطُّوا يْدِيهُمْ فِي يْدِينَا آنَا وبَرْنَابَا، أَمَارَة الِّي أَحْنَا مِتْشَارْكِينْ فِي الخِدْمَة: أَحْنَا لْغِيرْ اليْهُودْ، وهُومَا لِلْيْهُودْ. <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />ومَا طَلْبُوا مِنَّا كَانْ بَاشْ نِتْفَكْرُوا الفْقَارَى، وهَاذَا الِّي قَاعِدْ نَعْمِلْ فِيهْ بْكُلْ جِهْدِي.<verse eid="GAL 2:10" /></para>
  <para style="s">بُولِسْ يْعَارِضْ بُطْرُسْ فِي أَنْطَاكْيَة</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />آمَا كِي جَاء بُطْرُسْ لِمْدِينِةْ أَنْطَاكْيَة، عَارِضْتُو فِي وِجْهُو، عْلَى خَاطْرُو كَانْ غَالِطْ. <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />فِي الأُوِّلْ، كَانْ بُطْرُسْ يَاكِلْ مْعَ المُؤْمْنِينْ الِّي مُشْ مِنْ أَصْلْ يْهُودِي. آمَا، كِي جَاوْ جْمَاعَة مِنْ عَنْدْ يَعْقُوبْ، جْبِدْ رُوحُو وبْعِدْ عْلِيهُمْ، عْلَى خَاطْرُو خَافْ مِالنَّاسْ الِّي يْقُولُوا إِنُّو الطْهُورْ لَازِمْ . <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />وتَبْعُوهْ فِي نِفَاقُو المُؤْمْنِينْ الِّي مِنْ أَصْلْ يْهُودِي. حَتَّى مِنْ بَرْنَابَا بْدَا يِتْصَرِّفْ كِيفْهُمْ . <verse eid="GAL 2:13" /><verse number="14" style="v" sid="GAL 2:14" />وكِي شُفْتْ الِّي هُومَا مُشْ قَاعْدِينْ يِتْصَرْفُوا حَسْبْ الحَقْ الِّي فِي البْشَارَة، قُلْتْ لْبُطْرُسْ قُدَّامْ الحَاضْرِينْ الكُلْ: «إِذَا كَانْ إِنْتِ يْهُودِي وتْعِيشْ كِيفْ الِّي مَاهُمْشْ يْهُودْ، كِيفَاشْ تُجْبُرْ الِّي مَاهُمْشْ يْهُودْ بَاشْ يْعِيشُوا كِيفْ اليْهُودْ؟»<verse eid="GAL 2:14" /></para>
  <para style="s">الصَّلَاحْ يْجِي بِالإِيمَانْ</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15" />أَحْنَا مَوْلُودِينْ يْهُودْ، ومَانَاشْ مِالشْعُوبْ الِّي يْقُولُوا عْلِيهُمْ مُذْنْبِينْ. <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" />آمَا عْرَفْنَا الِّي اللَّهْ مَا يَعْتَبِرْشْ الإِنْسَانْ صَالَحْ وَقْتِلِّي يَعْمِلْ فْرَايِضْ الشَّرِيعَة، آمَا وَقْتِلِّي يَمِّنْ بْيَسُوعْ المَسِيحْ. هَاذَاكَا عْلَاشْ، أَحْنَا زَادَا أَمَّنَّا بْيَسُوعْ المَسِيحْ بَاشْ نِتْحِسْبُوا صَالْحِينْ بِالإِيمَانْ بِيهْ، مُشْ بْأَعْمَالْ الشَّرِيعَة الِّي مَا تْرُدْ حَتَّى إِنْسَانْ صَالَحْ.<verse eid="GAL 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 2:17" />آمَا، إِذَا كَانْ نْحِبُّوا اللَّهْ يِحْسِبْنَا صَالْحِينْ عْلَى خَاطِرْ أَمَّنَّا بِالمَسِيحْ، رَغْمِلِّي أَحْنَا فِي الحْقِيقَة مُذْنْبِينْ، يَاخِي هَاذَا مَعْنَاهْ إِنُّو المَسِيحْ يْشَجَّعْ عَالذْنُوبْ؟ حَاشَاهْ! <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />آمَا إِذَا نْعَاوِدْ نِبْنِي الِّي هْدِمْتُو، وَقْتْهَا نِرْجَعْ لِلشَّرِيعَة ونْوَرِّي الِّي آنَا غَالِطْ فِي حَقْهَا. <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />عْلَى خَاطِرْ، بِالشَّرِيعَة آنَا مُتْ بِالنِّسْبَة لِلشَّرِيعَة، بَاشْ انَّجِّمْ نْعِيشْ لِلَّهْ. <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />آنَا مُتْ عَالصَّلِيبْ مْعَ المَسِيحْ، ومَا عَادِشْ آنَا الِّي عَايِشْ، آمَا المَسِيحْ هُوَّ الِّي عَايِشْ فِيَّا. والحَيَاةْ الِّي نْعِيشْهَا تَوَّا، قَاعِدْ نْعِيشْهَا بِالإِيمَانْ بْإِبْنْ اللَّهْ، الِّي حَبْنِي وضَحَّى بَحْيَاتُو عْلَى خَاطْرِي، <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />مَالَا آنَا مَا نَكْفَرْشْ بْنِعْمِةْ اللَّهْ. كَانْ جَاء الإِنْسَانْ يْنَجِّمْ يْوَلِّي صَالَحْ بِالشَّرِيعَة، وَقْتْهَا يْكُونْ المَسِيحْ مَاتْ بْلَا فَايْدَة.<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s">الحْيَاةْ الجْدِيدَة هِيَّ بِالإِيمَانْ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />يَا أَهْلْ غَلَاطْيَة، يَلِّي بْلَا عْقَلْ! شْكُونْ الِّي سْحِرِّلْكُمْ عْقُولْكُمْ بَعْدْمَا وْصِفْنَالْكُمْ كِيفَاشْ تِصْلَبْ يَسُوعْ المَسِيحْ كَايِنُّو صَارْ قُدَّامْ عِينِيكُمْ؟ <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />نْحِبْ نِسْإِلْكُمْ عْلَى حَاجَة وَحْدَة: يَاخِي خْذِيتُوا الرُّوحْ القُدُسْ كِي طَبَّقْتُوا فْرَايِضْ الشَّرِيعَة، وَلَّا عْلَى خَاطِرْكُمْ سْمَعْتُوا البْشَارَة وأَمَّنْتُوا بِيهَا؟ <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />يَاخِي لِلدَّرْجَة هَاذِي إِنْتُومَا بْلَاشْ عْقَلْ؟ بَعْدْمَا كُنْتُوا عْلَى أُوِّلْ إِيمَانْكُمْ تْعَمْلُوا عْلَى رُوحْ اللَّهْ، تْحِبُّوا تَوَّا تْعَمْلُوا عْلَى أَعْمَالْكُمْ؟ <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />يَاخِي الِّي صَارْ عْلِيكُمْ مْشَى بْلَا فَايْدَة؟ وكِيفَاشْ يْنَجِّمْ يْكُونْ بْلَا فَايْدَة؟ <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />زَعْمَة اللَّهْ الِّي يَعْطِيكُمْ الرُّوحْ القُدُسْ، ويَعْمِلْ بِينَاتْكُمْ مُعْجْزَاتْ، يَعْمِلْهَا عْلَى خَاطِرْكُمْ تَعْمْلُوا فْرَايِضْ الشَّرِيعَة، وَلَّا عْلَى خَاطِرْكُمْ تَمْنُوا بِالبْشَارَة؟<verse eid="GAL 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6" />شُوفُوا إِبْرَاهِيمْ: أَمَّنْ بِاللَّهْ، يَاخِي إِيمَانُو تِحْسِبْلُو صَلَاحْ. <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" />مَالَا أَعْرْفُوا الِّي النَّاسْ الِّي يَمْنُوا هُومَا أَوْلَادْ إِبْرَاهِيمْ بِالحَقْ. <verse eid="GAL 3:7" /><verse number="8" style="v" sid="GAL 3:8" />والكْتُبْ المُقَدْسَة تْنَبْإِتْ بِالمْسَبَّقْ الِّي غِيرْ اليْهُودْ بِشْ يِتْحِسْبُوا صَالْحِينْ عَنْدْ اللَّهْ بِالإِيمَانْ. وبَشْرِتْ إِبْرَاهِيمْ بِالمْسَبَّقْ وقَالِتْلُو: «بِشْ تِتْبَارِكْ فِيكْ الشُّعُوبْ الكُلْ».<verse eid="GAL 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GAL 3:9" />مَالَا الِّي يَمْنُوا الكُلْ، يِتْبَارْكُوا مْعَ إِبْرَاهِيمْ المُؤْمِنْ. <verse eid="GAL 3:9" /><verse number="10" style="v" sid="GAL 3:10" />آمَا الِّي مْعَمْلِينْ عْلَى طَاعِتْهُمْ لِلشَّرِيعَة، رَاهُمْ الكُلْهُمْ مَلْعُونِينْ، عْلَى خَاطِرْ مَكْتُوبْ: «مَلْعُونْ كُلْ وَاحِدْ مَا يَعْمِلْشْ دِيمَا بْكُلْ مَا هُوَّ مَكْتُوبْ فِي كْتَابْ الشَّرِيعَة». <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" />وَاضَحْ الِّي الشَّرِيعَة مَا تْرُدْ حَتَّى وَاحِدْ صَالَحْ قُدَّامْ اللَّهْ، عْلَى خَاطِرْ الكْتُبْ المُقَدْسَة تْقُولْ: «الصَّالَحْ يَحْيَا بِالإِيمَانْ». <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" />آمَا الشَّرِيعَة مَاهِيشْ مِبْنِيَّة عَالإِيمَانْ. بِالعَكْسْ، مَكْتُوبْ: «الِّي يْطَبَّقْ وْصَايَا الشَّرِيعَة الكُلْ يَحْيَا بِيهَا».<verse eid="GAL 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13" />آمَا المَسِيحْ حَرَّرْنَا مِنْ لَعْنِةْ الشَّرِيعَة وَقْتِلِّي فْدَانَا، وخْذَا هُوَّ اللَّعْنَة فِي بْلَاصِتْنَا، عْلَى خَاطِرْ مَكْتُوبْ فِي الكْتُبْ المُقَدْسَة: «مَلْعُونْ كُلْ وَاحِدْ يِتْصْلَبْ عْلَى خَشْبَة». <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />المَسِيحْ عْمَلْ هَاذَا بَاشْ عْلَى طْرِيقُو هُوَّ تُوصِلْ بَرْكِةْ إِبْرَاهِيمْ لِلنَّاسْ الِّي مَاهُمْشْ يْهُودْ. وهَكَّا نَاخْذُوا، بِالإِيمَانْ، الرُّوحْ القُدُسْ الِّي وْعِدْنَا بِيهْ اللَّهْ.<verse eid="GAL 3:14" /></para>
  <para style="s">الوَعْدْ والبَرْكَة هُومَا بِالإِيمَانْ</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />يَا خْوَاتِي، نَعْطِيكُمْ مِثَالْ مِنْ حْيَاتْنَا العَادِيَّة: وَقْتِلِّي وَاحِدْ يَعْمِلْ عَهْدْ، حَتَّى حَدْ آخَرْ مَا يْنَجِّمْ يِلْغِيهْ وَلَّا يْزِيدْ عْلِيهْ. <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />واللَّهْ عْطَى الوُعُودْ لْإِبْرَاهِيمْ ولْنَسْلُو. ومَا قَالِشْ «نَسْلُو» بِالجَمْعْ، كَايِنُّو يُقْصُدْ فِي بَرْشَة نَاسْ، آمَا يُقْصُدْ فِي وَاحِدْ بَرْكْ، الِّي هُوَّ المَسِيحْ. <verse eid="GAL 3:16" /><verse number="17" style="v" sid="GAL 3:17" />الِّي نْحِبْ نْقُولُو هُوَّ إِنُّو اللَّهْ عْمَلْ عَهْدْ ثَابِتْ مْعَ إِبْرَاهِيمْ، والشَّرِيعَة الِّي جَاتْ بَعْدُو بْـ430 سْنَة، مَا تْنَجَّمْشْ تِلْغِي العَهْدْ هَاذَاكَا، وتْبَطِّلْ الوَعْدْ. <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" />وكَانْ البَرْكَة تْجِي عْلَى طْرِيقْ الشَّرِيعَة، يْوَلِّي الوَعْدْ مَاهُوشْ لَازِمْ. آمَا فِي الحْقِيقَة اللَّهْ نْعِمْ بِالبَرْكَة عْلَى إِبْرَاهِيمْ، بِالوَعْدْ.<verse eid="GAL 3:18" /></para>
  <para style="s">عْلَاشْ جَاتْ الشَّرِيعَة؟</para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19" />مَالَا عْلَاشْ جَاتْ الشَّرِيعَة؟ هِيَّ تْزَادِتْ بَاشْ تْظَهِّرْ الذْنُوبْ حَتَّى لِينْ يْجِي «النَّسْلْ» الِّي الوَعْدْ يْخُصُّو. والشَّرِيعَة هَاذِي بَلْغِتْهَا المْلَايْكَة عْلَى طْرِيقْ وَسِيطْ. <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />ومَادَامْ فَمَّة وَسِيطْ يَعْنِي فَمَّة أَكْثِرْ مِنْ وَاحِدْ، آمَا اللَّهْ الِّي عْطَى الوَعْدْ هُوَّ وَاحِدْ.<verse eid="GAL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21" />زَعْمَة الشَّرِيعَة ضِدْ وُعُودْ اللَّهْ؟ أَبَدًا! آمَا كَانْ جَاتْ الشَّرِيعَة قَادْرَة بَاشْ تَعْطِي الحَيَاةْ، رَاهُو اللَّهْ يَعْتَبِرْنَا صَالْحِينْ كِي نْطَبْقُوهَا. <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />آمَا الكْتُبْ المُقَدْسَة بَيْنِتْ الِّي النَّاسْ الكُلْ مَحْبُوسِينْ فِي ذْنُوبْهُمْ، بْقَصْدْ إِنُّو اللَّهْ يَعْطِي الوَعْدْ الِّي مَا يْجِي كَانْ عْلَى طْرِيقْ الإِيمَانْ بْيَسُوعْ المَسِيحْ، لِلِّي يَمْنُوا بِيهْ.<verse eid="GAL 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23" />قْبَلْ مَا يْجِي الإِيمَانْ هَاذَا، كُنَّا مَرْبُوطِينْ بِالشَّرِيعَة، حَتَّى لِينْ اللَّهْ يْظَهِّرْ الإِيمَانْ الِّي تْكَلَّمْ عْلِيهْ. <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />مَالَا الشَّرِيعَة كَانِتْ هِيَّ الِّي تْرَبِّي فِينَا حَتَّى لِينْ يْجِي المَسِيحْ، بَاشْ نْوَلِّيوْ صَالْحِينْ بِالإِيمَانْ. <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />آمَا بَعْدْمَا جَاء الإِيمَانْ، تْحَرَّرْنَا مِنْ سُلْطِةْ الِّي يْرَبِّي فِينَا.<verse eid="GAL 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26" />وإِنْتُومَا الكُلْ وْلَادْ اللَّهْ عْلَى طْرِيقْ إِيمَانْكُمْ بْيَسُوعْ المَسِيحْ. <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />عْلَى خَاطِرْ إِنْتُومَا الكُلْ الِّي تْعَمَّدْتُوا، مَعْنَاهَا وَلِّيتُوا وَاحِدْ مْعَ المَسِيحْ، رَاكُمْ وَلِّيتُوا تْشَبْهُولُو. <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />وتَوَّا، مَا عَادِشْ فَمَّة فَرْقْ بِينْ يْهُودِي ومُشْ يْهُودِي، عَبْدْ وَلَّا حُرْ، ذْكَرْ وَلَّا أَنْثَى عْلَى خَاطِرْ الكُلْكُمْ وَاحِدْ فِي يَسُوعْ المَسِيحْ. <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" />وإِذَا إِنْتُومَا تَابْعِينْ لِلْمَسِيحْ، مَالَا إِنْتُومَا نَسْلْ إِبْرَاهِيمْ ووَارْثِينْ البَرْكَة مْعَاهْ، كِيمَا وْعِدْ اللَّهْ.<verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="s">أَحْنَا وْلَادْ اللَّهْ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />الِّي نْحِبْ نْقُولُو هُوَّ، مَادَامْ الوَارِثْ قَاصِرْ، مَا فَمَّة حَتَّى فَرْقْ بِينُو وبِينْ العَبْدْ، رَغْمِلِّي هُوَّ مُولَى الوَرْثَة الكُلْ. <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />آمَا يْكُونْ تَحْتْ وْصَايِةْ نَاسْ يِتْصَرْفُولُو فِي مِلْكُو حَتَّى لِينْ يْجِي الوَقْتْ الِّي حَطُّو بُوهْ. <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />وأَحْنَا زَادَا: وَقْتِلِّي كُنَّا قَاصْرِينْ رُوحِيًّا، كُنَّا عَبِيدْ لْقَوَانِينْ الدِّنْيَا هَاذِي، <verse eid="GAL 4:3" /><verse number="4" style="v" sid="GAL 4:4" />آمَا كِي جَاء الوَقْتْ الْمُحَدِّدْ، بْعَثْ اللَّهْ إِبْنُو، مَوْلُودْ مِنْ مْرَا، وكَانْ خَاضَعْ لِلشَّرِيعَة، <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" />بَاشْ يِفْدِي النَّاسْ الِّي تَحْتْ حُكْمْ الشَّرِيعَة، وهَكَّا نْوَلِّيوْ وْلَادْ اللَّهْ.<verse eid="GAL 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 4:6" />وعْلَى خَاطِرْكُمْ وْلَادْ اللَّهْ، بْعَثْ رُوحْ إِبْنُو فِي قْلُوبْنَا يْنَادِي: «بَابَا! يَا بُونَا!». <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />مَالَا إِنْتِ مَا عَادِشْ عَبْدْ، إِنْتِ وِلْدُو. وعْلَى خَاطْرِكْ وِلْدُو، إِنْتِ وَلِّيتْ وَارِثْ لْبَرَكَاتُو.<verse eid="GAL 4:7" /></para>
  <para style="s">بُولِسْ مِتْحَيَّرْ عْلَى مُؤْمْنِينْ غَلَاطْيَة</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />قْبَلْ، كِي كُنْتُوا مَا تَعْرْفُوشْ اللَّهْ، كُنْتُوا عَبِيدْ لْآلْهَة مَاهُمْشْ آلْهَة بِالحَقْ. <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />آمَا تَوَّا كِي عْرَفْتُوا اللَّهْ، والأَصَحْ إِنُّو اللَّهْ هُوَّ الِّي عْرَفْكُمْ، كِيفَاشْ تِرْجْعُوا لْقَوَانِينْ العَالِمْ الِّي مَا عَنْدْهَاشْ قِيمَة ومَا تِنْفَعْشْ، وتْحِبُّوا تْوَلِّيوْ عَبِيدْ لِيهَا مَرَّة أُخْرَى؟ <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />وتِرْجْعُوا تِحْتَفْلُوا بْأَيَّامْ ومْوَاسِمْ وأُشْهْرَة وأَعْوَامْ. <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />خَايِفْ عْلِيكُمْ لَا يْكُونْ تَعْبِي مْعَاكُمْ مْشَى خْسَارَة.<verse eid="GAL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12" />يَا خْوَاتِي، نِتْرَجَّاكُمْ بَاشْ تْوَلِّيوْ كِيفِي، عْلَى خَاطِرْنِي آنَا زَادَا وَلِّيتْ كِيفْكُمْ. إِنْتُومَا مَا ظْلَمْتُونِيشْ بِالكُلْ، <verse eid="GAL 4:12" /><verse number="13" style="v" sid="GAL 4:13" />بِالعَكْسْ إِنْتُومَا تَعْرْفُوا الِّي بِسْبَبْ مَرْضْتِي جَاتْنِي الفُرْصَة بَاشْ نْبَشَّرْكُمْ أَوِّلْ مَرَّة. <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />ورَغْمِلِّي حَالْتِي هَاذِي كَانِتْ تْعَبْ لِيكُمْ، مَا حْقَرْتُونِيشْ ومَا نْفَرْتُوشْ مِنِّي، آمَا قْبِلْتُونِي كَايِنِّي مَلَاكْ مِنْ عَنْدْ اللَّهْ وَلَّا كَايِنِّي يَسُوعْ المَسِيحْ نَفْسُو. <verse eid="GAL 4:14" /><verse number="15" style="v" sid="GAL 4:15" />مَالَا وِينِي الفَرْحَة الِّي كَانِتْ عَنْدْكُمْ؟ آنَا نِشْهْدِلْكُمْ الِّي كَانْ جِيتُوا تْنَجْمُوا، رَاكُمْ قَلَّعْتُوا عِينِيكُمْ وعْطِيتُوهُمْلِي. <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />يَاخِي تَوَّا وَلِّيتْ عْدُوكُمْ عْلَى خَاطِرْنِي قُلْتِلْكُمْ الحَقْ؟<verse eid="GAL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17" />النَّاسْ الِّي يْغِيرُوا عْلِيكُمْ، مَاهُمْشْ عْلَى حُسْنْ نِيَّة. هُومَا يْحِبُّوا يْبَعْدُوكُمْ عْلِينَا بَاشْ تْوَلِّيوْ فِي صَفْهُمْ. <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />بَاهِي كِي يْغِيرُوا عْلِيكُمْ، آمَا الغِيرَة تْكُونْ صَادْقَة، وفِي كُلْ وَقْتْ، مُشْ كَانْ وَقْتِلِّي نْكُونْ مَوْجُودْ مْعَاكُمْ. <verse eid="GAL 4:18" /><verse number="19" style="v" sid="GAL 4:19" />يَا وْلَادِي، رَانِي نِتْوَجَّعْ بِيكُمْ مَرَّة أُخْرَى، كِالمْرَا الِّي بِشْ تُولِدْ، حَتَّى لِينْ تِتْكَوِّنْ فِيكُمْ صِفَاتْ المَسِيحْ. <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />وتْمَنِّيتْ لَوْ كُنْتْ مَوْجُودْ بِينَاتْكُمْ تَوَّا، رَانِي بَدَّلْتْ طَرِيقِةْ كْلَامِي، خَاطِرْنِي حِرْتْ كِيفَاشْ نِتْصَرِّفْ مْعَاكُمْ.<verse eid="GAL 4:20" /></para>
  <para style="s">مِثَالْ هَاجِرْ وسَارَّة</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />قُولُولِي يَلِّي تْحِبُّوا تِرْجْعُوا تَحْتْ سُلْطِةْ الشَّرِيعَة: يَاخِي مَا سْمَعْتُوشْ آشْ جَاء فِي الشَّرِيعَة؟ <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />مَكْتُوبْ: إِبْرَاهِيمْ كَانْ عَنْدُو زُوزْ وْلَادْ، وَاحِدْ مِالجَارْيَة والآخِرْ مِالمْرَا الحُرَّة. <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />وِلْدْ الجَارْيَة تُولِدّْ بْطَرِيقَة طَبِيعِيَّة، آمَا وِلْدْ الحُرَّة تُولِدّْ حَسْبْ وَعْدْ اللَّهْ. <verse eid="GAL 4:23" /><verse number="24" style="v" sid="GAL 4:24" />وهَاذَا الكُلْ عَنْدُو مَعْنَى رَمْزِي. الزُّوزْ نْسَاء هَاذُومَا يُرْمْزُوا لْزُوزْ عْهُودْ. الأُوِّلْ تَعْمَلْ فِي جْبَلْ سِينَاءْ، وأَوْلَادْ العَهْدْ هَاذَا يْكُونُوا عَبِيدْ. هَاذَا تُرْمُزْلُو هَاجِرْ، <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />وهَاجِرْ تْمَثِّلْ جْبَلْ سِينَاءْ فِي بْلَادْ العْرَبْ، وتُرْمُزْ لْأُورْشَلِيمْ المَوْجُودَة تَوَّا، الِّي هِيَّ ووْلَادْهَا عَبِيدْ. <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />آمَا العَهْدْ الثَّانِي تْمَثْلُو المْرَا الحُرَّة، وتُرْمُزْ لْأُورْشَلِيمْ السْمَاوِيَّة الِّي هِيَّ أُمْنَا. <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />كِيمَا مَكْتُوبْ:</para>
  <para style="b" vid="GAL 4:27" />
  <para style="q1" vid="GAL 4:27">«إِفْرَحْ يَلِّي مَا تَضْنَاشْ ومَا تُولِدْشْ،</para>
  <para style="q2" vid="GAL 4:27">عَيِّطْ بْأَعْلَى صُوتِكْ يَلِّي مَا جَرَّبْتِشْ وْجَايَعْ الوْلَادَة،</para>
  <para style="q1" vid="GAL 4:27">رَاهُمْ وْلَادْ الِّي رَاجِلْهَا هْجَرْهَا</para>
  <para style="q2" vid="GAL 4:27">أَكْثِرْ مِنْ وْلَادْ الِّي رَاجِلْهَا مْعَاهَا!».<verse eid="GAL 4:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28" />آمَا إِنْتُومَا يَا خْوَاتِي رَاكُمْ وْلَادْ الوَعْدْ كِيمَا إِسْحَاقْ. <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />ولِّي صَارْ قْبَلْ هُوَّ نَفْسُو الِّي قَاعِدْ يْصِيرْ تَوَّا: المَوْلُودْ بِالطَّرِيقَة الطَّبِيعِيَّة يَضْطَهِدْ فِي المَوْلُودْ بْقُوِّةْ رُوحْ اللَّهْ. <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />آمَا آشْ تْقُولْ الكْتُبْ المُقَدْسَة؟ «طَرِّدْ الجَارْيَة ووِلْدْهَا، عْلَى خَاطِرْ وِلْدْ الجَارْيَة مَا يُورِثْشْ مْعَ وِلْدْ الحُرَّة». <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />مَالَا يَا خْوَاتِي، أَحْنَا مَانَاشْ وْلَادْ الجَارْيَة، آمَا وْلَادْ الحُرَّة.<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="s">المَسِيحْ حَرَّرْنَا والطْهُورْ مَا يِنْفَعْ لْشَيْ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />المَسِيحْ حَرَّرْنَا بَاشْ نْكُونُوا أَحْرَارْ، مَالَا إِثْبْتُوا فِي الحُرِّيَّة هَاذِي، ومَا تِرْجْعُوشْ تْعِيشُوا كِيفْ العْبِيدْ. <verse eid="GAL 5:1" /><verse number="2" style="v" sid="GAL 5:2" />آنَا بُولِسْ نْقُولِلْكُمْ: إِذَا إِطَّهْرُوا، رَاهُو المَسِيحْ مَا يِنْفَعْكُمْ فِي حَتَّى شَيْ. <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />ونْذَكَّرْ مَرَّة أُخْرَى الِّي كُلْ وَاحِدْ مْطَهَّرْ هُوَّ مَلْزُومْ بَاشْ يْطِيعْ الشَّرِيعَة الكُلْ. <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />وإِنْتُومَا يَلِّي تْحِبُّوا تْكُونُوا صَالْحِينْ عْلَى طْرِيقْ الشَّرِيعَة، رَاكُمْ تَخْسْرُوا المَسِيحْ وتِتْحِرْمُوا مِالنِّعْمَة. <verse eid="GAL 5:4" /><verse number="5" style="v" sid="GAL 5:5" />آمَا أَحْنَا بْقُوِّةْ الرُّوحْ نِسْتَنَّاوْ بْثِيقَة بَاشْ نْوَلِّيوْ صَالْحِينْ قُدَّامْ اللَّهْ بِالإِيمَانْ، وهَاذَا هُوَّ رْجَانَا. <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />عْلَى خَاطِرْ الِّي تَبْعُوا يَسُوعْ المَسِيحْ، لَا عَادْ يْهِمْهُمْ لَا طْهُورْ ولَا غِيرْ طْهُورْ. المُهِمْ هُوَّ الإِيمَانْ الِّي يُظْهُرْ فِي المْحَبَّة.<verse eid="GAL 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7" />كُنْتُوا مِتْقَدْمِينْ بِالڨْدَا فِي سِبَاقْ الإِيمَانْ، شْكُونْ عَطَّلْكُمْ عْلَى طَاعِةْ الحَقْ؟ <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />التَّعْطِيلْ هَاذَا مُشْ مِنْ عَنْدْ اللَّهْ الِّي دْعَاكُمْ. <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" />رَاهِي شْوَيَّة خْمِيرَة كَافْيَة بَاشْ تْخَمِّرْ العْجِينَة الكُلْ. <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />وآنَا عَنْدِي ثِيقَة مِنْ عَنْدْ الرَّبْ الِّي إِنْتُومَا مُشْ بِشْ تِقْبْلُوا بْرَايْ آخَرْ. ولِّي قَاعِدْ يْغَلِّطْ فِيكُمْ بِشْ يِتْعَاقِبْ مَهْمَا كَانِتْ صِيفْتُو.<verse eid="GAL 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11" />آمَا آنَا يَا خْوَاتِي، كَانْ جِيتْ مَزِّلْتْ نْشَجَّعْ عَالطْهُورْ، مَالَا عْلَاشْ مَزَّالُوا اليْهُودْ يِضْطَهْدُوا فِيَّا لْتَوَّا؟ مُشْ رَاهُو الصَّلِيبْ مَا عَادِشْ يْكُونِلْهُمْ عَثْرَة؟ <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />يَا رِيتْ الِّي يْغَلْطُوا فِيكُمْ مُشْ يِطَّهْرُوا بَرْكَا آمَا يْكَمْلُوا يَخْصِيوْ رْوَاحْهُمْ!<verse eid="GAL 5:12" /></para>
  <para style="s">خَلِّي الرُّوحْ يْقُودْكُمْ</para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13" />يَا خْوَاتِي، اللَّهْ دْعَاكُمْ بَاشْ تْكُونُوا أَحْرَارْ، آمَا مَا تِسْتْغَلُّوشْ الحُرِّيَّة هَاذِي بَاشْ تَعْمْلُوا شْهَاوِيكُمْ، بِالعَكْسْ، إِخْدْمُوا بْعَضْكُمْ بِمْحَبَّة. <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />رَاهِي الشَّرِيعَة الكُلْ تِتْلَخَّصْ فِي وْصِيَّة وَحْدَة: «حِبْ قْرِيبِكْ كِيفْ مَا تْحِبْ رُوحِكْ». <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />آمَا كَانْكُمْ تَاكْلُوا وتِنْهْشُوا كُلْ وَاحِدْ فِي الآخِرْ، مَالَا رُدُّوا بَالْكُمْ لَا تِفْنِيوْ بْعَضْكُمْ.<verse eid="GAL 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />الِّي نْحِبْ نْقُولُو هُوَّ: خَلِّي الرُّوحْ يْقُودْكُمْ، وهَكَّا مَا تَعْمْلُوشْ شْهَاوِي الطْبِيعَة البَشَرِيَّة الفَاسْدَة. <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" />رَاهُو الطْبِيعَة البَشَرِيَّة الفَاسْدَة تِشْتْهِي عَكْسْ الرُّوحْ، والرُّوحْ عَكْسْ الطْبِيعَة البَشَرِيَّة الفَاسْدَة، وكُلْ وَاحِدْ مِنْهُمْ يْجِي ضِدْ الآخِرْ، حَتَّى لِينْ مَا تَعْمْلُوشْ الِّي تْحِبُّوا تَعْمْلُوهْ. <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />آمَا كَانْ تْخَلِّيْو الرُّوحْ يْقُودْكُمْ، رَاكُمْ مَا عَادِشْ تَحْتْ سُلْطِةْ الشَّرِيعَة.<verse eid="GAL 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19" />وأَعْمَالْ الطْبِيعَة البَشَرِيَّة الفَاسْدَة ظَاهْرَة: الِّي هِيَّ الزْنَى والنْجَاسَة والفْسَادْ <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />وعْبَادِةْ الصْنَبْ والسِّحْرْ والعْدَاوَة والعَرْكْ والغِيرَة والغُشْ والتَّحَزُّبْ والإِنْقِسَامْ والتَّعَصُّبْ، <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />والحُسْدْ والسِّكْرَة وسَهْرِيَّاتْ الفْسَادْ وكُلْ مَا تَابَعْهُمْ. انَّبَّهْكُمْ تَوَّا كِيفْ مَا نَبَّهْتْكُمْ قْبَلْ: الِّي يَعْمْلُوا الحَاجَاتْ هَاذِي، مَاهُمْشْ بِشْ يُورْثُوا مَمْلَكْةْ اللَّهْ.<verse eid="GAL 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22" />آمَا ثَمْرِةْ الرُّوحْ هِيَّ: المْحَبَّة، الفَرْحَة، السَّلَامْ، وِسْعْ البَالْ، السْيَاسَة، الطِّيبَة والأَمَانَة، <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />والحَنَانْ والتَّحَكُّمْ فِي النَّفْسْ. ومَا فَمَّة حَتَّى قَانُونْ يِمْنَعْ الحَاجَاتْ هَاذِي. <verse eid="GAL 5:23" /><verse number="24" style="v" sid="GAL 5:24" />ولِّي وَلَّاوْ تَابْعِينْ لِلْمَسِيحْ، صَلْبُوا الطْبِيعَة البَشَرِيَّة الفَاسْدَة بْرَغْبَاتْهَا وشْهَاوِيهَا. <verse eid="GAL 5:24" /><verse number="25" style="v" sid="GAL 5:25" />ومَادَامْ وَلِّينَا حَيِّينْ بِالرُّوحْ، يِلْزِمْنَا نْخَلِّيوْ الرُّوحْ يْقُودْنَا، <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />ومَا نِتْفُوخْرُوشْ، ومَا نِسْتْفَزُّوشْ ومَا نِحْسْدُوشْ بْعَضْنَا.<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="s">هِزُّوا أَحْمَالْ بْعَضْكُمْ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />يَا خْوَاتِي، إِذَا كَانْ فِقْتُوا بْوَاحِدْ مِنْكُمْ عْمَلْ غَلْطَة، لَازِمْ إِنْتُومَا الِّي عَايْشِينْ حَسْبْ الرُّوحْ تْرَجْعُوهْ بِالسْيَاسَة. وإِنْتِ زَادَا، رُدْ بَالِكْ عْلَى رُوحِكْ لَا تُغْلُطْ. <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />هِزُّوا أَحْمَالْ بْعَضْكُمْ، وهَكَّا إِطَّبْقُوا شَرِيعِةْ المَسِيحْ. <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />ولِّي يِسْخَايِبْ رُوحُو حَاجَة كْبِيرَة، وهُوَّ فِي الحْقِيقَة حَتَّى شَيْ، رَاهُو قَاعِدْ يْغُشْ فِي رُوحُو. <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />لَازِمْ كُلْ وَاحِدْ يْثَبِّتْ فِي أَعْمَالُو، ووَقْتْهَا يْنَجِّمْ يِتْفُوخِرْ بِلِّي عَمْلُو هُوَّ مُشْ بِلِّي عَمْلُو غِيرُو. <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />عْلَى خَاطِرْ كُلْ وَاحِدْ بِشْ يْهِزْ الحْمِلْ مْتَاعُو.<verse eid="GAL 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6" />الِّي يِتْعَلَّمْ فِي كِلْمِةْ اللَّهْ، لَازْمُو يْشَارِكْ الخِيرَاتْ الِّي عَنْدُو مْعَ الِّي عَلَّمْهَالُو. <verse eid="GAL 6:6" /><verse number="7" style="v" sid="GAL 6:7" />مَا تِتْخَدْعُوشْ: اللَّهْ مَا يْنَجِّمْ يْعَدِّيهَا عْلِيهْ حَتَّى حَدْ، رَاهُو الِّي يَزْرْعُو الإِنْسَانْ بِشْ يَحْصْدُو. <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />الِّي يَزْرَعْ بَاشْ يْرَضِّي طْبِيعْتُو البَشَرِيَّة الفَاسْدَة، بِشْ يَحْصِدْ مِنْهَا الفْسَادْ. ولِّي يَزْرَعْ بَاشْ يْرَضِّي الرُّوحْ، بِشْ يَحْصِدْ مِالرُّوحْ الحَيَاةْ الأَبَدِيَّة. <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />مَالَا، خَلِّينَا مَا نْمِلُّوشْ مِنْ فِعْلْ الخِيرْ، عْلَى خَاطِرْ بِشْ نَحْصْدُوا فِي الوَقْتْ المُنَاسِبْ إِذَا كَانْ مَا نْسَلْمُوشْ. <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />ومَادَامْ عَنْدْنَا الفُرْصَة، خَلِّينَا نَعْمْلُوا الخِيرْ لِلنَّاسْ الكُلْ، وبِالأَخَصْ لِخْوَاتْنَا فِي الإِيمَانْ.<verse eid="GAL 6:10" /></para>
  <para style="s">بُولِسْ يْحَذَّرْهُمْ ويْوَدَّعْهُمْ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />شُوفُوا مَا اكْبِرْهَا الحْرُوفْ الِّي كْتِبْتْهَالْكُمْ بِيدِي! <verse eid="GAL 6:11" /><verse number="12" style="v" sid="GAL 6:12" />الِّي يْلَزْمُوا عْلِيكُمْ الطْهُورْ، يْحِبُّوا يُظْهْرُوا بْمَظْهِرْ بَاهِي قُدَّامْ النَّاسْ، بَاشْ مَا يِضْطَهْدُوهُمْشْ بِسْبَبْ صَلِيبْ المَسِيحْ. <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />حَتَّى الِّي اطَّهْرُوا هُومَا بِيدْهُمْ مَا يَعْمْلُوشْ بِالشَّرِيعَة، آمَا يْحِبُّوكُمْ إِنْتُومَا تِتْطَهْرُوا بِشْ يِتْفُوخْرُوا الِّي هُومَا خَلَّاوْكُمْ تِتْطَهْرُوا. <verse eid="GAL 6:13" /><verse number="14" style="v" sid="GAL 6:14" />آمَا آنَا، مَا نِتْفَخِّرْ كَانْ بْصَلِيبْ رَبْنَا يَسُوعْ المَسِيحْ. بِالصَّلِيبْ وَلَّاتْ أُمُورْ الدِّنْيَا هَاذِي مِيْتَة ومَا عَادِشْ مُهِمَّة بِالنِّسْبَة لِيَّا، وآنَا وَلِّيتْ مِيِّتْ بِالنِّسْبَة لِلدِّنْيَا هَاذِي وأُمُورْهَا.<verse eid="GAL 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 6:15" />مُشْ مُهِمْ يْكُونْ الإِنْسَانْ مْطَهِّرْ وَلَّا لَا، آمَا المُهِمْ إِنُّو يْوَلِّي إِنْسَانْ جْدِيدْ. <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />السَّلَامْ والرَّحْمَة لِلنَّاسْ الكُلْ الِّي يْعِيشُوا بِالمَبْدَأْ هَاذَا، ولِّي هُومَا شَعْبْ اللَّهْ بِالحَقْ ولِّي يِتْسَمَّاوْ إِسْرَائِيلْ اللَّهْ.<verse eid="GAL 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17" />مَالَا، مِاليُومْ، مَا عَادْ نْحِبْ حَتَّى حَدْ يْزِيدْ عْلِيَّا تْعَبْ، عْلَى خَاطِرْ الجْرُوحْ الِّي فِي بَدْنِّي تْبَيِّنْ الِّي آنَا تَابَعْ لِلرَّبْ يَسُوعْ.<verse eid="GAL 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18" />يَا خْوَاتِي، نِعْمِةْ رَبْنَا يَسُوعْ المَسِيحْ تْكُونْ مْعَاكُمْ. آمِينْ!<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>