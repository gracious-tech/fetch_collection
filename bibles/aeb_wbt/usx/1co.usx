<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id" />
  <para style="h">كُورِنْثُوسْ الأُولَى</para>
  <para style="toc1">رِسَالِةْ بُولِسْ الأُولَى لِلْمُؤْمْنِينْ الِّي فِي كُورِنْثُوسْ</para>
  <para style="toc2">كُورِنْثُوسْ الأُولَى</para>
  <para style="toc3">كُورِنْثُوسْ الأُولَى</para>
  <para style="mt">رِسَالِةْ بُولِسْ الأُولَى لِلْمُؤْمْنِينْ الِّي فِي كُورِنْثُوسْ</para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />مِنْ عَنْدْ بُولِسْ الِّي دْعَاهْ اللَّهْ بَاشْ يْكُونْ رَسُولْ يَسُوعْ المَسِيحْ، ومِنْ عَنْدْ خُونَا سُوسْتَانِيسْ، <verse eid="1CO 1:1" /><verse number="2" style="v" sid="1CO 1:2" />لِكْنِيسِةْ اللَّهْ فِي كُورِنْثُوسْ، لِلِّي اخْتَارْهُمْ اللَّهْ فِي يَسُوعْ المَسِيحْ ودْعَاهُمْ بَاشْ يْكُونُوا قِدِّيسِينْ، ولِلنَّاسْ الِّي فِي كُلْ بْلَاصَة يْنَادِيوْ بْإِسْمْ رَبْنَا يَسُوعْ المَسِيحْ، الِّي هُوَّ رَبْهُمْ كِيمَا هُوَّ رَبْنَا.<verse eid="1CO 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3" />السَّلَامْ والنِّعْمَة لِيكُمْ مِنْ عَنْدْ اللَّهْ بُونَا والرَّبْ يَسُوعْ المَسِيحْ.<verse eid="1CO 1:3" /></para>
  <para style="s">الشُّكْرْ عَالنِّعْمَة الِّي عْطَاهَالْكُمْ اللَّهْ</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />نُشْكُرْ اللَّهْ دِيمَا عْلَى خَاطِرْكُمْ وعَالنِّعْمَة الِّي عْطَاهَالْكُمْ فِي يَسُوعْ المَسِيحْ، <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />الِّي بِيهْ وَلِّيتُوا غْنِيِّينْ فِي كُلْ شَيْ، فِي كُلْ كْلَامْ وْكُلْ مَعْرْفَة، <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />عْلَى خَاطِرْ شْهَادِتْنَا عَالمَسِيحْ ثِبْتِتْ فِيكُمْ، <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />ومَا عَادِشْ نَاقْصِتْكُمْ حَتَّى هِيبَة مِالهِيبَاتْ، وإِنْتُومَا تِسْتَنَّاوْ فِي رْجُوعْ رَبْنَا يَسُوعْ المَسِيحْ. <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />هُوَّ الِّي بِشْ يْثَبِّتْكُمْ حَتَّى لِلِّخِّرْ، بَاشْ مَا يْكُونِشْ عْلِيكُمْ لُومْ نْهَارِةْ الِّي يِرْجَعْ، <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />عْلَى خَاطِرْ اللَّهْ أَمِينْ، وهُوَّ الِّي دْعَاكُمْ بَاشْ تْكُونُوا مِتْشَارْكِينْ مْعَ إِبْنُو يَسُوعْ المَسِيحْ رَبْنَا.<verse eid="1CO 1:9" /></para>
  <para style="s">كُونُوا مِتَّفْقِينْ مُشْ مُتْخَالْفِينْ</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />نُطْلِبْ مِنْكُمْ يَا خْوَاتِي، بْإِسْمْ رَبْنَا يَسُوعْ المَسِيحْ، بَاشْ تْكُونُوا الكُلْ مِتَّفْقِينْ، مُشْ مِتْخَالْفِينْ، آمَا كُونُوا مِتَّحْدِينْ فِي رَايْ وَاحِدْ وفِكْرْ وَاحِدْ. <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />عْلَى خَاطِرْ، يَا خْوَاتِي، وْصِلْنِي مِنْ عَايِلْةْ خُلُوِي الِّي فَمَّة مَشَاكِلْ بِينَاتْكُمْ. <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" />نُقْصُدْ الِّي وَاحِدْ يْقُولْ: «آنَا مْعَ بُولِسْ» والآخِرْ: «آنَا مْعَ أَبُلُّوسْ» وَلَّا «آنَا مْعَ بُطْرُسْ» وَلَّا «آنَا مْعَ المَسِيحْ». <verse eid="1CO 1:12" /><verse number="13" style="v" sid="1CO 1:13" />يَاخِي المَسِيحْ تِقْسِمّْ؟ وَلَّا بُولِسْ هُوَّ الِّي تِصْلَبْ عْلَى خَاطِرْكُمْ؟ وَلَّا تْعَمَّدْتُوا بْإِسْمْ بُولِسْ؟<verse eid="1CO 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 1:14" />نُشْكُرْ اللَّهْ الِّي مَا عَمَّدْتْ حَتَّى وَاحِدْ مِنْكُمْ كَانْ كْرِيسْبُسْ وغَايُوسْ، <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />بَاشْ حَتَّى حَدْ مَا يْقُولْ الِّي إِنْتُومَا تْعَمَّدْتُوا بْإِسْمِي. <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" />وعَمَّدْتْ زَادَا عَايِلْةْ إِسْتِفَانَاسْ. بِخْلَافْ هَاذُومَا مَا نِتْذَكَّرْشْ رُوحِي عَمَّدْتْ وَاحِدْ آخِرْ. <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />عْلَى خَاطِرْ المَسِيحْ مَا بْعَثْنِيشْ بَاشْ نْعَمَّدْ، آمَا بْعَثْنِي بَاشْ نْبَشِّرْ مِنْ غِيرْ مَا نْعَمِّلْ عْلَى كْلَامْ حِكْمِةْ البَشَرْ، بَاشْ تَضْحِيةْ المَسِيحْ عَالصَّلِيبْ مَا تْضَيَّعْشْ قُوِّتْهَا.<verse eid="1CO 1:17" /></para>
  <para style="s">بْشَارِةْ الصَّلِيبْ هِيَّ قُوِّةْ اللَّهْ</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />والبْشَارَة بِالصَّلِيبْ عَنْدْ النَّاسْ المَاشِينْ لِلهْلَاكْ، هْبَالْ. آمَا عَنْدْنَا أَحْنَا الِّي نْجِينَا، هِيَّ قُوِّةْ اللَّهْ، <verse eid="1CO 1:18" /><verse number="19" style="v" sid="1CO 1:19" />عْلَى خَاطِرْ مَكْتُوبْ فِي الكْتُبْ المُقَدْسَة:</para>
  <para style="b" vid="1CO 1:19" />
  <para style="q1" vid="1CO 1:19">«بِشْ نِفْنِي حِكْمِةْ الحُكَمَاءْ،</para>
  <para style="q2" vid="1CO 1:19">ونُرْفُضْ فَهْمْ الفَاهْمِينْ».<verse eid="1CO 1:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="1CO 1:20" />وِينُو الحَكِيمْ؟ وِينُو عَالِمْ الشَّرِيعَة؟ وِينُو فَيْلَسُوفْ الزْمَانْ هَاذَا؟ مُشْ اللَّهْ ظَهِّرْ الِّي حِكْمِةْ الدِّنْيَا هَاذِي مَا عَنْدْهَاشْ مَعْنَى؟<verse eid="1CO 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 1:21" />النَّاسْ بْكُلْ حِكْمِتْهُمْ مَا نَجْمُوشْ يَعْرْفُوا اللَّهْ فِي حِكْمْتُو، هَاذَاكَا عْلَاشْ اللَّهْ إِخْتَارْ بَاشْ يْنَجِّي الِّي يَمْنُوا عْلَى طْرِيقْ البْشَارَة الِّي فَمَّة شْكُونْ يَعْتَبِرْهَا هْبَالْ. <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />اليْهُودْ يْحِبُّوا عَالمُعْجْزَاتْ، واليُونَانِيِّينْ يْلَوْجُوا عَالحِكْمَة، <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />آمَا أَحْنَا نْبَشْرُوا بِالمَسِيحْ الِّي تِصْلَبْ. وهَاذَا عَنْدْ اليْهُودْ مُشْ مَقْبُولْ، وعَنْدْ الِّي مُشْ يْهُودْ مُشْ مَعْقُولْ، <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />آمَا عَنْدْ الِّي دْعَاهُمْ اللَّهْ: يْهُودْ وَلَّا مُشْ يْهُودْ، المَسِيحْ هُوَّ قُوِّةْ اللَّهْ وحِكْمِةْ اللَّهْ . <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />ولِّي يُظْهُرْ هْبَالْ مِنْ اللَّهْ، هُوَّ أَحْكِمْ مِنْ حِكْمِةْ النَّاسْ. ولِّي يُظْهُرْ ضُعْفْ مِنْ اللَّهْ هُوَّ أَقْوَى مِنْ قُوِّةْ النَّاسْ.<verse eid="1CO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />تْذَكْرُوا يَا خْوَاتِي كِيفَاشْ كُنْتُوا وَقْتِلِّي دْعَاكُمْ اللَّهْ. مَا كَانِشْ فِيكُمْ بَرْشَة حُكَمَاءْ بْحِكْمِةْ البَشَرْ، ولَا بَرْشَة وَاصْلِينْ ولَا بَرْشَة شُرْفَة. <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />آمَا اللَّهْ إِخْتَارْ النَّاسْ الِّي العَالِمْ يِحْسِبْهُمْ مْهَبْلَة بَاشْ يْحَشَّمْ الحُكَمَاءْ، وإِخْتَارْ النَّاسْ الِّي العَالِمْ يِحْسِبْهُمْ ضْعَافْ بَاشْ يْحَشَّمْ القْوِيِّينْ. <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />وإِخْتَارْ اللَّهْ المَحْقُورِينْ ولِّي مَا يِسْوَاوِشْ عَنْدْ النَّاسْ، بَاشْ يْنَحِّي قِيمِةْ الِّي يِسْوَاوْ وعَنْدْهُمْ قْدَرْ فِي عِينِيهُمْ، <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />بَاشْ حَتَّى وَاحِدْ مَا يِتْفُوخِرْ قُدَّامْ اللَّهْ. <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />وبْفَضْلْ مِنْ عَنْدْ اللَّهْ، إِنْتُومَا وَلِّيتُوا تَابْعِينْ لْيَسُوعْ المَسِيحْ، الِّي عَرَّفْنَا حِكْمِةْ اللَّهْ، ولِّي عْلَى طْرِيقُو وَلِّينَا صَالْحِينْ وقِدِّيسِينْ ومِفْدِيِّينْ. <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />وكِيمَا مَكْتُوبْ: «الِّي يْحِبْ يِتْفَخِّرْ خَلِّيهْ يِتْفَخِّرْ بِالرَّبْ».<verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="s">تَبْشِيرْ بُولِسْ فِي كُورِنْثُوسْ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />وآنَا يَا خْوَاتِي، وَقْتِلِّي جِيتْ بَاشْ نْوَصْلِلْكُمْ سِرْ البْشَارَة، مَا جِيتْكُمْشْ بْقُوِّةْ الكْلَامْ والحِكْمَة، <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />عْلَى خَاطِرْ وآنَا مْعَاكُمْ، مَا حَبِّيتْ نْرَكِّزْ كَانْ عْلَى حَاجَة وَحْدَة الِّي هِيَّ يَسُوعْ المَسِيحْ ومُوتُو عَالصَّلِيبْ. <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" />ووَقْتِلِّي كُنْتْ عَنْدْكُمْ، كُنْتْ ضْعِيفْ وخَايِفْ وبْكُلِّي نُرْعُشْ، <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />وكْلَامِي وتَبْشِيرِي مَا كَانُوشْ مِبْنِيِّينْ عْلَى حِكْمِةْ البَشَرْ الِّي تِقْنَعْ، آمَا عَلِّي يْظَهْرُو رُوحْ اللَّهْ بْقُوْتُو، <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />بَاشْ مَا يْكُونِشْ إِيمَانْكُمْ مِبْنِي عْلَى حِكْمِةْ البَشَرْ، آمَا عْلَى قُوِّةْ اللَّهْ.<verse eid="1CO 2:5" /></para>
  <para style="s">الحِكْمَة الحَقِيقِيَّة هِيَّ مِالرُّوحْ</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />آمَا فَمَّة حِكْمَة نِتْكَلْمُوا بِيهَا مْعَ النَّاضْجِينْ فِي الرُّوحْ، حِكْمَة مَاهِيشْ كِيفْ حِكْمِةْ الدِّنْيَا هَاذِي ولَا كِيفْ حِكْمِةْ رُؤَسَائْهَا الفَانِينْ، <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />هِيَّ حِكْمِةْ اللَّهْ المْخُبْيَة والمَحْجُوبَة عَالنَّاسْ، ولِّي حَضَّرْهَا اللَّهْ مِنْ قْبَلْ مَا تِتْخْلَقْ الدِّنْيَا، لْمَجْدْنَا. <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />وحَتَّى وَاحِدْ مِنْ رُؤَسَاءْ الدِّنْيَا هَاذِي مَا فْهِمْهَا، وكَانْ جَاوْ فِهْمُوهَا رَاهُمْ مَا صَلْبُوشْ الرَّبْ الِّي عَنْدُو المَجْدْ الكُلْ. <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />آمَا كِيمَا مَكْتُوبْ فِي الكْتُبْ المُقَدْسَة:</para>
  <para style="b" vid="1CO 2:9" />
  <para style="q1" vid="1CO 2:9">«الِّي مَا شَافِتُّو عِينْ،</para>
  <para style="q2" vid="1CO 2:9">ولَا سَمْعِتُّو وْذِنْ،</para>
  <para style="q1" vid="1CO 2:9">ولَا جَاء عْلَى بَالْ إِنْسَانْ:</para>
  <para style="q2" vid="1CO 2:9">حَضّْرُو اللَّهْ لِلِّي يْحِبُّوهْ».<verse eid="1CO 2:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10" />وكِشْفُو لِينَا أَحْنَا بِالرُّوحْ، عْلَى خَاطِرْ الرُّوحْ يِكْشِفْ كُلْ شَيْ، حَتَّى أَسْرَارْ اللَّهْ الِّي مَا يَعْرَفْهَا كَانْ هُوَّ. <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />عْلَى خَاطِرْ مَا يَعْرِفْ فِكْرْ الإِنْسَانْ كَانْ رُوحُو الِّي فِيهْ. وزَادَا، مَا يَعْرِفْ فِكْرْ اللَّهْ كَانْ رُوحْ اللَّهْ. <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />وأَحْنَا مَا خْذِينَاشْ رُوحْ العَالِمْ، آمَا خْذِينَا الرُّوحْ الِّي مِنْ عَنْدْ اللَّهْ، بَاشْ نَعْرْفُوا الحَاجَاتْ الِّي نْعِمْ بِيهُمْ اللَّهْ عْلِينَا. <verse eid="1CO 2:12" /><verse number="13" style="v" sid="1CO 2:13" />وأَحْنَا نَحْكِيوْ عْلِيهُمْ بِكْلَامْ نِتْعَلْمُوهْ مِالرُّوحْ القُدُسْ، مُشْ مِنْ حِكْمِةْ البَشَرْ، ونْفَسْرُوا الأُمُورْ الرُّوحِيَّة بْكِلْمَاتْ رُوحِيَّة. <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />آمَا الإِنْسَانْ الِّي مَا عَنْدُوشْ رُوحْ اللَّهْ مَا يِقْبِلْشْ الحَاجَاتْ الِّي مِنْ رُوحْ اللَّهْ عْلَى خَاطِرْ يِعْتَبِرْهَا هْبَالْ، ومَا يْنَجَّمْشْ يِفْهِمْهَا عْلَى خَاطِرْ الحُكْمْ فِيهَا مَا يْكُونْ كَانْ بِالرُّوحْ. <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />آمَا الإِنْسَانْ الِّي عَنْدُو رُوحْ اللَّهْ يُحْكُمْ عَالحَاجَاتْ الكُلْ بِالصْحِيحْ، وحَتَّى حَدْ مَا يْنَجِّمْ يُحْكُمْ عْلِيهْ. <verse eid="1CO 2:15" /><verse number="16" style="v" sid="1CO 2:16" />وكِيمَا مَكْتُوبْ فِي الكْتُبْ المُقَدْسَة: «شْكُونْ عْرَفْ فِكْرْ الرَّبْ بَاشْ يُوصِلْ يْعَلْمُو؟». آمَا أَحْنَا عَنْدْنَا فِكْرْ المَسِيحْ.<verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s">مَزِّلْتُوا صْغَارْ فِي الإِيمَانْ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />آمَا آنَا يَا خْوَاتِي، مَا نَجَّمْتِشْ نْكَلَّمْكُمْ كِيمَا نْكَلَّمْ نَاسْ رُوحِيِّينْ، آمَا كِيمَا نَاسْ تِتْحَكِّمْ فِيهُمْ الطْبِيعَة البَشَرِيَّة الفَاسْدَة، مَزَّالُوا صْغَارْ فِي إِيِمَانْهُمْ بِالمَسِيحْ. <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" />هَاذَاكَا عْلَاشْ عْطِيتْكُمْ حْلِيبْ مُشْ مَاكْلَة قْوِيَّة، عْلَى خَاطِرْكُمْ مَا كُنْتُوشْ تْنَجْمُوا تَاكْلُوهَا، وحَتَّى لْتَوَّا مَزِّلْتُوا مَا تْنَجْمُوشْ تَاكْلُوهَا. <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />عْلَى خَاطِرْكُمْ مَزِّلْتُوا تِتْصَرْفُوا حَسْبْ الطْبِيعَة البَشَرِيَّة الفَاسْدَة. مَادَامْ مَزَّالْ فِيكُمْ حُسْدْ وعَرْكْ، مُشْ إِنْتُومَا هَكَّا إِتَّبْعُوا فِي طْبِيعِتْكُمْ البَشَرِيَّة الفَاسْدَة كِيمَا بْقِيِّةْ النَّاسْ؟ <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" />ومَادَامْ فِيكُمْ الِّي يْقُولْ: «آنَا مْعَ بُولِسْ»، ولِّي يْقُولْ «آنَا مْعَ أَبُلُّوسْ»، مَاكُمْشْ هَكَّا كِيمَا بْقِيِّةْ النَّاسْ؟<verse eid="1CO 3:4" /></para>
  <para style="s">دَوْرْ بُولِسْ وأَبُلُّوسْ</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5" />يَاخِي شْكُونُو بُولِسْ؟ وشْكُونُو أَبُلُّوسْ؟ هُومَا زُوزْ خُدَّامْ عَاوْنُوكُمْ بَاشْ تَمْنُوا عْلَى قَدْ المَسْؤُولِيَّة الِّي عْطَاهَالْهُمْ الرَّبْ. <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" />آنَا غْرِسْتْ وأَبُلُّوسْ سْقَى، آمَا اللَّهْ هُوَّ الِّي نَبِّتْ. <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />مُشْ الِّي غْرِسْ هُوَّ المُهِمْ ولَا حَتَّى الِّي سْقَى، آمَا اللَّهْ الِّي نَبِّتْ هُوَّ المُهِمْ. <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />ومَا فَمَّاشْ فَرْقْ بِينْ الِّي يِغْرِسْ ولِّي يِسْقِي، كُلْ وَاحِدْ بِشْ يَاخُو أَجْرُو عْلَى قَدْ تَعْبُو. <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />أَحْنَا نِتْشَارْكُوا مْعَ اللَّهْ فِي الخِدْمَة، وإِنْتُومَا زَرْعْ اللَّهْ وبَنْيِتُو الِّي يِبْنِي فِيهَا.<verse eid="1CO 3:9" /></para>
  <para style="s">يَسُوعْ هُوَّ السَّاسْ</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 3:10" />وعْلَى قَدْ النِّعْمَة الِّي عْطَاهَالِي اللَّهْ، حَطِّيتْ السَّاسْ كِيمَا يَعْمِلْ البَنَّايْ الِّي عَنْدُو خِبْرَة، ووَاحِدْ آخِرْ يِبْنِي فُوقُو. مَالَا لَازِمْ كُلْ وَاحِدْ يْرُدْ بَالُو كِيفَاشْ يِبْنِي. <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />رَاهُو مَا يْنَجِّمْ حَتَّى حَدْ يْحُطْ سَاسْ آخِرْ بِخْلَافْ السَّاسْ الِّي حَطُّو اللَّهْ، ولِّي هُوَّ يَسُوعْ المَسِيحْ. <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />وإِذَا كَانْ وَاحِدْ بْنَى فُوقْ السَّاسْ هَاذَا بَنْيَة بِالذْهَبْ، وَلَّا بِالفِضَّة، وَلَّا بِالأَحْجَارْ الكَرِيمَة، وَلَّا بِاللُّوحْ، وَلَّا بِالقَشْ، وَلَّا بِالتْبِنْ، <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />تَوَّا يُظْهُرْ نَوْعْ خِدِمْتُو فِي نْهَارْ الحْسَابْ. عْلَى خَاطِرْ النَّارْ، فِي النْهَارْ هَاذَاكَا، بِشْ تِكْشْفُو وتْبَيِّنْ قِيمِةْ خِدْمِةْ كُلْ وَاحِدْ. <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />ولِّي بَنِيتُو تْقَاوِمْ النَّارْ ، يَاخُو أَجْرُو، <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />ولِّي بَنِيتُو تِتْحْرَقْ، يِخْسِرْ أَجْرُو. هُوَّ بِشْ يِنْجَى، آمَا بِشْ يْكُونْ كِيمَا وَاحِدْ مْنَعْ مِنْ وِسْطْ حْرِيقَة.<verse eid="1CO 3:15" /></para>
  <para style="s">إِنْتُومَا هَيْكِلْ اللَّهْ</para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />يَاخِي مَا تَعْرْفُوشْ الِّي إِنْتُومَا هَيْكِلْ اللَّهْ، ولِّي رُوحْ اللَّهْ سَاكِنْ فِيكُمْ؟ <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />الِّي يْدَمِّرْ هَيْكِلْ اللَّهْ، اللَّهْ يْدَمْرُو، عْلَى خَاطِرْ هَيْكِلْ اللَّهْ مُقَدَّسْ، والهَيْكِلْ هَاذَا هُوَّ إِنْتُومَا.<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />حَتَّى وَاحِدْ مَا يْغَلِّطْ رُوحُو! إِذَا كَانْ وَاحِدْ مِنْكُمْ يِسْتْخَايِلْ رُوحُو حَكِيمْ حَسْبْ حِكْمِةْ الدِّنْيَا هَاذِي، رَاهُو لَازِمْ يْوَلِّي مَهْبُولْ بَاشْ يْوَلِّي حَكِيمْ بِالحَقْ، <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />عْلَى خَاطِرْ حِكْمَة الدِّنْيَا هَاذِي هِيَّ عَنْدْ اللَّهْ هْبَالْ. رَاهُو مَكْتُوبْ فِي الكْتُبْ المُقَدْسَة: «اللَّهْ يْحَصِّلْ الحُكَمَاءْ بِخْبَاثِتْهُمْ» <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />وزَادَا: «الرَّبْ يَعْرِفْ أَفْكَارْ الحُكَمَاءْ، ويَعْرِفْ الِّي هِيَّ بَاطْلَة». <verse eid="1CO 3:20" /><verse number="21" style="v" sid="1CO 3:21" />مَالَا، مَا يِلْزِمْ حَتَّى حَدْ يِتْفُوخِرْ بِالنَّاسْ، عْلَى خَاطِرْ كُلْ شَيْ لِيكُمْ، <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />بُولِسْ وَلَّا أَبُلُّوسْ وَلَّا بُطْرُسْ، وَلَّا الدِّنْيَا، وَلَّا الحَيَاةْ وَلَّا المُوتْ وَلَّا الحَاضِرْ وَلَّا المُسْتَقْبِلْ: كُلْ شَيْ لِيكُمْ، <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />آمَا إِنْتُومَا رَاكُمْ لِلْمَسِيحْ، والمَسِيحْ لِلَّهْ.<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s">خُدَّامْ فِي خِدْمِةْ المَسِيحْ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />مَالَا، لَازِمْ النَّاسْ يِعْتَبْرُونَا الِّي أَحْنَا مَالْنَا إِلَّا خُدَّامْ المَسِيحْ، ووُكَلَاءْ عْلَى أَسْرَارْ اللَّهْ. <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />والمَطْلُوبْ مِالوُكَلَاءْ هَاذُومَا، إِنْهُمْ يْكُونُوا ثِيقَة. <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />آمَا آنَا مَا يْهِمْنِيشْ الحُكْمْ الِّي تُحْكْمُوهْ عْلِيَّا إِنْتُومَا وَلَّا أَيْ مَحْكْمَة بَشَرِيَّة، وحَتَّى آنَا مَا نُحْكُمْشْ عْلَى رُوحِي، <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />عْلَى خَاطِرْ ضَمِيرِي مِرْتَاحْ فِي كُلْ شَيْ. هَاذَا مُشْ مَعْنَاهْ الِّي آنَا بَرِيءْ، آمَا المَسِيحْ هُوَّ الِّي بِشْ يْحَاسِبْنِي. <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />مَالَا مَا تُحْكْمُوا عْلَى حَتَّى شَيْ قْبَلْ الوَقْتْ، قْبَلْ مَا يْجِي الرَّبْ الِّي بِشْ يِكْشِفْ المْخُبِّي فِي الظْلَامْ، ويْظَهِّرْ نِيَّاتْ القْلُوبْ. وَقْتْهَا كُلْ وَاحِدْ يَاخُو المَدْحْ الِّي يِسْتْحَقُّو مِنْ عَنْدْ اللَّهْ.<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />آنَا يَا خْوَاتِي، حَطِّيتْ رُوحِي وأَبُلُّوسْ مِثَالْ بَاشْ تِتْعَلْمُوا مِنَّا «إِنْكُمْ مَا تُخْرْجُوشْ عَلِّي مَكْتُوبْ» بَاشْ حَتَّى حَدْ مَا يِتْكَبِّرْ، ويِتْفُوخِرْ بْوَاحِدْ عْلَى حْسَابْ الآخِرْ. <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />عْلَى خَاطِرْ شْنُوَّة الِّي يْخَلِّيكْ تِحْسِبْ رُوحِكْ خِيرْ مِنْ غِيرِكْ؟ ولِّي عَنْدِكْ الكُلْ مُشْ خْذِيتُو مِنْ عَنْدْ اللَّهْ؟ ومَادَامِكْ خْذِيتْو، عْلَاشْ تِتْفُوخِرْ كَايِنُّو مِنْ عَنْدِكْ؟<verse eid="1CO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8" />إِنْتُومَا شْبَعْتُوا وإِسْتَغْنِيتُوا! وَلِّيتُوا مُلُوكْ بْلَاشْ بِينَا! ويَا رِيتْكُمْ كُنْتُوا مُلُوكْ بِالحَقْ، بَاشْ حَتَّى أَحْنَا نْشَارْكُوكُمْ فِي المُلْكْ! <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />كَايِنُّو اللَّهْ حَطْنَا أَحْنَا الرُّسُلْ، آخِرْ النَّاسْ كِيمَا المَحْكُومْ عْلِيهُمْ بِالمُوتْ، خَاطِرْنَا وَلِّينَا فُرْجَة قُدَّامْ العَالِمْ، والمْلَايْكَة والنَّاسْ. <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />أَحْنَا مْهَبْلَة عْلَى خَاطِرْ المَسِيحْ، وإِنْتُومَا حُكَمَاءْ فِي المَسِيحْ! أَحْنَا ضْعَافْ، وإِنْتُومَا قْوِيِّينْ! إِنْتُومَا مْكَرْمِينْ، وأَحْنَا مَحْقُورِينْ! <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />ولْهَاذِي السَّاعَة مَزِّلْنَا نْعَانِيوْ مِالجُوعْ والعْطَشْ والعْرَى والضَّرْبْ ومَا عَنْدْنَاشْ وِينْ نُسْكْنُوا، <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" />نِخْدْمُوا بِيدِينَا ونِتْعْبُوا، بَاشْ نِكْسْبُوا قُوتْنَا. نْبَارْكُوا النَّاسْ الِّي يْسِبُّونَا، ونِتْحَمْلُوا وَقْتِلِّي يِضْطَهْدُونَا، <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />ونْجَاوْبُوا بِالسْيَاسَة وَقْتِلِّي يِتْبَلَّاوْ عْلِينَا. وَلِّينَا ومَزِّلْنَا حَتَّى لْتَوَّا كِيمَا وْسَخْ العَالِمْ وكِي حُثَالِةْ المُجْتَمَعْ.<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />آنَا مُشْ نِكْتِبْ فِي هَاذَا بَاشْ نْحَشَّمْكُمْ، آمَا بَاشْ نِنْصَحْكُمْ عْلَى خَاطِرْكُمْ وْلَادِي الِّي نْحِبْهُمْ. <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />يْنَجِّمْ يْكُونْ عَنْدْكُمْ 10 000 مُرْشِدْ فِي الإِيمَانْ بِالمَسِيحْ، آمَا مَا عَنْدْكُمْشْ بَرْشَة آبَاءْ، عْلَى خَاطِرْ آنَا الِّي وْلِدِتْكُمْ فِي يَسُوعْ المَسِيحْ بِالبْشَارَة الِّي بَشَّرْتْكُمْ بِيهَا. <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" />هَاذَاكَا عْلَاشْ نُطْلُبْ مِنْكُمْ تْعِيشُوا كِيفْ مَا نْعِيشْ آنَا، <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />وهَاذَاكَا عْلَاشْ بْعَثْتِلْكُمْ تِيمُوثَاوُسْ، وِلْدِي المَحْبُوبْ والأَمِينْ فِي الرَّبْ، وهُوَّ بِشْ يْذَكَّرْكُمْ بِالمَبَادِئْ الِّي نْعِيشْ بِيهَا فِي المَسِيحْ،كِيمَا نْعَلَّمْهَا فِي الكْنَايِسْ الكُلْ فِي كُلْ بْلَاصَة.<verse eid="1CO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18" />فَمَّة جْمَاعَة مِنْكُمْ تْكَبْرُوا، مَاشِي فِي بَالْهُمْ الِّي مَانِيشْ جَايْكُمْ، <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />آمَا آنَا، بْقُدْرِةْ رَبِّي بِشْ نْجِيكُمْ عْلَى قْرِيبْ بَاشْ نَعْرِفْ إِذَا كَانْ النَّاسْ المِتْكَبْرِينْ هَاذُومَا قَاعْدِينْ يِتْصَرْفُوا بْقُوِّةْ اللَّهْ فِي حْيَاتْهُمْ، وَلَّا كْلَامْ أَكَهَوْ. <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />عْلَى خَاطِرْ مَمْلَكْةْ اللَّهْ مَا تْكُونِشْ بِالكْلَامْ، آمَا بْقُوِّةْ اللَّهْ. <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />شْنُوَّة تْحِبُّوا؟ تْحِبُّونِي نْجِيكُمْ بِالعْصَا وَلَّا بِالمْحَبَّة وبِالسْيَاسَة؟<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s">الكْنِيسَة والزْنَى</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />يَحْكِيوْ فِي كُلْ بْلَاصَة الِّي بِالحَقْ فَمَّة زْنَى فِي وِسْطْكُمْ! زْنَى مَا يَعْمْلُوشْ كِيفُو حَتَّى الِّي مَاهُمْشْ مُؤْمْنِينْ: رَاجِلْ يَزْنَى مْعَ مَرْتْ بُوهْ! <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />وإِنْتُومَا مَزِّلْتُوا مَنْفُوخِينْ ومِتْكَبْرِينْ! بِالعَكْسْ، كَانْ لَازِمْ تِحْزْنُوا وتْنَحِّيوْ مِنْ وِسْطْكُمْ الِّي عْمَلْ العَمْلَة هَاذِي. <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />وآنَا رَغْمِلِّي غَايِبْ عْلِيكُمْ بِالبْدَنْ، آمَا حَاضِرْ بِينَاتْكُمْ بِالرُّوحْ، رَانِي حْكُمْتْ عْلَى صَاحِبْ العَمْلَة كَايِنِّي حَاضِرْ مْعَاكُمْ. <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />وَقْتِلِّي تِتْلَمُّوا مْعَ بْعَضْكُمْ بْإِسْمْ رَبْنَا يَسُوعْ المَسِيحْ، وآنَا مْعَاكُمْ بِالرُّوحْ، وقُوِّةْ رَبْنَا يَسُوعْ المَسِيحْ مْعَانَا، <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />لَازِمْ تْسَلْمُوا الرَّاجِلْ هَاذَا لِلشِّيطَانْ، بَاشْ تِمْشِي طْبِيعْتُو البَشَرِيَّة الفَاسْدَة لِلْهْلَاكْ، آمَا رُوحُو تِنْجَى فِي النْهَارْ الِّي يِرْجَعْ فِيهْ الرَّبْ.<verse eid="1CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />مَا عَنْدْكُمْ عْلَاشْ تِتْفُوخْرُوا! يَاخِي مَا تَعْرْفُوشْ الِّي شْوَيَّة خْمِيرَة تْخَمِّرْ العْجِينَة الكُلْ؟ <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />نَحِّيوْ الخْمِيرَة القْدِيمَة مِنْ وِسْطْكُمْ بَاشْ تْكُونُوا عْجِينَة جْدِيدَة، عْلَى خَاطِرْ إِنْتُومَا فْطِيرْ بْلَاشْ خْمِيرَة. وخَرُوفْ فِصْحْنَا، الِّي هُوَّ المَسِيحْ، تِذْبَحّْ عْلَى خَاطِرْنَا. <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />خَلِّينَا مَالَا نْعَيْدُوا، مُشْ بِالخْمِيرَة القْدِيمَة، ولَا بِخْمِيرِةْ الخُبْثْ والشَّرْ، آمَا بِفْطِيرْ الطُهْرْ والحَقْ.<verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />كْتِبْتِلْكُمْ فِي رِسَالْتِي بَاشْ مَا تْخَالْطُوشْ الزَّانِينْ. <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />ومَا كُنْتِشْ نُقْصُدْ الزَّانِينْ الكُلْ الِّي فِي العَالِمْ، وَلَّا الطَّمَّاعِينْ وَلَّا السُّرَّاقْ وَلَّا الِّي يِعْبْدُوا الصْنَبْ. كَانْ هَكَّا تْوَلِّيوْ يِلْزِمْكُمْ تُخْرْجُوا مِالعَالِمْ! <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />آمَا نُقْصُدْ مَا تْخَالْطُوشْ الِّي يْسَمِّى رُوحُو مُؤْمِنْ وهُوَّ زَانِي وَلَّا طَمَّاعْ وَلَّا يِعْبِدْ الصْنَبْ وَلَّا شَتَّامْ وَلَّا سُوكَارْجِي وَلَّا سَارِقْ. وَاحِدْ كِيمَا هَاذَا مَا تْعَاشْرُوهِشْ، وحَتَّى المَاكْلَة مَا تَاكْلُوهَاشْ مْعَاهْ. <verse eid="1CO 5:11" /><verse number="12" style="v" sid="1CO 5:12" />آنَا آشْ مْدَخَّلْنِي بَاشْ نْحَاسِبْ نَاسْ مَاهُمْشْ مِالكْنِيسَة؟ آمَا الِّي هُومَا تَابْعِينْ الكْنِيسَة، مُشْ إِنْتُومَا الِّي لَازِمْ تْحَاسْبُوهُمْ؟ <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />عْلَى خَاطِرْ النَّاسْ الِّي مُشْ مِالكْنِيسَة، اللَّهْ هُوَّ الِّي يْحَاسِبْهُمْ. مَالَا: «خَرْجُوا الفَاسِدْ مِنْ وِسْطْكُمْ».<verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s">الشْكَاوِي بِينْ المُؤْمْنِينْ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />وإِذَا كَانْ وَاحِدْ فِيكُمْ عَنْدُو شْكَايَة عْلَى مُؤْمِنْ آخِرْ، كِيفَاشْ يِسْمَحْ لْرُوحُو يِشْكِي بِيهْ عَنْدْ قَاضِي مُشْ مُؤْمِنْ فِي عُوْضْ مَا يِشْكِي لِلْمُؤْمْنِينْ؟ <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />يَاخِي مَا تَعْرْفُوشْ الِّي المُؤْمْنِينْ هُومَا الِّي بِشْ يُحْكْمُوا عَالعَالِمْ؟ إِذَا كَانْ إِنْتُومَا بِشْ تُحْكْمُوا عَالعَالِمْ، يَاخِي مَا تْنَجْمُوشْ تُحْكْمُوا فِي قَضَايَا صْغِيرَة؟ <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />ومَا تَعْرْفُوشْ الِّي أَحْنَا بِشْ نُحْكْمُوا عَالمْلَايْكَة؟ فَمَا بَالِكْ فِي أُمُورْ الدِّنْيَا هَاذِي؟ <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />وإِذَا صَارِتْ بِينَاتْكُمْ مَشَاكِلْ فِي أُمُورْ الحَيَاةْ، يْجِيشْ مِنُّو تْحُطُّوا نَاسْ مَا عَنْدْهُمْشْ إِعْتِبَارْ فِي الكْنِيسَة بَاشْ يُحْكْمُوا؟ <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />ونْقُولْ هَاذَا بَاشْ نْحَشَّمْكُمْ. يَاخِي مَا فِيكُمْشْ حَتَّى وَاحِدْ حَكِيمْ يْنَجِّمْ يُحْكُمْ بِينْ خْوَاتُو؟ <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />آمَا إِنْتُومَا بِالعَكْسْ: الخُو يِشْكِي بْخُوهْ، عَنْدْ نَاسْ مُشْ مُؤْمْنِينْ.<verse eid="1CO 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7" />وفِي الحْقِيقَة عِيبْ كْبِيرْ إِنْكُمْ تِشْكِيوْ بِبْعَضْكُمْ! مُشْ كَانْ تِتْحَمْلُوا الظُّلْمْ خِيرِلْكُمْ؟ مُشْ خِيرِلْكُمْ كَانْ تِقْبْلُوا إِنْهُمْ يِسْلْبُوكُمْ؟ <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />بِالعَكْسْ إِنْتُومَا الِّي قَاعْدِينْ تُظْلْمُوا وتِسْلْبُوا حَتَّى فِي خْوَاتْكُمْ!<verse eid="1CO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 6:9" />يَاخِي مَا تَعْرْفُوشْ الِّي الظَّالْمِينْ مَا يُورْثُوشْ مَمْلَكْةْ اللَّهْ؟ مَا تْغَلْطُوشْ رْوَاحْكُمْ، رَاهُو لَا الفُسَّاقْ، ولَا الِّي يِعْبْدُوا الصْنَبْ، ولَا الزَّانِينْ، ولَا المْخَنْثِينْ ولَا الشَّاذِّينْ، <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />ولَا السُرَّاقْ، ولَا الطَمَّاعَة، ولَا السُوكَارْجِيَّة، ولَا الشَّتَّامَى، ولَا القَلَّابَة يُورْثُوا مَمْلَكْةْ اللَّهْ. <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />وفَمَّة جْمَاعَة مِنْكُمْ كَانُوا هَكَّا. آمَا اللَّهْ طَهِّرْكُمْ، وقَدِّسْكُمْ، وإِعْتَبَرْكُمْ صَالْحِينْ بْقُوِّةْ إِسْمْ الرَّبْ يَسُوعْ المَسِيحْ وبْرُوحْ إِلَاهْنَا.<verse eid="1CO 6:11" /></para>
  <para style="s">بْدَنَّاتْنَا هَيْكِلْ لِلرُّوحْ القُدُسْ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />«كُلْ شَيْ حْلَالْ لِيَّا»، آمَا مُشْ كُلْ شَيْ يِنْفَعْ. «كُلْ شَيْ حْلَالْ لِيَّا»، آمَا مَانِيشْ بِشْ نْخَلِّي حَتَّى حَاجَة تِتْحَكِّمْ فِيَّا. <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />المَاكْلَة مَجْعُولَة لِلْكِرْشْ، والكِرْشْ لِلْمَاكْلَة، واللَّهْ بِشْ يِفْنِيهُمْ الإِثْنِينْ. والبْدَنْ مُشْ مَجْعُولْ لِلزْنَى، آمَا لِلرَّبْ، والرَّبْ لِلْبْدَنْ. <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />واللَّهْ الِّي قَيِّمْ الرَّبْ مِنْ بِينْ المُوتَى، بِشْ يْقَيِّمْنَا أَحْنَا زَادَا بْقُدْرْتُو!<verse eid="1CO 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15" />مَا تَعْرْفُوشْ الِّي بْدَنَّاتْكُمْ هِيَّ أَعْضَاءْ المَسِيحْ؟ يْجِيشْ مِنُّو نَاخُو أَعْضَاءْ المَسِيحْ ونْخَلِّيهَا تْوَلِّي أَعْضَاءْ وَحْدَة عَاهْرَة؟ حَاشَا! <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />وإِنْتُومَا تَعْرْفُوا الِّي كُلْ وَاحِدْ يُرْقُدْ مْعَ وَحْدَة عَاهْرَة يْوَلِّي بْدَنْ وَاحِدْ هُوَّ وَيَّاهَا؟ عْلَى خَاطِرْ مَكْتُوبْ فِي الكْتُبْ المُقَدْسَة: «الإِثْنِينْ يْوَلِّيوْ بْدَنْ وَاحِدْ». <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />وآمَا الِّي يِتَّحِدْ بِالرَّبْ، يْوَلِّي هُوَّ وَيَّاهْ رُوحْ وَاحِدْ.<verse eid="1CO 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18" />أُهْرْبُوا مِالزْنَى! كُلْ ذَنْبْ يَعْمْلُو الإِنْسَانْ يَعْمْلُو خَارِجْ بَدْنُو. آمَا الزَّانِي يِذْنِبْ فِي حَقْ بَدْنُو. <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" />يَاخِي مَا تَعْرْفُوشْ الِّي بْدَنَّاتْكُمْ هِيَّ هَيْكِلْ لِلرُّوحْ القُدُسْ السَّاكِنْ فِيكُمْ، ولِّي عْطَاهُولْكُمْ اللَّهْ؟ إِنْتُومَا مَاكُمْشْ مِلْكْ رْوَاحْكُمْ، آمَا مِلْكْ اللَّهْ. <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />عْلَى خَاطِرْ اللَّهْ شْرَاكُمْ بِالغَالِي. مَالَا مَجْدُوا اللَّهْ فِي بْدَنَّاتْكُمْ.<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s">لِلْمُؤْمْنِينْ المْعَرْسِينْ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />وآمَا بِخْصُوصْ الحَاجَاتْ الِّي كْتِبْتُولِي عْلِيهَا: مِالأَحْسِنْ إِنُّو الرَّاجِلْ مَا يْعَرِّسْشْ. <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />آمَا، بَاشْ مَا يْطِيحُوشْ فِي الزْنَى، خَلِّي كُلْ رَاجِلْ تْكُونْ عَنْدُو مَرْتُو وكُلْ مْرَا يْكُونْ عَنْدْهَا رَاجِلْهَا، <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />والرَّاجِلْ يِلْزْمُو يَعْطِي لْمَرْتُو حَقْهَا، والمْرَا زَادَا يِلْزِمْهَا تَعْطِي لْرَاجِلْهَا حَقُّو. <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />رَاهِي المْرَا مَا عَنْدْهَاشْ سُلْطَة عْلَى بْدَنْهَا، عْلَى خَاطِرْ بْدَنْهَا لْرَاجِلْهَا. ورَاهُو الرَّاجِلْ زَادَا مَا عَنْدُوشْ سُلْطَة عْلَى بَدْنُو، عْلَى خَاطِرْ بَدْنُو لْمَرْتُو. <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />مَا تِحْرْمُوشْ بْعَضْكُمْ مِالعَلَاقَة الزَّوْجِيَّة، إِلَّا إِذَا كَانْ تْفَاهِمْتُوا عْلَى هَاذَا، ولْمُدَّة قْصِيرَة، بَاشْ تْعَدِّيوْ وَقْتْ فِي الصْلَاة. ومْبَعِّدْ، إِرْجْعُوا لْعَلَاقِتْكُمْ، عْلَى خَاطِرْ مُمْكِنْ تْوَلِّيوْ مَا تْنَجْمُوشْ تْشِدُّوا رْوَاحْكُمْ، وهَكَّا تَعْطِيوْ فُرْصَة لِلشِّيطَانْ بَاشْ يْغُرْكُمْ.<verse eid="1CO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 7:6" />نْقُلْكُمْ هَاذَا نْصِيحَة، مُشْ أَمْرْ. <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />آنَا نِتْمَنَّى كَانْ جَاوْ النَّاسْ الكُلْ كِيفِي. آمَا كُلْ وَاحِدْ عَنْدُو الهِيبَة الِّي عْطَاهَالُو اللَّهْ، وَاحِدْ عْطَاهْ الهِيبَة هَاذِي والآخِرْ عْطَاهْ هِيبَة أُخْرَى.<verse eid="1CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8" />ونْقُولْ لِلْعُزَّابْ والهَجَّالَاتْ إِنُّو خِيرِلْهُمْ كَانْ يُقْعْدُوا كِيفِي. <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />آمَا إِذَا كَانْ مَا يْنَجْمُوشْ يِتْحَكْمُوا فِي رْوَاحْهُمْ، خَلِّيهُمْ يْعَرْسُوا، عْلَى خَاطِرْ خِيرْ الوَاحِدْ يْعَرِّسْ مِلِّي يُقْعُدْ يِتْحْرَقْ بْشَهْوْتُو. <verse eid="1CO 7:9" /><verse number="10" style="v" sid="1CO 7:10" />وبِالنِّسْبَة لِلْمْعَرْسِينْ نْوَصِّيهُمْ بَاشْ المْرَا مَا تْفَارِقْشْ رَاجِلْهَا، والوْصِيَّة هَاذِي مِنْ عَنْدْ الرَّبْ مُشْ مِنْ عَنْدِي، <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />وإِذَا فَارْقِتُّو مَا تْعَاوِدْشْ تْعَرِّسْ، وَلَّا تْعَاوِدْ تِتْصَالَحْ مْعَ رَاجِلْهَا. والرَّاجِلْ مَا يِلْزْمُوشْ يْطَلَّقْ مَرْتُو.<verse eid="1CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12" />وبِالنِّسْبَة لِلْبْقِيَّة، آنَا الِّي نْقُلْهُمْ ومُشْ الرَّبْ، إِذَا كَانْ وَاحِدْ مِنْ خْوَاتْنَا المُؤْمْنِينْ مَرْتُو مَاهِيشْ مُؤْمْنَة، وهِيَّ تْحِبْ تْعِيشْ مْعَاهْ، مَا يْطَلَّقْهَاشْ. <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />وإِذَا كَانْ وَحْدَة مُؤْمْنَة ورَاجِلْهَا مُشْ مُؤْمِنْ، ويْحِبْ يْعِيشْ مْعَاهَا، مَا اطَّلْقُوشْ. <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />عْلَى خَاطِرْ الرَّاجِلْ الِّي مُشْ مُؤْمِنْ يِتْقَدِّسْ عْلَى خَاطِرْ مَرْتُو المُؤْمْنَة، والمْرَا الِّي مَاهِيشْ مُؤْمْنَة تِتْقَدِّسْ عْلَى خَاطِرْ رَاجِلْهَا المُؤْمِنْ. وإِلَّا وْلَادْكُمْ بِشْ يْكُونُوا مَنْزُوسِينْ، آمَا هُومَا فِي الحْقِيقَة مُقَدْسِينْ. <verse eid="1CO 7:14" /><verse number="15" style="v" sid="1CO 7:15" />وإِذَا كَانْ الِّي مُشْ مُؤْمِنْ يْحِبْ يْطَلَّقْ خَلِّيهْ يْطَلَّقْ. فِي الحَالَة هَاذِي المُؤْمِنْ وَلَّا المُؤْمْنَة مَاهُمْشْ مَرْبُوطِينْ بِالعِرْسْ هَاذَا. عْلَى خَاطِرْ اللَّهْ دْعَاكُمْ بَاشْ تْعِيشُوا فِي سَلَامْ. <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />عْلَى خَاطِرْ كِيفَاشْ تَعْرِفْ يَا مْرَا، إِذَا كَانِكْ بِشْ تْكُونْ سْبَبْ إِنُّو رَاجْلِكْ يِنْجَى؟ وكِيفَاشْ تَعْرِفْ، يَا رَاجِلْ، إِذَا كَانِكْ بِشْ تْكُونْ سْبَبْ إِنُّو مَرْتِكْ تِنْجَى؟<verse eid="1CO 7:16" /></para>
  <para style="s">كُلْ وَاحِدْ وظُرُوفُو</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />مَالَا، خَلِّي كُلْ وَاحِدْ يِتْصَرِّفْ فِي الحَيَاةْ حَسْبْ مَا عْطَاهْ الرَّبْ وحَسْبْ مَا كَانِتْ حَالْتُو وَقْتِلِّي دْعَاهْ اللَّهْ. وهَاذَا هُوَّ المَبْدَأْ الِّي نُؤْمُرْ بِيهْ فِي الكْنَايِسْ الكُلْ. <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />الِّي دْعَاهْ اللَّهْ وهُوَّ مْطَهَّرْ، خَلِّيهْ يُقْعُدْ مْطَهَّرْ، ولِّي دْعَاهْ وهُوَّ مُشْ مْطَهَّرْ، خَلِّيهْ يُقْعُدْ مُشْ مْطَهَّرْ. <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />مَا يْهِمِّشْ مْطَهَّرْ وإِلَّا مُشْ مْطَهَّرْ، المُهِمْ إِنُّو الوَاحِدْ يْطَبَّقْ وْصَايَا اللَّهْ. <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />لَازِمْ كُلْ وَاحِدْ يُقْعُدْ فِي الحَالَة الِّي كَانْ عْلِيهَا وَقْتِلِّي دْعَاهْ اللَّهْ. <verse eid="1CO 7:20" /><verse number="21" style="v" sid="1CO 7:21" />إِذَا كُنْتْ عَبْدْ وَقْتِلِّي دْعَاكْ اللَّهْ، مَا تْخَلِّيشْ هَاذَا يْقَلْقِكْ. آمَا إِذَا كَانْ جَاتِكْ فُرْصَة بَاشْ تْوَلِّي حُرْ، إِسْتْغَلْهَا. <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />عْلَى خَاطِرْ الِّي دْعَاهْ الرَّبْ وهُوَّ عَبْدْ وَلَّى حُرْ فِي الرَّبْ، ولِّي دْعَاهْ الرَّبْ وهُوَّ حُرْ وَلَّى عَبْدْ لِلْمَسِيحْ. <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />رَاهُو اللَّهْ شْرَاكُمْ بِالغَالِي، مَالَا مَا تْوَلِّيوِشْ عَبِيدْ لِلنَّاسْ. <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />وخَلِّي كُلْ وَاحِدْ فِيكُمْ يَا خْوَاتِي، يُقْعِدْ مْعَ اللَّهْ فِي الحَالَة الِّي كَانْ عْلِيهَا وَقْتِلِّي دْعَاهْ.<verse eid="1CO 7:24" /></para>
  <para style="s">لِلِّي مُشْ مْعَرْسِينْ</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />آمَا العُزَّابْ مَا عَنْدِيشْ لِيهُمْ وْصِيَّة مِنْ عَنْدْ الرَّبْ، آمَا نَعْطِي رَايِي عْلَى خَاطِرْ رَحْمِةْ اللَّهْ خَلَّاتْنِي مْحَلْ ثِيقَة. <verse eid="1CO 7:25" /><verse number="26" style="v" sid="1CO 7:26" />وبِسْبَبْ الظُّرُوفْ الصْعِيبَة الِّي مَوْجُودَة تَوَّا، نْظُنْ إِنُّو مِالْأَحْسِنْ كُلْ وَاحِدْ يُقْعُدْ فِي الحَالَة الِّي هُوَّ عْلِيهَا. <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />كَانْ إِنْتِ مْعَرِّسْ بِمْرَا، مَا اطَّلَّقْهَاشْ، وكَانْ إِنْتِ مُشْ مْعَرِّسْ بِمْرَا، مَا تْعَرِّسْشْ، <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />آمَا كَانْ تْعَرِّسْ مَاكِشْ تَعْمِلْ فِي ذَنْبْ، وإِذَا كَانْ صْبِيَّة تْعَرِّسْ مَاهِيشْ تَعْمِلْ فِي ذَنْبْ. آمَا الِّي يْعَرْسُوا، يَشْقَاوْ بَرْشَة فِي أُمُورْ الحَيَاةْ، وآنَا نْحِبْ نِحْمِيكُمْ.<verse eid="1CO 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29" />آنَا نْقُلْكُمْ، يَا خْوَاتِي، الِّي الوَقْتْ وَلَّى قْصِيرْ. مَالَا خَلِّي الِّي عَنْدْهُمْ نْسَاء يْكُونُوا كَايِنْهُمْ مَا عَنْدْهُمْشْ، <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />ولِّي يِبْكِيوْ كَايِنْهُمْ مَا يِبْكِيوِشْ، ولِّي يِفْرْحُوا كَايِنْهُمْ مَا يِفْرْحُوشْ، ولِّي يِشْرِيوْ كَايِنْهُمْ مَا يِمْلْكُوشْ، <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />ولِّي يِتْعَامْلُوا فِي أُمُورْ الدِّنْيَا هَاذِي كَايِنْهُمْ مُشْ مِتْعَلْقِينْ بِيهَا. عْلَى خَاطِرْ الدِّنْيَا هَاذِي فَانْيَة. <verse eid="1CO 7:31" /><verse number="32" style="v" sid="1CO 7:32" />وآنَا مَا نْحِبِّشْ تْكُونْ عَنْدْكُمْ هْمُومْ. الِّي مُشْ مْعَرِّسْ يِتْلْهَى بْأُمُورْ الرَّبْ بَاشْ يْرَضِّيهْ. <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />آمَا المْعَرِّسْ يِتْلْهَى بْأُمُورْ الدِّنْيَا بَاشْ يْرَضِّي مَرْتُو، <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />وهَكَّا يْكُونْ فِكْرُو مْشَتِّتْ بِينْ الإِثْنِينْ. وزَادَا الصْبِيَّة ولِّي مَا عَنْدْهَاشْ رَاجِلْ يِتِلْهَاوْ بْأُمُورْ الرَّبْ ويْحِبُّوا يْخَصْصُولُوا رْوَاحْهُمْ وبْدَنَّاتْهُمْ. آمَا المْعَرْسَة تِتْلْهَى بْأُمُورْ الدِّنْيَا بَاشْ تْرَضِّي رَاجِلْهَا. <verse eid="1CO 7:34" /><verse number="35" style="v" sid="1CO 7:35" />نْقُولِلْكُمْ هَاذَا لْمَصْلْحِتْكُمْ، مُشْ بَاشْ انَّقِّصْ مِنْ حُرِّيِّتْكُمْ، آمَا بَاشْ تَعْمْلُوا الِّي يْلِيقْ بِالرَّبْ وتِخْدْمُوهْ مِنْ غِيرْ تْمَهْمِيشْ.<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />آمَا إِذَا كَانْ وَاحِدْ يْشُوفْ الِّي هُوَّ مُشْ قَاعِدْ يِتْصَرِّفْ بْطَرِيقَة لَايْقَة مْعَ خَطِيبْتُو وبِشْ يْفُوتْهَا وَقْتْ العِرْسْ ولَازِمْ تْعَرِّسْ، خَلِّيهْ يْعَرِّسْ كَانْ يْحِبْ، وهَاذَا مُشْ ذَنْبْ. <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />آمَا الِّي مُقْتَنَعْ فِي قَلْبُو، وحُرْ فِي إِخْتِيَارُو، ومُشْ مَلْزُومْ يْعَرِّسْ، وقَرِّرْ بَاشْ مَا يْعَرِّسْشْ، يَعْمِلْ حَاجَة بَاهْيَة. <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />مَالَا الِّي يْعَرِّسْ يَعْمِلْ حَاجَة بَاهْيَة، ولِّي مَا يْعَرِّسْشْ يَعْمِلْ حَاجَة أَحْسِنْ.<verse eid="1CO 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39" />تُقْعُدْ المْرَا مَرْبُوطَة بْرَاجِلْهَا مَادَامُو حَيْ. وكَانْ رَاجِلْهَا مَاتْ، عَنْدْهَا الحَقْ تْعَرِّسْ بِلِّي تْحِبْ، عْلَى شَرْطْ يْكُونْ مُؤْمِنْ. <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />آمَا حَسْبْ رَايِي، بَاشْ تْكُونْ فَرْحَانَة أَكْثِرْ كَانْ تَبْقَى مِنْ غِيرْ رَاجِلْ، ويُظْهُرْلِي آنَا زَادَا عَنْدِي رُوحْ اللَّهْ.<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s">الذْبَايَحْ المَذْبُوحَة لِلصْنَبْ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />آمَا بِخْصُوصْ الذْبَايَحْ الِّي يِذْبْحُوهَا لِلصْنَبْ: نَعْرْفُوا الِّي الْكُلْنَا عَنْدْنَا مَعْرْفَة. والمَعْرْفَة تُنْفُخْ وتْخَلِّي مُولَاهَا يِتْكَبِّرْ، آمَا المْحَبَّة تِبْنِي. <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />وإِذَا كَانْ وَاحِدْ مَاشِي فِي بَالُو الِّي هُوَّ يَعْرِفْ حَاجَة، رَاهُو فِي الحْقِيقَة مَزَّالْ مَا يَعْرِفْشْ كِيمَا يِلْزِمْ. <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />وكُلْ وَاحِدْ يْحِبْ اللَّهْ، اللَّهْ يَعْرْفُو.<verse eid="1CO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4" />وبِخْصُوصْ مَاكِلْةْ لْحَمْ الذْبَايَحْ المَذْبُوحَة لِلصْنَبْ: أَحْنَا نَعْرْفُوا الِّي الصَّنْبَة مَاهِيشْ إِلَاهْ حَقِيقِي، وإِنُّو مَا فَمَّة حَتَّى إِلَاهْ آخِرْ كَانْ اللَّهْ وَحْدُو. <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />وحَتَّى كَانْ فَمَّة آلْهَة النَّاسْ يْظُنُّوا إِنْهُمْ مَوْجُودِينْ فِي السْمَاء وَلَّا فِي الأَرْضْ، ومَا أَكْثَرْهُمْ هَا الآلْهَة والرْبُوبَة، <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />رَاهُو بِالنِّسْبَة لِينَا مَا عَنْدْنَا كَانْ إِلَاهْ وَاحِدْ، هُوَّ الآبْ خَالِقْ كُلْ شَيْ، وأَحْنَا حَيِّينْ عْلَى خَاطْرُو. وعَنْدْنَا رَبْ وَاحِدْ هُوَّ يَسُوعْ المَسِيحْ الِّي بِيهْ تِخْلَقّْ كُلْ شَيْ، وأَحْنَا حَيِّينْ بِيهْ.<verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />آمَا مُشْ المُؤْمْنِينْ الكُلْ يَعْرْفُوا الحْقِيقَة هَاذِي. فَمَّة مِنْهُمْ الِّي تْعَوْدُوا عَالصْنَبْ، ولْتَوَّا مَزَّالُوا يْظُنُّوا الِّي الذْبَايَحْ الِّي يَاكْلُوا مِنْ لْحَمْهَا، هِيَّ بِالحَقْ مَذْبُوحَة لِلصْنَبْ، وكِي يَاكْلُوا مِنْهَا يْحِسُّوا الِّي هُومَا تْنَجْسُوا، عْلَى خَاطِرْ ضْمَايِرْهُمْ ضْعِيفَة. <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />آمَا رَاهِي المَاكْلَة مَا تْقَرِّبْنَاشْ لِلَّهْ، وكَانْ نَاكْلُوا مَا يْزِيدْ فِينَا شَيْ وكَانْ مَا نَاكْلُوشْ مَا يُنْقُصْ مِنَّا شَيْ. <verse eid="1CO 8:8" /><verse number="9" style="v" sid="1CO 8:9" />آمَا رُدُّوا بَالْكُمْ لَا تْوَلِّي حُرِّيِّتْكُمْ هَاذِي سْبَبْ عَثْرَة لِلضْعَافْ. <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />وإِنْتِ يَلِّي تَعْرِفْ، إِذَا كَانْ وَاحِدْ ضَمِيرُو ضْعِيفْ يْشُوفِكْ تَاكِلْ فِي مَعْبِدْ الصْنَبْ، يَاخِي مُشْ يِتْشَجَّعْ ويَاكِلْ مِاللْحَمْ المَذْبُوحْ لِلصْنَبْ؟ <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />وهَكَّا، مَعْرِفْتِكْ تْكُونْ سْبَبْ فِي هْلَاكْ خُوكْ الضْعِيفْ الِّي مَاتْ المَسِيحْ عْلَى خَاطْرُو. <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />رَاكُمْ تَعْمْلُوا ذَنْبْ ضِدْ المَسِيحْ وَقْتِلِّي تُغْلْطُوا فِي حَقْ خْوَاتْكُمْ وتَجْرْحُوا ضَمِيرْهُمْ الضْعِيفْ. <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />هَاذَاكَا عْلَاشْ كَانْ فَمَّة مَاكْلَة تْخَلِّي خُويَا يِتْعَثِّرْ، مَا عَادِشْ نَاكِلْ اللْحَمْ بِالكُلْ، بَاشْ خُويَا مَا يْطِيحِشْ.<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s">حُقُوقْ خَادِمْ البْشَارَة</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />يَاخِي مُشْ آنَا حُرْ؟ مُشْ آنَا رَسُولْ؟ مُشْ آنَا شُفْتْ رَبْنَا يَسُوعْ المَسِيحْ؟ مُشْ إِنْتُومَا ثَمْرِةْ خِدْمْتِي فِي الرَّبْ؟ <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />وحَتَّى لَوْ كَانْ عَنْدْ نَاسْ أُخْرِينْ مَانِيشْ رَسُولْ، عَالأَقَلْ آنَا رَسُولْ بِالنِّسْبَة لِيكُمْ، عْلَى خَاطِرْ إِنْتُومَا الدَّلِيلْ الِّي آنَا رَسُولْ مِنْ عَنْدْ الرَّبْ.<verse eid="1CO 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3" />وهَاوْ شْنُوَّة بَاشْ نْقُولْ لِلنَّاسْ الِّي يُنْقْدُوا فِيَّا: <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />يَاخِي مَا عَنْدْنَاشْ الحَقْ نَاخْذُوا مَاكْلِتْنَا وشْرَابْنَا مِالخِدْمَة؟ <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />يَاخِي مَا عَنْدْنَاشْ الحَقْ يْسَافْرُوا مْعَانَا نْسَانَا المُؤْمْنِينْ، كِيفْ مَا يَعْمْلُوا الرُّسُلْ الأُخْرِينْ وخْوَاتْ الرَّبْ وبُطْرُسْ؟ <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />وَلَّا آنَا وبَرْنَابَا بَرِكْ مَجْبُورِينْ نِخْدْمُوا بَاشْ نْعِيشُوا؟ <verse eid="1CO 9:6" /><verse number="7" style="v" sid="1CO 9:7" />شْكُونْ الجُنْدِي الِّي يِمْشِي لِلْحَرْبْ ويُصْرُفْ عْلَى رُوحُو؟ شْكُونْ الِّي يَزْرَعْ سَانِيةْ عْنِبْ ومَا يَاكِلْشْ مِنْ غَلِّتْهَا؟ وَلَّا شْكُونُو السَّارِحْ الِّي يِسْرَحْ بِالغْنَمْ ومَا يُشْرُبْشْ مِنْ حْلِيبْهَا؟<verse eid="1CO 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 9:8" />يَاخِي تِسْتْخَايْلُونِي نِتْكَلَّمْ بْمَنْطَقْ البَشَرْ؟ مُشْ الشَّرِيعَة تْقُولْ هَاذَا؟ <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" />مَكْتُوبْ فِي شَرِيعِةْ مُوسَى: «مَا تْحُطِّشْ كْمَامَة عْلَى فُمْ الثُّورْ وَقْتِلِّي يِدْرِسْ». زَعْمَة اللَّهْ يْهِمُّو فِي الثِّيرَانْ؟ <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />وَلَّا يْقُولْ فِي هَاذَا عْلَى خَاطِرْنَا؟ أَيْ، هَاذَا تِكْتِبْ عْلَى خَاطِرْنَا أَحْنَا. الِّي يَحْرِثْ ولِّي يِدْرِسْ عَنْدْهُمْ أَمَلْ الِّي هُومَا بَاشْ يَاخْذُوا بَايْهُمْ مِالصَّابَة. <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" />ومَادَامْ أَحْنَا زْرَعْنَالْكُمْ البَرَكَاتْ الرُّوحِيَّة، يَاخِي خْسَارَة فِينَا نَحْصْدُوا مِنْكُمْ البَرَكَاتْ المَادِّيَة؟ <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />إِذَا كَانْ غِيرْنَا عَنْدْهُمْ الحَقْ بَاشْ يَاخْذُوا مِنْكُمْ البَرَكَاتْ المَادِّيَة، زَعْمَة مُشْ أَحْنَا أَوْلَى؟ آمَا أَحْنَا مَا طَالِبْنَاشْ بِالحَقْ هَاذَا، بِالعَكْسْ، تْحَمَّلْنَا كُلْ شَيْ بَاشْ مَا نْعَطْلُوشْ بْشَارِةْ المَسِيحْ.<verse eid="1CO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 9:13" />مَا تَعْرْفُوشْ إِنُّو الِّي يِخْدْمُوا فِي الهَيْكِلْ يَاخْذُوا مَاكْلِتْهُمْ مِالهَيْكِلْ، ولِّي يِخْدْمُوا فِي المَذْبَحْ يَاخْذُوا بَايْهُمْ مِالذْبَايَحْ؟ <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" />وزَادَا الرَّبْ عْطَى أَمْرْ إِنُّو الِّي يُنْشْرُوا البْشَارَة، يَاخْذُوا رِزْقْهُمْ مِنْ خِدْمِةْ البْشَارَة. <verse eid="1CO 9:14" /><verse number="15" style="v" sid="1CO 9:15" />آمَا آنَا مَا إِسْتَعْمَلْتْ حَتَّى حَقْ مِالحْقُوقْ هَاذِي، وْلَانِي قَاعِدْ نِكْتِبْ فِي هَاذَا بَاشْ نْطَالِبْ بِيهَا. آنَا نْخَيِّرْ نْمُوتْ ومَا يِحْرِمْنِي حَدْ مِالفُخْرَة هَاذِي. <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />وفِي الحْقِيقَة مَا عَنْدِيشْ عْلَاشْ نِتْفُوخِرْ بْإِنِّي نْبَشِّرْ، عْلَى خَاطِرْ هَاذَا وَاجِبْ عْلِيَّا، ويَا وِيلِي إِذَا كَانْ مَا نْبَشَّرْشْ. <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />كَانْ جِيتْ آنَا الِّي اخْتَرْتْ بَاشْ نْبَشِّرْ، وَقْتْهَا مِنْ حَقِّي نُخْلِصْ، آمَا مُشْ آنَا الِّي اخْتَرْتْ، هَاذِي مَسْؤُولِيَّة اللَّهْ أَمَّنِّي عْلِيهَا. <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />مَالَا شْنُوَّة خْلَاصِي؟ خْلَاصِي هُوَّ إِنِّي نْبَشِّرْ بْلَاشْ فْلُوسْ، ومَا نْطَالِبْشْ بْحْقُوقِي مِنْ خِدْمِةْ البْشَارَة.<verse eid="1CO 9:18" /></para>
  <para style="s">بُولِسْ يْسَلَّمْ فِي حْقُوقُو عْلَى خَاطِرْ البْشَارَة</para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />ورَغْمِلِّي آنَا حُرْ ومَانِي عَبْدْ لْحَتَّى حَدْ، خَلِّيتْ رُوحِي عَبْدْ لِلنَّاسْ الكُلْ، بَاشْ نِرْبَحْ أَكْثِرْ مَا يُمْكِنْ مِنْهُمْ لِلْمَسِيحْ. <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />وَقْتِلِّي نِبْدَا مْعَ اليْهُودْ نْعِيشْ كِيفْهُمْ بَاشْ نِرْبَحْهُمْ. وَقْتِلِّي نِبْدَا مْعَ الِّي تَحْتْ الشَّرِيعَة نْعِيشْ كَايِنِّي تَحْتْ الشَّرِيعَة، رَغْمِلِّي مَانِيشْ تَحْتْ الشَّرِيعَة، بَاشْ نِرْبَحْ الِّي تَحْتْ الشَّرِيعَة. <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />وبَاشْ نِرْبَحْ الِّي مَا عَنْدْهُمْشْ شَرِيعَة، وَلِّيتْ كَايِنِّي مِنْ غِيرْ شَرِيعَة، رَغْمِلِّي مَانِيشْ بْلَا شَرِيعَة، عْلَى خَاطِرْنِي تَحْتْ شَرِيعِةْ المَسِيحْ. <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />وَلِّيتْ ضْعِيفْ لِلضْعَافْ بَاشْ نِرْبَحْهُمْ. تْأَقْلَمْتْ مْعَ النَّاسْ الكُلْ، بَاشْ نْمَنَّعْ شْوَيَّة مِنْهُمْ بْأَيْ طَرِيقَة مُمْكْنَة. <verse eid="1CO 9:22" /><verse number="23" style="v" sid="1CO 9:23" />نَعْمِلْ فِي هَاذَا الكُلُّو عْلَى خَاطِرْ البْشَارَة، بَاشْ نِتْشَارِكْ مْعَاهُمْ فِي بَرَكَاتْهَا.<verse eid="1CO 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 9:24" />يَاخِي مَا تَعْرْفُوشْ إِنُّو الِّي يِجْرِيوْ فِي السِّبَاقْ الْكُلْهُمْ يِجْرِيوْ، آمَا وَاحِدْ بَرْكْ يِرْبَحْ الجَايْزَة؟ إِجْرِيوْ إِنْتُومَا زَادَا كِيفُو بَاشْ تِرْبْحُوا! <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />الِّي يُدْخْلُوا فِي مُسَابْقَة الكُلْ يْدَرْبُوا رْوَاحْهُمْ تَدْرِيبْ صْعِيبْ فِي كُلْ شَيْ. هُومَا يَعْمْلُوا فِي هَاذَا الكُلْ بَاشْ يَاخْذُوا تَاجْ يِفْنَى، آمَا أَحْنَا نَعْمْلُوا فِي هَاذَا بَاشْ نِرْبْحُوا تَاجْ مَا يِفْنَاشْ. <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />هَاذَاكَا عْلَاشْ آنَا نِجْرِي، مُشْ كِيمَا وَاحِدْ مَا عَنْدُوشْ هَدَفْ. ونَضْرِبْ مُشْ كِيمَا وَاحِدْ قَاعِدْ يَضْرِبْ فِي الهْوَاء، <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />آمَا نَقْسَى عْلَى بَدْنِي ونِتْحَكِّمْ فِيهْ، عْلَى خَاطِرْ نْخَافْ لَا بَعْدْمَا بَشَّرْتْ غِيرِي، نْكُونِشْ آنَا بِيدِي مَرْفُوضْ.<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s">خُوذُوا العِبْرَة مِالمَاضِي</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />نْحِبْكُمْ تِفْهْمُوا يَا خْوَاتِي شْنُوَّة الِّي صَارْ مْعَ جْدُودْنَا، الكُلْهُمْ كَانُوا تَحْتْ غِيمَة تْقُودْ فِيهُمْ، والكُلْهُمْ شَقُّوا البْحَرْ، <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />كَايِنْهُمْ تْعَمْدُوا فِي البْحَرْ الأَحْمِرْ وفِي الغِيمَة، بَاشْ يْوَلِّيوْ أَتْبَاعْ لْمُوسَى. <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />والكُلْهُمْ كْلَاوْ نَفْسْ المَاكْلَة الرُّوحِيَّة، <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />والكُلْهُمْ شَرْبُوا مِنْ نَفْسْ المَاء الرُّوحِي، عْلَى خَاطِرْ شَرْبُوا مِنْ حَجْرَة رُوحِيَّة كَانِتْ مْعَاهُمْ، والحَجْرَة هَاذِي هِيَّ المَسِيحْ. <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />ومْعَ هَاذَا، أَكْثَرِيِّتْهُمْ مَا رْضَاشْ عْلِيهُمْ اللَّهْ، هَاذَاكَا عْلَاشْ مَاتُوا فِي الصَّحْرَاء.<verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />وهَاذَاكَا الكُلْ صَارْ بَاشْ يْكُونْ عِبْرَة لِينَا، بَاشْ مَا نِشْتْهِيوِشْ نَعْمْلُوا الشَّرْ كِيفْهُمْ. <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />ومَا تِعْبْدُوشْ الصْنَبْ كِيفْ مَا عَمْلُوا جْمَاعَة مِنْهُمْ، كِيمَا تِكْتِبْ عْلِيهُمْ: «قْعَدْ الشَّعْبْ بَاشْ يَاكِلْ ويُشْرِبْ، ومْبَعِّدْ قَامُوا بَاشْ يَلْعْبُوا». <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />ومَا يِلْزِمْنَاشْ نِزْنَاوْ، كِيمَا زْنَاوْ جْمَاعَة مِنْهُمْ، يَاخِي مَاتُوا 23 000 وَاحِدْ فِي نَفْسْ النْهَارْ. <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />ومَا يِلْزِمْنَاشْ نْجَرْبُوا المَسِيحْ كِيمَا عَمْلُوا جْمَاعَة مِنْهُمْ، يَاخِي قَتْلِتْهُمْ اللْفَعْ. <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />ومَا تِتْشَكَّاوِشْ كِيفْ مَا تْشَكَّاوْ جْمَاعَة مِنْهُمْ، يَاخِي مَاتُوا عْلَى يِدْ مَلَاكْ المُوتْ. <verse eid="1CO 10:10" /><verse number="11" style="v" sid="1CO 10:11" />وصَارِلْهُمْ هَاذَا الكُلْ بَاشْ يْكُونْ عِبْرَة، وتْكْتِبْ بَاشْ يْنَبَّهْنَا أَحْنَا الِّي نْعِيشُوا فِي آخِرْ الزْمَانْ.<verse eid="1CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 10:12" />ولِّي مَاشِي فِي بَالُو الِّي هُوَّ وَاقِفْ، يْرُدْ بَالُو بَاشْ مَا يْطِيحِشْ. <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />المِحْنَة الِّي جَاتْكُمْ تْنَجِّمْ تْجِي لْأَيْ بَشَرْ، آمَا اللَّهْ أَمِينْ ومَا يْخَلِّيكُمْشْ تِتْعَدَّاوْ بْمِحْنَة فُوقْ مِنْ طَاقِتْكُمْ، آمَا وَقْتِلِّي اطِّيحُوا فِي مِحْنَة، يَعْطِيكُمْ مْعَاهَا كِيفَاشْ تُخْرْجُوا مِنْهَا، بَاشْ تْنَجْمُوا تِتْحَمْلُوهَا.<verse eid="1CO 10:13" /></para>
  <para style="s">أُهْرْبُوا مِنْ عْبَادِةْ الصْنَبْ</para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />هَاذَاكَا عْلَاشْ يَا حْبَابِي، أُهْرْبُوا مِنْ عْبَادِةْ الصْنَبْ. <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />آنَا نْكَلَّمْ فِيكُمْ كِيمَا نَاسْ فَاهْمِينْ، مَالَا أُحْكْمُوا إِنْتُومَا عَلِّي نْقُولْ فِيهْ: <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" />مُشْ كَاسْ البَرْكَة الِّي نُشْكْرُوا عْلِيهْ اللَّهْ ونُشْرْبُوا مِنُّو يْوَرِّي الِّي أَحْنَا وَاحِدْ مْعَ المَسِيحْ عْلَى طْرِيقْ دَمُّو؟ ومُشْ الخُبْزْ الِّي نَقْسْمُوهْ ونَاكْلُوهْ، يْوَرِّي الِّي أَحْنَا وَاحِدْ مْعَاهْ عْلَى طْرِيقْ بَدْنُو؟ <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />ومَادَامْ فَمَّة خُبْزْ وَاحِدْ، أَحْنَا الكُلْ نْكَوْنُوا بْدَنْ وَاحِدْ رَغْمِلِّي أَحْنَا بَرْشَة، عْلَى خَاطِرْنَا الكُلْنَا نِتْشَارْكُوا فِي الخُبْزْ هَاذَا.<verse eid="1CO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18" />شُوفُوا بَنِي إِسْرَائِيلْ: مُشْ الِّي يَاكْلُوا مِالذْبَايَحْ هُومَا مِتْشَارْكِينْ فِي تَقْدِيمْهَا عَالمَذْبَحْ؟ <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />شْنُوَّة قَصْدِي مَالَا؟ يَاخِي الصَّنْبَة عَنْدْهَا قِيمَة؟ وَلَّا الذْبِيحَة الِّي يَذْبْحُوهَالْهَا عَنْدْهَا قِيمَة؟ <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />بِالطْبِيعَة لَا! آمَا الِّي يِعْبْدُوا الصْنَبْ يَذْبْحُوا لِلشْوَاطِنْ، مُشْ لِلَّهْ. وآنَا مَا نْحِبْكُمْشْ تْكُونُوا مِتْشَارْكِينْ مْعَ الشْوَاطِنْ. <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />مَا تْنَجْمُوشْ تُشْرْبُوا مِنْ كَاسْ الرَّبْ ومِنْ كَاسْ الشْوَاطِنْ، ومَا تْنَجْمُوشْ تَاكْلُوا مِنْ طَاوِلْةْ الرَّبْ وطَاوِلْةْ الشْوَاطِنْ. <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />كَانْ نَعْمْلُوا هَاذَا، نِسْتْفَزُّوا الرَّبْ. وَلَّا بَالِكْ أَحْنَا أَقْوَى مِنُّو؟<verse eid="1CO 10:22" /></para>
  <para style="s">أَعْمْلُوا كُلْ شَيْ لْمَجْدْ اللَّهْ</para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />«كُلْ شَيْ حْلَالْ»، آمَا مُشْ كُلْ شَيْ يَنْفَعْ. «كُلْ شَيْ حْلَالْ»، آمَا مُشْ كُلْ شَيْ يِبْنِي. <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />مَا يِلْزِمْ حَتَّى وَاحِدْ يْلَوِّجْ عْلَى مَصْلَحْتُو، آمَا يْلَوِّجْ عْلَى مَصْلَحْةْ غِيرُو. <verse eid="1CO 10:24" /><verse number="25" style="v" sid="1CO 10:25" />كُولُوا مِاللْحَمْ الِّي يِتْبَاعْ فِي السُّوقْ ومَا تُقْعْدُوشْ تِسْأْلُوا عْلَى أَصْلُو مْنِينْ. كُولُوا وضَمِيرْكُمْ مِرْتَاحْ. <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />عْلَى خَاطِرْ مَكْتُوبْ: «الأَرْضْ ولِّي فِيهَا الكُلْ مِلْكْ لِلرَّبْ». <verse eid="1CO 10:26" /><verse number="27" style="v" sid="1CO 10:27" />وإِذَا اسْتَدْعَاكُمْ وَاحِدْ مُشْ مُؤْمِنْ ومْشِيتُوا بَحْذَاهْ، كُولُوا أَيْ حَاجَة يْحُطْهَالْكُمْ مِنْ غِيرْ مَا تِسْأْلُوا بَاشْ تْرَضِّيوْ ضَمِيرْكُمْ. <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />آمَا إِذَا كَانْ قَالِلْكُمْ وَاحِدْ: «الذْبِيحَة هَاذِي رَاهِي لِلصْنَبْ»، مَا تَاكْلُوشْ مِنْهَا، بَاشْ تْرَاعِيوْ الِّي قَالِلْكُمْ، وعْلَى خَاطِرْ رَاحِةْ الضَّمِيرْ، <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />ومَا نُقْصُدْشْ ضَمِيرْكُمْ إِنْتُومَا، آمَا ضَمِيرْ غِيرْكُمْ. عْلَى خَاطِرْ، عْلَاشْ ضَمِيرْ غِيرِي يُحْكُمْ فِي حُرِّيْتِي؟ <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />وإِذَا كْلِيتْ مَاكْلَة وشْكَرْتْ عْلِيهَا اللَّهْ، عْلَاشْ يْلُومُونِي عْلَى حَاجَة آنَا شْكَرْتْ عْلِيهَا اللَّهْ؟ <verse eid="1CO 10:30" /><verse number="31" style="v" sid="1CO 10:31" />هَاذَاكَا عْلَاشْ، كَانْ كْلِيتُوا وَلَّا شْرَبْتُوا، وَلَّا عْمَلْتُوا أَيْ حَاجَة، أَعْمْلُوا كُلْ شَيْ لْمَجْدْ اللَّهْ. <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />مَا تْكُونُوشْ إِنْتُومَا سْبَبْ عَثْرَة لِلْيْهُودْ ولَا لِلْمُشْ يْهُودْ ولَا لِكْنِيسِةْ اللَّهْ، <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />كِيمَا نَعْمِلْ آنَا زَادَا، نْحَاوِلْ بَاشْ نْرَضِّي النَّاسْ الكُلْ فِي أَيْ حَاجَة نَعْمِلْهَا، ومَا نْلَوَّجْشْ عْلَى مَصْلَحْتِي، آمَا نْلَوِّجْ عْلَى مَصْلَحْةْ أَكْثِرْ مَا يُمْكِنْ مِالنَّاسْ، فَمَّاشْ مَا يِنْجَاوْ.<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1" />خُوذُونِي مِثَالْ اتَّبْعُوهْ كِيفْ مَا آنَا مِثَالِي المَسِيحْ.<verse eid="1CO 11:1" /></para>
  <para style="s">العْبَادَة بِالنِّسْبَة لِلمْرَا ولِلرَّاجِلْ</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />يَعْطِيكُمْ الصَّحَّة عْلَى خَاطِرْكُمْ دِيمَا تِتْذَكْرُونِي فِي كُلْ شَيْ، ومْحَافْظِينْ عَالتَّعْلِيمْ كِيفْ مَا عْطِيتْهُولْكُمْ. <verse eid="1CO 11:2" /><verse number="3" style="v" sid="1CO 11:3" />آمَا نْحِبْكُمْ تَعْرْفُوا الِّي المَسِيحْ هُوَّ رَاسْ الرَّاجِلْ، والرَّاجِلْ رَاسْ المْرَا، واللَّهْ رَاسْ المَسِيحْ. <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />كُلْ رَاجِلْ يْصَلِّي وَلَّا يِتْنَبَّأْ ورَاسُو مْغُطِّي، يْجِيبْ العَارْ لِلْمَسِيحْ الِّي هُوَّ رَاسُو، <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />وكُلْ مْرَا تْصَلِّي وَلَّا تِتْنَبَّأْ ورَاسْهَا مُشْ مْغُطِّي تْجِيبْ العَارْ لْرَاجِلْهَا الِّي هُوَّ رَاسْهَا، كَايِنْهَا ڨَرْعِتْ شْعَرْهَا. <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />وإِذَا كَانْ المْرَا مَا تْغَطِّيشْ رَاسْهَا، خَلِّيهَا تْقُصْ شْعَرْهَا، ومَادَامْ عِيبْ عَالْمْرَا بَاشْ تْقُصْ شْعَرْهَا وَلَّا تْڨَرْعُو، مَالَا يِلْزِمْهَا تْغَطِّي رَاسْهَا. <verse eid="1CO 11:6" /><verse number="7" style="v" sid="1CO 11:7" />ومَا يِلْزِمْشْ الرَّاجِلْ يْغَطِّي رَاسُو عْلَى خَاطْرُو صُورِةْ اللَّهْ ومَجْدُو، آمَا المْرَا رَاهِي مَجْدْ الرَّاجِلْ، <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />عْلَى خَاطِرْ الرَّاجِلْ مَا تِخْلَقْشْ مِالمْرَا، آمَا المْرَا هِيَّ الِّي تْخَلْقِتْ مِالرَّاجِلْ، <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />والرَّاجِلْ مَا تِخْلَقْشْ عْلَى خَاطِرْ المْرَا، آمَا المْرَا هِيَّ الِّي تْخَلْقِتْ عْلَى خَاطِرْ الرَّاجِلْ. <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />هَاذَاكَا عْلَاشْ المْرَا يِلْزِمْهَا تْحُطْ عْلَى رَاسْهَا أَمَارِةْ السُّلْطَة، عْلَى خَاطِرْ المْلَايْكَة. <verse eid="1CO 11:10" /><verse number="11" style="v" sid="1CO 11:11" />آمَا فِي الرَّبْ، المْرَا مَا تِسْتَغْنَاشْ عَالرَّاجِلْ، والرَّاجِلْ مَا يِسْتَغْنَاشْ عَالمْرَا. <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />كِيفْ مَا المْرَا تْخَلْقِتْ مِالرَّاجِلْ، الرَّاجِلْ زَادَا يِتُولِدْ مِالمْرَا، آمَا اللَّهْ هُوَّ الِّي خْلَقْ كُلْ شَيْ.<verse eid="1CO 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13" />مَالَا أُحْكْمُوا إِنْتُومَا وَحَّدْكُمْ: يَاخِي يْجِي مِنُّو المْرَا تْصَلِّي لِلَّهْ ورَاسْهَا عِرْيَانْ؟ <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />مُشْ الطَّبِيعَة بِيدْهَا تْعَلَّمْنَا إِنُّو عِيبْ عَالرَّاجِلْ يْطَوِّلْ شَعْرُو؟ <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />آمَا بِالنِّسْبَة لِلْمَرْا، الشْعَرْ الطْوِيلْ مَجْدْ لِيهَا عْلَى خَاطِرْ اللَّهْ عْطَاهَا الشْعَرْ عِبَارَة عْلَى غْطَاء. <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />وإِذَا كَانْ وَاحِدْ يْحِبْ يَعْمِلْ مَشَاكِلْ بِخْصُوصْ المَوْضُوعْ هَاذَا، نْقُولُولُو الِّي مَا عَنْدْنَاشْ العَادَة هَاذِي، لَا أَحْنَا، ولَا كْنَايِسْ اللَّهْ.<verse eid="1CO 11:16" /></para>
  <para style="s">عْشَاء الرَّبْ</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />ومَانِيشْ بِشْ نَمْدَحْكُمْ فِي النْصَايَحْ الِّي بِشْ نَعْطِيهَالْكُمْ، عْلَى خَاطِرْ إِجْتِمَاعَاتْكُمْ تْضُرْ أَكْثِرْ مِلِّي تِنْفَعْ. <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />أَوِّلْ حَاجَة، سْمَعْتْ الِّي وَقْتِلِّي تِتْلَمُّوا فِي الكْنِيسَة، فَمَّة بِينَاتْكُمْ إِنْقِسَامَاتْ، وآنَا بْدِيتْ نْصَدَّقْ هَاذَا! <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />والمَشَاكِلْ هَاذِي لَا بُدَّا مِنْهَا، بَاشْ يْبَانْ شْكُونْ فِيكُمْ ثَابِتْ فِي الإِيمَانْ. <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />ولِّي تَعْمْلُوا فِيهْ وَقْتِلِّي تِتْلَمُّوا مْعَ بْعَضْكُمْ، مَا يِتْسَمَّاشْ عْشَاء الرَّبْ، <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />عْلَى خَاطِرْ وَقْتْ العْشَاء، كُلْ وَاحِدْ يِسْبَقْ ويَاكِلْ عْشَاهْ، وهَكَّا، فَمَّة شْكُونْ يُقْعُدْ جِيعَانْ، وفَمَّة شْكُونْ يُشْرُبْ حَتَّى يِسْكِرْ! <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />يَاخِي مَا عَنْدْكُمْشْ دْيَارْ تَاكْلُوا وتُشْرْبُوا فِيهَا؟ وَلَّا تِسْتْخَفُّوا بِكْنِيسِةْ اللَّهْ، وتْحَشْمُوا فِي النَّاسْ الِّي مَا عَنْدْهُمْشْ؟ شْنُوَّة نْقُولِلْكُمْ؟ نَمْدَحْكُمْ؟ مَا نَمْدَحْكُمْشْ عَالحَاجَة هَاذِي.<verse eid="1CO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23" />عْلَى خَاطِرْ الِّي خْذِيتُو مِنْ عَنْدْ الرَّبْ، هُوَّ الِّي عْطِيتْهُولْكُمْ. وهُوَّ إِنُّو الرَّبْ يَسُوعْ، فِي اللِّيلَة الِّي سَلْمُوهْ فِيهَا، خْذَا خُبْزْ، <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />وشْكَرْ، وقَسْمُو وقَالْ: «هَاذَا بَدْنِي الِّي نَعْطِيهْ عْلَى خَاطِرْكُمْ. أَعْمْلُوا هَاذَا بَاشْ تِتْذَكْرُونِي». <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />وزَادْ خْذَا الكَاسْ بَعْدْ العْشَاء وقَالْ: «هَاذَا الكَاسْ هُوَّ العَهْدْ الجْدِيدْ الِّي يَعْمْلُو اللَّهْ بْدَمِّي. كُلْ مَرَّة تُشْرْبُوا مِنُّو، أَعْمْلُوا هَاذَا بَاشْ تِتْذَكْرُونِي». <verse eid="1CO 11:25" /><verse number="26" style="v" sid="1CO 11:26" />مَالَا كُلْ مَا تَاكْلُوا الخُبْزْ هَاذَا وتُشْرْبُوا الكَاسْ هَاذَا، تْخَبْرُوا بْمُوتْ الرَّبْ، حَتَّى لِينْ يْجِي.<verse eid="1CO 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 11:27" />هَاذَاكَا عْلَاشْ الِّي يِسْتْخَفْ بْعْشَاء الرَّبْ، وَقْتِلِّي يَاكِلْ مِالخُبْزْ ويُشْرُبْ مِنْ كَاسْ الرَّبْ، رَاهُو مُذْنِبْ فِي حَقْ بْدَنْ الرَّبْ ودَمُّو. <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />مَالَا لَازِمْ الوَاحِدْ يْثَبِّتْ فِي تَصَرُّفَاتُو قْبَلْ، ومْبَعِّدْ يَاكِلْ مِالخُبْزْ ويُشْرِبْ مِالكَاسْ، <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />عْلَى خَاطِرْ الِّي يَاكِلْ ويُشْرِبْ مِنْ غِيرْ مَا يَعْرِفْ قِيمِةْ بْدَنْ الرَّبْ، رَاهُو قَاعِدْ يْجِيبْ فِي العِقَابْ لْرُوحُو. <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />هَاذَاكَا عْلَاشْ فِيكُمْ بَرْشَة نَاسْ مُرْضَى وضْعَافْ، فَمَّة حَتَّى الِّي مَاتُوا. <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />وكَانْ جِينَا نُحْكْمُوا عْلَى رْوَاحْنَا، رَاهُو مَا يِتْحْكَمْشْ عْلِينَا. <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />آمَا الرَّبْ يُحْكُمْ عْلِينَا ويْأَدَّبْنَا، بَاشْ مَا يِتْحْكَمْشْ عْلِينَا مْعَ العَالِمْ.<verse eid="1CO 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33" />مَالَا، يَا خْوَاتِي، وَقْتِلِّي تِتْلَمُّوا بَاشْ تَاكْلُوا، إِسْتَنَّاوْ بْعَضْكُمْ. <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />وإِذَا كَانْ وَاحِدْ فِيكُمْ جِيعَانْ، يَاكِلْ فِي دَارُو، بَاشْ اللَّهْ مَا يُحْكُمْشْ عْلِيكُمْ بِسْبَبْ لَمِّتْكُمْ. وبِخْصُوصْ الحَاجَاتْ الأُخْرَى تَوَّا انَّظَّمْهَا وَقْتِلِّي نْجِي.<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s">الهِيبَاتْ الرُّوحِيَّة</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />وبِخْصُوصْ الهِيبَاتْ الرُّوحِيَّة يَا خْوَاتِي، مَا نْحِبْكُمْشْ تِجْهْلُوا حْقِيقِتْهَا. <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />تَعْرْفُوا الِّي وَقْتِلِّي كُنْتُوا مَا تَعْرْفُوشْ اللَّهْ، كُنْتُوا كِي العْمِيْ اتَّبْعُوا فِي الصْنَبْ الِّي مَا تِتْكَلَّمْشْ. <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />هَاذَاكَا عْلَاشْ نْحِبْكُمْ تَعْرْفُوا الِّي مَا فَمَّة حَتَّى حَدْ يِتْكَلَّمْ بْرُوحْ اللَّهْ يْنَجِّمْ يْقُولْ: «يَسُوعْ أَنَاثِيمَا (مَعْنَاهَا مَلْعُونْ)!»، وزَادَا مَا يْنَجِّمْ حَتَّى حَدْ يْقُولْ الِّي يَسُوعْ رَبْ إِلَّا بِالرُّوحْ القُدُسْ.<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />الهِيبَاتْ فِيهَا بَرْشَة أَنْوَاعْ، آمَا الرُّوحْ الِّي يَعْطِيهَا وَاحِدْ. <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />وخِدْمِة الرَّبْ فِيهَا بَرْشَة أَنْوَاعْ، آمَا الرَّبْ الِّي نِخْدْمُوهْ وَاحِدْ. <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />والمُهِمَّاتْ بَرْشَة أَنْوَاعْ، آمَا الِّي يَعْطِينَا الكُلْ القُدْرَة بَاشْ نَعْمْلُوهَا هُوَّ إِلَاهْ وَاحِدْ. <verse eid="1CO 12:6" /><verse number="7" style="v" sid="1CO 12:7" />آمَا كُلْ وَاحِدْ يَاخِذْ هِيبَة تْظَهِّرْ الِّي الرُّوحْ القُدُسْ مَوْجُودْ فِيهْ، لْمَنْفَعْةْ النَّاسْ الكُلْ. <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />وَاحِدْ يَعْطِيهْ الرُّوحْ كْلَامْ حِكْمَة، والرُّوحْ نَفْسُو يَعْطِي لْوَاحِدْ آخِرْ كْلَامْ مَعْرْفَة. <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />والرُّوحْ نَفْسُو يَعْطِي هِيبِةْ إِيمَانْ لْوَاحِدْ ويَعْطِي هِيبِةْ شِفَاءْ لْوَاحِدْ آخِرْ، <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />ويَعْطِي لْوَاحِدْ القُدْرَة بَاشْ يَعْمِلْ مُعْجْزَاتْ، ولْوَاحِدْ آخِرْ بَاشْ يِتْنَبَّأْ، ولْوَاحِدْ بَاشْ يْفَرَّقْ بِينْ الأَرْوَاحْ، ولْوَاحِدْ آخِرْ بَاشْ يِتْكَلَّمْ بْلُوغَاتْ مُشْ مَعْرُوفَة، ولْآخِرْ بَاشْ يْتَرْجَمْهَا. <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />الحَاجَاتْ هَاذِي الكُلْ يَعْمِلْهَا نَفْسْ الرُّوحْ الوَاحِدْ، ويْفَرَّقْ الهِيبَاتْ عْلَى كُلْ وَاحِدْ كِيمَا يْحِبْ.<verse eid="1CO 12:11" /></para>
  <para style="s">الكُلْنَا أَعْضَاءْ فِي بْدَنْ المَسِيحْ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />وكِيمَا بْدَنْ الإِنْسَانْ هُوَّ بْدَنْ وَاحِدْ رَغْمِلِّي فِيهْ بَرْشَة أَعْضَاءْ، هَكَّا زَادَا بْدَنْ المَسِيحْ، رَغْمِلِّي فِيهْ بَرْشَة أَعْضَاءْ هُوَّ بْدَنْ وَاحِدْ. <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />وأَحْنَا الكُلْ، يْهُودْ وَلَّا مُشْ يْهُودْ، عَبِيدْ وَلَّا أَحْرَارْ، تْعَمِّدْنَا بْرُوحْ وَاحِدْ، بَاشْ نْوَلِّيوْ بْدَنْ وَاحِدْ، وتِرْوِينَا الكُلْ مِنْ رُوحْ وَاحِدْ.<verse eid="1CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14" />والبْدَنْ مُشْ عُضُوْ وَاحِدْ، آمَا بَرْشَة أَعْضَاءْ. <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />وكَانْ قَالِتْ السَّاقْ: «مَادَامْنِي مَانِيشْ يِدْ، مَالَا آنَا مَانِيشْ تَابْعَة لِلْبْدَنْ»، زَعْمَة هِيَّ بِالحَقْ مُشْ تَابْعَة البْدَنْ؟ <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />وكَانْ قَالِتْ الوْذِنْ: « مَادَامْنِي مَانِيشْ عِينْ، مَالَا آنَا مَانِيشْ تَابْعَة لِلْبْدَنْ»، زَعْمَة بِالحَقْ هِيَّ مُشْ تَابْعَة البْدَنْ؟ <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />إِذَا كَانْ البْدَنْ الكُلُّو عِينْ، كِيفَاشْ نِسْمْعُوا؟ وإِذَا كَانْ البْدَنْ الكُلُّو وْذِنْ، كِيفَاشْ نْشِمُّوا؟ <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />آمَا اللَّهْ حَطْ كُلْ عُضُوْ فِي البْدَنْ كِيفْ مَا حَبْ. <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />لَوْ كَانْ جَاوْ الكُلْهُمْ عُضُوْ وَاحِدْ، كِيفَاشْ هَاذَا يْكُونْ بْدَنْ؟ <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />فِي الحْقِيقَة فَمَّة بَرْشَة أَعْضَاءْ، آمَا بْدَنْ وَاحِدْ. <verse eid="1CO 12:20" /><verse number="21" style="v" sid="1CO 12:21" />مَا تْنَجَّمْشْ العِينْ تْقُولْ لِلْيِدْ: «مَا حَاشْتِيشْ بِيكْ». وَلَّا الرَّاسْ يْقُولْ لِلسَّاقِينْ: «مَا حَاشْتِيشْ بِيكُمْ!». <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />بِالعَكْسْ، حَتَّى أَعْضَاءْ البْدَنْ الِّي تُظْهْرِلْنَا ضْعِيفَة مَا انَّجْمُوشْ نِسْتَغْنَاوْ عْلِيهَا، <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />وأَعْضَاءْ البْدَنْ الِّي نَعْتَبْرُوهُمْ أَقَلْ أَهَمِيَّة نَعْطِيوْهُمْ كَرَامَة أَكْثِرْ، والأَعْضَاءْ الِّي مَا نْحِبُّوشْ نْوَرِّيْوهُمْ نَعَامْلُوهُمْ بْأَكْثِرْ إِحْتِرَامْ. <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />آمَا الِّي نْحِبُّوا نْوَرِّيوْهُمْ، مُشْ مِحْتَاجِينْ نْزِيدُوهُمْ إِحْتِرَامْ. واللَّهْ كَوِّنْ البْدَنْ بْطَرِيقَة عْطَى فِيهَا كَرَامَة أَكْثِرْ لِلْأَعْضَاءْ النَّاقْصَة أَهَمِيَّة، <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />بَاشْ مَا يْكُونِشْ فَمَّة إِنْقِسَامْ فِي البْدَنْ، آمَا الأَعْضَاءْ الكُلْ يِخْدْمُوا لْفَايِدْةْ بْعَضْهُمْ. <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />إِذَا كَانْ عُضُوْ يِتْوَجَّعْ، الأَعْضَاءْ الكُلْ تِتْوَجَّعْ مْعَاهْ، وإِذَا كَانْ عُضُوْ يَاخِذْ كَرَامَة، الأَعْضَاءْ الكُلْ تِفْرَحْ مْعَاهْ.<verse eid="1CO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27" />وفِي الحْقِيقَة إِنْتُومَا بْدَنْ المَسِيحْ، وكُلْ وَاحِدْ مِنْكُمْ هُوَّ عُضُوْ فِيهْ. <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" />واللَّهْ حَطْ نَاسْ فِي الكْنِيسَة، كُلْ وَاحِدْ ودَوْرُو: فِي الأُوِّلْ الرُّسُلْ، وبَعْدْهُمْ الأَنْبِيَاءْ، وبَعْدْهُمْ المُعَلْمِينْ، وبَعْدْهُمْ الِّي يَعْمْلُوا فِي المُعْجْزَاتْ، وبَعْدْهُمْ الِّي يِشْفِيوْ ولِّي يْعَاوْنُوا ولِّي يْنَظْمُوا ولِّي يِتْكَلْمُوا بْلُوغَاتْ مُشْ مَعْرُوفَة. <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />يَاخِي الكُلْهُمْ رُسُلْ؟ وَلَّا الكُلْهُمْ أَنْبِيَاءْ؟ وَلَّا الكُلْهُمْ مُعَلْمِينْ؟ وَلَّا الكُلْهُمْ يَعْمْلُوا فِي المُعْجْزَاتْ؟ <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />وَلَّا الكُلْ عَنْدْهُمْ هِيبِةْ الشِّفَاء؟ وَلَّا الكُلْ يِتْكَلْمُوا بْلُوغَاتْ مُشْ مَعْرُوفَة؟ وَلَّا الكُلْ يْتَرْجْمُوا؟ <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />آمَا إِنْتُومَا، أَسْعَاوْ لِلهِيبَاتْ الأَحْسِنْ، وآنَا نْوَرِّيكُمْ طْرِيقْ أَهَمْ.<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="s">المْحَبَّة</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />كَانْ جِيتْ نِتْكَلَّمْ بْلُوغَاتْ النَّاسْ والمْلَايْكَة، وآنَا مَا عَنْدِيشْ مْحَبَّة، مَانِي إِلَّا نْحَاسْ يْطَنْطِنْ وَلَّا نَاقُوزْ يْدَنْدِنْ. <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" />وكَانْ جَاتْ عَنْدِي هِيبِةْ النُّبُوَّة ونَعْرِفْ الأَسْرَارْ الكُلْ والعِلْمْ الكُلْ، وعَنْدِي إِيمَانْ يْنَقِّلْ الجْبَالْ مِنْ بْلَايِصْهَا، ومَا عَنْدِيشْ مْحَبَّة، آنَا حَتَّى شَيْ. <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />وكَانْ فَرَّقْتْ فْلُوسِي الكُلْ، وضَحِّيتْ بْبَدْنِي حَتَّى لِلْمُوتْ، ومَا عَنْدِيشْ مْحَبَّة، مَا نِسْتْفَادْ شَيْ.<verse eid="1CO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4" />المْحَبَّة تُصْبُرْ وتْحِنْ، المْحَبَّة مَا تِحْسِدْشْ، المْحَبَّة مَا تِتْفُوخِرْشْ ومَا تِتْكَبَّرْشْ. <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />المْحَبَّة مَا تِتْقَبَّحْشْ، ومَا تْلَوَّجْشْ عْلَى مَصْلْحِتْهَا، ومَا تِتْغَشَّشْ فِيسَعْ ومَا تْظُنِّشْ السُوءْ. <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />المْحَبَّة مَا تِفْرَحْشْ بِالظُّلْمْ، آمَا تِفْرَحْ بِالحَقْ. <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />المْحَبَّة تْسَامَحْ عْلَى كُلْ شَيْ، وتْصَدَّقْ كُلْ شَيْ، وعَنْدْهَا رْجَى فِي كُلْ شَيْ، وتُصْبِرْ عْلَى كُلْ شَيْ.<verse eid="1CO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8" />المْحَبَّة مَا تِفْنَاشْ بِالكُلْ. آمَا النُّبُوَاتْ تَاقِفْ، وهِيبِةْ اللُّوغَاتْ تِتْنَحَّى، والعِلْمْ يُوفَى. <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />تَوَّا، مَعْرْفِتْنَا نَاقْصَة ونُبُوَاتْنَا نَاقْصَة، <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />آمَا وَقْتِلِّي يْجِي الِّي هُوَّ كَامِلْ، يِتْنَحَّى كُلْ مَا هُوَّ نَاقِصْ. <verse eid="1CO 13:10" /><verse number="11" style="v" sid="1CO 13:11" />وَقْتِلِّي كُنْتْ طْفُلْ، كُنْتْ نِتْكَلَّمْ كِالطْفُلْ ونْحِسْ كِالطْفُلْ، ونْفَكِّرْ كِالطْفُلْ، آمَا وَقْتِلِّي وَلِّيتْ رَاجِلْ، بَطَّلْتْ حَاجَاتْ الصُغْرْ. <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />وأَحْنَا تَوَّا نْشُوفُوا فِي مْرَايَة تَصْوِيرَة مُشْ وَاضْحَة، آمَا نْهَارِتْهَا بِشْ نْشُوفُوا كُلْ شَيْ وَاضَحْ. تَوَّا مَعْرِفْتِي مَحْدُودَة، آمَا نْهَارِتْهَا بِشْ نَعْرِفْ كُلْ شَيْ كِيمَا اللَّهْ يَعْرِفْ عْلِيَّا كُلْ شَيْ.<verse eid="1CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13" />فِي الإِخِّرْ، الثْلَاثَة هَاذُمْ هُومَا الِّي بَاقِينْ: الإِيمَانْ والرْجَى والمْحَبَّة، وأَعْظِمْ وَحْدَة فِيهُمْ هِيَّ المْحَبَّة.<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s">هِيبَاتْ النُّبُوَّة والكْلَامْ بْلُوغَاتْ مُشْ مَعْرُوفَة</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />أَسْعَاوْ لِلْمْحَبَّة قْبَلْ كُلْ شَيْ، وأَسْعَاوْ زَادَا لِلهِيبَاتْ الرُّوحِيَّة، وبِالأَخَصْ هِيبِةْ النُّبُوَّة. <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />عْلَى خَاطِرْ الِّي يِتْكَلَّمْ بْلُوغَة مُشْ مَعْرُوفَة هُوَّ يْكَلَّمْ فِي اللَّهْ مُشْ فِي النَّاسْ، وحَتَّى حَدْ مَا يِفْهْمُو عْلَى خَاطْرُو يْقُولْ فِي أَسْرَارْ بِالرُّوحْ. <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />آمَا الِّي يِتْنَبَّأْ، هُوَّ يْكَلَّمْ فِي النَّاسْ بِكْلَامْ يْفِيدْ ويْشَجَّعْ ويْقَوِّي. <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />الِّي يِتْكَلَّمْ بْلُوغَاتْ يْفِيدْ رُوحُو، آمَا الِّي يِتْنَبَّأْ يْفِيدْ الكْنِيسَة. <verse eid="1CO 14:4" /><verse number="5" style="v" sid="1CO 14:5" />مَذَابِيَّا الكُلْكُمْ تِتْكَلْمُوا بْلُوغَاتْ، آمَا نْخَيِّرْ إِنْكُمْ تِتْنَبْؤُوا، عْلَى خَاطِرْ الِّي يِتْنَبَّأْ يِنْفَعْ أَكْثِرْ مِلِّي يِتْكَلَّمْ بْلُوغَاتْ، إِلَّا إِذَا كَانْ الِّي قَالُو يِتَّرْجِمْ، بَاشْ الكْنِيسَة تِسْتْفَادْ.<verse eid="1CO 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 14:6" />يَا خْوَاتِي، كَانْ جِيتْكُمْ آنَا وكَلَّمْتْكُمْ بْلُوغَاتْ مُشْ مَعْرُوفَة مِنْ غِيرْ مَا جِبْتِلْكُمْ وَحْيْ وَلَّا مَعْرْفَة وَلَّا نُبُوَّة وَلَّا تَعْلِيمْ، بِشْنُوَّة نِنْفَعْكُمْ؟ <verse eid="1CO 14:6" /><verse number="7" style="v" sid="1CO 14:7" />وكَانْ مَا جَاتِشْ آلَاتْ المُوسِيقَى الِّي هِيَّ جَمَادْ، كِيمَا النَّايْ وَلَّا القِيثَارَة، تْخَرِّجْ نَغْمَاتْ مُخْتَلْفَة، كِيفَاشْ يْنَجِّمْ الوَاحِدْ يْفَرَّقْ بِينَاتْهُمْ؟ <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />وإِذَا كَانْ بُوقْ الحَرْبْ صُوتُو مُشْ وَاضَحْ، شْكُونْ بِشْ يْحَضِّرْ رُوحُو لِلْحَرْبْ؟ <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />وإِنْتُومَا زَادَا، شْكُونْ بِشْ يِفْهِمْكُمْ كَانْ مَا تِتْكَلْمُوشْ بِكْلَامْ مَفْهُومْ؟ مُشْ كَايِنْكُمْ تِتْكَلْمُوا فِي الهْوَاء؟ <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />فَمَّة بَرْشَة لُوغَاتْ فِي العَالِمْ، ولَا وَحْدَة فِيهُمْ مَا عَنْدْهَاشْ مَعْنَى، <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />وإِذَا كَانْ مَا نِفْهِمْشْ مَعْنَى الكْلَامْ، نْكُونْ كِالأَجْنَبِيْ بِالنِّسْبَة لِلِّي يِتْكَلَّمْ، وهُوَّ زَادَا كِالأَجْنَبِيْ بِالنِّسْبَة لِيَّا. <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />مَالَا مَادَامْكُمْ مِتْشَوْقِينْ لِلْهِيبَاتْ الرُّوحِيَّة، أُطْلْبُوا مِنْ اللَّهْ يْزِيدْكُمْ فِي الهِيبَاتْ الِّي تِنْفَعْ الكْنِيسَة.<verse eid="1CO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13" />هَاذَاكَا عْلَاشْ الِّي يِتْكَلَّمْ بْلُوغَاتْ مُشْ مَعْرُوفَة، يِلْزْمُو يُطْلُبْ مِنْ اللَّهْ بَاشْ يَعْطِيهْ هِيبِةْ تَرْجْمِتْهَا. <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />عْلَى خَاطِرْ كَانْ نْصَلِّي بْلُوغَة مُشْ مَعْرُوفَة، رُوحِي هِيَّ الِّي تْصَلِّي، آمَا عَقْلِي مَا يِسْتْفَادْ شَيْ. <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />مَالَا شْنُوَّة الحَلْ؟ نْصَلِّي بِالرُّوحْ ونْصَلِّي بِالعْقَلْ زَادَا. ونْسَبَّحْ بِالرُّوحْ ونْسَبَّحْ بِالعْقَلْ زَادَا. <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />وكَانْ تِحْمِدْ اللَّهْ بِالرُّوحْ أَكَهَوْ، كِيفَاشْ يْنَجِّمْ المُؤْمِنْ الجْدِيدْ يْقُولْ «آمِينْ» وَقْتِلِّي تِحْمِدْ، وهُوَّ مُشْ فَاهِمْ آشْ قَاعِدْ تْقُولْ؟ <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />تْنَجِّمْ تْكُونْ حْمِدْتْ اللَّهْ بْطَرِيقَة هَايْلَة، آمَا غِيرِكْ مَا إِسْتَنْفَعْ بْشَيْ.<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />نِحْمِدْ اللَّهْ الِّي نِتْكَلَّمْ بْلُوغَاتْ مُشْ مَعْرُوفَة أَكْثِرْ مِنْكُمْ الكُلْ، <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />آمَا فِي الكْنِيسَة، نْخَيِّرْ نْقُولْ خَمْسَة كِلْمَاتْ مَفْهُومِينْ، نْعَلِّمْ بِيهُمْ النَّاسْ الأُخْرِينْ، أَحْسِنْ مِنْ 10 000 كِلْمَة بْلُوغَة مُشْ مَعْرُوفَة. <verse eid="1CO 14:19" /><verse number="20" style="v" sid="1CO 14:20" />يَا خْوَاتِي، مَا تْكُونُوشْ كِالصْغَارْ فِي طَرِيقِةْ تَفْكِيرْكُمْ، آمَا كُونُوا كِالصْغَارْ فِي فِعْلْ الشَّرْ، وكْبَارْ فِي تَفْكِيرْكُمْ. <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" />مَكْتُوبْ فِي الشَّرِيعَة:</para>
  <para style="b" vid="1CO 14:21" />
  <para style="q1" vid="1CO 14:21">«بِشْ نْكَلَّمْ الشَّعْبْ هَاذَا</para>
  <para style="q2" vid="1CO 14:21">عْلَى طْرِيقْ نَاسْ لُوغَاتْهُمْ غْرِيبَة</para>
  <para style="q1" vid="1CO 14:21">وعْلَى لْسَانْ أَجَانِبْ،</para>
  <para style="q2" vid="1CO 14:21">وحَتَّى هَكَّا مَاهُمْشْ بِشْ يِسْمْعُونِي،</para>
  <para style="q1" vid="1CO 14:21">يْقُولْ الرَّبْ».<verse eid="1CO 14:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22" />مَالَا، الكْلَامْ بْلُوغَاتْ مُشْ مَعْرُوفَة، هِيَّ عَلَامَة لْغِيرْ المُؤْمْنِينْ، مُشْ لِلْمُؤْمْنِينْ. آمَا هِيبِةْ النُّبُوَّة هِيَّ عَلَامَة لِلْمُؤْمْنِينْ، مُشْ لْغِيرْ المُؤْمْنِينْ. <verse eid="1CO 14:22" /><verse number="23" style="v" sid="1CO 14:23" />إِذَا تْلَمِّتْ الكْنِيسَة الكُلْ، وتْكَلْمُوا الكُلْ بْلُوغَاتْ مُشْ مَعْرُوفَة، ودَخْلُوا مُؤْمْنِينْ جْدُدْ وَلَّا مُشْ مُؤْمْنِينْ، زَعْمَة مَا يْقُولُوشْ عْلِيكُمْ مْهَبْلَة؟ <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />آمَا، كَانْ جَاوْ الكُلْ يِتْنَبْؤُوا ودْخَلْ وَاحِدْ مُشْ مُؤْمِنْ وَلَّا مُؤْمِنْ جْدِيدْ، ضَمِيرُو يْأَنْبُو والكْلَامْ الِّي يِسْمْعُو مِنْهُمْ الكُلْ يُحْكُمْ عْلِيهْ، <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />وهَكَّا تِتْكْشِفْ سْرَايِرْ قَلْبُو، ويِرْكَعْ لِلَّهْ يُسْجُدْلُو، ويِسْتَعْرِفْ الِّي اللَّهْ مَوْجُودْ فِي وِسْطْكُمْ بِالحَقْ.<verse eid="1CO 14:25" /></para>
  <para style="s">النِّظَامْ فِي العْبَادَة</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />مَالَا، شْنُوَّة الحَلْ يَا خْوَاتِي؟ وَقْتِلِّي تِتْلَمُّوا، ويِبْدَا كُلْ وَاحِدْ فِيكُمْ عَنْدُو تَرْنِيمَة، وَلَّا تَعْلِيمْ، وَلَّا نُبُوَّة، وَلَّا كْلَامْ بْلُوغَة مُشْ مَعْرُوفَة، وَلَّا تَرْجْمَة، خَلِّي كُلْ شَيْ يْكُونْ لِمَنْفَعْةْ المُؤْمْنِينْ. <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />كِي تِتْكَلْمُوا بْلُوغَاتْ مُشْ مَعْرُوفَة، خَلِّي أَكْثِرْ شَيْ اثْنِينْ وَلَّا ثْلَاثَة يِتْكَلْمُوا، بِالوَاحِدْ بِالوَاحِدْ، ووَاحِدْ مِنْكُمْ يْتَرْجِمْ. <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />وإِذَا كَانْ مَا فَمَّاشْ مُتَرْجِمْ، خَلِّي الِّي يِتْكَلَّمْ بِاللُّوغَاتْ يُسْكُتْ فِي الكْنِيسَة، ويِتْكَلَّمْ بِينُو وبِينْ اللَّهْ. <verse eid="1CO 14:28" /><verse number="29" style="v" sid="1CO 14:29" />آمَا الِّي يِتْنَبْؤُوا، خَلِّي اثْنِينْ وَلَّا ثْلَاثَة مِنْهُمْ يِتْكَلْمُوا، والبْقِيَّة يُحْكْمُوا عْلَى كْلَامْهُمْ. <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />وإِذَا كَانْ اللَّهْ عْطَى وَحْيْ لْوَاحِدْ آخِرْ، لَازِمْ الِّي قَاعِدْ يِتْكَلِّمْ يُسْكِتْ، <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />عْلَى خَاطِرْ الكُلْكُمْ تْنَجْمُوا تِتْنَبْؤُوا، بِالوَاحِدْ بِالوَاحِدْ، بَاشْ النَّاسْ الكُلْ يِتْعَلْمُوا ويِتْشَجْعُوا. <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />ولِّي يِتْنَبْؤُوا يْنَجْمُوا يِتْحَكْمُوا فِي هِيبِةْ النُّبُوَّة الِّي عَنْدْهُمْ، <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />عْلَى خَاطِرْ اللَّهْ مُشْ إِلَاهْ فَوْضَى، آمَا إِلَاهْ سَلَامْ.</para>
  <para style="p" vid="1CO 14:33">وكِيمَا فِي كْنَايِسْ القِدِّيسِينْ الكُلْ، <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />لَازِمْ النْسَاء يُسْكْتُوا فِي الإِجْتِمَاعَاتْ، عْلَى خَاطِرْ مُشْ مَسْمُوحِلْهُمْ يِتْكَلْمُوا. آمَا لَازِمْهُمْ يِخْضْعُوا كِيفْ مَا تْقُولْ الشَّرِيعَة. <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />وإِذَا كَانْ يْحِبُّوا يِتْعَلْمُوا حَاجَة، يِسْأْلُوا رْجَالْهُمْ فِي الدَّارْ، عْلَى خَاطِرْ عِيبْ المْرَا تِتْكَلَّمْ فِي الإِجْتِمَاعْ. <verse eid="1CO 14:35" /><verse number="36" style="v" sid="1CO 14:36" />يَاخِي كِلْمِةْ اللَّهْ جَاتْ مِنْ عَنْدْكُمْ إِنْتُومَا؟ وَلَّا جَاتْ لِيكُمْ إِنْتُومَا وَحَّدْكُمْ؟ <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />إِذَا وَاحِدْ يِحْسِبْ رُوحُو نَبِيْ وَلَّا عَنْدُو هِيبَة رُوحِيَّة، يِلْزْمُو يَعْرِفْ إِنُّو الِّي كْتِبْتْهُولْكُمْ هُوَّ وْصِيَّة مِنْ عَنْدْ الرَّبْ، <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />ولِّي مَا يِسْتَعْرَفْشْ بْهَاذَا، اتْجَاهْلُوهْ.<verse eid="1CO 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39" />مَالَا يَا خْوَاتِي، أَسْعَاوْ لْهِيبِةْ النُّبُوَة، ومَا تَمْنْعُوشْ الكْلَامْ بْلُوغَاتْ مُشْ مَعْرُوفَة. <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />آمَا لَازِمْ كُلْ شَيْ يِتْعْمَلْ بِإِحْتِرَامْ وبْنِظَامْ.<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s">المَسِيحْ قَامْ مِالمُوتْ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />نْذَكَّرْكُمْ، يَا خْوَاتِي، بِالبْشَارَة الِّي بَشَّرْتْكُمْ بِيهَا، ولِّي قْبِلْتُوهَا ومَزِّلْتُوا ثَابْتِينْ فِيهَا، <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />ولِّي تِنْجَاوْ بِيهَا زَادَا، كَانْ شَدِّيتُوا فِيهَا صْحِيحْ كِيمَا بَشَّرْتْكُمْ بِيهَا، وَلَّا إِيمَانْكُمْ يْكُونْ بَاطِلْ.<verse eid="1CO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3" />آنَا عْطِيتْكُمْ الِّي خْذِيتُو ولِّي هُوَّ مُهِمْ بَرْشَة: هُوَّ إِنُّو المَسِيحْ مَاتْ عْلَى خَاطِرْ ذْنُوبْنَا كِيمَا جَاء فِي الكْتُبْ المُقَدْسَة، <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" />وإِنُّو تِدْفِنْ وقَامْ فِي النْهَارْ الثَّالِثْ كِيفْ مَا جَاء فِي الكْتُبْ المُقَدْسَة، <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" />وإِنُّو ظْهُرْ لْبُطْرُسْ ولِلرُّسُلْ الأَثْنَاشْ. <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />ومْبَعِّدْ ظْهُرْ لْأَكْثِرْ مِنْ 500 وَاحِدْ مِالمُؤْمْنِينْ فَرْدْ مَرَّة، أَكْثَرْهُمْ مَزَّالُوا حَيِّينْ، آمَا فِيهُمْ الِّي مَاتُوا، <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />ومْبَعِّدْ ظْهُرْ لْيَعْقُوبْ، ومْبَعِّدْ لِلرُّسُلْ الكُلْ، <verse eid="1CO 15:7" /><verse number="8" style="v" sid="1CO 15:8" />وفِي الإِخِّرْ ظْهُرْ لِيَّا آنَا، كَايِنِّي صْغِيرْ تُولِدْ قْبَلْ وَقْتُو. <verse eid="1CO 15:8" /><verse number="9" style="v" sid="1CO 15:9" />وآنَا أَقَلْ قِيمَة مِنْ بْقِيِّةْ الرُّسُلْ، ومَا نِسْتَاهِلْشْ نِتْسَمَّى رَسُولْ عْلَى خَاطِرْنِي اضْطَهَدْتْ كْنِيسِةْ اللَّهْ. <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />آمَا بْنِعْمِةْ اللَّهْ وْصِلْتْ لِلِّي آنَا فِيهْ تَوَّا، والنِّعْمَة الِّي عْطَاهَالِي مَا كَانِتْشْ بْلَا فَايْدَة. عْلَى خَاطِرْنِي خْدِمْتْ أَكْثِرْ مِالرُّسُلْ الأُخْرِينْ الكُلْ، وفِي الحْقِيقَة مُشْ آنَا الِّي كُنْتْ نِخْدِمْ آمَا نِعْمِةْ اللَّهْ الِّي مْعَايَا. <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />وسِوَى آنَا وَلَّا هُومَا، هَاذِي هِيَّ البْشَارَة الِّي نْبَشْرُوا بِيهَا وهِيَّ الِّي أَمَّنْتُوا بِيهَا.<verse eid="1CO 15:11" /></para>
  <para style="s">المُوتَى يْقُومُوا مِالمُوتْ زَادَا</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />ومَادَامْنَا نْبَشْرُوا بِلِّي المَسِيحْ قَامْ مِنْ بِينْ المُوتَى، كِيفَاشْ جْمَاعَة مِنْكُمْ يْقُولُوا الِّي المُوتَى مَا يْقُومُوشْ؟ <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />إِذَا كَانْ المُوتَى مَا يْقُومُوشْ، مَعْنَاهَا المَسِيحْ زَادَا مَا قَامِشْ مِالمُوتْ. <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />ولَوْ كَانْ المَسِيحْ مَا قَامِشْ، رَاهُو تَبْشِيرْنَا بَاطِلْ وإِيمَانْكُمْ بَاطِلْ. <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />وأَكْثِرْ مِنْ هَكَّا: كَانْ جَاوْ بِالحَقْ المُوتَى مَا يْقُومُوشْ، نِطْلْعُوا أَحْنَا شْهِدْنَا بِالكِذْبْ عْلَى اللَّهْ، عْلَى خَاطِرْنَا شْهِدْنَا الِّي هُوَّ قَيِّمْ المَسِيحْ وَقْتِلِّي هُوَّ مَا قَيْمُوشْ. <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />وكَانْ المُوتَى مَا يْقُومُوشْ، مَالَا حَتَّى المَسِيحْ مَا قَامِشْ. <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />وإِذَا كَانْ المَسِيحْ مَا قَامِشْ، مَالَا إِيمَانْكُمْ بَاطِلْ، وإِنْتُومَا مَزِّلْتُوا فِي ذْنُوبْكُمْ، <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />والمُؤْمْنِينْ بِالمَسِيحْ الِّي مَاتُوا مْشَاوْ لِلْهْلَاكْ. <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />إِذَا كَانْ رْجَانَا فِي المَسِيحْ يِنْفَعْنَا كَانْ فِي الدِّنْيَا هَاذِي بَرْكْ، مَالَا أَحْنَا أَتْعِسْ النَّاسْ.<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />آمَا فِي الحْقِيقَة المَسِيحْ قَامْ مِالمُوتْ، وهَاذَا هُوَّ العَرْبُونْ إِنُّو الِّي مَاتُوا هُومَا زَادَا بِشْ يْقُومُوا. <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />عْلَى خَاطِرْ المُوتْ جَاتْ عْلَى طْرِيقْ إِنْسَانْ وَاحِدْ، والقْيَامَة مِنْ بِينْ المُوتَى زَادَا بِشْ تْكُونْ عْلَى طْرِيقْ إِنْسَانْ وَاحِدْ. <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />وكِيمَا النَّاسْ الكُلْ يْمُوتُوا بِسْبَبْ الِّي عَمْلُو آدَمْ، زَادَا النَّاسْ الِّي تَابْعِينْ المَسِيحْ الكُلْ بِشْ يْقُومُوا لِلْحَيَاةْ، <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />آمَا كُلْ وَاحِدْ ورُتْبْتُو: المَسِيحْ هُوَّ الأُوِّلْ عْلَى خَاطْرُو البِكْرْ، ومْبَعِّدْ، وَقْتِلِّي يِرْجَعْ، يْقُومُوا المُؤْمْنِينْ بِيهْ. <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />ومْبَعِّدْ تْجِي الآخْرَة، وَقْتِلِّي المَسِيحْ يَقْضِي عْلَى كُلْ رِئَاسَة وسُلْطَة وقُوَّة ويْسَلِّمْ المُلْكْ لِلَّهْ الآبْ، <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />عْلَى خَاطِرْ يِلْزِمْ المَسِيحْ يُمْلُكْ حَتَّى لِينْ يْحُطْ أَعْدَاؤُو الكُلْ تَحْتْ سَاقِيهْ. <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />وآخِرْ عْدُو يَقْضِي عْلِيهْ هُوَّ المُوتْ. <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />والكْتُبْ المُقَدْسَة تْقُولْ الِّي اللَّهْ: «حَطْ كُلْ شَيْ تَحْتْ سَاقِيهْ». وَقْتِلِّي يْقُولْ «كُلْ شَيْ»، وَاضِحْ إِنُّو يُقْصُدْ كُلْ شَيْ بِخْلَافْ اللَّهْ، الِّي حَطْ كُلْ شَيْ تَحْتْ سُلْطِةْ الإِبْنْ. <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />وَقْتِلِّي يْوَلِّي كُلْ شَيْ تَحْتْ سُلْطِةْ الإِبْنْ، هُوَّ بِيدُو بِشْ يْحُطْ رُوحُو تَحْتْ سُلْطِةْ اللَّهْ الِّي عْطَاهْ سُلْطَة عْلَى كُلْ شَيْ، بَاشْ هَكَّا يْكُونْ اللَّهْ هُوَّ الِّي يِمْلِكْ عَالكُلْ.<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />مَالَا كَانْ المُوتَى مَا يْقُومُوشْ، شْنُوَّة يِسْتْفَادُوا الِّي يِتْعَمْدُوا فِي عُوضْهُمْ؟ عْلَاشْ يِتْعَمْدُوا فِي بْلَاصِتْهُمْ؟ <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />وأَحْنَا، عْلَاشْ نْعَرْضُوا رْوَاحْنَا لِلْخْطَرْ فِي كُلْ لَحْظَة؟ <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />يَا خْوَاتِي، آنَا قَاعِدْ نْشُوفْ فِي المُوتْ كُلْ يُومْ، وهَاذِي حْقِيقَة كِي حْقِيقِةْ فُخْرْتِي بِيكُمْ فِي يَسُوعْ المَسِيحْ رَبْنَا، <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />وكَانْ جِيتْ حَارِبْتْ وُحُوشْ فِي أَفَسُسْ لْأَهْدَافْ بَشَرِيَّة بَرْكْ، شْنُوَّة إِسْتْفَدْتْ؟ إِذَا كَانْ المُوتَى مَا يْقُومُوشْ، مَالَا، خَلِّينَا نَاكْلُوا ونُشْرْبُوا عْلَى خَاطِرْ غُدْوَة بِشْ نْمُوتُوا.<verse eid="1CO 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33" />مَا تُغْلْطُوشْ، رَاهِي الخُلْطَة الخَايْبَة تْفَسِّدْ الأَخْلَاقْ البَاهْيَة. <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />إِرْجْعُوا لْعْقَلْكُمْ كِيمَا يِلْزِمْ ومَا تْزِيدُوشْ فِي الذْنُوبْ، عْلَى خَاطِرْ فِيكُمْ الِّي مَا يَعْرِفْشْ اللَّهْ. نْقُلْكُمْ هَاذَا بَاشْ نْحَشَّمْكُمْ عْلَى رْوَاحْكُمْ.<verse eid="1CO 15:34" /></para>
  <para style="s">بَانَا بْدَنْ يْقُومُوا المُوتَى؟</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />ويْقُولْ القَايِلْ: «كِيفَاشْ يْقُومُوا المُوتَى، وبْآنَا بْدَنْ يِرْجْعُوا؟». <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />يَا جَاهِلْ! الِّي تَزْرْعُو مَا يِنْبِتْ كَانْ بَعْدْمَا يْمُوتْ. <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />ولِّي تَزْرْعُو هُوَّ زِرِّيعَة، كِيمَا حَبِّةْ القَمْحْ وَلَّا أَيْ زِرِّيعَة أُخْرَى ومُشْ النَّبْتَة وهِيَّ كَامْلَة، <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />واللَّهْ هُوَّ الِّي يَعْطِيهَا الشَّكْلْ الِّي يْحِبْ عْلِيهْ، وكُلْ زِرِّيعَة عَنْدْهَا شَكْلْهَا. <verse eid="1CO 15:38" /><verse number="39" style="v" sid="1CO 15:39" />ومُشْ بْدَنَّاتْ المَخْلُوقَاتْ الكُلْ كِيفْ كِيفْ. الإِنْسَانْ عَنْدُو بْدَنْ، والحَيَوَانْ عَنْدُو بْدَنْ نَوْعْ آخِرْ. العْصَافِرْ عَنْدْهَا بْدَنْ، والحُوتْ عَنْدُو بْدَنْ نَوْعْ آخِرْ. <verse eid="1CO 15:39" /><verse number="40" style="v" sid="1CO 15:40" />فَمَّة كَوَاكِبْ فِي السْمَاء ومَخْلُوقَاتْ فِي الأَرْضْ. آمَا زِينْ الكَوَاكِبْ الِّي فِي السْمَاء مُشْ كِيفْ زِينْ المَخْلُوقَاتْ الِّي فِي الأَرْضْ. <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />الشَّمْسْ عَنْدْهَا زِينْ والڨَمْرَة عَنْدْهَا زِينْ آخِرْ، والنْجُومْ عَنْدْهَا زِينْ، وكُلْ نِجْمَة عَنْدْهَا زِينْ مُشْ كِيفْ الأُخْرَى.<verse eid="1CO 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42" />ونَفْسْ الشَّيْ بِالنِّسْبَة لِلِّي يْقُومُوا مِالمُوتْ: البْدَنْ يِتِدْفِنْ فَانِي ويْقُومْ بْدَنْ مَا يِفْنَاشْ. <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />يِتِدْفِنْ بْلَا مَجْدْ ويْقُومْ بْمَجْدْ، يِتِدْفِنْ ضْعِيفْ ويْقُومْ قْوِي. <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />يِتِدْفِنْ بْدَنْ بَشَرِي، ويْقُومْ بْدَنْ رُوحِي. وكِيمَا فَمَّة بْدَنْ بَشَرِي، فَمَّة زَادَا بْدَنْ رُوحِي. <verse eid="1CO 15:44" /><verse number="45" style="v" sid="1CO 15:45" />وهَاذَا عْلَاشْ مَكْتُوبْ: «وَلَّى آدَمْ، الإِنْسَانْ الأُوْلَانِي، نَفْسْ حَيَّة»، ووَلَّى آدَمْ الإِخْرَانِي الرُّوحْ الِّي يَعْطِي الحَيَاةْ. <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />ومُشْ الرُّوحِي هُوَّ الِّي جَاء فِي الأُوِّلْ، البَشَرِي هُوَّ الأُوِّلْ وبَعْدُو جَاء الرُّوحِي. <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />الإِنْسَانْ الأُوِّلْ تِخْلَقّْ مِالتْرَابْ، مَالَا هُوَّ مِالأَرْضْ. والإِنْسَانْ الثَّانِي جَاء مِالسْمَاء. <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />والنَّاسْ الِّي تَابْعِينْ الأَرْضْ هُومَا كِيمَا الإِنْسَانْ الِّي مِالتْرَابْ، ولِّي تَابْعِينْ السْمَاء هُومَا كِيمَا الإِنْسَانْ الِّي جَاء مِالسْمَاء. <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />وكِيمَا كُنَّا كِيفْ الِّي جَاء مِالتْرَابْ، بِشْ نْوَلِّيوْ زَادَا كِيفْ الِّي جَاء مِالسْمَاء.<verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />ونْقُلْكُمْ، يَا خْوَاتِي، الإِنْسَانْ الِّي مِنْ لْحَمْ ودَمْ مَا يْنَجَّمْشْ يُورِثْ مَمْلَكْةْ اللَّهْ، والفَانِي مَا يْنَجَّمْشْ يُورِثْ الِّي مَا يِفْنَاشْ. <verse eid="1CO 15:50" /><verse number="51" style="v" sid="1CO 15:51" />إِسْمْعُوا السِّرْ هَاذَا: مُشْ الكُلْنَا بِشْ نْمُوتُوا، آمَا الكُلْنَا بِشْ نِتْبَدْلُوا <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />فِي لَحْظَة، فِي رَمْشِةْ عِينْ، مْعَ صُوتْ البُوقْ الإِخْرَانِي. عْلَى خَاطِرْ صُوتْ البُوقْ بِشْ يَعْلَى، ويْقُومُوا المُوتَى بِبْدَنَّاتْ مَا تِفْنَاشْ، آمَا أَحْنَا نِتْبَدْلُوا. <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />عْلَى خَاطِرْ يِلْزِمْ البْدَنْ هَاذَا الِّي يِفْسِدْ يْوَلِّي مَا يِفْسِدْشْ، والفَانِي هَاذَا يْوَلِّي مَا يِفْنَاشْ. <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" />وبَعْدْمَا الِّي يِفْسِدْ يْوَلِّي مَا يِفْسِدْشْ ، والفَانِي يْوَلِّي مَا يِفْنَاشْ، يْتِمْ الِّي تِكْتِبْ فِي الكْتُبْ المُقَدْسَة:</para>
  <para style="b" vid="1CO 15:54" />
  <para style="q1" vid="1CO 15:54">«الإِنْتِصَارْ قْهَرْ المُوتْ بِالكَامِلْ».<verse eid="1CO 15:54" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="55" style="v" sid="1CO 15:55" />«يَا مُوتْ وِينِي شُوكْتِكْ؟</para>
  <para style="q2" vid="1CO 15:55">ويَا مُوتْ وِينِي قُوْتِكْ؟»<verse eid="1CO 15:55" /></para>
  <para style="b" />
  <para style="m">
    <verse number="56" style="v" sid="1CO 15:56" />والخَطِيئَة هِيَّ الِّي عْطَاتْ لِلْمُوتْ شُوكِتْهَا والشَّرِيعَة هِيَّ الِّي عْطَاتْ لِلْخَطِيئَة قُوِّتْهَا. <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />آمَا نِحْمْدُوا اللَّهْ الِّي يُنْصُرْنَا بْرَبْنَا يَسُوعْ المَسِيحْ.<verse eid="1CO 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58" />مَالَا يَا خْوَاتِي العْزَازْ عْلِيَّا، كُونُوا ثَابْتِينْ ومَا تْخَلِّيوْ حَتَّى شَيْ يْزَحْزَحْكُمْ، وكُونُوا دِيمَا مُجْتَهْدِينْ فِي خِدْمِةْ الرَّبْ، عَارْفِينْ الِّي تْعَبْكُمْ مُشْ بِشْ يِمْشِي خْسَارَة.<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s">لَمَّانْ التَّبَرُّعَاتْ لِلْمُؤْمْنِينْ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />وبِخْصُوصْ لَمَّانْ التَّبَرُّعَاتْ لِلْقِدِّيسِينْ، أَعْمْلُوا إِنْتُومَا زَادَا كِيفْ مَا وَصِّيتْ الكْنَايِسْ فِي غَلَاطْيَة. <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />فِي النْهَارْ الأُوِّلْ مِنْ كُلْ جُمْعَة، كُلْ وَاحِدْ فِيكُمْ يْحُطْ عْلَى جْنَبْ الفْلُوسْ الِّي يَقْدِرْ عْلِيهُمْ، بَاشْ مَا يْكُونِشْ لَمَّانْ الفْلُوسْ نْهَارِةْ الِّي نْجِي. <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />ووَقْتِلِّي نْجِي، نِبْعَثْ تَبَرُّعَاتْكُمْ لْأُورْشَلِيمْ مْعَ النَّاسْ الِّي تِخْتَارُوهُمْ إِنْتُومَا ونَبْعَثْ مْعَاهُمْ رَسَايِلْ. <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />وكَانْ الأُمُورْ تِسْتْحَقْ إِنِّي آنَا نْسَافِرْ يْوَلِّيوْ يِمْشِيوْ مْعَايَا.<verse eid="1CO 16:4" /></para>
  <para style="s">بُولِسْ نَاوِي يْزُورْهُمْ</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />آمَا بِشْ نْجِيكُمْ بَعْدْمَا نِتْعَدَّى عْلَى مَقْدُونِيَّة، عْلَى خَاطِرْنِي بِشْ نِتْعَدَّى مِنْ غَادِي. <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />مُمْكِنْ نُقْعِدْ مْعَاكُمْ مُدَّة، وَلَّا نْعَدِّي الشْتَاء الكُلْ بَحْذَاكُمْ بَاشْ تْعَاوْنُونِي نْكَمِّلْ نْسَافِرْ لْوِينْ مَاشِي. <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />عْلَى خَاطِرْ المَرَّة هَاذِي مَا نْحِبِّشْ نْشُوفْكُمْ شْوَيَّة ونِتْعَدَّى. نْحِبْ نُقْعِدْ بَحْذَاكُمْ مُدَّة طْوِيلَة كَانْ الرَّبْ سَهِّلْ. <verse eid="1CO 16:7" /><verse number="8" style="v" sid="1CO 16:8" />آمَا تَوَّا، بِشْ نُقْعِدْ فِي أَفَسُسْ حَتَّى لْعِيدْ يُومْ الخَمْسِينْ، <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />عْلَى خَاطِرْ اتْحَلِّي بَابْ وَاسَعْ لِلْخِدْمَة، وزَادَا فَمَّة بَرْشَة مْعَارْضِينْ.<verse eid="1CO 16:9" /></para>
  <para style="s">بُولِسْ يْوَصِّي فِي المُؤْمْنِينْ</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />وإِذَا كَانْ جَاكُمْ تِيمُوثَاوُسْ، خَلِّيوَهْ يْكُونْ مِرْتَاحْ عَنْدْكُمْ، عْلَى خَاطْرُو يِخْدِمْ فِي الرَّبْ كِيفِي. <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />وحَتَّى وَاحِدْ مَا يَحْقْرُو، آمَا عَاوْنُوهْ فِي السْفَرْ بَاشْ يِرْجَعْلِي وقَلْبُو مُطْمَانْ، رَانِي آنَا والإِخْوَة نِسْتَنَّاوْ فِيهْ. <verse eid="1CO 16:11" /><verse number="12" style="v" sid="1CO 16:12" />وبِالنِّسْبَة لْخُونَا أَبُلُّوسْ، طْلَبْتْ مِنُّو بَرْشَة مَرَّاتْ بَاشْ يْجِيكُمْ مْعَ الإِخْوَة، آمَا مَا حَبِّشْ يْجِي تَوَّا. وَقْتِلِّي يَلْقَى فُرْصَة مُنَاسْبَة تَوَّا يْجِيكُمْ.<verse eid="1CO 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />خَلِّيكُمْ فَايْقِينْ وإِثْبْتُوا فِي الإِيمَانْ، كُونُوا رْجَالْ، كُونُوا قْوِيِّينْ، <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />أَعْمْلُوا كُلْ شَيْ بِمْحَبَّة.<verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15" />يَا خْوَاتِي، إِنْتُومَا تَعْرْفُوا عَايِلْةْ إِسْتِفَانَاسْ، هُومَا أَوِّلْ نَاسْ أَمْنُوا بِالمَسِيحْ فِي مَنْطَقْةْ أَخَائِيَة، وهُومَا خَصْصُوا رْوَاحْهُمْ بَاشْ يِخْدْمُوا القِدِّيسِينْ. <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />هَاذَاكَا عْلَاشْ نُطْلُبْ مِنْكُمْ تِخْضْعُولْهُمْ هُومَا ولِّي كِيفْهُمْ ولِلِّي يِخْدْمُوا ويِتْعْبُوا مْعَاهُمْ الكُلْ. <verse eid="1CO 16:16" /><verse number="17" style="v" sid="1CO 16:17" />فْرَحْتْ بْجَيَّانْ إِسْتِفَانَاسْ وفُرْتُونَاتُوسْ وأَخَائِيكُوسْ، عْلَى خَاطِرْهُمْ عَوْضُوكُمْ وَقْتِلِّي إِنْتُومَا غَايْبِينْ، <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />ورَتْحُوا قَلْبِي كِيفْ مَا رَتْحُوا قْلُوبْكُمْ. أَعْرْفُوا كِيفَاشْ تِكْرْمُوا النَّاسْ الِّي كِيفْهُمْ.<verse eid="1CO 16:18" /></para>
  <para style="s">سْلَامْ</para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />يْسَلْمُوا عْلِيكُمْ المُؤْمْنِينْ الِّي فِي كَنَايِسْ آسِيَّا، وأَكِيلَا وبْرِيسْكِلَّا والكْنِيسَة الِّي تِتْلَمْ فِي دَارْهُمْ يْسَلْمُوا عْلِيكُمْ بَرْشَة فِي إِسْمْ الرَّبْ. <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />يْسَلْمُوا عْلِيكُمْ الإِخْوَة الِّي هُونِي الكُلْ. سَلْمُوا عْلَى بْعَضْكُمْ بْبُوسَة طَاهْرَة. <verse eid="1CO 16:20" /><verse number="21" style="v" sid="1CO 16:21" />آنَا بُولِسْ نِكْتْبِلْكُمْ السْلَامْ هَاذَا بْخَطْ يِدِّي. <verse eid="1CO 16:21" /><verse number="22" style="v" sid="1CO 16:22" />ولِّي مَا يْحِبِّشْ الرَّبْ، خَلِّيهْ يْكُونْ أَنَاثِيمَا (مَعْنَاهَا مَلْعُونْ)! مَارَانَاتَا (مَعْنَاهَا يَا رَبْ إِيجَا)! <verse eid="1CO 16:22" /><verse number="23" style="v" sid="1CO 16:23" />نِعْمِةْ الرَّبْ يَسُوعْ المَسِيحْ تْكُونْ مْعَاكُمْ. <verse eid="1CO 16:23" /><verse number="24" style="v" sid="1CO 16:24" />مْعَ مْحَبْتِي لِيكُمْ الكُلْ فِي يَسُوعْ المَسِيحْ. آمِينْ.<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>