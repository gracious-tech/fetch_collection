<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2PE" style="id" />
  <para style="h">بُطْرُسْ الثَّانْيَة</para>
  <para style="toc1">رِسَالِةْ بُطْرُسْ الثَّانْيَة</para>
  <para style="toc2">بُطْرُسْ الثَّانْيَة</para>
  <para style="toc3">بُطْرُسْ الثَّانْيَة</para>
  <para style="mt">رِسَالِةْ بُطْرُسْ الثَّانْيَة</para>
  <chapter number="1" style="c" sid="2PE 1" />
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1" />مِنْ سِمْعَانْ بُطْرُسْ، خَادِمْ ورَسُولْ يَسُوعْ المَسِيحْ، لِلنَّاسْ الِّي خْذَاوْ كِيفْنَا نَفْسْ الإِيمَانْ الغَالِي، بْصَلَاحْ إِلَاهْنَا ومُنَجِّينَا يَسُوعْ المَسِيحْ.<verse eid="2PE 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2" />يْزِيدْكُمْ اللَّهْ نِعْمَة وسَلَامْ، بْمَعْرْفِتْكُمْ لِلَّهْ ولْرَبْنَا يَسُوعْ.<verse eid="2PE 1:2" /></para>
  <para style="s">اللَّهْ دْعَاكُمْ وإِخْتَارْكُمْ</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3" />اللَّهْ عْطَانَا بْقُدْرْتُو الإِلَهِيَّة، كُلْ مَا نَحْتَاجُوا بَاشْ نْعِيشُوا حْيَاةْ التَّقْوَى. وهَاذَا عْلَى خَاطْرُو عَرَّفْنَا عَلِّي دْعَانَا بْمَجْدُو وصَلَاحُو، <verse eid="2PE 1:3" /><verse number="4" style="v" sid="2PE 1:4" />ولِّي بِيهُمْ عْطَانَا وُعُودْ عْظِيمَة وغَالْيَة. والوُعُودْ هَاذِي بِشْ تْخَلِّيكُمْ تِتْحَرْرُوا مِالفْسَادْ المَوْجُودْ فِي العَالِمْ بِسْبَبْ الشَّهْوَة وتْوَلِّيوْ مْشَارْكِينْ اللَّهْ فِي طَبِيعْتُو الإِلَهِيَّة.<verse eid="2PE 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="2PE 1:5" />هَاذَاكَا عْلَاشْ أَعْمْلُوا مَجْهُودْكُمْ</para>
  <para style="q2" vid="2PE 1:5">بَاشْ تْزِيدُوا لْإِيمَانْكُمْ صَلَاحْ، ولْصَلَاحْكُمْ مَعْرْفَة،<verse eid="2PE 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="2PE 1:6" />ولِلْمَعْرْفَة تَحَكُّمْ فِي النَّفْسْ،</para>
  <para style="q2" vid="2PE 1:6">ولِلتَّحَكُّمْ فِي النَّفْسْ صَبْرْ،</para>
  <para style="q1" vid="2PE 1:6">ولِلصَّبْرْ التَّقْوَى،<verse eid="2PE 1:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="2PE 1:7" />ولِلتَّقْوَى مْعَزِّةْ الإِخْوَة،</para>
  <para style="q1" vid="2PE 1:7">ولِمْعَزِّةْ الإِخْوَة المْحَبَّة.<verse eid="2PE 1:7" /></para>
  <para style="b" />
  <para style="m">
    <verse number="8" style="v" sid="2PE 1:8" />عْلَى خَاطِرْ، إِذَا كَانِتْ الصِّفَاتْ البَاهْيَة هَاذِي مَوْجُودَة فِيكُمْ، وقَاعْدَة تْزِيدْ، بِشْ تْخَلِّيكُمْ نَافْعِينْ ومُثْمْرِينْ فِي مَعْرْفِتْكُمْ لْرَبْنَا يَسُوعْ المَسِيحْ . <verse eid="2PE 1:8" /><verse number="9" style="v" sid="2PE 1:9" />آمَا الِّي مَا عَنْدُوشْ الصِّفَاتْ هَاذِي رَاهُو مَا يْرَاشْ مْلِيحْ وأَعْمَى رُوحِيًّا، ونْسَى الِّي هُوَّ إِطَّهِّرْ مِنْ ذْنُوبُو القْدِيمَة.<verse eid="2PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10" />هَاذَاكَا عْلَاشْ، يَا خْوَاتِي، إِجْتَهْدُوا أَكْثِرْ مَا يُمْكِنْ بَاشْ تْبَيْنُوا الِّي اللَّهْ دْعَاكُمْ وإِخْتَارْكُمْ بِالحَقْ. رَاكُمْ كَانْ تَعْمْلُوا هَاذَا، عْمُرْكُمْ مَا بِشْ تَعْثْرُوا واطِّيحُوا. <verse eid="2PE 1:10" /><verse number="11" style="v" sid="2PE 1:11" />وهَكَّا يِتْحَلِّلْكُمْ بَابْ وَاسَعْ بَاشْ تُدْخْلُوا لِلْمَمْلْكَة الأَبَدِيَّة، مَمْلَكْةْ يَسُوعْ المَسِيحْ، رَبْنَا ومُنَجِّينَا.<verse eid="2PE 1:11" /></para>
  <para style="s">وَحْيْ الكْتُبْ المُقَدْسَة</para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12" />هَاذَاكَا عْلَاشْ نْحِبْ دِيمَا نْذَكَّرْكُمْ بِالأُمُورْ هَاذِيَّ، رَغْمِلِّي إِنْتُومَا تَعْرْفُوهَا وثَابْتِينْ فِي الحَقْ الِّي وْصِلِّلْكُمْ. <verse eid="2PE 1:12" /><verse number="13" style="v" sid="2PE 1:13" />ومَادَامْنِي مَزِّلْتْ حَيْ، نْرَى الِّي مِنْ وَاجْبِي نْذَكَّرْكُمْ بِيهَا. <verse eid="2PE 1:13" /><verse number="14" style="v" sid="2PE 1:14" />آنَا نَعْرِفْ الِّي حْيَاتِي عَالأَرْضْ هَاذِي قْرِيبْ تُوفَى، كِيمَا سْبَقْ ووَرَّانِي رَبْنَا يَسُوعْ المَسِيحْ. <verse eid="2PE 1:14" /><verse number="15" style="v" sid="2PE 1:15" />وهَاذَاكَا عْلَاشْ قَاعِدْ نَعْمِلْ فِي جِهْدِي بَاشْ نْذَكَّرْكُمْ بِالأُمُورْ هَاذِي، بَاشْ تُقْعْدُوا مِتْذَكْرِينْهَا حَتَّى بَعْدْمَا نْمُوتْ.<verse eid="2PE 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16" />وأَحْنَا، وَقْتِلِّي حْكِينَالْكُمْ عْلَى قُوِّةْ رَبْنَا يَسُوعْ المَسِيحْ ورْجُوعُو المَجِيدْ، مَا كُنَّاشْ نَحْكِيوْلْكُمْ عْلَى خْرَافَاتْ مْلَفْقَة، آمَا حْكِينَالْكُمْ بْصِيفِتْنَا كُنَّا حَاضْرِينْ ورِينَا بْعِينِينَا قَدَّاشْ المَسِيحْ عْظِيمْ. <verse eid="2PE 1:16" /><verse number="17" style="v" sid="2PE 1:17" />عْلَى خَاطْرُو خْذَا مِنْ عَنْدْ اللَّهْ الآبْ كَرَامَة ومَجْدْ وَقْتِلِّي جَاهْ صُوتْ مِالمَجْدْ العْظِيمْ وقَالْ: «هَاذَا هُوَّ إِبْنِي الِّي نْحِبُّو ولِّي فَرْحَانْ بِيهْ». <verse eid="2PE 1:17" /><verse number="18" style="v" sid="2PE 1:18" />وأَحْنَا بِيدْنَا سْمَعْنَا الصُّوتْ هَاذَا جَايْ مِالسْمَاء، وَقْتِلِّي كُنَّا مْعَاهْ فِي الجْبَلْ المُقَدَّسْ.<verse eid="2PE 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19" />وهَكَّا، زِدْنَا تْأَكَدْنَا مِنْ صِحِّةْ كْلَامْ الأَنْبِيَاءْ. هَاذَاكَا عْلَاشْ بَاهِي كَانْ تِنْتَبْهُولُو عْلَى خَاطْرُو كِالفْنَارْ الِّي يِضْوِي فِي الظْلَامْ حَتَّى لِينْ يِطْلَعْ النْهَارْ وتِضْوِي نِجْمِةْ الصْبَاحْ فِي قْلُوبْكُمْ. <verse eid="2PE 1:19" /><verse number="20" style="v" sid="2PE 1:20" />آمَا قْبَلْ كُلْ شَيْ، نْحِبْكُمْ تَعْرْفُوا الِّي حَتَّى وَاحِدْ مَا يْنَجِّمْ يْفَسِّرْ حَتَّى نُبُوَّة مِالكْتُبْ المُقَدْسَة حَسْبْ مُخُّو. <verse eid="2PE 1:20" /><verse number="21" style="v" sid="2PE 1:21" />عْلَى خَاطِرْ مَا فَمَّة حَتَّى نُبُوَّة جَاتْ مِنْ عَنْدْ إِنْسَانْ، آمَا الرُّوحْ القُدُسْ هُوَّ الِّي خَلَّى رْجَالْ اللَّهْ الصَّالْحِينْ يِتْكَلْمُوا بِكْلَامْ اللَّهْ.<verse eid="2PE 1:21" /></para>
  <chapter eid="2PE 1" />
  <chapter number="2" style="c" sid="2PE 2" />
  <para style="s">المُعَلْمِينْ الكَذَّابِينْ ومَصِيرْهُمْ</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1" />وكِيفْ مَا كَانُوا أَنْبِيَاءْ كَذَّابِينْ فِي وِسْطْ الشَّعْبْ قْبَلْ، بِشْ يُظْهْرُوا فِي وِسْطْكُمْ زَادَا مُعَلْمِينْ كَذَّابِينْ، بِشْ يْجِيبُولْكُمْ تَعَالِيمْ غَالْطَة إِدَّمِّرْ النَّاسْ، وبِشْ يُنْكْرُوا حَتَّى الرَّبْ الِّي فْدَاهُمْ. وهَكَّا، بِشْ يِدَّمْرُوا فِيسَعْ . <verse eid="2PE 2:1" /><verse number="2" style="v" sid="2PE 2:2" />وبَرْشَة نَاسْ بِشْ يْتَبْعُوهُمْ فِي الفَاحْشَة، وبِشْ يْسِبُّوا طْرِيقْ الحَقْ بِسْبَبْهُمْ. <verse eid="2PE 2:2" /><verse number="3" style="v" sid="2PE 2:3" />وعْلَى خَاطِرْهُمْ طَمَّاعِينْ، قَاعْدِينْ يْطَلْعُوا فِي حْكَايَاتْ مِنْ رْيُوسْهُمْ بَاشْ يِسْتْغَلُّوكُمْ. هَاذَاكَا عْلَاشْ، عِقَابْ اللَّهْ يِسْتَنَّى فِيهُمْ مِنْ قْدِيمْ الزْمَانْ. وهُومَا هَالْكِينْ، لَا مَحَالَة.<verse eid="2PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4" />اللَّهْ مَا حَنِّشْ حَتَّى عَالمْلَايْكَة الِّي أَذْنْبُوا، بِالعَكْسْ، رْبَطْهُمْ بِسْلَاسِلْ فِي قَلْبْ الظْلَامْ ورْمَاهُمْ فِي جْهَنِّمْ، وِينْ بِشْ يُقْعْدُوا حَتَّى لِنْهَارْ الحْسَابْ. <verse eid="2PE 2:4" /><verse number="5" style="v" sid="2PE 2:5" />واللَّهْ مَا حَنِّشْ عَالعَالِمْ قْبَلْ، وغَرْقُو بِالطُّوفَانْ بِسْبَبْ الفْسَادْ، مَا عَدَا ثْمَنْيَة مِالنَّاسْ، مِنْ بِينْهُمْ نُوحْ، الِّي كَانْ يِدْعِي فِي النَّاسْ لِلصَّلَاحْ. <verse eid="2PE 2:5" /><verse number="6" style="v" sid="2PE 2:6" />واللَّهْ عَاقِبْ بُلْدَانْ سَدُومْ وعَمُورَة، وحْرَقْهُمْ ورَدْهُمْ رْمَادْ، بَاشْ يْكُونُوا عِبْرَة لِلِّي يْعِيشُوا حْيَاةْ الفْسَادْ كِيفْهُمْ، <verse eid="2PE 2:6" /><verse number="7" style="v" sid="2PE 2:7" />آمَا مَنَّعْ لُوطْ الصَّالَحْ، الِّي كَانْ مِتْقَلَّقْ ومِتْعَذَّبْ مِنْ حَالِةْ الشَّرْ والفَاحْشَة الِّي كَانُوا عَايْشِينْ فِيهَا. <verse eid="2PE 2:7" /><verse number="8" style="v" sid="2PE 2:8" />وعْلَى خَاطْرُو كَانْ رَاجِلْ صَالَحْ وسَاكِنْ بِينَاتْهُمْ، كَانِتْ رُوحُو الصَّالْحَة تِتْعَذَّبْ وتِتْوَجَّعْ كُلْ يُومْ مِالفْسَادْ الِّي كَانْ يْرَاهْ ويِسْمَعْ بِيهْ. <verse eid="2PE 2:8" /><verse number="9" style="v" sid="2PE 2:9" />مَالَا، نْشُوفُوا الِّي اللَّهْ يَعْرِفْ كِيفَاشْ يْمَنَّعْ الصَّالْحِينْ مِنْ مِحْنِتْهُمْ، ويْخَلِّي المُذْنْبِينْ لِلنْهَارْ الحْسَابْ بَاشْ يْعَاقِبْهُمْ. <verse eid="2PE 2:9" /><verse number="10" style="v" sid="2PE 2:10" />بِالأَخَصْ الِّي يْتَبْعُوا فِي شْهَاوِيهُمْ ويْنَجْسُوا فِي بْدَنَّاتْهُمْ، ومَا يَعْمْلُوشْ قِيمَة لْسُلْطِةْ اللَّهْ!</para>
  <para style="p" vid="2PE 2:10">هَاذُمْ نَاسْ قْبَاحْ ومِتْكَبْرِينْ، مَا يْخَافُوشْ كِي يْسِبُّوا ويْهِينُوا المَخْلُوقَاتْ السْمَاوِيَّة العْظِيمَة، <verse eid="2PE 2:10" /><verse number="11" style="v" sid="2PE 2:11" />رَغْمِلِّي المْلَايْكَة، الِّي هُومَا أَعْظِمْ وأَقْوَى مِنْهُمْ، مَا يِتْهْمُوشْ المَخْلُوقَاتْ هَاذِي بِالخَايِبْ قُدَّامْ الرَّبْ. <verse eid="2PE 2:11" /><verse number="12" style="v" sid="2PE 2:12" />آمَا النَّاسْ هَاذُومَا يِشْتْمُوا فِي أُمُورْ مَا يِفْهْمُوهَاشْ. هُومَا كِيمَا الحَيَوَانَاتْ الِّي بْلَاشْ عْقَلْ، تْحَرِّكْهُمْ الغَرِيزَة، ولِّي تْخَلْقُوا بَاشْ يِصْطَادُوهُمْ ويُقْتْلُوهُمْ. هَاذَاكَا عْلَاشْ بِشْ يِفْنَاوْ كِيفْهُمْ. <verse eid="2PE 2:12" /><verse number="13" style="v" sid="2PE 2:13" />وهَكَّا يَاخْذُوا الِّي يِسْتَاهْلُوهْ عْلَى فْسَادْهُمْ. وكِي يُغْطْسُوا فِي شْهَاوِيهُمْ حَتَّى فِي عِزْ النْهَارْ، يِحْسْبُوهَا مُتْعَة كْبِيرَة. هُومَا فُسَّادْ وامَّسْخِينْ. وحَتَّى وَقْتِلِّي يَاكْلُوا مْعَاكُمْ، يْغُشُّوكُمْ وهُومَا فَرْحَانِينْ. <verse eid="2PE 2:13" /><verse number="14" style="v" sid="2PE 2:14" />عِينِيهُمْ مِلْيَانَة بِالزْنَى، مَا يِشْبْعُوشْ مِالذْنُوبْ، يْغُرُّوا بِالضْعَافْ وقْلُوبْهُمْ سْتَانْسِتْ بِالطْمَعْ. هَاذُومَا بِالحَقْ مَلْعُونِينْ. <verse eid="2PE 2:14" /><verse number="15" style="v" sid="2PE 2:15" />خَلَّاوْ الطْرِيقْ المُسْتَقِيمْ، وضَاعُوا ومْشَاوْ فِي طْرِيقْ بَلْعَامْ وِلْدْ بَعُورْ الِّي عْمَلْ الشَّرْ عْلَى خَاطِرْ الفْلُوسْ، <verse eid="2PE 2:15" /><verse number="16" style="v" sid="2PE 2:16" />يَاخِي تْوَبَّخْ عْلَى عِصْيَانُو، وَقْتِلِّي بْهِيمَة بَكْمَة نَطْقِتْ بْصُوتْ بَشَرْ، ورَجّْعِتْ النَّبِيْ لْعَقْلُو.<verse eid="2PE 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17" />النَّاسْ هَاذُومَا أَبْيَارْ مَا فِيهَاشْ مَاء، وسْحَابْ هَازُّو الرِّيحْ القْوِيْ. هَاذَاكَا عْلَاشْ حَضْرِلْهُمْ اللَّهْ الظْلَامْ الأَبَدِي. <verse eid="2PE 2:17" /><verse number="18" style="v" sid="2PE 2:18" />يِتْكَلْمُوا بِكْلَامْ كْبِيرْ آمَا فَارِغْ، ويِسْتَعْمْلُوا شْهَاوِي البْدَنْ الفَاسْدَة بَاشْ يْغُرُّوا النَّاسْ الِّي مَزَّالُوا كِي تْخَلْصُوا مِنْ خُلْطِةْ النَّاسْ الِّي بْعَادْ عْلَى اللَّهْ. <verse eid="2PE 2:18" /><verse number="19" style="v" sid="2PE 2:19" />يُوعْدُوهُمْ بِالحُرِّيَّة، وهُومَا بِيدْهُمْ عَبِيدْ لِلْفْسَادْ. عْلَى خَاطِرْ الإِنْسَانْ يْوَلِّي عَبْدْ لْكُلْ حَاجَة تِتْسَلِّطْ عْلِيهْ وتِغْلْبُو. <verse eid="2PE 2:19" /><verse number="20" style="v" sid="2PE 2:20" />الِّي مَنْعُوا مِنْ فْسَادْ الدِّنْيَا هَاذِي، كِي عَرْفُوا رَبْنَا ومُنَجِّينَا يَسُوعْ المَسِيحْ، ومْبَعِّدْ رَجْعُوا يْعِيشُوا فِي نَفْسْ الفْسَادْ حَتَّى غْلِبْهُمْ، هَاذُومَا بِشْ تْكُونْ حَالِتْهُمْ فِي الإِخِّرْ أَتْعِسْ مِلِّي كَانُوا عْلِيهْ فِي الأُوِّلْ. <verse eid="2PE 2:20" /><verse number="21" style="v" sid="2PE 2:21" />وفِي الحْقِيقَة، كَانْ مَا عَرْفُوشْ طْرِيقْ الصَّلَاحْ خِيرِلْهُمْ مِلِّي بَعْدْمَا يَعْرْفُوهْ، يْسَلْمُوا فِي الوْصِيَّة المُقَدْسَة الِّي خْذَاوْهَا. <verse eid="2PE 2:21" /><verse number="22" style="v" sid="2PE 2:22" />هَاذُومَا يِطَّبَّقْ عْلِيهُمْ المَثَلْ الِّي يْقُولْ: «رْجَعْ الكَلْبْ يَاكِلْ فِلِّي رَدُّو»، و «الحْلَالِفْ الِّي تْغَسْلُوا، رَجْعُوا يِتْمَرْغْدُوا فِي وْسَخْهُمْ».<verse eid="2PE 2:22" /></para>
  <chapter eid="2PE 2" />
  <chapter number="3" style="c" sid="2PE 3" />
  <para style="s">نْهَارْ الحْسَابْ</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1" />يَا حْبَابِي، هَاذِي الرِّسَالَة الثَّانْيَة الِّي نِكْتِبْهَالْكُمْ. وحَبِّيتْ فِي الرَّسَايِلْ الزُّوزْ، نْذَكَّرْكُمْ بِالأُمُورْ هَاذِي بَاشْ نْشَجَّعْكُمْ تْفَكْرُوا بْطَرِيقَة صْحِيحَة، <verse eid="2PE 3:1" /><verse number="2" style="v" sid="2PE 3:2" />وبَاشْ تِتْفَكْرُوا الأَقْوَالْ الِّي قَالُوهَا الأَنْبِيَاءْ الصَّالْحِينْ مِنْ قْبَلْ، وتِتْفَكْرُوا زَادَا وْصِيِّةْ الرَّبْ المُنَجِّي، الِّي وَصْلُوهَالْكُمْ الرُّسُلْ.<verse eid="2PE 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 3:3" />قْبَلْ كُلْ شَيْ، يِلْزِمْكُمْ تَعْرْفُوا الِّي فِي آخِرْ الزْمَانْ، بِشْ يْجِيوْ نَاسْ يِتْمَسْخْرُوا عَالحَقْ وعَايْشِينْ يْتَبْعُوا فِي شْهَاوِيهُمْ، <verse eid="2PE 3:3" /><verse number="4" style="v" sid="2PE 3:4" />ويْقُولُوا: «مُشْ وْعِدْ بِشْ يْجِي؟ وِينُو؟ مِلِّي تْخَلْقِتْ الدِّنْيَا ومَاتُوا جْدُودْنَا وكُلْ شَيْ كِيمَا هُوَّ!». <verse eid="2PE 3:4" /><verse number="5" style="v" sid="2PE 3:5" />وهُومَا بِالعَانِي يِنْسَاوْ الِّي اللَّهْ مِنْ قْدِيمْ الزْمَانْ خْلَقْ السْمَاوَاتْ بْكِلْمْتُو والأَرْضْ كَوَّنْهَا مِالمَاء وبِالمَاء، <verse eid="2PE 3:5" /><verse number="6" style="v" sid="2PE 3:6" />وبْنَفْسْ الطَّرِيقَة، اللَّهْ دَمِّرْ العَالِمْ الِّي كَانْ مَوْجُودْ وَقْتْهَا، وغَرْقُو بِالمَاء. <verse eid="2PE 3:6" /><verse number="7" style="v" sid="2PE 3:7" />وبْنَفْسْ الكِلْمَة، السْمَاوَاتْ والأَرْضْ المَوْجُودِينْ تَوَّا، بِشْ يُقْعْدُوا مَحْفُوظِينْ حَتَّى يِتْحَرْقُوا بِالنَّارْ فِي نْهَارْ الحْسَابْ: نْهَارْ هْلَاكْ الأَشْرَارْ.<verse eid="2PE 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8" />آمَا يَا حْبَابِي، مَا تِنْسَاوِشْ الحْقِيقَة هَاذِي، الِّي نْهَارْ وَاحِدْ عَنْدْ الرَّبْ كِيمَا 1 000 سْنَة و1 000 سْنَة كِيمَا نْهَارْ وَاحِدْ. <verse eid="2PE 3:8" /><verse number="9" style="v" sid="2PE 3:9" />الرَّبْ مَا يِبْطَاشْ فِي تَحْقِيقْ وَعْدُو، كِيفْ مَا بَرْشَة نَاسْ يْظُنُّوا، آمَا هُوَّ يُصْبُرْ عْلِيكُمْ عْلَى خَاطِرْ يْحِبْ النَّاسْ الكُلْ يْتُوبُوا ومَا يْحِبِّشْ حَتَّى حَدْ يِفْنَى.<verse eid="2PE 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10" />بِشْ يْجِي نْهَارْ الحْسَابْ كِيفْ السَّارِقْ، تِفْنَى فِيهْ السْمَاوَاتْ وكُلْ مَاهُو فِي العَالِمْ بِشْ يِتْحْرَقْ بِالنَّارْ، وتِدَّمِرْ الأَرْضْ بِلِّي فِيهَا <verse eid="2PE 3:10" /><verse number="11" style="v" sid="2PE 3:11" />مَادَامْ الدِّنْيَا بِشْ تُوفَى هَكَّا، مَالَا كِيفَاشْ يِلْزِمْكُمْ تْعِيشُوا؟ يِلْزِمْكُمْ تْعِيشُوا فِي القَدَاسَة والتَّقْوَى، <verse eid="2PE 3:11" /><verse number="12" style="v" sid="2PE 3:12" />وإِنْتُومَا تِسْتَنَّاوْ فِي النْهَارْ الِّي يِرْجَعْ فِيهْ الرَّبْ، وعَامْلِينْ مَجْهُودْكُمْ تْحِبُّوهْ يْجِي فِيسَعْ. النْهَارْ هَاذَاكَا تِلْهِبْ فِيهْ السْمَاوَاتْ والعَالِمْ لْكُلُّو يِتْحْرَقْ بِالنَّارْ ويْذُوبْ. <verse eid="2PE 3:12" /><verse number="13" style="v" sid="2PE 3:13" />آمَا أَحْنَا، نِسْتَنَّاوْ فِي سْمَاوَاتْ جْدِيدَة وأَرْضْ جْدِيدَة، يُسْكُنْ فِيهَا الصَّلَاحْ، كِيمَا وْعِدْنَا الرَّبْ.<verse eid="2PE 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14" />يَا حْبَابِي، مَادَامْكُمْ تِسْتَنَّاوْ فِي الوَعْدْ، أَعْمْلُوا مَجْهُودْكُمْ بَاشْ تْكُونُوا قُدَّامْ اللَّهْ فِي سَلَامْ، ومَا فِيكُمْ حَتَّى عِيبْ ومَا عْلِيكُمْشْ لُومْ. <verse eid="2PE 3:14" /><verse number="15" style="v" sid="2PE 3:15" />وإِحْسْبُوا صَبْرْ الرَّبْ فُرْصَة بَاشْ تِنْجَاوْ، كِيفْ مَا كْتِبِّلْكُمْ خُونَا المَحْبُوبْ بُولِسْ، بِالحِكْمَة الِّي عْطَاهَالُو الرَّبْ. <verse eid="2PE 3:15" /><verse number="16" style="v" sid="2PE 3:16" />وهَاذَا الِّي دِيمَا يِكْتْبُو فِي رَسَايْلُو الكُلْ وَقْتِلِّي يَحْكِيلْنَا عَالأُمُورْ هَاذِي. الرَّسَايِلْ هَاذُمْ فِيهُمْ زَادَا حَاجَاتْ فَهْمْهَا صْعِيبْ، يْفَسْرُوهَا الجُهَّالْ وضْعَافْ النْفُوسْ تَفْسِيرْ غَالِطْ كِيمَا يَعْمْلُوا مْعَ الكْتُبْ المُقَدْسَة الأُخْرَى: وهَكَّا يْجِيبُوا البْلَاء والفْنَى لِرْوَاحْهُمْ.<verse eid="2PE 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 3:17" />آمَا، إِنْتُومَا يَا حْبَابِي، مَادَامْكُمْ فِقْتُوا بِالخْطَرْ قْبَلْ مَا يْصِيرْ، رُدُّوا بَالْكُمْ يْغُرُّوا بِيكُمْ الأَشْرَارْ وتْوَلِّيوْ مَا عَادِشْ ثَابْتِينْ فِي الإِيمَانْ. <verse eid="2PE 3:17" /><verse number="18" style="v" sid="2PE 3:18" />بِالعَكْسْ، إِكْبْرُوا فِي النِّعْمَة وفِي مَعْرِفْةْ رَبْنَا ومُنَجِّينَا يَسُوعْ المَسِيحْ. لِيهْ المَجْدْ تَوَّا، ولْأَبَدْ الآبِدِينْ. آمِينْ.<verse eid="2PE 3:18" /></para>
  <chapter eid="2PE 3" />
</usx>