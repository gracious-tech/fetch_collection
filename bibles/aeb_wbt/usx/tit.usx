<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="TIT" style="id" />
  <para style="h">تِيطُسْ</para>
  <para style="toc1">رِسَالِةْ بُولِسْ لْتِيطُسْ</para>
  <para style="toc2">تِيطُسْ</para>
  <para style="toc3">تِيطُسْ</para>
  <para style="mt">رِسَالِةْ بُولِسْ لْتِيطُسْ</para>
  <chapter number="1" style="c" sid="TIT 1" />
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1" />مِنْ بُولِسْ عَبْدْ اللَّهْ ورَسُولْ يَسُوعْ المَسِيحْ الِّي بْعَثْنِي بَاشْ نِهْدِي الِّي اخْتَارْهُمْ اللَّهْ لِلْإِيمَانْ، ولْمَعْرِفْةْ الحَقْ الِّي يْوَافِقْ التَّقْوَى، <verse eid="TIT 1:1" /><verse number="2" style="v" sid="TIT 1:2" />بَاشْ يْكُونْ عَنْدْهُمْ رْجَى فِي الحَيَاةْ الأَبَدِيَّة الِّي وْعِدْ بِيهَا اللَّهْ مِنْ أَوِّلْ الدِّنْيَا، واللَّهْ مَا يِكْذِبْشْ. <verse eid="TIT 1:2" /><verse number="3" style="v" sid="TIT 1:3" />وفِي الوَقْتْ المُنَاسِبْ، ظَهِّرْ اللَّهْ الِّي نَجَّانَا كِلْمْتُو بِالبْشَارَة الِّي حَطْهَا أَمَانَة بِينْ يْدَيَّا، بْأَمْرْ مِنُّو.<verse eid="TIT 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="TIT 1:4" />لْتِيطُسْ وِلْدِي الحَقِيقِي فِي الإِيمَانْ الِّي نِتْشَارْكُوا فِيهْ.</para>
  <para style="p" vid="TIT 1:4">لِيكْ النِّعْمَة والسَّلَامْ مِنْ اللَّهْ الآبْ ويَسُوعْ المَسِيحْ الِّي يْنَجِّينَا.<verse eid="TIT 1:4" /></para>
  <para style="s">تِيطُسْ يْحُطْ شْيُوخْ لِلْكْنَايِسْ</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5" />خَلِّيتِكْ فِي كْرِيتْ بَاشْ تْكَمِّلْ تْنَظِّمْ الحَاجَاتْ النَّاقْصَة وتْحُطْ شْيُوخْ كْنِيسَة فِي كُلْ مْدِينَة كِيفْ مَا وَصِّيتِكْ، <verse eid="TIT 1:5" /><verse number="6" style="v" sid="TIT 1:6" />وشِيخْ لِكْنِيسَةْ لَازِمْ مَا يْكُونِشْ عْلِيهْ لُومْ، ويْكُونْ رَاجِلْ لِمْرَا وَحْدَة، وْلَادُو مُؤْمْنِينْ وحَدْ مَا يِتْهِمْهُمْ بِلِّي هُومَا فُسَّادْ وعَايْقِينْ. <verse eid="TIT 1:6" /><verse number="7" style="v" sid="TIT 1:7" />عْلَى خَاطِرْ المَسْؤُولْ عَالكْنِيسَة، بِإِعْتِبَارُو وَكِيلْ لِلَّهْ، لَازِمْ مَا يْكُونِشْ عْلِيهْ حَتَّى لُومْ، لَاهُو مِتْكَبِّرْ، لَاهُو مُغْشَاشْ، لَاهُو سُوكَارْجِي، لَاهُو يْحِبْ العَرْكْ، ولَاهُو طَمَّاعْ فِي فْلُوسْ الحْرَامْ، <verse eid="TIT 1:7" /><verse number="8" style="v" sid="TIT 1:8" />آمَا يِلْزْمُو يْكُونْ مِضْيَافْ ويْحِبْ الخِيرْ ورْزِينْ وصَالَحْ وتَقِيْ ويِتْحَكَّمْ فِي رُوحُو، <verse eid="TIT 1:8" /><verse number="9" style="v" sid="TIT 1:9" />ويْشِدْ صْحِيحْ فِي كْلَامْ الحَقْ الِّي أَحْنَا نْعَلْمُوا فِيهْ، بَاشْ يْنَجِّمْ يْشَجَّعْ الأُخْرِينْ بِالتَّعْلِيمْ الصْحِيحْ ويْجَاوِبْ عَالمُعَارْضِينْ.<verse eid="TIT 1:9" /></para>
  <para style="s">وَقِّفْ التَّعْلِيمْ الغَالِطْ</para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10" />عْلَى خَاطِرْ فَمَّة بَرْشَة نَاسْ مِتْمَرْدِينْ، يْغَلْطُوا فِي النَّاسْ بِالكْلَامْ الفَارِغْ، بِالأَخَصْ الِّي هُومَا مِاليْهُودْ، <verse eid="TIT 1:10" /><verse number="11" style="v" sid="TIT 1:11" />هَاذُومَا يِلْزْمِكْ تْسَكْرِلْهُمْ أَفَّامْهُمْ، عْلَى خَاطِرْهُمْ وَقْتِلِّي يْعَلْمُوا حَاجَاتْ مَا يِلْزِمْهَاشْ تِتْعَلِّمْ، يْهِدُّوا فِي عَايْلَاتْ كَامْلَة، بَاشْ هُومَا يِرْبْحُوا فْلُوسْ الحْرَامْ. <verse eid="TIT 1:11" /><verse number="12" style="v" sid="TIT 1:12" />وقَالْ عْلِيهُمْ نَبِيْ مِنْهُمْ:</para>
  <para style="b" vid="TIT 1:12" />
  <para style="q1" vid="TIT 1:12">«الكَرِيتِيِّينْ دِيمَا كَذَّابِينْ،</para>
  <para style="q2" vid="TIT 1:12">حَيَوَانَاتْ مِتْوَحْشِينْ،</para>
  <para style="q1" vid="TIT 1:12">مَلْهُوفِينْ عَالمَاكْلَة وبُخْلِيِّينْ».<verse eid="TIT 1:12" /></para>
  <para style="b" />
  <para style="m">
    <verse number="13" style="v" sid="TIT 1:13" />والشْهَادَة هَاذِي صَادْقَة. هَاذَاكَا عْلَاشْ يِلْزْمِكْ تْنَبَّهُّمْ وتِكْبِسْ عْلِيهُمْ بَاشْ يْكُونْ إِيمَانْهُمْ صْحِيحْ، <verse eid="TIT 1:13" /><verse number="14" style="v" sid="TIT 1:14" />ومَا يِتِلْهَاوِشْ بِخْرَافَاتْ يْهُودِيَّة ووْصَايَا نَاسْ بِعْدُوا عَالحَقْ. <verse eid="TIT 1:14" /><verse number="15" style="v" sid="TIT 1:15" />كُلْ شَيْ طَاهِرْ لِلطَّاهْرِينْ، آمَا لِلْمَنْزُوسِينْ ولِّي مُشْ مُؤْمْنِينْ مَا فَمَّة حَتَّى شَيْ طَاهِرْ، حَتَّى مِنْ عْقُولْهُمْ وضْمَايِرْهُمْ مَنْزُوسَة. <verse eid="TIT 1:15" /><verse number="16" style="v" sid="TIT 1:16" />يْقُولُوا الِّي هُومَا يَعْرْفُوا اللَّهْ، آمَا يُنْكْرُوهْ بْأَعْمَالْهُمْ. هُومَا مَكْرُوهِينْ، عَاصِينْ، عَاجْزِينْ عْلَى إِنْهُمْ يَعْمْلُوا أَيْ حَاجَة صَالْحَة.<verse eid="TIT 1:16" /></para>
  <chapter eid="TIT 1" />
  <chapter number="2" style="c" sid="TIT 2" />
  <para style="s">وْصَايَا لِلْمُؤْمْنِينْ</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1" />آمَا إِنْتِ تْكَلِّمْ بِلِّي يْوَافِقْ التَّعْلِيمْ الصْحِيحْ. <verse eid="TIT 2:1" /><verse number="2" style="v" sid="TIT 2:2" />عَلِّمْ الرْجَالْ الكْبَارْ فِي العْمُرْ يْكُونُوا صَاحِينْ ومُحْتَرْمِينْ ورْزَانْ، وصْحَاحْ فِي الإِيمَانْ والمْحَبَّة والصَّبْرْ. <verse eid="TIT 2:2" /><verse number="3" style="v" sid="TIT 2:3" />وعَلِّمْ النْسَاء العْزَايِزْ زَادَا يِتْصَرْفُوا بِإِحْتِرَامْ، مَا يْقَطْعُوشْ النَّاسْ ويْرَيْشُوهُمْ ومَا يْكُونُوشْ مُدْمْنِينْ عَالشْرَابْ آمَا يِهْدِيوْ لِلْخِيرْ، <verse eid="TIT 2:3" /><verse number="4" style="v" sid="TIT 2:4" />يْعَلْمُوا النْسَاء الصْغَارْ كِيفَاشْ يْحِبُّوا رْجَالْهُمْ ووْلَادْهُمْ، <verse eid="TIT 2:4" /><verse number="5" style="v" sid="TIT 2:5" />وكِيفَاشْ يْكُونُوا رْزَانْ وطَاهْرِينْ يَعْرْفُوا يِتِلْهَاوْ بِدْيَارْهُمْ، وكِيفَاشْ يْكُونُوا طَيْبِينْ ويِخْضْعُوا لْرْجَالْهُمْ، بَاشْ حَتَّى حَدْ مَا يِتْكَلِّمْ بِالخَايِبْ عْلَى كْلَامْ اللَّهْ.<verse eid="TIT 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6" />وشَجِّعْ الشَّبَابْ زَادَا بَاشْ يِتْصَرْفُوا بِرْزَانَة. <verse eid="TIT 2:6" /><verse number="7" style="v" sid="TIT 2:7" />وإِنْتِ بِيدِكْ كُونْ فِي كُلْ شَيْ قُدْوَة لِيهُمْ بِالتَّصَرُّفْ البَاهِي، ووَرِّي الِّي إِنْتِ مُخْلِصْ وصَادَقْ فِي تَعْلِيمِكْ. <verse eid="TIT 2:7" /><verse number="8" style="v" sid="TIT 2:8" />وخَلِّي كْلَامِكْ يْكُونْ صْحِيحْ مَا عْلِيهِشْ لُومْ، بَاشْ الِّي يْجِي ضِدْنَا يِحْشِمْ عْلَى رُوحُو ومَا يْنَجِّمْ يْقُولْ عْلِينَا حَتَّى حَاجَة خَايْبَة.<verse eid="TIT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9" />وعَلِّمْ العَبِيدْ يِخْضْعُوا لْأَسْيَادْهُمْ ويْرَضِّيوْهُمْ فِي كُلْ شَيْ، ومَا يْخَالْفُوهُمْشْ <verse eid="TIT 2:9" /><verse number="10" style="v" sid="TIT 2:10" />ومَا يِسْرْقُوهُمْشْ، آمَا دِيمَا يْوَرِّيوْ الِّي هُومَا ثِيقَة، بَاشْ يْظَهْرُوا قَدَّاشْ تَعْلِيمْ اللَّهْ الِّي نَجَّانَا بَاهِي ومِزْيَانْ.<verse eid="TIT 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11" />عْلَى خَاطِرْ نِعْمِةْ اللَّهْ، الِّي فِيهَا نَجَاةْ لِلنَّاسْ الكُلْ، ظُهْرِتْ <verse eid="TIT 2:11" /><verse number="12" style="v" sid="TIT 2:12" />بَاشْ تْعَلِّمْنَا نِبْعْدُوا عَالكُفْرْ بِاللَّهْ وعْلَى شْهَاوِي الدِّنْيَا هَاذِي، ونْعِيشُوا بِالرْزَانَة والصَّلَاحْ والتَّقْوَى فِي الوَقْتْ الحَاضِرْ، <verse eid="TIT 2:12" /><verse number="13" style="v" sid="TIT 2:13" />مِسْتَنِّينْ بَاشْ يِتْحَقِّقْ رْجَانَا المُبَارَكْ، ويُظْهُرْ مَجْدْ إِلَاهْنَا ومُنَجِّينَا العْظِيمْ، يَسُوعْ المَسِيحْ. <verse eid="TIT 2:13" /><verse number="14" style="v" sid="TIT 2:14" />هُوَّ ضَحَّى بْرُوحُو عْلَى خَاطِرْنَا بَاشْ يِفْدِينَا مِنْ كُلْ مَعْصِيَة ويْطَهِّرْنَا ويْرُدْنَا شَعْبُو الخَاصْ بِيهْ، شَعْبْ مِتْحَمِّسْ لِلْأَعْمَالْ الصَّالْحَة.<verse eid="TIT 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15" />عَلِّمْهُمْ الأُمُورْ هَاذِي الكُلْ، وإِسْتَعْمِلْ كُلْ السُّلْطَة الِّي عَنْدِكْ بَاشْ تْشَجَّعْهُمْ وتِكْبِسْ عْلِيهُمْ. ومَا تْخَلِّي حَتَّى حَدْ يَحْقْرِكْ.<verse eid="TIT 2:15" /></para>
  <chapter eid="TIT 2" />
  <chapter number="3" style="c" sid="TIT 3" />
  <para style="s">أَعْمْلُوا الصَّالَحْ</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1" />ذَكِّرْ المُؤْمْنِينْ بَاشْ يِخْضْعُوا لِلْحُكَّامْ والنَّاسْ الِّي فِي السُّلْطَة ويْطِيعُوهُمْ، ويْكُونُوا مُسْتْعَدِّينْ بَاشْ يَعْمْلُوا كُلْ مَاهُو صَالَحْ، <verse eid="TIT 3:1" /><verse number="2" style="v" sid="TIT 3:2" />ومَا يْسِبُّوا حَتَّى حَدْ ومَا يِتْعَارْكُوا مْعَ حَتَّى حَدْ، آمَا يْكُونُوا طَيْبِينْ يِتْصَرْفُوا مْعَ النَّاسْ الكُلْ بِسْيَاسَة.<verse eid="TIT 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="TIT 3:3" />وأَحْنَا زَادَا قْبَلْ كُنَّا بْلَاشْ عْقَلْ، عَاصِينْ، ضَالِّينْ، عَبِيدْ لِشْهَاوِينَا ولْشِيخَاتْنَا، عَايْشِينْ فِي الخُبْثْ والحُسْدْ، مَكْرُوهِينْ ونَكْرْهُوا بْعَضْنَا. <verse eid="TIT 3:3" /><verse number="4" style="v" sid="TIT 3:4" />آمَا وَقْتِلِّي ظْهُرْ لُطْفْ اللَّهْ الِّي يْنَجِّينَا ومْحَبْتُو لِلْبَشَرْ، <verse eid="TIT 3:4" /><verse number="5" style="v" sid="TIT 3:5" />نَجَّانَا، مُشْ عْلَى خَاطِرْ حَاجَاتْ بَاهْيَة عْمَلْنَاهَا، آمَا عْلَى خَاطِرْ رَحْمْتُو. نَجَّانَا كِي غْسَلْنَا بِالوِلَادَة الثَّانْيَة وجَدِّدْنَا بِالرُّوحْ القُدُسْ. <verse eid="TIT 3:5" /><verse number="6" style="v" sid="TIT 3:6" />اللَّهْ حَطْ فِينَا الرُّوحْ القُدُسْ وخَلَّاهْ يْفِيضْ، بْيَسُوعْ المَسِيحْ الِّي يْنَجِّينَا، <verse eid="TIT 3:6" /><verse number="7" style="v" sid="TIT 3:7" />بَاشْ يِعْتَبِرْنَا صَالْحِينْ بْنِعْمْتُو، ونُورْثُوا الحَيَاةْ الأَبَدِيَّة حَسْبْ الرْجَى الِّي عَنْدْنَا. <verse eid="TIT 3:7" /><verse number="8" style="v" sid="TIT 3:8" />الكْلَامْ هَاذَا حَقْ، ونْحِبِّكْ تْأَكِّدْ عْلِيهْ، بَاشْ المُؤْمْنِينْ يِجْتَهْدُوا فِي الأَعْمَالْ الصَّالْحَة. وهَاذَا بَاهِي وفِيهْ فَايْدَة لِلنَّاسْ الكُلْ.<verse eid="TIT 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 3:9" />آمَا الحْدِيثْ الفَارَغْ، وحْكَايَاتْ النْسَبْ، والعَرْكْ، والنِّقَاشْ عَالشَّرِيعَة أَخْطَاكْ مِنْهَا عْلَى خَاطِرْهَا تْضُرْ ومَا تَنْفَعْشْ. <verse eid="TIT 3:9" /><verse number="10" style="v" sid="TIT 3:10" />ولِّي يِتْسَبِّبْ فِي تَفْرِيقْ النَّاسْ، أَقْطَعْ عَلَاقْتِكْ بِيهْ بَعْدْمَا تْنَبَّهْ عْلِيهْ مَرَّة ومَرْتِينْ، <verse eid="TIT 3:10" /><verse number="11" style="v" sid="TIT 3:11" />وكِيمَا تَعْرِفْ، وَاحِدْ كِيمَا هَاذَا ضَايِعْ ومُذْنِبْ وحْكُمْ عْلَى رُوحُو بْرُوحُو.<verse eid="TIT 3:11" /></para>
  <para style="s">وْصَايَا لْتِيطُسْ</para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12" />ووَقْتِلِّي نِبْعَثْلِكْ أَرْتِيمَاسْ وَلَّا تِيخِيكُسْ، أَعْمِلْ مَجْهُودِكْ بَاشْ تْجِينِي لْنِيكُوبُولِيسْ عْلَى خَاطِرْنِي قَرِّرْتْ بِشْ نْعَدِّي الشْتَاء غَادِي. <verse eid="TIT 3:12" /><verse number="13" style="v" sid="TIT 3:13" />عَاوِنْ زِينَاسْ المُحَامِي وأَبُلُّوسْ عْلَى قَدْ مَا تَقْدِرْ بَاشْ يْحَضْرُوا رْوَاحْهُمْ لِلسْفَرْ ومَا يُنْقُصْهُمْ حَتَّى شَيْ. <verse eid="TIT 3:13" /><verse number="14" style="v" sid="TIT 3:14" />وجْمَاعِتْنَا المُؤْمْنِينْ يِلْزِمْهُمْ يِتْعَلْمُوا كِيفَاشْ يِجْتَهْدُوا فِي أَعْمَالْ صَالْحَة بَاشْ يْوَفْرُوا الحَاجَاتْ الضَّرُورِيَّة، وهَكَّا مَا تْكُونِشْ حْيَاتْهُمْ بْلَا مَنْفْعَة.<verse eid="TIT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15" />يْسَلْمُوا عْلِيكْ الِّي مْعَايَا الكُلْ. سَلِّمْ عْلَى احْبَابْنَا فِي الإِيمَانْ. والنِّعْمَة تْكُونْ مْعَاكُمْ الكُلْ.<verse eid="TIT 3:15" /></para>
  <chapter eid="TIT 3" />
</usx>