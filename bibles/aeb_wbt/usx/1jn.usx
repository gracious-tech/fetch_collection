<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id" />
  <para style="h">يُوحَنَّا الأُولَى</para>
  <para style="toc1">رِسَالِةْ يُوحَنَّا الأُولَى</para>
  <para style="toc2">يُوحَنَّا الأُولَى</para>
  <para style="toc3">يُوحَنَّا الأُولَى</para>
  <para style="mt">رِسَالِةْ يُوحَنَّا الأُولَى</para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s">الكِلْمَة الِّي يَعْطِي الحَيَاةْ</para>
  <para style="q1">
    <verse number="1" style="v" sid="1JN 1:1" />نِكْتْبُولْكُمْ بِخْصُوصْ الكِلْمَة الِّي يَعْطِي الحَيَاةْ:</para>
  <para style="q2" vid="1JN 1:1">الِّي كَانْ مَوْجُودْ مِالأُوِّلْ،</para>
  <para style="q1" vid="1JN 1:1">الِّي سْمَعْنَاهْ،</para>
  <para style="q2" vid="1JN 1:1">وشُفْنَاهْ بْعِينِينَا،</para>
  <para style="q1" vid="1JN 1:1">وثَبَّتْنَا فِيهْ</para>
  <para style="q2" vid="1JN 1:1">ومَسِّينَاهْ بِيدِينَا.<verse eid="1JN 1:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="1JN 1:2" />والحَيَاةْ هَاذِي ظُهْرِتْ، وأَحْنَا شُفْنَاهَا ونِشْهْدُولْهَا ونْبَشْرُوكُمْ بِيهَا، ولِّي هِيَّ الحَيَاةْ الأَبَدِيَّة الِّي كَانِتْ عَنْدْ الآبْ وظُهْرِتْ قُدَّامْنَا. <verse eid="1JN 1:2" /><verse number="3" style="v" sid="1JN 1:3" />وأَحْنَا تَوَّا نْبَشْرُوا فِيكُمْ بِلِّي رِينَاهْ وسْمَعْنَاهْ بَاشْ إِنْتُومَا زَادَا تْكُونُوا مِتْشَارْكِينْ مْعَانَا، كِيمَا أَحْنَا مِتْشَارْكِينْ مْعَ الآبْ ومْعَ إِبْنُو يَسُوعْ المَسِيحْ. <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />نِكْتْبُولْكُمْ هَاذَا الكُلْ بَاشْ تِكْمِلْ فَرْحِتْنَا.<verse eid="1JN 1:4" /></para>
  <para style="s">عِيشُوا فِي النُّورْ</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />وهَاذَا هُوَّ الِّي سْمَعْنَاهْ مِالمَسِيحْ ونْبَشْرُوكُمْ بِيهْ: إِنُّو اللَّهْ نُورْ ومَافِيهِشْ ظْلَامْ بِالكُلْ. <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />كَانْ نْقُولُوا الِّي أَحْنَا مِتْشَارْكِينْ مْعَاهْ وبَاقِي نْعِيشُوا فِي الظْلَامْ، رَانَا قَاعْدِينْ نِكْذْبُوا ومَانَاشْ نَعْمْلُوا فِي الحَقْ. <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />آمَا إِذَا كُنَّا نْعِيشُوا فِي النُّورْ كِيفْ مَا هُوَّ فِي النُّورْ، نْكُونُوا بِالحَقْ مِتْشَارْكِينْ مْعَ بْعَضْنَا، ودَمْ يَسُوعْ المَسِيحْ إِبْنُو يْطَهِّرْنَا مِنْ كُلْ ذَنْبْ.<verse eid="1JN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8" />وإِذَا قُلْنَا الِّي أَحْنَا مَا عَنْدْنَا حَتَّى ذَنْبْ نْغَلْطُوا فِي رْوَاحْنَا والحَقْ مُشْ مَوْجُودْ فِينَا. <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />آمَا كَانْ إِسْتَعْرِفْنَا بِذْنُوبْنَا، هُوَّ أَمِينْ وعَادِلْ بَاشْ يِغْفْرِلْنَا ذْنُوبْنَا ويْطَهِّرْنَا مِنْ كُلْ شَرْ. <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />وكِي نْقُولُوا الِّي أَحْنَا مَا عْمَلْنَا حَتَّى ذَنْبْ رَانَا نْكَذْبُوا فِي اللَّهْ وكِلْمْتُو مُشْ مَوْجُودَة فِينَا.<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="s">المَسِيحْ يَشْفْعِلْنَا</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />يَا وْلَادِي العْزَازْ عْلِيَّا، رَانِي نِكْتْبِلْكُمْ فِي هَاذَا الكُلْ بَاشْ مَا تَعْمْلُوشْ الذْنُوبْ. آمَا إِذَا كَانْ وَاحِدْ أَذْنِبْ، رَاهُو يَسُوعْ المَسِيحْ الصَّالَحْ يْدَافَعْ عْلِينَا قُدَّامْ الآبْ. <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />عْلَى خَاطِرْ هُوَّ الضْحِيَّة الِّي تْكَفِّرْ عْلَى ذْنُوبْنَا، ومُشْ كَانْ ذْنُوبْنَا أَحْنَا أَكَهَوْ، آمَا ذْنُوبْ النَّاسْ الكُلْ.<verse eid="1JN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3" />وإِذَا كَانْ نْطِيعُوا الِّي وَصَّى بِيهْ، هَاذَا يْأَكْدِلْنَا الِّي أَحْنَا نَعْرْفُوهْ. <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />ولِّي يْقُولْ الِّي هُوَّ يَعْرْفُو ومَا يَعْمِلْشْ بِالوْصَايَا مْتَاعُو، رَاهُو يِكْذِبْ والحَقْ مُشْ مَوْجُودْ فِيهْ. <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />آمَا الِّي يْطِيعْ كِلْمْتُو، رَاهِي مْحَبِّةْ اللَّهْ تْكُونْ بِالحَقْ كَامْلَة فِيهْ. هَكَّا نَعْرْفُوا الِّي أَحْنَا ثَابْتِينْ فِيهْ. <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />ولِّي يْقُولْ إِنُّو هُوَّ ثَابِتْ فِيهْ، يِلْزْمُو يْعِيشْ كِيمَا عَاشْ المَسِيحْ.<verse eid="1JN 2:6" /></para>
  <para style="s">وْصِيَّة جْدِيدَة</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />يَا حْبَابِي مَانِيشْ نِكْتْبِلْكُمْ فِي وْصِيَّة جْدِيدَة آمَا رَاهِي وْصِيَّة قْدِيمَة كَانِتْ عَنْدْكُمْ مِالأُوِّلْ ولِّي هِيَّ الكِلْمَة الِّي سْمَعْتُوهَا قْبَلْ. <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />وفِي نَفْسْ الوَقْتْ نِكْتْبِلْكُمْ فِي وْصِيَّة جْدِيدَة ظَاهْرَة حْقِيقِتْهَا فِي المَسِيحْ وفِيكُمْ، عْلَى خَاطِرْ الظْلَامْ قَاعِدْ يِتْنَحَّى والنُّورْ الحَقِيقِي قَاعِدْ يِضْوِي.<verse eid="1JN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9" />الِّي يْقُولْ إِنُّو يْعِيشْ فِي النُّورْ وهُوَّ يِكْرَهْ خُوهْ رَاهُو مَزَّالْ لْتَوَّا يْعِيشْ فِي الظْلَامْ. <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />ولِّي يْحِبْ خُوهْ هُوَّ الِّي يْعِيشْ فِي النُّورْ وحَتَّى شَيْ مَا يْعَثْرُو. <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />ولِّي يِكْرَهْ خُوهْ رَاهُو ضَايَعْ فِي الظْلَامْ، يِمْشِي ومُشْ عَارِفْ رُوحُو وِينْ مَاشِي عْلَى خَاطِرْ الظْلَامْ عْمَالُو عِينِيهْ.<verse eid="1JN 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="1JN 2:12" />يَا وْلَادِي نِكْتْبِلْكُمْ فِي هَاذَا الكُلْ،</para>
  <para style="q2" vid="1JN 2:12">عْلَى خَاطِرْ اللَّهْ غْفِرِّلْكُمْ ذْنُوبْكُمْ عْلَى خَاطِرْ إِسْمْ المَسِيحْ.<verse eid="1JN 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1JN 2:13" />نِكْتْبِلْكُمْ يَا آبَاءْ،</para>
  <para style="q2" vid="1JN 2:13">عْلَى خَاطِرْكُمْ تَعْرْفُوا المَسِيحْ المَوْجُودْ مِالأُوِّلْ.</para>
  <para style="q1" vid="1JN 2:13">نِكْتْبِلْكُمْ يَا شَبَابْ،</para>
  <para style="q2" vid="1JN 2:13">عْلَى خَاطِرْكُمْ غْلِبْتُوا إِبْلِيسْ الشِّرِّيرْ.</para>
  <para style="q1" vid="1JN 2:13">نِكْتْبِلْكُمْ يَا وْلَادِي الصْغَارْ،</para>
  <para style="q2" vid="1JN 2:13">عْلَى خَاطِرْكُمْ تَعْرْفُوا الآبْ.<verse eid="1JN 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="1JN 2:14" />كْتِبْتِلْكُمْ يَا آبَاءْ،</para>
  <para style="q2" vid="1JN 2:14">عْلَى خَاطِرْكُمْ تَعْرْفُوا المَسِيحْ المَوْجُودْ مِالأُوِّلْ.</para>
  <para style="q1" vid="1JN 2:14">كْتِبْتِلْكُمْ يَا شَبَابْ،</para>
  <para style="q2" vid="1JN 2:14">عْلَى خَاطِرْكُمْ قْوِيِّينْ وكِلْمِةْ اللَّهْ ثَابْتَة فِي قْلُوبْكُمْ</para>
  <para style="q1" vid="1JN 2:14">وغْلِبْتُوا إِبْلِيسْ الشِّرِّيرْ.<verse eid="1JN 2:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />مَا تْحِبُّوشْ العَالِمْ والحَاجَاتْ الِّي فِي العَالِمْ. الِّي يْحِبْ العَالِمْ مَا تْكُونِشْ مْحَبِّةْ الآبْ فِي قَلْبُو. <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />عْلَى خَاطِرْ كُلْ مَا هُوَّ فِي العَالِمْ مِنْ شْهَاوِي الطْبِيعَة البَشَرِيَّة الفَاسْدَة وشْهَاوِي العِينْ والفُخْرَة بِلِّي يِكْسْبُو الإِنْسَانْ هُومَا مُشْ مِنْ عَنْدْ الآبْ آمَا مِالعَالِمْ. <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />والعَالِمْ بِشْ يِفْنَى هُوَّ والشْهَاوِي الِّي فِيهْ، آمَا الِّي يَعْمِلْ الحَاجَاتْ الِّي تْرَضِّي اللَّهْ بِشْ يَحْيَا لِلْأَبَدْ.<verse eid="1JN 2:17" /></para>
  <para style="s">رُدُّوا بَالْكُمْ مِلِّي ضِدْ المَسِيحْ</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />يَا وْلَادِي العْزَازْ، رَاهِي النْهَايَة قُرْبِتْ. سْمَعْتُوا الِّي فِي الإِخِّرْ بِشْ يْجِي المَسِيحْ الدَّجَّالْ. هَاهُمْ تَوَّا مَوْجُودِينْ بَرْشَة دَجَّالِينْ ضِدْ المَسِيحْ، وهَاذَا يْأَكْدِلْنَا إِنُّو النْهَايَة قُرْبِتْ. <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />الدَّجَّالِينْ هَاذُومَا خَرْجُوا مِنْ وِسْطْنَا، آمَا هُومَا فِي الحْقِيقَة مَا كَانُوشْ تَابْعِينَّا، ولَوْ كَانْ جَاوْ تَابْعِينَّا رَاهُمْ بْقَاوْ مْعَانَا. آمَا خْرُوجْهُمْ مِنْ وِسْطْنَا يْوَرِّي الِّي هُومَا الكُلْ مَاهُمْشْ تَابْعِينَّا.<verse eid="1JN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20" />آمَا إِنْتُومَا رَاكُمْ خْذِيتُوا قُوَّة مِنْ عَنْدْ القُدُّوسْ والكُلْكُمْ تَعْرْفُوا الحَقْ. <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />مَا كْتِبْتِلْكُمْشْ هَاذَا عْلَى خَاطِرْكُمْ مَا تَعْرْفُوشْ الحَقْ، بِالعَكْسْ كْتِبْتِلْكُمْ عْلَى خَاطِرْكُمْ تَعْرْفُوهْ، وتَعْرْفُوا زَادَا الِّي عُمْرُو الكِذْبْ مَا يْجِي مِالحَقْ. <verse eid="1JN 2:21" /><verse number="22" style="v" sid="1JN 2:22" />شْكُونُو الكَذَّابْ؟ الكَذَّابْ هُوَّ الِّي يُنْكُرْ الِّي يَسُوعْ هُوَّ المَسِيحْ بِالحَقْ. هَاذَا هُوَّ المَسِيحْ الدَّجَّالْ الِّي يُنْكُرْ الآبْ والإِبْنْ . <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />الِّي يُنْكُرْ الإِبْنْ مَعْنَاهَا يُنْكُرْ الآبْ زَادَا، ولِّي يِقْبِلْ الإِبْنْ يِقْبِلْ الآبْ زَادَا.<verse eid="1JN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24" />آمَا إِنْتُومَا خَلِّي يِثْبِتْ فِيكُمْ الكْلَامْ الِّي سْمَعْتُوهْ مِالأُوِّلْ، وإِذَا ثْبِتْ فِيكُمْ، تْكُونُوا إِنْتُومَا زَادَا ثَابْتِينْ فِي الإِبْنْ والآبْ. <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />ولِّي وْعِدْنَا بِيهْ اللَّهْ هُوَّ الحَيَاةْ الأَبَدِيَّة.<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />كْتِبْتِلْكُمْ الحَاجَاتْ هَاذِي بَاشْ نَحْكِيلْكُمْ عَالنَّاسْ الِّي يْحِبُّوا يْغَلْطُوكُمْ، <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />آمَا إِنْتُومَا الرُّوحْ الِّي خْذِيتُوهْ مِنْ عَنْدْ اللَّهْ ثَابِتْ فِيكُمْ، هَاذَاكَا عْلَاشْ مَا حَاشْتْكُمْشْ بِشْكُونْ يْعَلَّمْكُمْ. رَاهُو الرُّوحْ نَفْسُو يْعَلَّمْكُمْ كُلْ شَيْ. والرُّوحْ حَقْ مُشْ بَاطِلْ. مَالَا شِدُّوا صْحِيحْ فِي المَسِيحْ كِيمَا عَلَّمْكُمْ الرُّوحْ.<verse eid="1JN 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28" />يَا وْلَادِي شِدُّوا صْحِيحْ فِي المَسِيحْ بَاشْ تْكُونْ عَنْدْنَا ثِيقَة قُدَّامُو وَقْتِلِّي يْجِي، ومَا نِحْشْمُوشْ مِنُّو وَقْتِلِّي يِرْجَعْ. <verse eid="1JN 2:28" /><verse number="29" style="v" sid="1JN 2:29" />ومَادَامْكُمْ تَعْرْفُوا الِّي المَسِيحْ صَالَحْ، أَعْرْفُوا زَادَا إِنُّو كُلْ مِنْ يَعْمِلْ الصَّلَاحْ هُوَّ مَوْلُودْ مِنْ اللَّهْ.<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="s">أَحْنَا وْلَادْ اللَّهْ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />شُوفُوا قَدَّاشْ مْحَبِّةْ الآبْ لِينَا عْظِيمَة حَتَّى وَلِّينَا نِتْسَمَّاوْ وْلَادْ اللَّهْ، وبِالحَقْ أَحْنَا وْلَادُو. آمَا النَّاسْ الِّي فِي العَالِمْ هَاذَا مَا يَعْرْفُونَاشْ عْلَى خَاطِرْهُمْ مَا يَعْرْفُوشْ اللَّهْ. <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />يَا حْبَابِي أَحْنَا تَوَّا وْلَادْ اللَّهْ، ومَزِّلْنَا مَا نَعْرْفُوشْ كِيفَاشْ بِشْ نْوَلِّيوْ، آمَا رَانَا نَعْرْفُوا الِّي وَقْتِلِّي يِرْجَعْ المَسِيحْ بِشْ نْوَلِّيوْ كِيفُو عْلَى خَاطِرْنَا بِشْ نْشُوفُوهْ كِيفْ مَا هُوَّ. <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />وكُلْ وَاحِدْ عَنْدُو الرْجَى هَاذَا فِي المَسِيحْ، يِلْزْمُو يَحْفِظْ رُوحُو مِالذْنُوبْ كِيفْ مَا المَسِيحْ طَاهِرْ.<verse eid="1JN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4" />ولِّي يْعِيشْ فِي الذْنُوبْ يْجِي ضِدْ قَانُونْ اللَّهْ، عْلَى خَاطِرْ الذْنُوبْ هِيَّ إِنُّو الوَاحِدْ يْخَالِفْ قَانُونْ اللَّهْ. <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />وإِنْتُومَا تَعْرْفُوا الِّي المَسِيحْ جَاء بَاشْ يْنَحِّي الذْنُوبْ، هُوَّ الِّي مَا فِيهْ حَتَّى ذَنْبْ. <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />ولِّي يِثْبِتْ فِي المَسِيحْ مَا يْعِيشِشْ فِي الذْنُوبْ، آمَا الِّي يْعِيشْ فِي الذْنُوبْ رَاهُو عُمْرُو مَا شَافُو وعُمْرُو مَا عَرْفُو.<verse eid="1JN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7" />يَا وْلَادِي مَا تْخَلِّيوِشْ حَتَّى حَدْ يْغَلِّطْكُمْ. الِّي يَعْمِلْ الصَّلَاحْ رَاهُو صَالَحْ كِيفْ مَا المَسِيحْ زَادَا صَالَحْ. <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />ولِّي يْعِيشْ فِي الذْنُوبْ هُوَّ تَابَعْ لْإِبْلِيسْ عْلَى خَاطِرْ إِبْلِيسْ كَانْ يَعْمِلْ فِي الذْنُوبْ مِالأُوِّلْ، وإِبْنْ اللَّهْ جَاء بِالذِّمَة بَاشْ يْهِدْ أَعْمَالْ إِبْلِيسْ.<verse eid="1JN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9" />والمَوْلُودْ مِنْ اللَّهْ مَا يْعِيشِشْ فِي الذْنُوبْ، عْلَى خَاطِرْ الحَيَاةْ الِّي يَعْطِيهَا اللَّهْ تْزَرْعِتْ فِيهْ ومَا عَادِشْ يْنَجِّمْ يْكَمِّلْ يْعِيشْ فِي الذْنُوبْ عْلَى خَاطْرُو مَوْلُودْ مِنْ اللَّهْ. <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />وهَكَّا يْبَانُوا شْكُونْ وْلَادْ اللَّهْ وشْكُونْ وْلَادْ إِبْلِيسْ: الِّي مَا يَعْمِلْشْ الصَّالَحْ رَاهُو مُشْ مِنْ اللَّهْ، ولِّي مَا يْحِبِّشْ خُوهْ زَادَا.<verse eid="1JN 3:10" /></para>
  <para style="s">يِلْزِمْنَا نْحِبُّوا بْعَضْنَا</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />عْلَى خَاطِرْ الخْبَرْ الِّي سْمَعْتُوهْ مِالأُوِّلْ هُوَّ إِنُّو يِلْزِمْنَا نْحِبُّوا بْعَضْنَا. <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />ومَا نْكُونُوشْ كِيمَا قَايِينْ الِّي قْتَلْ خُوهْ. قَايِينْ كَانْ تَابَعْ لْإِبْلِيسْ الشِّرِّيرْ. وعْلَاشْ قْتَلْ خُوهْ؟ عْلَى خَاطِرْ أَعْمَالُو هُوَّ كَانِتْ خَايْبَة آمَا أَعْمَالْ خُوهْ كَانِتْ صَالْحَة.<verse eid="1JN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13" />يَا خْوَاتِي مَا تِسْتَغْرْبُوشْ كَانْ نَاسْ العَالِمْ هَاذَا يِكْرْهُوكُمْ. <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" />وأَحْنَا نَعْرْفُوا الِّي أَحْنَا كُنَّا مُوتَى ووَلِّينَا حَيِّينْ عْلَى خَاطِرْنَا نْحِبُّوا خْوَاتْنَا. الِّي مَا يْحِبِّشْ خُوهْ رَاهُو مَزَّالْ مِيِّتْ. <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />الِّي يِكْرَهْ خُوهْ هُوَّ قَاتِلْ رُوحْ، وإِنْتُومَا تَعْرْفُوا الِّي القَاتِلْ مَا عَنْدُوشْ الحَيَاةْ الأَبَدِيَّة.<verse eid="1JN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 3:16" />وأَحْنَا عْرَفْنَا شْنِيَّة المْحَبَّة الحَقِيقِيَّة وَقْتِلِّي ضَحَّى المَسِيحْ بِحْيَاتُو عْلَى خَاطِرْنَا، وهَاذَاكَا عْلَاشْ لَازِمْ أَحْنَا زَادَا نْضَحِّيوْ بِحْيَاتْنَا عْلَى خَاطِرْ خْوَاتْنَا. <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />إِذَا كَانْ وَاحِدْ عَنْدُو خِيرَاتْ العَالِمْ ويْشُوفْ وَاحِدْ مِنْ خْوَاتُو مِحْتَاجْ ومَا يَرْحْمُوشْ، كِيفَاشْ تْنَجِّمْ تْكُونْ مْحَبِّةْ اللَّهْ فِي قَلْبُو؟<verse eid="1JN 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 3:18" />يَا وْلَادِي مَا يِلْزِمْشْ تْكُونْ مْحَبِّتْنَا بِالفُمْ واللْسَانْ. يِلْزِمْنَا نْحِبُّوا بِالصِّدْقْ وبِالأَفْعَالْ. <verse eid="1JN 3:18" /><verse number="19" style="v" sid="1JN 3:19" />وهَكَّا نَعْرْفُوا الِّي أَحْنَا مَاشِينْ فِي طْرِيقْ الحَقْ وقْلُوبْنَا تِطْمَانْ قُدَّامْ اللَّهْ. <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />وحَتَّى كَانْ قْلُوبْنَا لَامِتْنَا عْلَى حَاجَة، رَاهُو اللَّهْ أَكْبِرْ مِنْ قْلُوبْنَا ويَعْرِفْ كُلْ شَيْ.<verse eid="1JN 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 3:21" />يَا حْبَابِي إِذَا كَانْ قْلُوبْنَا مَا لَامِتْنَاشْ، تْكُونْ عَنْدْنَا ثِيقَة كْبِيرَة قُدَّامْ اللَّهْ ، <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />وأَيْ حَاجَة نُطْلْبُوهَا مِنْ عَنْدُو يَعْطِيهَالْنَا عْلَى خَاطِرْنَا نْطِيعُوا الِّي وَصَّانَا بِيهْ ونَعْمْلُوا الِّي يْرَضِّيهْ. <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" />ووْصِيتُو لِينَا هِيَّ إِنَّا نَمْنُوا بْإِسْمْ إِبْنُو يَسُوعْ المَسِيحْ ونْحِبُّوا بْعَضْنَا كِيمَا وَصَّانَا. <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />الِّي يْطِيعْ وْصَايَا اللَّهْ، يِثْبِتْ فِي اللَّهْ واللَّهْ يِثْبِتْ فِيهْ. والرُّوحْ الِّي عْطَاهُولْنَا يْأَكْدِلْنَا الِّي هُوَّ ثَابِتْ فِينَا.<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s">إِمْتَحْنُوا الأَرْوَاحْ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />يَا حْبَابِي مَا تْصَدْقُوشْ كُلْ رُوحْ آمَا تْأَكْدُوا مِنْهَا كَانْ هِيَّ مِنْ عَنْدْ اللَّهْ وَلَّا لَا، عْلَى خَاطِرْ بَرْشَة أَنْبِيَاءْ كَذَّابِينْ كُثْرُوا فِي العَالِمْ الكُلْ. <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />وهَاوْ كِيفَاشْ تَعْرْفُوا رُوحْ اللَّهْ: كُلْ رُوحْ يِسْتَعْرِفْ بِلِّي يَسُوعْ المَسِيحْ جَاء لِلْأَرْضْ فِي بْدَنْ إِنْسَانْ رَاهُو مِنْ عَنْدْ اللَّهْ. <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />وكُلْ رُوحْ مَا يِسْتَعْرِفْشْ الِّي يَسُوعْ جَاء فِي بْدَنْ إِنْسَانْ، رَاهُو مُشْ مِنْ عَنْدْ اللَّهْ آمَا هَاذَا هُوَّ رُوحْ المَسِيحْ الدَّجَّالْ الِّي سْمَعْتُوا إِنُّو بِشْ يْجِي، وهُوَّ تَوَّا مَوْجُودْ فِي العَالِمْ.<verse eid="1JN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4" />يَا وْلَادِي إِنْتُومَا مِنْ عَنْدْ اللَّهْ وغْلِبْتُوا الأَنْبِيَاءْ الكَذَّابِينْ عْلَى خَاطِرْ الرُّوحْ القُدُسْ الِّي فِيكُمْ أَقْوَى مِنْ رُوحْ المَسِيحْ الدَّجَّالْ الِّي فِي العَالِمْ. <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />وهُومَا مِالعَالِمْ هَاذَا ويِتْكَلْمُوا بْأَفْكَارْ العَالِمْ، هَاذَاكَا عْلَاشْ النَّاسْ الِّي تَابْعِينْ العَالِمْ هَاذَا يِسْمْعُولْهُمْ. <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />آمَا أَحْنَا تَابْعِينْ اللَّهْ ولِّي يَعْرِفْ اللَّهْ يِسْمْعِلْنَا ولِّي مُشْ تَابَعْ اللَّهْ مَا يِسْمْعِلْنَاشْ. وهَكَّا انَّجْمُوا نَعْرْفُوا رُوحْ الحَقْ مِنْ رُوحْ البَاطِلْ.<verse eid="1JN 4:6" /></para>
  <para style="s">اللَّهْ مْحَبَّة</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />يَا حْبَابِي، يِلْزِمْنَا نْحِبُّوا بْعَضْنَا عْلَى خَاطِرْ المْحَبَّة تْجِي مِنْ عَنْدْ اللَّهْ، وكُلْ وَاحِدْ يْحِبْ هُوَّ مَوْلُودْ مِنْ اللَّهْ ويَعْرِفْ اللَّهْ. <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />ولِّي مَا عَنْدُوشْ مْحَبَّة مَا يَعْرِفْشْ اللَّهْ عْلَى خَاطِرْ اللَّهْ مْحَبَّة. <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />واللَّهْ وَرَّى مْحَبْتُو لِينَا، وَقْتِلِّي بْعَثْ إِبْنُو الوَحِيدْ لِلْعَالِمْ بَاشْ نَحْيَاوْ بِيهْ. <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />والمْحَبَّة الحْقِيقِيَّة هِيَّ إِنُّو مُشْ أَحْنَا الِّي حَبِّينَا اللَّهْ، آمَا هُوَّ الِّي حَبْنَا وبْعَثْ إِبْنُو بَاشْ يْكُونْ الضْحِيَّة الِّي تْكَفِّرْ عْلَى ذْنُوبْنَا. <verse eid="1JN 4:10" /><verse number="11" style="v" sid="1JN 4:11" />يَا حْبَابِي، مَادَامْ اللَّهْ حَبْنَا المْحَبَّة العْظِيمَة هَاذِي، لَازِمْ أَحْنَا زَادَا نْحِبُّوا بْعَضْنَا. <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />حَتَّى وَاحِدْ مَا شَافْ اللَّهْ آمَا وَقْتِلِّي نْحِبُّوا بْعَضْنَا، اللَّهْ يِثْبِتْ فِينَا وتْكُونْ مْحَبْتُو كَامْلَة فِي قْلُوبْنَا.<verse eid="1JN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13" />ولِّي يْأَكْدِلْنَا الِّي أَحْنَا ثَابْتِينْ فِي اللَّهْ وهُوَّ ثَابِتْ فِينَا، هُوَّ إِنُّو عْطَانَا مِنْ رُوحُو. <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />وأَحْنَا بِيدْنَا رِينَا ونِشْهْدُوا إِنُّو الآبْ بْعَثْ إِبْنُو بَاشْ يْنَجِّي العَالِمْ. <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />كُلْ وَاحِدْ يِسْتَعْرِفْ إِنُّو يَسُوعْ هُوَّ إِبْنْ اللَّهْ، يِثْبِتْ فِي اللَّهْ واللَّهْ يِثْبِتْ فِيهْ.<verse eid="1JN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 4:16" />وأَحْنَا نَعْرْفُوا الِّي اللَّهْ يْحِبْنَا وعَنْدْنَا ثِيقَة فِي هَاذَا. اللَّهْ مْحَبَّة، ولِّي يِثْبِتْ فِي المْحَبَّة، يِثْبِتْ فِي اللَّهْ واللَّهْ يِثْبِتْ فِيهْ. <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />وهَكَّا تْكُونْ مْحَبِّةْ اللَّهْ كَامْلَة فِينَا وتْكُونْ عَنْدْنَا ثِيقَة نْهَارْ الحْسَابْ، عْلَى خَاطِرْ أَحْنَا فِي العَالِمْ هَاذَا، نْعِيشُوا كِيمَا عَاشْ المَسِيحْ. <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />مَا فَمَّة حَتَّى خُوفْ فِي المْحَبَّة، آمَا المْحَبَّة الكَامْلَة تْنَحِّي كُلْ خُوفْ، عْلَى خَاطِرْ الخُوفْ هُوَّ الخُوفْ مِالعِقَابْ، ولِّي يْخَافْ مَا تْكُونِشْ مْحَبِّةْ اللَّهْ كَامْلَة فِيهْ.<verse eid="1JN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19" />آمَا بِالنِّسْبَة لِينَا، أَحْنَا نْحِبُّوا عْلَى خَاطِرْ اللَّهْ هُوَّ الِّي حَبْنَا الأُوِّلْ. <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />ولِّي يْقُولْ الِّي هُوَّ يْحِبْ اللَّهْ وهُوَّ يِكْرَهْ خُوهْ، رَاهُو كَذَّابْ. عْلَى خَاطِرْ الِّي مَا يْحِبِّشْ خُوهْ الِّي يْشُوفُو، كِيفَاشْ يْنَجِّمْ يْحِبْ اللَّهْ الِّي مَا يْشُوفُوشْ؟ <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />وهَاذِي الوْصِيَّة الِّي عْطَاهَالْنَا: الِّي يْحِبْ اللَّهْ يِلْزْمُو يْحِبْ خُوهْ زَادَا.<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s">الإِيمَانْ بِإِبْنْ اللَّهْ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />كُلْ وَاحِدْ يَمِّنْ إِنُّو يَسُوعْ هُوَّ المَسِيحْ، هُوَّ مَوْلُودْ مِنْ اللَّهْ، ولِّي يْحِبْ البُو يْحِبْ وْلَادُو زَادَا. <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />وإِذَا كَانْ نْحِبُّوا اللَّهْ ونْطَبْقُوا الِّي وَصَّى بِيهْ، هَاذَا يْأَكْدِلْنَا الِّي أَحْنَا نْحِبُّوا وْلَادْ اللَّهْ. <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" />ومْحَبِّتْنَا لِلَّهْ تُظْهِرْ وَقْتِلِّي نْطَبْقُوا الِّي وَصَّى بِيهْ. والوْصَايَا مْتَاعُو مَاهِيشْ صْعِيبَة، <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />عْلَى خَاطِرْ المَوْلُودْ مِنْ اللَّهْ يِغْلِبْ العَالِمْ. وإِيمَانَّا هُوَّ الِّي يْخَلِّينَا نِغْلْبُوا العَالِمْ. <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />وشْكُونْ الِّي يْنَجِّمْ يِغْلِبْ العَالِمْ هَاذَا؟ مَا يِغْلْبُو كَانْ الِّي يَمِّنْ إِنُّو يَسُوعْ هُوَّ إِبْنْ اللَّهْ.<verse eid="1JN 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />ويَسُوعْ المَسِيحْ هُوَّ الِّي جَاء بِالمَاء والدَّمْ، مُشْ بِالمَاء أَكَهَوْ آمَا بِالمَاء والدَّمْ، والحْقِيقَة هَاذِي يِشْهْدِلْهَا الرُّوحْ عْلَى خَاطِرْ الرُّوحْ هُوَّ الحَقْ. <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />الِّي يِشْهْدُوا لِلْمَسِيحْ هُومَا ثْلَاثَة، <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />الرُّوحْ والمَاء والدَّمْ، والثْلَاثَة هَاذُومَا مِتَّفْقِينْ. <verse eid="1JN 5:8" /><verse number="9" style="v" sid="1JN 5:9" />أَحْنَا نِقْبْلُوا شْهَادِةْ العْبَادْ، آمَا رَاهِي شْهَادِةْ اللَّهْ أَعْظِمْ، عْلَى خَاطِرْ هَاذِي شْهَادِةْ اللَّهْ نَفْسُو شْهِدْ بِيهَا لْإِبْنُو. <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />الِّي يَمِّنْ بِإِبْنْ اللَّهْ عَنْدُو الشْهَادَة هَاذِي فِي قَلْبُو، آمَا الِّي مَا يْصَدَّقْشْ اللَّهْ، يِتْهِمْ اللَّهْ بِالكِذْبْ عْلَى خَاطِرْ مَا يْصَدَّقْشْ الشْهَادَة الِّي شْهِدْ بِيهَا لْإِبْنُو. <verse eid="1JN 5:10" /><verse number="11" style="v" sid="1JN 5:11" />وهَاذِي هِيَّ شْهَادِةْ اللَّهْ، إِنُّو عْطَانَا الحَيَاةْ الأَبَدِيَّة والحَيَاةْ هَاذِي عْطَاهَالْنَا فِي إِبْنُو. <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />الِّي عَنْدُو إِبْنْ اللَّهْ عَنْدُو الحَيَاةْ ولِّي مَا عَنْدُوشْ إِبْنْ اللَّهْ مَا عَنْدُوشْ الحَيَاةْ.<verse eid="1JN 5:12" /></para>
  <para style="s">خَاتْمَة</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />إِنْتُومَا الِّي تَمْنُوا بْإِسْمْ إِبْنْ اللَّهْ، كْتِبْتِلْكُمْ هَاذَا بَاشْ تَعْرْفُوا الِّي عَنْدْكُمْ الحَيَاةْ الأَبَدِيَّة. <verse eid="1JN 5:13" /><verse number="14" style="v" sid="1JN 5:14" />وعَنْدْنَا ثِيقَة فِي اللَّهْ إِنُّو كِي نُطْلْبُوا مِنُّو حَاجَة تِتْوَافِقْ مْعَ الِّي يْحِبُّو هُوَّ يِسْمَعْنَا. <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />ومَادَامْنَا نَعْرْفُوا الِّي هُوَّ دِيمَا يِسْمْعِلْنَا، نَعْرْفُوا زَادَا الِّي هُوَّ يَعْطِينَا الِّي طْلَبْنَاهْ.<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />كَانْ وَاحِدْ يْشُوفْ خُوهْ يَعْمِلْ فِي ذَنْبْ مَا يْوَصْلُوشْ لِلْمُوتْ، يِلْزْمُو يِدْعِيلُو، وهَكَّا اللَّهْ يَعْطِيهْ الحَيَاةْ. هَاذَا إِذَا كَانْ الذَّنْبْ الِّي يَعْمِلْ فِيهْ مَا يْوَصَّلْشْ لِلْمُوتْ. فَمَّة ذَنْبْ يْوَصَّلْ لِلْمُوتْ، وآنَا هُونِي مَا نُقْصُدْشْ الِّي لَازِمْ نِدْعِيوْ عْلَى خَاطِرْ الذَّنْبْ هَاذَا. <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />كُلْ مَعْصْيَة هِيَّ ذَنْبْ آمَا مُشْ كُلْ ذَنْبْ يْوَصَّلْ لِلْمُوتْ.<verse eid="1JN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18" />أَحْنَا نَعْرْفُوا الِّي كُلْ وَاحِدْ مَوْلُودْ مِنْ اللَّهْ مَا يْعِيشِشْ فِي الذْنُوبْ، عْلَى خَاطِرْ إِبْنْ اللَّهْ يَحْفْظُو وإِبْلِيسْ الشِّرِّيرْ مَا يْنَجَّمْشْ يْضُرُّو. <verse eid="1JN 5:18" /><verse number="19" style="v" sid="1JN 5:19" />نَعْرْفُوا الِّي أَحْنَا تَابْعِينْ اللَّهْ ولِّي العَالِمْ هَاذَا الكُلْ مْسَيْطِرْ عْلِيهْ إِبْلِيسْ الشِّرِّيرْ. <verse eid="1JN 5:19" /><verse number="20" style="v" sid="1JN 5:20" />ونَعْرْفُوا زَادَا الِّي إِبْنْ اللَّهْ جَاء ونَوَّرْنَا بَاشْ نَعْرْفُوا الإِلَاهْ الحَقْ، وأَحْنَا تَوَّا تَابْعِينْ الإِلَاهْ الحَقْ، عْلَى خَاطِرْنَا تَابْعِينْ إِبْنُو يَسُوعْ المَسِيحْ الِّي هُوَّ الإِلَاهْ الحَقْ وهُوَّ الحَيَاةْ الأَبَدِيَّة.<verse eid="1JN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21" />يَا وْلَادِي رُدُّوا بَالْكُمْ اتَّبْعُوا الصْنَبْ.<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>