<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2CO" style="id" />
  <para style="h">كُورِنْثُوسْ الثَّانْيَة</para>
  <para style="toc1">رِسَالِةْ بُولِسْ الثَّانْيَة لِلْمُؤْمْنِينْ الِّي فِي كُورِنْثُوسْ</para>
  <para style="toc2">كُورِنْثُوسْ الثَّانْيَة</para>
  <para style="toc3">كُورِنْثُوسْ الثَّانْيَة</para>
  <para style="mt">رِسَالِةْ بُولِسْ الثَّانْيَة لِلْمُؤْمْنِينْ الِّي فِي كُورِنْثُوسْ</para>
  <chapter number="1" style="c" sid="2CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 1:1" />مِنْ بُولِسْ، الِّي اخْتَارُو اللَّهْ بَاشْ يْكُونْ رَسُولْ يَسُوعْ المَسِيحْ، ومِنْ خُونَا تِيمُوثَاوُسْ، لِكْنِيسِةْ اللَّهْ الِّي فِي كُورِنْثُوسْ، ولِلْقِدِّيسِينْ الكُلْ المَوْجُودِينْ فِي مَنْطَقْةْ أَخَائِيَة الكُلْ.<verse eid="2CO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 1:2" />النِّعْمَة والسَّلَامْ لِيكُمْ مِنْ عَنْدْ اللَّهْ بُونَا والرَّبْ يَسُوعْ المَسِيحْ.<verse eid="2CO 1:2" /></para>
  <para style="s">اللَّهْ يْشَجَّعْنَا فِي وَقْتْ الضِّيقْ</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 1:3" />مُبَارَكْ اللَّهْ، بُو رَبْنَا يَسُوعْ المَسِيحْ، البُو الرَّحِيمْ وإِلَاهْ كُلْ تَشْجِيعْ، <verse eid="2CO 1:3" /><verse number="4" style="v" sid="2CO 1:4" />الِّي يْشَجَّعْنَا فِي كُلْ ضِيقَة نِتْعَدَّاوْ بِيهَا، بَاشْ أَحْنَا زَادَا انَّجْمُوا نْشَجْعُوا غِيرْنَا فِي ضِيقِتْهُمْ، بْنَفْسْ التَّشْجِيعْ الِّي خْذِينَاهْ مِنْ عَنْدْ اللَّهْ. <verse eid="2CO 1:4" /><verse number="5" style="v" sid="2CO 1:5" />وكِيمَا قَاعْدِينْ نِتْشَارْكُوا مْعَ المَسِيحْ فِي وْجَايْعُوا، كِيمَا يْفِيضْ عْلِينَا التَّشْجِيعْ بِالمَسِيحْ زَادَا. <verse eid="2CO 1:5" /><verse number="6" style="v" sid="2CO 1:6" />وإِذَا كَانْ أَحْنَا فِي ضِيقْ، رَاهُو بَاشْ إِنْتُومَا تِتْشَجْعُوا وتِنْجَاوْ. وإِذَا كَانْ أَحْنَا مِتْشَجْعِينْ رَاهُو بَاشْ نْشَجْعُوكُمْ إِنْتُومَا، وهَاذَا يْخَلِّيكُمْ تُصْبْرُوا وتِتْحَمْلُوا نَفْسْ الوْجَايَعْ الِّي نِتْحَمْلُوا فِيهَا. <verse eid="2CO 1:6" /><verse number="7" style="v" sid="2CO 1:7" />ورْجَانَا مِنْ نَاحْيِتْكُمْ مَا يِتْبَدَّلْشْ، عْلَى خَاطِرْنَا نَعْرْفُوا الِّي كِيمَا تِتْشَارْكُوا مْعَانَا فِي الوْجَايَعْ، بِشْ تِتْشَارْكُوا مْعَانَا زَادَا فِي التَّشْجِيعْ.<verse eid="2CO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 1:8" />ونْحِبُّوكُمْ تَعْرْفُوا يَا خْوَاتِي المِحْنَة الِّي تْعَدِّينَا بِيهَا فِي مَنْطَقْةْ آسِيَّا. رَاهِي كَانِتْ صْعِيبَةْ بَرْشَة، وفُوقْ طَاقِتْنَا لْدَرْجِةْ إِنُّو فْقِدْنَا الأَمَلْ فِي إِنَّا نُقْعْدُوا حَيِّينْ. <verse eid="2CO 1:8" /><verse number="9" style="v" sid="2CO 1:9" />أَصْلًا حَسِّينَا الِّي مَحْكُومْ عْلِينَا بِالمُوتْ، وهَاذَا صَارْ بَاشْ مَا نْعَمْلُوشْ عْلَى رْوَاحْنَا، آمَا نِتْوَكْلُوا عْلَى اللَّهْ الِّي يْقَيِّمْ المُوتَى. <verse eid="2CO 1:9" /><verse number="10" style="v" sid="2CO 1:10" />وهُوَّ الِّي مَنَّعْنَا مِالمُوتْ هَاذَا، ومَزَّالْ يْمَنَّعْ فِينَا حَتَّى لْتَوَّا، وعَنْدْنَا ثِيقَة إِنُّو بِشْ يْزِيدْ يْمَنَّعْنَا. <verse eid="2CO 1:10" /><verse number="11" style="v" sid="2CO 1:11" />وإِنْتُومَا بِشْ تْعَاوْنُونَا بْصْلَاوَاتْكُمْ، وهَاذَا بِشْ يْخَلِّي بَرْشَة نَاسْ يُشْكْرُوا اللَّهْ عْلَى خَاطِرْنَا، وَقْتِلِّي يِقْبِلْ صْلَاوَاتْ بَرْشَة نَاسْ ويْبَارِكْنَا.<verse eid="2CO 1:11" /></para>
  <para style="s">بُولِسْ يْوَخِّرْ زْيَارْتُو</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 1:12" />وأَحْنَا نِتْفَخِّرُوا بِشْهَادِةْ ضَمِيرْنَا: الِّي أَحْنَا تْصَرَّفْنَا مْعَ النَّاسْ الكُلْ وخَاصَّةً مْعَاكُمْ إِنْتُومَا، بِصِدْقْ وأَمَانَة مِنْ عَنْدْ اللَّهْ، مُشْ بْحِكْمَة بَشَرِيَّة، آمَا بْنِعْمِةْ اللَّهْ. <verse eid="2CO 1:12" /><verse number="13" style="v" sid="2CO 1:13" />وأَحْنَا مَا نِكْتْبُولْكُمْ كَانْ الِّي تْنَجْمُوا تَقْرَاوُهْ وتِفْهْمُوهْ، ونِتْمَنَّى الِّي إِنْتُومَا تِفْهْمُوهْ بِالحَقْ. <verse eid="2CO 1:13" /><verse number="14" style="v" sid="2CO 1:14" />ونِتْمَنَّى الِّي، كِيمَا فْهِمْتُوا شْوَيَّة حَاجَاتْ بِخْصُوصْنَا، تْنَجْمُوا تِفْهْمُوا كُلْ شَيْ عْلِينَا، بَاشْ تِتْفَخْرُوا بِينَا، كِيمَا أَحْنَا زَادَا بِشْ نِتْفَخْرُوا بِيكُمْ نْهَارِةْ الِّي يِرْجَعْ رَبْنَا يَسُوعْ.<verse eid="2CO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 1:15" />وعْلَى خَاطِرْنِي كُنْتْ مِتْأَكِّدْ مِنْ هَاذَا، قَرَّرْتْ نْزُورْكُمْ فِي الأُوِّلْ، بَاشْ تِسْتْفَادُوا مَرْتِينْ، <verse eid="2CO 1:15" /><verse number="16" style="v" sid="2CO 1:16" />ونِتْعَدَّالْكُمْ وآنَا مَاشِي لْمَنْطَقْةْ مَقْدُونِيَّة، ونْعَاوِدْ نْجِيكُمْ وآنَا رَاجَعْ مِنْهَا، بَاشْ تْعَاوْنُونِي عَالسْفَرْ لْمَنْطَقْةْ اليَهُودِيَّة. <verse eid="2CO 1:16" /><verse number="17" style="v" sid="2CO 1:17" />يَاخِي فِي بَالْكُمْ الِّي آنَا خْذِيتْ القَرَارْ هَاذَا هَكَّاكَا؟ وَلَّا نْقَرِّرْ كِي بْقِيِّةْ النَّاسْ، ونْقُولْ «إِيْ» و «لَا» فِي نَفْسْ الوَقْتْ؟ <verse eid="2CO 1:17" /><verse number="18" style="v" sid="2CO 1:18" />واللَّهْ الأَمِينْ يِشْهِدْ الِّي كْلَامْنَا لِيكُمْ مَا كَانِشْ «إِيْ» و «لَا» فِي نَفْسْ الوَقْتْ! <verse eid="2CO 1:18" /><verse number="19" style="v" sid="2CO 1:19" />عْلَى خَاطِرْ يَسُوعْ المَسِيحْ إِبْنْ اللَّهْ الِّي بَشِّرْنَاكُمْ بِيهْ، آنَا وسِلْوَانُسْ وتِيمُوثَاوُسْ، مَا كَانِشْ نْعَمْ ولَا فِي نَفْسْ الوَقْتْ، آمَا كَانْ دِيمَا نْعَمْ. <verse eid="2CO 1:19" /><verse number="20" style="v" sid="2CO 1:20" />هُوَّ «النْعَمْ» لْوُعُودْ اللَّهْ الكُلْ. هَاذَاكَا عْلَاشْ أَحْنَا نْمَجْدُوا اللَّهْ وَقْتِلِّي نْقُولُوا «آمِينَ» بِإِسْمُو. <verse eid="2CO 1:20" /><verse number="21" style="v" sid="2CO 1:21" />واللَّهْ هُوَّ الِّي يْثَبِّتْنَا الكُلْ فِي المَسِيحْ، وهُوَّ الِّي إِخْتَارْنَا، <verse eid="2CO 1:21" /><verse number="22" style="v" sid="2CO 1:22" />وهُوَّ زَادَا الِّي حَطْ عْلِينَا طَابِعْ المِلْكِيَّة مْتَاعُو، وعْطَانَا الرُّوحْ القُدُسْ فِي قْلُوبْنَا كِيمَا العَرْبُونْ.<verse eid="2CO 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 1:23" />واللَّهْ يِشْهِدْ إِنِّي قَرَّرْتْ مَا نِرْجَعْشْ لْكُورِنْثُوسْ عْلَى خَاطِرْ مَا حَبِّيتِشْ نْكُونْ صْعِيبْ مْعَاكُمْ. <verse eid="2CO 1:23" /><verse number="24" style="v" sid="2CO 1:24" />رَانَا مَا نْحِبُّوشْ نِتْحَكْمُوا فِي إِيمَانْكُمْ، آمَا نْحِبُّوا نِخْدْمُوا مْعَاكُمْ بَاشْ تِفْرْحُوا، عْلَى خَاطِرْكُمْ ثَابْتِينْ فِي الإِيمَانْ.<verse eid="2CO 1:24" /></para>
  <chapter eid="2CO 1" />
  <chapter number="2" style="c" sid="2CO 2" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 2:1" />هَاذَاكَا عْلَاشْ قَرَّرْتْ بَاشْ مَا نْجِيكُمْشْ، بَاشْ مَا نْحَزِّنْكُمْشْ مَرَّة أُخْرَى. <verse eid="2CO 2:1" /><verse number="2" style="v" sid="2CO 2:2" />إِذَا كَانْ نْحَزَّنْكُمْ، مَالَا شْكُونْ بِشْ يْفَرَّحْنِي بِخْلَافْ الِّي حَزَّنْتْهُمْ؟ <verse eid="2CO 2:2" /><verse number="3" style="v" sid="2CO 2:3" />وكْتِبْتِلْكُمْ الِّي كْتِبْتُو، عْلَى خَاطِرْ وَقْتِلِّي نْجِيكُمْ مَا نْحِبِّشْ نِحْزِنْ بِسْبَبْ الِّي مِالمَفْرُوضْ يْفَرْحُونِي. وآنَا نَاثِقْ إِنُّو الِّي يْفَرَّحْنِي يْفَرَّحْكُمْ الكُلْ. <verse eid="2CO 2:3" /><verse number="4" style="v" sid="2CO 2:4" />وكْتِبْتْهُولْكُمْ وقَلْبِي حْزِينْ ومَهْمُومْ، ودْمُوعِي فِي عِينَيَّا. مَا كَانِشْ قَصْدِي نْحَزِّنْكُمْ، آمَا حَبِّيتْكُمْ تَعْرْفُوا قَدَّاشْ نْحِبْكُمْ.<verse eid="2CO 2:4" /></para>
  <para style="s">سَامْحُوا المُذْنِبْ</para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 2:5" />ولِّي خَلَّانِي حْزِينْ، مَا حَزَّنِّيشْ آنَا وَحْدِي، آمَا حَزَّنْكُمْ الكُلْ حَتَّى ولَوْ شْوَيَّة، قُلْتْ «حَتَّى ولَوْ شْوَيَّة» بَاشْ مَا نْبَالِغْشْ. <verse eid="2CO 2:5" /><verse number="6" style="v" sid="2CO 2:6" />والرَّاجِلْ هَاذَا يِزِّيهْ العِقَابْ الِّي أَغْلَبِيِّتْكُمْ عَاقْبُوهْ بِيهْ. <verse eid="2CO 2:6" /><verse number="7" style="v" sid="2CO 2:7" />وتَوَّا مِالأَحْسِنْ كَانْ تْسَامْحُوهْ وتْشَجْعُوهْ بَاشْ مَا يُغْرُقْشْ فِي الحُزْنْ. <verse eid="2CO 2:7" /><verse number="8" style="v" sid="2CO 2:8" />هَاذَاكَا عْلَاشْ نُطْلُبْ مِنْكُمْ بَاشْ تْبَيْنُولُو الِّي إِنْتُومَا تْحِبُّوهْ بِالحَقْ. <verse eid="2CO 2:8" /><verse number="9" style="v" sid="2CO 2:9" />وهَاذَا عْلَاشْ كْتِبْتِلْكُمْ، بَاشْ نْجَرَّبْكُمْ ونْشُوفْ إِذَا كَانْ اطِّيعُونِي فِي كُلْ شَيْ. <verse eid="2CO 2:9" /><verse number="10" style="v" sid="2CO 2:10" />الِّي تْسَامْحُوهْ آنَا زَادَا نْسَامْحُو، وإِذَا كَانْ فَمَّة حَاجَة سَامَحْتْ عْلِيهَا تِسْتْحَقْ السْمَاحْ، رَانِي سَامَحْتْ قُدَّامْ المَسِيحْ عْلَى خَاطِرْكُمْ إِنْتُومَا، <verse eid="2CO 2:10" /><verse number="11" style="v" sid="2CO 2:11" />بَاشْ الشِّيطَانْ مَا يِغْلِبْنَاشْ، عْلَى خَاطِرْ أَفْكَارُو مَا تَخْفَاشْ عْلِينَا.<verse eid="2CO 2:11" /></para>
  <para style="s">أَحْنَا غَالْبِينْ فِي المَسِيحْ</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 2:12" />وَقْتِلِّي وْصِلْتْ لْمْدِينِةْ تَرُوَاسْ بَاشْ نْبَشِّرْ بِبْشَارِةْ المَسِيحْ، لْقِيتْ الِّي الرَّبْ حَلِّي بَابْ لِلْخِدْمَة. <verse eid="2CO 2:12" /><verse number="13" style="v" sid="2CO 2:13" />آمَا تْقَلَّقْتْ بَرْشَة عْلَى خَاطِرْ مَا لْقِيتِشْ خُويَا تِيطُسْ، وَلِّيتْ وَدَّعْتْ الإِخْوَة وسَافِرْتْ لْمَنْطَقْةْ مَقْدُونِيَّة.<verse eid="2CO 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 2:14" />الحَمْدْ لِلَّهْ الِّي دِيمَا يْقُودْنَا فِي مَحْفِلْ نَصْرُو بْصِيفِتْنَا مُؤْمْنِينْ بِالمَسِيحْ، ولِّي عْلَى طْرِيقْنَا يْخَلِّي مَعْرِفْةْ المَسِيحْ تُوصِلْ لِلنَّاسْ كِي الرِّيحَة البْنِينَة الِّي تْفُوحْ فِي كُلْ بْلَاصَة. <verse eid="2CO 2:14" /><verse number="15" style="v" sid="2CO 2:15" />عْلَى خَاطِرْنَا أَحْنَا بِالنِّسْبَة لِلَّهْ رِيحِةْ المَسِيحْ الطَّيْبَة، الِّي تْفُوحْ بِينْ النَّاجِينْ وبِينْ الهَالْكِينْ، <verse eid="2CO 2:15" /><verse number="16" style="v" sid="2CO 2:16" />رِيحِةْ مُوتْ تْوَصِّلْ الهَالْكِينْ لِلْمُوتْ، ورِيحِةْ حَيَاةْ تْوَصِّلْ النَّاجِينْ لِلْحَيَاةْ. وشْكُونْ قَدْ المَسْؤُولِيَّة هَاذِي؟ <verse eid="2CO 2:16" /><verse number="17" style="v" sid="2CO 2:17" />أَحْنَا مَا نْتَاجْرُوشْ بِكْلَامْ اللَّهْ كِيمَا يَعْمْلُوا بَرْشَة نَاسْ أُخْرِينْ، آمَا نِتْكَلْمُوا بِكْلَامْ صَادِقْ قُدَّامْ اللَّهْ بْصِيفِتْنَا مِتَّحْدِينْ مْعَ المَسِيحْ ومَبْعُوثِينْ مِنْ اللَّهْ.<verse eid="2CO 2:17" /></para>
  <chapter eid="2CO 2" />
  <chapter number="3" style="c" sid="2CO 3" />
  <para style="s">أَحْنَا خُدَّامْ العَهْدْ الجْدِيدْ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 3:1" />زَعْمَة رْجَعْنَا نُفْخْرُوا فِي رْوَاحْنَا مَرَّة أُخْرَى؟ وَلَّا بَالِكْشِي نِسْتْحَقُّوا رَسَايِلْ تَوْصْيَة مِنْكُمْ وَلَّا لِيكُمْ كِيمَا النَّاسْ الأُخْرِينْ؟ <verse eid="2CO 3:1" /><verse number="2" style="v" sid="2CO 3:2" />لَا، آمَا إِنْتُومَا رِسَالِةْ التَّوْصْيَة بِالنِّسْبَة لِينَا، مَكْتُوبَة فِي قْلُوبْنَا، يَعْرْفُوهَا ويَقْرَاوْهَا النَّاسْ الكُلْ. <verse eid="2CO 3:2" /><verse number="3" style="v" sid="2CO 3:3" />وَاضِحْ الِّي إِنْتُومَا رِسَالِةْ المَسِيحْ الِّي جَاتْ عْلَى يْدِينَا، وهِيَّ مَكْتُوبَة مُشْ بِالحْبَارْ، آمَا بْرُوحْ اللَّهْ الحَيْ مُشْ عْلَى أَلْوَاحْ مِالحْجَرْ، آمَا عْلَى أَلْوَاحْ لْحَمْ ودَمْ، الِّي هِيَّ قْلُوبْكُمْ.<verse eid="2CO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 3:4" />وهَاذِي هِيَّ الثِّيقَة الِّي عَنَّا فِي اللَّهْ بِالمَسِيحْ. <verse eid="2CO 3:4" /><verse number="5" style="v" sid="2CO 3:5" />وهَاذَا مَا يَعْنِيشْ الِّي أَحْنَا قَادْرِينْ نَعْمْلُوا حَاجَة بْقُوِّتْنَا، آمَا قُدْرِتْنَا تْجِي مِنْ عَنْدْ اللَّهْ. <verse eid="2CO 3:5" /><verse number="6" style="v" sid="2CO 3:6" />وهُوَّ الِّي رَدْنَا قَادْرِينْ بَاشْ نِخْدْمُوا العَهْدْ الجْدِيدْ، عَهْدْ قَايِمْ عْلَى رُوحْ اللَّهْ، مُشْ عَالشَّرِيعَة المَكْتُوبَةْ بِحْرُوفْ، عْلَى خَاطِرْ الشَّرِيعَة المَكْتُوبَةْ تُحْكُمْ بِالمُوتْ، آمَا الرُّوحْ يَعْطِي حَيَاةْ.<verse eid="2CO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 3:7" />إِذَا كَانْ خِدْمِةْ عَهْدِ المُوتْ الِّي حْرُوفْهَا مَنْقُوشَة عَالحْجَرْ جَاتْ فِي مَجْدْ، لْدَرْجِةْ إِنُّو بَنِي إِسْرَائِيلْ مَا نَجْمُوشْ يُخْزْرُوا لْوِجْهْ مُوسَى مِنْ قُوِّةْ المَجْدْ الِّي فِيهْ، رَغْمِلِّي كَانْ مَجْدْ فَانِي، <verse eid="2CO 3:7" /><verse number="8" style="v" sid="2CO 3:8" />مَالَا قَدَّاشْ خِدْمِةْ عَهْدِ الرُّوحْ بَاشْ يْكُونْ مَجْدْهَا أَعْظِمْ؟ <verse eid="2CO 3:8" /><verse number="9" style="v" sid="2CO 3:9" />مَادَامْ الخِدْمِة الِّي حُكْمِتْ عَالنَّاسْ بِالعِقَابْ فِيهَا مَجْدْ، مَالَا قَدَّاشْ بِشْ يْكُونْ أَعْظِمْ مَجْدْ الخِدْمَة الِّي تْرُدْهُمْ صَالْحِينْ قُدَّامْ اللَّهْ. <verse eid="2CO 3:9" /><verse number="10" style="v" sid="2CO 3:10" />ولِّي كَانْ عَنْدُو مَجْدْ قْبَلْ، مَعَادِشْ عَنْدُو مَجْدْ قُدَّامْ المَجْدْ المَوْجُودْ تَوَّا، ولِّي هُوَّ أَقْوَى مِنُّو بَرْشَة. <verse eid="2CO 3:10" /><verse number="11" style="v" sid="2CO 3:11" />إِذَا كَانْ الحَاجَاتْ الفَانِيَة عَنْدْهَا مَجْدْ، مَالَا قَدَّاشْ بِشْ يْكُونْ مَجْدْ الحَاجَاتْ الدَّايْمَة؟<verse eid="2CO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 3:12" />وعْلَى خَاطِرْ عَنَّا الرْجَى هَاذَا، أَحْنَا نِتْكَلْمُوا بْثِيقَة كْبِيرَة. <verse eid="2CO 3:12" /><verse number="13" style="v" sid="2CO 3:13" />ومَانَاشْ كِيفْ مُوسَى الِّي حَطْ حِجَابْ عْلَى وِجْهُو بَاشْ بَنِي إِسْرَائِيلْ مَا يْشُوفُوشْ إِنُّو المَجْدْ الِّي عْلَى وِجْهُو مُشْ دَايِمْ وقَاعِدْ يِتْنَحَّى. <verse eid="2CO 3:13" /><verse number="14" style="v" sid="2CO 3:14" />آمَا مْخَاخْهُمْ وَلَّاتْ مْسَكْرَة، عْلَى خَاطِرْ الحْجَابْ هَاذَاكَا مَزَّالْ مَوْجُودْ لِلْيُومْ وَقْتِلِّي يَقْرَاوْ العَهْدْ القْدِيمْ، ومَا بِشْ يِتْنَحَّى كَانْ كِي يَمْنُوا بِالمَسِيحْ. <verse eid="2CO 3:14" /><verse number="15" style="v" sid="2CO 3:15" />ولِلْيُومْ، مَزَّالْ الحِجَابْ مَوْجُودْ عْلَى قْلُوبْهُمْ، وَقْتِلِّي يَقْرَاوْ تَوْرَاةْ مُوسَى. <verse eid="2CO 3:15" /><verse number="16" style="v" sid="2CO 3:16" />آمَا وَقْتِلِّي الوَاحِدْ يَمِّنْ بِالرَّبْ، يِتْنَحَّى الحِجَابْ. <verse eid="2CO 3:16" /><verse number="17" style="v" sid="2CO 3:17" />والرَّبْ هُوَّ الرُّوحْ، ووِينْ يْكُونْ رُوحْ الرَّبْ، تْكُونْ فَمَّة الحُرِّيَّة. <verse eid="2CO 3:17" /><verse number="18" style="v" sid="2CO 3:18" />وأَحْنَا الكُلْ قَاعْدِينْ نُخْزْرُوا لْمَجْدْ الرَّبْ بِوْجُوهْ مُشْ مْغُطْيَة كِيفْ مَا نُخْزْرُوا فِي مْرَايَة، وقَاعْدِينْ نِتْبَدْلُوا مِنْ مَجْدْ لْمَجْدْ بَاشْ نْوَلِّيوْ نْشَبْهُوا لِلصُّورَة الِّي نْشُوفُو فِيهَا، وهَاذَا يَعْمْلُو الرَّبْ الِّي هُوَّ الرُّوحْ.<verse eid="2CO 3:18" /></para>
  <chapter eid="2CO 3" />
  <chapter number="4" style="c" sid="2CO 4" />
  <para style="s">مَا نْأَيْسُوشْ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 4:1" />ومَادَامْ اللَّهْ بْرَحْمْتُو عْطَانَا الخِدْمَة هَاذِي، مَا نْأَيْسُوشْ، <verse eid="2CO 4:1" /><verse number="2" style="v" sid="2CO 4:2" />آمَا نَحِّينَا كُلْ حَاجَة تِتْعْمَلْ فِي السِّرْ، وكُلْ حَاجَة تْجِيبْ العَارْ، وأَحْنَا مَا نِسْتَعْمْلُوشْ الخُبْثْ ومَا نْحَرْفُوشْ كْلَامْ اللَّهْ، آمَا نْظَهْرُوا الحَقْ، ووَقْتِلِّي النَّاسْ يْشُوفُونَا، سُلُوكْنَا يِشْهِدْ قُدَّامْ اللَّهْ الِّي أَحْنَا مْحَلْ ثِيقَة. <verse eid="2CO 4:2" /><verse number="3" style="v" sid="2CO 4:3" />وإِذَا كَانْ بْشَارِتْنَا مَحْجُوبَة، رَاهِي مَحْجُوبَة عَنْدْ الِّي مَاشِينْ لِلْهْلَاكْ، <verse eid="2CO 4:3" /><verse number="4" style="v" sid="2CO 4:4" />عْلَى خَاطِرْ رَئِيسْ العَالِمْ هَاذَا عْمَى عْقُولْ الِّي مَاهُمْشْ مُؤْمْنِينْ بَاشْ مَا يْشُوفُوشْ نُورْ البْشَارَة الِّي تْبَيِّنْ مَجْدْ المَسِيحْ، الِّي هُوَّ صُورَة صَادْقَة عْلَى طَبِيعِةْ اللَّهْ. <verse eid="2CO 4:4" /><verse number="5" style="v" sid="2CO 4:5" />وأَحْنَا مَانَاشْ نْبَشْرُوا بِرْوَاحْنَا، آمَا نْبَشْرُوا بِلِّي يَسُوعْ المَسِيحْ هُوَّ الرَّبْ. وأَحْنَا خُدَّامْ لِيكُمْ عْلَى خَاطِرْ يَسُوعْ. <verse eid="2CO 4:5" /><verse number="6" style="v" sid="2CO 4:6" />واللَّهْ الِّي قَالْ: «خَلِّي يِضْوِي نُورْ مِالظْلَامْ» هُوَّ بِيدُو الِّي نَوِّرْ فِي قْلُوبْنَا بَاشْ عْرَفْنَا مَجْدْ اللَّهْ، الظَّاهِرْ فِي وِجْهْ يَسُوعْ المَسِيحْ.<verse eid="2CO 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 4:7" />ومَانَا إِلَّا مَاعُونْ فُخَّارْ هَازْ الكِنْزْ هَاذَا، وهَاذَا يْبَيِّنْ الِّي القُوَّة العْظِيمَة هَاذِي جَايَة مِنْ عَنْدْ اللَّهْ، مُشْ مِنْ عَنْدْنَا. <verse eid="2CO 4:7" /><verse number="8" style="v" sid="2CO 4:8" />تْضِيقْ بِينَا الدِّنْيَا مِالجِّيهَاتْ الكُلْ آمَا مَا نِتْغِلْبُوشْ، نْحِيرُوا آمَا مَا نْأَيْسُوشْ، <verse eid="2CO 4:8" /><verse number="9" style="v" sid="2CO 4:9" />يِضْطَهْدُونَا النَّاسْ آمَا اللَّهْ مَا يْخَلِّينَاشْ، يُضُرْبُونَا آمَا مَا نْمُوتُوشْ. <verse eid="2CO 4:9" /><verse number="10" style="v" sid="2CO 4:10" />وأَحْنَا دِيمَا فِي خْطَرْ إِنَّا نْمُوتُو كِيمَا يَسُوعْ، وهَكَّا بْدَنَّاتْنَا زَادَا تْظَهِّرْ الِّي يَسُوعْ يَحْيَا فِينَا. <verse eid="2CO 4:10" /><verse number="11" style="v" sid="2CO 4:11" />عْلَى خَاطِرْ أَحْنَا الحَيِّينْ، نِتْعَرْضُوا دِيمَا لِلْمُوتْ عْلَى خَاطِرْ يَسُوعْ، بَاشْ حْيَاةْ يَسُوعْ تُظْهُرْ زَادَا فِي بْدَنَّاتْنَا الفَانْيَة. <verse eid="2CO 4:11" /><verse number="12" style="v" sid="2CO 4:12" />وهَكَّا، أَحْنَا فِي خْطَرْ المُوتْ، وإِنْتُومَا فِي نَعِيمْ الحَيَاةْ.<verse eid="2CO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 4:13" />وأَحْنَا عَنْدْنَا نَفْسْ رُوحْ الإِيمَانْ المَكْتُوبْ عْلِيهْ فِي الكْتُبْ المُقَدْسَةْ ولِّي يْقُولْ: «تْكَلَّمْتْ عْلَى خَاطِرْنِي أَمَّنْتْ». أَحْنَا زَادَا نَمْنُوا، هَاذَاكَا عْلَاشْ نِتْكَلْمُوا. <verse eid="2CO 4:13" /><verse number="14" style="v" sid="2CO 4:14" />ونَعْرْفُوا إِنُّو اللَّهْ الِّي قَيِّمْ الرَّبْ يَسُوعْ مِالمُوتْ، بِشْ يْقَيِّمْنَا أَحْنَا زَادَا مْعَ يَسُوعْ، ويْحَضَّرْنَا مْعَاكُمْ قُدَّامُو. <verse eid="2CO 4:14" /><verse number="15" style="v" sid="2CO 4:15" />وهَاذَا الكُلْ عْلَى خَاطِرْكُمْ. هَاذَا صَارْ بَاشْ نِعْمَةْ اللَّهْ تُوصِلْ لْنَاسْ أَكْثِرْ، وعْلَى قَدْ مَا يْكُونْ فَمَّة شُكْرْ أَكْثِرْ، عْلَى قَدْ مَا يِتْمَجِّدْ اللَّهْ أَكْثِرْ.<verse eid="2CO 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 4:16" />هَاذَاكَا عْلَاشْ مَا نْأَيْسُوشْ. رَغْمِلَّي بْدَنَّا قَاعِدْ يِفْنَى، آمَا مِنْ دَاخِلْ قَاعْدِينْ نِتْجَدْدُّوا نْهَارْ بَعْدْ نْهَارْ. <verse eid="2CO 4:16" /><verse number="17" style="v" sid="2CO 4:17" />عْلَى خَاطِرْ الضِّيقْ الِّي نْعَانِيوْ فِيهْ هُوَّ وَقْتِي وبْسِيطْ، آمَا يْحَضْرِلْنَا فِي مَجْدْ عْظِيمْ مَا يِفْنَاشْ. <verse eid="2CO 4:17" /><verse number="18" style="v" sid="2CO 4:18" />هَاذَاكَا عْلَاشْ مَا نْرَكْزُوشْ عَالأُمُورْ الِّي نْشُوفُوهَا، آمَا نْرَكْزُوا عَالْأُمُورْ الِّي مَا نْشُوفُوهَاشْ. عْلَى خَاطِرْ الِّي نْشُوفُوهْ وَقْتِي، آمَا الِّي مَا نْشُوفُوهِشْ يْدُومْ لِلْأَبَدْ.<verse eid="2CO 4:18" /></para>
  <chapter eid="2CO 4" />
  <chapter number="5" style="c" sid="2CO 5" />
  <para style="s">بْدَنَّا الأَرْضِي وبْدَنَّا السْمَاوِي</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 5:1" />وأَحْنَا نَعْرْفُوا الِّي إِذَا كَانْ تِتْهَدْ الخِيمَة الِّي نْعِيشُوا فِيهَا عَالأَرْضْ، ولِّي هِيَّ بْدَنَّا، رَانَا عَنْدْنَا دَارْ حَضَّرْهَالْنَا اللَّهْ فِي السْمَاء، دَارْ مَا تِفْنَاشْ ومُشْ مَصْنُوعَة بِيدِينْ العْبَادْ. <verse eid="2CO 5:1" /><verse number="2" style="v" sid="2CO 5:2" />فِي الحْقِيقَة، وأَحْنَا سَاكْنِينْ فِي الخِيمَة هَاذِي قَاعْدِينْ نِتْوَجْعُوا، عْلَى خَاطِرْنَا مِتْشَوْقِينْ نِلْبْسُوا فُوقْهَا دَارْنَا الِّي فِي السْمَاء. <verse eid="2CO 5:2" /><verse number="3" style="v" sid="2CO 5:3" />عْلَى خَاطِرْ كَانْ نِلْبْسُوهَا، مَا عَادِشْ بِشْ نْكُونُوا عِرْيَانِينْ. <verse eid="2CO 5:3" /><verse number="4" style="v" sid="2CO 5:4" />ومَادَامْنَا فِي الخِيمَة هَاذِي، أَحْنَا مَزِّلْنَا نْئِنُّوا كِيمَا الِّي هَازِزْ حْمِلْ، مُشْ عْلَى خَاطِرْنَا نْحِبُّوا إنَّحِّيوْ بْدَنَّا الأَرْضِي، آمَا نْحِبُّوا نِلْبْسُوا فُوقُو بْدَنَّا السْمَاوِي، بَاشْ الحَيَاةْ تَبْلَعْ كُلْ مَا هُوَّ مِيِّتْ فِينَا، <verse eid="2CO 5:4" /><verse number="5" style="v" sid="2CO 5:5" />واللَّهْ هُوَّ الِّي حَضَّرْنَا لِلْمُسْتَقْبِلْ هَاذَا، وعْطَانَا الرُّوحْ القُدُسْ عَرْبُونْ.<verse eid="2CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 5:6" />هَاذَاكَا عْلَاشْ دِيمَا عَنْدْنَا الثِّيقَة الكَامْلَة فِي هَاذَا، ونَعْرْفُوا الِّي مَادَامْنَا سَاكْنِينْ فِي البْدَنْ هَاذَا، أَحْنَا بْعَادْ عَالرَّبْ. <verse eid="2CO 5:6" /><verse number="7" style="v" sid="2CO 5:7" />وأَحْنَا نْعِيشُوا بِالإِيمَانْ، مُشْ بِلِّي تْشُوفُو العِينِينْ. <verse eid="2CO 5:7" /><verse number="8" style="v" sid="2CO 5:8" />وأَحْنَا وَاثْقِينْ، ونْخَيْرُوا إِنَّا نْسَلْمُوا فِي البْدَنْ هَاذَا، ونُسْكْنُوا مْعَ الرَّبْ. <verse eid="2CO 5:8" /><verse number="9" style="v" sid="2CO 5:9" />وهَدَفْنَا إِنُّو نْرَضِّيوْ اللَّهْ، سِوَى كُنَّا سَاكْنِينْ فِي البْدَنْ هَاذَا وَلَّا مْعَاهْ، <verse eid="2CO 5:9" /><verse number="10" style="v" sid="2CO 5:10" />عْلَى خَاطِرْ لْكُلْنَا بِشْ نَاقْفُوا قُدَّامْ كُرْسِي مَحْكِمْةْ المَسِيحْ بَاشْ كُلْ وَاحِدْ فِينَا يَحْصِدْ نْتِيجِةْ أَعْمَالُو فِي الدِّنْيَا، سِوَى كَانِتْ خِيرْ وَلَّا شَرْ.<verse eid="2CO 5:10" /></para>
  <para style="s">أَحْنَا سُفَرَاءْ المَسِيحْ</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 5:11" />وعْلَى خَاطِرْنَا نَعْرْفُوا آشْ مَعْنَاهَا مْخَافِة الرَّبْ أَحْنَا نْحَاوْلُوا نَقْنْعُوا النَّاسْ. اللَّهْ يَعْرَفْنَا عْلَى حْقِيقِتْنَا، ونِتْمَنَّى إِنْكُمْ إِنْتُومَا زَادَا تَعْرْفُونَا فِي قْلُوبْكُمْ عْلَى حْقِيقِتْنَا. <verse eid="2CO 5:11" /><verse number="12" style="v" sid="2CO 5:12" />وأَحْنَا مَا نْحِبُّوشْ نْعَاوْدُوا نُشْكْرُوا رْوَاحْنَا قُدَّامْكُمْ، آمَا نْحِبُّوا نَعْطِيوْكُمْ سْبَبْ يْخَلِّيكُمْ تِتْفَخْرُوا بِينَا، بَاشْ تْنَجْمُوا تْجَاوْبُوا الِّي يِتْفُوخْرُوا بِالمَظَاهِرْ، مُشْ بِلِّي فِي القَلْبْ. <verse eid="2CO 5:12" /><verse number="13" style="v" sid="2CO 5:13" />كَانْ ظْهُرْنَالْكُمْ كِالمْهَبْلَة رَاهُو عْلَى خَاطِرْ اللَّهْ! وكَانْ أَحْنَا بِعْقُولَاتْنَا رَاهُو عْلَى خَاطِرْكُمْ إِنْتُومَا! <verse eid="2CO 5:13" /><verse number="14" style="v" sid="2CO 5:14" />عْلَى خَاطِرْ مْحَبِّةْ المَسِيحْ مَالْكِتْنَا، ونَعْرْفُوا إِنُّو مَادَامْ وَاحِدْ مَاتْ فِي عُوضْ النَّاسْ الكُلْ، مَالَا النَّاسْ الكُلْ مِتْشَارْكِينْ مْعَاهْ فِي مُوتُو. <verse eid="2CO 5:14" /><verse number="15" style="v" sid="2CO 5:15" />وهُوَّ مَاتْ فِي عُوضْ النَّاسْ الكُلْ، بَاشْ الحَيِّينْ مَا عَادِشْ يْعِيشُوا لِرْوَاحْهُمْ، آمَا يْعِيشُوا لِلِّي مَاتْ وقَامْ عْلَى خَاطِرْهُمْ.<verse eid="2CO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 5:16" />مَالَا مِنْ تَوَّا، مَا عَادِشْ بِشْ نُحْكْمُوا عَالنَّاسْ بْمَقَايِيسْ البَشَرْ. حَتَّى كَانْ عْمَلْنَا هَاذَا مْعَ المَسِيحْ قْبَلْ، أَحْنَا تَوَّا مَا عَادِشْ نُخْزْرُولُو بِالطَّرِيقَة هَاذِي. <verse eid="2CO 5:16" /><verse number="17" style="v" sid="2CO 5:17" />وإِذَا كَانْ وَاحِدْ تَابَعْ لِلْمَسِيحْ رَاهُو مَخْلُوقْ جْدِيدْ، الحَاجَاتْ القْدِيمَة تْنَحَّاتْ، وكُلْ شَيْ وَلَّى جْدِيدْ. <verse eid="2CO 5:17" /><verse number="18" style="v" sid="2CO 5:18" />وهَاذَا الكُلْ عَمْلُو اللَّهْ الِّي صَالَحْنَا مْعَاهْ بِالمَسِيحْ، وعْطَانَا أَحْنَا المُهِمَّة هَاذِي، إِنُّو نْصَالْحُوا النَّاسْ الأُخْرِينْ مْعَاهْ. <verse eid="2CO 5:18" /><verse number="19" style="v" sid="2CO 5:19" />مَعْنَاهَا إِنُّو اللَّهْ تْصَالَحْ مْعَ العَالِمْ عْلَى طْرِيقْ المَسِيحْ، ومَا حْسِبِلْهُمْشْ ذْنُوبْهُمْ، وكَلَّفْنَا أَحْنَا بَاشْ نْخَبْرُوا عَالصُلْحْ هَاذَا.<verse eid="2CO 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 5:20" />مَالَا أَحْنَا سُفَرَاءْ المَسِيحْ، كَايِنُّو اللَّهْ يِتْكَلِّمْ عْلَى طْرِيقْنَا. ونُطْلْبُوا مِنْكُمْ بْإِسْمْ المَسِيحْ: تْصَالْحُوا مْعَ اللَّهْ! <verse eid="2CO 5:20" /><verse number="21" style="v" sid="2CO 5:21" />عْلَى خَاطِرْ المَسِيحْ الِّي عُمْرُو مَا عْمَلْ ذَنْبْ، وَلَّى هُوَّ الذْبِيحَةْ عْلَى ذْنُوبْنَا، بَاشْ نْوَلِّيوْ صَالْحِينْ عَنْدْ اللَّهْ بِيهْ.<verse eid="2CO 5:21" /></para>
  <chapter eid="2CO 5" />
  <chapter number="6" style="c" sid="2CO 6" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 6:1" />مَادَامْنَا نِخْدْمُوا مْعَ اللَّهْ، نْشَجْعُوكُمْ بَاشْ مَا تْكُونُوشْ قْبِلْتُوا نِعْمِةْ اللَّهْ بْلَا فَايْدَة. <verse eid="2CO 6:1" /><verse number="2" style="v" sid="2CO 6:2" />عْلَى خَاطِرْ اللَّهْ يْقُولْ:</para>
  <para style="b" vid="2CO 6:2" />
  <para style="q1" vid="2CO 6:2">«فِي الوَقْتْ المُنَاسِبْ سْمَعْتِكْ،</para>
  <para style="q2" vid="2CO 6:2">وفِي يُومْ النْجَاةْ عَاوِنْتِكْ».</para>
  <para style="b" vid="2CO 6:2" />
  <para style="m" vid="2CO 6:2">وهَاذَا هُوَّ الوَقْتْ المُنَاسِبْ، واليُومْ هُوَّ يُومْ النْجَاةْ، <verse eid="2CO 6:2" /><verse number="3" style="v" sid="2CO 6:3" />وأَحْنَا مَا نَعْمْلُوا حَتَّى شَيْ يْكُونْ عَثْرَة لِلْأُخْرِينْ، بَاشْ مَا تْكُونِشْ فَمَّة مْلَامَة عَالخِدْمَة. <verse eid="2CO 6:3" /><verse number="4" style="v" sid="2CO 6:4" />آمَا فِي الظُّرُوفْ الكُلْ نْوَرِّيوْ الِّي أَحْنَا بِالحَقْ خُدَّامْ اللَّهْ ، بْصَبْرْنَا فِي الضِّيقْ والشِّدَة والعْذَابْ، <verse eid="2CO 6:4" /><verse number="5" style="v" sid="2CO 6:5" />والضَّرْبْ والحَبْسْ والمَشَاكِلْ والتْعَبْ وقِلِّةْ النُّومْ والجُوعْ. <verse eid="2CO 6:5" /><verse number="6" style="v" sid="2CO 6:6" />نْبَيْنُوا هَاذَا زَادَا بِالطُّهْرْ والمَعْرْفَة والصَّبِرْ والسْيَاسَة، وبِالرُّوحْ القُدُسْ والمْحَبَّة الصَّادْقَة، <verse eid="2CO 6:6" /><verse number="7" style="v" sid="2CO 6:7" />بْكِلْمِةْ الحَقْ، وبْقُوِّةْ اللَّهْ، مِتْسَلْحِينْ بِالصَّلَاحْ فِي الهُجُومْ والدِّفَاعْ، <verse eid="2CO 6:7" /><verse number="8" style="v" sid="2CO 6:8" />سِوَى كُنَّا فِي مَجْدْ وَلَّا فِي ذِلْ، سُمْعِتْنَا خَايْبَة وَلَّا بَاهْيَة. النَّاسْ يِعْتَبْرُونَا كَذَّابِينْ وأَحْنَا صَادْقِينْ، <verse eid="2CO 6:8" /><verse number="9" style="v" sid="2CO 6:9" />يِعْتَبْرُونَا مُشْ مَعْرُوفِينْ وأَحْنَا مَعْرُوْفِينْ، مُوتَى وهَانَا حَيِّينْ، مْعَاقْبِينْ ومُشْ مَقْتُولِينْ، <verse eid="2CO 6:9" /><verse number="10" style="v" sid="2CO 6:10" />حْزَانَى وأَحْنَا دِيمَا فَرْحَانِينْ، فْقَارَى وأَحْنَا نِغْنِيوْ بَرْشَة نَاسْ، مَا عَنَّا حَتَّى شَيْ وأَحْنَا نِمْلْكُوا كُلْ شَيْ.<verse eid="2CO 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 6:11" />يَا جْمَاعِةْ كُورِنْثُوسْ، كَلَّمْنَاكُمْ بْصَرَاحَة، وحَلِّينَالْكُمْ قْلُوبْنَا. <verse eid="2CO 6:11" /><verse number="12" style="v" sid="2CO 6:12" />أَحْنَا مَا بْخِلْنَاشْ عْلِيكُمْ بِمْحَبِّتْنَا، آمَا إِنْتُومَا الِّي بَاخْلِينْ عْلِينَا بِمْحَبِّتْكُمْ. <verse eid="2CO 6:12" /><verse number="13" style="v" sid="2CO 6:13" />نْكَلِّمْ فِيكُمْ كَايِنْكُمْ وْلَادِي: عَامْلُونَا كِيفْ مَا نْعَامْلُوكُمْ، وحِلُّوا قْلُوبْكُمْ لِينَا إِنْتُومَا زَادَا.<verse eid="2CO 6:13" /></para>
  <para style="s">أَحْنَا هَيْكِلْ اللَّهْ الحَيْ</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 6:14" />مَا تْكُونُوشْ مَرْبُوطِينْ بْعَهْدْ مْعَ الِّي مُشْ مُؤْمْنِينْ. يَاخِي شْنُوَّة الِّي يُرْبُطْ بِينْ الصَّلَاحْ والشَّرْ؟ وشْنُوَّة الِّي يِجْمَعْ النُّورْ بِالظْلَامْ؟ <verse eid="2CO 6:14" /><verse number="15" style="v" sid="2CO 6:15" />وشْنِيَّة المُفَاهْمَة الِّي تْنَجِّمْ تْكُونْ بِينْ المَسِيحْ وإِبْلِيسْ؟ وشْنِيَّة الشِّرْكَة الِّي تْنَجِّمْ تْكُونْ بِينْ المُؤْمِنْ ولِّي مُشْ مُؤْمِنْ؟ <verse eid="2CO 6:15" /><verse number="16" style="v" sid="2CO 6:16" />وشْنُوَّة الِّي يِجْمَعْ بِينْ هَيْكِلْ اللَّهْ والصْنَبْ؟ أَحْنَا هُومَا هَيْكِلْ اللَّهْ الحَيْ، كِيمَا قَالْ اللَّهْ:</para>
  <para style="b" vid="2CO 6:16" />
  <para style="q1" vid="2CO 6:16">«بِشْ نُسْكُنْ فِي وِسْطْهُمْ،</para>
  <para style="q2" vid="2CO 6:16">ونِمْشِي مْعَاهُمْ،</para>
  <para style="q1" vid="2CO 6:16">وآنَا نْكُونْ إِلَاهْهُمْ،</para>
  <para style="q2" vid="2CO 6:16">وهُومَا يْكُونُوا شَعْبِي».<verse eid="2CO 6:16" /></para>
  <para style="b" />
  <para style="m">
    <verse number="17" style="v" sid="2CO 6:17" />هَاذَاكَا عْلَاشْ الرَّبْ يْقُولْ:</para>
  <para style="b" vid="2CO 6:17" />
  <para style="q1" vid="2CO 6:17">«أُخْرْجُوا مِنْ وِسْطْهُمْ،</para>
  <para style="q2" vid="2CO 6:17">وإِبَعْدُوا عْلِيهُمْ.</para>
  <para style="q1" vid="2CO 6:17">مَا تْمِسُّوشْ المَنْزُوسْ،</para>
  <para style="q2" vid="2CO 6:17">وآنَا نِقْبِلْكُمْ،<verse eid="2CO 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="2CO 6:18" />ونْكُونِلْكُمْ بُو،</para>
  <para style="q2" vid="2CO 6:18">وإِنْتُومَا تْكُونُوا وْلَادِي وبْنَاتِي،</para>
  <para style="q1" vid="2CO 6:18">هَكَّا يْقُولْ الرَّبْ القَادِرْ عْلَى كُلْ شَيْ».<verse eid="2CO 6:18" /></para>
  <para style="b" />
  <chapter eid="2CO 6" />
  <chapter number="7" style="c" sid="2CO 7" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 7:1" />يَا حْبَابِي، مَادَامْ الوُعُودْ هَاذِي الكُلْ لِينَا، مَالَا خَلِّينَا نَطَهْرُوا رْوَاحْنَا مِنْ كُلْ مَا يْنَجِّسْ البْدَنْ والرُّوحْ، ونَسْعَاوْ بَاشْ نْعِيشُوا فِي قَدَاسَة كَامْلَة ونْخَافُوا اللَّهْ.<verse eid="2CO 7:1" /></para>
  <para style="s">بُولِسْ فَرْحَانْ بْتُوبِتْهُمْ</para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 7:2" />أَعْطِيوْنَا بْلَاصَة فِي قْلُوبْكُمْ، عْلَى خَاطِرْ أَحْنَا مَا ظْلَمْنَا حَتَّى حَدْ، ومَا ضَرِّينَا حَتَّى حَدْ، ومَا اسْتْغَلِّينَا حَتَّى حَدْ. <verse eid="2CO 7:2" /><verse number="3" style="v" sid="2CO 7:3" />ومَانِيشْ نْقُولْ فِي هَاذَا بَاشْ نُحْكُمْ عْلِيكُمْ، عْلَى خَاطِرْنِي قُلْتِلْكُمْ مِنْ قْبَلْ الِّي إِنْتُومَا فِي قْلُوبْنَا وأَحْنَا بِشْ نْكُونُوا مْعَاكُمْ فِي الحَيَاةْ وَلَّا فِي المُوتْ. <verse eid="2CO 7:3" /><verse number="4" style="v" sid="2CO 7:4" />آنَا عَنْدِي ثِيقَة كْبِيرَة فِيكُمْ وفَخُورْ بِيكُمْ بَرْشَة. ورَغْمْ المَشَاكِلْ الكُلْ، مِتْشَجَّعْ، وقَلْبِي فَايِضْ بِالفَرْحَة.<verse eid="2CO 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 7:5" />وحَتَّى كِي وْصِلْنَا لْمَنْطَقْةْ مَقْدُونِيَّة بْدَنَّا مَا ذَاقِشْ الرَّاحَة، كَانِتْ المَشَاكِلْ جَايِتْنَا مِنْ كُلْ شِيرَة: العَرْكْ دَايِرْ بِينَا مِنْ بَرَّا، والخُوفْ زَادْ فِينَا مِنْ دَاخِلْ. <verse eid="2CO 7:5" /><verse number="6" style="v" sid="2CO 7:6" />آمَا اللَّهْ الِّي يْشَجَّعْ المُحْبْطِينْ، شَجَّعْنَا بْجَيَّانْ تِيطُسْ، <verse eid="2CO 7:6" /><verse number="7" style="v" sid="2CO 7:7" />مُشْ بْجَيَّانُو بَرْكْ، آمَا بِالتَّشْجِيعْ الِّي شَجَّعْتُوهْ بِيهْ. وفَرْحْتِي زَادِتْ أَكْثِرْ وَقْتِلِّي حْكَالْنَا الِّي إِنْتُومَا تْوَحَّشْتُونِي، وعْلَى حُزْنْكُمْ وغِيرِتْكُمْ عْلِيَّا.<verse eid="2CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 7:8" />وإِذَا كَانْ حَزَّنْتْكُمْ بْرِسَالْتِي، رَانِي مَانِيشْ نَادِمْ. وحَتَّى كَانْ نْدِمْتْ، وَقْتِلِّي شُفْتْ الِّي هِيَّ خَلَّاتْكُمْ تِحْزْنُوا حَتَّى ولَوْ شْوَيَّة، <verse eid="2CO 7:8" /><verse number="9" style="v" sid="2CO 7:9" />آنَا تَوَّا فَرْحَانْ، مُشْ عْلَى خَاطِرْكُمْ حْزِنْتُوا، آمَا عْلَى خَاطِرْ حُزْنْكُمْ خَلَّاكُمْ اتُّوبُوا. وهُوَّ حُزْنْ كِيفْ مَا يْحِبْ اللَّهْ، وهَكَّا نْكُونُوا مَا ضَرِّينَاكُمْ فِي حَتَّى شَيْ. <verse eid="2CO 7:9" /><verse number="10" style="v" sid="2CO 7:10" />عْلَى خَاطِرْ الحُزْنْ الِّي كِيمَا يْحِبُّو اللَّهْ، يْهِزْ لِلتَّوْبَة الِّي تْنَجِّي، ولِّي مَا فِيهَاشْ نْدَمْ. آمَا الحُزْنْ الِّي حَسْبْ العَالِمْ ومَا يْبَدَّلْشْ القَلْبْ، يْهِزْ لِلْمُوتْ. <verse eid="2CO 7:10" /><verse number="11" style="v" sid="2CO 7:11" />شُوفُوا آشْ عْمَلْ فِيكُمْ الحُزْنْ الِّي كِيمَا يْحِبُّو اللَّهْ: خَلَّاكُمْ تَاخْذُوا المَوْضُوعْ بْجِدِّيَّة، وزِيدْ طْلَبْتُوا السْمَاحْ عَلِّي صَارْ، وتْغَشَّشْتُوا وتْقَلَّقْتُوا، وبَيَّنْتُوا الِّي إِنْتُومَا تْحِبُّونِي وتْوَحَّشْتُونِي، وعَاقِبْتُوا المُذْنِبْ، وظَهَّرْتُوا الِّي إِنْتُومَا أَبْرِيَاءْ فِلِّي صَارْ الكُلْ. <verse eid="2CO 7:11" /><verse number="12" style="v" sid="2CO 7:12" />مَالَا، الرِّسَالَة الِّي كْتِبْتْهَالْكُمْ مَا كَانِتِشْ عْلَى خَاطِرْ الظَّالِمْ ولَا عْلَى خَاطِرْ المَظْلُومْ، آمَا بَاشْ يْبَانِلْكُمْ قُدَّامْ اللَّهْ قَدَّاشْ إِنْتُومَا لَاهِينْ بِينَا، <verse eid="2CO 7:12" /><verse number="13" style="v" sid="2CO 7:13" />وهَاذَا الِّي خَلَّانَا نِتْشَجْعُوا.</para>
  <para style="p" vid="2CO 7:13">وفُوقْ التَّشْجِيعْ هَاذَا، زِدْنَا فْرَحْنَا أَكْثِرْ عْلَى خَاطِرْ تِيطُسْ كَانْ فَرْحَانْ بَعْدْمَا رَتَّحْتُولُو بَالُو. <verse eid="2CO 7:13" /><verse number="14" style="v" sid="2CO 7:14" />ومَا حَشِّمْتُونِيشْ إِنِّي تْفَخِّرْتْ بِيكُمْ قُدَّامْ تِيتُوسْ. وكِيفْ مَا كُنَّا صَادْقِينْ فِلِّي قُلْنَاهُولْكُمْ الكُلْ، كُنَّا زَادَا صَادْقِينْ وَقْتِلِّي تْفَخِّرْنَا بِيكُمْ قُدَّامُو. <verse eid="2CO 7:14" /><verse number="15" style="v" sid="2CO 7:15" />ورَاهِي مْحَبْتُو لِيكُمْ قَاعْدَة تْزِيدْ، كُلْ مَا يِتْفَكِّرْ كِيفَاشْ الكُلْكُمْ سْمَعْتُوا كْلَامُو، وكِيفَاشْ إِسْتَقْبِلْتُوهْ بْخُوفْ وإِحْتِرَامْ. <verse eid="2CO 7:15" /><verse number="16" style="v" sid="2CO 7:16" />وآنَا فَرْحَانْ الِّي انَّجِّمْ نَاثِقْ فِيكُمْ فِي كُلْ شَيْ.<verse eid="2CO 7:16" /></para>
  <chapter eid="2CO 7" />
  <chapter number="8" style="c" sid="2CO 8" />
  <para style="s">أَعْطِيوْ بْكَرَمْ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 8:1" />ونْحِبُّوا نَحْكِيوْلْكُمْ يَا خْوَاتْنَا عَالنِّعْمَة الِّي عْطَاهَا اللَّهْ لِكْنَايِسْ مَقْدُونِيَّة. <verse eid="2CO 8:1" /><verse number="2" style="v" sid="2CO 8:2" />رَغْمِلِّي كَانُوا فِي مِحْنَة صْعِيبَة، فَرْحِتْهُمْ الكْبِيرَة وفَقْرْهُمْ خَلَّاوْهُمْ يَعْطِيوْ بْكَرَمْ كْبِيرْ. <verse eid="2CO 8:2" /><verse number="3" style="v" sid="2CO 8:3" />وآنَا نِشْهِدْ الِّي هُومَا تْبَرْعُوا عْلَى قَدْ طَاقِتْهُمْ، وأَكْثِرْ حَتَّى مِنْ طَاقِتْهُمْ، مِنْ غِيرْ مَا حَدْ يْلِزْهُمْ، <verse eid="2CO 8:3" /><verse number="4" style="v" sid="2CO 8:4" />وزَادُوا شَدُّوا فِينَا صْحِيحْ بَاشْ نْخَلِّيوْهُمْ يْعَاوْنُوا القِدِّيسِينْ مْعَانَا. <verse eid="2CO 8:4" /><verse number="5" style="v" sid="2CO 8:5" />وعَمْلُوا أَكْثِرْ مِلِّي كُنَّا نِتْوَقْعُوا مِنْهُمْ، عْلَى خَاطِرْهُمْ خَصْصُوا رْوَاحْهُمْ لِلرَّبْ فِي الأُوِّلْ، ومْبَعِّدْ لِينَا أَحْنَا كِيفْ مَا حَبْ اللَّهْ. <verse eid="2CO 8:5" /><verse number="6" style="v" sid="2CO 8:6" />هَاذَاكَا عْلَاشْ طْلَبْنَا مِنْ تِيطُسْ بَاشْ يْكَمِّلْ الخِدْمَة المُبَارْكَة الِّي بْدَاهَا مْعَاكُمْ. <verse eid="2CO 8:6" /><verse number="7" style="v" sid="2CO 8:7" />ومَادَامْكُمْ غْنِيِّينْ فِي كُلْ شَيْ: فِي الإِيمَانْ، والكْلَامْ، والمَعْرْفَة، وفِي مْحَبِّتْكُمْ لِينَا، ومُجْتَهْدِينْ فِي كُلْ شَيْ، يَا رِيتْكُمْ تْكُونُوا غْنِيِّينْ زَادَا وَقْتِلِّي تَعْطِيوْ.<verse eid="2CO 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 8:8" />ومَانِيشْ قَاعِدْ نُأْمِرْ فِيكُمْ، آمَا نَحْكِيلْكُمْ قَدَّاشْ الأُخْرِينْ مُجْتَهْدِينْ وَقْتِلِّي يَعْطِيوْ، بَاشْ نْشُوفْ صِدْقْ مْحَبِّتْكُمْ. <verse eid="2CO 8:8" /><verse number="9" style="v" sid="2CO 8:9" />وإِنْتُومَا تَعْرْفُوا نِعْمِةْ رَبْنَا يَسُوعْ المَسِيحْ: كِيفَاشْ هُوَّ الغْنِيْ وَلَّى فْقِيرْ عْلَى خَاطِرْكُمْ، بَاشْ إِنْتُومَا تِسْتَغْنَاوْ بْفَقْرُو.<verse eid="2CO 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 8:10" />وهَاذَا رَايِي فِي المَوْضُوعْ، ورَاهُو لْمَصْلْحِتْكُمْ، إِنْتُومَا كُنْتُوا أَوِّلْ نَاسْ حَبُّوا يْعَاوْنُوا العَامْ الِّي فَاتْ، وأَوِّلْ نَاسْ بْدِيتُوا تْعَاوْنُوا بِالحَقْ. <verse eid="2CO 8:10" /><verse number="11" style="v" sid="2CO 8:11" />وتَوَّا كَمْلُوا الِّي بْدِيتُوا فِيهْ، حَسْبْ الِّي تَقْدْرُوا عْلِيهْ، بَاشْ حَمَاسْكُمْ وإِنْتُومَا تَعْطِيوْ يْكُونْ كِيمَا كَانْ وَقْتِلِّي قَرَّرْتُوا تَعْطِيوْ، <verse eid="2CO 8:11" /><verse number="12" style="v" sid="2CO 8:12" />عْلَى خَاطِرْ وَقْتِلِّي يْكُونْ الحَمَاسْ مَوْجُودْ، اللَّهْ يِقْبِلْ الِّي نَقْدْرُوا عْلِيهْ، ومَا يُطْلُبْشْ أَكْثِرْ مِلِّي عَنْدْنَا. <verse eid="2CO 8:12" /><verse number="13" style="v" sid="2CO 8:13" />مَا نُقْصُدْشْ الِّي إِنْتُومَا تْوَلِّيوْ فِي ضِيقْ وغِيرْكُمْ يْوَلِّيوْ فِي رَاحَة، آمَا نُقْصُدْ إِنْكُمْ تْكُونُوا مِتْسَاوِينْ، <verse eid="2CO 8:13" /><verse number="14" style="v" sid="2CO 8:14" />اليُومْ إِنْتُومَا عَنْدْكُمْ وتْنَجْمُوا تْعَاوْنُوهُمْ فِي ضِيقِتْهُمْ، نْهَارْ آخِرْ يْكُونُوا هُومَا عَنْدْهُمْ ويْنَجْمُوا يْعَاوْنُوكُمْ فِي ضِيقِتْكُمْ. وهَكَّا تْكُونُوا مِتْسَاوِينْ. <verse eid="2CO 8:14" /><verse number="15" style="v" sid="2CO 8:15" />كِيمَا تْقُولْ الكْتُبْ المُقَدْسَة: «الِّي لَمْ بَرْشَة مَا فْضُلْ عَنْدُو حَتَّى شَيْ، ولِّي لَمْ شْوَيَّة مَا نُقْصُو حَتَّى شَيْ».<verse eid="2CO 8:15" /></para>
  <para style="s">خِدْمِةْ تِيطُسْ فِي كُورِنْثُوسْ</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 8:16" />نُشْكُرْ اللَّهْ الِّي خَلَّى تِيطُسْ مِتْحَمِّسْ إِنُّو يْعَاوِنْكُمْ كِيفِي آنَا، <verse eid="2CO 8:16" /><verse number="17" style="v" sid="2CO 8:17" />ووَقْتِلِّي طْلَبْنَا مِنُّو بَاشْ يْجِيكُمْ فْرَحْ بَرْشَة عْلَى خَاطِرْ مِنْ قْبَلْ كَانْ مِتْحَمِّسْ يْحِبْ يْجِيكُمْ. <verse eid="2CO 8:17" /><verse number="18" style="v" sid="2CO 8:18" />وبْعَثْنَا مْعَاهْ خُونَا الِّي الكْنَايِسْ الكُلْ تُشْكِرْ فِيهْ عْلَى خِدْمْتُو فِي التَّبْشِيرْ. <verse eid="2CO 8:18" /><verse number="19" style="v" sid="2CO 8:19" />وزِيدْ عْلَى هَاذَا، الكَنَايِسْ اخْتَارِتُّو بَاشْ يْسَافِرْ مْعَانَا ويْعَاوِنَّا فِي الخِدْمَة المُبَارْكَة هَاذِي الِّي قَاعْدِينْ نَعْمْلُوا فِيهَا بَاشْ يِتْمَجِّدْ اللَّهْ وبَاشْ نْوَرِّيوْ الِّي أَحْنَا نْحِبُّوا نْعَاوْنُوا. <verse eid="2CO 8:19" /><verse number="20" style="v" sid="2CO 8:20" />وأَحْنَا رَادِّينْ بَالْنَا بَاشْ حَتَّى حَدْ مَا يْلُومْنَا عْلَى كِيفَاشْ قَاعْدِينْ نِتْصَرْفُوا فِي الهِيبَة الكْبِيرَة هَاذِي، <verse eid="2CO 8:20" /><verse number="21" style="v" sid="2CO 8:21" />عْلَى خَاطِرْنَا نْحِبُّوا نَعْمْلُوا الحَاجَاتْ البَاهْيَة، مُشْ قُدَّامْ الرَّبْ أَكَهَوْ، آمَا قُدَّامْ النَّاسْ زَادَا.<verse eid="2CO 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CO 8:22" />وزَادَا بْعَثْنَا مْعَاهُمْ خُونَا الِّي جَرِّبْنَاهْ بَرْشَة مَرَّاتْ وشُفْنَا الِّي هُوَّ مِتْحَمِّسْ فِي كُلْ شَيْ، وهُوَّ تَوَّا مِتْحَمِّسْ أَكْثِرْ عْلَى خَاطْرُو يَاثَقْ فِيكُمْ بَرْشَة. <verse eid="2CO 8:22" /><verse number="23" style="v" sid="2CO 8:23" />كَانْكُمْ عْلَى تِيطُسْ، رَاهُو شْرِيكِي ويْعَاوِنْ فِيَّا عْلَى خِدْمِتْكُمْ، وبِالنِّسْبَة لِخْوَاتْنَا الزُّوزْ الِّي مْعَاهْ، رَاهُمْ يْمَثْلُوا الكَنَايِسْ والمَسِيحْ يِتْمَجِّدْ بْخِدْمِتْهُمْ. <verse eid="2CO 8:23" /><verse number="24" style="v" sid="2CO 8:24" />مَالَا وَرِّيوْهُمْ مْحَبِّتْكُمْ لِيهُمْ، بَاشْ الكْنَايِسْ يْشُوفُوا الِّي عَنْدْنَا الحَقْ كِي نِتْفَخِّرُوا بِيكُمْ.<verse eid="2CO 8:24" /></para>
  <chapter eid="2CO 8" />
  <chapter number="9" style="c" sid="2CO 9" />
  <para style="s">اللَّهْ يْحِبْ الِّي يَعْطِي وهُوَّ فَرْحَانْ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 9:1" />فِي الحْقِيقَة مَا نْرَاشْ الِّي لَازِمْ نِكْتْبِلْكُمْ عْلَى مْعَاوْنِتْكُمْ لِلْقِدِّيسِينْ، <verse eid="2CO 9:1" /><verse number="2" style="v" sid="2CO 9:2" />عْلَى خَاطِرْنِي نَعْرِفْ الِّي إِنْتُومَا دِيمَا مُسْتْعَدِّينْ بَاشْ تْعَاوْنُوا، ونِتْفَخِّرْ بِيكُمْ قُدَّامْ المَقْدُونِيِّينْ ونْقُولْ الِّي خْوَاتْنَا فِي أَخَائِيَة حَاضْرِينْ بَاشْ يِتْبَرْعُوا مِالعَامْ الِّي فَاتْ. وحَمَاسْكُمْ هَاذَا شَجَّعْ بَرْشَة نَاسْ. <verse eid="2CO 9:2" /><verse number="3" style="v" sid="2CO 9:3" />آمَا بْعَثْتِلْكُمْ خْوَاتْنَا هَاذُومَا بَاشْ مَا نْكُونُوشْ تْفَخِّرْنَا بِيكُمْ فِي المَوْضُوعْ هَاذَا بِالفَارَغْ، وبَاشْ تْكُونُوا حَاضْرِينْ كِيمَا قُلْتْ. <verse eid="2CO 9:3" /><verse number="4" style="v" sid="2CO 9:4" />وآنَا نْخَافْ لَا يْجِيوْ مْعَايَا جْمَاعَة مِالمَقْدُونِيِّينْ ويَلْقَاوْكُمْ مُشْ حَاضْرِينْ، وَقْتْهَا نُقْعْدُوا أَحْنَا فِي الحِشْمَة — بَاشْ مَا نْقُولِشْ إِنْتُومَا — عْلَى خَاطِرْنَا وْثِقْنَا فِيكُمْ. <verse eid="2CO 9:4" /><verse number="5" style="v" sid="2CO 9:5" />هَاذَاكَا عْلَاشْ شُفْتْ إِنُّو لَازِمْ نُطْلُبْ مِالإِخْوَة يُوصْلُولْكُمْ قْبَلْنَا، بَاشْ يْحَضْرُوا الهِيبَة الِّي وْعِدْتُونَا بِيهَا. وهَكَّا، وَقْتِلِّي نْجِي نَلْقَاهَا حَاضْرَة، بِإِعْتِبَارْهَا هْدِيَّة مِنْكُمْ تَعْطِيوْهَا وإِنْتُومَا فَرْحَانِينْ مُشْ مَلْزُوزِينْ. <verse eid="2CO 9:5" /><verse number="6" style="v" sid="2CO 9:6" />واتْذَكْرُوا إِنُّو الِّي يَزْرَعْ شْوَيَّة يَحْصِدْ شْوَيَّة، ولِّي يَزْرَعْ بَرْشَة يَحْصِدْ بَرْشَة. <verse eid="2CO 9:6" /><verse number="7" style="v" sid="2CO 9:7" />خَلِّي كُلْ وَاحِدْ يِتْبَرَّعْ بِلِّي نْوَاهْ فِي قَلْبُو، مِنْ غِيرْ مَا يْكُونْ نَادِمْ وَلَّا مَلْزُوزْ، عْلَى خَاطِرْ اللَّهْ يْحِبْ الِّي يَعْطِي وهُوَّ فَرْحَانْ. <verse eid="2CO 9:7" /><verse number="8" style="v" sid="2CO 9:8" />واللَّهْ قَادِرْ يْفِيضْ عْلِيكُمْ بْكُلْ خِيرْ، وهَكَّا يْكُونْ عَنْدْكُمْ مِنْ كُلْ شَيْ وفِي كُلْ وَقْتْ مَا يِكْفِيكُمْ ويْزِيدْ، بَاشْ تَعْمْلُوا الخِيرْ أَكْثِرْ، <verse eid="2CO 9:8" /><verse number="9" style="v" sid="2CO 9:9" />كِيمَا تْقُولْ الكْتُبْ المُقَدْسَة:</para>
  <para style="b" vid="2CO 9:9" />
  <para style="q1" vid="2CO 9:9">«فَرَّقْ بْلَاشْ حْسَابْ،</para>
  <para style="q2" vid="2CO 9:9">عْطَى لِلْفْقَارَى،</para>
  <para style="q1" vid="2CO 9:9">صَلَاحُو يَبْقَى لِلْأَبَدْ».<verse eid="2CO 9:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="2CO 9:10" />واللَّهْ الِّي يَعْطِي الزِّرِّيعَة لِلِّي يَزْرَعْ، والخُبْزْ لِلْمَاكْلَة، هُوَّ بِشْ يَعْطِيكُمْ زِرِّيعَتْكُمْ ويْكَثَّرْهَا، ويْخَلِّي صَلَاحْكُمْ يْجِيبْ صَابَة، <verse eid="2CO 9:10" /><verse number="11" style="v" sid="2CO 9:11" />ويِغْنِيكُمْ فِي كُلْ شَيْ، بَاشْ تْكُونُوا كُرَمَاء بْلَاشْ حْسَابْ، وهَاذَا يْخَلِّي النَّاسْ يُشْكْرُوا اللَّهْ عَلِّي بْعَثْتُوهُولْهُمْ مْعَانَا. <verse eid="2CO 9:11" /><verse number="12" style="v" sid="2CO 9:12" />عْلَى خَاطِرْ الخِدْمَة الِّي تِخْدْمُوا فِيهَا، مُشْ بِشْ تْوَفِّرْ الِّي يِحْتَاجُوهْ الإِخْوَة القِدِّيسِينْ أَكَهَوْ، آمَا بِشْ تْخَلِّي شُكْرْهُمْ لِلَّهْ يْزِيدْ يْفِيضْ. <verse eid="2CO 9:12" /><verse number="13" style="v" sid="2CO 9:13" />رَاكُمْ بِالخِدْمَة هَاذِي وَرِّيتُوا إِيمَانْكُمْ، وخَلِّيتُوهُمْ يْمَجْدُوا اللَّهْ عْلَى طَاعِتْكُمْ لِيهْ وإِيمَانْكُمْ بِبْشَارِةْ المَسِيحْ، وعْلَى الكَرَمْ مْتَاعْكُمْ مْعَاهُمْ ومْعَ الأُخْرِينْ الكُلْ. <verse eid="2CO 9:13" /><verse number="14" style="v" sid="2CO 9:14" />ورَاهُمْ يِدْعِيوْلْكُمْ وعَنْدْهُمْ مَحَبَّة كْبِيرَة لِيكُمْ، بِسْبَبْ النِّعْمِة العْظِيمَة الِّي عْطَاهَالْكُمْ اللَّهْ. <verse eid="2CO 9:14" /><verse number="15" style="v" sid="2CO 9:15" />لِلَّهْ الحَمْدْ عْلَى هْدِيْتُو الِّي مَا تِتُوصِفْشْ!<verse eid="2CO 9:15" /></para>
  <chapter eid="2CO 9" />
  <chapter number="10" style="c" sid="2CO 10" />
  <para style="s">بُولِسْ يْدَافَعْ عْلَى خِدْمْتُو</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 10:1" />آنَا بُولِسْ الِّي يْقُولُوا عْلِيَّا مِتْوَاضَعْ وَقْتِلِّي نْكُونْ مْعَاكُمْ، وجَرِيءْ وَقْتِلِّي نْكُونْ بْعِيدْ عْلِيكُمْ، نُطْلُبْ مِنْكُمْ بْطِيبِةْ المَسِيحْ ولُطْفُو، <verse eid="2CO 10:1" /><verse number="2" style="v" sid="2CO 10:2" />مَا تْلِزُّونِيشْ نْكُونْ صْعِيبْ وَقْتِلِّي نَبْدَى بَحْذَاكُمْ. وآنَا نْشُوفْ الِّي بِشْ نِتْلَزْ نْكُونْ صْعِيبْ مْعَ الِّي يْخَمِمُّوا إِنُّو أَحْنَا نِتْصَرْفُوا كِيمَا يِتْصَرْفُوا نَاسْ الدِّنْيَا هَاذِي. <verse eid="2CO 10:2" /><verse number="3" style="v" sid="2CO 10:3" />صْحِيحْ أَحْنَا نْعِيشُوا فِي الدِّنْيَا هَاذِي، آمَا رَانَا مَا نْحَارْبُوشْ كِيمَا يْحَارْبُوا نَاسْهَا. <verse eid="2CO 10:3" /><verse number="4" style="v" sid="2CO 10:4" />عْلَى خَاطِرْ السْلَاحَاتْ الِّي نْحَارْبُوا بِيهُمْ مُشْ كِيفْ الِّي يْحَارْبُوا بِيهُمْ النَّاسْ. آمَا سْلَاحَاتْنَا عَنْدْهَا قُدْرَة مِنْ عَنْدْ اللَّهْ بَاشْ تْهِدْ الأَسْوَارْ: نْهِدُّوا بِيهَا الأَفْكَارْ الغَالْطَةْ، <verse eid="2CO 10:4" /><verse number="5" style="v" sid="2CO 10:5" />وكُلْ تَكَبُّرْ يَاقِفْ ضِدْ مَعْرِفْةْ اللَّهْ، ونْحِبُّوا نْخَلِّيوْ النَّاسْ يْبَدْلُوا أَفْكَارْهُمْ بَاشْ يْطِيعُوا المَسِيحْ. <verse eid="2CO 10:5" /><verse number="6" style="v" sid="2CO 10:6" />وأَحْنَا مُسْتْعَدِّينْ بَاشْ نْعَاقْبُو كُلْ العَاصِينْ الِّي بِينَاتْكُمْ، وَقْتِلِّي طَاعِتْكُمْ تْوَلِّي كَامْلَة.<verse eid="2CO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 10:7" />شُوفُوا الأُمُورْ عْلَى حْقِيقِتْهَا: إِذَا كَانْ حَدْ مِتْأَكِّدْ الِّي هُوَّ تَابَعْ لِلْمَسِيحْ، مَالَا خَلِّي يِتْذَكِّرْ الِّي أَحْنَا زَادَا تَابْعِينْ لِلْمَسِيحْ كِيفُو. <verse eid="2CO 10:7" /><verse number="8" style="v" sid="2CO 10:8" />وحَتَّى كَانْ تْفَخِّرْتْ أَكْثِرْ مِاللَّازِمْ بِالسُّلْطَة الِّي عَنْدْنَا، مَانِيشْ حَاشِمْ، عْلَى خَاطِرْ الرَّبْ عْطَاهَالْنَا بَاشْ نْكَبْرُوكُمْ فِي الإِيمَانْ، مُشْ بَاشْ نْطَيْحُوكُمْ. <verse eid="2CO 10:8" /><verse number="9" style="v" sid="2CO 10:9" />مَا نْحِبِّشْ نُظْهُرْ كَايِنِّي نْخَوِّفْ فِيكُمْ بِرْسَايْلِي. <verse eid="2CO 10:9" /><verse number="10" style="v" sid="2CO 10:10" />فَمَّة شْكُونْ فِيكُمْ يْقُولْ: «رَسَايِلْ بُولِسْ كَاسْحَة وصْعِيبَة، آمَا وَقْتِلِّي يْكُونْ مَوْجُودْ، يِبْدَا ضْعِيفْ وكْلَامُو تَافِهْ». <verse eid="2CO 10:10" /><verse number="11" style="v" sid="2CO 10:11" />الشَّخْصْ هَاذَا لَازِمْ يَعْرِفْ إِنُّو الِّي نِكْتْبُوهْ فِي رْسَايِلْنَا وأَحْنَا غَايْبِينْ، هُوَّ بِيدُو الِّي بِشْ نَعْمْلُوهْ وَقْتِلِّي نْجِيوْكُمْ.<verse eid="2CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 10:12" />أَحْنَا مَا نِتْجَرْؤُوشْ نْسَاوِيوْ رْوَاحْنَا مْعَ الِّي يُشْكْرُوا فِي رْوَاحْهُمْ، ولَا حَتَّى نْقَارْنُوا رْوَاحْنَا بِيهُمْ. قَدَّاشْهُمْ مَا يِفْهْمُوشْ! عَامْلِينْ رْوَاحْهُمْ مِقْيَاسْ، ويْقَارْنُوا فِي رْوَاحْهُمْ بِرْوَاحْهُمْ. <verse eid="2CO 10:12" /><verse number="13" style="v" sid="2CO 10:13" />آمَا أَحْنَا، رَانَا مَا نِتْفَخْرُوشْ بْحَاجَاتْ مَا عْمَلْنَاهُمِشْ، آمَا نِتْفَخْرُوا فِي حْدُودْ المَجَالْ الِّي عْطَاهُولْنَا اللَّهْ، ولِّي خَلَّانَا نُوصْلُولْكُمْ إِنْتُومَا زَادَا. <verse eid="2CO 10:13" /><verse number="14" style="v" sid="2CO 10:14" />ومَا تْعَدِّينَاشْ حُدُودْنَا، تْقُولْشْ عْلِينَا مَا بَشَّرْنَاكُمِشْ. آمَا أَحْنَا بِالحَقْ وْصِلْنَالْكُمْ، وجِبْنَالْكُمْ بْشَارِةْ المَسِيحْ. <verse eid="2CO 10:14" /><verse number="15" style="v" sid="2CO 10:15" />ومَا نِتْجَاوْزُوشْ حْدُودْنَا ونِتْفَخْرُوا بْخِدْمِةْ غِيرْنَا. آمَا عَنْدْنَا رْجَى وَقْتِلِّي إِيمَانْكُمْ يِكْبِرْ، إِنُّو خِدْمِتْنَا فِي وِسْطْكُمْ حْدُودْهَا تِتْوَسَّعْ، <verse eid="2CO 10:15" /><verse number="16" style="v" sid="2CO 10:16" />حَتَّى نْوَصْلُوا البْشَارَة لْأَبْعِدْ مِنْ بْلَادْكُمْ، ومَا نِتْفَخْرُوشْ بِلِّي عَمْلُو غِيرْنَا. <verse eid="2CO 10:16" /><verse number="17" style="v" sid="2CO 10:17" />وكِيمَا تْقُولْ الكْتُبْ المُقَدْسَة: «الِّي يْحِبْ يِتْفَخِّرْ خَلِّيهْ يِتْفَخِّرْ بِالرَّبْ». <verse eid="2CO 10:17" /><verse number="18" style="v" sid="2CO 10:18" />ومُشْ الِّي يِمْدَحْ رُوحُو هُوَّ الِّي يْكُونْ مَقْبُولْ، آمَا الِّي يِمْدْحُو الرَّبْ.<verse eid="2CO 10:18" /></para>
  <chapter eid="2CO 10" />
  <chapter number="11" style="c" sid="2CO 11" />
  <para style="s">بُولِسْ والرُّسُلْ الكَذَّابِينْ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 11:1" />مِيسَالِشْ! إِسْتَحْمْلُوا شْوَيَّة هْبَالْ مِنِّي، ونَعْرِفْ الِّي إِنْتُومَا مِتْحَمْلِينِّي. <verse eid="2CO 11:1" /><verse number="2" style="v" sid="2CO 11:2" />عْلَى خَاطِرْنِي نْغِيرْ عْلِيكُمْ غِيرَة مِنْ عَنْدْ اللَّهْ. ورَانِي خْطَبْتْكُمْ لَعْرِيسْ وَاحِدْ الِّي هُوَّ المَسِيحْ، بَاشْ نْقَدِّمْكُمْ لِيهْ كِيفْ الصْبِيَّة العْفِيفَة. <verse eid="2CO 11:2" /><verse number="3" style="v" sid="2CO 11:3" />آمَا نْخَافْ لَا عْقُولَاتْكُمْ تِفْسِدْ وتِبْعْدُوا عَالإِخْلَاصْ الصَّادِقْ لْيَسُوعْ المَسِيحْ، كِيمَا حَوَّاء تْغَرِّتْ بْخُبْثْ اللَّفْعَى. <verse eid="2CO 11:3" /><verse number="4" style="v" sid="2CO 11:4" />وظَاهِرْ الِّي إِنْتُومَا مُسْتْعَدِّينْ تِقْبْلُوا أَيْ وَاحِدْ يْبَشِّرْ بْيَسُوعْ آخَرْ غِيرْ الِّي بَشِّرْنَاكُمْ بِيهْ، وَلَّا تَاخْذُوا رُوحْ غِيرْ الِّي خْذِيتُوهْ، وَلَّا تِقْبْلُوا بْشَارَة غِيرْ الِّي قْبِلْتُوهَا. <verse eid="2CO 11:4" /><verse number="5" style="v" sid="2CO 11:5" />ومَا نِتْصَوِّرْشْ رُوحِي أَقَلْ قِيمَة «مِالرُّسُلْ الكْبَارْ» هَاذُومَا! <verse eid="2CO 11:5" /><verse number="6" style="v" sid="2CO 11:6" />وحَتَّى كَانْ مَانِيشْ مِتْكَلْمَانِي، آمَا رَانِي مَانِيشْ نَاقِصْ مَعْرْفَة. وأَحْنَا وَرِّينَاكُمْ هَاذَا فِي الأُمُورْ الكُلْ وبِالطُّرُقْ الكُلْ.<verse eid="2CO 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 11:7" />يَاخِي عْمَلْتْ ذَنْبْ كِي وَصِّلْتِلْكُمْ البْشَارَة بْلَاشْ، وطَيَّحْتْ مِنْ رُوحِي بَاشْ يِعْلَى مْقَامْكُمْ؟ <verse eid="2CO 11:7" /><verse number="8" style="v" sid="2CO 11:8" />حْرِمْتْ كْنَايِسْ أُخْرِينْ خَاطِرْ وَلَّاوْ يُصْرْفُوا عْلِيَّا بَاشْ نِخْدِمْكُمْ إِنْتُومَا. <verse eid="2CO 11:8" /><verse number="9" style="v" sid="2CO 11:9" />ووَقْتِلِّي كُنْتْ نَحْتَاجْ وآنَا بَحْذَاكُمْ، مَا ثَقِّلْتِشْ عْلَى حَتَّى وَاحِدْ فِيكُمْ. عْلَى خَاطِرْ خْوَاتْنَا الِّي جَاوْ مِنْ مَقْدُونِيَّة عْطَاوْنِي الِّي نِحْتَاجُو. وحْرَصْتْ إِنِّي مَا نْثَقِّلْشْ عْلِيكُمْ، ومَانِيشْ بِشْ نْثَقِّلْ عْلِيكُمْ بِالكُلْ. <verse eid="2CO 11:9" /><verse number="10" style="v" sid="2CO 11:10" />وكِيمَا المَسِيحْ هُوَّ حَقْ نْأَكْدِلْكُمْ إِنِّي نْقُولْ الحَقْ: حَتَّى حَدْ مَاهُو بِشْ يَمْنَعْنِي إِنِّي نِتْفَخِّرْ بْهَاذَا فِي مَنْطَقْةْ أَخَائِيَة. <verse eid="2CO 11:10" /><verse number="11" style="v" sid="2CO 11:11" />عْلَاشْ؟ زَعْمَة عْلَى خَاطِرْ مَا نْحِبْكُمْشْ؟ يِعْلِمْ اللَّهْ قَدَّاشْ نْحِبْكُمْ.<verse eid="2CO 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 11:12" />آمَا رَانِي بِشْ نْزِيدْ نْكَمِّلْ فِلِّي نَعْمِلْ فِيهْ تَوَّا، بَاشْ مَا نَعْطِيشْ فُرْصَة لِلجْمَاعَة الِّي يِسْتَنَّاوْ فِي فُرْصَة بَاشْ يِتْفُوخْرُوا بِلِّي خِدْمِتْهُمْ كِيفْ خِدْمِتْنَا. <verse eid="2CO 11:12" /><verse number="13" style="v" sid="2CO 11:13" />هَاذُوكُمْ رُسُلْ كَذَّابِينْ، وخَدَّامَة غَشَّاشِينْ، عَامْلِينْ رْوَاحْهُمْ رُسُلْ المَسِيحْ. <verse eid="2CO 11:13" /><verse number="14" style="v" sid="2CO 11:14" />ومَا تِسْتَغِرْبُوشْ، رَاهُو الشِّيطَانْ هُوَّ بِيدُو يِتْنَكِّرْ بْمَظْهِرْ مَلَاكْ نُورْ، <verse eid="2CO 11:14" /><verse number="15" style="v" sid="2CO 11:15" />مَالَا مُشْ غْرِيبْ إِنُّو خَدَّامْتُو يُظْهْرُوا كَايِنْهُمْ يِخِدْمُوا فِي الصَّلَاحْ. هَاذُوكُمْ آخْرِتْهُمْ بِشْ تْكُونْ عْلَى قَدْ أَعْمَالْهُمْ.<verse eid="2CO 11:15" /></para>
  <para style="s">بُولِسْ يِتْفُوخِرْبِوْجَايْعُو</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 11:16" />ونْعَاوِدْ نْقُولْ: يِمْشِيشْ حَدْ مِنْكُمْ يْفَكِّرْ بِلِّي آنَا مَا نِفْهِمْشْ! آمَا كَانْ خَمَّمْتُوا هَكَّا، مِيسَالِشْ إِقْبْلُونِي، بَاشْ انَّجِّمْ نِتْفُوخِرْ شْوَيَّة. <verse eid="2CO 11:16" /><verse number="17" style="v" sid="2CO 11:17" />ولِّي نْقُولْ فِيهْ تَوَّا مُشْ مِنْ عَنْدْ الرَّبْ، آمَا نِتْكَلِّمْ كِيمَا وَاحِدْ مَا يِفْهِمْشْ وعَنْدُو جُرْأَة بَاشْ يِتْفُوخِرْ. <verse eid="2CO 11:17" /><verse number="18" style="v" sid="2CO 11:18" />مَادَامْ بَرْشَة مِنْكُمْ يِتْفُوخْرُوا بْأُمُورْ الدِّنْيَا، آنَا زَادَا بَاشْ نِتْفُوخِرْ. <verse eid="2CO 11:18" /><verse number="19" style="v" sid="2CO 11:19" />وإِنْتُومَا الِّي بِعْقَلْكُمْ هَاكُمْ تِتْحَمْلُوا فِلِّي بْلَا عْقَلْ وإِنْتُومَا فَرْحَانِينْ! <verse eid="2CO 11:19" /><verse number="20" style="v" sid="2CO 11:20" />إِيْ نْعَمْ، إِنْتُومَا تِتْحَمْلُوا الِّي يِسْتَعْبِدْكُمْ ويِسْتْغَلْكُمْ ويِسْرَقْكُمْ، ويِتْكَبِّرْ عْلِيكُمْ ويَضْرَبْكُمْ بِالكَفْ! <verse eid="2CO 11:20" /><verse number="21" style="v" sid="2CO 11:21" />شَيْ يْحَشِّمْ! قَدَّاشْ كُنَّا ضْعَافْ فِي مُعَامْلِتْنَا مْعَاكُمْ.</para>
  <para style="p" vid="2CO 11:21">ومَادَامْنِي نِتْكَلِّمْ كِيمَا وَاحِدْ مَا يِفْهِمْشْ، مَالَا الِّي هُومَا يِتْفُوخْرُوا بِيهْ الكُلْ حَتَّى آنَا زَادَا نِتْفُوخِرْ بِيهْ. <verse eid="2CO 11:21" /><verse number="22" style="v" sid="2CO 11:22" />كَانْ هُومَا عِبْرَانِيِّينْ حَتَّى آنَا زَادَا عِبْرَانِي، وكَانْهُمْ مِنْ بَنِي إِسْرَائِيلْ حَتَّى آنَا زَادَا مِنْ بَنِي إِسْرَائِيلْ، وكَانْهُمْ مِنْ ذُرِيِّةْ إِبْرَاهِيمْ حَتَّى آنَا زَادَا مِنْ ذُرِيِّةْ إِبْرَاهِيمْ. <verse eid="2CO 11:22" /><verse number="23" style="v" sid="2CO 11:23" />وكَانْهُمْ خُدَّامْ المَسِيحْ — وهُونِي نِتْكَلِّمْ تْقُولْشِي عْلِيَّا وَاحِدْ بْلَا عْقَلْ — آنَا أَحْسِنْ مِنْهُمْ: عْلَى خَاطِرْ تْعِبْتْ أَكْثِرْ مِنْهُمْ، وتْشَدِّيتْ فِي الحَبْسْ أَكْثِرْ مِنْهُمْ، وتْحَمِّلْتْ الضَّرْبْ أَكْثِرْ مِنْهُمْ، وشُفْتْ المُوتْ بَرْشَة مَرَّاتْ، <verse eid="2CO 11:23" /><verse number="24" style="v" sid="2CO 11:24" />اليْهُودْ جِلْدُونِي بِالسُّوطْ خَمْسَة مَرَّاتْ، فِي كُلْ مَرَّة 39 جَلْدَة. <verse eid="2CO 11:24" /><verse number="25" style="v" sid="2CO 11:25" />تِضْرَبْتْ بِالعْصِيْ ثْلَاثَة مَرَّاتْ، تِرْجَمْتْ بِالحْجَرْ مَرَّة، تْكَسْرِتْ بِيَّا السْفِينَة ثْلَاثَة مَرَّاتْ، وعَدِّيتْ نْهَارْ ولِيلَة فِي قَلْبْ البْحَرْ. <verse eid="2CO 11:25" /><verse number="26" style="v" sid="2CO 11:26" />سَافِرْتْ بَرْشَة مَرَّاتْ وتْعَرِّضْتْ لِخْطَرْ الوِدْيَانْ وخْطَرْ السُّرَّاقْ، وخْطَرْ مِاليْهُودْ ومِنْ غِيرْ اليْهُودْ، وخْطَرْ فِي المُدُنْ، وخْطَرْ فِي الخْلَاء، وخْطَرْ فِي البْحَرْ، وخْطَرْ مِالإِخْوَة الكَذَّابِينْ. <verse eid="2CO 11:26" /><verse number="27" style="v" sid="2CO 11:27" />عَانِيتْ مِالشْقَى والتْعَبْ ومِنْ قِلِّةْ النُّومْ، قَاسِيتْ الجُوعْ والعْطَشْ وقِلِّةْ المَاكْلَة والبَرْدْ والعْرَى. <verse eid="2CO 11:27" /><verse number="28" style="v" sid="2CO 11:28" />وفُوقْ هَاذَا الكُلْ، الضَّغْطْ يْزِيدْ عْلِيَّا كُلْ يُومْ عْلَى خَاطِرْنِي هَازِزْ مَسْؤُولِيِّةْ الكْنَايِسْ الكُلْ. <verse eid="2CO 11:28" /><verse number="29" style="v" sid="2CO 11:29" />شْكُونْ الِّي يُضْعُفْ وآنَا مَا نُضْعُفْشْ مْعَاهْ؟ وشْكُونْ الِّي يَعْمِلْ ذَنْبْ وقَلْبِي مَا يِتَّحْرَقْشْ عْلِيهْ؟<verse eid="2CO 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2CO 11:30" />إِذَا كَانْ لَازِمْ نِتْفُوخِرْ، تَوْ نِتْفُوخِرْ بِالأُمُورْ الِّي تْظَهِّرْ ضُعْفِي. <verse eid="2CO 11:30" /><verse number="31" style="v" sid="2CO 11:31" />واللَّهْ بُو رَبْنَا يَسُوعْ، المُبَارَكْ لِلْأَبَدْ، يَعْرِفْ الِّي آنَا مَا نِكْذِبْشْ. <verse eid="2CO 11:31" /><verse number="32" style="v" sid="2CO 11:32" />وفِي دِمَشْقْ، الوَالِي مْتَاعْ المَلِكْ الحَارِثْ عْطَى أَمْرْ بَاشْ يْعِسُّوا عَالمْدِينَة، بَاشْ يْشِدُّونِي، <verse eid="2CO 11:32" /><verse number="33" style="v" sid="2CO 11:33" />آمَا الإِخْوَة حَطُّونِي فِي قُفَّة وهَبْطُونِي مِنْ شُبَّاكْ فِي السُّورْ، يَاخِي مْنَعْتْ مِنُّو.<verse eid="2CO 11:33" /></para>
  <chapter eid="2CO 11" />
  <chapter number="12" style="c" sid="2CO 12" />
  <para style="s">بُولِسْ والمُشْكْلَة الِّي فِي بَدْنُو</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 12:1" />لَازِمْنِي نْزِيدْ نِتْفُوخِرْ، رَغْمِلِّي هَاذَا مُشْ بِشْ يْزِيدْنِي حَتَّى شَيْ، آمَا بِشْ نَحْكِيلْكُمْ عَالرُّؤْيَاتْ والإِعْلَانَاتْ الِّي كْشِفْهَالِي الرَّبْ. <verse eid="2CO 12:1" /><verse number="2" style="v" sid="2CO 12:2" />نَعْرِفْ رَاجِلْ مُؤْمِنْ بِالمَسِيحْ تِخْطَفْ لِلسْمَاء الثَّالْثَة مِنْ أَرْبَعْطَاشِنْ سْنَة لْتَالِي. تِخْطَفّْ بْبَدْنُو وَلَّا مِنْ غِيرْ بَدْنُو؟ مَا نَعْرِفْشْ. اللَّهُ أَعْلَمْ. <verse eid="2CO 12:2" /><verse number="3" style="v" sid="2CO 12:3" />نْعَاوِدْ نْقُولْ: نَعْرِفْ الِّي هُوَّ تِخْطَفْ، بْبَدْنُو وَلَّا مِنْ غِيرْ بْدَنْ؟ مَا نَعْرِفْشْ. اللَّهُ أَعْلَمْ. <verse eid="2CO 12:3" /><verse number="4" style="v" sid="2CO 12:4" />تِخْطَفْ لِلْفِرْدَوْسْ، وغَادِي سْمَعْ كْلَامْ مَا يْنَجِّمْشْ البَشَرْ يَنْطِقْ بِيهْ، وحَتَّى حَدْ مَا عَنْدُو الحَقْ يْقُولُو. <verse eid="2CO 12:4" /><verse number="5" style="v" sid="2CO 12:5" />آنَا نِتْفَخِّرْ بِالرَّاجِلْ هَاذَا، آمَا فِي مَا يْخُصْنِي، رَانِي مَا نِتْفَخِّرْ كَانْ بْضُعْفِي. <verse eid="2CO 12:5" /><verse number="6" style="v" sid="2CO 12:6" />وكَانْ حَبِّيتْ نِتْفُوخِرْ، مَا نْكُونِشْ بْلَا عْقَلْ، عْلَى خَاطِرْنِي نْقُولْ فِي الحَقْ. آمَا مَا نْحِبِّشْ نَعْمِلْ هَاذَا بَاشْ حَتَّى حَدْ مَا يْفَكِّرْ الِّي آنَا أَعْظِمْ مِلِّي يْشُوفُوا وَلَّا يِسْمْعُوا مِنِّي.<verse eid="2CO 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 12:7" />وبَاشْ مَا نِتْكَبِّرْشْ بِسْبَبْ الإِعْلَانَاتْ العْظِيمَة الِّي كْشِفْهَالِي اللَّهْ، تِبْلِيتْ بْمُشْكْلَة فِي بَدْنِي، كَايِنْهَا مَرْسُولْ مِنْ عَنْدْ الشِّيطَانْ يَضْرِبْ فِيَّا بَاشْ مَا نِتْكَبَّرْشْ. <verse eid="2CO 12:7" /><verse number="8" style="v" sid="2CO 12:8" />وطْلَبْتْ مِالرَّبْ ثْلَاثَة مَرَّاتْ بَاشْ يْنَحِّيهَا عْلِيَّا، <verse eid="2CO 12:8" /><verse number="9" style="v" sid="2CO 12:9" />يَاخِي قَالِّي: «نِعْمْتِي تْكَفِّيكْ، عْلَى خَاطِرْ قُوْتِي تُظْهُرْ فِي الضُّعْفْ». هَاذَاكَا عْلَاشْ نِتْفَخِّرْ بْضُعْفِي وآنَا فَرْحَانْ، بَاشْ قُوِّةْ المَسِيحْ تُسْكُنْ فِيَّا. <verse eid="2CO 12:9" /><verse number="10" style="v" sid="2CO 12:10" />وعْلَى خَاطِرْ المَسِيحْ، نِتْحَمِّلْ الضُّعْفْ والإِهَانَة والضِّيقْ والإِضْطِهَادْ والهَمْ، عْلَى خَاطِرْنِي وَقْتِلِّي نِبْدَا ضْعِيفْ، وَقْتْهَا نْكُونْ قْوِي.<verse eid="2CO 12:10" /></para>
  <para style="s">مْحَبِّةْ بُولِسْ وخُوفُو عْلَى مُؤْمْنِينْ كُورِنْثُوسْ</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 12:11" />آنَا تْصَرَّفْتْ بْقِلِّةْ عْقَلْ كِي تْفَخَّرْتْ، وإِنْتُومَا الِّي لَزِّيتُونِي! كَانْ لَازِمْ إِنْتُومَا تَمْدْحُونِي، عْلَى خَاطِرْ مَا يُنْقُصْنِي شَيْ «عَالرُّسُلْ الكْبَارْ» هَاذُوكُمْ، حَتَّى كَانْ مَا نَسْوَى شَيْ. <verse eid="2CO 12:11" /><verse number="12" style="v" sid="2CO 12:12" />وَقْتِلِّي كُنْتْ عَنْدْكُمْ، خْدِمْتْ بْكُلْ صَبْرْ، واللَّهْ عْمَلْ عْلَى يْدَيَّا مُعْجْزَاتْ وعْجَايِبْ وحَاجَاتْ فُوقْ العْقَلْ. وهَاذَا بَيِّنْ الِّي آنَا رَسُولْ بِالحَقْ. <verse eid="2CO 12:12" /><verse number="13" style="v" sid="2CO 12:13" />مَالَا شْنُوَّة يُنْقُصْكُمْ عَالكْنَايِسْ الأُخْرِينْ غِيرْ إِنِّي مَا ثَقَّلْتِشْ عْلِيكُمْ فِي حَتَّى شَيْ؟ سَامْحُونِي عَالغَلْطَة هَاذِي!<verse eid="2CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 12:14" />آنَا مُسْتْعَدْ نْجِيكُمْ مَرَّة ثَالْثَة، ومَانِيشْ بِشْ نْثَقِّلْ عْلِيكُمْ. عْلَى خَاطِرْ حَاشْتِي بِيكُمْ إِنْتُومَا، مُشْ بِالحَاجَاتْ الِّي عَنْدْكُمْ. رَاهُمْ الوَالْدِينْ هُومَا الِّي لَازِمْهُمْ يُصْرْفُوا عْلَى وْلَادْهُمْ، مُشْ الأَوْلَادْ يُصْرْفُوا عْلَى وَالْدِيهُمْ. <verse eid="2CO 12:14" /><verse number="15" style="v" sid="2CO 12:15" />وبِالنِّسْبَة لِيَّا، آنَا مُسْتْعَدْ نُصْرُفْ كُلْ مَا عَنْدِي وآنَا فَرْحَانْ، ومُسْتْعَدْ حَتَّى نْضَحِّي بْرُوحِي عْلَى خَاطِرْكُمْ. يَاخِي كُلْ مَا نْزِيدْ نْحِبْكُمْ أَكْثِرْ، إِنْتُومَا تْحِبُّونِي أَقَلْ؟ <verse eid="2CO 12:15" /><verse number="16" style="v" sid="2CO 12:16" />مُمْكِنْ تْقُولُوا الِّي آنَا مَا ثَقِّلْتِشْ عْلِيكُمْ، آمَا تْحَيَّلْتْ عْلِيكُمْ وسْلِبْتْكُمْ بِخْبَاثَةْ! <verse eid="2CO 12:16" /><verse number="17" style="v" sid="2CO 12:17" />يَاخِي إِسْتْغَلِّيتْكُمْ عْلَى طْرِيقْ أَيْ وَاحِدْ مِلِّي بْعَثْتْهُمْلْكُمْ؟ <verse eid="2CO 12:17" /><verse number="18" style="v" sid="2CO 12:18" />وَقْتِلِّي شَدِّيتْ صْحِيحْ فِي تِيطُسْ بَاشْ يِمْشِيلْكُمْ وبْعَثْتْ مْعَاهْ خُونَا الآخِرْ، إِسْتْغَلْكُمْشِي تِيطُسْ فِي حَاجَة؟ يَاخِي مَا تْصَرَّفْنَاشْ مْعَاكُمْ بْنَفْسْ الرُّوحْ؟ مَا مْشِينَاشْ فِي نَفْسْ الطْرِيقْ؟<verse eid="2CO 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CO 12:19" />مُمْكِنْ مَاشِي فِي بَالْكُمْ الِّي الوَقْتْ هَاذَا الكُلْ أَحْنَا قَاعْدِينْ نْدَافْعُوا عْلَى رْوَاحْنَا قُدَّامْكُمْ. لَا! أَحْنَا نِتْكَلْمُوا قُدَّامْ اللَّهْ بْصِيفِتْنَا مُؤْمْنِينْ بِالمَسِيحْ، ونَعْمْلُوا فِي هَاذَا الكُلْ يَا حْبَابْنَا بَاشْ إِنْتُومَا تِكْبْرُوا فِي الإِيمَانْ. <verse eid="2CO 12:19" /><verse number="20" style="v" sid="2CO 12:20" />وآنَا خَايِفْ لَا وَقْتِلِّي نْجِيكُمْ، نَلْقَاكُمْ مُشْ كِيفْ مَا آنَا نْحِبْ، وتَلْقَاوْنِي مُشْ كِيمَا إِنْتُومَا تْحِبُّوا. نْخَافْ لَا يْكُونْ بِينَاتْكُمْ عَرْكْ وحُسْدْ وغُشْ وأَنَانِيَّة وذَمَّانْ وتَقْطِيعْ وتَرْيِيشْ وتَكَبُّرْ وفَوْضَى. <verse eid="2CO 12:20" /><verse number="21" style="v" sid="2CO 12:21" />ونْخَافْ إِذَا نْجِيكُمْ مَرَّة أُخْرَى، يْذِلْنِي إِلَاهِي قُدَّامْكُمْ، ونُقْعِدْ نِبْكِي عْلَى بَرْشَة مِلِّي عَمْلُوا ذْنُوبْ قْبَلْ ومَا تَابُوشْ عَالنْجَاسَة والزْنَى والفِسْقْ الِّي عَمْلُوهُمْ.<verse eid="2CO 12:21" /></para>
  <chapter eid="2CO 12" />
  <chapter number="13" style="c" sid="2CO 13" />
  <para style="s">تَنْبِيهْ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 13:1" />هَاذِي المَرَّة الثَّالْثَة الِّي بِشْ نْجِيكُمْ فِيهَا. وكِيمَا تْقُولْ الكْتُبْ المُقَدْسَة: «مَا يْكُونْ فَمَّة حُكْمْ فِي أَيْ قَضِيَّة إِلَّا مَا يْكُونْ فَمَّة زُوزْ وَلَّا ثْلَاثَة شْهُودْ». <verse eid="2CO 13:1" /><verse number="2" style="v" sid="2CO 13:2" />وَقْتِلِّي جِيتْكُمْ المَرَّة الثَّانْيَة نَبَّهْتْ عَلِّي عَمْلُوا ذْنُوبْ قْبَلْ وعَالأُخْرِينْ الكُلْ، وهَانِي حَتَّى وآنَا غَايِبْ بِشْ نْزِيدْ انَّبِّهْ عْلِيهُمْ: رَانِي وَقْتِلِّي نَرْجْعِلْكُمْ، مَانِي بِشْ نِسْخِفْ عْلَى حَتَّى حَدْ، <verse eid="2CO 13:2" /><verse number="3" style="v" sid="2CO 13:3" />مَادَامْكُمْ تُطْلْبُوا فِي دَلِيلْ إِنُّو المَسِيحْ يِتْكَلِّمْ عْلَى لْسَانِي. والمَسِيحْ مُشْ ضْعِيفْ وَقْتِلِّي يِتْعَامِلْ مْعَاكُمْ، آمَا رَاهُو قْوِي بِينَاتْكُمْ. <verse eid="2CO 13:3" /><verse number="4" style="v" sid="2CO 13:4" />ورَغْمِلِّي كَانْ ضْعِيفْ وَقْتِلِّي تِصْلَبْ، آمَا هُوَّ تَوَّا حَيْ بْقُوِّةْ اللَّهْ. وأَحْنَا زَادَا ضْعَافْ بِمَا إِنَّا تَابْعِينُو، آمَا بِشْ نْكُونُو قْوِيِّينْ وَقْتِلِّي نِتْصَرْفُوا مْعَاكُمْ، عْلَى خَاطِرْنَا حَيِّينْ مْعَاهْ بْقُوِّةْ اللَّهْ.<verse eid="2CO 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 13:5" />شُوفُوا رْوَاحْكُمْ، بَاشْ تَعْرْفُوا إِذَا كَانْ مَزِّلْتُوا مُؤْمْنِينْ، حَاسْبُوا رْوَاحْكُمْ. يَاخِي مَا تَعْرْفُوشْ الِّي يَسُوعْ المَسِيحْ فِيكُمْ؟ إِلَّا إِذَا كَانْ، بَعْدْ مَا حَاسِبْتُوا رْوَاحْكُمْ، تِلْقَاوْ رْوَاحْكُمْ فْشِلْتُوا فِي الإِمْتِحَانْ. <verse eid="2CO 13:5" /><verse number="6" style="v" sid="2CO 13:6" />آمَا مَذَابِينَا تَعْرْفُوا الِّي أَحْنَا مَا فْشِلْنَاشْ فِي الإِمْتِحَانْ. <verse eid="2CO 13:6" /><verse number="7" style="v" sid="2CO 13:7" />ونُطُلْبُوا مِنْ اللَّهْ إِنْكُمْ مَا تَعْمْلُوشْ الغْلَطْ، مُشْ بَاشْ النَّاسْ تْشُوفْ الِّي أَحْنَا نْجِحْنَا، آمَا بَاشْ إِنْتُومَا تَعْمْلُوا الصْوَابْ، حَتَّى كَانْ ظْهُرْنَا كَايِنَّا أَحْنَا فْشِلْنَا. <verse eid="2CO 13:7" /><verse number="8" style="v" sid="2CO 13:8" />عْلَى خَاطِرْنَا مَا انَّجْمُوشْ نَعْمْلُوا حَاجَة ضِدْ الحَقْ، ومَا انَّجْمُوا نْكُونُوا كَانْ مْعَاهْ، <verse eid="2CO 13:8" /><verse number="9" style="v" sid="2CO 13:9" />وقَدَّاشْ نِفْرْحُوا وَقْتِلِّي نْكُونُوا أَحْنَا ضْعَافْ وإِنْتُومَا قْوِيِّينْ. ولِّي نُطِلْبُوهْ مِنْ اللَّهْ هُوَّ إِنْكُمْ تْكُونُوا كَامْلِينْ. <verse eid="2CO 13:9" /><verse number="10" style="v" sid="2CO 13:10" />هَاذَاكَا عْلَاشْ نِكْتْبِلْكُمْ فِي هَاذَا وآنَا غَايِبْ بَاشْ مَا نْكُونِشْ صْعِيبْ مْعَاكُمْ وآنَا حَاضِرْ، عْلَى خَاطِرْ الرَّبْ عْطَانِي السُّلْطَة مُشْ بَاشْ نِهْدِمْ آمَا بَاشْ نِبْنِي.<verse eid="2CO 13:10" /></para>
  <para style="s">سْلَامْ</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 13:11" />وفِي الإِخِّرْ يَا خْوَاتِي، إِفْرْحُوا وأَسْعَاوْ بَاشْ تْكُونُوا كَامْلِينْ، اتْشَجْعُوا وكُونُوا بْرَايْ وَاحِدْ وعِيشُوا فِي سَلَامْ، وإِلَاهْ المْحَبَّة والسَّلَامْ يْكُونْ مْعَاكُمْ. <verse eid="2CO 13:11" /><verse number="12" style="v" sid="2CO 13:12" />سَلْمُوا عْلَى بْعَضْكُمْ بْبُوسَة طَاهْرَة. <verse eid="2CO 13:12" /><verse number="13" style="v" sid="2CO 13:13" />يْسَلْمُوا عْلِيكُمْ القِدِّيسِينْ الكُلْ.<verse eid="2CO 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 13:14" />ونِعْمِةْ رَبْنَا يَسُوعْ المَسِيحْ، ومْحَبِّةْ اللَّهْ، والعِشْرِة مْعَ الرُّوحْ القُدُسْ يْكُونُوا مْعَاكُمْ الكُلْ! آمِينْ.<verse eid="2CO 13:14" /></para>
  <chapter eid="2CO 13" />
</usx>