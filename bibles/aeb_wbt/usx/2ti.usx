<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id" />
  <para style="h">تِيمُوثَاوُسْ الثَّانْيَة</para>
  <para style="toc1">رِسَالِةْ بُولِسْ الثَّانْيَة لْتِيمُوثَاوُسْ</para>
  <para style="toc2">تِيمُوثَاوُسْ الثَّانْيَة</para>
  <para style="toc3">تِيمُوثَاوُسْ الثَّانْيَة</para>
  <para style="mt">رِسَالِةْ بُولِسْ الثَّانْيَة لْتِيمُوثَاوُسْ</para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />مِنْ بُولِسْ الِّي اللَّهْ حَبُّو يْكُونْ رَسُولْ يَسُوعْ المَسِيحْ، بَاشْ يْبَشِّرْ بِالحَيَاةْ الِّي وْعِدْ بِيهَا اللَّهْ لْكُلْ الِّي يَمْنُوا بْيَسُوعْ المَسِيحْ، <verse eid="2TI 1:1" /><verse number="2" style="v" sid="2TI 1:2" />لْوِلْدِي الِّي نْحِبُّو تِيمُوثَاوُسْ:</para>
  <para style="p" vid="2TI 1:2">النِّعْمَة والرَّحْمَة والسَّلَامْ لِيكْ مِنْ اللَّهْ الآبْ ومِالمَسِيحْ يَسُوعْ رَبْنَا.<verse eid="2TI 1:2" /></para>
  <para style="s">بُولِسْ يْشَجَّعْ تِيمُوثَاوُسْ عَالأَمَانَة</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />نُشْكُرْ اللَّهْ، الِّي نِعْبِدْ فِيهْ بْضَمِيرْ طَاهِرْ كِيمَا عِبْدُوهْ جْدُودِي، ورَانِي دِيمَا نِتْذَكِّرْ فِيكْ فِي صْلَاتِي لِيلْ ونْهَارْ. <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />وكِي نِتْذَكِّرْ دْمُوعِكْ، نْزِيدْ نِتْوَحْشِكْ ونْوَلِّي نْحِبْ نْشُوفِكْ بَاشْ نِتِمْلَى بِالفَرْحَة. <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" />ونِتْذَكِّرْ إِيمَانِكْ الصَّادِقْ، نَفْسْ الإِيمَانْ الِّي كَانْ سَاكِنْ فِي قَلْبْ مَمَّاتِكْ لُوئِيسْ وقَلْبْ أُمِّكْ أَفْنِيكِي، وآنَا مِتْأَكِّدْ الِّي هُوَّ يُسْكُنْ فِي قَلْبِكْ إِنْتِ زَادَا.<verse eid="2TI 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 1:6" />هَاذَاكَا عْلَاشْ نْشَجْعِكْ بَاشْ تْشَعِّلْ الهِيبَة الِّي عْطَاهَالِكْ اللَّهْ وَقْتِلِّي حَطِّيتْ عْلِيكْ يْدَيَّا ووَافِقْتْ عْلِيكْ. <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />رَاهُو اللَّهْ مَا عْطَانَاشْ رُوحْ الخُوفْ، آمَا عْطَانَا رُوحْ القُوَّة والمْحَبَّة والرْزَانَة. <verse eid="2TI 1:7" /><verse number="8" style="v" sid="2TI 1:8" />مَالَا مَا تِحْشِمْشْ بَاشْ تِشْهِدْ لِلرَّبْ، ومَا تِحْشِمْشْ بِيَّا آنَا، المَرْبُوطْ عْلَى خَاطْرُو. آمَا تْوَكِّلْ عْلَى قُوِّةْ اللَّهْ، وتْحَمِّلْ مْعَايَا العْذَابْ عْلَى خَاطِرْ البْشَارَة.<verse eid="2TI 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 1:9" />اللَّهْ نَجَّانَا ودْعَانَا لْعِيشَة مُقَدْسَة، مُشْ عْلَى خَاطِرْ أَعْمَالْنَا، آمَا عْلَى خَاطِرْ قَصْدُو ونِعْمْتُو الِّي عْطَاهَالْنَا فِي يَسُوعْ المَسِيحْ مِنْ أَوِّلْ الدِّنْيَا، <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />ولِّي تَوَّا كْشِفْهَالْنَا كِي ظْهُرْ يَسُوعْ المَسِيحْ الِّي يْنَجِّينَا، ولِّي غْلِبْ المُوتْ، ووَرَّى طْرِيقْ الحَيَاةْ الأَبَدِيَّة بِالبْشَارَة، <verse eid="2TI 1:10" /><verse number="11" style="v" sid="2TI 1:11" />ولِّي عْلَى خَاطِرْهَا إِخْتَارْنِي اللَّهْ بَاشْ نْكُونْ مُبَشِّرْ ورَسُولْ ومُعَلِّمْ، <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />وعْلَى خَاطِرْهَا نِتْحَمِّلْ العْذَابْ. وآنَا مَانِيشْ حَاشِمْ، خَاطِرْ نَعْرِفْ بِشْكُونْ أَمَّنْتْ، ونَاثِقْ الِّي هُوَّ قَادِرْ بَاشْ يَحْفِظْ الأَمَانَة الِّي عْطَاهَالِي حَتَّى يْجِي النْهَارْ هَاذَاكَا.<verse eid="2TI 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 1:13" />مَالَا أَعْمِلْ بِالكْلَامْ الصْحِيحْ الِّي سْمَعْتُو مِنِّي، وخَلِّيهْ يْكُونْلِكْ مِثَالْ اتَّبْعُو، وإِثْبِتْ فِي الإِيمَانْ والمْحَبَّة الِّي فِي يَسُوعْ المَسِيحْ . <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />أَحْفِظْ الأَمَانَة الصَّالْحَة الِّي تِعْطَاتْلِكْ، والرُّوحْ القُدُسْ الِّي يُسْكُنْ فِينَا يْعَاوْنِكْ.<verse eid="2TI 1:14" /></para>
  <para style="s">أَمَانِةْ أُونِيسِفُورُسْ</para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />إِنْتِ تَعْرِفْ إِنُّو الِّي فِي مَنْطَقْةْ آسِيَّا الكُلْ خَلَّاوْنِي، بِيمَا فِيهُمْ فِيجَلُّسْ وهَرْمُوجِينِيسْ. <verse eid="2TI 1:15" /><verse number="16" style="v" sid="2TI 1:16" />اللَّهْ يْبَارِكْ عَايِلْةْ أُونِيسِفُورُسْ عْلَى خَاطْرُو شَجَّعْنِي بَرْشَة ومَا حْشِمْشْ بَيَّا وآنَا فِي الحَبِسْ، <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />بِالعَكْسْ وَقْتِلِّي وْصُلْ لْرُومَا، لَوِّجْ عْلِيَّا بْكُلْ جُهْدُو حَتَّى لِينْ لْقَانِي. <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />الرَّبْ يِنْعِمْ عْلِيهْ بَاشْ يَلْقَى الرَّحْمَة مِنْ عَنْدْ الرَّبْ نْهَارِةْ الِّي يِرْجَعْ! وإِنْتِ تَعْرِفْ بِالڨْدَا قَدَّاشْ خْدِمْنِي وَقْتِلِّي كُنْتْ فِي أَفَسُسْ.<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="s">كُونْ جُنْدِي صَالَحْ لْيَسُوعْ المَسِيحْ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />وإِنْتِ يَا وِلْدِي، كُونْ قْوِي بِالنِّعْمَة الِّي فِي يَسُوعْ المَسِيحْ، <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />والتَّعْلِيمْ الِّي سْمَعْتُو مِنِّي بِحْضُورْ بَرْشَة شْهُودْ، أَعْطِيهْ أَمَانَة لْنَاسْ تَاثِقْ فِيهُمْ ويْكُونُوا قَادْرِينْ بَاشْ يْعَلْمُوا غِيرْهُمْ. <verse eid="2TI 2:2" /><verse number="3" style="v" sid="2TI 2:3" />وإِتْحَمِّلْ الوْجَايِعْ كِيمَا جُنْدِي صَالَحْ لْيَسُوعْ المَسِيحْ. <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />عْلَى خَاطِرْ الجُنْدِي الِّي يْحِبْ يْرَضِّي القَايِدْ مْتَاعُو مَا يُقْعُدِشْ لَاهِي بْأُمُورْ الحَيَاةْ العَادِيَّة. <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />ولِّي يَلْعِبْ فِي رِيَاضَة مَا يِرْبِحْ الجَايْزَة كَانْ كِي يَلْعِبْ بْحَسْبْ قَانُونْهَا. <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />والفَلَّاحْ الِّي يِخْدِمْ ويِتْعِبْ يِلْزْمُو يْكُونْ أَوِّلْ وَاحِدْ يَاخِذْ بَايُو مِالغَلَّة. <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />فَكِّرْ فِلِّي نْقُلِّكْ فِيهْ، والرَّبْ تَوْ يْعَاونِكْ بَاشْ تِفْهِمْ كُلْ شَيْ.<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />وإِتْذَكِّرْ يَسُوعْ المَسِيحْ الِّي قَامْ مِنْ بِينْ المُوتَى، وكَانْ مِنْ ذُرِّيِّةْ دَاوِدْ، وهَاذِي البْشَارَة الِّي نْبَشِّرْ بِيهَا <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />ولِّي نْقَاسِي فِي العْذَابْ عْلَى خَاطِرْهَا، حَتَّى إِنِّي تِرْبَطْتْ بِالسْلَاسِلْ كِيفْ المُجْرِمْ. آمَا كِلْمِةْ اللَّهْ مَا تِتْرْبَطْشْ. <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />هَاذَاكَا عْلَاشْ نِتْحَمِّلْ كُلْ شَيْ عْلَى خَاطِرْ الِّي إِخْتَارْهُمْ اللَّهْ، بَاشْ هُومَا زَادَا يَاخْذُوا النْجَاةْ الِّي فِي يَسُوعْ المَسِيحْ، مْعَ المَجْدْ الِّي يْدُومْ لِلْأَبَدْ. <verse eid="2TI 2:10" /><verse number="11" style="v" sid="2TI 2:11" />الكْلَامْ هَاذَا صَادِقْ:</para>
  <para style="b" vid="2TI 2:11" />
  <para style="q1" vid="2TI 2:11">إِذَا كَانْ مُتْنَا مْعَاهْ،</para>
  <para style="q2" vid="2TI 2:11">بِشْ نَحْيَاوْ مْعَاهْ.<verse eid="2TI 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12" />وإِذَا تْحَمَّلْنَا،</para>
  <para style="q2" vid="2TI 2:12">بِشْ نِمْلْكُوا مْعَاهْ،</para>
  <para style="q1" vid="2TI 2:12">وإِذَا نْكَرْنَاهْ</para>
  <para style="q2" vid="2TI 2:12">هُوَّ زَادَا بِشْ يُنْكُرْنَا.<verse eid="2TI 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13" />وإِذَا خُنَّا الأَمَانَة،</para>
  <para style="q2" vid="2TI 2:13">هُوَّ يَبْقَى أَمِينْ،</para>
  <para style="q1" vid="2TI 2:13">خَاطِرْ مَا يْنَجَّمِشْ يُنْكُرْ نَفْسُو.<verse eid="2TI 2:13" /></para>
  <para style="b" />
  <para style="s">كُونْ خَادِمْ أَمِينْ</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />ذَكِّرْهُمْ بِالحَاجَاتْ هَاذِي الكُلْ، ونَبِّهُّمْ قُدَّامْ اللَّهْ بَاشْ مَا يُدْخْلُوشْ فِي النِّقَاشَاتْ الفَارْغَةْ، رَاهِي مَا تُصْلُحْ لْشَيْء، آمَا إِدَّمِّرْ الِّي يِسْمْعُوهَا. <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />أَعْمِلْ مَجْهُودِكْ بَاشْ تْكُونْ مَقْبُولْ عَنْدْ اللَّهْ، وتْكُونْ خَادِمْ مَا يِحْشِمْشْ بْخِدِمْتُو عْلَى خَاطِرْ يْفَسِّرْ كِلْمِةْ الحَقْ بِالصْحِيحْ. <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />سَيِّبْ عْلِيكْ مِالكْلَامْ الفَارِغْ الِّي يِتْعَارِضْ مْعَ إِيمَانْنَا، خَاطِرْ الِّي يِتِلْهَاوْ بِيهْ يْزِيدُوا يِفْسْدُوا أَكْثِرْ، <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />وكْلَامْهُمْ كَايِنُّو سَرَطَانْ يِنْهِشْ فِي البْدَنْ، ومِنْهُمْ هِيمِينَايُسْ وفِيلِيتُسْ، <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />الِّي بِعْدُوا عَالحَقْ وَقْتِلِّي قَالُوا الِّي القْيَامَة صَارِتْ، وهَكَّا هَدُّوا إِيمَانْ جْمَاعَة مِالنَّاسْ. <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" />آمَا السَّاسْ الصْحِيحْ الِّي حَطُّو اللَّهْ رَاهُو يَبْقَى ثَابِتْ، مَخْتُومْ بِالكْلَامْ هَاذَا: «الرَّبْ يَعْرِفْ النَّاسْ الِّي تَابْعِينُو» و «الِّي يُذْكُرْ إِسْمْ الرَّبْ يِلْزْمُو يِبْعِدْ عَالشَّرْ».<verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />وفِي الدَّارْ الكْبِيرَة، مَا فَمَّاشْ كَانْ مَاعُونْ مِنْ ذْهَبْ وفِضَّة. فَمَّة زَادَا مَاعُونْ مِاللُّوحْ والفُخَّارْ، فَمَّة الِّي نِسْتَعْمْلُوهْ فِي الحَاجَاتْ الِّي عَنْدْهَا قِيمَة، وفَمَّة الِّي نِسْتَعْمْلُوهْ فِي الحَاجَاتْ الِّي مَا عَنْدْهَاشْ قِيمَة. <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />الِّي يْطَهِّرْ رُوحُو مِالشَّرْ الِّي ذْكَرْتُو، يْكُونْ كِالمَاعُونْ الِّي عَنْدُو قِيمَة، مْخَصِّصْ لْسِيدُو، نَافَعْ وحَاضِرْ بَاشْ يَعْمِلْ كُلْ مَا هُوَّ صَالَحْ.<verse eid="2TI 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22" />أُهْرُبْ مِالشْهَاوِي الخَايْبَة مْتَاعْ الشَّبَابْ، وتَبَّعْ الصَّلَاحْ والإِيمَانْ والمْحَبَّة والسَّلَامْ مْعَ الِّي يُطِلْبُوا فِي الرَّبْ بْقَلْبْ طَاهِرْ. <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />إِبْعِدْ عَالنِّقَاشَاتْ التَّافْهَة والفَارْغَةْ، خَاطْرِكْ تَعْرِفْ الِّي هِيَّ تَعْمِلْ العَرْكْ. <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />وخَادِمْ الرَّبْ مَا يِلْزْمُوشْ يَعْمِلْ العَرْكْ، آمَا يِلْزْمُو يْسَايِسْ النَّاسْ الكُلْ، ويْكُونْ يْنَجِّمْ يْعَلِّمْ، ويُصْبُرْ فِي الأَوْقَاتْ الصْعِيبَة، <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />ويْصَحِّحْ بِالسْيَاسَة الِّي يْعَارْضُوهْ، بَالِكْشِي اللَّهْ يِهْدِيهُمْ ويْتُوبُوا ويَعْرْفُوا الحَقْ، <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />ويِرْجْعُوا لِعْقُولَاتْهُمْ ويِفْلْتُوا مِنْ مِنْدَافْ إِبْلِيسْ الِّي إِصْطَادْهُمْ وخَلَّاهُمْ يَعْمْلُوا الِّي يْحِبْ عْلِيهْ.<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s">بِشْ تْجِي أَوْقَاتْ صْعِيبَة</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />وأَعْرِفْ الِّي فِي الأَيَّامَاتْ اللِّخْرَةْ بِشْ تْجِي أَوْقَاتْ صْعِيبَة، <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />يْكُونُوا فِيهَا النَّاسْ أَنَانِيِّينْ، يْحِبُّوا الفْلُوسْ، يِتْكَبْرُوا، يِتْفُوخْرُوا، يَكْفْرُوا، مَا يْطِيعُوشْ وَالْدِيهُمْ، يُنْكْرُوا الجْمِيلْ، فَاسِدِينْ، <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />لَا عَنْدْهُمْ لَا رَحْمَةْ ولَا شَفْقَةْ، مَا يْسَامْحُوشْ، يْهَتْكُوا فِي أَعْرَاضْ النَّاسْ، مِتْهَوْرِينْ، مِتْوَحْشِينْ، مَا يْحِبُّوشْ الخِيرْ، <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />خَايْنِينْ، طَايْشِينْ، عْمَاهُمْ التَّكَبُّرْ، يْحِبُّوا مُتْعِتْهُمْ أَكْثِرْ مِلِّي يْحِبُّوا اللَّهْ، <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />مَا عَنْدْهُمْ مِالتَقْوَى كَانْ المَظْهَرْ البَرَّانِي آمَا مَاهُمْشْ عَايْشِينْ بْقُوِّتْهَا. النَّاسْ هَاذُومَا، إِبْعِدْ عْلِيهُمْ. <verse eid="2TI 3:5" /><verse number="6" style="v" sid="2TI 3:6" />وفَمَّة شْكُونْ مِنْهُمْ يُدْخْلُوا لِلدْيَارْ ويْغُرُّوا بِالنْسَاء الضْعَافْ، المِلْيَانِينْ بِالذْنُوبْ، الِّي يْتَبْعُوا فِي الشْهَاوِي بْأَنْوَاعْهَا، <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />ولِّي قَاعْدِينْ دِيمَا يِتْعَلْمُوا آمَا عْمُرْهُمْ مَا يْنَجْمُوا يَعْرْفُوا الحَقْ. <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />وكِيفْ مَا يَنِّيسْ ويَمْبْرِيسْ جَاوْ ضِدْ مُوسَى، النَّاسْ هَاذُومَا زَادَا يْجِيوْ ضِدْ الحَقْ، نَاسْ عْقُولْهُمْ فَاسْدَة، ومَاهُمِشْ أَهْلْ لِلْإِيمَانْ، <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />آمَا مَا عَنْدْهُمْ وِينْ يُوصْلُوا، عْلَى خَاطِرْ قِلِّةْ فَهْمْهُمْ بِشْ تِكْشِفْهُمْ قُدَّامْ النَّاسْ الكُلْ، كِيمَا تْكِشْفِتْ قِلِّةْ فَهْمْ يِنِّيسْ ويِمْبْرِيسْ.<verse eid="2TI 3:9" /></para>
  <para style="s">إِثْبِتْ فِلِّي تْعَلِّمْتُو وأَمَّنْتْ بِيهْ</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />آمَا إِنْتِ تَبَّعْتْ التَّعْلِيمْ مْتَاعِي، وتَعْرِفْ سِيرْتِي، وأَهْدَافِي، وإِيمَانِي، وصَبْرِي، ومْحَبْتِي، وقَدَّاشْ نِتْحَمِّلْ، <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" />وإِنْتِ تَعْرِفْ الإِضْطِهَادْ والعْذَابْ الِّي قَاسِيتْهُمْ فِي أَنْطَاكْيَة وإِيقُونْيَة ولِسْتْرَة. قَدَّاشْ عَانِيتْ مِنْ إِضْطِهَادَاتْ! آمَا الرَّبْ مَنَّعْنِي مِنْهَا الكُلْ. <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />بِالحَقْ، كُلْ وَاحِدْ يْحِبْ يْعِيشْ عِيشِةْ التَّقْوَى فِي يَسُوعْ المَسِيحْ بِشْ يِضْطَهْدُوهْ. <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />آمَا الأَشْرَارْ والدَّجَّالِينْ، شَرْهُمْ بِشْ يْزِيدْ، هُومَا يْغَلْطُوا فِي غِيرْهُمْ ويْغَلْطُوا فِي رْوَاحْهُمْ. <verse eid="2TI 3:13" /><verse number="14" style="v" sid="2TI 3:14" />آمَا إِنْتِ إِثْبِتْ فِلِّي تْعَلِّمْتُو وأَمَّنْتْ بِيهْ وإِنْتِ مِتْأَكِّدْ مِنُّو، عْلَى خَاطْرِكْ تَعْرِفْ مِنْ عَنْدْ شْكُونْ خْذِيتُو. <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />وإِنْتِ مِلِّي كُنْتْ صْغِيرْ تَعْرِفْ الكْتُبْ المُقَدْسَة، الِّي تْنَجِّمْ تَعْطِيكْ الحِكْمَة الِّي تْوَصْلِكْ لِلنْجَاةْ بِالإِيمَانْ بْيَسُوعْ المَسِيحْ. <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />المَكْتُوبْ فِي الكْتُبْ المُقَدْسَة الكُلُّو وَحْيْ مِنْ عَنْدْ اللَّهْ، صَالَحْ بَاشْ يْعَلِّمْنَا ويْنَبِّهْنَا ويْصَلِّحْنَا ويْدَّرِّبْنَا كِيفَاشْ نْعِيشُوا حَسْبْ مَشِيئِةْ اللَّهْ، <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />بَاشْ يْكُونْ المُؤْمِنْ حَاضِرْ ومُؤَهِّلْ بَاشْ يَعْمِلْ كُلْ مَا هُوَّ صَالَحْ.<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="s">بَشِّرْ بِكْلَامْ اللَّهْ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />ونُطْلِبْ مِنِّكْ ونْلِحْ عْلِيكْ قُدَّامْ اللَّهْ والمَسِيحْ الِّي بِشْ يُحْكُمْ عَالحَيِّينْ والمُوتَى وَقْتِلِّي يُظْهُرْ وتْجِي مَمْلَكْتُو، <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />إِنِّكْ تْبَشِّرْ بِكْلَامْ اللَّهْ، وتَحْرِصْ عْلَى هَاذَا فِي وَقْتُو وفِي غِيرْ وَقْتُو. وَبِّخْ ونَبَّهْ وشَجَّعْ، وخَلِّي عَنْدِكْ صَبْرْ وإِنْتِ تْعَلِّمْ. <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />رَاهُو بِشْ يْجِي وَقْتْ النَّاسْ مَا عَادِشْ يِحْمْلُوا فِيهْ التَّعْلِيمْ الصْحِيحْ، آمَا بِشْ يْكَدْسُوا لِرْوَاحْهُمْ مُعَلْمِينْ يِخْتَارُوهُمْ حَسْبْ شْهَاوِيهُمْ، يْقُولُولْهُمْ الحَاجَاتْ الِّي يْحِبُّوا يِسْمْعُوهَا، <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />وهَكَّا يْسَكْرُوا وِذْنِيهُمْ عَالحَقْ، ويْتَبْعُوا الخْرَافَاتْ. <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />آمَا إِنْتِ، كُونْ دِيمَا فَايِقْ، وإِتْحَمِّلْ العْذَابْ، وإِخْدِمْ خِدْمِةْ المُبَشِّرْ، وكَمِّلْ خِدْمْتِكْ لِلِّخِرْ.<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />وبِالنِّسْبَة لِيَّا آنَا، رَاهُو جَاء الوَقْتْ الِّي بِشْ نْضَحِّي فِيهْ بِحْيَاتِي. وسَاعْتِي قُرْبِتْ. <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />جَاهِدْتْ الجِهَادْ البَاهِي، كَمَّلِتْ السِّبَاقْ، حَافِظْتْ عْلَى الإِيمَانْ، <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />وتَوَّا يِسْتَنَّى فِيَّا تَاجْ الصَّلَاحْ، الِّي بِشْ يْجَازِينِي بِيهْ الرَّبْ، القَاضِي العَادِلْ، فِي نْهَارْ الحْسَابْ. ومُشْ آنَا وَحْدِي، آمَا بِشْ يْجَازِي بِيهْ كُلْ المِتْشَوْقِينْ لِرْجُوعُو.<verse eid="2TI 4:8" /></para>
  <para style="s">وْصَايَا شَخْصِيَّة</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />حَاوِلْ تْجِينِي فِيسَعْ، <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" />عْلَى خَاطِرْ دِيمَاسْ حَبْ أُمُورْ الدِّنْيَا هَاذِي وخَلَّانِي ومْشَى لِتْسَالُونِيكِي، وكْرِيسْكِيسْ مْشَى لْغَلَاطْيَة وتِيطُسْ لْدَلْمَاطْيَة، <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" />ومَا بْقَى مْعَايَا كَانْ لُوقَا بَرْكْ. إِتْعَدَّى لْمُرْقُسْ وجِيبُو مْعَاكْ، عْلَى خَاطْرُو يَنْفَعْنِي بَرْشَة فِي خِدْمِةْ الرَّبْ. <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" />وكَانِكْ عْلَى تِيخِيكُسْ رَانِي بْعَثْتُو لْأَفَسُسْ. <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" />وَقْتِلِّي تْجِي، جِيبْلِي مْعَاكْ كَبُّوطِي الِّي خَلِّيتُو عَنْدْ كَارْبِسْ فِي تَرُوَاسْ، وجِيبْ الكْتُبْ زَادَا، وبِالأَخَصْ الأَوْرَاقْ الِّي مِالجِّلْدْ.<verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />إِسْكَنْدَرْ النَّحَّاسْ ضَرْنِي بَرْشَة، والرَّبْ بِشْ يْحَاسْبُو عْلَى عْمَايْلُو. <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />إِنْتِ زَادَا رُدْ بَالِكْ مِنُّو، عْلَى خَاطْرُو عَارِضْ كْلَامْنَا بْكُلْ قُوْتُو.<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />فِي أَوِّلْ مَرَّة وْقِفْتْ قُدَّامْ المَحْكْمَة ودَافِعْتْ عْلَى رُوحِي، حَتَّى حَدْ مَا وْقِفْ مْعَايَا، والنَّاسْ الكُلْ خَلَّاوْنِي. اللَّهْ يْسَامَحْهُمْ! <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />آمَا الرَّبْ وْقِفْ مْعَايَا وقَوَّانِي، بَاشْ نَجِّمْتْ نْوَصِّلْ البْشَارَة ويِسْمْعُوهَا الشُّعُوبْ الكُلْ، ومَنَّعْنِي مِنْ فُمْ الصِّيدْ، <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />والرَّبْ بِشْ يْنَجِّينِي مِنْ كُلْ شَرْ، ويَحْفِظْنِي لْمَمْلَكْتُو الِّي فِي السْمَاء. لِيهْ المَجْدْ لِلْأَبَدْ. آمِينْ.<verse eid="2TI 4:18" /></para>
  <para style="s">سْلَامْ</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />سَلِّمْ عْلَى بْرِيسْكِلَّا وأَكِيلَا وعْلَى عَايِلْةْ أُونِيسِفُورُسْ. <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" />أَرَسْطُوسْ بْقَى فِي كُورِنْثُوسْ، وتُرُوفِيمُسْ خَلِّيتُو فِي مِيلِيتُسْ عْلَى خَاطْرُو مْرِيضْ. <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />إِيجَانِي فِيسَعْ قْبَلْ مَا يْجِي الشْتَاء. يْسَلِّمْ عْلِيكْ إِيُوبُولُسْ وبُودِيسْ ولِينُسْ وكْلُودْيَة والإِخْوَة الكُلْ. <verse eid="2TI 4:21" /><verse number="22" style="v" sid="2TI 4:22" />الرَّبْ يْكُونْ مْعَاكْ. والنِّعْمَة تْكُونْ مْعَاكُمْ.<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>