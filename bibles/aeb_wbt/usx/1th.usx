<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TH" style="id" />
  <para style="h">تْسَالُونِيكِي الأُولَى</para>
  <para style="toc1">رِسَالِةْ بُولِسْ الأُولَى لِلْمُؤْمْنِينْ الِّي فِي تْسَالُونِيكِي</para>
  <para style="toc2">تْسَالُونِيكِي الأُولَى</para>
  <para style="toc3">تْسَالُونِيكِي الأُولَى</para>
  <para style="mt">رِسَالِةْ بُولِسْ الأُولَى لِلْمُؤْمْنِينْ الِّي فِي تْسَالُونِيكِي</para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />مِنْ بُولِسْ وسِلْوَانُسْ وتِيمُوثَاوُسْ لْكِنِيسِةْ تْسَالُونِيكِي التَّابْعَة لِلَّهْ الآبْ ولِلرَّبْ يَسُوعْ المَسِيحْ.</para>
  <para style="p" vid="1TH 1:1">لِيكُمْ النِّعْمَة والسَّلَامْ مِنْ عَنْدْ اللَّهْ بُونَا والرَّبْ يَسُوعْ المَسِيحْ.<verse eid="1TH 1:1" /></para>
  <para style="s">الشُّكْرْ عْلَى إِيمَانْ المُؤْمْنِينْ فِي تْسَالُونِيكِي</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />نُشْكْرُوا اللَّهْ فِي كُلْ وَقْتْ عْلَى خَاطِرْكُمْ الكُلْ، ودِيمَا نِتْفَكْرُوكُمْ فِي صْلَاتْنَا، <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />عْلَى خَاطِرْنَا نِتْذَكْرُوا قُدَّامْ إِلَاهْنَا وبُونَا كِيفَاشْ أَعْمَالْكُمْ تْظَهِّرْ إِيمَانْكُمْ، وجِهَادْكُمْ يْظَهِّرْ مْحَبِّتْكُمْ، وصَبْرْكُمْ يْظَهِّرْ رْجَاكُمْ فِي رَبْنَا يَسُوعْ المَسِيحْ.<verse eid="1TH 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 1:4" />نَعْرْفُوا، يَا خْوَاتْنَا المَحْبُوبِينْ، إِنُّو اللَّهْ هُوَّ الِّي اخْتَارْكُمْ، <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />عْلَى خَاطِرْ وَقْتِلِّي بَشَّرْنَاكُمْ، تَبْشِيرْنَا مَا كَانِشْ بِالكْلَامْ أَكَهَوْ، آمَا بْقُوَّة وبِالرُّوحْ القُدُسْ وبِإِقْتِنَاعْ، وإِنْتُومَا تَعْرْفُوا إِنُّو وَقْتِلِّي كُنَّا عَنْدْكُمْ تَصَرَّفْنَا بِلِّي فِيهْ الخِيْرْ لِيكُمْ. <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" />وإِنْتُومَا خْذِيتُونَا أَحْنَا والرَّبْ يَسُوعْ مِثَالْ لِيكُمْ، وقْبِلْتُوا كِلْمِةْ اللَّهْ بْفَرْحِةْ الرُّوحْ القُدُسْ رَغْمِلِّي كُنْتُوا تْعَانِيوْ بَرْشَة. <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />وهَكَّا وَلِّيتُوا مِثَالْ لِلْمُؤْمْنِينْ الكُلْ الِّي فِي مَنْطَقْةْ مَقْدُونِيَّة ومَنْطَقْةْ أَخَائِيَة، <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />عْلَى خَاطِرْكُمْ نْشَرْتُوا كِلْمِةْ الرَّبْ مُشْ فِي مَقْدُونِيَّة وأَخَائِيَة أَكَهَوْ، آمَا خْبَرْ إِيمَانْكُمْ بِاللَّهْ تِعْرَفْ فِي البْلَايِصْ الكُلْ لِلِّي مَا عَادْ عَنَّا شَيْ نَحْكِيوِهْ عْلِيهْ. <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />وهُومَا يَحْكِيوْ كِيفَاشْ قْبِلْتُونَا كِي جِينَاكُمْ، وكِيفَاشْ عْرَفْتُوا اللَّهْ وكِيفَاشْ بْعِدْتُوا عَالصْنَبْ بَاشْ تِعْبْدُوا اللَّهْ الحَيْ الحَقِيقِي، <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />وكِيفَاشْ إِنْتُومَا تِسْتَنَّاوْ بَاشْ يْجِي مِالسْمَاء إِبْنُو الِّي قَوْمُو مِالمُوتْ، يَسُوعْ الِّي يْنَجِّينَا مِالغَضَبْ الِّي بِشْ يْجِي.<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="s">تَوْصِيلْ البْشَارَة فِي تْسَالُونِيكِي</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />وتَعْرْفُوا، يَا خْوَاتِي، الِّي زْيَارِتْنَا لِيكُمْ مَا كَانِتْشْ بْلَا فَايْدَة، <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" />وكِيمَا تَعْرْفُوا أَحْنَا تْعَذَّبْنَا وتْهِنَّا فِي فِيلِپِّي، ورَغْمِلِّي النَّاسْ عَارْضُونَا، اللَّهْ عْطَانَا الشَّجَاعَة بَاشْ نْوَصْلُولْكُمْ البْشَارَة.<verse eid="1TH 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TH 2:3" />وتَبْشِيرْنَا مَا كَانِشْ فِيهْ غْلَطْ وَلَّا نِيَّة خَايْبَة وَلَّا غَشَّة، <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />آمَا اللَّهْ بَعْدْمَا جَرَّبْنَا، أَمَّنَّا عَالبْشَارَة، وأَحْنَا نْبَشْرُوا مُشْ بَاشْ نْرَضِّيوْ النَّاسْ، آمَا بَاشْ نْرَضِّيوْ اللَّهْ الِّي يَعْرِفْ قْلُوبْنَا. <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />وهُوَّ شَاهِدْ عْلِينَا، وإِنْتُومَا تَعْرْفُوا إِنُّو مَا نَافَقْنَاكُمِشْ بِكْلَامْ حْلُوْ، ولَا طْمَعْنَا فِيكُمْ. <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />ومَا طْلَبْنَاشْ المَجْدْ مِالنَّاسْ، لَا مِنْكُمْ ولَا مِنْ غِيرْكُمْ، <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" />رَغْمِلِّي كَانْ عَنَّا الحَقْ بَاشْ نُفْرْضُوا سُلْطِتْنَا عْلِيكُمْ بْصِيفِتْنَا رُسُلْ المَسِيحْ. آمَا أَحْنَا كُنَّا حْنَانْ عْلِيكُمْ كِيمَا الأُمْ مْعَ وْلَادْهَا، <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />وحَبِّينَاكُمْ لْدَرْجِةْ إِنُّو تْمَنِّينَا نَعْطِيوْكُمْ مُشْ كَانْ بْشَارِةْ اللَّهْ أَكَهَوْ آمَا حْيَاتْنَا زَادَا، عْلَى قَدْ مَا وَلِّيتُوا عْزَازْ عْلِينَا. <verse eid="1TH 2:8" /><verse number="9" style="v" sid="1TH 2:9" />إِنْتُومَا تِتْذَكْرُوا يَا خْوَاتِي، تْعَبْنَا وشْقَانَا، وَقْتِلِّي كُنَّا نْوَصْلُولْكُمْ فِي بْشَارِةْ اللَّهْ، وكِيفَاشْ كُنَّا نِخْدْمُوا نْهَارْ ولِيلْ بَاشْ مَا نْثَقْلُوا عْلَى حَتَّى حَدْ فِيكُمْ.<verse eid="1TH 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 2:10" />وإِنْتُومَا شَاهْدِينْ واللَّهْ زَادَا كِيفَاشْ كُنَّا نِتْصَرْفُوا بِطْهَارَة وتَقْوَى وَقْتِلِّي كُنَّا مْعَاكُمْ إِنْتُومَا المُؤْمْنِينْ، ومَا كَانِشْ عْلِينَا لُومْ. <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />وتَعْرْفُوا زَادَا كِيفَاشْ عَامِلْنَا كُلْ وَاحِدْ فِيكُمْ كِيفْ مَا يْعَامِلْ البُو وِلْدُو، <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />وكِيفَاشْ نْصَحْنَاكُمْ وشَجَّعْنَاكُمْ وأَكَّدْنَا عْلِيكُمْ إِنْكُمْ تْعِيشُوا عِيشَة تْلِيقْ بِاللَّهْ الِّي دْعَاكُمْ بَاشْ تُدْخْلُوا لْمَمْلِكْتُو وتْشَارْكُوهْ فِي مَجْدُو.<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />ودِيمَا نِحْمْدُوا اللَّهْ، عْلَى خَاطِرْ وَقْتِلِّي سْمَعْتُوا البْشَارَة الِّي وَصَّلْنَاهَالْكُمْ، قْبِلْتُوهَا مُشْ عْلَى إِنْهَا كْلَامْ بَشَرْ، آمَا كِيمَا هِيَّ فِي الحْقِيقَة: كْلَامْ اللَّهْ الِّي يِخْدِمْ فِي قْلُوبْكُمْ إِنْتُومَا المُؤْمْنِينْ. <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" />وإِنْتُومَا يَا خْوَاتِي، خْذِيتُوا كَنَايِسْ اللَّهْ التَّابْعِينْ لْيَسُوعْ المَسِيحْ فِي مَنْطَقْةْ اليَهُودِيَّة مِثَالْ لِيكُمْ، عْلَى خَاطِرْ شَعْبْكُمْ عَذَّبْكُمْ كِيفْ مَا هُومَا عَذْبُوهُمْ اليْهُودْ <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" />الِّي قَتْلُوا الرَّبْ يَسُوعْ والأَنْبِيَاءْ وإِضْطَهْدُونَا أَحْنَا زَادَا، وعَادَاوْ النَّاسْ الكُلْ وعْمُرْهُمْ مَا رَضَّاوْ اللَّهْ. <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />وهُومَا يِحِبُّوا يَمْنْعُونَا مِنْ تَوْصِيلْ البْشَارَة الِّي تْنَجِّي لِلِّي مَاهُمْشْ يْهُودْ، وهَكَّا فَاتُوا الحْدُودْ بِذْنُوبْهُمْ، وفِي الإِخِّرْ هْبِطْ عْلِيهُمْ غَضَبْ اللَّهْ.<verse eid="1TH 2:16" /></para>
  <para style="s">بُولِسْ مُتْشَوَّقْ يْزُورْهُمْ</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />وأَحْنَا يَا خْوَاتِي، دُوبْ مَا تْفَارِقْنَا عْلِيكُمْ مُدَّة قْصِيرَة تْوَحَّشْنَاكُمْ وحَبِّينَا نْشُوفُوكُمْ، رَغْمِلِّي كُنْتُوا بْعَادْ عْلَى عِينِينَا مُشْ بْعَادْ عْلَى قْلُوبْنَا. <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />هَاذَاكَا عْلَاشْ حَبِّينَا نْجِيوْكُمْ، وبِالأَخَصْ آنَا بُولِسْ، حَاوِلْتْ أَكْثِرْ مِنْ مَرَّة آمَا الشِّيطَانْ عَطَّلْنَا. <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />شْكُونْ بَاشْ يْكُونْ رْجَانَا وفَرْحِتْنَا والتَّاجْ الِّي نِتْفَخْرُوا بِيهْ قُدَّامْ رَبْنَا يَسُوعْ نْهَارِةْ الِّي يِرْجَعْ؟ يَاخِي مُشْ إِنْتُومَا؟ <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />بِالحَقْ، إِنْتُومَا مَجْدْنَا وفَرْحِتْنَا.<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="s">بُولِسْ يِبْعَثْ تِيمُوثَاوُسْ لْتْسَالُونِيكِي</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />ووَقْتِلِّي مَا عَادِشْ انَّجْمُوا نُصْبْرُوا، قَرَّرْنَا بِشْ نَبْقَاوْ وَحَّدْنَا فِي أَثِينَا، <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />وبْعَثْنَا تِيمُوثَاوُسْ خُونَا وشْرِيكْنَا فِي خِدْمِةْ اللَّهْ وتَوْصِيلْ بْشَارِةْ المَسِيحْ، بَاشْ يْشَجَّعْكُمْ ويْقَوِّيكُمْ فِي إِيمَانْكُمْ، <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />بَاشْ حَتَّى وَاحِدْ فِيكُمْ مَا يِتْزَعْزَعْ فِي الأَوْقَاتْ الصْعِيبَة هَاذِي، وإِنْتُومَا تَعْرْفُوا الِّي لَازِمْنَا نِتْعَدَّاوْ بِيهَا. <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />ووَقْتِلِّي كُنَّا بَحْذَاكُمْ قُلْنَالْكُمْ الِّي أَحْنَا بِشْ نْعَانِيوْ، وكِيمَا تَعْرْفُوا، هَاذَاكَا هُوَّ الِّي صَارْ. <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />وهَاذَاكَا عْلَاشْ كِي مَا عَادِشْ انَّجِّمْ نُصْبُرْ، بْعَثْتْ نِسْإِلْ عْلَى إِيمَانْكُمْ وخُفْتْ لَا يْكُونْ إِبْلِيسْ غَرْ بِيكُمْ وتْعَبْنَا مْشَى خْسَارَة.<verse eid="1TH 3:5" /></para>
  <para style="s">تِيمُوثَاوُسْ يَعْطِي أَخْبَارْ تْشَجَّعْ</para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6" />وتَوَّا رْجَعْ تِيمُوثَاوُسْ مِنْ عَنْدْكُمْ وبَشَّرْنَا بْإِيمَانْكُمْ ومْحَبِّتْكُمْ وقَالِلْنَا كِيفَاشْ دِيمَا تُذْكْرُوا فِينَا بِالخِيرْ وتْوَحَّشْتُوا تْشُوفُونَا كِيمَا أَحْنَا تْوَحَّشْنَا نْشُوفُوكُمْ. <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />هَاذَاكَا عْلَاشْ يَا خْوَاتِي إِيمَانْكُمْ شَجَّعْنَا فِي ضِيقْنَا وشِدِّتْنَا، <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />ورَجْعِتْ فِينَا الرُّوحْ عْلَى خَاطِرْكُمْ ثَابْتِينْ فِي الرَّبْ. <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />وقَدْ مَا نُشْكْرُوا اللَّهْ عْلَى خَاطِرْكُمْ وعْلَى خَاطِرْ الفَرْحَة الِّي نْحِسُّوا بِيهَا قُدَّامْ إِلَاهْنَا بِسْبَبْكُمْ، وشْوَيَّة. <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />وأَحْنَا، نْهَارْ ولِيلْ، نُطْلْبُوا مِنُّو ونْعَاوْدُوا بَاشْ انَّجْمُوا نْشُوفُوكُمْ مِنَّا لِيكُمْ، ونْشَجْعُوكُمْ تْزِيدُوا تِكْبْرُوا وتِتْقَدْمُوا فِي إِيمَانْكُمْ. <verse eid="1TH 3:10" /><verse number="11" style="v" sid="1TH 3:11" />ونُطْلْبُوا مِنْ إِلَاهْنَا وبُونَا، ورَبْنَا يَسُوعْ المَسِيحْ يْسَهْلِنَّا الطْرِيقْ بَاشْ نْجِيوْكُمْ، <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />ونُطْلْبُوا إِنُّو الرَّبْ يْزِيدْ مْحَبِّتْكُمْ لِبْعَضْكُمْ ولِلنَّاسْ الكُلْ حَتَّى لِينْ تْفِيضْ، كِيمَا مْحَبِّتْنَا لِيكُمْ، <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />وإِنُّو يْثَبِّتْ قْلُوبْكُمْ فِي القَدَاسَة بَاشْ تْكُونُوا مِنْ غِيرْ لُومْ، قُدَّامْ إِلَاهْنَا وبُونَا، فِي النْهَارْ الِّي يِرْجَعْ فِيهْ رَبْنَا يَسُوعْ مْعَ قِدِّيسِيهْ الكُلْ.<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="s">عِيشُوا حْيَاةْ تْرَضِّي اللَّهْ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />وفِي الإِخِّرْ يَا خْوَاتِي، نُطْلُبُوا مِنْكُمْ ونِتْرَجَّاوْكُمْ بْإِسْمْ الرَّبْ يَسُوعْ، إِنْكُمْ تْعِيشُوا بْمَا يُرْضِي اللَّهْ كِيمَا تْعَلَّمْتُوا مِنَّا، وكِيمَا قَاعْدِينْ تَعْمْلُوا، آمَا نْحِبُّوكُمْ تِتْقَدْمُوا أَكْثِرْ فِي هَاذَا. <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />وإِنْتُومَا تَعْرْفُوا الوْصَايَا الِّي وَصِّينَاكُمْ بِيهَا مِنْ عَنْدْ الرَّبْ يَسُوعْ. <verse eid="1TH 4:2" /><verse number="3" style="v" sid="1TH 4:3" />رَاهُو اللَّهْ يْحِبْكُمْ تِكْبْرُوا فِي القَدَاسَة، وتِبْعْدُوا جِمْلَة عَالزْنَى، <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />ولَازِمْ كُلْ وَاحِدْ فِيكُمْ يَعْرِفْ كِيفَاشْ يِتْحَكِّمْ فِي بَدْنُو بَاشْ يْعِيشْ بْقَدَاسَة وشَرَفْ، <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />ومَا يْخَلِّيشْ الشَهْوَة هِيَّ الِّي تْمَشِّيهْ كِيمَا نَاسْ الشُّعُوبْ الأُخْرِينْ الِّي مَا يَعْرْفُوشْ اللَّهْ، <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />ومَا يِتْعَدَّى حَدْ عْلَى حَقْ خُوهْ وَلَّا يْضُرُّو فِي الحْكَايَة هَاذِي. وكِيمَا قُلْنَالْكُمْ قْبَلْ ونَبَّهْنَاكُمْ، إِنُّو اللَّهْ يَنْتَقِمْ مِلِّي يَعْمْلُوا الأُمُورْ هَاذِي. <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />عْلَى خَاطِرْ اللَّهْ مَا دْعَانَاشْ بَاشْ نْعِيشُوا فِي النْجَاسَة، آمَا دْعَانَا بَاشْ نْعِيشُوا فِي القَدَاسَة. <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />مَالَا أَيْ وَاحِدْ يُرْفُضْ التَّعْلِيمْ هَاذَا، هُوَّ مُشْ يُرْفُضْ فِي إِنْسَانْ، آمَا يُرْفُضْ فِي اللَّهْ الِّي عْطَاكُمْ رُوحُو القُدُّوسْ.<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />ومَاكُمْشْ فِي حَاجَة بَاشْ نِكْتْبُولْكُمْ عَالمْحَبَّة الِّي بِينْ الإِخْوَة، عْلَى خَاطِرْ اللَّهْ عَلَّمْكُمْ كِيفَاشْ تْحِبُّوا بْعَضْكُمْ. <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />وبِالحَقْ إِنْتُومَا تِتْعَامْلُوا بِمْحَبَّة مْعَ الإِخْوَة الكُلْ فِي مَنْطَقْةْ مَقْدُونِيَّة، آمَا نْشَجْعُوكُمْ تْزِيدُوا تْحِبُّوهُمْ أَكْثِرْ وأَكْثِرْ، <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />وتَحْرْصُوا بَاشْ تْعِيشُوا عِيشَة رَايْضَة وتِتْلْهَاوْ فِي رْوَاحْكُمْ وتِخْدْمُوا بِعْرَقْ جْبِينْكُمْ كِيمَا وَصِّينَاكُمْ. <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />وهَكَّا تْكُونْ سِيرِتْكُمْ بَاهْيَة قُدَّامْ المُشْ مُؤْمْنِينْ، ومَا تْكُونُوشْ مُحْتَاجِينْ لْحَتَّى حَدْ.<verse eid="1TH 4:12" /></para>
  <para style="s">قْيَامِةْ المُؤْمْنِينْ الِّي مَاتُوا</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />ونْحِبُّوكُمْ يَا خْوَاتْنَا تَعْرْفُوا شْنُوَّة بِشْ يْصِيرْ مْعَ الِّي مَاتُوا، بَاشْ مَا تَحْزْنُوشْ كِيمَا النَّاسْ الأُخْرِينْ الِّي مَا عَنْدْهُمْشْ رْجَى. <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />مَادَامْنَا نَمْنُوا الِّي يَسُوعْ مَاتْ وقَامْ مِالمُوتْ، نَمْنُوا زَادَا إِنُّو الِّي مَاتُوا وهُومَا مُؤْمْنِينْ بِيهْ، اللَّهْ بِشْ يِجْمَعْهُمْ مْعَ يَسُوعْ. <verse eid="1TH 4:14" /><verse number="15" style="v" sid="1TH 4:15" />ونْقُولُولْكُمْ الِّي قَالُو الرَّبْ بِيدُو: رَانَا أَحْنَا الِّي بِشْ نَبْقَاوْ حَيِّينْ لِينْ يْجِي الرَّبْ مَانَاشْ بِشْ نِسْبْقُوا الِّي مَاتُوا، <verse eid="1TH 4:15" /><verse number="16" style="v" sid="1TH 4:16" />عْلَى خَاطِرْ الرَّبْ بِيدُو بِشْ يْجِي مِالسْمَاء وَقْتِلِّي يِتْسْمَعْ الأَمِرْ وصُوتْ رَئِيسْ المْلَايْكَة وصُوتْ بُوقْ اللَّهْ، ووَقْتْهَا، أَوِّلْ نَاسْ يْقُومُوا هُومَا الِّي مَاتُوا مُؤْمْنِينْ بِالمَسِيحْ، <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />ومْبَعِّدْ أَحْنَا الِّي بْقِينَا حَيِّينْ، نِتْخَطْفُوا مْعَاهُمْ فِي السْحَابْ، بَاشْ نْقَابْلُوا الرَّبْ فِي الهْوَاء، ونْكُونُوا مْعَاهْ لِلْأَبَدْ. <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />مَالَا شَجْعُوا بْعَضْكُمْ بِالكْلَامْ هَاذَا.<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="s">حَضْرُوا رْوَاحْكُمْ لْرْجُوعْ الرَّبْ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />يَا خْوَاتِي، مَاكُمْشْ مِحْتَاجِينْ بَاشْ نِكْتْبِلْكُمْ عَالتْوَارِيخْ والأَوْقَاتْ، <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" />عْلَى خَاطِرْكُمْ تَعْرْفُوا مْلِيحْ الِّي النْهَارْ الِّي يِرْجَعْ فِيهْ الرَّبْ يْجِي عْلَى غَفْلَة كِيفْ مَا يْجِي السَّارِقْ فِي اللِّيلْ. <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />ووَقْتِلِّي يْقُولُوا النَّاسْ: «عَنْدْنَا سَلَامْ وأَمَانْ»، يْجِيهُمْ الهْلَاكْ عْلَى غَفْلَة كِيفْ مَا يْجِي الحِسْ لِلْحِبْلَى، ومَا يْنَجْمُوشْ يَمْنْعُوا. <verse eid="1TH 5:3" /><verse number="4" style="v" sid="1TH 5:4" />آمَا إِنْتُومَا، يَا خْوَاتِي، مَاكُمْشْ فِي الظْلَامْ بَاشْ يْجِيكُمْ النْهَارْ هَاذَاكَا عْلَى غَفْلَة كِيفْ السَّارِقْ، <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />إِنْتُومَا الكُلْ وْلَادْ النُّورْ ووْلَادْ النْهَارْ، أَحْنَا لَانَا مِاللِّيلْ ولَا مِالظْلَامْ. <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />هَاذَاكَا عْلَاشْ مَا يِلْزِمْنَاشْ نُرْقْدُوا كِيفْ النَّاسْ الأُخْرِينْ، آمَا يِلْزِمْنَا نَسْهْرُوا ونُقْعْدُوا صَاحِينْ. <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />عْلَى خَاطِرْ الِّي يُرْقُدْ يُرْقُدْ فِي اللِّيلْ ، ولِّي يِسْكِرْ يِسْكِرْ فِي اللِّيلْ. <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" />آمَا أَحْنَا بِإِعْتِبَارْنَا وْلَادْ النْهَارْ خَلِّينَا نْكُونُوا صَاحِينْ، لَابْسِينْ الإِيمَانْ والمْحَبَّة كِيمَا الدِّرْعْ الِّي يَحْمِي الصْدِرْ، والرْجَى الِّي عَنَّا فِي النْجَاةْ كِيمَا الخَوْذَة الِّي تَحْمِي الرَّاسْ. <verse eid="1TH 5:8" /><verse number="9" style="v" sid="1TH 5:9" />عْلَى خَاطِرْ اللَّهْ مَا اخْتَارْنَاشْ بَاشْ يْهَبِّطْ عْلِينَا الغَضَبْ، آمَا بَاشْ نَاخْذُوا النْجَاةْ عْلَى طْرِيقْ رَبْنَا يَسُوعْ المَسِيحْ، <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />الِّي مَاتْ فِي عُوضْنَا بَاشْ نْعِيشُوا الكُلْ مْعَاهْ، سِوَى كُنَّا حَيِّينْ وَقْتِلِّي يِرْجَعْ وَلَّا مِيْتِينْ. <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />مَالَا شَجْعُوا بْعَضْكُمْ وقَوِّيوْ بْعَضْكُمْ، كِيمَا قَاعْدِينْ تَعْمْلُوا تَوَّا.<verse eid="1TH 5:11" /></para>
  <para style="s">وْصَايَا أُخْرَى</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />ونُطْلُبُوا مِنْكُمْ يَا اخْوِتْنَا بَاشْ تِحْتَرْمُوا الِّي قَاعْدِينْ يِتْعْبُوا بِينَاتْكُمْ، ويُرْشْدُوا فِيكُمْ فِي حْيَاتْكُمْ مْعَ الرَّبْ ويْنَبْهُوا فِيكُمْ، <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />قَدْرُوهُمْ وحِبُّوهُمْ بَرْشَة عْلَى خَاطِرْ الخِدْمَة الِّي يَعْمْلُوا فِيهَا. عِيشُوا فِي سَلَامْ مْعَ بْعَضْكُمْ.<verse eid="1TH 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 5:14" />ونْأَكْدُوا عْلِيكُمْ يَا اخْوِتْنَا، بَاشْ تْنَبْهُوا عَالبُخْلِيِّينْ وتْشَجْعُوا الخَايْفِينْ وتْعَاوْنُوا الضْعَافْ وتُصْبْرُوا عَالنَّاسْ الكُلْ. <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />رُدُّوا بَالْكُمْ بَاشْ حَتَّى حَدْ لَا يْرَجَّعْ عَالشَّرْ بِالشَّرْ، آمَا أَسْعَاوْ دِيمَا بَاشْ تَعْمْلُوا الخِيرْ لِبْعَضْكُمْ ولِلنَّاسْ الكُلْ. <verse eid="1TH 5:15" /><verse number="16" style="v" sid="1TH 5:16" />إِفْرْحُوا دِيمَا، <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />دَاوْمُوا عَالصَّلَاةْ، <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />إِحْمْدُوا اللَّهْ فِي كُلْ الأَحْوَالْ، عْلَى خَاطِرْ هَاذَا آشْ يْحِبْ مِنْكُمْ اللَّهْ بْصِيفِتْكُمْ مُؤْمْنِينْ بْيَسُوعْ المَسِيحْ. <verse eid="1TH 5:18" /><verse number="19" style="v" sid="1TH 5:19" />ومَا تِطْفِيوِشْ الرُّوحْ القُدُسْ، <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />مَا تَحْقْرُوشْ النُّبُوءَاتْ، <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />آمَا إِمْتَحْنُوا كُلْ شَيْ، وشِدُّوا فِي البَاهِي، <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />وإِبْعْدُوا عْلَى كُلْ مَاهُو شَرْ.<verse eid="1TH 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />وإِلَاهْ السَّلَامْ بِيدُو يْخَصَّصْكُمْ لِيهْ بِالكَامِلْ، ويَحْفِظْ رُوحْكُمْ ونَفْسْكُمْ وبْدَنْكُمْ بَاشْ يْكُونُوا بْلَا لُومْ، وَقْتِلِّي يِرْجَعْ رَبْنَا يَسُوعْ المَسِيحْ. <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />عْلَى خَاطِرْ الِّي دْعَاكُمْ أَمِينْ وبِشْ يَعْمِلْ الِّي قَالْ عْلِيهْ.<verse eid="1TH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />يَا خْوَاتِي، إِدْعِيوْلْنَا. <verse eid="1TH 5:25" /><verse number="26" style="v" sid="1TH 5:26" />سَلْمُوا عَالإِخْوَة الكُلْ بْبُوسَةْ طَاهْرَة. <verse eid="1TH 5:26" /><verse number="27" style="v" sid="1TH 5:27" />ونْوَصِّيكُمْ قُدَّامْ الرَّبْ بَاشْ تَقْرَاوْ الرِّسَالَة هَاذِي لِلإِخْوَة الكُلْ. <verse eid="1TH 5:27" /><verse number="28" style="v" sid="1TH 5:28" />ونِعْمِةْ رَبْنَا يَسُوعْ المَسِيحْ تْكُونْ مْعَاكُمْ.<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>