<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ROM" style="id" />
  <para style="h">رُومَا</para>
  <para style="toc1">رِسَالِةْ بُولِسْ لِلْمُؤْمْنِينْ الِّي فِي رُومَا</para>
  <para style="toc2">رُومَا</para>
  <para style="toc3">رُومَا</para>
  <para style="mt">رِسَالِةْ بُولِسْ لِلْمُؤْمْنِينْ الِّي فِي رُومَا</para>
  <chapter number="1" style="c" sid="ROM 1" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1" />مِنْ بُولِسْ عَبْدْ يَسُوعْ المَسِيحْ، الِّي دْعَاهْ اللَّهْ بَاشْ يْكُونْ رَسُولْ، واخْتَارُو بَاشْ يْخَبِّرْ بِالبْشَارَة مْتَاعُو، <verse eid="ROM 1:1" /><verse number="2" style="v" sid="ROM 1:2" />الِّي سْبَقْ ووْعِدْ بِيهَا عْلَى طْرِيقْ أَنْبِيَاؤُو فِي الكْتُبْ المُقَدْسَة، <verse eid="ROM 1:2" /><verse number="3" style="v" sid="ROM 1:3" />ولِّي تْخُصْ إِبْنُو الِّي مِنْ شِيرْتُو كَإِنْسَانْ، جَاء مِنْ ذُرِّيِّةْ دَاوِدْ، <verse eid="ROM 1:3" /><verse number="4" style="v" sid="ROM 1:4" />آمَا مِنْ شِيرِةْ رُوحْ القَدَاسَة، بَيِّنْ اللَّهْ بْقُوَّة الِّي هُوَّ إِبْنُو، وَقْتِلِّي قَيْمُو مِنْ بِينْ الأَمْوَاتْ. هُوَّ رَبْنَا يَسُوعْ المَسِيحْ، <verse eid="ROM 1:4" /><verse number="5" style="v" sid="ROM 1:5" />الِّي بِيهْ، ولْمَجْدْ إِسْمُو، خْذِيتْ نِعْمَة بَاشْ نْكُونْ رَسُولْ ونِدْعِي النَّاسْ مِالشُّعُوبْ الكُلْ لْطَاعِةْ اللَّهْ بِالإِيمَانْ. <verse eid="ROM 1:5" /><verse number="6" style="v" sid="ROM 1:6" />وإِنْتُومَا زَادَا مِنْهُمْ مَادَامْ اللَّهْ دْعَاكُمْ بَاشْ تْوَلِّيوْ تَابْعِينْ لْيَسُوعْ المَسِيحْ.<verse eid="ROM 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7" />نِكْتِبْ لِلْمُؤْمْنِينْ الكُلْ المَوْجُودِينْ فِي رُومَا، الِّي هُومَا شَعْبْ اللَّهْ الِّي يْحِبُّو، والمَدْعُوِّينْ بَاشْ يْكُونُوا قِدِّيسِينْ، النِّعْمَة والسَّلَامْ لِيكُمْ مِنْ عَنْدْ اللَّهْ بُونَا ومِنْ عَنْدْ الرَّبْ يَسُوعْ المَسِيحْ.<verse eid="ROM 1:7" /></para>
  <para style="s">بُولِسْ يْحِبْ يْزُورْ المُؤْمْنِينْ الِّي فِي رُومَا</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8" />قْبَلْ كُلْ شَيْ، نُشْكُرْ إِلَاهِي بْإِسْمْ يَسُوعْ المَسِيحْ عْلَى خَاطِرْكُمْ الكُلْ، وعْلَى خَاطِرْ إِيمَانْكُمْ الِّي سْمَعْ بِيهْ العَالِمْ الكُلْ. <verse eid="ROM 1:8" /><verse number="9" style="v" sid="ROM 1:9" />واللَّهْ الِّي نِخْدِمْ فِيهْ مِنْ كُلْ قَلْبِي ونْبَشِّرْ بِبْشَارِةْ إِبْنُو، يِشْهِدْ الِّي دِيمَا نُذْكُرْكُمْ قُدَّامُو، <verse eid="ROM 1:9" /><verse number="10" style="v" sid="ROM 1:10" />ودِيمَا نُطْلُبْ مِنُّو فِي صْلَاتِي إِنُّو بْقُدْرْتُو يْسَهَّلِّي فِي فُرْصَة بَاشْ نْجِي نْطُلْ عْلِيكُمْ، <verse eid="ROM 1:10" /><verse number="11" style="v" sid="ROM 1:11" />عْلَى خَاطِرْنِي مِتْوَحَّشْكُمْ، ونْحِبْ نَعْطِيكُمْ بَرْكَة رُوحِيَّة تْقَوِّيكُمْ، <verse eid="ROM 1:11" /><verse number="12" style="v" sid="ROM 1:12" />بَاشْ نْشَجْعُوا بْعَضْنَا بِالإِيمَانْ الِّي نِتْشَارْكُوا فِيهْ، الِّي هُوَّ إِيمَانْكُمْ وإِيمَانِي.<verse eid="ROM 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 1:13" />ونْحِبْكُمْ تَعْرْفُوا، يَا خْوَاتِي، الِّي آنَا حَاوِلْتْ بَرْشَة مَرَّاتْ بَاشْ نْجِيكُمْ، بَاشْ يْكُونْ عَنْدِي ثْمَرْ فِي وِسْطْكُمْ كِيمَا فِي وِسْطْ الشُّعُوبْ الأُخْرِينْ الكُلْ، آمَا حَتَّى لْتَوَّا بَرْشَة حَاجَاتْ مَانْعِتْنِي. <verse eid="ROM 1:13" /><verse number="14" style="v" sid="ROM 1:14" />عَنْدِي وَاجِبْ بَاشْ نْبَشِّرْ الشُّعُوبْ الكُلْ: المِتْمَدْنِينْ ولِّي مُشْ مِتْمَدْنِينْ، المِتْعَلْمِينْ ولِّي مُشْ قَارِينْ، <verse eid="ROM 1:14" /><verse number="15" style="v" sid="ROM 1:15" />هَاذَاكَا عْلَاشْ مِتْشَوَّقْ بَرْشَة بَاشْ نْبَشِّرْكُمْ إِنْتُومَا زَادَا الِّي فِي رُومَا.<verse eid="ROM 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16" />آنَا مَا نِحْشِمْشْ بِبْشَارِةْ المَسِيحْ، عْلَى خَاطِرْهَا قُوِّةْ اللَّهْ الِّي تْنَجِّي كُلْ وَاحِدْ يَمِّنْ بِيهَا، اليْهُودْ فِي الأُوِّلْ ومْبَعِّدْ الِّي مَاهُمْشْ يْهُودْ، <verse eid="ROM 1:16" /><verse number="17" style="v" sid="ROM 1:17" />عْلَى خَاطِرْ فِيهَا يْوَرِّينَا اللَّهْ كِيفَاشْ يْرُدْ الإِنْسَانْ صَالَحْ قُدَّامُو: وهَاذَا عْلَى أَسَاسْ الإِيمَانْ وبِالإِيمَانْ وَحْدُو، كِيمَا هُوَّ مَكْتُوبْ: «الصَّالَحْ يَحْيَا بِالإِيمَانْ».<verse eid="ROM 1:17" /></para>
  <para style="s">اللَّهْ غَاضِبْ عْلَى فْسَادْ وشَرْ النَّاسْ</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18" />اللَّهْ وَرَّى مِالسْمَاء قَدَّاشْ هُوَّ غَاضِبْ عْلَى فْسَادْ وشَرْ النَّاسْ، الِّي بِفْسَادْهُمْ مَا يْخَلِّيوِشْ الحْقِيقَة تُظْهُرْ.<verse eid="ROM 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 1:19" />عْلَى خَاطِرْ الِّي يْنَجْمُوا يَعْرْفُوهْ عْلَى اللَّهْ وَاضْحِلْهُمْ. اللَّهْ بِيدُو وَضَّحْهُولْهُمْ. <verse eid="ROM 1:19" /><verse number="20" style="v" sid="ROM 1:20" />ومِلِّي تْخَلْقِتْ الدِّنْيَا صِفَاتْ اللَّهْ الِّي مَا تِتْشَافِشْ، قُدْرْتُو الأَبَدِيَّة وطَبِيعْتُو الإِلَهِيَّة، ظَاهْرِينْ فِي مَخْلُوقَاتُو. هَاذَاكَا عْلَاشْ النَّاسْ مَا عَنْدْهُمْ حَتَّى عُذْرْ. <verse eid="ROM 1:20" /><verse number="21" style="v" sid="ROM 1:21" />رَغْمِلِّي عَرْفُوا اللَّهْ، مَا مَجْدُوهِشْ ومَا شُكْرُوهِشْ بِٱعْتِبَارُو اللَّهْ. بِالعَكْسْ، زَادْ فْسِدْ تَفْكِيرْهُمْ وظْلَامِتْ قْلُوبْهُمْ مِنْ قِلِّةْ الفَهْمْ. <verse eid="ROM 1:21" /><verse number="22" style="v" sid="ROM 1:22" />حَاسْبِينْ رْوَاحْهُمْ حُكَمَاءْ، يَاخِي وَلَّاوْ فِي الحْقِيقَة جُهَّالْ. <verse eid="ROM 1:22" /><verse number="23" style="v" sid="ROM 1:23" />وفِي عُوضْ مَا يِعْبْدُوا إِلَاهْ المَجْدْ الِّي مَا يِفْنَاشْ، عِبْدُوا أَصْنَامْ تْشَبَّهْ لِلْإِنْسَانْ الفَانِي ولِلطْيُورْ ولِلْحَيَوَانَاتْ الِّي تِمْشِي ولِّي تَزْحِفْ.<verse eid="ROM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24" />هَاذَاكَا عْلَاشْ سَلَّمْهُمْ اللَّهْ لْشَهْوِةْ قْلُوبْهُمْ، لِلْفْسَادْ الِّي نَجْسُوا بِيهْ بْدَنَّاتْهُمْ مَا بِينْ بْعَضْهُمْ. <verse eid="ROM 1:24" /><verse number="25" style="v" sid="ROM 1:25" />بَدْلُوا حَقْ اللَّهْ بِالكِذْبْ، وعِبْدُوا المَخْلُوقْ وخِدْمُوهْ فِي بْلَاصِةْ الخَالِقْ الِّي هُوَّ مُبَارَكْ لِلْأَبَدْ. آمِينْ.<verse eid="ROM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26" />هَاذَاكَا عْلَاشْ سَلَّمْهُمْ اللَّهْ لِلشْهَاوِي الِّي تَعْمِلْ العَارْ. وَلَّاوْ نْسَاهُمْ يُرْقْدُوا مْعَ بْعَضْهُمْ بْعَكْسْ الطَّبِيعَة. <verse eid="ROM 1:26" /><verse number="27" style="v" sid="ROM 1:27" />والرْجَالْ زَادَا بَطْلُوا العَلَاقَاتْ العَادِيَّة مْعَ النْسَاء وهَاجِتْ شَهْوِتْهُمْ لِبْعَضْهُمْ. وعَمْلُوا الِّي مَا يِتْعْمَلْشْ كِي رَقْدُوا رْجَالْ مْعَ رْجَالْ، وهَكَّا خْذَاوْ العِقَابْ الِّي يِسْتْحَقُّوهْ عْلَى فْسَادْهُمْ.<verse eid="ROM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28" />ومَادَامْهُمْ مَا حَبُّوشْ يَعْرْفُوا اللَّهْ، سَلَّمْهُمْ لْتَفْكِيرْهُمْ الفَاسِدْ بَاشْ يَعْمْلُوا الِّي مَا يِتْعْمَلْشْ. <verse eid="ROM 1:28" /><verse number="29" style="v" sid="ROM 1:29" />وَلَّاوْ مِلْيَانِينْ بْكُلْ أَنْوَاعْ الفْسَادْ والشَّرْ والطْمَعْ والنْجَاسَة، ومِلْيَانِينْ بِالحُسْدْ والقَتْلْ والعَرْكْ والغَشَّة والخْبَاثَة. ولَاهِينْ بِالقِيلْ والقَالْ، <verse eid="ROM 1:29" /><verse number="30" style="v" sid="ROM 1:30" />يْقَطْعُوا ويْرَيْشُوا فِي بْعَضْهُمْ، يِكْرْهُوا اللَّهْ، يْعَايْرُوا النَّاسْ، مِتْكَبْرِينْ، مِتْفَاخْرِينْ، مُتْفَنِّينْ فِي الشَّرْ، عَاصِينْ وَالْدِيهُمْ، <verse eid="ROM 1:30" /><verse number="31" style="v" sid="ROM 1:31" />لَا عَنْدْهُمْ فَهْمْ ولَا أَمَانَة ولَا حَنَانْ ولَا رَحْمَة. <verse eid="ROM 1:31" /><verse number="32" style="v" sid="ROM 1:32" />هُومَا يَعْرْفُوا الِّي اللَّهْ حْكُمْ بِالمُوتْ عَلِّي يَعْمْلُوا الحَاجَاتْ هَاذُومَا. ورَغْمْ هَاذَا، مُشْ يَعْمْلُوهَا بَرْكْ، آمَا يْزِيدُوا يِفْرْحُوا بِالنَّاسْ الِّي يَعْمْلُوهَا.<verse eid="ROM 1:32" /></para>
  <chapter eid="ROM 1" />
  <chapter number="2" style="c" sid="ROM 2" />
  <para style="s">حُكْمْ اللَّهْ العَادِلْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1" />هَاذَاكَا عْلَاشْ مَا عَنْدِكْ حَتَّى عُذْرْ يَا إِنْسَانْ، يَلِّي تُحْكُمْ عَالنَّاسْ الأُخْرِينْ وإِنْتِ تَعْمِلْ فِي نَفْسْ العْمَايِلْ. عْلَى خَاطِرْ، كِي تُحْكُمْ عْلِيهُمْ، إِنْتِ تُحْكُمْ عْلَى رُوحِكْ زَادَا. <verse eid="ROM 2:1" /><verse number="2" style="v" sid="ROM 2:2" />وأَحْنَا نَعْرْفُوا الِّي اللَّهْ يُحْكُمْ بِالعَدْلْ عَالنَّاسْ الِّي يَعْمْلُوا الحَاجَاتْ هَاذِيكَا. <verse eid="ROM 2:2" /><verse number="3" style="v" sid="ROM 2:3" />وإِنْتِ يَلِّي قَاعِدْ تُحْكُمْ عَالنَّاسْ الِّي يَعْمْلُوا الحَاجَاتْ هَاذِيكَا، وإِنْتِ بِيدِكْ تَعْمِلْ فِيهَا، يَاخِي مَاشِي فِي بَالِكْ بِشْ تَمْنَعْ مِنْ حُكْمْ اللَّهْ؟ <verse eid="ROM 2:3" /><verse number="4" style="v" sid="ROM 2:4" />وَلَّا مَاكِشْ عَاطِي قِيمَة لْطِيبْتُو ووِسْعْ بَالُو وصَبْرُو؟ يَاخِي مَا تَعْرَفْشْ الِّي القَصْدْ مِنْ طِيبْتُو هُوَّ إِنِّكْ إِتُّوبْ؟<verse eid="ROM 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 2:5" />آمَا بِعْنَادِكْ وكْسُوحِيِّةْ قَلْبِكْ، قَاعِدْ تْلِمْ فِي غَضَبْ اللَّهْ عْلِيكْ لِنْهَارْ الحْسَابْ، النْهَارْ الِّي بِشْ يْظَهَّرْ فِيهْ اللَّهْ حُكْمُو العَادِلْ، <verse eid="ROM 2:5" /><verse number="6" style="v" sid="ROM 2:6" />عْلَى خَاطْرُو بِشْ يْحَاسِبْ كُلْ وَاحِدْ حَسْبْ أَعْمَالُو. <verse eid="ROM 2:6" /><verse number="7" style="v" sid="ROM 2:7" />ولِّي يِجْتَهْدُوا فِي فِعْلْ الخِيرْ، ويِسْعَاوْ لِلْمَجْدْ والكَرَامَة والخُلُودْ، بِشْ يَعْطِيهُمْ الحَيَاةْ الأَبَدِيَّة. <verse eid="ROM 2:7" /><verse number="8" style="v" sid="ROM 2:8" />آمَا الِّي يْلَوْجُوا عْلَى مَصْلْحِتْهُمْ الشَّخْصِيَّة، ومَا يِقْبْلُوشْ الحَقْ ويْتَبْعُوا الظُّلْمْ، بِشْ يَسْخِطْهُمْ ويْهَبَّطْ عْلِيهُمْ الغَضَبْ مْتَاعُو. <verse eid="ROM 2:8" /><verse number="9" style="v" sid="ROM 2:9" />وبِشْ يْكُونْ عْذَابْ وشِدَّة لْكُلْ إِنْسَانْ يَعْمِلْ الشَّرْ، لِليْهُودِي فِي الأُوِّلْ ومْبَعِّدْ لِلِّي مُشْ يْهُودِي، <verse eid="ROM 2:9" /><verse number="10" style="v" sid="ROM 2:10" />ويَعْطِي مَجْدْ وكَرَامَة وسَلَامْ لْكُلْ وَاحِدْ يَعْمِلْ الخِيرْ، لِلْيْهُودِي فِي الأُوِّلْ ومْبَعِّدْ لِلِّي مُشْ يْهُودِي. <verse eid="ROM 2:10" /><verse number="11" style="v" sid="ROM 2:11" />رَاهُو اللَّهْ مَا يْمَيِّزْ حَدْ عْلَى حَدْ.<verse eid="ROM 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12" />الِّي عَمْلُوا الذْنُوبْ وهُومَا مَا عَنْدْهُمْشْ شَرِيعِةْ مُوسَى، بِشْ يْمُوتُوا زَادَا مِنْ غِيرْ حُكْمْ الشَّرِيعَة. ولِّي عَمْلُوا الذْنُوبْ وهُومَا عَنْدْهُمْ شَرِيعِةْ مُوسَى، بِشْ يْتَحْكَمْ عْلِيهُمْ بِالشَّرِيعَة. <verse eid="ROM 2:12" /><verse number="13" style="v" sid="ROM 2:13" />عْلَى خَاطِرْ مُشْ الِّي يِسْمْعُوا الشَّرِيعَة هُومَا الِّي يْرُدْهُمْ اللَّهْ صَالْحِينْ، آمَا الِّي يْطَبْقُوهَا. <verse eid="ROM 2:13" /><verse number="14" style="v" sid="ROM 2:14" />النَّاسْ الِّي مَاهُمْشْ يْهُودْ، ولِّي مَا عَنْدْهُمْشْ شَرِيعِةْ مُوسَى، وَقْتِلِّي يَعْمْلُوا بِطْبِيعِتْهُمْ الحَاجَاتْ الِّي تْقُولْ عْلِيهُمْ الشَّرِيعَة، يْكُونُوا شَرِيعَة لِرْوَاحْهُمْ، حَتَّى كَانْ مَا عَنْدْهُمْشْ شَرِيعَة. <verse eid="ROM 2:14" /><verse number="15" style="v" sid="ROM 2:15" />هَاذَا يْبَيِّنْ الِّي قَانُونْ الشَّرِيعَة مَكْتُوبْ فِي قْلُوبْهُمْ، وضَمِيرْهُمْ زَادَا يِشْهِدْ عْلَى هَاذَا، وحَتَّى أَفْكَارْهُمْ مِنْ دَاخِلْ مَرَّة تِتْهِمْهُمْ ومَرَّة إِدَّافَعْ عْلِيهُمْ . <verse eid="ROM 2:15" /><verse number="16" style="v" sid="ROM 2:16" />وكِيمَا بَشِّرْتْكُمْ، بِشْ يُظْهُرْ هَاذَا الكُلْ نْهَارِةْ الِّي يْحَاسِبْ اللَّهْ العْبَادْ عْلَى سْرَايِرْ قْلُوبْهُمْ، بْيَسُوعْ المَسِيحْ.<verse eid="ROM 2:16" /></para>
  <para style="s">اليْهُودْ والشَّرِيعَة</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17" />وإِنْتِ، الِّي تْسَمِّي فِي رُوحِكْ يْهُودِي، ومْعَمِّلْ عَالشَّرِيعَة وتِتْفُوخِرْ بِاللَّهْ، <verse eid="ROM 2:17" /><verse number="18" style="v" sid="ROM 2:18" />وتَعْرِفْ آشْ يْحِبْ اللَّهْ، وتَعْرِفْ تْفَرَّقْ بِينْ البَاهِي والخَايِبْ كِيمَا تْعَلَّمْتْ مِالشَّرِيعَة، <verse eid="ROM 2:18" /><verse number="19" style="v" sid="ROM 2:19" />ووَاثِقْ الِّي إِنْتِ قَايِدْ لِلْعِمْيَانْ، ونُورْ لِلِّي عَايْشِينْ فِي الظْلَامْ <verse eid="ROM 2:19" /><verse number="20" style="v" sid="ROM 2:20" />ولِّي إِنْتِ مُرْشِدْ لِلجُهَّالْ، ومُعَلِّمْ لِلصْغَارْ، ولِّي إِنْتِ عْلَى خَاطِرْ عَنْدِكْ الشَّرِيعَة، وْصِلْتْ لْقِمِّةْ الحَقْ والمَعْرْفَة… <verse eid="ROM 2:20" /><verse number="21" style="v" sid="ROM 2:21" />إِنْتِ، يَلِّي تْعَلَّمْ فِي الأُخْرِينْ، مُشْ كَانْ تْعَلَّمْ رُوحِكْ خِيرْ؟ يَاخِي تْقُولْ مَا تِسْرْقُوشْ وإِنْتِ تِسْرِقْ؟ <verse eid="ROM 2:21" /><verse number="22" style="v" sid="ROM 2:22" />وتْقُولْ مَا تَزْنَاوْشْ وإِنْتِ تَزْنَى؟ وتْقُولْ تِكْرَهْ الصْنَبْ آمَا تِسْرِقْ الهَيْكِلْ؟ <verse eid="ROM 2:22" /><verse number="23" style="v" sid="ROM 2:23" />تِتْفُوخِرْ بِالشَّرِيعَة، وتْهِينْ اللَّهْ كِي تْخَالِفْهَا! <verse eid="ROM 2:23" /><verse number="24" style="v" sid="ROM 2:24" />رَاهُو مَكْتُوبْ: «الِّي مَاهُمْشْ يْهُودْ، كَفْرُوا بْإِسْمْ اللَّهْ بِسْبَبْكُمْ إِنْتُومَا اليْهُودْ».<verse eid="ROM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25" />الطْهُورْ عَنْدُو قِيمَة إِذَا كَانْ اطِّيعْ الشَّرِيعَة، آمَا إِذَا كَانْ تْخَالِفْ الشَّرِيعَة، كِيفِكْ كِيفْ الِّي مُشْ مْطَهِّرْ. <verse eid="ROM 2:25" /><verse number="26" style="v" sid="ROM 2:26" />وإِذَا وَاحِدْ مُشْ مْطَهِّرْ يْطَبَّقْ فْرَايِضْ الشَّرِيعَة، يَاخِي مُشْ بِشْ يِحْسْبُو اللَّهْ كَايِنُّو مْطَهِّرْ؟ <verse eid="ROM 2:26" /><verse number="27" style="v" sid="ROM 2:27" />ولِّي يَعْمِلْ بِالشَّرِيعَة وهُوَّ مُشْ مْطَهِّرْ، بِشْ يُحْكُمْ عْلِيكْ إِنْتِ الِّي تْخَالِفْ الشَّرِيعَة وإِنْتِ عَنْدِكْ الكْتُبْ المُقَدْسَة والطْهُورْ. <verse eid="ROM 2:27" /><verse number="28" style="v" sid="ROM 2:28" />رَاهُو اليْهُودِي الحَقِيقِي، مُشْ الِّي هُوَّ يْهُودِي فِي الظَّاهِرْ، والطْهُورْ الحَقِيقِي مُشْ حَاجَة مِنْ بَرَّة فِي اللْحَمْ، <verse eid="ROM 2:28" /><verse number="29" style="v" sid="ROM 2:29" />آمَا اليْهُودِي الحَقِيقِي هُوَّ اليْهُودِي مِنْ دَاخِلْ، والطْهُورْ الحَقِيقِي هُوَّ طْهُورْ القَلْبْ بِالرُّوحْ مُشْ بِالشَّرِيعَة. هَاذَاكَا هُوَّ الإِنْسَانْ الِّي يَاخِذْ المَدْحْ مِنْ اللَّهْ مُشْ مِالنَّاسْ.<verse eid="ROM 2:29" /></para>
  <chapter eid="ROM 2" />
  <chapter number="3" style="c" sid="ROM 3" />
  <para style="s">مَا فَمَّة حَتَّى حَدْ صَالَحْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1" />مَالَا شْنُوَّة فَضْلْ اليْهُودِي؟ وشْنِيَّة فَايِدْةْ الطْهُورْ؟ <verse eid="ROM 3:1" /><verse number="2" style="v" sid="ROM 3:2" />مِالجِيهَاتْ الكُلْ فَمَّة فَايْدَة. وأَهَمْ وَحْدَة هِيَّ الِّي اللَّهْ إِسْتَأْمِنْ اليْهُودْ عْلَى كْلَامُو. <verse eid="ROM 3:2" /><verse number="3" style="v" sid="ROM 3:3" />وإِذَا كَانْ جْمَاعَة مِنْهُمْ خَانُوا الأَمَانَة، يَاخِي قِلِّةْ أَمَانِتْهُمْ تْبَطِّلْ أَمَانِةْ اللَّهْ؟ <verse eid="ROM 3:3" /><verse number="4" style="v" sid="ROM 3:4" />بِالطْبِيعَة لَا! اللَّهْ صَادِقْ والنَّاسْ الكُلْ تِكْذِبْ. وكِيمَا مَكْتُوبْ:</para>
  <para style="b" vid="ROM 3:4" />
  <para style="q1" vid="ROM 3:4">«يَا اللَّهْ هَكَّا تِثْبِتْ الِّي إِنْتِ صَادَقْ فِي كْلَامِكْ،</para>
  <para style="q2" vid="ROM 3:4">وغَالِبْ وَقْتِلِّي تُحْكُمْ».<verse eid="ROM 3:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5" />آمَا إِذَا كَانْ شَرْنَا يْظَهِّرْ صَلَاحْ اللَّهْ، يَاخِي مَعْقُولْ نْقُولُوا اللَّهْ ظَالِمْ كِي يْعَاقِبْنَا؟ وهْنَا نِتْكَلِّمْ بْمَنْطَقْ البَشَرْ. <verse eid="ROM 3:5" /><verse number="6" style="v" sid="ROM 3:6" />حَاشَاهْ! مَالَا كَانْ هَكَّا، كِيفَاشْ بِشْ يْنَجِّمْ يْحَاسِبْ العَالِمْ؟<verse eid="ROM 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 3:7" />ومُمْكِنْ تْقُولْ: «إِذَا كَانْ كِذْبِي يْزِيدْ يْظَهِّرْ صِدْقْ اللَّهْ ويْمَجْدُو أَكْثِرْ، مَالَا عْلَاشْ يِتْحْكَمْ عْلِيَّا كِيمَا وَاحِدْ مُذْنِبْ؟». <verse eid="ROM 3:7" /><verse number="8" style="v" sid="ROM 3:8" />يَاخِي مُشْ فَمَّة نَاسْ يِتْبَلَّاوْ عْلِينَا، ويِتْهْمُوا فِينَا بِالبَاطِلْ الِّي أَحْنَا نْقُولُوا: «عْلَاشْ مَا نَعْمْلُوشْ الشَّرْ بَاشْ يْجِي مِنُّو الخِيرْ؟». وهَاذُمْ اللَّهْ بِشْ يْحَاسِبْهُمْ.<verse eid="ROM 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9" />شْنُوَّة، مَالَا؟ يَاخِي أَحْنَا اليْهُودْ خِيرْ مِالنَّاسْ الأُخْرِينْ؟ مُسْتَحِيلْ! وآنَا سْبَقْ وْقُلْتِلْكُمْ الِّي اليْهُودْ ولِّي مُشْ يْهُودْ الكُلْهُمْ تَحْتْ سُلْطِةْ الخَطِيئَة. <verse eid="ROM 3:9" /><verse number="10" style="v" sid="ROM 3:10" />وكِيمَا مَكْتُوبْ:</para>
  <para style="b" vid="ROM 3:10" />
  <para style="q1" vid="ROM 3:10">«مَا فَمَّة حَتَّى حَدْ صَالَحْ، ولَا حَتَّى وَاحِدْ،<verse eid="ROM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ROM 3:11" />حَتَّى وَاحِدْ مَا يِفْهِمْ،</para>
  <para style="q2" vid="ROM 3:11">وحَتَّى وَاحِدْ مَا يْلَوِّجْ عْلَى اللَّهْ.<verse eid="ROM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12" />الكُلْهُمْ ضَاعُوا،</para>
  <para style="q2" vid="ROM 3:12">الكُلْهُمْ فِسْدُوا.</para>
  <para style="q1" vid="ROM 3:12">حَتَّى حَدْ مَا يَعْمِلْ فِي الصَّلَاحْ،</para>
  <para style="q2" vid="ROM 3:12">وَلَا وَاحِدْ».<verse eid="ROM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13" />«ڨْرَاجِمْهُمْ كِيفْ القْبُورَاتْ المَحْلُولَة،</para>
  <para style="q2" vid="ROM 3:13">لْسَانَاتْهُمْ خْبِيثَة».</para>
  <para style="q1" vid="ROM 3:13">«وسِمْ الأَفَاعِي فِي شْفَايِفْهُمْ».<verse eid="ROM 3:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="ROM 3:14" />«مَاعَنْدْهُمْ فِي آفَّامْهُمْ كَانْ دْعَاء الشَّرْ والكْلَامْ الِّي يُوجَعْ».<verse eid="ROM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15" />«يِتْجَارَاوْ بَاشْ يُقْتْلُوا العْبَادْ.<verse eid="ROM 3:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="ROM 3:16" />وِينْ يِمْشِيوْ يِخْلِيوْهَا ومَا يْجِي مِنْ وْرَاهُمْ كَانْ الهَّمْ.<verse eid="ROM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17" />طْرِيقْ السَّلَامْ مَا يَعْرْفُوهِشْ».<verse eid="ROM 3:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ROM 3:18" />«ومَا يْخَافُوشْ اللَّهْ».<verse eid="ROM 3:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19" />وأَحْنَا نَعْرْفُوا بِلِّي المَكْتُوبْ فِي الشَّرِيعَة، يْخُصْ النَّاسْ الِّي هُومَا تَحْتْ حُكْمْ الشَّرِيعَة، بَاشْ حَتَّى وَاحِدْ مَا يْنَجِّمْ يِتْكَلِّمْ، ويْكُونْ العَالِمْ الكُلْ تَحْتْ حُكْمْ اللَّهْ. <verse eid="ROM 3:19" /><verse number="20" style="v" sid="ROM 3:20" />عْلَى خَاطِرْ حَتَّى حَدْ مَا يْوَلِّي صَالَحْ قُدَّامْ اللَّهْ بْطَاعْتُو لِلشَّرِيعَة: الشَّرِيعَة تْوِجْدِتْ بَاشْ تِكْشِفْ الذْنُوبْ.<verse eid="ROM 3:20" /></para>
  <para style="s">الصَّلَاحْ هُوَّ بِالإِيمَانْ</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21" />آمَا تَوَّا ظْهُرْ كِيفَاشْ اللَّهْ يْرُدْ الإِنْسَانْ صَالَحْ مِنْ غِيرْ الشَّرِيعَة، كِيمَا شِهْدِتْ التَّوْرَاة وكْتُبْ الأَنْبِيَاءْ. <verse eid="ROM 3:21" /><verse number="22" style="v" sid="ROM 3:22" />اللَّهْ يَعْتْبَرْ الإِنْسَانْ صَالَحْ بْإِيمَانُو بْيَسُوعْ المَسِيحْ. وهَاذَا يِطَّبَّقْ عْلَى النَّاسْ الكُلْ الِّي يَمْنُوا بِيهْ ومَا فَمَّة حَتَّى فَرْقْ بِينَاتْهُمْ، <verse eid="ROM 3:22" /><verse number="23" style="v" sid="ROM 3:23" />خَاطِرْ النَّاسْ الكُلْ عَمْلُوا الذْنُوبْ وتْحِرْمُوا مِنْ مَجْدْ اللَّهْ. <verse eid="ROM 3:23" /><verse number="24" style="v" sid="ROM 3:24" />آمَا اللَّهْ اعْتَبَرْهُمْ صَالْحِينْ بِالنِّعْمَة، وهَاذِي هْدِيَّة مِنْ عَنْدُو عْلَى خَاطِرْ يَسُوعْ المَسِيحْ فْدَاهُمْ. <verse eid="ROM 3:24" /><verse number="25" style="v" sid="ROM 3:25" />اللَّهْ عْطَاهُولْنَا ضْحِيَّة بَاشْ يْكَفِّرْ عْلَى ذْنُوبْنَا بْدَمُو، إِذَا كَانْ أَمَّنَّا بِيهْ. وهَاذَا يْبَيِّنْ إِنُّو اللَّهْ صَالَحْ عْلَى خَاطْرُو صْبَرْ عْلَى ذْنُوبْ النَّاسْ الِّي تْعَمْلِتْ قْبَلْ ومَا عَاقِبْهُمْشْ عْلِيهَا، <verse eid="ROM 3:25" /><verse number="26" style="v" sid="ROM 3:26" />ويْبَيِّنْ زَادَا فِي الوَقْتْ الحَاضِرْ إِنُّو اللَّهْ صَالَحْ عْلَى خَاطِرْ كُلْ وَاحِدْ يَمِّنْ بْيَسُوعْ يَعْتَبْرُو صَالَحْ.<verse eid="ROM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27" />مَالَا بَاشْ يْنَجِّمْ يِتْفُوخِرْ الإِنْسَانْ؟ بْحَتَّى شَيْ! يَاخِي يْنَجِّمْ يِتْفُوخِرْ بْأَعْمَالْ الشَّرِيعَة؟ أَكِيدْ لَا، عْلَى خَاطْرُو وَلَّى صَالَحْ بِالإِيمَانْ، مُشْ بِالأَعْمَالْ. <verse eid="ROM 3:27" /><verse number="28" style="v" sid="ROM 3:28" />والنْتِيجَة الِّي وْصِلْنَالْهَا هِيَّ إِنُّو الإِنْسَانْ يْوَلِّي صَالَحْ بِالإِيمَانْ، مُشْ كِي يْطَبَّقْ فَرَايِضْ الشَّرِيعَة. <verse eid="ROM 3:28" /><verse number="29" style="v" sid="ROM 3:29" />يَاخِي اللَّهْ إِلَاهْ اليْهُودْ أَكَهَوْ؟ مُشْ هُوَّ إِلَاهْ الشُّعُوبْ الأُخْرِينْ زَادَا؟ إِيْ نْعَمْ، هُوَّ إِلَاهْ الشُّعُوبْ الكُلْ. <verse eid="ROM 3:29" /><verse number="30" style="v" sid="ROM 3:30" />مَادَامُو اللَّهْ وَاحِدْ، بِشْ يَعْتَبِرْ اليْهُودْ صَالْحِينْ عْلَى أَسَاسْ إِيمَانْهُمْ، ولِّي مَاهُمْشْ يْهُودْ صَالْحِينْ بْإِيمَانْهُمْ. <verse eid="ROM 3:30" /><verse number="31" style="v" sid="ROM 3:31" />زَعْمَة أَحْنَا قَاعْدِينْ انَّقْصُوا مِنْ قِيمِةْ الشَّرِيعَة كِي نْأَكْدُوا عَالإِيمَانْ؟ بِالعَكْسْ، أَحْنَا نْوَرِّيُو عْلَاشْ الشَّرِيعَة تْوِجْدِتْ.<verse eid="ROM 3:31" /></para>
  <chapter eid="ROM 3" />
  <chapter number="4" style="c" sid="ROM 4" />
  <para style="s">إِيمَانْ إِبْرَاهِيمْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1" />وآشْ نْقُولُوا عْلَى بُونَا إِبْرَاهِيمْ؟ آشْ صَارْ مْعَاهْ؟ <verse eid="ROM 4:1" /><verse number="2" style="v" sid="ROM 4:2" />لَوْ كَانْ اللَّهْ إِعْتَبَرْ إِبْرَاهِيمْ صَالَحْ عْلَى أَسَاسْ أَعْمَالُو، رَاهُو كَانْ عَنْدُو الحَقْ يِتْفُوخِرْ، آمَا مُشْ قُدَّامْ اللَّهْ. <verse eid="ROM 4:2" /><verse number="3" style="v" sid="ROM 4:3" />آشْ تْقُولْ الكْتُبْ المُقَدْسَة؟ «أَمَّنْ إِبْرَاهِيمْ بِاللَّهْ، يَاخِي إِيمَانُو تِحْسِبْلُو صَلَاحْ». <verse eid="ROM 4:3" /><verse number="4" style="v" sid="ROM 4:4" />الِّي يِخْدِمْ خِدْمَة يُخْلُصْ عْلِيهَا، وهَاذَاكَا حَقُّو مُشْ هْدِيَّة. <verse eid="ROM 4:4" /><verse number="5" style="v" sid="ROM 4:5" />آمَا الِّي مَا يِتْوَكِّلْشْ عْلَى أَعْمَالُو ويَمِّنْ بِاللَّهْ الِّي يِغْفِرْ لِلْمُذْنِبْ، إِيمَانُو هَاذَا يِحْسِبْهُولُو اللَّهْ صَلَاحْ. <verse eid="ROM 4:5" /><verse number="6" style="v" sid="ROM 4:6" />وكِيمَا قَالْ دَاوِدْ وهُوَّ يَحْكِي عْلَى فَرْحِةْ النَّاسْ الِّي إِعْتَبْرُهُمْ اللَّهْ صَالْحِينْ بْإِيمَانْهُمْ مُشْ بَأَعْمَالْهُمْ:<verse eid="ROM 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7" />«صَحَّة لِلِّي تْنَحَّاتْ خَطِيئِتْهُمْ</para>
  <para style="q2" vid="ROM 4:7">وتْغَفْرِتْ ذْنُوبْهُمْ.<verse eid="ROM 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8" />صَحَّة لِلِّي مَا يِحْسِبْلُو اللَّهْ</para>
  <para style="q2" vid="ROM 4:8">حَتَّى ذَنْبْ!».<verse eid="ROM 4:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9" />يَاخِي البَرْكَة هَاذِي لِلْيْهُودْ أَكَهَوْ وَلَّا لِلِّي مُشْ يْهُودْ زَادَا؟ وأَحْنَا سْبَقْ وقُلْنَا: رَاهُو اللَّهْ إِعْتَبَرْ إِبْرَاهِيمْ صَالَحْ بِسْبَبْ إِيمَانُو. <verse eid="ROM 4:9" /><verse number="10" style="v" sid="ROM 4:10" />وَقْتَاشْ صَارْ هَاذَا؟ قْبَلْ الطْهُورْ وَلَّا بَعْدُو؟ هَاذَا صَارْ قْبَلْ مَا يْطَهِّرْ. <verse eid="ROM 4:10" /><verse number="11" style="v" sid="ROM 4:11" />إِبْرَاهِيمْ خْذَا الطْهُورْ عَلَامَةْ وبُرْهَانْ الِّي اللَّهْ إِعْتَبْرُو صَالَحْ بِالإِيمَانْ قْبَلْ مَا يْطَهِّرْ، بَاشْ يْوَلِّي هُوَّ بُو النَّاسْ الِّي يَمْنُوا وهُومَا مُشْ مْطَهْرِينْ، وهَكَّا يَعْتَبِرْهُمْ اللَّهْ صَالْحِينْ، <verse eid="ROM 4:11" /><verse number="12" style="v" sid="ROM 4:12" />وزَادَا بُو المْطَهْرِينْ الِّي مَا يْعَمْلُوشْ كَانْ عَالطْهُورْ، آمَا يِمْشِيوْ فِي طْرِيقْ الإِيمَانْ الِّي كَانْ مَاشِي فِيهْ بُونَا إِبْرَاهِيمْ قْبَلْ مَا يْطَهِّرْ.<verse eid="ROM 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13" />وَقْتِلِّي وْعِدْ اللَّهْ إِبْرَاهِيمْ وذِرِّيتُو إِنْهُمْ بِشْ يُورْثُوا العَالِمْ، مَا كَانِشْ هَاذَاكَا عْلَى أَسَاسْ الشَّرِيعَة، آمَا عْلَى أَسَاسْ الصَّلَاحْ الِّي يْجِي بِالإِيمَانْ. <verse eid="ROM 4:13" /><verse number="14" style="v" sid="ROM 4:14" />إِذَا كَانْ الِّي يْطَبْقُو فِي الشَّرِيعَة هُومَا الِّي يُورْثُوا، مَالَا الإِيمَانْ مَا عَنْدُوشْ فَايْدَة والوَعْدْ بَاطِلْ: <verse eid="ROM 4:14" /><verse number="15" style="v" sid="ROM 4:15" />عْلَى خَاطِرْ الشَّرِيعَة تْخَلِّي اللَّهْ يِتْغَشِّشْ ويْعَاقِبْ الِّي يْخَالْفُوهَا، وكَانْ مَا جَاتِشْ فَمَّة شَرِيعَة مَا يْنَجَّمْشْ الوَاحِدْ يْخَالِفْهَا.<verse eid="ROM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16" />هَاذَاكَا عْلَاشْ الوَعْدْ يْجِي بِالإِيمَانْ عْلَى أَسَاسْ النِّعْمَة، بَاشْ يْكُونْ مَضْمُونْ لْذُرِّيِّةْ إِبْرَاهِيمْ الكُلْ، مُشْ لِلِّي عَنْدْهُمْ الشَّرِيعَة أَكَهَوْ، آمَا زَادَا لِلِّي عَنْدْهُمْ إِيمَانْ كِيمَا إِبْرَاهِيمْ. عْلَى خَاطْرُو بُونَا الكُلْ، <verse eid="ROM 4:16" /><verse number="17" style="v" sid="ROM 4:17" />كِيمَا مَكْتُوبْ : «رَدِّيتِكْ بُو لْبَرْشَة شْعُوبْ». هُوَّ بُونَا قُدَّامْ اللَّهْ الِّي أَمَّنْ بِيهْ، ولِّي يْقَيِّمْ المُوتَى، ويْرُدْ الِّي مُشْ مَوْجُودْ مَوْجُودْ.<verse eid="ROM 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 4:18" />وحَتَّى وَقْتِلِّي مَا كَانِشْ فَمَّة رْجَى، إِبْرَاهِيمْ أَمَّنْ وكَانْ عَنْدُو رْجَى، وهَكَّا وَلَّى بُو لْبَرْشَة شْعُوبْ كِيفْ مَا قَالُّو اللَّهْ: «بِشْ تْكُونْ عَنْدِكْ بَرْشَة ذُرِّيَّة». <verse eid="ROM 4:18" /><verse number="19" style="v" sid="ROM 4:19" />ومَا ضْعُفْشْ إِيمَانُو رَغْمِلِّي عُمْرُو كَانْ قْرِيبْ 100 سْنَة، وكَانْ يَعْرِفْ الِّي لَا هُوَّ ولَا مَرْتُو سَارَّة يْنَجْمُوا يْجِيبُوا الصْغَارْ. <verse eid="ROM 4:19" /><verse number="20" style="v" sid="ROM 4:20" />مَا ضْعُفْشْ إِيمَانُو ومَا شَكِّشْ فِي وَعْدْ اللَّهْ، آمَا بِالعَكْسْ، تْقَوَّى بِالإِيمَانْ وعْطَى المَجْدْ لَلَّهْ، <verse eid="ROM 4:20" /><verse number="21" style="v" sid="ROM 4:21" />عْلَى خَاطِرْ كَانْ مِتْأَكِّدْ الِّي اللَّهْ قَادِرْ بَاشْ يْتَمِّمْ وَعْدُو. <verse eid="ROM 4:21" /><verse number="22" style="v" sid="ROM 4:22" />عْلَى خَاطِرْ الإِيمَانْ هَاذَاكَا، إِبْرَاهِيمْ تِحْسِبّْ صَالَحْ.<verse eid="ROM 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 4:23" />وَقْتِلِّي تْقُولْ الكْتُبْ المُقَدْسَة: «إِعْتَبْرُو صَالَحْ» مَا تْقُولِشْ هَاذَا عْلِيهْ هُوَّ وَحْدُو، <verse eid="ROM 4:23" /><verse number="24" style="v" sid="ROM 4:24" />آمَا عْلِينَا أَحْنَا زَادَا. اللَّهْ يَعْتْبَرْنَا صَالْحِينْ، أَحْنَا الِّي نَمْنُوا بِاللَّهْ الِّي قَيِّمْ رَبْنَا يَسُوعْ مِالمُوتْ. <verse eid="ROM 4:24" /><verse number="25" style="v" sid="ROM 4:25" />عْلَى خَاطِرْ اللَّهْ سَلْمُو لِلْمُوتْ بِسْبَبْ ذْنُوبْنَا وقَيْمُو مِالمُوتْ بَاشْ يْرُدْنَا صَالْحِينْ.<verse eid="ROM 4:25" /></para>
  <chapter eid="ROM 4" />
  <chapter number="5" style="c" sid="ROM 5" />
  <para style="s">عَنْدْنَا سَلَامْ وفَرَحْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1" />مَالَا، مَادَامْ اللَّهْ رَدْنَا صَالْحِينْ بِالإِيمَانْ، وَلَّى عَنْدْنَا سَلَامْ مْعَاهْ بْرَبْنَا يَسُوعْ المَسِيحْ، <verse eid="ROM 5:1" /><verse number="2" style="v" sid="ROM 5:2" />وبِيهْ نَجَّمْنَا نُدْخْلُوا بِالإِيمَانْ لِلنِّعْمَة الِّي أَحْنَا فِيهَا تَوَّا، ونِفْرْحُوا الِّي عَنْدْنَا رْجَى، الِّي أَحْنَا بِشْ نْشَارْكُوا فِي مَجْدْ اللَّهْ. <verse eid="ROM 5:2" /><verse number="3" style="v" sid="ROM 5:3" />وأَكْثِرْ مِنْ هَكَّا، نِفْرْحُوا زَادَا فِي أَوْقَاتْ الضِّيقْ، عْلَى خَاطِرْ نَعْرْفُوا الِّي الضِّيقْ يْعَلَّمْنَا الصَّبْرْ. <verse eid="ROM 5:3" /><verse number="4" style="v" sid="ROM 5:4" />والصَّبْرْ يْخَلِّينَا نِتْقَوَّاوْ وَقْتْ المِحْنَة، والقُوَّة هَاذِي تَخْلَقْ فِينَا الرْجَى، <verse eid="ROM 5:4" /><verse number="5" style="v" sid="ROM 5:5" />والرْجَى مَا يْخِيبِشْ عْلَى خَاطِرْ اللَّهْ فَاضْ بِمْحَبْتُو فِي قْلُوبْنَا بِالرُّوحْ القُدُسْ الِّي عْطَاهُولْنَا.<verse eid="ROM 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6" />وفِي الوَاقَعْ، وَقْتِلِّي كُنَّا مَا عَنْدْنَاشْ القُدْرَة بَاشْ إِنَّجِّيوْ رْوَاحْنَا، مَاتْ المَسِيحْ عْلَى خَاطِرْ المُذْنْبِينْ فِي الوَقْتْ الِّي إِخْتَارُو اللَّهْ. <verse eid="ROM 5:6" /><verse number="7" style="v" sid="ROM 5:7" />صْعِيبْ الوَاحِدْ يْمُوتْ عْلَى خَاطِرْ إِنْسَانْ صَالَحْ. مُمْكِنْ الوَاحِدْ يِتْشَجَّعْ ويِفْدِي إِنْسَانْ بَاهِي بَرْشَة، <verse eid="ROM 5:7" /><verse number="8" style="v" sid="ROM 5:8" />آمَا اللَّهْ وَرَّانَا مْحَبْتُو، عْلَى خَاطِرْ وأَحْنَا مَزِّلْنَا مُذْنْبِينْ مَاتْ المَسِيحْ عْلَى خَاطِرْنَا. <verse eid="ROM 5:8" /><verse number="9" style="v" sid="ROM 5:9" />ومَادَامْنَا تَوَّا وَلِّينَا صَالْحِينْ بْدَمُّو، مَالَا أَكِيدْ بِشْ نِنْجَاوْ بِيهْ مِنْ غَضَبْ اللَّهْ. <verse eid="ROM 5:9" /><verse number="10" style="v" sid="ROM 5:10" />وإِذَا كَانْ اللَّهْ، وَقْتِلِّي كُنَّا أَعْدَاؤُو، صَالَحْنَا مْعَاهْ بْمُوتْ إِبْنُو، مَالَا أَكِيدْ، وأَحْنَا تَوَّا مِتْصَالْحِينْ مْعَاهْ، بِشْ نِنْجَاوْ بِحْيَاتُو. <verse eid="ROM 5:10" /><verse number="11" style="v" sid="ROM 5:11" />ومُشْ هَاذَا بَرْكْ، آمَا زَادَا نِفْرْحُوا بِاللَّهْ، عْلَى طْرِيقْ رَبْنَا يَسُوعْ المَسِيحْ الِّي صَالَحْنَا مْعَاهْ.<verse eid="ROM 5:11" /></para>
  <para style="s">الفَرْقْ بِينْ آدَمْ والمَسِيحْ</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12" />هَاذَاكَا عْلَاشْ، كِيمَا دَخْلِتْ الخَطِيئَة لِلدِّنْيَا بْإِنْسَانْ وَاحِدْ، والخَطِيئَة هَاذِي دَخْلِتْ مْعَاهَا المُوتْ، زَادَا وَلَّاوْ النَّاسْ الكُلْ يْمُوتُوا عْلَى خَاطِرْ الكُلْهُمْ عَمْلُوا الذْنُوبْ. <verse eid="ROM 5:12" /><verse number="13" style="v" sid="ROM 5:13" />والخَطِيئَة كَانِتْ مَوْجُودَة فِي العَالِمْ حَتَّى قْبَلْ الشَّرِيعَة، آمَا مَا كَانِتْشْ تِتِّحْسِبْ ضِدْ النَّاسْ، عْلَى خَاطِرْ وَقْتْهَا مَا كَانِتْشْ فَمَّة شَرِيعَة. <verse eid="ROM 5:13" /><verse number="14" style="v" sid="ROM 5:14" />ومْعَ هَاذَا، مِنْ وَقْتْ آدَمْ حَتَّى لْمُوسَى، سَيْطِرْ المُوتْ عَالنَّاسْ الكُلْ، حَتَّى الِّي مَا عَمْلُوشْ خَطِيئَة كِيمَا الِّي عْمَلْهَا آدَمْ. وآدَمْ كَانْ يُرْمُزْ لْشَخْصْ بِشْ يْجِي بَعْدُو.<verse eid="ROM 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 5:15" />آمَا هْدِيِّةْ اللَّهْ لِينَا مُشْ كِيمَا خَطِيئِةْ آدَمْ. إِذَا كَانِتْ البَشَرِيَّة تْمُوتْ نْتِيجِةْ خَطِيئِةْ إِنْسَانْ وَاحِدْ، مَالَا نِعْمِةْ اللَّهْ أَعْظِمْ! عْلَى خَاطْرُو فَاضْ بِيهَا عَالبَشَرِيَّة الكُلْ، وعْطَاهَا هْدِيَّة عْلَى طْرِيقْ إِنْسَانْ وَاحِدْ، الِّي هُوَّ يَسُوعْ المَسِيحْ!<verse eid="ROM 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 5:16" />ونْتِيجِةْ خَطِيئِةْ إِنْسَانْ وَاحِدْ مُشْ كِيمَا نْتِيجِةْ هْدِيِّةْ اللَّهْ. نْتِيجِةْ خَطِيئِةْ إِنْسَانْ وَاحِدْ خَلَّاتْ اللَّهْ يُحْكُمْ عَالنَّاسْ الكُلْ، آمَا هْدِيِّةْ اللَّهْ وَصْلِتْهُمْ لِلصَّلَاحْ حَتَّى بَعْدْمَا عَمْلُوا بَرْشَة ذْنُوبْ. <verse eid="ROM 5:16" /><verse number="17" style="v" sid="ROM 5:17" />إِذَا كَانْ بْخَطِيئِةْ إِنْسَانْ وَاحِدْ سَيْطِرْ المُوتْ عَالنَّاسْ الكُلْ بِسْبَبْ الإِنْسَانْ الوَاحِدْ هَاذَاكَا، مَالَا تَوَّا، الِّي رَدْهُمْ اللَّهْ صَالْحِينْ بْنِعْمْتُو العْظِيمَة، بِشْ يْعِيشُوا ويِمْلْكُوا عْلَى طْرِيقْ إِنْسَانْ وَاحِدْ، الِّي هُوَّ يَسُوعْ المَسِيحْ.<verse eid="ROM 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18" />مَالَا، كِيمَا خَطِيئِةْ إِنْسَانْ وَاحِدْ جَابِتْ المُوتْ لِلنَّاسْ الكُلْ، صَلَاحْ إِنْسَانْ وَاحِدْ جَابْ الصَّلَاحْ الِّي يَعْطِي الحَيَاةْ، لِلنَّاسْ الكُلْ. <verse eid="ROM 5:18" /><verse number="19" style="v" sid="ROM 5:19" />وكِيمَا بْخَطِيئِةْ إِنْسَانْ وَاحِدْ النَّاسْ الكُلْ وَلَّاوْ مُذْنْبِينْ، زَادَا، بْطَاعِة إِنْسَانْ وَاحِدْ بَرْشَة نَاسْ بِشْ يْوَلِّيوْ صَالْحِينْ.<verse eid="ROM 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20" />الشَّرِيعَة جَاتْ بَاشْ تُكْثُرْ المَعْصِيَة، آمَا وِينْ تُكْثُرْ المَعْصْيَة تْزِيدْ تُكْثُرْ النِّعْمَة، <verse eid="ROM 5:20" /><verse number="21" style="v" sid="ROM 5:21" />بَاشْ، كِيمَا سَيْطْرِتْ الخَطِيئَة عَالنَّاسْ الكُلْ بِالمُوتْ، زَادَا تِمْلِكْ النِّعْمَة عَالنَّاسْ الكُلْ بِالصَّلَاحْ، وتَعْطِي الحَيَاةْ الأَبَدِيَّة بْيَسُوعْ المَسِيحْ رَبْنَا.<verse eid="ROM 5:21" /></para>
  <chapter eid="ROM 5" />
  <chapter number="6" style="c" sid="ROM 6" />
  <para style="s">مُوتَى بِالنِّسْبَة لِلذْنُوبْ، وحَيِّينْ لِلَّهْ بْيَسُوعْ المَسِيحْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1" />مَالَا آشْ نْقُولُوا؟ نُقْعْدُوا عَايْشِينْ فِي الذْنُوبْ بَاشْ النِّعْمَة تُكْثُرْ؟ <verse eid="ROM 6:1" /><verse number="2" style="v" sid="ROM 6:2" />حَاشَا! أَحْنَا الِّي مُتْنَا بِالنِّسْبَة لِلذْنُوبْ،كِيفَاشْ نُقْعْدُوا نْعِيشُوا فِيهَا؟ <verse eid="ROM 6:2" /><verse number="3" style="v" sid="ROM 6:3" />يَاخِي مَا تَعْرْفُوشْ الِّي أَحْنَا الكُلْ، وَقْتِلِّي تْعَمِّدْنَا ووَلِّينَا وَاحِدْ مْعَ المَسِيحْ يَسُوعْ، تْعَمِّدْنَا بَاشْ نِتْشَارْكُوا مْعَاهْ فِي مُوتُو؟ <verse eid="ROM 6:3" /><verse number="4" style="v" sid="ROM 6:4" />وكِي تْعَمِّدْنَا، هَاذَا مَعْنَاهْ الِّي أَحْنَا مُتْنَا مْعَاهْ وتِدْفِنَّا مْعَاهْ، بَاشْ، كِيمَا قَامْ المَسِيحْ مِالمُوتْ بْقُدْرِةْ الآبْ، أَحْنَا زَادَا نْعِيشُوا حْيَاةْ جْدِيدَة.<verse eid="ROM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5" />ومَادَامْ وَلِّينَا وَاحِدْ مْعَاهْ فِي مُوتْ كِيمَا مُوتُو، أَكِيدْ بِشْ نْوَلِّيوْ وَاحِدْ مْعَاهْ فِي قْيَامَة كِيمَا قْيَامْتُو. <verse eid="ROM 6:5" /><verse number="6" style="v" sid="ROM 6:6" />وأَحْنَا نَعْرْفُوا الِّي الإِنْسَانْ القْدِيمْ الِّي فِينَا تِصْلَبْ مْعَ المَسِيحْ، بَاشْ الذْنُوبْ مَا عَادِشْ يْكُونْ عَنْدْهَا سُلْطَة عْلِينَا، ومَا نَبْقَاوِشْ عَبِيدْ لِيهَا. <verse eid="ROM 6:6" /><verse number="7" style="v" sid="ROM 6:7" />عْلَى خَاطِرْ الِّي يْمُوتْ يِتْحَرِّرْ مِالذْنُوبْ.<verse eid="ROM 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 6:8" />ومَادَامْنَا مُتْنَا مْعَ المَسِيحْ، أَحْنَا نَمْنُوا الِّي بِشْ نَحْيَاوْ مْعَاهْ زَادَا. <verse eid="ROM 6:8" /><verse number="9" style="v" sid="ROM 6:9" />ونَعْرْفُوا الِّي المَسِيحْ، بَعْدْمَا قَيْمُو اللَّهْ مِالمُوتْ، مُشْ بِشْ يْمُوتْ مَرَّة أُخْرَى، والمُوتْ مَعَادِشْ عَنْدْهَا سُلْطَة عْلِيهْ. <verse eid="ROM 6:9" /><verse number="10" style="v" sid="ROM 6:10" />عْلَى خَاطْرُو وَقْتِلِّي مَاتْ، مَاتْ عْلَى خَاطِرْ الذْنُوبْ مَرَّة وَحْدَة، آمَا تَوَّا، الحْيَاةْ الِّي يَحْيَاهَا، يَحْيَاهَا لِلَّهْ. <verse eid="ROM 6:10" /><verse number="11" style="v" sid="ROM 6:11" />كِيفْ كِيفْ إِنْتُومَا زَادَا، إِحْسْبُوا رْوَاحْكُمْ مُوتَى بِالنِّسْبَة لِلذْنُوبْ، وحَيِّينْ لِلَّهْ بْيَسُوعْ المَسِيحْ.<verse eid="ROM 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12" />مَالَا مَا تْخَلِّيوِشْ الذْنُوبْ تْسَيْطِرْ عْلَى بْدَنْكُمْ الفَانِي وتْوَلِّيوْ اتَّبْعُوا شْهَاوِيهْ. <verse eid="ROM 6:12" /><verse number="13" style="v" sid="ROM 6:13" />مَا تْسَلْمُوشْ أَعْضَاءْ بْدَنْكُمْ لِلذْنُوبْ، بَاشْ مَا تْوَلِّيشْ سْلَاحْ لِلشَّرْ، آمَا سَلْمُوا رْوَاحْكُمْ لِلَّهْ بْصِيفِتْكُمْ قُمْتُوا حَيِّينْ مِالمُوتْ، وسَلْمُولُو أَعْضَاءْ بْدَنْكُمْ، سْلَاحْ لْكُلْ مَاهُو صَالَحْ. <verse eid="ROM 6:13" /><verse number="14" style="v" sid="ROM 6:14" />وهَكَّا، مَا عَادِشْ يْكُونْ لِلذْنُوبْ سُلْطَة عْلِيكُمْ، مَادَامْ مَاكُمْشْ تَحْتْ حُكْمْ الشَّرِيعَة، آمَا تَحْتْ حُكْمْ النِّعْمَة.<verse eid="ROM 6:14" /></para>
  <para style="s">عَبِيدْ لِلصَّلَاحْ</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15" />مَالَا كِيفَاشْ؟ نَعْمْلُوا الذْنُوبْ مَادَامْنَا تَحْتْ حُكْمْ النِّعْمَة مُشْ تَحْتْ حُكْمْ الشَّرِيعَة؟ حَاشَا! <verse eid="ROM 6:15" /><verse number="16" style="v" sid="ROM 6:16" />يَاخِي مَا تَعْرْفُوشْ الِّي، كِي تْحُطُّوا رْوَاحْكُمْ فِي خِدْمِةْ وَاحِدْ واطِّيعُوهْ، تْوَلِّيوْ عَبِيدْ عَنْدُو؟ يَا إِمَّا تْكُونُوا عَبِيدْ لِلذْنُوبْ الِّي يْهِزُّوا لِلْمُوتْ، وَلَّا تْكُونُوا عَبِيدْ لِلطَّاعَة الِّي تْهِزْ لِلصَّلَاحْ. <verse eid="ROM 6:16" /><verse number="17" style="v" sid="ROM 6:17" />قْبَلْ كُنْتُوا عَبِيدْ لِلذْنُوبْ، آمَا الحَمْدْ لِلَّهْ، عْلَى خَاطِرْكُمْ طُعْتُوا مِنْ كُلْ قْلُوبْكُمْ التَّعْلِيمْ الِّي خْذِيتُوهْ. <verse eid="ROM 6:17" /><verse number="18" style="v" sid="ROM 6:18" />وتَوَّا تْحَرَّرْتُوا مِالذْنُوبْ ووَلِّيتُوا عَبِيدْ لِلصَّلَاحْ.<verse eid="ROM 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 6:19" />وآنَا نْعَبْرِلْكُمْ بْلُوغَة سَاهْلَة خَاطِرْنِي نَعْرِفْ الِّي صْعِيبْ عْلِيكُمْ تِفْهْمُوا. مَالَا، كِيمَا خَلِّيتُوا أَعْضَاءْ بْدَنْكُمْ يْكُونُوا عَبِيدْ لِلنْجَاسَة والشَّرْ الِّي خَلَّى شَّرْكُمْ يْزِيدْ ، تَوَّا خَلِّيوْ أَعْضَاءْ بْدَنْكُمْ يْكُونُوا عَبِيدْ لِلصَّلَاحْ، الِّي يْخَلِّي قَدَاسِتْكُمْ تْزِيدْ.<verse eid="ROM 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 6:20" />عْلَى خَاطِرْ، كِي كُنْتُوا عَبِيدْ لِذْنُوبْ، كُنْتُوا أَحْرَارْ، مُشْ مُطَالْبِينْ بَاشْ تَعْمْلُوا الصَّلَاحْ. <verse eid="ROM 6:20" /><verse number="21" style="v" sid="ROM 6:21" />يَاخِي، آشْ رْبَحْتُوا مِالحَاجَاتْ الِّي تَوَّا تِحْشْمُوا بِيهَا، ولِّي عَاقْبِتْهَا المُوتْ؟ <verse eid="ROM 6:21" /><verse number="22" style="v" sid="ROM 6:22" />آمَا تَوَّا، بَعْدْمَا تْحَرَّرْتُوا مِالذْنُوبْ ووَلِّيتُوا عَبِيدْ لِلَّهْ، الِّي رْبَحْتُوهْ هِيَّ القَدَاسَة، الِّي نْتِيجِتْهَا الحَيَاةْ الأَبَدِيَّة. <verse eid="ROM 6:22" /><verse number="23" style="v" sid="ROM 6:23" />عْلَى خَاطِرْ عَاقِبْةْ الذْنُوبْ هِيَّ المُوتْ، آمَا الهْدِيَّة الِّي يَعْطِيهَا اللَّهْ، هِيَّ الحَيَاةْ الأَبَدِيَّة بْيَسُوعْ المَسِيحْ رَبْنَا.<verse eid="ROM 6:23" /></para>
  <chapter eid="ROM 6" />
  <chapter number="7" style="c" sid="ROM 7" />
  <para style="s">تْحَرِّرْنَا مِالشَّرِيعَة</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1" />مَا يَخْفَاشْ عْلِيكُمْ يَا خْوَاتِي، الِّي قَانُونْ الشَّرِيعَة مَا يِطَبِّقْ عَالإِنْسَانْ كَانْ وهُوَّ حَيْ، وآنَا قَاعِدْ نْكَلِّمْ فِي نَاسْ يَعْرْفُوا الشَّرِيعَة، <verse eid="ROM 7:1" /><verse number="2" style="v" sid="ROM 7:2" />ونَعْطِيكُمْ مِثَالْ: المْرَا المْعَرْسَة تُرْبِطْهَا الشَّرِيعَة بْرَاجِلْهَا مَادَامُو حَيْ. آمَا كَانْ رَاجِلْهَا مَاتْ، تْوَلِّي، حَسْبْ الشَّرِيعَة، مَا عَادِشْ مَرْبُوطَة بِيهْ. <verse eid="ROM 7:2" /><verse number="3" style="v" sid="ROM 7:3" />هَاذَاكَا عْلَاشْ كَانْ وَلَّاتْ مَرْتْ رَاجِلْ آخَرْ ورَاجِلْهَا حَيْ، تِتْسَمَّى زَانْيَة. آمَا كَانْ رَاجِلْهَا يْمُوتْ، تْوَلِّي حُرَّة مِالقَانُونْ هَاذَا، ومَا تِتْسَمَّاشْ زَانْيَة كَانْ تْعَرِّسْ بْرَاجِلْ آخِرْ.<verse eid="ROM 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 7:4" />وهَكَّا إِنْتُومَا زَادَا يَا خْوَاتِي، بْمُوتْ المَسِيحْ، وَلِّيتُوا مُوتَى بِالنِّسْبَة لِلشَّرِيعَة، بَاشْ تْنَجْمُوا تْكُونُوا تَابْعِينْ لْوَاحِدْ آخِرْ، مَعْنَاهَا تَابْعِينْ لِلْمَسِيحْ الِّي قَامْ مِالمُوتْ، بَاشْ تَعْمْلُوا أَعْمَالْ صَالْحَة لِلَّهْ. <verse eid="ROM 7:4" /><verse number="5" style="v" sid="ROM 7:5" />وَقْتِلِّي كُنَّا عَايْشِينْ بِطْبِيعِتْنَا البَشَرِيَّة الفَاسْدَة، كَانِتْ شْهَاوِينَا الفَاسْدَة الِّي ظَهْرِتْهُمْ الشَّرِيعَة، هِيَّ الِّي تِتْحَكِّمْ فِي البْدَنْ الكُلْ، بَاشْ تْخَلِّينَا نَعْمْلُوا أَعْمَالْ تْهِزْ لِلْمُوتْ. <verse eid="ROM 7:5" /><verse number="6" style="v" sid="ROM 7:6" />آمَا تَوَّا تْحَرِّرْنَا مِالشَّرِيعَة، عْلَى خَاطِرْ مُتْنَا بِالنِّسْبَة لِلِّي كَانْ رَابِطْنَا، بَاشْ نِعْبْدُوا اللَّهْ بْطَرِيقَة جْدِيدَة، بِالرُّوحْ، مُشْ بْطَرِيقِةْ الفَرَايِضْ المَكْتُوبَة.<verse eid="ROM 7:6" /></para>
  <para style="s">الشَّرِيعَة ظَهّْرِتْ الذْنُوبْ</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7" />مَالَا آشْ نْقُولُوا؟ يَاخِي الشَّرِيعَة بِيدْهَا مُذْنْبَة؟ حَاشَاهَا! بِالعَكْسْ مَا عْرَفْتْ شْنُوَّة هُوَّ الشَّرْ كَانْ بِالشَّرِيعَة. عْلَى خَاطِرْ مَا كُنْتِشْ بِشْ نَعْرِفْ شْنِيَّة هِيَّ الشَّهْوَة كَانْ الشَّرِيعَة مَا قَالِتْشْ: «مَا تِشْتْهِيشْ». <verse eid="ROM 7:7" /><verse number="8" style="v" sid="ROM 7:8" />آمَا الخَطِيئَة اسْتْغَلِّتْ الوْصِيَّة بَاشْ تْحَرِّكْ فِيَّا الشْهَاوِي الكُلْ. عْلَى خَاطِرْ، كَانْ مُشْ مِالشَّرِيعَة، رَاهِي الخَطِيئَة مَا عَنْدْهَاشْ سُلْطَة. <verse eid="ROM 7:8" /><verse number="9" style="v" sid="ROM 7:9" />قْبَلْ مَا نَعْرِفْ الشَّرِيعَة، كُنْتْ حَيْ، آمَا وَقْتِلِّي جَاتْ الشَّرِيعَة، الذْنُوبْ حْيَاتْ <verse eid="ROM 7:9" /><verse number="10" style="v" sid="ROM 7:10" />وآنَا مُتْ، والوْصِيَّة الِّي المَفْرُوضْ تَعْطِي الحَيَاةْ، هِيَّ بِيدْهَا هَزِّتْنِي لِلْمُوتْ، <verse eid="ROM 7:10" /><verse number="11" style="v" sid="ROM 7:11" />عْلَى خَاطِرْ الذْنُوبْ لْقَاتْ فُرْصِتْهَا فِي الوْصِيَّة، وخَدْعِتْنِي وقَتْلِتْنِي بِيهَا.<verse eid="ROM 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 7:12" />مَالَا، الشَّرِيعَة مُقَدْسَة، والوْصِيَّة مُقَدْسَة وعَادْلَة وصَالْحَة. <verse eid="ROM 7:12" /><verse number="13" style="v" sid="ROM 7:13" />يَاخِي، الصَّلَاحْ يْهِزْنِي لِلْمُوتْ؟ حَاشَاهْ! آمَا الذْنُوبْ هِيَّ الِّي اسْتَعْمْلِتْ الشَّرِيعَة الصَّالْحَة وتْسَبْبِّتْلِي فِي المُوتْ، مُشْ الشَّرِيعَة بِيدْهَا. وهَاذَا بَاشْ تُظْهِرْ الذْنُوبْ عْلَى حْقِيقِتْهَا. عْلَى خَاطِرْ، بِالوْصِيَّة، يُظْهُرْ شَرْ الذْنُوبْ لْأَقْصَى دَرْجْتُو.<verse eid="ROM 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14" />أَحْنَا نَعْرْفُوا الِّي الشَّرِيعَة مِنْ رُوحْ اللَّهْ، آمَا آنَا بَشَرْ وعَبْدْ لِلذْنُوبْ: <verse eid="ROM 7:14" /><verse number="15" style="v" sid="ROM 7:15" />آنَا مُشْ فَاهِمْ رُوحِي فَاشْ نَعْمِلْ، عْلَى خَاطِرْ الِّي نْحِبْ نَعْمْلُو مَا نَعْمْلُوشْ، ولِّي مَا نْحِبِّشْ نَعْمْلُو هَاذَاكَا هُوَّ الِّي نَعْمْلُو. <verse eid="ROM 7:15" /><verse number="16" style="v" sid="ROM 7:16" />ومَادَامْنِي نَعْمِلْ فِلِّي مَا نْحِبِّشْ نَعْمْلُو، مَعْنَاهَا نْوَافِقْ الِّي الشَّرِيعَة صَالْحَة. <verse eid="ROM 7:16" /><verse number="17" style="v" sid="ROM 7:17" />فِي الحْقِيقَة مَانِيشْ آنَا الِّي قَاعِدْ نَعْمِلْ فِي هَاذَا، آمَا الذْنُوبْ المَوْجُودَة فِيَّا هِيَّ الِّي تَعْمِلْ. <verse eid="ROM 7:17" /><verse number="18" style="v" sid="ROM 7:18" />آنَا نَعْرِفْ الِّي مَا فِيَّا حَتَّى شَيْ صَالَحْ، نُقْصُدْ فِي طْبِيعْتِي البَشَرِيَّة الفَاسْدَة. عْلَى خَاطِرْنِي نْحِبْ نَعْمِلْ الخِيرْ، آمَا مَا انَّجَّمْشْ نَعْمْلُو. <verse eid="ROM 7:18" /><verse number="19" style="v" sid="ROM 7:19" />الخِيرْ الِّي نْحِبْ نَعْمْلُو مَا نَعْمْلُوشْ، آمَا الشَّرْ الِّي مَا نْحِبِّشْ نَعْمْلُو، هَاذَاكَا الِّي نَعْمْلُو. <verse eid="ROM 7:19" /><verse number="20" style="v" sid="ROM 7:20" />وإِذَا كَانْ نَعْمِلْ فِلِّي مَا نْحِبِّشْ نَعْمْلُو، مَالَا مَانِيشْ آنَا الِّي نَعْمِلْ فِيهْ، آمَا الذْنُوبْ المَوْجُودَة فِيَّا هِيَّ الِّي تَعْمِلْ.<verse eid="ROM 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21" />وَلَّالِي كَايِنُّو قَانُونْ: كِي نْحِبْ نَعْمِلْ الخِيرْ، نَلْقَى رُوحِي نَعْمِلْ فِي الشَّرْ. <verse eid="ROM 7:21" /><verse number="22" style="v" sid="ROM 7:22" />ورَانِي مِنْ دَاخِلْ فَرْحَانْ بْشَرِيعِةْ اللَّهْ، <verse eid="ROM 7:22" /><verse number="23" style="v" sid="ROM 7:23" />آمَا فَمَّة قُوَّة أُخْرَى فِيَّا تْحَارِبْ فِي القَانُونْ الِّي يِقْبْلُو عَقْلِي، وتْخَلِّينِي مَرْبُوطْ فِي قُوِّةْ الذْنُوبْ السَّاكْنَة فِيَّا. <verse eid="ROM 7:23" /><verse number="24" style="v" sid="ROM 7:24" />آنَا إِنْسَانْ تَعِيسْ! شْكُونْ بِشْ يْمَنَّعْنِي مِنْ هَا البْدَنْ الِّي مَاشِي لِلْمُوتْ؟ <verse eid="ROM 7:24" /><verse number="25" style="v" sid="ROM 7:25" />نُشْكُرْ اللَّهْ الِّي يْمَنَّعْنِي بْرَبْنَا يَسُوعْ المَسِيحْ. مَالَا، آنَا بْعَقْلِي خَاضَعْ لْشَرِيعِةْ اللَّهْ، آمَا بْطْبِيعِةْ البَشَرْ الفَاسْدَة آنَا خَاضَعْ لْشَرِيعِةْ الذْنُوبْ.<verse eid="ROM 7:25" /></para>
  <chapter eid="ROM 7" />
  <chapter number="8" style="c" sid="ROM 8" />
  <para style="s">نْعِيشُوا حَسْبْ الرُّوحْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1" />مَالَا تَوَّا، مَا عَادِشْ فَمَّة حُكْمْ عَلِّي تَابْعِينْ يَسُوعْ المَسِيحْ. <verse eid="ROM 8:1" /><verse number="2" style="v" sid="ROM 8:2" />عْلَى خَاطِرْ شَرِيعِةْ الرُّوحْ الِّي يَعْطِي الحَيَاةْ بْيَسُوعْ المَسِيحْ، حَرِرِّتْنِي مِنْ شَرِيعِةْ الذْنُوبْ والمُوتْ. <verse eid="ROM 8:2" /><verse number="3" style="v" sid="ROM 8:3" />ولِّي مَا نَجْمِتْشْ تَعْمْلُو الشَّرِيعَة بِسْبَبْ ضُعْفْ الطْبِيعَة البَشَرِيَّة الفَاسْدَة، عَمْلُو اللَّهْ وَقْتِلِّي بْعَثْ إِبْنُو الِّي وَلَّى بَشَرْ كِيفْنَا أَحْنَا المُذْنْبِينْ، بَاشْ يْحَرِّرْنَا مِالخَطِيئَة ويُحْكُمْ عَالخَطِيئَة المَوْجُودَة فِي الطْبِيعَة البَشَرِيَّة الفَاسْدَة. <verse eid="ROM 8:3" /><verse number="4" style="v" sid="ROM 8:4" />عْمَلْ هَاذَا بَاشْ الصَّلَاحْ الِّي تُطْلْبُو الشَّرِيعَة يِتْحَقَّقْ فِينَا أَحْنَا الِّي نْعِيشُوا حَسْبْ الرُّوحْ، مُشْ حَسْبْ الطْبِيعَة البَشَرِيَّة الفَاسْدَة.<verse eid="ROM 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 8:5" />رَاهُمْ الِّي يْعِيشُوا حَسْبْ الطْبِيعَة البَشَرِيَّة الفَاسْدَة، يْفَكْرُوا فِي أُمُورْ بَشَرِيَّة. ولِّي يْعِيشُوا حَسْبْ الرُّوحْ، يْفَكْرُوا فِي أُمُورْ رُوحِيَّة. <verse eid="ROM 8:5" /><verse number="6" style="v" sid="ROM 8:6" />التَّفْكِيرْ فِي أُمُورْ الطْبِيعَة البَشَرِيَّة الفَاسْدَة آخْرُو مُوتْ، آمَا التَّفْكِيرْ فِي أُمُورْ الرُّوحْ آخْرُو حَيَاةْ وسَلَامْ، <verse eid="ROM 8:6" /><verse number="7" style="v" sid="ROM 8:7" />ولِّي يْحِبْ يْرَضِّي الطْبِيعَة البَشَرِيَّة الفَاسْدَة هُوَّ عْدُو اللَّهْ، عْلَى خَاطِرْ مَا يْطِيعِشْ شَرِيعِةْ اللَّهْ. وفِي الحْقِيقَة مَا يْنَجِّمْشْ يْطِيعْهَا. <verse eid="ROM 8:7" /><verse number="8" style="v" sid="ROM 8:8" />ولِّي هُومَا تَحْتْ سُلْطِةْ الطْبِيعَة البَشَرِيَّة مَا يْنَجْمُوشْ يْرَضِّيوْ اللَّهْ.<verse eid="ROM 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9" />آمَا إِذَا كَانْ رُوحْ اللَّهْ يُسْكُنْ فِيكُمْ، إِنْتُومَا مَاكُمْشْ تَحْتْ سُلْطِةْ الطْبِيعَة البَشَرِيَّة الفَاسْدَة، آمَا تَحْتْ سُلْطِةْ الرُّوحْ. ولِّي مَا عَنْدُوشْ رُوحْ المَسِيحْ، رَاهُو مُشْ تَابَعْ المَسِيحْ. <verse eid="ROM 8:9" /><verse number="10" style="v" sid="ROM 8:10" />آمَا، إِذَا كَانْ المَسِيحْ فِيكُمْ، رَغْمِلِّي بْدَنَّاتْكُمْ يْجِيهَا نْهَارْ وتْمُوتْ بِسْبَبْ الذْنُوبْ، الرُّوحْ يَعْطِيكُمْ حْيَاةْ عْلَى خَاطِرْ اللَّهْ رَدْكُمْ صَالْحِينْ. <verse eid="ROM 8:10" /><verse number="11" style="v" sid="ROM 8:11" />وإِذَا كَانْ رُوحْ اللَّهْ الِّي قَيِّمْ يَسُوعْ مِالمُوتْ يُسْكُنْ فِيكُمْ، رَاهُو الِّي قَيِّمْ المَسِيحْ مِالمُوتْ بِشْ يَعْطِي حَيَاةْ لِبْدَنَّاتْكُمْ الفَانْيَة بْرُوحُو الِّي يُسْكُنْ فِيكُمْ.<verse eid="ROM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12" />مَالَا يَا خْوَاتِي، رَانَا عَنْدْنَا وَاجِبْ، آمَا وَاجِبْنَا مُشْ بَاشْ نْطِيعُوا الطْبِيعَة البَشَرِيَّة الفَاسْدَة ونْعِيشُوا حَسْبْهَا هِيَّ. <verse eid="ROM 8:12" /><verse number="13" style="v" sid="ROM 8:13" />عْلَى خَاطِرْ كَانْ تْعِيشُوا حَسْبْ الطْبِيعَة البَشَرِيَّة الفَاسْدَة بِشْ تْمُوتُوا، آمَا إِذَا كَانْ بِالرُّوحْ تُقْتْلُوا أَعْمَالْهَا رَاكُمْ بَاشْ تَحْيَاوْ. <verse eid="ROM 8:13" /><verse number="14" style="v" sid="ROM 8:14" />الِّي يْقُودْهُمْ رُوحْ اللَّهْ، هُومَا وْلَادْ اللَّهْ، <verse eid="ROM 8:14" /><verse number="15" style="v" sid="ROM 8:15" />رَاكُمْ مَا خْذِيتُوشْ رُوحْ يْرَجَّعْكُمْ عَبِيدْ مَرَّة أُخْرَى ويْرَجَّعْكُمْ لِلْخُوفْ، آمَا خْذِيتُوا رُوحْ يْرُدْكُمْ وْلَادْ اللَّهْ، رُوحْ يْخَلِّينَا نْقُولُوا لِلَّهْ: «بَابَا! يَا بُونَا!» <verse eid="ROM 8:15" /><verse number="16" style="v" sid="ROM 8:16" />والرُّوحْ هُوَّ بِيدُو يِشْهِدْ مْعَ رْوَاحْنَا الِّي أَحْنَا وْلَادْ اللَّهْ. <verse eid="ROM 8:16" /><verse number="17" style="v" sid="ROM 8:17" />ومَادَامْنَا وْلَادْ اللَّهْ، مَعْنَاهَا رَانَا نُورْثُوا: نُورْثُوا بَرَكَاتْ اللَّهْ، ونْشَارْكُوا المَسِيحْ فِي الوَرْثَة. آمَا لَازِمْنَا نِتْعَذْبُوا مْعَاهْ بَاشْ انَّجْمُوا نِتْمَجْدُوا مْعَاهْ.<verse eid="ROM 8:17" /></para>
  <para style="s">عَذَابْ الحَاضِرْ ومَجْدْ المُسْتَقْبِلْ</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18" />آنَا نْشُوفْ الِّي العْذَابْ الِّي نْعَانِيوْ فِيهْ فِي الوَقْتْ الحَاضِرْ مَا يْجِي حَتَّى شَيْ قُدَّامْ المَجْدْ الِّي بِشْ يِكْشِفْهُولْنَا اللَّهْ فِي المُسْتَقْبِلْ. <verse eid="ROM 8:18" /><verse number="19" style="v" sid="ROM 8:19" />رَاهُو الِّي خَلْقُو اللَّهْ الكُلْ يِسْتَنَّى بِالدْقِيقَة والدْرَجْ وَقْتَاشْ يُظْهْرُوا وْلَادْ اللَّهْ. <verse eid="ROM 8:19" /><verse number="20" style="v" sid="ROM 8:20" />عْلَى خَاطِرْ المَخْلُوقَاتْ الكُلْ وَلَّاتْ بْلَا فَايْدَة، مُشْ بْإِخْتِيَارْهَا آمَا بِاخْتِيَارْ الِّي خْلَقْهَا. ورَغْمْ هَاذَا، مَزَّالْ فَمَّة رْجَى لِلْعَالِمْ هَاذَا، <verse eid="ROM 8:20" /><verse number="21" style="v" sid="ROM 8:21" />إِنُّو اللَّهْ يْحَرِّرْ المَخْلُوقَاتْ هِيَّ زَادَا مِنْ قُوِّةْ الفْسَادْ الِّي يِسْتَعْبِدْ فِيهَا، وتَاخِذْ حُرِّيَّة ومَجْدْ مْعَ وْلَادْ اللَّهْ.<verse eid="ROM 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 8:22" />وأَحْنَا نَعْرْفُوا الِّي حَتَّى لْتَوَّا، العَالِمْ المَخْلُوقْ الكُلْ يْنِينْ ويِتْوَجَّعْ كِالمْرَا الِّي بِشْ تُولِدْ. <verse eid="ROM 8:22" /><verse number="23" style="v" sid="ROM 8:23" />ومُشْ هُوَّ بَرْكَا، آمَا أَحْنَا زَادَا الِّي خْذِينَا الرُّوحْ، أَوِّلْ بَرْكَة مِنْ عَنْدْ اللَّهْ، قْلُوبْنَا تْنِينْ، وْنِسْتَنَّاوْ بَاشْ اللَّهْ يِتْبَنَّانَا ويِفْدِي بْدَنَّاتْنَا. <verse eid="ROM 8:23" /><verse number="24" style="v" sid="ROM 8:24" />أَحْنَا نْجِينَا وعَنْدْنَا الرْجَى هَاذَا. وكَانْ انَّجْمُوا نْشُوفُوا الحَاجَة الِّي عَنْدْنَا فِيهَا رْجَى مَا عَادِشْ تِتْسَمَّى رْجَى. فَمَّة وَاحِدْ يِسْتَنَّى حَاجَة يْشُوفْ فِيهَا؟ <verse eid="ROM 8:24" /><verse number="25" style="v" sid="ROM 8:25" />آمَا كَانْ عَنْدْنَا رْجَى فِلِّي مَا نْشُوفُوهِشْ، بِشْ نِسْتَنَّاوُوهْ بْصَبْرْ.<verse eid="ROM 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26" />والرُّوحْ زَادَا يْعَاوِنَّا فِي ضَعْفْنَا. أَحْنَا مَا نَعْرْفُوشْ كِيفَاشْ نْصَلِّيوْ كِيمَا يِلْزِمْ، آمَا الرُّوحْ بِيدُو يِشْفَعْ فِينَا بْتَنْهِيدَاتْ مَا يِتْعَبَّرْشْ عْلِيهَا بِالكْلَامْ. <verse eid="ROM 8:26" /><verse number="27" style="v" sid="ROM 8:27" />واللَّهْ الِّي يَعْرِفْ آشْ فَمَّة فِي القْلُوبْ، يَعْرِفْ آشْ يُقْصُدْ الرُّوحْ. عْلَى خَاطِرْ الرُّوحْ يِشْفَعْ فِي القِدِّيسِينْ كِيمَا يْحِبْ اللَّهْ. <verse eid="ROM 8:27" /><verse number="28" style="v" sid="ROM 8:28" />وأَحْنَا نَعْرْفُوا الِّي الأُمُورْ الكُلْ تِخْدِمْ مْعَ بْعَضْهَا لِلخِيرْ لِلنَّاسْ الِّي يْحِبُّوا اللَّهْ، ولِّي دْعَاهُمْ حَسْبْ قَصْدُو. <verse eid="ROM 8:28" /><verse number="29" style="v" sid="ROM 8:29" />عْلَى خَاطِرْ الِّي سْبَقْ وعْرَفْهُمْ، سْبَقْ واخْتَارْهُمْ بَاشْ يْكُونُوا عْلَى صُورِةْ إِبْنُو، ويْكُونْ هُوَّ البِكْرْ بِينْ بَرْشَة خْوَاتْ. <verse eid="ROM 8:29" /><verse number="30" style="v" sid="ROM 8:30" />ولِّي سْبَقْ واخْتَارْهُمْ دْعَاهُمْ زَادَا، ولِّي دْعَاهُمْ رَدْهُمْ صَالْحِينْ زَادَا، ولِّي رَدْهُمْ صَالْحِينْ مَجِّدْهُمْ زَادَا.<verse eid="ROM 8:30" /></para>
  <para style="s">أَحْنَا غَالْبِينْ بْيَسُوعْ</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31" />آشْ بِشْ نْقُولُوا بَعْدْ هَاذَا الكُلْ؟ إِذَا كَانْ اللَّهْ مْعَانَا، شْكُونْ بِشْ يْكُونْ ضِدْنَا؟ <verse eid="ROM 8:31" /><verse number="32" style="v" sid="ROM 8:32" />الِّي مَا بْخِلْشْ عْلِينَا بْإِبْنُو، آمَا سَلْمُو لِلْمُوتْ عْلَى خَاطِرْنَا الكُلْ، كِيفَاشْ مَا يَعْطِينَاشْ مْعَاهْ كُلْ شَيْ؟ <verse eid="ROM 8:32" /><verse number="33" style="v" sid="ROM 8:33" />شْكُونْ بِشْ يِتْهِمْ الِّي اخْتَارْهُمْ اللَّهْ واللَّهْ هُوَّ الِّي رَدْهُمْ صَالْحِينْ؟ <verse eid="ROM 8:33" /><verse number="34" style="v" sid="ROM 8:34" />وشْكُونْ الِّي يْنَجِّمْ يُحْكُمْ عْلِينَا؟ رَاهُو يَسُوعْ المَسِيحْ مَاتْ وزَادَا قَامْ مِالمُوتْ، وهُوَّ عْلَى يْمِينْ اللَّهْ، يِشْفَعْ فِينَا.<verse eid="ROM 8:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ROM 8:35" />شْكُونْ بِشْ يُفْصُلْنَا عْلَى مْحَبِّةْ المَسِيحْ؟ زَعْمَة الشْقَى وَلَّا الضِّيقْ وَلَّا الإِضْطِهَادْ وَلَّا الجُوعْ وَلَّا العْرَى وَلَّا الخْطَرْ وَلَّا السِّيفْ؟ <verse eid="ROM 8:35" /><verse number="36" style="v" sid="ROM 8:36" />كِيفْ مَا هُوَّ مَكْتُوبْ:</para>
  <para style="b" vid="ROM 8:36" />
  <para style="q1" vid="ROM 8:36">«عْلَى خَاطْرِكْ نْوَاجْهُوا المُوتْ،</para>
  <para style="q2" vid="ROM 8:36">عْلَى طُولْ النْهَارْ،</para>
  <para style="q1" vid="ROM 8:36">مَحْسُوبِينْ كَايِنَّا غْنَمْ لِلذَّبْحَانْ».<verse eid="ROM 8:36" /></para>
  <para style="b" />
  <para style="p">
    <verse number="37" style="v" sid="ROM 8:37" />آمَا فِي الأُمُورْ هَاذِي الكُلْ، أَحْنَا أَكْثِرْ مِنْ غَالْبِينْ بِلِّي حَبْنَا. <verse eid="ROM 8:37" /><verse number="38" style="v" sid="ROM 8:38" />وآنَا مِتْأَكِّدْ الِّي لَا المُوتْ ولَا الحَيَاةْ، ولَا المْلَايْكَة ولَا الحُكَّامْ ولَا القُوَّاتْ الرُّوحِيَّة، ولَا الحَاضِرْ ولَا المُسْتَقْبِلْ، <verse eid="ROM 8:38" /><verse number="39" style="v" sid="ROM 8:39" />ولَا قُوَّاتْ مِالفُوقْ وَلَّا مِاللُّوطَة ولَا حَتَّى شَيْ مِلِّي خَلْقُو اللَّهْ الكُلْ يْنَجِّمْ يُفْصِلْنَا عْلَى مْحَبِّةْ اللَّهْ الِّي فِي يَسُوعْ المَسِيحْ رَبْنَا.<verse eid="ROM 8:39" /></para>
  <chapter eid="ROM 8" />
  <chapter number="9" style="c" sid="ROM 9" />
  <para style="s">بُولِسْ حْزِينْ عْلَى بَنِي إِسْرَائِيلْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1" />نْقُولْ الحَقْ ومَا نِكْذِبْشْ خَاطِرْنِي نَمِّنْ بِالمَسِيحْ. وضَمِيرِي يِشْهِدْ الِّي آنَا صَادِقْ بِالرُّوحْ القُدُسْ: <verse eid="ROM 9:1" /><verse number="2" style="v" sid="ROM 9:2" />آنَا حْزِينْ بَرْشَة، وفِي قَلْبِي وْجِيعَة مَا تُوفَاشْ، <verse eid="ROM 9:2" /><verse number="3" style="v" sid="ROM 9:3" />وتْمَنِّيتْ نْكُونْ آنَا بِيدِي مَلْعُونْ ومَحْرُومْ مِالمَسِيحْ، لَوْ كَانْ جَاء هَاذَا يَنْفَعْ خْوَاتِي الِّي هُومَا لَحْمِي ودَمِّي. <verse eid="ROM 9:3" /><verse number="4" style="v" sid="ROM 9:4" />وهُومَا بَنِي إِسْرَائِيلْ، الِّي اللَّهْ رَدْهُمْ وْلَادُو، وظَهْرِّلْهُمْ مَجْدُو، وعْمَلْ مْعَاهُمْ العُهُودْ، وعْطَاهُمْ الشَّرِيعَة وطَرِيقِةْ العِبَادَة والوْعُودْ، <verse eid="ROM 9:4" /><verse number="5" style="v" sid="ROM 9:5" />وهُومَا الِّي جَاوْ مِنْهُمْ الجْدُودْ الأُوْلَانِينْ، ومِنْهُمْ جَاء المَسِيحْ مِنْ جِيهِةْ البْدَنْ، هُوَّ الِّي فُوقْ الكُلْ، إِلَاهْ مُبَارَكْ لِلْأَبَدْ. آمِينْ.<verse eid="ROM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6" />وهَاذَا مُشْ مَعْنَاهْ الِّي وَعْدْ اللَّهْ مَا تَمِّشْ. عْلَى خَاطِرْ مُشْ كُلْ بَنِي إِسْرَائِيلْ هُومَا شَعْبْ اللَّهْ بِالحَقْ، <verse eid="ROM 9:6" /><verse number="7" style="v" sid="ROM 9:7" />ومُشْ كُلْ الِّي مِنْ ذُرِّيِّةْ إِبْرَاهِيمْ هُومَا أَوْلَادْ إِبْرَاهِيمْ. آمَا قَالْ اللَّهْ لِإِبْرَاهِيمْ: «بِشْ تْكُونْ عَنْدِكْ ذُرِّيَّة عْلَى طْرِيقْ إِسْحَاقْ». <verse eid="ROM 9:7" /><verse number="8" style="v" sid="ROM 9:8" />مَعْنَاهَا مُشْ الوْلَادْ الِّي يْجِيوْ بِالطَّرِيقَة الطَّبِيعِيَّة هُومَا أَوْلَادْ اللَّهْ، آمَا الوْلَادْ الِّي يْجِيوْ حَسْبْ وَعْدْ اللَّهْ هُومَا الِّي يِتْحِسْبُوا ذُرِّيِّةْ إِبْرَاهِيمْ. <verse eid="ROM 9:8" /><verse number="9" style="v" sid="ROM 9:9" />والوَعْدْ كَانْ: «بِشْ نِرْجَعْ فِي الوَقْتْ هَاذَا العَامْ الجَّايْ، وسَارَّة بِشْ تْكُونْ جَابِتْ وْلَيِّدْ».<verse eid="ROM 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10" />ومُشْ هَاذَا بَرْكَا، آمَا زَادَا وَقْتِلِّي رِفْقَة حِبْلِتْ وجَابِتْ وْلَادْ مِنْ نَفْسْ الرَّاجِلْ، الِّي هُوَّ بُونَا إِسْحَاقْ، <verse eid="ROM 9:10" /><verse number="11" style="v" sid="ROM 9:11" />وقْبَلْ مَا يِتْوِلْدُوا وْلَادْهَا التْوَامَا وقْبَلْ مَا يَعْمْلُوا لَا خِيرْ ولَا شَرْ، وبَاشْ يْتِمْ قَصْدْ اللَّهْ فِي الإِخْتِيَارْ، عْلَى خَاطْرُو يِخْتَارْ حَسْبْ دَعْوْتُو مُشْ حَسْبْ الأَعْمَالْ، <verse eid="ROM 9:11" /><verse number="12" style="v" sid="ROM 9:12" />قَالْ اللَّهْ لْرِفْقَةْ: «الكْبِيرْ بِشْ يِخْدِمْ الصْغِيرْ». <verse eid="ROM 9:12" /><verse number="13" style="v" sid="ROM 9:13" />كِيمَا مَكْتُوبْ: «إِخْتَرْتْ يَعْقُوبْ ورْفَضْتْ عِيسُو».<verse eid="ROM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14" />شِنْحِبُّوا نْقُولُوا؟ زَعْمَة اللَّهْ ظَالِمْ؟ حَاشَاهْ! <verse eid="ROM 9:14" /><verse number="15" style="v" sid="ROM 9:15" />رَاهُو قَالْ لْمُوسَى: «نَرْحِمْ الِّي نَرْحِمْ، ونِسْخِفْ عَلِّي نِسْخِفْ عْلِيهْ». <verse eid="ROM 9:15" /><verse number="16" style="v" sid="ROM 9:16" />مَالَا الحْكَايَة مَاهِيشْ مَرْبُوطَة بِلِّي يْحِبُّو الإِنْسَانْ ولَا بْمَجْهُودُو، آمَا مَرْبُوطَة بْرَحْمِةْ اللَّهْ. <verse eid="ROM 9:16" /><verse number="17" style="v" sid="ROM 9:17" />عْلَى خَاطِرْ اللَّهْ قَالْ لْفَرْعُونْ فِي الكْتُبْ المُقَدْسَة: «عْطِيتِكْ مْقَامْ بَاشْ نْوَرِّي قُوْتِي فِيكْ، وإِسْمِي يِتَعْرَفْ فِي العَالِمْ الكُلْ». <verse eid="ROM 9:17" /><verse number="18" style="v" sid="ROM 9:18" />مَالَا هُوَّ يَرْحِمْ الِّي يْحِبْ ، ويْقَسِّي قَلْبْ الِّي يْحِبْ.<verse eid="ROM 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19" />وهُونِي بِشْ تْقُلِّي: «مَالَا عْلَاشْ يْلُومْ؟ شْكُونْ يْنَجِّمْ يْقَاوِمْ قَصْدُو؟». <verse eid="ROM 9:19" /><verse number="20" style="v" sid="ROM 9:20" />وآنَا نْجَاوِبْ: شْكُونِكْ إِنْتِ يَا إِنْسَانْ بَاشْ تْنَاقِشْ اللَّهْ؟ يَاخِي الحَاجَة المَصْنُوعَة تْنَجِّمْ تْقُولْ لِلِّي صْنَعْهَا: «عْلَاشْ صْنَعْتْنِي هَكَّا؟». <verse eid="ROM 9:20" /><verse number="21" style="v" sid="ROM 9:21" />يَاخِي الِّي يَصْنَعْ الفُخَّارْ مُشْ حُرْ بَاشْ يَصْنَعْ مِنْ نَفْسْ الطِّينْ مَاعُونْ لِلمُنَاسْبَاتْ ومَاعُونْ لِلدَّهْكْ؟<verse eid="ROM 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22" />إِذَا كَانْ اللَّهْ، كِي حَبْ يْوَرِّي غُشُّو وِيْظَهِّرْ قُوْتُو، تْحَمِّلْ بْصَبْرْ كْبِيرْ النَّاسْ الِّي بِشْ يِسَيِّبْ عْلِيهُمْ غُشُّو ولِّي مَاشِينْ لِلْهْلَاكْ، كِالمَاعُونْ الِّي مْصِيرُو يِتْكَسِّرْ، آشْ عَنَّا مَا نْقُولُوا؟ <verse eid="ROM 9:22" /><verse number="23" style="v" sid="ROM 9:23" />اللَّهْ عْمَلْ هَاذَا بَاشْ يْظَهِّرْ مَجْدُو العْظِيمْ فِي مَاعُونْ الرَّحْمَة الِّي حَضّْرُو مِنْ قْبَلْ لِلمَجْدْ، <verse eid="ROM 9:23" /><verse number="24" style="v" sid="ROM 9:24" />وهَاذُمْ هُومَا أَحْنَا الِّي دْعَانَا مُشْ مِاليْهُودْ أَكَهَوْ، آمَا مِالشْعُوبْ الأُخْرِينْ زَادَا. <verse eid="ROM 9:24" /><verse number="25" style="v" sid="ROM 9:25" />كِيمَا قَالْ اللَّهْ فِي كْتَابْ النَّبِيْ هُوشَعْ:</para>
  <para style="b" vid="ROM 9:25" />
  <para style="q1" vid="ROM 9:25">«الِّي مَا كَانُوشْ شَعْبِي</para>
  <para style="q2" vid="ROM 9:25">بِشْ نْسَمِّيهُمْ شَعْبِي،</para>
  <para style="q1" vid="ROM 9:25">ولِّي مَا كَانِتْشْ مَحْبُوبَةْ</para>
  <para style="q2" vid="ROM 9:25">بِشْ نْسَمِّيهَا مَحْبُوبْتِي».<verse eid="ROM 9:25" /></para>
  <para style="b" />
  <para style="p">
    <verse number="26" style="v" sid="ROM 9:26" />وفِي نَفْسْ البْلَاصَة الِّي قَالِلْهُمْ فِيهَا اللَّهْ «مَاكُمْشْ شَعْبِي»، غَادِي بِشْ يِتْسَمَّاوْ «وْلَادْ اللَّهْ الحَيْ».<verse eid="ROM 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 9:27" />ويْقُولْ النَّبِيْ إِشَعْيَاءْ فِي مَا يْخُصْ بَنِي إِسْرَائِيلْ:</para>
  <para style="b" vid="ROM 9:27" />
  <para style="q1" vid="ROM 9:27">«حَتَّى لَوْ كَانُوا بَنِي إِسْرَائِيلْ قَدْ رْمَلْ البْحَرْ،</para>
  <para style="q2" vid="ROM 9:27">مَا بِشْ يِنْجَى مِنْهُمْ كَانْ شْوَيَّة بَرْكْ،<verse eid="ROM 9:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ROM 9:28" />عْلَى خَاطِرْ الرَّبْ بِشْ يْنَفِّذْ فِي العَالِمْ الِّي قَالْ بِشْ يَعْمْلُو</para>
  <para style="q2" vid="ROM 9:28">فِيسَعْ وبْصِيفَة كَامْلَة».<verse eid="ROM 9:28" /></para>
  <para style="b" />
  <para style="m">
    <verse number="29" style="v" sid="ROM 9:29" />كِيمَا سْبَقْ وقَالْ إِشَعْيَاءْ:</para>
  <para style="b" vid="ROM 9:29" />
  <para style="q1" vid="ROM 9:29">«كَانْ مَا جَاشْ إِلَاهْ كُلْ قُوَّة خَلَّالْنَا ذُرِّيَّة،</para>
  <para style="q2" vid="ROM 9:29">رَانَا وَلِّينَا كِي سَدُومْ، ونْشَبْهُوا لْعَمُورَة».<verse eid="ROM 9:29" /></para>
  <para style="b" />
  <para style="s">اليْهُودْ رَفْضُوا الإِيمَانْ</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30" />آشْ قَاعْدِينْ نْقُولُوا؟ نْقُولُوا إِنُّو الشُّعُوبْ الِّي مَاهُمْشْ يْهُودْ ولِّي مَا سْعَاوِشْ لِلصَّلَاحْ، إِعْتَبَرْهُمْ اللَّهْ صَالْحِينْ عْلَى أَسَاسْ إِيمَانْهُمْ <verse eid="ROM 9:30" /><verse number="31" style="v" sid="ROM 9:31" />آمَا بَنِي إِسْرَائِيلْ الِّي حَبُّوا يْكُونُوا صَالْحِينْ بْتَطْبِيقْ الشَّرِيعَة، مَا نَجْمُوشْ حَتَّى يْطَبْقُوهَا. <verse eid="ROM 9:31" /><verse number="32" style="v" sid="ROM 9:32" />وعْلَاشْ؟ عْلَى خَاطِرْهُمْ مَا سْعَاوِشْ لِلصَّلَاحْ بِالإِيمَانْ، آمَا بِالأَعْمَالْ الِّي تُفْرُضْهَا الشَّرِيعَة، يَاخِي عَثْرُوا فِي الحَجْرَة الِّي تْعَثِّرْ، <verse eid="ROM 9:32" /><verse number="33" style="v" sid="ROM 9:33" />كِيمَا مَكْتُوبْ:</para>
  <para style="b" vid="ROM 9:33" />
  <para style="q1" vid="ROM 9:33">«هَانِي بِشْ نْحُطْ فِي صِهْيَوْنْ حَجْرَة تْعَثِّرْ النَّاسْ،</para>
  <para style="q2" vid="ROM 9:33">وحَجْرَة إِطَّيَحْهُمْ،</para>
  <para style="q1" vid="ROM 9:33">آمَا الِّي يَمِّنْ بِيهَا</para>
  <para style="q2" vid="ROM 9:33">عُمْرُو مَا يْخِيبْ».<verse eid="ROM 9:33" /></para>
  <para style="b" />
  <chapter eid="ROM 9" />
  <chapter number="10" style="c" sid="ROM 10" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1" />يَا خْوَاتِي، شَهْوِةْ قَلْبِي وصْلَاتِي لِلَّهْ هِيَّ إِنُّو بَنِي إِسْرَائِيلْ يِنْجَاوْ. <verse eid="ROM 10:1" /><verse number="2" style="v" sid="ROM 10:2" />آنَا نِشْهِدْ الِّي هُومَا مِتْحَمْسِينْ لِلَّهْ. آمَا حَمَاسْهُمْ بْلَا مَعْرْفَة. <verse eid="ROM 10:2" /><verse number="3" style="v" sid="ROM 10:3" />وعْلَى خَاطِرْهُمْ مَا عَرْفُوشْ كِيفَاشْ اللَّهْ يْرُدْ الإِنْسَانْ صَالَحْ، وحَاوْلُوا يْكُونُوا صَالْحِينْ بْطَرِيقِتْهُمْ، مَا خَضْعُوشْ لْصَلَاحْ اللَّهْ. <verse eid="ROM 10:3" /><verse number="4" style="v" sid="ROM 10:4" />عْلَى خَاطِرْ المَسِيحْ حَطْ حَدْ لْدَوْرْ الشَّرِيعَة، بَاشْ كُلْ مِنْ يَمِّنْ بِيهْ يَعْتَبْرُو اللَّهْ صَالَحْ.<verse eid="ROM 10:4" /></para>
  <para style="s">رِسَالِةْ النْجَاةْ هِيَّ لِلنَّاسْ الكُلْ</para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5" />مُوسَى كْتِبْ عَالصَّلَاحْ الِّي يْجِي بِالشَّرِيعَة وقَالْ: «كُلْ وَاحِدْ يْطِيعْ وْصَايَا الشَّرِيعَة، يَحْيَا بِيهَا». <verse eid="ROM 10:5" /><verse number="6" style="v" sid="ROM 10:6" />آمَا عَالصَّلَاحْ الِّي يْجِي بِالإِيمَانْ يْقُولْ: «مَا تْقُولِشْ فِي قَلْبِكْ: شْكُونْ بِشْ يِطْلِعْ لِلسْمَاء (بَاشْ يْهَبِّطْ المَسِيحْ)؟» <verse eid="ROM 10:6" /><verse number="7" style="v" sid="ROM 10:7" />وَلَّا: «شْكُونْ بِشْ يَهْبِطْ لِلْهَاوْيَة (بَاشْ يْطَلَّعْ المَسِيحْ مِنْ بِينْ المُوتَى)؟» <verse eid="ROM 10:7" /><verse number="8" style="v" sid="ROM 10:8" />مَالَا شْنُوَّة يْقُولْ؟ يْقُولْ: «الكِلْمَة قْرِيبَة مِنِّكْ، عْلَى لْسَانِكْ وفِي قَلْبِكْ». وهِيَّ كِلْمِةْ الإِيمَانْ الِّي نْبَشْرُوا بِيهَا. <verse eid="ROM 10:8" /><verse number="9" style="v" sid="ROM 10:9" />عْلَى خَاطِرْ كَانْ تِعْتَرِفْ بِلْسَانِكْ الِّي يَسُوعْ هُوَّ الرَّبْ، وتَمِّنْ فِي قَلْبِكْ الِّي اللَّهْ قَيْمُو مِالمُوتْ، تِنْجَى. <verse eid="ROM 10:9" /><verse number="10" style="v" sid="ROM 10:10" />عْلَى خَاطِرْ الِّي يَمِّنْ بْقَلْبُو اللَّهْ يِعْتَبْرُو صَالَحْ، ولِّي يِعْتَرِفْ بِلْسَانُو اللَّهْ يْنَجِّيهْ. <verse eid="ROM 10:10" /><verse number="11" style="v" sid="ROM 10:11" />كِيمَا تْقُولْ الكْتُبْ المُقَدْسَة: «الِّي يَمِّنْ بِيهْ عُمْرُو مَا يْخِيبْ». <verse eid="ROM 10:11" /><verse number="12" style="v" sid="ROM 10:12" />رَاهُو مَا فَمَّاشْ فَرْقْ بِينْ اليْهُودْ ولِّي مَاهُمْشْ يْهُودْ، عْلَى خَاطِرْ اللَّهْ هُوَّ رَبْهُمْ الكُلْ، يْفِيضْ بْخِيرُو عَلِّي يُطْلْبُوهْ الكُلْ. <verse eid="ROM 10:12" /><verse number="13" style="v" sid="ROM 10:13" />وكِيمَا تْقُولْ الكْتُبْ المُقَدْسَة «كُلْ مِنْ يُطْلُبْ إِسْمْ الرَّبْ يِنْجَى».<verse eid="ROM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14" />آمَا كِيفَاشْ يُطْلْبُوهْ وهُومَا مَا أَمْنُوشْ بِيهْ؟ وكِيفَاشْ يَمْنُوا وهُومَا مَا سَمْعُوشْ بِيهْ؟ وكِيفَاشْ يِسْمْعُوا وحَتَّى وَاحِدْ مَا بَشِّرْهُمْ؟ <verse eid="ROM 10:14" /><verse number="15" style="v" sid="ROM 10:15" />وكِيفَاشْ الوَاحِدْ يْبَشِّرْ إِذَا كَانْ اللَّهْ مَا بَعْثُوشْ؟ كِيمَا مَكْتُوبْ: «مَحْلَاهَا جَيِّتْ الِّي يْبَشْرُوا بِالخِيرْ».<verse eid="ROM 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 10:16" />آمَا مُشْ الكُلْ قِبْلُوا البْشَارَة. كِيفْ مَا قَالْ إِشَعْيَاءْ: «يَا رَبْ، شْكُونْ الِّي أَمَّنْ بِكْلَامْنَا؟» <verse eid="ROM 10:16" /><verse number="17" style="v" sid="ROM 10:17" />مَالَا الإِيمَانْ يْجِي نْتِيجِةْ رِسَالَة نِسِمْعُوهَا، والرِّسَالَة هِيَّ بْشَارِةْ المَسِيحْ.<verse eid="ROM 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 10:18" />آمَا آنَا نِسْإِلْ: زَعْمَة مَا سَمْعُوشْ؟ بِالطْبِيعَة سَمْعُوا! والكْتُبْ المُقَدْسَة تْقُولْ:</para>
  <para style="b" vid="ROM 10:18" />
  <para style="q1" vid="ROM 10:18">«صُوتْهُمْ وْصُلْ</para>
  <para style="q2" vid="ROM 10:18">لِلْأَرْضْ الكُلْ،</para>
  <para style="q1" vid="ROM 10:18">وكْلَامْهُمْ وْصُلْ</para>
  <para style="q2" vid="ROM 10:18">لْإِخِّرْ الدِّنْيَا».<verse eid="ROM 10:18" /></para>
  <para style="b" />
  <para style="m">
    <verse number="19" style="v" sid="ROM 10:19" />ونِسْإِلْ مَرَّة أُخْرَى: زَعْمَة شَعْبْ إِسْرَائِيلْ مَا فْهِمْشْ؟ بِالطْبِيعَة فْهِمْ. فِي الأُوِّلْ مُوسَى قَالْ:</para>
  <para style="b" vid="ROM 10:19" />
  <para style="q1" vid="ROM 10:19">«بِشْ نْخَلِّيكُمْ تْغِيرُوا</para>
  <para style="q2" vid="ROM 10:19">مِنْ شَعْبْ مَاهُوشْ شَعْبِي،</para>
  <para style="q1" vid="ROM 10:19">وتِتْغَشِشُّوا</para>
  <para style="q2" vid="ROM 10:19">بِسْبَبْ شَعْبْ جَاهِلْ».<verse eid="ROM 10:19" /></para>
  <para style="b" />
  <para style="m">
    <verse number="20" style="v" sid="ROM 10:20" />وإِشَعْيَاءْ يْقُولْ بْكُلْ جُرْأَة:</para>
  <para style="b" vid="ROM 10:20" />
  <para style="q1" vid="ROM 10:20">«الِّي مَا لَوْجُوشْ عْلِيَّا لْقَاوْنِي،</para>
  <para style="q2" vid="ROM 10:20">وظَهِّرْتْ رُوحِي لِلِّي مَا سِأْلُوشْ عْلِيَّا».<verse eid="ROM 10:20" /></para>
  <para style="b" />
  <para style="m">
    <verse number="21" style="v" sid="ROM 10:21" />آمَا يْقُولْ عْلَى شَعْبْ إِسْرَائِيلْ:</para>
  <para style="b" vid="ROM 10:21" />
  <para style="q1" vid="ROM 10:21">«مَدِّيتْ يِدِّي نْهَارْ بَعْدْ نْهَارْ</para>
  <para style="q2" vid="ROM 10:21">لْشَعْبْ عَاصِي ورَاسُو صْحِيحْ».<verse eid="ROM 10:21" /></para>
  <para style="b" />
  <chapter eid="ROM 10" />
  <chapter number="11" style="c" sid="ROM 11" />
  <para style="s">اللَّهْ مَا رْفَضْشْ شَعْبُو</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1" />وهُونِي نِسْإِلْ: يَاخِي اللَّهْ رْفَضْ شَعْبُو؟ بِالطْبِيعَة لَا! آنَا بِيدِي مِنْ بَنِي إِسْرَائِيلْ، مِنْ ذُرِّيِّةْ إِبْرَاهِيمْ، ومِنْ عَرْشْ بِنْيَامِينْ. <verse eid="ROM 11:1" /><verse number="2" style="v" sid="ROM 11:2" />اللَّهْ مَا رْفَضْشْ شَعْبُو الِّي عْرَفْهُمْ مِنْ قْبَلْ. يَاخِي مَا تَعْرْفُوشْ الِّي قَالِتُّو الكْتُبْ المُقَدْسَة عْلَى إِيلِيَّا وَقْتِلِّي شْكَى بْشَعْبْ إِسْرَائِيلْ لِلَّهْ وقَالْ: <verse eid="ROM 11:2" /><verse number="3" style="v" sid="ROM 11:3" />«يَا رَبْ! قَتْلُوا أَنْبِيَائِكْ، وهَدْمُوا البْلَايِصْ الِّي نَذْبْحُولِكْ فِيهَا القَرَابِينْ، ومَا بْقِيتْ كَانْ آنَا، وهَاهُمَ يْحِبُّوا يُقْتْلُونِي»؟ <verse eid="ROM 11:3" /><verse number="4" style="v" sid="ROM 11:4" />آمَا شْنُوَّة جَاوْبُو اللَّهْ؟ «خَلِّيتْ لْرُوحِي 7 000 رَاجِلْ مَا ثْنَاوِشْ رْكَايِبْهُمْ بَاشْ يِعْبْدُوا الإِلَاهْ بَعْلْ». <verse eid="ROM 11:4" /><verse number="5" style="v" sid="ROM 11:5" />ونَفْسْ الحْكَايَة فِي وَقْتْنَا هَاذَا، مَزَّالْ فَمَّة بْقِيَّة اخْتَارْهُمْ اللَّهْ بِالنِّعْمَة. <verse eid="ROM 11:5" /><verse number="6" style="v" sid="ROM 11:6" />وإِذَا كَانْ اخْتَارْهُمْ بِالنِّعْمَة، مَالَا رَاهُو مُشْ عْلَى أَسَاسْ أَعْمَالْهُمْ، مَا كَانِشْ النِّعْمَة تْوَلِّي مَاهِيشْ نِعْمَة.<verse eid="ROM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7" />مَالَا شْنُوَّة الِّي صَارْ؟ بَنِي إِسْرَائِيلْ مَا خْذَاوِشْ الِّي كَانُوا يْلَوْجُوا عْلِيهْ، آمَا الِّي اخْتَارْهُمْ اللَّهْ خْذَاوَهْ. والبْقِيَّة قْلُوبْهُمْ كْسَاحِتْ، <verse eid="ROM 11:7" /><verse number="8" style="v" sid="ROM 11:8" />كِيمَا مَكْتُوبْ:</para>
  <para style="b" vid="ROM 11:8" />
  <para style="q1" vid="ROM 11:8">«اللَّهْ عْطَاهُمْ عْقَلْ مَا يِفْهِمْشْ،</para>
  <para style="q2" vid="ROM 11:8">وعِينِينْ مَا تْشُوفِشْ،</para>
  <para style="q1" vid="ROM 11:8">ووِذْنِينْ مَا تِسْمَعْشْ،</para>
  <para style="q2" vid="ROM 11:8">حَتَّى لِلْيُومْ».<verse eid="ROM 11:8" /></para>
  <para style="b" />
  <para style="m">
    <verse number="9" style="v" sid="ROM 11:9" />ويْقُولْ دَاوِدْ:</para>
  <para style="b" vid="ROM 11:9" />
  <para style="q1" vid="ROM 11:9">«يِجْعِلْ طَاوْلِتْهُمْ تْوَلِّيلْهُمْ مَصْيْدَة وشَبْكَة</para>
  <para style="q2" vid="ROM 11:9">وحَجْرَة اطَّيَّحْهُمْ وعِقَابْ.<verse eid="ROM 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10" />ويِجْعِلْ عِينِيهُمْ تِظْلَامْ بَاشْ مَا يْشُوفُوشْ،</para>
  <para style="q2" vid="ROM 11:10">ويِجْعِلْ ظْهُورَاتْهُمْ تْكُونْ دِيمَا مِثْنِيَّة».<verse eid="ROM 11:10" /></para>
  <para style="b" />
  <para style="s">فُرْصِةْ النْجَاةْ لِلشُّعُوبْ الأُخْرَى</para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11" />وهُونِي نِسْإِلْ: يَاخِي اليْهُودْ كِي عَثْرُوا مَا عَادِشْ بِشْ يْقُومُوا؟ بِالطْبِيعَة لَا! آمَا عَثْرِتْهُمْ عْطَاتْ فُرْصِةْ النْجَاةْ لِلشُّعُوبْ الأُخْرَى، فَمَّاشْ مَا اليْهُودْ يْغِيرُوا مِنْهُمْ. <verse eid="ROM 11:11" /><verse number="12" style="v" sid="ROM 11:12" />إِذَا كَانْ عَثْرِتْهُمْ فِيهَا بَرْكَة كْبِيرَة لِلْعَالِمْ، وخْسَارِتْهُمْ فِيهَا بَرْكَة كْبِيرَة لِلشْعُوبْ الأُخْرَى، مَالَا قَدَّاشْ بِشْ تْكُونْ البَرْكَة أَعْظِمْ وَقْتِلِّي يِرْجْعُوا لِلَّهْ.<verse eid="ROM 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13" />وآنَا نْقُولْ فِي هَاذَا لِيكُمْ إِنْتُومَا الِّي مَاكُمْشْ يْهُودْ: بِمَا إِنِّي رَسُولْ لِلِّي مَاهُمْشْ يْهُودْ، وآنَا نَعْطِي قِيمَة كْبِيرَة لْخِدْمْتِي هَاذِي، <verse eid="ROM 11:13" /><verse number="14" style="v" sid="ROM 11:14" />فَمَّاشْ مَا خْوَاتِي اليْهُودْ يْغِيرُوا وانَّجِي حَتَّى شْوَيَّة مِنْهُمْ. <verse eid="ROM 11:14" /><verse number="15" style="v" sid="ROM 11:15" />وإِذَا كَانْ اللَّهْ خَلَّى العَالِمْ يِتْصَالَحْ مْعَاهْ وَقْتِلِّي رْفَضْهُمْ، مَالَا شْنِيَّة بِشْ تْكُونْ النْتِيجَةْ وَقْتِلِّي اللَّهْ يِقْبِلْهُمْ؟ مَا تْكُونْ إِلَّا حَيَاةْ لِلِّي هُومَا مُوتَى.<verse eid="ROM 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 11:16" />إِذَا كَانْ الخْمِيرَة مُقَدْسَة، مَالَا رَاهِي العْجِينَة الكُلْ مُقَدْسَة. وإِذَا كَانْ العْرُوقْ مُقَدْسَة، مَالَا رَاهِي الأَعْرَافْ الكُلْ مُقَدْسَة. <verse eid="ROM 11:16" /><verse number="17" style="v" sid="ROM 11:17" />آمَا كَانْ تْقَصِّتْ أَعْرَافْ مِالزِّيتُونَة الأَصْلِيَّة، الِّي هُومَا اليْهُودْ، وإِنْتِ الِّي مِنْ زِيتُونَة جَالْيَة، تْلَقِّمْتْ فِيهَا ووَلِّيتْ مْشَارِكْ فِي عْرُوقْهَا وفِلِّي تِتْغَذَّى بِيهْ، <verse eid="ROM 11:17" /><verse number="18" style="v" sid="ROM 11:18" />مَا تِتْفُوخِرْشْ عَالأَعْرَافْ الِّي تْقَصِّتْ. وبْآنَا حَقْ تِتْفُوخِرْ، مَادَامْ مُشْ إِنْتِ الِّي هَازِزْ عْرُوقْ الشَّجْرَة، آمَا هِيَّ الِّي هَازِّتِكْ. <verse eid="ROM 11:18" /><verse number="19" style="v" sid="ROM 11:19" />ومُمْكِنْ تْقُولْ: «الأَعْرَافْ تْقَصِّتْ بَاشْ آنَا نِتْلَقِّمْ فِي بْلَاصِتْهَا!». <verse eid="ROM 11:19" /><verse number="20" style="v" sid="ROM 11:20" />صْحِيحْ! هُومَا تْقَصُّوا عْلَى خَاطِرْ مَا أَمْنُوشْ، وإِنْتِ بْقِيتْ عْلَى خَاطِرْ إِيمَانِكْ. مَالَا مَا تِتْكَبِّرْشْ، آمَا خَافْ! <verse eid="ROM 11:20" /><verse number="21" style="v" sid="ROM 11:21" />وإِذَا كَانْ اللَّهْ مَا خَلَّاشْ الأَعْرَافْ الأَصْلِيِّينْ، زَعْمَة بِشْ يْخَلِّيكْ إِنْتِ؟<verse eid="ROM 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 11:22" />فَكِّرْ مْلِيحْ فِي لُطْفْ اللَّهْ وصُعْبُو. رَاهُو صْعِيبْ مْعَ الِّي بِعْدُوا، آمَا يُلْطِفْ بِيكْ إِنْتِ، مَادَامِكْ مَزِّلْتْ شَادِدْ فِي لُطْفُو. مَا كَانِشْ رَاكْ إِنْتِ زَادَا بِشْ تِتْقَصّْ. <verse eid="ROM 11:22" /><verse number="23" style="v" sid="ROM 11:23" />وحَتَّى الِّي بِعْدُوا، كَانْ مَا يْكَمْلُوشْ فِي قِلِّةْ إِيمَانْهُمْ، بِشْ يِتْلَقْمُوا، عْلَى خَاطِرْ اللَّهْ يْنَجِّمْ يْلَقِّمْهُمْ مِنْ جْدِيدْ. <verse eid="ROM 11:23" /><verse number="24" style="v" sid="ROM 11:24" />وإِذَا كَانْ إِنْتِ تْقَصِّيتْ مِنْ زِيتُونَة جَالْيَة إِنْتِ تَابَعْهَا بِطْبِيعْتِكْ، وتْلَقِّمْتْ فِي زِيتُونَة بَاهْيَة بِالرَّغْمْ الِّي هِيَّ مُشْ مِنْ طْبِيعْتِكْ، مَالَا مَا فَمَّاشْ مَا أَسْهِلْ مِنْ إِنُّو الأَعْرَافْ الِّي تْقَصِّتْ تِرْجَعْ تِتْلَقِّمْ فِي زِيتُونِتْهَا الأَصْلِيَّة.<verse eid="ROM 11:24" /></para>
  <para style="s">شْكُونْ يَعْرِفْ فِكْرْ اللَّهْ؟</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25" />يَا خْوَاتِي، مَا نْحِبِّشْ يَخْفَى عْلِيكُمْ هَا السِّرْ، بَاشْ مَا تِتْنَفْخُوشْ: رَاوْ جْمَاعَة مِنْ بَنِي إِسْرَائِيلْ قْلُوبْهُمْ بِشْ تُقْعُدْ كَاسْحَة، حَتَّى لِينْ يِكْمِلْ عْدَدْ النَّاسْ الِّي بِشْ يَمْنُوا مِالشْعُوبْ الأُخْرَى، <verse eid="ROM 11:25" /><verse number="26" style="v" sid="ROM 11:26" />وبِالطَّرِيقَة هَاذِي يِنْجَاوْ بَنِي إِسْرَائِيلْ الكُلْ. كِيمَا مَكْتُوبْ:</para>
  <para style="b" vid="ROM 11:26" />
  <para style="q1" vid="ROM 11:26">«المُنَجِّي بِشْ يْجِي مِنْ صِهْيَوْنْ،</para>
  <para style="q2" vid="ROM 11:26">وبِشْ يْنَحِّي الشَّرْ مِنْ بَنِي يَعْقُوبْ.<verse eid="ROM 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27" />ويْكُونْ هَاذَا عَهْدِي لِيهُمْ،</para>
  <para style="q2" vid="ROM 11:27">وَقْتِلِّي انَّحِّيلْهُمْ ذْنُوبْهُمْ».<verse eid="ROM 11:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="ROM 11:28" />اليْهُودْ مَا قِبْلُوشْ البْشَارَة، هَاذَاكَا عْلَاشْ وَلَّاوْ أَعْدَاءْ اللَّهْ لْمَصْلْحِتْكُمْ إِنْتُومَا. آمَا اللَّهْ اخْتَارْهُمْ ومَزَّالْ يْحِبْهُمْ عْلَى خَاطِرْ جْدُودْهُمْ. <verse eid="ROM 11:28" /><verse number="29" style="v" sid="ROM 11:29" />عْلَى خَاطِرْ اللَّهْ مَا يِنْدِمْشْ عَلِّي يَعْطِيهْ ولَا الِّي يِخْتَارُو. <verse eid="ROM 11:29" /><verse number="30" style="v" sid="ROM 11:30" />كِيمَا إِنْتُومَا المُشْ يْهُودْ كُنْتُوا قْبَلْ عَاصِينْ اللَّهْ، وتَوَّا تِرْحَمْتُوا بِسْبَبْ عِصْيَانْ اليْهُودْ، <verse eid="ROM 11:30" /><verse number="31" style="v" sid="ROM 11:31" />هُومَا تَوَّا عَاصِينْ اللَّهْ، بَاشْ يِتْرَحْمُوا بِسْبَبْ رَحْمَة اللَّهْ لِيكُمْ .<verse eid="ROM 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ROM 11:32" />عْلَى خَاطِرْ اللَّهْ رْبَطْ النَّاسْ الكُلْ فِي حَبْسْ العِصْيَانْ، بَاشْ يَرْحَمْهُمْ الكُلْ. <verse eid="ROM 11:32" /><verse number="33" style="v" sid="ROM 11:33" />قَدَّاشْ اللَّهْ غْنِيْ! ومَا أَعْظِمْ حِكِمْتُو ومَعْرِفْتُو! شْكُونْ يْنَجِّمْ يِفْهِمْ أَحْكَامُو؟ وشْكُونْ يْنَجِّمْ يَعْرِفْ قَصْدُو؟<verse eid="ROM 11:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="ROM 11:34" />«شْكُونْ يَعْرِفْ فِكْرْ اللَّهْ؟</para>
  <para style="q2" vid="ROM 11:34">وشْكُونْ يْدَبِّرْ عْلِيهْ آشْ يَعْمِلْ؟»<verse eid="ROM 11:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35" />«وَلَّا شْكُونْ الِّي عْطَاهْ حَاجَة</para>
  <para style="q2" vid="ROM 11:35">ولَازِمْ اللَّهْ يْرَجَّعْهَالُو؟»<verse eid="ROM 11:35" /></para>
  <para style="b" />
  <para style="m">
    <verse number="36" style="v" sid="ROM 11:36" />رَاهُو كُلْ شَيْ مِنُّو وبِيهْ ولِيهْ. لِيهْ المَجْدْ لِلْأَبَدْ. آمِينْ.<verse eid="ROM 11:36" /></para>
  <chapter eid="ROM 11" />
  <chapter number="12" style="c" sid="ROM 12" />
  <para style="s">حْيَاتْنَا الجْدِيدَة فِي المَسيحْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1" />مَالَا يَا أَخْوْتِي، بِمَا إِنُّو اللَّهْ رْحَمْنَا، نُطْلُبْ مِنْكُمْ تْقَدْمُوا بْدَنَّاتْكُمْ ضْحِيَّة حَيَّة مُقَدْسَة ومَقْبُولَة عَنْدْ اللَّهْ، وتْكُونْ هَاذِي عْبَادَة حَقِيقِيَّة تْقَدْمُوهَالُو. <verse eid="ROM 12:1" /><verse number="2" style="v" sid="ROM 12:2" />مَا اتَّبْعُوشْ العَالِمْ هَاذَا كِيفَاشْ يْعِيشْ، آمَا خَلِّيوْ اللَّهْ يْبَدْلِلْكُمْ قْلُوبْكُمْ ويْجَدْدِلْكُمْ تَفْكِيرْكُمْ، بَاشْ تْنَجْمُوا تَعْرْفُوا شْنِيَّة هِيَّ إِرَادِةْ اللَّهْ الصَّالْحَة والمَقْبُولَة والكَامْلَة.<verse eid="ROM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3" />وبِالنِّعْمَة الِّي عْطَاهَالِي اللَّهْ، نْوَصِّي كُلْ وَاحِدْ مِنْكُمْ بَاشْ مَا يَعْطِيشْ لْرُوحُو قِيمَة أَكْثِرْ مِاللَّازِمْ، آمَا يَعْطِيهَا القِيمَة المَعْقُولَة، عْلَى قَدْ الإِيمَانْ الِّي عْطَاهُولُو اللَّهْ. <verse eid="ROM 12:3" /><verse number="4" style="v" sid="ROM 12:4" />وكِيمَا فِي البْدَنْ الوَاحِدْ عَنْدْنَا بَرْشَة أَعْضَاءْ، آمَا مَاهُمْشْ الكُلْ يَعْمْلُوا فِي نَفْسْ الحَاجَة، <verse eid="ROM 12:4" /><verse number="5" style="v" sid="ROM 12:5" />أَحْنَا زَادَا نَفْسْ الشَّيْ، رَغْمِلِّي أَحْنَا بَرْشَة آمَا رَانَا بْدَنْ وَاحِدْ فِي المَسِيحْ، وكُلْ عُضُوْ تَابَعْ لِلْأَعْضَاءْ الأُخْرِينْ. <verse eid="ROM 12:5" /><verse number="6" style="v" sid="ROM 12:6" />وعَنْدْنَا هِيبَاتْ مِتْنَوْعَة، كُلْ وَاحِدْ حَسْبْ النِّعْمَة الِّي عْطَاهَالُو اللَّهْ. الِّي عَنْدُو هِيبِةْ النُّبُوَّة خَلِّيهْ يِتْنَبَّأْ حَسْبْ الِّي نَمْنُوا بِيهْ، <verse eid="ROM 12:6" /><verse number="7" style="v" sid="ROM 12:7" />ولِّي عَنْدُو هِيبِةْ الخِدْمَة خَلِّيهْ يِخْدِمْ، ولِّي عَنْدُو هِيبِةْ التَّعْلِيمْ خَلِّيهْ يْعَلِّمْ، <verse eid="ROM 12:7" /><verse number="8" style="v" sid="ROM 12:8" />ولِّي عَنْدُو هِيبِةْ التَّشْجِيعْ خَلِّيهْ يْشَجَّعْ، ولِّي هُوَّ كْرِيمْ خَلِّيهْ يَعْطِي مِنْ غِيرْ مَا يِحْسِبْ، ولِّي يْقُودْ خَلِّيهْ يْقُودْ بِاجْتِهَادْ، ولِّي عَنْدُو هِيبِةْ الرَّحْمَة خَلِّيهْ يَرْحِمْ وهُوَّ فَرْحَانْ.<verse eid="ROM 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9" />المْحَبَّة يِلْزِمْهَا تْكُونْ صَادْقَة. أَكْرْهُوا الشَّرْ، وشِدُّوا صْحِيحْ فِي الخِيرْ. <verse eid="ROM 12:9" /><verse number="10" style="v" sid="ROM 12:10" />حِبُّوا بْعَضْكُمْ كِيمَا الإِخْوَاتْ، وكُلْ وَاحِدْ يِكْرِمْ الآخِرْ ويْبَجْلُو أَكْثِرْ مِنْ رُوحُو. <verse eid="ROM 12:10" /><verse number="11" style="v" sid="ROM 12:11" />مَا تْكُونُوشْ بُخْلِيِّينْ آمَا كُونُوا مُجْتَهْدِينْ، وكُونُوا مِتْحَمْسِينْ بِالرُّوحْ فِي خِدْمِةْ الرَّبْ. <verse eid="ROM 12:11" /><verse number="12" style="v" sid="ROM 12:12" />إِفْرْحُوا فِي الرْجَى، أُصْبْرُوا فِي الضِّيقْ، ودَاوْمُوا عَالصَّلَاةْ. <verse eid="ROM 12:12" /><verse number="13" style="v" sid="ROM 12:13" />عَاوْنُوا القِدِّيسِينْ المُحْتَاجِينْ، وكُونُوا مِضْيَافِينْ لِلنَّاسْ الكُلْ.<verse eid="ROM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14" />بَارْكُوا الِّي يِضْطَهْدُوكُمْ، بَارْكُوا ومَا تَلْعْنُوشْ. <verse eid="ROM 12:14" /><verse number="15" style="v" sid="ROM 12:15" />إِفْرْحُوا مْعَ الفَرْحَانِينْ، وإِبْكِيوْ مْعَ الِّي يِبْكِيوْ. <verse eid="ROM 12:15" /><verse number="16" style="v" sid="ROM 12:16" />كُونُوا مِتْفَاهْمِينْ فِي بْعَضْكُمْ، مَا تِتْكَبْرُوشْ وإِقْبْلُوا الزْوَاوْلَى. ومَا تِحْسْبُوشْ رْوَاحْكُمْ أَذْكَى مِالأُخْرِينْ. <verse eid="ROM 12:16" /><verse number="17" style="v" sid="ROM 12:17" />مَا تْرَجْعُوشْ عَالشَّرْ بِالشَّرْ، آمَا أَحْرْصُوا بَاشْ تَعْمْلُوا الخِيرْ قُدَّامْ النَّاسْ الكُلْ. <verse eid="ROM 12:17" /><verse number="18" style="v" sid="ROM 12:18" />عِيشُوا فِي سَلَامْ مْعَ النَّاسْ الكُلْ عْلَى قَدْ مَا تَقْدْرُوا. <verse eid="ROM 12:18" /><verse number="19" style="v" sid="ROM 12:19" />يَا حْبَابِي مَا تِنْتَقْمُوشْ لِرْوَاحْكُمْ، آمَا خَلِّيوْ اللَّهْ هُوَّ الِّي يْعَاقِبْ، عْلَى خَاطِرْ الكْتُبْ المُقَدْسَة تْقُولْ:</para>
  <para style="b" vid="ROM 12:19" />
  <para style="q1" vid="ROM 12:19">«آنَا الِّي نِنْتَقِمْ،</para>
  <para style="q2" vid="ROM 12:19">وآنَا الِّي نْجَازِي،</para>
  <para style="q1" vid="ROM 12:19">يْقُولْ الرَّبْ».<verse eid="ROM 12:19" /></para>
  <para style="b" />
  <para style="m">
    <verse number="20" style="v" sid="ROM 12:20" />آمَا</para>
  <para style="b" vid="ROM 12:20" />
  <para style="q1" vid="ROM 12:20">«إِذَا عْدُوِّكْ جَاعْ وَكْلُو،</para>
  <para style="q2" vid="ROM 12:20">وإِذَا عْطُشْ شَرْبُو،</para>
  <para style="q1" vid="ROM 12:20">رَاكْ كِي تَعْمِلْ هَاذَا تْحَشْمُو عْلَى رُوحُو».<verse eid="ROM 12:20" /></para>
  <para style="b" />
  <para style="m">
    <verse number="21" style="v" sid="ROM 12:21" />مَا تْخَلِّيشْ الشَّرْ يِغْلْبِكْ، آمَا إِغْلِبْ الشَّرْ بِالخِيرْ.<verse eid="ROM 12:21" /></para>
  <chapter eid="ROM 12" />
  <chapter number="13" style="c" sid="ROM 13" />
  <para style="s">لَازِمْ نِخْضْعُوا لِلسُّلْطَة</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1" />لَازِمْ كُلْ إِنْسَانْ يِخْضَعْ لِلنَّاسْ الِّي فِي السُّلْطَة. عْلَى خَاطِرْ مَا فَمَّاشْ سُلْطَة مُشْ مِنْ عَنْدْ اللَّهْ، والسُّلَطْ المَوْجُودِينْ تَوَّا اللَّهْ هُوَّ الِّي حَطْهُمْ. <verse eid="ROM 13:1" /><verse number="2" style="v" sid="ROM 13:2" />هَاذَاكَا عْلَاشْ الِّي يْقَاوِمْ السُّلْطَة، هُوَّ قَاعِدْ يْقَاوِمْ فِي النِّظَامْ الِّي حَطُّو اللَّهْ، ولِّي يْقَاوْمُوا يِسْتْحَقُّوا العِقَابْ. <verse eid="ROM 13:2" /><verse number="3" style="v" sid="ROM 13:3" />الِّي يَعْمْلُوا الخِيرْ مَا يْخَافُوشْ مِالحُكَّامْ، آمَا الِّي يَعْمْلُوا الشَّرْ هُومَا الِّي يْخَافُوا مِنْهُمْ. تْحِبْ مَا تْخَافِشْ مِالشَّخْصْ الِّي فِي السُّلْطَة؟ أَعْمِلْ الخِيرْ تَوْ يَرْضَى عْلِيكْ، <verse eid="ROM 13:3" /><verse number="4" style="v" sid="ROM 13:4" />عْلَى خَاطْرُو يِخْدِمْ فِي اللَّهْ لْمَصْلَحْتِكْ إِنْتِ. آمَا كَانِكْ تَعْمِلْ فِي الشَّرْ لَازْمِكْ تْخَافْ، عْلَى خَاطِرْ مُشْ بِالفَارَغْ عَنْدُو السُّلْطَة ويْنَجِّمْ يُحْكُمْ عْلِيكْ بِالمُوتْ. هُوَّ يِخْدِمْ فِي اللَّهْ بَاشْ يْظَهَّرْ الغَضَبْ مْتَاعُو عَلِّي يَعْمْلُوا الشَّرْ ويْعَاقِبْهُمْ. <verse eid="ROM 13:4" /><verse number="5" style="v" sid="ROM 13:5" />مَالَا يِلْزِمْنَا نِخْضْعُوا لِلسُّلَطْ، مُشْ بَاشْ نَمْنْعُوا مِالعِقَابْ أَكَهَوْ، آمَا زَادَا بَاشْ نْرَاعِيوْ ضَمِيرْنَا.<verse eid="ROM 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 13:6" />هَاذَاكَا عْلَاشْ إِنْتُومَا تَدْفْعُوا فِي الضَّرَايِبْ. عْلَى خَاطِرْ النَّاسْ الِّي فِي السُّلْطَة كِي يِخْدْمُوا خِدْمِتْهُمْ رَاهُمْ يِخْدْمُوا فِي اللَّهْ . <verse eid="ROM 13:6" /><verse number="7" style="v" sid="ROM 13:7" />أَعْطِيوْ لْكُلْ وَاحِدْ حَقُّو: أَعْطِيوْ الضَّرَايِبْ لِلِّي يِلْزِمْكُمْ تَدْفْعُولُوا الضَّرَايِبْ، والأَدَاءَاتْ لِلِّي يِلْزِمْكُمْ تَدْفْعُولُوا الأَدَاءَاتْ، والإِحْتِرَامْ لِلِّي يِلْزِمْكُمْ تِحْتَرْمُوهْ، والقْدَرْ لِلِّي يِلْزِمْكُمْ تْقَدْرُوهْ.<verse eid="ROM 13:7" /></para>
  <para style="s">شِدُّوا صْحِيحْ فِي المْحَبَّة</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8" />مَا تْكُونُوشْ مُسَالِينْ لْحَتَّى حَدْ كَانْ بِمْحَبِّتْكُمْ لِبْعَضْكُمْ، رَاهُو الِّي يْحِبْ غِيرُو يْكُونْ طَبِّقْ الشَّرِيعَة الكُلْ. <verse eid="ROM 13:8" /><verse number="9" style="v" sid="ROM 13:9" />عْلَى خَاطِرْ الوْصَايَا الِّي تْقُولْ: «مَا تَزْنَاشْ، مَا تَعْمِلْشْ جْرِيمِةْ قَتْلْ، مَا تِسْرِقْشْ، مَا تِشْهِدْسْ بِالكِذْبْ، مَا تِشْتْهَاشْ» والوْصَايَا الأُخْرِينْ الكُلْ يِتْلَخْصُوا فِي الوْصِيَّة هَاذِي: «حِبْ قْرِيبِكْ كِيفْ مَا تْحِبْ رُوحِكْ». <verse eid="ROM 13:9" /><verse number="10" style="v" sid="ROM 13:10" />الِّي يْحِبْ قْرِيبُو مَا يَعْمِلُّوشْ الشَّرْ، وهَاذَا كِيفَاشْ المْحَبَّة إِتَّمِّمْ الشَّرِيعَة.<verse eid="ROM 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11" />وخَاصَّةً إِنْكُمْ تَعْرْفُوا الوَقْتْ الِّي أَحْنَا عَايْشِينْ فِيهْ، تَوَّا جَاتْ السَّاعَة بَاشْ تْفِيقُوا مِنْ نُومْكُمْ، رَاهِي نْجَاتْنَا أَقْرْبِلْنَا تَوَّا مِلِّي كَانِتْ وَقْتِلِّي أَمَّنَّا. <verse eid="ROM 13:11" /><verse number="12" style="v" sid="ROM 13:12" />قْرِيبْ يُوفَى اللِّيلْ ويِطْلَعْ النْهَارْ. مَالَا خَلِّينَا انَّحِّيوْ الأَعْمَالْ الِّي تِتْعْمَلْ فِي الظْلَامْ ونِلْبْسُوا سْلَاحْ النُّورْ. <verse eid="ROM 13:12" /><verse number="13" style="v" sid="ROM 13:13" />خَلِّينَا نِتْصَرْفُوا بْطَرِيقَة لَايْقَة كِيمَا نَاسْ يْعِيشُوا فِي النُّورْ: مُشْ بِالفْسَادْ والسِّكْرَة، ولَا بِالنْجَاسَة والفَاحْشَة، ولَا بِالعَرْكْ والحُسْدْ. <verse eid="ROM 13:13" /><verse number="14" style="v" sid="ROM 13:14" />آمَا خَلِّيوْ الرَّبْ يَسُوعْ المَسِيحْ يْكُونْ هُوَّ السْلَاحْ الِّي تِلْبْسُوهْ، ومَا تُقْعْدُوشْ لَاهِينْ بِشْهَاوِي الطْبِيعَة البَشَرِيَّة الفَاسْدَة.<verse eid="ROM 13:14" /></para>
  <chapter eid="ROM 13" />
  <chapter number="14" style="c" sid="ROM 14" />
  <para style="s">مَا تُحْكْمُوشْ عْلَى بَعَضْكُمْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1" />إِقْبْلُوا فِي وِسْطْكُمْ الِّي إِيمَانُو ضْعِيفْ، ومَا تُحْكْمُوشْ عْلَى أَفْكَارُو. <verse eid="ROM 14:1" /><verse number="2" style="v" sid="ROM 14:2" />فَمَّة وَاحِدْ يَمِّنْ الِّي هُوَّ يْنَجِّمْ يَاكِلْ مِنْ كُلْ شَيْ، وفَمَّة شْكُونْ إِيمَانُو ضْعِيفْ مَا يَاكِلْ كَانْ الخُضْرَة. <verse eid="ROM 14:2" /><verse number="3" style="v" sid="ROM 14:3" />الِّي يَاكِلْ مِنْ كُلْ شَيْ مَا يِلْزْمُوشْ يَحْقِرْ الِّي مَا يَاكِلْشْ كِيفُو، ولِّي مَا يَاكِلْشْ كُلْ شَيْ يِلْزْمُو مَا يُحْكُمْشْ عَلِّي يَاكِلْ، عْلَى خَاطِرْ اللَّهْ قِبْلُو. <verse eid="ROM 14:3" /><verse number="4" style="v" sid="ROM 14:4" />شْكُونِكْ إِنْتِ بَاشْ تُحْكُمْ عْلَى خْدِيمْ غِيرِكْ؟ هَاذَا قَرَارْ يْخُصْ سِيدُو، كَانْ يِثْبِتْ وَلَّا يِتْعَثِّرْ. ورَاهُو بِشْ يِثْبِتْ، عْلَى خَاطِرْ الرَّبْ قَادِرْ يْثَبْتُو.<verse eid="ROM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5" />فَمَّة زَادَا الِّي يْخَيِّرْ نْهَارْ عْلَى نْهَارْ آخِرْ، وفَمَّة الِّي عَنْدُو النْهَارَاتْ الكُلْ كِيفْ كِيفْ. خَلِّي كُلْ وَاحِدْ يْكُونْ مُقْتَنِعْ بْرَايُو. <verse eid="ROM 14:5" /><verse number="6" style="v" sid="ROM 14:6" />الِّي يْخَيِّرْ نْهَارْ عْلَى نْهَارْ آخِرْ، يْخَيْرُو بَاشْ يِكْرِمْ الرَّبْ. ولِّي يَاكِلْ كُلْ شَيْ، يَاكِلْ بَاشْ يِكْرِمْ الرَّبْ، عْلَى خَاطْرُو يُشْكُرْ اللَّهْ كِي يَاكِلْ. ولِّي مَا يَاكِلْشْ مِنْ كُلْ شَيْ رَاهُو مَا يَاكِلْشْ بَاشْ يِكْرِمْ الرَّبْ، وهُوَّ زَادَا يُشْكُرْ اللَّهْ. <verse eid="ROM 14:6" /><verse number="7" style="v" sid="ROM 14:7" />حَتَّى وَاحِدْ فِينَا مَاهُو عَايِشْ لْرُوحُو، وحَتَّى وَاحِدْ فِينَا مَا يْمُوتْ عْلَى خَاطِرْ رُوحُو. <verse eid="ROM 14:7" /><verse number="8" style="v" sid="ROM 14:8" />كَانْ عِشْنَا رَانَا نْعِيشُوا لِلرَّبْ، وكَانْ مُتْنَا رَانَا نْمُوتُوا لِلرَّبْ. مَالَا كَانْ عِشْنَا وَلَّا مُتْنَا، أَحْنَا لِلرَّبْ. <verse eid="ROM 14:8" /><verse number="9" style="v" sid="ROM 14:9" />هَاذَاكَا عْلَاشْ المَسِيحْ مَاتْ وقَامْ مِالمُوتْ: بَاشْ يْكُونْ رَبْ المُوتَى والحَيِّينْ.<verse eid="ROM 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 14:10" />عْلَاشْ مَالَا تُحْكُمْ عْلَى خُوكْ؟ وعْلَاشْ تَحْقِرْ فِي خُوكْ؟ رَانَا الكُلْنَا بِشْ نَاقْفُوا قُدَّامْ عَرْشْ اللَّهْ وبِشْ نِتْحَاسْبُوا، <verse eid="ROM 14:10" /><verse number="11" style="v" sid="ROM 14:11" />رَاهُو مَكْتُوبْ:</para>
  <para style="b" vid="ROM 14:11" />
  <para style="q1" vid="ROM 14:11">«آنَا الحَيْ، يْقُولْ الرَّبْ،</para>
  <para style="q2" vid="ROM 14:11">كُلْ رُكْبَة بِشْ تِسْجِدْلِي،</para>
  <para style="q1" vid="ROM 14:11">وكُلْ لْسَانْ بِشْ يِعْتَرِفْ الِّي آنَا اللَّهْ».<verse eid="ROM 14:11" /></para>
  <para style="b" />
  <para style="m">
    <verse number="12" style="v" sid="ROM 14:12" />مَالَا، كُلْ وَاحِدْ فِينَا بِشْ يَعْطِي حْسَابْ عْلَى رُوحُو قُدَّامْ اللَّهْ.<verse eid="ROM 14:12" /></para>
  <para style="s">اتْصَرْفُوا بْمَحَبَّة</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13" />خَلِّينَا مَا عَادِشْ نُحْكْمُوا عْلَى بْعَضْنَا، بِالعَكْسْ نْقَرْرُوا بِشْ مَا نَعْمْلُوشْ حَاجَة تْخَلِّي وَاحِدْ مِنْ خْوَاتْنَا يَعْثِرْ وَلَّا يْطِيحْ، <verse eid="ROM 14:13" /><verse number="14" style="v" sid="ROM 14:14" />وبِمَا إِنِّي مُؤْمِنْ بِالرَّبْ يَسُوعْ آنَا نَعْرِفْ ومِتْأَكِّدْ الِّي مَا فَمَّاشْ حَاجَة مَنْزُوسَة فِي حَدْ ذَاتْهَا، آمَا هِيَّ مَنْزُوسَة عَنْدْ الِّي يَعْتَبِرْهَا مَنْزُوسَة. <verse eid="ROM 14:14" /><verse number="15" style="v" sid="ROM 14:15" />إِذَا كَانْ الِّي تَاكِلْ فِيهْ يْحَزِّنْ خُوكْ، رَاكْ مَاكِشْ تِتْصَرِّفْ بِمْحَبَّة. مَا تْخَلِّيشْ مَاكِلْتِكْ تْكُونْ سْبَبْ فِي هْلَاكْ خُوكْ الِّي المَسِيحْ مَاتْ عْلَى خَاطْرُو، <verse eid="ROM 14:15" /><verse number="16" style="v" sid="ROM 14:16" />مَا تْخَلِّيشْ الِّي تَعْتَبْرُو بَاهِي بِالنِّسْبَة لِيكْ يِتْقَالْ عْلِيهْ كْلَامْ خَايِبْ. <verse eid="ROM 14:16" /><verse number="17" style="v" sid="ROM 14:17" />رَاهِي مَمْلِكْةْ اللَّهْ مَاهِيشْ مَاكْلَة وشْرَابْ، آمَا صَلَاحْ وسَلَامْ وفَرَحْ بِالرُّوحْ القُدُسْ. <verse eid="ROM 14:17" /><verse number="18" style="v" sid="ROM 14:18" />الِّي يِخْدِمْ المَسِيحْ بِالطَّرِيقَة هَاذِي، اللَّهْ يَرْضَى عْلِيهْ، والنَّاسْ يِمْدْحُوهْ.<verse eid="ROM 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19" />مَالَا خَلِّينَا نْتَبْعُوا الحَاجَاتْ الِّي تْجِيبْ السَّلَامْ، ولِّي بِيهَا نْقَوِّيوْ بْعَضْنَا. <verse eid="ROM 14:19" /><verse number="20" style="v" sid="ROM 14:20" />مَا تْخَلِّيشْ مَاكِلْتِكْ تْهِدْ الِّي يَعْمْلُو اللَّهْ. صْحِيحْ الِّي كُلْ شَيْ طَاهِرْ، آمَا مُشْ بَاهِي تْخَلِّي خُوكْ يِتْعَثِّرِ بِسْبَبْ مَاكِلْتِكْ، <verse eid="ROM 14:20" /><verse number="21" style="v" sid="ROM 14:21" />ومِالأَحْسِنْ إِنِّكْ لَا تَاكِلْ لْحَمْ ولَا تُشْرِبْ شْرَابْ ولَا تَعْمِلْ أَيْ حَاجَة تْخَلِّي خُوكْ يِتْعَثِّرْ، <verse eid="ROM 14:21" /><verse number="22" style="v" sid="ROM 14:22" />خَلِّي الِّي إِنْتِ مُقْتَنِعْ بِيهْ فِي المَوْضُوعْ هَاذَا بِينِكْ وبِينْ اللَّهْ. صَحَّة لِيهْ الِّي مَا يُحْكُمْشْ عْلَى رُوحُو وَقْتِلِّي يِتْصَرِّفْ حَسْبْ الِّي هُوَّ مُقْتَنِعْ بِيهْ. <verse eid="ROM 14:22" /><verse number="23" style="v" sid="ROM 14:23" />آمَا الِّي يَاكِلْ حَاجَة وهُوَّ شَاكِكْ فِيهَا، رَاهُو يِتِحْكَمْ عْلِيهْ، عْلَى خَاطْرُو تْصَرِّفْ مِنْ غِيرْ إِيمَانْ. وكُلْ مَا يِتَعْمَلْ مِنْ غِيرْ إِيمَانْ هُوَّ ذَنْبْ.<verse eid="ROM 14:23" /></para>
  <chapter eid="ROM 14" />
  <chapter number="15" style="c" sid="ROM 15" />
  <para style="s">وَسْعُوا بَالْكُمْ مْعَ الضْعَافْ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1" />أَحْنَا القْوِيِّينْ يِلْزِمْنَا نْوَسْعُوا بَالْنَا مْعَ الضْعَافْ، ومَا يِلْزِمْنَاشْ نْلَوْجُوا عَلِّي يْرَضِّينَا. <verse eid="ROM 15:1" /><verse number="2" style="v" sid="ROM 15:2" />وخَلِّي كُلْ وَاحِدْ فِينَا يْرَضِّي خُوهْ ويْوَجْهُو لِلخِيرْ، بَاشْ يِبْنِيهْ ويْقَوِّي إِيمَانُو. <verse eid="ROM 15:2" /><verse number="3" style="v" sid="ROM 15:3" />عْلَى خَاطِرْ المَسِيحْ مَا لَوِّجِشْ عَلِّي يْرَضِّيهْ هُوَّ، آمَا كِيمَا مَكْتُوبْ: «سَبَّانْ الِّي يْسِبُّوا فِيكْ جَاء عْلِيَّا». <verse eid="ROM 15:3" /><verse number="4" style="v" sid="ROM 15:4" />ولِّي تِكْتِبّْ قْبَلْ الكُلْ، تِكْتِبّْ بَاشْ نِتْعَلْمُوا مِنُّو، بَاشْ يْوَلِّي عَنْدْنَا رْجَى بِالصَّبْرْ والتَّشْجِيعْ الِّي فِي الكْتُبْ المُقَدْسَة.<verse eid="ROM 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 15:5" />وإِلَاهْ الصَّبْرْ والتَّشْجِيعْ يْعَاوِنْكُمْ بَاشْ تْكُونُوا بْرَأْيْ وَاحِدْ كِيمَا عَلِّمْنَا المَسِيحْ يَسُوعْ، <verse eid="ROM 15:5" /><verse number="6" style="v" sid="ROM 15:6" />بَاشْ تْمَجْدُوا اللَّهْ بُو رَبْنَا يَسُوعْ المَسِيحْ، بْقَلْبْ وَاحِدْ وبْصُوتْ وَاحِدْ.<verse eid="ROM 15:6" /></para>
  <para style="s">إِقْبْلُوا بْعَضْكُمْ</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7" />مَالَا إِقْبْلُوا بْعَضْكُمْ كِيمَا قْبِلْكُمْ المَسِيحْ، بَاشْ اللَّهْ يِتْمَجِّدْ. <verse eid="ROM 15:7" /><verse number="8" style="v" sid="ROM 15:8" />وآنَا نْقُلْكُمْ الِّي المَسِيحْ وَلَّى خَادِمْ لِلْيْهُودْ بَاشْ يُثْبِتْ الِّي اللَّهْ صَادِقْ، وبِشْ يْحَقِّقْ الوُعُودْ الِّي عْطَاهُمْ اللَّهْ لِلجْدُودْ، <verse eid="ROM 15:8" /><verse number="9" style="v" sid="ROM 15:9" />وبَاشْ الشُّعُوبْ الأُخْرِينْ يْمَجْدُوا اللَّهْ عْلَى رَحْمْتُو، كِيمَا مَكْتُوبْ:</para>
  <para style="b" vid="ROM 15:9" />
  <para style="q1" vid="ROM 15:9">«هَاذَاكَا عْلَاشْ بِشْ نِحْمْدِكْ وُسْطْ الشُّعُوبْ الأُخْرِينْ،</para>
  <para style="q2" vid="ROM 15:9">وبِشْ نْسَبِّحْ لْإِسْمِكْ».<verse eid="ROM 15:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="ROM 15:10" />ويْقُولْ زَادَا:</para>
  <para style="b" vid="ROM 15:10" />
  <para style="q1" vid="ROM 15:10">«إِفْرْحُوا يَا شْعُوبْ مْعَ شَعْبْ اللَّهْ!».<verse eid="ROM 15:10" /></para>
  <para style="b" />
  <para style="m">
    <verse number="11" style="v" sid="ROM 15:11" />ويْقُولْ مَرَّة أُخْرَى:</para>
  <para style="b" vid="ROM 15:11" />
  <para style="q1" vid="ROM 15:11">«سَبْحُوا الرَّبْ يَلِّي مَاكُمْشْ يْهُودْ.</para>
  <para style="q2" vid="ROM 15:11">إِحْمْدُوهْ يَا كُلْ الشُّعُوبْ».<verse eid="ROM 15:11" /></para>
  <para style="b" />
  <para style="m">
    <verse number="12" style="v" sid="ROM 15:12" />وقَالْ إِشَعْيَاءْ زَادَا:</para>
  <para style="b" vid="ROM 15:12" />
  <para style="q1" vid="ROM 15:12">«بِشْ يْجِي مِنْ ذُرِّيِّةْ يَسَّى الِّي يْقُومْ ويُحْكُمْ فِلِّي مَاهُمْشْ يْهُودْ،</para>
  <para style="q2" vid="ROM 15:12">والشُّعُوبْ يْحُطُّوا رْجَاهُمْ فِيهْ».<verse eid="ROM 15:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13" />وإِلَاهْ الرْجَى يِمْلَاكُمْ بِالفَرْحَة والسَّلَامْ بْإِيمَانْكُمْ بِيهْ، بَاشْ رْجَاكُمْ يْفِيضْ بْقُوِّةْ الرُّوحْ القُدُسْ!<verse eid="ROM 15:13" /></para>
  <para style="s">بُولِسْ يَحْكِي عْلَى خِدِمْتُو</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14" />آنَا بِيدِي يَا خْوَاتِي مِتْأَكِّدْ الِّي إِنْتُومَا مِلْيَانِينْ بِالصَّلَاحْ وبِالمَعْرْفَة، وقَادْرِينْ بَاشْ تْعَلْمُوا بْعَضْكُمْ. <verse eid="ROM 15:14" /><verse number="15" style="v" sid="ROM 15:15" />آمَا فَمَّة حَاجَاتْ حَبِّيتْ نْذَكِّرْكُمْ بِيهَا وكْتِبْتِلْكُمْ عْلِيهَا بْكُلْ جُرْأَة، بِالنِّعْمَة الِّي عْطَاهَالِي اللَّهْ، <verse eid="ROM 15:15" /><verse number="16" style="v" sid="ROM 15:16" />بَاشْ نْكُونْ خَادِمْ المَسِيحْ يَسُوعْ لِلِّي مَاهُمْشْ يْهُودْ. وكِيمَا الكَاهِنْ، نْوَصْلِلْهُمْ البْشَارَة، بَاشْ يْكُونُوا قُرْبَانْ مَقْبُولْ عَنْدْ اللَّهْ مُقَدْسِينْ بِالرُّوحْ القُدُسْ.<verse eid="ROM 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 15:17" />مَالَا عَنْدِي الحَقْ فِي المَسِيحْ يَسُوعْ بَاشْ نِتْفُوخِرْ بْخِدْمْتِي لِلَّهْ، <verse eid="ROM 15:17" /><verse number="18" style="v" sid="ROM 15:18" />ومَا نِتْجَرَّأْ نِتْكَلِّمْ كَانْ عَلِّي عَمْلُو المَسِيحْ عْلَى يْدَيَّا بَاشْ يْخَلِّي غِيرْ اليْهُودْ يْطِيعُوا اللَّهْ. عْمَلْ هَاذَا عْلَى طْرِيقْ كْلَامِي وأَفْعَالِي، <verse eid="ROM 15:18" /><verse number="19" style="v" sid="ROM 15:19" />بْقُوِّةْ المُعْجْزَاتْ والعْجَايِبْ، وبْقُوِّةْ رُوحْ اللَّهْ. ورَانِي كَمِّلْتْ التَّبْشِيرْ بِالمَسِيحْ مِنْ أُورْشَلِيمْ والبْلَايِصْ الِّي دَايْرِينْ بِيهَا حَتَّى لِلِّيرِيكُونْ. <verse eid="ROM 15:19" /><verse number="20" style="v" sid="ROM 15:20" />وحْرَصْتْ بَاشْ نْبَشِّرْ فِي البْلَايِصْ الِّي مَا تْبَشَّرْشْ فِيهَا بْإِسْمْ المَسِيحْ، بَاشْ مَا نِبْنِيشْ عْلَى سَاسْ حَطُّو غِيرِي، <verse eid="ROM 15:20" /><verse number="21" style="v" sid="ROM 15:21" />كِيمَا مَكْتُوبْ:</para>
  <para style="b" vid="ROM 15:21" />
  <para style="q1" vid="ROM 15:21">«الِّي مَا تْبَشْرُوشْ بِيهْ بِشْ يْشُوفُوا،</para>
  <para style="q2" vid="ROM 15:21">ولِّي مَا سَمْعُوشْ بِيهْ بِشْ يِفْهْمُوا».<verse eid="ROM 15:21" /></para>
  <para style="b" />
  <para style="m">
    <verse number="22" style="v" sid="ROM 15:22" />وهَاذَا الِّي خَلَّانِي بَرْشَة مَرَّاتْ مَا نَجَّمْتِشْ نْجِيكُمْ.<verse eid="ROM 15:22" /></para>
  <para style="s">بُولِسْ يْحِبْ يْزُورْ المُؤْمْنِينْ الِّي فِي رُومَا</para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 15:23" />آمَا تَوَّا مَادَامْنِي كَمَّلْتْ خِدْمْتِي فِي البْلَايِصْ هَاذُومَا، وآنَا لِيَّا بَرْشَة سْنِينْ مِتْشَوِّقْ نْحِبْ نْجِيكُمْ، <verse eid="ROM 15:23" /><verse number="24" style="v" sid="ROM 15:24" />مَذَابِيَّا نِتْعَدَّالْكُمْ وآنَا فِي طْرِيقِي لْإِسْبَانْيَا. وبَعْدْمَا نِتْمَتَّعْ بِشْوَيَّة وَقْتْ مْعَاكُمْ، نِتْمَنَّى تْعَاوْنُونِي بَاشْ نْكَمِّلْ سَفَرْتِي لْغَادِي. <verse eid="ROM 15:24" /><verse number="25" style="v" sid="ROM 15:25" />آمَا تَوَّا رَانِي مَاشِي لْأُورْشَلِيمْ بَاشْ نْعَاوِنْ القِدِّيسِينْ، <verse eid="ROM 15:25" /><verse number="26" style="v" sid="ROM 15:26" />عْلَى خَاطِرْ الكَنَايِسْ فِي مَقْدُونِيَّة وأَخَائِيَة حَبُّوا يْعَاوْنُوا القِدِّيسِينْ المُحْتَاجِينْ الِّي فِي أُورْشَلِيمْ. <verse eid="ROM 15:26" /><verse number="27" style="v" sid="ROM 15:27" />وعَمْلُوا هَاذَا وهُومَا فَرْحَانِينْ، وفِي الحْقِيقَة هَاذَا وَاجِبْ عْلِيهُمْ. عْلَى خَاطِرْ، إِذَا كَانْ اليْهُودْ شَارْكُوا بَرَكَاتْهُمْ الرُّوحِيَّة مْعَ الشُّعُوبْ الأُخْرِينْ، مَالَا الشُّعُوبْ الأُخْرِينْ يِلْزِمْهُمْ يِخْدْمُوا اليْهُودْ بِالبَرَكَاتْ المَادِّيَة. <verse eid="ROM 15:27" /><verse number="28" style="v" sid="ROM 15:28" />وبَعْدْمَا نْكَمِّلْ المُهِمَّة هَاذِي ونَعْطِيهُمْ الفْلُوسْ، نِتْعَدَّالْكُمْ وآنَا فِي طْرِيقِي لْإِسْبَانْيَا. <verse eid="ROM 15:28" /><verse number="29" style="v" sid="ROM 15:29" />وآنَا نَعْرِفْ الِّي وَقْتِلِّي نْجِي، بِشْ نْجِيكُمْ بْبَرْكَة المَسِيحْ كَامْلَة.<verse eid="ROM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30" />يَا خْوَاتِي، نُطْلُبْ مِنْكُمْ بْإِسْمْ رَبْنَا يَسُوعْ المَسِيحْ وبِمْحَبِّةْ الرُّوحْ القُدُسْ، تْجَاهْدُوا مْعَايَا بِصْلَاتْكُمْ لِلَّهْ عْلَى خَاطْرِي، <verse eid="ROM 15:30" /><verse number="31" style="v" sid="ROM 15:31" />بَاشْ يْنَجِّينِي مِلِّي مَاهُمْشْ مُؤْمْنِينْ فِي مَنْطَقْةْ اليَهُودِيَّة، ويْخَلِّي خِدْمْتِي فِي أُورْشَلِيمْ مَقْبُولَة عَنْدْ القِدِّيسِينْ، <verse eid="ROM 15:31" /><verse number="32" style="v" sid="ROM 15:32" />وهَكَّا، كَانْ حَبْ رَبِّي، نْجِيكُمْ وآنَا مَلْيَانْ بِالفَرْحَة، ونَرْتَاحْ عَنْدْكُمْ. <verse eid="ROM 15:32" /><verse number="33" style="v" sid="ROM 15:33" />وإِلَاهْ السَّلَامْ يْكُونْ مْعَاكُمْ الكُلْ. آمِينْ.<verse eid="ROM 15:33" /></para>
  <chapter eid="ROM 15" />
  <chapter number="16" style="c" sid="ROM 16" />
  <para style="s">سْلَامْ خَاصْ ووْصَايَا</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1" />نْوَصِّيكُمْ عْلَى أُخْتْنَا فِيبِي، الِّي تِخْدِمْ فِي كْنِيسِةْ كَنْخَرِيَّة <verse eid="ROM 16:1" /><verse number="2" style="v" sid="ROM 16:2" />بَاشْ تِسْتَقْبْلُوهَا فِي الرَّبْ كِيمَا يْلِيقْ بِالقِدِّيسِينْ، وعَاوْنُوهَا فِي أَيْ حَاجَة تِسْتْحَقْهَا مِنْكُمْ، عْلَى خَاطِرْهَا كَانِتْ تْعَاوِنْ فِي بَرْشَة نَاسْ ومِنْهُمْ آنَا.<verse eid="ROM 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3" />سَلْمُوا عْلَى بْرِيسْكِلَّا ورَاجِلْهَا أَكِيلَا، الِّي يْشَارْكُونِي فِي خِدْمِةْ يَسُوعْ المَسِيحْ، <verse eid="ROM 16:3" /><verse number="4" style="v" sid="ROM 16:4" />ولِّي خَاطْرُوا بِحْيَاتْهُمْ عْلَى خَاطْرِي. ومُشْ آنَا بَرْكْ نُشْكُرْهُمْ، الكَنَايِسْ الِّي مُشْ مِنْ أَصْلْ يْهُودِي الكُلْ يُشْكْرُوهُمْ. <verse eid="ROM 16:4" /><verse number="5" style="v" sid="ROM 16:5" />سَلْمُوا زَادَا عْلَى الكْنِيسَة الِّي فِي دَارْهُمْ. سَلْمُوا عْلَى حْبِيبِي أَبَيْنِتُوسْ، أَوِّلْ وَاحِدْ أَمَّنْ بِالمَسِيحْ فِي آسِيَّا. <verse eid="ROM 16:5" /><verse number="6" style="v" sid="ROM 16:6" />سَلْمُوا عْلَى مَرْيِمْ الِّي تِعْبِتْ بَرْشَة بَاشْ تِخْدِمْكُمْ. <verse eid="ROM 16:6" /><verse number="7" style="v" sid="ROM 16:7" />سَلْمُوا عْلَى أَنْدَرُونِيكُوسْ ويُونِيَاسْ الِّي يُقْرْبُولِي ولِّي كَانُوا مَرْبُوطِينْ مْعَايَا فِي الحَبْسْ، هُومَا عَنْدْهُمْ مْقَامْ كْبِيرْ بَرْشَة عَنْدْ الرُّسُلْ، وأَمْنُوا بِالمَسِيحْ قَبْلِي. <verse eid="ROM 16:7" /><verse number="8" style="v" sid="ROM 16:8" />سَلْمُوا عْلَى أَمْبِلْيَاسْ حْبِيبِي فِي الرَّبْ. <verse eid="ROM 16:8" /><verse number="9" style="v" sid="ROM 16:9" />سَلْمُوا عْلَى أُورْبَانُوسْ شْرِيكِي فِي خِدْمِةْ المَسِيحْ، وعْلَى حْبِيبِي إِسْتَاخِيسْ. <verse eid="ROM 16:9" /><verse number="10" style="v" sid="ROM 16:10" />سَلْمُوا عْلَى أَبُلِّسْ، الِّي بَيِّنْ الِّي هُوَّ بِالحَقْ ثَابِتْ فِي المَسِيحْ. سَلْمُوا عْلَى إِمَّالِي أَرِسْتُوبُولُوسْ. <verse eid="ROM 16:10" /><verse number="11" style="v" sid="ROM 16:11" />سَلْمُوا عْلَى قْرِيبِي هِيرُودِيُونْ وعَلِّي يَمْنُوا بِالرَّبْ مِنْ عَايْلِةْ نَرْكِيسُّوسْ. <verse eid="ROM 16:11" /><verse number="12" style="v" sid="ROM 16:12" />سَلْمُوا عْلَى تَرِيفَيْنَا وتَرِيفُوسَا الِّي يِخْدْمُوا فِي الرَّبْ بْكُلْ جِهْدْهُمْ. سَلْمُوا عْلَى حْبِيبِتْنَا بَرِسِيسْ الِّي تِعْبِتْ بَرْشَة فِي خِدْمِةْ الرَّبْ. <verse eid="ROM 16:12" /><verse number="13" style="v" sid="ROM 16:13" />سَلْمُوا عْلَى رُوفُسْ الِّي الرَّبْ إِخْتَارُو، وعْلَى أُمُّو الِّي هِيَّ فِي مْقَامْ أُمِّي. <verse eid="ROM 16:13" /><verse number="14" style="v" sid="ROM 16:14" />سَلْمُوا عْلَى أَسِينْكِرِيتُسْ وفِلِيغُونْ وهَرْمِسْ وبَتْرُوبَاسْ وهَرْمَاسْ وعَالإِخْوَة الِّي مْعَاهُمْ. <verse eid="ROM 16:14" /><verse number="15" style="v" sid="ROM 16:15" />سَلْمُوا عْلَى فِيلُولُوغُسْ وجُولْيَا ونِيرْيُوسْ وأُخْتُو، وعْلَى أُولَمْبَاسْ والقِدِّيسِينْ الكُلْ الِّي مْعَاهُمْ. <verse eid="ROM 16:15" /><verse number="16" style="v" sid="ROM 16:16" />سَلْمُوا عْلَى بْعَضْكُمْ بْبُّوسَة طَاهْرَة. يْسَلْمُوا عْلِيكُمْ كَنَايِسْ المَسِيحْ الكُلْ.<verse eid="ROM 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17" />ونُطْلُبْ مِنْكُمْ يَا خْوَاتِي تْرُدُّوا بَالْكُمْ مِلِّي يْفَرْقُوا بِينَاتْكُمْ، ولِّي بِسْبَبْهُمْ النَّاسْ قَاعْدِينْ يِبْعْدُوا عَالإِيمَانْ، ويْعَلْمُوا بْعَكْسْ التَّعْلِيمْ الِّي تْعَلِّمْتُوهْ. إِبْعْدُوا عْلِيهُمْ. <verse eid="ROM 16:17" /><verse number="18" style="v" sid="ROM 16:18" />رَاهُو النَّاسْ هَاذُمْ مَاهُمْشْ يِخْدْمُوا فِي رَبْنَا يَسُوعْ المَسِيحْ، آمَا يِخْدْمُوا فِي شْهَاوِيهُمْ، ويْغُشُّوا فِي النَّاسْ البُسَطَاءْ بِالكْلَامْ العْسَلْ والحْدِيثْ الحْلُوْ. <verse eid="ROM 16:18" /><verse number="19" style="v" sid="ROM 16:19" />آمَا إِنْتُومَا، النَّاسْ الكُلْ يَعْرْفُوا طَاعِتْكُمْ، هَاذَاكَا عْلَاشْ آنَا فَرْحَانْ بِيكُمْ. ونْحِبْ تْكُونْ عَنْدْكُمْ حِكْمَة فِي كُلْ مَا هُوَّ خِيرْ، وتْكُونُوا طَاهْرِينْ مِنْ كُلْ مَا هُوَّ شَرْ. <verse eid="ROM 16:19" /><verse number="20" style="v" sid="ROM 16:20" />وإِلَاهْ السَّلَامْ بِشْ يَسْحَقْ الشِّيطَانْ تَحْتْ سَاقِيكُمْ عْلَى قْرِيبْ. نِعْمِةْ رَبْنَا يَسُوعْ تْكُونْ مْعَاكُمْ.<verse eid="ROM 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21" />يْسَلِّمْ عْلِيكُمْ تِيمُوثَاوُسْ شْرِيكِي فِي الخِدْمَة، ولُوكِيُوسْ ويَاسُونْ وسُوسِيبَاتْرُسْ الِّي يُقِرْبُولِي.<verse eid="ROM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22" />ونْسَلِّمْ عْلِيكُمْ، آنَا تَرْتِيُوسْ خُوكُمْ فِي الرَّبْ، الِّي كْتِبْتْ الرِّسَالَة هَاذِي.<verse eid="ROM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23" />يْسَلِّمْ عْلِيكُمْ غَايُوسْ الِّي مْضَيِّفْنِي ولِّي الكْنِيسَة تِتْلَمّْ فِي دَارُو. ويْسَلِّمْ عْلِيكُمْ أَرَاسْتُسْ أَمِينْ مَالْ المْدِينَة، ويْسَلِّمْ عْلِيكُمْ خُونَا كَوَارْتُسْ. <verse eid="ROM 16:23" /><verse number="24" style="v" sid="ROM 16:24" />نِعْمِةْ رَبْنَا يَسُوعْ المَسِيحْ تْكُونْ مْعَاكُمْ الكُلْ. آمِينْ.<verse eid="ROM 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25" />المَجْدْ لِلَّهْ القَادِرْ بَاشْ يْقَوِّيكُمْ بِبْشَارِةْ يَسُوعْ المَسِيحْ الِّي نْبَشِّرْ بِيهْ، البْشَارَة الِّي بِيهَا أَعْلِنْ اللَّهْ السِّرْ الِّي بْقَى مْخُبِّي لْوَقْتْ طْوِيلْ. <verse eid="ROM 16:25" /><verse number="26" style="v" sid="ROM 16:26" />وتَوَّا، تِكْشِفّْ السِّرْ هَاذَا ووَلَّى مَعْرُوفْ عَنْدْ الشُّعُوبْ الكُلْ عْلَى طْرِيقْ الِّي كِتْبُوهْ الأَنْبِيَاءْ، واللَّهْ الدَّايِمْ هُوَّ الِّي أْمَرْ بْهَاذَا بَاشْ يَمْنُوا بِيهْ الشُّعُوبْ ويْطِيعُوهْ. <verse eid="ROM 16:26" /><verse number="27" style="v" sid="ROM 16:27" />لِلَّهْ الِّي وَحْدُو حَكِيمْ، يْكُونْ المَجْدْ لِلْأَبَدْ، عْلَى طْرِيقْ يَسُوعْ المَسِيحْ. آمِينْ.<verse eid="ROM 16:27" /></para>
  <chapter eid="ROM 16" />
</usx>