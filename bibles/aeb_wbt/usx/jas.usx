<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JAS" style="id" />
  <para style="h">يَعْقُوبْ</para>
  <para style="toc1">رِسَالِةْ يَعْقُوبْ</para>
  <para style="toc2">يَعْقُوبْ</para>
  <para style="toc3">يَعْقُوبْ</para>
  <para style="mt">رِسَالِةْ يَعْقُوبْ</para>
  <chapter number="1" style="c" sid="JAS 1" />
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1" />سَلَامْ مِنْ يَعْقُوبْ خَادِمْ اللَّهْ والرَّبْ يَسُوعْ المَسِيحْ، لِلْأَثْنَاشِنْ عَرْشْ المْشَتْتِينْ فِي العَالِمْ الكُلْ.<verse eid="JAS 1:1" /></para>
  <para style="s">إِفْرْحُوا فِي المْحَايِنْ</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2" />يَا خْوَاتِي، وَقْتِلِّي تِتْعَدَّاوْ بْكُلْ أَنْوَاعْ المْحَايِنْ، إِحْسْبُوهَا فَرْحَة. <verse eid="JAS 1:2" /><verse number="3" style="v" sid="JAS 1:3" />عْلَى خَاطِرْ إِنْتُومَا تَعْرْفُوا الِّي وَقْتِلِّي إِيمَانْكُمْ يِغْلِبْ المْحَايِنْ، تِتْعَلْمُوا كِيفَاشْ تْشِدُّوا صْحِيحْ. <verse eid="JAS 1:3" /><verse number="4" style="v" sid="JAS 1:4" />أُصْبْرُوا لِلِّخِّرْ بَاشْ تْوَلِّيوْ نَاضْجِينْ وكَامْلِينْ ومَا نَاقِصْكُمْ شَيْ. <verse eid="JAS 1:4" /><verse number="5" style="v" sid="JAS 1:5" />وإِذَا كَانْ وَاحِدْ فِيكُمْ تُنْقْصُو الحِكْمَة، خَلِّيهْ يُطْلُبْهَا مِنْ عَنْدْ اللَّهْ الِّي يَعْطِي لِلنَّاسْ الكُلْ بْلَاشْ حْسَابْ ومَا يْعَايِرْشْ، واللَّهْ يَعْطِيهَالُو. <verse eid="JAS 1:5" /><verse number="6" style="v" sid="JAS 1:6" />آمَا لَازْمُو يُطْلُبْهَا بْإِيمَانْ ومَا يْشُكِّشْ، عْلَى خَاطِرْ الِّي يْشُكْ يْشَبَّهْ لْمُوجْ البْحَرْ الِّي الرِّيحْ تْهِزْ فِيهْ وتْجِيبْ. <verse eid="JAS 1:6" /><verse number="7" style="v" sid="JAS 1:7" />وَاحِدْ كِيمَا هَاذَا مَا يِلْزْمُوشْ يِتْوَقَّعْ الِّي هُوَّ بَاشْ يَاخِذْ حَاجَة مِنْ عَنْدْ الرَّبْ، <verse eid="JAS 1:7" /><verse number="8" style="v" sid="JAS 1:8" />عْلَى خَاطْرُو إِنْسَانْ بْرَايِينْ، يِتْرَدِّدْ فِي كُلْ حَاجَة يَعْمِلْهَا.<verse eid="JAS 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9" />لَازِمْ كُلْ مُؤْمِنْ فْقِيرْ يِفْرَحْ عْلَى خَاطِرْ اللَّهْ عَلَّالُو مْقَامُو، <verse eid="JAS 1:9" /><verse number="10" style="v" sid="JAS 1:10" />وكُلْ مُؤْمِنْ غْنِيْ يِفْرَحْ بِالمْقَامْ المِتْوَاضَعْ الِّي اللَّهْ عْطَاهُولُو، عْلَى خَاطْرُو بَاشْ يِذْبِلْ ويْمُوتْ كِي نَوَّارْ الحْشِيشْ. <verse eid="JAS 1:10" /><verse number="11" style="v" sid="JAS 1:11" />وَقْتِلِّي تُزْرِقْ الشَّمْسْ وسْخَانِتْهَا تْوَلِّي تَحْرِقْ، تْيَبِّسْ الحْشِيشْ ويِذْبِلْ نَوَّارُو ويِتْنَحَّى زِينُو. هَكَّاكَا يِذْبِلْ الغْنِيْ وهُوَّ غَاطِسْ فِي أُمُورُو.<verse eid="JAS 1:11" /></para>
  <para style="s">اللَّهْ مَا يْجَرَّبْ حَدْ بِالشَّرْ</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12" />صَحَّة لِيهْ الِّي يُصْبُرْ فِي المِحْنَة، عْلَى خَاطْرُو كِي يِنْجَحْ فِي الإِمْتِحَانْ يَاخِذْ تَاجْ الحَيَاةْ الِّي وْعِدْ بِيهْ اللَّهْ النَّاسْ الِّي يْحِبُّوهْ. <verse eid="JAS 1:12" /><verse number="13" style="v" sid="JAS 1:13" />وإِذَا وَاحِدْ طَاحْ فِي تَجْرْبَة، مَا يِلْزْمُوشْ يْقُولْ: «اللَّهْ هُوَّ الِّي يْجَرَّبْ فِيَّا!» عْلَى خَاطِرْ اللَّهْ مَا يِتْجَرَّبْشْ بِالشَّرْ ومَا يْجَرَّبْ حَتَّى حَدْ بِالشَّرْ، <verse eid="JAS 1:13" /><verse number="14" style="v" sid="JAS 1:14" />آمَا الإِنْسَانْ يِتْجَرَّبْ وَقْتِلِّي شَهْوْتُو تْغُرُّو وتِغْرِيهْ. <verse eid="JAS 1:14" /><verse number="15" style="v" sid="JAS 1:15" />والشَّهْوَة إِذَا تِحْبِلْ تْجِيبْ الذْنُوبْ، والذْنُوبْ إِذَا يِكْبْرُوا يْجِيبُوا المُوتْ.<verse eid="JAS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16" />يَا خْوَاتِي المَحْبُوبِينْ، مَا تُغْلْطُوشْ، <verse eid="JAS 1:16" /><verse number="17" style="v" sid="JAS 1:17" />رَاهِي كُلْ هْدِيَّة صَالْحَة وكُلْ هِيبَة كَامْلَة هِيَّ مِنْ فُوقْ، تْجِينَا مِنْ عَنْدْ اللَّهْ الِّي صْنَعْ أَنْوَارْ السْمَاء، ولِّي هُوَّ لَا يِتْبَدَّلْ ولَا يْدُورْ كِالظُّلْ، <verse eid="JAS 1:17" /><verse number="18" style="v" sid="JAS 1:18" />هُوَّ حَبْنَا نْوَلِّيوْ وْلَادُو عْلَى طْرِيقْ كِلْمِةْ الحَقْ، بَاشْ نْكُونُوا فِي المَرْتْبَة الأُولَى مْتَاعْ الِّي خَلْقُو الكُلْ.<verse eid="JAS 1:18" /></para>
  <para style="s">إِسْمْعُوا وطَبْقُوا</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19" />هَاذَاكَا عْلَاشْ، يَا خْوَاتِي المَحْبُوبِينْ، خَلِّي كُلْ وَاحِدْ فِيكُمْ يْكُونْ حَاضِرْ بَاشْ يِسْمَعْ، ومُشْ مَزْرُوبْ بَاشْ يِتْكَلِّمْ، ومَا يِتْغَشِّشْ فِيسَعْ، <verse eid="JAS 1:19" /><verse number="20" style="v" sid="JAS 1:20" />رَاهُو الإِنْسَانْ الِّي يِتْغَشِّشْ مَا يَعْمِلْشْ الصَّلَاحْ الِّي يْحِبُّو اللَّهْ. <verse eid="JAS 1:20" /><verse number="21" style="v" sid="JAS 1:21" />مَالَا نَحِّيوْ عْلِيكُمْ كُلْ مَاهُو نْجَاسَة وشَرْ، وإِقْبْلُوا بْتَوَاضُعْ الكِلْمَة الِّي اللَّهْ غْرِسْهَا فِيكُمْ ولِّي هِيَّ قَادْرَة تْنَجِّيكُمْ.<verse eid="JAS 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22" />مَا تْكُونُوشْ مِلِّي يِسْمْعُوا كْلَامْ اللَّهْ مِنْ غِيرْ مَا يْطَبْقُوهْ، هَكَّا تْوَلِّيوْ تْغُشُّوا فِي رْوَاحْكُمْ. <verse eid="JAS 1:22" /><verse number="23" style="v" sid="JAS 1:23" />الِّي يِسْمَعْ كْلَامْ اللَّهْ ومَا يَعْمِلْشْ بِيهْ، كِيفُو كِيفْ الِّي يُخْزُرْ لْوِجْهُو فِي المْرَايَة، <verse eid="JAS 1:23" /><verse number="24" style="v" sid="JAS 1:24" />وبَعْدْمَا يْشُوفُو يِمْشِي، وبِالوَقْتْ يِنْسَاهْ كِيفَاشْ كَانْ. <verse eid="JAS 1:24" /><verse number="25" style="v" sid="JAS 1:25" />آمَا الِّي يْثَبِّتْ فِي الشَّرِيعَة الكَامْلَة الِّي تْحَرِّرْ، ويْدَاوِمْ عْلِيهَا، مُشْ يِسْمَعْ ويِنْسَاهَا، آمَا يْطَبَّقْهَا، اللَّهْ يْبَارِكْلُو فِي كُلْ حَاجَة يَعْمِلْهَا.<verse eid="JAS 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26" />ولِّي مَاشِي فِي بَالُو الِّي هُوَّ مِدَّيِّنْ آمَا مَا يْشِدِّشْ لْسَانُو، رَاهُو يْغَلِّطْ فِي رُوحُو والتَّدَيُّنْ مْتَاعُو فَارَغْ. <verse eid="JAS 1:26" /><verse number="27" style="v" sid="JAS 1:27" />والدِّينْ الحْقِيقِي الطَّاهِرْ عَنْدْ اللَّهْ الآبْ هُوَّ إِنُّو الإِنْسَانْ يِتْلْهَى بِاليْتَامَى والهَجَّالَة فِي ضِيقْهُمْ، وإِنُّو يْصُونْ رُوحُو مِالفْسَادْ الِّي فِي الدِّنْيَا هَاذِي.<verse eid="JAS 1:27" /></para>
  <chapter eid="JAS 1" />
  <chapter number="2" style="c" sid="JAS 2" />
  <para style="s">مَا تْخَيْرُوا حَدْ عْلَى حَدْ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1" />يَا خْوَاتِي، مَادَامْكُمْ مُؤْمْنِينْ بْرَبْنَا يَسُوعْ المَسِيحْ، لِيهْ المَجْدْ، مَا تْخَيْرُوا حَدْ عْلَى حَدْ. <verse eid="JAS 2:1" /><verse number="2" style="v" sid="JAS 2:2" />إِذَا كَانْ دْخَلْ لْإِجْتِمَاعْكُمْ رَاجِلْ غْنِي فِي صُبْعُو خَاتِمْ ذْهَبْ ولَابِسْ لِبْسَة غَالْيَة، ومْبَعِّدْ دْخَلْ رَاجِلْ فْقِيرْ لَابِسْ لِبْسَة مْهِرْيَة، <verse eid="JAS 2:2" /><verse number="3" style="v" sid="JAS 2:3" />وتْلَفَّتُّوا لِلِّي لَابِسْ اللِّبْسَة الغَالْيَة وقُلْتُولُو: «إِنْتِ أُقْعُدْ هْنَا فِي البْلَاصَة الأُولَى»، وقُلْتُوا لِلْفْقِيرْ: «إِنْتِ آقِفْ غَادِي»، وَلَّا «أُقْعُدْ هْنَا عَنْدْ سَاقِينَا»، <verse eid="JAS 2:3" /><verse number="4" style="v" sid="JAS 2:4" />مُشْ هَكَّا تْخَيْرُوا فِي نَاسْ عْلَى نَاسْ، وتُحْكْمُوا بْأَفْكَارْكُمْ الشِّرِّيرَة؟<verse eid="JAS 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5" />إِسْمْعُوا، يَا خْوَاتِي المَحْبُوبِينْ: يَاخِي مُشْ اللَّهْ إِخْتَارْ فْقَارَى الدِّنْيَا هَاذِي بَاشْ يْكُونُوا غْنِيِّينْ فِي الإِيمَانْ، ويُورْثُوا المَمْلْكَة الِّي وْعِدْ بِيهَا الِّي يْحِبُّوهْ؟ <verse eid="JAS 2:5" /><verse number="6" style="v" sid="JAS 2:6" />آمَا إِنْتُومَا تَحْقْرُوا الفْقِيرْ! وشْكُونْهُمْ الِّي يُظْلْمُوا فِيكُمْ ويْهِزُّوا فِيكُمْ لِلْمْحَاكِمْ؟ مُشْ الغْنِيِّينْ؟ <verse eid="JAS 2:6" /><verse number="7" style="v" sid="JAS 2:7" />يَاخِي مُشْ هُومَا الِّي يَكْفْرُوا بِالإِسْمْ العْظِيمْ الِّي تْسَمِّيتُوا عْلِيهْ؟<verse eid="JAS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8" />إِذَا كَانْ تَعْمْلُوا بْأَعْظِمْ وْصِيَّة وَصَّاوْ بِيهَا الكْتُبْ المُقَدْسَة، ولِّي هِيَّ: «حِبْ قْرِيبِكْ كِيفْ مَا تْحِبْ رُوحِكْ»، رَاكُمْ تَعْمْلُوا فِي الصْحِيحْ. <verse eid="JAS 2:8" /><verse number="9" style="v" sid="JAS 2:9" />آمَا إِذَا خَيَّرْتُوا وَاحِدْ عْلَى الآخِرْ رَاكُمْ تَعْمْلُوا فِي ذَنْبْ والشَّرِيعَة تُحْكُمْ عْلِيكُمْ عْلَى خَاطِرْكُمْ مْخَالْفِينْهَا. <verse eid="JAS 2:9" /><verse number="10" style="v" sid="JAS 2:10" />ولِّي عْمَلْ بِالشَّرِيعَة الكُلْ وقَصِّرْ فِي وْصِيَّة وَحْدَة مِنْهَا، يْوَلِّي مُذْنِبْ، كَايِنُّو خَالِفْهَا الكُلْ، <verse eid="JAS 2:10" /><verse number="11" style="v" sid="JAS 2:11" />عْلَى خَاطِرْ الِّي قَالْ: «مَا تَزْنَاشْ»، قَالْ زَادَا: «مَا تَعْمِلْشْ جْرِيمِةْ قَتْلْ». وإِذَا كَانْ قْتَلْتْ آمَا مَا زْنِيتِشْ، رَاكْ مْخَالِفْ الشَّرِيعَة.<verse eid="JAS 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 2:12" />مَالَا تْكَلْمُوا وتْصَرْفُوا كِيمَا النَّاسْ الِّي بِشْ يُحْكُمْ عْلِيهُمْ اللَّهْ حَسْبْ شَرِيعِةْ الحُرِّيَة، <verse eid="JAS 2:12" /><verse number="13" style="v" sid="JAS 2:13" />عْلَى خَاطِرْ نْهَارْ الحْسَابْ، اللَّهْ مُشْ بِشْ يَرْحِمْ الِّي مَاكَانِشْ عَنْدُو رَحْمَة، آمَا الرَّحْمَة رَاهِي تِغْلِبْ الحُكْمْ.<verse eid="JAS 2:13" /></para>
  <para style="s">الإِيمَانْ والأَعْمَالْ</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14" />شْنِيَّة الفَايْدَة يَا خْوَاتِي كِي يْقُولْ وَاحِدْ الِّي هُوَّ مُؤْمِنْ آمَا أَفْعَالُو مَا تْوَرِّيشْ الِّي هُوَّ مُؤْمِنْ؟ زَعْمَة الإِيمَانْ هَاذَا يْنَجِّمْ يْنَجِّيهْ؟ <verse eid="JAS 2:14" /><verse number="15" style="v" sid="JAS 2:15" />إِذَا كَانْ فِي وِسْطْكُمْ خُو وإِلَّا أُخْتْ مِحْتَاجِينْ لِبْسَة ومَاكْلَة، <verse eid="JAS 2:15" /><verse number="16" style="v" sid="JAS 2:16" />شْنِيَّة الفَايْدَة كِي تْقُولِلْهُمْ: «رَبِّي يْنُوبْ! إِدَّفَّاوْ وإِشْبْعُوا»، وإِنْتِ مَا عْطِيتْهُمْشْ الِّي مِسْتْحَقِّينُو؟ <verse eid="JAS 2:16" /><verse number="17" style="v" sid="JAS 2:17" />هَكَّا الإِيمَانْ زَادَا، إِذَا كَانُو مِنْ غِيرْ أَعْمَالْ رَاهُو إِيمَانْ مِيِّتْ.<verse eid="JAS 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18" />ومُمْكِنْ وَاحِدْ مِنْكُمْ يْقُولْ: «إِنْتِ عَنْدِكْ إِيمَانْ وآنَا عَنْدِي أَعْمَالْ»، بَاهِي بَرْشَة! وَرِّينِي كِيفَاشْ يْكُونْ إِيمَانِكْ مِنْ غِيرْ أَعْمَالْ، وآنَا نْوَرِّيكْ إِيمَانِي بْأَعْمَالِي. <verse eid="JAS 2:18" /><verse number="19" style="v" sid="JAS 2:19" />إِنْتِ تَمِّنْ إِنُّو اللَّهْ وَاحِدْ؟ هَاذَا بَاهِي. حَتَّى الشْوَاطِنْ زَادَا يَمْنُوا بْهَاذَا ويُرْعْشُوا مِالخُوفْ.<verse eid="JAS 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JAS 2:20" />إِنْتِ يَلِّي مَا تِفْهِمِشْ، يَاخِي تْحِبْ نِثْبِتْلِكْ الِّي الإِيمَانْ مِنْ غِيرْ أَعْمَالْ مَا عَنْدُوشْ فَايْدَة؟ <verse eid="JAS 2:20" /><verse number="21" style="v" sid="JAS 2:21" />شُوفْ بُونَا إِبْرَاهِيمْ، يَاخِي مُشْ اللَّهْ إِعْتَبْرُو صَالَحْ بْأَعْمَالُو وَقْتِلِّي قَدِّمْ وِلْدُو إِسْحَاقْ ضْحِيَّة؟ <verse eid="JAS 2:21" /><verse number="22" style="v" sid="JAS 2:22" />وهَكَّا تْشُوفْ الِّي إِيمَانُو خْدِمْ مْعَ أَعْمَالُو، وإِيمَانُو وَلَّى كَامِلْ بِالأَعْمَالْ، <verse eid="JAS 2:22" /><verse number="23" style="v" sid="JAS 2:23" />وهَكَّا تَمْ الِّي تْقَالْ فِي الكْتُبْ المُقَدْسَة: «أَمَّنْ إِبْرَاهِيمْ بِاللَّهْ، يَاخِي تِحْسِبْلُو صَلَاحْ» وتْسَمَّى خَلِيلْ اللَّهْ. <verse eid="JAS 2:23" /><verse number="24" style="v" sid="JAS 2:24" />مَالَا شُفْتُوا الِّي الإِنْسَانْ يِتْحْسِبْ صَالَحْ، مُشْ بِالإِيمَانْ أَكَهَوْ، آمَا بِالأَعْمَالْ زَادَا.<verse eid="JAS 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25" />وزَادَا رَاحَابْ العَاهْرَة، مُشْ إِعْتَبَرْهَا اللَّهْ صَالْحَة بْأَعْمَالْهَا، وَقْتِلِّي خَبَّاتْ الرْجَالْ الزُّوزْ الِّي بَعْثُوهُمْ بَنِي إِسْرَائِيلْ، ومْبَعِّدْ هَرْبِتْهُمْ مِنْ ثْنِيَّة أُخْرَى؟ <verse eid="JAS 2:25" /><verse number="26" style="v" sid="JAS 2:26" />وكِيمَا البْدَنْ مِنْ غِيرْ رُوحْ مِيِّتْ، زَادَا الإِيمَانْ مِنْ غِيرْ أَعْمَالْ مِيِّتْ.<verse eid="JAS 2:26" /></para>
  <chapter eid="JAS 2" />
  <chapter number="3" style="c" sid="JAS 3" />
  <para style="s">أُلْجْمُوا لْسَانَاتْكُمْ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1" />يَا خْوَاتِي، مَا يِلْزِمْشْ بَرْشَة مِنْكُمْ يْكُونُوا مُعَلْمِينْ. كِيمَا تَعْرْفُوا، أَحْنَا المُعَلْمِينْ بِشْ نِتْحَاسْبُوا حْسَابْ أَقْوَى مِنْ غِيرْنَا. <verse eid="JAS 3:1" /><verse number="2" style="v" sid="JAS 3:2" />والكُلْنَا نُغْلْطُوا فِي بَرْشَة مَرَّاتْ. وإِذَا كَانْ وَاحِدْ مَا يُغْلُطْشْ فِي كْلَامُو، رَاهُو كَامِلْ ويْنَجِّمْ يِتْحَكِّمْ فِي بَدْنُو الكُلْ. <verse eid="JAS 3:2" /><verse number="3" style="v" sid="JAS 3:3" />مَثَلًا الحْصَانْ، أَحْنَا نْحُطُّوا اللْجَامْ فِي فُمُّو بَاشْ يْطَاوَعْنَا، ونِتْحَكْمُوا فِي بَدْنُو الكُلْ. <verse eid="JAS 3:3" /><verse number="4" style="v" sid="JAS 3:4" />والسْفِينَة زَادَا، رَغْمِلِّي هِيَّ كْبِيرَة، والرِّيحْ الِّي تْحَرِّكْ فِيهَا قْوِيَّة، دَفَّة صْغِيرَة إِدَّوَّرْهَا لْوِينْ يْحِبْ الرَّايِسْ. <verse eid="JAS 3:4" /><verse number="5" style="v" sid="JAS 3:5" />وهَكَّا اللْسَانْ زَادَا، هُوَّ عُضُوْ صْغِيرْ، آمَا يِتْفُوخِرْ بْأُمُورْ عْظِيمَة. وشُوفُوا كِيفَاشْ شْرَارَة صْغِيرَة تْنَجِّمْ تَحْرَقْ غَابَة كْبِيرَة! <verse eid="JAS 3:5" /><verse number="6" style="v" sid="JAS 3:6" />واللْسَانْ كِيمَا النَّارْ، ومِنْ بِينْ أَعْضَاءْ البْدَنْ، هُوَّ قُوَّة مْتَاعْ شَرْ، يْنَجِّسْ البْدَنْ الكُلْ ويْشَعِّلْ حْيَاتْنَا الكُلْ بْنَارْ جَايَة مِنْ جْهَنِّمْ.<verse eid="JAS 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 3:7" />الإِنْسَانْ يْنَجِّمْ يْرَوِّضْ كُلْ أَنْوَاعْ الحَيَوَانَاتْ: البَرِّيَّة ولِّي اطِّيرْ ولِّي تَزْحِفْ ولِّي فِي البْحَرْ، <verse eid="JAS 3:7" /><verse number="8" style="v" sid="JAS 3:8" />آمَا اللْسَانْ، حَتَّى حَدْ مَا يْنَجِّمْ يْرَوْضُو. هُوَّ شَرْ مَا يْنَجِّمْ حَدْ يْسَيْطِرْ عْلِيهْ، وهُوَّ مِلْيَانْ بِالسِّمْ الِّي يُقْتِلْ، <verse eid="JAS 3:8" /><verse number="9" style="v" sid="JAS 3:9" />بِيهْ نْبَارْكُوا رَبْنَا وبُونَا وبِيهْ نَلْعْنُوا النَّاسْ المَخْلُوقِينْ عْلَى صُورِةْ اللَّهْ. <verse eid="JAS 3:9" /><verse number="10" style="v" sid="JAS 3:10" />مِنْ نَفْسْ الفُمْ تُخْرُجْ البَرْكَة واللَّعْنَة، وهَاذَا مَا يِلْزْمُوشْ يْصِيرْ، يَا خْوَاتِي. <verse eid="JAS 3:10" /><verse number="11" style="v" sid="JAS 3:11" />يَاخِي تْنَجِّمْ نَفْسْ العِينْ تْخَرِّجْ مَاء حْلُوْ ومَاء مَالَحْ؟ <verse eid="JAS 3:11" /><verse number="12" style="v" sid="JAS 3:12" />يَا خْوَاتِي، تَوَّا تْنَجِّمْ الكَرْمُوسَة تْجِيبْ زِيتُونْ وَلَّا العِنْبَة تْجِيبْ كَرْمُوسْ؟ زَادَا العِينْ المَالْحَة مَا تْخَرِّجِّشْ مَاء حْلُوْ.<verse eid="JAS 3:12" /></para>
  <para style="s">الحِكْمَة الحَقِيقِيَّة</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13" />فِيكُمْ شْكُونْ حَكِيمْ وعَنْدُو فَهْمْ؟ خَلِّيهْ بْتَصَرُّفَاتُو البَاهْيَة يْوَرِّي أَعْمَالُو الِّي يَعْمِلْهَا بِالتَّوَاضُعْ الِّي يْجِي مِالحِكْمَة. <verse eid="JAS 3:13" /><verse number="14" style="v" sid="JAS 3:14" />آمَا إِذَا كَانْ قْلُوبْكُمْ فِيهَا الغِيرَة الِّي تُقْتِلْ والأَنَانِيَّة، مَالَا مَا تِتْفُوخْرُوشْ بْحِكْمِتْكُمْ ومَا تُنْكْرُوشْ الحَقْ. <verse eid="JAS 3:14" /><verse number="15" style="v" sid="JAS 3:15" />الحِكْمَة هَاذِي مَاهِيشْ مِنْ عَنْدْ اللَّهْ، آمَا رَاهِي حِكْمَة أَرْضِيَّة بَشَرِيَّة مِنْ عَنْدْ الشِّيطَانْ. <verse eid="JAS 3:15" /><verse number="16" style="v" sid="JAS 3:16" />عْلَى خَاطِرْ وِينْ فَمَّة الغِيرَة الِّي تُقْتِلْ والأَنَانِيَّة، تِلْقَى الفَوْضَى وأَنْوَاعْ الشَّرْ الكُلْ.<verse eid="JAS 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 3:17" />آمَا الحِكْمَة الِّي جَايَة مِنْ عَنْدْ اللَّهْ، هِيَّ قْبَلْ كُلْ شَيْ طَاهْرَة ومُسَالْمَة وطَيْبَة وسِيْسَة ومَلْيَانَة بِالرَّحْمَة والأَعْمَالْ الصَّالْحَة، مَا تْخَيَّرْ حَدْ عْلَى حَدْ ومَا تْنَافَقْشْ. <verse eid="JAS 3:17" /><verse number="18" style="v" sid="JAS 3:18" />والنَّاسْ الِّي يْحِبُّوا السَّلَامْ، يَزِرْعُوا السَّلَامْ، ويَحْصْدُوا الثَّمْرَة الِّي هِيَّ الصَّلَاحْ.<verse eid="JAS 3:18" /></para>
  <chapter eid="JAS 3" />
  <chapter number="4" style="c" sid="JAS 4" />
  <para style="s">إِخْضْعُوا لِلَّهْ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1" />شْنُوَّة الِّي يْخَلِّيكُمْ تِتْحَارْبُوا وتِتْعَارْكُوا؟ مُشْ الشْهَاوِي الِّي تِتْفَارَعْ فِيكُمْ مِنْ دَاخِلْ؟ <verse eid="JAS 4:1" /><verse number="2" style="v" sid="JAS 4:2" />تِشْتْهَاوْ حَاجَاتْ وتَاخْذُوهُمْشْ، تْوَلِّيوْ تُقْتْلُوا. تِحْسْدُوا عْلَى حَاجَاتْ ومَا تْنَجْمُوشْ تَاخْذُوهُمْ، تْوَلِّيوْ تِتْعَارْكُوا وتِتْحَارْبُوا. إِنْتُومَا مَا تَاخْذُوشْ عْلَى خَاطِرْكُمْ مَا تُطْلْبُوشْ مِنْ عَنْدْ اللَّهْ، <verse eid="JAS 4:2" /><verse number="3" style="v" sid="JAS 4:3" />وكِي تُطْلْبُوا مَا تَاخْذُوشْ، عْلَى خَاطِرْكُمْ تُطْلْبُوا بْنِيَّة خَايْبَة بَاشْ تْشَبْعُوا شْهَاوِيكُمْ.<verse eid="JAS 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JAS 4:4" />يَا خَايْنِينْ، يَاخِي مَا تَعْرْفُوشْ الِّي مْحَبِّةْ أُمُورْ الدِّنْيَا تْخَلِّيكُمْ تْعَادِيوْ اللَّهْ؟ إِيْ نْعَمْ الِّي يْحِبْ أُمُورْ الدِّنْيَا يْوَلِّي عْدُوْ لِلَّهْ. <verse eid="JAS 4:4" /><verse number="5" style="v" sid="JAS 4:5" />يَاخِي مَاشِي فِي بَالْكُمْ الِّي الكْتُبْ المُقَدْسَة تِتْكَلَّمْ فِي الفَارَغْ وَقْتِلِّي تْقُولْ الِّي الرُّوحْ السَّاكِنْ فِينَا يْغِيرْ؟ <verse eid="JAS 4:5" /><verse number="6" style="v" sid="JAS 4:6" />آمَا اللَّهْ يَعْطِينَا نِعْمَة أَعْظِمْ. هَاذَاكَا عْلَاشْ الكْتُبْ المُقَدْسَة تْقُولْ: «اللَّهْ يَاقِفْ ضِدْ المِتْكَبْرِينْ آمَا يَعْطِي نِعْمَة لِلْمِتْوَاضْعِينْ».<verse eid="JAS 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7" />مَالَا إِخْضْعُوا لِلَّهْ، وقَاوْمُوا إِبْلِيسْ وهَكَّا يُهْرُبْ مِنْكُمْ. <verse eid="JAS 4:7" /><verse number="8" style="v" sid="JAS 4:8" />أُقْرْبُوا لِلَّهْ وهُوَّ يُقْرُبْ مِنْكُمْ. نَظْفُوا يْدِيكُمْ يَا مُذْنْبِينْ، وطَهْرُوا قْلُوبْكُمْ يَلِّي مَاكُمْشْ ثَابْتِينْ عْلَى رَايْ وَاحِدْ. <verse eid="JAS 4:8" /><verse number="9" style="v" sid="JAS 4:9" />إِحْزْنُوا ونَوْحُوا وإِبْكِيوْ. خَلِّي ضُحْكُمْ يْوَلِّي بْكَاء وفَرْحِتْكُمْ تْوَلِّي غَمْ. <verse eid="JAS 4:9" /><verse number="10" style="v" sid="JAS 4:10" />تْوَاضْعُوا قُدَّامْ الرَّبْ، يِرْفَعْكُمْ.<verse eid="JAS 4:10" /></para>
  <para style="s">مَا تُحْكُمْشْ عْلَى قْرِيبِكْ</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11" />مَا تَحْكِيوْشْ عْلَى بْعَضْكُمْ بِالخَايِبْ، يَا خْوَاتِي. رَاهُو الِّي يَحْكِي عْلَى خُوهْ بِالخَايِبْ ويُحْكُمْ عْلِيهْ، هُوَّ فِي الحْقِيقَة يَحْكِي بِالخَايِبْ عَالشَّرِيعَة ويُحْكُمْ عْلِيهَا. وإِذَا كَانِكْ تُحْكُمْ عَالشَّرِيعَة، رَاكْ مَاكِشْ قَاعِدْ تَعْمِلْ بِيهَا، آمَا قَاعِدْ تُحْكُمْ عْلِيهَا. <verse eid="JAS 4:11" /><verse number="12" style="v" sid="JAS 4:12" />فَمَّة وَاحِدْ بَرْكْ يْحُطْ الشَّرِيعَة ووَاحِدْ بَرْكْ يُحْكُمْ، وهُوَّ اللَّهْ، الِّي وَحْدُو يْنَجِّمْ يْنَجِّي وَلَّا يِهْلِكْ. شْكُونِكْ إِنْتِ بَاشْ تُحْكُمْ عْلَى قْرِيبِكْ؟<verse eid="JAS 4:12" /></para>
  <para style="s">لَازِمْ نِتْوَكْلُوا عْلَى اللَّهْ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13" />وتَوَّا إِنْتُومَا الِّي تْقُولُوا: «اليُومْ وَلَّا غُدْوَة بِشْ نِمْشِيوْ لِلْمْدِينَة الفْلَانِيَّة، ونُقْعْدُوا فِيهَا عَامْ، ونْتَاجْرُوا ونِرْبْحُوا»، <verse eid="JAS 4:13" /><verse number="14" style="v" sid="JAS 4:14" />تِي إِنْتُومَا مَا تَعْرْفُوا شَيْ عْلَى غُدْوَة. يَاخِي شْنِيَّة هِيَّ حْيَاتْكُمْ؟ مَاهِي إِلَّا ضْبَابْ يُظْهُرْ شْوَيَّة ومْبَعِّدْ يِغْبِرْ. <verse eid="JAS 4:14" /><verse number="15" style="v" sid="JAS 4:15" />هَاذَاكَا عْلَاشْ يِلْزِمْكُمْ تْقُولُوا: «كَانْ حَبْ الرَّبْ، تَوْ نْعِيشُوا ونَعْمْلُوا الحَاجَة هَاذِي وَلَّا هَاذِيكَا!» <verse eid="JAS 4:15" /><verse number="16" style="v" sid="JAS 4:16" />آمَا إِنْتُومَا قَاعْدِينْ تِتْفُوخْرُوا وتِتْكَبْرُوا، وكُلْ فُخْرَة كِيمَا هَاذِي هِيَّ شَرْ. <verse eid="JAS 4:16" /><verse number="17" style="v" sid="JAS 4:17" />الِّي يَعْرِفْ يَعْمِلْ الخِيرْ ومَا يَعْمْلُوشْ، رَاهُو عْمَلْ ذَنْبْ.<verse eid="JAS 4:17" /></para>
  <chapter eid="JAS 4" />
  <chapter number="5" style="c" sid="JAS 5" />
  <para style="s">تَنْبِيهْ لِلْغْنِيِّينْ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1" />وتَوَّا إِنْتُومَا يَا غْنِيِينْ، إِبْكِيوْ ونَوْحُوا عَالمْصَايِبْ الِّي بِشْ تَهْبِطْ عْلِيكُمْ. <verse eid="JAS 5:1" /><verse number="2" style="v" sid="JAS 5:2" />ثَرْوِتْكُمْ فِسْدِتْ وحْوَايِجْكُمْ كْلَاهُمْ السُّوسْ. <verse eid="JAS 5:2" /><verse number="3" style="v" sid="JAS 5:3" />ذْهَبْكُمْ وفِضِّتْكُمْ كْلَاهُمْ الصْدِيدْ الِّي بِشْ يِشْهِدْ عْلِيكُمْ ويَاكِلْ لْحَمْكُمْ كِيفْ النَّارْ. تِكْنْزُوا وأَحْنَا فِي آخِرْ الأَيَّامَاتْ. <verse eid="JAS 5:3" /><verse number="4" style="v" sid="JAS 5:4" />أَهَوْكَا خْلَاصْ الخَدَّامَة الِّي حَصْدُولْكُمْ أَرَاضِيكُمْ ولِّي سْرِقْتُوهُمْ فِيهْ قَاعِدْ يْصِيحْ ويِشْهِدْ ضِدْكُمْ، وصْيَاحْ الحَصَّادَة بِيدْهُمْ سَمْعُو إِلَاهْ كُلْ قُوَّة. <verse eid="JAS 5:4" /><verse number="5" style="v" sid="JAS 5:5" />عِشْتُوا عَالأَرْضْ فِي الذْخَامَاتْ والخِيرَاتْ، وسَمِّنْتُوا رْوَاحْكُمْ كِيمَا يْسَمْنُوا العْجِلْ لِنْهَارْ الذْبِيحَة. <verse eid="JAS 5:5" /><verse number="6" style="v" sid="JAS 5:6" />حْكُمْتُوا عْلَى البَرِيءْ وقْتَلْتُوهْ مِنْ غِيرْ مَا يْقَاوِمْكُمْ.<verse eid="JAS 5:6" /></para>
  <para style="s">أُصْبْرُوا فِي المْحَايِنْ</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7" />آمَا إِنْتُومَا يَا خْوَاتِي، أُصْبْرُوا حَتَّى لِينْ يْجِي الرَّبْ. شُوفُوا الفَلَّاحْ كِيفَاشْ يُصْبِرْ حَتَّى الأَرْضْ تَعْطِي خِيرَاتْهَا الغَالْيَة، وكِيفَاشْ يِسْتَنَّى الزَّرْعْ لِينْ يِتِرْوَى مِنْ شْتَاء الخْرِيفْ وشْتَاء الرْبِيعْ. <verse eid="JAS 5:7" /><verse number="8" style="v" sid="JAS 5:8" />مَالَا إِنْتُومَا زَادَا، أُصْبْرُوا واتْشَجْعُوا، عْلَى خَاطِرْ الرَّبْ قْرِيبْ يْجِي. <verse eid="JAS 5:8" /><verse number="9" style="v" sid="JAS 5:9" />يَا خْوَاتِي، مَا تِتْشَكَّاوِشْ عْلَى بْعَضْكُمْ، بَاشْ اللَّهْ مَا يُحْكُمْشْ عْلِيكُمْ. عْلَى خَاطِرْ الِّي يُحْكُمْ عَالنَّاسْ، هَاوْ وَاقِفْ قُدَّامْ البَابْ.<verse eid="JAS 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JAS 5:10" />يَا خْوَاتِي، خَلِّيوْ الأَنْبِيَاءْ الِّي تْكَلْمُوا بْإِسْمْ الرَّبْ وهُومَا مِتْحَمْلِينْ العْذَابْ وصَابْرِينْ يْكُونُوا قُدْوَة لِيكُمْ. <verse eid="JAS 5:10" /><verse number="11" style="v" sid="JAS 5:11" />أَحْنَا نْقُولُوا: «صَحَّة لِيهُمْ الِّي صُبْرُوا». سْمَعْتُوا بْصَبْرْ أَيُّوبْ وشُفْتُوا كِيفَاشْ الرَّبْ بَارْكُوا فِي الإِخِّرْ. وهَاذَا يْوَرِّي الِّي الرَّبْ رَؤُوفْ ورَحِيمْ.<verse eid="JAS 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12" />وقْبَلْ كُلْ شَيْ، يَا خْوَاتِي، مَا تِحْلْفُوشْ لَا بِالسْمَاء ولَا بِالأَرْضْ ولَا بْحَتَّى شَيْ آخِرْ. خَلِّيوْ الإِيهْ مْتَاعْكُمْ تْكُونْ إِيهْ واللَّا مْتَاعْكُمْ تْكُونْ لَا، بَاشْ مَا يِتْحْكَمْشْ عْلِيكُمْ.<verse eid="JAS 5:12" /></para>
  <para style="s">قُوِّةْ الصْلَاةْ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13" />كَانْ فِيكُمْ شْكُونْ قَاعِدْ يْعَانِي؟ خَلِّيهْ يْصَلِّي! كَانْ فِيكُمْ شْكُونْ فَرْحَانْ؟ خَلِّيهْ يْسَبَّحْ! <verse eid="JAS 5:13" /><verse number="14" style="v" sid="JAS 5:14" />كَانْ فِيكُمْ شْكُونْ مْرِيضْ؟ خَلِّيهْ يِعَيِّطْ لِشْيُوخْ الكْنِيسَة بَاشْ يْصَلِّيوْ عْلَى خَاطْرُو، ويِدِهْنُولُو جْبِينُو بِشْوَيَّة زِيتْ بْإِسْمْ الرَّبْ. <verse eid="JAS 5:14" /><verse number="15" style="v" sid="JAS 5:15" />والصْلَاةْ بِالإِيمَانْ تِشْفِي المْرِيضْ، والرَّبْ يْرَجَّعْلُو صَحْتُو. وإِذَا كَانْ عْمَلْ ذَنْبْ يِغْفِرْهُولُو. <verse eid="JAS 5:15" /><verse number="16" style="v" sid="JAS 5:16" />إِعْتَرْفُوا بِذْنُوبْكُمْ لِبْعَضْكُمْ، وإِدْعِيوْ لِبْعَضْكُمْ بَاشْ تِتْشْفَاوْ. رَاهِي صْلَاةْ الإِنْسَانْ الصَّالَحْ عَنْدْهَا مَفْعُولْ قْوِيْ بَرْشَة. <verse eid="JAS 5:16" /><verse number="17" style="v" sid="JAS 5:17" />إِيلِيَّا كَانْ إِنْسَانْ عَادِي كِيفْنَا، وطْلَبْ مِنْ اللَّهْ بْقُوَّة بَاشْ الشْتَاء مَا تْصُبِّشْ، يَاخِي مَا صَبِّتْشْ عَالأَرْضْ لْمُدِّةْ ثْلَاثَة سْنِينْ ونُصْ. <verse eid="JAS 5:17" /><verse number="18" style="v" sid="JAS 5:18" />ومْبَعِّدْ طْلَبْ اللَّهْ مَرَّة أُخْرَى، يَاخِي صَبِّتْ الشْتَاء والأَرْضْ عْطَاتْ خِيرَاتْهَا.<verse eid="JAS 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19" />يَا خْوَاتِي، إِذَا وَاحِدْ فِيكُمْ بْعِدْ عَالحَقْ وجَاء وَاحِدْ آخِرْ ورَجْعُو، <verse eid="JAS 5:19" /><verse number="20" style="v" sid="JAS 5:20" />خَلِّيهْ يَعْرِفْ إِنُّو الِّي يْرَجَّعْ مُذْنِبْ مِالطْرِيقْ الِّي ضَايَعْ فِيهْ، رَاهُو نَجَّى رُوحْ مِالمُوتْ وسْتَرْ بَرْشَة ذْنُوبْ.<verse eid="JAS 5:20" /></para>
  <chapter eid="JAS 5" />
</usx>