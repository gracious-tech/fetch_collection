<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TI" style="id" />
  <para style="h">تِيمُوثَاوُسْ الأُولَى</para>
  <para style="toc1">رِسَالِةْ بُولِسْ الأُولَى لْتِيمُوثَاوُسْ</para>
  <para style="toc2">تِيمُوثَاوُسْ الأُولَى</para>
  <para style="toc3">تِيمُوثَاوُسْ الأُولَى</para>
  <para style="mt">رِسَالِةْ بُولِسْ الأُولَى لْتِيمُوثَاوُسْ</para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />مِنْ بُولِسْ، رَسُولْ يَسُوعْ المَسِيحْ بْحَسْبْ أَمْرْ اللَّهْ الِّي نَجَّانَا ويَسُوعْ المَسِيحْ الِّي هُوَّ رْجَانَا، <verse eid="1TI 1:1" /><verse number="2" style="v" sid="1TI 1:2" />لْتِيمُوثَاوُسْ، وِلْدِي الحْقِيقِي فِي الإِيمَانْ.</para>
  <para style="p" vid="1TI 1:2">النِّعْمَة والرَّحْمَة والسَّلَامْ لِيكْ مِنْ اللَّهْ الآبْ ومِنْ يَسُوعْ المَسِيحْ رَبْنَا.<verse eid="1TI 1:2" /></para>
  <para style="s">بُولِسْ يْنَبَّهْ مِالتَّعْلِيمْ الغَالِطْ</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />وَصِّيتِكْ، وآنَا مَاشِي لْمَقْدُونِيَّة، بَاشْ تُقْعُدْ فِي أَفَسُسْ بَاشْ تِمْنَعْ جْمَاعَة مِالنَّاسْ إِنْهُمْ يْعَلْمُوا تَعْلِيمْ يْخَالِفْ تَعْلِيمْنَا، <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />ومَا يِتِلْهَاوِشْ فِي الخْرَافَاتْ وحْكَايَاتْ النْسَبْ الِّي مَا تُوفَاشْ. رَاهِي الحَاجَاتْ هَاذِي تْجِيبْ النِّقَاشَاتْ الفَارْغَة ومَا تْخَلِّيشْ خِدْمِةْ اللَّهْ المِبْنِيَّة عَالإِيمَانْ تْقَدِّمْ. <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />والهَدَفْ مِالوْصِيَّة هَاذِي هُوَّ إِنُّو يْكُونْ عَنْدْهُمْ مْحَبَّة جَايَة مِنْ قَلْبْ طَاهِرْ وضَمِيرْ صَالَحْ وإِيمَانْ صَادِقْ. <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />فَمَّة نَاسْ بِعْدُوا عَالحَاجَاتْ البَاهْيَة هَاذِي وتَبْعُوا النِّقَاشَاتْ الفَارْغَة، <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />يْحِبُّوا يْوَلِّيوْ يْعَلْمُوا الشَّرِيعَة وهُومَا مُشْ فَاهْمِينْ الكْلَامْ الِّي قَاعْدِينْ يْقُولُوا فِيهْ ولَا الحَاجَاتْ الِّي شَادِّينْ فِيهَا صْحِيحْ.<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />وأَحْنَا نَعْرْفُوا الِّي الشَّرِيعَة صَالْحَة مَادَامْنَا نِسْتَعْمْلُوا فِيهَا بِالصْحِيحْ، <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />ونَعْرْفُوا الِّي الشَّرِيعَة مَاهِيشْ لِلنَّاسْ الصَّالْحِينْ، آمَا هِيَّ لِلْعَاصِينْ والأَشْرَارْ، لِلِّي مَا يْخَافُوشْ رَبِّي والمُذْنْبِينْ، لِلْمَنْزُوسِينْ والفَاسْدِينْ، لِلِّي يُقْتْلُوا أُبَّاتْهُمْ وأُمَّاتْهُمْ، ولْقَتَّالِينْ الأَرْوَاحْ، <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />لِلِّي يِزْنَاوْ ولِلرْجَالْ الِّي يُرْقْدُو مْعَ الرْجَالْ، لِلِّي يَخْطْفُوا النَّاسْ ويْرُدُّوهُمْ عَبِيدْ، لِلْكَذَّابِينْ ولِلِّي يِحْلْفُوا بِالكِذْبْ، ولْكُلْ وَاحِدْ يْخَالِفْ التَّعْلِيمْ الصْحِيحْ <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />المَوْجُودْ فِي البْشَارَة المَجِيدَة، الِّي عْطَاهَالِي اللَّهْ المُبَارَكْ أَمَانَة بِينْ يْدَيَّا.<verse eid="1TI 1:11" /></para>
  <para style="s">بُولِسْ يُشْكُرْ اللَّهْ عْلَى رَحْمْتُو</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />وآنَا نُشْكُرْ يَسُوعْ المَسِيحْ رَبْنَا الِّي قَوَّانِي واعْتَبَرْنِي نِسْتَاهِلْ ثِيقْتُو ودْعَانِي بَاشْ نِخْدْمُو، <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" />آنَا الِّي قْبَلْ كْفَرْتْ بِيهْ وجِيتْ ضِدُّو وسَبِّيتُو، آمَا اللَّهْ رْحَمْنِي عْلَى خَاطِرْ مَا كَانِشْ عَنْدِي إِيمَانْ ومَا كُنْتِشْ وَاعِي بِلِّي نَعْمِلْ فِيهْ، <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />وزَادْ فَاضْ عْلِيَّا بْنِعْمْتُو وبِالإِيمَانْ والمْحَبَّة الِّي فِي يَسُوعْ المَسِيحْ.<verse eid="1TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 1:15" />الكْلَامْ هَاذَا صَادِقْ ويِسْتْحَقْ القْبُولْ الكَامِلْ: هُوَّ إِنُّو يَسُوعْ المَسِيحْ جَاء لِلْعَالِمْ بَاشْ يْنَجِّي المُذْنْبِينْ، الِّي آنَا أَوِّلْهُمْ. <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />آمَا اللَّهْ رْحَمْنِي بَاشْ يْظَهِّرْ يَسُوعْ المَسِيحْ صَبْرُو العْظِيمْ فِيَّا آنَا أَوِّلْ المُذْنْبِينْ، ونْكُونْ مِثَالْ لِلنَّاسْ الِّي بِشْ يَاخْذُوا الحَيَاةْ الأَبَدِيَّة وَقْتِلِّي يَمْنُوا بِيهْ. <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />الكَرَامَة والمَجْدْ لِلْمَلِكْ الِّي مُلْكُو مَا يُوفَاشْ، الإِلَاهْ الوَاحِدْ الدَّايِمْ الِّي مَا تْشُوفُوشْ العِينْ. آمِينْ.<verse eid="1TI 1:17" /></para>
  <para style="s">وْصِيَّة لْتِيمُوثَاوِسْ</para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />يَا وِلْدِي تِيمُوثَاوُسْ، الوْصِيَّة الِّي نْخَلِّيهَالِكْ، ولِّي تْوَافِقْ النُّبُوءَاتْ الِّي تْقَالِتْ عْلِيكْ مِنْ قْبَلْ، هِيَّ إِنِّكْ اتَّبَّعْ النُّبُوءَاتْ بَاشْ تْجَاهِدْ أَحْسِنْ جِهَادْ، <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />وإِنْتِ شَادِدْ فِي الإِيمَانْ والضَّمِيرْ الصَّالَحْ. رَاهُو فَمَّة نَاسْ رَفْضُوا الضَّمِيرْ الصَّالَحْ، يَاخِي خِسْرُوا إِيمَانْهُمْ. <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />ومِنْ بِينْهُمْ هِيمِينَايُسْ وإِسْكَنْدَرْ الِّي سَلِّمْتْهُمْ لِلشِّيطَانْ بَاشْ يِتْرَبَّاوْ ومَا عَادِشْ يَكْفْرُوا بِاللَّهْ.<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="s">العِبَادَة فِي الكْنِيسَة</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />نُطْلُبْ مِنْكُمْ، قْبَلْ كُلْ شَيْ، بَاشْ تِدْعِيوْ وتْصَلِّيوْ وتِتْشَفْعُوا وتِحْمْدُوا اللَّهْ عْلَى خَاطِرْ النَّاسْ الكُلْ، <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />وعْلَى خَاطِرْ المُلُوكْ والنَّاسْ الِّي عَنْدْهُمْ سُلْطَة، بَاشْ نْعِيشُوا عِيشَة مُطْمَانَة وهَادْيَة، بْتَقْوَى وكَرَامَة. <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />وهَاذَا بَاهِي ومَقْبُولْ عَنْدْ اللَّهْ الِّي نَجَّانَا، <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />الِّي يْحِبْ إِنُّو النَّاسْ الكُلْ يِنْجَاوْ ويْوَلِّيوْ يَعْرْفُوا الحَقْ، <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />عْلَى خَاطِرْ فَمَّة إِلَاهْ وَاحِدْ، ومَا فَمَّة حَتَّى وَاسْطَة بِينُو وبِينْ النَّاسْ إِلَّا الإِنْسَانْ يَسُوعْ المَسِيحْ، <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />الِّي ضَحَّى بْرُوحُو بَاشْ يِفْدِي النَّاسْ الكُلْ. وهَاذِي الشْهَادَة الِّي قَدِّمْهَا يَسُوعْ فِي الوَقِتْ المُنَاسِبْ. <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" />وآنَا نْقُولْ الحَقْ ومَا نِكْذِبْشْ: اللَّهْ رَدْنِي مُبَشِّرْ ورَسُولْ لِلشْهَادَة هَاذِي بَاشْ نْعَلِّمْ الإِيمَانْ والحَقْ لِلِّي مَاهُمْشْ يْهُودْ.<verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />نْحِبْ الرْجَالْ فِي كُلْ بْلَاصَة يْصَلِّيوْ بْقْلُوبْ طَاهْرَة، مِنْ غِيرْ غُشْ ولَا عَرْكْ. <verse eid="1TI 2:8" /><verse number="9" style="v" sid="1TI 2:9" />ونْحِبْ زَادَا المْرَا تِلْبِسْ لِبْسَة مُحْتَرْمَة وتْزَيِّنْ رُوحْهَا بِالحِشْمَة والرْزَانَة، مُشْ الشْعَرْ المَظْفُورْ والذْهَبْ والجَوَاهِرْ واللِّبْسَة الغَالْيَة، <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />آمَا بْأَعْمَالْ صَالْحَة تْلِيقْ بِنْسَاء يْقُولُوا الِّي هُومَا يْعِيشُوا فِي التَقْوَى. <verse eid="1TI 2:10" /><verse number="11" style="v" sid="1TI 2:11" />والمْرَا يِلْزِمْهَا تِتْعَلِّمْ بِالرْيَاضْ وبْكُلْ خُضُوعْ، <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />ومَا نَسْمَحْشْ لِلْمْرَا بَاشْ تْعَلِّمْ وَلَّا تِتْسَلِّطْ عَالرَّاجِلْ، آمَا يِلْزِمْهَا تُقْعُدْ رَايْضَة، <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />عْلَى خَاطِرْ آدَمْ تِخْلَقّْ قْبَلْ حَوَّاء. <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />ومُشْ آدَمْ الِّي تْغَرْ، آمَا المْرَا هِيَّ الِّي تْغَرِّتْ وهَكَّا طَاحِتْ فِي المَعْصْيَة. <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />آمَا رَاهِي تِنْجَى بْجِيبَانْ الصْغَارْ كَانْ تِثْبِتْ فِي الإِيمَانْ والمْحَبَّة والقَدَاسَة مْعَ الرْزَانَة.<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="s">المَسْؤُولْ فِي الكْنِيسَة</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />بِالحَقْ: الِّي يْحِبْ يْوَلِّي مَسْؤُولْ فِي الكْنِيسَة، رَاهُو حَبْ حَاجَة بَاهْيَة. <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" />المَسْؤُولْ فِي الكْنِيسَة يِلْزْمُو مَا يْكُونِشْ عْلِيهْ لُومْ، رَاجِلْ لِمْرَا وَحْدَة، صَاحِي، يِتْحَكِّمْ فِي رُوحُو، مُحْتَرِمْ، مِضْيَافْ، قَادِرْ بَاشْ يْعَلِّمْ، <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />مُشْ سُوكَارْجِي ومُشْ مِتْهَوِّرْ، آمَا سِيِّسْ، مُسَالِمْ، ومَا يِجْرِيشْ وْرَاء الفْلُوسْ، <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />يَعْرِفْ كِيفَاشْ يِتْصَرِّفْ فِي دَارُو ويْخَلِّي وْلَادُو يْطِيعُوهْ ويِحْتَرْمُوهْ فِي كُلْ شَيْ. <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />خَاطِرْ الِّي مَا يَعْرِفْشْ يِتْصَرِّفْ فِي دَارُو، كِيفَاشْ بِشْ يِتْلْهَى بِكْنِيسِةْ اللَّهْ؟ <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />والمَسْؤُولْ فِي الكْنِيسَة، مَا يِلْزْمُوشْ يْكُونْ جْدِيدْ فِي الإِيمَانْ بَاشْ مَا يِتْكَبِّرْشْ ويِتْعَاقِبْ كِيفْ مَا تْعَاقِبْ إِبْلِيسْ. <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />ويِلْزِمْ تْكُونْ سُمْعْتُو بَاهْيَة عَنْدْ الِّي مَاهُمْشْ مِالكْنِيسَة، بَاشْ مَا يْجِيبِشْ العَارْ لْرُوحُو ويْحَصْلُو إِبْلِيسْ.<verse eid="1TI 3:7" /></para>
  <para style="s">الِّي يِخْدْمُوا فِي الكْنِيسَة</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />وزَادَا الِّي يِخِدْمُوا فِي الكْنِيسَة يِلْزِمْهُمْ يْكُونُوا مُحْتَرْمِينْ، وصَادْقِينْ، مُشْ مُدِمْنِينْ عَالشْرَابْ، ومُشْ طَمَّاعِينْ فِي الرِّبْحْ الحْرَامْ. <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />ويِلْزِمْهُمْ يْحَافْظُوا عْلَى حْقِيقِةْ الإِيمَانْ بْضَمِيرْ طَاهِرْ. <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />ويِلْزِمْ تْجَرْبُوهُمْ قْبَلْ، وإِذَا مَا عْلِيهُمْشْ لُومْ خَلِّيوْهُمْ يِخْدْمُوا فِي الكْنِيسَة. <verse eid="1TI 3:10" /><verse number="11" style="v" sid="1TI 3:11" />وزَادَا النْسَاء يِلْزِمْهُمْ يْكُونُوا مُحْتَرْمِينْ، مَا يْقَطْعُوشْ ويْرَيْشُوا، صَاحِينْ، وثِيقَة فِي كُلْ شَيْ. <verse eid="1TI 3:11" /><verse number="12" style="v" sid="1TI 3:12" />ولِّي يِخْدْمُوا فِي الكْنِيسَة لَازِمْ كُلْ وَاحِدْ فِيهُمْ يْكُونْ رَاجِلْ لِمْرَا وَحْدَة، ويَعْرِفْ كِيفَاشْ يِتْصَرِّفْ فِي دَارُو وصْغَارُو بِالبَاهِي. <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />عْلَى خَاطِرْ الِّي يِخْدْمُوا خِدْمِتْهُمْ بِالڨْدَا، يْوَلِّي عَنْدْهُمْ مْقَامْ عَالِي، وثِيقَة كْبِيرَة فِي الإِيمَانْ بْيَسُوعْ المَسِيحْ.<verse eid="1TI 3:13" /></para>
  <para style="s">السِّرْ العْظِيمْ</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />نِكْتِبْلِكْ الرِّسَالَة هَاذِي رَغْمِلِّي مِتْوَقَّعْ إِنِّي نْجِيكْ عْلَى قْرِيبْ، <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />بَاشْ كَانْ بْطِيتْ، تَعْرِفْ كِيفَاشْ تِتْصَرِّفْ فِي بِيتْ اللَّهْ، الِّي هِيَّ كْنِيسِةْ اللَّهْ الحَيْ، العُرْصَة والسَّاسْ مْتَاعْ الحَقْ. <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />مِنْ غِيرْ شَكْ، سِرّْ التَّقْوَى عْظِيمْ:</para>
  <para style="b" vid="1TI 3:16" />
  <para style="q1" vid="1TI 3:16">اللَّهْ ظْهُرْ فِي بْدَنْ إِنْسَانْ،</para>
  <para style="q2" vid="1TI 3:16">شْهِدْلُو الرُّوحْ إِنُّو صَالَحْ،</para>
  <para style="q1" vid="1TI 3:16">شَافِتُّو المْلَايْكَة،</para>
  <para style="q2" vid="1TI 3:16">تْبْشَّرْ بِيهْ فِي الشُّعُوبْ الكُلْ،</para>
  <para style="q1" vid="1TI 3:16">أَمْنُوا بِيهْ النَّاسْ فِي العَالِمْ،</para>
  <para style="q1" vid="1TI 3:16">وتِرْفَعّْ لِلسْمَاء فِي المَجْدْ.<verse eid="1TI 3:16" /></para>
  <para style="b" />
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="s">المُعَلْمِينْ الكَذَّابِينْ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />والرُّوحْ القُدُسْ يْقُولْ بْصَرَاحَة إِنُّو فِي الأَيَّامَاتْ اللِّخْرَة، فَمَّة نَاسْ بَاشْ يِبْعْدُوا عَالإِيمَانْ، ويْتَبْعُوا أَرْوَاحْ تْغَلِّطْهُمْ وتَعْلِيمْ مِنْ عَنْدْ الشْوَاطِنْ، <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />يُنْشْرُوا فِيهْ نَاسْ مُنَافْقِينْ كَذَّابِينْ ضْمَايِرْهُمْ فِسْدِتْ ومَاتِتْ. <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />يَمْنْعُوا النَّاسْ عَالعِرْسْ وعْلَى أَنْوَاعْ مَاكْلَة خْلَقْهَا اللَّهْ بَاشْ يَاكْلُوهَا بْشُكْرْ المُؤْمْنِينْ الِّي يَعْرْفُوا الحَقْ. <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />رَاهُو الِّي خَلْقُو اللَّهْ الكُلْ بَاهِي، ومَا يِلْزِمْ نُرْفْضُوا مِنُّو حَتَّى شَيْ، آمَا نِقِبْلُوهْ بِالشُّكْرْ، <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />عْلَى خَاطِرْ كُلْ شَيْ يْوَلِّي طَاهِرْ بْكِلْمِةْ اللَّهْ وبِالصَّلَاةْ.<verse eid="1TI 4:5" /></para>
  <para style="s">وْصَايَا لْتِيمُوثَاوِسْ</para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />وإِنْتِ، إِذَا فَكَّرْتْ الإِخْوَة بِالوْصَايَا هَاذُمْ، تْكُونْ خَادِمْ بَاهِي لْيَسُوعْ المَسِيحْ، مِتْغَذِّي مِنْ كْلَامْ الإِيمَانْ ومِالتَّعْلِيمْ الصْحِيحْ الِّي اتَّبَّعْ فِيهْ. <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />إِبْعِدْ عَالخْرَافَاتْ الزَّايْدَة والحْكَايَاتْ الفَارْغَة ودَرِّبْ رُوحِكْ عَالتَّقْوَى. <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />إِذَا كَانْ تَدْرِيبْ البْدَنْ فِيهْ شْوَيَّة فَايْدَة، التَّقْوَى فِيهَا فَايدَة لْكُلْ شَيْ، عْلَى خَاطِرْ فِيهَا وَعْدْ بِالحَيَاةْ فِي الدِّنْيَا والآخْرَة. <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />والكْلَامْ هَاذَا صَادِقْ ويِسْتْحَقْ القْبُولْ الكَامِلْ. <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />إِذَا كُنَّا نْجَاهْدُوا ونِتْعْبُوا، رَاهُو عْلَى خَاطِرْ عَنْدْنَا رْجَى فِي اللَّهْ الحَيْ الِّي يْنَجِّي النَّاسْ الكُلْ، وبِالأَخَصْ الِّي يَمْنُوا بِيهْ.<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />هَاذَا الِّي يِلْزْمِكْ تْوَصِّي بِيهْ وتْعَلْمُو. <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />مَا تْخَلِّيشْ حَتَّى حَدْ يَحْقْرِكْ عْلَى خَاطْرِكْ صْغِيرْ فِي العْمُرْ، آمَا كُونْ قُدْوَةْ لِلْمُؤْمْنِينْ فِي الكْلَامْ والتَّصَرُّفْ والمْحَبَّة والإِيمَانْ والطْهَارَة. <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />ودَاوِمْ عْلَى قْرَايِةْ الكْتُبْ المُقَدْسَة لِلْمُؤْمْنِينْ، وعَالتَّشْجِيعْ والتَّعْلِيمْ حَتَّى لِينْ نْجِي. <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />مَا تْهَمِّلْشْ الهِيبَة الِّي عَنْدِكْ، ولِّي خْذِيتْهَا بِالنُّبُوَّة وبْمُوَافْقِةْ الشْيُوخْ وَقْتِلِّي حَطُّوا يْدِيهُمْ عْلِيكْ. <verse eid="1TI 4:14" /><verse number="15" style="v" sid="1TI 4:15" />فَكِّرْ فِي الأُمُورْ هَاذِي وسَخِّرْ رُوحِكْ لِيهَا بَاشْ يْبَانْ لِلنَّاسْ الكُلْ الِّي إِنْتِ قَاعِدْ تِتْقَدِّمْ. <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />رُدْ بَالِكْ عْلَى رُوحِكْ وعَالتَّعْلِيمْ مْتَاعِكْ، عْلَى خَاطِرْ كِي تَجْتَهِدْ فِي هَاذَا رَاكْ تْنَجِّي رُوحِكْ ولِّي يِسْمْعُوا فِيكْ زَادَا.<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />مَا تْكِشِّشْ عَالكْبِيرْ فِي العْمُرْ، آمَا أَنْصْحُو بِالسْيَاسَة كَايِنُّو بُوكْ، واتْصَرِّفْ بْنَفْسْ الطَّرِيقَة مْعَ الشَّبَابْ كَايِنْهُمْ خْوَاتِكْ، <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />ومْعَ النْسَاءْ الكْبَارْ كِي الأُمَّاتْ، والبْنَاتْ تَعَامِلْ مْعَاهُمْ بْكُلْ طْهَارَة كَايِنْهُمْ خْوَاتِكْ.<verse eid="1TI 5:2" /></para>
  <para style="s">الهَجَّالَاتْ</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />إِكْرِمْ النْسَاء الهَجَّالَاتْ الِّي مَا عَنْدْهُمْشْ شْكُونْ يْقُومْ بِيهُمْ. <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />وإِذَا كَانِتْ الهَجَّالَة عَنْدْهَا وْلَادْ وَلَّا أَحْفَادْ، خَلِّي وْلَادْهُمْ وأَحْفَادْهُمْ يِتْعَلْمُوا فِي الأُوِّلْ كِيفَاشْ يِتْصَرْفُوا مْعَ أُمَّالِيهُمْ بِالتَّقْوَى ويْقُومُوا بْوَاجِبْهُمْ مْعَ وَالْدِيهُمْ، رَاهُو هَاذَا الِّي يْفَرَّحْ اللَّهْ. <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />آمَا الِّي هَجَّالَة بِالحَقْ، ومَا عَنْدْهَاشْ شْكُونْ يْقُومْ بِيهَا، هَاذِيكَا رْجَاهَا فِي اللَّهْ، تْصَلِّيلُو وتُطْلْبُو لِيلْ ونْهَارْ. <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />وكَانِكْ عَلِّي تِجْرِي وْرَاء الشْهَاوِي رَاهِي مِيْتَة حَتَّى ولَوْ كَانِتْ حَيَّة. <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />وَصِّيهُمْ بْهَاذَا الكُلْ بَاشْ مَا يْكُونِشْ عْلِيهُمْ لُومْ. <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />ولِّي مَا يِتْلْهَاشْ بِالنَّاسْ الِّي يُقْرْبُولُو، وبِالأَخَصْ عَايِلْتُو، رَاهُو نْكَرْ الإِيمَانْ وهُوَّ أَتْعِسْ مِلِّي مُشْ مُؤْمِنْ.<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />مَا تِتْقَيِّدْ مْرَا فِي دُوسِي النْسَاءْ الهَجَّالَة إِلَّا مَا يْكُونْ عْمُرْهَا 60 سْنَة عْلَى الأَقَلْ وكَانِتْ مَرْتْ رَاجِلْ وَاحِدْ، <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />ويِشْهْدُولْهَا الِّي هِيَّ تَعْمِلْ فِي أَعْمَالْ صَالْحَةْ، رَبَّاتْ وْلَادْهَا تُرْبْيَة بَاهْيَة، وضَيْفِتْ البْرَايْنِيَّة، غَسْلِتْ سَاقِينْ القِدِّيسِينْ، وعَاوْنِتْ الِّي عَنْدْهُمْ مَشَاكِلْ، وعَمْلِتْ الحَاجَاتْ البَاهْيَة الكُلْ. <verse eid="1TI 5:10" /><verse number="11" style="v" sid="1TI 5:11" />والهَجَّالَاتْ الصْغَارْ فِي العْمُرْ مَا تْقَيْدُوهُمِشْ فِي الدُّوسِي، رَاوْ كِي تِتْحَرِّكْ فِيهُمْ الشَّهْوَة يْنَجْمُوا يِسْتَغْنَاوْ عَالمَسِيحْ ويْوَلِّيوْ يْحِبُّوا يْعَرْسُوا. <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />وهَكَّا يْجِيبُوا اللُّومْ لِرْوَاحْهُمْ، خَاطِرْ كَسْرُوا عَهْدْهُمْ الأُولَانِي. <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />وزِيدْ عْلَى هَاذَا يِسْتَانْسُوا بِالبُخْلْ والدُّورَانْ مِنْ دَارْ لْدَارْ، ومُشْ بِالبُخْلْ أَكَهَوْ، آمَا زَادَا بِالحْدِيثْ الفَارِغْ واللَّهْوَة بِالحَاجَاتْ الِّي مَا تْخُصْهُمْشْ والكْلَامْ فِي حَاجَاتْ مَا تْلِيقِشْ. <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />هَاذَاكَا عْلَاشْ نْحِبْ الهَجَّالَاتْ الصْغَارْ فِي العْمُرْ يْعَرْسُوا ويْجِيبُوا صْغَارْ ويِتْلْهَاوْ بِدْيَارْهُمْ، بَاشْ العْدُو مَا يْشِدِّشْ عْلِينَا حَتَّى حَاجَة، <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />خَاصَّةً إِنُّو فَمَّة شْكُونْ مِنْهُمْ بِعْدُوا عَالثْنِيَّة وتَبْعُوا الشِّيطَانْ. <verse eid="1TI 5:15" /><verse number="16" style="v" sid="1TI 5:16" />وإِذَا كَانْ فَمَّة مُؤْمْنَة عَنْدْهَا هَجَّالَاتْ فِي عَايْلِتْهَا، خَلِّيهَا تْقُومْ بِيهُمْ ومَا تْثَقِّلْشْ عَالكْنِيسَة بَاشْ الكْنِيسَة تْنَجِّمْ تْعَاوِنْ الهَجَّالَاتْ الِّي مَا عَنْدْهُمْ حَدْ.<verse eid="1TI 5:16" /></para>
  <para style="s">شْيُوخْ الكْنِيسَة</para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />وشْيُوخْ الكْنِيسَة الِّي يِخْدْمُوا فِي خِدْمِتْهُمْ بِالڨْدَا يِسْتْحَقُّوا بَاشْ تِكْرْمُوهُمْ قَدْ الأُخْرِينْ مَرْتِينْ، وبِالأَخَصْ الِّي يِتْعْبُوا فِي التَّبْشِيرْ والتَّعْلِيمْ. <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" />عْلَى خَاطِرْ الكْتُبْ المُقَدْسَة تْقُولْ: «مَا تْحُطِّشْ كْمَامَة عْلَى فُمْ الثُّورْ وَقْتِلِّي يِدْرِسْ» وتْقُولْ زَادَا: «والخَدَّامْ مِنْ حَقُّو يُخْلُصْ». <verse eid="1TI 5:18" /><verse number="19" style="v" sid="1TI 5:19" />مَا تِقْبِلْشْ شْكَايَة عْلَى شِيخْ فِي الكْنِيسَة كَانْ بِشْهَادِةْ زُوزْ وَلَّا ثْلَاثَة شْهُودْ. <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />آمَا الِّي يَبْقَاوْ يَعْمْلُوا الذْنُوبْ، نَبَّهْ عْلِيهُمْ قُدَّامْ النَّاسْ الكُلْ بَاشْ البْقِيَّة يْخَافُوا.<verse eid="1TI 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1TI 5:21" />ونُطْلِبْ مِنِّكْ ونَلِحْ عْلِيكْ قُدَّامْ اللَّهْ ويَسُوعْ المَسِيحْ والمْلَايْكَة المُخْتَارِينْ بَاشْ تَعْمِلْ بِالوْصَايَا هَاذِي مِنْ غِيرْ مَا تْخَيِّرْ ولَا تْبَجِّلْ حَدْ عْلَى حَدْ. <verse eid="1TI 5:21" /><verse number="22" style="v" sid="1TI 5:22" />مَا تِزْرِبْشْ وتْحُطْ يْدِيكْ عْلَى وَاحِدْ بَاشْ تْوَافِقْ إِنُّو يْوَلِّي شِيخْ فِي الكْنِيسَة، ومَا تْشَارِكِشْ فِي ذْنُوبْ غِيرِكْ، وخَلِّي رُوحِكْ طَاهِرْ.<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />مَا عَادِشْ تُشْرُبْ المَاء أَكَهَوْ، آمَا أُشْرُبْ شْوَيَّة شْرَابْ عْلَى خَاطِرْ بَاهِي لْمَعْدْتِكْ والأَمْرَاضْ الِّي عَنْدِكْ.<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />فَمَّة نَاسْ ذْنُوبْهُمْ وَاضْحَة قْبَلْ مَا يِتْحَاسْبُوا، وفَمَّة شْكُونْ ذْنُوبْهُمْ مَا تُظْهُرْ كَانْ مْبَعِّدْ. <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />وزَادَا الأَعْمَالْ الصَّالْحَة وَاضْحَة، وحَتَّى الِّي مَاهِيشْ وَاضْحَة، مُشْ مُمْكِنْ تَبْقَى مْخُبْيَة.<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="s">وْصَايَا لِلْعْبِيدْ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />ويِلْزِمْ العَبِيدْ يَعْرْفُوا الِّي أَسْيَادْهُمْ يِسْتْحَقُّوا الإِحْتِرَامْ، بَاشْ حَتَّى حَدْ مَا يَكْفِرْ بْإِسْمْ اللَّهْ وبِالتَّعْلِيمْ. <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />وإِذَا كَانْ أَسْيَادْهُمْ مُؤْمْنِينْ، مَا يَحْقْرُوهُمْشْ عْلَى خَاطِرْهُمْ خْوَاتْهُمْ، بِالعَكْسْ يِلْزِمْهُمْ يِخْدْمُوهُمْ أَكْثِرْ عْلَى خَاطِرْ الِّي قَاعْدِينْ يِسْتْفَادُوا مِنْ خِدْمِتْهُمْ هُومَا مُؤْمْنِينْ ومَحْبُوبِينْ.</para>
  <para style="s" vid="1TI 6:2">التَّعْلِيمْ الغَالِطْ ومْحَبِّة الفْلُوسْ</para>
  <para style="p" vid="1TI 6:2">هَاذَا الِّي يِلْزِمْ تْعَلْمُو وَتْوَصِّي بِيهْ. <verse eid="1TI 6:2" /><verse number="3" style="v" sid="1TI 6:3" />وأَيْ وَاحِدْ يْعَلِّمْ حَاجَة أُخْرَى تْخَالِفْ الكْلَامْ الصْحِيحْ، الِّي هُوَّ كْلَامْ رَبْنَا يَسُوعْ المَسِيحْ، وتْخَالِفْ التَّعْلِيمْ الِّي يْوَافِقْ التَّقْوَى، <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />رَاهُو رَاجِلْ عْمَاهْ التَّكَبُّرْ ومُشْ فَاهِمْ حَتَّى شَيْ، يْمُوتْ عَالنِّقَاشَاتْ الفَارْغَة والعْنَادْ الِّي يْجِي مِنْهُمْ الحُسْدْ والمَشَاكِلْ والسَّبَّانْ وسُوءْ الظَّنْ <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />والعَرْكْ الِّي مَا يُوفَاشْ بِينْ نَاسْ عْقُولْهُمْ فِسْدِتْ وبِعْدُوا عَالحَقْ، وإِعْتَبْرُوا التَّقْوَى بَابْ لِلرِبْحْ. <verse eid="1TI 6:5" /><verse number="6" style="v" sid="1TI 6:6" />صْحِيحْ، التَّقْوَى فِيهَا بَرْشَة رِبْحْ إِذَا كَانْ مْعَاهَا القَنَاعَة. <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />كِي جِينَا لِلدِّنْيَا مَا جِبْنَا مْعَانَا شَيْ، وكِي بِشْ نُخْرْجُوا مِنْهَا مُشْ بِشْ نْهِزُّوا مْعَانَا شَيْ. <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />إِذَا كَانْ عَنْدْنَا مَا نَاكْلُوا ومَا نِلْبْسُوا هَاذَا يْكَفِّينَا. <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />آمَا الِّي يْحِبُّوا يْوَلِّيوْ غْنِيِّينْ رَاهُمْ يْطِيحُوا فِي التَّجِرْبَة ويُحْصْلُوا فِي مِنْدَافْ وفِي بَرْشَة شْهَاوِي تَافْهَة تْضُرْ وادَّمِّرْ النَّاسْ وتِهْلِكْهُمْ. <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />رَاهِي مْحَبِّةْ الفْلُوسْ أَصْلْ كُلْ شَرْ، وبِسْبَبْهَا فَمَّة نَاسْ بِعْدُوا عَالإِيمَانْ وتْسَبْبُوا لَرْوَاحْهُمْ فِي بَرْشَة وْجَايَعْ.<verse eid="1TI 6:10" /></para>
  <para style="s">وْصَايَا لْتِيمُوثَاوِسْ</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />آمَا إِنْتِ يَا رَاجِلْ اللَّهْ، إِبْعِدْ عْلَى هَاذَا الكُلْ. وتَبَّعْ الصَّلَاحْ والتَّقْوَى والإِيمَانْ والمْحَبَّة والصَّبْرْ والسْيَاسَة. <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />وجَاهِدْ بِالڨْدَا فِي جِهَادْ الإِيمَانْ وشِدْ صْحِيحْ فِي الحَيَاةْ الأَبَدِيَّة الِّي اللَّهْ دْعَاكْ لِيهَا، ولِّي شْهِدْتِلْهَا شْهَادَة بَاهْيَة قُدَّامْ بَرْشَة نَاسْ.<verse eid="1TI 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TI 6:13" />ونْوَصِّيكْ قُدَّامْ اللَّهْ الِّي يِحْيِي كُلْ شَيْ وقُدَّامْ يَسُوعْ المَسِيحْ الِّي شْهِدْ شْهَادَة بَاهْيَة قُدَّامْ بِيلَاطُسْ البُنْطِي، <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />إِنِّكْ تْحَافِظْ عَالوْصِيَّة بَاشْ تْكُونْ بْلَا لُومْ ولَا عِيبْ حَتَّى لِلنْهَارْ الِّي يِرْجَعْ فِيهْ رَبْنَا يَسُوعْ المَسِيحْ. <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />وهُوَّ بَاشْ يِرْجَعْ فِي الوَقْتْ المُحَدِّدْ الِّي اخْتَارُو اللَّهْ، الِّي هُوَّ السَّيِّدْ المُبَارَكْ الوَحِيدْ، مَلِكْ المُلُوكْ ورَبْ الأَرْبَابْ، <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />هُوَّ وَحْدُو الدَّايِمْ، الِّي يُسْكُنْ فِي نُورْ مَا يِتْقْرَبْشْ، ولِّي حَتَّى بَشَرْ مَا شَافُو وحَدْ مَا يْنَجِّمْ يْشُوفُو، لِيهْ الكَرَامَة والقُوَّة لِلْأَبَدْ. آمِينْ.<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />وَصِّي الغْنِيِّينْ فِي الدِّنْيَا هَاذِي بَاشْ مَا يِتْكَبْرُوشْ ومَا يْعَمْلُوشْ عْلَى فْلُوسْ مَا تْدُومِشْ، آمَا يِتْوَكْلُوا عْلَى اللَّهْ الِّي يَعْطِينَا الخِيرَاتْ بْلَاشْ حْسَابْ بَاشْ نِتْمَتْعُوا بِيهُمْ، <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />ووَصِّيهُمْ بَاشْ يَعْمْلُوا الخِيرْ، ويْكُونُوا غْنِيِّينْ بِأَعْمَالْهُمْ الصَّالْحَة، وكُرَمَاءْ ويْشَارْكُوا غِيرْهُمْ بْخِيرَاتْهُمْ. <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />وهَكَّا يِكْنْزُوا لِرْوَاحْهُمْ كَنْزْ يْكُونْ رَاسْ مَالْ لِلْمُسْتَقْبِلْ، بَاشْ يَعْرْفُوا شْنِيَّةْ الحَيَاةْ الحَقِيقِيَّة.<verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />يَا تِيمُوثَاوُسْ، حَافِظْ عَالأَمَانَة الِّي عَنْدِكْ، وإِبْعِدْ عَالكْلَامْ الفَارِغْ الِّي يِتْعَارِضْ مْعَ إِيمَانْنَا، والنِّقَاشْ الزَّايِدْ الِّي النَّاسْ يْسَمِّيوَهْ مَعْرْفَةْ، <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />ولِّي مْشَى فِي بَالْهُمْ إِنْهُمْ عَنْدْهُمْ المَعْرْفَةْ هَاذِي، بِعْدُوا عَالإِيمَانْ.</para>
  <para style="p" vid="1TI 6:21">نِعْمِةْ اللَّهْ مْعَاكُمْ.<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>