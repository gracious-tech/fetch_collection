<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id" />
  <para style="h">مُرْقُسْ</para>
  <para style="toc1">بْشَارِةْ مُرْقُسْ</para>
  <para style="toc2">مُرْقُسْ</para>
  <para style="toc3">مُرْقُسْ</para>
  <para style="mt">بْشَارِةْ مُرْقُسْ</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">يُوحَنَّا الِّي يْعَمِّدْ يْحَضِّرْ الطْرِيقْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />هَاذِي هِيَّ بِدَايِةْ البْشَارَة الِّي تْخُصْ يَسُوعْ المَسِيحْ إِبْنْ اللَّهْ. <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />كِيمَا قَالْ اللَّهْ فِي كْتَابْ النَّبِيْ إِشَعْيَاءْ:</para>
  <para style="b" vid="MRK 1:2" />
  <para style="q1" vid="MRK 1:2">«هَانِي بِشْ نِبْعَثْ قُدَّامِكْ رَسُولِي</para>
  <para style="q2" vid="MRK 1:2">بَاشْ يْحَضَّرْلِكْ الطْرِيقْ<verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />صُوتْ يْعَيِّطْ فِي الخْلَاء:</para>
  <para style="q2" vid="MRK 1:3">"حَضّْرُوا طْرِيقْ الرَّبْ، إِسْتْوِيوْ الثْنِيَّة قُدَّامُو"».<verse eid="MRK 1:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />كَانْ يُوحَنَّا فِي الخْلَاء يْنَادِي لِلنَّاسْ بَاشْ يْتُوبُوا ويِتْعَمْدُوا بَاشْ تِتْغْفِرْ ذْنُوبْهُمْ. <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />ومْشَاوْلُو النَّاسْ الكُلْ الِّي مِنْ مَنْطَقْةْ اليَهُودِيَّة وأُورْشَلِيمْ، وتْعَمْدُوا عْلَى يْدِيهْ فِي وَادْ الأُرْدُنْ بَعْدْمَا اعْتَرْفُوا بِذْنُوبْهُمْ. <verse eid="MRK 1:5" /><verse number="6" style="v" sid="MRK 1:6" />وكَانْ يُوحَنَّا لَابِسْ وْبَرْ الجْمَالْ ومِتْحَزِّمْ بْجِلْدْ ويَاكِلْ فِي الجْرَادْ والعْسَلْ الجَّالِي. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />وكَانْ يْبَشِّرْ ويْقُولْ: «بَعْدِي آنَا بِشْ يْجِي الِّي هُوَّ أَعْظَمْ مِنِّي، ولِّي مَا نِسْتَاهِلْشْ حَتَّى بَاشْ نْطَبِّسْ ونْحِلُّو رْبَايِطْ صَنْدَالُو. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />آنَا عَمَّدْتْكُمْ فِي المَاء، آمَا هُوَّ بِشْ يْعَمِّدْكُمْ فِي الرُّوحْ القُدُسْ».<verse eid="MRK 1:8" /></para>
  <para style="s">مَعْمُودِيِّةْ يَسُوعْ</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />فِي الوَقْتْ هَاذَاكَا جَاء يَسُوعْ مِالنَّاصْرَة الِّي فِي مَنْطَقْةْ الجَلِيلْ، وتْعَمِّدْ فِي وَادْ الأُرْدُنْ عْلَى يْدِينْ يُوحَنَّا. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />ودُوبْ مَا خْرَجْ مِالمَاء، شَافْ السْمَاء تْشَقِّتْ والرُّوحْ القُدُسْ هْبَطْ عْلِيهْ كِالحْمَامَة. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />وجَاء صُوتْ مِالسْمَاء يْقُولْ: «إِنْتِ إِبْنِي الِّي نْحِبُّو، آنَا فَرْحَانْ بِيكْ».<verse eid="MRK 1:11" /></para>
  <para style="s">الشِّيطَانْ يْجَرِّبْ يَسُوعْ</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />وبِالوَقْتْ الرُّوحْ القُدُسْ هَزْ يَسُوعْ لِلْخْلَاء <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />وعَدَّى 40 يُومْ والشِّيطَانْ يْجَرِّبْ فِيهْ، وكَانْ فِي وِسْطْ الحَيَوَانَاتْ المِتْوَحْشَة والمْلَايْكَة تِخْدِمْ فِيهْ.<verse eid="MRK 1:13" /></para>
  <para style="s">يَسُوعْ يَخْتَارْ تْلَامِذْتُو الأُولَانِينْ</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />وبَعْدْمَا تْحَطْ يُوحَنَّا فِي الحَبْسْ، مْشَى يَسُوعْ لْمَنْطَقْةْ الجَلِيلْ يُنْشُرْ فِي بْشَارِةْ اللَّهْ <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />ويْقُولْ: «جَاء الوَقْتْ وقُرْبِتْ مَمْلَكْةْ اللَّهْ. تُوبُوا وأَمْنُوا بِالبْشَارَة!».<verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />وهُوَّ مَاشِي عْلَى شَطْ بُحَيْرِةْ الجَلِيلْ، شَافْ زُوزْ صَيَّادَة، سِمْعَانْ وخُوهْ أَنْدَرَاوُسْ، يَرْمِيوْ فِي الشْبَاكْ فِي البُحَيْرَة. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />قَالِلْهُمْ يَسُوعْ: «تَبْعُونِي وآنَا بِشْ نْرُدْكُمْ صَيَّادِةْ نَاسْ». <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />وبِالوَقْتْ خَلَّاوْ الشْبَاكْ مْتَاعْهُمْ وتَبْعُوهْ. <verse eid="MRK 1:18" /><verse number="19" style="v" sid="MRK 1:19" />وبَعْدْمَا زَادْ مْشَى شْوَيَّة شَافْ يَعْقُوبْ وِلْدْ زَبَدِي وخُوهْ يُوحَنَّا فِي الفْلُوكَة يْصَلْحُوا فِي الشْبَاكْ. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />بِالوَقْتْ عَيْطِلْهُمْ. يَاخِي خَلَّاوْ بُوهُمْ زَبَدِي مْعَ الخَدَّامَة فِي الفْلُوكَة وتَبْعُوهْ.<verse eid="MRK 1:20" /></para>
  <para style="s">يَسُوعْ يْخَرِّجْ رُوحْ شِرِّيرْ</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />ومْبَعِّدْ مْشَاوْ لْكَفْرْنَاحُومْ، ونْهَارْ السِّبْتْ دْخَلْ يَسُوعْ لْمَعْبِدْ اليْهُودْ وبْدَا يْعَلِّمْ. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />وقَعْدُوا الحَاضْرِينْ مِتْعَجْبِينْ مِنْ تَعْلِيمُو، عْلَى خَاطْرُو كَانْ يْعَلِّمْ كِيمَا وَاحِدْ عَنْدُو سُلْطَة، مُشْ كِيمَا عُلَمَاءْ الشَّرِيعَة. <verse eid="MRK 1:22" /><verse number="23" style="v" sid="MRK 1:23" />وفِي الوَقْتْ هَاذَاكَا، كَانْ فَمَّة فِي المَعْبِدْ رَاجِلْ سَاكْنُو رُوحْ شِرِّيرْ بْدَا يْصِيحْ <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />وقَالْ: «آشْ تْحِبْ مِنَّا يَا يَسُوعْ النَّاصْرِي؟ جِيتْ بَاشْ تَقْضِي عْلِينَا؟ آنَا نَعْرِفْ إِنْتِ شْكُونْ، إِنْتِ القُدُّوسْ الِّي بَعْثُو اللَّهْ!». <verse eid="MRK 1:24" /><verse number="25" style="v" sid="MRK 1:25" />يَاخِي يَسُوعْ نْزَرْ عْلِيهْ وقَالُّو: «أُسْكُتْ! وأُخْرُجْ مِنُّو». <verse eid="MRK 1:25" /><verse number="26" style="v" sid="MRK 1:26" />صْرَعْ الرُّوحْ الشِّرِيرْ الرَّاجِلْ وصَاحْ بْصُوتْ عَالِي وخْرَجْ مِنُّو. <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />النَّاسْ الكُلْ قَعْدُوا مِتْعَجْبِينْ وبْدَاوْ يِسْأْلُوا فِي بْعَضْهُمْ: «شْنُوَّة هَاذَا؟ تَعْلِيمْ جْدِيدْ، وعَنْدُو سُلْطَة! حَتَّى مِالأَرْوَاحْ الشِّرِّيرَة يُأْمُرْهُمْ وهُومَا يْطِيعُوهْ!». <verse eid="MRK 1:27" /><verse number="28" style="v" sid="MRK 1:28" />وفِيسَعْ تِشْهَرْ يَسُوعْ فِي مَنْطَقْةْ الجَلِيلْ الكُلْ.<verse eid="MRK 1:28" /></para>
  <para style="s">يَسُوعْ يِشْفِي بَرْشَة نَاسْ</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />ودُوبْ مَا خَرْجُوا مِالمَعْبِدْ، مْشَاوْ لْدَارْ سِمْعَانْ وأَنْدَرَاوُسْ، ومْعَاهُمْ يَعْقُوبْ ويُوحَنَّا. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />كَانِتْ حْمَاةْ سِمْعَانْ رَاقْدَة فِي الفَرْشْ عَنْدْهَا السْخَانَة. يَاخِي كَلْمُوا يَسُوعْ عْلِيهَا. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />قْرُبِّلْهَا وشَدْهَا مِنْ يِدْهَا وقَيَّمْهَا وبِالوَقْتْ تْنَحَّاتْ عْلِيهَا السْخَانَة ووَلَّاتْ تِخْدِمْ فِيهُمْ.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />وفِي العْشِيَّة، وَقْتِلِّي غُرْبِتْ الشَّمْسْ، جَابُولُو النَّاسْ المُرْضَى الكُلْ ولِّي سَاكْنِتْهُمْ الشْوَاطِنْ. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />والنَّاسْ الكُلْ الِّي فِي أُورْشَلِيمْ تْلَمُّوا قُدَّامْ البَابْ، <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />وشْفَى بَرْشَة نَاسْ يْعَانِيوْ مِنْ بَرْشَة أَمْرَاضْ، وخَرِّجْ بَرْشَة شْوَاطِنْ، ومَا خَلَّاشْ الشْوَاطِنْ يِتْكَلْمُوا عْلَى خَاطِرْهُمْ عَرْفُوهْ شْكُونُو.<verse eid="MRK 1:34" /></para>
  <para style="s">يَسُوعْ يْبَشِّرْ فِي مَنْطَقْةْ الجَلِيلْ</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />ومِنْ غُدْوَة قْبَلْ الفَجْرْ قَامْ يَسُوعْ ومْشَى لْبُقْعَة خَالْيَة وبْدَا يْصَلِّي. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />ومْشَى سِمْعَانْ ولِّي مْعَاهْ يْلَوْجُوا عْلِيهْ <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />ووَقْتِلِّي لْقَاوْهْ قَالُولُو: «رَاهُمْ النَّاسْ الكُلْ يْلَوْجُوا عْلِيكْ!». <verse eid="MRK 1:37" /><verse number="38" style="v" sid="MRK 1:38" />قَالِلْهُمْ: «هَيَّا نِمْشِيوْ لِلدْشُرْ الأُخْرَى القْرِيبَة بَاشْ نْبَشِّرْ فِيهَا زَادَا، عْلَى خَاطِرْ هَاذَاكَا عَلَاشْ جِيتْ». <verse eid="MRK 1:38" /><verse number="39" style="v" sid="MRK 1:39" />ومْشَى لِمْعَابِدْ اليْهُودْ الِّي فِي مَنْطَقْةْ الجَلِيلْ الكُلْ، يْبَشِّرْ ويْخَرِّجْ فِي الشْوَاطِنْ.<verse eid="MRK 1:39" /></para>
  <para style="s">يَسُوعْ يِشْفِي المْرِيضْ بِالبْرَصْ</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />وجَاهْ وَاحِدْ أَبْرِصْ يِتْشَحِّتْ فِيهْ، وهْبَطْ عْلَى رْكَايْبُو قُدَّامُو وقَالْ: «كَانْ تْحِبْ، تْنَجِّمْ اطَّهِّرْنِي مِالبْرَصْ». <verse eid="MRK 1:40" /><verse number="41" style="v" sid="MRK 1:41" />حَنْ عْلِيهْ يَسُوعْ، ومَدْ يِدُّو ومَسُّو وقَالْ: «أَيْ نْحِبْ، أُطْهُرْ!». <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />ودُوبْ مَا تْكَلِّمْ يَسُوعْ تْنَحَّى عْلِيهْ البْرَصْ وطْهُرْ. <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />وبِالوَقْتْ، نَبَّهْ عْلِيهْ يَسُوعْ قْبَلْ مَا يْخَلِّيهْ يِمْشِي، <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />وقَالُّو: «رُدْ بَالِكْ! مَا تْقُولْ لْحَتَّى حَدْ. آمَا إِمْشِي وَرِّي رُوحِكْ لِلْكَاهِنْ، وعْلَى خَاطْرِكْ طْهُرْتْ، قَدِّمْ القُرْبَانْ الِّي أْمَرْ بِيهْ مُوسَى بَاشْ يْكُونْ شْهَادَة لِيهُمْ». <verse eid="MRK 1:44" /><verse number="45" style="v" sid="MRK 1:45" />آمَا هُوَّ مْشَى وبْدَا يُنْشِرْ فِي الخْبَرْ قُدَّامْ النَّاسْ، حَتَّى وَلَّى يَسُوعْ مَا عَادِشْ يْنَجِّمْ يُدْخُلْ لْحَتَّى بْلَادْ جْهَارْ، ووَلَّى قَاعِدْ فِي الخْلَاء، والنَّاسْ يْجِيوَهْ مِنْ كُلْ بْلَاصَة.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">يَسُوعْ يِشْفِي المَشْلُولْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />وبَعْدْ أَيَّامَاتْ، رْجَعْ يَسُوعْ لْمَنْطَقْةْ كَفْرْنَاحُومْ وتِنْشَرّْ الخْبَرْ الِّي هُوَّ فِي الدَّارْ. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />تْلَمُّوا بَرْشَة نَاسْ لِينْ مَا عَادِشْ فَمَّة بْلَاصَة لْحَتَّى حَدْ حَتَّى قُدَّامْ البَابْ. وبْدَا يَحْكِي مْعَاهُمْ بْكِلْمِةْ اللَّهْ. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />وجَابُولُو وَاحِدْ مَشْلُولْ هَازِّينُو أَرْبْعَة رْجَالْ. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />آمَا مَا نَجْمُوشْ يُقْرْبُولُو مِنْ كُثْرِةْ النَّاسْ. يَاخِي عَمْلُوا نُقْبَة فِي السْطَحْ فُوقْ البْلَاصَة الِّي كَانْ فِيهَا يَسُوعْ، وهَبّْطُوا مِنْهَا المَشْلُولْ، رَاقِدْ عْلَى فَرْشُو. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />وَقْتِلِّي شَافْ يَسُوعْ إِيمَانْهُمْ، قَالْ لِلْمَشْلُولْ: «يَا وِلْدِي، ذْنُوبِكْ تْغَفْرِتْ». <verse eid="MRK 2:5" /><verse number="6" style="v" sid="MRK 2:6" />وكَانْ بِينْ القَاعْدِينْ جْمَاعَة مِنْ عُلَمَاءْ الشَّرِيعَة بْدَاوْ يْخَمُّوا بِينْهُمْ وبِينْ رْوَاحْهُمْ: <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />«شْبِيهْ الرَّاجِلْ هَاذَا يِتْكَلِّمْ هَكَّا؟ قَاعِدْ يَكْفِرْ! شْكُونْ بِخْلَافْ اللَّهْ وَحْدُو يْنَجِّمْ يِغْفِرْ الذْنُوبْ؟».<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />وبِالوَقْتْ عْرَفْ يَسُوعْ فَاشْ يْخَمُّوا، يَاخِي سْإِلْهُمْ: «عْلَاشْ تْخَمُّوا هَكَّا؟ <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />آنَاهُو أَسْهِلْ؟ بَاشْ يِتْقَالْ لِلْمَشْلُولْ: "ذْنُوبِكْ تْغَفْرِتْ" وَلَّا يِتْقَالُّو: "قُومْ! هِزْ فَرْشِكْ وامْشِي"؟ <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />آمَا هَانِي بِشْ نْوَرِّيكُمْ الِّي إِبْنْ الإِنْسَانْ عَنْدُو السُّلْطَة فِي الأَرْضْ بَاشْ يِغْفِرْ الذْنُوبْ». يَاخِي قَالْ لِلْمَشْلُولْ: <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />«نْقُلِّكْ: قُومْ! هِزْ فَرْشِكْ ورَوَّحْ لْدَارِكْ». <verse eid="MRK 2:11" /><verse number="12" style="v" sid="MRK 2:12" />قَامْ الرَّاجِلْ بِالوَقْتْ، هَزْ فَرْشُو ومْشَى قُدَّامْ النَّاسْ الكُلْ. قَعْدُوا الكُلْهُمْ بَاهْتِينْ وحِمْدُوا اللَّهْ وقَالُوا: «عْمُرْنَا مَا شُفْنَا حَاجَة كِيمَا هَاذِي!».<verse eid="MRK 2:12" /></para>
  <para style="s">يَسُوعْ فِي دَارْ لَاوِي</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />وخْرَجْ يَسُوعْ مَرَّة أُخْرَى لْشَطْ البُحَيْرَة، وخَلْطُوا عْلِيهْ النَّاسْ الكُلْ، وبْدَا يْعَلَّمْ فِيهُمْ. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />وهُوَّ يِمْشِي، شَافْ لَاوِي وِلْدْ حَلْفَى قَاعِدْ فِينْ يْلِمُّوا الضَّرَايِبْ وقَالُّو: «تَبَّعْنِي!». يَاخِي قَامْ وتَبْعُو.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />ووَقْتِلِّي كَانْ يَسُوعْ قَاعِدْ يَاكِلْ فِي دَارْ لَاوِي، قَعْدُوا مْعَاهْ ومْعَ تْلَامِذْتُو بَرْشَة مَكَّاسَة الِّي يْلِمُّوا فِي الضَّرَايِبْ وبَرْشَة مُذْنْبِينْ، مِلِّي كَانُوا يْتَبْعُوا فِيهْ. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />ووَقْتِلِّي عُلَمَاءْ الشَّرِيعَة والفِرِّيسِيِّينْ شَافُوا الِّي يَسُوعْ يَاكِلْ مْعَ المَكَّاسَة والمُذْنْبِينْ، قَالُوا لِتْلَامِذْتُو: «عْلَاشْ يَاكِلْ مْعَ المَكَّاسَة والمُذْنْبِينْ؟». <verse eid="MRK 2:16" /><verse number="17" style="v" sid="MRK 2:17" />سْمَعْهُمْ يَسُوعْ وجَاوِبْهُمْ: «المُرْضَى هُومَا الِّي يَحْتَاجُوا لِلطْبِيبْ مُشْ الصْحَاحْ. آنَا جِيتْ لِلْمُذْنْبِينْ، مُشْ لِلصَّالْحِينْ».<verse eid="MRK 2:17" /></para>
  <para style="s">يَسُوعْ يْجَاوِبْ عَالصْيَامْ</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />وكَانُوا تْلَامِذْةْ يُوحَنَّا والفِرِّيسِيِّينْ صَايْمِينْ. يَاخِي جَاوْ جْمَاعَة لْيَسُوعْ وسِأْلُوهْ: «عْلَاشْ تْلَامِذْةْ يُوحَنَّا وتْلَامِذْةْ الفِرِّيسِيِّينْ يْصُومُوا، وتْلَامِذْتِكْ مَا يْصُومُوشْ؟». <verse eid="MRK 2:18" /><verse number="19" style="v" sid="MRK 2:19" />جَاوِبْهُمْ: «يَاخِي يْنَجْمُوا المِسْتَدْعِينْ لِلْعِرْسْ يْصُومُوا والعْرُوسْ مَزَّالْ مْعَاهُمْ؟ مَادَامُو العْرُوسْ مْعَاهُمْ، مَا يْنَجْمُوشْ يْصُومُوا. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />آمَا بِشْ يْجِي الوَقْتْ الِّي يِتْنَحَّى فِيهْ العْرُوسْ مِنْ بَحْذَاهُمْ. وَقْتْهَا يْصُومُوا. <verse eid="MRK 2:20" /><verse number="21" style="v" sid="MRK 2:21" />حَتَّى حَدْ مَا يْرَقَّعْ لِبْسَة قْدِيمَة بْطَرْفْ قْمَاشْ جْدِيدْ. مَا كَانِشْ تِتْكَمِّشْ القَطْعَة الجْدِيدَة ويِتْجَبِّدْ القْمَاشْ القْدِيمْ، وتْوَلِّي التَّقْطِيعَة أَتْعَسْ مِنْ قْبَلْ. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />ومَا فَمَّة حَتَّى وَاحِدْ يْحُطْ شْرَابْ جْدِيدْ فِي ڨِرْبَة قْدِيمَة، بَاشْ الشْرَابْ الجْدِيدْ مَا يِفْلِقْشْ الڨِرْبَة ويِخْسِرْ الشْرَابْ والڨِرْبَة. آمَا الشْرَابْ الجْدِيدْ يِتْحَطْ فِي ڨِرْبَة جْدِيدَة».<verse eid="MRK 2:22" /></para>
  <para style="s">يَسُوعْ هُوَّ رَبْ السِّبْتْ</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />وفِي نْهَارْ السِّبْتْ، تْعَدَّى يَسُوعْ وِسْطْ هْنَاشِرْ، وتْلَامِذْتُو بْدَاوْ يْنَحِّيوْ فِي سْبُولْ القَمْحْ وهُومَا مَاشِينْ. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />يَاخِي الفِرِّيسِيِّينْ قَالُولُو: «شُوفْ! عْلَاشْ تْلَامِذْتِكْ يَعْمْلُوا حَاجَاتْ مَا يِلْزِمْشْ تِتَعْمَلْ نْهَارْ السِّبْتْ؟». <verse eid="MRK 2:24" /><verse number="25" style="v" sid="MRK 2:25" />جَاوِبْهُمْ: «يَاخِي مَا قْرِيتُوشْ عَلِّي عَمْلُو دَاوِدْ هُوَّ ولِّي مْعَاهْ وَقْتِلِّي إِحْتَاجُوا وجَاعُوا، <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />كِيفَاشْ دْخَلْ لْخِيمِةْ الإِجْتِمَاعْ وَقْتِلِّي أَبِيأَثَارْ كَانْ كْبِيرْ الكَهَنَة، وكِيفَاشْ كْلَا مِنْ خُبْزْ القُرْبَانْ الِّي مَسْمُوحْ كَانْ لِلْكَهَنَة بَاشْ يَاكْلُوا مِنُّو، وزَادْ عْطَى لِلِّي مْعَاهْ، وكْلَاوْ؟». <verse eid="MRK 2:26" /><verse number="27" style="v" sid="MRK 2:27" />وزَادْ قَالِلْهُمْ: « رَاهُو السِّبْتْ مَجْعُولْ لِلْإِنْسَانْ، مُشْ الإِنْسَانْ مَجْعُولْ لِلسِّبْتْ. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />هَاذَاكَا عْلَاشْ إِبْنْ الإِنْسَانْ هُوَّ رَبْ السِّبْتْ زَادَا».<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">يَسُوعْ يِشْفِي فِي نْهَارْ سِبْتْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />ودْخَلْ يَسُوعْ لِلْمَعْبِدْ مَرَّة أُخْرَى وكَانْ فَمَّة رَاجِلْ يِدُّو يَابْسَة. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />وبْدَاوْ جْمَاعَة يْرَاقْبُوا فِيهْ يْحِبُّوا يْشُوفُوا إِذَا كَانْ بِشْ يِشْفِي الرَّاجِلْ هَاذَاكَا فِي نْهَارْ السِّبْتْ وَلَّا لَا، وهَكَّاكَا يْنَجْمُوا يِتْهْمُوهْ. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />قَالْ لِلرَّاجِلْ الِّي يِدُّو يَابْسَة: «قُومْ وآقِفْ فِي الوِسْطْ!». <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />وبَعْدْ سْإِلْ الحَاضْرِينْ: «زَعْمَة حْلَالْ فِي نْهَارْ السِّبْتْ، نَعْمْلُوا الخِيرْ وَلَّا الشَّرْ؟ إِنَّجِّيوْ رُوحْ وَلَّا نُقْتْلُوهَا؟». آمَا هُومَا قَعْدُوا سَاكْتِينْ. <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />خْزَرِّلْهُمْ يَسُوعْ بْغُشْ وحْزِنْ عْلَى قَسْوِةْ قْلُوبْهُمْ وقَالْ لِلرَّاجِلْ: «مِدْ يِدِّكْ!». مَدْهَا، وإِذَا بِيهَا رَجْعِتْ صْحِيحَة. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />وبِالوَقْتْ خَرْجُوا الفِرِّيسِيِّينْ وتْفَاهْمُوا مْعَ أَتْبَاعْ المَلِكْ هِيرُودُسْ، بَاشْ يُقْتْلُوهْ.<verse eid="MRK 3:6" /></para>
  <para style="s">يَسُوعْ يْعَلِّمْ ويِشْفِي بَرْشَة نَاسْ</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />ومْشَى يَسُوعْ وتْلَامِذْتُو لِلْبُحَيْرَة، وتَبْعُوهْ بَرْشَة نَاسْ مِنْ مَنْطَقْةْ الجَلِيلْ واليَهُودِيَّة، <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />ومِنْ أُورْشَلِيمْ وأَدُومِيَّة ومِنْ وْرَاء وَادْ الأُرْدُنْ، وبَرْشَة نَاسْ مِنْ شِيرِة صُورْ وصَيْدَا، عْلَى خَاطِرْهُمْ سَمْعُوا بِلِّي عَمْلُو. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />يَاخِي طْلَبْ مِنْ تْلَامِذْتُو يْحَضْرُولُو فْلُوكَة بَاشْ النَّاسْ مَا يْدِزُّوهِشْ، <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />عْلَى خَاطِرْ مِلِّي شْفَى بَرْشَة نَاسْ، وَلَّى كُلْ مْرِيضْ يِتْزَاحِمْ مْعَ الآخِرْ بَاشْ يُوصِلْ يْمِسُّو. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />وكَانِتْ كُلْ مَا تْشُوفُو الأَرْوَاحْ الشِّرِّيرَة اطِّيحْ قُدَّامُو وتْصِيحْ: «إِنْتِ إِبْنْ اللَّهْ!». <verse eid="MRK 3:11" /><verse number="12" style="v" sid="MRK 3:12" />وكَانْ يْنَبَّهْ عَلِيهُمْ بْقُوَّة بَاشْ مَا يُنْشْرُوشْ خَبْرُو.<verse eid="MRK 3:12" /></para>
  <para style="s">يَسُوعْ يَخْتَارْ الرُّسُلْ الأَثْنَاشْ</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />ومْبَعِّدْ طْلَعْ يَسُوعْ لِلجْبَلْ، ونَادَى الِّي يْحِبْ عْلِيهُمْ، يَاخِي جَاوِهْ. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />وإِخْتَارْ مِنْهُمْ أَثْنَاشِنْ وَاحِدْ وسَمَّاهُمْ رُسُلْ بَاشْ يْكُونُوا مْعَاهْ ويَبْعَثْهُمْ يْبَشْرُوا، <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />وتْكُونْ عَنْدْهُمْ سُلْطَة بَاشْ يْخَرْجُوا الشْوَاطِنْ. <verse eid="MRK 3:15" /><verse number="16" style="v" sid="MRK 3:16" />والأَثْنَاشْ الِّي اخْتَارْهُمْ هُومَا: سِمْعَانْ الِّي سَمَّاهْ بُطْرُسْ، <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />ويَعْقُوبْ ويُوحَنَّا وْلَادْ زَبَدِي، الِّي سَمَّاهُمْ بُوَانَرْجِسْ ومَعْنَاهَا وْلَادْ الرْعَدْ، <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />وأَنْدَرَاوُسْ، وفِيلِۑُّسْ، وبَرْثُلْمَاوُسْ، ومَتَّى، وتُومَا، ويَعْقُوبْ وِلْدْ حَلْفَى، وتَدَّاوُسْ، وسِمْعَانْ القَانَوِي، <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />ويَهُوذَا الإِسْخَرْيُوطِي الِّي خَانُو.<verse eid="MRK 3:19" /></para>
  <para style="s">يَسُوعْ يْجَاوِبْ عْلَى تُهْمِةْ عَايِلْتُو وعُلَمَاءْ الشَّرِيعَة</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />ومْشَى يَسُوعْ وتْلَامِذْتُو لِلدَّارْ، ومِنْ كُثْرِةْ النَّاسْ الِّي تْلَمُّوا مَرَّة أُخْرَى، مَا خَلْطُوشْ حَتَّى بَاشْ يَاكْلُوا. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />ووَقْتِلِّي سَمْعُوا أَقَارْبُو جَاوْ بَاشْ يْهِزُّوهْ عْلَى خَاطِرْ قَالُوا: «خْرَجْ مِنْ عَقْلُو». <verse eid="MRK 3:21" /><verse number="22" style="v" sid="MRK 3:22" />وعُلَمَاءْ الشَّرِيعَة الِّي جَاوْ مِنْ أُورْشَلِيمْ قَالُوا: «رَاهُو سَاكْنُو بَعْلَزَبُولْ رَئِيسْ الشْوَاطِنْ، وبِيهْ هُوَّ يْخَرِّجْ فِي الشْوَاطِنْ!». <verse eid="MRK 3:22" /><verse number="23" style="v" sid="MRK 3:23" />عَيْطِلْهُمْ يَسُوعْ وكَلَّمْهُمْ بْأَمْثَالْ وقَالْ: «كِيفَاشْ إِبْلِيسْ يْنَجِّمْ يْخَرِّجْ رُوحْ شِرِّيرْ؟ <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />إِذَا كَانْ مَمْلْكَة تْقِسْمِتْ عْلَى بْعَضْهَا، مُشْ مُمْكِنْ تْدُومْ. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />وإِذَا كَانْ دَارْ تْقِسْمِتْ عْلَى بْعَضْهَا، مُشْ مُمْكِنْ تِثْبِتْ. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />وإِذَا كَانْ إِبْلِيسْ جَاء ضِدْ رُوحُو وتِقْسِمْ، مَا يْنَجَّمْشْ يْدُومْ، ويِفْنَى. <verse eid="MRK 3:26" /><verse number="27" style="v" sid="MRK 3:27" />حَتَّى حَدْ مَا يْنَجِّمْ يُدْخُلْ لْدَارْ رَاجِلْ قْوِي ويِسْرَقْ الحَاجَاتْ الِّي فِيهَا إِلَّا إِذَا كَانْ يْكَتِّفْ الرَّاجِلْ قْبَلْ ومْبَعِّدْ يِسْرَقْلُو دَارُو. <verse eid="MRK 3:27" /><verse number="28" style="v" sid="MRK 3:28" />نْقُلْكُمْ الحَقْ: ذْنُوبْ النَّاسْ الكُلْهَا تِتْغْفِرْ، وحَتَّى مِنْ كُفْرْهُمْ. <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />آمَا الِّي يَكْفِرْ بِالرُّوحْ القُدُسْ، مَا يِتْغْفِرْلُوشْ، ويِبْقَى بْذَنْبُو لِلْأَبَدْ». <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />الكْلَامْ هَاذَا جَاوِبْ بِيهْ الِّي كَانُوا يْقُولُوا: «سَاكْنُو رُوحْ شِرِّيرْ».<verse eid="MRK 3:30" /></para>
  <para style="s">شْكُونْ عَايِلْةْ يَسُوعْ؟</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />وجَاوْ خْوَاتْ يَسُوعْ وأُمُّو ووِقْفُوا لْبَرَّا مِالدَّارْ وبَعْثُولُو شْكُونْ يْعَيِّطْلُو. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />وكَانُوا بَرْشَة نَاسْ قَاعْدِينْ دَايْرِينْ بِيهْ، قَالُولُو: «رَاهِي أُمِّكْ وخْوَاتِكْ يِسْتَنَّاوْ فِيكْ لْبَرَّا». <verse eid="MRK 3:32" /><verse number="33" style="v" sid="MRK 3:33" />جَاوِبْهُمْ وقَالْ: «شْكُونْهُمْ أُمِّي وخْوَاتِي؟». <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />وتْلَفِّتْ لِلِّي قَاعْدِينْ دَايْرِينْ بِيهْ وقَالْ: «هَاذُمْ هُومَا أُمِّي وخْوَاتِي. <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />وكُلْ وَاحِدْ يَعْمِلْ الِّي يْحِبْ عْلِيهْ اللَّهْ هُوَّ خُويَا وأُخْتِي وأُمِّي».<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">مَثَلْ الزَّارِعْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />وبْدَا يَسُوعْ يْعَلِّمْ فِي شَطْ البُحَيْرَة مَرَّة أُخْرَى. وتْلَمُّوا بِيهْ بَرْشَة نَاسْ، يَاخِي وَلَّى طْلَعْ وقْعَدْ فِي وِسْطْ فْلُوكَة فِي المَاء، والنَّاسْ الكُلْ قَعْدُوا عَالشَّطْ. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />وعَلَّمْهُمْ بَرْشَة حَاجَاتْ بِالأَمْثَالْ وقَالِلْهُمْ فِي تَعْلِيمُو: <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />«إِسْمْعُوا! خْرَجْ الفَلَّاحْ بَاشْ يَزْرَعْ. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />وَقْتِلِّي هُوَّ يَزْرَعْ، فَمَّة زِرِّيعَة جَاتْ عَالطْرِيقْ، يَاخِي جَاتْ العْصَافِرْ وكْلَاتْهَا. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />وفَمَّة زِرِّيعَة أُخْرَى طَاحِتْ فِي أَرْضْ مْحَجْرَة مَا فِيهَاشْ بَرْشَة تْرَابْ، يَاخِي نِبْتِتْ فِيسَعْ عْلَى خَاطِرْ تْرَابْهَا مُشْ غَارَقْ. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />آمَا وَقْتِلِّي طَلْعِتْ الشَّمْسْ، تْحَرْقِتْ ويِبْسِتْ عْلَى خَاطِرْ مَا عَنْدْهَاشْ عْرُوقْ. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />وفَمَّة زِرِّيعَة طَاحِتْ فِي وِسْطْ الشُّوكْ، ووَقْتِلِّي نْبِتْ الشُّوكْ خْنَقْهَا ومَا خَلَّاهَاشْ تُثْمُرْ. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />وفَمَّة زِرِّيعَة أُخْرَى طَاحِتْ فِي الأَرْضْ البَاهْيَة. نِبْتِتْ وكِبْرِتْ وثُمْرِتْ. فَمَّة مِنْهَا الِّي جَابِتْ 30 مَرَّة قَدْ الِّي تِزْرَعّْ، ومِنْهَا الِّي جَابِتْ 60، ومِنْهَا الِّي جَابِتْ 100». <verse eid="MRK 4:8" /><verse number="9" style="v" sid="MRK 4:9" />ومْبَعِّدْ قَالْ: «الِّي عَنْدُو وِذْنِينْ تِسْمَعْ، خَلِّيهْ يِسْمَعْ!».<verse eid="MRK 4:9" /></para>
  <para style="s">عْلَاشْ يَسُوعْ يَحْكِي بِالأَمْثَالْ</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />ووَقْتِلِّي وَلَّى وَحْدُو، سِأْلُوهْ النَّاسْ الدَّايْرِينْ بِيهْ والرُّسُلْ الأَثْنَاشْ عْلَى مَعْنَى المَثَلْ. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />قَالِلْهُمْ: «إِنْتُومَا تِعْطَالْكُمْ سِرْ مَمْلَكْةْ اللَّهْ. آمَا النَّاسْ الأُخْرِينْ كُلْ شَيْ يِتْقَالِلْهُمْ بِالأَمْثَالْ:<verse eid="MRK 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="MRK 4:12" />"بَاشْ قَدْ مَا يُخْزْرُوا مَا يْشُوفُوشْ،</para>
  <para style="q2" vid="MRK 4:12">وقَدْ مَا يِسْمْعُوا مَا يِفْهْمُوشْ،</para>
  <para style="q1" vid="MRK 4:12">بَاشْ مَا يْتُوبُوشْ وتِتْغْفِرْ ذْنُوبْهُمْ"».<verse eid="MRK 4:12" /></para>
  <para style="b" />
  <para style="s">يَسُوعْ يْفَسِّرْ مَثَلْ الزَّارِعْ</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />وقَالِلْهُمْ يَسُوعْ: «يَاخِي مَا فْهِمْتُوشْ المَثَلْ هَاذَا؟ مَالَا كِيفَاشْ بِشْ تِفْهْمُوا الأَمْثَالْ الأُخْرِينْ الكُلْ؟ <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />الفَلَّاحْ يَزْرَعْ كِلْمِةْ اللَّهْ. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />والزِرِّيعَة الِّي جَاتْ عَالطْرِيقْ، هُومَا النَّاسْ الِّي دُوبْ مَا يِسْمْعُوا الكِلْمَة، يْجِي الشِّيطَانْ ويَخْطِفْ الكِلْمَة الِّي تْزَرْعِتْ فِي قْلُوبْهُمْ. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />ولِّي جَاتْ فِي الأَرْضْ المْحَجْرَة، هُومَا النَّاسْ الِّي دُوبْ مَا يِسْمْعُوا الكِلْمَة يِقْبْلُوهَا بْفَرْحَة، <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />آمَا مَا عَنْدْهُمْشْ عْرُوقْ ومَا يْدُومُوشْ. ودُوبْ مَا يْجِي وَقْتْ صْعِيبْ وَلَّا إِضْطِهَادْ عْلَى خَاطِرْ كِلْمَة اللَّهْ يْسَلْمُوا فِيهَا فِيسَعْ. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />والزِرِّيعَة الِّي جَاتْ فِي وِسْطْ الشُّوكْ، هُومَا النَّاسْ الِّي سَمْعُوا الكِلْمَة، <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />آمَا هْمُومْ الدِّنْيَا ومْحَبِّةْ الفْلُوسْ وشَهْوَاتْ الحَاجَاتْ الأُخْرَى، تُدْخِلْ وتُخْنُقْ الكِلْمَة وتْوَلِّي مَا عَنْدْهَاشْ ثْمَرْ. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />آمَا الِّي يِتْزَرْعُوا فِي الأَرْضْ البَاهْيَة، هُومَا الِّي يِسْمْعُوا الكِلْمَة ويِقْبْلُوهَا ويُثْمْرُوا، مِنْهُمْ الِّي يْجِيبْ 30 مَرَّة قَدْ الِّي تِزْرَعّْ ومِنْهُمْ الِّي يْجِيبْ 60 ومِنْهُمْ الِّي يْجِيبْ 100».<verse eid="MRK 4:20" /></para>
  <para style="s">مَثَلْ الفْنَارْ</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />وقَالِلْهُمْ يَسُوعْ: « يْجِيبِشْ وَاحِدْ فْنَارْ ويْغُمُّو بْطَاسَة وَلَّا يْحُطُّو تَحْتْ سْرِيرْ؟ يَاخِي مُشْ يِتْحَطْ فِي بْلَاصَة عَالْيَة؟ <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />كُلْ حَاجَة مْخُبْيَة بِشْ تُظْهُرْ وكُلْ سِرْ بِشْ يِتْكْشِفْ. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />الِّي عَنْدُو وِذْنِينْ تِسْمَعْ، خَلِّيهْ يِسْمَعْ».<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />وقَالِلْهُمْ: « رَكْزُوا فِلِّي تِسْمْعُوا فِيهْ! رَاهُو بِالكِيلْ الِّي تْكَيْلُوا بِيهْ، يِتْكَيْلِلْكُمْ ويِتْزَادْ عْلِيهْ، <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />الِّي عَنْدُو يِتْزَادْلُو أَكْثِرْ، ولِّي مَا عَنْدُوشْ حَتَّى الِّي عَنْدُو يِتْفَكْلُو».<verse eid="MRK 4:25" /></para>
  <para style="s">الزِّرِّيعَة تِطْلَعْ وتِكْبِرْ</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />وقَالْ يَسُوعْ: «مَمْلَكْةْ اللَّهْ تْشَبَّهْ لْفَلَّاحْ يَرْمِي الزِّرِّيعَة فِي الأَرْضْ. <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />ومْبَعِّدْ يُرْقُدْ فِي اللِّيلْ ويْقُومْ فِي النْهَارْ والزِّرِّيعَة تِطْلَعْ وتِكْبِرْ، وهُوَّ مَا يَعْرِفْشْ كِيفَاشْ. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />الأَرْضْ وَحَّدْهَا تَعْطِي الثَّمْرَة، تْنَبِّتْ، وبَعْدْ تْسَبِّلْ، والسْبُولَة تِتْمْلَى بِالقَمْحْ. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />آمَا دُوبْ مَا الصَّابَة تَحْضِرْ، يَحْصِدْهَا الفَلَّاحْ بِالمِنْجِلْ عْلَى خَاطِرْ جَاء وَقْتْ الحْصَادْ».<verse eid="MRK 4:29" /></para>
  <para style="s">زِرِّيعَة الخَرْدِلْ</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />وقَالْ يَسُوعْ: «بَاشْ نْشَبْهُوا مَمْلَكْةْ اللَّهْ وبْأَيْ مَثَلْ نْمَثْلُوهَا؟ <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />تْشَبَّهْ لْزِرِّيعَة الخَرْدِلْ الِّي هِيَّ أَصْغِرْ زَرِّيعَة تِتْزْرَعْ فِي الأَرْضْ. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />آمَا وَقْتِلِّي تِنْبِتْ، تْوَلِّي أَكْبِرْ مِالنَّبْتَاتْ الكُلْ واطَّلَّعْ أَغْصَانْ كْبِيرَة، حَتَّى عْصَافِرْ السْمَاء تْعَشِشْ فِي ظُلْهَا». <verse eid="MRK 4:32" /><verse number="33" style="v" sid="MRK 4:33" />كَانْ يَسُوعْ يْعَلَّمْ فِيهُمْ كِلْمِةْ اللَّهْ بْبَرْشَة أَمْثَالْ كِيفْ مَا هَاذِي، عْلَى قَدْ مَا يْنَجْمُوا يِفْهْمُوا. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />ومَا كَانْ يَحْكِيلْهُمْ حَتَّى شَيْ مِنْ غِيرْ مَثَلْ، آمَا كَانْ يْفَسِّرْ لِتْلَامِذْتُو كُلْ شَيْ وَقْتِلِّي يُقْعُدْ مْعَاهُمْ وَحَّدْهُمْ.<verse eid="MRK 4:34" /></para>
  <para style="s">يَسُوعْ يْهَدِّي العَاصْفَة</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />ونْهَارِتْهَا فِي العْشِيَّة، قَالْ يَسُوعْ لِتْلَامِذْتُو: «هَيَّا نْشُقُّوا البُحَيْرَة لِلجِّيهَة الأُخْرَى». <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />يَاخِي خَلَّاوْ النَّاسْ وهَزُّوهْ مْعَاهُمْ فِي الفْلُوكَة الِّي كَانْ فِيهَا، وكَانُوا مْعَاهْ فْلَايِكْ أُخْرِينْ. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />وهَبِّتْ رِيحْ قْوِيَّة ووَلَّى المُوجْ يَضْرِبْ فِي الفْلُوكَة حَتَّى لِينْ قْرِيبْ تِتْعَبَّى بِالمَاء. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />وكَانْ يَسُوعْ رَاقِدْ فِي آخِرْ الفْلُوكَة وحَاطِطْ رَاسُو عْلَى مْخَدَّة. قَيْمُوهْ وقَالُولُو: «يَا مُعَلِّمْ! يَاخِي مَا يْهِمِّكْشْ فِينَا كَانْ نُغْرْقُوا؟». <verse eid="MRK 4:38" /><verse number="39" style="v" sid="MRK 4:39" />وَلَّى قَامْ وأْمَرْ الرِّيحْ وقَالْ لِلْبُحَيْرَة: «أُسْكُتْ! رِيضْ!» يَاخِي وِقْفِتْ الرِّيحْ والدِّنْيَا هْدَاتْ. <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />وقَالِلْهُمْ: «شْبِيكُمْ خُفْتُوا؟ كِيفَاشْ مَا عَنْدْكُمْشْ إِيمَانْ حَتَّى لْتَوَّا؟». <verse eid="MRK 4:40" /><verse number="41" style="v" sid="MRK 4:41" />تْرِعْبُوا وقَالُوا لِبْعَضْهُمْ: «شْكُونُو هَاذَا؟ حَتَّى مِالرِّيحْ والبُحَيْرَة يْطِيعُوهْ!».<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">يَسُوعْ يْخَرِّجْ الشْوَاطِنْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />ووُصْلُوا لِلجِّيهَة الأُخْرَى مْتَاعْ البُحَيْرَة فِي مَنْطَقْةْ الجَرَّاسِيِّينْ. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />ودُوبْ مَا هْبَطْ يَسُوعْ مِالفْلُوكَة، عُرْضُو رَاجِلْ خَارِجْ مِالجَّبَّانَة سَاكْنُو رُوحْ شِرِّيرْ. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />كَانْ يُسْكُنْ وِينْ يِدْفْنُوا المُوتَى، وحَتَّى حَدْ مَاعَادْ يْنَجِّمْ يُرْبْطُو حَتَّى بِالسْلَاسِلْ، <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />عْلَى خَاطِرْ بَرْشَة مَرَّاتْ رَبْطُوهْ بِالحْدِيدْ وبِالسْلَاسِلْ وكَانْ يْقَلَّعْهُمْ ويَقْطَّعْهُمْ، ومَا نَجِّمْ حَدْ يْسَيْطِرْ عْلِيهْ. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />وكَانْ لِيلْ ونْهَارْ وهُوَّ فِي الجَّبَّانَة وفِي الجْبُولَاتْ، يْصِيحْ ويَجْرَحْ فِي رُوحُو بِالحْجَرْ. <verse eid="MRK 5:5" /><verse number="6" style="v" sid="MRK 5:6" />وكِي شَافْ يَسُوعْ مِنْ بْعِيدْ جْرَالُو وسْجِدْلُو. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />وصَاحْ عْلَى طُولْ صُوتُو: «آشْ بِينِي وبِينِكْ يَا يَسُوعْ إِبْنْ اللَّهْ العَالِي؟ حَلَّفْتِكْ بِاللَّهْ مَا تْعَذَّبْنِيشْ!». <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />وتْكَلِّمْ هَكَّا عْلَى خَاطِرْ يَسُوعْ قَالُّو: «يَا رُوحْ شِرِّيرْ، أُخْرُجْ مِالرَّاجِلْ!». <verse eid="MRK 5:8" /><verse number="9" style="v" sid="MRK 5:9" />وسِأْلُو يَسُوعْ: «آشْ إِسْمِكْ؟». جَاوْبُو: «إِسْمِي جَيْشْ، عْلَى خَاطِرْنَا بَرْشَة!». <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />وقْعَدْ يِتْشَحَّتْ فِيهْ بَاشْ مَا يْطَرَّدْهُمْشْ بْعِيدْ عَالمَنْطْقَة هَاذِيكَا.<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />وكَانُوا فَمَّة بَرْشَة حْلَالِفْ سَارْحِينْ بِيهُمْ بَحْذَا الجْبَلْ. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />يَاخِي طَلْبُوا مِنُّو الأَرْوَاحْ وقَالُوا: «أَبْعَثْنَا لِلْحْلَالِفْ نُدْخْلُوا فِيهُمْ». <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />وَلَّى يَسُوعْ خَلَّاهُمْ، يَاخِي خَرْجُوا ودَخْلُوا فِي الحْلَالِفْ، الِّي كَانُوا قْرَابِةْ 2 000 حَلُّوفْ. وبِالوَقْتْ تِرْمَاوْ الكُلْ مِنْ حَافِةْ الجْبَلْ فِي البُحَيْرَة وغُرْقُوا. <verse eid="MRK 5:13" /><verse number="14" style="v" sid="MRK 5:14" />وهَرْبُوا سُرَّاحْ الحْلَالِفْ ونَشْرُوا الخْبَرْ فِي المْدِينَة وفِي الدْشُرْ الدَايْرَة بِيهَا وخَرْجُوا النَّاسْ بَاشْ يْشُوفُوا آشْ صَارْ. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />وجَاوْ لْيَسُوعْ يَاخِي شَافُوا الرَّاجِلْ الِّي كَانِتْ سَاكْنِتُّو الأَرْوَاحْ الشِّرِّيرَة رْجَعْلُو عَقْلُو ولَابِسْ دَبْشُو وقَاعِدْ، يَاخِي خَافُوا بَرْشَة. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />والنَّاسْ الِّي كَانُوا شَاهْدِينْ، حْكَاوْلْهُمْ آشْ صَارْ لِلرَّاجِلْ الِّي سَاكْنِتُّو الأَرْوَاحْ الشِّرِّيرَة ولِلْحْلَالِفْ. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />يَاخِي شَدُّو صْحِيحْ فِي يَسُوعْ بَاشْ يُخْرُجْ مِنْ مَنْطْقِتْهُمْ.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />وكِي جَاء طَالَعْ فِي الفْلُوكَة طْلَبْ مِنُّو الرَّاجِلْ الِّي كَانِتْ سَاكْنِتُّو الأَرْوَاحْ الشِّرِّيرَة بَاشْ يِمْشِي مْعَاهْ. <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />آمَا هُوَّ مَا خَلَّاهِشْ وقَالُّو: «إِمْشِي لْدَارِكْ ولُمَّالِيكْ واحْكِيلْهُمْ آشْ عْمَلْ مْعَاكْ الرَّبْ وكِيفَاشْ رَحْمِكْ». <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />يَاخِي مْشَى لْمَنْطَقْةْ العَشْرَة مُدُنْ، وبْدَا يَحْكِي عَلِّي عَمْلُو مْعَاهْ يَسُوعْ. والنَّاسْ الكُلْ قَعْدُوا بَاهْتِينْ.<verse eid="MRK 5:20" /></para>
  <para style="s">يَسُوعْ يْقَيِّمْ بْنَيَّة مِيْتَة ويِشْفِي مْرَا مْرِيضَة</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />ووَقْتِلِّي رْجَعْ يَسُوعْ بِالفْلُوكَة لِلجِّيهَة الأُخْرَى مْتَاعْ البُحَيْرَة، جَاوْ بَرْشَة نَاسْ لِلشَّطْ وتْلَمُّوا بِيهْ. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />جَاء وَاحِدْ مِنْ رُؤَسَاءْ مَعْبِدْ اليْهُودْ إِسْمُو يَايْرُسْ، ودُوبْ مَا شَافُو تِرْمَى قُدَّامْ سَاقِيهْ <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />وقْعَدْ يِتْشَحَّتْ فِيهْ وقَالُّو: «بِنْتِي الصْغِيرَة بِشْ تْمُوتْ. إِمْشِي مْعَايَا وحُطْ يِدِّكْ عْلِيهَا، بَاشْ تِتْشْفَى وتَحْيَى». <verse eid="MRK 5:23" /><verse number="24" style="v" sid="MRK 5:24" />ولَّى مْشَى مْعَاهْ. وتَبْعُوهْ بَرْشَة نَاسْ وكَانُوا يِدَّازُوا عْلِيهْ.<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />وكَانِتْ فَمَّة مْرَا عَنْدْهَا أَثْنَاشِنْ سْنَة وهِيَّ مْرِيضَة بْنَزِيفْ دَمْ. <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />وعَانَاتْ بَرْشَة وهِيَّ ادَّاوِي عَنْدْ الطُبَّة، وصَرْفِتْ الِّي وْرَاهَا ولِّي قُدَّامْهَا آمَا مَا اسْتْفَادِتْ بْشَيْ، بِالعَكْسْ حَالِتْهَا وَلَّاتْ أَتْعِسْ مِنْ قْبَلْ. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />ووَقْتِلِّي سَمْعِتْ بْيَسُوعْ، جَاتْ مِنْ وْرَاهْ فِي وِسْطْ النَّاسْ ومَسِّتْلُو حْوَايْجُو. <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />عْلَى خَاطِرْهَا قَالِتْ بِينْهَا وبِينْ رُوحْهَا: «يِكْفِينِي نْمِسْ حْوَايْجُو بَاشْ نَبْرَا». <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />وبِالوَقْتْ وْقِفْ النَّزِيفْ وحَسِّتْ رُوحْهَا بْرَاتْ مِنْ مْرَضْهَا. <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />وفِي نَفْسْ اللَّحْظَة يَسُوعْ حَسْ بْقُوَّة خَرْجِتْ مِنُّو، تْلَفِّتْ لِلنَّاسْ وسْإِلْهُمْ: «شْكُونْ مَسْلِي حْوَايْجِي؟». <verse eid="MRK 5:30" /><verse number="31" style="v" sid="MRK 5:31" />قَالُولُو تْلَامِذْتُو: «يَاخِي تْشُوفْ فِي النَّاسْ كِيفَاشْ يِدَّازُّوا عْلِيكْ مِنْ كُلْ شِيرَة وتِسْإِلْ: "شْكُونْ الِّي مَسْنِي؟"». <verse eid="MRK 5:31" /><verse number="32" style="v" sid="MRK 5:32" />آمَا هُوَّ تْلَفِّتْ بَاشْ يْشُوفْ شْكُونْ مَسُّو. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />يَاخِي جَاتُو المْرَا وهِيَّ تُرْعُشْ مِالخُوفْ عْلَى خَاطِرْهَا عَرْفِتْ آشْ صَارِلْهَا، وتِرْمَاتْ قُدَّامُو وقَالِتْلُو عَالحْقِيقَة الكُلْ. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />قَالِلْهَا: «يَا بِنْتِي، إِيمَانِكْ شْفَاكْ، إِمْشِي فِي الأَمَانْ وابْرَى مِنْ مَرْضِكْ!».<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />وهُوَّ يِتْكَلِّمْ، جَاوْ جْمَاعَة مِنْ دَارْ رَئِيسْ مَعْبِدْ اليْهُودْ وقَالُولُو: « بِنْتِكْ مَاتِتْ. عْلَاشْ تُقْعُدْ إِتَّعِّبْ فِي المُعَلِّمْ؟». <verse eid="MRK 5:35" /><verse number="36" style="v" sid="MRK 5:36" />آمَا يَسُوعْ كِي سْمَعْهُمْ، قَالْ لْرَئِيسْ المَعْبِدْ: «مَا تْخَافِشْ، أَمِّنْ بَرْكْ!». <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />ومَا خَلَّا حَتَّى وَاحِدْ يِمْشِي مْعَاهْ، كَانْ بُطْرُسْ ويَعْقُوبْ ويُوحَنَّا خُو يَعْقُوبْ. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />وكِي وْصُلْ لْدَارْ رَئِيسْ المَعْبِدْ، وشَافْ النَّاسْ قَاعْدِينْ يِبْكِيوْ ويْنَوْحُوا، <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />دْخَلْ وقَالِلْهُمْ: «عْلَاشْ تِبْكِيوْ وتْنَوْحُوا؟ البْنَيَّة مَا مَاتِتْشْ، هِيَّ رَاقْدَة أَكَهَوْ». <verse eid="MRK 5:39" /><verse number="40" style="v" sid="MRK 5:40" />يَاخِي ضَحْكُوا عْلِيهْ. وَلَّى خَرِّجْهُمْ يَسُوعْ الكُلْ وهَزْ مْعَاهْ بُو البْنَيَّة وأُمْهَا والتْلَامْذَة الِّي جَاوْ مْعَاهْ ودْخَلْ لِلْبِيتْ المَوْجُودَة فِيهَا البْنَيَّة. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />وشَدْهَا مِنْ يِدْهَا وقَالِلْهَا: «طَلِيثَة قُومْ!» ولِّي مَعْنَاهَا: «يَا بْنَيَّة، نْقُلِّكْ قُومْ!». <verse eid="MRK 5:41" /><verse number="42" style="v" sid="MRK 5:42" />وبِالوَقْتْ قَامِتْ البْنَيَّة ووَلَّاتْ تِمْشِي. وكَانْ عْمُرْهَا أَثْنَاشِنْ سْنَة. وقَعْدُوا النَّاسْ بَاهْتِينْ عَالإِخِّرْ. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />ووَصَّاهُمْ يَسُوعْ وأَكِّدْ عْلِيهُمْ بَاشْ مَا يْقُولُوا لْحَتَّى حَدْ عَلِّي صَارْ، وطْلَبْ مِنْهُمْ بَاشْ يَعْطِيوْهَا تَاكِلْ.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">النَّبِيْ مَا عَنْدُوشْ كَرَامَة فِي بْلَادُو</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />ومْشَى يَسُوعْ مِالمَنْطْقَة هَاذِيكَا ورْجَعْ لِبْلَادُو وتَبْعُوهْ تْلَامِذْتُو. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />ونْهَارْ السِّبْتْ، كَانْ يَسُوعْ يْعَلِّمْ فِي المَعْبَدْ. بَرْشَة نَاسْ تْعَجْبُوا وَقْتِلِّي سَمْعُوهْ وقَالُوا: «مْنِينْ لِيهْ هَاذَا؟ ومْنِينْ جَاتُو الحِكْمَة هَاذِي ومْنِينْ جَاتُو القُوَّة بَاشْ يَعْمِلْ المُعْجْزَاتْ؟ <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />يَاخِي مُشْ هَاذَا النَّجَّارْ وِلْدْ مَرْيِمْ، وخُو يَعْقُوبْ ويُوسِي ويَهُوذَا وسِمْعَانْ؟ ومُشْ خْوَاتُو البْنَاتْ عَايْشِينْ بِينَاتْنَا؟». هَاذَاكَا عْلَاشْ مَا حَبُّوشْ يِقْبْلُوهْ. <verse eid="MRK 6:3" /><verse number="4" style="v" sid="MRK 6:4" />آمَا هُوَّ قَالِلْهُمْ: « النَّبِيْ مَا عَنْدُوشْ كَرَامَة فِي بْلَادُو وبِينْ أَهْلُو ونَاسُو». <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />ومَا نَجِّمْ يَعْمِلْ غَادِي حَتَّى مُعْجْزَة، كَانْ شْوَيَّة مُرْضَى حَطْ عْلِيهُمْ يْدِيهْ وشْفَاهُمْ. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />وبْقَى مِتْعَجِّبْ مِنْ قِلِّةْ إِيْمَانْهُمْ. وبْدَا يْدُورْ فِي الدْشُرْ القْرِيبَة ويْعَلِّمْ.<verse eid="MRK 6:6" /></para>
  <para style="s">يَسُوعْ يَبْعَثْ تْلَامِذْتُو الأَثْنَاشْ يْبَشْرُوا</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7" />ومْبَعِّدْ عَيِّطْ لِلتْلَامْذَة الأَثْنَاشْ، وبْعَثْهُمْ كُلْ زُوزْ مْعَ بْعَضْهُمْ، وعْطَاهُمْ سُلْطَة عَالأَرْوَاحْ الشِّرِّيرَة. <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />ووَصَّاهُمْ بَاشْ مَا يْهِزُّوا شَيْ مْعَاهُمْ فِي الطْرِيقْ كَانْ عْصَا، لَا خُبْزْ ولَا صُرَّة ولَا فْلُوسْ فِي جْيُوبْهُمْ، <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />آمَا يِلْبْسُوا صَنْدَالْ وكَانْ تَبْدِيلَة وَحْدَة. <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />وقَالِلْهُمْ: «كِي تُدْخْلُوا لْدَارْ أَبْقَاوْ فِيهَا حَتَّى لِينْ تُخْرْجُوا مِالمْدِينَة. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />وأَيْ بْلَاصَة إِمَّالِيهَا مَا يِسْتَقْبْلُوكُمْشْ ومَا يِسْمْعُوشْ كْلَامْكُمْ، أُخْرْجُوا مِنْهَا وأُنْفْضُوا التْرَابْ مِنْ سَاقِيكُمْ أَمَارَة إِنُّو اللَّهْ مُشْ فَرْحَانْ بِيهُمْ». <verse eid="MRK 6:11" /><verse number="12" style="v" sid="MRK 6:12" />يَاخِي مْشَاوْ يْبَشْرُوا ويُطْلْبُوا مِالنَّاسْ إِنْهُمْ يْتُوبُوا. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />وخَرّْجُوا بَرْشَة شْوَاطِنْ، ودِهْنُوا بَرْشَة مُرْضَى بِالزِّيتْ، وشْفَاوْهُمْ.<verse eid="MRK 6:13" /></para>
  <para style="s">هِيرُودُسْ يُقْتِلْ يُوحَنَّا</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />وسْمَعْ المَلِكْ هِيرُودُسْ بْيَسُوعْ، عْلَى خَاطِرْ إِسْمُو وَلَّى مَشْهُورْ. كَانُوا نَاسْ يْقُولُوا: «هَاذَا يُوحَنَّا الِّي يْعَمِّدْ قَامْ مِالمُوتْ، هَاذَاكَا عْلَاشْ قَاعِدْ يَعْمِلْ فِي المُعْجْزَاتْ». <verse eid="MRK 6:14" /><verse number="15" style="v" sid="MRK 6:15" />ونَاسْ أُخْرِينْ يْقُولُوا: «هَاذَا إِيلِيَّا» وأُخْرِينْ يْقُولُوا: «هَاذَا نَبِيْ كِيفْ الأَنْبِيَاءْ الأُخْرِينْ!». <verse eid="MRK 6:15" /><verse number="16" style="v" sid="MRK 6:16" />آمَا هِيرُودُسْ وَقْتِلِّي سْمَعْ قَالْ: «هَاذَا يُوحَنَّا الِّي آنَا قَصِّيتْلُو رَاسُو، قَامْ مِالمُوتْ!». <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />عْلَى خَاطِرْ هِيرُودُسْ بِيدُو بْعَثْ شْكُونْ شَدْ يُوحَنَّا ورَبْطُو فِي الحَبْسْ، بِسْبَبْ هِيرُودِيَّا، مَرْتْ خُوهْ فِيلِۑُّسْ، الِّي عَرِّسْ بِيهَا. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />وكَانْ يُوحَنَّا يْقُلُّو: «حْرَامْ عْلِيكْ تْعَرِّسْ بْمَرْتْ خُوكْ». <verse eid="MRK 6:18" /><verse number="19" style="v" sid="MRK 6:19" />هَاذَاكَا عْلَاشْ كَانِتْ هِيرُودِيَّا نَاقْمَة عْلَى يُوحَنَّا وتْحِبْ تُقْتْلُو، آمَا مَا نَجْمِتْشْ، <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />عْلَى خَاطِرْ هِيرُودُسْ كَانْ يْخَافْ مِنُّو ويَحْمِي فِيهْ، وعَارِفْ الِّي هُوَّ رَاجِلْ تَقِيْ وصَالَحْ. وكَانْ يْحِبْ يِسْمْعُو، رَغْمِلِّي كَانْ كْلَامُو يْحَيْرُو بَرْشَة.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />وجَاتْهَا الفُرْصَة فِي عِيدْ مِيلَادْ هِيرُودُسْ، وَقْتِلِّي عْمَلْ عْشَاء، اسْتَدْعَى فِيهْ المَسْؤُولِينْ الكْبَارْ وضُبَّاطْ الجَيْشْ وأَعْيَانْ مَنْطَقْةْ الجَلِيلْ. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />وهُومَا يِتْعَشَّاوْ، دَخْلِتْ بِنْتْ هِيرُودِيَّا وشَطْحِتْ، وعِجْبِتْ هِيرُودُسْ والنَّاسْ القَاعْدِينْ مْعَاهْ. وَلَّى المَلِكْ قَالْ لِلْبْنَيَّة: «أُطْلْبْ الِّي تْحِبْ عْلِيهْ، وآنَا نَعْطِيهُولِكْ!». <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />وزَادْ حْلِفِّلْهَا وقَالْ: «الِّي تُطْلْبُو نَعْطِيهُولِكْ، حَتَّى لَوْ كَانْ نُصْ مَمْلِكْتِي!». <verse eid="MRK 6:23" /><verse number="24" style="v" sid="MRK 6:24" />يَاخِي خَرْجِتْ وسِأْلِتْ أُمْهَا: «زَعْمَة آشْ نُطْلُبْ؟». جَاوْبِتْهَا: «رَاسْ يُوحَنَّا الِّي يْعَمِّدْ!». <verse eid="MRK 6:24" /><verse number="25" style="v" sid="MRK 6:25" />رَجْعِتْ بِالوَقْتْ لِلْمَلِكْ وقَالِتْلُو: «نْحِبِّكْ تَعْطِينِي تَوَّا رَاسْ يُوحَنَّا الِّي يْعَمِّدْ فِي طْبَقْ!». <verse eid="MRK 6:25" /><verse number="26" style="v" sid="MRK 6:26" />حْزِنْ المَلِكْ بَرْشَة. آمَا عْلَى خَاطِرْ اليْمِينْ الِّي حِلْفُو وعْلَى خَاطِرْ الضْيُوفْ، مَا حَبِّشْ يِتْرَاجَعْ فِي وَعْدُو لِيهَا. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />وبِالوَقْتْ بْعَثْ المَلِكْ سَيَّافْ وأَمْرُو بَاشْ يْجِيبْلُو رَاسْ يُوحَنَّا. يَاخِي مْشَالُو وقَصْلُو رَاسُو فِي الحَبْسْ. <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />وجَابُو فِي طْبَقْ وعْطَاهْ لِلْبْنَيَّة، وهِيَّ هَزِّتُو لْأُمْهَا. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />ووَقْتِلِّي سَمْعُوا تْلَامِذْةْ يُوحَنَّا بِلِّي صَارْ، جَاوْ وهَزُّوا الجُثَّة ودِفْنُوهَا فِي قْبَرْ.<verse eid="MRK 6:29" /></para>
  <para style="s">يَسُوعْ يْوَكِّلْ 5 000 رَاجِلْ بْمُعْجْزَة</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />وجَاوْ الرُّسُلْ لْيَسُوعْ وحْكَاوْلُو عَالحَاجَاتْ الكُلْ الِّي عَمْلُوهَا ولِّي عَلّْمُوهَا. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />ومِنْ كُثْرِةْ النَّاسْ الِّي كَانُوا مَاشِينْ جَايِينْ عْلِيهُمْ، مَا لْقَاوِشْ حَتَّى الوَقْتْ بَاشْ يَاكْلُوا. وَلَّى يَسُوعْ قَالِلْهُمْ : «إِيجَاوْ مْعَايَا إِنْتُومَا وَحَّدْكُمْ لِبْلَاصَة خَالْيَة وارْتَاحُوا شْوَيَّة».<verse eid="MRK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 6:32" />يَاخِي مْشَاوْ بِالفْلُوكَة وَحَّدْهُمْ لِبْلَاصَة خَالْيَة. <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />آمَا بَرْشَة نَاسْ شَافُوهُمْ وعَرْفُوهُمْ وِينْ مَاشِينْ، يَاخِي خَرْجُوا مِنْ كُلْ دَشْرَة، يِجْرِيوْ عْلَى سَاقِيهُمْ، وسِبْقُوهُمْ لِلْبْلَاصَة الِّي مَاشِينْ لِيهَا. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />كِي هْبَطْ يَسُوعْ مِالفْلُوكَة، شَافْ بَرْشَة نَاسْ مَلْمُومِينْ، يَاخِي حَنْ عْلِيهُمْ، عْلَى خَاطِرْهُمْ كَانُوا كِي الغْنَمْ الِّي مَا عَنْدْهَاشْ سَارِحْ. وبْدَا يْعَلِّمْ فِيهُمْ فِي بَرْشَة حَاجَاتْ.<verse eid="MRK 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35" />وكِي تْعَدَّى النْهَارْ، جَاوْ التْلَامْذَة لْيَسُوعْ وقَالُولُو: «البْلَاصَة خَالْيَة، والنْهَارْ قْرِيبْ يُوفَى. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />أَبْعِثْ النَّاسْ خَلِّيهُمْ يِمْشِيوْ لِلْفِيرْمَاتْ والبْلَايِصْ القْرِيبَة ويِشْرِيوْ حَاجَة يَاكْلُوهَا». <verse eid="MRK 6:36" /><verse number="37" style="v" sid="MRK 6:37" />يَاخِي جَاوِبْهُمْ: «أَعْطِيوْهُمْ إِنْتُومَا حَاجَة يَاكْلُوهَا». قَالُولُو: «تْحِبْنَا نِشْرِيوْ خُبْزْ بِفْلُوسْ ثْمَنْيَة شْهُورْ خِدْمَة بَاشْ نَعْطِيوْهُمْ يَاكْلُوا؟». <verse eid="MRK 6:37" /><verse number="38" style="v" sid="MRK 6:38" />قَالِلْهُمْ: «إِمْشِيوْ وشُوفُوا قَدَّاشْ عَنْدْكُمْ مِنْ خُبْزَة؟». ووَقْتِلِّي شَافُوا قَالُولُو: «خَمْسَة خُبْزَاتْ وحُوتِّينْ». <verse eid="MRK 6:38" /><verse number="39" style="v" sid="MRK 6:39" />أْمَرْهُمْ يَسُوعْ بَاشْ يْقَعْدُوا النَّاسْ كُلْ جْمَاعَة مْعَ بْعَضْهُمْ فُوقْ الحْشِيشْ الأَخْضِرْ. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />قَعْدُوا كُلْ جْمَاعَة مْعَ بْعَضْهُمْ فِي حْلِقْ. حْلِقْ فِيهُمْ 100 وْحْلِقْ 50. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />وخْذَا يَسُوعْ الخَمْسَة خُبْزَاتْ والحُوتِّينْ، وهَزْ عِينِيهْ لِلسْمَاء وشْكَرْ اللَّهْ، وقْسَمْ الخُبْزَاتْ، وعْطَى لِتْلَامِذْتُو بَاشْ يْفَرْقُوهُمْ عَالنَّاسْ. والحُوتِّينْ قَسَّمْهُمْ عَالقَاعْدِينْ الكُلْ. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />والكُلْ كْلَاوْ وشَبْعُوا. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />وفُضْلِتْ أَثْنَاشِنْ قُفَّة مْعِبْيَة بِالخُبْزْ والحُوتْ. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />ولِّي كْلَاوْ مِالخُبْزْ كَانُوا 5 000 رَاجِلْ.<verse eid="MRK 6:44" /></para>
  <para style="s">يَسُوعْ يِمْشِي عَالمَاء</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />ومْبَعْدْهَا قَدْ قَدْ، حْكُمْ يَسُوعْ عْلَى تْلَامِذْتُو بَاشْ يِطْلْعُوا فِي الفْلُوكَة ويِسْبْقُوهْ لِلجِّيهَة المْقَابْلَة، لْدَشْرِةْ بِيتْ صَيْدَا، مَا بِينْ هُوَّ يَبْعَثْ النَّاسْ يْرَوْحُوا. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />وبَعْدْمَا وَدَّعْهُمْ، طْلَعْ لِلجْبَلْ بَاشْ يْصَلِّي. <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />وكِي جَاء اللِّيلْ، كَانِتْ الفْلُوكَة فِي وِسْطْ البُحَيْرَة وكَانْ يَسُوعْ وَحْدُو عَالبَرْ. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />وشَافْ تْلَامِذْتُو يِتْعَذْبُوا وهُومَا يْجَدْفُوا عْلَى خَاطِرْ الرِّيحْ كَانِتْ عَاكْسِتْهُمْ. قْبَلْ الفَجْرْ جَاهُمْ مَاشِي فُوقْ المَاء وزَعْمَة لَا فَاتْهُمْ. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />وَقْتِلِّي شَافُوهْ يِمْشِي فُوقْ المَاء مْشَى فِي بَالْهُمْ شَبَحْ يَاخِي بْدَاوْ يْصِيحُوا. <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />عْلَى خَاطِرْ الكُلْهُمْ شَافُوهْ وتْرِعْبُوا. آمَا هُوَّ كَلَّمْهُمْ بِالوَقْتْ وقَالِلْهُمْ: «إِتْشَجْعُوا. رَانِي آنَا هُوَّ، مَا تْخَافُوشْ!». <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />وكِي طْلَعْ مْعَاهُمْ فِي الفْلُوكَة، رْكَحْ الرِّيحْ . يَاخِي بِهْتُوا بَرْشَة وقَعْدُوا مِتْعَجْبِينْ. <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />عْلَى خَاطِرْ مَا فِهْمُوا شَيْ مِنْ مُعْجِزْةْ الخُبْزْ، مِنْ كُثْرْ مَا كَانِتْ قْلُوبْهُمْ كَاسْحَة.<verse eid="MRK 6:52" /></para>
  <para style="s">يَسُوعْ يِشْفِي بَرْشَة مُرْضَى</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />وكِي شَقُّوا البُحَيْرَة وُصْلُوا لْمَنْطَقْةْ جَنِّيسَارْتْ ورَبْطُوا الفْلُوكَة غَادِي. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />ودُوبْ مَا هَبْطُوا مِنْهَا النَّاسْ عَرْفُوا الِّي هُوَّ يَسُوعْ. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />بْدَاوْ يِجْرِيوْ فِي المَنْطْقَة الكُلْ ويْهِزُّولُو المُرْضَى فُوقْ فْرُوشَاتْهُمْ لْكُلْ بْلَاصَة يِسْمْعُوا بِيهْ مْشَالْهَا. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />وكُلْ بْلَاصَة يِمْشِيلْهَا، سِوَى لِلدْشُرْ وَلَّا الفِيرْمَاتْ وَلَّا الأَرْيَافْ، يْحُطُّوا المُرْضَى فِي وِسْطْ السَّاحَة ويُطْلْبُوا مِنُّو بَاشْ يْخَلِّيهُمْ يْمِسُّوا حَتَّى طْرَاطِشْ حْوَايْجُو. ولِّي مَسُّوهْ الكُلْ تِشْفَاوْ.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">وْصَايَا اللَّهْ وَلَّا تَقَالِيدْ النَّاسْ؟</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />تْلَمُّوا بِيهْ الفِرِّيسِيِّينْ ومْعَاهُمْ جْمَاعَة مِنْ عُلَمَاءْ الشَّرِيعَة الجَّايِينْ مِنْ أُورْشَلِيمْ. <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />وشَافُوا جْمَاعَة مِنْ تْلَامِذْتُو يَاكْلُوا بِيدِيهُمْ مَنْجُوسِينْ، مِنْ غِيرْ مَا يَغْسْلُوهُمْ. <verse eid="MRK 7:2" /><verse number="3" style="v" sid="MRK 7:3" />وكَانُوا الفِرِّيسِيِّينْ واليْهُودْ بْصِيفَة عَامَّة مَا يَاكْلُوا إِلَّا مَا يَغْسْلُوا يْدِيهُمْ عْلَى خَاطِرْهُمْ يْحَافْظُوا عَالعَادَاتْ الِّي فَرْضُوهَا شْيُوخْهُمْ. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />وكَانُوا كِي يِرْجْعُوا مِالسُّوقْ مَا يَاكْلُوا إِلَّا بَعْدْمَا يَطْهْرُوا. وفَمَّة بَرْشَة عَادَاتْ أُخْرَى خْذَاوْهَا مِنْ جْدُودْهُمْ وحَافْظُوا عْلِيهَا، كِيمَا غَسْلَانْ الكِيسَانْ والصْحَافِي والمَاعُونْ النْحَاسْ.<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />يَاخِي سِأْلُوهْ الفِرِّيسِيِّينْ وعُلَمَاءْ الشَّرِيعَة: «عْلَاشْ تْلَامِذْتِكْ مَا يِتْصَرْفُوشْ بْحَسْبْ عَادَاتْ شْيُوخْنَا، يَاكْلُوا وإِيدِيهُمْ مُشْ طَاهْرَة؟». <verse eid="MRK 7:5" /><verse number="6" style="v" sid="MRK 7:6" />جَاوِبْهُمْ يَسُوعْ: «يَا مُنَافْقِينْ! عَنْدُو الحَقْ إِشَعْيَاءْ وَقْتِلِّي تْنَبَّأْ عْلِيكُمْ وقَالْ فِي الكْتُبْ المُقَدْسَة:</para>
  <para style="b" vid="MRK 7:6" />
  <para style="q1" vid="MRK 7:6">"الشَّعْبْ هَاذَا يِكْرِمْنِي بْفُمُّو،</para>
  <para style="q2" vid="MRK 7:6">آمَا قَلْبُو بْعِيدْ عْلِيَّا.<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />عْبَادِتْهُمْ لِيَّا بَاطْلَة،</para>
  <para style="q2" vid="MRK 7:7">وقَاعْدِينْ يْعَلْمُوا فِي وْصَايَا حَطُّوهَا النَّاسْ".<verse eid="MRK 7:7" /></para>
  <para style="b" />
  <para style="m">
    <verse number="8" style="v" sid="MRK 7:8" />«سَيَّبْتُوا وْصِيِّةْ اللَّهْ وشَدِّيتُوا فِي عَادَاتْ وتَقَالِيدْ عَمْلُوهُمْ النَّاسْ!».<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />وقَالِلْهُمْ: «مَزْعَمْكُمْ كِي تْخَلِّيوْ وْصِيِّةْ اللَّهْ عْلَى جْنَبْ وتْكَبْشُوا فِي عَادَاتْكُمْ وتَقَالِيدْكُمْ. <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />مُوسَى قَالْ: "إِكْرِمْ بُوكْ وأُمِّكْ، ولِّي يْسِبْ بُوهْ وَلَّا أُمُّو يِلْزْمُو يِتْقْتَلْ". <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />آمَا إِنْتُومَا تْقُولُوا: "إِذَا وَاحِدْ قَالْ لْبُوهْ وَلَّا لْأُمُّو الِّي كُنْتْ نْعَاوِنْ فِيكْ بِيهْ رَانِي عْطِيتُو لِلَّهْ، <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />يْوَلِّي مَعْفِي، ومُشْ لَازِمْ يْعَاوِنْ بُوهْ وَلَّا أُمُّو". <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />هَكَّا تْرُدُّوا كْلَامْ اللَّهْ بَاطِلْ بْتَقَالِيدْكُمْ الِّي تِتْوَارْثُوا فِيهَا، وبْحَاجَاتْ أُخْرَى كِيفْهَا قَاعْدِينْ تَعْمْلُوا فِيهَا».<verse eid="MRK 7:13" /></para>
  <para style="s">شْنُوَّة الِّي يْنَجِّسْ الإِنْسَانْ؟</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />وعَيِّطْ يَسُوعْ لِلنَّاسْ مَرَّة أُخْرَى وقَالِلْهُمْ: «إِسْمْعُونِي الكُلْ وإِفْهْمُوا. <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />مَا فَمَّة حَتَّى حَاجَة تُدْخِلْ لِبْدَنْ الإِنْسَانْ تْنَجِّمْ تْنَجْسُو، آمَا الِّي يُخْرِجْ مِالإِنْسَانْ، هُوَّ الِّي يْنَجْسُو. <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />الِّي عَنْدُو وِذْنِينْ تِسْمَعْ، خَلِّيهْ يِسْمَعْ».<verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />ووَقْتِلِّي خَلَّى النَّاسْ ودْخَلْ لِلدَّارْ، سِأْلُوهْ تْلَامِذْتُو عْلَى مَعْنَى المَثَلْ. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />قَالِلْهُمْ: «حَتَّى إِنْتُومَا زَادَا مَا تِفْهْمُوشْ؟ يَاخِي مَا تَعْرْفُوشْ الِّي حَتَّى شَيْ مِلِّي يُدْخِلْ لِبْدَنْ الإِنْسَانْ يْنَجِّمْ يْنَجْسُو، <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />عْلَى خَاطِرْ مَا يُدْخُلْشْ لْقَلْبُو آمَا لْكِرْشُو ومْبَعِّدْ يُخْرُجْ مِنْ بْدَنُو؟». وهَكَّا عْلِنْ الِّي المَاكْلَة الكُلْ طَاهْرَة.<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />ومْبَعِّدْ قَالْ: «الحَاجَاتْ الِّي تُخْرُجْ مِالإِنْسَانْ هِيَّ الِّي تْنَجِّسْ الإِنْسَانْ. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />عْلَى خَاطِرْ مِنْ دَاخِلْ، مِنْ قْلُوبْ النَّاسْ تُخْرُجْ الأَفْكَارْ الخَايْبَة: الفْسَادْ والسِّرْقَة والقَتْلْ <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />والزْنَى والطْمَعْ والخْبَاثَة والغَشَّة والحُسْدْ والإِنْحِرَافْ وتَشْوِيهْ السُّمْعَة والتَّكَبُّرْ والجَهْلْ. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />الحَاجَاتْ الخَايْبَة هَاذِي الكُلْ تُخْرُجْ مِنْ دَاخِلْ الإِنْسَانْ وهِيَّ الِّي تْنَجْسُو».<verse eid="MRK 7:23" /></para>
  <para style="s">إِيمَانْ الأُمْ الفِينِيقِيَّة</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />ومْبَعِّدْ خْرَجْ يَسُوعْ مِنْ غَادِي ومْشَى لْجِيهِةْ صُورْ. ودْخَلْ لْدَارْ ومَا حَبْ حَتَّى حَدْ يَعْرِفْ هُوَّ وِينْ، آمَا مَا نَجَّمْشْ يُقْعِدْ مِتْخُبِّي، <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />وفَمَّة مْرَا بِنْتْهَا سَاكِنْهَا رُوحْ شِرِّيرْ، دُوبْ مَا سَمْعِتْ بِيهْ جَاتُو وتِرْمَاتْ قُدَّامْ سَاقِيهْ. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />واتْشَحْتِتُّو بَاشْ يْخَرِّجْ الرُّوحْ الشِّرِّيرْ مِنْ بِنْتْهَا، وكَانِتْ المْرَا هَاذِي أَصْلْهَا سُورِيَّة فِينِيقِيَّة مَعْنَاهَا مُشْ يْهُودِيَّة، <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />هَاذَاكَا عْلَاشْ قَالِلْهَا: «خَلِّي الأَوْلَادْ يَشْبْعُوا فِي الأُوِّلْ! مَا يْجِيشْ نَاخْذُوا خُبْزْ الأَوْلَادْ ونَرْمِيوَهْ لِلْكْلَابْ». <verse eid="MRK 7:27" /><verse number="28" style="v" sid="MRK 7:28" />آمَا هِيَّ جَاوْبِتُّو وقَالِتْلُو: «يَا سِيدِي! حَتَّى الكْلَابْ تَاكِلْ تَحْتْ الطَّاوْلَة مِالفِتْفَاتْ الِّي يْطَيْحُوهْ الأَوْلَادْ». <verse eid="MRK 7:28" /><verse number="29" style="v" sid="MRK 7:29" />قَالِلْهَا: «عْلَى خَاطْرِكْ قُلْتْ الكِلْمَة هَاذِي إِمْشِي، رَاهُو الرُّوحْ الشِرِّيرْ خْرَجْ مِنْ بِنْتِكْ!». <verse eid="MRK 7:29" /><verse number="30" style="v" sid="MRK 7:30" />ووَقْتِلِّي رَجْعِتْ لْدَارْهَا، لْقَاتْ بِنْتْهَا فُوقْ الفَرْشْ، ولْقَاتْ الرُّوحْ الشِّرِّيرْ خْرَجْ مِنْهَا.<verse eid="MRK 7:30" /></para>
  <para style="s">يَسُوعْ يِشْفِي أَطْرِشْ ومْلَكْوِنْ</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />وخْرَجْ يَسُوعْ مِنْ جِيهِةْ صُورْ وتْعَدَّى عْلَى صَيْدَا وعْلَى حُدُودْ بْلَاصَة اسْمْهَا العَشْرَة مُدُنْ ومْشَى لْبُحَيْرِةْ الجَلِيلْ. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />وجَابُولُو وَاحِدْ أَطْرِشْ ومْلَكْوِنْ وتْشَحْتُوهْ بَاشْ يْحُطْ عْلِيهْ يْدِيهْ. <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />يَاخِي هَزُّو وَحْدُو بْعِيدْ عَالنَّاسْ وحَطْ صْوَابْعُو فِي وِذْنِينْ الرَّاجِلْ وبَعْدْ بْزِقْ ومَسْلُو لْسَانُو. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />وهَزْ عِينِيهْ لِلسْمَاء وتْنَهِّدْ وقَالُّو: «إِفَّاتَا!» مَعْنَاهَا «إِتْحَلْ» <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />وبِالوَقْتْ تْحَلِّتْ وِذْنِيهْ ولْسَانُو تِطْلَقْ وبْدَا يْقُولْ فِي كْلَامْ وَاضَحْ. <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />ووَصَّاهُمْ يَسُوعْ بَاشْ مَا يَحْكِيوْ لْحَتَّى حَدْ. وكَانْ كُلْ مَا يْوَصِّيهُمْ أَكْثِرْ كُلْ مَا يُنْشْرُوا الخْبَرْ أَكْثِرْ. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />وكَانُوا بَاهْتِينْ فِيهْ وقَالُوا: «الحَاجَاتْ الِّي يَعْمِلْ فِيهَا الكُلْ عْظِيمَة، يْخَلِّي حَتَّى الطْرُشْ يِسْمْعُوا والبْكَاكِشْ يِتْكَلْمُوا».<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">يَسُوعْ يْوَكِّلْ 4 000 رَاجِلْ بْمُعْجْزَة</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />وفِي الوَقْتْ هَاذَاكَا، زَادُوا تْلَمُّوا بَرْشَة نَاسْ، ومَا كَانِشْ عَنْدْهُمْ مَا يَاكْلُوا. يَاخِي عَيِّطْ يَسُوعْ لِتْلَامِذْتُو وقَالِلْهُمْ: <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />«غَايْضِينِّي النَّاسْ عْلَى خَاطِرْ تَوَّا ثْلَاثَة أَيَّامْ وهُومَا مْعَايَا ومَاعَنْدْهُمْ مَا يَاكْلُوا. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />وإِذَا كَانْ نَبْعَثْهُمْ يْرَوْحُوا وهُومَا جْوَاعَى بِشْ يْدُوخُوا فِي الثْنِيَّة عْلَى خَاطِرْ فِيهُمْ الِّي جَاوْ مِنْ بْلَايِصْ بْعِيدَة». <verse eid="MRK 8:3" /><verse number="4" style="v" sid="MRK 8:4" />جَاوْبُوهْ تْلَامِذْتُو: «شْكُونْ يْنَجِّمْ يْشَبَّعْ النَّاسْ هَاذُومَا الكُلْ بِالخُبْزْ فِي بْلَاصَة خَالْيَة كِيمَا هَاذِي؟». <verse eid="MRK 8:4" /><verse number="5" style="v" sid="MRK 8:5" />يَاخِي سْإِلْهُمْ: «قَدَّاشْ عَنْدْكُمْ مِنْ خُبْزَة؟» جَاوْبُوهْ: «سَبْعَة». <verse eid="MRK 8:5" /><verse number="6" style="v" sid="MRK 8:6" />يَاخِي طْلَبْ مِالنَّاسْ بَاشْ يُقْعْدُوا فِي القَاعَة، وخْذَا السَّبْعَة خُبْزَاتْ وشْكَرْ اللَّهْ وقَسَّمْهُمْ وعْطَى لِتْلَامِذْتُو بَاشْ يْفَرْقُوا عَالنَّاسْ، وَلَّاوْ عَمْلُوا كِيمَا قَلْهُمْ. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />وكَانْ عَنْدْهُمْ كَعْبَاتْ حُوتْ صْغَارْ بَارِكْهُمْ وطْلَبْ مِالتْلَامْذَة بَاشْ يْفَرْقُوهُمْ عَالنَّاسْ. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />وكْلَاوْ النَّاسْ لِينْ شَبْعُوا. ومْبَعِّدْ هَزُّوا التْلَامْذَة سَبْعَة قْفَافْ مْعِبِّينْ بِالخُبْزْ الِّي فْضُلْ. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />والنَّاسْ الِّي كْلَاوْ كَانُوا قْرَابِةْ 4 000. ومْبَعِّدْ بْعَثْهُمْ يَسُوعْ رَوْحُوا، <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />وبِالوَقْتْ طْلَعْ فِي الفْلُوكَة مْعَ تْلَامِذْتُو وجَاء لْجِيهِةْ دَلْمَانُوثَة.<verse eid="MRK 8:10" /></para>
  <para style="s">الفِرِّيسِيِّينْ يِطْلْبُوا مُعْجْزَة</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />وجَاوْ الفِرِّيسِيِّينْ وبْدَاوْ يْنَاقْشُوا فِيهْ. وطَلْبُوا مِنُّو مُعْجْزَة مِالسْمَاء، بَاشْ يْجَرْبُوهْ. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />تْنَهِّدْ مِنْ قَلْبُو وقَالِلْهُمْ: «عْلَاشْ الجِيلْ هَاذَا يُطْلُبْ فِي مُعْجْزَة؟ نْقُولِلْكُمْ الحَقْ الجِيلْ هَاذَا مُشْ بِشْ يَاخِذْ حَتَّى مُعْجْزَة!». <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />وخَلَّاهُمْ ورْكِبْ فِي الفْلُوكَة ومْشَى لْشَطْ البُحَيْرَة المْقَابِلْ.<verse eid="MRK 8:13" /></para>
  <para style="s">رُدُّوا بَالْكُمْ مِنْ خْمِيرِةْ الفِرِّيسِيِّينْ وخْمِيرِةْ هِيرُودُسْ</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />ونْسَاوْ التْلَامْذَة بَاشْ يْهِزُّوا مْعَاهُمْ خُبْزْ، ومَا كَانْ عَنْدْهُمْ فِي الفْلُوكَة كَانْ خُبْزَة وَحْدَة. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />ووَصَّاهُمْ يَسُوعْ وقَالِلْهُمْ: «رُدُّوا بَالْكُمْ مِنْ خْمِيرِةْ الفِرِّيسِيِّينْ وخْمِيرِةْ هِيرُودُسْ». <verse eid="MRK 8:15" /><verse number="16" style="v" sid="MRK 8:16" />يَاخِي بْدَاوْ يِتْنَاقْشُوا بِينْ بْعَضْهُمْ ويْقُولُوا: «هَاذَا عْلَى خَاطِرْ مَا عَنْدْنَاشْ خُبْزْ؟». <verse eid="MRK 8:16" /><verse number="17" style="v" sid="MRK 8:17" />عْرَفْ يَسُوعْ وقَالِلْهُمْ: «شْبِيكُمْ تِتْنَاقْشُوا عَالخُبْزْ! يَاخِي مَزِّلْتُوا لْتَوَّا مَا تَعْرْفُوشْ ومَا تِفْهْمُوشْ؟ يَاخِي لْتَوَّا مَزَّالِتْ قْلُوبْكُمْ كَاسْحَة؟ <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />عَنْدْكُمْ عِينِينْ ومَا تْشُوفُوشْ؟ وعَنْدْكُمْ وِذْنِينْ ومَا تِسْمْعُوشْ؟ يَاخِي مَا تِتْذَكْرُوشْ؟ <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />وَقْتِلِّي قَسَّمْتْ الخَمْسَة خُبْزَاتْ عْلَى 5 000 رَاجِلْ، قَدَّاشْ هَزِّيتُوا مِنْ قُفَّة مْعِبْيَة بِالخُبْزْ؟» قَالُولُو: «أَثْنَاشْ!». <verse eid="MRK 8:19" /><verse number="20" style="v" sid="MRK 8:20" />«ووَقْتِلِّي قَسَّمْتْ السَّبْعَة خُبْزَاتْ عْلَى 4 000، قَدَّاشْ هَزِّيتُوا مِنْ قُفَّة مْعِبْيَة بِالخُبْزْ؟». قَالُوا: «سَبْعَة». <verse eid="MRK 8:20" /><verse number="21" style="v" sid="MRK 8:21" />قَالِلْهُمْ: «ولْتَوَّا مَزِّلْتُوا مَا فْهِمْتُوشْ؟».<verse eid="MRK 8:21" /></para>
  <para style="s">يَسُوعْ يِشْفِي أَعْمَى</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />ووُصْلُوا لْدَشْرِةْ بِيتْ صَيْدَا. وفَمَّة جْمَاعَة جَابُولُو وَاحِدْ أَعْمَى وطَلْبُوا مِنُّو بَاشْ يْحُطْ عْلِيهْ يِدُّو. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />شَدْ الأَعْمَى مِنْ يِدُّو وخَرْجُو مِالدَّشْرَة. وبَعْدْ حَطْلُو بْزَاقْ عْلَى عِينِيهْ، وحَطْ عْلِيهْ يْدِيهْ وسِأْلُو: «تْشُوفْ فِي حَاجَة؟». <verse eid="MRK 8:23" /><verse number="24" style="v" sid="MRK 8:24" />خْزَرْ وقَالْ: «نْشُوفْ فِي نَاسْ تْقُولْشْ عْلِيهُمْ شْجَرْ مَاشِينْ». <verse eid="MRK 8:24" /><verse number="25" style="v" sid="MRK 8:25" />حَطْ عْلِيهْ يِدُّو مَرَّة أُخْرَى، ووَقْتِلِّي حَلْ عِينِيهْ شَافْ كُلْ شَيْ وَاضِحْ ورْجَعْ لَابَاسْ . <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />يَاخِي بَعْثُو يْرَوَّحْ لْدَارُو وقَالُّو: «مَا تُدْخُلْشْ لِلدَّشْرَة».<verse eid="MRK 8:26" /></para>
  <para style="s">بُطْرُسْ يِشْهِدْ إِنُّو يَسُوعْ هُوَّ المَسِيحْ</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />ومْشَى يَسُوعْ وتْلَامِذْتُو لِدْشُرْ قَيْصَرِيِّةْ فِيلِۑُّسْ، وفِي الطْرِيقْ سْإِلْهُمْ: « آنَا شْكُونْ حَسْبْ رَايْ العْبَادْ؟». <verse eid="MRK 8:27" /><verse number="28" style="v" sid="MRK 8:28" />جَاوْبُوهْ: «جْمَاعَة يْقُولُوا عْلِيكْ يُوحَنَّا الِّي يْعَمِّدْ، وجْمَاعَة يْقُولُوا الِّي إِنْتِ إِيلِيَّا، وفَمَّة شْكُونْ يْقُولْ الِّي إِنْتِ وَاحِدْ مِالأَنْبِيَاءْ». <verse eid="MRK 8:28" /><verse number="29" style="v" sid="MRK 8:29" />وسْإِلْهُمْ: «وحَسْبْ رَايْكُمْ إِنْتُومَا آنَا شْكُونْ؟». جَاوْبُو بُطْرُسْ: «إِنْتِ المَسِيحْ!». <verse eid="MRK 8:29" /><verse number="30" style="v" sid="MRK 8:30" />يَاخِي نَبَّهْ عْلِيهُمْ بَاشْ مَا يْقُولُوشْ عْلَى شْكُونُو هُوَّ لْحَتَّى حَدْ.<verse eid="MRK 8:30" /></para>
  <para style="s">يَسُوعْ يِتْنَبَّأْ بْمُوتُو وقْيَامْتُو</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />وبْدَا يَسُوعْ يْعَلِّمْ فِيهُمْ الِّي إِبْنْ الإِنْسَانْ يِلْزْمُو يِتْعَذَّبْ بَرْشَة، ويُرْفْضُوهْ الشْيُوخْ وكْبَارْ الكَهَنَة وعُلَمَاءْ الشَّرِيعَة، ويِتْقْتَلْ، وبَعْدْ ثْلَاثَة أَيَّامْ يْقُومْ . <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />وكَانْ يَحْكِي عَالمَوْضُوعْ هَاذَا بْصَرَاحَة. جِبْدُو بُطْرُسْ عْلَى جْنَبْ وبْدَا يْلُومْ عْلِيهْ. <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />آمَا هُوَّ تْلَفِّتْ لِتْلَامِذْتُو ونْزَرْ عْلَى بُطْرُسْ وقَالُّو: «إِبْعِدْ عْلِيَّا يَا إِبْلِيسْ، إِنْتِ تْفَكِّرْ كِيفْ النَّاسْ مُشْ كِيفْ اللَّهْ!».<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />وعَيِّطْ لِلنَّاسْ ولِتْلَامِذْتُو وقَالِلْهُمْ: «إِذَا كَانْ وَاحِدْ يْحِبْ يْتَبَّعْنِي، لَازِمْ يُنْكُرْ رُوحُو، ويْشَارِكْنِي فِي العْذَابْ والمُوتْ. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />الِّي يْحِبْ يْمَنَّعْ حْيَاتُو يَخْسَرْهَا، ولِّي يَخْسَرْ حْيَاتُو عْلَى خَاطْرِي وعْلَى خَاطِرْ البْشَارَة يْنَجِّيهَا. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />شْنِيَّة الفَايْدَة كَانْ الإِنْسَانْ يِرْبَحْ العَالِمْ الكُلْ ويِخْسِرْ رُوحُو؟ <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />وبِشْنُوَّة يْنَجِّمْ الإِنْسَانْ يِفْدِي رُوحُو؟ <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />الِّي يِسْتْعَارْ بِيَّا وبِكْلَامِي فِي هَا الجِيلْ الفَاسِدْ والشِّرِيرْ، يِسْتْعَارْ بِيهْ إِبْنْ الإِنْسَانْ وَقْتِلِّي يِرْجَعْ فِي مَجْدْ بُوهْ مْعَ المْلَايْكَة القِدِّيسِينْ».<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />وقَالِلْهُمْ يَسُوعْ: «نْقُلْكُمْ الحَقْ: فَمَّة شْكُونْ مِالوَاقْفِينْ هُونِي مَاهُمْشْ بِشْ يْذُوقُوا المُوتْ، إِلَّا بَعْدْمَا يْشُوفُوا مَمْلَكْةْ اللَّهْ تُظْهِرْ بْقُوَّة».<verse eid="MRK 9:1" /></para>
  <para style="s">يَسُوعْ يُظْهُرْ فِي مَجْدُو</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />وبَعْدْ سِتَّة أَيَّامْ، هَزْ يَسُوعْ بُطْرُسْ ويَعْقُوبْ ويُوحَنَّا، وطْلَعْ بِيهُمْ لِجْبَلْ عَالِي وَحَّدْهُمْ، وغَادِي تْبَدْلِتْ هَيْأْتُو قُدَّامْهُمْ. <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />ووَلَّاوْ حْوَايْجُو بْيُضْ يِلْمْعُوا كِيفْ الثِّلْجْ مَا يْنَجِّمْشْ حَتَّى صَبَّاغْ فِي الدِّنْيَا يِصْبَغْ لِبْسَة بِالأَبْيِضْ كِيفْهَا. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />وظُهْرُولْهُمْ إِيلِيَّا ومُوسَى، وكَانُوا يَحْكِيوْ مْعَ يَسُوعْ.<verse eid="MRK 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5" />وقَالْ بُطْرُسْ لْيَسُوعْ: «يَا مُعَلِّمْ، مَحْلَاهَا القَعْدَة هُونِي، خَلِّينَا نُنْصْبُوا ثْلَاثَة خْيِمْ، وَحْدَة لِيكْ ووَحْدَة لْمُوسَى ووَحْدَة لْإِيلِيَّا!». <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />وكَانْ مُشْ عَارِفْ شْنُوَّة قَاعِدْ يْقُولْ مِنْ كُثْرِةْ مَا كَانُوا خَايْفِينْ.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />وجَاتْ غِيمَة وغَطَّاتْهُمْ، وخْرَجْ صُوتْ مِالغِيمَة يْقُولْ: «هَاذَا هُوَّ إِبْنِي الِّي نْحِبُّو. إِسْمْعُوا كْلَامُو!». <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />بِالوَقْتْ تْلَفْتُوا التْلَامْذَة، مَا لْقَاوْ حَتَّى حَدْ مْعَاهُمْ كَانْ يَسُوعْ وَحْدُو.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />ووَقْتِلِّي هُومَا هَابْطِينْ مِالجْبَلْ، وَصَّاهُمْ يَسُوعْ بَاشْ مَا يْقُولُوا لْحَتَّى حَدْ عَلِّي شَافُوهْ، إِلَّا بَعْدْمَا يْقُومْ إِبْنْ الإِنْسَانْ مِالمُوتْ. <verse eid="MRK 9:9" /><verse number="10" style="v" sid="MRK 9:10" />عَمْلُوا بِلِّي وَصَّاهُمْ عْلِيهْ، آمَا قَعْدُوا يِسْأْلُوا فِي بْعَضْهُمْ: «آشْ مَعْنَاهَا يْقُومْ مِالمُوتْ؟». <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" />يَاخِي سِأْلُوهْ: «عْلَاشْ يْقُولُوا عُلَمَاءْ الشَّرِيعَة الِّي لَازِمْ إِيلِيَّا يْجِي قْبَلْ؟». <verse eid="MRK 9:11" /><verse number="12" style="v" sid="MRK 9:12" />جَاوِبْهُمْ: «صْحِيحْ إِيلِيَّا يْجِي قْبَلْ ويْصَلَّحْ كُلْ شَيْ. آمَا زَادَا مَكْتُوبْ الِّي إِبْنْ الإِنْسَانْ لَازْمُو يِتْعَذَّبْ بَرْشَة ويِتْهَانْ. <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />وآنَا نْقُلْكُمْ: رَاهُو إِيلِيَّا جَاء وعَمْلُوا فِيهْ الِّي حَبُّوا، كِيفْ مَا قَالِتْ عْلِيهْ الكْتُبْ المُقَدْسَة».<verse eid="MRK 9:13" /></para>
  <para style="s">يَسُوعْ يِشْفِي طْفُلْ عَنْدُو رُوحْ شِرِّيرْ</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />ووَقْتِلِّي وُصْلُوا لْبْقِيِّةْ التْلَامْذَة، شَافُوا بَرْشَة نَاسْ دَايْرِينْ بِيهُمْ وعُلَمَاءْ الشَّرِيعَة يْنَاقْشُوا فِيهُمْ. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />ودُوبْ مَا النَّاسْ شَافُوا يَسُوعْ، تْعَجْبُوا وجْرَاوْلُو بَاشْ يْسَلْمُوا عْلِيهْ. <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />يَاخِي سْإِلْهُمْ: «فِي شْنُوَّة تْنَاقْشُوا فِيهُمْ؟». <verse eid="MRK 9:16" /><verse number="17" style="v" sid="MRK 9:17" />جَاوْبُو وَاحِدْ مِنْهُمْ: «يَا مُعَلِّمْ جِبْتْلِكْ وِلْدِي، سَاكْنُو رُوحْ شِرِّيرْ رَدُّو بَكُّوشْ. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />كُلْ مَا الرُّوحْ يْشِدُّو يِتْصْرَعْ، يْخَرِّجْ الكْشَاكِشْ مِنْ فُمُّو ويْعَظْ عْلَى سِنِّيهْ ويِيبِسْ. طْلَبْتْ مِنْ تْلَامِذْتِكْ يْخَرْجُوهْ مِنُّو، يَاخِي مَا نَجْمُوشْ». <verse eid="MRK 9:18" /><verse number="19" style="v" sid="MRK 9:19" />قَالِلْهُمْ: «إِنْتُومَا جِيلْ مُشْ مُؤْمِنْ! قَدَّاشْ بِشْ نُقْعْدِلْكُمْ؟ لْوَقْتَاشْ بِشْ نُصْبِرْ عْلِيكُمْ؟ جِيبُوهُولِي!». <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />جَابُوهُولُو. ودُوبْ مَا الرُّوحْ شَافْ يَسُوعْ، صْرَعْ الطْفُلْ وخَلَّاهْ يِتْصَكِّكْ فِي القَاعَة، وكْشَاكْشُو خَارْجَة مِنْ فُمُّو.<verse eid="MRK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21" />يَاخِي يَسُوعْ سْإِلْ بُوهْ: «مِنْ وَقْتَاشْ وهُوَّ هَكَّا؟» جَاوْبُو: «مِلِّي هُوَّ صْغِيرْ. <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />وبَرْشَة مَرَّاتْ الرُّوحْ يِرْمِيهْ فِي النَّارْ وفِي المَاء يْحِبْ يُقْتْلُو. آمَا كَانْ إِنْتِ تْنَجِّمْ تَعْمِلْ حَاجَة، حِنْ عْلِينَا وعَاوِنَّا!». <verse eid="MRK 9:22" /><verse number="23" style="v" sid="MRK 9:23" />قَالُّو يَسُوعْ: « عْلَاشْ تْقُولْ "كَانْ تْنَجِّمْ"؟ رَاهُو كُلْ شَيْ مُمْكِنْ عَنْدْ الِّي يَمِّنْ!». <verse eid="MRK 9:23" /><verse number="24" style="v" sid="MRK 9:24" />وبِالوَقْتْ صَاحْ بُو الطْفُلْ: «آنَا نَمِّنْ! عَاوِنِّي إِنْتِ وقَوِّي إِيمَانِي الضْعِيفْ!». <verse eid="MRK 9:24" /><verse number="25" style="v" sid="MRK 9:25" />ووَقْتِلِّي شَافْ يَسُوعْ النَّاسْ يِتْجَارَاوْ بَاشْ يِتْلَمُّوا بِيهْ، نْزَرْ عَالرُّوحْ الشِرِّيرْ وقَالُّو: «يَا رُوحْ، يَلِّي رَدِّيتْ الطْفُلْ هَاذَا بَكُّوشْ وأَطْرِشْ، نُأْمْرِكْ بَاشْ تُخْرُجْ مِنُّو ومَا عَادِشْ تِرْجَعْلُو بِالكُلْ!». <verse eid="MRK 9:25" /><verse number="26" style="v" sid="MRK 9:26" />صَاحْ الرُّوحْ وخَلَّى الطْفُلْ يِتْصَكِّكْ بِالقْوِيْ، وخْرَجْ مِنُّو. ووَلَّى الطْفُلْ كَايِنُّو مِيِّتْ، بِالعْمَلْ بَرْشَة نَاسْ قَالُوا الِّي هُوَّ مَاتْ بِالحَقْ. <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />آمَا وَقْتِلِّي شَدُّو يَسُوعْ مِنْ يِدُّو وقَيْمُو، قَامْ. <verse eid="MRK 9:27" /><verse number="28" style="v" sid="MRK 9:28" />وبَعْدْمَا دْخَلْ يَسُوعْ لِلدَّارْ، سِأْلُوهْ تْلَامِذْتُو وهُومَا وَحَّدْهُمْ: «عْلَاشْ أَحْنَا مَا نَجَّمْنَاشْ نْخَرْجُوا الرُّوحْ الشِرِّيرْ؟». <verse eid="MRK 9:28" /><verse number="29" style="v" sid="MRK 9:29" />جَاوِبْهُمْ: «النَّوْعْ هَاذَا مَا يُخْرِجْ كَانْ بِالصَّلَاةْ والصْيَامْ».<verse eid="MRK 9:29" /></para>
  <para style="s">يَسُوعْ يْعَاوِدْ يِتْنَبَّأْ بْمُوتُو وقْيَامْتُو</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />خَرْجُوا مِنْ غَادِي وتْعَدَّاوْ عْلَى مَنْطَقْةْ الجَلِيلْ. ومَا حَبِّشْ يَسُوعْ يِسْمَعْ بِيهْ حَتَّى وَاحِدْ، <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />عْلَى خَاطِرْ كَانْ يْعَلِّمْ فِي تْلَامِذْتُو ويْقُولِلْهُمْ: «إِبْنْ الإِنْسَانْ بِشْ يْسَلْمُوهْ فِي يْدِينْ النَّاسْ، وبِشْ يُقْتْلُوهْ، وفِي النْهَارْ الثَّالِثْ يْقُومْ». <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />آمَا هُومَا مَا فِهْمُوشْ كْلَامُو وخَافُوا بَاشْ يِسْأْلُوهْ.<verse eid="MRK 9:32" /></para>
  <para style="s">شْكُونْ هُوَّ الأَعْظَمْ؟</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />ومْبَعِّدْ جَاء يَسُوعْ لْكَفْرْنَاحُومْ. ووَقْتِلِّي هُوَّ فِي الدَّارْ سْإِلْ تْلَامِذْتُو: «فَاشْ كُنْتُوا تَحْكِيوْ فِي الطْرِيقْ؟». <verse eid="MRK 9:33" /><verse number="34" style="v" sid="MRK 9:34" />يَاخِي سِكْتُوا، عْلَى خَاطِرْهُمْ كَانُوا يِتْنَاقْشُوا فِي شْكُونْ فِيهُمْ أَعْظِمْ مِالآخِرْ. <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />قْعَدْ وعَيِّطْ لِلْأَثْنَاشِنْ تِلْمِيذْ وقَالِلْهُمْ: «إِذَا وَاحِدْ يْحِبْ يْكُونْ أُوِّلْ النَّاسْ، لَازْمُو يْوَلِّي آخِرْهُمْ ويِخْدِمْهُمْ الكُلْ!». <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />وجَابْ طْفُلْ صْغِيرْ ووَقْفُو فِي وِسْطْهُمْ، وعَنْقُو، وقَالِلْهُمْ: <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />«الِّي يِقْبِلْ وْلَيِّدْ مِالأَوْلَادْ الصْغَارْ هَاذُمْ عْلَى خَاطْرِي، يِقْبِلْنِي آنَا. ومُشْ يِقْبِلْنِي آنَا أَكَهَوْ، آمَا يِقْبِلْ زَادَا الِّي بْعَثْنِي».<verse eid="MRK 9:37" /></para>
  <para style="s">الِّي مُشْ ضِدْنَا هُوَّ مْعَانَا</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />قَالُّو يُوحَنَّا: «يَا مُعَلِّمْ، شُفْنَا وَاحِدْ يْخَرِّجْ فِي الشْوَاطِنْ بْإِسْمِكْ، يَاخِي مْنَعْنَاهْ، عْلَى خَاطْرُو مُشْ تَابَعْنَا». <verse eid="MRK 9:38" /><verse number="39" style="v" sid="MRK 9:39" />آمَا يَسُوعْ قَالْ: «مَا تَمْنْعُوهِشْ! عْلَى خَاطِرْ مَا فَمَّة حَتَّى وَاحِدْ يَعْمِلْ مُعْجْزَة بْإِسْمِي، وبَعْدْهَا فِيسَعْ يِتْكَلِّمْ عْلِيَّا بِالخَايِبْ. <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />الِّي مُشْ ضِدْنَا هُوَّ مْعَانَا. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />ونْقُلْكُمْ الحَقْ الِّي يَعْطِيكُمْ كَاسْ مَاء، عْلَى خَاطِرْكُمْ تَابْعِينْ لِلْمَسِيحْ، أَجْرُو مَا يْضِيعِشْ.<verse eid="MRK 9:41" /></para>
  <para style="s">مَا تْكُونِشْ سْبَبْ إِنُّو خُوكْ يُغْلُطْ</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />«الِّي يْكُونْ سْبَبْ فِي إِنُّو وَاحِدْ مِالصْغَارْ المُؤْمْنِينْ بِيَّا يُغْلُطْ، خِيرْلُو كَانْ يْعَلَّقْ حْجَرْ الرْحَى فِي رَقْبْتُو ويَرْمِي رُوحُو فِي البْحَرْ. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />وكَانْ يِدِّكْ تْخَلِّيكْ تُغْلِطْ قُصْهَا. خِيرْلِكْ تُدْخِلْ لِلْحْيَاةْ الأَبَدِيَّة ويِدِّكْ مَقْصُوصَة، مِلِّي تُدْخِلْ بِيدِيكْ الإِثْنِينْ لِجْهَنِّمْ، لْنَارْ مَا تِطْفَاشْ، <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />وِينْ دُودْهُمْ مَا يْمُوتِشْ والنَّارْ مَا تَطْفَاشْ. <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />وكَانْ سَاقِكْ تْخَلِّيكْ تُغْلِطْ قُصْهَا، خِيرْلِكْ تُدْخِلْ لِلْحْيَاةْ الأَبَدِيَّة وسَاقِكْ مَقْصُوصَة مِلِّي تُدْخِلْ بْسَاقِيكْ الزُّوزْ لِجْهَنِّمْ، <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />وِينْ دُودْهُمْ مَا يْمُوتِشْ والنَّارْ مَا تِطْفَاشْ. <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />وكَانْ عِينِكْ تْخَلِّيكْ تُغْلِطْ قَلَّعْهَا، خِيرْلِكْ تُدْخِلْ لِلْحْيَاةْ الأَبَدِيَّة بْعِينْ وَحْدَة، مِنْ أَنِّكْ تُدْخِلْ بْعِينِيكْ الزُّوزْ لِجْهَنِّمْ، <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />وِينْ دُودْهُمْ مَا يْمُوتِشْ والنَّارْ مَا تِطْفَاشْ. <verse eid="MRK 9:48" /><verse number="49" style="v" sid="MRK 9:49" />كُلْ وَاحِدْ بِشْ يِتْمَلَّحْ بِالنَّارْ.<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />«المِلْحْ بَاهِي. آمَا إِذَا كَانْ المِلْحْ مَا عَادِشْ فِيهْ مَطْعِمْ، كِيفَاشْ نْرَجْعُولُو مَطْعْمُو؟ خَلِّيكُمْ كِي المِلْحْ، وعِيشُوا فِي سَلَامْ مْعَ بْعَضْكُمْ».<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">الطْلَاقْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />ومْشَى يَسُوعْ مِنْ غَادِي وجَاء لْمَنْطَقْةْ اليَهُودِيَّة، لِلجِّيهَة الأُخْرَى مِنْ وَادْ الأُرْدُنْ، وتْلَمُّوا بِيهْ النَّاسْ مَرَّة أُخْرَى، وبْدَا يْعَلِّمْ فِيهُمْ كِالْعَادَة. <verse eid="MRK 10:1" /><verse number="2" style="v" sid="MRK 10:2" />وجَاوِهْ جْمَاعَة فِرِّيسِيِّينْ وسَأْلُوهْ بَاشْ يْجَرْبُوهْ: «يَاخِي حْلَالْ الرَّاجِلْ يْطَلَّقْ مَرْتُو؟». <verse eid="MRK 10:2" /><verse number="3" style="v" sid="MRK 10:3" />جَاوِبْهُمْ: «آشْ وَصَّاكُمْ مُوسَى؟». <verse eid="MRK 10:3" /><verse number="4" style="v" sid="MRK 10:4" />قَالُوا: «مُوسَى سْمَحْ لِلرَّاجِلْ بَاشْ يِكْتِبْ وَرْقِةْ طْلَاقْ لْمَرْتُو، ويْطَلَّقْهَا». <verse eid="MRK 10:4" /><verse number="5" style="v" sid="MRK 10:5" />قَالِلْهُمْ يَسُوعْ: « مُوسَى كْتِبِّلْكُمْ الوْصِيَّة هَاذِي مِنْ كْسُوحِيِّةْ قْلُوبْكُمْ . <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />آمَا مِلِّي تْخَلْقِتْ الدِّنْيَا، اللَّهْ خْلَقْ الإِنْسَانْ ذْكَرْ وأَنْثَى. <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />وهَاذَاكَا عْلَاشْ الرَّاجِلْ يْخَلِّي بُوهْ وأُمُّو ويِتْرْبَطْ بْمَرْتُو، <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />ويْوَلِّيوْ الإِثْنِينْ بْدَنْ وَاحِدْ. مَا عَادِشْ زُوزْ آمَا بْدَنْ وَاحِدْ. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />عْلَى خَاطِرْ الِّي يَجْمْعُو اللَّهْ مَا يْفَرْقُوشْ الإِنْسَانْ».<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />وَقْتِلِّي رَجْعُوا لِلدَّارْ، عَاوْدُوا تْلَامِذْتُو جِبْدُولُو نَفْسْ المَوْضُوعْ. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />قَالِلْهُمْ: «الِّي يْطَلَّقْ مَرْتُو ويْعَرِّسْ بِمْرَا أُخْرَى، يَزْنَى عْلِيهَا. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />وإِذَا كَانْ المْرَا طَلْقِتْ رَاجِلْهَا وعَرّْسِتْ بْرَاجِلْ آخِرْ، تَزْنَى!».<verse eid="MRK 10:12" /></para>
  <para style="s">يَسُوعْ يْبَارِكْ الصْغَارْ</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />وجَاوْ نَاسْ وجَابُولُو صْغَارْ بَاشْ يْحُطْ عْلِيهُمْ يِدُّو ويْبَارِكْهُمْ. يَاخِي التْلَامْذَة لَامُوهُمْ. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />ووَقْتِلِّي شَافْهُمْ يَسُوعْ تْغَشِّشْ وقَالِلْهُمْ: «خَلِّيوْ الصْغَارْ يْجِيوْنِي، ومَا تَمْنْعُوهُمْشْ، عْلَى خَاطِرْ مَمْلَكْةْ اللَّهْ يُدْخْلُولْهَا النَّاسْ الِّي كِيفْهُمْ. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />نْقُولِلْكُمْ الحَقْ:الِّي مَا يِقْبِلْشْ مَمْلَكْةْ اللَّهْ كِيمَا الطْفُلْ الصْغِيرْ، عُمْرُو مَا يُدْخْلِلْهَا!». <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />وعَنَّقْهُمْ وحَطْ عْلِيهُمْ يْدِيهْ وبَارِكْهُمْ.<verse eid="MRK 10:16" /></para>
  <para style="s">الرَّاجِلْ الغْنِيْ</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />وكِي خْرَجْ يَسُوعْ، جَاهْ رَاجِلْ يِجْرِي وسْجِدْلُو وسِأْلُو: «يَا مُعَلِّمْ يَا صَالَحْ آشْ نَعْمِلْ بَاشْ نُورِثْ الحَيَاةْ الأَبَدِيَّة؟». <verse eid="MRK 10:17" /><verse number="18" style="v" sid="MRK 10:18" />آمَا يَسُوعْ قَالُّو: «عْلَاشْ تْعَيَّطْلِي يَا صَالَحْ؟ مَا فَمَّة حَتَّى وَاحِدْ صَالَحْ كَانْ اللَّهْ وَحْدُو. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />إِنْتِ تَعْرِفْ الوْصَايَا: "مَا تَعْمِلْشْ جْرِيمِةْ قَتْلْ، مَا تَزْنَاشْ، مَا تِسْرَقْشْ، مَا تِشْهِدْشْ بِالكِذْبْ، مَا تْغُشِّشْ، إِكْرِمْ بُوكْ وأُمُّكْ!"». <verse eid="MRK 10:19" /><verse number="20" style="v" sid="MRK 10:20" />قَالُّو: «يَا مُعَلِّمْ، الوْصَايَا هَاذُمْ نَعْمِلْ فِيهُمْ مِنْ صُغْرِي». <verse eid="MRK 10:20" /><verse number="21" style="v" sid="MRK 10:21" />يَاخِي يَسُوعْ خْزَرْلُو بِمْحَبَة وقَالُّو: «مَزَّالِتْ نَاقْصِتِّكْ حَاجَة وَحْدَة، بِيعْ الِّي عَنْدِكْ الكُلْ وفَرْقُو عَالفْقَارَى، وهَكَّا يْوَلِّي عَنْدِكْ كِنْزْ فِي السْمَاء ومْبَعِّدْ إِيجَا تَبَّعْنِي». <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />آمَا هُوَّ كِي سْمَعْ الكْلَامْ هَاذَا مْشَى حْزِينْ ومَهْمُومْ عْلَى خَاطْرُو كَانْ صَاحِبْ ثَرْوَة كْبِيرَة.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />تْلَفِّتْ يَسُوعْ وقَالْ لِتْلَامِذْتُو: «مَصْعِبْ دْخُولْ الغْنِيِّينْ لْمَمْلَكْةْ اللَّهْ!». <verse eid="MRK 10:23" /><verse number="24" style="v" sid="MRK 10:24" />تْعَجْبُوا التْلَامْذَة مِنْ كْلَامُو. وعَاوِدْ يَسُوعْ قَالِلْهُمْ مَرَّة أُخْرَى: «يَا وْلَادِي، مَصْعِبْ دْخُولْ النَّاسْ الِّي تِتْوَكِّلْ عْلَى فْلُوسْهَا لْمَمْلَكْةْ اللَّهْ! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />دْخُولْ الجْمَلْ مِنْ نُقْبِةْ الإِبْرَة أَسْهِلْ مِنْ دْخُولْ الغْنِيْ لْمَمْلَكْةْ اللَّهْ!». <verse eid="MRK 10:25" /><verse number="26" style="v" sid="MRK 10:26" />التْلَامْذَة تْصَدْمُوا، وقَالُوا لِبْعَضْهُمْ: «مَالَا شْكُونْ يْنَجِّمْ يِنْجَى؟» . <verse eid="MRK 10:26" /><verse number="27" style="v" sid="MRK 10:27" />خْزَرِّلْهُمْ يَسُوعْ وقَالِلْهُمْ: «هَاذَا مُسْتَحِيلْ عَنْدْ النَّاسْ آمَا مُشْ مُسْتَحِيلْ عَنْدْ اللَّهْ، عْلَى خَاطِرْ عَنْدْ اللَّهْ كُلْ شَيْ مُمْكِنْ!».<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />قَلُّو بُطْرُسْ: «إِنْتِ تَعْرِفْ الِّي أَحْنَا خَلِّينَا كُلْ شَيْ وتَبَّعْنَاكْ». <verse eid="MRK 10:28" /><verse number="29" style="v" sid="MRK 10:29" />جَاوْبُو يَسُوعْ: «نْقُلْكُمْ الحَقْ: كُلْ مِنْ خَلَّا دَارْ وَلَّا إِخْوَة وَلَّا خْوَاتْ وَلَّا أُمْ وَلَّا بُو وَلَّا وْلَادْ وَلَّا أَرْضْ عْلَى خَاطْرِي وعْلَى خَاطِرْ البْشَارَة، <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />بِشْ يَاخُذْ قَدْهُمْ 100 مَرَّة دْيَارْ وإِخْوَة وخْوَاتْ وأُمَّاتْ ووْلَادْ وأَرَاضِي فِي الزْمَانْ هَاذَا مْعَ الإِضْطِهَادْ زَادَا، ويَاخِذْ الحَيَاةْ الأَبَدِيَّة فِي الزْمَانْ الجَّايْ. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />وفَمَّة بَرْشَة نَاسْ كَانُوا الأُوْلَانِينْ بِشْ يْوَلِّيوْ الإِخْرَانِينْ، ونَاسْ كَانُوا الإِخْرَانِينْ بِشْ يْوَلِّيوْ الأُوْلَانِينْ!».<verse eid="MRK 10:31" /></para>
  <para style="s">يَسُوعْ يْزِيدْ يِتْنَبَّأْ بْمُوتُو وقْيَامْتُو</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />وكَانُوا فِي الطْرِيقْ طَالْعِينْ لْأُورْشَلِيمْ، ويَسُوعْ يِمْشِي قُدَّامْهُمْ. وكَانُوا التْلَامْذَة مِتْحَيْرِينْ والنَّاسْ الِّي يْتَبْعُوا فِيهْ خَايْفِينْ. جْبِدْ التْلَامْذَة الأَثْنَاشْ عْلَى جْنَبْ، وبْدَا يَحْكِيلْهُمْ عَلِّي بِشْ يْصِيرْلُو وقَالْ: <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />«هَانَا طَالْعِينْ لْأُورْشَلِيمْ، وِينْ بِشْ يْسَلْمُوا إِبْنْ الإِنْسَانْ لِكْبَارْ الكَهَنَة وعُلَمَاءْ الشَّرِيعَة. وهُومَا بِشْ يُحْكْمُوا عْلِيهْ بِالمُوتْ ويْسَلْمُوهْ لِيدِينْ حُكَّامْ مَاهُمْشْ يْهُودْ. <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />وبِشْ يْهِينُوهْ ويِبْزْقُوا عْلِيهْ، ويِجْلْدُوهْ، ويُقْتْلُوهْ. وفِي النْهَارْ الثَّالِثْ يْقُومْ!».<verse eid="MRK 10:34" /></para>
  <para style="s">الِّي يْحِبْ يْكُونْ عْظِيمْ، لَازِمْ يْكُونْ خْدِيمْ</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />مْبَعِّدْ، جَاوِهْ يَعْقُوبْ ويُوحَنَّا وْلَادْ زَبَدِي وقَالُولُو: «يَا مُعَلِّمْ، نْحِبُّوكْ تَعْمِلْ الِّي نُطْلْبُوهْ مِنِّكْ». <verse eid="MRK 10:35" /><verse number="36" style="v" sid="MRK 10:36" />سْأَلْهُمْ: «شْنُوَّة تْحِبُّونِي نَعَمْلِلْكُمْ؟». <verse eid="MRK 10:36" /><verse number="37" style="v" sid="MRK 10:37" />قَالُولُو: «وَقْتِلِّي تْكُونْ فِي مَجْدِكْ، خَلِّينَا نُقْعْدُوا وَاحِدْ عْلَى يْمِينِكْ، ووَاحِدْ عْلَى يْسَارِكْ!». <verse eid="MRK 10:37" /><verse number="38" style="v" sid="MRK 10:38" />قَالِلْهُمْ يَسُوعْ: «إِنْتُومَا مُشْ عَارْفِينْ آشْ قَاعْدِينْ تُطْلْبُوا: تْنَجْمُوا تُشْرْبُوا الكَاسْ الِّي بِشْ نُشْرُبُو آنَا، وَلَّا تْقَاسِيوْ العْذَابْ الِّي بِشْ نِتْعَذْبُو آنَا؟». <verse eid="MRK 10:38" /><verse number="39" style="v" sid="MRK 10:39" />قَالُولُو: «انَّجْمُوا». جَاوِبْهُمْ يَسُوعْ: «الكَاسْ الِّي بِشْ نُشْرْبُو آنَا بِشْ تُشْرْبُوهْ، والعْذَابْ الِّي بِشْ نِتْعَذْبُو آنَا بِشْ تِتْعَذْبُوهْ. <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />آمَا القَعْدَة عْلَى يْمِينِي وعْلَى يْسَارِي مَا انَّجِّمْ نَعْطِيهَا كَانْ لِلِّي حَضَّرْهَالْهُمْ اللَّهْ».<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />ووَقْتِلِّي سَمْعُوا العَشْرَة تْلَامْذَة الأُخْرِينْ الكْلَامْ هَاذَا، تْغَشْشُوا عْلَى يَعْقُوبْ ويُوحَنَّا. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />آمَا يَسُوعْ عَيْطِلْهُمْ وقَالِلْهُمْ: «تَعْرْفُوا الِّي حُكَّامْ الشُّعُوبْ يْسَيْطْرُوا عْلِيهُمْ، ولِّي عَنْدْهُمْ السُّلْطَة يِتْسَلْطُوا عْلِيهُمْ. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />وهَاذَا مَا يِلْزْمُوشْ يْكُونْ بِينَاتْكُمْ، آمَا الِّي يْحِبْ يْكُونْ فِيكُمْ عْظِيمْ، لَازِمْ يْكُونْ لِيكُمْ خْدِيمْ، <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />ولِّي يْحِبْ يْوَلِّي الأُوِّلْ فِيكُمْ، لَازْمُو يْكُونْ عَبْدْ لِيكُمْ. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />عْلَى خَاطِرْ إِبْنْ الإِنْسَانْ مَا جَاشْ بَاشْ النَّاسْ يِخْدْمُوهْ، آمَا بَاشْ يِخْدِمْهُمْ ويِفْدِي بِحْيَاتُو بَرْشَة مِنْهُمْ».<verse eid="MRK 10:45" /></para>
  <para style="s">يَسُوعْ يِشْفِي بَارْتِيمَاوُسْ الأَعْمَى</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />ومْبَعِّدْ وُصْلُوا لْأَرِيحَا. ووَقْتِلِّي كَانْ خَارِجْ مِالمْدِينَة ومْعَاهْ تْلَامِذْتُو وبَرْشَة نَاسْ أُخْرِينْ، كَانْ بَارْتِيمَاوُسْ الأَعْمَى وِلْدْ تِيمَاوُسْ قَاعِدْ عْلَى جْنَبْ الطْرِيقْ يُطْلُبْ. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />وَقْتِلِّي سْمَعْ الِّي المِتْعِدِّي هُوَّ يَسُوعْ النَّاصِرِي، بْدَا يْعَيِّطْ : «يَا يَسُوعْ وِلْدْ دَاوِدْ، أَرْحَمْنِي!». <verse eid="MRK 10:47" /><verse number="48" style="v" sid="MRK 10:48" />وصَاحُوا عْلِيهْ بَرْشَة نَاسْ بَاشْ يُسْكُتْ، آمَا هُوَّ وَلَّى يْعَيِّطْ أَكْثِرْ: «يَا وِلْدْ دَاوِدْ، ارْحَمْنِي!». <verse eid="MRK 10:48" /><verse number="49" style="v" sid="MRK 10:49" />يَاخِي وْقِفْ يَسُوعْ وقَالْ: «عَيْطُولُو!». وعَيْطُوا لِلْأَعْمَى وقَالُولُو: «اتْشَجَّعْ، وقُومْ! أَهَوْكَا يْعَيِّطْلِكْ!». <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />وَلَّى رْمَى بَرْنُوسُو وقَامْ ومْشَى لْيَسُوعْ. <verse eid="MRK 10:50" /><verse number="51" style="v" sid="MRK 10:51" />وسِأْلُو يَسُوعْ: «شْنُوَّة تْحِبْنِي نَعْمِلِّكْ؟». قَالُّو الأَعْمَى: «يَا مُعَلِّمْ، نْحِبْ نْشُوفْ!». <verse eid="MRK 10:51" /><verse number="52" style="v" sid="MRK 10:52" />يَاخِي قَالُّو يَسُوعْ: «إِمْشِي! إِيمَانِكْ شْفَاكْ». وبِالوَقْتْ رْجَعْلُو نَظْرُو ووَلَّى يْتَبَّعْ فِي يَسُوعْ.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">النَّاسْ يِسْتَقْبْلُوا يَسُوعْ فِي أُورْشَلِيمْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />وَقْتِلِّي قُرْبُوا مِنْ أُورْشَلِيمْ، ووُصْلُوا لْدَشْرِةْ بِيتْ فَاجِي ودَشْرِةْ بِيتْ عَنْيَا، بَحْذَا جْبَلْ الزِّيتُونْ، بْعَثْ يَسُوعْ زُوزْ مِنْ تْلَامِذْتُو، <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />وقَالِلْهُمْ: «إِمْشِيوْ لِلدَّشْرَة لِمْقَابْلِتْكُمْ، ودُوبْ مَا تُدْخْلُولْهَا بِشْ تَلْقَاوْ جَحْشْ مَرْبُوطْ عُمْرُو مَا رْكِبْ عْلِيهْ حَتَّى حَدْ. حِلُّولُو الرْبَاطْ وجِيبُوهُولِي لَهْنَا. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />وإِذَا وَاحِدْ سْإِلْكُمْ: "عْلَاشْ تَعْمْلُوا هَكَّا؟" قُولُوا: "سِيدْنَا حَاشْتُو بِيهْ وتَوْ فِيسَعْ يْرَجْعُو"».<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />ومْشَاوْ، ولْقَاوْ الجَّحْشْ مَرْبُوطْ فِي بَابْ، يَاخِي حَلُّولُو الرْبَاطْ. <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />وفَمَّة جْمَاعَة كَانُوا وَاقْفِينْ غَادِي قَالُولْهُمْ: «آشْ تَعْمْلُوا؟ عْلَاشْ تْسَيْبُوا فِي الجَّحْشْ؟». <verse eid="MRK 11:5" /><verse number="6" style="v" sid="MRK 11:6" />وجَاوْبُوا كِيفْ مَا وَصَّاهُمْ يَسُوعْ، يَاخِي خَلَّاوْهُمْ يِمْشِيوْ. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />وجَابُوا الجَّحْشْ لْيَسُوعْ، وحَطُّوا عْلِيهْ حْوَايِجْهُمْ. يَاخِي رْكِبْ فُوقُو. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />وبَرْشَة نَاسْ فِرْشُوا حْوَايِجْهُمْ عَالطْرِيقْ، ونَاسْ أُخْرِينْ فِرْشُوا أَعْرَافْ قَصُّوهَا مِالأَشْجَارْ. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />وكَانُوا الِّي مَاشِينْ قُدَّامُو ولِّي وْرَاهْ يْعَيْطُوا:</para>
  <para style="b" vid="MRK 11:9" />
  <para style="q1" vid="MRK 11:9">«أُوصَنَّا!</para>
  <para style="q2" vid="MRK 11:9">مُبَارَكْ الِّي جَايْ بْإِسْمْ الرَّبْ!<verse eid="MRK 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10" />مُبَارْكَة مَمْلَكْةْ بُونَا دَاوِدْ الِّي جَايَة!</para>
  <para style="q2" vid="MRK 11:10">المَجْدْ لِلَّهْ فِي السْمَاء!».<verse eid="MRK 11:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />ودْخَلْ يَسُوعْ لْأُورْشَلِيمْ، ومْشَى لِلْهَيْكِلْ، وقْعَدْ يْرَاقِبْ فِلِّي قَاعِدْ صَايِرْ فِيهْ الكُلْ. وكَانْ الوَقْتْ إِمَّخِّرْ، يَاخِي مْشَى لْبِيتْ عَنْيَا هُوَّ والتْلَامْذَة الأَثْنَاشْ.<verse eid="MRK 11:11" /></para>
  <para style="s">كَرْمَة بْلَا غَلَّة</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />ومِنْ غُدْوَة، كِي خَرْجُوا مِنْ بِيتْ عَنْيَا، حَسْ بِالجُوعْ. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />وشَافْ مِنْ بْعِيدْ كَرْمَة فِيهَا بَرْشَة أَوْرَاقْ، يَاخِي مْشَالْهَا فَمَّاشْ مَا يَلْقَى فِيهَا كَرْمُوسْ. وَقْتِلِّي وْصِلِّلْهَا مَا لْقَى فِيهَا كَانْ الأَوْرَاقْ، عْلَى خَاطِرْ وَقْتْ الكَرْمُوسْ مَزَّالْ مَا جَاشْ. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />يَاخِي قَالِلْهَا: «مِنْ تَوَّا مَا عَادْ يَاكِلْ مِنْ غَلْتِكْ حَتَّى وَاحِدْ لِلْأَبَدْ!». وكَانُوا تْلَامِذْتُو يِسْمْعُوا فِيهْ.<verse eid="MRK 11:14" /></para>
  <para style="s">يَسُوعْ يْطَرِّدْ البَيَّاعَة مِالهَيْكِلْ</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />ووُصْلُوا لْأُورْشَلِيمْ، وكِي دْخَلْ يَسُوعْ لِلْهَيْكِلْ بْدَا يْطَرِّدْ فِلِّي كَانُوا يْبِيعُوا ويِشْرِيوْ غَادِي، وقْلِبْ طْوَاوِلْ النَّاسْ الِّي يْصَرْفُوا فِي الفْلُوسْ وكْرَاسِي الِّي يْبِيعُوا فِي الحْمَامْ. <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />ومَا خَلَّا حَتَّى وَاحِدْ هَازِزْ سِلْعَة يُدْخُلْ لِلْهَيْكِلْ. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />وبْدَا يْعَلِّمْ فِيهُمْ ويْقُولْ: «يَاخِي مُشْ مَكْتُوبْ: "دَارِي بِشْ تِتْسَمَّى دَارْ صْلَاةْ لِلشُّعُوبْ الكُلْ"؟ آمَا إِنْتُومَا رَدِّيتُوهَا مْغَارِةْ سُرَّاقْ!».<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />وسَمْعُوا كْبَارْ الكَهَنَة وعُلَمَاءْ الشَّرِيعَة الكْلَامْ هَاذَا، ومِنْ خُوفْهُمْ مِنُّو، بْدَاوْ يْلَوْجُوا كِيفَاشْ يُقْتْلُوهْ، عْلَى خَاطِرْ النَّاسْ الكُلْ كَانُوا مَبْهُورِينْ بْتَعْلِيمُو. <verse eid="MRK 11:18" /><verse number="19" style="v" sid="MRK 11:19" />وَقْتِلِّي جَاء اللِّيلْ، خَرَجْ يَسُوعْ وتْلَامِذْتُو مِالمْدِينَة.<verse eid="MRK 11:19" /></para>
  <para style="s">العِبْرَة مِنْ حْكَايِةْ الكَرْمَة</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />وهُومَا رَاجْعِينْ فِي الصْبَاحْ، شَافُوا الكَرْمَة يَابْسَة بْكُلْهَا حَتَّى لِلْعْرُوقْ. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />وتْذَكِّرْ بُطْرُسْ الِّي صَارْ وقَالُّو: «يَا مُعَلِّمْ، شُوفْ! الكَرْمَة الِّي لْعَنْتْهَا يِبْسِتْ!». <verse eid="MRK 11:21" /><verse number="22" style="v" sid="MRK 11:22" />يَاخِي قَالِلْهُمْ: «خَلِّي عَنْدْكُمْ إِيمَانْ بِاللَّهْ! <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />نْقُلْكُمْ الحَقْ، الِّي يْقُولْ لِلجْبَلْ هَاذَا: "إِتْقَلَّعْ واتْرْمَى فِي البْحَرْ!" ومَا يْشُكِّشْ فِي قَلْبُو آمَا يَمِّنْ إِنُّو الِّي يْقُولُو بِشْ يْصِيرْ، رَاهُو يْصِيرْ. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />هَاذَاكَا عْلَاشْ نْقُولِلْكُمْ: الِّي تُطْلْبُوهْ فِي صْلَاتْكُمْ، أَمْنُوا الِّي إِنْتُومَا خْذِيتُوهْ، تَوْ تَاخْذُوهْ. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />ووَقْتِلِّي تَاقْفُوا بَاشْ تْصَلِّيوْ، إِغْفْرُوا لِلِّي غْلُطْ فِي حَقْكُمْ، بَاشْ بُوكُمْ الِّي فِي السْمَاء يِغْفْرِلْكُمْ أَغْلَاطْكُمْ. <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />آمَا كَانْ مَا تِغْفْرُوشْ لِلْأُخْرِينْ، بُوكُمْ الِّي فِي السْمَاء زَادَا مَا يِغْفْرِلْكُمْشْ أَغْلَاطْكُمْ».<verse eid="MRK 11:26" /></para>
  <para style="s">سُلْطِةْ يَسُوعْ</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />ورَجْعُوا لْأُورْشَلِيمْ مَرَّة أُخْرَى. ووَقْتِلِّي يَسُوعْ كَانْ يِمْشِي فِي الهَيْكِلْ، جَاوَهْ كْبَارْ الكَهَنَة وعُلَمَاءْ الشَّرِيعَة والشْيُوخْ، <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />وسِأْلُوهْ: «بْآنَا سُلْطَة تَعْمِلْ فِي الحَاجَاتْ هَاذِي؟ وشْكُونْ عْطَاكْ السُّلْطَة بَاشْ تَعْمِلْهَا؟». <verse eid="MRK 11:28" /><verse number="29" style="v" sid="MRK 11:29" />جَاوِبْهُمْ يَسُوعْ : «وآنَا زَادَا نِسْإِلْكُمْ سُؤَالْ وَاحِدْ، وإِذَا تْجَاوْبُونِي، نْقُلْكُمْ بْآنَا سُلْطَة نَعْمِلْ فِي الحَاجَاتْ هَاذِي: <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />شْكُونْ عْطَى السُّلْطَة لْيُوحَنَّا بَاشْ يْعَمِّدْ؟ اللَّهْ وَلَّا النَّاسْ؟ جَاوْبُونِي!».<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />تْشَاوْرُوا مَا بِينَاتْهُمْ وقَالُوا: «إِذَا قُلْنَا: "مِنْ عَنْدْ اللَّهْ" يْقُولْ: "مَالَا عْلَاشْ مَا أَمَّنْتُوشْ بِلِّي جَاء بِيهْ؟". <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />زَعْمَة نْقُولُوا: "مِنْ عَنْدْ النَّاسْ"؟». آمَا كَانُوا خَايْفِينْ مِالشَّعْبْ، عْلَى خَاطْرُو كَانْ يَعْتَبِرْ يُوحَنَّا نَبِيْ بِالحَقْ. <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />يَاخِي جَاوْبُوهْ: «مَا نَعْرْفُوشْ». قَالِلْهُمْ يَسُوعْ: «حَتَّى آنَا مَا نْقُلْكُمْشْ بْآنَا سُلْطَة نَعْمِلْ فِي الحَاجَاتْ هَاذِي».<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">مَثَلْ الفَلَّاحَة</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />وبْدَا يَسُوعْ يْكَلِّمْ فِيهُمْ بِالأَمْثَالْ، وقَالْ: «فَمَّة وَاحِدْ زْرَعْ سَانْيَة عْنِبْ ودَوِّرْ بِيهَا سُورْ، وبْنَى فِيهَا مَعْصْرَة، وبُرْجْ، وكْرَاهَا لْفَلَّاحَة وسَافِرْ. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />وكِي طَابْ العْنِبْ، بْعَثْ وَاحِدْ مِنْ خَدَّامْتُو لِلْفَلَّاحَة بَاشْ يَاخِذْ بَايُو مِالصَّابَة. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />يَاخِي شَدُّوهْ وضَرْبُوهْ ورَجْعُوهْ يْدِيهْ فَارْغَة. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />عَاوِدْ بْعَثِّلْهُمْ وَاحِدْ آخِرْ. يَاخِي ضَرْبُوهْ عْلَى رَاسُو وهَانُوهْ. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />وَلَّى بْعَثْ وَاحِدْ آخِرْ، يَاخِي قَتْلُوهْ. وزَادْ بْعَثْ بَرْشَة غِيرْهُمْ، يَاخِي جِلْدُوا جْمَاعَة وقَتْلُوا جْمَاعَة أُخْرِينْ. <verse eid="MRK 12:5" /><verse number="6" style="v" sid="MRK 12:6" />ومَا قْعَدْ لِلرَّاجِلْ كَانْ وِلْدُو الِّي يْحِبُّو بَرْشَة، وَلَّى فِي الإِخِّرْ بْعَثْهُولْهُمْ وقَالْ: "تَوْ يْقَدْرُوا وِلْدِي!". <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" />آمَا الفَلَّاحَة قَالُوا لِبْعَضْهُمْ: "أَهَوَّا الوْرِيثْ، هَيَّا نُقْتْلُوهْ ونَاخْذُوا أَحْنَا الوَرْثَة!". <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />يَاخِي شَدُّوهْ وقَتْلُوهْ ورْمَاوَهْ لْبَرَّة مِالسَّانْيَة. <verse eid="MRK 12:8" /><verse number="9" style="v" sid="MRK 12:9" />آشْ بِشْ يَعْمِلْ مُولَى السَّانْيَة؟ يْجِي ويُقْتِلْ الفَلَّاحَة ويَعْطِي السَّانْيَة لْنَاسْ أُخْرِينْ. <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />يَاخِي مَا قْرِيتُوشْ الآيَة المَكْتُوبَة:</para>
  <para style="b" vid="MRK 12:10" />
  <para style="q1" vid="MRK 12:10">"الحَجْرَة الِّي رَفْضُوهَا البَنَّايَا،</para>
  <para style="q2" vid="MRK 12:10">وَلَّاتْ حَجْرِةْ السَّاسْ.<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />هَاذَا آشْ عْمَلْ الرَّبْ،</para>
  <para style="q2" vid="MRK 12:11">وهَاذِي حَاجَة عْجِيبَة بِالنِّسْبَة لِينَا!"».<verse eid="MRK 12:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />وحَبُّوا يْشِدُّوهْ، خَاطِرْهُمْ فِهْمُوا الِّي هُوَّ كَانْ يُقْصِدْ فِيهُمْ هُومَا بِالمَثَلْ هَاذَا. آمَا خَافُوا مِالنَّاسْ، يَاخِي خَلَّاوَهْ ومْشَاوْ.<verse eid="MRK 12:12" /></para>
  <para style="s">الضَّرَايِبْ لِلْقَيْصِرْ</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />وبَعْثُولُو جْمَاعَة مِالفِرِّيسِيِّينْ وجْمَاعَة تَابْعِينْ هِيرُودُسْ، بَاشْ يْحَصْلُوهْ بْكِلْمَة يْقُولْهَا. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />وَقْتِّلِي جَاوُوهْ قَالُولُو: «يَا مُعَلِّمْ، أَحْنَا نَعْرْفُوا الِّي إِنْتِ صَرِيحْ، ومَا تْخَافْ مِنْ حَدْ. عْلَى خَاطْرِكْ مَا تَعْمَلْشْ حْسَابْ لِمْقَامَاتْ النَّاسْ، وتْعَلِّمْ طْرِيقْ اللَّهْ بِالحَقْ. يَاخِي حْلَالْ نَدْفْعُوا الضَّرَايِبْ لِلْقَيْصِرْ وَلَّا لَا؟ نَدْفْعُوا وَلَّا مَا نَدْفْعُوشْ؟». <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />يَاخِي هُوَّ فَاقْ بْنِفَاقْهُمْ وقَالِلْهُمْ: «عْلَاشْ تْجَرْبُوا فِيَّا؟ جِيبُولِي دِينَارْ خَلِّينِي نْشُوفُو!». <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />جَابُولُو دِينَارْ، يَاخِي سْإِلْهُمْ: «مْتَاعْ شْكُونْ التَّصْوِيرَة هَاذِي، وإِسْمْ شْكُونْ هَاذَا؟» قَالُولُو: «مْتَاعْ القَيْصِرْ». <verse eid="MRK 12:16" /><verse number="17" style="v" sid="MRK 12:17" />قَالِلْهُمْ يَسُوعْ: «أَعْطِيوْ الِّي يْخُصْ القَيْصِرْ لِلْقَيْصِرْ، ولِّي يْخُصْ اللَّهْ لِلَّهْ!». وقَعْدُوا الكُلْهُمْ بَاهْتِينْ فِيهْ.<verse eid="MRK 12:17" /></para>
  <para style="s">بَعْدْ القِيَامَة مَا فَمَّاشْ عِرْسْ</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />وجَاوِهْ جْمَاعَة مِالصَّدُّوقِيِّينْ الِّي يْقُولُوا مَا فَمَّاشْ قْيَامَة بَعْدْ المُوتْ، وسِأْلُوهْ: <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />«يَا مُعَلِّمْ، مُوسَى كْتِبِّلْنَا: إِذَا كَانْ وَاحِدْ خُوهْ مَاتْ وخَلَّى مَرْتُو مِنْ بَعْدُو مِنْ غِيرْ مَا يْجِيبْ صْغَارْ، يِلْزِمْ خُوهْ يْعَرِّسْ بِيهَا ويْجِيبْ صْغَارْ ويْقَيِّدْهُمْ بْإِسْمْ خُوهْ الِّي مَاتْ.<verse eid="MRK 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 12:20" />«وكَانْ فَمَّة سَبْعَة أَخْوَة، عَرِّسْ الأُوِّلْ بِمْرَا ومَاتْ مِنْ غِيرْ مَا يْجِيبْ صْغَارْ. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />وعَرِّسْ بِيهَا الثَّانِي ومَاتْ هُوَّ زَادَا مِنْ غِيرْ مَا يْجِيبْ صْغَارْ وكِيفْ كِيفْ الثَّالِثْ . <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />وهَكَّا عَرْسُوا بِيهَا السَّبْعَة ومَاتُوا مِنْ غِيرْ مَا جَابُوا صْغَارْ. وبَعْدْهُمْ الكُلْ، مَاتِتْ المْرَا زَادَا. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />مَالَا فِي يُومْ القْيَامَة، وَقْتِلِّي يْقُومُوا مِالمُوتْ، بِشْ تْكُونْ مَرْتْ شْكُونْ فِيهُمْ؟ هَايْ عَرْسِتْ بِيهُمْ السَّبْعَة؟». <verse eid="MRK 12:23" /><verse number="24" style="v" sid="MRK 12:24" />جَاوِبْهُمْ يَسُوعْ: «إِنْتُومَا غَالْطِينْ، عْلَى خَاطِرْكُمْ مَا تِفِهْمُوشْ لَا الكْتُبْ المُقَدْسَة ولَا قُوِّةْ اللَّهْ! <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />بَعْدْ القْيَامَة النَّاسْ لَا يْعَرْسُوا ولَا يْعَرْسُولْهُمْ، آمَا يْكُونُوا كِيفْ المْلَايْكَة الِّي فِي السْمَاء. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />آمَا كَانْكُمْ عْلَى قْيَامِةْ المُوتَى، يَاخِي مَا قْرِيتُوشْ فِي التَّوْرَاةْ حْكَايِةْ شَجْرِةْ العُلِّيقَة، كِيفَاشْ اللَّهْ كَلَّمْ مُوسَى وقَالُّو: "آنَا إِلَاهْ إِبْرَاهِيمْ وإِلَاهْ إِسْحَاقْ وإِلَاهْ يَعْقُوبْ"؟ <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />مَالَا هُوَّ مُشْ إِلَاهْ المُوتَى، آمَا إِلَاهْ الحَيِّينْ. إِنْتُومَا رَاكُمْ غَالْطِينْ بَرْشَة!».<verse eid="MRK 12:27" /></para>
  <para style="s">أَهَمْ وْصِيَّة</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />وسْمَعْهُمْ وَاحِدْ مِنْ عُلَمَاءْ الشَّرِيعَة يِتْنَاقْشُوا، وعِجْبُو كِيفَاشْ يَسُوعْ جَاوِبْهُمْ. يَاخِي سِأْلُو: «آنَاهِي أَهَمْ وْصِيَّة فِي الوْصَايَا الكُلْ؟». <verse eid="MRK 12:28" /><verse number="29" style="v" sid="MRK 12:29" />جَاوْبُو يَسُوعْ: «أَهَمْ وْصِيَّة هِيَّ: "إِسْمْعُوا يَا بَنِي إِسْرَائِيلْ، الرَّبْ إِلَاهْنَا هُوَّ رَبْ وَاحِدْ. <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />حِبْ الرَّبْ إِلَاهِكْ بْكُلْ قَلْبِكْ وبْكُلْ رُوحِكْ وبْكُلْ عَقْلِكْ وبْكُلْ قُوْتِكْ". <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />والثَّانْيَة هِيَّ: "حِبْ قْرِيبِكْ كِيفْ مَا تْحِبْ رُوحِكْ". مَا فَمَّاشْ وْصِيَّة أُخْرَى أَعْظِمْ مِنْ هَاذُومَا الإِثْنِينْ». <verse eid="MRK 12:31" /><verse number="32" style="v" sid="MRK 12:32" />وقَالُّو العَالِمْ فِي الشَّرِيعَة: «صْحِيحْ يَا مُعَلِّمْ! قُلْتْ الحَقْ. خَاطِرْ اللَّهْ وَاحِدْ ومَا فَمَّاشْ غِيرُو. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />وإِنُّو الوَاحِدْ يْحِبُّو بْكُلْ قَلْبُو وبْكُلْ عَقْلُو وبْكُلْ قُوْتُو، ويْحِبْ قْرِيبُو كِيفْ مَا يْحِبْ رُوحُو، هَاذُومَا أَحْسِنْ مِنْ كُلْ الذْبَايَحْ والقَرَابِينْ الِّي تِتْحْرَقْ». <verse eid="MRK 12:33" /><verse number="34" style="v" sid="MRK 12:34" />وكِي شَافْ يَسُوعْ الِّي هُوَّ جَاوِبْ بْحِكْمَة قَالُّو: «مَاكِشْ بْعِيدْ عْلَى مَمْلَكْةْ اللَّهْ!». وحَتَّى حَدْ مَا تْجَرَّأْ يْزِيدْ يِسْأْلُو.<verse eid="MRK 12:34" /></para>
  <para style="s">المَسِيحْ ودَاوِدْ</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />وَقْتِلِّي كَانْ يَسُوعْ يْعَلِّمْ فِي الهَيْكِلْ، قَالْ: «عْلَاشْ عُلَمَاءْ الشَّرِيعَة يْقُولُوا الِّي المَسِيحْ هُوَّ وِلْدْ دَاوِدْ؟ <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />ودَاوِدْ بِيدُو قَالْ بِالرُّوحْ القُدُسْ:</para>
  <para style="b" vid="MRK 12:36" />
  <para style="q1" vid="MRK 12:36">"قَالْ اللَّهْ لْرَبِّي:</para>
  <para style="q2" vid="MRK 12:36">أُقْعُدْ عْلَى يْمِينِي،</para>
  <para style="q1" vid="MRK 12:36">حَتَّى لِينْ نْحُطْ أَعْدَائِكْ تَحْتْ سَاقِيكْ".<verse eid="MRK 12:36" /></para>
  <para style="b" />
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />«إِذَا كَانْ دَاوِدْ نَفْسُو يَعْيِّطْ لِلْمَسِيحْ رَبْ، مَالَا كِيفَاشْ يْكُونْ وِلْدُو؟». وكَانُوا بَرْشَة نَاسْ يِسْمْعُوا فِيهْ وفَرْحَانِينْ.<verse eid="MRK 12:37" /></para>
  <para style="s">رُدُّوا بَالْكُمْ مِنْ عُلَمَاءْ الشَّرِيعَة</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />وكِي كَانْ يْعَلِّمْ قَالِلْهُمْ: «رُدُّوا بَالْكُمْ مِنْ عُلَمَاءْ الشَّرِيعَة، الِّي يْحِبُّوا يْدُورُوا بِاللِّبْسَة الطْوِيلَة، ويْحِبُّوا النَّاسْ تْسَلِّمْ عْلِيهُمْ فِي الأَسْوَاقْ، <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />ويْحِبُّوا يُقْعْدُوا فِي الصَّفْ الأُوِّلْ فِي المَعَابِدْ وفِي المْحَافِلْ، <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />وهُومَا يِسِرْقُوا فِي فْلُوسْ الهَجَّالَاتْ، ويْطَوْلُوا فِي الصْلَاةْ بَاشْ النَّاسْ تْرَاهُمْ. هَاذُوكُمْ بِشْ يِتْحَاسْبُوا أَكْثِرْ مِالنَّاسْ الأُخْرِينْ!».<verse eid="MRK 12:40" /></para>
  <para style="s">التَّبَرُّعَاتْ</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />وقْعَدْ يَسُوعْ مْقَابِلْ صَنْدُوقْ التَّبَرُّعَاتْ الِّي فِي الهَيْكِلْ، وبْدَا يْشُوفْ فِي النَّاسْ كِيفَاشْ يْحُطُّوا فِي الفْلُوسْ. وبَرْشَة غْنِيِّينْ حَطُّوا بَرْشَة فْلُوسْ. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />ومْبَعِّدْ جَاتْ مْرَا هَجَّالَة وفْقِيرَة وحَطِّتْ زُوزْ فْرَنْكْ. <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />يَاخِي عَيِّطْ لِتْلَامِذْتُو وقَالِلْهُمْ: «نْقُلْكُمْ الحَقْ: المْرَا الهَجَّالَة الفْقِيرَة هَاذِي، حَطِّتْ فِي الصَّنْدُوقْ أَكْثِرْ مِلِّي حَطُّوهْ النَّاسْ الأُخْرِينْ الكُلْ. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />الكُلْهُمْ عْطَاوْ مِلِّي فَاضِلْ عْلِيهُمْ، آمَا هِيَّ رَغْمِلِّي مِحْتَاجَة، حَطِّتْ الِّي عَنْدْهَا الكُلْ. حَطِّتْ الفْلُوسْ الِّي تْعِيشْ بِيهُمْ الكُلْ».<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">يَسُوعْ يِتْنَبَّأْ بِخْرَابْ أُورْشَلِيمْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />وهُوَّ خَارِجْ مِالهَيْكِلْ، قَالُّو وَاحِدْ مِنْ تْلَامِذْتُو: «يَا مُعَلِّمْ، شُوفْ مَلَّا حْجَرْ ومَلَّا بَنِيْ!». <verse eid="MRK 13:1" /><verse number="2" style="v" sid="MRK 13:2" />جَاوْبُو يَسُوعْ: «شُفْتْ البَنِيْ العْظِيمْ هَاذَا؟ لَا حَجْرَة مِنُّو بِشْ تِبْقَى فُوقْ أُخْتْهَا، الكُلُّو بِشْ يْطِيحْ».<verse eid="MRK 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />ووَقْتِلِّي يَسُوعْ كَانْ قَاعِدْ فِي جْبَلْ الزِّيتُونْ مْقَابِلْ الهَيْكِلْ، سِأْلُوهْ بُطْرُسْ ويَعْقُوبْ ويُوحَنَّا وأَنْدَرَاوُسْ وَقْتِلِّي وَحَّدْهُمْ: <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />«قُولِلْنَا: وَقْتَاشْ بِشْ يْصِيرْ هَاذَا؟ وكِي يُقْرُبْ الوَقْتْ، شْنِيَّة الأَمَارَة الِّي نَجْمُوا نَعْرْفُوهْ بِيهَا؟».<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />جَاوِبْهُمْ يَسُوعْ: «رُدُّوا بَالْكُمْ لَا وَاحِدْ يْغَلَّطْكُمْ! <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />بِشْ يْجِيوْ بَرْشَة بْإِسْمِي ويْقُولُوا: "آنَا هُوَّ المَسِيحْ!" ويْغَلْطُوا بَرْشَة نَاسْ. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />آمَا، وَقْتِلِّي تِسْمْعُوا بِالحْرُوبَاتْ وأَخْبَارْ الحْرُوبَاتْ مَا تْخَافُوشْ، خَاطِرْ هَاذَا لَازْمُو يْصِيرْ، آمَا هَاذِي مُشْ النِّهَايَة. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />بِشْ تِتْقْلِبْ أُمَّة عْلَى أُمَّة، ومَمْلْكَة عْلَى مَمْلْكَة، وبِشْ تْصِيرْ زْلَازِلْ فِي بَرْشَة بْلَايِصْ، وبَرْشَة مَجَاعَاتْ، آمَا هَاذِي مَاهِي إِلَّا بِدَايِةْ المْوَاجَعْ.<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />«مَالَا رُدُّوا بَالْكُمْ، عْلَى خَاطِرْ بِشْ يْسَلْمُوكُمْ لِلْمْحَاكِمْ وبِشْ تِتْضَرْبُوا فِي المْعَابِدْ، وتَاقْفُوا قُدَّامْ حُكَّامْ ومُلُوكْ عْلَى خَاطْرِي، بَاشْ تِشْهْدُولِي. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />آمَا قْبَلْ كُلْ شَيْ لَازِمْ تُوصِلْ البْشَارَة لِلشْعُوبْ الكُلْ. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />ووَقْتِلِّي يْشِدُّوكُمْ بَاشْ يْسَلْمُوكُمْ لِلْمْحَاكِمْ، مَا تُقُعْدُوشْ تْخَمُّوا آشْ بِشْ تْقُولُوا، آمَا قُولُوا الكْلَامْ الِّي يْجِيكُمْ وَقْتْهَا، عْلَى خَاطِرْ مَاكُمْشْ إِنْتُومَا الِّي تِتْكَلْمُوا آمَا الرُّوحْ القُدُسْ هُوَّ الِّي يِتْكَلِّمْ. <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" />والخُو بِشْ يْسَلِّمْ خُوهْ لِلْمُوتْ، والبُو يْسَلِّمْ وِلْدُو، والوْلَادْ يْدُورُوا عْلَى وَالْدِيهُمْ ويْكُونُوا سْبَبْ فِي قَتْلْهُمْ. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />وبِشْ يِكْرْهُوكُمْ النَّاسْ الكُلْ عْلَى خَاطِرْ إِسْمِي. آمَا الِّي يِثْبِتْ لِلِّخِّرْ، يِنْجَى».<verse eid="MRK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />«ووَقْتِلِّي تْشُوفُوا "النْجَاسَة الِّي تْخَرِّبْ" مَوْجُودَة فِي البْلَاصَة الِّي مَا يِلْزِمْشْ تْكُونْ فِيهَا — خَلِّي القَارِي يِفْهِمْ — وَقْتْهَا الِّي فِي مَنْطَقْةْ اليَهُودِيَّة يُهْرْبُوا لِلجْبَالْ. <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />ولِّي فُوقْ السْطَحْ مَا يَهْبِطْشْ لْدَارُو ومَا يُدْخُلْشْ يْهِزْ مِنْهَا حَاجَة. <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />ولِّي كَانْ فِي السَّانْيَة، مَا يِرْجَعْشْ يْهِزْ حْوَايْجُو. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />ويَا وِيلْ النْسَاء الحْبَالَى ولِّي يْرَضْعُوا فِي الأَيَّامَاتْ هَاذُوكُمْ! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />صَلِّيوْ بَاشْ مَا يْصِيرِشْ هَاذَا فِي الشْتَاء. <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />وبِشْ يْصِيرْ فِي الأَيَّامَاتْ هَاذُوكُمْ ضِيقْ كْبِيرْ، مَا صَارِشْ كِيفُو مِلِّي خْلَقْ اللَّهْ الدِّنْيَا لْتَوَّا، ومُشْ بِشْ يِتْعَاوِدْ بِالكُلْ. <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />ولَوْ كَانْ مُشْ الرَّبْ قَصِّرْ الأَيَّامَاتْ هَاذُوكُمْ، رَاوْ مَا نَجِّمْ حَتَّى حَدْ يِنْجَى. آمَا هُوَّ قَصَّرْهُمْ عْلَى خَاطِرْ النَّاسْ الِّي اخْتَارْهُمْ.<verse eid="MRK 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21" />«إِذَا قَالِلْكُمْ وَاحِدْ وَقْتْهَا: "هَاوْ المَسِيحْ هُونِي!" وَلَّا "أَهَوْكَا غَادِي"، مَا تْصَدْقُوهِشْ! <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />خَاطِرْ بِشْ يُظْهْرُوا أَكْثِرْ مِنْ مَسِيحْ دَجَّالْ وبَرْشَة أَنْبِيَاءْ كَذَّابِينْ، وبِشْ يَعْمْلُوا مُعْجْزَاتْ وعْجَايِبْ يْحَاوْلُوا يْغَلْطُوا بِيهُمْ حَتَّى النَّاسْ الِّي اخْتَارْهُمْ اللَّهْ. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />رُدُّوا بَالْكُمْ. هَانِي قُلْتِلْكُمْ كُلْ شَيْ قْبَلْ مَا يْصِيرْ.<verse eid="MRK 13:23" /></para>
  <para style="s">يَسُوعْ بَاشْ يْجِي مَرَّة أُخْرَى</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />«آمَا فِي الأَيَّامَاتْ هَاذُوكُمْ، بَعْدْ الضِّيقْ، بِشْ تِظْلَامْ الشَّمْسْ ويِتْحْجِبْ ضَوْء الڨَمْرَة، <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />ونْجُومْ السْمَاء بِشْ اطِّيحْ، وتِتْزَعْزَعْ كُلْ قُوَّة فِي السْمَاوَاتْ. <verse eid="MRK 13:25" /><verse number="26" style="v" sid="MRK 13:26" />وَقْتْهَا النَّاسْ بِشْ يْشُوفُوا إِبْنْ الإِنْسَانْ جَايْ فِي السْحَابْ بْقُوَّة عْظِيمَة ومَجْدْ. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />وفِي الوَقْتْ هَاذَاكَا يَبْعَثْ مْلَايِكْتُو بَاشْ يْلِمُّوا النَّاسْ الِّي إِخْتَارْهُمْ مِالشَّرْقْ والغَرْبْ والشَّمَالْ والجَنُوبْ، مِنْ طَرْفْ لْحَرْفْ الدِّنْيَا».<verse eid="MRK 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />«خُوذُوا العِبْرَة مِالكَرْمَة: دُوبْ مَا أَعْرَافْهَا تِخْضَارْ واطَّلَّعْ الأَوْرَاقْ، تَعْرْفُوا الِّي الصِّيفْ قْرُبْ. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />وإِنْتُومَا زَادَا نَفْسْ الشَّيْ، كِي تْشُوفُوا الحَاجَاتْ هَاذِي قَاعْدَة تْصِيرْ، أَعْرْفُوا الِّي الوَقْتْ قْرُبْ وعَالأَبْوَابْ. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />نْقُلْكُمْ الحَقْ: الحَاجَاتْ هَاذِي الكُلْ بِشْ تْصِيرْ قْبَلْ مَا يْمُوتْ الجِيلْ هَاذَا. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />السْمَاء والأَرْضْ يِفْنَاوْ، آمَا كْلَامِي عُمْرُو مَا يِفْنَى.<verse eid="MRK 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />«آمَا النْهَارْ هَاذَاكَا والسَّاعَة هَاذِيكَا مَا يَعْرَفْهُمْ حَتَّى حَدْ، لَا المْلَايْكَة الِّي فِي السْمَاء، ولَا الإِبْنْ، مَا يَعْرِفْهُمْ كَانْ الآبْ. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />رُدُّوا بَالْكُمْ وفِيقُوا عْلَى خَاطِرْكُمْ مَا تَعْرْفُوشْ وَقْتَاشْ يْجِي الوَقْتْ. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />وبِشْ يْكُونْ هَاذَا كِيمَا إِنْسَانْ خَلَّى دَارُو وسَافِرْ لِبْعِيدْ، وعْطَى المَسْؤُولِيَّة لْخَدَّامْتُو بَاشْ يِتْصَرِّفْ كُلْ وَاحِدْ فِي خِدْمْتُو، ووَصَّى العَسَّاسْ بَاشْ يْكُونْ فَايِقْ ويْرُدْ بَالُو. <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />مَالَا أَسْهْرُوا، خَاطِرْكُمْ مَا تَعْرْفُوشْ وَقْتَاشْ مُولَى الدَّارْ يِرْجَعْ، فِي العْشِيَّة امَّخَّرْ وَلَّا فِي نُصْ اللِّيلْ، وَلَّا الفَجْرْ، وَلَّا فِي الصْبَاحْ، <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />بَاشْ مَا يْجِيشْ عْلَى غَفْلَة ويَلْقَاكُمْ رَاقْدِينْ. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />ولِّي نْقُولْهُولْكُمْ، نْقُولُو لِلنَّاسْ الكُلْ: أَسْهْرُوا!»<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">يِتْحَيْلُوا بَاشْ يُقْتْلُوا يَسُوعْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />قْبَلْ عِيدْ الفِصْحْ اليْهُودِي وعِيدْ الفْطِيرْ بِنْهَارِينْ، كَانُوا كْبَارْ الكَهَنَة وعُلَمَاءْ الشَّرِيعَة يِتْحَيْلُوا كِيفَاشْ يْشِدُّوا يَسُوعْ ويُقْتْلُوهْ. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />آمَا كَانُوا يْقُولُوا: «الأَحْسَنْ مَا نَعْمْلُوشْ هَاذَا فِي العِيدْ، بَاشْ مَا يْهِيجِشْ الشَّعْبْ!».<verse eid="MRK 14:2" /></para>
  <para style="s">دَبُّوزِةْ العِطْرْ</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />وَقْتِلِّي كَانْ يَسُوعْ فِي بِيتْ عَنْيَا، مِتَّكِي فِي دَارْ سِمْعَانْ الأَبْرِصْ، جَاتْ مْرَا هَازَّة دَبُّوزَة عِطْرْ النَّارْدِينْ الصَّافِي والغَالِي، وكَسْرِتْهَا وصَبِّتْلُو العِطْرْ عْلَى رَاسُو. <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />وفَمَّة نَاسْ مِالحَاضْرِينْ تْغَشْشُوا وقَالُوا: «عْلَاشْ هَكَّا تَبْذِيرْ العِطْرْ؟ <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />كَانْ يْنَجِّمْ يِتْبَاعْ بْأَكْثِرْ مِنْ شَهْرِيِّةْ عَامْ كَامِلْ، والفْلُوسْ يَاخْذُوهَا الفْقَارَى». وبْدَاوْ يْلُومُوا فِي المْرَا. <verse eid="MRK 14:5" /><verse number="6" style="v" sid="MRK 14:6" />آمَا يَسُوعْ قَالْ: «أَخْطَاوْهَا! عْلَاشْ تْقَلْقُوا فِيهَا؟ رَاهِي عَمْلِتْلِي حَاجَة بَاهْيَة. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />الفْقَارَى دِيمَا مْعَاكُمْ، وتْنَجْمُوا تَعْمْلُوا مْعَاهُمْ الخِيرْ وَقْتِلِّي تْحِبُّوا. آمَا آنَا مَانِيشْ بِشْ نْكُونْ مْعَاكُمْ دِيمَا. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />هِيَّ عَمْلِتْ الِّي تَقْدِرْ عْلِيهْ. وغَسّْلِتْ بَدْنِي بِالمْسَبَّقْ وحَضْرِتُّو لِلدْفِينَة. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />نْقُلْكُمْ الحَقْ: وِينْ مَا تِتْنْشَرْ البْشَارَة فِي العَالِمْ الكُلْ، بِشْ يَحْكِيوْ النَّاسْ عَلِّي عَمْلِتُّو المْرَا هَاذِي، ويُقْعْدُوا دِيمَا يِتْفَكْرُوهَا!».<verse eid="MRK 14:9" /></para>
  <para style="s">يَهُوذَا الخَايِنْ</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />ومْشَى يَهُوذَا الإِسْخَرْيُوطِي، الِّي هُوَّ وَاحِدْ مِالأَثْنَاشْ، لِكْبَارْ الكَهَنَة بَاشْ يْسَلْمِلْهُمْ يَسُوعْ. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />ووَقْتِلِّي سَمْعُوا، فَرْحُوا ووِعْدُوهْ بَاشْ يَعْطِيوِهْ فْلُوسْ، وقْعَدْ يِسْتَنَّى فِي فُرْصَة بَاهْيَة بَاشْ يْسَلْمُو.<verse eid="MRK 14:11" /></para>
  <para style="s">العِيدْ</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />وفِي النْهَارْ الأُوِّلْ فِي عِيدْ الفْطِيرْ الِّي كَانُوا يِذْبْحُوا فِيهْ عَلُّوشْ الفِصْحْ سِأْلُوا التْلَامْذَة يَسُوعْ: «وِينْ تْحِبْنَا نِمْشِيوْ ونْحَضْرُولِكْ عْشَاء الفِصْحْ بَاشْ تَاكْلُو؟». <verse eid="MRK 14:12" /><verse number="13" style="v" sid="MRK 14:13" />وبْعَثْ زُوزْ مِنْ تْلَامِذْتُو وقَالِلْهُمْ: «إِمْشِيوْ لِلْمْدِينَة وتَوْ تَلْقَاوْ رَاجِلْ هَازْ قُلَّة مَاء تَبْعُوهْ. <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />والدَّارْ الِّي يُدْخْلِلْهَا قُولُوا لْمُولَاهَا: "المُعَلِّمْ يْقُولْ: وِينِي البِيتْ الِّي بِشْ نَاكِلْ فِيهَا عْشَاء الفِصْحْ مْعَ تْلَامِذْتِي؟". <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />وهُوَّ بَاشْ يْوَرِّيكُمْ بِيتْ كْبِيرَة فِي الطَّاقْ الفُوقَانِي، مَفْرُوشَة وحَاضْرَة، حَضّْرُولْنَا العْشَاء غَادِي!». <verse eid="MRK 14:15" /><verse number="16" style="v" sid="MRK 14:16" />مْشَاوْ التْلَامْذَة ودَخْلُوا لِلْمْدِينَة، ولْقَاوْ كُلْ شَيْ كِيفْ مَا قَالِلْهُمْ عْلِيهْ. وغَادِي حَضّْرُوا عْشَاء الفِصْحْ.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />وفِي العْشِيَّة جَاء يَسُوعْ هُوَّ والتْلَامْذَة الأَثْنَاشْ. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />وَقْتِلِّي كَانُوا قَاعْدِينْ يَاكْلُوا، قَالْ يَسُوعْ: «نْقُلْكُمْ الحَقْ: وَاحِدْ مِنْكُمْ بِشْ يْخُونِّي وهُوَّ تَوَّا قَاعِدْ يَاكِلْ مْعَايَا». <verse eid="MRK 14:18" /><verse number="19" style="v" sid="MRK 14:19" />حِزْنُوا التْلَامْذَة، وبْدَاوْ يِسْأْلُوا فِيهْ بِالوَاحِدْ: «يَاخِي آنَا الِّي بِشْ نْخُونِكْ؟». <verse eid="MRK 14:19" /><verse number="20" style="v" sid="MRK 14:20" />وقَالِلْهُمْ: «هُوَّ وَاحِدْ مِالأَثْنَاشْ وهُوَّ الِّي قَاعِدْ يَاكِلْ مْعَايَا تَوَّا مِنْ نَفْسْ الصْحَنْ. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />إِبْنْ الإِنْسَانْ لَازْمُو يْمُوتْ كِيمَا مَكْتُوبْ عْلِيهْ فِي الكْتُبْ المُقَدْسَة، آمَا يَا وِيلُو الرَّاجِلْ الِّي بِشْ يْسَلْمُو. خِيرْلُو لَوْ كَانْ مَا تُولِدْشْ!».<verse eid="MRK 14:21" /></para>
  <para style="s">عَشَاء الرَّبْ</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />ووَقْتِلِّي كَانُوا يَاكْلُوا خْذَا يَسُوعْ خُبْزَة وشْكَرْ اللَّهْ، وقْسِمْ وعْطَى لِتْلَامِذْتُو وقَالْ: «خُوذُوا، هَاذَا هُوَّ بَدْنِي». <verse eid="MRK 14:22" /><verse number="23" style="v" sid="MRK 14:23" />ومْبَعِّدْ خْذَا كَاسْ وشْكَرْ اللَّهْ، وعْطَاهُمْ شَرْبُوا مِنُّو الكُلْ. <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />وقَالِلْهُمْ: «هَاذَا هُوَّ دَمِّي الِّي يَعْمِلْ بِيهْ اللَّهْ عَهْدْ جْدِيدْ، ولِّي بِشْ يْسِيلْ عْلَى خَاطِرْ بَرْشَة نَاسْ. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />نْقُلْكُمْ الحَقْ: مَا عَادِشْ بِشْ نُشْرُبْ مِنْ عَصِيرْ العْنِبْ، حَتَّى لِلنْهَارْ الِّي نُشْرُبْ فِيهْ عَصِيرْ جْدِيدْ فِي مَمْلَكْةْ اللَّهْ».<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />ومْبَعِّدْ سَبْحُوا اللَّهْ بِالتَّرْنِيمْ، ومْشَاوْ لِجْبَلْ الزِّيتُونْ.<verse eid="MRK 14:26" /></para>
  <para style="s">أَتْبَاعُو بِشْ يْخَلِّيوِهْ</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />قَالِلْهُمْ يَسُوعْ: «الكُلْكُمْ بِشْ تْخَلِّيوْنِي، خَاطِرْ مَكْتُوبْ:</para>
  <para style="b" vid="MRK 14:27" />
  <para style="q1" vid="MRK 14:27">"نَضْرِبْ السَّارِحْ،</para>
  <para style="q2" vid="MRK 14:27">تِتْفَرِّقْ الغْنَمْ".<verse eid="MRK 14:27" /></para>
  <para style="b" />
  <para style="m">
    <verse number="28" style="v" sid="MRK 14:28" />«آمَا بَعْدْمَا نْقُومْ مِالمُوتْ، بِشْ نِسْبَقْكُمْ لِلْجَلِيلْ». <verse eid="MRK 14:28" /><verse number="29" style="v" sid="MRK 14:29" />يَاخِي قَالُّو بُطْرُسْ: «حَتَّى لَوْ كَانْ مْشَاوْ عْلِيكْ الكُلْ، آنَا عُمْرِي مَا نْخَلِّيكْ». <verse eid="MRK 14:29" /><verse number="30" style="v" sid="MRK 14:30" />قَالُّو يَسُوعْ: «نْقُلِّكْ الحَقْ: اليُومْ، فِي اللِّيلَة هَاذِي، قْبَلْ مَا يْصِيحْ السَّرْدُوكْ مَرْتِينْ تُنْكُرْنِي ثْلَاثَة مَرَّاتْ». <verse eid="MRK 14:30" /><verse number="31" style="v" sid="MRK 14:31" />آمَا بُطْرُسْ شَدْ صْحِيحْ وقَالْ: «مَانِيشْ بِشْ نُنْكْرِكْ بِالكُلْ، حَتَّى كَانْ لْزِمْ نْمُوتْ مْعَاكْ!». والتْلَامْذَة الكُلْ قَالُوا نَفْسْ الكْلَامْ.<verse eid="MRK 14:31" /></para>
  <para style="s">فِي جَثْسَيْمَانِي</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />ومْشَاوْ لِبْلَاصَة إِسْمْهَا جَثْسَيْمَانِي، وقَالْ يَسُوعْ لِتْلَامِذْتُو: «أُقْعْدُوا هُونِي مَادَامْ آنَا صَلِّيتْ». <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />وهَزْ مْعَاهْ بُطْرُسْ ويَعْقُوبْ ويُوحَنَّا، وبْدَا يْحِسْ بِالرَّهْبَة والحُزْنْ. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />وقَالِلْهُمْ: «رُوحِي حْزِينَة بَرْشَة، لْدَرْجِةْ المُوتْ. أُقْعْدُوا هُونِي وأَسْهْرُوا». <verse eid="MRK 14:34" /><verse number="35" style="v" sid="MRK 14:35" />وبْعِدْ عْلِيهُمْ شْوَيَّة، وهْبَطْ عَالأَرْضْ وبْدَا يْصَلِّي بَاشْ مَا يِتْعَدَّاشْ بِالسَّاعَة هَاذِيكَا، إِذَا كَانْ مُمْكِنْ. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />وقَالْ: «بَابَا! يَا بَابَا! إِنْتِ قَادِرْ عْلَى كُلْ شَيْ، بَعِّدْ عْلِيَّا هَا الكَاسْ. آمَا خَلِّي يْصِيرْ الِّي تْحِبْ عْلِيهْ إِنْتِ، مُشْ الِّي نْحِبْ عْلِيهْ آنَا!». <verse eid="MRK 14:36" /><verse number="37" style="v" sid="MRK 14:37" />وكِي رْجَعْ لْقَاهُمْ رَاقْدِينْ، وقَالْ لْبُطْرُسْ: «يَا سِمْعَانْ! رَاقِدْ؟ مَا نَجَّمْتِشْ تَسْهِرْ حَتَّى سَاعَة وَحْدَة؟ <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />أَسْهْرُوا وصَلِّيوْ بَاشْ مَا تُدْخْلُوشْ فِي تَجْرْبَة. رَاهِي الرُّوحْ نَاشْطَة، آمَا البْدَنْ ضْعِيفْ». <verse eid="MRK 14:38" /><verse number="39" style="v" sid="MRK 14:39" />ومْشَى صَلَّى مَرَّة أُخْرَى، وقَالْ نَفْسْ الكْلَامْ . <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />ورْجَعْ مَرَّة أُخْرَى ولْقَاهُمْ رَاقْدِينْ عْلَى خَاطِرْ النُّومْ غْلِبْهُمْ، يَاخِي مَا عَرْفُوشْ آشْ يْجَاوْبُوهْ. <verse eid="MRK 14:40" /><verse number="41" style="v" sid="MRK 14:41" />وجَاء المَرَّة الثَّالْثَة وقَالِلْهُمْ: «مَزِّلْتُوا رَاقْدِينْ ومِرْتَاحِينْ؟ يِزِّي! جَاتْ السَّاعَة. تَوَّا إِبْنْ الإِنْسَانْ بِشْ يْسَلْمُوهْ لِيْدِينْ المُذْنْبِينْ. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />قُومُوا، هَيَّا نِمْشِيوْ! هَاوْ الِّي بِشْ يْخُونِّي جَاء!».<verse eid="MRK 14:42" /></para>
  <para style="s">يَسُوعْ تْشَدْ</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />وبِالوَقْتْ، وهُوَّ مَزَّالْ يِتْكَلِّمْ، وْصُلْ يَهُوذَا الِّي هُوَّ وَاحِدْ مِالأَثْنَاشْ، ومْعَاهْ بَرْشَة نَاسْ هَازِّينْ سْيُوفَا وعْصِيْ، بَعْثُوهُمْ كْبَارْ الكَهَنَة وعُلَمَاءْ الشَّرِيعَة والشْيُوخْ. <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />ولِّي بِشْ يْسَلْمُو عْطَاهُمْ أَمَارَة وقَالْ: «الِّي بِشْ نْبُوسُو هَاذَاكَا هُوَّ. شِدُّوهْ وهِزُّوهْ وعِسُّوا عْلِيهْ بِالڨْدَا». <verse eid="MRK 14:44" /><verse number="45" style="v" sid="MRK 14:45" />ودُوبْ مَا وْصُلْ يَهُوذَا، مْشَالُو وقَالُّو: «يَا مُعَلِّمْ!» وبَاسُو. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />يَاخِي شَدُّوهْ. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />آمَا وَاحِدْ مِالوَاقْفِينْ غَادِي، جْبِدْ سِيفُو وضْرَبْ خْدِيمْ كْبِيرْ الكَهَنَة قَصْلُو وِذْنُو. <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />قَالِلْهُمْ يَسُوعْ: «يَاخِي آنَا سَارِقْ خَارْجِينْلِي بِالسْيُوفَا والعْصِي بَاشْ تْشِدُّونِي؟ <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />كُنْتْ كُلْ يُومْ نْعَلِّمْ بِينَاتْكُمْ فِي الهَيْكِلْ، ومَا شَدِّيتُونِيشْ. آمَا تَوَّا لَازِمْ يِتْحَقَّقْ الكْلَامْ الِّي تِكْتِبْ فِي الكْتُبْ المُقَدْسَة». <verse eid="MRK 14:49" /><verse number="50" style="v" sid="MRK 14:50" />وَقْتْهَا خَلَّاوَهْ الكُلْ وهَرْبُوا. <verse eid="MRK 14:50" /><verse number="51" style="v" sid="MRK 14:51" />وتَبْعُو طْفُلْ مَا لَابِسْ كَانْ فُوطَة. شَدُّوهْ هُوَّ زَادَا. <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />يَاخِي خَلَّا الفُوطَة وهْرَبْ عِرْيَانْ.<verse eid="MRK 14:52" /></para>
  <para style="s">يَسُوعْ قُدَّامْ مَجْلِسْ اليْهُودْ</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />وهَزُّوا يَسُوعْ لِكْبِيرْ الكَهَنَة. وتْلَمُّوا بِيهْ كْبَارْ الكَهَنَة الكُلْهُمْ والشْيُوخْ وعُلَمَاءْ الشَّرِيعَة. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />تَبْعُو بُطْرُسْ حَتَّى لِينْ دْخَلْ لدَارْ كْبِيرْ الكَهَنَة، ودْخَلْ وقْعَدْ مْعَ الحُرَّاسْ يِدَّفَّى عَالنَّارْ.<verse eid="MRK 14:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55" />وكَانُوا كْبَارْ الكَهَنَة ولِّي فِي المَجْلِسْ الأَعْلَى الكُلْ يْلَوْجُوا عْلَى شْكُونْ يِشْهِدْ ضِدْ يَسُوعْ بَاشْ يْنَجْمُوا يُقْتْلُوهْ، يَاخِي مَا لْقَاوِشْ. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />عْلَى خَاطِرْ بَرْشَة نَاسْ شِهْدُوا ضِدُّو بِالبَاطِلْ، آمَا شْهَادِتْهُمْ كَانِتْ عَكْسْ بْعَضْهَا. <verse eid="MRK 14:56" /><verse number="57" style="v" sid="MRK 14:57" />فِي الإِخِّرْ، قَامُوا جْمَاعَة وشِهْدُوا ضِدُّو بِالكِذْبْ وقَالُوا: <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />«سْمَعْنَاهْ يْقُولْ: "بِشْ نْهِدْ الهَيْكِلْ هَاذَا الِّي بْنَاوِهْ النَّاسْ، وبَعْدْ ثْلَاثَة أَيَّامْ بِشْ نِبْنِي هَيْكِلْ آخِرْ مَا صَنْعُوشْ الإِنْسَانْ"». <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />آمَا حَتَّى هَاذَا زَادَا تْخَالْفُوا فِيهْ. <verse eid="MRK 14:59" /><verse number="60" style="v" sid="MRK 14:60" />ووْقِفْ كْبِيرْ الكَهَنَة فِي وِسْطْ المَجْلِسْ وسْإِلْ يَسُوعْ: «يَاخِي مَا عَنْدِكْ مَا تْجَاوِبْ عَالنَّاسْ الِّي شِهْدُوا ضِدِّكْ؟». <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />آمَا هُوَّ بْقَى سَاكِتْ ومَا جَاوِبْ بْحَتَّى شَيْ. وعَاوِدْ كْبِيرْ الكَهَنَة سِأْلُو: «يَاخِي إِنْتِ المَسِيحْ، إِبْنْ اللَّهْ المُبَارَكْ؟». <verse eid="MRK 14:61" /><verse number="62" style="v" sid="MRK 14:62" />قَالْ يَسُوعْ: «آنَا هُوَّ. وبِشْ تْشُوفُوا إِبْنْ الإِنْسَانْ قَاعِدْ عْلَى يْمِينْ اللَّهْ وجَايْ عْلَى سْحَابْ السْمَاء!». <verse eid="MRK 14:62" /><verse number="63" style="v" sid="MRK 14:63" />يَاخِي كْبِيرْ الكَهَنَة قَطَّعْ حْوَايْجُو وقَالْ: «آشْ مَزِّلْنَا نَحْتَاجُوا لِشْهُودْ؟ <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />هَاكُمْ سْمَعْتُوهْ يَكْفِرْ: شْنُوَّة رَايْكُمْ؟». يَاخِي الكُلْهُمْ حُكْمُوا الِّي هُوَّ يِسْتَاهِلْ المُوتْ. <verse eid="MRK 14:64" /><verse number="65" style="v" sid="MRK 14:65" />وبْدَاوْ جْمَاعَة مِنْهُمْ يِبْزْقُوا عْلِيهْ، ويغَطِّيوْلُو وِجْهُو ويَضْرْبُوهْ ويْقُولُولُو: «تْنَبَّأْ!». وبْدَاوْ حُرَّاسْ الهَيْكِلْ يَضْرْبُوا فِيهْ بِالكَفْ.<verse eid="MRK 14:65" /></para>
  <para style="s">بُطْرُسْ يُنْكِرْ يَسُوعْ</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />ووَقْتِلِّي بُطْرُسْ كَانْ اللُّوطَا فِي وِسْطْ الدَّارْ، جَاتْ خْدِيمَة تَابْعَة كْبِيرْ الكَهَنَة، <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />وكِي شَافِتْ بُطْرُسْ يِدَّفَّى ثَبْتِتْ فِيهْ وقَالِتْ: «إِنْتِ زَادَا كُنْتْ مْعَ يَسُوعْ النَّاصْرِي!». <verse eid="MRK 14:67" /><verse number="68" style="v" sid="MRK 14:68" />آمَا هُوَّ نْكَرْ وقَالْ: «مُشْ عَارِفْ ومُشْ فَاهِمْ آشْ قَاعْدَة تْقُولْ!». وخْرَجْ وقْعَدْ بَحْذَا البَابْ، ووَقْتْهَا صَاحْ السَّرْدُوكْ. <verse eid="MRK 14:68" /><verse number="69" style="v" sid="MRK 14:69" />آمَا وَقْتِلِّي شَافِتُّو الخْدِيمَة مَرَّة أُخْرَى، بْدَاتْ تْقُولْ لِلنَّاسْ الوَاقْفِينْ غَادِي: «هَاذَا وَاحِدْ مِنْهُمْ!». <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />يَاخِي زَادْ نْكَرْ مَرَّة أُخْرَى. وبَعْدْ شْوَيَّة، قَالُوا الوَاقْفِينْ غَادِي لْبُطْرُسْ: «بِالحَقْ إِنْتِ وَاحِدْ مِنْهُمْ عْلَى خَاطْرِكْ مِنْ مَنْطَقْةْ الجَلِيلْ». <verse eid="MRK 14:70" /><verse number="71" style="v" sid="MRK 14:71" />آمَا هُوَّ بْدَا يَلْعِنْ ويَحْلِفْ: «رَانِي مَا نَعْرْفُوشْ الرَّاجِلْ هَاذَا الِّي تَحْكِيوْ عْلِيهْ». <verse eid="MRK 14:71" /><verse number="72" style="v" sid="MRK 14:72" />وبِالوَقْتْ صَاحْ السَّرْدُوكْ ثَانِي مَرَّة وتْذَكِّرْ بُطْرُسْ آشْ قَلُّو يَسُوعْ: «قْبَلْ مَا يْصِيحْ السَّرْدُوكْ مَرْتِينْ تْكُونْ إِنْتِ نْكَرْتْنِي ثْلَاثَة مَرَّاتْ». يَاخِي اطَّرْشَقْ بِالبْكَاء.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">بِيلَاطُسْ حْكُمْ بْصَلْبْ يَسُوعْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />وفِي الصْبَاحْ بِكْرِي تْشَاوْرُوا كْبَارْ الكَهَنَة مْعَ الشْيُوخْ وعُلَمَاءْ الشَّرِيعَة والمَجْلِسْ الأَعْلَى. ومْبَعِّدْ كَتْفُوا يَسُوعْ، وهَزُّوهْ، وسَلْمُوهْ لْبِيلَاطُسْ. <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />وسِأْلُو بِيلَاطُسْ: «يَاخِي إِنْتِ مَلِكْ اليْهُودْ؟». جَاوْبُو يَسُوعْ: «إِنْتِ بِيدِكْ قُلْتْ». <verse eid="MRK 15:2" /><verse number="3" style="v" sid="MRK 15:3" />وبْدَاوْ كْبَارْ الكَهَنَة يِتْهْمُوا فِيهْ بْبَرْشَة تُهَمْ. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />يَاخِي سِأْلُو بِيلَاطُسْ مَرَّة أُخْرَى: «مَاكِشْ بِشْ تْقُولْ حَتَّى شَيْ؟ شُوفْ قَدَّاشْ مِنْ تُهْمَة قَالُوهَا ضِدِّكْ». <verse eid="MRK 15:4" /><verse number="5" style="v" sid="MRK 15:5" />آمَا يَسُوعْ مَا جَاوِبْ بْحَتَّى شَيْ بِالعْمَلْ بِيلَاطُسْ إِسْتَغْرِبْ.<verse eid="MRK 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />وكَانْ بِيلَاطُسْ مِسْتَانِسْ فِي كُلْ عِيدْ يْسَيْبِلْهُمْ وَاحِدْ مِالمْرَابِيطْ الِّي يَخْتَارُوهْ. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />وكَانْ وَاحِدْ إِسْمُو بَارَابَاسْ مَرْبُوطْ هُوَّ وأَصْحَابُو الِّي شَارْكُوا مْعَاهْ فِي ثَوْرَة، وقَتْلُوا نَاسْ وَقْتِلِّي كَانِتْ فَمَّة خُوضَة فِي البْلَادْ. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />تْلَمُّوا النَّاسْ وطَلْبُوا مِنْ بِيلَاطُسْ بَاشْ يْسَيْبِلْهُمْ وَاحِدْ كِيمَا عَادْتُو. <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />يَاخِي جَاوِبْهُمْ بِيلَاطُسْ: «تْحِبُّوا نْسَيْبِلْكُمْ مَلِكْ اليْهُودْ؟». <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />خَاطْرُو كَانْ يَعْرِفْ الِّي كْبَارْ الكَهَنَة سَلْمُوا يَسُوعْ بِسْبَبْ الغِيرَة. <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />آمَا كْبَارْ الكَهَنَة هَيْجُوا الشَّعْبْ بَاشْ يْصِيحُوا ويُطْلْبُوا مِنُّو يْسَيْبِلْهُمْ بَارَابَاسْ. <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />قَالِلْهُمْ بِيلَاطُسْ مَرَّة أُخْرَى: «مَالَا آشْ تْحِبُّونِي نَعْمِلْ لِلِّي تْسَمِّيوْ فِيهْ مَلِكْ اليْهُودْ؟». <verse eid="MRK 15:12" /><verse number="13" style="v" sid="MRK 15:13" />بْدَاوْ يْصِيحُوا ويْعَاوْدُوا: «أُصْلْبُو!». <verse eid="MRK 15:13" /><verse number="14" style="v" sid="MRK 15:14" />وسْإِلْهُمْ بِيلَاطُسْ: «شْنُوَّة الشَّرْ الِّي عَمْلُو؟» آمَا هُومَا وَلَّاوْ يْصِيحُوا أَكْثِرْ: «أُصْلْبُو!». <verse eid="MRK 15:14" /><verse number="15" style="v" sid="MRK 15:15" />وحَبْ بِيلَاطُسْ يْرَضِّي الشَّعْبْ، يَاخِي سَيْبِلْهُمْ بَارَابَاسْ. وبَعْدْمَا أْمَرْ بْجَلْدْ يَسُوعْ، سَلْمُو بَاشْ يِتْصْلَبْ.<verse eid="MRK 15:15" /></para>
  <para style="s">العَسْكِرْ يِتْمَسْخْرُوا عَالمَسِيحْ</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />وهَزُّوهْ الجُنُودْ لْوِسْطْ دَارْ الوِلَايَة، ولَمُّوا فِرْقِةْ العَسْكِرْ الكُلْ. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />ولَبْسُوهْ لِبْسَة لُونْهَا بَنَفْسَجِي، وضَفْرُولُو تَاجْ مِالشُّوكْ وحَطُّوهْ فُوقْ رَاسُو. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />وبْدَاوْ يْحَيِّيوْ فِيهْ ويْقُولُوا: «سَلَامْ يَا مَلِكْ اليْهُودْ!» <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />ويَضْرْبُوا فِيهْ عْلَى رَاسُو بْقَصْبَة، ويِبْزْقُوا عْلِيهْ، ويَهْبْطُوا عْلَى رْكَايِبْهُمْ ويُسْجْدُولُو. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />وبَعْدْمَا تْمَسْخْرُوا عْلِيهْ، نَحَّاوْلُو اللِّبْسَة البَنَفْسَجِيَّة ولَبْسُوهْ حْوَايْجُو، وهَزُّوهْ لْبَرَّة بَاشْ يُصْلْبُوهْ.<verse eid="MRK 15:20" /></para>
  <para style="s">الصَّلِيبْ</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />وكَانْ سِمْعَانْ القِيرِينِي، بُو إِسْكَنْدِرْ ورُوفُسْ، رَاجَعْ مِالسَّانْيَة، يَاخِي لَزْمُوا عْلِيهْ يْهِزْ صَلِيبْ يَسُوعْ. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />ومْشَاوْ بِيهْ لِبْلَاصَة تِتْسَمَّى الجُلْجْثَة، ولِّي مَعْنَاهَا بُقْعِةْ الجُمْجْمَة. <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />وعْطَاوَهْ شْرَابْ مْخَلِّطْ بِالمُرْ، يَاخِي مَا حَبِّشْ يُشْرْبُو. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />وبَعْدْمَا صَلْبُوهْ، قَسْمُوا حْوَايْجُو بِينَاتْهُمْ بِالقُرْعَة. <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />وَقْتِلِّي صَلْبُوهْ كَانِتْ وَقْتْهَا التِّسْعَة مْتَاعْ الصْبَاحْ. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />وكِتْبُوا التُّهْمَة مْتَاعُو عْلَى بْلَاكَة ولِّي هِيَّ: «مَلِكْ اليْهُودْ».<verse eid="MRK 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 15:27" />وصَلْبُوا زَادَا زُوزْ سُرَّاقْ، وَاحِدْ عْلَى يْمِينُو ووَاحِدْ عْلَى يْسَارُو. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />وهَكَّا تَمْ الكْلَامْ المَكْتُوبْ فِي الكْتُبْ المُقَدْسَة: «وحِسْبُوهْ مْعَ المُجْرْمِينْ». <verse eid="MRK 15:28" /><verse number="29" style="v" sid="MRK 15:29" />وكَانُوا المَاشِينْ يْسِبُّوا والجَّايِينْ يْسِبُّوا، وهُومَا يْدَوْحُوا فِي رْيُوسْهُمْ ويْقُولُوا: «هَهْ! يَلِّي بِشْ اطَّيَّحْ الهَيْكِلْ وتِبْنِيهْ فِي ثْلَاثَة أَيَّامْ، <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />نَجِّي رُوحِكْ وأَهْبِطْ مِنْ فُوقْ الصَّلِيبْ!». <verse eid="MRK 15:30" /><verse number="31" style="v" sid="MRK 15:31" />وكَانُوا زَادَا كْبَارْ الكَهَنَة وعُلَمَاءْ الشَّرِيعَة يِتْمَسْخْرُوا عْلِيهْ ويْقُولُوا لِبْعَضْهُمْ: «نَجَّى غِيرُو، آمَا مَا انَّجَّمْشْ يْنَجِّي رُوحُو! <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />تْرَاهْ خَلِّي المَسِيحْ مَلِكْ إِسْرَائِيلْ يَهْبِطْ مِنْ فُوقْ الصَّلِيبْ، تَوَّا نَمْنُوا بِيهْ». وبْدَاوْ السُّرَاقْ الزُّوزْ زَادَا يْسِبُّوا فِيهْ.<verse eid="MRK 15:32" /></para>
  <para style="s">مُوتْ المَسِيحْ</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />وظْلَامِتْ الدِّنْيَا الكُلْ مِنْ نُصْفْ النْهَارْ، حَتَّى لِلمَاضِي ثْلَاثَة مْتَاعْ العْشِيَّة. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />وفِي مَاضِي ثْلَاثَة صَاحْ يَسُوعْ بْصُوتْ عَالِي: «أَلُّوِي! أَلُّوِي! لِمَا شَبَقْتَنِي؟» ومَعْنِتْهَا «يَا إِلَاهِي! يَا إِلَاهِي! عْلَاشْ خَلِّيتْنِي؟». <verse eid="MRK 15:34" /><verse number="35" style="v" sid="MRK 15:35" />وَقْتِلِي سَمْعُوهْ جْمَاعَة مِالوَاقْفِينْ غَادِي قَالُوا: « هَاوْ يْعَيِّطْ لِلنَّبِيْ إِيلِيَّا!». <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />وبِالوَقْتْ جْرَى وَاحِدْ مِنْهُمْ، خْذَا شِيفُونَة، نَفَّخْهَا فِي الخَلْ، حَطْهَا عْلَى قَصْبَة ومَدْهَالُو بَاشْ يُشْرُبْ، وقَالْ: « إِسْتَنَّاوْ، خَلِّينَا نْشُوفُوا إِذَا كَانْ إِيلِيَّا بِشْ يْجِي ويْهَبْطُو!». <verse eid="MRK 15:36" /><verse number="37" style="v" sid="MRK 15:37" />وصَاحْ يَسُوعْ صِيحَة قْوِيَّة وسَلِّمْ الرُّوحْ. <verse eid="MRK 15:37" /><verse number="38" style="v" sid="MRK 15:38" />وتْشَرِّڨْ حْجَابْ الهَيْكِلْ عْلَى ثْنِينْ، مِالفُوقْ اللُّوطَا. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />وَقْتِلِّي الضَّابِطْ الِّي وَاقِفْ مْقَابْلُو شَافُو كِيفَاشْ صَاحْ وسَلِّمْ الرُّوحْ، قَالْ: «بِالحَقْ الإِنْسَانْ هَاذَا كَانْ إِبْنْ اللَّهْ!».<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />وكَانُوا فَمَّة نْسَاء يِتْفَرْجُوا مِنْ بْعِيدْ فِلِّي قَاعِدْ يْصِيرْ ومِنْهُمْ مَرْيِمْ المَجْدَلِيَّة ومَرْيِمْ أُمْ يَعْقُوبْ الصْغِيرْ ويُوسِي، وسَالُومَة. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />هُومَا الِّي تَبْعُوا يَسُوعْ، وكَانُوا يِخْدْمُوا فِيهْ وَقْتِلِّي كَانْ فِي الجَلِيلْ، وبَرْشَة أُخْرِينْ غِيرْهُمْ طَلْعُوا مْعَاهْ لْأُورْشَلِيمْ.<verse eid="MRK 15:41" /></para>
  <para style="s">دْفِينِةْ المَسِيحْ</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />وكِي قْرُبْ اللِّيلْ، وكَانْ نْهَارْهَا نْهَارْ التَّحْضِيرْ، الِّي قْبَلْ السِّبْتْ، <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />جَاء يُوسِفْ الِّي مِنْ مَنْطَقْةْ الرَّامَة، وهُوَّ كَانْ عُضُوْ مُحْتْرَمْ فِي المَجْلِسْ الأَعْلَى، وكَانْ زَادَا يِسْتَنَّى فِي مَمْلَكْةْ اللَّهْ، تْشَجَّعْ ودْخَلْ لْبِيلَاطُسْ وطْلَبْ مِنُّو جُثِّةْ يَسُوعْ. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />إِسْتَغْرِبْ بِيلَاطُسْ كِيفَاشْ يَسُوعْ مَاتْ فِيسَعْ. عَيِّطْ لِلضَّابِطْ وسِأْلُو: «يَاخِي عَنْدُو بَرْشَة مِلِّي مَاتْ؟». <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />وكِي الضَابِطْ أَكَّدْلُو الخْبَرْ، عْطَى الجُثَّة لْيُوسِفْ. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />شْرَى يُوسِفْ كْفَنْ ولَفْ بِيهْ الجُثَّة، ودِفْنُو فِي قْبَرْ مَحْفُورْ فِي الحْجَرْ وحَطْ حَجْرَة عْلَى بَابْ القْبَرْ. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />ومَرْيِمْ المَجْدَلِيَّة ومَرْيِمْ أُمْ يُوسِي شَافُوا البُقْعَة الِّي دِفْنُو فِيهَا.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">المَسِيحْ قَامْ مِالمُوتْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />وبَعْدْمَا تْعَدَّى السِّبْتْ، شْرَاتْ مَرْيِمْ المَجْدَلِيَّة ومَرْيِمْ أُمْ يَعْقُوبْ وسَالُومَة عْطُورَاتْ بَاشْ يِدْهْنُوا بِيهَا جُثِّةْ يَسُوعْ. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />ونْهَارْ الأَحَدْ، مْشَاوْ لِلْقْبَرْ فِي الصْبَاحْ بِكْرِي، قْبَلْ طْلُوعْ الشَّمْسْ. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />وكَانُوا يْقُولُوا لِبْعَضْهُمْ: «شْكُونْ بِشْ يْبَعْدِلْنَا الحَجْرَة مِنْ بَابْ القْبَرْ؟». <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />ووَقْتِلِّي خَزْرُوا، لْقَاوْ الِّي الحَجْرَة تْنَحَّاتْ مِالبَابْ رَغْمِلِّي كَانِتْ كْبِيرَة بَرْشَة. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />وكِي دَخْلُوا فِي وِسْطْ القْبَرْ شَافُوا فِي الجِّيهَة اليْمِينْ وَاحِدْ قَاعِدْ ولَابِسْ بِالأَبْيِضْ، يَاخِي خَافُوا. <verse eid="MRK 16:5" /><verse number="6" style="v" sid="MRK 16:6" />قَالِلْهُمْ: «مَا تْخَافُوشْ. إِنْتُومَا تْلَوْجُوا عْلَى يَسُوعْ النَّاصْرِي الِّي تِصْلَبْ. رَاهُو قَامْ، هُوَّ مُشْ هُونِي. هَايْ البُقْعَة الِّي حَطُّوهْ فِيهَا. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />بَرَّاوْ قُولُوا لِتْلَامِذْتُو ولْبُطْرُسْ رَاهُو بِشْ يِسْبِقْكُمْ لِلْجَلِيلْ، وغَادِي بِشْ تْشُوفُوهْ كِيمَا قَالِلْكُمْ». <verse eid="MRK 16:7" /><verse number="8" style="v" sid="MRK 16:8" />يَاخِي خَلَّاوْ القْبَرْ وهَرْبُوا وهُومَا مَرْعُوبِينْ، ومَا قَالُوا حَتَّى شَيْ لْحَتَّى وَاحِدْ مِنْ كُثْرِةْ الخُوفْ.<verse eid="MRK 16:8" /></para>
  <para style="s">ظْهُرْ لِتْلَامِذْتُو</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />وبَعْدْمَا قَامْ يَسُوعْ مِالمُوتْ نْهَارْ الأَحَدْ الصْبَاحْ، أَوِّلْ مَا ظْهُرْ، ظْهُرْ لْمَرْيِمْ المَجْدَلِيَّة الِّي خَرِّجْ مِنْهَا سَبْعَة أَرْوَاحْ شِرِّيرَة. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />يَاخِي مْشَاتْ وبَشْرِتْ أَتْبَاعُو، الِّي كَانُوا يْنَوْحُوا ويِبْكِيوْ. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />وكِي سَمْعُوا الِّي هُوَّ حَيْ ولِّي هِيَّ شَافِتُّو، مَا صَدْقُوشْ.<verse eid="MRK 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />وبَعْدْهَا ظْهُرْ فِي هَيْئَة أُخْرَى لْزُوزْ مِنْ تْلَامِذْتُو وهُومَا مَاشِينْ لِلرِّيفْ. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />يَاخِي مْشَاوْ وبَشْرُوا البَقِيَّة، آمَا حَتَّى هُومَا مَا صَدْقُوهُمْشْ.<verse eid="MRK 16:13" /></para>
  <para style="s">إِمْشِيوْ لِلْعَالِمْ أَجْمَعْ</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />ومْبَعِّدْ ظْهُرْ لِلحْدَاشِنْ تِلْمِيذْ، وَقْتِلِّي كَانُوا يَاكْلُوا، ولَامْهُمْ عْلَى قِلِّةْ إِيمَانْهُمْ وكْسُوحِيِّةْ قْلُوبْهُمْ، كِي مَا صَدْقُوشْ النَّاسْ الِّي شَافُوهْ بَعْدْمَا قَامْ مِالمُوتْ. <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />وقَالِلْهُمْ: «إِمْشِيوْ لِلْعَالِمْ أَجْمَعْ، ووَصّْلُوا البْشَارَة لِلنَّاسْ الكُلْ: <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />الِّي يَمِّنْ ويِتْعَمِّدْ يِنْجَى، ولِّي مَا يَمِّنْشْ يِتَّحْكَمْ عْلِيهْ. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />ولِّي يَمْنُوا بِشْ تْكُونْ عَنْدْهُمْ المُعْجْزَاتْ هَاذِي: يْخَرْجُوا الشْوَاطِنْ بْإِسْمِي ويِتْكَلْمُوا بْلُوغَاتْ جْدِيدَة، <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />ويْشِدُّوا حَتَّى اللْفَعْ بِيدِيهُمْ. وإِذَا شَرْبُوا حَاجَة سَامَّة مَا تْضُرْهُمْشْ، ويْحُطُّوا يْدِيهُمْ عَالمُرْضَى يَبْرَاوْ».<verse eid="MRK 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />وبَعْدْمَا الرَّبْ تْكَلِّمْ مْعَاهُمْ، تِرْفَعّْ لِلسْمَاء، وقْعَدْ عْلَى يْمِينْ اللَّهْ. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />وخَرْجُوا التْلَامْذَة يْبَشْرُوا فِي كُلْ بْلَاصَة، وكَانْ الرَّبْ يْعَاوِنْ فِيهُمْ ويْأَكِّدْ فِي كْلَامْهُمْ بِالمُعْجْزَاتْ.<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>