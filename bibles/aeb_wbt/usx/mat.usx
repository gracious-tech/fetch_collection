<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id" />
  <para style="h">مَتَّى</para>
  <para style="toc1">بْشَارِةْ مَتَّى</para>
  <para style="toc2">مَتَّى</para>
  <para style="toc3">مَتَّى</para>
  <para style="mt">بْشَارِةْ مَتَّى</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">نْسَبْ يَسُوعْ المَسِيحْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />هَاذَا نْسَبْ يَسُوعْ المَسِيحْ وِلْدْ دَاوِدْ وِلْدْ إِبْرَاهِيمْ:<verse eid="MAT 1:1" /></para>
  <para style="b" />
  <para style="li">
    <verse number="2" style="v" sid="MAT 1:2" />إِبْرَاهِيمْ جَابْ إِسْحَاقْ.</para>
  <para style="li" vid="MAT 1:2">وإِسْحَاقْ جَابْ يَعْقُوبْ.</para>
  <para style="li" vid="MAT 1:2">ويَعْقُوبْ جَابْ يَهُوذَا وخْوَاتُو.<verse eid="MAT 1:2" /></para>
  <para style="li">
    <verse number="3" style="v" sid="MAT 1:3" />ويَهُوذَا جَابْ فَارِصْ وزَارَحْ مِنْ ثَامَارْ.</para>
  <para style="li" vid="MAT 1:3">وفَارِصْ جَابْ حَصْرُونْ.</para>
  <para style="li" vid="MAT 1:3">وحَصْرُونْ جَابْ أَرَامْ.<verse eid="MAT 1:3" /></para>
  <para style="li">
    <verse number="4" style="v" sid="MAT 1:4" />وأَرَامْ جَابْ عَمِّينَادَابْ.</para>
  <para style="li" vid="MAT 1:4">وعَمِّينَادَابْ جَابْ نَحْشُونْ.</para>
  <para style="li" vid="MAT 1:4">ونَحْشُونْ جَابْ سَلْمُونْ.<verse eid="MAT 1:4" /></para>
  <para style="li">
    <verse number="5" style="v" sid="MAT 1:5" />وسَلْمُونْ جَابْ بُوعَزْ مِنْ رَاحَابْ.</para>
  <para style="li" vid="MAT 1:5">وبُوعَزْ جَابْ عُوبِيدْ مِنْ رَاعُوثْ.</para>
  <para style="li" vid="MAT 1:5">وعُوبِيدْ جَابْ يَسَّى.<verse eid="MAT 1:5" /></para>
  <para style="li">
    <verse number="6" style="v" sid="MAT 1:6" />ويَسَّى جَابْ المَلِكْ دَاوِدْ.</para>
  <para style="b" vid="MAT 1:6" />
  <para style="li" vid="MAT 1:6">ودَاوِدْ جَابْ سُلَيْمَانْ مِالمْرَا الِّي كَانْ مَاخِذْهَا أُورِيَّا.<verse eid="MAT 1:6" /></para>
  <para style="li">
    <verse number="7" style="v" sid="MAT 1:7" />وسُلَيْمَانْ جَابْ رَحَبْعَامْ.</para>
  <para style="li" vid="MAT 1:7">ورَحَبْعَامْ جَابْ أَبِيَّا.</para>
  <para style="li" vid="MAT 1:7">وأَبِيَّا جَابْ آسَا.<verse eid="MAT 1:7" /></para>
  <para style="li">
    <verse number="8" style="v" sid="MAT 1:8" />وآسَا جَابْ يَهُوشَافَاطْ.</para>
  <para style="li" vid="MAT 1:8">ويَهُوشَافَاطْ جَابْ يُورَامْ.</para>
  <para style="li" vid="MAT 1:8">ويُورَامْ جَابْ عُزِّيَّا.<verse eid="MAT 1:8" /></para>
  <para style="li">
    <verse number="9" style="v" sid="MAT 1:9" />وعُزِّيَّا جَابْ يُوثَامْ.</para>
  <para style="li" vid="MAT 1:9">ويُوثَامْ جَابْ أَحَازْ.</para>
  <para style="li" vid="MAT 1:9">وأَحَازْ جَابْ حِزْقِيَّا.<verse eid="MAT 1:9" /></para>
  <para style="li">
    <verse number="10" style="v" sid="MAT 1:10" />وحِزْقِيَّا جَابْ مَنَسَّى.</para>
  <para style="li" vid="MAT 1:10">ومَنَسَّى جَابْ آمُونْ.</para>
  <para style="li" vid="MAT 1:10">وآمُونْ جَابْ يُوشِيَّا.<verse eid="MAT 1:10" /></para>
  <para style="li">
    <verse number="11" style="v" sid="MAT 1:11" />ويُوشِيَّا جَابْ يَكُنْيَا وخْوَاتُو، وَقْتِلِّي كَانُوا يِسْبِيوْ فِي اليْهُودْ لْبَابِلْ.<verse eid="MAT 1:11" /></para>
  <para style="b" />
  <para style="li">
    <verse number="12" style="v" sid="MAT 1:12" />وبَعْدْمَا سْبَاوْهُمْ لْبَابِلْ، يَكُنْيَا جَابْ شَأَلْتِئِيلْ.</para>
  <para style="li" vid="MAT 1:12">وشَأَلْتِئِيلْ جَابْ زَرُبَّابِلْ.<verse eid="MAT 1:12" /></para>
  <para style="li">
    <verse number="13" style="v" sid="MAT 1:13" />وزَرُبَّابِلْ جَابْ أَبِيهُودْ.</para>
  <para style="li" vid="MAT 1:13">وأَبِيهُودْ جَابْ أَلِيَاقِيمْ.</para>
  <para style="li" vid="MAT 1:13">وأَلِيَاقِيمْ جَابْ عَازُورْ.<verse eid="MAT 1:13" /></para>
  <para style="li">
    <verse number="14" style="v" sid="MAT 1:14" />وعَازُورْ جَابْ صَادُوقْ.</para>
  <para style="li" vid="MAT 1:14">وصَادُوقْ جَابْ أَخِيمْ.</para>
  <para style="li" vid="MAT 1:14">وأَخِيمْ جَابْ أَلِيُودْ.<verse eid="MAT 1:14" /></para>
  <para style="li">
    <verse number="15" style="v" sid="MAT 1:15" />وأَلِيُودْ جَابْ أَلِيعَازَرْ.</para>
  <para style="li" vid="MAT 1:15">وأَلِيعَازَرْ جَابْ مَتَّانْ.</para>
  <para style="li" vid="MAT 1:15">ومَتَّانْ جَابْ يَعْقُوبْ.<verse eid="MAT 1:15" /></para>
  <para style="li">
    <verse number="16" style="v" sid="MAT 1:16" />ويَعْقُوبْ جَابْ يُوسِفْ رَاجِلْ مَرْيِمْ</para>
  <para style="li" vid="MAT 1:16">الِّي وِلْدِتْ يَسُوعْ الِّي يْعَيْطُولُو المَسِيحْ.<verse eid="MAT 1:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />وهَكَّا نَلْقَاوْ 14 جِيلْ مِنْ إِبْرَاهِيمْ حَتَّى لْدَاوِدْ، و14 جِيلْ مِنْ دَاوِدْ حَتَّى لِينْ تِسْبَاوْ اليْهُودْ لْبَابِلْ، و14 جِيلْ مِلِّي تِسْبَاوْ حَتَّى لِينْ جَاء المَسِيحْ.<verse eid="MAT 1:17" /></para>
  <para style="s">وْلَادِةْ يَسُوعْ</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />وهَاوْ كِيفَاشْ تُولِدْ يَسُوعْ المَسِيحْ: كَانِتْ أُمُّو مَرْيِمْ مَخْطُوبَة لْرَاجِلْ إِسْمُو يُوسِفْ. وقْبَلْ مَا يْعَرْسُوا، ظْهُرْ الِّي هِيَّ حِبْلَى بْقُوِّةْ الرُّوحْ القُدُسْ. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />وعْلَى خَاطِرْ يُوسِفْ كَانْ رَاجِلْ صَالَحْ، قَرِّرْ يِبْعِدْ عْلِيهَا فِي السِّرْ، مِنْ غِيرْ مَا يِفْضَحْهَا. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />وهُوَّ مَزَّالْ يْخَمِّمْ فِي الحْكَايَة، ظْهُرْلُو مَلَاكْ مِنْ عَنْدْ الرَّبْ فِي المْنَامْ، وقَالُّو: «يَا يُوسِفْ وِلْدْ دَاوِدْ، مَا تْخَافِشْ إِنِّكْ تْعَرِّسْ بْمَرْيِمْ، عْلَى خَاطِرْ الِّي حِبْلَى بِيهْ هُوَّ مِالرُّوحْ القُدُسْ. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />وبِشْ تْجِيبْ وْلَيِّدْ، وإِنْتِ تْسَمِّيهْ يَسُوعْ، عْلَى خَاطْرُو بِشْ يْنَجِّي شَعْبُو مِنْ ذْنُوبْهُمْ». <verse eid="MAT 1:21" /><verse number="22" style="v" sid="MAT 1:22" />وهَاذَا الكُلْ صَارْ بَاشْ يِتْحَقَّقْ الِّي قَالُو الرَّبْ عْلَى طْرِيقْ النَّبِيْ:<verse eid="MAT 1:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="MAT 1:23" />«الصْبِيَّة تِحْبِلْ، وتْجِيبْ طْفُلْ،</para>
  <para style="q2" vid="MAT 1:23">يِتْسَمَّى عِمَّانُوئِيلْ!» (الِّي تَفْسِيرُو: اللَّهْ مْعَانَا).<verse eid="MAT 1:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />ووَقْتِلِّي فَاقْ يُوسِفْ مِالنُّومْ، عْمَلْ كِيمَا قَالُّو المَلَاكْ، ورَوَّحْ بْمَرْتُو لْدَارُو، <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />آمَا مَا مَسْهَاشْ حَتَّى لِينْ جَابِتْ الطْفُلْ، وسَمَّاهْ يَسُوعْ.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">حُكَمَاءْ مِالشَّرْقْ يْلَوْجُوا عْلَى يَسُوعْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />ووَقْتِلِّي تُولِدْ يَسُوعْ فِي بَيْتْ لَحْمْ الِّي فِي مَنْطَقْةْ اليَهُودِيَّة، فِي عَهْدْ المَلِكْ هِيرُودُسْ، جَاوْ جْمَاعَة حُكَمَاءْ مِالشَّرْقْ لْأُورْشَلِيمْ، <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />وسِأْلُوا: «وِينُو مَلِكْ اليْهُودْ الِّي تُولِدْ؟ رَانَا شُفْنَا نِجْمْتُو فِي الشَّرْقْ، وجِينَا بَاشْ نُسْجْدُولُو». <verse eid="MAT 2:2" /><verse number="3" style="v" sid="MAT 2:3" />وكِي سْمَعْ المَلِكْ هِيرُودُسْ الحْكَايَة هَاذِي، دْخَلْ بَعْضُو هُوَّ وأُورْشَلِيمْ الكُلْ. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />يَاخِي لَمْ كْبَارْ الكَهَنَة وعُلَمَاءْ الشَّرِيعَة الكُلْ وسْإِلْهُمْ: «وِينْ يِتُوْلِدْ المَسِيحْ؟». <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />جَاوْبُوهْ: «فِي بَيْتْ لَحْمْ الِّي فِي مَنْطَقْةْ اليَهُودِيَّة، عْلَى خَاطِرْ هَاذَا الِّي كِتْبُو النَّبِيْ:<verse eid="MAT 2:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />وإِنْتِ يَا بَيْتْ لَحْمْ الِّي فِي أَرْضْ يَهُوذَا،</para>
  <para style="q2" vid="MAT 2:6">مَاكِشْ مَحْقُورَة بِينْ حُكَّامْ يَهُوذَا،</para>
  <para style="q1" vid="MAT 2:6">عْلَى خَاطِرْ مِنِّكْ يِطْلَعْ حَاكِمْ،</para>
  <para style="q2" vid="MAT 2:6">يَرْعَى شَعْبِي بَنِي إِسْرَائِيلْ».<verse eid="MAT 2:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />وَلَّى هِيرُودُسْ عَيِّطْ لِلْحُكَمَاءْ فِي السِّرْ، وثَبِّتْ مِنْهُمْ وَقْتَاشْ بِالضَّبْطْ ظُهْرِتْ النِّجْمَة، <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />ومْبَعِّدْ بْعَثْهُمْ لْبَيْتْ لَحْمْ وقَالِلْهُمْ: «إِمْشِيوْ لَوْجُوا بِالڨْدَا عَالطْفُلْ. وكِي تَلْقَاوَهْ، إِيجَاوْ خَبْرُونِي بَاشْ نِمْشِي حَتَّى آنَا نُسْجُدْلُو». <verse eid="MAT 2:8" /><verse number="9" style="v" sid="MAT 2:9" />بَعْدْمَا سَمْعُوا كْلَامْ المَلِكْ مْشَاوْ. وهُومَا فِي الطْرِيقْ، إِذَا بِيهَا النِّجْمَة الِّي شَافُوهَا قْبَلْ فِي الشَّرْقْ قَاعْدَة تِمْشِي قُدَّامْهُمْ حَتَّى لِينْ وِقْفِتْ فُوقْ البْلَاصَة الِّي مَوْجُودْ فِيهَا الطْفُلْ. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />ووَقْتِلِّي شَافُوا النِّجْمَة فَرْحُوا فَرْحَة كْبِيرَة. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />ودَخْلُوا لِلدَّارْ ولْقَاوْ الطْفُلْ مْعَ أُمُّو مَرْيِمْ. وهَبْطُوا عْلَى رْكَايِبْهُمْ وسِجْدُولُو، وحَلُّوا صْنَادِقْهُمْ وهْدَاوْلُو ذْهَبْ وبْخُورْ ولُوبَانْ. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />ونَبَّهُّمْ اللَّهْ فِي المْنَامْ بَاشْ مَا يِرْجْعُوشْ لْهِيرُودُسْ، وَلَّاوْ جَابُوا طْرِيقْ آخِرْ ورَوْحُوا لِبْلَادْهُمْ.<verse eid="MAT 2:12" /></para>
  <para style="s">يُوسِفْ يُهْرِبْ بْعَايِلْتُو لْمَصْرْ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />وبَعْدْمَا رَوْحُوا الحُكَمَاءْ، ظْهُرْ مَلَاكْ مِنْ عَنْدْ الرَّبْ لْيُوسِفْ فِي المْنَامْ وقَالُّو: «قُومْ! هِزْ الطْفُلْ وأُمُّو وأُهْرُبْ لْمَصْرْ، وإِبْقَى غَادِي حَتَّى لِينْ نْقُلِّكْ وَقْتَاشْ تِرْجَعْ، عْلَى خَاطِرْ هِيرُودُسْ نَاوِي يْلَوِّجْ عْلِيهْ ويُقْتْلُو». <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />وفِي نَفْسْ اللِّيلَة قَامْ يُوسِفْ وهَزْ الطْفُلْ وأُمُّو ومْشَى لْمَصْرْ. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />وبْقَى فِيهَا حَتَّى لِينْ مَاتْ هِيرُودُسْ، وهَكَّا صَارْ الِّي قَالُو الرَّبْ عْلَى طْرِيقْ النَّبِيْ: «عَيَّطْتْ لْإِبْنِي مِنْ مَصْرْ».<verse eid="MAT 2:15" /></para>
  <para style="s">هِيرُودُسْ يُأْمُرْ بْقَتْلَانْ الصْغَارْ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />وكِي فْهِمْ هِيرُودُسْ الِّي الحُكَمَاءْ تْمَسْخْرُوا عْلِيهْ، تْغَشِّشْ عَالإِخِّرْ وعْطَى أَمْرْ بَاشْ يُقْتْلُوا الصْغَارْ الكُلْ الِّي فِي بَيْتْ لَحْمْ والبْلَايِصْ الدَّايْرَة بِيهَا الِّي عْمَارْهُمْ عَامِينْ وأَقَلْ، بْحَسْبْ الوَقْتْ الِّي قَالُولُو عْلِيهْ الحُكَمَاءْ. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />وهَكَّا صَارْ الِّي قَالُو النَّبِيْ إِرْمِيَا:<verse eid="MAT 2:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />«فِي مْدِينِةْ الرَّامَة سَمْعُوا صْيَاحْ،</para>
  <para style="q2" vid="MAT 2:18">وبَرْشَة بْكَى ونْوَاحْ،</para>
  <para style="q1" vid="MAT 2:18">رَاحِيلْ تِبْكِي عْلَى وْلَادْهَا،</para>
  <para style="q2" vid="MAT 2:18">ومَا تْحِبِّشْ تْبَطِّلْ الحُزْنْ عْلَى خَاطِرْهُمْ مَاتُوا».<verse eid="MAT 2:18" /></para>
  <para style="s">يُوسِفْ يِرْجَعْ مْعَ عَايِلْتُو لِلنَّاصْرَة</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />وبَعْدْمَا مَاتْ هِيرُودُسْ، ظْهُرْ مَلَاكْ مِنْ عَنْدْ الرَّبْ لْيُوسِفْ فِي المْنَامْ وهُوَّ فِي مَصْرْ، <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />وقَالُّو: «قُومْ! هِزْ الطْفُلْ وأُمُّو وإِرْجَعْ لْأَرْضْ إِسْرَائِيلْ، عْلَى خَاطِرْ الِّي حَبُّوا يُقْتْلُوهْ مَاتُوا». <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />يَاخِي قَامْ وهَزْ الطْفُلْ وأُمُّو ورْجَعْ لْأَرْضْ إِسْرَائِيلْ. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />آمَا كِي سْمَعْ الِّي أَرْخِيلَاوُسْ وَلَّى مَلِكْ عْلَى مَنْطَقْةْ اليَهُودِيَّة فِي بْلَاصِةْ بُوهْ هِيرُودُسْ، خَافْ بِشْ يِمْشِيلْهَا. يَاخِي نَبْهُو اللَّهْ فِي المْنَامْ، وَلَّى مْشَى لْمَنْطَقْةْ الجَلِيلْ. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />وسِكْنُوا فِي مْدِينَة إِسْمْهَا النَّاصْرَة، بَاشْ يْصِيرْ الِّي تْقَالْ فِي كْتُبْ الأَنْبِيَاءْ بِشْ يْعَيْطُولُو نَاصْرِي.<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">يُوحَنَّا يْحَضِّرْ فِي الطْرِيقْ لْيَسُوعْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />وفِي الزْمَانْ هَاذَاكَا، بْدَا يُوحَنَّا الِّي يْعَمِّدْ يْبَشِّرْ فِي خْلَاء مَنْطَقْةْ اليَهُودِيَّة <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />ويْقُولْ: «تُوبُوا، رَاهِي مَمْلَكْةْ السْمَاوَاتْ قُرْبِتْ!». <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />ويُوحَنَّا هَاذَا هُوَّ الِّي حْكَى عْلِيهْ النَّبِيْ إِشَعْيَاءْ كِي قَالْ:</para>
  <para style="b" vid="MAT 3:3" />
  <para style="q1" vid="MAT 3:3">«صُوتْ يْعَيِّطْ فِي الخْلَاء:</para>
  <para style="q2" vid="MAT 3:3">حَضّْرُوا طْرِيقْ الرَّبْ،</para>
  <para style="q1" vid="MAT 3:3">إِسْتْوِيوْ الثْنِيَّة قُدَّامُو!».<verse eid="MAT 3:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />وكَانْ يُوحَنَّا لَابِسْ لِبْسَة مِنْ وْبَرْ الجْمَالْ، ومِتْحَزِّمْ بِحْزَامْ جِلْدْ، ويَاكِلْ فِي الجْرَادْ والعْسَلْ الجَّالِي. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />وكَانُوا النَّاسْ يِمْشِيوْلُو مِنْ أُورْشَلِيمْ ومَنْطَقْةْ اليَهُودِيَّة الكُلْ والبْلَايِصْ الِّي بَحْذَا وَادْ الأُرْدُنْ، <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />بَاشْ يَعْتَرْفُوا بِذْنُوبْهُمْ، وهُوَّ يْعَمِّدْهُمْ فِي وَادْ الأُرْدُنْ.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />ووَقْتِلِّي شَافْ بَرْشَة فِرِّيسِيِّينْ وصَدُّوقِيِّينْ جَايِّينُو بَاشْ يْعَمِّدْهُمْ، قَالِلْهُمْ: «يَا وْلَادْ الأَفَاعِي! شْكُونْ الِّي عَلَّمْكُمْ تُهْرْبُوا مِنْ غَضَبْ اللَّهْ الِّي بِشْ يْجِي؟ <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />أَعْمْلُوا أَعْمَالْ تْوَرِّي الِّي إِنْتُومَا تُبْتُوا بِالحَقْ، <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />ومَا تْقُولُوشْ فِي قْلُوبْكُمْ: "أَحْنَا وْلَادْ إِبْرَاهِيمْ"، عْلَى خَاطِرْ آنَا نْقُلْكُمْ إِنُّو اللَّهْ قَادِرْ يَعْمِلْ مِالحْجَرْ هَاذَا وْلَادْ لْإِبْرَاهِيمْ. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />هَاوْ الفَاسْ مِنْ تَوَّا حَاضِرْ بَاشْ يْقُصْ الشْجَرْ مِنْ عْرُوقُو، والشَّجْرَة الِّي مَا تْجِيبِشْ غَلَّة بَاهْيَة تِتْقَصْ وتِتْرْمَى فِي النَّارْ. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />آنَا نْعَمِّدْكُمْ بِالمَاء كِي اتُّوبُوا، آمَا الِّي بِشْ يْجِي بَعْدِي رَاهُو أَقْوَى مِنِّي، وآنَا مَا نِسْتَاهِلْشْ حَتَّى نْهِزْلُو صَنْدَالُو. هُوَّ بِشْ يْعَمِّدْكُمْ بِالرُّوحْ القُدُسْ والنَّارْ. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />ويْهِزْ المَذْرَى فِي يِدُّو ويِفْرِزْ صَابْتُو، يْلِمْ القَمْحْ فِي المَخْزِنْ، آمَا التْبِنْ يَحْرْقُو بْنَارْ مَا تِطْفَاشْ».<verse eid="MAT 3:12" /></para>
  <para style="s">مَعْمُودِيِّةْ يَسُوعْ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />فِي الوَقْتْ هَاذَاكَا جَاء يَسُوعْ مِنْ مَنْطَقْةْ الجَلِيلْ لْوَادْ الأُرْدُنْ، ومْشَى لْيُوحَنَّا بَاشْ يِتْعَمِّدْ عْلَى يْدِيهْ. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />آمَا يُوحَنَّا مَا خَلَّاهِشْ وقَالُّو: «آنَا هُوَّ الِّي مِسْتْحَقْ نْجِيكْ تْعَمِّدْنِي، كِيفَاشْ إِنْتِ الِّي تْجِينِي؟» <verse eid="MAT 3:14" /><verse number="15" style="v" sid="MAT 3:15" />يَاخِي جَاوْبُو يَسُوعْ: «خَلِّي هَاذَا يْصِيرْ تَوَّا، عْلَى خَاطِرْ هَكَّا نْتَمْمُوا كُلْ مَاهُو صَالَحْ». يَاخِي وَافْقُو يُوحَنَّا. <verse eid="MAT 3:15" /><verse number="16" style="v" sid="MAT 3:16" />وبِالوَقْتْ بَعْدْمَا تْعَمِّدْ يَسُوعْ وخْرَجْ مِالمَاء، تْحَلِّتْلُو السْمَاء، وشَافْ رُوحْ اللَّهْ هَابِطْ كِالحْمَامَة وحَطْ عْلِيهْ. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />وإِذَا بِيهْ صُوتْ مِالسْمَاء يْقُولْ: «هَاذَا هُوَّ إِبْنِي الِّي نْحِبُّو ولِّي آنَا فَرْحَانْ بِيهْ».<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">إِبْلِيسْ يْجَرِّبْ فِي يَسُوعْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />وهَزْ الرُّوحْ القُدُسْ يَسُوعْ لِلْخْلَاء بَاشْ إِبْلِيسْ يْجَرْبُو. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />وبَعْدْمَا صَامْ 40 يُومْ و40 لِيلَة، جَاعْ. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />قْرُبْلُو إِبْلِيسْ الِّي يْجَرِّبْ وقَالُّو: «كَانِكْ إِنْتِ إِبْنْ اللَّهْ، قُولْ لِلْحْجَرْ هَاذَا يْوَلِّي خُبْزْ». <verse eid="MAT 4:3" /><verse number="4" style="v" sid="MAT 4:4" />يَاخِي جَاوْبُو يَسُوعْ: «مَكْتُوبْ فِي الكْتُبْ المُقَدْسَة:</para>
  <para style="b" vid="MAT 4:4" />
  <para style="q1" vid="MAT 4:4">"الإِنْسَانْ مَا يْعِيشِشْ كَانْ بِالخُبْزْ،</para>
  <para style="q2" vid="MAT 4:4">آمَا يْعِيشْ بْكُلْ كِلْمَة تُخْرُجْ مِنْ فُمْ اللَّهْ"».<verse eid="MAT 4:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />وهَزُّو إِبْلِيسْ لِلْمْدِينَة المُقَدْسَة، ووَقْفُو عْلَى حَرْفْ أَعْلَى بْلَاصَة فِي الهَيْكِلْ، <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />وقَالُّو: «كَانِكْ إِنْتِ إِبْنْ اللَّهْ إِرْمِي رُوحِكْ مِنْ فُوقْ، عْلَى خَاطِرْ مَكْتُوبْ:</para>
  <para style="b" vid="MAT 4:6" />
  <para style="q1" vid="MAT 4:6">"يْوَصِّي عْلِيكْ مْلَايِكْتُو"،</para>
  <para style="b" vid="MAT 4:6" />
  <para style="q1" vid="MAT 4:6">"وهُومَا يْهِزُّوكْ عْلَى يْدِيهُمْ</para>
  <para style="q2" vid="MAT 4:6">بَاشْ سَاقِيكْ مَا تِتْضْرَبْشْ فِي حَجْرَة"».<verse eid="MAT 4:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />جَاوْبُو يَسُوعْ: «مَكْتُوبْ زَادَا: "مَا تْجَرَّبْشْ الرَّبْ إِلَاهِكْ"».<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />ومْبَعِّدْ هَزُّو إِبْلِيسْ فُوقْ جْبَلْ عَالِي بَرْشَة، ووَرَّاهْ مَمَالِكْ الدِّنْيَا الكُلْ والحَاجَاتْ العْظِيمَة الِّي فِيهَا، <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />وقَالُّو: «نَعْطِيكْ هَاذَا الكُلْ، إِذَا كَانْ تَهْبِطْ عْلَى رْكَايْبِكْ وتِسْجِدْلِي». <verse eid="MAT 4:9" /><verse number="10" style="v" sid="MAT 4:10" />يَاخِي جَاوْبُو يَسُوعْ: «إِبْعِدْ عْلِيَّا يَا شِيطَانْ! عْلَى خَاطِرْ مَكْتُوبْ فِي الكْتُبْ المُقَدْسَة:</para>
  <para style="b" vid="MAT 4:10" />
  <para style="q1" vid="MAT 4:10">"إِسْجِدْ لِلرَّبْ إِلَاهِكْ،</para>
  <para style="q2" vid="MAT 4:10">واعْبْدُو هُوَّ وَحْدُو"».<verse eid="MAT 4:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />وَلَّى إِبْلِيسْ بْعِدْ عْلِيهْ، وجَاتْ المْلَايْكَة وبْدَاتْ تِخْدِمْ فِيهْ.<verse eid="MAT 4:11" /></para>
  <para style="s">يَسُوعْ يْبَشِّرْ فِي الجَلِيلْ</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />وكِي سْمَعْ يَسُوعْ الِّي يُوحَنَّا تْشَدْ فِي الحَبْسْ، رْجَعْ لْمَنْطَقْةْ الجَلِيلْ. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />وخْرَجْ مِنْ مْدِينِةْ النَّاصْرَة ومْشَى سْكِنْ فِي كَفْرْنَاحُومْ الِّي عْلَى شَطْ البُحَيْرَة المَوْجُودَة فِي أَرْضْ زَبُولُونْ ونَفْتَالِي، <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />بَاشْ يِتْحَقَّقْ الِّي قَالُو النَّبِيْ إِشَعْيَاءْ:<verse eid="MAT 4:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />«أَرْضْ نَفْتَالِي وأَرْضْ زَبُولُونْ،</para>
  <para style="q2" vid="MAT 4:15">عْلَى ثْنِيِّةْ البُحَيْرَة فِي غَرْبْ وَادْ الأُرْدُنْ،</para>
  <para style="q2" vid="MAT 4:15">أَرْضْ الجَلِيلْ العَايْشِينْ فِيهَا الِّي مَاهُمْشْ يْهُودْ!<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />الشَّعْبْ العَايِشْ فِي الظْلَامْ شَافْ نُورْ عْظِيمْ،</para>
  <para style="q2" vid="MAT 4:16">والنُّورْ ضْوَى عَلِّي عَايْشِينْ فِي أَرْضْ المُوتْ وظِلُّو».<verse eid="MAT 4:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />ومِنْ وَقْتْهَا بْدَا يَسُوعْ يْبَشِّرْ ويْقُولْ: «تُوبُوا، رَاهِي مَمْلَكْةْ السْمَاوَاتْ قُرْبِتْ».<verse eid="MAT 4:17" /></para>
  <para style="s">يَسُوعْ يِخْتَارْ تْلَامِذْتُو الأُولَانِينْ</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />وَقْتِلِّي كَانْ يَسُوعْ يِمْشِي عْلَى شَطْ بُحَيْرِةْ الجَلِيلْ، شَافْ زُوزْ صَيَّادَة خْوَاتْ يَرْمِيوْ فِي شَبْكَة فِي البُحَيْرَة، وهُومَا سِمْعَانْ الِّي يْعَيْطُولُو بُطْرُسْ وخُوهْ أَنْدَرَاوُسْ. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />قَالِلْهُمْ: «تَبْعُونِي وآنَا نْرُدْكُمْ صَيَّادِةْ نَاسْ». <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />وبِالوَقْتْ خَلَّاوْ شْبَاكْهُمْ وتَبْعُوهْ. <verse eid="MAT 4:20" /><verse number="21" style="v" sid="MAT 4:21" />وهُوَّ مْكَمِّلْ فِي ثْنِيْتُو، شَافْ زُوزْ أَخْوَة أُخْرِينْ، الِّي هُومَا يَعْقُوبْ وِلْدْ زَبَدِي وخُوهْ يُوحَنَّا، وكَانُوا فِي الفْلُوكَة مْعَ بُوهُمْ يْصَلْحُوا فِي شْبَاكْهُمْ، يَاخِي عَيْطِلْهُمْ. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />وبِالوَقْتْ خَلَّاوْ الفْلُوكَة وبُوهُمْ وتَبْعُوهْ.<verse eid="MAT 4:22" /></para>
  <para style="s">يَسُوعْ يْعَلِّمْ ويِشْفِي المُرْضَى</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />وكَانْ يَسُوعْ يْدُورْ فِي مَنْطَقْةْ الجَلِيلْ الكُلْ يْعَلِّمْ فِي وِسْطْ مْعَابِدْ اليْهُودْ، ويْخَبِّرْ بِبْشَارِةْ مَمْلَكْةْ السْمَاوَاتْ، ويِشْفِي النَّاسْ مِنْ كُلْ مَرْضْ ودَاء. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />وسَمْعُوا بِيهْ فِي سُورْيَا الكُلْ. وجَابُولُو المُرْضَى بْكُلْ أَنْوَاعْهُمْ، والمَسْكُونِينْ بِالشْوَاطِنْ والمَصْرُوعِينْ والمَشْلُولِينْ، يَاخِي شْفَاهُمْ الكُلْ. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />وتَبْعُوهْ بَرْشَة نَاسْ مِالجَلِيلْ ومِنْ مَنْطَقْةْ المُدُنْ العَشْرْ وأُورْشَلِيمْ ومَنْطَقْةْ اليَهُودِيَّة ومِنْ شَرْقْ الأُرْدُنْ.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">الوَعْظَة عَالجْبَلْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />وكِي شَافْ يَسُوعْ النَّاسْ طْلَعْ لِلجْبَلْ، ودُوبْ مَا قْعَدْ، قُرْبُولُو تْلَامِذْتُو، <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />وبْدَا يْعَلِّمْ فِيهُمْ، وقَالْ:<verse eid="MAT 5:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />«صَحَّة لِيهُمْ الِّي يِعْتَرْفُوا بْضُعْفْهُمْ الرُّوحِي!</para>
  <para style="q2" vid="MAT 5:3">عْلَى خَاطِرْ مَمْلَكْةْ السْمَاوَاتْ لِيهُمْ.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />صَحَّة لِيهُمْ الحْزَانَى،</para>
  <para style="q2" vid="MAT 5:4">خَاطِرْهُمْ بِشْ يِتْعَزَّاوْ.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />صَحَّة لِيهُمْ المُسَالْمِينْ!</para>
  <para style="q2" vid="MAT 5:5">خَاطِرْهُمْ بِشْ يُورْثُوا الأَرْضْ.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />صَحَّة لِيهُمْ الجْوَاعَى والعُطْشَانِينْ لِلصَّلَاحْ!</para>
  <para style="q2" vid="MAT 5:6">رَاهُمْ بِشْ يِشْبْعُوا.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />صَحَّة لِيهُمْ الِّي يَرْحْمُوا!</para>
  <para style="q2" vid="MAT 5:7">خَاطِرْهُمْ بِشْ يِتْرَحْمُوا.<verse eid="MAT 5:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="MAT 5:8" />صَحَّة لِيهُمْ الِّي قْلُوبْهُمْ صَافْيَة!</para>
  <para style="q2" vid="MAT 5:8">عْلَى خَاطِرْهُمْ بِشْ يْشُوفُوا اللَّهْ.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />صَحَّة لِيهُمْ الِّي يَعْمْلُوا السَّلَامْ!</para>
  <para style="q2" vid="MAT 5:9">عْلَى خَاطِرْهُمْ بِشْ يِتْسَمَّاوْ وْلَادْ اللَّهْ.<verse eid="MAT 5:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="MAT 5:10" />صَحَّة لِيهُمْ الِّي يِضْطَهْدُوهُمْ بِسْبَبْ الصَّلَاحْ!</para>
  <para style="q2" vid="MAT 5:10">عْلَى خَاطِرْ مَمْلَكْةْ السْمَاوَاتْ لِيهُمْ.<verse eid="MAT 5:10" /></para>
  <para style="b" />
  <para style="m">
    <verse number="11" style="v" sid="MAT 5:11" />«صَحَّة لِيكُمْ كَانْ عْلَى خَاطْرِي عَايْرُوكُمْ واضْطَهْدُوكُمْ وقَالُوا عْلِيكُمْ كْلَامْ خَايِبْ بِالكِذْبْ! <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />إِفْرْحُوا وازْهَاوْ، عْلَى خَاطِرْ أَجْرْكُمْ عْظِيمْ فِي السْمَاء. رَاهُمْ هَكَّا اضْطَهْدُوا الأَنْبِيَاءْ قْبَلْكُمْ.<verse eid="MAT 5:12" /></para>
  <para style="s">إِنْتُومَا مِلْحْ الأَرْضْ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />«إِنْتُومَا مِلْحْ الأَرْضْ. وإِذَا كَانْ المِلْحْ ضَيَّعْ مْلُوحِيتُو، بَاشْ بِشْ يِرْجَعْلُو طَعْمُو؟ رَاهُو مَا عَادْ يُصْلُحْ لْحَتَّى شَيْ، كَانْ بَاشْ يِتْرْمَى لْبَرَّا والنَّاسْ يْعَفْسُوا عْلِيهْ. <verse eid="MAT 5:13" /><verse number="14" style="v" sid="MAT 5:14" />إِنْتُومَا النُّورْ الِّي فِي الدِّنْيَا هَاذِي. مَا فَمَّاشْ مْدِينَة مِبْنِيَّة فُوقْ جْبَلْ ومَا تِتْشَافِشْ، <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />ومَا فَمَّاشْ وَاحِدْ يْشَعِّلْ فْنَارْ ويْغُمُّو بْطَاسَة، آمَا يْحُطُّو فِي بْلَاصَة عَالْيَة بَاشْ يِضْوِي عَالمَوْجُودِينْ فِي الدَّارْ الكُلْ. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />وإِنْتُومَا زَادَا خَلِّيوْ نُورْكُمْ يِضْوِي قُدَّامْ النَّاسْ، بَاشْ يْشُوفُوا أَعْمَالْكُمْ الصَّالْحَة، ويْمَجْدُوا بُوكُمْ الِّي فِي السْمَاء.<verse eid="MAT 5:16" /></para>
  <para style="s">يَسُوعْ وشَرِيعِةْ مُوسَى</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />«مَا تْحُطُّوشْ فِي بَالْكُمْ الِّي آنَا جِيتْ بَاشْ نْرُدْ الشَّرِيعَة وكْتُبْ الأَنْبِيَاءْ بَاطْلِينْ، آنَا مَا جِيتِشْ بَاشْ نْرُدْهُمْ بَاطْلِينْ آمَا بَاشْ نْكَمَّلْهُمْ. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />نْقُلْكُمْ الحَقْ: مَادَامْ السْمَاء والأَرْضْ مَوْجُودِينْ، مَا يِتْنَحَّى حَتَّى حَرْفْ ولَا حَتَّى نُقْطَة وَحْدَة مِالشَّرِيعَة حَتَّى لِينْ يِكْمِلْ كُلْ شَيْ. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />الِّي يْخَالِفْ أَصْغِرْ وَحْدَة مِالوْصَايَا هَاذُمْ ويْعَلِّمْ النَّاسْ بَاشْ يَعْمْلُوا كِيفُو، يْكُونْ عَنْدُو أَقَلْ مْقَامْ فِي مَمْلَكْةْ السْمَاوَاتْ. آمَا الِّي يْطِيعْهُمْ ويْعَلِّمْهُمْ، يْكُونْ عَنْدُو مْقَامْ عَالِي فِي مَمْلَكْةْ السْمَاوَاتْ. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />وآنَا نْقُولِلْكُمْ، إِذَا كَانْ صَلَاحْكُمْ مَا يْفُوتِشْ صَلَاحْ عُلَمَاءْ الشَّرِيعَة والفِرِّيسِيِّينْ، رَاهُو عْمُرْكُمْ مَا بِشْ تُدْخْلُوا لْمَمْلَكْةْ السْمَاوَاتْ.<verse eid="MAT 5:20" /></para>
  <para style="s">الغُشْ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />«سْمَعْتُوا إِنُّو تْقَالْ لِجْدُودْكُمْ: "مَا تَعْمِلْشْ جْرِيمِةْ قَتْلْ، ولِّي يُقْتُلْ يِلْزْمُو يِتْحَاكِمْ". <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />آمَا آنَا نْقُولِلْكُمْ: الِّي يِتْغَشِّشْ عْلَى خُوهْ يِلْزْمُو يِتْحَاكِمْ، ولِّي يْقُولْ لْخُوهْ "يَا تَافَهْ"، يِتْعَدَّى عَالمَجْلِسْ الأَعْلَى، ولِّي يْقُلُّو "يَا بْهِيمْ"، يِسْتَاهِلْ نَارْ جْهَنِّمْ. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />مَالَا كِي تَبْدَى جَايِبْ قُرْبَانِكْ لِلْمَذْبَحْ وتْذَكَّرْتْ وَقْتْهَا الِّي خُوكْ عَنْدُو حَاجَة ضِدِّكْ، <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />خَلِّي قُرْبَانِكْ قُدَّامْ المَذْبَحْ، وإِمْشِي اتْصَالَحْ مْعَ خُوكْ قْبَلْ، ومْبَعِّدْ إِيجَا أَعْطِي قُرْبَانِكْ. <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" />حَاوِلْ فِيسَعْ تْرَاضِي وَاحِدْ عَنْدُو مُشْكْلَة مْعَاكْ مَادَامْكُمْ فِي طْرِيقْكُمْ لِلْمَحْكْمَة، بَاشْ مَا يْهِزِّكْشْ لِلْقَاضِي والقَاضِي يْسَلْمِكْ لِلْحَاكِمْ، وتِتِّرْمَى فِي الحَبْسْ. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />نْقُلِّكْ الحَقْ: مَاكِشْ بِشْ تُخْرُجْ مِنْ غَادِي حَتَّى لِينْ تْخَلِّصْ آخِرْ فْرَنْكْ.<verse eid="MAT 5:26" /></para>
  <para style="s">الزْنَى</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />«سْمَعْتُوا إِنُّو تْقَالْ: "مَا تَزْنَاشْ". <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />آمَا آنَا نْقُولِلْكُمْ: الِّي يُخْزُرْ لِمْرَا بْشَهْوَة، رَاهُو زْنَى بِيهَا فِي قَلْبُو. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />إِذَا كَانْ عِينِكْ اليْمِينْ تْخَلِّيكْ تُغْلُطْ، قَلَّعْهَا وإِرْمِيهَا، تَخْسِرْ قَطْعَة مِنْ بَدْنِكْ خِيرْ مِلِّي بَدْنِكْ الكُلْ يِتْرْمَى فِي جْهَنِّمْ. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />وإِذَا كَانْ يِدِّكْ اليْمِينْ تْخَلِّيكْ تُغْلُطْ، قُصْهَا وإِرْمِيهَا، تَخْسِرْ قَطْعَة مِنْ بَدْنِكْ خِيرْ مِلِّي بَدْنِكْ الكُلْ يِتْرْمَى فِي جْهَنِّمْ.<verse eid="MAT 5:30" /></para>
  <para style="s">الطْلَاقْ</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />«وتْقَالْ زَادَا: "الِّي يْطَلَّقْ مَرْتُو، لَازِمْ يَعْطِيهَا وَرْقِةْ الطْلَاقْ". <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />آمَا آنَا نْقُولِلْكُمْ: الِّي يْطَلَّقْ مَرْتُو بْأَيْ سْبَبْ بِخْلَافْ الزْنَى، رَاهُو يْخَلِّيهَا عُرْضَة لِلزْنَى، ولِّي يْعَرِّسْ بِمْرَا مْطَلْقَة هُوَّ قَاعِدْ يَزْنَى.<verse eid="MAT 5:32" /></para>
  <para style="s">الحِلْفَانْ</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />«وسْمَعْتُوا زَادَا إِنُّو تْقَالْ لِجْدُودْكُمْ: "مَا تِحْلِفْشْ وتِخْلِفْ، آمَا كَانْ وعِدْتْ الرَّبْ بْحَاجَة أُصْدُقْ فِيهَا". <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />آمَا آنَا نْقُولِلْكُمْ: مَا تِحْلْفُوشْ بِالكُلْ، لَا بِالسْمَاء عْلَى خَاطِرْهَا عَرْشْ اللَّهْ، <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />ولَا بِالأَرْضْ خَاطِرْهَا مَسْنِدْ سَاقِيهْ، ولَا بْأُورْشَلِيمْ خَاطِرْهَا مْدِينِةْ المَلِكْ العْظِيمْ. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />ومَا تِحْلِفْشْ بْرَاسِكْ، عْلَى خَاطِرْ مَا تْنَجَّمْشْ تْرُدْ حَتَّى شَعْرَة فِيهْ بِيضَة وَلَّا كَحْلَة. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />قُولُوا إِيْ إِذَا كَانْ تُقْصْدُوا إِيْ، ولَا كَانْ تُقْصْدُوا لَا، وكُلْ حَاجَة زَايْدَة عْلَى هَاذَا رَاهِي مِالشِّرِّيرْ.<verse eid="MAT 5:37" /></para>
  <para style="s">مَا تْرُدُّوشْ عَالشَّرْ بِالشَّرْ</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />«سْمَعْتُوا إِنُّو تْقَالْ: "العِينْ بِالعِينْ والسِّنَّة بِالسِّنَّة". <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />آمَا آنَا نْقُولِلْكُمْ: مَا تْرُدُّوشْ عَالشَّرْ بِالشَّرْ. آمَا كَانْ وَاحِدْ ضَرْبِكْ عْلَى خَدِّكْ اليْمِينْ دَوَّرْلُو خَدِّكْ الآخِرْ زَادَا. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />ولِّي يْحِبْ يِشْكِي بِيكْ بَاشْ يَاخُذْلِكْ جِبْتِكْ، كَمِّلْ خَلِّيلُو بَرْنُوسِكْ زَادَا. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />ولِّي يْخَلِّيكْ تِمْشِي مْعَاهْ كِيلُومَاتِرْ بِالسِّيفْ عْلِيكْ، إِمْشِي مْعَاهْ زُوزْ. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />الِّي يُطْلُبْ مِنْ عَنْدِكْ حَاجَة أَعْطِيهَالُو، ولِّي يْحِبْ يِتْسَلَّفْ مِنْ عَنْدِكْ مَا تْرُدُّوشْ.<verse eid="MAT 5:42" /></para>
  <para style="s">حِبُّوا أَعْدَائْكُمْ</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />«سْمَعْتُوا إِنُّو تْقَالْ: "حِبْ قْرِيبِكْ وإِكْرَهْ عْدُوكْ". <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />آمَا آنَا نْقُولِلْكُمْ: حِبُّوا أَعْدَائْكُمْ وبَارْكُوا الِّي يِلْعْنُوكُمْ وأَعْمْلُوا الخِيرْ لِلِّي يِكْرْهُوكُمْ وصَلِّيوْ لِلِّي يِضْطَهْدُوكُمْ، <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />وهَكَّا تْكُونُوا وْلَادْ بُوكُمْ الِّي فِي السْمَاء. عْلَى خَاطْرُو يْضَوِّي بْشَمْسُو عَالبَاهِينْ والخَايْبِينْ، ويَعْطِي المْطَرْ لِلصَّالْحِينْ والطَّالْحِينْ. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />شْنُوَّة أَجْرْكُمْ وَقْتِلِّي مَا تْحِبُّوا كَانْ الِّي يْحِبُّوكُمْ؟ يَاخِي مُشْ المَكَّاسَة يَعْمْلُوا نَفْسْ الشَّيْ؟ <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />ووَقْتِلِّي مَا تْسَلْمُوا كَانْ عْلَى خْوَاتْكُمْ، شْنِيَّة الحَاجَة الزَّايْدَة الِّي عْمَلْتُوهَا؟ يَاخِي مُشْ هَكَّا زَادَا يَعْمْلُوا الِّي مَاهُمْشْ يْهُودْ؟ <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />مَالَا كُونُوا كَامْلِينْ، كِيمَا بُوكُمْ الِّي فِي السْمَاء كَامِلْ.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">الصَّدْقَة</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />«رُدُّوا بَالْكُمْ تَعْمْلُوا الخِيرْ الِّي اللَّهْ يُطْلْبُو مِنْكُمْ بْنِيِّةْ إِنُّو النَّاسْ تْشُوفْكُمْ، مَا كَانِشْ مُشْ بِشْ يْكُونْ لِيكُمْ أَجْرْ عَنْدْ بُوكُمْ الِّي فِي السْمَاء. <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />وَقْتِلِّي تَعْطِي صَدْقَة، مَا تِبْدَاشْ ادُّورْ وتَحْكِي عْلِيهَا كِيمَا يَعْمْلُوا المُنَافْقِينْ فِي المْعَابِدْ والشْوَارَعْ بَاشْ النَّاسْ يِمْدْحُوهُمْ. نْقُلْكُمْ الحَقْ: رَاهُمْ هَكَّا خْذَاوْ أَجْرْهُمْ. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />آمَا إِنْتِ، كِي تَعْطِي صَدْقَة مَا تْخَلِّيشْ يِدِّكْ اليْسَارْ تَعْرِفْ آشْ عَمْلِتْ يِدِّكْ اليْمِينْ، <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />بَاشْ الصَّدْقَة مْتَاعِكْ تْكُونْ فِي السِّرْ، وبُوكْ الِّي يْرَى الِّي يْصِيرْ فِي السِّرْ يْجَازِيكْ.<verse eid="MAT 6:4" /></para>
  <para style="s">الصْلَاةْ</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />«ووَقْتِلِّي تْصَلِّيوْ، مَا تْكُونُوشْ كِي المُنَافْقِينْ، الِّي يْحِبُّوا يْصَلِّيوْ وَاقْفِينْ فِي المْعَابِدْ وفِي مَفْرَقْ الشْوَارَعْ الكْبِيرَة بَاشْ النَّاسْ تْشُوفْهُمْ. نْقُلْكُمْ الحَقْ: رَاهُمْ هَكَّا خْذَاوْ أَجْرْهُمْ. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />آمَا إِنْتِ، وَقْتِلِّي تْصَلِّي، أُدْخُلْ لْبِيتِكْ وسَكِّرْ بَابِكْ وصَلِّي لْبُوكْ الِّي مَا يْرَاهْ حَدْ. وبُوكْ الِّي يْرَى آشْ يْصِيرْ فِي السِّرْ يْجَازِيكْ.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />«وكِي تْصَلِّيوْ مَا تُقْعْدُوشْ تْعَاوْدُوا فِي الكْلَامْ بِالفَارَغْ كِيمَا الِّي مَاهُمْشْ يْهُودْ، الِّي مَاشِي فِي بَالْهُمْ إِنُّو اللَّهْ يِسْمَعْهُمْ وَقْتِلِّي يْكَثْرُوا مِالكْلَامْ. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />مَا تْكُونُوشْ كِيفْهُمْ، عْلَى خَاطِرْ بُوكُمْ يَعْرِفْ شْنُوَّة تِحْتَاجُوا قْبَلْ حَتَّى مَا تُطْلْبُوا مِنُّو.<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />«وهَاوْ كِيفَاشْ يِلْزِمْكُمْ تْصَلِّيوْ:</para>
  <para style="b" vid="MAT 6:9" />
  <para style="q1" vid="MAT 6:9">يَا بُونَا الِّي فِي السْمَاء،</para>
  <para style="q2" vid="MAT 6:9">خَلِّي إِسْمِكْ يِتْقَدِّسْ.<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />خَلِّي مَمْلَكْتِكْ تْجِي،</para>
  <para style="q2" vid="MAT 6:10">خَلِّي قَصْدِكْ يْصِيرْ عَالأَرْضْ كِيمَا صَايِرْ فِي السْمَاء.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />أَعْطِينَا اليُومْ الخُبْزْ الِّي يْكَفِّينَا.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />إِغْفْرِلْنَا ذْنُوبْنَا،</para>
  <para style="q2" vid="MAT 6:12">كِيمَا أَحْنَا نِغْفْرُوا لِلِّي يُغْلْطُوا فِينَا.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />مَا ادَّخَّلْنَاشْ فِي تَجْرْبَة،</para>
  <para style="q2" vid="MAT 6:13">آمَا نَجِّينَا مِالشِّرِيرْ.</para>
  <para style="q1" vid="MAT 6:13">عْلَى خَاطِرْ لِيكْ المُلْكْ والقُوَّة والمَجْدْ،</para>
  <para style="q2" vid="MAT 6:13">لِلْأَبَدْ. آمِينْ.<verse eid="MAT 6:13" /></para>
  <para style="b" />
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14" />«وكَانْ غْفَرْتُوا لِلنَّاسْ أَغْلَاطْهُمْ، يِغْفْرِلْكُمْ بُوكُمْ الِّي فِي السْمَاء أَغْلَاطْكُمْ زَادَا. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />آمَا كَانْ مَا تِغْفْرُوشْ لِلنَّاسْ أَغْلَاطْهُمْ، مَا يِغْفْرِلْكُمْشْ بُوكُمْ زَادَا أَغْلَاطْكُمْ.<verse eid="MAT 6:15" /></para>
  <para style="s">الصُّومْ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />«ووَقْتِلِّي تْصُومُوا، مَا تْخَلِّيوِشْ وْجُوهْكُمْ تْبَانْ حْزِينَة كِي المُنَافْقِينْ، الِّي يْكَشْبْرُوا وْجُوهْهُمْ بَاشْ يْوَرِّيوْ لِلنَّاسْ الِّي هُومَا صَايْمِينْ. نْقُلْكُمْ الحَقْ: الِّي يَعْمْلُوا هَكَّا خْذَاوْ أَجْرْهُمْ. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />آمَا إِنْتِ، وَقْتِلِّي تْصِيمْ حُطْ عِطْرْ وأَغْسِلْ وِجْهِكْ، <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />بَاشْ مَا تْظَهَّرْشْ لِلنَّاسْ الِّي إِنْتِ صْايِمْ، آمَا بُوكْ الِّي مَا يْرَاهْ حَدْ يْرَاكْ، وبُوكْ الِّي يْرَى آشْ يْصِيرْ فِي السِّرْ يْجَازِيكْ.<verse eid="MAT 6:18" /></para>
  <para style="s">إِكْنْزُوا كْنُوزْ فِي السْمَاء</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />«مَا تِكْنْزُوشْ لِرْوَاحْكُمْ كْنُوزْ فِي الأَرْضْ وِينْ يْنَجِّمْ يْفَسَّدْهَا السُّوسْ والصْدِيدْ، ووِينْ يْنَجْمُوا يَحْفْرُوا عْلِيهَا السُّرَّاقْ ويِسْرْقُوهَا. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />آمَا إِكْنْزُوا لِرْوَاحْكُمْ كْنُوزْ فِي السْمَاء، وِينْ لَا يْنَجِّمْ يْفَسَّدْهَا لَا السُّوسْ ولَا الصْدِيدْ، ولَا يْنَجْمُوا يَحْفْرُوا عْلِيهَا السُّرَّاقْ ويِسْرْقُوهَا. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />عْلَى خَاطِرْ وِينْ يْكُونْ كَنْزِكْ يْكُونْ قَلْبِكْ.<verse eid="MAT 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />«العِينْ هِيَّ فْنَارْ البْدَنْ. كَانْ عِينِكْ لَابَاسْ، بَدْنِكْ الكُلْ بِشْ يْكُونْ مْنَوِّرْ. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />آمَا إِذَا كَانْ عِينِكْ شِرِّيرَة، بَدْنِكْ الكُلْ بِشْ يْكُونْ مْظَلِّمْ. إِذَا كَانْ النُّورْ الِّي فِيكْ ظْلَامْ، مَالَا قَدَّاشْ قْوِيْ الظْلَامْ الِّي فِيكْ!<verse eid="MAT 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />«حَتَّى وَاحِدْ مَا يْنَجِّمْ يِخْدِمْ زُوزْ أَسْيَادْ، يَا إِمَّا بِشْ يِكْرَهْ وَاحِدْ ويْحِبْ الآخِرْ، وَلَّا بِشْ يْتَبَّعْ وَاحِدْ ويَحْقِرْ الآخِرْ. مَا تْنَجْمُوشْ تِخْدْمُوا اللَّهْ والفْلُوسْ مْعَ بْعَضْهُمْ.<verse eid="MAT 6:24" /></para>
  <para style="s">أَسْعَاوْ لْمَمْلَكْةْ اللَّهْ وصَلَاحُو</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />«هَاذَاكَا عْلَاشْ نْقُولِلْكُمْ: مَا تْعِيشُوشْ وإِنْتُومَا تْخَمُّوا كَانْ فِي شْنُوَّة بِشْ تَاكْلُوا وشْنُوَّة بِشْ تُشْرْبُوا، ولَا فِي شْنُوَّة بِشْ تِلْبْسُوا. يَاخِي هِيَّ الحَيَاةْ لِلْمَاكْلَة أَكَهَوْ، والبْدَنْ لِلِّبْسَة أَكَهَوْ؟ <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />شُوفُوا العْصَافِرْ كِيفَاشْ لَا تَزْرَعْ ولَا تَحْصِدْ ولَا تْحُطْ فِي مْخَازِنْ، وبُوكُمْ الِّي فِي السْمَاء يُرْزُقْهَا. يَاخِي مُشْ إِنْتُومَا أَهَمْ مِنْهَا إِبَّرْشَة؟ <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />وشْكُونْ فِيكُمْ الِّي كِي يْخَمِّمْ بْزَايِدْ يْنَجِّمْ يْزِيدْ فِي عُمْرُو حَتَّى سَاعَة وَحْدَة؟ <verse eid="MAT 6:27" /><verse number="28" style="v" sid="MAT 6:28" />وعْلَاشْ تْخَمُّوا بْزَايِدْ فِي اللِّبْسَة؟ ثَبْتُوا فِي نَوَّارْ بُوڨَرْعُونْ كِيفَاشْ يِكْبِرْ، وهُوَّ لَا يِتْعِبْ ولَا يَغْزِلْ. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />آمَا آنَا نْقُولِلْكُمْ: حَتَّى المَلِكْ سُلَيْمَانْ فِي عِزُّو مَا لْبِسْشْ كِيفْ وَحْدَة مِنْهُمْ! <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />إِذَا كَانْ الحْشِيشْ الِّي يِنْبِتْ اليُومْ وغُدْوَة يِتْرْمَى فِي النَّارْ اللَّهْ يْلَبْسُو كِيمَا هَكَّا، مُشْ إِنْتُومَا أَوْلَى إِنُّو يْلَبَّسْكُمْ يَلِّي إِيمَانْكُمْ ضْعِيفْ! <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />هَاذَاكَا عْلَاشْ مَا تُقْعْدُوشْ تْخَمُّوا وتْقُولُوا: "شْنُوَّة بِشْ نَاكْلُوا؟" وَلَّا "شْنُوَّة بِشْ نُشْرْبُوا؟" وَلَّا "شْنُوَّة بِشْ نِلْبْسُوا؟". <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />الحَاجَاتْ هَاذِي الكُلْ يِجْرِيوْ وْرَاهَا الِّي مَاهُمْشْ يْهُودْ، آمَا بُوكُمْ الِّي فِي السْمَاء يَعْرِفْ الِّي إِنْتُومَا تَحْتَاجُولْهَا. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />مَالَا أَسْعَاوْ فِي الأُوِّلْ لْمَمْلَكْةْ اللَّهْ وصَلَاحُو، والحَاجَاتْ هَاذِي الكُلْ تَوْ تِتْزَادِلْكُمْ. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />مَا تُقْعْدُوشْ تْخَمُّوا فِي غُدْوَة، خَلِّيوْ غُدْوَة كِيفْ يْجِي يْخَمِّمْ عْلَى رُوحُو. كُلْ نْهَارْ يِكْفِيهْ الشَّرْ الِّي فِيهْ.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">مَا تُحْكْمُوشْ عَالنَّاسْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />«مَا تُحْكْمُوشْ عَالنَّاسْ بَاشْ مَا يِتْحْكَمْشْ عْلِيكُمْ. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />كِيمَا تُحْكْمُوا يِتْحْكَمْ عْلِيكُمْ، وبِالكِيلْ الِّي تْكَيْلُوا بِيهْ يِتْكَيْلِلْكُمْ. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />عْلَاشْ القَشَّة الِّي فِي عِينْ خُوكْ تْشُوفْهَا، واللُّوحَة الِّي فِي عِينِكْ مَا تْشُوفْهَاشْ؟ <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />وَلَّا كِيفَاشْ تْقُولْ لْخُوكْ: "خَلِّينِي انَّحِّيلِكْ القَشَّة مِنْ عِينِكْ" وَقْتِلِّي عِينِكْ إِنْتِ فِيهَا لُوحَة؟ <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />يَا مُنَافِقْ! نَحِّي اللُّوحَة مِنْ عِينِكْ قْبَلْ، وَقْتْهَا تْوَلِّي تْشُوفْ بِالڨْدَا وتْنَجِّمْ تْنَحِّي القَشَّة مِنْ عِينْ خُوكْ.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />«مَا تَعْطِيوِشْ الحَاجَاتْ المُقَدْسَة لِلْكْلَابْ، ومَا تَرْمِيوِشْ الجُوهِرْ مْتَاعْكُمْ قُدَّامْ الحْلَالِفْ، بَاشْ مَا يْعَفْسُوهَاشْ بْسَاقِيهُمْ ويْدُورُوا عْلِيكُمْ ويِنْهْشُوكُمْ.<verse eid="MAT 7:6" /></para>
  <para style="s">أُطْلْبُوا تَاخْذُوا</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />«أُطْلْبُوا تَاخْذُوا، أَسْعَاوْ تَلْقَاوْ، دُقُّوا البَابْ يِتْحَلِّلْكُمْ. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />عْلَى خَاطِرْ الِّي يُطْلُبْ يَاخِذْ، ولِّي يَسْعَى يَلْقَى، ولِّي يْدُقْ البَابْ يِتْحَلُّو. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />شْكُونْ فِيكُمْ وَقْتِلِّي يُطْلْبُو وِلْدُو فِي الخُبْزْ يَعْطِيهْ حَجْرَة؟ <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />وَلَّا يُطْلْبُو فِي حُوتَة يَعْطِيهْ حْنَشْ؟ <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />إِذَا كَانْ وإِنْتُومَا أَشْرَارْ تَعْرْفُوا تَعْطِيوْ حَاجَاتْ بَاهْيَة لَوْلَادْكُمْ، مُشْ بِالأَوْلَى بُوكُمْ الِّي فِي السْمَاء يَعْطِي حَاجَاتْ بَاهْيَة لِلِّي يُطْلْبُوهْ؟<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />«كِيمَا تْحِبُّوا النَّاسْ يْعَامْلُوكُمْ، عَامْلُوهُمْ إِنْتُومَا زَادَا. وهَاذَا يْلَخَّصْ التَّعْلِيمْ الِّي فِي الشَّرِيعَة وكْتُبْ الأَنْبِيَاءْ.<verse eid="MAT 7:12" /></para>
  <para style="s">أُدْخْلُوا مِالبَابْ الضِّيِّقْ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />«أُدْخْلُوا مِالبَابْ الضِّيِّقْ. عْلَى خَاطِرْ بَابْ الهْلَاكْ وَاسَعْ وطْرِيقُو سَاهِلْ، وبَرْشَة الِّي يُدْخْلُوا مِنُّو. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />آمَا قَدَّاشُو ضِيِّقْ البَابْ وصْعِيبْ الطْرِيقْ الِّي يْهِزْ لِلْحَيَاةْ، وشْوَيَّة الِّي يَلْقَاوَهْ.<verse eid="MAT 7:14" /></para>
  <para style="s">مِنْ ثْمَارْهُمْ تَعْرْفُوهُمْ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />«رُدُّوا بَالْكُمْ مِالأَنْبِيَاءْ الكَذَّابِينْ، يْجِيوْكُمْ عَامْلِينْ رْوَاحْهُمْ عْلَالِشْ وهُومَا مِنْ دَاخِلْ ذْيُوبَة مِتْوَحْشَة. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />مِنْ ثْمَارْهُمْ تَعْرْفُوهُمْ. يَاخِي الشُّوكْ يْجِيبْ العْنِبْ، وَلَّا العِلِّيقْ يْجِيبْ الكَرْمُوسْ؟ <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />كِيفْ كِيفْ كُلْ شَجْرَة بَاهْيَة تْجِيبْ ثْمَرْ بَاهِي، وكُلْ شَجْرَة خَايْبَة تْجِيبْ ثْمَرْ خَايِبْ. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />مَا تْنَجَّمْشْ شَجْرَة بَاهْيَة تْجِيبْ ثْمَرْ خَايِبْ، ولَا شَجْرَة خَايْبَة تْجِيبْ ثْمَرْ بَاهِي. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />وكُلْ شَجْرَة مَا تْجِيبِشْ ثْمَرْ بَاهِي تِتْقَصْ وتِتْرْمَى فِي النَّارْ. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />هَاذَاكَا عْلَاشْ مِنْ ثْمَارْهُمْ تَعْرْفُوهُمْ.<verse eid="MAT 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />«مُشْ كُلْ حَدْ يْقُلِّي: "يَا رَبْ، يَا رَبْ" يُدْخُلْ مَمْلَكْةْ السْمَاوَاتْ، مَا يُدْخُلْ كَانْ الِّي يَعْمِلْ مَشِيئِةْ بَابَا الِّي فِي السْمَاء. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />نْهَارْ الحْسَابْ بَرْشَة نَاسْ بِشْ يْقُولُولِي: "يَا رَبْ، يَا رَبْ، مُشْ بْإِسْمِكْ تْنَبَّأْنَا؟ وبِإِسْمِكْ خَرَّجْنَا الشْوَاطِنْ؟ وبِإِسْمِكْ عْمَلْنَا بَرْشَة مُعْجْزَاتْ؟". <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />وآنَا بِشْ نْقُولِلْهُمْ: "آنَا عُمْرِي مَا عْرَفْتْكُمْ. إِبْعْدُوا عْلِيَّا يَلِّي تَعْمْلُوا فِي الشَّرْ!".<verse eid="MAT 7:23" /></para>
  <para style="s">إِبْنِيوْ عْلَى سَاسْ صْحِيحْ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />«الِّي يِسْمَعْ الِّي قُلْتُو هَاذَا الكُلْ ويْطَبْقُو، يْكُونْ كِيمَا رَاجِلْ حَكِيمْ بْنَى دَارُو عَالحْجَرْ. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />وصَبِّتْ المْطَرْ وجَاتْ الفَيْضَانَاتْ وهَبِّتْ الرِّيحْ بْقُوَّة عَالدَّارْ هَاذِيكَا، آمَا الدَّارْ مَا طَاحِتْشْ، عْلَى خَاطِرْ سَاسْهَا مِبْنِي عَالحْجَرْ. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />ولِّي يِسْمَعْ كْلَامِي هَاذَا ومَا يْطَبْقُوشْ، يْكُونْ كِيمَا رَاجِلْ بْلَا عْقَلْ بْنَى دَارُو عَالرْمَلْ. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />وصَبِّتْ المْطَرْ وجَاتْ الفَيْضَانَاتْ وهَبِّتْ الرِّيحْ عَالدَّارْ هَاذِيكَا، يَاخِي طَاحِتْ وتْهَدِّتْ الكُلْ».<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />وكِي كَمِّلْ يَسُوعْ الكْلَامْ هَاذَا، بْقَاوْ النَّاسْ بَاهْتِينْ مِنْ تَعْلِيمُو، <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />عْلَى خَاطْرُو كَانْ يْعَلِّمْ فِيهُمْ بْسُلْطَة، مُشْ كِيمَا عُلَمَاءْ الشَّرِيعَة مْتَاعْهُمْ.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">يَسُوعْ يِشْفِي مْرِيضْ بِالبْرَصْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />ووَقْتِلِّي هْبَطْ يَسُوعْ مِالجْبَلْ، تَبْعُوهْ بَرْشَة نَاسْ. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />وجَاهْ وَاحِدْ أَبْرِصْ، وسْجِدْلُو وقَالْ: «يَا سِيدِي، كَانْ تْحِبْ، تْنَجِّمْ اطَّهِّرْنِي مِالبْرَصْ». <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />يَاخِي مَدْ يَسُوعْ يِدُّو ومَسُّو وقَالُّو: «أَيْ نْحِبْ، أُطْهُرْ!» وبِالوَقْتْ تْنَحَّى البْرَصْ وطْهُرْ. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />وقَالُّو يَسُوعْ: «رُدْ بَالِكْ تْقُولْ لْحَدْ. آمَا إِمْشِي لِلْكَاهِنْ خَلِّيهْ يْشُوفِكْ. ومْبَعِّدْ أَعْطِي القُرْبَانْ الِّي وَصَّى بِيهْ مُوسَى، شْهَادَة لِيهُمْ إِنُّو البْرَصْ تْنَحَّى».<verse eid="MAT 8:4" /></para>
  <para style="s">يَسُوعْ يِشْفِي خْدِيمْ الضَّابِطْ الرُومَانِي</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />وكِي دْخَلْ يَسُوعْ لْكَفْرْنَاحُومْ،جَاهْ ضَابِطْ رُومَانِي ولَحْ عْلِيهْ <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />وقَالُّو: «يَا سِيدِي، عَنْدِي خْدِيمْ فِي الدَّارْ شَادِدْ الفَرْشْ وقَاعِدْ يِتْعَذَّبْ بَرْشَة ومَا يْنَجَّمْشْ يِتْحَرِّكْ». <verse eid="MAT 8:6" /><verse number="7" style="v" sid="MAT 8:7" />قَالُّو يَسُوعْ: «تَوْ نِمْشِي نِشْفِيهْ». <verse eid="MAT 8:7" /><verse number="8" style="v" sid="MAT 8:8" />يَاخِي جَاوْبُو الضَّابِطْ: «يَا سِيدِي، آنَا مَا نِسْتَاهِلْشْ إِنِّكْ تُدْخُلْ تَحْتْ سْقَفْ دَارِي، قُولْ كِلْمَة بَرْكْ تَوْ خْدِيمِي يَبْرَا. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />عْلَى خَاطِرْ آنَا زَادَا عَنْدِي شْكُونْ يُحْكُمْ فِيَّا وعَنْدِي عَسْكِرْ نُحْكُمْ فِيهُمْ، نْقُولْ لْوَاحِدْ "إِمْشِي!" يِمْشِي، ولْغِيرُو "إِيجَا!" يْجِي، ونْقُولْ لِخْدِيمِي "أَعْمِلْ هَاذَا!" يَعْمِلْ». <verse eid="MAT 8:9" /><verse number="10" style="v" sid="MAT 8:10" />وتْعَجِّبْ يَسُوعْ مِنْ كْلَامْ الضَّابِطْ، وقَالْ لِلِّي يْتَبْعُوا فِيهْ: «نْقُلْكُمْ الحَقْ، فِي بَنِي إِسْرَائِيلْ الكُلْ مَا لْقِيتْ حَدْ عَنْدُو إِيمَانْ عْظِيمْ كِيفْ إِيمَانُو. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />ونْزِيدْ نْقُولِلْكُمْ إِنُّو بَرْشَة نَاسْ بِشْ يْجِيوْ مِالشَّرْقْ ومِالغَرْبْ ويُقْعْدُوا يِتْعَشَّاوْ عْلَى نَفْسْ الطَّاوْلَة مْعَ إِبْرَاهِيمْ وإِسْحَاقْ ويَعْقُوبْ فِي مَمْلَكْةْ السْمَاوَاتْ، <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />آمَا وْلَادْ المَمْلْكَة بِشْ يِتِرْمَاوْ لْبَرَّة فِي الظْلَامْ، وِينْ بِشْ يْكُونْ البْكَاء والنْدَمْ». <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />وبَعْدْهَا قَالْ يَسُوعْ لِلضَّابِطْ الرُّومَانِي: «إِمْشِي لْدَارِكْ، وخَلِّي الِّي أَمَّنْتْ بِيهْ يْصِيرْ». وفِي لَحْظِتْهَا بْرَا الخْدِيمْ.<verse eid="MAT 8:13" /></para>
  <para style="s">يَسُوعْ يِشْفِي حْمَاةْ بُطْرُسْ</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />ودْخَلْ يَسُوعْ لْدَارْ بُطْرُسْ، يَلْقَى حْمَاةْ بُطْرُسْ شَادَّة الفَرْشْ وعَنْدْهَا السْخَانَة، <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />ومَسْهَا مِنْ يِدْهَا، يَاخِي تْنَحَّاتْ عْلِيهَا السْخَانَة، وقَامِتْ تِلْهَاتْ بِيهُمْ.<verse eid="MAT 8:15" /></para>
  <para style="s">يَسُوعْ يِشْفِي بَرْشَة نَاسْ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />وفِي العْشِيَّة إِمَّخِّرْ، جَابُولُو بَرْشَة نَاسْ سَاكْنِتْهُمْ الشْوَاطِنْ. وكَانْ يْخَرِّجْ فِي الأَرْوَاحْ الشِّرِّيرَة بْكِلْمَة وَحْدَة، وشْفَى المُرْضَى الكُلْ. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />وهَكَّا صَارْ الكْلَامْ الِّي قَالُو النَّبِيْ إِشَعْيَاءْ:</para>
  <para style="b" vid="MAT 8:17" />
  <para style="q1" vid="MAT 8:17">«نَحَّى وْجَايَعْنَا،</para>
  <para style="q2" vid="MAT 8:17">وهَزْ أَمْرَاضْنَا».<verse eid="MAT 8:17" /></para>
  <para style="s">كِيفَاشْ نْتَبْعُوا يَسُوعْ</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />وكِي شَافْ يَسُوعْ بَرْشَة نَاسْ دَايْرِينْ بِيهْ، عْطَى أَمْرْ لِتْلَامِذْتُو بَاشْ يْشُقُّوا لِلجِّيهَة الأُخْرَى مِالبُحَيْرَة. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />وجَاهْ وَاحِدْ مِنْ عُلَمَاءْ الشَّرِيعَة وقَالُّو: «يَا مُعَلِّمْ، فِينْ مَا تِمْشِي بِشْ نْتَبْعِكْ». <verse eid="MAT 8:19" /><verse number="20" style="v" sid="MAT 8:20" />جَاوْبُو يَسُوعْ: «الثْعَالِبْ عَنْدْهَا مْغَاغِرْ، والطْيُورْ عَنْدْهَا عْشَاشْ، آمَا إِبْنْ الإِنْسَانْ مَا عَنْدُو وِينْ يْكِنْ رَاسُو». <verse eid="MAT 8:20" /><verse number="21" style="v" sid="MAT 8:21" />وقَالُّو وَاحِدْ آخِرْ مِنْ تْلَامِذْتُو: «يَا سِيدِي، خَلِّينِي قْبَلْ كُلْ شَيْ نِمْشِي نِدْفِنْ بَابَا». <verse eid="MAT 8:21" /><verse number="22" style="v" sid="MAT 8:22" />جَاوْبُو يَسُوعْ : «تَبَّعْنِي وخَلِّي المُوتَى يِدْفْنُوا المُوتَى مْتَاعْهُمْ!»<verse eid="MAT 8:22" /></para>
  <para style="s">يَسُوعْ يْهَدِّي العَاصْفَة</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />وطْلَعْ يَسُوعْ فِي الفْلُوكَة وتَبْعُوهْ تْلَامِذْتُو. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />وهَبِّتْ رِيحْ قْوِيَّة حَتَّى لِينْ المُوجْ غَطَّى الفْلُوكَة. ويَسُوعْ كَانْ رَاقِدْ. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />ومْشَاوْلُو تْلَامِذْتُو وقَيْمُوهْ وقَالُولُو: «مَنَّعْنَا يَا سِيدْنَا، رَانَا قَاعْدِينْ نُغْرْقُوا!». <verse eid="MAT 8:25" /><verse number="26" style="v" sid="MAT 8:26" />قَالِلْهُمْ يَسُوعْ: «شْبِيكُمْ خَايْفِينْ يَلِّي إِيمَانْكُمْ ضْعِيفْ؟» وقَامْ سَكِّتْ الرِّيحْ والبُحَيْرَة، يَاخِي الدِّنْيَا هْدَاتْ. <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />والنَّاسْ تْعَجْبُوا وقَالُوا: «شْكُونُو هَاذَا الِّي حَتَّى مِالرِّيحْ والبُحَيْرَة يْطِيعُوهْ؟».<verse eid="MAT 8:27" /></para>
  <para style="s">يَسُوعْ يْخَرِّجْ أَرْوَاحْ شِرِّيرَة مِنْ زُوزْ رْجَالْ</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />وكِي وْصُلْ يَسُوعْ لِلجِّيهَة الأُخْرَى مْتَاعْ البُحَيْرَة ولِّي هِيَّ مَنْطَقْةْ الجَدْرِيِّينْ، عُرْضُوهْ زُوزْ رْجَالْ سَاكْنِتْهُمْ أَرْوَاحْ شِرِّيرَة خَارْجِينْ مِنْ بِينْ القْبُورَاتْ، وكَانُوا هَايْجِينْ بَرْشَة، لْدَرْجِةْ إِنُّو حَتَّى حَدْ مَا عَادْ يْنَجِّمْ يِتْعَدَّى مِنْ غَادِي. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />وبْدَاوْ يْصِيحُوا: «آشْ بِينَّا وبِينِكْ، يَا إِبْنْ اللَّهْ؟ يَاخِي جِيتْ لَهْنَا بَاشْ تْعَذَّبْنَا قْبَلْ الوَقْتْ؟». <verse eid="MAT 8:29" /><verse number="30" style="v" sid="MAT 8:30" />وكَانُوا فَمَّة بَرْشَة حْلَالِفْ سَارْحِينْ بْعِيدْ عْلِيهُمْ، <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />وتْشَحْتُوهْ الأَرْوَاحْ الشِّرِّيرَة وقَالُولُو: «كَانِكْ بِشْ اطَّرَدْنَا، أَبْعَثْنَا لِلْحْلَالِفْ!». <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />قَالِلْهُمْ: «إِمْشِيوْ». يَاخِي خَرْجُوا ودَخْلُوا فِي الحْلَالِفْ، وجْرَاوْ الحْلَالِفْ الكُلْ وتِرْمَاوْ مِنْ حَافِّةْ الجْبَلْ فِي البُحَيْرَة وغُرْقُوا. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />ولِّي كَانُوا سَارْحِينْ بِالحْلَالِفْ هَرْبُوا لِلْمْدِينَة وحْكَاوْ عْلَى كُلْ شَيْ، وعَلِّي صَارْ لِلزُّوزْ رْجَالْ الِّي كَانِتْ سَاكْنِتْهُمْ الشْوَاطِنْ. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />وإِذَا بِيهَا المْدِينَة الكُلْ خَرْجِتْ بَاشْ تْقَابِلْ يَسُوعْ. وكِي شَافُوهْ طَلْبُوا مِنُّو يُخْرِجْ مِنْ مْدِينِتْهُمْ.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">يَسُوعْ يِشْفِي مَشْلُولْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />ورْكِبْ يَسُوعْ فِي الفْلُوكَة وشَقْ البُحَيْرَة ورْجَعْ لِمْدِينْتُو. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />وجَابُولُو النَّاسْ وَاحِدْ مَشْلُولْ رَاقِدْ عْلَى فَرْشْ، وكِي شَافْ يَسُوعْ إِيمَانْهُمْ قَالْ لِلْمَشْلُولْ: «كُونْ مِطْمَانْ يَا وِلْدِي، رَاهِي ذْنُوبِكْ تْغِفْرِتْ». <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />وفَمَّة جْمَاعَة مِنْ عُلَمَاءْ الشَّرِيعَة قَالُوا فِي قْلُوبْهُمْ: «الرَّاجِلْ هَاذَا كْفَرْ». <verse eid="MAT 9:3" /><verse number="4" style="v" sid="MAT 9:4" />وعْرَفْ يَسُوعْ فَاشْ قَاعْدِينْ يْفَكْرُوا، وقَالِلْهُمْ: «عْلَاشْ تَقْرَاوْ فِي الشَّرْ فِي قْلُوبْكُمْ؟ <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />آنَاهُو الأَسْهِلْ؟ إِنُّو يِتْقَالْ: "ذْنُوبِكْ تْغِفْرِتْ"، وَلَّا يِتْقَالْ: "قُومْ وإِمْشِي"؟ <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />آمَا هَانِي بِشْ نْوَرِّيكُمْ الِّي إِبْنْ الإِنْسَانْ عَنْدُو السُّلْطَة فِي الأَرْضْ بَاشْ يِغْفِرْ الذْنُوبْ». يَاخِي قَالْ لِلْمَشْلُولْ: «قُومْ! هِزْ فَرْشِكْ ورَوَّحْ لْدَارِكْ». <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />يَاخِي قَامْ ورَوَّحْ لْدَارُو. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />ووَقْتِلِّي النَّاسْ شَافُوا الِّي صَارْ خَافُوا ومَجْدُوا اللَّهْ الِّي عْطَى سُلْطَة كِيفْ هَاذِي لِلْبَشَرْ.<verse eid="MAT 9:8" /></para>
  <para style="s">يَسُوعْ يِخْتَارْ مَتَّى</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />ومْشَى يَسُوعْ مِنْ غَادِي، وفِي الطْرِيقْ شَافْ رَاجِلْ إِسْمُو مَتَّى قَاعِدْ فِي البْلَاصَة الِّي يْلِمُّوا فِيهَا الضَّرَايِبْ. وقَالُّو: «تَبَّعْنِي». يَاخِي قَامْ وتَبْعُو.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />وَقْتِلِّي كَانْ يَسُوعْ قَاعِدْ ويَاكِلْ فِي دَارْ مَتَّى، جَاوْ بَرْشَة مَكَّاسَة ومُذْنْبِينْ وقَعْدُوا مْعَ يَسُوعْ وتْلَامِذْتُو. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />وكِي شَافُوا الفِرِّيسِيِّينْ هَاذَا قَالُوا لِتْلَامِذْتُو: «عْلَاشْ المُعَلِّمْ مْتَاعْكُمْ يَاكِلْ مْعَ المَكَّاسَة والمُذْنْبِينْ؟» <verse eid="MAT 9:11" /><verse number="12" style="v" sid="MAT 9:12" />وكِي سْمَعْ يَسُوعْ كْلَامْهُمْ، قَالْ: «المُرْضَى هُومَا الِّي يَحْتَاجُوا لِطْبِيبْ مُشْ الصْحَاحْ. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />بَرَّاوْ اتْعَلْمُوا آشْ مَعْنَاهَا الآيَة هَاذِي: "نْحِبْ رَحْمَة مُشْ ذْبِيحَة". وآنَا مَا جِيتِشْ نِدْعِي فِي الصَّالْحِينْ لِلتُّوبَة آمَا جِيتْ لِلْمُذْنْبِينْ».<verse eid="MAT 9:13" /></para>
  <para style="s">الجْدِيدْ والقْدِيمْ</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />وبَعْدْهَا جَاوْ تْلَامِذْةْ يُوحَنَّا لْيَسُوعْ وقَالُوا: «عْلَاشْ أَحْنَا والفِرِّيسِيِّينْ نْصُومُوا بَرْشَة، وتْلَامِذْتِكْ مَا يْصُومُوشْ؟». <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />قَالِلْهُمْ يَسُوعْ: «يَاخِي يْنَجْمُوا إِمَّالِي العِرْسْ يَحْزْنُوا والعْرُوسْ مَزَّالْ بِينَاتْهُمْ؟ آمَا تَوْ يْجِي نْهَارْ ويِتْنَحَّى العْرُوسْ مِنْ بَحْذَاهُمْ، ووَقْتْهَا تَوْ يْصُومُوا. <verse eid="MAT 9:15" /><verse number="16" style="v" sid="MAT 9:16" />مَا فَمَّة حَتَّى حَدْ يْرَقَّعْ لِبْسَة قْدِيمَة بْطَرْفْ قْمَاشْ جْدِيدْ، عْلَى خَاطِرْ القْمَاشْ الجْدِيدْ بِشْ يُشْرُبْ ويِجْبِدْ مْعَاهْ القْمَاشْ القْدِيمْ، وتْوَلِّي التَّقْطِيعَة أَتْعَسْ مِنْ قْبَلْ. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />ومَا فَمَّة حَتَّى حَدْ يْحُطْ شْرَابْ جْدِيدْ فِي ڨِرْبَة قْدِيمَة، مَا كَانِشْ الڨِرْبَة تِتْفْلَقْ والشْرَابْ يِتْبَزَّعْ والڨِرْبَة تْوَلِّي مَا عَادِشْ تُصْلُحْ. آمَا يْحُطُّوا الشْرَابْ الجْدِيدْ فِي ڨِرْبَة جْدِيدَة وهَكَّا يِسْتَحْفْظُوا عْلِيهُمْ الإِثْنِينْ».<verse eid="MAT 9:17" /></para>
  <para style="s">يَسُوعْ يِشْفِي مْرَا مْرِيضَة ويْقَيِّمْ بْنَيَّة مِالمُوتْ</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />وفِي الوَقْتْ الِّي كَانْ يَسُوعْ يْكَلِّمْ فِيهُمْ، جَاء رَئِيسْ مَعْبِدْ اليْهُودْ وسْجِدْ قُدَّامُو وقَالْ: «بِنْتِي مَزَّالِتْ كِي مَاتِتْ. آمَا إِيجَا حُطْ عْلِيهَا يِدِّكْ تَوْ تَحْيَا». <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />يَاخِي قَامْ يَسُوعْ هُوَّ وتْلَامِذْتُو وتَبْعُوهْ.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />وكَانِتْ فَمَّة مْرَا مْرِيضَة بْنَزِيفْ دَمْ مِنْ أَثْنَاشِنْ سْنَة، جَاتْ مِنْ وْرَاهْ ومَسِّتْ طَرْفْ حْوَايْجُو مِاللُّوطَة، <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />عْلَى خَاطِرْهَا قَالِتْ فِي قَلْبْهَا: «كَانْ نُوصِلْ نْمِسْلُو حْوَايْجُو بَرْكْ تَوْ نَبْرَا». <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />وتْلَفِّتْ يَسُوعْ وشَافْهَا، يَاخِي قَالْ: «كُونْ مِطْمَانَة يَا بِنْتِي، إِيمَانِكْ شْفَاكْ». وبِالوَقْتْ المْرَا بْرَاتْ.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />وكِي وْصُلْ يَسُوعْ لْدَارْ رَئِيسْ مَعْبِدْ اليْهُودْ، وشَافْ النَّدَّابَا والنَّاسْ دَاخْلِينْ بْعَضْهُمْ، <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />قَالْ: «إِمْشِيوْ عْلَى رْوَاحْكُمْ! البْنَيَّة مَا مَاتِتْشْ، آمَا رَاهِي رَاقْدَة». يَاخِي ضَحْكُوا عْلِيهْ. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />وبَعْدْمَا خَرْجُوا العْبَادْ، دْخَلْ وشَدْ البْنَيَّة مِنْ يِدْهَا يَاخِي قَامِتْ. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />والخْبَرْ هَاذَا تِنْشَرْ فِي المَنْطْقَة هَاذِيكَا الكُلْ.<verse eid="MAT 9:26" /></para>
  <para style="s">يَسُوعْ يِشْفِي زُوزْ عِمْيَانْ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />وكِي مْشَى يَسُوعْ مِنْ غَادِي، تَبْعُوهْ زُوزْ رْجَالْ عِمْيَانْ وهُومَا يْصِيحُوا ويْعَيْطُوا: «يَا وِلْدْ دَاوِدْ أَرْحَمْنَا!». <verse eid="MAT 9:27" /><verse number="28" style="v" sid="MAT 9:28" />ووَقْتِلِّي دْخَلْ لِلدَّارْ، جَاوَهْ العِمْيَانْ الزُّوزْ، يَاخِي سْإِلْهُمْ يَسُوعْ: «تَمْنُوا الِّي آنَا قَادِرْ نَعْمِلْ هَاذَا؟». قَالُولُو: «أَيْ نْعَمْ يَا سِيدْنَا!». <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />وَلَّى يَسُوعْ مَسْهُمْ مِنْ عِينِيهُمْ وقَالْ: «عْلَى قَدْ إِيمَانْكُمْ تَاخْذُوا». <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />يَاخِي عِينِيهُمْ تْحَلِّتْ. ونَبَّهْ عْلِيهُمْ يَسُوعْ وقَالِلْهُمْ: «رُدُّوا بَالْكُمْ لَا وَاحِدْ يَعْرِفْ!». <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />آمَا هُومَا خَرْجُوا وبْدَاوْ يَحْكِيوْ عْلِيهْ فِي المَنْطْقَة هَاذِيكَا الكُلْ.<verse eid="MAT 9:31" /></para>
  <para style="s">يَسُوعْ يِشْفِي بَكُّوشْ</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />ودُوبْ مَا خَرْجُوا الزُّوزْ رْجَالْ، جَاوْ جْمَاعَة وجَابُولُو وَاحِدْ بَكُّوشْ، سَاكْنُو شِيطَانْ. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />وكِي خَرِّجْ يَسُوعْ الشِّيطَانْ، البَكُّوشْ وَلَّى يِتْكَلِّمْ. والنَّاسْ بْقَاوْ بَاهْتِينْ، وقَالُوا: «عْمُرْنَا مَا شُفْنَا حَاجَة كِيفْ هَاذِي فِي إِسْرَائِيلْ!». <verse eid="MAT 9:33" /><verse number="34" style="v" sid="MAT 9:34" />آمَا الفِرِّيسِيِّينْ قَالُوا: «يْخَرِّجْ فِي الشْوَاطِنْ بْقُوِّةْ رَئِيسْ الشْوَاطِنْ».<verse eid="MAT 9:34" /></para>
  <para style="s">الصَّابَة بَرْشَة، آمَا الخَدَّامَة شْوَيَّة</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />وكَانْ يَسُوعْ يْدُورْ مِنْ مْدِينَة لِمْدِينَة ومِنْ قَرْيَة لْقَرْيَة، يْعَلِّمْ فِي مْعَابِدْ اليْهُودْ ويْنَادِي بِبْشَارِةْ مَمْلَكْةْ اللَّهْ، ويِشْفِي فِي النَّاسْ مِنْ كُلْ مَرْضْ وعِلَّة.<verse eid="MAT 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 9:36" />وكِي شَافْ النَّاسْ حَنْ عْلِيهُمْ، عْلَى خَاطِرْهُمْ كَانُوا مِتْعَذْبِينْ ومْشَرْدِينْ كِيفْ الغْنَمْ الِّي مَا عَنْدْهَا شْكُونْ يِسْرَحْ بِيهَا. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />وقَالْ لِتْلَامِذْتُو: «الصَّابَة بَرْشَة، آمَا الخَدَّامَة شْوَيَّة. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />مَالَا أُطْلْبُوا مِنْ مُولَى الصَّابَة يَبْعَثْ خَدَّامَة لْصَابْتُو».<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">يَسُوعْ يَبْعَثْ التْلَامْذَة الأَثْنَاشْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />ومْبَعِّدْ عَيِّطْ لِلْأَثْنَاشِنْ تِلْمِيذْ، وعْطَاهُمْ سُلْطَة بَاشْ يْخَرْجُوا الأَرْوَاحْ الشِّرِّيرَة، ويِشْفِيوْ النَّاسْ مِنْ كُلْ مَرْضْ وعِلَّة. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />وهَاذِي أَسَامِي الأَثْنَاشِنْ رَسُولْ: الأُولَانِي إِسْمُو سِمْعَانْ الِّي يْعَيْطُولُو بُطْرُسْ، وخُوهْ أَنْدَرَاوُسْ، ويَعْقُوبْ وِلْدْ زَبَدِي وخُوهْ يُوحَنَّا، <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />وفِيلِۑُّسْ وبَرْثُلْمَاوُسْ، وتُومَا ومَتَّى المَكَّاسْ، ويَعْقُوبْ وِلْدْ حَلْفَى وتَدَّاوُسْ، <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />وسِمْعَانْ القَانَوِي، ويَهُوذَا الإِسْخَرْيُوطِي الِّي خَانْ يَسُوعْ.<verse eid="MAT 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />بْعَثْ يَسُوعْ الأَثْنَاشْ هَاذُومَا ووَصَّاهُمْ: «مَا تِمْشِيوِشْ لِلِّي مَاهُمْشْ يْهُودْ ومَا تُدْخْلُوشْ لْحَتَّى مْدِينَة فِي مَنْطَقْةْ السَّامْرَة. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />آمَا بِالأَوْلَى إِمْشِيوْ لِغْنَمْ بَنِي إِسْرَائِيلْ الضَّايْعَة. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />وإِنْتُومَا مَاشِينْ بَشْرُوا وقُولُوا: "رَاهِي مَمْلَكْةْ السْمَاوَاتْ قُرْبِتْ". <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />إِشْفِيوْ المُرْضَى، قَيْمُوا المُوتَى، خَلِّيوْ الِّي عَنْدْهُمْ البْرَصْ يُطْهْرُوا، خَرّْجُوا الشْوَاطِنْ. إِنْتُومَا خْذِيتُوا بْلَاشْ، أَعْطِيوْ بْلَاشْ.<verse eid="MAT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 10:9" />«مَا تْهِزُّوشْ مْعَاكُمْ فْلُوسْ سِوَى كَانِتْ مِنْ ذْهَبْ وَلَّا فُضَّة وَلَّا نْحَاسْ. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />ولَا تْهِزُّوا مْعَاكُمْ زَادْ لِلطْرِيقْ ولَا لِبْسَة ولَا صَنْدَالْ زَايْدِينْ ولَا عْصَا، عْلَى خَاطِرْ الِّي يِخْدِمْ مِنْ حَقُّو يَعْطِيوَهْ يَاكِلْ. <verse eid="MAT 10:10" /><verse number="11" style="v" sid="MAT 10:11" />وأَيْ مْدِينَة وَلَّا دَشْرَة تُدْخْلُوهَا، لَوْجُوا فِيهَا عْلَى شْكُونْ يِسْتَاهِلْ تُدْخْلُوا لْدَارُو، وأُسْكْنُوا عَنْدُو حَتَّى لِينْ تِمْشِيوْ. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />وكِي تُدْخْلُوا لْدَارْ سَلْمُوا عَالنَّاسْ الِّي فِيهَا. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />وإِذَا كَانْ إِمَّالِي الدَّارْ يِسْتَاهْلُوا، سَلَامْكُمْ يْبَارِكْهُمْ، وإِذَا كَانْهُمْ مَا يِسْتَاهْلُوشْ سَلَامْكُمْ يِرْجْعِلْكُمْ. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />وأَيْ وَاحِدْ مَا يِقْبِلْكُمْشْ ومَا يِسْمْعِلْكُمْشْ، أُخْرْجُوا مِالدَّارْ وَلَّا المْدِينَة هَاذِيكَا، وأُنْفْضُوا التْرَابْ مِنْ سَاقِيكُمْ. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />نْقُلْكُمْ الحَقْ: فِي نْهَارْ الحْسَابْ، مْدِينِةْ سَدُومْ وعَمُورَة بِشْ يْكُونْ حْسَابْهُمْ أَخَفْ مِالمْدِينَة هَاذِيكَا.<verse eid="MAT 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />«هَانِي بِشْ نِبْعَثْكُمْ كِيمَا الغْنَمْ فِي وِسْطْ الذْيُوبَة، مَالَا كُونُوا فَايْقِينْ كِي الأَفَاعِي، ومُسَالْمِينْ كِي الحْمَامْ. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />ورُدُّوا بَالْكُمْ مِالنَّاسْ، عْلَى خَاطِرْهُمْ بِشْ يْهِزُّوكُمْ لِلْمْحَاكِمْ، ويِجْلْدُوكُمْ فِي مْعَابِدْ اليْهُودْ، <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />ويْكَرْكْرُوكُمْ لِلْحُكَّامْ والمُلُوكْ عْلَى خَاطْرِي، وهَاذَا بِشْ يْكُونْ شْهَادَة قُدَّامْ اليْهُودْ والمُشْ يْهُودْ. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />ووَقْتِلِّي يْشِدُّوكُمْ مَا تْخَمُّوشْ فِي كِيفَاشْ بِشْ تَحْكِيوْ وَلَّا شْنُوَّة بِشْ تْقُولُوا، عْلَى خَاطِرْ فِي الوَقْتْ هَاذَاكَا بِشْ يِتْعْطَالْكُمْ الكْلَامْ الِّي تْقُولُوهْ. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />عْلَى خَاطِرْ مُشْ إِنْتُومَا الِّي تِتْكَلْمُوا، آمَا رُوحْ بُوكُمْ هُوَّ الِّي يِتْكَلِّمْ فِيكُمْ. <verse eid="MAT 10:20" /><verse number="21" style="v" sid="MAT 10:21" />والخُو يْهِزْ خُوهْ لِلْمُوتْ، والبُو يْهِزْ وِلْدُو، والوْلَادْ يْدُورُوا عْلَى وَالْدِيهُمْ ويُقْتْلُوهُمْ، <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />والنَّاسْ الكُلْ بِشْ تِكْرَهْكُمْ عْلَى خَاطِرْ إِسْمِي. آمَا الِّي يِثْبِتْ لِلِّخِّرْ يِنْجَى. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />وإِذَا اضْطَهْدُوكُمْ فِي مْدِينَة أُهْرْبُوا لِمْدِينَة أُخْرَى، نْقُلْكُمْ الحَقْ: قْبَلْ مَا تْكَمْلُوا خِدْمِتْكُمْ فِي مْدُنْ بَنِي إِسْرَائِيلْ الكُلْ يْجِي إِبْنْ الإِنْسَانْ.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />«التِّلْمِيذْ مُشْ أَعْظَمْ مِالمُعَلِّمْ مْتَاعُو والخْدِيمْ مُشْ أَعْظَمْ مِنْ سِيدُو. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />يِكْفِي التِّلْمِيذْ يْكُونْ كِيفْ المُعَلِّمْ مْتَاعُو والخْدِيمْ يْكُونْ كِيمَا سِيدُو. إِذَا كَانْ كْبِيرْ العِيْلَة سَمَّاوَهْ بَعْلَزَبُولْ، مَالَا بْقِيِّةْ العَايْلَة آشْ بِشْ يْقُولُوا عْلِيهُمْ؟<verse eid="MAT 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />«مَا تْخَافُوشْ مِنْهُمْ. عْلَى خَاطِرْ المَسْتُورْ بِشْ يِتْكْشِفْ، والمْخُبِّي بِشْ يِتْعْرَفْ. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />ولِّي نْقُولْهُولْكُمْ فِي الظْلَامْ، قُولُوهْ فِي النُّورْ. ولِّي تْقَالِلْكُمْ فِي وِذْنِيكُمْ نَادِيوْ بِيهْ مِنْ فُوقْ السْطُوحَاتْ. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />مَا تْخَافُوشْ مِلِّي يْنَجْمُوا يُقْتْلُوا البْدَنْ آمَا مَا يْنَجْمُوشْ يُقْتْلُوا الرُّوحْ، بِالعَكْسْ خَافُوا مِلِّي يَقْدِرْ يِهْلِكْ البْدَنْ والرُّوحْ فِي جْهَنِّمْ.<verse eid="MAT 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 10:29" />«يَاخِي مُشْ زُوزْ عْصَافِرْ يِتْبَاعُوا بِفْرَنْكْ؟ ورَغْمْ هَاذَاكَا مَا يْطِيحْ حَتَّى وَاحِدْ مِنْهُمْ عَالأَرْضْ ويْمُوتْ مِنْ غِيرْ عِلْمْ بُوكُمْ الِّي فِي السْمَاء. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />آمَا إِنْتُومَا حَتَّى شْعَرْ رْيُوسْكُمْ مَحْسُوبْ بْكُلُّو. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />مَالَا مَا تْخَافُوشْ، رَاكُمْ إِنْتُومَا خِيرْ مِنْ بَرْشَة عْصَافِرْ!<verse eid="MAT 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />«الِّي يِسْتَعْرِفْ بِيَّا قُدَّامْ النَّاسْ نِسْتَعْرِفْ بِيهْ قُدَّامْ بَابَا الِّي فِي السْمَاء. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />ولِّي يُنْكُرْنِي قُدَّامْ النَّاسْ، نُنْكُرُو قُدَّامْ بَابَا الِّي فِي السْمَاء.<verse eid="MAT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />«مَا يِمْشِيشْ فِي بَالْكُمْ الِّي آنَا جِيتْ بَاشْ نْجِيبْ سَلَامْ لِلْأَرْضْ. مَا جِيتِشْ بَاشْ نْجِيبْ سَلَامْ آمَا بَاشْ نْجِيبْ سِيفْ. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />جِيتْ بَاشْ يْوَلِّي الوْلِدْ ضِدْ بُوهْ، والبْنَيَّة ضِدْ أُمْهَا، والكِنَّة ضِدْ حْمَاتْهَا. <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />وهَكَّا يْوَلِّيوْ أَعْدَاءْ الإِنْسَانْ امَّالِيهْ. <verse eid="MAT 10:36" /><verse number="37" style="v" sid="MAT 10:37" />ولِّي يْحِبْ بُوهْ وَلَّا أُمُّو أَكْثِرْ مِنِّي مَا يِسْتَاهِلْنِيشْ. ولِّي يْحِبْ وِلْدُو وَلَّا بِنْتُو أَكْثِرْ مِنِّي مَا يِسْتَاهِلْنِيشْ. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />ولِّي مَا يْهِزِّشْ صَلِيبُو ويْتَبَّعْنِي، مَا يِسْتَاهِلْنِيشْ. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />الِّي يْحِبْ يْمَنَّعْ حْيَاتُو يَخْسَرْهَا، ولِّي يَخْسَرْ حْيَاتُو عْلَى خَاطْرِي يِرْبَحْهَا.<verse eid="MAT 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />«الِّي يِقْبِلْكُمْ يِقْبِلْنِي، ولِّي يِقْبِلْنِي يِقْبِلْ الِّي بْعَثْنِي. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />الِّي يِقْبِلْ نَبِيْ عْلَى خَاطْرُو نَبِيْ يَاخِذْ أَجْرْ كِيفْ أَجْرْ النَّبِيْ. ولِّي يِقْبِلْ رَاجِلْ صَالَحْ عْلَى خَاطْرُو رَاجِلْ صَالَحْ يَاخِذْ أَجْرْ كِيفْ أَجْرْ الرَّاجِلْ الصَّالَحْ. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />ولِّي يَعْطِي لْوَاحِدْ مِالصْغَارْ هَاذُومَا حَتَّى كَاسْ مَاء بَارِدْ عْلَى خَاطْرُو تِلْمِيذِي، نْقُلْكُمْ الحَقْ، أَجْرُو عُمْرُو مَا يْضِيعْ».<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">يُوحَنَّا يَبْعَثْ شْكُونْ يِسْإِلْ يَسُوعْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />وبَعْدْمَا كَمِّلْ يَسُوعْ وَصَّى تْلَامِذْتُو الأَثْنَاشْ، مْشَى مِالبْلَاصَة هَاذِيكَا بَاشْ يْعَلِّمْ ويْبَشِّرْ فِي المْدُنْ الأُخْرَى.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />وسْمَعْ يُوحَنَّا وهُوَّ فِي الحَبْسْ بِلِّي يَعْمِلْ فِيهْ المَسِيحْ، يَاخِي بْعَثْلُو جْمَاعَة مِنْ تْلَامِذْتُو، <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />بَاشْ يِسْأْلُوهْ: «إِنْتِ هُوَّ الِّي نِسْتَنَّاوْ فِيهْ بَاشْ يْجِي، وَلَّا نِسْتَنَّاوْ وَاحِدْ آخِرْ؟» <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />جَاوِبْهُمْ يَسُوعْ: «إِمْشِيوْ خَبْرُوا يُوحَنَّا بِلِّي تْشُوفُوا فِيهْ وتِسْمْعُوا فِيهْ، <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />العِمْيَانْ يْشُوفُوا، والعَايْبِينْ يِمْشِيوْ، ولِّي عَنْدْهُمْ البْرَصْ يَطْهْرُوا، والطْرُشْ يِسْمْعُوا، والمُوتَى يْقُومُوا، والمْسَاكِنْ تُوصِلْهُمْ البْشَارَة. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />وصَحَّة لِيهْ الِّي مَا يْشُكِّشْ فِيَّا!».<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />وَقْتِلِّي مْشَاوْ تْلَامِذْةْ يُوحَنَّا، بْدَا يَسُوعْ يَحْكِي لِلنَّاسْ عْلَى يُوحَنَّا وقَالْ: «وَقْتِلِّي خْرَجْتُوا لِلْخْلَاء، شْنُوَّة خْرَجْتُوا بَاشْ تْشُوفُوا؟ قَصْبَة يْحَرِّكْ فِيهَا الرِّيحْ؟ <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />شْنُوَّة خْرَجْتُوا بَاشْ تْشُوفُوا؟ رَاجِلْ لَابِسْ لِبْسَة مِذْخْمَة؟ الِّي يِلْبْسُوا اللِّبْسَة المِذْخْمَة هُومَا فِي قْصُورْ المُلُوكْ! <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />قُولُولِي مَالَا شْنُوَّة خْرَجْتُوا بَاشْ تْشُوفُوا؟ نَبِيْ؟ إِيْ نْعَمْ، وآنَا نْقُولِلْكُمْ إِنُّو أَعْظِمْ مِنْ نَبِيْ. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />هَاذَا هُوَّ الِّي تِكْتِبّْ عْلِيهْ فِي الكْتُبْ المُقَدْسَة:</para>
  <para style="b" vid="MAT 11:10" />
  <para style="q1" vid="MAT 11:10">"هَانِي بِشْ نِبْعَثْ قُدَّامِكْ رَسُولِي،</para>
  <para style="q2" vid="MAT 11:10">بَاشْ يْحَضِّرْلِكْ الطْرِيقْ".<verse eid="MAT 11:10" /></para>
  <para style="b" />
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11" />«نْقُلْكُمْ الحَقْ: فِي البَشَرْ الكُلْ، عُمْرُو مَا تُوجِدْ وَاحِدْ أَعْظَمْ مِنْ يُوحَنَّا الِّي يْعَمِّدْ. آمَا رَاهُو أَصْغِرْ وَاحِدْ فِي مَمْلِكْةْ السْمَاوَاتْ أَعْظَمْ مِنُّو. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />مِلِّي بْدَا يُوحَنَّا الِّي يْعَمِّدْ خِدْمْتُو لْتَوَّا والنَّاسْ يَسْعَاوْ بَاشْ يُدْخْلُوا مَمْلَكْةْ السْمَاوَاتْ، ولِّي قَاعْدِينْ يَسْعَاوْ يُدْخْلُوهَا بِالشْقَى. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />والأَنْبِيَاءْ الكُلْ والتَّوْرَاةْ تْنَبْؤُوا عْلِيهَا حَتَّى لِينْ جَاء يُوحَنَّا. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />وكَانْ تْحِبُّوا تْصَدْقُوا كْلَامْهُمْ، أَعْرْفُوا الِّي يُوَحَنَّا هُوَّ إِيلِيَّا الِّي تِسْتَنَّاوْ فِيهْ يْجِي. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />الِّي عَنْدُو وِذْنِينْ تِسْمَعْ، خَلِّيهْ يِسْمَعْ!<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />«بِشْكُونْ نْشَبَّهْ الجِيلْ هَاذَا؟ هُومَا كِيفْ أَوْلَادْ قَاعْدِينْ فِي السُّوقْ يْعَيْطُوا لِصْحَابْهُمْ ويْقُولُوا:<verse eid="MAT 11:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />"ضْرَبْنَالْكُمْ الزُّكْرَة مَا شْطَحْتُوا،</para>
  <para style="q2" vid="MAT 11:17">نْدِبْنَالْكُمْ مَا نَوَّحْتُوا".<verse eid="MAT 11:17" /></para>
  <para style="b" />
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18" />«جَاء يُوحَنَّا لَا يَاكِلْ لَا يُشْرُبْ قُلْتُوا: "سَاكْنُو شِيطَانْ". <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />جَاء إِبْنْ الإِنْسَانْ يَاكِلْ ويُشْرُبْ قُلْتُوا عْلِيهْ وَكَّالْ وسُوكَارْجِي وصَاحِبْ المَكَّاسَة والمُذْنْبِينْ. آمَا الحِكْمَة الحَقِيقِيَّة يِشْهْدُولْهَا أَفْعَالْهَا».<verse eid="MAT 11:19" /></para>
  <para style="s">يَا وِيلْهُمْ المْدُنْ الِّي مَا تَابُوشْ</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />وبْدَا يَسُوعْ يْلُومْ فِي المْدُنْ الِّي عْمَلْ فِيهَا أَكْثِرْ مُعْجْزَاتْ ونَاسْهَا مَا تَابُوشْ، <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />وقَالْ: «يَا وِيلِكْ يَا كُورَزِينْ! يَا وِيلِكْ يَا بَيْتْ صَيْدَا! لَوْ كَانْ المُعْجْزَاتْ الِّي تْعَمْلِتْ فِي وِسْطْكُمْ تْعَمْلِتْ فِي صُورْ وصَيْدَا، رَاهُو نَاسْهُمْ تَابُوا ولِبْسُوا خْيِشْ وحَطُّوا الرْمَادْ عْلَى رْيُوسْهُمْ. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />آمَا آنَا نْقُلْكُمْ: فِي نْهَارْ الحْسَابْ، صُورْ وصَيْدَا بِشْ يْكُونْ حْسَابْهُمْ أَخَفْ مِنْكُمْ. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />وإِنْتِ يَا كَفْرْنَاحُومْ! تْحِبْ تِطْلَعْ لِلسْمَاء؟ لَا، رَاكْ بِشْ تَهْبِطْ لِلْهَاوِيَة. لَوْ كَانْ المُعْجْزَاتْ الِّي تْعَمْلِتْ فِيكْ تْعَمْلِتْ فِي مْدِينِةْ سَدُومْ، رَاهِي قَعْدِتْ مَوْجُودَة لِلْيُومْ. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />آمَا نْقُلْكُمْ: نْهَارْ الحْسَابْ حَالِةْ سَدُومْ بِشْ تْكُونْ أَهْوِنْ مِنْ حَالْتِكْ».<verse eid="MAT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />تْكَلِّمْ يَسُوعْ فِي الوَقْتْ هَاذَاكَا وقَالْ: «نِحْمْدِكْ يَا بَابَا، يَا رَبْ السْمَاء والأَرْضْ، عْلَى خَاطْرِكْ خَبِّيتْ الأُمُورْ هَاذِي عَالحُكَمَاءْ والعُلَمَاءْ وكْشِفْتْهَا لِلصْغَارْ. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />إِيْ نْعَمْ، يَا بَابَا، هَكَّا إِنْتِ حَبِّيتْ.<verse eid="MAT 11:26" /></para>
  <para style="s">إِيجَاوْنِي وآنَا نْرَتَّحْكُمْ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />«بَابَا عْطَانِي فِي يِدِّي كُلْ شَيْ. وحَتَّى وَاحِدْ مَا يَعْرِفْ الإِبْنْ كَانْ الآبْ، وحَتَّى وَاحِدْ مَا يَعْرِفْ الآبْ كَانْ الإِبْنْ وأَيْ وَاحِدْ حَبْ الإِبْنْ يْعَرْفُو بِيهْ. <verse eid="MAT 11:27" /><verse number="28" style="v" sid="MAT 11:28" />إِنْتُومَا يَا تَاعْبِينْ وحْمَالْكُمْ ثْقِيلَة، إِيجَاوْنِي وآنَا نْرَتَّحْكُمْ. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />حُطُّوا عْلِيكُمْ نِيرِي واتْعَلْمُوا مِنِّي خَاطِرْنِي سِيِّسْ وقَلْبِي مِتْوَاضَعْ، وتَوَّا تَلْقَاوْ الرَّاحَة لِرْوَاحْكُمْ، <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />عْلَى خَاطِرْ نِيرِي سَاهِلْ وحِمْلِي خْفِيفْ».<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">يَسُوعْ هُوَّ رَبْ السِّبْتْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />فِي الأَيَّامَاتْ هَاذِيكَا تْعَدَّى يَسُوعْ وِسْطْ هْنَاشِرْ فِي نْهَارْ سِبْتْ. وتْلَامِذْتُو جَاعُوا، يَاخِي بْدَاوْ يْنَحِّيوْ فِي سْبُولْ القَمْحْ ويَاكْلُوا. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />ووَقْتِلِّي الفِرِّيسِيِّينْ شَافُوهُمْ قَالُولُو: «شُوفْ! تْلَامِذْتِكْ يَعْمْلُوا فِي حَاجَة مُشْ حْلَالْ تِتْعْمَلْ نْهَارْ السِّبْتْ». <verse eid="MAT 12:2" /><verse number="3" style="v" sid="MAT 12:3" />جَاوِبْهُمْ يَسُوعْ: «مَا قْرِيتُوشْ شْنُوَّة عْمَلْ دَاوِدْ هُوَّ ولِّي مْعَاهْ وَقْتِلِّي جَاعُوا؟ <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />كِيفَاشْ دْخَلْ لْخِيمِةْ الإِجْتِمَاعْ، وكْلَا الخُبْزْ الِّي يِتْقَدِّمْ قُرْبَانْ لِلَّهْ، الِّي مَا عَنْدُوشْ الحَقْ يَاكِلْ مِنُّو هُوَّ ولِّي مْعَاهْ، وحْلَالْ كَانْ لِلْكَهَنَة يَاكْلُوا مِنُّو. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />وَلَّا مَا قْرِيتُوشْ فِي الشَّرِيعَة كِيفَاشْ الكَهَنَة يْكَسْرُوا وْصِيِّةْ السِّبْتْ عْلَى خَاطِرْ يِخِدْمُوا فِي الهَيْكِلْ نْهَارْ السِّبْتْ، ومَا يِتْحِسْبُوشْ مُذْنْبِينْ؟ <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />آمَا نْقُلْكُمْ: هُونِي فَمَّة وَاحِدْ أَعْظِمْ مِالهَيْكِلْ. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />وكَانْ جِيتُوا فْهِمْتُوا مَعْنَى الآيَة هَاذِي: "نْحِبْ رَحْمَة مُشْ ذْبِيحَة" رَاكُمْ مَا حْكُمْتُوشْ عْلَى نَاسْ مَا عَمْلُوشْ حَاجَة غَالْطَة. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />عْلَى خَاطِرْ إِبْنْ الإِنْسَانْ هُوَّ رَبْ السِّبْتْ».<verse eid="MAT 12:8" /></para>
  <para style="s">يَسُوعْ يِشْفِي فِي السِّبْتْ</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />ومْشَى يَسُوعْ مِنْ غَادِي ودْخَلْ لْمَعْبِدْ اليْهُودْ. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />ولْقَى رَاجِلْ يِدُّو مَشْلُولَة. وحَبُّوا الفِرِّيسِيِّينْ يَلْقَاوْ حَاجَة يِتْهْمُوهْ بِيهَا، وَلَّاوْ سِأْلُوهْ: «يَاخِي حْلَالْ الوَاحِدْ يِشْفِي المُرْضَى نْهَارْ السِّبْتْ؟». <verse eid="MAT 12:10" /><verse number="11" style="v" sid="MAT 12:11" />يَاخِي جَاوِبْهُمْ: «شْكُونْ مِنْكُمْ عَنْدُو عَلُّوشْ وَاحِدْ، ويْطِيحْلُو فِي بِيرْ نْهَارْ السِّبْتْ، ومَا يْشِدُّوشْ ويْخَرْجُو مِالبِيرْ؟ <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />والإِنْسَانْ قَدَّاشْ عَنْدُو قِيمَة أَكْثِرْ مِالعَلُّوشْ! هَاذَاكَا عْلَاشْ فِعْلْ الخِيرْ بِالسِّبْتْ حْلَالْ». <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />ومْبَعِّدْ قَالْ يَسُوعْ لِلرَّاجِلْ: «مِدْ يِدِّكْ!» يَاخِي مَدْهَا، ورَجْعِتْ صْحِيحَة كِي الأُخْرَى. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />وخَرْجُوا الفِرِّيسِيِّينْ وتْفَاهْمُوا بَاشْ يُقْتْلُوا يَسُوعْ.<verse eid="MAT 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />وكِي عْرَفْ يَسُوعْ الِّي هُومَا يْحِبُّوا يُقْتْلُوهْ، خْرَجْ مِنْ غَادِي. وتَبْعُوهْ بَرْشَة نَاسْ وشْفَى المُرْضَى الِّي فِيهُمْ الكُلْ. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />ونَبَّهْ عْلِيهُمْ بَاشْ مَا يَحْكِيوْ عْلِيهْ لْحَدْ، <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />بَاشْ يِتْحَقَّقْ الِّي قَالُو النَّبِيْ إِشَعْيَاءْ:<verse eid="MAT 12:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />«هَاذَا هُوَّ عَبْدِي الِّي اخْتَرْتُو،</para>
  <para style="q2" vid="MAT 12:18">حْبِيبِي الِّي يْفَرَّحْنِي.</para>
  <para style="q1" vid="MAT 12:18">بِشْ نْفِيضْ بْرُوحِي فِيهْ،</para>
  <para style="q2" vid="MAT 12:18">بَاشْ يُعْلِنْ العَدْلْ لِلشُّعُوبْ.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />لَا يَعْمِلْ عَرْكْ ولَا يْصِيحْ،</para>
  <para style="q2" vid="MAT 12:19">ولَا حَدْ يِسْمَعْ صُوتُو فِي الشْوَارَعْ.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />قَصْبَة مْرَضِرْضَة مَا يْكَسَّرْهَاشْ،</para>
  <para style="q2" vid="MAT 12:20">وفْتِيلَة ادَّخِّنْ مَا يِطْفِيهَاشْ،</para>
  <para style="q1" vid="MAT 12:20">حَتَّى لِينْ يُنْصُرْ العَدْلْ،<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />والشُّعُوبْ الكُلْ يْحُطُّوا رْجَاهُمْ فِي إِسْمُو».<verse eid="MAT 12:21" /></para>
  <para style="s">يَسُوعْ وبَعْلَزَبُولْ رَئِيسْ الشْوَاطِنْ</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />وجَابُولُو رَاجِلْ أَعْمَى وبَكُّوشْ سَاكْنُو شِيطَانْ. وشْفَاهْ يَسُوعْ ووَلَّى يِتْكَلِّمْ ويْشُوفْ. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />والنَّاسْ الكُلْ بِهْتُوا وقَالُوا: «زَعْمَة هَاذَا هُوَّ وِلْدْ دَاوِدْ؟». <verse eid="MAT 12:23" /><verse number="24" style="v" sid="MAT 12:24" />وكِي سَمْعُوا الفِرِّيسِيِّينْ النَّاسْ آشْ يَحْكِيوْ قَالُوا: «رَاهُو قَاعِدْ يْخَرِّجْ فِي الشْوَاطِنْ بْرَئِيسْ الشْوَاطِنْ بَعْلَزَبُولْ». <verse eid="MAT 12:24" /><verse number="25" style="v" sid="MAT 12:25" />وعْرَفْ يَسُوعْ أَفْكَارْهُمْ، وقَالِلْهُمْ: «كُلْ مَمْلْكَة تِتْقْسِمْ ضِدْ رُوحْهَا تِخْرِبْ، وكُلْ مْدِينَة وَلَّا عَايْلَة تِتْقْسِمْ ضِدْ رُوحْهَا مَا ادُّومِشْ. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />إِذَا كَانْ إِبْلِيسْ يْخَرِّجْ إِبْلِيسْ، بِشْ يِتْقْسِمْ ضِدْ رُوحُو. مَالَا كِيفَاشْ مَمْلَكْتُو تْنَجِّمْ ادُّومْ؟ <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />وكَانْ آنَا نْخَرِّجْ فِي الشْوَاطِنْ ابَّعْلَزَبُولْ، مَالَا أَوْلَادْكُمْ بِشْكُونْ يْخَرْجُوا فِيهُمْ؟ هَاذَاكَا عْلَاشْ هُومَا الِّي بِشْ يُحْكْمُوا عْلِيكُمْ. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />آمَا كَانْ آنَا نْخَرِّجْ فِي الشْوَاطِنْ بْرُوحْ اللَّهْ، أَعْرْفُوا إِنُّو مَمْلَكْةْ اللَّهْ جَاتْ حَتَّى لْعَنْدْكُمْ. <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />كِيفَاشْ يْنَجِّمْ وَاحِدْ يُدْخُلْ لْدَارْ رَاجِلْ قْوِيْ ويِسْرَقْلُو دَبْشُو، كَانْ مَا يْكَتْفُوشْ قْبَلْ، ومْبَعِّدْ يِسْرْقُو؟ <verse eid="MAT 12:29" /><verse number="30" style="v" sid="MAT 12:30" />الِّي مُشْ مْعَايَا رَاهُو ضِدِّي، ولِّي مَا يَجْمَعْشْ مْعَايَا رَاهُو يْفَرِّتْ. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />هَاذَاكَا عْلَاشْ نْقُلْكُمْ: كُلْ ذَنْبْ وكُلْ كُفْرْ يِتْغْفِرْ لِلنَّاسْ، آمَا الكُفْرْ بِالرُّوحْ القُدُسْ مَا يِتْغْفِرْشْ. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />الِّي يْقُولْ كِلْمَة ضِدْ إِبْنْ الإِنْسَانْ يِتْغْفِرْلُو، آمَا الِّي يْقُولْ كِلْمَة ضِدْ الرُّوحْ القُدُسْ، مُشْ بِشْ يِتْغْفِرْلُو، لَا فِي الزْمَانْ هَاذَا ولَا فِي الزْمَانْ الجَايْ».<verse eid="MAT 12:32" /></para>
  <para style="s">الشَّجْرَة تِتْعْرَفْ مِنْ غَلَّتْهَا</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />«يَا إِمَّا تْخَلِّيوْ الشَّجْرَة تْكُونْ بَاهْيَة تَوَّا تْجِيبْ غَلَّة بَاهْيَة، وَلَّا تْخَلِّيوْ الشَّجْرَة تْكُونْ خَايْبَة تَوَّا تْجِيبْ غَلَّة خَايْبَة. عْلَى خَاطِرْ الشَّجْرَة تِتْعْرَفْ مِنْ غَلَّتْهَا. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />يَا وْلَادْ الأَفَاعِي، كِيفَاشْ تْنَجْمُوا تْقُولُوا كْلَامْ يُصْلُحْ وإِنْتُومَا أَشْرَارْ؟ خَاطِرْ اللْسَانْ يَنْطَقْ بِلِّي فِي القَلْبْ. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />الإِنْسَانْ الصَّالَحْ يْخَرِّجْ الحَاجَاتْ الصَّالْحَة مِالكِنْزْ الصَّالَحْ الِّي فِي قَلْبُو، والإِنْسَانْ الشِّرِيرْ يْخَرِّجْ الشَّرْ مِنْ كِنْزْ الشَّرْ الِّي فِي قَلْبُو. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />ونْقُلْكُمْ: كُلْ كِلْمَة بَاطْلَة يْقُولُوهَا النَّاسْ بِشْ يِتْحَاسْبُوا عْلِيهَا فِي نْهَارْ الحْسَابْ. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />عْلَى خَاطِرْ بِكْلَامِكْ تِتْحْسِبْ صَالَحْ وبِكْلَامِكْ تِتْحْسِبْ مُذْنِبْ».<verse eid="MAT 12:37" /></para>
  <para style="s">مُعْجِزْةْ النَّبِيْ يُونَانْ</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />وقَالُولُو جْمَاعَة مِنْ عُلَمَاءْ الشَّرِيعَة والفِرِّيسِيِّينْ: «يَا مُعَلِّمْ، نْحِبُّوا نْشُوفُوا مِنِّكْ مُعْجْزَة». <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" />يَاخِي جَاوِبْهُمْ: «جِيلْ شِرِّيرْ وخَايِنْ يْحِبْ عْلَى مُعْجْزَة، ومَا يِتْعْطَالُو كَانْ مُعْجِزْةْ النَّبِيْ يُونَانْ. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />وكِيفْ مَا قْعَدْ يُونَانْ ثْلَاثَة أَيَّامْ وثْلَاثَة لْيَالِي فِي كِرْشْ الحُوتَة، هَكَّاكَا إِبْنْ الإِنْسَانْ زَادَا بِشْ يُقْعُدْ ثْلَاثَة أَيَّامْ وثْلَاثَة لْيَالِي فِي قَلْبْ الأَرْضْ. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />أَهْلْ مْدِينِةْ نِينَوَى بِشْ يَاقْفُوا نْهَارْ الحْسَابْ مْعَ الجِيلْ هَاذَا ويُحْكْمُوا عْلِيهْ، عْلَى خَاطِرْهُمْ تَابُوا وَقْتِلِّي نَبَّهُّمْ يُونَانْ، وهَاوْ فَمَّة شْكُونْ هْنَا أَعْظِمْ مِنْ يُونَانْ. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />ومَلِكَةْ الجَنُوبْ بِشْ تَاقِفْ نْهَارْ الحْسَابْ مْعَ الجِيلْ هَاذَا وتُحْكُمْ عْلِيهْ، عْلَى خَاطِرْهَا جَاتْ مِنْ آخِرْ الدِّنْيَا بَاشْ تِسْمَعْ حِكْمِةْ سُلَيْمَانْ، وهَاوْ فَمَّة شْكُونْ هْنَا أَعْظِمْ مِنْ سُلَيْمَانْ!»<verse eid="MAT 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />«وَقْتِلِّي الرُّوحْ الشِّرِّيرْ يُخْرُجْ مِنْ إِنْسَانْ، يَبْدَى يْدُورْ فِي البْلَايِصْ الخَالِيَة يْلَوِّجْ عَالرَّاحَة، ومَا يَلْقَاهَاشْ. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />وَقْتْهَا يْقُولْ: "نِرْجَعْ لْدَارِي الِّي خْرَجْتْ مِنْهَا" ويِرْجَعْ يَلْقَاهَا فَارْغَة ومَكْنُوسَة ومْنَظْمَة. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />ويِمْشِي يْجِيبْ مْعَاهْ سَبْعَة أَرْوَاحْ أُخْرِينْ أَشَرْ مِنُّو ويُدْخْلُوا ويُسْكْنُوا فِي الإِنْسَانْ هَاذَاكَا، وحَالْتُو تْوَلِّي أَخْيِبْ مِلِّي كَانْ عْلِيهَا قْبَلْ. وهَكَّا بِشْ يْصِيرْ مْعَ الجِيلْ الشِّرِّيرْ هَاذَا».<verse eid="MAT 12:45" /></para>
  <para style="s">عَايِلْة يَسُوعْ الحَقِيقِيَّة</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />ووَقْتِلِّي كَانْ يَسُوعْ يْكَلِّمْ فِي النَّاسْ، جَاوْ أُمُّو وخْوَاتُو وقَعْدُوا وَاقْفِينْ لْبَرَّا، وحَبُّوا يَحْكِيوْ مْعَاهْ. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />يَاخِي وَاحِدْ مِالحَاضْرِينْ قَالُّو: «أُمُّكْ وخْوَاتِكْ وَاقْفِينْ لْبَرَّا، يْحِبُّوا يَحْكِيوْ مْعَاكْ». <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />آمَا يَسُوعْ جَاوْبُو: «شْكُونْهَا أُمِّي، وشْكُونْهُمْ خْوَاتِي؟». <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />وشَاوِرْ بْيِدُّو لِتْلَامِذْتُو وقَالْ: «هَاذُومْ هُومَا أُمِّي وخْوَاتِي. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />عْلَى خَاطِرْ الِّي يَعْمِلْ الِّي يْحِبْ عْلِيهْ بَابَا الِّي فِي السْمَاء هُوَّ خُويَا وأُخْتِي وأُمِّي».<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">مَثَلْ الزَرِّيعَة وتَفْسِيرُو</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />وفِي النْهَارْ هَاذَاكَا، خْرَجْ يَسُوعْ مِالدَّارْ وقْعَدْ عْلَى شَطْ البُحَيْرَة. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />وتْلَمُّوا بِيهْ بَرْشَة نَاسْ، حَتَّى لِينْ تْلَزْ يِطْلَعْ فِي فْلُوكَة ويُقْعُدْ فِيهَا، والنَّاسْ الكُلْ بْقَاوْ وَاقْفِينْ عَالشَّطْ. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />وكَلَّمْهُمْ فِي بَرْشَة أُمُورْ بِالأَمْثَالْ، وقَالْ: «خْرَجْ الفَلَّاحْ بَاشْ يَزْرَعْ. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />وهُوَّ قَاعِدْ يَزْرَعْ، جَاتْ شْوَيَّة مِالزَرِّيعَة عَالطْرِيقْ، يَاخِي جَاتْ العْصَافِرْ وكْلَاتْهَا. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />وشْوَيَّة أُخْرَى جَاتْ فِي أَرْضْ مْحَجْرَة مَا فِيهَاشْ بَرْشَة تْرَابْ، يَاخِي نِبْتِتْ فِيسَعْ عْلَى خَاطِرْ التْرَابْ مَا كَانِشْ غَارَقْ. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />وكِي طَلْعِتْ الشَّمْسْ تْحَرْقِتْ ويِبْسِتْ خَاطِرْهَا بْلَاشْ عْرُوقْ. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />وجَاتْ زَرِّيعَة أُخْرَى وِسْطْ الشُّوكْ، وكِي كْبِرْ الشُّوكْ خْنَقْهَا. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />وفَمَّة زَرِّيعَة جَاتْ فِي تُرْبَة بَاهْيَة يَاخِي ثُمْرِتْ، مِنْهَا الِّي جَابِتْ 100 ومِنْهَا الِّي جَابِتْ 60 ومِنْهَا الِّي جَابِتْ 30. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />الِّي عَنْدُو وِذْنِينْ تِسْمَعْ، خَلِّيهْ يِسْمَعْ!».<verse eid="MAT 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />يَاخِي قُرْبُولُو تْلَامِذْتُو وسِأْلُوهْ: «عْلَاشْ تْكَلِّمْ فِيهُمْ بِالأَمْثَالْ؟» <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />جَاوِبْهُمْ: «إِنْتُومَا تِعْطَالْكُمْ بَاشْ تَعْرْفُوا أَسْرَارْ مَمْلَكْةْ السْمَاوَاتْ، آمَا هُومَا مَا تِعْطَالْهُمْشْ. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />الِّي عَنْدُو، بِشْ يِتْعْطَالُو أَكْثِرْ ويْوَلِّي عَنْدُو بْزَايِدْ. آمَا الِّي مَا عَنْدُوشْ، حَتَّى الشْوَيَّة الِّي عَنْدُو يِتْفَكُّولُو. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />هَاذَاكَا عْلَاشْ آنَا نْكَلِّمْ فِيهُمْ بِالأَمْثَالْ عْلَى خَاطِرْهُمْ يُخْزْرُوا ومَا يْشُوفُوشْ ويِسْمْعُوا ومَا يِفْهْمُوشْ. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />وهُومَا الِّي تْحَقْقِتْ فِيهُمْ نُبُوِّةْ إِشَعْيَاءْ الِّي تْقُولْ:</para>
  <para style="b" vid="MAT 13:14" />
  <para style="q1" vid="MAT 13:14">"مَهْمَا سْمَعْتُوا،</para>
  <para style="q2" vid="MAT 13:14">مَاكُمْشْ بِشْ تِفِهْمُوا،</para>
  <para style="q1" vid="MAT 13:14">ومَهْمَا خْزَرْتُوا،</para>
  <para style="q2" vid="MAT 13:14">مَاكُمْشْ بِشْ تْشُوفُوا.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />عْلَى خَاطِرْ الشَّعْبْ هَاذَا قَلْبُو كْسَاحْ،</para>
  <para style="q2" vid="MAT 13:15">وسَمَعْهُمْ ثْقُلْ،</para>
  <para style="q1" vid="MAT 13:15">وغَمْضُوا عِينِيهُمْ،</para>
  <para style="q2" vid="MAT 13:15">بَاشْ مَا يْشُوفُوشْ بْعِينِيهُمْ،</para>
  <para style="q1" vid="MAT 13:15">ومَا يِسْمْعُوشْ بْوِذْنِيهُمْ،</para>
  <para style="q2" vid="MAT 13:15">ومَا يِفْهْمُوشْ بِقْلُوبْهُمْ،</para>
  <para style="q1" vid="MAT 13:15">ومَا يْتُوبُوشْ بَاشْ نِشْفِيهُمْ".<verse eid="MAT 13:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />«آمَا إِنْتُومَا صَحَّة لِيكُمْ عْلَى خَاطِرْ عِينِيكُمْ تُخْزِرْ ووِذْنِيكُمْ تِسْمَعْ. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />نْقُلْكُمْ الحَقْ: بَرْشَة أَنْبِيَاءْ وصَالْحِينْ تْمَنَّاوْ يْشُوفُوا الِّي إِنْتُومَا تْشُوفُوا فِيهْ ومَا شَافُوهِشْ، ويِسْمْعُوا الِّي إِنْتُومَا تِسْمْعُوا فِيهْ ومَا سَمْعُوهِشْ.<verse eid="MAT 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />«مَالَا إِسْمْعُوا إِنْتُومَا شْنُوَّة المَقْصُودْ بْمَثَلْ الفَلَّاحْ: <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />الزَّرِّيعَة الِّي جَاتْ عَالطْرِيقْ، هِيَّ كُلْ مِنْ يِسْمَعْ كِلْمِةْ مَمْلَكْةْ اللَّهْ ومَا يِفْهِمْهَاشْ، يْجِي إِبْلِيسْ ويَخْطِفْ الِّي تِزْرَعْ فِي قَلْبُو.<verse eid="MAT 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 13:20" />«ولِّي تِزْرَعّْ فِي الأَرْضْ المْحَجْرَة، هُوَّ الِّي يِسْمَعْ الكِلْمَة وبِالوَقْتْ يِقْبِلْهَا وهُوَّ فَرْحَانْ، <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />وعْلَى خَاطِرْ مَا عَنْدْهَاشْ عْرُوقْ مَا تْدُومِشْ. ودُوبْ مَا يْجِي وَقْتْ صْعِيبْ وَلَّا إِضْطِهَادْ عْلَى خَاطِرْ كِلْمَة اللَّهْ، يْسَلِّمْ فِيهَا بِالوَقْتْ.<verse eid="MAT 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 13:22" />«ولِّي تِزْرَعّْ وِسْطْ الشُّوكْ، هُوَّ الِّي يِسْمَعْ كِلْمِةْ اللَّهْ، آمَا هْمُومْ الزْمَانْ هَاذَا ومْحَبِّةْ الفْلُوسْ يُخْنْقُوهَا ومَا تُثْمُرْشْ فِيهْ.<verse eid="MAT 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 13:23" />«آمَا الِّي تِزْرَعّْ فِي الأَرْضْ البَاهْيَة، هُوَّ الِّي يِسْمَعْ كِلْمِةْ اللَّهْ ويِفْهِمْهَا وتُثْمُرْ فِيهْ، وفَمَّة الِّي تْجِيبْ 100 وفَمَّة الِّي تْجِيبْ 60 وفَمَّة الِّي تْجِيبْ 30».<verse eid="MAT 13:23" /></para>
  <para style="s">مَثَلْ القَمْحْ والزِّيوَانْ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />وعْطَاهُمْ يَسُوعْ مَثَلْ آخِرْ وقَالْ: «مَمْلِكْةْ السْمَاوَاتْ هِيَّ كِيفْ رَاجِلْ زْرَعْ زَرِّيعَة بَاهْيَة فِي السَّانْيَة مْتَاعُو. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />ووَقْتِلِّي كَانُوا النَّاسْ رَاقْدِينْ، جَاء عْدُوهْ وزْرَعْ زِيوَانْ فِي وِسْطْ القَمْحْ ومْشَى. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />ووَقْتِلِّي القَمْحْ نْبِتْ وعْمَلْ السْبُولْ، نْبِتْ مْعَاهْ الزِّيوَانْ. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />وجَاوْ خَدَّامِةْ مُولَى الأَرْضْ وقَالُولُو: "يَا سِيدْنَا، يَاخِي مُشْ زْرَعْتْ زَرِّيعَة بَاهْيَة فِي أَرْضِكْ؟ مَالَا مْنِينْ جَاهَا الزِّيوَانْ؟" <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />وهُوَّ جَاوِبْهُمْ: "عْدُوْ هُوَّ الِّي عْمَلْ هَاذَا". يَاخِي سِأْلُوهْ: "تْحِبْ نِمْشِيوْ نْقَلْعُوهْ الزِّيوَانْ؟". <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />وجَاوِبْهُمْ: "لَا، بَاشْ مَا تْقَلْعُوشْ القَمْحْ وإِنْتُومَا تْقَلْعُوا فِي الزِّيوَانْ. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />خَلِّيوْهُمْ الزُّوزْ يِكْبْرُوا مْعَ بْعَضْهُمْ لِينْ يْجِي وَقْتْ الحْصَادْ، ووَقْتْهَا نْقُولْ لِلْحَصَّادَة: لِمُّوا الزِّيوَانْ قْبَلْ فِي رْزِمْ وأَحْرْقُوهْ، آمَا القَمْحْ لِمُّوهْ وحُطُّوهْ فِي المَخْزِنْ مْتَاعِي"».<verse eid="MAT 13:30" /></para>
  <para style="s">مَثَلْ حَبِّةْ الخَرْدِلْ</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />وعْطَاهُمْ مَثَلْ آخِرْ، وقَالْ: «مَمْلَكْةْ السْمَاوَاتْ هِيَّ كِيفْ حَبِّةْ الخَرْدِلْ الِّي هَزْهَا رَاجِلْ وزْرَعْهَا فِي السَّانْيَة مْتَاعُو. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />رَغْمِلِّي هِيَّ أَصْغِرْ وَحْدَة فِي الزَّرِّيعَة الكُلْ، آمَا كِي تَبْدَى تِكْبِرْ تْوَلِّي أَكْبِرْ نَبْتَة فِي نَبْتَاتْ الجْنِينَة الكُلْ، ومْبَعِّدْ تْوَلِّي شَجْرَة، وحَتَّى العْصَافِرْ تْجِي وتْعَشِّشْ فِي فْرُوعْهَا».<verse eid="MAT 13:32" /></para>
  <para style="s">مَثَلْ الخْمِيرَة</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />وقَالِلْهُمْ مَثَلْ آخِرْ: «مَمْلَكْةْ السْمَاوَاتْ هِيَّ كِيفْ خْمِيرَة هَزِّتْهَا مْرَا وحَطِّتْهَا فِي ثْلَاثَة كْيَالْ فَرِينَة حَتَّى لِينْ خْمِرْ العْجِينْ الكُلْ».<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />هَاذَا الكُلْ قَالُو يَسُوعْ لِلنَّاسْ بِالأَمْثَالْ. وكَانْ مَا يَحْكِي مْعَاهُمْ كَانْ بِالأَمْثَالْ، <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />بَاشْ يِتْحَقَّقْ الِّي قَالُو اللَّهْ عْلَى طْرِيقْ النَّبِيْ:</para>
  <para style="b" vid="MAT 13:35" />
  <para style="q1" vid="MAT 13:35">«بِالأَمْثَالْ بِشْ نِتْكَلِّمْ،</para>
  <para style="q2" vid="MAT 13:35">ونِكْشِفْ الِّي كَانْ مْخُبِّي مِلِّي تْخَلْقِتْ الدِّنْيَا».<verse eid="MAT 13:35" /></para>
  <para style="b" />
  <para style="s">تَفْسِيرْ مَثَلْ القَمْحْ والزِّيوَانْ</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />ومْبَعِّدْ بْعَثْ يَسُوعْ النَّاسْ يْرَوْحُوا، ورْجَعْ هُوَّ لِلدَّارْ، وجَاوْ تْلَامِذْتُو وقَالُولُو: «فَسْرِلْنَا المَثَلْ مْتَاعْ الزِّيوَانْ». <verse eid="MAT 13:36" /><verse number="37" style="v" sid="MAT 13:37" />يَاخِي جَاوِبْهُمْ: «الِّي زْرَعْ الزَّرِّيعَة البَاهْيَة هُوَّ إِبْنْ الإِنْسَانْ، <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />والأَرْضْ المَزْرُوعَة هِيَّ الدِّنْيَا هَاذِي، والزَّرِّيعَة البَاهْيَة هُومَا وْلَادْ مَمْلَكْةْ اللَّهْ، والزِّيوَانْ هُومَا وْلَادْ إِبْلِيسْ، <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />والعْدُو الِّي زْرَعْ الزِّيوَانْ هُوَّ إِبْلِيسْ، والحْصَادْ هُوَّ آخِرْ الزْمَانْ، والحَصَّادَة هُومَا المْلَايْكَة. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />وكِيمَا يِتْقَلَّعْ الزِّيوَانْ ويِتْحْرَقْ بِالنَّارْ، هَكَّاكَا بِشْ يْصِيرْ فِي آخِرْ الزْمَانْ: <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />يَبْعَثْ إِبْنْ الإِنْسَانْ مْلَايِكْتُو، بَاشْ يْخَرْجُوا مِنْ مَمْلَكْتُو كُلْ الِّي عْمَلُوا الشَّرْ وكُلْ الِّي كَانُوا سْبَبْ فِيهْ، <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />ويَرْمِيوْهُمْ فِي النَّارْ، وِينْ بِشْ يْكُونْ البْكَاء والنْدَمْ. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />آمَا الصَّالْحِينْ، بِشْ يِضْوِيوْ كِي الشَّمْسْ فِي مَمْلَكْةْ بُوهُمْ. الِّي عَنْدُو وِذْنِينْ تِسْمَعْ، خَلِّيهْ يِسْمَعْ!<verse eid="MAT 13:43" /></para>
  <para style="s">مَثَلْ الكِنْزْ المَدْفُونْ</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />«مَمْلَكْةْ السْمَاوَاتْ هِيَّ كِيمَا كِنْزْ مَدْفُونْ فِي سَانْيِة، لْقَاهْ رَاجِلْ وخَبَّاهْ، ومِالفَرْحَة مْشَى بَاعْ كُلْ مَا يِمْلِكْ وشْرَى السَّانْيَة هَاذِيكَا.<verse eid="MAT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />«وزَادَا مَمْلَكْةْ السْمَاوَاتْ هِيَّ كِيفْ تَاجِرْ يْلَوِّجْ عَالجُوهِرْ الغَالِي. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />وكِي لْقَى قَطْعَة جُوهِرْ غَالْيَة بَرْشَة، مْشَى وبَاعْ كُلْ مَا يِمْلِكْ وشْرَاهَا.<verse eid="MAT 13:46" /></para>
  <para style="s">مَثَلْ الشِّبْكَة</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />«وزَادَا مَمْلَكْةْ السْمَاوَاتْ هِيَّ كِيفْ شَبْكَة رْمَاوْهَا فِي البْحَرْ ولَمِّتْ حُوتْ مِنْ كُلْ نَوْعْ. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />وكِي تِمْلَاتْ خَرْجُوهَا الصَّيَّادَة لِلشَّطْ وقَعْدُوا، والحُوتْ البَاهِي حَطُّوهْ فِي قْفَافْ والخَايِبْ رْمَاوَهْ. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />وهَكَّاكَا بِشْ يْصِيرْ فِي آخِرْ الزْمَانْ: يْجِيوْ المْلَايْكَة ويْخَرْجُوا النَّاسْ الأَشْرَارْ مِنْ بِينْ النَّاسْ الصَّالْحِينْ، <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />ويَرْمِيوْهُمْ فِي النَّارْ، وِينْ بِشْ يْكُونْ البْكَاء والنْدَمْ».<verse eid="MAT 13:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />وسْإِلْ يَسُوعْ تْلَامِذْتُو: « فْهِمْتُوا الأُمُورْ هَاذِي الكُلْ؟». جَاوْبُوهْ: «إِيْ نْعَمْ». <verse eid="MAT 13:51" /><verse number="52" style="v" sid="MAT 13:52" />يَاخِي قَالِلْهُمْ: «هَاذَاكَا عْلَاشْ أَيْ عَالِمْ فِي الشَّرِيعَة كِيفْ يْوَلِّي تِلْمِيذْ فِي مَمْلَكْةْ السْمَاوَاتْ، هُوَّ كِيفْ مُولَى الدَّارْ الِّي يْخَرِّجْ مِالمَخْزِنْ مْتَاعُو كْنُوزْ جْدِيدَة وكْنُوزْ قْدِيمَة».<verse eid="MAT 13:52" /></para>
  <para style="s">مْدِينِةْ النَّاصْرَة مَا تِقْبِلْشْ يَسُوعْ</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />وبَعْدْمَا كَمِّلْ يَسُوعْ الأَمْثَالْ هَاذِي، مْشَى مِالبْلَاصَة هَاذِيكَا. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />ورْجَعْ لِبْلَادُو، وبْدَا يْعَلِّمْ فِيهُمْ فِي مَعْبِدْ اليْهُودْ، يَاخِي بِهْتُوا وقَالُوا: «مْنِينْ لِيهْ الحِكْمَة والمُعْجْزَاتْ هَاذِي؟ <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />يَاخِي مُشْ هَاذَا وِلْدْ النَّجَّارْ؟ مُشْ أُمُّو إِسْمْهَا مَرْيِمْ وخْوَاتُو هُومَا يَعْقُوبْ ويُوسِفْ وسِمْعَانْ ويَهُوذَا؟ <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />ومُشْ خْوَاتُو البْنَاتْ عَايْشِنْ بِينَاتْنَا؟ مْنِينْ لِيهْ هَاذَا الكُلْ؟» <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />هَاذَاكَا عْلَاشْ مَا حَبُّوشْ يِقْبْلُوهْ. يَاخِي يَسُوعْ قَالِلْهُمْ: «النَّبِيْ مَا عَنْدُوشْ كَرَامَة فِي بْلَادُو وبِينْ أَهْلُو ونَاسُو». <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />ومَا عْمَلْشْ بَرْشَة مُعْجْزَاتْ غَادِي بِسْبَبْ قِلِّةْ إِيمَانْهُمْ.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">هِيرُودُسْ يُقْتِلْ يُوحَنَّا</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />فِي الوَقْتْ هَاذَاكَا سْمَعْ هِيرُودُسْ الوَالِي أَخْبَارْ يَسُوعْ، <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />وقَالْ لْخُدَّامُو: «هَاذَا يُوحَنَّا الِّي يْعَمِّدْ قَامْ مِالمُوتْ، هَاذَاكَا عْلَاشْ قَاعِدْ يَعْمِلْ فِي المُعْجْزَاتْ». <verse eid="MAT 14:2" /><verse number="3" style="v" sid="MAT 14:3" />عْلَى خَاطِرْ هِيرُودُسْ قْبَلْ شَدْ يُوحَنَّا وكَتْفُو وحَطُّو فِي الحَبْسْ بِسْبَبْ هِيرُودِيَّا مَرْتْ فِيلِۑُّسْ خُوهْ، <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />عْلَى خَاطِرْ يُوحَنَّا كَانْ يْقُلُّو: «مَا عَنْدِكْشْ الحَقْ تْعَرِّسْ بِيهَا». <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />وحَبْ يُقْتْلُو، آمَا خَافْ مِالشَّعْبْ، عْلَى خَاطِرْ يُوحَنَّا كَانْ بِالنِّسْبَة لِيهُمْ نَبِيْ. <verse eid="MAT 14:5" /><verse number="6" style="v" sid="MAT 14:6" />وفِي عِيدْ مِيلَادْ هِيرُودُسْ، شَطْحِتْ بِنْتْ هِيرُودِيَّا فِي الحَفْلَة قُدَّامْ الضْيُوفْ، يَاخِي عِجْبِتْ هِيرُودُسْ، <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />وحْلِفْ بِشْ يَعْطِيهَا أَيْ حَاجَة تُطْلُبْهَا. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />وبَعْدْمَا شَاوْرِتْ أُمْهَا قَالِتْ لْهِيرُودُسْ: «أَعْطِينِي رَاسْ يُوحَنَّا الِّي يْعَمِّدْ عْلَى طْبَقْ!». <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />حْزِنْ المَلِكْ، آمَا عْلَى خَاطِرْ اليْمِينْ الِّي حَلْفُو قُدَّامْ ضْيُوفُو، عْطَى أَمْرْ بَاشْ يَعْطِيوْهَا الِّي حَبِّتْ عْلِيهْ. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />وبْعَثْ سَيَّافْ لِلْحَبْسْ، قَصْ رَاسْ يُوحَنَّا. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />وجَابُو فِي طْبَقْ وعْطَاهْ لِلْبْنَيَّة، وهِيَّ هَزِّتُو لْأُمْهَا. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />وجَاوْ تْلَامِذْةْ يُوحَنَّا وهَزُّوا بَدْنُو ودِفْنُوهْ، ومْشَاوْ خَبْرُوا يَسُوعْ.<verse eid="MAT 14:12" /></para>
  <para style="s">يَسُوعْ يْوَكِّلْ 5 000 رَاجِلْ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />وكِي سْمَعْ يَسُوعْ بِالحْكَايَة، رْكِبْ فِي فْلُوكَة ومْشَى وَحْدُو لِبْلَاصَة خَالْيَة. وكِي النَّاسْ سَمْعُوا بِيهْ، تَبْعُوهْ عْلَى سَاقِيهُمْ مِنْ كُلْ مْدِينَة. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />وكِي هْبَطْ مِالفْلُوكَة، شَافْ بَرْشَة نَاسْ، يَاخِي حَنْ عْلِيهُمْ وشْفَى كُلْ وَاحِدْ مْرِيضْ فِيهُمْ. <verse eid="MAT 14:14" /><verse number="15" style="v" sid="MAT 14:15" />وفِي العْشِيَّة، جَاوَهْ تْلَامِذْتُو وقَالُولُو: «النْهَارْ وْفَى، والبْلَاصَة هَاذِي خَالْيَة، أَبْعِثْ النَّاسْ يِمْشِيوْ لِلدْشُرْ ويِشْرِيوْ حَاجَة يَاكْلُوهَا». <verse eid="MAT 14:15" /><verse number="16" style="v" sid="MAT 14:16" />آمَا يَسُوعْ قَالِلْهُمْ: «مُشْ لَازِمْ يِمْشِيوْ. إِنْتُومَا أَعْطِيوْهُمْ يَاكْلُوا». <verse eid="MAT 14:16" /><verse number="17" style="v" sid="MAT 14:17" />يَاخِي قَالُولُو: «مَا عَنْدْنَا هْنَا كَانْ خَمْسَة خُبْزَاتْ وحُوتِّينْ». <verse eid="MAT 14:17" /><verse number="18" style="v" sid="MAT 14:18" />قَالْ يَسُوعْ: «جِيبُوهُمْلِي». <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />وعْطَى أَمْرْ لِلنَّاسْ بَاشْ يُقْعْدُوا عَالحْشِيشْ، وخْذَا الخَمْسَة خُبْزَاتْ والحُوتِّينْ، وهَزْ عِينِيهْ لِلسْمَاء، وشْكَرْ اللَّهْ وقْسِمْ الخُبْزَاتْ وعْطَاهُمْ لِلتْلَامْذَة، والتْلَامْذَة فَرْقُوهُمْ عَالنَّاسْ. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />والنَّاسْ كْلَاوْ لِينْ شَبْعُوا. والتْلَامْذَة هَزُّوا أَثْنَاشِنْ قُفَّة مْعَبْيَة مِلِّي فْضُلْ. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />والنَّاسْ الِّي كْلَاوْ كَانُوا قْرَابِةْ 5 000 رَاجِلْ، بِخْلَافْ النْسَاء والصْغَارْ.<verse eid="MAT 14:21" /></para>
  <para style="s">يَسُوعْ يِمْشِي عَالمَاءْ</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />وبَعْدْهَا بِالضَّبْطْ، طَلَّعْ تْلَامِذْتُو فِي الفْلُوكَة بَاشْ يِسْبْقُوهْ لِلشَّطْ الآخِرْ، حَتَّى لِينْ هُوَّ يَبْعَثْ النَّاسْ يْرَوْحُوا. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />وبَعْدْمَا بْعَثْ النَّاسْ يْرَوْحُوا، طْلَعْ وَحْدُو لِلجْبَلْ بَاشْ يْصَلِّي. وجَاء اللِّيلْ وهُوَّ لْغَادِي وَحْدُو. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />والفْلُوكَة بِعْدِتْ عَالشَّطْ، وبْدَا المُوجْ يَضْرِبْ فِيهَا عْلَى خَاطِرْ الرِّيحْ كَانِتْ عَاكْسِتْهَا.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />وقْبَلْ الفَجْرْ جَاهُمْ يَسُوعْ يِمْشِي فُوقْ المَاء. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />وكِي شَافُوهْ تْلَامِذْتُو يِمْشِي فُوقْ المَاء تْرِعْبُوا وقَالُوا: «هَاذَا شَبَحْ!» وبْدَاوْ يْصِيحُوا مِالخُوفْ. <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />وبِالوَقْتْ قَالِلْهُمْ يَسُوعْ: «اتْشَجْعُوا! رَانِي آنَا هُوَّ، مَا تْخَافُوشْ». <verse eid="MAT 14:27" /><verse number="28" style="v" sid="MAT 14:28" />يَاخِي بُطْرُسْ قَالُّو: «يَا سِيدِي، كَانِكْ إِنْتِ هُوَّ، أُأْمُرْنِي بَاشْ نْجِيكْ نِمْشِي فُوقْ المَاء». <verse eid="MAT 14:28" /><verse number="29" style="v" sid="MAT 14:29" />قَالُّو يَسُوعْ: «إِيجَا». يَاخِي خْرَجْ بُطْرُسْ مِالفْلُوكَة ومْشَى لْيَسُوعْ فُوقْ المَاء. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />وكِي شَافْ الرِّيحْ قْوِيَّة خَافْ، وبْدَا يُغْرُقْ، وقَامْ يْعَيِّطْ: «يَا سِيدِي، مَنَّعْنِي!» <verse eid="MAT 14:30" /><verse number="31" style="v" sid="MAT 14:31" />وبِالوَقْتْ مَدْ يَسُوعْ يِدُّو وشَدُّو وقَالُّو: «يَا قْلِيلْ الإِيمَانْ، عْلَاشْ شَكِّيتْ؟». <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />وكِي طَلْعُوا فِي الفْلُوكَة هْدَاتْ الرِّيحْ. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />ولِّي فِي الفْلُوكَة سِجْدُولُو وقَالُوا: «بِالحَقْ إِنْتِ إِبْنْ اللَّهْ!».<verse eid="MAT 14:33" /></para>
  <para style="s">يَسُوعْ يِشْفِي بَرْشَة نَاسْ</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />وشَقُّوا البُحَيْرَة لِينْ وُصْلُوا لْشَطْ جَنِّيسَارْتْ. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />وأَهْلْ المَنْطْقَة هَاذِيكَا عَرْفُوهْ، ونَشْرُوا الخْبَرْ فِي البْلَايِصْ الِّي دَايْرَة بِيهُمْ، يَاخِي جَابُولُو المُرْضَى الكُلْ. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />وطَلْبُوا مِنُّو يْخَلِّيهُمْ يْمِسُّوا حَتَّى طْرَاطِشْ حْوَايْجُو. ولِّي مَسُّوهْ الكُلْ تِشْفَاوْ.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">عَادَاتْ النَّاسْ وَلَّا وْصِيَّةْ اللَّهْ؟</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />وجَاوْ جْمَاعَة مِالفِرِّيسِيِّينْ وعُلَمَاءْ الشَّرِيعَة لْيَسُوعْ مِنْ أُورْشَلِيمْ، وسِأْلُوهْ: <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />«عْلَاشْ تْلَامِذْتِكْ مَا يِحْتَرْمُوشْ العَادَاتْ الِّي فَرْضُوهَا الشْيُوخْ؟ ومَا يَغْسْلُوشْ يْدِيهُمْ قْبَلْ المَاكْلَة؟». <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />جَاوِبْهُمْ: «وعْلَاشْ إِنْتُومَا مَا اطِّيعُوشْ وْصِيِّةْ اللَّهْ وشَادِّينْ صْحِيحْ فِي عَادَاتْكُمْ وتَقَالِيدْكُمْ؟ <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />اللَّهْ قَالْ: "إِكْرِمْ بُوكْ وأُمِّكْ، ولِّي يْسِبْ بُوهْ وَلَّا أُمُّو يِلْزْمُو يِتِقْتَلْ". <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />آمَا إِنْتُومَا تْقُولُوا: "إِذَا وَاحِدْ قَالْ لْبُوهْ وَلَّا أُمُّو: الِّي كُنْتْ بِشْ نْعَاوْنِكْ بِيهْ رَانِي عْطِيتُو لِلَّهْ، <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />يْوَلِّي مَعْفِي، ومُشْ لَازِمْ يْعَاوِنْ بُوهْ وَلَّا أُمُّو". وهَكَّا خَالِفْتُوا وْصِيِّةْ اللَّهْ عْلَى خَاطِرْ تَقَالِيدْكُمْ. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />يَا مُنَافْقِينْ، صْدُقْ إِشَعْيَاءْ وَقْتِلِّي تْنَبَّأْ عْلِيكُمْ وقَالْ:<verse eid="MAT 15:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />"الشَّعْبْ هَاذَا يِكْرِمْنِي بْفُمُّو،</para>
  <para style="q2" vid="MAT 15:8">آمَا قَلْبُو بْعِيدْ عْلِيَّا.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />عْبَادِتْهُمْ لِيَّا بَاطْلَة،</para>
  <para style="q2" vid="MAT 15:9">وقَاعْدِينْ يْعَلْمُوا فِي وْصَايَا حَطُّوهَا النَّاسْ"».<verse eid="MAT 15:9" /></para>
  <para style="b" />
  <para style="s">الطَّاهِرْ والمَنْجُوسْ</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />ومْبَعِّدْ عَيِّطْ يَسُوعْ لِلنَّاسْ وقَالِلْهُمْ: «إِسْمْعُوا وإِفْهْمُوا: <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />مُشْ الِّي يُدْخُلْ لِلْفُمْ يْنَجِّسْ الإِنْسَانْ، آمَا الِّي يُخْرُجْ مِالفُمْ هُوَّ الِّي يْنَجِّسْ الإِنْسَانْ». <verse eid="MAT 15:11" /><verse number="12" style="v" sid="MAT 15:12" />يَاخِي جَاوُوهْ تْلَامِذْتُو وقَالُوا: «فِي بَالِكْ الِّي كْلَامِكْ هَاذَا غَشِّشْ الفِرِّيسِيِّينْ؟». <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" />جَاوِبْهُمْ: «كُلْ زَرْعْ مَا زَرْعُوشْ بَابَا الِّي فِي السْمَاء يِتْقَلَّعْ. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />إِبْعْدُوا عْلِيهُمْ! هُومَا عِمْيَانْ يْقُودُوا فِي عِمْيَانْ. وإِذَا كَانْ أَعْمَى يْقُودْ أَعْمَى، الإِثْنِينْ يْطِيحُوا فِي حُفْرَة».<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />يَاخِي قَالُّو بُطْرُسْ: «فَسْرِلْنَا المَثَلْ هَاذَا». <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />جَاوِبْ يَسُوعْ: « إِنْتُومَا زَادَا لْتَوَّا مَا تِفْهْمُوشْ؟ <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />يَاخِي مَا تَعْرْفُوشْ الِّي أَيْ مَاكْلَة تُدْخُلْ مِالفُمْ تَهْبِطْ لِلْكِرْشْ، ومْبَعِّدْ تُخْرُجْ مِالبْدَنْ؟ <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />آمَا الِّي يُخْرُجْ مِالفُمْ، هُوَّ جَايْ مِالقَلْبْ، وهَاذَا الِّي يْنَجِّسْ الإِنْسَانْ. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />عْلَى خَاطِرْ مِالقَلْبْ تْجِي الأَفْكَارْ الشِّرِّيرَة: القَتْلْ والزْنَى والفْسَادْ والسِّرْقَة وشْهَادِةْ الزُّورْ والتَّقْطِيعْ والتَّرْيِيشْ. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />وهَاذِي هِيَّ الحَاجَاتْ الِّي تْنَجِّسْ الإِنْسَانْ. آمَا المَاكْلَة بِيدِينْ مُشْ مَغْسُولَة مَا تْنَجِّسْشْ الإِنْسَانْ».<verse eid="MAT 15:20" /></para>
  <para style="s">إِيمَانْ المْرَا الكَنْعَانِيَّة</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />وخْرَجْ يَسُوعْ مِنْ غَادِي ومْشَى لْشِيرِةْ صُورْ وصَيْدَا. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />وجَاتُو مْرَا كَنْعَانِيَّة مِالمَنْطْقَة هَاذِيكَا وبْدَاتْ تْعَيِّطْ: «يَا سِيدِي، يَا وِلْدْ دَاوِدْ، أَرْحَمْنِي! بِنْتِي سَاكِنْهَا شِيطَانْ ومْعَذَّبْهَا بَرْشَة». <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />آمَا هُوَّ مَا جَاوِبْهَا بْحَتَّى كِلْمَة. وجَاوْ تْلَامِذْتُو ولَحُّوا عْلِيهْ وقَالُوا: «بَعَّدْهَا عْلِينَا، رَاهِي قَاعْدَة تْعَيِّطْ وْرَانَا». <verse eid="MAT 15:23" /><verse number="24" style="v" sid="MAT 15:24" />جَاوِبْهُمْ: «آنَا مَا بْعَثْنِي اللَّهْ كَانْ لِغْنَمْ بَنِي إِسْرَائِيلْ الضَّايْعَة». <verse eid="MAT 15:24" /><verse number="25" style="v" sid="MAT 15:25" />آمَا المْرَا، جَاتْ وسِجْدِتْ قُدَّامُو وقَالِتْ: «يَا سِيدِي، عَاوِنِّي!». <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />يَاخِي جَاوِبْهَا: «مَا يْجِيشْ نَاخْذُوا خُبْزْ الصْغَارْ ونَرْمِيوَهْ لِلْكْلَابْ». <verse eid="MAT 15:26" /><verse number="27" style="v" sid="MAT 15:27" />قَالِتْلُو: «صْحِيحْ يَا سِيدِي! آمَا حَتَّى الكْلَابْ تَاكِلْ مِالفِتْفَاتْ الِّي يْطِيحْ مِنْ طَاوِلْةْ أَسْيَادْهَا». <verse eid="MAT 15:27" /><verse number="28" style="v" sid="MAT 15:28" />جَاوِبْهَا يَسُوعْ: «يَا مْرَا، إِيمَانِكْ عْظِيمْ! خَلِّي الِّي طْلَبْتُو يْكُونْ لِيكْ». وفِي لَحْظِتْهَا بِنْتْهَا تِشْفَاتْ.<verse eid="MAT 15:28" /></para>
  <para style="s">يَسُوعْ يِشْفِي بَرْشَة نَاسْ</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />ومْبَعِّدْ مْشَى يَسُوعْ مِنْ غَادِي وجَاء لْشَطْ بُحَيْرِةْ الجَلِيلْ، وطْلَعْ لِلجْبَلْ وقْعَدْ غَادِي. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />يَاخِي جَاوَهْ بَرْشَة نَاسْ وجَابُوا مْعَاهُمْ نَاسْ عَايْبِينْ ومَشْلُولِينْ وعِمْيَانْ وبْكَاكِشْ وبَرْشَة أُخْرِينْ، وحَطُّوهُمْ قُدَّامْ سَاقِيهْ وهُوَّ شْفَاهُمْ. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />وتْعَجْبُوا النَّاسْ كِي شَافُوا البْكَاكِشْ يِتْكَلْمُوا، والمَشْلُولِينْ تِشْفَاوْ، والعَايْبِينْ يِمْشِيوْ، والعِمْيَانْ يْشُوفُوا. ومَجْدُوا إِلَاهْ إِسْرَائِيلْ.<verse eid="MAT 15:31" /></para>
  <para style="s">يَسُوعْ يْوَكِّلْ 4 000 رَاجِلْ</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />وعَيِّطْ يَسُوعْ لِتْلَامِذْتُو وقَالِلْهُمْ: «النَّاسْ هَاذُومَا غَايْضِينِّي، عْلَى خَاطِرْهُمْ بْقَاوْ مْعَايَا ثْلَاثَة أَيَّامْ ومَا عَنْدْهُمْشْ مَا يَاكْلُوا. ومَا نْحِبِّشْ نَبْعَثْهُمْ يْرَوْحُوا وهُومَا جْوَاعَى بَاشْ مَا يَعْيَاوِشْ فِي الثْنِيَّة». <verse eid="MAT 15:32" /><verse number="33" style="v" sid="MAT 15:33" />يَاخِي قَالُولُو التْلَامْذَة: «فِي الخْلَاء هَاذَا، مْنِينْ بِشْ نْجِيبُوا خُبْزْ يْكَفِّي النَّاسْ هَاذُومَا الكُلْ؟». <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />قَالِلْهُمْ يَسُوعْ: «قَدَّاشْ عَنْدْكُمْ مِنْ خُبْزَة؟». قَالُوا: «سَبْعَة خُبْزَاتْ وكْعِيبَاتْ حُوتْ صْغَارْ». <verse eid="MAT 15:34" /><verse number="35" style="v" sid="MAT 15:35" />يَاخِي طْلَبْ يَسُوعْ مِالنَّاسْ بَاشْ يُقْعْدُوا عَالأَرْضْ. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />وخْذَا السَّبْعَة خُبْزَاتْ وكْعِيبَاتْ الحُوتْ، وشْكَرْ وقْسِمْهُمْ وعْطَاهُمْ لِلتْلَامْذَة، والتْلَامْذَة عْطَاوْ لِلنَّاسْ. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />وكْلَاوْ الكُلْ حَتَّى لِينْ شَبْعُوا، وهَزُّوا التْلَامْذَة سَبْعَة قْفَافْ كْبَارْ مِلْيَانِينْ بِالخُبْزْ الِّي فْضُلْ. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />ولِّي كْلَاوْ كَانْ عْدَدْهُمْ 4 000 رَاجِلْ، بِخْلَافْ النْسَاء والصْغَارْ. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />وبَعْدْمَا يَسُوعْ مَشَّى النَّاسْ، طْلَعْ فِي الفْلُوكَة ومْشَى لْمَنْطَقْةْ مَجْدَانْ.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">الفِرِّيسِيِّينْ والصَّدُّوقِيِّينْ يْجَرْبُوا يَسُوعْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />وجَاوَهْ الفِرِّيسِيِّينْ والصَّدُّوقِيِّينْ بَاشْ يْجَرْبُوهْ، وطَلْبُوا مِنُّو بَاشْ يْوَرِّيهُمْ مُعْجْزَة مِالسْمَاء. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />يَاخِي جَاوِبْهُمْ يَسُوعْ: «كِي تَبْدَى السْمَاء حَمْرَاء وَقْتْ المُغْرُبْ، تْقُولُوا: "غُدْوَة الطَّقْسْ بِشْ يْجِي بَاهِي". <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />وكَانْ صَبْحِتْ السْمَاء حَمْرَاء ومْغَيْمَة، تْقُولُوا: "اليُومْ المْطَرْ بِشْ تْصُبْ!". إِنْتُومَا تَعْرْفُوا كِيفَاشْ تْفَسْرُوا مَنْظِرْ السْمَاء، آمَا عَلَامَاتْ الزْمَانْ مَا تَعْرْفُوشْ تْفَسْرُوهَا! <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />جِيلْ شِرِّيرْ وفَاسَقْ يُطْلُبْ فِي مُعْجْزَة، آمَا مَاهِيشْ بِشْ تِتْعْطَالُو كَانْ مُعْجْزِةْ يُونَانْ». وخَلَّاهُمْ ومْشَى.<verse eid="MAT 16:4" /></para>
  <para style="s">خْمِيرِةْ الفِرِّيسِيِّينْ والصَّدُّوقِيِّينْ</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />وكِي وُصْلُوا التْلَامْذَة لِلشَّطْ المْقَابِلْ، ظُهْرُوا نْسَاوْ بَاشْ يْهِزُّوا مْعَاهُمْ خُبْزْ. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />قَالِلْهُمْ يَسُوعْ: «فِيقُوا، ورُدُّوا بَالْكُمْ مِنْ خْمِيرِةْ الفِرِّيسِيِّينْ والصَّدُّوقِيِّينْ». <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />يَاخِي بْدَاوْ يِتْنَاقْشُوا بِينْ بْعَضْهُمْ ويْقُولُوا: «هَاذَا عْلَى خَاطِرْ مَا عَنْدْنَاشْ خُبْزْ». <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />وعْرَفْ يَسُوعْ فَاشْ يَحْكِيوْ يَاخِي قَالِلْهُمْ: «يَلِّي إِيمَانْكُمْ ضْعِيفْ، عْلَاشْ تِتْنَاقْشُوا وتْقُولُوا: مَا عَنْدْنَاشْ خُبْزْ؟ <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />يَاخِي لْتَوَّا لَا فْهِمْتُوا؟ نْسِيتُوا الخَمْسَة خُبْزَاتْ الِّي شَبْعُوا الـ5 000 وقَدَّاشْ مِنْ قُفَّة هَزِّيتُوا مِلِّي فْضُلْ؟ <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />وَلَّا السَّبْعَة خُبْزَاتْ الِّي شَبّْعِتْ الـ4 000 وقَدَّاشْ مِنْ قُفَّة مْعَبْيَة هَزِّيتُوا؟ <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />كِيفَاشْ مَا فْهِمْتُوشْ الِّي آنَا مَانِيشْ نَحْكِي عَالخُبْزْ كِي قُلْتِلْكُمْ: رُدُّوا بَالْكُمْ مِنْ خْمِيرِةْ الفِرِّيسِيِّينْ والصَّدُّوقِيِّينْ؟». <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />وَقْتْهَا فِهْمُوا التْلَامْذَة الِّي هُوَّ قَالِلْهُمْ رُدُّوا بَالْكُمْ مِنْ تَعْلِيمْ الفِرِّيسِيِّينْ والصَّدُّوقِيِّينْ مُشْ مِنْ خْمِيرِةْ الخُبْزْ.<verse eid="MAT 16:12" /></para>
  <para style="s">بُطْرُسْ يِشْهِدْ الِّي يَسُوعْ هُوَّ المَسِيحْ إِبْنْ اللَّهْ الحَيْ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />وَقْتِلِّي وْصُلْ يَسُوعْ لْمَنْطَقْةْ قَيْصَرِيِّةْ فِيلِۑُّسْ، سْإِلْ تْلَامِذْتُو: «حَسْبْ رَايْ النَّاسْ شْكُونِي آنَا إِبْنْ الإِنْسَانْ؟». <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />جَاوْبُوهْ: «فِيهُمْ شْكُونْ يْقُولْ الِّي إِنْتِ يُوحَنَّا الِّي يْعَمِّدْ، وأُخْرِينْ يْقُولُوا الِّي إِنْتِ إِيلِيَّا، وغِيرْهُمْ يْقُولْ الِّي إِنْتِ إِرْمِيَا وَلَّا وَاحِدْ مِالأَنْبِيَاءْ». <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />سْإِلْهُمْ: «وحَسْبْ رَايْكُمْ إِنْتُومَا آنَا شْكُونْ؟». <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />جَاوِبْ سِمْعَانْ بُطْرُسْ: «إِنْتِ المَسِيحْ إِبْنْ اللَّهْ الحَيْ». <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />قَالُّو يَسُوعْ: «صَحَّة لِيكْ، يَا سِمْعَانْ وِلْدْ يُونَا. الِّي كْشِفْلِكْ الحْقِيقَة هَاذِي مُشْ بَشَرْ، آمَا بَابَا الِّي فِي السْمَاء. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />وآنَا نْقُلِّكْ: إِنْتِ بُطْرُسْ، وعَالحَجْرَة هَاذِي نِبْنِي كْنِيسْتِي، وبِيبَانْ الهَاوْيَة مُشْ بِشْ تَقْوَى عْلِيهَا. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />بِشْ نَعْطِيكْ مْفَاتَحْ مَمْلَكْةْ السْمَاوَاتْ، وكُلْ الِّي تُرْبْطُو فِي الأَرْضْ يْكُونْ مَرْبُوطْ فِي السْمَاء، ولِّي تْحِلُّو فِي الأَرْضْ يْكُونْ مَحْلُولْ فِي السْمَاء». <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />وبَعْدْهَا نَبَّهْ عْلَى تْلَامِذْتُو بَاشْ مَا يْقُولُوا لْحَدْ الِّي هُوَّ المَسِيحْ.<verse eid="MAT 16:20" /></para>
  <para style="s">يَسُوعْ يِتْنَبَّأْ بْمُوتُو وقْيَامْتُو</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />ومِنْ وَقْتْهَا بْدَا يَسُوعْ يْفَهَّمْ فِي تْلَامِذْتُو الِّي هُوَّ يِلْزْمُو يِمْشِي لْأُورْشَلِيمْ، ويِتْعَذَّبْ عْلَى يْدِينْ الشْيُوخْ وكْبَارْ الكَهَنَة وعُلَمَاءْ الشَّرِيعَة، ويِتْقْتَلْ، وفِي النْهَارْ الثَّالِثْ يْقُومْ. <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />وجِبْدُو بُطْرُسْ عْلَى جْنَبْ وبْدَا يْلُومْ عْلِيهْ وقَالُّو: «حَاشَاكْ يَا سِيدِي! هَاذَا مُشْ بِشْ يْصِيرْلِكْ!». <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />آمَا يَسُوعْ تْلَفِّتْ لْبُطْرُسْ وقَالُّو: «إِبْعِدْ عْلِيَّا يَا إِبْلِيسْ! إِنْتِ تْعَطِّلْ فِيَّا، عْلَى خَاطْرِكْ تْفَكِّرْ كِيفْ النَّاسْ مُشْ كِيفْ اللَّهْ!».<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />وبَعْدْهَا قَالْ يَسُوعْ لِتْلَامِذْتُو: «الِّي يْحِبْ يْتَبَّعْنِي، يِلْزْمُو يُنْكُرْ رُوحُو ويْشَارِكْنِي فِي العْذَابْ والمُوتْ، <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />عْلَى خَاطِرْ الِّي يْحِبْ يْمَنَّعْ حْيَاتُو يَخْسَرْهَا، ولِّي يَخْسَرْ حْيَاتُو عْلَى خَاطْرِي يَلْقَاهَا. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />شْنِيَّة الفَايْدَة كَانْ الإِنْسَانْ يِرْبَحْ العَالِمْ الكُلْ ويَخْسَرْ رُوحُو؟ وشْنِيَّة يْنَجِّمْ يَعْطِي الإِنْسَانْ بَاشْ يِفْدِي رُوحُو؟ <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />عْلَى خَاطِرْ إِبْنْ الإِنْسَانْ بِشْ يْجِي مْعَ مْلَايِكْتُو فِي مَجْدْ بُوهْ، ووَقْتْهَا يْجَازِي كُلْ وَاحِدْ عْلَى حَسْبْ أَعْمَالُو. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />نْقُلْكُمْ الحَقْ: فَمَّة شْكُونْ مِالوَاقْفِينْ هْنَا مَاهُمْشْ بِشْ يْذُوقُوا المُوتْ، إِلَّا بَعْدْمَا يْشُوفُوا إِبْنْ الإِنْسَانْ جَايْ فِي مَمْلَكْتُو».<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">يَسُوعْ يُظْهُرْ فِي مَجْدُو</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />وبَعْدْ سِتَّة أَيَّامْ هَزْ يَسُوعْ بُطْرُسْ ويَعْقُوبْ ويُوحَنَّا خُوهْ، وطْلَعْ بِيهُمْ لِجْبَلْ عَالِي وَحَّدْهُمْ. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />وتْبَدْلِتْ هَيْأْتُو قُدَّامْهُمْ، ووِجْهُو وَلَّى يِضْوِي كِي الشَّمْسْ، وحْوَايْجُو وَلَّاوْ بْيُضْ كِي النُّورْ. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />وهُومَا هَكَّاكَا، ظُهْرُولْهُمْ مُوسَى وإِيلِيَّا يِتْكَلْمُوا مْعَ يَسُوعْ.<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />يَاخِي بُطْرُسْ قَالْ لْيَسُوعْ: «يَا سِيدِي، مَحْلَاهَا القَعْدَة هُونِي! كَانْ تْحِبْ، تَوْ نُنْصْبُوا ثْلَاثَة خْيِمْ: وَحْدَة لِيكْ ووَحْدَة لْمُوسَى ووَحْدَة لْإِيلِيَّا». <verse eid="MAT 17:4" /><verse number="5" style="v" sid="MAT 17:5" />وهُوَّ مَزَّالْ يِتْكَلِّمْ، غَطَّاتْهُمْ غِيمَة ضَاوْيَة، وخْرَجْ صُوتْ مِالغِيمَة يْقُولْ: «هَاذَا هُوَّ إِبْنِي الِّي نْحِبُّو ولِّي فَرْحْتِي بِيهْ عْظِيمَة، إِسْمْعُوا كْلَامُو!». <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />وكِي سَمْعُوا التْلَامْذَة الصُّوتْ، طَاحُوا عْلَى وْجُوهْهُمْ وخَافُوا بَرْشَة. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />يَاخِي يَسُوعْ قْرُبِّلْهُمْ ومَسْهُمْ وقَالْ: «قُومُوا، مَا تْخَافُوشْ». <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />وكِي هَزُّوا عِينِيهُمْ، مَا شَافُوا كَانْ يَسُوعْ وَحْدُو.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />وهُومَا هَابْطِينْ مِالجْبَلْ، وَصَّاهُمْ يَسُوعْ: «مَا تْقُولُوا لْحَدْ عَلِّي شُفْتُوهْ إِلَّا بَعْدْمَا يْقُومْ إِبْنْ الإِنْسَانْ مِالمُوتْ». <verse eid="MAT 17:9" /><verse number="10" style="v" sid="MAT 17:10" />يَاخِي التْلَامْذَة سِأْلُوهْ: «عْلَاشْ عُلَمَاءْ الشَّرِيعَة يْقُولُوا الِّي إِيلِيَّا لَازِمْ يْجِي قْبَلْ؟». <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />جَاوِبْهُمْ: «صْحِيحْ، إِيلِيَّا يْجِي ويْصَلَّحْ كُلْ شَيْ. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />آمَا آنَا نْقُلْكُمْ: إِيلِيَّا جَاء، ومَا عَرْفُوهُوشْ، آمَا عَمْلُوا فِيهْ كِيمَا حَبُّوا. وكِيفْ كِيفْ إِبْنْ الإِنْسَانْ زَادَا بِشْ يِتْعَذَّبْ عْلَى يْدِيهُمْ». <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />وَقْتْهَا فِهْمُوا التْلَامْذَة الِّي هُوَّ كَانْ يَحْكِيلْهُمْ عْلَى يُوحَنَّا الِّي يْعَمِّدْ.<verse eid="MAT 17:13" /></para>
  <para style="s">يَسُوعْ يْخَرِّجْ شِيطَانْ مِنْ وْلَيِّدْ</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />وكِي رَجْعُوا بَحْذَا النَّاسْ، جَاء رَاجِلْ لْيَسُوعْ وهْبَطْ عْلَى رْكَايْبُو قُدَّامُو. <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />وقَالْ: «يَا سِيدِي، أَرْحَمْ وِلْدِي عْلَى خَاطْرُو عَنْدُو الصَّرْعْ، ومِتْعَذَّبْ بَرْشَة ودِيمَا يْطِيحْ فِي النَّارْ وفِي المَاء. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />ورَانِي جِبْتُو لِتْلَامِذْتِكْ، آمَا مَا نَجْمُوشْ يِشْفِيوَهْ». <verse eid="MAT 17:16" /><verse number="17" style="v" sid="MAT 17:17" />جَاوِبْ يَسُوعْ: «إِنْتُومَا جِيلْ مُشْ مُؤْمِنْ وضَايَعْ! قَدَّاشْ بِشْ نُقْعْدِلْكُمْ؟ وقَدَّاشْ بِشْ نُصْبِرْ عْلِيكُمْ؟ جِيبُوهُولِي لَهْنَا!». <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />ونْزَرْ يَسُوعْ عَالشِّيطَانْ، يَاخِي خَرَجْ مِالوْلَيِّدْ، والوْلَيِّدْ تِشْفَى بِالوَقْتْ. <verse eid="MAT 17:18" /><verse number="19" style="v" sid="MAT 17:19" />وجِبْدُوا التْلَامْذَة يَسُوعْ عْلَى جْنَبْ وسِأْلُوهْ: «عْلَاشْ أَحْنَا مَا نَجَّمْنَاشْ نْخَرْجُوهْ؟». <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" />جَاوِبْهُمْ: «عْلَى خَاطِرْ إِيمَانْكُمْ ضْعِيفْ! نْقُلْكُمْ الحَقْ، كَانْ جَاء عَنْدْكُمْ إِيمَانْ قَدْ كَعْبِةْ الخَرْدِلْ، رَاكُمْ تْقُولُوا لِلجْبَلْ هَاذَا: "نَقِّلْ مِنْ هْنَا لْغَادِي!" وهُوَّ يْنَقِّلْ، ومَا يْكُونْ حَتَّى شَيْ مُسْتَحِيلْ قُدَّامْكُمْ. <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />آمَا النَّوْعْ هَاذَا مِالشْوَاطِنْ، مَا يُخْرُجْ كَانْ بِالصْلَاةْ والصُّومْ».<verse eid="MAT 17:21" /></para>
  <para style="s">يَسُوعْ يْعَاوِدْ يِتْنَبَّأْ بْمُوتُو وقْيَامْتُو</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />وكِي كَانُوا التْلَامْذَة مَلْمُومِينْ فِي الجَلِيلْ قَالِلْهُمْ يَسُوعْ: «إِبْنْ الإِنْسَانْ بِشْ يْسَلْمُوهْ بِينْ يْدِينْ النَّاسْ، <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />وبِشْ يُقْتْلُوهْ، وفِي النْهَارْ الثَّالِثْ يْقُومْ». يَاخِي حِزْنُوا بَرْشَة.<verse eid="MAT 17:23" /></para>
  <para style="s">ضْرِيبِةْ الهَيْكِلْ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />وكِي وُصْلُوا يَسُوعْ وتْلَامِذْتُو لْكَفْرْنَاحُومْ، جَاوْ الِّي يْلِمُّوا فِي ضْرِيبِةْ الهَيْكِلْ لْبُطْرُسْ وقَالُولُو: «يَاخِي المُعَلِّمْ مْتَاعْكُمْ يِدْفَعْ الضَّرَايِبْ؟». <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />جَاوِبْ: «إِيْ نْعَمْ». ووَقْتِلِّي دْخَلْ بُطْرُسْ لِلدَّارْ، سِبْقُو يَسُوعْ بِالكْلَامْ وقَالُّو: «شْنُوَّة رَايِكْ، يَا سِمْعَانْ؟ مُلُوكْ الأَرْضْ مِنْ عَنْدْ شْكُونْ يَاخْذُوا الضَّرَايِبْ والجِزْيَة؟ مِنْ عَنْدْ أَوْلَادْهُمْ وَلَّا مِالبْرَايْنِيَّة؟». <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />جَاوْبُو بُطْرُسْ: «مِنْ عَنْدْ البْرَايْنِيَّة». قَالُّو يَسُوعْ: «مَالَا، الأَوْلَادْ مَا يِدْفْعُوا شَيْ. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />آمَا بَاشْ مَا نَعْمْلُولْهُمْشْ مُشْكْلَة، إِمْشِي لِلْبُحَيْرَة، وأَرْمِي الصُّنَّارَة، والحُوتَة الأُولَى الِّي تْشِدْهَا، حِلِّلْهَا فُمْهَا تَوْ تَلْقَى بْيَاسَة قِيمِتْهَا تِكْفِي بَاشْ تِدْفَعْ الضَّرِيبَة. خُوذْهَا وادْفَعْ الضَّرِيبَة عْلِيَّا وعْلِيكْ».<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">شْكُونْ أَعْظِمْ وَاحِدْ فِي مَمْلَكْةْ السْمَاوَاتْ؟</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />فِي الوَقْتْ هَاذَاكَا، جَاوْ التْلَامْذَة لْيَسُوعْ وسِأْلُوهْ: «شْكُونْ أَعْظِمْ وَاحِدْ فِي مَمْلَكْةْ السْمَاوَاتْ؟». <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />يَاخِي عَيِّطْ يَسُوعْ لِطْفُلْ صْغِيرْ ووَقْفُو فِي وِسْطْهُمْ <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />وقَالْ: «نْقُلْكُمْ الحَقْ: كَانْ مَا تِتْبَدْلُوشْ وتْوَلِّيوْ كِي الأَوْلَادْ الصْغَارْ، مُشْ بِشْ تُدْخْلُوا لْمَمْلَكْةْ السْمَاوَاتْ. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />الِّي يِتْوَاضَعْ ويْكُونْ كِيفْ هَا الطْفُلْ الصْغِيرْ، هُوَّ أَعْظَمْ وَاحِدْ فِي مَمْلَكْةْ السْمَاوَاتْ. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />ولِّي يِقْبِلْ طْفُلْ صْغِيرْ كِيمَا هَاذَا عْلَى خَاطِرْ إِسْمِي يِقْبِلْنِي آنَا.<verse eid="MAT 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />«ولِّي يْكُونْ سْبَبْ فِي إِنُّو وَاحِدْ مِالصْغَارْ الِّي يَمْنُوا بِيَّا يُغْلُطْ، خِيرْلُو كَانْ يِتْعَلَّقْ فِي رَقْبْتُو حَجْرِةْ الرْحَى ويِتِرْمَى فِي قَلْبْ البْحَرْ. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />يَا وِيلُو العَالِمْ مِالحَاجَاتْ الِّي تْخَلِّي النَّاسْ تُغْلُطْ! الغْلَطْ لَازِمْ بِشْ يْصِيرْ، آمَا يَا وِيلُو الِّي يْكُونْ هُوَّ السْبَبْ فِيهْ!<verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />«وإِذَا يِدِّكْ وَلَّا سَاقِكْ تْخَلِّيكْ تُغْلُطْ، قُصْهَا وأَرْمِيهَا بْعِيدْ، خِيرْلِكْ تُدْخُلْ لِلْحَيَاةْ الأَبَدِيَّة نَاقِصْ سَاقْ وَلَّا يِدْ، مِنْ إِنُّو يْدِيكْ وَلَّا سَاقِيكْ يْكُونُوا كَامْلِينْ وتِطَّيِّشْ فِي النَّارْ الأَبَدِيَّة. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />وإِذَا كَانْ عِينِكْ تْخَلِّيكْ تُغْلُطْ، قَلَّعْهَا وأَرْمِيهَا بْعِيدْ، خِيرْلِكْ تُدْخُلْ لِلْحَيَاةْ الأَبَدِيَّة بْعِينْ وَحْدَة، مِنْ إِنُّو يْكُونُوا عَنْدِكْ زُوزْ عِينِينْ وتِتْرْمَى فِي نَارْ جْهَنِّمْ.<verse eid="MAT 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />«رُدُّوا بَالْكُمْ تَحْقْرُوا وَاحِدْ مِالصْغَارْ هَاذُومَا. نْقُولِلْكُمْ: مْلَايْكِتْهُمْ فِي السْمَاء دِيمَا يْشُوفُوا فِي وِجْهْ بَابَا الِّي فِي السْمَاء. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />عْلَى خَاطِرْ إِبْنْ الإِنْسَانْ جَاء بَاشْ يْنَجِّي الِّي مَاشِينْ لِلْهْلَاكْ.<verse eid="MAT 18:11" /></para>
  <para style="s">مَثَلْ العَلُّوشْ الضَّايَعْ</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />«شْنُوَّة رَايْكُمْ؟ إِذَا كَانْ رَاجِلْ عَنْدُو 100 عَلُّوشْ ووَاحِدْ مِنْهُمْ ضَاعْ، مُشْ يْخَلِّي الـ99 فِي الجْبَالْ ويِمْشِي يْلَوِّجْ عَالعَلُّوشْ الضَّايَعْ؟ <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />نْقُلْكُمْ الحَقْ: إِذَا كَانْ يَلْقَاهْ، رَاهُو بِشْ يِفْرَحْ بِيهْ أَكْثِرْ مِالـ99 الِّي مَا ضَاعُوشْ. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />هَكَّاكَا زَادَا بُوكُمْ الِّي فِي السْمَاء مَا يْحِبِّشْ وَاحِدْ مِالصْغَارْ هَاذُومَا يِمْشِي لِلْهْلَاكْ.<verse eid="MAT 18:14" /></para>
  <para style="s">كَانْ خُوكْ غْلُطْ فِي حَقِّكْ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />«إِذَا كَانْ خُوكْ غْلُطْ فِي حَقِّكْ، إِمْشِيلُو وأَحْكِي مْعَاهْ بِينِكْ وبِينُو، وكَانْ سْمَعْ مِنِّكْ، تْكُونْ رْبِحْتْ خُوكْ. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />وكَانْ مَا سْمَعْشْ مِنِّكْ، هِزْ مْعَاكْ وَاحِدْ وَلَّا زُوزْ أُخْرِينْ، بَاشْ مَا يْكُونْ فَمَّة حَتَّى حُكْمْ فِي القَضِيَّة إِلَّا مَا يْكُونْ فَمَّة زُوزْ وَلَّا ثْلَاثَة شْهُودْ. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />وكَانْ مَا حَبِّشْ يِسْمَعْ مِنْهُمْ، قُولْ لِلْكْنِيسَة، وإِذَا مَا حَبِّشْ يِسْمَعْ مِالكْنِيسَة زَادَا، عَامْلُو كِيمَا تْعَامِلْ الِّي مَاهُوشْ يْهُودِي وَلَّا كِيمَا المَكَّاسْ. <verse eid="MAT 18:17" /><verse number="18" style="v" sid="MAT 18:18" />نْقُلْكُمْ الحَقْ: كُلْ الِّي تُرْبْطُوهْ فِي الأَرْضْ يْكُونْ مَرْبُوطْ فِي السْمَاء، ولِّي تْحِلُّوهْ فِي الأَرْضْ يْكُونْ مَحْلُولْ فِي السْمَاء.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />«ونْقُلْكُمْ زَادَا: إِذَا كَانْ زُوزْ مِنْكُمْ يِتْفَاهْمُوا فِي الأَرْضْ عْلَى أَيْ حَاجَة يُطْلْبُوهَا، رَاهُو بَابَا الِّي فِي السْمَاء يَعْطِيهَالْهُمْ. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />عْلَى خَاطِرْ وِينْ يِتْلَمُّوا زُوزْ وَلَّا ثْلَاثَة بْإِسْمِي، آنَا نْكُونْ فِي وِسْطْهُمْ».<verse eid="MAT 18:20" /></para>
  <para style="s">مَثَلْ العَبْدْ الِّي مَا يْسَامَحْشْ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />وَقْتْهَا قْرُبْ بُطْرُسْ لْيَسُوعْ وسِأْلُو: «يَا سِيدِي، قَدَّاشْ مِنْ مَرَّة نْسَامَحْ خُويَا وَقْتِلِّي يُغْلُطْ فِي حَقِّي؟ سَبْعَة مَرَّاتْ؟». <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" />جَاوْبُو يَسُوعْ: «مُشْ سَبْعَة مَرَّاتْ، آمَا سَبْعِينْ مَرَّة سَبْعَة مَرَّاتْ.<verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />«هَاذَاكَا عْلَاشْ نْشَبَّهْ مَمْلَكْةْ السْمَاوَاتْ بْمَلِكْ حَبْ يْحَاسِبْ عَبِيدُو. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />وكِي بْدَا يْحَاسِبْ فِيهُمْ، جَابُولُو وَاحِدْ يْسَالُو بَرْشَة فْلُوسْ. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />وكِي طْلَعْ العَبْدْ مَا عَنْدُوشْ مْنِينْ يْخَلِّصْ، سِيدُو أْمَرْ بَاشْ يِتْبَاعْ هُوَّ ومَرْتُو وأَوْلَادُو وكُلْ مَا يِمْلِكْ، بَاشْ يْخَلِّصْ الدِّينْ الِّي عْلِيهْ. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />وَلَّى رْمَى رُوحُو قُدَّامُو وسْجِدْلُو وقَالْ: "يَا سِيدِي، أُصْبُرْ عْلِيَّا وتَوْ نْخَلْصِكْ فِي دْيُونِي الكُلْ!". <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />يَاخِي سْخِفْ عْلِيهْ سِيدُو، وسَامْحُو فِي دْيُونُو الكُلْ وسَيْبُو.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />«والعَبْدْ هَاذَا وهُوَّ خَارِجْ، لْقَى وَاحِدْ مِالعَبِيدْ صُوحَابُو كَانْ يْسَالُو شْوَيَّة فْلُوسْ، شَدْ خَنْقُو مِنْ رَقْبْتُو وقَالُّو: "خَلِّصْنِي فِلِّي نْسَالْهُمْلِكْ!". <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />يَاخِي العَبْدْ الآخِرْ رْمَى رُوحُو قُدَّامُو وتْشَحْتُو وقَالْ: "أُصْبُرْ عْلِيَّا، تَوْ نْخَلْصِكْ فِيهُمْ". <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />آمَا هُوَّ مَا حَبِّشْ ورْمَاهْ فِي الحَبْسْ حَتَّى لِينْ يْخَلِّصْ الدِّينْ الِّي عْلِيهْ. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />وكِي صُوحَابْهُمْ العَبِيدْ شَافُوا الِّي صَارْ، حِزْنُوا بَرْشَة ومْشَاوْ حْكَاوْ لْسِيدْهُمْ. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />عَيَّطْلُو سِيدُو وقَالُّو: "إِنْتِ عَبْدْ شِرِّيرْ! دْيُونِكْ الكُلْ سَامَحْتِكْ فِيهُمْ، عْلَى خَاطْرِكْ اتْشَحَّتْنِي. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />مُشْ كَانْ لَازْمِكْ تَرْحَمْ العَبْدْ صَاحْبِكْ كِيمَا آنَا رْحَمْتِكْ؟". <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />وتْغَشِّشْ سِيدُو بَرْشَة، ورْمَاهْ لِلْجَلَّادِينْ بَاشْ يْعَذْبُوهْ حَتَّى لِينْ يْخَلِّصْ دْيُونُو الكُلْ». <verse eid="MAT 18:34" /><verse number="35" style="v" sid="MAT 18:35" />وبَعْدْ قَالِلْهُمْ يَسُوعْ: «هَكَّا زَادَا يَعْمْلِلْكُمْ بَابَا الِّي فِي السْمَاء كَانْ مَا يْسَامَحْشْ كُلْ وَاحِدْ فِيكُمْ خُوهْ مِنْ قَلْبُو».<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">يَسُوعْ يْجَاوِبْ الفِرِّيسِيِّينْ عَالطْلَاقْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />وبَعْدْمَا كَمِّلْ يَسُوعْ كْلَامُو، خَلَّى مَنْطَقْةْ الجَلِيلْ ومْشَى لْمَنْطَقْةْ اليَهُودِيَّة الِّي وْرَاء نَهْرْ الأُرْدُنْ. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />وتَبْعُوهْ بَرْشَة نَاسْ، وشْفَاهُمْ غَادِي.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />وجَاوَهْ جْمَاعَة فِرِّيسِيِّينْ بَاشْ يْجَرْبُوهْ وسِأْلُوهْ: «يَاخِي حْلَالْ الرَّاجِلْ يْطَلَّقْ مَرْتُو لْأَيْ سْبَبْ؟». <verse eid="MAT 19:3" /><verse number="4" style="v" sid="MAT 19:4" />جَاوِبْهُمْ: «يَاخِي مَا قْرِيتُوشْ الِّي الخَالَقْ مِلِّي بْدَاتْ الدِّنْيَا، خْلَقْ الإِنْسَانْ ذْكَرْ وأَنْثَى، <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />وقَالْ: "هَاذَاكَا عْلَاشْ الرَّاجِلْ يْخَلِّي بُوهْ وأُمُّو ويِتْرْبَطْ بْمَرْتُو ويْوَلِّيوْ الإِثْنِينْ بْدَنْ وَاحِدْ"؟ <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />مَالَا هُومَا مَا عَادِشْ إِثْنِينْ، آمَا بْدَنْ وَاحِدْ. ولِّي جَمْعُو اللَّهْ مَا يْفَرْقُوشْ الإِنْسَانْ». <verse eid="MAT 19:6" /><verse number="7" style="v" sid="MAT 19:7" />يَاخِي سِأْلُوهْ: «مَالَا عْلَاشْ مُوسَى وَصَّى بَاشْ الرَّاجِلْ يَعْطِي وَرْقِةْ طْلَاقْ لْمَرْتُو كِي يْطَلَّقْهَا؟». <verse eid="MAT 19:7" /><verse number="8" style="v" sid="MAT 19:8" />جَاوِبْهُمْ يَسُوعْ: «مُوسَى خَلَّاكُمْ اطَّلْقُوا نْسَاكُمْ بِسْبَبْ كْسُوحِيِّةْ قْلُوبْكُمْ. آمَا الأُمُورْ مَا كَانِتْشْ هَكَّا مِالأُوِّلْ. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />وآنَا نْقُلْكُمْ:الِّي يْطَلَّقْ مَرْتُو لْأَيْ سْبَبْ غِيرْ الزْنَى ويْعَرِّسْ بِمْرَا أُخْرَى يَزْنَى، ولِّي يْعَرِّسْ بِمْرَا مْطَلْقَة يَزْنَى». <verse eid="MAT 19:9" /><verse number="10" style="v" sid="MAT 19:10" />قَالُولُو تْلَامِذْتُو: «إِذَا كَانْ هَاذَا حَالْ الرَّاجِلْ مْعَ المْرَا، مَالَا كَانْ مَا يْعَرِّسْشْ خِيرْ». <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" />آمَا هُوَّ قَالِلْهُمْ: «مُشْ النَّاسْ الكُلْ يِقْبْلُوا الكْلَامْ هَاذَا، آمَا كَانْ الِّي تِعْطَالْهُمْ بَاشْ يِقْبْلُوهْ. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />عْلَى خَاطِرْ فَمَّة نَاسْ تْوِلْدُوا مِنْ كْرُوشْ أُمَّاتْهُمْ مَا يْنَجْمُوشْ يْعَرْسُوا، وفَمَّة شْكُونْ الِّي خْصَاوْهُمْ النَّاسْ، وفَمَّة الِّي إِخْتَارُوا مَا يْعَرْسُوشْ عْلَى خَاطِرْ مَمْلَكْةْ السْمَاوَاتْ. ولِّي يْنَجِّمْ يِقْبِلْ هَاذَا خَلِّيهْ يِقْبْلُو».<verse eid="MAT 19:12" /></para>
  <para style="s">خَلِّيوْ الصْغَارْ يْجِيوْنِي</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />وفَمَّة نَاسْ جَابُولُو وْلَادْ صْغَارْ بَاشْ يْحُطْ عْلِيهُمْ يْدِيهْ ويْصَلِّي عْلَى خَاطِرْهُمْ. يَاخِي التْلَامْذَة لَامُوا عْلِيهُمْ. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />آمَا يَسُوعْ قَالْ: «خَلِّيوْ الصْغَارْ يْجِيوْنِي ومَا تَمْنْعُوهُمْشْ، عْلَى خَاطِرْ مَمْلَكْةْ السْمَاوَاتْ يُدْخْلُولْهَا النَّاسْ الِّي كِيفْهُمْ». <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />وحَطْ عْلِيهُمْ يْدِيهْ وبَارِكْهُمْ، ومْشَى مِالبْلَاصَة هَاذِيكَا.<verse eid="MAT 19:15" /></para>
  <para style="s">يَسُوعْ والغْنِيْ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />وجَاهْ وَاحِدْ وقَالُّو: «يَا مُعَلِّمْ، شْنِيَّة الأَعْمَالْ الصَّالْحَة الِّي لَازِمْنِي نَعْمِلْهُمْ بَاشْ نَاخِذْ الحَيَاةْ الأَبَدِيَّة؟». <verse eid="MAT 19:16" /><verse number="17" style="v" sid="MAT 19:17" />يَاخِي جَاوْبُو: «عْلَاشْ تِسْإِلْ فِيَّا عَالصَّلَاحْ؟ فَمَّة وَاحِدْ بَرْكْ صَالَحْ، آمَا إِذَا كَانْ تْحِبْ تُدْخُلْ لِلْحَيَاةْ الأَبَدِيَّة أَعْمِلْ بِالوْصَايَا». <verse eid="MAT 19:17" /><verse number="18" style="v" sid="MAT 19:18" />قَالُّو: «أَنَاهُمْ الوْصَايَا؟». قَالُّو يَسُوعْ: «مَا تَعْمِلْشْ جْرِيمِةْ قَتْلْ، مَا تَزْنَاشْ، مَا تِسْرِقْشْ، مَا تِشْهِدْشْ بِالكِذْبْ، <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />إِكْرِمْ بُوكْ وأُمِّكْ، وحِبْ قْرِيبِكْ كِيفْ مَا تْحِبْ رُوحِكْ». <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />قَالُّو: «الوْصَايَا هَاذُمْ الكُلْ نْطَبَّقْ فِيهُمْ مِلِّي آنَا صْغِيرْ، شْنُوَّة الِّي مَزَّالْ نَاقِصْنِي؟». <verse eid="MAT 19:20" /><verse number="21" style="v" sid="MAT 19:21" />جَاوْبُو يَسُوعْ: «إِذَا تْحِبْ تْكُونْ كَامِلْ، بِيعْ الِّي عَنْدِكْ الكُلْ وفَرْقُو عَالفْقَارَى، وهَكَّا يْوَلِّي عَنْدِكْ كِنْزْ فِي السْمَاء، ومْبَعِّدْ إِيجَا تَبَّعْنِي!» <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />كِي سْمَعْ الكْلَامْ هَاذَا، مْشَى وهُوَّ حْزِينْ، عْلَى خَاطْرُو كَانْ غْنِيْ بَرْشَة.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />يَاخِي يَسُوعْ قَالْ لِتْلَامِذْتُو: «نْقُلْكُمْ الحَقْ: صْعِيبْ عَالغْنِيْ إِنُّو يُدْخُلْ لْمَمْلَكْةْ السْمَاوَاتْ! <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />ونْزِيدْ نْقُلْكُمْ: دْخُولْ الجْمَلْ مِنْ نُقْبِةْ الإِبْرَة أَسْهِلْ مِنْ دْخُولْ الغْنِيْ لْمَمْلَكْةْ اللَّهْ». <verse eid="MAT 19:24" /><verse number="25" style="v" sid="MAT 19:25" />تْعَجْبُوا التْلَامْذَة بَرْشَة مِالكْلَامْ هَاذَا وقَالُوا: «مَالَا شْكُونْ يْنَجِّمْ يِنْجَى؟». <verse eid="MAT 19:25" /><verse number="26" style="v" sid="MAT 19:26" />خْزَرِّلْهُمْ يَسُوعْ وقَالْ: «هَاذَا مُسْتَحِيلْ عَنْدْ النَّاسْ، آمَا عَنْدْ اللَّهْ كُلْ شَيْ مُمْكِنْ».<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />يَاخِي بُطْرُسْ قَالُّو: «هَانَا أَحْنَا خَلِّينَا كُلْ شَيْ وتَبَّعْنَاكْ، شْنُوَّة بِشْ نَاخْذُوا؟». <verse eid="MAT 19:27" /><verse number="28" style="v" sid="MAT 19:28" />جَاوِبْ يَسُوعْ: «نْقُلْكُمْ الحَقْ: فِي زْمَانْ تَجْدِيدْ كُلْ شَيْ، وَقْتِلِّي إِبْنْ الإِنْسَانْ يُقْعُدْ عْلَى عَرْشْ مَجْدُو، إِنْتُومَا زَادَا الِّي تَبَّعْتُونِي بِشْ تُقْعْدُوا عْلَى أَثْنَاشِنْ عَرْشْ وتُحْكْمُوا عْلَى قَبَائِلْ بَنِي إِسْرَائِيلْ الأَثْنَاشْ. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />وأَيْ وَاحِدْ خَلَّى دْيَارْ وَلَّا إِخْوَة وَلَّا خْوَاتْ، وَلَّا بُو، وَلَّا أُمْ، وَلَّا وْلَادْ، وَلَّا أَرَاضِي عْلَى خَاطِرْ إِسْمِي، بِشْ يَاخِذْ قَدْهُمْ 100 مَرَّة ويُورِثْ الحَيَاةْ الأَبَدِيَّة. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />وبَرْشَة نَاسْ كَانُوا الأُولَانِينْ بِشْ يْوَلِّيوْ الإِخْرَانِينْ، ونَاسْ كَانُوا الإِخْرَانِينْ بِشْ يْوَلِّيوْ الأُولَانِينْ».<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">مَثَلْ الخَدَّامَة</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />«رَاهِي مَمْلَكْةْ السْمَاوَاتْ تْشَبَّهْ لْرَاجِلْ عَنْدُو أَرْضْ، خْرَجْ مِالفَجْرْ بَاشْ يْجِيبْ خَدَّامَة لْسَانْيِةْ العْنِبْ مْتَاعُو. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />وتْفَاهِمْ مْعَ الخَدَّامَة بَاشْ يَعْطِيهُمْ بْيَاسَة فُضَّة فِي النْهَارْ، وبْعَثْهُمْ لْسَانِيتُو. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />وخْرَجْ قْرِيبْ التِّسْعَة مْتَاعْ الصْبَاحْ، يَاخِي شَافْ خَدَّامَة أُخْرِينْ وَاقْفِينْ فِي السُّوقْ مِنْ غِيرْ خِدْمَة <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />وقَالِلْهُمْ: "إِمْشِيوْ إِنْتُومَا زَادَا لْسَانْيِةْ العْنِبْ، وتَوْ نَعْطِيكُمْ حَقْكُمْ". يَاخِي مْشَاوْ. <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />وخْرَجْ مَرَّة أُخْرَى قْرِيبْ نُصْ النْهَارْ، ومَرَّة أُخْرَى مْعَ مَاضِي ثْلَاثَة مْتَاعْ العْشِيَّة، وعْمَلْ نَفْسْ الحْكَايَة. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />وخْرَجْ قْرِيبْ الخَمْسَة مْتَاعْ العْشِيَّة، ولْقَى خَدَّامَة أُخْرِينْ وَاقْفِينْ، وقَالِلْهُمْ: "شْبِيكُمْ وَاقْفِينْ هُونِي نْهَارْ كَامِلْ بْلَا خِدْمَة؟". <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />قَالُولُو: "مَا عَيْطِلْنَا حَدْ بَاشْ نِخْدْمُوا". يَاخِي قَالِلْهُمْ: "إِمْشِيوْ إِنْتُومَا زَادَا لْسَانْيِةْ العْنِبْ". <verse eid="MAT 20:7" /><verse number="8" style="v" sid="MAT 20:8" />وفِي آخِرْ النْهَارْ، قَالْ مُولَى السَّانْيَة لِلِّي لَاهِي بِالخَدَّامَة: "عَيِّطْ لِلْخَدَّامَة وخَلَّصْهُمْ، وأَبْدَى بِلِّي جَاوْ الإِخْرَانِينْ حَتَّى لِينْ تُوصِلْ لِلِّي جَاوْ الأُولَانِينْ".<verse eid="MAT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9" />«وجَاوْ الِّي بْدَاوْ يِخْدْمُوا مْعَ الخَمْسَة مْتَاعْ العْشِيَّة، وخْذَا كُلْ وَاحِدْ فِيهُمْ بْيَاسَة فُضَّة. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />ووَقْتِلِّي جَاوْ الِّي بْدَاوْ الأُولَانِينْ، مْشَى فِي بَالْهُمْ بِشْ يَاخْذُوا أَكْثِرْ مِالأُخْرِينْ، آمَا كُلْ وَاحِدْ فِيهُمْ خْذَا بْيَاسَة فُضَّة. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />وهُومَا قَاعْدِينْ يُخْلْصُوا، بْدَاوْ يِتْشَكَّاوْ عْلَى مُولَى السَّانْيَة، <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />ويْقُولُوا: "هَاذُومَا الِّي جَاوْ الإِخْرَانِينْ خِدْمُوا سَاعَة وَحْدَة، وإِنْتِ خَلَّصْتْهُمْ كِيفْنَا أَحْنَا الِّي خْدِمْنَا نْهَارْ كَامِلْ فِي السْخَانَة!". <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />آمَا مُولَى السَّانْيَة جَاوِبْ وَاحِدْ مِنْهُمْ: "يَا صَاحْبِي، آنَا رَانِي مَا ظْلَمْتِكْشْ. يَاخِي مُشْ تْفَاهِمْتْ مْعَاكْ عْلَى بْيَاسَة فُضَّة؟ <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />خُوذْ حَقِّكْ وإِمْشِي. هَاذَا الِّي جَاء فِي الإِخِّرْ نْحِبْ نَعْطِيهْ كِيفِكْ، <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />يَاخِي مَا عَنْدِيشْ الحَقْ نِتْصَرِّفْ فِي فْلُوسِي كِيفْ مَا نْحِبْ؟ وَلَّا إِنْتِ حْسُودِي عْلَى خَاطِرْنِي آنَا كْرِيمْ؟"». <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" />وقَالْ يَسُوعْ: «وهَكَّا الإِخْرَانِينْ يْوَلِّيوْ الأُولَانِينْ، والأُولَانِينْ يْوَلِّيوْ الإِخْرَانِينْ».<verse eid="MAT 20:16" /></para>
  <para style="s">يَسُوعْ يِتْنَبَّأْ بْمُوتُو وقْيَامْتُو مَرَّة أُخْرَى</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />ويَسُوعْ طَالَعْ لْأُورْشَلِيمْ، جْبِدْ الأَثْنَاشِنْ تِلْمِيذْ عْلَى جْنَبْ فِي الطْرِيقْ، وقَالِلْهُمْ: <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />«أَحْنَا طَالْعِينْ لْأُورْشَلِيمْ، وغَادِي، بِشْ يْسَلْمُوا إِبْنْ الإِنْسَانْ لِكْبَارْ الكَهَنَة وعُلَمَاءْ الشَّرِيعَة، وبِشْ يُحْكْمُوا عْلِيهْ بِالمُوتْ، <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />ويْسَلْمُوهْ فِي يْدِينْ نَاسْ مَاهُمْشْ يْهُودْ، بَاشْ يْهِينُوهْ ويِجْلْدُوهْ ويُصْلْبُوهْ، وفِي النْهَارْ الثَّالِثْ يْقُومْ».<verse eid="MAT 20:19" /></para>
  <para style="s">الِّي يْحِبْ يْكُونْ فِيكُمْ عْظِيمْ، لَازِمْ يْكُونْ لِيكُمْ خْدِيمْ</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />وجَاتُو أُمْ وْلَادْ زَبَدِي ومْعَاهَا وْلَادْهَا الزُّوزْ، وسِجْدِتْلُو وطَلْبِتْ مِنُّو حَاجَة. <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />يَاخِي قَالِلْهَا: «شْنِيَّة تْحِبْ؟». قَالِتْلُو: «أُأْمُرْ إِنُّو وْلَادِي هَاذُومَا الزُّوزْ يُقْعْدُوا وَاحِدْ عْلَى يْمِينِكْ والآخِرْ عْلَى يْسَارِكْ فِي مَمْلَكْتِكْ». <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />جَاوِبْهُمْ يَسُوعْ: «إِنْتُومَا مُشْ عَارْفِينْ فَاشْ قَاعْدِينْ تُطْلْبُوا. تْنَجْمُوا تُشْرْبُوا الكَاسْ الِّي بِشْ نُشْرُبُو آنَا؟». قَالُولُو: «انَّجْمُوا!». <verse eid="MAT 20:22" /><verse number="23" style="v" sid="MAT 20:23" />قَالِلْهُمْ: «إِنْتُومَا بِشْ تُشْرْبُوا الكَاسْ مْتَاعِي، آمَا القَعْدَة عْلَى يْمِينِي وعْلَى يْسَارِي مَا انَّجِّمْ نَعْطِيهَا كَانْ لِلِّي حَضَّرْهَالْهُمْ بَابَا».<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />ووَقْتِلِّي سَمْعُوا التْلَامْذَة العَشْرَة الأُخْرِينْ هَاذَا، تْغَشْشُوا عَالأَخْوَة الزُّوزْ. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />يَاخِي عَيْطِلْهُمْ يَسُوعْ وقَالِلْهُمْ: «إِنْتُومَا تَعْرْفُوا الِّي حُكَّامْ الشُّعُوبْ يْسَيْطْرُوا عْلِيهُمْ، ولِّي عَنْدْهُمْ السُّلْطَة يِتْسَلْطُوا عْلِيهُمْ. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />وهَاذَا مَا يِلْزْمُوشْ يْكُونْ بِينَاتْكُمْ، آمَا الِّي يْحِبْ يْكُونْ فِيكُمْ عْظِيمْ، لَازِمْ يْكُونْ لِيكُمْ خْدِيمْ. <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />ولِّي يْحِبْ يْوَلِّي الأُوِّلْ فِيكُمْ، خَلِّيهْ يْكُونْ عَبْدْ لِيكُمْ، <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />كِيفْ مَا إِبْنْ الإِنْسَانْ جَاء مُشْ بَاشْ يِخْدْمُوهْ النَّاسْ، آمَا بَاشْ يِخْدِمْهُمْ ويِفْدِي بِحْيَاتُو بَرْشَة مِنْهُمْ».<verse eid="MAT 20:28" /></para>
  <para style="s">يَسُوعْ يِشْفِي زُوزْ عِمْيَانْ</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />وكِي جَاوْ خَارْجِينْ مِنْ أَرِيحَا، تَبْعُوهْ بَرْشَة نَاسْ. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />وكَانْ فَمَّة زُوزْ عِمْيَانْ قَاعْدِينْ بِجْنَبْ الطْرِيقْ، وسَمْعُوا الِّي يَسُوعْ مِتْعَدِّي مِنْ غَادِي. يَاخِي بْدَاوْ يْعَيْطُوا: «يَا سِيدْنَا، يَا وِلْدْ دَاوِدْ أَرْحَمْنَا!». <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />يَاخِي النَّاسْ صَاحُوا عْلِيهُمْ بَاشْ يُسْكْتُوا. آمَا هُومَا عَيْطُوا أَكْثِرْ: «يَا سِيدْنَا، يَا وِلْدْ دَاوِدْ أَرْحَمْنَا!». <verse eid="MAT 20:31" /><verse number="32" style="v" sid="MAT 20:32" />يَاخِي وْقِفْ يَسُوعْ وعَيْطِلْهُمْ وقَالِلْهُمْ: «آشْ تْحِبُّونِي نَعْمْلِلْكُمْ؟». <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />قَالُولُو: «يَا سِيدْنَا، نْحِبُّوكْ تْحِلِّلْنَا عِينِينَا!». <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />يَاخِي حَنْ عْلِيهُمْ يَسُوعْ ومَسِّلْهُمْ عِينِيهُمْ، وبِالوَقْتْ وَلَّاوْ يْشُوفُوا وتَبْعُوهْ.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">يَسُوعْ يُدْخُلْ لْأُورْشَلِيمْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />ووَقْتِلِّي قْرُبْ يَسُوعْ وتْلَامِذْتُو مِنْ أُورْشَلِيمْ، ووُصْلُوا لْدَشْرِةْ بِيتْ فَاجِي الِّي بَحْذَا جْبَلْ الزِّيتُونْ، بْعَثْ يَسُوعْ زُوزْ مِنْ تْلَامِذْتُو، <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />وقَالِلْهُمْ: «إِمْشِيوْ لِلدَّشْرَة الِّي مْقَابْلِتْكُمْ، تَوْ تَلْقَاوْ بْهِيمَة مَرْبُوطَة ومْعَاهَا جَحْشْ، حِلُّولْهُمْ الرْبَاطْ وجِيبُوهُمْلِي. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />وكَانْ حَدْ كَلَّمْكُمْ، قُولُولُو: "سِيدْنَا حَاشْتُو بِيهُمْ، وتَوْ فِيسَعْ يْرَجَّعْهُمْ"».<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />وهَاذَا صَارْ بَاشْ يْتِمْ الِّي قَالُّو اللَّهْ عْلَى لْسَانْ النَّبِيْ:<verse eid="MAT 21:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />«قُولُوا لْبِنْتْ صِهْيَوْنْ:</para>
  <para style="q2" vid="MAT 21:5">هَاوْ المَلِكْ مْتَاعِكْ جَايِكْ،</para>
  <para style="q1" vid="MAT 21:5">جَايِكْ مِتْوَاضَعْ ورَاكِبْ عْلَى بْهِيمَة،</para>
  <para style="q2" vid="MAT 21:5">رَاكِبْ عْلَى جَحْشْ وِلْدْ بْهِيمَة».<verse eid="MAT 21:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />يَاخِي مْشَاوْ التْلَامْذَة الزُّوزْ، وعَمْلُوا كِيمَا أْمَرْهُمْ يَسُوعْ. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />وجَابُوا البْهِيمَة والجَّحْشْ وحَطُّوا عْلِيهُمْ حْوَايِجْهُمْ، ورْكِبْ يَسُوعْ. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />وبَرْشَة نَاسْ فِرْشُوا حْوَايِجْهُمْ عَالطْرِيقْ، ونَاسْ أُخْرِينْ فِرْشُوا أَعْرَافْ قَصُّوهَا مِالشْجَرْ. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />وكَانُوا النَّاسْ الِّي يِمْشِيوْ قُدَّامُو ووْرَاهْ يْعَيْطُوا:</para>
  <para style="b" vid="MAT 21:9" />
  <para style="q1" vid="MAT 21:9">«أُوصَنَّا لْوِلْدْ دَاوِدْ!</para>
  <para style="q2" vid="MAT 21:9">مُبَارَكْ الِّي جَايْ بْإِسْمْ الرَّبْ!</para>
  <para style="q1" vid="MAT 21:9">أُوصَنَّا فِي السْمَاء!».<verse eid="MAT 21:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />وكِي دْخَلْ يَسُوعْ لْأُورْشَلِيمْ خَاضِتْ المْدِينَة الكُلْ وبْدَاوْ النَّاسْ يِسْأْلُوا: «شْكُونُو هَاذَا؟». <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />ولِّي دَايْرِينْ بِيهْ جَاوْبُوا: «هَاذَا النَّبِيْ يَسُوعْ الِّي مِالنَّاصْرَة فِي مَنْطَقْةْ الجَلِيلْ».<verse eid="MAT 21:11" /></para>
  <para style="s">يَسُوعْ يْطَرِّدْ البَيَّاعَة مِالهَيْكِلْ</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />ودْخَلْ يَسُوعْ لِلْهَيْكِلْ وطَرِّدْ كُلْ الِّي كَانُوا يْبِيعُوا ويِشْرِيوْ غَادِي، وقْلِبْ طْوَاوِلْ النَّاسْ الِّي يْصَرْفُوا فِي الفْلُوسْ وكْرَاسِي الِّي يْبِيعُوا فِي الحْمَامْ، <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />وقَالِلْهُمْ: «مَكْتُوبْ بِلِّي: "دَارِي بِشْ تِتْسَمَّى دَارْ صْلَاةْ، آمَا إِنْتُومَا رَدِّيتُوهَا مْغَارِةْ سُرَّاقْ!"».<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />وهُوَّ فِي الهَيْكِلْ، جَاوَهْ العِمْيَانْ والعَايْبِينْ يَاخِي شْفَاهُمْ. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />آمَا كْبَارْ الكَهَنَة وعُلَمَاءْ الشَّرِيعَة تْغَشْشُوا وَقْتِلِّي شَافُوا المُعْجْزَاتْ الِّي عْمَلْهَا والأَوْلَادْ الصْغَارْ يْعَيْطُوا فِي الهَيْكِلْ: «أُوصَنَّا لْوِلْدْ دَاوِدْ!». <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />وقَالُولُو: «يَاخِي تِسْمَعْ فَاشْ قَاعْدِينْ يْقُولُوا؟». قَالِلْهُمْ يَسُوعْ: «إِيْ نْعَمْ، يَاخِي عْمُرْكُمْ مَا قْرِيتُوا الآيَة هَاذِي:</para>
  <para style="b" vid="MAT 21:16" />
  <para style="q1" vid="MAT 21:16">"مِنْ أَفَّامْ الصْغَارْ ولِّي مَزَّالُوا يَرْضْعُوا،</para>
  <para style="q2" vid="MAT 21:16">خَرَّجْتْ حَمْدْ لِلَّهْ"؟».<verse eid="MAT 21:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />وخَلَّاهُمْ وخْرَجْ مِالمْدِينَة لْدَشْرِةْ بِيتْ عَنْيَا، وبَاتْ غَادِي.<verse eid="MAT 21:17" /></para>
  <para style="s">كَرْمَة بْلَا غَلَّة</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />وفِي الصْبَاحْ وهُوَّ رَاجَعْ لِلْمْدِينَة، جَاعْ. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />وشَافْ كَرْمَة عْلَى حَافِّةْ الطْرِيقْ، مْشَالْهَا، آمَا مَا لْقَى فِيهَا كَانْ الأَوْرَاقْ. يَاخِي قَالِلْهَا: «مَا عَادِشْ بِشْ تْجِي مِنِّكْ غَلَّة لِلْأَبَدْ!». وبِالوَقْتْ يِبْسِتْ الكَرْمَة. <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />وكِي شَافُوا التْلَامْذَة الِّي صَارْ، تْعَجْبُوا وقَالُوا: «كِيِفَاشْ يِبْسِتْ الكَرْمَة بِالوَقْتْ؟». <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />جَاوِبْهُمْ يَسُوعْ: «نْقُلْكُمْ الحَقْ: إِذَا كَانْ عَنْدْكُمْ إِيمَانْ ومَا تْشُكُّوشْ، مُشْ بِشْ تَعْمْلُوا الِّي عْمَلْتُو آنَا لِلْكَرْمَة أَكَهَوْ، آمَا حَتَّى كَانْ تْقُولُوا لِلجْبَلْ هَاذَا: "اتْقَلَّعْ واتْرْمَى فِي البْحَرْ"، بِشْ يْصِيرْ بِالحَقْ. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />كُلْ الِّي تُطْلْبُوهْ فِي الصْلَاةْ بْإِيمَانْ، تَاخْذُوهْ».<verse eid="MAT 21:22" /></para>
  <para style="s">سُلْطِة يَسُوعْ</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />ومْشَى يَسُوعْ لِلْهَيْكِلْ. وهُوَّ يْعَلِّمْ، جَاوَهْ كْبَارْ الكَهَنَة وشْيُوخْ الشَّعْبْ وسِأْلُوهْ: «بَانَا سُلْطَة تَعْمِلْ فِي الحَاجَاتْ هَاذِي؟ وشْكُونْ عْطَاهَالِكْ السُّلْطَة؟». <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />جَاوِبْهُمْ يَسُوعْ: «وآنَا زَادَا بِشْ نِسْإِلْكُمْ سُؤَالْ وَاحِدْ، وكَانْ تْجَاوْبُونِي، نْقُلْكُمْ بَانَا سُلْطَة نَعْمِلْ فِي الحَاجَاتْ هَاذِي: <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />شْكُونْ عْطَى السُّلْطَة لْيُوحَنَّا بَاشْ يْعَمِّدْ؟ اللَّهْ وَلَّا النَّاسْ؟». يَاخِي تْشَاوْرُوا مَا بِينَاتْهُمْ وقَالُوا: «إِذَا قُلْنَا: "مِنْ عَنْدْ اللَّهْ" تَوْ يْقُولْ: "مَالَا عْلَاشْ مَا أَمَّنْتُوشْ بِلِّي جَاء بِيهْ؟" <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />وإِذَا قُلْنَا "مِنْ عَنْدْ النَّاسْ"، نْخَافُوا لَا الشَّعْبْ يْهِيجْ عْلِينَا، عْلَى خَاطِرْهُمْ مُقْتَنْعِينْ الِّي يُوحَنَّا نَبِيْ». <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />يَاخِي جَاوْبُوهْ: «مَا نَعْرْفُوشْ». قَالِلْهُمْ يَسُوعْ: «حَتَّى آنَا مَا نْقُلْكُمْشْ بَانَا سُلْطَة نَعْمِلْ فِي الحَاجَاتْ هَاذِي».<verse eid="MAT 21:27" /></para>
  <para style="s">مَثَلْ الزُّوزْ أَوْلَادْ</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />«شْنِيَّة رَايْكُمْ؟ كَانْ فَمَّة رَاجِلْ عَنْدُو زُوزْ وْلَادْ. مْشَى لِلْأُوِّلْ وقَالُّو: "يَا وِلْدِي، إِمْشِي اليُومْ وإِخْدِمْ فِي سَانْيِةْ العْنِبْ". <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />يَاخِي جَاوْبُو وِلْدُو: "مَا نْحِبِّشْ نِمْشِي". آمَا مْبَعِّدْ نْدِمْ ومْشَى. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />وجَاء لْوِلْدُو الثَّانِي وقَالُّو نَفْسْ الشَّيْ، يَاخِي جَاوْبُو: "هَانِي مَاشِي يَا بَابَا!" آمَا مَا مْشَاشْ. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />شْكُونْ مِنْهُمْ عْمَلْ الِّي حَبْ عْلِيهْ البُو؟». قَالُولُو: «الأُوِّلْ». قَالِلْهُمْ يَسُوعْ: «نْقُولِلْكُمْ الحَقْ: المَكَّاسَة والعَاهْرَاتْ بِشْ يُدْخْلُوا قْبَلْكُمْ لْمَمْلَكْةْ اللَّهْ. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />عْلَى خَاطِرْ يُوحَنَّا جَاء بَاشْ يْوَرِّيكُمْ طْرِيقْ الصَّلَاحْ وإِنْتُومَا مَا صَدَّقْتُوهُشْ، آمَا المَكَّاسَة والعَاهْرَاتْ صَدْقُوهْ. وإِنْتُومَا حَتَّى بَعْدْمَا شُفْتُوا هَاذَا، مَا نْدِمْتُوشْ ومَا صَدَّقْتُوهُشْ.<verse eid="MAT 21:32" /></para>
  <para style="s">مَثَلْ الفَلَّاحَة</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />«إِسْمْعُوا مَثَلْ آخِرْ: فَمَّة رَاجِلْ زْرَعْ سَانْيَة عْنِبْ، ودَوِّرْ بِيهَا سُورْ، وعْمَلْ فِيهَا مَعْصْرَة وبْنَى بُرْجْ، وكْرَاهَا لْفَلَّاحَة وسَافِرْ. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />وكِي قْرُبْ وَقْتْ الصَّابَة، بْعَثْ خَدَّامْتُو لِلْفَلَّاحَة بَاشْ يَبْعْثُولُو بَايُو مِنْهَا. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />يَاخِي الفَلَّاحَة شَدُّوا خَدَّامْتُو الِّي بْعَثْهُمْ، وضَرْبُوا وَاحِدْ، وقَتْلُوا الآخِرْ، ورَجْمُوا الثَّالِثْ بِالحْجَرْ. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />وبَعْدْهَا، بْعَثْ مُولَى السَّانْيَة خَدَّامَة أُخْرِينْ أَكْثِرْ مِالمَرَّة الأُولَى، يَاخِي عَمْلُوا فِيهُمْ نَفْسْ الشَّيْ. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />وفِي الإِخِّرْ بْعَثِّلْهُمْ وِلْدُو وقَالْ: "تَوْ يْقَدْرُوا وِلْدِي". <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />وكِي الفَلَّاحَة شَافُوا الوْلِدْ قَالُوا لِبْعَضْهُمْ: "أَهَوَّا الوْرِيثْ، هَيَّا نُقْتْلُوهْ ونَاخْذُوا أَحْنَا الوَرْثَة مْتَاعُو!". <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />وشَدُّوهْ وكَرْكْرُوهْ لْبَرَّا مِالسَّانْيَة وقَتْلُوهْ. <verse eid="MAT 21:39" /><verse number="40" style="v" sid="MAT 21:40" />مَالَا كِي يِرْجَعْ مُولَى السَّانْيَة، شْنِيَّة بِشْ يَعْمِلْ فِيهُمْ الفَلَّاحَة هَاذُومَا؟». <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />جَاوْبُوهْ: «يُقْتُلْهُمْ قَتْلَانْ الأَشْرَارْ هَاذُومَا، ويِكْرِي سَانْيِةْ العْنِبْ لْفَلَّاحَة أُخْرِينْ يَعْطِيوَهْ بَايُو مِالصَّابَة فِي وَقْتْهَا». <verse eid="MAT 21:41" /><verse number="42" style="v" sid="MAT 21:42" />قَالِلْهُمْ يَسُوعْ: «يَاخِي عْمُرْكُمْ مَا قْرِيتُوا فِي الكْتُبْ المُقَدْسَة:</para>
  <para style="b" vid="MAT 21:42" />
  <para style="q1" vid="MAT 21:42">"الحَجْرَة الِّي رَفْضُوهَا البَنَّايَا،</para>
  <para style="q2" vid="MAT 21:42">وَلَّاتْ حَجْرِةْ السَّاسْ.</para>
  <para style="q1" vid="MAT 21:42">هَاذَا آشْ عْمَلْ الرَّبْ،</para>
  <para style="q2" vid="MAT 21:42">وهَاذِي حَاجَة عْجِيبَة بِالنِّسْبَة لِينَا!"<verse eid="MAT 21:42" /></para>
  <para style="b" />
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />«هَاذَاكَا عْلَاشْ نْقُلْكُمْ: مَمْلَكْةْ اللَّهْ بِشْ تِتْفَكِّلْكُمْ وتِتْعْطَى لْشَعْبْ يَعْمِلْ الِّي يُطْلْبُو مِنْهُمْ اللَّهْ. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />الِّي يْطِيحْ عَالحَجْرَة هَاذِي يِتْكَسِّرْ، ولِّي اطِّيحْ عْلِيهْ الحَجْرَة هَاذِي يِدَّڨْدِڨْ».<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />ووَقْتِلِّي سَمْعُوا كْبَارْ الكَهَنَة والفِرِّيسِيِّينْ الزُّوزْ أَمْثَالْ هَاذُومَا، فِهْمُوا الِّي هُوَّ كَانْ يُقْصِدْ فِيهُمْ. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />وحَبُّوا يْشِدُّوهْ، آمَا خَافُوا مِالشَّعْبْ، عْلَى خَاطِرْهُمْ كَانُوا يِعْتَبْرُوهْ نَبِيْ.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">مَثَلْ عْشَاء العِرْسْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />وكَلَّمْهُمْ يَسُوعْ مَرَّة أُخْرَى بِالأَمْثَالْ وقَالْ: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />«مَمْلَكْةْ السْمَاوَاتْ تْشَبَّهْ لْمَلِكْ عْمَلْ عْشَاء فِي عِرْسْ وِلْدُو. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />وبْعَثْ عَبِيدُو بَاشْ يْعَيْطُوا لِلْمِسْتِدْعِينْ لِلْعِرْسْ، يَاخِي مَا حَبُّوشْ يْجِيوْ. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />يَاخِي بْعَثْ المَلِكْ عَبِيدْ أُخْرِينْ وقَالِلْهُمْ: "قُولُوا لِلْمِسْتِدْعِينْ: عْشَايَا حْضَرْ. ذْبَحْتْ ثِيرَانِي وعْجُولِي السْمَانْ وكُلْ شَيْ حَاضِرْ. إِيجَاوْ لِلْعِرْسْ!". <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />آمَا هُومَا مَا اهْتَمُّوشْ، ومْشَاوْ وَاحِدْ لْسَانِيتُو، والآخِرْ لْحَانُوتُو، <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />والبْقِيَّة شَدُّوا عَبِيدْ المَلِكْ وسَبُّوهُمْ وقَتْلُوهُمْ. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />يَاخِي المَلِكْ تْغَشِّشْ وبْعَثْ العَسْكِرْ مْتَاعُو وقْتَلْ المْجَرْمَة هَاذُوكُمْ وحْرَقِّلْهُمْ مْدِينِتْهُمْ. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />ومْبَعِّدْ قَالْ لْعَبِيدُو: "العْشَاء حَاضِرْ، آمَا المِسْتَدْعِينْ مَا يِسْتَاهْلُوشْ، <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />إِمْشِيوْ لِلشْوَارَعْ ولِّي تَلْقَاوَهْ إِسْتَدْعَاوَهْ لِعْشَاء العِرْسْ". <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />وخَرْجُوا العَبِيدْ لِلشْوَارَعْ، ولَمُّوا النَّاسْ عْلَى بْعَضْهُمْ أَشْرَارْ وصَالْحِينْ، حَتَّى لِينْ تِمْلَاتْ صَالِةْ العِرْسْ بِالضْيَافْ. <verse eid="MAT 22:10" /><verse number="11" style="v" sid="MAT 22:11" />آمَا كِي دْخَلْ المَلِكْ بَاشْ يْشُوفْ الضْيَافْ، شَافْ رَاجِلْ مُشْ لَابِسْ لِبْسِةْ العِرْسْ. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />يَاخِي قَالُّو: "يَا صَاحْبِي، كِيفَاشْ دْخَلْتْ هْنَا وإِنْتِ مَاكِشْ لَابِسْ لِبْسِةْ العِرْسْ؟". آمَا الرَّاجِلْ مَا لْقَى مَا يْجَاوِبْ. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />وَقْتْهَا قَالْ المَلِكْ لِلْعَبِيدْ: "كَتْفُوهْ مِنْ يْدِيهْ وسَاقِيهْ وطَيْشُوهْ لْبَرَّة فِي الظْلَامْ، غَادِي يْكُونْ البْكَاء والنْدَمْ". <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />عْلَى خَاطِرْ المِسْتَدْعِينْ بَرْشَة والمُخْتَارِينْ شْوَيَّة».<verse eid="MAT 22:14" /></para>
  <para style="s">الضَّرَايِبْ لِلْقَيْصِرْ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />وَقْتْهَا مْشَاوْ الفِرِّيسِيِّينْ وتْفَاهْمُوا كِيفَاشْ يْحَصْلُوا يَسُوعْ بْكِلْمَة. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />يَاخِي بَعْثُولُو تْلَامْذِتْهُمْ ومْعَاهُمْ جْمَاعَة تَابْعِينْ هِيرُودُسْ وقَالُولُو: «يَا مُعَلِّمْ، أَحْنَا نَعْرْفُوا الِّي إِنْتِ صَادِقْ، وتْعَلِّمْ طْرِيقْ اللَّهْ بِالحَقْ، ومَا تْخَافْ مِنْ حَدْ. عْلَى خَاطْرِكْ مَا تِتْعَامِلْشْ بِالوْجُوهْ. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />قُولِلْنَا: شْنِيَّة رَايِكْ؟ يَاخِي حْلَالْ نَدْفْعُوا الضَّرَايِبْ لِلْقَيْصِرْ وَلَّا لَا؟». <verse eid="MAT 22:17" /><verse number="18" style="v" sid="MAT 22:18" />وعْرَفْ يَسُوعْ الِّي هُومَا يِتْخُوبْثُوا، وقَالِلْهُمْ: «يَا مُنَافْقِينْ! عْلَاشْ تْحِبُّوا تْحَصْلُونِي؟ <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />وَرِّيوْنِي الفْلُوسْ الِّي تْخَلْصُوا بِيهَا فِي الضَّرِيبَة!». يَاخِي مَدُّولُو بْيَاسَة فُضَّة. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />قَالِلْهُمْ يَسُوعْ: «مْتَاعْ شْكُونْ التَّصْوِيرَة هَاذِي، وإِسْمْ شْكُونْ هَاذَا؟» <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />قَالُوا: «مْتَاعْ القَيْصِرْ!»، قَالِلْهُمْ: «مَالَا أَعْطِيوْ الِّي يْخُصْ القَيْصِرْ لِلْقَيْصِرْ، ولِّي يْخُصْ اللَّهْ لِلَّهْ». <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />وتْعَجْبُوا مِلِّي سَمْعُوهْ، وخَلَّاوَهْ ومْشَاوْ.<verse eid="MAT 22:22" /></para>
  <para style="s">يَسُوعْ يْجَاوِبْ الصَّدُّوقِيِّينْ عَالقْيَامَة</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />وفِي نَفْسْ النْهَارْ، جَاوْ لْيَسُوعْ جْمَاعَة مِالصَّدُّوقِيِّينْ الِّي مَا يَمْنُوشْ بِلِّي فَمَّة قْيَامَة بَعْدْ المُوتْ، وسِأْلُوهْ: <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />«يَا مُعَلِّمْ، مُوسَى قَالْ: "إِذَا رَاجِلْ مَاتْ ومَا خَلَّاشْ صْغَارْ، لَازِمْ خُوهْ يْعَرِّسْ بْمَرْتُو ويْجِيبْ صْغَارْ ويْقَيِّدْهُمْ بْإِسْمْ خُوهْ الِّي مَاتْ". <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />وكَانْ عَنَّا سَبْعَة أَخْوَة، وعَرِّسْ الأُولَانِي ومَاتْ مِنْ غِيرْ مَا يْجِيبْ صْغَارْ، يَاخِي مَرْتُو خْذَاهَا خُوهْ. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />وصَارْ نَفْسْ الشَّيْ مْعَ الثَّانِي والثَّالِثْ حَتَّى لِلْخُو السَّابَعْ. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />وبَعْدْهُمْ الكُلْ، مَاتِتْ المْرَا زَادَا. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />مَالَا فِي نْهَارْ القْيَامَة، بِشْ تْكُونْ مَرْتْ شْكُونْ فِيهُمْ؟ هَايْ عَرْسِتْ بِيهُمْ السَّبْعَة!». <verse eid="MAT 22:28" /><verse number="29" style="v" sid="MAT 22:29" />جَاوِبْهُمْ يَسُوعْ: «إِنْتُومَا غَالْطِينْ، عْلَى خَاطِرْكُمْ مَا تِفْهْمُوشْ لَا الكْتُبْ المُقَدْسَة ولَا قُوِّةْ اللَّهْ! <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />عْلَى خَاطِرْ بَعْدْ القْيَامَة مِالمُوتْ، النَّاسْ لَا يْعَرْسُوا ولَا يْعَرْسُولْهُمْ، آمَا بِشْ يْكُونُوا كِي المْلَايْكَة الِّي فِي السْمَاء. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />آمَا فِي مَا يْخُصْ قْيَامِةْ المُوتَى، يَاخِي مَا قْرِيتُوشْ شْنِيَّة قَالِلْكُمْ اللَّهْ: <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />"آنَا إِلَاهْ إِبْرَاهِيمْ، وإِلَاهْ إِسْحَاقْ، وإِلَاهْ يَعْقُوبْ"؟ مَالَا اللَّهْ مُشْ إِلَاهْ مُوتَى، آمَا إِلَاهْ حَيِّينْ». <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />وكِي سَمْعُوا النَّاسْ الكْلَامْ هَاذَا، تْعَجْبُوا مِنْ تَعْلِيمُو.<verse eid="MAT 22:33" /></para>
  <para style="s">أَعْظِمْ وْصِيَّة</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />آمَا كِي سَمْعُوا الفِرِّيسِيِّينْ الِّي هُوَّ سَكِّتْ الصَّدُّوقِيِّينْ، لَمُّوا بْعَضْهُمْ، <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />ووَاحِدْ مِنْهُمْ، وهُوَّ مِنْ عُلَمَاءْ الشَّرِيعَة، سِأْلُو بَاشْ يْجَرْبُو: <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />«يَا مُعَلِّمْ، آنَاهِي أَعْظِمْ وْصِيَّة فِي الشَّرِيعَة؟». <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />جَاوْبُو يَسُوعْ: «تْحِبْ الرَّبْ إِلَاهِكْ بْكُلْ قَلْبِكْ، وبْكُلْ رُوحِكْ وبْكُلْ عَقْلِكْ. <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />هَاذِي هِيَّ أَهَمْ وأَعْظِمْ وْصِيَّة. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />والوْصِيَّة الثَّانْيَة كِيفْهَا: حِبْ قْرِيبِكْ كِيفْ مَا تْحِبْ رُوحِكْ. <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />الِّي تْعَلْمُو الشَّرِيعَة الكُلْ وكْتُبْ الأَنْبِيَاءْ قَايِمْ عَالزُّوزْ وْصَايَا هَاذُومَا».<verse eid="MAT 22:40" /></para>
  <para style="s">المَسِيحْ ودَاوِدْ</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />ووَقْتِلِّي كَانُوا الفِرِّيسِيِّينْ مَلْمُومِينْ مْعَ بْعَضْهُمْ، سْإِلْهُمْ يَسُوعْ: <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />«شْنِيَّة رَايْكُمْ؟ المَسِيحْ هُوَّ وِلْدْ شْكُونْ؟». قَالُولُو: «وِلْدْ دَاوِدْ!». <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />قَالِلْهُمْ: «مَالَا كِيفَاشْ دَاوِدْ بْوَحْيْ مِالرُّوحْ القُدُسْ يْعَيَّطْلُو "رَبِّي" كِي قَالْ:<verse eid="MAT 22:43" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />"قَالْ اللَّهْ لْرَبِّي:</para>
  <para style="q2" vid="MAT 22:44">أُقْعُدْ عْلَى يْمِينِي</para>
  <para style="q1" vid="MAT 22:44">حَتَّى لِينْ نْحُطْ أَعْدَائِكْ تَحْتْ سَاقِيكْ".<verse eid="MAT 22:44" /></para>
  <para style="b" />
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />«إِذَا كَانْ دَاوِدْ يَعْيِّطْ لِلْمَسِيحْ رَبْ، مَالَا كِيفَاشْ يْكُونْ المَسِيحْ وِلْدُو؟». <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />وحَدْ مَا نَجِّمْ يْجَاوْبُو بْكِلْمَة. ومِنْ نْهَارِتْهَا مَا تْجَرَّأْ حَدْ بَاشْ يِسْأْلُو حَتَّى سُؤَالْ.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">يَسُوعْ يْنَبَّهْ مِنْ عُلَمَاءْ الشَّرِيعَة والفِرِّيسِيِّينْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />ووَقْتْهَا قَالْ يَسُوعْ لِلنَّاسْ ولِتْلَامِذْتُو: <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />«عُلَمَاءْ الشَّرِيعَة والفِرِّيسِيِّينْ عْطَاوْ لِرْوَاحْهُمْ الحَقْ إِنْهُمْ يْعَلْمُوكُمْ تَوْرَاةْ مُوسَى. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />أَحْفْظُوا كُلْ الِّي يْقُولُولْكُمْ عْلِيهْ وأَعْمْلُوا بِيهْ. آمَا مَا تَعْمْلُوشْ كِيفْهُمْ، عْلَى خَاطِرْهُمْ يْقُولُوا حَاجَة ويَعْمْلُوا حَاجَة أُخْرَى <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />ويْحُطُّوا فِي حْمِلْ رْزِينْ عْلَى كْتَافْ النَّاسْ، ومَا يْحَرْكُوشْ حَتَّى صْبُعْ بَاشْ يْعَاونُوهُمْ. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />ولِّي يَعْمْلُوهْ الكُلْ، يَعْمْلُوهْ بَاشْ النَّاسْ تْشُوفْهُمْ، يْعَرْضُوا فِي العْصَابَة الِّي فِيهَا الآيَاتْ ويْطَوْلُوا فِي أَطْرَافْ حْوَايِجْهُمْ، <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />ويْحِبُّوا يُقْعْدُوا فِي الصَّفْ الأُوِّلْ فِي المْحَافِلْ والكْرَاسِي الأُولَى فِي المْعَابِدْ. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />ويْحِبُّوا النَّاسْ يْسَلْمُوا عْلِيهُمْ فِي الأَسْوَاقْ، ويْعَيْطُولْهُمْ: "يَا مُعَلِّمْ! يَا مُعَلِّمْ!".<verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />«آمَا إِنْتُومَا مَا تْخَلِّيوْ حَتَّى حَدْ يْعَيْطِلْكُمْ "يَا مُعَلِّمْ"، عْلَى خَاطِرْكُمْ الكُلْ خْوَاتْ وعَنْدْكُمْ مُعَلِّمْ وَاحِدْ. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />ومَا تْعَيْطُوا لْحَتَّى حَدْ فِي الأَرْضْ "يَا بَابَا"، عْلَى خَاطِرْ عَنْدْكُمْ بُو وَاحِدْ الِّي هُوَّ فِي السْمَاء. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />ومَا تْخَلِّيوْ حَتَّى حَدْ يْقُولِلْكُمْ: "يَا سِيدِي"، عْلَى خَاطِرْ عَنْدْكُمْ سِيدْ وَاحِدْ الِّي هُوَّ المَسِيحْ. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />وأَعْظِمْ وَاحِدْ فِيكُمْ لَازْمُو يْكُونْ خْدِيمْ لِيكُمْ. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />الِّي يْعَلِّي رُوحُو يَهْبِطْ، ولِّي يْطَيَّحْ مِنْ رُوحُو يَعْلَى.<verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />«يَا وِيلْكُمْ يَا عُلَمَاءْ الشَّرِيعَة ويَا الفِرِّيسِيِّينْ المُنَافْقِينْ! عْلَى خَاطِرْكُمْ تْسَكْرُوا فِي مَمْلَكْةْ السْمَاوَاتْ فِي وْجُوهْ النَّاسْ، يَاخِي لَا دْخَلْتُوا إِنْتُومَا ولَا خَلِّيتُوا شْكُونْ يُدْخُلْ.<verse eid="MAT 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 23:14" />«يَا وِيلْكُمْ يَا عُلَمَاءْ الشَّرِيعَة ويَا الفِرِّيسِيِّينْ المُنَافْقِينْ! عْلَى خَاطِرْكُمْ تِسْرْقُوا فِي فْلُوسْ الهَجَّالَاتْ، واطَّوْلُوا فِي الصْلَاةْ بَاشْ النَّاسْ تْرَاكُمْ، هَاذَاكَا عْلَاشْ بِشْ تِتْحَاسْبُوا أَكْثِرْ مِالنَّاسْ الأُخْرِينْ.<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />«يَا وِيلْكُمْ يَا عُلَمَاءْ الشَّرِيعَة ويَا الفِرِّيسِيِّينْ المُنَافْقِينْ! عْلَى خَاطِرْكُمْ تْشُقُّوا البَرْ والبْحَرْ بَاشْ ادَّخْلُوا وَاحِدْ لْدِينْكُمْ، وكِي يُدْخُلْ، تْرُدُّوهْ يِسْتَاهِلْ جْهَنِّمْ قَدْ مَا تِسْتَاهْلُوا إِنْتُومَا بْمَرْتِينْ!<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />«يَا وِيلْكُمْ يَا قَادَة يَا عِمْيَانْ! تْقُولُوا: "الِّي يِحْلِفْ بِالهَيْكِلْ مُشْ مَلْزُومْ بِيْمِينُو، آمَا الِّي يِحْلِفْ بِذْهَبْ الهَيْكِلْ، هَاذَاكَا مَلْزُومْ بِيهْ". <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />يَا عِمْيَانْ يَلِّي مَا تِفْهْمُوشْ! آنَاهُو الِّي عَنْدُو قِيمَة أَكْثِرْ؟ الذْهَبْ وَلَّا الهَيْكِلْ الِّي خَلَّى الذْهَبْ مْقَدِّسْ؟ <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />وتْقُولُوا: "الِّي يِحْلِفْ بِالمَذْبَحْ مُشْ مَلْزُومْ بِيْمِينُو، آمَا الِّي يِحْلِفْ بِالقُرْبَانْ الِّي فُوقْ المَذْبَحْ رَاهُو مَلْزُومْ بِيهْ". <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />يَا عِمْيَانْ، آنَاهُو الِّي عَنْدُو قِيمَة أَكْثِرْ؟ القُرْبَانْ وَلَّا المَذْبَحْ الِّي يْخَلِّي القُرْبَانْ مْقَدِّسْ؟ <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />رَاهُو الِّي يِحْلِفْ بِالمَذْبَحْ، يِحْلِفْ بِيهْ وبْكُلْ الِّي عْلِيهْ، <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />ولِّي يِحْلِفْ بِالهَيْكِلْ، يِحْلِفْ بِيهْ وبِلِّي سَاكِنْ فِيهْ، <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />ولِّي يِحْلِفْ بِالسْمَاء، يِحْلِفْ بْعَرْشْ اللَّهْ وبِلِّي قَاعِدْ عَالعَرْشْ.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />«يَا وِيلْكُمْ يَا عُلَمَاءْ الشَّرِيعَة ويَا الفِرِّيسِيِّينْ المُنَافْقِينْ! عْلَى خَاطِرْكُمْ تَعْطِيوْ العْشُرْ مْتَاعْ النَّعْنَاعْ والشِّبْتْ والكَمُّونْ، ومْهَمْلِينْ أَهَمْ مَا جَاء فِي الشَّرِيعَة: العَدْلْ والرَّحْمَة والأَمَانَة. كَانْ لَازِمْ تَعْمْلُوا هَاذُمْ مِنْ غِيرْ مَا تْهَمْلُوا الأُخْرِينْ. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />يَا قَادَة يَا عِمْيَانْ! تْصَفِّيوْ فِي المَاء مِالنَّمُّوسَة، آمَا تَبْلْعُوا الجْمَلْ.<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />«يَا وِيلْكُمْ يَا عُلَمَاءْ الشَّرِيعَة ويَا الفِرِّيسِيِّينْ المُنَافْقِينْ! عْلَى خَاطِرْكُمْ تْنَظْفُوا فِي الكَاسْ والصْحَنْ مِالبَرَّة، وهُومَا مِنْ دَاخِلْ مَلْيَانِينْ بِلِّي نْهِبْتُوهْ وطْمَعْتُوا فِيهْ. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />يَا فِرِّيسِي يَا أَعْمَى! نَظِّفْ الكَاسْ مِنْ دَاخِلْ فِي الأُوِّلْ، بَاشْ يْوَلِّي نْظِيفْ مِنْ بَرَّة زَادَا.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />«يَا وِيلْكُمْ يَا عُلَمَاءْ الشَّرِيعَة ويَا الفِرِّيسِيِّينْ المُنَافْقِينْ! عْلَى خَاطِرْكُمْ كِي القْبُورَاتْ المَدْهُونَة بِالأَبْيِضْ، تُظْهُرْ مِزْيَانَة مِنْ بَرَّة، آمَا مِنْ دَاخِلْ مِلْيَانَة بَعْظَامْ المُوتَى وبِالنْجَاسَة. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />هَكَّاكَا إِنْتُومَا زَادَا، مِنْ بَرَّة تُظْهْرُوا لِلنَّاسْ صَالْحِينْ، آمَا مِنْ دَاخِلْ إِنْتُومَا مِلْيَانِينْ بِالنِّفَاقْ والشَّرْ.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />«يَا وِيلْكُمْ يَا عُلَمَاءْ الشَّرِيعَة ويَا الفِرِّيسِيِّينْ المُنَافْقِينْ! عْلَى خَاطِرْكُمْ تِبْنِيوْ فِي قْبُورَاتْ الأَنْبِيَاءْ وتْزَيْنُوا فِي البْلَايِصْ المَدْفُونِينْ فِيهُمْ الصَّالْحِينْ، <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />وتْقُولُوا: "كَانْ جِينَا مَوْجُودِينْ فِي وَقْتْ جْدُودْنَا، رَانَا مَا شَارِكْنَاهُمْشْ فِي قَتْلَانْ الأَنْبِيَاءْ". <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />وهَكَّا قَاعْدِينْ تِشْهْدُوا عْلَى رْوَاحْكُمْ الِّي إِنْتُومَا وْلَادْ الِّي قَتْلُوا الأَنْبِيَاءْ. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />مَالَا كَمْلُوا إِنْتُومَا الِّي بْدَاوَهْ جْدُودْكُمْ بَاشْ الكَاسْ يْفِيضْ.<verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />«يَا حْنُوشَة يَا وْلَادْ الأَفَاعِي! كِيفَاشْ بِشْ تِفْلْتُوا مِنْ عِقَابْ جْهَنِّمْ؟ <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />هَاذَاكَا عْلَاشْ آنَا بِشْ نَبْعْثِلْكُمْ أَنْبِيَاءْ وحُكَمَاءْ وعُلَمَاء الشَّرِيعَة، مِنْهُمْ الِّي بِشْ تُقْتْلُوهُمْ وتُصْلْبُوهُمْ، ومِنْهُمْ الِّي بِشْ تِجْلْدُوهُمْ فِي مَعَابِدْكُمْ، وتْشِدُّوا جُرِّتْهُمْ مِنْ مْدِينَة لِمْدِينَة. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />وهَاذَا الِّي بِشْ يْخَلِّيكُمْ تِتْحَاسْبُوا عْلَى دَمْ الصَّالْحِينْ الِّي جْرَى عَالأَرْضْ، مِنْ دَمْ هَابِيلْ الصَّالَحْ لْدَمْ زَكَرِيَّا وِلْدْ بَرَخِيَّا الِّي قْتَلْتُوهْ مَا بِينْ الهَيْكِلْ والمَذْبَحْ. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />نْقُلْكُمْ الحَقْ: الجِيلْ هَاذَا هُوَّ الِّي بِشْ يِتْعَاقِبْ عْلَى هَاذَا الكُلْ!».<verse eid="MAT 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />«يَا أُورْشَلِيمْ، يَا أُورْشَلِيمْ، يَلِّي تُقْتُلْ فِي الأَنْبِيَاءْ وتُرْجُمْ فِلِّي يِتْبَعْثُولْهَا، قَدَّاشْ مِنْ مَرَّة حَبِّيتْ نْلِمْ أَوْلَادِكْ، كِيفْ مَا تْلِمْ الدْجَاجَة فْلَالِسْهَا تَحْتْ جْنَاحَاتْهَا، آمَا إِنْتُومَا مَا حَبِّيتُوشْ. <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />هَايْ دَارْكُمْ بِشْ تَبْقَالْكُمْ خِرْبَة! <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />ونْقُولِلْكُمْ: مِنْ تَوَّا مَا عَادِشْ بِشْ تْرَاوْنِي حَتَّى لِينْ يْجِي الوَقْتْ الِّي تْقُولُوا فِيهْ "مُبَارَكْ الِّي جَايْ بْإِسْمْ الرَّبْ"».<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">يَسُوعْ يِتْنَبَّأْ بِخْرَابْ الهَيْكِلْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />وخْرَجْ يَسُوعْ مِالهَيْكِلْ. وهُوَّ يِمْشِي جَاوَهْ تْلَامِذْتُو وبْدَاوْ يْوَرِّيوْ فِيهْ فِي الهَيْكِلْ كِيفَاشْ مِبْنِي. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />قَالِلْهُمْ: «شُفْتُوا هَاذَا الكُلْ؟ نْقُلْكُمْ الحَقْ: لَاحَجْرَة مِنُّو بِشْ تِبْقَى فُوقْ أُخْتْهَا، الكُلُّو بِشْ يِتْهَدْ».<verse eid="MAT 24:2" /></para>
  <para style="s">عَلَامَاتْ نْهَايِةْ الزْمَانْ</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />وهُوَّ قَاعِدْ فِي جْبَلْ الزِّيتُونْ، جِبْدُوهْ تْلَامِذْتُو عْلَى جْنَبْ وقَالُولُو: «قُولِلْنَا: وَقْتَاشْ بِشْ يْصِيرْ هَاذَا؟ وشْنِيَّة الأَمَارَة الِّي نَعْرْفُوا بِيهَا وَقْتْ رْجُوعِكْ ونْهَايِةْ الزْمَانْ؟» <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />جَاوِبْهُمْ يَسُوعْ: «رُدُّوا بَالْكُمْ لَا حَدْ يْغَلِّطْكُمْ. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />بِشْ يْجِيوْ بَرْشَة بْإِسْمِي ويْقُولُوا: آنَا هُوَّ المَسِيحْ! ويْغَلْطُوا بَرْشَة نَاسْ. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />وبِشْ تِسْمْعُوا بِحْرُوبَاتْ وأَخْبَارْ حْرُوبَاتْ، رُدُّوا بَالْكُمْ تْخَافُوا. عْلَى خَاطِرْ هَاذَا لَازْمُو يْصِيرْ، آمَا مُشْ هَاذِي هِيَّ النِّهَايَة. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />بِشْ تِتْقْلِبْ أُمَّة عْلَى أُمَّة، ومَمْلْكَة عْلَى مَمْلْكَة، وتْصِيرْ مَجَاعَاتْ وزْلَازِلْ فِي بَرْشَة بْلَايِصْ. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />آمَا هَاذِي مَاهِي إِلَّا بْدَايِةْ الوْجَايَعْ. <verse eid="MAT 24:8" /><verse number="9" style="v" sid="MAT 24:9" />فِي الوَقْتْ هَاذَاكَا بِشْ يْعَذْبُوكُمْ ويُقْتْلُوكُمْ. وتْكُونُوا مَكْرُوهِينْ عَنْدْ الشُّعُوبْ الكُلْ عْلَى خَاطِرْ إِسْمِي. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />ووَقْتْهَا بَرْشَة بِشْ يِرْتَدُّوا عَالإِيمَانْ، ويْخُونُوا بْعَضْهُمْ ويِكْرْهُوا بْعَضْهُمْ، <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />ويُظْهْرُوا بَرْشَة أَنْبِيَاءْ كَذَّابِينْ ويْغَلْطُوا بَرْشَة نَاسْ. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />ومِنْ كُثْرِةْ الشَّرْ، تِبْرِدْ المْحَبَّة فِي قْلُوبْ بَرْشَة نَاسْ. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />آمَا الِّي يِثْبِتْ لِلِّخِّرْ، هُوَّ الِّي يِنْجَى. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />وبْشَارِةْ مَمْلَكْةْ اللَّهْ هَاذِي بِشْ يِسْمَعْ بِيهَا العَالِمْ أَجْمَعْ، وتُوصِلْ الشْهَادَة لِلشْعُوبْ الكُلْ، ومْبَعِّدْ تْجِي النِّهَايَة.<verse eid="MAT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />«وَقْتِلِّي تْشُوفُوا "النْجَاسَة الِّي تْخَرِّبْ" الِّي حْكَى عْلِيهَا النَّبِيْ دَانْيَالْ مَوْجُودَة فِي البْلَاصَة المُقَدْسَة، — خَلِّي القَارِي يِفْهِمْ — <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />وَقْتْهَا يِلْزِمْ الِّي فِي مَنْطَقْةْ اليَهُودِيَّة يُهْرْبُوا لِلجْبَالْ. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />ولِّي فُوقْ السْطَحْ، مَا يَهْبَطْشْ لْدَارُو بَاشْ يْهِزْ دَبْشُو. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />ولِّي فِي السَّانْيَة، مَا يِرْجَعْشْ بَاشْ يْهِزْ حْوَايْجُو. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />يَا وِيلْهُمْ النْسَاء الحْبَالَى ولِّي يْرَضْعُوا فِي الأَيَّامَاتْ هَاذُوكُمْ! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />صَلِّيوْ بَاشْ مَا يْكُونِشْ هْرُوبْكُمْ فِي الشْتَاء ولَا فِي نْهَارْ سِبْتْ. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />عْلَى خَاطِرْ فِي الأَيَّامَاتْ هَاذُوكُمْ بِشْ يْصِيرْ ضِيقْ كْبِيرْ، مَا صَارِشْ كِيفُو مِلِّي تْخَلْقِتْ الدِّنْيَا لْتَوَّا، ومُشْ بِشْ يْزِيدْ يْصِيرْ بِالكُلْ. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />وكَانْ مَا جَاشْ اللَّهْ قَصَّرْ الأَيَّامَاتْ هَاذُوكُمْ، رَاوْ حَتَّى حَدْ مَا يْنَجِّمْ يِنْجَى. آمَا هُوَّ قَصَّرْهُمْ عْلَى خَاطِرْ النَّاسْ الِّي إِخْتَارْهُمْ.<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />«إِذَا قَالِلْكُمْ وَاحِدْ وَقْتْهَا: "هَاوْ المَسِيحْ هُونِي!" وَلَّا "أَهَوْكَا غَادِي"، مَا تْصَدْقُوهُوشْ! <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />عْلَى خَاطِرْ بِشْ يُظْهْرُوا أَكْثِرْ مِنْ مَسِيحْ دَجَّالْ وبَرْشَة أَنْبِيَاءْ كَذَّابِينْ، ويَعْمْلُوا مُعْجْزَاتْ وعْجَايِبْ بَاشْ يْحَاوْلُوا يْغَلْطُوا بِيهُمْ حَتَّى النَّاسْ الِّي إِخْتَارْهُمْ اللَّهْ. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />هَانِي قُلْتِلْكُمْ كُلْ شَيْ قْبَلْ مَا يْصِيرْ. <verse eid="MAT 24:25" /><verse number="26" style="v" sid="MAT 24:26" />مَالَا كَانْ قَالُولْكُمْ: "أَهَوَّا المَسِيحْ فِي الخْلَاء!" مَا تِمْشِيوِشْ لْغَادِي، وَلَّا: "أَهَوَّا فِي الدْيَارْ لْدَاخِلْ" مَا تْصَدْقُوشْ! <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />رَاهُو، كِيمَا يَضْرِبْ البْرَقْ فِي الشَّرْقْ ويِضْوِي فِي الغَرْبْ، هَكَّا يْكُونْ رْجُوعْ إِبْنْ الإِنْسَانْ. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />عْلَى خَاطِرْ وِينْ فَمَّة الجِيفَة، غَادِي تِتْلَمْ النْسُورَا.<verse eid="MAT 24:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />«وبِالوَقْتْ، بَعْدْ ضِيقْ الأَيَّامَاتْ هَاذِيكَا، بِشْ تِظْلَامْ الشَّمْسْ، ويِتْحْجِبْ ضَوْء الڨَمْرَة، ونْجُومْ السْمَاء اطِّيحْ، وتِتْزَعْزَعْ كُلْ قُوَّة فِي السْمَاوَاتْ. <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />وَقْتْهَا تُظْهُرْ عَلَامِةْ إِبْنْ الإِنْسَانْ فِي السْمَاء، وقْبَايِلْ الأَرْضْ الكُلْ بِشْ تْنَوَّحْ، ويْشُوفُوا إِبْنْ الإِنْسَانْ جَايْ عَالسْحَابْ بْقُوَّة عْظِيمَة ومَجْدْ، <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />ويَبْعَثْ مْلَايِكْتُو يْبَوْقُوا بْصُوتْ عْظِيمْ، ويْلِمُّوا النَّاسْ الِّي إِخْتَارْهُمْ مِالشَّرْقْ والغَرْبْ والشَّمَالْ والجَنُوبْ، مِنْ كُلْ بْلَاصَة تَحْتْ السْمَاء.<verse eid="MAT 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />«خُوذُوا العِبْرَة مِالكَرْمَة: دُوبْ مَا أَعْرَافْهَا تِخْضَارْ واطَّلَّعْ الأَوْرَاقْ، تَعْرْفُوا الِّي الصِّيفْ قْرُبْ. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />وإِنْتُومَا زَادَا، كِي تْشُوفُوا الحَاجَاتْ هَاذِي قَاعْدَة تْصِيرْ، أَعْرْفُوا الِّي الوَقْتْ قْرُبْ وعَالأَبْوَابْ. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />نْقُلْكُمْ الحَقْ: الحَاجَاتْ هَاذِي الكُلْ بِشْ تْصِيرْ قْبَلْ مَا يْمُوتْ الجِيلْ هَاذَا. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />السْمَاء والأَرْضْ يِفْنَاوْ، آمَا كْلَامِي عُمْرُو مَا يِفْنَى.<verse eid="MAT 24:35" /></para>
  <para style="s">خَلِّيكُمْ فَايْقِينْ</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />«آمَا النْهَارْ هَاذَاكَا والسَّاعَة هَاذِيكَا مَا يَعْرَفْهُمْ حَتَّى حَدْ، لَا المْلَايْكَة الِّي فِي السْمَاء، ولَا الإِبْنْ، مَا يَعْرِفْهُمْ كَانْ الآبْ. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />وكِيفْ مَا صَارْ فِي زْمَانْ نُوحْ، هَكَّاكَا بَاشْ يْصِيرْ كِي يْجِي إِبْنْ الإِنْسَانْ. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />كَانُوا النَّاسْ فِي الأَيَّامَاتْ الِّي قْبَلْ الطُّوفَانْ، يَاكْلُوا ويُشُرْبُوا ويْعَرْسُوا ويْعَرْسُولْهُمْ، حَتَّى لِينْ جَاء النْهَارْ الِّي دْخَلْ فِيهْ نُوحْ لِلسْفِينَة. <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />وعْلَى غَفْلَة، جَاء الطُّوفَانْ وهَزْهُمْ الكُلْ. هَكَّاكَا بِشْ يْصِيرْ كِي يْجِي إِبْنْ الإِنْسَانْ. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />فِي الوَقْتْ هَاذَاكَا، يْكُونُوا زُوزْ رْجَالْ فِي السَّانْيَة، يِتْهَزْ وَاحِدْ ويِبْقَى الآخِرْ. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />ويْكُونُوا زُوزْ نْسَاء يِرْحِيوْ مْعَ بْعَضْهُمْ بِالرْحَى، تِتْهَزْ وَحْدَة وتِبْقَى الأُخْرَى. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />مَالَا خَلِّيكُمْ فَايْقِينْ، رَاكُمْ مَا تَعْرْفُوشْ أَنَاهُو النْهَارْ الِّي يِرْجَعْ فِيهْ سِيدْكُمْ. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />وأَعْرْفُوا هَاذَا: كَانْ جَاء مُولَى الدَّارْ يَعْرِفْ وَقْتَاشْ يَهْبِطْ عْلِيهْ السَّارَقْ، رَاهُو سْهَرْ ومَا خَلَّاشْ دَارُو تِتْسْرَقْ. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />كُونُوا إِنْتُومَا زَادَا مُسْتْعَدِّينْ، عْلَى خَاطِرْ إِبْنْ الإِنْسَانْ بِشْ يِرْجَعْ فِي سَاعَة مَا تِتْوَقْعُوهَاشْ».<verse eid="MAT 24:44" /></para>
  <para style="s">مَثَلْ الخْدِيمْ الثِّيقَة</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />«شْكُونُو الخْدِيمْ الثِّيقَة والحَكِيمْ الِّي يْكَلْفُو سِيدُو بَاشْ يَعْطِي خُدَّامُو الأُخْرِينْ مَاكْلِتْهُمْ فِي وَقْتْهَا؟ <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />صَحَّة لِيهْ الخْدِيمْ هَاذَاكَا، الِّي كِي يِرْجَعْ سِيدُو يَلْقَاهْ يِخْدِمْ فِي خِدْمْتُو. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />نْقُلْكُمْ الحَقْ: هَاذَا يْحُطُّو سِيدُو مَسْؤُولْ عْلَى أَمْلَاكُو الكُلْ. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />آمَا إِذَا كَانْ الخْدِيمْ هَاذَا شِرِّيرْ وقَالْ بِينُو وبِينْ رُوحُو: "سِيدِي بِشْ يِرْجَعْ إِمَّخِّرْ" <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />وبْدَا يَضْرِبْ فِي الخُدَّامْ الِّي مْعَاهْ، ويَاكِلْ ويُشْرُبْ مْعَ السُّوكَّارْجِيَّة، <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />يِرْجَعْ سِيدُو عْلَى غَفْلَة، فِي نْهَارْ مَا يْجِيشْ عْلَى بَالُو وفِي سَاعَة مَا يَعْرِفْهَاشْ، <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />ويْعَاقْبُو عِقَابْ كْبِيرْ ويْوَلِّي مْصِيرُو مْعَ المُنَافْقِينْ. غَادِي وِينْ يْكُونْ البْكَاء والنْدَمْ».<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">مَثَلْ العَشْرَة صْبَايَا</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />«فِي الوَقْتْ هَاذَاكَا، تْشَبَّهْ مَمْلَكْةْ السْمَاوَاتْ لْعَشْرَة ضْيُوفْ صْبَايَا هَزُّوا فْنَارَاتْهُمْ ومْشَاوْ بَاشْ يْعَرْضُوا لِلْعْرُوسْ. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />خَمْسَة مِنْهُمْ عَنْدْهُمْ حِكْمَة، والخَمْسَة الأُخْرِينْ مَا عَنْدْهُمْشْ. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />الِّي مَا عَنْدْهُمْشْ حِكْمَة هَزُّوا فْنَارَاتْهُمْ، ومَا هَزُّوشْ مْعَاهُمْ زِيتْ. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />آمَا الِّي عَنْدْهُمْ حِكْمَة، هَزُّوا بْزَايِدْ زِيتْ مْعَ فْنَارَاتْهُمْ. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />وبْطَى العْرُوسْ، يَاخِي الكُلْهُمْ نِعْسُوا ورَقْدُوا. <verse eid="MAT 25:5" /><verse number="6" style="v" sid="MAT 25:6" />ومْعَ نُصْ اللِّيلْ، فَمَّة صُوتْ صَاحْ: "هَاوْ العْرُوسْ جَاء، أُخْرْجُوا بَاشْ تْقَابْلُوهْ!". <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />يَاخِي قَامُوا الصْبَايَا العَشْرَة الكُلْ وحَضّْرُوا فْنَارَاتْهُمْ. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />ولِّي مَا عَنْدْهُمْشْ حِكْمَة قَالُوا لِلْأُخْرِينْ: "أَعْطِيوْنَا شْوَيَّة مِنْ زِيتْكُمْ، عْلَى خَاطِرْ فْنَارَاتْنَا قَاعْدَة تِطْفَى". <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />آمَا الِّي عَنْدْهُمْ حِكْمَة جَاوْبُوا: "مُمْكِنْ مَا يِكْفِيشْ لِينَا ولِيكُمْ، إِمْشِيوْ لِلِّي يْبِيعُوا فِي الزِّيتْ وإِشْرِيوْ الِّي تَحْتَاجُوهْ". <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />وهُومَا مَاشْيِينْ بَاشْ يِشْرِيوْ، وْصُلْ العْرُوسْ. ودَخْلُوا مْعَاهْ الصْبَايَا المِسْتَدْعِينْ لِلْعِرْسْ، وتْسَكِّرْ البَابْ. <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" />وبَعْدْ مُدَّة، خَلْطُوا الصْبَايَا الأُخْرِينْ وقَالُوا لِلْعْرُوسْ: "يَا سِيدْنَا، يَا سِيدْنَا، حِلِّلْنَا البَابْ!". <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />جَاوِبْهُمْ العْرُوسْ: "نْقُلْكُمْ الحَقْ: آنَا مَا نَعْرِفْكُمْشْ". <verse eid="MAT 25:12" /><verse number="13" style="v" sid="MAT 25:13" />مَالَا خَلِّيكُمْ فَايْقِينْ، عْلَى خَاطِرْكُمْ مَا تَعْرْفُوشْ لَا النْهَارْ ولَا السَّاعَة.<verse eid="MAT 25:13" /></para>
  <para style="s">مَثَلْ صْرُرْ الفْلُوسْ</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />«وتْشَبَّهْ مَمْلَكْةْ السْمَاوَاتْ لْرَاجِلْ حَبْ يْسَافِرْ، يَاخِي اسْتَدْعَى خُدَّامُو وعْطَاهُمْ فْلُوسُو. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />عْطَى لِلْأُوِّلْ خَمْسَة صْرُرْ فْلُوسْ، والثَّانِي زُوزْ صْرُرْ، والثَّالِثْ صُرَّة وَحْدَة، كُلْ وَاحِدْ عْلَى قَدْرْ طَاقْتُو، وبَعْدْهَا سَافِرْ. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />الِّي خْذَا الخَمْسَة صْرُرْ مْشَى بِالوَقْتْ وتَاجِرْ بِيهُمْ، ورْبِحْ خَمْسَة صْرُرْ أُخْرِينْ. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />ولِّي خْذَا الزُّوزْ صْرُرْ عْمَلْ كِيفُو، ورْبِحْ زُوزْ صْرُرْ أُخْرِينْ. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />آمَا الِّي خْذَا صُرَّة وَحْدَة، مْشَى حْفَرْ حُفْرَة فِي الأَرْضْ، وخَبَّى فِيهَا فْلُوسْ سِيدُو.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />«وبَعْدْ مُدَّة طْوِيلَة، رْجَعْ سِيدْ الخُدَّامْ هَاذُوكُمْ وحَاسِبْهُمْ. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />وجَاء الِّي خْذَا الخَمْسَة صْرُرْ، وجَابْ خَمْسَة صْرُرْ زَايْدِينْ وقَالْ: "يَا سِيدِي، إِنْتِ عْطِيتْنِي خَمْسَة صْرُرْ، وهَانِي رْبِحْتْ فُوقْهُمْ خَمْسَة صْرُرْ أُخْرِينْ". <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />يَاخِي قَالُّو سِيدُو: "صَحِّيتْ، إِنْتِ خْدِيمْ صَالَحْ وثِيقَة. عْلَى خَاطْرِكْ كُنْتْ أَمِينْ فِي الشْوَيَّة، هَانِي بِشْ نَمْنِكْ عَالبَرْشَة: أُدْخُلْ وتَمَتَّعْ بْنَعِيمْ سِيدِكْ". <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />ولِّي خْذَا الزُّوزْ صْرُرْ جَاء هُوَّ زَادَا، وقَالْ: "يَا سِيدِي، إِنْتِ عْطِيتْنِي زُوزْ صْرُرْ، وهَانِي رْبِحْتْ فُوقْهُمْ زُوزْ صْرُرْ أُخْرِينْ". <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />يَاخِي قَالُّو سِيدُو: "صَحِّيتْ، إِنْتِ خْدِيمْ صَالَحْ وثِيقَة. عْلَى خَاطْرِكْ كُنْتْ أَمِينْ فِي الشْوَيَّة، هَانِي بِشْ نَمْنِكْ عَالبَرْشَة: أُدْخُلْ وتَمَتَّعْ بْنَعِيمْ سِيدِكْ". <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />وجَاء زَادَا الِّي خْذَا صُرَّة وَحْدَة، وقَالْ: "يَا سِيدِي، نَعْرِفْ الِّي إِنْتِ رَاجِلْ قَاسِي، تَحْصِدْ مِنْ وِينْ مَا زْرَعْتِشْ، وتْلِمْ مِنْ وِينْ مَا غْرَسْتِشْ، <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />يَاخِي خُفْتْ، ومْشِيتْ خَبِّيتْ الصُّرَّة مْتَاعِكْ فِي الأَرْضْ، وهَايْ فْلُوسِكْ". <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />جَاوْبُو سِيدُو: "يَا خْدِيمْ يَا شِرِّيرْ يَا بُخْلِي! كِي إِنْتِ تَعْرِفْ الِّي آنَا نَحْصِدْ مِنْ وِينْ مَا زْرَعْتِشْ، ونْلِمْ مِنْ وِينْ مَا غْرِسْتِشْ، <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />مُشْ أَحْسَنْلِكْ كَانْ حَطِّيتْلِي فْلُوسِي فِي البَانْكَة، بَاشْ كِي نِرْجَعْ، نَاخِذْهُمْ ومْعَاهُمْ رِبْحْ؟". <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />وقَالْ لْخُدَّامُو: "خُوذُوا الصُّرَّة مِنْ عَنْدُو، وأَعْطِيوْهَا لِلِّي عَنْدُو العَشْرَة صْرُرْ. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />عْلَى خَاطِرْ الِّي عَنْدُو بِشْ يِتَعْطَالُو أَكْثِرْ ويْفِيضْ، ولِّي مَا عَنْدُوشْ، حَتَّى الِّي عَنْدُو بِشْ يِتْفَكْلُو. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />والخْدِيمْ هَاذَا الِّي مَا مِنُّوشْ فَايْدَة، إِرْمِيوَهْ لْبَرَّة فِي الظْلَامْ. غَادِي وِينْ البْكَاء والنْدَمْ".<verse eid="MAT 25:30" /></para>
  <para style="s">نْهَارْ الحْسَابْ</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />«وَقْتِلِّي يِرْجَعْ إِبْنْ الإِنْسَانْ فِي مَجْدُو، ومْعَاهْ المْلَايْكَة الكُلْ، يُقْعُدْ عْلَى عَرْشُو العْظِيمْ. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />ويِتْلَمُّوا قُدَّامُو الشُّعُوبْ الكُلْ، ويِفْرِزْهُمْ مِنْ بْعَضْهُمْ، كِيمَا يِفْرِزْ السَّارَحْ العْلَالِشْ مِالمْعِيزْ. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />ويْحُطْ العْلَالِشْ عْلَى يْمِينُو والمْعِيزْ عْلَى يْسَارُو. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />ومْبَعِّدْ يْقُولْ المَلِكْ لِلِّي عْلَى يْمِينُو: "إِيجَاوْ، يَلِّي بَارِكْكُمْ بَابَا، أُورْثُوا المَمْلْكَة الِّي تْحَضْرِتِّلْكُمْ مِلِّي تْخَلْقِتْ الدِّنْيَا، <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />عْلَى خَاطِرْنِي جُعْتْ وإِنْتُومَا وَكَّلْتُونِي، وعْطُشْتْ وإِنْتُومَا شَرَّبْتُونِي، وكُنْتْ غْرِيبْ وإِنْتُومَا سَكَّنْتُونِي، <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />كُنْتْ عِرْيَانْ وإِنْتُومَا لَبَّسْتُونِي، وكُنْتْ مْرِيضْ وإِنْتُومَا زُرْتُونِي، وكُنْتْ مَرْبُوطْ فِي حَبْسْ وإِنْتُومَا جِيتُونِي". <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />وَقْتْهَا الصَّالْحِينْ يْجَاوْبُوهْ: "يَا سِيدِي، وَقْتَاشْ شُفْنَاكْ جِيعَانْ ووَكَّلْنَاكْ؟ وَلَّا عُطْشَانْ وشَرَّبْنَاكْ؟ <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />ووَقْتَاشْ شُفْنَاكْ غْرِيبْ وسَكِّنَّاكْ؟ وَلَّا عِرْيَانْ ولَبِّسْنَاكْ؟ <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />ووَقْتَاشْ شُفْنَاكْ مْرِيضْ وَلَّا مَرْبُوطْ وزُرْنَاكْ؟" <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />والمَلِكْ يْجَاوِبْهُمْ: "نْقُلْكُمْ الحَقْ: مَادَامْ عْمَلْتُوا هَاذَا مْعَ وَاحِدْ مِنْ خْوَاتِي الصْغَارْ، مَعْنَاهَا عْمَلْتُوهْ مْعَايَا آنَا!". <verse eid="MAT 25:40" /><verse number="41" style="v" sid="MAT 25:41" />ومْبَعِّدْ يْقُولْ لِلِّي عْلَى يْسَارُو: "إِبْعْدُوا عْلِيَّا يَا مَلْعُونِينْ وإِمْشِيوْ لِلنَّارْ الِّي مَا تِطْفَاشْ، الِّي تْحَضْرِتْ لْإِبْلِيسْ ومْلَايِكْتُو، <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />عْلَى خَاطِرْنِي جُعْتْ ومَا وَكَّلْتُونِيشْ، وعْطُشِتْ ومَا شَرَّبْتُونِيشْ، <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />وكُنْتْ غْرِيبْ ومَا سَكَّنْتُونِيشْ، وعِرْيَانْ ومَا لَبَّسْتُونِيشْ، ومْرِيضْ ومَرْبُوطْ ومَا زُرْتُونِيشْ". <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />وَقْتْهَا هُومَا زَادَا بِشْ يْجَاوْبُوا: "يَا سِيدِي، وَقْتَاشْ شُفْنَاكْ جِيعَانْ وَلَّا عُطْشَانْ وَلَّا غْرِيبْ وَلَّا عِرْيَانْ وَلَّا مْرِيضْ وَلَّا مَرْبُوطْ ومَا عَاوِنَّاكِشْ؟". <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />والمَلِكْ يْجَاوِبْهُمْ: "نْقُلْكُمْ الحَقْ: مَادَامْكُمْ مَا عْمَلْتُوشْ هَاذَا مْعَ وَاحِدْ مِنْ خْوَاتِي الصْغَارْ، يَعْنِي مَا عْمَلْتُوهُوشْ مْعَايَا آنَا". <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />وهَاذُوكُمْ يِمْشِيوْ لِلْعْذَابْ الِّي مَا يُوفَاشْ، والصَّالْحِينْ يِمْشِيوْ لِلْحَيَاةْ الأَبَدِيَّة».<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">مُؤَامْرَة عْلَى يَسُوعْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />ووَقْتِلِّي كَمِّلْ يَسُوعْ كْلَامُو هَاذَا الكُلْ، قَالْ لِتْلَامِذْتُو: <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />«إِنْتُومَا تَعْرْفُوا الِّي عِيدْ الفِصْحْ اليْهُودِي يْجِي بَعْدْ نْهَارِينْ، وإِبْنْ الإِنْسَانْ يْسَلْمُوهْ بَاشْ يِتْصْلَبْ».<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />فِي الوَقْتْ هَاذَاكَا تْلَمُّوا كْبَارْ الكَهَنَة وشْيُوخْ الشَّعْبْ فِي دَارْ الكَاهِنْ الكْبِيرْ الِّي إِسْمُو قَيَافَا، <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />وتْشَاوْرُوا مْعَ بْعَضْهُمْ بَاشْ يَعْمْلُوا حِيلَة يْشِدُّوا بِيهَا يَسُوعْ ويُقْتْلُوهْ. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />آمَا قَالُوا: «مَا نَعْمْلُوشْ هَاذَا فِي العِيدْ، بَاشْ مَا يْهِيجِشْ الشَّعْبْ».<verse eid="MAT 26:5" /></para>
  <para style="s">مْرَا تْصُبْ العِطْرْ عْلَى يَسُوعْ</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />ووَقْتِلِّي كَانْ يَسُوعْ فِي بِيتْ عَنْيَا فِي دَارْ سِمْعَانْ الأَبْرِصْ، <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />جَاتُو مْرَا وفِي يْدِيهَا دَبُّوزَة عِطْرْ غَالْيَة بَرْشَة، وصَبِّتْهَا فُوقْ رَاسُو وهُوَّ يِتْعَشَّى. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />وكِي شَافُوا التْلَامْذَة الِّي عَمْلِتُّو، مَا عْجِبْهُمْشْ وقَالُوا: «عْلَاشْ التَّبْذِيرْ هَاذَا؟ <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />العِطْرْ هَاذَا كَانْ يْنَجِّمْ يِتْبَاعْ إِبَّرْشَة فْلُوسْ، والفْلُوسْ تِتْعْطَى لِلْفْقَارَى». <verse eid="MAT 26:9" /><verse number="10" style="v" sid="MAT 26:10" />عْرَفْ يَسُوعْ الحْكَايَة وقَالِلْهُمْ: «أَخْطَاوْهَا! عْلَاشْ تْقَلْقُوا فِيهَا؟ رَاهِي عَمْلِتْلِي حَاجَة بَاهْيَة. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />الفْقَارَى دِيمَا مَوْجُودِينْ، آمَا آنَا مَانِيشْ بِشْ نَبْقَى عَنْدْكُمْ دِيمَا. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />هِيَّ كِي صَبِّتْ العِطْرْ عْلَى بَدْنِي، قَاعْدَة تْحَضِّرْ فِيَّا لِدْفِينْتِي. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />نْقُلْكُمْ الحَقْ: وِينْ مَا تِتْنْشَرْ البْشَارَة فِي العَالِمْ الكُلْ، النَّاسْ بِشْ يَحْكِيوْ عَلِّي عَمْلِتُّو المْرَا هَاذِي، ويُقْعْدُوا دِيمَا يِتْفَكْرُوهَا!».<verse eid="MAT 26:13" /></para>
  <para style="s">خْيَانِةْ يَهُوذَا</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />فِي الوَقْتْ هَاذَاكَا وَاحِدْ مِالأَثْنَاشِنْ تِلْمِيذْ، ولِّي إِسْمُو يَهُوذَا الإِسْخَرْيُوطِي، مْشَى لِكْبَارْ الكَهَنَة، <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />وقَالِلْهُمْ: «قَدَّاشْ تَعْطِيوْنِي بَاشْ نْسَلَّمْكُمْ يَسُوعْ؟». يَاخِي دَفْعُولُو ثْلَاثِينْ بْيَاسَة فُضَّة. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />ومِنْ وَقْتْهَا، بْدَا يَهُوذَا يْلَوِّجْ عْلَى فُرْصَة بَاشْ يْسَلْمُو.<verse eid="MAT 26:16" /></para>
  <para style="s">عْشَاء الفِصْحْ</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />فِي أَوِّلْ أَيَّامَاتْ عِيدْ الفْطِيرْ الِّي بْلَاشْ خْمِيرَة، جَاوْ التْلَامْذَة لْيَسُوعْ وقَالُولُو: «وِينْ تْحِبْنَا نْحَضْرُولِكْ عْشَاء الفِصْحْ؟». <verse eid="MAT 26:17" /><verse number="18" style="v" sid="MAT 26:18" />جَاوِبْهُمْ: «إِمْشِيوْ لِفْلَانْ فِي المْدِينَة وقُولُولُو: "قَالِّكْ المُعَلِّمْ: سَاعْتِي قُرْبِتْ، وبِشْ نَاكِلْ عْشَاء الفِصْحْ مْعَ تْلَامِذْتِي فِي دَارِكْ"». <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />وعَمْلُوا التْلَامْذَة كِيمَا قَالِلْهُمْ يَسُوعْ وحَضْرُوا عْشَاء الفِصْحْ.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />وفِي العْشِيَّة، قْعَدْ يَسُوعْ بَاشْ يَاكِلْ مْعَ تْلَامِذْتُو الأَثْنَاشْ. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />وهُومَا يَاكْلُوا، قَالْ يَسُوعْ: «نْقُلْكُمْ الحَقْ: وَاحِدْ مِنْكُمْ بِشْ يْخُونِّي». <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />وحِزْنُوا التْلَامْذَة، وبْدَاوْ يِسْأْلُوا فِيهْ بِالوَاحِدْ: «يَاخِي آنَا هُوَّ، يَا سِيدِي؟». <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />جَاوِبْهُمْ: «الِّي كْلَا مْعَايَا مِنْ نَفْسْ الصْحَنْ هُوَّ الِّي بِشْ يْخُونِّي. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />إِبْنْ الإِنْسَانْ لَازْمُو يْمُوتْ كِيمَا مَكْتُوبْ عْلِيهْ فِي الكْتُبْ المُقَدْسَة، آمَا يَا وِيلُو الرَّاجِلْ الِّي بِشْ يْسَلْمُو. خِيرْلُو كَانْ مَا تُولِدْشْ». <verse eid="MAT 26:24" /><verse number="25" style="v" sid="MAT 26:25" />يَاخِي سِأْلُو يَهُوذَا الِّي خَانُو: «يَاخِي آنَا هُوَّ، يَا مُعَلِّمْ؟» جَاوْبُو يَسُوعْ: «إِنْتِ بِيدِكْ قُلْتْ».<verse eid="MAT 26:25" /></para>
  <para style="s">عَشَاء الرَّبْ</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />وهُومَا يَاكْلُوا، خْذَا يَسُوعْ خُبْزْ وشْكَرْ اللَّهْ وقْسِمْ وعْطَى لِتْلَامِذْتُو وقَالْ: «خُوذُوا كُولُوا، هَاذَا هُوَّ بَدْنِي». <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />ومْبَعِّدْ خْذَا كَاسْ وشْكَرْ اللَّهْ وعْطَاهُمْ وقَالْ: «أُشْرْبُوا مِنُّو الكُلْكُمْ. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />عْلَى خَاطِرْ هَاذَا هُوَّ دَمِّي الِّي يَعْمِلْ بِيهْ اللَّهْ عَهْدْ جْدِيدْ، ولِّي بِشْ يْسِيلْ عْلَى خَاطِرْ بَرْشَة نَاسْ، بَاشْ الذْنُوبْ تِتْغْفِرْ. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />ونْقُولِلْكُمْ: مِنْ تَوَّا مَا عَادِشْ بِشْ نُشْرُبْ مِنْ عَصِيرْ العْنِبْ هَاذَا، حَتَّى لِينْ يْجِي النْهَارْ الِّي نُشْرْبُو فِيهْ مْعَاكُمْ جْدِيدْ فِي مَمْلَكْةْ بَابَا». <verse eid="MAT 26:29" /><verse number="30" style="v" sid="MAT 26:30" />ومْبَعِّدْ سَبْحُوا اللَّهْ بِالتَّرْنِيمْ، ومْشَاوْ لِجْبَلْ الزِّيتُونْ.<verse eid="MAT 26:30" /></para>
  <para style="s">يَسُوعْ يِتْنَبَّأْ الِّي بُطْرُسْ بِشْ يُنْكْرُو</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />وَقْتْهَا قَالِلْهُمْ يَسُوعْ: «الكُلْكُمْ بِشْ تْخَلِّيوْنِي اللِّيلَة هَاذِي. عْلَى خَاطِرْ مَكْتُوبْ:</para>
  <para style="b" vid="MAT 26:31" />
  <para style="q1" vid="MAT 26:31">"نَضْرِبْ السَّارَحْ،</para>
  <para style="q2" vid="MAT 26:31">تِتْفَرَّقْ الغْنَمْ".<verse eid="MAT 26:31" /></para>
  <para style="b" />
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />«آمَا بَعْدْمَا نْقُومْ مِالمُوتْ بِشْ نِسْبِقْكُمْ لِلْجَلِيلْ». <verse eid="MAT 26:32" /><verse number="33" style="v" sid="MAT 26:33" />جَاوْبُو بُطْرُسْ وقَالُّو: «حَتَّى كَانْ مْشَاوْ عْلِيكْ الكُلْ، آنَا عُمْرِي مَا نْخَلِّيكْ». <verse eid="MAT 26:33" /><verse number="34" style="v" sid="MAT 26:34" />جَاوْبُو يَسُوعْ: «نْقُلِّكْ الحَقْ: فِي اللِّيلَة هَاذِي، قْبَلْ مَا يْصِيحْ السَّرْدُوكْ، بِشْ تُنْكُرْنِي ثْلَاثَة مَرَّاتْ». <verse eid="MAT 26:34" /><verse number="35" style="v" sid="MAT 26:35" />قَالُّو بُطْرُسْ: «مَانِيشْ بِشْ نُنْكْرِكْ بِالكُلْ، حَتَّى كَانْ لْزِمْ نْمُوتْ مْعَاكْ!» والتْلَامْذَة الكُلْ قَالُوا نَفْسْ الكْلَامْ.<verse eid="MAT 26:35" /></para>
  <para style="s">يَسُوعْ يْصَلِّي فِي جَثْسَيْمَانِي</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />ومْبَعِّدْ مْشَى يَسُوعْ وتْلَامِذْتُو لِبْلَاصَة إِسْمْهَا جَثْسَيْمَانِي، وقَالِلْهُمْ: «أُقْعْدُوا هُونِي، مَادَامْ آنَا صَلِّيتْ غَادِي». <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />وهَزْ مْعَاهْ بُطْرُسْ ووْلَادْ زَبَدِي الإِثْنِينْ، وبْدَا يْحِسْ فِي الضِّيقْ والحُزْنْ. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />وقَالِلْهُمْ: «رُوحِي حْزِينَة بَرْشَة، لْدَرْجِةْ المُوتْ. أُقْعْدُوا هُونِي وأَسْهْرُوا مْعَايَا». <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />وبْعِدْ عْلِيهُمْ شْوَيَّة وهْبَطْ عْلَى وِجْهُو، وصَلَّى وقَالْ: «يَا بَابَا، إِذَا كَانْ مُمْكِنْ، بَعِّدْ عْلِيَّا الكَاسْ هَاذِي. آمَا خَلِّي يْصِيرْ الِّي تْحِبْ عْلِيهْ إِنْتِ، مُشْ الِّي نْحِبْ عْلِيهْ آنَا!». <verse eid="MAT 26:39" /><verse number="40" style="v" sid="MAT 26:40" />ورْجَعْ لِتْلَامِذْتُو ولْقَاهُمْ رَاقْدِينْ. يَاخِي قَالْ لْبُطْرُسْ: «هَكَّا، مَا نَجَّمْتُوشْ تَسْهْرُوا مْعَايَا سَاعَة وَحْدَة؟ <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />أَسْهْرُوا وصَلِّيوْ بَاشْ مَا تُدْخْلُوشْ فِي مِحْنَة. رَاهِي الرُّوحْ نَاشْطَة، آمَا البْدَنْ ضْعِيفْ». <verse eid="MAT 26:41" /><verse number="42" style="v" sid="MAT 26:42" />ومْشَى يْصَلِّي مَرَّة أُخْرَى، وقَالْ: «يَا بَابَا، إِذَا كَانْ مُشْ مُمْكِنْ تْبَعِّدْ عْلِيَّا الكَاسْ هَاذِي، ولَازِمْ نُشْرُبْهَا، مَالَا خَلِّي يْصِيرْ كِيمَا تْحِبْ إِنْتِ». <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />ورْجَعْ مَرَّة أُخْرَى ولْقَاهُمْ رَاقْدِينْ، عْلَى خَاطِرْ النُّومْ غْلِبْهُمْ. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />يَاخِي خَلَّاهُمْ ورْجَعْ يْصَلِّي مَرَّة ثَالْثَة نَفْسْ الصْلَاةْ. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />وبَعْدْهَا رْجَعْ لِتْلَامِذْتُو وقَالِلْهُمْ: «مَزِّلْتُوا رَاقْدِينْ ومِرْتَاحِينْ! السَّاعَة الِّي فِيهَا يْسَلْمُوا إِبْنْ الإِنْسَانْ لِيْدِينْ المُذْنْبِينْ جَاتْ. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />قُومُوا، وهَيَّا نِمْشِيوْ! هَاوْ الِّي بِشْ يْخُونِّي جَاء».<verse eid="MAT 26:46" /></para>
  <para style="s">يَسُوعْ يِتْشَدْ</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />وهُوَّ مَزَّالْ يِتْكَلِّمْ، وْصُلْ يَهُوذَا الِّي هُوَّ وَاحِدْ مِالأَثْنَاشْ، ومْعَاهْ بَرْشَة نَاسْ هَازِّينْ سْيُوفَا وعْصِيْ، بَعْثُوهُمْ كْبَارْ الكَهَنَة وشْيُوخْ الشَّعْبْ. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />ولِّي بِشْ يْخُونُو عْطَاهُمْ أَمَارَة وقَالْ: «الِّي بِشْ نْبُوسُو هَاذَاكَا هُوَّ، شِدُّوهْ!». <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />ومْشَى طُولْ لْيَسُوعْ وقَالُّو: «السَّلَامْ، يَا مُعَلِّمْ!» وبَاسُو. <verse eid="MAT 26:49" /><verse number="50" style="v" sid="MAT 26:50" />يَاخِي قَالُّو يَسُوعْ: «يَا صَاحْبِي، عْلَاشْ جِيتْ؟». وَقْتْهَا قُرْبُوا لْيَسُوعْ وشَدُّوهْ. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />وإِذَا بْوَاحِدْ مِلِّي كَانُوا مْعَ يَسُوعْ مَدْ يِدُّو وجْبِدْ سِيفُو وضْرَبْ بِيهْ خْدِيمْ الكَاهِنْ الكْبِيرْ وقَصْلُو وِذْنُو. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />قَالُّو يَسُوعْ: «رَجَّعْ سِيفِكْ لِبْلَاصْتُو! عْلَى خَاطِرْ الِّي يِسْتَعْمْلُوا السِّيفْ، يْمُوتُوا بِالسِّيفْ. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />يَاخِي مَاشِي فِي بَالِكْ الِّي آنَا مَا انَّجَّمْشْ نُطْلُبْ مِنْ بَابَا وهُوَّ يَبْعَثْلِي بِالوَقْتْ أَكْثِرْ مِنْ أَثْنَاشِنْ جَيْشْ مِالمْلَايْكَة؟ <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />آمَا هَاذَا يِلْزْمُو يْصِيرْ بَاشْ يْتِمْ الِّي جَاء فِي الكْتُبْ المُقَدْسَة».<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />وقَالْ يَسُوعْ لِلِّي تْلَمُّوا عْلِيهْ: «يَاخِي آنَا سَارَقْ خَارْجِينْلِي بِالسْيُوفَا والعْصِي بَاشْ تْشِدُّونِي؟ كُنْتْ كُلْ يُومْ نُقْعُدْ نْعَلِّمْ بِينَاتْكُمْ فِي الهَيْكِلْ، ومَا شَدِّيتُونِيشْ. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />آمَا هَاذَا الكُلْ صَارْ بَاشْ يْتِمْ الِّي تْقَالْ فِي كْتُبْ الأَنْبِيَاءْ». وَقْتْهَا تْلَامِذْتُو الكُلْ خَلَّاوَهْ وهَرْبُوا.<verse eid="MAT 26:56" /></para>
  <para style="s">يَسُوعْ قُدَّامْ مَجْلِسْ اليْهُودْ</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />ولِّي شَدُّوا يَسُوعْ هَزُّوهْ لْقَيَافَا الكَاهِنْ الكْبِيرْ، وكَانُوا مَلْمُومِينْ عَنْدُو عُلَمَاء الشَّرِيعَة والشْيُوخْ. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />وبُطْرُسْ كَانْ يْتَبَّعْ فِيهْ مِنْ بْعِيدْ حَتَّى لِينْ وْصِلْ لْدَارْ الكَاهِنْ الكْبِيرْ. ودْخَلْ وقْعَدْ مْعَ الحَرَسْ وبْقَى يِسْتَنَّى كِيفَاشْ بِشْ تُوفَى الحْكَايَة.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />وكَانُوا كْبَارْ الكَهَنَة ولِّي فِي المَجْلِسْ الأَعْلَى الكُلْ يْلَوْجُوا عْلَى شْكُونْ يِشْهِدْ بِالزُّورْ عْلَى يَسُوعْ بَاشْ يْنَجْمُوا يُقْتْلُوهْ، <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />آمَا مَا لْقَاوِشْ، رَغْمِلِّي جَاوْ بَرْشَة شْهُودْ زُورْ. وفِي الإِخِّرْ قَدْمُوا زُوزْ <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />وقَالُوا: «الرَّاجِلْ هَاذَا قَالْ: "آنَا انَّجِّمْ نْهِدْ هَيْكِلْ اللَّهْ ونْعَاوِدْ نِبْنِيهْ فِي ثْلَاثَة أَيَّامْ"». <verse eid="MAT 26:61" /><verse number="62" style="v" sid="MAT 26:62" />ووْقِفْ الكَاهِنْ الكْبِيرْ وقَالْ: «يَاخِي مَا عَنْدِكْ مَا تْجَاوِبْ عَلِّي شِهْدُوا بِيهْ الزُّوزْ هَاذُومَا عْلِيكْ؟». <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />آمَا يَسُوعْ بْقَى سَاكِتْ. والكَاهِنْ الكْبِيرْ قَالُّو: «حَلَّفْتِكْ بِاللَّهْ الحَيْ قُولِلْنَا: يَاخِي إِنْتِ المَسِيحْ إِبْنْ اللَّهْ؟». <verse eid="MAT 26:63" /><verse number="64" style="v" sid="MAT 26:64" />قَالُّو يَسُوعْ: «إِنْتِ بِيدِكْ قُلْتْ. وآنَا نْقُلْكُمْ: مِاليُومْ بِشْ تْشُوفُوا إِبْنْ الإِنْسَانْ قَاعِدْ عْلَى يْمِينْ اللَّهْ القَادِرْ عْلَى كُلْ شَيْ، وجَايْ عْلَى سْحَابْ السْمَاء!». <verse eid="MAT 26:64" /><verse number="65" style="v" sid="MAT 26:65" />يَاخِي قَطَّعْ الكَاهِنْ الكْبِيرْ حْوَايْجُو وقَالْ: «هَاوْ كْفَرْ! مَزَّالْ حَاشِتْنَا بِشْهُودْ؟ هَاكُمْ سْمَعْتُوا كُفْرُو، <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />شْنِيَّة رَايْكُمْ؟». جَاوْبُوا: «يِسْتَاهِلْ المُوتْ!». <verse eid="MAT 26:66" /><verse number="67" style="v" sid="MAT 26:67" />وبَعْدْهَا، بِزْقُوا عْلَى وِجْهُو، وضَرْبُوهْ بِالبُونْيَة، وجْمَاعَة مِنْهُمْ عْطَاوَهْ كْفُوفْ <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />وقَالُوا: «تْنَبْإِلْنَا، يَا سِي المَسِيحْ! شْكُونْ الِّي ضَرْبِكْ؟».<verse eid="MAT 26:68" /></para>
  <para style="s">بُطْرُسْ يُنْكُرْ يَسُوعْ</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />فِي الوَقْتْ هَاذَاكَا كَانْ بُطْرُسْ قَاعِدْ لْبَرَّا فِي الوِسْطِيَّة مْتَاعْ الدَّارْ. يَاخِي قُرْبِتْلُو خْدِيمَة وقَالِتْ: «إِنْتِ زَادَا كُنْتْ مْعَ يَسُوعْ الجَلِيلِي!». <verse eid="MAT 26:69" /><verse number="70" style="v" sid="MAT 26:70" />آمَا هُوَّ نْكَرْ قُدَّامْهُمْ الكُلْ، وقَالْ: «مُشْ فَاهِمْ فَاشْ قَاعْدَة تْقُولْ!». <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />ومْبَعِّدْ خْرَجْ لْمَدْخِلْ الدَّارْ، يَاخِي شَافِتُّو خْدِيمَة أُخْرَى وقَالِتْ لِلِّي كَانُوا غَادِي: «الرَّاجِلْ هَاذَا كَانْ مْعَ يَسُوعْ النَّاصْرِي!». <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />آمَا بُطْرُسْ نْكَرْ مَرَّة أُخْرَى وحْلِفْ وقَالْ: «الرَّاجِلْ هَاذَا آنَا مَا نَعْرْفُوشْ!». <verse eid="MAT 26:72" /><verse number="73" style="v" sid="MAT 26:73" />ومْبَعِّدْ شْوَيَّة جَاوْ الِّي كَانُوا وَاقْفِينْ غَادِي لْبُطْرُسْ وقَالُولُو: «بِالحَقْ إِنْتِ زَادَا وَاحِدْ مِنْهُمْ، عْلَى خَاطِرْ لَهْجْتِكْ كِيفْهُمْ!». <verse eid="MAT 26:73" /><verse number="74" style="v" sid="MAT 26:74" />وبْدَا بُطْرُسْ يَلْعِنْ ويِحْلِفْ: «الرَّاجِلْ هَاذَا آنَا مَا نَعْرْفُوشْ». وبِالوَقْتْ صَاحْ السَّرْدُوكْ. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />يَاخِي تْذَكِّرْ بُطْرُسْ كِلْمِةْ يَسُوعْ كِي قَالُّو: «قْبَلْ مَا يْصِيحْ السَّرْدُوكْ، بِشْ تُنْكُرْنِي ثْلَاثَة مَرَّاتْ» وخْرَجْ لْبَرَّا وبْدَا يِبْكِي بِالشَّهْقَة.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">يَهُوذَا يُشْنُقْ رُوحُو</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />وفِي الصْبَاحْ، تْلَمُّوا كْبَارْ الكَهَنَة وشْيُوخْ الشَّعْبْ الكُلْ، وتْشَاوْرُوا عْلَى كِيفَاشْ بِشْ يُقْتْلُوا يَسُوعْ. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />ومْبَعِّدْ كَتْفُوهْ وهَزُّوهْ وسَلْمُوهْ لْبِيلَاطُسْ الوَالِي.<verse eid="MAT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />وَقْتِلِّي يَهُوذَا الِّي خَانُو شَافْ الِّي يَسُوعْ تِحْكَمْ عْلِيهْ، نْدِمْ ورَجَّعْ الثْلَاثِينْ بْيَاسَة فُضَّة لِكْبَارْ الكَهَنَة والشْيُوخْ، <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />وقَالِلْهُمْ: «آنَا غْلُطْتْ كِي سَلَّمْتُكُمْ رَاجِلْ بَرِيءْ». يَاخِي جَاوْبُوهْ: «هَاذِي مُشْ مُشْكْلِتْنَا أَحْنَا، بَرَّا دَبِّرْ رَاسِكْ!». <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" />ولَّى رْمَى بْيَاسَاتْ الفُضَّة فِي الهَيْكِلْ وخْرَجْ، وبَعْدْهَا مْشَى شْنَقْ رُوحُو. <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />وخْذَاوْ كْبَارْ الكَهَنَة الفُضَّة وقَالُوا: «هَاذُمْ حَقْ دَمْ إِنْسَانْ، حْرَامْ نْحُطُّوهُمْ فِي خَزْنِةْ الهَيْكِلْ». <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />وبَعْدْمَا تْشَاوْرُوا، شْرَاوْ بِيهُمْ سَانِيةْ الفُخَّارْجِي بَاشْ يَعْمْلُوهَا جَبَّانَة يِدْفْنُوا فِيهَا البْرَايْنِيَّة. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />هَاذَاكَا عْلَاشْ لِلْيُومْ يْسَمِّيوْهَا سَانْيِةْ الدَّمْ. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />وهَكَّا تَمْ الِّي قَالُّو النَّبِيْ إِرْمِيَا: «وخْذَاوْ ثْلَاثِينْ بْيَاسَة فُضَّة، السُّومْ الِّي سَامُوهْ بِيهْ بَنِي إِسْرَائِيلْ، <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />وشْرَاوْ بِيهُمْ سَانِيةْ الفُخَّارْجِي، كِيفْ مَا أْمَرْنِي الرَّبْ».<verse eid="MAT 27:10" /></para>
  <para style="s">يَسُوعْ قُدَّامْ بِيلَاطُسْ الوَالِي الرُّومَانِي</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />ووْقِفْ يَسُوعْ قُدَّامْ الوَالِي. والوَالِي سِأْلُو: «يَاخِي إِنْتِ مَلِكْ اليْهُودْ؟» جَاوْبُو يَسُوعْ: « إِنْتِ بِيدِكْ قُلْتْ». <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />وكِي كَانُوا كَبَارْ الكَهَنَة والشْيُوخْ يِتْهْمُوا فِيهْ، بْقَى سَاكِتْ ومَا جَاوِبْهُمْشْ. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />قَالُّو بِيلَاطُسْ: «يَاخِي مَاكِشْ قَاعِدْ تِسْمَعْ فِلِّي تِهْمُوكْ بِيهْ؟». <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />آمَا يَسُوعْ مَا جَاوْبُو بْحَتَّى كِلْمَة، حَتَّى لِينْ بْقَى الوَالِي بَاهِتْ بَرْشَة.<verse eid="MAT 27:14" /></para>
  <para style="s">بِيلَاطُسْ يُحْكُمْ بْصَلْبْ يَسُوعْ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />وكَانْ الوَالِي مِسْتَانِسْ فِي كُلْ عِيدْ يْسَيِّبْ وَاحِدْ مِالمْرَابِيطْ الِّي يَخْتَارُوهْ الشَّعْبْ. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />وكَانْ عَنْدْهُمْ فِي الوَقْتْ هَاذَاكَا مَرْبُوطْ مَشْهُورْ إِسْمُو بَارَابَاسْ. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />ووَقْتِلِّي تْلَمُّوا النَّاسْ قَالِلْهُمْ بِيلَاطُسْ: «شْكُونْ تْحِبُّونِي نْسَيْبِلْكُمْ: بَارَابَاسْ وَلَّا يَسُوعْ الِّي يْقُولُولُو المَسِيحْ؟» <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />عْلَى خَاطْرُو كَانْ يَعْرِفْ الِّي هُومَا سَلْمُولُو يَسُوعْ بِسْبَبْ غِيرِتْهُمْ.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />ووَقْتِلِّي بِيلَاطُسْ كَانْ قَاعِدْ فِي المَحْكْمَة، بَعْثِتْلُو مَرْتُو وقَالِتْلُو: «رُدْ بَالِكْ تَعْمِلْ حَاجَة لِلرَّاجِلْ الصَّالَحْ هَاذَا، رَانِي اللِّيلَة تْقَلَّقْتْ بَرْشَة عْلَى خَاطْرُو فِي حِلْمَة».<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />آمَا كْبَارْ الكَهَنَة والشْيُوخْ حَرْشُوا النَّاسْ بَاشْ يُطْلْبُوا مِنُّو يْسَيْبِلْهُمْ بَارَابَاسْ ويُقْتُلْ يَسُوعْ. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />وكِي سْإِلْهُمْ الوَالِي: «شْكُونْ تْحِبُّونِي نْسَيْبِلْكُمْ؟» جَاوْبُوهْ: «بَارَابَاسْ!». <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" />قَالِلْهُمْ بِيلَاطُسْ: «مَالَا شْنِيَّة تْحِبُّونِي نَعْمِلْ لْيَسُوعْ الِّي يْقُولُولُو المَسِيحْ؟». قَالُوا الكُلْ: «أُصْلْبُو!» <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />قَالِلْهُمْ: «شْنُوَّة الشَّرْ الِّي عَمْلُو؟». آمَا هُومَا وَلَّاوْ يْصِيحُوا أَكْثِرْ: «أُصْلْبُو!». <verse eid="MAT 27:23" /><verse number="24" style="v" sid="MAT 27:24" />وكِي شَافْ بِيلَاطُسْ إِنُّو مُشْ بِشْ يُوصِلْ مْعَاهُمْ لْشَيْ، والشَّعْبْ بْدَا يْهِيجْ أَكْثِرْ، خْذَا مَاء وغْسَلْ يْدِيهْ قُدَّامْ النَّاسْ وقَالْ: «آنَا بَرِيءْ مِنْ دَمْ الرَّاجِلْ هَاذَا! تْصَرْفُوا مْعَاهْ إِنْتُومَا». <verse eid="MAT 27:24" /><verse number="25" style="v" sid="MAT 27:25" />والشَّعْبْ الكُلْ جَاوْبُوا: «دَمُّو فِي رَقْبِتْنَا، أَحْنَا وأَوْلَادْنَا!». <verse eid="MAT 27:25" /><verse number="26" style="v" sid="MAT 27:26" />يَاخِي سَيْبِلْهُمْ بَارَابَاسْ، وعْطَى أَمْرْ بَاشْ يِجْلْدُوا يَسُوعْ، ومْبَعِّدْ سَلْمُو بَاشْ يِتْصْلَبْ.<verse eid="MAT 27:26" /></para>
  <para style="s">الحُرَّاسْ يِتْمَسْخْرُوا عْلَى يَسُوعْ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />وجَاوْ عَسْكِرْ الوَالِي وهَزُّوا يَسُوعْ لْدَارْ الوِلَايَة، وتْلَمِّتْ بِيهْ فِرْقِتْهُمْ الكُلْ، <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />ونَحَّاوْلُو حْوَايْجُو ولَبْسُوهْ لِبْسَة حَمْرَة، <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />وضَفْرُولُو تَاجْ مِالشُّوكْ وحَطُّوهْ فُوقْ رَاسُو، وحَطُّولُو قَصْبَة فِي يِدُّو اليْمِينْ، وهَبْطُوا عْلَى رْكَايِبْهُمْ قُدَّامُو وبْدَاوْ يِتْمَسْخْرُوا عْلِيهْ ويْقُولُوا: «سَلَامْ يَا مَلِكْ اليْهُودْ!». <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />وبِزْقُوا عْلِيهْ، وخْذَاوْلُو القَصْبَة وضَرْبُوهْ بِيهَا عْلَى رَاسُو. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />وبَعْدْمَا تْمَسْخْرُوا عْلِيهْ، نَحَّاوْلُو اللِّبْسَة الحَمْرَة، وعَاوْدُوا لَبْسُوهْ حْوَايْجُو وهَزُّوهْ بَاشْ يِتْصْلَبْ.<verse eid="MAT 27:31" /></para>
  <para style="s">صَلْبْ يَسُوعْ</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />وهُومَا خَارْجِينْ بِيهْ مِالمْدِينَة عْرُضْهُمْ رَاجِلْ مِنْ مَنْطَقْةْ قِيرِينَا إِسْمُو سِمْعَانْ، يَاخِي لَزْمُوا عْلِيهْ بَاشْ يْهِزْ الصَّلِيبْ مْتَاعْ يَسُوعْ. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />وكِي وُصْلُوا لِبْلَاصَة تِتْسَمَّى الجُلْجْثَة، الِّي مَعْنَاهَا بْلَاصِةْ الجُمْجُمَة، <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />عْطَاوَهْ شْرَابْ مْخَلِّطْ بْحَاجَة مُرَّة بَاشْ يُشْرُبْ، وكِي ذَاقُو مَا حَبِّشْ يُشْرْبُو. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />ومْبَعِّدْ صَلْبُوهْ. وعَمْلُوا قُرْعَة عْلَى حْوَايْجُو وقِسْمُوهَا بِينَاتْهُمْ. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />وقَعْدُوا غَادِي يْعِسُّوا عْلِيهْ. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />وحَطُّوا بْلَاكَة فُوقْ رَاسُو وكِتْبُوا عْلِيهَا التُّهْمَة مْتَاعُو: «هَاذَا يَسُوعْ، مَلِكْ اليْهُودْ».<verse eid="MAT 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 27:38" />وصَلْبُوا مْعَاهْ زُوزْ سُرَّاقْ، وَاحِدْ عْلَى يْمِينُو ووَاحِدْ عْلَى يْسَارُو. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />وكَانُوا الِّي يِتْعَدَّاوْ مِنْ غَادِي يْسِبُّوا فِيهْ، ويْدَوْحُوا فِي رْيُوسْهُمْ <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />ويْقُولُوا: «إِنْتِ يَلِّي بِشْ تْهِدْ الهَيْكِلْ وتِبْنِيهْ فِي ثْلَاثَة أَيَّامْ، كَانِكْ إِنْتِ إِبْنْ اللَّهْ نَجِّي رُوحِكْ وأَهْبِطْ مِنْ فُوقْ الصَّلِيبْ». <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />وكْبَارْ الكَهَنَة وعُلَمَاءْ الشَّرِيعَة والشْيُوخْ كَانُوا يِتْمَسْخْرُوا عْلِيهْ زَادَا، ويْقُولُوا: <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />«نَجَّى غِيرُو، آمَا مَا نَجَّمْشْ يْنَجِّي رُوحُو! هَاذَا هُوَّ مَلِكْ إِسْرَائِيلْ؟ خَلِّيهْ يَهْبِطْ تَوَّا مِنْ فُوقْ الصَّلِيبْ، وتَوْ نَمْنُوا بِيهْ. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />مَاهُو حَطْ ثِيقْتُو فِي اللَّهْ وقَالْ: "آنَا إِبْنْ اللَّهْ"، خَلِّي اللَّهْ يْنَجِّيهْ تَوَّا كَانُو رَاضِي عْلِيهْ». <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />والسُّرَّاقْ الزُّوزْ الِّي تْصَلْبُوا مْعَاهْ كَانُوا يْعَايْرُوا فِيهْ بْنَفْسْ الكْلَامْ.<verse eid="MAT 27:44" /></para>
  <para style="s">مُوتْ يَسُوعْ</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />وظْلَامِتْ الدِّنْيَا الكُلْ مِنْ نُصْ نْهَارْ حَتَّى لْمَاضِي ثْلَاثَة مْتَاعْ العْشِيَّة. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />ومْعَ مَاضِي ثْلَاثَة، عَيِّطْ يَسُوعْ بْصُوتْ عَالِي: «إِيلِي! إِيلِي! لِمَا شَبَقْتَنِي؟» ومَعْنِتْهَا «يَا إِلَاهِي! يَا إِلَاهِي! عْلَاشْ خَلِّيتْنِي؟». <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />وكِي سَمْعُوهْ جْمَاعَة مِلِّي وَاقْفِينْ غَادِي قَالُوا: «هَاوْ يْعَيِّطْ لِلنَّبِيْ إِيلِيَّا!». <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />وبِالوَقْتْ جْرَالُو وَاحِدْ مِنْهُمْ، وخْذَا شِيفُونَة، ونَفَّخْهَا فِي الخَلْ، وحَطْهَا عْلَى قَصْبَة ومَدْهَالُو بَاشْ يُشْرُبْ. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />آمَا الأُخْرِينْ قَالُوا: « إِسْتَنَّى، خَلِّينَا نْشُوفُوا إِذَا كَانْ إِيلِيَّا بِشْ يْجِي ويْنَجِّيهْ!». <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />وعَيِّطْ يَسُوعْ مَرَّة أُخْرَى بِالقْوِيْ، وطَلَّعْ الرُّوحْ. <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />وتْشَرِّڨْ حْجَابْ الهَيْكِلْ عْلَى ثْنِينْ مِالفُوقْ اللُّوطَا. والأَرْضْ تْزَلْزْلِتْ والحْجَرْ تْشَقَّقْ <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />وتْحَلِّتْ القْبُورَاتْ وبَرْشَة قِدِّيسِينْ كَانُوا مُوتَى قَامُوا، <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />وخَرْجُوا مِالقْبُورَاتْ. وبَعْدْ قْيَامِةْ يَسُوعْ دَخْلُوا لِلْمْدِينَة المُقَدْسَة وظُهْرُوا لْبَرْشَة نَاسْ. <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />ووَقْتِلِّي الضَّابِطْ الرُّومَانِي ولِّي كَانُوا يْعِسُّوا مْعَاهْ عْلَى يَسُوعْ شَافُوا الزِلْزَالْ ولِّي صَارْ الكُلْ، تْرِعْبُوا وقَالُوا: «بِالحَقْ هَاذَا كَانْ إِبْنْ اللَّهْ!».<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />وكَانْ فَمَّة بَرْشَة نْسَاء يِتْفَرْجُوا مِنْ بْعِيدْ. وهُومَا الِّي تَبْعُوا يَسُوعْ مِالجَلِيلْ، بَاشْ يِخْدْمُوهْ، <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />ومِنْهُمْ مَرْيِمْ المَجْدَلِيَّة، ومَرْيِمْ أُمْ يَعْقُوبْ ويُوسِي، وأُمْ وْلَادْ زَبَدِي.<verse eid="MAT 27:56" /></para>
  <para style="s">يُوسِفْ يِدْفِنْ يَسُوعْ</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />وفِي العْشِيَّة جَاء رَاجِلْ غْنِي إِسْمُو يُوسِفْ مِنْ مْدِينِةْ الرَّامَة، وهُوَّ زَادَا كَانْ مِنْ تْلَامِذْةْ يَسُوعْ. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />ومْشَى لْبِيلَاطُسْ وطْلَبْ مِنُّو جُثِّةْ يَسُوعْ. يَاخِي بِيلَاطُسْ أْمَرْ بَاشْ يَعْطِيوْهَالُو. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />وهَزْ يُوسِفْ الجُثَّة ولَفْهَا فِي كْفَنْ نْظِيفْ، <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />ودِفْنُو فِي قْبَرْ جْدِيدْ حَافْرُو فِي الحْجَرْ لْرُوحُو هُوَّ، وحَطْ حَجْرَة كْبِيرَة عْلَى بَابْ القْبَرْ، ومْشَى. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />وكَانِتْ مَرْيِمْ المَجْدَلِيَّة، ومَرْيِمْ الأُخْرَى، قَاعْدِينْ مْقَابِلْ القْبَرْ.<verse eid="MAT 27:61" /></para>
  <para style="s">الحَرَسْ يْعِسُّوا عَالقْبَرْ</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />ومِنْ غُدْوَة، مَعْنَاهَا بَعْدْ نْهَارْ التَّحْضِيرْ لِلسِّبْتْ، مْشَاوْ كْبَارْ الكَهَنَة والفِرِّيسِيِّينْ لْبِيلَاطُسْ، <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />وقَالُولُو: «يَا سِيدْنَا، تْذَكَّرْنَا الِّي هَاكِ الدَّجَّالْ وَقْتِلِّي كَانْ حَيْ قَالْ: "بِشْ نْقُومْ بَعْدْ ثْلَاثَة أَيَّامْ". <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />مَالَا أَعْطِي أَمْرْ بَاشْ يْعِسُّوا عَالقْبَرْ لِلنْهَارْ الثَّالِثْ، بَاشْ مَا يْجِيوِشْ تْلَامِذْتُو يِسْرْقُوا جُثْتُو، ويْقُولُوا لِلنَّاسْ: "رَاهُو قَامْ مِالمُوتْ"، وتْكُونْ الكِذْبَة الثَّانْيَة أَخْطِرْ مِالأُولَى!». <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />قَالِلْهُمْ بِيلَاطُسْ: «هَاوْ عَنْدْكُمْ الحَرَسْ، إِمْشِيوْ وعِسُّوا عْلِيهْ كِيمَا تْحِبُّوا». <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />ومْشَاوْ سَكْرُوا القْبَرْ وشَمْعُوهْ، وحَطُّوا عْلِيهْ الحَرَسْ يْعِسُّوا.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">يَسُوعْ يْقُومْ مِالمُوتْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />وبَعْدْمَا تْعَدَّى السِّبْتْ وطْلَعْ فَجْرْ نْهَارْ الأَحَدْ، مْشَاتْ مَرْيِمْ المَجْدَلِيَّة ومَرْيِمْ الأُخْرَى بَاشْ يْشُوفُوا القْبَرْ. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />وإِذَا بِيهْ زِلْزَالْ كْبِيرْ يْصِيرْ، عْلَى خَاطِرْ مَلَاكْ مِنْ عَنْدْ الرَّبْ هْبَطْ مِالسْمَاء وبَعِّدْ الحَجْرَة الِّي فِي بَابْ القْبَرْ وقْعَدْ فُوقْهَا. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />وكَانْ مَنْظْرُو كِي البْرَقْ ولِبْسْتُو بِيضَة كِي الثِّلْجْ. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />وكِي شَافُوهْ الحَرَسْ تْرِعْبُوا ووَلَّاوْ تْقُولِشْ عْلِيهُمْ مُوتَى.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />آمَا المَلَاكْ قَالْ لِلزُّوزْ نْسَاء: «مَا تْخَافُوشْ. آنَا نَعْرِفْ الِّي إِنْتُومَا تْلَوْجُوا عْلَى يَسُوعْ الِّي تِصْلَبْ. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />هُوَّ مَاهُوشْ هْنَا، عْلَى خَاطْرُو قَامْ كِيمَا قَالْ. إِيجَاوْ شُوفُوا البْلَاصَة الِّي كَانْ مَحْطُوطْ فِيهَا. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />وإِمْشِيوْ فِيسَعْ وقُولُوا لِتْلَامِذْتُو الِّي هُوَّ قَامْ مِنْ بِينْ المُوتَى، وهَاوْ بِشْ يِسْبَقْكُمْ لِلْجَلِيلْ، وغَادِي بِشْ تْشُوفُوهْ. هَانِي خَبَّرْتْكُمْ».<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />يَاخِي مْشَاوْ الزُّوزْ نْسَاء فِيسَعْ مِالقْبَرْ، وهُومَا خَايْفِينْ آمَا فِي نَفْسْ الوَقْتْ فَرْحَانِينْ، ومْشَاوْ يِجْرِيوْ بَاشْ يْبَشْرُوا التْلَامْذَة. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />وهُومَا فِي الثْنِيَّة، عْرُضْهُمْ يَسُوعْ وقَالِلْهُمْ: «السَّلَامْ». يَاخِي قُرْبُولُو وشَدُّوا فِي سَاقِيهْ وسِجْدُولُو. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />قَالِلْهُمْ يَسُوعْ: «مَا تْخَافُوشْ! إِمْشِيوْ لِخْوَاتِي وقُولُولْهُمْ يِمْشِيوْ لِلْجَلِيلْ، وغَادِي يْشُوفُونِي».<verse eid="MAT 28:10" /></para>
  <para style="s">الحَرَسْ يْطَلْعُوا إِشَاعَة</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />وهُومَا فِي الثْنِيَّة، رَجْعُوا جْمَاعَة مِالحَرَسْ لِلْمْدِينَة، وخَبْرُوا كْبَارْ الكَهَنَة بِلِّي صَارْ الكُلْ. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />يَاخِي تْلَمُّوا كْبَارْ الكَهَنَة والشْيُوخْ وتْشَاوْرُوا، وبَعْدْهَا رْشَاوْ الحَرَسْ إِبَّرْشَة فْلُوسْ، <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />وقَالُولْهُمْ: «قُولُوا لِلنَّاسْ الِّي تْلَامِذْتُو جَاوْ فِي اللِّيلْ وسِرْقُوهْ وَقْتِلِّي أَحْنَا رَاقْدِينْ. <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />وكِي يِسْمَعْ الوَالِي بِالخْبَرْ، أَحْنَا نْدَافْعُوا عْلِيكُمْ قُدَّامُو ومَا يْصِيرِلْكُمْ شَيْ». <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />يَاخِي الحَرَسْ خْذَاوْ الفْلُوسْ وعَمْلُوا كِيمَا قَالُولْهُمْ. والإِشَاعَة هَاذِي قَعْدِتْ اتْدُورْ بِينْ اليْهُودْ حَتَّى لِلْيُومْ.<verse eid="MAT 28:15" /></para>
  <para style="s">إِمْشِيوْ لِلشْعُوبْ الكُلْ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />وبَعْدْهَا، هَزُّوا الحْدَاشِنْ تِلْمِيذْ رْوَاحْهُمْ ومْشَاوْ لِلْجَلِيلْ، لِلجْبَلْ الِّي قَالِلْهُمْ عْلِيهْ يَسُوعْ. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />ودُوبْ مَا رَاوَهْ سِجْدُولُو، آمَا فِيهُمْ شْكُونْ الِّي شَكْ. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />يَاخِي قْرُبِّلْهُمْ يَسُوعْ وقَالْ: «تَعْطَاتْلِي كُلْ سُلْطَة فِي السْمَاء والأَرْضْ. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />مَالَا إِمْشِيوْ لِلشْعُوبْ الكُلْ وخَلِّيوْ النَّاسْ يْوَلِّيوْ تْلَامْذَة لِيَّا، وعَمْدُوهُمْ بْإِسْمْ الآبْ والإِبْنْ والرُّوحْ القُدُسْ، <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />وعَلْمُوهُمْ يْطِيعُوا الِّي وَصِّيتْكُمْ بِيهْ الكُلْ، وهَانِي دِيمَا مْعَاكُمْ، لْآخِرْ الزْمَانْ».<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>