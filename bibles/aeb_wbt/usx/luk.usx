<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LUK" style="id" />
  <para style="h">لُوقَا</para>
  <para style="toc1">بْشَارِةْ لُوقَا</para>
  <para style="toc2">لُوقَا</para>
  <para style="toc3">لُوقَا</para>
  <para style="mt">بْشَارِةْ لُوقَا</para>
  <chapter number="1" style="c" sid="LUK 1" />
  <para style="s">مُقَدْمَة</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1" />بَرْشَة نَاسْ بْدَاوْ يِكْتْبُوا عَالأُمُورْ الِّي صَارِتْ عَنْدْنَا، <verse eid="LUK 1:1" /><verse number="2" style="v" sid="LUK 1:2" />كِيمَا وَصْلُوهَالْنَا الِّي كَانُوا شْهُودْ مِالأُوِّلْ وشَافُوهَا بْعِينِيهُمْ، ومْبَعِّدْ وَلَّاوْ خُدَّامْ لْكِلْمِةْ اللَّهْ. <verse eid="LUK 1:2" /><verse number="3" style="v" sid="LUK 1:3" />آنَا زَادَا، بَعْدْمَا ثَبَّتْ مْلِيحْ فِي كُلْ شَيْ مِالأُوِّلْ كِيفْ مَا يِلْزِمْ، شُفْتْ إِنُّو نِكْتِبْهَالِكْ بِالتَّرْتِيبْ يَا صَاحِبْ العِزَّة ثَاوْفِيلُسْ، <verse eid="LUK 1:3" /><verse number="4" style="v" sid="LUK 1:4" />بَاشْ تِتْأَكِّدْ إِنُّو التَّعْلِيمْ الِّي وْصِلِّكْ صْحِيحْ.<verse eid="LUK 1:4" /></para>
  <para style="s">البْشَارَة بِوْلَادِةْ يُوحَنَّا</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5" />فِي زْمَانْ هِيرُودُسْ مَلِكْ اليَهُودِيَّة، كَانْ فَمَّة كَاهِنْ إِسْمُو زَكَرِيَّا، تَابَعْ لْفِرْقِةْ أَبِيَّا مْتَاعْ الكَهَنَة، وكَانِتْ مَرْتُو مِنْ ذُرِّيِّةْ هَارُونْ وإِسْمْهَا أَلِيصَابَاتْ. <verse eid="LUK 1:5" /><verse number="6" style="v" sid="LUK 1:6" />وكَانُوا الإِثْنِينْ صَالْحِينْ فِي عِينِينْ اللَّهْ، ويْعِيشُوا حَسْبْ الوْصَايَا مْتَاعُو وفَرَايْضُو، ومَا عْلِيهُمْشْ لُومْ. <verse eid="LUK 1:6" /><verse number="7" style="v" sid="LUK 1:7" />آمَا مَا كَانِشْ عَنْدْهُمْ وْلَادْ، عْلَى خَاطِرْ أَلِيصَابَاتْ مَا كَانِتْشْ تْجِيبْ الصْغَارْ، وكَانُوا الإِثْنِينْ كْبَارْ فِي العْمُرْ.<verse eid="LUK 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8" />وفِي مَرَّة مِالمَرَّاتْ وَقْتِلِّي كَانْ زَكَرِيَّا يِخْدِمْ فِي الهَيْكِلْ قُدَّامْ اللَّهْ وَقْتْ دَوْرْ فِرْقْتُو فِي الخِدْمَة، <verse eid="LUK 1:8" /><verse number="9" style="v" sid="LUK 1:9" />عَمْلُوا قُرْعَة كِيمَا جْرَاتْ عَادِةْ الكَهَنَة، يَاخِي جَاتْ عْلِيهْ هُوَّ بَاشْ يُدْخُلْ لْهَيْكِلْ الرَّبْ ويَحْرَقْ البْخُورْ. <verse eid="LUK 1:9" /><verse number="10" style="v" sid="LUK 1:10" />والشَّعْبْ الكُلْ كَانْ لْبَرَّة يْصَلِّي وَقْتْ حَرْقَانْ البْخُورْ. <verse eid="LUK 1:10" /><verse number="11" style="v" sid="LUK 1:11" />يَاخِي ظْهُرْلُو مَلَاكْ مِنْ عَنْدْ الرَّبْ وَاقِفْ عْلَى يْمِينْ المَذْبَحْ مْتَاعْ البْخُورْ. <verse eid="LUK 1:11" /><verse number="12" style="v" sid="LUK 1:12" />وكِي شَافُو زَكَرِيَّا دْخَلْ بَعْضُو ومِكْنُو الخُوفْ. <verse eid="LUK 1:12" /><verse number="13" style="v" sid="LUK 1:13" />يَاخِي قَالُّو المَلَاكْ: «مَا تْخَافِشْ يَا زَكَرِيَّا عْلَى خَاطِرْ اللَّهْ سْمَعْ صْلَاتِكْ ومَرْتِكْ أَلِيصَابَاتْ بِشْ تْجِيبْلِكْ وْلَيِّدْ، وإِنْتِ بِشْ تْسَمِّيهْ يُوحَنَّا. <verse eid="LUK 1:13" /><verse number="14" style="v" sid="LUK 1:14" />وبِشْ تِفْرَحْ وتِتْهَنَّى بِيهْ، وبَرْشَة نَاسْ بِشْ يِفْرْحُوا كِي يِتُّولِدْ. <verse eid="LUK 1:14" /><verse number="15" style="v" sid="LUK 1:15" />عْلَى خَاطْرُو بِشْ يْكُونْ عْظِيمْ عَنْدْ الرَّبْ، ومُشْ بِشْ يُشْرُبْ لَا شْرَابْ ولَا حَاجَاتْ تْسَكِّرْ، وبِشْ يِتْمْلَى بِالرُّوحْ القُدُسْ مِلِّي هُوَّ فِي كِرْشْ أُمُّو. <verse eid="LUK 1:15" /><verse number="16" style="v" sid="LUK 1:16" />وبِشْ يْرَجَّعْ بَرْشَة مِنْ بَنِي إِسْرَائِيلْ لِلرَّبْ إِلَاهُّمْ. <verse eid="LUK 1:16" /><verse number="17" style="v" sid="LUK 1:17" />ويْجِي قْبَلْ الرَّبْ بْرُوحْ إِيلِيَّا وقُوْتُو، بَاشْ يْصَالَحْ الوَالْدِينْ مْعَ وْلَادْهُمْ، ويْرَجَّعْ العَاصِينْ لْحِكْمَة الصَّالْحِينْ، وهَكَّا يْحَضِّرْ شَعْبْ مُسْتْعَدْ لِلرَّبْ».<verse eid="LUK 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18" />يَاخِي قَالْ زَكَرِيَّا لِلْمَلَاكْ: «كِيفَاشْ يْصِيرْ هَاذَا، وآنَا رَاجِلْ شَايِبْ ومَرْتِي كْبِيرَة فِي العْمُرْ؟». <verse eid="LUK 1:18" /><verse number="19" style="v" sid="LUK 1:19" />جَاوْبُو المَلَاكْ: «آنَا جِبْرِيلْ الوَاقِفْ قُدَّامْ اللَّهْ، وآنَا تِبْعَثْتْ بَاشْ نْكَلْمِكْ ونْبَشْرِكْ بِالخْبَرْ هَاذَا. <verse eid="LUK 1:19" /><verse number="20" style="v" sid="LUK 1:20" />وهَاكْ تَوَّا بِشْ تِبْقَى سَاكِتْ ومَاكِشْ بِشْ تْنَجِّمْ تِتْكَلِّمْ حَتَّى لِينْ يْجِي النْهَارْ الِّي يْتِمْ فِيهْ هَاذَا، عْلَى خَاطْرِكْ مَا صَدَّقْتِشْ كْلَامِي الِّي بِشْ يْصِيرْ فِي وَقْتُو».<verse eid="LUK 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21" />الشَّعْبْ كَانْ يِسْتَنَّى فِي زَكَرِيَّا ومِسْتَغْرِبْ كِيفَاشْ بْطَى لْدَاخِلْ فِي الهَيْكِلْ. <verse eid="LUK 1:21" /><verse number="22" style="v" sid="LUK 1:22" />وكِي خْرَجْ مَا نَجَّمْشْ يْكَلَّمْهُمْ، يَاخِي فِهْمُوا الِّي هُوَّ شَافْ رُؤْيَا فِي الهَيْكِلْ، وبْدَا يَحْكِي مْعَاهُمْ بِالإِشَارَاتْ وبْقَى سَاكِتْ. <verse eid="LUK 1:22" /><verse number="23" style="v" sid="LUK 1:23" />ووَقْتِلِّي كِمْلِتْ أَيَّامَاتْ خِدْمْتُو رْجَعْ لْدَارُو. <verse eid="LUK 1:23" /><verse number="24" style="v" sid="LUK 1:24" />وبَعْدْ مُدَّة حِبْلِتْ مَرْتُو أَلِيصَابَاتْ، وخَبَّاتْ رُوحْهَا خَمْسَة شْهُورْ وكَانِتْ تْقُولْ: <verse eid="LUK 1:24" /><verse number="25" style="v" sid="LUK 1:25" />«هَاذَا آشْ عْمَلْ مْعَايَا الرَّبْ نْهَارِةْ الِّي نْعِمْ عْلِيَّا ونَحَّالِي عَارِي بِينْ النَّاسْ!».<verse eid="LUK 1:25" /></para>
  <para style="s">البْشَارَة بِوْلَادِةْ يَسُوعْ</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26" />وكِي كَانِتْ أَلِيصَابَاتْ فِي شْهَرْهَا السَّادِسْ، بْعَثْ اللَّهْ المَلَاكْ جِبْرِيلْ لِمْدِينَة فِي مَنْطَقْةْ الجَلِيلْ إِسْمْهَا النَّاصْرَة، <verse eid="LUK 1:26" /><verse number="27" style="v" sid="LUK 1:27" />لِصْبِيَّة إِسْمْهَا مَرْيِمْ مَخْطُوبَة لْرَاجِلْ مِنْ نَسْلْ دَاوِدْ إِسْمُو يُوسِفْ. <verse eid="LUK 1:27" /><verse number="28" style="v" sid="LUK 1:28" />يَاخِي دْخَلِّلْهَا المَلَاكْ وقَالِلْهَا: «السَّلَامْ يَلِّي نْعِمْ عْلِيكْ اللَّهْ! الرَّبْ مْعَاكْ، مُبَارْكَة إِنْتِ مِنْ بِينْ النْسَاء». <verse eid="LUK 1:28" /><verse number="29" style="v" sid="LUK 1:29" />يَاخِي دَخْلِتْ بْعَضْهَا مِنْ كْلَامْ المَلَاكْ وقَالِتْ بِينْهَا وبِينْ رُوحْهَا: «زَعْمَة شْنُوَّة مَعْنَى السَّلَامْ هَاذَا؟». <verse eid="LUK 1:29" /><verse number="30" style="v" sid="LUK 1:30" />يَاخِي قَالِلْهَا المَلَاكْ: «مَا تْخَافِشْ يَا مَرْيِمْ رَاهُو اللَّهْ نْعِمْ عْلِيكْ. <verse eid="LUK 1:30" /><verse number="31" style="v" sid="LUK 1:31" />وهَاكْ بِشْ تِحْبِلْ وتْجِيبْ وْلَيِّدْ وتْسَمِّيهْ يَسُوعْ. <verse eid="LUK 1:31" /><verse number="32" style="v" sid="LUK 1:32" />وبِشْ يْكُونْ عْظِيمْ، ويِتْسَمَّى إِبْنْ العَالِي، ويَعْطِيهْ الرَّبْ الإِلَاهْ عَرْشْ بُوهْ دَاوِدْ، <verse eid="LUK 1:32" /><verse number="33" style="v" sid="LUK 1:33" />ويِمْلِكْ عْلَى ذُرِّيِّةْ يَعْقُوبْ لِلْأَبَدْ، ومَا يْكُونِشْ فَمَّة نْهَايَة لْمُلْكُو».<verse eid="LUK 1:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34" />يَاخِي قَالِتْ مَرْيِمْ لِلْمَلَاكْ: «كِيفَاشْ يْصِيرْ هَاذَا وآنَا مَزِّلْتْ صْبِيَّة؟». <verse eid="LUK 1:34" /><verse number="35" style="v" sid="LUK 1:35" />جَاوِبْهَا المَلَاكْ: «الرُّوحْ القُدُسْ يَهْبِطْ عْلِيكْ وقُدْرِةْ العَالِي تْغَطِّيكْ، هَاذَاكَا عْلَاشْ القُدُّوسْ الِّي بِشْ تُولْدُو يِتْسَمَّى إِبْنْ اللَّهْ. <verse eid="LUK 1:35" /><verse number="36" style="v" sid="LUK 1:36" />وهَايْ قْرِيبْتِكْ أَلِيصَابَاتْ حِبْلَى بِوْلَيِّدْ وهِيَّ كْبِيرَة فِي العْمُرْ، ولِّي كَانُوا يْقُولُوا عْلِيهَا مَا تَضْنَاشْ هَايْ تَوَّا فِي شْهَرْهَا السَّادِسْ. <verse eid="LUK 1:36" /><verse number="37" style="v" sid="LUK 1:37" />عْلَى خَاطِرْ حَتَّى شَيْ مَاهُو مُسْتَحِيلْ عَنْدْ اللَّهْ». <verse eid="LUK 1:37" /><verse number="38" style="v" sid="LUK 1:38" />يَاخِي قَالِتْ مَرْيِمْ: «آنَا خْدِيمِةْ الرَّبْ، خَلِّي يْصِيرْلِي كِيمَا قُلْتْ». ومْشَى المَلَاكْ مِنْ عَنْدْهَا.<verse eid="LUK 1:38" /></para>
  <para style="s">مَرْيِمْ تْزُورْ أَلِيصَابَاتْ</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39" />وفِي الأَيَّامَاتْ هَاذُوكُمْ، حَضّْرِتْ مَرْيِمْ رُوحْهَا ومْشَاتْ فِيسَعْ لِلجْبَالْ لِمْدِينَة فِي يَهُوذَا. <verse eid="LUK 1:39" /><verse number="40" style="v" sid="LUK 1:40" />ودَخْلِتْ لْدَارْ زَكَرِيَّا وسَلْمِتْ عْلَى أَلِيصَابَاتْ. <verse eid="LUK 1:40" /><verse number="41" style="v" sid="LUK 1:41" />وكِي سَمْعِتْ أَلِيصَابَاتْ سْلَامْ مَرْيِمْ تْحَرِّكْ الصْغِيرْ فِي كِرْشْهَا، وتِمْلَاتْ بِالرُّوحْ القُدُسْ. <verse eid="LUK 1:41" /><verse number="42" style="v" sid="LUK 1:42" />وعَيْطِتْ بْصُوتْ عَالِي وقَالِتْ: «مُبَارْكَة إِنْتِ مِنْ بِينْ النْسَاء، ومُبَارِكْ الصْغِيرْ الِّي فِي كِرْشِكْ. <verse eid="LUK 1:42" /><verse number="43" style="v" sid="LUK 1:43" />شْكُونِي آنَا حَتَّى تْجِينِي أُمْ سِيدِي؟ <verse eid="LUK 1:43" /><verse number="44" style="v" sid="LUK 1:44" />أَوِّلْ مَا وْصِلْ سْلَامِكْ لْوِذْنَيَّا، الصْغِيرْ الِّي فِي كِرْشِي تْحَرِّكْ مِالفَرْحَة. <verse eid="LUK 1:44" /><verse number="45" style="v" sid="LUK 1:45" />وصَحَّة لِيهَا الِّي أَمْنِتْ إِنُّو الكْلَامْ الِّي تْقَالِلْهَا مِنْ عَنْدْ الرَّبْ بِشْ يْصِيرْ».<verse eid="LUK 1:45" /></para>
  <para style="s">مَرْيِمْ تْسَبَّحْ اللَّهْ</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46" />وقَالِتْ مَرْيِمْ:</para>
  <para style="b" vid="LUK 1:46" />
  <para style="q1" vid="LUK 1:46">«نَفْسِي تْعَظِّمْ الرَّبْ،<verse eid="LUK 1:46" /></para>
  <para style="q2">
    <verse number="47" style="v" sid="LUK 1:47" />ورُوحِي تِفْرَحْ بِاللَّهْ الِّي يْنَجِّينِي.<verse eid="LUK 1:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LUK 1:48" />عْلَى خَاطْرُو نْعِمْ عْلِيَّا آنَا خْدِيمْتُو البْسِيطَة!</para>
  <para style="q2" vid="LUK 1:48">ومِنْ تَوَّا الأَجْيَالْ الكُلْ بِشْ يْقُولُوا صَحَّة لِيهَا.<verse eid="LUK 1:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="LUK 1:49" />عْلَى خَاطِرْ اللَّهْ القَادِرْ عْلَى كُلْ شَيْ عْمَلْ مْعَايَا حَاجَاتْ عْظِيمَة.</para>
  <para style="q2" vid="LUK 1:49">إِسْمُو قُدُّوسْ،<verse eid="LUK 1:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50" />ورَحْمْتُو لِلِّي يَتَّقِيوُهْ،</para>
  <para style="q2" vid="LUK 1:50">تِبْقَى مِنْ جِيلْ لْجِيلْ.<verse eid="LUK 1:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51" />بْقُدْرْتُو عْمَلْ حَاجَاتْ عْظِيمَة.</para>
  <para style="q2" vid="LUK 1:51">وشَرِّدْ الِّي قْلُوبْهُمْ مِتْكَبْرَة.<verse eid="LUK 1:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52" />هَبِّطْ الحُكَّامْ مِنْ عَرْشْهُمْ،</para>
  <para style="q2" vid="LUK 1:52">ورْفَعْ المِتْوَاضْعِينْ.<verse eid="LUK 1:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53" />شَبَّعْ الجْوَاعَى بِالخِيرَاتْ،</para>
  <para style="q2" vid="LUK 1:53">ورَجَّعْ الغُنْيَا بِيْدِيهُمْ فَارْغِينْ.<verse eid="LUK 1:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54" />عَاوِنْ إِسْرَائِيلْ عَبْدُو،</para>
  <para style="q2" vid="LUK 1:54">عْلَى خَاطِرْ وِعْدُو بِشْ يَرَحْمُو،<verse eid="LUK 1:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55" />كِيمَا وْعِدْ جْدُودْنَا،</para>
  <para style="q2" vid="LUK 1:55">إِبْرَاهِيمْ وذُرِّيتُو لِلْأَبَدْ».<verse eid="LUK 1:55" /></para>
  <para style="b" />
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56" />وبْقَاتْ مَرْيِمْ بَحْذَا أَلِيصَابَاتْ قْرِيبْ الثْلَاثَة شْهُرْ، ومْبَعِّدْ رَجْعِتْ لْدَارْهَا.<verse eid="LUK 1:56" /></para>
  <para style="s">وْلَادِةْ يُوحَنَّا</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57" />وَقْتِلِّي جَاء وَقْتْ أَلِيصَابَاتْ بَاشْ تُولِدْ، جَابِتْ وْلَيِّدْ. <verse eid="LUK 1:57" /><verse number="58" style="v" sid="LUK 1:58" />وسَمْعُوا جِيرَانْهَا ولِّي يُقْرْبُولْهَا إِنُّو اللَّهْ فَاضْ عْلِيهَا بْرَحْمْتُو، وفَرْحُوا مْعَاهَا. <verse eid="LUK 1:58" /><verse number="59" style="v" sid="LUK 1:59" />وفِي النْهَارْ الثَّامِنْ جَاوْ بَاشْ يْطَهْرُوا الطْفُلْ، وحَبُّوا يْسَمِّيوَهْ زَكَرِيَّا عْلَى إِسْمْ بُوهْ. <verse eid="LUK 1:59" /><verse number="60" style="v" sid="LUK 1:60" />آمَا أُمُّو قَالِتْ: «لَا، بِشْ يِتْسَمَّى يُوحَنَّا». <verse eid="LUK 1:60" /><verse number="61" style="v" sid="LUK 1:61" />يَاخِي قَالُولْهَا: «حَتَّى وَاحِدْ مِنْ امَّالِيكْ مَا تْسَمَّى بِالإِسْمْ هَاذَا». <verse eid="LUK 1:61" /><verse number="62" style="v" sid="LUK 1:62" />وسِأْلُوا بُوهْ بِالإِشَارَاتْ بَاشْ يَعْرْفُوا آشْ يْحِبْ يْسَمِّيهْ. <verse eid="LUK 1:62" /><verse number="63" style="v" sid="LUK 1:63" />وبُوهْ طْلَبْ لُوحَة وكْتِبْ عْلِيهَا: «إِسْمُو يُوحَنَّا». يَاخِي بِهْتُوا الكُلْ. <verse eid="LUK 1:63" /><verse number="64" style="v" sid="LUK 1:64" />وبِالوَقْتْ تْحَلْ فُمْ زَكَرِيَّا وتْسَرَّحْ لْسَانُو، وبْدَا يِتْكَلِّمْ ويْسَبَّحْ فِي اللَّهْ. <verse eid="LUK 1:64" /><verse number="65" style="v" sid="LUK 1:65" />والجِيرَانْ الكُلْ مْكِنْهُمْ الخُوفْ، وبْقَاوْ النَّاسْ يَحْكِيوْ بِالأُمُورْ هَاذِي فِي جْبَالْ مَنْطَقْةْ يَهُوذَا الكُلْ. <verse eid="LUK 1:65" /><verse number="66" style="v" sid="LUK 1:66" />ولِّي سَمْعُوهُمْ الكُلْ، قَعْدُوا يْقُولُوا فِي قْلُوبْهُمْ: «زَعْمَة شْنُوَّة بِشْ يْوَلِّي هَا الوْلَيِّدْ؟». عْلَى خَاطِرْ قُدْرِةْ الرَّبْ كَانِتْ مْعَاهْ.<verse eid="LUK 1:66" /></para>
  <para style="s">زَكَرِيَّا يْسَبَّحْ اللَّهْ</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67" />وتِمْلَى زَكَرِيَّا بُوهْ بِالرُّوحْ القُدُسْ، وتْنَبَّأْ وقَالْ:<verse eid="LUK 1:67" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68" />«مُبَارَكْ الرَّبْ إِلَاهْ إِسْرَائِيلْ،</para>
  <para style="q2" vid="LUK 1:68">عْلَى خَاطْرُو جَاء بَاشْ يْعَاوِنْ شَعْبُو ويِفْدِيهْ،<verse eid="LUK 1:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69" />وبْعَثِّلْنَا مُنَجِّي قْدِيرْ،</para>
  <para style="q2" vid="LUK 1:69">مِنْ عَرْشْ عَبْدُو دَاوِدْ،<verse eid="LUK 1:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70" />كِيمَا وْعِدْ مِنْ قْدِيمْ الزْمَانْ عْلَى لْسَانْ أَنْبِيَاؤُو القِدِّيسِينْ،<verse eid="LUK 1:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71" />بَاشْ يْنَجِّينَا مِنْ أَعْدَائْنَا،</para>
  <para style="q2" vid="LUK 1:71">ومِنْ يْدِينْ الِّي يِكْرْهُونَا الكُلْ.<verse eid="LUK 1:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72" />وهَكَّا، يْظَهِّرْ رَحْمْتُو لِجْدُودْنَا،</para>
  <para style="q2" vid="LUK 1:72">ويِتْذَكِّرْ عَهْدُو المُقَدِّسْ،<verse eid="LUK 1:72" /></para>
  <para style="q1">
    <verse number="73" style="v" sid="LUK 1:73" />عْلَى خَاطْرُو حْلِفْ يْمِينْ،</para>
  <para style="q2" vid="LUK 1:73">لْبُونَا إِبْرَاهِيمْ،<verse eid="LUK 1:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="LUK 1:74" />إِنُّو يْنَجِّينَا مِنْ أَعْدَائْنَا،</para>
  <para style="q2" vid="LUK 1:74">بَاشْ نِعْبْدُوهْ بْلَا خُوفْ،<verse eid="LUK 1:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="LUK 1:75" />وأَحْنَا فِي القَدَاسَة والصَّلَاحْ قُدَّامُو</para>
  <para style="q2" vid="LUK 1:75">طُولْ حْيَاتْنَا.<verse eid="LUK 1:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76" />وإِنْتِ يَا وِلْدِي، بِشْ تِتْسَمَّى نَبِيْ العَالِي،</para>
  <para style="q2" vid="LUK 1:76">عْلَى خَاطْرِكْ جِيتْ قْبَلْ الرَّبْ بِشْ تْحَضَّرْلُو الطْرِيقْ،<verse eid="LUK 1:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77" />وتْعَلِّمْ شَعْبُو إِنُّو النْجَاةْ تْكُونْ</para>
  <para style="q2" vid="LUK 1:77">بْمَغْفِرْةْ ذْنُوبْهُمْ.<verse eid="LUK 1:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78" />عْلَى خَاطِرْ إِلَاهْنَا رَحْمْتُو عْظِيمَة،</para>
  <para style="q2" vid="LUK 1:78">خَلَّى كَوْكِبْ الفَجْرْ يْزُورْنَا مِالسْمَاء ويِضْوِي عْلِينَا،<verse eid="LUK 1:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79" />ويْضَوِّي عَالعَايْشِينْ فِي الظْلَامْ وفِي ظِلْ المُوتْ،</para>
  <para style="q2" vid="LUK 1:79">ويِهْدِي خَطْوَاتْنَا فِي طْرِيقْ السَّلَامْ».<verse eid="LUK 1:79" /></para>
  <para style="b" />
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80" />وكَانْ الطْفُلْ يِكْبِرْ ويِتْقَوَّى بِالرُّوحْ، وكَانْ يْعِيشْ فِي الخْلَاء لِلنْهَارْ الِّي ظْهُرْ فِيهْ لْبَنِي إِسْرَائِيلْ.<verse eid="LUK 1:80" /></para>
  <chapter eid="LUK 1" />
  <chapter number="2" style="c" sid="LUK 2" />
  <para style="s">وْلَادِةْ يَسُوعْ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1" />وفِي الزْمَانْ هَاذَاكَا، عْطَى القَيْصِرْ أُغُسْطُسْ أَمْرْ بَاشْ يِحْسْبُوا عْدَدْ سُكَّانْ الإِمْبْرَاطُورِيَّة. <verse eid="LUK 2:1" /><verse number="2" style="v" sid="LUK 2:2" />وكَانْ هَاذَا أَوِّلْ حِسْبَانْ لِلسُّكَّانْ، وصَارْ فِي زْمَانْ كِيرِينْيُوسْ وَالِي مَنْطَقْةْ سُورِيَّة. <verse eid="LUK 2:2" /><verse number="3" style="v" sid="LUK 2:3" />يَاخِي مْشَى كُلْ وَاحِدْ لِمْدِينْتُو بَاشْ يِتْقَيِّدْ فِيهَا.<verse eid="LUK 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4" />ومْشَى يُوسِفْ زَادَا مِنْ مْدِينِةْ النَّاصْرَة الِّي فِي مَنْطَقْةْ الجَلِيلْ، لِمْدِينِةْ دَاوِدْ الِّي تِتْسَمَّى بَيْتْ لَحْمْ الِّي فِي مَنْطَقْةْ اليَهُودِيَّة، عْلَى خَاطْرُو كَانْ مِنْ ذُرِّيِّةْ دَاوِدْ، <verse eid="LUK 2:4" /><verse number="5" style="v" sid="LUK 2:5" />مْشَى بَاشْ يِتْقَيِّدْ غَادِي، هُوَّ وخَطِيبْتُو مَرْيِمْ، الِّي كَانِتْ حِبْلَى. <verse eid="LUK 2:5" /><verse number="6" style="v" sid="LUK 2:6" />وهُومَا فِي بَيْتْ لَحْمْ، جَاء وَقْتْ وْلَادِتْهَا. <verse eid="LUK 2:6" /><verse number="7" style="v" sid="LUK 2:7" />يَاخِي وِلْدِتْ وِلْدْهَا البِكْرْ، وقَمْطِتُّو ورَقْدِتُّو فِي مَعْلِفْ مْتَاعْ حَيَوَانَاتْ، عْلَى خَاطِرْ مَا كَانِشْ فَمَّة بْلَاصَة لِيهُمْ فِي الوْكَالَة.<verse eid="LUK 2:7" /></para>
  <para style="s">المْلَايْكَة يْخَبْرُوا السُرَّاحْ بِوْلَادِةْ يَسُوعْ</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8" />وفِي المَنْطْقَة هَاذِيكَا، كَانْ فَمَّة سُرَّاحْ يْبَاتُوا فِي السْوَانِي، ويِتْبَادْلُوا فِي العَسَّة عْلَى غْنَمْهُمْ فِي اللِّيلْ. <verse eid="LUK 2:8" /><verse number="9" style="v" sid="LUK 2:9" />وإِذَا بِيهْ مَلَاكْ مِنْ عَنْدْ الرَّبْ ظْهُرِّلْهُمْ، ومَجْدْ الرَّبْ ضْوَى عْلِيهُمْ مِنْ كُلْ جِيهَة، يَاخِي خَافُوا بَرْشَة. <verse eid="LUK 2:9" /><verse number="10" style="v" sid="LUK 2:10" />آمَا المَلَاكْ قَالِلْهُمْ: «مَا تْخَافُوشْ! جِيتْ نْبَشِّرْ فِيكُمْ بِخْبَرْ عْظِيمْ يْفَرَّحْ الشَّعْبْ الكُلْ. <verse eid="LUK 2:10" /><verse number="11" style="v" sid="LUK 2:11" />اليُومْ فِي مْدِينِةْ دَاوِدْ تُوْلِدِّلْكُمْ مُنَجِّي هُوَّ المَسِيحْ الرَّبْ. <verse eid="LUK 2:11" /><verse number="12" style="v" sid="LUK 2:12" />وهَاذِي أَمَارَة لِيكُمْ: تَلْقَاوْ طْفُلْ مَلْفُوفْ بِقْمَاطَة ورَاقِدْ فِي مَعْلِفْ». <verse eid="LUK 2:12" /><verse number="13" style="v" sid="LUK 2:13" />وهُومَا هَكَّاكَا، ظْهُرْ مْعَ المَلَاكْ عْدَدْ كْبِيرْ مِنْ مْلَايِكْةْ جَيْشْ السْمَاءْ، يْسَبْحُوا فِي اللَّهْ ويْقُولُوا:<verse eid="LUK 2:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14" />«المَجْدْ لِلَّهْ فِي السْمَاء،</para>
  <para style="q2" vid="LUK 2:14">وعَالأَرْضْ السَّلَامْ لِلنَّاسْ الِّي يْحِبْهُمْ اللَّهْ».<verse eid="LUK 2:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15" />ووَقْتِلِّي رَجْعُوا المْلَايْكَة لِلسْمَاء، قَالُوا السُرَّاحْ لِبْعَضْهُمْ: «هَيَّا نِمْشِيوْ لْبِيتْ لَحْمْ ونْشُوفُوا الِّي صَارْ، ولِّي خَبَّرْنَا بِيهْ الرَّبْ». <verse eid="LUK 2:15" /><verse number="16" style="v" sid="LUK 2:16" />ومْشَاوْ فِيسَعْ، ولْقَاوْ مَرْيِمْ ويُوسِفْ والطْفُلْ رَاقِدْ فِي المَعْلِفْ. <verse eid="LUK 2:16" /><verse number="17" style="v" sid="LUK 2:17" />ووَقْتِلِّي شَافُوهْ، حْكَاوْ عَالكْلَامْ الِّي تْقَالِلْهُمْ فِي مَا يْخُصْ الطْفُلْ هَاذَا. <verse eid="LUK 2:17" /><verse number="18" style="v" sid="LUK 2:18" />ولِّي سَمْعُوا الكُلْ تْعَجْبُوا مِلِّي قَالُوهْ السُرَّاحْ. <verse eid="LUK 2:18" /><verse number="19" style="v" sid="LUK 2:19" />آمَا مَرْيِمْ خَلَّاتْ الكْلَامْ هَاذَا الكُلْ فِي قَلْبْهَا وقَعْدِتْ تْخَمِّمْ فِيهْ. <verse eid="LUK 2:19" /><verse number="20" style="v" sid="LUK 2:20" />ورَجْعُوا السُرَّاحْ وهُومَا يْمَجْدُوا ويْسَبْحُوا فِي اللَّهْ عَلِّي سَمْعُوهْ وشَافُوهْ الكُلْ، عْلَى خَاطِرْ كُلْ شَيْ كَانْ كِيمَا قَالِلْهُمْ المَلَاكْ بِالضَّبْطْ.<verse eid="LUK 2:20" /></para>
  <para style="s">مَرْيِمْ ويُوسِفْ يْهِزُّوا يَسُوعْ لِلْهَيْكِلْ</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21" />وبَعْدْ ثْمَنْيَة أَيَّامْ، جَاء الوَقْتْ الِّي يْطَهْرُوا فِيهْ الطْفُلْ، وسَمَّاوَهْ يَسُوعْ كِيمَا سَمَّاهْ المَلَاكْ قْبَلْ مَا تِحْبِلْ بِيهْ مَرْيِمْ. <verse eid="LUK 2:21" /><verse number="22" style="v" sid="LUK 2:22" />ووَقْتِلِّي تْعَدَّاوْ أَيَّامْ تَطْهِيرْهُمْ، حَسْبْ شَرِيعِةْ مُوسَى، طَلْعُوا بِيهْ لْأُورْشَلِيمْ بَاشْ يْقَدْمُوهْ لِلرَّبْ، <verse eid="LUK 2:22" /><verse number="23" style="v" sid="LUK 2:23" />كِيمَا مَكْتُوبْ فِي شَرِيعِةْ الرَّبْ: «كُلْ بِكْرْ ذْكَرْ يِتْخَصِّصْ لِلرَّبْ»، <verse eid="LUK 2:23" /><verse number="24" style="v" sid="LUK 2:24" />وزَادَا بَاشْ يْقَدْمُوا ذْبِيحَة كِيمَا وَصَّاتْ شَرِيعَةْ الرَّبْ: «زُوزْ طْيُورْ يْمَامْ وَلَّا زُوزْ فْرُوخْ حْمَامْ».<verse eid="LUK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25" />وكَانْ فَمَّة رَاجِلْ فِي أُورْشَلِيمْ إِسْمُو سِمْعَانْ، والرَّاجِلْ هَاذَا كَانْ صَالَحْ ويْخَافْ اللَّهْ. وكَانْ يِسْتَنَّى وَقْتَاشْ يْجِي الِّي بِشْ يْنَجِّي شَعْبْ إِسْرَائِيلْ، والرُّوحْ القُدُسْ كَانْ مْعَاهْ. <verse eid="LUK 2:25" /><verse number="26" style="v" sid="LUK 2:26" />والرُّوحْ القُدُسْ وْحَالُو قْبَلْ، إِنُّو مَا يْمُوتْ إِلَّا مَا يْرَى مَسِيحْ الرَّبْ. <verse eid="LUK 2:26" /><verse number="27" style="v" sid="LUK 2:27" />وجَاء لِلْهَيْكِلْ بْوَحْيْ مِالرُّوحْ. ووَقْتِلِّي يُوسِفْ ومَرْيِمْ دَخْلُوا ومْعَاهُمْ وِلْدْهُمْ يَسُوعْ بَاشْ يَعْمْلُولُو الِّي فَرْضِتُّو الشَّرِيعَة، <verse eid="LUK 2:27" /><verse number="28" style="v" sid="LUK 2:28" />هَزُّو سِمْعَانْ بِينْ يْدِيهْ، ومَجِّدْ اللَّهْ وقَالْ:<verse eid="LUK 2:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29" />«يَا رَبْ، تَوَّا تْحَقَّقْ وَعْدِكْ لِيَّا،</para>
  <para style="q2" vid="LUK 2:29">خَلِّي عَبْدِكْ يِمْشِي بْسَلَامْ.<verse eid="LUK 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30" />عْلَى خَاطِرْ عِينَيَّا شَافُوا نْجَاتِكْ<verse eid="LUK 2:30" /></para>
  <para style="q2">
    <verse number="31" style="v" sid="LUK 2:31" />الِّي حَضَّرْتْهَا بَاشْ يْشُوفُوهَا الشُّعُوبْ الكُلْ.<verse eid="LUK 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32" />هِيَّ نُورْ تِهْدِي بِيهْ الشُّعُوبْ الأُخْرِينْ،</para>
  <para style="q2" vid="LUK 2:32">ومَجْدْ لْبَنِي إِسْرَائِيلْ شَعْبِكْ».<verse eid="LUK 2:32" /></para>
  <para style="b" />
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33" />وتْعَجْبُوا بُوهْ وأُمُّو مِالكْلَامْ الِّي تْقَالْ عْلِيهْ. <verse eid="LUK 2:33" /><verse number="34" style="v" sid="LUK 2:34" />وبَارِكْهُمْ سِمْعَانْ وقَالْ لْمَرْيِمْ أُمُّو: «الطْفُلْ هَاذَا اخْتَارُو اللَّهْ بَاشْ يْكُونْ سْبَبْ إِنُّو بَرْشَة نَاسْ فِي بَنِي إِسْرَائِيلْ يْطِيحُوا، وبَرْشَة نَاسْ يْقُومُوا. ويْكُونْ أَمَارَة مِنْ عَنْدْ اللَّهْ يْقَاوْمُوهَا. <verse eid="LUK 2:34" /><verse number="35" style="v" sid="LUK 2:35" />وتِتْكْشِفْ نِيَّاتْ بَرْشَة قْلُوبْ. آمَا إِنْتِ، الحُزْنْ بِشْ يُدْخُلْ فِي قَلْبِكْ كِيمَا السِّيفْ».<verse eid="LUK 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36" />وكَانِتْ فَمَّة نَبِيَّة، إِسْمْهَا حَنَّة بِنْتْ فَنُوئِيلْ، مِنْ عَرْشْ أَشِيرْ. كَانِتْ كْبِيرَة فِي العْمُرْ، وعَاشِتْ مْعَ رَاجِلْهَا سَبْعَة سْنِينْ بَعْدْ العِرْسْ، <verse eid="LUK 2:36" /><verse number="37" style="v" sid="LUK 2:37" />ومْبَعِّدْ عَاشِتْ هَجَّالَة. وفِي الوَقْتْ هَاذَاكَا كَانْ عْمُرْهَا 84 سْنَة. وكَانِتْ دِيمَا فِي الهَيْكِلْ، تِعْبِدْ فِي اللَّهْ نْهَارْ ولِيلْ بِالصُّومْ والصْلَاةْ. <verse eid="LUK 2:37" /><verse number="38" style="v" sid="LUK 2:38" />وجَاتْ فِي نَفْسْ الوَقْتْ وبْدَاتْ تْسَبَّحْ فِي اللَّهْ، وتِتْكَلِّمْ عْلَى يَسُوعْ مْعَ كُلْ النَّاسْ الِّي كَانُوا يِسْتَنَّاوْ فِي اللَّهْ بَاشْ يِفْدِي أُورْشَلِيمْ.<verse eid="LUK 2:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39" />وبَعْدْمَا كَمْلُوا يُوسِفْ ومَرْيِمْ فْرَايِضْ شَرِيعِةْ الرَّبْ الكُلْ، رَجْعُوا لِلْجَلِيلْ، لِمْدِينِتْهُمْ النَّاصْرَة. <verse eid="LUK 2:39" /><verse number="40" style="v" sid="LUK 2:40" />وكَانْ الوْلَيِّدْ يَسُوعْ يِكْبِرْ ويِتْقَوَّى. وكَانْ مِلْيَانْ بِالحِكْمَة ونِعْمَةْ اللَّهْ كَانِتْ عْلِيهْ.<verse eid="LUK 2:40" /></para>
  <para style="s">يَسُوعْ وِلْدْ أَثْنَاشِنْ سْنَة فِي الهَيْكِلْ</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41" />وكَانُوا وَالْدِيهْ يِمْشِيوْ كُلْ عَامْ لْأُورْشَلِيمْ فِي عِيدْ الفِصْحْ. <verse eid="LUK 2:41" /><verse number="42" style="v" sid="LUK 2:42" />وكِي كَانْ عْمُرْ يَسُوعْ أَثْنَاشِنْ سْنَة، طَلْعُوا لْأُورْشَلِيمْ كِي العَادَة فِي العِيدْ. <verse eid="LUK 2:42" /><verse number="43" style="v" sid="LUK 2:43" />وبَعْدْمَا وْفَاوْ أَيَّامَاتْ العِيدْ، رَوْحُوا وَالْدِيهْ وبْقَى يَسُوعْ فِي أُورْشَلِيمْ مِنْ غِيرْ مَا يَعْرْفُوا. <verse eid="LUK 2:43" /><verse number="44" style="v" sid="LUK 2:44" />ومْشَى فِي بَالْهُمْ الِّي هُوَّ مْعَ بْقِيِّةْ النَّاسْ الِّي مْسَافْرِينْ مْعَاهُمْ، وبَعْدْمَا مْشَاوْ مْسَافِةْ نْهَارْ كَامِلْ، بْدَاوْ يْلَوْجُوا عْلِيهْ بِينْ الأَقَارِبْ والمْعَارِفْ. <verse eid="LUK 2:44" /><verse number="45" style="v" sid="LUK 2:45" />وكِي مَا لْقَاوْهُوشْ رَجْعُوا لْأُورْشَلِيمْ يْلَوْجُوا عْلِيهْ. <verse eid="LUK 2:45" /><verse number="46" style="v" sid="LUK 2:46" />وبَعْدْ ثْلَاثَة أَيَّامْ لْقَاوَهْ فِي الهَيْكِلْ قَاعِدْ وِسْطْ المُعَلْمِينْ يِسْمَعْ ويِسْإِلْ فِيهُمْ. <verse eid="LUK 2:46" /><verse number="47" style="v" sid="LUK 2:47" />ولِّي سَمْعُوهْ الكُلْ بْقَاوْ بَاهْتِينْ فِي فَهْمُو وفِي الأَجْوْبَة مْتَاعُو. <verse eid="LUK 2:47" /><verse number="48" style="v" sid="LUK 2:48" />وتْعَجْبُوا وَالْدِيهْ وَقْتِلِّي شَافُوهْ، وقَالِتْلُو أُمُّو: «يَا وْلِيدِي، عْلَاشْ عْمَلْتْ فِينَا هَكَّا؟ رَانِي آنَا وبُوكْ تْعَذَّبْنَا بَرْشَة وأَحْنَا نْلَوْجُوا عْلِيكْ!». <verse eid="LUK 2:48" /><verse number="49" style="v" sid="LUK 2:49" />يَاخِي جَاوِبْهُمْ: «عْلَاشْ تْلَوْجُوا عْلِيَّا؟ مَا تَعْرْفُوشْ الِّي يِلْزِمْنِي نْكُونْ فِي دَارْ بَابَا؟». <verse eid="LUK 2:49" /><verse number="50" style="v" sid="LUK 2:50" />آمَا هُومَا مَا فِهْمُوشْ الكْلَامْ الِّي قَالْهُولْهُمْ. <verse eid="LUK 2:50" /><verse number="51" style="v" sid="LUK 2:51" />ورَجْعْ مْعَاهُمْ لِلنَّاصْرَة وكَانْ يِسْمَعْ كْلَامْهُمْ. وأُمُّو خَلَّاتْ هَاذَا الكُلْ فِي قَلْبْهَا. <verse eid="LUK 2:51" /><verse number="52" style="v" sid="LUK 2:52" />وكَانْ يَسُوعْ يِكْبِرْ فِي بَدْنُو وفِي الحِكْمَة وفِي النِّعْمَة عَنْدْ اللَّهْ وعَنْدْ النَّاسْ.<verse eid="LUK 2:52" /></para>
  <chapter eid="LUK 2" />
  <chapter number="3" style="c" sid="LUK 3" />
  <para style="s">يُوحَنَّا يْحَضِّرْ الطْرِيقْ لْيَسُوعْ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1" />وَقْتِلِّي القَيْصِرْ طِيبَارْيُوسْ عْمَلْ 15 سْنَة فِي الحُكْمْ، وكَانْ بِيلَاطُسْ البُنْطِي وَالِي عْلَى مَنْطَقْةْ اليَهُودِيَّة، وهِيرُودُسْ وَالِي عْلَى مَنْطَقْةْ الجَلِيلْ، وخُوهْ فِيلِيبُّسْ وَالِي عْلَى مَنْطَقْةْ إِيطُورِيَّة وتْرَاخُونِيتْسْ، ولِيسَانْيُوسْ وَالِي عْلَى مَنْطَقْةْ الأَبِلِيَّة، <verse eid="LUK 3:1" /><verse number="2" style="v" sid="LUK 3:2" />وفِي الوَقْتْ الِّي كَانُوا فِيهْ حَنَّانْ وقِيَافَا كْبَارْ الكَهَنَة، كَلِّمْ اللَّهْ يُوحَنَّا وِلْدْ زَكَرِيَّا وهُوَّ فِي الخْلَاء. <verse eid="LUK 3:2" /><verse number="3" style="v" sid="LUK 3:3" />يَاخِي مْشَى لِلْبْقَايَعْ الكُلْ الدَّايْرَة بْوَادْ الأُرْدُنْ، يْنَادِي لِلنَّاسْ بَاشْ يْتُوبُوا ويِتْعَمْدُوا بَاشْ تِتْغْفِرْ ذْنُوبْهُمْ، <verse eid="LUK 3:3" /><verse number="4" style="v" sid="LUK 3:4" />كِيمَا مَكْتُوبْ فِي كْتَابْ النَّبِيْ إِشَعْيَاءْ:</para>
  <para style="b" vid="LUK 3:4" />
  <para style="q1" vid="LUK 3:4">«صُوتْ يْعَيِّطْ فِي الخْلَاء:</para>
  <para style="q2" vid="LUK 3:4">حَضّْرُوا طْرِيقْ الرَّبْ،</para>
  <para style="q1" vid="LUK 3:4">إِسْتْوِيوْ الثْنِيَّة قُدَّامُو!<verse eid="LUK 3:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="LUK 3:5" />كُلْ وَادْ يِتِرْدِمْ،</para>
  <para style="q1" vid="LUK 3:5">وكُلْ جْبَلْ وهَضْبَة يُوطَاوْ،</para>
  <para style="q2" vid="LUK 3:5">والثْنَايَا المْعَوْجَة تِتْسْتْوَى،</para>
  <para style="q1" vid="LUK 3:5">والوَاعْرَة تِسْهَالْ،<verse eid="LUK 3:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="LUK 3:6" />والنَّاسْ الكُلْ بِشْ يْشُوفُوا نْجَاةْ اللَّهْ».<verse eid="LUK 3:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7" />وكَانْ يُوحَنَّا يْقُولْ لِلنَّاسْ الِّي جَاوْ بَاشْ يِتْعَمْدُوا عْلَى يْدِيهْ: «يَا وْلَادْ الأَفَاعِي! شْكُونْ الِّي وَرَّاكُمْ كِيفَاشْ تُهْرْبُوا مِنْ غَضَبْ اللَّهْ الِّي بِشْ يْجِي؟ <verse eid="LUK 3:7" /><verse number="8" style="v" sid="LUK 3:8" />أَعْمْلُوا أَعْمَالْ تْوَرِّي الِّي إِنْتُومَا تُبْتُوا بِالحَقْ، ومَا تْقُولُوشْ فِي قْلُوبْكُمْ: "أَحْنَا وْلَادْ إِبْرَاهِيمْ". عْلَى خَاطِرْ آنَا نْقُلْكُمْ إِنُّو اللَّهْ قَادِرْ يَعْمِلْ مِالحْجَرْ هَاذَا وْلَادْ لْإِبْرَاهِيمْ. <verse eid="LUK 3:8" /><verse number="9" style="v" sid="LUK 3:9" />والفَاسْ تَوَّا مَحْطُوطْ عْلَى عْرُوقْ الشْجَرْ، وكُلْ شَجْرَة مَا تْجِيبِشْ غَلَّة بَاهْيَة تِتْقَصْ وتِتْرْمَى فِي النَّارْ».<verse eid="LUK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10" />يَاخِي سِأْلُوهْ النَّاسْ: «مَالَا شْنُوَّة لَازِمْنَا نَعْمْلُوا؟» <verse eid="LUK 3:10" /><verse number="11" style="v" sid="LUK 3:11" />وهُوَّ جَاوِبْهُمْ: «الِّي عَنْدُو لِبْسْتِينْ يَعْطِي لِلِّي مَا عَنْدُوشْ، ولِّي عَنْدُو مَاكْلَة يَعْمِلْ نَفْسْ الشَّيْ». <verse eid="LUK 3:11" /><verse number="12" style="v" sid="LUK 3:12" />وجَاوِهْ زَادَا جْمَاعَة مَكَّاسَة بَاشْ يِتْعَمْدُوا وسِأْلُوهْ: «يَا مُعَلِّمْ، وأَحْنَا آشْ نَعْمْلُوا؟». <verse eid="LUK 3:12" /><verse number="13" style="v" sid="LUK 3:13" />يَاخِي قَالِلْهُمْ: «مَا تَاخْذُوشْ أَكْثِرْ مِلِّي لَازِمْ تَاخْذُوهْ». <verse eid="LUK 3:13" /><verse number="14" style="v" sid="LUK 3:14" />وسِأْلُوهْ جْمَاعَة مِالعَسْكِرْ: «وأَحْنَا، آشْ نَعْمْلُوا؟». جَاوِبْهُمْ: «مَا تَاخْذُوا فْلُوسْ حَتَّى حَدْ بِالقُوَّة، ومَا تِتْبَلَّاوْ عْلَى حَتَّى حَدْ، واسْتَكْفَاوْ بِشْهَارِيكُمْ».<verse eid="LUK 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15" />والنَّاسْ كَانُوا يِسْتَنَّاوْ فِي المَسِيحْ، والكُلْ كَانُوا يِسْأْلُوا فِي رْوَاحْهُمْ عْلَى يُوحَنَّا: «زَعْمَة هُوَّ المَسِيحْ؟». <verse eid="LUK 3:15" /><verse number="16" style="v" sid="LUK 3:16" />يَاخِي جَاوِبْ يُوحَنَّا وقَالْ لِلنَّاسْ الكُلْ: «آنَا نْعَمِّدْكُمْ بِالمَاء، آمَا بِشْ يْجِي الِّي هُوَّ أَعْظَمْ مِنِّي، وآنَا مَا نِسْتَاهِلْشْ نْكُونْ الخْدِيمْ الِّي يْحِلُّو رْبَايِطْ صَنْدَالُو، هُوَّ بِشْ يْعَمِّدْكُمْ بِالرُّوحْ القُدُسْ والنَّارْ. <verse eid="LUK 3:16" /><verse number="17" style="v" sid="LUK 3:17" />ويْهِزْ المَذْرَى فِي يِدُّو ويِفْرِزْ صَابْتُو، يْلِمْ القَمْحْ فِي المَخْزِنْ مْتَاعُو، آمَا التْبِنْ يَحْرْقُو بْنَارْ مَا تِطْفَاشْ».<verse eid="LUK 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 3:18" />وكَانْ يُوحَنَّا يَنْصَحْ فِي النَّاسْ إِبَّرْشَة حَاجَاتْ أُخْرِينْ ويْبَشِّرْ فِيهُمْ. <verse eid="LUK 3:18" /><verse number="19" style="v" sid="LUK 3:19" />آمَا لَامْ الوَالِي هِيرُودُسْ عْلَى خَاطْرُو عَرِّسْ بْهِيرُودِيَّا مَرْتْ خُوهْ، وعَالحَاجَاتْ الخَايْبَة الِّي عْمَلْهَا الكُلْ. <verse eid="LUK 3:19" /><verse number="20" style="v" sid="LUK 3:20" />وفُوقْ الشَّرْ الِّي عْمَلُو الكُلْ، زَادْ هِيرُودُسْ حَطْ يُوحَنَّا فِي الحَبْسْ.<verse eid="LUK 3:20" /></para>
  <para style="s">مَعْمُودِيِّةْ يَسُوعْ</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21" />وبَعْدْمَا تْعَمْدُوا النَّاسْ الكُلْ، تْعَمِّدْ يَسُوعْ زَادَا. ووَقْتِلِّي كَانْ يَسُوعْ يْصَلِّي، تْحَلِّتْ السْمَاء، <verse eid="LUK 3:21" /><verse number="22" style="v" sid="LUK 3:22" />وهْبَطْ عْلِيهْ الرُّوحْ القُدُسْ فِي شَكْلْ حْمَامَة، وجَاء صُوتْ مِالسْمَاء يْقُولْ: «إِنْتِ إِبْنِي الِّي نْحِبُّو، وآنَا فَرْحَانْ بِيكْ».<verse eid="LUK 3:22" /></para>
  <para style="s">نْسَبْ يَسُوعْ المَسِيحْ</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23" />وكِي بْدَا يَسُوعْ خِدْمْتُو كَانْ عُمْرُو قْرِيبْ 30 سْنَة، وكَانْ مَعْرُوفْ الِّي هُوَّ:</para>
  <para style="li" vid="LUK 3:23">وِلْدْ يُوسِفْ، وِلْدْ هَالِي،<verse eid="LUK 3:23" /></para>
  <para style="li">
    <verse number="24" style="v" sid="LUK 3:24" />وِلْدْ مَتْثَاتْ، وِلْدْ لَاوِي،</para>
  <para style="li" vid="LUK 3:24">وِلْدْ مَلْكِي، وِلْدْ يَنَّا،</para>
  <para style="li" vid="LUK 3:24">وِلْدْ يُوسِفْ، <verse eid="LUK 3:24" /><verse number="25" style="v" sid="LUK 3:25" />وِلْدْ مَتَّاثِيَا،</para>
  <para style="li" vid="LUK 3:25">وِلْدْ عَامُوصْ، وِلْدْ نَاحُومْ،</para>
  <para style="li" vid="LUK 3:25">وِلْدْ حَسْلِي، وِلْدْ نَجَّايْ،<verse eid="LUK 3:25" /></para>
  <para style="li">
    <verse number="26" style="v" sid="LUK 3:26" />وِلْدْ مَآثْ، وِلْدْ مَتَّاثِيَا،</para>
  <para style="li" vid="LUK 3:26">وِلْدْ شِمْعِي، وِلْدْ يُوسِفْ،</para>
  <para style="li" vid="LUK 3:26">وِلْدْ يَهُوذَا، <verse eid="LUK 3:26" /><verse number="27" style="v" sid="LUK 3:27" />وِلْدْ يُوحَنَّا،</para>
  <para style="li" vid="LUK 3:27">وِلْدْ رِيسَا، وِلْدْ زَرُبَّابِلْ،</para>
  <para style="li" vid="LUK 3:27">وِلْدْ شَأَلْتِئِيلْ، وِلْدْ نِيرِي،<verse eid="LUK 3:27" /></para>
  <para style="li">
    <verse number="28" style="v" sid="LUK 3:28" />وِلْدْ مَلْكِي، وِلْدْ أَدِّي،</para>
  <para style="li" vid="LUK 3:28">وِلْدْ قُصَمْ، وِلْدْ أَلْمُودَامْ،</para>
  <para style="li" vid="LUK 3:28">وِلْدْ عِيرْ، <verse eid="LUK 3:28" /><verse number="29" style="v" sid="LUK 3:29" />وِلْدْ يُوسِي،</para>
  <para style="li" vid="LUK 3:29">وِلْدْ أَلِيعَازَرْ، وِلْدْ يُورِيمْ،</para>
  <para style="li" vid="LUK 3:29">وِلْدْ مَتْثَاتْ، وِلْدْ لَاوِي،<verse eid="LUK 3:29" /></para>
  <para style="li">
    <verse number="30" style="v" sid="LUK 3:30" />وِلْدْ شَمْعُونْ، وِلْدْ يَهُوذَا،</para>
  <para style="li" vid="LUK 3:30">وِلْدْ يُوسِفْ، وِلْدْ يُونَانْ،</para>
  <para style="li" vid="LUK 3:30">وِلْدْ أَلِيَاقِيمْ، <verse eid="LUK 3:30" /><verse number="31" style="v" sid="LUK 3:31" />وِلْدْ مَلَيَا،</para>
  <para style="li" vid="LUK 3:31">وِلْدْ مَيْنَانْ، وِلْدْ مَتَّاثَا،</para>
  <para style="li" vid="LUK 3:31">وِلْدْ نَاثَانْ، وِلْدْ دَاوِدْ،<verse eid="LUK 3:31" /></para>
  <para style="li">
    <verse number="32" style="v" sid="LUK 3:32" />وِلْدْ يَسَّى، وِلْدْ عُوبِيدْ،</para>
  <para style="li" vid="LUK 3:32">وِلْدْ بُوعَزْ، وِلْدْ سَلْمُونْ،</para>
  <para style="li" vid="LUK 3:32">وِلْدْ نَحْشُونْ، <verse eid="LUK 3:32" /><verse number="33" style="v" sid="LUK 3:33" />وِلْدْ عَمِّينَادَابْ،</para>
  <para style="li" vid="LUK 3:33">وِلْدْ أَرَامْ، وِلْدْ حَصْرُونْ،</para>
  <para style="li" vid="LUK 3:33">وِلْدْ فَارِصْ، وِلْدْ يَهُوذَا،<verse eid="LUK 3:33" /></para>
  <para style="li">
    <verse number="34" style="v" sid="LUK 3:34" />وِلْدْ يَعْقُوبْ، وِلْدْ إِسْحَاقْ،</para>
  <para style="li" vid="LUK 3:34">وِلْدْ إِبْرَاهِيمْ، وِلْدْ تَارَحْ،</para>
  <para style="li" vid="LUK 3:34">وِلْدْ نَاحُورْ، <verse eid="LUK 3:34" /><verse number="35" style="v" sid="LUK 3:35" />وِلْدْ سَرُوجْ،</para>
  <para style="li" vid="LUK 3:35">وِلْدْ رَعُو، وِلْدْ فَالَجْ،</para>
  <para style="li" vid="LUK 3:35">وِلْدْ عَابِرْ، وِلْدْ شَالَحْ،<verse eid="LUK 3:35" /></para>
  <para style="li">
    <verse number="36" style="v" sid="LUK 3:36" />وِلْدْ قِينَانْ، وِلْدْ أَرْفَكْشَادْ،</para>
  <para style="li" vid="LUK 3:36">وِلْدْ سَامْ، وِلْدْ نُوحْ،</para>
  <para style="li" vid="LUK 3:36">وِلْدْ لَامَكْ، <verse eid="LUK 3:36" /><verse number="37" style="v" sid="LUK 3:37" />وِلْدْ مَتُوشَالَحْ،</para>
  <para style="li" vid="LUK 3:37">وِلْدْ أَخْنُوخْ، وِلْدْ يَارِدْ،</para>
  <para style="li" vid="LUK 3:37">وِلْدْ مَهْلَلْئِيلْ، وِلْدْ قِينَانْ،<verse eid="LUK 3:37" /></para>
  <para style="li">
    <verse number="38" style="v" sid="LUK 3:38" />وِلْدْ أَنُوشْ، وِلْدْ شِيثْ،</para>
  <para style="li" vid="LUK 3:38">وِلْدْ آدَمْ، مِنْ عَنْدْ اللَّهْ.<verse eid="LUK 3:38" /></para>
  <chapter eid="LUK 3" />
  <chapter number="4" style="c" sid="LUK 4" />
  <para style="s">إِبْلِيسْ يْجَرِّبْ يَسُوعْ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1" />ورْجَعْ يَسُوعْ مِنْ وَادْ الأُرْدُنْ وهُوَّ مِلْيَانْ بِالرُّوحْ القُدُسْ، يَاخِي هَزُّو الرُّوحْ لِلْخْلَاء <verse eid="LUK 4:1" /><verse number="2" style="v" sid="LUK 4:2" />لْمُدِّةْ 40 يُومْ، وإِبْلِيسْ كَانْ يْجَرِّبْ فِيهْ. وطُولْ المُدَّة هَاذِيكَا يَسُوعْ مَا كْلَا حَتَّى شَيْ، وكِي كِمْلُوا 40 يُومْ جَاعْ. <verse eid="LUK 4:2" /><verse number="3" style="v" sid="LUK 4:3" />يَاخِي قَالُّو إِبْلِيسْ: «كَانِكْ إِنْتِ إِبْنْ اللَّهْ، قُولْ لِلْحَجْرَة هَاذِي تْوَلِّي خُبْزْ». <verse eid="LUK 4:3" /><verse number="4" style="v" sid="LUK 4:4" />جَاوْبُو يَسُوعْ: «مَكْتُوبْ: "الإِنْسَانْ مَا يْعِيشِشْ كَانْ بِالخُبْزْ، آمَا يْعِيشْ بْكُلْ كِلْمَة تُخْرُجْ مِنْ فُمْ اللَّهْ"».<verse eid="LUK 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5" />ومْبَعِّدْ طَلّْعُو إِبْلِيسْ فُوقْ جْبَلْ عَالِي، ووَرَّاهْ مَمَالِكْ الدِّنْيَا الكُلْ فِي لَحْظَة مِالزْمَانْ، <verse eid="LUK 4:5" /><verse number="6" style="v" sid="LUK 4:6" />وقَالُّو: «نَعْطِيكْ السُّلْطَة عَالمَمَالِكْ هَاذِي الكُلْ، وكُلْ مَا فِيهَا مِنْ مَجْدْ، عْلَى خَاطِرْ هِيَّ تِعْطَاتْلِي، وآنَا نَعْطِيهَا لِلِّي نْحِبْ. <verse eid="LUK 4:6" /><verse number="7" style="v" sid="LUK 4:7" />مَالَا، كَانْ إِنْتِ تُسْجُدْلِي، تْوَلِّي الكُلْهَا مْتَاعِكْ!». <verse eid="LUK 4:7" /><verse number="8" style="v" sid="LUK 4:8" />وجَاوْبُو يَسُوعْ: «مَكْتُوبْ:</para>
  <para style="b" vid="LUK 4:8" />
  <para style="q1" vid="LUK 4:8">"إِسْجِدْ لِلرَّبْ إِلَاهِكْ،</para>
  <para style="q2" vid="LUK 4:8">واعْبْدُو هُوَّ وَحْدُو"».<verse eid="LUK 4:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9" />وهَزُّو إِبْلِيسْ لْأُورْشَلِيمْ، ووَقْفُو عْلَى حَرْفْ أَعْلَى بْلَاصَة فِي الهَيْكِلْ، وقَالُّو: «كَانِكْ إِنْتِ إِبْنْ اللَّهْ أَرْمِي رُوحِكْ مِنْ هُونِي. <verse eid="LUK 4:9" /><verse number="10" style="v" sid="LUK 4:10" />عْلَى خَاطِرْ مَكْتُوبْ:</para>
  <para style="b" vid="LUK 4:10" />
  <para style="q1" vid="LUK 4:10">"اللَّهْ يْوَصِّي مْلَايِكْتُو بَاشْ يَحْفْظُوكْ"،<verse eid="LUK 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LUK 4:11" />"وهُومَا يْهِزُّوكْ عْلَى يْدِيهُمْ،</para>
  <para style="q2" vid="LUK 4:11">بَاشْ سَاقِيكْ مَا تِتْضْرَبْشْ فِي حَجْرَة"».<verse eid="LUK 4:11" /></para>
  <para style="b" />
  <para style="m">
    <verse number="12" style="v" sid="LUK 4:12" />وجَاوْبُو يَسُوعْ: «آمَا مَكْتُوبْ: "مَا تْجَرَّبْشْ الرَّبْ إِلَاهِكْ"».<verse eid="LUK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13" />وبَعْدْمَا كَمِّلْ إِبْلِيسْ جَرْبُو بِالتَّجَارِبْ الكُلْ، خَلَّاهْ ومْشَى حَتَّى لِينْ تْجِي فُرْصَة أُخْرَى.<verse eid="LUK 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14" />ورْجَعْ يَسُوعْ مِلْيَانْ بْقُوِّةْ الرُّوحْ لْمَنْطَقْةْ الجَلِيلْ، وتِشْهَرْ فِي البْلَايِصْ الِّي دَايْرَة بِيهَا الكُلْ. <verse eid="LUK 4:14" /><verse number="15" style="v" sid="LUK 4:15" />وكَانْ يْعَلِّمْ فِي مْعَابِدْ اليْهُودْ، وكَانُوا الكُلْ يْمَجْدُوا فِيهْ.<verse eid="LUK 4:15" /></para>
  <para style="s">النَّاصْرَة مَا تِقْبِلْشْ يَسُوعْ</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16" />وجَاء لِمْدِينِةْ النَّاصْرَة الِّي تْرَبَّى فِيهَا، ونْهَارْ السِّبْتْ دْخَلْ كِي العَادَة لْمَعْبِدْ اليْهُودْ، ووْقِفْ بَاشْ يَقْرَى. <verse eid="LUK 4:16" /><verse number="17" style="v" sid="LUK 4:17" />يَاخِي عْطَاوِهْ كْتَابْ النَّبِيْ إِشَعْيَاءْ، وحَلُّو ولْقَى الآيَة الِّي مَكْتُوبْ فِيهَا:<verse eid="LUK 4:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18" />«رُوحْ الرَّبْ عْلِيَّا،</para>
  <para style="q2" vid="LUK 4:18">عْلَى خَاطْرُو إِخْتَارْنِي بَاشْ نْبَشِّرْ المْسَاكِنْ،</para>
  <para style="q1" vid="LUK 4:18">وبْعَثْنِي بَاشْ انَّادِي لِلْمَرْبُوطِينْ بِالحُرِّيَة،</para>
  <para style="q2" vid="LUK 4:18">والعِمْيَانْ يْوَلِّيوْ يْشُوفُوا،</para>
  <para style="q1" vid="LUK 4:18">ونْحَرِّرْ المَظْلُومِينْ،<verse eid="LUK 4:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="LUK 4:19" />ونْخَبِّرْ عَالوَقْتْ الِّي فِيهْ يْظَهِّرْ الرَّبْ نِعْمْتُو لِلنَّاسْ الكُلْ».<verse eid="LUK 4:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20" />وسَكِّرْ يَسُوعْ الكْتَابْ وعْطَاهْ لْخَادِمْ المَعْبِدْ وقْعَدْ. والنَّاسْ الِّي فِي المَعْبِدْ الكُلْ بْقَاوْ يُخْزْرُولُو. <verse eid="LUK 4:20" /><verse number="21" style="v" sid="LUK 4:21" />وبْدَا يْقُولِلْهُمْ: «اليُومْ تَحَقَّقْ الكْلَامْ الِّي سْمَعْتُوهْ». <verse eid="LUK 4:21" /><verse number="22" style="v" sid="LUK 4:22" />والحَاضْرِينْ الكُلْ كَانُوا يِمْدْحُوا فِيهْ وهُومَا مِتْعَجْبِينْ مِنْ كْلَامْ النِّعْمَة الِّي خَارِجْ مِنْ فُمُّو، وكَانُوا يْقُولُوا: « يَاخِي مُشْ هَاذَا وِلْدْ يُوسِفْ؟». <verse eid="LUK 4:22" /><verse number="23" style="v" sid="LUK 4:23" />يَاخِي قَالِلْهُمْ يَسُوعْ: «أَكِيدْ رَاكُمْ بِشْ تْقُولُولِي المَثَلْ هَاذَا: "يَا طْبِيبْ إِشْفِي رُوحِكْ! ولِّي سْمَعْنَا بِيكْ عْمَلْتُو فِي كَفْرْنَاحُومْ، أَعْمْلُو هْنَا زَادَا فِي مْدِينْتِكْ"».<verse eid="LUK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 4:24" />وزَادْ قَالْ: «نْقُلْكُمْ الحَقْ: مَا فَمَّة حَتَّى نَبِيْ مَقْبُولْ فِي بْلَادُو. <verse eid="LUK 4:24" /><verse number="25" style="v" sid="LUK 4:25" />وبِالحَقْ نْقُلْكُمْ: كَانُوا فَمَّة بَرْشَة نْسَاء هَجَّالَة فِي إِسْرَائِيلْ فِي وَقْتْ النَّبِيْ إِيلِيَّا، وَقْتِلِّي المْطَرْ قَعْدِتْ ثْلَاثَة سْنِينْ وسِتَّة شْهُرْ مَا صَبِّتْشْ حَتَّى لِينْ وَلَّاتْ فَمَّة مَجَاعَة كْبِيرَة فِي البْلَادْ الكُلْ، <verse eid="LUK 4:25" /><verse number="26" style="v" sid="LUK 4:26" />وإِيلِيَّا مَا تِبْعَثْشْ لْحَتَّى وَحْدَة فِيهُمْ، آمَا تِبْعَثّْ لْهَجَّالَة فِي مَدِينِةْ صِرْفَة فِي مَنْطَقْةْ صَيْدَا. <verse eid="LUK 4:26" /><verse number="27" style="v" sid="LUK 4:27" />وكَانْ فَمَّة بَرْشَة مُرْضَى بِالبْرَصْ فِي إِسْرَائِيلْ فِي وَقْتْ النَّبِيْ أَلِيشَعْ، ومَا طْهُرْ حَتَّى وَاحِدْ مِنْهُمْ كَانْ نُعْمَانْ السُّورِي».<verse eid="LUK 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28" />والحَاضْرِينْ فِي المَعْبِدْ الكُلْ تْغَشْشُوا بَرْشَة كِي سَمْعُوا الكْلَامْ هَاذَا، <verse eid="LUK 4:28" /><verse number="29" style="v" sid="LUK 4:29" />يَاخِي قَامُوا وخَرْجُوهْ لْبَرَّة مِالمْدِينَة، وهَزُّوهْ لْحَافِّةْ الجْبَلْ الِّي تِبْنَاتْ عْلِيهْ مْدِينِتْهُمْ بَاشْ يِرْمِيوَهْ مِنُّو. <verse eid="LUK 4:29" /><verse number="30" style="v" sid="LUK 4:30" />آمَا يَسُوعْ تْعَدَّى فِي وِسْطْهُمْ ومْشَى.<verse eid="LUK 4:30" /></para>
  <para style="s">يَسُوعْ يْخَرِّجْ رُوحْ شِرِّيرْ مِنْ رَاجِلْ</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31" />وهْبَطْ لْكَفْرْنَاحُومْ الِّي هِيَّ مْدِينَة فِي مَنْطَقْةْ الجَلِيلْ، وكَانْ يْعَلِّمْ فِي النَّاسْ كُلْ نْهَارْ سِبْتْ. <verse eid="LUK 4:31" /><verse number="32" style="v" sid="LUK 4:32" />وقَعْدُوا بَاهْتِينْ مِنْ تَعْلِيمُو، عْلَى خَاطِرْ كْلَامُو كَانْ فِيهْ سُلْطَة. <verse eid="LUK 4:32" /><verse number="33" style="v" sid="LUK 4:33" />وفِي المَعْبِدْ كَانْ فَمَّة رَاجِلْ سَاكْنُو رُوحْ شِرِّيرْ، بْدَا يْصِيحْ بْصُوتْ عَالِي: <verse eid="LUK 4:33" /><verse number="34" style="v" sid="LUK 4:34" />«آهْ، آشْ تْحِبْ مِنَّا يَا يَسُوعْ النَّاصْرِي؟ جِيتْ بَاشْ تَقْضِي عْلِينَا؟ آنَا نَعْرِفْ إِنْتِ شْكُونْ: إِنْتِ القُدُّوسْ الِّي بَعْثُو اللَّهْ!». <verse eid="LUK 4:34" /><verse number="35" style="v" sid="LUK 4:35" />يَاخِي يَسُوعْ نْزَرْ عْلِيهْ وقَالُّو: «أُسْكُتْ وأُخْرِجْ مِنُّو». يَاخِي الشِّيطَانْ صْرَعْ الرَّاجِلْ فِي وِسْطْ النَّاسْ وخْرَجْ مِنُّو مِنْ غِيرْ مَا ضَرُّو. <verse eid="LUK 4:35" /><verse number="36" style="v" sid="LUK 4:36" />وإِسْتَغْرْبُوا النَّاسْ الكُلْ وقَالُوا لِبْعَضْهُمْ: «شْنُوَّة الكْلَامْ هَاذَا؟ رَاهُو يُؤْمُرْ فِي الأَرْوَاحْ الشِّرِّيرَة بْسُلْطَة وبْقُوَّة وهُومَا يُخْرْجُوا!». <verse eid="LUK 4:36" /><verse number="37" style="v" sid="LUK 4:37" />وتِشْهَرْ يَسُوعْ فِي البْلَايِصْ مْتَاعْ المَنْطْقَة هَاذِيكَا الكُلْ.<verse eid="LUK 4:37" /></para>
  <para style="s">يَسُوعْ يِشْفِي حْمَاةْ سِمْعَانْ</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38" />ومْبَعِّدْ، خْرَجْ مِالمَعْبِدْ ودْخَلْ لْدَارْ سِمْعَانْ. وحْمَاةْ سِمْعَانْ كَانْ عَنْدْهَا بَرْشَة سْخَانَة، يَاخِي طَلْبُوا مِنُّو بَاشْ يِشْفِيهَا. <verse eid="LUK 4:38" /><verse number="39" style="v" sid="LUK 4:39" />قْرُبِّلْهَا يَسُوعْ وعْطَى أَمْرْ لِلسْخَانَة، والسْخَانَة تْنَحَّاتِلْهَا، وبِالوَقْتْ قَامِتْ وبْدَاتْ تِخْدِمْ فِيهُمْ.<verse eid="LUK 4:39" /></para>
  <para style="s">يَسُوعْ يِشْفِي بَرْشَة نَاسْ</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40" />ووَقْتِلِّي غُرْبِتْ الشَّمْسْ، كُلْ وَاحِدْ عَنْدُو مْرِيضْ مَهْمَا كَانْ نُوعْ مَرْضُو جَابُو لْيَسُوعْ، وهُوَّ حَطْ يْدِيهْ عْلَى كُلْ وَاحِدْ مِنْهُمْ وشْفَاهُمْ. <verse eid="LUK 4:40" /><verse number="41" style="v" sid="LUK 4:41" />وخَرْجُوا الشْوَاطِنْ مِنْ بَرْشَة مِنْهُمْ وهُومَا يْصِيحُوا: «إِنْتِ إِبْنْ اللَّهْ!». آمَا يَسُوعْ نْزَرْ عْلِيهُمْ ومَا خَلَّاهُمْشْ يِتْكَلْمُوا، عْلَى خَاطِرْهُمْ عَرْفُوا الِّي هُوَّ المَسِيحْ.<verse eid="LUK 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42" />وكِي طْلَعْ النْهَارْ، خْرَجْ يَسُوعْ ومْشَى لِبْلَاصَة خْلَاء، ولَوْجُوا عْلِيهْ النَّاسْ حَتَّى لِينْ لْقَاوَهْ وشَدُّوا فِيهْ صْحِيحْ بَاشْ مَا يِمْشِيشْ مِنْ بَحْذَاهُمْ. <verse eid="LUK 4:42" /><verse number="43" style="v" sid="LUK 4:43" />آمَا هُوَّ قَالِلْهُمْ: «لَازِمْنِي نِمْشِي لِلْمُدُنْ الأُخْرِينْ زَادَا ونْبَشَّرْهُمْ بْمَمْلَكْةْ اللَّهْ، عْلَى خَاطِرْ اللَّهْ بْعَثْنِي بَاشْ نَعْمِلْ هَاذَا». <verse eid="LUK 4:43" /><verse number="44" style="v" sid="LUK 4:44" />ومْشَى يْبَشِّرْ فِي المْعَابِدْ الِّي فِي مَنْطَقْةْ اليَهُودِيَّة.<verse eid="LUK 4:44" /></para>
  <chapter eid="LUK 4" />
  <chapter number="5" style="c" sid="LUK 5" />
  <para style="s">يَسُوعْ يِخْتَارْ تْلَامِذْتُو الأُولَانِينْ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1" />وفِي نْهَارْ مِالنْهَارَاتْ، كَانْ يَسُوعْ وَاقِفْ عْلَى شَطْ بُحَيْرِةْ جَنِّيسَارْتْ، والنَّاسْ كَانُوا مَلْمُومِينْ بِيهْ بَاشْ يِسْمْعُوا كِلْمِةْ اللَّهْ. <verse eid="LUK 5:1" /><verse number="2" style="v" sid="LUK 5:2" />وشَافْ زُوزْ فْلَايِكْ عَالشَّطْ، هَبْطُوا مِنْهُمْ الصَّيَّادَة بَاشْ يَغْسْلُوا شْبَاكْهُمْ. <verse eid="LUK 5:2" /><verse number="3" style="v" sid="LUK 5:3" />يَاخِي رْكِبْ فِي وَحْدَة مِنْهُمْ الِّي هِيَّ مْتَاعْ سِمْعَانْ، وقَالُّو يِبْعِدْ عَالشَّطْ شْوَيَّة، ومْبَعِّدْ قْعَدْ وبْدَا يْعَلِّمْ فِي النَّاسْ مِالفْلُوكَة.<verse eid="LUK 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4" />وكِي كَمِّلْ كْلَامُو قَالْ لْسِمْعَانْ: «أُدْخُلْ لِلْغْرِيقْ، وإِرْمِيوْ شْبَاكُّمْ واصْطَادُوا». <verse eid="LUK 5:4" /><verse number="5" style="v" sid="LUK 5:5" />يَاخِي جَاوْبُو سِمْعَانْ: «يَا سِيدْنَا رَانَا تْعِبْنَا اللِّيلْ بْكُلُّو ومَا اصْطَدْنَا شَيْ، آمَا عْلَى كِلْمْتِكْ هَانِي بِشْ نَرْمِي الشْبَاكْ». <verse eid="LUK 5:5" /><verse number="6" style="v" sid="LUK 5:6" />وكِي عَمْلُوا بِكْلَامُو، اصْطَادُوا بَرْشَة حُوتْ لِينْ شْبَاكْهُمْ بْدَاتْ تِتْقَطَّعْ. <verse eid="LUK 5:6" /><verse number="7" style="v" sid="LUK 5:7" />وَلَّاوْ شَاوْرُوا بِيْدِيهُمْ لِصْحَابْهُمْ الِّي فِي الفْلُوكَة الأُخْرَى بَاشْ يْجِيوْ يْعَاوْنُوهُمْ، وجَاوْ وعَبَّاوْ الزُّوزْ فْلَايِكْ لِينْ قْرِيبْ يُغْرْقُوا. <verse eid="LUK 5:7" /><verse number="8" style="v" sid="LUK 5:8" />وكِي شَافْ سِمْعَانْ بُطْرُسْ الِّي صَارْ، تِرْمَى قُدَّامْ رْكَايِبْ يَسُوعْ وقَالْ: «يَا رَبْ، إِبْعِدْ عْلِيَّا، رَانِي إِنْسَانْ مُذْنِبْ». <verse eid="LUK 5:8" /><verse number="9" style="v" sid="LUK 5:9" />وكَانْ هُوَّ ولِّي مْعَاهْ مِتْعَجْبِينْ مِنْ كُثْرِةْ الحُوتْ الِّي اصْطَادُوهْ. <verse eid="LUK 5:9" /><verse number="10" style="v" sid="LUK 5:10" />وكَانْ نَفْسْ الشَّيْ بِالنِّسْبَة لْيَعْقُوبْ ويُوحَنَّا وْلَادْ زَبَدِي الِّي هُومَا شُرْكَا مْعَ سِمْعَانْ. وقَالْ يَسُوعْ لْسِمْعَانْ: «مَا تْخَافِشْ، مِنْ تَوَّا بِشْ تْوَلِّي صَيَّادْ نَاسْ». <verse eid="LUK 5:10" /><verse number="11" style="v" sid="LUK 5:11" />وكِي رَجْعُوا بِالزُّوزْ فْلَايِكْ لِلشَّطْ، خَلَّاوْ كُلْ شَيْ وتَبْعُوا يَسُوعْ.<verse eid="LUK 5:11" /></para>
  <para style="s">يَسُوعْ يِشْفِي مْرِيضْ بِالبْرَصْ</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12" />ووَقْتِلِّي كَانْ يَسُوعْ فِي مْدِينَة مِالمُدُنْ، جَاهْ رَاجِلْ بَدْنُو الكُلْ مِلْيَانْ بِالبْرَصْ، وأَوِّلْ مَا شَافْ يَسُوعْ سْجِدْلُو وتْشَحْتُو وقَالْ: «يَا سِيدِي، كَانْ إِنْتِ تْحِبْ، تْنَجِّمْ اطَّهِّرْنِي مِالبْرَصْ». <verse eid="LUK 5:12" /><verse number="13" style="v" sid="LUK 5:13" />يَاخِي مَدْ يَسُوعْ يِدُّو ومَسُّو وقَالُّو: «أَيْ نْحِبْ، أُطْهُرْ!». وبِالوَقْتْ تْنَحَّى عْلِيهْ البْرَصْ. <verse eid="LUK 5:13" /><verse number="14" style="v" sid="LUK 5:14" />ووَصَّاهْ يَسُوعْ بَاشْ مَا يْقُولْ لْحَدْ وقَالُّو: «إِمْشِي لِلْكَاهِنْ خَلِّيهْ يْشُوفِكْ، وأَعْطِي عْلَى تَطْهِيرِكْ الِّي وَصَّى بِيهْ مُوسَى، خَلِّيهْ يْكُونْ أَمَارَة لِيهُمْ إِنِّكْ تِشْفِيتْ مِالمْرَضْ».<verse eid="LUK 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15" />آمَا أَخْبَارْ يَسُوعْ زَادِتْ تْنَشْرِتْ أَكْثِرْ، وجَاوَهْ بَرْشَة نَاسْ بَاشْ يِسْمْعُوهْ ويِتْشْفَاوْ مِنْ أَمْرَاضْهُمْ. <verse eid="LUK 5:15" /><verse number="16" style="v" sid="LUK 5:16" />آمَا هُوَّ بَرْشَة مَرَّاتْ كَانْ يِمْشِي لِلْخْلَاء بَاشْ يْصَلِّي.<verse eid="LUK 5:16" /></para>
  <para style="s">يَسُوعْ يِشْفِي مَشْلُولْ</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17" />وفِي نْهَارْ مِالنْهَارَاتْ، كَانْ يَسُوعْ يْعَلِّمْ، وكَانُوا بِينْ الحَاضْرِينْ جْمَاعَة مِالفِرِّيسِيِّينْ ومِلِّي يْعَلْمُوا فِي الشَّرِيعَة، جَاوْ مِنْ كُلْ دَشْرَة فِي مَنْطَقْةْ الجَلِيلْ واليَهُودِيَّة ومِنْ أُورْشَلِيمْ، وكَانِتْ قُدْرِةْ اللَّهْ تِشْفِي المُرْضَى عْلَى يْدِيهْ. <verse eid="LUK 5:17" /><verse number="18" style="v" sid="LUK 5:18" />وإِذَا بِيهْ جَاوْ جْمَاعَة هَازِّينْ رَاجِلْ مَشْلُولْ عْلَى فَرْشْ، وحَاوْلُوا يُدْخْلُوا بِيهْ ويْحُطُّوهْ قُدَّامُو. <verse eid="LUK 5:18" /><verse number="19" style="v" sid="LUK 5:19" />وكِي مَا نَجْمُوشْ يُدْخْلُوا مِنْ كُثْرِةْ النَّاسْ، طَلْعُوا لِلسْطَحْ ونَقْبُوهْ وهَبْطُوا المَشْلُولْ بِالفَرْشْ مْتَاعُو وحَطُّوهْ فِي الوِسْطْ قُدَّامْ يَسُوعْ.<verse eid="LUK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 5:20" />وكِي شَافْ يَسُوعْ إِيمَانْهُمْ قَالْ لِلْمَشْلُولْ: «يَا رَاجِلْ، ذْنُوبِكْ تْغِفْرِتْ». <verse eid="LUK 5:20" /><verse number="21" style="v" sid="LUK 5:21" />يَاخِي بْدَاوْ عُلَمَاءْ الشَّرِيعَة والفِرِّيسِيِّينْ يْقُولُوا فِي قْلُوبْهُمْ: «شْكُونُو هَاذَا الِّي قَاعِدْ يْقُولْ فِي كْلَامْ كُفْرْ؟ شْكُونْ بِخْلَافْ اللَّهْ وَحْدُو يْنَجِّمْ يِغْفِرْ الذْنُوبْ؟». <verse eid="LUK 5:21" /><verse number="22" style="v" sid="LUK 5:22" />وعْرَفْ يَسُوعْ فَاشْ يْخَمُّوا يَاخِي قَالِلْهُمْ: «عْلَاشْ تْخَمُّوا هَكَّا فِي قْلُوبْكُمْ؟ <verse eid="LUK 5:22" /><verse number="23" style="v" sid="LUK 5:23" />آنَاهُو الأَسْهِلْ؟ إِنُّو يِتْقَالْ: "ذْنُوبِكْ تْغِفْرِتْ"، وَلَّا يِتْقَالْ: "قُومْ وإِمْشِي"؟ <verse eid="LUK 5:23" /><verse number="24" style="v" sid="LUK 5:24" />آمَا هَانِي بِشْ نْوَرِّيكُمْ الِّي إِبْنْ الإِنْسَانْ عَنْدُو السُّلْطَة فِي الأَرْضْ بَاشْ يِغْفِرْ الذْنُوبْ». يَاخِي قَالْ لِلْمَشْلُولْ: «نْقُلِّكْ: قُومْ! هِزْ فَرْشِكْ ورَوَّحْ لْدَارِكْ». <verse eid="LUK 5:24" /><verse number="25" style="v" sid="LUK 5:25" />وبِالوَقْتْ قَامْ قُدَّامْهُمْ وهَزْ فَرْشُو الِّي كَانْ رَاقِدْ عْلِيهْ، ورَوَّحْ لْدَارُو وهُوَّ يْمَجِّدْ فِي اللَّهْ. <verse eid="LUK 5:25" /><verse number="26" style="v" sid="LUK 5:26" />والنَّاسْ الكُلْ قَعْدُوا بَاهْتِينْ، ومَجْدُوا اللَّهْ وقَالُوا وهُومَا مَاكِنْهُمْ الخُوفْ: «اليُومْ رِينَا عْجَايِبْ!».<verse eid="LUK 5:26" /></para>
  <para style="s">يَسُوعْ يِخْتَارْ لَاوِي</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27" />وبَعْدْ هَاذَا خْرَجْ يَسُوعْ، وشَافْ مَكَّاسْ إِسْمُو لَاوِي قَاعِدْ فِينْ يْلِمُّوا فِي المَكْسْ، يَاخِي قَالُّو: «تَبَّعْنِي!». <verse eid="LUK 5:27" /><verse number="28" style="v" sid="LUK 5:28" />يَاخِي قَامْ وخَلَّى كُلْ شَيْ وتَبْعُو.<verse eid="LUK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29" />وعْمَلُّو لَاوِي ضْيَافَة كْبِيرَة فِي دَارُو، وكَانُوا فَمَّة بَرْشَة مَكَّاسَة ونَاسْ أُخْرِينْ قَاعْدِينْ يَاكْلُوا مْعَاهُمْ. <verse eid="LUK 5:29" /><verse number="30" style="v" sid="LUK 5:30" />وبْدَاوْ عُلَمَاءْ الشَّرِيعَة والفِرِّيسِيِّينْ يِتْشَكَّاوْ عْلَى تْلَامْذِةْ يَسُوعْ وقَالُولْهُمْ: «عْلَاشْ تَاكْلُوا وتُشْرْبُوا مْعَ المَكَّاسَة والمُذْنْبِينْ؟» <verse eid="LUK 5:30" /><verse number="31" style="v" sid="LUK 5:31" />يَاخِي جَاوِبْهُمْ يَسُوعْ: «المُرْضَى هُومَا الِّي يَحْتَاجُوا لِلطْبِيبْ مُشْ الصْحَاحْ. <verse eid="LUK 5:31" /><verse number="32" style="v" sid="LUK 5:32" />آنَا مَا جِيتِشْ لِلصَّالْحِينْ، آمَا جِيتْ نِدْعِي فِي الْمُذْنْبِينْ بَاشْ يْتُوبُوا».<verse eid="LUK 5:32" /></para>
  <para style="s">يَسُوعْ والصْيَامْ</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33" />يَاخِي قَالُولُو: «تْلَامْذِةْ يُوحَنَّا يْصُومُوا ويْصَلِّيوْ بَرْشَة، وتْلَامْذِةْ الفِرِّيسِيِّينْ يَعْمْلُوا نَفْسْ الشَّيْ، آمَا تْلَامِذْتِكْ يَاكْلُوا ويُشْرْبُوا». <verse eid="LUK 5:33" /><verse number="34" style="v" sid="LUK 5:34" />قَالِلْهُمْ يَسُوعْ: «يَاخِي تْنَجْمُوا تْلِزُّوا المِسْتَدْعِينْ لِلْعِرْسْ بَاشْ يْصُومُوا والعْرُوسْ مْعَاهُمْ؟ <verse eid="LUK 5:34" /><verse number="35" style="v" sid="LUK 5:35" />آمَا بِشْ يْجِي الوَقْتْ الِّي يِتْنَحَّى فِيهْ العْرُوسْ مِنْ بَحْذَاهُمْ، ووَقْتْهَا يْصُومُوا».<verse eid="LUK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36" />وقَالِلْهُمْ المَثَلْ هَاذَا: «حَتَّى حَدْ مَا يْرَقَّعْ لِبْسَة قْدِيمَة بْطَرْفْ قْمَاشْ جْدِيدْ، عْلَى خَاطِرْ القْمَاشْ الجْدِيدْ بِشْ يِتْقَطَّعْ والرُّقْعَة بِيدْهَا مُشْ بِشْ تْوَاتِي القْمَاشْ القْدِيمْ. <verse eid="LUK 5:36" /><verse number="37" style="v" sid="LUK 5:37" />ومَا فَمَّة حَتَّى وَاحِدْ يْحُطْ شْرَابْ جْدِيدْ فِي ڨِرْبَة قْدِيمَة، بَاشْ الشْرَابْ الجْدِيدْ مَا يِفْلَقْشْ الڨِرْبَة ويَخْسِرْ الشْرَابْ والڨِرْبَة. <verse eid="LUK 5:37" /><verse number="38" style="v" sid="LUK 5:38" />آمَا الشْرَابْ الجْدِيدْ يِتْحَطْ فِي ڨِرْبَة جْدِيدَة. <verse eid="LUK 5:38" /><verse number="39" style="v" sid="LUK 5:39" />ومَا فَمَّة حَدْ يُشْرُبْ الشْرَابْ المْعَتَّقْ ويْلَوِّجْ عَالجْدِيدْ، عْلَى خَاطِرُو يْقُولْ: "المْعَتَّقْ أَحْسِنْ"».<verse eid="LUK 5:39" /></para>
  <chapter eid="LUK 5" />
  <chapter number="6" style="c" sid="LUK 6" />
  <para style="s">إِبْنْ الإِنْسَانْ هُوَّ رَبْ السِّبْتْ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1" />وفِي نْهَارْ سِبْتْ، تْعَدَّى يَسُوعْ وِسْطْ هْنَاشِرْ، وبْدَاوْ تْلَامِذْتُو يْنَحِّيوْ فِي السْبُولْ ويُفْرْكُوهُمْ بِينْ يْدِيهُمْ ويَاكْلُوا. <verse eid="LUK 6:1" /><verse number="2" style="v" sid="LUK 6:2" />يَاخِي جْمَاعَة مِالفِرِّيسِيِّينْ قَالُولْهُمْ: «عْلَاشْ تَعْمْلُوا حَاجَاتْ مَا يِلْزِمْشْ تِتْعْمَلْ نْهَارْ السِّبْتْ؟». <verse eid="LUK 6:2" /><verse number="3" style="v" sid="LUK 6:3" />جَاوِبْهُمْ يَسُوعْ: «يَاخِي مَا قْرِيتُوشْ شْنِيَّة عْمَلْ دَاوِدْ هُوَّ ولِّي مْعَاهْ وَقْتِلِّي جَاعُوا، <verse eid="LUK 6:3" /><verse number="4" style="v" sid="LUK 6:4" />كِيفَاشْ دْخَلْ لْخِيمِةْ الإِجْتِمَاعْ، وخْذَا مِالخُبْزْ الِّي يِتْقَدِّمْ قُرْبَانْ لِلَّهْ وكْلَا مِنُّو، رَغْمِلِّي مَا كَانْ مَسْمُوحْ كَانْ لِلْكَهَنَة بَاشْ يَاكْلُوا مِنُّو، وزَادْ عْطَى مِنُّو لِلِّي مْعَاهْ؟» <verse eid="LUK 6:4" /><verse number="5" style="v" sid="LUK 6:5" />ومْبَعِّدْ قَالِلْهُمْ: «إِبْنْ الإِنْسَانْ هُوَّ رَبْ السِّبْتْ».<verse eid="LUK 6:5" /></para>
  <para style="s">يَسُوعْ يِشْفِي فِي السِّبْتْ</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6" />وفِي سِبْتْ آخِرْ دْخَلْ يَسُوعْ لْمَعْبِدْ اليْهُودْ وبْدَا يْعَلِّمْ، وكَانْ فَمَّة رَاجِلْ غَادِي يِدُّو اليْمِينْ مَشْلُولَة. <verse eid="LUK 6:6" /><verse number="7" style="v" sid="LUK 6:7" />وكَانُوا عُلَمَاءْ الشَّرِيعَة والفِرِّيسِيِّينْ يْرَاقْبُوا فِي يَسُوعْ بَاشْ يْشُوفُوهْ كَانْ يِشْفِي نْهَارْ السِّبْتْ. وهَكَّاكَا يْنَجْمُوا يِتْهْمُوهْ. <verse eid="LUK 6:7" /><verse number="8" style="v" sid="LUK 6:8" />وعْرَفْ يَسُوعْ فَاشْ يْخَمُّوا، يَاخِي قَالْ لِلرَّاجِلْ الِّي يِدُّو مَشْلُولَة: «قُومْ وآقِفْ فِي الوِسْطْ» والرَّاجِلْ قَامْ ووْقِفْ. <verse eid="LUK 6:8" /><verse number="9" style="v" sid="LUK 6:9" />وقَالِلْهُمْ يَسُوعْ: «نِسْإِلْكُمْ سُؤَالْ: زَعْمَة حْلَالْ فِي نْهَارْ السِّبْتْ، نَعْمْلُوا الخِيرْ وَلَّا الشَّرْ؟ نْمَنْعُوا إِنْسَانْ وَلَّا نْخَلِّيوِهْ يْمُوتْ؟». <verse eid="LUK 6:9" /><verse number="10" style="v" sid="LUK 6:10" />وبَعْدْمَا خْزَرِّلْهُمْ الكُلْ، قَالْ لِلرَّاجِلْ: «مِدْ يِدِّكْ». وكِي مَدْهَا رَجْعِتْ يِدُّو صْحِيحَة. <verse eid="LUK 6:10" /><verse number="11" style="v" sid="LUK 6:11" />يَاخِي تْغَشْشُوا بَرْشَة، وبْدَاوْ يِتْشَاوْرُوا شْنِيَّة يَعْمْلُوا فِي يَسُوعْ.<verse eid="LUK 6:11" /></para>
  <para style="s">يَسُوعْ يِخْتَارْ الرُّسُلْ الأَثْنَاشْ</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12" />وفِي الأَيَّامَاتْ هَاذِيكَا، طْلَعْ لِلجْبَلْ بَاشْ يْصَلِّي، وعَدَّا اللِّيلْ الكُلْ وهُوَّ يْصَلِّي لِلَّهْ. <verse eid="LUK 6:12" /><verse number="13" style="v" sid="LUK 6:13" />وكِي طْلَعْ الصْبَاحْ، عَيِّطْ لِتْلَامِذْتُو واخْتَارْ مِنْهُمْ أَثْنَاشِنْ وَاحِدْ وسَمَّاهُمْ رُسُلْ. <verse eid="LUK 6:13" /><verse number="14" style="v" sid="LUK 6:14" />وهُومَا: سِمْعَانْ الِّي سَمَّاهْ زَادَا بُطْرُسْ، وأَنْدَرَاوُسْ خُوهْ، ويَعْقُوبْ، ويُوحَنَّا، وفِيلِۑُّسْ، وبَرْثُلْمَاوُسْ، <verse eid="LUK 6:14" /><verse number="15" style="v" sid="LUK 6:15" />ومَتَّى، وتُومَا، ويَعْقُوبْ وِلْدْ حَلْفَى، وسِمْعَانْ الِّي مْسَمِّينُو الغَيُورْ، <verse eid="LUK 6:15" /><verse number="16" style="v" sid="LUK 6:16" />ويَهُوذَا وِلْدْ يَعْقُوبْ، ويَهُوذَا الإِسْخَرْيُوطِي الِّي بِشْ يْخُونُو.<verse eid="LUK 6:16" /></para>
  <para style="s">يَسُوعْ يِشْفِي المُرْضَى</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17" />ومْبَعِّدْ هْبَطْ مْعَاهُمْ مِالجْبَلْ، ووْقِفْ فِي بَطْحَة. وكَانْ فَمَّة بَرْشَة مِنْ تْلَامِذْتُو حَاضْرِينْ ومْعَاهُمْ بَرْشَة نَاسْ مِاليَهُودِيَّة وأُورْشَلِيمْ وسَاحِلْ صُورْ وصَيْدَا. <verse eid="LUK 6:17" /><verse number="18" style="v" sid="LUK 6:18" />جَاوْ بَاشْ يِسْمْعُوهْ ويِتْشْفَاوْ مِنْ أَمْرَاضْهُمْ، وحَتَّى الِّي كَانِتْ تْعَذَّبْ فِيهُمْ الأَرْوَاحْ الشِّرِّيرَة تِشْفَاوْ. <verse eid="LUK 6:18" /><verse number="19" style="v" sid="LUK 6:19" />والنَّاسْ الكُلْ كَانُوا يْحَاوْلُوا بَاشْ يْمِسُّوهْ، عْلَى خَاطِرْ كَانِتْ فَمَّة قُوَّة تُخْرُجْ مِنُّو وتِشْفِيهُمْ الكُلْ.<verse eid="LUK 6:19" /></para>
  <para style="s">بَرَكَاتْ ولَعَنَاتْ</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20" />وهَزْ يَسُوعْ عِينِيهْ وخْزَرْ لِتْلَامِذْتُو وقَالْ:</para>
  <para style="b" vid="LUK 6:20" />
  <para style="q1" vid="LUK 6:20">«صَحَّة لِيكُمْ يَا مْسَاكِنْ،</para>
  <para style="q2" vid="LUK 6:20">عْلَى خَاطِرْ مَمْلَكْةْ اللَّهْ هِيَّ لِيكُمْ.<verse eid="LUK 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21" />صَحَّة لِيكُمْ يَلِّي تَوَّا جِيعَانِينْ،</para>
  <para style="q2" vid="LUK 6:21">عْلَى خَاطِرْكُمْ بِشْ تِشْبْعُوا.</para>
  <para style="q1" vid="LUK 6:21">صَحَّة لِيكُمْ يَلِّي تَوَّا تِبْكِيوْ،</para>
  <para style="q2" vid="LUK 6:21">عْلَى خَاطِرْكُمْ بِشْ تَضْحْكُوا.<verse eid="LUK 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LUK 6:22" />صَحَّة لِيكُمْ وَقْتِلِّي يِكْرْهُوكُمْ النَّاسْ ويْطَرْدُوكُمْ ويْعَايْرُوكُمْ،</para>
  <para style="q2" vid="LUK 6:22">ويْقُولُوا عْلِيكُمْ كْلَامْ خَايِبْ عْلَى خَاطِرْكُمْ اتَّبْعُوا فِي إِبْنْ الإِنْسَانْ.<verse eid="LUK 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="LUK 6:23" />إِفْرْحُوا فِي النْهَارْ هَاذَاكَا وازْهَاوْ،</para>
  <para style="q2" vid="LUK 6:23">عْلَى خَاطِرْ أَجْرْكُمْ عْظِيمْ فِي السْمَاء.</para>
  <para style="q2" vid="LUK 6:23">رَاهُو هَكَّا عَمْلُوا جْدُودْهُمْ مْعَ الأَنْبِيَاءْ.<verse eid="LUK 6:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24" />آمَا يَا وِيلْكُمْ يَا غُنْيَا،</para>
  <para style="q2" vid="LUK 6:24">عْلَى خَاطِرْكُمْ خْذِيتُوا بَايْكُمْ.<verse eid="LUK 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25" />يَا وِيلْكُمْ يَلِّي تَوَّا شَبْعَانِينْ،</para>
  <para style="q2" vid="LUK 6:25">عْلَى خَاطِرْ بِشْ تْجُوعُوا.</para>
  <para style="q1" vid="LUK 6:25">يَا وِيلْكُمْ يَلِّي تَوَّا تَضْحْكُوا،</para>
  <para style="q2" vid="LUK 6:25">عْلَى خَاطِرْ بِشْ تَحْزْنُوا وتْنَوْحُوا.<verse eid="LUK 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="LUK 6:26" />يَا وِيلْكُمْ إِذَا النَّاسْ الكُلْ مَدْحُوكُمْ.</para>
  <para style="q2" vid="LUK 6:26">رَاهُو جْدُودْهُمْ عَمْلُوا نَفْسْ الشَّيْ مْعَ الأَنْبِيَاءْ الكَذَّابِينْ».<verse eid="LUK 6:26" /></para>
  <para style="s">حِبُّوا أَعْدَاءْكُمْ</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27" />«آمَا إِنْتُومَا يَلِّي تِسْمْعُوا فِيَّا، نْقُلْكُمْ: حِبُّوا أَعْدَاءْكُمْ، أَعْمْلُوا الخِيرْ مْعَ الِّي يِكْرْهُوكُمْ، <verse eid="LUK 6:27" /><verse number="28" style="v" sid="LUK 6:28" />بَارْكُوا الِّي يَلْعْنُوكُمْ، وإِدْعِيوْ بِالخِيرْ لِلِّي يَعْمْلُوا مْعَاكُمْ الخَايِبْ. <verse eid="LUK 6:28" /><verse number="29" style="v" sid="LUK 6:29" />ولِّي يَضْرْبِكْ عْلَى خَدِّكْ، زِيدْ دَوَّرْلُو خَدِّكْ الآخِرْ. ولِّي يْنَحِّيلِكْ بَرْنُوسِكْ مَا تْشِدِّشْ عْلِيهْ جِبْتِكْ. <verse eid="LUK 6:29" /><verse number="30" style="v" sid="LUK 6:30" />ولِّي يُقْصْدِكْ فِي حَاجَة أَعْطِيهَالُو، ولِّي يَاخِذْلِكْ حَاجْتِكْ مَا اطَّالْبُوشْ بِيهَا. <verse eid="LUK 6:30" /><verse number="31" style="v" sid="LUK 6:31" />كِيمَا تْحِبُّوا النَّاسْ يْعَامْلُوكُمْ، عَامْلُوهُمْ إِنْتُومَا زَادَا. <verse eid="LUK 6:31" /><verse number="32" style="v" sid="LUK 6:32" />إِذَا تْحِبُّوا الِّي يْحِبُّوكُمْ، شْنِيَّة الحَاجَة الزَّايْدَة الِّي عْمَلْتُوهَا؟ حَتَّى المُذْنْبِينْ يْحِبُّوا الِّي يْحِبُّوهُمْ. <verse eid="LUK 6:32" /><verse number="33" style="v" sid="LUK 6:33" />وإِذَا عْمَلْتُوا الخِيرْ مْعَ الِّي يَعْمْلُوا مْعَاكُمْ فِي الخِيرْ، شْنِيَّة الحَاجَة الزَّايْدَة الِّي عْمَلْتُوهَا؟ حَتَّى المُذْنْبِينْ يَعْمْلُوا هَكَّا زَادَا. <verse eid="LUK 6:33" /><verse number="34" style="v" sid="LUK 6:34" />وإِذَا تْسَلْفُوا الِّي تَعْرْفُوهُمْ بِشْ يْرَجْعُولْكُمْ، شْنِيَّة الحَاجَة الزَّايْدَة الِّي عْمَلْتُوهَا؟ حَتَّى المُذْنْبِينْ يْسَلْفُوا المُذْنْبِينْ وهُومَا مِسْتَنِّينْ يْرَجْعُولْهُمْ. <verse eid="LUK 6:34" /><verse number="35" style="v" sid="LUK 6:35" />آمَا حِبُّوا أَعْدَاءْكُمْ وأَعْمْلُوا مْعَاهُمْ البَاهِي، وسَلْفُوا مِنْ غِيرْ مَا تِسْتَنَّاوْ إِنُّو الحَاجَة تِرْجْعِلْكُمْ، وهَكَّا يْكُونْ أَجْرْكُمْ عْظِيمْ وتْكُونُوا وْلَادْ العَالِي، الِّي يِنْعِمْ حَتَّى عْلَى نَاكِرْ الجْمِيلْ والشِّرِّيرْ. <verse eid="LUK 6:35" /><verse number="36" style="v" sid="LUK 6:36" />مَالَا أَرْحْمُوا كِيمَا بُوكُمْ يَرْحِمْ.<verse eid="LUK 6:36" /></para>
  <para style="s">مَا تُحْكْمُوشْ عَالنَّاسْ</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37" />«مَا تِتْهْمُوشْ النَّاسْ بَاشْ مَا يِتْهْمُوكُمْشْ، مَا تُحْكْمُوشْ عَالنَّاسْ بَاشْ مَا يِتْحْكَمْشْ عْلِيكُمْ، إِغْفْرُوا يِتْغْفِرِّلْكُمْ، <verse eid="LUK 6:37" /><verse number="38" style="v" sid="LUK 6:38" />أَعْطِيوْ يِتْعْطَالْكُمْ، كِيلْ وَافِي ومَرْصُوصْ وفَايِضْ يِتْصَبِّلْكُمْ فِي حْجِرْكُمْ، عْلَى خَاطِرْ بِالكِيلْ الِّي تْكَيْلُوا بِيهْ يِتْكَيْلِلْكُمْ».<verse eid="LUK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39" />وعْطَاهُمْ يَسُوعْ مَثَلْ: «يْنَجَّمْشِي أَعْمَى يْقُودْ أَعْمَى؟ مُشْ بِشْ يْطِيحُوا الزُّوزْ فِي حُفْرَة؟ <verse eid="LUK 6:39" /><verse number="40" style="v" sid="LUK 6:40" />مَا فَمَّاشْ تِلْمِيذْ أَعْظِمْ مِالمُعَلِّمْ مْتَاعُو، آمَا التِّلْمِيذْ الِّي يْكَمِّلْ تَعْلِيمُو يْوَلِّي كِيمَا المُعَلِّمْ مْتَاعُو.<verse eid="LUK 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41" />«وعْلَاشْ تْشُوفْ القَشَّة الِّي فِي عِينْ خُوكْ، واللُّوحَة الِّي فِي عِينِكْ مَا تْشُوفْهَاشْ؟ <verse eid="LUK 6:41" /><verse number="42" style="v" sid="LUK 6:42" />وَلَّا كِيفَاشْ تْنَجِّمْ تْقُولْ لْخُوكْ: "يَا خُويَا، خَلِّينِي انَّحِّيلِكْ القَشَّة مِنْ عِينِكْ" وإِنْتِ مَاكِشْ قَاعِدْ تْشُوفْ فِي اللُّوحَة الِّي فِي عِينِكْ؟ يَا مُنَافِقْ! نَحِّي اللُّوحَة مِنْ عِينِكْ قْبَلْ، وَقْتْهَا تْوَلِّي تْشُوفْ بِالڨْدَا وتْنَجِّمْ تْنَحِّي القَشَّة مِنْ عِينْ خُوكْ».<verse eid="LUK 6:42" /></para>
  <para style="s">الشَّجْرَة تِتْعْرَفْ مِنْ غَلِّتْهَا</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43" />«الشَّجْرَة البَاهْيَة مَا تَعْطِيشْ غَلَّة خَايْبَة، والشَّجْرَة الخَايْبَة مَا تَعْطِيشْ غَلَّة بَاهْيَة. <verse eid="LUK 6:43" /><verse number="44" style="v" sid="LUK 6:44" />كُلْ شَجْرَة تِتْعْرَفْ مِنْ غَلِّتْهَا: مَا يِجْنِيوِشْ الكَرْمُوسْ مِالشُّوكْ، ومَا يْنَحِّيوِشْ العْنِبْ مِنْ شَجْرِةْ العُلِّيڨْ. <verse eid="LUK 6:44" /><verse number="45" style="v" sid="LUK 6:45" />الإِنْسَانْ الصَّالَحْ يْخَرِّجْ الحَاجَاتْ الصَّالْحَة مِالكِنْزْ الصَّالَحْ الِّي فِي قَلْبُو، والإِنْسَانْ الخَايِبْ يْخَرِّجْ الحَاجَاتْ الخَايْبَة مِالكِنْزْ الخَايِبْ الِّي فِي قَلْبُو. عْلَى خَاطِرْ اللْسَانْ يَنْطَقْ بِلِّي يْفِيضْ مِالقَلْبْ».<verse eid="LUK 6:45" /></para>
  <para style="s">الِّي يِسْمَعْ كِلْمِةْ الرَّبْ لَازِمْ يَعْمِلْ بِيهَا</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46" />«كِيفَاشْ تْعَيْطُولِي "يَا رَبْ، يَا رَبْ" وإِنْتُومَا مَا تَعْمْلُوشْ بِلِّي نْقُولْ فِيهْ؟ <verse eid="LUK 6:46" /><verse number="47" style="v" sid="LUK 6:47" />هَاوْ بِشْ نْوَرِّيكُمْ لِشْكُونْ يْشَبَّهْ الِّي يْجِينِي ويِسْمَعْ كْلَامِي ويَعْمِلْ بِيهْ: <verse eid="LUK 6:47" /><verse number="48" style="v" sid="LUK 6:48" />يْشَبَّهْ لْإِنْسَانْ بْنَى دَارْ، حْفَرِّلْهَا وغَرَّقْ وحَطْ السَّاسْ عَالحْجَرْ. وكِي فَاضْ الوَادْ وهَدْ عْلِيهَا المَاء بْقُوَّة، مَا نَجَّمْشْ يْزَعْزَعْهَا عْلَى خَاطِرْ سَاسْهَا كَانْ مِبْنِي عَالحْجَرْ. <verse eid="LUK 6:48" /><verse number="49" style="v" sid="LUK 6:49" />وآمَا الِّي سْمَعْ كْلَامِي ومَا عْمَلْشْ بِيهْ، يْشَبَّهْ لْإِنْسَانْ بْنَى دَارُو عَالتْرَابْ مِنْ غِيرْ سَاسْ. وكِي فَاضْ عْلِيهَا الوَادْ وهَدْ عْلِيهَا المَاء بْقُوَّة طَاحِتْ بِالوَقْتْ، وتْهَدِّتْ الكُلْ!»<verse eid="LUK 6:49" /></para>
  <chapter eid="LUK 6" />
  <chapter number="7" style="c" sid="LUK 7" />
  <para style="s">إِيمَانْ الضَّابِطْ الرُّومَانِي</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1" />وبَعْدْمَا كَمِّلْ يَسُوعْ كْلَامُو لِلشَّعْبْ، دْخَلْ لِمْدِينِةْ كَفْرْنَاحُومْ. <verse eid="LUK 7:1" /><verse number="2" style="v" sid="LUK 7:2" />وكَانْ فَمَّة ضَابِطْ رُومَانِي عَنْدُو خْدِيمْ عْزِيزْ عْلِيهْ مْرِيضْ وقْرِيبْ يْمُوتْ. <verse eid="LUK 7:2" /><verse number="3" style="v" sid="LUK 7:3" />وكِي سْمَعْ عْلَى يَسُوعْ، بْعَثْلُو جْمَاعَة مِنْ شْيُوخْ اليْهُودْ بَاشْ يُطْلْبُوا مِنُّو يْجِي ويِشْفِيلُو خْدِيمُو. <verse eid="LUK 7:3" /><verse number="4" style="v" sid="LUK 7:4" />وكِي وِصْلُوا لْيَسُوعْ، شَدُّوا فِيهْ صْحِيحْ وقَالُولُو: «رَاهُو يِسْتَاهِلْ إِنِّكْ تَعْاوْنُو فِلِّي طَلْبُو مِنِّكْ، <verse eid="LUK 7:4" /><verse number="5" style="v" sid="LUK 7:5" />عْلَى خَاطْرُو يْحِبْ شَعْبْنَا وهُوَّ الِّي بْنَالْنَا المَعْبِدْ». <verse eid="LUK 7:5" /><verse number="6" style="v" sid="LUK 7:6" />يَاخِي يَسُوعْ مْشَى مْعَاهُمْ. وكِي قْرُبْ مِالدَّارْ، بْعَثْلُو الضَّابِطْ الرُّومَانِي مْعَ جْمَاعَة صْحَابُو يْقُلُّو: «يَا سِيدِي، مَا اتَّعَّبْشْ رُوحِكْ، آنَا مَا نِسْتَاهِلْشْ إِنِّكْ تُدْخُلْ تَحْتْ سْقَفْ دَارِي. <verse eid="LUK 7:6" /><verse number="7" style="v" sid="LUK 7:7" />هَاذَاكَا عْلَاشْ مَا تْجَرَّأْتِشْ إِنِّي نْجِيكْ آنَا بِيدِي، آمَا قُولْ كِلْمَة بَرْكَة تَوْ يَبْرَى خْدِيمِي. <verse eid="LUK 7:7" /><verse number="8" style="v" sid="LUK 7:8" />عْلَى خَاطِرْ آنَا زَادَا عَنْدِي شْكُونْ يُحْكُمْ فِيَّا وعَنْدِي عْسَاكِرْ نُحْكُمْ فِيهُمْ. نْقُولْ لْوَاحِدْ "إِمْشِي!" يِمْشِي، ولْغِيرُو "إِيجَا!" يْجِي، ونْقُولْ لِخْدِيمِي "أَعْمِلْ هَكَّا!" يَعْمِلْ». <verse eid="LUK 7:8" /><verse number="9" style="v" sid="LUK 7:9" />وكِي سْمَعْ يَسُوعْ الكْلَامْ هَاذَا، تْعَجِّبْ وقَالْ لِلِّي يْتَبْعُوا فِيهْ: «نْحِبْ نْقُولِلْكُمْ إِنُّو فِي بَنِي إِسْرَائِيلْ الكُلْ مَا لْقِيتْ حَدْ عَنْدُو إِيمَانْ عْظِيمْ كِيمَا هَاذَا». <verse eid="LUK 7:9" /><verse number="10" style="v" sid="LUK 7:10" />وكِي رَجْعُوا أَصْحَابْ الضَّابِطْ الرُّومَانِي لِلدَّارْ، لْقَاوْ الِّي الخْدِيمْ بْرَا.<verse eid="LUK 7:10" /></para>
  <para style="s">يَسُوعْ يْقَيِّمْ وِلْدْ هَجَّالَة مِالمُوتْ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11" />ومِنْ غُدْوَة، مْشَى يَسُوعْ لِمْدِينَة إِسْمْهَا نَايِينْ ومْعَاهْ تْلَامِذْتُو وبَرْشَة نَاسْ أُخْرِينْ. <verse eid="LUK 7:11" /><verse number="12" style="v" sid="LUK 7:12" />وكِي قْرُبْ مِنْ بَابْ المْدِينَة، شَافْ وَاحِدْ مِيِّتْ خَارْجِينْ بِيهْ، وكَانْ هُوَّ الوْلَيِّدْ الوَحِيدْ لِمْرَا هَجَّالَة، وكَانْ مْعَاهَا بَرْشَة مِنْ أَهْلْ المْدِينَة. <verse eid="LUK 7:12" /><verse number="13" style="v" sid="LUK 7:13" />وكِي شَافْهَا يَسُوعْ، سْخِفْ عْلِيهَا وقَالِلْهَا: «مَا تِبْكِيشْ!». <verse eid="LUK 7:13" /><verse number="14" style="v" sid="LUK 7:14" />وقْرُبْ مِالنَّعْشْ ومَسُّو، يَاخِي وِقْفُوا الِّي كَانُوا هَازِّينُو، وقَالْ: «يَا وْلِدْ، نْقُلِّكْ: قُومْ!». <verse eid="LUK 7:14" /><verse number="15" style="v" sid="LUK 7:15" />تْقَعَّدْ المِيِّتْ وبْدَا يِتْكَلِّمْ، يَاخِي رَجْعُو يَسُوعْ لْأُمُّو.<verse eid="LUK 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16" />والنَّاسْ الكُلْ خَافُوا، ومَجْدُوا اللَّهْ وقَالُوا: «ظْهُرْ بِينَاتْنَا نَبِيْ عْظِيمْ، اللَّهْ جَاء بَاشْ يْعَاوِنْ شَعْبُو». <verse eid="LUK 7:16" /><verse number="17" style="v" sid="LUK 7:17" />وتِنْشَرْ الخْبَرْ هَاذَا فِي اليَهُودِيَّة الكُلْ وفِي البْلَايِصْ الدَّايْرَة بِيهَا.<verse eid="LUK 7:17" /></para>
  <para style="s">يَسُوعْ ويُوحَنَّا</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18" />وسْمَعْ يُوحَنَّا الأَخْبَارْ هَاذِي الكُلْ مِنْ تْلَامِذْتُو، يَاخِي عَيِّطْ لْزُوزْ مِنْهُمْ، <verse eid="LUK 7:18" /><verse number="19" style="v" sid="LUK 7:19" />وبْعَثْهُمْ لِلرَّبْ يَسُوعْ بَاشْ يِسْأْلُوهْ: «إِنْتِ هُوَّ الِّي نِسْتَنَّاوْ فِيهْ بَاشْ يْجِي، وَلَّا نِسْتَنَّاوْ وَاحِدْ آخِرْ؟». <verse eid="LUK 7:19" /><verse number="20" style="v" sid="LUK 7:20" />ومْشَاوْ الزُّوزْ رْجَالْ لْيَسُوعْ، وقَالُولُو: «بْعَثْنَا لِيكْ يُوحَنَّا الِّي يْعَمِّدْ بَاشْ نِسْأْلُوكْ: "إِنْتِ هُوَّ الِّي نِسْتَنَّاوْ فِيهْ بَاشْ يْجِي، وَلَّا نِسْتَنَّاوْ وَاحِدْ آخَرْ؟"». <verse eid="LUK 7:20" /><verse number="21" style="v" sid="LUK 7:21" />وفِي الوَقْتْ هَاذَاكَا بِالضَّبْطْ، شْفَى يَسُوعْ بَرْشَة مُرْضَى ومُعَاقِينْ وخَرِّجْ أَرْوَاحْ شِرِّيرَة، وبَرْشَة عِمْيَانْ رَدْهُمْ يْشُوفُوا. <verse eid="LUK 7:21" /><verse number="22" style="v" sid="LUK 7:22" />يَاخِي يَسُوعْ جَاوِبْ الِّي بْعَثْهُمْ يُوحَنَّا: «إِمْشِيوْ خَبْرُوا يُوحَنَّا بِلِّي شُفْتُوهْ وسْمَعْتُوهْ: العِمْيَانْ يْشُوفُوا، والعَايْبِينْ يِمْشِيوْ، ولِّي عَنْدْهُمْ البْرَصْ يُطْهْرُوا، والطْرُشْ يِسْمْعُوا، والمُوتَى يْقُومُوا، والمْسَاكِنْ تُوصِلْهُمْ البْشَارَة، <verse eid="LUK 7:22" /><verse number="23" style="v" sid="LUK 7:23" />وصَحَّة لِيهْ الِّي مَا يْشُكِّشْ فِيَّا!».<verse eid="LUK 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24" />ووَقْتِلِّي مْشَاوْ تْلَامِذْةْ يُوحَنَّا، بْدَا يَسُوعْ يَحْكِي لِلنَّاسْ عْلَى يُوحَنَّا وقَالْ: «وَقْتِلِّي خْرَجْتُوا لِلْخْلَاء شْنُوَّة خْرَجْتُوا بَاشْ تْشُوفُوا؟ قَصْبَة يْحَرِّكْ فِيهَا الرِّيحْ؟ <verse eid="LUK 7:24" /><verse number="25" style="v" sid="LUK 7:25" />شْنُوَّة خْرَجْتُوا بَاشْ تْشُوفُوا؟ رَاجِلْ لَابِسْ لِبْسَة مِذْخْمَة؟ الِّي يِلْبْسُوا اللِّبْسَة الغَالْيَة ولِّي لَابَاسْ عْلِيهُمْ هُومَا فِي قْصُورْ المُلُوكْ! <verse eid="LUK 7:25" /><verse number="26" style="v" sid="LUK 7:26" />قُولُولِي مَالَا شْنُوَّة خْرَجْتُوا بَاشْ تْشُوفُوا؟ نَبِيْ؟ إِيْ نْعَمْ، وآنَا نْقُولِلْكُمْ إِنُّو أَعْظِمْ مِنْ نَبِيْ. <verse eid="LUK 7:26" /><verse number="27" style="v" sid="LUK 7:27" />هَاذَا هُوَّ الِّي تِكْتِبّْ عْلِيهْ فِي الكْتُبْ المُقَدْسَة:</para>
  <para style="b" vid="LUK 7:27" />
  <para style="q1" vid="LUK 7:27">"هَانِي بِشْ نِبْعَثْ قُدَّامِكْ رَسُولِي،</para>
  <para style="q2" vid="LUK 7:27">بَاشْ يْحَضِّرْلِكْ الطْرِيقْ".<verse eid="LUK 7:27" /></para>
  <para style="b" />
  <para style="m">
    <verse number="28" style="v" sid="LUK 7:28" />«وآنَا نْقُلْكُمْ: فِي البَشَرْ الكُلْ، عُمْرُو مَا تُوجِدْ وَاحِدْ أَعْظَمْ مِنْ يُوحَنَّا الِّي يْعَمِّدْ، آمَا رَاهُو أَصْغِرْ وَاحِدْ فِي مَمْلِكْةْ اللَّهْ أَعْظِمْ مِنُّو. <verse eid="LUK 7:28" /><verse number="29" style="v" sid="LUK 7:29" />والنَّاسْ الكُلْ الِّي سَمْعُوا يُوحَنَّا، حَتَّى المَكَّاسَة، إِعْتَرْفُوا بِلِّي اللَّهْ صَالَحْ، وقِبْلُوا بَاشْ يِتْعَمْدُوا بْمَعْمُودِيِّةْ يُوحَنَّا. <verse eid="LUK 7:29" /><verse number="30" style="v" sid="LUK 7:30" />آمَا الفِرِّيسِيِّينْ وعُلَمَاءْ الشَّرِيعَة رَفْضُوا مَشِيئِةْ اللَّهْ لِيهُمْ، ومَا قِبْلُوشْ يُوحَنَّا يْعَمِّدْهُمْ».<verse eid="LUK 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31" />وزَادْ قَالْ: «مَالَا بَاشْ نْشَبَّهْ وْلَادْ الجِيلْ هَاذَا؟ ولِشْكُونْ يْشَبْهُوا؟ <verse eid="LUK 7:31" /><verse number="32" style="v" sid="LUK 7:32" />هُومَا كِيفْ وْلَادْ قَاعْدِينْ فِي السُّوقْ يْعَيْطُوا لِبْعَضْهُمْ ويْقُولُوا:</para>
  <para style="b" vid="LUK 7:32" />
  <para style="q1" vid="LUK 7:32">"ضْرَبْنَالْكُمْ الزُّكْرَة مَا شْطَحْتُوا،</para>
  <para style="q2" vid="LUK 7:32">نْدِبْنَالْكُمْ مَا نَوَّحْتُوا".<verse eid="LUK 7:32" /></para>
  <para style="b" />
  <para style="m">
    <verse number="33" style="v" sid="LUK 7:33" />«عْلَى خَاطِرْ يُوحَنَّا جَاء لَا يَاكِلْ خُبْزْ ولَا يُشْرُبْ الشْرَابْ، قُلْتُوا: "سَاكْنُو شِيطَانْ". <verse eid="LUK 7:33" /><verse number="34" style="v" sid="LUK 7:34" />وجَاء إِبْنْ الإِنْسَانْ يَاكِلْ ويُشْرُبْ، قُلْتُوا عْلِيهْ: "هَاذَا رَاجِلْ وَكَّالْ وسُوكَارْجِي وصَاحِبْ المَكَّاسَة والمُذْنْبِينْ". <verse eid="LUK 7:34" /><verse number="35" style="v" sid="LUK 7:35" />آمَا الحِكْمَة الحَقِيقِيَّة تُظْهُرْ فِي تَصَرُّفَاتْ الِّي يْطَبْقُوا فِيهَا».<verse eid="LUK 7:35" /></para>
  <para style="s">يَسُوعْ يِغْفِرْ الذْنُوبْ</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36" />وإِسْتَدْعَاهْ وَاحِدْ فِرِّيسِّي بَاشْ يُفْطُرْ بَحْذَاهْ. يَاخِي دْخَلْ لْدَارْ الفِرِّيسِي، واتَّكَّى بَاشْ يَاكِلْ. <verse eid="LUK 7:36" /><verse number="37" style="v" sid="LUK 7:37" />وفِي المْدِينَة هَاذِيكَا، كَانْ فَمَّة مْرَا فَاسْدَة. كِي عَرْفِتْ الِّي يَسُوعْ مِسْتِدْعِي فِي دَارْ الفَرِّيسِي، جَاتْ وجَابِتْ مْعَاهَا دَبُّوزَة غَالِيَة مِلْيَانَة بِالعِطْرْ. <verse eid="LUK 7:37" /><verse number="38" style="v" sid="LUK 7:38" />وجَاتْ وْرَاهْ عَنْدْ سَاقِيهْ وهِيَّ تِبْكِي وبْدَاتْ تْبِلُّو فِي سَاقِيهْ بِدْمُوعْهَا وتَمْسَحْ فِيهُمْ بِشْعَرْهَا، وتْبُوسْ وتِدْهِنْ فِيهُمْ بِالعِطِرْ.<verse eid="LUK 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 7:39" />وكِي شَافْ الفِرِّيسِي الِّي اسْتَدْعَاهْ شْنِيَّة صَارْ، قَالْ بِينُو وبِينْ رُوحُو: «كَانْ جَاء الرَّاجِلْ هَاذَا نَبِيْ رَاهُو عْرَفْ شْكُونِي هَا المْرَا الِّي تْمِسْ فِيهْ وعْرَفْ سِيرِتْهَا! عْلَى خَاطِرْهَا فَاسْدَة». <verse eid="LUK 7:39" /><verse number="40" style="v" sid="LUK 7:40" />يَاخِي قَالُّو يَسُوعْ: «يَا سِمْعَانْ عَنْدِي مَا نْقُلِّكْ». وجَاوْبُو سِمْعَانْ: «قُولْ يَا مُعَلِّمْ». <verse eid="LUK 7:40" /><verse number="41" style="v" sid="LUK 7:41" />قَالُّو يَسُوعْ: «كَانْ فَمَّة رَاجِلْ مْسَلِّفْ فْلُوسْ لْزُوزْ مِالنَّاسْ، وَاحِدْ سَلْفُو 500 بْيَاسَة فِضَّة والآخِرْ 50. <verse eid="LUK 7:41" /><verse number="42" style="v" sid="LUK 7:42" />والزُّوزْ مَا نَجْمُوشْ يْرَجْعُوا الدِّينْ الِّي عْلِيهُمْ، وَلَّى سَامَحْهُمْ الإِثْنِينْ. زَعْمَة شْكُونْ مِنْهُمْ بَاشْ يْحِبُّو أَكْثِرْ؟». <verse eid="LUK 7:42" /><verse number="43" style="v" sid="LUK 7:43" />جَاوْبُو سِمْعَانْ: «نِتْصَوِّرْ الِّي يْسَالُو أَكْثِرْ». يَاخِي قَالُّو يَسُوعْ: «كْلَامِكْ صْحِيحْ».<verse eid="LUK 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 7:44" />ومْبَعِّدْ تْلَفِّتْ يَسُوعْ لِلْمْرَا وقَالْ لْسِمْعَانْ: «رِيتْهَا المْرَا هَاذِي؟ آنَا دْخَلْتْ لْدَارِكْ وإِنْتِ مَا عْطِيتْنِيشْ مَاء بَاشْ نَغْسِلْ سَاقَيَّا، آمَا هِيَّ غَسْلِتْهُمْلِي بِدْمُوعْهَا ومَسْحِتْهُمْلِي بِشْعَرْهَا. <verse eid="LUK 7:44" /><verse number="45" style="v" sid="LUK 7:45" />بُوسَة وَحْدَة مَا بُسْتْنِيشْ، آمَا هِيَّ مِلِّي دْخَلْتْ وهِيَّ تْبُوسْلِي فِي سَاقَيَّا. <verse eid="LUK 7:45" /><verse number="46" style="v" sid="LUK 7:46" />إِنْتِ مَا دْهِنْتْلِيشْ رَاسِي بِالزِّيتْ، آمَا هِيَّ دِهْنِتْلِي سَاقَيَّا بِالعِطْرْ. <verse eid="LUK 7:46" /><verse number="47" style="v" sid="LUK 7:47" />هَاذَاكَا عْلَاشْ نْقُلِّكْ: ذْنُوبْهَا الِّي قَدْ شْعَرْ الرَّاسْ تْغَفْرِتْ، يَاخِي ظَهْرِتْ بَرْشَة مْحَبَّة، آمَا الِّي يِتْغْفِرْلُو شْوَيَّة يْحِبْ شْوَيَّة». <verse eid="LUK 7:47" /><verse number="48" style="v" sid="LUK 7:48" />مْبَعِّدْ قَالِلْهَا: «ذْنُوبِكْ مَغْفُورَة». <verse eid="LUK 7:48" /><verse number="49" style="v" sid="LUK 7:49" />يَاخِي بْدَاوْ الحَاضْرِينْ يِسْأْلُوا فِي رْوَاحْهُمْ: «شْكُونُو هَاذَا حَتَّى يِغْفِرْ الذْنُوبْ؟». <verse eid="LUK 7:49" /><verse number="50" style="v" sid="LUK 7:50" />وقَالْ يَسُوعْ لِلْمْرَا: «إِيمَانِكْ نَجَّاكْ، إِمْشِي فِي سَلَامْ».<verse eid="LUK 7:50" /></para>
  <chapter eid="LUK 7" />
  <chapter number="8" style="c" sid="LUK 8" />
  <para style="s">نْسَاء يْعَاوْنُوا يَسُوعْ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1" />وبَعْدْهَا، بْدَا يَسُوعْ يْدُورْ مِنْ مْدِينَة لِمْدِينَة ومِنْ قَرْيَة لْقَرْيَة، يْنَادِي ويْبَشِّرْ بْمَمْلَكْةْ اللَّهْ. وكَانُوا مْعَاهْ تْلَامِذْتُو الأَثْنَاشْ، <verse eid="LUK 8:1" /><verse number="2" style="v" sid="LUK 8:2" />وشْوَيَّة نْسَاء شْفَاهُمْ مِالأَرْوَاحْ الشِّرِّيرَة والأَمْرَاضْ، وهُومَا: مَرْيِمْ الِّي يْعَيْطُولْهَا المَجْدَلِيَّة الِّي خَرِّجْ مِنْهَا سَبْعَة شْوَاطِنْ، <verse eid="LUK 8:2" /><verse number="3" style="v" sid="LUK 8:3" />ويُوَنَّا مَرْتْ خُوزِي الِّي كَانْ لَاهِي بْدَارْ هِيرُودُسْ، وسُوسَنَّة، وبَرْشَة غِيرْهُمْ مِلِّي كَانُوا يْعَاوْنُوا فِي يَسُوعْ وتْلَامِذْتُو مِنْ فْلُوسْهُمْ.<verse eid="LUK 8:3" /></para>
  <para style="s">مَثَلْ الزَرِّيعَة وتَفْسِيرُو</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4" />وتْلَمُّوا بِيهْ بَرْشَة نَاسْ جَايِّينْ مِنْ كُلْ مْدِينَة، يَاخِي قَالِلْهُمْ يَسُوعْ مَثَلْ: <verse eid="LUK 8:4" /><verse number="5" style="v" sid="LUK 8:5" />«خْرَجْ الفَلَّاحْ بَاشْ يَزْرَعْ الزَّرِّيعَة. وهُوَّ قَاعِدْ يَزْرَعْ، جَاتْ شْوَيَّة مِالزَرِّيعَة عَالطْرِيقْ، يَاخِي تْعَفْسِتْ بِالسَّاقِينْ وكْلَاتْهَا العْصَافِرْ. <verse eid="LUK 8:5" /><verse number="6" style="v" sid="LUK 8:6" />وشْوَيَّة أُخْرَى جَاتْ بِينْ الحْجَرْ، ودُوبْ مَا نِبْتِتْ يِبْسِتْ، عْلَى خَاطِرْ مَا كَانِشْ فَمَّة مَاء. <verse eid="LUK 8:6" /><verse number="7" style="v" sid="LUK 8:7" />وشْوَيَّة زَرِّيعَة طَاحِتْ فِي وُسْطْ الشُّوكْ، ونْبِتْ مْعَاهَا الشُّوكْ وخْنَقْهَا. <verse eid="LUK 8:7" /><verse number="8" style="v" sid="LUK 8:8" />وفَمَّة زَرِّيعَة أُخْرَى جَاتْ فِي أَرْضْ بَاهْيَة، وكِي نِبْتِتْ ثُمْرِتْ وجَابِتْ 100 مَرَّة قَدْ الِّي تِزْرَعْ». وكِي كَمِّلْ المَثَلْ قَالْ بْصُوتْ عَالِي: «الِّي عَنْدُو وِذْنِينْ تِسْمَعْ، خَلِّيهْ يِسْمَعْ!».<verse eid="LUK 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9" />وسِأْلُوهْ تْلَامِذْتُو: «شْنِيَّة مَعْنَاهْ المَثَلْ هَاذَا؟». <verse eid="LUK 8:9" /><verse number="10" style="v" sid="LUK 8:10" />يَاخِي جَاوِبْهُمْ: «إِنْتُومَا تِعْطَالْكُمْ بَاشْ تَعْرْفُوا أَسْرَارْ مَمْلَكْةْ اللَّهْ، آمَا غِيرْكُمْ نْكَلَّمْهُمْ بِالأَمْثَالْ، بَاشْ حَتَّى كِي يُخْزْرُوا مَا يْشُوفُوشْ وكِي يِسْمْعُوا مَا يِفْهْمُوشْ.<verse eid="LUK 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11" />«وهَاذَا المَقْصُودْ بِالمَثَلْ: الزَّرِّيعَة هِيَّ كِلْمِةْ اللَّهْ. <verse eid="LUK 8:11" /><verse number="12" style="v" sid="LUK 8:12" />فَمَّة نَاسْ هُومَا كِيمَا الزَّرِّيعَة الِّي جَاتْ عَالطْرِيقْ، يِسْمْعُوا كِلْمِةْ اللَّهْ ومْبَعِّدْ يْجِي إِبْلِيسْ يْنَحِّيهَا مِنْ قْلُوبْهُمْ بَاشْ مَا يَمْنُوشْ ويِنْجَاوْ. <verse eid="LUK 8:12" /><verse number="13" style="v" sid="LUK 8:13" />ونَاسْ أُخْرِينْ كِيمَا الِّي طَاحِتْ بِينْ الحْجَرْ، كِي يِسْمْعُوا الكِلْمَة يِقْبْلُوهَا بْفَرْحَة، آمَا هُومَا مَا عَنْدْهُمْشْ عْرُوقْ، يَمْنُوا مُدَّة قْصِيرَة، ودُوبْ مَا يْجِي وَقْتْ صْعِيبْ يْسَلْمُوا فِيهَا. <verse eid="LUK 8:13" /><verse number="14" style="v" sid="LUK 8:14" />ولِّي طَاحُوا وِسْطْ الشُّوكْ، هُومَا الِّي يِسْمْعُوا الكِلْمَة، آمَا وهُومَا مَاشِينْ تُخْنُقْهُمْ الهْمُومْ ومْحَبِّةْ الفْلُوسْ وشْهَاوِي الدِّنْيَا، وثَمْرِتْهُمْ مَا تُنْضُجِشْ. <verse eid="LUK 8:14" /><verse number="15" style="v" sid="LUK 8:15" />آمَا الِّي طَاحُوا فِي الأَرْضْ البَاهْيَة، هُومَا الِّي قْلُوبْهُمْ صَادْقَة وصَالْحَة، وكِي يِسْمْعُوا كِلْمِةْ اللَّهْ يْشِدُّوا فِيهَا صْحِيحْ ويِجْتَهْدُوا حَتَّى لِينْ يُثْمْرُوا.<verse eid="LUK 8:15" /></para>
  <para style="s">الفْنَارْ يِتْحَطْ فِي بْلَاصَة عَالْيَة</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16" />«ومَا فَمَّاشْ وَاحِدْ يْشَعِّلْ فْنَارْ ويْغُمُّو بْطَاسَة وَلَّا يْحُطُّو تَحْتْ فَرْشْ، آمَا يْحُطُّو فِي بْلَاصَة عَالْيَة بَاشْ الِّي يُدْخُلُوا يْشُوفُوا الضَّوْء. <verse eid="LUK 8:16" /><verse number="17" style="v" sid="LUK 8:17" />عْلَى خَاطِرْ كُلْ حَاجَة مْخُبْيَة بِشْ تُظْهُرْ، وكُلْ سِرْ بِشْ يِتْعْرَفْ ويِتْكْشِفْ. <verse eid="LUK 8:17" /><verse number="18" style="v" sid="LUK 8:18" />مَالَا رُدُّوا بَالْكُمْ وأَعْرْفُوا كِيفَاشْ تِسْمْعُوا. رَاهُو الِّي عَنْدُو يِتْزَادْلُو أَكْثِرْ، ولِّي مَا عَنْدُوشْ حَتَّى الِّي يِسْتْخَايْلُو عَنْدُو بِشْ يِتْفَكْلُو».<verse eid="LUK 8:18" /></para>
  <para style="s">أُمْ يَسُوعْ وخْوَاتُو</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19" />وجَاوْ أُمْ يَسُوعْ وخْوَاتُو، آمَا مَا نَجْمُوشْ يُوصْلُولُو مِنْ كُثْرِةْ مَا فَمَّة نَاسْ. <verse eid="LUK 8:19" /><verse number="20" style="v" sid="LUK 8:20" />يَاخِي قَالُولُو: «أُمُّكْ وخْوَاتِكْ وَاقْفِينْ لْبَرَّا، يْحِبُّوا يْشُوفُوكْ». <verse eid="LUK 8:20" /><verse number="21" style="v" sid="LUK 8:21" />جَاوِبْهُمْ: «أُمِّي وخْوَاتِي هُومَا الِّي يِسْمْعُوا كِلْمِةْ اللَّهْ ويْطَبْقُوهَا».<verse eid="LUK 8:21" /></para>
  <para style="s">يَسُوعْ يْهَدِّي العَاصْفَة</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22" />وفِي نْهَارْ مِالنْهَارَاتْ رْكِبْ يَسُوعْ فِي فْلُوكَة مْعَ تْلَامِذْتُو وقَالِلْهُمْ: «هَيَّا نْشُقُّوا لِلجِّيهَة الأُخْرَى مْتَاعْ البُحَيْرَة». ومْشَاوْ بِالفْلُوكَة. <verse eid="LUK 8:22" /><verse number="23" style="v" sid="LUK 8:23" />وهُومَا فِي البُحَيْرَة، يَسُوعْ رْقَدْ. وإِذَا بِيهْ هَبِّتْ رِيحْ قْوِيَّة، وبْدَاتْ الفْلُوكَة تِتْعَبَّى بِالمَاء ووَلَّاوْ فِي خْطَرْ. <verse eid="LUK 8:23" /><verse number="24" style="v" sid="LUK 8:24" />يَاخِي جَاوَهْ تْلَامِذْتُو وفَيْقُوهْ وقَالُولُو: «يَا سِيدْنَا، يَا سِيدْنَا، رَانَا بِشْ نُغْرْقُوا!». وَلَّا قَامْ وأْمَرْ الرِّيحْ والمُوجْ الهَايِجْ، يَاخِي رَكْحُوا والدِّنْيَا هْدَاتْ. <verse eid="LUK 8:24" /><verse number="25" style="v" sid="LUK 8:25" />مْبَعِّدْ قَالِلْهُمْ: «وِينُو إِيمَانْكُمْ؟». وخَافُوا وتْعَجْبُوا وبْدَاوْ يِسْأْلُوا فِي بْعَضْهُمْ: «شْكُونُو هَاذَا؟ حَتَّى الرِّيحْ والمُوجْ كِي يُأْمُرْهُمْ يْطِيعُوهْ!».<verse eid="LUK 8:25" /></para>
  <para style="s">يَسُوعْ يْخَرِّجْ أَرْوَاحْ شِرِّيرَة مِنْ رَاجِلْ</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26" />ووِصْلُوا لْمَنْطَقْةْ الجَرَّاسِيِّينْ الِّي مْقَابْلَة الجَلِيلْ. <verse eid="LUK 8:26" /><verse number="27" style="v" sid="LUK 8:27" />وكِي هْبَطْ يَسُوعْ لِلْبَرْ، عُرْضُو رَاجِلْ مِالمْدِينَة مَسْكُونْ بْأَرْوَاحْ شِرِّيرَة مِنْ مُدَّة طْوِيلَة، عِرْيَانْ بْكُلُّو ومَا يُسْكُنْشْ فِي دَارْ آمَا بِينْ القْبُورَاتْ. <verse eid="LUK 8:27" /><verse number="28" style="v" sid="LUK 8:28" />ودُوبْ مَا شَافْ يَسُوعْ صَاحْ وتِرْمَى عَنْدْ سَاقِيهْ، وعَيِّطْ عْلَى طُولْ صُوتُو: «آشْ بِينِي وبِينِكْ يَا يَسُوعْ إِبْنْ اللَّهْ العَالِي؟ نِتْرَجَّاكْ، مَا تْعَذَّبْنِيشْ». <verse eid="LUK 8:28" /><verse number="29" style="v" sid="LUK 8:29" />قَالْ هَاذَا عْلَى خَاطِرْ يَسُوعْ أْمَرْ الرُّوحْ الشِّرِّيرْ بَاشْ يُخْرُجْ مِالرَّاجِلْ، عْلَى خَاطِرْ بَرْشَة مَرَّاتْ كَانْ يِمْكْنُو، وكُلْ مَا يْشِدُّوهْ بِالسْلَاسِلْ وَلَّا يُرْبْطُولُو سَاقِيهْ بِالحْدِيدْ بَاشْ يْرَيْضُوهْ، كَانْ يْقَطَّعْهُمْ والشِّيطَانْ يْهِزُّو لِلْخْلَاء. <verse eid="LUK 8:29" /><verse number="30" style="v" sid="LUK 8:30" />سِأْلُو يَسُوعْ: «آشْ إِسْمِكْ؟». قَالْ: «جَيْشْ!» عْلَى خَاطِرْ جَيْشْ كْبِيرْ مِالأَرْوَاحْ الشِّرِّيرَة كَانُوا دَاخْلِينْ فِيهْ. <verse eid="LUK 8:30" /><verse number="31" style="v" sid="LUK 8:31" />وتْشَحْتُوهْ بَاشْ مَا يَبْعَثْهُمْشْ لِلْهَاوْيَة. <verse eid="LUK 8:31" /><verse number="32" style="v" sid="LUK 8:32" />وكَانْ فَمَّة بَرْشَة حْلَالِفْ سَارْحِينْ فِي الجْبَلْ، يَاخِي طَلْبُوا مِنُّو بَاشْ يْخَلِّيهُمْ يُدْخْلُوا فِيهُمْ، ويَسُوعْ خَلَّاهُمْ. <verse eid="LUK 8:32" /><verse number="33" style="v" sid="LUK 8:33" />وخَرْجُوا الأَرْوَاحْ الشِّرِّيرَة مِالرَّاجِلْ ودَخْلُوا فِي الحْلَالِفْ. وجْرَاوْ الحْلَالِفْ الكُلْ وتِرْمَاوْ مِنْ حَافِّةْ الجْبَلْ فِي البُحَيْرَة وغُرْقُوا.<verse eid="LUK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34" />كِي شَافُوا سُرَّاحْ الحْلَالِفْ آشْ صَارْ، هَرْبُوا ونَشْرُوا الخْبَرْ فِي المْدِينَة والدْشُرْ. <verse eid="LUK 8:34" /><verse number="35" style="v" sid="LUK 8:35" />وخَرْجُوا النَّاسْ بَاشْ يْشُوفُوا الِّي صَارْ، وجَاوْ لْيَسُوعْ ولْقَاوْ الرَّاجِلْ الِّي خَرْجِتْ مِنُّو الأَرْوَاحْ الشِّرِّيرَة قَاعِدْ عَنْدْ سَاقِينْ يَسُوعْ، لَابِسْ دَبْشُو وبْعَقْلُو، يَاخِي خَافُوا بَرْشَة. <verse eid="LUK 8:35" /><verse number="36" style="v" sid="LUK 8:36" />والنَّاسْ الِّي كَانُوا شَاهْدِينْ حْكَاوِلْهُمْ كِيفَاشْ تِشْفَى الرَّاجِلْ المَسْكُونْ بْأَرْوَاحْ شِرِّيرَة. <verse eid="LUK 8:36" /><verse number="37" style="v" sid="LUK 8:37" />يَاخِي سُكَّانْ مَنْطَقْةْ الجَرَّاسِيِّينْ الكُلْ طَلْبُوا مِنْ يَسُوعْ بَاشْ يِبْعِدْ عْلِيهُمْ، عْلَى خَاطِرْهُمْ خَافُوا بَرْشَة. وَلَّا طْلَعْ فِي الفْلُوكَة ورْجَعْ. <verse eid="LUK 8:37" /><verse number="38" style="v" sid="LUK 8:38" />والرَّاجِلْ الِّي خَرْجِتْ مِنُّو الأَرْوَاحْ الشِّرِّيرَة قْعَدْ يْحَاوِلْ فِيهْ بَاشْ يْهِزُّو مْعَاهْ، آمَا يَسُوعْ مَا خَلَّاهِشْ وقَالُّو: <verse eid="LUK 8:38" /><verse number="39" style="v" sid="LUK 8:39" />«إِرْجَعْ لْدَارِكْ وأَحْكِي عَلِّي عَمْلُو مْعَاكْ اللَّهْ الكُلْ». يَاخِي دَارْ المْدِينَة الكُلْ يَحْكِي عَلِّي عْمَلْهُولُو يَسُوعْ الكُلْ.<verse eid="LUK 8:39" /></para>
  <para style="s">يَسُوعْ يِشْفِي مْرَا مْرِيضَة ويْقَيِّمْ بْنَيَّة مِالمُوتْ</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40" />وكِي رْجَعْ يَسُوعْ، رَحْبُوا بِيهْ النَّاسْ الكُلْ عْلَى خَاطِرْهُمْ كَانُوا يِسْتَنَّاوْ فِي رْجُوعُو. <verse eid="LUK 8:40" /><verse number="41" style="v" sid="LUK 8:41" />وجَاهْ رَاجِلْ إِسْمُو يَايْرُسْ، وهُوَّ وَاحِدْ مِنْ رُؤَسَاءْ مَعْبِدْ اليْهُودْ، وتِرْمَى عَنْدْ سَاقِيهْ وتْشَحْتُو بَاشْ يِمْشِي مْعَاهْ لْدَارُو، <verse eid="LUK 8:41" /><verse number="42" style="v" sid="LUK 8:42" />عْلَى خَاطِرْ كَانْ عَنْدُو بْنَيَّة وَحْدَة، عْمُرْهَا أَثْنَاشِنْ سْنَة، قْرِيبْ تْمُوتْ. ويَسُوعْ مَاشِي، كَانُوا بَرْشَة نَاسْ يِدَّازُوا عْلِيهْ.<verse eid="LUK 8:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 8:43" />وكَانِتْ فَمَّة مْرَا عَنْدْهَا نَزِيفْ دَمْ مِنْ أَثْنَاشِنْ سْنَة. ورَغْمِلِّي صَرْفِتْ الِّي وْرَاهَا ولِّي قُدَّامْهَا عَالطُّبَّة، مَا نَجِّمْ حَدْ يِشْفِيهَا. <verse eid="LUK 8:43" /><verse number="44" style="v" sid="LUK 8:44" />وجَاتْ مِنْ وْرَاء يَسُوعْ ومَسِّتْ طَرْفْ مِنْ حْوَايْجُو، وبِالوَقْتْ النَّزِيفْ وْقِفْ. <verse eid="LUK 8:44" /><verse number="45" style="v" sid="LUK 8:45" />يَاخِي يَسُوعْ قَالْ: «شْكُونْ مَسْنِي؟». وكِي النَّاسْ الكُلْ نَكْرُوا، بُطْرُسْ قَالْ: «يَا سِيدْنَا النَّاسْ يِدَّازُّوا عْلِيكْ مِنْ كُلْ شِيرَة وإِنْتِ تِسْإِلْ شْكُونْ مَسْنِي؟». <verse eid="LUK 8:45" /><verse number="46" style="v" sid="LUK 8:46" />آمَا يَسُوعْ قَالْ: «فَمَّة شْكُونْ مَسْنِي، عْلَى خَاطِرْ حَسِّيتْ بْقُوَّة خَرْجِتْ مِنِّي». <verse eid="LUK 8:46" /><verse number="47" style="v" sid="LUK 8:47" />ووَقْتِلِّي عَرْفِتْ المْرَا إِنُّو فَاقْ بِيهَا، جَاتُو وهِيَّ تُرْعُشْ مِالخُوفْ، وتِرْمَاتْ عَنْدْ سَاقِيهْ وحْكَاتْ قُدَّامْ النَّاسْ الكُلْ عْلَاشْ مَسِّتُّو، وكِيفَاشْ بْرَاتْ بِالوَقْتْ. <verse eid="LUK 8:47" /><verse number="48" style="v" sid="LUK 8:48" />قَالِلْهَا: «يَا بِنْتِي، إِيمَانِكْ شْفَاكْ، إِمْشِي فِي سَلَامْ!».<verse eid="LUK 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49" />وهُوَّ يِتْكَلِّمْ، جَاء وَاحِدْ مِنْ دَارْ يَايْرُسْ رَئِيسْ مَعْبِدْ اليْهُودْ وقَالُّو: «بِنْتِكْ مَاتِتْ، مِنْ غِيرْ مَا تُقْعُدْ اتَّعِّبْ فِي المُعَلِّمْ». <verse eid="LUK 8:49" /><verse number="50" style="v" sid="LUK 8:50" />وكِي سْمَعْ يَسُوعْ الكْلَامْ هَاذَا، قَالُّو: «مَا تْخَافِشْ، أَمَّنْ بَرْكْ وهِيَّ تِتْشْفَى». <verse eid="LUK 8:50" /><verse number="51" style="v" sid="LUK 8:51" />وكِي وْصِلْ يَسُوعْ لِلدَّارْ، مَا خَلَّى حَتَّى وَاحِدْ يُدْخُلْ مْعَاهْ كَانْ بُطْرُسْ ويُوحَنَّا ويَعْقُوبْ وبُو الطُّفْلَة وأُمْهَا. <verse eid="LUK 8:51" /><verse number="52" style="v" sid="LUK 8:52" />والنَّاسْ الكُلْ كَانُوا يِبْكِيوْ ويِنْدْبُوا عْلِيهَا، يَاخِي قَالِلْهُمْ يَسُوعْ: «مَا تِبْكِيوِشْ، البْنَيَّة مَا مَاتِتْشْ، آمَا رَاهِي رَاقْدَة». <verse eid="LUK 8:52" /><verse number="53" style="v" sid="LUK 8:53" />والنَّاسْ ضَحْكُوا عْلِيهْ، عْلَى خَاطِرْهُمْ كَانُوا يَعْرْفُوا الِّي هِيَّ مَاتِتْ. <verse eid="LUK 8:53" /><verse number="54" style="v" sid="LUK 8:54" />آمَا هُوَّ خَرِّجْ النَّاسْ الكُلْ لْبَرَّا، وشَدْ الطُّفْلَة مِنْ يِدْهَا وقَالْ بْصُوتْ عَالِي: «يَا بْنَيَّة، قُومْ!». <verse eid="LUK 8:54" /><verse number="55" style="v" sid="LUK 8:55" />يَاخِي رَجْعِتِّلْهَا رُوحْهَا ووِقْفِتْ بِالوَقْتْ. وعْطَاهُمْ أَمْرْ بَاشْ يَعْطِيوْهَا تَاكِلْ. <verse eid="LUK 8:55" /><verse number="56" style="v" sid="LUK 8:56" />وقَعْدُوا وَالْدِيهَا بَاهْتِينْ، آمَا يَسُوعْ وَصَّاهُمْ بَاشْ مَا يَحْكِيوْ لْحَدْ عَلِّي صَارْ.<verse eid="LUK 8:56" /></para>
  <chapter eid="LUK 8" />
  <chapter number="9" style="c" sid="LUK 9" />
  <para style="s">يَسُوعْ يَبْعَثْ التْلَامْذَة الأَثْنَاشْ يْبَشْرُوا</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1" />ومْبَعِّدْ عَيِّطْ يَسُوعْ لِتْلَامِذْتُو الأَثْنَاشْ، وعْطَاهُمْ قُوَّة وسُلْطَة بَاشْ يْخَرْجُوا الشْوَاطِنْ الكُلْ ويِشْفِيوْ الأَمْرَاضْ. <verse eid="LUK 9:1" /><verse number="2" style="v" sid="LUK 9:2" />وبْعَثْهُمْ بَاشْ يْبَشْرُوا بْمَمْلَكْةْ اللَّهْ ويِشْفِيوْ المُرْضَى. <verse eid="LUK 9:2" /><verse number="3" style="v" sid="LUK 9:3" />وقَالِلْهُمْ: «وإِنْتُومَا مَاشِينْ مَا تْهِزُّوا مْعَاكُمْ شَيْ: لَا عْصَا، لَا صُرَّة، لَا خُبْزْ، لَا فْلُوسْ ولَا حَتَّى لِبْسَة زَايْدَة. <verse eid="LUK 9:3" /><verse number="4" style="v" sid="LUK 9:4" />والدَّارْ الِّي تُدْخْلُولْهَا أُسْكْنُوا فِيهَا حَتَّى لِينْ تِمْشِيوْ. <verse eid="LUK 9:4" /><verse number="5" style="v" sid="LUK 9:5" />وأَيْ مْدِينَة أَهْلْهَا مَا يِقْبْلُوكُمْشْ، أُخْرْجُوا مِنْهَا وأُنْفْضُوا التْرَابْ مِنْ سَاقِيكُمْ أَمَارَة إِنُّو اللَّهْ مُشْ فَرْحَانْ بِيهُمْ». <verse eid="LUK 9:5" /><verse number="6" style="v" sid="LUK 9:6" />ووَقْتِلِّي خَرْجُوا، بْدَاوْ يْدُورُوا مِنْ دَشْرَة لْدَشْرَة يْبَشْرُوا ويِشْفِيوْ فِي المُرْضَى فِي كُلْ بْلَاصَة.<verse eid="LUK 9:6" /></para>
  <para style="s">هِيرُودُسْ مُحْتَارْ</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7" />وسْمَعْ هِيرُودُسْ الوَالِي بِلِّي كَانْ صَايِرْ الكُلْ، وبْقَى مِتْحَيِّرْ، عْلَى خَاطِرْ فَمَّة شْكُونْ كَانُوا يْقُولُوا: «يُوحَنَّا الِّي يْعَمِّدْ قَامْ مِالمُوتْ». <verse eid="LUK 9:7" /><verse number="8" style="v" sid="LUK 9:8" />وجْمَاعَة يْقُولُوا: «إِيلِيَّا ظْهُرْ»، وأُخْرِينْ يْقُولُوا: «وَاحِدْ مِالأَنْبِيَاءْ القْدُمْ قَامْ». <verse eid="LUK 9:8" /><verse number="9" style="v" sid="LUK 9:9" />آمَا هِيرُودُسْ قَالْ: « يُوحَنَّا آنَا قَصِّيتْلُو رَاسُو، مَالَا شْكُونُو هَاذَا الِّي نِسْمَعْ عْلِيهْ فِي هَا الأَخْبَارْ؟». وكَانْ يْحَاوِلْ بَاشْ يْقَابْلُو.<verse eid="LUK 9:9" /></para>
  <para style="s">يَسُوعْ يْشَبَّعْ 5 000 رَاجِلْ</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10" />وبَعْدْمَا رَجْعُوا الرُّسُلْ، حْكَاوْ لْيَسُوعْ عَلِّي عَمْلُوهْ الكُلْ. يَاخِي هَزْهُمْ مْعَاهْ ومْشَاوْ بَاشْ يُقْعْدُوا وَحَّدْهُمْ بَحْذَا مْدِينَة إِسْمْهَا بَيْتْ صَيْدَا. <verse eid="LUK 9:10" /><verse number="11" style="v" sid="LUK 9:11" />آمَا النَّاسْ فَاقُوا بِيهْ وتَبْعُوهْ. يَاخِي اسْتَقْبِلْهُمْ وكَلَّمْهُمْ عْلَى مَمْلَكْةْ اللَّهْ، وشْفَى الِّي كَانُوا مُحْتَاجِينْ يِتْشْفَاوْ.<verse eid="LUK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12" />وكِي قْرِيبْ يُوفَى النْهَارْ، جَاوَهْ تْلَامِذْتُو الأَثْنَاشْ وقَالُولُو: «أَبْعِثْ النَّاسْ خَلِّيهُمْ يِمْشِيوْ لِلدْشُرْ والفِيرْمَاتْ القْرِيبَة، بَاشْ يْبَاتُوا غَادِي ويَلْقَاوْ مَا يَاكْلُوا، عْلَى خَاطِرْ هُونِي البْلَاصَة خْلَاء». <verse eid="LUK 9:12" /><verse number="13" style="v" sid="LUK 9:13" />آمَا يَسُوعْ قَالِلْهُمْ: «أَعْطِيوْهُمْ إِنْتُومَا مَا يَاكْلُوا». جَاوْبُوهْ: «مَا عَنْدْنَا كَانْ خَمْسَة خُبْزَاتْ وحُوتِّينْ، إِلَّا إِذَا كَانْ نِمْشِيوْ نِشْرِيوْ مَاكْلَة لِلنَّاسْ هَاذُومَا الكُلْ». <verse eid="LUK 9:13" /><verse number="14" style="v" sid="LUK 9:14" />عْلَى خَاطِرْ كَانْ عْدَدْهُمْ تَقْرِيبْ 5 000 رَاجِلْ. يَاخِي قَالْ لِتْلَامِذْتُو: «قَعْدُوهُمْ كُلْ 50 مْعَ بْعَضْهُمْ». <verse eid="LUK 9:14" /><verse number="15" style="v" sid="LUK 9:15" />وعَمْلُوا كِيمَا قَالِلْهُمْ وقَعْدُوا النَّاسْ الكُلْ. <verse eid="LUK 9:15" /><verse number="16" style="v" sid="LUK 9:16" />وخْذَا يَسُوعْ الخَمْسَة خُبْزَاتْ والحُوتِّينْ وهَزْ عِينِيهْ لِلسْمَاء وشْكَرْ اللَّهْ وقَسَّمْهُمْ وعْطَاهُمْ لِتْلَامِذْتُو بَاشْ يْفَرْقُوهُمْ عَالنَّاسْ. <verse eid="LUK 9:16" /><verse number="17" style="v" sid="LUK 9:17" />وكْلَاوْ النَّاسْ الكُلْ وشَبْعُوا. وعَبَّاوْ أَثْنَاشِنْ قُفَّة مِالمَاكْلَة الِّي فُضْلِتْ.<verse eid="LUK 9:17" /></para>
  <para style="s">بُطْرُسْ يِشْهِدْ الِّي يَسُوعْ هُوَّ مَسِيحْ اللَّهْ</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18" />فِي نْهَارْ مِالنْهَارَاتْ كَانْ يَسُوعْ قَاعِدْ يْصَلِّي وَحْدُو والتْلَامْذَة كَانُوا بَحْذَاهْ، يَاخِي سْإِلْهُمْ: «آنَا شْكُونْ حَسْبْ رَايْ النَّاسْ؟». <verse eid="LUK 9:18" /><verse number="19" style="v" sid="LUK 9:19" />جَاوْبُوهْ: «جْمَاعَة يْقُولُوا عْلِيكْ يُوحَنَّا الِّي يْعَمِّدْ، وجْمَاعَة يْقُولُوا الِّي إِنْتِ إِيلِيَّا، وفَمَّة شْكُونْ يْقُولْ الِّي إِنْتِ وَاحِدْ مِالأَنْبِيَاءْ القْدُمْ قَامْ مِالمُوتْ». <verse eid="LUK 9:19" /><verse number="20" style="v" sid="LUK 9:20" />يَاخِي سْإِلْهُمْ: «وحَسْبْ رَايْكُمْ إِنْتُومَا، آنَا شْكُونْ؟». جَاوْبُو بُطْرُسْ: «إِنْتِ مَسِيحْ اللَّهْ!».<verse eid="LUK 9:20" /></para>
  <para style="s">يَسُوعْ يِتْنَبَّأْ بْمُوتُو وقْيَامْتُو</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21" />آمَا هُوَّ نَبَّهْ عْلِيهُمْ بَاشْ مَا يْقُولُوا هَاذَا لْحَدْ. <verse eid="LUK 9:21" /><verse number="22" style="v" sid="LUK 9:22" />وقَالْ: «إِبْنْ الإِنْسَانْ لَازْمُو يِتْعَذَّبْ بَرْشَة، ويُرْفْضُوهْ الشْيُوخْ وكْبَارْ الكَهَنَة وعُلَمَاءْ الشَّرِيعَة، ويِتْقْتَلْ، وفِي النْهَارْ الثَّالِثْ يْقُومْ».<verse eid="LUK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23" />وقَالْ لِلنَّاسْ الكُلْ: «إِذَا كَانْ وَاحِدْ يْحِبْ يْتَبَّعْنِي، لَازْمُو يُنْكُرْ رُوحُو، ويْكُونْ مِسْتْعَدْ بَاشْ يْشَارِكْنِي فِي العْذَابْ والمُوتْ كُلْ يُومْ، ويْتَبَّعْنِي. <verse eid="LUK 9:23" /><verse number="24" style="v" sid="LUK 9:24" />الِّي يْحِبْ يْنَجِّي رُوحُو يَخْسَرْهَا. آمَا الِّي يَخْسَرْ رُوحُو عْلَى خَاطْرِي يْنَجِّيهَا. <verse eid="LUK 9:24" /><verse number="25" style="v" sid="LUK 9:25" />شْنِيَّة الفَايْدَة كَانْ الإِنْسَانْ يِرْبَحْ العَالِمْ بْكُلُّو ويَخْسَرْ حْيَاتُو وَلَّا يْضَيَّعْهَا؟ <verse eid="LUK 9:25" /><verse number="26" style="v" sid="LUK 9:26" />الِّي يِسْتْعَارْ بِيَّا وبِكْلَامِي، يِسْتْعَارْ بِيهْ إِبْنْ الإِنْسَانْ وَقْتِلِّي يِرْجَعْ فِي مَجْدُو ومَجْدْ الآبْ والمْلَايْكَة القِدِّيسِينْ. <verse eid="LUK 9:26" /><verse number="27" style="v" sid="LUK 9:27" />آمَا نْقُلْكُمْ الحَقْ: فَمَّة شْكُونْ مِالوَاقْفِينْ هُونِي مَاهُمْشْ بِشْ يْذُوقُوا المُوتْ إِلَّا بَعْدْمَا يْشُوفُوا مَمْلَكْةْ اللَّهْ».<verse eid="LUK 9:27" /></para>
  <para style="s">يَسُوعْ يُظْهُرْ فِي مَجْدُو</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28" />وبَعْدْمَا قَالْ الكْلَامْ هَاذَا بِثْمَنْيَة أَيَّامْ، هَزْ يَسُوعْ بُطْرُسْ ويُوحَنَّا ويَعْقُوبْ وطْلَعْ لِلجْبَلْ بَاشْ يْصَلِّي. <verse eid="LUK 9:28" /><verse number="29" style="v" sid="LUK 9:29" />وهُوَّ يْصَلِّي، وِجْهُو تْبَدِّلْ، وحَوَايْجُو وَلَّاوْ بْيُضْ يِلْمْعُوا. <verse eid="LUK 9:29" /><verse number="30" style="v" sid="LUK 9:30" />وإِذَا بِيهُمْ زُوزْ رْجَالْ يَحْكِيوْ مْعَاهْ، وهُومَا: مُوسَى وإِيلِيَّا، <verse eid="LUK 9:30" /><verse number="31" style="v" sid="LUK 9:31" />الِّي ظُهْرُوا فِي مَجْدْ، وكَانُوا يِتْكَلْمُوا عْلَى مُوتُو الِّي لَازِمْ يْتِمْ فِي أُورْشَلِيمْ.<verse eid="LUK 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 9:32" />بُطْرُسْ ولِّي مْعَاهْ غْلِبْهُمْ النُّومْ، آمَا كِي فَاقُوا، شَافُوا مَجْدْ يَسُوعْ والزُّوزْ الرْجَالْ الوَاقْفِينْ مْعَاهْ. <verse eid="LUK 9:32" /><verse number="33" style="v" sid="LUK 9:33" />وكِي جَاوْ الرْجَالْ يْفَارْقُوا فِيهْ، قَالْ بُطْرُسْ لْيَسُوعْ: « يَا سِيدِي مَحْلَاهَا القَعْدَة هُونِي، خَلِّينَا نُنْصْبُوا ثْلَاثَة خْيِمْ: وَحْدَة لِيكْ، ووَحْدَة لْمُوسَى، ووَحْدَة لْإِيلِيَّا». وكَانْ مُشْ عَارِفْ فَاشْ قَاعِدْ يْقُولْ. <verse eid="LUK 9:33" /><verse number="34" style="v" sid="LUK 9:34" />وهُوَّ مَزَّالْ يِتْكَلِّمْ جَاتْ غِيمَة وغَطَّاتْهُمْ، يَاخِي التْلَامْذَة خَافُوا كِي دَخْلُوا وِسْطْ الغِيمَة. <verse eid="LUK 9:34" /><verse number="35" style="v" sid="LUK 9:35" />وخْرَجْ صُوتْ مِالغَيْمَة يْقُولْ: «هَاذَا هُوَّ إِبْنِي الِّي اخْتَرْتُو، إِسْمْعُوا كْلَامُو». <verse eid="LUK 9:35" /><verse number="36" style="v" sid="LUK 9:36" />وبَعْدْمَا سَمْعُوا الصُّوتْ، شَافُوا يَسُوعْ وَحْدُو. يَاخِي كِتْمُوا الخْبَرْ ومَا حْكَاوْ لْحَتَّى حَدْ فِي الأَيَّامَاتْ هَاذِيكَا عَلِّي شَافُوهْ.<verse eid="LUK 9:36" /></para>
  <para style="s">يَسُوعْ يْخَرِّجْ رُوحْ شِرِّيرْ مِنْ وْلَيِّدْ</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37" />ومِنْ غُدْوَة، كِي هَبْطُوا مِالجْبَلْ، لْقَاوْ بَرْشَة نَاسْ يِسْتَنَّاوْ فِي يَسُوعْ. <verse eid="LUK 9:37" /><verse number="38" style="v" sid="LUK 9:38" />وبْدَا وَاحِدْ مِنْهُمْ يْعَيِّطْ ويْقُولْ: «يَا مُعَلِّمْ، نِتْرَجَّاكْ تْجِي تْشُوفْلِي وِلْدِي، رَانِي مَا عَنْدِي كَانْ هُوَّ، <verse eid="LUK 9:38" /><verse number="39" style="v" sid="LUK 9:39" />رَاهُو يِمْكْنُو رُوحْ شِرِّيرْ، وفِي لَحْظَة يْوَلِّي يْصِيحْ، ويْطِيحْ يِتْصَكِّكْ وكْشَاكْشُو تُخْرُجْ، ومَا يْسَيْبُو كَانْ بِالسِّيفْ وهُوَّ مْرَضْرِضْ. <verse eid="LUK 9:39" /><verse number="40" style="v" sid="LUK 9:40" />وطْلَبْتْ مِنْ تْلَامِذْتِكْ بَاشْ يْخَرْجُوهْ مِنُّو، يَاخِي مَا نَجْمُوشْ».<verse eid="LUK 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41" />جَاوِبْ يَسُوعْ: «إِنْتُومَا جِيلْ مُشْ مُؤْمِنْ وضَايَعْ! قَدَّاشْ بِشْ نُقْعْدِلْكُمْ ونُصْبُرْ عْلِيكُمْ؟» وقَالْ لِلرَّاجِلْ: «جِيبْ وِلْدِكْ هُونِي!». <verse eid="LUK 9:41" /><verse number="42" style="v" sid="LUK 9:42" />والوْلَيِّدْ جَايْ فِي الثْنِيَّة، صَرْعُو الشِّيطَانْ وطَاحْ يِتْصَكِّكْ فِي القَاعَة. يَاخِي نْزَرْ يَسُوعْ عَالرُّوحْ الشِّرِّيرْ، وشْفَى الوْلَيِّدْ ورَجْعُو لْبُوهْ.<verse eid="LUK 9:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 9:43" />والنَّاسْ الكُلْ تْعَجْبُوا مِنْ قُدْرِةْ اللَّهْ العْظِيمَة. وهُومَا مِتْعَجْبِينْ مِلِّي عَمْلُو يَسُوعْ، قَالْ هُوَّ لِتْلَامِذْتُو: <verse eid="LUK 9:43" /><verse number="44" style="v" sid="LUK 9:44" />«إِسْمْعُوا مْلِيحْ الِّي بِشْ نْقُولْهُولْكُمْ: إِبْنْ الإِنْسَانْ بِشْ يْسَلْمُوهْ فِي يْدِينْ النَّاسْ». <verse eid="LUK 9:44" /><verse number="45" style="v" sid="LUK 9:45" />آمَا هُومَا مَا فَهْمُوشْ كْلَامُو، عْلَى خَاطِرْ مَعْنَاهْ كَانْ مْخُبِّي عْلِيهُمْ، بَاشْ مَا يِفْهْمُوهِشْ. وخَافُوا بَاشْ يِسْأْلُوهْ شْنُوَّة يُقْصُدْ.<verse eid="LUK 9:45" /></para>
  <para style="s">شْكُونْ أَعْظِمْ وَاحِدْ فِي مَمْلَكْةْ اللَّهْ؟</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46" />وتْخَالْفُوا تْلَامِذْتُو فِي بْعَضْهُمْ عْلَى شْكُونْ أَعْظِمْ وَاحِدْ فِيهُمْ. <verse eid="LUK 9:46" /><verse number="47" style="v" sid="LUK 9:47" />آمَا يَسُوعْ عْرَفْ الِّي فِي قْلُوبْهُمْ، يَاخِي شَدْ طْفُلْ صْغِيرْ مِنْ يِدُّو ووَقْفُو بْجَنْبُو <verse eid="LUK 9:47" /><verse number="48" style="v" sid="LUK 9:48" />وقَالِلْهُمْ: «الِّي يِقْبِلْ الوْلَيِّدْ هَاذَا عْلَى خَاطِرْ إِسْمِي، يِقْبِلْنِي آنَا، ولِّي يِقْبِلْنِي، يِقْبِلْ الِّي بْعَثْنِي. عْلَى خَاطِرْ أَصْغِرْ وَاحِدْ فِيكُمْ الكُلْ هُوَّ أَعْظِمْ وَاحِدْ».<verse eid="LUK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49" />تْكَلَّمْ يُوحَنَّا قَالْ: «يَا سِيدِي، شُفْنَا وَاحِدْ يْخَرِّجْ فِي الشْوَاطِنْ بْإِسْمِكْ، يَاخِي مْنَعْنَاهْ، عْلَى خَاطْرُو مُشْ يْتَبَّعْ فِيكْ مْعَانَا». <verse eid="LUK 9:49" /><verse number="50" style="v" sid="LUK 9:50" />يَاخِي قَالُّو يَسُوعْ: «مَا تِمْنْعُوهُوشْ، عْلَى خَاطِرْ الِّي مُشْ ضِدْكُمْ، هُوَّ مْعَاكُمْ».<verse eid="LUK 9:50" /></para>
  <para style="s">قَرْيَة مَا تِقْبِلْشْ يَسُوعْ</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51" />وكِي قْرُبْ الوَقْتْ الِّي بِشْ يِتْرْفَعْ فِيهْ يَسُوعْ لِلسْمَاء، قَرِّرْ بَاشْ يِمْشِي لْأُورْشَلِيمْ. <verse eid="LUK 9:51" /><verse number="52" style="v" sid="LUK 9:52" />وبْعَثْ جْمَاعَة بَاشْ يِسْبْقُوهْ، ودَخْلُوا لْقَرْيَة فِي مَنْطَقْةْ السَّامْرَة بَاشْ يْحَضْرُولُو مَا يِلْزِمْ. <verse eid="LUK 9:52" /><verse number="53" style="v" sid="LUK 9:53" />آمَا إِمَّالِيهَا مَا قِبْلُوهِشْ عْلَى خَاطْرُو كَانْ مَاشِي لْأُورْشَلِيمْ. <verse eid="LUK 9:53" /><verse number="54" style="v" sid="LUK 9:54" />وكِي تْلَامِذْتُو يُوحَنَّا ويَعْقُوبْ شَافُوا الِّي صَارْ قَالُوا: «يَا سِيدْنَا، تْحِبْشِي نُأْمْرُوا بَاشْ تَهْبِطْ عْلِيهُمْ نَارْ مِالسْمَاء وتَحْرَقْهُمْ؟». <verse eid="LUK 9:54" /><verse number="55" style="v" sid="LUK 9:55" />وتْلَفْتِلْهُمْ يَسُوعْ ولَامْ عْلِيهُمْ وقَالْ: «إِنْتُومَا مَا تَعْرْفُوشْ مِنْ آنَا رُوحْ جِيتُوا، <verse eid="LUK 9:55" /><verse number="56" style="v" sid="LUK 9:56" />عْلَى خَاطِرْ إِبْنْ الإِنْسَانْ مَا جَاشْ بَاشْ يِهْلِكْ النَّاسْ، آمَا جَاء بَاشْ يْنَجِّيهُمْ». ومْشَاوْ لْدَشْرَة أُخْرَى.<verse eid="LUK 9:56" /></para>
  <para style="s">الِّي يْحُطْ يِدُّو عَالمِحْرَاثْ مَا يِتْلَفَّتْشْ لْتَالِي</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57" />وهُومَا مَاشِينْ فِي الطْرِيقْ جَاء وَاحِدْ لْيَسُوعْ وقَالُّو: «بِشْ نْتَبْعِكْ فِينْ مَا تِمْشِي». <verse eid="LUK 9:57" /><verse number="58" style="v" sid="LUK 9:58" />جَاوْبُو يَسُوعْ: «الثْعَالِبْ عَنْدْهَا مْغَاغِرْ، والطْيُورْ عَنْدْهَا عْشَاشْ، آمَا إِبْنْ الإِنْسَانْ مَا عَنْدُو وِينْ يْكِنْ رَاسُو». <verse eid="LUK 9:58" /><verse number="59" style="v" sid="LUK 9:59" />وقَالْ يَسُوعْ لْوَاحِدْ آخِرْ: «تَبَّعْنِي!». آمَا هُوَّ قَالُّو: «يَا سِيدِي، قْبَلْ كُلْ شَيْ خَلِّينِي نِمْشِي نِدْفِنْ بَابَا». <verse eid="LUK 9:59" /><verse number="60" style="v" sid="LUK 9:60" />يَاخِي قَالُّو يَسُوعْ: «خَلِّي المُوتَى يِدْفْنُوا المُوتَى مْتَاعْهُمْ، آمَا إِنْتِ إِمْشِي وبَشِّرْ بْمَمْلَكْةْ اللَّهْ». <verse eid="LUK 9:60" /><verse number="61" style="v" sid="LUK 9:61" />وقَالُّو وَاحِدْ آخِرْ: «يَا سِيدْنَا، آنَا نْتَبْعِكْ، آمَا خَلِّينِي نِمْشِي نْسَلِّمْ عْلَى عَايِلْتِي قْبَلْ». <verse eid="LUK 9:61" /><verse number="62" style="v" sid="LUK 9:62" />جَاوْبُو يَسُوعْ: «الِّي يْحُطْ يِدُّو عَالمِحْرَاثْ ويِتْلَفَّتْ لْتَالِي، مَا يُصْلُحْشْ لْمَمْلَكْةْ اللَّهْ».<verse eid="LUK 9:62" /></para>
  <chapter eid="LUK 9" />
  <chapter number="10" style="c" sid="LUK 10" />
  <para style="s">يَسُوعْ يَبْعَثْ الـ72 تِلْمِيذْ يْبَشْرُوا</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1" />وبَعْدْ هَاذَا زَادْ إِخْتَارْ الرَّبْ يَسُوعْ 72 أُخْرِينْ، وبْعَثْهُمْ كُلْ زُوزْ مْعَ بْعَضْهُمْ، بَاشْ يِسْبْقُوهْ لْكُلْ مْدِينَة وكُلْ بْلَاصَة كَانْ نَاوِي يِمْشِيلْهَا. <verse eid="LUK 10:1" /><verse number="2" style="v" sid="LUK 10:2" />وقَالِلْهُمْ: «هَانِي بِشْ نِبْعَثْكُمْ كِيفْ الحَصَّادَة. الصَّابَة بَرْشَة، آمَا الخَدَّامَة شْوَيَّة. مَالَا أُطْلْبُوا مِنْ مُولَى الصَّابَة يَبْعَثْ خَدَّامَة لْصَابْتُو. <verse eid="LUK 10:2" /><verse number="3" style="v" sid="LUK 10:3" />إِمْشِيوْ، هَانِي بِشْ نِبْعَثْكُمْ كِيفْ الغْنَمْ فِي وِسْطْ الذْيُوبَة. <verse eid="LUK 10:3" /><verse number="4" style="v" sid="LUK 10:4" />لَا تْهِزُّوا مْعَاكُمْ فْلُوسْ، ولَا صُرَّة، ولَا صَنْدَالْ، ومَا تْسَلْمُوا عْلَى حَتَّى حَدْ فِي الطْرِيقْ. <verse eid="LUK 10:4" /><verse number="5" style="v" sid="LUK 10:5" />والدَّارْ الِّي تُدْخْلُوهَا قُولُوا فِي الأُوِّلْ: "سَلَامْ لِلدَّارْ هَاذِي". <verse eid="LUK 10:5" /><verse number="6" style="v" sid="LUK 10:6" />إِذَا كَانْ فِيهَا شْكُونْ يْحِبْ السَّلَامْ سْلَامْكُمْ يِمْلَاهْ، مَا كَانِشْ سْلَامْكُمْ يِرْجْعِلْكُمْ. <verse eid="LUK 10:6" /><verse number="7" style="v" sid="LUK 10:7" />وأُقْعْدُوا فِي الدَّارْ هَاذِيكَا، وكُولُوا وأُشْرْبُوا مِلِّي عَنْدْهُمْ، عْلَى خَاطِرْ الِّي يِخْدِمْ مِنْ حَقُّو يُخْلِصْ. ومَا تُقْعْدُوشْ إِدُّورُوا مِنْ دَارْ لْدَارْ.<verse eid="LUK 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 10:8" />«وأَيْ مْدِينَة تُدْخْلُوهَا وإِمَّالِيهَا يِقْبْلُوكُمْ، كُولُوا مِالمَاكْلَة الِّي يَعْطِيوْهَالْكُمْ، <verse eid="LUK 10:8" /><verse number="9" style="v" sid="LUK 10:9" />وإِشْفِيوْ المُرْضَى الِّي فِيهَا وقُولُولْهُمْ: "مَمْلَكْةْ اللَّهْ قُرْبِتِّلْكُمْ". <verse eid="LUK 10:9" /><verse number="10" style="v" sid="LUK 10:10" />وأَيْ مْدِينَة تُدْخْلُوهَا ومَا يِقْبْلُوكُمْشْ إِمَّالِيهَا، أُخْرْجُوا لِشْوَارَعْهَا وقُولُوا: <verse eid="LUK 10:10" /><verse number="11" style="v" sid="LUK 10:11" />"حَتَّى تْرَابْ مْدِينِتْكُمْ الِّي لْصِقْ فِي سَاقِينَا نُنْفْضُوهْ عْلِيكُمْ، آمَا أَعْرْفُوا الِّي مَمْلَكْةْ اللَّهْ قْرِيبَة". <verse eid="LUK 10:11" /><verse number="12" style="v" sid="LUK 10:12" />نْقُولِلْكُمْ: رَاهُو فِي نْهَارْ الحْسَابْ، مْدِينِةْ سَدُومْ بِشْ يْكُونْ حْسَابْهَا أَخَفْ مِالمْدِينَة هَاذِيكَا.<verse eid="LUK 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13" />«يَا وِيلِكْ يَا كُورَزِينْ! يَا وِيلِكْ يَا بَيْتْ صَيْدَا! لَوْ كَانْ المُعْجْزَاتْ الِّي تْعَمْلُوا فِي وِسْطْكُمْ تْعَمْلُوا فِي صُورْ وصَيْدَا، رَاهُو نَاسْهُمْ تَابُوا مِنْ مُدَّة طْوِيلَة ولِبْسُوا خْيِشْ وحَطُّوا الرْمَادْ عْلَى رْيُوسْهُمْ بَاشْ يْوَرِّيوْ الِّي هُومَا تَابُوا. <verse eid="LUK 10:13" /><verse number="14" style="v" sid="LUK 10:14" />آمَا فِي نْهَارْ الحْسَابْ، صُورْ وصَيْدَا بِشْ يْكُونْ حْسَابْهُمْ أَخَفْ مِنْكُمْ. <verse eid="LUK 10:14" /><verse number="15" style="v" sid="LUK 10:15" />وإِنْتِ يَا كَفْرْنَاحُومْ! تْحِبْ تِطْلَعْ لِلسْمَاء؟ لَا، رَاكْ بِشْ تَهْبِطْ لِلْهَاوِيَة.<verse eid="LUK 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16" />«الِّي يِسْمَعْكُمْ، يِسْمَعْنِي، ولِّي يُرْفُضْكُمْ، يُرْفُضْنِي، ولِّي يُرْفُضْنِي يُرْفُضْ الِّي بْعَثْنِي».<verse eid="LUK 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17" />والـ72 الِّي بْعَثْهُمْ رَجْعُوا فَرْحَانِينْ وقَالُوا: «يَا سِيدْنَا حَتَّى الشْوَاطِنْ تِخْضْعِلْنَا بْإِسْمِكْ». <verse eid="LUK 10:17" /><verse number="18" style="v" sid="LUK 10:18" />يَاخِي قَالِلْهُمْ: «شُفْتْ الشِّيطَانْ طَايَحْ مِالسْمَاء كِيمَا البْرَقْ. <verse eid="LUK 10:18" /><verse number="19" style="v" sid="LUK 10:19" />وهَانِي عْطِيتْكُمْ سُلْطَة بَاشْ تْعَفْسُوا عَالأَفَاعِي والعْقَارِبْ وكُلْ قُوَّة عَنْدْ العْدُو، وحَتَّى شَيْ مَا يْضُرْكُمْ. <verse eid="LUK 10:19" /><verse number="20" style="v" sid="LUK 10:20" />ومْعَ هَاذَا، مَا تِفْرْحُوشْ الِّي الأَرْوَاحْ الشِّرِّيرَة تِخْضْعِلْكُمْ، آمَا إِفْرْحُوا الِّي أَسَامِيكُمْ تْكِتْبِتْ فِي السْمَاء».<verse eid="LUK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21" />وفِي لَحْظِتْهَا تِمّْلَى يَسُوعْ بِالفَرْحَة مِالرُّوحْ القُدُسْ وقَالْ: «نِحْمْدِكْ يَا بَابَا، رَبْ السْمَاء والأَرْضْ، عْلَى خَاطْرِكْ خَبِّيتْ الأُمُورْ هَاذِي عَالحُكَمَاءْ والعُلَمَاءْ وكْشِفْتْهَا لِلصْغَارْ. إِيْ نْعَمْ يَا بَابَا عْلَى خَاطِرْ هَاذِي مَشِيئْتِكْ الصَّالْحَة.<verse eid="LUK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22" />«بَابَا عْطَانِي كُلْ شَيْ، وحَتَّى حَدْ مَا يَعْرِفْ شْكُونْ هُوَّ الإِبْنْ كَانْ الآبْ، وحَتَّى حَدْ مَا يَعْرِفْ شْكُونْ هُوَّ الآبْ كَانْ الإِبْنْ والنَّاسْ الِّي يِخْتَارْ الاِبْنْ بَاشْ يِكْشِفْهُولْهُمْ».<verse eid="LUK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23" />وتْلَفَّتْ لِتْلَامِذْتُو وقَالِلْهُمْ: «صَحَّة لِلْعِينِينْ الِّي تْشُوفْ فِلِّي تْشُوفُوا فِيهْ إِنْتُومَا. <verse eid="LUK 10:23" /><verse number="24" style="v" sid="LUK 10:24" />نْقُلْكُمْ الِّي بَرْشَة أَنْبِيَاءْ ومُلُوكْ تْمَنَّاوْ يْشُوفُوا الِّي إِنْتُومَا تْشُوفُوا فِيهْ ومَا شَافُوهِشْ، ويِسْمْعُوا الِّي إِنْتُومَا تِسْمْعُوا فِيهْ ومَا سَمْعُوهِشْ».<verse eid="LUK 10:24" /></para>
  <para style="s">مَثَلْ السَّامْرِي الصَّالَحْ</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25" />وحَبْ وَاحِدْ مِنْ عُلَمَاءْ الشَّرِيعَة يْجَرْبُو، يَاخِي قَالُّو: «يَا مُعَلِّمْ، آشْ نَعْمِلْ بَاشْ نُورِثْ الحَيَاةْ الأَبَدِيَّة؟». <verse eid="LUK 10:25" /><verse number="26" style="v" sid="LUK 10:26" />قَالُّو يَسُوعْ: «آشْ تْقُولْ الشَّرِيعَة؟ وإِنْتِ كِيفَاشْ تْفَسْرُو؟». <verse eid="LUK 10:26" /><verse number="27" style="v" sid="LUK 10:27" />جَاوْبُو الرَّاجِلْ: «حِبْ الرَّبْ إِلَاهِكْ بْكُلْ قَلْبِكْ وبْكُلْ رُوحِكْ وبْكُلْ قُوْتِكْ وبْكُلْ عَقْلِكْ، وحِبْ قْرِيبِكْ كِيفْ مَا تْحِبْ رُوحِكْ». <verse eid="LUK 10:27" /><verse number="28" style="v" sid="LUK 10:28" />قَالُّو يَسُوعْ: «جَاوِبْتْ بِالصْحِيحْ، أَعْمِلْ هَاذَا تَحْيَا».<verse eid="LUK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29" />آمَا هُوَّ كِي حَبْ يَعْطِي لْرُوحُو الحَقْ، سْإِلْ يَسُوعْ: «شْكُونْ هُوَّ قْرِيبِي؟». <verse eid="LUK 10:29" /><verse number="30" style="v" sid="LUK 10:30" />جَاوْبُو يَسُوعْ: «فَمَّة رَاجِلْ كَانْ هَابِطْ مِنْ أُورْشَلِيمْ لْأَرِيحَا، يَاخِي طَاحْ فِي يْدِينْ جْمَاعَة سُرَّاقْ، نَحَّاوْلُو حْوَايْجُو وضَرْبُوهْ، ومْشَاوْ وخَلَّاوَهْ بِينْ حْيَاة ومُوتْ. <verse eid="LUK 10:30" /><verse number="31" style="v" sid="LUK 10:31" />وبِالصُّدْفَة تْعَدَّى كَاهِنْ مِنْ نَفْسْ الطْرِيقْ، وكِي شَافُو قَصْ لِلشِّيرَة الأُخْرَى ومْشَى. <verse eid="LUK 10:31" /><verse number="32" style="v" sid="LUK 10:32" />وتْعَدَّى زَادَا مِنْ نَفْسْ البْلَاصَة وَاحِدْ مِاللَّاوِيِّينْ الِّي يِخْدْمُوا فِي الهَيْكِلْ، خْزَرْلُو وقَصْ لِلشِّيرَة الأُخْرَى ومْشَى. <verse eid="LUK 10:32" /><verse number="33" style="v" sid="LUK 10:33" />آمَا فَمَّة وَاحِدْ سَامْرِي كَانْ مْسَافِرْ ومِتْعَدِّي مِنْ غَادِي، وكِي شَافُو حَنْ عْلِيهْ <verse eid="LUK 10:33" /><verse number="34" style="v" sid="LUK 10:34" />وقْرُبْ مِنُّو وصَبْ زِيتْ وشْرَابْ عَالبْلَايِصْ المَجْرُوحَة وضَمِّدْهُمْلُو، ورَكْبُو عَالزَّايْلَة مْتَاعُو وهَزُّو لِوْتِيلْ وتِلْهَى بِيهْ. <verse eid="LUK 10:34" /><verse number="35" style="v" sid="LUK 10:35" />ومِنْ غُدْوَة وهُوَّ خَارِجْ، عْطَى لْمُولَى الوْتِيلْ زُوزْ بْيَاسَاتْ فُضَّة ووَصَّاهْ: "تِلْهَى بِيهْ، وحَتَّى كَانْ صْرَفْتْ عْلِيهْ أَكْثِرْ مِلِّي عْطِيتِكْ، تَوْ كِي نِرْجَعْ نْمِدْهُمْلِكْ".<verse eid="LUK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36" />«حَسْبْ رَايِكْ شْكُونْ مِالثْلَاثَة هَاذُومَا يِتْسَمَّى قْرِيبْ الرَّاجِلْ الِّي طَاحْ فِي يْدِينْ السُرَّاقْ؟». <verse eid="LUK 10:36" /><verse number="37" style="v" sid="LUK 10:37" />جَاوْبُو: «الِّي عَامْلُو بْرَحْمَة». يَاخِي قَالُّو يَسُوعْ: «مَالَا إِمْشِي وأَعْمِلْ كِيفُو».<verse eid="LUK 10:37" /></para>
  <para style="s">يَسُوعْ فِي دَارْ مَرْيِمْ ومَرْثَا</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38" />وهُومَا يِمْشِيوْ فِي الثْنِيَّة، دْخَلْ يَسُوعْ لْدَشْرَة. يَاخِي ضَيْفِتُّو مْرَا إِسْمْهَا مَرْثَا فِي دَارْهَا. <verse eid="LUK 10:38" /><verse number="39" style="v" sid="LUK 10:39" />وكَانِتْ عَنْدْهَا أُخْتْهَا إِسْمْهَا مَرْيِمْ قَعْدِتْ عَنْدْ سَاقِينْ يَسُوعْ تِسْمَعْ فِيهْ فَاشْ قَاعِدْ يْقُولْ. <verse eid="LUK 10:39" /><verse number="40" style="v" sid="LUK 10:40" />آمَا مَرْثَا كَانِتْ غَارْقَة فِي تَحْضِيرْ الضْيَافَة. جَاتْ لْيَسُوعْ وقَالِتْلُو: «يَا سِيدِي، يَاخِي مَا قَلْقِكْشْ كِي أُخْتِي خَلَّاتْنِي نَقْضِي وَحْدِي؟ قُلْهَا تْعَاوِنِّي!». <verse eid="LUK 10:40" /><verse number="41" style="v" sid="LUK 10:41" />جَاوِبْهَا يَسُوعْ: «مَرْثَا! مَرْثَا! إِنْتِ مْشَغْشْبَة رُوحِكْ ولَاهْيَة فِي بَرْشَة حَاجَاتْ، <verse eid="LUK 10:41" /><verse number="42" style="v" sid="LUK 10:42" />آمَا مَا فَمَّة كَانْ حَاجَة وَحْدَة لَازْمَة، ومَرْيِمْ إِخْتَارِتْ أَحْسِنْ بَايْ الِّي حَتَّى حَدْ مَا يْنَجِّمْ يْفُكْهُولْهَا».<verse eid="LUK 10:42" /></para>
  <chapter eid="LUK 10" />
  <chapter number="11" style="c" sid="LUK 11" />
  <para style="s">يَسُوعْ يْعَلِّمْ تْلَامِذْتُو كِيفَاشْ يْصَلِّيوْ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1" />نْهَارْ، كَانْ يَسُوعْ يْصَلِّي فِي بْلَاصَة مِالبْلَايِصْ، وكِي كَمِّلْ، قَالُّو وَاحِدْ مِنْ تْلَامِذْتُو: «يَا سِيدِي، عَلِّمْنَا كِيفَاشْ نْصَلِّيوْ، كِيمَا عَلِّمْ يُوحَنَّا تْلَامِذْتُو». <verse eid="LUK 11:1" /><verse number="2" style="v" sid="LUK 11:2" />قَالِلْهُمْ يَسُوعْ: «وَقْتِلِّي تْصَلِّيوْ قُولُوا:</para>
  <para style="b" vid="LUK 11:2" />
  <para style="q1" vid="LUK 11:2">يَا بُونَا الِّي فِي السْمَاء،</para>
  <para style="q2" vid="LUK 11:2">خَلِّي إِسْمِكْ يِتْقَدِّسْ،</para>
  <para style="q1" vid="LUK 11:2">خَلِّي مَمْلَكْتِكْ تْجِي،</para>
  <para style="q2" vid="LUK 11:2">خَلِّي قَصْدِكْ يْصِيرْ عَالأَرْضْ كِيمَا صَايِرْ فِي السْمَاء.<verse eid="LUK 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3" />أَعْطِينَا كُلْ يُومْ الخُبْزْ الِّي يْكَفِّينَا.<verse eid="LUK 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4" />إِغْفْرِلْنَا ذْنُوبْنَا،</para>
  <para style="q2" vid="LUK 11:4">عْلَى خَاطِرْ أَحْنَا نِغْفْرُوا لِلِّي يُغْلْطُوا فِي حَقْنَا.</para>
  <para style="q1" vid="LUK 11:4">ومَا ادَّخَّلْنَاشْ فِي تَجْرْبَة،</para>
  <para style="q2" vid="LUK 11:4">آمَا نَجِّينَا مِالشِّرِيرْ».<verse eid="LUK 11:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5" />ومْبَعِّدْ زَادْ قَالِلْهُمْ: «شْكُونْ فِيكُمْ عَنْدُو صَاحْبُو، ويِمْشِيلُو فِي نُصْ اللِّيلْ ويْقُلُّو: "يَا صَاحْبِي سَلَّفْنِي ثْلَاثَة خُبْزَاتْ، <verse eid="LUK 11:5" /><verse number="6" style="v" sid="LUK 11:6" />عْلَى خَاطِرْ عَنْدِي صَاحْبِي جَاء مِالسْفَرْ، وآنَا مَا لْقِيتْ مَا نَعْطِيهْ". <verse eid="LUK 11:6" /><verse number="7" style="v" sid="LUK 11:7" />آمَا صَاحْبُو يْجَاوْبُو مِنْ دَاخِلْ: "مَا تْقَلَّقْنِيشْ! البَابْ مْسَكِّرْ، ووْلَادِي رَاقْدِينْ بْجَنْبِي. مَا انَّجَّمْشْ نْقُومْ ونَعْطِيكْ". <verse eid="LUK 11:7" /><verse number="8" style="v" sid="LUK 11:8" />نْقُولِلْكُمْ: إِذَا كَانْ مَا يْقُومِشْ ويَعْطِيهْ عْلَى خَاطْرُو صَاحْبُو، رَاهُو بِشْ يْقُومْ ويَعْطِيهْ الِّي حَاشْتُو بِيهْ الكُلْ، عْلَى خَاطْرُو شَدْ صْحِيحْ ومَا حْشِمْشْ.<verse eid="LUK 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 11:9" />«هَاذَاكَا عْلَاشْ آنَا نْقُلْكُمْ: أُطْلْبُوا تَاخْذُوا، أَسْعَاوْ تَلْقَاوْ، دُقُّوا البَابْ يِتْحَلِّلْكُمْ. <verse eid="LUK 11:9" /><verse number="10" style="v" sid="LUK 11:10" />عْلَى خَاطِرْ الِّي يُطْلُبْ يَاخِذْ، ولِّي يَسْعَى يَلْقَى، ولِّي يْدُقْ البَابْ يِتْحَلُّو. <verse eid="LUK 11:10" /><verse number="11" style="v" sid="LUK 11:11" />شْكُونْ البُو الِّي فِيكُمْ كِي يْجِيهْ وِلْدُو ويُطْلُبْ مِنْ عَنْدُو خُبْزَة، يَعْطِيهْ حَجْرَة؟ وَلَّا يُطْلُبْ مِنْ عَنْدُو حُوتَة، يَعْطِيهْ فِي عُوضْهَا حْنَشْ؟ <verse eid="LUK 11:11" /><verse number="12" style="v" sid="LUK 11:12" />وَلَّا يُطْلُبْ مِنْ عَنْدُو عَضْمَة، يَعْطِيهْ عَقْرِبْ؟ <verse eid="LUK 11:12" /><verse number="13" style="v" sid="LUK 11:13" />إِذَا كَانْ إِنْتُومَا الأَشْرَارْ تَعْرْفُوا تَعْطِيوْ حَاجَاتْ بَاهْيَة لَوْلَادْكُمْ، مُشْ بِالأَوْلَى بُوكُمْ الِّي فِي السْمَاء يَعْطِي الرُّوحْ القُدُسْ لِلِّي يُطْلْبُوهْ؟».<verse eid="LUK 11:13" /></para>
  <para style="s">قُوِّةْ اللَّهْ مُشْ بَعْلَزَبُولْ</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14" />وفِي مَرَّة، كَانْ يَسُوعْ يْخَرِّجْ فِي شِيطَانْ مِنْ رَاجِلْ، والشِّيطَانْ هَاذَاكَا كَانْ مْخَلِّيهْ بَكُّوشْ، وكِي خْرَجْ، الرَّاجِلْ رْجَعْ يِتْكَلِّمْ، والنَّاسْ تْعَجْبُوا. <verse eid="LUK 11:14" /><verse number="15" style="v" sid="LUK 11:15" />آمَا فَمَّة شْكُونْ مِنْهُمْ قَالْ: «هَاذَا يْخَرِّجْ فِي الشْوَاطِنْ ابَّعْلَزَبُولْ رَئِيسْ الشْوَاطِنْ». <verse eid="LUK 11:15" /><verse number="16" style="v" sid="LUK 11:16" />ونَاسْ أُخْرِينْ طَلْبُوا مِنُّو مُعْجْزَة مِالسْمَاء، بَاشْ يْجَرْبُوهْ.<verse eid="LUK 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 11:17" />وعْرَفْ يَسُوعْ أَفْكَارْهُمْ، وقَالِلْهُمْ: «كُلْ مَمْلْكَة تِتْقْسِمْ ضِدْ رُوحْهَا تِخْرِبْ، وكُلْ عَايْلَة تِتْقْسِمْ ضِدْ رُوحْهَا تِدَّمِّرْ. <verse eid="LUK 11:17" /><verse number="18" style="v" sid="LUK 11:18" />إِذَا كَانْ إِبْلِيسْ زَادَا يِتْقْسِمْ عْلَى رُوحُو، مَالَا كِيفَاشْ مَمْلَكْتُو تِبْقَى ثَابْتَة؟ عْلَى خَاطِرْكُمْ تْقُولُوا الِّي آنَا نْخَرِّجْ فِي الشْوَاطِنْ ابَّعْلَزَبُولْ. <verse eid="LUK 11:18" /><verse number="19" style="v" sid="LUK 11:19" />إِذَا كَانْ آنَا نْخَرِّجْ فِي الشْوَاطِنْ ابَّعْلَزَبُولْ، مَالَا الِّي يْتَبْعُوا فِيكُمْ بِشْكُونْ يْخَرْجُوا فِيهُمْ؟ هَاذَاكَا عْلَاشْ هُومَا الِّي بِشْ يُحْكْمُوا عْلِيكُمْ. <verse eid="LUK 11:19" /><verse number="20" style="v" sid="LUK 11:20" />آمَا كَانْ آنَا نْخَرِّجْ فِي الشْوَاطِنْ بْقُوِّةْ اللَّهْ، مَالَا أَعْرْفُوا إِنُّو مَمْلَكْةْ اللَّهْ جَاتْ حَتَّى لْعَنْدْكُمْ.<verse eid="LUK 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21" />«وَقْتِلِّي الرَّاجِلْ القْوِيْ والمْسَلَّحْ يْعِسْ عْلَى دَارُو، الحَاجَاتْ الِّي فِيهَا بِشْ تْكُونْ فِي الحِفِظْ والأَمَانْ. <verse eid="LUK 11:21" /><verse number="22" style="v" sid="LUK 11:22" />آمَا كَانْ يِهْجِمْ عْلِيهْ وَاحِدْ أَقْوَى مِنُّو ويِغْلْبُو، يْفُكْلُو سْلَاحُو الِّي مْعَمِّلْ عْلِيهْ، يِسْلْبُو ويْفَرَّقْ المَسْلُوبْ. <verse eid="LUK 11:22" /><verse number="23" style="v" sid="LUK 11:23" />الِّي مُشْ مْعَايَا رَاهُو ضِدِّي، ولِّي مَا يَجْمَعْشْ مْعَايَا رَاهُو يْفَرِّتْ.<verse eid="LUK 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24" />«وَقْتِلِّي الرُّوحْ الشِّرِيرْ يُخْرُجْ مِنْ إِنْسَانْ، يِبْدَا يْدُورْ فِي الخْلَاء يْلَوِّجْ عَالرَّاحَة، وكِي مَا يَلْقَاهَاشْ يْقُولْ: "نِرْجَعْ لْدَارِي الِّي خْرَجْتْ مِنْهَا". <verse eid="LUK 11:24" /><verse number="25" style="v" sid="LUK 11:25" />وكِي يِرْجَعْ يَلْقَاهَا مَكْنُوسَة ومْنَظْمَة. <verse eid="LUK 11:25" /><verse number="26" style="v" sid="LUK 11:26" />يْوَلِّي يِمْشِي ويْجِيبْ مْعَاهْ سَبْعَة أَرْوَاحْ أُخْرِينْ أَشَرْ مِنُّو، ويُدْخْلُوا ويُسْكْنُوا غَادِيكَا، وتْوَلِّي حَالِةْ الإِنْسَانْ هَاذَاكَا أَخْيِبْ مِلِّي كَانْ عْلِيهَا قْبَلْ».<verse eid="LUK 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27" />وهُوَّ يِتْكَلِّمْ، عَلَّاتْ مْرَا صُوتْهَا فِي وِسْطْ النَّاسْ وقَالِتْ: «صَحَّة لِلْأُمْ الِّي جَابِتِّكْ ورَضْعِتِّكْ». <verse eid="LUK 11:27" /><verse number="28" style="v" sid="LUK 11:28" />آمَا هُوَّ قَالْ: «صَحَّة لِلِّي يِسْمْعُوا كِلْمِةْ اللَّهْ ويْطَبْقُوهَا».<verse eid="LUK 11:28" /></para>
  <para style="s">مُعْجِزْةْ النَّبِيْ يُونَانْ</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29" />كِي بْدَاتْ الدِّنْيَا تِتْعَبَّى بِالنَّاسْ قَالْ: «الجِيلْ هَاذَا جِيلْ فَاسِدْ، يْحِبْ عْلَى مُعْجْزَة، ومَا بِشْ تِتْعْطَالُو كَانْ مُعْجِزْةْ النَّبِيْ يُونَانْ. <verse eid="LUK 11:29" /><verse number="30" style="v" sid="LUK 11:30" />وكِيمَا كَانْ يُونَانْ عَلَامَة لْأَهْلْ مْدِينِةْ نِينَوَى، إِبْنْ الإِنْسَانْ زَادَا بِشْ يْكُونْ عَلَامَة لِلْجِيلْ هَاذَا. <verse eid="LUK 11:30" /><verse number="31" style="v" sid="LUK 11:31" />ومَلِكِةْ الجَنُوبْ بِشْ تَاقِفْ نْهَارْ الحْسَابْ مْعَ الجِيلْ هَاذَا وتُحْكُمْ عْلِيهْ، عْلَى خَاطِرْهَا جَاتْ مِنْ آخِرْ الدِّنْيَا بَاشْ تِسْمَعْ حِكْمِةْ سُلَيْمَانْ، وهَاوْ فَمَّة شْكُونْ هْنَا أَعْظِمْ مِنْ سُلَيْمَانْ. <verse eid="LUK 11:31" /><verse number="32" style="v" sid="LUK 11:32" />وأَهْلْ مْدِينِةْ نِينَوَى بِشْ يَاقْفُوا نْهَارْ الحْسَابْ مْعَ الجِيلْ هَاذَا ويُحْكْمُوا عْلِيهْ، عْلَى خَاطِرْهُمْ تَابُوا وَقْتِلِّي نَبَّهُّمْ يُونَانْ، وهَاوْ فَمَّة شْكُونْ هْنَا أَعْظِمْ مِنْ يُونَانْ.<verse eid="LUK 11:32" /></para>
  <para style="s">العِينْ هِيَّ فْنَارْ البْدَنْ</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33" />«مَا فَمَّاشْ وَاحِدْ يْشَعِّلْ فْنَارْ ويْخَبِّيهْ وَلَّا يْغُمُّو بْطَاسَة، آمَا يْحُطُّو فِي بْلَاصَة عَالْيَة بَاشْ الِّي يْجِي دَاخِلْ يْشُوفْ الضَّوْء. <verse eid="LUK 11:33" /><verse number="34" style="v" sid="LUK 11:34" />العِينْ هِيَّ فْنَارْ البْدَنْ. كَانْ عِينِكْ لَابَاسْ عْلِيهَا، بَدْنِكْ الكُلْ بِشْ يْكُونْ مْنَوِّرْ. آمَا إِذَا كَانْ عِينِكْ شِرِّيرَة، بَدْنِكْ الكُلْ بِشْ يْكُونْ مْظَلِّمْ. <verse eid="LUK 11:34" /><verse number="35" style="v" sid="LUK 11:35" />مَالَا رُدْ بَالِكْ لَا يْكُونْ النُّورْ الِّي فِيكْ ظْلَامْ. <verse eid="LUK 11:35" /><verse number="36" style="v" sid="LUK 11:36" />إِذَا كَانْ بَدْنِكْ الكُلْ مْنَوِّرْ ومَا فِيهْ حَتَّى بْلَاصَة ظْلَامْ، رَاهُو بِشْ يْكُونْ مْنَوِّرْ بْكُلُّو كَايِنُو فْنَارْ ضْوَى عْلِيكْ».<verse eid="LUK 11:36" /></para>
  <para style="s">يَسُوعْ يْوَبَّخْ الفِرِّيسِيِّينْ وعُلَمَاءْ الشَّرِيعَة</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37" />ووَقْتِلِّي يَسُوعْ كَانْ يِتْكَلِّمْ، اسْتَدْعَاهْ وَاحِدْ مِالفِرِّيسِيِّينْ بَاشْ يُفْطُرْ عَنْدُو. يَاخِي دْخَلْ لْدَارُو واتَّكَّى بَاشْ يَاكِلْ. <verse eid="LUK 11:37" /><verse number="38" style="v" sid="LUK 11:38" />وتْعَجِّبْ الفِرِّيسِي كِي شَافْ الِّي يَسُوعْ مَا غْسَلْشْ يْدِيهْ قْبَلْ الفْطُورْ. <verse eid="LUK 11:38" /><verse number="39" style="v" sid="LUK 11:39" />يَاخِي الرَّبْ يَسُوعْ قَالُّو: «إِنْتُومَا الفِرِّيسِيِّينْ تَغْسْلُوا الكَاسْ والصْحَنْ مِنْ بَرَّة، آمَا مِنْ دَاخِلْ إِنْتُومَا مِلْيَانِينْ بِالطْمَعْ والخُبْثْ. <verse eid="LUK 11:39" /><verse number="40" style="v" sid="LUK 11:40" />يَلِّي مَا تِفْهْمُوشْ، يَاخِي الِّي صْنَعْ البَرَّانِي، مُشْ هُوَّ بِيدُو الِّي صْنَعْ الدَّخْلَانِي زَادَا؟ <verse eid="LUK 11:40" /><verse number="41" style="v" sid="LUK 11:41" />آمَا أَعْطِيوْ صَدْقَة مِلِّي عَنْدْكُمْ، وهَكَّا يْوَلِّي كُلْ شَيْ طَاهِرْ لِيكُمْ. <verse eid="LUK 11:41" /><verse number="42" style="v" sid="LUK 11:42" />آمَا يَا وِيلْكُمْ يَا فِرِّيسِيِّينْ، عْلَى خَاطِرْكُمْ تَعْطِيوْ فِي العْشُرْ مْتَاعْ النَّعْنَاعْ والفِيجِلْ وبْقِيِّتْ الحْشَايِشْ، آمَا مْهَمْلِينْ الحَقْ ومْحَبِّةْ اللَّهْ. كَانْ لَازِمْ تَعْمْلُوا هَاذَا مِنْ غِيرْ مَا تْهَمْلُوا الآخِرْ. <verse eid="LUK 11:42" /><verse number="43" style="v" sid="LUK 11:43" />يَا وِيلْكُمْ يَا فِرِّيسِيِّينْ! عْلَى خَاطِرْكُمْ تْحِبُّوا تُقْعْدُوا فِي البْلَاصَة الأُولَى فِي المْعَابِدْ، وتْحِبُّوا النَّاسْ تْجِي تْسَلِّمْ عْلِيكُمْ فِي الشْوَارَعْ. <verse eid="LUK 11:43" /><verse number="44" style="v" sid="LUK 11:44" />يَا وِيلْكُمْ، عْلَى خَاطِرْكُمْ تْشَبْهُوا لِلْقْبُورَاتْ الِّي مَا تِتْشَافِشْ ومَا عْلِيهَا حَتَّى أَمَارَة، الِّي يِمْشِيوْ فُوقْهَا النَّاسْ مِنْ غِيرْ مَا يَعْرْفُوا الِّي هِيَّ تَحْتْهُمْ».<verse eid="LUK 11:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45" />وتْكَلِّمْ وَاحِدْ مِنْ عُلَمَاءْ الشَّرِيعَة وقَالُّو: «يَا مُعَلِّمْ، كِي تْقُولْ هَكَّا رَاكْ قَاعِدْ تْسِبْ فِينَا أَحْنَا زَادَا!». <verse eid="LUK 11:45" /><verse number="46" style="v" sid="LUK 11:46" />يَاخِي قَالْ: «يَا وِيلْكُمْ إِنْتُومَا زَادَا يَا عُلَمَاءْ الشَّرِيعَة، عْلَى خَاطِرْكُمْ تْحُطُّوا فِي الأَحْمَالْ الثْقِيلَة عْلَى كْتَافْ النَّاسْ، وإِنْتُومَا مَا تْحِبُّوشْ تْمِسُّوهَا حَتَّى بِصْبُعْ. <verse eid="LUK 11:46" /><verse number="47" style="v" sid="LUK 11:47" />يَا وِيلْكُمْ، تِبْنِيوْ فِي قْبُورَاتْ الأَنْبِيَاءْ وجْدُودْكُمْ هُومَا الِّي قَتْلُوهُمْ. <verse eid="LUK 11:47" /><verse number="48" style="v" sid="LUK 11:48" />إِنْتُومَا مَالَا شَاهْدِينْ ومْوَافْقِينْ عَلِّي عَمْلُوهْ جْدُودْكُمْ. هُومَا قَتْلُوا الأَنْبِيَاءْ وإِنْتُومَا تِبْنِيوْ قْبُورَاتْهُمْ. <verse eid="LUK 11:48" /><verse number="49" style="v" sid="LUK 11:49" />هَاذَاكَا عْلَاشْ حِكْمِةْ اللَّهْ قَالِتْ: بِشْ نَبَعْثِلْهُمْ أَنْبِيَاءْ ورُسُلْ، مِنْهُمْ الِّي يُقْتْلُوهُمْ، ومِنْهُمْ الِّي يِضْطَهْدُوهُمْ. <verse eid="LUK 11:49" /><verse number="50" style="v" sid="LUK 11:50" />هَاذَاكَا عْلَاشْ نْحَاسِبْ الجِيلْ هَاذَا عْلَى دَمْ الأَنْبِيَاءْ الكُلْ الِّي سَالْ مِلِّي تْخَلْقِتْ الدِّنْيَا، <verse eid="LUK 11:50" /><verse number="51" style="v" sid="LUK 11:51" />مِنْ دَمْ هَابِيلْ لْدَمْ زَكَرِيَّا الِّي تِقْتَلْ بِينْ المَذْبَحْ والقُدْسْ الِّي فِي الهَيْكِلْ! إِيْ نْعَمْ، نْأَكْدِلْكُمْ الِّي الدَّمْ هَاذَا الكُلْ بِشْ يِتْحَاسِبْ عْلِيهْ الجِيلْ هَاذَا. <verse eid="LUK 11:51" /><verse number="52" style="v" sid="LUK 11:52" />يَا وِيلْكُمْ يَا عُلَمَاءْ الشَّرِيعَة! إِسْتَوْلِيتُوا عْلَى مِفْتَاحْ المَعْرْفَة، آمَا لَا دْخَلْتُوا إِنْتُومَا ولَا خَلِّيتُوا شْكُونْ يُدْخُلْ».<verse eid="LUK 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53" />ووَقْتِلِّي خْرَجْ يَسُوعْ مِنْ غَادِي، بْدَاوْ عُلَمَاءْ الشَّرِيعَة والفِرِّيسِيِّينْ يِنْقْمُوا عْلِيهْ، ويِسْتَنْطْقُوا فِيهْ فِي بَرْشَة أُمُورْ، <verse eid="LUK 11:53" /><verse number="54" style="v" sid="LUK 11:54" />ويْعِسُّوا فَمَّاشْ مَا يِزْلِقْ بْكِلْمَة يْشِدُّوهَا عْلِيهْ.<verse eid="LUK 11:54" /></para>
  <chapter eid="LUK 11" />
  <chapter number="12" style="c" sid="LUK 12" />
  <para style="s">مَا تْخَافُوشْ!</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1" />وفِي الوَقْتْ هَاذَاكَا، تْلَمُّوا عَشَرَاتْ الآلَافْ مِالعْبَادْ حَتَّى وَلَّاوْ يْعَفْسُوا فِي بْعَضْهُمْ، يَاخِي قَالْ يَسُوعْ لِتْلَامِذْتُو فِي الأُوِّلْ: «رُدُّوا بَالْكُمْ مِنْ خْمِيرِةْ الفِرِّيسِيِّينْ الِّي هِيَّ النِّفَاقْ، <verse eid="LUK 12:1" /><verse number="2" style="v" sid="LUK 12:2" />عْلَى خَاطِرْ كُلْ مَسْتُورْ بِشْ يِتْكْشِفْ، وكُلْ سِرْ بِشْ يِتَعْرَفْ. <verse eid="LUK 12:2" /><verse number="3" style="v" sid="LUK 12:3" />هَاذَاكَا عْلَاشْ كُلْ الِّي قُلْتُوهْ فِي الظْلَامْ بِشْ يِتْسْمَعْ فِي النُّورْ. ولِّي وَشْوَشْتُوهْ وْرَاء البِيبَانْ المْسَكْرَة، بِشْ يِتْبَرَّحْ بِيهْ مِنْ فُوقْ السْطُوحَاتْ.<verse eid="LUK 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4" />«ونْقُولِلْكُمْ يَا حْبَابِي: مَا تْخَافُوشْ مِلِّي يُقْتْلُوا البْدَنْ، ولِّي مَا يْنَجْمُوا يَعْمْلُوا شَيْ أَكْثِرْ مِنْ هَكَّا. <verse eid="LUK 12:4" /><verse number="5" style="v" sid="LUK 12:5" />آمَا نْوَرِّيكُمْ مِنْ شْكُونْ تْخَافُوا: خَافُوا مِلِّي بَعْدْمَا يُقْتِلْ البْدَنْ عَنْدُو القُدْرَة يَرْمِي فِي جْهَنِّمْ. إِيْ نْعَمْ، نْقُولِلْكُمْ، هَاذَا هُوَّ الِّي تْخَافُوا مِنُّو.<verse eid="LUK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 12:6" />«يَاخِي مُشْ خَمْسَة عْصَافِرْ يِتْبَاعُوا بْزُوزْ فْرَنْكْ؟ ومْعَ هَاذَا اللَّهْ مَا يِنْسَى حَتَّى وَاحِدْ مِنْهُمْ. <verse eid="LUK 12:6" /><verse number="7" style="v" sid="LUK 12:7" />آمَا إِنْتُومَا حَتَّى شْعَرْ رْيُوسْكُمْ مَحْسُوبْ بْكُلُّو، مَالَا مَا تْخَافُوشْ، رَاكُمْ إِنْتُومَا خِيرْ مِنْ بَرْشَة عْصَافِرْ!<verse eid="LUK 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8" />«ونْقُولِلْكُمْ: الِّي يِسْتَعْرِفْ بِيَّا قُدَّامْ النَّاسْ، يِسْتَعْرِفْ بِيهْ إِبْنْ الإِنْسَانْ قُدَّامْ مْلَايِكْةْ اللَّهْ. <verse eid="LUK 12:8" /><verse number="9" style="v" sid="LUK 12:9" />ولِّي يُنْكُرْنِي قُدَّامْ النَّاسْ، نُنْكْرُوا قُدَّامْ مْلَايِكْةْ اللَّهْ. <verse eid="LUK 12:9" /><verse number="10" style="v" sid="LUK 12:10" />ولِّي يْقُولْ كِلْمَة ضِدْ إِبْنْ الإِنْسَانْ يِتْغْفِرْلُو، آمَا الِّي يَكْفِرْ بِالرُّوحْ القُدُسْ، مُشْ بِشْ يِتْغْفِرْلُو.<verse eid="LUK 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11" />«وكِي يْهِزُّوكُمْ بَاشْ تِتْحَاكْمُوا فِي المْعَابِدْ وقُدَّامْ الحُكَّامْ والنَّاسْ الِّي فِي السُّلْطَة، مَا تْخَمُّوشْ كِيفَاشْ ادَّافْعُوا عْلَى رْوَاحْكُمْ ولَا آشْ بِشْ تْقُولُوا، <verse eid="LUK 12:11" /><verse number="12" style="v" sid="LUK 12:12" />عْلَى خَاطِرْ فِي اللَّحْظَة هَاذِيكَا، الرُّوحْ القُدُسْ يْعَلِّمْكُمْ آشْ لَازِمْكُمْ تْقُولُوا».<verse eid="LUK 12:12" /></para>
  <para style="s">مَثَلْ الرَّاجِلْ الغْنِيْ</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13" />وقَالُّو وَاحِدْ مِالحَاضْرِينْ: «يَا مُعَلِّمْ، قُولْ لْخُويَا يَعْطِينِي بَايِي مِالوَرْثَة». <verse eid="LUK 12:13" /><verse number="14" style="v" sid="LUK 12:14" />آمَا هُوَّ قَالُّو: «يَا رَاجِلْ، شْكُونْ حَطْنِي عْلِيكُمْ قَاضِي وَلَّا قَسَّامْ وِرْثْ؟» <verse eid="LUK 12:14" /><verse number="15" style="v" sid="LUK 12:15" />وقَالْ لِلنَّاسْ: «رُدُّوا بَالْكُمْ وابْعْدُوا عْلَى كُلْ أَنْوَاعْ الطْمَعْ، عْلَى خَاطِرْ حْيَاةْ الإِنْسَانْ مُشْ فِي كُثْرِةْ أَمْلَاكُو».<verse eid="LUK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16" />وقَالِلْهُمْ المَثَلْ هَاذَا: «فَمَّة رَاجِلْ غْنِيْ، أَرْضُو جَابِتْلُو صَابَة كْبِيرَة. <verse eid="LUK 12:16" /><verse number="17" style="v" sid="LUK 12:17" />يَاخِي خَمَّمْ وقَالْ: "آشْ بِشْ نَعْمِلْ تَوَّا وآنَا مَا عَنْدِيشْ بْلَاصَة نْخَزِّنْ فِيهَا صَابْتِي؟". <verse eid="LUK 12:17" /><verse number="18" style="v" sid="LUK 12:18" />ومْبَعِّدْ قَالْ: "هَاوْ آشْ بِشْ نَعْمِلْ: نْهِدْ المْخَازِنْ الِّي عَنْدِي ونِبْنِي مَا أَكْبِرْ مِنْهَا، ونْخَزِّنْ فِيهُمْ قَمْحِي وخِيرَاتِي الكُلْ. <verse eid="LUK 12:18" /><verse number="19" style="v" sid="LUK 12:19" />ونْقُولْ لْرُوحِي: عَنْدِكْ خِيرَاتْ بْزَايِدْ مْخَزْنَة، تِكْفِيكْ سْنِينْ وسْنِينْ، إِرْتَاحْ وكُولْ وأُشْرُبْ وتْنَعِّمْ". <verse eid="LUK 12:19" /><verse number="20" style="v" sid="LUK 12:20" />آمَا اللَّهْ قَالُّو: "يَلِّي مَا تِفْهِمْشْ، اللِّيلَة هَاذِي تِطْلَعْ رُوحِكْ، وهَاذَا الِّي حَضَّرْتُو لِشْكُونْ بِشْ تْخَلِّيهْ؟". <verse eid="LUK 12:20" /><verse number="21" style="v" sid="LUK 12:21" />وهَاذَا حَالْ الِّي يِكْنِزْ لْرُوحُو، ومَا يْكُونِشْ غْنِيْ لِلَّهْ».<verse eid="LUK 12:21" /></para>
  <para style="s">اللَّهْ يَرْعَانَا</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22" />ومْبَعِّدْ قَالْ يَسُوعْ لِتْلَامِذْتُو: «هَاذَاكَا عْلَاشْ نْقُولِلْكُمْ: مَا تْعِيشُوشْ وإِنْتُومَا تْخَمُّوا فِي شْنُوَّة بِشْ تَاكْلُوا، ولَا فِي شْنُوَّة بِشْ تِلْبْسُوا. <verse eid="LUK 12:22" /><verse number="23" style="v" sid="LUK 12:23" />عْلَى خَاطِرْ الحَيَاةْ أَهَمْ مِالمَاكْلَة، والبْدَنْ أَهَمْ مِاللِّبْسَة. <verse eid="LUK 12:23" /><verse number="24" style="v" sid="LUK 12:24" />ثَبْتُوا فِي الغِرْبَانْ: هِيَّ لَا تَزْرَعْ، لَا تَحْصِدْ، ولَا عَنْدْهَا مَخْزِنْ ولَا دِبُّو، واللَّهْ يُرْزُقْهَا. فَمَا بَالِكْ إِنْتُومَا الِّي أَحْسِنْ مِالعْصَافِرْ إِبَّرْشَة. <verse eid="LUK 12:24" /><verse number="25" style="v" sid="LUK 12:25" />وشْكُونْ فِيكُمْ إِذَا بْقَى يْخَمَّمْ يْنَجِّمْ يْزِيدْ فِي عُمْرُو حَتَّى سَاعَة وَحْدَة؟ <verse eid="LUK 12:25" /><verse number="26" style="v" sid="LUK 12:26" />إِذَا كَانْ مَا قْدَرْتُوشْ عَالأُمُورْ البْسِيطَة، مَالَا عْلَاشْ تَبْقَاوْ تْخَمُّوا عَالأُمُورْ الأُخْرَى؟<verse eid="LUK 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 12:27" />«ثَبْتُوا فِي النَّوَّارْ كِيفَاشْ يِكْبِرْ! وهُوَّ لَا يِتْعِبْ ولَا يِغْزِلْ. آمَا آنَا نْقُلْكُمْ: حَتَّى المَلِكْ سُلَيْمَانْ فِي عِزُّو مَا لْبِسْشْ كِيفْ وَحْدَة مِنْهُمْ! <verse eid="LUK 12:27" /><verse number="28" style="v" sid="LUK 12:28" />إِذَا كَانْ الحْشِيشْ الِّي يِنْبِتْ اليُومْ وغُدْوَة يِتْرْمَى فِي النَّارْ، اللَّهْ يْلَبْسُو كِيمَا هَكَّا، مُشْ إِنْتُومَا أَوْلَى إِنُّو يْلَبَّسْكُمْ يَلِّي إِيمَانْكُمْ ضْعِيفْ! <verse eid="LUK 12:28" /><verse number="29" style="v" sid="LUK 12:29" />مَالَا مَا تُقْعْدُوشْ تْخَمُّوا آشْ بِشْ تَاكْلُوا وآشْ بِشْ تُشْرْبُوا، ومَا تُقْعْدُوشْ مِتْقَلْقِينْ. <verse eid="LUK 12:29" /><verse number="30" style="v" sid="LUK 12:30" />الحَاجَاتْ هَاذِي الكُلْ يِجْرِيوْ وْرَاهَا شُعُوبْ العَالِمْ، آمَا بُوكُمْ الِّي فِي السْمَاء يَعْرِفْ الِّي إِنْتُومَا تَحْتَاجُولْهَا. <verse eid="LUK 12:30" /><verse number="31" style="v" sid="LUK 12:31" />آمَا أَسْعَاوْ لْمَمْلَكْةْ اللَّهْ، والحَاجَاتْ هَاذِي الكُلْ تَوْ تِتْزَادِلْكُمْ. <verse eid="LUK 12:31" /><verse number="32" style="v" sid="LUK 12:32" />مَا تْخَافُوشْ، يَلِّي كِيمَا القَطِيعْ الصْغِيرْ! رَاهُو بُوكُمْ الِّي فِي السْمَاء فَرْحَانْ إِنُّو يَعْطِيكُمْ المَمْلْكَة.<verse eid="LUK 12:32" /></para>
  <para style="s">وِينْ يْكُونْ كِنْزِكْ يْكُونْ قَلْبِكْ</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 12:33" />«بِيعُوا الِّي تِمْلْكُوهْ واتْصَدْقُوا بِيهْ. وزَوْدُوا رْوَاحْكُمْ بْمَالْ مَا يُوفَاشْ، يْكُونْ كِنْزْ فِي السْمَاء مَا يِفْنَاشْ، وِينْ لَا يُقْرْبُو سَارَقْ ولَا يَاكْلُو السُّوسْ. <verse eid="LUK 12:33" /><verse number="34" style="v" sid="LUK 12:34" />عْلَى خَاطِرْ وِينْ يْكُونْ كِنْزِكْ يْكُونْ قَلْبِكْ زَادَا.<verse eid="LUK 12:34" /></para>
  <para style="s">كُونُوا دِيمَا مُسْتْعَدِّينْ</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35" />«كُونُوا مُسْتْعَدِّينْ، مْشَمْرِينْ عْلَى ذْرَاعَاتْكُمْ وفْنَارَاتْكُمْ شَاعْلَة، <verse eid="LUK 12:35" /><verse number="36" style="v" sid="LUK 12:36" />وكُونُوا كِيفْ النَّاسْ الِّي يِسْتَنَّاوْ فِي سِيدْهُمْ وَقْتَاشْ يِرْجَعْ مِالعِرْسْ، بَاشْ دُوبْ مَا يُوصِلْ ويْدُقْ البَابْ يْحِلُّولُو بِالوَقْتْ. <verse eid="LUK 12:36" /><verse number="37" style="v" sid="LUK 12:37" />صَحَّة لِيهُمْ الخُدَّامْ الِّي وَقْتِلِّي يِرْجَعْ سِيدْهُمْ يَلْقَاهُمْ سَاهْرِينْ. نْقُلْكُمْ الحَقْ: رَاهُو يْشَمِّرْ عْلَى ذْرَاعُو ويْقَعَّدْهُمْ بَاشْ يَاكْلُوا ويَبْدَى يِخْدِمْ فِيهُمْ. <verse eid="LUK 12:37" /><verse number="38" style="v" sid="LUK 12:38" />صَحَّة لِيهُمْ كَانْ رْجَعْ سِيدْهُمْ مْعَ نُصْ اللِّيلْ وَلَّا بَعْدُو ولْقَاهُمْ سَاهْرِينْ. <verse eid="LUK 12:38" /><verse number="39" style="v" sid="LUK 12:39" />آمَا أَعْرْفُوا هَاذَا: كَانْ جَاء مُولَى الدَّارْ يَعْرِفْ وَقْتَاشْ يَهْبِطْ عْلِيهْ السَّارَقْ، رَاهُو مَا خَلَّاشْ دَارُو تِتْسْرَقْ. <verse eid="LUK 12:39" /><verse number="40" style="v" sid="LUK 12:40" />كُونُوا إِنْتُومَا زَادَا مُسْتْعَدِّينْ عْلَى خَاطِرْ إِبْنْ الإِنْسَانْ بِشْ يِرْجَعْ فِي سَاعَة مَا تِتْوَقْعُوهَاشْ».<verse eid="LUK 12:40" /></para>
  <para style="s">شْكُونُو المَسْؤُولْ الثِّيقَة والحَكِيمْ؟</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41" />يَاخِي سِأْلُو بُطْرُسْ: «يَا سِيدِي، المَثَلْ هَاذَا تْقُولْ فِيهْ لِينَا أَحْنَا وَلَّا لِلنَّاسْ الكُلْ؟». <verse eid="LUK 12:41" /><verse number="42" style="v" sid="LUK 12:42" />وجَاوْبُو الرَّبْ يَسُوعْ: «شْكُونُو المَسْؤُولْ الثِّيقَة والحَكِيمْ الِّي يْكَلْفُو سِيدُو بَاشْ يَعْطِي لْخُدَّامُو الأُخْرِينْ بَايْهُمْ مِالمَاكْلَة فِي وَقْتْهَا؟ <verse eid="LUK 12:42" /><verse number="43" style="v" sid="LUK 12:43" />صَحَّة لِيهْ الخْدِيمْ هَاذَا، الِّي كِي يِرْجَعْ سِيدُو يَلْقَاهْ يِخْدِمْ فِي خِدْمْتُو. <verse eid="LUK 12:43" /><verse number="44" style="v" sid="LUK 12:44" />نْقُلْكُمْ الحَقْ: هَاذَا يْحُطُّو سِيدُو مَسْؤُولْ عْلَى أَمْلَاكُو الكُلْ. <verse eid="LUK 12:44" /><verse number="45" style="v" sid="LUK 12:45" />آمَا إِذَا كَانْ الخْدِيمْ هَاذَا قَالْ بِينُو وبِينْ رُوحُو: "سِيدِي بِشْ يِرْجَعْ امَّخَّرْ" وبْدَا يَضْرِبْ فِي الخُدَّامْ، نْسَاء ورْجَالْ، ويَاكِلْ ويُشْرُبْ ويِسْكِرْ، <verse eid="LUK 12:45" /><verse number="46" style="v" sid="LUK 12:46" />يِرْجَعْ سِيدُو عْلَى غَفْلَة، فِي نْهَارْ مَا يْجِيشْ عْلَى بَالُو وفِي سَاعَة مَا يَعْرِفْهَاشْ، ويْعَاقْبُو عِقَابْ كْبِيرْ ويِتْصَرِّفْ مْعَاهْ كِيمَا يِتْصَرِّفْ مْعَ الخُدَّامْ الخَايْنِينْ. <verse eid="LUK 12:46" /><verse number="47" style="v" sid="LUK 12:47" />والخْدِيمْ الِّي يَعْرِفْ آشْ يْحِبْ سِيدُو، ومَا يْحَضَّرْشْ رُوحُو ومَا يَعْمِلْشْ الِّي يْحِبْ عْلِيهْ سِيدُو، رَاهُو بِشْ يِتْضْرَبْ بَرْشَة. <verse eid="LUK 12:47" /><verse number="48" style="v" sid="LUK 12:48" />آمَا الِّي مَا يَعْرِفْشْ آشْ يْحِبْ سِيدُو ويَعْمِلْ الِّي يِسْتَاهِلْ عْلِيهْ الضَّرْبْ، هَاذَاكَا يِتْضْرَبْ ضَرْبْ أَخَفْ. كُلْ الِّي تَعْطَالُو بَرْشَة يُطْلْبُوا مِنُّو بَرْشَة، ولِّي يِسْتَأْمْنُوهْ عْلَى بَرْشَة يْطَالْبُوهْ بْمَا أَكْثِرْ.<verse eid="LUK 12:48" /></para>
  <para style="s">مُشْ سَلَامْ، آمَا إِنْقِسَامْ</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49" />«جِيتْ بَاشْ نَرْمِي نَارْ عَالأَرْضْ، وقَدَّاشْ نِتْمَنَّي إِنْهَا تُكُونْ شِعْلِتْ! <verse eid="LUK 12:49" /><verse number="50" style="v" sid="LUK 12:50" />آمَا عَنْدِي وْجَايَعْ لَازِمْنِي نُغْطُسْ فِيهَا كِيمَا الِّي يُغْطُسْ فِي مَعْمُودِيِّةْ المَاء، ومَانِي بِشْ نَرْتَاحْ كَانْ مَا تْصِيرْ. <verse eid="LUK 12:50" /><verse number="51" style="v" sid="LUK 12:51" />يَاخِي مَاشِي فِي بَالْكُمْ الِّي آنَا جِيتْ بَاشْ نْجِيبْ سَلَامْ لِلْأَرْضْ؟ لَا، آمَا جِيتْ بَاشْ نْفَرَّقْ بِينْ النَّاسْ. <verse eid="LUK 12:51" /><verse number="52" style="v" sid="LUK 12:52" />ومِنْ تَوَّا الدَّارْ الِّي فِيهَا خَمْسَة، بِشْ يِتْقَسْمُوا: ثْلَاثَة ضِدْ ثْنِينْ، وثْنِينْ ضِدْ ثْلَاثَة. <verse eid="LUK 12:52" /><verse number="53" style="v" sid="LUK 12:53" />البُو يْجِي ضِدْ وِلْدُو، والوْلَيِّدْ ضِدْ بُوهْ. الأُمْ ادُّورْ عْلَى بِنْتْهَا، والبْنَيَّة عْلَى أُمْهَا. الحْمَاة عْلَى كَنِّتْهَا، والكَنَّة عْلَى حْمَاتْهَا».<verse eid="LUK 12:53" /></para>
  <para style="s">أَعْرْفُوا كِيفَاشْ تْمَيْزُوا الحَقْ</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54" />وزَادْ قَالْ لِلنَّاسْ: «كِي تْشُوفُوا غِيمَة طَالْعَة مِالغَرْبْ، بِالوَقْتْ تْقُولُوا: "المْطَرْ بَاشْ تْصُبْ" وهَاذَاكَا الِّي يْصِيرْ. <verse eid="LUK 12:54" /><verse number="55" style="v" sid="LUK 12:55" />وإِذَا هَبِّتْ رِيحْ مِالجَنُوبْ، تْقُولُوا: "الدِّنْيَا بِشْ تُسْخُنْ" وهَاذَاكَا الِّي يْصِيرْ. <verse eid="LUK 12:55" /><verse number="56" style="v" sid="LUK 12:56" />يَا مُنَافْقِينْ! تَعْرْفُوا حَالِةْ الطَّقْسْ كِي تُخْزْرُوا لِلسْمَاء ولِلْأَرْضْ، وحَالِةْ الزْمَانْ هَاذَا مَا تَعْرْفُوهَاشْ؟<verse eid="LUK 12:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57" />«عْلَاشْ مَا تَعْرْفُوشْ تْمَيْزُوا الحَقْ وَحَّدْكُمْ؟ <verse eid="LUK 12:57" /><verse number="58" style="v" sid="LUK 12:58" />كِي تَبْدَى مَاشِي لِلْمَحْكْمَة مْعَ الِّي شَاكِي بِيكْ، أَعْمِلْ جِهْدِكْ بَاشْ تِتْصَالَحْ مْعَاهْ وإِنْتِ فِي الثْنِيَّة، بَاشْ مَا يْهِزِّكْشْ لِلقَاضِي، والقَاضِي يْسَلْمِكْ لِلْحَاكِمْ والحَاكِمْ يَرْمِيكْ فِي الحَبْسْ. <verse eid="LUK 12:58" /><verse number="59" style="v" sid="LUK 12:59" />آنَا نْقُلِّكْ: مَاكِشْ بِشْ تُخْرُجْ مِنْ غَادِي حَتَّى لِينْ تْخَلِّصْ آخِرْ مِلِّيمْ».<verse eid="LUK 12:59" /></para>
  <chapter eid="LUK 12" />
  <chapter number="13" style="c" sid="LUK 13" />
  <para style="s">تُوبُوا</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1" />وفِي الوَقْتْ هَاذَاكَا، جَاوْ جْمَاعَة لْيَسُوعْ وحْكَاوْلُو عَالجَلِيلِيِّينْ الِّي قْتَلْهُمْ بِيلَاطُسْ، وخَلِّطْ دَمْهُمْ بْدَمْ الذْبَايَحْ مْتَاعْهُمْ. <verse eid="LUK 13:1" /><verse number="2" style="v" sid="LUK 13:2" />جَاوِبْهُمْ يَسُوعْ: «يَاخِي مَاشِي فِي بَالْكُمْ الِّي الجَلِيلِيِّينْ هَاذُوكُمْ صَارِلْهُمْ الِّي صَارْ عْلَى خَاطِرْهُمْ أَشَرْ مِنْ بْقِيِّةْ الجَلِيلِيِّينْ؟ <verse eid="LUK 13:2" /><verse number="3" style="v" sid="LUK 13:3" />آنَا نْقُلْكُمْ: لَا! وإِذَا مَا اتُّوبُوشْ، الكُلْكُمْ بِشْ تِمْشِيوْ لِلْهْلَاكْ كِيفْهُمْ. <verse eid="LUK 13:3" /><verse number="4" style="v" sid="LUK 13:4" />وَلَّا مَاشِي فِي بَالْكُمْ الِّي الثْمُنْطَاشِنْ وَاحِدْ الِّي طَاحْ عْلِيهُمْ البُرْجْ فِي سِلْوَامْ وقْتَلْهُمْ، كَانُوا أَشَرْ مِلِّي يُسْكْنُوا فِي أُورْشَلِيمْ الكُلْ؟ <verse eid="LUK 13:4" /><verse number="5" style="v" sid="LUK 13:5" />نْقُلْكُمْ: لَا! وإِذَا مَا اتُّوبُوشْ، الكُلْكُمْ بِشْ تِمْشِيوْ لِلْهْلَاكْ كِيفْهُمْ».<verse eid="LUK 13:5" /></para>
  <para style="s">مَثَلْ الكَرْمَة الِّي بْلَا غَلَّة</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6" />وعْطَى المَثَلْ هَاذَا: «كَانْ فَمَّة وَاحِدْ عَنْدُو كَرْمَة مَغْرُوسَة فِي سَانْيِةْ العْنِبْ مْتَاعُو، مْشَالْهَا فِي بَالُو بِشْ يَلْقَى فِيهَا غَلَّة، يَاخِي مَا لْقَى فِيهَا شَيْ. <verse eid="LUK 13:6" /><verse number="7" style="v" sid="LUK 13:7" />قَالْ لِلْجَنَّانْ: "تَوَّا ثْلَاثَة سْنِينْ وآنَا كُلْ مَا نْجِي لِلْكَرْمَة هَاذِي نْحِبْ عَالغَلَّة مَا نَلْقَى فِيهَا شَيْ. قُصْهَا! عْلَاشْ مَاخْذَة بْلَاصَة بِالفَارَغْ؟". <verse eid="LUK 13:7" /><verse number="8" style="v" sid="LUK 13:8" />آمَا الجَنَّانْ جَاوْبُو: "يَا سِيدِي خَلِّيهَا تْزِيدْ العَامْ هَاذَا، وتَوْ نِقْلْبِلْهَا التْرَابْ الدَّايِرْ بِيهَا ونْحُطِّلْهَا الغْبَارْ، <verse eid="LUK 13:8" /><verse number="9" style="v" sid="LUK 13:9" />بَالِكْشِي تْجِيبْ غَلَّة العَامْ الجَّايْ، وكَانْ مَا جَابِتْشْ قُصْهَا"».<verse eid="LUK 13:9" /></para>
  <para style="s">يَسُوعْ يِشْفِي مْرَا فِي نْهَارْ سِبْتْ</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10" />وفِي سِبْتْ مِالأَسْبَاتْ، كَانْ يَسُوعْ يْعَلِّمْ فِي وَاحِدْ مِنْ مْعَابِدْ اليْهُودْ. <verse eid="LUK 13:10" /><verse number="11" style="v" sid="LUK 13:11" />وكَانِتْ فَمَّة مْرَا سَاكِنْهَا رُوحْ شِرِّيرْ، مْخُلِّيهَا ثْمُنْطَاشِنْ سْنَة مْرِيضَة وظْهَرْهَا مْقَوِّسْ، مَا تْنَجَّمْشْ تَاقِفْ مِسْتْوِيَّة. <verse eid="LUK 13:11" /><verse number="12" style="v" sid="LUK 13:12" />وكِي شَافْهَا يَسُوعْ عَيْطِلْهَا وقَالِلْهَا: «يَا مْرَا إِنْتِ تْحَرَّرْتْ مِنْ مَرْضِكْ». <verse eid="LUK 13:12" /><verse number="13" style="v" sid="LUK 13:13" />وحَطْ يْدِيهْ عْلِيهَا، وبِالوَقْتْ وِقْفِتْ مِسْتْوِيَّة وبْدَاتْ تْمَجِّدْ فِي اللَّهْ.<verse eid="LUK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14" />آمَا المَسْؤُولْ عَالمَعْبِدْ تْغَشِّشْ عْلَى خَاطِرْ يَسُوعْ شْفَى المْرَا فِي نْهَارْ السِّبْتْ، يَاخِي قَالْ لِلْحَاضْرِينْ: «عَنْدْكُمْ سِتَّة أَيَّامْ تِخْدْمُوا فِيهُمْ، إِيجَاوْ فِيهُمْ وتِشْفَاوْ كِيمَا تْحِبُّو، آمَا نْهَارْ السِّبْتْ لَا». <verse eid="LUK 13:14" /><verse number="15" style="v" sid="LUK 13:15" />يَاخِي جَاوْبُو الرَّبْ يَسُوعْ وقَالْ: «يَا مُنَافْقِينْ: يَاخِي مَا يْحِلِّشْ كُلْ وَاحِدْ فِيكُمْ رْبَاطْ ثُورُو وَلَّا بْهِيمُو فِي نْهَارْ السِّبْتْ ويْخَرْجُو مِالكُورِي ويْهِزْ يْشَرْبُو؟ <verse eid="LUK 13:15" /><verse number="16" style="v" sid="LUK 13:16" />والمْرَا هَاذِي الِّي هِيَّ بِنْتْ إِبْرَاهِيمْ، تَوَّا ثْمَنْطَاشِنْ سْنَة والشِّيطَانْ رَابِطْهَا، يَاخِي مَا تِسْتَاهِلْشْ يِتْحَلْ رْبَاطْهَا فِي نْهَارْ السِّبْتْ؟». <verse eid="LUK 13:16" /><verse number="17" style="v" sid="LUK 13:17" />وكِي قَالِلْهُمْ الكْلَامْ هَاذَا، الِّي عَارْضُوهْ الكُلْ حِشْمُوا عْلَى رْوَاحْهُمْ، والحَاضْرِينْ الكُلْ فَرْحُوا بِالأَعْمَالْ العْظِيمَة الِّي كَانْ يَعْمِلْ فِيهَا.<verse eid="LUK 13:17" /></para>
  <para style="s">لِشْنُوَّة تْشَبَّهْ مَمْلَكْةْ اللَّهْ؟</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18" />وقَالْ يَسُوعْ: «لِشْنُوَّة تْشَبَّهْ مَمْلَكْةْ اللَّهْ؟ وبِشْنُوَّة انَّجِّمْ نْشَبَّهَّا؟ <verse eid="LUK 13:18" /><verse number="19" style="v" sid="LUK 13:19" />هِيَّ تْشَبَّهْ لْكَعْبِة خَرْدِلْ، هَزْهَا رَاجِلْ وزْرَعْهَا فِي جْنِينْتُو، يَاخِي نِبْتِتْ ووَلَّاتْ شَجْرَة كْبِيرَة، وجَاتْ طْيُورْ السْمَاء وعَشْشِتْ فِيهَا».<verse eid="LUK 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20" />وزَادْ قَالْ: «بَاشْ نْشَبَّهْ مَمْلَكْةْ اللَّهْ؟ <verse eid="LUK 13:20" /><verse number="21" style="v" sid="LUK 13:21" />هِيَّ تْشَبَّهْ لِخْمِيرَة هَزِّتْهَا مْرَا وحَطِّتْهَا فِي ثْلَاثَة كِيلَاتْ فَرِينَة حَتَّى لِينْ خِمْرِتْ العْجِينَة الكُلْ».<verse eid="LUK 13:21" /></para>
  <para style="s">أُدْخْلُوا مِالبَابْ الضِّيِّقْ</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22" />وكَانْ يَسُوعْ يْعَلِّمْ فِي النَّاسْ فِي كُلْ مْدِينَة وقَرْيَة يِتْعَدَّى عْلِيهَا وهُوَّ فِي طْرِيقُو لْأُورْشَلِيمْ. <verse eid="LUK 13:22" /><verse number="23" style="v" sid="LUK 13:23" />وسِأْلُو وَاحِدْ: «يَا سِيدْنَا، يَاخِي مَا فَمَّة كَانْ شْوَيَّة مِالنَّاسْ بِشْ يِنْجَاوْ؟». آمَا هُوَّ قَالِلْهُمْ: <verse eid="LUK 13:23" /><verse number="24" style="v" sid="LUK 13:24" />«أَعْمْلُوا مَجْهُودْكُمْ بَاشْ تُدْخْلُوا مِالبَابْ الضِّيِّقْ، عْلَى خَاطِرْ هَانِي نْقُولِلْكُمْ: بَرْشَة بِشْ يْحَاوْلُوا يُدْخْلُوا ومُشْ بِشْ يْنَجْمُوا. <verse eid="LUK 13:24" /><verse number="25" style="v" sid="LUK 13:25" />بَعْدْمَا يْكُونْ مُولَى الدَّارْ قَامْ وسَكِّرْ البَابْ، تَبْدَاوْ إِنْتُومَا وَاقْفِينْ لْبَرَّا، وادُّقُّوا عَالبَابْ وتْقُولُوا: "يَا سِيدْنَا حِلِّلْنَا!" يْجَاوِبْكُمْ: "آنَا مَا نَعْرِفْشْ إِنْتُومَا مْنِينْ". <verse eid="LUK 13:25" /><verse number="26" style="v" sid="LUK 13:26" />وَقْتْهَا تْقُولُوا: "كْلِينَا وشْرَبْنَا مْعَاكْ، وإِنْتِ عَلَّمْتْ فِي شْوَارَعْنَا". <verse eid="LUK 13:26" /><verse number="27" style="v" sid="LUK 13:27" />آمَا هُوَّ بِشْ يْقُولِلْكُمْ: "آنَا مَا نَعْرِفْشْ إِنْتُومَا مْنِينْ! إِبْعْدُوا عْلِيَّا يَا أَشْرَارْ".<verse eid="LUK 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 13:28" />«غَادِي بِشْ يْكُونْ البْكَاء والنْدَمْ، كِي تْشُوفُوا إِبْرَاهِيمْ وإِسْحَاقْ ويَعْقُوبْ والأَنْبِيَاءْ الكُلْ فِي مَمْلَكْةْ اللَّهْ، وإِنْتُومَا مْطَيْشِينْ لْبَرَّا. <verse eid="LUK 13:28" /><verse number="29" style="v" sid="LUK 13:29" />وبِشْ يْجِيوْ نَاسْ مِالشَّرْقْ ومِالغَرْبْ ومِالشَّمَالْ ومِالجَنُوبْ ويُقْعْدُوا ويَاكْلُوا فِي مَمْلَكْةْ اللَّهْ. <verse eid="LUK 13:29" /><verse number="30" style="v" sid="LUK 13:30" />والإِخْرَانِينْ يْوَلِّيوْ هُومَا الأُولَانِينْ، والأُولَانِينْ يْوَلِّيوْ هُومَا الإِخْرَانِينْ».<verse eid="LUK 13:30" /></para>
  <para style="s">يَسُوعْ حْزِينْ عْلَى أُورْشَلِيمْ</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31" />وفِي الوَقْتْ هَاذَاكَا، جَاوَهْ جْمَاعَة مِالفِرِّيسِيِّينْ وقَالُولُو: «إِمْشِي مِنْ هْنَا وأُهْرُبْ، عْلَى خَاطِرْ هِيرُودُسْ يْحِبْ يُقْتْلِكْ». <verse eid="LUK 13:31" /><verse number="32" style="v" sid="LUK 13:32" />يَاخِي قَالِلْهُمْ: «إِمْشِيوْ قُولُوا لْهَاكْ الثَّعْلِبْ: "هَانِي نْخَرِّجْ فِي الشْوَاطِنْ ونِشْفِي فِي المُرْضَى اليُومْ وغُدْوَة، وفِي النْهَارْ الثَّالِثْ نْكَمِّلْ كُلْ شَيْ". <verse eid="LUK 13:32" /><verse number="33" style="v" sid="LUK 13:33" />آمَا لَازِمْنِي نْكَمِّلْ نِمْشِي فِي طْرِيقِي اليُومْ وغُدْوَة وبَعْدْ غُدْوَة، عْلَى خَاطِرْ مَا فَمَّاشْ نَبِيْ يْمُوتْ لْبَرَّا مِنْ أُورْشَلِيمْ!<verse eid="LUK 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34" />«يَا أُورْشَلِيمْ، يَا أُورْشَلِيمْ، يَلِّي تُقْتُلْ الأَنْبِيَاءْ وتُرْجُمْ الِّي يِتْبَعْثُولِكْ، قَدَّاشْ مِنْ مَرَّة حَبِّيتْ نْلِمْ أَوْلَادِكْ، كِيفْ مَا تْلِمْ الدْجَاجَة فْلَالِسْهَا تَحْتْ جْنَاحَاتْهَا. آمَا إِنْتُومَا مَا حَبِّيتُوشْ. <verse eid="LUK 13:34" /><verse number="35" style="v" sid="LUK 13:35" />هَايْ دَارْكُمْ بِشْ تَبْقَالْكُمْ خِرْبَة! ونْقُلْكُمْ الحَقْ: مَا عَادِشْ بِشْ تْرَاوْنِي حَتَّى لِينْ يْجِي الوَقْتْ الِّي تْقُولُوا فِيهْ "مُبَارَكْ الِّي جَايْ بْإِسْمْ الرَّبْ"».<verse eid="LUK 13:35" /></para>
  <chapter eid="LUK 13" />
  <chapter number="14" style="c" sid="LUK 14" />
  <para style="s">يَسُوعْ يِشْفِي فِي نْهَارْ سِبْتْ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1" />وفِي نْهَارْ السِّبْتْ، دْخَلْ لْدَارْ وَاحِدْ مِنْ كْبَارْ الفِرِّيسِيِّينْ بَاشْ يَاكِلْ عَنْدُو، والحَاضْرِينْ كَانُوا يِتْرَصْدُوا فِيهْ. <verse eid="LUK 14:1" /><verse number="2" style="v" sid="LUK 14:2" />وكَانْ قُدَّامُو وَاحِدْ مْرِيضْ بِالبُومِينَة. <verse eid="LUK 14:2" /><verse number="3" style="v" sid="LUK 14:3" />يَاخِي يَسُوعْ سْإِلْ عُلَمَاءْ الشَّرِيعَة والفِرِّيسِيِّينْ: «زَعْمَة حْلَالْ يْصِيرْ الشْفَى نْهَارْ السِّبْتْ وَلَّا لَا؟». <verse eid="LUK 14:3" /><verse number="4" style="v" sid="LUK 14:4" />آمَا هُومَا قَعْدُوا سَاكْتِينْ، يَاخِي يَسُوعْ هَزْ الرَّاجِلْ وشْفَاهْ وبَعْثُو يْرَوَّحْ. <verse eid="LUK 14:4" /><verse number="5" style="v" sid="LUK 14:5" />ومْبَعِّدْ عَاوِدْ سْإِلْهُمْ: «شْكُونْ مِنْكُمْ كِي يْطِيحْ وِلْدُو وَلَّا ثُورُو فِي بِيرْ نْهَارْ السِّبْتْ، مَا يْخَرْجُوشْ بِالوَقْتْ؟». <verse eid="LUK 14:5" /><verse number="6" style="v" sid="LUK 14:6" />ومَا نَجْمُوشْ يْجَاوْبُوهْ عَالسُّؤَالْ هَاذَا.<verse eid="LUK 14:6" /></para>
  <para style="s">التَّوَاضُعْ</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7" />وكِي لَاحِظْ الِّي المِسْتَدْعِينْ قَاعْدِينْ يَخْتَارُوا لِرْوَاحْهُمْ فِي البْلَايِصْ الأُولَى، عْطَاهُمْ المَثَلْ هَاذَا: <verse eid="LUK 14:7" /><verse number="8" style="v" sid="LUK 14:8" />«وَقْتِلِّي يِسْتَدْعَاكْ وَاحِدْ لِلْعْشَاء فِي عِرْسْ، مَا تُقْعُدْشْ فِي البْلَاصَة الأُولَى، عْلَى خَاطِرْ مُمْكِنْ يْكُونْ مِسْتَدْعِي شْكُونْ أَهَمْ مِنِّكْ، <verse eid="LUK 14:8" /><verse number="9" style="v" sid="LUK 14:9" />ويْجِي الِّي اسْتَدْعَاكُمْ ويْقُلِّكْ: "خَلِّي البْلَاصَة لِلرَّاجِلْ هَاذَا". وَقْتْهَا تْقُومْ وإِنْتِ حَاشِمْ، وتُقْعُدْ فِي البْلَاصَة الإِخْرَانِيَّة. <verse eid="LUK 14:9" /><verse number="10" style="v" sid="LUK 14:10" />آمَا وَقْتِلِّي يِسْتَدْعَاوِكْ، إِمْشِي وأُقْعُدْ فِي إِخِّرْ بْلَاصَة، بَاشْ وَقْتِلِّي يْجِي الِّي اسْتَدْعَاكْ ويْقُلِّكْ: "يَا صَاحْبِي إِيجَا وأُقْعُدْ لْقُدَّامْ"، يْزِيدْ قَدْرِكْ قُدَّامْ الضْيُوفْ المَوْجُودِينْ. <verse eid="LUK 14:10" /><verse number="11" style="v" sid="LUK 14:11" />عْلَى خَاطِرْ، الِّي يْعَلِّي رُوحُو يَهْبِطْ، ولِّي يْطَيَّحْ مِنْ رُوحُو يَعْلَى».<verse eid="LUK 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12" />وزَادْ قَالْ لِلِّي اسْتَدْعَاهْ: «وَقْتِلِّي تَعْمِلْ فْطُورْ وَلَّا عْشَاء مَا تِسْتَدْعَاشْ لَا صْحَابِكْ ولَا خْوَاتِكْ ولَا الِّي يُقْرْبُولِكْ ولَا جِيرَانِكْ الغُنْيَا، بَاشْ مَا يِسْتَدْعَاوْكِشْ هُومَا زَادَا، وهَكَّا تِتْسَمَّى خْذِيتْ أَجْرِكْ. <verse eid="LUK 14:12" /><verse number="13" style="v" sid="LUK 14:13" />آمَا وَقْتِلِّي تَعْمِلْ عْشَاء، اسْتَدْعَى الفْقَارَى والمُعَاقِينْ والعَايْبِينْ والعِمْيَانْ. <verse eid="LUK 14:13" /><verse number="14" style="v" sid="LUK 14:14" />ووَقْتْهَا صَحَّة لِيكْ، عْلَى خَاطِرْ هَاذُمْ مَا عَنْدْهُمْشْ بَاشْ يْرَجْعُولِكْ الأَجْرْ، وهَكَّا تَاخِذْ أَجْرِكْ وَقْتْ قْيَامِةْ الصَّالْحِينْ».<verse eid="LUK 14:14" /></para>
  <para style="s">مَثَلْ العْشَاء الكْبِيرْ</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15" />وَقْتِلِّي سْمَعْ وَاحِدْ مِالمِسْتَدْعِينْ الكْلَامْ هَاذَا قَالْ: «صَحَّة لِلِّي بِشْ يَاكِلْ فِي مَمْلَكْةْ اللَّهْ». <verse eid="LUK 14:15" /><verse number="16" style="v" sid="LUK 14:16" />جَاوْبُو يَسُوعْ: «فَمَّة رَاجِلْ عْمَلْ عْشَاء كْبِيرْ، واسْتَدْعَالُو بَرْشَة نَاسْ. <verse eid="LUK 14:16" /><verse number="17" style="v" sid="LUK 14:17" />وفِي وَقْتْ العْشَاء بْعَثْ خْدِيمُو بَاشْ يْقُولْ لِلْمِسْتَدْعِينْ: "إِيجَاوْ رَاوْ كُلْ شَيْ حَاضِرْ". <verse eid="LUK 14:17" /><verse number="18" style="v" sid="LUK 14:18" />يَاخِي بْدَاوْ الكُلْ يِتْسَبْبُوا. وقَالْ الأُوِّلْ: "آنَا شْرِيتْ سَانْيَة ولَازِمْنِي نِمْشِي نْشُوفْهَا، سَامَحْنِي مَا انَّجَّمْشْ نْجِي". <verse eid="LUK 14:18" /><verse number="19" style="v" sid="LUK 14:19" />ووَاحِدْ قَالْ: "آنَا شْرِيتْ خَمْسَة زْوَازْ بْڨَرْ، ومَاشِي تَوَّا بَاشْ نْجَرَّبْهُمْ. سَامَحْنِي مَا انَّجَّمْشْ نْجِي". <verse eid="LUK 14:19" /><verse number="20" style="v" sid="LUK 14:20" />ووَاحِدْ آخِرْ قَالْ: "مِزِّلْتْ كِي عَرِّسْتْ، مَا انَّجَّمْشْ نْجِي".<verse eid="LUK 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 14:21" />«ورْجَعْ الخْدِيمْ لْسِيدُو وحْكَالُو عَلِّي صَارْ. وَقْتْهَا تْغَشِّشْ مُولَى الدَّارْ وقَالْ لِخْدِيمُو: "أُخْرُجْ فِيسَعْ لِشْوَارَعْ المْدِينَة وزْنَاقِيهَا وجِيبْ الفْقَارَى والمُعَاقِينْ والعَايْبِينْ والعِمْيَانْ لَهْنَا". <verse eid="LUK 14:21" /><verse number="22" style="v" sid="LUK 14:22" />رْجَعْ الخْدِيمْ وقَالْ: "يَا سِيدِي عْمَلْتْ الِّي قُتْلِي عْلِيهْ ومَزَّالِتْ فَمَّة بْلَايِصْ فَارْغَة". <verse eid="LUK 14:22" /><verse number="23" style="v" sid="LUK 14:23" />يَاخِي قَالُّو سِيدُو: "أُخْرُجْ لِلْكَيَّاسَاتْ والثْنَايَا، وشِدْ صْحِيحْ فِي النَّاسْ بَاشْ يُدْخْلُوا، حَتَّى لِينْ تِتْعَبَّى دَارِي. <verse eid="LUK 14:23" /><verse number="24" style="v" sid="LUK 14:24" />رَانِي نْأَكْدِلْكُمْ، وَلَا وَاحِدْ مِنْ هَاكْ الِّي اسْتَدْعِيتْهُمْ بِشْ يْذُوقْ مِنْ عْشَايَا"».<verse eid="LUK 14:24" /></para>
  <para style="s">إِحْسْبُوا التَّكْلْفَة</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25" />وكَانْ فَمَّة بَرْشَة نَاسْ مَاشِينْ مْعَ يَسُوعْ، يَاخِي تْلَفْتِلْهُمْ وقَالْ: <verse eid="LUK 14:25" /><verse number="26" style="v" sid="LUK 14:26" />«كَانْ يْجِينِي وَاحِدْ، ومَا يْحِبْنِيشْ أَكْثِرْ مِنْ بُوهْ وأُمُّو ومَرْتُو ووْلَادُو وأَخْوْتُو وخْوَاتُو وحَتَّى أَكْثِرْ مِنْ رُوحُو، مَا يْنَجَّمْشْ يْكُونْ تِلْمِيذِي. <verse eid="LUK 14:26" /><verse number="27" style="v" sid="LUK 14:27" />ولِّي مُشْ مُسْتْعَدْ يْقَاسِي العْذَابْ والمُوتْ مْعَايَا ويْتَبَّعْنِي، مَا يْنَجَّمْشْ يْكُونْ تِلْمِيذِي.<verse eid="LUK 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28" />«شْكُونْ فِيكُمْ كِي يْحِبْ يِبْنِي بُرْجْ، مَا يُقْعُدْشْ فِي الأُوِّلْ ويِحْسِبْ قَدَّاشْ يِتْكَلَّفْلُو، ويْشُوفْ إِذَا الفْلُوسْ الِّي عَنْدُو تِكْفِيهْ بَاشْ يْكَمِّلْ وَلَّا لَا؟ <verse eid="LUK 14:28" /><verse number="29" style="v" sid="LUK 14:29" />بَاشْ مَا يْحُطِّشْ السَّاسْ ومْبَعِّدْ مَا يْنَجَّمْشْ يْكَمِّلْ، والنَّاسْ يِضْحْكُوا عْلِيهْ <verse eid="LUK 14:29" /><verse number="30" style="v" sid="LUK 14:30" />ويْقُولُوا: "الرَّاجِلْ هَاذَا بْدَا يِبْنِي ومَا نَجَّمْشْ يْكَمِّلْ!".<verse eid="LUK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31" />«وشْكُونْ المَلِكْ الِّي مَاشِي يْحَارِبْ فِي مَلِكْ آخِرْ، ومَا يُقْعُدْشْ قْبَلْ ويِحْسِبْهَا، بَاشْ يَعْرِفْ إِذَا كَانْ يْنَجِّمْ يْحَارِبْ بْـ10 000 عَسْكْرِي الِّي جَايُو بْـ20 000؟ <verse eid="LUK 14:31" /><verse number="32" style="v" sid="LUK 14:32" />مَا كَانِشْ، يَبْعَثْ مَرْسُولْ مَادَامْ العْدُو مَزَّالْ بْعِيدْ، ويِسْإِلْ كِيفَاشْ يْنَجِّمْ يْرَجَّعْ السَّلَامْ بِينَاتْهُمْ. <verse eid="LUK 14:32" /><verse number="33" style="v" sid="LUK 14:33" />وإِنْتُومَا زَادَا، أَيْ وَاحِدْ فِيكُمْ مَا يْسَلَّمْشْ فِلِّي يِمْلْكُو الكُلْ، مَا يْنَجَّمْشْ يْكُونْ تِلْمِيذِي.<verse eid="LUK 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34" />«المِلْحْ بَاهِي، آمَا إِذَا كَانْ ضَيَّعْ مْلُوحِيتُو، كِيفَاشْ نْرَجْعُولُو طَعْمُو؟ <verse eid="LUK 14:34" /><verse number="35" style="v" sid="LUK 14:35" />لَا عَادْ يُصْلُحْ لَا لِلتْرَابْ ولَا لِلْغْبَارْ، ويِتْلَوَّحْ لْبَرَّا. الِّي عَنْدُو وِذْنِينْ تِسْمَعْ، خَلِّيهْ يِسْمَعْ!».<verse eid="LUK 14:35" /></para>
  <chapter eid="LUK 14" />
  <chapter number="15" style="c" sid="LUK 15" />
  <para style="s">مَثَلْ العَلُّوشْ الضَّايَعْ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1" />كَانُوا المَكَّاسَة الكُلْ والمُذْنْبِينْ يِتْلَمُّوا بْيَسُوعْ بَاشْ يِسْمْعُوهْ. <verse eid="LUK 15:1" /><verse number="2" style="v" sid="LUK 15:2" />يَاخِي بْدَاوْ الفِرِّيسِيِّينْ وعُلَمَاءْ الشَّرِيعَة يِتْشَكَّاوْ ويْقُولُوا: «الرَّاجِلْ هَاذَا يِفْرَحْ بِالمُذْنْبِينْ ويَاكِلْ مْعَاهُمْ». <verse eid="LUK 15:2" /><verse number="3" style="v" sid="LUK 15:3" />وَلَّى يَسُوعْ عْطَاهُمْ المَثَلْ هَاذَا وقَالْ: <verse eid="LUK 15:3" /><verse number="4" style="v" sid="LUK 15:4" />«شْكُونْ مِنْكُمْ عَنْدُو 100 عَلُّوشْ وضَيَّعْ وَاحِدْ مِنْهُمْ، مَا يْخَلِّيشْ 99 فِي الخْلَاء ويِمْشِي يْلَوِّجْ عَالعَلُّوشْ الضَّايَعْ حَتَّى لِينْ يَلْقَاهْ؟ <verse eid="LUK 15:4" /><verse number="5" style="v" sid="LUK 15:5" />وكِي يَلْقَاهْ، يْهِزُّو عْلَى كْتَافُو وهُوَّ فَرْحَانْ. <verse eid="LUK 15:5" /><verse number="6" style="v" sid="LUK 15:6" />وكِي يِرْجَعْ لْدَارُو يِسْتَدْعَى صْحَابُو وجِيرَانُو ويْقُولِلْهُمْ: "إِفْرْحُوا مْعَايَا عْلَى خَاطِرْنِي لْقِيتْ عَلُّوشِي الضَّايَعْ!". <verse eid="LUK 15:6" /><verse number="7" style="v" sid="LUK 15:7" />نْقُولِلْكُمْ: هَكَّا تْكُونْ الفَرْحَة فِي السْمَاء بْمُذْنِبْ وَاحِدْ يْتُوبْ، أَكْثِرْ مِنْ 99 صَالَحْ مَا يَحْتَاجُوشْ بَاشْ يْتُوبُوا.<verse eid="LUK 15:7" /></para>
  <para style="s">مَثَلْ البْيَاسَة الفُضَّة الضَّايْعَة</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8" />«وكَانْ جَاتْ فَمَّة مْرَا عَنْدْهَا عَشْرَة بْيَاسَاتْ فُضَّة، وضَيْعِتْ مِنْهُمْ بْيَاسَة، مُشْ تْشَعِّلْ فْنَارَة وتُكْنُسْ الدَّارْ، وتْلَوِّجْ عْلِيهَا مْلِيحْ حَتَّى لِينْ تَلْقَاهَا؟ <verse eid="LUK 15:8" /><verse number="9" style="v" sid="LUK 15:9" />وكِي تَلْقَاهَا، تِسْتَدْعَى صَاحْبَاتْهَا وجِيرَانْهَا وتْقُولِلْهُمْ: "إِفْرْحُوا مْعَايَا عْلَى خَاطِرْنِي لْقِيتْ بْيَاسْتِي الضَّايْعَة". <verse eid="LUK 15:9" /><verse number="10" style="v" sid="LUK 15:10" />نْقُولِلْكُمْ: هَكَّا تْكُونْ الفَرْحَة بِينْ مْلَايِكْةْ اللَّهْ بْمُذْنِبْ وَاحِدْ يْتُوبْ».<verse eid="LUK 15:10" /></para>
  <para style="s">مَثَلْ الزُّوزْ أَخْوَة</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11" />وقَالْ يَسُوعْ: «كَانْ فَمَّة رَاجِلْ عَنْدُو زُوزْ وْلَادْ، <verse eid="LUK 15:11" /><verse number="12" style="v" sid="LUK 15:12" />والصْغِيرْ فِيهُمْ قَالُّو: "يَا بَابَا أَعْطِينِي بَايِي مِالوَرْثَة!". يَاخِي بُوهُمْ قْسَمِّلْهُمْ كُلْ مَا يِمْلِكْ بِينَاتْهُمْ. <verse eid="LUK 15:12" /><verse number="13" style="v" sid="LUK 15:13" />وبَعْدْ أَيَّامَاتْ، وِلْدُو الصْغِيرْ لَمْ الِّي يِمْلْكُو الكُلْ، ومْشَى لِبْلَادْ بْعِيدَة. وغَادِي بَذِّرْ فْلُوسُو الكُلْ فِي الطِّيشْ. <verse eid="LUK 15:13" /><verse number="14" style="v" sid="LUK 15:14" />وكِي صْرَفْ الِّي عَنْدُو الكُلْ، جَاتْ مَجَاعَة كْبِيرَة فِي البْلَادْ هَاذِيكَا، وبْدَا يِحْتَاجْ. <verse eid="LUK 15:14" /><verse number="15" style="v" sid="LUK 15:15" />رَصَّاتْلُو مْشَى يِخْدِمْ عَنْدْ وَاحِدْ مِنْ إِمَّالِي البْلَادْ هَاذِيكَا، يَاخِي بَعْثُو لِلسْوَانِي مْتَاعُو بَاشْ يَسْرَحْلُو بِالحْلَالِفْ. <verse eid="LUK 15:15" /><verse number="16" style="v" sid="LUK 15:16" />وكَانْ يِتْمَنَّى يْعَبِّي كِرْشُو بِالخَرُّوبْ الِّي كَانُوا يَاكْلُوا فِيهْ الحْلَالِفْ، آمَا حَدْ مَا عْطَاهْ.<verse eid="LUK 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 15:17" />«يَاخِي رْجَعْلُو شَاهِدْ لِعْقَلْ وقَالْ: "قَدَّاشْ مِنْ خَدَّامْ عَنْدْ بَابَا عَنْدُو المَاكْلَة بِالفَاضِلْ، وآنَا هُونِي مِيِّتْ بِالشَّرْ. <verse eid="LUK 15:17" /><verse number="18" style="v" sid="LUK 15:18" />تَوَّا نْقُومْ ونِرْجَعْ لْبَابَا ونْقُلُّو: يَا بَابَا، آنَا غْلُطْتْ فِي حَقْ اللَّهْ وفِي حَقِّكْ، <verse eid="LUK 15:18" /><verse number="19" style="v" sid="LUK 15:19" />ومَا نِسْتَاهِلْشْ نِتْسَمَّى وِلْدِكْ، إِحْسِبْنِي كِيمَا وَاحِدْ مِالخَدَّامَة مْتَاعِكْ".<verse eid="LUK 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 15:20" />«وقَامْ ورْجَعْ لْبُوهْ. وهُوَّ جَايْ مِنْ بْعِيدْ شَافُو بُوهْ، يَاخِي حَنْ عْلِيهْ وجْرَالُو وعَنْقُو وبَاسُو. <verse eid="LUK 15:20" /><verse number="21" style="v" sid="LUK 15:21" />وقَالْ الوْلِدْ لْبُوهْ: "يَا بَابَا، آنَا غْلُطْتْ فِي حَقْ اللَّهْ وفِي حَقِّكْ ومَا نِسْتَاهِلْشْ نِتْسَمَّى وِلْدِكْ". <verse eid="LUK 15:21" /><verse number="22" style="v" sid="LUK 15:22" />آمَا البُو قَالْ لْخَدَّامْتُو: "فِيسَعْ جِيبُولُو أَحْسِنْ لِبْسَة ولَبْسُوهَالُو، وحُطُّولُو خَاتِمْ فِي صُبْعُو وصَبَّاطْ فِي سَاقِيهْ. <verse eid="LUK 15:22" /><verse number="23" style="v" sid="LUK 15:23" />وجِيبُوا العْجِلْ السْمِينْ واذْبْحُوهْ وخَلِّينَا نَاكْلُوا ونِفْرْحُوا. <verse eid="LUK 15:23" /><verse number="24" style="v" sid="LUK 15:24" />رَاهُو وِلْدِي هَاذَا كَانْ مِيِّتْ وحْيَى وكَانْ ضَايَعْ ولْقِيتُو". وهَكَّا بْدَاوْ الحَفْلَة.<verse eid="LUK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25" />«ووِلْدُو الكْبِيرْ كَانْ فِي السَّانْيَة، وكِي جَاء وقْرُبْ مِالدَّارْ، سْمَعْ صُوتْ الغْنَاء والشْطِيحْ. <verse eid="LUK 15:25" /><verse number="26" style="v" sid="LUK 15:26" />يَاخِي عَيِّطْ لْوَاحِدْ مِالخَدَّامَة، وسِأْلُو عَلِّي قَاعِدْ يْصِيرْ. <verse eid="LUK 15:26" /><verse number="27" style="v" sid="LUK 15:27" />جَاوْبُو الخَدَّامْ: "خُوكْ رْجَعْ، وبُوكْ ذْبَحْلُو العْجِلْ السْمِينْ عْلَى خَاطْرُو رْجَعْلُو لَابَاسْ". <verse eid="LUK 15:27" /><verse number="28" style="v" sid="LUK 15:28" />يَاخِي تْغَشِّشْ ومَا حَبِّشْ يُدْخُلْ. وَلَّى بُوهْ خْرَجْلُو وبْقَى يِتْشَحِّتْ فِيهْ. <verse eid="LUK 15:28" /><verse number="29" style="v" sid="LUK 15:29" />آمَا هُوَّ قَالُّو: "آنَا نِخْدِمْ فِيكْ السْنِينْ هَاذِي الكُلْ، وعُمْرِي مَا طَيَّحْتْلِكْ كِلْمْتِكْ، وإِنْتِ وَلَا مَرَّة عْطِيتْنِي حَتَّى جَرْدْ بِرْشْنِي بَاشْ نِفْرَحْ بِيهْ مْعَ صْحَابِي. <verse eid="LUK 15:29" /><verse number="30" style="v" sid="LUK 15:30" />آمَا كِي رْجَعْ وِلْدِكْ هَاذَا، الِّي كْلَالِكْ رِزْقِكْ مْعَ النْسَاء الفَاسْدِينْ، ذْبَحْتْلُو العْجِلْ السْمِينْ".<verse eid="LUK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 15:31" />«قَالُّو بُوهْ: "يَا وْلِيدِي إِنْتِ دِيمَا مْعَايَا، ولِّي نِمْلْكُو الكُلْ هُوَّ لِيكْ. <verse eid="LUK 15:31" /><verse number="32" style="v" sid="LUK 15:32" />آمَا كَانْ لَازِمْنَا نِفْرْحُوا ونَعْمْلُوا حَفْلَة، عْلَى خَاطِرْ خُوكْ هَاذَا كَانْ مِيِّتْ وحْيَى، وكَانْ ضَايَعْ ولْقِينَاهْ"».<verse eid="LUK 15:32" /></para>
  <chapter eid="LUK 15" />
  <chapter number="16" style="c" sid="LUK 16" />
  <para style="s">مَثَلْ المَسْؤُولْ الِّي مَاهُوشْ أَمِينْ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1" />وزَادْ قَالْ لِتْلَامِذْتُو: «كَانْ فَمَّة رَاجِلْ غْنِيْ عَنْدُو وَاحِدْ مَسْؤُولْ عْلَى رِزْقُو، سْمَعْ بِيهْ قَاعِدْ يْبَذَّرْلُو فِي فْلُوسُو. <verse eid="LUK 16:1" /><verse number="2" style="v" sid="LUK 16:2" />يَاخِي عَيِّطْلُو وقَالُّو: "شْنُوَّة الِّي قَاعِدْ نِسْمَعْ فِيهْ عْلِيكْ؟ أَعْطِي حْسَابْ عَلِّي صْرَفْتُو، عْلَى خَاطِرْ مِاليُومْ مَا عَادِشْ بِشْ تْكُونْ مَسْؤُولْ عْلَى رِزْقِي". <verse eid="LUK 16:2" /><verse number="3" style="v" sid="LUK 16:3" />يَاخِي قَالْ بِينُو وبِينْ رُوحُو: "سِيدِي بِشْ يْطَرِّدْنِي مِنْ خِدْمْتِي، آشْ بِشْ نَعْمِلْ؟ آنَا مَا عَنْدِيشْ جِهْدْ لِلْفْلَاحَة ونِحْشِمْ بَاشْ نْمِدْ يِدِّي لِلطُّلْبَة. <verse eid="LUK 16:3" /><verse number="4" style="v" sid="LUK 16:4" />عْرَفْتْ آشْ بِشْ نَعْمِلْ، بَاشْ حَتَّى كَانْ نَحَّالِي خِدْمْتِي، النَّاسْ يِقْبْلُونِي فِي دْيَارْهُمْ".<verse eid="LUK 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5" />«واسْتَدْعَى الِّي كَانْ سِيدُو يْسَالْهُمْ وَاحِدْ وَاحِدْ. وسْإِلْ الأُوِّلْ: "قَدَّاشْ سِيدِي يْسَالِكْ؟". <verse eid="LUK 16:5" /><verse number="6" style="v" sid="LUK 16:6" />قَالُّو: "100 بِرْمِيلْ زِيتْ زِيتُونَة". يَاخِي قَالُّو: "شِدْ كِمْبْيَالْتِكْ وأُقْعُدْ فِيسَعْ وإِكْتِبْ 50". <verse eid="LUK 16:6" /><verse number="7" style="v" sid="LUK 16:7" />وقَالْ لْوَاحِدْ آخِرْ: "وإِنْتِ فِي قَدَّاشْ مُسَالْ؟". جَاوْبُو: "100 شْكَارَة قَمْحْ". يَاخِي قَالُّو: "شِدْ كِمْبْيَالْتِكْ وإِكْتِبْ 80".<verse eid="LUK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 16:8" />«والرَّاجِلْ مْدَحْ المَسْؤُولْ الِّي مَاهُوشْ أَمِينْ عْلَى خَاطْرُو تْصَرِّفْ بِذْكَاء. رَاهُو وْلَادْ العَالِمْ هَاذَا عَنْدْهُمْ حِكْمَة أَكْثِرْ مِنْ وْلَادْ النُّورْ فِي مُعَامْلَاتْهُمْ مْعَ بْعَضْهُمْ. <verse eid="LUK 16:8" /><verse number="9" style="v" sid="LUK 16:9" />وآنَا نْقُولِلْكُمْ: أَعْمْلُوا اصْحَابْ بِمَالْ الدِّنْيَا هَاذِي، بَاشْ نْهَارِةْ الِّي يُوفَى عْلِيكُمْ، يِقْبْلُوكُمْ فِي الدْيَّارْ الأَبَدِيَّة. <verse eid="LUK 16:9" /><verse number="10" style="v" sid="LUK 16:10" />الأَمِينْ فِي الأُمُورْ البْسِيطَة، أَمِينْ زَادَا فِي الأُمُورْ الكْبِيرَة. ولِّي مُشْ أَمِينْ فِي الأُمُورْ البْسِيطَة، مُشْ أَمِينْ زَادَا فِي الأُمُورْ الكْبِيرَة. <verse eid="LUK 16:10" /><verse number="11" style="v" sid="LUK 16:11" />إِذَا مَا تْكُونُوشْ أُمَنَاءْ عَالْمَالْ البَاطِلْ، شْكُونْ بِشْ يْأَمِّنْكُمْ عْلَى مَالْ الحَقْ؟ <verse eid="LUK 16:11" /><verse number="12" style="v" sid="LUK 16:12" />وإِذَا مَا تْكُونُوشْ أُمَنَاءْ عْلَى حَاجِةْ غِيرْكُمْ، شْكُونْ بِشْ يَعْطِيكُمْ حَاجِتْكُمْ؟ <verse eid="LUK 16:12" /><verse number="13" style="v" sid="LUK 16:13" />حَتَّى خْدِيمْ مَا يْنَجِّمْ يِخْدِمْ زُوزْ أَسْيَادْ، عْلَى خَاطِرْ يَا إِمَّا بِشْ يِكْرَهْ وَاحِدْ ويْحِبْ الآخِرْ، وَلَّا بِشْ يْتَبَّعْ وَاحِدْ ويَحْقِرْ الآخِرْ. مَا تْنَجْمُوشْ تِخْدْمُوا اللَّهْ والفْلُوسْ مْعَ بْعَضْهُمْ».<verse eid="LUK 16:13" /></para>
  <para style="s">الشَّرِيعَة ومَمْلَكْةْ اللَّهْ</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14" />والفِرِّيسِيِّينْ كَانُوا يِسْمْعُوا فِي هَاذَا الكُلْ ويِتْمَسْخْرُوا عْلِيهْ، عْلَى خَاطِرْهُمْ كَانُوا يْحِبُّوا الفْلُوسْ. <verse eid="LUK 16:14" /><verse number="15" style="v" sid="LUK 16:15" />يَاخِي قَالِلْهُمْ يَسُوعْ: «تْحِبُّوا تُظْهْرُوا الِّي إِنْتُومَا صَالْحِينْ قُدَّامْ النَّاسْ، آمَا اللَّهْ يَعْرِفْ قْلُوبْكُمْ. رَاهُو الِّي يَعْتَبْرُوهْ النَّاسْ عْظِيمْ، هُوَّ مَكْرُوهْ عَنْدْ اللَّهْ.<verse eid="LUK 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16" />«الشَّرِيعَة وكْتُبْ الأَنْبِيَاءْ بْقَاوْ لِينْ جَاء يُوحَنَّا. وبَعْدْهَا بْدَاتْ البْشَارَة بْمَمْلَكْةْ اللَّهْ، وكُلْ وَاحِدْ يَشْقَى بَاشْ يُدْخْلِلْهَا. <verse eid="LUK 16:16" /><verse number="17" style="v" sid="LUK 16:17" />آمَا رَاهُو أَسْهِلْ إِنُّو السْمَاء والأَرْضْ يِتْنَحَّاوْ مِنْ إِنُّو حَرْفْ وَاحِدْ مِالشَّرِيعَة يْطِيحْ».<verse eid="LUK 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18" />«الِّي يْطَلَّقْ مَرْتُو، ويْعَرِّسْ بِمْرَا أُخْرَى يَزْنَى، ولِّي يْعَرِّسْ بِمْرَا مْطَلْقَة يَزْنَى.<verse eid="LUK 16:18" /></para>
  <para style="s">الغْنِيْ ولِعَازِرْ</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19" />«كَانْ فَمَّة رَاجِلْ غْنِيْ، يِلْبِسْ الغَالِي والمِذْخِمْ، وكُلْ يُومْ عَايِشْ فِي نَعِيمْ. <verse eid="LUK 16:19" /><verse number="20" style="v" sid="LUK 16:20" />وكَانْ فَمَّة رَاجِلْ مِسْكِينْ إِسْمُو لِعَازِرْ، مَحْطُوطْ قُدَّامْ بَابْ دَارُو، وبَدْنُو لْكُلُّو دِمَّالْ. <verse eid="LUK 16:20" /><verse number="21" style="v" sid="LUK 16:21" />وكَانْ يِتْشَهَّى إِنُّو يِشْبَعْ مِالفِتْفَاتْ الطَّايَحْ مِنْ طَاوِلْةْ الغْنِيْ، وزِيدْ عْلَى هَاذَا حَتَّى الكْلَابْ كَانِتْ تْجِي وتَلْحِسْ الدِّمَّالْ مْتَاعُو.<verse eid="LUK 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22" />«ومَاتْ المِسْكِينْ وهَزِّتُّو المْلَايْكَة بَحْذَا إِبْرَاهِيمْ، والغْنِيْ زَادَا مَاتْ وتِدْفِنْ. <verse eid="LUK 16:22" /><verse number="23" style="v" sid="LUK 16:23" />وهُوَّ قَاعِدْ يِتْعَذَّبْ فِي الهَاوْيَة، هَزْ الغْنِيْ عِينِيهْ، يَاخِي شَافْ إِبْرَاهِيمْ مِنْ بْعِيدْ ولِعَازِرْ بَحْذَاهْ. <verse eid="LUK 16:23" /><verse number="24" style="v" sid="LUK 16:24" />يَاخِي عَيِّطْ: "يَا بَابَا إِبْرَاهِيمْ! أَرْحَمْنِي، وأَبْعَثْلِي لِعَازِرْ خَلِّيهْ يْغَطِّسْ طَرْتُوشِةْ صُبْعُو فِي المَاء ويْبَرِّدْلِي لْسَانِي، رَانِي مِتْعَذَّبْ فِي هَا النَّارْ". <verse eid="LUK 16:24" /><verse number="25" style="v" sid="LUK 16:25" />آمَا إِبْرَاهِيمْ جَاوْبُو: "يَا وِلْدِي اتْذَكِّرْ الِّي إِنْتِ خْذِيتْ بَايِكْ فِي الدِّنْيَا مِالخِيرَاتْ ولِعَازِرْ خْذَا بَايُو مِالبْلَاوَاتْ، آمَا تَوَّا هُوَّ قَاعِدْ يِتْعَزَّى هْنَا، وإِنْتِ تِتْعَذَّبْ. <verse eid="LUK 16:25" /><verse number="26" style="v" sid="LUK 16:26" />وفُوقْ هَاذَا الكُلْ، بِينَاتْنَا هَفْهُوفْ كْبِيرْ، مَا يْنَجِّمْ حَدْ يِتْعَدَّاهْ، لَا مِنْ عَنْدْنَا لْعَنْدْكُمْ ولَا مِنْ عَنْدْكُمْ لْعَنْدْنَا". <verse eid="LUK 16:26" /><verse number="27" style="v" sid="LUK 16:27" />يَاخِي قَالُّو الغْنِيْ: "مَالَا نِتْرَجَّاكْ يَا بَابَا إِبْرَاهِيمْ بَاشْ تَبْعَثُو لْدَارْ بَابَا، <verse eid="LUK 16:27" /><verse number="28" style="v" sid="LUK 16:28" />بَاشْ يْنَبَّهْ خْوَاتِي الخَمْسَة، ومَا تْرَصِّيلْهُمْشْ هُومَا زَادَا فِي بْلَاصَة العْذَابْ هَاذِي". <verse eid="LUK 16:28" /><verse number="29" style="v" sid="LUK 16:29" />آمَا إِبْرَاهِيمْ قَالُّو: "عَنْدْهُمْ كْتُبْ مُوسَى والأَنْبِيَاءْ! خَلِّي يَعْمْلُوا بِلِّي فِيهُمْ". <verse eid="LUK 16:29" /><verse number="30" style="v" sid="LUK 16:30" />جَاوْبُو: "لَا يَا بَابَا إِبْرَاهِيمْ، آمَا إِذَا كَانْ وَاحِدْ مِنْ بِينْ المُوتَى مْشَالْهُمْ تَوْ يْتُوبُوا". <verse eid="LUK 16:30" /><verse number="31" style="v" sid="LUK 16:31" />قَالُّو إِبْرَاهِيمْ: "إِذَا كَانْ مَا سَمْعُوشْ كْلَامْ مُوسَى والأَنْبِيَاءْ، مُشْ بِشْ يِقْتَنْعُوا حَتَّى لَوْ كَانْ قَامْ وَاحِدْ مِنْ بِينْ المُوتَى!"».<verse eid="LUK 16:31" /></para>
  <chapter eid="LUK 16" />
  <chapter number="17" style="c" sid="LUK 17" />
  <para style="s">المُتْسَبِّبْ فِي الذْنُوبْ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1" />وقَالْ يَسُوعْ لِتْلَامِذْتُو: «أَكِيدْ بِشْ يْصِيرُوا حَاجَاتْ تْخَلِّي النَّاسْ يَعْمْلُوا الذْنُوبْ، آمَا يَا وِيلُو الِّي يْكُونْ هُوَّ السْبَبْ فِيهَا. <verse eid="LUK 17:1" /><verse number="2" style="v" sid="LUK 17:2" />يْكُونْ خِيرْلُو كَانْ تِتْرْبَطْ فِي رَقْبْتُو حَجْرِةْ رْحَى ويِتْرْمَى فِي البْحَرْ، مِنْ إِنُّو يْكُونْ سْبَبْ فِي إِنُّو وَاحِدْ مِالصْغَارْ هَاذُومَا يَعْمِلْ ذَنْبْ.<verse eid="LUK 17:2" /></para>
  <para style="s">السْمَاحْ</para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 17:3" />«مَالَا رُدُّوا بَالْكُمْ. كَانْ خُوكْ عْمَلْ ذَنْبْ وَاجْهُو، وكَانْ تَابْ سَامْحُو. <verse eid="LUK 17:3" /><verse number="4" style="v" sid="LUK 17:4" />وكَانْ غْلُطْ فِي حَقِّكْ سَبْعَة مَرَّاتْ فِي النْهَارْ ورْجَعْلِكْ فِي كُلْ مَرَّة وقَالْ "آنَا تُبْتْ" سَامْحُو».<verse eid="LUK 17:4" /></para>
  <para style="s">الإِيمَانْ</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5" />وقَالُوا الرُّسُلْ لِلرَّبْ يَسُوعْ: «زِيدْ إِيمَانَّا». <verse eid="LUK 17:5" /><verse number="6" style="v" sid="LUK 17:6" />آمَا الرَّبْ يَسُوعْ جَاوِبْهُمْ: «كَانْ جَاء عَنْدْكُمْ إِيمَانْ قَدْ كَعْبِةْ الخَرْدِلْ، رَاكُمْ تْقُولُوا لْشَجْرِةْ التُّوتْ هَاذِي: "اتْقَلَّعْ واتْغْرِسْ فِي البْحَرْ" وهِيَّ اطِّيعْكُمْ.<verse eid="LUK 17:6" /></para>
  <para style="s">التَّوَاضُعْ فِي الخِدْمَة</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7" />«شْكُونْ فِيكُمْ عَنْدُو خْدِيمْ يَحْرِثْ وَلَّا يِسْرَحْ بِالغْنَمْ، يْقُلُّو وَقْتِلِّي يِرْجَعْ مِالسَّانْيَة: "إِيجَا تَوَّا وأُقْعُدْ كُولْ"؟ <verse eid="LUK 17:7" /><verse number="8" style="v" sid="LUK 17:8" />مُشْ يْقُلُّو: "حَضَّرْلِي العْشَاء، وشَمِّرْ عْلَى ذْرَاعِكْ وتِلْهَى بِيَّا حَتَّى لِينْ آنَا نَاكِلْ ونُشْرُبْ، ومْبَعِّدْ إِنْتِ كُولْ وأُشْرُبْ عْلَى رُوحِكْ"؟ <verse eid="LUK 17:8" /><verse number="9" style="v" sid="LUK 17:9" />يَاخِي سِيدُو مَلْزُومْ يُشْكُرُو عْلَى خَاطْرُو عْمَلْ الِّي أَمْرُو بِيهْ؟ مَا نْظُنِّشْ. <verse eid="LUK 17:9" /><verse number="10" style="v" sid="LUK 17:10" />هَكَّاكَا إِنْتُومَا زَادَا، كِي تَعْمْلُوا الِّي تِأْمَرْتُوا بِيهْ لَازِمْ تْقُولُوا: "أَحْنَا مَانَا إِلَّا خَدَّامَة، ومَعْمَلْنَا كَانْ الوَاجِبْ"».<verse eid="LUK 17:10" /></para>
  <para style="s">الشُّكْرْ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11" />وفِي نْهَارْ، وهُوَّ فِي طْرِيقُو لْأُورْشَلِيمْ، تْعَدَّى يَسُوعْ عَالسَّامْرَة والجَلِيلْ. <verse eid="LUK 17:11" /><verse number="12" style="v" sid="LUK 17:12" />وهُوَّ دَاخِلْ لْدَشْرَة، جَاوَهْ عَشْرَة رْجَالْ عَنْدْهُمْ البْرَصْ، ووِقْفُوا بْعِيدْ عْلِيهْ. <verse eid="LUK 17:12" /><verse number="13" style="v" sid="LUK 17:13" />وبْدَاوْ يْعَيْطُوا: «يَا يَسُوعْ، يَا سِيدْنَا، أَرْحَمْنَا». <verse eid="LUK 17:13" /><verse number="14" style="v" sid="LUK 17:14" />وكِي شَافْهُمْ يَسُوعْ قَالِلْهُمْ: «إِمْشِيوْ وَرِّيوْ رْوَاحْكُمْ لِلْكَهَنَة». وهُومَا مَاشِينْ طُهْرُوا مِالبْرَصْ.<verse eid="LUK 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 17:15" />وكِي وَاحِدْ مِنْهُمْ شَافْ الِّي هُوَّ طْهُرْ، رْجَعْ وهُوَّ يْمَجِّدْ فِي اللَّهْ بْأَعْلَى صُوتُو. <verse eid="LUK 17:15" /><verse number="16" style="v" sid="LUK 17:16" />وهْبَطْ عْلَى وِجْهُو قُدَّامْ سَاقِينْ يَسُوعْ وشَكْرُو، والرَّاجِلْ هَاذَا كَانْ سَامْرِي. <verse eid="LUK 17:16" /><verse number="17" style="v" sid="LUK 17:17" />يَاخِي يَسُوعْ قَالْ: «مُشْ العَشْرَة رْجَالْ طُهْرُوا؟ مَالَا وِينْهُمْ التِّسْعَة الأُخْرِينْ؟ <verse eid="LUK 17:17" /><verse number="18" style="v" sid="LUK 17:18" />مِنْ بِينْهُمْ الكُلْ، مَا فَمَّة حَتَّى حَدْ رْجَعْ بَاشْ يْمَجِّدْ اللَّهْ غِيرْ هَا البَرَّانِي؟». <verse eid="LUK 17:18" /><verse number="19" style="v" sid="LUK 17:19" />ومْبَعِّدْ قَالُّو: «قُومْ وإِمْشِي عْلَى رُوحِكْ، إِيمَانِكْ شْفَاكْ».<verse eid="LUK 17:19" /></para>
  <para style="s">وَقْتَاشْ تْجِي مَمْلَكْةْ اللَّهْ؟</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20" />ووَقْتِلِّي الفِرِّيسِيِّينْ سِأْلُوهْ: «وَقْتَاشْ تْجِي مَمْلَكْةْ اللَّهْ؟» جَاوِبْهُمْ: «رَاهِي مَمْلَكْةْ اللَّهْ مَا تْجِيشْ بْطَرِيقَة تِتْشَافْ. <verse eid="LUK 17:20" /><verse number="21" style="v" sid="LUK 17:21" />ومَا يْقُولُوشْ: "هَايْ هْنَا، وَلَّا: هَايْ غَادِي!" عْلَى خَاطِرْ مَمْلَكْةْ اللَّهْ هِيَّ فِي وِسْطْكُمْ».<verse eid="LUK 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22" />وقَالْ لِتْلَامِذْتُو: «بِشْ يْجِي وَقْتْ تِتْمَنَّاوْ تْكُونُوا فِيهْ مْعَ إِبْنْ الإِنْسَانْ ولَوْ نْهَارْ وَاحِدْ، ومُشْ بِشْ تْنَجْمُوا. <verse eid="LUK 17:22" /><verse number="23" style="v" sid="LUK 17:23" />وبِشْ يْقُولُولْكُمْ: "هَا هَوَّا هْنَا" وَلَّا "أَهَوْكَا غَادِي". مَا تِمْشِيوِشْ، ومَا اتَّبْعُوهُمْشْ. <verse eid="LUK 17:23" /><verse number="24" style="v" sid="LUK 17:24" />عْلَى خَاطِرْ كِيمَا البْرَقْ كِي يُبْرُقْ يْضَوِّي السْمَاء الكُلْ، هَكَّاكَا يْكُونْ إِبْنْ الإِنْسَانْ نْهَارِةْ الِّي يِرْجَعْ. <verse eid="LUK 17:24" /><verse number="25" style="v" sid="LUK 17:25" />آمَا فِي الأُوِّلْ لَازْمُو يِتْعَذَّبْ بَرْشَة والجِّيلْ هَاذَا يُرْفْضُو.<verse eid="LUK 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 17:26" />«وكِيمَا صَارْ فِي أَيَّامْ نُوحْ، هَكَّاكَا بِشْ يْصِيرْ فِي أَيَّامْ إِبْنْ الإِنْسَانْ: <verse eid="LUK 17:26" /><verse number="27" style="v" sid="LUK 17:27" />كَانُوا النَّاسْ يَاكْلُوا ويُشْرْبُوا ويْعَرْسُوا ويْعَرْسُولْهُمْ، لِينْ جَاء النْهَارْ الِّي دْخَلْ فِيهْ نُوحْ لِلسْفِينَة، وجَاء الطُّوفَانْ وهْلِكْهُمْ الكُلْ. <verse eid="LUK 17:27" /><verse number="28" style="v" sid="LUK 17:28" />وبِشْ يْكُونْ كِيمَا صَارْ زَادَا فِي زْمَانْ لُوطْ: كَانُوا يَاكْلُوا ويُشْرْبُوا، ويِشْرِيوْ ويْبِيعُوا، ويَزْرْعُوا ويِبْنِيوْ. <verse eid="LUK 17:28" /><verse number="29" style="v" sid="LUK 17:29" />آمَا نْهَارِةْ الِّي خْرَجْ لُوطْ مِنْ مْدِينِةْ سَدُومْ، مَطْرِتْ السْمَاء نَارْ وكِبْرِيتْ وهِلْكِتْهُمْ الكُلْ.<verse eid="LUK 17:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 17:30" />«هَكَّا بِشْ يْصِيرْ فِي النْهَارْ الِّي بِشْ يُظْهُرْ فِيهْ إِبْنْ الإِنْسَانْ. <verse eid="LUK 17:30" /><verse number="31" style="v" sid="LUK 17:31" />فِي النْهَارْ هَاذَاكَا، الِّي يَبْدَى فُوقْ السْطَحْ ودَبْشُو فِي الدَّارْ، مَا يَهْبَطْشْ يْهِزُّو. ولِّي فِي السَّانْيَة مَا يِرْجَعْشْ لِلدَّارْ. <verse eid="LUK 17:31" /><verse number="32" style="v" sid="LUK 17:32" />اتْذَكْرُوا مَرْتْ لُوطْ. <verse eid="LUK 17:32" /><verse number="33" style="v" sid="LUK 17:33" />الِّي يْحِبْ يَحْفِظْ حْيَاتُو يَخْسَرْهَا، آمَا الِّي يَخْسَرْ حْيَاتُو هُوَّ الِّي يَحْفَظْهَا. <verse eid="LUK 17:33" /><verse number="34" style="v" sid="LUK 17:34" />نْقُولِلْكُمْ: فِي اللِّيلَة هَاذِيكَا يْكُونُوا زُوزْ رَاقْدِينْ فِي فَرْشْ وَاحِدْ، يِتْهَزْ وَاحِدْ ويِبْقَى الآخِرْ. <verse eid="LUK 17:34" /><verse number="35" style="v" sid="LUK 17:35" />ويْكُونُوا زُوزْ نْسَاء يِرْحِيوْ مْعَ بْعَضْهُمْ، تِتْهَزْ وَحْدَة وتِبْقَى الأُخْرَى. <verse eid="LUK 17:35" /><verse number="36" style="v" sid="LUK 17:36" />ويْكُونُوا زُوزْ رْجَالْ فِي السَّانْيَة، يِتْهَزْ وَاحِدْ ويِبْقَى الآخِرْ». <verse eid="LUK 17:36" /><verse number="37" style="v" sid="LUK 17:37" />يَاخِي سِأْلُوهْ تْلَامِذْتُو: «وِينْ بِشْ يْصِيرْ هَاذَا يَا سِيدْنَا؟» جَاوِبْهُمْ: «وِينْ فَمَّة الجِيفَة، غَادِي تِتْلَمْ النْسُورَة».<verse eid="LUK 17:37" /></para>
  <chapter eid="LUK 17" />
  <chapter number="18" style="c" sid="LUK 18" />
  <para style="s">مَثَلْ القَاضِي والمْرَا الهَجَّالَة</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1" />وعْطَاهُمْ مَثَلْ يْبَيْنِلْهُمْ بِيهْ كِيفَاشْ يِلْزِمْهُمْ دِيمَا يْصَلِّيوْ ومَا يْمِلُّوشْ، <verse eid="LUK 18:1" /><verse number="2" style="v" sid="LUK 18:2" />وقَالْ: «كَانِتْ فَمَّة مْدِينَة فِيهَا قَاضِي مَا يْخَافِشْ اللَّهْ ومَا يْهِمُّو فِي حَدْ. <verse eid="LUK 18:2" /><verse number="3" style="v" sid="LUK 18:3" />وكَانِتْ فَمَّة مْرَا هَجَّالَة فِي نَفْسْ المْدِينَة، دِيمَا تْجِيهْ وتْقُلُّو: "خُوذْلِي حَقِّي مِنْ عْدُويَا". <verse eid="LUK 18:3" /><verse number="4" style="v" sid="LUK 18:4" />وبْقَى مُدَّة مَا يْحِبِّشْ يِقْبِلْ شْكَايِتْهَا. آمَا مْبَعِّدْ قَالْ بِينُو وبِينْ رُوحُو: "صْحِيحْ آنَا مَا نْخَافِشْ اللَّهْ ومَا يْهِمْنِي فِي حَدْ، <verse eid="LUK 18:4" /><verse number="5" style="v" sid="LUK 18:5" />آمَا عْلَى خَاطِرْ الهَجَّالَة هَاذِي تْقَلَّقْ فِيَّا، بِشْ نَاخْذِلْهَا حَقْهَا، مَاكَانِشْ بِشْ تُقْعُدْ كُلْ مَرَّة تْكَسَّرْلِي فِي رَاسِي!"».<verse eid="LUK 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6" />وقَالْ الرَّبْ يَسُوعْ: «إِسْمْعُوا القَاضِي الظَّالِمْ آشْ قَالْ. <verse eid="LUK 18:6" /><verse number="7" style="v" sid="LUK 18:7" />مَالَا زَعْمَة اللَّهْ مَا يَاخِذْشْ حَقْ الِّي إِخْتَارْهُمْ، الِّي يِتْضَرْعُولُو لِيلْ ونْهَارْ؟ زَعْمَة يِبْطَى عْلِيهُمْ ومَا يْجَاوِبْهُمْشْ؟ <verse eid="LUK 18:7" /><verse number="8" style="v" sid="LUK 18:8" />نْقُولِلْكُمْ: رَاهُو فِيسَعْ يَاخْذِلْهُمْ حَقْهُمْ. آمَا وَقْتِلِّي يِرْجَعْ إِبْنْ الإِنْسَانْ، زَعْمَة يَلْقَى إِيمَانْ عَالأَرْضْ؟».<verse eid="LUK 18:8" /></para>
  <para style="s">مَثَلْ الفِرِّيسِي والمَكَّاسْ</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9" />وعْطَى زَادَا مَثَلْ لِلنَّاسْ الِّي يِعْتَبْرُوا رْوَاحْهُمْ صَالْحِينْ، ويَحْقْرُوا غِيرْهُمْ: <verse eid="LUK 18:9" /><verse number="10" style="v" sid="LUK 18:10" />«فَمَّة زُوزْ رْجَالْ طَلْعُوا لِلْهَيْكِلْ بَاشْ يْصَلِّيوْ، وَاحِدْ فِرِّيسِي والآخِرْ مَكَّاسْ. <verse eid="LUK 18:10" /><verse number="11" style="v" sid="LUK 18:11" />وْقِفْ الفِرِّيسِي يْصَلِّي فِي قَلْبُو وقَالْ: "نُشْكْرِكْ يَا اللَّهْ، عْلَى خَاطِرْنِي مَانِيشْ كِيمَا بْقِيِّةْ النَّاسْ الأُخْرِينْ الطَّمَّاعِينْ والظَّالْمِينْ والزَّانِينْ، ولَا كِيمَا المَكَّاسْ هَاذَا. <verse eid="LUK 18:11" /><verse number="12" style="v" sid="LUK 18:12" />نْصُومْ مَرْتِينْ فِي الجِّمْعَة، ونَعْطِي العْشُرْ مِلِّي نِكْسْبُو الكُلْ". <verse eid="LUK 18:12" /><verse number="13" style="v" sid="LUK 18:13" />آمَا المَكَّاسْ، وْقِفْ مِنْ بْعِيدْ ومَا حَبِّشْ حَتَّى يْهِزْ عِينِيهْ لِلسْمَاء، آمَا كَانْ يَضْرِبْ عْلَى صِدْرُو ويْقُولْ: "يَا اللَّهْ أَرْحَمْنِي، آنَا المُذْنِبْ". <verse eid="LUK 18:13" /><verse number="14" style="v" sid="LUK 18:14" />نْقُولِلْكُمْ: الِّي رْجَعْ لْدَارُو واللَّهْ مُعْتَبْرُو صَالَحْ هُوَّ المَكَّاسْ مُشْ الفِرِّيسِي. عْلَى خَاطِرْ الِّي يْعَلِّي رُوحُو يَهْبِطْ، ولِّي يْطَيَّحْ مِنْ رُوحُو يَعْلَى».<verse eid="LUK 18:14" /></para>
  <para style="s">خَلِّيوْ الصْغَارْ يْجِيوْنِي</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15" />وجَاوْ نَاسْ وجَابُولُو صْغَارْ بَاشْ يْحُطْ عْلِيهُمْ يِدُّو ويْبَارِكْهُمْ، وكِي شَافُوهُمْ التْلَامْذَة لَامُوهُمْ. <verse eid="LUK 18:15" /><verse number="16" style="v" sid="LUK 18:16" />آمَا يَسُوعْ عَيِّطْ لِلصْغَارْ وقَالْ: «خَلِّيوْ الصْغَارْ يْجِيوْنِي ومَا تَمْنْعُوهُمْشْ، عْلَى خَاطِرْ مَمْلَكْةْ اللَّهْ هِيَّ لِلنَّاسْ الِّي كِيفْهُمْ. <verse eid="LUK 18:16" /><verse number="17" style="v" sid="LUK 18:17" />نْقُولِلْكُمْ الحَقْ: الِّي مَا يِقْبِلْشْ مَمْلَكْةْ اللَّهْ كِيمَا الطْفُلْ الصْغِيرْ عُمْرُو مَا يُدْخْلِلْهَا».<verse eid="LUK 18:17" /></para>
  <para style="s">يَسُوعْ والرَّاجِلْ الغْنِيْ</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18" />وسِأْلُو وَاحِدْ مِالأَعْيَانْ: «إِنْتِ مُعَلِّمْ صَالَحْ، قُلِّي آشْ نَعْمِلْ بَاشْ نُورِثْ الحَيَاةْ الأَبَدِيَّة؟». <verse eid="LUK 18:18" /><verse number="19" style="v" sid="LUK 18:19" />آمَا يَسُوعْ قَالُّو: «عْلَاشْ تْعَيِّطْلِي صَالَحْ؟ مَا فَمَّة حَتَّى وَاحِدْ صَالَحْ كَانْ اللَّهْ وَحْدُو. <verse eid="LUK 18:19" /><verse number="20" style="v" sid="LUK 18:20" />إِنْتِ تَعْرِفْ الوْصَايَا: مَا تَزْنَاشْ، مَا تَعْمِلْشْ جْرِيمِةْ قَتْلْ، مَا تِسْرَقْشْ، مَا تِشْهِدْشْ بِالكِذْبْ، إِكْرِمْ بُوكْ وأُمِّكْ». <verse eid="LUK 18:20" /><verse number="21" style="v" sid="LUK 18:21" />قَالُّو الرَّاجِلْ: «الوْصَايَا هَاذُمْ الكُلْ نْطَبَّقْ فِيهُمْ مِنْ صُغْرِي». <verse eid="LUK 18:21" /><verse number="22" style="v" sid="LUK 18:22" />وكِي سْمَعْ يَسُوعْ الكْلَامْ هَاذَا قَالُّو: «مَزَّالِتْ نَاقْصِتِّكْ حَاجَة وَحْدَة: بِيعْ الِّي عَنْدِكْ الكُلْ وفَرْقُو عَالفْقَارَى، وهَكَّا يْوَلِّي عَنْدِكْ كِنْزْ فِي السْمَاء، ومْبَعِّدْ إِيجَا تَبَّعْنِي». <verse eid="LUK 18:22" /><verse number="23" style="v" sid="LUK 18:23" />آمَا الرَّاجِلْ كِي سْمَعْ الكْلَامْ هَاذَا، حْزِنْ عَالإِخِّرْ، عْلَى خَاطْرُو كَانْ غْنِيْ بَرْشَة.<verse eid="LUK 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 18:24" />وكِي شَافُو يَسُوعْ كِيفَاشْ حْزِنْ، قَالْ: «مَصْعِبْ دْخُولْ الغْنِيِّينْ لْمَمْلَكْةْ اللَّهْ! <verse eid="LUK 18:24" /><verse number="25" style="v" sid="LUK 18:25" />رَاهُو دْخُولْ الجْمَلْ مِنْ نُقْبِةْ الإِبْرَة أَسْهِلْ مِنْ دْخُولْ الغْنِيْ لْمَمْلَكْةْ اللَّهْ». <verse eid="LUK 18:25" /><verse number="26" style="v" sid="LUK 18:26" />ولِّي كَانُوا يِسْمْعُوا فِيهْ قَالُوا: «مَالَا شْكُونْ يْنَجِّمْ يِنْجَى؟». <verse eid="LUK 18:26" /><verse number="27" style="v" sid="LUK 18:27" />قَالِلْهُمْ يَسُوعْ: «المُسْتَحِيلْ عَنْدْ النَّاسْ، اللَّهْ يَقْدِرْ عْلِيهْ».<verse eid="LUK 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28" />وقَالُّو بُطْرُسْ: «هَانَا أَحْنَا خَلِّينَا الِّي عَنْدْنَا الكُلْ وتَبَّعْنَاكْ!». <verse eid="LUK 18:28" /><verse number="29" style="v" sid="LUK 18:29" />يَاخِي قَالِلْهُمْ: «نْقُلْكُمْ الحَقْ: كُلْ مِنْ خَلَّى دَارْ، وَلَّا مْرَا، وَلَّا خْوَاتْ، وَلَّا وَالْدِينْ، وَلَّا وْلَادْ، عْلَى خَاطِرْ مَمْلَكْةْ اللَّهْ، <verse eid="LUK 18:29" /><verse number="30" style="v" sid="LUK 18:30" />بِشْ يَاخِذْ فِي الزْمَانْ هَاذَا أَضْعَافْ الِّي خَلَّاهْ، ويَاخِذْ فِي الزْمَانْ الجَايْ الحَيَاةْ الأَبَدِيَّة».<verse eid="LUK 18:30" /></para>
  <para style="s">يَسُوعْ يْزِيدْ يِتْنَبَّأْ بْمُوتُو وقْيَامْتُو</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31" />وبَعْدْهَا جْبِدْ الأَثْنَاشِنْ تِلْمِيذْ عْلَى جْنَبْ وقَالِلْهُمْ: «هَاوْ بِشْ نِطْلْعُوا لْأُورْشَلِيمْ، ولِّي كِتْبُوهْ الأَنْبِيَاءْ عْلَى إِبْنْ الإِنْسَانْ الكُلْ بِشْ يْتِمْ. <verse eid="LUK 18:31" /><verse number="32" style="v" sid="LUK 18:32" />رَاهُو بِشْ يْسَلْمُوهْ لِلِّي مَاهُمْشْ يْهُودْ، وبِشْ يِتْمَسْخْرُوا عْلِيهْ ويْسِبُّوهْ ويِبْزْقُوا عْلِيهْ، <verse eid="LUK 18:32" /><verse number="33" style="v" sid="LUK 18:33" />وبَعْدْمَا يِجْلْدُوهْ يُقْتْلُوهْ، وفِي النْهَارْ الثَّالِثْ يْقُومْ».<verse eid="LUK 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34" />آمَا التْلَامْذَة مَا فِهْمُوا حَتَّى شَيْ، والكْلَامْ كَانْ غَامِضْ عْلِيهُمْ، ومَا عَرْفُوشْ شْنِيَّة يُقْصِدْ.<verse eid="LUK 18:34" /></para>
  <para style="s">يَسُوعْ يِشْفِي وَاحِدْ أَعْمَى</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35" />وكِي قْرُبْ يَسُوعْ مِنْ مْدِينِةْ أَرِيحَا، كَانْ فَمَّة وَاحِدْ أَعْمَى قَاعِدْ عْلَى جْنَبْ الطْرِيقْ يُطْلُبْ. <verse eid="LUK 18:35" /><verse number="36" style="v" sid="LUK 18:36" />وكِي سْمَعْ حِسْ بَرْشَة نَاسْ مِتْعَدِّينْ، سْإِلْ: «آشْ فَمَّة؟». <verse eid="LUK 18:36" /><verse number="37" style="v" sid="LUK 18:37" />قَالُولُو: «يَسُوعْ النَّاصْرِي مِتْعَدِّي مِنْ هْنَا». <verse eid="LUK 18:37" /><verse number="38" style="v" sid="LUK 18:38" />يَاخِي بْدَا يْعَيِّطْ: «يَا يَسُوعْ وِلْدْ دَاوِدْ، أَرْحَمْنِي!». <verse eid="LUK 18:38" /><verse number="39" style="v" sid="LUK 18:39" />والنَّاسْ الِّي قَاعْدِينْ يِمْشِيوْ مِالقُدَّامْ صَاحُوا عْلِيهْ بَاشْ يُسْكُتْ، آمَا هُوَّ وَلَّى يْعَيِّطْ أَكْثِرْ: «يَا وِلْدْ دَاوِدْ، أَرْحَمْنِي!». <verse eid="LUK 18:39" /><verse number="40" style="v" sid="LUK 18:40" />يَاخِي وْقِفْ يَسُوعْ وقَالِلْهُمْ يْجِيبُوهُولُو، وكِي قْرُبْ مِنُّو سِأْلُو: <verse eid="LUK 18:40" /><verse number="41" style="v" sid="LUK 18:41" />«شْنُوَّة تْحِبْنِي نَعْمَلِّكْ؟». قَالْ: «يَا سِيدِي، نْحِبْ نْوَلِّي نْشُوفْ!». <verse eid="LUK 18:41" /><verse number="42" style="v" sid="LUK 18:42" />قَالُّو يَسُوعْ: «تْنَجِّمْ تْشُوفْ، إِيمَانِكْ شْفَاكْ». <verse eid="LUK 18:42" /><verse number="43" style="v" sid="LUK 18:43" />وبِالوَقْتْ وَلَّى يْشُوفْ، وتَبْعُو وهُوَّ يْسَبَّحْ فِي اللَّهْ. والنَّاسْ الكُلْ كِي شَافُوا الِّي صَارْ، مَجْدُوا اللَّهْ.<verse eid="LUK 18:43" /></para>
  <chapter eid="LUK 18" />
  <chapter number="19" style="c" sid="LUK 19" />
  <para style="s">يَسُوعْ وزَكَّا</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1" />ودْخَلْ يَسُوعْ لِمْدِينِةْ أَرِيحَا وتْعَدَّى فِي وِسْطْهَا. <verse eid="LUK 19:1" /><verse number="2" style="v" sid="LUK 19:2" />وكَانْ فَمَّة غَادِي رَاجِلْ غْنِيْ إِسْمُو زَكَّا، وكَانْ رَئِيسْ المَكَّاسَة. <verse eid="LUK 19:2" /><verse number="3" style="v" sid="LUK 19:3" />وحَاوِلْ يْشُوفْ شْكُونْ هُوَّ يَسُوعْ، آمَا مَا نَجَّمْشْ عْلَى خَاطِرْ كَانُوا فَمَّة بَرْشَة نَاسْ قُدَّامُو، وزِيدْ هُوَّ قْصِيرْ. <verse eid="LUK 19:3" /><verse number="4" style="v" sid="LUK 19:4" />يَاخِي سْبِقْ يِجْرِي وطْلَعْ فُوقْ شَجْرَة بَاشْ يْشُوفُو، عْلَى خَاطِرْ يَسُوعْ كَانْ بِشْ يِتْعَدَّى مِنْ غَادِي. <verse eid="LUK 19:4" /><verse number="5" style="v" sid="LUK 19:5" />وكِي وْصِلْ يَسُوعْ لِلْبْلَاصَة هَاذِيكَا، هَزْ عِينِيهْ وشَافُو، يَاخِي قَالُّو: «يَا زَكَّا، أَهْبِطْ فِيسَعْ، رَاهُو لَازِمْنِي نَبْقَى فِي دَارِكْ اليُومْ». <verse eid="LUK 19:5" /><verse number="6" style="v" sid="LUK 19:6" />وَلَّى زَكَّا هْبَطْ فِيسَعْ، وضَيْفُو وكَانْ فَرْحَانْ بِيهْ. <verse eid="LUK 19:6" /><verse number="7" style="v" sid="LUK 19:7" />وكِي شَافُوا النَّاسْ الِّي صَارْ، بْدَاوْ يِتْشَكَّاوْ، ويْقُولُوا: «دْخَلْ لْدَارْ وَاحِدْ مُذْنِبْ بَاشْ يْبَاتْ عَنْدُو!». <verse eid="LUK 19:7" /><verse number="8" style="v" sid="LUK 19:8" />آمَا زَكَّا وْقِفْ وقَالْ لِلرَّبْ يَسُوعْ: «يَا سِيدِي، هَانِي بِشْ نَعْطِي نُصْ ثَرْوْتِي لِلْفْقَارَى. وإِذَا كَانْ خْذِيتْ عْلَى وَاحِدْ حَاجَة زَايْدَة، نْرَجَّعْلُو قَدْهَا أَرْبْعَة مَرَّاتْ». <verse eid="LUK 19:8" /><verse number="9" style="v" sid="LUK 19:9" />يَاخِي قَالُّو يَسُوعْ: «اليُومْ نْجَاوْ أَهْلْ الدَّارْ هَاذِي، عْلَى خَاطِرْ الرَّاجِلْ هَاذَا هُوَّ زَادَا وِلْدْ إِبْرَاهِيمْ. <verse eid="LUK 19:9" /><verse number="10" style="v" sid="LUK 19:10" />رَاهُو إِبْنْ الإِنْسَانْ جَاء بَاشْ يْلَوِّجْ عَلِّي مَاشِينْ لِلْهْلَاكْ ويْنَجِّيهُمْ».<verse eid="LUK 19:10" /></para>
  <para style="s">مَثَلْ الخُدَّامْ والبْيَاسَاتْ الذْهَبْ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11" />وهُومَا قَاعْدِينْ يِسْمْعُوا فِي الكْلَامْ هَاذَا، زَادْ يَسُوعْ عْطَاهُمْ مَثَلْ، عْلَى خَاطْرُو قْرُبْ مِنْ أُورْشَلِيمْ والنَّاسْ كَانْ مَاشِي فِي بَالْهُمْ الِّي مَمْلَكْةْ اللَّهْ بِشْ تُظْهُرْ فِي لَحْظِتْهَا. <verse eid="LUK 19:11" /><verse number="12" style="v" sid="LUK 19:12" />وقَالْ: «فَمَّة وَاحِدْ مِالأَعْيَانْ سَافِرْ لِبْلَادْ بْعِيدَة، بَاشْ يِتْعَيِّنْ مَلِكْ ومْبَعِّدْ يِرْجَعْ. <verse eid="LUK 19:12" /><verse number="13" style="v" sid="LUK 19:13" />عَيِّطْ لْعَشْرَة مِنْ خُدَّامُو، وعْطَى لْكُلْ وَاحِدْ فِيهُمْ بْيَاسَة ذْهَبْ، وقَالِلْهُمْ: تَاجْرُوا بِيهُمْ حَتَّى لِينْ نِرْجَعْ.<verse eid="LUK 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 19:14" />«آمَا وْلَادْ بْلَادُو كَانُوا يِكْرْهُوهْ، وبَعْثُوا وْرَاهْ جْمَاعَة يْقُولُوا: "مَا نْحِبُّوشْ هَاذَا يْكُونْ مَلِكْ عْلِينَا". <verse eid="LUK 19:14" /><verse number="15" style="v" sid="LUK 19:15" />ورْجَعْ بَعْدْمَا تْعَيِّنْ مَلِكْ، وعْطَى أَمْرْ بَاشْ يْعَيْطُوا لِلْخُدَّامْ الِّي عْطَاهُمْ البْيَاسَاتْ الذْهَبْ، بَاشْ يْشُوفْ قَدَّاشْ رْبِحْ كُلْ وَاحِدْ فِيهُمْ. <verse eid="LUK 19:15" /><verse number="16" style="v" sid="LUK 19:16" />جَاء الأُوِّلْ وقَالْ: "يَا سِيدِي، بْيَاسْتِكْ الذْهَبْ جَابِتْ عَشْرَة كِيفْهَا". <verse eid="LUK 19:16" /><verse number="17" style="v" sid="LUK 19:17" />يَاخِي قَالُّو: "صَحِّيتْ، إِنْتِ خْدِيمْ صَالَحْ. عْلَى خَاطْرِكْ كُنْتْ أَمِينْ فِي القْلِيلْ، بِشْ نْحُطِّكْ حَاكِمْ عْلَى عَشْرَة مُدُنْ". <verse eid="LUK 19:17" /><verse number="18" style="v" sid="LUK 19:18" />وجَاء الثَّانِي وقَالْ: "يَا سِيدِي، بْيَاسْتِكْ الذْهَبْ جَابِتْ خَمْسَة كِيفْهَا". <verse eid="LUK 19:18" /><verse number="19" style="v" sid="LUK 19:19" />قَالُّو: "إِنْتِ بِشْ نْحُطِّكْ حَاكِمْ عْلَى خَمْسَة مُدُنْ". <verse eid="LUK 19:19" /><verse number="20" style="v" sid="LUK 19:20" />وجَاء وَاحِدْ آخِرْ وقَالْ: "يَا سِيدِي، هَايْ بْيَاسْتِكْ الذْهَبْ، لَفِّيتْهَا فِي مَنْدِيلَة وخَبِّيتْهَا. <verse eid="LUK 19:20" /><verse number="21" style="v" sid="LUK 19:21" />رَانِي كُنْتْ خَايِفْ مِنِّكْ، عْلَى خَاطْرِكْ إِنْسَانْ صْعِيبْ، تَاخِذْ الِّي مُشْ لِيكْ، وتَحْصِدْ الِّي مَا زَرْعِتُّوشْ يْدِيكْ". <verse eid="LUK 19:21" /><verse number="22" style="v" sid="LUK 19:22" />قَالُّو: "مِنْ كْلَامِكْ بِشْ نُحْكُمْ عْلِيكْ، يَا خْدِيمْ يَا شِرِّيرْ. إِنْتِ تَعْرِفْ الِّي آنَا إِنْسَانْ صْعِيبْ، نَاخِذْ الِّي مُشْ لِيَّا، ونَحْصِدْ الِّي مَا زَرْعِتُّوشْ يْدَيَّا، <verse eid="LUK 19:22" /><verse number="23" style="v" sid="LUK 19:23" />مَالَا عْلَاشْ مَا حَطِّيتْلِيشْ فْلُوسِي فِي البَانْكَة بَاشْ عَالأَقَلْ كِي نِرْجَعْ، نَاخُذْهُمْ ومْعُاهُمْ رِبْحْ؟". <verse eid="LUK 19:23" /><verse number="24" style="v" sid="LUK 19:24" />مْبَعِّدْ قَالْ لِلْحَاضْرِينْ غَادِي: "خُوذُوا مِنْ عَنْدُو البْيَاسَة الذْهَبْ وأَعْطِيوْهَا لِلِّي عَنْدُو عَشْرَة بْيَاسَاتْ". <verse eid="LUK 19:24" /><verse number="25" style="v" sid="LUK 19:25" />قَالُولُو: "يَا سِيدْنَا رَاهُو عَنْدُو عَشْرَة بْيَاسَاتْ ذْهَبْ!". <verse eid="LUK 19:25" /><verse number="26" style="v" sid="LUK 19:26" />جَاوِبْهُمْ: "الِّي عَنْدُو بِشْ يِتْزَادْلُو، ولِّي مَا عَنْدُوشْ، حَتَّى الِّي عَنْدُو بِشْ يِتْفَكْلُو. <verse eid="LUK 19:26" /><verse number="27" style="v" sid="LUK 19:27" />آمَا الأَعْدَاءْ مْتَاعِي، الِّي مَا حَبُّونِيشْ نِمْلِكْ عْلِيهُمْ، جِيبُوهُمْلِي لَهْنَا وأَذْبْحُوهُمْ قُدَّامِي"».<verse eid="LUK 19:27" /></para>
  <para style="s">يَسُوعْ يُدْخُلْ لْأُورْشَلِيمْ</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28" />وبَعْدْمَا كَمِّلْ يَسُوعْ كْلَامُو، مْشَى هُوَّ الأُوِّلْ وشَدْ ثْنِيِّةْ أُورْشَلِيمْ. <verse eid="LUK 19:28" /><verse number="29" style="v" sid="LUK 19:29" />وكِي قْرُبْ مِنْ دَشْرِةْ بَيْتْ فَاجِي ودَشْرِةْ بَيْتْ عَنْيَا الِّي بَحْذَا الجْبَلْ المْسَمِّينُوا جْبَلْ الزِّيتُونْ، بْعَثْ زُوزْ مِنْ تْلَامِذْتُو، <verse eid="LUK 19:29" /><verse number="30" style="v" sid="LUK 19:30" />وقَالِلْهُمْ: «إِمْشِيوْ لِلدَّشْرَة الِّي مْقَابْلِتْكُمْ، ودُوبْ مَا تُدْخْلُوهَا بِشْ تَلْقَاوْ جَحْشْ مَرْبُوطْ عُمْرُو مَا رْكِبْ عْلِيهْ حَتَّى حَدْ، حِلُّولُو الرْبَاطْ وجِيبُوهُولِي لَهْنَا. <verse eid="LUK 19:30" /><verse number="31" style="v" sid="LUK 19:31" />وإِذَا كَانْ وَاحِدْ سْإِلْكُمْ: "عْلَاشْ تْحِلُّولُو فِي الرْبَاطْ؟" قُولُولُو: "سِيدْنَا حَاشْتُو بِيهْ"».<verse eid="LUK 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32" />ومْشَاوْ الزُّوزْ تْلَامْذَة الِّي بْعَثْهُمْ، ولْقَاوْ كُلْ شَيْ كِيفْ مَا قَالِلْهُمْ. <verse eid="LUK 19:32" /><verse number="33" style="v" sid="LUK 19:33" />وهُومَا قَاعْدِينْ يْحِلُّوا فِي الرْبَاطْ، سِأْلُوهُمْ إِمَّالِي الجَّحْشْ: «عْلَاشْ تْحِلُّوا فِيهْ؟». <verse eid="LUK 19:33" /><verse number="34" style="v" sid="LUK 19:34" />قَالُوا: «سِيدْنَا حَاشْتُو بِيهْ». <verse eid="LUK 19:34" /><verse number="35" style="v" sid="LUK 19:35" />وجَابُولُو الجَّحْشْ، وحَطُّوا عْلِيهْ حْوَايِجْهُمْ، ورَكّْبُوا يَسُوعْ. <verse eid="LUK 19:35" /><verse number="36" style="v" sid="LUK 19:36" />وهُوَّ مِتْعَدِّي، بْدَاوْ النَّاسْ يِفْرْشُوا فِي حْوَايِجْهُمْ عَالطْرِيقْ بَاشْ يِكْرْمُوهْ. <verse eid="LUK 19:36" /><verse number="37" style="v" sid="LUK 19:37" />وكِي قْرُبْ مِنْ أُورْشَلِيمْ، فِي الهَبْطَة مْتَاعْ جْبَلْ الزِّيتُونْ، بْدَاوْ تْلَامِذْتُو الكُلْ يْسَبْحُوا فِي اللَّهْ بْصُوتْ عَالِي وهُومَا فَرْحَانِينْ، عَالمُعْجْزَاتْ الِّي شَافُوهَا الكُلْ. <verse eid="LUK 19:37" /><verse number="38" style="v" sid="LUK 19:38" />ويْقُولُوا:</para>
  <para style="b" vid="LUK 19:38" />
  <para style="q1" vid="LUK 19:38">«مُبَارَكْ المَلِكْ الِّي جَايْ بْإِسْمْ الرَّبْ!</para>
  <para style="q2" vid="LUK 19:38">سَلَامْ فِي السْمَاء،</para>
  <para style="q1" vid="LUK 19:38">ومَجْدْ فِي الأَعَالِي!».<verse eid="LUK 19:38" /></para>
  <para style="b" />
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39" />آمَا جْمَاعَة مِالفِرِّيسِيِّينْ الِّي كَانُوا مَوْجُودِينْ غَادِي قَالُولُو: «يَا مُعَلِّمْ، سَكِّتْ تْلَامِذْتِكْ!». <verse eid="LUK 19:39" /><verse number="40" style="v" sid="LUK 19:40" />جَاوِبْهُمْ يَسُوعْ: «نْقُولِلْكُمْ: إِذَا هُومَا يُسْكْتُوا، الحْجَرْ يَنْطَقْ!».<verse eid="LUK 19:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41" />وكِي قْرُبْ لْأُورْشَلِيمْ وشَافْهَا، بْكَى عْلِيهَا. <verse eid="LUK 19:41" /><verse number="42" style="v" sid="LUK 19:42" />وقَالْ: «يَا لِيتِكْ اليُومْ عْرَفْتْ شْنُوَّة الِّي فِيهْ سَلَامِكْ! آمَا هَاذَا تَوَّا مَحْجُوبْ عْلَى عِينِيكْ. <verse eid="LUK 19:42" /><verse number="43" style="v" sid="LUK 19:43" />بِشْ تْجِي عْلِيكْ أَيَّامَاتْ يْسَيْجُوا عْلِيكْ أَعْدَائِكْ، ويَحْصْرُوكْ ويْضَيْقُوا عْلِيكْ مِنْ كُلْ شِيرَة <verse eid="LUK 19:43" /><verse number="44" style="v" sid="LUK 19:44" />ويْهِدُّوكْ عَالسَّاكْنِينْ فِيكْ، ومَا يْخَلِّيوِشْ فِيكْ حَجْرَة فُوقْ الأُخْرَى، عْلَى خَاطْرِكْ مَا عْرَفْتِشْ الوَقْتْ الِّي جَاء فِيهْ اللَّهْ بَاشْ يْنَجِّيكْ».<verse eid="LUK 19:44" /></para>
  <para style="s">يَسُوعْ يْطَرِّدْ البَيَّاعَة مِالهَيْكِلْ</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45" />ومْبَعِّدْ دْخَلْ لِلْهَيْكِلْ، وبْدَا يْطَرِّدْ فِي النَّاسْ الِّي كَانُوا يْبِيعُوا ويِشْرِيوْ. <verse eid="LUK 19:45" /><verse number="46" style="v" sid="LUK 19:46" />وقَالِلْهُمْ: «مَكْتُوبْ: "دَارِي مَجْعُولَة بَاشْ تْكُونْ دَارْ لِلصْلَاةْ، آمَا إِنْتُومَا رَدِّيتُوهَا مْغَارَة مْتَاعْ سُرَّاقْ"». <verse eid="LUK 19:46" /><verse number="47" style="v" sid="LUK 19:47" />وكَانْ يْعَلِّمْ فِي الهَيْكِلْ كُلْ يُومْ. وكْبَارْ الكَهَنَة وعُلَمَاءْ الشَّرِيعَة وأَعْيَانْ الشَّعْبْ، كَانُوا يْحَاوْلُوا بَاشْ يُقْتْلُوهْ، <verse eid="LUK 19:47" /><verse number="48" style="v" sid="LUK 19:48" />آمَا مَا عَرْفُوشْ كِيفَاشْ. عْلَى خَاطِرْ الشَّعْبْ الكُلْ كَانُوا مِتْعَلْقِينْ بِيهْ ويْحِبُّوا يِسْمْعُوهْ.<verse eid="LUK 19:48" /></para>
  <chapter eid="LUK 19" />
  <chapter number="20" style="c" sid="LUK 20" />
  <para style="s">سُلْطِة يَسُوعْ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1" />وفِي نْهَارْ مِالنْهَارَاتْ، كَانْ يَسُوعْ يْعَلِّمْ ويْبَشِّرْ فِي الشَّعْبْ فِي الهَيْكِلْ، يَاخِي جَاوِهْ كْبَارْ الكَهَنَة وعُلَمَاءْ الشَّرِيعَة والشْيُوخْ، <verse eid="LUK 20:1" /><verse number="2" style="v" sid="LUK 20:2" />وقَالُولُو: «قُولِلْنَا، بَانَا سُلْطَة تَعْمِلْ فِي الحَاجَاتْ هَاذِي؟ وشْكُونْ عْطَاهَالِكْ السُّلْطَة؟». <verse eid="LUK 20:2" /><verse number="3" style="v" sid="LUK 20:3" />جَاوِبْهُمْ: «وآنَا زَادَا بِشْ نِسْإِلْكُمْ سُؤَالْ وَاحِدْ، وجَاوْبُونِي عْلِيهْ: <verse eid="LUK 20:3" /><verse number="4" style="v" sid="LUK 20:4" />شْكُونْ عْطَى السُّلْطَة لْيُوحَنَّا بَاشْ يْعَمِّدْ؟ اللَّهْ وَلَّا النَّاسْ؟».<verse eid="LUK 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5" />يَاخِي تْشَاوْرُوا مَا بِينَاتْهُمْ وقَالُوا: «إِذَا قُلْنَا: "مِنْ عَنْدْ اللَّهْ" تَوْ يْقُولْ: "مَالَا عْلَاشْ مَا أَمَّنْتُوشْ بِلِّي جَاء بِيهْ يُوحَنَّا؟". <verse eid="LUK 20:5" /><verse number="6" style="v" sid="LUK 20:6" />وإِذَا قُلْنَا "مِنْ عَنْدْ النَّاسْ"، الشَّعْبْ الكُلْ بِشْ يُرْجُمْنَا، عْلَى خَاطِرْهُمْ مُقْتَنْعِينْ الِّي يُوحَنَّا نَبِيْ». <verse eid="LUK 20:6" /><verse number="7" style="v" sid="LUK 20:7" />وَلَّاوْ جَاوْبُوهْ: «مَا نَعْرْفُوشْ مْنِينْ جَاتْ». <verse eid="LUK 20:7" /><verse number="8" style="v" sid="LUK 20:8" />يَاخِي قَالِلْهُمْ يَسُوعْ: «حَتَّى آنَا مَا نْقُلْكُمْشْ بَانَا سُلْطَة نَعْمِلْ فِي الحَاجَاتْ هَاذِي!».<verse eid="LUK 20:8" /></para>
  <para style="s">مَثَلْ الفَلَّاحَة</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9" />وقَالْ المَثَلْ هَاذَا لِلشَّعْبْ: «فَمَّة وَاحِدْ زْرَعْ سَانْيَة عْنِبْ، وكْرَاهَا لْفَلَّاحَة وسَافِرْ مُدَّة طْوِيلَة. <verse eid="LUK 20:9" /><verse number="10" style="v" sid="LUK 20:10" />وكِي طَابْ العْنِبْ، بْعَثْ وَاحِدْ مِنْ خُدَّامُو لِلْفَلَّاحَة بَاشْ يَاخِذْلُو بَايُو مِالصَّابَة. يَاخِي ضَرْبُوهْ ورَجْعُوهْ بِيدِيهْ فَارْغَة. <verse eid="LUK 20:10" /><verse number="11" style="v" sid="LUK 20:11" />وَلَّى بْعَثِّلْهُمْ خْدِيمْ آخِرْ، يَاخِي ضَرْبُوهْ هُوَّ زَادَا وهَانُوهْ ورَجْعُوهْ بِيدِيهْ فَارْغَة. <verse eid="LUK 20:11" /><verse number="12" style="v" sid="LUK 20:12" />زَادْ عَاوِدْ بْعَثِّلْهُمْ خْدِيمْ ثَالِثْ، يَاخِي جَرْحُوهْ ورْمَاوَهْ لْبَرَّا مِالسَّانْيَة. <verse eid="LUK 20:12" /><verse number="13" style="v" sid="LUK 20:13" />يَاخِي مُولَى السَّانْيَة قَالْ: "آشْ نَعْمِلْ؟ نَبْعْثِلْهُمْ وِلْدِي الِّي نْحِبُّو، بَالِكْشِي كِي يْشُوفُوهْ يْقَدْرُوهْ!". <verse eid="LUK 20:13" /><verse number="14" style="v" sid="LUK 20:14" />آمَا دُوبْ مَا شَافُوهْ الفَلَّاحَة، قَالُوا لِبْعَضْهُمْ: "هَاذَا هُوَّ الِّي بِشْ يُورِثْ، هَيَّا نُقْتْلُوهْ ونَاخْذُوا أَحْنَا الوَرْثَة!". <verse eid="LUK 20:14" /><verse number="15" style="v" sid="LUK 20:15" />ورْمَاوَهْ لْبَرَّة مِالسَّانْيَة وقَتْلُوهْ. وَقْتْهَا آشْ بِشْ يَعْمِلْ مْعَاهُمْ مُولَى السَّانْيَة؟ <verse eid="LUK 20:15" /><verse number="16" style="v" sid="LUK 20:16" />بِشْ يْجِي ويُقْتُلْ الفَلَّاحَة ويَعْطِي السَّانْيَة لْغِيرْهُمْ». وكِي سَمْعُوا النَّاسْ الكْلَامْ هَاذَا، قَالُوا: «لَا، أَبَدًا». <verse eid="LUK 20:16" /><verse number="17" style="v" sid="LUK 20:17" />خْزَرِّلْهُمْ يَسُوعْ وقَالْ: «مَالَا آشْ تُقْصُدْ الكْتُبْ المُقَدْسَة كِي قَالِتْ:</para>
  <para style="b" vid="LUK 20:17" />
  <para style="q1" vid="LUK 20:17">"الحَجْرَة الِّي رَفْضُوهَا البَنَّايَا،</para>
  <para style="q2" vid="LUK 20:17">وَلَّاتْ حَجْرِةْ السَّاسْ"؟<verse eid="LUK 20:17" /></para>
  <para style="b" />
  <para style="m">
    <verse number="18" style="v" sid="LUK 20:18" />«الِّي يْطِيحْ عَالحَجْرَة هَاذِي يِتْكَسِّرْ، ولِّي اطِّيحْ عْلِيهْ الحَجْرَة هَاذِي يِدَّڨْدِڨْ».<verse eid="LUK 20:18" /></para>
  <para style="s">الضَّرَايِبْ لِلْقَيْصِرْ</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19" />وحَبُّوا كْبَارْ الكَهَنَة وعُلَمَاءْ الشَّرِيعَة يْشِدُّوهْ وَقْتْهَا، آمَا خَافُوا مِالشَّعْبْ، عْلَى خَاطِرْهُمْ عَرْفُوا الِّي هُوَّ يُقْصُدْ فِيهُمْ بِالمَثَلْ هَاذَا. <verse eid="LUK 20:19" /><verse number="20" style="v" sid="LUK 20:20" />ووَلَّاوْ يْعِسُّوا عْلِيهْ، وبَعْثُوا وْرَاهْ نَاسْ عَامْلِينْ رْوَاحْهُمْ صَالْحِينْ بَاشْ يِتْجَسْسُوا عْلِيهْ، فَمَّاشِي مَا يْحَصْلُوهْ بْكِلْمَة يْقُولْهَا، ويْسَلْمُوهْ لِلْحَاكِمْ الرُّومَانِي والسُّلْطَة مْتَاعُو. <verse eid="LUK 20:20" /><verse number="21" style="v" sid="LUK 20:21" />يَاخِي سِأْلُوهْ: «يَا مُعَلِّمْ، أَحْنَا نَعْرْفُوا الِّي إِنْتِ صَادِقْ فِي كْلَامِكْ وفِي تَعْلِيمِكْ، ومَا تِتْعَامِلْشْ بِالوْجُوهْ، وتْعَلِّمْ طْرِيقْ اللَّهْ بِالحَقْ. <verse eid="LUK 20:21" /><verse number="22" style="v" sid="LUK 20:22" />يَاخِي حْلَالْ نَدْفْعُوا الضَّرَايِبْ لِلْقَيْصِرْ وَلَّا لَا؟». <verse eid="LUK 20:22" /><verse number="23" style="v" sid="LUK 20:23" />وعْرَفْ يَسُوعْ الِّي هُومَا يِتْخُوبْثُوا، وقَالِلْهُمْ: <verse eid="LUK 20:23" /><verse number="24" style="v" sid="LUK 20:24" />«وَرِّيوْنِي بْيَاسَة فُضَّة! مْتَاعْ شْكُونْ التَّصْوِيرَة هَاذِي، وإِسْمْ شْكُونْ هَاذَا؟». جَاوْبُوهْ: «مْتَاعْ القَيْصِرْ!» <verse eid="LUK 20:24" /><verse number="25" style="v" sid="LUK 20:25" />قَالِلْهُمْ: «مَالَا أَعْطِيوْ الِّي يْخُصْ القَيْصِرْ لِلْقَيْصِرْ، ولِّي يْخُصْ اللَّهْ لِلَّهْ!». <verse eid="LUK 20:25" /><verse number="26" style="v" sid="LUK 20:26" />ومَا نَجْمُوشْ يْحَصْلُوهْ بْحَتَّى كِلْمَة قُدَّامْ الشَّعْبْ، وتْعَجْبُوا مِالإِجَابَة مْتَاعُو وسِكْتُوا.<verse eid="LUK 20:26" /></para>
  <para style="s">القْيَامَة بَعْدْ المُوتْ</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27" />وجَاوَهْ جْمَاعَة مِالصَّدُّوقِيِّينْ الِّي يْقُولُوا مَا فَمَّاشْ قْيَامَة بَعْدْ المُوتْ، وسِأْلُوهْ: <verse eid="LUK 20:27" /><verse number="28" style="v" sid="LUK 20:28" />«يَا مُعَلِّمْ! مُوسَى كْتِبِّلْنَا: إِذَا وَاحِدْ مْعَرِّسْ مَاتْ، وخَلَّى مَرْتُو مِنْ بَعْدُو مِنْ غِيرْ مَا يْجِيبْ صْغَارْ، يِلْزِمْ خُوهْ يْعَرِّسْ بِيهَا ويْجِيبْ صْغَارْ ويْقَيِّدْهُمْ بْإِسْمْ خُوهْ الِّي مَاتْ. <verse eid="LUK 20:28" /><verse number="29" style="v" sid="LUK 20:29" />وكَانْ فَمَّة سَبْعَة خْوَاتْ، والأُوْلَانِي فِيهُمْ عَرِّسْ بِمْرَا ومَاتْ مِنْ غِيرْ مَا جَابْ صْغَارْ. <verse eid="LUK 20:29" /><verse number="30" style="v" sid="LUK 20:30" />يَاخِي عَرِّسْ بِيهَا الثَّانِي. <verse eid="LUK 20:30" /><verse number="31" style="v" sid="LUK 20:31" />ومْبَعِّدْ عَرِّسْ بِيهَا الثَّالِثْ، وهَكَّا عَرْسُوا بِيهَا السَّبْعَة وَاحِدْ بَعْدْ وَاحِدْ، والكُلْهُمْ مَاتُوا مِنْ غِيرْ مَا جَابُوا صْغَارْ. <verse eid="LUK 20:31" /><verse number="32" style="v" sid="LUK 20:32" />وبَعْدْهُمْ مَاتِتْ المْرَا زَادَا. <verse eid="LUK 20:32" /><verse number="33" style="v" sid="LUK 20:33" />مَالَا فِي نْهَارْ القْيَامَة، بِشْ تْكُونْ مَرْتْ شْكُونْ فِيهُمْ؟ هَايْ عَرْسِتْ بِيهُمْ السَّبْعَة!». <verse eid="LUK 20:33" /><verse number="34" style="v" sid="LUK 20:34" />جَاوِبْهُمْ يَسُوعْ: «النَّاسْ فِي الزْمَانْ هَاذَا يْعَرْسُوا ويْعَرْسُولْهُمْ. <verse eid="LUK 20:34" /><verse number="35" style="v" sid="LUK 20:35" />آمَا الِّي وَلَّاوْ يِسْتَاهْلُوا بَاشْ يْكُونْ عَنْدْهُمْ بَايْ فِي الزْمَانْ الجَايْ والقْيَامَة مِالمُوتْ، هَاذُوكُمْ لَا يْعَرْسُوا ولَا يْعَرْسُولْهُمْ. <verse eid="LUK 20:35" /><verse number="36" style="v" sid="LUK 20:36" />ومَا يْنَجْمُوشْ يْمُوتُوا بَعْدْهَا، عْلَى خَاطِرْهُمْ يْكُونُوا كِيمَا المْلَايْكَة. وهُومَا أَوْلَادْ اللَّهْ عْلَى خَاطِرْهُمْ قَامُوا مِالمُوتْ. <verse eid="LUK 20:36" /><verse number="37" style="v" sid="LUK 20:37" />ومُوسَى بِيدُو فِي حْكَايِةْ الْعُلِّيقَة وَرَّى الِّي المُوتَى يْقُومُوا، وَقْتِلِّي قَالْ عَالرَّبْ إِنُّو هُوَّ إِلَاهْ إِبْرَاهِيمْ وإِلَاهْ إِسْحَاقْ وإِلَاهْ يَعْقُوبْ. <verse eid="LUK 20:37" /><verse number="38" style="v" sid="LUK 20:38" />واللَّهْ مُشْ إِلَاهْ المُوتَى، آمَا إِلَاهْ الحَيِّينْ، وهُومَا الكُلْ حَيِّينْ عَنْدُو». <verse eid="LUK 20:38" /><verse number="39" style="v" sid="LUK 20:39" />يَاخِي جْمَاعَة مِنْ عُلَمَاءْ الشَّرِيعَة قَالُو: «يَا مُعَلِّمْ، يَعْطِيكْ الصَحَّة فِلِّي قُلْتُو». <verse eid="LUK 20:39" /><verse number="40" style="v" sid="LUK 20:40" />وبَعْدْهَا مَا تْجَرَّأْ حَتَّى حَدْ بَاشْ يِسْأْلُو عْلَى حَتَّى حَاجَة.<verse eid="LUK 20:40" /></para>
  <para style="s">المَسِيحْ ودَاوِدْ</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41" />وقَالِلْهُمْ: «كِيفَاشْ يْقُولُوا الِّي المَسِيحْ هُوَّ وِلْدْ دَاوِدْ، <verse eid="LUK 20:41" /><verse number="42" style="v" sid="LUK 20:42" />وَقْتِلِّي دَاوِدْ بِيدُو يْقُولْ فِي كْتَابْ المَزَامِيرْ:</para>
  <para style="b" vid="LUK 20:42" />
  <para style="q1" vid="LUK 20:42">"قَالْ اللَّهْ لْرَبِّي:</para>
  <para style="q2" vid="LUK 20:42">أُقْعُدْ عْلَى يْمِينِي<verse eid="LUK 20:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="LUK 20:43" />حَتَّى لِينْ نْحُطْ أَعْدَائِكْ تَحْتْ سَاقِيكْ"؟<verse eid="LUK 20:43" /></para>
  <para style="b" />
  <para style="m">
    <verse number="44" style="v" sid="LUK 20:44" />«إِذَا كَانْ دَاوِدْ يَعْيِّطْ لِلْمَسِيحْ رَبْ، مَالَا كِيفَاشْ يْكُونْ المَسِيحْ وِلْدُو؟».<verse eid="LUK 20:44" /></para>
  <para style="s">رُدُّوا بَالْكُمْ مِنْ عُلَمَاءْ الشَّرِيعَة</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45" />ووَقْتِلِّي الشَّعْبْ الكُلْ كَانْ يِسْمَعْ فِيهْ، قَالْ يَسُوعْ لِتْلَامِذْتُو: <verse eid="LUK 20:45" /><verse number="46" style="v" sid="LUK 20:46" />«رُدُّوا بَالْكُمْ مِنْ عُلَمَاءْ الشَّرِيعَة، الِّي يْحِبُّوا يْدُورُوا بِاللِّبْسَة الطْوِيلَة، ويْحِبُّوا النَّاسْ تْسَلِّمْ عْلِيهُمْ فِي الأَسْوَاقْ، ويُقْعْدُوا فِي الصَّفْ الأُوِّلْ فِي المْعَابِدْ وفِي أَحْسِنْ البْلَايِصْ فِي المْحَافِلْ. <verse eid="LUK 20:46" /><verse number="47" style="v" sid="LUK 20:47" />وهُومَا يِنْهْبُوا فِي فْلُوسْ الهَجَّالَاتْ، ويْطَوْلُوا فِي الصْلَاةْ بَاشْ النَّاسْ تْرَاهُمْ. هَاذُوكُمْ حْسَابْهُمْ بِشْ يْكُونْ أَكْثِرْ مِنْ غِيرْهُمْ!».<verse eid="LUK 20:47" /></para>
  <chapter eid="LUK 20" />
  <chapter number="21" style="c" sid="LUK 21" />
  <para style="s">التَّبَرُّعَاتْ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1" />خْزَرْ يَسُوعْ، وشَافْ الغْنِيِّينْ يْحُطُّوا فِي الفْلُوسْ فِي صَنْدُوقْ التَّبَرُّعَاتْ الِّي فِي الهَيْكِلْ. <verse eid="LUK 21:1" /><verse number="2" style="v" sid="LUK 21:2" />وشَافْ زَادَا مْرَا هَجَّالَة وفْقِيرَة، حَطِّتْ زُوزْ فْرَنْكْ. <verse eid="LUK 21:2" /><verse number="3" style="v" sid="LUK 21:3" />يَاخِي قَالْ: «نْقُلْكُمْ الحَقْ، هَا المْرَا الهَجَّالَة الفْقِيرَة حَطِّتْ أَكْثِرْ مِنْهُمْ الكُلْ. <verse eid="LUK 21:3" /><verse number="4" style="v" sid="LUK 21:4" />عْلَى خَاطِرْهُمْ الكُلْ عْطَاوْ مِالفَاضِلْ عْلِيهُمْ، آمَا هِيَّ رَغْمِلِّي مِحْتَاجَة، حَطِّتْ الفْلُوسْ الِّي تْعِيشْ بِيهُمْ الكُلْ».<verse eid="LUK 21:4" /></para>
  <para style="s">عَلَامَاتْ نْهَايِةْ الزْمَانْ</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5" />وكَانْ فَمَّة جْمَاعَة يَحْكِيوْ عَالهَيْكِلْ، وكِيفَاشْ مْزَيِّنْ بِالحْجَرْ المِزْيَانْ، والتُّحَفْ الِّي عْطَاوْهَا النَّاسْ هْدِيَّة لِلَّهْ. يَاخِي يَسُوعْ قَالْ: <verse eid="LUK 21:5" /><verse number="6" style="v" sid="LUK 21:6" />«بِشْ يْجِي وَقْتْ، كُلْ الِّي تْشُوفُوا فِيهْ بِشْ يِتْهَدْ، ولَا حَجْرَة مِنُّو بِشْ تِبْقَى فُوقْ أُخْتْهَا». <verse eid="LUK 21:6" /><verse number="7" style="v" sid="LUK 21:7" />سِأْلُوهْ: «يَا مُعَلِّمْ! وَقْتَاشْ بِشْ يْصِيرْ هَاذَا؟ وشْنِيَّة الأَمَارَة الِّي تْوَرِّي إِنُّو هَاذَا قْرِيبْ يْصِيرْ؟».<verse eid="LUK 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8" />جَاوِبْهُمْ: «رُدُّوا بَالْكُمْ لَا يْغُرُّوا بِيكُمْ! عْلَى خَاطِرْ بِشْ يْجِيوْ بَرْشَة بْإِسْمِي ويْقُولُوا: "آنَا هُوَّ المَسِيحْ، والوَقْتْ قْرُبْ!". مَا اتَّبْعُوهُمْشْ. <verse eid="LUK 21:8" /><verse number="9" style="v" sid="LUK 21:9" />وكِي تِسْمْعُوا بِالحْرُوبَاتْ والثَّوْرَاتْ مَا تْخَافُوشْ، عْلَى خَاطِرْ هَاذَا لَازْمُو يْصِيرْ قْبَلْ، آمَا النْهَايَة مَا تْجِيشْ بَعْدْهَا بِالضَّبْطْ».<verse eid="LUK 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10" />مْبَعِّدْ قَالِلْهُمْ: «بِشْ تِتْقْلِبْ أُمَّة عْلَى أُمَّة، ومَمْلْكَة عْلَى مَمْلْكَة، <verse eid="LUK 21:10" /><verse number="11" style="v" sid="LUK 21:11" />وبِشْ تْصِيرْ زْلَازِلْ قْوِيَّة فِي بَرْشَة بْلَايِصْ، وبَرْشَة مَجَاعَاتْ وأَوْبْئَة، وتْصِيرْ حَاجَاتْ تْخَوِّفْ، وتُظْهُرْ أَمَايِرْ عْظِيمَة فِي السْمَاء.<verse eid="LUK 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 21:12" />«آمَا قْبَلْ هَاذَا الكُلْ، يْشِدُّوكُمْ ويِضْطَهْدُوكُمْ، ويْهِزُّوكُمْ لِلْمْعَابِدْ والحْبُوسَاتْ، ويْوَقْفُوكُمْ قُدَّامْ المُلُوكْ والحُكَّامْ عْلَى خَاطِرْ إِسْمِي. <verse eid="LUK 21:12" /><verse number="13" style="v" sid="LUK 21:13" />وهَاذِي بِشْ تْكُونِلْكُمْ فُرْصَة بَاشْ تِشْهْدُولِي. <verse eid="LUK 21:13" /><verse number="14" style="v" sid="LUK 21:14" />ومَا تُقْعْدُوشْ تْخَمُّوا بِالمْسَبَقْ كِيفَاشْ بِشْ ادَّافْعُوا عْلَى رْوَاحْكُمْ. <verse eid="LUK 21:14" /><verse number="15" style="v" sid="LUK 21:15" />عْلَى خَاطِرْنِي آنَا بِشْ نَعْطِيكُمْ كْلَامْ وحِكْمَة، مَا يْنَجِّمْ حَتَّى حَدْ مِلِّي ضِدْكُمْ يْقَاوِمْهَا وَلَّا يْعَارِضْهَا. <verse eid="LUK 21:15" /><verse number="16" style="v" sid="LUK 21:16" />وحَتَّى وَالْدِيكُمْ وخْوَاتْكُمْ وأَقَارِبْكُمْ وأَصْحَابْكُمْ بِشْ يْسَلْمُوكُمْ لِلْحَاكِمْ، ويُقْتْلُوا نَاسْ مِنْكُمْ. <verse eid="LUK 21:16" /><verse number="17" style="v" sid="LUK 21:17" />وبِشْ يِكْرْهُوكُمْ النَّاسْ الكُلْ عْلَى خَاطِرْ إِسْمِي. <verse eid="LUK 21:17" /><verse number="18" style="v" sid="LUK 21:18" />آمَا حَتَّى شَعْرَة مِنْ رْيُوسْكُمْ مَا اطِّيحْ. <verse eid="LUK 21:18" /><verse number="19" style="v" sid="LUK 21:19" />شِدُّوا صْحِيحْ، تِنْجَاوْ.<verse eid="LUK 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20" />«ووَقْتِلِّي تْشُوفُوا أُورْشَلِيمْ مْحَاصْرَة بِالجْيُوشْ، أَعْرْفُوهَا الِّي هِيَّ بِشْ تِتْخْرِبْ عْلَى قْرِيبْ. <verse eid="LUK 21:20" /><verse number="21" style="v" sid="LUK 21:21" />وَقْتْهَا يِلْزِمْ الِّي فِي مَنْطَقْةْ اليَهُودِيَّة يُهْرْبُوا لِلجْبَالْ، ولِّي فِي أُورْشَلِيمْ يَرْحْلُوا مِنْهَا ولِّي فِي الأَرْيَافْ مَا يُدْخْلُولْهَاشْ. <verse eid="LUK 21:21" /><verse number="22" style="v" sid="LUK 21:22" />عْلَى خَاطِرْ الوَقْتْ هَاذَاكَا وَقْتْ إِنْتِقَامْ، يْتِمْ فِيهْ كُلْ الِّي تِكْتِبْ فِي الكْتُبْ المُقَدْسَة. <verse eid="LUK 21:22" /><verse number="23" style="v" sid="LUK 21:23" />يَا وِيلْهُمْ النْسَاء الحْبَالَى ولِّي يْرَضْعُوا فِي الأَيَّامَاتْ هَاذُوكُمْ! عْلَى خَاطِرْ ضِيقَة عْظِيمَة بِشْ تْصِيرْ عَالأَرْضْ، وغَضَبْ اللَّهْ يَهْبِطْ عَالشَّعْبْ هَاذَا. <verse eid="LUK 21:23" /><verse number="24" style="v" sid="LUK 21:24" />ويْمُوتُوا مَقْتُولِينْ بِالسْيُوفَا ويِتْسْبَاوْ عَنْدْ شْعُوبْ العَالِمْ الكُلْ، وتُقْعُدْ أُورْشَلِيمْ يْعَفْسُوا فِيهَا الشُّعُوبْ الأُخْرِينْ حَتَّى لِينْ يِكْمِلْ وَقْتْهُمْ.<verse eid="LUK 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25" />«وبِشْ تْصِيرْ أَمَايِرْ فِي الشَّمْسْ والڨَمْرَة والنْجُومْ، وفِي الأَرْضْ، الشُّعُوبْ يْكُونُوا فِي ضِيقْ وحِيرَة، عْلَى خَاطِرْ البْحَرْ يْكُونْ هَايِجْ ومُوجُو عَالِي. <verse eid="LUK 21:25" /><verse number="26" style="v" sid="LUK 21:26" />والنَّاسْ بِشْ يْمُوتُوا مِالرُّعْبْ، ومِنْ خُوفْهُمْ مِلِّي بِشْ يْصِيرْ لِلْعَالِمْ، عْلَى خَاطِرْ السْمَاء بِشْ تِتْزَعْزَعْ. <verse eid="LUK 21:26" /><verse number="27" style="v" sid="LUK 21:27" />وَقْتْهَا يْشُوفُوا إِبْنْ الإِنْسَانْ جَايْ فِي السْحَابْ بْقُوَّة ومَجْدْ عْظِيمْ. <verse eid="LUK 21:27" /><verse number="28" style="v" sid="LUK 21:28" />وإِذَا بْدَاتْ الأُمُورْ هَاذِي تْصِيرْ، آقْفُوا وهِزُّوا رْيُوسْكُمْ، عْلَى خَاطِرْ بِشْ تِنْجَاوْ عْلَى قْرِيبْ».<verse eid="LUK 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29" />وعْطَاهُمْ المَثَلْ هَاذَا: «أُخْزْرُوا لِلْكَرْمَة وبْقِيِّةْ الشْجَرْ. <verse eid="LUK 21:29" /><verse number="30" style="v" sid="LUK 21:30" />كِي تْشُوفُوهُمْ بْدَاوْ يْطَلّْعُوا فِي الأَوْرَاقْ، تَعْرْفُوا وَحَّدْكُمْ الِّي الصِّيفْ قْرُبْ. <verse eid="LUK 21:30" /><verse number="31" style="v" sid="LUK 21:31" />وإِنْتُومَا زَادَا، كِي تْشُوفُوا الحَاجَاتْ هَاذِي قَاعْدَة تْصِيرْ، أَعْرْفُوا الِّي مَمْلَكْةْ اللَّهْ قُرْبِتْ. <verse eid="LUK 21:31" /><verse number="32" style="v" sid="LUK 21:32" />نْقُلْكُمْ الحَقْ، الحَاجَاتْ هَاذِي الكُلْ بِشْ تْصِيرْ قْبَلْ مَا يْمُوتْ الجِيلْ هَاذَا. <verse eid="LUK 21:32" /><verse number="33" style="v" sid="LUK 21:33" />السْمَاء والأَرْضْ يِفْنَاوْ، آمَا كْلَامِي عُمْرُو مَا يِفْنَى.<verse eid="LUK 21:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34" />«رُدُّوا بَالْكُمْ تُقْعْدُوا لَاهِينْ بِالسِّكْرَة والشِّيخَاتْ وَلَّا بِهْمُومْ الدِّنْيَا، لَا يْجِيكُمْ النْهَارْ هَاذَاكَا عْلَى غَفْلَة، <verse eid="LUK 21:34" /><verse number="35" style="v" sid="LUK 21:35" />عْلَى خَاطْرُو بِشْ يِتْسَكِّرْ كِي المِنْدَافْ عْلَى سُكَّانْ الأَرْضْ الكُلْ. <verse eid="LUK 21:35" /><verse number="36" style="v" sid="LUK 21:36" />مَالَا خَلِّيكُمْ فَايْقِينْ وصَلِّيوْ فِي كُلْ وَقْتْ، بَاشْ تْنَجْمُوا تِمْنْعُوا مِنْ كُلْ الِّي بِشْ يْصِيرْ، وتَاقْفُوا قُدَّامْ إِبْنْ الإِنْسَانْ».<verse eid="LUK 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37" />وكَانْ يَسُوعْ يْعَلِّمْ فِي الهَيْكِلْ فِي النْهَارْ، وفِي اللِّيلْ يِمْشِي يْبَاتْ فِي الجْبَلْ الِّي يِتْسَمَّى جْبَلْ الزِّيتُونْ. <verse eid="LUK 21:37" /><verse number="38" style="v" sid="LUK 21:38" />وكَانْ الشَّعْبْ الكُلْ يْجِيهْ عَالصْبَاحْ بِكْرِي لِلْهَيْكِلْ بَاشْ يِسْمْعُوهْ.<verse eid="LUK 21:38" /></para>
  <chapter eid="LUK 21" />
  <chapter number="22" style="c" sid="LUK 22" />
  <para style="s">المُؤَامْرَة ضِدْ يَسُوعْ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1" />وقْرُبْ عِيدْ الفْطِيرْ المَعْرُوفْ بْعِيدْ الفِصْحْ. <verse eid="LUK 22:1" /><verse number="2" style="v" sid="LUK 22:2" />وكَانُوا كْبَارْ الكَهَنَة وعُلَمَاءْ الشَّرِيعَة يْلَوْجُوا عْلَى طَرِيقَة يُقْتْلُوا بِيهَا يَسُوعْ، عْلَى خَاطِرْ كَانُوا خَايْفِينْ مِالشَّعْبْ.<verse eid="LUK 22:2" /></para>
  <para style="s">خْيَانِةْ يَهُوذَا</para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 22:3" />ودْخَلْ الشِّيطَانْ فِي يَهُوذَا الِّي يْسَمِّيوَهْ الإِسْخَرْيُوطِي، وهُوَّ وَاحِدْ مِالتْلَامْذَة الأَثْنَاشْ. <verse eid="LUK 22:3" /><verse number="4" style="v" sid="LUK 22:4" />وَلَّى مْشَى لِكْبَارْ الكَهَنَة وقَادِةْ حَرَسْ الهَيْكِلْ وتْفَاهِمْ مْعَاهُمْ كِيفَاشْ بِشْ يْسَلَّمْهُولْهُمْ. <verse eid="LUK 22:4" /><verse number="5" style="v" sid="LUK 22:5" />يَاخِي فِرْحُوا ووِعْدُوهْ بِشْ يَعْطِيوَهْ فْلُوسْ. <verse eid="LUK 22:5" /><verse number="6" style="v" sid="LUK 22:6" />وهُوَّ رْضَى، وقْعَدْ يِسْتَنَّى فِي فُرْصَة بَاشْ يْسَلَّمْهُولْهُمْ بِالسِّرْقَة عَالشَّعْبْ.<verse eid="LUK 22:6" /></para>
  <para style="s">عْشَاء الفِصْحْ</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7" />وجَاء نْهَارْ عِيدْ الفْطِيرْ الِّي كَانْ لَازِمْ يِتْذْبَحْ فِيهْ عَلُّوشْ الفِصْحْ. <verse eid="LUK 22:7" /><verse number="8" style="v" sid="LUK 22:8" />يَاخِي بْعَثْ يَسُوعْ بُطْرُسْ ويُوحَنَّا وقَالِلْهُمْ: «إِمْشِيوْ حَضْرُولْنَا عْشَاء الفِصْحْ، بَاشْ نَاكْلُوهْ». <verse eid="LUK 22:8" /><verse number="9" style="v" sid="LUK 22:9" />سِأْلُوهْ: «وِينْ تْحِبْنَا نْحَضْرُوهْ؟». <verse eid="LUK 22:9" /><verse number="10" style="v" sid="LUK 22:10" />قَالِلْهُمْ: «دُوبْ مَا تُدْخْلُوا لِلْمْدِينَة، يُعْرِضْكُمْ وَاحِدْ هَازِزْ قُلَّة مَاء. تَبْعُوهْ لِلدَّارْ الِّي بِشْ يُدْخْلِلْهَا، <verse eid="LUK 22:10" /><verse number="11" style="v" sid="LUK 22:11" />وقُولُوا لْمُولَى الدَّارْ هَاذِيكَا: "قَالِّكْ المُعَلِّمْ: وِينِي البِيتْ الِّي بِشْ نَاكِلْ فِيهَا عْشَاء الفِصْحْ مْعَ تْلَامِذْتِي؟". <verse eid="LUK 22:11" /><verse number="12" style="v" sid="LUK 22:12" />وهُوَّ تَوْ يْوَرِّيكُمْ بَيْتْ كْبِيرَة فِي الطَّاقْ الفُوقَانِي، وَاسْعَة ومَفْرُوشَة، حَضْرُوا العْشَاء غَادِي». <verse eid="LUK 22:12" /><verse number="13" style="v" sid="LUK 22:13" />مْشَاوْ، ولْقَاوْ كُلْ شَيْ كِيمَا قَالِلْهُمْ، وحَضْرُوا عْشَاء الفِصْحْ.<verse eid="LUK 22:13" /></para>
  <para style="s">عَشَاء الرَّبْ</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14" />وكِي جَاء الوَقْتْ قْعَدْ هُوَّ والرُّسُلْ. <verse eid="LUK 22:14" /><verse number="15" style="v" sid="LUK 22:15" />وقَالِلْهُمْ: «قَدَّاشْ شْتْهِيتْ نَاكِلْ عْشَاء الفِصْحْ مْعَاكُمْ قْبَلْ مَا نِتْعَذَّبْ. <verse eid="LUK 22:15" /><verse number="16" style="v" sid="LUK 22:16" />ونْقُولِلْكُمْ: مَا عَادِشْ بِشْ نَاكِلْ مِنُّو مَرَّة أُخْرَى، حَتَّى يِتْحَقَّقْ المَقْصُودْ بِيهْ فِي مَمْلَكْةْ اللَّهْ». <verse eid="LUK 22:16" /><verse number="17" style="v" sid="LUK 22:17" />وخْذَا كَاسْ وشْكَرْ وقَالْ: «خُوذُوا الكَاسْ هَاذَا وإِقْسْمُوا العَصِيرْ بِينَاتْكُمْ. <verse eid="LUK 22:17" /><verse number="18" style="v" sid="LUK 22:18" />نْقُولِلْكُمْ: مَا عَادِشْ بِشْ نُشْرُبْ مَرَّة أُخْرَى مِنْ عَصِيرْ العْنِبْ حَتَّى لِينْ تْجِي مَمْلَكْةْ اللَّهْ».<verse eid="LUK 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19" />وخْذَا الخُبْزْ وشْكَرْ وقْسِمْ، وعْطَاهُمْ وقَالْ: «هَاذَا بَدْنِي الِّي يِتْعْطَى عْلَى خَاطِرْكُمْ. أَعْمْلُوا هَاذَا بَاشْ تِتْذَكْرُونِي». <verse eid="LUK 22:19" /><verse number="20" style="v" sid="LUK 22:20" />وكِيفْ كِيفْ خْذَا الكَاسْ بَعْدْ العْشَاء وقَالْ: «هَاذَا الكَاسْ هُوَّ العَهْدْ الجْدِيدْ الِّي يَعْمْلُو اللَّهْ بْدَمِّي الِّي بِشْ يْسِيلْ عْلَى خَاطِرْكُمْ. <verse eid="LUK 22:20" /><verse number="21" style="v" sid="LUK 22:21" />آمَا رَاهُو الِّي بِشْ يْخُونِّي قَاعِدْ مْعَايَا عَالطَّاوْلَة. <verse eid="LUK 22:21" /><verse number="22" style="v" sid="LUK 22:22" />وإِبْنْ الإِنْسَانْ بِشْ يْمُوتْ كِيمَا اللَّهْ قَرَّرْ، آمَا يَا وِيلُو الِّي بِشْ يْخُونُو!» <verse eid="LUK 22:22" /><verse number="23" style="v" sid="LUK 22:23" />وبْدَاوْ التْلَامْذَة يِسْأْلُوا فِي بْعَضْهُمْ: «شْكُونْ فِينَا الِّي بِشْ يَعْمِلْ هَا الْعَمْلَة؟».<verse eid="LUK 22:23" /></para>
  <para style="s">شْكُونُو الأَعْظَمْ؟</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24" />وبَعْدْ بْوَقْتْ، صَارْ بِينَاتْهُمْ نِقَاشْ عْلَى شْكُونْ فِيهُمْ أَعْظِمْ مِالآخِرْ. <verse eid="LUK 22:24" /><verse number="25" style="v" sid="LUK 22:25" />يَاخِي قَالِلْهُمْ يَسُوعْ: «المُلُوكْ يِتْحَكْمُوا فِي شُعُوبْهُمْ، وأَصْحَابْ السُّلْطَة يْقُولُوا عْلِيهُمْ مُحْسْنِينْ. <verse eid="LUK 22:25" /><verse number="26" style="v" sid="LUK 22:26" />آمَا إِنْتُومَا مَا تْكُونُوشْ كِيفْهُمْ، بِالعَكْسْ، أَعْظَمْ وَاحِدْ فِيكُمْ يِلْزْمُو يْكُونْ كِيمَا أَصْغِرْ وَاحِدْ، والقَايِدْ يْكُونْ كِيمَا الخْدِيمْ. <verse eid="LUK 22:26" /><verse number="27" style="v" sid="LUK 22:27" />شْكُونُو الأَعْظَمْ: الِّي قَاعِدْ يَاكِلْ عَالطَّاوْلَة وَلَّا الِّي يِخْدِمْ فِيهْ؟ يَاخِي مُشْ الِّي قَاعِدْ عَالطَّاوْلَة؟ آمَا آنَا بِينَاتْكُمْ كِيمَا الِّي يِخْدِمْ.<verse eid="LUK 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 22:28" />«إِنْتُومَا هُومَا الِّي وْقِفْتُوا مْعَايَا فِي وَقْتْ مِحْنْتِي، <verse eid="LUK 22:28" /><verse number="29" style="v" sid="LUK 22:29" />هَاذَاكَا عْلَاشْ بِشْ نَعْطِيكُمْ السُّلْطَة بَاشْ تِمْلْكُوا كِيمَا عْطَانِي بَابَا السُّلْطَة بَاشْ نِمْلِكْ، <verse eid="LUK 22:29" /><verse number="30" style="v" sid="LUK 22:30" />بَاشْ تَاكْلُوا وتُشْرْبُوا عْلَى طَاوِلْتِي فِي مَمْلَكْتِي، وتُقْعْدُوا عْلَى كْرَاسِي المُلْكْ وتُحْكْمُوا عْلَى عْرُوشَاتْ بَنِي إِسْرَائِيلْ الأَثْنَاشْ».<verse eid="LUK 22:30" /></para>
  <para style="s">يَسُوعْ يِتْنَبَّأْ الِّي بُطْرُسْ بَاشْ يُنْكْرُو</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31" />وقَالْ الرَّبْ يَسُوعْ: «سِمْعَانْ! سِمْعَانْ! هَاوْ الشِّيطَانْ طْلَبْ إِنُّو يْغَرْبِلْكُمْ كِيمَا يِتْغَرْبِلْ القَمْحْ. <verse eid="LUK 22:31" /><verse number="32" style="v" sid="LUK 22:32" />آمَا آنَا صَلِّيتْ عْلَى خَاطْرِكْ، بَاشْ إِيمَانِكْ مَا يِفْنَاشْ. وإِنْتِ وَقْتِلِّي تِرْجَعْلِي قَوِّي خْوَاتِكْ». <verse eid="LUK 22:32" /><verse number="33" style="v" sid="LUK 22:33" />يَاخِي قَالُّو سِمْعَانْ: «يَا سِيدِي، آنَا مُسْتْعَدْ نِمْشِي مْعَاكْ لِلْحَبْسْ ولِلْمُوتْ». <verse eid="LUK 22:33" /><verse number="34" style="v" sid="LUK 22:34" />قَالُّو يَسُوعْ: «آنَا نْقُلِّكْ يَا بُطْرُسْ، اليُومْ، قْبَلْ مَا يْصِيحْ السَّرْدُوكْ تْكُونْ إِنْتْ نْكَرْتْ إِنِّكْ تَعْرَفْنِي ثْلَاثَة مَرَّاتْ».<verse eid="LUK 22:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35" />ومْبَعِّدْ قَالِلْهُمْ: «كِي بْعَثْتْكُمْ مِنْ غِيرْ فْلُوسْ ولَا صُرَّة ولَا صَنْدَالْ، اسْتْحَقِّيتُوشِي حَاجَة؟». قَالُوا: «لَا». <verse eid="LUK 22:35" /><verse number="36" style="v" sid="LUK 22:36" />يَاخِي قَالِلْهُمْ: «آمَا تَوَّا، الِّي عَنْدُو فْلُوسْ يْهِزْهُمْ، ولِّي عَنْدُو صُرَّة كِيفْ كِيفْ. ولِّي مَا عَنْدُوشْ سِيفْ، يْبِيعْ حْوَايْجُو ويِشْرِي سِيفْ. <verse eid="LUK 22:36" /><verse number="37" style="v" sid="LUK 22:37" />ونْقُولِلْكُمْ: الِّي تِكْتِبْ، "وحِسْبُوهْ مْعَ المُجْرْمِينْ" لَازْمُو يِتْحَقَّقْ فِيَّا آنَا، عْلَى خَاطِرْ الِّي يْخُصْنِي لَازْمُو يْتِمْ». <verse eid="LUK 22:37" /><verse number="38" style="v" sid="LUK 22:38" />قَالُوا التْلَامْذَة: «يَا سِيدْنَا، هَاوْ عَنْدْنَا زُوزْ سْيُوفَا». قَالِلْهُمْ يَسُوعْ: «يِزِّيوْ!».<verse eid="LUK 22:38" /></para>
  <para style="s">يَسُوعْ يْصَلِّي فِي جْبَلْ الزِّيتُونْ</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39" />ومْبَعِّدْ خْرَجْ ومْشَى كِي عَادْتُو لِجْبَلْ الزِّيتُونْ، وتْلَامِذْتُو تَبْعُوهْ. <verse eid="LUK 22:39" /><verse number="40" style="v" sid="LUK 22:40" />وَقْتِلِّي وْصِلْ لِلْبْلَاصَة قَالِلْهُمْ: «صَلِّيوْ بَاشْ مَا تُدْخْلُوشْ فِي تَجْرْبَة». <verse eid="LUK 22:40" /><verse number="41" style="v" sid="LUK 22:41" />وبْعِدْ عْلِيهُمْ شْوَيَّة، ورْكَعْ وبْدَا يْصَلِّي: <verse eid="LUK 22:41" /><verse number="42" style="v" sid="LUK 22:42" />وقَالْ: «يَا بَابَا، كَانْ تْحِبْ، بَعِّدْ عْلِيَّا هَا الكَاسْ. آمَا خَلِّي يْصِيرْ الِّي تْحِبْ عْلِيهْ إِنْتِ، مُشْ الِّي نْحِبْ عْلِيهْ آنَا». <verse eid="LUK 22:42" /><verse number="43" style="v" sid="LUK 22:43" />وظْهُرْلُو مَلَاكْ مِالسْمَاء يْقَوِّي فِيهْ. <verse eid="LUK 22:43" /><verse number="44" style="v" sid="LUK 22:44" />وكَانْ حَاسِسْ بْضِيقْ كْبِيرْ، يَاخِي بْدَى يْصَلِّي بِحْرَارَة، والعْرَقْ مْتَاعُو وَلَّى كِي قَطْرَاتْ الدَّمْ هَابْطَة عَالقَاعَة.<verse eid="LUK 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45" />مْبَعِّدْ قَامْ مِالصْلَاةْ ورْجَعْ لِتْلَامِذْتُو، يَلْقَاهُمْ رَاقْدِينْ مِنْ كُثْرِتْ مَا كَانُوا حْزَانَى. <verse eid="LUK 22:45" /><verse number="46" style="v" sid="LUK 22:46" />وقَالِلْهُمْ: «شْبِيكُمْ رَاقْدِينْ؟ قُومُوا صَلِّيوْ بَاشْ مَا تُدْخْلُوشْ فِي مِحْنَة».<verse eid="LUK 22:46" /></para>
  <para style="s">يَسُوعْ يِتْشَدْ</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47" />وهُوَّ مَزَّالْ يِتْكَلِّمْ، جَاوْ جْمَاعَة كَانْ جَايِبْهُمْ يَهُوذَا، الِّي هُوَّ وَاحِدْ مِالأَثْنَاشْ. وقْرُبْ مِنْ يَسُوعْ بَاشْ يْبُوسُو. <verse eid="LUK 22:47" /><verse number="48" style="v" sid="LUK 22:48" />قَالُّو يَسُوعْ: «يَا يَهُوذَا، إِبُّوسَة تْخُونْ إِبْنْ الإِنْسَانْ؟». <verse eid="LUK 22:48" /><verse number="49" style="v" sid="LUK 22:49" />وكِي فِهْمُوا تْلَامِذْتُو الِّي بِشْ يْصِيرْ قَالُوا: «يَا سِيدْنَا، نَضْرْبُوا بِالسْيُوفَا؟». <verse eid="LUK 22:49" /><verse number="50" style="v" sid="LUK 22:50" />ووَاحِدْ مِنْهُمْ ضْرَبْ خْدِيمْ الكَاهِنْ الكْبِيرْ وقَصْلُو وِذْنُو اليْمِينْ. <verse eid="LUK 22:50" /><verse number="51" style="v" sid="LUK 22:51" />آمَا يَسُوعْ قَالْ: «يِزِّي، حَدْكُمْ هُونِي!» ومَسْ وْذِنْ الرَّاجِلْ وشْفَاهْ. <verse eid="LUK 22:51" /><verse number="52" style="v" sid="LUK 22:52" />وقَالْ يَسُوعْ لِكْبَارْ الكَهَنَة وقَادِةْ حَرَسْ الهَيْكِلْ والشْيُوخْ الِّي جَاوُوهْ: «يَاخِي آنَا سَارَقْ بَاشْ تْجِيوْنِي بِالسْيُوفَا والعْصِي؟ <verse eid="LUK 22:52" /><verse number="53" style="v" sid="LUK 22:53" />كُنْتْ كُلْ يُومْ مْعَاكُمْ فِي الهَيْكِلْ، وحَدْ مَا مَدْ يِدُّو عْلِيَّا. آمَا تَوَّا هَاذَا وَقْتْكُمْ، تَوَّا قُوَّاتْ الشَّرْ تْسَيْطِرْ فِي الظْلَامْ». <verse eid="LUK 22:53" /><verse number="54" style="v" sid="LUK 22:54" />يَاخِي شَدُّوهْ وكَرْكْرُوهْ وهَزُّوهْ لْدَارْ كْبِيرْ الكَهَنَة. وبُطْرُسْ كَانْ يْتَبَّعْ فِيهْ مِنْ بْعِيدْ.<verse eid="LUK 22:54" /></para>
  <para style="s">بُطْرُسْ يُنْكُرْ يَسُوعْ</para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 22:55" />وشَعْلُوا نَارْ فِي الوِسْطِيَّة مْتَاعْ الدَّارْ وقَعْدُوا دَايْرِينْ بِيهَا، وقْعَدْ بُطْرُسْ مْعَاهُمْ. <verse eid="LUK 22:55" /><verse number="56" style="v" sid="LUK 22:56" />وفَمَّة خْدِيمَة شَافِتُّو قَاعِدْ بَحْذَا النَّارْ، ثَبْتِتْ فِيهْ وقَالِتْ: «الرَّاجِلْ هَاذَا زَادَا كَانْ مْعَاهْ». <verse eid="LUK 22:56" /><verse number="57" style="v" sid="LUK 22:57" />آمَا هُوَّ نْكَرْ وقَالْ: «يَا مْرَا، آنَا مَا نَعْرْفُوشْ!». <verse eid="LUK 22:57" /><verse number="58" style="v" sid="LUK 22:58" />وبَعْدْ شْوَيَّة شَافُو وَاحِدْ آخِرْ وقَالْ: «إِنْتِ زَادَا وَاحِدْ مِنْهُمْ». آمَا بُطْرُسْ قَالْ: «لَا يَا رَاجِلْ، مَانِيشْ آنَا!». <verse eid="LUK 22:58" /><verse number="59" style="v" sid="LUK 22:59" />وبَعْدْمَا تْعَدَّاتْ حْكَايِةْ سَاعَة، فَمَّة وَاحِدْ آخِرْ شَدْ صْحِيحْ وقَالْ: «بِالحَقْ هَاذَا كَانْ مْعَاهْ زَادَا، عْلَى خَاطْرُو مِالجَلِيلْ!». <verse eid="LUK 22:59" /><verse number="60" style="v" sid="LUK 22:60" />وبُطْرُسْ قَالْ: «يَا رَاجِلْ، فَاشْ قَاعِدْ تَحْكِي!». وهُوَّ مَزَّالْ يِتْكَلِّمْ، السَّرْدُوكْ صَاحْ. <verse eid="LUK 22:60" /><verse number="61" style="v" sid="LUK 22:61" />وتْلَفِّتْ الرَّبْ وخْزَرْ لْبُطْرُسْ، يَاخِي تْذَكِّرْ بُطْرُسْ كْلَامْ الرَّبْ كِي قَالُّو: «قْبَلْ مَا يْصِيحْ السَّرْدُوكْ، إِنْتِ بِشْ تُنْكُرْنِي ثْلَاثَة مَرَّاتْ». <verse eid="LUK 22:61" /><verse number="62" style="v" sid="LUK 22:62" />وخْرَجْ بُطْرُسْ لْبَرَّا وبْدَا يِبْكِي بِالشَّهْقَة.<verse eid="LUK 22:62" /></para>
  <para style="s">الحُرَّاسْ يِتْمَسْخْرُوا عْلَى يَسُوعْ</para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63" />والرْجَالْ الِّي كَانُوا يْعِسُّوا عْلَى يَسُوعْ، بْدَاوْ يِتْمَسْخْرُوا عْلِيهْ ويَضْرْبُوا فِيهْ، <verse eid="LUK 22:63" /><verse number="64" style="v" sid="LUK 22:64" />ويْغَطِّيوْلُو فِي وِجْهُو ويِسْأْلُوا فِيهْ: «تْرَاهْ، تْنَبَّأْ شْكُونْ ضَرْبِكْ؟». <verse eid="LUK 22:64" /><verse number="65" style="v" sid="LUK 22:65" />وقَعْدُوا يْسِبُّوا فِيهْ إِبَّرْشَة كْلَامْ خَايِبْ.<verse eid="LUK 22:65" /></para>
  <para style="s">يَسُوعْ قُدَّامْ المَجْلِسْ الأَعْلَى</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66" />وكِي طْلَعْ النْهَارْ، تْلَمُّوا شْيُوخْ الشَّعْبْ، الِّي هُومَا كْبَارْ الكَهَنَة وعُلَمَاءْ الشَّرِيعَة، وجَابُوا يَسُوعْ قُدَّامْ مَجْلِسْهُمْ الأَعْلَى. <verse eid="LUK 22:66" /><verse number="67" style="v" sid="LUK 22:67" />وقَالُولُو: «إِذَا كَانِكْ إِنْتِ المَسِيحْ قُولِلْنَا!». جَاوِبْهُمْ: «كَانْ نْقُلْكُمْ مَاكُمْشْ بِشْ تْصَدْقُونِي، <verse eid="LUK 22:67" /><verse number="68" style="v" sid="LUK 22:68" />وكَانْ نِسْإِلْكُمْ مَاكُمْشْ بِشْ تْجَاوْبُونِي. <verse eid="LUK 22:68" /><verse number="69" style="v" sid="LUK 22:69" />آمَا مِنْ تَوَّا إِبْنْ الإِنْسَانْ بِشْ يُقْعُدْ عْلَى يْمِينْ اللَّهْ القَادِرْ عْلَى كُلْ شَيْ». <verse eid="LUK 22:69" /><verse number="70" style="v" sid="LUK 22:70" />يَاخِي الكُلْهُمْ قَالُوا: «مَالَا إِنْتِ إِبْنْ اللَّهْ؟». قَالِلْهُمْ: «إِنْتُومَا بِيدْكُمْ تْقُولُوا الِّي آنَا هُوَّ!». <verse eid="LUK 22:70" /><verse number="71" style="v" sid="LUK 22:71" />يَاخِي قَالُوا: «عْلَاشْ مَزِّلْنَا نِسْتْحَقُّوا لِشْهُودْ؟ هَانَا سْمَعْنَاهَا مِنْ فُمُّو هُوَّ».<verse eid="LUK 22:71" /></para>
  <chapter eid="LUK 22" />
  <chapter number="23" style="c" sid="LUK 23" />
  <para style="s">يَسُوعْ قُدَّامْ بِيلَاطُسْ وهِيرُودُسْ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1" />وقَامُوا الكُلْ، وهَزُّوهْ لْبِيلَاطُسْ. <verse eid="LUK 23:1" /><verse number="2" style="v" sid="LUK 23:2" />وبْدَاوْ يِتْهْمُوا فِيهْ ويْقُولُوا: «شَدِّينَا الرَّاجِلْ هَاذَا يَعْمِلْ فِي فِتْنَة فِي وِسْطْ الشَّعْبْ، ويَمْنَعْ فِي النَّاسْ مِنْ دَفْعَانْ الضَّرَايِبْ لِلْقَيْصِرْ، ويْقُولْ الِّي هُوَّ المَسِيحْ المَلِكْ». <verse eid="LUK 23:2" /><verse number="3" style="v" sid="LUK 23:3" />يَاخِي بِيلَاطُسْ سِأْلُو: «إِنْتِ مَلِكْ اليْهُودْ؟». جَاوْبُو يَسُوعْ: «إِنْتِ بِيدِكْ قُلْتْ». <verse eid="LUK 23:3" /><verse number="4" style="v" sid="LUK 23:4" />وَلَّى بِيلَاطُسْ قَالْ لِكْبَارْ الكَهَنَة والنَّاسْ المَلْمُومِينْ: «مَا لْقِيتْ حَتَّى سْبَبْ يْخَلِّينِي نُحْكُمْ عَالرَّاجِلْ هَاذَا». <verse eid="LUK 23:4" /><verse number="5" style="v" sid="LUK 23:5" />آمَا هُومَا شَدُّوا صْحِيحْ وقَالُوا: «رَاهُو يْهَيِّجْ فِي الشَّعْبْ فِي مَنْطَقْةْ اليَهُودِيَّة الكُلْ بِلِّي قَاعِدْ يْعَلِّمْ فِيهْ، بْدَاهَا مِالجَلِيلْ حَتَّى لِينْ وْصِلْ لَهْنَا».<verse eid="LUK 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6" />وكِي سْمَعْ بِيلَاطُسْ كِلْمِةْ الجَلِيلْ، سْإِلْ: «يَاخِي الرَّاجِلْ هَاذَا مِالجَلِيلْ؟». <verse eid="LUK 23:6" /><verse number="7" style="v" sid="LUK 23:7" />وكِي عْرَفْ الِّي يَسُوعْ تَابَعْ لْوِلَايِةْ هِيرُودُسْ، بْعَثْهُولُو، وهِيرُودُسْ بِيدُو كَانْ فِي أُورْشَلِيمْ فِي الوَقْتْ هَاذَاكَا. <verse eid="LUK 23:7" /><verse number="8" style="v" sid="LUK 23:8" />وكِي هِيرُودُسْ شَافْ يَسُوعْ فْرَحْ بَرْشَة، عْلَى خَاطْرُو كَانْ يَاسِرْ يِسْمَعْ عْلِيهْ، وعَنْدُو مُدَّة طْوِيلَة مَذَابِيهْ يْشُوفُو، وكَانْ يِتْمَنَّى يْرَاهْ يَعْمِلْ فِي مُعْجْزَة قُدَّامُو. <verse eid="LUK 23:8" /><verse number="9" style="v" sid="LUK 23:9" />وسِأْلُو بَرْشَة أَسْئْلَة، آمَا هُوَّ مَا جَاوْبُوشْ. <verse eid="LUK 23:9" /><verse number="10" style="v" sid="LUK 23:10" />ووِقْفُوا كْبَارْ الكَهَنَة وعُلَمَاءْ الشَّرِيعَة وهَبْطُوا عْلِيهْ بِالتُّهَمْ. <verse eid="LUK 23:10" /><verse number="11" style="v" sid="LUK 23:11" />يَاخِي حَتَّى هِيرُودُسْ والعَسْكَرْ مْتَاعُو حَقْرُوهْ، وتْمَسْخْرُوا عْلِيهْ، ولَبّْسُو جِبَّة مِذْخْمَة، ورَجّْعُو لْبِيلَاطُسْ. <verse eid="LUK 23:11" /><verse number="12" style="v" sid="LUK 23:12" />وفِي النْهَارْ هَاذَاكَا هِيرُودُسْ وبِيلَاطُسْ تْصَالْحُوا، بَعْدْمَا كَانُوا قْبَلْ مِتْعَارْكِينْ.<verse eid="LUK 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13" />وعَيِّطْ بِيلَاطُسْ لِكْبَارْ الكَهَنَة والقَادَة والشَّعْبْ <verse eid="LUK 23:13" /><verse number="14" style="v" sid="LUK 23:14" />وقَالِلْهُمْ: «جِبْتُولِي الرَّاجِلْ هَاذَا وقُلْتُولِي الِّي هُوَّ يَعْمِلْ فِي فِتْنَة وِسْطْ الشَّعْبْ، وآنَا بَعْدْمَا ثَبَّتْ فِي كُلْ شَيْ قُدَّامْكُمْ، مَا لْقِيتُو عَامِلْ شَيْ مِلِّي تْهِمْتُوهْ بِيهْ. <verse eid="LUK 23:14" /><verse number="15" style="v" sid="LUK 23:15" />ولَا هِيرُودُسْ زَادَا شَدْ عْلِيهْ حَاجَة، عْلَى خَاطْرُو رَجَّعْهُولْنَا. مَالَا هُوَّ مَا عْمَلْ شَيْ يِسْتَاهِلْ عْلِيهْ المُوتْ. <verse eid="LUK 23:15" /><verse number="16" style="v" sid="LUK 23:16" />وهَانِي بِشْ نِجِلْدُو ونْسَيْبُو». <verse eid="LUK 23:16" /><verse number="17" style="v" sid="LUK 23:17" />وفِي كُلْ عِيدْ، كَانْ لَازِمْ عْلَى بِيلَاطُسْ يْسَيْبِلْهُمْ وَاحِدْ مِالمْرَابِيطْ. <verse eid="LUK 23:17" /><verse number="18" style="v" sid="LUK 23:18" />آمَا الحَاضْرِينْ الكُلْ صَاحُوا فَرْدْ وَقْتْ: «أُقْتُلْ هَاذَا! وسَيْبِلْنَا بَارَابَاسْ!». <verse eid="LUK 23:18" /><verse number="19" style="v" sid="LUK 23:19" />وبَارَابَاسْ هَاذَا، كَانْ فِي الحَبْسْ بِسْبَبْ فِتْنَة صَارِتْ فِي المْدِينَة وبِسْبَبْ جْرِيمِةْ قْتَلْ. <verse eid="LUK 23:19" /><verse number="20" style="v" sid="LUK 23:20" />وبِيلَاطُسْ كَانْ يْحِبْ يْسَيِّبْ يَسُوعْ، يَاخِي حْكَى مْعَاهُمْ مَرَّة أُخْرَى. <verse eid="LUK 23:20" /><verse number="21" style="v" sid="LUK 23:21" />آمَا هُومَا زَادُوا صَاحُوا: «أُصْلْبُو! أُصْلْبُو!». <verse eid="LUK 23:21" /><verse number="22" style="v" sid="LUK 23:22" />وعَاوِدْ قَالِلْهُمْ مَرَّة ثَالْثَة: «شْنُوَّة الشَّرْ الِّي عَمْلُو؟ مَا لْقِيتْ حَتَّى سْبَبْ يِسْتَاهِلْ عْلِيهْ المُوتْ. بِشْ نِجْلْدُو ونْسَيْبُو». <verse eid="LUK 23:22" /><verse number="23" style="v" sid="LUK 23:23" />آمَا هُومَا شَدُّوا صْحِيحْ وبْدَاوْ يْصِيحُوا بْأَعْلَى صُوتْهُمْ بَاشْ يُصْلْبُو. وصْيَاحُهُمْ هُوَّ الِّي غْلِبْ.<verse eid="LUK 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 23:24" />وحْكُمْ بِيلَاطُسْ بِلِّي حَبُّوا عْلِيهْ. <verse eid="LUK 23:24" /><verse number="25" style="v" sid="LUK 23:25" />وسَيْبِلْهُمْ الرَّاجِلْ الِّي اخْتَارُوهْ ولِّي كَانْ فِي الحَبْسْ بِسْبَبْ جْرِيمِةْ القَتْلْ والفِتْنَة. وحْكُمْ عْلَى يَسُوعْ كِيفْ مَا حَبُّوا هُومَا.<verse eid="LUK 23:25" /></para>
  <para style="s">يَسُوعْ عَالصَّلِيبْ</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26" />وهُومَا هَازِّينُو بَاشْ يُصْلْبُوهْ، شَدُّوا رَاجِلْ مِنْ مَنْطَقْةْ قِيرِينَا إِسْمُو سِمْعَانْ كَانْ رَاجَعْ مِالرِّيفْ، وحَطُّوا عْلِيهْ الصَّلِيبْ بَاشْ يْهِزُّو ويِمْشِي وْرَاء يَسُوعْ. <verse eid="LUK 23:26" /><verse number="27" style="v" sid="LUK 23:27" />وتَبْعُوهْ بَرْشَة نَاسْ مِالشَّعْبْ، مِنْهُمْ بَرْشَة نْسَاء كَانُوا يِنْدْبُوا ويْنَوْحُوا عْلِيهْ. <verse eid="LUK 23:27" /><verse number="28" style="v" sid="LUK 23:28" />وتْلَفْتِلْهُمْ يَسُوعْ وقَالْ: «يَا بْنَاتْ أُورْشَلِيمْ مَا تِبْكِيوِشْ عْلِيَّا، آمَا إِبْكِيوْ عْلَى رْوَاحْكُمْ وعْلَى وْلَادْكُمْ. <verse eid="LUK 23:28" /><verse number="29" style="v" sid="LUK 23:29" />عْلَى خَاطِرْ بِشْ يْجِي وَقْتْ يْقُولُوا فِيهْ النَّاسْ: "صَحَّة لِلنْسَاء الِّي مَا يَضْنَاوِشْ، ولِّي لَا حِبْلُوا ولَا رَضْعُوا!". <verse eid="LUK 23:29" /><verse number="30" style="v" sid="LUK 23:30" />ووَقْتْهَا يْقُولُوا لِلجْبَالْ: "طِيحْ عْلِينَا"، ولِلْهْضُبْ: "غَطِّينَا!". <verse eid="LUK 23:30" /><verse number="31" style="v" sid="LUK 23:31" />وإِذَا كَانْ العُودْ الأَخْضِرْ عَمْلُوا فِيهْ هَكَّا، مَالَا اليَابِسْ آشْ بِشْ يِجْرَالُو؟».<verse eid="LUK 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32" />وزَادُوا هَزُّوا زُوزْ مُجْرْمِينْ بَاشْ يُقْتْلُوهُمْ مْعَ يَسُوعْ. <verse eid="LUK 23:32" /><verse number="33" style="v" sid="LUK 23:33" />وكِي وِصْلُوا لِلْبُقْعَة الِّي تِتْسَمَّى الجُمْجْمَة، صَلْبُوهْ غَادِي مْعَ الزُّوزْ المْجَرْمَة، وَاحِدْ عْلَى يْمِينُو والآخِرْ عْلَى يْسَارُو. <verse eid="LUK 23:33" /><verse number="34" style="v" sid="LUK 23:34" />وقَالْ يَسُوعْ: «يَا بَابَا، إِغْفْرِلْهُمْ، عْلَى خَاطِرْهُمْ مُشْ عَارْفِينْ فَاشْ قَاعْدِينْ يَعْمْلُوا». وقَسْمُوا العْسَاكِرْ حْوَايْجُو بِينَاتْهُمْ بِالقُرْعَة.<verse eid="LUK 23:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 23:35" />والنَّاسْ كَانُوا وَاقْفِينْ يِتْفَرْجُوا، والقَادَة مْتَاعْهُمْ يِتْمَسْخْرُوا ويْقُولُوا: «مَنَّعْ غِيرُو، تْرَاهْ خَلِّيهْ يْمَنَّعْ رُوحُو إِذَا كَانْ هُوَّ المَسِيحْ الِّي اخْتَارُو اللَّهْ!». <verse eid="LUK 23:35" /><verse number="36" style="v" sid="LUK 23:36" />وكَانُوا العْسَاكِرْ زَادَا يِتْمَسْخْرُوا عْلِيهْ، ويُقْرْبُولُو ويْمِدُّولُو الخَلْ <verse eid="LUK 23:36" /><verse number="37" style="v" sid="LUK 23:37" />ويْقُولُولُو: «إِذَا كُنْتْ إِنْتِ مَلِكْ اليْهُودْ، نَجِّي رُوحِكْ». <verse eid="LUK 23:37" /><verse number="38" style="v" sid="LUK 23:38" />وكَانِتْ مْعَلْقَة فُوقْ رَاسُو بْلَاكَة مَكْتُوبْ عْلِيهَا: «هَاذَا هُوَّ مَلِكْ اليْهُودْ».<verse eid="LUK 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39" />وكَانْ وَاحِدْ مِالمُجْرْمِينْ المَصْلُوبِينْ مْعَاهْ يْسِبْ فِيهْ ويْقُولْ: «مُشْ إِنْتِ المَسِيحْ؟ مَالَا مَنَّعْ رُوحِكْ ومَنَّعْنَا!». <verse eid="LUK 23:39" /><verse number="40" style="v" sid="LUK 23:40" />آمَا المُجْرِمْ الآخِرْ لَامْ عْلِيهْ وقَالُّو: «يَاخِي مَا تْخَافِشْ اللَّهْ؟ رَاوْ مَحْكُومْ عْلِيكْ بِالمُوتْ كِيفُو. <verse eid="LUK 23:40" /><verse number="41" style="v" sid="LUK 23:41" />أَحْنَا تِحْكَمْ عْلِينَا بِالعَدْلْ ونِسْتَاهْلُوا العِقَابْ عَلِّي عْمَلْنَاهْ بِيدِينَا، آمَا الرَّاجِلْ هَاذَا مَا عْمَلْ حَتَّى حَاجَة غَالْطَة». <verse eid="LUK 23:41" /><verse number="42" style="v" sid="LUK 23:42" />ومْبَعِّدْ قَالْ: «يَا يَسُوعْ، إِتْذَكِّرْنِي كِي تْجِي فِي مَمْلَكْتِكْ». <verse eid="LUK 23:42" /><verse number="43" style="v" sid="LUK 23:43" />قَالُّو يَسُوعْ: «نْقُلِّكْ الحَقْ: اليُومْ تْكُونْ مْعَايَا فِي الفِرْدَوْسْ!».<verse eid="LUK 23:43" /></para>
  <para style="s">مُوتْ يَسُوعْ</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44" />وقْرِيبْ نُصْ النْهَارْ، ظْلَامِتْ الدِّنْيَا الكُلْ حَتَّى لْمَاضِي ثْلَاثَة مْتَاعْ العْشِيَّة. <verse eid="LUK 23:44" /><verse number="45" style="v" sid="LUK 23:45" />وغَابِتْ الشَّمْسْ، وتْشَقْ حْجَابْ الهَيْكِلْ مِالوُسْطْ. <verse eid="LUK 23:45" /><verse number="46" style="v" sid="LUK 23:46" />وصَاحْ يَسُوعْ بْصُوتْ عَالِي: «يَا بَابَا، نْسَلِّمْ رُوحِي بِينْ يْدِيكْ». وكِي كَمِّلْ كْلَامُو، مَاتْ.<verse eid="LUK 23:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47" />وكِي الضَّابِطْ الرُّومَانِي شَافْ الِّي صَارْ، مَجِّدْ اللَّهْ وقَالْ: «بِالحَقْ الإِنْسَانْ هَاذَا كَانْ رَاجِلْ صَالَحْ». <verse eid="LUK 23:47" /><verse number="48" style="v" sid="LUK 23:48" />والنَّاسْ الِّي تْلَمُّوا غَادِي بَاشْ يِتْفَرْجُوا فِي الصَّلْبْ، وَقْتِلِّي شَافُوا الِّي صَارْ، رَوْحُوا لِدْيَارْهُمْ وهُومَا يَضْرْبُوا عْلَى صْدُورَاتْهُمْ. <verse eid="LUK 23:48" /><verse number="49" style="v" sid="LUK 23:49" />آمَا صُوحَابْ يَسُوعْ الكُلْ والنْسَاء الِّي تَبْعُوهْ مِالجَلِيلْ، كَانُوا وَاقْفِينْ مِنْ بْعِيدْ يِتْفَرْجُوا فِلِّي قَاعِدْ صَايِرْ.<verse eid="LUK 23:49" /></para>
  <para style="s">يُوسِفْ يِدْفِنْ يَسُوعْ</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50" />وفِي المَجْلِسْ الأَعْلَى مْتَاعْ اليْهُودْ، كَانْ فَمَّة رَاجِلْ تَقِيْ وصَالِحْ إِسْمُو يُوسِفْ. <verse eid="LUK 23:50" /><verse number="51" style="v" sid="LUK 23:51" />ومَا كَانِشْ مْوَافِقْ لَا عَالقَرَارْ الِّي خْذَاوِهْ فِي المَجْلِسْ ولَا عَلِّي عَمْلُوهْ. ويُوسِفْ هَاذَا أَصْلُو مِالرَّامَة الِّي هِيَّ مْدِينَة مِنْ مُدُنْ اليْهُودْ، وكَانْ يِسْتَنَّى فِي مَمْلَكْةْ اللَّهْ. <verse eid="LUK 23:51" /><verse number="52" style="v" sid="LUK 23:52" />يَاخِي مْشَى لْبِيلَاطُسْ وطْلَبْ مِنُّو جُثِّةْ يَسُوعْ. <verse eid="LUK 23:52" /><verse number="53" style="v" sid="LUK 23:53" />وهَبّْطُو مِنْ فُوقْ الصَّلِيبْ وكَفْنُو، وحَطُّو فِي قْبَرْ مَحْفُورْ فِي الحْجَرْ مَا تِدْفِنْ فِيهْ حَتَّى حَدْ قْبَلْ. <verse eid="LUK 23:53" /><verse number="54" style="v" sid="LUK 23:54" />ونْهَارِتْهَا كَانْ نْهَارْ التَّحْضِيرْ لِلسِّبْتْ الِّي كَانْ قْرِيبْ يَبْدَى.<verse eid="LUK 23:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55" />والنْسَاء الِّي جَاوْ مْعَ يَسُوعْ مِالجَلِيلْ تَبْعُوا يُوسِفْ، وشَافُوا القْبَرْ وكِيفَاشْ الجُثَّة تْحَطِّتْ فِيهْ. <verse eid="LUK 23:55" /><verse number="56" style="v" sid="LUK 23:56" />ومْبَعِّدْ رَوْحُوا وحَضّْرُوا عِطْرْ وقْوَارِصْ. ونْهَارْ السِّبْتْ ارْتَاحُوا كِيفْ مَا وَصَّاتْ الشَّرِيعَة.<verse eid="LUK 23:56" /></para>
  <chapter eid="LUK 23" />
  <chapter number="24" style="c" sid="LUK 24" />
  <para style="s">يَسُوعْ يْقُومْ مِالمُوتْ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1" />ونْهَارْ الأَحَدْ فِي الفَجْرْ، جَاوْ النْسَاء لِلْقْبَرْ هَازِّينْ العِطْرْ الِّي حَضّْرُوهْ. <verse eid="LUK 24:1" /><verse number="2" style="v" sid="LUK 24:2" />يَاخِي لْقَاوْ الحَجْرَة تْنَحَّاتْ مِنْ مَدْخِلْ القْبَرْ. <verse eid="LUK 24:2" /><verse number="3" style="v" sid="LUK 24:3" />وكِي دَخْلُوا مَا لْقَاوِشْ جُثِّةْ الرَّبْ يَسُوعْ. <verse eid="LUK 24:3" /><verse number="4" style="v" sid="LUK 24:4" />وهُومَا حَايْرِينْ فِلِّي صَارْ، إِذَا بْزُوزْ رْجَالْ حْوَايِجْهُمْ تِلْمَعْ، وِقْفُوا بِجْنَبْهُمْ. <verse eid="LUK 24:4" /><verse number="5" style="v" sid="LUK 24:5" />يَاخِي مْكِنْهُمْ الخُوفْ وطَبْسُوا رْيُوسْهُمْ، وَقْتْهَا قَالُولْهُمْ الزُّوزْ الرْجَالْ: «عْلَاشْ تْلَوْجُوا عَالحَيْ بِينْ المُوتَى؟ <verse eid="LUK 24:5" /><verse number="6" style="v" sid="LUK 24:6" />هُوَّ مُشْ هْنَا، آمَا رَاهُو قَامْ! تْذَكْرُوا الِّي قَالْهُولْكُمْ وَقْتِلِّي كَانْ فِي الجَلِيلْ: <verse eid="LUK 24:6" /><verse number="7" style="v" sid="LUK 24:7" />"إِبْنْ الإِنْسَانْ لَازِمْ يْسَلْمُوهْ لِيْدِينْ نَاسْ مُذْنْبِينْ، ويِتْصْلَبْ، وفِي النْهَارْ الثَّالِثْ يْقُومْ"». <verse eid="LUK 24:7" /><verse number="8" style="v" sid="LUK 24:8" />يَاخِي تْذَكْرُوا كْلَامُو.<verse eid="LUK 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 24:9" />وَلَّاوْ رَجْعُوا مِالقْبَرْ وحْكَاوْ الِّي صَارْ الكُلْ لِلتْلَامْذَة الحْدَاشْ ولِلْأُخْرِينْ الكُلْ. <verse eid="LUK 24:9" /><verse number="10" style="v" sid="LUK 24:10" />ولِّي حْكَاوْ لِلرُّسُلْ هُومَا: مَرْيِمْ المَجْدَلِيَّة، ويُوَنَّا، ومَرْيِمْ أُمْ يَعْقُوبْ، والنْسَاء الأُخْرِينْ الِّي مْشَاوْ مْعَاهُمْ. <verse eid="LUK 24:10" /><verse number="11" style="v" sid="LUK 24:11" />والرُّسُلْ مَا صَدْقُوهُمْشْ، وظْهُرِّلْهُمْ الِّي هُومَا يْخَلْوْضُوا. <verse eid="LUK 24:11" /><verse number="12" style="v" sid="LUK 24:12" />آمَا بُطْرُسْ قَامْ وجْرَى لِلْقْبَرْ، وكِي طَلْ لْقَى قْمَايِطْ الكْفَنْ مَلْفُوفِينْ وَحَّدْهُمْ. يَاخِي رْجَعْ وهُوَّ مِسْتَغْرِبْ مِالحْكَايَة.<verse eid="LUK 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13" />وفِي نَفْسْ النْهَارْ، فَمَّة زُوزْ مِالتْلَامْذَة كَانُوا فِي الثْنِيَّة مَاشِينْ لْدَشْرَة تِبْعِدْ حْدَاشِنْ كِيلُومَاتِرْ عْلَى أُورْشَلِيمْ، إِسْمْهَا عِمْوَاسْ. <verse eid="LUK 24:13" /><verse number="14" style="v" sid="LUK 24:14" />وكَانُوا يَحْكِيوْ عَلِّي صَارْ الكُلْ. <verse eid="LUK 24:14" /><verse number="15" style="v" sid="LUK 24:15" />وهُومَا يَحْكِيوْ ويِتْنَاقْشُوا، وإِذَا بِيهْ يَسُوعْ بِيدُو جَاء وبْدَا يِمْشِي مْعَاهُمْ. <verse eid="LUK 24:15" /><verse number="16" style="v" sid="LUK 24:16" />آمَا تْقُولِشْ عْلِيهَا فَمَّة حَاجَة غَمْضِتِّلْهُمْ عِينِيهُمْ يَاخِي مَا عَرْفُوهُوشْ.<verse eid="LUK 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 24:17" />يَاخِي سْإِلْهُمْ: «فَاشْ تَحْكِيوْ وإِنْتُومَا مَاشِينْ؟». وِقْفُوا وكَانْ الحُزْنْ ظَاهِرْ عْلَى وْجُوهْهُمْ. <verse eid="LUK 24:17" /><verse number="18" style="v" sid="LUK 24:18" />وجَاوْبُو وَاحِدْ مِنْهُمْ إِسْمُو كْلِيُوبَاسْ: «يَاخِي إِنْتِ البَرَّانِي الوَحِيدْ فِي أُورْشَلِيمْ الِّي مَا يَعْرِفْشْ آشْ صَارْ فِي هَا الأَيَّامَاتْ؟». <verse eid="LUK 24:18" /><verse number="19" style="v" sid="LUK 24:19" />قَالِلْهُمْ: «آشْ صَارْ؟». قَالُولُو: «الِّي صَارْ فِي يَسُوعْ النَّاصْرِي، الِّي كَانْ نَبِيْ عَنْدُو قُدْرَة فِي القَوْلْ وفِي الفِعْلْ قُدَّامْ اللَّهْ وقُدَّامْ الشَّعْبْ الكُلْ، <verse eid="LUK 24:19" /><verse number="20" style="v" sid="LUK 24:20" />وكِيفَاشْ كْبَارْ الكَهَنَة وقَادِتْنَا سَلْمُوهْ بَاشْ يِتْحْكَمْ عْلِيهْ بِالمُوتْ وصَلْبُوهْ. <verse eid="LUK 24:20" /><verse number="21" style="v" sid="LUK 24:21" />وأَحْنَا كَانْ عَنْدْنَا أَمَلْ الِّي هُوَّ بِشْ يِفْدِي بَنِي إِسْرَائِيلْ. وزِيدْ عْلَى هَاذَا الكُلْ، اليُومْ هُوَّ النْهَارْ الثَّالِثْ مِلِّي صَارِتْ الحْكَايَة. <verse eid="LUK 24:21" /><verse number="22" style="v" sid="LUK 24:22" />آمَا فَمَّة نْسَاء مِنْ جْمَاعِتْنَا حَيْرُونَا. مْشَاوْ لِلْقْبَرْ فِي الفَجْرْ، <verse eid="LUK 24:22" /><verse number="23" style="v" sid="LUK 24:23" />ومَا لْقَاوِشْ الجُثَّة، يَاخِي رَجْعُوا وقَالُولْنَا الِّي هُومَا شَافُوا زُوزْ مْلَايْكَة فِي رُؤْيَا قَالُولْهُمْ الِّي هُوَّ حَيْ. <verse eid="LUK 24:23" /><verse number="24" style="v" sid="LUK 24:24" />ومْشَاوْ جْمَاعَة مِنَّا لِلْقْبَرْ، ولْقَاوْ الحْكَايَة صْحِيحَة كِيمَا قَالُوا النْسَاء، آمَا هُوَّ مَا شَافُوهُوشْ».<verse eid="LUK 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25" />يَاخِي قَالِلْهُمْ يَسُوعْ: «قَدَّاشْكُمْ مَا تِفْهْمُوشْ وقَدَّاشْكُمْ رْزَانْ فِي الإِيمَانْ بِلِّي قَالُوهْ الأَنْبِيَاءْ! <verse eid="LUK 24:25" /><verse number="26" style="v" sid="LUK 24:26" />يَاخِي المَسِيحْ مُشْ كَانْ لَازْمُو يْعَانِي الوْجَايَعْ هَاذِي، ومْبَعِّدْ يُدْخُلْ لْمَجْدُو؟». <verse eid="LUK 24:26" /><verse number="27" style="v" sid="LUK 24:27" />وبْدَالْهُمْ مِنْ تَوْرَاةْ مُوسَى حَتَّى لِكْتُبْ الأَنْبِيَاءْ الكُلْ، يْفَسْرِلْهُمْ فِلِّي تِكْتِبْ عْلِيهْ فِي الكْتُبْ المُقَدْسَة.<verse eid="LUK 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28" />وكِي قُرْبُوا لِلدَّشْرَة الِّي كَانُوا مَاشِينِيلْهَا، حْسِبْ يَسُوعْ رُوحُو مَاشِي لِبْلَاصَة مَا أَبْعِدْ. <verse eid="LUK 24:28" /><verse number="29" style="v" sid="LUK 24:29" />آمَا هُومَا شَدُّوا فِيهْ صْحِيحْ وقَالُوا: «أَبْقَى مْعَانَا عْلَى خَاطِرْ النْهَارْ قْرِيبْ يُوفَى والدِّنْيَا بْدَاتْ تِظْلَامْ». وَلَّى دْخَلْ وبْقَى مْعَاهُمْ. <verse eid="LUK 24:29" /><verse number="30" style="v" sid="LUK 24:30" />وكِي قْعَدْ مْعَاهُمْ بَاشْ يَاكْلُوا، خْذَا الخُبْزْ وشْكَرْ وقْسِمْ وعْطَاهُمْ. <verse eid="LUK 24:30" /><verse number="31" style="v" sid="LUK 24:31" />وَقْتْهَا تْحَلِّتْ عِينِيهُمْ وعَرْفُوهْ، وفِي لَحْظِتْهَا مَا عَادِشْ شَافُوهْ. <verse eid="LUK 24:31" /><verse number="32" style="v" sid="LUK 24:32" />وقَالُوا لِبْعَضْهُمْ: «هَاذَاكَا عْلَاشْ كُنَّا نْحِسُّوا كِيمَا النَّارْ تَاكِلْ فِي قْلُوبْنَا بِالفَرْحَة وَقْتِلِّي كَانْ يْكَلِّمْ فِينَا فِي الطْرِيقْ ويْفَسْرِلْنَا فِي الكْتُبْ المُقَدْسَة!». <verse eid="LUK 24:32" /><verse number="33" style="v" sid="LUK 24:33" />وقَامُوا بِالوَقْتْ ورَجْعُوا لْأُورْشَلِيمْ، ولْقَاوْ الرُّسُلْ الحْدَاشْ ولِّي مْعَاهُمْ مَلْمُومِينْ، <verse eid="LUK 24:33" /><verse number="34" style="v" sid="LUK 24:34" />وكَانُوا يْقُولُوا الزُّوزْ رْجَالْ: «بِالحَقْ الرَّبْ يَسُوعْ قَامْ مِالمُوتْ، وظْهُرْ لْسِمْعَانْ!». <verse eid="LUK 24:34" /><verse number="35" style="v" sid="LUK 24:35" />يَاخِي حْكَاوُلْهُمْ التْلَامْذَة الزُّوزْ عَلِّي صَارْ فِي الطْرِيقْ، وكِيفَاشْ عَرْفُوا الِّي هُوَّ الرَّبْ يَسُوعْ وَقْتِلِّي قْسَمِّلْهُمْ الخُبْزْ.<verse eid="LUK 24:35" /></para>
  <para style="s">يَسُوعْ يُظْهُرْ لِتْلَامِذْتُو</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36" />وهُومَا يَحْكِيوْ، وْقِفْ يَسُوعْ بِيدُو فِي وِسْطْهُمْ وقَالِلْهُمْ: «السَّلَامْ لِيكُمْ!». <verse eid="LUK 24:36" /><verse number="37" style="v" sid="LUK 24:37" />آمَا هُومَا خَافُوا وتْرِعْبُوا عْلَى خَاطِرْ مْشَى فِي بَالْهُمْ الِّي هُومَا قَاعْدِينْ يْشُوفُوا فِي شَبَحْ. <verse eid="LUK 24:37" /><verse number="38" style="v" sid="LUK 24:38" />يَاخِي قَالِلْهُمْ: «شْبِيكُمْ دَاخْلِينْ بْعَضْكُمْ؟ وعْلَاشْ الشَّكْ هَاذَا فِي قْلُوبْكُمْ؟ <verse eid="LUK 24:38" /><verse number="39" style="v" sid="LUK 24:39" />شُوفُوا يْدَيَّا وسَاقَيَّا، آنَا هُوَّ. مِسُّونِي وتْأَكْدُوا. رَاهُو الشَّبَحْ لَا عَنْدُو لْحَمْ ولَا عْظَمْ كِيمَا آنَا عَنْدِي».<verse eid="LUK 24:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 24:40" />وكِي قَالِلْهُمْ هَاذَا، وَرَّاهُمْ يْدِيهْ وسَاقِيهْ. <verse eid="LUK 24:40" /><verse number="41" style="v" sid="LUK 24:41" />وهُومَا بَاهْتِينْ ومُشْ مْصَدْقِينْ رْوَاحْهُمْ مِنْ كُثْرِةْ الفَرْحَة، قَالِلْهُمْ: «عَنْدْكُمْشِي مَا يِتَّاكِلْ؟». <verse eid="LUK 24:41" /><verse number="42" style="v" sid="LUK 24:42" />يَاخِي عْطَاوَهْ شْوَيَّة حُوتْ مِشْوِي، <verse eid="LUK 24:42" /><verse number="43" style="v" sid="LUK 24:43" />خْذَاهْ وكْلَاهْ قُدَّامْهُمْ.<verse eid="LUK 24:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44" />ومْبَعِّدْ قَالِلْهُمْ: «هَاذَا هُوَّ الكْلَامْ الِّي قُلْتْهُولْكُمْ كِي كُنْتْ مْعَاكُمْ: إِنُّو لَازِمْ يْتِمْ كُلْ الِّي تِكْتِبْ عْلِيَّا فِي تَوْرَاةْ مُوسَى وكْتُبْ الأَنْبِيَاءْ والمَزَامِيرْ». <verse eid="LUK 24:44" /><verse number="45" style="v" sid="LUK 24:45" />مْبَعِّدْ نَوْرِلْهُمْ عْقُولْهُمْ بَاشْ يِفْهْمُوا الكْتُبْ المُقَدْسَة. <verse eid="LUK 24:45" /><verse number="46" style="v" sid="LUK 24:46" />وقَالِلْهُمْ: «الكْتُبْ المُقَدْسَة تْقُولْ الِّي المَسِيحْ لَازْمُو يْعَانِي الوْجَايَعْ ويْقُومْ مِالمُوتْ فِي النْهَارْ الثَّالِثْ، <verse eid="LUK 24:46" /><verse number="47" style="v" sid="LUK 24:47" />وبْشَارِةْ التُّوبَة وغُفْرَانْ الذْنُوبْ بْإِسْمُو لَازِمْ تُوصِلْ لِلشُّعُوبْ الكُلْ، وبِشْ تَبْدَى مِنْ أُورْشَلِيمْ. <verse eid="LUK 24:47" /><verse number="48" style="v" sid="LUK 24:48" />وإِنْتُومَا شْهُودْ عْلَى هَاذَا. <verse eid="LUK 24:48" /><verse number="49" style="v" sid="LUK 24:49" />وهَانِي بِشْ نِبْعْثِلْكُمْ الِّي وْعِدْ بِيهْ بَابَا. مَالَا أُقْعْدُوا فِي مْدِينِةْ أُورْشَلِيمْ حَتَّى لِينْ تَاخْذُوا قُوَّة مِالسْمَاء».<verse eid="LUK 24:49" /></para>
  <para style="s">يَسُوعْ يِتِرْفَعْ لِلسْمَاء</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50" />مْبَعِّدْ خَرَّجْهُمْ مِالمْدِينَة وهَزْهُمْ قْرِيبْ لْبِيتْ عَنْيَا، وغَادِي هَزْ يْدِيهْ وبَارِكْهُمْ. <verse eid="LUK 24:50" /><verse number="51" style="v" sid="LUK 24:51" />وهُوَّ يْبَارِكْ فِيهُمْ، فَارِقْهُمْ وتِرْفَعّْ لِلسْمَاء. <verse eid="LUK 24:51" /><verse number="52" style="v" sid="LUK 24:52" />يَاخِي سِجْدُولُو، ورَجْعُوا لْأُورْشَلِيمْ وهُومَا طَايْرِينْ بِالفَرْحَة. <verse eid="LUK 24:52" /><verse number="53" style="v" sid="LUK 24:53" />وكَانُوا دِيمَا فِي الهَيْكِلْ، يْسَبْحُوا ويْبَارْكُوا فِي اللَّهْ.<verse eid="LUK 24:53" /></para>
  <chapter eid="LUK 24" />
</usx>