<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="COL" style="id" />
  <para style="h">كُولُوسِي</para>
  <para style="toc1">رِسَالِةْ بُولِسْ لِلْمُؤْمْنِينْ الِّي فِي كُولُوسِي</para>
  <para style="toc2">كُولُوسِي</para>
  <para style="toc3">كُولُوسِي</para>
  <para style="mt">رِسَالِةْ بُولِسْ لِلْمُؤْمْنِينْ الِّي فِي كُولُوسِي</para>
  <chapter number="1" style="c" sid="COL 1" />
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1" />مِنْ بُولِسْ، الِّي إِخْتَارُو اللَّهْ بَاشْ يْكُونْ رَسُولْ يَسُوعْ المَسِيحْ، ومِنْ خُونَا تِيمُوثَاوُسْ، <verse eid="COL 1:1" /><verse number="2" style="v" sid="COL 1:2" />لِلْقِدِّيسِينْ الِّي فِي كُولُوسِي، الإِخْوَة المُؤْمْنِينْ التَّابْعِينْ لِلْمَسِيحْ.</para>
  <para style="p" vid="COL 1:2">النِّعْمَة والسَّلَامْ عْلِيكُمْ مِنْ اللَّهْ بُونَا والرَّبْ يَسُوعْ المَسِيحْ.<verse eid="COL 1:2" /></para>
  <para style="s">شُكْرْ ودُعَاءْ</para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3" />أَحْنَا نِحْمْدُوا اللَّهْ بُو رَبْنَا يَسُوعْ المَسِيحْ، فِي كُلْ مَرَّة نْصَلِّيوْ فِيهَا عْلَى خَاطِرْكُمْ، <verse eid="COL 1:3" /><verse number="4" style="v" sid="COL 1:4" />وأَحْنَا سْمَعْنَا عْلَى إِيمَانْكُمْ بْيَسُوعْ المَسِيحْ، وعْلَى مْحَبِّتْكُمْ لِلْقِدِّيسِينْ الكُلْ. <verse eid="COL 1:4" /><verse number="5" style="v" sid="COL 1:5" />الإِيمَانْ والمْحَبَّة هَاذُمْ هُومَا بِسْبَبْ الرْجَى الِّي عَنْدْكُمْ فِلِّي حَضَّرْهُولْكُمْ اللَّهْ فِي السْمَاء. الرْجَى هَاذَا سْمَعْتُوا بِيهْ مِنْ قْبَلْ فِي كِلْمِةْ الحَقْ، الِّي هِيَّ البْشَارَة <verse eid="COL 1:5" /><verse number="6" style="v" sid="COL 1:6" />الِّي وِصْلِتِّلْكُمْ كِيمَا وِصْلِتْ لِلْعَالِمْ الكُلْ، وبْدَاتْ تُثْمُرْ وتِنْتَشِرْ فِيهْ كِيفْ مَا ثُمْرُتْ وانْتَشْرِتْ بِينَاتْكُمْ مِلِّي سْمَعْتُوا بْنِعْمِةْ اللَّهْ وعْرَفْتُوهَا بِالحَقْ. <verse eid="COL 1:6" /><verse number="7" style="v" sid="COL 1:7" />وهَاذَا تْعَلَّمْتُوهْ مِنْ أَبَفْرَاسْ، شْرِيكْنَا المَحْبُوبْ فِي خِدْمِةْ الرَّبْ، والخَادِمْ الأَمِينْ لِلْمَسِيحْ بِينَاتْكُمْ. <verse eid="COL 1:7" /><verse number="8" style="v" sid="COL 1:8" />وهُوَّ الِّي حْكَالْنَا عَالمْحَبَّة الِّي عْطَاهَالْكُمْ الرُّوحْ. <verse eid="COL 1:8" /><verse number="9" style="v" sid="COL 1:9" />ومِلِّي سْمَعْنَا هَاذَا، قْعَدْنَا دِيمَا نِدْعِيوْلْكُمْ، طَالْبِينْ مِنْ اللَّهْ بَاشْ يَمْلَاكُمْ بِالحِكْمَة والفَهْمْ الرُّوحِي، بَاشْ تَعْرْفُوهْ آشْ يْحِبْ، <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />وهَكَّا تْوَلِّيوْ تِتْصَرْفُوا فِي كُلْ شَيْ كِيمَا يْلِيقْ بِالرَّبْ ويْرَضِّيهْ، وتُثْمْرُوا بِالأَعْمَالْ الصَّالْحَة وتِكْبْرُوا فِي مَعْرِفْةْ اللَّهْ، <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" />وطَالْبِينْ مِنْ اللَّهْ زَادَا إِنْكُمْ تِتْقَوَّاوْ بْكُلْ القُوَّة الِّي بْحَسْبْ قُدْرْتُو المَجِيدَة، بَاشْ تْنَجْمُوا تِتْحَمْلُوا كُلْ شَيْ وتُصْبْرُوا، وإِنْتُومَا فَرْحَانِينْ، <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />وحَامْدِينْ الآبْ الِّي رَدْكُمْ تِسْتَاهْلُوا بَاشْ تْشَارْكُوا فِي وَرْثِةْ القِدِّيسِينْ فِي مَمْلَكْةْ النُّورْ. <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />هُوَّ الِّي نَجَّانَا مِنْ سُلْطِةْ الظْلَامْ وحَطْنَا فِي مَمْلَكْةْ إِبْنُو الِّي يْحِبُّو، <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" />الِّي فْدَانَا عْلَى طْرِيقُو وغْفَرْ ذْنُوبْنَا.<verse eid="COL 1:14" /></para>
  <para style="s">حْقِيقِةْ الإِبْنْ</para>
  <para style="q1">
    <verse number="15" style="v" sid="COL 1:15" />والإِبْنْ يَعْطِي صُورَة صَادْقَة عْلَى طَبِيعِةْ اللَّهْ الِّي مَا يِتْشَافِشْ،</para>
  <para style="q2" vid="COL 1:15">وهُوَّ البِكْرْ، وفُوقْ كُلْ مَا تِخْلَقّْ.<verse eid="COL 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="COL 1:16" />بِيهْ تِخْلَقّْ كُلْ شَيْ:</para>
  <para style="q1" vid="COL 1:16">الِّي فِي السْمَاء ولِّي عَالأَرْضْ،</para>
  <para style="q2" vid="COL 1:16">الِّي يِتْشَافْ ولِّي مَا يِتْشَافِشْ:</para>
  <para style="q1" vid="COL 1:16">مُلُوكْ وَلَّا أَسْيَادْ</para>
  <para style="q2" vid="COL 1:16">وَلَّا رُؤَسَاءْ وَلَّا سْلَاطِينْ.</para>
  <para style="q1" vid="COL 1:16">كُلْ شَيْ تِخْلَقّْ بِيهْ ولِيهْ.<verse eid="COL 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="COL 1:17" />هُوَّ مَوْجُودْ قْبَلْ كُلْ شَيْ،</para>
  <para style="q2" vid="COL 1:17">وفِيهْ كُلْ شَيْ يْدُومْ.<verse eid="COL 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="COL 1:18" />هُوَّ رَاسْ البْدَنْ، مَعْنَاهَا رَاسْ الكْنِيسَة،</para>
  <para style="q2" vid="COL 1:18">وهُوَّ البِدَايَة،</para>
  <para style="q1" vid="COL 1:18">وأَوِّلْ وَاحِدْ يْقُومْ مِنْ بِينْ الِّي مَاتُوا،</para>
  <para style="q2" vid="COL 1:18">بَاشْ يْكُونْ هُوَّ الأُوِّلْ فِي كُلْ شَيْ.<verse eid="COL 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="COL 1:19" />وفِيهْ حَبْ اللَّهْ يْكُونْ مَوْجُودْ بِالكَامِلْ بْكُلْ صِفَاتُو.<verse eid="COL 1:19" /></para>
  <para style="q2">
    <verse number="20" style="v" sid="COL 1:20" />وبِيهْ حَبْ اللَّهْ يْصَالَحْ كُلْ شَيْ مْعَاهْ،</para>
  <para style="q1" vid="COL 1:20">كُلْ مَا فِي الأَرْضْ وفِي السْمَاء،</para>
  <para style="q2" vid="COL 1:20">ويْحَقَّقْ السَّلَامْ بْدَمْ إِبْنُو الِّي مَاتْ عَالصَّلِيبْ.<verse eid="COL 1:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="COL 1:21" />وقْبَلْ كُنْتُوا بْرَايْنِيَّة عْلَى اللَّهْ وأَعْدَاءْ لِيهْ بْأَفْكَارْكُمْ وأَعْمَالْكُمْ الشِّرِّيرَة، <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />آمَا تَوَّا اللَّهْ صَالَحْكُمْ بْمُوتْ بْدَنْ المَسِيحْ البَشَرِي، بَاشْ يْجِيبْكُمْ قُدَّامُو وإِنْتُومَا قِدِّيسِينْ، بْلَاشْ عْيُوبْ ومَا عْلِيكُمْشْ لُومْ. <verse eid="COL 1:22" /><verse number="23" style="v" sid="COL 1:23" />عْلَى شَرْطْ إِنْكُمْ تِثْبْتُوا فِي الإِيمَانْ، مِبْنِيِّينْ عْلَى سَاسْ صْحِيحْ، ومَا تِبْعْدُوشْ عْلَى رْجَى البْشَارَة الِّي سْمَعْتُوهَا ولِّي وِصْلِتْ لْكُلْ المَخْلُوقَاتْ الِّي فِي الأَرْضْ، البْشَارَة الِّي آنَا بُولِسْ وَلِّيتْ خَادِمْ لِيهَا.<verse eid="COL 1:23" /></para>
  <para style="s">بُولِسْ خَادِمْ المَسِيحْ</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24" />وآنَا تَوَّا نِفْرَحْ بِالعْذَابْ الِّي نْعَانِي فِيهْ عْلَى خَاطِرْكُمْ. وبِالوْجَايَعْ الِّي فِي بَدْنِي، نْشَارِكْ المَسِيحْ فِي الوْجَايَعْ الِّي يْقَاسِي فِيهَا عْلَى خَاطِرْ بَدْنُو، الِّي هُوَّ الكْنِيسَة. <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />وآنَا وَلِّيتْ خَادِمْ لِيهَا كِيمَا كَلَّفْنِي اللَّهْ عْلَى خَاطِرْكُمْ، بَاشْ نْوَصِّلْ البْشَارَة كَامْلَة. <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />وهِيَّ السِّرْ الِّي كَانْ مْخُبِّي طُولْ القُرُونْ والأَجْيَالْ السَّابْقَة، آمَا تَوَّا اللَّهْ كِشْفُو لِلْقِدِّيسِينْ مْتَاعُو. <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />واللَّهْ حَبْهُمْ يَعْرْفُوا قَدَّاشْ السِّرْ هَاذَا غْنِي ومَجِيدْ لِلِّي مَاهُمْشْ يْهُودْ. والسِّرْ هُوَّ إِنُّو المَسِيحْ يَحْيَا فِيكُمْ، وهُوَّ الرْجَى الِّي عَنْدْكُمْ بَاشْ تْشَارْكُوا فِي مَجْدْ اللَّهْ. <verse eid="COL 1:27" /><verse number="28" style="v" sid="COL 1:28" />وهُوَّ الِّي نْبَشْرُوا بِيهْ النَّاسْ الكُلْ، وانَّبْهُوهُمْ ونْعَلْمُوهُمْ بْكُلْ حِكْمَة، بَاشْ نْقَدْمُوا لِلَّهْ كُلْ إِنْسَانْ نَاضِجْ فِي المَسِيحْ. <verse eid="COL 1:28" /><verse number="29" style="v" sid="COL 1:29" />وهَاذَا عْلَاشْ نِتْعِبْ ونْجَاهِدْ مِتْوَكِّلْ عْلَى قُدْرْتُو الِّي تِخْدِمْ فِيَّا بْقُوَّة.<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1" />ونْحِبْكُمْ تَعْرْفُوا قَدَّاشْ نْجَاهِدْ عْلَى خَاطِرْكُمْ وعْلَى خَاطِرْ الِّي فِي لَاوْدُكِيَّة، وعْلَى خَاطِرْ الِّي عْمُرْهُمْ مَا شَافُونِي الكُلْ، <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />بَاشْ قْلُوبْهُمْ تِتْشَجَّعْ، ويْوَلِّيوْ وَاحِدْ فِي المْحَبَّة، وهَكَّا يْكُونْ عَنْدْهُمْ الفَهْمْ الوَاسَعْ الكَامِلْ بَاشْ يْنَجْمُوا يَعْرْفُوا سِرْ اللَّهْ، الِّي هُوَّ المَسِيحْ، <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />المَخْزُونَة فِيهْ كُلْ كْنُوزْ الحِكْمَة والمَعْرْفَة.<verse eid="COL 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="COL 2:4" />نْقُولِلْكُمْ فِي هَاذَا بَاشْ حَتَّى حَدْ مَا يْغُشْكُمْ بِكْلَامْ حْلُو. <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />آنَا غَايِبْ عْلِيكُمْ بْبَدْنِي، آمَا رَانِي مْعَاكُمْ بِالرُّوحْ، ونِفْرَحْ كِي نْشُوفْكُمْ مْنَظْمِينْ وثَابْتِينْ فِي الإِيمَانْ بِالمَسِيحْ.<verse eid="COL 2:5" /></para>
  <para style="s">الحْيَاةْ الجْدِيدَة</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />مَالَا، كِيمَا قْبِلْتُوا الرَّبْ يَسُوعْ المَسِيحْ، عِيشُوا حَسْبْ العَلَاقَة الِّي عَنْدُكْمْ مْعَاهْ، <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />مَغْرُوسِينْ فِيهْ كِيفْ النَّبْتَة الِّي مَادَّة عْرُوقْهَا وبَانِينْ حْيَاتْكُمْ عْلِيهْ هُوَّ السَّاسْ، ثَابْتِينْ فِي الإِيمَانْ كِيمَا تْعَلَّمْتُوهْ، وكُونُوا دِيمَا شَاكْرِينْ. <verse eid="COL 2:7" /><verse number="8" style="v" sid="COL 2:8" />ورُدُّوا بَالْكُمْ لَا وَاحِدْ يِسْحْرِلْكُمْ عْقُولْكُمْ بْفَلْسْفَة فَارْغَة وغَالْطَة، مِبْنِيَّة عْلَى تَقَالِيدْ النَّاسْ وعْلَى قَوَانِينْ العَالِمْ هَاذَا، ومُشْ مِبْنِيَّة عَالمَسِيحْ. <verse eid="COL 2:8" /><verse number="9" style="v" sid="COL 2:9" />عْلَى خَاطِرْ، فِي المَسِيحْ، اللَّهْ مَوْجُودْ بْكَامِلْ أُلُوهِيْتُو فِي بْدَنْ بَشَرِي، <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />ومَادَامْكُمْ تَابْعِينُو، إِنْتُومَا عَنْدْكُمْ كُلْ مَا يِلْزِمْكُمْ بَاشْ تْعِيشُوا بْطَرِيقَة تْرَضِّيهْ، هُوَّ الِّي فُوقْ كُلْ رِئَاسَة وسُلْطَة رُوحِيَّة.<verse eid="COL 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="COL 2:11" />وفِيهْ زَادَا اطَّهَّرْتُوا، مُشْ بِالطْهُورْ المَعْمُولْ بِاليِدْ، آمَا بِالطْهُورْ الِّي عَمْلُو المَسِيحْ كِي نَحَّى مِنْكُمْ طْبِيعِةْ البَشَرْ الفَاسْدَة. <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" />إِنْتُومَا وَقْتِلِّي تْعَمَّدْتُوا تِدْفِنْتُوا مْعَاهْ وقُمْتُوا مْعَاهْ، عْلَى خَاطِرْكُمْ أَمَّنْتُوا بْقُدْرِةْ اللَّهْ الِّي قَيْمُو مِنْ بِينْ المُوتَى.<verse eid="COL 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="COL 2:13" />قْبَلْ كُنْتُوا مِيْتِينْ بِسْبَبْ ذْنُوبْكُمْ وطْبِيعِتْكُمْ البَشَرِيَّة الفَاسْدَة الِّي مَا طَهَّرْهَاشْ المَسِيحْ، آمَا اللَّهْ حْيَاكُمْ مْعَ المَسِيحْ وسَامَحْنَا عْلَى ذْنُوبْنَا الكُلْ. <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" />وفَسَّخْ كِمْبْيَالْ الفْرَايِضْ الِّي كَانْ عْلِينَا ولِّي مَا كَانِشْ فِي صَالِحْنَا، ونَحَّاهْ وسَمْرُو عَالصَّلِيبْ. <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />وغْلِبْ رُؤَسَاءْ وحُكَّامْ العَالِمْ الرُّوحِي، ونَحَّالْهُمْ سْلَاحْهُمْ وفْضَحْهُمْ قُدَّامْ النَّاسْ، وهَزْهُمْ كِي المْرَابِيطْ فِي مَوْكِبْ إِنْتِصَارُو.<verse eid="COL 2:15" /></para>
  <para style="s">فْرَايِضْ مَا تِنْفَعْشْ</para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16" />هَاذَاكَا عْلَاشْ، مَا تْخَلِّيوْ حَتَّى حَدْ يُحْكُمْ عْلِيكُمْ فِي المَاكْلَة والشْرَابْ وَلَّا فِي الأَعْيَادْ وطْلُوعْ الهْلَالْ والأَسْبَاتْ، <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />هَاذِي الكُلْهَا مَاهِي إِلَّا ظِلْ لِلْأُمُورْ الِّي بِشْ تَاقَعْ فِي المُسْتَقْبِلْ، آمَا الوَاقَعْ هُوَّ المَسِيحْ. <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />ومَا تْخَلِّيوْ حَتَّى حَدْ يْخَسَّرْكُمْ فِي جَايْزِتْكُمْ كِي يَعْمِلْ رُوحُو مِتْوَاضَعْ ويِعْبِدْ فِي المْلَايْكَة. وَاحِدْ كِيمَا هَاذَا يْشِدْ فِي حَاجَاتْ يْقُولْ إِنُّو شَافْهَا، وتَفْكِيرُو البَشَرِي البَاطِلْ يْخَلِّيهْ مَنْفُوخْ بِالفَارَغْ، <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" />آمَا مَا يْشِدِّشْ فِي المَسِيحْ الِّي هُوَّ الرَّاسْ، ولِّي بِيهْ يِتْقَوَّى البْدَنْ الكُلْ ويْكُونْ شَادِدْ فِي بَعْضُو بِالأَعْصَابْ والمْفَاصِلْ بَاشْ يِكْبِرْ كِيمَا يْحِبْ اللَّهْ.<verse eid="COL 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20" />مَادَامْكُمْ مُتُّوا مْعَ المَسِيحْ وتْحَرَّرْتُوا مِالقُوَّة المْسَيْطْرَة عَالعَالِمْ، عْلَاشْ تْعِيشُوا كَايِنْكُمْ تَابْعِينْ لِلدِّنْيَا هَاذِي؟ وعْلَاشْ اطِّيعُوا فِي فْرَايِضْ كِيمَا: <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />«مَا تْمِسِّشْ، مَا تْذُوقِشْ، مَا تْشِدِّشْ…»؟ <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />هَاذِي الكُلْ فْرَايِضْ تْخُصْ حَاجَاتْ نِسْتَعْمْلُوهَا وْتُوفَى. هِيَّ أَحْكَامْ وقَوَانِينْ حَطُّوهَا النَّاسْ، <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />تُظْهُرْ الِّي هِيَّ فِيهَا حِكْمَة بِالتَّدَيُّنْ الِّي فِيهَا والتَّزَهُّدْ وتَعْذِيبْ البْدَنْ، آمَا الحَاجَاتْ هَاذِي مَا عَنْدْهَا حَتَّى قِيمَة، ومَا تْنَحِّيشْ شْهَاوِي الطْبِيعَة البَشَرِيَّة الفَاسْدَة.<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="s">المُؤْمِنْ وسُلُوكُو</para>
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1" />ومَادَامْكُمْ قُمْتُوا مْعَ المَسِيحْ، مَالَا أُطْلْبُوا الحَاجَاتْ الِّي فِي السْمَاء وِينْ المَسِيحْ قَاعِدْ عْلَى يْمِينْ اللَّهْ. <verse eid="COL 3:1" /><verse number="2" style="v" sid="COL 3:2" />فَكْرُوا فِي الحَاجَاتْ الِّي فِي السْمَاء، مُشْ فِي الحَاجَاتْ الِّي فِي الأَرْضْ، <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />عْلَى خَاطِرْكُمْ مُتُّوا، وتَوَّا حْيَاتْكُمْ مَسْتُورَة مْعَ المَسِيحْ فِي اللَّهْ. <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />ووَقْتِلِّي يُظْهُرْ المَسِيحْ، الِّي هُوَّ حْيَاتْكُمْ، إِنْتُومَا زَادَا بِشْ تُظْهْرُوا مْعَاهْ فِي مَجْدُو.<verse eid="COL 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5" />مَالَا أُقْتْلُوا الرَّغْبَاتْ الِّي فِيكُمْ المَرْبُوطَة بِالأَرْضْ: الزْنَى والنْجَاسَة والتَّسَيُّبْ والشْهَاوِي الخَايْبَة والطْمَعْ، الِّي هُوَّ عْبَادِةْ الصْنَبْ، <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />رَاهُو بِسْبَبْهَا يْجِي غَضَبْ اللَّهْ عَلِّي مَا يْطِيعُوهِشْ. <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />وإِنْتُومَا زَادَا كُنْتُوا قْبَلْ كِيفْهُمْ، وَقْتِلِّي كُنْتُوا تَعْمْلُوا فِي الحَاجَاتْ هَاذُوكُمْ. <verse eid="COL 3:7" /><verse number="8" style="v" sid="COL 3:8" />آمَا تَوَّا، نَحِّيوْ عْلِيكُمْ هَاذُمْ الكُلْ: الغْضَبْ والنِّقْمَة والخُبْثْ والسَّبَّانْ والكْلَامْ القْبِيحْ، <verse eid="COL 3:8" /><verse number="9" style="v" sid="COL 3:9" />ومَا تِكْذْبُوشْ عْلَى بْعَضْكُمْ، عْلَى خَاطِرْكُمْ نْزَعْتُوا الطْبِيعَة البَشَرِيَّة القْدِيمَة هِيَّ وأَعْمَالْهَا، <verse eid="COL 3:9" /><verse number="10" style="v" sid="COL 3:10" />ولْبِسْتُوا الطْبِيعَة الجْدِيدَة الِّي تِتْجَدِّدْ دِيمَا عْلَى صُورِةْ الِّي خْلَقْهَا، لِينْ تُوصِلْ لِلْمَعْرْفَة الكَامْلَة بِيهْ. <verse eid="COL 3:10" /><verse number="11" style="v" sid="COL 3:11" />ومَا عَادِشْ فَمَّة فَرْقْ بِينْ يْهُودِي ومُشْ يْهُودِي، وبِينْ مْطَهَّرْ ومُشْ مْطَهَّرْ، ولَا بِينْ مِتْحَضِّرْ ومُشْ مِتْحَضِّرْ، ولَا بِينْ عَبْدْ وحُرْ، المُهِمْ هُوَّ المَسِيحْ الِّي هُوَّ الكُلْ وفِي الكُلْ.<verse eid="COL 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12" />وإِنْتُومَا يَلِّي إِخْتَارْكُمْ اللَّهْ، وقَدَّسْكُمْ وحَبْكُمْ، إِلْبْسُوا الحَنَانْ واللُّطْفْ والتَّوَاضُعْ والسْيَاسَة والصَّبْرْ. <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" />تْحَمْلُوا بْعَضْكُمْ، وسَامْحُوا بْعَضْكُمْ. إِذَا كَانْ وَاحِدْ مِنْكُمْ عَنْدُو مَا يِشْكِي مِالآخِرْ، كِيفْ مَا سَامَحْكُمْ الرَّبْ، إِنْتُومَا زَادَا سَامْحُوا. <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />وإِلْبْسُوا فُوقْ هَاذَا الكُلْ المْحَبَّة، الِّي هِيَّ الرْبَاطْ الِّي يُرْبُطْكُمْ بِبْعَضْكُمْ بْصِيفَة كَامْلَة.<verse eid="COL 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="COL 3:15" />وخَلِّي يِمْلِكْ عْلَى قْلُوبْكُمْ سَلَامْ المَسِيحْ الِّي اللَّهْ دْعَاكُمْ لِيهْ بْصِيفِتْكُمْ أَعْضَاءْ فِي بْدَنْ وَاحِدْ، وكُونُوا شَاكْرِينْ. <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" />خَلِّيوْ كِلْمِةْ المَسِيحْ الغْنِيَّة تُسْكُنْ فِي قْلُوبْكُمْ. وعَلْمُوا ونَبْهُوا بْعَضْكُمْ بْكُلْ حِكْمَة. سَبْحُوا اللَّهْ بْمَزَامِيرْ وتَرَانِيمْ وغْنَايَاتْ رُوحِيَّة، واحْمْدُوهْ واشْكْرُوهْ مِنْ كُلْ قْلُوبْكُمْ. <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />خَلِّي الِّي تْقُولُوهْ وَلَّا تَعْمْلُوهْ الكُلْ يْكُونْ بْإِسْمْ الرَّبْ يَسُوعْ، حَامْدِينْ بِيهْ اللَّهْ الآبْ.<verse eid="COL 3:17" /></para>
  <para style="s">المُؤْمِنْ والعَايْلَة</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18" />يَا نْسَاء، إِخْضْعُوا لِرْجَالْكُمْ كِيفْ مَا يْلِيقْ بِالرَّبْ.<verse eid="COL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="COL 3:19" />يَا رْجَالْ، حِبُّوا نْسَاكُمْ ومَا تْكُونُوشْ قَاسِينْ عْلِيهُمْ.<verse eid="COL 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 3:20" />يَا وْلَادْ، طِيعُوا وَالْدِيكُمْ فِي كُلْ شَيْ عْلَى خَاطِرْ هَاذَا يْرَضِّي الرَّبْ.<verse eid="COL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 3:21" />يَا آبَاءْ، مَا تْلِزُّوشْ وْلَادْكُمْ لِلْغُشْ بَاشْ مَا تْفَشْلُوهُمْشْ.<verse eid="COL 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="COL 3:22" />يَا عَبِيدْ، طِيعُوا اسْيَادْكُمْ فِي الدِّنْيَا هَاذِي فِي كُلْ شَيْ، مُشْ قُدَّامْ عِينِيهُمْ كِيمَا الِّي يْحِبْ يْرَضِّي النَّاسْ، آمَا بْقَلْبْ صَادِقْ، يْخَافْ اللَّهْ. <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />وأَيْ حَاجَة تَعْمْلُوهَا، أَعْمْلُوهَا مِنْ كُلْ قْلُوبْكُمْ كَايِنْكُمْ تَعْمْلُوا فِيهَا لِلرَّبْ مُشْ لِلنَّاسْ، <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />وأَعْرْفُوا الِّي الرَّبْ بِشْ يْجَازِيكُمْ بِالوَرْثَة الِّي وْعِدْكُمْ بِيهَا، عْلَى خَاطِرْ المَسِيحْ هُوَّ السِيدْ الِّي تِخْدْمُوا فِيهْ. <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" />آمَا الِّي يَعْمِلْ الشَّرْ رَاهُو بِشْ يِتْعَاقِبْ عْلَى شَرُّو، عْلَى خَاطِرْ اللَّهْ مَا يْخَيِّرْ حَدْ عْلَى حَدْ.<verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1" />يَا أَسْيَادْ، عَامْلُوا العَبِيدْ مْتَاعْكُمْ بِالعَدْلْ والمُسَاوَاةْ، عَارْفِينْ الِّي إِنْتُومَا زَادَا عَنْدْكُمْ سِيدْ فِي السْمَاء.<verse eid="COL 4:1" /></para>
  <para style="s">آخِرْ وْصَايَا</para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />دَاوْمُوا عَالصْلَاةْ. وإِنْتُومَا تْصَلِّيوْ، خَلِّيكُمْ دِيمَا فَايْقِينْ وشَاكْرِينْ. <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />وإِدْعِيوْلْنَا أَحْنَا زَادَا بَاشْ اللَّهْ يْحِلِّلْنَا بَابْ بَاشْ نْوَصْلُوا الكِلْمَة ونْبَشْرُوا بْسِرْ المَسِيحْ، الِّي آنَا فِي الحَبْسْ عْلَى خَاطْرُو. <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />وصَلِّيوْ بَاشْ نْوَصْلُو بْوُضُوحْ كِيمَا يِلْزِمْ.<verse eid="COL 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 4:5" />تْصَرْفُوا بْحِكْمَة مْعَ الِّي مَاهُمْشْ مُؤْمْنِينْ، واسْتْغَلُّوا كُلْ فُرْصَة تْجِيكُمْ. <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />خَلِّي كْلَامْكُمْ دِيمَا مِلْيَانْ بِالنِّعْمَة ومُفِيدْ، بَاشْ تَعْرْفُوا كِيفَاشْ تْجَاوْبُوا كُلْ وَاحِدْ كِيمَا يِلْزِمْ.<verse eid="COL 4:6" /></para>
  <para style="s">تَحِيَّاتْ فِي الخَاتْمَة</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />آمَا بِالنِّسْبَة لْأَحْوَالِي، تَوَّا يْخَبَّرْكُمْ عْلِيهَا تِيخِيكُسْ، خُونَا المَحْبُوبْ، الخَادِمْ الأَمِينْ وشْرِيكْنَا فِي خِدْمِةْ الرَّبْ. <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />بْعَثْتْهُولْكُمْ بِالذِّمَّة، بَاشْ تَعْرْفُوا أَحْوَالْنَا ويْشَجَّعْكُمْ، <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" />وبْعَثْتْ مْعَاهْ أُونُسِيمُوسْ، خُونَا الأَمِينْ المَحْبُوبْ، ولِّي هُوَّ وَاحِدْ مِنْكُمْ. وهُومَا تَوْ يَحْكِيولْكُمْ عَلِّي قَاعِدْ يْصِيرْ هُونِي لْكُلْ.<verse eid="COL 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="COL 4:10" />يْسَلَّمْ عْلِيكُمْ أَرِسْتَرْخُسْ المَرْبُوطْ مْعَايَا فِي الحَبْسْ، ومُرْقُسْ قْرِيبْ بَرْنَابَا الِّي وَصَّاوْكُمْ عْلِيهْ، إِفْرْحُوا بِيهْ كَانْ جَاكُمْ. <verse eid="COL 4:10" /><verse number="11" style="v" sid="COL 4:11" />ويْسَلَّمْ عْلِيكُمْ زَادَا يَشُوعْ الِّي يْنَادِيوْلُو يُوسْتُسْ. ومِنْ بِينْ اليْهُودْ الِّي أَمْنُوا، هَاذُومَا بَرْكْ الِّي يِخْدْمُوا مْعَايَا فِي مَمْلَكْةْ اللَّهْ، وهُومَا مَصْدِرْ تَشْجِيعْ لِيَّا.<verse eid="COL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 4:12" />يْسَلَّمْ عْلِيكُمْ أَبَفْرَاسْ، وهُوَّ زَادَا وَاحِدْ مِنْكُمْ وعَبْدْ لْيَسُوعْ المَسِيحْ . هُوَّ دِيمَا يْجَاهِدْ فِي الصْلَاةْ عْلَى خَاطِرْكُمْ بَاشْ تُنْضْجُوا وتِثْبْتُوا وتْكُونْ عَنْدْكُمْ ثِيقَة كَامْلَة مِنْ جِيهِةْ قَصْدَ اللَّهْ. <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />وآنَا نِشْهِدْ الِّي هُوَّ يِتْعِبْ بَرْشَة فِي الخِدْمَة عْلَى خَاطِرْكُمْ إِنْتُومَا وعْلَى خَاطِرْ الِّي فِي لَاوْدُكِيَّة وهِيرَابُولِيسْ.<verse eid="COL 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="COL 4:14" />ويْسَلَّمْ عْلِيكُمْ لُوقَا الطْبِيبْ المَحْبُوبْ، ودِيمَاسْ. <verse eid="COL 4:14" /><verse number="15" style="v" sid="COL 4:15" />سَلْمُوا عَالإِخْوَة الِّي فِي لَاوْدُكِيَّة، وعْلَى نِمْفَا والكْنِيسَة الِّي تِتْلَمْ فِي دَارْهَا. <verse eid="COL 4:15" /><verse number="16" style="v" sid="COL 4:16" />وبَعْدْمَا تَقْرَاوْ الرِّسَالَة هَاذِي، أَبْعْثُوهَا لِكْنِيسِةْ لَاوْدُكِيَّة بَاشْ يَقْرَاوْهَا المُؤْمْنِينْ غَادِي، وأَقْرَاوْ إِنْتُومَا زَادَا الرِّسَالَة الِّي عَنْدْهُمْ.<verse eid="COL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="COL 4:17" />قُولُوا لْأَرْخِبُّوسْ: «أَحْرِصْ بَاشْ تْكَمِّلْ الخِدْمَة الِّي عْطَاهَالِكْ الرَّبْ أَمَانَة».<verse eid="COL 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18" />السْلَامْ هَاذَا كْتِبْتُو بْخَطْ يِدِّي آنَا بُولِسْ. تْفَكْرُوا الِّي آنَا فِي الحَبْسْ. نِعْمِةْ اللَّهْ تْكُونْ مْعَاكُمْ!<verse eid="COL 4:18" /></para>
  <chapter eid="COL 4" />
</usx>