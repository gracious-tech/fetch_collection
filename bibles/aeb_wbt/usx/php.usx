<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id" />
  <para style="h">فِيلِپِّي</para>
  <para style="toc1">رِسَالِةْ بُولِسْ لِلْمُؤْمْنِينْ الِّي فِي فِيلِپِّي</para>
  <para style="toc2">فِيلِپِّي</para>
  <para style="toc3">فِيلِپِّي</para>
  <para style="mt">رِسَالِةْ بُولِسْ لِلْمُؤْمْنِينْ الِّي فِي فِيلِپِّي</para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />مِنْ بُولِسْ وتِيمُوثَاوُسْ، خُدَّامْ يَسُوعْ المَسِيحْ، لِخْوَاتْنَا القِدِّيسِينْ المُؤْمْنِينْ بْيَسُوعْ المَسِيحْ الِّي فِي مْدِينِةْ فِيلِپِّي، ولِلْمَسْؤُولِينْ عَالكْنِيسَة والخُدَّامْ المُدَبْرِينْ.<verse eid="PHP 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 1:2" />النِّعْمَة والسَّلَامْ لِيكُمْ مِنْ عَنْدْ اللَّهْ بُونَا ومِنْ عَنْدْ رَبْنَا يَسُوعْ المَسِيحْ.<verse eid="PHP 1:2" /></para>
  <para style="s">شُكْرْ ودُعَاء</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />نُشْكُرْ اللَّهْ كُلْ مَا نِتْفَكَّرْكُمْ، <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />ودِيمَا نِدْعِيلْكُمْ الكُلْ فِي صْلَاتِي وآنَا فَرْحَانْ، <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />عْلَى خَاطِرْكُمْ شَارِكْتُونِي فِي تَوْصِيلْ البْشَارَة مِنْ نْهَارِةْ الِّي قْبِلْتُوهَا لْتَوَّا. <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />وآنَا مِتْأَكِّدْ إِنُّو اللَّهْ الِّي بْدَا فِيكُمْ الخِدْمَة الصَّالْحَة هَاذِي، بِشْ يُقْعِدْ يْكَمِّلْ فِيهَا حَتَّى لِلنْهَارْ الِّي يِرْجَعْ فِيهْ يَسُوعْ المَسِيحْ.<verse eid="PHP 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 1:7" />وعَنْدِي الحَقْ نْحِسْ الإِحْسَاسْ هَاذَا مِنْ نَاحْيِتْكُمْ عْلَى خَاطِرْكُمْ دِيمَا فِي قَلْبِي، وعْلَى خَاطِرْكُمْ الكُلْ مْشَارْكِينِي فِي نِعْمَةْ اللَّهْ، تَوَّا وآنَا مَرْبُوطْ فِي الحَبْسْ وَلَّا وَقْتِلِّي نْدَافَعْ عَالبْشَارَة ونْظَهِّرْ الِّي هِيَّ الحَقْ. <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />واللَّهْ يِشْهِدْ قَدَّاشْ نْحِبْكُمْ الكُلْ بِالمْحَبَّة الِّي يَعْطِيهَا يَسُوعْ المَسِيحْ. <verse eid="PHP 1:8" /><verse number="9" style="v" sid="PHP 1:9" />ونْصَلِّي إِنُّو مْحَبِّتْكُمْ تْزِيدْ أَكْثِرْ وأَكْثِرْ فِي المَعْرْفَة والفَهْمْ الصْحِيحْ، <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />بَاشْ تْنَجْمُوا تَخْتَارُوا الأَحْسِنْ، وتْكُونُوا طَاهْرِينْ ومَا عْلِيكُمْشْ لُومْ حَتَّى لِلنْهَارْ الِّي يِرْجَعْ فِيهْ المَسِيحْ، <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />وتِتْمْلَى حْيَاتْكُمْ بِالأَعْمَالْ الصَّالْحَة النَّابْعَة مِنْ يَسُوعْ المَسِيحْ، بَاشْ يِرْجَعْ المَجْدْ والحَمْدْ لِلَّهْ.<verse eid="PHP 1:11" /></para>
  <para style="s">إِنْتِشَارْ البْشَارَة</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />ونْحِبْكُمْ تَعْرْفُوا يَا خْوَاتِي إِنُّو الِّي صَارْلِي خَلَّى البْشَارَة تُوصِلْ لْأَكْثِرْ بْقَايَعْ، <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" />حَتَّى مِالعَسْكِرْ الِّي فِي دَارْ الوِلَايَة، والنَّاسْ الِّي هُونِي الكُلْ، عَرْفُوا الِّي آنَا مَرْبُوطْ فِي الحَبْسْ عْلَى خَاطِرْ المَسِيحْ، <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />وبِسْبَبْ وْجُودِي فِي الحَبْسْ، أَغْلَبِيِّةْ المُؤْمْنِينْ وَلَّاتْ عَنْدُهُمْ ثِيقَة أَكْثِرْ فِي الرَّبْ بَاشْ يْبَشْرُوا بْكِلْمِةْ اللَّهْ بْشَجَاعَة ومِنْ غِيرْ خُوفْ.<verse eid="PHP 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15" />صْحِيحْ الِّي فَمَّة شْكُونْ قَاعْدِينْ يْبَشْرُوا بِالمَسِيحْ مِالغِيرَة والحُسْدْ، آمَا فَمَّة زَادَا الِّي يْبَشْرُوا بْنِيَّة صَافْيَة. <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />هَاذُومَا يَعْمْلُوا هَكَّا مِالمْحَبَّة، خَاطِرْهُمْ يَعْرْفُوا الِّي اللَّهْ إِخْتَارْنِي بَاشْ نْدَافَعْ عَالبْشَارَة. <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />آمَا الأُخْرِينْ يْبَشْرُوا بِالمَسِيحْ مِالغِيرَة ومُشْ بْنِيَّة صَافْيَة، مَاشِي فِي بَالْهُمْ إِنُّو الِّي يَعْمْلُوا فِيهْ بِشْ يْزِيدْ يْتَعَّبْنِي أَكْثِرْ وآنَا فِي الحَبْسْ. <verse eid="PHP 1:17" /><verse number="18" style="v" sid="PHP 1:18" />آمَا هَاذَا مَا يْهِمِّشْ، المُهِمْ هُوَّ الِّي التَبْشِيرْ بِالمَسِيحْ قَاعِدْ يْصِيرْ فِي كُلْ الحَالَاتْ، بْنِيَّة صَافْيَة وَلَّا خَايْبَة. آنَا فَرْحَانْ بْهَاذَا وبِشْ نْزِيدْ نِفْرَحْ. <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />وآنَا مِتْأَكِّدْ الِّي بِشْ نِنْجَى، عْلَى خَاطِرْ صْلَاتْكُمْ ورُوحْ يَسُوعْ المَسِيحْ بِشْ يْعَاوْنُونِي.<verse eid="PHP 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PHP 1:20" />الِّي نِسْتَنَّى فِيهْ بِالحَقْ ونِتْمَنَّاهْ إِنُّو عُمْرِي مَا نْخِيبْ فِي حَتَّى شَيْ، آمَا تْكُونْ عَنْدِي الشَّجَاعَة فِي كُلْ وَقْتْ وبِالأَخَصْ تَوَّا، بَاشْ يِتْمَجِّدْ المَسِيحْ فِي حْيَاتِي الكُلْ، سِوَى عِشْتْ وَلَّا مُتِتْ. <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />عْلَى خَاطِرْ بِالنِّسْبَة لِيَّا الحَيَاةْ هِيَّ المَسِيحْ، والمُوتْ رِبْحْ لِيَّا. <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />آمَا كَانْ قْعَدِتْ حَيْ انَّجِّمْ نْزِيدْ نَعْمِلْ أَعْمَالْ عَنْدْهَا قِيمَة، هَاذَاكَا عْلَاشْ مَا نَعْرَفْشْ شْنُوَّة نِخْتَارْ! <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />وآنَا حَايِرْ بِينْ الإِثْنِينْ: نْحِبْ نِمْشِي مِالدِّنْيَا هَاذِي ونْكُونْ مْعَ المَسِيحْ، وهَاذَا خِيرْ بَرْشَة، <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />آمَا عْلَى خَاطِرْكُمْ إِنْتُومَا، مُهِمْ بَرْشَة إِنِّي نُقْعُدْ عَايِشْ. <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />ومَادَامْنِي مِتْأَكِّدْ مِنْ هَاذَا، آنَا نَعْرِفْ الِّي بِشْ نَبْقَى مْعَاكُمْ الكُلْ، بَاشْ تِتْقَدْمُوا وتِفْرْحُوا فِي الإِيمَانْ، <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />وهَكَّا، حْضُورِي مْعَاكُمْ مَرَّة أُخْرَى، يْكُونْ سْبَبْ بَاشْ تْزِيدْ فُخْرِتْكُمْ بْيَسُوعْ المَسِيحْ.<verse eid="PHP 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27" />المُهِمْ تَوَّا هُوَّ إِنْكُمْ تْعِيشُوا عِيشَة تْلِيقْ بِبْشَارِةْ المَسِيحْ، بَاشْ كَانْ جِيتْ وشُفْتْكُمْ، وَلَّا سْمَعْتْ عْلِيكُمْ وآنَا غَايِبْ، نَعْرِفْ الِّي إِنْتُومَا ثَابْتِينْ بْرُوحْ وَاحِدْ وتْجَاهْدُوا بْقَلْبْ وَاحِدْ عْلَى خَاطِرْ الإِيمَانْ بِالبْشَارَة. <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />مَا تْخَافُوشْ بِالكُلْ مِالنَّاسْ الِّي يْجِيوْ ضِدْكُمْ. هَاذَاكَا دَلِيلْ الِّي هُومَا بِشْ يِمْشِيوْ لِلْهْلَاكْ ولِّي إِنْتُومَا بِشْ تِنْجَاوْ. وهَاذَا فَضْلْ مِنْ عَنْدْ اللَّهْ، <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />رَاهُو، عْلَى خَاطِرْ المَسِيحْ، نْعِمْ عْلِيكُمْ مُشْ بَاشْ تَمْنُوا بِيهْ أَكَهَوْ، آمَا بَاشْ تِتْعَذْبُوا عْلَى خَاطْرُو زَادَا، <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" />وإِنْتُومَا تْجَاهْدُوا فِي نَفْسْ الجِهَادْ الِّي شُفْتُوهْ فِيَّا قْبَلْ، وتِسْمْعُوا الِّي آنَا مَزِّلْتْ نْجَاهِدْ فِيهْ لْتَوَّا.<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="s">تَوَاضُعْ المَسِيحْ</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />مَادَامْكُمْ مِتْشَجْعِينْ فِي المَسِيحْ، ومَادَامْكُمْ مِرْتَاحِينْ فِي مْحَبْتُو، ومَادَامْ عَنْدْكُمْ شِرْكَة فِي الرُّوحْ، ومَادَامْ عَنْدْكُمْ حَنَانْ ورَحْمَة، <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />مَالَا كَمْلُوا فَرْحْتِي وخَلِّي يْكُونْ عَنْدْكُمْ رَايْ وَاحِدْ ومْحَبَّة وَحْدَة، وقَلْبْ وَاحِدْ وهَدَفْ وَاحِدْ. <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />مَا تَعْمْلُوا حَتَّى شَيْ بْغِيرَة وبْفُخْرَة، آمَا كُونُوا مِتْوَاضْعِينْ وبَجْلُوا الأُخْرِينْ عْلَى رْوَاحْكُمْ. <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />خَلِّي كُلْ وَاحِدْ فِيكُمْ يْلَوِّجْ عْلَى مَصْلَحْةْ غِيرُو، مُشْ كَانْ عْلَى مَصْلَحْتُو الخَاصَّة.<verse eid="PHP 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 2:5" />وخَلِّي يْكُونْ عَنْدْكُمْ فِكْرْ يَسُوعْ المَسِيحْ:<verse eid="PHP 2:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PHP 2:6" />بِالرَّغْمْ الِّي عَنْدُو نَفْسْ طَبِيعِةْ اللَّهْ</para>
  <para style="q2" vid="PHP 2:6">مَا إِعْتَبَرْشْ مُسَاوَاتُو مْعَ اللَّهْ حَاجَة لَازْمُو يْشِدْ فِيهَا صْحِيحْ،<verse eid="PHP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PHP 2:7" />بِالعَكْسْ، فَرِّطْ فِي بْلَاصْتُو،</para>
  <para style="q2" vid="PHP 2:7">وخْذَا طَبِيعِةْ عَبْدْ خْدِيمْ،</para>
  <para style="q1" vid="PHP 2:7">ووَلَّى كِيمَا البَشَرْ<verse eid="PHP 2:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PHP 2:8" />وجَاء فِي هَيْئِةْ إِنْسَانْ،</para>
  <para style="q1" vid="PHP 2:8">تْوَاضَعْ وطَاعْ حَتَّى لِلْمُوتْ،</para>
  <para style="q2" vid="PHP 2:8">المُوتْ الِّي عَالصَّلِيبْ.<verse eid="PHP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PHP 2:9" />هَاذَاكَا عْلَاشْ، اللَّهْ عْطَاهْ أَعْلَى مْقَامْ،</para>
  <para style="q2" vid="PHP 2:9">وعْطَاهْ إِسْمْ أَعْظَمْ مِنْ كُلْ إِسْمْ،<verse eid="PHP 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10" />بَاشْ تُسْجُدْ لْإِسْمْ يَسُوعْ كُلْ رُكْبَة فِي السْمَاء</para>
  <para style="q2" vid="PHP 2:10">وفِي الأَرْضْ وتَحْتْ الأَرْضْ،<verse eid="PHP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PHP 2:11" />ويِشْهِدْ كُلْ لْسَانْ الِّي يَسُوعْ المَسِيحْ هُوَّ الرَّبْ،</para>
  <para style="q2" vid="PHP 2:11">بَاشْ يِتْمَجِّدْ اللَّهْ الآبْ.<verse eid="PHP 2:11" /></para>
  <para style="b" />
  <para style="s">إِضْوِيوْ فِي العَالِمْ</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />مَالَا يَا حْبَابِي، كِيمَا كُنْتُوا دِيمَا اطِّيعُوا وآنَا حَاضِرْ مْعَاكُمْ، طِيعُوا أَكْثِرْ تَوَّا وآنَا غَايِبْ عْلِيكُمْ، وإِسْعَاوْ بَاشْ تْكَمْلُوا نْجَاتْكُمْ بْخُوفْ ورَهْبَة، <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />عْلَى خَاطِرْ اللَّهْ هُوَّ الِّي يَخْلَقْ فِيكُمْ الرَّغْبَة والقُدْرَة بَاشْ تَعْمْلُوا الحَاجَاتْ الِّي تْرَضِّيهْ.<verse eid="PHP 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 2:14" />أَعْمْلُوا كُلْ شَيْ مِنْ غِيرْ مَا تِتْشَكَّاوْ وَلَّا تِتْعَارْكُوا، <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />بَاشْ تْكُونُوا طَاهْرِينْ ومَا عْلِيكُمْشْ لُومْ، وْلَادْ اللَّهْ الِّي مَا فِيهُمْشْ عِيبْ فِي وِسْطْ جِيلْ ضَايَعْ وفَاسِدْ، وإِنْتُومَا تِضْوِيوْ فِيهْ كِيمَا النْجُومْ تْضَوِّي السْمَاء، <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />شَادِّينْ صْحِيحْ فِي كِلْمِةْ الحَيَاةْ. وهَكَّا نِتْفَخِّرْ بِيكُمْ فِي يُومْ المَسِيحْ عْلَى خَاطِرْ مَا سْعِيتِشْ ومَا تْعِبْتِشْ بْلَا فَايْدَة. <verse eid="PHP 2:16" /><verse number="17" style="v" sid="PHP 2:17" />وحَتَّى كَانْ دَمِّي يْسِيلْ كِيمَا الضْحِيَّة فُوقْ ضْحِيِّتْكُمْ الِّي قَدَّمْتُوهَا لِلَّهْ ولِّي هِيَّ إِيمَانْكُمْ وخِدْمِتْكُمْ، آنَا بِشْ نْكُونْ فَرْحَانْ وإِنْتُومَا زَادَا. <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />وإِنْتُومَا مِنْ جِيهِتْكُمْ إِفْرْحُوا وفَرْحُونِي مْعَاكُمْ.<verse eid="PHP 2:18" /></para>
  <para style="s">تِيمُوثَاوُسْ</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />كَانْ سَهِّلْ الرَّبْ يَسُوعْ، نْحِبْ نِبَعْثِلْكُمْ تِيمُوثَاوُسْ عْلَى قْرِيبْ بَاشْ نَعْرِفْ أَحْوَالْكُمْ ويِطْمَانْ قَلْبِي عْلِيكُمْ. <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />رَاهُو مَا عَنْدِيشْ شْكُونْ كِيفُو، قَلْبُو عْلِيكُمْ بِالحَقْ، <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />عْلَى خَاطِرْ الكُلْ يِجْرِيوْ عْلَى مَصْلْحِتْهُمْ مُشْ عْلَى مَصْلَحْةْ يَسُوعْ المَسِيحْ. <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />وإِنْتُومَا تَعْرْفُوا خِبْرِةْ تِيمُوثَاوُسْ وكِيفَاشْ خْدِمْ مْعَايَا فِي تَوْصِيلْ البْشَارَة كِيمَا يِخْدِمْ الوْلِدْ مْعَ بُوهْ. <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />هَاذَاكَا عْلَاشْ نْحِبْ نِبْعَثْهُولْكُمْ دُوبْ مَا تِتْوَضَّحْ أُمُورِي. <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />وعَنْدِي ثِيقَة فِي الرَّبْ الِّي آنَا زَادَا بِشْ نْجِيكُمْ عْلَى قْرِيبْ.<verse eid="PHP 2:24" /></para>
  <para style="s">أَبَفْرُودِيتُسْ</para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25" />وشُفْتْ الِّي لَازِمْ نِبَعْثِلْكُمْ خُويَا أَبَفْرُودِيتُسْ الِّي خْدِمْ وجَاهِدْ مْعَايَا، ولِّي بْعَثْتُوهُولِي بَاشْ يْعَاوِنِّي، <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />عْلَى خَاطْرُو تْوَحَّشْكُمْ الكُلْ بَرْشَة، واتْقَلَّقْ كِي سْمَعْتُوا بِلِّي هُوَّ مْرِيضْ. <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />هُوَّ كَانْ مْرِيضْ بَرْشَة وقْرِيبْ لَا مَاتْ، آمَا اللَّهْ حَنْ عْلِيهْ وحَنْ عْلِيَّا آنَا زَادَا، بَاشْ مَا نْزِيدِشْ نَحْزِنْ أَكْثِرْ. <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />هَاذَا الِّي خَلَّانِي نِبْعَثْهُولْكُمْ فِيسَعْ، بَاشْ تِفْرْحُوا كِي تْشُوفُوهْ ويُنْقُصْ حُزْنِي. <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />مَالَا إِسْتَقْبْلُوهْ بْكُلْ فَرْحَة بِإِعْتِبَارُو خُوكُمْ فِي الرَّبْ، وإِكْرْمُوا النَّاسْ الِّي كِيفُو، <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />رَاهُو قْرِيبْ لَا مَاتْ عْلَى خَاطِرْ خِدْمِةْ المَسِيحْ. وخَاطِرْ بِحْيَاتُو بَاشْ يَعْمِلْ الِّي مَا نَجَّمْتُوشْ تَعْمْلُوهُولِي إِنْتُومَا خَاطِرْكُمْ بْعَادْ.<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s">الصَّلَاحْ الحْقِيقِي</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />فِي الإِخِّرْ، يَا خْوَاتِي، إِفْرْحُوا فِي الرَّبْ. مَا يْقَلَّقْنِيشْ إِنِّي نْعَاوِدْ نِكْتْبِلْكُمْ عْلَى نَفْسْ الحَاجَاتْ، رَاهِي مْعَاوْدِتْهَا تَحْمِيكُمْ. <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />رُدُّوا بَالْكُمْ مِالكْلَابْ، الِّي يَعْمْلُوا فِي الشَّرْ، ويْحِبُّوا يْلِزُّوكُمْ لِلْطْهُورْ، <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />رَانَا أَحْنَا المْطَهْرِينْ بِالطْهُورْ الحْقِيقِي، عْلَى خَاطِرْنَا نِعْبْدُوا اللَّهْ بِالرُّوحْ، ونِتْفَخْرُوا بْيَسُوعْ المَسِيحْ، ومَا نْعَمْلُوشْ عْلَى حَاجَاتْ تْخُصْ البْدَنْ مِنْ بَرَّا، <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />رَغْمِلِّي عَنْدِي الحَقْ بَاشْ نْعَمِّلْ عْلِيهَا. إِذَا كَانْ وَاحِدْ مَاشِي فِي بَالُو الِّي مِنْ حَقُّو بَاشْ يْعَمِّلْ عَالحَاجَاتْ هَاذِي، رَانِي آنَا أَحَقْ مِنُّو: <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" />كَانِكْ عَالطْهُورْ مْطَهَّرْ مِلِّي عُمْرِي ثْمَنْيَة أَيَّامْ، وآنَا مِنْ بَنِي إِسْرَائِيلْ، مِنْ عَرْشْ بِنْيَامِينْ، عِبْرَانِي بُو عِالجِّدْ! ومِنْ جِيهِةْ الشَّرِيعَة فِرِّيسِي، <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" />ومِنْ كُثْرِةْ غِيرْتِي، كُنْتْ نِضْطَهِدْ فِي الكْنِيسَة، وبِالنِّسْبَة لِلصَّلَاحْ الِّي تُطْلْبُو الشَّرِيعَة، مَا كَانْ عْلِيَّا حَتَّى لُومْ.<verse eid="PHP 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 3:7" />الحَاجَاتْ هَاذِي الكُلْ الِّي كُنْتْ نَعْتَبِرْهَا مُهِمَّة، تَوَّا وَلَّاتْ بْلَا قِيمَة عَنْدِي عْلَى خَاطِرْ المَسِيحْ، <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />وأَكْثِرْ مِنْ هَكَّا، كُلْ شَيْ نِحْسْبُو بْلَا قِيمَة قُدَّامْ الرِّبْحْ الكْبِيرْ، الِّي هُوَّ مَعْرِفْةْ يَسُوعْ المَسِيحْ رَبِّي. وآنَا عْلَى خَاطْرُو خْسَرْتْ كُلْ شَيْ، وحْسِبْتْ كُلْ شَيْ زِبْلَة بَاشْ نِرْبَحْ المَسِيحْ <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />ونْوَلِّي تَابْعُو، ويَعْتَبِرْنِي اللَّهْ صَالَحْ، مُشْ عْلَى أَسَاسْ الشَّرِيعَة، آمَا بِالإِيمَانْ بِالمَسِيحْ. وهَاذَا هُوَّ الصَّلَاحْ الِّي يَعْطِيهْ اللَّهْ عْلَى أَسَاسْ الإِيمَانْ. <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />آنَا نْحِبْ نَعْرِفْ المَسِيحْ، ونَعْرِفْ قُوِّةْ قْيَامْتُو، ونْشَارْكُو فِي وْجَايْعُو، ونْوَلِّي كِيفُو فِي مُوتُو، <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />فَمَّاشْ مَا نُوصِلْ لِلْقْيَامَة مِالمُوتْ.<verse eid="PHP 3:11" /></para>
  <para style="s">بُولِسْ يِسْعَى بَاشْ يُوصِلْ لِلهَدَفْ</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />ومَانِيشْ نْقُولْ الِّي آنَا وْصِلْتْ لِلْهَدَفْ وَلَّا وَلِّيتْ كَامِلْ، آمَا نِسْعَى بَاشْ نُوصِلْ لِلْجَايْزَة عْلَى خَاطِرْ يَسُوعْ المَسِيحْ إِخْتَارْنِي بَاشْ نْكُونْ تَابَعْ لِيهْ. <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />يَا خْوَاتِي، آنَا مَا نَعْتَبِرْشْ رُوحِي رْبِحْتْ الجَايْزَة، آمَا تْهِمْنِي حَاجَة وَحْدَة وهِيَّ: إِنِّي نِنْسَى كُلْ مَاهُو وْرَايَا ونَعْمِلْ كُلْ مَجْهُودِي بَاشْ نْقَدِّمْ لْقُدَّامْ، <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />ونِجْرِي بَاشْ نُوصِلْ لِلْهَدَفْ، ونِرْبَحْ الجَايْزَة الِّي دْعَانَا لِيهَا اللَّهْ مِالسْمَاء بْيَسُوعْ المَسِيحْ، <verse eid="PHP 3:14" /><verse number="15" style="v" sid="PHP 3:15" />أَحْنَا النَّاضْجِينْ رُوحِيًّا، يِلْزِمْ نْفَكْرُوا بِالطَّرِيقَة هَاذِي. وكَانْ عَنْدْكُمْ رَايْ آخِرْ، تَوَّا اللَّهْ يْزِيدْ يْوَضْحِلْكُمْ الأُمُورْ. <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />آمَا تَوَّا، خَلِّينَا نْكَمْلُوا طْرِيقْنَا وأَحْنَا نْتَبْعُوا فِي الحَقْ الِّي عْرَفْنَاهْ.<verse eid="PHP 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17" />يَا خْوَاتِي، خُوذُونِي قُدْوَة لِيكُمْ، وخَلِّيوْ عِينِيكُمْ عَالنَّاسْ الِّي يِتْصَرْفُوا كِيفْنَا. <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />سْبَقْ وقُلْتِلْكُمْ هَاذَا بَرْشَة مَرَّاتْ، ونْزِيدْ نْقُولْهُولْكُمْ تَوَّا ودْمُوعِي فِي عِينَيَّا: فَمَّة بَرْشَة يِتْصَرْفُوا كِيمَا يِتْصَرْفُوا أَعْدَاءْ صَلِيبْ المَسِيحْ. <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />هَاذُومَا عَاقْبِتْهُمْ الهْلَاكْ، إِلَاهُّمْ هُوَّ كْرُوشْهُمْ، ويِتْفُوخْرُوا بْعَارْهُمْ، ومَا يْفَكْرُوا كَانْ فِي أُمُورْ الدِّنْيَا هَاذِي. <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />آمَا أَحْنَا، جِنْسِيِّتْنَا سْمَاوِيَّة، ونِسْتَنَّاوْ مِتْشَوْقِينْ بَاشْ يِرْجَعْ مِالسْمَاء الرَّبْ يَسُوعْ المَسِيحْ بَاشْ يْنَجِّينَا. <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />هُوَّ الِّي بِشْ يْبَدِّلْ بْدَنَّا الضْعِيفْ، ويْرُدُّو كِيمَا بَدْنُو المَجِيدْ، وهَاذَا بْقُدْرْتُو الِّي بِيهَا يْخَلِّي كُلْ شَيْ يِخْضَعْلُو.<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="s">آخِرْ وْصَايَا</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />مَالَا، يَا خْوَاتِي الِّي نْحِبْهُمْ ومِتْوَحَّشْهُمْ، يَا فَرْحْتِي وتَاجْ رَاسِي، إِثْبْتُوا فِي الرَّبْ يَا حْبَابِي.<verse eid="PHP 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />نْأَكِّدْ عْلَى أَفُودِيَة وسِنْتِيخِي إِنْهُمْ يْكُونُوا بْرَايْ وَاحِدْ بِإِعْتِبَارْهُمْ مُؤْمْنَاتْ بِالرَّبْ. <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />وإِنْتِ، يَا شْرِيكِي المُخْلِصْ، نْحِبِّكْ تْعَاوِنْهُمْ عْلَى خَاطِرْهُمْ جَاهْدُوا مْعَايَا فِي خِدْمِةْ البْشَارَة، هُومَا وإِكْلِيمَنْدُسْ ولِّي عَاوْنُونَا الكُلْ، الِّي أَسَامِيهُمْ مَكْتُوبَة فِي كْتَابْ الحَيَاةْ.<verse eid="PHP 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4" />إِفْرْحُوا دِيمَا فِي الرَّبْ، ونْزِيدْ نْقُولِلْكُمْ: إِفْرْحُوا. <verse eid="PHP 4:4" /><verse number="5" style="v" sid="PHP 4:5" />خَلِّي النَّاسْ يْلَاحْظُوا وِسْعْ بَالْكُمْ. رَاهُو الرَّبْ قْرِيبْ. <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />مَا تِتْقَلْقُوشْ عْلَى حَتَّى شَيْ، آمَا فِي كُلْ شَيْ، أُطْلْبُوا الِّي تِحْتَاجُوهْ مِنْ عَنْدْ اللَّهْ بِالصَّلَاةْ والدُّعَاءْ والشُّكْرْ، <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />وسَلَامْ اللَّهْ الِّي أَقْوَى مِنْ فَهْمْنَا، يَحْفِظْ قْلُوبْكُمْ وأَفْكَارْكُمْ فِي يَسُوعْ المَسِيحْ.<verse eid="PHP 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8" />وفِي الإِخِّرْ، يَا خْوَاتِي، دِيمَا فَكْرُوا فِي كُلْ مَا هُوَّ حَقْ وشْرِيفْ وعَادِلْ وطَاهِرْ، وكُلْ مَا هُوَّ مُسْتْحَبْ وسُمْعْتُو طَيْبَة، وكُلْ مَاهُو بَاهِي ويِسْتْحَقْ الشُّكْرْ، <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />وأَعْمْلُوا بِلِّي عَلَّمْتْهُولْكُمْ وخْذِيتُوهْ عْلِيَّا، ولِّي سْمَعْتُوهْ مِنِّي ورِيتُوهْ فِيَّا، وإِلَاهْ السَّلَامْ يْكُونْ مْعَاكُمْ.<verse eid="PHP 4:9" /></para>
  <para style="s">بُولِسْ يُشْكُرْ عَالحَاجَاتْ الِّي بَعْثُوهَالُو</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />فْرَحْتْ بَرْشَة فِي الرَّبْ وَقْتِلِّي شُفْتْ الِّي إِنْتُومَا رْجَعْتُوا لَاهِينْ بِيَّا. صْحِيحْ كُنْتُوا مِنْ قْبَلْ تْفَكْرُوا فِيَّا، آمَا مَا كَانِشْ عَنْدْكُمْ فُرْصَة بَاشْ تْظَهْرُوا هَاذَا. <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />ومَانِيشْ نْقُولْ هَكَّا عْلَى خَاطِرْنِي مُحْتَاجْ، آنَا تْعَلَّمْتْ كِيفَاشْ نِرْضَى بِلِّي عَنْدِي فِي كُلْ الأَحْوَالْ. <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />وآنَا نَعْرِفْ كِيفَاشْ نْعِيشْ فِي الفَقْرْ، كِيمَا نَعْرِفْ نْعِيشْ فِي الغْنَى، وفِي كُلْ الأَحْوَالْ، جَرَّبْتْ الشْبَعْ والجُّوعْ، وتْعَلَّمْتْ نْعِيشْ فِي الخِيرْ وَلَّا نْعِيشْ مُحْتَاجْ، <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />وآنَا قَادِرْ نِتْحَمِّلْ كُلْ شَيْ بِالمَسِيحْ الِّي يْقَوِّينِي.<verse eid="PHP 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14" />آمَا بَاهِي الِّي إِنْتُومَا شَارِكْتُونِي فِي ضِيقْتِي. <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />وإِنْتُومَا تَعْرْفُوا، يَا أَهْلْ فِيلِپِّي، الِّي مِلِّي مْشِيتْ مِنْ مَنْطَقْةْ مَقْدُونِيَّة وبْدِيتْ نْبَشِّرْ، مَا فَمَّة حَتَّى كْنِيسَة عَاوْنِتْنِي فِي المَدْخُولْ والمَصْرُوفْ كَانْ إِنْتُومَا. <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" />وحَتَّى كِي إِسْتْحَقِّيتْ وآنَا فِي تَسَالُونِيكِي، عَاوِنْتُونِي أَكْثِرْ مِنْ مَرَّة. <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />نْقُولْ هَكَّا مُشْ عْلَى خَاطِرْ نْحِبْكُمْ تَعْطِيوْنِي، آمَا نْحِبْ الرِّبْحْ يِتْزَادِلْكُمْ فِي حْسَابْكُمْ عْلَى خَاطِرْ الِّي عْمَلْتُوهْ الكُلْ. <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />وتَوَّا عَنْدِي الِّي نِحْتَاجُو الكُلْ وأَكْثِرْ. وأُمُورِي وَلَّاتْ لَابَاسْ بَعْدْمَا جَابْلِي أَبَفْرُودِيتُسْ الحَاجَاتْ الِّي بَعَثْتُوهَالِي مْعَاهْ، وهِيَّ كِيمَا قُرْبَانْ رِيحْتُو طَيْبَة، وذْبِيحَة يِقْبِلْهَا ويِرْضَى عْلِيهَا اللَّهْ. <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />وإِلَاهِي يَعْطِيكُمْ الِّي تَحْتَاجُوهْ الكُلْ بْحَسْبْ غْنَاهْ العْظِيمْ فِي يَسُوعْ المَسِيحْ . <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />المَجْدْ لِلَّهْ بُونَا لِلْأَبَدْ. آمِينْ.<verse eid="PHP 4:20" /></para>
  <para style="s">الخَاتْمَة</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />سَلْمُوا عَالقِدِّيسِينْ المُؤْمْنِينْ بْيَسُوعْ المَسِيحْ الكُلْ. يْسَلْمُوا عْلِيكُمْ الإِخْوَة الِّي مْعَايَا. <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />يْسَلْمُوا عْلِيكُمْ القِدِّيسِينْ المُؤْمْنِينْ الِّي هْنَا الكُلْ، وبِالأَخَصْ الِّي يِخْدْمُوا فِي قْصَرْ القَيْصِرْ. <verse eid="PHP 4:22" /><verse number="23" style="v" sid="PHP 4:23" />نِعْمِةْ الرَّبْ يَسُوعْ المَسِيحْ تْكُونْ مْعَاكُمْ الكُلْ. آمِينْ!<verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>