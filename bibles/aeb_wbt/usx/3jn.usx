<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id" />
  <para style="h">يُوحَنَّا الثَّالْثَة</para>
  <para style="toc1">رِسَالِةْ يُوحَنَّا الثَّالْثَة</para>
  <para style="toc2">يُوحَنَّا الثَّالْثَة</para>
  <para style="toc3">يُوحَنَّا الثَّالْثَة</para>
  <para style="mt">رِسَالِةْ يُوحَنَّا الثَّالْثَة</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />مِنِّي آنَا الشِّيخْ، لِحْبِيبِي غَايُوسْ الِّي نْحِبُّو بِالحَقْ.<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />يَا حْبِيبِي نْحِبِّكْ تْكُونْ نَاجِحْ فِي كُلْ شَيْ وتْكُونْ صَحِّةْ بَدْنِكْ بَاهْيَة، كِيفْ مَا حَالْتِكْ الرُّوحِيَّة بَاهْيَة.<verse eid="3JN 1:2" /></para>
  <para style="s">يُوحَنَّا يِمْدَحْ غَايُوسْ</para>
  <para style="p">
    <verse number="3" style="v" sid="3JN 1:3" />وفْرَحْتْ بَرْشَة كِي جَاوْ الإِخْوَة الِّي كَانُوا بَحْذَاكْ وحْكَاوْلِي كِيفَاشْ إِنْتِ مُخْلِصْ لِلْحَقْ وتْعِيشْ بِيهْ. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />وأَكْبِرْ فَرْحَة عَنْدِي كِي نِسْمَعْ الِّي وْلَادِي قَاعْدِينْ يْعِيشُوا فِي الحَقْ.<verse eid="3JN 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />يَا حْبِيبِي، إِنْتِ أَمِينْ فِي لَهْوْتِكْ بِالإِخْوَة حَتَّى لَوْ كَانْ مَا تَعْرِفْهُمْشْ، <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />وهُومَا الِّي شِهْدُوا عْلَى مْحَبْتِكْ هَاذِي قُدَّامْ الكْنِيسَة. وبَاهِي كَانْ تْعَاوِنْهُمْ بِلِّي يِسْتْحَقُّوهْ فِي السْفَرْ وهَاذِي حَاجَة تْرَضِّي اللَّهْ، <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />عْلَى خَاطِرْهُمْ خَرْجُوا يْبَشْرُوا بْإِسْمْ المَسِيحْ ومَا خْذَاوْ حَتَّى شَيْ مِنْ عَنْدْ أَيْ وَاحِدْ مُشْ مُؤْمِنْ. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />هَاذَاكَا عْلَاشْ لَازِمْنَا نْضَيْفُوا النَّاسْ الِّي كِيفْهُمْ، بَاشْ نِتْشَارْكُوا مْعَاهُمْ فِي خِدْمِةْ الحَقْ.<verse eid="3JN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />كْتِبْتْ لِلْكْنِيسَة، آمَا دِيُوتْرِيفُوسْ الِّي يُفْرُضْ فِي رُوحُو قَايِدْ عْلِيهُمْ مَا حَبِّشْ يِقْبِلْ كْلَامْنَا. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />هَاذَاكَا عْلَاشْ، وَقْتِلِّي نْجِيكُمْ، تَوْ نَحْكِي عَلِّي يَعْمِلْ فِيهْ وكِيفَاشْ يْشَوْهِلْنَا فِي سُمْعِتْنَا بِكْلَامْ مُشْ صْحِيحْ، ومَا كَفَّاهِشْ هَاذَا الكُلْ، زَادْ مَا قْبِلْشْ خْوَاتْنَا المْسَافْرِينْ، ومَا خَلَّاشْ شْكُونْ يِقْبِلْهُمْ ولِّي يِقْبِلْهُمْ يْطَرْدُو مِالكْنِيسَة.<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />يَا حْبِيبِي، مَا اتَّبَّعْشْ الشَّرْ آمَا تَبَّعْ الخِيرْ، رَاهُو الِّي يَعْمِلْ الخِيرْ هُوَّ مِنْ عَنْدْ اللَّهْ، ولِّي يَعْمِلْ الشَّرْ عُمْرُو مَا عْرَفْ اللَّهْ. <verse eid="3JN 1:11" /><verse number="12" style="v" sid="3JN 1:12" />النَّاسْ الكُلْ يِشْهْدُوا الِّي خُونَا دِيمِتْرِيُوسْ رَاجِلْ بَاهِي، والحَقْ بِيدُو يِشْهِدْلُو وأَحْنَا زَادَا نِشْهْدُولُو وإِنْتِ تَعْرِفْ الِّي شْهَادِتْنَا صَادْقَة.<verse eid="3JN 1:12" /></para>
  <para style="s">خَاتْمَة</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />مَزَّالْ عَنْدِي بَرْشَة حَاجَاتْ نْحِبْ نَحْكِيهَالِكْ آمَا مَا حَبِّيتِشْ نِكْتِبْهَا عَالأَوْرَاقْ. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />ونِتْمَنَّى نِتْقَابْلُوا عْلَى قْرِيبْ ونَحْكِيهَا مِنِّي لِيكْ. <verse eid="3JN 1:14" /><verse number="15" style="v" sid="3JN 1:15" />سَلَامْ اللَّهْ يْكُونْ مْعَاكْ، يْسَلْمُوا عْلِيكْ الأَحْبَابْ الكُلْ. وإِنْتِ سَلِّمْ عْلَى حْبَابْنَا كُلْ وَاحِدْ بْإِسْمُو.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>