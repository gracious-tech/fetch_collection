<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1PE" style="id" />
  <para style="h">بُطْرُسْ الأُولَى</para>
  <para style="toc1">رِسَالِةْ بُطْرُسْ الأُولَى</para>
  <para style="toc2">بُطْرُسْ الأُولَى</para>
  <para style="toc3">بُطْرُسْ الأُولَى</para>
  <para style="mt">رِسَالِةْ بُطْرُسْ الأُولَى</para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1" />مِنْ بُطْرُسْ، رَسُولْ يَسُوعْ المَسِيحْ، لِلِّي عَايْشِينْ فِي الغُرْبَة ومِتْفَرْقِينْ فِي كُلْ بْلَاصَة فِي بُنْطُسْ وغَلَاطْيَة وكَبَّدُوكِيَّة وآسِيَّا وبِثِينِيَّة، <verse eid="1PE 1:1" /><verse number="2" style="v" sid="1PE 1:2" />ولِّي اخْتَارْهُمْ اللَّهْ الآبْ حَسْبْ عِلْمُو بِالمْسَبَّقْ، وقَدَّسْهُمْ بِالرُّوحْ القُدُسْ بَاشْ يْطِيعُوا يَسُوعْ المَسِيحْ، ويِطَّهْرُوا بْدَمُّو الِّي سَالْ.</para>
  <para style="p" vid="1PE 1:2">يْزِيدْكُمْ اللَّهْ نِعْمَة وسَلَامْ.<verse eid="1PE 1:2" /></para>
  <para style="s">الحْيَاةْ الجْدِيدَة</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3" />مُبَارَكْ اللَّهْ بُو رَبْنَا يَسُوعْ المَسِيحْ، الِّي بْرَحْمْتُو العْظِيمَة وبِقْيَامِةْ يَسُوعْ المَسِيحْ مِالمُوتْ تُولِدْنَا مِنْ جْدِيدْ لِرْجَى حَيْ، <verse eid="1PE 1:3" /><verse number="4" style="v" sid="1PE 1:4" />ولْوَرْثَة مَا تِفْنَاشْ ومَا تِفْسِدْشْ ومَا تُوفَاشْ، مَحْفُوظَة لِيكُمْ فِي السْمَاء، <verse eid="1PE 1:4" /><verse number="5" style="v" sid="1PE 1:5" />إِنْتُومَا الِّي، بِالإِيمَانْ، مَحْفُوظِينْ بْقُدْرِةْ اللَّهْ، حَتَّى تْجِي النْجَاةْ الِّي بِشْ تُظْهُرْ فِي آخِرْ الزْمَانْ.<verse eid="1PE 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 1:6" />هَاذَا الِّي يْخَلِّيكُمْ تِفْرْحُوا، رَغْمِلِّي تَوَّا لَازِمْ تَحْزْنُوا لْمُدَّة قْصِيرَة، بِسْبَبْ كُلْ أَنْوَاعْ المْحَايِنْ الِّي تْجِيكُمْ ، <verse eid="1PE 1:6" /><verse number="7" style="v" sid="1PE 1:7" />ولِّي بِشْ تْبَيِّنْ إِذَا إِيمَانْكُمْ صْحِيحْ. وكِيمَا النَّارْ تْنَقِّي الذْهَبْ، المْحَايِنْ تْنَقِّي إِيمَانْكُمْ الِّي هُوَّ أَغْلَى مِالذْهَبْ. وهَكَّا تَاخْذُوا الشُّكْرْ والمَجْدْ والكَرَامَة نْهَارِةْ الِّي يِرْجَعْ يَسُوعْ المَسِيحْ. <verse eid="1PE 1:7" /><verse number="8" style="v" sid="1PE 1:8" />إِنْتُومَا تْحِبُّوهْ رَغْمِلِّي مَا شُفْتُوهِشْ، وتَمْنُوا بِيهْ رَغْمِلِّي تَوَّا مَاكُمْشْ تْرَاوْ فِيهْ، وتِفْرْحُوا فَرْحَة عْظِيمَة مَا تِتْوْصِفْشْ، <verse eid="1PE 1:8" /><verse number="9" style="v" sid="1PE 1:9" />عْلَى خَاطِرْ وْصِلْتُوا لْهَدَفْ إِيمَانْكُمْ، الِّي هُوَّ نْجَاتْكُمْ.<verse eid="1PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10" />وحَتَّى الأَنْبِيَاءْ الِّي تْنَبْؤُوا عَالنِّعْمَة الِّي حَضَّرْهَالْكُمْ اللَّهْ، فَرْكْسُوا ولَوْجُوا عَالنْجَاةْ هَاذِي <verse eid="1PE 1:10" /><verse number="11" style="v" sid="1PE 1:11" />وحَاوْلُوا يَعْرْفُوا وَقْتَاشْ يْصِيرُوا الأَحْدَاثْ الِّي قْصَدْهُمْ رُوحْ المَسِيحْ الِّي فِيهُمْ، وَقْتِلِّي سْبَقْ وخَبَّرْهُمْ عْلَى وْجَايَعْ المَسِيحْ والمَجْدْ الِّي بِشْ يْجِي بَعْدْهَا. <verse eid="1PE 1:11" /><verse number="12" style="v" sid="1PE 1:12" />آمَا اللَّهْ ظَهْرِلْهُمْ الِّي مَجْهُودْهُمْ مَا كَانِشْ لْفَايْدِتْهُمْ هُومَا آمَا لْفَايْدِتْكُمْ إِنْتُومَا، وهَاذَا كَانْ عْلَى خَاطِرْ البْشَارَة الِّي وَصْلُوهَالْكُمْ المُبَشْرِينْ فِي الوَقْتْ هَاذَا بِالرُّوحْ القُدُسْ الِّي تِبْعَثّْ مِالسْمَاء، البْشَارَة الِّي حَتَّى المْلَايْكَة تِتْمَنَّى تَعْرَفْهَا.<verse eid="1PE 1:12" /></para>
  <para style="s">كُونُوا قِدِّيسِينْ</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13" />هَاذَاكَا عْلَاشْ كُونُوا دِيمَا فَايْقِينْ، واتْحَكْمُوا فِي رْوَاحْكُمْ، وحُطُّوا رْجَاكُمْ فِي النِّعْمَة، الِّي بِشْ تْكُونْ لِيكُمْ وَقْتِلِّي يِرْجَعْ يَسُوعْ المَسِيحْ. <verse eid="1PE 1:13" /><verse number="14" style="v" sid="1PE 1:14" />مَادَامْكُمْ وَلِّيتُوا أَوْلَادْ اللَّهْ وتِسْمْعُوا كْلَامُو، مَالَا مَا عَادِشْ اتَّبْعُوا نَفْسْ الشْهَاوِي الِّي كُنْتُوا اتَّبْعُوا فِيهَا قْبَلْ كِي كُنْتُوا عَايْشِينْ فِي الجَهْلْ، <verse eid="1PE 1:14" /><verse number="15" style="v" sid="1PE 1:15" />آمَا كُونُوا قِدِّيسِينْ فِي كُلْ تَصَرُّفَاتْكُمْ كِيمَا الِّي دْعَاكُمْ هُوَّ زَادَا قُدُّوسْ. <verse eid="1PE 1:15" /><verse number="16" style="v" sid="1PE 1:16" />عْلَى خَاطِرْ اللَّهْ يْقُولْ فِي الكْتُبْ المُقَدْسَة: «يِلْزِمْكُمْ تْكُونُوا قِدِّيسِينْ، عْلَى خَاطِرْ آنَا قُدُّوسْ». <verse eid="1PE 1:16" /><verse number="17" style="v" sid="1PE 1:17" />ومَادَامْكُمْ تَعْتَرْفُوا الِّي اللَّهْ هُوَّ بُوكُمْ، ولِّي هُوَّ يُحْكُمْ عْلَى كُلْ وَاحِدْ حَسْبْ فِعْلُو مِنْ غِيرْ تَمْيِيزْ، مَالَا عِيشُوا مُدِّةْ غُرْبِتْكُمْ فِي الأَرْضْ وإِنْتُومَا خَايْفِينْ اللَّهْ، <verse eid="1PE 1:17" /><verse number="18" style="v" sid="1PE 1:18" />عَارْفِينْ الِّي اللَّهْ فْدَاكُمْ مِالسِّيرَة البَاطْلَة الِّي وْرِثْتُوهَا مِنْ جْدُودْكُمْ، مُشْ بْحَاجَاتْ فَانْيَة كِيمَا الذْهَبْ والفِضَّة، <verse eid="1PE 1:18" /><verse number="19" style="v" sid="1PE 1:19" />آمَا بْدَمْ غَالِي، دَمْ المَسِيحْ، الخَرُوفْ الطَّاهِرْ الِّي مَا فِيهْ حَتَّى عِيبْ. <verse eid="1PE 1:19" /><verse number="20" style="v" sid="1PE 1:20" />اخْتَارُو اللَّهْ لِلْمُهِمَّة هَاذِي قْبَلْ مَا يَخْلَقْ الدِّنْيَا، آمَا ظَهْرُو تَوَّا فِي آخِرْ الزْمَانْ عْلَى خَاطِرْكُمْ. <verse eid="1PE 1:20" /><verse number="21" style="v" sid="1PE 1:21" />وعْلَى طْرِيقُو هُوَّ إِنْتُومَا تَمْنُوا بِاللَّهْ، الِّي قَيْمُو مِالمُوتْ وعْطَاهْ المَجْدْ، بَاشْ إِيمَانْكُمْ ورْجَاكُمْ يْكُونُوا فِي اللَّهْ. <verse eid="1PE 1:21" /><verse number="22" style="v" sid="1PE 1:22" />وتَوَّا، بَعْدْمَا اطَّهْرِتْ رْوَاحْكُمْ كِي طُعْتُوا الحَقْ، وَلِّيتُوا قَادْرِينْ تْحِبُّوا اخْوَاتْكُمْ بِالحَقْ، مَالَا حِبُّوا بْعَضْكُمْ بِمْحَبَّة قْوِيَّة مِنْ قَلْبْ طَاهِرْ. <verse eid="1PE 1:22" /><verse number="23" style="v" sid="1PE 1:23" />عْلَى خَاطِرْكُمْ تُولِدْتُوا مِنْ جْدِيدْ، مُشْ مِنْ زَرْعْ يِفْنَى، آمَا مِنْ زَرْعْ مَا يِفْنَاشْ، مِنْ كِلْمِةْ اللَّهْ الحَيَّة والدَّايْمَة. <verse eid="1PE 1:23" /><verse number="24" style="v" sid="1PE 1:24" />رَاهُو الكْتُبْ المُقَدْسَة تْقُولْ:</para>
  <para style="b" vid="1PE 1:24" />
  <para style="q1" vid="1PE 1:24">«البَشَرْ الكُلْ كِيفْ الحْشِيشْ.</para>
  <para style="q2" vid="1PE 1:24">ومَجْدُو الكُلْ كِيفْ النَّوَّارْ.</para>
  <para style="q1" vid="1PE 1:24">الحْشِيشْ يِيبِسْ</para>
  <para style="q2" vid="1PE 1:24">والنَّوَّارْ يْطِيحْ،<verse eid="1PE 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="1PE 1:25" />آمَا كِلْمِةْ اللَّهْ ثَابْتَة لِلْأَبَدْ».</para>
  <para style="b" vid="1PE 1:25" />
  <para style="m" vid="1PE 1:25">وهَاذِي هِيَّ البْشَارَة الِّي وِصْلِتْكُمْ.<verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="s">المَسِيحْ هُوَّ الحَجْرَة الحَيَّة</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />مَالَا نَحِّيوْ مِنْكُمْ كُلْ خُبْثْ وكُلْ تَحَيُّلْ ونِفَاقْ وحُسْدْ وكُلْ تَقْطِيعْ وتَرْيِيشْ، <verse eid="1PE 2:1" /><verse number="2" style="v" sid="1PE 2:2" />وكِيمَا الصْغَارْ الِّي مَزَّالُوا كِي تْوِلْدُوا يِشْتْهَاوْ الحْلِيبْ، إِنْتُومَا زَادَا اشْتْهَاوْ كِلْمِةْ اللَّهْ، الِّي تِكْبْرُوا بِيهَا وتِنْجَاوْ. <verse eid="1PE 2:2" /><verse number="3" style="v" sid="1PE 2:3" />هَاذَا إِذَا كَانْ بِالحَقْ ذُقْتُوا وعْرَفْتُوا قَدَّاشْ الرَّبْ صَالَحْ.<verse eid="1PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 2:4" />مَالَا إِيجَاوِهْ بِٱعْتِبَارُو الحَجْرَة الحَيَّة المَرْفُوضَة عَنْدْ النَّاسْ، آمَا مُخْتَارَة وغَالْيَة عَنْدْ اللَّهْ. <verse eid="1PE 2:4" /><verse number="5" style="v" sid="1PE 2:5" />إِنْتُومَا زَادَا كِيفْ الحْجَرْ الحَيْ، تْكَوْنُوا بَنْيَة رُوحِيَّة، وتْكُونُوا فِيهَا كَهَنَة مَفْرُوزِينْ لِلَّهْ، تْقَدْمُوا بْيَسُوعْ المَسِيحْ، ذْبَايَحْ رُوحِيَّة مَقْبُولَة عَنْدْ اللَّهْ. <verse eid="1PE 2:5" /><verse number="6" style="v" sid="1PE 2:6" />وكِيمَا تْقُولْ الكْتُبْ المُقَدْسَة:</para>
  <para style="b" vid="1PE 2:6" />
  <para style="q1" vid="1PE 2:6">«هَانِي بِشْ نْحُطْ فِي صِهْيَوْنْ حَجْرِةْ السَّاسْ،</para>
  <para style="q2" vid="1PE 2:6">مُخْتَارَة وغَالْيَة،</para>
  <para style="q1" vid="1PE 2:6">ولِّي يَمِّنْ بِيهَا عُمْرُو مَا يْخِيبْ».<verse eid="1PE 2:6" /></para>
  <para style="b" />
  <para style="m">
    <verse number="7" style="v" sid="1PE 2:7" />هِيَّ عَنْدْهَا قِيمَة كْبِيرَة عَنْدْكُمْ إِنْتُومَا المُؤْمْنِينْ. آمَا عَنْدْ الِّي مَا يَمْنُوشْ:</para>
  <para style="b" vid="1PE 2:7" />
  <para style="q1" vid="1PE 2:7">«الحَجْرَة الِّي رَفْضُوهَا البَنَّايَا،</para>
  <para style="q2" vid="1PE 2:7">وَلَّاتْ حَجْرِةْ السَّاسْ».<verse eid="1PE 2:7" /></para>
  <para style="b" />
  <para style="m">
    <verse number="8" style="v" sid="1PE 2:8" />وهِيَّ زَادَا:</para>
  <para style="b" vid="1PE 2:8" />
  <para style="q1" vid="1PE 2:8">«الحَجْرَة الِّي تْخَلِّيهُمْ يَعْثْرُوا،</para>
  <para style="q2" vid="1PE 2:8">والصَّخْرَة الِّي تْخَلِّيهُمْ يْطِيحُوا».</para>
  <para style="b" vid="1PE 2:8" />
  <para style="m" vid="1PE 2:8">هُومَا يَعْثْرُوا عْلَى خَاطِرْ مَا يْطِيعُوشْ كِلْمِةْ اللَّهْ. وهَاذَا هُوَّ مَصِيرْهُمْ.<verse eid="1PE 2:8" /></para>
  <para style="s">أَحْنَا شَعْبْ اللَّهْ</para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9" />آمَا إِنْتُومَا رَاكُمْ سْلَالَة مُخْتَارَة، وكَهَنَة يِخْدْمُوا المَلِكْ، وأُمَّة مُقَدْسَة، وشَعْبْ تَابَعْ لِلَّهْ، إِخْتَارْكُمْ بَاشْ اتْخَبْرُوا بْأَعْمَالْ الِّي خَرَّجْكُمْ مِالظْلَامْ لْنُورُو العْجِيبْ.<verse eid="1PE 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="1PE 2:10" />قْبَلْ مَا كُنْتُوشْ شَعْبْ،</para>
  <para style="q2" vid="1PE 2:10">آمَا تَوَّا وَلِّيتُوا شَعْبْ اللَّهْ،</para>
  <para style="q1" vid="1PE 2:10">وقْبَلْ مَا عْرَفْتُوشْ رَحْمِةْ اللَّهْ،</para>
  <para style="q2" vid="1PE 2:10">آمَا تَوَّا رْحَمْكُمْ.<verse eid="1PE 2:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11" />يَا حْبَابِي، نْأَكِّدْ عْلِيكُمْ، بِإِعْتِبَارْكُمْ بْرَايْنِيَّة ومِتْغَرْبِينْ فِي الدِّنْيَا هَاذِي، بَاشْ مَا اتَّبْعُوشْ شْهَاوِي الطْبِيعَة البَشَرِيَّة الفَاسْدَة، الِّي تْحَارِبْ النَّفْسْ. <verse eid="1PE 2:11" /><verse number="12" style="v" sid="1PE 2:12" />عِيشُوا عِيشَة صَالْحَة فِي وِسْطْ الِّي مَا يَمْنُوشْ، بَاشْ، حَتَّى كَانْ يِتْهْمُوكُمْ بِالشَّرْ، يْشُوفُوا أَعْمَالْكُمْ الصَّالْحَة ويِحْمْدُوا اللَّهْ نْهَارِةْ الِّي يْجِي.<verse eid="1PE 2:12" /></para>
  <para style="s">طِيعُوا السُّلْطَة</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13" />ومْحَبَّة فِي الرَّبْ، إِخْضْعُوا لْكُلْ وَاحِدْ عَنْدُو سُلْطَة: إِخْضْعُوا لِلْمَلِكْ الِّي عَنْدُو أَعْلَى سُلْطَة، <verse eid="1PE 2:13" /><verse number="14" style="v" sid="1PE 2:14" />ولِلْحُكَّامْ الِّي حَطْهُمْ بَاشْ يْعَاقْبُوا المُذْنْبِينْ ويِكْرْمُوا الصَّالْحِينْ. <verse eid="1PE 2:14" /><verse number="15" style="v" sid="1PE 2:15" />عْلَى خَاطِرْ اللَّهْ يْحِبْكُمْ تَعْمْلُوا الصَّلَاحْ بَاشْ النَّاسْ الجُهَّالْ الِّي مَا يِفْهْمُوشْ يُسْكْتُوا ومَا عَادِشْ يِتْكَلْمُوا ضِدْكُمْ . <verse eid="1PE 2:15" /><verse number="16" style="v" sid="1PE 2:16" />عِيشُوا أَحْرَارْ، ومَا تِسْتْغَلُّوشْ الحُرِّيَة هَاذِي بَاشْ تَعْمْلُوا الشَّرْ، آمَا عِيشُوا بِإِعْتِبَارْكُمْ خُدَّامْ لِلَّهْ. <verse eid="1PE 2:16" /><verse number="17" style="v" sid="1PE 2:17" />إِكْرْمُوا النَّاسْ الكُلْ، حِبُّوا الإِخْوَة، خَافُوا اللَّهْ، إِكْرْمُوا المَلِكْ.<verse eid="1PE 2:17" /></para>
  <para style="s">إِتْحَمْلُوا الظُّلْمْ كِيمَا المَسِيحْ</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18" />يَا خُدَّامْ، إِخْضْعُوا لْأَسْيَادْكُمْ وإِحْتَرْمُوهُمْ، مُشْ البَاهِينْ والطَّيْبِينْ أَكَهَوْ، آمَا الصْعَابْ زَادَا. <verse eid="1PE 2:18" /><verse number="19" style="v" sid="1PE 2:19" />رَاهُو فَضْلْ مِنْ عَنْدْ اللَّهْ إِذَا كَانْ، عْلَى خَاطْرُو، الوَاحِدْ يِتْحَمِّلْ الوْجَايَعْ وَقْتِلِّي يِتْعَذَّبْ وهُوَّ مَظْلُومْ. <verse eid="1PE 2:19" /><verse number="20" style="v" sid="1PE 2:20" />شْنِيَّة المْزِيَّة الِّي عْمَلْتُوهَا وَقْتِلِّي تُغْلْطُوا وتُصْبْرُوا عَالعِقْابْ الِّي تِسْتَاهْلُوهْ؟ آمَا كَانْ تِتْحَمْلُوا الوْجَايَعْ وإِنْتُومَا تَعْمْلُوا فِي الخِيرْ، هَاذَا فَضْلْ عَنْدْ اللَّهْ. <verse eid="1PE 2:20" /><verse number="21" style="v" sid="1PE 2:21" />عْلَى خَاطِرْ اللَّهْ دْعَاكُمْ لْهَاذَا. والمَسِيحْ زَادَا تْعَذَّبْ عْلَى خَاطِرْكُمْ وخَلَّالْكُمْ مِثَالْ بَاشْ اتَّبْعُوهْ. <verse eid="1PE 2:21" /><verse number="22" style="v" sid="1PE 2:22" />هُوَّ مَا عْمَلْشْ حَتَّى ذَنْبْ، ولَا عُمْرُو كْذِبْ. <verse eid="1PE 2:22" /><verse number="23" style="v" sid="1PE 2:23" />كِي تْسَبْ مَا رَجَّعْشْ السَّبَّة. وكِي تْعَذَّبْ مَا هَدَّدْ حَدْ، آمَا سَلِّمْ أَمْرُو لِلِّي يُحْكُمْ بِالعَدْلْ، <verse eid="1PE 2:23" /><verse number="24" style="v" sid="1PE 2:24" />هُوَّ تْحَمِّلْ عِقَابْ ذْنُوبْنَا فِي بَدْنُو عَالصَّلِيبْ بَاشْ نْمُوتُوا أَحْنَا بِالنِّسْبَة لِلذْنُوبْ ونْعِيشُوا لِلْحَقْ. وهُوَّ الِّي تِشْفِيتُوا بِجْرُوحُو. <verse eid="1PE 2:24" /><verse number="25" style="v" sid="1PE 2:25" />كُنْتُوا كِيفْ العْلَالِشْ الضَّايْعِينْ، آمَا تَوَّا رْجَعْتُوا لِلِّي يَرْعَى نْفُوسْكُمْ ويَحْفَظْهَا.<verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="s">الزَوْجَاتْ والأَزْوَاجْ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1" />وإِنْتُومَا زَادَا يَا نْسَاء، إِخْضْعُوا لْرْجَالْكُمْ، بَاشْ حَتَّى كَانْ فِيهُمْ الِّي مَا يَمِّنْشْ بْكِلْمِةْ اللَّهْ، مُمْكِنْ تْنَجِّمْ تِرْبْحُو لِلْإِيمَانْ بْسِيرِتْهَا البَاهْيَة مِنْ غِيرْ مَا تِتْكَلِّمْ، <verse eid="1PE 3:1" /><verse number="2" style="v" sid="1PE 3:2" />وَقْتِلِّي يْلَاحِظْ سِيرِتْهَا المُحْتَرْمَة والعْفِيفَة. <verse eid="1PE 3:2" /><verse number="3" style="v" sid="1PE 3:3" />مَا تْخَلِّيوِشْ زِينِتْكُمْ تْكُونْ بِالزِّينَة البَرَّانِيَة، بِالشْعَرْ المَظْفُورْ والصْيَاغَة الذْهَبْ واللِّبْسَة الغَالْيَة، <verse eid="1PE 3:3" /><verse number="4" style="v" sid="1PE 3:4" />آمَا خَلِّيوْ زِينِتْكُمْ تْكُونْ دَخْلَانِيَّة، فِي القَلْبْ، زِينِةْ الرُّوحْ السِّيْسَة والهَادْيَة. هَاذِي هِيَّ الزِّينَة الِّي مَا تِفْنَاشْ، ولِّي قِيمِتْهَا عَنْدْ اللَّهْ كْبِيرَة. <verse eid="1PE 3:4" /><verse number="5" style="v" sid="1PE 3:5" />وقْبَلْ، كَانُوا النْسَاء الصَّالْحَاتْ الِّي حَطُّوا رْجَاهُمْ فِي اللَّهْ يْزَيْنُوا رْوَاحْهُمْ بِالزِّينَة هَاذِي. وكَانِتْ كُلْ وَحْدَة اطِّيعْ رَاجِلْهَا، <verse eid="1PE 3:5" /><verse number="6" style="v" sid="1PE 3:6" />كِيمَا كَانِتْ سَارَّة اطِّيعْ إِبْرَاهِيمْ، وتْنَادِيلُو سِيدِي. إِنْتُومَا تْوَلِّيوْ بْنَاتْهَا بِالحَقْ، كِي تِتْصَرْفُوا بِالبَاهِي ومَا تْخَافُوا مِنْ حَتَّى شَيْ.<verse eid="1PE 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7" />وإِنْتُومَا زَادَا يَا رْجَالْ، عِيشُوا مْعَ نْسَاكُمْ مْرَاعِينْ الِّي هُومَا أَضْعَفْ مِنْكُمْ، وإِكْرْمُوهُمْ عْلَى خَاطِرْهُمْ مْشَارْكِينْكُمْ فِي نَفْسْ الوَرْثَة، الِّي هِيَّ نِعْمِةْ الحَيَاةْ، بَاشْ حَتَّى شَيْ مَا يْعَطِّلْ صْلَاتْكُمْ.<verse eid="1PE 3:7" /></para>
  <para style="s">تِتْعَذْبُوا وإِنْتُومَا تَعْمْلُوا فِي الخِيرْ</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />وآخِرْ حَاجَة، كُونُوا الكُلْكُمْ بْرَايْ وَاحِدْ، حِسُّوا بِبْعَضْكُمْ وحِبُّوا بْعَضْكُمْ كِي الإِخْوَة وكُونُوا حْنَانْ ومِتْوَاضْعِينْ. <verse eid="1PE 3:8" /><verse number="9" style="v" sid="1PE 3:9" />مَا تْرَجْعُوشْ عَالشَّرْ بِالشَّرْ وعَالسَّبَّة بْسَبَّة. بِالعَكْسْ، بَارْكُوا، عْلَى خَاطِرْ هَاذَا الِّي دْعَاكُمْ لِيهْ اللَّهْ، وهَكَّا إِنْتُومَا زَادَا تِتْبَارْكُوا. <verse eid="1PE 3:9" /><verse number="10" style="v" sid="1PE 3:10" />والكْتُبْ المُقَدْسَة تْقُولْ:</para>
  <para style="b" vid="1PE 3:10" />
  <para style="q1" vid="1PE 3:10">«الِّي يْحِبْ يِتْمَتَّعْ بِالدِّنْيَا،</para>
  <para style="q2" vid="1PE 3:10">ويْشُوفْ أَيَّامْ سْعِيدَة،</para>
  <para style="q1" vid="1PE 3:10">يْصُونْ لْسَانُو عَالشَّرْ،</para>
  <para style="q2" vid="1PE 3:10">وفُمُّو عَالكِذْبْ،<verse eid="1PE 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1PE 3:11" />ويِبْعِدْ عَالشَّرْ ويَعْمِلْ الخِيرْ،</para>
  <para style="q2" vid="1PE 3:11">ويُطْلُبْ السَّلَامْ ويِسْعَالُو.<verse eid="1PE 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1PE 3:12" />عْلَى خَاطِرْ عِينِينْ اللَّهْ تْشُوفْ الصَّالْحِينْ</para>
  <para style="q2" vid="1PE 3:12">ووِذْنِيهْ تِسْمَعْ صْلَاتْهُمْ.</para>
  <para style="q1" vid="1PE 3:12">آمَا يْجِي ضِدْ الِّي يَعْمْلُوا الشَّرْ».<verse eid="1PE 3:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13" />مَالَا شْكُونْ يْنَجِّمْ يْضُرْكُمْ إِذَا كَانْ تَحَرْصُوا عْلَى فِعْلْ الخِيرْ؟ <verse eid="1PE 3:13" /><verse number="14" style="v" sid="1PE 3:14" />آمَا حَتَّى كَانْ تِتْعَذْبُوا عْلَى خَاطِرْ تَعْمْلُوا الصَّلَاحْ، صَحَّة لِيكُمْ! مَا تْخَافُوشْ مِلِّي يْحِبُّوا يْضُرُّوكُمْ ومَا تِتْقَلْقُوشْ، <verse eid="1PE 3:14" /><verse number="15" style="v" sid="1PE 3:15" />آمَا إِكْرْمُوا المَسِيحْ وخَلِّيوَهْ هُوَّ السَّيِّدْ عْلَى قْلُوبْكُمْ. وكُونُوا دِيمَا حَاضْرِينْ بَاشْ تْجَاوْبُوا أَيْ وَاحِدْ يِسْإِلْكُمْ عْلَى سْبَبْ الرْجَى الِّي عَنْدْكُمْ. <verse eid="1PE 3:15" /><verse number="16" style="v" sid="1PE 3:16" />وأَعْمْلُوا هَاذَا بِسْيَاسَة وإِحْتِرَامْ وخَلِّيوْ ضَمِيرْكُمْ دِيمَا طَاهِرْ، بَاشْ الِّي يَحْكِيوْ بِالخَايِبْ عْلَى سِيرِتْكُمْ الصَّالْحَة بِإِعْتِبَارْكُمْ مُؤْمْنِينْ بِالمَسِيحْ، يِحْشْمُوا عْلَى رْوَاحْهُمْ. <verse eid="1PE 3:16" /><verse number="17" style="v" sid="1PE 3:17" />إِذَا كَانْ اللَّهْ حَبِّلْكُمْ تِتْعَذْبُوا، خِيرِلْكُمْ تِتْعَذْبُوا وإِنْتُومَا تَعْمْلُوا فِي الخِيرْ، مِلِّي تِتْعَذْبُوا وإِنْتُومَا تَعْمْلُوا فِي الشَّرْ.<verse eid="1PE 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="1PE 3:18" />المَسِيحْ زَادَا</para>
  <para style="q2" vid="1PE 3:18">مَاتْ مَرَّة وَحْدَة بَاشْ يْحِلْ مُشْكِلْةْ الذْنُوبْ.</para>
  <para style="q1" vid="1PE 3:18">هُوَّ الصَّالَحْ، مَاتْ عْلَى خَاطِرْ المُذْنْبِينْ،</para>
  <para style="q2" vid="1PE 3:18">بَاشْ يْقَرِّبْنَا لِلَّهْ.</para>
  <para style="q1" vid="1PE 3:18">مَاتْ بْبَدْنُو،</para>
  <para style="q2" vid="1PE 3:18">آمَا قَامْ مِالمُوتْ بْرُوحُو.<verse eid="1PE 3:18" /></para>
  <para style="b" />
  <para style="m">
    <verse number="19" style="v" sid="1PE 3:19" />ومْشَى بْنَفْسْ الرُّوحْ، بَشِّرْ الأَرْوَاحْ المَرْبُوطَة، <verse eid="1PE 3:19" /><verse number="20" style="v" sid="1PE 3:20" />الِّي رَفْضُوا بَاشْ يْطِيعُوا اللَّهْ فِي أَيَّامَاتْ نُوحْ، وَقْتِلِّي كَانْ اللَّهْ صَابِرْ عْلِيهُمْ طُولْ المُدَّة الِّي كَانْ فِيهَا نُوحْ يَصْنَعْ فِي السْفِينَة، وفِي الطُّوفَانْ مَا نْجَاوْ فِيهَا كَانْ شْوَيَّة عْبَادْ ولِّي هُومَا ثْمَنْيَة مِالنَّاسْ أَكَهَوْ. <verse eid="1PE 3:20" /><verse number="21" style="v" sid="1PE 3:21" />والنْجَاةْ هَاذِي تُرْمُزْ لِلْمَعْمُودِيَّة، ومُشْ مَقْصُودْ بِيهَا غَسْلَانْ وْسَخْ البْدَنْ، آمَا هِيَّ عَهْدْ ضَمِيرْ طَاهِرْ قُدَّامْ اللَّهْ، الِّي يْنَجِّيكُمْ بِقْيَامِةْ يَسُوعْ المَسِيحْ، <verse eid="1PE 3:21" /><verse number="22" style="v" sid="1PE 3:22" />الِّي طْلَعْ لِلسْمَاء وهُوَّ تَوَّا قَاعِدْ عْلَى يْمِينْ اللَّهْ، وتِخْضَعْلُو المْلَايْكَة والقَادَة والحُكَّامْ الِّي فِي العَالِمْ الرُّوحِي.<verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="s">حْيَاةْ المُؤْمِنْ وأَخْلَاقُو</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />مَادَامُو المَسِيحْ تْعَذَّبْ فِي بَدْنُو، كُونُوا إِنْتُومَا زَادَا مُسْتْعَدِّينْ بَاشْ تِتْعَذْبُوا كِيفُو، عْلَى خَاطِرْ الِّي يِتْعَذَّبْ فِي بَدْنُو يْكُونْ قْطَعْ صِيلْتُو بِالذْنُوبْ، <verse eid="1PE 4:1" /><verse number="2" style="v" sid="1PE 4:2" />بَاشْ يْنَجِّمْ يْعِيشْ بْقِيِّةْ عُمْرُو، مُشْ حَسْبْ الشْهَاوِي الِّي تِتْحَكِّمْ فِي الإِنْسَانْ، آمَا حَسْبْ الِّي يْحِبُّو اللَّهْ. <verse eid="1PE 4:2" /><verse number="3" style="v" sid="1PE 4:3" />يِزِّيكُمْ الِّي ضَاعْ مِنْ عْمُرْكُمْ وإِنْتُومَا تِتْصَرْفُوا كِيمَا الشُّعُوبْ الِّي مَا يَمْنُوشْ بِاللَّهْ، عَايْشِينْ فِي النْجَاسَة والشْهَاوِي والسِّكْرَة وسَهْرِيَاتْ الفْسَادْ وعْبَادِةْ الصْنَبْ الِّي حَرَّمْهَا اللَّهْ. <verse eid="1PE 4:3" /><verse number="4" style="v" sid="1PE 4:4" />هُومَا تَوَّا مِسْتَغْرْبِينْ فِيكُمْ كِيفَاشْ مَا اتَّبْعُوشْ الفْسَادْ كِيفْهُمْ، وهَاذَاكَا عْلَاشْ يْشَوْهُولْكُمْ فِي سُمْعِتْكُمْ ، <verse eid="1PE 4:4" /><verse number="5" style="v" sid="1PE 4:5" />آمَا رَاهُمْ بِشْ يِتْحَاسْبُوا قُدَّامْ الِّي هُوَّ حَاضِرْ بَاشْ يُحْكُمْ عَالحَيِّينْ وعَالمُوتَى. <verse eid="1PE 4:5" /><verse number="6" style="v" sid="1PE 4:6" />هَاذَاكَا عْلَاشْ حَتَّى الِّي مَاتُوا زَادَا سَمْعُوا البْشَارَة، بَاشْ يْكُونُوا دِيمَا حَيِّينْ بِالرُّوحْ عَنْدْ اللَّهْ، رَغْمِلِّي تِحْكَمّْ عْلَى بْدَنَّاتْهُمْ بِالمُوتْ كِي بْقِيِّةْ النَّاسْ.<verse eid="1PE 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7" />نْهَايِةْ كُلْ شَيْ قُرْبِتْ، مَالَا كُونُوا فَايْقِينْ واتْحَكْمُوا فِي رْوَاحْكُمْ بَاشْ تْنَجْمُوا تْصَلِّيوْ. <verse eid="1PE 4:7" /><verse number="8" style="v" sid="1PE 4:8" />وقْبَلْ كُلْ شَيْ خَلِّيوْ مْحَبِّتْكُمْ لِبْعَضْكُمْ تْكُونْ قْوِيَّة، رَاهِي المْحَبَّة تُسْتُرْ بَرْشَة ذْنُوبْ. <verse eid="1PE 4:8" /><verse number="9" style="v" sid="1PE 4:9" />ضَيْفُوا بْعَضْكُمْ مِنْ غِيرْ مَا تِتْشَكَّاوْ، <verse eid="1PE 4:9" /><verse number="10" style="v" sid="1PE 4:10" />وخَلِّي كُلْ وَاحِدْ يِخْدِمْ الأُخْرِينْ بِالهِيبَة الرُّوحِيَّة الِّي خْذَاهَا مِنْ عَنْدْ اللَّهْ، بِإِعْتِبَارْكُمْ خُدَّامْ ثِيقَة وَكَّلْهُمْ اللَّهْ عَالهِيبَاتْ الرُّوحِيَّة المِتْنَوْعَة الِّي عْطَاهَالْهُمْ بْنِعْمْتُو. <verse eid="1PE 4:10" /><verse number="11" style="v" sid="1PE 4:11" />خَلِّي الِّي يِتْكَلِّمْ يِتْكَلِّمْ بِكْلَامْ اللَّهْ، ولِّي يِخْدِمْ خَلِّيهْ يِخْدِمْ بِالقُوَّة الِّي يَعْطِيهَالُو اللَّهْ، بَاشْ اللَّهْ يِتْمَجِّدْ فِي كُلْ شَيْ بْيَسُوعْ المَسِيحْ، لِيهْ المَجْدْ والسُّلْطَة لِلْأَبَدْ. آمِينْ.<verse eid="1PE 4:11" /></para>
  <para style="s">العْذَابْ بِسْبَبْ الإِيمَانْ بِالمَسِيحْ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />يَا حْبَابِي، مَا تِسْتَغْرْبُوشْ مِالمِحْنَة الصْعِيبَة الِّي جَاتْكُمْ بَاشْ تْجَرِّبْكُمْ، كَايِنْهَا حَاجَة غْرِيبَة صَايْرَة عْلِيكُمْ. <verse eid="1PE 4:12" /><verse number="13" style="v" sid="1PE 4:13" />آمَا بِالعَكْسْ، إِفْرْحُوا عْلَى خَاطِرْكُمْ تْشَارْكُوا فِي وْجَايَعْ المَسِيحْ، بَاشْ تْنَجْمُوا تِفْرْحُوا أَكْثِرْ وَقْتِلِّي يُظْهُرْ مَجْدُو. <verse eid="1PE 4:13" /><verse number="14" style="v" sid="1PE 4:14" />صَحَّة لِيكُمْ إِذَا كَانْ يْسِبُّوكُمْ عْلَى خَاطِرْ إِسْمْ المَسِيحْ، هَاذَا يْوَرِّي الِّي عَنْدْكُمْ رُوحْ المَجْدْ، الِّي هُوَّ رُوحْ اللَّهْ. <verse eid="1PE 4:14" /><verse number="15" style="v" sid="1PE 4:15" />مَا يِلْزِمْشْ يْكُونْ فِيكُمْ وَاحِدْ يِتْعَذَّبْ بِسْبَبْ قَتْلْ، وَلَّا سِرْقَة، وَلَّا جَرَايِمْ أُخْرَى، وَلَّا عْلَى خَاطْرُو يِدَّخِّلْ فِي أُمُورْ غِيرُو. <verse eid="1PE 4:15" /><verse number="16" style="v" sid="1PE 4:16" />آمَا إِذَا كَانْ وَاحِدْ يِتْعَذَّبْ عْلَى خَاطْرُو مَسِيحِي، مَا يِلْزْمُوشْ يِحْشِمْ، آمَا يْمَجِّدْ اللَّهْ عْلَى خَاطْرُو مِتْسَمِّى بِالإِسْمْ هَاذَاكَا. <verse eid="1PE 4:16" /><verse number="17" style="v" sid="1PE 4:17" />جَاء وَقْتْ الِّي بِشْ يِبْدَا فِيهْ الحْسَابْ، وبِشْ يِبْدَا بْشَعْبْ اللَّهْ. وإِذَا كَانْ الحُكْمْ بِشْ يِبْدَا بِينَا أَحْنَا، شَعْبُو، مَالَا كِيفَاشْ بِشْ تْكُونْ آخِرْةْ الِّي مَا يَمْنُوشْ بِبْشَارِةْ اللَّهْ؟ <verse eid="1PE 4:17" /><verse number="18" style="v" sid="1PE 4:18" />والكْتُبْ المُقَدْسَة تْقُولْ:</para>
  <para style="b" vid="1PE 4:18" />
  <para style="q1" vid="1PE 4:18">«إِذَا كَانْ الإِنْسَانْ الصَّالَحْ يِنْجَى بِصْعُوبَة،</para>
  <para style="q2" vid="1PE 4:18">شْنُوَّة بِشْ يْصِيرْ لِلْفَاسِدْ والمُذْنِبْ؟»<verse eid="1PE 4:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="1PE 4:19" />مَالَا الِّي حَبِّلْهُمْ اللَّهْ يِتْعَذْبُوا، خَلِّيهُمْ يْحُطُّوا رْوَاحْهُمْ بِينْ يْدِينْ الخَالِقْ الأَمِينْ، ويَعْمْلُوا الخِيرْ.<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="s">تَوْصِيَاتْ لِلشْيُوخْ والشَّبَابْ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />وهَاذِي وْصِيْتِي لِشْيُوخْ الكْنِيسَة الِّي بِينَاتْكُمْ، بِإِعْتِبَارِي شِيخْ كِيفْهُمْ، شَاهِدْ عْلَى وْجَايَعْ المَسِيحْ، وشْرِيكْ فِي المَجْدْ الِّي بِشْ يُظْهُرْ، <verse eid="1PE 5:1" /><verse number="2" style="v" sid="1PE 5:2" />تِلْهَاوْ بِغْنَمْ اللَّهْ الِّي مْعَاكُمْ، ورُدُّوا بَالْكُمْ عْلِيهُمْ، آمَا بِرْضَاكُمْ مُشْ بِالسِّيفْ عْلِيكُمْ، كِيمَا يْحِبْ اللَّهْ، ومُشْ طْمَعْ فِي الفْلُوسْ، آمَا مْحَبَّة فِي خِدْمِةْ اللَّهْ. <verse eid="1PE 5:2" /><verse number="3" style="v" sid="1PE 5:3" />ومَا تِتْحَكْمُوشْ فِي النَّاسْ الِّي حَطْهُمْ اللَّهْ أَمَانَة بِينْ يْدِيكُمْ، آمَا كُونُوا قُدْوَة لِيهُمْ. <verse eid="1PE 5:3" /><verse number="4" style="v" sid="1PE 5:4" />ووَقْتِلِّي يُظْهُرْ رَئِيسْ الرُّعَاةْ، بِشْ تَاخْذُوا تَاجْ المَجْدْ الِّي مَا يِفْنَاشْ.<verse eid="1PE 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5" />ونْوَصِّي الشَّبَابْ زَادَا، طِيعُوا شْيُوخْ الكْنِيسَة، وكُونُوا مِتْوَاضْعِينْ مْعَ بْعَضْكُمْ، عْلَى خَاطِرْ الكْتُبْ المُقَدْسَة تْقُولْ:</para>
  <para style="b" vid="1PE 5:5" />
  <para style="q1" vid="1PE 5:5">«اللَّهْ يَاقِفْ ضِدْ المِتْكَبْرِينْ،</para>
  <para style="q2" vid="1PE 5:5">آمَا يَعْطِي نِعْمَة لِلْمِتْوَاضْعِينْ».<verse eid="1PE 5:5" /></para>
  <para style="b" />
  <para style="m">
    <verse number="6" style="v" sid="1PE 5:6" />مَالَا، اتْوَاضْعُوا تَحْتْ يِدْ اللَّهْ القْوِيَّة وهُوَّ يَرْفَعْكُمْ فِي الوَقْتْ المُنَاسِبْ. <verse eid="1PE 5:6" /><verse number="7" style="v" sid="1PE 5:7" />وحُطُّوا هْمُومْكُمْ الكُلْ عْلِيهْ، عْلَى خَاطْرُو يِتْلْهَى بِيكُمْ.<verse eid="1PE 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8" />رُدُّوا بَالْكُمْ وفِيقُوا، رَاهُو عْدُوكُمْ إِبْلِيسْ، قَاعِدْ يْدُورْ ويِزْئِرْ كِيفْ الصِّيدْ ويْلَوِّجْ عْلَى شْكُونْ يِبْلْعُو. <verse eid="1PE 5:8" /><verse number="9" style="v" sid="1PE 5:9" />قَاوْمُوهْ وإِثْبْتُوا فِي إِيمَانْكُمْ، وأَعْرْفُوا الِّي خْوَاتْكُمْ المُؤْمْنِينْ فِي العَالِمْ الكُلْ يْعَانِيوْ مِنْ نَفْسْ الوْجَايَعْ. <verse eid="1PE 5:9" /><verse number="10" style="v" sid="1PE 5:10" />وبَعْدْمَا تْعَذَّبْتُوا مُدَّة قْصِيرَة، اللَّهْ، الِّي يَعْطِي كُلْ نِعْمَة، ولِّي جَابْكُمْ لِلْمَسِيحْ بَاشْ تْشَارْكُوهْ فِي مَجْدُو الِّي مَا يُوفَاشْ، هُوَّ بِشْ يْثَبِّتْكُمْ ويْقَوِّيكُمْ ويِبْنِيكُمْ. <verse eid="1PE 5:10" /><verse number="11" style="v" sid="1PE 5:11" />لِيهْ المَجْدْ والسُّلْطَة لِلْأَبَدْ. آمِينْ.<verse eid="1PE 5:11" /></para>
  <para style="s">تَحِيَّاتْ فِي الخَاتْمَة</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />سِلْوَانُسْ الِّي بِالنِّسْبَة لِيَّا خُويَا الأَمِينْ، هُوَّ الِّي كْتِبْلِي رِسَالْتِي القْصِيرَة هَاذِي، الِّي حَبِّيتْ نْشَجَّعْكُمْ بِيهَا ونِشْهْدِلْكُمْ الِّي النِّعْمَة الِّي تِتْمَتْعُوا بِيهَا، هِيَّ نِعْمِةْ اللَّهْ الحَقِيقِيَّة، مَالَا إِثْبْتُوا فِيهَا. <verse eid="1PE 5:12" /><verse number="13" style="v" sid="1PE 5:13" />تْسَلِّمْ عْلِيكُمْ الكْنِيسَة الِّي فِي بَابِلْ ولِّي إِخْتَارْهَا اللَّهْ كِيفْكُمْ. ويْسَلِّمْ عْلِيكُمْ وِلْدِي مُرْقُسْ زَادَا. <verse eid="1PE 5:13" /><verse number="14" style="v" sid="1PE 5:14" />سَلْمُوا عْلَى بْعَضْكُمْ بْبُوسِةْ المْحَبَّة الطَّاهْرَة. سَلَامْ لِيكُمْ إِنْتُومَا الكُلْ الِّي فِي المَسِيحْ.<verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>