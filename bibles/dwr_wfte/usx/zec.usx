<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ZEC" style="id">- Dawuro Full Bible Ethiopic Version</book>
  <para style="h">ዛካራሳ</para>
  <para style="toc1">ዛካራሳ ትምቢትያ</para>
  <para style="toc2">ዛካራሳ</para>
  <para style="toc3">ዛካ.</para>
  <para style="mt1">ዛካራሳ ትምቢትያ</para>
  <para style="imt">ገሉዋ</para>
  <para style="ip">ትምቢትያ ኦድያ ዛካራሳ ማጻፋይ ላኡዋዉ ሻከቴ።</para>
  <para style="ipi">1. ሸምፑዋ 1ፐ ቢደ 8 ጋካናዉ ደእያ ሳአይ ክርስቶሳ የለታፐ ካሰ እቼሹ ጼታነ ላታሙ ላይፐ ዪደ እቼሹ ጼታነ ታማነ እቼሹ ላይ ጋካናዉ ደእያ ላይቱዋ ግዶን፥ ዱማ ዱማ ዎደቱዋን ትምቢትያ ኦድያ ዛካራስ ኦዴዳ ትምቢትያ ቃላቱዋ ኦይቄዳ ክፍልያ። ሄዋ ጉሳይ አሳይ ኦሞዱዋፐ ስሜዳዋፐ ጉይያና ጉሳ። ሀ ትምቢትያ ኦዴዳ ቃላቱ ሳፃ ማላን ሺቄዳዋንታ ግድሽን፥ የሩሳላመ ኦራጻናዋ፥ ጌሻ ጎልያ ስሚደ ግምበታናዋ፥ ጾሳ አሳይ ጌያናዋነ ስንፐ ያና ማስያ ላይባ ኦድያዋንታ።</para>
  <para style="ipi">2. ሸምፑዋ 9ፐ ቢደ 14 ጋካናዉ ደእያ ክፍሊ ጉ ታክሺን ኦደቴዳ ትምቢትያ ቃላቱዋ ኦይቄዳዋ። ሀ ትምቢትያ ኦዴዳ ቃላቱ ስንፐ ያና ማስያባነ ዉርሰ ፕርዳባ ኦዲኖ።</para>
  <para style="iot">ሸምፓቱዋ ኡባቶ እመቴዳ ቃን ቆፋቱዋ</para>
  <para style="io1">1. ገሉዋ 1:1-6</para>
  <para style="io1">2. ቃማ ቤቴዳ ሆስፑን ሳጻቱዋ 1:7—6:8</para>
  <para style="io1">3. ቄስያ ኡባ ካፑዋ ኢያሱ ቦላ ጫነቴዳ ሀሳይሱዋ ካላቻ 6:9-15</para>
  <para style="io1">4. ልከ ግደና ጾማነ ስንዉ እመቴዳ ህዶታ 7:1—8:23</para>
  <para style="io1">5. ማስህያ ዩሳነ ጾሳ ካዉተይ በስያዋዳን ኤረቱሳ 9:1—14:21</para>
  <chapter number="1" style="c" sid="ZEC 1"/>
  <para style="s1">ገሉዋ</para>
  <para style="r">(<ref loc="ZEC 1:1-6">1:1-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 1:1"/>ዳርዮሰ ካተቴዳ ላኤን ላይን፥ ሆስፑን አግናን መና ጎዳ ቃላይ እዶ ናኣ በረክያ ናኣ ትምቢትያ ኦድያ ዛካራሳኮ ዬዳ።<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="EZR 4:24-5:1">እዝራ 4:24—5:1</ref>፤ <ref loc="EZR 6:14">6:14</ref></char></note><verse eid="ZEC 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ZEC 1:2"/>“መና ጎዳይ ህንተ ማይዛ አዎቱዋ ቦላን ሎይ ሀንቀቴዳ። <verse eid="ZEC 1:2"/><verse number="3" style="v" sid="ZEC 1:3"/>ሽን ሀእ አሳዉ ሀዋዳን ያጋደ ኦዳ፤ ‘ታኮ ስምተ፤ ቃይ ታንካ ህንተኮ ስማና።’ ታን ኡባፐ ዎልቃማ መና ጎዳይ ሀዋ ኦዳይ። <verse eid="ZEC 1:3"/><verse number="4" style="v" sid="ZEC 1:4"/>ካሰ ትምቢትያ ኦድያዋንቱ፥ ‘ኡባፐ ዎልቃማ መና ጎዳይ፥ ህንተ ኢታ ኦግያፐነ ኢታ ኦሱዋፐ ስምተ’ ያጌ” ያጊደ ኦድና ስሰናን እጼድኖነ ታናካ ስሰናን እጼዳ ህንተ ማይዛ አዎቱዋዳን ሀኖፕተ። ታን መና ጎዳይ ሀዋ ኦዳይ። <verse eid="ZEC 1:4"/><verse number="5" style="v" sid="ZEC 1:5"/>ህንተ ማይዛ አዎቱ ሀእ ሀቃን ደኢኖ? ሄ ትምቢትያ ኦዴዳዋንቱ መናዉ ፓጻ ደኢኖ? <verse eid="ZEC 1:5"/><verse number="6" style="v" sid="ZEC 1:6"/>ግዶ ሽን፥ ትምቢትያ ኦድያ ታ ቆማቱ ባጋና ታን ኦዴዳ ቃላቱነ ህገቱ ኡባይ ህንተ ማይዛ አዎቱዋ ቦላን ጋክበይክኖ? ያትና፥ ኡንቱንቱካ ካዮቲደ፥ ኡባፐ ዎልቃማ መና ጎዳይ ኑ ኦግያዳንነ ኑ ኦሱዋዳን ኑዉ እማና ጌዳዋዳን፥ ባረ ጌዳዋ ኦዳ ያጌድኖ ያጋ ያጌዳ።<verse eid="ZEC 1:6"/></para>
  <para style="s1">ቃማ በኤቴዳ ሆስፑን ሳጻቱዋ</para>
  <para style="r">(<ref loc="ZEC 1:7-6:8">1:7—6:8</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 1:7"/>ዳርዮሰ ካተቴዳ ላኤን ላይን፥ ሻባጻ ግያ ታማነ እተን አግናን፥ ላታማነ ኦይደን ጋላስ መና ጎዳይ ቃላይ እዶ ናኣ በረክያ ናኣ ትምቢትያ ኦድያ ዛካራሳኮ ዬዳ። <verse eid="ZEC 1:7"/><verse number="8" style="v" sid="ZEC 1:8"/>ታን ቃማ ሳጻን ዞኦ ፓራ ቶጌዳ እት ብታንያ በኣድ፤ እካ ዛንጋራን ደእያ ባርሴነትያ ግያ ምቱዋ ጋርሳን ኤቄዳ፤ ቃይ አፐ ጉየ ባጋና ዳማ፥ ዞኦነ ቦ ፓራቱ ደኢኖ።<note caller="-" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="REV 6:2-8">ሳፃ 6:2-8</ref></char></note> <verse eid="ZEC 1:8"/><verse number="9" style="v" sid="ZEC 1:9"/>ያትና፥ ታን፥ ታ ጎዳዉ፥ ሀዋንቱ አዬ? ያጋድ።</para>
  <para style="p" vid="ZEC 1:9">ታናና ሃሳይያ ኪታንቻይ ዛሪደ ታና፥ “ሀዋንቱ አየንቶ ታን ኔና በሳና ያጌዳ።<verse eid="ZEC 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 1:10"/>“ያትና፥ ባርሴነትያ ጋርሳን ኤቄዳ ብታኒ፥ ሀዋንቱ ሳኣ ኡባ ዩይ ዩዪደ ጾሞሳና ማላ፥ መና ጎዳይ ኪቴዳዋንታ ያጌዳ።<verse eid="ZEC 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ZEC 1:11"/>“ኡንቱንቱ ባርሴነትያ ጋርሳን ኤቄዳ መና ጎዳ ኪታንቻዉ ሀዋዳን ያጌድኖ፤ ‘ኑን ሳኣ ኡባ ዩይ ዩዪደ ጾሞሲደ፤ ቢታይ ሳአይ ዎፑ ጊደ፥ ሳሮ ደኤ’ ያጌድኖ።<verse eid="ZEC 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ZEC 1:12"/>“ሄዋፐ ጉይያን፥ መና ጎዳ ኪታንቻይ ሀዋዳን ያጌዳ፤ ‘አቤት ኡባፐ ዎልቃማ መና ጎዳዉ፥ ኔን ሀንቀቶደፐ ላፑን ታሙ ላይ ግዴዳ ሀ የሩሳላመነ ይሁዳ ካታማቱዋ ማረናን አዉደ ጋካናዉ ጋምአይ?’ ያጌዳ።” <verse eid="ZEC 1:12"/><verse number="13" style="v" sid="ZEC 1:13"/>መና ጎዳይ ታናና ሃሳይያ ኪታንቻዉ ሎኦነ ምንያ ቃላን ዛሩዋ እሜዳ።<verse eid="ZEC 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ZEC 1:14"/>ሄዋ ድራዉ፥ ታናና ሃሳይያ ኪታንቻይ ታና፥ “ሀ ቃላ አዋያ፤ ኡባፐ ዎልቃማ መና ጎዳይ ሀዋዳን ያጌ፤ ‘ታን የሩሳላመዉነ ጽዮንዉ ዳሮ ምሸታይ። <verse eid="ZEC 1:14"/><verse number="15" style="v" sid="ZEC 1:15"/>ኑን ሳሮ ደኤቶ ግያ ካዉተቱዋ ቦላ ታን ዳሮ ሀንቀታድ፥ ታን ታ አሳ ቦላ ጉ ሀንቀታድ ሽን ኡንቱንቱ ታ አሳ ቦላ ዳሮ ቱጋ ጋድኖ። <verse eid="ZEC 1:15"/><verse number="16" style="v" sid="ZEC 1:16"/>ሄዋ ድራዉ፥ ታን መና ጎዳይ ሀዋ ኦዳይ፤ ታን የሩሳላመ ማሮታን ስማድ። ታ ጌሻ ጎሊ ያን ኬጸታና፤ የሩሳላመ ካታማይካ ዎዶሩዋን ልከታና። ታን ኡባፐ ዎልቃማ መና ጎዳይ ሀዋ ኦዳይ’ ያጌ” ያጋደ አዋያ።<verse eid="ZEC 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ZEC 1:17"/>“ዛረደካ ሀዋዳን ያጋደ አዋያ፤ ‘ኡባፐ ዎልቃማ መና ጎዳይ ታ ካታማቱዋ ዱረተይ ኩም ጎጋና ቃይ ታን መና ጎዳይ ጽዮነ ዛረደ ምንና፤ የሩሳላመካ ዛረደ ዶራና ያጌ’ ያጋደ አዋያ” ያጌዳ።<verse eid="ZEC 1:17"/></para>
  <para style="s1">ዛካራስ ሳጻን ኦይዱ ካጨቱዋ በኤዳ</para>
  <para style="p">
    <verse number="18" style="v" sid="ZEC 1:18"/>ቃይካ ታን ሳጻን ኦይዱ ካጨቱዋ በኣድ። <verse eid="ZEC 1:18"/><verse number="19" style="v" sid="ZEC 1:19"/>ታናና ሃሳይያ ኪታንቻ፥ “ሀዋንቱ አዬ?” ያጋደ ኦቻድ።</para>
  <para style="p" vid="ZEC 1:19">እካ ታዉ ዛሪደ፥ “ሀ ካጨቱ ይሁዳ፥ እስራኤላነ የሩሳላመ ላሌዳ ካዉተቱዋ” ካዉተቱዋ ሌምሳቱዋ ያጌዳ።<verse eid="ZEC 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ZEC 1:20"/>ሄዋፐ ጉይያን፥ መና ጎዳይ ታና ብራታ ቆጽያ ኦይዱ ሂላቱዋ በሴዳ። <verse eid="ZEC 1:20"/><verse number="21" style="v" sid="ZEC 1:21"/>ታን፥ “ሀዋንቱ አያ ኦናዉ ዬድኖ?” ያጋደ ኦቻድ።</para>
  <para style="p" vid="ZEC 1:21">እ ዛሪደ፥ “ሀዋንቱ ኦንነ ቁ ጊደ ጼለናዳን፥ ይሁዳ ቢታ ላሌዳ ካጨቱዋ ያሽሳናዉ ዬድኖ፤ ቃይ ይሁዳ ቢታ ላላናዉ ባረንቱ ካጭያ ደንዳ አይሁዳ ግደና ካዉተቱዋ ካጭያ ቆጺደ፥ ሳኣን የጋናዉ ዬድኖ” ያጌዳ።<verse eid="ZEC 1:21"/></para>
  <chapter eid="ZEC 1"/>
  <chapter number="2" style="c" sid="ZEC 2"/>
  <para style="s1">ዛካራስ ሳጻን ልክያ ዎዶሩዋ በኤዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 2:1"/>ቃይካ ሀራ ሳጻን ባረ ኩሽያን ልክያ ዎዶሩዋ ኦይቄዳ እት ብታንያ በኣድ። <verse eid="ZEC 2:1"/><verse number="2" style="v" sid="ZEC 2:2"/>ታን፥ “ኔን ሀቃ ባይ?” ያጋደ አ ኦቻድ።</para>
  <para style="p" vid="ZEC 2:2">እ፥ “ታን የሩሳላመ ጎምፓይነ ጌሳይ አይ ኬሸንቶ በአናዉ፥ ልካናዉ ባይ” ያጌዳ።<verse eid="ZEC 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEC 2:3"/>ሄዋፐ ጉይያን፥ ታናና ሃሳይያ ኪታንቻይ ከሲደ ቤዳ፤ ቃይ አናና ጋከታናዉ ሀራ ኪታንቻይካ ዬዳ። <verse eid="ZEC 2:3"/><verse number="4" style="v" sid="ZEC 2:4"/>አ ሀዋዳን ያጌዳ፤ “ዎጻ፤ ባደ ሄ ያላጋ ብታንያ፥ መና ጎዳይ ሀዋዳን ያጌ፤ ‘አሳነ መህያ ዳሮተፐ ደንዴዳዋን የሩሳላመ ካታማ ዩሹ ድርሳ ግምቢ ባይና ካታማዳን ደአና። <verse eid="ZEC 2:4"/><verse number="5" style="v" sid="ZEC 2:5"/>ታን አ ዩሹዋን ታማ ድርሳ ግዳና፤ ታን አ ግዶን ቦንቹዋ ግዳና ያጌ’ ያጋ” ያጌዳ መና ጎዳይ።<verse eid="ZEC 2:5"/></para>
  <para style="s1">መና ጎዳይ ባረ አሳ ባረንቱ ቢታ ስማናዳን ጼሴዳ</para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 2:6"/>መና ጎዳይ ባረ አሳ ሀዋዳን ያጌ፤ “ታን ህንተና ኡባ ሳን ላላድ። ሽን ሀእ ሁጲሳ ባጋ ጋድያፐ ባቃቲደ ክችተ!” ያጌ መና ጎዳይ።<verse eid="ZEC 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 2:7"/>ቃይካ ጾሳይ፥ “ኔኖ፥ ጽዮኔ፥ ባብሎነ ማጫ ናናቱዋና ደእያነ ከሳ አካደ ሃያ!” ያጌ። <verse eid="ZEC 2:7"/><verse number="8" style="v" sid="ZEC 2:8"/>አያዉ ጎፐ፥ ኡባፐ ዎልቃማ መና ጎዳይ ባረ ቦንቹዋ ቆንጭሳና ማላ፥ ባረ አሳ ቦንቄዳ ካዉተቱዋኮ ታና ኪቲደ፥ ሀዋዳን ያጌዳ፤ “ህንተና ቦችያዌ ታ አይፍያ ቡሉዋ ቦቼ። <verse eid="ZEC 2:8"/><verse number="9" style="v" sid="ZEC 2:9"/>በእተ፥ ታን ታ ኩሽያ ኡንቱንቱ ቦላን ደንና፤ ቃይ ኡንቱንቱካ ካሰ ባረንቱ ቆማቱዋን ኦሞደታና” ያጌዳ።</para>
  <para style="p" vid="ZEC 2:9">ሄ ዎደ ህንተ ኡባፐ ዎልቃማ መና ጎዳይ ታና ኪቴዳዋ ኤራና።<verse eid="ZEC 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 2:10"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ጽዮነ አሳዉ፥ የጽተነ ናሸትተ! አያዉ ጎፐ፥ ታን ያደ ህንተ ግዶን ደአና” ያጌ።<verse eid="ZEC 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ZEC 2:11"/>ሄ ዎደ ዳሮ አይሁዳ ግደና ካዉተቱ መና ጎዳና ጋከቲደ፥ አ አሳ ግዳና፤ እካ ኡንቱንቱ ግዶን ደአና። ቃይ ህንተካ ኡባፐ ዎልቃማ መና ጎዳይ ታና ህንተኮ ኪቴዳዋ ሄ ዎደ ኤራና። <verse eid="ZEC 2:11"/><verse number="12" style="v" sid="ZEC 2:12"/>ጌሻ ቢታን መና ጎዳይ ይሁዳ ባረና ጋኬዳ ግሹዋ ኦደ ላታና፤ የሩሳላመካ እ ዛረደ ዶራና።<verse eid="ZEC 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ZEC 2:13"/>መና ጎዳይ ባረ ደእያ ጌሻ ሳኣን ደንዴዳ፤ ሄዋ ድራዉ፥ አሹዋ ማዬዳ ኡባይ አ ስንን ጮኡ ጎ!<verse eid="ZEC 2:13"/></para>
  <chapter eid="ZEC 2"/>
  <chapter number="3" style="c" sid="ZEC 3"/>
  <para style="s1">ዛካራስ ሳጻን ቄስያ ኡባቱዋ ካፑዋ በኤዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 3:1"/>ሄዋፐ ጉይያን፥ ቄስያ ኡባቱ ካፑ ኢያሱ መና ጎዳ ኪታንቻ ስንን ኤቄዳዋነ ሴጻናይካ ኢያሳ ሞታናዉ አፐ ኡሸቻ ባጋና ኤቄዳዋ መና ጎዳይ ሳጻን ታና በሴዳ።<note caller="-" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="EZR 5:2">እዝራ 5:2</ref>፤ <ref loc="REV 12:10">ሳፃ 12:10</ref></char></note> <verse eid="ZEC 3:1"/><verse number="2" style="v" sid="ZEC 3:2"/>መና ጎዳይ ሴጻና፥ “ሴጻናዉ፥ መና ጎዳይ ኔና ሴሮ፤ የሩሳላመ ዶሬዳ መና ጎዳይ ኔና ሴሮ! ሀ ብታኒ ታማፐ ከሲደ አቴዳ ጺፋ ማላ ግደኔ?” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="JDG 9">ዳና. 9</ref></char></note><verse eid="ZEC 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEC 3:3"/>ኢያሱ ኪታንቻ ስንን ኤቄዳ ዎደ፥ ቅታ ማዩዋ ማይ ኡቴዳ። <verse eid="ZEC 3:3"/><verse number="4" style="v" sid="ZEC 3:4"/>ኪታንቻይ ባረ ስንን ኤቄዳዋንታ፥ “አፐ ሀ ቅታ ማዩዋ ቃርተ” ያጌዳ። ቃይ እ ኢያሳ፥ “በአ፥ ታን ነ ባይዙዋ ኔፐ ድጋድ፤ ቦንቹዋ ማዩዋካ ኔና ማይዛና” ያጌዳ። <verse eid="ZEC 3:4"/><verse number="5" style="v" sid="ZEC 3:5"/>ቃይካ ታን፥ “ጌሻ ሻሽያ አ ሁጲያን ጻጽተ” ያጋድ። ኡንቱንቱካ እ አዛዜዳዋዳን ኦድኖ፤ ማዩዋካ አ ማይዜድኖ። መና ጎዳ ኪታንቻይ ሄ ዎደ አ ምይያን ኤቄዳ።<verse eid="ZEC 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 3:6"/>ሄዋፐ ጉይያን፥ መና ጎዳ ኪታንቻይ ኢያሱዉ ሀዋዳን ያጊደ ሽሴዳ፤ <verse eid="ZEC 3:6"/><verse number="7" style="v" sid="ZEC 3:7"/>“ኡባፐ ዎልቃማ መና ጎዳይ ሀዋዳን ያጌ፤ ‘ኔን ታ ኦግያን ሀመቶፐነ ታ አዛዙዋ ናጎፐ፥ ኔን ታ ጌሻ ጎልያ አይሳና፤ ታ ዳባባንካ አዎታና። ቃይ ሀዋን ኤቄዳዋንቱና እትፐ ኔን ገልያ ማታ ታን ነዉ እማና።<verse eid="ZEC 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 3:8"/>“ ‘ነኖ ቄስያ ኡባቱዋ ካፑዋ ኢያሱ፥ ሀዋ ስሳ! ስንና ያና ኬካባዉ ማላታ ግድያ ኔናና ኦያዋንቱካ ሀዋ ስስኖ! ታን ታሽያ ጌተትያ ታ ቆማ አሀና።<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="JER 23:5">ኤር. 23:5</ref>፤ <ref loc="JER 33:15">33:15</ref>፤ <ref loc="ZEC 6:12">ዛካ. 6:12</ref></char></note> <verse eid="ZEC 3:8"/><verse number="9" style="v" sid="ZEC 3:9"/>በአ፥ ታን ኢያሱ ስንን ሹቻ ዎና፤ ሄ ሹቻ ቦላ ላፑን አይፈቱ ደኢኖ፤ ታን አ ቦላን ዎጫደ ጹፍያ ጻፋና። ታን ኡባፐ ዎልቃማ መና ጎዳይ ሀዋ ኦዳይ። ሄ ጋድያ ናጋራካ ታን እት ጋላስ ድጋና’ ያጌ።<verse eid="ZEC 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 3:10"/>“ኡባፐ ዎልቃማ መና ጎዳይ ሀዋዳን ያጌ፤ ‘ሄ ጋላስ ህንተ ኡባይካ ህንተ ዎይንያ ቱራነ ህንተ ባላስያ ም ጋርሳን ኡቲደ፥ ህንተ ሾሮቱዋ ሾባና’ ያጌ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="MIC 4:4">ሚክ. 4:4</ref></char></note><verse eid="ZEC 3:10"/></para>
  <chapter eid="ZEC 3"/>
  <chapter number="4" style="c" sid="ZEC 4"/>
  <para style="s1">ዛካራስ ሳጻን ጾምፕያ ዎያ ባላነ ዎጋራ ም በኤዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 4:1"/>ሄዋፐ ጉይያን፥ ታናና ሃሳዬዳ ኪታንቻይ ስም ዪደ፥ ገምእሼዳ አሳ ቤጎያዋዳን፥ ታና ቤጎዳ። <verse eid="ZEC 4:1"/><verse number="2" style="v" sid="ZEC 4:2"/>እ ታና፥ “ኔን በእያዌ አዬ?” ያጌዳ።</para>
  <para style="p" vid="ZEC 4:2">ታን፥ “ታን ዎርቃ ጻላላፐ ኦሰቴዳ ጾምፕያ ዎያ ባላ በአይ፤ አ ጼራን ዛይትያ ጻሩ ደኤ፤ ቃይ አ ቦላን ላፑን ጾምፐቱ ደኢኖ፤ ሄ ላፑን ጾምፐቶካ ላፑን ላፑን ሉኮቱ ደኢኖ። <verse eid="ZEC 4:2"/><verse number="3" style="v" sid="ZEC 4:3"/>ሄ ጾምፕያ ዎያ ባላ ማታን ላኡ ዎጋራቱ ደኢኖ፤ ኡንቱንቱ ዛይትያ ጻሩዋፐ ኡሸቻ ባጋናነ ሀድርሳ ባጋና ደኢኖ” ያጋድ።<note caller="-" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="REV 11:4">ሳፃ 11:4</ref></char></note><verse eid="ZEC 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ZEC 4:4"/>ታን ታናና ሃሳይያ ኪታንቻ ቃይካ፥ “ታ ጎዳዉ፥ ሀዋንቱ አዬ?” ያጋደ ኦቻድ።<verse eid="ZEC 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ZEC 4:5"/>ታናና ሃሳይያ ኪታንቻይ ዛሪደ፥ “ሀዋንቱ አየንቶ ኤርኪ?” ያጌዳ።</para>
  <para style="p" vid="ZEC 4:5">ታን፥ “ታ ጎዳዉ፥ ታን ኤርከ” ያጋድ።<verse eid="ZEC 4:5"/></para>
  <para style="s1">ጾሳይ ዛሩባቤላዉ ኦዴዳ ቃላ</para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 4:6"/>ቃይካ እ፥ “ዛሩባቤላዉ መና ጎዳይ ኦዴዳ ቃላይ ሀዋ፤ ‘ታ አያናናፐ አትና፥ ዎልቃን ዎይ ምኖተን ግደና። ታን ኡባፐ ዎልቃማ መና ጎዳይ ሀዋ ኦዳይ።<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="EZR 5:2">እዝራ 5:2</ref></char></note> <verse eid="ZEC 4:6"/><verse number="7" style="v" sid="ZEC 4:7"/>ዎልቃማ ደርያዉ፥ ኔን አዬ? ኔን ዛሩባቤላ ስንን ልጲ ጌዳ ደምባ ግዳና። ቃይ ዛሩባቤል ጌሻ ጎልያ ኬጽ ፖሊደ፥ ዉርሰ ሹቻ ፑደ ከስያ ዎደ አሳይ፥ “ሀሹ! ሀሹ ፖለቴ!” ያጋና’ ያጌዳ።”<verse eid="ZEC 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 4:8"/>ቃይካ መና ጎዳ ቃላይ ዛካራሳኮ ዬዳ። <verse eid="ZEC 4:8"/><verse number="9" style="v" sid="ZEC 4:9"/>ዛካራስ ሀዋዳን ያጌዳ፤ “ሀ ጌሻ ጎልያ ባሱዋ ዛሩባቤላ ኩሸቱ ባሴድኖ፤ ቃይ ፖሉዋካ አ ኩሸቱ ኬጺደ ፖላና። ሄዋፐ ጉይያን፥ ኡባፐ ዎልቃማ መና ጎዳይ ታና ህንተኮ ኪቴዳዋ ህንተ ኤራና። <verse eid="ZEC 4:9"/><verse number="10" style="v" sid="ZEC 4:10"/>ሀ ጉ ዶመ ካያ ኦናነ ግዶፐ ዛሩባቤላ ኩሽያን ቱምቢያ በኤዳ ዎደ ናሸታና፤ ሀዋንቱ ላፑን ጾምፐቱ ቢታ ኡባ ዩዪደ ጼልያ መና ጎዳ አይፈቱዋ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="REV 5:6">ሳፃ 5:6</ref></char></note><verse eid="ZEC 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ZEC 4:11"/>ታን ኪታንቻ ዛራደ፥ “ሀ ጾምፕያ ዎያ ባላፐ ኡሸቻ ባጋናነ ሀድርሳ ባጋና ደእያ ሀ ላኡ ዎጋራቱ አዬ?” ያጋደ ኦቻድ።<note caller="-" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="REV 11:4">ሳፃ 11:4</ref></char></note> <verse eid="ZEC 4:11"/><verse number="12" style="v" sid="ZEC 4:12"/>ታን ላኤንዋካ፥ “ሀ ዛይቲ ኡንቱንቱፐ ጎግያ ላኡ ዎርቃ ቦምባቱዋ ማታን ደእያ ላኡ ዎጋራ ታሸቱካ አዬ?” ያጋደ ኦቻድ።<verse eid="ZEC 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ZEC 4:13"/>እካ ዛሪደ፥ “ሀዋንቱ አየንቶ ኔን ኤርኪ?” ያጌዳ።</para>
  <para style="p" vid="ZEC 4:13">ታንካ፥ “ታ ጎዳዉ፥ ታን ኤርከ” ያጋድ።<verse eid="ZEC 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ZEC 4:14"/>እ ዛሪደ፥ “ሀዋንቱ ሳኣ ኡባ ጎዳዉ ኦያ፥ ላኡ ኦከቴዳ አሳቱዋ” ያጌዳ።<verse eid="ZEC 4:14"/></para>
  <chapter eid="ZEC 4"/>
  <chapter number="5" style="c" sid="ZEC 5"/>
  <para style="s1">ዛካራስ ሳጻን ጻጸት ኡቴዳ ማጻፋይ ፓልያዋ በኤዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 5:1"/>ቃይካ ታን ቁ ጋደ ጼልያ ዎደ፥ እት ጻጸት ኡቴዳ ማጻፋይ ቦላና ፓልያዋ በኣድ።<verse eid="ZEC 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ZEC 5:2"/>ኪታንቻይ ታና፥ “ሀ ኔን በእያዌ አዬ?” ያጊደ ኦቼዳ።</para>
  <para style="p" vid="ZEC 5:2">ታን፥ “ታን እት ጻጸት ኡቴዳ ፓልያ ማጻፋ በአይ፤ አዉ ጌሳይ ላታሙ ዋ፤ ጎምፓይካ ታሙ ዋ” ያጋድ።<verse eid="ZEC 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEC 5:3"/>እ ታና ሀዋዳን ያጌዳ፤ “ሀ ጻ ማጻፋ ግዶን ደእያዌ ቢታ ኡባ ቦላን ይያ ሸቃ። ሄ ማጻፋን እት ባጋና፥ ‘ዉእያ ኡባይ ጋድያፐ ያና’ ያግያዌ ጻፈቴዳ፤ ቃይ የንኮ ባጋና፥ ‘ዎርዱዋን ጫቂያ ኡባይ ያና’ ያግያዌ ጻፈቴዳ። <verse eid="ZEC 5:3"/><verse number="4" style="v" sid="ZEC 5:4"/>ኡባፐ ዎልቃማ መና ጎዳይ ሀዋዳን ያጌ፤ ‘ታን ሄ ሸቃ ኪታና፤ እ ቢደ፥ ካይሱዋ ሶነ ታ ሱንን ዎርዱዋን ጫቂያዋ ጎለ ገላና፤ ያን ደኢደ፥ ሄ ጎልያ እ ኬጸቴዳ ምናነ ሹቻና ጋደ፥ ም ይሳና’ ያጌ” ያጌዳ።<verse eid="ZEC 5:4"/></para>
  <para style="s1">ዛካራስ ሳጻን ቁንኣ ግዶን ኡቴዳ ምሽራቶ በኤዳ</para>
  <para style="p">
    <verse number="5" style="v" sid="ZEC 5:5"/>ሄዋፐ ጉይያን፥ ሄ ታናና ሃሳይያ ኪታንቻይ ታኮ ዪደ፥ “አነ ቁ ጋደ፥ ሀ ይያዌ አየንቶ በአ” ያጌዳ።<verse eid="ZEC 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 5:6"/>ታን፥ “እ አዬ?” ያጋደ ኦቻድ።</para>
  <para style="p" vid="ZEC 5:6">እ ዛሪደ፥ “ሀዌ ማክያ ቁንኣ” ያጌዳ። ቃይካ ጉጂደ፥ “ሀዌ አሳይ ሀ ቢታ ኡባን ኦዳ ናቁዋ ማላታ” ያጌዳ።<verse eid="ZEC 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 5:7"/>እርሳስያ ግያ ብራታፐ ኦሰቴዳ ቁንኣ ቁምኢ ፖከቴዳ ዎደ እት ምሽራታ ቁንኣ ግዶን ኡቴዳኖ በኣድ። <verse eid="ZEC 5:7"/><verse number="8" style="v" sid="ZEC 5:8"/>ኪታንቻይ ታዉ ኦዲደ፥ “ሀና ኢታተቶ ጌተታዉ” ያጌዳ። እዞ ጉየ ቁንኣ ግዶ ሱግ ገልሲደ፥ እርሳስያ ቁምእያካ ዱገ ናቂደ፥ ቁንኣ ቁምኤዳ።<verse eid="ZEC 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 5:9"/>ሄዋፐ ጉይያን፥ ታን ቁ ጋደ ጼልያ ዎደ፥ ኡንቱንቱ ቀፍያን ጫርኩ ደእያ ላኡ ማጫ አሳቱ ይያዋንታ በኣድ፤ ኡንቱንቱ ቀፊ ሾርትያ ቀፍያ ማላ። ኡንቱንቱ ሄ ኬሻ ሳኣፐነ ሳሉዋፐ ግዶ ፑደ ደንድኖ።<verse eid="ZEC 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 5:10"/>ያትና፥ ታን ታናና ሃሳይያ ኪታንቻ፥ “ሀዋንቱ ቁንኣ ሀቃ አፊኖ?” ያጋደ ኦቻድ።<verse eid="ZEC 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ZEC 5:11"/>እ፥ “ኡንቱንቱ ቁንኣ ጎልያ ኬጻናዉ ባብሎነ ቢታ አፊኖ፤ ጎሊ ኬጸቴዳ ዎደ፥ ኡንቱንቱ ሄ ቁንኣ አዉ ጊጌዳ ሳኣን ዎና” ያጌዳ።<verse eid="ZEC 5:11"/></para>
  <chapter eid="ZEC 5"/>
  <chapter number="6" style="c" sid="ZEC 6"/>
  <para style="s1">ዛካራስ ሳጻን ኦይዱ ፓራ ጋረቱዋ በኤዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 6:1"/>ቃይካ ታን ቁ ጋደ ጼላድ፤ ጼልያ ዎደ ኦይዱ ፓራ ጋረቱ ላኡ ደረቱዋፐ ግዱዋና ይያዋንታ በኣድ፤ ደረቱካ ቃይ ናሃሰ ግያ ብራታ ደረቱዋ። <verse eid="ZEC 6:1"/><verse number="2" style="v" sid="ZEC 6:2"/>ኮይሮ ፓራ ጋርያ ዞኦ ፓራቱ ጎቺኖ፤ ላኤን ፓራ ጋርያ ካረ ፓራቱ ጎቺኖ፤<note caller="-" style="x"><char style="xo" closed="false">6:2 </char><char style="xt" closed="false"><ref loc="REV 6:4">ሳፃ 6:4</ref>፣ <ref loc="REV 6:5">5</ref></char></note> <verse eid="ZEC 6:2"/><verse number="3" style="v" sid="ZEC 6:3"/>ሄዘን ፓራ ጋርያ ቦ ፓራቱ ጎቺኖ፤ ኦይደን ፓራ ጋርያ ዋንጮ ፓራቱ ጎቺኖ፤ ኡንቱንቱ ኡባቱካ ዎልቃማ።<note caller="-" style="x"><char style="xo" closed="false">6:3 </char><char style="xt" closed="false"><ref loc="REV 6:2">ሳፃ 6:2</ref></char></note> <verse eid="ZEC 6:3"/><verse number="4" style="v" sid="ZEC 6:4"/>ታን ታናና ሃሳይያ ኪታንቻ፥ “ታ ጎዳዉ፥ ሀዋንቱ አዬ?” ያጋደ ኦቻድ።<verse eid="ZEC 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ZEC 6:5"/>ኪታንቻይ፥ “ሀዋንቱ ሳኣ ኡባ ጎዳ ስንን ባረና ሺሺደ ከስያ ኦይዱ ሳሉዋ ጫርኮቱዋ።<note caller="-" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="REV 7:1">ሳፃ 7:1</ref></char></note> <verse eid="ZEC 6:5"/><verse number="6" style="v" sid="ZEC 6:6"/>ካረ ፓራቱ ጎችያ ጋሪ ሁጲሳ ባጋ ቢታ ቤ፤ ቦ ፓራቱ ጎችያ ጋሪ አዋይ ዶልያ ባጋ ቤ፤ ዋንጮ ፓራቱ ጎችያ ጋሪ ቃይ ገድሳ ባጋ ቤ” ያጊደ ዛሬዳ። <verse eid="ZEC 6:6"/><verse number="7" style="v" sid="ZEC 6:7"/>ሄ ፓራቱ ከሴዳ ዎደ፥ ቢታ ኡባ ዩዪደ ጾሞሳናዉ ፓቹሪኖ። ኪታንቻይ ኡንቱንታ፥ “ቢተ፥ ቢታ ኡባ ዩዪደ ጾሞስተ” ያጌዳ። ኡንቱንቱ ቢታ ኡባ ዩዪደ ዎቼድኖ። <verse eid="ZEC 6:7"/><verse number="8" style="v" sid="ZEC 6:8"/>ሄዋፐ ጉይያን፥ ኪታንቻይ ባረ ቃላ ቁ ኦ ታኮ ዋሲደ፥ “በአ፥ ሁጲሳ ባጋ ቢታ ቤዳ ፓራቱ ባረንቱ ቤዳ ሁጲሳ ባጋ ጋድያን ጾሳ አያና ሸምፕሴድኖ” ያጌዳ።<verse eid="ZEC 6:8"/></para>
  <para style="s1">ቄስያ ኡባ ካፑዋ ኢያሱ ቦላ ጫነቴዳ ሀሳይሱዋ ካላቻ</para>
  <para style="r">(<ref loc="ZEC 6:9-15">6:9-15</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 6:9"/>መና ጎዳ ቃላይ ታኮ፥ ቃይካ ሀዋዳን ያጊድ ዬዳ፤ <verse eid="ZEC 6:9"/><verse number="10" style="v" sid="ZEC 6:10"/>“ባብሎነ ኦሞዱዋፐ ስሜዳ ሄልዳይ፥ ጾቢነ ያዳይ እምያ እሞታ አካ፤ ሄ ጋላስካ ጻፋንያ ናኣ እዮስያሳ ጎለ ባ። <verse eid="ZEC 6:10"/><verse number="11" style="v" sid="ZEC 6:11"/>ኡንቱንቱፐ አኬዳ ብራፐነ ዎርቃፐ ካላቻ መ፤ እዮጸዴቃ ናኣ፥ ቄስያ ኡባቱ ካፑዋ ኢያሱ ሁጲያን ዎ። <verse eid="ZEC 6:11"/><verse number="12" style="v" sid="ZEC 6:12"/>አዉ፥ ‘ኡባፐ ዎልቃማ መና ጎዳይ ሀዋዳን ያጌ፤ “በአ፥ አ ሱንይ ታሽያ ጌተትያ እት ብታኒ ባረ ደእያ ሳን ድጫና፤ እ መና ጎዳ ጌሻ ጎልያ ዛር ኬጻና።<note caller="-" style="x"><char style="xo" closed="false">6:12 </char><char style="xt" closed="false"><ref loc="JER 23:5">ኤር. 23:5</ref>፤ <ref loc="JER 33:15">33:15</ref>፤ <ref loc="ZEC 3:8">ዛካ. 3:8</ref></char></note> <verse eid="ZEC 6:12"/><verse number="13" style="v" sid="ZEC 6:13"/>መና ጎዳ ጌሻ ጎልያ ኬጻናዌ አ፤ እ ካትያዳን ቦንቹዋ ማዪደ፥ ባረ ካተቱዋ አራታን ኡታናነ ሞዳና። ቃይ እ ባረ አራታን ኡቲደ ቄሰተን ኦና፤ ኡንቱንቱ ላኡ ባረንቱ ቆፋን እቱዋ ግዳና” ያጌ’ ያጋ። <verse eid="ZEC 6:13"/><verse number="14" style="v" sid="ZEC 6:14"/>ሄ ካላቻይ ሄልዳያ፥ ጾቢያ፥ ያዳያነ ጻፋንያ ናኣ እዮስያሳ ሀሳይስያዋ ግዲደ፥ መና ጎዳ ጌሻ ጎልያን ደአና” ያጌዳ።<verse eid="ZEC 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ZEC 6:15"/>ሄ ዎደ ሃኮ ሳን ደእያዋንቱ መና ጎዳ ጌሻ ጎልያ ኬጺደ ማዳናዉ ያና። ኡባፐ ዎልቃማ መና ጎዳይካ ታና ህንተኮ ኪቴዳዋ ህንተ ሄዋን ኤራና። መና ጎዳዉ፥ ህንተ ጾሳዉ፥ ህንተ ፖሎ አዛዘቶፐ፥ ሄዌ ሀናና።<verse eid="ZEC 6:15"/></para>
  <chapter eid="ZEC 6"/>
  <chapter number="7" style="c" sid="ZEC 7"/>
  <para style="s1">ልከ ግደና ጾማነ ስንዉ እመቴዳ ህዶታ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 7:1"/>ዳርዮሰ ካተቴዳ ኦይደን ላይን፥ ክስሌዋ ግያ ኡዱፑን አግናን፥ ኦይደን ጋላሳን መና ጎዳ ቃላይ ዛካራሳኮ ዬዳ። <verse eid="ZEC 7:1"/><verse number="2" style="v" sid="ZEC 7:2"/>ቤቴለ ካታማ አሳይ ሳርጼጸና፥ ረጌም-መለካነ ኡንቱንቱና እትፐ ደእያ አሳቱዋ መና ጎዳፐ አንጁ ያና ማላ ዎሳናዉ ኪቴድኖ። <verse eid="ZEC 7:2"/><verse number="3" style="v" sid="ZEC 7:3"/>ቃይ ኡባፐ ዎልቃማ መና ጎዳ ጌሻ ጎልያን ኦያ ቄሳቱ ዋነ ትምቢትያ ኦድያዋንታ፥ “ዳሮ ላይፐ ኦደ ጋምኤዳዋዳን፥ ታን ሀእካ አገናን እቼሸን አግናን ዬካናዉነ ጾማናዉ በሲ?” ያጊደ ኦቻናዳን ኪቴድኖ።<verse eid="ZEC 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ZEC 7:4"/>ሄዋፐ ጉይያን፥ ኡባፐ ዎልቃማ መና ጎዳ ቃላይ ሀዋዳን ያጊድ ታኮ ዬዳ፤ <verse eid="ZEC 7:4"/><verse number="5" style="v" sid="ZEC 7:5"/>“ቢታን ደእያ አሳ ኡባነ ቄሳቱ ዋ ሀዋዳን ያጋደ ኦቻ፤ ‘ህንተ ሄ አዳ ላፑን ታሙ ላይ ግዶን እቼሸን አግናንነ ላፑን አግናን ጾሜዳዋነ ዬኬዳዋ ታዉ ጾሜድቴ? <verse eid="ZEC 7:5"/><verse number="6" style="v" sid="ZEC 7:6"/>ህንተ ምያ ዎደነ ኡሽያ ዎደ፥ ህንተንቶ ሚታነ ኡሺታ ግደኔ። <verse eid="ZEC 7:6"/><verse number="7" style="v" sid="ZEC 7:7"/>የሩሳላመ ካታማንነ አ ዩሹዋን ደእያ ካታማቱዋን አሳይ ደኤዳ ዎደ፥ ኡንቱንቱ እሻሊደ ደኤዳ ዎደነ ኔጌበንነ አዋይ ዶልያ ባጋ ዝቃ ጋድያን አሳይ ደኤዳ ዎደ፥ መና ጎዳይ ባረ ትምቢትያ ኦድያዋንቱ ባጋና ኦዴዳ ቃላይ ሀዋ ግደኔ?’ ያጋ” ያጌዳ።<verse eid="ZEC 7:7"/></para>
  <para style="s1">አዛዘተናን እጼዳዌ ኦሞደታናዉ ጋሶ ግዴዳ</para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 7:8"/>መና ጎዳ ቃላይ ቃይካ ዛካራሳኮ ሀዋዳን ያጊድ ዬዳ፤ <verse eid="ZEC 7:8"/><verse number="9" style="v" sid="ZEC 7:9"/>“ኡባፐ ዎልቃማ መና ጎዳይ ካሰ ሀዋዳን ያጌዳ፤ ‘ቱሙ ፕርዳ ፕርድተ። ህንተ ግዶን እቱ እቶ ኬካተነ ማሮተ ኦተ። <verse eid="ZEC 7:9"/><verse number="10" style="v" sid="ZEC 7:10"/>አምኤቱዋ፥ አታ አዉ ባይና ናናቱዋ፥ በተቱዋነ ህዬሳቱዋ ናቆፕተ። ቃይ ህንተፐ ኦንነ ባረ እሻ ቦላን ኢታባ ኦናዉ ባረ ዎዛናን ቆፖፖ’ ያጌዳ” ያጊድ ዬዳ።<verse eid="ZEC 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ZEC 7:11"/>ሽን ኡንቱንቱ ስሰናን እጼድኖ፤ ቃይ ዞክያ ዛሬድኖነ ስሰናዳን፥ ባረንቱ ሀይካ ቱጬድኖ። <verse eid="ZEC 7:11"/><verse number="12" style="v" sid="ZEC 7:12"/>ኡባፐ ዎልቃማ መና ጎዳይ ባረ አያናን ካሰ ባረ ትምቢትያ ኦድያዋንቱ ባጋና ኪቴዳ ህግያነ ቃላ ስሰና ማላ፥ ኡንቱንቱ ባረንቱ ዎዛና ዛላዳን ምንሴድኖ። ሄዋ ድራዉ፥ ኡባፐ ዎልቃማ መና ጎዳ ማታፐ ዎልቃማ ሀንቁ ኡንቱንቱ ቦላ ዬዳ።<verse eid="ZEC 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ZEC 7:13"/>ኡባፐ ዎልቃማ መና ጎዳይ ሀዋዳን ያጌ፤ “ታን ጼሴዳ ዎደ፥ ኡንቱንቱ ስሰናን እጼዳዋዳን፥ ኡንቱንቱ ጼሴዳ ዎደ፥ ታንካ ስስከ። <verse eid="ZEC 7:13"/><verse number="14" style="v" sid="ZEC 7:14"/>ታን ጎትያ አሃደ፥ ኡንቱንታ ኡንቱንቱ ኤርቤና ካዉተቱዋ ግዶን ላላድ፤ ቢታይ አሳይ ያነ ሃነ ስመረተና መላ ቢታ ግዴዳ፤ ሄዋዳን ሀኒደ፥ ሀ ሎኦ ቢታይ መላ ግዴዳ” ያጌ።<verse eid="ZEC 7:14"/></para>
  <chapter eid="ZEC 7"/>
  <chapter number="8" style="c" sid="ZEC 8"/>
  <para style="s1">የሩሳላመ ኦራጻና</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 8:1"/>ኡባፐ ዎልቃማ መና ጎዳ ቃላይ ቃይካ ታኮ፥ ሀዋዳን ያጊድ ዬዳ፤ <verse eid="ZEC 8:1"/><verse number="2" style="v" sid="ZEC 8:2"/>“ኡባፐ ዎልቃማ መና ጎዳይ፥ ‘ታን ጽዮንዉ ሎይ ምሸታይ፤ ታና እ ምሹ ጹጌ’ ያጌ። <verse eid="ZEC 8:2"/><verse number="3" style="v" sid="ZEC 8:3"/>መና ጎዳይ ሀዋዳን ያጌ፤ ‘ታን ጽዮነ ስማና፤ የሩሳላመ ግዶን ደአና። ቃይ የሩሳላመካ አማነትያ ካታማ ጌተታና፤ ኡባፐ ዎልቃማ መና ጎዳ ደሪ ቃይ ጌሻ ደርያ ጌተቲደ ጼሰታና’ ያጌ።<verse eid="ZEC 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ZEC 8:4"/>“ኡባፐ ዎልቃማ መና ጎዳይ ሀዋዳን ያጌ፤ ‘ጭሚደ ጉፍያን ብያ አቱማ አሳይነ ማጫ አሳይ ካሰዋንቱዋዳን ቃይካ የሩሳላመ ዳባባን ኡታና። <verse eid="ZEC 8:4"/><verse number="5" style="v" sid="ZEC 8:5"/>የሩሳላመ ካታማ ኦገቱ ካሳ ካእያ አቱማ ናናቱዋንነ ማጫ ናናቱዋን ኩማና’ ያጌ። <verse eid="ZEC 8:5"/><verse number="6" style="v" sid="ZEC 8:6"/>ኡባፐ ዎልቃማይ መና ጎዳይ፥ ‘ሀዌ ሀቃ አሳፐ አቴዳዋንቶ ማላልስያባ ግዶፐነ፥ ታዉ ማላልስያባ ግደና’ ያጌ ኡባፐ ዎልቃማይ መና ጎዳይ። <verse eid="ZEC 8:6"/><verse number="7" style="v" sid="ZEC 8:7"/>ኡባፐ ዎልቃማይ መና ጎዳይ ሀዋዳን ያጌ፤ ‘በእተ፥ ታን ታ አሳ አዋይ ዉልያ ባጋ ቢታፐነ አዋይ ዶልያ ባጋ ጋድያፐ አሻና። <verse eid="ZEC 8:7"/><verse number="8" style="v" sid="ZEC 8:8"/>ኡንቱንቱ የሩሳላመ ግዶን ደአናዳን አሀና። ኡንቱንቱ ታ አሳ ግዳና፤ ታንካ ኡንቱንቱ ጾሳ፥ አማነትያነ ጽሎ ጾሳ ግዳና’ ያጌ” ያጊድ ዬዳ።<verse eid="ZEC 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 8:9"/>ኡባፐ ዎልቃማ መና ጎዳይ ሀዋዳን ያጌ፤ “ህንተኖ፥ ኡባፐ ዎልቃማ መና ጎዳ ጌሻ ጎልያ ባሱዋ ባስያ ጋላሳፐ ዶሚደ፥ ትምቢትያ ኦድያዋንቱ ኦዴዳ ቃላ ስሴዳዋንቶ፥ ህንተ ኩሽያ ምንሲደ ፖልተ። <verse eid="ZEC 8:9"/><verse number="10" style="v" sid="ZEC 8:10"/>አያዉ ጎፐ፥ ሄ ጋላሳቱዋፐ ካሰ ባጋን አሳዉ ድርጉ ባዋ፤ መህያዉካ ከራ ጭጋይ ባዋ፤ ቃይ ታን አሳ ኡባ እቱዋ እቱዋ ቦላ ሞርከተን ደን ዎዳ ድራዉ፥ ገልያዋዉነ ከስያዎ ሳሩ ባዋ። <verse eid="ZEC 8:10"/><verse number="11" style="v" sid="ZEC 8:11"/>ሽን ሀእ ታን ሀ አሳፐ አቴዳዋንታ ካሰ ኦዳዋዳን ኦከ። ታን ኡባፐ ዎልቃማ መና ጎዳይ ሀዋ ኦዳይ።<verse eid="ZEC 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ZEC 8:12"/>“ኡንቱንቱ ባረንቱ ዘረ ሳሩዋን ዘራና፤ ኡንቱንቱ ዎይንያ ቱራይካ ባረ አይፍያ አይፋና፤ ቢታይካ ካ ዳርሲደ ሞካና፤ ሳሎቱካ እራ ቡካና። ሀ አሳፐ አቴዳዋንቶ ታን ሀ ኡባ አንጁዋ እማና። <verse eid="ZEC 8:12"/><verse number="13" style="v" sid="ZEC 8:13"/>ህንተኖ ይሁዳ አሳቶ፥ ህንተኖ እስራኤልያ አሳቶ፥ ካዉተቱዋ ግዶን ህንተ ሸቀቴዳዋንታ ግዲደ ደኤድታ፤ ሽን ሀእ ታን ህንተና አሻና፤ ህንተካ አንጀቴዳዋንታ ግዳና። ያዮፕተ! ህንተ ኩሽያካ ምንስተ!” ያጌ።<verse eid="ZEC 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ZEC 8:14"/>ኡባፐ ዎልቃማ መና ጎዳይ ሀዋዳን ያጌ፤ “ህንተ ማይዛ አዎቱ ታና ሀንቀዳ ዎደ፥ ኡንቱንቱ ቦላን ኢታባ አሀና ጋደ ቃቼዳ ቆፋ ላመናን ኦዳዋዳን፥ <verse eid="ZEC 8:14"/><verse number="15" style="v" sid="ZEC 8:15"/>ሄዋዳንካ ሀእ ታን የሩሳላመዉነ ይሁዳዉ ሎኦባ ኦናዉ ቆፋ ቃቻድ። ስም ያዮፕተ! <verse eid="ZEC 8:15"/><verse number="16" style="v" sid="ZEC 8:16"/>ህንተ ኦናዉ ኮሽያዌ ሀዋንታ: እቱ እቱዋና ቱሙዋ ሃሳይተ፤ ህንተ ፕርዳ ጎልያንካ ቱሙዋነ ሳሩዋ አህያ ፕርዳ ፕርድተ፤<note caller="-" style="x"><char style="xo" closed="false">8:16 </char><char style="xt" closed="false"><ref loc="EPH 4:25">ኤፈ. 4:25</ref></char></note> <verse eid="ZEC 8:16"/><verse number="17" style="v" sid="ZEC 8:17"/>እቱ እቱዋ ቆሀናዉ ኢታባ ህንተ ዎዛናን ማቀቶፕተ፤ ዎርዱዋን ጫቂያዋ ዶሶፕተ። ሄዋንታ ኡባ ታን መና ጎዳይ እጻይ” ያጌ።<verse eid="ZEC 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ZEC 8:18"/>ኡባፐ ዎልቃማ መና ጎዳ ቃላይ ቃይካ ታኮ፥ ሀዋዳን ያጊድ ዬዳ፤ <verse eid="ZEC 8:18"/><verse number="19" style="v" sid="ZEC 8:19"/>“ኡባፐ ዎልቃማ መና ጎዳይ ሀዋዳን ያጌ፤ ‘ኦይደን፥ እቼሸን፥ ላፑንነ ታማን አግናቱዋን ህንተ ጾሜዳ ጾማቱ ይሁዳ አሳዉ ፓሽክስያ ዎደነ ናሸችያ ግብራ ግዳናዋ። ሄዋ ድራዉ፥ ህንተ ቱማተነ ሳሮተ ዶስተ’ ያጌ።<verse eid="ZEC 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ZEC 8:20"/>“ኡባፐ ዎልቃማ መና ጎዳይ ሀዋዳን ያጌ፤ ‘አሳይ፥ ኡባ ቃይ ዳሮ ካታማቱዋን ደእያ አሳይ ብሮ የሩሳላመ ያና። <verse eid="ZEC 8:20"/><verse number="21" style="v" sid="ZEC 8:21"/>እት ካታማን ደእያ አሳይ ሀራ ካታማን ደእያ አሳኮ ቢደ፥ “መና ጎዳ አንጁ ያና ማላ ዎሳናዉነ ኡባፐ ዎልቃማ መና ጎዳ ኮያናዉ አነ ቤቶ፤ ታንካ ባይ” ያጋና። <verse eid="ZEC 8:21"/><verse number="22" style="v" sid="ZEC 8:22"/>ቃይ ዳሮ አሳይነ ዎልቃማ ካዉተቱ ኡባፐ ዎልቃማ መና ጎዳ ኮያናዉነ ዎሳናዉ የሩሳላመ ያና’ ያጌ።<verse eid="ZEC 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ZEC 8:23"/>“ኡባፐ ዎልቃማ መና ጎዳይ ሀዋዳን ያጌ፤ ‘ሄ ጋላሳቱዋን ዱማ ዱማ ቃላን ሃሳይያ ካዉተቱዋ ኡባፐ ታሙ አሳቱ ዪደ፥ እት አይሁዳ ብታንያ ማዩዋ ማጫራ ኦይቂደ፥ “ጾሳይ ህንተናና ደእያዋ ኑን ስሴዳ ድራዉ፥ አነ ኑንካ ኔናና ቤቶ” ያጋና’ ያጌ” ያጊድ ዬዳ።<verse eid="ZEC 8:23"/></para>
  <chapter eid="ZEC 8"/>
  <chapter number="9" style="c" sid="ZEC 9"/>
  <para style="s1">ማስህያ ዩሳነ ጾሳ ካዉተይ በስያዋዳን ኤረቱሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 9:1"/>ሀድራካ ግያ ቢታይነ ዳማስቆ ካታማይ ሙረታናዋ ጾሳይ ኦዴዳ ፕርዳ ቃላይ ሀዋ።<note caller="-" style="x"><char style="xo" closed="false">9:1 </char><char style="xt" closed="false"><ref loc="ISA 17:1-3">ኢሳ. 17:1-3</ref>፤ <ref loc="JER 49:23-27">ኤር. 49:23-27</ref>፤ <ref loc="AMO 1:3-5">አሞጻ 1:3-5</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">9:1-4 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">ኢሳ. 23:1-18</ref>፤ <ref loc="EZK 26:1-28:26">ህዝ. 26:1—28:26</ref>፤ <ref loc="JOL 3:4-8">ኢዩ. 3:4-8</ref>፤ <ref loc="AMO 1:9-10">አሞጻ 1:9-10</ref>፤ <ref loc="MAT 11:21-22">ማቶሳ 11:21-22</ref>፤ <ref loc="LUK 10:13-14">ሉቃሳ 10:13-14</ref></char></note> ሶርያ ዋና ካታማይ ዳማስቁካ መና ጎዳሳ ግድያ ድራዉ፥ እስራኤልያ ዛራቱዋ ጻላላ ግደናን አሳ ኡባ አይፊ ፑደ መና ጎዳኮ ጼሌ። <verse eid="ZEC 9:1"/><verse number="2" style="v" sid="ZEC 9:2"/>ቃይ ሄ ፕርዳይ ሀድራካና ዛዋትያ ሀማታ ካታማ ቦላካ ጋካና፤ ኡንቱንቱ አዳ ኤራንቻ ግዶፐነ፥ ጺሮሳነ ሲዶና ካታማቱዋካ ሀ ፕርዳይ ጋካና። <verse eid="ZEC 9:2"/><verse number="3" style="v" sid="ZEC 9:3"/>ጺሮሳ ካታማይ ዳሮ ምኖ ጌሱዋ ግምቤዳ። ቃይ ብራ ቢታዳን ዶሬዳ፤ ዎርቃካ ኦግያ ኡርቃዳን ጉፔዳ። <verse eid="ZEC 9:3"/><verse number="4" style="v" sid="ZEC 9:4"/>ሽን እዛ ሺሼዳዋ ኡባ ጎዳይ ዉርስ አካና፤ እዝ አባ ዎልቃ ይሳና፤ ካታማይካ ታማን ሜተታና።<verse eid="ZEC 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ZEC 9:5"/>አስቃሎና ካታማይ ሄዋ በኢደ ያያና፤ ጋዛ ካታማይካ በኢደ ኡንኤና፤ ቃይ ኤቅሮና ካታማይካ ህዶታ ያና። ጋዛ ባረ ካትያ ያና፤ አስቃሎና ካታማይካ መላ ግዳናዋ።<note caller="-" style="x"><char style="xo" closed="false">9:5-7 </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">ኢሳ. 14:29-31</ref>፤ <ref loc="JER 47:1-7">ኤር. 47:1-7</ref>፤ <ref loc="EZK 25:15-17">ህዝ. 25:15-17</ref>፤ <ref loc="JOL 3:4-8">ኢዩ. 3:4-8</ref>፤ <ref loc="AMO 1:6-8">አሞጻ 1:6-8</ref>፤ <ref loc="ZEP 2:4-7">ሶፎ. 2:4-7</ref></char></note> <verse eid="ZEC 9:5"/><verse number="6" style="v" sid="ZEC 9:6"/>አሽዶዳ ካታማን ዋላካ አሳይ ደአና።</para>
  <para style="p" vid="ZEC 9:6">ታን፥ “ፕልስጼማቱዋ ኦቶሩዋካ ይሳና። <verse eid="ZEC 9:6"/><verse number="7" style="v" sid="ZEC 9:7"/>ታን ሱ ኡንቱንቱ ዶናፐ፥ ድገቴዳ ቁማ ኡንቱንቱ አቻፐ ድጋና። ኡንቱንቱፐ አቴዳዋንቱ ኑ ጾሳ አሳ ግዳና። ቃይ ይሁዳ ያራ ማላ ግዳና። ኤቅሮና አሳይ ያቡሳ አሳዳን፥ ታ አሳ ግዳና። <verse eid="ZEC 9:7"/><verse number="8" style="v" sid="ZEC 9:8"/>ሄዋፐ ጉይያን፥ ኦላንቻቱ ካንናዳን፥ ታን ታ ጋድያ ናጋና። ታን ታ ሁጲያን ናግያ ድራዉ፥ ላኤን ኦንነ ታ አሳ ኡቁነና” ያጌ።<verse eid="ZEC 9:8"/></para>
  <para style="s1">ይያ ካትያ</para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 9:9"/>ኔኖ ጽዮነ ካታማቴነ የሩሳላመ ካታማቴ፥ እልላ!<note caller="-" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="MAT 21:5">ማቶሳ 21:5</ref>፤ <ref loc="JHN 12:15">ዮሃ. 12:15</ref></char></note> በአ፥ ጾኔዳ ነ ጽሎ ካቲ ኔኮ ዬ። ነ ካቲ አሽከ ግዲደ፥ ሀርያ ቦላ፥ ሀርያ ማራ ቦላ ኡቲደ፥ ኔኮ ዬ።<verse eid="ZEC 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 9:10"/>ታን፥ “ፓራ ጋረቱዋ እስራኤልያፐ፥ ኦላ ፓራቱዋካ የሩሳላመፐ ይሳና፤ ኦላ ዎንዳፊካ መኤረታና። ቃይ ነ ካቲ ካዉተቶ ሳሩዋ አዋያና፤ እ ሀ አባ ጋጻፐ ህን አባ ጋጻ ጋካናዉነ ኤፍራጺሳ ሻፋፐ ሳኣ ጋጻ ጋካናዉ ሞዳና ያጌ።<note caller="-" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="PSA 72:8">ማዝ. 72:8</ref></char></note><verse eid="ZEC 9:10"/></para>
  <para style="s1">ጾሳይ ባረ አሳ አሻና</para>
  <para style="p">
    <verse number="11" style="v" sid="ZEC 9:11"/>“ኔና ግዶፐ፥ ቃይ ታን ኔናና ጫቀቴዳ ጫቁዋ ሱ ድራዉ፥ ነ አሳቱዋ ኡንቱንቱ ቃሸቴዳ ሃይ ባይና ኦላፐ ታን ከሳደ የዳና።<note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="EXO 24:8">ከሳ 24:8</ref></char></note> <verse eid="ZEC 9:11"/><verse number="12" style="v" sid="ZEC 9:12"/>ህንተኖ ህዶታን ደእያ ቃሸቶ አሳቶ፥ ህንተ ጌሱዋኮ ስምተ፤ ካሰዋ ድራዉ ዳኩዋ አቁዋ ህንተንቶ እማናዋ ሀች ታን ህንተንቶ አዋያይ። <verse eid="ZEC 9:12"/><verse number="13" style="v" sid="ZEC 9:13"/>አያዉ ጎፐ፥ ታን ይሁዳ ዎንዳፍያዳን፥ እስራኤልያካ ዎንዳፍያ ፖዳን ጎኤታና። ጽዮኔ፥ ታን ነ ናናቱዋ ግሪከ ጋድያ ናናቱ ቦላ ደንና፤ ኔናካ ዎልቃማ ኦላንቻ ማሻ ማላ ኦና” ያጌ።<verse eid="ZEC 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ZEC 9:14"/>ሄ ዎደ መና ጎዳይ ኡንቱንቱ ቦላ ቆንጫና፤ አ ዎንዳፊካ ዋልቃንዳን ዋልቃማና። ኡባ ማርያ መና ጎዳይ ማላካታ ፑናና፤ ገድሳ ባጋ ጎቲ አያዋዳንካ አና። <verse eid="ZEC 9:14"/><verse number="15" style="v" sid="ZEC 9:15"/>ኡባፐ ዎልቃማ መና ጎዳይ ኡንቱንታ ናጋና። ኡንቱንቱካ ባረንቱ ሞርከቱዋ ዉርሳና፤ ያምባርሻን ኦልያዋንታካ የና። ኡንቱንቱ ባረንቱ ሞርከቱዋ ሱ ዎይንያ ኤሳዳን ኡሻና፤ ሱይ ከርያን ኩምያዋዳን ኩማና፤ ቃይ ያርሽያ ሳኣን ጉክያዋዳን ጉካና።<verse eid="ZEC 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ZEC 9:16"/>ሄ ጋላስ መና ጎዳይ ኡንቱንቱ ጾሳይ ኡንቱንታ አሻና፤ አያዉ ጎፐ፥ ኡንቱንቱ አ አሳ ዉደቱዋ። ካላቻ ቦላ ደእያ አሌቁዋዳን፥ ጾሳ ጋድያ ቦላን ኡንቱንቱ ጶላና። <verse eid="ZEC 9:16"/><verse number="17" style="v" sid="ZEC 9:17"/>ኡንቱንቱ ዋኒደ ሎአነ ማላ ፑላ ግዳንድኖሻ! ዎዳላ ናናቱዋ ካይ፥ ዎዶሮ ናናቱዋካ ዎይንያ ኤሳይ አጭሳና።<verse eid="ZEC 9:17"/></para>
  <chapter eid="ZEC 9"/>
  <chapter number="10" style="c" sid="ZEC 10"/>
  <para style="s1">መና ጎዳይ ባረ አሳ አንጃና</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 10:1"/>ባልጉ ጋክያ ዎደ፥ መና ጎዳይ እራ እማናዳን ዎስተ። መና ጎዳይ እራ ቶኬዳ ሻርያ ኪቴ፤ ቃይ እ አሳዉ እራ እሜ፤ አታክልትያካ ሾይቃን ሞክሴ። <verse eid="ZEC 10:1"/><verse number="2" style="v" sid="ZEC 10:2"/>ሶ ኤቃ ምስለቱ ኦድያዌ ሀዳ፤ ካይያዋንቱ ዎርዶ ሳፃ በኢኖ፤ አኩመትያዋንቱካ ዎርዶ አኩሙዋ ኦዲኖ፤ ሀዳ ምንዋካ ምንኖ። ሄዋ ድራዉ፥ አሳይ ዱጼዳ ዶርሳዳን ቶይላካቴ፤ ኡንቱንታ ሄምያዌ ባይና ድራዉ፥ ኡንቱንቱ ቆሄቲኖ።<verse eid="ZEC 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEC 10:3"/>ታ ሀንቁ ሄንንቻቱዋ ቦላ ኤጽ ከሴዳ፤ ሄ ካለያዋንታ ታን ሙራና። አያዉ ጎፐ፥ ኡባፐ ዎልቃማ መና ጎዳይ ባረ ዶርሳ ዉደ ግድያ ይሁዳ አሳ እ ሄሜ፤ እ ኡንቱንታ ኦላዉ ሳልፔዳ ባረ ዎልቃማ ፓራ ማላ ኦና። <verse eid="ZEC 10:3"/><verse number="4" style="v" sid="ZEC 10:4"/>ይሁዳ አሳ ግዶፐ ካለያዋንቱ ከሳና፤ ኡንቱንቱ ጎልያዉ ጎዳ ጻጱዋ ምንስያ ሹቻዳን፥ ዱንካንያ ጌዳዋዳንነ ኦላ ሚሻዳን ምኖ ግዳናዋ። <verse eid="ZEC 10:4"/><verse number="5" style="v" sid="ZEC 10:5"/>ኡንቱንቱ ኦግያ ኡርቃ የያ ምኖ ኦላንቻቱዋ ማላ ግዳናዋንታ፤ መና ጎዳይ ኡንቱንቱና ደእያ ድራዉ፥ ኡንቱንቱ ኦለታና፤ ፓራ አሳቱዋካ ጾናና።<verse eid="ZEC 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 10:6"/>“ታን ይሁዳ አሳ ምንና፤ ዮሴፎ አሳካ አሻና፤ ታን ኡንቱንቶ ቃረትያ ድራዉ፥ ኡንቱንቱ ዛራደ አሀና፤ ቃይ ኡንቱንቱካ ታን ኡንቱንታ ካሰካ አጋቤናባ ማላ ግዳናዋ። ታን መና ጎዳ ኡንቱንቱ ጾሳ ግድያ ድራዉ፥ ኡንቱንቱ ዎሳ ስሳና። <verse eid="ZEC 10:6"/><verse number="7" style="v" sid="ZEC 10:7"/>ኤፍሬማ አሳይ ምኖ ኦላንቻ ማላ ግዳናዋ፤ ዎይንያ ኤሳ ኡሼዳ አሳዳን፥ ኡንቱንቱ ዎዛናይ ናሸታና። ኡንቱንቱ ናናይካ ሄዋ በኢደ፥ ሀሹ ጋና፤ ኡንቱንቱ ዎዛናይ መና ጎዳን ናሸታና።<verse eid="ZEC 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 10:8"/>“ታን ታ አሳ ሱይቃደ ጼሳና፤ ያታደ፥ ኡንቱንታ እትፐ ሺሻና። አያዉ ጎፐ፥ ታን ኡንቱንታ ዎዛድ፤ ኡንቱንቱ ካሰዋዳንካ ጮራ ግዳናዋንታ። <verse eid="ZEC 10:8"/><verse number="9" style="v" sid="ZEC 10:9"/>ታን ኡንቱንታ አይሁዳ ግደና ካዉተቱዋ ግዶን ላልንቶካ፥ ኡንቱንቱ ባረንቱ ደእያ ሃኮ ጋድያን ታና ሀሳያና፤ ቃይ ኡንቱንቱካ ኡንቱንቱ ናናይካ ፓጻ አታናነ ባረንቱ ቢታ ስማና። <verse eid="ZEC 10:9"/><verse number="10" style="v" sid="ZEC 10:10"/>ታን ኡንቱንታ ግብጼ ጋድያፐ ዛራና፤ አሶረ ቢታፐካ ታን ኡንቱንታ ሺሻና። ኡንቱንቶ ኡትያ ሳአይ ያና ጋካናዉ፥ ታን ኡንቱንታ ጋላኣደ ቢታንነ ሊባኖሳ ጋድያን ኩንና። <verse eid="ZEC 10:10"/><verse number="11" style="v" sid="ZEC 10:11"/>ኡንቱንቱ መቶ አባ ግዶና አሽን፥ ታን ጾሳይ አባ ቤታ ሾጫና፤ ጪማ ግዴዳ ናይለ ሻፋይካ መላና። አሶረ ቢታ ኦቶሩ ጊያና፤ ግብጼ ካተቱዋ ጻምአይካ መአና። <verse eid="ZEC 10:11"/><verse number="12" style="v" sid="ZEC 10:12"/>ታን ኡንቱንታ መና ጎዳን ምንሳና፤ ኡንቱንቱካ አ ሱንን ሀመታና። ታን መና ጎዳይ ሀዋ ኦዳይ” ያጌ።<verse eid="ZEC 10:12"/></para>
  <chapter eid="ZEC 10"/>
  <chapter number="11" style="c" sid="ZEC 11"/>
  <para style="s1">ፕርዳ ሌምሱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 11:1"/>ኔኖ፥ ልባኖሳ፥ ታማይ ነ ዝጋቱዋ ማና ማላ፥ ነ ፐንገቱዋ ዶያ! <verse eid="ZEC 11:1"/><verse number="2" style="v" sid="ZEC 11:2"/>ኔኖ ጽድያዉ፥ ዝጋይ ኩንድ ክቼዳ ድራዉ፥ ቃይ ሄ ቦንቹዋ ምቱካ ይክቼዳ ድራዉ፥ አየ ጋደ ዬካ! ህንተኖ ባሳነ ጋድያ ዎላቶ፥ ሄ ኮንሶሴዳ ዎራይ ቃንጸት ክቼዳ ድራዉ፥ አየ ጊደ ዬክተ። <verse eid="ZEC 11:2"/><verse number="3" style="v" sid="ZEC 11:3"/>ሄንንቻቱ ዝላሳ ስስተ፤ አያዉ ጎፐ፥ ኡንቱንቱ ቦንቹ ዬዳ! ጋሞቱ ጉድያዋካ ስስተ፤ አያዉ ጎፐ፥ ዮርዳኖሳ ዎራይ ይክቼዳ።<verse eid="ZEC 11:3"/></para>
  <para style="s1">ኬካነ ኢታ ሄንንቻቱዋ</para>
  <para style="p">
    <verse number="4" style="v" sid="ZEC 11:4"/>መና ጎዳይ ታ ጾሳይ ታና ሀዋዳን ያጌዳ፤ “ሄ ሹከታናዉ ደእያ ዶርሳቱዋ ዉድያ ሄማ። <verse eid="ZEC 11:4"/><verse number="5" style="v" sid="ZEC 11:5"/>ኡንቱንታ ሻምያዋንቱ ሹክኖ፤ ሙረተናን አትኖ። ቃይ ዛልእያዋንቱካ፥ ‘ኑን ዱረቴዶ፤ መና ጎዳይ ጋላተቶ’ ያጊኖ፤ ሀራይ አትና፥ ኡንቱንቱ ሄንንቻቱካ ኡንቱንቶ ቃረትክኖ” ያጌዳ።<verse eid="ZEC 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 11:6"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ታንካ ሀዋፐ ስንናዉ ሀ ጋድያን ደእያ አሳዉ ቃረትከ፤ ታን አሳ ኡባ እቱዋ እቱዋ ኩሽያንነ ካትያ ኩሽያን አደ እማና። ኡንቱንቱ ጋድያ ባይዛና፤ ታንካ እት አሳነ ኡንቱንቱ ኩሽያፐ አሽከ” ያጌ።<verse eid="ZEC 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 11:7"/>ሄዋ ድራዉ፥ ታን ሹከታናዉ ደእያ ዶርሳቱዋ፥ ኡባ ቃይ ዉድያ ግዶን ቱጋቴዳዋንታ ሄምያዋ ግዳድ። ቃይ ላኡ ጋትማቱዋ አካደ ኡንቱንቱፐ እቱዋ ኬካተ ጋደ ሱንድ፤ ላኤንዋካ እትፐተ ጋደ ሱንድ። ያታደ ዶርሳ ዉድያ ሄማድ። <verse eid="ZEC 11:7"/><verse number="8" style="v" sid="ZEC 11:8"/>ሄዋፐ ጉይያን፥ ታን እት አግና ግዶን ሄዙ ሄንንቻቱዋ ድጋድ። አያዉ ጎፐ፥ ኡንቱንቱ ሀኖተይ ታዉ ዳንዳየትቤና፤ ያትና፥ ኡንቱንቱካ ታና እጼድኖ። <verse eid="ZEC 11:8"/><verse number="9" style="v" sid="ZEC 11:9"/>ያታ ስማደ ታን ዶርሳቱዋ፥ “ታን ህንተና ላኤን ሄምከ፤ ሀይቂያዌ ሀይቆ፤ ባይያዌ ባዮ፤ አትያዌካ እቱ እቱዋና ሜተቲደ ዉሮ” ያጋድ።<verse eid="ZEC 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 11:10"/>ስማደ ታን ካዉተቱዋ ኡባና ጫቀቴዳ ጫቁዋ መንዳዋ በሳናዉ ኬካተ ግያ ታ ጋትማ አካደ መንድ። <verse eid="ZEC 11:10"/><verse number="11" style="v" sid="ZEC 11:11"/>ሄዋ ድራዉ፥ ሄ ጋላስካ ጫቁዋ መን አጌዳ፤ ያትና፥ ሄ ዎደ ኡንኤት ኡቴዳ ታና ጼልያ ዶርሳቱ በኢደ፥ ሀዌ መና ጎዳ ቃላ ግድያዋ ኤሬድኖ። <verse eid="ZEC 11:11"/><verse number="12" style="v" sid="ZEC 11:12"/>ታን ኡንቱንቱ፥ “እማናዉ በሰ ጎፐ፥ ታ ድርጉዋ ሀምተ፤ ኮሸና ጎፐካ፥ አግ ባሽተ” ያጋድ። ኡንቱንቱ ታ ድርጉዋ ሀታሙ ጻጋራ ብራ ታዉ እሜድኖ።<note caller="-" style="x"><char style="xo" closed="false">11:12 </char><char style="xt" closed="false"><ref loc="MAT 26:15">ማቶሳ 26:15</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">11:12-13 </char><char style="xt" closed="false"><ref loc="MAT 27:9-10">ማቶሳ 27:9-10</ref></char></note><verse eid="ZEC 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ZEC 11:13"/>ያትና፥ መና ጎዳይ ታና፥ “ኡንቱንቱ ሄዋ ከሳና ግ ማየቲደ እሜዳ ሄ ካቴዳ ብራ መና ጎዳ ጎልያ ሻሉዋ ምንጅያ ጎልያ ግዱዋ ኦላ” ያጌዳ። ታን ሄ ሀታሙ ጻጋራ ብራ አፋደ፥ መና ጎዳ ጎልያ ሻሉዋ ምንጅያ ጎልያ ግዶ ኦላድ። <verse eid="ZEC 11:13"/><verse number="14" style="v" sid="ZEC 11:14"/>ሄዋፐ ጉይያን፥ ታን ይሁዳፐነ እስራኤልያፐ ግዱዋን ደእያ እሻተይ መኤዳዋ በሳናዉ እትፐተ ግያ ታ ላኤን ጻምኣ መንድ።<verse eid="ZEC 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ZEC 11:15"/>ቃይካ መና ጎዳይ ታና፥ “ላኤንዋካ አዛላ ሄንንቻ ሚሻቱዋ አካ። <verse eid="ZEC 11:15"/><verse number="16" style="v" sid="ZEC 11:16"/>አያዉ ጎፐ፥ ታን ሀ ጋድያን እት ሄንንቻ ደንና። ሽን እ ዋየትያ ዶርሳቱዋ ማደና፤ ላለቴዳዋንታ ሺሸና፤ ዎቢያዋ ኮለና፤ ፓጻካ ምዘና። እ ሄዋ አጊደ፥ ሞዳዋንታ ሹክ ሹኪደ ሜ፤ ኡንቱንቱ ሹቁልያካ ቃንጼ። <verse eid="ZEC 11:16"/><verse number="17" style="v" sid="ZEC 11:17"/>ዶርሳ ዉድያ የግ ባሼዳ ሄ ላፋ ፓና ሄንንቻዉ አየ አና! አ ቀስያነ አ ኡሸቻ አይፍያ ቦላን ማሻይ ዎ። አ ቀሲ ስሎ፤ አ ኡሸቻ አይፊካ ትፕ ጊደ ቶኦ” ያጌዳ።<verse eid="ZEC 11:17"/></para>
  <chapter eid="ZEC 11"/>
  <chapter number="12" style="c" sid="ZEC 12"/>
  <para style="s1">የሩሳላመ ጾኑዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 12:1"/>ሀዌ እስራኤልያባ ኦድያ መና ጎዳ ቃላ። ሳሎቱዋ ምጬዳዌ፥ ሳኣካ መዳዌ፥ አሳ ግዶንካ አያና መዳ መና ጎዳይ ሀዋዳን ያጌ፤ <verse eid="ZEC 12:1"/><verse number="2" style="v" sid="ZEC 12:2"/>“በአ፥ ታን የሩሳላመ ካታማ አ ዩሹዋን ደእያ አሳ ኡባ ኡሽና ጋንድጋርስያ ዎይንያ ኤሳ ትግያ ዋንጫ ማላ ኦና፤ የሩሳላመ ዶደትያ ዎደ፥ ይሁዳ ካታማቱካ ዶደታና። <verse eid="ZEC 12:2"/><verse number="3" style="v" sid="ZEC 12:3"/>ሄ ጋላስ ታን የሩሳላመ ካታማ አሳ ኡባዉ ዴጾ ሹቻ ማላ ኦና፤ አ ደንያ ኡባይ ባረዉ ደሸታና። ቃይ ሳኣ ካዉተቱ ኡባይ አ ኦለታናዉ እትፐ ሺቃና። <verse eid="ZEC 12:3"/><verse number="4" style="v" sid="ZEC 12:4"/>ሄ ጋላስ ታን ፓራ ኡባ ዳጋንና፤ ፓራ ቶግያዋንታካ ጎሻና። ሄዋ ታን መና ጎዳይ ኦዳይ። ይሁዳ አሳ ታን ታ ኬካ አይፍያን ጼላና፤ ሽን ሞርከቱዋ ፓራቱዋ ኡባካ ቆቅሳና። <verse eid="ZEC 12:4"/><verse number="5" style="v" sid="ZEC 12:5"/>ሄ ዎደ ይሁዳን ካለያዋንቱ ባረንቱ ዎዛናን፥ ‘የሩሳላመ አሳይ ኡባፐ ዎልቃማ መና ጎዳን፥ ባረንቱ ጾሳን፥ ምኖተ ደሜድኖ’ ያጋና።<verse eid="ZEC 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 12:6"/>“ሄ ጋላስ ታን ይሁዳን ካለያዋንታ ም ዶርያ ግዶን ደእያ ጺፋነ ምርቀቱዋ ግዶን ላጮትያ ጾምፕያ ኦና። ኡንቱንቱ ባረንቱ ኡሸቻን ሀድርሳንነ ባረንቱ ዩሹዋን ደእያ አሳ ኡባ ማና፤ ሽን የሩሳላመ ካታማይ አሳይ ሳሮ ደኢያሳ ግዳናዋ።<verse eid="ZEC 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 12:7"/>“ዳዊታ ጎልያ ቦንቹነ የሩሳላመን ደእያዋንቱ ቦንቹ ይሁዳ አሳ ቦንቹዋፐ አና ማላ፥ ታን መና ጎዳይ ካሰታደ ይሁዳ አሳዉ ጾኑዋ እማና። <verse eid="ZEC 12:7"/><verse number="8" style="v" sid="ZEC 12:8"/>ሄ ጋላስ ኡንቱንቱ ግዶን ዳሮ ላፋ ግያ አስካ ዳዊታ ማላ ምኖ ግዳናዳን፥ ታን መና ጎዳይ የሩሳላመን ደእያዋንቶ ጎንዳለ ግዳና። ዳዊታ ጎለቱካ ጾሳ ማላ፥ ኡንቱንታ ካለያ መና ጎዳ ኪታንቻ ማላ ግዳና። <verse eid="ZEC 12:8"/><verse number="9" style="v" sid="ZEC 12:9"/>ሄ ጋላስ ታን የሩሳላመ ኦላናዉ ደንድያ ካዉተቱዋ ኡባ ይሳናዉ ደንዳና።<verse eid="ZEC 12:9"/></para>
  <para style="s1">ባረንቱ ጫዴዳዎ ዬኬዳ ዬኩዋ</para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 12:10"/>“ታን ዳዊታ ጎለቱዋ ቦላነ የሩሳላመን ደእያ አሳ ቦላ አ ኬካተነ ዎሳ አያና ጉሳና፤ ሄዋ ድራዉ፥ ኡንቱንቱ ባረንቱ ጫዴዳዋ በእያ ዎደ፥ አሳይ ባረ መጽ እት ናአዉ ዬክያዋዳን ዬካና፤ ቃይ ባረ ባይራ ናአዉካ ካዮትያ አሳዳን ካዮታና።<note caller="-" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="JHN 19:37">ዮሃ. 19:37</ref>፤ <ref loc="REV 1:7">ሳፃ 1:7</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">12:10-14 </char><char style="xt" closed="false"><ref loc="MAT 24:30">ማቶሳ 24:30</ref>፤ <ref loc="REV 1:7">ሳፃ 1:7</ref></char></note> <verse eid="ZEC 12:10"/><verse number="11" style="v" sid="ZEC 12:11"/>ሄ ጋላስ የሩሳላመን ዬከትያ ዬኩ ማግዶ ደምባን ሀዳድ-ርሞናስ ዬከቴዳ ዬኩዋ ኬሻ ዎልቃማ ግዳናዋ። <verse eid="ZEC 12:11"/><verse number="12" style="v" sid="ZEC 12:12"/>ቢታን ደእያ እት እት ዛሪ ባረዉ ባረዉ ዬካና፤ ዳዊታ ዛራቱ ባረዉ፥ ኡንቱንቱ ማቼቱካ ባረዉ፥ ናታና ዛራቱ ባረዉ፥ ኡንቱንቱ ማቼቱካ ቃይ ባረዉ ዬካና። <verse eid="ZEC 12:12"/><verse number="13" style="v" sid="ZEC 12:13"/>ቃይካ ሌዊያ ዛራቱ ባረዉ፥ ኡንቱንቱ ማቼቱካ ባረዉ፥ ሽምአ ዛራቱ ባረዉ፥ ኡንቱንቱ ማቼቱካ ባረዉ ዬካና። <verse eid="ZEC 12:13"/><verse number="14" style="v" sid="ZEC 12:14"/>ቃይ አቴዳ ዛሪ ኡባይካ ባረዉ ባረዉ ዬካና፤ ኡንቱንቱ ማቼቱካ ባረዉ ባረዉ ዬካና” ያጌ።<verse eid="ZEC 12:14"/></para>
  <chapter eid="ZEC 12"/>
  <chapter number="13" style="c" sid="ZEC 13"/>
  <para style="s1">ናጋራፐ ጌዩሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 13:1"/>ኡባፐ ዎልቃማ መና ጎዳይ ሀዋዳን ያጌ፤ “ሄ ጋላስ ዳዊታ ጎለቱዋነ የሩሳላመን ደእያዋንታ ናጋራፐነ ቱናተፐ ጌሻናዉ ፑልቱ ፑልታና። <verse eid="ZEC 13:1"/><verse number="2" style="v" sid="ZEC 13:2"/>ሄ ጋላስ ታን ኡንቱንቱ ላኤን ሀሳየተናዳን፥ ኤቃቱዋ ሱን ጋድያፐ ይሳና። ቃይ ትምቢትያ ኦድያዋንታነ ቱና አያና ጋድያፐ ይሳና። ታን ኡባፐ ዎልቃማ መና ጎዳይ ሀዋ ኦዳይ። <verse eid="ZEC 13:2"/><verse number="3" style="v" sid="ZEC 13:3"/>ቃይካ ኦንነ፥ ታን ትምቢትያ ኦድያዋ ጎፐ፥ አ የሌዳ አዉነ አታ አ፥ ‘ኔን መና ጎዳ ሱንን ዎርዱዋ ኦድያ ድራዉ፥ ፓጻ ደአካ’ ያጋና፤ ያጊደ እ ትምቢትያ ኦድሽን፥ አ የሌዳ አዉነ አታ አ ጫዲደ ዎና። <verse eid="ZEC 13:3"/><verse number="4" style="v" sid="ZEC 13:4"/>ሄ ጋላስ ዎርዶ ትምቢትያ ኦድያ ዎደ፥ ባረ በኤዳ ሳፃ ጋሱዋን ዬላታና፤ ቃይ ጭማናዉ እስክያና ደእያ ዋሩዋካ ማየና። <verse eid="ZEC 13:4"/><verse number="5" style="v" sid="ZEC 13:5"/>ሽን እ፥ ‘ታን ናአተደፐካ ዶማደ ቢታ ኦያ ጎሻንቻፐ አትና፥ ትምቢትያ ኦድያዋ ግድከ’ ያጋና። <verse eid="ZEC 13:5"/><verse number="6" style="v" sid="ZEC 13:6"/>እት አሳይ አ፥ ‘ያትና፥ ሀ ነ ቦላን ደእያ ማዱይ አዬ?’ ያጊደ ኦቾፐ፥ እ፥ ‘ሀዌ ታን ታ ላገቱዋ ሶን ማዱጼዳዋ’ ያጋና” ያጌ።<verse eid="ZEC 13:6"/></para>
  <para style="s1">ሄንንቻይ ሾጨቴዳ</para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 13:7"/>ኡባፐ ዎልቃማ ጎዳይ ሀዋዳን ያጌ፤ “ማሻዉ፥ ታዉ ማታ ግድያ ታ ዶርሳ ሄምያዋ ቦላ ቤጎታ! ዶርሳቱ ላለታናዳን፥ ዶርሳ ሄምያዋ ሾጫ። ታንካ ሄ ጉ ዶርሳቱዋ ቦላን ታ ኩሽያ ደንና።<note caller="-" style="x"><char style="xo" closed="false">13:7 </char><char style="xt" closed="false"><ref loc="MAT 26:31">ማቶሳ 26:31</ref>፤ <ref loc="MRK 14:27">ማር. 14:27</ref></char></note> <verse eid="ZEC 13:7"/><verse number="8" style="v" sid="ZEC 13:8"/>ቢታ ኡባን ደእያ ሄዙ ኩሸ አሳፐ ላኡ ኩሺ ሾጨቲደ ሀይቃና፤ እት ኩሸ ጻላላይ ፓጻ አታና። ታን መና ጎዳይ ሀዋ ኦዳይ። <verse eid="ZEC 13:8"/><verse number="9" style="v" sid="ZEC 13:9"/>ሀ አቴዳ ሄዘን ኩሸ አሳ ታን ታማን የጋና፤ ብራይ ታማን ጌይያዋዳን፥ ኡንቱንታ ጌሻና፤ ቃይ ዎርቃይ ፓጨትያዋዳንካ ፓጫና። ሄዋፐ ጉይያን፥ ኡንቱንቱ ታ ሱንን ዎሳና፤ ታንካ ኡንቱንታ ስሳና። ታን፥ ‘ሀዋንቱ ታ አሳቱዋ’ ያጋና። ኡንቱንቱካ፥ ‘መና ጎዳይ ኑ ጾሳ’ ያጋና” ያጌ።<verse eid="ZEC 13:9"/></para>
  <chapter eid="ZEC 13"/>
  <chapter number="14" style="c" sid="ZEC 14"/>
  <para style="s1">የሩሳላሞነ ካዉተቱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 14:1"/>በእተ፥ መና ጎዳ ጋላሳይ ዬ፤ ሄ ዎደ ህንተፐ ቦንቄዳዋ ህንተ ጼልሽን፥ ኡንቱንቱ ሻክ አካና። <verse eid="ZEC 14:1"/><verse number="2" style="v" sid="ZEC 14:2"/>ጾሳይ ካዉተቱዋ ኡባ የሩሳላመ ቦላን ኦላዉ ሺሻና፤ ካታማይ ኦይቀታና፤ ጎለቱካ ቦንቀታናዋ፤ ማጫ አሳናካ አሳይ ዎልቃን ጋከታና። ካታማ አሳፐ ባጋይ ኦሞደቲደ ባና፤ ሽን አቴዳ አሳይ ካታማፐ ከሰና። <verse eid="ZEC 14:2"/><verse number="3" style="v" sid="ZEC 14:3"/>ሄዋፐ ጉይያን መና ጎዳይ ከሲደ፥ ካሰካ ኦላ ጋላስ ኦለትያዋዳን፥ ሄ ካዉተቱዋና ኦለታና። <verse eid="ZEC 14:3"/><verse number="4" style="v" sid="ZEC 14:4"/>ሄ ጋላስ አ ገደቱ የሩሳላመፐ አዋይ ዉልያ ባጋና ደእያ ዳብረ ዛይተ ደርያ ቦላ ኤቃና። ዳብረ ዛይተ ደሪካ አዋይ ዉልያ ባጋፐ አዋይ ዶልያ ባጋ ጋካናዉ፥ ላኡ ከሲደ ጳልቀታና፤ ሎይ አኮ ዎምባይ መታና፤ ያቶፐ ደርያዉ ባጋይ ሁጲሳ ባጋ፥ ቃይ ባጋይካ ገድሳ ባጋ ሸርእ ጋና። <verse eid="ZEC 14:4"/><verse number="5" style="v" sid="ZEC 14:5"/>ሄ ዎምባይ ቢደ አጼላ ጋካና፤ ህንተ ሄ ዎምባና አደ ባቃታና። በን ይሁዳ ካትያ ኦዝያና ላይ ቢታይ ቃጽና፥ ህንተ ማይዛ አዎቱ ባቃቴዳዋዳን፥ ህንተካ ባቃታና። ሄዋፐ ጉይያን፥ መና ጎዳይ ታ ጾሳይ ያና፤ ቃይ ጌሻቱ ኡባይካ አናና እትፐ ያና።<verse eid="ZEC 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 14:6"/>ሄ ጋላስ ሜጉ፥ ሻቻይነ ማይ ደኤና፤ <verse eid="ZEC 14:6"/><verse number="7" style="v" sid="ZEC 14:7"/>ሄ ጋላሳይ ቃምነ ጋላስ ባይና፥ መና ጎዳይ ኤርያ ዱማ ጋላሳ ግዳናዋ፤ ሄ ጋላስ ቃማይካ ፖኦ ግዳናዋ።<verse eid="ZEC 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 14:8"/>ሄ ጋላስ ደኡዋ ሃይ የሩሳላመፐ ጎጋና፤ አፐ ባጋይ ማጽንያ አባን ገላና፤ ቃይ ባጋይ ሜድተራነ አባን ገላና። ሄ ሃይ ባልጉዋን ቦንያን ጎጊደ ደአና።<note caller="-" style="x"><char style="xo" closed="false">14:8 </char><char style="xt" closed="false"><ref loc="EZK 47:1">ህዝ. 47:1</ref>፤ <ref loc="JHN 7:38">ዮሃ. 7:38</ref>፤ <ref loc="REV 22:1">ሳፃ 22:1</ref></char></note> <verse eid="ZEC 14:8"/><verse number="9" style="v" sid="ZEC 14:9"/>ቃይ መና ጎዳይ ሳኣ ኡባ ቦላ ካተታና፤ ሄ ጋላስ እት መና ጎዳ ጻላላይ ደአና፤ አ ሱንይካ መጽ እቱዋ ግዳናዋ።<verse eid="ZEC 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 14:10"/>ገባአፐ ዶሚደ፥ የሩሳላመፐ ገድሳ ባጋና ደእያ ርሞና ግያ ካታማ ጋካናዉ ደእያ ቢታይ ኡባይ ደምባታና። ሽን የሩሳላመ ቢንያማ ፐንግያፐ ቢደ፥ በን ፐንግያ ባጋና ዞዝያ ፐንግያ ጋካናዉነ፥ ቃይ ሀናንኤላ አዱሳ ግምቢያፐ ቢደ፥ ካትያ ዎይንያ ጉምኢያሳ ጋካናዉ፥ ባረ ሳኣን ቁ ጊደ ደአና። <verse eid="ZEC 14:10"/><verse number="11" style="v" sid="ZEC 14:11"/>የሩሳላመ፥ አሳይ ደኢያሳ ግዳና፤ ሄዋፐ ጉይያን እዛ ዩኩ፤ እዝን ደእያ አሳይካ ህርግ ባይናን ሳሮ ደአና።<note caller="-" style="x"><char style="xo" closed="false">14:11 </char><char style="xt" closed="false"><ref loc="REV 22:3">ሳፃ 22:3</ref></char></note><verse eid="ZEC 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ZEC 14:12"/>መና ጎዳይ የሩሳላመና ኦለቴዳ አሳ ኡባ ሾጫና ቦሻይ ሀዋ: ኡንቱንቱ ኤቁዋን ደእሽን፥ ኡንቱንቱ አሹ ዎቃና፤ ኡንቱንቱ አይፊ ጮጭያን፥ ኡንቱንቱ እንጻርሳይካ ኡንቱንቱ ኮክያን ዎቃና። <verse eid="ZEC 14:12"/><verse number="13" style="v" sid="ZEC 14:13"/>ሄ ጋላስ መና ጎዳይ ኡንቱንቱ ዎልቃማ ዳጋማ ዳጋንና፤ አሳይ ኡባይ እቱ እቱዋ ኩሽያ ኦይቂደ፥ እቱ እቱዋና ኦለታና። <verse eid="ZEC 14:13"/><verse number="14" style="v" sid="ZEC 14:14"/>ይሁዳ አሳይ የሩሳላመ ባጋ ግዲደ ኦለታና። ቃይ ዩሹዋን ደእያ ካዉተቱዋ ኡባቱዋ አቁዋ፥ ዎርቃ፥ ብራነ ማዩዋ ፓይዱ ባይናዋ ኦሞዲደ ሺሻና። <verse eid="ZEC 14:14"/><verse number="15" style="v" sid="ZEC 14:15"/>ሀ ቦሻ ማላ ቦሻይ ፓራቱዋ ቦላ፥ ባቁሎቱዋ ቦላ፥ ጋሎቱዋ ቦላ፥ ሀረቱዋ ቦላነ ሞርከቱ ዱንካኔዳሳን ደእያ መህያ ኡባ ቦላ ያና።<verse eid="ZEC 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ZEC 14:16"/>ሄዋፐ ጉይያን፥ የሩሳላመና ኦለቴዳ ካዉተቱዋ ኡባፐ ፓጻ አቴዳ ኡባይ ካትያዉ፥ ኡባፐ ዎልቃማ መና ጎዳዉ ጎይናናዉነ ዳስያ ባኣላ ቦንቻናዉ ላይን ላይን የሩሳላመ ባና።<note caller="-" style="x"><char style="xo" closed="false">14:16 </char><char style="xt" closed="false"><ref loc="LEV 23:39-43">ዎጋ 23:39-43</ref></char></note> <verse eid="ZEC 14:16"/><verse number="17" style="v" sid="ZEC 14:17"/>ቃይ ሀ ሳኣን ደእያ አሳፐ ኦንነ ካትያዉ፥ ኡባፐ ዎልቃማ መና ጎዳዉ ጎይናናዉ የሩሳላመ ቤናን ዮፐ፥ ሄ አሳዉ እራይ ቡከና። <verse eid="ZEC 14:17"/><verse number="18" style="v" sid="ZEC 14:18"/>ግብጼ ቢታ አሳይካ ቢደ ጎይነናን እጾፐ እራይ ቡከና፥ ዳስያ ባላ ቦንቻናዉ ቤናን እጽያ አሳ መና ጎዳይ ሾጭያ ቦሻይ ኡንቱንቱ ቦላንካ ያና። <verse eid="ZEC 14:18"/><verse number="19" style="v" sid="ZEC 14:19"/>ዳስያ ባላ ቦንቻናዉ ቤናን እጽያ ግብጼነ ሀራ ካዉተቱ ኡባይ ሙረታና ሙሩ ሀዋ ግዳናዋ።<verse eid="ZEC 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ZEC 14:20"/>ሄ ጋላስ ፓራቱዋ ቆያን አያ ዳላቱዋ ቦላንካ፥ “መና ጎዳዉ ጌዬዳዋ” ጌተቲደ ጻፈታና። መና ጎዳ ጌሻ ጎልያን ደእያ ካያ ኦቶቱካ ያርሽያ ሳኣ ስንን ደእያ ጌሻ ከረቱዋ ማላ ግዳናዋ። <verse eid="ZEC 14:20"/><verse number="21" style="v" sid="ZEC 14:21"/>የሩሳላመንነ ይሁዳን ደእያ ኦቶ ኡባይ ኡባፐ ዎልቃማ መና ጎዳዉ ጌሻ ግዳናዋ፤ ያቶፐ ያርሹዋ ያርሽያ አሳይ ኡባይ ዪደ፥ ሄ ኦቶቱዋ አኪደ፥ ያርሹዋ አሹዋ ኡንቱንቱን ካና። ሄ ጋላስ ኡባፐ ዎልቃማ መና ጎዳ ጌሻ ጎልያ ግዶን አይ ዛልአንቻይነ ደኤና።<verse eid="ZEC 14:21"/></para>
  <chapter eid="ZEC 14"/>
</usx>
