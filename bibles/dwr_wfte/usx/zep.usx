<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ZEP" style="id">- Dawuro Full Bible Ethiopic Version</book>
  <para style="h">ሶፎናሳ</para>
  <para style="toc1">ሶፎናሳ ትምቢትያ</para>
  <para style="toc2">ሶፎናሳ</para>
  <para style="toc3">ሶፎ.</para>
  <para style="mt1">ሶፎናሳ ትምቢትያ</para>
  <para style="imt">ገሉዋ</para>
  <para style="ip">ትምቢትያ ኦድያ ሶፎናስ ባረ ኪታ አዳዌ ክርስቶሳ የለታፐ ካሰ ላፑን ጼቱ ላይዉ ላኤን ሻኩዋና ግድሽን፥ ሄዌ እዮስያስ ክርስቶሳ የለታፐ ካሰ፥ ኡሱፑን ጼታነ ላታማነ እት ላይን፥ አማኑዋ ዎጋ ኦራናፐ ታሙ ላይ ካሰቲደ ግደናን አገና። ማጻፋይ ካሴደፐ አሳይ ስስ ሜዘቴዳ ትምቢትያ ሃሳዩሳ ኦይቄዳ። ሄዋንቱካ ሀቃዋንቴ ጎፐ፥ ይሁዳይ አላጋ ጾሳቶ ጎይኔዳ ጋሱዋን ሙረትያ ዎደ፥ እ ባያናዋነ ዶማናዋ በስያዋንታ። ቃይ ጾሳይ ሄ ዎደ ሀራ አሳካ ጉጂደ ሙራና። የሩሳላመ ላልያ ዳባን ጋከቶፐነ፥ ዎድያፐ ካታማይ ኦራጺድ፥ በን ባረ ሳኣ ስማና፤ አሽከቱነ ጽሎተ ካልያ አሳቱ አን ደአና።</para>
  <para style="iot">ሸምፓቱዋ ኡባቶ እመቴዳ ቃን ቆፋቱዋ</para>
  <para style="io1">1. ይሁዳ ቦላ አያ ፕርዳ <char style="ior"><ref loc="ZEP 1:1-18">1:1-18</ref></char></para>
  <para style="io1">2. ናጋራ ፓጹሳ <char style="ior"><ref loc="ZEP 2:1-3">2:1-3</ref></char></para>
  <para style="io1">3. እስራኤልያ ዩሹዋን ደእያ ካዉተቱዋ ኩንደ <char style="ior"><ref loc="ZEP 2:4-15">2:4-15</ref></char></para>
  <para style="io1">4. ይሁዳይነ ሀራ አሳቱ ጎዳኮ ስሙሳ <char style="ior"><ref loc="ZEP 3:1-20">3:1-20</ref></char></para>
  <chapter number="1" style="c" sid="ZEP 1"/>
  <para style="s1">ይሁዳ ቦላ አያ ፕርዳ</para>
  <para style="r">(<ref loc="ZEP 1:1-18">1:1-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1"/>አሞና ናአይ እዮስያስ ይሁዳን ካተቴዳ ዎደ ሶፎናሳኮ ዬዳ መና ጎዳ ቃላይ ሀዋ። ሶፎናስ ኩሻ ናኣ፤ ኩሽ ጋዳልያ ናኣ፤ ጋዳሊ አማርያ ናኣ፤ አማር ካትያ ህዝቂያሳ ናኣ።<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2KI 22:1-23:30">2 ካታ. 22:1—23:30</ref>፤ <ref loc="2CH 34:1-35:27">2 ኦዱዋ 34:1—35:27</ref></char></note><verse eid="ZEP 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ZEP 1:2"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ታን ጋድያ ቦላን ደእያዋ ኡባ ሙልጹ ኦደ ይሳና። <verse eid="ZEP 1:2"/><verse number="3" style="v" sid="ZEP 1:3"/>ታን አሳነ መህያ፥ ሳሉዋ ካፎቱዋነ አባ ሞለቱዋካ ይሳና። ቃይ ታን ኢታ አሳቱዋ አ የጋና፤ አሳ ዛርያካ ቢታ ቦላፐ ይሳና” ያጌ መና ጎዳይ።<verse eid="ZEP 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ZEP 1:4"/>ቃይካ ጾሳይ ሀዋዳን ያጌ፤ “ታን ይሁዳንነ የሩሳላመን ደእያ ኡባ ሙራናዉ ታ ኩሽያ ደንና፤ ባኣላ ግያ ኤቃዉ ጎይንያ አቴዳዋንታነ አዉ ኦያ ቄሳቱ ዋ ሄ ሳኣፐ ሙልጹ ኦደ ይሳና። <verse eid="ZEP 1:4"/><verse number="5" style="v" sid="ZEP 1:5"/>ጎልያ ሁጲያ ደምባዪደ ኦድኖ፤ ሄዋ ቦላ ከሲደ፥ አዋዉ፥ አግናስነ ጾልንተቶ ጎይንያዋንታ ታን ይሳና። መና ጎዳዉ ጎይኒድነ አ ሱንን ጫቂደ፥ ቃይ ሞሎካ ግያ ኤቃ ሱንን ጫቂያዋንታ ታን ይሳና። <verse eid="ZEP 1:5"/><verse number="6" style="v" sid="ZEP 1:6"/>መና ጎዳ ካልያዋ አጊደ ጉየ ስሜዳዋንታ፥ መና ጎዳ ኮይቤናዋንታነ ኡንቱንታ ካለናዳን ኦችቤናዋንታካ ታን ይሳና” ያጌ።<verse eid="ZEP 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEP 1:7"/>መና ጎዳ ጋላሳይ ማቴዳ ድራዉ፥ ኡባ ሞድያ መና ጎዳ ስንን ጮኡ ጊተ! መና ጎዳይ ባረ አሳ ያርሾ ጊጌዳ መህያዳን አ እማናዉ ጊግሴዳ፤ ቃይ ይሁዳ ቦንቂያ ሞርከቱዋካ ዱማዪደ ጊግሴዳ።<verse eid="ZEP 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEP 1:8"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ታ አሳ አ እምያ ጋላስ ካፓቱዋ፥ ካትያ ናናቱዋነ አላጋ ቢታ ዎጋ ካልያዋንታ ኡባቱዋ ታን ሙራና። <verse eid="ZEP 1:8"/><verse number="9" style="v" sid="ZEP 1:9"/>ሄ ጋላስ አላጋ ቢታ አሳቱዋዳን፥ ኤቃዉ ጎይንያዋንታነ ባረንቱ ጎዳ ጎልያ ማካላንነ ጭሙዋን ኩንያዋንታ ታን ሙራና” ያጌ።<verse eid="ZEP 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEP 1:10"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ሄ ጋላስ የሩሳላመ ድርሳን ሞልያ ፐንግያ ማታን ደእያ ኦራ ካታማ ሻኩዋን ዋሱነ ዬኩ ስሰታና፥ ዞዘቱዋ ቦላንካ ቁ ጌዳ ዶምኤ ኮሻይ ጊሩማና። <verse eid="ZEP 1:10"/><verse number="11" style="v" sid="ZEP 1:11"/>ህንተኖ፥ ካታማዉ ህርክ ባጋና ደእያዋንቶ፥ ዬክተ፤ አያዉ ጎፐ፥ ሄዋን ዛልእያ ኡባቱ ዬድኖ፤ አሌቆ ሀንያ ብራ ዛልእያዋንቱካ ሀይቂ ዉሬድኖ። <verse eid="ZEP 1:11"/><verse number="12" style="v" sid="ZEP 1:12"/>ሄ ጋላስ ታን የሩሳላመ ግዱዋ ጾምፕያን ኮያና፤ ህርግ ባይናን ዎፑ ግ ኡቲደ፥ ባረንቱ ዎዛናን፥ ‘መና ጎዳይ ሎኦባነ ኦና፤ ኢታባነ ኦና’ ያግያዋንታ ታን ሙራና። <verse eid="ZEP 1:12"/><verse number="13" style="v" sid="ZEP 1:13"/>ኡንቱንቱ ማጹ ቦንቀታናዋ፤ ኡንቱንቱ ጎሊካ ኮለታና። ኡንቱንቱ ጎልያ ኬጻና፥ ሽን ሄ ጎልያን ደእክኖ፤ ቃይ ዎይንያ ቱራቱዋካ ቶካና፥ ሽን ሄ ዎይንያ ኤሳ ኡሽክኖ” ያጌ።<verse eid="ZEP 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ZEP 1:14"/>መና ጎዳ ዎልቃማ ጋላሳይ ማቴዳ፤ ቃይ ሎይ ኤሌሊደ ዬ። መና ጎዳ ጋላሳይ ጫሞ ጋላሳ። ሄ ጋላስ ምኖ ኦላንቻቱካ ዋሱዋ ጹልሳና። <verse eid="ZEP 1:14"/><verse number="15" style="v" sid="ZEP 1:15"/>ሄ ጋላሳይ ሀንቁዋ ጋላሳ፥ መቶነ ኡንኦ ጋላሳ፥ ባሻነ ኮለ ጋላሳ፥ ማነ ሻኖቻ ጋላሳነ ሻርያነ ባራ ማ ጋላሳ ግዳናዋ። <verse eid="ZEP 1:15"/><verse number="16" style="v" sid="ZEP 1:16"/>ሄ ጋላሳይ ዩሹዋ ድረቴዳ ካታማቱዋ ቦላነ አዱሳ ግምበቱዋ ቦላ ኦላ ማላካታይ ፑነትያ ጋላሳነ ኦላንቻቱ ኦላ ኮሻይ ስሰትያ ጋላሳ ግዳናዋ።<verse eid="ZEP 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ZEP 1:17"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ኡንቱንቱ ጾሳ ናቄዳ ድራዉ፥ ቆቅያዳን ታታፋና ጋካናዉ፥ አሳቱዋ ቦላን ታን መቱዋ አሀና። ኡንቱንቱ ሱይ ድኡዋዳን ጎጋና፤ ኡንቱንቱ አሃይ ፕቱዋዳን ኦለታና። <verse eid="ZEP 1:17"/><verse number="18" style="v" sid="ZEP 1:18"/>መና ጎዳ ሀንቁዋ ጋላስ ኡንቱንቱ ብራ ግድና፥ ኡንቱንቱ ዎርቃይካ ኡንቱንታ አሻናዉ ዳንዳየና። እ ሳኣን ደእያ ኡባ አኬከናን ደእሽን፥ ዉርስ ይሳና፤ ቢታ ኡባይካ አ ሀንቁዋ ታማን ሜተታና” ያጌ።<verse eid="ZEP 1:18"/></para>
  <chapter eid="ZEP 1"/>
  <chapter number="2" style="c" sid="ZEP 2"/>
  <para style="s1">ናጋራ ፓጹሳ</para>
  <para style="r">(<ref loc="ZEP 2:1-3">2:1-3</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 2:1"/>ህንተኖ፥ ዬላይ ባይና አሳቶ፥ አነ እትፐ ሺቅተ፤ <verse eid="ZEP 2:1"/><verse number="2" style="v" sid="ZEP 2:2"/>ጫርኩ ፑኒደ አፍያ ሱላዳን ቤናን ደኢደ፥ ያሽያ መና ጎዳ ሀንቁ ህንተ ቦላ ዎናን ደእሽን፥ መና ጎዳ ሀንቁዋ ሱሉዋ ጋላሳይካ ህንተ ቦላን ጋከናን ደእሽን፥ መና ጎዳኮ ስምተ። <verse eid="ZEP 2:2"/><verse number="3" style="v" sid="ZEP 2:3"/>ህንተኖ፥ ጋድያን ደእያ አሽከቶነ አ አዛዙዋ ኦያ ኡባ ገደ፥ መና ጎዳ ኮይተ፤ ጽሎተ ኮይተ፤ ቃይ አሽከተካ ኮይተ። ያቶፐ፥ ኦን ኤሪ፥ መና ጎዳ ሀንቁዋ ጋላስ ህንተና ቆሲደ አሻነንቶነ።<verse eid="ZEP 2:3"/></para>
  <para style="s1">እስራኤልያ ዩሹዋን ደእያ ካዉተቱዋ ኩንደ</para>
  <para style="r">(<ref loc="ZEP 2:4-15">2:4-15</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="ZEP 2:4"/>ጋዛ ካታማይ ኦናና፤ አስቃሎና ካታማይካ መላ ግዳናዋ፤ አሽዶዳ ካታማ አሳይ ሴታ ጋላስ ጎደታና፤ ኤቅሮና ካታማይካ ቆለታናዋ።<note caller="-" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">ኢሳ. 14:29-31</ref>፤ <ref loc="JER 47:1-7">ኤር. 47:1-7</ref>፤ <ref loc="EZK 25:15-17">ህዝ. 25:15-17</ref>፤ <ref loc="JOL 3:4-8">ኢዩ. 3:4-8</ref>፤ <ref loc="AMO 1:6-8">አሞጻ 1:6-8</ref>፤ <ref loc="ZEC 9:5-7">ዛካ. 9:5-7</ref></char></note> <verse eid="ZEP 2:4"/><verse number="5" style="v" sid="ZEP 2:5"/>ህንተኖ፥ አባ ዶናን ደእያ ፕልስጼማ አሳቶ፥ ህንተንቶ አየ አና! ኔኖ፥ ፕልስጼማቱ ደእያ ካናነ ቢታዉ፥ መና ጎዳ ፕርዳይ ነ ቦላን ዬ። ታን ኔና ይሳና፤ ኔናን እት አሳይነ አተና። <verse eid="ZEP 2:5"/><verse number="6" style="v" sid="ZEP 2:6"/>አባ ዶናን ደእያ ህንተ ቢታይ መህያ ሄምያ ሳ፥ ሄንንቻቱ ደኢያሳነ መህያ ዉድያ ባሉዋ ግዳናዋ። <verse eid="ZEP 2:6"/><verse number="7" style="v" sid="ZEP 2:7"/>አባ ዶናይ ይሁዳ አሳፐ አቴዳዋንቶ ላታ ግዳናዋ፤ ሄዋን ኡንቱንቱ ሄመታና። ሳአይ ቃምያ ዎደ ኡንቱንቱ አስቃሎና ካታማን ደእያ ጎለቱዋን አቃና፤ አያዉ ጎፐ፥ መና ጎዳይ ኡንቱንቱ ጾሳይ ኡንቱንቱዋ ቆፓና፤ እ ኡንቱንታ ዛሪደ እሻልሳና።<verse eid="ZEP 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEP 2:8"/>ኡባፐ ዎልቃማ መና ጎዳይ፥ እስራኤልያ ጾሳይ፥ ሀዋዳን ያጌ፤ “ታን ሞኣባ አሳ ቅሊጩዋነ አሞና አሳ ቦርያ ስሳድ። ኡንቱንቱ ታ አሳ ቅሊጬድኖ፤ ኡንቱንቱ ቢታ ቦላንካ ኦቶረቴድኖ።<note caller="-" style="x"><char style="xo" closed="false">2:8-11 </char><char style="xt" closed="false"><ref loc="ISA 15:1-16:14">ኢሳ. 15:1—16:14</ref>፤ <ref loc="ISA 25:10-12">25:10-12</ref>፤ <ref loc="JER 48:1-49:6">ኤር. 48:1—49:6</ref>፤ <ref loc="EZK 21:28-32">ህዝ. 21:28-32</ref>፤ <ref loc="EZK 25:1-11">25:1-11</ref>፤ <ref loc="AMO 1:13-15">አሞጻ 1:13-15</ref></char></note> <verse eid="ZEP 2:8"/><verse number="9" style="v" sid="ZEP 2:9"/>ሄዋ ድራዉ፥ ታ ደኡዋ ሱንን ጫቃይ፥ ሞኣበ ሶዶማዳን ሀናና፤ አሞና አሳይካ ጋሞራ አሳዳን ሀናና። ኡንቱንቱ መናዉ ማጽንያ ቦክያ ኦላነ አጉንይ ማዬዳ ባዙዋ ግዳናዋ። ታ አሳፐ አቴዳዋንቱ ኡንቱንቱ ዱሬታ ቦንቃናዋንታ፤ ኡንቱንቱ ቢታካ ላታናዋንታ” ያጌ።<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="GEN 19:24">ዶመ 19:24</ref></char></note><verse eid="ZEP 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEP 2:10"/>አሞናነ ሞኣበ አሳይ ኡባፐ ዎልቃማ መና ጎዳ አሳ ቦላ ቅሊጪድነ ኦቶረቲደ ሃሳዬዳ ድራዉ፥ ኡንቱንቱ ቦላ ሀ መቱ ጋካናዋ። <verse eid="ZEP 2:10"/><verse number="11" style="v" sid="ZEP 2:11"/>መና ጎዳይ ኡንቱንቱን ያየቴዳዋ ግዳናዋ፤ ቢታን ደእያ ጾሳቱዋ ኡባ እ ይሳና፤ ቃይ ሳኣን ደእያ ካዉተቱዋን ደእያ አሳይ ኡባይ ባረ ደእያ ሳን ደእያ ሳን አዉ ጎይናና።<verse eid="ZEP 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ZEP 2:12"/>ህንተኖ፥ ቶጵያ አሳቶ፥ ህንተካ ታ ማሻን ሀይቃና።<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="ISA 18:1-7">ኢሳ. 18:1-7</ref></char></note><verse eid="ZEP 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ZEP 2:13"/>መና ጎዳይ ባረ ኩሽያ ሁጲሳ ባጋ ዛሪደ የዳና፤ አሶረ ቢታ ይሳና። ቃይ ናናዌ ካታማካ መላ ባዙዋዳን፥ መላ ሳኣ ኦና።<note caller="-" style="x"><char style="xo" closed="false">2:13-15 </char><char style="xt" closed="false"><ref loc="ISA 10:5-34">ኢሳ. 10:5-34</ref>፤ <ref loc="ISA 14:24-27">14:24-27</ref>፤ <ref loc="NEH 1:1-3:19">ናህ. 1:1—3:19</ref></char></note> <verse eid="ZEP 2:13"/><verse number="14" style="v" sid="ZEP 2:14"/>ዉዲነ ዶአቱ ኡባይ አ ግዶን አላጻና፤ ጉቱነ ቁጻርሳይ አ ኮለቴዳ ግምበቱዋ ግዶን ደአና፤ ኡንቱንቱ ኮሻይ ማስኮትያናነ ፐንግያና ስሰታና። ጎለቱ ኬጸቴዳ ዝጋይ ካሎታና። <verse eid="ZEP 2:14"/><verse number="15" style="v" sid="ZEP 2:15"/>ሀ ካታማይ፥ “ታና! ታፐ አትና፥ ሀራይ ባዋ” ያጊደ ኦቶረቲደ ደኤዳዋ፤ ሽን እ ሀእ ዶአቱ ጌሱ መላ ሳኣ ግዴዳ። አ ምይያና አያ ኡባይ ዳሮፐ ማላለቲደ፥ ባረንቱ ኩሽያ ጾርሲደ፥ “ባርቼ!” ጋና።<verse eid="ZEP 2:15"/></para>
  <chapter eid="ZEP 2"/>
  <chapter number="3" style="c" sid="ZEP 3"/>
  <para style="s1">ይሁዳይነ ሀራ አሳቱ ጎዳኮ ስሙሳ</para>
  <para style="r">(<ref loc="ZEP 3:1-20">3:1-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 3:1"/>ማካላንቻትዉ፥ ቱኔዳንዉነ ባረ አሳ ቱጋዬዳ የሩሳላመ ካታማትዉ አየ አና! <verse eid="ZEP 3:1"/><verse number="2" style="v" sid="ZEP 3:2"/>እዛ ኦናነ ስሱኩ፤ ሴርና ስሙኩ፤ መና ጎዳን አማነቱኩ፤ ባረ ጾሳኮካ ሺቁኩ። <verse eid="ZEP 3:2"/><verse number="3" style="v" sid="ZEP 3:3"/>እዝ ግዶን ደእያ ካፓቱ ጉድያ ጋሞቱዋ ማላ፤ ዳናቱካ ዎንትዉ አሸናን ደሜዳዋ ኡባ ዉርስ ም ድግያ ኦማርሳ ዋንግሬሎቱዋ ማላ። <verse eid="ZEP 3:3"/><verse number="4" style="v" sid="ZEP 3:4"/>እዝን ናባቱ ኦቶራንቻነ ገናንቻ። እዝ ቄሳቱ ካ ጌሻባ ቱንስያዋንታ፤ ቃይ ኡንቱንቱ ጾሳ ህግያ ባረንቶ እንጀትያዋዳን፥ ምርቂደ ብሊኖ። <verse eid="ZEP 3:4"/><verse number="5" style="v" sid="ZEP 3:5"/>ሽን እዝ ግዶን ደእያ መና ጎዳይ ጽሉዋ፤ እ ባላባ ኦና፤ ዎንትና ዎንትናካ እ ባረ ጽሎ ፕርዳ ፕርዴ፤ አይ ዎንታንካ አግ ኤረና። ግዶፐነ፥ እዝን ደእያ ማካላንቻይ አይነ ዬላ ኤረና።<verse eid="ZEP 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEP 3:6"/>ጾሳይ ሀዋዳን ያጌ፤ “ታን ካዉተቱዋ ይሳድ፤ ኡንቱንቱ ግምበቴዳ ሳአቱካ ኮለት ክቼድኖ። ኡንቱንቱ ካታማቱዋ እት አሳይነ ደኤና ኦና ቢታ ኦድ፤ ኦገቱካ ኦንነ ሄዋና አናዋ ግዴድኖ። <verse eid="ZEP 3:6"/><verse number="7" style="v" sid="ZEP 3:7"/>ታን ሀዋ ኡባ የሩሳላመዉ ኦደ፥ ‘ስም ታ አሳይ ታና ቦንቻና፤ ታን ሴርያ ሴራካ አካና፤ ታን አዛዜዳዋካ ዶገና’ ያጋድ። ሽን ኡንቱንቱ ካሰዋፐካ ያ ያ ባረንቱ ኦሱዋን ቱኒደ ቤድኖ” ያጌ።<verse eid="ZEP 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEP 3:8"/>መና ጎዳይ ሀዋዳን ያጌ፥ “አነ ታን ፕርድያ ጋላሳይ ጋካናዉ፥ ታክ ጊተ። አያዉ ጎፐ፥ ታን አሳቱዋነ ካዉተቱዋ ሺሻናዉ ቃቻድ፤ ሺሻደ ታ ሀንቁዋ ሱሉዋ ኡንቱንቱ ቦላ ጉሳና። ሳአይ ሙለናካ ታ ሀንቁዋ ታማን ጹገታና።<verse eid="ZEP 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ZEP 3:9"/>“ሄ ዎደ ታን አሳ ኡባይ ጌሻ ሃሳያ ሃሳያና ማላ ኦና፤ ያትና፥ ኡንቱንቱ ኡባይካ መና ጎዳ ሱን ጼጋናነ እትፐ አዉ ኦና። <verse eid="ZEP 3:9"/><verse number="10" style="v" sid="ZEP 3:10"/>ላለቴዳ ታ አሳቱ፥ ታዉ ቱሙ ጎይንያዋንቱ ቶጵያ ሻፋቱዋፐ ሄፍን ባጋፐ ታዉ እሞታ አሀና። <verse eid="ZEP 3:10"/><verse number="11" style="v" sid="ZEP 3:11"/>ሄ ዎደ ህንተ ታ ቦላ ማካሊደ ኦዳ ኦሶቱዋ ጋሱዋን ዬላትክታ፤ አያዉ ጎፐ፥ ኦቶረትያነ አይያዋንታ ታን ህንተ ግዶፐ ድጋ ድጋና። ቃይ ህንተካ ሀዋፐ ስንን ታ ጌሻ ደርያን ኦቶረትክታ። <verse eid="ZEP 3:11"/><verse number="12" style="v" sid="ZEP 3:12"/>ታን ህንተ ግዶፐ ባረንቱ ሁጲያ ካዉሽያዋንታነ ዝቂ ኦያ አሳቱዋ አሻና፤ ኡንቱንቱካ መና ጎዳ ሱንን አማነትያዋንታነ ታፐ ማዱዋ ኮይያዋንታ ግዳና። <verse eid="ZEP 3:12"/><verse number="13" style="v" sid="ZEP 3:13"/>እስራኤልያ አሳፐ አቴዳዋንቱ ኦ ቦላነ ኢታባ ኦክኖ፤ ዎርዱዋ ሃሳይክኖ፤ ኡንቱንቱ እንጻርሳንካ ጭሙ ቤተና። ሄዋ ግሻዉ፥ ኡንቱንቱ ሄመታናነ አላጻና፤ ኡንቱንታ ያሽስያባይካ ደኤና” ያጌ።<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="REV 14:5">ሳፃ 14:5</ref></char></note><verse eid="ZEP 3:13"/></para>
  <para style="s1">ናሸቻ የ</para>
  <para style="p">
    <verse number="14" style="v" sid="ZEP 3:14"/>ጽዮነ ናቴ፥ ማዛሙርያ የጻ! እስራኤልያ አሳዉ፥ እልልተ! የሩሳላመ ናቴ፥ ነ ፖሎ ዎዛናፐ ናሸታ፤ ሀሹካ ጋ! <verse eid="ZEP 3:14"/><verse number="15" style="v" sid="ZEP 3:15"/>መና ጎዳይ ህንተ ቦላ ፕርዴዳ ፕርዳ አጌዳ፤ ህንተ ሞርከቱዋካ ድጌዳ። መና ጎዳይ፥ እስራኤልያ ካቲ፥ ህንተ ግዶን ደኤ፤ ሀዋፐ ስንናዉ ህንተና ያሽስያዌ ባዋ። <verse eid="ZEP 3:15"/><verse number="16" style="v" sid="ZEP 3:16"/>ሄ ጋላስ የሩሳላመባይ ሀዋዳን ያገታና፤ “ጽዮኔ፥ ያዮፓ! ነ ኩሸቱካ አርጋጮፕኖ። <verse eid="ZEP 3:16"/><verse number="17" style="v" sid="ZEP 3:17"/>መና ጎዳይ ነ ጾሳይ ነ ግዶን ደኤ፤ እ ነዉ ጾኑዋ እምያ ኦላንቻ። እ ኔናን ናሸታና፤ እ ባረ ሲቁዋን ኔና ኦራጽሳና፤ አሳይ ባላ ጋላስ የጽያዋዳን፥ እ ኔናን ናሸቴዳዋ ማዛሙርያ የጺደ በሳና” ያጋና።<verse eid="ZEP 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ZEP 3:18"/>ጾሳይ ሀዋዳን ያጌ፤ “ሀዋፐ ስንናዉ ነ ቦላ ባሻይ ጋከናዳን ታን ኦና፤ ነ ዬላካ ቁጫና። <verse eid="ZEP 3:18"/><verse number="19" style="v" sid="ZEP 3:19"/>በአ፥ ሄ ዎደ ታን ኔና ኡቁኔዳዋንታ ኡባ ሙራና። ታን ዎባቱዋ አሻና፤ ላለቴዳዋንታካ ሺሻና። ታን ኡንቱንቱ ካዉሻ ቦንቾ ላማና፤ ያቶፐ ሳኣን ደእያ አሳ ኡባ ማታን ኡንቱንቱ ሱንይ ኤረቴዳዋ ግዳናዋ። <verse eid="ZEP 3:19"/><verse number="20" style="v" sid="ZEP 3:20"/>ሄ ዎደ ታን ህንተና ሺሻና፤ ታን ህንተና እትፐ ሺሻደ ዛራና፤ ያታደ ታን ህንተ አይፊ በእሽን ህንተና እሻልስያ ዎደ፥ ህንተ ሀ ሳኣን ደእያ አሳ ኡባ ማታን ቦንቼቴዳዋንታነ ኤረቴዳዋንታ ግዳንታ” ያጌ መና ጎዳይ።<verse eid="ZEP 3:20"/></para>
  <chapter eid="ZEP 3"/>
</usx>
