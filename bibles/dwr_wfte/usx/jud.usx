<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JUD" style="id">- Dawuro Full Bible Ethiopic Version</book>
  <para style="h">ይሁዳ ኪታ</para>
  <para style="toc1">ይሁዳይ ጻፌዳ ኪታ</para>
  <para style="toc2">ይሁዳ ኪታ</para>
  <para style="toc3">ይሁዳ</para>
  <para style="mt1">ይሁዳይ</para>
  <para style="mt2">ጻፌዳ ኪታ</para>
  <para style="imt">ገሉዋ</para>
  <para style="ip">ይሁዳ ኪታይ ጻፈቴዳዌ፥ አማነናን ደኢደ አማንያ አሳ ማላቲደ፥ ዎርዶ ትምርትያ ላልያ አሳቱዋፐ አማንያ አሳይ ናገታና ማላ፥ ኦዳናሳ። ሀ ቃን ኪታይ ባረ ግዶን ኦይቄዳዋን ላኤን ጰጽሮሳ ማላቴ። ጻፊ ናባብያዋንቶ ኦዲደ፥ “ላኤና ሀኖታን ጾሳይ ባረ ናናቶ እት ካላካ እሜዳ አማኖ ምኒደ ባጸታናዳን” ምንሲደ ቆፍሴ።</para>
  <para style="iot">ሸምፓቱዋ ኡባቶ እመቴዳ ቃን ቆፋቱዋ</para>
  <para style="io1">ገሉዋ <char style="ior"><ref loc="JUD 1:1-2">1-2</ref></char></para>
  <para style="io1">ዎርዶ አስታማራቱዋ ትምርትያ ኤሻነ ኩንደ <char style="ior"><ref loc="JUD 1:3-16">3-16</ref></char></para>
  <para style="io1">አማኑዋ ናጋናዳን እመቴዳ ዞርያ <char style="ior"><ref loc="JUD 1:17-23">17-23</ref></char></para>
  <para style="io1">ዉርሰ አንጁዋ <char style="ior"><ref loc="JUD 1:24-25">24-25</ref></char></para>
  <chapter number="1" style="c" sid="JUD 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1"/>ታን የሱስ ክርስቶሳ ቆማይ ይሁዳይ፥ ያቆባ እሻይ፥ ጾሳይ ጼሴዳዋንቶ፥ ጾሳይ አዉ ሲቅያዋንቶ፥ ቃይ የሱስ ክርስቶስ ናግያዋንቶ፥ ሀ ዳብዳቢያ ጻፋይ።<verse eid="JUD 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JUD 1:2"/>ማሮተይ፥ ሳሮተይነ ሲቆተይ ህንተናን ኩሞ።<verse eid="JUD 1:2"/></para>
  <para style="s1">ዎርዶ አስታማራቱዋ</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3"/>ታ ሲቃቶ፥ ኑን እትፐ ሻክ አካና አቶተባ ህንተንቶ ጻፋናዉ ታን ዳሮ ዳቡርያ ዎደ፥ ጾሳይ ባረ ናናቶ ላኤናን እት ገደ እሜዳ አማኖ ህንተ ባጸታና ማላ፥ ህንተና ዞራደ ጻፋናዉ ኮሽያዋ አኬካድ። <verse eid="JUD 1:3"/><verse number="4" style="v" sid="JUD 1:4"/>አያዉ ጎፐ፥ ጾሳ ኤረና እት እት አሳቱ ኦንነ በኤናን ህንተ ግዶ ገሌድኖ። ሄዋንቱ ኑ ጾሳ አ ኬካተባ ኦድያ ኪታ ኢታ ቱናተዉ ጌላይ ታማርሲኖ፤ ኡንቱንቱ ኑ እት ካትያ፥ ኑ ጎዳ የሱስ ክርስቶሳ ኤሮኮ ያጊኖ፤ ቃይ ኡንቱንቱ ፕርዳ አካናዋ ጾሳ ማጻፋቱ ዳሮ ዎድያፐ ካሰ ኦዴድኖ።<verse eid="JUD 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5"/>ሽን ህንተ ሀ ኡባባ ኤርያዋ ግዶፐካ፥ ጎዳይ እስራኤልያ አሳ ግብጼ ጋድያፐ ዎት አሼደንቶነ ቃይ አማንቤናዋንታ ጉየፐ ዎት ይሴደንቶ፥ ታን ህንተና ሀሳይሳናዉ ኮያይ።<note caller="-" style="x"><char style="xo" closed="false">5 </char><char style="xt" closed="false"><ref loc="EXO 12:51">ከሳ 12:51</ref>፤ <ref loc="NUM 14:29-30">ፓይ. 14:29-30</ref></char></note> <verse eid="JUD 1:5"/><verse number="6" style="v" sid="JUD 1:6"/>ቃይ ባረንቱ ደኢያሳ አጊደ፥ ባረንቶ እመቴዳ ካፖተ ናግቤና ኪታንቻቱ ፕርዳ አክያ ዎልቃማ ጋላሳይ ጋካናዉ ጾሳይ ኡንቱንታ ናግያሳን፥ ማፐ ጋርሳን መናዉ ቃች ዎ።<note caller="-" style="x"><char style="xo" closed="false">6 </char><char style="xt" closed="false"><ref loc="GEN 6:2">ዶመ 6:2</ref></char></note> <verse eid="JUD 1:6"/><verse number="7" style="v" sid="JUD 1:7"/>ሄዋዳን ሶዶማነ ጋሞራ ግያ ካታማቱዋንነ ኡንቱንቱ ሄራን ደእያ ካታማቱዋን ደእያ አሳይ ሄ ኪታንቻቱዋዳን ዎሹሜድኖነ ዎሹማናዉ ሎይ ካጄሌድኖ፤ ሄዋንቱ መና ታማን ኤጺደ፥ ሀራቶ ሌምሱዋ ግዴድኖ።<note caller="-" style="x"><char style="xo" closed="false">7 </char><char style="xt" closed="false"><ref loc="GEN 19:1">ዶመ 19:1</ref></char></note><verse eid="JUD 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8"/>ሄዋዳን ቃይ ሄ አኩመትያ አሳቱ ባረንቱ አሳተ ቱንሲኖ፤ ጾሳ ጎዳተ ካኖ፤ ቦንቾ መታቱዋካ ቦሪኖ። <verse eid="JUD 1:8"/><verse number="9" style="v" sid="JUD 1:9"/>ሽን ኪታንቻቱዋ ካፑ ምካኤል ሙሴ አሃባ<note caller="+" style="f"><char style="fr" closed="false">9 </char><char style="fq" closed="false">ምካኤል ሙሴ አሃባ፦ </char><char style="ft" closed="false">ሀዌ በስያዌ፥ በን ኮይሮቲደ አይሁዳቱዋ ማጻፋን ሙሴባዉ ጻፈቴዳዋ።</char></note> ጻላህያና ፓሉመቴዳ ዎደ፥ “ጎዳይ ኔና ሴሮ” ጌዳዋፐ አትን፥ ቦርያ ቃላን አ ቦላ ፕርዳናዉ ኮይቤና።<note caller="-" style="x"><char style="xo" closed="false">9 </char><char style="xt" closed="false"><ref loc="DAN 10:13">ዳኔላ 10:13</ref>፣ <ref loc="DAN 10:21">21</ref>፤ <ref loc="DAN 12:1">12:1</ref>፤ <ref loc="REV 12:7">ሳፃ 12:7</ref>፤ <ref loc="DEU 34:6">ዛረ. 34:6</ref>፤ <ref loc="ZEC 3:2">ዛካ. 3:2</ref></char></note> <verse eid="JUD 1:9"/><verse number="10" style="v" sid="JUD 1:10"/>ሽን ሄ አሳቱ ባረዉ አኬከናባ ኡባ ቦሪኖ፤ ቃይ ኡንቱንቱ ዩሽ ቆፐና ዶአቱዋዳን፥ መታ ኤራተን ኤርያ የዋቱ ኡንቱንታ ይስያዋንታ። <verse eid="JUD 1:10"/><verse number="11" style="v" sid="JUD 1:11"/>ኡንቱንቶ አዬሮ! አያዉ ጎፐ፥ ኡንቱንቱ ቃዬል ሀመቴዳ ኦግያ<note caller="+" style="f"><char style="fr" closed="false">11 </char><char style="fq" closed="false">ቃዬል ሀመቴዳ ኦግያ፦ </char><char style="ft" closed="false">ቃዬል ባረ እሻ አቤላ ዎዳ። ዶመ 4:3-8 ጼልተ።</char></note> ሀመቴድኖ። ሻሉዋ ድራዉ ጊደ፥ ባላም ኦዳዋ<note caller="+" style="f"><char style="fr" closed="false">11 </char><char style="fq" closed="false">ባላም ኦዳዋ፦ </char><char style="ft" closed="false">ጌሻ ቃላ ፓይዱዋ ማራዳን፥ ቦላ ጉጃ ደማና ጊደ እስራኤልያ አሳ ሸቂከ ጊደ እጼዳ ጋሱዋን ኡንቱንቱ ጾሳዉ አዛዘተናዳን ደአና ኦግያ ታማርሴዳ። ፓይ። 22:18፤ 24:13፤ 25:1-3፤ 31:16 ጼልተ።</char></note> ማላ ባይዙዋ ኦድኖ። ቃይ ቆረ<note caller="+" style="f"><char style="fr" closed="false">11 </char><char style="fq" closed="false">ቆረ፦ </char><char style="ft" closed="false">ዳታነና እትፐ ግዲደ ሙሴዉነ አሮነዉ ማካሌዳዋዳን፥ ማካላ አሳ ታማርሴድኖ። ፓይ. 16:1-35፤ 26:9-10 ጼልተ።</char></note> ግያ ብታኒ ማካሊደ ዬዳዋዳን፥ ኡንቱንቱካ ማካሊደ ዬድኖ።<note caller="-" style="x"><char style="xo" closed="false">11 </char><char style="xt" closed="false"><ref loc="GEN 4:3-8">ዶመ 4:3-8</ref>፤ <ref loc="NUM 22:1-35">ፓይ. 22:1-35</ref>፤ <ref loc="NUM 16:1-35">16:1-35</ref></char></note><verse eid="JUD 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JUD 1:12"/>ሄዋንቱ ሲቁዋን ሾቢያ ህንተ ምያሳን ህንተናና ያሽ ባይናን ምያ ዎደ፥ ቆሰቴዳ ቡዋ ማላ። ኡንቱንቱ ባረንቱ ጻላላ ናጊኖ። ኡንቱንቱ ጫርኩ አፍያ እራይ ባይና ሻርያ ማላ፤ ቃይ ኡንቱንቱ ቦንያን አይፍያ አይፈና፥ ጻጱዋና ሾደቲደ፥ ሙለካ መሌዳ ም ማላ። <verse eid="JUD 1:12"/><verse number="13" style="v" sid="JUD 1:13"/>ኡንቱንቱ ባረንቱ ፖኩዋ ገንና ሆሞትያ፥ ኢታ አባ ቤታ ማላ። ኡንቱንቱ፥ ጾሳይ፥ መናዉ ሳካና ማን ሳኣ ጊግስ ዎዳ ዩይያ ጾልንታቱዋ ማላ።<verse eid="JUD 1:13"/></para>
  <para style="p">
    <verse number="14-15" style="v" sid="JUD 1:14-15"/>ሄኖክ አዳማፐ ዶምና፥ ላፑን የለታ ግድያዌ፥ ዳሮ ዎድያፐ ካሰ ኡንቱንቱዋ ትምቢትያ ኦዲደ፥ ሀዋዳን ያጌዳ፤</para>
  <para style="q1" vid="JUD 1:14-15">“አኬክተ፤ ጾሳ ኤረና ናጋራንቻ አሳቱ ኦዳ፥</para>
  <para style="q2" vid="JUD 1:14-15">ኢታ ኦሱዋ ኡባዉነ፥</para>
  <para style="q1" vid="JUD 1:14-15">ቃይ ጾሳ ኤረና ሄ ኢታ አሳቱ፥</para>
  <para style="q2" vid="JUD 1:14-15">ጾሳ ቦላ ሃሳዬዳ ኢታ ሃሳያ ኡባዉ፥</para>
  <para style="q1" vid="JUD 1:14-15">ጎዳይ ኡንቱንቱ ኡባ ቦላ ፕርዳናዉ፥</para>
  <para style="q2" vid="JUD 1:14-15">ባረ ጮራ ሻአ ጌሻቱዋና እትፐ ያና”</para>
  <para style="m" vid="JUD 1:14-15">ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">14-15 </char><char style="xt" closed="false"><ref loc="GEN 5:18">ዶመ 5:18</ref>፣ <ref loc="GEN 5:21-24">21-24</ref></char></note> <verse eid="JUD 1:14-15"/><verse number="16" style="v" sid="JUD 1:16"/>ሄ አሳቱ ኡባ ዎደ ዙዙሚኖነ ሀራቱዋ አማሳሊኖ፤ ቃይ ባረንቱ ኢታ አሙዋ ካሊኖ፤ ባረንቱ ሁጰዉ ጎአ ደማናዉ ሀራቱዋ ሳቢኖነ ባረንቱ ኮሻ ዎጋፐ አደ፥ ቁ ኦ ሃሳዪኖ።<verse eid="JUD 1:16"/></para>
  <para style="s1">ምኖ አኬክሱዋነ ዞርያ</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17"/>ሽን ታ ሲቃቶ፥ ኑ ጎዳ የሱስ ክርስቶስ ኪቴዳዋንቱ ህንተንቶ በን ሃሳዬዳ ቃላ አኬክተ። <verse eid="JUD 1:17"/><verse number="18" style="v" sid="JUD 1:18"/>ኡንቱንቱ ህንተንቶ፥ “ዉርሰ ዎድያን፥ ባረንቶ ጾሳይ ባይናዋንቱ፥ ባረንቱ አሙዋ ካልያዋንቱ፥ ቃይ ህንተ ቦላ ቅሊጭያዋንቱ ያና” ያጌድኖ። <verse eid="JUD 1:18"/><verse number="19" style="v" sid="JUD 1:19"/>ሄዋንቱ አሳ ግዶን ሻኮተ መያዋንታነ፥ ባረንቱ ኢታ አሞ ሞደቴዳዋንታ፤ ቃይ ጌሻ አያናይ ባይናዋንታ።<verse eid="JUD 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JUD 1:20"/>ሽን ታ ሲቃቶ፥ ኡባፐ አያ ጌሻ አማኑዋን ህንተ ሁጲያ ኬጽተ፤ ቃይ ጌሻ አያና ዎልቃን ጾሳ ዎስተ። <verse eid="JUD 1:20"/><verse number="21" style="v" sid="JUD 1:21"/>ቃይ ኑ ጎዳይ የሱስ ክርስቶስ ባረ ማሮተን ህንተንቶ እማና መና ደኡዋ ናጊደ፥ ህንተ ሁጲያ ጾሳ ሲቁዋን ዎተ።<verse eid="JUD 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22"/>እት እት ስ ደእያ አሳቶ ቃረትተ። <verse eid="JUD 1:22"/><verse number="23" style="v" sid="JUD 1:23"/>እቱዋ እቱዋ ታማፐ ዳፍ ከሲደ አሽተ። ቃይ ሀራይ አቶ ኡንቱንቱ ኢታ አሙዋን ቱኔዳ ማዩዋ እጺደካ፥ እቶ እቶ ያሻተን ቃረትተ።<verse eid="JUD 1:23"/></para>
  <para style="s1">ጋላታ ዎሳ</para>
  <para style="p">
    <verse number="24-25" style="v" sid="JUD 1:24-25"/>ህንተ ኩንደናዳን፥ ህንተና ናጋናዉነ ፖኩ ባይናዋንታ ኦደ፥ ባረ ቦንቹዋ ስን ዎልቃማ ናሸቻን ሺሻናዉ ዳንዳይያ ኑና አሽያ እት ጾሳዉ፥ ኑ ጎዳ የሱስ ክርስቶሳ ባጋና ቦንቹ፥ ግታተይ፥ ዎልቃይነ ማታይ፥ አዳ ዎደ ኡባፐነ ሀእነ መና ጋካናዉ ግዶ። አመንእ።<verse eid="JUD 1:24-25"/></para>
  <chapter eid="JUD 1"/>
</usx>
