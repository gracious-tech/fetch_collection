<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- Dawuro Full Bible Ethiopic Version</book>
  <para style="h">ናሆማ</para>
  <para style="toc1">ናሆማ ትምቢትያ</para>
  <para style="toc2">ናሆማ</para>
  <para style="toc3">ናሆማ</para>
  <para style="mt1">ናሆማ ትምቢትያ</para>
  <para style="imt">ገሉዋ</para>
  <para style="ip">ናሆማ ግያ ሱን ብለይ፥ “ጾሳይ ምንያዋ ግያዋ።” ናሆማ ማጻፋይ በንፐ ዶሚደ እስራኤልያዉ ሞርከ ግዲደ ደኤዳ አሶረ ካዉተ ዋና ካታማ ነነዌ ኩንደ ናሸቻ ግጽምያን ኦዴ። መቀ ኢታነ ኦቶራንቻ ግዴዳ ነነዌ ካታማይ፥ የሱሳ የለታፐ ካሰ ላፑን ጼቱ ላይ ዉርሰን ኦላን ባዬዳ። ሄዌካ መቀ ኢታነ ኦቶራንቻ አሳ ቦላ ጾሳይ ዎት ፕርድንቶ በሴ።</para>
  <para style="iot">ሸምፓቱዋ ኡባቶ እመቴዳ ቃን ቆፋቱዋ</para>
  <para style="io1">1. ያሽያ ጾሳ ሀንቁዋ <char style="ior"><ref loc="NAM 1:1-6">1:1-6</ref></char></para>
  <para style="io1">2. አሶራ ቦላ አዳ ፕርዳይ እስራኤልያ አሳዉ ህዶታ ቤትሴዳ <char style="ior"><ref loc="NAM 1:7-15">1:7-15</ref></char></para>
  <para style="io1">3. አሶራ ሁጰ ካታማ ናናዌ ባየ <char style="ior"><ref loc="NAM 2:1-3:19">2:1—3:19</ref></char></para>
  <chapter number="1" style="c" sid="NAM 1"/>
  <para style="s1">ያሽያ ጾሳ ሀንቁዋ</para>
  <para style="r">(<ref loc="NAM 1:1-6">1:1-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1"/>ኤልቆሻ ጌተትያ ሳን ደእያ ናሆመ ነነዌ ቦላ ጾሳፐ አኬዳ ኪታይነ በኤዳ ሳፃ ማጻፋይ ሀዋ።<note caller="-" style="x"><char style="xo" closed="false">1:1—3:19</char><char style="xt" closed="false"><ref loc="ISA 10:5-34">ኢሳ. 10:5-34</ref>፤ <ref loc="ISA 14:24-27">14:24-27</ref>፤ <ref loc="ZEP 2:13-15">ሶፎ. 2:13-15</ref></char></note><verse eid="NAM 1:1"/></para>
  <para style="s1">ነነዌ ቦላን ጾሳይ ሀንቀቴዳ ሀንቁዋ</para>
  <para style="p">
    <verse number="2" style="v" sid="NAM 1:2"/>መና ጎዳይ ቃናትያነ ሀሉዋ ከስያ ጾሳ፤ መና ጎዳይ ሀሉዋ ከስያዋነ ሀንቁዋን ኩሜዳዋ፤ መና ጎዳይ ባረናና ኤቀትያዋንቶ ሀሉዋ ከሴ፤ ቃይ ባረ ሞርከቱዋ ሙራናዉ ባረ ሀንቁዋ ጊግስ ዎዳ። <verse eid="NAM 1:2"/><verse number="3" style="v" sid="NAM 1:3"/>መና ጎዳይ ሀንቀታናዉ ኤሌለና፤ ዎልቃይካ አዌ ዎልቃማ፤ እ ባይዛንቻ አያ ግዶፐነ፥ ሙረናን አገና።</para>
  <para style="p" vid="NAM 1:3">መና ጎዳዉ ጎቱዋንነ ቤታ ግዶን ኦጊ ደኤ፤ ሻሪካ አ ገዲ የና ደንድያ ባና። <verse eid="NAM 1:3"/><verse number="4" style="v" sid="NAM 1:4"/>እ አባ ሴሪደ መልሴ፤ ሻፋቱዋ ኡባካ ቶይሴ። ባሳነንነ ቃርመሎሳን ደእያ ምቱነ ማታቱ ሹሊኖ። ሊባኖሳ ጪሻይካ ቆቆፈቴ። <verse eid="NAM 1:4"/><verse number="5" style="v" sid="NAM 1:5"/>አ ስንን ደረቱ ቃጺኖ፤ ዞዘቱካ ሲሊኖ። እ ቆንጭያ ዎደ ቢታይ ሳአይ ቃጻና፤ ሳኣን ደእያባይ ኡባይካ ኮኮራና። <verse eid="NAM 1:5"/><verse number="6" style="v" sid="NAM 1:6"/>አ ሀንቁዋ ስንን ኤቃናዌ ኦኔ? አ ሀንቁዋ ሱሉዋካ ዳንዳያናዌ ኦኔ? አ ሀንቁ ታማዳን ቡክያ ዎደ፥ ዛላቱ ዛኢደ ጳልቀቲኖ።<verse eid="NAM 1:6"/></para>
  <para style="s1">አሶረ ቦላ አዳ ፕርዳይ እስራኤልያ አሳዉ ህዶታ ቤትሴዳ</para>
  <para style="r">(<ref loc="NAM 1:7-15">1:7-15</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="NAM 1:7"/>መና ጎዳይ ኬካ፤ መቱዋ ጋላስካ ባቃት አትያሳ፤ እ ባረኮ ባቃት አታናዉ ኮይያዋንታ ኤሬ። <verse eid="NAM 1:7"/><verse number="8" style="v" sid="NAM 1:8"/>ሽን እ ባረ ሞርከቱዋ ድኡዋን ሙክሲደ ይሳና፤ ባረናና ኤቀትያዋንታካ ማዉ የደርሳና።<verse eid="NAM 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NAM 1:9"/>ህንተ መና ጎዳ ቦላ ማቀትያዌ እ አዬ? እ ህንተና ኡባና ይሳና፤ ላኤንዋ ይሳናዉ ደንደና። <verse eid="NAM 1:9"/><verse number="10" style="v" sid="NAM 1:10"/>ህንተንቱ፥ ባጽባለቴዳ አጉን ማላቱ፥ ቃይ ኡሺደ ማቴዳዋዳን ጋንድጋርያዋንቱ፥ መላ ኡቱላዳን ታማን ጹገት ያና። <verse eid="NAM 1:10"/><verse number="11" style="v" sid="NAM 1:11"/>ነነዌ፥ መና ጎዳ ቦላ ኢታባ ቆፕያዌ፥ ኢታ ዞርያ ዞርያዌ ነ ግዶፐ ከሴዳ።<verse eid="NAM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NAM 1:12"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ናናዌቱ ምኖነ ጮራ ግዶፐካ፥ ቆለቲደ ያና። ይሁዳ አሳዉ፥ ታን ህንተና ካሰ ቱጋያድ፤ ሽን ሀዋፐ ስንናዉ ቱጋይከ። <verse eid="NAM 1:12"/><verse number="13" style="v" sid="NAM 1:13"/>ሀእ ታን አሶረቱዋ ሞርገ ም ህንተ ሞርግያፐ መንና፤ ህንተ ኡቁና ቃሹዋካ ታን ዱሰረና” ያጌ።<verse eid="NAM 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NAM 1:14"/>ነነዌ፥ መና ጎዳይ ነ ቦላ ፕርዴዳ ፕርዳይ ሀዋዳን ያግያዋ፤ “ሀዋፐ ስንናዉ ነ ሱን ጼስስያ ዘረይ ነዉ ደኤና። ነ ጾሳቱዋ ጎልያን ደእያ ምስለቱዋነ ኤቃቱዋ ታን ይሳና። ኔን ዳምበናዋ ግዴዳ ድራዉ፥ ታን ነ ዱፉዋ ቦካና” ያግያዋ።<verse eid="NAM 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NAM 1:15"/>በእተ፥ እት ኪተቴዳዌ ሎኦ ምሽራቹዋ ኦዲድነ ሳሮተ አዋዪደ፥ ቃ ደረቱዋ ቦላና ጋኬዳ። ህንተኖ፥ ይሁዳ አሳቶ፥ ህንተና ይስያ ሞርከቱ ኡባና ዬድኖ፤ ኡንቱንቱ ላኤን ህንተ ቢታ ዎራጅክኖ። ሄዋ ድራዉ፥ ህንተ ባላቱዋ ቦንችተ፤ ህንተ ሺቄዳዋካ ጋተ።<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="ISA 52:7">ኢሳ. 52:7</ref></char></note><verse eid="NAM 1:15"/></para>
  <chapter eid="NAM 1"/>
  <chapter number="2" style="c" sid="NAM 2"/>
  <para style="s1">አሶራ ሁጰ ካታማ ናናዌ ባየ</para>
  <para style="r">(<ref loc="NAM 2:1-3:19">2:1—3:19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NAM 2:1"/>ኔኖ ናናዌ ካታማዉ፥ ይስያባይ ዬዳ! ሄዋ ድራዉ፥ ነ ጌሱዋ ናጋ፤ ነ ኦግያካ ዎቻ፤ ነ ዳንጩዋ ምንሳ፤ ነ ዎልቃካ ሎይ ምንሳ።<verse eid="NAM 2:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="NAM 2:2"/>ይስያዋንቱ፥ እስራኤልያ አሳነ ዎይንያ ቱራ ይሶፐካ፥ መና ጎዳይ እስራኤልያ ቦንቹዋነ ያቆባ ቦንቹዋ ዛራና።<verse eid="NAM 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NAM 2:3"/>ኦላንቻቱዋ ጎንዳላቱ ዞኦ፤ ኦላንቻቱካ ዞኦ ማዩዋ ማዬድኖ። ኡንቱንቱ ኦላዉ ጊግያ ዎደ፥ ፓራ ጋረቱዋ ብራታይ ታማ ላጩዋዳን ጶልቁ ጊኖ፤ ኡንቱንቱ ባረንቱ ቶራ ቶማካ ጊግሴድኖ። <verse eid="NAM 2:3"/><verse number="4" style="v" sid="NAM 2:4"/>ፓራ ጋረቱ ኦግያን አንዳራሱዋ ክንቺኖ፤ ኡንቱንቱ ያነ ሃነ ጃሚደ፥ ካታማ ኦግያን ዩዪኖ። ቃይ ኡንቱንቱ ላጩ ፖዱ ግያ ጾምፕያ ማላቲኖ፤ ዋልቃንዳንካ ኤሌሊኖ። <verse eid="NAM 2:4"/><verse number="5" style="v" sid="NAM 2:5"/>እ ባረ ኦላ ካፓቱዋ ጼሲደ ሺሼ፤ ሽን አ ካፓቱ ሀመቲደ በቲኖ። ኡንቱንቱ ካታማ ግምቢያ ድርሳኮ ኤሌሊኖ፤ ኡንቱንታ ሞርከቱዋ ቆሁዋፐ ናግያ ዎልቃማ ጎንዳሊ ጊጌዳ። <verse eid="NAM 2:5"/><verse number="6" style="v" sid="NAM 2:6"/>ሻፋ ባጋና ደእያ ካታማ ድርሳ ፐንገቱ ዶየቴድኖ፤ ካትያ ጎሊካ ሻቢረቴዳ። <verse eid="NAM 2:6"/><verse number="7" style="v" sid="NAM 2:7"/>ካታማታ ኦሞደታደ ባዱ፤ እዝ ማጫ ቆማቱካ ካዮቲደ፥ ሀራጰቱዋዳን ዋሲኖ፤ ባረንቱ ትራካ ባቂኖ።<verse eid="NAM 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NAM 2:8"/>ዳጋት ኡቴዳ ሃይ ፖክ በስና ጎግያዋዳን፥ ነነዌ አሳይ ካታማፐ ባቃታና። አሳይ ኡንቱንቱ ባረ ቃላ ቁ ኦደ፥ “ኤቂተ፤ ኤቂተ!” ያጊደ ጼሳና፤ ሽን ኦንነ ጉየ ጼለና። <verse eid="NAM 2:8"/><verse number="9" style="v" sid="NAM 2:9"/>ሄ ካታማ አቆ፥ አን ምንጀቴዳ ቦንቾ ሚሻስካ ፓይዱ ባዋ። ሄዋ ድራዉ፥ ሄ ብራ ቦንቂተ! ሄ ዎርቃካ ቃይ ቦንቂተ!<verse eid="NAM 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NAM 2:10"/>ነነዌ ካታማይ መላ ግዴዳ፤ ቃይ ኦኒደ ባዬዳ! አሳ ዎዛናይ ያሻን ሲሌዳ፤ ጋዱካ ኮኮሬዳ፤ አሳ ኡባ ጼሳይ ጋጅ ጋጄዳ፤ ሶምኢካ ቡላቴዳ! <verse eid="NAM 2:10"/><verse number="11" style="v" sid="NAM 2:11"/>ጋማቱዋ ጌሱዋ ማላ፥ ዎዳላ ጋማቱ ደኢያሳ ማላነ አቱማነ ማጫ ጋማቱ ባረንቱ ማራቱዋና ኡንቱንቱ ያሽስያዌ ባይናን፥ ዩይያ ዎራ ማላ ግዴዳ ናናዌ ካታማይ ሀእ ሀቃን ደኢ? <verse eid="NAM 2:11"/><verse number="12" style="v" sid="NAM 2:12"/>ጋሙ ባረ ማራቶ ግድያባ ኦይቄዳ፤ ማጫ ጋማትስካ መንሬደ እሜዳ። ባረ ጌሱዋ ሃስ ኦይቄዳዋን፥ ባረ ጎንጎሉዋካ ሃስ አሄዳ አሹዋን ኩንዳ።<verse eid="NAM 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NAM 2:13"/>ኡባፐ ዎልቃማ መና ጎዳይ ሀዋዳን ያጌ፤ “በአ፥ ታን ነ ቦላን ደንዳድ! ታን ነ ፓራ ጋረቱዋ ታማን ጹጋና፤ ነ ዎዳላ ጋማቱዋካ ማሻይ ማና። ኔን ሃሳይያዋ ታን ቢታ ኡባፐ ይሳና፤ ነዉ ኪተትያዋንቱ ቃላይካ ላኤን ሙለካ ስሰተና” ያጌ።<verse eid="NAM 2:13"/></para>
  <chapter eid="NAM 2"/>
  <chapter number="3" style="c" sid="NAM 3"/>
  <para style="s1">ናናዌ ካታማትዉ አየ አና!</para>
  <para style="p">
    <verse number="1" style="v" sid="NAM 3:1"/>ዳሮ አሳ ሱ ጉሴዳ ነነዌ ካታማትዉ አዬሮ! ዎርዱ እዝን ኩም ኡቴዳ። እዛ ዎልቃን አኬዳነ ቦንቄዳ ዱረታዉ ፓይዱ ባዋ። <verse eid="NAM 3:1"/><verse number="2" style="v" sid="NAM 3:2"/>ናናዌ ካታማትን ልሱዋ አርፔሉ፥ ፓራ ጋርያ ገድያ ጉንይ፥ ፓራቱዋ አንዳራሱነ ፓራ ጋረቱዋ ጉፋይ ስሰቴ። <verse eid="NAM 3:2"/><verse number="3" style="v" sid="NAM 3:3"/>ፓራ አሳቱ ነ ቦላ ዬድኖ፤ ማሻይ ጶሉጶሌ፤ ቶራቱካ ጶሊኖ። ዳሮ አሳይ ሀይቄዳ! አሃይ አሃ ቦላ ዶረቴዳ! ሀይቄዳባዉ ፓይዱ ባዋ! ሄዋና አደ ብያ አሳይካ አሃን በቴ። <verse eid="NAM 3:3"/><verse number="4" style="v" sid="NAM 3:4"/>ሀዌ ኡባይ ሀኔዳዌ ዛዋይ ባይና ነነዌ ጫራተ ጋሱዋና። እዛ ጮራ ሙሩኖ አቶ፤ ካዉተቱዋ ባረ ጫራተን፥ አሳካ ባረ ሙሩኑዋን አይለያዱ።<verse eid="NAM 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NAM 3:5"/>ኡባፐ ዎልቃማ መና ጎዳይ፥ “በአ፥ ታን ነ ቦላን ደንዳድ! ታን ነ ማዩዋ ነ ቦላፐ ቃራና፤ ነ ካሉዋ ጋደ አሳ፥ ነ ፖኩዋካ ካዉተቱዋ በሳና። <verse eid="NAM 3:5"/><verse number="6" style="v" sid="NAM 3:6"/>ታን ኔና ፕቱዋ ኦልያ ሳ ከሳና፤ ታን ኔና ካና፤ ቃይ አሳይ ኡባይ ኔናን ቅሊጭያዋ ኦና። <verse eid="NAM 3:6"/><verse number="7" style="v" sid="NAM 3:7"/>ኔና በእያ ኡባይ ኔፐ ሸልእ ጊደ፥ ‘በእተ፥ ናናዌ ካታማታ መላ ግዳዱ። እዝዉ ካዮትያዌ ኦኔ? እዞ ምንያዌካ ሀቃፐ ቤታንዴሻ!’ ያጋና” ያጌ።<verse eid="NAM 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NAM 3:8"/>ኔኖ ነነዌ ካታማቴ፥ ኔን ቴብሶ ግያ ግብጼ ካታማትፐ ዳራይ? እዞ ናይለ ሻፋይ ዶድ ዎዳ። ሻፋይ እዝዉ ተእያ ግምቢያ፤ ሃቱካ እዝዉ ድርሳ። <verse eid="NAM 3:8"/><verse number="9" style="v" sid="NAM 3:9"/>ቶጲነ ግብጼ እዝዉ ዛዋይ ባይና ዎልቃ፤ ፑጸነ ሊቢ እዞ ማድያዋንታ። <verse eid="NAM 3:9"/><verse number="10" style="v" sid="NAM 3:10"/>ግዶፐነ፥ እዛ ኦሞደታደ ባዱ፤ እዝን ደእያ ጉ ናናይካ ዳራጸቲደ፥ ኦግያ ጋጻን ኡባን ኩንዴድኖ። እዝ ቦንቼቴዳ አሳቱዋ ቦላን ሳማይ የገቴዳ፤ እዝ ዎልቃማ አሳቱ ኡባይካ ሳንላታን ቃሸቴድኖ።<verse eid="NAM 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NAM 3:11"/>ኔኖ ነነዌ ካታማቴ፥ ኔን ቃይ ማቲደ ጋንድጋርያ አሳዳን ሀናና። ነ ሞርከቱዋ ስንፐ ቆሰታደ አትያሳ ኔን ኮያና። <verse eid="NAM 3:11"/><verse number="12" style="v" sid="NAM 3:12"/>ነ ጌሳቱ ኡባይ ኮይሮ ቴሬዳ ቴራይ ጋዉጨቴዳ ባላስያ ምቱዋ ማላ፤ ሄ ባላስያ ም ቃያ ዎደ፥ ቴራይ ምያዎ ዶናን ዎ። <verse eid="NAM 3:12"/><verse number="13" style="v" sid="NAM 3:13"/>በአ፥ ነ ኦላንቻቱ ኡባይ ማጫ አሳ ማላ። ነ ዛዋ ፐንገቱካ ነ ሞርከቶ አኪደ ዶየቴድኖ፤ ጎርድያ ምካ ታማይ ም ድጌዳ።<verse eid="NAM 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NAM 3:14"/>ነ ሞርከቱ ኔና ዶዲደ ኡንኤያ ዎደ ኡሻናዉ ሃ ትካ። ነ ጌሱዋካ ምንሳ፤ ኡርቃ የ፤ አፐ ጹብያ መያ ሚሻን ጹብያ ጊግሳ። <verse eid="NAM 3:14"/><verse number="15" style="v" sid="NAM 3:15"/>ኔና ያን ታማይ ማና፤ ቦሊ ካ ምያዋዳን፥ ኔና ማሻን ቃንጸሬና።</para>
  <para style="p" vid="NAM 3:15">ኔን ቦልያዳን ዳራ፤ ቦልያዋዳንካ ጮራታ። <verse eid="NAM 3:15"/><verse number="16" style="v" sid="NAM 3:16"/>ኔን ነ ዛልአንቻቱዋ ሳሉዋ ጾልንተቱዋፐ አደ ጮራያዳ። ሽን ሄዋንቱ ኡባይ ቦልያዳን ኡባባ ም ድጊደ፥ ፓል ያና። <verse eid="NAM 3:16"/><verse number="17" style="v" sid="NAM 3:17"/>ነ ካፓቱነ ማታይ ደእያዋንቱ፥ ሜጎ ጋላስ ድርሳ ቦላን ኡቲደ፥ አዋይ ከስያ ዎደ ፓል ይያ ቦለቱዋ ማላ፤ ኡንቱንቱ ቤዳ ሳካ ኤርያዌ ባዋ።<verse eid="NAM 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NAM 3:18"/>ኔኖ አሶረ ካተዉ፥ ነ ሄንንቻቱ ገምእሼድኖ፤ ነ ቦንቼቴዳ አሳቱካ ጌሮቴድኖ። ነ አሳይ ደረቱዋ ቦላን ላለቴዳ፤ ኡንቱንታ ሺሽያዌካ ባዋ። <verse eid="NAM 3:18"/><verse number="19" style="v" sid="NAM 3:19"/>ነ መኡ ኮለተና፤ ነ ማዱይካ ፓጸና። ነባ ስሴዳ ኡባይ ናሸቲደ፥ ኩሽያ ባቃና። አያዉ ጎፐ፥ ነ ዛዋይ ባይና ኢታተፐ ከስ አኬዳ አሳይ ሙለካ ባዋ።<verse eid="NAM 3:19"/></para>
  <chapter eid="NAM 3"/>
</usx>
