<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ISA" style="id">- Dawuro Full Bible Ethiopic Version</book>
  <para style="h">ኢስያሳ</para>
  <para style="toc1">ኢስያሳ ትምቢትያ</para>
  <para style="toc2">ኢስያሳ</para>
  <para style="toc3">ኢሳ.</para>
  <para style="mt1">ኢስያሳ ትምቢትያ</para>
  <para style="imt">ገሉዋ</para>
  <para style="ip">ኢስያሳ ማጻፋይ ክርስቶስ የለታናፐ ካሰ፥ ሆስፑን ጼቱ ላይ ሄራን የሩሳላመን ደኤዳ፥ ትምቢትያ ኦድያ ኢስያሳ ሱንን ጼሰቴ። አ ሱን ብለይካ፥ “ጾሳይ አሽያዋ” ግያዋ። ሀ ማጻፋ ሄዙ ሁጴ ሁጴ ክፍለቱዋን ሻኪደ በአናዉ ዳንዳዬቴ።</para>
  <para style="ip">1. ሸምፑዋ 1ፐ ቢደ 39 ጋካናዉ ደእያዌ ገድሳ ባጋና ደእያ ይሁዳ ካዉተ አሶረ ግያ ዎልቃማ ሾሮ ካዉተይ ዎልቃንያዋ ኦዴ። ይሁዳ ሄዋ ማላ ሀዳን የጌዳዌ አሶረ ካዉተ ምኖተ ግደናን፥ አሳ ናጋራ፥ ጾሳዉ አዛዘተናን እጽያዋ፥ ሄዋዳንካ ኡንቱንቱ ጾሳን አማነተናን አግያዋ ግድያዋ እስያስ ማላቴዳ። ትምቢትያ ኦድያዌ ቆንጨ ሃሳያንነ ኦሱዋን አሳነ አሳ ካለያዋንታ ጽሎተይነ ሱረ ፕርዳይ ኩሜዳ ደኡዋኮ ስማና ማላ አኬክሴዳ፤ ቃይ ጾሳዉ አዛዘተናን አግያዌ ጋማ ሜተቱሳነ ባሻ ካለያዋ ኡንቱንቶ ምንሲደ ኦዴዳ። እስያስ ሄዋ ቦላካ ጉጂደ ኦዲደ፥ ያና ዎደቱዋን ሳኣ ዩሹዋን ሳሩ ኩሜዳ፥ ፖኮባይ ባይናን ካለያ፥ ዳዊታ ዛረ ግድያ ካቲ ያናዉ ደእያዋ ካሰቲደ ኦዴዳ።</para>
  <para style="ip">2. ሸምፑዋ 40ፐ ቢደ 55 ጋካናዉ ደእያ ክፍልያፐ ዳርያ ባጋይ ይሁዳ አሳይ ኦሞደቲደ ባብሎነ ቤዳ ዎደ፥ ኡንቱንቱ ደኡ ኩንዴዳነ ኡንቱንቱ ህዶታ ቃንጼዳ ዎደቱዋባ ኦዴ። ትምቢትያ ኦድያዌ ጾሳይ ባረ አሳ ሄ ሀኖታፐ ብል የዳና ዎዲነ ኡንቱንቱ ኦራ ደኡዋ ዶማና ማላ፥ ኡንቱንታ የሩሳላመ አፋና ዎዲ ማታቴዳዋ ኦዴዳ። ሀ ሸምፓቱዋ ግዶን ቆንጪደ ቤትያ የዉ ጾሳይ ታርክያዉ ጎዳ ግድያዋነ ባረ አሳዉ አዉ ደእያ ሀልቹዋ፥ ሄዌነ እስራኤልያ አሳ ባጋና አንጀታናዉ ደእያ አሳኮ ኡንቱንቱ ቢደ፥ ኦናዉ በስያዋ ኦድያ ክፍልያ።</para>
  <para style="ip">3. ሸምፑዋ 56ፐ ቢደ 66 ጋካናዉ ደእያ ክፍሊ ኦድያዌ ጉየን የሩሳላመን ደእያ አሳዋ፤ ሄ አሳይ ጾሳይ ባረ አሳዉ ገሌዳ ቃላ ፖላናዋ ጌሺደ ኤራናዉ፥ ማርካ ግድያባ ደማናዉ ኮዪደ ኡቴዳ። ኡንቱንቱ ሎይ ኦናዳን ኮየቴዳ ኦሶቱ ጽሎተ፥ ሱረ ፕርዳ፥ ሳምባታ ቦንችያዋ፥ ያርሹዋ ያርሽያዋነ ዎሳን ሼክያዋ። ሀ ክፍልያን ኤረቴዳ ሸምፑ 61:1-2 ደእያዋ ግድሽን፥ የሱስ ኮይሮ ኦሱዋ ዶሚደ፥ ባረ ጼሳባዉ ማርካ ኦደ ሺሼዳ ቃላቱ ሀ ፓይዶቱዋ ግዶን ደኢኖ።</para>
  <para style="iot">ሸምፓቱዋ ኡባቶ እመቴዳ ቃን ቆፋቱዋ</para>
  <para style="io1">ገሉዋ <char style="ior"><ref loc="ISA 1:1-31">1:1-31</ref></char></para>
  <para style="io1">ይሁዳዉነ እስራኤልያዉ አዳ ኪታቱዋ <char style="ior"><ref loc="ISA 2:1-5:30">2:1—5:30</ref></char></para>
  <para style="io1">ኢስያሳ ኦሱዋን ቤቴዳ የዎቱዋ <char style="ior"><ref loc="ISA 6:1-9:7">6:1—9:7</ref></char></para>
  <para style="io1">ይሁዳዉነ እስራኤልያዉ ጉጃ ኪታቱዋ <char style="ior"><ref loc="ISA 9:8-12:6">9:8—12:6</ref></char></para>
  <para style="io1">ጾሳ ሙራይ ሀራ አሳቱዋ ቦላ <char style="ior"><ref loc="ISA 13:1-23:18">13:1—23:18</ref></char></para>
  <para style="io1">ዋየትያ እስራኤልያ አሳቶ ህዶታ ኪታ <char style="ior"><ref loc="ISA 24:1-27:13">24:1—27:13</ref></char></para>
  <para style="io1">ጾሳይ ማካላንቻ አሳ ሙርያዋ ግዱሳ <char style="ior"><ref loc="ISA 28:1-31:9">28:1—31:9</ref></char></para>
  <para style="io1">ጾሳይ ኤዶማ ሙርያዋ እየሩሳሌሞ አንጅያዋ ግዱሳ <char style="ior"><ref loc="ISA 32:1-35:10">32:1—35:10</ref></char></para>
  <para style="io1">አሶራ፥ ባብሎና፥ ካትያ ህዝቂያሳነ ኢስያሳ <char style="ior"><ref loc="ISA 36:1-39:8">36:1—39:8</ref></char></para>
  <para style="io1">ጾሳይ ባረ አሳ አሽያዋ ግዱሳ <char style="ior"><ref loc="ISA 40:1-48:22">40:1—48:22</ref></char></para>
  <para style="io1">ጾሳ ሀጋዝያዋባ <char style="ior"><ref loc="ISA 49:1-53:12">49:1—53:12</ref></char></para>
  <para style="io1">ጾሳይ እሜዳ ህዶታ ናግያዋ ግዱሳ <char style="ior"><ref loc="ISA 54:1-55:13">54:1—55:13</ref></char></para>
  <para style="io1">አሳ ዛሪ ኡባይ ጾሳ ባጋ ግዳናዉ ዳንዳዩሳ <char style="ior"><ref loc="ISA 56:1-8">56:1-8</ref></char></para>
  <para style="io1">ጾሳዉ አማነተና ካለያዋንቱ ሙረትያዋ <char style="ior"><ref loc="ISA 56:9-59:21">56:9—59:21</ref></char></para>
  <para style="io1">የሩሳላመ ስን ቦንቾ ህዶታ <char style="ior"><ref loc="ISA 60:1-62:12">60:1—62:12</ref></char></para>
  <para style="io1">ጾሳ ኦራ ማላልስያ መታ <char style="ior"><ref loc="ISA 63:1-66:24">63:1—66:24</ref></char></para>
  <chapter number="1" style="c" sid="ISA 1"/>
  <para style="s1">ገሉዋ</para>
  <para style="r">(<ref loc="ISA 1:1-31">1:1-31</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 1:1"/>ኦዝያነ፥ እዮኣታም፥ አካዝነ ህዝቂያስ ይሁዳ ካተቱዋ ግዴዳ ዎደ፥ አሞጻ ናአይ እስያስ ይሁዳባነ የሩሳላመባ በኤዳ ሳጻይ ሀዋ።<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2KI 15:1-7">2 ካታ. 15:1-7</ref>፤ <ref loc="2KI 15:32-16:20">15:32—16:20</ref>፤ <ref loc="2KI 18:1-20:21">18:1—20:21</ref>፤ <ref loc="2CH 26:1-32:33">2 ኦዱዋ 26:1—32:33</ref></char></note><verse eid="ISA 1:1"/></para>
  <para style="s1">ጾሳይ ባረ አሳ ሴሬዳ</para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 1:2"/>ሳሎቱዋን ደእያዋንቶ፥ ስስተ፤ ሳኣን ደእያዋንቶ፥ ስስተ፤ አያዉ ጎፐ፥ መና ጎዳይ ሀዋዳን ያጌዳ፤ “ታን ናናቱዋ ድቻ ጋድ፤ ሽን ኡንቱንቱ ታዉ ማካሌድኖ። <verse eid="ISA 1:2"/><verse number="3" style="v" sid="ISA 1:3"/>ቦራይ ባረ ጎዳ ኤሬ፤ ሀሪካ ባረና ሞዴዳዋ ዛዳሉዋ ኤሬ፤ ሽን እስራኤላቱ ኤርክኖ፤ ታ አሳቱ አኬክክኖ።<verse eid="ISA 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 1:4"/>“ናጋራ ኦያ ካዉተዉ፥ ህንተ ናቁዋን ዴጸቴዳ አሳዉ፥ ኢታ ኦያ ዛርያዉ፥ ህንተ ማይዛቱዋ ቱናተ ካልያ ናቶ፥ ህንተንቶ አየ አና! መና ጎዳ ህንተ አጌድታ፤ እስራኤልያ ጌሻ ሸነዬድታ፤ አዉ ዞክያ ዛሬድታ። <verse eid="ISA 1:4"/><verse number="5" style="v" sid="ISA 1:5"/>ህንተ አያዉ ማካላ ቦላ ማካላ ጉጅ ጉጅ ቢቴ? አያዉ ቃይካ ሙረታናዉ ኮዪቴ? ህንተ ኩመን ሁጲ ሳከቴዳ፤ ህንተ ኩመን ዎዛናይካ ዳቡሬዳ። <verse eid="ISA 1:5"/><verse number="6" style="v" sid="ISA 1:6"/>ገድያ ብራያፐ ሁጲያ ብናና ጋካናዉ ፓጻተይ ባዋ፤ ማዱይ፥ ጋፉነ ጊይያባይ ደኤ፤ ኡንቱንቱነ ጊይበይክኖ፥ ዎይ ሜጨት ቃሸትበይክኖ፥ ዎይ ዛይትያን ኦከቲደ ሹግበይክኖ።<verse eid="ISA 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 1:7"/>“ህንተ ጋዲ ድርቃለቲደ ባያና፤ ህንተ ካታማቱካ ታማን ጹገቴድኖ፤ ህንተ ጎሻ ህንተ ጼልሽን፥ አላጋቱ አኪኖ፤ እማ አሳቱ፥ መላ አሻና። <verse eid="ISA 1:7"/><verse number="8" style="v" sid="ISA 1:8"/>የሩሳላመ ካታማይ ዎይንያ ቱራ ናግያ ዳስያዳን፥ ሌክያ ናግያ ጎልያዳን ሞርክያን ድረቴዳ ካታማዳን ሀኒደ አቴዳ። <verse eid="ISA 1:8"/><verse number="9" style="v" sid="ISA 1:9"/>ኡባፐ ዎልቃማ መና ጎዳይ ኑዉ አማሬዳ ዛራቱዋ አሸነንቶ፥ ኑን ሶዶማ ካታማዳንነ ጋሞራ ካታማዳን ሀኔዶሽን” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="GEN 19:24">ዶመ 19:24</ref>፤ <ref loc="ROM 9:29">ሮመ 9:29</ref></char></note><verse eid="ISA 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 1:10"/>ህንተኖ፥ ሶዶማ ሞድያዋንቶ ኡባቶ፥ መና ጎዳ ቃላ ስስተ! ህንተኖ፥ ጋሞራ አሳ ኡባቶ፥ ኑ ጾሳ ህግያ ስስተ! <verse eid="ISA 1:10"/><verse number="11" style="v" sid="ISA 1:11"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ህንተ ያርሹዋ ዳሩ ታዉ አያ ጎኢ? ሀኖ ጋካናዉ ህንተ ታዉ ሺሼዳ ጹገቴዳ ኦርገ ዶርሳቱዋነ ኬዳ መህያ ሞዋ ያርሹዋ ታን ካላድ፤ ኮሩማ ቦራቱዋ፥ ዶርሳ ማራቱነ ዴሻቱዋ ሱን ታን ናሸትከ።<note caller="-" style="x"><char style="xo" closed="false">1:11-14 </char><char style="xt" closed="false"><ref loc="AMO 5:21-22">አሞጻ 5:21-22</ref></char></note> <verse eid="ISA 1:11"/><verse number="12" style="v" sid="ISA 1:12"/>ህንተ ታዉ ጎይናናዉ ይያ ዎደ፥ ታ ጌሻ ጎልያ ዳባባ ህንተና የተ ጌዳዌ ኦኔ? <verse eid="ISA 1:12"/><verse number="13" style="v" sid="ISA 1:13"/>ስም ሀዳ ያርሹዋ አህያዋ አግተ! ህንተ ጩውስያ እጻናይ ታና ሸነዬ፤ አግና ጼሩዋ ህንተ ቦንችያ ጋላሳ፥ ህንተ ሳምባታነ ህንተ ኬሬዳ ያአቱዋ፥ ሀ ሺቃቱዋ ኡባ ኢታተና እትፐ ዋላከቴዳዋንታ ታን ዳንዳይከ። <verse eid="ISA 1:13"/><verse number="14" style="v" sid="ISA 1:14"/>አግና ጼሩዋ ህንተ ቦንችያ ጋላሳነ ኬረቴዳ ህንተ ባላ ጋላሳቱዋ ታን እጻድ፤ ኡንቱንቱ ታዉ ቶኩዋ ግዴድኖ፤ ታን ኡንቱንታ ቶካደ ዳቡራድ።<verse eid="ISA 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 1:15"/>“ህንተ ኩሽያ ምጪደ፥ ህንተ ዎስያ ዎደ፥ ታን ታ አይፍያ ህንተፐ ገንና፤ ህንተ ዳሮ ዎሳ ዎስንቶካ፥ ታን ስስከ፤ አያዉ ጎፐ፥ ህንተ ኩሺ ሱን ሙናቀቴዳ። <verse eid="ISA 1:15"/><verse number="16" style="v" sid="ISA 1:16"/>ሜጨትተ፤ ጌይተ፤ ህንተ ኢታ ኦሱዋ ታ ስንፐ ድግተ። ኢታ ኦያዋ አግተ፤ <verse eid="ISA 1:16"/><verse number="17" style="v" sid="ISA 1:17"/>ሎኦባ ኦናዉ ታማርተ። ጽሎ ፕርዳ ኮይተ፤ ኡንኤቴዳዋንቱ ሞርግያ ኦይቂተ። አዉ ባይናዋንቶ ፕርድተ፤ አስናይ ሀይቄዳ ማጫ አሳቶ ሞተትተ” ያጌ።<verse eid="ISA 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 1:18"/>ቃይካ መና ጎዳይ፥ “ሃይተ፤ አነ ዞረቶይተ። ህንተ ናጋራይ ባራዳን ዞእንቶካ፥ ሻቻዳን ቦጻና፤ ሱዳን ዞእንቶካ፥ ፑቱዋዳን ቦጻና። <verse eid="ISA 1:18"/><verse number="19" style="v" sid="ISA 1:19"/>ህንተ ኤኖ ጊደ፥ ታዉ አዛዘቶፐ፥ ጋድያፐ ሞክያ ሙሩታ ማና። <verse eid="ISA 1:19"/><verse number="20" style="v" sid="ISA 1:20"/>ሽን ህንተ እጻድ ጊደ ማካሎፐ፥ ማሻን ሜተታና” ያጌ። መና ጎዳይ ባረ ዶናፐ ሀዋ ሃሳዬዳ።<verse eid="ISA 1:20"/></para>
  <para style="s1">ናጋራይ ኩሜዳ ካታማ</para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 1:21"/>አማነቴዳ ዎልቃማ ካታማታ ዋናደ ሻርሙጻ ግዳዴ! እዛ ካሰ ሱረ ፕርዳይ ኩሜዳኖ፤ ጽሎተይ ካሰ እ ግዶን ደኤዳ፤ ሽን ሀእ አሳ ዎያዋንቱ እዝ ግዶን ደኢኖ። <verse eid="ISA 1:21"/><verse number="22" style="v" sid="ISA 1:22"/>ነ ብራይ ሽእ ክቼዳ፤ ነ ሎኦ ዎይንያ ኤሳይካ ሃና ዬለቴዳ። <verse eid="ISA 1:22"/><verse number="23" style="v" sid="ISA 1:23"/>ህንተ ዳናቱ ማካላንቻቱዋነ ካይሶቱዋ ላገቱዋ ግዴድኖ፤ ኡንቱንቱ ኡባቱካ ማታይያ ዶሲኖነ ሚሻ የደርሲኖ፤ አዉ ባይናዋንቶ ፕርድክኖ፤ አስናይ ሀይቄዳ ማጫ አሳቱዋ ሞቱ ኡንቱንቱኮ ሺቀና።<verse eid="ISA 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 1:24"/>ሄዋ ድራዉ፥ ጎዳይ፥ ኡባፐ ዎልቃማ መና ጎዳይ፥ እስራኤልያ ዎልቃማይ፥ ሀዋዳን ያጌ፤ “ሀእ ታን ታና እጽያዋንቱፐ ሸምፓና፤ ታን ታ ሞርከቱዋ ቦላ ታ ሀሉዋ ከሳና። <verse eid="ISA 1:24"/><verse number="25" style="v" sid="ISA 1:25"/>ታን ታ ኩሽያ ነ ቦላ ዎና፤ ነ ሽኦዋ ቁልጹጽሳደ ጌሻና፤ ኔናና ዋላከቴዳባ ኡባ ጌሻደ የድሳና። <verse eid="ISA 1:25"/><verse number="26" style="v" sid="ISA 1:26"/>ታን በንዋንቱ ማላ ዳናቱዋ፥ ኮይሮዋንቱ ማላ ዞርያዋንታ ነዉ ዛራና። ሄዋፐ ጉይያን፥ ኔን ጽሎተ ካታማ፥ አማነቴዳ ካታማ ጌተታና” ያጌ።<verse eid="ISA 1:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ISA 1:27"/>ጽዮኔ ሱረ ፕርዳን፥ ባረንቱ ናጋራ ፓጽያዋንቱካ ጽሎተን ዎዘታና። <verse eid="ISA 1:27"/><verse number="28" style="v" sid="ISA 1:28"/>ሽን ማካላንቻቱነ ናጋራንቻቱ ላኡካ መአና፤ መና ጎዳ አግያዋንቱ ያና። <verse eid="ISA 1:28"/><verse number="29" style="v" sid="ISA 1:29"/>ዎናዉ ዶሴዳ ዎላ ድራዉ፥ ህንተ ዬላታና፤ ህንተ ዶሬዳ ካሻ ግሻዉካ ህንተ ካዉሻና። <verse eid="ISA 1:29"/><verse number="30" style="v" sid="ISA 1:30"/>ቦንጪ ቆቆፈትያ ዎላዳን፥ ዎይ ዱቢ ባይና ሾይቃዳን፥ ህንተ ሀናና። <verse eid="ISA 1:30"/><verse number="31" style="v" sid="ISA 1:31"/>ምኑ ዳላ ግዳናዋ፤ አ ኦሱካ ጺፋ ግዳናዋ፤ ኡንቱንቱ እትፐ ጹገታናዋንታ፤ ሄ ታማ ቶይስያዌ ያና።<verse eid="ISA 1:31"/></para>
  <chapter eid="ISA 1"/>
  <chapter number="2" style="c" sid="ISA 2"/>
  <para style="ms">ይሁዳዉነ እስራኤልያዉ አዳ ኪታቱዋ</para>
  <para style="mr">(<ref loc="ISA 2:1-5:30">2:1—5:30</ref>)</para>
  <para style="s1">መና ሳሮተ</para>
  <para style="r">(<ref loc="MIC 4:1-3">ሚክ. 4:1-3</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 2:1"/>ይሁዳ ቢታባነ የሩሳላመ ካታማባ አሞጻ ናአይ እስያስ በኤዳዌ ሀዋ።<verse eid="ISA 2:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 2:2"/>ዉርሰ ጋላሳቱዋን መና ጎዳ ጌሻ ጎሊ ኬጸቴዳ ደሪ ደረቱዋ ኡባፐ ቂደ ቤታና፤ ዞዘቱዋ ኡባቱዋፐካ ቦላና ቁ ቁ ጋና። ካዉተቱዋን ደእያ አሳይ ኡባይ አኮ ዛታና። <verse eid="ISA 2:2"/><verse number="3" style="v" sid="ISA 2:3"/>ዳሮ አሳይ ዪደ፥ “ሃይተ! መና ጎዳ ደርያ፥ ያቆባ መና ጎዳ ጌሻ ጎልያ አነ ፑደ ከሶይተ። እ ኮይያዋዳን ኑን ባና ማላ፥ እ ኑና ባረ ኦግያ ታማርሳና” ያጋና። አያዉ ጎፐ፥ ህጊ ጽዮነፐ፥ ጾሳ ቃላይካ የሩሳላመፐ ከሳና። <verse eid="ISA 2:3"/><verse number="4" style="v" sid="ISA 2:4"/>ካዉተቱዋፐነ ካዉተቱዋፐ ግዱዋን እ ፕርዳናነ ዳሮ አሳቱዋ ፓሉምያ ሻካና።<note caller="-" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="JOL 3:10">ኢዩ. 3:10</ref></char></note> ኡንቱንቱ ባረንቱ ማሻ ማራሻ፥ ባረንቱ ቶራካ ባጫ ከሳናዉ ቆጻና። ካዉተይ ካዉተ ቦላ ማሻ ደንና። ሄዋፐ ጉይያን ኡንቱንቱ ሙለካ ኦላ ትምርትያ ታማርክኖ።<verse eid="ISA 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 2:5"/>ህንተኖ፥ ያቆባ ዛረቶ፥ ሃይተ! አነ መና ጎዳ ፖኡዋን ሀመቶይተ።<verse eid="ISA 2:5"/></para>
  <para style="s1">መና ጎዳ ጋላሳ</para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 2:6"/>ጾሳዉ፥ ነ አሳ፥ ያቆባ ዛራቱዋ አጋዳ። ኡንቱንቱ አዋይ ዶልያ ባጋ ጋድያ አሳቱዋ ቢታን ኩሜድኖ፤ ፕልስጼማ አሳቱዋዳን ካዪኖ። ኡንቱንቱ አላጋ አሳቱዋና እትፐ ዙፐቲኖ። <verse eid="ISA 2:6"/><verse number="7" style="v" sid="ISA 2:7"/>ኡንቱንቱ ጋዲ ብራይነ ዎርቃይ ኩሜዳዋ፤ ኡንቱንቱ ሻሎ ዛዋይ ባዋ። ኡንቱንቱ ጋዲ ፓራይ ኩሜዳዋ፤ ኡንቱንቱ ፓራ ጋረቶ ዛዋይ ባዋ። <verse eid="ISA 2:7"/><verse number="8" style="v" sid="ISA 2:8"/>ኡንቱንቱ ጋዲ ኤቃቱዋን ኩሜዳዋ፤ ኡንቱንቱ ባረንቱ ኩሺ ኦዳ ኦሶ ሆኪደ ጎይኒኖ።<verse eid="ISA 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 2:9"/>ሄዋ ድራዉ፥ አሳይ ኡባይ ቶሸታናነ ካዉሻና። ኡንቱንቶ አቶ ጎፓ።<verse eid="ISA 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 2:10"/>መና ጎዳ ዳጋማፐነ አ አንጋ ቦንቹዋፐ አታናዉ ዛላኮ ቢተ፤ ቢታ ግዶን ቆሰትተ!<note caller="-" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="REV 6:15">ሳፃ 6:15</ref>፤ <ref loc="2TH 1:9">2 ተስ. 1:9</ref></char></note> <verse eid="ISA 2:10"/><verse number="11" style="v" sid="ISA 2:11"/>አሳ ኦቶሩ ጊያና፤ አ ክላሁካ ሲላና፤ ሄ ጋላስ መና ጎዳ ጻላላይ ቁ ቁ ጋና። <verse eid="ISA 2:11"/><verse number="12" style="v" sid="ISA 2:12"/>ኡባፐ ዎልቃማ መና ጎዳይ እት ጋላሳ ኬሬዳ። ሄ ጋላስ ኦቶረትያዋንታ፥ አይያዋንታነ ቁ ቁ ጌዳዋንታ ካዉሻና፤ <verse eid="ISA 2:12"/><verse number="13" style="v" sid="ISA 2:13"/>አዱሳነ ቃ ግድያ ሊባኖሳ ዝጋቱዋነ ባሳነ ዎላ ኡባ ይሳና፤ <verse eid="ISA 2:13"/><verse number="14" style="v" sid="ISA 2:14"/>ቃ ደረቱዋካ ዞዘቱዋካ ደምባያና፤ <verse eid="ISA 2:14"/><verse number="15" style="v" sid="ISA 2:15"/>ካታማ ናግያ አዱሳ ሚጻቱዋ ኡባነ ካታማ ዩሹዋን ደእያ ምኖ ግምበቱዋ ዝቂሳና፤ <verse eid="ISA 2:15"/><verse number="16" style="v" sid="ISA 2:16"/>ጾሳይ ግታነ ሎእያ ማርካባቱዋካ ሃን ምትሳና። <verse eid="ISA 2:16"/><verse number="17" style="v" sid="ISA 2:17"/>አሳ ኦቶሩ ዝቂ ጋና፤ አ አዩካ ያና። ሄ ጋላስ መና ጎዳ ጻላላይ ቁ ቁ ጋና፤ <verse eid="ISA 2:17"/><verse number="18" style="v" sid="ISA 2:18"/>ኤቃ ኡባይካ ኡባና ያና።<verse eid="ISA 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 2:19"/>መና ጎዳይ ሀ ጋድያ ቃናዉ ደንድያ ዎደ፥ አ ዳጋማፐነ አ አንጋ ቦንቹዋፐ አታናዉ አሳይ ሹቻ ጎንጎሎነ ቢታ ኦላዉ ባቃታና። <verse eid="ISA 2:19"/><verse number="20" style="v" sid="ISA 2:20"/>ሄ ጋላስ አሳይ ጎይናናዉ መዳ ባረንቱ ብራ ምስለቱዋነ ባረንቱ ዎርቃ ምስለቱዋ ኦጮቶነ ሀራ ካፎቶ ኦላና። <verse eid="ISA 2:20"/><verse number="21" style="v" sid="ISA 2:21"/>መና ጎዳይ ሀ ጋድያ ቃናዉ ደንድያ ዎደ፥ አ ዳጋማፐነ አ አንጋ ቦንቹዋፐ አታናዉ ኡንቱንቱ ጎንጎሎ ግዶነ ሹቻ ኮፖ ግዶ ባቃታና።<verse eid="ISA 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 2:22"/>ስም ሀይቂያ አሳን አማነትያዋ አግተ! አሳይ አይ ማዳኔ?<verse eid="ISA 2:22"/></para>
  <chapter eid="ISA 2"/>
  <chapter number="3" style="c" sid="ISA 3"/>
  <para style="s1">የሩሳላመ ጋካና መቱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 3:1"/>በእተ፥ ጎዳይ፥ ኡባፐ ዎልቃማ መና ጎዳይ ምንጃነ ማዱዋ ላኡዋካ የሩሳላመፐነ ይሁዳፐ ድጋና ሀኔ። ካ ምንጃነ ሃ ምንጃ ኡባ፤ <verse eid="ISA 3:1"/><verse number="2" style="v" sid="ISA 3:2"/>ምኖቱዋነ ኦላንቻቱዋ፥ ዳናቱዋነ ትምቢትያ ኦድያዋንታ፥ ካይያዋንታነ ጭማቱዋ፥ <verse eid="ISA 3:2"/><verse number="3" style="v" sid="ISA 3:3"/>ኦላ ጋዳዋቱዋነ ጋድያ አይስያዋንታ፥ ዞርያዋንታ፥ ሂላትያዋንታነ ጭንጫ ብታንቻቱዋ ኡባ ድጋና ሀኔ።<verse eid="ISA 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 3:4"/>ታን ያላጋ አቱማ ናናቱዋ ኡንቱንቱ ካፑዋ ከሳና፤ ጉ ናናይ ኡንቱንታ ሞዳና። <verse eid="ISA 3:4"/><verse number="5" style="v" sid="ISA 3:5"/>አሳይ አሳ ቦላ፥ ሾሩ ሾሩዋ ቦላ ደንዲደ፥ እቱ እቱዋ ሱጋና። ያላጋይ ጭማ ቦላ፥ ካቴዳዌ ቦንቼቴዳዋ ቦላ ደንዳና።<verse eid="ISA 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 3:6"/>እት አሳይ ባረ አዉዋ ጎልያን ባረ እሻቱዋፐ እቱዋ ኦይቂደ፥ “ነዉ ማዩ ደኤ፤ ኔን ኑዉ ሱን ግዳ፤ ሀ ኮለቴዳ ሳኣ አዎተ አካ” ያጋና።<verse eid="ISA 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 3:7"/>እ ሄ ጋላስ ባረ ቃላ ቂሲደ፥ “ታናን ሊ ባዋ፤ ታ ሶን ቁም ዎይ ማዩ ባዋ፤ ህንተ ቦላ ታና ሱንፕተ” ያጋና።<verse eid="ISA 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 3:8"/>የሩሳላመ ጋንድጋሬ፤ ይሁዳይ ኩንዴ፤ አያዉ ጎፐ፥ ኡንቱንቱ ባረንቱ ኦዱዋንነ ባረንቱ ኦሱዋን መና ጎዳ ቦላ ደንዲደ፥ አ ቦንቹዋ ቶቺኖ። <verse eid="ISA 3:8"/><verse number="9" style="v" sid="ISA 3:9"/>ኡንቱንቱ ሶምኡዋ ማላይ ኡንቱንቱ ቦላ ማርካቴ፤ ኡንቱንቱ ባረንቱ ናጋራ ሶዶማ አሳዳን አዋዪኖ፤ ባረንቱ ናጋራ ቆስክኖ። ኡንቱንቶ አየ አና! አያዉ ጎፐ፥ ኡንቱንቱ ባረንቱ ቦላ ኢታባ አሄድኖ።<verse eid="ISA 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 3:10"/>ጽሎቶ፥ “ህንተዉ ሎአ ግዳናዋ” ጋደ ኦዳ፤ አያዉ ጎፐ፥ ኡንቱንቱ ባረንቱ ኦሱዋ አይፍያ ማና። <verse eid="ISA 3:10"/><verse number="11" style="v" sid="ISA 3:11"/>ኢታቶ አየ አና! ኡንቱንቶ ኢታና፤ አያዉ ጎፐ፥ ኡንቱንቱ ባረንቱ ኩሽያ ኦሱዋ ጋትያ አካና። <verse eid="ISA 3:11"/><verse number="12" style="v" sid="ISA 3:12"/>ያላጋቱ ታ አሳ ኡንኤኖ፤ ማጫ አሳቱካ ኡንቱንታ ሞዲኖ። ታ አሳዉ፥ ህንተና ካለያዋንቱ ህንተና ዎራ ካለኖ፤ ህንተ ብያ ኦግያካ ባለኖ።<verse eid="ISA 3:12"/></para>
  <para style="s1">ጾሳይ ባረ አሳ ፕርዳና</para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 3:13"/>መና ጎዳይ ዳናዳን፥ ችሎታን ኡቴ፤ አሳ ፕርዳናዉ ደንዴ። <verse eid="ISA 3:13"/><verse number="14" style="v" sid="ISA 3:14"/>አሳ ጭማቱዋነ ካለያዋንታ ፕርዳናዉ ሺሺደ፥ መና ጎዳይ፥ ኡባፐ ዎልቃማ መና ጎዳይ ሀዋዳን ያጌ፤ “ታ ዎይንያ ቱራ ቶኬዳሳ ባይዜዳዋንቱ ህንተና፤ ህዬሳቱዋፐ ቦንቄዳባይ ህንተ ጎልያን ደኤ። <verse eid="ISA 3:14"/><verse number="15" style="v" sid="ISA 3:15"/>ታ አሳ አያዉ ክንቼረቴ? ህዬሳቱዋ ሶምኡዋ አያዉ ጋጪቴ?” ያጌ ጎዳይ፥ ኡባፐ ዎልቃማ መና ጎዳይ።<verse eid="ISA 3:15"/></para>
  <para style="s1">ጾሳይ ጽዮነ ማጫ አሳቱዋ ሴሬዳ</para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 3:16"/>መና ጎዳይ ቃይካ፥ “ጽዮነ ማጫ አሳቱ ኦቶረቴድኖ፤ ባረንቱ ዚዝያ ኤስ አኪደ፥ ባረንቱ አይፍያን ስምኤቲደ፥ ባረንቱ ሀመ ማክሲደ፥ ባረንቱ ገድያ አልቡዋ ጊርሲደ ሀመቲኖ። <verse eid="ISA 3:16"/><verse number="17" style="v" sid="ISA 3:17"/>ሄዋ ድራዉ፥ ታን ጎዳይ ጽዮነ ማጫ አሳቱዋ ሁጲያ ጭቱዋን ጎእሳና። ታን መና ጎዳይ ኡንቱንቱ ሁጲያ ቦአያና” ያጌ።<verse eid="ISA 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 3:18"/>ሄ ጋላስ ጎዳይ ጽዮነ ማጫ አሳቱዋ አሌቆቱዋ፥ ሄዋንቱነ ኡንቱንቱ ገድያ አልቡዋ፥ ሻሽያ፥ ቆያ አሌቁዋ፥ <verse eid="ISA 3:18"/><verse number="19" style="v" sid="ISA 3:19"/>ሀይ ጉትቻ፥ ኩሽያ ሳጋዩዋ፥ ሶምኡዋ ካምያ ኩታ፥ <verse eid="ISA 3:19"/><verse number="20" style="v" sid="ISA 3:20"/>ሁጲያን ዎያ አሌቁዋ፥ ቀስያን ቃችያ ሳንሳላታ፥ ጼሳን ዳንጭያ ዳንጩዋ፥ ሽቱዋ ጻራሙስያ፥ ክታፋ፥ <verse eid="ISA 3:20"/><verse number="21" style="v" sid="ISA 3:21"/>ሲያ ምግዱዋ፥ ብራያነ <verse eid="ISA 3:21"/><verse number="22" style="v" sid="ISA 3:22"/>ምንጃ ማዩዋ፥ አዱሳ ማዩዋ፥ ጃኑዋ፥ ቦርሳ፥ <verse eid="ISA 3:22"/><verse number="23" style="v" sid="ISA 3:23"/>ሄረጋ፥ ሊኑዋ ግያ ቃጭናፐ ዳደቴዳ፥ ግዶና ማይያ ማዩዋ፥ ብናናን ዎያ አሌቁዋነ ሻርቢያ ኡባ ቦንቃ አካና።<verse eid="ISA 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 3:24"/>ሽቱዋ ድራዉ ጽንቁዋ ግዳናዋ፤ ዳንጩዋ ድራዉ ዎዶሩዋ፥ ጎፋርያ ድራዉ ቦኣ፥ አዱሳ ማዩዋ ድራዉ ዋሩዋ፥ ፑላ ድራዉ ባቂያ ጻላላ ግዳናዋ።<verse eid="ISA 3:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 3:25"/>ነ አሳቱ ማሻን፥ ነ ኦላንቻቱ ኦላን ሀይቃና። <verse eid="ISA 3:25"/><verse number="26" style="v" sid="ISA 3:26"/>ጽዮነ ፐንገቱዋን ደእያ አሳይ ዬካናነ ዝላላና፤ መላ አቴዳ፥ ጋድያን ኡታና።<verse eid="ISA 3:26"/></para>
  <chapter eid="ISA 3"/>
  <chapter number="4" style="c" sid="ISA 4"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 4:1"/>ሄ ጋላስ ላፑን ማጫ አሳቱ እት አቱማዋ ኦይቂደ፥ “ኑን ኑ ቁማ ማና፤ ኑ ማዩዋ ማያና፤ ነ ሱንን ጼሰታና ማላ ኦደ ኑ ካዉሻ ኑፐ ቃራርኪ” ያጊደ ዎሳና።<verse eid="ISA 4:1"/></para>
  <para style="s1">መና ጎዳይ የሩሳላመ ጌሻና</para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 4:2"/>ሄ ጋላስ መና ጎዳ ም ታሺ ሎአናነ ቦንቼታና፤ እስራኤልያ አሳፐ አቴዳዋንቶ ሄ ጋድያ ካይ ጬቆነ ቦንቹዋ ግዳናዋ። <verse eid="ISA 4:2"/><verse number="3" style="v" sid="ISA 4:3"/>ጽዮነን አትያዋንቱ፥ የሩሳላመን ጋምእያዋንቱ፥ የሩሳላመን ፓጻ ደእያዋንቱና ጻፈትያዋንቱ፥ “ኡንቱንቱ ጌሻቱዋ” ጌተታና። <verse eid="ISA 4:3"/><verse number="4" style="v" sid="ISA 4:4"/>ጎዳይ ጽዮነ ማጫ አሳቱዋ ቅታ ሜጫና፤ ፕርዳ አያናንነ ጹግያ አያናን ሱ ጉስያ ባይዙዋ የሩሳላመፐ እ ጌሻና። <verse eid="ISA 4:4"/><verse number="5" style="v" sid="ISA 4:5"/>መና ጎዳይ ጽዮነ ደርያ ኡባ ቦላነ ያን ሺቅያዋንቱ ቦላ ጋላስ ሻርያነ ጩዋ፥ ቃማ ኤጽያ ታማ ፖኡዋ መና፤ ቦንቹ ኡባ ቦላ ካምያዋ ግዳናዋ።<note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="EXO 13:21">ከሳ 13:21</ref>፤ <ref loc="EXO 24:16">24:16</ref></char></note> <verse eid="ISA 4:5"/><verse number="6" style="v" sid="ISA 4:6"/>እ ጋላሳ አዋ ሱሉዋፐ አሽያ ኩዋነ ጎትያፐነ እራፐ ባቃት አትያሳ ግዳናዋ።<verse eid="ISA 4:6"/></para>
  <chapter eid="ISA 4"/>
  <chapter number="5" style="c" sid="ISA 5"/>
  <para style="s1">ዎይንያ ቱራ ቶክያ ሳኣ ሌምሱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 5:1"/>ታን ታ ሲቅያዎ አ ዎይንያ ቱራ ቶክያ ሳኣዋ ሲቁዋ የ የጻና።<note caller="-" style="x"><char style="xo" closed="false">5:1-2 </char><char style="xt" closed="false"><ref loc="MAT 21:33">ማቶሳ 21:33</ref>፤ <ref loc="MRK 12:1">ማር. 12:1</ref>፤ <ref loc="LUK 20:9">ሉቃሳ 20:9</ref></char></note></para>
  <para style="b" vid="ISA 5:1"/>
  <para style="q1" vid="ISA 5:1">ታን ሲቅያዎ</para>
  <para style="q2" vid="ISA 5:1">ቱኤቴዳ ዞዝያን ዎይንያ ቱራ ቶክያ ሳአይ ደኤ።<verse eid="ISA 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 5:2"/>ቢታ ቦኪደ፥</para>
  <para style="q2" vid="ISA 5:2">ሹቻ ቆር ከሲደ፥</para>
  <para style="q1" vid="ISA 5:2">ኡባፐ ሎእያ ዎይንያ ቱራ ቶኬዳ።</para>
  <para style="q2" vid="ISA 5:2">ናግያ ሻኩዋ አ ግዶን ሻኬዳ፤</para>
  <para style="q2" vid="ISA 5:2">ዎይንያ ኤሳ ጉምኢያሳ ዎጪደ ጊግሴዳ።</para>
  <para style="q2" vid="ISA 5:2">ሄዋፐ ጉይያን፥ ሎኦ አይፍያ አይፌ፥</para>
  <para style="q2" vid="ISA 5:2">ያጊደ ናጌዳ፤</para>
  <para style="q2" vid="ISA 5:2">ሽን ጫልያ አይፍያ አይፌዳ።<verse eid="ISA 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 5:3"/>ያትና፥ ታ ሲቁ ሀዋዳን ያጌዳ፤</para>
  <para style="q2" vid="ISA 5:3">“ህንተኖ፥ የሩሳላመን ደእያዋንቶ፥</para>
  <para style="q1" vid="ISA 5:3">ህንተኖ፥ ይሁዳ አሳቶ፥</para>
  <para style="q2" vid="ISA 5:3">ታፐነ ታ ዎይንያ ቱራ ቶክያ ሳኣፐ ግዱዋን፥</para>
  <para style="q2" vid="ISA 5:3">ደእያ የዉዋ አነ ሀእ ፕርድተ።<verse eid="ISA 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 5:4"/>ታን ታ ዎይንያ ቱራ ሳአዉ ኦዳዋፐ</para>
  <para style="q2" vid="ISA 5:4">ሀራ አያ ኦናዌ አቴዴ?</para>
  <para style="q1" vid="ISA 5:4">ሎኦ አይፍያ አይፌ ያጋደ ናግሽን፥</para>
  <para style="q2" vid="ISA 5:4">አያዉ ጫልያ አይፍያ አይፌዴ?<verse eid="ISA 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 5:5"/>ሀእ ታን ታ ዎይንያ ቱራ ሳኣ፥</para>
  <para style="q2" vid="ISA 5:5">ኦያዋ ህንተንቶ ኦዳይ።</para>
  <para style="q1" vid="ISA 5:5">ታን ድርሳ ሾዳና፤</para>
  <para style="q2" vid="ISA 5:5">ሄ ቱራይካ ያናዳን ኦና።</para>
  <para style="q1" vid="ISA 5:5">ታን ግምቢያ ኮላና፤</para>
  <para style="q2" vid="ISA 5:5">ሄ ሳአይካ የታና።<verse eid="ISA 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 5:6"/>ታን ሄ ሳኣ ባዬዳ ቢታ ኦና።</para>
  <para style="q1" vid="ISA 5:6">ሄ ቱራይ ጹንቀተናነ ቡልኤተና፤</para>
  <para style="q2" vid="ISA 5:6">ያትና፥ ክንድቹነ አጉንይ ያን ሞካና።</para>
  <para style="q1" vid="ISA 5:6">እራይ አን ቡከናዳን፥ ታን ሻረቱዋ አዛዛና” ያጌዳ።<verse eid="ISA 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 5:7"/>ኡባፐ ዎልቃማ መና ጎዳይ፥</para>
  <para style="q2" vid="ISA 5:7">ዎይንያ ቱራ ሳአይ እስራኤልያ አሳ።</para>
  <para style="q1" vid="ISA 5:7">ይሁዳ አሳይ እ ናሸትያ ዳርኩዋ።</para>
  <para style="q2" vid="ISA 5:7">ኡንቱንቱ ሱረ ፕርዲኖ ጊደ ናጌዳ፤</para>
  <para style="q2" vid="ISA 5:7">ሽን ሱ ጉሴድኖ።</para>
  <para style="q2" vid="ISA 5:7">ጽሎተ ኦኖ ጊደ ናጌዳ፤</para>
  <para style="q2" vid="ISA 5:7">ሽን ዋሶ ግዴዳ።<verse eid="ISA 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 5:8"/>ሳአይ ይና፥ ህንተ ጻላላይ ጋድያ ቦላ ደአና ጋካናዉ፥ ጎልያ ጎልያ ቦላ ጉጅያዋንቶ፥ ጋድያ ጋድያና ጋያዋንቶ፥ ህንተንቶ አየ አና! <verse eid="ISA 5:8"/><verse number="9" style="v" sid="ISA 5:9"/>ኡባፐ ዎልቃማ መና ጎዳይ ታና ሀዋዳን ያጌዳ፤ “ሄ ዎልቃማ ጎለቱ ኦናና፤ ሄ ሎኦ ጎለቱዋን ደአናዉ አሳይ ያና። <verse eid="ISA 5:9"/><verse number="10" style="v" sid="ISA 5:10"/>ታሙ ዋ ቦራቱዋን ቶኬዳ ዎይንያ አይፍያፐ እት ኦቶ ግድያ ጉምኤቴዳ ዎይንያ ኤሳ ጻላላይ ከሳና፤ ታሙ ቁንአ ካ ዘርና፥ እት ቁንአ ካ ጻላላ አይፋና” ያጌዳ።<verse eid="ISA 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 5:11"/>ማይያ ኡሻ ኮያናዉ ዎንታ ጉራና ደንድያዋንቶነ ዎይንያ ኤሳን ጹገታና ጋካናዉ፥ ሳኣ ቃምስያዋንቶ አየ አና! <verse eid="ISA 5:11"/><verse number="12" style="v" sid="ISA 5:12"/>ኡንቱንቱ ሾብያን ማስንቁ፥ ዲይ፥ ዳርቢ፥ ህጽጺነ ዎይንያ ኤሳይ ደኤ፤ ሽን ኡንቱንቱ መና ጎዳ ኦሱዋ ጋተ ጊክኖ፤ እ ባረ ኩሽያን ኦዳዋ ቦንችክኖ። <verse eid="ISA 5:12"/><verse number="13" style="v" sid="ISA 5:13"/>ያትና፥ ታ አሳይ አኬካ ዬዳ ድራዉ፥ ኦሞደቲደ ባና፤ ኡንቱንቱ ጋድያ አይስያዋንቱካ ኮሻን ሀይቃና፤ ኡንቱንቱ አኮ አሳይካ ኮፕሳ መላና። <verse eid="ISA 5:13"/><verse number="14" style="v" sid="ISA 5:14"/>ዱፉ ባረ ጎምፓ አሴ፤ ባረ ዶናካ ዛዋይ ባይናዋ ሀንጌ፤ የሩሳላመን ደእያ ዎልቃማ አሳነ የንኮ ዳሮ አሳ፥ ዋጭያዋንታነ ናሸትያዋንታ ምታና።<verse eid="ISA 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 5:15"/>አሳይ ኡባይ ቶሸታናነ ካዉሻና፤ ኦቶረትያዋንቱ ኡባይካ ካዉሻና። <verse eid="ISA 5:15"/><verse number="16" style="v" sid="ISA 5:16"/>ሽን ኡባፐ ዎልቃማ መና ጎዳይ፥ ሱረ ፕርዳን ቁ ቁ ጋና፤ ጌሻ ጾሳይ ጌሻ ግድያዋ ባረ ጽሎተን በሳና። <verse eid="ISA 5:16"/><verse number="17" style="v" sid="ISA 5:17"/>ሄ ዎደ ዶርሳቱ ባረንቱ ቆሩዋን ሄመትያዋዳን ሄመታና፤ ዶርሳ ማራቱ ኮለቴዳ ዱረቱዋ ጎልያ ሳኣ ማና።<verse eid="ISA 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 5:18"/>ጭሙዋ ዎዶሩዋን ናጋራ፥ ጋርያ ዎዶሩዋን ኢታተ ጎችያዋንቶ አየ አና! <verse eid="ISA 5:18"/><verse number="19" style="v" sid="ISA 5:19"/>“አነ ጾሳይ ኤሌሎ! ኑን በአና ማላ፥ ባረ ኦሱዋ ኤሌልሶ! ጋ! ኤ፥ ኑን ኤራና ማላ፥ እስራኤልያ ጌሻይ ቆፔዳ ቆፋይ ፖለቶ” ያግያዋንቶ አየ አና!<verse eid="ISA 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 5:20"/>ኢታ ሎአ ሎኡዋ ኢታ ያግያዋንቶ፥ ማ ፖኦ ፖኡዋ ማ ኦያዋንቶነ ጫምያዋ ማልእያዋ ማልእያዋ ጫምያዋ ኦያዋንቶ አየ አና!<verse eid="ISA 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 5:21"/>ባረና፥ “ታን አዳ ኤራንቻ! ታን ጭንጫ ግድክታ!” ያግ ቆፕያዋንቶ አየ አና!<verse eid="ISA 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 5:22"/>ዎይንያ ኤሳ ኡሽያዋን ኤረቴዳዋንቶነ ማይያ ኡሻ ዋላካናዉ ጎብያዋንቶ አየ አና! <verse eid="ISA 5:22"/><verse number="23" style="v" sid="ISA 5:23"/>ማታይያ አኪደ፥ ባይዜዳዋንታ ጽልስያዋንቶነ ጽሎ አሳቶ ሱረ ፕርዳ ድግያዋንቶ አየ አና! <verse eid="ISA 5:23"/><verse number="24" style="v" sid="ISA 5:24"/>ታማ ላጩ ዳላ ኦይቂያዋዳንነ መላ ማታይ ኤጽ ይያዋዳን፥ ሄዋዳን ኡንቱንቱ ጻጱ ዎቃና፤ ኡንቱንቱ ጪሻይካ ባናዳን ላለት ያና፤ አያዉ ጎፐ፥ ኡንቱንቱ ኡባፐ ዎልቃማ መና ጎዳ ህግያ እጼድኖ፤ እስራኤልያ ጌሻ ቃላካ ካድኖ። <verse eid="ISA 5:24"/><verse number="25" style="v" sid="ISA 5:25"/>ሄዋ ድራዉ፥ መና ጎዳ ሀንቁ አ አሳ ቦላ ኤጽ ከሴ፤ እ ባረ ኩሽያ ኡንቱንቱ ቦላ ደንደ፥ ኡንቱንታ ሾጨዳ። ደረቱ ቃጺኖ፤ ሀይቄዳ አሳ አሃይ ኦግያን ቡራ ማላ ግዴ፤ ያንናካ አ ሀንቁ ስመና፤ አ ኩሺ ሀእካ ደንዴዳሳን ደኤ።<verse eid="ISA 5:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ISA 5:26"/>ጾሳይ ሃኩዋን ደእያ ካዉተቶ ማላታ ቃን ኤሴ፤ ሳኣ ጋጻን ደእያ ሞርከቱካ ሱይቄ። ኡንቱንቱካ ኤለካ ጃሚደ፥ ፑቱ ጊኖ። <verse eid="ISA 5:26"/><verse number="27" style="v" sid="ISA 5:27"/>ኡንቱንቱ ግዶን ዳቡርያባይነ ዎቢያባይ ባዋ፤ ኡንቱንቱፐ እቱነ ገምእሸና ዎይ ግሰና። ጼሳን ዳንጭያ ሳቂካ ብለተና፤ ኡንቱንቱ ጫማ ዳፉካ ዱጸና። <verse eid="ISA 5:27"/><verse number="28" style="v" sid="ISA 5:28"/>ኡንቱንቱ ቶራይ ሳታና ደኤ፤ ኡንቱንቱ ዎንዳፊካ ዋጸቴዳ። ኡንቱንቱ ፓራቱዋ ጹጉንይ ዛላ ሹቻ ማላ፤ ኡንቱንቱ ፓራ ጋረቱዋ ይንግረይ ጎትያ ማላ። <verse eid="ISA 5:28"/><verse number="29" style="v" sid="ISA 5:29"/>ኡንቱንቱ ጉዱካ ጋሞ ማላ፤ ዎዳላ ጋሞቱዋዳን ጉዲኖ፤ ኡንቱንቱ ዳሪደ፥ ባረዉ ምያዋ ኦይቂኖ፤ ቶክ አኪደ ቢኖ፤ ኡንቱንቱፐ ዎ አካናዌ ኦንነ ባዋ።<verse eid="ISA 5:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ISA 5:30"/>ሄ ጋላስ ኡንቱንቱ ዎልቃማ አባ ጉንዳን፥ እስራኤልያ ቦላ ጉማና፤ እት አሳይ ሄ ጋድያ ጼሎፐ፥ ማነ ዋይያ በአና፤ ፖኡካ ሻርያን ምተታና።<verse eid="ISA 5:30"/></para>
  <chapter eid="ISA 5"/>
  <chapter number="6" style="c" sid="ISA 6"/>
  <para style="ms">ኢስያሳ ኦሱዋን ቤቴዳ የዎቱዋ</para>
  <para style="mr">(<ref loc="ISA 6:1-9:7">6:1—9:7</ref>)</para>
  <para style="s1">ኢስያሳ ጼሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 6:1"/>ካቲ ኦዝያነ ሀይቄዳ ላይ ጎዳይ ቦላንነ ቃ አራታን ኡቴዳዋ በኣድ፤ አ ማዩ ጌሻ ጎልያ ኩሜዳ።<note caller="-" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="2KI 15:7">2 ካታ. 15:7</ref>፤ <ref loc="2CH 26:23">2 ኦዱዋ 26:23</ref></char></note> <verse eid="ISA 6:1"/><verse number="2" style="v" sid="ISA 6:2"/>ሱራፌላ ጌተትያ ኪታንቻቱ አፐ ቦላና ደኢኖ፤ እት እት ሱራፌልያዉ ኡሱፑን ቀፈቱ ደኢኖ፤ ላኡ ቀፈቱዋን ባረ ሶምኡዋ ካሜ፤ ላኡ ቀፈቱዋን ባረ ገድያ ካሜ፤ ላኡ ቀፈቱዋን ፓሌ። <verse eid="ISA 6:2"/><verse number="3" style="v" sid="ISA 6:3"/>እቱ እቱዋና፥ “ጌሻይ፥ ጌሻይ፥ ጌሻይ ኡባፐ ዎልቃማ መና ጎዳ! ሳኣ ኡባይ አ ቦንቹዋን ኩሜዳ” ያጊደ ጼሰቴድኖ።<note caller="-" style="x"><char style="xo" closed="false">6:3 </char><char style="xt" closed="false"><ref loc="REV 4:8">ሳፃ 4:8</ref></char></note> <verse eid="ISA 6:3"/><verse number="4" style="v" sid="ISA 6:4"/>ኡንቱንቱ ጼሳ ኮሻን ጌሻ ጎልያ ባሱ ቃጼዳ፤ ቃይ ጌሻ ጎሊ ጩዋን ኩሜዳ።<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="REV 15:8">ሳፃ 15:8</ref></char></note><verse eid="ISA 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 6:5"/>ያትና፥ ታን፥ “ታዉ አየ አና! ታን ባያድ፤ አያዉ ጎፐ፥ ታን ዶናይ ቱኔዳ አሳ፤ ቃይ ዶናይ ቱኔዳ አሳቱዋ ግዶን ደአይ፤ ታን ካትያ፥ ኡባፐ ዎልቃማ መና ጎዳ ታ አይፍያን በኣድ” ያጋድ።<verse eid="ISA 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 6:6"/>ሱራፌላቱዋፐ እቱ ያርሽያ ሳኣፐ ቃጴዳ ታማ ቦንቁዋ አኪደ ፓሊደ፥ ታኮ ዬዳ። <verse eid="ISA 6:6"/><verse number="7" style="v" sid="ISA 6:7"/>ታማ ቦንቁዋን ታ ዶና ቦቺደ፥ “በአ፤ ሀ ታማ ቦንቁ ነ ዶና ቦቼዳ፤ ነ ባይዙ ኔፐ ክቼዳ፤ ነ ናጋራይካ አቶ ጌተቴዳ” ያጌዳ።<verse eid="ISA 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 6:8"/>ሄዋፐ ጉይያን ጎዳይ፥ “ኦና ኪቶ? ኑዉ ኦኔ ባናዌ?” ያግሽን ስሳድ። ሄዌካ፥ “ሄኮ፥ ታና ኪታ” ያጋድ።<verse eid="ISA 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 6:9"/>ጎዳይ ሀዋዳን ያጌዳ፤ “ባ፤ ሀ አሳዉ፥ ‘ህንተ ስሳ ስሲታ፤ ሽን ህንተንቶ ገለና፤ ጼሉዋካ ጼሊታ፤ ሽን በእክታ’ ያጋደ ኦዳ።<note caller="-" style="x"><char style="xo" closed="false">6:9-10 </char><char style="xt" closed="false"><ref loc="MAT 13:14-15">ማቶሳ 13:14-15</ref>፤ <ref loc="MRK 4:12">ማር. 4:12</ref>፤ <ref loc="LUK 8:10">ሉቃሳ 8:10</ref>፤ <ref loc="JHN 12:40">ዮሃ. 12:40</ref>፤ <ref loc="ACT 28:26-27">ኪታ 28:26-27</ref></char></note> <verse eid="ISA 6:9"/><verse number="10" style="v" sid="ISA 6:10"/>ሀ አሳ ዎዛና ዶንጭልሳ፤ ኡንቱንቱ ሀይካ ቱልሳ፤ ኡንቱንቱ አይፍያካ ቆቅሳ፤ ሄዌ ዮፐ፥ ኡንቱንቱ ባረንቱ አይፍያን በአና፤ ባረንቱ ሀይን ስሳና፤ ባረንቱ ዎዛናንካ አኬካና፤ ያቲደ ኡንቱንቱ ታኮ ስማናነ ፓጻና” ያጌዳ።<verse eid="ISA 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 6:11"/>ያትና፥ ታን፥ “አቤት ጎዳዉ! ሀዌ አይደ ጋካናሴ?” ያጋድ።</para>
  <para style="p" vid="ISA 6:11">እ ዛረደ፥ “ካታማቱ ደእያ አሳ ዪደ፥ ኮለታና ጋካናሳ፥ ጎለቱካ ኦናና ጋካናዉነ ቢታይካ ኡባና መላ ግዳና ጋካናሳ። <verse eid="ISA 6:11"/><verse number="12" style="v" sid="ISA 6:12"/>ታን መና ጎዳይ አሳ ሃሳና፤ ቢታካ መላ ከሳና። <verse eid="ISA 6:12"/><verse number="13" style="v" sid="ISA 6:13"/>ታሙ አሳፐ እት አሳይ ጋድያ ቦላ አቶፐ፥ እካ ያና፤ ቃንጽ ድግና አቴዳ ዎላ ዱሩማ ማላ ግዳናዋ፤ ሄ ዱሩማይ ጌሻ ዘረ ግዳናዋ” ያጌዳ።<verse eid="ISA 6:13"/></para>
  <chapter eid="ISA 6"/>
  <chapter number="7" style="c" sid="ISA 7"/>
  <para style="s1">ካትያ አካዛዉ ዬዳ ኪታ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 7:1"/>ኦዝያና ናአይ እዮኣታም የሌዳ አካዝ ይሁዳ ጋድያን ካተቴዳ ዎደ፥ ሶርያ ጋድያ ካቲ ራጺንነ እስራኤልያ ጋድያ ካቲ ራማልያ ናአይ ፓቁህ የሩሳላመ ኦላናዉ ዬድኖ፤ ሽን ጾናናዉ ዳንዳይበይክኖ።<note caller="-" style="x"><char style="xo" closed="false">7:1 </char><char style="xt" closed="false"><ref loc="2KI 16:5">2 ካታ. 16:5</ref>፤ <ref loc="2CH 28:5-6">2 ኦዱዋ 28:5-6</ref></char></note><verse eid="ISA 7:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 7:2"/>ሶርያ ጋዲ ኤፍሬማ ቢታና እትፐ ኦላዉ ጫቀቴዳዋ ዳዊታ ዛርያፐ ካተቴዳ ካቲ ስሴዳ ዎደ፥ ደርያን ጫርኩ ቃያ ምዳን፥ አካዛ ዎዛናይነ አ አሳ ዎዛናይ ዳጋማን ሻቢረቴዳ።<verse eid="ISA 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 7:3"/>ያትና፥ መና ጎዳይ ኢስያሳ፥ “ኔን ነ ናኣ ሻኣር-ያሹባ<note caller="+" style="f"><char style="fr" closed="false">7:3 </char><char style="fq" closed="false">ሻኣር-ያሹባ፦ </char><char style="ft" closed="false">ሀ ሱን ብለይ እብራዌዋን፥ “አማሬዳዋንቱ ስማና” (10:20-22 በእተ) ግያዋ።</char></note> አካደ፥ አካዛና ጋከታናዉ ባ፤ ማዩዋ ሜጭያዋንቱ ጎሻኮ አፍያ ኦግያ ማታን ቆሞና ደእያ ሺቄዳ ሃ ጼራን ኔን አ ደማና። <verse eid="ISA 7:3"/><verse number="4" style="v" sid="ISA 7:4"/>አዉ ሀዋዳን ያጋደ ኦዳ፤ ‘ናገታ፤ ህርጎፓ፤ ሶርያ አሳ፥ ካትያ ራጺናነ ራማልያ ናኣ ሀንቆ ያዮፓ፤ ነ ዎዛናይካ ሻባረቶፖ፤ አያዉ ጎፐ፥ ላኡ ካተቱ ታማፐ አደ ጩዋትያ ላኡ ም ዱሩማ ማላ።<verse eid="ISA 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 7:5"/>“ ‘ሶርያ ጋድያ አሳይ ኤፍሬማ አሳናነ ራማልያ ናኣና ነ ቦላ ኢታባ ማቀቲደ፥ <verse eid="ISA 7:5"/><verse number="6" style="v" sid="ISA 7:6"/>“አነ ይሁዳ ጋድያን ዎራጂደ፥ መንሬድነ ኑ ግዶን ሻኪደ፥ ጻብኤላ ናኣ ካዉቶ” ያጊኖ’ ያጋ” ያጌዳ።<verse eid="ISA 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 7:7"/>ግዶፐነ፥ ኡባ ሞድያ መና ጎዳይ ሀዋዳን ያጌ፤ “ሄ ኡንቱንቱ ማቁ ምነና፤ ሙለካ ሄዌ ፖለተናዋ። <verse eid="ISA 7:7"/><verse number="8" style="v" sid="ISA 7:8"/>አያዉ ጎፐ፥ ዳማስቁ ሶርያ ቢታዉ ሁጲያ፤ ካቲ ራጺንካ ዳማስቆ ካታማዉ ሁጲያ። ኡሱፑን ታማነ እቼሹ ላይ ግዶን ኤፍሬማ ጋዲ ቡንቼቲደ፥ ካዉተ ግደናን አታና። <verse eid="ISA 7:8"/><verse number="9" style="v" sid="ISA 7:9"/>ቃይ ሳማሪ ኤፍሬማ ቢታዉ ሁጲያ፤ ራማልያ ናአይ ሳማርያ ካታማዉ ሁጲያ፤ ህንተ አማኑዋን ምኒደ ኤቀናን ዮፐ፥ ህንተካ ኤቂክታ” ያጌ።<verse eid="ISA 7:9"/></para>
  <para style="s1">አማኑኤል ያናዋ በስያ ማላታ</para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 7:10"/>ቃይካ መና ጎዳይ አካዛዉ፤ <verse eid="ISA 7:10"/><verse number="11" style="v" sid="ISA 7:11"/>“መና ጎዳይ ነ ጾሳይ ነዉ ቦላ ሳሉዋፐ፥ ዎይ ጋርሳ ሳኣ ጪሙዋፐ እት ማላታ እማና ማላ ኦቻ” ያጌዳ። <verse eid="ISA 7:11"/><verse number="12" style="v" sid="ISA 7:12"/>ሽን አካዝ፥ “ኦችከ፤ መና ጎዳካ ፓጭከ” ያጌዳ።<verse eid="ISA 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 7:13"/>ያትና፥ እስያስ፥ “ህንተኖ፥ ዳዊታ ዛረቶ፥ ስስተ! ህንተ አሳ ዳቡርስያዌ አይ ጉጽና፥ ቃይ ታ ጾሳ ዳቡርሲቴ? <verse eid="ISA 7:13"/><verse number="14" style="v" sid="ISA 7:14"/>ያቶፐ፥ ጎዳይ ባረ ሁጲያን ህንተንቶ ማላታ እማና፤ ወዶራታ ሻሃራደ አቱማ ናኣ የላና፤ አ ሱንካ አማኑኤላ<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="fq" closed="false">አማኑኤላ፦ </char><char style="ft" closed="false">ሀ ሱን ብለይ እብራዌዋን፥ “ጾሳይ ኑናና ደኤ” ግያዋ።</char></note> ያጋደ ሱንና።<note caller="-" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="MAT 1:23">ማቶሳ 1:23</ref></char></note> <verse eid="ISA 7:14"/><verse number="15" style="v" sid="ISA 7:15"/>እ ኢታ እጻናዉነ ሎኡዋ ዶራናዉ ኤርያ ዎደ፥ መኤዳ ማነ ኤሳ ኡታና። <verse eid="ISA 7:15"/><verse number="16" style="v" sid="ISA 7:16"/>ሽን ናአይ ኢታ እጻናዉነ ሎኡዋ ዶራናዉ ኤራናፐ ካሰቲደ፥ ኔን ሎይ ያዬዳ ላኡ ካተቱ ቢታቱ ኮለት መላ ግዳና።<verse eid="ISA 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 7:17"/>“ኤፍሬማ ጋዲ ይሁዳ ጋድያፐ ሻከቶደፐ ዶምና ሀንቤና መቶ ዎድያ መና ጎዳይ ነ ቦላ፥ ነ አሳ ቦላነ ነ አዉዋ ጎልያ ቦላ አሀና፤ ሄ ያናዌካ አሶረ ጋድያ ካትያ” ያጌዳ።<verse eid="ISA 7:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 7:18"/>ሄ ጋላሳይ ጋክያ ዎደ፥ መና ጎዳይ ኡዱንጸቶ፥ ግብጼን ሃኮ ሻፋን ደእያ አሳቶ ማላታና፤ እ ማቱዋ፥ አሶረ ጋድያ አሳቱዋ ጼሳና። <verse eid="ISA 7:18"/><verse number="19" style="v" sid="ISA 7:19"/>ያትና፥ ኡንቱንቱ ኡባይካ ዪደ፥ ዛንጋራ ሾባን፥ ሹቻ ጎንጎሉዋን፥ አጉንይ ደእያ ቡራንነ ሃ ኦላን ኡታና።<verse eid="ISA 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 7:20"/>ሄ ጋላስ ጎዳይ ኤፍራጺሳ ሻፋፐ ሄፍን ባጋፐ ሁጲያ ቃንጽያ አሳ ጼሳና፤ እካ አሶረ ጋድያ ካትያ፤ እ ዪደ፥ ህንተ ሁጲያ ብናና፥ ህንተ አሳተ ብናናነ ህንተ ቡቻ ሜዳና።<verse eid="ISA 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 7:21"/>ሄ ጋላስ እት አሳይ መጽ እት ማ ሚዛነ ላኡ ዴሻቱዋ ጻላላ አሻና። <verse eid="ISA 7:21"/><verse number="22" style="v" sid="ISA 7:22"/>ግዶፐካ፥ ኡንቱንቱ ማጽያ ማይ ሎይ ዳሮ ግድያ ድራዉ፥ እ መኤዳ ማ ኡታና፤ ሄ ጋድያን አቴዳ አሳይ ኡባይካ መኤዳ ማነ ኤሳ ኡታና።<verse eid="ISA 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 7:23"/>ሄ ጋላስ እት ሻአ ብራን ዋሸትያ ሻአ ዎይንያ አኖቱ ደእያ ሳን ኡባን ክንድቹነ አጉን ጻላላይ ሞካና። <verse eid="ISA 7:23"/><verse number="24" style="v" sid="ISA 7:24"/>ቢታ ኡባን ክንድቹነ አጉንይ ኩሜዳ ድራዉ፥ አሳይ ያ ብያ ዎደ፥ ቶራነ ዎንዳፍያ ኦይቂደ ባና። <verse eid="ISA 7:24"/><verse number="25" style="v" sid="ISA 7:25"/>ካሰ ጎማን ቡልኤዳ ዞዘቱዋን ሀእ ክንድቹነ አጉንይ ኩሜዳ ድራዉ ያዪደ፥ እት አሳይነ ያ ቤና። መሂ የደትያሳነ ዶርሳይ ሄመትያሳ ግዳናዋ።<verse eid="ISA 7:25"/></para>
  <chapter eid="ISA 7"/>
  <chapter number="8" style="c" sid="ISA 8"/>
  <para style="s1">አሶረ ካትያ ዩሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 8:1"/>መና ጎዳይ ታና ሀዋዳን ያጌዳ፤ “ዎልቃማ ጻ ዋራቃታ አካደ፥ ‘ኦሞዶ ኤሌላ! ቦንቂያዉ ኤሌላ!’ ያጋደ፥ ናባበትያ ፕዶልያን ጻፋ። <verse eid="ISA 8:1"/><verse number="2" style="v" sid="ISA 8:2"/>ቄስያ ኦርዮናነ ይባራክያ ናኣ ዛካራሳ አማንያ ማርካቱዋ ኦደ ታን ሱንና” ያጌዳ።<verse eid="ISA 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 8:3"/>ሄዋፐ ጉይያን፥ ታን ትምቢትያ ኦድያ ታ ማቻትና ግሳድ፤ ያትና፥ አ ሻሃራደ እት ናኣ የላዱ፤ መና ጎዳይ ታና ሀዋዳን ያጌዳ፤ “አ ሱን፥ ‘ማሀር-ሻላል-ሀሽ-ባዝ’ ያጋደ ሱን። <verse eid="ISA 8:3"/><verse number="4" style="v" sid="ISA 8:4"/>ናአይ፥ ‘ታ አዎ፥ ታ አቴ’ ያጊደ ጼስያዋ ኤራናፐ ካሰ፥ አሶረ ጋድያ ካቲ ዳማስቆ ዱረተነ ሳማርያ ኦሞዱዋ አኪደ አፋና” ያጌዳ።<verse eid="ISA 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 8:5"/>መና ጎዳይ ቃይካ ታዉ ሀዋዳን ያጊደ ሃሳዬዳ፤ <verse eid="ISA 8:5"/><verse number="6" style="v" sid="ISA 8:6"/>“ሀ አሳይ ሎዳን ጎግያ ሳልሆማ ሃቱዋ እጺደ፥ ራጺናነ ራማልያ ናኣ ናሸቲደ አኬድኖ። <verse eid="ISA 8:6"/><verse number="7" style="v" sid="ISA 8:7"/>ሄዋ ድራዉ፥ ታን ጎዳይ ምኖነ ዳሮ ግድያ ኤፍራጺሳ ሃ፥ አሶረ ካትያ አ ቶራንቻቱዋ ኡባና አሀና ሀናይ። እ ሻፍያ ኡባ ኩሚደ ከሳና፤ ጋጻ ኡባ ማዪደ ጎጋና። <verse eid="ISA 8:7"/><verse number="8" style="v" sid="ISA 8:8"/>ክጺደ ጎጊደ፥ ይሁዳ ገላና፤ ኤሊደ ያና አና፤ ኩን ቆያ ጋካና። አቤት አማኑኤላ፥ ካፉ ባረ ቀፍያ ምጭያዋዳን፥ ሃ ኩን ነ ጋድያ ኡባ ቦላን ምጨታና” ያጌዳ።<verse eid="ISA 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 8:9"/>ህንተኖ ካዉተቶ፥ እትፐ ሺቅተ! ሽን ህንተ መኤረታና! ሃኮ ቢታ ኡባን ደእያ አሳቶ፥ ስስተ! ኦላዉ ጊግተ! ሽን ህንተ መኤረታና! ኤ፥ ኦላዉ ጊግተ፤ ሽን ህንተ መኤረታና! <verse eid="ISA 8:9"/><verse number="10" style="v" sid="ISA 8:10"/>ኦላ ኦለታናዉ ማቀትተ፤ ሽን ህንተ ማቁ ላለታና፤ ህንተ ሀልቹዋ ሃሳይተ፤ ሽን ህንተ ሀልቹዋ ሀላና፤ አያዉ ጎፐ፥ ጾሳይ ኑናና ደኤ።<note caller="+" style="f"><char style="fr" closed="false">8:10 </char><char style="fk" closed="false">ጾሳይ ኑናና ደኤ፦ </char><char style="ft" closed="false">ሀዌ እብራዌ ቃላን “አማኑኤላ” ግያዋ።</char></note><verse eid="ISA 8:10"/></para>
  <para style="s1">ጾሳን አማነቱሳ</para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 8:11"/>መና ጎዳይ ባረ ምኖ ኩሽያ ታ ቦላ ዎደ፥ ታዉ ሃሳዬዳ፤ ታን ሀ አሳ ኦግያ ካለና ማላ፥ ታና ሀዋዳን ያጊደ ሴሬዳ፤ <verse eid="ISA 8:11"/><verse number="12" style="v" sid="ISA 8:12"/>“ሀ አሳይ ማካላ ማቆ ግያዋ ኡባ ማካላ ማቆ ጎፕተ፤ ኡንቱንቱ ያይያባዉ ያዮፕተ ዎይ ዳጋሞፕተ።<note caller="-" style="x"><char style="xo" closed="false">8:12-13 </char><char style="xt" closed="false"><ref loc="1PE 3:14-15">1 ጰጽ. 3:14-15</ref></char></note> <verse eid="ISA 8:12"/><verse number="13" style="v" sid="ISA 8:13"/>ህንተ ጌሻ ጋናዉ በስያዌ ኡባፐ ዎልቃማ መና ጎዳ፤ ህንተ አዉ ያያናዉነ ዳጋማናዉ በሰ። <verse eid="ISA 8:13"/><verse number="14" style="v" sid="ISA 8:14"/>እ ጌሻ ሳ ግዳናዋ፤ ሽን ይሁዳ ጋድያ አሳዉነ እስራኤልያ ጋድያ አሳዉ እ ቢያ ሹቻነ ኩንድስያ ዛላ ግዳናዋ፤ የሩሳላመን ደእያ አሳዉ እ ግትያነ ጲረ ግዳናዋ።<note caller="-" style="x"><char style="xo" closed="false">8:14-15 </char><char style="xt" closed="false"><ref loc="1PE 2:8">1 ጰጽ. 2:8</ref></char></note> <verse eid="ISA 8:14"/><verse number="15" style="v" sid="ISA 8:15"/>ኡንቱንቱፐ ዳሩ በታና፤ ኩንዲደካ መአና፤ ጲርያን ኦይቀቲደካ ኦሞደታና” ያጌዳ።<verse eid="ISA 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 8:16"/>ታን ኦዴዳዋ ናጋ፤ ታ ኤርስያ ቆማቱ ግዶን ህግያ አታማ። <verse eid="ISA 8:16"/><verse number="17" style="v" sid="ISA 8:17"/>ታን ባረ ሶምኡዋ ያቆባ ዛራቱዋፐ ገንያ መና ጎዳ ናጋና፤ ቃይ አን አማነታና።<note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="HEB 2:13">እብራ. 2:13</ref></char></note><verse eid="ISA 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 8:18"/>ታናነ ታዉ መና ጎዳይ እሜዳ ናናቱዋ በእተ። ኑን ጽዮነ ደርያን ደእያ ኡባፐ ዎልቃማ መና ጎዳፐ እስራኤልያዉ ማላታነ ማርካ።<note caller="-" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="HEB 2:13">እብራ. 2:13</ref></char></note><verse eid="ISA 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 8:19"/>“ሳሱኪደነ ዙዙሚደ ሃሳይያ ሻሬቾቱዋነ ሞይትልያ ሃሳይስያዋንታ ኦችተ” ያጊደ ህንተና ዞርያ አሳይ ደኤ። ሀይቄዳዋንታ ፓጻ ደእያዋንቱባ ኦችያዋፐ፥ አሳይ ባረንቱ ጾሳ ኦቻናዉ በሰኔ? <verse eid="ISA 8:19"/><verse number="20" style="v" sid="ISA 8:20"/>ህግያነ ጾሳይ ኦድያዋ ስስተ! ሄ አሳቱ ሀ ቃላዳን ሃሳያና ዮፐ፥ ኡንቱንቶ ሳአይ ዎንተና።<verse eid="ISA 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 8:21"/>አሳይ ዋየቲድነ ኮሻቲደ፥ ጋድያን ቶይላካታና፤ ኡንቱንቱ ኮሻቴዳ ዎደ ይሎቲደ፥ ፑደ ጼሊደ ባረንቱ ካትያነ ባረንቱ ጾሳ ሸቃና። <verse eid="ISA 8:21"/><verse number="22" style="v" sid="ISA 8:22"/>ሳኣኮ ዱገ ጼሊደ፥ ዋይያ፥ ማነ ያሽያ ሾኑዋ በአና፤ ኡንቱንቱ ባራ ማዉ ኦለታና።<verse eid="ISA 8:22"/></para>
  <chapter eid="ISA 8"/>
  <chapter number="9" style="c" sid="ISA 9"/>
  <para style="s1">ስንፐ ካተታና ካትያ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 9:1"/>ግዶፐነ፥ ዋየቴዳዋንቶ ሀዋፐ ስንዉ መና።<note caller="-" style="x"><char style="xo" closed="false">9:1 </char><char style="xt" closed="false"><ref loc="MAT 4:15">ማቶሳ 4:15</ref></char></note> በን ዎደ ጾሳይ ዛብሎና ቢታነ ንፍታሌማ ጋድያ ካዉሼዳ፤ ሽን ስንፐ ሄ ሜድተራነ አባ ኦግያን ደእያ ቢታነ ዮርዳኖሳ ሻፋፐ ሄፍን ባጋን ደእያ “አይሁዳ ግደና አሳይ ደእያ ጋሊላ” ግያ ጋድያ እ ቦንቻና።<verse eid="ISA 9:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 9:2"/>ማን ሀመትያ አሳይ ዎልቃማ ፖኡዋ በኤዳ፤<note caller="-" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="MAT 4:16">ማቶሳ 4:16</ref>፤ <ref loc="LUK 1:79">ሉቃሳ 1:79</ref></char></note> ቃይ ባራ ማ ጋድያን ደእያዋንቶ ፖኡ ፖኤዳ።<verse eid="ISA 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 9:3"/>ኔን ካዉተ አሳ ዳርሳዳ፤ ኡንቱንቶ ናሸቻ ጉጃዳ፤ አሳይ ካ ጫክያ ዎደ ናሸትያዋዳን፥ ዎይ ኦሞዱዋ ግሺደ አክያ ዎደ ናሸትያዋዳን፥ ነ ስንን ናሸታና። <verse eid="ISA 9:3"/><verse number="4" style="v" sid="ISA 9:4"/>አያዉ ጎፐ፥ ኔን ምድያማ ጋድያ ጾኔዳ ጋላሳዳን፥ ኡንቱንታ ዴጽያ ሞርገ ም፥ ኡንቱንቱ ሀሽያ ሞርገ ምነ ኡንቱንታ ናቂያዋንቱ ጻምኣ መንሬዳ። <verse eid="ISA 9:4"/><verse number="5" style="v" sid="ISA 9:5"/>ዎራጅያ ኦላንቻቱዋ ጫማይነ ሱን ሙናቀቴዳ ማዩ ኡባይ ታማን ኤያባ ግዳናዋ። <verse eid="ISA 9:5"/><verse number="6" style="v" sid="ISA 9:6"/>ናአይ ኑዉ የለቴዳ! አቱማ ናእ ኑዉ እመቴዳ! ካዉተይ አ ሀሽያን ዎና፤ አ ሱንይ፥ “ማላልስያ ዞርያዋ፥ ዎልቃማ ጾሳ፥ መና አዉዋ፥ ሳሮተ ካፑዋ” ጌተታና። <verse eid="ISA 9:6"/><verse number="7" style="v" sid="ISA 9:7"/>አ ካዉተ ዳሩዋዉነ አ ሳሮተዉ ዛዋይ ባዋ፤<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="LUK 1:32-33">ሉቃሳ 1:32-33</ref></char></note> ሀችፐ ዶሚደ፥ መና ጋካናዉ፥ ሱረ ፕርዳንነ ጽሎተን ምንሳናዉነ ኤሳናዉ ዳዊታ ካተቱዋ አራታንነ አ ካዉተን እ ካተታና፤ ኡባፐ ዎልቃማ መና ጎዳ ምሹ ሄዋ ፖላና።<verse eid="ISA 9:7"/></para>
  <para style="ms">ይሁዳዉነ እስራኤልያዉ ጉጃ ኪታቱዋ</para>
  <para style="mr">(<ref loc="ISA 9:8-12:6">9:8—12:6</ref>)</para>
  <para style="s1">ጎዳ ሀንቁዋ</para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 9:8"/>ጎዳይ ያቆባ ዛራቱዋ ቦላ ፕርዳ ቃላ ኪቴዳ፤ እስራኤልያ ቦላ ኩንዴዳ። <verse eid="ISA 9:8"/><verse number="9" style="v" sid="ISA 9:9"/>አሳይ ኡባይ፥ ኤፍሬማ አሳይነ ሳማርያ ካታማን ደእያዋንቱ፥ አዩዋንነ ኦቶሩዋን ሃሳይያዋንቱ፥ ሀዋ ኦዳዌ ጎዳ ግድያዋ ኤራና። <verse eid="ISA 9:9"/><verse number="10" style="v" sid="ISA 9:10"/>ኡንቱንቱ፥ “ጹብያፐ ኬጸቴዳዋንቱ ኮለቴድኖ፤ ሽን ኑን ኡንቱንታ ዛረደ፥ ማሰቴዳ ሹቻቱዋን ኬጻና፤ ኤቱ ቃንጸቴድኖ፤ ሽን ኑን ኡንቱንቱ ሳኣን ዝጋቱዋ ላማና” ያጌድኖ።<verse eid="ISA 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 9:11"/>ሄዋ ድራዉ፥ መና ጎዳይ፥ ራአሶና ሞርከቱዋ ምንሳና፥ ኡንቱንቱና ኦለቴዳ ሞርከቱዋ ኡንቱንቱ ቦላ ደንዳ። <verse eid="ISA 9:11"/><verse number="12" style="v" sid="ISA 9:12"/>አዋይ ዶልያ ባጋፐ ሶርያ ጋድያ አሳቱነ አዋይ ዉልያ ባጋፐ ፕልስጼማ ጋድያ አሳቱ ባረንቱ ዶና ሀንጊደ፥ እስራኤልያ ሜድኖ። ሄ ኡባንካ ጾሳ ሀንቁ ስምቤና፤ አ ኩሺካ ብሮ ደንዴዳሳን ደኤ።<verse eid="ISA 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 9:13"/>ግዶፐነ፥ አሳቱ ባረና ሾጬዳዋኮ ስምበይክኖ፤ ኡባፐ ዎልቃማ መና ጎዳካ ኮይበይክኖ። <verse eid="ISA 9:13"/><verse number="14" style="v" sid="ISA 9:14"/>ሄዋ ድራዉ፥ መጽ እት ጋላስ መና ጎዳይ እስራኤልያፐ ሁጲያነ ጎይና፥ ቃ ዛምባ ዳሻነ ዝቃ ማቃ ቃንጻና። <verse eid="ISA 9:14"/><verse number="15" style="v" sid="ISA 9:15"/>ጭማቱነ ቦንቼቴዳዋንቱ ሁጲያ፤ ዎርዱዋ ታማርስያ ትምቢትያ ኦድያዋንቱ ጎይና። <verse eid="ISA 9:15"/><verse number="16" style="v" sid="ISA 9:16"/>ሀ አሳ ካለያዋንቱ፥ ዎራ ካለኖ፤ ኡንቱንታ ካልያዋንቱካ ባሊኖ። <verse eid="ISA 9:16"/><verse number="17" style="v" sid="ISA 9:17"/>ሄዋ ድራዉ፥ ጎዳይ ኡንቱንቱ ያላጋ አሳቱዋን ናሸተና፤ አዉ ባይና ናናቶነ አምኤቶ ቃረተና። አያዉ ጎፐ፥ አሳይ ኡባይ ኢታነ ጾሳ ኤረናዋ፤ አሳይ ኡባይ ባረ ዶናን ኢታባ ሃሳየ። ሄ ኡባንካ ጎዳ ሀንቁ ስምቤና፤ አ ኩሺካ ብሮ ደንዴዳሳን ደኤ።<verse eid="ISA 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 9:18"/>ኢታተይ ታማዳን ጹጌ፤ ክንድቹዋነ አጉን ም ይሴ፤ ስኬዳ ዎራይ ኤጽና፥ ጩዋይ ቱሳዳን ስት ጊደ፥ ፑደ ከሴ። <verse eid="ISA 9:18"/><verse number="19" style="v" sid="ISA 9:19"/>ኡባፐ ዎልቃማ መና ጎዳ ሀንቁዋን ጋዲ ጹገታናዋ፤ አሳይካ ታማን ኤያባ ማላ ግዳናዋ፤ ኦንነ ባረ እሻ አሻናዉ ቆፐና። <verse eid="ISA 9:19"/><verse number="20" style="v" sid="ISA 9:20"/>ኡንቱንቱ ኡሸቻ ባጋፐ ቦንቃና፤ ሽን ኮሻታና፤ ሀድርሳ ባጋፐ ማና፤ ሽን ካልክኖ፤ ኡንቱንቱ ባረንቱ የሌዳ ናናቱዋ ማና። <verse eid="ISA 9:20"/><verse number="21" style="v" sid="ISA 9:21"/>ምናሰ ኤፍሬማ፥ ኤፍሬምካ ምናሳ ማና፤ ኡንቱንቱ እትፐ ግዲደ፥ ይሁዳ ቢታ ሞርካና። ሄ ኡባንካ ጾሳ ሀንቁ ስምቤና፤ አ ኩሺካ ብሮ ደንዴዳሳን ደኤ።<verse eid="ISA 9:21"/></para>
  <chapter eid="ISA 9"/>
  <chapter number="10" style="c" sid="ISA 10"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 10:1"/>ኢታ ህግያ ከስያዋንቶነ ኡቁንያ ጹፍያ ጻፍያዋንቶ አየ አና! <verse eid="ISA 10:1"/><verse number="2" style="v" sid="ISA 10:2"/>ሄዋን ኡንቱንቱ ማንቆቱዋ ፕርዳ ጌላዪኖ፤ ህዬሳቱዋ ማታካ ሱጊኖ። ያቲደ አምኤቱዋ አቁዋነ አታ አዉ ባይና ናናቱዋካ ቦንቂኖ። <verse eid="ISA 10:2"/><verse number="3" style="v" sid="ISA 10:3"/>ሃኮ ጋድያፐ ይያ መቱዋን እ ህንተና ሙሪያ ዎደ፥ ዋኒቴ? ማዱዋ ደማናዉ ኦኮ ባቃቲቴ? ህንተ ዱረተ ሀቃን ቆሲቴ? <verse eid="ISA 10:3"/><verse number="4" style="v" sid="ISA 10:4"/>ህንተ ኦላን ሀይቃና፤ ቃቺደ ጎችና፥ ህንተ ባና። ሄዌ ኡባይ ሀንናካ፥ ጾሳ ሀንቁ ዉርቤና፤ ሙራናዉ እ ባረ ኩሽያ የድ ዎዳ።<verse eid="ISA 10:4"/></para>
  <para style="s1">አሶረ ካቲ ፕርደታና</para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 10:5"/>ጎዳይ ሀዋዳን ያጌ፤ “ታ ይሎ ጋትማ ግዴዳነ ታ ኤጽያ ሀንቆ ጻምኣ ግዴዳ አሶረ ጋድያ አሳዉ አየ አና!<note caller="-" style="x"><char style="xo" closed="false">10:5-34 </char><char style="xt" closed="false"><ref loc="ISA 14:24-27">ኢሳ. 14:24-27</ref>፤ <ref loc="NAM 1:1-3:19">ናሆማ 1:1—3:19</ref>፤ <ref loc="ZEP 2:13-15">ሶፎ. 2:13-15</ref></char></note> <verse eid="ISA 10:5"/><verse number="6" style="v" sid="ISA 10:6"/>ታን አሶረቱዋ ጾሳ ኤረና ካዉተ ቦላ ኪታና፤ ኡንቱንቱ ዱረታ ኡባ ኦሞዳናዳንነ ቦንቃናዳን፥ ቃይ ኦግያን ደእያ ኡርቃዳን፥ ኡንቱንታ የናዳን፥ ታና ሀንቀዳ አሳ ቦላ ታን አሶረቱዋ አዛዛና” ያጌዳ።<verse eid="ISA 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 10:7"/>ሽን አሶረ ካቲ ሀዋ ሀልችቤና፤ አ ዎዛናይካ ሀዋዳን ቆፕቤና። እ ሀልቼዳዌ ካዉተቱዋ ኡባና ይሳናሳ። <verse eid="ISA 10:7"/><verse number="8" style="v" sid="ISA 10:8"/>እ ጬቀቲደ፥ ሀዋዳን ያጌዳ፤ “ታ ጋዳዋቱ ኡባቱ ካትያ ግድክኖየ? <verse eid="ISA 10:8"/><verse number="9" style="v" sid="ISA 10:9"/>ካልኖ ካታማይ ካርካሚሻ ካታማ ማላ ግደኔየ? ሀማታ ካታማይ አርፋዳ ካታማ ማላ ግደኔየ? ሳማርያ ካታማይካ ዳማስቆ ካታማ ማላ ግደኔየ? <verse eid="ISA 10:9"/><verse number="10" style="v" sid="ISA 10:10"/>የሩሳላመንነ ሳማርያን ደእያ ማሰቴዳ ኤቃ ምስለቱዋፐ ዳርያ ምስለቶ ጎይንያ ካዉተቱዋ ሙራናዉ፥ ታን ታ ኩሽያ የዳድ። <verse eid="ISA 10:10"/><verse number="11" style="v" sid="ISA 10:11"/>ታን ሳማርያ ካታማ ቦላነ አን ደእያ ኤቃ ምስለቱዋ ቦላ ኦዳዋዳን፥ የሩሳላመ ካታማ ቦላነ አ ኤቃቱዋ ቦላ ኦክታየ?” ያጌዳ።<verse eid="ISA 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 10:12"/>ጎዳይ ጽዮነ ደርያ ቦላነ የሩሳላመ ቦላ ባረ ኦያ ኦሱዋ ኡባ ፖሌዳዋፐ ጉይያን፥ አሶረ ጋድያ ካትያ አ አዩዋነ አ ኦቶሩዋ ሙራና። <verse eid="ISA 10:12"/><verse number="13" style="v" sid="ISA 10:13"/>አያዉ ጎፐ፥ አሶረ ካቲ ሀዋዳን ያጌ፤ “ታ ኩሽያ ምኖተን፥ ታ አዳ ኤራተንነ ታዉ ደእያ አኬካን ታን ሀዋ ኡዳድ። ታን ካዉተቱዋ ግዶን ደእያ ዛዋቱዋ ሾዳድ፤ ኡንቱንቱ ቢታቱዋን ደእያ አሳ አቁዋ ቦንቃድ፤ ታ ምኖ ቀስያን፥ ካተቱዋ አራታቱዋን ኡቴዳዋንታ ኡባ ዱገ ዎድ። <verse eid="ISA 10:13"/><verse number="14" style="v" sid="ISA 10:14"/>አሳይ ካፉዋ ጎልያን ኩሽያ የድያዋዳን፥ ታን ካዉተ ዱረተ ቦላ ታ ኩሽያ የዳድ። ቃይ ዶገቲደ አቴዳ ቁቁለቱዋ ሺሽያዋዳን፥ ታን ቢታ ኡባ ሺሻድ። ፓላናዉ ባረ ቀፍያ ባቂያባይ፥ ዎይ ሃሳያናዉ ባረ ዶና ፖግያባይ፥ ዎይ ቃይ ዋስያዌ እቱነ ባዋ” ያጌዳ።<verse eid="ISA 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 10:15"/>ቱሙ ካልታይ ባረናን ቃንጽያ ብታንያፐ፥ “ታን አይ” ጋናዉ ዳንዳዪየ? ዎይ ማጋዚ ባረና ጎችያ ብታንያፐ፥ “ታን ዳራይ” ጊየ? ጻምአይ ባረና ኦይቂያ አሳ ደን? ጉፊ ኦይቂያ አሳይ ባይናን ሀመቲ? <verse eid="ISA 10:15"/><verse number="16" style="v" sid="ISA 10:16"/>ሄዋ ድራዉ፥ ጎዳይ፥ ኡባፐ ዎልቃማ መና ጎዳይ፥ አ ምኖ ቶራንቻቱዋ ቦላ ላፈያ ሀርግያ የዳና፤ አ ቦንቹዋፐ ጋርሳና ምሹ ኤጽያ ታማዳን ኤጽ ከሳና። <verse eid="ISA 10:16"/><verse number="17" style="v" sid="ISA 10:17"/>እስራኤልያ ፖኡ ታማ ግዳናዋ፤ እስራኤልያ ጌሻይካ ላጩዋ ግዳናዋ፤ ያቲደ አ አጉንነ አ ክንድቹዋ እት ጋላስ ጹጋናነ ማና። <verse eid="ISA 10:17"/><verse number="18" style="v" sid="ISA 10:18"/>ጾሳይ ባረ ዎራ ም ቦንቹዋነ ባረ አራዳ ጋድያ ቦንቹዋ ይሳና፤ ስም ሄዌ ሀርግያ አሳይ ስልያዋዳን ስላና። <verse eid="ISA 10:18"/><verse number="19" style="v" sid="ISA 10:19"/>አ ዎራን አታና ምቱ ሎይ ጉ ግድያ ድራዉ፥ እት ጉ ናአይካ ፓይድ ዉርሳናዋ።<verse eid="ISA 10:19"/></para>
  <para style="s1">አማሬዳዋንቱ ስሙዋ</para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 10:20"/>ሄ ጋላሳን እስራኤልያፐ አቴዳዋንቱ ባረና ሾጬዳዋንቱን ዘምፕክኖ፤ ሽን ኡንቱንቱ ቱሙዋፐ መና ጎዳን፥ እስራኤልያ ጌሻን ዘምፓና። <verse eid="ISA 10:20"/><verse number="21" style="v" sid="ISA 10:21"/>አተይ፥ ይሁዳ አሳ አተይ ዎልቃማ ጾሳኮ ስማና። <verse eid="ISA 10:21"/><verse number="22" style="v" sid="ISA 10:22"/>ኔኖ እስራኤልያዉ፥ ነ አሳይ አባ ማታን ደእያ ሻፍያ ኬሻ ግዶፐካ፥ ኡንቱንቱፐ አማሬዳዋንቱ ጻላላይ ስማና። ጽሎተይ ኩም ፓላሄዳ ባሻይ አዋየቴዳ።<note caller="-" style="x"><char style="xo" closed="false">10:22-23 </char><char style="xt" closed="false"><ref loc="ROM 9:27">ሮመ 9:27</ref></char></note> <verse eid="ISA 10:22"/><verse number="23" style="v" sid="ISA 10:23"/>ኤ፥ ጎዳይ፥ ኡባፐ ዎልቃማ መና ጎዳይ ሳኣ ኡባ ቦላን አሀናዉ ቃቼዳ ባሻ አሀና።<verse eid="ISA 10:23"/></para>
  <para style="s1">ጾሳይ አሶራ ሙራና</para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 10:24"/>ሄዋ ድራዉ፥ ጎዳይ፥ ኡባፐ ዎልቃማ መና ጎዳይ ሀዋዳን ያጌ፤ “ጽዮነን ደእያ ታ አሳቶ፥ ግብጼቱ ኦዳዋዳን፥ አሶረቱ ህንተና ጻምአን ሾጭያ ዎደነ ባረንቱ ጋትማ ህንተ ቦላ ደንያ ዎደ ያዮፕተ። <verse eid="ISA 10:24"/><verse number="25" style="v" sid="ISA 10:25"/>ጺ ጉ ዎድያፐ ጉይያን፥ ታን ህንተና ሀንቀትያዋ አጋና፤ ሄዋፐ ጉይያን፥ ታ ሀንቁ ኡንቱንታ ይሳናዉ ባና” ያጌ።<verse eid="ISA 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ISA 10:26"/>ኡባፐ ዎልቃማ መና ጎዳይ ኦሬባ ግያ ሹቻ ማታን ሚድያማቱዋ ሾጬዳዋዳን፥ ኡንቱንቱ ቦላ ልሱዋ ደንና። እ ግብጼን ኦዳዋዳን፥ ባረ ጋትማ አባ ቦላ ደንና። <verse eid="ISA 10:26"/><verse number="27" style="v" sid="ISA 10:27"/>ሄ ጋላስ፥ አ ቶኩ ህንተ ሀሽያፐ ዎና፤ አ ሞርገ ምይካ ህንተ ሞርግያፐ ክቻና። ህንተ ኦርዴዳ ድራዉ፥ ሞርገ ምይ መአና።<verse eid="ISA 10:27"/></para>
  <para style="s1">ዎራጅያዋንቱ ኦሌዳ ኦላ</para>
  <para style="p">
    <verse number="28" style="v" sid="ISA 10:28"/>ሞርክያ ዎታዳራቱ አታ ካታማ ገሌድኖ፤ ምግሮናን አድኖ፤ ባረንቱ ኦላ ሚሻካ ምክማሳ ካታማን ዎድኖ። <verse eid="ISA 10:28"/><verse number="29" style="v" sid="ISA 10:29"/>ኡንቱንቱ ጋድያ አያሳና ፕኒደ፥ ገባአ ካታማን አቄድኖ። ራማ ካታማን ደእያ አሳይ ኡባይ ኮኮሬዳ፤ ካትያ ሳኦላ ካታማን ግብአን ደእያ አሳይካ ባቃቴዳ። <verse eid="ISA 10:29"/><verse number="30" style="v" sid="ISA 10:30"/>ጋሊማ አሳዉ፥ ዋሱዋ ጹልስተ! ላይሻ አሳዉ፥ ስስተ! አናቶታ ካታማን ደእያ አሳዉ፥ ኦችያዋ ኦድተ! <verse eid="ISA 10:30"/><verse number="31" style="v" sid="ISA 10:31"/>ማድሜና ግያ ካታማ አሳይ ባቃቴዳ፤ ገቢማ አሳይካ ባረ ሸምፖ ቆሰቴዳ። <verse eid="ISA 10:31"/><verse number="32" style="v" sid="ISA 10:32"/>ሀቼ ሞርክያ ዎታዳራቱ ኖባ ካታማን ደኢኖ፤ ያን ኡንቱንቱ ባረንቱ ኩሽያ ቃደ፥ ጽዮነ ደርያ፥ የሩሳላመ ካታማ ባብሲኖ።<verse eid="ISA 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ISA 10:33"/>በእተ፥ ጎዳይ፥ ኡባፐ ዎልቃማ መና ጎዳይ ቃንካቱዋ ዎልቃማ ዎልቃን ቃንጻና፤ አዱቄዳ ምቱካ ቃንጸታና፤ ቃይ ቦንቼቴዳዋንቱካ ካዉሻና። <verse eid="ISA 10:33"/><verse number="34" style="v" sid="ISA 10:34"/>ጾሳይ ስኬዳ ዎራ ካልታን ቃንጻና፤ ሊባኖስካ ዎልቃማ ስንን ኩንዳና።<verse eid="ISA 10:34"/></para>
  <chapter eid="ISA 10"/>
  <chapter number="11" style="c" sid="ISA 11"/>
  <para style="s1">ሳሮተይ ኩሜዳ ካዉተ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 11:1"/>እሰይ ዱሩማፐ አጫይ ከሳና፤ አ ጻጱዋፐ አይፍያ ታሺ ከሳና።<note caller="-" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="REV 5:5">ሳፃ 5:5</ref>፤ <ref loc="REV 22:16">22:16</ref></char></note> <verse eid="ISA 11:1"/><verse number="2" style="v" sid="ISA 11:2"/>መና ጎዳ አያናይ፥ አዳ ኤራተነ አኬካ አያናይ፥ ዞርያነ ዎልቃ አያናይ፥ ኤራተነ መና ጎዳዉ ያይያ አያናይ አ ቦላ ሸምፓና። <verse eid="ISA 11:2"/><verse number="3" style="v" sid="ISA 11:3"/>መና ጎዳዉ ያይያዋን እ ናሸቴ፤ ባረ አይፊ በኤዳዋን ጮ ፕርደና፤ ዎይ ባረ ሀይይ ስሴዳዋን ጮ ፕርደና። <verse eid="ISA 11:3"/><verse number="4" style="v" sid="ISA 11:4"/>ሽን ህዬሳቶ እ ጽሉዋን ፕርዳና፤<note caller="-" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="2TH 2:8">2 ተስ. 2:8</ref></char></note> ሳኣን ደእያ መቶታንቻቱ የዉዋካ እ ሱረተን ፕርዳና። እ ባረ እንጻርሳ ጋትማን ሳኣ ሾጫና፤ ባረ ዶና ሸምፑዋን ኢታቱዋ ዎና። <verse eid="ISA 11:4"/><verse number="5" style="v" sid="ISA 11:5"/>ጽሎተይ አ ጼሳዉ ዳንጮ ግዳናዋ፤ አማነትያዌካ አ ምይያዉ ሳቂያ ግዳናዋ።<note caller="-" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="EPH 6:14">ኤፈ. 6:14</ref></char></note><verse eid="ISA 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 11:6"/>ጄሪ ዶርሳ ማራና እትፐ ደአና፤<note caller="-" style="x"><char style="xo" closed="false">11:6-9 </char><char style="xt" closed="false"><ref loc="ISA 65:25">ኢሳ. 65:25</ref></char></note> ማሂካ ዴሻ ማራና እትፐ ግሳና፤ ሚዛ ማራና፥ ጋሙዋ ማራናነ እትፐ ሄመታና፤ ጉ ናእ ኡንቱንታ ሄማና። <verse eid="ISA 11:6"/><verse number="7" style="v" sid="ISA 11:7"/>ሚዛታነ ባባን ጌተትያ ዶአይ እትፐ ማና፤ ኡንቱንቱ ማራቱካ እትፐ ግሳና፤ ጋሙ ቦራዳን ኡቱላ ማና። <verse eid="ISA 11:7"/><verse number="8" style="v" sid="ISA 11:8"/>ን ምያ ናአይ ሾሻ ኦላን ካአና፤ ን ዱዳ ናአይ ዎያ ሾሻ ኦላን ባረ ኩሽያ የዳና። <verse eid="ISA 11:8"/><verse number="9" style="v" sid="ISA 11:9"/>ታ ጌሻ ደርያን ኦንነ ቆሄተና፥<note caller="-" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="HAB 2:14">እምባ. 2:14</ref></char></note> ዎይ ባየና፤ አያዉ ጎፐ፥ አባይ ሃን ኩምያዋዳን፥ ሳአይ መና ጎዳ ኤርያዋን ኩማና።<verse eid="ISA 11:9"/></para>
  <para style="s1">በቴዳ አሳይ ስምያ ስሙዋ</para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 11:10"/>ሄ ጋላስ እሰይ ጻጱ አሳዉ ማላታ ግዲደ ኤቃና፤ ካዉተ ኡባይ አ ኮያና፤ እ ደእያ ሳአይካ ቦንቼታና።<note caller="-" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="ROM 15:12">ሮመ 15:12</ref></char></note> <verse eid="ISA 11:10"/><verse number="11" style="v" sid="ISA 11:11"/>ሄ ጋላስ ጎዳይ ባረ አሳ አቶተ አሶረፐ፥ ግብጼፐ፥ ፓትሮሳፐ፥ ቶጵያፐ፥ ኤላማፐ፥ ባብሎነፐ፥ ሀማታፐነ አባ ዶናን ደእያ ቢታቱዋፐ ላኤንዋ ዛር አካናዉ ባረ ኩሽያ የዳና። <verse eid="ISA 11:11"/><verse number="12" style="v" sid="ISA 11:12"/>ካዉተቶ ማላታ እ ቁ ኦደ ደንና፤ እስራኤልያፐ ላለቴዳዋንታ እትፐ ጋና፤ ይሁዳፐ ፕስክ ጌዳዋንታካ ሳኣ ኦይዱ ሚዛናፐ እ ሺሻና።<verse eid="ISA 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 11:13"/>ሄዋፐ ጉይያን፥ ኤፍሬማ ቃናቲ አፐ ሻከታና፤ ቃይ ይሁዳ ዋይስያዋንቱካ ቆለት ያና። ኤፍሬመ ይሁዳ ቃናተና፤ ይሁዳይካ ኤፍሬማ ዋይሰና። <verse eid="ISA 11:13"/><verse number="14" style="v" sid="ISA 11:14"/>ኡንቱንቱ አዋይ ዉልያ ባጋን ደእያ ፕልስጼማ ጋድያ ቦላ ፓሊደ ዎና፤ አዋይ ዶልያ ባጋን ደእያ አሳካ ኡንቱንቱ እትፐ ቦንቃና። ኡንቱንቱ ኤዶማ ቦላነ ሞኣባ ቦላ ባረንቱ ኩሽያ ዎና፤ አሞናቱካ ኡንቱንቶ አዛዘታና። <verse eid="ISA 11:14"/><verse number="15" style="v" sid="ISA 11:15"/>መና ጎዳይ ግብጼ ምይያን ደእያ ዞኦ አባ ኡባና መልሳና፤ ባረ ላጽያ ጫርኩዋና ባረ ኩሽያ ኤፍራጺሳ ሻፋ ቦላ ደንና። ያቲደ አሳይ መላ ኤለካ ፕናና ማላ፥ ላፑን ቄር ሻፋ ከሲደ ሾጫና።<note caller="-" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="REV 16:12">ሳፃ 16:12</ref></char></note> <verse eid="ISA 11:15"/><verse number="16" style="v" sid="ISA 11:16"/>እስራኤልያ አሳይ ግብጼ ጋድያፐ ከስያ ዎደ ኦጊ ደኤዳዋዳን፥ አ አሳፐ አቴዳዋንቶ አሶረ ጋድያፐ ከስያ ኦጊ ደአናዋ።<verse eid="ISA 11:16"/></para>
  <chapter eid="ISA 11"/>
  <chapter number="12" style="c" sid="ISA 12"/>
  <para style="s1">ጋላታ የ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 12:1"/>ሄ ዎደ ህንተ ሀዋዳን ያጋና፦</para>
  <para style="b" vid="ISA 12:1"/>
  <para style="q1" vid="ISA 12:1">“አቤት መና ጎዳዉ፥ ኔን ታና ሀንቀታዳ፤</para>
  <para style="q2" vid="ISA 12:1">ሀንቁዋፐካ ስማዳ፤</para>
  <para style="q2" vid="ISA 12:1">ያታደ ታና ምንዳ።</para>
  <para style="q2" vid="ISA 12:1">ሄዋ ድራዉ፥ ታን ኔና ጋላታይ።<verse eid="ISA 12:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 12:2"/>“በእተ፥ መና ጎዳይ ታ አቶተ፤<note caller="-" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="EXO 15:2">ከሳ 15:2</ref>፤ <ref loc="PSA 118:14">ማዝ. 118:14</ref></char></note></para>
  <para style="q2" vid="ISA 12:2">ታን አን አማነታደ፥ ያይከ።</para>
  <para style="q1" vid="ISA 12:2">አያዉ ጎፐ፥ መና ጎዳይ፥</para>
  <para style="q2" vid="ISA 12:2">ታዉ ዎልቃነ የ።</para>
  <para style="q1" vid="ISA 12:2">እ ታ አቶተ ግዴዳ”</para>
  <para style="m" vid="ISA 12:2">ያጋና።<verse eid="ISA 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 12:3"/>አሽያ ፑልቶቱዋፐ ሃ ህንተ ናሸቻን ዱቃና። <verse eid="ISA 12:3"/><verse number="4" style="v" sid="ISA 12:4"/>ሄ ጋላስ ቃይ ህንተ ሀዋዳን ያጋና፦</para>
  <para style="b" vid="ISA 12:4"/>
  <para style="q1" vid="ISA 12:4">“መና ጎዳ ጋላትተ!</para>
  <para style="q2" vid="ISA 12:4">አ ሱንካ ጼስተ።</para>
  <para style="q1" vid="ISA 12:4">አ ኦሶቱዋ ካዉተቱዋ ኡባ ግዶን ኤርስተ።</para>
  <para style="q2" vid="ISA 12:4">አ ሱንይ ቁ ቁ ጌዳዋ አዋይተ።<verse eid="ISA 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 12:5"/>መና ጎዳይ ዎልቃማ ኦሱዋ ኦዳ ድራዉ፥</para>
  <para style="q2" vid="ISA 12:5">አዉ የጽተ።</para>
  <para style="q1" vid="ISA 12:5">ሀዌ ሳኣ ኡባን ኤረቶ።<verse eid="ISA 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 12:6"/>እስራኤልያ ጌሻይ ህንተ ግዶን</para>
  <para style="q2" vid="ISA 12:6">ቁ ቁ ጌዳ ድራዉ፥</para>
  <para style="q2" vid="ISA 12:6">ህንተኖ፥ ጽዮነን ደእያዋንቶ፥</para>
  <para style="q2" vid="ISA 12:6">ሆምቦጭተ! ናሸቻዉ የጽተ!”</para>
  <para style="m" vid="ISA 12:6">ያጋና።<verse eid="ISA 12:6"/></para>
  <chapter eid="ISA 12"/>
  <chapter number="13" style="c" sid="ISA 13"/>
  <para style="s1">ጾሳ ሙራይ ሀራ አሳቱዋ ቦላ</para>
  <para style="r">(<ref loc="ISA 13:1-23:18">13:1—23:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 13:1"/>አሞጻ ናኣ ኢስያሳ ዉ ጾሳይ ባብሎነዋ ቆንጭስና በኤዳዌ ሀዋ።<note caller="-" style="x"><char style="xo" closed="false">13:1—14:23 </char><char style="xt" closed="false"><ref loc="ISA 47:1-15">ኢሳ. 47:1-15</ref>፤ <ref loc="JER 50:1-51:64">ኤር. 50:1—51:64</ref></char></note><verse eid="ISA 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 13:2"/>መላ ደርያ ቦላ ባንድራ ኤስተ፤ ህንተ ቃላ ቁ ኦደ፥ ኡንቱንቶ ዋስተ፤ ኡንቱንቱ ካፓቱዋ ፐንግያና ገላና ማላ፥ ዉትተ። <verse eid="ISA 13:2"/><verse number="3" style="v" sid="ISA 13:3"/>ታን ሀንቀቴዳዋንታ ሙራና ማላ፥ ታ ጌሻቱዋ አዛዛድ፤ ታን ጾንያዋን ናሸትያ ታ ዎልቃማ ቶራንቻቱዋካ ጼሳድ።<verse eid="ISA 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 13:4"/>ጮራ አሳይ ጫቦትያዋዳን፥ ደርያ ሁጲያን ጫቦትያ ዋላሳ ስስተ! ቃይ ካዉተቱ እትፐ ሺቂደ ሻቢረትያ ዋላሳ ስስተ! ኡባፐ ዎልቃማ መና ጎዳይ ቶራንቻቱዋ ኦላዉ ሳልፕሴ። <verse eid="ISA 13:4"/><verse number="5" style="v" sid="ISA 13:5"/>መና ጎዳይነ እ ባረ ሀንቁዋ ፖልሳናዉ ጎኤትያ ሚሻቱ ቢታ ኡባ ይሳናዉ፥ ሃኮ ጋድያፐ፥ ሳሎቱዋ ጋጻፐ ዪኖ።<verse eid="ISA 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 13:6"/>መና ጎዳ ጋላሳይ ማቴዳ ድራዉ ዬክተ! ሄ ጋላሳይ ኡባፐ ዎልቃማ ጾሳ ማታፐ ባሻዳን ያና።<note caller="-" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false"><ref loc="JOL 1:15">ኢዩ. 1:15</ref></char></note> <verse eid="ISA 13:6"/><verse number="7" style="v" sid="ISA 13:7"/>ሄዋ ድራዉ፥ ኩሽያ ኡባይ ህልስ ጋና፤ አሳ ኡባ ዎዛናይካ ሲላና። <verse eid="ISA 13:7"/><verse number="8" style="v" sid="ISA 13:8"/>ኡንቱንቱ ዳጋማና፤ ኦይይነ ዬላይ ኡንቱንታ ኦይቃና። የሉ ኦይቄዳ ምሽራቲዳን፥ ኡንቱንቱ ኦይቀታና። ኡንቱንቱ ዳጋሚደ፥ እቱ እቱዋ ጼላና፤ ኡንቱንቱ ሶምኢካ ዳጋማን ቦጻና። <verse eid="ISA 13:8"/><verse number="9" style="v" sid="ISA 13:9"/>በእተ፤ መቀ ኢሲደ፥ ይሉዋንነ ሱሎ ሀንቁዋን ጋድያ መላ ከሳናዉነ አን ደእያ ናጋራንቻቱዋ ይሳናዉ፥ መና ጎዳ ጋላሳይ ዬ። <verse eid="ISA 13:9"/><verse number="10" style="v" sid="ISA 13:10"/>ሳሉዋ ጾልንተቱነ ጾልንተቱዋ ጭታቱ ባረንቱ ፖኡዋ እመናን እጻና፤ አዋ አይፊ ዶሊደ ማና፤ አግናይካ ፖኤናን አጋና።<note caller="-" style="x"><char style="xo" closed="false">13:10 </char><char style="xt" closed="false"><ref loc="EZK 32:7">ህዝ. 32:7</ref>፤ <ref loc="MAT 24:29">ማቶሳ 24:29</ref>፤ <ref loc="MRK 13:24-25">ማር. 13:24-25</ref>፤ <ref loc="LUK 21:25">ሉቃሳ 21:25</ref>፤ <ref loc="REV 6:12-13">ሳፃ 6:12-13</ref></char></note><verse eid="ISA 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 13:11"/>ጾሳይ ሀዋዳን ያጌ፥ “ታን ሀ ሳኣ አ ኢታተ ድራዉ፥ ኢታቱዋካ ኡንቱንቱ ናጋራ ድራዉ ሙራና። ታን ኦቶራንቻቶ ኦቶሩዋ ድጋና፤ መቀ ኢታቱዋ ኦቶሩዋካ ካዉሻና። <verse eid="ISA 13:11"/><verse number="12" style="v" sid="ISA 13:12"/>አቴዳ አሳይ አልኦ ዎርቃፐ አደ አልአና፤ ኦፊራ ዎርቃፐካ አደ አልአና። <verse eid="ISA 13:12"/><verse number="13" style="v" sid="ISA 13:13"/>ሄዋ ድራዉ፥ ኡባፐ ዎልቃማ መና ጎዳ ሀንቁዋን፥ አ ሀንቁዋ ሱሉዋ ጋላስ ታን ሳሎቱዋ ኮኮርሳና፤ ሳአይካ ባረ ደኢያሳፐ ካጻና” ያጌ።<verse eid="ISA 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 13:14"/>ሻንካፐ ባቃትያ ጋራዳን፥ ዎይ ሄምያ አሳይ ባይና ዶርሳ ዉድያዳን፥ አሳይ ኡባይ ባረ አሳኮ አሳኮ ስማና፤ ኡባይካ ባረ ቢታ ባቃታና። <verse eid="ISA 13:14"/><verse number="15" style="v" sid="ISA 13:15"/>ቤቴዳዌ ኦንነ ጫደታና፤ ኦይቀቴዳዌ ኦንነ ማሻን ሀይቃና። <verse eid="ISA 13:15"/><verse number="16" style="v" sid="ISA 13:16"/>ኡንቱንቱ ጉ ናናይ ኡንቱንቱ ስንን ቡሳከታና፤ ኡንቱንቱ ጎለቱካ ቦንቀታናዋ፤ ኡንቱንቱ ማጫ አሳቱዋናካ ዎልቃን ሀራ አቱማ አሳቱ ጋከታና።<verse eid="ISA 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 13:17"/>በእተ፥ ብራ ኮየና፥ ዎርቃንካ ናሸተና ሜዶና ጋድያ አሳቱዋ ታን ኡንቱንቱ ቦላን ደንና። <verse eid="ISA 13:17"/><verse number="18" style="v" sid="ISA 13:18"/>ኡንቱንቱ ዎንዳፈቱ ዎዳላቱዋ ዎኖ፤ ጉ ናናቱዋካ የድ ማርክኖ፤ ኡንቱንቱ አይፊ ፑርጋእያ ናናቶካ ቃረተና። <verse eid="ISA 13:18"/><verse number="19" style="v" sid="ISA 13:19"/>ካዉተቶ ቦንቹዋ፥ ቃይ ባብሎነ አሳዉካ አሌቆነ አዉ ግዴዳ ባብሎነ ጋድያ ጾሳይ ሶዶማዳንነ ጋሞራዳን አ የጋና።<note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="GEN 19:24">ዶመ 19:24</ref></char></note> <verse eid="ISA 13:19"/><verse number="20" style="v" sid="ISA 13:20"/>ሄ ጋድያን ሙለካ አሳይ ኡተና፤ ዎይ የለታፐ የለታ ጋካናዉካ ያን አሳይ ደኤና፤ አራባ አሳይካ ያን ባረ ዱንካንያ ቶለና፤ ዶርሳ ዉድያ ሄምያዋንቱካ ያን ባረንቱ ዉድያ አላጽሲኖ። <verse eid="ISA 13:20"/><verse number="21" style="v" sid="ISA 13:21"/>ሽን ያን ባዙዋ ዶአቱ አላጻና። ዎራካናቱ ኡንቱንቱ ጎልያ ኩማና፤ ጉታቱ ሄዋን ደአና፤ ባዙዋ ዴሻቱ ሄዋን ጉፓና።<note caller="-" style="x"><char style="xo" closed="false">13:21 </char><char style="xt" closed="false"><ref loc="ISA 34:14">ኢሳ. 34:14</ref>፤ <ref loc="ZEP 2:14">ሶፎ. 2:14</ref>፤ <ref loc="REV 18:2">ሳፃ 18:2</ref></char></note> <verse eid="ISA 13:21"/><verse number="22" style="v" sid="ISA 13:22"/>ኡንቱንቱ ጎለቱዋን ባባርቂ ዋሳና፤ ኡንቱንቱ ቦንቾ ካትያ ጎለቱዋንካ ዎራካናይ ቦጫና። አ ዎዲ ማታቴዳ፤ ጋላሳይካ ጋምኤና።<verse eid="ISA 13:22"/></para>
  <chapter eid="ISA 13"/>
  <chapter number="14" style="c" sid="ISA 14"/>
  <para style="s1">እስራኤልያ አሳይ ኦሞዱዋፐ ስማና</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 14:1"/>መና ጎዳይ እስራኤልያ አሳዉ ቃረታና፤ እስራኤልያካ ዛረደ ዶራና። ኡንቱንታ ኡንቱንቱ ቡዞ ጋድያን ዎና፤ እማቱ ዪደ ኡንቱንቱና ጋከቲደ፥ እስራኤልያ አሳና እትፐ ደአና። <verse eid="ISA 14:1"/><verse number="2" style="v" sid="ISA 14:2"/>ዳሮ ካዉተይ እስራኤልያ አሳ አኪደ፥ ኡንቱንቱ ሳኣ አሀና፤ እስራኤልያ አሳይ ካዉተቱዋ ማጫነ አቱማ ቆማዳን፥ መና ጎዳ ጋድያን ሞዳና። ኡንቱንቱ ባረና ኦሞዴዳዋንታ ኦሞዳና፤ ባረና ኡቁኔዳዋንታካ ሞዳና።<verse eid="ISA 14:2"/></para>
  <para style="s1">ባብሎነ ካቲ ዱፉዋን ገሌዳ ገሉሳ</para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 14:3"/>መና ጎዳይ ህንተና ህንተ ቱጋፐ፥ መቱዋፐነ ህንተ ሞደቴዳ ኢታ አይለተፐ ሸምፕሴዳ ጋላስ፥ <verse eid="ISA 14:3"/><verse number="4" style="v" sid="ISA 14:4"/>ህንተ ባብሎነ ካትያ ቦላ ሀዋዳን ያጊደ ቅሊጫና፤ “ኡቁንያዌ ዋን አጌዴ፤ አ ሀንቁዋ ሱሉካ ዋን አቴዴ! <verse eid="ISA 14:4"/><verse number="5" style="v" sid="ISA 14:5"/>መና ጎዳይ ካዉተቱዋ ጻምኣነ ሞድያዋንቱ ጋትማ መንዳ። <verse eid="ISA 14:5"/><verse number="6" style="v" sid="ISA 14:6"/>ኡንቱንቱ አሳ ዉርሰ ባይና ሀንቁዋን ሾጬድኖ። ባረንታ ጾኔዳ አሳቱዋ ቃንጸናን ኡንኤደ ደኤድኖ። <verse eid="ISA 14:6"/><verse number="7" style="v" sid="ISA 14:7"/>ቢታ ኡባይ ኡንቱንቱፐ ሸምፒደ፥ ዎፓን ደኤ፤ አሳይካ የ የጼ። <verse eid="ISA 14:7"/><verse number="8" style="v" sid="ISA 14:8"/>ሀራይ አትና፥ ዝጋቱካ ሊባኖሳ ጽደቱካ፥ ካትያ ኩንደን ናሸቲደ፤ ‘ኔን ካዉሻደ ዎደፐ፥ ኑና ቃንጻናዉ ይያዌ ባዋ’ ያጊኖ።<verse eid="ISA 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 14:9"/>“ኔን ይያ ዎደ፥ ስኦሊ ኔና ሞካናዉ ህርክን ጊጌዳ፤ እ ካሰ ጋድያ ካለዳ አሳቱዋ ሞይትለቱዋ ኔና ሳሮታናዳን ደን፤ ቃይ ካሰ ካዉተቶ ካትያ ግዴዳ ኡባቱዋካ ኡንቱንቱ አራታፐ ደን ኤሴ። <verse eid="ISA 14:9"/><verse number="10" style="v" sid="ISA 14:10"/>ኡንቱንቱ ኡባይካ ሀዋዳን ያጋና፤ ‘ሄኮ ኔንካ ኑዋዳን፥ ዎልቃ ያዳ፤ ኔንካ ኑ ማላ ግዳዳ! <verse eid="ISA 14:10"/><verse number="11" style="v" sid="ISA 14:11"/>ካሰ ዲ ዲጺደ ሳቢያ ነ ቦንቹ ስኦልያን ዱገ ገሌዳ። ዱቻቱ ኔን ግስያ ግሱዋ፤ ጉጹነቱካ ኔን ማይያ አፍላ ግዳና’ ያጋና።<verse eid="ISA 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 14:12"/>“ኔኖ ዎንታ ናአዉ፥ ባካልያዉ፥ ሳሉዋፐ ዋና ኩንዳዲ! ኔኖ ካዉተ ካዉሼዳዎ፥ ዋና ቃንጸታደ ሳኣን ዎአዲ!<note caller="-" style="x"><char style="xo" closed="false">14:12 </char><char style="xt" closed="false"><ref loc="REV 8:10">ሳፃ 8:10</ref>፤ <ref loc="REV 9:1">9:1</ref></char></note> <verse eid="ISA 14:12"/><verse number="13" style="v" sid="ISA 14:13"/>ኔን ነ ዎዛናን፥ ‘ታን ሳሉዋ ከሳና፤ ታ ካዉተ አራታካ ጾሳ ጾልንተቱዋፐ ቦላና ቃን ዎና፤ ሁጲሳ ባጋ ጋጻን፥ ያአይ ሺቅያ ደርያ ሁጲያን ኡታና።<note caller="-" style="x"><char style="xo" closed="false">14:13-15 </char><char style="xt" closed="false"><ref loc="MAT 11:23">ማቶሳ 11:23</ref>፤ <ref loc="LUK 10:15">ሉቃሳ 10:15</ref></char></note> <verse eid="ISA 14:13"/><verse number="14" style="v" sid="ISA 14:14"/>ሻረቱ ደእያ ቃፐካ ሁጲያዉ ፑደ አና፤ ታን ታና ኡባፐ ቂያ ጾሳ ማላ ኦና’ ያጋዳ። <verse eid="ISA 14:14"/><verse number="15" style="v" sid="ISA 14:15"/>ሽን ኔን ስኦልያን፥ ህርክ ጪማ ኦላን ዱገ የገታዳ።<verse eid="ISA 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 14:16"/>“ኔና በእያዋንቱ፥ ‘ቢታ ቃዳዌ፥ ካዉተቱዋ ኮኮርሴዳዌ፥ <verse eid="ISA 14:16"/><verse number="17" style="v" sid="ISA 14:17"/>ሳኣ ባዙዋ ከሴዳዌ፥ ሳኣን ደእያ ካታማቱዋካ አ የጌዳዌ፥ ባረ ቃሾ አሳቱዋካ ጎለ የደናን ድጌዳ ብታኒ ሀዌ?’ ያጊደ ትሽ ኦ አኬኪደ ጼላና።<verse eid="ISA 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 14:18"/>“ካዉተቱዋ ካተቱ ኡባይ ባረ ዱፉዋን ዱፉዋን ቦንቹዋን ግሳና። <verse eid="ISA 14:18"/><verse number="19" style="v" sid="ISA 14:19"/>ሽን ኔን እጸቴዳ ታሽያዳን፥ ነ ዱፉዋፐ ጋጻ ኦለታዳ፤ ነ አሃይ ማሻን ጫደት ሀይቄዳ አሃን፥ ቃይ ኦላን ደእያ ሹቻቱዋኮ ዱገ ዎያዋንቱ አሃን ካመቴዳ። ኔን ገድያን የደርሴዳ አሃ ማላ ግዳዳ። <verse eid="ISA 14:19"/><verse number="20" style="v" sid="ISA 14:20"/>ኔን ሞጉዋካ ኡንቱንቱና እትፐ ሞገታካ፤ አያዉ ጎፐ፥ ኔን ነ ጋድያ ባይዛዳ፤ ነ አሳካ ዎዳ። ኢታ ኦያዋንቱ ሱንይ ላኤን ሙለካ ጼሰቶፖ። <verse eid="ISA 14:20"/><verse number="21" style="v" sid="ISA 14:21"/>ኡንቱንቱ አዎቱዋ ናጋራ ድራዉ፥ ናናቱዋ ዎናዉ ጊግስተ፤ ሄዌ ዮፐ ኡንቱንቱ ደንዲደ፥ ጋድያ ላታና፤ ሳኣ ኡባካ ካታማ ሳላላ ኦና” ያጋና።<verse eid="ISA 14:21"/></para>
  <para style="s1">ጾሳይ ባብሎነ ቢታ ይሳና</para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 14:22"/>ኡባፐ ዎልቃማ መና ጎዳይ ሀዋዳን ያጌ፤ “ታን ኡንቱንቱ ቦላን ደንዳና፤ ኡንቱንቱ ሱን፥ ኡንቱንቱ አቶተ፥ ኡንቱንቱ ዘረነ ኡንቱንቱ የለታ ባብሎነፐ ይሳና። <verse eid="ISA 14:22"/><verse number="23" style="v" sid="ISA 14:23"/>ታን ባብሎነ ጉታታ ደኢያሳነ ሃይ ኤልያሳ ኦና፤ ባሻ ፑጻን ታን አ ፕታና። ታን ኡባፐ ዎልቃማ መና ጎዳይ ሀዋ ኦዳይ” ያጌ።<verse eid="ISA 14:23"/></para>
  <para style="s1">ጾሳይ አሶረቱዋ ይሳና</para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 14:24"/>ኡባፐ ዎልቃማ መና ጎዳይ ሀዋዳን ያጊደ ጫቄዳ፤ “ታን ሀልቼዳዋዳን ሀናና፤ ታን ቆፔዳዋዳንካ ፖለታና።<note caller="-" style="x"><char style="xo" closed="false">14:24 </char><char style="xt" closed="false"><ref loc="ISA 10:5-34">ኢሳ. 10:5-34</ref>፤ <ref loc="NAM 1:1-3:19">ናሆማ 1:1—3:19</ref>፤ <ref loc="ZEP 2:13-15">ሶፎ. 2:13-15</ref></char></note> <verse eid="ISA 14:24"/><verse number="25" style="v" sid="ISA 14:25"/>ታን አሶረ ጋድያ ብታንያ ታ ጋድያን መንሬና፤ ታ ደረቱዋ ሁጲያን ታን አ የና፤ አ ሞርገ ምይ ኡንቱንቱ ቦላፐ፥ አ ቶኩካ ኡንቱንቱ ሀሽያፐ ክቻና” ያጌዳ። <verse eid="ISA 14:25"/><verse number="26" style="v" sid="ISA 14:26"/>ሳአዉ ሙልያዉ ቆፈቴዳ ቆፋይ ሀዋ፤ ካዉተቱዋ ኡባ ቦላን ምጨቴዳ ኩሺካ ሀዋ። <verse eid="ISA 14:26"/><verse number="27" style="v" sid="ISA 14:27"/>ኡባፐ ዎልቃማ መና ጎዳይ ሀዋ ቆፔዳ ድራዉ፥ አ ኦን ድጋናዉ ዳንዳዪ? አ ኩሺካ ምጨቴዳ፤ ሄዋ ኦን ጉየ ዛራናዉ ዳንዳዪ?<verse eid="ISA 14:27"/></para>
  <para style="s1">ጾሳይ ፕልስጼማቱዋ ይሳና</para>
  <para style="p">
    <verse number="28" style="v" sid="ISA 14:28"/>ካቲ አካዝ ሀይቄዳ ላይ ኦደቴዳ ቃላይ ሀዋዳን ያግያዋ፤<note caller="-" style="x"><char style="xo" closed="false">14:28 </char><char style="xt" closed="false"><ref loc="2KI 16:20">2 ካታ. 16:20</ref>፤ <ref loc="2CH 28:27">2 ኦዱዋ 28:27</ref></char></note> <verse eid="ISA 14:28"/><verse number="29" style="v" sid="ISA 14:29"/>“ህንተኖ ፕልስጼማ አሳቶ ኡባቱካ፥ ህንተና ሾጬዳ ጻምአይ መኤዳ ድራዉ ናሸቶፕተ፤ አያዉ ጎፐ፥ ሄ ሾሻ ዛርያፐ ሀሱ ከሳና፤ አ ዘረይካ ቃይ ፓልያ ሾሻ ግዳናዋ።<note caller="-" style="x"><char style="xo" closed="false">14:29-31 </char><char style="xt" closed="false"><ref loc="JER 47:1-7">ኤር. 47:1-7</ref>፤ <ref loc="EZK 25:15-17">ህዝ. 25:15-17</ref>፤ <ref loc="JOL 3:4-8">ኢዩ. 3:4-8</ref>፤ <ref loc="AMO 1:6-8">አሞጻ 1:6-8</ref>፤ <ref loc="ZEP 2:4-7">ሶፎ. 2:4-7</ref>፤ <ref loc="ZEC 9:5-7">ዛካ. 9:5-7</ref></char></note> <verse eid="ISA 14:29"/><verse number="30" style="v" sid="ISA 14:30"/>ህዬሳቱዋ ባይራ ናናይ ቁማ ማና፤ መቶታንቻቱ ዎፑ ጊደ ግሳና። ሽን ታን ነ ዛርያ ኮሻን ዉርሳና፤ ቃይ ኔፐ አቴዳዋንታካ ዎና።<verse eid="ISA 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ISA 14:31"/>“ኔኖ ፐንግያዉ፥ ዬካ! ኔኖ ካታማዉ፥ ዋሳ! ህንተኖ ፕልስጼማ አሳዉ ኡባዉ፥ ህንተ ኡባይካ ህርጋን ሙሽተ! አያዉ ጎፐ፥ ሁጲሳ ባጋፐ ጩዋይ ከሲደ ዬ፤ ሄ ጭታፐ ዱጺደ ጉየ አትያዌ ባዋ። <verse eid="ISA 14:31"/><verse number="32" style="v" sid="ISA 14:32"/>ካዉተይ ኪቴዳዋንቶ ዋጊደ ዛራኔ? መና ጎዳይ ‘ጽዮኖ ኬጼ፤ ቆሄቴዳ አ አሳይ እ ግዶን ቆሰት አትያሳ ደሜዳ’ ያጋና” ያግያ ቃላይ ኦደቴዳ።<verse eid="ISA 14:32"/></para>
  <chapter eid="ISA 14"/>
  <chapter number="15" style="c" sid="ISA 15"/>
  <para style="s1">ጾሳይ ሞኣባ ቢታ ይሳና</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 15:1"/>ሞኣባ ቢታዉ ጾሳይ ኦዴዳ ቃላይ ሀዋ:<note caller="-" style="x"><char style="xo" closed="false">15:1—16:14 </char><char style="xt" closed="false"><ref loc="ISA 25:10-12">ኢሳ. 25:10-12</ref>፤ <ref loc="JER 48:1-47">ኤር. 48:1-47</ref>፤ <ref loc="EZK 25:8-11">ህዝ. 25:8-11</ref>፤ <ref loc="AMO 2:1-3">አሞጻ 2:1-3</ref>፤ <ref loc="ZEP 2:8-11">ሶፎ. 2:8-11</ref></char></note> ሞኣበን ደእያ ኤራ ግያ ካታማይ እት ቃማ ኮለቲደ ዬዳ፤ ቃይ ሞኣበን ደእያ ቂራ ግያ ካታማይካ እት ቃማ ኮለቲደ ዬዳ። <verse eid="ISA 15:1"/><verse number="2" style="v" sid="ISA 15:2"/>ድቦና ካታማ አሳይ ባረንቱ ኤቃ ጎልያን ዬካናዉ ቃ ሳኣ ከሴድኖ። ሞኣባ ጋድያ አሳይ ናቦነ መዳባ ግያ ካታማቶ ሄዋዳን ዬኬ። ሁጲ ኡባይ ቦአትክቼዳ፤ ቡቻ ኡባይካ ሜደቴዳ። <verse eid="ISA 15:2"/><verse number="3" style="v" sid="ISA 15:3"/>ኦጊ ደእያ ሳን ኡባን ኡንቱንቱ ማቃ ማዬድኖ፤ ጎልያ ቦላን ደምባይ ኬጾሳንነ ዳባባ ቦላ ኡባን ኡንቱንቱ ዬኪኖነ አፎ ሆልሳዪኖ። <verse eid="ISA 15:3"/><verse number="4" style="v" sid="ISA 15:4"/>ሀሰቦና ካታማ አሳይነ ኤልኣለ ካታማ አሳይ ዋሲኖ፤ ኡንቱንቱ ዋሱዋ ኮሻይካ ያሃጻ ግያሳ ጋካናዉ ስሰቴ። ሄዋ ድራዉ፥ ኦላዉ ዳንጬዳ ሞኣባ ዎታዳራቱ ባረንቱ ኮሻ ቂሲደ ዋሴድኖ፤ ኡንቱንቱ ሸምፑካ ኡንቱንቱ ጋርሳን ኮኮሬዳ። <verse eid="ISA 15:4"/><verse number="5" style="v" sid="ISA 15:5"/>ታን ሞኣባዉ ዎዛናፐ ዬካድ፤ አን ደእያ አሳይ ጾኣሮነ ኤግላት-ሻሊሽያ ግያ ካታማቶ ባቃቴዳ። ኡንቱንቱ ሉሂታ ኦግያን ዬኪደ ቢኖ፤ ባጋቱ ቃይ ሆሮናይማ ብያ ኦግያን፥ ባረንቱ ባሻ ድራዉ፥ ዋሱዋ ጹሊኖ። <verse eid="ISA 15:5"/><verse number="6" style="v" sid="ISA 15:6"/>ንምሪማ ሃቱ ቶኤድኖ፤ ማታይ መሌዳ፤ አጫይካ ሹሌዳ፤ እርጻባይ ኡባይካ ዬዳ። <verse eid="ISA 15:6"/><verse number="7" style="v" sid="ISA 15:7"/>ሄዋ ድራዉ፥ ኡንቱንቱ ባረንቱ ሺሼዳ አቁዋነ ምንጃ ቶክ አኪደ፥ አሃያ ግያ ምይ ደእያ ዎምባፐ ሄፍን አፊኖ። <verse eid="ISA 15:7"/><verse number="8" style="v" sid="ISA 15:8"/>ሞኣባ ዩሹ ኡባይ ዋሶ ጻላላ ግዴዳ፤ ኡንቱንቱ ዋሱ ኤግላይማነ ብኤር-ኤሊማ ጋካናዉ ስሰቴ። <verse eid="ISA 15:8"/><verse number="9" style="v" sid="ISA 15:9"/>ድሞና ካታማ ሃቱ ሱ ጻላላ ግዴድኖ፤ ታን ድሞና ካታማ ቦላ ሄዋፐካ ዳርያዋ አሀና። ሞኣባፐ ከስ አኪደ ይያዋንቱ ቦላነ ሄ ጋድያን ፓጻ አቲደ ደእያዋንቱ ቦላ ጋሙዋ የዳደ ዉርሳና።<verse eid="ISA 15:9"/></para>
  <chapter eid="ISA 15"/>
  <chapter number="16" style="c" sid="ISA 16"/>
  <para style="s1">ሞኣባዉ ህዶታይ ባዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 16:1"/>ሞኣባ አሳይ ባዙዋ ብያ ኦግያን ደእያ ሰላአ ካታማፐ ያላጋ ዶርሳ ኦርገቱዋ የሩሳላመን ደእያ ቢታ ሞድያዎ የድተ። <verse eid="ISA 16:1"/><verse number="2" style="v" sid="ISA 16:2"/>ሞኣባ ማጫ አሳይ ባረንቱ ደእያ ጎልያፐ ጋጻን ላለቴዳ ካፎቱዋዳን፥ አርኖና ሻፋ ፕንያ ሳኣን ላለታና።<verse eid="ISA 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 16:3"/>ሞኣባ አሳይ ይሁዳ አሳ ሀዋዳን ያጋና፤ “ኑና ዞርተ፤ ሱረ ፕርድተ፤ ሴታ ጋላሳን ህንተ ኩዋ ቃማዳን ኩዋይተ። የደርሰትያዋንታ ቆስተ፤ ባቃት ዬዳዋንታካ አ እሞፕተ። <verse eid="ISA 16:3"/><verse number="4" style="v" sid="ISA 16:4"/>ሞኣባፐ የደርሴቴዳዋንቱ ህንተ ግዶን ደእኖ፤ ኡንቱንታ ይስያዋንቱፐ ኡንቱንቱ ቆሰት አትያሳ ግድተ። ኡንቱንታ ኡቁንያዋንቱ ዉሬድኖ፤ ባሻይ አቴዳ፤ ኡንቱንቱ ቱጋይያዋንቱካ ጋድያፐ ዬድኖ። <verse eid="ISA 16:4"/><verse number="5" style="v" sid="ISA 16:5"/>ሄዋፐ ጉይያን፥ እት ካተቱዋ አራታይ አገና ሲቁዋን ኤቃና፤ ሄ አራታን፥ ዳዊታ ዱንካንያን እት አማነትያ ዳናይ ኡታና። እ ሱረተ ኮያና፤ ጽሎተ ኦናዉካ ኤሌላና” ያጋና።<verse eid="ISA 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 16:6"/>ይሁዳ አሳይ ሀዋዳን ያጋና፤ “ሞኣባ ጋድያ አሳይ አይ ኬና ኦቶረትንቶ፥ ኑ ኡንቱንቱ ኦቶሩዋባ ስሴዶ፤ ኡንቱንቱ አዩዋነ ኡንቱንቱ ሸቃካ ስሴዶ፤ ሽን ኡንቱንቱ ኦቶሩ ሀዳ” ያጋና።<verse eid="ISA 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 16:7"/>ሄዋ ድራዉ፥ ሞኣበ ዬኮ፤ አሳይ ኡባይካ ሞኣባዉ ዬኮ፤ ቂርሄሬሳ ካታማን ህንተ ደእያ ዎደ ሜዳ ሎኦ ቁማ ሀሳዪደ ዬክተ። <verse eid="ISA 16:7"/><verse number="8" style="v" sid="ISA 16:8"/>ሀሰቦና ሾይቃቱነ ሲብማ ዎይንያ ቶክያ ሳአቱ ዬድኖ፤ ኡንቱንቶ ታሺ ያእዜራ ጋኪደ፥ ባዞ ዛኤዳ ዶረቴዳ ዎይነቱዋ ካዉተቱዋ ካፓቱ የደርሲደ ይሴድኖ፤ ኡንቱንቱ አጫይካ ዛኢደ፥ አባ ፕኔዳ። <verse eid="ISA 16:8"/><verse number="9" style="v" sid="ISA 16:9"/>ታን ያእዜራ ካታማዉ ዬክያዋዳን፥ ሲብማ ካታማ ዎይነቶካ ዬካይ። ሀሰቦናነ ኤልኣለ ካታማቶ፥ ታን ታ አፎን ህንተና ሆልሳያይ። አያዉ ጎፐ፥ ህንተ ም አይፍያነ ህንተ ቦቴዳ ካ ቦላን ኦላ ዋሱ ደንዴዳ። <verse eid="ISA 16:9"/><verse number="10" style="v" sid="ISA 16:10"/>ካ አይፍያን ኩሜዳ ሾይቃፐ ናሸቻይነ ሀሹ ጉሳይ አከቴዳ። ዎይንያ ቶክያ ሳንካ ማዝሙሪ የጸተና። ናሸቻን ዎይንያ ቴራ ጉምእያ ሳኣን ጉምእያባይ ባዋ። ታን ጉምእያዋንቱ እልልያ እልልሳካ ይሳድ። <verse eid="ISA 16:10"/><verse number="11" style="v" sid="ISA 16:11"/>ሄዋ ድራዉ፥ ታ ዎዛናይ ሞኣባዉ፥ ታ ጋርሳ አሳተይካ ቂርሄሬሳዉ ዲዳን ዋሴ። <verse eid="ISA 16:11"/><verse number="12" style="v" sid="ISA 16:12"/>ሞኣበ ባረ ቃ ሳኣ ቦፐነ፥ ጮ ባረና ዳቡርሴ፤ ቃይ እ ባረ ኤቃ ጎልያ ዎሳናዉ ቦፐካ፥ ሄዌ አ አይነ ማደና።<verse eid="ISA 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 16:13"/>መና ጎዳይ ካሰቲደ፥ ሞኣበዋ ኦዴዳ ቃላይ ሄዋ። <verse eid="ISA 16:13"/><verse number="14" style="v" sid="ISA 16:14"/>ሽን ሀእ መና ጎዳይ ሀዋዳን ያጌ፤ “ኮንትራትያ ኦሳንቻ ላይ ፓይዱዋዳን፥ ሞኣባ ቦንቹነ አ ጮራተይ ሄዙ ላይቱዋ ግዶን ዉራና፤ አን አትያ አሳቱካ አማሬዳዋንታነ ዎልቃይ ባይናዋንታ ግዳናዋንታ” ያጌ።<verse eid="ISA 16:14"/></para>
  <chapter eid="ISA 16"/>
  <chapter number="17" style="c" sid="ISA 17"/>
  <para style="s1">ጾሳይ ሶርያነ እስራኤልያ ሙራና</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 17:1"/>ዳማስቆ ካታማባ ጾሳይ ሀዋዳን ያጌ፤ “በእተ፥ ሀዋፐ ስንናዉ ዳማስቁ ካታማ ግድያዌ አታና፤ እ ኮለ ዶርያ ግዳናዋ።<note caller="-" style="x"><char style="xo" closed="false">17:1-3 </char><char style="xt" closed="false"><ref loc="JER 49:23-27">ኤር. 49:23-27</ref>፤ <ref loc="AMO 1:3-5">አሞጻ 1:3-5</ref>፤ <ref loc="ZEC 9:1">ዛካ. 9:1</ref></char></note> <verse eid="ISA 17:1"/><verse number="2" style="v" sid="ISA 17:2"/>አሩራ ካታማቱ አሳይ ደኤና ሳኣ ግዳናዋንታ፤ ሄዋን መህያ ዉዲ አላጻና፤ ኡንቱንቱ ያሽስያዌካ ደኤና። <verse eid="ISA 17:2"/><verse number="3" style="v" sid="ISA 17:3"/>ኤፍሬመፐ ጌሳቱ፥ ዳማስቆፐካ ካዉተይ ያና፤ ሶርያ አሳፐ አቴዳዋንቱ እስራኤልያ አሳ ቦንቹዋ ማላ ግዳናዋንታ። ታን፥ ኡባፐ ዎልቃማ መና ጎዳይ ሀዋ ኦዳይ” ያጌ።<verse eid="ISA 17:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 17:4"/>ጾሳይ ሀዋዳን ያጌ፤ “ሄ ጋላስ እስራኤልያ ቦንቹ ቃረታና፤ አ ሞካ ሾራና። <verse eid="ISA 17:4"/><verse number="5" style="v" sid="ISA 17:5"/>እስራኤሊ ጫክያዌ ኤቁዋን ደእያ ካ ሺሽ ኦይቂደ፥ ማቃ ዛዋፐ ቃንጽ ቃንጽ ጫክያዋ ማላ ግዳናዋ፤ ዎይ ራፋይማ ዛንጋራን ካ ጫኪደ፥ ፑሻሌዳ ሳ ማላ ግዳናዋ። <verse eid="ISA 17:5"/><verse number="6" style="v" sid="ISA 17:6"/>ዎጋራ ቃ ስምና፥ ጼራን ላኡ ዎይ ሄዙ ቃርመ አይፈቱ አትያዋዳን፥ ዎይ ዳሻ ግዶን ኦይዱ ዎይ እቼሹ አይፈቱ አትያዋዳን፥ እስራኤልያፐ ቃርመቱ አታና” ያጌዳ። ሄዋ መና ጎዳይ፥ እስራኤልያ ጾሳይ ሃሳዬዳ።<verse eid="ISA 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 17:7"/>ሄ ጋላስ አሳይ ባረና መዳዋኮ ጼላና፤ ባረንቱ አይፍያካ እስራኤልያ ጌሻኮ ዛራና። <verse eid="ISA 17:7"/><verse number="8" style="v" sid="ISA 17:8"/>ኡንቱንቱ ባረንቱ ኩሽያን ጊግሴዳ ያርሽያ ሳኣ ጼልክኖ፤ አሼሮ ግያ ኤቃት ምስልያ ግድናካ፥ እጻና ጩዋይያ ሳኣ ግድናካ፥ ኡንቱንቱ ባረንቱ ብራያን መዳዋን አማነትያዋ አጋና።<verse eid="ISA 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 17:9"/>ሄ ጋላስ እስራኤልያ አሳ ጋሱዋን ሂዌቱዋነ አሞረቱዋ ካታማቱ ላለቴዳዋዳን፥ ኡንቱንቱ ምኖ ካታማቱ ላለታና፤ ሄ ካታማቱ መላ ግዳናዋንታ። <verse eid="ISA 17:9"/><verse number="10" style="v" sid="ISA 17:10"/>አያዉ ጎፐ፥ ህንተ ህንተና አሽያ፥ ጾሳ ዶጌድታ፤ ህንተ ባቃት አትያ ዎጋ ዛላካ ሀሳይበይክታ። ሄዋ ድራዉ፥ ኔን ሎኦ ምቱዋ ቶኮፐካ፥ ካረ ጋድያፐ ዬዳ ሎኦ አታክልትያ ቶኮፐካ፥ <verse eid="ISA 17:10"/><verse number="11" style="v" sid="ISA 17:11"/>ነ ቶኬዳ ጋላስ ኡንቱንቱ ድጪንቶካ፥ ቃይ ነ ዘሬዳ ዎንታ ኔ ኡንቱንታ ጪሽስንቶካ፥ ነ ካዩዋነ ነ ፓጻናዉ ዳንዳየና ሳኩዋ ጋላስ ሄ ጫኩ ጋኬዳ ካይ ባቃት ያና።<verse eid="ISA 17:11"/></para>
  <para style="s1">ሞርከ ካዉተቱ ጾነቴድኖ</para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 17:12"/>በአ፥ ዳሮ አሳይ ጉሜ፤ ኡንቱንቱ አባ ቤታዳን ጉሚኖ። ቃይ ካዉተቱ ዋሲኖ፤ ኡንቱንቱ ዎልቃማ ሃዳን ዋሲኖ። ኡንቱንቶ አየ አና። <verse eid="ISA 17:12"/><verse number="13" style="v" sid="ISA 17:13"/>ካዉተቱ ዳሮ ሃቱዋ ጉንዳን ጉሚኖ፤ ሽን ጾሳይ ኡንቱንታ ሴራና፤ ኡንቱንቱ ደርያ ሁጲያን ደእያ ሱላይ ጫርኩዋን ደንድያዋዳንነ ጎቲ ደንያ ባናዳን፥ የደርሰቲደ፥ ሃኮ ሳ ባቃታና። <verse eid="ISA 17:13"/><verse number="14" style="v" sid="ISA 17:14"/>ሳአይ ቃምያ ዎደ፥ ኡንቱንቱ ሻቢረታና፤ ሳአይ ዎንታናፐ ካሰቲደ፥ ኡንቱንቱ ያና፤ ኑዋ ዎልቃን አክያዋንቱ ካጫይነ ኑና ቦንቂያዋንቱ ሳማይ ሀዋ።<verse eid="ISA 17:14"/></para>
  <chapter eid="ISA 17"/>
  <chapter number="18" style="c" sid="ISA 18"/>
  <para style="s1">ጾሳይ ቶጵያ አሳባ ኦዴዳ ቃላ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 18:1"/>ቶጵያ ሻፋቱዋፐ ሄፍን ባጋና ደእያ ቀፈቱ ጊረትያ ቢታዉ አየ አና!<note caller="-" style="x"><char style="xo" closed="false">18:1-7 </char><char style="xt" closed="false"><ref loc="ZEP 2:12">ሶፎ. 2:12</ref></char></note> <verse eid="ISA 18:1"/><verse number="2" style="v" sid="ISA 18:2"/>ሄ ጋዲ ኪተትያ አሳቱዋ ናይለ ሻፋ ቦላና ኪቴ፤ ቃይ ሾምቦቁዋ ዎልዎሉዋን ዎደ፥ ሃቱዋ ቦላናካ ኪቴ። ህንተኖ፥ ድርቢያ ኪተትያዋንቶ፥ እት አዱሳነ ሊቆ አሳኮ ቢተ፤ ማታይ ሃኩ ያይያ አሳኮ፥ ዎልቃማነ ጾንያ ካዉተ ግድያ፥ ሻፋይ ኡንቱንቱ ጋድያ ግዱዋን ሻኪደ ጎግያ ጋድያ አሳኮ ቢተ።<verse eid="ISA 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 18:3"/>ህንተኖ፥ ሳኣን ደእያ ኡባ ገደ፥ ህንተኖ፥ ጋድያን ደእያዋንቶ፥ ደረቱዋ ቦላን ማላታይ ኤቂያ ዎደ፥ ህንተ በአና፤ ቃይ ማላካታይካ ፑነትያ ዎደ፥ ህንተ ስሳና። <verse eid="ISA 18:3"/><verse number="4" style="v" sid="ISA 18:4"/>አያዉ ጎፐ፥ መና ጎዳይ ታዉ ሀዋዳን ያጌዳ፤ “ሳአይ ሴታ ጋላሳ ግድያ ዎደ ከስያ ዎልቃማ ምሹዋዳን፥ ቃይ ካ ጫክያ አግናን ሆምቢያ ቃማን ሺቅያ ከተርሳዳን፥ ታን ጮኡ ጋደ፥ ታ ደእያ ሳኣፐ ዱገ ጼላና” ያጌዳ። <verse eid="ISA 18:4"/><verse number="5" style="v" sid="ISA 18:5"/>ካ ጫክያ ዎድያፐ ካሰ፥ ጪሻይ ኮለት ስምና፥ ዎይንያ አይፊ ቴርያ ዎደ፥ እ ጹንቂያ ባጫን አ ጼራ ጹንቂክቻና፤ ዳሽያ ማራ ዳሻካ እ ድጋና። <verse eid="ISA 18:5"/><verse number="6" style="v" sid="ISA 18:6"/>ኡንቱንቱ ኡባይካ ደርያ ሁጲያን ደእያ፥ ምያዋ ዎችያ ካፎቶነ ሳኣ ዶአቶ አታና፤ ምያዋ ዎችያ ካፎቱ ባልጉዋ፥ ሳኣ ዶአቱ ቦንያ ኡንቱንታ ሚደ ሻጫና።<verse eid="ISA 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 18:7"/>ሄ ዎደ አዱሳነ ሊቆ አሳፐ፥ ማታይ ሃኩ ያይያ አሳፐ፥ ዎልቃማነ ጾንያ ካዉተፐ፥ ቃይ ሻፋይ ኡንቱንቱ ጋድያ ግዱዋን ሻኪደ ጎግያ ጋድያ አሳፐ፥ ኡባፐ ዎልቃማ መና ጎዳዉ እሞታይ ጽዮነ ደርያ፥ መና ጎዳ ሱንይ ደእያ ሳኣ ያና።<verse eid="ISA 18:7"/></para>
  <chapter eid="ISA 18"/>
  <chapter number="19" style="c" sid="ISA 19"/>
  <para style="s1">ጾሳይ ግብጻ ሙራና</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 19:1"/>ግብጼ ቢታ ጾሳይ ሀዋዳን ያጌ፤<note caller="-" style="x"><char style="xo" closed="false">19:1-25 </char><char style="xt" closed="false"><ref loc="JER 46:2-26">ኤር. 46:2-26</ref>፤ <ref loc="EZK 29:1-32:32">ህዝ. 29:1—32:32</ref></char></note> “በእተ፥ መና ጎዳይ ድርቢያ ሻርያ ቶጊደ፥ ግብጼ ዬ። ግብጼ ኤቃቱ አ ስንን ኮኮራና፤ ግብጼ አሳ ዎዛናይካ ኡንቱንቱ ግዶን ሲላና” ያጌ።<verse eid="ISA 19:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 19:2"/>ኡባፐ ዎልቃማ ጾሳይ ሀዋዳን ያጌ፤ “ታን ግብጼ ጋድያ አሳ ግብጼ አሳ ቦላ ደንና፤ ኡንቱንቱ ባረንቱ ግዶን እሻይ እሻና፥ ሾሩ ሾሩዋና፥ ካታማይ ካታማና፥ ካዉተይ ካዉተና ኦለታና። <verse eid="ISA 19:2"/><verse number="3" style="v" sid="ISA 19:3"/>ግብጼ አሳ አያናይ ጋገታና፤ ታን ኡንቱንቱ ሀልቹዋ ሀዳ ኦና። ኡንቱንቱ ኤቃቱዋነ ሞይትልያ ሃሳይስያ አሳቱዋ፥ ካይያዋንታነ ሻሬቾቱዋ ዞረታ ኦቻና። <verse eid="ISA 19:3"/><verse number="4" style="v" sid="ISA 19:4"/>ቃይ ታን ግብጼ ጋድያ አሳ እት መቀ ባይና ጎዳ ኩሽያን አደ እማና፤ እት መቀ ባይና ካቲ ኡንቱንታ ሞዳና” ያጌ ኡባፐ ዎልቃማ መና ጎዳይ።<verse eid="ISA 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 19:5"/>ናይለ ሻፋ ሃይ መላና፤ ሻፋይካ ሌላን ሌላን መል አጋና። <verse eid="ISA 19:5"/><verse number="6" style="v" sid="ISA 19:6"/>ዜሮ ሃቱ ጽንቃና፤ ግብጼ ፑልቶቱ ጉጻናነ ቶአና። ሾምቦቆቱነ ጫረቱ ሹላና፤ <verse eid="ISA 19:6"/><verse number="7" style="v" sid="ISA 19:7"/>ናይለ ሻፋ ማታን ደእያ ሳአቱ፥ አባ ማታቱ ኡባይ ኮለት መላ ግዳና። ናይለ ሻፋ ማታን ዘሬዳባይ ኡባይ መላና፥ ላለታናነ ያና። <verse eid="ISA 19:7"/><verse number="8" style="v" sid="ISA 19:8"/>ሞልያ ኦይቂያዋንቱ ካዮታና። ናይለ ሻፋን ግትያ የግያ ኡባቱ ዬካና፤ ሃን ግትያ የግያዋንቱካ ዶጫና። <verse eid="ISA 19:8"/><verse number="9" style="v" sid="ISA 19:9"/>ፓተቴዳ ታልባፐ ሊኑዋ ኦያዋንቱ፥ ቃይ ቦ ፑቱዋ ማዩዋ ዳድያ ሸማይነቱካ ዬላታና። <verse eid="ISA 19:9"/><verse number="10" style="v" sid="ISA 19:10"/>ሽማይነቱነ ከራ ኦያ ኡባቱካ ካዮታና።<verse eid="ISA 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 19:11"/>ጾኣነ ካታማ ሞድያዋንቱ ሙለካ ኤያ፤ አዳ ኤራንቻ ግያ ግብጼ ካትያ ዞርያዋንቱ ዞሪካ ዳማ። ያትና፥ ህንተ ግብጼ ካትያዉ፥ “ኑን አዳ ኤራንቻቱዋ ናናቱዋ፤ ኑን በን ካተቱ ናናቱዋ” ጋናዉ ዋኒደ ዳንዳዪቴ? <verse eid="ISA 19:11"/><verse number="12" style="v" sid="ISA 19:12"/>ነ አዳ ኤራንቻ አሳቱ ያትና ሀእ ሀቃን ደኢኖ? ኡባፐ ዎልቃማ መና ጎዳይ ግብጼ ቦላ ኦናዉ ሀልቼዳዋ አነ ኡንቱንቱ ነዉ ኦድኖነ ኔና ኤርስኖ። <verse eid="ISA 19:12"/><verse number="13" style="v" sid="ISA 19:13"/>ጾኣነ ካታማ ሞድያዋንቱካ ኤዬድኖ፤ መምፒሳ ካታማ ሞድያዋንቱካ ጭመቴድኖ። ግብጼ አሳ ዛርያ ግዶፐ አሳ ካለያዋንታ ጊደ ዎዳዋንቱ ግብጼ ባለድኖ። <verse eid="ISA 19:13"/><verse number="14" style="v" sid="ISA 19:14"/>መና ጎዳይ ኡንቱንቱ ግዶን ጌላ አያና ዋላኬዳ፤ ያትና፥ ኡንቱንቱ ማቲደ አሳይ ባረ ጮሻን ጋንድጋርያዋዳን፥ ግብጼ ባረ ኦሶ ኡባን ጋንድጋራናዳን ኦድኖ። <verse eid="ISA 19:14"/><verse number="15" style="v" sid="ISA 19:15"/>ግብጼዉ አ ሁጲ ዎይ አ ጎይናይ፥ አ ዛምባ ታሺ፥ ዎይ አ ሾምቦቁ ኦናባይ አያይነ ባዋ።<verse eid="ISA 19:15"/></para>
  <para style="s1">ግብጼቱ ጾሳዉ ጎይንያ ጋላሳይ ያና</para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 19:16"/>ሄ ጋላስ ግብጼ ጋድያ አሳይ ማጫ አሳ ማላ ግዳናዋ። ቃይ ኡባፐ ዎልቃማ መና ጎዳይ ኡንቱንቱ ቦላን ዉጻክያ አ ኩሽያ በኢደ፥ ኡንቱንቱ ያሻን ኮኮራና። <verse eid="ISA 19:16"/><verse number="17" style="v" sid="ISA 19:17"/>ይሁዳ ጋዲ ግብጼ ጋድያ አሳ ያሽያዋ ግዳናዋ፤ ኡባፐ ዎልቃማ መና ጎዳይ ኡንቱንቱ ቦላን ኦናዉ ቆፔዳ ቆፋ ድራዉ፥ ይሁዳባ ስስያ ኡባይ ያያና።<verse eid="ISA 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 19:18"/>ሄ ጋላስ ግብጼ ጋድያን ደእያ እቼሹ ካታማቱ ካናነ ቃላን ሃሳይያዋንታነ ኡባፐ ዎልቃማ መና ጎዳዉ አማነታናዉ ጫቂያዋንታ ግዳና። ሄ ካታማቱዋፐ እቱ፥ “አዋ ካታማ” ጌተቲደ ጼሰታና።<verse eid="ISA 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 19:19"/>ሄ ጋላስ ግብጼ ቢታዉ ግዱዋን፥ መና ጎዳዉ ያርሽያሳይ ጊጋና፤ ቃይ ግብጼ ጋድያ ዛዋንካ መና ጎዳዉ ቱሳይ ኤቃና። <verse eid="ISA 19:19"/><verse number="20" style="v" sid="ISA 19:20"/>ሄዌ ኡባፐ ዎልቃማ መና ጎዳዉ ግብጼ ጋድያን ማላታነ ማርካ ግዳናዋ፤ ኡንቱንቱ ባረና ኡቁንያዋንቱፐ ደንዴዳዋን መና ጎዳኮ ዋስያ ዎደ፥ እ ኡንቱንቶ አሽያዋ ኪታና፤ ኡንቱንታ አሻና። <verse eid="ISA 19:20"/><verse number="21" style="v" sid="ISA 19:21"/>ሄ ዎደ ጾሳይ ግብጼ ጋድያን ኤረቴዳዋ ግዳናዋ፤ ግብጼ አሳይካ ሄ ጋላስ ጾሳ ኤራናነ ያርሹዋነ ካ ያርሹዋ አክ ዪደ፥ አዉ ጎይናና። ኡንቱንቱ ጾሳዉ ሺቃናነ ባረንቱ ሺቆዋካ ጋና። <verse eid="ISA 19:21"/><verse number="22" style="v" sid="ISA 19:22"/>መና ጎዳይ ግብጼ ሾጫና፤ ሾጫናነ ፓና። ኡንቱንቱካ መና ጎዳኮ ስማና፤ እካ ኡንቱንቱ ዋትዋቱዋ ስሲደ፥ ኡንቱንቱ ፓና።<verse eid="ISA 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 19:23"/>ሄ ጋላስ ግብጼፐ አሶረ ጋካናዉ አኮ ኦገ ከሳና፤ አሶረ አሳይ ግብጼ፥ ግብጼ አሳይካ አሶረ ስመረታና፤ ቃይ ግብጼ አሳይ አሶረ አሳና እትፐ ጎይናና። <verse eid="ISA 19:23"/><verse number="24" style="v" sid="ISA 19:24"/>ሄ ጋላስ እስራኤሊ ግብጼናነ አሶረና ሄዘን ቢታ ግዲደ፥ ሳኣ ግዶን አንጆ ግዳናዋ። <verse eid="ISA 19:24"/><verse number="25" style="v" sid="ISA 19:25"/>ኡባፐ ዎልቃማ መና ጎዳይ ኡንቱንታ ሀዋዳን ያጊደ አንጃና፤ “ታ አሳዉ ግብጼ፥ ታ ኩሺ መዳ አሶረነ ታን ዶሬዳ እስራኤልያዉ አንጀቴዳዋንታ ግድተ” ያጋና።<verse eid="ISA 19:25"/></para>
  <chapter eid="ISA 19"/>
  <chapter number="20" style="c" sid="ISA 20"/>
  <para style="s1">ግብጼ ቦላነ ቶጵያ ቦላ ኦደቴዳ ትምቢትያ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 20:1"/>አሶረ ጋድያ ካቲ ሳርጎን ኪቴዳ ኦላ ጋዳዋይ ዪደ፥ አሽዶዳ ግያ ፕልስጼማ ካታማ ኦሊደ ኦይቄዳ ላይ፥ <verse eid="ISA 20:1"/><verse number="2" style="v" sid="ISA 20:2"/>ሄ ዎደ መና ጎዳይ አሞጻ ናኣ ኢስያሳ ሀዋዳን ያጌዳ፤ “ባ፤ ነ ቦላፐ ማቃ ቃራ፤ ነ ገድያፐካ ነ ጫማ ከሳ” ያጌዳ፤ እስያስ ጾሳይ ጌዳዋዳን ሀኒደ፥ ካሎ ጺራነ መላ ገድያን ሀመቴዳ።<verse eid="ISA 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 20:3"/>መና ጎዳይ ሀዋዳን ያጌዳ፤ “ታ ቆማይ እስያስ ግብጼነ ቶጵያ ቦላን ጋክያባዉ ማላታ ግዳና ማላ፥ ሄዙ ላይ ካሎ ጺራነ መላ ገድያን ሀመቴዳ። <verse eid="ISA 20:3"/><verse number="4" style="v" sid="ISA 20:4"/>ሄዋዳን አሶረ ካቲ፥ ግብጼፐ ኦሞደቴዳዋንታነ ቶጵያፐ በቲደ ከሴዳዋንታ ካሎ ጺራነ መላ ገድያና፥ ዱሊካ ካሎ ደእሽን ላግ፥ ግብጼ ዬላዉ አፋና። <verse eid="ISA 20:4"/><verse number="5" style="v" sid="ISA 20:5"/>ቶጵያን አማነትያዋንቱነ ግብጼን ጬቀትያዋንቱ ያዪደ ዬላታና። <verse eid="ISA 20:5"/><verse number="6" style="v" sid="ISA 20:6"/>አባ ማታን ደእያ አሳይ ሄ ጋላስ ሀዋዳን ያጋና፤ ‘በእተ፥ ኑን አሶረ ካትያፐ አታናዉ ማዲኖ ጊደ ኑ ህዶታ ዎዳነ ኡንቱንቱኮ ባቃቴዳ አሳ ቦላ ሀዌ ጋኬዳ፤ ያትና፥ ኑን ዋን አታናዉ ዳንዳዬቶ?’ ያጋና” ያጌዳ።<verse eid="ISA 20:6"/></para>
  <chapter eid="ISA 20"/>
  <chapter number="21" style="c" sid="ISA 21"/>
  <para style="s1">ባብሎነ ኩንደ በስያ ሳፃ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 21:1"/>አባ ማታን ደእያ ባዞ ኦደቴዳ ጾሳ ቃላይ ሀዋ።</para>
  <para style="p" vid="ISA 21:1">ገድሳ ባጋፐ ጎትያ ጫርኩ ሱራጊደ ይያዋዳን፥ ባሻይ መላ ቢታፐ፥ ያሽያ ጋድያፐ ዬ።<verse eid="ISA 21:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 21:2"/>እት ያሽያ ሳጻይ ታዉ ቆንጬዳ። አ እምያዌ አ እሜ፤ ኦሞድያዌ ኦሞዴ፤ ኤላማ ቢታዉ፥ ዎራጃ! ሜዶና ቢታዉ፥ ካታማ ዶዳ! ባብሎነ ጋሱዋን ጋኬዳ ኦልያ ታን ግድሳና።<verse eid="ISA 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 21:3"/>ሄዋ ድራዉ፥ ታ ጼሳይ ሳኮ ጻላላ ግዴዳ፤ ማጫ አሳ የሉ ኦይቂያዋዳን፥ ታና ኡንኡ ኦይቄዳ፤ ታን ስስያዋፐ ደንዴዳዋን ሆካድ፤ ታን በኤዳዋፐ ደንዴዳዋን ዳጋማድ። <verse eid="ISA 21:3"/><verse number="4" style="v" sid="ISA 21:4"/>ታና ዪጮዬ፤ ታና ያሻይ ኮኮርሴ፤ ታን አሞቴዳ ኦማርሳይ ታዉ ኮኮርሳዉ ላመቴዳ።<verse eid="ISA 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 21:5"/>ታን በኤዳ ሳጻን ኡንቱንቱ ግብራ ጊግሴድኖ፤ ምንጻፍያካ ሂጼድኖ፤ ያቲደ ሚኖነ ኡሺኖ። ያትሽን፥ “ህንተኖ ካፓቶ፥ ደንድተ! ህንተ ጎንዳለቱዋ ቁጭተ!” ያግያ አዛዙ ዬዳ።<verse eid="ISA 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 21:6"/>ጎዳይ ታና ሀዋዳን ያጌዳ፤ “ባ፤ ጾሞስያ አሳ ዎ፤ እ ባረ በእያዋ ኦዶ። <verse eid="ISA 21:6"/><verse number="7" style="v" sid="ISA 21:7"/>ጋማማ መህያ ቶግያዋንታ፥ ላኡዋ ላኡዋ ግዲደ ብያ ፓራ አሳቱዋ፥ ሀረቱዋ ቶግያዋንታነ ጋሎቱዋ ቶግያዋንታ በእያ ዎደ፥ ሎይደ ጼሎ፤ ሽ ጼሎ” ያጌዳ።<verse eid="ISA 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 21:8"/>ሄዋፐ ጉይያን፥ ዎቼዳዌ ሀዋዳን ያግ ዋሴዳ፤ “ጎዳዉ፥ ታን ዎችያሳን ጋላስ ጋላስ ፓጭ ባይናን ኤቃድ፤ ታ ሳንታርያንካ ቃማ ሙልያ ቶለታድ። <verse eid="ISA 21:8"/><verse number="9" style="v" sid="ISA 21:9"/>በእተ፥ ጋማማ መህያ ቶግያ ፓራ አሳቱ ላአ ላአ ግዲደ ዪኖ” ያጌዳ። እ ቃይካ ሀዋዳን ያጌዳ፤ “ባብሎነ ኩንዴዳ፤ አ ጾሳቱዋ ምስለቱካ ኩንዴድኖ። ኡንቱንቱ ኡባይካ ሳኣን ዱገ ኩንዲደ ጋጨቴድኖ” ያጊደ ዋሴዳ።<note caller="-" style="x"><char style="xo" closed="false">21:9 </char><char style="xt" closed="false"><ref loc="REV 14:8">ሳፃ 14:8</ref>፤ <ref loc="REV 18:2">18:2</ref></char></note> <verse eid="ISA 21:9"/><verse number="10" style="v" sid="ISA 21:10"/>ህንተኖ፥ ታ ኡዱማን ቆጸቴዳ ታ አሳቶ፥ ኡባፐ ዎልቃማ መና ጎዳፐ፥ እስራኤልያ ጾሳፐ ስሴዳዋ ታን ህንተንቶ ኤርሳይ።<verse eid="ISA 21:10"/></para>
  <para style="s1">ኤዶማባዉ ኦደቴዳዋ</para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 21:11"/>ኤዶማ ቢታ ጾሳይ ሀዋዳን ያጌዳ፤ “እት ብታኒ ኤዶማ ባጋና ታና ጼሲደ፥ ‘ላ ዎችያዎ፥ ሳአይ ዎንታናዉ አፑኑ አቴዴ? ላ ዎችያዎ፥ ሳአይ ዎንታናዉ አፑኑ አቴዴ?’ ያጌ። <verse eid="ISA 21:11"/><verse number="12" style="v" sid="ISA 21:12"/>ዎችያዌ ዛሪደ፥ ‘ሳአይ ዎንታና ሀኔ፤ ቃይ ቃማና፤ ህንተ ኦቻናዉ ኮዮፐ፥ ስም ዪደ ኦችተ’ ያጌ” ያጌዳ።<verse eid="ISA 21:12"/></para>
  <para style="s1">አራባ ቢታባዉ ኦደቴዳዋ</para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 21:13"/>አራባ ግያ ቢታ ጎዳይ ሀዋዳን ያጌ፤ “ህንተኖ ዳዳና ዛልአንቻቶ፥ ህንተ ህንተ ጫንያ ጋሎቱዋናካ አራባ ጋድያ ባዙዋን አቃና። <verse eid="ISA 21:13"/><verse number="14" style="v" sid="ISA 21:14"/>ህንተኖ፥ ቴማ ግያ ጋድያን ደእያ አሳቶ፥ ሳመቴዳዋንቶ ሃ አህተ፤ በተቶ ምያዋ እምተ። <verse eid="ISA 21:14"/><verse number="15" style="v" sid="ISA 21:15"/>አያዉ ጎፐ፥ ኡንቱንቱ ማሻፐ፥ ሾኩዋፐ ሾዴዳ ማሻፐ፥ ዳፌዳ ዎንዳፍያፐነ ምኖ ኦላፐ ባቃቲደ ዬድኖ” ያጌ።<verse eid="ISA 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 21:16"/>ሄዋፐ ጉይያን፥ ጎዳይ ታና ሀዋዳን ያጌዳ፤ “ኮንትራትያ ኦሳንቻ ዎድያዳን፥ መጽ እት ላይ ግዶን ቄዳረ ቦንቹ ኡባይ ዉራና። <verse eid="ISA 21:16"/><verse number="17" style="v" sid="ISA 21:17"/>ቄዳረ ጋድያን ደእያ ዎንዳፍያን ዱክያ ዎልቃማ ኦላንቻቱዋፐ ጉቱ አታና፤ ሄዋ መና ጎዳይ እስራኤልያ ጾሳይ ኦዴዳ” ያጌዳ።<verse eid="ISA 21:17"/></para>
  <chapter eid="ISA 21"/>
  <chapter number="22" style="c" sid="ISA 22"/>
  <para style="s1">የሩሳላመባይ ኦደቴዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 22:1"/>ሳፃ ዎምባ ግያ ሳኣባዉ ጾሳይ ኦዴዳ ቃላ። ህንተ ኡባይ ጎልያ ቦላን ደምባዪደ ኦዳ ሳኣ ከሴዳዌ አያሴ? <verse eid="ISA 22:1"/><verse number="2" style="v" sid="ISA 22:2"/>ኔኖ ዋሱ፥ ድርባይነ ጫቡ ኩሜዳ ካታማዉ፥ ነ ግዶን ሀይቄዳ አሳቱ ማሻን ሀይቂበይክኖ፤ ዎይ ኦላንካ ሀይቂበይክኖ። <verse eid="ISA 22:2"/><verse number="3" style="v" sid="ISA 22:3"/>ህንተ ካፓቱ ኡባይ እትፐ ባቃቴድኖ፤ ኡንቱንቱ ዎንዳፊ ባይናን ጮ ኦሞደቴድኖ፤ ኡንቱንቱ ሃኮ ሳ ባቃቶፐነ ቤቴዳ ኡባቱ ኦይቀቴድኖ። <verse eid="ISA 22:3"/><verse number="4" style="v" sid="ISA 22:4"/>ሄዋ ድራዉ፥ ታን ሀዋዳን ያጋድ፤ “ታና ጼሎፕተ፤ አነ ታን አፎጻደ ምሾ ዬኩዋ ዬካይ፤ ዬዳ ታ አሳዉ ዬክያ ታና ምንና ጊደ ዳቡሮፕተ” ያጋድ። <verse eid="ISA 22:4"/><verse number="5" style="v" sid="ISA 22:5"/>ጎዳይ፥ ኡባፐ ዎልቃማ መና ጎዳይ ሀ ጋላሳ ሳፃ ዛንጋራን ዳጋማ፥ የደርሳነ ሻቢርሳ ጋላሳ ኦዳ፤ ቃይ ግምበቱካ ኮለትያ ጋላሳነ ደረቱዋኮካ ዋስያ ጋላሳ።<verse eid="ISA 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 22:6"/>ኤላመ ባረ ፓራ ጋረቱዋናነ ፓራ አሳቱዋና ባረ ዎንዳፍያ ኦይቂደ ዬዳ፤ ቂራ ጋድያ ዎታዳራቱ ቃይ ባረንቱ ጎንዳለቱዋ ጊግሴድኖ። <verse eid="ISA 22:6"/><verse number="7" style="v" sid="ISA 22:7"/>ሎይ ሎእያ ህንተ ዛንጋራቱ ፓራ ጋረቱዋን ኩሜድኖ፤ ፓራ አሳቱ የሩሳላመ ካታማ ፐንግያ ስንን ኤቄድኖ። <verse eid="ISA 22:7"/><verse number="8" style="v" sid="ISA 22:8"/>እ ይሁዳ ጌሶቱዋ ቃሬዳ። ሄ ጋላስ ህንተ ዎራ ጎልያን ደእያ ካትያ ኦላ ሚሻቱዋ ጼሌድታ። <verse eid="ISA 22:8"/><verse number="9" style="v" sid="ISA 22:9"/>ቃይ ህንተ ዳዊታ ካታማ ግዶን ኮለቴዳሳይ ዳሬዳዋ በኤድታ፤ ዝቃ ሳኣ ሺቄዳ ሃ ዳጋይ ደኢታ። <verse eid="ISA 22:9"/><verse number="10" style="v" sid="ISA 22:10"/>ያቲደ ህንተ የሩሳላመን ደእያ ጎለቱዋ ፓይዴድታ፤ ግምቢያ ምንናዉ ጎለቱዋ ኮሌድታ። <verse eid="ISA 22:10"/><verse number="11" style="v" sid="ISA 22:11"/>ካሰ ኤጫ ዳልባንን ደእያ ሃ ዛሪደ፥ አ ምንጅያሳ ላኡ ግምበቱዋፐ ግዱዋን ጊግሴድታ። ሽን ህንተ ሄዋ መዳዌ ጾሳ ግድያዋ አኬክበይክታ፤ ዎይ ዳሮ ዎድያፐ ካሰ ሄዋ ሀልቼዳዋ ያይንበይክታ።<verse eid="ISA 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 22:12"/>ሄ ጋላስ ጎዳይ፥ ኡባፐ ዎልቃማ መና ጎዳይ ህንተና ዬካናዉነ ዝላላናዉ፥ ህንተ ሁጲያ ሜደታናዉነ ዋሩዋ ማያናዉ ህንተና ጼሴዳ። <verse eid="ISA 22:12"/><verse number="13" style="v" sid="ISA 22:13"/>ሽን በእተ፥ ህንተ ናሸቲታነ ፖጩ ጊታ፤ ቦራነ ዶርሳ ሹኪታ፤ አሹዋ ሚታ፤ ዎይንያ ኤሳካ ኡሺታ፤ “ኑን ዎንት ሀይቂያ ድራዉ፥ አነ ሜቶነ ኡሼቶ” ያጊታ።<note caller="-" style="x"><char style="xo" closed="false">22:13 </char><char style="xt" closed="false"><ref loc="1CO 15:32">1 ቆሮ. 15:32</ref></char></note><verse eid="ISA 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 22:14"/>ኡባፐ ዎልቃማ መና ጎዳይ ሀዋ ታዉ ኦዴዳ፤ እ፥ “ህንተ ሀይቃና ጋካናዉካ ሀ ናጋራይ ህንተንቶ አቶ ጌተተና። ታን ጎዳይ፥ ኡባፐ ዎልቃማ መና ጎዳይ ሀዋ ኦዳይ” ያጌዳ።<verse eid="ISA 22:14"/></para>
  <para style="s1">ሼብና፥ “ኔና ኤራ!” ጌዳዋ</para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 22:15"/>ጎዳይ፥ ኡባፐ ዎልቃማ መና ጎዳይ ሀዋዳን ያጌዳ፤ “ባ፤ ካትያ ጎልያን ሱንቴዳ ካፑዋ ሼብናኮ ባደ ሀዋዳን ያጋ፤ <verse eid="ISA 22:15"/><verse number="16" style="v" sid="ISA 22:16"/>‘ሀዋን ኔን አያ ኦይ? ቃይ ኔን ሀዋን ነዉ ዱፉዋ ቦካናዉ፥ ነዉ ሀዋን ኦኔ ደእያዌ? ኔኖ ቃ ሳኣን ነዉ ዱፉዋ ማስያዎ፥ ቃይ ሹቻ ጎምፓን ነዉ ደእያ ሳኣ ዎጭያዎ፥ <verse eid="ISA 22:16"/><verse number="17" style="v" sid="ISA 22:17"/>ነኖ ምኖ ብታንያዉ፥ ኔና መና ጎዳይ ዎልቃን ዎራ ዛሪደ ኦላና። ኔና እ ጲርጾ ኦይቂደ፥ <verse eid="ISA 22:17"/><verse number="18" style="v" sid="ISA 22:18"/>ዩሽ ዩሽ አደ ኩዋዳን፥ እት አኮ ጋድያን ኦል አጋና። ኔኖ ነ ጎዳ ጎልያዉ ዬላ ግዴዳ ብታንያዉ፥ ኔን ያን ሀይቃና፤ ነ ቦንቾ ፓራ ጋረቱካ ያን አታና። <verse eid="ISA 22:18"/><verse number="19" style="v" sid="ISA 22:19"/>ታን ኔና ነ ኦሱዋፐ ከሳና፤ ነ ዳናተፐካ ኔና ሻራና’ ያጋ።<verse eid="ISA 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 22:20"/>“ሄ ጋላስ ታን ህልቂያ ናኣ ታ ቆማ ኤልያቂማ ጼሳና። <verse eid="ISA 22:20"/><verse number="21" style="v" sid="ISA 22:21"/>ነ ማዩዋ አ ማይዛና፤ ነ ዳንጭያዋንካ አ ዳንጭሳና፤ ነ ሱንተካ አዉ አደ እማና። እ የሩሳላመን ደእያ አሳዉነ ይሁዳ አሳዉ አዉዋ ግዳናዋ። <verse eid="ISA 22:21"/><verse number="22" style="v" sid="ISA 22:22"/>ታን ዳዊታ ጎልያ ቁልፕያ አ ሀሽያን ዎና፤ እ ዶያና፤ ኦንነ ጎርደና፤ ቃይ እ ጎርዳና፤ ኦንነ ዶየና።<note caller="-" style="x"><char style="xo" closed="false">22:22 </char><char style="xt" closed="false"><ref loc="REV 3:7">ሳፃ 3:7</ref></char></note> <verse eid="ISA 22:22"/><verse number="23" style="v" sid="ISA 22:23"/>ታን አ አማንያ ሳኣን ሽካልያዳን ጋና፤ እ ባረ አዉዋ ጎልያዉ ቦንቾ ካተቱዋ አራታ ግዳናዋ። <verse eid="ISA 22:23"/><verse number="24" style="v" sid="ISA 22:24"/>ዋንጫፐ ቢደ፥ ቃባ ጋካናዉ ኮጫን ካቄዳዋዳን፥ ኡንቱንቱ አ አዉዋ ጎልያ ቦንቹዋ ኡባ፥ ናናቱዋ፥ ናኣ ናናቱዋካ፥ አ ቦላ ዎና” ያጌዳ።<verse eid="ISA 22:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 22:25"/>ኡባፐ ዎልቃማ መና ጎዳይ ሀዋዳን ያጌ፤ “ሄ ጋላስ አማነትያ ሳኣን ጌዳ ሽካሊ ክቻና፤ ቃንጸታናነ ኩንዳና። አ ቦላን ካቄዳ ቶኩዋ ኡባይ ዱጽ ዎና” ያጌ። ሀዋ መና ጎዳይ ኦዴዳ።<verse eid="ISA 22:25"/></para>
  <chapter eid="ISA 22"/>
  <chapter number="23" style="c" sid="ISA 23"/>
  <para style="s1">ጺሮሳባይ ትምቢትያን ኦደቴዳዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 23:1"/>ጺሮሳ ካታማዉ ኦደቴዳ ጾሳ ቃላይ ሀዋ።<note caller="-" style="x"><char style="xo" closed="false">23:1-18 </char><char style="xt" closed="false"><ref loc="EZK 26:1-28:19">ህዝ. 26:1—28:19</ref>፤ <ref loc="JOL 3:4-8">ኢዩ. 3:4-8</ref>፤ <ref loc="AMO 1:9-10">አሞጻ 1:9-10</ref>፤ <ref loc="ZEC 9:1-4">ዛካ. 9:1-4</ref>፤ <ref loc="MAT 11:21-22">ማቶሳ 11:21-22</ref>፤ <ref loc="LUK 10:13-14">ሉቃሳ 10:13-14</ref></char></note></para>
  <para style="p" vid="ISA 23:1">ህንተኖ ታርሴሳ ማርካብያ ላግያዋንቶ ዬክተ! አያዉ ጎፐ፥ ጺሮሳ ካታማይ ጎሊ ዎይ ሸምፕያሳይ ባይና መላ ከሴዳ፤ ሄ ኦዱ ኡንቱንቶ ቆጲሮሳ ጋድያፐ ዬዳ። <verse eid="ISA 23:1"/><verse number="2" style="v" sid="ISA 23:2"/>ህንተኖ፥ አባ ማታን ደእያ አሳቶ፥ ህንተኖ ሲዶና ካታማ ዛልአንቻቶ፥ ጮኡ ጊተ! ህንተ ኪትያ አሳቱ አባ ፕኔድኖ። <verse eid="ISA 23:2"/><verse number="3" style="v" sid="ISA 23:3"/>ህንተዉ ይያ ካይ ናይለ ሻፋፐ ጫከቴዳ ሽሆራ ጋድያ ካ። ህንተ ካዉተቱ ዛልእያ ዛልእያ ሳ ግዳና።<verse eid="ISA 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 23:4"/>ኔኖ ሲዶና ካታማዉ፥ አባ ጌሶ፥ አባይ፥ “ታን ናኣ የላበይከ፤ ታን አቱማ ናኣካ ማጫ ናኣካ ድቻበይከ” ያጊደ ሃሳዬዳ ድራዉ ዬላታ። <verse eid="ISA 23:4"/><verse number="5" style="v" sid="ISA 23:5"/>ኦዱ ግብጼ ጋድያ ጋክያ ዎደ፥ ኡንቱንቱ ጺሮሳባ ስሲደ ሴለታና።<verse eid="ISA 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 23:6"/>ህንተኖ አባ ማታን ደእያ አሳቶ፥ ዝላልተ፤ ሄፍን ታርሴሳ ቢታ ፕንተ። <verse eid="ISA 23:6"/><verse number="7" style="v" sid="ISA 23:7"/>በን ዎደ ኬጸቴዳ፥ ካረ ጋድያ ኦይቂደ ሞዳናዉ አ ገዲ አ ሃስ አፌዳነ፥ ህንተ አን ናሸትያ ጺሮሳ ካታማይ ሀዋዳን ሀኔዴ? <verse eid="ISA 23:7"/><verse number="8" style="v" sid="ISA 23:8"/>ካላቻ ዎስያ ካታማ አ ዛልአንቻቱ ጋድያ ሞድያዋንታ ግዴዳነ አ ግዶን ዛልእያዋንቱነ ላምያዋንቱ ጋድያ ቦላን ቦንቼቴዳዋንታ ግዴዳ ጺሮሳ ካታማ ቦላ ሀዋ ሀልቼዳዌ ኦኔ? <verse eid="ISA 23:8"/><verse number="9" style="v" sid="ISA 23:9"/>ኦቶረትያዋንቱ ቦንቹዋ ኡባ ጉናዉ፥ ቃይ ጋድያ ቦላን ቦንቼቴዳዋንታ ኡባ ካዉሻናዉ፥ ኡባፐ ዎልቃማ መና ጎዳይ ሀዋ ሀልቼዳ።<verse eid="ISA 23:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 23:10"/>ህንተኖ፥ ታርሴሳ ጋድያ አሳቶ፥ ህንተና ተእያባይ ባይና ድራዉ፥ ናይለ ሻፋዳን፥ ህንተ ጋድያ ቦላን ኩሚደ ጎግተ። <verse eid="ISA 23:10"/><verse number="11" style="v" sid="ISA 23:11"/>መና ጎዳይ አባ ቦላን ባረ ኩሽያ ምጬዳ፤ እ ካዉተካ ቃዳ፤ ካናነ ጋድያ ጌሶቱዋ ላላና ማላ፥ ጾሳይ አዛዙዋ እሜዳ። <verse eid="ISA 23:11"/><verse number="12" style="v" sid="ISA 23:12"/>ቃይ እ ሀዋዳን ያጌዳ፤ “ህንተኖ፥ ኡንኤቴዶ ሲዶና አሳቶ፥ ህንተ ናሸቻ ፖጩ ግያ ዎዲ ዉሬዳ። ደንድተ፤ ሄፍን ቆጲሮሳ ፕንተ። ሀራይ አቶ ያንካ ህንተንቶ ሸምፑ ቤተና” ያጌዳ።<verse eid="ISA 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 23:13"/>ባብሎነ ጋድያ በእተ፤ ሄ ጋድያ አሳይ ሀእ ፓናባ ግዴዳ። አሶረ ጋድያ አሳቱ ሄ ጋድያን ዶአይ ሲራናዳን ኦድኖ። ኡንቱንቱ ሄዋን ደእያ ዎጋ ጎለቱዋ ኮሊደ፥ ባረንቱ ጌሶቱዋ ግምቤድኖ፤ ቢታካ መላ ኦድኖ።<verse eid="ISA 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 23:14"/>ህንተኖ፥ ታርሴሳ ጋድያ ማርካብያ አሳቶ፥ ህንተ ጌሱ ላለቴዳ ድራዉ፥ ዝላልተ።<verse eid="ISA 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 23:15"/>ጺሮሳ ካታማይ ላፑን ታሙ ላይ ዶገቲደ ደአና ዎዲ ያና፤ ሄዌነ፥ እት ካትያ ላይ ኬሻ ግያዋ። ላፑን ታሙ ላይይ ዉርያ ዎደ፥ ሻርሙጻ ምሽራትዉ የጸትያ የ ማላይ፥ ጺሮሳ ካታማዉ የጸታና። ኡንቱንቱ፥ <verse eid="ISA 23:15"/><verse number="16" style="v" sid="ISA 23:16"/>“ሀነ፥ ዶገቴዳ ሻርሙጻተ፥ ነ ዲ አካ፤ ካታማን ዩያ። ኔና አሳይ ሀሳያና ማላ፥ ማልኦ ቃላን ዳሮ የ የጻ” ያጋና።<verse eid="ISA 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 23:17"/>ላፑን ታሙ ላይይ ፖለትያ ዎደ፥ መና ጎዳይ ጺሮሳ ጾሞሳና። ሽን ሄዋፐ ጉይያን፥ አ በን ባረ ሻርሙጻ ኦሶ ስማና፤ ሳኣን ደእያ ካዉተቱዋ ኡባና ሻርሙጻና። <verse eid="ISA 23:17"/><verse number="18" style="v" sid="ISA 23:18"/>ግዶፐነ፥ እዚ ዛልኢነ እ ድርጉ መና ጎዳዉ ዱማቴዳዋ ግዳና፤ እዚ ዛልኢ ዳሮ ቁማነ ሎኦ ማዩዋ ሻማናዉ፥ መና ጎዳዉ ኦያ አሳቶ እመታናፐ አትና፥ ሚሻ ጎልያንነ ምንጃ ጎልያን ኡተና።<verse eid="ISA 23:18"/></para>
  <chapter eid="ISA 23"/>
  <chapter number="24" style="c" sid="ISA 24"/>
  <para style="ms">ዋየትያ እስራኤልያ አሳቶ ህዶታ ኪታ</para>
  <para style="mr">(<ref loc="ISA 24:1-27:13">24:1—27:13</ref>)</para>
  <para style="s1">መና ጎዳይ ሳኣ ሙራና</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 24:1"/>በእተ፥ መና ጎዳይ ጋድያ ኮሊደ መላ ከሳና፤ እ ጋድያ ባይዚደ፥ አን ደእያ አሳካ ላላና። <verse eid="ISA 24:1"/><verse number="2" style="v" sid="ISA 24:2"/>ሀራ አሳ ቦላን ሀንያዋዳን ቄሳቱ ዋ ቦላንካ፥ ቆማ ቦላን ሀንያዋዳን ጎዳ ቦላንካ፥ ቆማት ቦላን ሀንያዋዳን ጎዳት ቦላንካ፥ ሻምያዋ ቦላን ሀንያዋዳን ዛልእያዋ ቦላንካ፥ ታልእያ እምያዋ ቦላን ሀንያዋዳን ታልእያ አክያዋ ቦላንካ፥ አጩዋ አችያዋ ቦላን ሀንያዋዳን፥ አጩዋ አሸትያዋ ቦላንካ ሀናና። <verse eid="ISA 24:2"/><verse number="3" style="v" sid="ISA 24:3"/>ቢታይ ኡባና መላ ከሳና፤ ቃይ ኡባናካ ቦንቀታናዋ። አያዉ ጎፐ፥ ሀ ቃላ መና ጎዳይ ሃሳዬዳ።<verse eid="ISA 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 24:4"/>ቢታይ ሎይ መልና፥ አ አጫይ ኡባይ ሹሌ፤ ጋድያን ደእያ ዎልቃማ አሳይካ ዳቡሬ። <verse eid="ISA 24:4"/><verse number="5" style="v" sid="ISA 24:5"/>ቢታይ ባረናን ደእያ አሳፐ ደንዴዳዋን ቱኔዳ። አያዉ ጎፐ፥ ኡንቱንቱ ህግያ ኮሌድኖ፤ ዎጋ መንድኖ፤ መና ጫቁዋካ ኮሌድኖ። <verse eid="ISA 24:5"/><verse number="6" style="v" sid="ISA 24:6"/>ሄዋ ድራዉ፥ ጾሳ ሸቃይ ጋድያ ሜ፤ ቃይ አን ደእያ አሳቱካ ባረንቱ ባይዙዋ ጋሱዋን ሙረቴድኖ። ሄዋ ድራዉ፥ ሳኣን ደእያ አሳቱ ጹገቴድኖ፤ ያትና ፓይዱዋን ጉ አሳይ አቴዳ። <verse eid="ISA 24:6"/><verse number="7" style="v" sid="ISA 24:7"/>ዎይንያ ቱራ አኑ መልና፥ ዎይንያ ኤሳይካ ዉሬዳ፤ ካሰ ናሸትያ ኡባይ ካዮቴዳ። <verse eid="ISA 24:7"/><verse number="8" style="v" sid="ISA 24:8"/>ካራቡዋ ባቃ ናሸቻይ ጮኡ ጌዳ። ናሸትያዋንቱ ሆምቦጨይካ ኤቄዳ። ሎእያ ዲ ናሸቻይካ ጮኡ ጌዳ። <verse eid="ISA 24:8"/><verse number="9" style="v" sid="ISA 24:9"/>ሀዋፐ ስንናዉ የ የጺድ፥ ኡንቱንቱ ዎይንያ ኤሳ ኡሽክኖ፤ ማይያ ኡሻይ ኡሽያዋንቶ ጫሞ ግዳናዋ። <verse eid="ISA 24:9"/><verse number="10" style="v" sid="ISA 24:10"/>ማራ ማጫራ ዬዳ ካታማይ ላለቴዳ፤ ኦንነ ገለናዳን፥ ጎልያ ኡባይ ጎርደቴዳ። <verse eid="ISA 24:10"/><verse number="11" style="v" sid="ISA 24:11"/>ዎይንያ ኤሳይ ዬዳዎ አሳይ ዳባባን ዋሴ፤ ናሸቻ ኡባይ ካዮ ላመቴዳ፤ ሳኣ ናሸቻይ ኡባይ ክቼዳ። <verse eid="ISA 24:11"/><verse number="12" style="v" sid="ISA 24:12"/>ካታማይ ኮለቴዳ፤ ካታማ ፐንገቱካ መኤረቴድኖ። <verse eid="ISA 24:12"/><verse number="13" style="v" sid="ISA 24:13"/>ዎጋራ ቴራ ቃደ ቆቆፍያዋዳን፥ ዎይ ዎይንያ ቴራ ማጽ ስሚደ፥ ቃርምያ ማጽያዋዳን፥ ጋድያ ቦላን ደእያ ካዉተቱዋ ግዶን ሄዋዳን ሀናና።<verse eid="ISA 24:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 24:14"/>ኡንቱንቱ ባረንቱ ቃላ ቁ ኦደ፥ ናሸቻን የጺኖ፤ አዋይ ዉልያ ባጋና ደእያ ኡባይ መና ጎዳ ግታተ ኦዳና። <verse eid="ISA 24:14"/><verse number="15" style="v" sid="ISA 24:15"/>ሄዋ ድራዉ፥ አዋይ ዶልያ ባጋና ደእያዋንቶ፥ መና ጎዳዉ ቦንቹዋ እምተ፤ አባ ዶናን ደእያ ቢታቱዋን ደእያዋንቶ፥ እስራኤልያ መና ጎዳ፥ ጾሳ ሱንዉ ቦንቹዋ እምተ። <verse eid="ISA 24:15"/><verse number="16" style="v" sid="ISA 24:16"/>ቢታ ጋጻፐ፥ “ጽሎ ቦንቹ ግዶ” ያግያ የ ኑን ስሴቶ።</para>
  <para style="p" vid="ISA 24:16">ሽን ታን፥ “ታን ግልቃይ! ታን ግልቃይ! ታዉ አየ አና! አያዉ ጎፐ፥ ካድያዋንቱ ካዲኖ፤ ካድያዋንቱ ሎይ አ እሚኖ” ያጋይ። <verse eid="ISA 24:16"/><verse number="17" style="v" sid="ISA 24:17"/>ህንተኖ፥ ሳኣ ቦላን ደእያ አሳቶ፥ ዳጋማይ፥ አፉነ ጲሪ ህንተና ናጌ። <verse eid="ISA 24:17"/><verse number="18" style="v" sid="ISA 24:18"/>ሳሉዋ ማስኮተቱ ዶየቴዳ ድራዉነ፥ ጋድያ ባሶቱካ ቃጽያ ድራዉ፥ ዳጋንያ ኮሻፐ ባቃትያዌ ኦላን ኩንዳና፤ ቃይ ኦላፐ ፑደ ከስያዌ ጲርያን ኦይቀታና። <verse eid="ISA 24:18"/><verse number="19" style="v" sid="ISA 24:19"/>ቢታይ ዛኢደ ጳልቀቴዳ፤ ንፕ ጊደ መኤረቴዳ፤ ዎልቃፐ ቃጼዳ። <verse eid="ISA 24:19"/><verse number="20" style="v" sid="ISA 24:20"/>ቢታይ ማቲደ አሳዳን ጋንድጋሬ፤ ጫርኩ ሱግያ ዳስያዳን፥ ዮንቁ ጌ። ማካላንቻቱ ባይዙ አ ሎይ ዴጼዳ ድራዉ፥ ላኤን ደንደናዳን ኩንዴ።<verse eid="ISA 24:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 24:21"/>ሄ ጋላስ መና ጎዳይ ሳሉዋ ዎልቃቱዋ ሳሉዋን፥ ቃይ ሳኣ ካተቱዋካ ሳኣን ሙራና። <verse eid="ISA 24:21"/><verse number="22" style="v" sid="ISA 24:22"/>ኡንቱንቱ ኦላን ደእያ ቃሾ አሳቱዋዳን፥ እትፐ ሺቃና፤ ቃሾ ጎልያን ጎርደቲደ ኡታና። ቃይ ዳሮ ጋላሳፐ ጉይያን፥ ኡንቱንቱ ሙረታና። <verse eid="ISA 24:22"/><verse number="23" style="v" sid="ISA 24:23"/>ሄዋፐ ጉይያን፥ አግናይካ አዋይካ ዬላታና። አያዉ ጎፐ፥ ኡባፐ ዎልቃማ መና ጎዳይ ጽዮነ ደርያንነ የሩሳላመን ካተታና፤ ቃይ እ የሩሳላመ ጭማቱዋ ስንን ባረ ቦንቹዋ ቆንጭሳና።<verse eid="ISA 24:23"/></para>
  <chapter eid="ISA 24"/>
  <chapter number="25" style="c" sid="ISA 25"/>
  <para style="s1">ጋላታ የ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 25:1"/>አቤት መና ጎዳዉ፥ ኔን ታ ጾሳ። ታን ኔና ቁ ቁ ኦና፤ ነ ሱንካ ጋላታና። አያዉ ጎፐ፥ ኔን ፖሎ አማነትያዋን በንፐ ሀልቼቲደ ደእያ ማላልስያ ኦሶቱዋ ኦዳ። <verse eid="ISA 25:1"/><verse number="2" style="v" sid="ISA 25:2"/>ኔን ካታማ ሹቻይ ኦለትያ ሳኣ ኦዳ፤ ምኑዋን ግምበቴዳ ካታማ ኮላዳ። አላጋቱዋ ካትያ ጎልያካ ላኤን ካታማ ግደናዳን ኦዳ። ስሚደ ሙለካ ኬጸተና። <verse eid="ISA 25:2"/><verse number="3" style="v" sid="ISA 25:3"/>ሄዋ ድራዉ፥ ምኖ አሳቱ ኔና ቦንቻና፤ መቀ ባይና ካዉተቱዋ ካታማቱካ ነዉ ያያና። <verse eid="ISA 25:3"/><verse number="4" style="v" sid="ISA 25:4"/>ኔን ህዬሳዉ ባቃት አትያሳ። መቶታንቻዉካ ባረ መቱዋ ዎደ ባቃት አትያሳ፥ ኡሹዋፐ አትያ ሳኣነ አዋ ሴላፐ አትያ ኩዋ ግዳዳ። አያዉ ጎፐ፥ መቀ ባይና አሳ ሀንቁ ግምቢያ ሾጭያ ኡሹዋ ማላነ <verse eid="ISA 25:4"/><verse number="5" style="v" sid="ISA 25:5"/>ባዙዋ ጋድያ ምሹዋ ማላ። አዋ ምሹ ሻርያ ኩዋን ጋቢ ግያዋዳን፥ ኔን አላጋቱዋ ዋላሳ ሀይዝሳዳ፤ ያትና፥ መቀ ባይና አሳቱዋ የይ ጮኡ ጌዳ።<verse eid="ISA 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 25:6"/>ኡባፐ ዎልቃማ መና ጎዳይ አሳ ኡባዉ ሀ ደርያ ቦላን ዎልቃማ ግብራ ጊግሳና፤ ሄዌካ ሞቱዋ፥ ኮልዝያና ደእያባቱዋነ ሎኦ ካኤዳ ዎይንያ ኤሳ ግብራ። <verse eid="ISA 25:6"/><verse number="7" style="v" sid="ISA 25:7"/>ሀ ደርያን አሳ ኡባ ጫሜዳዋ፥ ካዉተ ኡባ ቦላንካ ምጨቴዳ ጋርዱዋ እ ይሳና። <verse eid="ISA 25:7"/><verse number="8" style="v" sid="ISA 25:8"/>ሀይቁዋ እ መናዉ ምታና፤ ኡባ ሞድያ መና ጎዳይ አይፍያ ኡባፐ አፎ ቁጫና፤ ባረ አሳ ካዉሻካ ቢታ ኡባፐ ድጋና። ሀዋ መና ጎዳይ ኦዴዳ።<note caller="-" style="x"><char style="xo" closed="false">25:8 </char><char style="xt" closed="false"><ref loc="1CO 15:54">1 ቆሮ. 15:54</ref>፤ <ref loc="REV 7:17">ሳፃ 7:17</ref>፤ <ref loc="REV 21:4">21:4</ref></char></note><verse eid="ISA 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 25:9"/>ሄ ጋላስ ኡንቱንቱ ሀዋዳን ያጋና፤ “ሀዌ ቱሙ ኑ ጾሳ፤ ኑን እ ኑና አሻናዳን ናጌዶ፤ እ ኑና አሼዳ። ሀዌ መና ጎዳ፤ ኑን አ ናጌዶ። አነ አ አቶተን ሀሹ ጌቶነ ናሸቴቶ” ያጋና።<verse eid="ISA 25:9"/></para>
  <para style="s1">ጾሳይ ሞኣባ ቢታ ሙራና</para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 25:10"/>አያዉ ጎፐ፥ መና ጎዳ ኩሺ አሻናዉ ሀ ደርያ ቦላን ግዳናዋ። ሽን ዳርጫ ፕቱዋ ኦላን የጊደ የያዋዳን፥ ሞኣባ ቢታ አሳይ ባረ ሳኣን የታና።<note caller="-" style="x"><char style="xo" closed="false">25:10-12 </char><char style="xt" closed="false"><ref loc="ISA 15:1-16:14">ኢሳ. 15:1—16:14</ref>፤ <ref loc="JER 48:1-47">ኤር. 48:1-47</ref>፤ <ref loc="EZK 25:8-11">ህዝ. 25:8-11</ref>፤ <ref loc="AMO 2:1-3">አሞጻ 2:1-3</ref>፤ <ref loc="ZEP 2:8-11">ሶፎ. 2:8-11</ref></char></note> <verse eid="ISA 25:10"/><verse number="11" style="v" sid="ISA 25:11"/>ሃ ዋያዌ ሃ ዋናዉ ባረ ኩሽያ ፕድ ኦያዋዳን፥ ኡንቱንቱ ሄዋ ግዶን ባረንቱ ኩሽያ ፕድ ኦና። ሽን ጾሳይ አ ኦቶሩዋ አ ኩሽያ ገንያናካ ጋደ ካዉሻና። <verse eid="ISA 25:11"/><verse number="12" style="v" sid="ISA 25:12"/>ኡንቱንቱ ቂሲደ፥ ምኑዋን ግምቤዳ ግምቢያ እ ዱገ አሀናነ ካዉሻና፤ ዱገ ሳኣን፥ ኡባ ህርክ ባናን ኦላና።<verse eid="ISA 25:12"/></para>
  <chapter eid="ISA 25"/>
  <chapter number="26" style="c" sid="ISA 26"/>
  <para style="s1">ጾሳይ ባረ አሳዉ ጾኑዋ እማና</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 26:1"/>ሄ ጋላስ ይሁዳ ጋድያን ሀ የይ የጸታና።</para>
  <para style="b" vid="ISA 26:1"/>
  <para style="q1" vid="ISA 26:1">ኑዉ ምኖ ካታማይ ደኤ፤</para>
  <para style="q2" vid="ISA 26:1">ጾሳይ አቶተ አ ዩሹዋን ግምቢያዳንነ ጌሱዋዳን ኤሴ።<verse eid="ISA 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 26:2"/>አማኑዋ ናግያ ጽሎ ካዉተይ ገላና ማላ፥</para>
  <para style="q2" vid="ISA 26:2">ፐንግያ ዶይተ።<verse eid="ISA 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 26:3"/>ባረ ቆፋ ኔናን ዎዳ አሳ</para>
  <para style="q2" vid="ISA 26:3">ኔን ፖሎ ሳሮተን ናጋሳ፤</para>
  <para style="q1" vid="ISA 26:3">አያዉ ጎፐ፥ እ ኔናን አማነቴ።<verse eid="ISA 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 26:4"/>መና ጎዳን መናዉ አማነትተ፤</para>
  <para style="q2" vid="ISA 26:4">አያዉ ጎፐ፥ መና ጎዳይ፥ መና ጎዳይ መና ዛላ።<verse eid="ISA 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 26:5"/>ቃን ደእያዋንታነ፥</para>
  <para style="q2" vid="ISA 26:5">ኡንቱንቱ ቃ ካታማ ዝቂ ኦዳ፤</para>
  <para style="q1" vid="ISA 26:5">እ አ ካዉሼ።</para>
  <para style="q2" vid="ISA 26:5">ዱገ ሳኣ ጋካናዉ ዝቂ ኦ፤</para>
  <para style="q2" vid="ISA 26:5">ቢታ ባናን ኦሌ።<verse eid="ISA 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 26:6"/>ማንቁዋ ገዲ፥ መቶታንቻ ገዲ፥ አ የና።<verse eid="ISA 26:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 26:7"/>ጽሎቱዋ ኦጊ ሳላላ።</para>
  <para style="q2" vid="ISA 26:7">አቤት ጽሎ፥ ኔን</para>
  <para style="q2" vid="ISA 26:7">ጽሎቱዋ ኦግያ ሳላልሳሳ።<verse eid="ISA 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 26:8"/>ኤ መና ጎዳዉ፥ ነ ህግያ ኦግያን ሀመቲደ፥</para>
  <para style="q2" vid="ISA 26:8">ኑን ኔና ናጌቶ።</para>
  <para style="q1" vid="ISA 26:8">ኑ ዎዛና አሙ፥</para>
  <para style="q2" vid="ISA 26:8">ነ ሱን ቦንቻናዋ ጻላላ።<verse eid="ISA 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 26:9"/>ቃማን ታን ኔና ላሞታይ፤</para>
  <para style="q2" vid="ISA 26:9">ዎንታን ታ ግዶን ደእያ ታ አያናይ፥</para>
  <para style="q2" vid="ISA 26:9">ቱሙዋፐ ኔና ምንሲደ ኮዬ።</para>
  <para style="q2" vid="ISA 26:9">አያዉ ጎፐ፥ ነ ፕርዳይ ሳኣን ደእያ ዎደ፥</para>
  <para style="q2" vid="ISA 26:9">ሳኣን ደእያ አሳይ ጽሎተ ታማሬ።<verse eid="ISA 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 26:10"/>ኢታ አሳዉ ኬካተ ኦፐካ፥</para>
  <para style="q2" vid="ISA 26:10">እ ጽሎተ ታማረና።</para>
  <para style="q1" vid="ISA 26:10">ሱረ አሳቱዋ ጋድያን ኢታባ ኦ፤</para>
  <para style="q2" vid="ISA 26:10">መና ጎዳ ግታተካ ኤረና።<verse eid="ISA 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 26:11"/>አቤት መና ጎዳዉ፥ ኔን፥</para>
  <para style="q2" vid="ISA 26:11">ነ ኩሽያ ቁ ኦዳ፤</para>
  <para style="q1" vid="ISA 26:11">ሽን ኡንቱንቱ በእክኖ።<note caller="-" style="x"><char style="xo" closed="false">26:11 </char><char style="xt" closed="false"><ref loc="HEB 10:27">እብራ. 10:27</ref></char></note></para>
  <para style="q2" vid="ISA 26:11">ነ አሳዉ ኔን ምሸትያ ምሹዋ በኢደ ዬላትኖ።</para>
  <para style="q1" vid="ISA 26:11">ኔን ነ ሞርከቶ ዎዳ ታማይ፥</para>
  <para style="q2" vid="ISA 26:11">ኡንቱንታ ም ይሶ።<verse eid="ISA 26:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 26:12"/>አቤት ጾሳዉ፥ ኔን፥</para>
  <para style="q2" vid="ISA 26:12">ኑዉ ሳሮተ ምንዳ፤</para>
  <para style="q1" vid="ISA 26:12">ኑ ኦሶ ኡባ ኔን ኑዉ ኦዳ።<verse eid="ISA 26:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 26:13"/>አቤት መና ጎዳዉ፥ ኑ ጾሳዉ፥</para>
  <para style="q2" vid="ISA 26:13">ኔፐ ሀራቱ ኑና ሞዴድኖ፤</para>
  <para style="q1" vid="ISA 26:13">ሽን ኑን ነ ሱን ጻላላ ቦንቼቶ።<verse eid="ISA 26:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 26:14"/>ኡንቱንቱ ሀይቄድኖ፤</para>
  <para style="q2" vid="ISA 26:14">ስሚደ ፓጻ ደእክኖ።</para>
  <para style="q1" vid="ISA 26:14">ኔን ይሰዳ ድራዉ፥</para>
  <para style="q2" vid="ISA 26:14">ስሚደ ደንድክኖ።</para>
  <para style="q1" vid="ISA 26:14">ኡንቱንቱ ሀሳየትያዋ ኡባ ቁጫ ይሳዳ።<verse eid="ISA 26:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 26:15"/>አቤት መና ጎዳዉ!</para>
  <para style="q2" vid="ISA 26:15">ኔን አሳ ዳርሳዳ።</para>
  <para style="q1" vid="ISA 26:15">አሳ ዳርሳደ፥ ኔን ቦንቼታዳ፤</para>
  <para style="q2" vid="ISA 26:15">ቢታ ዛዋ ኡባካ አሳዳ።<verse eid="ISA 26:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 26:16"/>አቤት መና ጎዳዉ!</para>
  <para style="q2" vid="ISA 26:16">መቱዋ ዎደ ኡንቱንቱ ኔና ኮዬድኖ።</para>
  <para style="q1" vid="ISA 26:16">ኔን ኡንቱንታ ሙሬዳ ዎደ፥</para>
  <para style="q2" vid="ISA 26:16">ኡንቱንቱ ኔና ሳሱክ ዎሴድኖ።<verse eid="ISA 26:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 26:17"/>አቤት መና ጎዳዉ! ሻሃሬዳ ምሽራታ፥</para>
  <para style="q2" vid="ISA 26:17">የልያ ዎዲ ጋክና፥</para>
  <para style="q1" vid="ISA 26:17">የሉዋ ኡንኤታደ ዋስያዋዳን፥</para>
  <para style="q2" vid="ISA 26:17">ኑንካ ነ ስንን ሄዋዳን ሀኔዶ።<verse eid="ISA 26:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 26:18"/>ኑን ሻሃሬዶ፤ ኦይ ኦይቀቴዶ፤</para>
  <para style="q2" vid="ISA 26:18">ሽን ጫርኩዋ የልያዋ ግዴዶ።</para>
  <para style="q1" vid="ISA 26:18">ኑን ሳአዉ አቶተ አህበይኮ፤</para>
  <para style="q2" vid="ISA 26:18">ሳኣን ደእያ አሳካ የልቦኮ።<verse eid="ISA 26:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 26:19"/>ሀይቄዳ ነ አሳይ ፓጻና፤<note caller="-" style="x"><char style="xo" closed="false">26:19 </char><char style="xt" closed="false"><ref loc="DAN 12:2">ዳኔላ 12:2</ref></char></note></para>
  <para style="q2" vid="ISA 26:19">ኡንቱንቱ አሃይ ደንዳና።</para>
  <para style="q1" vid="ISA 26:19">ህንተኖ፥ ቢታ ባና ግዶን ደእያዋንቶ፥</para>
  <para style="q2" vid="ISA 26:19">ህንተ ጻሳይ ዎንታ ከተርሳ ማላ ግድያ ግሻዉነ፥</para>
  <para style="q2" vid="ISA 26:19">ሳአይካ ሀይቄዳዋንታ ዛረደ እምያ ድራዉ፥</para>
  <para style="q2" vid="ISA 26:19">ቤጎትተነ ናሸቻዉ የጽተ።<verse eid="ISA 26:19"/></para>
  <para style="s1">ፕርዳነ ኦሞዱዋፐ ስምያዋ</para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 26:20"/>ታ አሳቶ፥ ሃ ዪተ፤ ህንተ ጎለ ገሊደ፥ ፐንግያ ህንተ ቦላ ጎርድተ። ጾሳ ሀንቁ አና ጋካናዉ፥ ጉ ዎድያ ህንተና ቆስተ። <verse eid="ISA 26:20"/><verse number="21" style="v" sid="ISA 26:21"/>ቢታ ቦላን ደእያ አሳ፥ ኡንቱንቱ ናጋራ ድራዉ ሙራና፥ መና ጎዳይ ባረ ደኢያሳፐ ከሲደ ዬ። ቢታይካ ባረ ቦላን ጉኬዳ ሱ ቆንጭሳና፤ ዎዳዋንታካ ላኤን ገንና።<verse eid="ISA 26:21"/></para>
  <chapter eid="ISA 26"/>
  <chapter number="27" style="c" sid="ISA 27"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 27:1"/>ሄ ጋላስ መና ጎዳይ ባረ ምኖ፥ ግታነ ዎልቃማ ማሻን ሌዋታና ግያ ኮልጽያነ ጻጸትያ ሾሻ ሙራና፤ አባን ደእያ ዳዊያካ ዎና።<note caller="-" style="x"><char style="xo" closed="false">27:1 </char><char style="xt" closed="false"><ref loc="JOB 41:1">ኢዮባ 41:1</ref>፤ <ref loc="PSA 74:14">ማዝ. 74:14</ref>፤ <ref loc="PSA 104:26">104:26</ref></char></note> <verse eid="ISA 27:1"/><verse number="2" style="v" sid="ISA 27:2"/>ሄ ጋላስ ሀዋዳን ጌተታና፤ “ሀዌ ዶሰቴዳ ዎይንያ ቱራ ሳ፤ አባ የጽተ! <verse eid="ISA 27:2"/><verse number="3" style="v" sid="ISA 27:3"/>ታን፥ መና ጎዳይ አ ናግያዋ፤ ታን አ ሀእ ሀእ ሃ ኡሻይ፤ ኦንነ አ ቆሄናዳን፥ ታን ቃማነ ጋላስ አ ናጋይ። <verse eid="ISA 27:3"/><verse number="4" style="v" sid="ISA 27:4"/>ታን ሀንቀትከ፤ ታናና ኦለታናዉ፥ አጉንይነ ጎምኦሪ ደኤርክኖሻ! ታን ኡንቱንቱ ቦላ ከሳ ኤቃደ፥ ኡንቱንታ ጹጋ ዉርሳና። <verse eid="ISA 27:4"/><verse number="5" style="v" sid="ISA 27:5"/>ዎይ ባቃት ቆሰት አታናዉ ታኮ ዪኖ፤ ታናና ጊግኖ፤ ኤ፥ ታናና ጊግኖ” ያገታና።<verse eid="ISA 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 27:6"/>ያና ጋላሳቱዋን ያቆብ ጻጱዋ የዳና፤ እስራኤሊ አጫናነ ጪሻና፤ ያቲደ አይፌዳ አይፊ ሳኣ ኡባ ኩማና።<verse eid="ISA 27:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 27:7"/>ኡንቱንታ ሾጬዳዋንታ ሾጬዳዋዳን፥ መና ጎዳይ እስራኤልያ አሳ ሾጬደየ? ዎይ ኡንቱንታ ዎዳዋንቱ ሀይቄዳዋዳን፥ ኡንቱንቱ ሀይቄድኖየ? <verse eid="ISA 27:7"/><verse number="8" style="v" sid="ISA 27:8"/>ጾሳይ ባረ አሳ ኦሞዶ የድያዋን ሙሬዳ፤ አዋይ ዶልያ ባጋ ጫርኩዋ ጋላስ ኡንቱንታ ባረ ያሽያ ጎትያን ላግ ከሴዳ። <verse eid="ISA 27:8"/><verse number="9" style="v" sid="ISA 27:9"/>ሄዋ ድራዉ፥ ያቆባ ባይዙ አቶ ጌተታናዌነ አ ናጋራይ ፖሎ ቁጨታናዌ ሀዋና: ሄዌካ ያርሽያ ሳኣ ሹቻ ኡባ እ መኤረቴዳ ቦቅን ሹቻዳን ኦያ ዎደነ፥ አሼሮ ግያ ማጫ ጾሳት ምስሊ፥ ዎይ እጻና ጩዋዪደ፥ ያርሽያ ሳአይካ ኤቁዋን አተናዳን ኦያ ዎደ።<verse eid="ISA 27:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 27:10"/>ምኑዋ ድረቴዳ ካታማይ ኦኔዳ፤ ካሰ አሳይ ደእያ ሳአይ ሀእ ባዙዋዳን፥ መላ አቴዳነ ዶገቴዳ፤ እ መሂ ሄመትያ ሳኣ ግዴዳ ድራዉ፥ ም ቦንጭያ ሚደ፥ ማራቱ ሄዋን አላጺኖ። <verse eid="ISA 27:10"/><verse number="11" style="v" sid="ISA 27:11"/>ም ታሸቱ መልያ ዎደ መኤረቲኖ፤ ማጫ አሳይካ ዪደ፥ ኡንቱንታ ኤናዉ አፌ። ሀ አሳይ አኬክ ባይና አሳ ግድያ ድራዉ፥ ኡንቱንታ መዳዌ ኡንቱንቶ ቃረተናነ ማረና።<verse eid="ISA 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 27:12"/>ሄ ጋላስ ኤፍራጺሳ ሻፋፐ ግብጼ ሻፋ ጋካናዉ፥ መና ጎዳይ ካ ቡካና፤ ህንተኖ፥ እስራኤልያ አሳቶ፥ ህንተካ ህንተ ታራን ታራን ሺቃና።<verse eid="ISA 27:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 27:13"/>ሄ ጋላስ ዎልቃማ ማላካታይ ፑነታና፤ አሶረ ጋድያን ይያዋንቱነ ግብጼ ቢታዉ የደርሴዳዋንቱ ያና፤ የሩሳላመን ጌሻ ደርያን መና ጎዳዉ ጎይናና።<verse eid="ISA 27:13"/></para>
  <chapter eid="ISA 27"/>
  <chapter number="28" style="c" sid="ISA 28"/>
  <para style="ms">ጾሳይ ማካላንቻ አሳ ሙርያዋ ግዱሳ</para>
  <para style="mr">(<ref loc="ISA 28:1-31:9">ኢሳ. 28:1—31:9</ref>)</para>
  <para style="s1">ሁጲሳ ካዉተ፥ “ኔና ኤራ!” ጌዳዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 28:1"/>ኤፍሬማን ደእያ ማትያዋንቱ ካላቻዉነ፥ ዎይንያ ኤሳይ ጾኔዳዋንቱ አራዳ ዛንጋራን ደእያ፥ ሹልያ ጪሻ ማላ ግዴዳ አ ቦንቹዋ ፑላዉ አየ አና! <verse eid="ISA 28:1"/><verse number="2" style="v" sid="ISA 28:2"/>በእተ፥ ጎዳዉ ዎልቃማነ ምኖ ግዴዳ እት አሳይ ደኤ፤ ጎዳይ አ ሻቻ ኡሹዋዳን፥ ባይዝያ ጎትያዳንነ ኩንደ ጎግያ ዎልቃማ ሃዳን፥ ምኖ ኩሽያን ዱገ ሳኣ ኦላና። <verse eid="ISA 28:2"/><verse number="3" style="v" sid="ISA 28:3"/>ሄ ማትያ ኤፍሬማ አሳቱዋ ኦቶሩዋ ካላቻይ ገድያን የታና። <verse eid="ISA 28:3"/><verse number="4" style="v" sid="ISA 28:4"/>አራዳ ዛንጋራ ሁጲያን ደእያ ቆቆፈትያ ጪሻይ፥ አ ቦንቹዋ ፑላይ ዎዲ ጋካናፐ ካሰቲደ ቴሬዳ ባላስያ ማላ ግዳናዋ፤ እት አሳይ ሄ ባላስያ በእያ ዎደ፥ ባረ ኩሽያን ኦይቆሳና ማና።<verse eid="ISA 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 28:5"/>ሄ ጋላስ ኡባፐ ዎልቃማ መና ጎዳይ ባረ አሳፐ አቴዳዋንቶ ቦንቹዋ ካላቻነ ፑላዉ ሁጲያን ኡትያ አሌቁዋ ግዳናዋ። <verse eid="ISA 28:5"/><verse number="6" style="v" sid="ISA 28:6"/>እ ዳናቶ ልከ ፕርድያ አያና፥ ኦላ ሚጻፐ ዛርያዋንቶካ ዎልቃ ግዳናዋ።<verse eid="ISA 28:6"/></para>
  <para style="s1">ኢስያሳ ነ ማቲደ ትምቢትያ ኦድያ ይሁዳ አሳቱዋ</para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 28:7"/>ሀዋንቱካ ዎይንያ ኤሳ ኡሺደ ዪጮቲኖነ ማይያ ኡሻን ጋንድጋሪኖ። ቄሲነ ትምቢትያ ኦድያዌ ማይያ ኡሻን ዪጮቲኖ፤ ኡንቱንቱ ዎይንያ ኡሻን ሻዌቲኖ፤ ማይያ ኡሻንካ ጋንድጋሪኖ። ሳፃ ልከ በእክኖ፤ ፕርዲደካ በቲኖ። <verse eid="ISA 28:7"/><verse number="8" style="v" sid="ISA 28:8"/>ኡንቱንቱ ምያ ማዳ ኡባይ ጮሻ ጻላላ ግድያ ድራዉ፥ ባይቤና ሳአይ ሙለካ ባዋ።<verse eid="ISA 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 28:9"/>ኡንቱንቱ ሀዋዳን ያጋና፤ “ኤራተ እ ኦና ታማርሳኔ? ኪታካ ኦስ ቆንጭሳኔ? ማ ፓኩዋ ብሮ አጌዳዋንቱሴየ፥ ዎይ ን ብሮ ዱዳዋንቱሴ? <verse eid="ISA 28:9"/><verse number="10" style="v" sid="ISA 28:10"/>አያዉ ጎፐ፥ እ ግያዌ ሀዋ፤ አዛዙዋ ቦላ አዛዙዋ፥ አዛዙዋ ቦላ አዛዙዋ፥ ዎጋ ቦላ ዎጋ፥ ዎጋ ቦላ ዎጋ፥ ሀዋን ጉ፥ ሄዋን ጉ” ያጋና።<verse eid="ISA 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 28:11"/>ሽን ጾሳይ አላጋቱዋ ቃላንነ እማቱዋ ዶናን ሀ አሳዉ ሃሳያና።<note caller="-" style="x"><char style="xo" closed="false">28:11-12 </char><char style="xt" closed="false"><ref loc="1CO 14:21">1 ቆሮ. 14:21</ref></char></note> <verse eid="ISA 28:11"/><verse number="12" style="v" sid="ISA 28:12"/>እ ኡንቱንቶ ሀዋዳን ያጌዳ፤ “ሀዌ ሸምፑዋ። ጻላሌዳዋ ሸምፕስተ። ሀዌ ሸምፕ አክያ ሳ” ያጌዳ። ሽን ኡንቱንቱ ስሰናን እጼድኖ። <verse eid="ISA 28:12"/><verse number="13" style="v" sid="ISA 28:13"/>ሄዋ ድራዉ፥ ኡንቱንቱ ቢደ ኩንዳና ማላ፥ መአና ማላነ ግትያን ኦይቀቲደ ኦሞዱዋ ባና ማላ፥ መና ጎዳ ቃላይ ኡንቱንቶ አዛዙዋ ቦላ አዛዙዋ፥ አዛዙዋ ቦላ አዛዙዋ፥ ዎጋ ቦላ ዎጋ፥ ዎጋ ቦላ ዎጋ ግዲደ፥ ሀዋን ጉይ፥ ሄዋን ጉይ ግዴዳ።<verse eid="ISA 28:13"/></para>
  <para style="s1">ጽዮንዉ ጎዳ ጻጱዋ ምንያ ሹቻ</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 28:14"/>ሄዋ ድራዉ፥ ህንተኖ፥ የሩሳላመን ደእያ አሳ ሞድያ ቅሊጭያዋንቶ፥ መና ጎዳ ቃላ ስስተ። <verse eid="ISA 28:14"/><verse number="15" style="v" sid="ISA 28:15"/>ህንተ፥ “ኑን ሀይቁዋና ጊጌዶ፤ ስኦልያናካ ጫቀቴዶ፤ ኑን ዎርዱዋ ኑዉ ደኡዋ ኦዳ ድራዉነ ማልትያ ኑዉ ቆሰት አትያሳ ኦዳ ድራዉ፥ ዎልቃማ ቦሻይ ዪደካ ኑና ቦቼናን አና” ያጊደ ጬቀቲታ።<verse eid="ISA 28:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 28:16"/>ሄዋ ድራዉ፥ ኡባ ሞድያ መና ጎዳይ ሀዋዳን ያጌ፤ “በእተ፥ ታን ጽዮነን ባሱዋ ሹቻ፥ ፓጨቴዳ ሹቻ፥ ጎዳ ጻጱዋ ምንስያ፥ አልኦ ሹቻ ዎድ፤ አን አማንያ ኦንነ ዬላተና።<note caller="-" style="x"><char style="xo" closed="false">28:16 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">ማዝ. 118:22-23</ref>፤ <ref loc="ROM 9:33">ሮመ 9:33</ref>፤ <ref loc="ROM 10:11">10:11</ref>፤ <ref loc="1PE 2:6">1 ጰጽ. 2:6</ref></char></note> <verse eid="ISA 28:16"/><verse number="17" style="v" sid="ISA 28:17"/>ታን ሱረ ፕርዳ ባሱዋ ልክያ ዎዶሩዋ፥ ጽሎተካ ቱምቢያ ኦና። ቃይ ህንተ አማነትያ ዎርዱዋ ጌሱዋ፥ ሻቻይ ሾጫና፤ ህንተ ቆሰት አትያሳካ ሃይ ሙካና” ያጌ። <verse eid="ISA 28:17"/><verse number="18" style="v" sid="ISA 28:18"/>ሄዋፐ ጉይያን፥ ህንተ ሀይቁዋና ጫቀቴዳ ጫቁ ላለታና። ስኦልያናካ ጫቀቴዳ ጫቁካ ምነና። ዎልቃማ ቦሻይ ይያ ዎደ፥ ህንተ አን ሾጨታና። <verse eid="ISA 28:18"/><verse number="19" style="v" sid="ISA 28:19"/>ሄ ቦሻይ ዎንታ ዎንታ፥ ቃምነ ጋላስ ሄዋና አና፤ ሄ አያ ዎደ ኡባንካ፥ ህንተና አክ ባና።</para>
  <para style="p" vid="ISA 28:19">አ ኪታ አኬክያዌ ህንተንቶ ሻቢርሳ ዳጋማ ግዳናዋ። <verse eid="ISA 28:19"/><verse number="20" style="v" sid="ISA 28:20"/>አርሳይ ገድያ ጮጎቲደ ግሳናዉ ቃን፤ አፍላይካ ጋ ማያናዉ ጉ። <verse eid="ISA 28:20"/><verse number="21" style="v" sid="ISA 28:21"/>አያዉ ጎፐ፥ ፓራጺማ ደርያ ቦላን መና ጎዳይ ኦዳዋዳን፥ ባረ ኦሱዋ፥ ባረ እማ ኦሱዋ፥ ሄዌካ ባረ ኦራ ኦሱዋ ኦናዉ ደንዳና። ቃይ ጋባኦና ዛንጋራን ሀንቀቴዳዋዳን ሀንቀታናዋ።<note caller="-" style="x"><char style="xo" closed="false">28:21 </char><char style="xt" closed="false"><ref loc="JOS 10:10-12">ኢያሳ 10:10-12</ref>፤ <ref loc="2SA 5:20">2 ሳሜላ 5:20</ref>፤ <ref loc="1CH 14:11">1 ኦዱዋ 14:11</ref></char></note> <verse eid="ISA 28:21"/><verse number="22" style="v" sid="ISA 28:22"/>ጎዳፐ፥ ኡባፐ ዎልቃማ መና ጎዳፐ እ ቦሻ ቢታ ኡባ ቦላ አሀናዉ ቃቼዳዋ ታን ስሴዳ ድራዉ፥ ህንተ ቃሹ ምነና ማላ፥ ቅሊጭያዋ አግተ።<verse eid="ISA 28:22"/></para>
  <para style="s1">ጾሳ አዳ ኤራተ</para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 28:23"/>ህንተ ሀይ ሃ የጊደ፥ ታን ኦድያዋ ስስተ፤ ታ ሃሳያካ አኬኪደ ስስተ። <verse eid="ISA 28:23"/><verse number="24" style="v" sid="ISA 28:24"/>ካ ዘራናዉ ጎሽያ ጎሻንቻይ ኡባ ገደካ ጎሺደ ደኢ? ቃይ እ ኡባ ገደካ ጉሉዋ ክንቺደነ ሊቅሲድ ደኢ? <verse eid="ISA 28:24"/><verse number="25" style="v" sid="ISA 28:25"/>ጋድያ ሊቅሲደ፥ አኑጋ ላሌ፤ ካረ ሳዉዋካ ዘሬ፤ ዛርጋካ አ ይፓን፥ ባንጋካ አ ቆሙዋን፥ ሞርገ ምካ አዉ በስያ ሳኣን ዘሬ ግደኔ? <verse eid="ISA 28:25"/><verse number="26" style="v" sid="ISA 28:26"/>አያዉ ጎፐ፥ ሀ ሂላ አ ጾሳይ አ ኤርሴነ ታማርሴ። <verse eid="ISA 28:26"/><verse number="27" style="v" sid="ISA 28:27"/>ካረ ሳዉዋ ኡዱላ ምን ቆጸና፤ አኑጋካ ጩጉዋን ቡከና። ሄዋ አጊደ፥ ካረ ሳዉዋካ ጋትማን፥ አኑጋካ ጻምአን ቆጼ። <verse eid="ISA 28:27"/><verse number="28" style="v" sid="ISA 28:28"/>ኡክ ኡክያ ካ ቆጽያሳን ቆጽያዌ ሊቅሲየ? ግደና፥ እ አ ቆጺደ ቆጺደ፥ መናዉ ደኤና። ቃይ እ ካ ቡክያ ፓራ ጋረቱዋ አ ቦላና ላጊደካ ካይ ጋጨታናዳን ኦና። <verse eid="ISA 28:28"/><verse number="29" style="v" sid="ISA 28:29"/>ሀዌካ ቃይ ማላልስያ ዞርያ ዞርያ፥ ኦሱዋካ አዳ ኤራን ኦያ ኡባፐ ዎልቃማ መና ጎዳፐ ዬ።<verse eid="ISA 28:29"/></para>
  <chapter eid="ISA 28"/>
  <chapter number="29" style="c" sid="ISA 29"/>
  <para style="s1">ዳዊታ ካታማ የሩሳላምዉ አየ አና!</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 29:1"/>ኔኖ ዳዊተ ደኤዳ አሪኤላ ግያ ካታማዉ፥ ነዉ አየ አና! ላይ ቦላን ላይ ጉጃ፤ ባላቱዋካ ዛራ ዛራደ ቦንቻ። <verse eid="ISA 29:1"/><verse number="2" style="v" sid="ISA 29:2"/>ታን አሪኤላ ግያ ካታማ ብሮካ ኡንኤና፤ ኡንቱንቱ ዝላላናነ ዬካና። ሄ ካታማይ ሱይ ካሜዳ ያርሽያ ሳኣ ማላ ግዳናዋ። <verse eid="ISA 29:2"/><verse number="3" style="v" sid="ISA 29:3"/>ታን ነ ዩሹዋን ዶዳናነ አዱሳ ግምቢያን ኔና ድራና፤ ነ ቦላን ኦላ ማማ ኬጻና። <verse eid="ISA 29:3"/><verse number="4" style="v" sid="ISA 29:4"/>ሄዋፐ ጉይያን፥ ኔን ቢታ ጪሙዋፐ ሃ ፑደ ሃሳያና፤ ህርክ ባናፐ ነ ኮሻይ ያና። ነ ኮሻይ ሞይትልያ ኮሻ፥ ቢታ ግዶፐ ከሳና፤ ነ ሃሳያይካ ባና ግዶፐ ሳሱከታና።<verse eid="ISA 29:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 29:5"/>ሽን ነ ሞርከቱ ሊቆ ባና ኬሻ ጮራነ ነ መቀ ባይናዋንቱ ፓይዱካ ጫርኩ አፍያ ሱላ ኬሻ ዳሮ ግዳናዋ። ቆፐናን ደእሽን ኤለካ፥ <verse eid="ISA 29:5"/><verse number="6" style="v" sid="ISA 29:6"/>ኡባፐ ዎልቃማ መና ጎዳይ ጉጉንን፥ ቢታ ቃን፥ ዎልቃማ ኮሻን፥ ጎትያን፥ ጫርኩዋንነ ምያ ታማ ላጩዋን ህንተና ጾሞሳና። <verse eid="ISA 29:6"/><verse number="7" style="v" sid="ISA 29:7"/>አሪኤላ ካታማ ኦልያ ጮራ ካዉተ ኡባይ፥ ሄ ካታማነ አ ጌሱዋ ኦልያ ኡባይ፥ አ ዋይስያ ኡባይ አኩሙዋዳን፥ ቃማ ሳጻዳን ሀናና። <verse eid="ISA 29:7"/><verse number="8" style="v" sid="ISA 29:8"/>ኮሻቴዳ አሳይ አኩሙዋን ሜ፤ ሽን ቤጎትያ ዎደ አ ኮሻይ አገና፤ ዎይ ሳመቴዳ አሳይ አኩሙዋን ኡሼ፤ ሽን ቤጎትያ ዎደ ዳቡሬ፤ ሳሙዋካ አልቤና፤ ጽዮነ ደርያ ኦልያ ጮራ ካዉተ ኡባይ ሄዋዳን ሀናና።<verse eid="ISA 29:8"/></para>
  <para style="s1">ጾሳ አዛዙዋ ካያዌ አህያ ሙሩዋ</para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 29:9"/>ህንተ ህንተረካ ዳመቲደ፥ ዳማ አሳ ግድተ፤ ህንተና ህንተረካ ቆቅሲደ፥ ቆቀ አሳ ግድተ። ማትተ፤ ሽን ዎይንያ ኤሳና ግዶፖ። ጋንድጋርተ፤ ሽን ማይያ ኡሻና ግዶፖ። <verse eid="ISA 29:9"/><verse number="10" style="v" sid="ISA 29:10"/>አያዉ ጎፐ፥ መና ጎዳይ ገምእሹዋ ሶኑ ኦያ አያና ህንተ ቦላን ጉሴዳ። ትምቢትያ ኦድያዋንቶ፥ ያቲደ ህንተ አይፈቱዋ እ ጎዜዳ። ሳፃ በእያዋንቶ፥ ህንተ ሁጰቱዋካ ጉሎዬዳ።<note caller="-" style="x"><char style="xo" closed="false">29:10 </char><char style="xt" closed="false"><ref loc="ROM 11:8">ሮመ 11:8</ref></char></note><verse eid="ISA 29:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 29:11"/>ሀ ኡባ ሳጻይ ነዉ አታመቴዳ ማጻፋ ማላ ግዴዳ። አሳይ፥ “ሄይ፥ ሀዋ ናባባ” ያግ፥ እት ናባብ ዳንዳይያ ኡራዉ እምያ ዎደ እ፥ “ማጻፋይ አታመቴዳ ድራዉ፥ ታን ናባባናዉ ዳንዳይከ” ያጋና። <verse eid="ISA 29:11"/><verse number="12" style="v" sid="ISA 29:12"/>ቃይ ማጻፋ ናባብ ዳንዳየና ኡራዉ፥ “ሄይ፥ ሀዋ ናባባ” ያጊደ እምያ ዎደ፥ እ፥ “ታን ናባባናዉ ዳንዳይከ” ያጋና።<verse eid="ISA 29:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 29:13"/>ያትና፥ ጎዳይ ሀዋዳን ያጋና፤ “ሀዌ አሳይ ባረ ቦላ ዶናን ታኮ ሺቄ፤ ባረ እንጻርሳን ታና ቦንቼ፤ ሽን ኡንቱንቱ ዎዛናይ ታፐ ሃኩዋን ደኤ። ኡንቱንቱ አሳይ መዳ ዎጋ ታማሪደ፥ ታዉ ጮ ጎይኒኖ።<note caller="-" style="x"><char style="xo" closed="false">29:13 </char><char style="xt" closed="false"><ref loc="MAT 15:8-9">ማቶሳ 15:8-9</ref>፤ <ref loc="MRK 7:6-7">ማር. 7:6-7</ref></char></note> <verse eid="ISA 29:13"/><verse number="14" style="v" sid="ISA 29:14"/>ሄዋ ድራዉ፥ በእተ፥ ታን ሀ አሳ ቦላ ዛረደካ ማላልስያባ ኦና፤ ማላልያባነ ኦራባ ኦና። ኡንቱንቱ ኤራንቻቱዋ አዳ ኤራተይ ዳላማና፤ ኡንቱንቱ አኬካንቻቱዋ አኬካይካ ቆሰታና” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">29:14 </char><char style="xt" closed="false"><ref loc="1CO 1:19">1 ቆሮ. 1:19</ref></char></note><verse eid="ISA 29:14"/></para>
  <para style="s1">ስንፐ ያና ኬካ</para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 29:15"/>ባረ ሀልቹዋ ጪማዪደ፥ መና ጎዳፐ ቆስያዋንቶ፥ ባረንቱ ኦሱዋ ማን ኦደ፥ “ኑና ኦን በኢ? ኑና ኦን ኤሪ?” ያግያዋንቶ አየ አና! <verse eid="ISA 29:15"/><verse number="16" style="v" sid="ISA 29:16"/>ህንተ የዎቱዋ ላሚታ፤ ኡርቃ መያዌ ኡርቃ ማላ ጊደ ቆፒታ! መቴዳዌ መዳዋ፥ “እ ታና መቤና” ጋኔ? ኦቱ ባረና መዳዋ፥ “እ አይነ ኤረና” ጋናዉ ዳንዳዪ?<note caller="-" style="x"><char style="xo" closed="false">29:16 </char><char style="xt" closed="false"><ref loc="ISA 45:9">ኢሳ. 45:9</ref></char></note><verse eid="ISA 29:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 29:17"/>ሊባኖሳ ዎራይ አራዳ ጋድያዉ ላመታናዉ፥ አራዳ ጋዲ ቃይ ዎራ ግዳናዉ፥ ጉ ዎዲ አቴዳ ግደኔየ?<verse eid="ISA 29:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 29:18"/>ሄ ጋላስ ቱለቱ ማጻፋ ቃላ ስሳና፤ ለምእለምኣፐነ ማፐ ከሲደ፥ ቆቀቱዋ አይፊ ጼላና። <verse eid="ISA 29:18"/><verse number="19" style="v" sid="ISA 29:19"/>አሽከቱ ጉጂድካ መና ጎዳን ናሸታና፤ አሳ ግዶን ደእያ ህዬሳቱካ እስራኤልያ ጌሻን ሀሹ ጋና። <verse eid="ISA 29:19"/><verse number="20" style="v" sid="ISA 29:20"/>መቀ ባይናዋንቱ ዉራና። ቅሊጭያዋንቱ ትምእ ጋና። ኢታባ ኦናዉ ዎችያዋንቱ ኡባይ ያና። <verse eid="ISA 29:20"/><verse number="21" style="v" sid="ISA 29:21"/>ሄዋንቱ የዉዋን አሳ ባይዛንቻ ከስያዋንታ፥ ችሎታን አሳ ሴርያዋንቶ ግትያ ዎያዋንታነ ዎርዱዋን ጽሎ ብታንያ ፕርዳ ተእያዋንታ።<verse eid="ISA 29:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 29:22"/>ሄዋ ድራዉ፥ አብራሃማ ዎዜዳ መና ጎዳይ ያቆባ ዛርያዉ ሀዋዳን ያጌ፤ “ያቆባ ዛሪ ሀዋፐ ስንናዉ ዬላተና፤ ኡንቱንቱ ሶምኢካ ዬላቲደ፥ ሳኣ ጼለና። <verse eid="ISA 29:22"/><verse number="23" style="v" sid="ISA 29:23"/>ሽን ኡንቱንቱ ታ ኩሽያ ኦሶ ግድያ ባረንቱ ናናቱዋ ባረንቱ ግዶን በእያ ዎደ፥ ታ ሱን ጌሻተን ናጋና፤ ኡንቱንቱ ያቆባ ጌሻ ጌሻተ ባይዝክኖ። እስራኤልያ ጾሳካ ያሻተን ቦንቻና። <verse eid="ISA 29:23"/><verse number="24" style="v" sid="ISA 29:24"/>አያናን ባሌዳዋንቱ ስሚደ አኬካና፤ ዙዙምያዋንቱካ ትምርትያ አካና” ያጌ።<verse eid="ISA 29:24"/></para>
  <chapter eid="ISA 29"/>
  <chapter number="30" style="c" sid="ISA 30"/>
  <para style="s1">ግብጼና ጫቀትያ ሀዳ ጫቁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 30:1"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ማካላንቻ ናናቶ አየ አና! ታን ሀልቻቤናባ ኦያዋንቶ፥ ታ አያናፐ ግደና ኤጻ ባረዉ ጊግስያዋንቶ፥ ናጋራ ናጋራ ቦላ ጉጅያዋንቶ አየ አና። <verse eid="ISA 30:1"/><verse number="2" style="v" sid="ISA 30:2"/>ግብጼ ካትያ ጌሱዋን አታናዉነ ግብጼ ኩዋን አትያሳ ኮያናዉ፥ ታና ዞረታ በሰናን፥ ዱገ ግብጼ ዎያዋንቶ አየ አና! <verse eid="ISA 30:2"/><verse number="3" style="v" sid="ISA 30:3"/>ሄዋ ድራዉ፥ ግብጼ ካትያ ጌሱ ህንተንቶ ዬላ፥ ካቲካ ካዉሻ ግዳናዋ። <verse eid="ISA 30:3"/><verse number="4" style="v" sid="ISA 30:4"/>ኡንቱንቱ ካፓቱ ጾኣነን ደኦፐካ፥ ኡንቱንቱ ኪቴዳዋንቱ ሀኔሳ ግያ ካታማ ጋክንቶካ፥ <verse eid="ISA 30:4"/><verse number="5" style="v" sid="ISA 30:5"/>ዬላፐነ ካዉሻፐ አትና፥ ሀራባ አያነ ዎና አሳ፥ አያነ ማደና ዎይ ጎኤና አሳን አማነቴዳ አሳይ ኡባይ ካዉሻና” ያጌ።<verse eid="ISA 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 30:6"/>ኔጌባን ደእያ ዶአቱዋባ ጾሳይ ግያዌ ሀዋ፤ ኪተትያዋንቱ መቱነ ቱጋይ ደእያ ቢታ ግዱዋና፥ ጋሙነ ጋማታ ዎያ ሾሻቱነ ፓልያ ዳዌቱ ኮልጽያ ኢታ ቢታና አደ ባና። ባረ ዱረተ ሀረቱዋ ዞክያን፥ ባረንቱ አቁዋ ጋሎቱዋ ዝመን ጫን አኪደ፥ ኡንቱንቶ አያነ ዎሰና ቢታ ባና። <verse eid="ISA 30:6"/><verse number="7" style="v" sid="ISA 30:7"/>አያዉ ጎፐ፥ ግብጼ ማዱ ጋቲ ባይናባነ መላ። ሄዋ ድራዉ፥ ታን አ፥ “ጮኡ ጊደ ኡቴዳ ራኣባ” ያጋደ ሱንድ።<verse eid="ISA 30:7"/></para>
  <para style="s1">አዛዘተና አሳ</para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 30:8"/>ሀእ ባ፤ ስንና ያና ዎድያዉ መና ማላታ ግዳና ማላ፥ ኡንቱንቱ ስንን ሹቻ ማሰን ዎጫ፤ ማዝጎባንካ ጻፋ። <verse eid="ISA 30:8"/><verse number="9" style="v" sid="ISA 30:9"/>አያዉ ጎፐ፥ ሀዋንቱ ማካላንቻ አሳቱዋነ ዎርዱዋ ናናቱዋ፤ ኡንቱንቱ መና ጎዳይ ኦድያዋ ስሳናዉ ኮየና ናናቱዋ። <verse eid="ISA 30:9"/><verse number="10" style="v" sid="ISA 30:10"/>ኡንቱንቱ ሳፃ ኦድያዋንታ፥ “ሳጻ በኦፕተ” ያጊኖ፤ ትምቢትያ ኦድያዋንታካ፥ “ናሸችያባፐነ ማላትያባፐ አትና፥ ኑዉ ሱረባ ኦዶፕተ። <verse eid="ISA 30:10"/><verse number="11" style="v" sid="ISA 30:11"/>ኦግያፐ ክችተ፤ ሎሱዋፐካ እት ባጋ ስምተ፤ ኑን እስራኤልያ ጌሻባ ዛረደ ስሶኮ” ያጊኖ።<verse eid="ISA 30:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 30:12"/>ያትና፥ እስራኤልያ ጌሻይ ሀዋዳን ያጌ፤ “ህንተ ሀ ቃላ እጺደ፥ አሳ ናቂያዋን አማነቴዳ ድራዉነ ጭምያዋን ጬቀቴዳ ድራዉ፥ <verse eid="ISA 30:12"/><verse number="13" style="v" sid="ISA 30:13"/>ሀ ናጋራይ ህንተንቶ ዛኢደ ዎያ፥ አኬከናን ኤለካ ኩንድያ አዱሳ ግምቢያ ማላ ግዳናዋ። <verse eid="ISA 30:13"/><verse number="14" style="v" sid="ISA 30:14"/>አ መኡ ኡርቃፐ መዳነ ንፕ ጊደ መኤዳ ኦቱዋ ማላ ግዳናዋ፤ ሄ መኡዋ ግዶን ታማ ካሽያ ዎይ ኦላፐ ሃ ዱቂደ ከስያ ኮንአይነ ቤተና” ያጌ።<verse eid="ISA 30:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 30:15"/>ኡባ ሞድያ መና ጎዳይ፥ እስራኤልያ ጌሻይ ሀዋዳን ያጌ፤ “ህንተ ታኮ ስምያዋንነ ሸምፕያዋን አታና፤ ጮኡ ግያዌነ አማነትያዌ ህንተንቶ ዎልቃ ግዳናዋ፤ ሽን ህንተ እጼድታ። <verse eid="ISA 30:15"/><verse number="16" style="v" sid="ISA 30:16"/>ሀዋዳን ያጌድታ፤ ‘ቱይት፥ ኑን ፓራቱዋን ኡቲደ ባቃታና’ ያጌድታ፤ ሄዋ ድራዉ፥ ህንተ ባቃታና። ቃይካ ህንተ፥ ‘ኤሌል ፓራቱዋ ቶጊደ ብ ክቻና’ ያጌድታ፤ ሄዋ ድራዉ፥ ህንተና የደርስያዋንቱ ኤሌላና። <verse eid="ISA 30:16"/><verse number="17" style="v" sid="ISA 30:17"/>እት ቶራንቻ በኢደ፥ ህንተፐ ሻአ አሳይ ባቃታና፤ እቼሹ ቶራንቻቱ ህንተና ሙልያ የደርሳና። ደርያ ሁጲያን ኤሴዳ ባንድራ ምዳን፥ ህንተ ቶራንቻቱዋፐ ጉቱ አታና” ያጌ።<verse eid="ISA 30:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 30:18"/>ሽን መና ጎዳይ ህንተንቶ ኬካናዉ ናጌ፤ እ ህንተንቶ ቃረትያዋ በሳናዉ ደንዴ። አያዉ ጎፐ፥ መና ጎዳይ ጽሎ ፕርድያ ጾሳ፤ አ ናግያዋንቱ ኡባቱ አንጀቴዳዋንታ።<verse eid="ISA 30:18"/></para>
  <para style="s1">ጾሳይ ባረ አሳ አንጃና</para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 30:19"/>ህንተኖ፥ የሩሳላመን ደእያ ጽዮነ አሳቶ፥ ሀዋፐ ስንናዉ ዬክክታ፤ ህንተ ዋሱዋን እ ህንተንቶ ቱሙዋፐ ቃረታና፤ እ ህንተ ዋሱዋ ስስያ ዎደ፥ ህንተንቶ ዛሩዋ እማና። <verse eid="ISA 30:19"/><verse number="20" style="v" sid="ISA 30:20"/>ጎዳይ ህንተንቶ መቱዋ ኡክነ ቱጋ ሃ እሞፐካ፥ ህንተ አስታማሪ ሀዋፐ ስንን ባረና ቆሰና። ሽን ህንተ አይፊ ህንተ አስታማርያ በአና። <verse eid="ISA 30:20"/><verse number="21" style="v" sid="ISA 30:21"/>ህንተ ኡሸቻ ዎይ ሀድርሳ ስምያ ዎደ፥ ጉየና ህንተና፥ “ኦጊ ሀዋ፤ አን ቢተ” ያግያ ኮሻ ህንተ ስሳና። <verse eid="ISA 30:21"/><verse number="22" style="v" sid="ISA 30:22"/>ሄዋፐ ጉይያን፥ ብራን አሌቀቴዳ ኤቃቱዋነ ዎርቃን ካመቴዳ ምስለቱዋ ህንተ ቱንሳና። ቅታ ጩርቃዳን ህንተ ኡንቱንታ፥ “ኑፐ ሃክተ” ያጊደ ዎራ ኦላና።<verse eid="ISA 30:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 30:23"/>ሄ ዎደ ህንተ ጋድያን ዘሬዳ ካዉ እ እራ ቡክሳና፤ ጋድያፐ ሞክያ ካይካ ሙሩታነ ዳሮ ግዳናዋ። ሄ ጋላስ ህንተ ሚዛይ አኮ ደምባን ሀመታና። <verse eid="ISA 30:23"/><verse number="24" style="v" sid="ISA 30:24"/>ጋድያ ጎሽያ ቦራቱነ ሀረቱ ላይዳንነ ግላን ፑነቲደ፥ ጌዬዳ ሀርቁዋ ማና። <verse eid="ISA 30:24"/><verse number="25" style="v" sid="ISA 30:25"/>ህንተ ሞርከቱዋ ጌሶቱ ኦሞደትና፥ አሳይ ጎራኤቲደ ዉርያ ጋላስ፥ ዎልቃማ ደረቱዋፐነ ቃ ደረቱዋፐ ፑልቶ ሃቱ ጎጋና። <verse eid="ISA 30:25"/><verse number="26" style="v" sid="ISA 30:26"/>ሄ ጋላስ አግናት ፖኡ አዋ ፖኡዋዳን ሀናና፤ አዋ ፖኡካ ካሰዋፐ ላፑን ኩሽያ ዳራና፤ ላፑን ጋላሳ ፖኡዋ ኬና ፖአና። ሄ ጋላስ መና ጎዳይ መኤዳ ባረ አሳ ኮላና፤ እ ደችና ማዱጼዳ ማዱካ ፓና።<verse eid="ISA 30:26"/></para>
  <para style="s1">ጾሳይ አሶረ ሙራና</para>
  <para style="p">
    <verse number="27" style="v" sid="ISA 30:27"/>በእተ፥ መና ጎዳ ሱንይ ሱልያ ሀንቁዋና፥ ስኬዳ ጩዋ ሻርያና ሃኮ ሳፐ ያና፤ አ ዶናይ ሀንቁ ኩሜዳዋ፤ አ እንጻርሳይካ ምያ ታማ። <verse eid="ISA 30:27"/><verse number="28" style="v" sid="ISA 30:28"/>ባረ ፔኑዋን ኡባባ ፕት አፍያ ድኡዋዳን፥ ይስያ ሃ ኩንዋ ማላ። እ ካዉተቱዋ ባሻ ዛዝርያን ዛዝራና፤ አሳ ጋፓታካ ዎራ አፍያ ብጻላ ባርሳና። <verse eid="ISA 30:28"/><verse number="29" style="v" sid="ISA 30:29"/>ጌሻ ባላይ ቦንቼትያ ቃማ የጽያዋዳን፥ ህንተ የጻና፤ መና ጎዳ ደርያ እስራኤልያ ዛላኮ ብያ ዎደ፥ ሱሱልያ ፑኒደ የጽያ አሳይ ናሸትያዋዳን፥ ህንተ ናሸታና።<verse eid="ISA 30:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ISA 30:30"/>ቃይ መና ጎዳይ ባረ ያሽያ ኮሻ ስሳና፤ አ ቀሲ ዎደ ሾጭያ ሾቻ ባረ ሱልያ ሀንቁዋን፥ ምያ ታማ ላጩዋን፥ ጎትያን፥ ኡሹዋንነ ሻቻ ቡርጭያን ቆንጭሳና። <verse eid="ISA 30:30"/><verse number="31" style="v" sid="ISA 30:31"/>መና ጎዳይ ባረ ኮሻን አሶረ ዳጋንና። አ ጻምአይካ ኡንቱንታ ሾጫና። <verse eid="ISA 30:31"/><verse number="32" style="v" sid="ISA 30:32"/>መና ጎዳይ ኡንቱንታ ባረ ሙርያ ጻምአን ሾጫና ሾቻይ ኡባይ ዳርቢያንነ ዲን ግዳናዋ። ኦላን እ ባረ ቄስያ ደንደ፥ ኡንቱንታ ኦላና። <verse eid="ISA 30:32"/><verse number="33" style="v" sid="ISA 30:33"/>አያዉ ጎፐ፥ ታማ ኤያሳኣ ቶፌት በን ጊጌዳ፤ ሄ ሳአይ ጊጌዳዌ ካትያሳ። ሄ ሳአይ ዝቃነ አኮ ግዲደ፥ ታማይነ ዳሮ ምይ ዶረት ኡቴዳ ሳ። መና ጎዳ ሸምፑ ዲንያ ሻፋዳን ዪደ፥ ሄ ታማ ኤ ከሳና።<verse eid="ISA 30:33"/></para>
  <chapter eid="ISA 30"/>
  <chapter number="31" style="c" sid="ISA 31"/>
  <para style="s1">ጾሳይ የሩሳላመ ናጋና</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 31:1"/>ማዱዋ ኮያናዉ ዱገ ግብጼ ዎያዋንቶነ ፓራን አማነትያዋንቶ አየ አና! ጮራ ግድያ ድራዉ ፓራ ጋረቱዋን፥ ዳሮፐ ምኖ ግድያ ድራዉ ፓራ አሳቱዋን አማነትያዋንቶ አየ አና! ኡንቱንቱ እስራኤልያ ጌሻኮ ጼልክኖ፤ ዎይ መና ጎዳፐ ማዱዋ ኮይክኖ። <verse eid="ISA 31:1"/><verse number="2" style="v" sid="ISA 31:2"/>ሽን እካ ባሻ አሀናዉ ዳንዳይያ አዳ ኤራንቻ፤ ባረ ጌዳዋካ አገና፤ ኢታቱዋ ጎልያ አሳ ቦላነ ኢታባ ኦያዋንታ ማድያዋንቱ ቦላ ደንዳና። <verse eid="ISA 31:2"/><verse number="3" style="v" sid="ISA 31:3"/>ግብጼ ጋድያ አሳቱ አሳፐ አትና፥ ጾሳ ግድክኖ። ኡንቱንቱ ፓራቱካ አሾፐ አትና፥ አያና ግድክኖ። መና ጎዳይ ሀንቁዋን ባረ ኩሽያ ምጭያ ዎደ፥ ማድያዌ በታና፤ ማደትያዌካ ኩንዳና፤ ኡንቱንቱ ኡባይካ እትፐ ያና።<verse eid="ISA 31:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 31:4"/>ጾሳይ ታና ሀዋዳን ያጌ፤ “ጋሙ ዎይ ዎዳላ ጋሙ መህያ ኦይቂደ ጉድያ ዎደ፥ ዳሮ ሄንንቻቱ አ ቦላ ጼሰት ሺቆፐካ፥ እ ኡንቱንቱ ዋሶ ዳጋመና። ኡንቱንቱ ዋሶካ ያየና። ሄዋዳንካ፥ ኡባፐ ዎልቃማ መና ጎዳይ ጽዮነ ደርያንነ አ ቃን ኦላ ጋከታናዉ ዱገ ዎና። <verse eid="ISA 31:4"/><verse number="5" style="v" sid="ISA 31:5"/>ካፉ ቦላና አዋልያዋዳን፥ ኡባፐ ዎልቃማ መና ጎዳይ የሩሳላመ ጎንዳላናነ አሽ አካና፤ እ አ ቦላና አደ፥ አ ዎ አካና” ያጌ።<verse eid="ISA 31:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 31:6"/>ህንተኖ እስራኤልያ አሳቶ፥ ህንተ ሎይ ማካሌዳዋኮ ስምተ። <verse eid="ISA 31:6"/><verse number="7" style="v" sid="ISA 31:7"/>አያዉ ጎፐ፥ አሳ ኡባይ ባረንቱ ናጋራንቻ ኩሽያን ብራፐነ ዎርቃፐ መዳ ኤቃቱዋ ሄ ጋላስ ኦላና።<verse eid="ISA 31:7"/></para>
  <para style="p">
    <verse number="8-9" style="v" sid="ISA 31:8-9"/>ታማይ ጽዮነን፥ ጮጪ የሩሳላመን ደእያ ጾሳይ ሀዋዳን ያጌ፤ “አሶረ አሳዋ ግደና ማሻን ኩንዳና፤ አሳዋ ግደና ማሻይ ኡንቱንታ ማና። ኡንቱንቱ ማሻ ስንፐ ባቃታና፤ ኡንቱንቱ ዎዳላ አሳቱ ዴጾ ኦሶ አዛዘታና። ዳጋማ ጋሱዋን፥ ኡንቱንቱ ምኖ ጌሱ ላለታና፤ ኡንቱንቱ ኦላ ጋዳዋቱካ ዳጋማዉ ኦላ ባንድራ አግ ባሺደ ባና” ያጌ መና ጎዳይ።<verse eid="ISA 31:8-9"/></para>
  <chapter eid="ISA 31"/>
  <chapter number="32" style="c" sid="ISA 32"/>
  <para style="ms">ጾሳይ ኤዶማ ሙርያዋ የሩሳሌሞ አንጅያዋ ግዱሳ</para>
  <para style="mr">(<ref loc="ISA 32:1-35:10">ኢሳ. 32:1—35:10</ref>)</para>
  <para style="s1">ጽሎተን አይስያ ካትያ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 32:1"/>በእተ፥ ካቲ ጽሎተን ካተታና፤ ሞድያዋንቱካ ሱረተን ሞዳና። <verse eid="ISA 32:1"/><verse number="2" style="v" sid="ISA 32:2"/>አሳይ ሁጲያን ሁጲያን ጫርኩዋፐ ጌምያ ሳ፥ ጎትያፐ ባቃትያ ሳ ግዳናዋ፤ መላ ሳኣን ጎግያ ሃነ ዞዘትያ ጋድያን ደእያ ዎልቃማ ዛላ ኩዋ ማላ ግዳናዋ። <verse eid="ISA 32:2"/><verse number="3" style="v" sid="ISA 32:3"/>ጼልያ አሳቱ አይፊ ጪልመና፤ ስስያዋንቱ ሀይይካ ሀይዛና። <verse eid="ISA 32:3"/><verse number="4" style="v" sid="ISA 32:4"/>ታፍታፍያ አሳቱዋ ዎዛናይ ኤራናነ አኬካና። ዴዶትያ አሳቱዋ እንጻርሳይካ ሱረ ጌሺደ ሃሳያና። <verse eid="ISA 32:4"/><verse number="5" style="v" sid="ISA 32:5"/>ሀዋፐ ስንናዉ ኤይ ቦንቾ አሳ ጌተተና። ኢታ አሳይ ቦንቼተና። <verse eid="ISA 32:5"/><verse number="6" style="v" sid="ISA 32:6"/>አያዉ ጎፐ፥ ቦዛይ ቦዛተ ሃሳየ፤ አ ዎዛናይካ ናጋራ ኦናዉ፥ መና ጎዳ ቦላ ጻላባ ሃሳያናዉ፥ ኮሻቴዳዋንታ ካልሰናን አጋናዉነ ሳመቴዳዋንታ ኡሸናን ድጋናዉ፥ ኢታባ ማቀቴ። <verse eid="ISA 32:6"/><verse number="7" style="v" sid="ISA 32:7"/>ኡዘትያዋ ኡዚ ኢታ፤ መቶታንቻይ ሱረባ ሃሳዪደ፥ ዎርዱዋን ህዬሳ ይሳናዉ እ ኢታ ቆፋ ቆፔ። <verse eid="ISA 32:7"/><verse number="8" style="v" sid="ISA 32:8"/>ሎኦ ኡራይ ሎኦባ ሀልቼ፤ ሄ ሎኦ ሀልቹዋን ምኒደ ደኤ።<verse eid="ISA 32:8"/></para>
  <para style="s1">ፕርዳነ በትያፐ ስምያዋ</para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 32:9"/>ህንተኖ ቆፋይ ባይናን ደእያ ማጫዋንቶ፥ ደንድተ፤ ታ ኦድያዋ ስስተ፤ ህንተኖ አማነቲደ ኡቴዳ ማጫ ናቶ፥ ታን ህንተንቶ ኦድያዋ ስስተ። <verse eid="ISA 32:9"/><verse number="10" style="v" sid="ISA 32:10"/>እት ላይፐ ጉ አሽን፥ ህንተ አማነቲደ ኡቴዳዋንቱ ኮኮራና፤ ዎይንያ አ ዎድያን ጹንቂያዌ አታና። ቶኬዳዋፐ ህንተ አይፍያ ሺሻና ዎዲካ ዬና። <verse eid="ISA 32:10"/><verse number="11" style="v" sid="ISA 32:11"/>ህንተኖ እሻሉዋን ደእያ ማጫዋንቶ፥ ኮኮርተ። ህንተኖ አማነቲደ ኡቴዳ ማጫ ናቶ፥ ጋጅ ጋጅተ። ህንተ ማዩዋ ቃርተ፤ ካዩዋ አፍላ ህንተ ጼሳን ዳንጭተ። <verse eid="ISA 32:11"/><verse number="12" style="v" sid="ISA 32:12"/>ሎእያ ሾይቃይነ አይፍያ ዶርጾጼዳ ዎይኒ ዬዳ ድራዉ፥ ካዮቲደ፥ ህንተ ትራ ባቂተ። <verse eid="ISA 32:12"/><verse number="13" style="v" sid="ISA 32:13"/>አጉን ቡራይነ ክንድቹ ታ አሳ ጋደን ሞኬዳ። አሳይ ናሸቲደ ደኤዳ ጎለቱዋስነ ናሸቻን ደኤዳ ሀ ካታማዉ ዬክተ። <verse eid="ISA 32:13"/><verse number="14" style="v" sid="ISA 32:14"/>ሚጻይ አታና፤ ዳሮ አሳይ ደእያ ካታማቱካ ኦናና፤ ጌሱነ ዎችያ ግምበቱ መናዉ መላ ግዳናዋ፤ ኡንቱንቱ ዎራ ሀረቱ ናሸትያሳነ ዶርሳ ዉዲ ሀመትያሳ ግዳናዋ። <verse eid="ISA 32:14"/><verse number="15" style="v" sid="ISA 32:15"/>ሄዌነ፥ ቦላ ቃፐ ኑ ቦላ አያናይ ጉካና ጋካናሳ፥ መላ ባዙ አራዳና ጋካናሳነ አራዳ ቢታይካ ዎራ ግዴዳ ጌተቲደ ቆፈታና ጋካናሳ።<verse eid="ISA 32:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 32:16"/>ሄዋፐ ጉይያን፥ ሱረ ፕርዳይ መላ ባዙዋን፥ ጽሎተይካ አራዳ ጋድያን ደአና። <verse eid="ISA 32:16"/><verse number="17" style="v" sid="ISA 32:17"/>ጽሎተ ኦሱ ሳሮተ ግዳናዋ፤ ጽሎተ አይፊካ መናዉ ዎፓተነ አማነቲደ ደእያዋ ግዳናዋ። <verse eid="ISA 32:17"/><verse number="18" style="v" sid="ISA 32:18"/>ታ አሳይ ሳሮተይ ደእያ ሳኣን፥ ናገትያ ጎልያንነ ዎፑ ጌዳ ሸምፖ ሳአቱዋን ደአና። <verse eid="ISA 32:18"/><verse number="19" style="v" sid="ISA 32:19"/>ሻቻን ዎራይ ዲፖፐነ፥ ቃይ ካታማይ ኡባና ኮለቶፐነ፥ <verse eid="ISA 32:19"/><verse number="20" style="v" sid="ISA 32:20"/>ሄ ሃ ኡባ ማታን ህንተ ካ ዘሪደ፥ ህንተ መህያካ ህንተ ሀረቱዋካ ሄንዉ ብል የዲደ፥ ህንተ ሎይ አንጀታና።<verse eid="ISA 32:20"/></para>
  <chapter eid="ISA 32"/>
  <chapter number="33" style="c" sid="ISA 33"/>
  <para style="s1">ማዱዋ ዎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 33:1"/>ኔኖ፥ ኔና ይሰናን ደእሽን ይስያዎ፥ ነዉ አየ አና! ኔኖ፥ ኔና አ እመናን ደእሽን፥ አ እምያዎ፥ ነዉ አየ አና! ኔን ይሱዋ አጌዳ ዎደ ኔና ይሳና፤ ኔን አ እሙዋ አጌዳ ዎደ ኔና አ እማና።<verse eid="ISA 33:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 33:2"/>አቤት መና ጎዳዉ፥ ኑና ማራ፤ ኑን ኔና ናጌቶ፤ ዎንታ ዎንታ ኑዉ ዎልቃ ግዳ፤ መቱዋ ዎደካ ኑና አሽያዋ ግዳ። <verse eid="ISA 33:2"/><verse number="3" style="v" sid="ISA 33:3"/>ነ ኮሻይ ጉጉንዳን ጉምያ ዎደ አሳይ ባቃቴ፤ ኔን ኑና ማዳናዉ ደንዳ ኤቂያ ዎደ፥ ካዉተቱ ላለቲኖ። <verse eid="ISA 33:3"/><verse number="4" style="v" sid="ISA 33:4"/>ጎንዱ ሺቅያዋዳን፥ ህንተ ኦሞዱ ሺቃና፤ ቦሊ ድርቢያዋዳን፥ አሳይ አ ቦላ ድርባና።<verse eid="ISA 33:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 33:5"/>መና ጎዳይ ቦላን ደእያ ድራዉ፥ ቁ ቁ ጌዳ፤ እ ጽዮነ ሱረ ፕርዳንነ ጽሎተን ኩንና። <verse eid="ISA 33:5"/><verse number="6" style="v" sid="ISA 33:6"/>እ ህንተንቶ ህንተ ዎድያ ምንያዋ፥ ህንተ ኩመን አቶተ፥ አዳ ኤራተነ ኤራ ግዳናዋ፤ መና ጎዳዉ ያይያዌ አዉ አቆ ግዳናዋ።<verse eid="ISA 33:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 33:7"/>በእተ፥ ኡንቱንቱ ዎልቃማ አሳቱ ኦግያን ዋሲኖ፤ ስጋተዉ ኪቴዳዋንቱካ ምሸቲደ ዬኪኖ። <verse eid="ISA 33:7"/><verse number="8" style="v" sid="ISA 33:8"/>አኮ ኦገቱ ኦኔድኖ፤ ኦግያና አያዌ አጌዳ። እ ባረ ጫቀቴዳ ጫቁዋ ኮሌዳ፤ ካታማቱዋካ ካዳ። አሳካ ደምቤና። <verse eid="ISA 33:8"/><verse number="9" style="v" sid="ISA 33:9"/>ቢታይ ካዮቴነ ላባኔ። ሊባኖስ ዬላቲደ መሌ፤ ሳሮና ግያ አራዳ ድልባይ መላ ቢታ ግዴዳ። ባሳነ ግያ ደርያንነ ቃርመሎሳ ደርያን ደእያ ምቱዋ ሀይይ ቆቆፈቴ።<verse eid="ISA 33:9"/></para>
  <para style="s1">ጾሳይ ባረና እጽያዋንታ ኡባ፥ “አዬ!” ጌዳዋ</para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 33:10"/>መና ጎዳይ ካዉተቶ ሀዋዳን ያጌ፤ “ሀእ ታን ደንዳና፤ ሀእ ታን ቦንቼታና፤ ሀእ ታን ቁ ቁ ጋና። <verse eid="ISA 33:10"/><verse number="11" style="v" sid="ISA 33:11"/>ህንተ ኡቱላ ሻሃሪደ፥ ሱላ የሌድታ። ህንተ ሸምፕያ ሸምፑ ህንተና ምያ ታማ። <verse eid="ISA 33:11"/><verse number="12" style="v" sid="ISA 33:12"/>አሳይ ታማን ጹገቴዳ ብድን ማላ ግዳናዋ፤ ቃይ ቃንጸቲደ፥ ታማን ኤጼዳ አጉን ማላ ግዳናዋ። <verse eid="ISA 33:12"/><verse number="13" style="v" sid="ISA 33:13"/>ህንተኖ፥ ሃኩዋን ደእያዋንቶ፥ ታን ኦዳዋ ስስተ፤ ማታን ደእያዋንቶ፥ ታን ዎልቃማ ግድያዋ አኬክተ” ያጌ።<verse eid="ISA 33:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 33:14"/>ጽዮነን ደእያ ናጋራንቻቱ ያዬድኖ፤ ጾሳዉ ግደናዋንታ ኮኮርሳይ ኦይቄዳ። ሄዋ ድራዉ፥ ኡንቱንቱ፥ “ምያ ታማና ደአናዉ ዳንዳይያ ኡራይ ኑ ግዶን ኦኔ? ኤጺደ ደእ አግያዋና ደአናዉ ዳንዳይያ ኡራይ ኑ ግዶን ኦኔ?” ያጊኖ። <verse eid="ISA 33:14"/><verse number="15" style="v" sid="ISA 33:15"/>ጽሎተን ሀመትያዌ፥ ሱረባ ሃሳይያዌ፥ ሱረ ግደና ኦግያና ቤትያ ጎኣ እጽያዌ፥ ማታይያ አካናዉ ባረ ኩሽያ የደናዌ፥ ሱ ጉስያዋ ስሰናዳን፥ ባረ ሀይ ቱጭያዌ፥ ኢታባ ጼለናዳን፥ ባረ አይፍያ ጪልምያዌ፥ <verse eid="ISA 33:15"/><verse number="16" style="v" sid="ISA 33:16"/>ሄ ኡራይ ቃሳን ደአና። እ ባቃቲደ አታና ሳአይካ ምኖ ዛላ ደኡዋ ግዳናዋ፤ አ ኡክይካ አዉ እመታና፤ እ ኡሽያ ሃይካ ፓጨና።<verse eid="ISA 33:16"/></para>
  <para style="s1">ቦንቹ ኩሜዳ ያና ላይ</para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 33:17"/>ህንተ አይፈቱ ካትያ አ ፑላና በአና፤ ሃኪደ ደእያ ቢታካ በአና። <verse eid="ISA 33:17"/><verse number="18" style="v" sid="ISA 33:18"/>ህንተ ዎዛናይ፥ “ፓይዴዳዌ ሀቃን ደኢ? ጊራ ይግ ጼሌዳዌ ሀቃን ደኢ? አዱሳ ግምበቱዋ ፓይዴዳዌ ሀቃን ደኢ?” ያጊደ ያሽያ በንዋ ቆፓና። <verse eid="ISA 33:18"/><verse number="19" style="v" sid="ISA 33:19"/>ህንተ ቃረት ባይና አሳቱዋ፥ ህንተንቶ ገለና ሃሳያ ሃሳይያ አሳቱዋነ እንጻርሳይ ዴዶትያ አሳቱዋ ሀዋፐ ስንን በእክታ።<verse eid="ISA 33:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 33:20"/>ኑን ኑ ባላ ቦንችያ ጽዮነ ካታማ በእተ! ዎፑ ጊደ ደኢያሳ፥ አ ሽካሊ ሾደተና፥ አ ዎዶሩካ ዱጸናነ ቃጸና ዱንካንያ ማላ፥ የሩሳላመ ካታማ ህንተ ህንተ አይፍያን በአና። <verse eid="ISA 33:20"/><verse number="21" style="v" sid="ISA 33:21"/>ሽን መና ጎዳይ ኑዉ ሄ ሳኣን ባረ ዎልቃማ ዎልቃ ቆንጭሳና። ሄ ሳአይ አኮ ሻፋቱነ ጎግያ ሃቱዋ ማላ ግዳናዋ። ላግያ ዎሉዎሉ አ ቦላና ባናዉ ዳንዳየና፤ ዎልቃማ ማርካቢካ ያና አናዉ ዳንዳየና። <verse eid="ISA 33:21"/><verse number="22" style="v" sid="ISA 33:22"/>አያዉ ጎፐ፥ መና ጎዳይ ኑ ዳና፤ መና ጎዳይ ኑዉ ህግያ እሜዳዋ። መና ጎዳይ ኑ ካትያ፤ እ ኑና አሻና።<verse eid="ISA 33:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 33:23"/>ነ ዎዶሩዋ ቃሹ ሾልኤዳ፤ ማርካብያ ቱሳ አ ሳኣን ምንስ ኦይቃናዉ ዎይ ሻራካ ጻጋጋናዉ ዳንዳየና። ሄ ዎደ ዳሮ ኦሞዲደ አሄዳባይ ሻከታና፤ ሀራይ አትና፥ ዎባቱካ ኦሞዱዋ ኦሞዳና። <verse eid="ISA 33:23"/><verse number="24" style="v" sid="ISA 33:24"/>ጽዮነን ደእያ ኦንነ፥ “ታን ሀርጋይ” ያገና፤ ያን ደእያ አሳ ናጋራይ አቶ ጌተታና።<verse eid="ISA 33:24"/></para>
  <chapter eid="ISA 33"/>
  <chapter number="34" style="c" sid="ISA 34"/>
  <para style="s1">ጾሳይ ባረ ሞርከቱዋ ሙራና</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 34:1"/>ህንተኖ፥ ካዉተቶ፥ ሺቂደ ስስተ! ህንተኖ አሳቶ ስስተ! ቢታይነ ጋድያን ደእያባይ ኡባይ፥ ሳአይነ ሳኣን ደእያባይ ኡባይ ስሶ! <verse eid="ISA 34:1"/><verse number="2" style="v" sid="ISA 34:2"/>አያዉ ጎፐ፥ መና ጎዳይ ካዉተ ኡባ ሀንቀቴዳ፤ አ ይሉካ ኡንቱንቱ ቶራንቻቱዋ ኡባ ቦላና። እ ኡንቱንቱ ኡባና ይሳና፤ ኡንቱንታ ሲፍያዋንቶ አደ እማና። <verse eid="ISA 34:2"/><verse number="3" style="v" sid="ISA 34:3"/>ኡንቱንቱፐ ዎዳዋንቱ ኦለታና፤ ኡንቱንቱ አሃይ ጽንቃና። ዎጋ ደረቱ ኡንቱንቱ ሱን ካመታና። <verse eid="ISA 34:3"/><verse number="4" style="v" sid="ISA 34:4"/>ሳሉዋ ጾልንተቱ ኡባይ ሲላና፤ ሳሎቱ ዋራቃታዳን ጻጸታና። ኡንቱንቱ ጾልንተቱ ኡባይ ዎይንያፐ ሀይይ ቆቆፈትያዋዳን፥ ባላስያፐ አይፊ ቆቆፈትያዋዳን ቆቆፈታና።<note caller="-" style="x"><char style="xo" closed="false">34:4 </char><char style="xt" closed="false"><ref loc="MAT 24:29">ማቶሳ 24:29</ref>፤ <ref loc="MRK 13:25">ማር. 13:25</ref>፤ <ref loc="LUK 21:26">ሉቃሳ 21:26</ref>፤ <ref loc="REV 6:13-14">ሳፃ 6:13-14</ref></char></note> <figure style="fig" alt="Scrole" file="HK00150B.TIF" size="col" ref="34:4">ጻጸ ማፋ</figure><verse eid="ISA 34:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 34:5"/>ታ ማሻይ ሳሎቱዋ ግዶን አላና ጋካናዉ ኡሼዳ። በእተ፥ እ ኤዶማ ቦላ፥ ታን ሸቄዳ አሳ ቦላ ፕርዳናዉ ዎ።<note caller="-" style="x"><char style="xo" closed="false">34:5-17 </char><char style="xt" closed="false"><ref loc="ISA 63:1-6">ኢሳ. 63:1-6</ref>፤ <ref loc="JER 49:7-22">ኤር. 49:7-22</ref>፤ <ref loc="EZK 25:12-14">ህዝ. 25:12-14</ref>፤ <ref loc="EZK 35:1-15">35:1-15</ref>፤ <ref loc="AMO 1:11-12">አሞጻ 1:11-12</ref>፤ <ref loc="OBA 1:1-14">አብድ. 1-14</ref>፤ <ref loc="MAL 1:2-5">ሚልክ. 1:2-5</ref></char></note> <verse eid="ISA 34:5"/><verse number="6" style="v" sid="ISA 34:6"/>መና ጎዳዉ ቦጽራ ግያ ካታማን ያርሹ፥ ኤዶማ ጋድያን ዎልቃማ ሹካይ ደእያ ድራዉ፥ መና ጎዳ ማሻይ ሱን ሜጨቲደ፥ ሞዋን ጻጸቴዳ። ዶርሳቱዋነ ዴሻቱዋ ሱን ሜጨቲደ፥ ዶርሳቱዋ ክላሆቱዋ ሞዋን ጻጸቴዳ። <verse eid="ISA 34:6"/><verse number="7" style="v" sid="ISA 34:7"/>ቃይ መንቱ፥ ማራቱነ ኮሩማ ቦራቱ ኡንቱንቱና ኩንዳና። ኡንቱንቱ ቢታይ ሱ ጻላላ ግዳና፤ ኡንቱንቱ ቢታይካ ሞዋን ሙናቀታና። <verse eid="ISA 34:7"/><verse number="8" style="v" sid="ISA 34:8"/>አያዉ ጎፐ፥ መና ጎዳይ ሀሉዋ ከስያ ጋላሳ፤ ጽዮነ ኦሌዳ ሞርከቶ ኩሽያ ዛርያ ላይ።<verse eid="ISA 34:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 34:9"/>ጎግያ ኤዶማ ሃቱ ሽድያዉ፥ አ ቢታይካ ዲንያዉ ላመታናዋ፤ አ ቢታይ ኤጽያ ሽድያ ግዳናዋ። <verse eid="ISA 34:9"/><verse number="10" style="v" sid="ISA 34:10"/>ታማይካ ቃማን ጋላሳን ቶኤና፤ አ ጩዋይካ መናዉ ጩዋታና። ኤዶማ ቢታይ የለታፐ የለታ ጋካናዉ፥ መላ ግዳናዋ፤ ኦንነ መናዉ ሄዋና አና።<note caller="-" style="x"><char style="xo" closed="false">34:10 </char><char style="xt" closed="false"><ref loc="REV 14:11">ሳፃ 14:11</ref>፤ <ref loc="REV 19:3">19:3</ref></char></note> <verse eid="ISA 34:10"/><verse number="11" style="v" sid="ISA 34:11"/>ሽን ጽንግሊነ ቁጻርሳይ አ ላታና፤ ጉቶቱነ ቁሩ አን ደአና። ጾሳይ ኤዶማ ቦላ ኮለ ልክያ ዎዶሩዋነ መላተ ልክያ ቱምቢያ ፕድ ኦደ የዳና። <verse eid="ISA 34:11"/><verse number="12" style="v" sid="ISA 34:12"/>ሄ ጋድያን ካተትያዌ ያና፤ ካፓቱካ ሄዋፐ ክቻና። <verse eid="ISA 34:12"/><verse number="13" style="v" sid="ISA 34:13"/>አ ጎለቱዋን አጉንይ፥ አ ሚጻቱዋን ኦካይ ኦዶሩ ሞካና። እ ዎራካናቱ አላጽያሳነ ሶጎኒ ደኢያሳ ግዳናዋ። <verse eid="ISA 34:13"/><verse number="14" style="v" sid="ISA 34:14"/>ዎራ ዶአቱ ጎዳረቱዋና ጋከታና፤ ቱና አያናቱ እቱ እቱዋና ጼሰታና፤ ቃማ ጻላሄቱ ዎደ፥ ያን ደአና። <verse eid="ISA 34:14"/><verse number="15" style="v" sid="ISA 34:15"/>ጉታታ ያን ጎልያ ኬጻና፤ ቁቁሌዳ ቁቁለቱዋ ሀጳደ ቆጻና። ባረ ማራቱዋካ ባረ ቀፈቱዋ ጋርሳን ሀጳና፤ ቃይ ጋጨቱ ባረንቱ ላግያና ላግያና ሄ ሳኣ ሺቃና።<verse eid="ISA 34:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 34:16"/>መና ጎዳ ማጻፋፐ ኮዪደ ናባብተ። ጾሳ ዶናይ አዛዜዳ ድራዉነ አ አያናይ ሺሼዳ ድራዉ፥ ሀዋንቱፐ እቱነ ፓጨና፤ ቃይ እቱነ ባረ ላጊ ባይናን ደኤና። <verse eid="ISA 34:16"/><verse number="17" style="v" sid="ISA 34:17"/>እ ኡንቱንቶ ሳማ ከሴዳ፤ አ ኩሺ ኡንቱንቶ ጋድያ ዎርዱዋን ሻኬዳ፤ ኡንቱንቱ አ መናዉ ሞዳና፤ የለታፐ የለታ ጋካናዉ፥ ኡንቱንቱ አን ደአና።<verse eid="ISA 34:17"/></para>
  <chapter eid="ISA 34"/>
  <chapter number="35" style="c" sid="ISA 35"/>
  <para style="s1">ጽሎተ ኦግያ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 35:1"/>ቢታ ባዙነ መላ ቢታይ ናሸታና፤ መላ ቢታይ ናሸቻ ፖጩ ጊደ፥ ጪሻ ጪሻና። <verse eid="ISA 35:1"/><verse number="2" style="v" sid="ISA 35:2"/>እ ዳሮፐ ጪሻና፤ ፖጩ ጊደ ናሸቻን የጻና። ሊባኖሳ ቦንቹነ ቃርመሎሳነ ሳሮና ግታተይ እመታና፤ ኡንቱንቱ መና ጎዳ ቦንቹዋነ ኑ ጾሳ ግታተ በአና።<verse eid="ISA 35:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 35:3"/>ዳቡሬዳ ኩሸቱዋነ አርጋጬዳ ጉልባታ ምንተ።<note caller="-" style="x"><char style="xo" closed="false">35:3 </char><char style="xt" closed="false"><ref loc="HEB 12:12">እብራ. 12:12</ref></char></note> <verse eid="ISA 35:3"/><verse number="4" style="v" sid="ISA 35:4"/>ዎዛናን ያሻይ ደእያዋንታ፥ “ምንተ! ያዮፕተ! ሄኮ፥ ህንተ ጾሳይ ሀሉዋ ከሳናዉነ ባረ ጾሳተን ኡንቱንታ ሙራናዉ ያና፤ እ ህንተና አሻና” ያግተ።<verse eid="ISA 35:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 35:5"/>ሄ ዎደ፥ ቆቀቱዋ አይፊ ዶየታና፤<note caller="-" style="x"><char style="xo" closed="false">35:5-6 </char><char style="xt" closed="false"><ref loc="MAT 11:5">ማቶሳ 11:5</ref>፤ <ref loc="LUK 7:22">ሉቃሳ 7:22</ref></char></note> ቱለቱዋ ሀይይካ ስሳና። <verse eid="ISA 35:5"/><verse number="6" style="v" sid="ISA 35:6"/>ዎባቱዋ ገንእያዳን ጉፓና፤ ዱደቱካ ናሸቻን የጻና፤ ባዙዋን ሃይ መሎሳን ፑልቱ ቃና። <verse eid="ISA 35:6"/><verse number="7" style="v" sid="ISA 35:7"/>ጹግያ ሻፊ ዳጋቴዳ ሃ ግዳናዋ፤ መላ ቢታይ ሃ ፑልታና፤ ዎራካናቱ አላጽያሳን ማታይ ማቃይነ ጫሪ ዶላና።<verse eid="ISA 35:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 35:8"/>ያን አኮ ኦጊ ደአና፤ እካ ጌሻተ ኦግያ ጌተታና። ጌሻ ግደናዋንቱ ሄ ኦግያና አክኖ። ሽን እ ጌሻቱዋሳ ግዳናዋ፤ ኢታ ኤያቱ አን ስመረትክኖ። <verse eid="ISA 35:8"/><verse number="9" style="v" sid="ISA 35:9"/>ያን ጋሙ ደኤና፤ ያሽያ ዶአቱካ ሄዋና አክኖ፤ ያንካ ቤትክኖ፤ ሽን ዎዘቴዳዋንቱ ጻላላይ ሀመታና። <verse eid="ISA 35:9"/><verse number="10" style="v" sid="ISA 35:10"/>መና ጎዳይ ዎዜዳዋንቱ ስማና፤ የጺድ፥ ጽዮነ ያና፤ መና ናሸቻይ ኡንቱንቱ ሁጲያን ዎና። ኡንቱንቱ ናሸቻነ ሀሹ ግያዋ ደማና፤ ካዩነ ኦሊ ዎራ ባቃታና።<verse eid="ISA 35:10"/></para>
  <chapter eid="ISA 35"/>
  <chapter number="36" style="c" sid="ISA 36"/>
  <para style="ms">አሶራ፥ ባብሎና፥ ካትያ ህዝቅያሳነ ኢስያሳ</para>
  <para style="mr">(<ref loc="ISA 36:1-39:8">36:1—39:8</ref>)</para>
  <para style="s1">አሶረቱ የሩሳላሞ ናሴድኖ</para>
  <para style="r">(<ref loc="2KI 18:13-27">2 ካታ. 18:13-27</ref>፤ <ref loc="2CH 32:1-19">2 ኦዱዋ 32:1-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 36:1"/>ካትያ ህዝቂያስ ካተቴዳ ታማነ ኦይደን ላይን፥ አሶረ ካቲ ሳናክሬብ ግምበት ኡቴዳ ይሁዳ ካታማቱዋ ኡባ ኦሊደ ኦይቄዳ። <verse eid="ISA 36:1"/><verse number="2" style="v" sid="ISA 36:2"/>ሄዋፐ ጉይያን፥ አሶረ ጋድያ ካቲ ላክሻ ግያ ካታማፐ እት ዋናትያ ኦላ ጋዳዋ ጮራ ኦላንቻቱዋና ካትያ ህዝቂያሳኮ የሩሳላመ የዴዳ። ቢደ፥ ማዩዋ ሜጭያዋ ጋደ አፍያ ኦግያፐ ቆሞ ባጋና ደእያ ዳጋቴዳ ሃይ ጎግያ ሃ ማታን ኤቄዳ። <verse eid="ISA 36:2"/><verse number="3" style="v" sid="ISA 36:3"/>ያትና፥ ህልቂያ ናአይ ካትያ ጎልያን አዎትያ ኤልያቂመ፥ ዋና ጻፊ ሼብንነ አሳፋ ናአይ ታርክያ ጻፍያ ዮኣህ አኮ ካረ ከሴድኖ።<verse eid="ISA 36:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 36:4"/>አሶረቱዋ ጋዳዋይ ኡንቱንታ፥ “ህዝቂያሳዉ ሀዋዳን ያጊደ ኦድተ፤ አሶረ ካቲ፥ ዎልቃማይ ኔና ሀዋዳን ያጌ፤ ‘ኔን ሀዋ ኬሻ አያን አማነታዲ? <verse eid="ISA 36:4"/><verse number="5" style="v" sid="ISA 36:5"/>ኔን ጮ መላ፥ ኦላ ኦለታናዉ ታዉ አዳ ኤራይነ ዎልቃይ ደኤ ያጋሳ። ሽን ኔን ኦናን አማነታደ ታ ቦላ ሀዋ ማካላዲ? <verse eid="ISA 36:5"/><verse number="6" style="v" sid="ISA 36:6"/>ኔን ግብጼ ካቲ ማዳና ጋደ ቆፔዳዋ ግዶፐ፥ መኤዳ ማቃ ጋትማን ጉፈትያ አሳ ማላ። አያዉ ጎፐ፥ ጻምአይ መእና፥ ፕንጩ ኩሽያ ጫዴነ ማዱጽሴ። ግብጼ ካቲ ባረናን አማነትያ አሳ ኡባዉ ሄዋ ማላ።’ ”<note caller="-" style="x"><char style="xo" closed="false">36:6 </char><char style="xt" closed="false"><ref loc="EZK 29:6-7">ህዝ. 29:6-7</ref></char></note><verse eid="ISA 36:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 36:7"/>ሽን ኔን ታዉ፥ “ኑን መና ጎዳን፥ ኑ ጾሳን፥ አማነቴቶ” ያጎፐ፥ ህዝቂያስ ይሁዳ አሳነ የሩሳላመ አሳ፥ “ህንተ የሩሳላመን ደእያ ያርሽያሳን ጎይናናዉ ኮሼ” ጊደ፥ አዉ ጎይንያ ቃ ሳአቱዋነ ያርሽያ ሳኣ ድጌዳ ጾሳ እ ግደኔ?<verse eid="ISA 36:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 36:8"/>አነ ሀእ ሃያ! ታ ጎዳ አሶረ ካትያና ናሰታ። ኔን ቶጋናዉ ዳንዳይያ፥ ግድያ አሳ ደሞፐ፥ ላኡ ሻአ ፓራቱዋ ታን ነዉ እማና። <verse eid="ISA 36:8"/><verse number="9" style="v" sid="ISA 36:9"/>ኔን፥ “ግብጼቱ ፓራ አሳቱዋነ ፓራ ጋረቱዋ ታዉ የዳና” ጋደ አማኖፐነ፥ ታ ጎዳ ኦላንቻቱዋ ካፓቱዋፐ እት ላፍያዋካ ዛራናዉ ዳንዳያካ። <verse eid="ISA 36:9"/><verse number="10" style="v" sid="ISA 36:10"/>ሄዋ ቦላካ ቃይ፥ ታን ሀእ ቱሙ መና ጎዳ አዛዙ ባይናን ሀ ጋድያ ይሳናዉ ከሳድታ? መና ጎዳይ ባረ ሁጲያን ታና፥ “ኔረ፥ ሄ ጋድያ ባደ፥ ኦላደ ባይዛ” ያጊደ ኦዴዳ ያጌ ያግተ ያጌዳ።<verse eid="ISA 36:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 36:11"/>ሄዋፐ ጉይያን ኤልያቂመ፥ ሼብንነ ዮኣህ አሶረቱዋ ጋዳዋ ሀዋዳን ያጌድኖ፤ “ኑን ብለ ኤርያ ድራዉ፥ ሀያና ኔን ኑዉ ነ ቆማቶ ሶርያ ቃላን ኦዳ። ድርሳ ግምቢያ ሁጲያን ደእያ አሳይ ስሰና ማላ፥ እብራይስጸ ቃላን ኦዶፓ” ያጌድኖ።<verse eid="ISA 36:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 36:12"/>ሽን ጋዳዋይ ዛረደ፥ “ሀ ቃላቱዋ ታን ህንተዉነ ህንተ ጎዳ ጻላላዉ ኦዳናዉ ታና ታ ጎዳይ ኪቴዴየ? ህንተናና እትፐ ባረንቱ ኡርቃ ሼሻ ማናዉነ ባረንቱ ሃ ሼሻ ኡሻናዉ ደእያ፥ ሀ ድርሳ ግምቢያ ቦላ ኡቴዳ አሳ ኡባዉ ኦዳናሳ ግደኔየ?” ያጌዳ።<verse eid="ISA 36:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 36:13"/>ሄዋፐ ጉይያን አሶረቱዋ ጋዳዋይ ደንድ ኤቂደ፥ ባረ ቃላ ቁ ኦደ፥ እብራይስጸ ቃላን ሀዋዳን ያጌዳ፤ “አሶረ ካቲ ዎልቃማይ ህንተና ግያዋ ስስተ! <verse eid="ISA 36:13"/><verse number="14" style="v" sid="ISA 36:14"/>ካቲ ህንተና ሀዋዳን ያጌ፤ ‘ህዝቂያስ ህንተና ጭሞፖ፤ አያዉ ጎፐ፥ እ ህንተና ታ ኩሽያፐ ዎ አካናዉ ዳንዳየና። <verse eid="ISA 36:14"/><verse number="15" style="v" sid="ISA 36:15"/>እ ህንተና፥ “መና ጎዳይ ቱማ ኑና አሻና፤ ሀ ካታማይካ አሶረ ካትያ ኩሽያን ገለና” ጊደ ህንተ መና ጎዳን አማነታና ማላ ኦፖ’ ያጌ።<verse eid="ISA 36:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 36:16"/>“ኤ፥ ህንተ ህዝቂያስ ኦድያዋ ስሶፕተ። አሶረ ካቲ ህንተና፥ ‘ታናና ስገትተ፤ ሃ ታኮ ከስተ። ያቶፐ፥ ህንተ ኡባይካ ህንተ ዎይንያ ቴራፐነ ህንተ ባላስያ ቴራፐ ማና፤ ህንተ ቦኬዳ ኦላፐካ ሃ ኡሻና። <verse eid="ISA 36:16"/><verse number="17" style="v" sid="ISA 36:17"/>ሄዋፐ ጉይያን ታን ያደ፥ ህንተና ህንተ ቢታ ማላትያ ቢታ አካደ አፋና። ሄ ቢታይ ካይነ ዎይንያ ኤሳይ፥ ኡክይነ ዎይንያ አታክልቲ ኩሜዳ ቢታ’ ያጌ።<verse eid="ISA 36:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 36:18"/>“ህዝቂያስ ህንተና፥ ‘መና ጎዳይ ኑና አሻና’ ያጊደ ጭመናዳን ናገትተ። ጋድያ አሳቱዋ ጾሳቱዋፐ ባረ ቢታ አሶረ ካትያ ኩሽያፐ አሼዳ ጾስ ደኢየ? <verse eid="ISA 36:18"/><verse number="19" style="v" sid="ISA 36:19"/>ሀማታ ጾሳቱነ አርፋዳ ጾሳቱ ሀቃን ደኢኖ? ሳፋርዋይማ ግያ ካታማ ጾሳቱ ሀቃን ደኢኖ? ኡንቱንቱ ሳማርያ ታ ኩሽያፐ ዎ አኬድኖ? <verse eid="ISA 36:19"/><verse number="20" style="v" sid="ISA 36:20"/>ሀ ቢታቱዋ ጾሳቱዋ ኡባ ግዶን ባረ ጋድያ ታ ኩሽያፐ አይ ጾስ አሼዳዋ ሽን፥ መና ጎዳይ የሩሳላመ ታ ኩሽያፐ አሻኔ?” ያጌዳ።<verse eid="ISA 36:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 36:21"/>ሽን አሳይ እት ቃላነ አዉ ዛረናን ጮኡ ጌዳ። አያዉ ጎፐ፥ ካቲ ኡንቱንታ፥ “አዉ አይነ ዛሪደ ኦዶፕተ” ያግ ዎዳ። <verse eid="ISA 36:21"/><verse number="22" style="v" sid="ISA 36:22"/>ሄዋፐ ጉይያን ህልቂያ ናአይ ካትያ ጎልያን አዎትያ ኤልያቂመ፥ ዋና ጻፊ ሼብንነ ታርክያ ጻፊ አሳፋ ናአይ ዮኣህ ባረንቱ ማዩዋ ፔደ፥ ህዝቂያሳኮ ቤድኖ፤ አሶረቱዋ ጋዳዋይ ጌዳዋ ኡባ አዉ ኦዴድኖ።<verse eid="ISA 36:22"/></para>
  <chapter eid="ISA 36"/>
  <chapter number="37" style="c" sid="ISA 37"/>
  <para style="s1">ካቲ ህዝቂያስ ኢስያሳ ዞርያ ኦቼዳ</para>
  <para style="r">(<ref loc="2KI 19:1-7">2 ካታ. 19:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 37:1"/>ካቲ ህዝቂያስ ሄዋ ስሴዳ ዎደ፥ ባረ ማዩዋ ፔዳ፤ ማቃ ማዪደ፥ መና ጎዳ ጌሻ ጎልያ ገሌዳ። <verse eid="ISA 37:1"/><verse number="2" style="v" sid="ISA 37:2"/>ካትያ ጎልያን አዎትያ ኤልያቂመ፥ ዋና ጻፊ ሼብንነ ጭማ ቄሳቱ ማቃ ማዪደ፥ አሞጻ ናኣ ትምቢትያ ኦድያ ኢስያሳ ኮ ባና ማላ ኪቴዳ። <verse eid="ISA 37:2"/><verse number="3" style="v" sid="ISA 37:3"/>ኡንቱንቱ ኢስያሳ ኮ ቢደ፥ “ህዝቂያስ ሀዋዳን ያጌ፤ ‘ሀቼ ጋላሳይ መቶ ጋላሳ፥ ሴራ ጋላሳነ ዬላ ጋላሳ። ሄዌካ ናእ የለታናዉ ዎዲ ጋክና፥ ባናደ የላናዉ ምሽራትዉ ዎልቃይ ይያዋ ማላ። <verse eid="ISA 37:3"/><verse number="4" style="v" sid="ISA 37:4"/>ደኡዋ ጾሳ ሸቃናዳን፥ አ ጎዳይ፥ አሶረ ካቲ፥ ኪቴዳ ጋዳዋ ቃላ መና ጎዳይ ነ ጾሳይ ስሰናን አገና። ቃይ መና ጎዳይ ነ ጾሳይ ሄ ስሴዳ ቃላ ሀዳን አ ሙረናን አገና። ሄዋ ድራዉ፥ ኑ አሳ ግዶን ፓላህ አታናዋንቶ ዎሳ!’ ያጌ” ያጌድኖ።<verse eid="ISA 37:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 37:5"/>ካትያ ህዝቂያሳ ቆማቱ ኢስያሳ ኮ ዬዳ ዎደ፥ <verse eid="ISA 37:5"/><verse number="6" style="v" sid="ISA 37:6"/>እስያስ ኡንቱንታ ሀዋዳን ያጌዳ፤ “ህንተ ጎዳዉ ሀዋዳን ያጊደ ኦድተ፤ መና ጎዳይ ኔና፥ ‘አሶረ ካትያ ቆማቱ ታና ሸቅሽን፥ ኔን ስሴዳ ቦርያ ቃላዉ ያዮፓ። <verse eid="ISA 37:6"/><verse number="7" style="v" sid="ISA 37:7"/>በአ፥ ኦዱዋ ስሲደ፥ እ ባረ ቢታ ስማና ማላ፥ ታን አ ግዶን እት አያና ዎና። ያታደ እ ባረ ቢታ ቢደ፥ ያን ማሻን ሀይቃናዳን፥ ታን አ ኦና ያጌ’ ” ያግተ ያጌዳ።<verse eid="ISA 37:7"/></para>
  <para style="s1">አሶረቱ ሀራቱዋካ ናሴድኖ</para>
  <para style="r">(<ref loc="2KI 19:8-19">2 ካታ. 19:8-19</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 37:8"/>አሶረ ካቲ ላክሻ ካታማፐ ደንዲደ ብ ክቼዳዋ አሶረቱዋ ጋዳዋይ ስሲደ፥ ጉየ ስሜዳ። ካቲ ሊብና ካታማን ኦለትያዋ ደሜዳ።<verse eid="ISA 37:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 37:9"/>ካቲ ሳናክሬብ፥ “ቶጵያ ካቲ ትርሃቅ ኔና ኦላናዉ ዬዳ” ያግያ ኦዱዋ ስሴዳ። ህዝቂያሳዉ ሀዋዳን ያግ ኪቴዳ፤ <verse eid="ISA 37:9"/><verse number="10" style="v" sid="ISA 37:10"/>“ይሁዳ ካትያ ህዝቂያሳ፥ ኔን አማነትያ ጾሳይ ኔና፥ ‘የሩሳላመ አሶረ ካትያ ኩሽያን ገለና’ ያግ ጭሞፖ። <verse eid="ISA 37:10"/><verse number="11" style="v" sid="ISA 37:11"/>በአ፥ አሶረ ካተቱ ቢታቱዋ ኡባ ኡባና ይሲደ፥ ኡንቱንቱ ኦዳዋ ኔን ስሳዳ። ያትና፥ ኔን አታኒ? <verse eid="ISA 37:11"/><verse number="12" style="v" sid="ISA 37:12"/>በን ታ ማይዛ አዎቱ ባይዜዳ ቢታቱዋ ጾሳቱ፥ ሄዋንቱነ ጎዛና፥ ካራነነ ረጼፋ ቢታቱዋ ጾሳቱነ ታላሳራን ደእያ ኤደነ አሳ ጾሳቱ ሄ ቢታቱዋ ባሻፐ አሼድኖ? <verse eid="ISA 37:12"/><verse number="13" style="v" sid="ISA 37:13"/>ሀማታ ካቲ፥ አርፋዳ ካቲ፥ ሳፋርዋይማ ካቲ፥ ሄናአ ካቲነ ኢዋ ካቲ ሀቃን ደኢኖ?” ያግ ኪቴዳ።<verse eid="ISA 37:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 37:14"/>ህዝቂያስ ዳብዳቢያ ኪተቴዳ አሳቱዋፐ አኪደ ናባቤዳ። ዳብዳቢያ መና ጎዳ ጌሻ ጎልያ አክ አፊደ፥ መና ጎዳ ስንን ምጬዳ። <verse eid="ISA 37:14"/><verse number="15" style="v" sid="ISA 37:15"/>ያቲደ መና ጎዳ ሀዋዳን ያግ ዎሴዳ፤ <verse eid="ISA 37:15"/><verse number="16" style="v" sid="ISA 37:16"/>“አቤት ኡባፐ ዎልቃማ መና ጎዳዉ፥ ክሩበቱዋፐ ግዱዋን ኡትያ እስራኤልያ ጾሳዉ፥ ሳኣ ካዉተቱዋ ኡባ ቦላ ነ ጻላላይ ጾሳ። ሳሉዋነ ሳኣ ኔን መዳ።<note caller="-" style="x"><char style="xo" closed="false">37:16 </char><char style="xt" closed="false"><ref loc="EXO 25:22">ከሳ 25:22</ref></char></note> <verse eid="ISA 37:16"/><verse number="17" style="v" sid="ISA 37:17"/>አቤት መና ጎዳዉ፥ ነ ሀይ ሃ የጋደ ስሳ። አቤት መና ጎዳዉ፥ ነ አይፍያ ፖጋደ ጼላ። ኔና፥ ደኡዋ ጾሳ ቦራናዉ ሳናክሬብ ኪቴዳ ቃላ ስሳ።<verse eid="ISA 37:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 37:18"/>“አቤት መና ጎዳዉ፥ አሶረ ቢታ ካተቱ ካዉተ ኡባነ ኡንቱንቱ ጋድያ ባይዜዳዌ ኤ ቱማ። <verse eid="ISA 37:18"/><verse number="19" style="v" sid="ISA 37:19"/>ኡንቱንቱ ጾሳቱዋ ታማን ጹግ ይሴድኖ፤ አያዉ ጎፐ፥ ኡንቱንቱ ጾሳቱ ዎንካ አሳ ኩሺ ማሲደ ከሴዳ ምነ ሹቻ ግድያ ድራዉ፥ ቱሙ ጾሳቱዋ ግድክኖ፤ ሄዋ ድራዉ፥ ኡንቱንቱ ኡንቱንታ ይሴድኖ። <verse eid="ISA 37:19"/><verse number="20" style="v" sid="ISA 37:20"/>ሀእ ስም አቤት መና ጎዳዉ፥ ኑ ጾሳዉ፥ ነ ጻላላይ ጾሳ ግድያዋ ሳኣ ካዉተቱ ኡባይ ኤራና ማላ፥ ኔን ኑና አ ኩሽያፐ ዎ አካ!” ያግ ዎሴዳ።<verse eid="ISA 37:20"/></para>
  <para style="s1">እስያስ ካትያዉ የዴዳ ኪታ</para>
  <para style="r">(<ref loc="2KI 19:20-37">2 ካታ. 19:20-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 37:21"/>ሄዋፐ ጉይያን፥ አሞጻ ናአይ እስያስ ህዝቂያሳዉ ሀዋዳን ያግ ኪቴዳ፤ “መና ጎዳይ እስራኤልያ ጾሳይ ሀዋዳን ያጌ፤ ‘ኔን አሶረ ካትያ ሳናክሬባ ጋሱዋን ታና ዎሴዳ ዎሳ ስሳድ’ ያጌ። <verse eid="ISA 37:21"/><verse number="22" style="v" sid="ISA 37:22"/>መና ጎዳይ ሳናክሬባዋ ሀዋዳን ያግ ሃሳየ፦</para>
  <para style="q1" vid="ISA 37:22">“ጽዮነን ደእያ አሳይ ኔና ካ፤</para>
  <para style="q2" vid="ISA 37:22">የሩሳላመ አሳይ ባረ ሁጲያ ቃደ፥ ኔና ቅሊጬ።<verse eid="ISA 37:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 37:23"/>ኔን ሸቄዳዌነ ቶቼዳዌ ኦኔ?</para>
  <para style="q2" vid="ISA 37:23">ኔን ኦ ቦላን ነ ቃላ</para>
  <para style="q2" vid="ISA 37:23">ቁ ኦደ ሃሳያዲ?</para>
  <para style="q2" vid="ISA 37:23">ቃይ ኦቶሩዋን ኦና</para>
  <para style="q2" vid="ISA 37:23">ቁ ጋደ ጼላዲ?</para>
  <para style="q2" vid="ISA 37:23">ሄዋ ኔን ኦዳዌ ታ ቦላና፥</para>
  <para style="q1" vid="ISA 37:23">እስራኤልያ ጌሻ ቦላና ግደኔ!<verse eid="ISA 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 37:24"/>ኔን ኪቴዳ አሳቱዋ ባጋና ጎዳ ሸቃዳ።</para>
  <para style="q2" vid="ISA 37:24">ቃይ ሀዋዳን ያጋዳ፤</para>
  <para style="q1" vid="ISA 37:24">‘ታን ታዉ ደእያ ጮራ ፓራ ጋረቱዋን</para>
  <para style="q2" vid="ISA 37:24">ቃ ደረቱዋ ሁጲያ፥ ሊባኖሳ ደርያ ኪክያ ከሳድ።</para>
  <para style="q1" vid="ISA 37:24">ከሳደ ኡባፐ አዱቂያ ዝጋቱዋነ፥</para>
  <para style="q2" vid="ISA 37:24">ኡባፐ ሎእያ ጺዳቱዋ ቃንጻድ።</para>
  <para style="q1" vid="ISA 37:24">ታን ቃዉ ዉርሰ ጋጻነ፥</para>
  <para style="q2" vid="ISA 37:24">ጪልሞ ዎራ ጋካድ።<verse eid="ISA 37:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 37:25"/>ታን አላጋ ቢታቱዋን</para>
  <para style="q2" vid="ISA 37:25">ሃ ኦላቱዋ ቦካደ፥</para>
  <para style="q1" vid="ISA 37:25">ሃ ኡንቱንቱፐ ኡሻድ።</para>
  <para style="q2" vid="ISA 37:25">ግብጼ ጋድያን ጎግያ ሃ ኡባ</para>
  <para style="q2" vid="ISA 37:25">ታን ታ ገድያ ጎምፓን የደ መልሳድ’</para>
  <para style="m" vid="ISA 37:25">ያጋዳ።<verse eid="ISA 37:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 37:26"/>“ዳሮ ዎድያፐ ካሰ፥</para>
  <para style="q2" vid="ISA 37:26">ኔን ግምበቴዳ ካታማቱዋ ቆቆፋደ፥</para>
  <para style="q2" vid="ISA 37:26">ሹቻ ኬላ ከሳና ማላ፥</para>
  <para style="q2" vid="ISA 37:26">ታን ቆፋ ቃቻ ዎዳዋ ኔን ኤራበይኪ?</para>
  <para style="q1" vid="ISA 37:26">ታን ሀእ ፖልያ ሀልቾቱዋ፥</para>
  <para style="q2" vid="ISA 37:26">በን ሀልቻ ዎድ።<verse eid="ISA 37:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 37:27"/>ሄዋ ድራዉ፥ ኡንቱንቱ አሳዉ ዎልቃይ እጽና፥</para>
  <para style="q2" vid="ISA 37:27">ኡንቱንቱ ካዉሼድኖነ ዬላቴድኖ።</para>
  <para style="q1" vid="ISA 37:27">ኡንቱንቱ ጋደ ማታ ማላ፤</para>
  <para style="q2" vid="ISA 37:27">ጎሻን ሞኬዳ ጫርሻ ማላ።</para>
  <para style="q1" vid="ISA 37:27">ኡንቱንቱ ጎልያ ሁጲያን</para>
  <para style="q2" vid="ISA 37:27">ሞክያ ሻራፋዳንነ ካኤናን ደእሽን፥</para>
  <para style="q2" vid="ISA 37:27">ትሻን ዋግ ሜዳ ካዳን ሀኔድኖ።<verse eid="ISA 37:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 37:28"/>“ሽን ኔን ኡትያሳ፥</para>
  <para style="q2" vid="ISA 37:28">ከስያሳ፥ ገልያሳነ፥</para>
  <para style="q2" vid="ISA 37:28">ታ ቦላ ኔን ሀንቀቴዳ ሀንቁዋ ታን ኤራይ።<verse eid="ISA 37:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 37:29"/>ኔን ታ ቦላ ሀንቀቴዳ ድራዉነ፥</para>
  <para style="q2" vid="ISA 37:29">ነ ኦቶሩዋካ ታን ስሴዳ ድራዉ፥</para>
  <para style="q2" vid="ISA 37:29">ታን ነ ሲያን ታ ማጋ አና፤</para>
  <para style="q2" vid="ISA 37:29">ነ ዶናንካ ታ ብጻላ ባርሳና።</para>
  <para style="q1" vid="ISA 37:29">ያታደ ኔን ዬዳ ኦግያና፥</para>
  <para style="q2" vid="ISA 37:29">ታን ኔና ጉየ ዛራና ያጌ”</para>
  <para style="m" vid="ISA 37:29">ያጌዳ።<verse eid="ISA 37:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ISA 37:30"/>ሄዋፐ ጉይያን፥ እስያስ ካትያ ህዝቂያሳ ሀዋዳን ያጌዳ፤ “ሀዎ ነዉ ማላታይ ሀዋ: ሀ ላይ ህንተ አዛባ ሞኬዳ ካ ማና፤ ላይ ቃይ ሀ ላይ ሞኬዳዋ አዛባ ማና። ሽን ካላ ላይ ህንተ ህንተ ሁጲያን ዘርተነ ጫክተ፤ ዎይንያ ቱራካ ቶክተነ አ ቴራ ሚተ። <verse eid="ISA 37:30"/><verse number="31" style="v" sid="ISA 37:31"/>ይሁዳ አሳፐ አትያዋንቱ ጻጱዋ ዱገ የዲደ፥ ቦላን አይፍያ አይፍያ ም ማላ ግዳናዋ። <verse eid="ISA 37:31"/><verse number="32" style="v" sid="ISA 37:32"/>አያዉ ጎፐ፥ ዉሪደ አቴዳዋንቱ የሩሳላመፐ፥ ፓላሄዳዋንቱካ ጽዮነፐ ከሳና። ኡባፐ ዎልቃማ መና ጎዳ ምሹ ሄዋ ኦደ ፖላና።<verse eid="ISA 37:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ISA 37:33"/>“ሄዋ ድራዉ፥ አሶረ ካትያባ መና ጎዳይ ሀዋዳን ያጌ፤ ‘አሶረ ካቲ ሀ ካታማ ገለና፤ ዎይ ሀዋን ባረ ዎንዳፍያ ዱከና፤ ዎይ ባረ ጎንዳልያ ኦይቂደ፥ ሀ ካታማ ስን አና፤ ዎይ ቃይ ካታማ ዩሹዋ ቢታ ዶርያን ዶደና። <verse eid="ISA 37:33"/><verse number="34" style="v" sid="ISA 37:34"/>አሶረ ካቲ ባረ ዬዳ ኦግያና ጉየ ስማና፤ እ ሀ ካታማ ገለና። ታን መና ጎዳይ ሀዋ ኦዳይ። <verse eid="ISA 37:34"/><verse number="35" style="v" sid="ISA 37:35"/>ታን ታ ቦንቹዋ ድራዉነ ታ ቆማ ዳዊታ ድራዉ፥ ሀ ካታማ ቦሽሰናን አሻ አካና’ ያጌ” ያጌዳ።<verse eid="ISA 37:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ISA 37:36"/>ሄ ጋላስ ቃማ መና ጎዳ ኪታንቻይ ከሲደ፥ አሶረ አሳይ ዱንካኔዳሳን፥ እት ጼታነ ሆስፑን ታማነ እቼሹ ሻአ አቱማ አሳ ዎዳ። ያትና፥ አሳይ ዎንታ ሱሪደ በእያ ዎደ፥ ሀይቄዳ አሳ አሃይ ሄዋን ኩሜዳ። <verse eid="ISA 37:36"/><verse number="37" style="v" sid="ISA 37:37"/>ሄዋ ድራዉ፥ አሶረ ካቲ ሳናክሬብ ደንዲደ፥ ጉየ ስም ቢደ፥ ናናዌ ካታማን ኡቴዳ።<verse eid="ISA 37:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ISA 37:38"/>እት ጋላስ ሳናክሬብ ባረ ጾሳ ንስሮካ ጎልያን ጎይኒድ ደእሽን፥ አ ናናይ አድራመሌክነ ሳርኤጸር ማሻን አ ዎድኖ። አራራተ ግያ ቢታ ባቃቴድኖ። አ ናአይ አስራዶን አ ሳኣን ካተቴዳ። 37:38 አስራዶን: እ እብራዌ ቃላን “ኤሳር-ሀዶን” ጌተቴ።<verse eid="ISA 37:38"/></para>
  <chapter eid="ISA 37"/>
  <chapter number="38" style="c" sid="ISA 38"/>
  <para style="s1">ካቲ ህዝቂያስ ሀርጊደ ፓጼዳ</para>
  <para style="r">(<ref loc="2KI 20:1-11">2 ካታ. 20:1-11</ref>፤ <ref loc="2CH 32:24-26">2 ኦዱዋ 32:24-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 38:1"/>ሄ ዎደ ካቲ ህዝቂያስ ሀርጊደ፥ ሀይቃና ማቴዳ። ያት ደእሽን አሞጻ ናአይ ትምቢትያ ኦድያ እስያስ አኮ ቢደ፥ “መና ጎዳይ ኔና፥ ‘ኔን ሀይቃሳፐ አትና ፓጻካ፤ ሄዋ ድራዉ፥ ነ ጎልያ ጊግሳ’ ያጌ” ያጌዳ።<verse eid="ISA 38:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 38:2"/>ህዝቂያስ ጎዳኮ ስም ግሲደ፥ መና ጎዳ ዎሴዳ። <verse eid="ISA 38:2"/><verse number="3" style="v" sid="ISA 38:3"/>እ “አቤት መና ጎዳዉ፥ ታን ነ ስንን ቱማተንነ ኩመን ዎዛናን ሄመቴዳዋነ ቃይ ኔና ናሸችያባ ኦዳዋ ታዉ ኔን ሀሳያና ማላ፥ ታን ኔና ዎሳይ” ያጊደ ዎሴዳ፤ ህዝቂያስ ሎይ ምሸቲደ ዬኬዳ።<verse eid="ISA 38:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 38:4"/>ሄዋፐ ጉይያን፥ መና ጎዳ ቃላይ ኢስያሳ ኮ ሀዋዳን ያጊድ ዬዳ። <verse eid="ISA 38:4"/><verse number="5" style="v" sid="ISA 38:5"/>“ባደ፤ ህዝቂያሳ፥ መና ጎዳይ ነ ማይዛ አዉዋ ዳዊታ ጾሳይ ሀዋዳን ያጌ፤ ‘ታን ነ ዎሳ ስሳድ፤ ነ አፎካ በኣድ። ነ ላይ ቦላ ታን ነዉ ታማነ እቼሹ ላይ ጉጃና። <verse eid="ISA 38:5"/><verse number="6" style="v" sid="ISA 38:6"/>ኔናነ ሀ ካታማ አሶረ ጋድያ ካትያ ኩሽያፐ አሻና፤ ታን ሀ ካታማዉ ኦለታደ አሻና ያጌ’ ” ያጋ ያጌዳ።<verse eid="ISA 38:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 38:7"/>እስያስ ጉጂድካ ሀዋዳን ያጌዳ፤ “መና ጎዳይ ባረ ጌዳ ቃላ ፖላናዉ መና ጎዳዉ ማላታይ ሀዋ: <verse eid="ISA 38:7"/><verse number="8" style="v" sid="ISA 38:8"/>በአ፥ አካዝ ፑደ ከሳናዉ ጊግሴዳ ደን ደእያ ኩዋይ ታሙ ታንጉዋ ጉየ ስሚደ ባናዳን፥ ታን ኦና” ያጌዳ። ኩዋይ ታሙ ታንጉዋ ጉየ ስሚደ ቤዳ።<verse eid="ISA 38:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 38:9"/>ይሁዳ ካቲ ህዝቂያስ ሀርግ ፓጼዳዋፐ ጉይያን፥ ጻፌዳ ማዝሙሪ ሀዋ: <verse eid="ISA 38:9"/><verse number="10" style="v" sid="ISA 38:10"/>ታን፥ “ታ ደኦ ላይዉ ብሮ ባጋ ጋክያ ዎደ፥ ሀይቁዋ ፐንግያና ገላና ሀናይታ? ታ አቴዳ ላይ ቦንቂ ድግና፥ መላ አታና ሀናይታ?” ያጋድ። <verse eid="ISA 38:10"/><verse number="11" style="v" sid="ISA 38:11"/>ሄዋዳንካ ቃይ፥ “ታን ፓጻ ደእያዋንቱ ጋድያን መና ጎዳ በእከ፤ ሀ ሳኣን ደእያዋንቱ ግዶንካ ላኤን መና ጎዳ በእከ። <verse eid="ISA 38:11"/><verse number="12" style="v" sid="ISA 38:12"/>ዶርሳ ሄምያዋ ዱንካንያዳን፥ ታ ደኡ ሾደቴዳ። ሸማይኒ አፍላ ሀርባን ጻጽያዋዳን፥ ታን ታ ደኡዋ ጻጻድ፤ እካ ታና ሸማይንያ ሀርባፐ ዱዳ ጋላሳፐ ቃማ ጋካናዉ፥ ኔን ታና ይሳዳ ያጋድ። <verse eid="ISA 38:12"/><verse number="13" style="v" sid="ISA 38:13"/>ሳአይ ዎንታና ጋካናዉ ታን ማዱዋ ደማናዉ ዋሳድ። ሽን ጋሙዋዳን እ ታ መቀ ኡባ መንዳ። ቃይ ጋላሳፐ ቃማ ጋካናዉ፥ ኔን ታና ይሳዳ። <verse eid="ISA 38:13"/><verse number="14" style="v" sid="ISA 38:14"/>ታን ጭራሹዋዳንነ ሃ ካፉዋዳን ዋሳድ፤ ሀራጵያዳንካ ዙዙማድ። ታ አይፈቱ ሳሉዋ ፑደ ጼሊደ ጼሊደ ዳቡሬድኖ። አቤት ጎዳዉ፥ ታን ኡንኤታድ፤ ኔን ታና ሀ ኡንኡዋፐ ከሳ!” ያጋድ።<verse eid="ISA 38:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 38:15"/>ሀዋ ኡባ ጾሳይ እ ባረ ሁጲያን ኦዳ፤ ያትና፥ ታን አያ ጋናዉ ዳንዳያይታ? ታ ሸምፑ ሎይ ኡንኤቴዳ ድራዉ፥ ታ ላይ ኡባን አሽከተን ሀመታና። <verse eid="ISA 38:15"/><verse number="16" style="v" sid="ISA 38:16"/>አቤት ጎዳዉ፥ ሀዋንቱ ማላ የዎቱዋን አሳይ ፓጻ ደኤ። ሀይ ታ ፓጻተ ዛራደ፥ ታና ፓጻ ዎርኪ! <verse eid="ISA 38:16"/><verse number="17" style="v" sid="ISA 38:17"/>በአ፥ ታን ሀ ዎልቃማ ቱጋ ቱጋቴዳዌ ታዉ ሎአ ግዴዳ። ኔን ታ ሸምፑዋ ባሻ ኦላፐ ጉየ ዛራደ አሻዳ፤ ኔን ታ ናጋራ ኡባ ኔፐ ጉየ ዛራደ ኦላዳ። <verse eid="ISA 38:17"/><verse number="18" style="v" sid="ISA 38:18"/>አያዉ ጎፐ፥ ዱፉ ኔና ጋላተና፤ ሀይቁካ ኔና ሳበና። ጪማ ኦላዉ ዱገ ዎያዋንቱ ኔና አማን ጊደ ህዶታ ኦክኖ። <verse eid="ISA 38:18"/><verse number="19" style="v" sid="ISA 38:19"/>ታን ሀች ኔና ጋላትያዋዳን፥ ፓጻ ደእያዋንቱ ጻላላቱ ኔና ጋላቲኖ፤ ኔን አማንያዋ አዉ ባረ ናናቶ ኦዴ።<verse eid="ISA 38:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 38:20"/>መና ጎዳይ ታና አሻና፤ ሄዋ ድራዉ፥ ኑን ኑ ደኡዋ ላይ ኡባን፥ መና ጎዳ ጎልያን ባቀቴዳ ክርያን ዋጸቴዳ ዲን የጻና።<verse eid="ISA 38:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 38:21"/>ሀዋፐ ካሰ እስያስ፥ “ባላስያ ቴራ ዳጺደ፥ አ ጋፉዋ ቦላ ዎተ። ያቶፐ፥ እ ፓጻና” ያግ ዎዳ።<verse eid="ISA 38:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 38:22"/>ህዝቂያስካ፥ “ታን ፓጻደ መና ጎዳ ጌሻ ጎልያ ፑደ ከሳናዎ ማላታይ አዬ” ያግ ኢስያሳ ኦች ዎዳ።<verse eid="ISA 38:22"/></para>
  <chapter eid="ISA 38"/>
  <chapter number="39" style="c" sid="ISA 39"/>
  <para style="s1">ባብሎነፐ ኪተቲደ ዬዳ አሳቱዋ</para>
  <para style="r">(<ref loc="2KI 20:12-19">2 ካታ. 20:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 39:1"/>ሄ ዎደ፥ ባላዳና ናአይ፥ ባብሎነ ካቲ ማሮዳክ ባላዳን፥ ህዝቂያስ ሀርጊደ ፓጼዳዋ ስሴዳ ድራዉ፥ ዳብዳቢያነ እሙዋ ህዝቂያሳዉ የዴዳ። <verse eid="ISA 39:1"/><verse number="2" style="v" sid="ISA 39:2"/>ህዝቂያስ ኪተቲደ ዬዳ አሳቱዋ ሞኬዳ። ያቲደ ባረ ሻሉዋ ምንጅያ ጎልያን ደእያ ብራ፥ ዎርቃ፥ ሳዉዋ፥ አልኦ ዛይትያ፥ ባረ ኦላ ሚሻነ ባረ ሻሉዋ ምንጅያ ጎልያን ደእያዋ ኡባ ኡንቱንታ በሴዳ። ባረ ሶን ዎይ ባረ ካዉተ ግዶን ደእያዋ ኡባፐ ህዝቂያስ ኡንቱንታ በሰናን አጌዳባይ አያይነ ባዋ።<verse eid="ISA 39:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 39:3"/>ሄዋፐ ጉይያን፥ ትምቢትያ ኦድያ እስያስ ካትያ ህዝቂያሳኮ ዪደ፥ “ሀ አሳቱ ዋጌድኖ? ኡንቱንቱ ሀቃፐ ዬድኖ?” ያግ ኦቼዳ።</para>
  <para style="p" vid="ISA 39:3">ህዝቂያስ፥ “ኡንቱንቱ ታኮ ሃኮ ጋድያፐ፥ ባብሎነፐ ዬድኖ” ያጌዳ።<verse eid="ISA 39:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 39:4"/>እስያስ ቃይካ፥ “ኡንቱንቱ ነ ሶን አያ አያ በኤድኖ?” ያጌዳ።</para>
  <para style="p" vid="ISA 39:4">ህዝቂያስ፥ “ኡንቱንቱ ታ ሶን ደእያ ኡባባ በኤድኖ፤ ታ ሻሉዋ ምንጅያ ጎልያን ደእያባፐ ታን ኡንቱንታ በሳቤናባይ አያይነ ባዋ” ያጌዳ።<verse eid="ISA 39:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 39:5"/>ሄዋፐ ጉይያን፥ እስያስ ህዝቂያሳ፥ “ኡባፐ ዎልቃማ መና ጎዳይ ግያዋ ስሳ። <verse eid="ISA 39:5"/><verse number="6" style="v" sid="ISA 39:6"/>መና ጎዳይ ሀዋዳን ያጌ፤ ‘ነ ካትያ ጎልያን ደእያባይ ኡባባይነ ነ ማይዛ አዎቱ ሀች ጋካናዉ ሺሼዳባይ ኡባባይ ኡባና ኦሞደቲደ፥ ባብሎነ ቢታ ባና ጋላሳቱ ያና፤ አፐ አያይነ አተና። <verse eid="ISA 39:6"/><verse number="7" style="v" sid="ISA 39:7"/>ቃይ ነዉ የለታና፥ ነ አሾነ ነ ሱ ግድያ፥ ነ አቱማ ዛራቱዋፐካ ኦሞደቲደ ባና፤ ቢደ ባብሎነ ካትያ ጎልያን ጎይሮ ግዲደ ኦና’ ያጌ” ያጌዳ።<verse eid="ISA 39:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 39:8"/>ህዝቂያስ ዛሪደ፥ “ኔን ኦዴዳ መና ጎዳ ቃላይ ሎአ” ያጌዳ። አያዉ ጎፐ፥ ህዝቂያስ፥ “ታን ደኤዳ ላይን ሳሩነ ዎፓይ ደአና ግደኔ” ያግ ቆፔዳ።<verse eid="ISA 39:8"/></para>
  <chapter eid="ISA 39"/>
  <chapter number="40" style="c" sid="ISA 40"/>
  <para style="ms">ጾሳይ ባረ አሳ አሽያዋ ግዱሳ</para>
  <para style="mr">(<ref loc="ISA 40:1-48:22">40:1—48:22</ref>)</para>
  <para style="s1">ምን ኩሜዳ ቃላ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 40:1"/>ህንተ ጾሳይ ሀዋዳን ያጌ፤ “ታ አሳ ምንተ! ምንተ! <verse eid="ISA 40:1"/><verse number="2" style="v" sid="ISA 40:2"/>የሩሳላመዉካ፥ እዛ ኦሞዱዋን ደኤዳ ዎዲ ፖለቴዳዋ፥ እዝ ናጋራይ አቶ ጌተቴዳዋ ኦድተ፤ እዝ ናጋራ ድራዉ፥ መና ጎዳይ እዞ ላኡ ዳኩዋ ሙሬዳዋ ኦድተ” ያጌ።<verse eid="ISA 40:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 40:3"/>እት ሀዋዳን ያግያ ኮሻ ስሰቴ፤<note caller="-" style="x"><char style="xo" closed="false">40:3 </char><char style="xt" closed="false"><ref loc="MAT 3:3">ማቶሳ 3:3</ref>፤ <ref loc="MRK 1:3">ማር. 1:3</ref>፤ <ref loc="JHN 1:23">ዮሃ. 1:23</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">40:3-5 </char><char style="xt" closed="false"><ref loc="LUK 3:4-6">ሉቃሳ 3:4-6</ref></char></note> “መላ ቢታን መና ጎዳ ኦግያ ጊግስተ፤ ኑ ጾሳዉ መላ ጋድያን አኮ ኦግያ ስት ኦተ። <verse eid="ISA 40:3"/><verse number="4" style="v" sid="ISA 40:4"/>ዎምባ ኡባይ ቁ ጋና፤ ደሪ ኡባይነ የዉ ኡባይ ዝቂ ጋና። ባዬዳ ኦጊ ሳላላና፤ ኮርጱኮርጳ ቢታይካ ደምባታና። <verse eid="ISA 40:4"/><verse number="5" style="v" sid="ISA 40:5"/>ሄ ዎደ፥ መና ጎዳ ቦንቹ ቆንጫና፤ አሹዋ ማዬዳ ኡባይ ሄዋ እትፐ በአና። አያዉ ጎፐ፥ መና ጎዳ ዶናይ ሄዋ ሃሳዬዳ” ያጌ።<verse eid="ISA 40:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 40:6"/>እት ኮሻይ፥ “ዋሳ!” ያግያዋ ስሳድ።<note caller="-" style="x"><char style="xo" closed="false">40:6-8 </char><char style="xt" closed="false"><ref loc="JAS 1:10-11">ያቆባ 1:10-11</ref>፤ <ref loc="1PE 1:24-25">1 ጰጽ. 1:24-25</ref></char></note></para>
  <para style="p" vid="ISA 40:6">ታን፥ “ዋጋደ ዋሶ?” ያጋድ።</para>
  <para style="p" vid="ISA 40:6">“አሳይ ኡባይ ማታ ማላ፤ አ ቦንቹ ኡባይካ ደምባ ጪሻ ማላ። <verse eid="ISA 40:6"/><verse number="7" style="v" sid="ISA 40:7"/>መና ጎዳይ ባረ ሸምፑዋ አ ቦላን ሸምፕያ ዎደ፥ ማታይ መሌ፤ ጪሻይካ ቆቆፈቴ። አሳይ ቱሙ ማታ ማላ። <verse eid="ISA 40:7"/><verse number="8" style="v" sid="ISA 40:8"/>ማታይ መሌ፤ ጪሻይካ ቆቆፈቴ፤ ሽን ኑ ጾሳ ቃላይ መናዉ ኤቂደ ደኤ” ያጋ ዋሳ።<verse eid="ISA 40:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 40:9"/>ኔኖ ምሽራቹዋ ኦድያ ጽዮኔ፥ ቃ ደርያ ፑደ ከሳ፤ ነኖ ምሽራቹዋ ኦድያ የሩሳላመ፥ ነ ኮሻ ዎልቃፐ ቁ ኦ፤ ያዮፓ፤ ቁ ኦ፤ ያታደ ይሁዳ ካታማቶ፥ “ህንተ ጾሳይ ሀዌኮ” ያጋ ኦዳ። <verse eid="ISA 40:9"/><verse number="10" style="v" sid="ISA 40:10"/>በእተ፥ ኡባ ሞድያ መና ጎዳይ ዎልቃና ዬ፤<note caller="-" style="x"><char style="xo" closed="false">40:10 </char><char style="xt" closed="false"><ref loc="ISA 62:11">ኢሳ. 62:11</ref>፤ <ref loc="REV 22:12">ሳፃ 22:12</ref></char></note> አ ቀሲ አዉ ሞዳና። በእተ፥ አ ዎይታይ አናና ደኤ፤ አ ኦሱዋ ጋቲካ አ ስንና። <verse eid="ISA 40:10"/><verse number="11" style="v" sid="ISA 40:11"/>እ ባረ ዉድያ ሄንንቻዳን ምዜ፤<note caller="-" style="x"><char style="xo" closed="false">40:11 </char><char style="xt" closed="false"><ref loc="EZK 34:15">ህዝ. 34:15</ref>፤ <ref loc="JHN 10:11">ዮሃ. 10:11</ref></char></note> ባረ ዶርሳ ማራቱዋካ ባረ ቀስያን ሺሺደ፥ ባረ ክዉዋን እድማና። ንያዋንታካ ሎዳን ካለና።<verse eid="ISA 40:11"/></para>
  <para style="s1">ኡባፐ ቦላ ግዴዳ እስራኤልያ ጾሳ</para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 40:12"/>ሃቱዋ ባረ ኩሽያ ኮጵያን ማኬዳዌ፥ ሳሎቱዋ ታካያን ልኬዳዌ፥ ቢታ ባና ቁንኣን ማኬዳዌ፥ ቃይ ደረቱዋነ ዞዘቱዋካ ሚዛናን ልኬዳዌ ኦኔ? <verse eid="ISA 40:12"/><verse number="13" style="v" sid="ISA 40:13"/>መና ጎዳ አያና አዛዜዳዌ፥ ዎይ አ ዞርያዋ ግዲደ ታማርሴዳዌ ኦኔ?<note caller="-" style="x"><char style="xo" closed="false">40:13 </char><char style="xt" closed="false"><ref loc="ROM 11:34">ሮመ 11:34</ref>፤ <ref loc="1CO 2:16">1 ቆሮ. 2:16</ref></char></note> <verse eid="ISA 40:13"/><verse number="14" style="v" sid="ISA 40:14"/>እ ባረዉ ቆንጫናዳን፥ መና ጎዳይ ኦናና ዞረቴዴ? ዎይ አ ሱረ ፕርዳ ኦግያ ታማርሴዳዌ ኦኔ? ዎይ አ አዳ ኤራተ ታማርሴዳዌ ዎይ አ አኬካ ኦግያ በሴዳዌ ኦኔ?<verse eid="ISA 40:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 40:15"/>በእተ፥ ካዉተቱ ባሬታ ግዶን ደእያ እት ጾክያ ሃ ማላ። ኡንቱንቱ ሚዛናን ደእያ ጉ ባናዳን ፓይደቴድኖ። በእተ እ ዳጋቴዳ ሃካ ሊቆ ባናዳን ማዛኔ። <verse eid="ISA 40:15"/><verse number="16" style="v" sid="ISA 40:16"/>ሊባኖሳ ምይ አዉ ኤናዉ ግደና፤ አን ደእያ ዶአቱካ ጹግያ ያርሾ ግድክኖ። <verse eid="ISA 40:16"/><verse number="17" style="v" sid="ISA 40:17"/>ካዉተቱ ኡባይ አ ስንን ባይናዋ ማላ፤ ኡንቱንቱ አ ስንን ኡባ ባይናባፐካ ጉዳን ፓይደቲኖ።<verse eid="ISA 40:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 40:18"/>ያትና፥ ጾሳ ህንተ ኦናና ማላትሲቴ?<note caller="-" style="x"><char style="xo" closed="false">40:18-19 </char><char style="xt" closed="false"><ref loc="ACT 17:29">ኪታ 17:29</ref></char></note> ዎይ አይ ምስለቱዋና ልኪ ጼሊቴ? <verse eid="ISA 40:18"/><verse number="19" style="v" sid="ISA 40:19"/>ኤቃ ምስልያ ግዶፐ፥ ኩሽያ ሂላ ኤርያ አሳይ አ ማሴ፤ ሄዋ ቃይ ዎርቃ ትግያዌ ዎርቃን ሼሼ፤ ብራ ትግያዌካ አ ቦላ ብራ ሳንሳላታ መ። <verse eid="ISA 40:19"/><verse number="20" style="v" sid="ISA 40:20"/>ሄዎ ሻሉ ባይና ህዬሳይ ያርሾ ዎቀና ም ዶሬ፤ ያቲደ፥ ሄ ምስሊ ቃጸናዳን ኤሳናዉ ኩሽያ ሂላ ኤርያ አሳ ኮዬ።<verse eid="ISA 40:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 40:21"/>ኤርበይክቴ? ዎይ ስስበይክቴ? ሀዌ ህንተንቶ ኮይሮፐ ኦደትቤኔ? ዎይ ሳአይ መቶደፐ ሀዋ ህንተ አኬክበይክቴ? <verse eid="ISA 40:21"/><verse number="22" style="v" sid="ISA 40:22"/>እ ቢታ ዩሹዋፐ ቦላ ባጋን ባረ አራታን ኡቴ፤ ጋድያን ደእያዋንቱ አ ስንን ቡምቡረ ማላ። ሳሎቱዋ ጋርዱዋዳን ፕድ ኦያዌ፥ ቃይ ደኢያሳ ኦደ፥ ዱንካንያዳን ቶልያዌ፥ <verse eid="ISA 40:22"/><verse number="23" style="v" sid="ISA 40:23"/>ካፓቱዋ ባይናባዳን ኦያዌ፥ ቢታ ካለያዋንታካ ሀዳ ኦያዌ አ። <verse eid="ISA 40:23"/><verse number="24" style="v" sid="ISA 40:24"/>ብሮ ኡንቱንቱ ቶከቶሳናነ ዘረቶሳና፥ ቃይ ጻጱዋካ ብሮ ጋድያን የዶሳና፥ ጾሳይ ኡንቱንቱ ቦላ ጫርኩዋ የድ አጌዳ፤ ኡንቱንቱካ መሌድኖ፤ ጎቲ ኡንቱንታ ሱላዳን አፌዳ።<verse eid="ISA 40:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 40:25"/>ጌሻይ ኡንቱንታ፥ “ያትና፥ ታን አናና ልከታናዉ ታና ኦናና ማላትሲቴ?” ያጌ። <verse eid="ISA 40:25"/><verse number="26" style="v" sid="ISA 40:26"/>ህንተ አይፍያ ቁ ኦደ፥ ሳሉዋ ጼልተ፤ ሄ ጾልንተቱዋ መዳዌ ኦኔ? እ ኡንቱንታ ኦላንቻዳን ካለ፤ ኡንቱንቱ ፓይዱዋካ ኤሬ። እ ኡንቱንታ ኡባካ ኡንቱንቱ ሱንን ሱንን ጼሴ። አ አንጋ ግታተፐነ አ ዎልቃ ምኖተፐ ደንዴዳዋን፥ ኡንቱንቱፐ እቱነ የና።<verse eid="ISA 40:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ISA 40:27"/>ኔኖ ያቆባ፥ ነኖ እስራኤልያዉ፥ “ታ ኦጊ መና ጎዳፐ ጌሜዳ፤ ጾሳይ ታ ፕርዳ ሸነኮ ጌዳ” ያጋ አያዉ አማሳላይ? ቃይ አያዉ ሀዋዳን ሃሳያይ? <verse eid="ISA 40:27"/><verse number="28" style="v" sid="ISA 40:28"/>ኤራበይኪ? ስሳበይኪ? መና ጎዳይ መና ጾሳ፤ እ ቢታ ኡባካ መዳዋ። እ ዳቡረና፤ ዎይ ዎልቃይ አዉ ዉረና፤ ኦንነ አ ቆፋ ኤራናዉ ዳንዳየና። <verse eid="ISA 40:28"/><verse number="29" style="v" sid="ISA 40:29"/>ዳቡራንቻዉ ዎልቃ እሜ፤ ምኖተይ ባይናዎካ ምኖተ ጉጄ። <verse eid="ISA 40:29"/><verse number="30" style="v" sid="ISA 40:30"/>ሀራይ አቶ ያላጋ ናናይካ ዳቡሪኖ፤ ቃይ ዎልቃ ዉሪኖ። ዎዳላቱካ ኡባና ዳቡሪደ ኩንዲኖ። <verse eid="ISA 40:30"/><verse number="31" style="v" sid="ISA 40:31"/>ሽን መና ጎዳ አማነቲደ ናግያዋንቱ፥ ባረንቱ ዎልቃ ኦራና። ኡንቱንቱ አርጋንቱዋዳን፥ ቀፍያን ፑደ ከሳና፤ ዎጺደ ዳቡርክኖ፤ ሀመቲደካ ዎልቃ ዉርክኖ።<verse eid="ISA 40:31"/></para>
  <chapter eid="ISA 40"/>
  <chapter number="41" style="c" sid="ISA 41"/>
  <para style="s1">እስራኤልያዉ ጾሳ ማዱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 41:1"/>ጾሳይ ሀዋዳን ያጌ፤ “ህንተኖ አባ ዶናን ደእያ ቢታቶ፥ ጮኡ ጊደ፥ ታን ኦድያዋ ስስተ! አሳይ ባረንቱ ምኖተ ኦራጽስኖ፤ ኡንቱንቱ ሃ ሺቂደ ሃሳዪኖ። አነ ኑን ፕርደታናዉ እትፐ ሺቆይተ።<verse eid="ISA 41:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 41:2"/>“ብያሳ ኡባን ጾንያ እቱዋ አዋይ ዶልያ ባጋፐ ደንዳዌ ኦኔ? እ ካዉተቱዋ አ ስንን አደ እሜ፤ ያትና፥ እ ካተቱዋ ገድያፐ ጋርሳና የ። እ ኡንቱንታ ባረ ማሻን ባናዳን ኦ፤ ቃይ ባረ ዎንዳፍያን ሱላዳን ኦ። <verse eid="ISA 41:2"/><verse number="3" style="v" sid="ISA 41:3"/>እ ኡንቱንታ የደርሲደ፥ አ ገዲ ካሰ የቤና ኦግያናካ ሳሮ አ። <verse eid="ISA 41:3"/><verse number="4" style="v" sid="ISA 41:4"/>ሀዋ ኦዳዌነ ፖሌዳዌ ቃይ የለታቱዋካ ኮይሮፐ ጼሴዳዌ ኦኔ? ታን መና ጎዳይ፥ ኮይሩ፥ ዉርሰዋንቱናካ ደእያዌ፥ ታን አ” ያጌ። <verse eid="ISA 41:4"/><verse number="5" style="v" sid="ISA 41:5"/>አባ ዶናን ደእያ ቢታቱ በኢደ ያዬድኖ፤ ሳኣ ጋጻቱካ ኮኮሬድኖ። ኡንቱንቱ እትፐ ሺቂደ፥ ታኮ ዬድኖ። <verse eid="ISA 41:5"/><verse number="6" style="v" sid="ISA 41:6"/>አሳ ኡባይ ባረ ሾሩዋ ሾሩዋ ማዴ፤ ቃይ ባረ እሻ፥ “ምና” ያጌ። <verse eid="ISA 41:6"/><verse number="7" style="v" sid="ISA 41:7"/>ኩሽያ ሂላንቻይ ዎርቃ ትግያዋ ምን፤ ማዶሻን ሌእስያዌ ባቻን ብራታ ሴርስያዋ፥ “ምና” ያጌ። እ ብራታ እትፐ ጋያዋ፥ “ሀዌ ሎአ” ያጌ፤ ቃይ ሄ ኤቃይ ቃጸናዳን፥ ኡንቱንቱ ምስማርያን ጊኖ።<verse eid="ISA 41:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 41:8"/>ጾሳይ ሀዋዳን ያጌ፥ “ሽን ነኖ እስራኤልያዉ፥ ታ ቆማዉ፥<note caller="-" style="x"><char style="xo" closed="false">41:8 </char><char style="xt" closed="false"><ref loc="2CH 20:7">2 ኦዱዋ 20:7</ref>፤ <ref loc="JAS 2:23">ያቆባ 2:23</ref></char></note> ታን ዶሬዳ ያቆባ፥ ታ ዳቡዋ አብራሃማ ዛርያዉ፥ <verse eid="ISA 41:8"/><verse number="9" style="v" sid="ISA 41:9"/>ታን ኔና ቢታ ጋጻፐ አካደ፥ ቃይ ዉርሰ ሃኮ ሳፐ ጼሳደ፥ ‘ኔን ታ ቆማ’ ያጌዳዎ፥ ታን ኔና ዶራድ፤ ቃይ ታን ኔና ኦልከ። <verse eid="ISA 41:9"/><verse number="10" style="v" sid="ISA 41:10"/>ታን ኔናና ደእያ ድራዉ ያዮፓ፤ ታን ነ ጾሳ ግድያ ድራዉ ዳጋሞፓ። ታን ኔና ምንሳና፤ ቃይ ታን ኔና ማዳና። ታን ኔና ታ ጾንያ ኡሸቻ ኩሽያን ዘምፕሳደ ኦይቃና።<verse eid="ISA 41:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 41:11"/>“በአ፥ ኔና ሀንቀትያ ኡባይ ዬላቲደ ካዉሻና፤ ኔናና ኤቀትያዋንቱ ካሰካ ባይናዋዳን ሀኒደ ያና። <verse eid="ISA 41:11"/><verse number="12" style="v" sid="ISA 41:12"/>ኔናና ዋላቀትያዋንታ ኔን ኮያና፤ ሽን ኔን ኡንቱንታ ደማካ። ኔናና ኦለትያዋንቱ ካሰካ ባይናባዳን፥ ሹፉሮ ግዲደ ያና። <verse eid="ISA 41:12"/><verse number="13" style="v" sid="ISA 41:13"/>አያዉ ጎፐ፥ ታን መና ጎዳይ፥ ነ ጾሳይ፥ ነ ኡሸቻ ኩሽያ ኦይቃና። ኔና፥ ‘ያዮፓ፥ ታን ኔና ማዳና። <verse eid="ISA 41:13"/><verse number="14" style="v" sid="ISA 41:14"/>ኔኖ ጉጹንያዉ፥ ያቆባ፥ ህንተኖ እስራኤልያ አሳዉ፥ ያዮፕተ፤ ታን ህንተና ማዳና። መና ጎዳይ፥ ህንተና ዎዝያዌ፥ እስራኤልያ ጌሻ’ ያጋይ። <verse eid="ISA 41:14"/><verse number="15" style="v" sid="ISA 41:15"/>በአ፥ ታን ኔና ኦራ፥ ቃራነ አቻና ደእያ፥ ቆጻናዉ ጎኤትያ ሚሻ ኦድ። ኔን ደረቱዋ ቆጻደ ሊቅሳና፤ ዞዘቱዋካ ሱላዳን ኦና። <verse eid="ISA 41:15"/><verse number="16" style="v" sid="ISA 41:16"/>ኔን ኡንቱንታ ፑናና፤ ጫርኩ ኡንቱንታ አፋና፤ ጎቲካ ኡንቱንታ ላላና። ሽን ኔን መና ጎዳን ናሸታና፤ ቃይ እስራኤልያ ጌሻን ቦንቼታና።<verse eid="ISA 41:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 41:17"/>“ህዬሳቱነ መቶታንቻቱ ሃ ኮይና ኡንቱንቶ ይያ ዎደ፥ ቃይ ኡንቱንቱ ኮኪካ ሳሙዋን መልያ ዎደ፥ ታን መና ጎዳይ ኡንቱንታ ስሳና፤ ታን፥ እስራኤልያ ጾሳይ ኡንቱንታ አግከ። <verse eid="ISA 41:17"/><verse number="18" style="v" sid="ISA 41:18"/>ታን መላ ቃ ሳአቱዋን ሻፋ፥ ቃይ ዎምባቱዋ ግዶንካ ፑልቱዋ ሳና። መላ ቢታይ ሃይ ኤልያሳ፥ ቃይ መላ ቢታካ ሃይ ቂያሳ ኦና። <verse eid="ISA 41:18"/><verse number="19" style="v" sid="ISA 41:19"/>ባዙዋን ዝጋነ ጉጋን፥ ባርሴነትያነ ዛይትያ ዎጋራ ዶልሳና። ቃይካ ባዙዋን ጽድያ፥ ኦዶሩዋነ ዎጋራ እትፐ ዎና ያጌ። <verse eid="ISA 41:19"/><verse number="20" style="v" sid="ISA 41:20"/>እስራኤልያ ጌሻይ ሄዋ መዳዋ፥ ቃይ መና ጎዳ ኩሺ ሄዋ ኦዳዋ አሳይ በአናነ ኤራና ማላ፥ ቃይ ቆፓናነ እትፐካ አኬካና ማላ፥ ታን ሄዋ ኦድ።<verse eid="ISA 41:20"/></para>
  <para style="s1">ጾሳይ ዎርዶ ጾሳቱዋ እጼ</para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 41:21"/>“መና ጎዳይ፥ ‘አነ ህንተ ሞቱዋ ሃ አተ’ ያጌ። ያቆባ ካቲ፥ ‘አነ ህንተ ጋሱዋካ ሃ አህተ’ ያጌ። <verse eid="ISA 41:21"/><verse number="22" style="v" sid="ISA 41:22"/>አነ ኡንቱንቱ ባረንቱ ምስለቱዋ ሃ አይና፥ አያይ ሀናናዉ ደእንቶ፥ ኡንቱንቱ ምስለቱ ኑዉ ኦድኖ። ኑን አኬካና ማላነ ኡንቱንቱ ዉርሰካ ኤራና ማላ፥ ካሰ የዎቱ አየንቶ ኑዉ ኦድተ፤ ዎይ ቃይ ስንፐ ትምቢትያ ኑዉ አዋይተ። <verse eid="ISA 41:22"/><verse number="23" style="v" sid="ISA 41:23"/>ህንተ ጾሳቱዋ ግድያዋ ኑን ኤራና ማላ፥ ስንፐ ያናዉ ደእያዋ ኑዉ ኦድተ። ኑን ዳጋማና ማላነ ያያና ማላ፥ ሎኦ ግድና ኢታ ግድና፥ አነ እትባ ኦተ። <verse eid="ISA 41:23"/><verse number="24" style="v" sid="ISA 41:24"/>በእተ፥ ህንተ ባይናዋ ማላ፤ ህንተ ኦሱካ ሀዳ። ህንተና ዶርያ አሳይካ ባረዉ ሸነይያዋ።<verse eid="ISA 41:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 41:25"/>“ታን ሁጲሳ ባጋፐ እቱዋ ደንድ፤ እ ዬዳ። ቃይ ታ ሱን ጼስያ እቱ አዋይ ዶልያ ባጋፐ ያና። ኡርቃ መያዌ ኡርቃ የያዋዳን፥ እ ካለያዋንታ የና።<verse eid="ISA 41:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ISA 41:26"/>“ሀዋ ኑን ኤራና ማላ፥ ኮይሮ ኑዉ አዋዬዳዌ ኦኔ? ዎይ ኑን፥ ‘እ ልከ’ ጋና ማላ፥ ካሰቲደ ኑዉ ኦዴዳዌ ኦኔ? ኦንነ ሀዋ ኦዴዳዌ ባዋ፤ ኦንነ ትምቢትያ ኦድቤና። ቃይ ህንተ ቃላካ ስሴዳዌ ባዋ። <verse eid="ISA 41:26"/><verse number="27" style="v" sid="ISA 41:27"/>ታን ሀዋ ካሰታደ ጽዮንዉ አዋያድ፤ ቃይ ታን የሩሳላመዉካ ምሽራቹዋ ኦድያዋ እማድ። <verse eid="ISA 41:27"/><verse number="28" style="v" sid="ISA 41:28"/>ሽን ታን ጼሌዳ ዎደ እቱነ ባዋ፤ ታን ዞርያ ኦችያ ዎደ፥ ኡንቱንቱ ምስለቱዋ ግዶን ዛሩዋ እምያ እቱነ ባዋ። <verse eid="ISA 41:28"/><verse number="29" style="v" sid="ISA 41:29"/>በእተ፥ ኡንቱንቱ ኡባይካ ሀዳ፤ ኡንቱንቱ ኦሱካ መላ፤ ሲልሲደ መዳ ኡንቱንቱ ምስለቱ መላ ጫርኩዋ” ያጌ።<verse eid="ISA 41:29"/></para>
  <chapter eid="ISA 41"/>
  <chapter number="42" style="c" sid="ISA 42"/>
  <para style="s1">መና ጎዳ ቆማ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 42:1"/>ታን ዘምፕሳደ ኦይኬዳ ታ ቆማይ፥ ታ ሸምፑ አን ናሸትያዌ፥ ታን ዶሬዳዌ ሀዎኮ። ታን ታ አያና አ ቦላ ዎድ፤ እ ካዉተቶ ሱረ ፕርዳ አሀና።<note caller="-" style="x"><char style="xo" closed="false">42:1 </char><char style="xt" closed="false"><ref loc="MAT 3:17">ማቶሳ 3:17</ref>፤ <ref loc="MAT 17:5">17:5</ref>፤ <ref loc="MRK 1:11">ማር. 1:11</ref>፤ <ref loc="LUK 3:22">ሉቃሳ 3:22</ref>፤ <ref loc="LUK 9:35">9:35</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">42:1-4 </char><char style="xt" closed="false"><ref loc="MAT 12:18-21">ማቶሳ 12:18-21</ref></char></note> <verse eid="ISA 42:1"/><verse number="2" style="v" sid="ISA 42:2"/>እ ዋሰና፤ ዎይ ባረ ቃላ ቂሰና፤ ዎይ ቃይ ባረ ቃላ ኦግያን ስሰና። <verse eid="ISA 42:2"/><verse number="3" style="v" sid="ISA 42:3"/>ትንጨቴዳ ሾምቦቁዋ እ መንና፤ ቃይ ሊአካቲደ ኤጽያ ሙቃዳካ እ ቶይሰና። እ አማነቲደ፥ ሱረ ፕርዳ አሀና። <verse eid="ISA 42:3"/><verse number="4" style="v" sid="ISA 42:4"/>እ ቢታን ሱረ ፕርዳ ኤሰናን ደኢደ አገና፤ ዎይ ጉየ ጌና። አባ ዶና ቢታቱዋን ደእያ አሳይ ኡባይ አ ህግያ ስሳናዉ ናጌ።<verse eid="ISA 42:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 42:5"/>ጾሳይ መና ጎዳይ፥ ሳሎቱዋ መደ ምጬዳዌ፥<note caller="-" style="x"><char style="xo" closed="false">42:5 </char><char style="xt" closed="false"><ref loc="ACT 17:24-25">ኪታ 17:24-25</ref></char></note> ሳኣነ ሳኣፐ ከስያዋ ኡባ ኦዳዌ፥ ሳኣን ደእያ አሳዉ ሸምፑዋ እምያዌ፥ አን ሀመትያ ኡባዉ ደኡዋ እምያዌ ሀዋዳን ያጌ፤ <verse eid="ISA 42:5"/><verse number="6" style="v" sid="ISA 42:6"/>“ታን መና ጎዳ፤ ታን ኔና ጽሎተን ጼሳድ፤ ታን ነ ኩሽያ ኦይቃደ፥<note caller="-" style="x"><char style="xo" closed="false">42:6 </char><char style="xt" closed="false"><ref loc="ISA 49:6">ኢሳ. 49:6</ref>፤ <ref loc="LUK 2:32">ሉቃሳ 2:32</ref>፤ <ref loc="ACT 13:47">ኪታ 13:47</ref>፤ <ref loc="ACT 26:23">26:23</ref></char></note> ኔና ናጋና። ታን ኔና ካዉተቶ ፖኦ ኦደ፥ ቃይ አሳዉካ ጫቁዋ ኦደ እማና። <verse eid="ISA 42:6"/><verse number="7" style="v" sid="ISA 42:7"/>ኔን ቆቅያ አይፍያ ዶያና ማላ፥ ኦሞደቴዳዋንታ ኦሞዱዋ ጎልያፐ ከሳና ማላ፥ ማን ደእያዋንታካ ቃሾ ጎልያፐ ከሳና ማላ፥ <verse eid="ISA 42:7"/><verse number="8" style="v" sid="ISA 42:8"/>ታን መና ጎዳ፤ ሄዌ ታ ሱን። ታ ቦንቹዋ ታን ሀራዉ እምከ፤ ታ ጋላታካ ማሰቲደ ጊጌዳ ምስለቶ እምከ። <verse eid="ISA 42:8"/><verse number="9" style="v" sid="ISA 42:9"/>በእተ፥ ካሰ ታን ኦዴዳዋንቱ ኡባይ ፖለቴድኖ። ሀእ ቃይ ታን ኦራባ አዋያይ፤ ኡንቱንቱ ሀናናፐ ካሰታደ ታን ህንተንቶ ኦዳይ” ያጌ።<verse eid="ISA 42:9"/></para>
  <para style="s1">ጋላታ የ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 42:10"/>መና ጎዳዉ ኦራ ማዝሙርያ የጽተ፤</para>
  <para style="q2" vid="ISA 42:10">ቢታ ጋጻፐ ዶሚደ፥ አ ጋላታ ኦድተ።</para>
  <para style="q1" vid="ISA 42:10">አባ ቦላን ብያዋንቱነ፥</para>
  <para style="q2" vid="ISA 42:10">አን ኩሜዳ ኡባይካ አነ ዋስኖ።</para>
  <para style="q1" vid="ISA 42:10">አባ ዶና ቢታቱነ ኡንቱንቱን ደእያ ኡባይካ የጽኖ።<verse eid="ISA 42:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 42:11"/>መላ ቢታይነ ባዙዋን ደእያ ካታማቱ፥</para>
  <para style="q2" vid="ISA 42:11">ቃይ ቄዳረ አሳይ ደእያ ሞቱካ፥</para>
  <para style="q2" vid="ISA 42:11">ባረንቱ ቃላ ቁ ኦኖ።</para>
  <para style="q2" vid="ISA 42:11">ሰላአ ግያ ካታማን ደእያዋንቱካ፥</para>
  <para style="q2" vid="ISA 42:11">ደርያ ሁጲያፐ ባረንቱ እልልሳ ስስኖ።<verse eid="ISA 42:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 42:12"/>ኡንቱንቱ ቦንቹዋ መና ጎዳዉ እምኖ፤</para>
  <para style="q2" vid="ISA 42:12">አ ጋላታካ ጋጻ ቢታቱዋን አዋይኖ።<verse eid="ISA 42:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 42:13"/>መና ጎዳይ ምኖ አሳዳን ከሳና፤</para>
  <para style="q2" vid="ISA 42:13">ኦላንቻ አሳዳን፥ እ ባረ ሀንቁዋ ደንና።</para>
  <para style="q1" vid="ISA 42:13">እ ዋሳና፤ ባረ ቃላካ ቁ ኦደ አዋያና።</para>
  <para style="q2" vid="ISA 42:13">እ ምኖ ግድያዋ ባረ ሞርከቱዋ በሳና።<verse eid="ISA 42:13"/></para>
  <para style="s1">ጾሳይ ባረ አሳ ማዳናዉ ቃላ ገሌዳ</para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 42:14"/>ጾሳይ ሀዋዳን ያጌ፤</para>
  <para style="q2" vid="ISA 42:14">“አዱሳ ዎድያፐ ታን ሳሩዋን ታካድ፤</para>
  <para style="q2" vid="ISA 42:14">ጮኡ ጋደ ዳንዳያድ።</para>
  <para style="q2" vid="ISA 42:14">ሀእ የሉ ኦይኬዳ ምሽራቲዳን፥</para>
  <para style="q2" vid="ISA 42:14">ታን ዋሳና፤</para>
  <para style="q2" vid="ISA 42:14">ቶካ ቶካደ ሸምፓናነ ፔኑቃና።<verse eid="ISA 42:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 42:15"/>ታን ደረቱዋነ ዞዘቱዋ ላላና፤</para>
  <para style="q2" vid="ISA 42:15">ኡንቱንቱን ሞኬዳዋ ኡባ መልሳና።</para>
  <para style="q1" vid="ISA 42:15">ሻፋቱዋ መላ ከሳና፤</para>
  <para style="q2" vid="ISA 42:15">ደልኤቱዋካ መልሳና።<verse eid="ISA 42:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 42:16"/>“ታን ቆቀቱዋ ኡንቱንቱ ኤረና ኦግያና አሀና፤</para>
  <para style="q2" vid="ISA 42:16">ኡንቱንቱ ኤረና ሎሱዋናካ ካለና።</para>
  <para style="q1" vid="ISA 42:16">ኡንቱንቱ ስንን ደእያ ማ ፖኦ ላማና፤</para>
  <para style="q2" vid="ISA 42:16">ኮርጱኮርጳ ሳኣካ ሳላልሳና።</para>
  <para style="q1" vid="ISA 42:16">ሄዋንታ ታን ኡንቱንቶ ኦና፤</para>
  <para style="q2" vid="ISA 42:16">ታን ጌዳ ሀ የዎቱዋ ኦናን አግከ።<verse eid="ISA 42:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 42:17"/>ሽን ማሲደ ጊግሴዳ ምስለቱዋን አማነትያዋንቱ፥</para>
  <para style="q2" vid="ISA 42:17">ቃይ ሲልሲደ ጊግሴዳ ምስለቱዋ፥</para>
  <para style="q1" vid="ISA 42:17">‘ህንተ ኑ ጾሳቱዋ’ ያግያዋንቱ፥</para>
  <para style="q2" vid="ISA 42:17">ጉየ ስማና።</para>
  <para style="q1" vid="ISA 42:17">ኡንቱንቱ ሙለ ዬላታና”</para>
  <para style="m" vid="ISA 42:17">ያጌ።<verse eid="ISA 42:17"/></para>
  <para style="s1">እስራኤልያ አሳይ ታማረናን እጼዳ እጹዋ</para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 42:18"/>ጾሳይ ሀዋዳን ያጌ፤ “ህንተኖ ቱለቶ፥ ስስተ፤ ህንተኖ ቆቀቶ፥ ህንተ በአና ማላ ጼልተ። <verse eid="ISA 42:18"/><verse number="19" style="v" sid="ISA 42:19"/>ታ ቆማፐ ሀራ ቆቂ ኦኔ? ታን ኪትያ ኡራፐ ሀራ ቱሊ ኦኔ? ጾሳዉ ዱማቴዳ ኡራዳን፥ ዎይ መና ጎዳ ቆማዳን ቆቃይ ኦኔ? <verse eid="ISA 42:19"/><verse number="20" style="v" sid="ISA 42:20"/>ዳሮባ ጼሊታ፤ ሽን አኬክክታ። ህንተንቱ ሀይቱካ ዶያ፤ ሽን ስስክኖ” ያጌ።<verse eid="ISA 42:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 42:21"/>መና ጎዳይ ባረ ጽሎተ ድራዉ፥ ባረ ህግያ ግታያናዉነ ቦንቻናዉ ዶሴዳ። <verse eid="ISA 42:21"/><verse number="22" style="v" sid="ISA 42:22"/>ሽን ሀዌ አሳይ ቦንቀቴዳነ ዎ አከቴዳ። ኡንቱንቱ ኡባይካ ዲዛን ኦይቀቲደ፥ ቃሾ ጎልያን ቆሰቴድኖ። ኡንቱንቱ ቦንቀቴድኖ፤ ሽን ኡንቱንታ አሽያዌ ባዋ። ቃይ ኦሞደቴድኖ፤ ሽን ኦንነ፥ “ዛርተ” ያግያዌ ባዋ።<verse eid="ISA 42:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 42:23"/>ህንተ ግዶፐ ሀዋ ስሳናዌ ኦኔ? ቃይ ስንፐ ያና ዎድያባ ሀይዛናዌ ኦኔ? <verse eid="ISA 42:23"/><verse number="24" style="v" sid="ISA 42:24"/>ያቆባ ኦሞድያዎ፥ እስራኤልያ ቦንቂያዎ አደ እሜዳዌ ኦኔ? አ ቦላን ኑን ናጋራ ኦዳ፥ አ ኦግያን ኡንቱንቱ ቤናን እጼዳነ አ ህግያዉካ ኡንቱንቱ አዛዘተናን እጼዳ መና ጎዳ ግደኔየ? <verse eid="ISA 42:24"/><verse number="25" style="v" sid="ISA 42:25"/>ሄዋ ድራዉ፥ እ ኡንቱንቱ ቦላ ባረ ሀንቁዋ ሱሉዋነ ያሽያ ኦላ ጉሴዳ፤ እ ኡንቱንቱ ዩሹዋን ታማ ኤዳ፥ ሽን ኡንቱንታ ኤርበይክኖ፤ እ ኡንቱንቱ ጹጌዳ፤ ሽን ኡንቱንቱ አኬክበይክኖ።<verse eid="ISA 42:25"/></para>
  <chapter eid="ISA 42"/>
  <chapter number="43" style="c" sid="ISA 43"/>
  <para style="s1">ጾሳይ ባረ አሳ አሻና ጌዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 43:1"/>ሽን ነኖ ያቆባ ኔና መዳዎ፥ ነኖ እስራኤልያዉ፥ ኔና ጊግሴዳ መና ጎዳይ ሀዋዳን ያጌ፤ “ታን ኔና ዎዜዳ ድራዉ ያዮፓ። ታን ኔና ነ ሱንን ጼሳድ፤ ኔን ታዋ። <verse eid="ISA 43:1"/><verse number="2" style="v" sid="ISA 43:2"/>ኔን ሃ ግዱዋና ፕንያ ዎደ፥ ታን ኔናና ግዳና። ኔን ሻፋቱዋ ግዱዋና ፕንያ ዎደካ ኡንቱንቱ ኔና ሙክክኖ። ኔን ታማ ግዶና አያ ዎደ፥ ጹገታካ፤ ላጩካ ኔና ሜና። <verse eid="ISA 43:2"/><verse number="3" style="v" sid="ISA 43:3"/>አያዉ ጎፐ፥ ታን ኔና አሽያ እስራኤልያ ጌሻ፥ መና ጎዳ ነ ጾሳ። ታን ግብጼ ነዉ ዎዞ ኦደ፥ ቶጵያነ ሳባ ነ ላምያ ኦደ እማና። <verse eid="ISA 43:3"/><verse number="4" style="v" sid="ISA 43:4"/>ኔን ታ ስንን አልአነ ቦንቾ ግድያ ድራዉነ፥ ታንካ ኔና ሲቅያ ድራዉ፥ ነ ላምያዉ አሳ፥ ነ ሸምፑዋ ላምያዉካ ካዉተቱዋ እማና።<verse eid="ISA 43:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 43:5"/>“ታን ኔናና ደእያ ድራዉ ያዮፓ፤ ታን ነ ዘረቱዋ ዉላሃፐነ ዶላሃፐ ሺሻደ አሀና። <verse eid="ISA 43:5"/><verse number="6" style="v" sid="ISA 43:6"/>ታን ሁጲሳ ባጋ፥ ‘ኡንቱንታ ዛራደ አሀ!’ ያጋና። ገድሳ ባጋካ፥ ‘ኡንቱንታ ተኦፓ’ ያጋና። ታ አቱማ ናናቱዋ ሃኩዋፐ፥ ታ ማጫ ናናቱዋካ ሳኣ ጋጻፐ አሀና፤ <verse eid="ISA 43:6"/><verse number="7" style="v" sid="ISA 43:7"/>ታ ሱንን ጼገቴዳ ኡባቱዋ፥ ታን ታ ቦንቾ መዳዋንታ፥ ታን ጊግሴዳዋንታነ ኦዳዋንታ ሀምተ” ያጋና።<verse eid="ISA 43:7"/></para>
  <para style="s1">እስራኤሊ ጾሳ ማርካ</para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 43:8"/>አይፊ ደእሽን ቆቄዳ አሳቱዋ፥ ሀይይካ ደእሽን ቱሌዳዋንታ ከሳ፤ <verse eid="ISA 43:8"/><verse number="9" style="v" sid="ISA 43:9"/>ካዉተቱ ኡባይ እትፐ ሺቅኖ፤ አሳይካ ሺቁዋ ኡቶ። ኡንቱንቱ ግዶፐ ሀዋ ኦዳናዉነ ካሰ አዳ የዎቱዋ ኑና በሳናዉ ዳንዳይያዌ ኦኔ? ሀራ አሳይካ ስሲደ፥ “ሀዌ ቱማ” ያጋና ማላ፥ ኡንቱንቱ ልከ ግድያዋ በሳናዉ ባረንቱ ማርካቱዋ አይኖ።<verse eid="ISA 43:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 43:10"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ህንተ ታ ማርካቱዋ፤ ህንተ ታና ኤራና ማላነ አማናና ማላ፥ ቃይ ታን ጾሳ ግድያዋ አኬካና ማላ፥ ታን ዶሬዳ ታ ቆማቱ ህንተና። ታፐ ካሰ ሀራ ጾስ መትቤና፤ ዎይ ታፐ ጉይያንካ ሀራ ጾስ ደኤና።<verse eid="ISA 43:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 43:11"/>“ታናቴ፤ ታን መና ጎዳ። ታፐ አትና፥ ሀራ አሽያዌ ባዋ። <verse eid="ISA 43:11"/><verse number="12" style="v" sid="ISA 43:12"/>ታን ኦዳድ፥ አሻድነ አዋያድ። ህንተ ግዶን ሀራ አላጋ ጾስ ደእቤና። ታን መና ጎዳ ግድያዎ ታዉ ህንተ ማርካቱዋ። <verse eid="ISA 43:12"/><verse number="13" style="v" sid="ISA 43:13"/>ታን ጾሳ፤ ጻጱዋፐ ዶማደካ ታን ታናቴ። ታ ኩሽያፐ ኦንነ አሸና፤ ታን ኦዳዋ ላማናዉ ዳንዳይያዌ ባዋ” ያጌ።<verse eid="ISA 43:13"/></para>
  <para style="s1">መና ጎዳ ማሮታነ አማነተና እስራኤልያ</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 43:14"/>መና ጎዳይ፥ ህንተና ዎዝያዌ፥ እስራኤልያ ጌሻይ ሀዋዳን ያጌ፤ “ህንተ ድራዉ፥ ባብሎነ ቦላ ኦላንቻቱዋ ኪታደ ባብሎናቱዋ ኡንቱንቱ ጬቀትያ ማርካብያና በትሳና። <verse eid="ISA 43:14"/><verse number="15" style="v" sid="ISA 43:15"/>ታን መና ጎዳ፥ ህንተ ጌሻ፥ እስራኤልያ መዳዋ፥ ህንተ ካትያ” ያጌ።<verse eid="ISA 43:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 43:16"/>መና ጎዳይ ሀዋዳን ያጌ፥ አባ ግዶን ኦግያ፥ ዎልቃማ ሃቱዋ ግዶፐካ ሎሱዋ ከሲደ፥ <verse eid="ISA 43:16"/><verse number="17" style="v" sid="ISA 43:17"/>ፓራ ጋረቱዋነ ፓራቱዋ፥ ኦላንቻቱዋነ ምኖ አሳቱዋ አባዉ አሂደ፥ ኡንቱንቱ ደንደናዳን ዛቁልሴዳ መና ጎዳይ፥ ቃይ ኡንቱንቱ ሙቃዳ ላጩዋዳን ቶይሴዳ ያጌ <verse eid="ISA 43:17"/><verse number="18" style="v" sid="ISA 43:18"/>“ካሰ የዎቱዋ ሃሳዮፕተ፤ በንዋካ ቆፖፕተ። <verse eid="ISA 43:18"/><verse number="19" style="v" sid="ISA 43:19"/>በእተ፥ ሀእ ታን ኦራባ ኦይ፤ እካ ሀእ ሞኬ። ህንተ ሄዋ ኤርክቴየ? ታን ባዙዋን ኦግያ፥ መላ ቢታንካ ሻፋቱዋ ከሳና። <verse eid="ISA 43:19"/><verse number="20-21" style="v" sid="ISA 43:20-21"/>ዎራ ዶአቱ፥ ዎራካናቱነ ሳጎናቱ ታና ቦንቻና። አያዉ ጎፐ፥ ታ ጋላታ አዋያና ማላ፥ ታ ጊግሴዳነ ዶሬዳ ታ አሳዉ ታን ባዙዋን ሃ፥ መላ ቢታንካ ሻፋቱዋ እማይ።<verse eid="ISA 43:20-21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 43:22"/>“ሽን ነኖ ያቆባ፥ ኔን ታ ሱን ጼሳባካ፤ ነኖ እስራኤልያዉ፥ ኔንካ ታና ሳለታዳ። <verse eid="ISA 43:22"/><verse number="23" style="v" sid="ISA 43:23"/>ኔን ታዉ ጹግያ ያርሾ ዶርሳ አሀባካ፤ ዎይ ሀራ ያርሾቱዋንካ ታና ቦንቻበይካ። ታን ኔና ካ ያርሹዋ እማ ጋደ ዋይሳበይከ፤ ዎይ ቃይ እጻና እማ ጋደ ዳቡርሳበይከ። <verse eid="ISA 43:23"/><verse number="24" style="v" sid="ISA 43:24"/>ኔን ታዉ እጻና ሻሉዋን ሻማባካ፤ ዎይ ነ መህያ ያርሹዋ ሞዋን ታና ካልሳባካ። ሽን ኔን ነ ናጋራን ታና ዋይሳዳ፤ ነ ናቁዋንካ ታና ዳቡርሳዳ።<verse eid="ISA 43:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 43:25"/>“ታና፥ ነ ባይዙዋ ታ ድራዉ ጋደ ቁጭያዌ ታናቴ፤ ነ ናጋራካ ዛረደ ሃሳይከ። <verse eid="ISA 43:25"/><verse number="26" style="v" sid="ISA 43:26"/>ታና ሀሳይሳ፤ አነ እትፐ ሀ የዉዋ ሞተቶይተ። ኔን ጽሉዋ ግድያዋ በአናዉ አነ ነ የዉዋ ብዳ። <verse eid="ISA 43:26"/><verse number="27" style="v" sid="ISA 43:27"/>ነ ኮይሮ አዉ ናጋራ ኦዳ፤ ኔና ታማርስያዋንቱካ ታና ናቄድኖ። <verse eid="ISA 43:27"/><verse number="28" style="v" sid="ISA 43:28"/>ሄዋ ድራዉ፥ ታን ጌሻ ማቅዳስያ ካፓቱዋ ቱንሳድ፤ ያቆባ ባሻዉ፥ እስራኤልያካ ሸቃዉ አደ እማድ” ያጌ።<verse eid="ISA 43:28"/></para>
  <chapter eid="ISA 43"/>
  <chapter number="44" style="c" sid="ISA 44"/>
  <para style="s1">ጾሳይ ጾሳ ጻላላ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 44:1"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ታ ቆማዉ ያቆባ፥ ታን ዶሬዳ ይሽሩና፥ ሀእካ ስሳ። <verse eid="ISA 44:1"/><verse number="2" style="v" sid="ISA 44:2"/>ታን ኔና መድ፤ ነ ዳይ ኡሉዋን ኔና ጊግሳድነ ማዳድ። ታ ቆማ ያቆባ፥ ታን ዶሬዳዎ፥ ያዮፓ። <verse eid="ISA 44:2"/><verse number="3" style="v" sid="ISA 44:3"/>ታን ሳመቴዳ ጋድያን ሃ ጉሳና፤ መላ ቢታንካ ፑልቱዋ ጎግሳና። ታን ታ አያና ነ ናናቱ ቦላ፥ ታ አንጁዋካ ነ ዘረቱዋ ቦላ ጉሳና። <verse eid="ISA 44:3"/><verse number="4" style="v" sid="ISA 44:4"/>ሃ ዶናን ሞኬዳ ማታዳን፥ ቃይ ጎግያ ፑልቱዋ ማታን ደእያ ምዳን፥ ኡንቱንቱ ሞካና። <verse eid="ISA 44:4"/><verse number="5" style="v" sid="ISA 44:5"/>እቱ፥ ‘ታን መና ጎዳዋ’ ያጋና፤ ሀራይ ቃይ ባረና ያቆባ ሱንን ጼሳና፤ ሀራይካ፥ ቃይ ባረ ኩሽያ ቦላን፥ ‘ታን መና ጎዳዋ’ ያጊደ ጻፋና፤ እ ቃይ ባረና እስራኤሊ ጼሰትያ ሲቁዋ ሱንን ጼሳና” ያጌ።<verse eid="ISA 44:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 44:6"/>መና ጎዳይ፥ እስራኤልያ ካቲ፥ አ ዎዝያዌ፥<note caller="-" style="x"><char style="xo" closed="false">44:6 </char><char style="xt" closed="false"><ref loc="ISA 48:12">ኢሳ. 48:12</ref>፤ <ref loc="REV 1:17">ሳፃ 1:17</ref>፤ <ref loc="REV 22:13">22:13</ref></char></note> ኡባፐ ዎልቃማ መና ጎዳይ ሀዋዳን ያጌ፤ “ኮይሩ ታና፤ ዉርሰይካ ታና። ታፐ ሀራ ጾሳይ ባዋ። <verse eid="ISA 44:6"/><verse number="7" style="v" sid="ISA 44:7"/>ታ ማላይ ኦኔ? ደኦፐ አነ አዋዮ፤ ቃይ አነ ታ ስንን ኤቂደ ኦዶ። በንፐ ዶሚደ፥ ስንፐ ያናዋ ኦድያዌ ኦኔ? አነ ኡንቱንቱ ስንፐ ትምቢትያ ኑዉ ኦድኖ። <verse eid="ISA 44:7"/><verse number="8" style="v" sid="ISA 44:8"/>ያዮፕተ፤ ቃይ ዳጋሞፕተ። ታን ሀዋ ህንተንቶ በንፐ ዶማደ ኦዳበይክታ? ቃይ አዋያበይክታ? ሄዎ ታዉ ህንተ ማርካ። ታፐ አትና፥ ሀራ ጾሳይ ደኢ? ሀራ ዛል ባዋ፤ ታን ኦናነ ኤርከ” ያጌ።<verse eid="ISA 44:8"/></para>
  <para style="s1">ኤቃ ጎይኑዋ ቦላ ሃሳየቴዳ ቦረ ሃሳያ</para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 44:9"/>ኤቃ ምስለቱዋ ማሲደ መያ ኡባቱ ሀዳ፤ ኡንቱንቱ አን ናሸትያባቱ ኡንቱንታ ጎእክኖ። ኡንቱንቱ ማርካቱካ በእክኖነ ኤርክኖ። ሄዋ ድራዉ፥ ኡንቱንቱ ዬላታና። <verse eid="ISA 44:9"/><verse number="10" style="v" sid="ISA 44:10"/>ጾሳ ጊግሴዳዌ፥ ዎይ አያዉነ ጎኤና ምስልያ ማሴዳዌ ኦኔ? <verse eid="ISA 44:10"/><verse number="11" style="v" sid="ISA 44:11"/>በእተ፥ አ ላገቱ ኡባይ ዬላታና፤ ኩሽያ ሂላንቻቱ ኡባይ አሳ። አነ ኡንቱንቱ ኡባይካ እትፐ ሺቂደ ኤቂኖ። ኡንቱንቱ ያያና፤ ቃይ ኡንቱንቱ ኡባይካ እትፐ ዬላታና።<verse eid="ISA 44:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 44:12"/>ብራታ ቆጽያዌ ባረ ቡክያ ብራታ ታማን ዎ፤ ቦንቄዳዋ ባቻን ቆጺደ፥ ባረ ምኖ ቀስያን አ መታ ጊግሴ። ሄዋ ጊግሲደ ኮሻቴ፤ አ ምኖተይካ ዉሬ። ሃካ ኡሸና፤ ላባኔ።<verse eid="ISA 44:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 44:13"/>አናጺ ዎዶሩዋን ልኬ፤ እርሳስያን አ ቦላ ማላታ ዎ፤ ያቲደ ማሎግያን ልልእሴ። ልኪደ፥ ፑላና ደእያ አሳ ምስልያ ማላትስ ጊግሲደ፥ ባረ ሶን ዎ። <verse eid="ISA 44:13"/><verse number="14" style="v" sid="ISA 44:14"/>እ ሄዋ ኦናዉ ዝጋ ቃንጼ፤ ዎይ ዎላ ዎይ ጽድያ ዎራ ግዶፐ ዶሪደ ድጫናዳን ኦ። ዎይ እጾፐ፥ እ ዝጋ ቶክና፥ እራይ አ ድቻናዉ ናጌ። <verse eid="ISA 44:14"/><verse number="15" style="v" sid="ISA 44:15"/>ሄዋፐ ጉይያን፥ እ አሳይ ኤያ ም ግዴ፤ እካ አፐ ባጋ አኪደ፥ ኤደ ሆኤ፤ ቃይ ባጋ ኤደ፥ ኡክ ኡኬ። አፐካ ጾሳ መደ፥ አዉ ጎይኔ፤ ቃይ ምስልያ ማሲደ፥ አ ስንን ጉፋኔ። <verse eid="ISA 44:15"/><verse number="16" style="v" sid="ISA 44:16"/>አፐ ባጋ ታማን ኤደ፥ ቁማ ካ፤ ባጋን አሹዋ ጺጺደ፥ ካሊደ ሜ። ቃይ ታማ ሆእ ስሚደ፥ “ሀሹ፥ ላ ሀዌ አያ ሆኢ!” ያጌ። <verse eid="ISA 44:16"/><verse number="17" style="v" sid="ISA 44:17"/>ቃይ አቴዳ ም ማሲደ፥ ባረዉ ጎይንያ ጾሳ ምስልያ ከሴ። ሄ ምስልያ ስንን ጉፋኒደ፥ አዉ ጎይኔ፤ ያቲደ፥ “ኔን ታ ጾሳ ግዴዳ ድራዉ፥ ታና አሻ” ያጊደ ዎሴ።<verse eid="ISA 44:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 44:18"/>ኡንቱንቱ አይነ ኤርክኖ፤ አይነካ አኬክክኖ። አያዉ ጎፐ፥ ኡንቱንቱ በኤና ማላ፥ ኡንቱንቱ አይፊ ጎዘቴዳ፤ ቃይ አኬከና ማላ፥ ኡንቱንቱ ዎዛናይካ ጎርደቴዳ። <verse eid="ISA 44:18"/><verse number="19" style="v" sid="ISA 44:19"/>ኤቃ ኦያ አሳይ ባረ ዎዛናን፥ “አፐ ባጋ ታማን ኤድ፤ አ ቦንቁዋንካ ኡክ ኡካድ፤ አሹዋካ አን ጺጻደ ማድ። ያትና፥ አፐ አቴዳዋ ሸነይያ ኤቃ ኦደ መ? ቃይ ም ሙዶ ጉፋናደ ጎይኖ?” ያግያ ኤር ዎይ አኬክ ኦስነ ባዋ። <verse eid="ISA 44:19"/><verse number="20" style="v" sid="ISA 44:20"/>እ ብድን ሜ፤ አ ጭመቴዳ ዎዛናይ አ ዎራ ካለዳ። እ ባረ ሸምፑዋ አሻናዉ ዎይ፥ “ታ ኡሸቻ ኩሽያን ደእያዌ ዎርዱዋ ግደኔ?” ጋናዉ ዳንዳየና።<verse eid="ISA 44:20"/></para>
  <para style="s1">ጾሳይ መዳዋነ አሽያዋ</para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 44:21"/>ጾሳይ ሀዋዳን ያጌ፤ “ያቆባ፥ ነኖ እስራኤልያዉ፥ ኔን ታ ቆማ ግድያ ድራዉ፥ ሀ የዎቱዋ ሀሳያ። ታን ኔና ጊግሳድ፤ ኔን ታ ቆማ። ኔኖ እስራኤልያዉ፥ ታን ኔና ዶግከ። <verse eid="ISA 44:21"/><verse number="22" style="v" sid="ISA 44:22"/>ታን ነ ባይዙዋ ሻርያዳን፥ ነ ናጋራካ ጫጋናዳን ቁጫድ። ታን ኔና ዎዜዳ ድራዉ፥ ታኮ ስማ” ያጌ።<verse eid="ISA 44:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 44:23"/>ህንተኖ ሳሎቶ፥ መና ጎዳይ ሀዋ ኦዳ ድራዉ፥ ናሸቻን የጽተ። ህንተኖ ቢታ ጪማቶ፥ እልልተ። ህንተኖ ደረቶ፥ ዎራዉነ አ ግዶን ደእያ ም ኡባዉ፥ ማዝሙርያ ክንችተ። አያዉ ጎፐ፥ መና ጎዳይ ያቆባ ዎዜዳ፤ ቃይ እስራኤልያ ግዶንካ እ ቦንቼታና።<verse eid="ISA 44:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 44:24"/>ኔና ዎዝያዌ፥ ዳይ ኡሉዋን ኔና መዳዌ መና ጎዳይ ሀዋዳን ያጌ፤ “ታን መና ጎዳ፥ ኡባ የዎቱዋ መዳዋ፤ ሳሎቱዋ ታረካ ምጬዳዌ፤ ሳኣካ ታረካ ምጬዳዌ ታና። <verse eid="ISA 44:24"/><verse number="25" style="v" sid="ISA 44:25"/>ታን ዎርዱዋ ትምቢትያ ኦድያዋንቱ ማላታ ሀዳ ኦይ፤<note caller="-" style="x"><char style="xo" closed="false">44:25 </char><char style="xt" closed="false"><ref loc="1CO 1:20">1 ቆሮ. 1:20</ref></char></note> ቃይ ሻሬቾቱዋካ ኤያ ከሳይ። ታን አዳ ኤራንቻቱዋ ጉየ ዛራይ፤ ኡንቱንቱ ኤራካ ኤያ ኦይ። <verse eid="ISA 44:25"/><verse number="26" style="v" sid="ISA 44:26"/>ታን ታ ቆማ ቃላ ምንይ፤ ታ ኪቴዳዋንቱ ሀናና ጌዳዋካ ፖላይ። ታን የሩሳላመ ካታማ፥ ‘ኔን አሳይ ደኢያሳ ግዳና’ ያጋይ፤ ይሁዳ ካታማቱዋካ፥ ‘ህንተ ስሚደ ኬጸታና፤ ህንተ ግምቢያካ ኦራጽሳና’ ያጋይ። <verse eid="ISA 44:26"/><verse number="27" style="v" sid="ISA 44:27"/>ታን ሃ ጪማቱዋካ፥ ‘መልተ! ህንተ ጎግያ ሃቱዋካ መልሳና’ ያጋይ። <verse eid="ISA 44:27"/><verse number="28" style="v" sid="ISA 44:28"/>ቃይ ቂሮሳ፥ ‘ኔን ታ አሳ ሄምያዋ፤<note caller="-" style="x"><char style="xo" closed="false">44:28 </char><char style="xt" closed="false"><ref loc="2CH 36:23">2 ኦዱዋ 36:23</ref>፤ <ref loc="EZR 1:2">እዝራ 1:2</ref></char></note> ኔን የሩሳላመ ካታማ፥ “ነ ስማደ ኬጸታና” ያጋደ፥ ጌሻ ጎልያካ፥ “ነ ባሱ ባሰታና” ያጋደ ታ ሀልቹዋ ፖልያዋ’ ያጋይ” ያጌ።<verse eid="ISA 44:28"/></para>
  <chapter eid="ISA 44"/>
  <chapter number="45" style="c" sid="ISA 45"/>
  <para style="s1">ጾሳይ ቂሮሳ ካትያ ከሳናዉ ዶሬዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 45:1"/>መና ጎዳይ ኦኬዳዎ፥ ካዉተቱዋ አዉ ሞድሳና ማላ፥ ካተቱ ዳንጩዋ ብላና ማላነ ፐንጊካ አዉ አ ስንን ዶየታና ማላ፥ አ ኡሸቻ ኩሽያ ኦይቄዳ ቂሮሳዉ ጾሳይ ሀዋዳን ያጌ፤ <verse eid="ISA 45:1"/><verse number="2" style="v" sid="ISA 45:2"/>“ታን ነ ስንና ባና፤ ደረቱዋ ደምባያና። ናሃስያ ብራታ ሳንቃቱዋ መንና፤ ብራታ ኩልቦቱዋካ ቃንጻና። <verse eid="ISA 45:2"/><verse number="3" style="v" sid="ISA 45:3"/>ኔና ነ ሱንን ጼስያዌ ታና መና ጎዳ፥ እስራኤልያ ጾሳ ግድያዋ ኔን ኤራና ማላ፥ ታን ነዉ ማ ሳኣን ደእያ አቁዋነ ጌማን ቆሰቲደ ዱረታ እማና። <verse eid="ISA 45:3"/><verse number="4" style="v" sid="ISA 45:4"/>ታ ቆማ ያቆባ ድራዉነ ታን ዶሬዳ እስራኤልያ ድራዉ፥ ታን ኔና ነ ሱንን ጼሳይ። ኔን ታና ኤራና ዮፐ፥ ታን ኔና ቦንቾ ሱንን ጼሳይ።<verse eid="ISA 45:4"/></para>
  <para style="p">
    <verse number="5-6" style="v" sid="ISA 45:5-6"/>“ታን መና ጎዳ፤ ታፐ ሀራይ ባዋ፤ ታፐ ሀራ ጾሳይ ደኤና። አዋይ ሞክያሳፐ ቢደ፥ ዉልያሳ ጋካናዉ ደእያ አሳይ ታፐ ሀራይ ባይናዋ ኤራና ማላ፥ ታን ኔና ግጽሳ። ግዶፐነ፥ ኔን ታና ኤራባካ። ታን መና ጎዳ፤ ታፐ ሀራይ ባዋ። <verse eid="ISA 45:5-6"/><verse number="7" style="v" sid="ISA 45:7"/>ታን ፖኡዋ ኦይ፤ ማካ መይ። ሳሮተ ኦይ፤ ባሻካ አያይ። ታን መና ጎዳይ፥ ሀ ኡባ የዎቱዋ ኦያዋ።<verse eid="ISA 45:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 45:8"/>“ህንተኖ ሳሎቶ፥ ቦላፐ ዱገ ጽሎተ ትግተ፤ ሻረቱካ አ ቡክኖ። ቢታይ ዶየቶ፤ አቶተይካ ፑደ ሞኮ። ጽሎተይካ አናና እትፐ ድጮ። ታን መና ጎዳይ ሀዋ መድ።<verse eid="ISA 45:8"/></para>
  <para style="s1">ጾሳይ መታዉነ ታርክያዉ ጎዳ</para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 45:9"/>“ባረና መዳዋና ባጸትያዎ አየ አና!<note caller="-" style="x"><char style="xo" closed="false">45:9 </char><char style="xt" closed="false"><ref loc="ROM 9:20">ሮመ 9:20</ref></char></note> አያዉ ጎፐ፥ እ ኡርቃ ሚሻፐ እቱዋ። ኡርቃይ መያዋ፥ ‘አይ ኦይ?’ ዎይ ቃይ፥ ‘ነዉ ኩሺ ባዋ’ ያጊ? <verse eid="ISA 45:9"/><verse number="10" style="v" sid="ISA 45:10"/>ባረ አዉዋ፥ ‘አያዉ የላዲ?’ ያግያ ኡራዉ፥ ዎይ ባረ ዳዮ፥ ‘አያዉ ታና ሀዋዳን የላዲ?’ ያግያ ኡራዉ አየ አና! <verse eid="ISA 45:10"/><verse number="11" style="v" sid="ISA 45:11"/>መና ጎዳይ፥ እስራኤልያ ጌሻይ፥ አ መዳዌ፥ ሀዋዳን ያጌ፤ ‘ስንፐ ትምቢትያ ኤራናዉነ ታ ናናቱዋባ ታና ኦቻናዉ ህንተ በሲቴ? ታ ኩሽያን ታን ኦናባካ ታና አዛዛናዉ በሲቴ? <verse eid="ISA 45:11"/><verse number="12" style="v" sid="ISA 45:12"/>ታን ሳኣ ኦድ፤ አሳካ አ ቦላ መድ። ሳሎቱዋ ታን ታ ኩሽያን ቶላድ፤ ኡንቱንቱን ደእያ መታቱዋ ኡባካ አዛዛድ። <verse eid="ISA 45:12"/><verse number="13" style="v" sid="ISA 45:13"/>ታን ቂሮሳ ጽሎተን ደንድ፤ አ ኦግያ ኡባካ ሱረ ኦና። ሻሉዋ ጭገናን፥ ዎይ ማታይያ እመናን፥ እ ታ ካታማ ኬጻና፤ ታ አሳካ ኦሞዱዋፐ ከሳና’ ያጌ። ታን ኡባፐ ዎልቃማ መና ጎዳይ ሀዋ ኦዳይ” ያጌ።<verse eid="ISA 45:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 45:14"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ግብጼ ዱረታይነ ቶጵያ ዛልኢ፥ ቃይ ጌሳ አዱሳ ግድያ ሳባአ አሳቱካ ኔኮ ዪደ፥ ነባ ግዳናዋ። ኡንቱንቱ ሳንሳላታን ቃሸቲደ፥ ኔና ካላና። ኡንቱንቱ ነዉ ጎይኒድ፥ ‘ጾሳይ ነ ጻላላና ደኤ፤ ሀራይ ባዋ፤ አፐ ሀራ ጾስ ባዋ’ ያጊደ ነዉ ዋትዋታና” ያጌ።<verse eid="ISA 45:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 45:15"/>አቤት ጾሳዉ፥ እስራኤልያ አሽያዎ፥ ቱሙዋፐ ኔን ኔና ገንያ ጾሳ። <verse eid="ISA 45:15"/><verse number="16" style="v" sid="ISA 45:16"/>ኤቃ መያዋንቱ ኡባይካ ዬላታናነ ካዉሻና። ኤቃ ምስልያ መያዋንቱ ኡባይ እትፐ ካዉሻዉ ባና። <verse eid="ISA 45:16"/><verse number="17" style="v" sid="ISA 45:17"/>ሽን እስራኤልያ መና ጎዳይ መና አቶተን አሽ ድጌዳ፤ ህንተ መናዉካ ዬላትክታነ ካዉሽክታ።<verse eid="ISA 45:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 45:18"/>ሳሎቱዋ መዳ መና ጎዳይ፥ ቢታካ ጊግሲደ ኦዳዌ፥ ቃይ አሳይ ደአናዳናፐ አትና፥ ቢታ ጮ መቤና መና ጎዳይ ሀዋዳን ያጌ፤ “ታን መና ጎዳ፤ ታፐ ሀራይ ባዋ፤ <verse eid="ISA 45:18"/><verse number="19" style="v" sid="ISA 45:19"/>ታን ጌማን፥ ሀቃነንቶ እት ማ ጋድያን ሃሳያበይከ። ያቆባ ዘረዉካ፥ ‘ታና ጮ ኮይተ’ ጋበይከ። ታን መና ጎዳይ ቱሙዋ ሃሳያይ፤ ልከባ ኦዳይ።<verse eid="ISA 45:19"/></para>
  <para style="s1">ሳሉዋ ሳኣ መዳ ጾሳነ ባብሎነ ኤቃቱዋ</para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 45:20"/>“ህንተኖ ካዉተቱዋፐ አቴዳዋንቶ፥ እትፐ ሺቂደ ሃይተ፤ ማታ ሺቅተ። ምፐ ኦሰቴዳ ኤቃ ምስልያ ቶክ ዩይያዋንቶነ፥ አሻናዉ ዳንዳየና ጾሳ ዎስያዋንቶ ኤር ባዋ። <verse eid="ISA 45:20"/><verse number="21" style="v" sid="ISA 45:21"/>አነ ኦድተ፤ ህንተ ሞቱዋ ሺሽተ፤ ኡንቱንቱካ አነ እትፐ ዞረትኖ። አዱሳ ዎድያፐ ካሰ ሀዋ ኦዴዳዌ ኦኔ? በንፐ ሀዋ አዋዬዳዌ ኦኔ? ታና መና ጎዳ ግድክታየ? ታፐ አትና ሀራ ጾሳይ ባዋ። ታን ጽሎ ጾሳነ አሽያዋ። ታፐ ሀራይ ባዋ።<verse eid="ISA 45:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 45:22"/>“ህንተኖ ቢታ ጋጻን ደእያ ኡባ አሳቱ፥ ታኮ ስሚደ፥ አትተ። አያዉ ጎፐ፥ ታን ጾሳ፤ ታፐ ሀራይ ባዋ። <verse eid="ISA 45:22"/><verse number="23" style="v" sid="ISA 45:23"/>ታን ታ ሁጲያን ጫቃድ፤<note caller="-" style="x"><char style="xo" closed="false">45:23 </char><char style="xt" closed="false"><ref loc="ROM 14:11">ሮመ 14:11</ref>፤ <ref loc="PHP 2:10-11">ፕልጵ. 2:10-11</ref></char></note> ጉየ ስመና ቃላይ ታ ዶናፐ ጽሎተን ከሴዳ፦ ‘አሳይ ኡባይ ታዉ ጉልባታና፤ እንጻርሳ ኡባይካ ታናን ጫቃና’ ያጋድ።<verse eid="ISA 45:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 45:24"/>“ኡንቱንቱ ታዋ ሃሳዪደ፥ ‘ጽሎተይነ ምኖተይ መና ጎዳ ጻላላን ደኤ’ ያጋና” ያጌ።</para>
  <para style="p" vid="ISA 45:24">አ እጽያዋንቱ ኡባይ አኮ ዪደ ዬላታና። <verse eid="ISA 45:24"/><verse number="25" style="v" sid="ISA 45:25"/>ሽን እስራኤልያ ዘረይ ኡባይ መና ጎዳን፥ ጾኑዋነ ቦንቹዋ ደማና።<verse eid="ISA 45:25"/></para>
  <chapter eid="ISA 45"/>
  <chapter number="46" style="c" sid="ISA 46"/>
  <para style="s1">ባብሎና ኤቃቱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 46:1"/>ቤላ ግያ ባብሎነ ኤቃይ ጎይኔ፤ ናባ ግያ ኤቃይካ ሆኬ። ካሰ ህንተ ቶክያ ኤቃቱ ሀእ ጫና መህያ ቦላን ጫነቲደ፥ ኡንቱንቶ ዴጾ ቶኩዋ ግዴድኖ። <verse eid="ISA 46:1"/><verse number="2" style="v" sid="ISA 46:2"/>ጫና መሄቱ ዴጹዋፐ ደንዴዳዋን፥ ጫናና እትፐ ኩንዴድኖ፤ ኤቃቱ ባረና አሻናዉ ዳንዳየና ድራዉ፥ ባረንቱ ሁጲያዉካ ኦሞደቲደ ቤድኖ።<verse eid="ISA 46:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 46:3"/>ጾሳይ ሀዋዳን ያጌ፤ “ህንተኖ፥ እስራኤልያፐ አቴዳዋንቶ፥ ያቆባ ዛረቶ፥ ታን ኦድያዋ ስስተ፤ ህንተ የለቴዳ ዎድያፐ ዶማደ ታን ህንተና ቶካድ። <verse eid="ISA 46:3"/><verse number="4" style="v" sid="ISA 46:4"/>ህንተ ጭማና ጋካናዉካ ታን ታናካ፤ ህንተ ፑሉማና ጋካናዉካ፥ ታን ህንተና ማዳና። ታን ህንተና መድ፤ ታን ህንተና ደንና፤ ታን ህንተና ቶካናነ አሻና።<verse eid="ISA 46:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 46:5"/>“ታና ኦ ማላ ጊተ? ቃይ ኦናና ልኪቴ? ኑን እት ማላ ግዳናዳን፥ ታና ኦናና ጋ ጼሊቴ? <verse eid="ISA 46:5"/><verse number="6" style="v" sid="ISA 46:6"/>ዎርቃ ባረንቱ ቃርጪታፐ ቆልያዋንቱነ ብራ ሚዛናን ዎደ ልክያዋንቱ ሄዋ ኡንቱንቶ ጾሳ ኦደ መና ማላ፥ ዎርቃ ትግያዋ ቃጻሪኖ። እካ ጾሳ ኦደ መ፤ ያትና፥ ኡንቱንቱ ሄ ኤቃ ስንን ሆኪደ ጎይኒኖ። <verse eid="ISA 46:6"/><verse number="7" style="v" sid="ISA 46:7"/>ኡንቱንቱ አ ደንደ፥ ባረንቱ ሀሽያን ቶኪኖ፤ አ ሳኣን አ ዎኖ። ያቶፐ እ ሄዋን ኤቂ አጌ፤ ሄዋፐ ያ ሃ ቃጸና። እት አሳይ አዉ ዋሶፐካ፥ ዛሩዋ እመና፤ ቃይ አ መቱዋፐካ አ አሸና።<verse eid="ISA 46:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 46:8"/>“ህንተኖ ናጋራንቻቶ፥ ሀዋ ሀሳይተነ ቆፕተ፤ ህንተ ዎዛናን ካሀን ዎተ። <verse eid="ISA 46:8"/><verse number="9" style="v" sid="ISA 46:9"/>በን ዎደ ሀኔዳ የዎቱዋ ሀሳይተ። አያዉ ጎፐ፥ ታን ጾሳ፤ ሀራይ ባዋ። ታን ጾሳ፤ ታ ማላይ ኦንነ ባዋ። <verse eid="ISA 46:9"/><verse number="10" style="v" sid="ISA 46:10"/>‘ታ ቆፋይ ምናና፤ ቃይ ታንካ ታ ሀልቹዋ ኡባ ፖላና’ ያጋይ። ዉርሰን ትምቢትያ ዶመን፥ ቃይ ብሮ ሀንቤና የዎቱዋ በን ዎድያፐ ዶማደ አዋያይ። <verse eid="ISA 46:10"/><verse number="11" style="v" sid="ISA 46:11"/>አዋይ ዶልያ ባጋፐ ቦንቂያ ካፉዋ፥ ሃኮ ጋድያፐ ታ ቆፋ ፖልያ አሳ ታን ጼሳደ፥ ታን ጌዳዋ ታን ፖላና፤ ታን ሀልቼዳዋካ ታን ኦና።<verse eid="ISA 46:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 46:12"/>“ህንተኖ ዎዛናይ ሙሜዳዋንቶ፥ ጽሎተፐካ ሃኬዳዋንቶ፥ ታን ኦድያዋ ስስተ፤ <verse eid="ISA 46:12"/><verse number="13" style="v" sid="ISA 46:13"/>ታን ታ ጽሎተ ማታ አያይ፤ እካ ሀሳኮ ግደና። ታ አቶተይ ጋምኤና፤ ታን ታ አቶተ ጽዮንዉ፥ ታ ቦንቹዋካ እስራኤልያዉ እማና” ያጌ።<verse eid="ISA 46:13"/></para>
  <chapter eid="ISA 46"/>
  <chapter number="47" style="c" sid="ISA 47"/>
  <para style="s1">ባብሎነ ቦላ ይያ ፕርዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 47:1"/>ጾሳይ ሀዋዳን ያጌ፤<note caller="-" style="x"><char style="xo" closed="false">47:1-15 </char><char style="xt" closed="false"><ref loc="ISA 13:1-14:23">ኢሳ. 13:1—14:23</ref>፤ <ref loc="JER 50:1">ኤር. 50:1</ref>፤ <ref loc="JER 51:64">51:64</ref></char></note> “ሀነ ባብሎነ ዎዶራተ፥ ዱገ ዎ፤ ባናን ኡታ። ሀነ ካላዳዌቱዋ ናተ፥ ነ ካተቱዋ አራታ አጋደ ሳኣን ኡታ። አያዉ ጎፐ፥ ሀዋፐ ስንናዉ ኔን ኦቶሮትያኖነ ሹጋቶ ጌተታካ። <verse eid="ISA 47:1"/><verse number="2" style="v" sid="ISA 47:2"/>ዎጻ አካደ ካ ጋጫ። ነ ጉለ ቃራ፤ ነ አዱሳ ማዩዋካ ከሳ። ነ ጸፕያ በሳ፤ ያታደ ሻፋቱዋ ፕና። <verse eid="ISA 47:2"/><verse number="3" style="v" sid="ISA 47:3"/>ነ ካሉ ቃረታና፤ ነ ፖኩካ ቤታና። ታን ሀሉዋ ከሳና፤ ኦስካ ቃረትከ” ያጌ።<verse eid="ISA 47:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 47:4"/>ኑና ዎዝያዌ፥ አዉ ሱንይ ኡባፐ ዎልቃማ መና ጎዳ ግድያዌ፥ እስራኤልያ ጌሻ።<verse eid="ISA 47:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 47:5"/>ጾሳይ ሀዋዳን ያጌ፤ “ሀነ ካላዳዌቱዋ ናተ፥ ባ፤ ማን ጮኡ ጋደ ኡታሻ። አያዉ ጎፐ፥ ሀዋፐ ስንዉ ኔን ካዉተቱዋ ካታቶ ጌተታካ። <verse eid="ISA 47:5"/><verse number="6" style="v" sid="ISA 47:6"/>ታን ታ አሳ ሀንቀታድ፤ ታ ላታካ ቱንሳድ፤ ታን ኡንቱንቱ ነ ኩሽያን አደ እማድ። ኔን ኡንቱንቶ ቃረታባካ፤ ጭሜዳዋንቱ ቦላንካ ነ ሞርገ ምን ሎይ ዴጸታዳ። <verse eid="ISA 47:6"/><verse number="7" style="v" sid="ISA 47:7"/>ኔን፥ ‘ታን መናዉ ካታቶ ግዳና’ ያጋዳ። ሄዋ ድራዉ፥ ሀ የዎቱዋ ነ ዎዛናን ቆፓባካ፤ ኡንቱንቱ ዉርሰካ ሀሳያባካ።<verse eid="ISA 47:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 47:8"/>“ኔኖ ዎፑ ጋደ ኡቴዳነ እሻሉዋ ዶስያነ፥ ስሳ።<note caller="-" style="x"><char style="xo" closed="false">47:8-9 </char><char style="xt" closed="false"><ref loc="REV 18:7-8">ሳፃ 18:7-8</ref></char></note> ነ ዎዛናን፥ ‘ታና፤ ታፐ አትና፥ ሀራይ ባዋ። ታን አምኤ ግድከ፤ ዎይ የላደ ናእ ባይና ማይነ ግድከ’ ያጋዳ። <verse eid="ISA 47:8"/><verse number="9" style="v" sid="ISA 47:9"/>ሀ ላኡ የዎቱ እት ጋላስ አይፊ ልጳናዉ፥ ነ ቦላ ያና። ነ ብታይ ዳራ፥ ነ ሙሩኑካ ዎልቃማ ዎልቃማ ግዶፐነ፥ ኔን ነ ናናቱዋፐ መላ አትያዌነ አምኤተይ ነ ቦላ ኩመንን ይያዌ አተና።<verse eid="ISA 47:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 47:10"/>“ኔን ነ ኢታተን አማነታ ኡታዳ፤ ቃይ፥ ‘ታና ኦንነ በኤና’ ያጋዳ። ነ አዳ ኤራተይነ ጭንጫተይ ኔና ዎራ ካለና፥ ኔን ነ ዎዛናን፥ ‘ታና፥ ታፐ አትና፥ ሀራይ ባዋ’ ያጋዳ። <verse eid="ISA 47:10"/><verse number="11" style="v" sid="ISA 47:11"/>ሽን ኔን ዋታ ሙሩኑዋን ሃሳንንቶ ኤረና ኢታይ ነ ቦላ ያና። ኔን ጋትያ ጭጋናዉ ዳንዳየና ቦሻይ ነ ቦላን ዎና፤ ቃይ ኔን አያነ ኤረና ባሻይ ቆፐናን ነ ቦላ ያና።<verse eid="ISA 47:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 47:12"/>“አነ ኔን ነ ናአተደፐ ኦደ ደኤዳ ነ ብታነ ነ ሙሩኑዋ ሀእካ አጎፓ። ኦን ኤሪ፥ ነ ጎዋዳን ሀናነንቶ፤ ዎይ ኔን አን ዳጋንንንቶ። <verse eid="ISA 47:12"/><verse number="13" style="v" sid="ISA 47:13"/>ዞረ ጻላላን ነ ዳቡራዳ። ሳሉዋ ጾልንትያ ፓይድያዋንቱ፥ አ ጼሊደ ትምቢትያ ኦድያዋንቱ፥ ቃይ፥ አግና ጼሩዋን ጼሩዋን ነ ቦላን ያናዋ ኦድያዋንቱ አነ ኔና አሽኖ። <verse eid="ISA 47:13"/><verse number="14" style="v" sid="ISA 47:14"/>በአ፥ ኡንቱንቱ ዱርጫ ማላ፤ ታማይ ኡንቱንታ ማና። ኡንቱንቱ ታማ ላጩዋፐ ባረና አሻናዉ ዳንዳይክኖ። ሄዌ አሳይ ባረ ቦላ ሆኤናዉ ሆእያ ቦንቆ ዎይ ቃይ አሳይ አ ስንን ኡታናዉ ዳንዳይያ ታማ ግደና። <verse eid="ISA 47:14"/><verse number="15" style="v" sid="ISA 47:15"/>ኔን ኡንቱንቱና ዳቡሬዳዋንቱ፥ ነ ናአተደፐ ዶሚደ፥ ኔናና ዛልኤዳዋንቱ ነዉ ሄዋ ማላ። ኡንቱንቱ ኡባይካ ባረ ባጋና ባጋና ላለታና፤ ኔና አሽያዌካ እቱነ ባዋ።<verse eid="ISA 47:15"/></para>
  <chapter eid="ISA 47"/>
  <chapter number="48" style="c" sid="ISA 48"/>
  <para style="s1">ጾሳይ ስንፐ ሀናናዋ ኤርያ ጾሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 48:1"/>“ህንተኖ ያቆባ ዛረቶ፥ እስራኤልያ ሱንን ጼሰትያዋንቶ፥ ቃይ ይሁዳ ዘረፐ ዬዳዋንቶ፥ ሀዋ ስስተ። ህንተ መና ጎዳ ሱንን ጫቂታ፤ እስራኤልያ ጾሳ ጼሲታ፤ ሽን ቱማተንነ ጽሎተን ግደና። <verse eid="ISA 48:1"/><verse number="2" style="v" sid="ISA 48:2"/>ህንተ ህንተና ጌሻ ካታማ ሱንን ጼሲታ፤ እስራኤልያ ጾሳን ዘምፒታ፤ አ ሱንይ ኡባፐ ዎልቃማ መና ጎዳ።<verse eid="ISA 48:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 48:3"/>“ታን ካሰ ሀኔዳዋንታ ዳሮ ዎድያፐ ካሰ ኦዳድ፤ ታ ዶናፐ ኡንቱንቱ ከሴድኖ። ኡንቱንቱ ኤለካ ፖለታናዳን፥ ታን ኦድ። <verse eid="ISA 48:3"/><verse number="4" style="v" sid="ISA 48:4"/>አያዉ ጎፐ፥ ኔን ኦድና ስሰናዋ፥ ነ ሞርጊ ብራታ ማላ ግድያዋ፥ ነ ሶምኢካ ናሃስያ ግያ ብራታዳን ሌቃመናዋ ታን ኤራድ። <verse eid="ISA 48:4"/><verse number="5" style="v" sid="ISA 48:5"/>ሄዋ ድራዉ፥ ኔን፥ ‘ሀዋ ታ ኤቃይ ኦዳ፤ ቃይ ታ ማሰቴዳ ምስለቱነ ታ ሲልሲደ ኦዳ ምስሊ ኦዳ’ ጌናዳን፥ ታን ሄዋ ነዉ በንፐ ዶማደ ኦዳድ። ቃይ ኡንቱንቱ ሀናናፐ ካሰታደ፥ ታን ኡንቱንታ ነዉ አዋያድ።<verse eid="ISA 48:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 48:6"/>“ኔን ካሰ ስሳዳ፤ ሀእ ስም ሀዋ ኡባ በአ። ያትና፥ ኔን ሀዋ ኡባ ቱማ ጊኪ? ሀእፐ ዶማደ ስንዉ ኔን ኦራባ ስሳናዳን፥ ታን ኦና። <verse eid="ISA 48:6"/><verse number="7" style="v" sid="ISA 48:7"/>ኡንቱንቱ ሀእ መቴድኖፐ አትና፥ በን መትበይክኖ። ኔን፥ ‘በአ፥ ታን ኡንቱንታ ኤራይ’ ጌናዳን፥ ሀችፐ ካሰ ኔን ሙለካ ኡንቱንቱባ ስሳባካ። <verse eid="ISA 48:7"/><verse number="8" style="v" sid="ISA 48:8"/>ኔን ሙለካ ስሳባካ፤ ቃይ ሙለካ ኤራባካ። ነ ሀይይ በንፐካ ዶየትቤና። አያዉ ጎፐ፥ ኔን ጭምያዋ ግድያዋ ታን ኤራይ፤ ቃይ የለቶደፐካ ኔን ማካላንቻ ጌተታደ ጼሰታዳ።<verse eid="ISA 48:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 48:9"/>“ታ ሱን ድራዉ፥ ታን ታ ሀንቁዋ ዛራና፤ ታን ኔና ይሰናዳን፥ ታ ሀንቁዋ ተአና። <verse eid="ISA 48:9"/><verse number="10" style="v" sid="ISA 48:10"/>በአ፥ ታን ኔና ፓጫድ፤ ሽን ብራዳን ግደና፤ ታን ኔና መቱዋ ታማን ፓጫድ። <verse eid="ISA 48:10"/><verse number="11" style="v" sid="ISA 48:11"/>ታን ታ ድራዉ፥ ሀዋ ኦይ። አያዉ ጎፐ፥ ታ ሱንይ ቶሸታናዉ ታን ኮይከ። ታን ታ ቦንቹዋ ሀራዉ እምከ።<verse eid="ISA 48:11"/></para>
  <para style="s1">ጾሳይ ዶሬዳ ቆማ</para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 48:12"/>“ኔኖ ያቆባ፥ ታን ጼሴዳ እስራኤልያዉ፥ ታን ግያዋ ስሳ።<note caller="-" style="x"><char style="xo" closed="false">48:12 </char><char style="xt" closed="false"><ref loc="ISA 44:6">ኢሳ. 44:6</ref>፤ <ref loc="REV 1:17">ሳፃ 1:17</ref>፤ <ref loc="REV 22:13">22:13</ref></char></note> ታን አ፤ ኮይሩካ ታና ዉርሰይካ ታና። <verse eid="ISA 48:12"/><verse number="13" style="v" sid="ISA 48:13"/>ቢታ ባሱዋ ታ ኩሺ ባሴዳ። ሳሎቱዋካ ታ ኡሸቻ ኩሺ ምጬዳ። ታን ኡንቱንታ ጼስያ ዎደ፥ ኡንቱንቱ እትፐ ኤቂኖ።<verse eid="ISA 48:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 48:14"/>“ህንተ ኡባይ እትፐ ሺቂደ ስስተ፤ ኤቃቱዋፐ ሀዌ ሀናናዋ ካሰቲደ ኦዴዳዌ ኦኔ? መና ጎዳይ ዶሬዳዌ አ ቆፋ ባብሎነ ቦላ ፖላና፤ አ ቀሲካ ባብሎነ ቢታ አሳ ቦላ ግዳናዋ። <verse eid="ISA 48:14"/><verse number="15" style="v" sid="ISA 48:15"/>ታን ታ ሁጲያዉ አ ጼሳድነ አዉ ኦዳድ፤ አ አሄዳዌ ታና። ቃይ እ ኦያባይ ኡባይ አዉ እንጀታና።<verse eid="ISA 48:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 48:16"/>“ታኮ ሃ ሺቂደ፥ ሀዋ ስስተ፤ ታን ኮይሮፐ ዶማደካ ጌማን ሃሳያበይከ፤ ሄዌ ሀኔዳ ዎድያፐካ ዶማደ ታን ያን ደአይ” ያጌ።</para>
  <para style="p" vid="ISA 48:16">ቃይ ኡባ ሞድያ መና ጎዳይነ አ አያናይ ሀእ ታና ኪቴድኖ።<verse eid="ISA 48:16"/></para>
  <para style="s1">ጾሳይ ባረ አሳዉ ሀልቼዳ ሀልቹዋ</para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 48:17"/>መና ጎዳይ፥ ኔና ዎዝያዌ፥ እስራኤልያ ጌሻይ ሀዋዳን ያጌ፤ “ታን መና ጎዳይ፥ ነ ጾሳይ፥ ኔና ማድያዋ ታማርስያዋ። ኔን ባናዉ በስያ ኦግያንካ ኔና ካለያዌ ታና። <verse eid="ISA 48:17"/><verse number="18" style="v" sid="ISA 48:18"/>ኔን ታ አዛዙዋ ስሴዳዋ ግድንቶነ፥ ነ ሳሮተይ ሻፋ ሃዳን ጎጋና ሽን፤ ነ ጽሎተይካ አባ ቤታዳን ሀናና ሽን። <verse eid="ISA 48:18"/><verse number="19" style="v" sid="ISA 48:19"/>ነ ዛሪ አባ ሻፍያዳን፥ ነ ናናይካ ፓይዱ ባይና ሳኣ ባናዳን ጮራታና ሽን፤ ኡንቱንቱ ሱንይካ ታ ስንፐ የናን ዎይ ክቼናን አጋና ሽን” ያጌ።<verse eid="ISA 48:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 48:20"/>ባብሎነ ጋድያፐ ከስተ፤ ባብሎነ አሳፐካ ባቃትተ!<note caller="-" style="x"><char style="xo" closed="false">48:20 </char><char style="xt" closed="false"><ref loc="REV 18:4">ሳፃ 18:4</ref></char></note> ቃላ ቁ ኦደ፥ ናሸቻን ሀዋ ሃሳይተ፤ ሳኣፐ ሳኣ ጋጻ ጋካናዉ፥ ሀዋ ኪትተ። “መና ጎዳይ ባረ ቆማ ያቆባ ዎዜዳ” ያጊደ ኦድተ። <verse eid="ISA 48:20"/><verse number="21" style="v" sid="ISA 48:21"/>እ ኡንቱንታ መላ ቢታ ግዶና ካለዳ ዎደ፥ ኡንቱንቱ ሳመትበይክኖ። ዛላፐ ሃካ ኡንቱንቶ ፑልትሴዳ፤ ዛላ እ ጳልቂና፥ ሃይ ቄዳ።<verse eid="ISA 48:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 48:22"/>መና ጎዳይ፥ “ኢታቶ ሳሩ ባዋ” ያጌ።<note caller="-" style="x"><char style="xo" closed="false">48:22 </char><char style="xt" closed="false"><ref loc="ISA 57:21">ኢሳ. 57:21</ref></char></note><verse eid="ISA 48:22"/></para>
  <chapter eid="ISA 48"/>
  <chapter number="49" style="c" sid="ISA 49"/>
  <para style="ms">ጾሳ ሀጋዝያዋባ</para>
  <para style="mr">(<ref loc="ISA 49:1-53:12">49:1—53:12</ref>)</para>
  <para style="s1">እስራኤሊ ቢታን ደእያ አሳዉ ፖኦ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 49:1"/>ህንተኖ፥ አባ ዶናን ደእያ ቢታቶ፥ ታን ኦድያዋ ስስተ።<note caller="-" style="x"><char style="xo" closed="false">49:1 </char><char style="xt" closed="false"><ref loc="JER 1:5">ኤር. 1:5</ref></char></note> ህንተኖ፥ ሃኩዋን ደእያ ካዉተቶ፥ ስስተ። ታን የለታናፐ ካሰ መና ጎዳይ ታና ጼሴዳ፤ ቃይ ታ ዳይ ኡሉዋን ደእሽን፥ ታ ሱን ሱንዳ። <verse eid="ISA 49:1"/><verse number="2" style="v" sid="ISA 49:2"/>ታ እንጻርሳ ሳታና ደእያ ማሻዳን ኦዳ፤<note caller="-" style="x"><char style="xo" closed="false">49:2 </char><char style="xt" closed="false"><ref loc="HEB 4:12">እብራ. 4:12</ref>፤ <ref loc="REV 1:16">ሳፃ 1:16</ref></char></note> ባረ ኩሽያ ኩዋን ታና ገንዳ፤ እ ታና ፖሼዳ ቶራዳን ኦዳ፤ ያቲደ ባረ ሾኩዋ ግዶን ታና የጊደ ቆሴዳ።<verse eid="ISA 49:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 49:3"/>እ ታና፥ “ኔን ታን ኔናን ቦንቼትያ ታ ቆማ እስራኤልያ” ያጌዳ።<verse eid="ISA 49:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 49:4"/>ሽን ታን ሀዋዳን ያጋድ፤ “ታን መላ ጮ ዳቡራድ፤ ታ ዎልቃካ ጎኤናባንነ ሀዳባን ጮ ዉርሳድ። ታ ፕርዳይ ጾሳ ማታና፤ ታ ጋቲካ ታ መና ጎዳ ማታና” ያጋድ።<verse eid="ISA 49:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 49:5"/>ሀእካ፥ ታን መና ጎዳ አይፍያ ስንን ቦንቼቴዳ ድራዉነ ታ ጾሳይ ታዉ ዎልቃ ግዴዳ ድራዉ፥ ያቆባ አኮ ዛራናዉነ እስራኤልያ አኮ ሺሻናዉ፥ ታን አዉ ቆማ ግዳናዳን፥ ታና ታ ዳይ ኡሉዋን መዳዌ መና ጎዳይ ሀዋዳን ያጌ፤ <verse eid="ISA 49:5"/><verse number="6" style="v" sid="ISA 49:6"/>“ኔን ያቆባ ዛርያ ደንናዉነ እስራኤልያፐ አቴዳዋንታ ዛራደ አሀናዉ፥ ኔን ታዉ ቆማ ግድያዌ ቄር ጉባ። ሄዋ ቦላ ጉጃደ፥ ታ አቶተይ ቢታ ጋጻ ጋካናዳን፥ ታን ኔና ካዉተቶ ፖኦ ኦና” ያጌ።<note caller="-" style="x"><char style="xo" closed="false">49:6 </char><char style="xt" closed="false"><ref loc="ISA 42:6">ኢሳ. 42:6</ref>፤ <ref loc="LUK 2:32">ሉቃሳ 2:32</ref>፤ <ref loc="ACT 13:47">ኪታ 13:47</ref>፤ <ref loc="ACT 26:23">26:23</ref></char></note><verse eid="ISA 49:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 49:7"/>አሳይ ካዳዎ፥ እጼዳዎነ ደርያ ሞድያዋንቶ ቆማዉ፥ መና ጎዳይ፥ እስራኤልያ ዎዝያዌ፥ እስራኤልያ ጌሻይ ሀዋዳን ያጌ፤ “አማነትያ መና ጎዳ ድራዉነ ኔና ዶሬዳ እስራኤልያ ጌሻ ድራዉ ካተቱ በኢደ፥ ደንድ ኤቃና። ደርያ ሞድያዋንቱካ በኢደ ጎይናና” ያጌ።<verse eid="ISA 49:7"/></para>
  <para style="s1">የሩሳላመ ዛረ ኦሰታና</para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 49:8"/>መና ጎዳይ ሀዋዳን ያጌ፤<note caller="-" style="x"><char style="xo" closed="false">49:8 </char><char style="xt" closed="false"><ref loc="2CO 6:2">2 ቆሮ. 6:2</ref></char></note> “ታን ዶሬዳ ዎድያን ነ ኦሻ ዛራድ። አቶተ ጋላስ ታን ኔና ማዳድ። ታን ኔና ናጋና፤ ኔን ቢታ ዛረደ ኤሳና ማላ፥ አሳይ ደኤና ቢታቱዋካ ኔን ላትሳና ማላ፥ ታን ኔና አሳዉ ጫቁዋ ኦደ እማድ። <verse eid="ISA 49:8"/><verse number="9" style="v" sid="ISA 49:9"/>ኦሞዱዋን ደእያዋንታ፥ ‘ከስተ!’ ማ ቃሹዋን ደእያዋንታካ፥ ‘ብለትተ!’ ጋና ማላ፥ አሳዉ ጫቁዋ ኦደ ኔና እማና። ኡንቱንቱ ኦግያ ማታን ሄመታና፤ ዞዘትያ ከራ ኡባ ቦላ አላጻና። <verse eid="ISA 49:9"/><verse number="10" style="v" sid="ISA 49:10"/>ኡንቱንቱ ኮሻትክኖ ዎይ ሳመትክኖ።<note caller="-" style="x"><char style="xo" closed="false">49:10 </char><char style="xt" closed="false"><ref loc="REV 7:16-17">ሳፃ 7:16-17</ref></char></note> ኡንቱንቱ ባዙዋ ምሹ ጹገና፤ አዋይካ ኡንቱንታ ሜና። ኡንቱንቶ ቃረያዌ ኡንቱንታ ካለና፤ ፑልቶ ሃኮካ ኡንቱንታ ላጋና።<verse eid="ISA 49:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 49:11"/>“ታን ታ ደረቱዋ ኡባ ኦገ ከሳና፤ ታ ዎጋ ኦገቱካ ዛንጋራፐ ቁ ጋና። <verse eid="ISA 49:11"/><verse number="12" style="v" sid="ISA 49:12"/>በአ፥ ታ አሳይ ሃኮ ሳፐ ያና: ሁጲሳ ባጋፐነ አዋይ ዉልያ ባጋፐ ያና። ቃይ አስዋና ቢታፐካ ያና” ያጌ።<verse eid="ISA 49:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 49:13"/>ህንተኖ ሳሎቶ፥ ናሸቻን የጽተ። ኔኖ ቢታዉ ናሸታ። ህንተኖ ደረቶ፥ እልልተ! አያዉ ጎፐ፥ መና ጎዳይ ባረ አሳ ምንዳ፤ ቃይ ባረ መቶታንቻቶካ ቃረቴ።<verse eid="ISA 49:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 49:14"/>ሽን ጽዮና፥ “መና ጎዳይ ታና አጌዳ፤ ጎዳይ ታና ዶጌዳ” ያጋዉ።<verse eid="ISA 49:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 49:15"/>ጾሳይ ሀዋዳን ያጊደ ዛሬ፤ “አታ ባረ ንያ ናኣ ዶጋናዉ ዳንዳያይ? ባረ ኡሉዋፐ የሌዳ ናአዉ ቃረተኬየ? ጌላዳን አ ዶግንቶካ፥ ታን ኔና ዶግከ! <verse eid="ISA 49:15"/><verse number="16" style="v" sid="ISA 49:16"/>በአ፥ ታን ኔና ታ ኩሽያ ጎምፓን ጻፋ ዎድ፤ ነ ድርሳ ግምበቱካ ኡባ ገደ ታ ስንን ደኢኖ።<verse eid="ISA 49:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 49:17"/>“ኔና ዛረደ ኬጽያዋንቱ ያና፤ ኔና ኮሌዳዋንቱ ከሲደ ባና። <verse eid="ISA 49:17"/><verse number="18" style="v" sid="ISA 49:18"/>አነ ቁ ጋደ፥ ነ ዩሹዋ ጼላ፤ ነ ናናይ ኡባይ እትፐ ሺቂደ፥ ኔኮ ያና። ታን መና ጎዳይ ታ ደኡዋን ጫቃይ: ኔን ኡንቱንቱ ኡባ አሌቁዋዳን ማያና፤ ቡላቼታናዉ ሀንያ ምሽራቲዳን፥ ኔን ኡንቱንታ ማያና።<verse eid="ISA 49:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 49:19"/>“ነ ባሻ ሳአቱነ መላ ቢታቱ ሀእ ኔናን ደእያ አሳዉ ሎይ ኡንአና፤ ቃይ ኔና ኮሌዳዋንቱካ ኔፐ ሃካና። <verse eid="ISA 49:19"/><verse number="20" style="v" sid="ISA 49:20"/>ኔን ካዮትያ ላይቱዋን ነዉ የለቴዳ ናናይ ነ ሀይን ኦዲደ፥ ‘ሀዌ ሳአይ ኑዉ ሎይ ኡንኦ፤ ሄዋ ድራዉ፥ ኑዉ ደአናዉ አኮ ሳኣ እማ’ ያጋና። <verse eid="ISA 49:20"/><verse number="21" style="v" sid="ISA 49:21"/>ኔን ነ ዎዛናን፥ ‘ሀዋንታ ናናቱዋ ኡባ ታዉ ኦኔ የሌዳዌ? ታን የላደ ማን አታድ ሽን፤ ታን ማይናድ ሽን፤ ታን ኦሞደታደ ዎራ ባድ ሽን። ያትና፥ ሀዋንታ ኦኔ ድቼዳዌ? በአ፤ ታን ታረካ አታድ፤ ያትና ሀዋንቱ ናናይ ኡባይ ሀቃፐ ዬድኖ?’ ያጋና” ያጌ።<verse eid="ISA 49:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 49:22"/>ኡባ ሞድያ መና ጎዳይ ሀዋዳን ያጌ፤ “በአ፥ ታን ካዉተቶ ማላታ በሳና፤ ታን አሳዉ ታ ባንድራ ኤሳና። ኡንቱንቱ ነ አቱማ ናናቱዋ እድም አሀና፤ ነ ማጫ ናናቱዋካ ባረንቱ ሀሽያን ቶኪደ አሀና። <verse eid="ISA 49:22"/><verse number="23" style="v" sid="ISA 49:23"/>ካተቱ ኔና ድችያ አዎቱዋ ግዳና፤ ኡንቱንቱ ማጫ ካተቱካ ኔና ንያዋንታ ግዳና። ኡንቱንቱ ጉፋኒደ፥ ነዉ ጎይናና፤ ቃይ ነ ገድያ ባናካ ላጫና። ታን መና ጎዳ ግዴዳዋ ኔን ሄዋን ኤራና፤ ታናን አማነቲደ ናግያዋንቱ ዬላትክኖ” ያጌ።<verse eid="ISA 49:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 49:24"/>ኦሞዱዋን አኬዳዋ ዎልቃማ ኩሽያፐ ዛርሳና ዳንዳዪቴየ? ዎይ ኦሞዲደ አፌዳ አሳይ መቀ ባይና ኢታ ኩሽያፐ ከስ አካናዉ ዳንዳዪየ?<verse eid="ISA 49:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 49:25"/>ሽን መና ጎዳይ ሀዋዳን ያጌ፤ “ዎልቃማይ ኦሞዲደ አፌዳባይ ስማና፤ መቀ ባይና ኢታቱዋ ኩሽያን ኦሞደቴዳ አስካ ከስ አካና። አያዉ ጎፐ፥ ኔናና ኦለትያዋንቱና ታን ኦለታና፤ ነ ናናቱዋካ ታን አሻና። <verse eid="ISA 49:25"/><verse number="26" style="v" sid="ISA 49:26"/>ኔና ኡቁንያዋንቱ ባረንቱ አሹዋ ማናዳን፥ ታን ኦና፤ ቃይ ዎይንያ ኤሳ ኡሺደ ማትያዋዳን፥ ኡንቱንቱ ባረንቱ ሱ ኡሺደ ማታና። ያቶፐ አሳ ኡባይ ታን መና ጎዳ፥ ኔና አሽያዋ፥ ዎዝያዋነ፥ ያቆባ ዎልቃማ ግድያዋ ሄዋን ኤራና” ያጌ።<verse eid="ISA 49:26"/></para>
  <chapter eid="ISA 49"/>
  <chapter number="50" style="c" sid="ISA 50"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 50:1"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ታን ህንተ ዳዮ የዴዳ ፕርማይ ሀቃን ደኢ? ዎይ ኦስ ህንተና ታን ዛልኣድታ? በእተ፥ ህንተ ናጋራ ድራዉ፥ ህንተ ዛልኤቴድታ፤ ህንተ ባይዙዋ ድራዉ፥ ህንተ ዳያ ብለታዱ። <verse eid="ISA 50:1"/><verse number="2" style="v" sid="ISA 50:2"/>ታን ዬዳ ዎደ፥ አያዉ ሄዋን አሳይ ዬዴ? ታን ጼሴዳ ዎደ፥ ‘ዬ!’ ጋናዉ አያዉ አሳይ ሄዋን ደእቤኔ? ታን ህንተና ዎዛናዉ ታ ኩሺ ቃንየ? ዎይ ህንተና አሻናዉ ታዉ ዎልቃይ ባዌየ? በእተ፥ ታን ሴራደ አባ መልሳይ። ሻፋቱዋካ መላ ቢታ ኦይ። ኡንቱንቱን ደእያ ሞለቱ ሃይ ይና ዎቂኖ፤ ሳሙ ዎና ሀይቂኖ። <verse eid="ISA 50:2"/><verse number="3" style="v" sid="ISA 50:3"/>ታን ሳሎቱዋ ካረባ ማይዛይ፤ ዋሩዋካ ኡንቱንቱ ካመትያባ ኦይ” ያጌ።<verse eid="ISA 50:3"/></para>
  <para style="s1">ጾሳ ቆማይ አዛዘትያዋ</para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 50:4"/>ዳቡሬዳዋ ታን ቃላን ዋታደ ምንነንቶ ኤራና ማላ፥ ኡባ ሞድያ መና ጎዳይ ታዉ ታማሬዳ እንጻርሳ እሜዳ። እ ታና ዎንታ ዎንታ ቤጎደ፥ ታን ታማርያ አሳዳን ስሳናዳን፥ ታ ሀይ ዶዬ። <verse eid="ISA 50:4"/><verse number="5" style="v" sid="ISA 50:5"/>ኡባ ሞድያ መና ጎዳይ ታ ሀይ ዶዬዳ፤ ታንካ ማካላንቻ ግዳበይከ፤ ጉየካ ስማበይከ። <verse eid="ISA 50:5"/><verse number="6" style="v" sid="ISA 50:6"/>ታን ታ ዞክያ ሾጭያዋንቶ፥<note caller="-" style="x"><char style="xo" closed="false">50:6 </char><char style="xt" closed="false"><ref loc="MAT 26:67">ማቶሳ 26:67</ref>፤ <ref loc="MRK 14:65">ማር. 14:65</ref></char></note> ታ ጋጩዋ ቡቻ ሾድያዋንቶ አደ እማድ። ታ ሶምኡዋ ካዉሻፐነ ጩቻ ጩሸትያሳፐ ገንበይከ። <verse eid="ISA 50:6"/><verse number="7" style="v" sid="ISA 50:7"/>ኡባ ሞድያ መና ጎዳይ ታና ማድያ ድራዉ፥ ታን ዬላታበይከ፤ ሄዋ ድራዉ፥ ታን ታ ሶምኡዋ ሳልያ ግያ ሹቻዳን ኡዳድ። ታን ዬላተናን አታናዋካ ኤራይ። <verse eid="ISA 50:7"/><verse number="8" style="v" sid="ISA 50:8"/>ታና ሻትንያዌ ማታን ደኤ፤<note caller="-" style="x"><char style="xo" closed="false">50:8-9 </char><char style="xt" closed="false"><ref loc="ROM 8:33-34">ሮመ 8:33-34</ref></char></note> ያትና፥ ታና ሞትያዌ ኦኔ? አነ እትፐ ታናና ኤቆ! ታ ሞርኪ ኦኔ? አነ ታናና ጋከቶ! <verse eid="ISA 50:8"/><verse number="9" style="v" sid="ISA 50:9"/>በእተ፥ ኡባ ሞድያ መና ጎዳይ ታና ማዴ፤ ያትና፥ ታና ባይዛንቻ ጋናዌ ኦኔ? በእተ፥ ኡንቱንቱ ኡባይካ ማዩዋዳን ኤጭ ዉራና፤ ብልአይ ኡንቱንታ ማና።<verse eid="ISA 50:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 50:10"/>ህንተ ግዶፐ መና ጎዳዉ ያይያዌነ አ ቆማ ቃላዉ አዛዘትያዌ ኦኔ? ማን ሀመትያዌነ ፖኡ ባይናዌ እ ኦኔ? ሄ ኡራይ መና ጎዳ ሱንን አማነቶ፤ ባረ ጾሳንካ ዘምፖ። <verse eid="ISA 50:10"/><verse number="11" style="v" sid="ISA 50:11"/>በእተ፥ ህንተኖ ታማ ኤያ ኡባ ገደ፥ ዪቻ ጾምፕያ ላጩዋ ህንተንቶ ሺሽያዋንቶ፥ ህንተ ኤዳ ታማ ፖኡዋን ሄመትተ! ህንተ ዪጬዳ ጾምፕያ ላጩዋ ፖኡዋን ስመረትተ! ህንተ ታ ኩሽያፐ አካናዉ ደእያባይ ሀዋ: ህንተ ዎልቃማ ሴላን ግሳና።<verse eid="ISA 50:11"/></para>
  <chapter eid="ISA 50"/>
  <chapter number="51" style="c" sid="ISA 51"/>
  <para style="s1">የሩሳላመ ምንያ ቃላ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 51:1"/>ጾሳይ ሀዋዳን ያጌ፤ “ህንተኖ ጽሎተ ካልያዋንቶ፥ ህንተኖ ታና፥ መና ጎዳ ኮይያዋንቶ፥ ስስተ። ህንተ ጳልቀቲደ አከቴዳ ሹቻነ ህንተ ቦከቴዳ ከሴዳ ኦላ ጼልተ። <verse eid="ISA 51:1"/><verse number="2" style="v" sid="ISA 51:2"/>ህንተ አዉዋ አብራሃማኮነ ህንተና የሌዳ ሳርኮ ጼልተ። እ ባረካ ደእሽን፥ ታን አ ጼሳድ፤ አንጃድነ ፓይዱዋን ጮራያድ።<verse eid="ISA 51:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 51:3"/>“መና ጎዳይ ጽዮነንነ አ ኮለቴዳ ሳአቱዋን ደእያ ኡባ አሳ ምንና። እ ባዙዋ ኤደነ ገነትያዳን፥ እ መላ ሳአቱዋካ መና ጎዳ አታክልትያ ሳኣዳን ኦና። ናሸቻይነ ሀሹ ጉሳይ ያን ደአና፤ ጋላታነ ማዝሙርያ ኮሻይ ያን ስሰታና።<verse eid="ISA 51:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 51:4"/>“ታ አሳዉ፤ ታን ኦድያዋ ስስተ። ታ ካዉተዉ፥ ነ ሀይ ታኮ የጋደ ስሳ። አያዉ ጎፐ፥ ህጊ ታፐ ከሴ፤ ታ ሱረ ፕርዳይካ ካዉተቶ ፖኦ ግዳናዋ። <verse eid="ISA 51:4"/><verse number="5" style="v" sid="ISA 51:5"/>ታ ጽሎተይ ኤሌሊደ ሺቃና፤ ታ አሹካ ከሲደ፥ ኦግያን ደኤ። ታ ቀሲ አሳ ሞዳና፤ አባ ዶና ቢታቱዋን ደእያ አሳይ ኡባይ ታናን አማነቲደ ናጋና፤ ቃይ ታን ኡንቱንታ ታ ዎልቃን አሻናዋ፥ ናሸቻ ኦደ ናጋና። <verse eid="ISA 51:5"/><verse number="6" style="v" sid="ISA 51:6"/>ፑደ ቁ ጊደ፥ ሳሎቱዋ ጼልተ፤ ዱገ ሳኣካ ጼልተ። አያዉ ጎፐ፥ ሳሎቱ ጩዋዳን ፕስክ ጊደ ያና፤ ሳአይካ አፍላዳን ዉራና፤ አን ደእያ አሳይ ኡባይ ኡዱንጸቱዋዳን ሀይቃና። ሽን ታ አሹ መናዉ ደአና፤ ታ ጽሎተይካ ዉረና።<verse eid="ISA 51:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 51:7"/>“ህንተኖ ጽሎተ ኤርያዋንቶ፥ ታ ህጊካ ህንተ ዎዛናን ደእያዋንቶ፥ ስስተ። አሳ ቦርናሾ ያዮፕተ፤ ኡንቱንቱ ቦርያዉካ ዳጋሞፕተ። <verse eid="ISA 51:7"/><verse number="8" style="v" sid="ISA 51:8"/>አያዉ ጎፐ፥ ማዩዋ ምያዋዳን፥ ብልአይ ኡንቱንታ ማና፤ ዶርሳ እክስያ ምያዋዳን፥ ጉጹኒ ኡንቱንታ ማና። ሽን ታ ጽሎተይ መናዉ ደአና፤ ታ አሹካ የለታ ኡባዉ ጋካና” ያጌ።<verse eid="ISA 51:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 51:9"/>አቤት ጾሳዉ፥ ቤጎታ! ቤጎታ! መና ጎዳ ቀስያዉ፥ ዎልቃ ማያ፤ ካሰ አዳ ዎደቱዋንነ የለታቱዋን ቤጎቴዳዋዳን ቤጎታ። ራኣባ ግያ ዳዊያ ቃንጸሬዳዌ፥ ሚምንትያካ ጫዴዳዌ ኔና ግድኪየ? <verse eid="ISA 51:9"/><verse number="10" style="v" sid="ISA 51:10"/>አባነ ዎልቃማ ጪሙዋ ሃ መልሴዳዌ ኔና ግድኪየ? ኔን ዎዜዳዋንቱ ፕናና ማላ፥ ጪማ አባ ኦገ ኦዳዌ ኔና ግድኪየ? <verse eid="ISA 51:10"/><verse number="11" style="v" sid="ISA 51:11"/>መና ጎዳይ ዎዜዳዋንቱ ስሚደ፥ የጺድ ጽዮነ ያና፤ ዪደ መና ናሸቻይ ኡንቱንቱ ቦላን ደአና፤ ኡንቱንቱ ናሸቻነ ሀሹ ግያዋ ደማና። ቃይ ካዩነ ዬኩ ኡንቱንቱፐ ሃካና።<verse eid="ISA 51:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 51:12"/>ጾሳይ ሀዋዳን ያጌ፤ “ህንተና ምንያዌ ታና። ያትና፥ ሀይቂያ አሳዉ ያያናዉ፥ ማታዳን ኤለካ መልያ አሳ ናአዉ ያያናዉ ህንተ ኦኔ? <verse eid="ISA 51:12"/><verse number="13" style="v" sid="ISA 51:13"/>ህንተ ሳሎቱዋ ምጬዳነ ሳኣ ባሱዋካ ባሴዳ መና ጎዳ፥ ህንተናካ መዳዋ ዶጌድቴ? ኡንቱንቱ ህንተና ይሳናዉ ጊግሴዳ፥ ህንተና ኡቁንያ አሳቱዋ ሀንቁዋ ጋሱዋን ጋላሳ ኩመን ያዬድታ። ሽን ህንተና ኡቁንያዋ ሀንቁ ሀቃን ደኢ? <verse eid="ISA 51:13"/><verse number="14" style="v" sid="ISA 51:14"/>ኦሞደቴዳዌ ኤለካ ብለታና፤ ሀይቀና፤ ኦላንካ ገለና፤ አዉ ኡክይካ ፓጨና። <verse eid="ISA 51:14"/><verse number="15" style="v" sid="ISA 51:15"/>አያዉ ጎፐ፥ ታን መና ጎዳ ነ ጾሳቴ። ቤታይ ዋሳናዳን፥ አባ ቃይ። ታ ሱንይ ኡባፐ ዎልቃማ መና ጎዳ። <verse eid="ISA 51:15"/><verse number="16" style="v" sid="ISA 51:16"/>ሳሎቱዋ ምጫናዳን፥ ቢታ ባሱዋካ ባሳናዳን፥ ቃይ ጽዮነ፥ ‘ኔን ታ አሳ’ ጋናዳን፥ ታን ታ ቃላ ነ ዶናን ዎድ፤ ታ ኩሽያ ኩዋን ታን ኔና ገንድ” ያጌ።<verse eid="ISA 51:16"/></para>
  <para style="s1">መና ጎዳ ሀንቁዋ ጹኣ</para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 51:17"/>ኔኖ፥ መና ጎዳ ኩሽያፐ አ ሀንቁዋ ጹኣ ኡሼዳ የሩሳላመ፥ ቤጎታ!<note caller="-" style="x"><char style="xo" closed="false">51:17 </char><char style="xt" closed="false"><ref loc="REV 14:10">ሳፃ 14:10</ref>፤ <ref loc="REV 16:19">16:19</ref></char></note> ደንዳ! ኔን ጋንድጋርስያ ጹኣ ጭንግርሳደ ኡሻዳ። <verse eid="ISA 51:17"/><verse number="18" style="v" sid="ISA 51:18"/>አ የሌዳ ናናቱ ኡባፐ እዞ ካለያባይ እቱነ ባዋ፤ ቃይ አ ድቼዳ ናናቱ ኡባፐካ እ ኩሽያ ኦይቂያዌ እቱነ ባዋ። <verse eid="ISA 51:18"/><verse number="19" style="v" sid="ISA 51:19"/>ዳኮ ዳሮ ባሻይ ነ ቦላን ጋኬዳ፤ ያትና፥ ኔና ኦኔ ምንናዉ ዳንዳይያዌ? ሄዋንቱካ ኮለ፥ ኮሻነ ማሻ። ያትና፥ ታን ኔና ዋታደ ምንኔ? <verse eid="ISA 51:19"/><verse number="20" style="v" sid="ISA 51:20"/>ነ ናናይ ላባኔድኖ፤ ኡንቱንቱ ግትያ ግዶን ገሌዳ ገንእያዳን፥ ኦገ ኡባ ጋጻን ኩንዴድኖ። ኡንቱንቱ መና ጎዳ ሀንቁዋንነ ነ ጾሳ ሴራን ኩሜድኖ።<verse eid="ISA 51:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 51:21"/>ሄዋ ድራዉ፥ ነኖ፥ ዎይንያ ኤሳ ኡሸናን ማቴዳ መቶታንቻቴ፥ ሀዋ ስሳ። <verse eid="ISA 51:21"/><verse number="22" style="v" sid="ISA 51:22"/>ነ ጾሳይ፥ ባረ አሳዉ ሞተትያ ኡባ ሞድያ መና ጎዳይ ሀዋዳን ያጌ፤ “በአ፤ ኔና ጋንድጋርስያ፥ ታ ሀንቁዋ ጹኣ ታን ነ ኩሽያፐ አካድ፤ ኔን ላኤንዋ አ ሙለካ ኡሻካ። <verse eid="ISA 51:22"/><verse number="23" style="v" sid="ISA 51:23"/>ታን ሄዋ ኔና ቱጋይያዋንቱ ኩሽያን ዎና። ኡንቱንቱ ኔና፥ ‘ኑን ነ ቦላና ሀመቲደ አና ማላ፥ ዛቁላ’ ያጌድኖ። ኔን አና ጋካናዉ፥ ነ ዞክያ ኡንቱንቶ ቢታዳንነ ኦግያዳን ኦዳ” ያጌ።<verse eid="ISA 51:23"/></para>
  <chapter eid="ISA 51"/>
  <chapter number="52" style="c" sid="ISA 52"/>
  <para style="s1">ጾሳይ የሩሳላመ አሻና</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 52:1"/>ኔኖ ጽዮነ ካታማዉ፥ ቤጎታ፤ ምኖተ አፍላዳን ማያ።<note caller="-" style="x"><char style="xo" closed="false">52:1 </char><char style="xt" closed="false"><ref loc="REV 21:2">ሳፃ 21:2</ref>፣ <ref loc="REV 21:27">27</ref></char></note> ኔኖ፥ ጌሻ ካታማዉ፥ የሩሳላመ፥ ነ ቦንቹዋ ማዩዋ ማያ፤ አያዉ ጎፐ፥ ሀዋፐ ስንናዉ ቃጻረትቤናዌነ ቱናይ ነ ግዶ ገለና። <verse eid="ISA 52:1"/><verse number="2" style="v" sid="ISA 52:2"/>ኔኖ፥ ኦሞደቴዳ የሩሳላመ፥ ነ ባና ቆቆፋ። ደንዳዴ ነ ካተቱዋ አራታን ኡታ። ህንተኖ፥ ኦሞዱዋን ደእያ ጽዮነ አሳቶ፥ ህንተ ቆያን ቃሸቴዳ ሳንሳላታ ብርሽተ።<verse eid="ISA 52:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 52:3"/>አያዉ ጎፐ፥ ኡባ ሞድያ ጾሳይ ሀዋዳን ያጌ፤ “ህንተ ካሰካ ጋትያ አከናን ዛልኤቴድታ፤ ቃይ ሀእካ ሚሻ እመናን ጮ ዎዘታና። <verse eid="ISA 52:3"/><verse number="4" style="v" sid="ISA 52:4"/>ታ አሳይ ኮይሮ በተ ግዲደ፥ ግብጼ ቢታ ቤዳ፤ ሽን አሶረቱ ታ አሳ ጮ ኡቁኔድኖ። <verse eid="ISA 52:4"/><verse number="5" style="v" sid="ISA 52:5"/>መና ጎዳይ፥ ታ አሳይ ጋትያ ጭገናን ጮ ኦሞዱዋን ብ ክችና፥ ታዉ ሀዋን አዬ ደእያዌ? ኡንቱንታ ሞድያዋንቱ ዋሲኖ፤ ታ ሱንይካ ኡባ ገደ ጋላሳ ኩመን ቦረቴ ያጌ መና ጎዳይ።<note caller="-" style="x"><char style="xo" closed="false">52:5 </char><char style="xt" closed="false"><ref loc="ROM 2:24">ሮመ 2:24</ref></char></note> <verse eid="ISA 52:5"/><verse number="6" style="v" sid="ISA 52:6"/>ሄዋ ድራዉ፥ ታ አሳይ ታ ሱን ኤራና፤ ሄ ጋላስ ሃሳይያዌ ታና ግድያዋ ኡንቱንቱ ኤራና። ኤ ሄዌ ታና። ታን ጾሳይ ሀዋ ኦዳይ” ያጌ።<verse eid="ISA 52:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 52:7"/>ሎኦ ምሽራቹዋ አህያ፥ ሳሮተ ኦድያ፥ ናሸችያ ምሽራቹዋ ኦድያ፥ አቶተ ኦድያነ፥ ጽዮኖካ፥ “ነ ጾሳይ ካተቴ” ጊደ ደረቱዋ ቦላና ይያ ብታንያ ገደቱ ዎት ሎእኖ!<note caller="-" style="x"><char style="xo" closed="false">52:7 </char><char style="xt" closed="false"><ref loc="NAM 1:15">ናሆማ 1:15</ref>፤ <ref loc="ROM 10:15">ሮመ 10:15</ref>፤ <ref loc="EPH 6:15">ኤፈ. 6:15</ref></char></note> <verse eid="ISA 52:7"/><verse number="8" style="v" sid="ISA 52:8"/>ስስተ፥ ህንተ ካታማ ናግያዋንቱ ባረንቱ ቃላ ቁ ኦደ፥ ናሸቻዉ እትፐ የጺኖ፤ መና ጎዳይ ጽዮነ ስምያ ዎደ፥ እ ስሞዋ ኡንቱንቱ ባረንቱ አይፍያን በአና። <verse eid="ISA 52:8"/><verse number="9" style="v" sid="ISA 52:9"/>ህንተኖ የሩሳላመን ኮለቴዳ ሳቶ፥ እትፐ ናሸቻዉ የጽተ፤ አያዉ ጎፐ፥ መና ጎዳይ ባረ አሳ ምንዳ፤ የሩሳላመ ካታማካ ዎዜዳ። <verse eid="ISA 52:9"/><verse number="10" style="v" sid="ISA 52:10"/>መና ጎዳይ ባረ ጌሻ ቀስያ ካዉተቱዋ ኡባ ስንን ቆንጭሴዳ፤ ቃይ ቢታ ጋጻይ ኡባይካ ኑ ጾሳ አቶተ በአና።<verse eid="ISA 52:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 52:11"/>ህንተኖ መና ጎዳ ጎልያ ሚሻቱዋ ቶክያዋንቶ፥ ክችተ፥ ክችተ፤ ያፐ ከስተ። ቱናባ ቦቾፕተ፤ አ ግዶፐ ከስ ክችተ። ህንተ ሁጲያዉካ ጌይተ።<note caller="-" style="x"><char style="xo" closed="false">52:11 </char><char style="xt" closed="false"><ref loc="2CO 6:17">2 ቆሮ. 6:17</ref></char></note> <verse eid="ISA 52:11"/><verse number="12" style="v" sid="ISA 52:12"/>ሽን ከሲደ፥ ኤለካ ከስክታ፤ ዎይ በቲደ ቢክታ፤ አያዉ ጎፐ፥ መና ጎዳይ ህንተፐ ስንዉ አደ ካለና፤ እስራኤልያ ጾሳይካ ጉየና ግዲደ፥ ህንተና ናጋና።<verse eid="ISA 52:12"/></para>
  <para style="s1">መቱ ጋክያ ቆማ</para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 52:13"/>ጾሳይ ሀዋዳን ያጌ፤ “በእተ፥ ታ ቆማይ አኬካን ኦና፤ እ ቦንቼቲደ፥ ቁ ቁ ጋና፤ እ ሎይ ግታታና። <verse eid="ISA 52:13"/><verse number="14" style="v" sid="ISA 52:14"/>አ ሶምኢ አሳ ኡባዋፐ፥ አ ማላይካ አሳ ናና ኡባፐ ቆሄቴዳ፤ አ በኢደ፥ ዳሮ አሳይ ዳጋሜዳ። <verse eid="ISA 52:14"/><verse number="15" style="v" sid="ISA 52:15"/>ሽን ሀእ ዳሮ ካዉተቱ ኡባይ አባን ማላለታና፤<note caller="-" style="x"><char style="xo" closed="false">52:15 </char><char style="xt" closed="false"><ref loc="ROM 15:21">ሮመ 15:21</ref></char></note> አፐ ደንዴዳዋን፥ ካተቱ ባረንቱ ዶና ኦይቃና፤ አያዉ ጎፐ፥ ኡንቱንቱ ባረዉ ኦደትቤናዋ በአና፤ ስስቤናዋካ አኬካና” ያጌ።<verse eid="ISA 52:15"/></para>
  <chapter eid="ISA 52"/>
  <chapter number="53" style="c" sid="ISA 53"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 53:1"/>ኑን ኦዴዳዋ ኦን አማኔዴ? መና ጎዳይ ባረ ዎልቃ ኦና በሴዴ?<note caller="-" style="x"><char style="xo" closed="false">53:1 </char><char style="xt" closed="false"><ref loc="JHN 12:38">ዮሃ. 12:38</ref>፤ <ref loc="ROM 10:16">ሮመ 10:16</ref></char></note> <verse eid="ISA 53:1"/><verse number="2" style="v" sid="ISA 53:2"/>እ አ ስንን መላ ጋድያን ደእያ ዱሩማፐ ጻጱዋ የዲደ፥ አጭያ ያላጋ አጫዳን ድጬዳ። ኑን አ ሎይ ጼላናዉ፥ አዉ ማላይ ዎይ ፑላይ ባዋ፤ ኑን አኮ ሺቃናዉ አዉ ፑል ባዋ። <verse eid="ISA 53:2"/><verse number="3" style="v" sid="ISA 53:3"/>እ አሳን ካቴዳነ እጸቴዳ፤ እ ሀርግያፐነ መቱዋፐ ሻከት ኤረና ካዮትያ አሳ ግዴዳ። እ አሳይ አ በአናፐ ጊደ፥ ባረ ሶምኡዋ ዎራ ዛርያ አሳዳን ካቴዳ፤ ኑንካ አ ቦንችበይኮ።<verse eid="ISA 53:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 53:4"/>እ ቱሙ ኑ ሀርግያ ባረዉ አኬዳ፤<note caller="-" style="x"><char style="xo" closed="false">53:4 </char><char style="xt" closed="false"><ref loc="MAT 8:17">ማቶሳ 8:17</ref></char></note> ቃይ ኑ ካዩዋካ ቶኬዳ። ሽን አ ጋኬዳ መቱ፥ ደሸይነ ዋዪ ጾሳፐ አዉ ዬዳዋ ጊደ ኑን ቆፔዶ። <verse eid="ISA 53:4"/><verse number="5" style="v" sid="ISA 53:5"/>ሽን እ ኑ ባይዙዋ ድራዉ፥ ጫደቲደ ማዱንጼዳ፤<note caller="-" style="x"><char style="xo" closed="false">53:5 </char><char style="xt" closed="false"><ref loc="1PE 2:24">1 ጰጽ. 2:24</ref></char></note> ኑ ናጋራ ድራዉካ ሾጨቲደ ሊቄዳ። እ ሙረቴዳዋን፥ ኑን ሳሩዋ ደሜዶ፤ አ ማዱን ኑን ፓጼዶ። <verse eid="ISA 53:5"/><verse number="6" style="v" sid="ISA 53:6"/>ኑን ኡባይ ኦግያ ባሌዳ ዶርሳቱዋዳን ዎራ ቤዶ፤<note caller="-" style="x"><char style="xo" closed="false">53:6 </char><char style="xt" closed="false"><ref loc="1PE 2:25">1 ጰጽ. 2:25</ref></char></note> ኑን ኡባይካ ኑ ኦግያዉ ኦግያዉ ስሜዳ። መና ጎዳይ ኑ ኡባይ ናቄዳ ናቁዋ አ ቦላ ዎዳ።<verse eid="ISA 53:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 53:7"/>እ ኡንኤቴዳነ ቆሄቴዳ፤ ሽን ባረ ዶና ፖክቤና።<note caller="-" style="x"><char style="xo" closed="false">53:7 </char><char style="xt" closed="false"><ref loc="REV 5:6">ሳፃ 5:6</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">53:7-8 </char><char style="xt" closed="false"><ref loc="ACT 8:32-33">ኪታ 8:32-33</ref></char></note> ሹካናዉ አፍያ ዶርሳዳን ላገቴዳ፤ ባረ እስክያ ሜድያዋንቱ ስንን ጮኡ ግያ ዶርሳ ማራዳን፥ እካ ባረ ዶና ፖክቤና። <verse eid="ISA 53:7"/><verse number="8" style="v" sid="ISA 53:8"/>ኡንቱንቱ አ ኡቁኒደነ አ ቦላ ሱገ ፕርዳ ፕርዲደ አፌድኖ። እ ታ አሳ ባይዙዋ ድራዉ ሾጨቲደ፥ ፓጻ ደእያዋንቱ ቢታፐ እ ክቼዳዋ አ ዛርያፐ ኦኔ አኬኬዳዌ? <verse eid="ISA 53:8"/><verse number="9" style="v" sid="ISA 53:9"/>እ ባረ ሀይቁዋን ኢታ አሳቱዋና ፓይደቴዳ፤<note caller="-" style="x"><char style="xo" closed="false">53:9 </char><char style="xt" closed="false"><ref loc="1PE 2:22">1 ጰጽ. 2:22</ref></char></note> ሀይቂደካ ዱረ አሳ ዱፉዋን ሞገቴዳ። ግዶፐነ፥ ኢታባ እ ኦቤና፤ ባረ ዶናንካ ዎርዱዋ ሃሳይቤና።<verse eid="ISA 53:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 53:10"/>ሽን እ ቆሄታናዌ መና ጎዳ ሸነ ግዴዳ፤ ቃይ መና ጎዳይ እ ቱጋታናዳን ኦዳ። እ ባረና ናጋራዉ ያርሹዋ ኦያ ዎደ፥ ባረ ዘረ በአና። አ ባረካ አዱቃና፤ መና ጎዳ ሸኒካ አ ኩሽያን ፖለታና። <verse eid="ISA 53:10"/><verse number="11" style="v" sid="ISA 53:11"/>አ ሸምፑ ዋየቴዳዋፐ ጉይያን፥ እ ደኡዋ ፖኡዋ በአና፤ ናሸታና። ታ ጽሎ ቆማይ ባረ ኤራተን ዳሮቱዋ ጽልሳና፤ ኡንቱንቱ ባይዙዋካ ቶካና። <verse eid="ISA 53:11"/><verse number="12" style="v" sid="ISA 53:12"/>ሄዋ ድራዉ፥ ዎልቃማ አሳቱ ግዱዋን ታን አዉ ቦንቾ ሳኣ ሻካደ እማና፤<note caller="-" style="x"><char style="xo" closed="false">53:12 </char><char style="xt" closed="false"><ref loc="MRK 15:28">ማር. 15:28</ref>፤ <ref loc="LUK 22:37">ሉቃሳ 22:37</ref></char></note> ቃይ ምኖቱዋና እ ኦሞዱዋ ሻካና። አያዉ ጎፐ፥ እ ባረ ሸምፑዋ ሀይቆ አደ እሜዳ፤ ያቲደ ባይዛንቻቱዋና ፓይደቴዳ። ግዶፐነ፥ እ ዳሮ አሳ ናጋራ ቶኬዳ፤ ባይዛንቻቶካ ጋናቴዳ።<verse eid="ISA 53:12"/></para>
  <chapter eid="ISA 53"/>
  <chapter number="54" style="c" sid="ISA 54"/>
  <para style="ms">ጾሳይ እሜዳ ህዶታ ናግያዋ ግዱሳ</para>
  <para style="mr">(<ref loc="ISA 54:1-55:13">ኢሳ. 54:1—55:13</ref>)</para>
  <para style="s1">ጾሳይ እስራኤልያ ሲቅያ ሲቁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 54:1"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ሀነ፥ የላቤና ማይናቴ፥ የጻ!<note caller="-" style="x"><char style="xo" closed="false">54:1 </char><char style="xt" closed="false"><ref loc="GAL 4:27">ጋላ. 4:27</ref></char></note> ኔኖ፥ ኦይይ ኦይቂ ኤረናኔ፥ ነ ቃላ ቁ ኦደ እልላ! አያዉ ጎፐ፥ ባረ አስናና ደእያ ማጫን ናናቱዋፐ፥ ባረካ ደእያ ማጫን ናናይ ዳራና። <verse eid="ISA 54:1"/><verse number="2" style="v" sid="ISA 54:2"/>ነ ዱንካንያ ሳኣ አሳ፤ ቃይ ኔን ደእያ ሳኣን ጋርዳቱዋካ ፕድ ኦደ ምጫ። ጉየ ጎፓ፤ ዎዶሩዋካ አዱሳ፤ ሽካልያካ ምንሳ። <verse eid="ISA 54:2"/><verse number="3" style="v" sid="ISA 54:3"/>ኔን ኡሸቻ ባጋናነ ሀድርሳ ባጋና አካና፤ ነ ዛራቱ ካዉተቱዋ ላታና፤ ኡንቱንቱ መላ ካታማቱዋን ኬጺደ ኡታና።<verse eid="ISA 54:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 54:4"/>“ያዮፓ፤ አያዉ ጎፐ፥ ኔን ዬላታካ። ዳጋሞፓ፤ አያዉ ጎፐ፥ ኔን ካዉሻካ። ኔን ነ ያላጋተ ዬላ ዶጋና፤ ነ አምኤተ ቦርያካ ሀዋፐ ስንን ሀሳያካ። <verse eid="ISA 54:4"/><verse number="5" style="v" sid="ISA 54:5"/>አያዉ ጎፐ፥ ኔና መዳዌ ነዉ አስና፤ አዉ ሱንይካ ኡባፐ ዎልቃማ መና ጎዳ። እስራኤልያ ጌሻይ ኔና ዎዜዳዋ፤ እ ቢታ ኡባ ጾሳ ጌተቴ” ያጌ። <verse eid="ISA 54:5"/><verse number="6" style="v" sid="ISA 54:6"/>ነ ጾሳይ ሀዋዳን ያጌ፤ “አስናይ ኡባና አግ ባሽና፥ ዶገታደ ካዮትያ ማጫ ምሽራቲዳንነ ያላጋተን አስና ጎለፐ ከሴዳ ምሽራቲዳን ኔን ሀና ደእሽን፥ ታን መና ጎዳይ ኔና ዛራ ጼሳድ።<verse eid="ISA 54:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 54:7"/>“እት ጉ ዎድያዉ ታን ኔና አጋድ፤ ሽን ዎልቃማ ማሮታን ኔና ታን ዛራ ሺሻና። <verse eid="ISA 54:7"/><verse number="8" style="v" sid="ISA 54:8"/>ሱልያ ሀንቁዋን፥ ታን ታ ዴሙዋ ኔፐ ጉ ዎድያዉ ገንድ፤ ሽን መና ሲቁዋን ታን ነዉ ቃረታና” ያጌ። መና ጎዳይ፥ ኔና ዎዝያዌ ሀዋ ኦዴ።<verse eid="ISA 54:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 54:9"/>ነዉ ቃረትያ መና ጎዳይ ሀዋዳን ያጌ፤ “ሀዌ ታዉ ኖሄ ዎድያ ማላ። ሄ ዎደ ታን ኖሄ ዎዴ ባሻ ሃይ ላኤንዋ ሳኣ ምተናዳን ጫቃድ፤<note caller="-" style="x"><char style="xo" closed="false">54:9 </char><char style="xt" closed="false"><ref loc="GEN 9:8-17">ዶመ 9:8-17</ref></char></note> ሄዋዳንካ፥ ኔና ላኤን ሀንቀተናንነ ሴረናን አጋናዉ ታን ጫቃድ። <verse eid="ISA 54:9"/><verse number="10" style="v" sid="ISA 54:10"/>ደረቱ ቃጻናዉ፥ ዞዘቱካ ባረንቱ ደኢያሳፐ ክቻናዉ ዳንዳዪኖ፤ ሽን ታ አገና ሲቁ ኔፐ ሻከተና፤ ታ ሳሮተ ጫቁካ ክቼና” ያጌ።<verse eid="ISA 54:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 54:11"/>ጾሳይ ሀዋዳን ያጌ፤<note caller="-" style="x"><char style="xo" closed="false">54:11-12 </char><char style="xt" closed="false"><ref loc="REV 21:18-21">ሳፃ 21:18-21</ref></char></note> “ኔኖ፥ መቶቴዳ ካታማቴ! ጎቲ ያነ ሃነ ሾጬዳነ፥ ምንያብ ዬዳነ፥ በአ፥ ታን ኔና ቦንቾ ሹቻን አሌቂሳደ ኬጻና፤ ነ ባሱዋንካ ሳምፔርያ ግያ ሹቻ ሂጻና። <verse eid="ISA 54:11"/><verse number="12" style="v" sid="ISA 54:12"/>ነ አዱሳ ሹቻ ግምቢያን ደእያ ጉምቡዋ ታን እንቁዋ ግያ ዳሮ አልኦ ዞኦ ሹቻን ግምባና፤ ነ ፐንግያ ጶልያ አልኦ እንቁዋን፥ ነ ድርሳ ኡባካ ቦንቾ ሹቻን ግምባና። <verse eid="ISA 54:12"/><verse number="13" style="v" sid="ISA 54:13"/>ነ አቱማ ናናቱዋ ኡባ መና ጎዳይ ታማርሳና፤<note caller="-" style="x"><char style="xo" closed="false">54:13 </char><char style="xt" closed="false"><ref loc="JHN 6:45">ዮሃ. 6:45</ref></char></note> ነ ናናቱ ሳሮተይካ ዳራና። <verse eid="ISA 54:13"/><verse number="14" style="v" sid="ISA 54:14"/>ኔን ጽሎተን ምናደ ኤቃና፤ ሱገይነ ኡቁናይ ኔፐ ሃካና። ኔን አያዉካ ያያካ፤ ዳጋማይካ ኔኮ ሺቀና። <verse eid="ISA 54:14"/><verse number="15" style="v" sid="ISA 54:15"/>ኔና ኦላናዉ ደንድያዌ ደኦፐ፥ ሄዌ ታ ሸንያ ኦና፤ ታን ነ ባጋ ግድያ ድራዉ፥ ኔና ኦላናዉ ደንድያ ኡባይ ኩንዳና።<verse eid="ISA 54:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 54:16"/>“በአ፥ ዎምፒናን ታማ ፑኒደ፥ ባረ ሀልቾ ሀንያ ኦላ ሚሻ ቆጽያ አሳቱዋ ታን መድ። ቃይ ባይዛናዳን፥ ባይዝያዋንታካ ታን መድ። <verse eid="ISA 54:16"/><verse number="17" style="v" sid="ISA 54:17"/>ኔና ቆሀናዉ ኦዳ አይ ሚሻይነ ኔና ቆሂደ ካን ከሰና። ኔና ሞትያ እንጻርሳ ኡባዉ ግድያ ዛሩዋ ኔን እማና። መና ጎዳ ቆማቱ ላታይ ሀዋ፤ ኡንቱንታ ታን ሻትንና” ያጌ። መና ጎዳይ ሄዋ ኦዴ።<verse eid="ISA 54:17"/></para>
  <chapter eid="ISA 54"/>
  <chapter number="55" style="c" sid="ISA 55"/>
  <para style="s1">ጾሳፐ ቤትያ ማሮታ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 55:1"/>ጾሳይ ሀዋዳን ያጌ፤<note caller="-" style="x"><char style="xo" closed="false">55:1 </char><char style="xt" closed="false"><ref loc="REV 21:6">ሳፃ 21:6</ref>፤ <ref loc="REV 22:17">22:17</ref></char></note> “ህንተኖ ሳመቴዳዋንቶ፥ ኡባይካ ሃኮ ሃ ዪተ፤ ሻሉ ባይናዋንቶ፥ ሃይተ። ሻምተ፤ ሚተ። ሃ ዪደ፥ ሚሻ ጭገናን ጮ ዎይንያ ኤሳካ ማካ ሻምተ። <verse eid="ISA 55:1"/><verse number="2" style="v" sid="ISA 55:2"/>ህንተ ሚሻ ቁማ ግደናባዉ አያዉ ከሲቴ? ካልሰናዋን ህንተ ዎልቃ አያዉ ዉርሲቴ? አነ ሎይደ፥ ታን ኦድያዋ ስስተ፤ ሎኦባ ሚተ፤ ቃይ ሞዋን ህንተ አሳተ ናሸችተ።<verse eid="ISA 55:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 55:3"/>“ታ አሳዉ፥ ስስተ፤ ታኮ ሃ ዪተ።<note caller="-" style="x"><char style="xo" closed="false">55:3 </char><char style="xt" closed="false"><ref loc="ACT 13:34">ኪታ 13:34</ref></char></note> ሸምፑዋና ፓጻ ደአና ጎፐ፥ ታን ኦድያዋ ስስተ። ታን ህንተናና መና ጫቁዋ ጫቀታና። ታን አንጃና ጋደ ዳዊታ አንጄዳዋዳን፥ ህንተናካ አንጃና። <verse eid="ISA 55:3"/><verse number="4" style="v" sid="ISA 55:4"/>በእተ፥ ታን አ አሳዉ ማርካ፥ ካለያዋነ ካፑዋ ኡዳድ። <verse eid="ISA 55:4"/><verse number="5" style="v" sid="ISA 55:5"/>በአ፥ ኔን ኤረና ካዉተቱዋ ጼሳና፤ ቃይ መና ጎዳ ነ ጾሳ እስራኤልያ ጌሻ ጋሱዋን፥ ኔና ኤረና ካዉተቱ ኔኮ ኤሌሊደ ያና። አያዉ ጎፐ፥ ጾሳይ ኔና ቦንቼዳ” ያጌ።<verse eid="ISA 55:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 55:6"/>መና ጎዳይ ቤትያ ዎደ አ ኮይተ፤ ማታን ደእያ ዎደ አ ጼስተ። <verse eid="ISA 55:6"/><verse number="7" style="v" sid="ISA 55:7"/>ኢታይ ባረ ኦሱዋ፥ ናጋራንቻይካ ባረ ቆፋ አጎ፤ ጾሳኮ እ ስሞ። እ አ ማራና። እ ኑ መና ጎዳኮ ስሞ። እ አዉ ጮ አቶ ጋና።<verse eid="ISA 55:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 55:8"/>አያዉ ጎፐ፥ መና ጎዳይ፥ “ታ ቆፋይ ህንተ ቆፋ ማላ ግደና፤ ህንተ ኦጊካ ታ ኦግያ ማላ ግደና። <verse eid="ISA 55:8"/><verse number="9" style="v" sid="ISA 55:9"/>ሳሎቱ ሳኣፐ ቂያዋዳን፥ ታ ኦጊ ህንተ ኦግያፐ ቄ፤ ታ ቆፋይካ ህንተ ቆፋፐ ቄ። <verse eid="ISA 55:9"/><verse number="10" style="v" sid="ISA 55:10"/>እራይነ ሱፓ ሻቻይ ሳሉዋፐ ዎደ፥ ቢታ አሊደ፥ ሞካናዳንነ አይፋናዳን ኦያዋዳን፥ ቃይ ዘርያዎ ዘረ፥ ምያዋዉካ ካ እመናን ጉየ ሳሉዋ ስመናዋዳን፥<note caller="-" style="x"><char style="xo" closed="false">55:10 </char><char style="xt" closed="false"><ref loc="2CO 9:10">2 ቆሮ. 9:10</ref></char></note> <verse eid="ISA 55:10"/><verse number="11" style="v" sid="ISA 55:11"/>ታ ዶናፐ ከስያ ቃላይካ ሄዋ ማላ። እ ታን ሀልቼዳዋ ፖላና፤ ቃይ ኪቴዳዋ ኦናፐ አትና፥ ታኮ ጮ ስመና።<verse eid="ISA 55:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 55:12"/>“ህንተ ናሸቻን ከሳና፤ ሳሩዋን ሞይዘታና። ደረቱነ ከራቱ ህንተ ስንን ናሸቲደ የጻና፤ ደምባን ደእያ ምቱ ኡባይካ ባረንቱ ኩሽያ ባቃና። <verse eid="ISA 55:12"/><verse number="13" style="v" sid="ISA 55:13"/>አጉን ድራዉ ጺዳይ፥ ጎምኦርያ ድራካ ጻይይ ሞካና። ሄዌ መና ጎዳይ ሀሳየትያዋነ መናዉ የና ማላታ ግዳናዋ” ያጌ።<verse eid="ISA 55:13"/></para>
  <chapter eid="ISA 55"/>
  <chapter number="56" style="c" sid="ISA 56"/>
  <para style="s1">አሳ ዛሪ ኡባይ ጾሳ ባጋ ግዳናዉ ዳንዳዩሳ</para>
  <para style="r">(<ref loc="ISA 56:1-8">56:1-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 56:1"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ቱሙ ፕርዳ ናግተ፤ ጽሎባ ሀንተ፤ አያዉ ጎፐ፥ ታ አሹ ኤሌሊደ ያና፤ ታ ጽሎተይካ ማታን ቆንጫና። <verse eid="ISA 56:1"/><verse number="2" style="v" sid="ISA 56:2"/>ሀዋ ኦያ ኡራ፥ ሳምባታ ቱንሰናዳን ቦንችያ ኡራነ ኢታባ ኦናን እጽያ ኡራ ታን አንጃና” ያጌ።<verse eid="ISA 56:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 56:3"/>መና ጎዳኮ ሺቄዳ በቲ፥ “መና ጎዳይ ታና ባረ አሳፐ ቱሙ ሻካና” ጎፖ። ቃይ ሙይሬሳይካ፥ “በአ፥ ታን መሌዳ ም” ጎፖ።<verse eid="ISA 56:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 56:4"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ታ ሳምባታቱዋ ቦንችያ፥ ታና ናሸችያባ ዶርያነ ታ ጫቁዋ ምንሲደ ናግያ ሙሬሳቶ፥ <verse eid="ISA 56:4"/><verse number="5" style="v" sid="ISA 56:5"/>ኡንቱንቶ ታን ታ ጌሻ ጎልያ ግዱዋንነ ታ ድርሳ ግምቢያ ግዶን፥ ኡንቱንቱ ሀሳየትያዋ እማና። ማጫ ናናቱዋፐነ አቱማ ናናቱዋፐ ሎእያ ሱን ታን ኡንቱንቶ እማና፤ ታን ኡንቱንቶ መናዉ የና ሱን እማና። <verse eid="ISA 56:5"/><verse number="6" style="v" sid="ISA 56:6"/>መና ጎዳዉ ኦናዉ፥ መና ጎዳ ሱን ዶሳናዉነ አ ቆማ ግዳናዉ፥ ባረንታ አኮ ሺሽያ በተቱዋ፥ ቃይ ሳምባታ ቱንሰናን ቦንችያዋንታነ ታ ጫቁዋ ምንሲደ ናግያዋንታ ኡባቱዋ <verse eid="ISA 56:6"/><verse number="7" style="v" sid="ISA 56:7"/>ታን ታ ጌሻ ደርያ አሀና፤ ታ ዎሳ ጎልያን ኡንቱንታ ናሸቻና። ኡንቱንቱ ታ ያርሽያ ሳኣ ቦላን ሺሽያ፥ ጹግያ ያርሹነ ሀራ ያርሹ አከታና፤ አያዉ ጎፐ፥ ታ ጎሊ አሳይ ኡባይ ጾሳ ዎስያ ጎልያ ጌተታና” ያጌ።<note caller="-" style="x"><char style="xo" closed="false">56:7 </char><char style="xt" closed="false"><ref loc="MAT 21:13">ማቶሳ 21:13</ref>፤ <ref loc="MRK 11:17">ማር. 11:17</ref>፤ <ref loc="LUK 19:46">ሉቃሳ 19:46</ref></char></note><verse eid="ISA 56:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 56:8"/>እስራኤልያፐ ላለቴዳዋንታ ሺሽያ፥ ኡባ ሞድያ መና ጎዳይ፥ “ሺቄዳዋንቱ ቦላ ጉጃደ፥ ታን ሀራቱዋካ ሺሻና” ያጌ።<verse eid="ISA 56:8"/></para>
  <para style="s1">ጾሳዉ አማነተና ካለያዋንቱ ፕርደቱሳ</para>
  <para style="r">(<ref loc="ISA 56:9-59:21">ኢሳ. 56:9—59:21</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 56:9"/>ህንተኖ ባዙዋ ዶአቶ፥ ህንተኖ ዎራን ደእያ ዶአቶ፥ ኡባይካ ሃ ዪደ ሚተ። <verse eid="ISA 56:9"/><verse number="10" style="v" sid="ISA 56:10"/>እስራኤልያ አሳ ናግያዋንቱ ቆቀ፤ ኡንቱንቶ ኡባዉካ ኤር ባዋ። ኡንቱንቱ ኡባይካ ቦጫናዉ ዳንዳየና ዱደ ካናቱዋ ማላ። ኡንቱንቱ ግሲደ አኩመቲኖ፤ ኡንቱንቱ ገምእሹዋ ዶሲኖ። <verse eid="ISA 56:10"/><verse number="11" style="v" sid="ISA 56:11"/>ኡንቱንቱ ሚደ ካለና ካና ማላ፤ ካል ኤርክኖ። ኡንቱንቱ አኬክ ፓጬዳ ሄንንቻ፤ ኡንቱንቱ ኡባይ ባረንቱ ኦግያ ኦግያ ስሜድኖ፤ ኡባይካ ባረንቱ ጎአ ጻላላ ኮዪኖ። <verse eid="ISA 56:11"/><verse number="12" style="v" sid="ISA 56:12"/>ኡንቱንቱ ኡባይካ፥ “ሃ ዪተ፤ ዎይንያ ኤሳ አነ ኡሼቶ። አነ ኑ ማይያ ኡሻ ኩመን ጋነቶ! ዎንታይካ ሀች ማላ ግዳናዋ፤ ዎይ ሀችፐካ አ ሎአና” ያጊኖ።<verse eid="ISA 56:12"/></para>
  <chapter eid="ISA 56"/>
  <chapter number="57" style="c" sid="ISA 57"/>
  <para style="s1">እስራኤላቱ ኤቃዉ ጎይንያ ጎይኑ ፕርደቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 57:1"/>ጽሎ አሳይ ሀይቄ፤ ሽን ሄዋ አኬኪደ ቆፕያዌ ባዋ። ባረና ጾሳዉ እሜዳ አሳቱ ጋድያፐ ዪኖ፤ ሽን ጽሎ አሳይ ባሻይ ያናፐ ካሰቲደ አከትያዋ ኦንነ አኬከና። <verse eid="ISA 57:1"/><verse number="2" style="v" sid="ISA 57:2"/>እ ቢደ ሳሮተይ ደእያ ሳኣ ገሌ። ሱረተን ሀመትያዋንቱ ሀይቂደ ሸምፑዋ ደሚኖ።<verse eid="ISA 57:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 57:3"/>ጾሳይ ሀዋዳን ያጌ፤ “ህንተኖ፥ ሻሬቻት ናቶ፥ ህንተኖ ዎሹምያንነ ሻርሙጽያን ዘረቶ፥ ሃይተ። <verse eid="ISA 57:3"/><verse number="4" style="v" sid="ISA 57:4"/>ህንተ ኦ ቦላ ቅሊጪቴ? ህንተ ኦና ህንተ ዶናን ቦቺቴ? ህንተ እንጻርሳካ ኦ ቦላ ከሲቴ? ህንተ ማካላንቻቱዋ ናናቱዋነ ዎርዳንቻቱዋ ናናቱዋ ግድክቴ? <verse eid="ISA 57:4"/><verse number="5" style="v" sid="ISA 57:5"/>ህንተ ዎላ ግዱዋንነ ዳሻ ም ኡባ ጋርሳን አሙዋን ጹገቲታነ ቱናባ ኦታ፤ ህንተ ናናቱዋካ ዛንጋራ ሾባንነ ሹቻ ጎንጎሉዋን ሹኪደ ያርሺታ። <verse eid="ISA 57:5"/><verse number="6" style="v" sid="ISA 57:6"/>ዛንጋራ ሾባን ደእያ ሊቆ ሹቻቱ ህንተ ጾሳቱዋ። ህንተ ኡንቱንቶ ኡሻ ያርሹዋ ትጌድታ፤ ካ ያርሹዋካ እሜድታ። ያትና፥ ታን ሀዋን ኡባን ናሸትያዋ ህንተንቶ ማላቲ? <verse eid="ISA 57:6"/><verse number="7" style="v" sid="ISA 57:7"/>ሎይ ቃነ አዱሳ ደርያ ሁጲያን ህንተ ግሱዋ የጌድታ፤ ያን ያርሻናዉ ፑደ ከሴድታ። <verse eid="ISA 57:7"/><verse number="8" style="v" sid="ISA 57:8"/>ህንተ ፐንግያፐነ ቆስለፐ ሶ ባጋና ኤቃ ምስለቱዋ ኤሴድታ። ታና አግ ባሺደ፥ ህንተ አርሳ አሲደ፥ ያ ፑደ ከሴድታ። ኡንቱንቱና ጫቁዋ ጫቀቴድታ፤ ያቲደ ኡንቱንቱ አርሳ ዶሴድታ፤ ኡንቱንቱ ካሉዋካ በኤድታ። <verse eid="ISA 57:8"/><verse number="9" style="v" sid="ISA 57:9"/>ዛይትያ አኪደ፥ ሞሎካ ግያ ኤቃኮ ቤድታ፤ ህንተ ሽቱዋካ ዳርሴድታ፤ ህንተዉ ኪተትያዋንታ ሃኮ ሳ ኪቴድታ፤ ሀራይ አትና፥ ስኦልያ ጋካናዉ ዎድታ። <verse eid="ISA 57:9"/><verse number="10" style="v" sid="ISA 57:10"/>ህንተ ሀራ ጾሳቱዋ ኮዪደ ዳቡሬድታ፤ ሽን፥ ‘ህዶት ባዋ’ ያግበይክታ። ህንተ ዎልቃይ ሃ ኦራጼዳ፤ ሄዋ ድራዉ፥ ላባኒደ ኩንድበይክታ።<verse eid="ISA 57:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 57:11"/>“ህንተ ኦስ ያዪደ፥ ታዉ ዎርዶቴድቴ? ህንተ ታና ሀሳይበይክታ፤ ህንተ ዎዛናንካ ቆፕበይክታ። ታን ዳሮ ዎድያ ጮኡ ጌዳ ድራዉ ግደኔ፥ ህንተ ታዉ ያየናን አጌዳዌ? <verse eid="ISA 57:11"/><verse number="12" style="v" sid="ISA 57:12"/>ታን ህንተ ጽሎተነ ህንተ ኦሶቱዋ ቆንጭሳና፤ ሽን ህንተና አይነ ጎእክኖ። <verse eid="ISA 57:12"/><verse number="13" style="v" sid="ISA 57:13"/>ህንተ ዋስያ ዎደ፥ ህንተ ሺሼዳ ኤቃቱ ህንተና አሽኖ! ኡንቱንታ ኡባካ ጫርኩ አክ አፋና፤ እቶደን ሸምፕያ ሸምፑ ኡንቱንታ ፑን ይሳና። ሽን ታና ባረዉ ባቃት አትያሳ ኦያ አሳይ ቢታ ላታና፤ ታ ጌሻ ደርያካ እ አካና” ያጌ።<verse eid="ISA 57:13"/></para>
  <para style="s1">ጾሳይ ባረ አሳ ማዳናዉነ ፓናዉ እሜዳ ህዶታ</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 57:14"/>ጾሳይ ሀዋዳን ያጌ፤ “ግምቢተ፥ ግምቢተ! ኦግያካ ጊግስተ፤ ታ አሳ ኦግያፐ ቢያዋ ኡባ ድግተ” ያጌ። <verse eid="ISA 57:14"/><verse number="15" style="v" sid="ISA 57:15"/>አያዉ ጎፐ፥ መናዉ ደእያዌ፥ ግታይ፥ ቃን ደእያዌ፥ አ ሱንይካ ጌሻ ጌተትያዌ፥ ሀዋዳን ያጌ፤ “ታን ቁ ጌዳነ ጌሻ ሳኣን ደአይ፤ ግዶፐነ፥ ባረንቱ ኦዳ ናጋራዉ ካዮቲደ ስምያዋንቱናነ ባረና ዝቂ ኦያዋንቱና ደአይ። ያታደ ታን ባረንቱ ኦዳ ናጋራዉ ካዮቲደ ስምያዋንቱ አያናነ ባረና ዝቂ ኦያዋንቱ ዎዛና ኦራጽሳይ። <verse eid="ISA 57:15"/><verse number="16" style="v" sid="ISA 57:16"/>ታን መናዉ ሞትከ፤ ኡባ ገደካ ሀንቀትከ። አሳ አያናይ፥ ታን መዳ አሳ ሸምፑ ዳቡራና። <verse eid="ISA 57:16"/><verse number="17" style="v" sid="ISA 57:17"/>ኡንቱንቱ ናጋራ ጋሱዋንነ ኡንቱንቱ ያርያ ጋሱዋን፥ ታን ኡንቱንታ ሀንቀታድ። ኡንቱንታ ሾጫድ፤ ታ ስንካ ኡንቱንቱፐ ገንድ። ሽን ኡንቱንቱ ሀእካ ስሚደ፥ ባረንቱ ዎዛና ቆፋን ቤድኖ። <verse eid="ISA 57:17"/><verse number="18" style="v" sid="ISA 57:18"/>ታን ኡንቱንቱ ኦገቱዋ በኣድ፤ ሽን ታን ኡንቱንታ ፓና፥ ካለናነ ዬክያዋንታ ምንና። <verse eid="ISA 57:18"/><verse number="19" style="v" sid="ISA 57:19"/>እስራኤልያ ጋድያን ዬክያዋንቱ መተርሻን ጋላታ ዎና። ሃኩዋንነ ማታን ደእያዋንቶ ሳሩ ግዶ። ታን ኡንቱንታ ፓና” ያጌ መና ጎዳይ።<note caller="-" style="x"><char style="xo" closed="false">57:19 </char><char style="xt" closed="false"><ref loc="EPH 2:17">ኤፈ. 2:17</ref></char></note> <verse eid="ISA 57:19"/><verse number="20" style="v" sid="ISA 57:20"/>ሽን ኢታቱ ቡሉቂያነ ኡርቃ ፑደ ፑሻክያ፥ ዎፑ ጋናዉካ ዳንዳየና አባ ቤታ ማላ። <verse eid="ISA 57:20"/><verse number="21" style="v" sid="ISA 57:21"/>ታ ጾሳይ፥ “ኢታቶ ሳሩ ባዋ” ያጌ።<note caller="-" style="x"><char style="xo" closed="false">57:21 </char><char style="xt" closed="false"><ref loc="ISA 48:22">ኢሳ. 48:22</ref></char></note><verse eid="ISA 57:21"/></para>
  <chapter eid="ISA 57"/>
  <chapter number="58" style="c" sid="ISA 58"/>
  <para style="s1">ቱሙ ጾማ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 58:1"/>ጾሳይ ሀዋዳን ያጌ፤ “ነ ቃላ ቁ ኦደ ዋሳ፤ ጉየ ጎፓ። ነ ኮሻ ማላካታዋዳን ቂሳ። ታ አሳዉ ኡንቱንቱ ማካላ፥ ያቆባ ጎልያ አሳዉካ ኡንቱንቱ ናጋራ ኦዳ። <verse eid="ISA 58:1"/><verse number="2" style="v" sid="ISA 58:2"/>ሽን ኡንቱንቱ ታና ሀች ሀች ኮዪኖ፤ ታ ኦግያካ ካላናዉ ዶስያዋ ማላቲኖ። ጽሎባ ኦዳ ካተተዳንነ ጾሳ አዛዙዋ ኦልቤና አሳዳን፥ ኡንቱንቱ ታና ሱረ ፕርዳ ኦቺኖ፤ ታኮ ጾሳኮ ሺቃናዉካ ዶሲኖ” ያጌ።<verse eid="ISA 58:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 58:3"/>ኡንቱንቱ ሺቂደ ጾሳ፥ “ኑን ጾሜዶ፤ ሽን ኔን አያዉ ኑና ጼላበይኪ? ኑን ኑናተ ካዉሼዶ፤ ሽን ኔን ኑና አያዉ ኤራበይኪ?” ያጊኖ።</para>
  <para style="p" vid="ISA 58:3">ጾሳይ ዛሪደ፥ ኡንቱንታ ሀዋዳን ያጌ፤ “በእተ፥ ህንተ ጾምያ ጋላስ ህንተና ናሸችያባ ኦታ፤ ህንተ ኦሳንቻ ኡባ ኡቁኒታ። <verse eid="ISA 58:3"/><verse number="4" style="v" sid="ISA 58:4"/>በእተ፥ ህንተ ዋላሳዉነ ዋታዉ ጾሚታ፤ ቃይ መቀ ባይና ደሸ ደቻናዉ ጾሚታ። ሀቼ ህንተ ጾምያ ሀዋ ማላ ጾማይ፥ ህንተ ቃላይ ቦላን ስሰታናዳን ኦና። <verse eid="ISA 58:4"/><verse number="5" style="v" sid="ISA 58:5"/>ታን ዶርያ ጾማይ ሀዋ ማሌየ? እት አሳይ ባረናተ ካዉሽያዌ ሀዋ ማላ ጋላሳኔየ? ቃይ ታን ኮይያ ጾማይ አሳይ ባረ ሁጲያ ጬጫዳን ዱገ ሆክስያዌየ? ብድን ቆሊደ፥ ማቃ ሂጺደ ግስያዌየ? ያትና፥ ሄዋ ጾማ ጊደ ጼጊቴየ? ቃይ ሄ ጾምያ ጋላሳይካ መና ጎዳይ ናሸትያ ጋላሳ ጌተቲየ?<verse eid="ISA 58:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 58:6"/>“ታን ዶሬዳ ጾማ ሀዋ በእተ፦ ፕርዳን ናቂደ ቃቼዳዋንቱ ሳንሳላታ ለፕያዋ፥ ሞርገ ም ጎንያ ብልያዋ፥ ኡቁነቴዳዋንታ ኡቁኑዋፐ ከስያዋነ ሞርገ ም ኡባ መንያዋ። <verse eid="ISA 58:6"/><verse number="7" style="v" sid="ISA 58:7"/>ቃይ ታን ዶሬዳ ጾማይ ኮሻቴዳዎ ህንተ ቁማ ሻክያዋ፥ ጎሊ ባይና ህዬሳቱዋ ጎልያ አክያዋ፥ ካሎቴዳዋንታ በእያ ዎደ፥ ማይዝያዋ፥ ማዱዋ ኮይያ ህንተ ዳቡዋፐ ህንተ ዴሙዋ ገንናን አግያዋ።<note caller="-" style="x"><char style="xo" closed="false">58:7 </char><char style="xt" closed="false"><ref loc="MAT 25:35">ማቶሳ 25:35</ref></char></note><verse eid="ISA 58:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 58:8"/>“ያቶፐ፥ ህንተ ፖኡ ዎንታ ጻልቂያዳን ፖአና፤ ህንተ ፓጻተይካ ኤለካ ያና። ህንተ ጽሎተይ ህንተፐ ስንና ባና፤ መና ጎዳ ቦንቹካ ህንተፐ ጉየና ግዲደ፥ ህንተና ናጋና። <verse eid="ISA 58:8"/><verse number="9" style="v" sid="ISA 58:9"/>ሄ ዎደ ህንተ ጼሳና፤ መና ጎዳይ ህንተንቶ ኮያና። ህንተ ማዱዋ አካናዉ ዋሳና፤ እካ፥ ‘ሄኮ፥ ታን ሀዋን ደአይ!’ ያጋና።</para>
  <para style="p" vid="ISA 58:9">“ህንተ ግዶፐ ህንተ ኡቁንያ ሞርገ ም ድጎፐ፥ ቃይ ብራያን ማላትያዋነ ኢታባ ሃሳይያዋ አጎፐ፥ <verse eid="ISA 58:9"/><verse number="10" style="v" sid="ISA 58:10"/>ኮሻቴዳዋ ቁማ ሙዚደ ካልሶፐ፥ ናቀቴዳዋ እ ኮይያዋ ካልሶፐ፥ ሄ ዎደ ህንተ ፖኡ ማን ፖአና፤ ህንተ ቃማይካ ሴታ ጋላሳ ግዳናዋ። <verse eid="ISA 58:10"/><verse number="11" style="v" sid="ISA 58:11"/>መና ጎዳይ ህንተና ኡባ ገደ ካለና፤ ህንተና መላ ባዙዋን ኮሽያዋካ እ ህንተዉ ኩንና። ህንተ ቦላ ጻጱዋካ ምንሳና። ቃይ ህንተ ሃ ኡሽያ ገነትያ ማላነ አ ሃይ ሙለካ ቶኤና ፑልቱዋ ማላ ግዳናዋ። <verse eid="ISA 58:11"/><verse number="12" style="v" sid="ISA 58:12"/>በን ኮለቴዳዋንታ ህንተ ዛረደ ኬጻና፤ ዳሮ ዎድያፐ ካሰ ባሰቴዳ ባሶቱካ ኬጸቲደ ቁ ጋና። ህንተካ ኮለቴዳ ግምበቱዋ ዛረደ ግምቢያዋንታነ አሳይ ደእያ ሳአቱዋን ኦግያ ከስያዋንታ ጌተት ጼሰታና” ያጌ።<verse eid="ISA 58:12"/></para>
  <para style="s1">ሳምባታ ቦንችያዋ ዎይቱዋ</para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 58:13"/>ቃይካ ጾሳይ ሀዋዳን ያጌ፤ “ሳምባታ መና ጎዳዉ ዱማ ጋላሳዳን ጼሎፐ፥ ሄ ታ ጌሻ ጋላስ ህንተ ጎኣ የደርስያዋንታ ግዳና ዮፐ፥ ሳምባታ ናሸችያነ ቦንቼቴዳ ጾሳ ጋላሳ ቦንቹዋ ጊደ ጼሶፐ፥ ቃይካ ህንተ ህንተ ኦግያ ቤናን አጊደ፥ ቦንችያዋ ግዶፐ፥ ዎይ ህንተና ናሸችያባ ኦናንነ ሀዳባ ሃሳየናን አጎፐ፥ <verse eid="ISA 58:13"/><verse number="14" style="v" sid="ISA 58:14"/>ሄ ዎደ ህንተ መና ጎዳን ናሸታና። ቃይ ታን ህንተና ዳሮ ቦንቼቴዳዋንታ ኦና፤ ህንተ አዉዋ ያቆባ ጋድያፐ ላተቴዳዋ ህንተ ማናዳን፥ ታን ህንተና ኦና። ታን መና ጎዳይ ሀዋ ሃሳያድ” ያጌ።<verse eid="ISA 58:14"/></para>
  <chapter eid="ISA 58"/>
  <chapter number="59" style="c" sid="ISA 59"/>
  <para style="s1">ትምቢትያ ኦድያዌ አሳ ናጋራ ፕርዴዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 59:1"/>በእተ፥ መና ጎዳ ኩሺ ህንተና አሻናዉ ቃምቤና፤ አ ሀይይካ ስሰናን እጻናዉ ቱልቤና። <verse eid="ISA 59:1"/><verse number="2" style="v" sid="ISA 59:2"/>ሽን ህንተ ናጋራይ ህንተፐነ ህንተ ጾሳፐ ግዱዋን ሻኮተ መዳ። ቃይ እ ስሰና ማላ፥ ህንተ ናጋራይ አ ዴሙዋ ህንተፐ ገንዳ። <verse eid="ISA 59:2"/><verse number="3" style="v" sid="ISA 59:3"/>አያዉ ጎፐ፥ ህንተ ኩሺ ሱን፥ ህንተ ብራካ ናቁዋን ቱኔዳ፤ ህንተ ዶናይ ዎርዱዋ ሃሳየ፤ ህንተ እንጻርሳይካ ኢታባ ዙዙሜ።<verse eid="ISA 59:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 59:4"/>ጽሎተን ሞትያዌ ባዋ፤ ቱማተን ፕርድያዌካ ባዋ። ኡንቱንቱ መላ ፓሉምያን ጬቀቲኖ፤ ዎርዱዋ ሃሳዪኖ። ቃይ መቱዋ ሻሃሪደ፥ ኢታተ የሊኖ። <verse eid="ISA 59:4"/><verse number="5" style="v" sid="ISA 59:5"/>ኡንቱንቱ ሾሻ ቁቁልያ ቆጺኖ፤ ሻራሮትያ ጎልያካ ኬጺኖ። ኡንቱንቱ ቁቁለቱዋ ምያ አሳይ ሀይቄ፤ ቁቁልያፐ እቱ መኦፐ፥ ሾሻይ አ ግዶፐ ከሴ። <verse eid="ISA 59:5"/><verse number="6" style="v" sid="ISA 59:6"/>ኡንቱንቱ ኬጼዳ ሻራሮታት ጎሊ ማያናዉ ኡንቱንታ ጎኤና። ኡንቱንቱ ባረንቱ መዳዋን ባረና ካምክኖ። ኡንቱንቱ ኦሱ ኢታ ኦሶ፤ ማካላ ኦሱ ኡንቱንቱ ኩሽያን ደኤ። <verse eid="ISA 59:6"/><verse number="7" style="v" sid="ISA 59:7"/>ኡንቱንቱ ገደቱ ኢታባ ኦናዉ ዎጺኖ፤ ጽሉዋ ሱ ጉሳናዉካ ጃሚኖ። ኡንቱንቱ ቆፋይ ኢታ ቆፋ። ኡንቱንቱ ቤዳ ሳ ኡባን ቆሁነ ባሻይ ደኤ።<note caller="-" style="x"><char style="xo" closed="false">59:7-8 </char><char style="xt" closed="false"><ref loc="ROM 3:15-17">ሮመ 3:15-17</ref></char></note> <verse eid="ISA 59:7"/><verse number="8" style="v" sid="ISA 59:8"/>ኡንቱንቱ ሳሮተ ኦግያ ኤርክኖ፤ ኡንቱንቱ ብያ ኦግያን ሱረ ፕርድ ባዋ፤ ኡንቱንቱ ባረንቱ ኦግያ ጌላዬድኖ፤ ሄ ኦገቱዋና ሀመትያ ኦንነ ሳሮተ ኤረና።<verse eid="ISA 59:8"/></para>
  <para style="s1">አሳይ ባረ ናጋራ ፓጼ</para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 59:9"/>ሄዋ ድራዉ፥ ሱረ ፕርዳይ ኑፐ ሃኬዳ፤ ጽሎተይካ ኑኮ ጋከና። ኑን ፖኡዋ ኮዬቶ፤ ሽን በእተ፥ ማ ግዴዳ፤ ዎልቃማ ፖኡዋ ኮዬቶ፤ ሽን ማን ሀመቴቶ። <verse eid="ISA 59:9"/><verse number="10" style="v" sid="ISA 59:10"/>ኑን አይፊ ባይና ቆቅያዳን፥ ድርሳ ግምቢያኮ ታታፌቶ። ሳአይ ለምእለምእና ሀመትያዋዳን፥ ሴታ ጋላስ በቴቶ። ቃይ ኩመን ዎልቃና ደእያ አሳቱዋ ግዶን ኑን ሀይቄዳ አሳቱዋ ማላ ግዴዶ። <verse eid="ISA 59:10"/><verse number="11" style="v" sid="ISA 59:11"/>ኑን ኡባይካ ጋሙዋዳን ጉዴቶ፤ ሀራጰቱዋዳንካ ካዮቲደ ኦሌቶ። ኑን ሱረ ፕርዳ ኮዬዶ፤ ሽን ደምበይኮ። ቃይ አቶተካ ኮዬዶ፤ ሽን እ ኑፐ ሃኬዳ።<verse eid="ISA 59:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 59:12"/>አያዉ ጎፐ፥ ኑ ባይዙ ነ ስንን ዳሬዳ፤ ኑ ናጋራይካ ኑ ቦላ ማርካቴ። ኑ ባይዙ ኑናና ደኤ፤ ኑ ናቁዋካ ኑን ኤሬቶ። <verse eid="ISA 59:12"/><verse number="13" style="v" sid="ISA 59:13"/>ኑን ማካሊደ፥ ጾሳ ካዴዶ፤ ኑ መና ጎዳ ካልያዋ አጊደ፥ ጉየ ስሜዶ፤ ሱገነ ገንያ ሃሳዬዶ። ቃይ ኑን ሻሃሬዳ ዎርዶ ቃላ ኑ ዎዛናፐ የሌዶ። <verse eid="ISA 59:13"/><verse number="14" style="v" sid="ISA 59:14"/>ሱረ ፕርዳይ ጉየ ሱገቴዳ፤ ጽሎተይካ ኑፐ ሃኬዳ፤ አያዉ ጎፐ፥ ቱማተይ ጉታራን በቴ፤ አማነትያ ሀኖታዉ ገልያ ሳአይ ዬዳ። <verse eid="ISA 59:14"/><verse number="15" style="v" sid="ISA 59:15"/>ቱማተይ ሀቃንነ ቤተና፤ ኢታተፐ ሃክያ አሳይ ባረዉ ኦሞደቴ።</para>
  <para style="s1" vid="ISA 59:15">ጾሳይ ባረ አሳ አሻናዉ ጊግ ኡቴዳ</para>
  <para style="p" vid="ISA 59:15">መና ጎዳይ በኢደ፥ ሱረ ፕርዳይ ባይናዎ ካዮቴዳ። <verse eid="ISA 59:15"/><verse number="16" style="v" sid="ISA 59:16"/>ኡቁነቴዳዋንታ ማድያ አሳይ ባይናዋ ጾሳይ በኤዳ፤ ጋናትያ አሳይ ባይናዎ ጋራመቴ። ሄዋ ድራዉ፥ አ ቀሲ አዉ አቶተ አሄዳ። አ ጽልቶተይ አ ዘምፕሲደ ኦይቄዳ።<note caller="-" style="x"><char style="xo" closed="false">59:16 </char><char style="xt" closed="false"><ref loc="ISA 63:5">ኢሳ. 63:5</ref></char></note> <verse eid="ISA 59:16"/><verse number="17" style="v" sid="ISA 59:17"/>ጾሳይ ጽሎተ ትራን ዎያ ኦላ ሚሻዳን ማዬዳ፤ ባረ ሁጲያንካ አቶተ ቆብያ ዎዳ። ሀሉዋ ከስያ ማዩዋካ ማዪደ፥ ምሹዋ ቁማዩዋ ቁማዬዳ።<note caller="-" style="x"><char style="xo" closed="false">59:17 </char><char style="xt" closed="false"><ref loc="EPH 6:14">ኤፈ. 6:14</ref>፣ <ref loc="EPH 6:17">17</ref>፤ <ref loc="1TH 5:8">1 ተስ. 5:8</ref></char></note> <verse eid="ISA 59:17"/><verse number="18" style="v" sid="ISA 59:18"/>እ ኡንቱንቶ ኡንቱንቱ ኦሱዋዳን ኦሱዋዳን ዛራና፤ ባረ ሞርከቶ ሀንቁዋ፥ ባረ ባልጋራቶካ ሙሩዋ ዛራና። አባ ዶና ቢታቱዋን ደእያዋንቶ ኡንቱንቱ ኦሶ በስያዋ እማና። <verse eid="ISA 59:18"/><verse number="19" style="v" sid="ISA 59:19"/>ሄዋ ድራዉ፥ አዋይ ዉልያ ባጋና ደእያዋንቱ መና ጎዳ ሱንዉ ያያና፤ አዋይ ዶልያ ባጋና ደእያዋንቱካ አ ቦንቹዋ ያያና። አያዉ ጎፐ፥ መና ጎዳ ጫርኩ ጋጋን የድና፥ ጎግያ ድኡዋዳን እ ያና።<verse eid="ISA 59:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 59:20"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ታን ጽዮነዉነ ያቆባ ዛራቱዋን ባረንቱ ናጋራፐ ስምያዋንቶ ዎዝያዋ ግዳደ ያና” ያጌ።<note caller="-" style="x"><char style="xo" closed="false">59:20 </char><char style="xt" closed="false"><ref loc="ROM 11:26">ሮመ 11:26</ref></char></note><verse eid="ISA 59:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 59:21"/>ቃይካ መና ጎዳይ ሀዋዳን ያጌ፤ “ታና ግዶፐ፥ ታን ኡንቱንቱና ጫቀትያ ጫቁ ሀዋ: ህንተ ቦላን ደእያ ታ አያናይነ ታን ህንተ ዶናን ዎዳ ታ ቃላይ ሀችፐ ዶሚደ፥ መና ጋካናዉ፥ ህንተ ዶናፐ፥ ህንተ ናናቱ ዶናፐነ ህንተ ናናቱ ናናቱ ዶናፐ ሻከተና። ታን መና ጎዳይ ሀዋ ኦዳይ” ያጌ።<verse eid="ISA 59:21"/></para>
  <chapter eid="ISA 59"/>
  <chapter number="60" style="c" sid="ISA 60"/>
  <para style="s1">የሩሳላመ ስን ቦንቾ ህዶታ</para>
  <para style="r">(<ref loc="ISA 60:1-62:12">60:1—62:12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 60:1"/>ጾሳይ ሀዋዳን ያጌ፡ “ደንዳ! ደንዳደ ፖእሳ፤ አያዉ ጎፐ፥ ነ ፖኡ ዬዳ። መና ጎዳ ቦንቹካ ነ ቦላን ፖኤዳ። <verse eid="ISA 60:1"/><verse number="2" style="v" sid="ISA 60:2"/>በአ፥ ማይ ሳኣ ካማና፤ ባራ ማይካ አሳ ቦላን ዎና። ሽን መና ጎዳይ ነ ቦላ ደንዳና፤ አ ቦንቹካ ነ ቦላ ፖአና። <verse eid="ISA 60:2"/><verse number="3" style="v" sid="ISA 60:3"/>ካዉተቱ ነ ፖኡዋኮ፥ ካተቱካ ነ ዎንታ ዋጃጃኮ ያና።<verse eid="ISA 60:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 60:4"/>“ቁ ጋደ ነ ዩሹዋ ጼላ። ኡንቱንቱ ኡባይ እትፐ ሺቂደ፥ ኔኮ ያና። ነ አቱማ ናናይ ሃኩዋፐ ያና፤ ነ ማጫ ናናይካ ባኤቲደ፥ ኔኮ ያና። <verse eid="ISA 60:4"/><verse number="5" style="v" sid="ISA 60:5"/>ሄ ዎደ ኔን በኣደ ናሸታና፤ ነ ዎዛናይካ ሎይ ፖጩ ጋና። አያዉ ጎፐ፥ አባ ቦላን ደእያ ግዳይ ኔኮ ስማና፤ ካዉተቱዋ ዱረተይካ ኔኮ ያና። <verse eid="ISA 60:5"/><verse number="6" style="v" sid="ISA 60:6"/>ምድያማ ቢታፐነ ኤፋ ጋድያፐ ዬዳ ያላጋ ጋሎቱዋ ዉዲ ነ ቢታ ካማና። ቃይ ዎርቃነ እጻና ጫነቴዳ ጋሎቱ መና ጎዳ ጋላታ አዋዪደ፥ ሳባፐ ያና። <verse eid="ISA 60:6"/><verse number="7" style="v" sid="ISA 60:7"/>ቄዳረነ ናባዮታ ዶርሳ ዉደቱ ኡባይ ያርሾ ታ ያርሹዋ ሳኣ ኔኮ ሺቃና፤ ቃይ ታንካ ታ ቦንቾ ጌሻ ጎልያ ቦንቻና።<verse eid="ISA 60:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 60:8"/>“ሀ ሻርያዳንነ ባረንቱ ጎልያኮ ፓልያ ሀራጰቱዋዳን ፓልያዋንቱ ኦኔ? <verse eid="ISA 60:8"/><verse number="9" style="v" sid="ISA 60:9"/>ሀዋንቱ ሃን ዶደቴዳ ቢታቱ ታናን ህዶታ ኦና። እስራኤልያ ጌሻይ መና ጎዳይ ህንተ ጾሳይ ህንተና ቦንቼዳ ድራዉ፥ ተርሴሰ ማርካባቱ ስንት ከሲደ ነ ናናቱዋ ሃኮ ቢታፐ ኡንቱንቱ ብራናነ ዎርቃና ጾሳ ቦንቾ አሀና።<verse eid="ISA 60:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 60:10"/>“አላጋ ጋድያ አሳይ ነ ድርሳ ግምባና፤ ኡንቱንቱ ካተቱ ነዉ ኦና። ኔና ታን ታ ሀንቁዋን ካሰ ሾጬዳዋ ግዶፐካ፥ ሀእ ታ ቃረታን ታን ኔና ማራድ። <verse eid="ISA 60:10"/><verse number="11" style="v" sid="ISA 60:11"/>ነ ፐንገቱ ኡባ ገደ ዶያ ደአና።<note caller="-" style="x"><char style="xo" closed="false">60:11 </char><char style="xt" closed="false"><ref loc="REV 21:25-26">ሳፃ 21:25-26</ref></char></note> ካዉተቱዋ ዱረተነ ኦሞደቴዳ ካተቱዋ ኔኮ አሀና ማላ፥ ጋላስካ ቃማካ ጎርደትክኖ። <verse eid="ISA 60:11"/><verse number="12" style="v" sid="ISA 60:12"/>ነዉ ኦና አሳይ ዎይ ካዉተይ ኡባይ ኡባና ያና። <verse eid="ISA 60:12"/><verse number="13" style="v" sid="ISA 60:13"/>ታ ጌሻ ጎልያ ሳኣ ሎይና ማላ፥ ሊባኖሳ ቦንቹ፥ ዝጋይ፥ ጺዳይነ ጻይይ ኔኮ ያና፤ ታን ታ ገድያ ዎያ ሳኣ ቦንቻና። <verse eid="ISA 60:13"/><verse number="14" style="v" sid="ISA 60:14"/>ኔና ኡቁኔዳዋንቱ አቱማ ናናይ ነዉ ሆኪደ፥ ኔኮ ያና፤<note caller="-" style="x"><char style="xo" closed="false">60:14 </char><char style="xt" closed="false"><ref loc="REV 3:9">ሳፃ 3:9</ref></char></note> ኔና ካዳ ኡባቱ ነ ስንን ጎይናና። ኡንቱንቱ ኔና፥ ‘መና ጎዳ ካታማቴ ጽዮኔ፥ እስራኤልያ ጌሻ ካታማቴ’ ያጊደ ጼሳና።<verse eid="ISA 60:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 60:15"/>“ኦንነ ነ ግዶና አናዋ ኬና ኔን ካሰ ኦለታዳነ እጸታዳ። ሽን ሀእ ታን ኔና መናዉ ዎልቃማ ኦና፤ ቃይ የለታ ኡባይ ናሸትያ ሳ ኦና። <verse eid="ISA 60:15"/><verse number="16" style="v" sid="ISA 60:16"/>ኔን ካዉተቱዋ ማ ኡሻና፤ ካተቱ ንካ ማና። ሄዋፐ ጉይያን፥ ታን መና ጎዳይ ኔና አሽያዋ፤ ዎዝያዋነ፥ ያቆባ ዎልቃማ ግድያዋ ኔን ኤራና። <verse eid="ISA 60:16"/><verse number="17" style="v" sid="ISA 60:17"/>ናሃስያ ድራዉ ዎርቃ፥ ብራታ ድራካ ብራ፥ ም ድራዉ ናሃስያ፥ ሹቻ ድራዉ ብራታ ታን ነዉ አሀና። ታን ኔና ሞድያዋንታ ሳሮ፥ ነ ካፖቱዋካ ጽሉዋ ኦና። <verse eid="ISA 60:17"/><verse number="18" style="v" sid="ISA 60:18"/>ሀዋፐ ጉይያን፥ ሱገ ኦሱ ነ ጋድያን ስሰተና፤ ነ ዛዋንካ ላለይነ ባሻይ ስሰተና። ኔን ነ ድርሳ ግምቢያ፥ ‘አቶተ’ ነ ፐንገቱዋካ፥ ‘ጋላታ’ ያጋደ ጼሳና።<verse eid="ISA 60:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 60:19"/>“ሄዋፐ ጉይያን፥ ጋላስ ነዉ አዋ ፖኡዋ ኮሸና፤<note caller="-" style="x"><char style="xo" closed="false">60:19 </char><char style="xt" closed="false"><ref loc="REV 21:23">ሳፃ 21:23</ref>፤ <ref loc="REV 22:5">22:5</ref></char></note> ቃማካ አግና ፖኡዋ ኮሸና። አያዉ ጎፐ፥ መና ጎዳይ ነዉ መና ፖኦ ግዳናዋ፤ ነ ጾሳይ ነዉ ቦንቾ ግዳናዋ። <verse eid="ISA 60:19"/><verse number="20" style="v" sid="ISA 60:20"/>ነ አዋይ ላኤን ዉለና፤ ነ አግናይካ ፖእያዋ አገና። አያዉ ጎፐ፥ መና ጎዳይ ነዉ መና ፖኦ ግዳናዋ፤ ኔን ዬኬዳ ጋላሳቱካ ዉራና። <verse eid="ISA 60:20"/><verse number="21" style="v" sid="ISA 60:21"/>ነ አሳይ ኡባይ ጽሉዋ ግዳናዋ፤ ኡንቱንቱ ቢታቶካ መናዉ ላታና። ኡንቱንቱ ታን ታ ቦንቹዋ ቆንጭሳናዉ ቶኬዳ ፑተቱዋ፤ ኡንቱንቱ ታ ኩሽያ ኦሶቱዋ። <verse eid="ISA 60:21"/><verse number="22" style="v" sid="ISA 60:22"/>ህንተ ግዶን እት ጎልያን ደእያ ፓይዱዋን ጉ አሳቱዋ ታን ሻእሳና፤ ኡባፐ ፓይዱዋን ጉጽያዋንታካ ዎልቃማ ካዉተ ኦና። ታን መና ጎዳ፤ ዎዲ ጋክያ ዎደ፥ ታን ሀዋ ኤለካ ፖላና” ያጌ።<verse eid="ISA 60:22"/></para>
  <chapter eid="ISA 60"/>
  <chapter number="61" style="c" sid="ISA 61"/>
  <para style="s1">አቶተ ምሽራቹዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 61:1"/>ኡባ ሞድያ መና ጎዳ አያናይ ታ ቦላን ደኤ፤<note caller="-" style="x"><char style="xo" closed="false">61:1 </char><char style="xt" closed="false"><ref loc="MAT 11:5">ማቶሳ 11:5</ref>፤ <ref loc="LUK 7:22">ሉቃሳ 7:22</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">61:1-2 </char><char style="xt" closed="false"><ref loc="LUK 4:18-19">ሉቃሳ 4:18-19</ref></char></note> አያዉ ጎፐ፥ ቆሄቴዳዋንቶ ሎኦ ምሽራቹዋ ኦዳና ማላ፥ ጾሳይ ታና ኦኬዳ። እ ታና ዎዛናይ መኤዳዋንቶ ኮለትያዋነ ኦሞደቴዳዋንቶ ኦሞዱዋፐ ከስያዋ አዋያና ማላነ ቃሸቴዳዋንቶ ብለ አዋያና ማላ ኪቴዳ። <verse eid="ISA 61:1"/><verse number="2" style="v" sid="ISA 61:2"/>መና ጎዳይ ዶሬዳ ላይነ ኑ ጾሳይ ሀሉዋ ከስያ ጋላሳ አዋያና ማላነ ካዮትያዋንታ ኡባቱዋ ምንና ማላ፥ ታና ኪቴዳ።<note caller="-" style="x"><char style="xo" closed="false">61:2 </char><char style="xt" closed="false"><ref loc="MAT 5:4">ማቶሳ 5:4</ref></char></note> <verse eid="ISA 61:2"/><verse number="3" style="v" sid="ISA 61:3"/>ሄዋዳንካ ቃይ፥ ጽዮነን ካዮትያዋንቶ፥ ብድን ድራዉ ካላቻ፥ ካዩ ድራዉ ናሸቻ ዛይትያ፥ ላባና አያና ድራዉ ጋላታ ቁማዩዋ እማና ማላ፥ ታና ኪቴዳ። ኡንቱንቱ መና ጎዳይ ባረ ቦንቾ ቶኬዳ ጽሎ ም ጌተቲደ ጼሰታና።<verse eid="ISA 61:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 61:4"/>ኡንቱንቱ በን ኮለቴዳዋንታ ዛረደ ኬጻና፤ በን ኩንዴዳዋንታካ ዛረደ ኤሳና። ኡንቱንቱ ኦኔዳዋንታነ ዳሮ የለታፐ ካሰ ኮለቴዳ ካታማቱዋ ዛረደ ኬጻና። <verse eid="ISA 61:4"/><verse number="5" style="v" sid="ISA 61:5"/>አላጋ ቢታ አሳቱ ህንተ ዶርሳ ዉድያ ሄማና፤ እማቱካ ህንተ ጋድያ ጎሻናነ ህንተ ዎይንያ ቱራ ናግያዋንታ ግዳና። <verse eid="ISA 61:5"/><verse number="6" style="v" sid="ISA 61:6"/>ህንተ ቃይ፥ “መና ጎዳ ቄሳቱ ዋ” ጌተቲደ ጼሰታና፤ አሳይካ ህንተና፥ “ኑ ጾሳ ኦሳንቻቱዋ” ያጊደ ጼሳና። ህንተ ካዉተቱዋ ዱረተ ማና፤ ኡንቱንቱ ዱረተንካ ህንተ ጬቀታና።<verse eid="ISA 61:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 61:7"/>ህንተ ዬላ ድራዉ ህንተ ላኡ ኩሽያ ሳማ አካና፤ ካዉሼዳዋ ድራዉካ ህንተ ካጫን ህንተ ናሸታና። ሄዋ ድራዉ፥ ህንተ ህንተ ጋድያን ላኡ ዳኩዋ ላታና፤ ህንተ ናሸቻይካ መና ናሸቻ ግዳናዋ።<verse eid="ISA 61:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 61:8"/>ጾሳይ ሀዋዳን ያጌ፤ “ታን መና ጎዳይ ሱረ ፕርዳ ዶሳይ፤ ቦንቂያነ ባይዙዋ እጻይ። ታን አማነታደ፥ ኡንቱንቱ ኦሱዋ ጋትያ ኡንቱንቶ ጭጋና። ታን ኡንቱንቱና መና ጫቁዋ ጫቀታና። <verse eid="ISA 61:8"/><verse number="9" style="v" sid="ISA 61:9"/>ኡንቱንቱ ዛራቱ ካዉተቱዋ ግዶን፥ ኡንቱንቱ ናናይካ ጋደ አሳቱዋ ግዶን ኤረታና፤ ኡንቱንታ በኤዳ ኡባይ ታን፥ መና ጎዳይ አንጄዳ አሳቱዋ ኡንቱንቱ ግድያዋ ጌሺደ ኤራና” ያጌ።<verse eid="ISA 61:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 61:10"/>ታን መና ጎዳን ሎይ ናሸታይ፤ ታ ሸምፑካ ታ ጾሳን ሀሹ ጌ።<note caller="-" style="x"><char style="xo" closed="false">61:10 </char><char style="xt" closed="false"><ref loc="REV 21:2">ሳፃ 21:2</ref></char></note> አያዉ ጎፐ፥ ቡላችያዌ ባረ ሁጲያን ቄሲ ሻሽያ ዎያዋዳን፥ ቡላቼትያናካ ዱማ ዱማ አሌቁዋን አሌቀትያዋዳን፥ እ ታና አቶተ ማዩዋ ማይዜዳ፤ ጽሎተ ቁማዩዋካ ቦላና ታዉ ጉጄዳ። <verse eid="ISA 61:10"/><verse number="11" style="v" sid="ISA 61:11"/>ቢታይ ጫርሻ ሞክያዋዳንነ አታክልትያ ሳአይካ ቶኬዳዋ ድችያዋዳን፥ ሄዋዳንካ፥ ኡባ ሞድያ መና ጎዳይ ጽሎተነ ጋላታ ካዉተ ኡባ ስንን ፑልትሳና።<verse eid="ISA 61:11"/></para>
  <chapter eid="ISA 61"/>
  <chapter number="62" style="c" sid="ISA 62"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 62:1"/>ጽዮነ ድራዉ፥ ታን ጮኡ ጊከ፤ የሩሳላመ ጽሎተይ ዎልቃማ ፖኡዋዳን፥ እ አቶተይካ ኤጽያ ጾምፕያዳን ፖአና ጋካናዉ፥ ታን ጮኡ ጊከ። <verse eid="ISA 62:1"/><verse number="2" style="v" sid="ISA 62:2"/>ካዉተቱ ነ ጽሎተ፥ ካተቱ ኡባይካ ነ ቦንቹዋ በአና። መና ጎዳይ ባረ ዶናፐ ሱንያ ኦራ ሱንን ኔን ጼሰታና። <verse eid="ISA 62:2"/><verse number="3" style="v" sid="ISA 62:3"/>ኔን መና ጎዳ ኩሽያን ሎኤዳ አሌቁዋነ ካዉተ ካላቻ ማላ ግዳና። <verse eid="ISA 62:3"/><verse number="4" style="v" sid="ISA 62:4"/>ሀዋፐ ስንናዉ ኔን፥ “ዶገታ አቴዳኖ” ጌተታካ። ቃይ ነ ቢታታካ፥ “መላ አቴዳኖ” ጌተቱኩ። ሽን ኔን፥ “ታ ናሸቻይ እን ደእያኖ” ነ ቢታታካ፥ “አስና ገሌዳኖ” ጌተታና። አያዉ ጎፐ፥ መና ጎዳይ ኔናን ናሸታና፤ ነ ቢታትዉካ እ አስና ማላ ግዳናዋ። <verse eid="ISA 62:4"/><verse number="5" style="v" sid="ISA 62:5"/>ዎዳላይ ዎዶራቶ ማችያዋዳን፥ ነ ናናይ ኔና አካና፤ ማቻቶ ቡላችያዌ ቡላቼትያንን ናሸትያዋዳን፥ ሄዋዳንካ፥ ነ ጾሳይ ኔናን ናሸታና።<verse eid="ISA 62:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 62:6"/>ኔኖ የሩሳላመ፥ ነ ድርሳ ግምቢያ ቦላን ዎችያዋንታ ታን ዎድ፤ ኡንቱንቱ ጋላስካ ቃማካ ጮኡ ጊክኖ። <verse eid="ISA 62:6"/><verse number="7" style="v" sid="ISA 62:7"/>ህንተኖ፥ የሩሳላመባ መና ጎዳ ሀሳይስያዋንቶ፥ እ የሩሳላመ ኬጻና ጋካናዉነ ቢታ ኡባ ቦላን ናሸቴዳ ካታማ ኦና ጋካናዉ፥ ህንተዉካ ሸምፖፕተ፤ አካ ሸምፕሶፕተ።<verse eid="ISA 62:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 62:8"/>መና ጎዳይ ባረ ኡሸቻ ኩሽያንነ ባረ ዎልቃማ ቀስያን ሀዋዳን ያጊደ ጫቄዳ፤ “ታን ላኤን ህንተ ካ ህንተ ሞርከቶ ቁማ ኦደ እምከ፤ ቃይ ህንተ ዳቡሬዳ ህንተ ዎይንያ ኤሳካ አላጋቱ ኡሽክኖ። <verse eid="ISA 62:8"/><verse number="9" style="v" sid="ISA 62:9"/>ሽን ጫኬዳዋንቱ ባረንቱ ካ ማና፤ ያቲደ መና ጎዳ ኡንቱንቱ ጋላታና፤ ዎይንያ ቴራ ማጼዳዋንቱ ታ ጌሻ ጎልያ ዳባባን ኡሻና” ያጌ።<verse eid="ISA 62:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 62:10"/>አተ! ፐንግያና ከሲደ ቢተ! አሳዉ ኦግያ ከስተ! ከስተ፥ ዎጋ ኦግያ ከስተ! ሹቻቱዋካ ድግተ፤ ካዉተቱ ኦግያ ደማና ማላ፥ ባንድራ ኤስተ።<verse eid="ISA 62:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 62:11"/>በእተ፥ መና ጎዳይ ቢታ ሳኣ ጋጻን ሀዋዳን ያጊደ አዋዬዳ፤ “ጽዮነ አሳዉ ሀዋዳን ያግተ፤ ‘በእተ፥ ህንተና አሽያዌ ጋኬዳ! በእተ፥ አ ጋቲ አናና ደኤ፤ ኦሶ እ እምያ ኬርሱካ አ ስንን ደኤ’ ያግተ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">62:11 </char><char style="xt" closed="false"><ref loc="ISA 40:10">ኢሳ. 40:10</ref>፤ <ref loc="ISA 22:12">22:12</ref></char></note> <verse eid="ISA 62:11"/><verse number="12" style="v" sid="ISA 62:12"/>ህንተ፥ “መና ጎዳይ ዎዜዳ ጌሻ አሳቱዋ” ጌተቲደ ጼሰታና፤ የሩሳላመካ፥ “ኮየቴዳኖ፥ አግ ባሽቤና ካታማቶ” ጌተታና።<verse eid="ISA 62:12"/></para>
  <chapter eid="ISA 62"/>
  <chapter number="63" style="c" sid="ISA 63"/>
  <para style="ms">ጾሳ ኦራ ማላልስያ መታ</para>
  <para style="mr">(<ref loc="ISA 63:1-66:24">63:1—66:24</ref>)</para>
  <para style="s1">አይሁዳ ግደና አሳቱዋ ጾሳይ ጾንያ ጾኑዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 63:1"/>ኤዶማ ጋድያን ደእያ ቦጽራ ግያ ካታማፐ ዞኦ ማዩዋ ማዪደ ይያዌ፥ ሄዌ እ ኦኔ? ሀ ፑላና ደእያ ማዩዋ ማዪደ፥ ባረ ዎልቃ ምኖተን ስንዉ ሀመትያዌ ኦኔ?<note caller="-" style="x"><char style="xo" closed="false">63:1-6 </char><char style="xt" closed="false"><ref loc="ISA 34:5-17">ኢሳ. 34:5-17</ref>፤ <ref loc="JER 49:7-22">ኤር. 49:7-22</ref>፤ <ref loc="EZK 25:12-14">ህዝ. 25:12-14</ref>፤ <ref loc="EZK 35:1-15">35:1-15</ref>፤ <ref loc="AMO 1:11-12">አሞጻ 1:11-12</ref>፤ <ref loc="OBA 1:1-14">አብድ. 1-14</ref>፤ <ref loc="MAL 1:2-5">ሚልክ. 1:2-5</ref></char></note></para>
  <para style="p" vid="ISA 63:1">ጾሳይ፥ “ሄዌ ጽሉዋ ሃሳይያዌነ ዎልቃን አሽያዌ ታና ግድክታ!” ያጌ።<verse eid="ISA 63:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 63:2"/>ዎይንያ ጉምኢያሳን ዎይንያ የያ ብታንያ ማዩዋዳን፥ ነ ማዩ አያዉ ዞኤዴ?<verse eid="ISA 63:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 63:3"/>ጾሳይ ሀዋዳን ያጊደ ዛራና፤ “ዎይንያ ጉምኢያሳ ታን ታረካ የድ፤ ካዉተቱዋፐ እት አሳይነ ታናና ባዋ። ታን ኡንቱንታ ታ ሀንቁዋን የድ፤ ታ ይሉዋንካ ኡንቱንታ ድርጸረድ። ኡንቱንቱ ሱይ ታ ማዩዋ ቦላን ጨትና፥ ታ ማዩ ኡባይ ባዬዳ።<note caller="-" style="x"><char style="xo" closed="false">63:3 </char><char style="xt" closed="false"><ref loc="REV 14:20">ሳፃ 14:20</ref>፤ <ref loc="REV 19:13">19:13</ref>፣ <ref loc="REV 19:15">15</ref></char></note> <verse eid="ISA 63:3"/><verse number="4" style="v" sid="ISA 63:4"/>ታን ታ አሳ ዎዝያ ጋላሳይነ ኡንቱንቱ ሞርከቶ ሀሉዋ ከስያ ላይይ ጋኬዳ። <verse eid="ISA 63:4"/><verse number="5" style="v" sid="ISA 63:5"/>ታን ጼላድ፤ ሽን ታና ማድያ እት አሳይነ ቤትቤና። ማድያዌ ዬዳ ድራዉ፥ ታን ማላለታድ። ሄዋ ድራዉ፥ ታ ቀሲ ታዉ ጾኑዋ አሄዳ፤ ታ ሀንቁካ ታና ማዴዳ።<note caller="-" style="x"><char style="xo" closed="false">63:5 </char><char style="xt" closed="false"><ref loc="ISA 59:16">ኢሳ. 59:16</ref></char></note> <verse eid="ISA 63:5"/><verse number="6" style="v" sid="ISA 63:6"/>ታን ታ ሀንቁዋን ካዉተቱዋ የድ፤ ታ ይሉዋንካ ኡንቱንታ መንሬድ፤ ኡንቱንቱ ሱካ ታን ጋድያን ጉሳድ” ያጋና።<verse eid="ISA 63:6"/></para>
  <para style="s1">ጾሳይ እስራኤልያዉ ኬክያ ኬካ</para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 63:7"/>መና ጎዳይ ኑዉ ኦዳ ኦሱዋ ኡባ ድራዉ፥ መና ጎዳ አገና ሲቁዋነ አ ጋላታ ታን ኦዳና፤ ኤ፥ ባረ ማሮታንነ ባረ ኬካተ ዳሩዋን እስራኤልያ አሳዉ እ እሜዳ ጮራ ሎኦባ ታን ኦዳና። <verse eid="ISA 63:7"/><verse number="8" style="v" sid="ISA 63:8"/>ጾሳይ ኦዲደ፥ “ኡንቱንቱ ቱሙ ታ አሳቱዋነ ታ ናናቱዋ ግድያ ድራዉ፥ ታና ጭማናዉ ኮይክኖ” ያጌዳ። ሄዋ ድራዉ፥ እ ኡንቱንታ አሽያዋ ግዴዳ። <verse eid="ISA 63:8"/><verse number="9" style="v" sid="ISA 63:9"/>ኡንቱንቱ ዋይያ ኡባን እ ዋየቴዳ። አ ደኡሳ ኪታንቻይ ኡንቱንታ አሼዳ። እ ኡንቱንታ ባረ ሲቁዋንነ ባረ ማሮታን ዎዜዳ። ካሰ አዳ ዎደቱዋ ኡባን እ ኡንቱንታ ደንደ ቶኬዳ።<verse eid="ISA 63:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 63:10"/>ሽን ኡንቱንቱ ማካሌድኖ፤ አ ጌሻ አያናካ ካዮዬድኖ። ሄዋ ድራዉ፥ እ ስሚደ፥ ኡንቱንቶ ሞርከ ግዴዳ፤ ኡንቱንቱናካ ኦለቴዳ።<verse eid="ISA 63:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 63:11"/>ሄዋፐ ጉይያን አሳይ በንዋ፥ እ ባረ ቆማ ሙሴ ዎደ ኦዳዋ ሀሳዪደ፥ ሀዋዳን ያጌዳ፤ “ባረ ዉድያ ሄንንቻቱዋናካ ኡባ አባ ግዶና አደ ከሴዳዌ ሀቃን ደኢ? ቃይ ሄ ዎደ ባረ ጌሻ አያና ኡንቱንቱ ግዶን ዎዳዌ ሀእ ሀቃን ደኢ? <verse eid="ISA 63:11"/><verse number="12" style="v" sid="ISA 63:12"/>ባረ ቦንቹዋ ቀስያ ዎልቃማ ዎልቃ ሙሴዉ ኡሸቻ ኩሽያ ግዳናዳን ኪቴዳዌ፥ ባረ መና ሀይ ከሳናዉ፥ ኡንቱንቱ ስንን ደእያ ሃ ሻኬዳዌ፥<note caller="-" style="x"><char style="xo" closed="false">63:12 </char><char style="xt" closed="false"><ref loc="EXO 14:21">ከሳ 14:21</ref></char></note> <verse eid="ISA 63:12"/><verse number="13" style="v" sid="ISA 63:13"/>ኡንቱንቱ ጪሙዋ ግዶና ፕንዳዌ ሀቃን ደኢ?” ያጌድኖ።</para>
  <para style="p" vid="ISA 63:13">ባዙዋና አያ ፓራዳን፥ ኡንቱንቱ በትበይክኖ። <verse eid="ISA 63:13"/><verse number="14" style="v" sid="ISA 63:14"/>ዎምባ ዱገ ዎያ መህያዳን፥ መና ጎዳ አያናይ ኡንቱንታ ሸምፕሴዳ። ሄዋዳን ኔን ነ ሱን ቦንችሳናዉ ነ አሳ ካለዳ።<verse eid="ISA 63:14"/></para>
  <para style="s1">ማሮታነ ማዱዋ ደማናዉ ዎስያ ዎሳ</para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 63:15"/>አቤት ጾሳዉ፥ ሳሉዋና ዱገ ጼላ፤ ኔን ደእያ ጌሻነ ቦንቾ ግዴዳ ሳፐ ኤለካ በአ። ኔን ምሸትያ ምሹነ ነ ዎልቃይ አኔ? ነ ዎዛናይ ኑና ላሞትያ ላሞታይነ ነ ቃረታይ ኑፐ ሃኬዳ። <verse eid="ISA 63:15"/><verse number="16" style="v" sid="ISA 63:16"/>አብራሃመ ኑና ኤራና ዮፐካ፥ ያቆብ ኑና አኬከናን ዮፐካ፥ አቤት መና ጎዳዉ፥ ኔን ኑ አዉዋ። በን ዎደፐካ ዶሚደ፥ ነ ሱንይ ኑና ዎዝያዋ። <verse eid="ISA 63:16"/><verse number="17" style="v" sid="ISA 63:17"/>አቤት መና ጎዳዉ፥ ኑን ነ ኦግያፐ ባያናዳን፥ አያዉ ኦዲ? ቃይ ኑን ነዉ ያየናዳን፥ ኑ ዎዛና አያዉ ሌፋያዴ? ጾሳዉ፥ ነ ቆማቱ ድራዉ፥ ነ ቢታ ላቴዳ ዛራቱዋ ድራዉ፥ ኑኮ ስማ። <verse eid="ISA 63:17"/><verse number="18" style="v" sid="ISA 63:18"/>ነ ጌሻ አሳይ ነ ጌሻ ጎልያ ጉ ዎድያዉ ላቴድኖ፤ ሽን ኑ ሞርከቱ አ ዱገ ዛሪደ የድኖ። <verse eid="ISA 63:18"/><verse number="19" style="v" sid="ISA 63:19"/>ኑን በንፐካ ነዋንታ፤ ኡንቱንታ ኔን ሞዳባካ፤ ኡንቱንቱ ነ ሱንን ጼሰትበይክኖ።<verse eid="ISA 63:19"/></para>
  <chapter eid="ISA 63"/>
  <chapter number="64" style="c" sid="ISA 64"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 64:1"/>አቤት መና ጎዳዉ፥ ኔን ሳሎቱዋ ዳካደ ዱገ ዎ! ደረቱካ ጋጅ ጋጂደ ኮኮርኖ። <verse eid="ISA 64:1"/><verse number="2" style="v" sid="ISA 64:2"/>ታማይ ቃይጼርያ ሚደ፥ ሃ ፐንትስያዋዳን፥ ዱገ ዎአደ፥ ነ ሱን ነ ሞርከቶ ኤርሳ፤ ካዉተቱዋካ ነ ስንን ኮኮርሳ። <verse eid="ISA 64:2"/><verse number="3" style="v" sid="ISA 64:3"/>ካሰካ ኔን ኑን ናግቤና ማላልስያባ ኦዳ ዎደ ዎአዳ፤ ደረቱ ነ ስንን ጋጅ ጋጂደ ኮኮሬድኖ። <verse eid="ISA 64:3"/><verse number="4" style="v" sid="ISA 64:4"/>በንፐ ዶሚደ፥ ኔናን አማነቲደ፥ ናግያዋንቶ ማላልስያባ ኦዳ ኔፐ አትና፥ ሀራ ጾሳ አሳ ሀይይ ስስቤና፤ አሳ አይፊካ በእቤና።<note caller="-" style="x"><char style="xo" closed="false">64:4 </char><char style="xt" closed="false"><ref loc="1CO 2:9">1 ቆሮ. 2:9</ref></char></note> <verse eid="ISA 64:4"/><verse number="5" style="v" sid="ISA 64:5"/>ጽሎተ ናሸቲደ ኦያዋንታነ ነ ኦግያን ኔና ሀሳይያዋንታ ኔን ጋካደ ማዳሳ። በአ፥ ኔን ሀንቀታዳ፤ ሽን ናጋራ ኦያዋ አግበይኮ። ኑን ናጋራ ኦደ፥ አዱሳ ዎድያ ደኤዶ፤ ያትና፥ ኑን ዋኒደ አታኔ? <verse eid="ISA 64:5"/><verse number="6" style="v" sid="ISA 64:6"/>ኑን ኡባይካ ቱና አሳ ግዴዶ፤ ኑ ጽሎተ ኦሶ ኡባይካ ቅታ ጩርቃ ማላ። ኑን ኡባይካ ቦንጭያዳን ሹሌዶ፤ ኑ ናጋራይ ኑና ጫርኩዋዳን፥ ፕቲደ አፌዳ። <verse eid="ISA 64:6"/><verse number="7" style="v" sid="ISA 64:7"/>ነ ሱን ጼስያዌ፥ ዎይ ኔና ምንስ ኦይካናዉ ኮይያዌ ባዋ። አያዉ ጎፐ፥ ኔን ነ ዴሙዋ ኑፐ ገንደ ናጋራይ ይሳናዳን፤ ኑና ኑ ናጋራ ድራዉ፥ አጋዳ።<verse eid="ISA 64:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 64:8"/>ግዶፐነ፥ አቤት መና ጎዳዉ፥ ኔን ኑ አዉዋ፤ ኑን ኡርቃ፤ ኔን ኡርቃ መዳዋ፤ ኑን ኡባይካ ነ ኩሽያን መቴዶ። <verse eid="ISA 64:8"/><verse number="9" style="v" sid="ISA 64:9"/>አቤት መና ጎዳዉ፥ ሎይ ሀንቀቶፓ፤ ኑ ናጋራካ መናዉ ሀሳዮፓ። ኑና በአ፥ ኑን ኡባይካ ነ አሳ። <verse eid="ISA 64:9"/><verse number="10" style="v" sid="ISA 64:10"/>ነ ጌሻ ካታማቱ ባዙዋ ግዴድኖ፤ ሀራይ አትና፥ ጽዮነ ካታማይካ ባዙዋ ግዴዳ፤ የሩሳላመካ መላ ሳ ግዴዳ። <verse eid="ISA 64:10"/><verse number="11" style="v" sid="ISA 64:11"/>ኑ አዎቱ ኔና ጋላቴዳ ጌሻነ ሎኦ ግዴዳ ኑ ጌሻ ጎሊ ታማን ጹገቴዳ፤ ቃይ ኑ ሎኦ ሳአቱ ኡባይካ ባዬድኖ። <verse eid="ISA 64:11"/><verse number="12" style="v" sid="ISA 64:12"/>አቤት መና ጎዳዉ፥ ኔን ሀዋ ኡባ በኣደካ ኑና አጋኒ? ኔን ጮኡ ጋደ፥ ኑና ዛዋይ ባይና ሙሩዋ ሙራኒ?<verse eid="ISA 64:12"/></para>
  <chapter eid="ISA 64"/>
  <chapter number="65" style="c" sid="ISA 65"/>
  <para style="s1">ጾሳይ ማካላንቻቱዋ ሙሬ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 65:1"/>ጾሳይ ሀዋዳን ያጌ፤ “ታን ታና ኦችቤናዋንቶ ቆንጫድ፤ ቃይ ታና ኮይቤናዋንቶ ቤታድ። ታን ታ ሱን ጼስቤና ካዉተዉ፥ ‘ታ ሀዋና! ታ ሀዋና!’ ያጋደ ኮያድ።<note caller="-" style="x"><char style="xo" closed="false">65:1 </char><char style="xt" closed="false"><ref loc="ROM 10:20">ሮመ 10:20</ref></char></note> <verse eid="ISA 65:1"/><verse number="2" style="v" sid="ISA 65:2"/>ባረ ቆፋ ካሊድ፥ ሎኦ ግደና ኦግያን ሀመትያ ማካላንቻ አሳቱዋኮ ጋላሳ ኡባን ታ ኩሽያ ምጫድ።<note caller="-" style="x"><char style="xo" closed="false">65:2 </char><char style="xt" closed="false"><ref loc="ROM 10:21">ሮመ 10:21</ref></char></note> <verse eid="ISA 65:2"/><verse number="3" style="v" sid="ISA 65:3"/>ሀ አሳይ አታክልትያ ግዶን ያርሺደነ ጹብያ ቦላን እጻና ጩዋዪደ፥ ታን ጼልሽን፥ ታና ኡባ ዎደ ሀንቀኖ። <verse eid="ISA 65:3"/><verse number="4" style="v" sid="ISA 65:4"/>ቃይ ኡንቱንቱ ዱፉዋ ግዶን ኡትያዋንታ፤ ጌማ ሳኣን ቃማ አቅያዋንታ። ጉዱን አሹዋ ምያዋንታ፤ ኡንቱንቱ ጻሩዋን ቱና አሹዋ ጫባይ ደእያዋንታ። <verse eid="ISA 65:4"/><verse number="5" style="v" sid="ISA 65:5"/>ሄዋ ኦደ፥ ኡንቱንቱ ቃይ ሀራቱዋ፥ ‘ያን ህንተንቶ ደእተ፤ ኑን ህንተፐ ጌሻ ግድያ ድራዉ፥ ኑኮ ሺቆፕተ!’ ያጊኖ። ኡንቱንቱ ታ ሲ ግዶፐ ከስያ ጩዋነ ጋላሳ ኡባ ኤጽያ ታማ።<verse eid="ISA 65:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 65:6"/>“በእተ፥ ታ ስንን ጻፈት ኡቴዳ፤ ታን ኡንቱንቶ ዛራናፐ አትና፥ ጮኡ ጊከ፤ ኡንቱንታ ሙራናዉ ቃቻድ። <verse eid="ISA 65:6"/><verse number="7" style="v" sid="ISA 65:7"/>ኤ፥ ታን ኡንቱንቱ ባይዙዋነ ኡንቱንቱ አዎቱዋ ባይዙዋ አጩዋ እትፐ ኡንቱንቶ ዛራና። አያዉ ጎፐ፥ ኡንቱንቱ ደርያ ቦላን እጻና ጩዋዬድኖ፤ ቃይ ዞዘቱዋ ቦላን ታና ቦሬድኖ። ኡንቱንቱ ካሰ ኦዳ ኦሱዋ አጩዋ ታን ኡንቱንቶ ዛራና” ያጌ መና ጎዳይ።<verse eid="ISA 65:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 65:8"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ዎይንያ አይፊ ዎይንያ ቱራን ደእያ ዎደ አሳይ፥ ‘አ ግዶን አንጁ ደእያ ድራዉ፥ አ ይሶፕተ’ ግያዋዳን፥ ታን ታ ቆማቱ ድራዉ፥ ሄዋዳን ኦና፤ ታን ኡንቱንቱ ኡባ ይስከ። <verse eid="ISA 65:8"/><verse number="9" style="v" sid="ISA 65:9"/>ታን ያቆባፐ ዘረ፥ ይሁዳፐካ ታ ደረቱዋ ላትያዋንታ ከሳና፤ ታን ዶሬዳዋንቱ አ ላታና፤ ታ ቆማቱካ ያን ደአና። <verse eid="ISA 65:9"/><verse number="10" style="v" sid="ISA 65:10"/>ታና ኮዬዶ ታ አሳዉ ሳሮና ግያ ደምባይ ዶርሳ ዉድያ ሄምያ ሳ ግዳናዋ፤ ቃይ አኮራ ዎምባይ ሚዛ ዉድያ አላጽስያ ሳ ግዳናዋ።<note caller="-" style="x"><char style="xo" closed="false">65:10 </char><char style="xt" closed="false"><ref loc="JOS 7:24-26">ኢያሳ 7:24-26</ref></char></note><verse eid="ISA 65:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 65:11"/>“ሽን ህንተኖ፥ መና ጎዳ አጌዳዋንቶ፥ ታ ጌሻ ደርያ ዶጌዳዋንቶ፥ ካጫ ግያ ኤቃዉ ማዳ ጊግሴዳዋንቶ፥ ቃይ ህንተ ዉርሰ ኤራናዉ፥ ሳማ ግያ ኤቃዉ ዋላካ ዎይንያ ኤሳ ዋንጫን ኩንዳዋንቶ፥ <verse eid="ISA 65:11"/><verse number="12" style="v" sid="ISA 65:12"/>ታን ህንተ ዉርሰ ማሻዉ አደ እማና፤ ህንተ ኡባይካ ጎራኤታናዉ ሆካና። አያዉ ጎፐ፥ ታን ህንተና ጼስና ኮይበይክታ፤ ሃሳዪደ ስስበይክታ” ያጌ። ህንተ ታ ስንን ኢታባ ኦድታ፤ ታን ዶሰናባካ ዶሬድታ።<verse eid="ISA 65:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 65:13"/>ሄዋ ድራዉ፥ ኡባ ሞድያ መና ጎዳይ ሀዋዳን ያጌ፤ “በእተ፥ ታ ቆማቱ ማና፤ ሽን ህንተ ኮሻታና። ታ ቆማቱ ኡሻና፤ ሽን ህንተ ሳመታና። ታ ቆማቱ ናሸታና፤ ሽን ህንተ ዬላታና። <verse eid="ISA 65:13"/><verse number="14" style="v" sid="ISA 65:14"/>በእተ፥ ታ ቆማቱ ዎዛናን ናሸቲደ የጻና፤ ሽን ህንተ ዎዛናን ካዮቲደ ዋሳና። ቃይ ህንተ አያናይ መኤዳ ድራዉ፥ ህንተ ዝላሊደ ዬካና። <verse eid="ISA 65:14"/><verse number="15" style="v" sid="ISA 65:15"/>ህንተ ህንተ ሱን ታ ዶረቴዳዋንቶ ሸቃዉ እማና። ኡባ ሞድያ መና ጎዳይ ህንተና ዎና፤ ሽን እ ባረ ቆማቱዋ ዱማ ሱንን ጼሳና። <verse eid="ISA 65:15"/><verse number="16" style="v" sid="ISA 65:16"/>ሄ ጋድያን አንጁዋ ኮይያ ኡባይ ቱማተ ጾሳይ አንጃናዳን ዎሳና። ሄ ጋድያን ጫቁዋ ጫቂያ ኡባይካ ቱማተ ጾሳን ጫቃና፤ አያዉ ጎፐ፥ ካሰ መቶቱ ዶገቴድኖ፤ ታ አይፍያ ስንፐካ ጌሜድኖ” ያጌ።<verse eid="ISA 65:16"/></para>
  <para style="s1">ኦራ መታ</para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 65:17"/>ጾሳይ ሀዋዳን ያጌ፤ “በእተ፥ ታን ኦራ ሳሎቱዋነ ኦራ ሳኣ መይ፤ ካሰባይ ኡባይ ሀሳየተናነ ቆፈተና።<note caller="-" style="x"><char style="xo" closed="false">65:17 </char><char style="xt" closed="false"><ref loc="ISA 66:22">ኢሳ. 66:22</ref>፤ <ref loc="2PE 3:13">2 ጰጽ. 3:13</ref>፤ <ref loc="REV 21:1">ሳፃ 21:1</ref></char></note> <verse eid="ISA 65:17"/><verse number="18" style="v" sid="ISA 65:18"/>ሽን ታን መያባን መናዉ ናሸትተነ ሀሹ ጊተ። አያዉ ጎፐ፥ ታን መዳ የሩሳላማ ናሸቻን ኩሜዳኖ ግዳና፤ የሩሳላመ አስካ ሀሹተነ ግያዋ ግዳና። <verse eid="ISA 65:18"/><verse number="19" style="v" sid="ISA 65:19"/>ታን የሩሳላመን ናሸታና፤ ታ አሳንካ ሀሹ ጋና። ሀዋፐ ስንናዉ ዬክያዋ ኮሻይነ ኡንኤቲደ ዋስያዋ ኮሻይ ያን ስሰተና።<note caller="-" style="x"><char style="xo" closed="false">65:19 </char><char style="xt" closed="false"><ref loc="REV 21:4">ሳፃ 21:4</ref></char></note><verse eid="ISA 65:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 65:20"/>“የሩሳላመ ግዶን ሀዋፐ ስንናዉ፥ ጉ ዎደ ጻላላ ደኢደ ሀይቂያ ቄር ናእ፥ ዎይ ባረ ላይ ዉርሰናን ሀይቂያ ጭማ አሳይ ደኤና። ጼቱ ላይና ሀይቂያ ኡራይ ዳሮ ያላጋን ሀይቄዳ ጌተታና፤ ጼቱ ላይ ጋናን ሀይቂያዌ ሼቀቴዳዋዳን ፓይደታና። <verse eid="ISA 65:20"/><verse number="21" style="v" sid="ISA 65:21"/>ሄ ዎደቱዋን አሳቱ ጎለቱዋ ኬጺደ፥ ኡንቱንቱን ደአና፤ ዎይንያ ቱራቱዋካ ቶኪደ፥ ኡንቱንቱ አይፍያ ማና። <verse eid="ISA 65:21"/><verse number="22" style="v" sid="ISA 65:22"/>ኡንቱንቱ ኬጽና፥ ሀራይ ደኤና፤ ሀራይ ማናዉ ቶክያዋ ቶክክኖ። ታ አሳ ላይይ ም ላይዳን አዱቃና፤ ቃይ ታን ዶሬዳዋንቱ ባረንቱ አዱሳ ዎድያዉ ባረንቱ ኩሽያ ኦሱዋን ናሸታና። <verse eid="ISA 65:22"/><verse number="23" style="v" sid="ISA 65:23"/>ኡንቱንቱ ጮ ዳቡርክኖ፤ ዎይ ናናቱዋ ቦሻዉ የልክኖ፤ አያዉ ጎፐ፥ ኡንቱንቱ ባረንቱ ናናቱዋናካ መና ጎዳን አንጀቴዳ ዘረ ግዳናዋ። <verse eid="ISA 65:23"/><verse number="24" style="v" sid="ISA 65:24"/>ኡንቱንቱ ታና ጼሳናፐ ካሰታደ ታን ኡንቱንቶ ኮያና፤ ቃይ ኡንቱንቱ ብሮ ሃሳይሽን፥ ታን ኡንቱንታ ስሳና። <verse eid="ISA 65:24"/><verse number="25" style="v" sid="ISA 65:25"/>ኦኮሩነ ዶርሳ ማራይ እትፐ ሄመታና፤ ጋሙካ ቦራዳን፥ ኡቱላ ማና። ቃይ ሾሻዉ ባናይ ቁማ ግዳናዋ። ሄ ዎደቱዋን ታ ጌሻ ደርያን ኡባን፥ ኡንቱንቱ ቆሄትክኖነ ባይክኖ። ታን መና ጎዳይ ሀዋ ኦዳይ” ያጌ።<note caller="-" style="x"><char style="xo" closed="false">65:25 </char><char style="xt" closed="false"><ref loc="ISA 11:6-9">ኢሳ. 11:6-9</ref></char></note><verse eid="ISA 65:25"/></para>
  <chapter eid="ISA 65"/>
  <chapter number="66" style="c" sid="ISA 66"/>
  <para style="s1">ጾሳይ አይሁዳ ግደና አሳ ቦላ ፕርዳና</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 66:1"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ሳሉ ታ አራታ፤ ሳአይካ ታ ገዲ የያ ሳ። ያትና ህንተ ታዉ ኬጻና ጎሊ አይ ማላ ጎሌ? ታን ሸምፓና ሳአይ ሀቃነ?<note caller="-" style="x"><char style="xo" closed="false">66:1 </char><char style="xt" closed="false"><ref loc="MAT 5:34">ማቶሳ 5:34</ref>፣ <ref loc="MAT 5:35">35</ref>፤ <ref loc="MAT 23:22">23:22</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">66:1-2 </char><char style="xt" closed="false"><ref loc="ACT 7:49-50">ኪታ 7:49-50</ref></char></note> <verse eid="ISA 66:1"/><verse number="2" style="v" sid="ISA 66:2"/>ሄዋንታ ኡባባካ ታ ኩሺ ኦዳ ግደኔ? ሄዋ ድራዉ፥ ሀዋንቱ ኡባቱካ ታዋንታ። ሽን ታን ባረና ዝቂ ኦያዋኮ፥ ባረ ኦዳ ናጋራዉ ካዮቲደ ስምያዋኮነ ታ ቃላን ኮኮርያዋኮ ጼላና ያጌ መና ጎዳይ።<verse eid="ISA 66:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 66:3"/>“አሳይ ኡባይ ባረዉ ባረዉ እንጀትያ ኦግያ ዶሬዳ ጋሱዋን፥ ኮሩማ ያርሽያዌ አሳ ዎያ ኡራ ማላ፤ ዶርሳ ማራ ያርሽያዌካ ካና ጎራእያ አሳ ማላ፤ ካ ያርሹዋ ያርሽያዌካ ጉዱን ሱ ያርሽያ አሳ ማላ፤ ቃይ ሀሳይስያ እጻና ጩዋይያ ኡራይካ ኤቃዉ ጎይንያ አሳ ማላ። ኡንቱንቱ ሸምፑካ ኡንቱንቱ ቱናተን ናሸቴ። <verse eid="ISA 66:3"/><verse number="4" style="v" sid="ISA 66:4"/>ሄዋ ድራዉ፥ ታን መቱዋ ኡንቱንቶ ዶራና፤ ኡንቱንቱ ያዬዳዋካ ታን ኡንቱንቱ ቦላን አሀና። አያዉ ጎፐ፥ ታን ጼሴዳ ዎደ፥ ኦንነ ኮይቤና፤ ታን ሃሳዬዳ ዎደካ ኦንነ ሀይዝቤና። ኡንቱንቱ ታ ስንን ኢታባ ኦድኖ፤ ታን ናሸተናዋ ዶሬድኖ” ያጌ።<verse eid="ISA 66:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 66:5"/>ህንተኖ፥ ጾሳ ቃላዉ ያዪደ ኮኮርያዋንቶ፥ መና ጎዳ ቃላ ስስተ፤ “ህንተ እሻቱ፥ ህንተና እጽያዋንቱ፥ ታ ሱን ድራዉ፥ ህንተና ቦህያዋንቱ፥ ‘ህንተ ናሸቻ ኑን በአና ማላ፥ መና ጎዳይ አነ ቦንቼትና በአና’ ያጌድኖ፤ ሽን ኡንቱንቱ ዬላታና። <verse eid="ISA 66:5"/><verse number="6" style="v" sid="ISA 66:6"/>ካታማፐ ይያ ዋሱዋ ስስተ፤ ጌሻ ጎልያፐ ይያ ኮሻካ ስስተ። ሄዌ ኮሻይ ባረ ሞርከቶ ኡንቱንቱ ኦሱዋ ማላ ኩሽያ ዛርያ መና ጎዳ ኮሻ።<verse eid="ISA 66:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 66:7"/>“ባንከናን ናኣ የልያ ማጫ አስ ደኢ? ኦይይ ኡንኤናን አቱማ ናኣ የልያ ማጫ አስ ደኢ?<note caller="-" style="x"><char style="xo" closed="false">66:7 </char><char style="xt" closed="false"><ref loc="REV 12:5">ሳፃ 12:5</ref></char></note> <verse eid="ISA 66:7"/><verse number="8" style="v" sid="ISA 66:8"/>ሀዋ ማላባ ኦኔ ስሴዳዌ? ቃይ ሀዋ ማላባ ኦኔ በኤዳዌ? እት ቢታ አሳይ ፐጽ እት ጋላስ የለታናዉ ዳንዳዪየ? ዎይ ካዉተይ እት ኩን የለቲ? የሩሳላማ ባንኮ ሳናካ፥ እት ኩን ባረ ናናቱዋ የላዱ። <verse eid="ISA 66:8"/><verse number="9" style="v" sid="ISA 66:9"/>የላና ዎድያ ጋያ ታን ኡንቱንቱ የላናዳን ኦክታየ? ያጌ መና ጎዳይ። ቃይ የላናዳን ኦያ ታን የልያ ኡሉዋ ጎርዳይታየ? ሀዋ ግያዌ ታና፥ ጾሳ።<verse eid="ISA 66:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 66:10"/>“ህንተኖ የሩሳላሞ ሲቅያ ኡባቶ፥ ኢናና ናሸትተ፤ እ ድራዉካ ናሸቻን ፖጩ ጊተ። ህንተኖ እሲ ዬክያ ኡባቶ፥ ኢናና ሎይ ናሸትተ። <verse eid="ISA 66:10"/><verse number="11" style="v" sid="ISA 66:11"/>አያዉ ጎፐ፥ ህንተ እ ምንያ ን ሚደ ካላና፤ ቃይ እ ዳሮ ቦንቹዋፐ ሎይ ኡሺደ፥ ህንተ ናሸታና” ያጌ።<verse eid="ISA 66:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 66:12"/>መና ጎዳይ ሀዋዳን ያጌ፤ “በእተ፥ ታን እዝዉ ሳሮተ ሻፋዳን ዳርሳና፤ ካዉተቱዋ ዱረተካ ኩሚደ ጎግያ ፑልቱዋዳን፥ እዝዉ አሀና። ያቶፐ ህንተ ሄዋ ማና፤ እ ሀሽያን ህንተ ቶከታና፤ እ ክዉዋን ኡቲደ፥ ህንተ እሻለታና። <verse eid="ISA 66:12"/><verse number="13" style="v" sid="ISA 66:13"/>አታ ባረ ናኣ ምንያዋዳን፥ ታንካ ህንተና ምንና፤ ህንተ የሩሳላመን ምነታና። <verse eid="ISA 66:13"/><verse number="14" style="v" sid="ISA 66:14"/>ህንተ ሄዋ በእያ ዎደ፥ ህንተ ዎዛናይ ናሸታና፤ ህንተ መቀይካ ማታዳን አጫና። ቃይ መና ጎዳ ኩሺ አ ቆማቱዋና ደእያዌነ አ ሀንቁ አ ሞርከቱዋ ቦላን ደእያዌ ኤረታና” ያጌ።<verse eid="ISA 66:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 66:15"/>በእተ፥ መና ጎዳይ ታማ አኪደ ያና። ባረ ሀንቀቴዳዋንታ ሙራናዉነ ታማ ላጩዋን ሴራናዉ ሳራጋላ ቶጊደ፥ እ ያና። <verse eid="ISA 66:15"/><verse number="16" style="v" sid="ISA 66:16"/>አያዉ ጎፐ፥ መና ጎዳይ አሹዋ ማዬዳ ኡባ ታማንነ ማሻን ፕርዳና። ቃይ መና ጎዳ ማሻን ሀይቄዳዋንቱ ፓይዱ ዳራና።<verse eid="ISA 66:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 66:17"/>መና ጎዳይ ሀዋዳን ያጌ፤ “አታክልትያ ሳኣን ባረንቱ ኤቃዉ ጎይናናዉ፥ ባረንቱ ግዶን ደእያ እቱዋ ካሊደ፥ ባረና ዱማዪደ ጌሽያዋንቱ፥ ቃይ ጉዱን አሹዋ፥ ሸነይያዋነ ኤጨርያ ምያዋንቱ ኡባይ እትፐ ያና።<verse eid="ISA 66:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 66:18"/>“ታን ኡንቱንቱ ኦሱዋነ ኡንቱንቱ ቆፋ ኤርያ ድራዉ፥ ካዉተቱዋ ኡባነ ዱማ ዱማ ቃላን ሃሳይያዋንታ እትፐ ሺሻናዉ ያይ፤ ኡንቱንቱ ሺቂደ፥ ታ ቦንቹዋ በአና። <verse eid="ISA 66:18"/><verse number="19" style="v" sid="ISA 66:19"/>ታን ኡንቱንቱ ግዶን ማላታ ኦና፤ ኡንቱንቱፐ አቴዳዋንታካ ታ ግታተ ስስቤናነ ታ ቦንቹዋ በእቤና ካዉተቱዋኮ፥ ታርሴሳኮ፥ ሊብያኮ፥ ሊድያኮ፥ ቱባላኮ፥ ያዋናኮነ አባ ዶናን ደእያ ሃኮ ቢታቱዋኮ ኪታና፤ ኡንቱንቱ ታ ቦንቹዋ ካዉተቱዋ ግዶን ኦዳና። 66:19 ሊብያኮ: እብራዌዋን ፑጻ ጌተቴ። <verse eid="ISA 66:19"/><verse number="20" style="v" sid="ISA 66:20"/>እስራኤልያ አሳይ ካ ያርሹዋ ጌሻ ሚሻን ዎደ፥ መና ጎዳ ጌሻ ጎልያ አህያዋዳን፥ ኡንቱንቱ ህንተ እሻቱዋ ኡባ ካዉተቱዋ ኡባ ግዶፐ ፓራቱዋን፥ ፓራ ጋረቱዋን፥ ጋሎቱዋን፥ ባቁሎቱዋንነ ሚሻቱዋ ጫንያ ጋረቱዋን ኡትሲደ፥ ታዉ እሙዋ ግዳናዳን፥ መና ጎዳ ጌሻ ደርያ የሩሳላመ አሀና። <verse eid="ISA 66:20"/><verse number="21" style="v" sid="ISA 66:21"/>ኡንቱንቱፐ እቱዋ እቱዋ ታን ቄሳቱ ዋነ ሌዋቱዋ ከሳና። ታን መና ጎዳይ ሀዋ ኦዳይ” ያጌ።<verse eid="ISA 66:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 66:22"/>ቃይካ መና ጎዳይ ሀዋዳን ያጌ፤ “ታን መያ ኦራ ሳሎቱነ ኦራ ሳአይ ታ ስንን ምኒደ ደእያዋዳን፥ ሄዋዳንካ፥ ህንተ ዘረይነ ህንተ ሱንይ ምኒደ ደአና።<note caller="-" style="x"><char style="xo" closed="false">66:22 </char><char style="xt" closed="false"><ref loc="ISA 65:17">ኢሳ. 65:17</ref>፤ <ref loc="2PE 3:13">2 ጰጽ. 3:13</ref>፤ <ref loc="REV 21:1">ሳፃ 21:1</ref></char></note> <verse eid="ISA 66:22"/><verse number="23" style="v" sid="ISA 66:23"/>አግና ጼሩዋፐ ቢደ ሀራ ጼሩዋ ጋካናዉነ እት ሳምባታፐ ቢደ ሀራ ሳምባታ ጋካናዉ፥ አሳይ ኡባይ ታ ስንን ጎይናናዉ ያና ያጌ መና ጎዳይ። <verse eid="ISA 66:23"/><verse number="24" style="v" sid="ISA 66:24"/>ኡንቱንቱ ከሲ ቢደ፥ ታ ቦላ ማካሌዳ አሳቱ አሃ በአና። ሄዋንታ ምያ ጉጹኒ ሀይቀና፤ ኡንቱንታ ጹግያ ታማይካ ቶኤና። ኡንቱንቱ አሳ ኡባዉ ሸነይያባ ግዳናዋ” ያጌ።<note caller="-" style="x"><char style="xo" closed="false">66:24 </char><char style="xt" closed="false"><ref loc="MRK 9:48">ማር. 9:48</ref></char></note><verse eid="ISA 66:24"/></para>
  <chapter eid="ISA 66"/>
</usx>
