<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="NUM" style="id">- Dawuro Full Bible Ethiopic Version</book>
  <para style="h">ፓይዱዋ</para>
  <para style="toc1">ፓይዱዋ ማጻፋ</para>
  <para style="toc2">ፓይዱዋ</para>
  <para style="toc3">ፓይ.</para>
  <para style="mt1">ፓይዱዋ ማጻፋ</para>
  <para style="imt">ገሉዋ</para>
  <para style="ip">ፓይዱዋ ጌተቴዳ ሀ ማጻፋይ፥ እስራኤልያ አሳ ያራቱዋ ሙሴ ፓይዴዳዋ በስያ ድራሳ። ሲና ደርያፐ ደንዴዳ ዎድያፐ ዶሚደ፥ ጾሳይ ኡንቱንቶ እማና ጌዳ፥ ህዶታ ቢታዉ አዋይ ዉልያ ባጋ ዛዋ ጋካና ጋካናዉ፥ ኦይታሙ ላይ ኡንቱንቱ ደኤዳ ታርክያ ኦዴ። ማጻፋ ሱንይ፥ ግዶን ደእያ ታርከቱዋፐ ዳርያ ክፍልያ በሰ። ሄዌነ እስራኤልያ አሳይ ሲና ደርያፐ ደንዲደ ባናፐ ካሰቲደ፥ ቃይ እት የለታፐ ስምና ዮርዳኖሳ ሻፋፐ አዋይ ዶልያ ባጋና ሞኣበን፥ ሙሴ አሳ ፓይዴዳ ፓይዱዋባ በሰ። ላኡ ፓይዳቱዋፐ ግዱዋን ደእያ ዎደቱዋን እስራኤልያ አሳይ ካናነዉ ገድሳ ባጋ ዛዋ ግድያ ቃዴሳ-ባርነ ጋክ ኡቴዳ። ግዶፐነ ኡንቱንቱ ሄዋና ህዶታ ቢታ ገላናዉ ዳንዳይበይክኖ። ሄዋ ድራዉ፥ ኡንቱንቱ ሄዋ ሄራን ዳሮ ላይ አደ፥ ጉየፐ ዮርዳኖሳ ሻፋፐ አዋይ ዶልያ ባጋና ደእያ ቢታ ቤድኖ። ኡንቱንቱፐ ባጋይ ያን ደአናዉ ቆፋ ቃችና፥ አቴዳ አሳይ ዮርዳኖሳ ፕኒደ፥ ካናነ ባናዉ ባረና ጊግሴዳ።</para>
  <para style="ip">ፓይዱዋባይ ዳሮ መቱ ጋክያ ዎደ ያይያነ ህዶታ ቃንጽያ አሳቱ ታርክያ፥ ጾሳ ቦላነ ኡንቱንታ ካለና ማላ ጾሳይ ኡንቱንቶ ዶሬዳ ሙሴ ቦላ ማካሊደ ደንዴዳ አሳቱ ታርክያ ኦይቄዳዋ። አሳይ ዳቡራንቻነ ባ ግዶፐነ ጾሳይ ኡንቱንቶ አማነትያዋ ግዲደ፥ ኡንቱንታ ካቦዪደ ዎዳዋ ታርኪ ኦዴ። ሄዋዳንካ ሙሴ እት እቶደን ገንጫ ዮፐ፥ አዉ ምኖ አማኑ ደእያዌ ጾሳዉነ አሳዉ አማነቲደ ኦዳ አሳ እ ግድያዌ ቤቴዳ።</para>
  <para style="iot">ሸምፓቱዋ ኡባቶ እመቴዳ ቃን ቆፋቱዋ</para>
  <para style="io1">እስራኤላቱ ሲና ደርያፐ ባናዉ ጊጉሳ <char style="ior"><ref loc="NUM 1:1-9:23">1:1—9:23</ref></char></para>
  <para style="io2">ሀ. ኮይሮ አሳ ፓይዱዋ <char style="ior"><ref loc="NUM 1:1-4:49">1:1—4:49</ref></char></para>
  <para style="io2">ለ. ዱማ ዱማ ህግያነ ዎጋ <char style="ior"><ref loc="NUM 5:1-8:26">5:1—8:26</ref></char></para>
  <para style="io2">ሐ. ላኤን ፓስጋ <char style="ior"><ref loc="NUM 9:1-23">9:1-23</ref></char></para>
  <para style="io1">ሲና ደርያፐ ሞኣበ ቡሳ <char style="ior"><ref loc="NUM 10:1-21:35">10:1—21:35</ref></char></para>
  <para style="io1">ሞኣበን ኦሰቴዳ ሀኖታቱዋ <char style="ior"><ref loc="NUM 22:1-32:42">22:1—32:42</ref></char></para>
  <para style="io1">ግብጼፐ ሞኣባ ጋካናዉ ደእያ ሀመሳይ ቃንን <char style="ior"><ref loc="NUM 33:1-49">33:1-49</ref></char></para>
  <para style="io1">ዮርዳኖሳ ፕናናፐ ካሰት እመቴዳ አዛዙዋ <char style="ior"><ref loc="NUM 33:50-36:13">33:50—36:13</ref></char></para>
  <chapter number="1" style="c" sid="NUM 1"/>
  <para style="ms">እስራኤላቱ ሲና ደርያፐ ባናዉ ጊጉሳ</para>
  <para style="mr">(<ref loc="NUM 1:1-9:23">1:1—9:23</ref>)</para>
  <para style="s1">ኮይሮ እስራኤልያ አሳ ፓይዱዋባ</para>
  <para style="r">(<ref loc="NUM 1:1-4:49">1:1—4:49</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 1:1"/>ሲና መላ ቢታ፥ መና ጎዳ ዱንካንያ ግዶን፥ እስራኤልያ አሳይ ግብጼ ጋድያፐ ከሴዳ ላኤን ላይን፥ ላኤን አግናን፥ ሄ አግናዉ ኮይሮ ጋላሳን፥ መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤<note caller="-" style="x"><char style="xo" closed="false">1:1-46 </char><char style="xt" closed="false"><ref loc="NUM 26:1-51">ፓይ. 26:1-51</ref></char></note> <verse eid="NUM 1:1"/><verse number="2" style="v" sid="NUM 1:2"/>“እስራኤልያ አሳ ኡባ ኡንቱንቱ ያራን ያራንነ ጎልያን ጎልያን ፓይዳደ፥ አቱማ አሳ ኡንቱንቱ ሱንን ሱንን ጻፋ። <verse eid="NUM 1:2"/><verse number="3" style="v" sid="NUM 1:3"/>ኔንነ አሮን የለቶደፐ ላታሙ ላይነ ሄዋፐ ቦላና ደእያ እስራኤላቱዋ፥ ኦላ ባናዉ ዳንዳይያዋንታ ኡባቱዋ፥ ኡንቱንቱ ጭታን ጭታን ፓይድተ። <verse eid="NUM 1:3"/><verse number="4" style="v" sid="NUM 1:4"/>ዛርያፐ ዛርያፐ እት እት አሳይ ባረ ጎልያ አሳዉ ካፑዋ ግዲደ፥ ህንተና ማዶ። <verse eid="NUM 1:4"/><verse number="5" style="v" sid="NUM 1:5"/>ህንተና ማዳና አሳቱ ሱንይ ሀዋፐ ካሊደ ደእያዋ:</para>
  <para style="m" vid="NUM 1:5">ዛርያ ጎልያ አሳ ካፑዋ</para>
  <para style="m" vid="NUM 1:5">ሮቤላ ሻደኡራ ናኣ ኤሊጹራ፥<verse eid="NUM 1:5"/></para>
  <para style="m">
    <verse number="6" style="v" sid="NUM 1:6"/>ስሞና ጹሪሻዳያ ናኣ ሻሉምኤላ፥<verse eid="NUM 1:6"/></para>
  <para style="m">
    <verse number="7" style="v" sid="NUM 1:7"/>ይሁዳ አምናዳባ ናኣ ናአሶና፥<verse eid="NUM 1:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="NUM 1:8"/>ይሳኮራ ጹኣራ ናኣ ናታንኤላ፥<verse eid="NUM 1:8"/></para>
  <para style="m">
    <verse number="9" style="v" sid="NUM 1:9"/>ዛብሎና ሄሎና ናኣ ኤልኣባ፥<verse eid="NUM 1:9"/></para>
  <para style="m">
    <verse number="10" style="v" sid="NUM 1:10"/>ዮሴፎ ናናፐ ኤፍሬማ አምሁዳ ናኣ ኤልሻማአ፥</para>
  <para style="m" vid="NUM 1:10">ምናሰ ፓዳጹራ ናኣ ጋማልኤላ፥<verse eid="NUM 1:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="NUM 1:11"/>ቢንያማ ጊድኦና ናኣ አብዳና፥<verse eid="NUM 1:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="NUM 1:12"/>ዳና አምሻዳያ ናኣ አህኤዘራ፥<verse eid="NUM 1:12"/></para>
  <para style="m">
    <verse number="13" style="v" sid="NUM 1:13"/>አሴራ ኦክራና ናኣ ፓግኤላ፥<verse eid="NUM 1:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="NUM 1:14"/>ጋዳ ዳኡኤላ ናኣ ኤልያሳፋ፥<verse eid="NUM 1:14"/></para>
  <para style="m">
    <verse number="15" style="v" sid="NUM 1:15"/>ንፍታሌማ ኤናና ናኣ አህራአ፤<verse eid="NUM 1:15"/></para>
  <para style="m">
    <verse number="16" style="v" sid="NUM 1:16"/>ሀ አሳቱ ባረንቱ አዎቱዋ ጎልያ አሳቱዋፐ ካለናዉ፥ ዶረቴዳዋንታ፤ ኡንቱንቱ እስራኤልያ ያራቶ ካፓቱዋ” ያጌዳ።<verse eid="NUM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 1:17"/>ሙሴነ አሮን ሱንይ ጼሰቴዳ ሀ አሳቱዋ አፌድኖ። <verse eid="NUM 1:17"/><verse number="18" style="v" sid="NUM 1:18"/>ላኤን አግናን ኮይሮ ጋላስ ኩመን ማባራ ጼሲደ፥ እትፐ ሺሼድኖ። አሳይ ባረ ያራን ያራንነ ባረ ጎልያን ጎልያን ኦዲደ፥ የለቶደፐ ላታሙ ላይነ ሄዋፐ ቦላና ደእያ አቱማ አሳቱዋ ኡባ ሱንይ ኡባና ጻፈቴዳ። <verse eid="NUM 1:18"/><verse number="19" style="v" sid="NUM 1:19"/>መና ጎዳይ አ አዛዜዳዋዳን፥ ሙሴ ኡንቱንታ ሲና መላ ቢታን ፓይዴዳ።<verse eid="NUM 1:19"/></para>
  <para style="p">
    <verse number="20-21" style="v" sid="NUM 1:20-21"/>ኦላዉ ባናዉ ዳንዳይያ አቱማ አሳቱ ኡባይ፥ ላታሙ ላይነ ሄዋፐ ቦላና ደእያዋንቱ ፓይደቲደ፥ ሁጲያን ሁጲያን ጻፈቴድኖ። ኡንቱንቱ ባረንቱ ያራን ያራንነ ባረንቱ ጎልያን ጎልያን ሻከቲደ፥ ሀዋፐ ካሊደ ደእያ ፓይዱዋን ማዝጎበቴድኖ።</para>
  <para style="m" vid="NUM 1:20-21">ዛርያ ኦላንቻቱዋ ፓይዱዋ፤</para>
  <para style="m" vid="NUM 1:20-21">ሮቤላ (እስራኤልያ ናኣ ባይራ) 46,500<verse eid="NUM 1:20-21"/></para>
  <para style="m">
    <verse number="22-23" style="v" sid="NUM 1:22-23"/>ስሞና 59,300፤<verse eid="NUM 1:22-23"/></para>
  <para style="m">
    <verse number="24-25" style="v" sid="NUM 1:24-25"/>ጋዳ 45,650፤<verse eid="NUM 1:24-25"/></para>
  <para style="m">
    <verse number="26-27" style="v" sid="NUM 1:26-27"/>ይሁዳ 74,600፤<verse eid="NUM 1:26-27"/></para>
  <para style="m">
    <verse number="28-29" style="v" sid="NUM 1:28-29"/>ይሳኮራ 54,400፤<verse eid="NUM 1:28-29"/></para>
  <para style="m">
    <verse number="30-31" style="v" sid="NUM 1:30-31"/>ዛብሎና 57,400፤<verse eid="NUM 1:30-31"/></para>
  <para style="m">
    <verse number="32-33" style="v" sid="NUM 1:32-33"/>ዮሴፎ ናኣ ኤፍሬማ 40,500፤<verse eid="NUM 1:32-33"/></para>
  <para style="m">
    <verse number="34-35" style="v" sid="NUM 1:34-35"/>ዮሴፎ ናኣ ምናሳ 32,200፤<verse eid="NUM 1:34-35"/></para>
  <para style="m">
    <verse number="36-37" style="v" sid="NUM 1:36-37"/>ቢንያማ 35,400፤<verse eid="NUM 1:36-37"/></para>
  <para style="m">
    <verse number="38-39" style="v" sid="NUM 1:38-39"/>ዳና 62,700፤<verse eid="NUM 1:38-39"/></para>
  <para style="m">
    <verse number="40-41" style="v" sid="NUM 1:40-41"/>አሴራ 41,500፤<verse eid="NUM 1:40-41"/></para>
  <para style="m">
    <verse number="42-43" style="v" sid="NUM 1:42-43"/>ንፍታሌማ 53,400፤<verse eid="NUM 1:42-43"/></para>
  <para style="m">
    <verse number="44" style="v" sid="NUM 1:44"/>ሙሴ፥ አሮንነ ታማነ ላኡ እስራኤልያ ዛራቱ ካፓቱ ፓይዴዳ አሳይ ሀዋ። <verse eid="NUM 1:44"/><verse number="45" style="v" sid="NUM 1:45"/>ኦላዉ ባናዉ ዳንዳይያ አቱማ አሳቱ ኡባይ ላታሙ ላይነ ሄዋፐ ቦላና ደእያዋንቱ ባረንቱ አዉዋ ጎልያን ጎልያን ፓይደቴድኖ። <verse eid="NUM 1:45"/><verse number="46" style="v" sid="NUM 1:46"/>ሄዋንቱ ኡባና 603,550.<verse eid="NUM 1:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="NUM 1:47"/>ሽን ሌዊያ ዛራቱ ሀ ፓይደቴዳ አሳና ፓይደትበይክኖ። <verse eid="NUM 1:47"/><verse number="48" style="v" sid="NUM 1:48"/>አያዉ ጎፐ፥ መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="NUM 1:48"/><verse number="49" style="v" sid="NUM 1:49"/>“ሌዊያ ዛራቱዋ ፓይዶፓ፤ ኡንቱንታ አቴዳ እስራኤላቱዋ ፓይዱዋን የጎፓ። <verse eid="NUM 1:49"/><verse number="50" style="v" sid="NUM 1:50"/>ሌዋቱዋ ጾሳ ዱንካንያ ቦላንነ አ ግዶን ደእያ ሚሻቱዋ ኡባ ቦላን ካፑዋ ኦደ ሱን። ኡንቱንቱ ሄ ዱንካንያነ አ ግዶን ደእያ ሚሻቱዋ ቶክኖ፤ ኡንቱንቱ አ ግዶን ኦኖነ አ ዩሹዋን ዱንካንኖ። <verse eid="NUM 1:50"/><verse number="51" style="v" sid="NUM 1:51"/>ጾሳ ዱንካኒ ሾደትያ ዎደ ሌዋቱ ሾድኖ፤ ጾሳ ዱንካኒ ኤቂያ ዎደካ ሌዋቱ ኤስኖ። ኡንቱንቱፐ ሀራይ ኦንነ አኮ ሺቆፐ፥ ሀይቆ። <verse eid="NUM 1:51"/><verse number="52" style="v" sid="NUM 1:52"/>እስራኤልያ አሳቱ ኡባይ ባረንቱ አርማን አርማንነ ባረንቱ ጭታን ጭታን ሻከቲደ፥ ባረንቱ ዱንካንያ ዱንካንኖ። <verse eid="NUM 1:52"/><verse number="53" style="v" sid="NUM 1:53"/>ሽን ጾሳ ሀንቁ እስራኤልያ ማባራ ቦላ ዎና ማላ፥ ሌዋቱ ጾሳ ማርካተ ዱንካንያ ዩሹዋን ባረንቱ ዱንካንያ ዱንካንኖ፤ ሌዋቱ ጾሳ ዱንካንያን አዎትኖ” ያጌዳ።<verse eid="NUM 1:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="NUM 1:54"/>እስራኤላቱ ሀዋ ኡባ መና ጎዳይ ሙሳ አዛዜዳዋዳን ኦድኖ።<verse eid="NUM 1:54"/></para>
  <chapter eid="NUM 1"/>
  <chapter number="2" style="c" sid="NUM 2"/>
  <para style="s1">እት እት ሻኩ ዱንካናና ሳኣ በስያዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 2:1"/>መና ጎዳይ ሙሳነ አሮና ሀዋዳን ያጌዳ፤ <verse eid="NUM 2:1"/><verse number="2" style="v" sid="NUM 2:2"/>“እስራኤልያ አሳይ ባረንቱ ባጋ ባጋ ኤርስያ አርማነ ባረንቱ ያራ ያራ ኤርስያ ባንድራ ካሊደ፥ ጾሳ ዱንካንያፐ ጉ ሃኪደ፥ አ ዩሹዋን ዱንካንኖ።<verse eid="NUM 2:2"/></para>
  <para style="p">
    <verse number="3-4" style="v" sid="NUM 2:3-4"/>“አዋይ ዶልያ ባጋና ይሁዳ ባጋይ ባረንቱ አርማ ካሊደ ዱንካንኖ። ኡንቱንቱ ዛራቱዋ ሱንይ፥ ዛራቱዋ ካፓቱዋ ሱንይነ ኦላንቻቱዋ ፓይዱ ሀዋፐ ካሌ:</para>
  <para style="m" vid="NUM 2:3-4">ይሁዳ አምናዳባ ናኣ ናአሶና 74,600፤<verse eid="NUM 2:3-4"/></para>
  <para style="m">
    <verse number="5-6" style="v" sid="NUM 2:5-6"/>ይሳኮራ ጹኣራ ናኣ ናታንኤላ 54,400፤<verse eid="NUM 2:5-6"/></para>
  <para style="m">
    <verse number="7-8" style="v" sid="NUM 2:7-8"/>ዛብሎና ሄሎና ናኣ ኤልኣባ 57,400፤<verse eid="NUM 2:7-8"/></para>
  <para style="m">
    <verse number="9" style="v" sid="NUM 2:9"/>ይሁዳ ባጋፐ ፓይደቴዳ ኦላንቻቱ ኡባና 186,400. ሀራ ሳኣ ብያ ዎደ ኡንቱንቱ ኮይሮ ከስያዋንታ።<verse eid="NUM 2:9"/></para>
  <para style="p">
    <verse number="10-11" style="v" sid="NUM 2:10-11"/>“ቃይ ዱገሃ ባጋና ሮቤላ ባጋይ ባረንቱ አርማ ካሊደ ዱንካንኖ። ኡንቱንቱ ዛራቱ ሱንይ፥ ዛራቱዋ ካፓቱዋ ሱንይነ ኦላንቻቱዋ ፓይዱ ሀዋፐ ካሌ:</para>
  <para style="m" vid="NUM 2:10-11">ሮቤላ ሻደኡራ ናኣ ኤሊጹራ 46,500፤<verse eid="NUM 2:10-11"/></para>
  <para style="m">
    <verse number="12-13" style="v" sid="NUM 2:12-13"/>ስሞና ጹሪሻዳያ ናኣ ሻሉምኤላ 59,300፤<verse eid="NUM 2:12-13"/></para>
  <para style="m">
    <verse number="14-15" style="v" sid="NUM 2:14-15"/>ጋዳ ረኡኤላ ናኣ ኤልያሳፋ 45,650።<verse eid="NUM 2:14-15"/></para>
  <para style="m">
    <verse number="16" style="v" sid="NUM 2:16"/>ሮቤላ ባጋፐ ፓይደቴዳ ኦላንቻቱ ኡባና 151,450 ሀራ ሳኣ ብያ ዎደ ኡንቱንቱ ላኤን ከስያዋንታ።<verse eid="NUM 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 2:17"/>“ሄዋፐ ጉይያን፥ ጾሳ ዱንካኒነ ሌዊያ ዛራቱ ኮይሮ ከሲደ ላኡ ባጋፐነ ጉየፐ ከስያ ላኡ ባጋፐ ግዱዋን ከስኖ፤ ያቲደ ባረንቱ ዱንካኔዳ ማራን ማራንነ ባረንቱ ባንድራ ባንድራ ካሊደ ከስኖ።<verse eid="NUM 2:17"/></para>
  <para style="p">
    <verse number="18-19" style="v" sid="NUM 2:18-19"/>“ቃይ አዋይ ዉልያ ባጋና ኤፍሬማ ባጋይ ባረንቱ አርማ ካሊደ ዱንካንኖ። ኡንቱንቱ ዛራቱዋ ሱንይ፥ ዛራቱዋ ካፓቱዋ ሱንይነ ኦላንቻቱዋ ፓይዱ ሀዋፐ ካሌ:</para>
  <para style="m" vid="NUM 2:18-19">ኤፍሬማ አምሁዳ ናኣ ኤልሻማአ 40,500፤<verse eid="NUM 2:18-19"/></para>
  <para style="m">
    <verse number="20-21" style="v" sid="NUM 2:20-21"/>ምናሳ ፓዳጹራ ናኣ ጋማልኤላ 32,200፤<verse eid="NUM 2:20-21"/></para>
  <para style="m">
    <verse number="22-23" style="v" sid="NUM 2:22-23"/>ቢንያማ ጊድኦና ናኣ አብዳና 35,400፤<verse eid="NUM 2:22-23"/></para>
  <para style="m">
    <verse number="24" style="v" sid="NUM 2:24"/>ኤፍሬማ ባጋፐ ፓይደቴዳ ኦላንቻቱ ኡባና 108,100። ሀራ ሳኣ ብያ ዎደ፥ ኡንቱንቱ ሄዘን ከስያዋንታ።<verse eid="NUM 2:24"/></para>
  <para style="p">
    <verse number="25-26" style="v" sid="NUM 2:25-26"/>“ቃይካ ሁጲሳ ባጋና ዳና ባጋይ ባረንቱ አርማ ካሊደ ዱንካንኖ። ኡንቱንቱ ዛራቱዋ ሱንይ፥ ዛራቱዋ ካፓቱዋ ሱንይነ ኦላንቻቱዋ ፓይዱ ሀዋፐ ካሌ:</para>
  <para style="m" vid="NUM 2:25-26">ዳና አምሻዳያ ናኣ አህኤዘራ 62,700፤<verse eid="NUM 2:25-26"/></para>
  <para style="m">
    <verse number="27-28" style="v" sid="NUM 2:27-28"/>አሴራ ኦክራና ናኣ ፓግኤላ 41,500፤<verse eid="NUM 2:27-28"/></para>
  <para style="m">
    <verse number="29-30" style="v" sid="NUM 2:29-30"/>ንፍታሌማ ኤናና ናኣ አህራአ 53,400፤<verse eid="NUM 2:29-30"/></para>
  <para style="m">
    <verse number="31" style="v" sid="NUM 2:31"/>ዳና ባጋፐ ፓይደቴዳ ኦላንቻቱ ኡባና 157,600፤ ሀራ ሳኣ ብያ ዎደ ኡንቱንቱ ዉርሰን ባረ ባንድራን ከስያዋንታ” ያጌዳ።<verse eid="NUM 2:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 2:32"/>ባረ ያራን ያራን ሻከቲደ ፓይደቴዳ እስራኤልያ ኦላንቻቱ ኡባና 603,550. <verse eid="NUM 2:32"/><verse number="33" style="v" sid="NUM 2:33"/>ሽን መና ጎዳይ ሙሳ አዛዜዳዋዳን፥ ሌዋቱ ሀራ እስራኤላቱዋና ፓይደትበይክኖ። <verse eid="NUM 2:33"/><verse number="34" style="v" sid="NUM 2:34"/>እስራኤላቱ መና ጎዳይ ሙሳ አዛዜዳዋ ኡባባ ኦድኖ። ስም ኡንቱንቱ ባረንቱ ባንድራ ካሊደ፥ ሄዋዳን ዱንካኔድኖ፤ ቃይ ባረንቱ ያራ ያራነ ባረንቱ ሶ አሳ አሳ ካሊደ፥ ሄዋዳን ከሴድኖ።<verse eid="NUM 2:34"/></para>
  <chapter eid="NUM 2"/>
  <chapter number="3" style="c" sid="NUM 3"/>
  <para style="s1">አሮና አቱማ ናናቱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 3:1"/>መና ጎዳይ ሲና ደርያ ቦላን ሙሴና ሃሳዬዳ ዎደ ደእያ አሮናነ ሙሴ ጎልያ አሳይ ሀዋፐ ካሊደ ጻፈቴዳዋ። <verse eid="NUM 3:1"/><verse number="2" style="v" sid="NUM 3:2"/>አሮና አቱማ ናናቱዋ ሱንይ ባይራይ ናዳባ፥ አቢሀ፥ ኤልኣዛራነ እታማራ።<note caller="-" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="NUM 26:60">ፓይ. 26:60</ref></char></note> <verse eid="NUM 3:2"/><verse number="3" style="v" sid="NUM 3:3"/>ሄ አሮና አቱማ ናናይ ኡባይ ቄሰ ግዲደ ኦናዉ ኦከቲደ ሱንቴድኖ። <verse eid="NUM 3:3"/><verse number="4" style="v" sid="NUM 3:4"/>ሽን ኡንቱንቱ ግዶፐ ናዳብነ አብሁ ሲና መላ ቢታን ጾሳይ አዛዝቤና ታማ ያርሺደ፥ መና ጎዳ ስንን ሀይቄድኖ፤ ኡንቱንቶ ናእ ባዋ። ሄዋ ድራዉ፥ ኡንቱንቱ አዉ አሮን ፓጻ ደኤዳ ላይ ኡባን ኤልኣዛራነ እታማራ ጻላላይ ቄሰ ግዲደ ኦድኖ።<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="LEV 10:1-2">ዎጋ 10:1-2</ref>፤ <ref loc="NUM 26:61">ፓይ. 26:61</ref></char></note><verse eid="NUM 3:4"/></para>
  <para style="s1">ሌዋቱ ቄሳቱዋ ማዳናዉ ሱንቴድኖ</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 3:5"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="NUM 3:5"/><verse number="6" style="v" sid="NUM 3:6"/>“ሌዋቱዋ ሃ አካ ያደ ቄስያ አሮና ማዳና ማላ፥ ኡንቱንታ አ ስን ሺሻ። <verse eid="NUM 3:6"/><verse number="7" style="v" sid="NUM 3:7"/>ኡንቱንቱ አሮናዉነ እስራኤልያ ማባራዉ ኡባዉ ጾሳ ዱንካንያ ስንን ዱማ ዱማ ኦሱዋ ኦኖ። <verse eid="NUM 3:7"/><verse number="8" style="v" sid="NUM 3:8"/>ኡንቱንቱ ጾሳ ዱንካንያን ደእያ ሚሻ ኡባ አዎተ አክኖ፤ እስራኤልያ አሳ ድራዉ ጾሳ ዱንካንያን ኦሶ ኡባ ኡንቱንቱ ኦኖ። <verse eid="NUM 3:8"/><verse number="9" style="v" sid="NUM 3:9"/>ኔን ሌዋቱዋ አሮናነ አ አቱማ ናናቱዋ ማዳናዳን ሱን፤ ኡንቱንቱ እስራኤልያ ግዶፐ ኡባና አሮናዉ እመቴድኖ። <verse eid="NUM 3:9"/><verse number="10" style="v" sid="NUM 3:10"/>አሮናነ አ አቱማ ናናቱዋ ቄሰ ኦደ ሱን። ኡንቱንቱፐ ሀራ አሳይ ኦንነ ጾሳ ዱንካንያኮ ሺቆፐ፥ ሀይቆ” ያጌዳ።<verse eid="NUM 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 3:11"/>ቃይ መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="NUM 3:11"/><verse number="12" style="v" sid="NUM 3:12"/>“ታን እስራኤላቱዋ ማጫ አሳይ ባይራ የልያ አቱማ ናናቱዋ ኡባ ድራዉ እስራኤላቱዋ ግዶፐ ሌዋቱዋ አካድ። ሌዋቱ ታዋ፤ <verse eid="NUM 3:12"/><verse number="13" style="v" sid="NUM 3:13"/>አያዉ ጎፐ፥ ባይራ የለቴዳ ኡባይ ታዋ። ታን ግብጼ ጋድያን ባይራ የለቴዳዋ ኡባ ዎዳ ጋላሳን፥ እስራኤላቱዋን ባይራ የለቴዳዋ ኡባ፥ አሳ ግድና፥ መህያ ግድና፥ ታዉ ዱማያድ፤ ኡንቱንቱ ታዋ ግዳና። ታን መና ጎዳ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="EXO 13:2">ከሳ 13:2</ref></char></note><verse eid="NUM 3:13"/></para>
  <para style="s1">ሌዋቱዋ ፓይዱዋባ</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 3:14"/>ቃይካ መና ጎዳይ ሙሳ ሲና መላ ቢታን፥ <verse eid="NUM 3:14"/><verse number="15" style="v" sid="NUM 3:15"/>“ኔን ሌዋቱዋ ኡንቱንቱ ሶ አሳን አሳንነ ኡንቱንቱ ያራን ያራን ፓይዳ፤ የለቶደፐ እት አግናነ ሄዋፐ ቦላና ደእያ አቱማዋንታ ኡባ ፓይዳ” ያጌዳ። <verse eid="NUM 3:15"/><verse number="16" style="v" sid="NUM 3:16"/>መና ጎዳይ አዛዜዳዋዳን፥ ሙሴ ኡንቱንታ ፓይዴዳ።<verse eid="NUM 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 3:17"/>ሌዊያ አቱማ ናናይ ገርሾና፥ ቃሃታነ ማራራ። <verse eid="NUM 3:17"/><verse number="18" style="v" sid="NUM 3:18"/>ገርሾና አቱማ ናናይ ሊብናነ ሽምአ። <verse eid="NUM 3:18"/><verse number="19" style="v" sid="NUM 3:19"/>ቃሃታ አቱማ ናናይ አምራማ፥ ይጽሃራ፥ ከብሮናነ ኡዝኤላ። <verse eid="NUM 3:19"/><verse number="20" style="v" sid="NUM 3:20"/>ማራራ አቱማ ናናይ ቃይ ማህላነ ሙሻ። ሌዋቱዋ ማይዛ አዎቱ ሀዋንታ።<verse eid="NUM 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 3:21"/>ሊብና ያራቱነ ሽምአ ያራቱ ገርሾና ዛራቱዋ። <verse eid="NUM 3:21"/><verse number="22" style="v" sid="NUM 3:22"/>ኡንቱንቱፐ ፓይድና፥ የለቶደፐ እት አግናነ ሄዋፐ ቦላና ደእያ አቱማዋንቱ ኡባና 7,500. <verse eid="NUM 3:22"/><verse number="23" style="v" sid="NUM 3:23"/>ገርሾና ያራቱ ጾሳ ዱንካንያፐ ጉየ አዋይ ዉልያ ባጋና ዱንካኒኖ። <verse eid="NUM 3:23"/><verse number="24" style="v" sid="NUM 3:24"/>ገርሾና ያራቱዋ ሶ አሳ ካፑ ላኤላ ናኣ ኤልያሳፋ። <verse eid="NUM 3:24"/><verse number="25" style="v" sid="NUM 3:25"/>ገርሾና ያራቱ ጾሳ ዱንካንያ፥ ዱንካንያ ካምያዋንታ ገልያሳ ጋርዱዋ፥ <verse eid="NUM 3:25"/><verse number="26" style="v" sid="NUM 3:26"/>ዳባባ ጋርዳቱዋ፥ ጾሳ ዱንካንያነ ያርሽያ ሳኣ ዩሹዋን ደእያ ዳባባ ገልያሳን ጋርዱዋ፥ ዎዶሮቱዋነ ኡንቱንቱ ጎኣና ጋከትያባቱዋ ኡባባ አዎተ አኪኖ።<verse eid="NUM 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 3:27"/>አምራማ ያራቱ፥ ይጽሃራ ያራቱ፥ ከብሮና ያራቱነ ኡዝኤላ ያራቱ ቃሃታ ዛራቱዋ። <verse eid="NUM 3:27"/><verse number="28" style="v" sid="NUM 3:28"/>የለቶደፐ እት አግናነ ሄዋፐ ቦላና ደእያ አቱማዋንቱ ኡባና 8,600. ቃሃታ ያራቱ ጾሳ ዱንካንያ አዎተ አኪኖ። <verse eid="NUM 3:28"/><verse number="29" style="v" sid="NUM 3:29"/>ቃሃታ ያራቱ ጾሳ ዱንካንያፐ ገድሳ ባጋና ዱንካኒኖ። <verse eid="NUM 3:29"/><verse number="30" style="v" sid="NUM 3:30"/>ቃሃታ ያራቱዋ ሶ አሳ ካፑ ኡዝኤላ ናኣ ኤልጻፋና። <verse eid="NUM 3:30"/><verse number="31" style="v" sid="NUM 3:31"/>ኡንቱንቱ ታቦታ፥ ጻራጴዛ፥ ጾምፕያ ዎያ ባላ፥ ያርሽያ ሳኣ፥ ኦያ ዎደ ጎኤትያ ጾሳ ዱንካንያ ሚሻቱዋ፥ ጋርዱዋነ ኡንቱንቱ ጎኣና ጋከትያባቱዋ ኡባባ አዎተ አኪኖ።<verse eid="NUM 3:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 3:32"/>ሌዋቱዋ ካፓቱዋ ካፑ ቄስያ አሮና ናኣ ኤልኣዛራ፤ ጌሻ ሳኣ አዎትያዋንቱ ቦላ እ ሱንቴዳ።<verse eid="NUM 3:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 3:33"/>ማህላ ያራቱነ ሙሻ ያራቱ ማራራ ዛራቱዋ። <verse eid="NUM 3:33"/><verse number="34" style="v" sid="NUM 3:34"/>ኡንቱንቱፐ ፓይድና፥ የለቶደፐ እት አግናነ ሄዋፐ ቦላና ደእያ አቱማዋንቱ ኡባና 6,200. <verse eid="NUM 3:34"/><verse number="35" style="v" sid="NUM 3:35"/>ማራራ ያራቱዋ ሶ አሳ ካፑ አብሀይላ ናኣ ጹሪኤላ። ማራራ ያራቱ ጾሳ ዱንካንያፐ ሁጲሳ ባጋና ዱንካኒኖ። <verse eid="NUM 3:35"/><verse number="36" style="v" sid="NUM 3:36"/>ማራራ ያራቱ ዱንካንያ ጻጋገቱዋ፥ ኩልቦቱዋ፥ ቱሳቱዋ፥ ገደቱዋ፥ ሄ ኦሶ ኮሽያ ሚሻቱዋ ኡባነ ኡንቱንቱ ጎኣና ጋከትያባቱዋ ኡባ አዎተ አኪኖ። <verse eid="NUM 3:36"/><verse number="37" style="v" sid="NUM 3:37"/>ሄዋ ቦላካ ጉጂደ፥ ዩሹዋን ደእያ ዳባባ ቱሳቱዋነ ኡንቱንቱ ገደቱዋ፥ ሽካልያነ ዎዶሮቱዋ አዎተ አኪኖ።<verse eid="NUM 3:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 3:38"/>ቃይ ጾሳ ዱንካንያፐ ስን አዋይ ዶልያ ባጋና ሙሴ፥ አሮንነ አ አቱማ ናናይ ዱንካኒኖ። ኡንቱንቱ እስራኤላቱዋ ድራዉ ጾሳ ዱንካነ ግዶን ኦያ ኦሱዋ አዎተ አኪኖ። ሀራ አሳይ ጾሳ ዱንካንያኮ ሺቆፐ፥ ሀይቆ።<verse eid="NUM 3:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 3:39"/>መና ጎዳይ አዛዝና፥ ሙሴነ አሮን ፓይዴዳ አቱማ ሌዋቱ፥ የለቶደፐ እት አግናነ ሄዋፐ ቦላና ደእያ አቱማዋንቱ ኡባና 22,000.<verse eid="NUM 3:39"/></para>
  <para style="s1">ባይራ የለቴዳ እስራኤላቱዋ ኮታ ሌዋቱ አከቴድኖ</para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 3:40"/>መና ጎዳይ ሙሳ፥ “እስራኤላቱዋ ባይራ አቱማ ናናቱዋ፥ የለቶደፐ እት አግናነ ሄዋፐ ቦላና ደእያዋንታ ኡባ ፓይዳደ ኡንቱንቱ ሱን ጻፋ። <verse eid="NUM 3:40"/><verse number="41" style="v" sid="NUM 3:41"/>እስራኤላቱዋን ባይራ የለቴዳ ኡባ ኮታዉ ሌዋቱዋ ታዉ አካ፤ ቃይ እስራኤላቱዋ መህያን ባይራ የለቴዳ ኡባ ኮታዉ ሌዋቱዋ መህያ ታዉ አካ። ታን መና ጎዳ” ያጌዳ። <verse eid="NUM 3:41"/><verse number="42" style="v" sid="NUM 3:42"/>ሙሴ መና ጎዳይ አ አዛዜዳዋዳን፥ እስራኤላቱዋን ባይራ የለቴዳ ኡባ ፓይዴዳ። <verse eid="NUM 3:42"/><verse number="43" style="v" sid="NUM 3:43"/>የለቶደፐ እት አግናነ ሄዋፐ ቦላና ደእያ ባይራ የለቴዳ አቱማዋንቱ፥ ሱንይካ ጻፈቴዳዋንቱ ኡባና 22,273.<verse eid="NUM 3:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 3:44"/>መና ጎዳይ ሙሳ ቃይካ ሀዋዳን ያጌዳ፤ <verse eid="NUM 3:44"/><verse number="45" style="v" sid="NUM 3:45"/>“ሌዋቱዋ እስራኤልያ አቱማዋንቱ ኡባ ኮታዉ አካ፤ ሌዋቱዋ መሄቱዋ እስራኤላቱዋ መህያ ኮታዉ አካ፤ ሌዋቱ ታዋ ግዳናዋንታ። ታን መና ጎዳ። <verse eid="NUM 3:45"/><verse number="46" style="v" sid="NUM 3:46"/>ሌዋቱዋ ፓይዱዋፐ ዳርያ 273 ባይራ ግዲደ የለቴዳ እስራኤልያ አቱማ ናናቱዋ ዎዛናዉ፥ <verse eid="NUM 3:46"/><verse number="47" style="v" sid="NUM 3:47"/>እቶ እቶ እቼሹ ጻጋራ ብራ ጾሳ ዱንካንያን ኤረቲያ ሚዛንያ ልክያን አካ፤ እት ጻጋራ ብራይ ላታሙ ጌራ ኬሻ። <verse eid="NUM 3:47"/><verse number="48" style="v" sid="NUM 3:48"/>ፓላሄዳ እስራኤላቱዋ ዎዝያ ሄ ሚሻ አሮናዉነ አ አቱማ ናናዉ እማ” ያጌዳ። <verse eid="NUM 3:48"/><verse number="49" style="v" sid="NUM 3:49"/>ሙሴ፥ ሌዋቱዋን ዎዘቴዳዋንቱፐ ፓላሄዳዋንታ ዎዝያ ሚሻ ሺሼዳ። <verse eid="NUM 3:49"/><verse number="50" style="v" sid="NUM 3:50"/>ባይራ የለቴዳ እስራኤላቱዋፐ 1,365 ጻጋራ ብራ ጾሳ ዱንካንያን ኤረቲያ ሚዛንያ ልክያን እ ሺሼዳ፤ <verse eid="NUM 3:50"/><verse number="51" style="v" sid="NUM 3:51"/>መና ጎዳይ አዛዜዳ አዛዙዋዳን፥ ሙሴ ዎዝያ ሚሻ አሮናዉነ አ አቱማ ናናዉ እሜዳ።<verse eid="NUM 3:51"/></para>
  <chapter eid="NUM 3"/>
  <chapter number="4" style="c" sid="NUM 4"/>
  <para style="s1">ቃሃታ ያራ ግድያ ሌዋቱዋ ኦሱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 4:1"/>መና ጎዳይ ሙሳነ አሮና ሀዋዳን ያጌዳ፤ <verse eid="NUM 4:1"/><verse number="2" style="v" sid="NUM 4:2"/>“ሌዊያ ዛራቱዋን ቃሃታ ያራቱዋ ኡንቱንቱ ዳቡዋን ዳቡዋንነ ኡንቱንቱ ሶ አሳን አሳን ሻካደ ፓይዳ፤ <verse eid="NUM 4:2"/><verse number="3" style="v" sid="NUM 4:3"/>የለቶደፐ ላይይ ሀታሙዋፐ ቢደ እሻታሙዋ ጋኬዳ አቱማ አሳ ኡባ፥ ጾሳ ዱንካንያ ግዶን ኦናዉ ይያዋንታ ፓይዳ። <verse eid="NUM 4:3"/><verse number="4" style="v" sid="NUM 4:4"/>ቃሃታ ያራቱ ጾሳ ዱንካንያ ግዶን ኦና ኦሱ ሀዋ: ኡንቱንቱ ኡባፐ አዳ ጌሻ ሚሻቱዋን አዎቲኖ።<verse eid="NUM 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 4:5"/>“አሳይ ዱንካኔዳ ሳፐ ባናዉ ሀንያ ዎደ፥ አሮንነ አ አቱማ ናናይ ጾሳ ዱንካንያ ግዶ ገሊደ፥ ታቦታ ስን ጋርዱዋ ካቁዋፐ ዎኖ፤ ሄ ጫቁዋ ታቦታ አን ካምኖ። <verse eid="NUM 4:5"/><verse number="6" style="v" sid="NUM 4:6"/>ሄ ካሜዳዋ ቦላካ ዎያ እርባንያ ካምኖ፤ ሄዋ ቦላካ ቃይ ጉጂደ፥ ሳሉዋ ማላትያ ጫርቂያ ካምኖ፤ ቶክያ ካሶቱዋ ኡንቱንቱ ሳጋየቱዋን አኖ።<verse eid="NUM 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 4:7"/>“ጾሳ ስን ሺሽያ ኡክ ዎያ ጻራጴዛ ቦላን ሳሉዋ ማላትያ ጫርቂያ ሂጽኖ፤ አ ቦላ ሳነቱዋ፥ ጭልፓቱዋ፥ ጹአቱዋነ ኡሻ ያርሾ ጎኤትያ ኦቶቱዋ ዎኖ፤ ቃይ ኡክይ ኡባ ዎደካ አ ቦላፐ ዮፖ። <verse eid="NUM 4:7"/><verse number="8" style="v" sid="NUM 4:8"/>ሄዋ ቦላን ዞኦ ጫርቂያ ሂጺደ፥ እርባንያ ቃይ አ ቦላ ካምኖ፤ ቶክያ ካሶቱዋ ሳጋየቱዋን አኖ።<verse eid="NUM 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 4:9"/>“ኡንቱንቱ ሳሉዋ ማላትያ ጫርቂያ አኪደ፥ ጾምፕያ ዎያ ባላቱዋ ጾምፐቱዋና፥ ቶይስያ ቃጰቱዋና፥ ኡንቱንታ ዎያባቱዋናነ ዛይትያ ትግያ ጻሮቱዋናካ ኡባ ካምኖ። <verse eid="NUM 4:9"/><verse number="10" style="v" sid="NUM 4:10"/>ያቲደ አካ ሚሻቱዋ ኡባካ እርባንያን ካሚደ፥ ቶክያ ሻንቻማ ቦላን ዎኖ።<verse eid="NUM 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 4:11"/>“እጻና ጩውስያ ዎርቃ ሳጽንያ ቦላን ሳሉዋ ማላትያ ጫርቂያ ሂጼዳዋ ቃይ እርባንያን ካምኖ፤ ቶክያ ካሶቱዋ ኡንቱንቱ ሳጋየቱዋን አኖ። <verse eid="NUM 4:11"/><verse number="12" style="v" sid="NUM 4:12"/>ሄዋዳንካ፥ ቃይ ጾሳ ዱንካንያ ግዶን ጎኤትያ ሚሻቱዋ ኡባ አኪደ፥ ሳሉዋ ማላትያ ጫርቂያን ጻጽኖ፤ እርባንያን ካሚደ፥ ቶክያ ሻንቻማ ቦላን ዎኖ።<verse eid="NUM 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 4:13"/>“ያቲደ ናሃስያፐ ኦዳ ያርሽያ ሳኣ ቦላ ደእያ ብድን ድጊደ አ ቦላ ኦቻ ቴራ ማላትያ ጫርቂያ ሂጽኖ። <verse eid="NUM 4:13"/><verse number="14" style="v" sid="NUM 4:14"/>አ ቦላ ያርሽያሳን ጎኤትያ ሚሻቱዋ ኡባ፥ ታማ ጮጨቱዋ፥ አሹዋ ቃጲያ ቃጰቱዋ፥ አካፋቱዋነ ካሽያ ኩይጻሮቱዋ ዎኖ። እርባንያን ካምኖ፤ ቶክያ ካሶቱዋ ኡንቱንቱ ሳጋየቱዋን አኖ።<verse eid="NUM 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 4:15"/>“አሮንነ አ አቱማ ናናይ፥ ጌሻባቱዋነ ጌሻ ሚሻቱዋ ኡባ ካሚደ ማኮፐነ ዱንካኔዳ ሳኣፐ ደንድያ ዎዲ ጋኮፐ፥ ሄዋ ኡባ ቶካናዉ ቃሃታ ያራቱ ዪኖ። ሽን ጌሻ ሚሻቱዋ ኡንቱንቱ ቦቾፐ ሀይቂኖ። ጾሳ ዱንካንያ ግዶን ደእያ ሄ ሚሻ ቃሃታ ያራቱ ቶክኖ።<verse eid="NUM 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 4:16"/>“ቄስያ አሮና ናአይ ኤልኣዛር ጾምፕያ ዛይትያዉ፥ ሳዊያ እጻናዉ፥ ሀች ሀች ያርሽያ ካ ያርሹዋነ ኦክያ ዛይትያዉ፥ ቃይ ጾሳ ዱንካንያ ሙልያነ አ ግዶን ደእያ ዱማ ጌሻ ሚሻቱዋ ኡባ ቦላ አዋቶ” ያጌዳ።<verse eid="NUM 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 4:17"/>ቃይ መና ጎዳይ ሙሳነ አሮና ሀዋዳን ያጌዳ፤ <verse eid="NUM 4:17"/><verse number="18" style="v" sid="NUM 4:18"/>“ቃሃታ ያራቱ ሌዊያ ዛራቱዋፐ ሀይቂደ የና ማላ ጼልተ። <verse eid="NUM 4:18"/><verse number="19" style="v" sid="NUM 4:19"/>ኡባፐ አዳ ጌሻ ሚሻ ማታ ሺቅያ ዎደ፥ ኡንቱንቱ ሀይቀናን ፓጻ አቲደ ደአና ማላ፥ ኡንቱንቶ ሀዋዳን ኦተ: አሮንነ አ አቱማ ናናይ ጾሳ ዱንካንያ ግዶ ገሊደ ቃሃታ ያራቱ ኡባይ ሁጲያን ሁጲያን ኦና ኦሱዋነ ቶካና ቶኩዋ ሻክ ሻኪደ ግሽኖ። <verse eid="NUM 4:19"/><verse number="20" style="v" sid="NUM 4:20"/>ቃሃታ ያራቱ ሀይቀናዳን፥ ኡባፐ አያ ጌሻቱዋ ቄሳቱ ጻጽሽን በአናዉ ግዱዋ ገሎፕኖ” ያጌዳ።<verse eid="NUM 4:20"/></para>
  <para style="s1">ገርሾና ያራ ግድያ ሌዋቱዋ ኦሱዋ</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 4:21"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="NUM 4:21"/><verse number="22" style="v" sid="NUM 4:22"/>“ገርሾና ያራቱዋካ ኡንቱንቱ ዳቡዋን ዳቡዋንነ ኡንቱንቱ ሶ አሳን አሳን ሻካደ ፓይዳ፤ <verse eid="NUM 4:22"/><verse number="23" style="v" sid="NUM 4:23"/>የለቶደፐ ላይይ ሀታሙዋፐ ቢደ እሻታሙዋ ጋኬዳ አቱማ አሳ ኡባ፥ ጾሳ ዱንካንያ ግዶን ኦናዉ ይያዋንታ ፓይዳ።<verse eid="NUM 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 4:24"/>“ገርሾና ያራቱ ኦያ ኦሱነ ቶክያ ቶኩ ሀዋ: <verse eid="NUM 4:24"/><verse number="25" style="v" sid="NUM 4:25"/>ኡንቱንቱ ጾሳ ዱንካንያ ጋርዳቱዋ፥ ጾሳ ዱንካንያ፥ አ ካምያባቱዋነ ቦላና ካምያ እርባንያ፥ ጾሳ ዱንካንያ ገልያሳን ሶትያ ጋርዱዋ ቶክኖ፤ <verse eid="NUM 4:25"/><verse number="26" style="v" sid="NUM 4:26"/>ቃይ ጾሳ ዱንካንያነ ያርሽያ ሳኣ ዩይ አዳ ዳባባ ጋርዳቱዋ፥ ዳባባ ገልያሳ ጋርዱዋ፥ ዎዶሮቱዋነ ኡንቱንቶ ጎእያ ሚሻቱዋ ኡባ ቶክኖ። ገርሾና ያራቱ ሀ ሚሻቱዋን ኦናዉ በስያ ኦሱዋ ኡባ ኦኖ። <verse eid="NUM 4:26"/><verse number="27" style="v" sid="NUM 4:27"/>ቶክያዋ ግድና፥ ሀራ ኦሱዋ ግድናካ ኡንቱንቱ ኦያ ኦሱዋ ኡባይ አሮንነ አ አቱማ ናናይ ኡንቱንታ አዛዝና ኦሰትኖ። ኔን ኡንቱንቱ ቶካናዉ በስያባቱዋ ኡባ ኡንቱንቱ አዎተ አዎተዳን ኡንቱንቶ ግሻ። <verse eid="NUM 4:27"/><verse number="28" style="v" sid="NUM 4:28"/>ጾሳ ዱንካንያ ግዶን ገርሾና ያራቱ ኦና ኦሱ ኡባይ ሀዋ። ኡንቱንቱ ኦና ኦሱዋ ኡባይ ቄስያ አሮና ናኣ እታማራ አዎተ ጋርሳና ግዳናዋ።<verse eid="NUM 4:28"/></para>
  <para style="s1">ማራራ ያራ ግድያ ሌዋቱዋ ኦሱዋ</para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 4:29"/>“ማራራ ያራቱዋ ኡንቱንቱ ዳቡዋን ዳቡዋንነ ኡንቱንቱ ሶ አሳን አሳን ሻካደ ፓይዳ፤ <verse eid="NUM 4:29"/><verse number="30" style="v" sid="NUM 4:30"/>የለቶደፐ ላይይ ሀታሙዋፐ ቢደ እሻታሙዋ ጋኬዳ አቱማ አሳ ኡባ፥ ጾሳ ዱንካንያ ግዶን ኦናዉ ይያዋንታ ፓይዳ።<verse eid="NUM 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 4:31"/>“ኡንቱንቱ ጾሳ ዱንካንያ ግዶን ኦና ኦሶቱ ሀዋንታ: ኡንቱንታ ዱንካንያ ጻጋገቱዋ፥ ኩልቦቱዋ፥ ቱሳቱዋነ ገደቱዋ፥ <verse eid="NUM 4:31"/><verse number="32" style="v" sid="NUM 4:32"/>ቃይካ ዳባባ ዩሹዋን ኤቂያ ቱሳቱዋ፥ ሄ ቱሳቱ ገደቱዋ፥ ቶልያ ጻጋገቱዋ፥ ዎዶሮቱዋ፥ ሄዋንቶ ኮሽያ ሚሻቱዋ ኡባነ ሄ ሚሻቱዋና ጋከትያባቱዋ ኡባ ቶክኖ። እት እት ኡራዉ እ ቶካናዋ ሻካደ ግሻ። <verse eid="NUM 4:32"/><verse number="33" style="v" sid="NUM 4:33"/>ጾሳ ዱንካንያ ግዶን ማራራ ያራቱ ኦና ኦሱ ኡባና ሀዋ። ኡንቱንቱ ኦና ኦሶ ኡባይ ቄስያ አሮና ናኣ እታማራ አዎተ ጋርሳና ግዳናዋ” ያጌዳ።<verse eid="NUM 4:33"/></para>
  <para style="s1">ሌዋቱዋ ፓይዱዋባ</para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 4:34"/>ሙሴ አሮንነ ማባራ ካፓቱ ቃሃታ ያራቱዋ አቱማ አሳ ኡንቱንቱ ዳቡዋን ዳቡዋንነ ኡንቱንቱ ሶ አሳን አሳን ሻኪደ ፓይዴድኖ። <verse eid="NUM 4:34"/><verse number="35" style="v" sid="NUM 4:35"/>የለቶደፐ ላይይ ሀታሙዋፐ ቢደ እሻታሙዋ ጋኬዳ አቱማ አሳቱ ኡባቱ፥ ጾሳ ዱንካንያ ግዶን ኦናዉ ይያዋንቱ፥ <verse eid="NUM 4:35"/><verse number="36" style="v" sid="NUM 4:36"/>ኡንቱንቱ ሶ አሳን አሳን ፓይድና ኡባና 2,750. <verse eid="NUM 4:36"/><verse number="37" style="v" sid="NUM 4:37"/>ቃሃታ ያራቱዋን ጾሳ ዱንካንያ ግዶን ኦዳ አሳ ፓይዱ ሀዋ። መና ጎዳይ ሙሴ ባጋና አዛዜዳዋዳን፥ ሙሴነ አሮን ኡንቱንታ ፓይዴድኖ።<verse eid="NUM 4:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 4:38"/>ገርሾና ያራቱካ ባረንቱ ዳቡዋን ዳቡዋንነ ባረንቱ ሶ አሳን አሳን ሻከቲደ ፓይደቴድኖ። <verse eid="NUM 4:38"/><verse number="39" style="v" sid="NUM 4:39"/>የለቶደፐ ላይይ ሀታሙዋፐ ቢደ እሻታሙዋ ጋኬዳ አቱማ አሳቱ ኡባቱ፥ ጾሳ ዱንካንያ ግዶን ኦናዉ ይያዋንቱ፥ <verse eid="NUM 4:39"/><verse number="40" style="v" sid="NUM 4:40"/>ኡንቱንቱ ሶ አሳን አሳን ፓይድና ኡባይ 2,630. <verse eid="NUM 4:40"/><verse number="41" style="v" sid="NUM 4:41"/>ገርሾና ያራቱዋን ጾሳ ዱንካንያ ግዶን ኦዳ አሳ ፓይድና ሀዋ። መና ጎዳይ ሙሴ ባጋና አዛዜዳዋዳን፥ ሙሴነ አሮን ኡንቱንታ ፓይዴድኖ።<verse eid="NUM 4:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 4:42"/>ማራራ ያራቱካ ቃይ ዳቡዋን ዳቡዋንነ ባረንቱ ሶ አሳን አሳን ሻከቲደ ፓይደቴድኖ። <verse eid="NUM 4:42"/><verse number="43" style="v" sid="NUM 4:43"/>የለቶደፐ ላይይ ሀታሙዋፐ ቢደ እሻታሙዋ ጋኬዳ አቱማ አሳቱ ኡባቱ፥ ጾሳ ዱንካንያ ግዶን ኦናዉ ይያዋንቱ፥ <verse eid="NUM 4:43"/><verse number="44" style="v" sid="NUM 4:44"/>ኡንቱንቱ ሶ አሳን አሳን ፓይድና ኡባይ 3,200. <verse eid="NUM 4:44"/><verse number="45" style="v" sid="NUM 4:45"/>ማራራ ያራቱዋ ፓይዱ ሀዋ። መና ጎዳይ ሙሴ ባጋና አዛዜዳዋዳን፥ ሙሴነ አሮን ኡንቱንታ ፓይዴድኖ።<verse eid="NUM 4:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 4:46"/>ሄዋ ኦደ ሙሴ፥ አሮንነ እስራኤልያ ካፓቱ ሌዋቱዋ ኡባ፥ ኡንቱንቱ ያራን ያራንነ ኡንቱንቱ ሶ አሳን አሳን ሻኪደ ፓይዴድኖ። <verse eid="NUM 4:46"/><verse number="47" style="v" sid="NUM 4:47"/>የለቶደፐ ላይይ ሀታሙዋፐ ቢደ እሻታሙዋ ጋኬዳ አቱማ አሳቱ ኡባቱ፥ ጾሳ ዱንካንያ ግዶን ኦሱዋ ኦናዉነ አዉ ጎእያ ሚሻቱዋ ኡባ ቶካናዉ ዬዳዋንቱ <verse eid="NUM 4:47"/><verse number="48" style="v" sid="NUM 4:48"/>ኡባይ 8,580. <verse eid="NUM 4:48"/><verse number="49" style="v" sid="NUM 4:49"/>መና ጎዳይ ሙሴ ባጋና አዛዜዳዋዳን፥ ኡንቱንቱ ሁጲያን ሁጲያን ኦና ኦሱ ዎይ ቶካና ቶኩካ ኡንቱንቶ ኦደቴዳ። መና ጎዳይ ሙሳ አዛዜዳዋዳን፥ ኡንቱንቱ ኡባይካ ፓይደቴድኖ።<verse eid="NUM 4:49"/></para>
  <chapter eid="NUM 4"/>
  <chapter number="5" style="c" sid="NUM 5"/>
  <para style="ms">ዱማ ዱማ ህግያነ ዎጋ</para>
  <para style="mr">(<ref loc="NUM 5:1-8:23">5:1—8:23</ref>)</para>
  <para style="s1">ጌይቤና አሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 5:1"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፦ <verse eid="NUM 5:1"/><verse number="2" style="v" sid="NUM 5:2"/>“ኔን እስራኤላቱዋ፥ ‘ህንተ ግዶን ዎልቃማ ጋልባ ሀርጊ ኦይቄዳ ኡራ፥ ዎይ ቦላፐ አያይኔካ ጎግያ ኡራ፥ ዎይ አሃ ኦይቂደ ቱኔዳ ኡራ ኦናካ ህንተ ዱንካኔዳ ሳኣፐ ከስ ድግተ’ ያጋደ አዛዛ። <verse eid="NUM 5:2"/><verse number="3" style="v" sid="NUM 5:3"/>ሄዌ ማጫዋ አቱማዋ ግድናካ ከስኖ። ታን ኡንቱንቱ ግዱዋን ደእያ ኡንቱንቱ ዱንካኔዳሳ ሄዋንቱ ቱንሰና ማላ፥ ኡንቱንቱ ዱንካኔዳ ሳኣፐ ከሳ የዳ” ያጌዳ። <verse eid="NUM 5:3"/><verse number="4" style="v" sid="NUM 5:4"/>መና ጎዳይ ሙሳ አዛዜዳዋዳን፥ እስራኤላቱ ኡንቱንቱ ኡባ ዱንካኔዳ ሳኣፐ ከሲደ የዴድኖ።<verse eid="NUM 5:4"/></para>
  <para style="s1">ናቁዋ አጫ</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 5:5"/>ሄዋፐ ጉይያን፥ መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="LEV 6:1-7">ዎጋ 6:1-7</ref></char></note> <verse eid="NUM 5:5"/><verse number="6" style="v" sid="NUM 5:6"/>“ኔን እስራኤላቱዋ ሀዋዳን ያጋ፤ ‘እት አቱማ አሳይ ዎይ እት ማጫ አሳይ አይ ኦግያንነ ሀራ አሳ ናቆፐነ ሄዋን መና ጎዳዉ አማነተናን እጾፐ፥ ሄ ኡራይ ባይዛንቻ። <verse eid="NUM 5:6"/><verse number="7" style="v" sid="NUM 5:7"/>ሄዋ ድራዉ፥ እ ባረ ኦዳ ናጋራ ፓጾ፤ ባረ ባይዜዳዋ ኩመን ዛሪደ ጭጎ፤ ሄዋ ቦላካ እቼሸን ኩሽያ ጉጂደ፥ ባረ ናቄዳ ኡራዉ አጮ። <verse eid="NUM 5:7"/><verse number="8" style="v" sid="NUM 5:8"/>ሽን ሄ ናቀቴዳ ኡራይ ሀይቄዳዋ ግዶፐነ፥ አጫ አካናዉ አዉ ማታ ዳቡ ዮፐ፥ ሄ አጫይ መና ጎዳሳ። ሄ አጭያ አጫይ ናቄዳ ኡራይ ማረታናዉ ያርሾ እምያ ዶርሳ ኦርግያና እትፐ ቄስያዉ እመቶ። <verse eid="NUM 5:8"/><verse number="9" style="v" sid="NUM 5:9"/>ቃይ እስራኤላቱ ቄስያዉ እምያ ጌሻ እሙዋ ኡባይ ሄ ቄስያሳ። <verse eid="NUM 5:9"/><verse number="10" style="v" sid="NUM 5:10"/>እት እት አሳይ እምያ እሞታይ ሄ እሜዳ ኡራባ፤ ሽን ቄስያዉ እ እምያ እሞታይ ሄ ቄስያሳ’ ያጋ” ያጌዳ።<verse eid="NUM 5:10"/></para>
  <para style="s1">ባረ አስናን ስትያ ማቻትባ</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 5:11"/>ሄዋፐ ጉይያን መና ጎዳይ ሙሳ፥ <verse eid="NUM 5:11"/><verse number="12" style="v" sid="NUM 5:12"/>“ኔን እስራኤላቶ ሀዋዳን ያጋደ ኦዳ፤ ‘እት ኡራ ማቻታ ካረ ሀመታደ፥ አዉ አማነተናን እጻደ፥ <verse eid="NUM 5:12"/><verse number="13" style="v" sid="NUM 5:13"/>ሀራ አቱማ አሳና ግሶፐ፥ ቃይ ሄዋ እዛ ባረ አስናፐ ቆሶፐ፥ ማርካይ ባይናዋ ግዶፐነ፥ እዛ ሻርሙጻደ ኦይቀተናን አቶፐ፥ <verse eid="NUM 5:13"/><verse number="14" style="v" sid="NUM 5:14"/>እዛ ቱኔዳ ድራዉ፥ እ ጎልያዉ እዞ ስያዋ ግዳናዉ ዳንዳዬ፤ ዎይ እዛ ቱነናን ደእሽን፥ እ ባረ ማቻቶ ስያዋ ግዳናዉ ዳንዳዬ። <verse eid="NUM 5:14"/><verse number="15" style="v" sid="NUM 5:15"/>ያቶፐ፥ ሄ ብታኒ ባረ ማቻቶ ቄስያኮ አፎ፤ ቃይ እዝ ድራዉ ያርሻናዉ እት ኪሎ ግራመ ባንጋ ልያ አፎ። ሽን ልያ ቦላ ዛይትያ ትጎፖ፥ ዎይ እጻና አ ቦላ ዎፖ፤ አያዉ ጎፐ፥ ሄ ሊ እ ባረ ማቻቶ ስዳ ድራዉ ያርሽያ ካ ያርሾ፤ ቃይ ሄዌ ባይዙዋ ቆንጭስያ ያርሹዋ።<verse eid="NUM 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 5:16"/>“ ‘ሄዋፐ ጉይያን፥ ቄሲ ሄ ምሽራቶ ሺሺደ፥ መና ጎዳ ስንን ኤሶ። <verse eid="NUM 5:16"/><verse number="17" style="v" sid="NUM 5:17"/>አንጀቴዳ ሃ ኩይጻሩዋን አኮ። ሄዋፐ ጉይያን፥ ጾሳ ዱንካንያ ዉይግያን ደእያ ባና አኪደ፥ ሄ ሃን ጉጆ። <verse eid="NUM 5:17"/><verse number="18" style="v" sid="NUM 5:18"/>ሄ ምሽራቶ መና ጎዳ ስንን ኤሶ፤ ሄዋፐ ጉይያን፥ ሄ ምሽራት ሁጲያ ብሎ፤ ስዳ ድራዉ ያርሽያ እዝ ባይዙዋ ቆንጭስያ ካ ያርሹዋ እዝ ኩሽያን ዎ፤ ቃይ ሄ ቄሲ ባረ ኩሽያን ሸቃ አህያ ጫሞ ሃ ኩይጻሩዋና ኦይቆ። <verse eid="NUM 5:18"/><verse number="19" style="v" sid="NUM 5:19"/>ምሽራቶ ሀዋዳን ያጊደ ጫቀ፤ “ኔን ሀራ አቱማ አሳና ግሳቤናዋ ግዶፐነ፥ ነ አስና አጋደ ካረ ሀመታደ ቱናቤናዋ ግዶፐ፥ ሸቃ አህያ ሀ ጫሞ ሃይ ነዉ ጎመቶፖ። <verse eid="NUM 5:19"/><verse number="20" style="v" sid="NUM 5:20"/>ሽን ኔን ነ አስና አጋደ ካረ ሀመታደ ቱኔዳዋ ግዶፐነ፥ ሀራ አቱማ አሳና ግሴዳዋ ግዶፐ፥ <verse eid="NUM 5:20"/><verse number="21" style="v" sid="NUM 5:21"/>መና ጎዳይ ነ የሉዋ ጎልያ ጉንድስያዋንነ ነ ኡሉዋካ ጋፍስያዋን፥ ነ አሳን ኔና ሸቅሶ። <verse eid="NUM 5:21"/><verse number="22" style="v" sid="NUM 5:22"/>ሀ ሸቃ አህያ ሃይ ነ ኡሎ ግዶ ገሊደ ነ ኡሉዋ ጋፍሶ፤ ነ የሉዋ ኬካ ጉንድሶ” ያጊደ ጫቀ።</para>
  <para style="p" vid="NUM 5:22">“ ‘ምሽራታካ፥ “አመንእ፤ አመንእ” ያጉ።<verse eid="NUM 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 5:23"/>“ ‘ሄዋፐ ጉይያን፥ ቄሲ ሀ ሸቃቱዋ ጻጸቴዳ ማጻፋን ጻፎ፤ ሸቃቱዋ ጫሞ ሃ ግዶ ሜጮ። <verse eid="NUM 5:23"/><verse number="24" style="v" sid="NUM 5:24"/>ያቲደ ሸቃ አህያ ሄ ጫሞ ሃ ምሽራቶ ኡሾ፤ ሸቃ አህያ ሃይ ምሽራት ኡሉዋን ገሊደ፥ እዞ ጫሞ ሳኩዋ ሳካና። <verse eid="NUM 5:24"/><verse number="25" style="v" sid="NUM 5:25"/>ቄሲ ምሽራት ኩሽያፐ ስዳ ድራዉ ያርሽያ ካ ያርሹዋ አኪደ፥ ሄ ያርሹዋ መና ጎዳ ስንን ቃደ፥ ያርሽያ ሳኣ አሆ። <verse eid="NUM 5:25"/><verse number="26" style="v" sid="NUM 5:26"/>ቄሲ ካ ያርሹዋፐ ኮጵያዋ አኪደ ባይዛንቻ ግደከንቶ ቆንጭስያ ያርሹዋ ኦደ፥ ያርሽያሳን ጹጎ። ሄዋፐ ጉይያን፥ ምሽራቶ ሄ ሃ ኡሾ። <verse eid="NUM 5:26"/><verse number="27" style="v" sid="NUM 5:27"/>ሃ እዞ ኡሼዳዋፐ ጉይያን፥ ሀዋዳን ሀናና: እዛ ባረ አስናዉ አማነታና ያደ ቱኔዳዋ ግዶፐ፥ ሸቃ አህያ ሃይ እ ኡሉዋን ገሊደ፥ እዞ ጫሞ ሳኩዋ ሳካና፤ እዝ ኡሉካ ጋፋና፤ እዝ የሉዋ ጎሊካ ጉንዳና። እዛ ባረ አሳን ሸቀቴዳኖ ግዳና። <verse eid="NUM 5:27"/><verse number="28" style="v" sid="NUM 5:28"/>ሽን እዛ ቱናቤና ጽሎ ማጫ አሳ ግዶፐ፥ አ ሳሮ አታደ ናናቱዋ የላና።<verse eid="NUM 5:28"/></para>
  <para style="p">
    <verse number="29-30" style="v" sid="NUM 5:29-30"/>“ ‘እት አሳይ ባረ ማቻቶ ስያ ዎደ ኦና ዎጋይ ሀዋ። እዛ ካረ ሀመታደ ቱኖፐ፥ ዎይ እት አሳይ ባረ ማቻቶ ስፐ፥ መና ጎዳ ስንን እዞ ኤሲደ ቄሲ ሀ ዎጋ ኡባ እዝ ቦላ ፖሎ። <verse eid="NUM 5:29-30"/><verse number="31" style="v" sid="NUM 5:31"/>አስናይ ባይዙዋ ኡባፐ ሳሮ አታና፤ ሽን ማጫውኖ ባረ ናጋራ ጋሱዋን ይያዋ ቶካና’ ያጋ” ያጌዳ።<verse eid="NUM 5:31"/></para>
  <chapter eid="NUM 5"/>
  <chapter number="6" style="c" sid="NUM 6"/>
  <para style="s1">ናዝራዌተ ህግያ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 6:1"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፥ <verse eid="NUM 6:1"/><verse number="2" style="v" sid="NUM 6:2"/>“ኔን እስራኤልያ አሳዉ ሀዋዳን ያጋደ ኦዳ፤ ‘አቱማ አሳይ ዎይ ማጫ አሳይ ናዝራዌ ግዲደ፥ ባረና መና ጎዳዉ ዱማያናዉ ገፖፐ፥ <verse eid="NUM 6:2"/><verse number="3" style="v" sid="NUM 6:3"/>ዎይንያ ኤሳነ ሀራ ማይያ ኡሻ ኡሾፖ፤ ዎይንያ አይፍያፐ አገትያ ጫላባነ ማይያባ ኡሾፖ፤ ዎይንያ ቴራ ጉምኤዳዋ ኡሾፖ። ዎይ ዎይንያ ቴራ ሹጉዋ ግድና፥ መላ ግድናካ ሞፖ፤<note caller="-" style="x"><char style="xo" closed="false">6:3 </char><char style="xt" closed="false"><ref loc="LUK 1:15">ሉቃሳ 1:15</ref></char></note> <verse eid="NUM 6:3"/><verse number="4" style="v" sid="NUM 6:4"/>እ ባረና ዱማዬዳ ዎድያን ኡባን፥ ዎይንያ ቱራፐ ቤትያዋ ኡባ፥ ዎይንያ ዘረ ግድና፥ ዎይ ዎይንያ ፖቁዋ ግድናካ ሞፖ።<verse eid="NUM 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 6:5"/>“ ‘እ ባረና መና ጎዳዉ ዱማያናዉ ገፔዳ ዎድያን ኡባን፥ አ ሁጲ ሜደቶፖ ዎይ ቃንጸቶፖ። እ ባረ ሁጲያ ብናናካ አዱሲደ ድቾ። እ ባረና መና ጎዳዉ ዱማዬዳ ዎዲ ፖለታና ጋካናዉ፥ ጌሻ ግዳናዉ ኮሼ።<verse eid="NUM 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 6:6"/>“ ‘እ ባረና መና ጎዳዉ ዱማዬዳ ዎድያን ኡባን አሃኮ ሺቆፖ። <verse eid="NUM 6:6"/><verse number="7" style="v" sid="NUM 6:7"/>ሀራይ አትና አ አዉ፥ ዎይ አ ዳያ፥ ዎይ አ እሻይ፥ ዎይ አ ምቻታ ሀይቆፐካ፥ እ ባረና ቱንሶፖ። አያዉ ጎፐ፥ እ ባረና ጾሳዉ ዱማዬዳዋ ኤርስያዌ ባረ ሁጲያና። <verse eid="NUM 6:7"/><verse number="8" style="v" sid="NUM 6:8"/>እ ባረና ጾሳዉ ዱማዬዳ ዎድያን ኡባን እ መና ጎዳዉ ጌሻ።<verse eid="NUM 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 6:9"/>“ ‘አሳይ አ ማታን አኬከናን ሀይቂና፥ ጾሳዉ ዱማዬዳ አ ሁጲ ቱኖፐ፥ ላፑን ጋላሳ ጋምኢደ፥ ባረ ጌይያ ሄ ላፑን ጋላስ ባረ ሁጲያ ሜደቶ። <verse eid="NUM 6:9"/><verse number="10" style="v" sid="NUM 6:10"/>ሆስፑን ጋላሳን ላኡ ሀራጰቱዋ ዎይ ላኡ ማራ ሀራጰቱዋ ጾሳ ዱንካንያ ፐንገ ቄስያዉ አሆ። <verse eid="NUM 6:10"/><verse number="11" style="v" sid="NUM 6:11"/>ቄሲ ሀራጰቱዋፐ እቱዋ ናጋራ ያርሾ፥ እቱዋ ቃይ ጹግያ ያርሾ ያርሾ። አያዉ ጎፐ፥ አሃይ አ ማታ ሺቄዳ ባይዙዋ ድራዉ፥ አዉ አቶ ጊሳናሳ። ሄ ጋላስ እ ባረ ሁጲያ ዎጋዳን ጌሾ፤ <verse eid="NUM 6:11"/><verse number="12" style="v" sid="NUM 6:12"/>እ ባረና ካሰ ገፔዳ ዎድያ ኬና ባረና ጾሳዉ ዱማያናዉ ኮሼ። ያቲደ የለቶደፐ እት ላይ ግድያ አቱማ ዶርሳ ናቆ እምያ ያርሹዋ ኦደ ያርሾ። ሽን ሄዋፐ ካሰ እ ባረና ጾሳዉ ዱማዬዳ ጋላሳቱ ፓይደትክኖ፤ አያዉ ጎፐ፥ እ ባረና ዱማዬዳ ሄ ዎደቱዋ ግዶን ባረና ቱንስ ድጌዳ።<verse eid="NUM 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 6:13"/>“ ‘ባረ ገፋ ዎድያ ዉርሴዳ ዎደ ባረና ጾሳዉ ዱማዬዳ ናዝራዊያ ዎጋይ ሀዋ: ጾሳ ዱንካንያ ፐንገ እ ሺቆ፤<note caller="-" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="ACT 21:23-24">ኪታ 21:23-24</ref></char></note> <verse eid="NUM 6:13"/><verse number="14" style="v" sid="NUM 6:14"/>መና ጎዳዉ ትላ ቦላና ደእያ እት ላይ አቱማ ዶርሳ ጹግያ ያርሾ፥ ትላ ቦላና ደእያ እት ላይ ዶርሳቶ ናጋራ ያርሾነ ትላ ቦላና ደእያ ዶርሳ ኦርግያ እትፐተ ያርሾ ሄ ሳኣ አሆ። <verse eid="NUM 6:14"/><verse number="15" style="v" sid="NUM 6:15"/>ቃይ ካ ያርሹዋነ ኡሻ ያርሹዋ ኡንቱንቱና እትፐ ያርሻናዉ አሆ፤ ሄ ካ ያርሹ እርሹ ገልቤናዋ ግዶ፤ ቃይ ዛይትያን ሙናቄዳ ሊቆ ልያ ኮምፖቱዋነ ዛይትያ ኦከቴዳ ሌኦ ኡክቱዋ ማሶፍያን አሆ።<verse eid="NUM 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 6:16"/>“ ‘ቄሲ ሄዋ ኡባ ሺሺደ፥ ናጋራ ያርሹዋነ ጹግያ ያርሾ ኦደ፥ መና ጎዳዉ አ ድራዉ ያርሾ። <verse eid="NUM 6:16"/><verse number="17" style="v" sid="NUM 6:17"/>ቄሲ ዶርሳ ኦርግያ፥ እርሹ ገልቤና ኮምፖቱዋነ ኡክቱዋ እትፐተ ያርሹዋ ኦደ፥ መና ጎዳዉ ያርሾ። ቃይ ሄዋና እትፐ ካ ያርሹዋነ ኡሻ ያርሹዋ ያርሾ። <verse eid="NUM 6:17"/><verse number="18" style="v" sid="NUM 6:18"/>ሄዋፐ ጉይያን፥ ናዝራዊ ጾሳዉ ዱማዬዳ ባረ ሁጲያ ጾሳ ዱንካንያ ፐንግያን ሜደቶ፤ ሜደቴዳ ብናና አፊደ፥ እትፐተ ያርሹዋፐ ጋርሳ ባጋና ደእያ ታማን የጎ።<verse eid="NUM 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 6:19"/>“ ‘ባረና ጾሳዉ ዱማዬዳ ናዝራዊ ባረ ሁጲያ ሜደቴዳዋፐ ጉይያን፥ ቄሲ ዶይሰቴዳ ዶርሳ ኦርግያ ምሳ፥ እርሹ ገልቤና እት ኮምፑዋነ እት ሌኦ ኡክ አኪደ፥ ሀ ናዝራውያ ኩሽያን ዎ። <verse eid="NUM 6:19"/><verse number="20" style="v" sid="NUM 6:20"/>ቄሲ ኡንቱንታ ቃያ ያርሹዋ ኦደ፥ መና ጎዳ ስንን ቃ። ያቶፐ ሄዋንቱ ዉጻኬዳ አንጎሱዋናነ ያርሼዳ ገድያና ጌሻነ ቄስያሳ። ሄዋፐ ጉይያን፥ መና ጎዳዉ ባረና ዱማዬዳ ናዝራዊ ዎይንያ ኤሳ ኡሻና ጎፐ ኡሾ።<verse eid="NUM 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 6:21"/>“ ‘ስም ጾሳዉ ባረና ዱማያናዉ ገፔዳ ናዝራውያዉ ዎ ዎጋይ ሀዋ: ባረና መና ጎዳዉ ያርሻናዉ ኮሽያ ያርሾቱዋፐ አያዋ እማናዉ ገፔዳዋ ግዶፐ፥ እ ባረ ገፔዳ ገፋ ኬና ጋናዉ ኮሼ’ ያጋ” ያጌዳ።<verse eid="NUM 6:21"/></para>
  <para style="s1">ቄሳቱ አንጃና አንጁዋ</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 6:22"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="NUM 6:22"/><verse number="23" style="v" sid="NUM 6:23"/>“አሮናዉነ አ አቱማ ናናቶ ሀዋ ኦዳ፤ ‘እስራኤልያ አሳ ህንተ ሀዋዳን ያጊደ አንጅተ፦<verse eid="NUM 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 6:24"/>“መና ጎዳይ ህንተና አንጆነ</para>
  <para style="q2" vid="NUM 6:24">ህንተና ናጎ፤<verse eid="NUM 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="NUM 6:25"/>መና ጎዳይ ህንተንቶ ባረ ሶምኡዋ</para>
  <para style="q2" vid="NUM 6:25">ፖእሶነ ህንተንቶ ቃረቶ፤<verse eid="NUM 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="NUM 6:26"/>መና ጎዳይ ህንተና ባረ ኬካ አይፍያን</para>
  <para style="q2" vid="NUM 6:26">ጼሎነ ህንተንቶ ሳሮተ እሞ”</para>
  <para style="m" vid="NUM 6:26">ያጊደ አንጅተ’ ያጋ።<verse eid="NUM 6:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 6:27"/>“ሀዋዳን ኡንቱንቱ እስራኤልያ አሳ ቦላ ታ ሱን ዎና፥ ታን ኡንቱንታ አንጃና” ያጌዳ።<verse eid="NUM 6:27"/></para>
  <chapter eid="NUM 6"/>
  <chapter number="7" style="c" sid="NUM 7"/>
  <para style="s1">ካፖቱ አሄዳ እሞታ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 7:1"/>ሙሴ ጾሳ ዱንካንያ ቶሊደ ማኬዳ ዎደ፥ ሄ ዱንካንያነ አ ሚሻ ኡባ ኦኪደ ጌሼዳ፤ ቃይ ያርሽያ ሳነ አ ሚሻ ኡባካ ኦኪደ ጌሼዳ። <verse eid="NUM 7:1"/><verse number="2" style="v" sid="NUM 7:2"/>ሄዋፐ ጉይያን፥ እስራኤልያ አሳ ካለዳዋንቱ፥ ሄዋንቱነ ዛራቱዋ ፓይዴዳ ሶ አሳ ካፖቱ እሞታ አሄድኖ። <verse eid="NUM 7:2"/><verse number="3" style="v" sid="NUM 7:3"/>መና ጎዳዉ እሞታ ሺሼድኖ፤ ሄዋንቱካ ካመቴዳ ኡሱፑን ጋረቱዋ፥ ታማነ ላኡ ቦራቱዋ፥ ካፑዋን ካፑዋን እት እት ቦራነ ላኡ ላኡ ካፖቱ እት እት ጋርያ ጾሳ ዱንካንያ አሄድኖ።<verse eid="NUM 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 7:4"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="NUM 7:4"/><verse number="5" style="v" sid="NUM 7:5"/>“ጾሳ ዱንካንያ ኦሶ ጎአና ማላ፥ ኔን ሄዋንታ ኡንቱንቱፐ አካደ፥ ሌዋቶ ኡንቱንቱ ኦሶ ኦሶ ኮሽያዋዳን ሻካደ እማ” ያጌዳ። <verse eid="NUM 7:5"/><verse number="6" style="v" sid="NUM 7:6"/>ሙሴ ጋረቱዋነ ቦራቱዋ አኪደ፥ ሌዋቶ እሜዳ። <verse eid="NUM 7:6"/><verse number="7" style="v" sid="NUM 7:7"/>ገርሾና ያራቶ ኡንቱንቱ ኦሶ ኮሽያዋዳን ሻኪደ፥ ላኡ ጋረቱዋነ ኦይዱ ቦራቱዋ እሜዳ። <verse eid="NUM 7:7"/><verse number="8" style="v" sid="NUM 7:8"/>ቃይ ማራራ ያራቶ ኡንቱንቱ ኦሶ ኮሽያዋዳን ሻኪደ፥ ኦይዱ ጋረቱዋነ ሆስፑን ቦራቱዋ እሜዳ። ኡንቱንቱ ኡባይካ ቄስያ አሮና ናኣ እታማራ አዎተ ጋርሳና። <verse eid="NUM 7:8"/><verse number="9" style="v" sid="NUM 7:9"/>ሽን ሙሴ ቃሃታ ያራቶ ሄዋፐ አያነ እምቤና፤ አያዉ ጎፐ፥ ኡንቱንቱ አዎተን ደእያ ጌሻ ሚሻቱ ባረንቱ ሀሽያን ቶካናዉ ኮሽያዋንታ ግድያ ድራሳ።<verse eid="NUM 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 7:10"/>ያርሽያ ሳ ሙሴ ኦኪደ ጌሼዳ ጋላሳን፥ ካፖቱ ያርሽያ ሳኣ አንጅሳናዉ ባረንቱ እሙዋ አኪደ፥ ሄ ያርሹዋ ሳኣ ስን አሄድኖ። <verse eid="NUM 7:10"/><verse number="11" style="v" sid="NUM 7:11"/>መና ጎዳይ ሙሳ ካሰ፥ “እት እት ጋላስ እት ካፑ ያርሽያ ሳኣ አንጃናዉ ባረ እሙዋ ጾሳዉ እሞ” ያግ ዎዳ።<verse eid="NUM 7:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="NUM 7:12"/>ኮይሮ ጋላስ ባረ እሙዋ አሄዳዌ ይሁዳ ዛርያፐ አምናዳባ ናኣ ናአሶና።<verse eid="NUM 7:12"/></para>
  <para style="m">
    <verse number="13" style="v" sid="NUM 7:13"/>ናአሶን አሄዳ እሙ ኤረቴዳ ሚዛናን ዎና፥ እት ኪሎ ግራመነ ባጋ ዴጽያ ብራፐ መዳ እት ከርያነ ሆስፑን ጼቱ ግራመ ዴጽያ ብራፐ መዳ እት ኩይጻሩዋ፥ ላኡካ ካ ያርሹዋ ያርሻናዉ ሊቆ ሊ ዛይትያን ሙናቄዳዌ ኩሜዳዋንታ፤ <verse eid="NUM 7:13"/><verse number="14" style="v" sid="NUM 7:14"/>ቃይ እት ጼታነ ታሙ ግራመ ዴጽያ ዎርቃፐ መዳ፥ እጻናይ ኩሜዳ ሻታ፤ <verse eid="NUM 7:14"/><verse number="15" style="v" sid="NUM 7:15"/>ጹግያ ያርሾ፥ እት ኮሩማ፥ እት ዶርሳ ኦርግያነ እት ላይይ ኩሜዳ አቱማ ዶርሳ፤ <verse eid="NUM 7:15"/><verse number="16" style="v" sid="NUM 7:16"/>ናጋራ ያርሾ እት ዴሻ ኦርግያ፤ <verse eid="NUM 7:16"/><verse number="17" style="v" sid="NUM 7:17"/>እትፐተ ያርሾ ላኡ ኮሩማቱዋ፥ እቼሹ ዶርሳ ኦርገቱዋ፥ እቼሹ ጋኬዳ ዴሻ ኦርገቱዋነ እት ላይይ ኩሜዳ እቼሹ አቱማ ዶርሳቱዋ። አምናዳባ ናአይ ናአሶን አሄዳ እሙ ሀዋ።<verse eid="NUM 7:17"/></para>
  <para style="m">
    <verse number="18" style="v" sid="NUM 7:18"/>ላኤን ጋላስ ይሳኮራ ዛራቱ ካፑ፥ ጹኣራ ናአይ ናታንኤል ባረ እሙዋ አሄዳ።<verse eid="NUM 7:18"/></para>
  <para style="m">
    <verse number="19" style="v" sid="NUM 7:19"/>ናታንኤል አሄዳ እሙ ኤረቴዳ ሚዛናን ዎና፥ እት ኪሎ ግራመነ ባጋ ዴጽያ ብራፐ መዳ እት ከርያነ ሆስፑን ጼቱ ግራመ ዴጽያ ብራፐ መዳ እት ኩይጻሩዋ፥ ላኡካ ካ ያርሹዋ ያርሻናዉ ሊቆ ሊ ዛይትያን ሙናቄዳዌ ኩሜዳዋንታ፤ <verse eid="NUM 7:19"/><verse number="20" style="v" sid="NUM 7:20"/>ቃይ እት ጼታነ ታሙ ግራመ ዴጽያ ዎርቃፐ መዳ፥ እጻናይ ኩሜዳ ሻታ፤ <verse eid="NUM 7:20"/><verse number="21" style="v" sid="NUM 7:21"/>ጹግያ ያርሾ እት ኮሩማ፥ እት ዶርሳ ኦርግያነ እት ላይይ ኩሜዳ አቱማ ዶርሳ፤ <verse eid="NUM 7:21"/><verse number="22" style="v" sid="NUM 7:22"/>ናጋራ ያርሾ እት ዴሻ ኦርግያ፤ <verse eid="NUM 7:22"/><verse number="23" style="v" sid="NUM 7:23"/>እትፐተ ያርሾ ላኡ ኮሩማቱዋ፥ እቼሹ ዶርሳ ኦርገቱዋ፥ እቼሹ ጋኬዳ ዴሻ ኦርገቱዋነ እት ላይይ ኩሜዳ እቼሹ አቱማ ዶርሳቱዋ። ጹኣራ ናአይ ናታንኤል አሄዳ እሙ ሀዋ።<verse eid="NUM 7:23"/></para>
  <para style="m">
    <verse number="24" style="v" sid="NUM 7:24"/>ሄዘን ጋላስ ዛብሎና ዛራቱ ካፑ፥ ሄሎና ናአይ ኤልኣብ ባረ እሙዋ አሄዳ።<verse eid="NUM 7:24"/></para>
  <para style="m">
    <verse number="25" style="v" sid="NUM 7:25"/>ኤልኣብ አሄዳ እሙ ኤረቴዳ ሚዛናን ዎና፥ እት ኪሎ ግራመነ ባጋ ዴጽያ ብራፐ መዳ እት ከርያነ ሆስፑን ጼቱ ግራመ ዴጽያ ብራፐ መዳ እት ኩይጻሩዋ፥ ላኡካ ካ ያርሹዋ ያርሻናዉ ሊቆ ሊ ዛይትያን ሙናቀቴዳዌ ኩሜዳዋንታ፤ <verse eid="NUM 7:25"/><verse number="26" style="v" sid="NUM 7:26"/>ቃይ እት ጼታነ ታሙ ግራመ ዴጽያ ዎርቃፐ መዳ፥ እጻናይ ኩሜዳ ሻታ፤ <verse eid="NUM 7:26"/><verse number="27" style="v" sid="NUM 7:27"/>ጹግያ ያርሾ እት ኮሩማ፥ እት ዶርሳ ኦርግያነ እት ላይይ ኩሜዳ አቱማ ዶርሳ፤ <verse eid="NUM 7:27"/><verse number="28" style="v" sid="NUM 7:28"/>ናጋራ ያርሾ እት ዴሻ ኦርግያ፥ <verse eid="NUM 7:28"/><verse number="29" style="v" sid="NUM 7:29"/>እትፐተ ያርሾ ላኡ ኮሩማቱዋ፥ እቼሹ ዶርሳ ኦርገቱዋ፥ እቼሹ ጋኬዳ ዴሻ ኦርገቱዋነ እት ላይይ ኩሜዳ እቼሹ አቱማ ዶርሳቱዋ። ሄሎና ናአይ ኤልኣብ አሄዳ እሙ ሀዋ።<verse eid="NUM 7:29"/></para>
  <para style="m">
    <verse number="30" style="v" sid="NUM 7:30"/>ኦይደን ጋላስ ሮቤላ ዛራቱ ካፑ ሻደኡራ ናአይ ኤሊጹር ባረ እሙዋ አሄዳ።<verse eid="NUM 7:30"/></para>
  <para style="m">
    <verse number="31" style="v" sid="NUM 7:31"/>ኤሊጹር አሄዳ እሙ ኤረቴዳ ሚዛናን ዎና፥ እት ኪሎ ግራመነ ባጋ ዴጽያ ብራፐ መዳ እት ከርያነ ሆስፑን ጼቱ ግራመ ዴጽያ ብራፐ መዳ እት ኩይጻሩዋ፥ ላኡካ ካ ያርሹዋ ያርሻናዉ ሊቆ ሊ ዛይትያን ሙናቄዳዌ ኩሜዳዋንታ፤ <verse eid="NUM 7:31"/><verse number="32" style="v" sid="NUM 7:32"/>ቃይ እት ጼታነ ታሙ ግራመ ዴጽያ ዎርቃፐ መዳ፥ እጻናይ ኩሜዳ ሻታ፤ <verse eid="NUM 7:32"/><verse number="33" style="v" sid="NUM 7:33"/>ጹግያ ያርሾ እት ኮሩማ፥ እት ዶርሳ ኦርግያነ እት ላይይ ኩሜዳ አቱማ ዶርሳ፤ <verse eid="NUM 7:33"/><verse number="34" style="v" sid="NUM 7:34"/>ናጋራ ያርሾ እት ዴሻ ኦርግያ፤ <verse eid="NUM 7:34"/><verse number="35" style="v" sid="NUM 7:35"/>እትፐተ ያርሾ ላኡ ኮሩማቱዋ፥ እቼሹ ዶርሳ ኦርገቱዋ፥ እቼሹ ጋኬዳ ዴሻ ኦርገቱዋነ እት ላይይ ኩሜዳ እቼሹ አቱማ ዶርሳቱዋ። ሻደኡራ ናአይ ኤሊጹር አሄዳ እሙ ሀዋ።<verse eid="NUM 7:35"/></para>
  <para style="m">
    <verse number="36" style="v" sid="NUM 7:36"/>እቼሻን ጋላስ ስሞና ዛራቱ ካፑ፥ ጹሪሻዳያ ናአይ ሻሉምኤል ባረ እሙዋ አሄዳ።<verse eid="NUM 7:36"/></para>
  <para style="m">
    <verse number="37" style="v" sid="NUM 7:37"/>ሻሉምኤል አሄዳ እሙ ኤረቴዳ ሚዛናን ዎና፥ እት ኪሎ ግራመነ ባጋ ዴጽያ ብራፐ መዳ እት ከርያነ ሆስፑን ጼቱ ግራመ ዴጽያ ብራፐ መዳ እት ኩይጻሩዋ፥ ላኡካ ካ ያርሹዋ ያርሻናዉ ሊቆ ሊ ዛይትያን ሙናቄዳዌ ኩሜዳዋንታ፤ <verse eid="NUM 7:37"/><verse number="38" style="v" sid="NUM 7:38"/>ቃይ እት ጼታነ ታሙ ግራመ ዴጽያ ዎርቃፐ መዳ እጻናይ ኩሜዳ ሻታ፤ <verse eid="NUM 7:38"/><verse number="39" style="v" sid="NUM 7:39"/>ጹግያ ያርሾ እት ኮሩማ፥ እት ዶርሳ ኦርግያነ፥ እት ላይይ ኩሜዳ አቱማ ዶርሳ፤ <verse eid="NUM 7:39"/><verse number="40" style="v" sid="NUM 7:40"/>ናጋራ ያርሾ እት ዴሻ ኦርግያ፤ <verse eid="NUM 7:40"/><verse number="41" style="v" sid="NUM 7:41"/>እትፐተ ያርሾ ላኡ ኮሩማቱዋ፥ እቼሹ ዶርሳ ኦርገቱዋ፥ እቼሹ ጋኬዳ ዴሻ ኦርገቱዋነ እት ላይይ ኩሜዳ እቼሹ አቱማ ዶርሳቱዋ። ጹሪሻዳያ ናአይ ሻሉምኤል አሄዳ እሙ ሀዋ።<verse eid="NUM 7:41"/></para>
  <para style="m">
    <verse number="42" style="v" sid="NUM 7:42"/>ኡሱፑን ጋላስ ጋዳ ዛራቱ ካፑ፥ ረኡኤላ ናአይ ኤልያሳፍ ባረ እሙዋ አሄዳ።<verse eid="NUM 7:42"/></para>
  <para style="m">
    <verse number="43" style="v" sid="NUM 7:43"/>ኤልያሳፍ አሄዳ እሙ ኤረቴዳ ሚዛናን ዎና፥ እት ኪሎ ግራመነ ባጋ ዴጽያ ብራፐ መዳ እት ከርያነ ሆስፑን ጼቱ ግራመ ዴጽያ ብራፐ መዳ እት ኩይጻሩዋ፥ ላኡካ ካ ያርሹዋ ያርሻናዉ ሊቆ ሊ ዛይትያን ሙናቄዳዌ ኩሜዳዋንታ፤ <verse eid="NUM 7:43"/><verse number="44" style="v" sid="NUM 7:44"/>ቃይ እት ጼታነ ታሙ ግራመ ዴጽያ ዎርቃፐ መዳ እጻናይ ኩሜዳ ሻታ፤ <verse eid="NUM 7:44"/><verse number="45" style="v" sid="NUM 7:45"/>ጹግያ ያርሾ እት ኮሩማ፥ እት ዶርሳ ኦርግያነ እት ላይይ ኩሜዳ አቱማ ዶርሳ፤ <verse eid="NUM 7:45"/><verse number="46" style="v" sid="NUM 7:46"/>ናጋራ ያርሾ እት ዴሻ ኦርግያ፤ <verse eid="NUM 7:46"/><verse number="47" style="v" sid="NUM 7:47"/>እትፐተ ያርሾ ላኡ ኮሩማቱዋ፥ እቼሹ ዶርሳ ኦርገቱዋ፥ እቼሹ ጋኬዳ ዴሻ ኦርገቱዋነ እት ላይይ ኩሜዳ እቼሹ አቱማ ዶርሳቱዋ። ረኡኤላ ናአይ ኤልያሳፍ አሄዳ እሙ ሀዋ።<verse eid="NUM 7:47"/></para>
  <para style="m">
    <verse number="48" style="v" sid="NUM 7:48"/>ላፑን ጋላስ ኤፍሬማ ዛራቱዋ ካፑ አምሁዳ ናአይ ኤልሻማእ ባረ እሙዋ አሄዳ።<verse eid="NUM 7:48"/></para>
  <para style="m">
    <verse number="49" style="v" sid="NUM 7:49"/>ኤልሻማእ አሄዳ እሙ ኤረቴዳ ሚዛናን ዎና፥ እት ኪሎ ግራመነ ባጋ ዴጽያ ብራፐ መዳ እት ከርያነ ሆስፑን ጼቱ ግራመ ዴጽያ ብራፐ መዳ እት ኩይጻሩዋ፥ ላኡካ ካ ያርሹዋ ያርሻናዉ ሊቆ ሊ ዛይትያን ሙናቄዳዌ ኩሜዳዋንታ፤ <verse eid="NUM 7:49"/><verse number="50" style="v" sid="NUM 7:50"/>ቃይ እት ጼታነ ታሙ ግራመ ዴጽያ ዎርቃፐ መዳ እጻናይ ኩሜዳ ሻታ፤ <verse eid="NUM 7:50"/><verse number="51" style="v" sid="NUM 7:51"/>ጹግያ ያርሾ እት ኮሩማ፥ እት ዶርሳ ኦርግያነ፥ እት ላይይ ኩሜዳ አቱማ ዶርሳ፤ <verse eid="NUM 7:51"/><verse number="52" style="v" sid="NUM 7:52"/>ናጋራ ያርሾ እት ዴሻ ኦርግያ፤ <verse eid="NUM 7:52"/><verse number="53" style="v" sid="NUM 7:53"/>እትፐተ ያርሾ ላኡ ኮሩማቱዋ፥ እቼሹ ዶርሳ ኦርገቱዋ፥ እቼሹ ጋኬዳ ዴሻ ኦርገቱዋነ እት ላይይ ኩሜዳ እቼሹ አቱማ ዶርሳቱዋ። አምሁዳ ናኣ ኤልሻማአ እሙ ሀዋ።<verse eid="NUM 7:53"/></para>
  <para style="m">
    <verse number="54" style="v" sid="NUM 7:54"/>ሆስፑን ጋላስ ምናሰ ዛራቱ ካፑ ፓዳጹራ ናአይ ጋማልኤል ባረ እሙዋ አሄዳ።<verse eid="NUM 7:54"/></para>
  <para style="m">
    <verse number="55" style="v" sid="NUM 7:55"/>ጋማልኤል አሄዳ እሙ ኤረቴዳ ሚዛናን ዎና፥ እት ኪሎ ግራመነ ባጋ ዴጽያ ብራፐ መዳ እት ከርያነ ሆስፑን ጼቱ ግራመ ዴጽያ ብራፐ መዳ እት ኩይጻሩዋ፥ ላኡካ ካ ያርሹዋ ያርሻናዉ ልቆ ሊ ዛይትያን ሙናቄዳዌ ኩሜዳዋንታ <verse eid="NUM 7:55"/><verse number="56" style="v" sid="NUM 7:56"/>ቃይ እት ጼታነ ታሙ ግራመ ዴጽያ ዎርቃፐ መዳ እጻናይ ኩሜዳ ሻታ፤ <verse eid="NUM 7:56"/><verse number="57" style="v" sid="NUM 7:57"/>ጹግያ ያርሾ እት ኮሩማ፥ እት ዶርሳ ኦርግያነ፥ እት ላይይ ኩሜዳ አቱማ ዶርሳ፤ <verse eid="NUM 7:57"/><verse number="58" style="v" sid="NUM 7:58"/>ናጋራ ያርሾ እት ዴሻ ኦርግያ፥ <verse eid="NUM 7:58"/><verse number="59" style="v" sid="NUM 7:59"/>እትፐተ ያርሾ ላኡ ኮሩማቱዋ፥ እቼሹ ዶርሳ ኦርገቱዋ፥ እቼሹ ጋኬዳ ዴሻ ኦርገቱዋነ እት ላይይ ኩሜዳ እቼሹ አቱማ ዶርሳቱዋ። ፓዳጹራ ናአይ ጋማልኤል አሄዳ እሙ ሀዋ።<verse eid="NUM 7:59"/></para>
  <para style="m">
    <verse number="60" style="v" sid="NUM 7:60"/>ኡዱፑን ጋላስ ቢንያማ ዛራቱ ካፑ ጊድኦና ናአይ አብዳን ባረ እሙዋ አሄዳ።<verse eid="NUM 7:60"/></para>
  <para style="m">
    <verse number="61" style="v" sid="NUM 7:61"/>አብዳን አሄዳ እሙ ኤረቴዳ ሚዛናን ዎና፥ እት ኪሎ ግራመነ ባጋ ዴጽያ ብራፐ መዳ እት ከርያነ ሆስፑን ጼቱ ግራመ ዴጽያ ብራፐ መዳ እት ኩይጻሩዋ፥ ላኡካ ካ ያርሹዋ ያርሻናዉ ሊቆ ሊ፥ ዛይትያን ሙናቄዳዌ ኩሜዳዋንታ፤ <verse eid="NUM 7:61"/><verse number="62" style="v" sid="NUM 7:62"/>ቃይ እት ጼታነ ታሙ ግራመ ዴጽያ ዎርቃፐ መዳ፥ እጻናይ ኩሜዳ ሻታ፤ <verse eid="NUM 7:62"/><verse number="63" style="v" sid="NUM 7:63"/>ጹግያ ያርሾ እት ኮሩማ እት ዶርሳ ኦርግያነ፥ እት ላይይ ኩሜዳ አቱማ ዶርሳ፤ <verse eid="NUM 7:63"/><verse number="64" style="v" sid="NUM 7:64"/>ናጋራ ያርሾ እት ዴሻ ኦርግያ፤ <verse eid="NUM 7:64"/><verse number="65" style="v" sid="NUM 7:65"/>እትፐተ ያርሾ ላኡ ኮሩማቱዋ፥ እቼሹ ዶርሳ ኦርገቱዋ፥ እቼሹ ጋኬዳ ዴሻ ኦርገቱዋነ፥ እት ላይይ ኩሜዳ እቼሹ አቱማ ዶርሳቱዋ። ጊድኦና ናአይ አብዳን አሄዳ እሙ ሀዋ።<verse eid="NUM 7:65"/></para>
  <para style="m">
    <verse number="66" style="v" sid="NUM 7:66"/>ታማን ጋላስ ዳና ዛራቱ ካፑ አምሻዳያ ናአይ አህኤዘር ባረ እሙዋ አሄዳ።<verse eid="NUM 7:66"/></para>
  <para style="m">
    <verse number="67" style="v" sid="NUM 7:67"/>አህኤዘር አሄዳ እሙ ኤረቴዳ ሚዛናን ዎና፥ እት ኪሎ ግራመነ ባጋ ዴጽያ ብራፐ መዳ እት ከርያነ ሆስፑን ጼቱ ግራመ ዴጽያ ብራፐ መዳ እት ኩይጻሩዋ፥ ላኡካ ካ ያርሹዋ ያርሻናዉ ሊቆ ሊ፥ ዛይትያን ሙናቄዳዌ ኩሜዳዋንታ፤ <verse eid="NUM 7:67"/><verse number="68" style="v" sid="NUM 7:68"/>ቃይ እት ጼታነ ታሙ ግራመ ዴጽያ ዎርቃፐ መዳ፥ እጻናይ ኩሜዳ ሻታ። <verse eid="NUM 7:68"/><verse number="69" style="v" sid="NUM 7:69"/>ጹግያ ያርሾ እት ኮሩማ፥ እት ዶርሳ ኦርግያነ፥ እት ላይይ ኩሜዳ አቱማ ዶርሳ፤ <verse eid="NUM 7:69"/><verse number="70" style="v" sid="NUM 7:70"/>ናጋራ ያርሾ እት ዴሻ ኦርግያ፤ <verse eid="NUM 7:70"/><verse number="71" style="v" sid="NUM 7:71"/>እትፐተ ያርሾ ላኡ ኮሩማቱዋ፥ እቼሹ ዶርሳ ኦርገቱዋ፥ እቼሹ ጋኬዳ ዴሻ ኦርገቱዋነ እት ላይይ ኩሜዳ እቼሹ አቱማ ዶርሳቱዋ። አምሻዳያ ናአይ አህኤዘር አሄዳ እሙ ሀዋ።<verse eid="NUM 7:71"/></para>
  <para style="m">
    <verse number="72" style="v" sid="NUM 7:72"/>ታማነ እተን ጋላስ አሴራ ዛራቱ ካፑ ኦክራና ናአይ ፓግኤል ባረ ያርሹዋ አሄዳ።<verse eid="NUM 7:72"/></para>
  <para style="m">
    <verse number="73" style="v" sid="NUM 7:73"/>ፓግኤል አሄዳ እሙ ኤረቴዳ ሚዛናን ዎና፥ እት ኪሎ ግራመነ ባጋ ዴጽያ ብራፐ መዳ እት ከርያነ ሆስፑን ጼቱ ግራመ ዴጽያ ብራፐ መዳ እት ኩይጻሩዋ፥ ላኡካ ካ ያርሾ ያርሻናዉ ሊቆ ሊ፥ ዛይትያን ሙናቄዳዌ ኩሜዳዋንታ፤ <verse eid="NUM 7:73"/><verse number="74" style="v" sid="NUM 7:74"/>ቃይ እት ጼታነ ታሙ ግራመ ዴጽያ ዎርቃፐ መዳ ሻታ፥ እጻናይ ኩሜዳዋ፤ <verse eid="NUM 7:74"/><verse number="75" style="v" sid="NUM 7:75"/>ጹግያ ያርሾ እት ኮሩማ፥ እት ዶርሳ ኦርግያነ እት ላይይ ኩሜዳ አቱማ ዶርሳ፤ <verse eid="NUM 7:75"/><verse number="76" style="v" sid="NUM 7:76"/>ናጋራ ያርሾ እት ዴሻ ኦርግያ፤ <verse eid="NUM 7:76"/><verse number="77" style="v" sid="NUM 7:77"/>እትፐተ ያርሾ ላኡ ኮሩማቱዋ፥ እቼሹ ዶርሳ ኦርገቱዋ፥ እቼሹ ጋኬዳ ዴሻ ኦርገቱዋነ እት ላይይ ኩሜዳ እቼሹ አቱማ ዶርሳቱዋ። ኦክራና ናአይ ፓግኤል አሄዳ እሙ ሀዋ።<verse eid="NUM 7:77"/></para>
  <para style="m">
    <verse number="78" style="v" sid="NUM 7:78"/>ታማነ ላኤን ጋላስ ንፍታሌማ ዛራቱ ካፑ ኤናና ናአይ አህራእ ባረ እሙዋ አሄዳ።<verse eid="NUM 7:78"/></para>
  <para style="m">
    <verse number="79" style="v" sid="NUM 7:79"/>አህራእ አሄዳ እሙ ኤረቴዳ ሚዛናን ዎና፥ እት ኪሎ ግራመነ ባጋ ዴጽያ ብራፐ መዳ እት ከርያነ ሆስፑን ጼቱ ግራመ ዴጽያ ብራፐ መዳ እት ኩይጻሩዋ፥ ላኡካ ካ ያርሹዋ ያርሻናዉ ሊቆ ሊ፥ ዛይትያን ሙናቄዳዌ ኩሜዳዋንታ፥ <verse eid="NUM 7:79"/><verse number="80" style="v" sid="NUM 7:80"/>ቃይ እት ጼታነ ታሙ ግራመ ዴጽያ ዎርቃፐ መዳ እት ሻታ፥ እጻናይ ኩሜዳዋ፤ <verse eid="NUM 7:80"/><verse number="81" style="v" sid="NUM 7:81"/>ጹግያ ያርሾ እት ኮሩማ፥ እት ዶርሳ ኦርግያነ እት ላይይ ኩሜዳ አቱማ ዶርሳ፤ <verse eid="NUM 7:81"/><verse number="82" style="v" sid="NUM 7:82"/>ናጋራ ያርሾ እት ዴሻ ኦርግያ፥ <verse eid="NUM 7:82"/><verse number="83" style="v" sid="NUM 7:83"/>እትፐተ ያርሾ ላኡ ኮሩማቱዋ፥ እቼሹ ዶርሳ ኦርገቱዋ፥ እቼሹ ጋኬዳ ዴሻ ኦርገቱዋነ እት ላይይ ኩሜዳ እቼሹ አቱማ ዶርሳቱዋ። ኤናና ናአይ አህራእ አሄዳ እሙ ሀዋ።<verse eid="NUM 7:83"/></para>
  <para style="p">
    <verse number="84" style="v" sid="NUM 7:84"/>ያርሽያ ሳአይ ኦከቴዳ ዎደ፥ እስራኤላቱዋ ካፓቱ ያርሽያ ሳኣ አንጃናዉ አሄዳ እሞታይ ኡባና ሀዋንታ: ብራፐ መዳ ታማነ ላኡ ከረቱዋ፥ ብራፐ መዳ ታማነ ላኡ ኩይጻሮቱዋነ ዎርቃፐ መዳ ታማነ ላኡ ሻተቱዋ፤ <verse eid="NUM 7:84"/><verse number="85" style="v" sid="NUM 7:85"/>ብራፐ መዳ እት እት ከሪ እት ኪሎ ግራመነ ባጋ ዴጼ፤ ብራፐ መዳ እት እት ኩይጻሩ ሆስፑን ጼቱ ግራመ ዴጼ፤ ብራፐ መቴዳ ከርያነ ኩይጻሩ ኤረቴዳ ሚዛናን ዎና፥ ኡባና ላታማነ ሆስፑን ኪሎ ግራመ ኬና ዴጺኖ። <verse eid="NUM 7:85"/><verse number="86" style="v" sid="NUM 7:86"/>ታማነ ላኡ ዎርቃ ሻታቱ ኤረቴዳ ሚዛናን ዎና እቱ እቱ እት ጼታነ ታሙ ግራመ፥ ኡባና እት ክሎነ ሄዙ ጼቱ ግራመ ዴጺኖ። ኡንቱንቱን እጻናይ ኩም ኡቴዳ። <verse eid="NUM 7:86"/><verse number="87" style="v" sid="NUM 7:87"/>ካ ያርሹዋና እትፐ ጹግያ ያርሾ አሄዳ መሂ ኡባና ታማነ ላኡ ኮሩማቱዋ፥ ታማነ ላኡ ዶርሳ ኦርገቱዋነ እት ላይይ ኩሜዳ ታማነ ላኡ አቱማ ዶርሳቱዋ። ኡንቱንቱ ናጋራ ያርሾ አሄዳ ዴሻ ኦርገቱ ኡባና ታማነ ላአ። <verse eid="NUM 7:87"/><verse number="88" style="v" sid="NUM 7:88"/>ኡንቱንቱ እትፐተ ያርሾ አሄዳ መሂ ኡባና ላታማነ ኦይዱ ኮሩማቱዋ፥ ኡሱፑን ታሙ ዶርሳ ኦርገቱዋ፥ ኡሱፑን ታሙ ጋኬዳ ዴሻ ኦርገቱዋነ እት ላይይ ኩሜዳ ኡሱፑን ታሙ አቱማ ዶርሳቱዋ። ያርሽያ ሳአይ ኦከቴዳዋፐ ጉይያን፥ አንጆ አሄዳ እሞታይ ሀዋንታ።<verse eid="NUM 7:88"/></para>
  <para style="p">
    <verse number="89" style="v" sid="NUM 7:89"/>ሙሴ መና ጎዳና ሃሳያናዉ ጾሳ ዱንካንያ ገልያ ዎደ፥ ማርካተ ታቦታ ቦላን ደእያ አቶ ግያ ሳኣ ቁምኡዋ ቦላን፥ ላኡ ክሩበቱዋፐ ግዱዋና መና ጎዳይ ሃሳይያ ኮሻ ስሴዳ፤ እካ አናና ሃሳዬዳ።<verse eid="NUM 7:89"/></para>
  <chapter eid="NUM 7"/>
  <chapter number="8" style="c" sid="NUM 8"/>
  <para style="s1">ጾምፐቱዋ ኡትስሱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 8:1"/>መና ጎዳይ ሙሳ፥<note caller="-" style="x"><char style="xo" closed="false">8:1-4 </char><char style="xt" closed="false"><ref loc="EXO 25:31-40">ከሳ 25:31-40</ref>፤ <ref loc="EXO 37:17-24">37:17-24</ref></char></note> <verse eid="NUM 8:1"/><verse number="2" style="v" sid="NUM 8:2"/>“ኔን አሮናዉ ሀዋዳን ያጋደ ኦዳ፤ ‘ኔን ላፑን ጾምፐቱዋ ዎያ ዎደ ጾምፐቱ ጾምፕያ ዎያ ባላቱዋፐ ስን ባጋና ደእያ ሄራቱዋ ፖኢኖ’ ያጋ” ያጌዳ።<verse eid="NUM 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 8:3"/>እ ጌዳዋዳን አሮን ኦዳ። መና ጎዳይ ሙሳ አዛዜዳዋዳን፥ አሮን ጾምፐቱዋ ዎያ ባላቱዋፐ ስን ባጋና ደእያ ሄራቱዋ ፖእሳናዳን ኦደ፥ ባላቱዋን ዎዳ። <verse eid="NUM 8:3"/><verse number="4" style="v" sid="NUM 8:4"/>ጾምፕያ ዎያዌ ጋርሳ ገድያፐ ቦላ ጪሻና አሌቀቴዳ ባላቱዋ ጼራ ጋካናዉ ቆጸቴዳ ዎርቃፐ መቴዳ። ጾምፕያ ዎያ ባላይ መና ጎዳይ ሙሳ በሴዳ ሌምሱዋዳን ኦሰቴዳ።<verse eid="NUM 8:4"/></para>
  <para style="s1">ሌዋቱ ጾሳዉ ዱማቴድኖ</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 8:5"/>ቃይ መና ጎዳይ ሙሳ፥ <verse eid="NUM 8:5"/><verse number="6" style="v" sid="NUM 8:6"/>“ሀራ እስራኤልያ አሳ ግዱዋፐ ሌዋቱዋ አካደ፥ ኡንቱንታ ዎጋዳን ጌሻ። <verse eid="NUM 8:6"/><verse number="7" style="v" sid="NUM 8:7"/>ኔን ኡንቱንታ ጌሻናዉ ሀዋዳን ኦ: ጌሽያ ሃ አካደ ኡንቱንታ ፑሻካ፤ ኡንቱንቱ ባረንቱ ቦላ ኡባ ሜደትኖ፤ ባረንቱ ማዩዋካ ሜጭኖ፤ ያቲደ ኡንቱንቱ ዎጋዳን ጌሻ ግዳና። <verse eid="NUM 8:7"/><verse number="8" style="v" sid="NUM 8:8"/>ሄዋፐ ጉይያን፥ ኡንቱንቱ ኮሩማ እቱዋነ ሊቆ ልያ ዛይትያን ሙናቄዳዋ ካ ያርሾ አክኖ፤ ኔን ቃይ ላኤን ኮሩማ ናጋራ ያርሾ አካ። <verse eid="NUM 8:8"/><verse number="9" style="v" sid="NUM 8:9"/>ያታደ ሌዋቱዋ ጾሳ ዱንካንያ ስን አያ፤ እስራኤልያ አሳ ማባራ ኡባ ሺሻ። <verse eid="NUM 8:9"/><verse number="10" style="v" sid="NUM 8:10"/>ኔን ሌዋቱዋ መና ጎዳ ስን፥ አህና እስራኤልያ አሳይ ኡንቱንቱ ቦላ ባረንቱ ኩሽያ ዎኖ። <verse eid="NUM 8:10"/><verse number="11" style="v" sid="NUM 8:11"/>ሌዋቱ መና ጎዳ ኦሱዋ ኦናዉ ጊጋና ማላ፥ አሮን እስራኤልያ አሳፐ ሌዋቱዋ ቃያ ያርሹዋ ኦደ፥ መና ጎዳ ስን ሺሾ።<verse eid="NUM 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 8:12"/>“ሌዋቱ ባረንቱ ኩሽያ ኮሩማቱ ሁጲያን ዎኖ፤ እቱዋ ናጋራ ያርሹዋ ኦደ፥ እቱዋ ቃይ ሌዋቱ አቶ ጌተታና ማላ፥ ጹግያ ያርሹዋ ኦደ መና ጎዳዉ ያርሻ። <verse eid="NUM 8:12"/><verse number="13" style="v" sid="NUM 8:13"/>ሌዋቱዋ አሮናነ አ አቱማ ናናቱ አዎተ ጋርሳን ዎ፤ ያታደ ኡንቱንታ ቃያ ያርሹዋ ኦደ፥ መና ጎዳ ስን ሺሻ። <verse eid="NUM 8:13"/><verse number="14" style="v" sid="NUM 8:14"/>ሄዋዳን ኦደ ሌዋቱዋ ሀራ እስራኤልያ አሳፐ ዱማያ፤ ዱማዮፐ ሌዋቱ ታዋ ግዳና።<verse eid="NUM 8:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 8:15"/>“ኔን ሌዋቱዋ ጌሼዳዋፐነ ቃያ ያርሹዋ ኦደ ሺሼዳዋፐ ጉይያን፥ ጾሳ ዱንካንያን ባረንቱ ኦሱዋ ኦናዉ ዪኖ። <verse eid="NUM 8:15"/><verse number="16" style="v" sid="NUM 8:16"/>እስራኤልያ አሳ ግዱዋፐ ኡንቱንቱ ታዉ ኡባና እመቴድኖ፤ እስራኤልያ ማጫ አሳፐ የለቴዳ ባይራ አቱማዋንቱ ኡባ ድራዉ ታን ሌዋቱዋ ታዉ አካድ። <verse eid="NUM 8:16"/><verse number="17" style="v" sid="NUM 8:17"/>እስራኤልያ አሳ ግዱዋን ባይራ የለቴዳዌ አሳ ግድና፥ መህያ ግድናካ ኡባይ ታዋ። ታን ግብጼ ጋድያን ባይራ ኡባ ዎዳ ጋላሳን፥ ኡንቱንታ ታዉ ዱማያድ።<note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="EXO 13:2">ከሳ 13:2</ref></char></note> <verse eid="NUM 8:17"/><verse number="18" style="v" sid="NUM 8:18"/>እስራኤልያ ባይራ አቱማዋንቱ ኡባ ድራዉ ታን ሌዋቱዋ አካድ። <verse eid="NUM 8:18"/><verse number="19" style="v" sid="NUM 8:19"/>እስራኤልያ አሳ ኡባ ግዱዋፐ ታን ሌዋቱዋ አሮናዉነ አሮና አቱማ ናናዉ እሙዋ ኦደ እማድ። እስራኤልያ አሳይ ጋከትያ ዱንካንያ ሺቅያ ዎደ፥ ቦሻይ ኡንቱንታ ቦቼና ማላ፥ ሌዋቱ እስራኤልያ አሳ ግሻ ጋከትያ ዱንካንያን ባረንቱ ኦሱዋ ኦኖነ ኡንቱንቱ ድራዉ አቶ ጌተትኖ” ያጌዳ።<verse eid="NUM 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 8:20"/>መና ጎዳይ ሙሳ ሌዋቱዋ ዱማያናዉ አዛዜዳዋዳን ሙሴ፥ አሮንነ እስራኤልያ አሳ ማባራይ ኡባይ ኦድኖ። <verse eid="NUM 8:20"/><verse number="21" style="v" sid="NUM 8:21"/>ሌዋቱ ባረና ጌሼድኖ፤ ባረንቱ ማዩዋካ ሜጬድኖ። አሮን ኡንቱንቱ ቃያ ያርሹዋ ኦደ፥ መና ጎዳ ስን ሺሼዳ፤ ኡንቱንታ ጌሻናዉ ኡንቱንታ አቶ ጊሴዳ። <verse eid="NUM 8:21"/><verse number="22" style="v" sid="NUM 8:22"/>ሄዋፐ ጉይያን፥ ሌዋቱ አሮናነ አሮና አቱማ ናናቱ አዎተ ጋርሳን፥ ጋከትያ ዱንካንያ ግዶን ባረንቱ ኦሱዋ ኦናዉ ዬድኖ። መና ጎዳይ ሙሳ ሌዋቱዋ ዱማያናዉ አዛዜዳዋዳን ኡንቱንቱ ኦድኖ።<verse eid="NUM 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 8:23"/>ቃይካ መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="NUM 8:23"/><verse number="24" style="v" sid="NUM 8:24"/>“ሀዌ ሌዋቱዋ ጼልያ ዎጋ: ላይይ ላታማነ እቼሻነ ሄዋፐ ቦላና ደእያ አቱማዋንቱ ኦሱዋ ኦናዉ ጋከትያ ዱንካንያ ዪኖ። <verse eid="NUM 8:24"/><verse number="25" style="v" sid="NUM 8:25"/>ሽን ኡንቱንቱ ላይይ እሻታሙዋ ግድያ ዎደ ኡንቱንቱ ባረንቱ ኦሱዋፐ ጹራታ ከስኖ፤ ስሚደ ላኤን ኦፕኖ። <verse eid="NUM 8:25"/><verse number="26" style="v" sid="NUM 8:26"/>ኡንቱንቱ ጋከትያ ዱንካንያን ኦያ ባረንቱ እሻቱዋ ኦ ማዳና ጎፐ ማድኖፐ አትና፥ ኡንቱንቱ ባረካ አይ ኦሶነ ኦፕኖ። ስም ኔን ሌዋቱዋ ኦሱዋ ሀዋዳን ኦስሳሳ” ያጌዳ።<verse eid="NUM 8:26"/></para>
  <chapter eid="NUM 8"/>
  <chapter number="9" style="c" sid="NUM 9"/>
  <para style="s1">ላኤን ፓስጋ</para>
  <para style="r">(<ref loc="NUM 9:1-23">9:1-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 9:1"/>እስራኤልያ አሳይ ግብጼፐ ከሴዳ ላኤን ላይን ኮይሮ አግናን ሲና መላ ቢታን መና ጎዳይ ሙሴዉ ሀዋዳን ያጊደ ሃሳዬዳ፤<note caller="-" style="x"><char style="xo" closed="false">9:1-5 </char><char style="xt" closed="false"><ref loc="EXO 12:1-13">ከሳ 12:1-13</ref></char></note> <verse eid="NUM 9:1"/><verse number="2" style="v" sid="NUM 9:2"/>“እስራኤልያ አሳይ ፓስጋ ባላ ኬሬዳ ጋላሳን ቦንቾ። <verse eid="NUM 9:2"/><verse number="3" style="v" sid="NUM 9:3"/>ሀ አግናን ታማነ ኦይደን ጋላሳን፥ አ ኬሬዳ ዎደ፥ አዋይ ዉላና ሀንያ ዎደ፥ አ ዎጋ ኡባዳንነ አ አዛዞ ኡባዳን ቦንቾ” ያጌዳ። <verse eid="NUM 9:3"/><verse number="4" style="v" sid="NUM 9:4"/>ሙሴ እስራኤልያ አሳይ ፓስጋ ባላ ቦንቻና ማላ፥ ኡንቱንቶ ኦዴዳ። <verse eid="NUM 9:4"/><verse number="5" style="v" sid="NUM 9:5"/>ኮይሮ አግናዉ ታማነ ኦይደን ጋላስ፥ አዋይ ዉላና ሀንያ ዎደ ሲና መላ ቢታን ኡንቱንቱ ፓስጋ ባላ ቦንቼድኖ። እስራኤልያ አሳይ መና ጎዳይ ሙሳ አዛዜዳዋዳን ኡባባ ኦዳ።<verse eid="NUM 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 9:6"/>ሽን ኡንቱንቱፐ አማሬዳዋንቱ ሀይቄዳ አሳ አሃ ቦቺደ ቱኔዳ ድራዉ፥ ሄ ጋላስ ፓስጋ ባላ ቦንቻናዉ ዳንዳይበይክኖ። ሄዋ ድራዉ፥ ኡንቱንቱ ሙሴኮነ አሮናኮ ሄ ጋላስ ዪደ፥ <verse eid="NUM 9:6"/><verse number="7" style="v" sid="NUM 9:7"/>ሙሳ፥ “ኑን ሀይቄዳ አሳ አሃ ቦቼዳ ድራዉ ቱኔዶ፤ ሽን ኬሬዳ ዎድያን ሀራ እስራኤልያ አሳና መና ጎዳዉ ያርሹዋ ሺሽያዋ ኑን አያዉ ድገቴቶ?” ያጌድኖ።<verse eid="NUM 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 9:8"/>ሙሴ ኡንቱንታ፥ “መና ጎዳይ ህንተዋ ታዉ አዛዝያዋ ታን ስሳና ጋካናዉ ህንተ ታክሽተ” ያጌዳ።<verse eid="NUM 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 9:9"/>ሄዋፐ ጉይያን መና ጎዳይ ሙሳ፥ <verse eid="NUM 9:9"/><verse number="10" style="v" sid="NUM 9:10"/>“ኔን እስራኤልያ አሳ ሀዋዳን ያጋ፤ ‘ህንተፐ ዎይ ህንተ ዛራቱዋፐ ኦንነ አሃ ቦቺደ ቱኖፐ፥ ዎይ ማንዳሬዳዋ ግዶፐ፥ እ መና ጎዳዉ ፓስጋ ባላ ቦንቾ፤ <verse eid="NUM 9:10"/><verse number="11" style="v" sid="NUM 9:11"/>ላኤን አግናን ታማነ ኦይደን ጋላስ አዋይ ዉላና ሀንያ ዎደ ፓስጋ ባላ ቦንቾ። ፓስጋ ዶርሳ እርሹ ገልቤና ኡክናነ ጫሞ ቦንጭያና ሞ። <verse eid="NUM 9:11"/><verse number="12" style="v" sid="NUM 9:12"/>ሳአይ ዎንታናዉ ሄ ዶርሳፐ አያነ አሾፖ፤ ቃይ አ መቀፐካ እቱዋነ መንፖ። ፓስጋ ባላዉ አ ዎጋ ኡባ ኦ።<note caller="-" style="x"><char style="xo" closed="false">9:12 </char><char style="xt" closed="false"><ref loc="EXO 12:46">ከሳ 12:46</ref>፤ <ref loc="JHN 19:36">ዮሃ. 19:36</ref></char></note> <verse eid="NUM 9:12"/><verse number="13" style="v" sid="NUM 9:13"/>ሽን ማንዳርቤና ጌሻ አሳይ ፓስጋ ቦንቼናን እጾፐ፥ ሄዋፐ ስንዉ እ ታ አሳ ግዶፐ ቦሄቶ። አያዉ ጎፐ፥ መና ጎዳ ያርሹዋ ኬሬዳ ዎድያን እ ሺሽቤና። ሄ አሳይ ባረ ናጋራይ አሄዳ መቱዋ አካናዉ በሰ።<verse eid="NUM 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 9:14"/>“ ‘ህንተ ግዱዋን ደእያ በተ አሳይ ፓስጋ ባላ መና ጎዳዉ ቦንቻና ኮዮፐ፥ ፓስጋ ዎጋዳን ቦንቾ። በትያዉካ ጋደ አሳዉካ እት ማላ ዎጋይ ደኦ’ ያጋ” ያጌዳ።<verse eid="NUM 9:14"/></para>
  <para style="s1">ታማዳን ፖኤዳ ሻርያ</para>
  <para style="r">(<ref loc="EXO 40:34-38">ከሳ 40:34-38</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 9:15"/>ዱንካኒ ቶለቴዳ ጋላስ ሻሪ ማርካተ ዱንካንያ ማዬዳ፤ ኦማርሳፐ ዶሚደ፥ ዎንታና ጋካናዉ ዱንካንያፐ ቦላና ደእያ ሻሪ ታማ ማላቴ። <verse eid="NUM 9:15"/><verse number="16" style="v" sid="NUM 9:16"/>ሄዋዳን ኡባ ዎደ ጋላስ ጋላስ ሻሪ ማዬ፤ ቃማ ቃማ ሄ ሻሪ ታማዳን ፖኤ። <verse eid="NUM 9:16"/><verse number="17" style="v" sid="NUM 9:17"/>ሄ ሻሪ ዱንካንያ ቦላፐ ደንድያ ዎደ አዉደነ እስራኤላቱ ባረንቱ ዱንካኔዳ ሳኣፐ ደንዲኖ፤ ቃይ ሄ ሻሪ ዎያ አይ ሳኣንነ እስራኤላቱ ዱንካኒኖ። <verse eid="NUM 9:17"/><verse number="18" style="v" sid="NUM 9:18"/>እስራኤላቱ መና ጎዳ አዛዙዋን ደንድኖ፤ ሄዋዳንካ፥ መና ጎዳ አዛዙዋን ዱንካኒኖ። ሻሪ ዱንካንያ ቦላን ጋምእያ ዎደ ኡባን ባረንቱ ዱንካኔዳሳን ጋምእኖ። <verse eid="NUM 9:18"/><verse number="19" style="v" sid="NUM 9:19"/>ሻሪ ዱንካንያ ቦላን ዳሮ ጋላሳ ጋምኦፐ፥ እስራኤላቱ መና ጎዳ አዛዙዋ ናጊኖፐ አትና፥ ሀቃነ ቢክኖ። <verse eid="NUM 9:19"/><verse number="20" style="v" sid="NUM 9:20"/>እት እት ገደ ሻሪ ዱንካንያ ቦላን አማሬዳ ጋላሳ ጋምኤ። መና ጎዳ አዛዙዋን ኡንቱንቱ ዱንካኒኖ፤ ቃይ ሄዋዳንካ፥ ጾሳ አዛዙዋን ኡንቱንቱ ደንድኖ። <verse eid="NUM 9:20"/><verse number="21" style="v" sid="NUM 9:21"/>እት እት ገደ ሻሪ ኦማርሳፐ ዎንታና ጋካናዉ ጻላላ ጋምኤ፤ ዎንትና ሻሪ ደንድያ ዎደ ኡንቱንቱካ ደንድኖ። ጋላሳ ግድና፥ ቃማ ግድና፥ ሻሪ ደንድያ ዎደ ኡንቱንቱካ ደንድኖ። <verse eid="NUM 9:21"/><verse number="22" style="v" sid="NUM 9:22"/>ሻሪ ዱንካንያ ቦላን ላኡ ጋላሳ ጋምእና፥ ዎይ እት አግና፥ ዎይ እት ላይ ጋምእና፥ እስራኤላቱ ባረንቱ ዱንካኔዳሳን ጋምኢኖፐ አትና ቢክኖ። ሽን ሻሪ ደንድያ ዎደ ኡንቱንቱካ ደንድኖ። <verse eid="NUM 9:22"/><verse number="23" style="v" sid="NUM 9:23"/>ኡንቱንቱ መና ጎዳ አዛዙዋን ዱንካኒኖነ ቃይ መና ጎዳ አዛዙዋን ደንድኖ፤ መና ጎዳይ ሙሴ ባጋና አዛዜዳዋዳን፥ ኡንቱንቱ መና ጎዳ አዛዙዋ ናጌድኖ።<verse eid="NUM 9:23"/></para>
  <chapter eid="NUM 9"/>
  <chapter number="10" style="c" sid="NUM 10"/>
  <para style="ms">ሲና ደርያፐ ሞኣበ ቡሳ</para>
  <para style="mr">(<ref loc="NUM 10:1-21:35">10:1—21:35</ref>)</para>
  <para style="s1">ብራፐ ኦሰቴዳ ጹሩምባቱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 10:1"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="NUM 10:1"/><verse number="2" style="v" sid="NUM 10:2"/>“ላኡ ጹሩምባቱዋ ብራፐ ቆጻደ ኦ፤ ያታደ አሳ ሺቆ ጼጋናዉነ ቃይ ዱንካኔዳ ሳፐ ደንዳናዉ ደንናዳን ፑና። <verse eid="NUM 10:2"/><verse number="3" style="v" sid="NUM 10:3"/>ሀ ላኡ ጹሩምባቱ ፑነትያ ዎደ፥ አሳይ ኡባይ ጋከትያ ዱንካንያ ፐንጊ ኔኮ ሺቆ። <verse eid="NUM 10:3"/><verse number="4" style="v" sid="NUM 10:4"/>ሽን እት ጹሩምባ ጻላላይ ፑነቶፐ፥ እስራኤልያ ዛራቱዋ ካፓቱ ነ ስን ሺቅኖ። <verse eid="NUM 10:4"/><verse number="5" style="v" sid="NUM 10:5"/>ኔን ጹሩምባ ቁ ኦደ ፑንያ ዎደ፥ አዋይ ዶልያ ባጋና ዱንካኔዳ ዛራቱ ደንድኖ። <verse eid="NUM 10:5"/><verse number="6" style="v" sid="NUM 10:6"/>ጹሩምባ ላኤን ቁ ኦደ ፑንያ ዎደ፥ ገድሳ ባጋና ዱንካኔዳ ዛራቱ ደንድኖ። ጹሩምባይ ቁ ግ ፑነትያዌ ደንዳናዉ ማላ ግዶ። <verse eid="NUM 10:6"/><verse number="7" style="v" sid="NUM 10:7"/>ያአዉ አሳ ሺሻናዉ ጹሩምባ ፑና፤ ሽን ኮሻ ቁ ኦደ ፑኖፓ። <verse eid="NUM 10:7"/><verse number="8" style="v" sid="NUM 10:8"/>አሮና ናናይ ቄሳቱ ጹሩምባ ፑንኖ። ሀዌ ነዉነ ይያ የለታ ኡባዉ መና ዎጋ ግዶ።<verse eid="NUM 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 10:9"/>“ህንተ ጋድያን መቱዋ ደንያ ህንተ ሞርክያና ህንተ ኦለታናዉ ከስያ ዎደ፥ ሄ ጹሩምባቱዋ ቁ ኦደ ፑንተ። ሄዋን መና ጎዳይ ህንተ ጾሳይ ህንተና ሄ ዎደ ሀሳዪደ፥ ህንተ ሞርክያፐ ህንተና አሻና። <verse eid="NUM 10:9"/><verse number="10" style="v" sid="NUM 10:10"/>ሄዋዳንካ፥ ቃይ ህንተ ናሸትያ ጋላስ፥ ባላ ቦንቻናዉ ህንተ ኬሬዳ ጋላስነ አግናይ ጼርያ ባላን፥ ህንተ ጹግያ ያርሹዋ ያርሽያ ዎደነ ህንተ እትፐተ ያርሹዋ ያርሽያ ዎደ ሄ ጹሩምባቱዋ ፑንተ፤ ሄዌ ጾሳ ስንን ህንተና ሀሳይስያዋ ግዳና። ታን መና ጎዳ፥ ህንተ ጾሳ” ያጌዳ።<verse eid="NUM 10:10"/></para>
  <para style="s1">እስራኤላቱ ሲናፐ ቤድኖ</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 10:11"/>ላኤን ላይን ላኤን አግናን ላታማን ጋላስ፥ ሻሪ ማርካተ ዱንካንያ ቦላፐ ደንዴዳ። <verse eid="NUM 10:11"/><verse number="12" style="v" sid="NUM 10:12"/>ሄዋፐ ጉይያን፥ እስራኤልያ አሳይ ሲና መላ ቢታፐ ደንዴዳ፤ ሻሪ ፓራና ግያ መላ ቢታ ጋኪደ ዎዳ። <verse eid="NUM 10:12"/><verse number="13" style="v" sid="NUM 10:13"/>ኡንቱንቱ ሀ ኮይሮ ቡሳዉ መና ጎዳይ ሙሴ ባጋና አዛዜዳዋዳን ደንዴድኖ።<verse eid="NUM 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 10:14"/>ይሁዳ ዛራቱዋና ዱንካኔዳ ባጋይ ባረንቱ አርማ ኦይቂደ ኮይሮ ደንዴድኖ። ይሁዳ ዛራቱ ካፑ አምናዳባ ናኣ ናአሶና፤ <verse eid="NUM 10:14"/><verse number="15" style="v" sid="NUM 10:15"/>ይሳኮራ ዛራቱ ካፑ ጹኣራ ናኣ ናታንኤላ፤ <verse eid="NUM 10:15"/><verse number="16" style="v" sid="NUM 10:16"/>ዛብሎና ዛራቱ ካፑ ሄሎና ናኣ ኤልኣባ።<verse eid="NUM 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 10:17"/>ሄዋፐ ጉይያን፥ ዱንካንያ ሾድና፥ ገርሾና ያራቱነ ማራራ ያራቱ ቶኪደ ደንዴድኖ።<verse eid="NUM 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 10:18"/>ካሊደ ሮቤላ ዛራቱዋና ዱንካኔዳ ባጋይ ባረንቱ አርማ ኦይቂደ ደንዴዳ። ሮቤላ ዛራቱ ካፑ ሻደኡራ ናኣ ኤሊጹራ፤ <verse eid="NUM 10:18"/><verse number="19" style="v" sid="NUM 10:19"/>ስሞና ዛራቱ ካፑ ጹሪሻዳያ ናኣ ሻሉምኤላ፤ <verse eid="NUM 10:19"/><verse number="20" style="v" sid="NUM 10:20"/>ጋዳ ዛራቱ ካፑ ረኡኤላ ናኣ ኤልያሳፋ።<verse eid="NUM 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 10:21"/>ሄዋፐ ጉይያን፥ ቃሃታ ያራቱ ጌሻ ሚሻቱዋ ቶኪደ ደንዴድኖ። ኡንቱንቱ ጋካናፐ ካሰቲደ፥ ዱንካኒ ቶለት ኡቴዳ።<verse eid="NUM 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 10:22"/>ካሊደ ኤፍሬማ ዛራቱዋና ዱንካኔዳ ባጋይ ባረ አርማ ኦይቂደ ደንዴዳ። ኤፍሬማ ዛራቱ ካፑ አምሁዳ ናኣ ኤልሻማአ፤ <verse eid="NUM 10:22"/><verse number="23" style="v" sid="NUM 10:23"/>ምናሰ ዛራቱ ካፑ ፓዳጹራ ናኣ ጋማልኤላ፤ <verse eid="NUM 10:23"/><verse number="24" style="v" sid="NUM 10:24"/>ቢንያማ ዛራቱ ካፑ ጊድኦና ናኣ አብዳና።<verse eid="NUM 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 10:25"/>ዉርሰን፥ ሀ ጩጉዋ ኡባዉ ጉየ ባጋን ናግያ ዳና ዛራቱዋና ዱንካኔዳ ባጋይ ባረ አርማ ኦይቂደ ደንዴዳ። ዳና ዛራቱ ካፑ አምሻዳያ ናኣ አህኤዘራ፤ <verse eid="NUM 10:25"/><verse number="26" style="v" sid="NUM 10:26"/>አሴራ ዛራቱ ካፑ ኦክራና ናኣ ፓግኤላ፤ <verse eid="NUM 10:26"/><verse number="27" style="v" sid="NUM 10:27"/>ንፍታሌማ ዛራቱ ካፑ ኤናና ናኣ አህራአ። <verse eid="NUM 10:27"/><verse number="28" style="v" sid="NUM 10:28"/>እስራኤልያ አሳይ ባረ ባጋን ባጋን ደንዲደ ብያ ማራይ ሀዋዳና።<verse eid="NUM 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 10:29"/>ሙሴ ምድያማ አሳ ግድያ ባረ ቦሉዋ ረኡኤላ ናኣ ሆባባ፥ “ኑን መና ጎዳይ፥ ‘ታን ህንተንቶ እማና’ ጌዳ ሳኣ ቤቶ፤ መና ጎዳይ እስራኤልያዉ ሎኦባ ኦና ጌዳ ድራዉ፥ ኔን ኑናና ደንዳ። ኑን ነዉ ሎኦባ ኦና” ያጌዳ።<verse eid="NUM 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 10:30"/>ሆባብ፥ “ቱይት፥ ታን ቢከ፤ ታን ታ ቢታ ታ አሳኮ ባና” ያጌዳ።<verse eid="NUM 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 10:31"/>ሙሴ አ፥ “ሀያና፥ ኑና የጋደ ቦፓርኪ! መላ ቢታን ኑን ዱንካናናዉ በስያሳ ኔን ኤራሳ፤ ኔን ኑ ብያ ኦግያ ኑና ካለናዉካ ዳንዳያሳ። <verse eid="NUM 10:31"/><verse number="32" style="v" sid="NUM 10:32"/>ኔን ኑናና ቦፐ፥ መና ጎዳይ ኑዉ እምያ አንጁዋ ኡባ ኑን ኔናና ሻካና” ያጌዳ።<verse eid="NUM 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 10:33"/>ያትና ኡንቱንቱ መና ጎዳ ደርያፐ ደንዲደ፥ ሄዙ ጋላሳ ኬሻ ኦግያ ቤድኖ። መና ጎዳ ጫቁዋ ታቦታይ ኡንቱንቱ ሸምፕያ ሳኣ ደማናዉ ሄ ሄዙ ጋላሳን ኡንቱንቱፐ ስንዉ ቤዳ። <verse eid="NUM 10:33"/><verse number="34" style="v" sid="NUM 10:34"/>ኡንቱንቱ ዱንካኔዳ ሳኣፐ ደንድያ ዎደ ኡባን፥ መና ጎዳ ሻሪ ጋላስ ጋላስ ኡንቱንቱፐ ቦላና ደኤ። <verse eid="NUM 10:34"/><verse number="35" style="v" sid="NUM 10:35"/>ታቦታይ ደንድያ ዎደ ኡባን ሙሴ፥ “አቤት መና ጎዳዉ፥ ደንዳ! ነ ሞርከቱ ላለትኖ፤ ኔና እጽያዋንቱካ ነ ስንፐ ባቃትኖ” ያጌ።<note caller="-" style="x"><char style="xo" closed="false">10:35 </char><char style="xt" closed="false"><ref loc="PSA 68:1">ማዝ. 68:1</ref></char></note> <verse eid="NUM 10:35"/><verse number="36" style="v" sid="NUM 10:36"/>ታቦታይ ሸምፕያ ዎደ ኡባን ሙሴ፥ “አቤት መና ጎዳዉ፥ ሀ ዳሮ ሻአን ፓይደትያ እስራኤልያ አሳኮ ኔን ስማ” ያጌ።<verse eid="NUM 10:36"/></para>
  <chapter eid="NUM 10"/>
  <chapter number="11" style="c" sid="NUM 11"/>
  <para style="s1">ጾሳፐ ዬዳ ታማ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 11:1"/>አሳይ ባረ መቶ መና ጎዳ ቦላ ዙዙሜዳ፤ ኡንቱንቱ ዙዙሚና ጾሳይ ስሲደ፥ ሀንቁዋ ኤጽ ከሴዳ። ያትና መና ጎዳ ታማይ ኡንቱንቱ ግዱዋን ኤጺደ፥ ኡንቱንቱ ዱንካኔዳ ሳአዉ እት እት ጋጻ ባጋ ሜዳ። <verse eid="NUM 11:1"/><verse number="2" style="v" sid="NUM 11:2"/>ያትና አሳይ ሙሴዉ ዋስና፥ ሙሴ መና ጎዳ ዎሴዳ። ታማይ ቶኤዳ። <verse eid="NUM 11:2"/><verse number="3" style="v" sid="NUM 11:3"/>መና ጎዳ ታማይ ኡንቱንቱ ግዱዋን ኤጼዳ ድራዉ፥ ሄ ሳአይ ታብኤራ<note caller="+" style="f"><char style="fr" closed="false">11:3 </char><char style="fq" closed="false">ታብኤራ፦ </char><char style="ft" closed="false">ሀ ሱን ብለይ “ኤጼዳ” ግያዋ።</char></note> ጌተት ጼሰቴዳ።<verse eid="NUM 11:3"/></para>
  <para style="s1">ሙሴ ላፑን ታሙ ካፓቱዋ ዶሬዳ</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 11:4"/>እስራኤላቱዋና ደእያ ዱማ ዱማ ጋደ አሳይ ሀራ ቁማ ሎይ አሞቴዳ። እስራኤልያ አሳይካ ቃይ ሀዋዳን ያጊደ ዬኩዋ ዶሜዳ፤ “ላ ኑን አሹዋ ሀቃፐ ደማኔ? <verse eid="NUM 11:4"/><verse number="5" style="v" sid="NUM 11:5"/>ኑን ግብጼ ጋድያን ሚሻ ጭገናን ጮ ምያ ሞልያ ሀሳዬቶ፤ ቃይ ቃይያ ምያ ፓራንጅያ ሌክያ፥ ዞልዶ ሌኪያ ማላትያ ማልእያ ሃይ ኩሜዳ ሜሎንያ፥ አዱሳ ፓራንጅያ ሱንቁሩትያነ ቱሙዋ ሀሳዬቶ። <verse eid="NUM 11:5"/><verse number="6" style="v" sid="NUM 11:6"/>ሽን ሀእ ኑ ቆ ጎርደቴዳ፤ ኑ አይፊካ ሀ ማናፐ አትና፥ ሀራባ አይነ በኤና” ያጌድኖ።<verse eid="NUM 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 11:7"/>ማናይ ዴቡዋ አይፍያ ማላቴ፤ አ ማላይ ቦጽያ ም ጮሻ ማላቴ።<note caller="-" style="x"><char style="xo" closed="false">11:7-8 </char><char style="xt" closed="false"><ref loc="EXO 16:31">ከሳ 16:31</ref></char></note> <verse eid="NUM 11:7"/><verse number="8" style="v" sid="NUM 11:8"/>አሳይ ዩይ ዩይ አ ቆሬ፤ ዎጻን ጋጬ፥ ዎይ ኡዱላን ጫዴ፤ ኡንቱንቱ አ ኦቱዋን ፐንትሲደ፥ ባሽያን ኮምፒኖ። እ ዛይትያን ሙናቂደ ኡኬዳ ኡክዳን ማልኤ። <verse eid="NUM 11:8"/><verse number="9" style="v" sid="NUM 11:9"/>ቃማ ዱንካኔዳሳን ጻሳይ ዎያ ዎደ፥ ማናይ አናና ዎ።<note caller="-" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="EXO 16:13-15">ከሳ 16:13-15</ref></char></note><verse eid="NUM 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 11:10"/>አሳይ ባረ ዱንካንያ ፐንግያን ፐንግያን ዬክሽን፥ ሙሴ ስሴዳ። መና ጎዳ ሀንቁ ኤጽ ከሴዳ ድራዉ፥ ሙሴ ኡንኤቴዳ። <verse eid="NUM 11:10"/><verse number="11" style="v" sid="NUM 11:11"/>ሄዋ ድራዉ፥ ሙሴ መና ጎዳ ሀዋዳን ያጊደ ኦቼዳ፤ “ኔን ታ ቦላ ነ ቆማ ቦላ አያዉ ሀ መቱዋ አሃዲ? ኔን ታናን አያዉ ናሸታበይኪ? ኔን ሀ አሳ ኡባ ቶኩዋ ታ ቦላ አያዉ ዎዲ? <verse eid="NUM 11:11"/><verse number="12" style="v" sid="NUM 11:12"/>ሀ አሳ ኡባ ታን ሻሃራድታየ? ዎይ ኡንቱንታ ታን የላድታ? ‘ኔን ኡንቱንቱ ማይዛ አዋቶ፥ “ታን ህንተንቶ እማና” ጋደ ጫቄዳ ቢታ ጋናዉ፥ ናናቱዋ ድችያና ንያ ናኣ ባረ ክዉዋን እድምያዋዳን፥ ኔን ኡንቱንታ ነ ክዉዋን እድማ’ ያጋደ ታዉ አያዉ ኦዳይ? <verse eid="NUM 11:12"/><verse number="13" style="v" sid="NUM 11:13"/>ሀ አሳዉ ኡባዉ ታን አሹዋ ሀቃፐ ደማኔ? ኡንቱንቱ ታና፥ ‘ምያ አሹዋ ኑዉ እማ’ ያጊደ ዬኪኖ። <verse eid="NUM 11:13"/><verse number="14" style="v" sid="NUM 11:14"/>ታን ሀ አሳ ኡባ ታረካ ቶካና ዳንዳይከ፤ ቶኩ ታዉ ሎይ ዴጼ። <verse eid="NUM 11:14"/><verse number="15" style="v" sid="NUM 11:15"/>ስም ኔን ታና ሀዋዳን መቶታናዳን ኦናዋፐ ታዉ ቃረታደ ታና ሀእ ዎ ባሻ፤ ያቶፐ፥ ታን መቱዋፐ ሸምፓና” ያጌዳ።<verse eid="NUM 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 11:16"/>መና ጎዳይ ሙሳ፥ “እስራኤልያ ጭማቱዋፐ ካለያዋንታነ ካፓቱዋ ግድያ፥ ኔን ኤርያ ላፑን ታሙ ጭማቱዋ ታዉ ሺሻ፤ ኡንቱንቱ ኔናና ያን ኤቃና ማላ፥ ጾሳ ዱንካንያኮ፥ ኡንቱንታ ኔን አያ። <verse eid="NUM 11:16"/><verse number="17" style="v" sid="NUM 11:17"/>ታን ዱገ ዎደ ኔናና ያን ሃሳያና፤ ታን ኔናን ደእያ አያናፐ አካደ፥ ሄ አያና ኡንቱንቱ ቦላ ዎና። ኔን ኔረካ ቶከና ማላ፥ ኡንቱንቱ አሳ ቶኩዋ ቶኪደ፥ ኔና ማዳና።<verse eid="NUM 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 11:18"/>“ኔን አሳዉ ሀዋዳን ጋደ ኦዳ፥ ‘ዎንትዉ ህንተና ጌሽተ፤ ያቲደ ህንተ አሹዋ ማና። ህንተ፥ “ላ ኑን አሹዋ ሀቃፐ ደማኔ? ኑዉ ግብጼ ጋድያን ሳአይ ሎአ ሽን!” ያጊደ ዬኬዳዋ መና ጎዳይ ስሴዳ። መና ጎዳይ አሹዋ ሀእ ህንተንቶ እማና፤ እምና ህንተ ማና። <verse eid="NUM 11:18"/><verse number="19-20" style="v" sid="NUM 11:19-20"/>ህንተ ግዱዋን ደእያ መና ጎዳ ህንተ ካዳ ድራዉነ ህንተ፥ “ኑን ግብጼ ጋድያፐ አያዉ ከሴዶ?” ያጊደ አ ስንን ዬኬዳ ድራዉ፥ ህንተ እት ጋላሳ፥ ዎይ ላኡ ጋላሳ፥ ዎይ እቼሹ ጋላሳ፥ ዎይ ታሙ ጋላሳ፥ ዎይ ላታሙ ጋላሳ ጻላላ አሹዋ ሚክታ፤ ሽን ህንተንቶ ሲያና ከሳና ጋካናዉ፥ ህንተና ሳለና ጋካናዉ፥ እት አግና ኩመን ህንተ አሹዋ ማና’ ያጋ” ያጌዳ።<verse eid="NUM 11:19-20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 11:21"/>ሽን ሙሴ ጾሳ፥ “በአ፥ ታን ኡሱፑን ጼቱ ሻአ ግድያ አሳ ግዱዋን ደአይ፤ ኔን፥ ‘እት አግና ኩመን ኡንቱንቱ ማናዉ ኡንቱንቶ ታን አሹዋ እማና’ ጋዳ። <verse eid="NUM 11:21"/><verse number="22" style="v" sid="NUM 11:22"/>ሚዛ ዉድያነ ዶርሳ ዉድያ ኡንቱንቶ ሹክና ካልሳኔ? አባን ደእያ ሞልያ ኡባ ሺሽያዋ ግድንቶነ፥ ኡንቱንቶ ግዳኔ?” ያጌዳ።<verse eid="NUM 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 11:23"/>መና ጎዳይ ሙሳ፥ “መና ጎዳ ኩሺ ቃንየ? ታን ነዉ ግያባይ ቱመንቶነ ዎርደንቶ ኔን ሀእ በአና” ያጌዳ።<verse eid="NUM 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 11:24"/>ሙሴ ካረ ከሲደ፥ መና ጎዳይ ጌዳዋ አሳዉ ኦዴዳ። እ እስራኤልያ ጭማቱዋፐ ላፑን ታሙ አሳ ሺሺደ፥ ዱንካንያ ዩሹዋን ኤሴዳ። <verse eid="NUM 11:24"/><verse number="25" style="v" sid="NUM 11:25"/>መና ጎዳይ ሻሪያን ዱገ ዎደ፥ አናና ሃሳዬዳ፤ ያቲደ አ ቦላን ደእያ አያናፐ አኪደ፥ ሄ ላፑን ታሙ ጭማቱዋ ቦላ ዎዳ። አያናይ ኡንቱንቱ ቦላን ሸምፔዳ ዎደ፥ ኡንቱንቱ ትምቢትያ ኦዴድኖ። ሽን ሄዋፐ ጉይያን፥ ዛረደ ትምቢትያ ኦድበይክኖ።<verse eid="NUM 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 11:26"/>ሄ ላፑን ታሙ ጭማቱዋና ማዝጎብያን ጻፈቴዳ አሳቱ ኤልዳዳነ መዳዳ ግያ ላአቱ ዱንካኔዳሳን አቴድኖ፤ ዱንካንያኮ ይበይክኖ፤ ሽን ኡንቱንቱ ቦላካ አያናይ ዎና፥ ዱንካኔዳሳን ትምቢትያ ኦዴድኖ። <verse eid="NUM 11:26"/><verse number="27" style="v" sid="NUM 11:27"/>እት ዎዳላይ ዎጽ ዪደ፥ ሙሳ፥ “ኤልዳድነ መዳድ ዱንካኔዳሳን ትምቢትያ ኦዲኖ” ያጊደ ኦዴዳ።<verse eid="NUM 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 11:28"/>ባረ ያላጋተፐ ዶሚደ፥ ሙሳ ማድያ ኔዌ ናአይ ኢያሱ ሙሳ፥ “ታ ጎዳዉ ሙሴ፥ ኔን ኡንቱንታ ተአ” ያጌዳ።<verse eid="NUM 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 11:29"/>ሽን ሙሴ አ፥ “ታ ግሻታ ነ ምሸታይ? መና ጎዳ አሳይ ኡባይ ትምቢትያ ኦድያዋነ መና ጎዳይ ባረ አያና ኡንቱንቱ ቦላ ዎያዋ ግዴረኔሻ!” ያጌዳ። <verse eid="NUM 11:29"/><verse number="30" style="v" sid="NUM 11:30"/>ሄዋፐ ጉይያን፥ ሙሴነ እስራኤልያ ጭማቱ ዱንካኔዳሳ ስሜድኖ።<verse eid="NUM 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 11:31"/>ሄዋፐ ጉይያን፥ መና ጎዳይ ጫርኩዋ ደንና፥ አባ ባጋፐ አካ አሳይ ዱንካኔዳሳ ኡባ ዩሹዋኮ ጫርኩ አሄዳ፤ ሄ ካፎቱ ሳኣ ዶናና ጋድያፐ ፑደ ላኡ ዋ ኬሻን ፓሌድኖ። ዪደ ኡንቱንቱ ዱንካኔዳሳ ኡባፐ ጋጻና፥ እት ጋላሳ ኦገ ኬና ሳኣን ኡቴድኖ። <verse eid="NUM 11:31"/><verse number="32" style="v" sid="NUM 11:32"/>ሄ ጋላሳ ኡባን፥ ሄ ቃማ ኡባንነ ዎንተ ጋላሳ ኡባን አሳይ ካረ ከሲደ፥ ሀ አካቱዋ ኦይቂደ ሺሼዳ፤ ኡንቱንቱፐ ኦንነ እት ሻአ ኪሎ ግራመፐ ጉ ሺሽቤና። ኡንቱንቱ ሄዋፐ ጉይያን፥ ዱንካኔዳሳ ዩሹዋ ኡባን መልሳናዉ ምጬድኖ። <verse eid="NUM 11:32"/><verse number="33" style="v" sid="NUM 11:33"/>ሽን አሹ ብሮ ኡንቱንቱ ማታን ደእሽን፥ ኡንቱንቱ ጮሚደ ምተናን ደእሽን፥ መና ጎዳ ሀንቁ አሳ ቦላ ኤጽ ከሴዳ፤ ያትና መና ጎዳይ አሳ ዎልቃማ ቦሻን ሾጬዳ። <verse eid="NUM 11:33"/><verse number="34" style="v" sid="NUM 11:34"/>ያትና ሄ ሳአይ ክብሮት ሀታባ (አሙዋ ዱፉዋ) ጌተት ሱንቴዳ፤ አያዉ ጎፐ፥ አሹዋ አሞቴዳ አሳ ኡንቱንቱ ሄ ሳኣን ሞጌድኖ። <verse eid="NUM 11:34"/><verse number="35" style="v" sid="NUM 11:35"/>አሳይ ሄዋፐ ደንዲደ ሀጸሮታ ግያሳ ቢደ፥ ያን ዱንካኔዳ።<verse eid="NUM 11:35"/></para>
  <chapter eid="NUM 11"/>
  <chapter number="12" style="c" sid="NUM 12"/>
  <para style="s1">ሚርያማነ አሮን ሙሳ ኤቀቴድኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 12:1"/>ሙሴ ቶጵያ ቢታ ምሽራቶ አኬዳ። እ አኬዳ ቶጵያ ማጫን ድራዉ፥ ሚርያማነ አሮን ሙሳ ቦሬድኖ። <verse eid="NUM 12:1"/><verse number="2" style="v" sid="NUM 12:2"/>ኡንቱንቱ፥ “መና ጎዳይ ሙሴ ባጋ ጻላላና ሃሳዬደየ? ቃይ እ ኑ ባጋና ሃሳይቤኔየ?” ያጌድኖ። መና ጎዳይ ሄዋ ስሴዳ። <verse eid="NUM 12:2"/><verse number="3" style="v" sid="NUM 12:3"/>ሙሴ ጋድያን ሳኣን ኡባን ደእያ አሳ ኡባፐ አያ አሽከ አሳ።<verse eid="NUM 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 12:4"/>መና ጎዳይ ኤለካ ሙሴዉ፥ አሮናዉነ ሚርያምዉ፥ “ህንተ ሄዙካ ጋከትያ ዱንካንያኮ ከስተ” ያጌዳ፤ ኡንቱንቱ ሄዙካ ከሴድኖ። <verse eid="NUM 12:4"/><verse number="5" style="v" sid="NUM 12:5"/>ጾሳይ ሻርያ ቱሳን ዱገ ዎዳ፤ ዱንካንያ ፐንግያን ኤቂደ፥ አሮናነ ሚርያሞ ጼሴዳ። ኡንቱንቱ ላኡካ አ ስን ሺቅና፥ <verse eid="NUM 12:5"/><verse number="6" style="v" sid="NUM 12:6"/>እ ኡንቱንታ፥ “ታ ኦድያዋ ስስተ: ህንተ ግዱዋን ትምቢትያ ኦድያዌ ደኦፐ፥ ታን መና ጎዳይ ታና አዉ ሳጻን ቆንጭሳይ፤ ታን አዉ አኩሙዋን ኦዳይ። <verse eid="NUM 12:6"/><verse number="7" style="v" sid="NUM 12:7"/>ሽን ታ ቆማ ሙሴና ሄዋዳን ግደና፤ እ ታ ጎልያ ኡባን አማነቴዳዋ።<note caller="-" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="HEB 3:2">እብራ. 3:2</ref></char></note> <verse eid="NUM 12:7"/><verse number="8" style="v" sid="NUM 12:8"/>ታን ሙሴና ስን ስንን ሃሳያይፐ አትና፥ ሌምሱዋን ሃሳይከ። እ መና ጎዳ ማላ በኤ። ያትና ታ ቆማ ሙሳ ቦራናዉ ህንተ አያዉ ያይበይክቴ?” ያጌዳ።<verse eid="NUM 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 12:9"/>መና ጎዳ ሀንቁ ኡንቱንቱ ቦላ ኤጽ ከሴዳ፤ መና ጎዳይ ቤዳ። <verse eid="NUM 12:9"/><verse number="10" style="v" sid="NUM 12:10"/>ሻሪ ዱንካንያ ቦላፐ ደንዴዳ ዎደ፥ ሚርያማ ዎልቃማ ጋልባ ሀርግያን ምልጽ ጋደ ቦጻዱ። አሮን ኢኮ ስሚደ ጼልያ ዎደ፥ ዎልቃማ ጋልባ ሀርግያን ኦይቀቴዳኖ በኤዳ። <verse eid="NUM 12:10"/><verse number="11" style="v" sid="NUM 12:11"/>ያትና እ ሙሳ፥ “ሀይ ታ ጎዳዉ፥ ኑን ኤያተን ኦዳ ናጋራዉ ኑና ሙሮፓ። <verse eid="NUM 12:11"/><verse number="12" style="v" sid="NUM 12:12"/>ባረ ዳይ ኡሉዋፐ ከስያ ዎደ፥ አ አሹዋፐ ባጋይ ሜተት ክችና፥ ሀይቂ ክቺደ የለቴዳ ጋጭኖ ናኣ ማላ ግዶፓረኬ” ያጌዳ።<verse eid="NUM 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 12:13"/>ሙሴ፥ “ሀይ ጾሳዉ፥ እዞ ፓርኪ!” ያጊደ መና ጎዳዉ ዋሴዳ።<verse eid="NUM 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 12:14"/>መና ጎዳይ ሙሳ፥ “እ አዉ እ ሶምእያን ጩቻ ጩቼዳዋ ግድንቶነ፥ ላፑን ጋላሳ እዛ ዬላ ማያደ ኡታና ግደኬየ? ሄዋ ድራዉ፥ ኔን እዞ ላፑን ጋላሳ ዱንካኔዳ ሳኣፐ ጋጻ ባጋና ዱማ ሳኣን ኡትሳ፤ ሄዋፐ ጉይያን፥ ስማደ ዩ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">12:14 </char><char style="xt" closed="false"><ref loc="NUM 5:2-3">ፓይ. 5:2-3</ref></char></note> <verse eid="NUM 12:14"/><verse number="15" style="v" sid="NUM 12:15"/>ያትና ሚርያማ አሳይ ዱንካኔዳ ሳኣፐ ጋጻ ከሳደ ላፑን ጋላሳ ኡታዱ። አ ስማና ጋካናዉ አሳይ ባናዉ ደንድቤና። <verse eid="NUM 12:15"/><verse number="16" style="v" sid="NUM 12:16"/>ሄዋፐ ጉይያን፥ አሳይ ሀጸሮታ ግያ ሳፐ ደንዲደ፥ ፓራና መላ ቢታ ዱንካኔዳ።<verse eid="NUM 12:16"/></para>
  <chapter eid="NUM 12"/>
  <chapter number="13" style="c" sid="NUM 13"/>
  <para style="s1">ካናነ ቢታ ዎቻናዉ ቤዳ አሳቱዋ</para>
  <para style="r">(<ref loc="DEU 1:19-33">ዛረ. 1:19-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 13:1"/>መና ጎዳይ፥ ሙሳ፥ <verse eid="NUM 13:1"/><verse number="2" style="v" sid="NUM 13:2"/>“ታን እስራኤላቶ እምያ ካናነ ቢታ ዎቻና ማላ፥ አማሬዳ አሳ ኪታ፤ ኡንቱንቱ ዛረ ኡባፐ እት እት ካፑዋ ኪታ” ያጌዳ። <verse eid="NUM 13:2"/><verse number="3" style="v" sid="NUM 13:3"/>ሙሴ መና ጎዳ አዛዙዋን ፓራና መላ ቢታፐ ኡንቱንታ ኪቴዳ። ኡንቱንቱ ኡባይካ እስራኤልያ አሳ ካፓቱዋ። <verse eid="NUM 13:3"/><verse number="4" style="v" sid="NUM 13:4"/>ኡንቱንቱ ሱንይ ሀዋፐ ካሊደ ጻፈቴዳዋ:</para>
  <para style="m" vid="NUM 13:4">ዛርያ ካፑዋ ሮቤላ ዛኩራ ናኣ ሻሙአ፤<verse eid="NUM 13:4"/></para>
  <para style="m">
    <verse number="5" style="v" sid="NUM 13:5"/>ስሞና ሆራ ናኣ ሻፋጻ፤<verse eid="NUM 13:5"/></para>
  <para style="m">
    <verse number="6" style="v" sid="NUM 13:6"/>ይሁዳ ይፉነ ናኣ ካሌባ፤<verse eid="NUM 13:6"/></para>
  <para style="m">
    <verse number="7" style="v" sid="NUM 13:7"/>ይሳኮራ ዮሴፎ ናኣ ይግኣላ፤<verse eid="NUM 13:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="NUM 13:8"/>ኤፍሬማ ኔዌ ናኣ ሆሼአ፤<verse eid="NUM 13:8"/></para>
  <para style="m">
    <verse number="9" style="v" sid="NUM 13:9"/>ቢንያማ ራፉ ናኣ ፓልጻ፤<verse eid="NUM 13:9"/></para>
  <para style="m">
    <verse number="10" style="v" sid="NUM 13:10"/>ዛብሎና ሶዳ ናኣ ጋድኤላ፤<verse eid="NUM 13:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="NUM 13:11"/>ዮሴፎ ናኣ ምናሳ ሱሳ ናኣ ጋዳ፤<verse eid="NUM 13:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="NUM 13:12"/>ዳና ጋማላ ናኣ አምኤላ፤<verse eid="NUM 13:12"/></para>
  <para style="m">
    <verse number="13" style="v" sid="NUM 13:13"/>አሴራ ምካኤላ ናኣ ሳቱራ፤<verse eid="NUM 13:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="NUM 13:14"/>ንፍታሌማ ዋፍሳ ናኣ ናህባ፤<verse eid="NUM 13:14"/></para>
  <para style="m">
    <verse number="15" style="v" sid="NUM 13:15"/>ጋዳ ማካ ናኣ ገኡኤላ።<verse eid="NUM 13:15"/></para>
  <para style="m">
    <verse number="16" style="v" sid="NUM 13:16"/>ሄ ቢታ ዎቻና ማላ፥ ሙሴ ኪቴዳ አሳቱ ሱንይ ሀዋፐ ቆሞና ደእያዋ። ሙሴ ኔዌ ናኣ ሆሼአ ሱን ኢያሳ ያጊደ ሱንዳ።<verse eid="NUM 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 13:17"/>ኡንቱንቱ ካናነ ቢታ ዎቻና ማላ፥ ሙሴ ኡንቱንታ ኪትያ ዎደ ሀዋዳን ያጌዳ፤ “ሀዋፐ ኔጌባ መላ ቢታ ፑደ ከሲደ፥ ያፐ ሁጲሳ ባጋን ደእያ ገዘ ቢታ ቢተ። <verse eid="NUM 13:17"/><verse number="18" style="v" sid="NUM 13:18"/>ቢታይ አይ ማላ ቢተንቶነ በእተ፤ ሄ ጋድያን ደእያ አሳይ ምነንቶነ ላፈንቶ፥ ጉንቶነ ዳረንቶ፥ <verse eid="NUM 13:18"/><verse number="19" style="v" sid="NUM 13:19"/>ኡንቱንቱ ደእያ ቢታይ ሎኤንቶነ ኢተንቶ፥ ኡንቱንቱ ደእያ ካታማይነ አይ ማላ ካታመንቶ፥ ግምቢያን ድረት ኡቴደንቶ ድረትቤነንቶ፥ <verse eid="NUM 13:19"/><verse number="20" style="v" sid="NUM 13:20"/>ቢታይ አይ ማላ ቱኤንቶነ ላደንቶ፥ ሄ ጋድያን ምይ ደእንቶነ ባዌንቶ በእተ። ምንተ! ሄ ጋድያን ሞኬዳዋ አይፍያፐ አከናን ዮፕተ” ያጌዳ። ሄ ዎዲ ዎይንያ ቱራይ ኮይሮ አይፍያ አይፍያ ዎደ።<verse eid="NUM 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 13:21"/>ኡንቱንቱ ፑደ ከሲደ፥ ጺና ግያ መላ ቢታፐ ዶሚደ፥ ቢደ ሀማታ ፕኑዋ ማታን ደእያ ራሆባ ጋካናዉ ሄ ቢታ ዎቼድኖ። <verse eid="NUM 13:21"/><verse number="22" style="v" sid="NUM 13:22"/>ኔጌባ ፑደ ከሲደ፥ ከብሮና ጋኬድኖ፤ ሄዋን አህማና፥ ሸሻያነ ታልማያ ጌተትያ አናቀ ዛራቱ ደኢኖ። ከብሮን ግብጼን ደእያ ጾኣነ ካታማፐ ላፑን ላይ ካሰት ኬጸቴዳ።<verse eid="NUM 13:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 13:23"/>ሄዋና አደ፥ ኡንቱንቱ ኤሽኮላ ግያ ዛንጋራ ቢደ ጋኬዳ ዎደ፥ ዎይንያ ቱራ እቱዋፐ እት ዉርጩዋና ደእያ እት ታሽያ ቃንጼድኖ፤ ኡንቱንቱፐ ላኡ ካሱዋ ግዱዋን ገልስ ቶኬድኖ። ሄዋና ሮማንያነ ባላስያ ግያ ምቱዋ አይፍያ አሄድኖ። <verse eid="NUM 13:23"/><verse number="24" style="v" sid="NUM 13:24"/>እስራኤልያ አሳቱ ሄዋፐ ቃንጼዳ ዎይንያ ቱራ ዉርጩዋ ድራዉ፥ ሄ ሳኣ ኤሽኮላ<note caller="+" style="f"><char style="fr" closed="false">13:24 </char><char style="fq" closed="false">ኤሽኮላ፦ </char><char style="ft" closed="false">ሀ ሱን ብለይ እብራዌዋን፥ “ዳሮ ዎይኒ ደእያ ሳኣ” ግያዋ።</char></note> ዛንጋራ ጊደ ጼሴድኖ።<verse eid="NUM 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 13:25"/>ኡንቱንቱ ሄ ቢታ ዎቺደ፥ ኦይታሙ ጋላሳፐ ጉይያን ስሜድኖ፤ <verse eid="NUM 13:25"/><verse number="26" style="v" sid="NUM 13:26"/>ፓራና መላ ቢታን ቃዴሳ ግያ ሳን ደእያ ሙሴኮ፥ አሮነኮነ እስራኤልያ አሳ ማባራ ኡባኮ ዬድኖ። ባረንቱ በኤዳዋ ኡንቱንቶዉነ አሳ ኡባዉ ኦዴድኖ፤ ሄ ጋድያን አይፍያ አይፍያካ ኡንቱንታ በሴድኖ። <verse eid="NUM 13:26"/><verse number="27" style="v" sid="NUM 13:27"/>ኡንቱንቱ ሙሴዉ ሀዋዳን ያጊደ ኦዴድኖ፤ “ኔን ኑና ኪቴዳ ቢታ ኑን ቤዶ፤ ሄ ጋድያን ማይነ ኤሳይ ጎጌ። አን አይፍያ አይፍያካ ሀዋ በአ። <verse eid="NUM 13:27"/><verse number="28" style="v" sid="NUM 13:28"/>ሽን ሄ ጋድያን ደእያ አሳይ ዎልቃማ፤ ኡንቱንቱ ካታማይካ ግምቢያ ድርሳን ድረት ኡቴዳዋነ ዎልቃማ። ኑን ቃይ አናቀ ዛራቱዋ ያን በኤዶ። <verse eid="NUM 13:28"/><verse number="29" style="v" sid="NUM 13:29"/>ኔጌባ አማሌቃ አሳቱ ደኢኖ፤ ገዝያን ሂተቱ፥ ያቡሳቱነ አሞራቱ ደኢኖ፤ ቃይ ካናነቱ ሜድተራነ አባ ዶናንነ ዮርዳኖሳ ሻፋ ጋጻን ደኢኖ” ያጌድኖ።<verse eid="NUM 13:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 13:30"/>ካሌብ አሳ ሙሴ ስንን ጮኡ ጊሲደ፥ “ኑን ቱሙ ጾናናዉ ዳንዳይያ ድራዉ፥ ፑደ ሀእ ከሲደ፥ ሄ ቢታ ኦሊደ አነ ኦይቆይተ” ያጌዳ።<verse eid="NUM 13:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 13:31"/>ሽን ካሌበና ፑደ ቤዳ አሳቱ፥ “ሄ ቢታ አሳይ ኑፐ ምንያ ድራዉ፥ ኑን ኡንቱንታ ጾናናዉ ዳንዳዮኮ” ያጌድኖ። <verse eid="NUM 13:31"/><verse number="32" style="v" sid="NUM 13:32"/>ኡንቱንቱ ዩይ ዎቼዳ ቢታ እስራኤልያ አሳዉ ሀዋዳን ጊደ፥ ኢታ ኦዱዋ ኦዴድኖ፥ “ኑን ዎቼዳ ቢታይ ባረናን ደእያ አሳካ ምያዋ፤ አሳይ ኡባይካ ሎይ አዱሳ። <verse eid="NUM 13:32"/><verse number="33" style="v" sid="NUM 13:33"/>ኑን ዎጋ አዱሳ አሳቱ ያራ ግድያ አናቀ ዛራቱዋ ያን በኤዶ፤ ኑን ኑ አይፍያን ኑና ጼልያ ዎደ ቡምቡረ ማላቴቶ፤ ቃይ ኑን ኡንቱንቱ አይፍያን ሄዋካ ማላ” ያጌድኖ።<note caller="-" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="GEN 6:4">ዶመ 6:4</ref></char></note><verse eid="NUM 13:33"/></para>
  <chapter eid="NUM 13"/>
  <chapter number="14" style="c" sid="NUM 14"/>
  <para style="s1">አሳ ማካላ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 14:1"/>ሄ ጋላሳ ቃማ ማባራይ ኡባይ ባረንቱ ቃላ ቂሲደ ዬኬድኖ። <verse eid="NUM 14:1"/><verse number="2" style="v" sid="NUM 14:2"/>እስራኤልያ አሳይ ኡባይ ሙሴ ቦላነ አሮና ቦላ ዙዙሜድኖ። ማባራይ ኩመንይ ኡንቱንታ፥ “ኑን ግብጼ ጋድያን ደኢደ ሀይቄዳዋ ግዴሮኮ! ዎይ ኑን ሀ መላ ቢታን ሀይቄዳዋ ግዴሮኮ! <verse eid="NUM 14:2"/><verse number="3" style="v" sid="NUM 14:3"/>ማሻን ኑና ዎ ዉርሳናዉ መና ጎዳይ ሀ ቢታ ኑና አያዉ አሂ? ኑ ማቼቱነ ኑ ናናይ ኦሞደታና። ሄዋፐ ጉየ ግብጼ ቢታ ስምያዌ ኑዉ ኬከኔየ?” ያጌድኖ። <verse eid="NUM 14:3"/><verse number="4" style="v" sid="NUM 14:4"/>ቃይ ኡንቱንቱ እቱ እቱዋ፥ “ኑን ካለያዋ ዶሪደ፥ ጉየ ግብጼ ስሜቶ” ያጌድኖ።<verse eid="NUM 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 14:5"/>ሙሴነ አሮን ሄዋን ሺቄዳ እስራኤልያ አሳ ማባራ ኡባ ስንን ሶምኡዋ ሳኣን ጋደ ጉፋኔድኖ። <verse eid="NUM 14:5"/><verse number="6" style="v" sid="NUM 14:6"/>ሄ ቢታ ዎቼዳ አሳቱ ግዶፐ ኔዌ ናአይ ኢያሱነ ይፉነ ናአይ ካሌብ ባረንቱ ማዩዋ ፔድኖ። <verse eid="NUM 14:6"/><verse number="7" style="v" sid="NUM 14:7"/>እስራኤልያ አሳ ማባራ ኡባዉ፥ “ኑን ካን ከሲደ ዎቼዳ ቢታይ ሎይ ዳሮ ሎአ። <verse eid="NUM 14:7"/><verse number="8" style="v" sid="NUM 14:8"/>መና ጎዳይ ኑናን ናሸትያዋ ግዶፐ፥ ማይነ ኤሳይ ጎግያ ሄ ቢታዉ ኑና እ ገልሳና፤ ሄ ቢታ ኑዉ እ እማና። <verse eid="NUM 14:8"/><verse number="9" style="v" sid="NUM 14:9"/>ሄዋ ድራዉ፥ መና ጎዳ ቦላ ማካላ ማካሎፕተ። ሄ ቢታ አሳዉ ያዮፕተ፤ ኡንቱንቱ ኑዉ ሃ ኡሻካ ጋክክኖ። ኡንቱንቶ አምቦምያዌ ባዋ፤ ሽን መና ጎዳይ ኑናና ደኤ። ህንተ ኡንቱንቶ ያዮፕተ!” ያጌድኖ።<note caller="-" style="x"><char style="xo" closed="false">14:9 </char><char style="xt" closed="false"><ref loc="HEB 3:16">እብራ. 3:16</ref></char></note> <verse eid="NUM 14:9"/><verse number="10" style="v" sid="NUM 14:10"/>ማባራይ ኡባይ ኡንቱንታ ሹቻን ጫዳናዉ ሃሳዬድኖ።</para>
  <para style="p" vid="NUM 14:10">ሄ ዎደ መና ጎዳ ቦንቹ ጋከትያ ዱንካንያን እስራኤልያ አሳ ኡባዉ ቆንጬዳ። <verse eid="NUM 14:10"/><verse number="11" style="v" sid="NUM 14:11"/>መና ጎዳይ ሙሳ፥ “ሀ አሳይ አዉደ ጋካናዉ ታና ካኔ? ታን ኡንቱንቱ ግዱዋን ኦዳ ማላታ ኡባ በኢደ፥ አዉደ ጋካናዉ ኡንቱንቱ ታናን አማነናን እጻኔ? <verse eid="NUM 14:11"/><verse number="12" style="v" sid="NUM 14:12"/>ታን ኡንቱንታ ኢታ ሀርግያን ሾጫደ ይሳና፤ ያታደ ታን ኔና ኡንቱንቱፐ ዳርያነ ምንያ ካዉተዉ አዉዋ ኦና” ያጌዳ።<verse eid="NUM 14:12"/></para>
  <para style="s1">ሙሴ አሳ ድራዉ ዎሴዳ</para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 14:13"/>ሙሴ መና ጎዳ ሀዋዳን ያጊደ ዎሴዳ፤ “ኔን ነ ዎልቃን ሀ አሳ ግብጼፐ ፑደ ከሴዳዋ ኤርያ ግብጼቱ ሀዋ ስሶፐ፥ ኡንቱንቱ ዋጋኔ?<note caller="-" style="x"><char style="xo" closed="false">14:13-19 </char><char style="xt" closed="false"><ref loc="EXO 32:11-14">ከሳ 32:11-14</ref></char></note> <verse eid="NUM 14:13"/><verse number="14" style="v" sid="NUM 14:14"/>ኡንቱንቱ ሀ ጋድያን ደእያዋንቶካ ሄዋ ኦዳና። አቤት መና ጎዳዉ፥ ኔን ሀ አሳ ግዱዋን ደእያዋ ኡንቱንቱ ስሴድኖ። አቤት መና ጎዳዉ፥ ኑን ኔና በኤዳዋ ኡንቱንቱ ኤሬድኖ፤ ነ ሻሪ ኡንቱንቱፐ ቦላና ታክያዋነ ጋላስ ሻርያ ቱሳን፥ ቃማ ታማ ቱሳን ኔን ኡንቱንቱ ስንን ብያዋ በኤድኖ። <verse eid="NUM 14:14"/><verse number="15" style="v" sid="NUM 14:15"/>ሀእ ኔን ሀ አሳ ኡባ እት ኩን ዎያዋ ግዶፐ፥ ነ ካሰ ኦዳዋ ስሴዳ ካዉተቱ፥ <verse eid="NUM 14:15"/><verse number="16" style="v" sid="NUM 14:16"/>መና ጎዳይ ሀ አሳ፥ ‘ህንተዉ እማና ጊደ ጫቄዳ ቢታ ኡንቱንታ አፋናዉ ዳንዳይቤና ድራዉ፥ መላ ቢታን ኡንቱንታ ዎዳ’ ያጊደ ሃሳያና።<verse eid="NUM 14:16"/></para>
  <para style="p">
    <verse number="17-18" style="v" sid="NUM 14:17-18"/>“ሄዋ ድራዉ፥ ጎዳዉ፥ ኔን ነ ዎልቃ ኑና በሳ፤ ኔን ጋደ፥ ‘መና ጎዳይ ዳንዳያንቻነ አገና ሲቁዋን ኩሜዳዋ፤ ናጋራነ ማካላ አቶ ግያዋ፤ ግዶፐነ፥ ባይዛንቻ ሙረናን አገናዋ፤ አዎቱዋ ናጋራ ድራዉ ናናቱዋ ሄዘንነ ኦይደን የለታ ጋካናዉ ሙርያዋ’ ጋደ ኦዳ ዎዳዋ ፖላ።<note caller="-" style="x"><char style="xo" closed="false">14:17-18 </char><char style="xt" closed="false"><ref loc="EXO 20:5-6">ከሳ 20:5-6</ref>፤ <ref loc="EXO 34:6-7">34:6-7</ref>፤ <ref loc="DEU 5:9-10">ዛረ. 5:9-10</ref>፤ <ref loc="DEU 7:9-10">7:9-10</ref></char></note> <verse eid="NUM 14:17-18"/><verse number="19" style="v" sid="NUM 14:19"/>ሀ አሳይ ግብጼፐ ከሶደፐ ዶማደ ሀች ጋካናዉ ኔን አቶ ጌዳዋዳን፥ ነ አገና ሲቁዋ ዳሩዋን ሀ አሳ ናጋራ አቶ ጋርኪ!” ያጌዳ።<verse eid="NUM 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 14:20"/>መና ጎዳይ ሙሳ፥ “ኔን ኦቼዳዋዳን ታን ኡንቱንቶ አቶ ጋድ። <verse eid="NUM 14:20"/><verse number="21" style="v" sid="NUM 14:21"/>ሽን ታ ደኡዋን ጫቃይ፤ መና ጎዳ ቦንቹ ሳኣ ኡባ ኩምያዋዳን፥<note caller="-" style="x"><char style="xo" closed="false">14:21-23 </char><char style="xt" closed="false"><ref loc="HEB 3:18">እብራ. 3:18</ref></char></note> <verse eid="NUM 14:21"/><verse number="22-23" style="v" sid="NUM 14:22-23"/>ሀ አሳፐ እቱነ ሄ ቢታ በኤና። ታ ቦንቹዋነ ግብጼ ቢታንነ መላ ቢታ ታን ኦዳ ማላታ ሀ አሳቱ በኤድኖ፤ ሽን ኡንቱንቱ ታሙ ገደ ታና ፓጬድኖነ ታ ቃላ ስሰናን እጼድኖ። ሄዋ ድራዉ፥ ታን ኡንቱንቱ ማይዛ አዋቶ እማና ጋደ ጫቄዳ ቢታ ታና ካዳዋንቱፐ እቱነ ሙለካ በኤና። <verse eid="NUM 14:22-23"/><verse number="24" style="v" sid="NUM 14:24"/>ሽን ታ ቆማይ ካሌብ ኡንቱንቱፐ ዱማትያ ድራዉነ እ ታና ፖሎ ዎዛናፐ ካሌዳ ድራዉ፥ ታን እ ካሰ ቤዳ ቢታ አ ጋና፤ አ ዘረይ ሄ ቢታ ላታና።<note caller="-" style="x"><char style="xo" closed="false">14:24 </char><char style="xt" closed="false"><ref loc="JOS 14:9-12">ኢያሳ 14:9-12</ref></char></note> <verse eid="NUM 14:24"/><verse number="25" style="v" sid="NUM 14:25"/>ሽን ሀእ አማሌቃቱነ ካናነቱ ዛንጋራን ደእያ ድራዉ፥ ዎንት ጉየ ስሚደ፥ ዞኦ አባኮ አፍያ ኦግያ ኦይቂደ መላ ቢታ ቢተ” ያጌዳ።<verse eid="NUM 14:25"/></para>
  <para style="s1">ጾሳይ ዙዙሜዳ አሳ ሙሬዳ</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 14:26"/>ቃይ መና ጎዳይ ሙሳነ አሮና ሀዋዳን ያጌዳ፤ <verse eid="NUM 14:26"/><verse number="27" style="v" sid="NUM 14:27"/>“ሀ ኢታ አሳይ ታ ቦላ አዉደ ጋካናዉ ዙዙማኔ? ታን እስራኤልያ አሳ ዙዙን ኡባ ስሳድ። <verse eid="NUM 14:27"/><verse number="28" style="v" sid="NUM 14:28"/>ሄዋ ድራዉ፥ ኔን ኡንቱንቶ ሀዋዳን ያጋደ ኦዳ፤ ‘ታ ደኡዋን ጫቃይ፤ ታን ህንተ ሃሳይሽን ታ ሀይን ስሴዳዋ ህንተንቶ ኦና። ታን መና ጎዳይ ሄዋ ኦዳይ። <verse eid="NUM 14:28"/><verse number="29" style="v" sid="NUM 14:29"/>ህንተ አሃይ ሀ መላ ቢታን ኩንዳና፤ አያዉ ጎፐ፥ አሳ ፓይድያ ዎደ ፓይደቴዳ ላታሙ ላይነ ሄዋፐ ቦላና ደእያ አሳይ ኡባይ ታ ቦላ ዙዙሜድታ።<note caller="-" style="x"><char style="xo" closed="false">14:29 </char><char style="xt" closed="false"><ref loc="HEB 3:17">እብራ. 3:17</ref></char></note> <verse eid="NUM 14:29"/><verse number="30" style="v" sid="NUM 14:30"/>ይፉነ ናኣ ካሌባፐነ ኔዌ ናኣ ኢያሱፐ አትና፥ ህንተፐ ኦንነ ታን ህንተና ዎናዉ ጫቄዳ ሄ ቢታ ገለና። <verse eid="NUM 14:30"/><verse number="31" style="v" sid="NUM 14:31"/>ህንተ፥ “ኑ ናናይ ኦሞደታና” ጌዳ ህንተ ጉ ናናቱዋ ሄ ህንተ ካዳ ቢታ ገልሳና፤ ቢታይካ ኡንቱንቱሳ ግዳናዋ። <verse eid="NUM 14:31"/><verse number="32" style="v" sid="NUM 14:32"/>ሽን ህንተና ግዶፐ፥ ህንተ አሃይ ሀ መላ ቢታን ኩንዳና። <verse eid="NUM 14:32"/><verse number="33" style="v" sid="NUM 14:33"/>ህንተ አማነትቤና ድራዉ፥ ህንተ ዉርሰ አሃይ ሀ መላ ቢታ ዉላና ጋካናዉ፥ ህንተ ናናይ ዋየቲደ፥ ሀ መላ ቢታ ኦይታሙ ላይ ሄንንቻ ግዲደ ዩያና።<note caller="-" style="x"><char style="xo" closed="false">14:33 </char><char style="xt" closed="false"><ref loc="ACT 7:36">ኪታ 7:36</ref></char></note> <verse eid="NUM 14:33"/><verse number="34" style="v" sid="NUM 14:34"/>ህንተ ሄ ቢታ ዎቼዳ ሄ ኦይታሙ ጋላሳ ፓይዱዋን፥ እት ጋላሳዉ እት ላይ፥ ሄዌነ፥ ኦይታሙ ላይዉ ህንተ ናጋራ ድራዉ ህንተ ዋየታና፤ ታን ህንተ ቦላ ደንድያዋ ህንተ ኤራና’ ያጋ ኦዳ። <verse eid="NUM 14:34"/><verse number="35" style="v" sid="NUM 14:35"/>ታን መና ጎዳይ ሀዋ ኦዳይ። ታ ቦላ ሺቅ ኡቴዳ ሀ ኢታ ማባራ ቦላ ሀዋዳን ቱሙ ኦና: ኡንቱንቱ ሀ መላ ቢታን ዉራና፤ ሀዋን ኡንቱንቱ ሀይቃና” ያጌዳ።<verse eid="NUM 14:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 14:36"/>ሄ ቢታ ዎቻና ማላ፥ ሙሴ ኡንቱንታ ኪትና ቢደ ስሜዳ አሳቱ፥ ሄ ቢታ ኢታ ኦዱዋ ኦዲደ፥ ሙሴ ቦላ አሳይ ኡባይ ዙዙማና ማላ ኦዳዋንቱ፥ <verse eid="NUM 14:36"/><verse number="37" style="v" sid="NUM 14:37"/>ሄ ኢታ ኦዱዋ ኦዴዳ አሳቱ፥ መና ጎዳ ስን ቦሻን ሀይቄድኖ። <verse eid="NUM 14:37"/><verse number="38" style="v" sid="NUM 14:38"/>ሄ ቢታ ዎቻናዉ ቤዳ አሳቱዋፐ ይፉነ ናአይ ካሌብነ ኔዌ ናአይ ኢያሱ ጻላላይ ፓጻ አቴድኖ።<verse eid="NUM 14:38"/></para>
  <para style="s1">እስራኤልያ አሳይ ቢታ ቦላ ዎራጃናዉ ኮይሮ ደንዴዳ</para>
  <para style="r">(<ref loc="DEU 1:41-46">ዛረ. 1:41-46</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 14:39"/>ሙሴ ሀዋ እስራኤልያ አሳዉ ኡባዉ ኦዴዳ ዎደ፥ አሳይ ሎይ ዬኬዳ። <verse eid="NUM 14:39"/><verse number="40" style="v" sid="NUM 14:40"/>ዎንተ ጋላስ ዎንታ ጉራን ኡንቱንቱ ደንዲደ፥ ፑደ ገዘ ቢታ ከሲደ፥ “ኑን ናጋራ ኦዶ፤ ሽን ሀእ ጾሳይ ኑዉ እማና ጌዳ ሳኣ ፑደ ከሳና” ያጌድኖ።<verse eid="NUM 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 14:41"/>ሽን ሙሴ ኡንቱንታ፥ “መና ጎዳ አዛዙዋ ህንተ አያዉ መንቴ? ህንተዉ ሀነና። <verse eid="NUM 14:41"/><verse number="42" style="v" sid="NUM 14:42"/>መና ጎዳይ ህንተናና ደኤና ድራዉ፥ ፑደ ከሶፕተ፤ ህንተ ሞርከቱ ህንተና ጾናና። <verse eid="NUM 14:42"/><verse number="43" style="v" sid="NUM 14:43"/>አማሌቃ አሳቱዋናነ ካናነ አሳቱዋና ህንተ ኦለታና፤ ህንተ ማሻን ሀይቃና። መና ጎዳፐ ህንተ ዎራ ስሜዳ ድራዉ፥ መና ጎዳይ ህንተናና ደኤና” ያጌዳ።<verse eid="NUM 14:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 14:44"/>ሽን ኡንቱንቱ መና ጎዳ ጫቁዋ ታቦታይነ ሙሴነ ዱንካኔዳ ሳኣፐ ደንዳና ዮፐካ፥ ገዘ ቢታ ከሳናዉ ጻሊደ ደንዴድኖ። <verse eid="NUM 14:44"/><verse number="45" style="v" sid="NUM 14:45"/>ገዘ ጋድያን ደእያ አማሌቃ አሳቱነ ካናነ አሳቱ ዎደ ኡንቱንቱ ኦላይ ጾኒደ፥ ሆርማ ጋካናዉ ኡንቱንታ የደርሴድኖ።<verse eid="NUM 14:45"/></para>
  <chapter eid="NUM 14"/>
  <chapter number="15" style="c" sid="NUM 15"/>
  <para style="s1">ያርሹዋ ሺሻናዉ እመቴዳ ህግያ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 15:1"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="NUM 15:1"/><verse number="2" style="v" sid="NUM 15:2"/>“እስራኤልያ አሳዉ ሀዋዳን ያጋ፤ ‘ህንተ ደአና ማላ፥ ታን ህንተንቶ እምያ ቢታ ገልያ ዎደ፥ <verse eid="NUM 15:2"/><verse number="3" style="v" sid="NUM 15:3"/>መህያፐ ዎይ ዶርሳፐ፥ ጹግያ ያርሹዋ ግድና፥ ዎይ ሺቆዋ ጋናዉ ያርሽያ ያርሹዋ ግድና፥ ዎይ መና ጎዳይ ኬሬዳ ባላ ጋላሳቱዋን ህንተ ዶሱዋን ጮ እምያ ያርሹዋ ግድና፥ መና ጎዳዉ ታማን ጹግያ፥ ሳዉዋ ቶሹኩ ግያ ያርሾቱዋ ያርሽተ። <verse eid="NUM 15:3"/><verse number="4" style="v" sid="NUM 15:4"/>ያርሹዋ ሺሽያ ኡራይ ካ ያርሾ እት ኪሎ ግራመ ልያ እት ሊትሮ ዎጋራ ዛይትያን ሙናቄዳዋካ መና ጎዳዉ አሆ። <verse eid="NUM 15:4"/><verse number="5" style="v" sid="NUM 15:5"/>ቃይ ጹግያ ያርሾ፥ ዎይ ሀራ ያርሾ አህያ እት እት ዶርሳና እት ሊትሮ ዎይንያ ኤሳ ኡሻ ያርሹዋ ኦደ ጊግስተ።<verse eid="NUM 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 15:6"/>“ ‘ዶርሳ ኦርግያ ያርሻናዉ ሺሽያ ዎደ፥ ካ ያርሾ ላኡ ኪሎ ግራመ ልያ እት ሊትሮነ ባጋ ዎጋራ ዛይትያን ሙናቄዳዋነ <verse eid="NUM 15:6"/><verse number="7" style="v" sid="NUM 15:7"/>እት ሊትሮነ ባጋ ዎይንያ ኤሳ ኡሻ ያርሾ አህተ። መና ጎዳዉ ሳዉዋ ቶሹኩ ግያ ያርሹዋ ያርሽተ።<verse eid="NUM 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 15:8"/>“ ‘እት ኮሩማ ጹግያ ያርሹዋ፥ ዎይ ሺቁዋ ጋያ ያርሹዋ፥ ዎይ እትፐተ ያርሹዋ ኦደ ያርሻናዉ መና ጎዳዉ አህያ ዎደ፥ <verse eid="NUM 15:8"/><verse number="9" style="v" sid="NUM 15:9"/>ኮሩማና እትፐ ካ ያርሾ ሄዙ ኪሎ ግራመ ልያ ላኡ ሊትሮ ዎጋራ ዛይትያን ሙናቄዳዋነ <verse eid="NUM 15:9"/><verse number="10" style="v" sid="NUM 15:10"/>ኡሻ ያርሾ ላኡ ሊትሮ ዎይንያ ኤሳካ አህተ። መና ጎዳዉ ሳዉዋ ቶሹኩ ግያ ያርሹዋ ታማን ያርሽተ።<verse eid="NUM 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 15:11"/>“ ‘እት እት ኮሩማ ቦራ፥ ዎይ እት እት ዶርሳ ኦርግያ፥ ዎይ ያላጋ ዴሻ ኦርግያ፥ ዎይ አቱማ ዶርሳ ማራ ያርሻናዉ ሺሽያ ዎደ፥ ካ ያርሹነ ኡሻ ያርሹ ሀዋዳን እትፐ ሺቄ። <verse eid="NUM 15:11"/><verse number="12" style="v" sid="NUM 15:12"/>እት መህያፐ ዳሩ ሺቅያ ዎደ፥ ካ ያርሹነ ኡሻ ያርሹ ሄዋዳን ዳሪደ ሺቄ። <verse eid="NUM 15:12"/><verse number="13" style="v" sid="NUM 15:13"/>እስራኤልያ አሳ ግድያ ኦንነ ታማን ጹግያ፥ ሳዉዋ ቶሹኩ ግያ ያርሹዋ መና ጎዳዉ ሺሽያ ዎደ ኡባን፥ ሀዋዳን ኦናዉ ኮሼ። <verse eid="NUM 15:13"/><verse number="14" style="v" sid="NUM 15:14"/>ስንፐ ያና የለታን ህንተ ግዶን ደእያ በቲ ዎይ ሀራ አሳይ ኦንነ ጹግያ፥ ሳዉዋ ቶሹኩ ግያ ያርሹዋ መና ጎዳዉ ሺሻናዉ ኮዮፐ፥ እካ ህንተ ኦያዋዳን ኦናዉ ኮሼ። <verse eid="NUM 15:14"/><verse number="15" style="v" sid="NUM 15:15"/>ህንተዉካ ህንተ ግዶን ደእያ በተቶካ ሀ ዎጋይ እቱዋ፤ ሀዌ ስንፐ ያና የለታዉካ ኤቂደ ደእያ ዎጋ። ህንተካ በተቱካ መና ጎዳ ስንን እቱዋ። <verse eid="NUM 15:15"/><verse number="16" style="v" sid="NUM 15:16"/>ህንተዉካ ህንተ ግዶን ደእያ በተ አሳቶካ ህጊነ ዎጋይ እቱዋ ግዳና’ ያጋ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">15:16 </char><char style="xt" closed="false"><ref loc="LEV 24:22">ዎጋ 24:22</ref></char></note><verse eid="NUM 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 15:17"/>ሄዋፐ ጉይያን፥ መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="NUM 15:17"/><verse number="18" style="v" sid="NUM 15:18"/>“እስራኤልያ አሳዉ ሀዋዳን ያጋደ ኦዳ፤ ‘ታን ህንተና አፍያ ቢታ ህንተ ገሊደ፥ <verse eid="NUM 15:18"/><verse number="19" style="v" sid="NUM 15:19"/>ሄ ጋድያን ሞክያ ካ ምያ ዎደ፥ ሄ ካፐ ጼራ ከሲደ፥ ህንተ መና ጎዳዉ ያርሹዋ ኦደ ሺሽተ። <verse eid="NUM 15:19"/><verse number="20" style="v" sid="NUM 15:20"/>ሄዌካ፥ ባይራ ካኤዳ ካፐ ኡኬዳ ኮይሮ ኮምፑዋ፥ ካ ቡክያ ኡዱማፐ እምያ ያርሹዋ ኦደ ሺሽተ። <verse eid="NUM 15:20"/><verse number="21" style="v" sid="NUM 15:21"/>ያና የለታ ኡባን ህንተ ህንተ ጋድያን ሞኬዳ ካፐ ጼራ ከሴዳ ኮምፑዋ፥ መና ጎዳዉ ያርሹዋ ኦደ ሺሽተ።<verse eid="NUM 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 15:22"/>“ ‘መና ጎዳይ ኦዴዳ ሀ አዛዞቱዋ ኡባ ህንተ ኤራና ዪደ፥ ናገናን አጎፐ፥ <verse eid="NUM 15:22"/><verse number="23" style="v" sid="NUM 15:23"/>መና ጎዳይ አ ባጋና ህንተና አዛዜዳ አዛዞቱዋ ኡባ፥ መና ጎዳይ እሜዳ ጋላሳፐ ዶሚደ፥ ያና የለታ ጋካናዉ፥ ፓጨናን ናገናን አጎፐ፥ <verse eid="NUM 15:23"/><verse number="24" style="v" sid="NUM 15:24"/>ቃይ ሄዋ ማባራይ ኤረናን ኦዳዋ ግዶፐ፥ ማባራይ ኡባይ መና ጎዳዉ እት ኮሩማ ጹግያ፥ ሳዉዋ ቶሹኩ ግያ ያርሹዋ ኦደ፥ አዉ ዎጋይ አዛዝያዋዳን፥ ካ ያርሹዋናነ ኡሻ ያርሹዋና ሺሾ፤ ቃይ ናጋራ ያርሹዋ ኦደ፥ እት ዴሻ ኦርግያ ሺሾ። <verse eid="NUM 15:24"/><verse number="25" style="v" sid="NUM 15:25"/>ያቶፐ ቄሲ ኩመን እስራኤልያ ማባራ ናጋራ አቶ ጊስያ ዎጋ ፖሎ፤ ኡንቱንቱ ናጋራይ አቶ ጌተታና። አያዉ ጎፐ፥ ኡንቱንቱ ኤሪደ ኦበይክኖ፤ ቃይ ኡንቱንቱ ባረንቱ ባይዙዋ ድራዉ፥ መና ጎዳዉ ታማን ጹግያ ያርሹዋነ ባረንቱ ናጋራ ያርሹዋ ሺሼድኖ። <verse eid="NUM 15:25"/><verse number="26" style="v" sid="NUM 15:26"/>አሳይ ኡባይ ኤረናን ሄ ባይዙዋን ሀምባላቼቴዳ ድራዉ፥ ኩመን እስራኤልያ ማባራዉካ ኡንቱንቱ ግዶን ደእያ በተ አሳዉካ አቶ ጌተታና።<verse eid="NUM 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 15:27"/>“ ‘እት አሳይ ባረካ ኤራና ዪደ ናጋራ ኦፐ፥ የለቶደፐ እት ላይ ግድያ እት ዴሻቶ ናጋራ ያርሹዋ ኦደ ሺሾ፤<note caller="-" style="x"><char style="xo" closed="false">15:27-28 </char><char style="xt" closed="false"><ref loc="LEV 4:27-31">ዎጋ 4:27-31</ref></char></note> <verse eid="NUM 15:27"/><verse number="28" style="v" sid="NUM 15:28"/>ኤረናን ደኢደ ናጋራ ኦዳ ኡራዉ ቄሲ መና ጎዳ ስንን ናጋራ አቶ ጊስያ ዎጋ ፖሎ፤ አ ናጋራይ አቶ ጌተታና። <verse eid="NUM 15:28"/><verse number="29" style="v" sid="NUM 15:29"/>ኤረናን ደኢደ ናጋራ ኦያ አሳ ኡባዉ፥ የለታን እስራኤልያ አሳ ግድናካ በተ አሳ ግድናካ ሀ ህጊ እቱዋ።<verse eid="NUM 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 15:30"/>“ ‘ሽን የለታን እስራኤልያ አሳ ግድናካ በተ አሳ ግድናካ ኤሪደ ኦቶሩዋን ናጋራ ኦያ ኡራይ መና ጎዳ ቦሬ። ሄ ኡራይ ባረ አሳ ግዶፐ ቦሄቶ። <verse eid="NUM 15:30"/><verse number="31" style="v" sid="NUM 15:31"/>ሄ አዉ መና ጎዳ ቃላ ካዳ ድራዉነ አ አዛዙዋ መንዳ ድራዉ፥ እ ቱሙዋፐ አሳ ግዶፐ ቦሄታናዉ በሰ፤ አ ባይዙ አና’ ያጋ” ያጌዳ።<verse eid="NUM 15:31"/></para>
  <para style="s1">ሳምባታ ዎጋ መንዳ ብታንያ</para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 15:32"/>እት ጋላስ እስራኤልያ አሳይ መላ ቢታ ደእሽን፥ እት ብታኒ ሳምባታን ም ምጺደ ቤቴዳ። <verse eid="NUM 15:32"/><verse number="33" style="v" sid="NUM 15:33"/>ም እ ምጽሽን ደሜዳ አሳቱ ሙሴኮ፥ አሮነኮነ ኩመን ሽቁዋኮ አ አሄድኖ። <verse eid="NUM 15:33"/><verse number="34" style="v" sid="NUM 15:34"/>ኡንቱንቱ አ ኦናዋ ኤርቤና ድራዉ፥ ቃሹዋን ታክሴድኖ። <verse eid="NUM 15:34"/><verse number="35" style="v" sid="NUM 15:35"/>ሄዋፐ ጉይያን መና ጎዳይ ሙሳ፥ “ሀ ብታኒ ሀይቃናዉ በሰ፤ ኩመን ያአይ ባረንቱ ዱንካኔዳ ሳኣፐ ጋጻ ከሲደ፥ ሹቻን ጫዲደ አ ዎ” ያጌዳ። <verse eid="NUM 15:35"/><verse number="36" style="v" sid="NUM 15:36"/>ኩመን ያአይ መና ጎዳይ ሙሳ አዛዜዳዋዳን፥ ዱንካኔዳ ሳኣፐ ጋጻ ከሲደ፥ ሹቻን ጫዲደ አ ዎዳ።<verse eid="NUM 15:36"/></para>
  <para style="s1">ማዩዋ ማጫራ ዎጋ</para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 15:37"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="NUM 15:37"/><verse number="38" style="v" sid="NUM 15:38"/>“እስራኤልያ አሳዉ ሀዋዳን ያጋደ ኦዳ፤ ‘ህንተካ ስንፐ ያና የለታይካ ህንተ ማዩዋ ጋጻ ጼራን ጼራን ማጫራ ከስተ፤ ሄ ማጫራ ቦላ ሳሉዋ ማላትያ ቃጭና ስክተ።<note caller="-" style="x"><char style="xo" closed="false">15:38 </char><char style="xt" closed="false"><ref loc="DEU 22:12">ዛረ. 22:12</ref></char></note> <verse eid="NUM 15:38"/><verse number="39" style="v" sid="NUM 15:39"/>ሄ ማጫራ ህንተ በእያ ዎደ ኡባን መና ጎዳ አዛዞቱዋ ሀሳዪደ ፖልተ፤ ያቶፐ፥ ህንተ ህንተ አይፍያነ ህንተ ዎዛና አሙዋ ካሊደ፥ ታፐ ዎራ ስምክታ። <verse eid="NUM 15:39"/><verse number="40" style="v" sid="NUM 15:40"/>ሄ ማጫራ በእያዋን ህንተ ታ አዛዞቱዋ ኡባ ሀሳዪደ ፖላናነ ህንተ ህንተ ጾሳዉ ጌሻ ግዳና። <verse eid="NUM 15:40"/><verse number="41" style="v" sid="NUM 15:41"/>ታን መና ጎዳ፥ ህንተ ጾሳቴ፤ ታን ህንተ ጾሳ ግዳናዉ፥ ህንተና ግብጼፐ ከሳድ። ታን መና ጎዳ፥ ህንተ ጾሳ’ ያጋ” ያጌዳ።<verse eid="NUM 15:41"/></para>
  <chapter eid="NUM 15"/>
  <chapter number="16" style="c" sid="NUM 16"/>
  <para style="s1">ቆራህ፥ ዳታንነ አቢራም ሙሴ ቦላ ደንዴድኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 16:1"/>ሌዊያ ዛርያፐ ቃሃታ ያራ ግድያ ይጽሃራ ናአይ ቆራህ፥ ሮቤላ ዛርያፐ ኤልኣባ ናናይ ዳታንነ አቢራምነ ቃይ ፐሌታ ናአይ ኦንስ፥<note caller="-" style="x"><char style="xo" closed="false">16:1 </char><char style="xt" closed="false"><ref loc="JUD 1:11">ይሁዳ 11</ref></char></note> <verse eid="NUM 16:1"/><verse number="2" style="v" sid="NUM 16:2"/>ሙሴ ቦላ ደንዴድኖ። ኡንቱንቱና ላኡ ጼታነ እሻታሙ እስራኤልያ አሳቱ ደኢኖ፤ ኡንቱንቱ ኤረቴዳ አሳነ ማባራን ዶረቴዳ ካለያዋንታ። <verse eid="NUM 16:2"/><verse number="3" style="v" sid="NUM 16:3"/>ኡንቱንቱ ሙሴነ አሮና ስን ሺቂደ፥ ሀዋዳን ያጌድኖ፤ “ህንተ ዳርሴድታ! ማባራይ ኡባይ ሁጲያን ሁጲያን ጌሻ፤ መና ጎዳይካ ኡንቱንቱ ግዱዋን ደኤ፤ ያትና መና ጎዳ ማባራ ቦላ ህንተና አያዉ ቁ ቁ ኦቴ?” ያጌድኖ።<verse eid="NUM 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 16:4"/>ሙሴ ሀዋ ስሴዳ ዎደ ጾሳ ስንን ሳኣን ጉፋኔዳ፤ <verse eid="NUM 16:4"/><verse number="5" style="v" sid="NUM 16:5"/>ቆራሀነ አ ጭታ ኡባ፥ “ዎንት ዎንታ መና ጎዳይ ኦን ናጋራንቼንቶነ ኦን ጌሸንቶ በሳና፤ እ ሄ ዶርያ አሳ ባረኮ ሺሻና። <verse eid="NUM 16:5"/><verse number="6" style="v" sid="NUM 16:6"/>ቆራሀ፥ ኔንነ ነ ጭታይ ኡባይ ሀዋ ኦተ: ዎንት እጻና ጩዋይያዋንታ አኪደ፥ <verse eid="NUM 16:6"/><verse number="7" style="v" sid="NUM 16:7"/>ቦንቁዋ አን ዎደ፥ መና ጎዳ ስንን እጻና ጩዋይተ። መና ጎዳይ ዶርያ አሳይ፥ እ ጌሻ ግዳናዋ። ሌዊያ ዛረቶ፥ ህንተ ዳርሴድታ” ያጌዳ።<verse eid="NUM 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 16:8"/>ሙሴ ቃይካ ቆራሀ፥ “ህንተኖ ሌዊያ ዛረቶ፥ ስስተ! <verse eid="NUM 16:8"/><verse number="9" style="v" sid="NUM 16:9"/>እስራኤልያ መና ጎዳይ ህንተና እስራኤልያ ማባራፐ ዱማዪደ፥ መና ጎዳ ዱንካንያ ኦሱዋ ኦና ማላነ አሳ ስንን ሄ ኦሱዋ ኦናዉ ህንተ ኤቃና ማላ፥ ባረኮ ሺሼዳዌ ህንተንቶ ጉጼዴ? <verse eid="NUM 16:9"/><verse number="10" style="v" sid="NUM 16:10"/>እ ህንተናነ ህንተ እሻቱዋ ሌዋቱዋ ኡባ ባረኮ ሺሼዳ፤ ቃይ ሀእ ህንተ ቄሰተካ ካጄሊታ። <verse eid="NUM 16:10"/><verse number="11" style="v" sid="NUM 16:11"/>ኔንነ ነ ጭታይ ኡባይ አሮና ቦላ ዙዙምያዌ፥ እ ኦኔ? ህንተንቱ መና ጎዳ ቦላ ማካሊታ” ያጌዳ።<verse eid="NUM 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 16:12"/>ሄዋፐ ጉይያን፥ ሙሴ ኪቲደ ኤልኣባ ናናቱዋ፥ ዳታናነ አቢራማ ጼስሴዳ፤ ሽን ኡንቱንቱ አ፥ “ኑን ቦኮ! <verse eid="NUM 16:12"/><verse number="13" style="v" sid="NUM 16:13"/>ኔን መላ ቢታን ኑና ዎናዉ ማይነ ኤሳይ ጎግያ ጋድያፐ ከሴዳዌ ጉጼዴ? ቃይ ሀእ ኔን ኑ ቦላ ካፑዋ ግዳናዉ ኮያይ? <verse eid="NUM 16:13"/><verse number="14" style="v" sid="NUM 16:14"/>ሄዋ ቦላካ ቃይ ማይነ ኤሳይ ጎግያ ቢታ ኔን ኑና ገልሳባካ፥ ዎይ ኔን ኑዉ ላታ ኦደ ጋድያነ ዎይንያ ቱራ እማባካ፤ ኔን ሀ አሳ ጭማሳ። ኑን ቦኮ!” ያጌድኖ።<verse eid="NUM 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 16:15"/>ሙሴ ሎይ ሀንቀቲደ መና ጎዳ፥ “ኡንቱንቱ ያርሽያ ያርሹዋ አኮፓ፤ ታን ኡንቱንቱፐ ሀርያ እቱዋነ አካበይከ፥ ዎይ ታን ኡንቱንቱፐ እት አሳነ ናቃበይከ” ያጌዳ።<verse eid="NUM 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 16:16"/>ቃይ ሙሴ ቆራሀ፥ “ዎንት ኔን፥ ነ ጭታይ ኡባይነ አሮን መና ጎዳ ስንን ግድተ። <verse eid="NUM 16:16"/><verse number="17" style="v" sid="NUM 16:17"/>እት እት አሳይ ባረ እጻና ጩዋይያዋ ኡባና ላኡ ጼታነ እሻታሙዋ አኪደ፥ እጻና አን ዎደ፥ መና ጎዳ ስን ሽሾ። ቃይ ኔንነ አሮን ህንተ እጻና ጩዋይያዋንታ አህተ” ያጌዳ። <verse eid="NUM 16:17"/><verse number="18" style="v" sid="NUM 16:18"/>አሳይ ኡባይካ ባረ እጻና ጩዋይያዋ አኪደ፥ ቦንቁዋነ እጻና አን ዎዳ፤ ጋከትያ ዱንካንያ ፐንግያን ሙሴናነ አሮናና ኤቄድኖ። <verse eid="NUM 16:18"/><verse number="19" style="v" sid="NUM 16:19"/>ቆራህ ኩመን ማባራ ጋከትያ ዱንካንያ ፐንግያን ሺሼዳ።</para>
  <para style="p" vid="NUM 16:19">ሄ ዎደ መና ጎዳ ቦንቹ ኩመን ማባራዉ ቆንጬዳ። <verse eid="NUM 16:19"/><verse number="20" style="v" sid="NUM 16:20"/>መና ጎዳይ ሙሳነ አሮና፥ <verse eid="NUM 16:20"/><verse number="21" style="v" sid="NUM 16:21"/>“ታን እት ኩን ሀ ማባራ ይሳና ሀንያ ድራዉ፥ ኡንቱንቱፐ ሻከትተ” ያጌዳ።<verse eid="NUM 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 16:22"/>ሽን ሙሴነ አሮን ሳኣን ጉፋኒደ፥ “አቤት ጾሳዉ፥ አሹዋ ማዬዳ አሳ ኡባ መዳ ጾሳዉ፥ እት ኡራይ ናጋራ ኦፐ፥ ኔን ኩመን ማባራ ሀንቀታይ?” ያጌድኖ።<verse eid="NUM 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 16:23"/>ያትና መና ጎዳይ ሙሳ፥ <verse eid="NUM 16:23"/><verse number="24" style="v" sid="NUM 16:24"/>“ኔን ማባራ፥ ‘ቆራሀ፥ ዳታናነ አቢራማ ዱንካነቱዋፐ ክችተ’ ያጋደ ኦዳ” ያጌዳ።<verse eid="NUM 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 16:25"/>ሙሴ ደንዲደ፥ ዳታነኮነ አቢራመኮ ቢና፥ እስራኤልያ ጭማቱ አ ካሌድኖ። <verse eid="NUM 16:25"/><verse number="26" style="v" sid="NUM 16:26"/>ማባራ እ፥ “ሀ ኢታ አሳቱ ዱንካነቱዋፐ ክችተ፤ ኡንቱንቱዋ ግዴዳዋ አያነ ቦቾፕተ። ሄንኮደ ኡንቱንቱ ናጋራ ኡባ ጋሱዋን ህንተካ ፕተት ያና” ያጊደ ምንሲደ ኦዴዳ።<verse eid="NUM 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 16:27"/>ኡንቱንቱ ቆራሀ፥ ዳታናነ አቢራማ ዱንካነቱዋፐ ክቼድኖ። ዳታንነ አቢራም ካረ ከሲደ፥ ባረንቱ ማቼቱዋና፥ ባረንቱ ናናቱዋና ባረንቱ ጉ ናናቱዋና ባረንቱ ዱንካነቱዋ ፐንግያን ኤቄድኖ። <verse eid="NUM 16:27"/><verse number="28" style="v" sid="NUM 16:28"/>ሙሴ አሳ፥ “ታን ሀ ኦሶ ኡባ ኦና ማላ፥ መና ጎዳይ ታና ኪቴዳዋነ ታን ታ ሸንያን ኦናዋ ህንተ ሀዋን ኤራና። <verse eid="NUM 16:28"/><verse number="29" style="v" sid="NUM 16:29"/>ሀ አሳቱ አሳይ ሀይቂያዋዳን ሀይቆፐ፥ ዎይ አሳ ቦላ ጋክያዋ ጻላላይ ኡንቱንቱ ቦላ ጋኮፐ፥ መና ጎዳይ ታና ኪትቤና። <verse eid="NUM 16:29"/><verse number="30" style="v" sid="NUM 16:30"/>ሽን መና ጎዳይ ኡባና ኦራባ ኦና፥ ቢታይ ዶየቲደ ኡንቱንታነ ኡንቱንቶ ደእያዋ ኡባ ምት አጎፐ፥ ኡንቱንቱ ፓጻ ደኢደ ስኦልያ ዱገ ዎፐ፥ ሄ ዎደ ሀ አሳቱ መና ጎዳ ካዳዋ ህንተ ኤራና” ያጌዳ።<verse eid="NUM 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 16:31"/>እ ያጊደ ዉርሴዳ ዎደ፥ ኡንቱንቱ ኤቄዳ ቢታይ ጳልቀት ዎዳ። <verse eid="NUM 16:31"/><verse number="32" style="v" sid="NUM 16:32"/>ቢታይ ዶየቲደ፥ ኡንቱንታነ ኡንቱንቱ ሶ አሳ፥ ቆራሀ ጭታ ኡባ ኡንቱንቶ ደእያዋ ኡባና ምት አጌዳ። <verse eid="NUM 16:32"/><verse number="33" style="v" sid="NUM 16:33"/>ያትና ኡንቱንቱ ባረዉ ደእያዋ ኡባና ፓጻ ደኢደ፥ ስኦልያ ዱገ ዎድኖ። ቢታይካ ኡንቱንቱ ቦላ ጎርደት አጌዳ፤ ኡንቱንቱ ማባራ ግዶፐ ትፕ ጊደ ይ አጌድኖ። <verse eid="NUM 16:33"/><verse number="34" style="v" sid="NUM 16:34"/>ኡንቱንቱ ዋሱዋን ኡንቱንቱ ማታን ደእያ እስራኤላቱ ኡባይ፥ “ቢታይ ኑናካ ቃይ ምታና ሀኔ!” ያጊድ ባቃቴድኖ።<verse eid="NUM 16:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 16:35"/>ቃይ ታማይካ መና ጎዳ ማታፐ ዪደ፥ እጻና ጩዋይያ ላኡ ጼታነ እሻታሙ አሳ ም አጌዳ።<verse eid="NUM 16:35"/></para>
  <para style="s1">እጻና ጩዋይያባቱዋ</para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 16:36"/>ሄዋፐ ጉይያን መና ጎዳይ ሙሳ፥ <verse eid="NUM 16:36"/><verse number="37" style="v" sid="NUM 16:37"/>“ኔን ቄስያ አሮና ናኣ ኤልኣዛራዉ ያጋደ ኦዳ፥ ‘እጻና ጩዋይያባቱዋ ታማን ጹገቴዳ አሳ ግዶፐ አካ፤ ቦንቁዋ ጩዋይያባቱዋፐ ሃሳደ ላላ። ሄ እጻና ጩዋይያባቱ ጌሻ። <verse eid="NUM 16:37"/><verse number="38" style="v" sid="NUM 16:38"/>ባረ ናጋራ ድራዉ ሀይቄዳ ሀ አሳቱ እጻና ጩዋይያባቱዋ ሌእሳደ ቆጻደ፥ ያርሹዋ ሳጽንያ ካማ። ኡንቱንቱ ሄዋንታ መና ጎዳ ስንን ሺሼዳ ድራዉ፥ ሄዋንቱ ጌሻ፤ ሄዋንቱ እስራኤላቱዋ ሀሳይስያ ማላታ ግዳና’ ያጋ” ያጌዳ።<verse eid="NUM 16:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 16:39"/>ቄሲ ኤልኣዛር ጹገቴዳ አሳቱ ሺሼዳ ናሃሰ ብራታፐ ኦሰቴዳ እጻና ጩዋይያባቱዋ አኪደ፥ ያርሹዋ ሳጽንያ ካማናዉ ሌእሲደ ቆጼዳ። <verse eid="NUM 16:39"/><verse number="40" style="v" sid="NUM 16:40"/>አሮና ዛረ ግደና ኦንነ መና ጎዳ ስንን እጻና ጩዋያናዉ ሺቀና ማላ፥ ቆራሀነ አ ጭታ ጋኬዳዌ አ ጋከና ማላ፥ እስራኤላቱዋ ሀሳይሳናዉ ሀዋንታ ኦዳ። መና ጎዳይ ሙሴ ባጋና ኤልኣዛራ አዛዜዳዋዳን ሀዌ ሀኔዳ።<verse eid="NUM 16:40"/></para>
  <para style="s1">አሮን አሳ ቦሻፐ አሼዳ</para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 16:41"/>ዎንተ ጋላስ እስራኤልያ ማባራይ ኡባይ፥ “መና ጎዳ አሳ ህንተ ዎድታ” ያጊደ፥ ሙሴ ቦላነ አሮና ቦላ ዙዙሜድኖ። <verse eid="NUM 16:41"/><verse number="42" style="v" sid="NUM 16:42"/>ማባራይ ሙሴነ አሮና ቦላ ደንዳናዉ ሺቂደ፥ ጋከትያ ዱንካንያኮ ስም ጼልያ ዎደ፥ ሻሪ ጋከትያ ዱንካንያ ካምና፥ መና ጎዳ ቦንቹ ቆንጬዳ።<verse eid="NUM 16:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="NUM 16:43"/>ሄዋፐ ጉይያን፥ ሙሴነ አሮን ጋከትያ ዱንካንያ ስንዉ ዬድኖ። <verse eid="NUM 16:43"/><verse number="44" style="v" sid="NUM 16:44"/>መና ጎዳይ ሙሳ፥ <verse eid="NUM 16:44"/><verse number="45" style="v" sid="NUM 16:45"/>“ሀ አሳ ግዱዋፐ ክችተ፤ ታን ኡንቱንታ እት ኩን ይሳ ባሻና” ያጌዳ።</para>
  <para style="p" vid="NUM 16:45">ኡንቱንቱ ሳኣን ጉፋኔድኖ። <verse eid="NUM 16:45"/><verse number="46" style="v" sid="NUM 16:46"/>ሙሴ አሮና፥ “ነ እጻና ጩዋይያዋ አካደ፥ ቦንቁዋ ያርሽያ ሳኣፐ አካደ፥ እጻና አን ዎ፤ ኡንቱንቶ አቶ ጊሳናዉ ኤለካ ማባራኮ አፋ። አያዉ ጎፐ፥ መና ጎዳ ሀንቁ አ ማታፐ ከስ ክቼዳ፤ ቦሻይካ ዶም ክቼዳ” ያጌዳ። <verse eid="NUM 16:46"/><verse number="47" style="v" sid="NUM 16:47"/>ሙሴ ጌዳዋዳን አሮን ባረ እጻና ጩዋይያዋ አኪደ፥ ማባራ ግዶ ዎጼዳ። ቦሻይ አሳ ግዱዋን ዶም ደእሽን፥ አሮን እጻና ጩዋዪደ፥ አሳዉ አቶ ጊሴዳ። <verse eid="NUM 16:47"/><verse number="48" style="v" sid="NUM 16:48"/>ያቲደ እ ሀይቄዳዋንቱፐነ ፓጻ ደእያዋንቱፐ ግዱዋን ኤቂና፥ ቦሻይ አግ አጌዳ። <verse eid="NUM 16:48"/><verse number="49" style="v" sid="NUM 16:49"/>ቆራሀ ጋሱዋን ሀይቄዳ አሳይ ፓይደተናን፥ ሀ ቦሻን ሀይቄዳዋንቱ 14,700. <verse eid="NUM 16:49"/><verse number="50" style="v" sid="NUM 16:50"/>ቦሻይ ኤቄዳዋፐ ጉይያን፥ አሮን ጋከትያ ዱንካንያ ፐንግያን ደእያ ሙሴኮ ስሜዳ።<verse eid="NUM 16:50"/></para>
  <chapter eid="NUM 16"/>
  <chapter number="17" style="c" sid="NUM 17"/>
  <para style="s1">አሮና ጻምኣ አጫቱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 17:1"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="NUM 17:1"/><verse number="2" style="v" sid="NUM 17:2"/>“ኔን፥ ‘ህንተ ዛርያን ዛርያን ህንተ ካፓቱዋፐ ሁጲያን ሁጲያን እት እት ጻምኣ ኡባና ታማነ ላኡ ጻምኣ ታዉ እምተ’ ያጋደ እስራኤላቱዋፐ አካ። እት እት አሳ ሱን ጻምኣ ቦላን ጻፋ። <verse eid="NUM 17:2"/><verse number="3" style="v" sid="NUM 17:3"/>እት እት ዛርያ ካፖ እት ጻምኣ ግድያ ድራዉ፥ ሌዊያ ጻምአን አሮና ሱን ጻፋ። <verse eid="NUM 17:3"/><verse number="4" style="v" sid="NUM 17:4"/>ጋከትያ ዱንካንያ ግዶን ታን ኔናና ጋከትያ ማርካተ ታቦታ ስንን ዎ። <verse eid="NUM 17:4"/><verse number="5" style="v" sid="NUM 17:5"/>ታን ዶርያ አሳ ጻምአይ አጫና፤ ሀዋዳን ኦደ ህንተ ቦላን እስራኤላቱ ዙዙምያ ዙዙን ታን ሙለ ይሳና” ያጌዳ።<verse eid="NUM 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 17:6"/>ሙሴ እስራኤልያ አሳዉ ኦድና፥ ኡንቱንቱ ካፓቱ ታማነ ላኡ ጻምአቱዋ፥ እት እት ዛርያ ካፓቱ እት እት ጻምኣ አዉ እሜድኖ። ሄ ጻምአቱዋ ግዱዋን አሮና ጻምአይካ ደኤ። <verse eid="NUM 17:6"/><verse number="7" style="v" sid="NUM 17:7"/>ሙሴ ሄ ጻምኣ ኡባ ማርካተ ዱንካንያ ግዶን መና ጎዳ ስንን ዎዳ።<verse eid="NUM 17:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 17:8"/>ዎንተ ጋላስ ማርካተ ዱንካንያ ግዶ ሙሴ ገሌዳ ዎደ፥ ሌዊያ ዛረ ግድያ አሮና ጻምአይ አጬዳዋ፥ ጉምቤዳዋ፥ ጪሼዳዋነ ጪሺደ ላዉዝያ ግያ ም አይፍያ አይፌዳዋ በኤዳ።<note caller="-" style="x"><char style="xo" closed="false">17:8-10 </char><char style="xt" closed="false"><ref loc="HEB 9:4">እብራ. 9:4</ref></char></note> <verse eid="NUM 17:8"/><verse number="9" style="v" sid="NUM 17:9"/>ሄዋፐ ጉይያን፥ ሙሴ ጻምኣ ኡባ መና ጎዳ ስንፐ እስራኤልያ አሳ ኡባኮ አሄዳ። አሳይ ኡንቱንታ በኤዳዋፐ ጉይያን፥ ካፓቱ ባረንቱ ጻምኣ ጻምኣ አኬድኖ። <verse eid="NUM 17:9"/><verse number="10" style="v" sid="NUM 17:10"/>መና ጎዳይ ሙሳ፥ “አሮና ጻምኣ ታቦታ ስንን ዛራ ዎ። ሄዋ ማካሌዳዋንቱ ታ ቦላ ላኤን ዙዙሚደ ሀይቀናዳን፥ ኡንቱንቶ ማላታ ኦደ ናጋ” ያጌዳ። <verse eid="NUM 17:10"/><verse number="11" style="v" sid="NUM 17:11"/>መና ጎዳይ አዛዜዳዋዳን ሙሴ ኦዳ።<verse eid="NUM 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 17:12"/>እስራኤልያ አሳይ ሙሳ፥ “ኑን ሀይቃና፤ ያና፤ ኑን ኡባይካ ያና! <verse eid="NUM 17:12"/><verse number="13" style="v" sid="NUM 17:13"/>መና ጎዳ ዱንካንያኮ፥ ሀራይ አቶ ማታ ሺቅያ ኡራይ ኦንነ ሀይቃና። ስም ኑን ኡባይካ ሀይቄቶ?” ያጌድኖ።<verse eid="NUM 17:13"/></para>
  <chapter eid="NUM 17"/>
  <chapter number="18" style="c" sid="NUM 18"/>
  <para style="s1">ቄሳቱዋነ ሌዋቱዋ ኦሱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 18:1"/>መና ጎዳይ አሮና፥ “ኔን፥ ነ አቱማ ናናቱነ ሌዋቱ ጌሻ ሳኣ ኦሱዋን ፖለትያ ናጋራ ቶካና፤ ኔንነ ነ አቱማ ናናቱ ጻላላይ ህንተ ቄሰተ ኦሱዋን ፖለትያ ናጋራ ቶካና። <verse eid="NUM 18:1"/><verse number="2" style="v" sid="NUM 18:2"/>ኔንነ ነ አቱማ ናናይ ማርካተ ዱንካንያ ስንን ኦያ ዎደ፥ ኔናና ግዲደ ማዳና ማላ፥ ሌዊያ ዛረ ግድያ ነ ዳቦቱዋ አሀ። <verse eid="NUM 18:2"/><verse number="3" style="v" sid="NUM 18:3"/>ኡንቱንቱ ህንተፐ ጋርሳና ዱንካንያ ኦሶ ኡባ ኦኖ፤ ሽን ኡንቱንቱካ ህንተካ እትፐ ሀይቀናዳን፥ ኡንቱንቱ ጌሻ ሳኣ ሚሻኮነ ያርሽያ ሳኮ ሺቆፕኖ። <verse eid="NUM 18:3"/><verse number="4" style="v" sid="NUM 18:4"/>ኡንቱንቱ ህንተናና እትፐ ግድኖ፤ ጋከትያ ዱንካንያን ደእያ ኦሶ ኡባ ኦኖ። ሌዋቱዋፐ አትና፥ ሀራ ኡራይ ኦንነ ህንተኮ ሺቆፖ። <verse eid="NUM 18:4"/><verse number="5" style="v" sid="NUM 18:5"/>ላኤንዋ እስራኤላቱዋ ቦላ ሀንቁ ዎና ማላ፥ ጌሻ ሳኣነ ያርሽያ ሳኣ ኦሱዋ ኦተ። <verse eid="NUM 18:5"/><verse number="6" style="v" sid="NUM 18:6"/>ሌዋቱዋ ህንተ ዳቦቱዋ እስራኤላቱዋ ግዶፐ ታን ታ ሁጲያዉ ዶራድ። ኡንቱንቱ ጋከትያ ዱንካንያ ኦሱዋ ኦናዉ ህንተንቶ እሙዋዳን እማደ፥ መና ጎዳዉ ዱማያድ። <verse eid="NUM 18:6"/><verse number="7" style="v" sid="NUM 18:7"/>ሽን ኔንነ ነ አቱማ ናናቱ ጻላላይ ያርሽያ ሳኣ ኦሱዋ ኡባነ ጋርዱዋ ግዶን ደእያ ቄሰተ ኦሶ ኡባ ኦተ። ቄሰተ ኦሱዋ ታን ህንተንቶ እሙዋዳን ኦደ እማይ፤ ሀራ ኡራይ ኦንነ ጌሻ ሳኣኮ ሺቅያዌ ሀይቆ” ያጌዳ።<verse eid="NUM 18:7"/></para>
  <para style="s1">ቄሳቱዋ ግሹዋ</para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 18:8"/>ሄዋፐ ጉይያን መና ጎዳይ አሮና፥ “እስራኤላቱ ታዉ እምያ ጌሻ እሞታ ኡባ ታን ነዉ እማድ። ታን ነዉ ነ ድራውነ ነ አቱማ ናናዉ ኡንቱንቱ ድራዉ መናዉ ግሻ ኦደ እማድ። <verse eid="NUM 18:8"/><verse number="9" style="v" sid="NUM 18:9"/>ታዉ እምያ አዳ ጌሻ እሙዋፐ ታማን ጹገተና ባጋይ ህንተሳ ግዳናዋ: ኡንቱንቱ ታዉ እምያ ጌሻ እሙዋ ኡባፐ ካ ያርሹ፥ ዎይ ናጋራ ድራዉ ያርሽያ ያርሹ፥ ዎይ ናቁዋ ድራዉ ያርሽያ ያርሹ ኔሳነ ነ አቱማ ናናቱዋሳ ግዳናዋ። <verse eid="NUM 18:9"/><verse number="10" style="v" sid="NUM 18:10"/>ህንተ ሄዋ ጌሻ ሳኣን ሚተ፤ አቱማዌ ኡባይ ሄዋ ሞ፤ ሄዌ ህንተዉ ጌሻ ግዳናዋ።<verse eid="NUM 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 18:11"/>“ሀዌ ቃይ ኔሳ። እስራኤላቱዋ ቃ ያርሹዋ ኡባ ነዉ፥ ነ አቱማ ናናቶነ ነ ማጫ ናናዉ መናዉ ግሻ ኦደ እማይ፤ ህንተ ጎልያ አሳ ግዶን ዎጋዳን ጌሻ ግድያ ኡባይ ሄዋ ሞ።<verse eid="NUM 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 18:12"/>“ኡንቱንቱ ታዉ እምያ ኮይሮ አይፍያፐ ሎኦ ዎጋራ ዛይትያ ኡባ፥ ያላጋ ዎይንያ ኤሳ ኡባነ ሙሩታ ካ ኡባ መና ጎዳዉ እማይ። <verse eid="NUM 18:12"/><verse number="13" style="v" sid="NUM 18:13"/>ኡንቱንቱ መና ጎዳዉ አህያ ኡንቱንቱ ጋድያን ደእያ ኮይሮ ጋኬዳ አይፊ ህንተሳ፤ ህንተ ጎልያ አሳ ግዶን ዎጋዳን ጌሻ ግድያ ኡባይ ሄዋ ሞ።<verse eid="NUM 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 18:14"/>“እስራኤልያን መና ጎዳዉ ዱማቴዳባይ ኡባይ ህንተሳ።<note caller="-" style="x"><char style="xo" closed="false">18:14 </char><char style="xt" closed="false"><ref loc="LEV 27:28">ዎጋ 27:28</ref></char></note> <verse eid="NUM 18:14"/><verse number="15" style="v" sid="NUM 18:15"/>ባይራ የለቴዳ አሳይ ዎይ መሂ፥ እስራኤላቱ መና ጎዳዉ እሜዳዌ ህንተሳ። ሽን ባይራ የለቴዳ አሳነ ባይራ የለቴዳ ጌሻ ግደና መህያ ህንተ ዎዛናዉ በሰ። <verse eid="NUM 18:15"/><verse number="16" style="v" sid="NUM 18:16"/>እት አግና ናናቱዋ ዎዛናዉ ዱንካንያን ኤርቲያ ሚዛንያ (20 ጌራ) ልክያን እቼሹ ጻጋራ ብራ ዎዞ ጋትያ ቃንጽተ። <verse eid="NUM 18:16"/><verse number="17" style="v" sid="NUM 18:17"/>ሽን ሚዛ ባይራ፥ ዎይ ዶርሳ ባይራ፥ ዎይ ዴሻ ባይራ ህንተ ዎዛናዉ ኮሸና፤ ኡንቱንቱ ጌሻ። ኔን ኡንቱንቱ ሱ ያርሽያ ሳኣ ቦላን ጫጫፋ፤ መና ጎዳ ቶሹኩ ጊደ ሳዋና ማላ፥ ኡንቱንቱ ሞዋ ታማን ጹጋ። <verse eid="NUM 18:17"/><verse number="18" style="v" sid="NUM 18:18"/>ኡንቱንቱፐ ቤትያ አሹ ዉጻኬዳ አንጎሱዋዳንነ ኡሸቻ ገድያዳን ህንተሳ። <verse eid="NUM 18:18"/><verse number="19" style="v" sid="NUM 18:19"/>እስራኤላቱ መና ጎዳዉ እምያ ጌሻ ያርሹዋ ኡባ ነዉ፥ ነ አቱማ ናናቶነ ነ ማጫ ናናቶ መናዉ ግሻ ኦደ እማይ። ሀዌካ መና ጎዳይ ኔናናነ ነ ዘረቱዋና ጫቀትያ ማጽንያ ጫቁዋ” ያጌዳ።<verse eid="NUM 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 18:20"/>ቃይካ መና ጎዳይ አሮና፥ “ኡንቱንቱ ጋድያን ኔን አይነ ላታካ፤ ኡንቱንቱ ግዶን ኔና ጋክያ ሻኩ አያይካ ባዋ፤ እስራኤላቱዋ ግዶን ነ ላታይነ ኔና ጋክያ ሻኩ ታና” ያጌዳ።<verse eid="NUM 18:20"/></para>
  <para style="s1">ሌዋቱዋ ጋክያ ግሹዋ</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 18:21"/>ጾሳይ፥ “ሌዋቱ ጋከትያ ዱንካንያን ኦያ ኦሱዋ ድራዉ፥ እስራኤላቱዋ አስራታ ኡባ ኡንቱንቶ እማድ።<note caller="-" style="x"><char style="xo" closed="false">18:21 </char><char style="xt" closed="false"><ref loc="LEV 27:30-33">ዎጋ 27:30-33</ref>፤ <ref loc="DEU 14:22-29">ዛረ. 14:22-29</ref></char></note> <verse eid="NUM 18:21"/><verse number="22" style="v" sid="NUM 18:22"/>ሀቼፐ ዶሚደ፥ እስራኤልያ አሳቱ ባረንቱ ናጋራን ሀይቀና ማላ፥ ጋከትያ ዱንካንያኮ ሺቆፕኖ። <verse eid="NUM 18:22"/><verse number="23" style="v" sid="NUM 18:23"/>ጋከትያ ዱንካንያ ኦሱዋ ኦያዋንቱነ ሄዋን ፖለትያ ናጋራ ቶክያዋንቱ ሌዋቱዋ። ሀዌ የለታ ኡባዉ መና ዎጋ። ሌዋቱ እስራኤልያ አሳ ግዱዋን አይነ ላትክኖ። <verse eid="NUM 18:23"/><verse number="24" style="v" sid="NUM 18:24"/>ሄዋ ድራዉ፥ እስራኤላቱ መና ጎዳዉ እሙዋዳን እምያ አስራታ፥ ታን ሌዋቶ ኡንቱንታ ላታዳን እማድ። ታን ኡንቱንቱባ፥ ‘ኡንቱንቱ እስራኤልያ አሳ ግዱዋን አይነ ላትክኖ’ ያጌዳዌ ሄዋሳ” ያጌዳ።<verse eid="NUM 18:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 18:25"/>ቃይ መና ጎዳይ ሙሳ፥ <verse eid="NUM 18:25"/><verse number="26" style="v" sid="NUM 18:26"/>“ኔን ሌዋቱዋ ሀዋዳን ያጋ፤ ‘ታን ህንተንቶ ላታዳን እሜዳ አስራታ ህንተ እስራኤልያ አሳፐ አክያ ዎደ፥ ህንተ ሄ አስራታፐ አስራታ መና ጎዳዉ እምተ። <verse eid="NUM 18:26"/><verse number="27" style="v" sid="NUM 18:27"/>ህንተ እሙ ህንተንቶ ካ ቡክያ ኡዱማ ካዳንነ ጉምእያ ዎይንያ አይፍያዳን ፓይደቴ። <verse eid="NUM 18:27"/><verse number="28" style="v" sid="NUM 18:28"/>ቃይ ሀዋዳን እስራኤልያ አሳፐ ህንተ አክያ አስራታ ኡባፐ እሙዋ መና ጎዳዉ እምተ፤ ሀ አስራታፐ መና ጎዳ ድራዉ ቄስያ አሮናዉ ህንተ እማናዉ በሰ። <verse eid="NUM 18:28"/><verse number="29" style="v" sid="NUM 18:29"/>ህንተ አክያ እሞታ ኡባፐ፥ ሎእያዋነ ጌሻ መና ጎዳዉ ግሹዋ ኦደ፥ ህንተ እማናዉ በሴ’ ያጋ።<verse eid="NUM 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 18:30"/>“ቃይ ኔን ሌዋቱዋ፥ ‘ኡባፐ ሎኦ እሙዋ ህንተ እሜዳዋፐ ጉይያን፥ አቴዳዌ ህንተንቶ ካ ቡክያ ኡዱማ ካዳንነ ጉምእያ ዎይንያ አይፍያዳን ፓይደታና። <verse eid="NUM 18:30"/><verse number="31" style="v" sid="NUM 18:31"/>ህንተነ ህንተ ጎልያ አሳይ ሄዋፐ አቴዳዋ ሀቃንነ ሚተ፤ አያዉ ጎፐ፥ ሄዌ ጋከትያ ዱንካንያን ህንተ ኦያ ኦሶ ህንተ ድርጉዋ። <verse eid="NUM 18:31"/><verse number="32" style="v" sid="NUM 18:32"/>ሎኦ ባጋ ጾሳዉ እም ድጌዳዋፐ ጉይያን ህንተ ምያ ዎደ፥ ባይዛንቻ ግድክታ። ሽን ሎኦ ባጋ ሄ እሞታፐ ከሰናን ደኢደ፥ ህንተ እስራኤልያ አሳ እሞታ ቱንሰናዳን ናገትተ። ሄዋዳን ኦና ዮፐ፥ ህንተ ሀይቃና’ ያጋ” ያጌዳ።<verse eid="NUM 18:32"/></para>
  <chapter eid="NUM 18"/>
  <chapter number="19" style="c" sid="NUM 19"/>
  <para style="s1">ቱናተፐ ጌይያ ሃ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 19:1"/>መና ጎዳይ ሙሳነ አሮና ሀዋዳን ያጌዳ፤ <verse eid="NUM 19:1"/><verse number="2" style="v" sid="NUM 19:2"/>“መና ጎዳይ ህግያን አዛዜዳ ዎጋይ ሀዋ: ትላ ቦላና ደእያ ዎይ ቦርስያባይ ባይና፥ እ ሞርግያን ሞርገ ምይ ዎቤና ዞኦ ኡሳቶ ነዉ አሀና ማላ፥ እስራኤልያ አሳዉ ኦድተ። <verse eid="NUM 19:2"/><verse number="3" style="v" sid="NUM 19:3"/>ቄስያ ኤልኣዛራዉ እዞ እምተ፤ እ እዞ ዱንካኔዳ ሳኣፐ ጋጻ አፍና፥ እት አሳይ እዞ አ ስንን ሹኮ። <verse eid="NUM 19:3"/><verse number="4" style="v" sid="NUM 19:4"/>ቄስያ ኤልኣዛር እ ሱፐ አማሬዳዋ ባረ ብራያን አኪደ፥ ጋከትያ ዱንካንያዉ ስን ባጋና ላፑን ገደ ጫጫፎ። <verse eid="NUM 19:4"/><verse number="5" style="v" sid="NUM 19:5"/>እ ጼልሽን ኡሳታ ጹገቱ፤ እ ጋልባይ፥ አሹ፥ ሱይነ ቶጪ ጹገቶ። <verse eid="NUM 19:5"/><verse number="6" style="v" sid="NUM 19:6"/>ቄሲ ዝጋ፥ ሂሶጵያ ታሽያነ ዞኦ ቁንጩትያ አኪደ፥ ኡሳቶ ጹግያ ታማን ኦሎ። <verse eid="NUM 19:6"/><verse number="7" style="v" sid="NUM 19:7"/>ሄዋፐ ጉይያን፥ ቄሲ ባረ ማዩዋ ሜጮ፤ ባረ ቦላካ ሃን ሜጨቶ፤ ያትደ ዱንካኔዳሳ ገሎ፤ ሽን ኦማርሳ ጋካናዉ እ ዎጋዳን ቱና ግዳናዋ። <verse eid="NUM 19:7"/><verse number="8" style="v" sid="NUM 19:8"/>ሄ ኡሳቶ ጹጌዳዌ ቃይ ባረ ማዩዋ ሜጮ፤ ባረ ቦላካ ሃን ሜጨቶ፤ እካ ቃይ ኦማርሳ ጋካናዉ ዎጋዳን ቱና ግዳናዋ።<verse eid="NUM 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 19:9"/>“ሄዋፐ ጉይያን፥ ጌሻ አሳይ ኡሳታ ጹገቴዳ ብድን ሺሺደ፥ ዱንካኔዳ ሳኣፐ ጋጻና ጌሻ ሳኣን ዎ። እስራኤልያ አሳይ ቱናተፐ ጌይያ ሃን ጎኤታናዉ ሄዋ ናግ ዎና፤ ሄዌ ናጋራፐ ጌሻናሳ።<note caller="-" style="x"><char style="xo" closed="false">19:9 </char><char style="xt" closed="false"><ref loc="HEB 9:13">እብራ. 9:13</ref></char></note> <verse eid="NUM 19:9"/><verse number="10" style="v" sid="NUM 19:10"/>ቃይ ኡሳት ብድን ሺሼዳ አሳይ ባረ ማዩዋ ሜጮ፤ ኦማርስ ጋካናዉ እ ዎጋዳን ቱና ግዳናዋ። ሀ ዎጋይ እስራኤልያ አሳዉነ ኡንቱንቱ ግዱዋን ደእያ ሀራ ጋደ አሳዉ ላኦካ መና ዎጋ ግዳናዋ።<verse eid="NUM 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 19:11"/>“ሀይቄዳ አሳ አሃ ቦችያ ኦንነ ላፑን ጋላሳ ዎጋዳን ቱናና። <verse eid="NUM 19:11"/><verse number="12" style="v" sid="NUM 19:12"/>ሄ ቱናተፐ ጌይያ ሃን ሄዛን ጋላስነ ላፑን ጋላስ፥ እ ባረና ጌሾ፤ ሄዋፐ ጉይያን፥ እ ዎጋዳን ጌሻ ግዳናዋ፤ ሽን ሄዛን ጋላሳንነ ላፑን ጋላሳን ባረና ጌሻና ዮፐ፥ እ ጌሻ ግደና። <verse eid="NUM 19:12"/><verse number="13" style="v" sid="NUM 19:13"/>ሀይቄዳ ኡራ አሃ ቦችያ ኦንነ ባረና ጌሸናን አጎፐ፥ መና ጎዳ ዱንካንያ እ ቱንሴ፤ ሄ ኡራይ እስራኤልያ አሳ ግዶፐ ቦሄቶ። ቱናተፐ ጌይያ ሃይ አ ቦላን ጫጫፈትቤና ድራዉ፥ እ ቱና፤ አ ቱናተይ አ ቦላን ጋምኤ።<verse eid="NUM 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 19:14"/>“እት ኡራይ ዱንካንያ ግዶን ሀይቆፐ ደእያ ዎጋይ ሀዋ: ዱንካንያ ግዶ ገልያ ኦንነ፥ ቃይ ዱንካንያ ግዶን ደእያ ኡባይካ ላፑን ጋላሳ ቱና ግዳናዋ። <verse eid="NUM 19:14"/><verse number="15" style="v" sid="NUM 19:15"/>ሄዋዳንካ፥ ቁምኤተናን ዶያ ደእያ ሚሻ ኡባይ ቱና ግዳናዋ። <verse eid="NUM 19:15"/><verse number="16" style="v" sid="NUM 19:16"/>ቃይ ደምባን ማሻን ሀይቄዳ አሳ፥ ዎይ ጮ ሀይቄዳ አሃ፥ ዎይ አሳ መቀ፥ ዎይ ዱፉዋ ቦችያ ኦንነ ላፑን ጋላሳ ቱና ግዳናዋ።<verse eid="NUM 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 19:17"/>“ቱናተፐ ጌሻናዉ ጹጌዳ ኡሳት ብድንፐ አማሬዳዋ አካደ፥ ኦቱዋን ዎደ፥ ፑልቶ ሃ አን ትጋ፤ <verse eid="NUM 19:17"/><verse number="18" style="v" sid="NUM 19:18"/>ጌሻ አሳይ ሂሶጵያ ቦንጭያ አኪደ፥ ሃን ቱሽ ከሲደ፥ ዱንካንያ፥ ዱንካንያን ደእያ ሚሻ ኡባንነ ሄዋን ደእያ አሳ ኡባ ቦላን ጫጫፎ። ቃይ አሳ መቀ፥ ዎይ ዱፉዋ፥ ዎይ ዎዳ ኡራ፥ ዎይ ሀይቄዳ ኡራ ቦቼዳ አሳ ቦላ እ ጫጫፎ። <verse eid="NUM 19:18"/><verse number="19" style="v" sid="NUM 19:19"/>ጌሻ አሳይ ሄዘንነ ላፑን ጋላሳን ቱኔዳ ኡራ ቦላን ጫጫፎ። እ ላፑን ጋላሳን ሄ ኡራ ቱናተፐ ጌሾ፤ ሄ ጌዬዳ ብታኒ ባረ ማዩዋ ሜጮ፤ ባረ ቦላካ ሃን ሜጨቶ፤ ሄ ጋላሳ ኦማርስ እ ጌሻ ግዳናዋ።<verse eid="NUM 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 19:20"/>“ሽን ቱና ኡራይ ባረና ጌሸናዋ ግዶፐ፥ ሄ ኡራይ መና ጎዳ ጌሻ ሳኣ ቱንሴዳ ድራዉ፥ እስራኤልያ አሳ ግዶፐ ቦሄቶ፤ ቱናተፐ ጌይያ ሃይ አ ቦላን ጫጫፈትቤና ድራዉ፥ እ ቱና። <verse eid="NUM 19:20"/><verse number="21" style="v" sid="NUM 19:21"/>ሀዌ ህንተንቶ መና ዎጋ ግዳናዋ። ቃይ ቱናተፐ ጌይያ ሃ ጫጫፍያ አሳይ ባረ ማዩዋ ሜጮ፤ ቱናተፐ ጌይያ ሃ ቦችያ ኦንነካ ኦማርስ ጋካናዉ ቱና ግዳናዋ። <verse eid="NUM 19:21"/><verse number="22" style="v" sid="NUM 19:22"/>ቱና ኡራይ ቦችያ አያይነ ቱኔ። ቃይ ሄዋ ቦችያ ኦንነ ኦማርሳ ጋካናዉ ቱና ግዴ” ያጌዳ።<verse eid="NUM 19:22"/></para>
  <chapter eid="NUM 19"/>
  <chapter number="20" style="c" sid="NUM 20"/>
  <para style="s1">ዛላፐ ከሴዳ ሃ</para>
  <para style="r">(<ref loc="EXO 17:1-7">ከሳ 17:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 20:1"/>ኮይሮ አግናን እስራኤላቱ ኡባይ ጺና ግያ መላ ቢታ ጋኪደ፥ ቃዴሳ ግያ ሳን ዱንካኔድኖ። ሄዋን ሚርያማ ሀይቃደ ሞገታዱ።<verse eid="NUM 20:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 20:2"/>ሄዋን አሳዉ ሃይ ይና፥ አሳይ ሺቂደ፥ ሙሴ ቦላነ አሮና ቦላ ደንዴዳ። <verse eid="NUM 20:2"/><verse number="3" style="v" sid="NUM 20:3"/>ኡንቱንቱ፥ “ኑ እሻቱ መና ጎዳ ስንን ሀይቄዳ ዎደ፥ ኑንካ ሀይቄዳዋ ግዴሮኮሻ! <verse eid="NUM 20:3"/><verse number="4" style="v" sid="NUM 20:4"/>ኑንነ ኑ መሂ ሀ መላ ቢታን ሀይቃናዳን፥ መና ጎዳ አሳ ሀዋ ህንተ አያዉ አሄድቴ? <verse eid="NUM 20:4"/><verse number="5" style="v" sid="NUM 20:5"/>ሀ ዎልቃማ ሳኣ ኑና ግብጼፐ ፑደ አያዉ አሄድቴ? ሀዋን ካ አይፊ፥ ዎይ ባላስያ፥ ዎይ ዎይንያ አይፊ፥ ዎይ ሮማኒ ባዋ፤ ቃይ ኡሽያ ሃይካ ሀዋን ባዋ” ያጊደ ሙሴና ዋላቀቴድኖ።<verse eid="NUM 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 20:6"/>ያትና ሙሴነ አሮን አሳ ማታፐ ጋከትያ ዱንካንያ ፐንገ ቢደ ጉፋኔድኖ፤ መና ጎዳ ቦንቹ ኡንቱንቶ ቆንጬዳ። <verse eid="NUM 20:6"/><verse number="7" style="v" sid="NUM 20:7"/>መና ጎዳይ ሙሳ፥ <verse eid="NUM 20:7"/><verse number="8" style="v" sid="NUM 20:8"/>“ነ ጋትማ አካ፤ ኔንነ ነ እሻ አሮን ሺቁዋ ሺሽተ፤ ኡንቱንቱ ስንን ዛላይ ሃ ጎጋና ማላ ኦዳ። ዛላፐ ሃ ህንተ ከሲደ፥ ሽቁዋነ ኡንቱንቱ መህያ ኡሻና” ያጌዳ። <verse eid="NUM 20:8"/><verse number="9" style="v" sid="NUM 20:9"/>መና ጎዳይ አዛዜዳዋዳን፥ ሙሴ መና ጎዳ ስንፐ ጋትማ አኬዳ።<verse eid="NUM 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 20:10"/>እነ አሮን ሺቁዋ ዛላ ስንን ሺሼድኖ፤ ሙሴ ኡንቱንታ፥ “ህንተኖ ማካላንቻቶ፥ ስስተ፤ ሀ ዛላፐ ሃ ህንተንቶ ኑን ቱሙ ከሳኔ?” ያጌዳ። <verse eid="NUM 20:10"/><verse number="11" style="v" sid="NUM 20:11"/>ሙሴ ባረ ኩሽያ ቁ ኦደ፥ ባረ ጋትማን ላኡ ገደ ዛላ ሾጭና፥ ሃይ ቂደ ከስና ያአይነ ኡንቱንቱ መሂ ኡሼዳ።<verse eid="NUM 20:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 20:12"/>ሽን መና ጎዳይ ሙሳነ አሮና፥ “እስራኤልያ አሳ ስንን ህንተ ታ ጌሻተ በሳናዉ አማነትቤና ድራዉ፥ ታን ኡንቱንቶ እምያ ቢታ ሀ አሳ ህንተ ገልስክታ” ያጌዳ።<verse eid="NUM 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 20:13"/>እስራኤልያ አሳይ መና ጎዳና ዋላቀቶዌ እ ባረ ጌሻተ ኡንቱንቱ ግዶን ቆንጭሴዳሳይ ሀ ማሪባ<note caller="+" style="f"><char style="fr" closed="false">20:13 </char><char style="fq" closed="false">ማሪባ፦ </char><char style="ft" closed="false">ሀ ሱን ብለይ እብራዌዋን፥ “ፓሉመቴዳ” ግያዋ።</char></note> ሃና።<verse eid="NUM 20:13"/></para>
  <para style="s1">ኤዶማ ካቲ እስራኤልያ አሳይ ባረ ቢታና አናዳን ድጌዳ</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 20:14"/>ሙሴ ቃዴሳፐ ኤዶማ ቢታ ካትያኮ፥ ባረ ኪተትያዋንታ ሀዋዳን ያጊደ ኪቴዳ፤ “ነ ዳቦ ግድያ እስራኤልያ አሳይ ሀዋዳን ያጌ፤ ‘ኑና ጋኬዳ መቱዋ ኡባ ኔን ኤራሳ። <verse eid="NUM 20:14"/><verse number="15" style="v" sid="NUM 20:15"/>ኑ ማይዛ አዎቱ ዱገ ግብጼ ዎድኖ፤ ያን ኑን ዳሮ ላይ ደኤዶ። ግብጼቱ ኑናነ ኑ አዎቱዋ ኡቅኔድኖ። <verse eid="NUM 20:15"/><verse number="16" style="v" sid="NUM 20:16"/>ኑን መና ጎዳዉ ዋስና፥ ኑ ዋሱዋ ስሲደ፥ ኪታንቻ ኪቲደ፥ ኑና ግብጼፐ ከሴዳ። ሀእ ኑን ነ ቢታ ጋጻን ደእያ ቃዴሳ ካታማን ደኤቶ። <verse eid="NUM 20:16"/><verse number="17" style="v" sid="NUM 20:17"/>ሀያና፥ ኑና ነ ቢታና አርኪ! ኑን አይ ጋደ ግዶፐካ ዎይ ዎይንያ ቱራ ግዶፐካ ቦቾኮ! ቃይ ኑን አይ ሃ ኦላፐነ ሃ ኡሾኮ። ኑን ካትያ ኦግያ ኦይቂደ ባና፤ ኑን ነ ቢታና አና ጋካናዉ፥ ሀድርሳ ዎይ ኡሸቻ ጎኮ’ ያጌ” ያጌዳ።<verse eid="NUM 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 20:18"/>ሽን ኤዶማ ካቲ፥ “ኑ ቢታና አከ፤ ህንተ ሀዋና መንና ካጄሎፐ፥ ኑን ደንዲደ ህንተና ማሻን ኦላና” ያጌድኖ።<verse eid="NUM 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 20:19"/>እስራኤላቱ አ፥ “ኑን ካትያ ኦግያና ባና፤ ኑን ዎይ ኑ መሂ ህንተ ሃ ኡሾፐ፥ ኑን ሄዎ ጋትያ ጭጋና። ኑን ገድያን አ ጻላላ ኮዬቶ፤ ሀራባ አያነ ኮዮኮ” ያጌድኖ።<verse eid="NUM 20:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 20:20"/>ኤዶማ ካቲ ዛረደ፥ “ህንተና አከ” ያጌዳ። ሄዋፐ ጉይያን፥ ዳሮነ ዎልቃማ ኦላንቻቱዋ አኪደ፥ እስራኤልያ አሳና ኦላ ጋከታናዉ ከሴዳ። <verse eid="NUM 20:20"/><verse number="21" style="v" sid="NUM 20:21"/>ኤዶማቱ ባረንቱ ቢታና እስራኤልያ አሳይ አናዉ ድጌዳ ድራዉ፥ እስራኤልያ አሳይ ስሚደ ሀራ ኦግያ ቤዳ።<verse eid="NUM 20:21"/></para>
  <para style="s1">አሮና ሀይቁዋ</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 20:22"/>እስራኤልያ አሳይ ኡባይ ቃዴሳፐ ደንዲደ፥ ሆራ ግያ ደርያ ቤድኖ። <verse eid="NUM 20:22"/><verse number="23" style="v" sid="NUM 20:23"/>ኤዶማ ዛዋ ማታን ደእያ ሆራ ደርያን፥ መና ጎዳይ ሙሳነ አሮና፥ <verse eid="NUM 20:23"/><verse number="24" style="v" sid="NUM 20:24"/>“አሮን ሀይቂደ ባረ ማይዛን ጋከትያ ዎዲ ጋኬዳ። ማሪባ ሃ ማታን ህንተ ላኡካ ታ አዛዙዋ ቦላ ማካሌዳ ድራዉ፥ እስራኤልያ አሳዉ ታን እምያ ቢታ እ ገለና። <verse eid="NUM 20:24"/><verse number="25" style="v" sid="NUM 20:25"/>አሮናነ አ ናኣ ኤልኣዛራ አካደ፥ ሆራ ደርያ አሀ። <verse eid="NUM 20:25"/><verse number="26" style="v" sid="NUM 20:26"/>አሮና ማዩዋ ቃራደ፥ አ ናኣ ኤልኣዛራ ማይዛ። አሮን ባረ ማይዛን ጋከታና፤ እ ያን ሀይቃና” ያጌዳ።<verse eid="NUM 20:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 20:27"/>መና ጎዳይ አዛዜዳዋዳን ሙሴ ኦዳ፤ አሳይ ኡባይ ጼልሽን፥ ኡንቱንቱ ሆራ ደርያ ከሴድኖ። <verse eid="NUM 20:27"/><verse number="28" style="v" sid="NUM 20:28"/>ሙሴ አሮና ማዩዋ ቃሪደ፥ አ ናኣ ኤልኣዛራ ማይዜዳ። አሮን ሄ ደርያ ሁጲያን ሀይቄዳ። ሄዋፐ ጉይያን፥ ሙሴነ ኤልኣዛር ደርያፐ ዎድኖ።<note caller="-" style="x"><char style="xo" closed="false">20:28 </char><char style="xt" closed="false"><ref loc="EXO 29:29">ከሳ 29:29</ref>፤ <ref loc="NUM 33:38">ፓይ. 33:38</ref>፤ <ref loc="DEU 10:6">ዛረ. 10:6</ref></char></note> <verse eid="NUM 20:28"/><verse number="29" style="v" sid="NUM 20:29"/>አሮን ሀይቄዳዋ አሳይ ኡባይ ኤሬዳ ዎደ፥ እስራኤልያ አሳይ ኡባይ አሮናዉ ሀታሙ ጋላሳ ዬኬዳ።<verse eid="NUM 20:29"/></para>
  <chapter eid="NUM 20"/>
  <chapter number="21" style="c" sid="NUM 21"/>
  <para style="s1">ካናነቱ ጾነቴድኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 21:1"/>ኔጌባ መላ ቢታ፥ ካናነ ጋድያን ደእያ አራዳ ካቲ እስራኤልያ አሳይ አታርማ አፍያ ኦግያ ባጋና ይያዋ ስሴዳ ዎደ፥ እ እስራኤላቱዋና ኦላ ጋከቲደ፥ ኡንቱንቱፐ አማሬዳዋንታ ኦሞዴዳ።<note caller="-" style="x"><char style="xo" closed="false">21:1 </char><char style="xt" closed="false"><ref loc="NUM 33:40">ፓይ. 33:40</ref></char></note> <verse eid="NUM 21:1"/><verse number="2" style="v" sid="NUM 21:2"/>ሄ ዎደ እስራኤልያ አሳይ፥ “ኔን ሀ አሳ ኑ ኩሽያን አደ እሞፐ፥ ኑን ኡንቱንቱ ካታማቱዋ ኡባና ይሳና” ያጊደ መና ጎዳው ሺቄድኖ። <verse eid="NUM 21:2"/><verse number="3" style="v" sid="NUM 21:3"/>መና ጎዳይ እስራኤልያ ቃላ ስሲደ፥ ሄ ካናነቱዋ ኡንቱንቶ አ እሜዳ፤ ኡንቱንቱ ሄ ካናነቱዋነ ኡንቱንቱ ካታማቱዋ ኡባና ይሴድኖ። ሄዋ ድራዉ፥ ሄ ሳአይ ሆርማ<note caller="+" style="f"><char style="fr" closed="false">21:3 </char><char style="fq" closed="false">ሆርማ፦ </char><char style="ft" closed="false">ሀ ሱን ብለይ እብራዌዋን፥ “ባሻ” ግያዋ።</char></note> ጌተት ሱንቴዳ።<verse eid="NUM 21:3"/></para>
  <para style="s1">ናሃስያ ብራታፐ መቴዳ ሾሻ</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 21:4"/>እስራኤልያ አሳይ ሆራ ደርያፐ ደንዲደ፥ ኤዶማ ቢታ ዩሹዋ ባናዉ ዞኦ አባ አፍያ ኦግያና ቤድኖ፤ ሽን ኦግያ ቦላን አሳዉ ዳንዳያይ ዉሬዳ።<note caller="-" style="x"><char style="xo" closed="false">21:4 </char><char style="xt" closed="false"><ref loc="DEU 2:1">ዛረ. 2:1</ref></char></note> <verse eid="NUM 21:4"/><verse number="5" style="v" sid="NUM 21:5"/>አሳይ፥ “ኑን መላ ቢታን ሀይቃናዉ ግብጼፐ ፑደ ኑና አያዉ አሄድቴ? ቁም ባዋ፤ ሃይ ባዋ፤ ሀ ኢታ ቁማይ ኑና ሸነዬዳ” ያጊደ ጾሳ ቦላነ ሙሴ ቦላ ዙዙሜድኖ።<note caller="-" style="x"><char style="xo" closed="false">21:5-6 </char><char style="xt" closed="false"><ref loc="1CO 10:9">1 ቆሮ. 10:9</ref></char></note><verse eid="NUM 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 21:6"/>መና ጎዳይ አሳ ግዱዋን ማርዝያና ደእያ ሾሻቱዋ የዴዳ፤ ኡንቱንቱ ዱክና፥ ዳሮ እስራኤላቱ ሀይቄድኖ። <verse eid="NUM 21:6"/><verse number="7" style="v" sid="NUM 21:7"/>ኡንቱንቱ ሙሴኮ ዪደ አ፥ “ኑን መና ጎዳ ቦላነ ነ ቦላ ዙዙሚደ፥ ናጋራ ኦዶ። ኑፐ ሀ ሾሻ ሃሳና ማላ፥ ኔን መና ጎዳ ዎሳ” ያጌድኖ። ሙሴ አሳ ድራዉ ዎሴዳ።<verse eid="NUM 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 21:8"/>ሄዋፐ ጉይያን መና ጎዳይ ሙሳ፥ “ኔን ሾሻ መደ፥ ኡንቱንቱ ስንን ም ቦላን ካቃ፤ ዱከቴዳ ኦንነ አ ጼሎፐ ፓጻና” ያጌዳ። <verse eid="NUM 21:8"/><verse number="9" style="v" sid="NUM 21:9"/>ሙሴ ናሃሰ ብራታፐ ሾሻ መደ፥ ም ቦላን ካቄዳ። ሄዋፐ ጉይያን፥ ሾሻይ ዱኬዳ አሳይ ኡባይ ናሃስያ ሾሻ ጼሊደ ፓጼድኖ።<note caller="-" style="x"><char style="xo" closed="false">21:9 </char><char style="xt" closed="false"><ref loc="2KI 18:4">2 ካታ. 18:4</ref>፤ <ref loc="JHN 3:14">ዮሃ. 3:14</ref></char></note><verse eid="NUM 21:9"/></para>
  <para style="s1">ሆራ ደርያፐ ደንዲደ ሞኣባ ቢታ ቤድኖ</para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 21:10"/>እስራኤልያ አሳይ ደንዲደ፥ ኦቦታ ግያ ሳን ዱንካኔድኖ። <verse eid="NUM 21:10"/><verse number="11" style="v" sid="NUM 21:11"/>ኦቦታፐ ደንዲደ፥ ሞኣባፐ ስንና ደእያ ባዙዋን፥ አዋይ ዶልያ ባጋና፥ ላለቴዳ እየ አባርማ ካታማን ዱንካኔድኖ። <verse eid="NUM 21:11"/><verse number="12" style="v" sid="NUM 21:12"/>ሄዋፐ ደንዲደ፥ ዘሬዳ ዛንጋራን ዱንካኔድኖ። <verse eid="NUM 21:12"/><verse number="13" style="v" sid="NUM 21:13"/>ሄዋፐ ደንዲደ፥ አሞረቱ ቢታ ጋጻ ጋካናዉ ብያ መላ ቢታ ግዶን አርኖና ሻፋፐ ሄፍንን ዱንካኔድኖ። አርኖና ሻፋይ ሞኣባ ቢታፐነ አሞረቱ ጋድያፐ ግዱዋን ደእያ ዛዋ። <verse eid="NUM 21:13"/><verse number="14" style="v" sid="NUM 21:14"/>ሄዋ ድራዉ፥ ጾሳ ኦላ ማጻፋን፥ “ሱፋ ሄራን ደእያ ዋሄባ ካታማነ አርኖና ሻፋ ዛንጋራ፥ <verse eid="NUM 21:14"/><verse number="15" style="v" sid="NUM 21:15"/>ኤራ ካታማ ጋካናዉነ ሞኣባ ዛዋ ጋካናዉ ደእያ ዛንጋራ ዱገ” ያገት ጻፈቴዳ።<verse eid="NUM 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 21:16"/>ኡንቱንቱ ሄዋፐ ደንዲደ፥ ቤራ ግያሳ ቤድኖ፤ ሄዌ ጾሳይ ሙሳ፥ “አሳ ሺሻ፤ ታን ኡንቱንቶ ሃ እማና” ያጊደ ኦዴዳ ሃ ኦላ።<verse eid="NUM 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 21:17"/>ሄዋን እስራኤልያ አሳይ ሀ ማዝሙርያ የጼዳ።</para>
  <para style="q1" vid="NUM 21:17">“ሃ ኦላዉ፥ ፑልታ!<verse eid="NUM 21:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 21:18"/>ካፓቱ ቦኬዳ ሃ ኦላዉ፥</para>
  <para style="q2" vid="NUM 21:18">አሳ ካለያዋንቱ ኦላዉ፥</para>
  <para style="q2" vid="NUM 21:18">ካተቱዋ ጻምኣንነ ኡንቱንቱ ካዛራን ቦኬዳ ሃ ኦላዉ</para>
  <para style="q2" vid="NUM 21:18">አነ የጼቶ” ያጌዳ።</para>
  <para style="p" vid="NUM 21:18">ኡንቱንቱ ሄ ባዙዋፐ ማታና ግያሳ ቤድኖ፤ <verse eid="NUM 21:18"/><verse number="19" style="v" sid="NUM 21:19"/>ማታናፐ ናህልኤላ፥ ናህልኤላፐ ባሞታ ግያሳ፥ <verse eid="NUM 21:19"/><verse number="20" style="v" sid="NUM 21:20"/>ባሞታፐ ደንዲደ፥ ሞኣበን ደእያ ዛንጋራ ቤድኖ፤ ሀ ዛንጋራይ ፕስጋ ደርያፐ ጋርሳን ባዙዋ ማታን ደኤ።<verse eid="NUM 21:20"/></para>
  <para style="s1">ካቲ ስሆንነ ካቲ ኦግ ጾነቴድኖ</para>
  <para style="r">(<ref loc="DEU 2:26-3:11">ዛረ. 2:26—3:11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 21:21"/>ሄዋፐ ጉይያን፥ እስራኤልያ አሳይ አሞረ ቢታ ካትያ ስሆናኮ ኪተትያዋንታ ሀዋዳን ያጊደ ኪቴዳ፤ <verse eid="NUM 21:21"/><verse number="22" style="v" sid="NUM 21:22"/>“ኑና ነ ቢታና አርኪ! ኑን ነ ጋድያ ግዱዋ ዎይ ዎይንያ ቱራ ግዱዋ ገሎኮ፤ ቃይ ሃ ኦላ ሀቃዋፐነ ኡሾኮ። ኑን ነ ቢታና አና ጋካናዉ፥ ካትያ ኦግያና ባና” ያጌዳ።<verse eid="NUM 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 21:23"/>ሽን ስሆን ባረ ቢታና እስራኤልያ አሳ አናን ድጌዳ፤ እ ባረ ኦላንቻቱዋ ኡባ ሺሺደ፥ እስራኤልያ አሳ ኦላናዉ መላ ቢታ ቤዳ፤ ያሃጻ ግያሳ ብ ጋኪደ፥ እስራኤልያ አሳና ኦለቴዳ። <verse eid="NUM 21:23"/><verse number="24" style="v" sid="NUM 21:24"/>ሽን እስራኤልያ አሳይ ኦላን አሞረቱዋፐ ዳሩዋ ዎደ፥ ኡንቱንታ ቢታ አርኖና ሻፋፐ ዶሚደ፥ አሞናቱዋ ዛዋን ደእያ ያቦቃ ሻፋ ጋካናዉ ኦይቄዳ። አሞና አሳቱ ቢታ ዛዋይ ግምበት ኡቴዳ ድራዉ፥ ኡንቱንቱ ያ ገልበይክኖ። <verse eid="NUM 21:24"/><verse number="25" style="v" sid="NUM 21:25"/>ያትና እስራኤላቱ አሞረቱ ካታማቱዋ ኡባ ጾኒደ አኬድኖ። ቃይ ሀሰቦናነ አ ዩሹዋን ደእያ ቄር ካታማቱዋካ ኡባ ኦይቂደ፥ ያን ኡቴድኖ። <verse eid="NUM 21:25"/><verse number="26" style="v" sid="NUM 21:26"/>ሀሰቦና ካታማይ አሞረቱ ካትያ ስሆና ካታማ። ስሆን ሞኣባ ቢታ ካትያ ካሰዋ ኦሊደ፥ አርኖና ሻፋ ጋካናዉ አ ቢታ ኡባ አፐ አኬዳዋ።<verse eid="NUM 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 21:27"/>ሄዋ ድራዉ፥ ሌምሱዋን ሀዋዳን ያጌድኖ፤</para>
  <para style="q1" vid="NUM 21:27">“ሀሰቦና ሃይተ፤</para>
  <para style="q2" vid="NUM 21:27">ሄ ካታማይ ዛረ ኬጸቶ፤</para>
  <para style="q1" vid="NUM 21:27">ስሆና ዎልቃማ ካታማይ ዎ ኤቂደ ኬጸቶ!<verse eid="NUM 21:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="NUM 21:28"/>አያዉ ጎፐ፥ ታማይ ሀሰቦናፐ፥<note caller="-" style="x"><char style="xo" closed="false">21:28 </char><char style="xt" closed="false"><ref loc="JER 48:45-46">ኤር. 48:45-46</ref></char></note></para>
  <para style="q2" vid="NUM 21:28">ላጩ ስሆና ካታማፐ ከሴዳ፤</para>
  <para style="q1" vid="NUM 21:28">ሞኣበን ደእያ ኤራነ</para>
  <para style="q2" vid="NUM 21:28">አርኖና ሻፋ ሄራን ገዝያን ደእያ ካፓቱዋ ሜዳ።<verse eid="NUM 21:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="NUM 21:29"/>ሞኣባ፥ ነዉ አየ አና!</para>
  <para style="q2" vid="NUM 21:29">ካሞሻዉ ጎይንያዋንቶ፥ ህንተ ዬድታ።</para>
  <para style="q1" vid="NUM 21:29">ህንተ ጾሳይ፥ ካሞሽ፥</para>
  <para style="q2" vid="NUM 21:29">ህንተ አቱማ ናናቱዋ ባቃታናዉ፥</para>
  <para style="q2" vid="NUM 21:29">ህንተ ማጫ ናናቱዋ ኦሞዶ፥</para>
  <para style="q2" vid="NUM 21:29">አሞረቱ ካትያ ስሆናዉ እሜዳ።<verse eid="NUM 21:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="NUM 21:30"/>ህንተ ዘረቱ ሀሰቦናፐ ዶሚደ፥</para>
  <para style="q2" vid="NUM 21:30">ድቦና ጋካናዉ ኡባና ዬድኖ።</para>
  <para style="q1" vid="NUM 21:30">መዳባ ማታን ደእያ ኖፋሀ ጋካናዉ</para>
  <para style="q2" vid="NUM 21:30">ዉርሲደ ባይዜድኖ” ያጌድኖ።<verse eid="NUM 21:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 21:31"/>ሄዋዳን ሀኒደ፥ እስራኤላቱ አሞረቱ ጋድያን ኡቴድኖ። <verse eid="NUM 21:31"/><verse number="32" style="v" sid="NUM 21:32"/>ቃይ ሙሴ ዎችያዋንታ ያእዜራ ግያ ካታማ የድና፥ እስራኤላቱ ሄ ካታማነ አ ሄራን ደእያ ቄር ካታማቱዋ ኦይቂደ፥ ሄዋን ደእያ አሞረቱዋ ከሲደ የደርሴድኖ።<verse eid="NUM 21:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 21:33"/>ሄዋፐ ጉይያን፥ እስራኤላቱ ስሚደ፥ ባሳነ አፍያ ኦግያና ከሴድኖ። ባሳነ ካቲ ኦግ ባረ ኦላንቻቱዋ ኡባና ኤድራአ ግያ ካታማ ኡንቱንቱና ኦለታናዉ ከሴዳ። <verse eid="NUM 21:33"/><verse number="34" style="v" sid="NUM 21:34"/>ሽን መና ጎዳይ ሙሳ፥ “አዉ ያዮፓ! አያዉ ጎፐ፥ ታን ካትያ ኦጋ አ አሳ ኡባናነ አ ቢታና ነ ኩሽያን አደ እማድ። ሀሰቦናን ኡቲደ ሞዴዳ አሞረቱ ካትያ ስሆና ቦላ ኦዳዋዳን፥ ኔን አ ቦላካ ኦና” ያጌዳ። <verse eid="NUM 21:34"/><verse number="35" style="v" sid="NUM 21:35"/>እስራኤላቱ ኦጋ፥ አ አቱማ ናናቱዋነ አ አሳ ኡባ እቱዋነ ፓጻ አሸናን ዎድኖ። ኡንቱንቱ አ ቢታ ላቴድኖ።<verse eid="NUM 21:35"/></para>
  <chapter eid="NUM 21"/>
  <chapter number="22" style="c" sid="NUM 22"/>
  <para style="ms">ሞኣባን ኦሰቴዳ ሀኖታቱዋ</para>
  <para style="mr">(<ref loc="NUM 22:1-32:42">22:1—32:42</ref>)</para>
  <para style="s1">ሞኣባ ካቲ ባላቅ ባላማ ጼግሴዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 22:1"/>ሄዋፐ ጉይያን እስራኤልያ አሳይ ደንዲደ፥ እያርኮ ልክያን ዮርዳኖሳ ሄፍንን ደእያ ሞኣባ ደምባን ዱንካኔዳ።<verse eid="NUM 22:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 22:2"/>እስራኤልያ አሳይ አሞረቱ ቦላ ኦዳዋ ኡባ ጽፖራ ናአይ ባላቅ ስሴዳ። <verse eid="NUM 22:2"/><verse number="3" style="v" sid="NUM 22:3"/>እስራኤልያ አሳይ ሎይ ዳሮ ግዴዳ ድራዉ፥ ሞኣባቱ ሎይ ዳጋሚደ ያዬድኖ። <verse eid="NUM 22:3"/><verse number="4" style="v" sid="NUM 22:4"/>ሞኣባቱ ምድያማ ጭማቱዋ፥ “ቦራይ ማታ ም ይስያዋዳን ሀ ዉደ አሳይ ኑ ዩሹዋን ደእያ ኡባ ም ይሳና” ያጌድኖ።</para>
  <para style="p" vid="NUM 22:4">ሄ ዎደ ሞኣባ ካቲ፥ ጽፖራ ናአይ ባላቅ <verse eid="NUM 22:4"/><verse number="5" style="v" sid="NUM 22:5"/>አማዋ ጋድያን ኤፍራጺሳ ሻፋ ማታን ፓቶራ ካታማን ደእያ ብኦራ ናኣ ባላማኮ አሳ ኪቴዳ። ባላቅ፥ “በአ፥ ግብጼፐ ዳሮ አሳይ ከሴዳ፤ ኡንቱንቱ ቢታ ኡባ ማዪደ፥ ታፐ ያ ባጋን ደኢኖ።<note caller="-" style="x"><char style="xo" closed="false">22:5 </char><char style="xt" closed="false"><ref loc="NUM 31:8">ፓይ. 31:8</ref>፤ <ref loc="2PE 2:15-16">2 ጰጽ. 2:15-16</ref>፤ <ref loc="JUD 1:11">ይሁዳ 11</ref></char></note> <verse eid="NUM 22:5"/><verse number="6" style="v" sid="NUM 22:6"/>ኡንቱንቱ ታዉ ሎይ ዎልቃምያ ድራዉ፥ ሀያና ሀእ ያደ፥ ኡንቱንታ ታዉ ሸቃርኪ! ኦን ኤሪ፥ ታን ኡንቱንታ ጾናናዉነ ጋድያፐ ከሳናዉ ዳንዳያነንቶነ። አያዉ ጎፐ፥ ኔን አንጄዳዌ አንጀቴዳዋነ ኔን ሸቄዳዌ ሸቀቴዳዋ ግድያዋ ታን ኤራይ” ያጌዳ።<verse eid="NUM 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 22:7"/>ሞኣባ ጭማቱነ ምድያማ ጭማቱ ሸቂስያ ጋትያ አኪደ፥ ባላማኮ ቤድኖ። ባላቅ ጌዳዋ አዉ ኦዴድኖ። <verse eid="NUM 22:7"/><verse number="8" style="v" sid="NUM 22:8"/>ባላም ኡንቱንታ፥ “ሀቼ ቃማ ሀዋን አቅተ፤ መና ጎዳይ ታዉ ኦድያዋ ታን ህንተንቶ ኦዳና” ያጌዳ። ሞኣባ ካፓቱ ባላማዋን ታኬድኖ።<verse eid="NUM 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 22:9"/>ጾሳይ ባላማኮ ዪደ፥ “ሀዋንቱ ኔናና ደእያ አሳቱ ኦኔ?” ያጊደ ኦቼዳ።<verse eid="NUM 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 22:10"/>ባላም ጾሳ፥ “ሞኣባ ካቲ፥ ጽፖራ ናአይ ባላቅ፥ <verse eid="NUM 22:10"/><verse number="11" style="v" sid="NUM 22:11"/>‘ግብጼፐ ዳሮ አሳይ ከሴዳ፤ ኡንቱንቱ ቢታ ኡባ ማዬድኖ። ሀእ ኔን ያደ፥ ኡንቱንታ ታዉ ሸቃርኪ! ኦን ኤሪ፥ ታን ኡንቱንታ ጾናናዉነ ጋድያፐ ከሳናዉ ዳንዳያነንቶነ’ ያጊደ ኡንቱንታ ታኮ ኪቴዳ” ያጌዳ።<verse eid="NUM 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 22:12"/>ጾሳይ ባላማ፥ “ኔን ኡንቱንቱና ቦፓ። እስራኤላቱ አንጀቴዳዋንታ ግድያ ድራዉ፥ ኔን ሄ አሳ ሸቆፓ” ያጌዳ።<verse eid="NUM 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 22:13"/>ዎንተ ጋላስ ዎንታ ባላም ደንዲደ፥ ባላቃ ካፓቱዋ፥ “ታን ህንተናና ቤናዳን መና ጎዳይ ድጌዳ ድራዉ፥ ህንተ ቢታ ስምተ” ያጌዳ።<verse eid="NUM 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 22:14"/>ሞኣባ ካፓቱ ያፐ ደንዲደ፥ ባላቃኮ ስሚደ አ፥ “ባላም ኑናና ዬናን እጼዳ” ያጌድኖ።<verse eid="NUM 22:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 22:15"/>ዛሪደካ ባላቅ ካሰዋንቱፐ አ ቦንቼቴዳነ ፓይዱዋንካ ጮራቴዳ ሀራ ካፓቱዋ አኮ ኪቴዳ። <verse eid="NUM 22:15"/><verse number="16" style="v" sid="NUM 22:16"/>ኡንቱንቱ ባላማኮ ዪደ፥ “ጽፖራ ናአይ ባላቅ ኔና፥ ‘ኔን ታኮ ያናዋ ኔና አያይነ ተኦፖ። <verse eid="NUM 22:16"/><verse number="17" style="v" sid="NUM 22:17"/>አያዉ ጎፐ፥ ታን ነዉ ዳሮ ዎይቱዋ እማና፤ ኔን ግያዋ ኡባ አያነ ታን ኦና። ያደ ሀ አሳ ታዉ ሸቃርኪ’ ” ያጊደ ኦዴድኖ።<verse eid="NUM 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 22:18"/>ሽን ባላም ኡንቱንቶ፥ “ባላቅ ሀራይ አቶ ብራይነ ዎርቃይ ኩሜዳ ባረ ካትያ ጎልያ ታዉ እሜዳዋ ግድንቶነ፥ መና ጎዳ ታ ጾሳ አዛዙዋፐ አደ፥ ታን አያነ ፓጭሳናዉ ዎይ ጉጃናዉ ዳንዳይከ። <verse eid="NUM 22:18"/><verse number="19" style="v" sid="NUM 22:19"/>መና ጎዳይ ታዉ ኦድያ ሀራባይ ደኦፐ ታን ኤራናዳን፥ ህንተካ ሀች ቃማ ሀዋን አቅተ” ያጌዳ።<verse eid="NUM 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 22:20"/>ሄ ጋላሳ ቃማ ጾሳይ ባላማኮ ዪደ፥ “ሀ አሳይ ኔና ጼሳናዉ ዬዳ ድራዉ፥ ኔን ኡንቱንቱና ባ። ሽን ታን ነዉ ኦድያዋ ጻላላ ኦ” ያጌዳ።<verse eid="NUM 22:20"/></para>
  <para style="s1">ባላማነ አ ሀራቶ</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 22:21"/>ዎንተ ጋላስ ባላም ባረ ሀራቶ ኮሪደ፥ ሞኣባ ካፓቱዋና ቤዳ። <verse eid="NUM 22:21"/><verse number="22" style="v" sid="NUM 22:22"/>ሽን እ ብያ ዎደ ጾሳ ሀንቁ ኤጽ ከሴዳ፤ ያትና መና ጎዳ ኪታንቻይ አ ተአናዉ ኦግያን ኤቄዳ። ሄ ዎደ ባላም ባረ ሀራቶ ቶጎዋን፥ አ ላኡ ቆማቱ አናና ደኢኖ። <verse eid="NUM 22:22"/><verse number="23" style="v" sid="NUM 22:23"/>መና ጎዳ ኪታንቻይ ማሻ ዛረ ኦይቂደ፥ ኦግያን ኤቄዳዋ ሀራታ በአኔ፥ ኦግያ አጋደ፥ ጎሻ ግዶ ገላዱ። ባላም ኦግያ ዛራናዉ ሀራቶ ሾጬዳ።<verse eid="NUM 22:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 22:24"/>ያትና መና ጎዳ ኪታንቻይ ላኡ ዎይንያ ቱራ ሳአቱዋፐ ግዱዋን፥ ያ ባጋናነ ሀ ባጋና ግምቢያን ድረት ኡቴዳ ኡንኦ ኦግያን ኤቄዳ። <verse eid="NUM 22:24"/><verse number="25" style="v" sid="NUM 22:25"/>ሀራታ መና ጎዳ ኪታንቻ በኤዳ ዎደ፥ ግምቢያ ድርሳኮ ሺቃደ፥ ባላማ ገድያ ግምቢያ ድርሳና ዳራጻዱ፤ እ ሀራቶ ላኤንዋካ ሾጬዳ።<verse eid="NUM 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 22:26"/>ሄዋፐ ጉይያን፥ መና ጎዳ ኪታንቻይ ስንዉኮ አደ፥ ሀድርሳ ባጋናካ ኡሸቻ ባጋና አያ ሳአይ ባይና ኡንኦ ሳኣን ኤቄዳ። <verse eid="NUM 22:26"/><verse number="27" style="v" sid="NUM 22:27"/>ሀራታ መና ጎዳ ኪታንቻ በኣደ፥ ባላም ቶጎዋን ግሳዱ። ባላም ሎይ ሀንቀቲደ፥ ባረ ጻምአን ሀራቶ ቡኬዳ። <verse eid="NUM 22:27"/><verse number="28" style="v" sid="NUM 22:28"/>ሄዋፐ ጉይያን፥ መና ጎዳይ ሀራት ዶና ዶይና፥ ሀራታ ባላማ፥ “ታን ነዉ አይ ኦኔ ኔን ታና ሀ ሄዙ ገደ ቡኬዳዌ?” ያጋዱ።<verse eid="NUM 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 22:29"/>ባላም ሀራቶ፥ “ኔን ታና ኤየዳ ድራሳ። ታ ኩሽያን ማሻይ ደኤዳዋ ግድንቶነ፥ ታን ኔና ሀእ ዎና ሽን!” ያጌዳ።<verse eid="NUM 22:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 22:30"/>ሀራታ ባላማ፥ “ታን ነ ደኦ ኡባን ሀች ጋካናዉ ቶግያ ነ ሀራቶ ግድክታ? ታን ነዉ ሀዋዳን ሀና ኤራይታ?” ያጋዱ።</para>
  <para style="p" vid="NUM 22:30">ባላም፥ “ሀና ኤራካ” ያጌዳ።<verse eid="NUM 22:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 22:31"/>ሄዋፐ ጉይያን፥ መና ጎዳይ ባላማ አይፍያ ዶይና፥ መና ጎዳ ኪታንቻይ ሾኩዋፐ ሾዴዳ ማሻ ኦይቂደ፥ ኦግያን ኤቄዳዋ በኤዳ። እ ልጭ ጊደ፥ ሶምኡዋ ሳኣ ጋደ ጉፋኔዳ። <verse eid="NUM 22:31"/><verse number="32" style="v" sid="NUM 22:32"/>መና ጎዳ ኪታንቻይ አ፥ “ነ ሀራቶ ሀ ሄዙ ገደ አያዉ ቡካዲ? ነ ኦጊ ታ ስንን ጌላ ግድያ ድራዉ፥ ታን ኔና ተአናዉ ሀዋ ያድ። <verse eid="NUM 22:32"/><verse number="33" style="v" sid="NUM 22:33"/>ሀራታ ታና በኣደ፥ ታ ስንፐ ሄዙ ገደ ዎራ ስማዱ። ሀራታ ዎራ ስማቤናዋ ግድንቶነ፥ ታን ኔና ሀኖደ ቱሙ ዎ ድጋደ፥ ሀራቶ አሻና ሽን” ያጌዳ።<verse eid="NUM 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 22:34"/>ባላም መና ጎዳ ኪታንቻ ዛሪደ፥ “ታን ናጋራ ኦድ። ኔን ታና ተአናዉ ኦግያ ቦላን ኤቄዳዋ ታን ኤራበይከ። ኔን ዶሳቤናባ ግዶፐ፥ ታን ሀእ ጉየ ስማና” ያጌዳ።<verse eid="NUM 22:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 22:35"/>መና ጎዳ ኪታንቻይ ባላማ፥ “ኔን ሀ አሳቱዋና ባ፤ ሽን ታን ነዉ ኦድያዋ ጻላላ ሃሳያ” ያጌዳ። ባላም ባላቃ ቢታ ካፓቱዋና ቤዳ።<verse eid="NUM 22:35"/></para>
  <para style="s1">ባላቅ ባላማ ናሸቻን ሞኬዳ</para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 22:36"/>ባላም ይያዋ ባላቅ ስሴዳ ዎደ፥ አርኖና ሻፋ ዛዋን ባረ ቢታ ጋጻን ደእያ ሞኣባቱዋ ካታማን አናና ጋከታናዉ ቤዳ። <verse eid="NUM 22:36"/><verse number="37" style="v" sid="NUM 22:37"/>ባላቅ ባላማ፥ “ኔን ኤለካ ያናዳን ታን ኪታበይክታ? ኔን አያዉ ታኮ ኤለካ ያበይኪ? ታን ነዉ ዎይታናዉ ቱሙ ዳንዳይክታ?” ያጌዳ።<verse eid="NUM 22:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 22:38"/>ባላም ባላቃ፥ “በአ፥ ሀእ ታን ኔኮ ያድ፤ ሽን ታን አያነ ጋናዉ ቱሙ ዳንዳይከ። ጾሳይ ታና ሃሳይስያዋ ጻላላ ታን ሃሳያና” ያጌዳ። <verse eid="NUM 22:38"/><verse number="39" style="v" sid="NUM 22:39"/>ሄዋፐ ጉይያን፥ ባላም ባላቃና ቅርያት-ሁጾታ ግያ ካታማ ቤዳ። <verse eid="NUM 22:39"/><verse number="40" style="v" sid="NUM 22:40"/>ባላቅ ሚዛነ ዶርሳ ያርሺደ፥ አሹዋፐ አማሬዳዋ ባላማዉነ አናና ደእያ ካፓቶ እሜዳ።<verse eid="NUM 22:40"/></para>
  <para style="s1">ባላማ ኮይሮ ትምቢትያ</para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 22:41"/>ዎንተ ጋላስ ዎንታ ባላቅ ባላማ አኪደ፥ ባሞት-ባኣል ግያሳ ፑደ ከሴዳ፤ ሄዋን ኤቂደ፥ ባላም እስራኤልያ አሳፐ ባጋ በኤዳ።<verse eid="NUM 22:41"/></para>
  <chapter eid="NUM 22"/>
  <chapter number="23" style="c" sid="NUM 23"/>
  <para style="p">
    <verse number="1" style="v" sid="NUM 23:1"/>ባላም ባላቃ፥ “ሀዋን ኔን ታዉ ላፑን ያርሽያ ሳኣ ግምባ፤ ቃይ ላፑን ኮሩማ ቦራነ ላፑን ዶርሳ ኦርገቱዋ ኔን ታዉ ጊግሳ” ያጌዳ።<verse eid="NUM 23:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 23:2"/>ባላም ጌዳዋዳን ባላቅ ኦዳ፤ ኡንቱንቱ ላኡካ እት እት ያርሽያ ሳኣን እት ኮሩማ ቦራነ እት ዶርሳ ኦርግያ ያርሼድኖ። <verse eid="NUM 23:2"/><verse number="3" style="v" sid="NUM 23:3"/>ሄዋፐ ጉይያን፥ ባላም ባላቃ፥ “ኔን ነ ጹግያ ያርሹዋ ማታን ሀዋን ኤቃሻ፤ ታን ገደኮ ባይ። መና ጎዳይ ታናና ጋከታናዉ ሀቀት ዬናን አገና። እ ታዉ ቆንጭስያዋ አያነ ታን ነዉ ኦዳና” ያጌዳ። ቃ ዞዘትያ መላ ሳኣ ከሴዳ። <verse eid="NUM 23:3"/><verse number="4" style="v" sid="NUM 23:4"/>ሄዋን ጾሳይ ባላማና ጋከትና ባላም፥ “ታን ላፑን ያርሽያ ሳኣ ጊግሳድ፤ እት እት ያርሽያ ሳኣን እት ኮሩማ ቦራነ እት ዶርሳ ኦርግያ ያርሻድ” ያጌዳ።<verse eid="NUM 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 23:5"/>ባላም ጋናባ መና ጎዳይ አዉ ኦዲደ፥ “ኔን ባላቃኮ ስማደ፥ አዉ ሀ ትምቢትያ ኦዳ” ያጌዳ። <verse eid="NUM 23:5"/><verse number="6" style="v" sid="NUM 23:6"/>እ ባላቃኮ ስምያ ዎደ፥ ባላቅ ሞኣባ ካፓቱ ኡባና ባረ ጹግያ ያርሹዋ ማታን ኤቄዳ።<verse eid="NUM 23:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 23:7"/>ሄዋፐ ጉይያን፥ ባላም ባረ ትምቢትያ ሀዋዳን ያጊደ ኦዴዳ፤</para>
  <para style="q1" vid="NUM 23:7">“ሞኣባ ካቲ አዋይ ዶልያ ባጋ ደረቱዋፐ፥</para>
  <para style="q2" vid="NUM 23:7">ሶርያ ጋድያፐ ታና ሀዋዳን ያጊደ አሄዳ፤</para>
  <para style="q1" vid="NUM 23:7">‘ሃያ፤ ያቆባ ታዉ ሸቃ!</para>
  <para style="q2" vid="NUM 23:7">እስራኤልያ አሳ፥ “ዉርተ!” ያጋ’ ያጌዳ።<verse eid="NUM 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 23:8"/>ጾሳይ ሸቂቤናዋንታ ታን ዋታ ሸቆ?</para>
  <para style="q2" vid="NUM 23:8">መና ጎዳይ፥ ‘ዉርተ!’ ያግቤናዋንታ፥</para>
  <para style="q2" vid="NUM 23:8">ታን ዋታደ፥ ‘ዉርተ!’ ያጎ?<verse eid="NUM 23:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 23:9"/>ታን ቃ ዛላ ሁጲያን ኤቃደ ኡንቱንታ ጼላይ፤</para>
  <para style="q2" vid="NUM 23:9">ዞዝያን ኤቃደ ታን ኡንቱንታ በአይ።</para>
  <para style="q1" vid="NUM 23:9">ኡንቱንቱ ባረካ ደእያ አሳ፤</para>
  <para style="q2" vid="NUM 23:9">ኡንቱንቱ ባረና ካዉተቱዋፐ እቱዋዳን ፓይድክኖ።<verse eid="NUM 23:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NUM 23:10"/>ባናዳን ጮራቴዳ ያቆባ ዘረ ኦን</para>
  <para style="q2" vid="NUM 23:10">ፓይዳናዉ ዳንዳዪ?</para>
  <para style="q1" vid="NUM 23:10">ሀራይ አቶ እስራኤልያ አሳዉ ኦይደን ኩሽያ ኦን</para>
  <para style="q2" vid="NUM 23:10">ፓይዳናዉ ዳንዳዪ?</para>
  <para style="q1" vid="NUM 23:10">ታ ሀይቁ ጽሎቱዋ ሀይቁዋ ማላ ግዶ፤</para>
  <para style="q2" vid="NUM 23:10">ታ ደኡዋ ዉርሰይካ ኡንቱንቱዋዳን ሀኖ!” ያጌዳ።<verse eid="NUM 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 23:11"/>ባላቅ ባላማ፥ “ኔን ታ ቦላ ኦያባይ አዬ? ታን ኔና ታ ሞርከቱዋ ሸቃናዳን አሃድ፤ ሽን ኔን ኡንቱንታ አንጃዳፐ አትና፥ ሀራባ አይነ ኦባካ!” ያጌዳ።<verse eid="NUM 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 23:12"/>ባላም ዛሪደ፥ “ታን መና ጎዳይ ታና ሃሳይስያዋፐ ሀራ ሃሳዮየ?” ያጌዳ።<verse eid="NUM 23:12"/></para>
  <para style="s1">ባላማ ላኤን ትምቢትያ</para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 23:13"/>ሄዋፐ ጉይያን፥ ባላቅ አ፥ “ኡንቱንቱ ኔን በአናዉ ዳንዳይያ ሀራሳ ታናና ደንዳ። ኔን ኡንቱንቱፐ አማሬዳዋ በአናፐ አትና፥ ኡንቱንታ ኡባ በአካ። ኔን ሄዋን ታዉ ኡንቱንታ ሸቃርኪ” ያጌዳ። <verse eid="NUM 23:13"/><verse number="14" style="v" sid="NUM 23:14"/>ፕስጋ ግያ ደርያ ሁጲያን ደእያ ጾፊማ ደምባ አኪደ አፌዳ። ሄዋን ላፑን ያርሽያ ሳኣ ግምቤዳ፤ እት እት ያርሽያ ሳኣን እት ኮሩማ ቦራነ እት ዶርሳ ኦርግያ ያርሼዳ።<verse eid="NUM 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 23:15"/>ባላም ባላቃ፥ “ታን ህንና ጾሳና ጋከትያ ዎደ፥ ኔን ሀዋን ነ ጹግያ ያርሹዋ ማታን ኤቃሻ” ያጌዳ።<verse eid="NUM 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 23:16"/>መና ጎዳይ ባላማና ጋከቲደ ኪቲደ፥ “ኔን ባላቃኮ ስማደ፥ አዉ ሀ ትምቢትያ ኦዳ” ያጌዳ።<verse eid="NUM 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 23:17"/>እ አኮ ስሚደ፥ ባረ ጹግያ ያርሹዋ ማታን ሞኣባ ቢታ ካፓቱና ኤቄዳዋ ደሜዳ። ባላቅ አ፥ “መና ጎዳይ ኦድያባይ አዬ?” ያጌዳ።<verse eid="NUM 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 23:18"/>ባላም ባረ ትምቢትያ ሀዋዳን ያጊደ ኦዴዳ፤</para>
  <para style="q1" vid="NUM 23:18">“ጽፖራ ናኣ ባላቃ ደንዳ ስሳ፤</para>
  <para style="q2" vid="NUM 23:18">ታን ኦድያዋ ስሳ!<verse eid="NUM 23:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 23:19"/>ጾሳይ ዎርዶታናዉ አሳ ግደና፤</para>
  <para style="q2" vid="NUM 23:19">ባረ ቆፋ ላማናዉ እ አሳ ናኣ ግደና።</para>
  <para style="q1" vid="NUM 23:19">እ ኦዲደ፥ ባረ ኦዴዳዋ ኦኔ?</para>
  <para style="q2" vid="NUM 23:19">ዎይ እ ባረ ጌዳዋ ፖለኔ?<verse eid="NUM 23:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="NUM 23:20"/>ታን አንጃናዉ አዛዙዋ አካድ።</para>
  <para style="q2" vid="NUM 23:20">እ አንጅ ክቼዳ፤</para>
  <para style="q2" vid="NUM 23:20">ታን ሄዋ ላማናዉ ዳንዳይከ።<verse eid="NUM 23:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="NUM 23:21"/>ያቆባ ዛርያዉ ኢታባይ ያናባይ፥</para>
  <para style="q2" vid="NUM 23:21">እስራኤልያ አሳዉ መቱ ጋካናባይ ታዉ ቤትቤና።</para>
  <para style="q2" vid="NUM 23:21">መና ጎዳይ ኡንቱንቱ ጾሳይ ኡንቱንቱና ደኤ፤</para>
  <para style="q2" vid="NUM 23:21">እ ኡንቱንቶ ካትያ ግድያዋ አዋዪኖ።<verse eid="NUM 23:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 23:22"/>ጾሳይ ኡንቱንታ ግብጼፐ ከሴዳ፤</para>
  <para style="q2" vid="NUM 23:22">እ ምኖ መንዳን ኡንቱንቶ ደኤ።<verse eid="NUM 23:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="NUM 23:23"/>ያቆባ ቦላ ጋካና ብታይ ባዋ፤</para>
  <para style="q2" vid="NUM 23:23">እስራኤልያ አሳ ቆሀና ሙሩኑካ ባዋ።</para>
  <para style="q1" vid="NUM 23:23">አሳይ ሀእ፥ ‘ያቆባዉነ እስራኤላዉ ጾሳይ ኦዳዋ በእተ’ ያጋና።<verse eid="NUM 23:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 23:24"/>ሀ አሳይ ማጫ ጋማትዳን ደንዴዳ።</para>
  <para style="q2" vid="NUM 23:24">ባረ ኦይቄዳዋ ማና ጋካናዉነ፥</para>
  <para style="q2" vid="NUM 23:24">ባረ ዎዳዋ ሱ ኡሻና ጋካናዉ፥</para>
  <para style="q2" vid="NUM 23:24">ሸምፐና ጋሙዋዳን ኡንቱንቱ ኤቂ ደንድኖ” ያጌዳ።<verse eid="NUM 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 23:25"/>ሄዋፐ ጉይያን፥ ባላቅ ባላማ፥ “ኔን ኡንቱንታ ሙለካ ሸቆፓነ ሙለካ አንጆፓ” ያጌዳ።<verse eid="NUM 23:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 23:26"/>ባላም ዛሪደ፥ “መና ጎዳይ ግያዋ ኡባ ኦና ጋደ ታን ነዉ ኦዳበይክታ?” ያጌዳ።<verse eid="NUM 23:26"/></para>
  <para style="s1">ባላማ ሄዘን ትምቢትያ</para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 23:27"/>ሄዋፐ ጉይያን፥ ባላቅ ባላማ፥ “ሃያ፤ ታን ኔና ሀራሳ አፋና። ኦን ኤሪ፥ ኔና ያ አፍና ጾሳይ ናሸቲደ፥ ኔና ኡንቱንታ ታዉ ሸቅሳነንቶ” ያጌዳ። <verse eid="NUM 23:27"/><verse number="28" style="v" sid="NUM 23:28"/>ባላቅ ባላማ መላ ቢታ ቦላና ዱገ ጼልያ ፓኦራ ደርያ ሁጲያ አፌዳ።<verse eid="NUM 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 23:29"/>ባላም፥ “ኔን ሀዋን ታዉ ላፑን ያርሽያ ሳኣ ግምባ፤ ቃይ ላፑን ኮሩማ ቦራቱዋነ ላፑን ዶርሳ ኦርገቱዋ ታዉ ጊግሳ” ያጌዳ። <verse eid="NUM 23:29"/><verse number="30" style="v" sid="NUM 23:30"/>ባላም ጌዳዋዳን ባላቅ ኦዳ፤ እት እት ያርሽያ ሳኣን እት ኮሩማ ቦራነ እት ዶርሳ ኦርግያ ያርሼዳ።<verse eid="NUM 23:30"/></para>
  <chapter eid="NUM 23"/>
  <chapter number="24" style="c" sid="NUM 24"/>
  <para style="p">
    <verse number="1" style="v" sid="NUM 24:1"/>እስራኤልያ አንጅያዌ መና ጎዳ ናሸቼዳዋ ባላም በኤዳ ዎደ፥ ካሰ እ ኦዳዋዳን ሙሩናናዉ ኮይቤና፤ ሽን ባረ ሶምኡዋ መላ ቢታኮ ዛሬዳ። <verse eid="NUM 24:1"/><verse number="2" style="v" sid="NUM 24:2"/>ያቲዴ ቁ ጊ ጼሊደ፥ እስራኤልያ አሳይ ባረ ዛርያን ዛርያን ዱንካን ኡቴዳዋ በኤዳ፤ ጾሳ አያናይ አ ቦላ ዎዳ። <verse eid="NUM 24:2"/><verse number="3" style="v" sid="NUM 24:3"/>እ ባረ ትምቢትያ ሀዋዳን ያጊደ ኦዴዳ፤</para>
  <para style="q1" vid="NUM 24:3">“ብኦራ ናኣ ባላማ ትምቢቲ፥</para>
  <para style="q2" vid="NUM 24:3">አ አይፊ ትሽ ኦ ጼልያዋ ትምቢቲ፥<verse eid="NUM 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NUM 24:4"/>ጾሳይ ግያዋ ስስያዋ ትምቢቲ፥</para>
  <para style="q2" vid="NUM 24:4">ልጭ ጊደ ጉፋንና፥</para>
  <para style="q1" vid="NUM 24:4">አ አይፊ ዶየቴዳዋነ</para>
  <para style="q2" vid="NUM 24:4">ኡባ ዳንዳይያ ጾሳ ሳፃ በእያዋ ትምቢቲ ሀዋ።<verse eid="NUM 24:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="NUM 24:5"/>ያቆባ ዛረቶ፥ ህንተ ዱንካነቱ፥</para>
  <para style="q2" vid="NUM 24:5">እስራኤልያ አሳዉ፥ ህንተ ደእያ ሳአቱካ፥</para>
  <para style="q2" vid="NUM 24:5">ዎት ሎኤ!<verse eid="NUM 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NUM 24:6"/>ኡንቱንቱ ምጨቴዳ ዎምባዳን፥</para>
  <para style="q2" vid="NUM 24:6">ሻፋ ዶናን ደእያ አታክልትያ ሳኣዳን፥</para>
  <para style="q1" vid="NUM 24:6">መና ጎዳይ ቶኬዳ ጎዳረ ኡዳንነ</para>
  <para style="q2" vid="NUM 24:6">ሃ ዶናን ደእያ ዝጋዳን ሀኒኖ።<verse eid="NUM 24:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 24:7"/>ኡንቱንቶ ዳሮ ሃይ ፑልታና፤</para>
  <para style="q2" vid="NUM 24:7">ኡንቱንቱ ዛረቶ ግድያ ሃይ ደአና።</para>
  <para style="q1" vid="NUM 24:7">ኡንቱንቱ ካቲ ካትያ አጋጋፐ ግታታና፤</para>
  <para style="q2" vid="NUM 24:7">ኡንቱንቱ ካዉተይካ ቦንቼታና።<verse eid="NUM 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 24:8"/>ጾሳይ ኡንቱንታ ግብጼፐ ከሴዳ፤</para>
  <para style="q2" vid="NUM 24:8">እ ምኖ መንዳን ኡንቱንቶ ደኤ።</para>
  <para style="q2" vid="NUM 24:8">ኡንቱንቱ ሞርከ ካዉተ ምታና፤</para>
  <para style="q2" vid="NUM 24:8">ኡንቱንቱ መቀካ ሊቅሳና፤</para>
  <para style="q2" vid="NUM 24:8">ኡንቱንቱ ባረንቱ ዎንዳፍያ ዙቢያን ኡንቱንታ ጫዳና።<verse eid="NUM 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 24:9"/>እስራኤልያ አሳይ ጋሙዋዳን ግሴ።<note caller="-" style="x"><char style="xo" closed="false">24:9 </char><char style="xt" closed="false"><ref loc="GEN 12:3">ዶመ 12:3</ref>፤ <ref loc="GEN 49:9">49:9</ref></char></note></para>
  <para style="q2" vid="NUM 24:9">ማጫ ጋማትዳን ኡንቱንታ ደንናዉ ኦን ጻላኔ?</para>
  <para style="q1" vid="NUM 24:9">ህንተና አንጅያ ኡባይ አንጀቴዳዋ ግዳናዋ፤</para>
  <para style="q2" vid="NUM 24:9">ህንተና ሸቂያ ኡባይ ሸቀቴዳዋ ግዳናዋ” ያጌዳ።<verse eid="NUM 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 24:10"/>ሄዋፐ ጉይያን፥ ባላቅ ባላማ ቦላ ሀንቁዋ ኤጽ ከሴዳ። ባላቅ ባረ ኩሽያ ዱኪደ ባላማ፥ “ታ ሞርከቱዋ ቃንጋናዳን ታን ኔና ጼሳድ፤ ሽን ኔን ሀ ሄዙ ገደካ ኡንቱንታ አንጃዳ። <verse eid="NUM 24:10"/><verse number="11" style="v" sid="NUM 24:11"/>ስም ሀእ ኔን ነ ጎለ ባቃታ፤ ‘ታን ነዉ ዳሮባ ዎይታና’ ጋድ፤ ሽን ኔን ዎይቱዋ አከናዳን መና ጎዳይ ኔና ድጌዳ” ያጌዳ።<verse eid="NUM 24:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 24:12"/>ባላም ባላቃ ዛሪደ፥ “ኔን ታኮ ኪቴዳዋንቱነ፥ <verse eid="NUM 24:12"/><verse number="13" style="v" sid="NUM 24:13"/>‘ባላቅ ሀራይ አቶ ባረ ብራይነ ዎርቃይ ኩሜዳ ባረ ካትያ ጎልያ ታዉ እሜዳዋ ግድንቶነ፥ መና ጎዳይ ኦዴዳዋ አደ፥ ሎኡዋ ዎይ ኢታ ታ ሸንያን ኦናዉ ዳንዳይከ። ታን መና ጎዳይ ግያዋ ጻላላ ጋና’ ያጋደ ነዉ ኦዳበይክታየ?” ያጌዳ።<verse eid="NUM 24:13"/></para>
  <para style="s1">ባላማ ዉርሰ ትምቢትያ</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 24:14"/>ያጊደ፥ “ታን ሀእ ታ አሳኮ ባይ፤ ሽን ኔን ሃያ፤ ሀ አሳይ ዉርሰ ዎድያን ነ አሳ ኦናዋ ታን ነዉ ኦዳና” ያጌዳ። <verse eid="NUM 24:14"/><verse number="15" style="v" sid="NUM 24:15"/>እ ባረ ትምቢትያ ሀዋዳን ያጊደ ኦዴዳ፤</para>
  <para style="q1" vid="NUM 24:15">“ብኦራ ናኣ ባላማ ትምቢቲ፥</para>
  <para style="q2" vid="NUM 24:15">አ አይፊ ትሽ ኦደ ጼልያዋ ትምቢቲ፥<verse eid="NUM 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="NUM 24:16"/>ጾሳይ ግያዋ ስስያዋነ፥</para>
  <para style="q2" vid="NUM 24:16">ኡባፐ ቂያ ጾሳፐ</para>
  <para style="q2" vid="NUM 24:16">ግዴዳ ኤራተይ ደእያዋ ትምቢቲ፥</para>
  <para style="q2" vid="NUM 24:16">ልጵ ጊደ ጉፋንና፥</para>
  <para style="q2" vid="NUM 24:16">አ አይፊ ዶየቴዳዋነ</para>
  <para style="q2" vid="NUM 24:16">ኡባ ዳንዳይያ ጾሳ ሳፃ በእያዋ ትምቢቲ ሀዋ።<verse eid="NUM 24:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="NUM 24:17"/>ታን አ በአይ፤ ሽን ዎዲ ሀአ ግደና፤</para>
  <para style="q2" vid="NUM 24:17">ታን አ ጼላይ፤ ሽን ማታን ግደና።</para>
  <para style="q1" vid="NUM 24:17">ያቆባ ዛርያፐ ጾልንቲ ከሳና።</para>
  <para style="q2" vid="NUM 24:17">እስራኤልያፐ ካተቱዋ ጻምአይ ከሳና።</para>
  <para style="q1" vid="NUM 24:17">ሞኣባ አሳ ሶምኡዋ እ ጋጭ ቆላና።</para>
  <para style="q2" vid="NUM 24:17">ሴተ አሳ ኡባ ሁጲያ እ ክንቻና።<verse eid="NUM 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 24:18"/>ኤዶም ጾነታና፤</para>
  <para style="q2" vid="NUM 24:18">አ ሞርኪ ሰኢርካ ጾነታና፤</para>
  <para style="q1" vid="NUM 24:18">ሽን እስራኤሊ ምን ምኒደ ባና።<verse eid="NUM 24:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 24:19"/>ያቆባፐ ሞድያዌ ከሳና፤</para>
  <para style="q2" vid="NUM 24:19">ኡንቱንቱ ካታማን ፓጻ አቴዳዋንታ ይሳና” ያጌዳ።<verse eid="NUM 24:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 24:20"/>ሄዋፐ ጉይያን፥ ባላም አማሌቃ አሳቱዋ በኢደ፥ ባረ ትምቢትያ ሀዋዳን ያጊደ ኦዴዳ፤</para>
  <para style="b" vid="NUM 24:20"/>
  <para style="q1" vid="NUM 24:20">“ካዉተቱዋ ግዶን አማሌቅ ኮይሮ፤</para>
  <para style="q2" vid="NUM 24:20">ሽን ኡንቱንቱ ዉርሰይ ዮ” ያጌዳ።<verse eid="NUM 24:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 24:21"/>ቃይ ባላም ቄና አሳቱዋ በኢደ፥ ባረ ትምቢትያ ሀዋዳን ያጊደ ኦዴዳ፤</para>
  <para style="q1" vid="NUM 24:21">“ህንተ ደእያ ሳአይ ሳሮ ሳ ግዴ፤</para>
  <para style="q2" vid="NUM 24:21">ህንተ ጎሊ ዛላ ቦላን ኬጸቴዳ።<verse eid="NUM 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 24:22"/>ሽን አሶረቱ ህንተና ኦሞድያ ዎደ፥</para>
  <para style="q2" vid="NUM 24:22">ህንተ ቄና አሳቱ ያና” ያጌዳ።<verse eid="NUM 24:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 24:23"/>ሄዋፐ ጉይያን፥ ባላም ባረ ትምቢትያ ሀዋዳን ያጊደ ኦዴዳ፤</para>
  <para style="q1" vid="NUM 24:23">“አየ አና!</para>
  <para style="q2" vid="NUM 24:23">ጾሳይ ሀዋ ኦያ ዎደ፥</para>
  <para style="q2" vid="NUM 24:23">ኦን ደአና ዳንዳዪ?<verse eid="NUM 24:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 24:24"/>ማርካባቱ ክቲማ ሀሩሩዋፐ ያና፤</para>
  <para style="q2" vid="NUM 24:24">ኡንቱንቱ አሶረቱዋነ ኤቤራቱዋ ኡቁናና፤</para>
  <para style="q1" vid="NUM 24:24">ሽን ቃይ ኡንቱንቱካ ያና” ያጌዳ።<verse eid="NUM 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 24:25"/>ሄዋፐ ጉይያን፥ ባላም ደንዲደ፥ ባረ ጎለ ስሜዳ፤ ባላቅካ ባረ ኦግያ ቤዳ።<verse eid="NUM 24:25"/></para>
  <chapter eid="NUM 24"/>
  <chapter number="25" style="c" sid="NUM 25"/>
  <para style="s1">እስራኤላቱ ፓኦራ ግያ ሳን ናጋራ ኦድኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 25:1"/>እስራኤላቱ ሺጽማ ግያ ሳን ዱንካኔዳ ዎደ፥ አሳይ ሞኣባ ቢታ ማቼቱዋና ሻርሙጹዋ ዶሜዳ። <verse eid="NUM 25:1"/><verse number="2" style="v" sid="NUM 25:2"/>ሄ ማጫ አሳቱ ባረንቱ ጾሳቱዋ ያርሹዋ ማናዉ ኡንቱንታ ሾቤድኖ፤ ኡንቱንቱ ሚደ፥ ኡንቱንቱ ጾሳቶ ጎይኔድኖ። <verse eid="NUM 25:2"/><verse number="3" style="v" sid="NUM 25:3"/>እስራኤላቱ ፓኦራ ባኣላ ግያ ኤቃ ካሌዳ ድራዉ፥ መና ጎዳ ሀንቁ ኡንቱንቱ ቦላን ኤጽ ከሴዳ። <verse eid="NUM 25:3"/><verse number="4" style="v" sid="NUM 25:4"/>ያትና መና ጎዳይ ሙሳ፥ “መና ጎዳ ሀንቁ እስራኤልያፐ ዎራ ስማና ማላ፥ ሀ አሳ ካለያዋንታ ኡባ አፋደ፥ ሴታ ጋላስ መና ጎዳ ስንን ካቃ” ያጌዳ። <verse eid="NUM 25:4"/><verse number="5" style="v" sid="NUM 25:5"/>ሙሴ እስራኤልያ ዳናቱዋ፥ “ፓኦራ ባኣላ ግያ ኤቃዉ ጎይኔዳ ህንተ አሳ ኡባ ህንተ ሁጲያን ሁጲያን ዎተ” ያጌዳ።<verse eid="NUM 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 25:6"/>ሙሴነ እስራኤልያ ማባራይ ኡባይ ጋከትያ ዱንካንያ ፐንግያን ዬክሽን፥ እስራኤላቱዋፐ እቱ ምድያማ ቢታ ምሽራቶ ኡንቱንቱ ስንና አደ፥ ባረ ጎልያ አሳኮ አሄዳ። <verse eid="NUM 25:6"/><verse number="7" style="v" sid="NUM 25:7"/>ቄስያ አሮና ናኣ ኤልኣዛራ ናአይ ፒንሃስ ሄዋ በኤዳ ዎደ፥ ማባራ ግዶፐ ደንዲደ፥ ቶራ ባረ ኩሽያን ኦይቂደ፥ <verse eid="NUM 25:7"/><verse number="8" style="v" sid="NUM 25:8"/>ሄ እስራኤልያ ብታንያ ካሊደ፥ ዱንካንያ ግዶ ገሌዳ። እስራኤልያ ብታንያነ ምሽራቶነ ላኡዋካ ቶራን ጫዲደ፥ ካን ከሴዳ። ሄዋዳን ሀንና፥ ቦሻይ እስራኤላቱዋፐ ቃረቴዳ፤ <verse eid="NUM 25:8"/><verse number="9" style="v" sid="NUM 25:9"/>ሽን ሄ ቦሻን ሀይቄዳ አሳይ ላታማነ ኦይዱ ሻአ።<verse eid="NUM 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 25:10"/>ሄዋፐ ጉይያን፥ መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="NUM 25:10"/><verse number="11" style="v" sid="NUM 25:11"/>“ቄስያ አሮና ናኣ ኤልኣዛራ ናአይ ፒንሃስ እስራኤልያ አሳ ግዶን ታን ታ ቦንቾ ምሸትያዋዳን ምሸቴዳ ድራዉ፥ ኡንቱንቱ ቦላ ታን ሀንቀቴዳ ሀንቁ ዶቼዳ፤ ታንካ ኡንቱንታ ታ ሀንቁዋን ይሳበይከ። <verse eid="NUM 25:11"/><verse number="12" style="v" sid="NUM 25:12"/>ሄዋ ድራዉ፥ ታን ታ ሳሮተ ጫቁዋ አናና ጫቀትያዋ ፒንሃሳዉ ኔን ኦዳ። <verse eid="NUM 25:12"/><verse number="13" style="v" sid="NUM 25:13"/>እ ባረ ጾሳ ቦንቾ ምሸቴዳ ግሻዉነ እስራኤልያ አሳዉ አቶ ጊሴዳ ድራዉ፥ እነ አ ዘረቱ መናዉ ቄሰ ግዳናዋ” ያጌዳ።<verse eid="NUM 25:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 25:14"/>ምድያማ ቢታ ምሽራትና ዎዳ እስራኤልያ ብታንያ ሱንይ ሳሉ ናኣ ዝምራ፤ ሳሉ ስሞና ዛራቱዋን እት ያራ ካፑዋ። <verse eid="NUM 25:14"/><verse number="15" style="v" sid="NUM 25:15"/>ሀይቄዳ ምድያማ ቢታ ምሽራት ሱንይ ኮዝቦ፤ እ አዉ ጹር ምድያማቱ ያራ ካፑዋ።<verse eid="NUM 25:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 25:16"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="NUM 25:16"/><verse number="17" style="v" sid="NUM 25:17"/>“ምድያማ ቢታ አሳቱዋ ሞርክተ፤ ኡንቱንታ ዎተ። <verse eid="NUM 25:17"/><verse number="18" style="v" sid="NUM 25:18"/>አያዉ ጎፐ፥ ኡንቱንቱ ህንተና ፓኦራን ጭሚደ፥ ህንተዉ ሞርከ ግዴድኖ፤ ቃይ ቦሻ ጋላስ ፓኦራን ዎዳ ምሽራት፥ ምድያማቱ ያራ ካፑዋ ናት ኮዝብ ጋሱዋን ኡንቱንቱ ህንተና ሞርኬድኖ” ያጌዳ።<verse eid="NUM 25:18"/></para>
  <chapter eid="NUM 25"/>
  <chapter number="26" style="c" sid="NUM 26"/>
  <para style="s1">ላኤን እስራኤልያ አሳ ፓይዱዋባ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 26:1"/>ቦሻፐ ጉይያን፥ መና ጎዳይ ሙሳነ ቄስያ አሮና ናኣ ኤልኣዛራ፥<note caller="-" style="x"><char style="xo" closed="false">26:1 </char><char style="xt" closed="false"><ref loc="NUM 1:1-46">ፓይ. 1:1-46</ref></char></note> <verse eid="NUM 26:1"/><verse number="2" style="v" sid="NUM 26:2"/>“የለቶደፐ ላታሙ ላይነ ሄዋፐ ቦላና ደእያ እስራኤላቱዋ፥ ኦላዉ ባናዉ ዳንዳይያዋንታ ኡባቱዋ፥ ኡንቱንቱ ጎልያን ጎልያን ፓይድተ” ያጌዳ።<verse eid="NUM 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 26:3"/>ሙሴነ ቄሲ ኤልኣዛር ዮርዳኖሳ ሻፋፐ ሄፍን ባጋና፥ እያርኮ ማታን፥ ሞኣባ ደምባን ኡንቱንቱና ሃሳዪደ፥ <verse eid="NUM 26:3"/><verse number="4" style="v" sid="NUM 26:4"/>“መና ጎዳይ ሙሳ አዛዜዳዋዳን፥ የለቶደፐ ላታሙ ላይነ ሄዋፐ ቦላና ደእያ አሳ ፓይድተ” ያጌድኖ።</para>
  <para style="p" vid="NUM 26:4">ግብጼፐ ከሴዳ እስራኤላቱ ሀዋንታ፦<verse eid="NUM 26:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 26:5"/>እስራኤልያ ባይራ ናኣ ሮቤላ ዛራቱ: ሀኖካ ያራቱዋ፥ ፓሉ ያራቱዋ፥ <verse eid="NUM 26:5"/><verse number="6" style="v" sid="NUM 26:6"/>ሄጽሮና ያራቱዋነ ካርማ ያራቱዋ። <verse eid="NUM 26:6"/><verse number="7" style="v" sid="NUM 26:7"/>ሀዋንቱ ሮቤላ ዛራቱዋ፤ ኡንቱንቱ ኡባና 43,730። <verse eid="NUM 26:7"/><verse number="8" style="v" sid="NUM 26:8"/>ፓሉ ናአይ ኤልኣባ፤ <verse eid="NUM 26:8"/><verse number="9" style="v" sid="NUM 26:9"/>ኤልኣባ አቱማ ናናይ ነሙኤላ፥ ዳታናነ አቢራማ፤ ሀ ዳታንነ አቢራም ማባራይ ዶሬዳዋንታ። ኡንቱንቱ ቆራሀነ አ ካልያዋንቱና ዙፐቲደ፥ ሙሴ ቦላ፥ አሮና ቦላነ መና ጎዳ ቦላ ማካሌድኖ። <verse eid="NUM 26:9"/><verse number="10" style="v" sid="NUM 26:10"/>ቢታይ ዶየቲደ፥ ኡንቱንታ ቆራሃና እትፐ ምቴዳ፤ ኡንቱንታ ካልያ ላኡ ጼታነ እሻታሙ አሳ ታማይ ሚና ሀይቄድኖ። ያትና ኡንቱንቱ አሳይ በኢደ ዱጽያ ማላታ ግዴድኖ። <verse eid="NUM 26:10"/><verse number="11" style="v" sid="NUM 26:11"/>ሽን ቆራሀ አቱማ ናናይ ሄ ጋላስ ሀይቂበይክኖ።<verse eid="NUM 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 26:12"/>ስሞና ዛራቱ ባረንቱ ያራን ያራን: ነሙኤላ ያራቱዋ፥ ያሚና ያራቱዋ፥ ያኪና ያራቱዋ፥ <verse eid="NUM 26:12"/><verse number="13" style="v" sid="NUM 26:13"/>ዛራሀ ያራቱዋነ ሻኡላ ያራቱዋ። <verse eid="NUM 26:13"/><verse number="14" style="v" sid="NUM 26:14"/>ሀዋንቱ ስሞና ዛራቱዋ፤ ኡንቱንቱ ኡባና 22,200።<verse eid="NUM 26:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 26:15"/>ጋዳ ዛራቱ ባረንቱ ያራን ያራን: ጻፎና ያራቱዋ፥ ሀጋ ያራቱዋ፥ ሹና ያራቱዋ፥ <verse eid="NUM 26:15"/><verse number="16" style="v" sid="NUM 26:16"/>ኦዝና ያራቱዋ፥ ኤራ ያራቱዋ፥ <verse eid="NUM 26:16"/><verse number="17" style="v" sid="NUM 26:17"/>አሮዳ ያራቱዋነ አርኤላ ያራቱዋ። <verse eid="NUM 26:17"/><verse number="18" style="v" sid="NUM 26:18"/>ሀዋንቱ ጋዳ ዛራቱዋ፤ ኡንቱንቱ ኡባና 40,500።<verse eid="NUM 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 26:19"/>ይሁዳ አቱማ ናናይ ኤራነ ኦናና፤ ሽን ኡንቱንቱ ካናነ ጋድያን ሀይቄድኖ። <verse eid="NUM 26:19"/><verse number="20" style="v" sid="NUM 26:20"/>ይሁዳ ዛራቱ ባረንቱ ያራን ያራን: ሼላ ያራቱዋ፥ ፓሬሳ ያራቱዋነ ዛራሀ ያራቱዋ። <verse eid="NUM 26:20"/><verse number="21" style="v" sid="NUM 26:21"/>ፓሬሳ ዛራቱ ሄጽሮና ያራቱዋነ ሀሙላ ያራቱዋ። <verse eid="NUM 26:21"/><verse number="22" style="v" sid="NUM 26:22"/>ሀዋንቱ ይሁዳ ዛራቱዋ፤ ኡንቱንቱ ኡባና 76,500።<verse eid="NUM 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 26:23"/>ይሳኮራ ዛራቱ ባረንቱ ያራን ያራን: ቶላአ ያራቱዋ፥ ፑዋ ያራቱዋ፥ <verse eid="NUM 26:23"/><verse number="24" style="v" sid="NUM 26:24"/>ያሹባ ያራቱዋነ ሽምሮና ያራቱዋ። <verse eid="NUM 26:24"/><verse number="25" style="v" sid="NUM 26:25"/>ሀዋንቱ ይሳኮራ ዛራቱዋ፤ ኡንቱንቱ ኡባና 64,300።<verse eid="NUM 26:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 26:26"/>ዛብሎና ዛራቱ ባረንቱ ያራን ያራን: ሰሬዳ ያራቱዋ፥ ኤሎና ያራቱዋነ ያህላኤላ ያራቱዋ። <verse eid="NUM 26:26"/><verse number="27" style="v" sid="NUM 26:27"/>ሀዋንቱ ዛብሎና ዛራቱዋ፤ ኡንቱንቱ ኡባና 60,500።<verse eid="NUM 26:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 26:28"/>ምናሰነ ኤፍሬማ አዉዋ ዮሴፎ ዛራቱ ሀዋፐ ካሊደ ጻፈቴድኖ። <verse eid="NUM 26:28"/><verse number="29" style="v" sid="NUM 26:29"/>ምናሰ ዛራቱ ምናሰ ናኣ ማኪራ ያራቱዋ፥ ማኪር ናኣ ጋላኣደ ያራቱዋነ ጋላኣደ ናናቱ ያራቱዋ። <verse eid="NUM 26:29"/><verse number="30" style="v" sid="NUM 26:30"/>ጋላኣደ ዛራቱ እኤዘራ ያራቱዋ፥ ሄሌቃ ያራቱዋ፥ <verse eid="NUM 26:30"/><verse number="31" style="v" sid="NUM 26:31"/>አስርኤላ ያራቱዋ፥ ሸኬማ ያራቱዋ፥ <verse eid="NUM 26:31"/><verse number="32" style="v" sid="NUM 26:32"/>ሻምዳአ ያራቱዋነ ሄፌራ ያራቱዋ። <verse eid="NUM 26:32"/><verse number="33" style="v" sid="NUM 26:33"/>ሄፌራ ናአይ ጻሎፍሃድ ማጫ ናናቱ ጻላላ የሌዳ፤ አዉ አቱማ ናእ ባዋ። ጻሎፍሃዳ ማጫ ናናቱ ሱንይ ማህሎ፥ ኖኦ፥ ሆግሎ፥ ምልኮነ ትርጾ። <verse eid="NUM 26:33"/><verse number="34" style="v" sid="NUM 26:34"/>ሀዋንቱ ምናሰ ዛራቱዋ፤ ኡንቱንቱ ኡባና 52,700።<verse eid="NUM 26:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 26:35"/>ኤፍሬማ ዛራቱ ባረንቱ ያራን ያራን: ሹተላሀ ያራቱዋ፥ በኬራ ያራቱዋ፥ ታሃና ያራቱዋነ <verse eid="NUM 26:35"/><verse number="36" style="v" sid="NUM 26:36"/>ሹተላሀ ናኣ ኤራና ያራቱዋ። <verse eid="NUM 26:36"/><verse number="37" style="v" sid="NUM 26:37"/>ሀዋንቱ ኤፍሬማ ዛራቱዋ፤ ኡንቱንቱ ኡባና 32,500። ዮሴፎ ዛራቱ ባረንቱ ያራን ያራን ሄዋንታ።<verse eid="NUM 26:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 26:38"/>ቢንያማ ዛራቱ ባረንቱ ያራን ያራን: በላአ ያራቱዋ፥ አሽቤላ ያራቱዋ፥ አህራማ ያራቱዋ፥ <verse eid="NUM 26:38"/><verse number="39" style="v" sid="NUM 26:39"/>ሻፉፋማ ያራቱዋ፥ ሁፋማ ያራቱዋ፥ <verse eid="NUM 26:39"/><verse number="40" style="v" sid="NUM 26:40"/>በላአ ናኣ አራዳ ያራቱዋነ በላአ ናኣ ናእማና ያራቱዋ። <verse eid="NUM 26:40"/><verse number="41" style="v" sid="NUM 26:41"/>ሀዋንቱ ቢንያማ ዛራቱዋ፤ ኡንቱንቱ ኡባና 45,600።<verse eid="NUM 26:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 26:42"/>ዳና ዛራቱ ሹሃማ ያራቱዋ። <verse eid="NUM 26:42"/><verse number="43" style="v" sid="NUM 26:43"/>ሹሃማ ያራቱ ኡባና 64,400።<verse eid="NUM 26:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 26:44"/>አሴራ ዛራቱ ባረንቱ ያራን ያራን: ይምና ያራቱዋ፥ ይሽዋሀ ያራቱዋ፥ ባሪአ ያራቱዋ፥ <verse eid="NUM 26:44"/><verse number="45" style="v" sid="NUM 26:45"/>ባሪአ ናኣ ሄቤራ ያራቱዋነ ባሪአ ናኣ ማልክኤላ ያራቱዋ። <verse eid="NUM 26:45"/><verse number="46" style="v" sid="NUM 26:46"/>አሴራዉ ሰራሆ ግያ ማጫ ናታ ደአዉ። <verse eid="NUM 26:46"/><verse number="47" style="v" sid="NUM 26:47"/>ሀዋንቱ አሴራ ዛራቱዋ፤ ኡንቱንቱ ኡባና 53,400።<verse eid="NUM 26:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 26:48"/>ንፍታሌማ ዛራቱ ባረንቱ ያራን ያራን: ያእዝኤላ ያራቱዋ፥ ጉና ያራቱዋ፥ <verse eid="NUM 26:48"/><verse number="49" style="v" sid="NUM 26:49"/>የጼራ ያራቱዋነ ሽሌማ ያራቱዋ። <verse eid="NUM 26:49"/><verse number="50" style="v" sid="NUM 26:50"/>ሀዋንቱ ንፍታሌማ ዛራቱዋ፤ ኡንቱንቱ ኡባና 45,400።<verse eid="NUM 26:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="NUM 26:51"/>ፓይደቴዳ እስራኤልያ አቱማ አሳይ ኡባና 601,730።<verse eid="NUM 26:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="NUM 26:52"/>ቃይካ መና ጎዳይ ሙሳ፥<note caller="-" style="x"><char style="xo" closed="false">26:52-56 </char><char style="xt" closed="false"><ref loc="NUM 34:13">ፓይ. 34:13</ref>፤ <ref loc="JOS 14:1-2">ኢያሳ 14:1-2</ref></char></note> <verse eid="NUM 26:52"/><verse number="53" style="v" sid="NUM 26:53"/>“ሀ ዛረቶ ኡንቱንቱ ሱን ሱን ፓይዱዋዳን ቢታይ ሻከቲደ፥ ላታ ግዲደ ኡንቱንቶ እመቶ። <verse eid="NUM 26:53"/><verse number="54" style="v" sid="NUM 26:54"/>ፓይዱዋን ጮራቶ ኡንቱንቱ ጮራተ ኬና፥ ፓይዱዋን ጉቶ ኡንቱንቱ ጉተ ኬና ሻካደ እማ። ኡባይካ ጻፈቴዳ ባረንቱ ፓይዱዋ ኬና ኬና አክኖ። <verse eid="NUM 26:54"/><verse number="55" style="v" sid="NUM 26:55"/>ሽን ቢታይ ሳማን ሻከቶ፤ እት እት ዛሪ ላትያ ቢታይ ኡንቱንቱ አዉዋ ዛርያ ሱንዳን ግዶ። <verse eid="NUM 26:55"/><verse number="56" style="v" sid="NUM 26:56"/>ላታ ኡባይ ፓይዱዋን ጮራቱዋፐነ ፓይዱዋን ጉቱዋፐ ግዱዋን ኤጻን ሻከቶ” ያጌዳ።<verse eid="NUM 26:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="NUM 26:57"/>ባረ ያራን ያራን ፓይደቴዳ ሌዋቱ ሀዋንታ: ገርሾና ያራቱዋ፥ ቃሃታ ያራቱዋነ ማራራ ያራቱዋ። <verse eid="NUM 26:57"/><verse number="58" style="v" sid="NUM 26:58"/>ሀዋንቱካ ቃይ ሌዋቱዋ ያራቱዋ: ሊብና ያራቱዋ፥ ከብሮና ያራቱዋ፥ ማህላ ያራቱዋ፥ ሙሻ ያራቱዋነ ቆራሀ ያራቱዋ። ቃሃት አምራማ የሌዳ። <verse eid="NUM 26:58"/><verse number="59" style="v" sid="NUM 26:59"/>አምራማ ማቻት ሱንይ ዮከቤዶ፤ አ ግብጼን ሌዊያዉ የለቴዳ ናቶ። እዛ አምራማዉ አሮና፥ ሙሳነ ኡንቱንቱ ምቻቶ ሚርያሞ የላዱ። <verse eid="NUM 26:59"/><verse number="60" style="v" sid="NUM 26:60"/>አሮን ናዳባ፥ አቢሀ፥ ኤልኣዛራነ እታማራ የሌዳ።<note caller="-" style="x"><char style="xo" closed="false">26:60 </char><char style="xt" closed="false"><ref loc="NUM 3:2">ፓይ. 3:2</ref></char></note> <verse eid="NUM 26:60"/><verse number="61" style="v" sid="NUM 26:61"/>ሽን መና ጎዳይ አዛዝቤና ታማ አ ስንን ያርሼዳ ዎደ፥ ናዳብነ አብሁ ሀይቄድኖ።<note caller="-" style="x"><char style="xo" closed="false">26:61 </char><char style="xt" closed="false"><ref loc="LEV 10:1-2">ዎጋ 10:1-2</ref>፤ <ref loc="NUM 3:4">ፓይ. 3:4</ref></char></note> <verse eid="NUM 26:61"/><verse number="62" style="v" sid="NUM 26:62"/>የለቶደፐ እት አግናነ ሄዋፐ ቦላና ደእያ ፓይደቴዳ አቱማ ሌዋቱ ኡባና ላታማነ ሄዙ ሻአ። እስራኤላቱዋ ግዱዋን ኡንቱንቶ ላትያ ቢታይ እመትቤና ድራዉ፥ ኡንቱንቱ እስራኤላቱዋና ፓይደትበይክኖ።<verse eid="NUM 26:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="NUM 26:63"/>ዮርዳኖሳ ሻፋፐ ሄፍን ባጋና፥ እያርኮ ማታን፥ ሞኣባ ደምባን ሙሴነ ቄሲ ኤልኣዛር እስራኤላቱዋ ፓይዴዳ ዎደ፥ ፓይደቴዳ አሳይ ሀዋ። <verse eid="NUM 26:63"/><verse number="64" style="v" sid="NUM 26:64"/>ሙሴነ ቄሲ አሮን ካሰ ሲና መላ ቢታን እስራኤላቱዋ ፓይዴዳ ዎደ፥ ፓይደቴዳ አሳፐ ሀራይ አቶ መጽ እት አሳይነ አትቤና። <verse eid="NUM 26:64"/><verse number="65" style="v" sid="NUM 26:65"/>አያዉ ጎፐ፥ መና ጎዳይ ሄ እስራኤላቱዋ ኦዲደ፥ “ኡንቱንቱ መላ ቢታን ቱሙ ሀይቃና” ያግ ዎዳ። ይፉነ ናኣ ካሌባፐነ ኔዌ ናኣ ኢያሱፐ አትና፥ ሀራይ እት አሳይነ አትቤና።<note caller="-" style="x"><char style="xo" closed="false">26:65 </char><char style="xt" closed="false"><ref loc="NUM 14:26-35">ፓይ. 14:26-35</ref></char></note><verse eid="NUM 26:65"/></para>
  <chapter eid="NUM 26"/>
  <chapter number="27" style="c" sid="NUM 27"/>
  <para style="s1">ጻሎፍሃዳ ማጫ ናናቱዋ ኦሻ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 27:1"/>ጻሎፍሃዳ ማጫ ናናይ ማህሎ፥ ኖኦ፥ ሆግሎ፥ ምልኮነ ትርጾ። ጻሎፍሃድ ሄፌራ ናኣ፤ ሄፌር ጋላኣደ ናኣ፤ ጋላኣደ ማክራ ናኣ፤ ማክር ምናሰ ናኣ፤ ምናሰ ዮሴፎ ናኣ። <verse eid="NUM 27:1"/><verse number="2" style="v" sid="NUM 27:2"/>ሀ ማጫ ናናይ ጋከትያ ዱንካንያ ፐንግያን ሙሴ ስንን፥ ቄስያ ኤልኣዛራ ስንን፥ ካፓቱ ስንንነ ማባራ ኡባ ስንን ኤቂደ፥ ሀዋዳን ያጌድኖ፤ <verse eid="NUM 27:2"/><verse number="3" style="v" sid="NUM 27:3"/>“ኑ አዉ ባዙዋን ሀይቄዳ፤ እ ባረ ናጋራን ሀይቄዳፐ አትና፥ መና ጎዳ ቦላ ደንዴዳ ቆራሀ ካልያዋንቱ ግዶን ደኤና። አዉ አቱማ ናእ ባዋ። <verse eid="NUM 27:3"/><verse number="4" style="v" sid="NUM 27:4"/>አቱማ ናእ አዉ ባይናዋ ግዶፐነ፥ ኑ አዉዋ ሱንይ አ ዳቦቱዋ ግዱዋፐ አያዉ ዪ? ኑ አዉዋ እሻንቱ ግዶን ኑዉ ላትያ ቢታ እማ” ያጌድኖ።<verse eid="NUM 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 27:5"/>ሙሴ ኡንቱንቱ ኦሻ መና ጎዳ ስን ሺሼዳ። <verse eid="NUM 27:5"/><verse number="6" style="v" sid="NUM 27:6"/>መና ጎዳይ ሙሳ፥ <verse eid="NUM 27:6"/><verse number="7" style="v" sid="NUM 27:7"/>“ጻሎፍሃዳ ማጫ ናናይ ኦቼዳዌ ልከ፤ ኡንቱንቱ አዉዋ እሻንቱ ግዶን ኔን ኡንቱንቶ ላትያ ቢታ እማ፤ አ ላታይ ኡንቱንታ ጋኮ።<note caller="-" style="x"><char style="xo" closed="false">27:7 </char><char style="xt" closed="false"><ref loc="NUM 36:2">ፓይ. 36:2</ref></char></note> <verse eid="NUM 27:7"/><verse number="8" style="v" sid="NUM 27:8"/>ቃይ ኔን እስራኤላቱዋ ሀዋዳን ያጋ፤ ‘እት አሳይ አቱማ ናእ ባይናን ሀይቂያዋ ግዶፐ፥ አ ቢታ አ ማጫ ናእ ላቶ፤ <verse eid="NUM 27:8"/><verse number="9" style="v" sid="NUM 27:9"/>ማጫ ናእካ አዉ ባይናዋ ግዶፐ፥ አ ቢታ አ እሻቱ ላትኖ፤ <verse eid="NUM 27:9"/><verse number="10" style="v" sid="NUM 27:10"/>አዉ እሻቱ ባይናዋ ግዶፐ፥ አ አዉዋ እሻቱ ላትኖ፤ <verse eid="NUM 27:10"/><verse number="11" style="v" sid="NUM 27:11"/>አ አዉዋ እሻቱካ ባይናዋ ግዶፐ፥ አ ዛርያፐ ኡባፐ ማታትያ ዳቡዋ ላትሳ። ታን መና ጎዳይ ኔና ሙሳ አዛዜዳዋዳን፥ ሀዌ እስራኤላቶ ህገ ግዶ’ ያጋ” ያጌዳ።<verse eid="NUM 27:11"/></para>
  <para style="s1">ሙሴ ኮታን ኢያሱ ዶረቴዳ</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 27:12"/>ሄዋፐ ጉይያን፥ መና ጎዳይ ሙሳ፥ “ፑደ አባርማ ደረቱዋ ከሳደ፥ ታን እስራኤልያ አሳዉ እሜዳ ቢታ በአ።<note caller="-" style="x"><char style="xo" closed="false">27:12-14 </char><char style="xt" closed="false"><ref loc="DEU 3:23-27">ዛረ. 3:23-27</ref>፤ <ref loc="DEU 32:48-52">32:48-52</ref></char></note> <verse eid="NUM 27:12"/><verse number="13" style="v" sid="NUM 27:13"/>በኤዳዋፐ ጉይያን፥ ነ እሻ አሮነዳን ኔንካ ሀይቃደ፥ ነ ማይዛን ጋከታና። <verse eid="NUM 27:13"/><verse number="14" style="v" sid="NUM 27:14"/>አያዉ ጎፐ፥ ጺና ባዙዋን ደእያ ሃን አሳይ ኡባይ ማካሌዳ ዎደ፥ ህንተ ላኡካ ኡንቱንቱ ስንን ታና ጌሻዳን ቦንቻናዉ ታዉ አዛዘትበይክታ” ያጌዳ። ሄዌ ሃይ ጺና መላ ቢታን፥ ቃዴሳን ደእያ ማሪባ ሃ።<verse eid="NUM 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 27:15"/>ሙሴ መና ጎዳ ሀዋዳን ያጌዳ፤ <verse eid="NUM 27:15"/><verse number="16-17" style="v" sid="NUM 27:16-17"/>“አቤት መና ጎዳዉ፥ አሳ ኡባዉ ደኡዋ እምያ ጾሳዉ፥ ነ አሳይ፥ ጾሳ አሳይ ሄንንቻይ ባይና ዉድያ ማላ ግደናዳን፥ ሀ አሳ ስንን ከስያነ ገልያ፥ ኡንቱንቱካ ካለደ ከስያነ ገልስያ፥ እት አሳ ሀ ማባራ ቦላ ሱንርኪ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">27:16-17 </char><char style="xt" closed="false"><ref loc="EZK 34:5">ህዝ. 34:5</ref>፤ <ref loc="MAT 9:36">ማቶሳ 9:36</ref>፤ <ref loc="MRK 6:34">ማር. 6:34</ref></char></note><verse eid="NUM 27:16-17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 27:18"/>መና ጎዳይ ሙሳ፥ “አያናይ አን ደእያ ኔዌ ናኣ ኢያሳ አካደ፥ ነ ኩሽያ አ ቦላ ዎ፤<note caller="-" style="x"><char style="xo" closed="false">27:18 </char><char style="xt" closed="false"><ref loc="EXO 24:13">ከሳ 24:13</ref></char></note> <verse eid="NUM 27:18"/><verse number="19" style="v" sid="NUM 27:19"/>ያታደ ቄስያ ኤልኣዛራ ስንንነ ማባራ ኡባ ስንን ኤሳደ፥ ኡንቱንቱ በእሽን ሱን። <verse eid="NUM 27:19"/><verse number="20" style="v" sid="NUM 27:20"/>እስራኤላቱዋ ማባራ ኡባይ አዉ አዛዘታናዳን፥ ነ ማታፐ አዉ ሻካደ እማ። <verse eid="NUM 27:20"/><verse number="21" style="v" sid="NUM 27:21"/>ቄስያ ኤልኣዛራ ስንን እ ኤቆ፤ ኤልኣዛር ኡሪምያን አዉ መና ጎዳ ሸንያ ኦቾ። ኢያሱነ እስራኤልያ ማባራይ ኡባይ ኤልኣዛራ አዛዙዋን ከስኖነ አ አዛዙዋን ገልኖ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">27:21 </char><char style="xt" closed="false"><ref loc="EXO 28:30">ከሳ 28:30</ref>፤ <ref loc="1SA 14:41">1 ሳሜላ 14:41</ref>፤ <ref loc="1SA 28:6">28:6</ref></char></note><verse eid="NUM 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 27:22"/>መና ጎዳይ አዛዜዳዋዳን ሙሴ ኦዳ፤ ኢያሳ አፊደ፥ ቄስያ ኤልኣዛራ ስንንነ ማባራ ኡባ ስንን ኤሴዳ። <verse eid="NUM 27:22"/><verse number="23" style="v" sid="NUM 27:23"/>መና ጎዳይ ጾሳይ አዛዜዳዋዳን፥ ሙሴ ባረ ኩሽያ አ ቦላ ዎደ፥ አ ሱንዳ።<note caller="-" style="x"><char style="xo" closed="false">27:23 </char><char style="xt" closed="false"><ref loc="DEU 31:23">ዛረ. 31:23</ref></char></note><verse eid="NUM 27:23"/></para>
  <chapter eid="NUM 27"/>
  <chapter number="28" style="c" sid="NUM 28"/>
  <para style="s1">ሀቼ ሀቼ ሺሽያ ያርሹዋ</para>
  <para style="r">(<ref loc="EXO 29:38-46">ከሳ 29:38-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 28:1"/>መና ጎዳይ ሙሳ፥ <verse eid="NUM 28:1"/><verse number="2" style="v" sid="NUM 28:2"/>“እስራኤላቱዋ ሀዋዳን ያጋደ አዛዛ፤ ‘ታ ቁማ፥ ታና ቶሹኩ ጊደ ሳዋና ማላ፥ ታማን ያርሽያ ታ ያርሹዋ ኬሬዳ ዎድያን ዎድያን ታዉ ናጊደ እምተ’ ያጋ። <verse eid="NUM 28:2"/><verse number="3" style="v" sid="NUM 28:3"/>ቃይ ኔን ኡንቱንታ፥ ‘መና ጎዳዉ ታማን ያርሽያ ያርሹ ሀዋ: ትላ ቦላና ደእያ፥ እት ላይ ግዴዳ ላኡ ዶርሳ ኦርገቱዋ ሀች ሀች ጹግያ ያርሾ ያርሽተ፤ <verse eid="NUM 28:3"/><verse number="4" style="v" sid="NUM 28:4"/>ዶርሳ ኦርገቱዋፐ እቱዋ ዎንታ፥ ላኤንዋ ኦማርስ ያርሽተ። <verse eid="NUM 28:4"/><verse number="5" style="v" sid="NUM 28:5"/>ቃይ ሄዋና እት ሊትሮ ግድያ ዛይትያን ሙናቀቴዳ እት ኪሎ ግራመ ሙሩታ ዛርጋ ልያ ካ ያርሾ ያርሽተ። <verse eid="NUM 28:5"/><verse number="6" style="v" sid="NUM 28:6"/>ሀዌ መና ጎዳ ቶሹኩ ጊደ ሳዋና ማላ፥ ሲና ደርያ ቦላን አዛዘቴዳ፥ ሀች ሀች ታማን ጹግያ ያርሹዋ። <verse eid="NUM 28:6"/><verse number="7" style="v" sid="NUM 28:7"/>ሄዋና ያርሽያ ኡሻ ያርሹ እት ዶርሳ ኦርግያዉ እት ሊትሮ ግድያ ዎይንያ ኤሳ። ኡሻ ያርሹዋ ጌሻ ሳኣን መና ጎዳዉ ጉስተ። <verse eid="NUM 28:7"/><verse number="8" style="v" sid="NUM 28:8"/>ኦማርስ ላኤን ዶርሳ ኦርግያ፥ ዎንታዋ ኦዳዋዳን ኦደ፥ ካ ያርሹዋናነ ኡሻ ያርሹዋና መና ጎዳ ቶሹኩ ጊደ ሳዋና ማላ፥ ታማን ያርሽተ።<verse eid="NUM 28:8"/></para>
  <para style="s1">ሳምባታ ጋላሳ ያርሹዋ</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 28:9"/>“ ‘ሳምባታ ጋላሳን፥ ትላ ቦላና ደእያ እት ላይ ግዴዳ ላኡ ዶርሳነ ዛይትያን ሙናቀቴዳ ላኡ ኪሎ ግራመ ግድያ ሙሩታ ልያ ካ ያርሹዋነ ኡሻ ያርሹዋ ኦደ ያርሽተ። <verse eid="NUM 28:9"/><verse number="10" style="v" sid="NUM 28:10"/>ሀቼ ሀች ጹግያ ያርሹዋነ አ ኡሻ ያርሹዋ ቦላ፥ ሳምባታ ጋላሳ ኡባን ህንተ ያርሽያ ጹግያ ያርሹ ሀዋ።<verse eid="NUM 28:10"/></para>
  <para style="s1">አግናይ ጼርያ ጋላሳ ያርሹዋ</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 28:11"/>“ ‘አግናይ ጼርያ ጋላሳ ኡባን፥ ላኡ ኮሩማቱዋ፥ እት ዶርሳ ኦርግያነ እት ላይ ግዴዳ ላፑን ዶርሳ ኦርገቱዋ፥ ኡባይካ ትላ ቦላና ደእያዋንታ፥ ጹግያ ያርሹዋ ኦደ፥ መና ጎዳዉ ያርሽተ። <verse eid="NUM 28:11"/><verse number="12" style="v" sid="NUM 28:12"/>እት እት ኮሩማና ዛይትያን ሙናቀቴዳ ሄዙ ኪሎ ግራመ ግድያ ሙሩታ ዛርጋ ልያ፥ እት ዶርሳ ኦርግያና ዛይትያን ሙናቀቴዳ ላኡ ኪሎ ግራመ ግድያ ሙሩታ ዛርጋ ልያነ <verse eid="NUM 28:12"/><verse number="13" style="v" sid="NUM 28:13"/>ላፑን ዶርሳ ማራቱዋፐ እት እት ዶርሳ ማራና ዛይትያን ሙናቀቴዳ እት ኪሎ ግራመ ግድያ ሙሩታ ዛርጋ ልያ ካ ያርሹዋ ኦደ፥ መና ጎዳ ቶሹኩ ጊደ ሳዋና ማላ፥ ታማን ያርሽያ ያርሹዋ ያርሽተ። <verse eid="NUM 28:13"/><verse number="14" style="v" sid="NUM 28:14"/>ቃይ ኡሻ ያርሾ እት እት ኮሩማና ላኡ ሊትሮ ግድያ ዎይንያ ኤሳ፥ እት ዶርሳ ኦርግያና እት ሊትሮነ ባጋ ዎይንያ ኤሳነ እት እት ዶርሳ ማራና እት ሊትሮ ግድያ ዎይንያ ኤሳ ሺሽተ። ሀዌ ላይ ግዶን አግናይ ጼርያ ጋላሳ ኡባን ያርሽያ ጹግያ ያርሹዋ። <verse eid="NUM 28:14"/><verse number="15" style="v" sid="NUM 28:15"/>ሀቼ ሀች ጹግያ ያርሹዋነ አ ኡሻ ያርሹዋ ቦላ፥ እት ዴሻ ኦርግያ ናጋራ ያርሹዋ ኦደ፥ መና ጎዳዉ ያርሽተ።<verse eid="NUM 28:15"/></para>
  <para style="s1">ፓስጋ ባላነ ኡክ ባላ ያርሾቱዋ</para>
  <para style="r">(<ref loc="LEV 23:5-14">ዎጋ 23:5-14</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 28:16"/>“ ‘ኮይሮ አግናን ታማነ ኦይደን ጋላሳይ መና ጎዳ ፓስጋ ቦንችያ ጋላሳ ግዶ።<note caller="-" style="x"><char style="xo" closed="false">28:16 </char><char style="xt" closed="false"><ref loc="EXO 12:1-13">ከሳ 12:1-13</ref>፤ <ref loc="DEU 16:1-2">ዛረ. 16:1-2</ref></char></note> <verse eid="NUM 28:16"/><verse number="17" style="v" sid="NUM 28:17"/>ቃይ ሄ አግናንካ ታማነ እቼሸን ጋላሳን ዶሚደ፥ ኡክ ባላይ ቦንቼቴ፤ ሄዋ ድራዉ፥ ላፑን ጋላሳቱዋን እርሹ ገልቤና ኡክ ሚተ።<note caller="-" style="x"><char style="xo" closed="false">28:17 </char><char style="xt" closed="false"><ref loc="EXO 12:14-20">ከሳ 12:14-20</ref>፤ <ref loc="EXO 23:15">23:15</ref>፤ <ref loc="EXO 34:18">34:18</ref>፤ <ref loc="DEU 16:3-8">ዛረ. 16:3-8</ref></char></note> <verse eid="NUM 28:17"/><verse number="18" style="v" sid="NUM 28:18"/>ሄ ጋላሳቱዋፐ ኮይሮ ጋላሳን ጌሻ ሺቁዋ ሺቅተ፤ ዳቡርስያ ኦሶ አያነ ኦፕተ። <verse eid="NUM 28:18"/><verse number="19" style="v" sid="NUM 28:19"/>ላኡ ኮሩማቱዋ፥ እት ዶርሳ ኦርግያነ እት ላይ ግዴዳ ላፑን ዶርሳ ኦርገቱዋ፥ ኡባይካ ትላ ቦላና ደእያዋንታ፥ ታማን ያርሽያ ያርሹዋ ኦደ፥ መና ጎዳዉ ያርሽተ። <verse eid="NUM 28:19"/><verse number="20" style="v" sid="NUM 28:20"/>ካ ያርሾ እት ኮሩማና ዛይትያን ሙናቀቴዳ ሄዙ ኪሎ ግራመ ግድያ ሙሩታ ዛርጋ ልያ፥ እት ዶርሳ ኦርግያና ላኡ ኪሎ ግራመ ግድያ ልያነ <verse eid="NUM 28:20"/><verse number="21" style="v" sid="NUM 28:21"/>ላፑን ዶርሳ ማራቱዋፐ እት እት ማራና እት ኪሎ ግራመ ልያ ያርሽተ። <verse eid="NUM 28:21"/><verse number="22" style="v" sid="NUM 28:22"/>ቃይ እት ዴሻ ኦርግያ ናጋራ ያርሾ፥ ህንተ ናጋራ አቶ ጊሳናዉ ያርሽተ። <verse eid="NUM 28:22"/><verse number="23-24" style="v" sid="NUM 28:23-24"/>ሀቼ ሀች ዎንታ ጹግያ ያርሹዋነ አ ካ ያርሹዋ ቦላ፥ ሳዉዋ ቶሹኩ ግያ ቁማ ታማን ያርሽያ ያርሹዋ ጉጂደ፥ መና ጎዳዉ ያርሽተ። ላፑን ጋላሳዉ ሄዋዳን ኦተ። <verse eid="NUM 28:23-24"/><verse number="25" style="v" sid="NUM 28:25"/>ላፑን ጋላሳን ቃይ ጌሻ ሺቁዋ ሺቅተ፤ ዳቡርስያ ኦሶ አያነ ኦፕተ።<verse eid="NUM 28:25"/></para>
  <para style="s1">ሳምንታቱዋ ባላ ያርሹዋ</para>
  <para style="r">(<ref loc="LEV 23:15-22">ዎጋ 23:15-22</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 28:26"/>“ ‘ሳምንታቱ ባላ ጋላሳን ህንተ መና ጎዳዉ ኦራ ካ ሺሽያ ዎደ፥ ጌሻ ሺቁዋ ሺቅተ፤ ዳቡርስያ ኦሶ አያነ ኦፕተ።<note caller="-" style="x"><char style="xo" closed="false">28:26-31 </char><char style="xt" closed="false"><ref loc="EXO 23:16">ከሳ 23:16</ref>፤ <ref loc="EXO 34:22">34:22</ref>፤ <ref loc="DEU 16:9-12">ዛረ. 16:9-12</ref></char></note> <verse eid="NUM 28:26"/><verse number="27" style="v" sid="NUM 28:27"/>ላኡ ኮሩማቱዋ፥ እት ዶርሳ ኦርግያነ እት ላይ ግዴዳ ላፑን ዶርሳ ኦርገቱዋ ሳዉዋ ቶሹኩ ግያ ጹግያ ያርሹዋ ኦደ፥ መና ጎዳዉ ያርሽተ። <verse eid="NUM 28:27"/><verse number="28" style="v" sid="NUM 28:28"/>እት እት ኮሩማና ዛይትያን ሙናቀቴዳ ሄዙ ኪሎ ግራመ ግድያ ሙሩታ ዛርጋ ልያ፥ እት ዶርሳ ኦርግያና ላኡ ኪሎ ግራመ ልያነ <verse eid="NUM 28:28"/><verse number="29" style="v" sid="NUM 28:29"/>ላፑን ዶርሳ ማራቱዋፐ እት እት ማራና እት ኪሎ ግራመ ልያ ካ ያርሾ ያርሽተ። <verse eid="NUM 28:29"/><verse number="30" style="v" sid="NUM 28:30"/>ቃይ እት ዴሻ ኦርግያ ናጋራ አቶ ጊስያ ያርሹዋ ኦደ ያርሽተ። <verse eid="NUM 28:30"/><verse number="31" style="v" sid="NUM 28:31"/>ሀቼ ሀች ጹግያ ያርሹዋነ አ ኡሻ ያርሹዋ ቦላ፥ ሀዋንታ ኡንቱንቱ ካ ያርሹዋና ያርሽተ። መሄቱ ትላ ቦላና ደእያዋንታ ግድያዋ ጌሺደ ኤርተ።<verse eid="NUM 28:31"/></para>
  <chapter eid="NUM 28"/>
  <chapter number="29" style="c" sid="NUM 29"/>
  <para style="s1">ማላካታ ባላ</para>
  <para style="r">(<ref loc="LEV 23:23-25">ዎጋ 23:23-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 29:1"/>“ ‘ላፑን አግናዉ ኮይሮ ጋላሳን፥ ጌሻ ሺቁዋ ሺቅተ። ዳቡርስያ ኦሶ አያነ ኦፕተ። ሄ ጋላሳይ ጹሩምባይ ፑነትያ ጋላሳ። <verse eid="NUM 29:1"/><verse number="2" style="v" sid="NUM 29:2"/>መና ጎዳዉ ሳዉዋ ቶሹኩ ጋና ማላ፥ ጹግያ ያርሾ፥ እት ኮሩማ፥ እት ዶርሳ ኦርግያነ እት ላይ ግዴዳ ላፑን ዶርሳ ኦርገቱዋ፥ ኡባይካ ትላ ቦላና ደእያዋንታ፥ ያርሽተ። <verse eid="NUM 29:2"/><verse number="3" style="v" sid="NUM 29:3"/>ካ ያርሾ እት ኮሩማና ዛይትያን ሙናቀቴዳ ሄዙ ኪሎ ግራመ ግድያ ሙሩታ ዛርጋ ልያ፥ እት ዶርሳ ኦርግያና ላኡ ኪሎ ግራመ ልያነ <verse eid="NUM 29:3"/><verse number="4" style="v" sid="NUM 29:4"/>ላፑን ዶርሳ ማራቱዋፐ እት እት ማራና እት ኪሎ ግራመ ልያ ያርሽተ። <verse eid="NUM 29:4"/><verse number="5" style="v" sid="NUM 29:5"/>ቃይ እት ዴሻ ኦርግያ ናጋራ ያርሾ፥ ህንተ ናጋራ አቶ ጊሳናዉ ያርሽተ። <verse eid="NUM 29:5"/><verse number="6" style="v" sid="NUM 29:6"/>ሄዋንታ አግናይ ጼርያ ጋላሳን ጹግያ ያርሹዋ ቦላነ አ ካ ያርሹዋ ቦላ፥ ሀች ሀች ጹግያ ያርሹዋ ቦላ፥ አ ካ ያርሹዋ ቦላነ አ ኡሻ ያርሹዋ ቦላ ጉጂደ፥ ዎጋዳን ያርሽተ፤ ሀዋንቱ መና ጎዳዉ ሳዉዋ ቶሹኩ ግያ፥ ታማን ያርሽያ ያርሾቱዋ።<verse eid="NUM 29:6"/></para>
  <para style="s1">ናጋራ አቶ ጊስያ ጋላሳ ያርሹዋ</para>
  <para style="r">(<ref loc="LEV 23:26-32">ዎጋ 23:26-32</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 29:7"/>“ ‘ሀ ላፑን አግናዉ ታማን ጋላሳን ጌሻ ሺቁዋ ሺቅተ፤ ህንተ ሁጲያ ካዉሽተ፤ አያ ኦሱዋካ ኦፕተ።<note caller="-" style="x"><char style="xo" closed="false">29:7-11 </char><char style="xt" closed="false"><ref loc="LEV 16:29-34">ዎጋ 16:29-34</ref></char></note> <verse eid="NUM 29:7"/><verse number="8" style="v" sid="NUM 29:8"/>ያቲደ መና ጎዳ ቶሹኩ ጊደ ሳዋና ማላ፥ ጹግያ ያርሾ እት ኮሩማ፥ እት ዶርሳ ኦርግያነ እት ላይ ግዴዳ ላፑን ዶርሳ ኦርገቱዋ፥ ኡባይካ ትላ ቦላና ደእያዋንታ፥ ያርሽተ። <verse eid="NUM 29:8"/><verse number="9" style="v" sid="NUM 29:9"/>ካ ያርሾ እት ኮሩማና ዛይትያን ሙናቀቴዳ ሄዙ ኪሎ ግራመ ግድያ ሙሩታ ዛርጋ ልያ፥ እት ዶርሳ ኦርግያና ላኡ ኪሎ ግራመ ልያነ <verse eid="NUM 29:9"/><verse number="10" style="v" sid="NUM 29:10"/>ላፑን ዶርሳ ማራቱዋፐ እት እት ማራና እት ኪሎ ግራመ ልያ ያርሽተ። <verse eid="NUM 29:10"/><verse number="11" style="v" sid="NUM 29:11"/>ቃይ ናጋራ ያርሾ እት ዴሻ ኦርግያ ያርሽተ። ሄዋንታ ናጋራ አቶ ጊስያ ያርሹዋ ቦላ፥ ሀች ሀች ጹግያ ያርሹዋ ቦላ፥ ኡንቱንቱ ካ ያርሹዋ ቦላነ ኡንቱንቱ ኡሻ ያርሹዋ ቦላ ጉጂደ ያርሽተ።<verse eid="NUM 29:11"/></para>
  <para style="s1">ዳስያ ባላ ያርሾቱዋ</para>
  <para style="r">(<ref loc="LEV 23:33-44">ዎጋ 23:33-44</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 29:12"/>“ ‘ላፑን አግናን ታማነ እቼሸን ጋላሳን፥ ጌሻ ሺቁዋ ሺቅተ፤ ዳቡርስያ ኦሶ አያነ ኦፕተ። መና ጎዳዉ ዳስያ ባላ ላፑን ጋላሳ ቦንችተ። <verse eid="NUM 29:12"/><verse number="13" style="v" sid="NUM 29:13"/>መና ጎዳ ቶሹኩ ጊደ ሳዋና ማላ፥ ታማን ያርሽያ ታማነ ሄዙ ኮሩማቱዋ፥ ላኡ ዶርሳ ኦርገቱዋነ እት ላይ ግዴዳ ታማነ ኦይዱ ዶርሳ ኦርገቱዋ፥ ኡባይካ ትላ ቦላና ደእያዋንታ፥ ያርሽተ። <verse eid="NUM 29:13"/><verse number="14" style="v" sid="NUM 29:14"/>ካ ያርሾ ታማነ ሄዙ ኮሩማቱዋፐ እት እት ኮሩማና ዛይትያን ሙናቀቴዳ ሄዙ ኪሎ ግራመ ግድያ ሙሩታ ዛርጋ ልያ፥ ላኡ ዶርሳ ኦርገቱዋፐ እት እት ኦርግያና ላኡ ኪሎ ግራመ ልያነ <verse eid="NUM 29:14"/><verse number="15" style="v" sid="NUM 29:15"/>ታማነ ኦይዱ ዶርሳ ማራቱዋፐ እት እት ማራና እት ኪሎ ግራመ ልያ ያርሽተ። <verse eid="NUM 29:15"/><verse number="16" style="v" sid="NUM 29:16"/>ቃይ ናጋራ ያርሾ እት ዴሻ ኦርግያ ያርሽተ። ሄዋንታ ሀች ሀች ጹግያ ያርሹዋ ቦላ፥ አ ካ ያርሹዋ ቦላነ አ ኡሻ ያርሹዋ ቦላ ጉጂደ ያርሽተ።<verse eid="NUM 29:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 29:17"/>“ ‘ላኤን ጋላሳን ታማነ ላኡ ኮሩማቱዋ፥ ላኡ ዶርሳ ኦርገቱዋነ እት ላይ ግዴዳ ታማነ ኦይዱ ዶርሳ ኦርገቱዋ፥ ኡባይካ ትላ ቦላና ደእያዋንታ፥ ያርሽተ። <verse eid="NUM 29:17"/><verse number="18" style="v" sid="NUM 29:18"/>ኮሩማቱዋና፥ ዶርሳ ኦርገቱዋናነ ዶርሳ ማራቱዋና፥ ኡንቱንቱ ካ ያርሹዋነ ኡንቱንቱ ኡሻ ያርሹዋ ዎጋይ አዛዝያ ፓይዱዋዳን ያርሽተ። <verse eid="NUM 29:18"/><verse number="19" style="v" sid="NUM 29:19"/>ቃይ ናጋራ ያርሾ እት ዴሻ ኦርግያ ያርሽተ። ሄዋንታ ሀች ሀች ጹግያ ያርሹዋ ቦላ፥ አ ካ ያርሹዋ ቦላነ አ ኡሻ ያርሹዋ ቦላ ጉጂደ ያርሽተ።<verse eid="NUM 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 29:20"/>“ ‘ሄዘን ጋላሳን፥ ታማነ እት ኮሩማቱዋ፥ ላኡ ዶርሳ ኦርገቱዋነ እት ላይ ግዴዳ ታማነ ኦይዱ ዶርሳ ኦርገቱዋ፥ ኡባይካ ትላ ቦላና ደእያዋንታ፥ ያርሽተ። <verse eid="NUM 29:20"/><verse number="21" style="v" sid="NUM 29:21"/>ኮሩማቱዋና፥ ዶርሳ ኦርገቱዋናነ ዶርሳ ማራቱዋና፥ ኡንቱንቱ ካ ያርሹዋነ ኡንቱንቱ ኡሻ ያርሹዋ ዎጋይ አዛዝያ ፓይዱዋዳን ያርሽተ። <verse eid="NUM 29:21"/><verse number="22" style="v" sid="NUM 29:22"/>ቃይ ናጋራ ያርሾ እት ዴሻ ኦርግያ ያርሽተ። ሄዋንታ ሀች ሀች ጹግያ ያርሹዋ ቦላ፥ አ ካ ያርሹዋ ቦላነ አ ኡሻ ያርሹዋ ቦላ ጉጂደ ያርሽተ።<verse eid="NUM 29:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 29:23"/>“ ‘ኦይደን ጋላሳን፥ ታሙ ኮሩማቱዋ፥ ላኡ ዶርሳ ኦርገቱዋነ እት ላይ ግዴዳ ታማነ ኦይዱ ዶርሳ ኦርገቱዋ፥ ኡባይካ ትላ ቦላና ደእያዋንታ፥ ያርሽተ። <verse eid="NUM 29:23"/><verse number="24" style="v" sid="NUM 29:24"/>ኮሩማቱዋና፥ ዶርሳ ኦርገቱዋናነ ዶርሳ ማራቱዋና፥ ኡንቱንቱ ካ ያርሹዋነ ኡንቱንቱ ኡሻ ያርሹዋ ዎጋይ አዛዝያ ፓይዱዋዳን ያርሽተ። <verse eid="NUM 29:24"/><verse number="25" style="v" sid="NUM 29:25"/>ቃይ ናጋራ ያርሾ እት ዴሻ ኦርግያ ያርሽተ። ሄዋንታ ሀች ሀች ጹግያ ያርሹዋ ቦላ፥ አ ካ ያርሹዋ ቦላነ እዛ ኡሻ ያርሹዋ ቦላ ጉጂደ ያርሽተ።<verse eid="NUM 29:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 29:26"/>“ ‘እቼሸን ጋላሳን፥ ኡዱፑን ኮሩማቱዋ፥ ላኡ ዶርሳ ኦርገቱዋነ፥ እት ላይ ግዴዳ ታማነ ኦይዱ ዶርሳ ኦርገቱዋ፥ ኡባይካ ትላ ቦላና ደእያዋንታ፥ ያርሽተ። <verse eid="NUM 29:26"/><verse number="27" style="v" sid="NUM 29:27"/>ኮሩማቱዋና፥ ዶርሳ ኦርገቱዋናነ ዶርሳ ማራቱዋና ኡንቱንቱ ካ ያርሹዋነ ኡንቱንቱ ኡሻ ያርሹዋ ዎጋይ አዛዝያ ፓይዱዋዳን ያርሽተ። <verse eid="NUM 29:27"/><verse number="28" style="v" sid="NUM 29:28"/>ቃይ ናጋራ ያርሾ እት ዴሻ ኦርግያ ያርሽተ። ሄዋንታ ሀች ሀች ጹግያ ያርሹዋ ቦላ፥ አ ካ ያርሹዋ ቦላነ አ ኡሻ ያርሹዋ ቦላ ጉጂደ ያርሽተ።<verse eid="NUM 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 29:29"/>“ ‘ኡሱፑን ጋላሳን፥ ሆስፑን ኮሩማቱዋ፥ ላኡ ዶርሳ ኦርገቱዋነ እት ላይ ግዴዳ ታማነ ኦይዱ ዶርሳ ኦርገቱዋ፥ ኡባይካ ትላ ቦላና ደእያዋንታ፥ ያርሽተ። <verse eid="NUM 29:29"/><verse number="30" style="v" sid="NUM 29:30"/>ኮሩማቱዋና፥ ዶርሳ ኦርገቱዋናነ ዶርሳ ማራቱዋና ኡንቱንቱ ካ ያርሹዋነ ኡንቱንቱ ኡሻ ያርሹዋ ዎጋይ አዛዝያ ፓይዱዋዳን ያርሽተ። <verse eid="NUM 29:30"/><verse number="31" style="v" sid="NUM 29:31"/>ቃይ ናጋራ ያርሾ እት ዴሻ ኦርግያ ያርሽተ። ሄዋንታ ሀች ሀች ጹግያ ያርሹዋ ቦላ፥ አ ካ ያርሹዋ ቦላነ አ ኡሻ ያርሹዋ ቦላ ጉጂደ ያርሽተ።<verse eid="NUM 29:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 29:32"/>“ ‘ላፑን ጋላሳን፥ ላፑን ኮሩማቱዋ፥ ላኡ ዶርሳ ኦርገቱዋነ እት ላይ ግዴዳ ታማነ ኦይዱ ዶርሳ ኦርገቱዋ፥ ኡባይካ ትላ ቦላና ደእያዋንታ፥ ያርሽተ። <verse eid="NUM 29:32"/><verse number="33" style="v" sid="NUM 29:33"/>ኮሩማቱዋና፥ ዶርሳ ኦርገቱዋናነ ዶርሳ ማራቱዋና ኡንቱንቱ ካ ያርሹዋነ ኡንቱንቱ ኡሻ ያርሹዋ ዎጋይ አዛዝያ ፓይዱዋዳን ያርሽተ። <verse eid="NUM 29:33"/><verse number="34" style="v" sid="NUM 29:34"/>ቃይ ናጋራ ያርሾ እት ዴሻ ኦርግያ ያርሽተ። ሄዋንታ ሀች ሀች ጹግያ ያርሹዋ ቦላ፥ አ ካ ያርሹዋ ቦላነ አ ኡሻ ያርሹዋ ቦላ ጉጂደ ያርሽተ።<verse eid="NUM 29:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 29:35"/>“ ‘ሆስፑን ጋላሳን ጌሻ ሺቁዋ ሺቅተ፤ ዳቡርስያ ኦሶ አያነ ኦፕተ። <verse eid="NUM 29:35"/><verse number="36" style="v" sid="NUM 29:36"/>ታማን ያርሽያ ያርሹ መና ጎዳ ቶሹኩ ጊደ ሳዋና ማላ፥ እት ኮሩማ፥ እት ዶርሳ ኦርግያነ እት ላይ ግዴዳ ላፑን ዶርሳ ኦርገቱዋ፥ ኡባይካ ትላ ቦላና ደእያዋንታ፥ ያርሽተ። <verse eid="NUM 29:36"/><verse number="37" style="v" sid="NUM 29:37"/>ኮሩማና፥ ዶርሳ ኦርግያናነ ዶርሳ ማራቱዋና ኡንቱንቱ ካ ያርሹዋነ ኡንቱንቱ ኡሻ ያርሹዋ ዎጋይ አዛዝያ ፓይዱዋዳን ሺሽተ። <verse eid="NUM 29:37"/><verse number="38" style="v" sid="NUM 29:38"/>ቃይ ናጋራ ያርሾ እት ዴሻ ኦርግያ ያርሽተ። ሄዋንታ ሀች ሀች ጹግያ ያርሹዋ ቦላ፥ አ ካ ያርሹዋ ቦላነ አ ኡሻ ያርሹዋ ቦላ ጉጂደ ያርሽተ።<verse eid="NUM 29:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 29:39"/>“ ‘ህንተ ሺቆዋ ጋናዉ ያርሽያ ያርሾቱ ቦላነ ህንተ ህንተ ዶሱዋን ጮ እምያ ያርሾቱ ቦላ፥ ጹግያ ያርሹዋ፥ ካ ያርሹዋ፥ ኡሻ ያርሹዋነ እትፐተ ያርሹዋ፥ ሀዋንታ መና ጎዳ ባላ ህንተ ቦንቻናዉ ኬሬዳ ዎድያን ዎድያን ያርሽተ’ ያጋ” ያጌዳ።<verse eid="NUM 29:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 29:40"/>ሙሴ ባረና መና ጎዳይ አዛዜዳዋ ኡባ እስራኤላቶ ኦዴዳ።<verse eid="NUM 29:40"/></para>
  <chapter eid="NUM 29"/>
  <chapter number="30" style="c" sid="NUM 30"/>
  <para style="s1">ቃንገ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 30:1"/>ሙሴ እስራኤልያ ዛራቱ ካፓቱዋ ሀዋዳን ያጌዳ፤ “መና ጎዳይ አዛዝያዌ ሀዋ። <verse eid="NUM 30:1"/><verse number="2" style="v" sid="NUM 30:2"/>እት አሳይ መና ጎዳዉ እትባ ኦናዉ ገፖፐ፥ ዎይ እትባ አጋናዉ ጫቆፐ፥ ባረ ዶናፐ ከሴዳዋ ኡባ ፖሎፐ አትና፥ ባረ ቃላ ብሎፖ።<note caller="-" style="x"><char style="xo" closed="false">30:2 </char><char style="xt" closed="false"><ref loc="DEU 23:21-23">ዛረ. 23:21-23</ref>፤ <ref loc="MAT 5:33">ማቶሳ 5:33</ref></char></note><verse eid="NUM 30:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 30:3"/>“ባረ አዉዋ ሶን ደእያ ዎዶሮ ናታ፥ መና ጎዳዉ እትባ ኦናዉ ገፖፐ፥ ዎይ እትባ አጋናዉ ጫቆፐ፥ <verse eid="NUM 30:3"/><verse number="4" style="v" sid="NUM 30:4"/>እ አዉ እ ገፋ ዎይ እ ጫቁዋባ ስሲደ፥ እዞ አይነ ጌናን አጎፐ፥ አ ኦናዉ ገፔዳዋ ኡባነ አጋናዉ ጫቄዳዋ ኡባ ፖሉ። <verse eid="NUM 30:4"/><verse number="5" style="v" sid="NUM 30:5"/>ሽን እ አዉ ሄዋ ስሲደ ጳልቆፐ፥ አ ገፔዳ ገፋይነ አጋናዉ ጫቄዳ ጫቁ ፖለተናን አቴ። እ አዉ እዞ ድጌዳ ድራዉ፥ መና ጎዳይ እዝዉ አቶ ጋና።<verse eid="NUM 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 30:6"/>“ገላቤና ማጫውና ገፓ ኡታደ፥ ዎይ እትባ አጋናዉ ኤለካ ባረ ዶናፐ ጫቃ ኡታደ አስና ገሎፐ፥ <verse eid="NUM 30:6"/><verse number="7" style="v" sid="NUM 30:7"/>እ አስናይ ሄዋ ስሲደ፥ እዞ አይነ ጌናን አጎፐ፥ አ ኦናዉ ገፔዳ ገፋነ እትባ አጋናዉ ጫቄዳ ጫቁዋ ፖሉ። <verse eid="NUM 30:7"/><verse number="8" style="v" sid="NUM 30:8"/>ሽን እ አስናይ ሄዋ ስሲደ ጳልቆፐ፥ አ ገፔዳ ገፋይ ዎይ እትባ አጋናዉ ኤለካ ጫቄዳ ጫቁ ፖለተናን አቴ። ሄዋ ድራዉ፥ መና ጎዳይ እዝዉ አቶ ጋና።<verse eid="NUM 30:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 30:9"/>“ሽን አምአታ ዎይ አስናይ የዴዳ ማጫውኖ ኦናዉ ገፔዳዋ ዎይ እትባ አጋናዉ ጫቄዳዋ ፖሉ።<verse eid="NUM 30:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 30:10"/>“ማቻታ ባረ አስና ሶን ደኣደ ገፖፐ፥ ዎይ እትባ አጋናዉ ጫቁዋ ጫቆፐ፥ <verse eid="NUM 30:10"/><verse number="11" style="v" sid="NUM 30:11"/>እ አስናይ ሄዋ ስሲደ እዞ አይነ ጌናን አጎፐ፥ አ ገፔዳ ገፋነ እትባ አጋናዉ ጫቄዳ ጫቁዋ ኡባ ፖሉ። <verse eid="NUM 30:11"/><verse number="12" style="v" sid="NUM 30:12"/>ሽን እ አስናይ ሄዋ ስሲደ ጳልቆፐ፥ እ ገፋይ ዎይ አ አጋናዉ ጫቄዳ ጫቁ አያይነ ፖለቶፖ። እ አስናይ ድጌዳ ድራዉ፥ መና ጎዳይ እዝዉ አቶ ጋና። <verse eid="NUM 30:12"/><verse number="13" style="v" sid="NUM 30:13"/>እ አስናይ አ ገፕያ ገፋ ኡባ ዎይ አ ባረና ዝቂ ኦናዉ ጫቄዳዋ ኡባ ጳልቃናዉ ዎይ ኤኖ ጋናው ዳንዳዬ። <verse eid="NUM 30:13"/><verse number="14" style="v" sid="NUM 30:14"/>ሽን እ አስናይ ሄ ጋላስ ዎይ ዎንተ ጋላስ ሄዋ አይነ ጌናን አጎፐ፥ እ ገፋ ኡባ ዎይ እ ጫቁዋ ኡባ ማዬ። እ ሄዋ ስሴዳ ጋላስ ጮኡ ጌዳዋዳን እ ገፋ ኡባ ዎይ እ ጫቁዋ ኡባ ማይ ኡቴዳ። <verse eid="NUM 30:14"/><verse number="15" style="v" sid="NUM 30:15"/>ሽን እ ሄዋ ስሴዳ አማሬዳ ዎድያፐ ጉይያን ጳልቆፐ፥ እ ጎሚ አ ጋኬ” ያጌዳ።<verse eid="NUM 30:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 30:16"/>አስና ገላቤና፥ ባረ አዉዋ ሶን ደእያ ዎዶሮ ናታነ እ አዉዋ ግዱዋን ዎይ ማቻትነ አስና ግዱዋን ደአና ማላ፥ መና ጎዳይ ሙሳ አዛዜዳ ገፋ ዎጋይ ሀዋ።<verse eid="NUM 30:16"/></para>
  <chapter eid="NUM 30"/>
  <chapter number="31" style="c" sid="NUM 31"/>
  <para style="s1">ምድያማ አሳቱዋ ቦላ ደንዴዳ ኦላ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 31:1"/>መና ጎዳይ ሙሳ፥ <verse eid="NUM 31:1"/><verse number="2" style="v" sid="NUM 31:2"/>“እስራኤልያ አሳ ድራዉ፥ ኔን ምድያማ አሳ ቦላ ጾሳ ሀሉዋ ከሳ፤ ሄዋፐ ጉይያን፥ ኔን ሀይቃና” ያጌዳ።<verse eid="NUM 31:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 31:3"/>ሄዋ ድራዉ፥ ሙሴ አሳ፥ “ምድያማ አሳ ቦላ መና ጎዳ ሀሉዋ ከሳና ማላ ኦላ ባናዉ፥ ህንተ አሳ ኦላ ሚሻ ዳንጭስተ። <verse eid="NUM 31:3"/><verse number="4" style="v" sid="NUM 31:4"/>እት እት እስራኤልያ ዛራቱዋፐ እት ሻአ አቱማ አሳ ኦላዉ የድተ” ያጌዳ።<verse eid="NUM 31:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 31:5"/>እስራኤልያፐ ታማነ ላኡ ሻአ አቱማ አሳይ፥ እት እት ዛርያፐ እት ሻአ አሳይ፥ ኦላዉ ጊጌድኖ። <verse eid="NUM 31:5"/><verse number="6" style="v" sid="NUM 31:6"/>እት እት ዛርያፐ እት ሻአ አሳ ሙሴ ቄስያ ኤልኣዛራ ናኣ ፒንሃሳና ኦላዉ የዴዳ፤ ፒንሃስ ጌሻ ሚሻቱዋነ ማላታዉ ፑንያ ጹሩምባ ባረናና አኪደ ቤዳ። <verse eid="NUM 31:6"/><verse number="7" style="v" sid="NUM 31:7"/>መና ጎዳይ ሙሳ አዛዜዳዋዳን፥ ኡንቱንቱ ምድያማ አሳና ኦለቲደ፥ አቱማ አሳ ኡባ ዎድኖ። <verse eid="NUM 31:7"/><verse number="8" style="v" sid="NUM 31:8"/>ቃይ ምድያማ ካተቱዋ እቼሻቱዋ፥ ኤዋ፥ ረቄማ፥ ጹራ፥ ሁራነ ረባአ ግያዋንታ ዎድኖ። ኡንቱንቱ ቃይ ብኦራ ናኣ ባላማካ ማሻን ሲፌድኖ። <verse eid="NUM 31:8"/><verse number="9" style="v" sid="NUM 31:9"/>እስራኤላቱ ምድያማ ማጫ አሳቱዋነ ናናቱዋ ኦሞዲደ፥ ኡንቱንቱ ሚዛ፥ ኡንቱንቱ ዶርሳ ዉድያነ ኡንቱንቱ ሚሻ ኡባ ቦንቄድኖ። <verse eid="NUM 31:9"/><verse number="10" style="v" sid="NUM 31:10"/>ምድያማ አሳቱ ደኤዳ ካታማቱዋ ኡባነ ኡንቱንቱ ሞቱዋ ኡባ ታማን ጹጌድኖ። <verse eid="NUM 31:10"/><verse number="11" style="v" sid="NUM 31:11"/>ኡንቱንቱ አሳ፥ መህያነ ኦሞዴዳዋ ኡባ አክ አፌድኖ። <verse eid="NUM 31:11"/><verse number="12" style="v" sid="NUM 31:12"/>ኡንቱንቱ ኦሞዴዳ አሳቱዋነ ቦንቄዳባቱዋ ሙሴኮ፥ ቄስያ ኤልኣዛራኮነ እስራኤልያ ማባራኮ፥ ያርኮፐ ሄፍንን፥ ዮርዳኖሳ ሻፋ ማታን ደእያ ሞኣባ ደምባን ኡንቱንቱ ዱንካኔዳሳ አሄድኖ።<verse eid="NUM 31:12"/></para>
  <para style="s1">ኦላንቻቱ ስሜድኖ</para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 31:13"/>ሙሴ፥ ቄሲ ኤልኣዛርነ ማባራ ካፓቱ ኡባይ ዱንካኔዳ ሳኣፐ ጋጻ ኡንቱንቱና ጋከታናዉ ከሴድኖ። <verse eid="NUM 31:13"/><verse number="14" style="v" sid="NUM 31:14"/>ኦላፐ ስሜዳ ጋዳዋቱ ቦላ፥ ሻላቃቱ ቦላነ ጼቱዋ ካፓቱ ቦላ ሙሴ ሀንቀቴዳ። <verse eid="NUM 31:14"/><verse number="15" style="v" sid="NUM 31:15"/>ሙሴ ኡንቱንታ ሀዋዳን ያጌዳ፤ “ማጫ አሳ ኡባ ህንተ አያዉ አሼድቴ? <verse eid="NUM 31:15"/><verse number="16" style="v" sid="NUM 31:16"/>ኡንቱንቱ ባላማ ዞርያን፥ ፓኦራ ግያ ሳን እስራኤልያ አሳይ መና ጎዳ ናቂደ፥ ኤቃዉ ጎይናናዳን ኦዳዋንታ፤ መና ጎዳ አሳ ቦላ ቦሻይ ዬዳዌ ሄዋሳ።<note caller="-" style="x"><char style="xo" closed="false">31:16 </char><char style="xt" closed="false"><ref loc="NUM 25:1-9">ፓይ. 25:1-9</ref></char></note> <verse eid="NUM 31:16"/><verse number="17" style="v" sid="NUM 31:17"/>ሄዋ ድራዉ፥ ሀእ አቱማ ናናቱዋ ኡባ ዎተ፤ ቃይ አቱማ አሳና ግሴዳ ማጫ አሳ ኡባ ዎተ። <verse eid="NUM 31:17"/><verse number="18" style="v" sid="NUM 31:18"/>ሽን አቱማ አሳና ግሳቤና ማጫ ናናቱዋ ኡባ ህንተንቶ አሽተ። <verse eid="NUM 31:18"/><verse number="19" style="v" sid="NUM 31:19"/>ህንተ ግዶፐ አሳ ዎዳ ኡራይ ዎይ አሃ ቦቼዳ ኡራይ ኦንነ ዱንካኔዳ ሳኣፐ ጋጻን ላፑን ጋላሳ ኡቶ፤ ሄዛን ጋላስነ ላፑን ጋላስ ህንተናነ ህንተ ኦሞዴዳዋንታ ጌሽተ። <verse eid="NUM 31:19"/><verse number="20" style="v" sid="NUM 31:20"/>ቃይ ማዮ ኡባነ ጋልባፐ፥ ዴሻ እክሰፐነ ምፐ ኦሰቴዳዋንታ ኡባ ጌሽተ” ያጌዳ።<verse eid="NUM 31:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 31:21"/>ቄሲ ኤልኣዛር ኦላፐ ስሜዳ ኦላንቻቱዋ ሀዋዳን ያጌዳ፤ “መና ጎዳይ ሙሴዉ እሜዳ ህግያ ማራይ ሀዋ: <verse eid="NUM 31:21"/><verse number="22" style="v" sid="NUM 31:22"/>ዎርቃ፥ ብራ፥ ናሃስያ፥ ብራታ፥ ቆርቆሩዋነ እርሳስያ ግያ ብራታ <verse eid="NUM 31:22"/><verse number="23" style="v" sid="NUM 31:23"/>ታማን ሜተተናባቱዋ ኡባ ታማ ግዶና አና፥ ሄዌ ጌያና። ሽን ሄዌ ቃይ ቱናተፐ ጌይያ ሃን ጌያናዉ ኮሼ። ቃይ ታማን ሜተትያባቱዋ ኡባ ቱናተፐ ጌይያ ሃን ጌሻናዉ ኮሼ። <verse eid="NUM 31:23"/><verse number="24" style="v" sid="NUM 31:24"/>ላፑን ጋላስ ህንተ ማዩዋ ሜጭተ፤ ህንተካ ጌይተ። ሄዋፐ ጉይያን፥ ዱንካኔዳሳ ገልተ” ያጌዳ።<verse eid="NUM 31:24"/></para>
  <para style="s1">ኦሞዱዋ ሻኬድኖ</para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 31:25"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="NUM 31:25"/><verse number="26" style="v" sid="NUM 31:26"/>“ኔን፥ ቄሲ ኤልኣዛርነ ማባራ ካፓቱ ኦሞደቴዳ አሳነ መህያ ኡባ ፓይድተ። <verse eid="NUM 31:26"/><verse number="27" style="v" sid="NUM 31:27"/>ኦላን ኦለቴዳ ኦላንቻቶነ አቴዳ ማባራዉ ላኡ ከሲደ ሻክተ። <verse eid="NUM 31:27"/><verse number="28" style="v" sid="NUM 31:28"/>ኦለቴዳ ኦላንቻቱዋ ጋኬዳ ሻኩዋፐ፥ አሳ ግድና፥ ሚዛ ግድና፥ ሀረቱዋ፥ ዶርሳቱዋ ዎይ ዴሻቱዋ ግድና፥ እቼሹ ጼቱዋፐ እቱዋ መና ጎዳዉ እሞታዳን እምተ። <verse eid="NUM 31:28"/><verse number="29" style="v" sid="NUM 31:29"/>ኡንቱንታ ጋኬዳ ባጋፐ አኬዳ ጊራ መና ጎዳ ግሻዳን ቄስያ ኤልኣዛራዉ እምተ። <verse eid="NUM 31:29"/><verse number="30" style="v" sid="NUM 31:30"/>ህንኮ እስራኤላቱዋ ጋኬዳ ሻኩዋፐ፥ አሳ ግድና፥ ሚዛ ግድና፥ ሀረቱዋ፥ ዶርሳቱዋ፥ ዎይ ዴሻቱዋ ግድና፥ መህያ ኡባፐ እሻታሙዋፐ እቱዋ አኪደ ሄዋ መና ጎዳ ዱንካንያዉ አዎትያ ሌዋቶ እምተ” ያጌዳ። <verse eid="NUM 31:30"/><verse number="31" style="v" sid="NUM 31:31"/>ሙሴነ ቄሲ ኤልኣዛር መና ጎዳይ አዛዜዳዋዳን ኦድኖ።<verse eid="NUM 31:31"/></para>
  <para style="p">
    <verse number="32-35" style="v" sid="NUM 31:32-35"/>ኦላንቻቱ ባረንቶ አክና፥ አቴዳ ኦሞዱ 675,000 ዶርሳቱዋ፥ 72,000 ሚዛቱዋ፥ 61,000 ሀረቱዋነ አቱማ አሳና ግሳቤና 32,000 ማጫ ናናቱዋ። <verse eid="NUM 31:32-35"/><verse number="36" style="v" sid="NUM 31:36"/>ኦላን ኦለቴዳዋንታ ጋኬዳ ባጋ ሻኩ 337,500 ዶርሳቱዋ፤ <verse eid="NUM 31:36"/><verse number="37" style="v" sid="NUM 31:37"/>ኡንቱንቱፐ መና ጎዳዉ እሞታ ከሴዳዋንቱ 675. <verse eid="NUM 31:37"/><verse number="38" style="v" sid="NUM 31:38"/>ሚዛቱ 36,000፤ ኡንቱንቱፐ መና ጎዳዉ እሞታ ከሴዳዋንቱ 72. <verse eid="NUM 31:38"/><verse number="39" style="v" sid="NUM 31:39"/>ሀረቱ 30,500 ኡንቱንቱፐ መና ጎዳዉ እሞታ ከሴዳዋንቱ 61. <verse eid="NUM 31:39"/><verse number="40" style="v" sid="NUM 31:40"/>ማጫ አሳቱ 16,000 ኡንቱንቱፐ መና ጎዳዉ እሞታ ከሴዳዋንቱ፥ 32. <verse eid="NUM 31:40"/><verse number="41" style="v" sid="NUM 31:41"/>መና ጎዳይ ሙሳ አዛዜዳዋዳን፥ መና ጎዳ ጋክያ እሞታ ሙሴ ቄስያ ኤልኣዛራዉ እሜዳ።<verse eid="NUM 31:41"/></para>
  <para style="p">
    <verse number="42-46" style="v" sid="NUM 31:42-46"/>ኦላንቻቱ አሄዳ ኦሞዱዋ ሙሴ ላኡ ከሲደ ሻክና፥ እስራኤልያ ማባራ ጋኬዳ ሻኩ 337,500 ዶርሳቱዋ፥ 36,000 ሚዛቱዋ፥ 30,500 ሀረቱዋነ 16,000 ማጫ አሳቱዋ። <verse eid="NUM 31:42-46"/><verse number="47" style="v" sid="NUM 31:47"/>እስራኤልያ ማባራ ጋኬዳ ሻኩዋፐ እሻታሙ እሻታሙ አሳፐ እቱዋነ እሻታሙ እሻታሙ መህያፐ እቱዋ ሙሴ አኪደ፥ መና ጎዳይ ባረና አዛዜዳዋዳን፥ መና ጎዳ ዱንካንያዉ አዎትያ ሌዋቶ እሜዳ።<verse eid="NUM 31:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 31:48"/>ሄዋፐ ጉይያን፥ ኦላ ጋዳዋቱ፥ ሻላቃቱነ ጼቱዋ ካፓቱ ሙሴኮ ዬድኖ። <verse eid="NUM 31:48"/><verse number="49" style="v" sid="NUM 31:49"/>ኡንቱንቱ ሙሳ፥ “ኑን ነ ቆማቱ ኑ አዛዙዋ ጋርሳን ደእያ ኦላንቻቱዋ ፓይድና፥ እቱነ ፓጭቤና። <verse eid="NUM 31:49"/><verse number="50" style="v" sid="NUM 31:50"/>መና ጎዳይ ኑ ሸምፑዋ አሼዳ ድራዉ፥ ኑን ሁጲያን ሁጲያን አኬዳ ዎርቃ አሌቆቱዋ፥ ኩሽያ ሳጋየቱዋ፥ ገድያ አልቦቱዋ፥ ምግዶቱዋ፥ ሀይ ሎታቱዋነ ቆያን አያ አሌቁዋ መና ጎዳዉ እሙዋ አሄዶ” ያጌድኖ። <verse eid="NUM 31:50"/><verse number="51" style="v" sid="NUM 31:51"/>ሙሴነ ቄሲ ኤልኣዛር ዎርቃ አሌቆቱዋ ኡባ ኡንቱንቱፐ አኬድኖ። <verse eid="NUM 31:51"/><verse number="52" style="v" sid="NUM 31:52"/>ሻኣ ካፓቱነ ጼቱዋ ካፓቱ አሂደ መና ጎዳዉ እሜዳ ዎርቃይ ኡባይ ላኡ ጼቱ ኪሎ ግራመ ግድያዋ። <verse eid="NUM 31:52"/><verse number="53" style="v" sid="NUM 31:53"/>ሽን እት እት ኦላንቻቱ ኡባይ ባረንቱ ኦሞዱዋ ኦሞዱዋ ባረዉ አኬድኖ። <verse eid="NUM 31:53"/><verse number="54" style="v" sid="NUM 31:54"/>ሙሴነ ቄሲ ኤልኣዛር ሻኣ ካፓቱዋፐነ ጼቱዋ ካፓቱዋፐ አኬዳ ዎርቃ መና ጎዳ ስንን እስራኤልያ አሳ ሀሳይሳና ማላ፥ መና ጎዳ ዱንካንያ ግዱዋ ገልሴድኖ።<verse eid="NUM 31:54"/></para>
  <chapter eid="NUM 31"/>
  <chapter number="32" style="c" sid="NUM 32"/>
  <para style="s1">ዮርዳኖሳ ሻፋ ዶላሃ ባጋና ደእያ ዛራቱዋ</para>
  <para style="r">(<ref loc="DEU 3:12-22">ዛረ. 3:12-22</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 32:1"/>ሮቤላ ዛረቶነ ጋዳ ዛረቶ ሎይ ዳሮ መሂ ደኤ። ኡንቱንቱ ያእዜራ ቢታይነ ጋላኣደ ቢታይ መህያዉ እንጀ ግድያዋ በኤድኖ። <verse eid="NUM 32:1"/><verse number="2" style="v" sid="NUM 32:2"/>ኡንቱንቱ ሙሴኮ፥ ቄስያ ኤልኣዛራኮነ ማባራ ካፓቱዋኮ ዪደ፥ ኡንቱንታ ሀዋዳን ያጌድኖ፤ <verse eid="NUM 32:2"/><verse number="3-4" style="v" sid="NUM 32:3-4"/>“መና ጎዳይ እስራኤልያ አሳን ጾንሴዳ ቢታቱ፥ አጻሮት፥ ድቦን፥ ያእዜር፥ ኒምር፥ ሀሰቦና፥ ኤልኣል፥ ሴብም፥ ናቦነ ባኦን መህያዉ እንጀ ቢታ፤ ኑዉ ህንተ ቆማቶ መሂ ደኤ። <verse eid="NUM 32:3-4"/><verse number="5" style="v" sid="NUM 32:5"/>ኑን ህንተና ናሸቼዳዋ ግዶፐ፥ ሀ ቢታቱ ኑ ህንተ ቆማቶ ላታ ጋደ ግዲደ እመትኖ። ኑና ዮርዳኖሳ ሻፋ ሄፍን ፕንፕተ” ያጌድኖ።<verse eid="NUM 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 32:6"/>ሙሴ ጋዳ ዛራቱዋነ ሮቤላ ዛራቱዋ ሀዋዳን ያጌዳ፤ “ሀራ እስራኤልያ አሳይ ኦላ ብያ ዎደ፥ ህንተ ሀዋን ኡቲቴ? <verse eid="NUM 32:6"/><verse number="7" style="v" sid="NUM 32:7"/>መና ጎዳይ ኡንቱንቶ እሜዳ ቢታ እስራኤላቱ ፕነናዳን፥ ህንተ አያዉ ኡንቱንቱ ዎዛና ሹግሲቴ? <verse eid="NUM 32:7"/><verse number="8" style="v" sid="NUM 32:8"/>ቃዴሳ-ባርነፐ ሄ ቢታ ዎች ጼላናዉ ህንተ አዎቱዋ ታን የዴዳ ዎደ፥ ኡንቱንቱካ ሀዋዳን ኦድኖ።<note caller="-" style="x"><char style="xo" closed="false">32:8-9 </char><char style="xt" closed="false"><ref loc="NUM 13:17-33">ፓይ. 13:17-33</ref></char></note> <verse eid="NUM 32:8"/><verse number="9" style="v" sid="NUM 32:9"/>ዋኒደ ጎፐ፥ ኡንቱንቱ ኤሽኮላ ዛንጋራ ከሲደ፥ ሄ ቢታ ጼሌዳ ዎደ፥ እስራኤላቱ መና ጎዳይ ኡንቱንቶ እሜዳ ቢታ ገለና ማላ፥ ኡንቱንቱ እስራኤላቱዋ ዎዛና ሹግሴድኖ። <verse eid="NUM 32:9"/><verse number="10" style="v" sid="NUM 32:10"/>መና ጎዳይ ሄ ጋላስ ሀንቁዋ ኤጽ ከሲደ፥ ሀዋዳን ያጊደ ጫቄዳ፤<note caller="-" style="x"><char style="xo" closed="false">32:10-13 </char><char style="xt" closed="false"><ref loc="NUM 14:26-35">ፓይ. 14:26-35</ref></char></note> <verse eid="NUM 32:10"/><verse number="11-12" style="v" sid="NUM 32:11-12"/>‘መና ጎዳ ባረንቱ ኩመን ዎዛናፐ ካሌዳ ቀኒዝያ ይፉነ ናኣ ካሌባፐነ ኔዌ ናኣ ኢያሱፐ አትና፥ የለቶደፐ ላታሙ ላይነ ሄዋፐ ቦላና ደእያ አቱማ አሳን ግብጼ ጋድያፐ ከሴዳዋንቱፐ እቱነ፥ ታን አብራሃማዉ፥ ይሳቃዉነ ያቆባዉ እማናዉ ጫቄዳ ቢታ በኤና። አያዉ ጎፐ፥ ኡንቱንቱ ታና ባረንቱ ኩመን ዎዛናፐ ካልበይክኖ’ ያጊደ ጫቄዳ። <verse eid="NUM 32:11-12"/><verse number="13" style="v" sid="NUM 32:13"/>መና ጎዳ ሀንቁ እስራኤልያ ቦላ ኤጽ ከሴዳ፤ ያትና ጾሳ ስንን ኢታ ኦዳ ሄ የለታ ኡባይ ዉር ያና ጋካናዉ፥ መላ ቢታን ኦይታሙ ላይ እ ኡንቱንታ ቶይላዬዳ። <verse eid="NUM 32:13"/><verse number="14" style="v" sid="NUM 32:14"/>ህንተኖ፥ ናጋራንቻ የለታቶ፥ መና ጎዳይ እስራኤልያ ቦላ ጉጅ ሀንቁዋ ኤጽ ከሳናዳን፥ ህንተ ህንተ አዎቱዋ ሳኣን ሀእ ኤቄድታ። <verse eid="NUM 32:14"/><verse number="15" style="v" sid="NUM 32:15"/>ህንተ መና ጎዳ ካልያዋ አጊደ ዎራ ስሞፐ፥ እ ቃይካ ባረ አሳ መላ ቢታን አግ ባሻና። ያቲደ ህንተ ሀ አሳ ኡባ ይሳና” ያጌዳ።<verse eid="NUM 32:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 32:16"/>ኡንቱንቱ ሙሴ ማታ ዪደ፥ አ ሀዋዳን ያጌድኖ፤ “ኑን ሀዋን ኑ መሄቶ ድርሳ፥ ኑ ናናዉ ካታማቱዋ ኬጻና። <verse eid="NUM 32:16"/><verse number="17" style="v" sid="NUM 32:17"/>ሽን ኑን ኦላ ሚሻ ዳንጪደ፥ እስራኤልያ አሳ ኡንቱንቱ ሳኣ ጋና ጋካናዉ ኦለታናዉ ባና። ሄዋ ኬሻን፥ ሀ ጋድያን ደእያ አሳቱዋፐ ናገታናዉ፥ ኑ ናናይነ ማጫ አሳይ ግምበቲደ ኡቴዳ ካታማቱዋን ደእኖ። <verse eid="NUM 32:17"/><verse number="18" style="v" sid="NUM 32:18"/>እስራኤላቱ ኡባይ ባረንቱ ላታ ላታ አካና ጋካናዉ፥ ኑን ኑ ጎለ ስሞኮ። <verse eid="NUM 32:18"/><verse number="19" style="v" sid="NUM 32:19"/>ኑን ኑ ላታ ዮርዳኖሳ ሻፋፐ ሀፍን አዋይ ዶልያ ባጋና ላቴዳ ድራዉ፥ ኑን ዮርዳኖሳፐ ሄፍን ባጋና፥ ያን ኡንቱንቱና ላታ ላቶኮ” ያጌድኖ።<verse eid="NUM 32:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 32:20"/>ሙሴ ኡንቱንቱ፥ “ህንተ ሀዋ ኦፐ፥ ህንተ መና ጎዳ ስንን ኦላ ባናዉ ጊጎፐነ <verse eid="NUM 32:20"/><verse number="21" style="v" sid="NUM 32:21"/>ህንተ ኦላንቻቱ ኡባይ ኦላ ሚሻ ዳንጪደ፥ መና ጎዳይ ባረ ሞርከቱዋ ባረ ስንፐ የደርሳና ጋካናዉ፥ ዮርዳኖሳ ሻፋ ጾሳ ስንን ፕኖፐ፥ <verse eid="NUM 32:21"/><verse number="22" style="v" sid="NUM 32:22"/>መና ጎዳይ ሄ ቢታ ጾኔዳዋፐ ጉይያን፥ ህንተ ስማናዉ ዳንዳዪታ። ያቶፐ፥ ህንተ ኦለታናዉ በስያ ኦላ መና ጎዳዉነ እስራኤልያ አሳዉ ኦለቲደ ፖሌድታ ግያዋ። ቃይ ሄ ቢታይ መና ጎዳ ስንን ህንተንቶ ላታ ቢታ ግዳናዋ።<verse eid="NUM 32:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 32:23"/>“ሽን ህንተ ሄዋዳን ኦናን እጾፐ፥ መና ጎዳ ቦላ ናጋራ ኦታ፤ ስም ህንተና ህንተ ናጋራይ ጋክያዋ ቱሙ ኤርተ። <verse eid="NUM 32:23"/><verse number="24" style="v" sid="NUM 32:24"/>ህንተ ህንተ ናናዉነ ማጫ አሳዉ ካታማቱዋ ኬጽተ፤ ህንተ ዶርሳ ዉድያዉካ ባሉዋ ጊግስተ፤ ሽን ህንተ ጌዳዋ አገናን ኦተ” ያጌዳ።<verse eid="NUM 32:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 32:25"/>ጋዳ ዛራቱነ ሮቤላ ዛራቱ ሙሳ፥ “ኑን ነ ቆማቱ ኔን ኑ ጎዳይ አዛዜዳዋዳን ኦና። <verse eid="NUM 32:25"/><verse number="26" style="v" sid="NUM 32:26"/>ኑ ናናቱነ ኑ ማጫ አሳቱ፥ ኑ ዶርሳቱነ ኑ ሚዛቱ ሀዋን ጋላኣደ ካታማቱዋን ደእሽኖ። <verse eid="NUM 32:26"/><verse number="27" style="v" sid="NUM 32:27"/>ሽን ኑን ነ ቆማቱ፥ ኦላዉ ዳንጬዳ ኦላንቻቱ ኡባይ፥ ኔን ኑ ጎዳይ ግያዋዳን፥ ኦለታናዉ መና ጎዳ ስንን ዮርዳኖሳ ሻፋ ፕናና” ያጌድኖ።<verse eid="NUM 32:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 32:28"/>ሄዋ ድራዉ፥ ሙሴ ቄስያ ኤልኣዛራ፥ ኔዌ ናኣ ኢያሳነ እስራኤልያ ዛራቱ ካፓቱዋ ኡንቱንቱዋ አዛዜዳ።<note caller="-" style="x"><char style="xo" closed="false">32:28-32 </char><char style="xt" closed="false"><ref loc="JOS 1:12-15">ኢያሳ 1:12-15</ref></char></note> <verse eid="NUM 32:28"/><verse number="29" style="v" sid="NUM 32:29"/>ሙሴ ኡንቱንታ ሀዋዳን ያጌዳ፤ “ጋዳ ዛራቱነ ሮቤላ ዛራቱ ኡባይ ኦላ ሚሻ ዳንጪደ፥ መና ጎዳ ስንን ህንተናና ዮርዳኖሳ ሻፋ ፕኖፐነ ህንተ ሄ ቢታ ጾኖፐ፥ ሄዋፐ ጉይያን፥ ጋላኣደ ቢታ ህንተ ኡንቱንታ ላትስተ። <verse eid="NUM 32:29"/><verse number="30" style="v" sid="NUM 32:30"/>ሽን ኡንቱንቱ ኦላ ሚሻ ዳንጪደ፥ ህንተናና ፕነናን እጾፐ፥ ኡንቱንቱ ካናነ ቢታ ህንተናና ላትኖ” ያጌዳ።<verse eid="NUM 32:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 32:31"/>ጋዳ ዛራቱነ ሮቤላ ዛራቱ ዛሪደ፥ “ኑን ነ ቆማቱ መና ጎዳይ ጌዳዋ ኦና። <verse eid="NUM 32:31"/><verse number="32" style="v" sid="NUM 32:32"/>ኦላ ሚሻ ዳንጪደ፥ መና ጎዳ ስንን ኑን ካናነ ቢታ ገላናዉ ፕናና፤ ሽን ኑን ላትያ ላታይ ዮርዳኖሳፐ ሀፍን ባጋና ግዳናዋ” ያጌድኖ።<verse eid="NUM 32:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 32:33"/>ሄዋ ድራዉ፥ ሙሴ ጋዳ ዛረቶ፥ ሮቤላ ዛረቶነ ዮሴፎ ናኣ ምናሰ ዛራቱዋፐ ባጋዉ አሞረቱ ካትያ ስሆና ካዉተነ ባሳነ ካትያ ኦጋ ካዉተ፥ ኡንቱንቱ ዩሹዋን ደእያ ካታማቱዋና እሜዳ። <verse eid="NUM 32:33"/><verse number="34" style="v" sid="NUM 32:34"/>ጋዳ ዛራቱ ድቦና፥ አጻሮታ፥ አሮኤራ <verse eid="NUM 32:34"/><verse number="35" style="v" sid="NUM 32:35"/>አጽሮት-ሾፋና፥ ያእዜራ፥ ዮግባሀ፥ <verse eid="NUM 32:35"/><verse number="36" style="v" sid="NUM 32:36"/>ቤት-ኒምራነ ቤት-ሃራና ጌተትያ ግምቢያን ድረቴዳ ካታማቱዋ ዛረደ ኬጼድኖ። ባረ ዶርሳቶካ ኡንቱንቱ ባሉዋ ጊግሴድኖ።<verse eid="NUM 32:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 32:37"/>ሮቤላ ዛራቱካ ሀሰቦና፥ ኤልኣላ፥ ቅርያታይማነ፥ <verse eid="NUM 32:37"/><verse number="38" style="v" sid="NUM 32:38"/>ናባ፥ ባኣል-ማኦናነ (ሄ ካታማቱዋፐ እቱ እቱ ሱን ላሜድኖ) ሲብማ ጌተትያ ካታማቱዋ ዛረ ኬጼድኖ።<verse eid="NUM 32:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 32:39"/>ምናሰ ናኣ ማክራ ያራቱ ጋላኣደ ቢደ፥ ኦላይ ኦይቂደ፥ ያን ደእያ አሞረቱዋ የደርሴድኖ። <verse eid="NUM 32:39"/><verse number="40" style="v" sid="NUM 32:40"/>ሄዋ ድራዉ፥ ምናሰ ናኣ ማክራ ያራቶ ሙሴ ጋላኣደ ቢታ እምና፥ ኡንቱንቱ ያን ደኤድኖ። <verse eid="NUM 32:40"/><verse number="41" style="v" sid="NUM 32:41"/>ምናሰ ዛረ ግድያ ያኢር ቢደ፥ ኡንቱንቱ ኦላይ ኦይቂደ፥ ሀቦት-ያኢራ ካታማቱዋ ያጊደ ሱንዳ። <verse eid="NUM 32:41"/><verse number="42" style="v" sid="NUM 32:42"/>ኖባህ ቢደ፥ ቃናታ ካታማነ አ ዩሹዋን ደእያ ሄራቱዋ ኦላን ኦይቂደ፥ ባረ ሱንን ኖባሀ ጊደ ጼሴዳ።<verse eid="NUM 32:42"/></para>
  <chapter eid="NUM 32"/>
  <chapter number="33" style="c" sid="NUM 33"/>
  <para style="s1">ግብጼፐ ሞኣበ ጋካናዉ ደእያ ሀመይ ቃንን</para>
  <para style="r">(<ref loc="NUM 33:1-49">33:1-49</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 33:1"/>እስራኤላቱ ሙሴነ አሮን ካለና፥ ባረንቱ ጩጉዋን ጩጉዋን ግብጼፐ ከሴዳ ዎደ፥ ያቲደ ሀመቴድኖ። <verse eid="NUM 33:1"/><verse number="2" style="v" sid="NUM 33:2"/>መና ጎዳይ አዛዝና፥ ኡንቱንቱ ባና ቡሳ ዶሜዳ ሳኣ ሙሴ ጻፌዳ፤ ኡንቱንቱ ቡሳ ማራይ ሀዋ።<verse eid="NUM 33:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 33:3"/>ኮይሮ አግናዉ ታማነ እቼሸን ጋላስ፥ ፓስጋ ቦንችያ ጋላሳፐ ካልያ ጋላስ ደንዲደ፥ ግብጼ አሳይ ኡባይ ጼልሽን፥ ያየናን ራምሳፐ ከሴድኖ። <verse eid="NUM 33:3"/><verse number="4" style="v" sid="NUM 33:4"/>ሄ ዎደ ግብጼ አሳይ መና ጎዳይ ዎዳ ባረንቱ ባይራ ናናቱዋ ሞጊኖ። ሀዋዳን ኦደ፥ መና ጎዳይ ኡንቱንቱ ጾሳቱዋ ቦላ ፕርዳ አሄዳ።<verse eid="NUM 33:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 33:5"/>እስራኤላቱ ራምሳፐ ደንዲደ፥ ሱኮታ ግያ ሳኣን ዱንካኔድኖ።<verse eid="NUM 33:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 33:6"/>ሱኮታፐ ደንዲደ፥ መላ ቢታ ጼራን ደእያ ኤታማን ዱንካኔድኖ።<verse eid="NUM 33:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 33:7"/>ኤታማፐ ደንዲደ፥ ባኣል-ጻፎናፐ አዋይ ዶልያ ባጋና ደእያ ፕሃህሮታ ስሚደ፥ ምግዶላ ማታን ዱንካኔድኖ።<verse eid="NUM 33:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 33:8"/>ፕሃህሮታፐ ደንዲደ፥ ዞኦ አባ ፕኒደ፥ መላ ቢታ ቤድኖ። ኤታማ መላ ቢታን ሄዙ ጋላሳ ኦግያ ሀመቲደ፥ ማራን ዱንካኔድኖ።<verse eid="NUM 33:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 33:9"/>ማራፐ ደንዲደ፥ ታማነ ላኡ ፑልቶቱነ ላፑን ታሙ ዛምባቱ ደእያ ኤሊማ ቢደ፥ ያን ዱንካኔድኖ።<verse eid="NUM 33:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 33:10"/>ኤሊማፐ ደንዲደ፥ ዞኦ አባ ማታን ዱንካኔድኖ።<verse eid="NUM 33:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 33:11"/>ዞኦ አባ ላንቂያፐ ደንዲደ፥ ሲና መላ ቢታን ዱንካኔድኖ።<verse eid="NUM 33:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 33:12"/>ሲና መላ ቢታፐ ደንዲደ፥ ዶፍቃን ዱንካኔድኖ።<verse eid="NUM 33:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 33:13"/>ዶፍቃፐ ደንዲደ፥ አሉሻን ዱንካኔድኖ።<verse eid="NUM 33:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 33:14"/>አሉሻፐ ደንዲደ፥ ራፊድማን ዱንካኔድኖ። ያን አሳዉ ኡሻናዉ ሃይ ባዋ።<verse eid="NUM 33:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 33:15"/>ራፊድማፐ ደንዲደ፥ ሲና መላ ቢታን ዱንካኔድኖ።<verse eid="NUM 33:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 33:16"/>ሲና መላ ቢታፐ ደንዲደ፥ ክብሮት-ሀታባር (አሙዋ ዱፉዋ ግያ ሳን ዱንካኔድኖ)።<verse eid="NUM 33:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 33:17"/>ክብሮት-ሀታባር (አሙዋ ዱፉዋ) ግያ ሳፐ ደንዲደ፥ ሀጸሮታን ዱንካኔድኖ።<verse eid="NUM 33:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 33:18"/>ሀጸሮታፐ ደንዲደ፥ ሪትማን ዱንካኔድኖ።<verse eid="NUM 33:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 33:19"/>ሪትማፐ ደንዲደ፥ ርሞን-ፐሬዛን ዱንካኔድኖ።<verse eid="NUM 33:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 33:20"/>ርሞን-ፐሬዛፐ ደንዲደ፥ ሊብናን ዱንካኔድኖ።<verse eid="NUM 33:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 33:21"/>ሊብናፐ ደንዲደ፥ ሪሳን ዱንካኔድኖ።<verse eid="NUM 33:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 33:22"/>ሪሳፐ ደንዲደ፥ ቃሄላታን ዱንካኔድኖ።<verse eid="NUM 33:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 33:23"/>ቃሄላታፐ ደንዲደ፥ ሸፋራ ደርያን ዱንካኔድኖ።<verse eid="NUM 33:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 33:24"/>ሸፋራ ደርያፐ ደንዲደ፥ ሀራዳን ዱንካኔድኖ።<verse eid="NUM 33:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 33:25"/>ሀራዳፐ ደንዲደ፥ ማቅሄሎታን ዱንካኔድኖ።<verse eid="NUM 33:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 33:26"/>ማቅሄሎታፐ ደንዲደ፥ ታሃታን ዱንካኔድኖ።<verse eid="NUM 33:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 33:27"/>ታሃታፐ ደንዲደ፥ ታራን ዱንካኔድኖ።<verse eid="NUM 33:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 33:28"/>ታራፐ ደንዲደ፥ ሚትቃን ዱንካኔድኖ።<verse eid="NUM 33:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 33:29"/>ሚትቃፐ ደንዲደ፥ ሀሽሞናን ዱንካኔድኖ።<verse eid="NUM 33:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 33:30"/>ሀሽሞናፐ ደንዲደ፥ ሞሰሮታን ዱንካኔድኖ።<verse eid="NUM 33:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 33:31"/>ሞሰሮታፐ ደንዲደ፥ በነ-ያእቃናን ዱንካኔድኖ።<verse eid="NUM 33:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 33:32"/>በነ-ያእቃናፐ ደንዲደ፥ ሆር-ሀግድጋዳን ዱንካኔድኖ።<verse eid="NUM 33:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 33:33"/>ሆር-ሀግድጋዳፐ ደንዲደ፥ ዮጽባታን ዱንካኔድኖ።<verse eid="NUM 33:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 33:34"/>ዮጽባታፐ ደንዲደ፥ አብሮናን ዱንካኔድኖ።<verse eid="NUM 33:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 33:35"/>አብሮናፐ ደንዲደ፥ ኤጽዮን-ጋብራን ዱንካኔድኖ።<verse eid="NUM 33:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 33:36"/>ኤጽዮን-ጋብራፐ ደንዲደ፥ ጺና መላ ቢታን ደእያ ቃዴሳን ዱንካኔድኖ።<verse eid="NUM 33:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 33:37"/>ቃዴሳፐ ደንዲደ፥ ኤዶማ ቢታ ዛዋን ደእያ ሆራ ደርያን ዱንካኔድኖ። <verse eid="NUM 33:37"/><verse number="38" style="v" sid="NUM 33:38"/>ቄሲ አሮን መና ጎዳይ አዛዝና፥ ሆራ ደርያ ሁጲያ ከሴዳ፤ እስራኤላቱ ግብጼ ጋድያፐ ከሴዳ ኦይታሙን ላይን፥ እቼሸን አግናን፥ አግናዉ ኮይሮ ጋላሳን ያን ሀይቄዳ።<note caller="-" style="x"><char style="xo" closed="false">33:38 </char><char style="xt" closed="false"><ref loc="NUM 20:22-28">ፓይ. 20:22-28</ref>፤ <ref loc="DEU 10:6">ዛረ. 10:6</ref>፤ <ref loc="DEU 32:50">32:50</ref></char></note> <verse eid="NUM 33:38"/><verse number="39" style="v" sid="NUM 33:39"/>አሮን ሆራ ደርያ ሁጲያን ሀይቂያ ዎደ፥ አ ላይይ ጼታነ ላታማነ ሄዛ።<verse eid="NUM 33:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 33:40"/>ኔጌባ መላ ቢታን፥ ካናነን ደእያ አራዳ ግያሳ ካቲ እስራኤልያ አሳ ዩሳ ስሴዳ።<note caller="-" style="x"><char style="xo" closed="false">33:40 </char><char style="xt" closed="false"><ref loc="NUM 21:1">ፓይ. 21:1</ref></char></note><verse eid="NUM 33:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 33:41"/>እስራኤላቱ ሆራ ደርያፐ ደንዲደ፥ ጻልሞናን ዱንካኔድኖ።<verse eid="NUM 33:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 33:42"/>ጻልሞናፐ ደንዲደ፥ ፑኖናን ዱንካኔድኖ።<verse eid="NUM 33:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="NUM 33:43"/>ፑኖናፐ ደንዲደ፥ ኦቦታን ዱንካኔድኖ።<verse eid="NUM 33:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 33:44"/>ኦቦታፐ ደንዲደ፥ ሞኣባ ቢታ ዛዋን ደእያ እየ አባርማን ዱንካኔድኖ።<verse eid="NUM 33:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="NUM 33:45"/>እየ አባርማፐ ደንዲደ፥ ድቦና-ጋዳን ዱንካኔድኖ።<verse eid="NUM 33:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 33:46"/>ድቦና-ጋዳፐ ደንዲደ፥ አልሞና-ድብላታይማን ዱንካኔድኖ።<verse eid="NUM 33:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="NUM 33:47"/>አልሞና-ድብላታይማፐ ደንዲደ፥ ናቦ ደርያ ማታን አባርማ ደረቱዋን ዱንካኔድኖ።<verse eid="NUM 33:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 33:48"/>አባርማ ደረቱዋፐ ደንዲደ፥ ያርኮፐ ሄፍንና፥ ዮርዳኖሳ ሻፋ ማታን ደእያ ሞኣባ ደምባን ዱንካኔድኖ። <verse eid="NUM 33:48"/><verse number="49" style="v" sid="NUM 33:49"/>ዮርዳኖሳ ሻፋ ማታን ደእያ ሞኣባ ደምባን፥ ቤት-ያሽሞታፐነ አቤል-ሺጽማ ግዱዋን ዱንካኔድኖ።<verse eid="NUM 33:49"/></para>
  <para style="s1">ዮርዳኖሳ ፕናናፐ ካሰቲደ እመቴዳ አዛዙዋ</para>
  <para style="r">(<ref loc="NUM 33:50-36:13">33:50—36:13</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="NUM 33:50"/>እያርኮ ሄፍንና፥ ዮርዳኖሳ ሻፋ ማታን ደእያ ሞኣባ ደምባን መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="NUM 33:50"/><verse number="51" style="v" sid="NUM 33:51"/>“እስራኤላቱዋ ኔን ያጋ፤ ‘ዮርዳኖሳ ሻፋ ፕኒደ፥ ካናነ ቢታ ህንተ ገልያ ዎደ፥ <verse eid="NUM 33:51"/><verse number="52" style="v" sid="NUM 33:52"/>ሄ ጋድያን ደእያ አሳ ኡባ ህንተ ስንፐ የደርስተ፤ ሹቻፐ ማሰቴዳ ኡንቱንቱ ምስለቱዋ ኡባነ ሲልሲደ መዳ ኤቃቱዋ ኡባ ይስተ። ኡንቱንቱ ጎይንያ ቃ ሳኣ ኡባካ ላልተ። <verse eid="NUM 33:52"/><verse number="53" style="v" sid="NUM 33:53"/>ታን ህንተንቶ ሄ ቢታ ላታዉ እሜዳ ድራዉ፥ ሄ ቢታ ላቲደ፥ አን ደእተ። <verse eid="NUM 33:53"/><verse number="54" style="v" sid="NUM 33:54"/>ህንተ ዛርያን ዛርያን ሳማ ከሲደ፥ ቢታ ሻክተ። ፓይዱዋን ጮራትያ ዛረቶ ዳሮ ላታ እምተ፤ ፓይዱዋን ጉጽያ ዛረቶ ጉ ላታ እምተ። ሳማን ኡንቱንታ ጋኬዳ ሀቃዌነ ኡንቱንቱዋ ግዳናዋ። ቢታ ህንተ ማይዛ አዎቱዋ ዛርያን ዛርያን ግሽ አኪታ።<note caller="-" style="x"><char style="xo" closed="false">33:54 </char><char style="xt" closed="false"><ref loc="NUM 26:54-56">ፓይ. 26:54-56</ref></char></note><verse eid="NUM 33:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="NUM 33:55"/>“ ‘ሽን ሄ ጋድያን ደእያ አሳ ህንተ የደርሰናን አጎፐ፥ ህንተ አሼዳዋንቱ ህንተንቶ ህንተ አይፍያዉ ፕንጮ፥ ህንተ ምይያዉ አጉን ግዳና፤ ህንተ ደአና ጋድያን ኡንቱንቱ ህንተና ዋይሳና። <verse eid="NUM 33:55"/><verse number="56" style="v" sid="NUM 33:56"/>ህንተ ኡንቱንታ የደርሰናን አጎፐ፥ ኡንቱንቱ ቦላ ታን ኦናዉ ቆፔዳዋ ህንተ ቦላ ኦና’ ያጋደ ኦዳ” ያጌዳ።<verse eid="NUM 33:56"/></para>
  <chapter eid="NUM 33"/>
  <chapter number="34" style="c" sid="NUM 34"/>
  <para style="s1">እስራኤልያ ቢታ ዛዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 34:1"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="NUM 34:1"/><verse number="2" style="v" sid="NUM 34:2"/>“ኔን እስራኤላቱዋ ሀዋዳን ያጋደ አዛዛ፤ ‘ላታዳን ህንተና ጋክያ ካናነ ቢታ ዛዋይ ሀዋ። <verse eid="NUM 34:2"/><verse number="3" style="v" sid="NUM 34:3"/>ገድሳ ባጋና ህንተ ዛዋይ ጺና መላ ቢታነ ኤዶማ ዛዋ ግዳናዋ። አዋይ ዶልያ ባጋና ህንተ ገድሳ ዛዋይ ማጽንያ አባ ገድሳፐ ዶሜ፤ <verse eid="NUM 34:3"/><verse number="4" style="v" sid="NUM 34:4"/>አቅራቢማ ፑደና ገድሳ ባጋና ስሚደ፥ ጺና መላ ቢታ አደ፥ ቃዴሳ-ባርነ ገድሳ ጋኬ፤ ሄዋፐ ሀዳር-አዳራ አደ፥ አጽሞና ጋኬ። <verse eid="NUM 34:4"/><verse number="5" style="v" sid="NUM 34:5"/>አጽሞናፐ ግብጼ ሻፋኮ ስሚደ፥ ሜድተራነ አባ ጋኬ።<verse eid="NUM 34:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 34:6"/>“ ‘አዋይ ዉልያ ባጋና ህንተ ዛዋይ ሜድተራነ አባ ጋጻ ግዳናዋ።<verse eid="NUM 34:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 34:7"/>“ ‘ሁጲሳ ባጋና ህንተ ዛዋይ ሜድተራነ አባፐ ሆራ ደርያ ስት ኦ ቢደ፥ <verse eid="NUM 34:7"/><verse number="8" style="v" sid="NUM 34:8"/>ሆራ ደርያፐ ሌቦ-ሀማታ ፕኑዋ ጋካናሳ፤ ሄዋፐ ጻዳዳን ዛዋቴ። <verse eid="NUM 34:8"/><verse number="9" style="v" sid="NUM 34:9"/>ቃይ ዝፍሮነፐ ቢደ፥ ሀጻር-ኤናና ጋኬ። ሁጲሳ ባጋና ህንተ ዛዋይ ሀዋ ግዳናዋ።<verse eid="NUM 34:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 34:10"/>“ ‘አዋይ ዶልያ ባጋና ህንተ ዛዋይ ሀጻር-ኤናናፐ ሻፋማ ጋካናዉ ስት ኦ ቢደ፥ <verse eid="NUM 34:10"/><verse number="11" style="v" sid="NUM 34:11"/>ሻፋማፐ ቢደ፥ አይናፐ አዋይ ዶልያ ባጋና ደእያ ርብላ ዎደ፥ ጋሊላ አባፐ አዋይ ዶልያ ባጋና ደእያ ደርያ ጋኬ። <verse eid="NUM 34:11"/><verse number="12" style="v" sid="NUM 34:12"/>ሄዋፐ ዱገ ዮርዳኖሳ ሻፋ ዎ ዛዋቲደ፥ ማጽንያ አባ ጋኬ። ህንተ ቢታ ዛዋይ ኡባ ባጋናካ ሀዋ’ ያጋ” ያጌዳ።<verse eid="NUM 34:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 34:13"/>ሙሴ እስራኤላቱዋ ሀዋዳን ያጊደ አዛዜዳ፤ “ኤጻ የጊደ፥ ህንተ ላታና ማላ፥ ኡዱፑን ዛረቶነ ባጋ ዛረቶ ሄ ቢታይ እመታናዳን መና ጎዳይ አዛዜዳ።<note caller="-" style="x"><char style="xo" closed="false">34:13-15 </char><char style="xt" closed="false"><ref loc="JOS 14:1-5">ኢያሳ 14:1-5</ref></char></note> <verse eid="NUM 34:13"/><verse number="14-15" style="v" sid="NUM 34:14-15"/>አያዉ ጎፐ፥ ሮቤላ ዛራቱ ጋዳ ዛራቱነ፥ ምናሰ ዛራቱዋፐ ባጋይ ባረንቱ ላታ እያርኮ ሄፍንን ዮርዳኖሳ ሻፋፐ አዋይ ዶልያ ባጋና አኬድኖ” ያጌዳ።<verse eid="NUM 34:14-15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 34:16"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="NUM 34:16"/><verse number="17" style="v" sid="NUM 34:17"/>“ሄ ቢታ ህንተንቶ ላታ ኦደ፥ ሻክ እማና አሳቱ ሱንይ ሀዋ፤ ቄስያ ኤልኣዛራነ ኔዌ ናኣ ኢያሳ። <verse eid="NUM 34:17"/><verse number="18" style="v" sid="NUM 34:18"/>ቃይ ቢታ ሻካናዉ ማዳና ማላ፥ ዛረ ኡባፐ እት እት ካፑዋ ሱንተ። <verse eid="NUM 34:18"/><verse number="19" style="v" sid="NUM 34:19"/>ኡንቱንቱ ሱንይ ሀዋፐ ካሊደ ደእያዋ።</para>
  <para style="m" vid="NUM 34:19">ዛርያ ካፑዋ</para>
  <para style="m" vid="NUM 34:19">ይሁዳ ይፉነ ናኣ ካሌባ፤<verse eid="NUM 34:19"/></para>
  <para style="m">
    <verse number="20" style="v" sid="NUM 34:20"/>ስሞና አምሁዳ ናኣ ሻሉምኤላ፤<verse eid="NUM 34:20"/></para>
  <para style="m">
    <verse number="21" style="v" sid="NUM 34:21"/>ቢንያማ ክስሎና ናኣ ኤልዳዳ፤<verse eid="NUM 34:21"/></para>
  <para style="m">
    <verse number="22" style="v" sid="NUM 34:22"/>ዳና ዮግላ ናኣ ቡቃ፤<verse eid="NUM 34:22"/></para>
  <para style="m">
    <verse number="23" style="v" sid="NUM 34:23"/>ዮሴፎ ናኣ ምናሰ ኤፎዳ ናኣ ሀንኤላ፤<verse eid="NUM 34:23"/></para>
  <para style="m">
    <verse number="24" style="v" sid="NUM 34:24"/>ዮሴፎ ናኣ ኤፍሬማ ሽፍጻና ናኣ ቃሙኤላ፤<verse eid="NUM 34:24"/></para>
  <para style="m">
    <verse number="25" style="v" sid="NUM 34:25"/>ዛብሎና ፓርናካ ናኣ ኤልጻፋና፤<verse eid="NUM 34:25"/></para>
  <para style="m">
    <verse number="26" style="v" sid="NUM 34:26"/>ይሳኮራ አዛና ናኣ ፓልጽኤላ፤<verse eid="NUM 34:26"/></para>
  <para style="m">
    <verse number="27" style="v" sid="NUM 34:27"/>አሴራ ሻሎማ ናኣ አህሁዳ፤<verse eid="NUM 34:27"/></para>
  <para style="m">
    <verse number="28" style="v" sid="NUM 34:28"/>ንፍታሌማ አምሁዳ ናኣ ፓዳህኤላ፤<verse eid="NUM 34:28"/></para>
  <para style="m">
    <verse number="29" style="v" sid="NUM 34:29"/>ካናነ ጋድያን እስራኤላቶ ላታ ሻክ እማና ማላ፥ መና ጎዳይ አዛዜዳ አሳቱ ሀዋንታ” ያጌዳ።<verse eid="NUM 34:29"/></para>
  <chapter eid="NUM 34"/>
  <chapter number="35" style="c" sid="NUM 35"/>
  <para style="s1">ሌዋቶ እመታና ካታማቱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 35:1"/>እያርኮ ሄፍንና፥ ዮርዳኖሳ ሻፋ ማታን ደእያ ሞኣባ ደምባን፥ መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤<note caller="-" style="x"><char style="xo" closed="false">35:1-8 </char><char style="xt" closed="false"><ref loc="JOS 21:1-42">ኢያሳ 21:1-42</ref></char></note> <verse eid="NUM 35:1"/><verse number="2" style="v" sid="NUM 35:2"/>“እስራኤላቱ ባረንቱ ላታፐ ሌዋቱዋ ደአና ካታማቱዋነ ኡንቱንቱ ዩሹዋን ደእያ ሄን ጋደቱዋ እማና ማላ፥ ኔን ኡንቱንታ አዛዛ። <verse eid="NUM 35:2"/><verse number="3" style="v" sid="NUM 35:3"/>ሄ ካታማቱዋን ኡንቱንቱ ደእኖ፤ ሄን ጋደቱ ኡንቱንቱ ሚዛሳ፥ ኡንቱንቱ ዶርሳሳነ ኡንቱንቱ ሀራ መህያ ኡባሳ ግድኖ። <verse eid="NUM 35:3"/><verse number="4" style="v" sid="NUM 35:4"/>ህንተ ሌዋቶ እማና ካታማ ዩሹዋን ደእያ ሄን ጋደቱ ካታማ ግምቢያ ድርሳፐ ካረኮ እት ሻአ ዋ ግድኖ። <verse eid="NUM 35:4"/><verse number="5" style="v" sid="NUM 35:5"/>ካታማፐ ካረና፥ አዋይ ዶልያ ባጋና ላኡ ሻአ ዋ፥ ገድሳ ባጋና ላኡ ሻአ ዋ፥ አዋይ ዉልያ ባጋና ላኡ ሻአ ዋነ ሁጲሳ ባጋና ላኡ ሻአ ዋ ልክተ፤ ያቶፐ ካታማይ ግዶ ልክያን ደአና። ሌዋቱ ሄ ሄራ ባረንቱ ካታማዉ ሄን ጋደ ኦኖ።<verse eid="NUM 35:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 35:6"/>“ሌዋቶ ህንተ እማና ካታማቱ፥ አሳ ዎዳ ኡራይ ባቃቲደ አትያ ኡሱፑን ካታማቱዋ፤ ሄዋንቱ ቦላ ጉጂደ፥ ኦይታማነ ላኡ ሀራ ካታማቱዋ ኡንቱንቶ እምተ። <verse eid="NUM 35:6"/><verse number="7" style="v" sid="NUM 35:7"/>ሌዋቶ ህንተ ኡባና ኦይታማነ ሆስፑን ካታማቱዋ ኡንቱንቱ ሄን ጋደቱዋና እትፐ እምተ። <verse eid="NUM 35:7"/><verse number="8" style="v" sid="NUM 35:8"/>እስራኤላቱዋ ላታፐ ሌዋቶ ህንተ እማና ካታማቱ እት እት ዛሪ ላቴዳዋ ኬሻ ግዳናዉ ኮሼ፤ ጮራ አሳይ ደእያ ዛርያፐ ጮራ ካታማቱዋ አኪተ፤ ሽን ፓይዱዋን ጉ አሳይ ደእያ ዛርያፐ ጉ ካታማቱዋ አኪተ” ያጌዳ።<verse eid="NUM 35:8"/></para>
  <para style="s1">ባቃት አትያ ካታማቱዋ</para>
  <para style="r">(<ref loc="DEU 19:1-13">ዛረ. 19:1-13</ref>፤ <ref loc="JOS 20:1-9">ኢያሳ 20:1-9</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 35:9"/>ሄዋፐ ጉይያን፥ መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="NUM 35:9"/><verse number="10" style="v" sid="NUM 35:10"/>“ኔን እስራኤልያ አሳ ሀዋዳን ያጋ፤ ‘ዮርዳኖሳ ሻፋ ፕኒደ፥ ካናነ ቢታ ህንተ ገልያ ዎደ፥ <verse eid="NUM 35:10"/><verse number="11" style="v" sid="NUM 35:11"/>ኤረናን አሳ ዎዳ ኡራይ ባቃት ቢደ አታና ማላ፥ ካታማቱዋ ህንተንቶ ዶርተ። <verse eid="NUM 35:11"/><verse number="12" style="v" sid="NUM 35:12"/>ኤረናን አሳ ዎዳዌ ሺቁዋ ስን ሙራናዉ ኤቃና ጋካናዉ፥ ሱ አችያዌ አ ዎና ማላ፥ ሄ ካታማቱ ባቃት አትያሳ ግድኖ። <verse eid="NUM 35:12"/><verse number="13" style="v" sid="NUM 35:13"/>ሀ ህንተ እምያ ኡሱፑን ካታማቱ ህንተንቶ ባቃት አትያ ካታማቱዋ ግድኖ። <verse eid="NUM 35:13"/><verse number="14" style="v" sid="NUM 35:14"/>ዮርዳኖሳ ሻፋፐ ሀፍን ባጋና ሄዙ ካታማነ ካናነ ጋድያን ሄዙ ካታማቱዋ ህንተ ባቃት አታናዉ እምተ። <verse eid="NUM 35:14"/><verse number="15" style="v" sid="NUM 35:15"/>ሀ ኡሱፑን ካታማቱ ኤረናን አሳ ዎዳ እስራኤላቱ፥ ሀራ ጋደ አሳቱነ ኡንቱንቱ ግዶን ደእያ በተቱ ባቃቲደ አትያሳ ግድኖ።<verse eid="NUM 35:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 35:16"/>“ ‘እት አሳይ እት አሳ ብራታ ሚሻን ሾጭና፥ ሄ ኡራይ ሀይቆፐ፥ ሄዌ ሸምፑዋ ዎዳዋ፤ ሸምፑዋ ዎዳዌ ሀይቆ። <verse eid="NUM 35:16"/><verse number="17" style="v" sid="NUM 35:17"/>ቃይ ዎና ዳንዳይያ ሹቻ ባረ ኩሽያን ኦይቄዳ አሳይ እት አሳ ሄ ሹቻን ጫድና፥ ሄ ኡራይ ሀይቆፐ፥ ሄዌ ሸምፑዋ ዎዳዋ፤ ሸምፑዋ ዎዳዌ ሀይቆ። <verse eid="NUM 35:17"/><verse number="18" style="v" sid="NUM 35:18"/>ቃይካ ዎና ዳንዳይያ ም ባረ ኩሽያን ኦይቄዳ አሳይ እት አሳ ሄ ምን ሾጭና፥ ሄ ኡራይ ሀይቆፐ፥ ሄዌ ሸምፑዋ ዎዳዋ፤ ሸምፑዋ ዎዳዌ ሀይቆ። <verse eid="NUM 35:18"/><verse number="19" style="v" sid="NUM 35:19"/>ሱ አችያዌ ሄ ሸምፑዋ ዎዳዋ ደሞፐ ዎ።<verse eid="NUM 35:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 35:20"/>“ ‘እት አሳይ እት አሳ ሞርኪደ ጫድና፥ ዎይ ዙጊድ እትባ አ ቦላ ኦልና፥ ሄ ኡራይ ሀይቆፐ፥ <verse eid="NUM 35:20"/><verse number="21" style="v" sid="NUM 35:21"/>ዎይ ሞርኪደ ባረ ኩሽያን ቦክስና፥ ሄ ኡራይ ሀይቆፐ፥ እ ሸምፑዋ ዎዳዋ፤ ሸምፑዋ ዎዳዌ ሀይቆ። ሱ አችያዌ ሸምፑዋ ዎዳዋ ደሞፐ ዎ።<verse eid="NUM 35:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 35:22"/>“ ‘ሽን ሞርከተይ ባይናን፥ እት አሳይ እት አሳ አኬከናን ሱጎፐ፥ ዎይ ዙጊድ ናገናን እትባ አ ቦላ ኦሎፐ፥ <verse eid="NUM 35:22"/><verse number="23" style="v" sid="NUM 35:23"/>ዎይ አ ዎና ዳንዳይያ ሹቻ እ በኤናን አ ቦላ የጎፐነ ሄ ኡራይ ሀይቆፐ፥ ሄዌ አ ሞርከ ግደና ድራዉነ አ ቆሀናዉ ሀልችቤና ድራዉ፥ <verse eid="NUM 35:23"/><verse number="24" style="v" sid="NUM 35:24"/>ያአይ ኤረናን ዎዳዋፐነ ሱ አችያዋፐ ግዱዋን ሀ ዎጋቱዋዳን ፕርዶ። <verse eid="NUM 35:24"/><verse number="25" style="v" sid="NUM 35:25"/>ኤረናን ዎዳዋ ሱ አችያዋ ኩሽያፐ ያአይ አሺደ፥ እ ባቃቲደ አትያ ካታማ ዛሮ። ጌሻ ዛይትያን ኦከቲደ፥ ቄሲ ኡባቱ ካፑ ሀይቃና ጋካናዉ፥ እ ያን ደኦ።<verse eid="NUM 35:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 35:26"/>“ ‘ሽን ኤረናን ዎዳዌ ባቃቲደ አትያ ካታማ ዛዋፐ ካረ ከስያዋ ግዶፐነ፥ <verse eid="NUM 35:26"/><verse number="27" style="v" sid="NUM 35:27"/>ባቃት አትያ ካታማፐ ካረና ሱ አችያዌ አ ደሚደ ዎፐ፥ እ ዎዳዎ ኦሸተና። <verse eid="NUM 35:27"/><verse number="28" style="v" sid="NUM 35:28"/>አያዉ ጎፐ፥ ቄሲ ኡባቱ ካፑ ሀይቃና ጋካናዉ፥ ሄ ኤረናን ዎዳዌ ባረ ባቃቴዳ ካታማን ኡታናዋሽን አጌዳ። ሽን ቄሰ ኡባቱ ካፑ ሀይቄዳዋፐ ጉይያን፥ ኤረናን ዎዳዌ ባረ ላታ ጋደ ስማናዉ ዳንዳዬ።<verse eid="NUM 35:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 35:29"/>“ ‘ህንተዉነ ብሮ የለታና የለታዉ፥ ህንተ ደኢያሳ ኡባን ሀዌ ህገ ግዶ።<verse eid="NUM 35:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 35:30"/>“ ‘አሳ ዎዳ ኦንነ ሸምፑዋ እ ዎዳዋዳን ማርካቱ ማርካትና ሀይቆ፤ ሽን እት አሳ ጻላላይ ማርካትና፥ አይ አሳይነ ሀይቆፖ።<note caller="-" style="x"><char style="xo" closed="false">35:30 </char><char style="xt" closed="false"><ref loc="DEU 17:6">ዛረ. 17:6</ref>፤ <ref loc="DEU 19:15">19:15</ref></char></note> <verse eid="NUM 35:30"/><verse number="31" style="v" sid="NUM 35:31"/>ሸምፑዋ ዎዳ ድራዉ ሀይቃናዉ በስያ አሳ ፓጻ አሻናዉ አጫ አኮፕተ፤ እ ሀይቆ። <verse eid="NUM 35:31"/><verse number="32" style="v" sid="NUM 35:32"/>አትያ ካታማ ባቃቴዳ ኦፐነ ቄሰ ኡባቱ ካፑ ሀይቃናፐ ካሰ፥ እ ጉየ ስሚደ፥ ባረ ጋድያን ደአናዳን ኦናዉ አጫ አኮፕተ።<verse eid="NUM 35:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 35:33"/>“ ‘ሄዋዳን ኦደ፥ ህንተ ደእያ ቢታ ቱንሶፕተ። አያዉ ጎፐ፥ ሱ ጉስያዌ ቢታ ቱንሴ፤ ሱ ጉሴዳዋ ሱናፐ አትና፥ ቢታ አቶ ጊሳናዉ ሀራ ኦግያን ዳንዳየተና <verse eid="NUM 35:33"/><verse number="34" style="v" sid="NUM 35:34"/>ታን፥ መና ጎዳይ፥ እስራኤልያ አሳ ግዱዋን ደእያ ድራዉ፥ ህንተ ደእያ ቢታ፥ ታንካ ደእያ ቢታ ቱንሶፕተ’ ያጋደ ኦዳ” ያጌዳ።<verse eid="NUM 35:34"/></para>
  <chapter eid="NUM 35"/>
  <chapter number="36" style="c" sid="NUM 36"/>
  <para style="s1">ጋድያ ላትያ ማጫ አሳቱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 36:1"/>ዮሴፎ ዛራቱዋፐ፥ ምናሰ ናኣ ማኪራ ናኣ ጋላኣደ ያራቱዋ ካፓቱ ሙሴኮነ እስራኤላቱዋ ያራቱዋ ካፓቱዋኮ ዬድኖ። <verse eid="NUM 36:1"/><verse number="2" style="v" sid="NUM 36:2"/>ኡንቱንቱ ዪደ፥ “ኑ ጎዳዉ፥ እስራኤልያ አሳዉ ቢታ ኤጻን ሻካደ እማና ማላ፥ መና ጎዳይ ኔና አዛዜዳ፤ ቃይ ጾሳይ ኑ እሻ ጻሎፍሃዳ ላታ አ ማጫ ናናዉ ኔን እማና ማላ፥ ኔና አዛዜዳ።<note caller="-" style="x"><char style="xo" closed="false">36:2 </char><char style="xt" closed="false"><ref loc="NUM 27:7">ፓይ. 27:7</ref></char></note> <verse eid="NUM 36:2"/><verse number="3" style="v" sid="NUM 36:3"/>ሌምሶ ኡንቱንቱ ሀራ ዛረ ግድያ እስራኤልያ አሳ ገሎፐ፥ ኡንቱንቱ ላታይ ኑ አዎቱዋ ላታፐ አከቲደ፥ ኡንቱንቱ ገልያ ዛርያዉ ጉጀቴ። ሄዋ ድራዉ፥ ኑዉ ኤጻን እመቴዳ ላታይ ፓጫና። <verse eid="NUM 36:3"/><verse number="4" style="v" sid="NUM 36:4"/>ቃይ እስራኤላቶ እሻታማን ላይ ባላይ ጋክያ ዎደ፥ ኡንቱንቱ ላታይ ኡንቱንቱ ገልያ አሳ ዛርያዉ ጉጀቴ፤ ኡንቱንቱ ላታይ ኑ አዎቱዋ ዛርያ ላታፐ ፓጫና” ያጌዳ።<verse eid="NUM 36:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 36:5"/>ሄዋፐ ጉይያን፥ መና ጎዳ ቃላዳን፥ ሙሴ እስራኤላቱዋ ሀዋዳን ያጊደ አዛዜዳ፤ “ዮሴፎ ዛራቱ ግያዌ ልከ። <verse eid="NUM 36:5"/><verse number="6" style="v" sid="NUM 36:6"/>መና ጎዳይ ጻሎፍሃዳ ማጫ ናናቱዋባ አዛዜዳዌ ሀዋ፤ ኡንቱንቱ ባረንቱ ዶሴዳ አስና ገላናዉ ዳንዳዪኖ፤ ሽን ባረንቱ አዉዋ ዛርያፐ ግዳናዉ ኮሼ። <verse eid="NUM 36:6"/><verse number="7" style="v" sid="NUM 36:7"/>እስራኤላቱዋ ላታይ እት ዛርያፐ ሀራ ዛርያዉ አፖ፤ እስራኤልያ ኡባይ ባረ ማይዛ አዎቱዋ ዛሪ ላቴዳ ቢታ ምንሲደ ኦይቆ። <verse eid="NUM 36:7"/><verse number="8" style="v" sid="NUM 36:8"/>እስራኤልያ አሳ ግዶን አይ ዛረፐ ግድናካ፥ ቢታ ላትያ ማጫ ናእ ኡባይ፥ እስራኤሊ ኡባይ ባረ ማይዛ አዎቱዋ ላታ ላታና ማላ፥ አ ባረ አዉዋ ዛረ ግድያ አሳ ገሉ። <verse eid="NUM 36:8"/><verse number="9" style="v" sid="NUM 36:9"/>ሄዋዳን ሀኒደ፥ ላታይ እት ዛርያፐ ሀራ ዛርያዉ ሙለካ አናን ደአና። ሄዋ ድራዉ፥ እስራኤልያ ኡባይ ባረ ማይዛ አዎቱዋ ዛሪ ላቴዳ ቢታ ምንሲደ ኦይቆ” ያጌዳ።<verse eid="NUM 36:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 36:10"/>ጻሎፍሃዳ ማጫ ናናይ መና ጎዳይ ሙሳ አዛዜዳዋዳን ኦድኖ። <verse eid="NUM 36:10"/><verse number="11" style="v" sid="NUM 36:11"/>ጻሎፍሃዳ ማጫ ናናይ፥ ማህሎ፥ ትርጾ፥ ሆግሎ፥ ምልኮነ ኖኦ ጌተትያዋንቱ፥ ባረንቱ አዉዋ እሻንቱ ናናቱዋ ገሌድኖ። <verse eid="NUM 36:11"/><verse number="12" style="v" sid="NUM 36:12"/>ኡንቱንቱ ዮሴፎ ናኣ ምናሰ ናናቱ ዛርያ ግዶን አስና ገሌድኖ፤ ኡንቱንቱ ላታይ ኡንቱንቱ አዉዋ ዛርያዉነ ያራዉ አቴዳ።<verse eid="NUM 36:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 36:13"/>ያርኮፐ ሄፍንና፥ ዮርዳኖሳ ሻፋ ማታን ደእያ ሞኣባ ደምባን ሙሴ ባጋና መና ጎዳይ እስራኤልያ አሳ አዛዜዳ ህገቱነ ዎጋቱ ሀዋንታ።<verse eid="NUM 36:13"/></para>
  <chapter eid="NUM 36"/>
</usx>
