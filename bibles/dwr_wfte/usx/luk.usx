<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LUK" style="id">LUK’ - Dawuro Full Bible Ethiopic Version</book>
  <para style="h">ሉቃሳ ምሽራቹዋ</para>
  <para style="toc1">ሉቃስ ጻፌዳ ምሽራቹዋ ቃላ</para>
  <para style="toc2">ሉቃሳ ምሽራቹዋ</para>
  <para style="toc3">ሉቃሳ</para>
  <para style="mt1">ሉቃስ ጻፌዳ</para>
  <para style="mt2">ምሽራቹዋ ቃላ</para>
  <para style="imt">ገሉዋ</para>
  <para style="ip">ሉቃስ ጻፌዳ ምሽራቹ፥ የሱሳ ኮይሮ ያናዋ ያገት ናባቱዋን አባይ ኦደቴዳዋ፥ ዳሮ ዎድያፐ ናገቴዳ ህዶታዉ ሁጰ ግዴዳዌ፥ እስራኤልያ አሳይ ናጊደ ደእያ ጾሳን ኦከቴዳዌ፥ አሳ ዘረ ኡባ አሽያዋ ግድያዋ ቆንጭሴ። የሱስ ጾሳ አዉዋፐ ህዬሳቶ ምሽራቹዋ ቃላ ኦዳናዉ ኪተቴዳዋ ግድያዋነ ሀ ምሽራቹዋ ቃላይ አሳዉ ደእያ ዱማ ዱማ መቱዋ ቃርያ ዎልቃ ኦይቄዳዋ ግድያዋ ሉቃስ ኦዴ። ሉቃሳ ምሽራቹዋ ቃላ ግዶን፥ የሱሳ ዩሳባ ኦድያ ኮይሮ ሸምፓቱዋንነ ቃይካ የሱስ ሳሉዋ ፑደ ከሴዳዋ ኦድያ ዉርሰ ሸምፓቱዋን ሎይደ፥ ኦደቴዳዌ ናሸቻባ። የሱስ ሳሉዋ ከሴዳዋፐ ጉይያን አማኑዋባይ ዋን ድጬደንቶነ ዋን አኬደንቶ ኦድያ ታርክያ ሀ ማጻፋ ጻፌዳ ብታኒ የሱስ ኪቴዳዋንቱ ኦሱዋ ማጻፋን ኦዴዳ።</para>
  <para style="ip">ኪታንቻቱዋ የባይ፥ የሱስ የለቴዳ ዎደ ዉድያ ሄምያዋንቱ ቢደ በኤዳዋ ኦድያ ታርኪ፥ የሱስ ናአተን ደኢደ ጌሻ ጎልያ ቤዳባይ፥ ቃረታንቻ ሳምራውያነ ባዪደ ቤቴዳ ናኣ ታርኪ ሉቃሳ ምሽራቹዋ ጻላላን ቤትያዋንታ። ሀ ምሽራቹዋ ቃላ ግዶን ሀ ጋጻፐ ህን ጋጻ ጋካናዉ ሁጰ ግዲደ ጼለቴዳባይ ዎሳባ፥ ጌሻ አያናባ፥ የሱሳ ኦሱዋ ግዶን ማጫ አሳዉ ደእያ ሳባነ ጾሳይ ናጋራ አቶ ያግያባ።</para>
  <para style="iot">ሸምፓቱዋ ኡባቶ እመቴዳ ቃን ቆፋቱዋ</para>
  <para style="io1">ገሉዋ <char style="ior"><ref loc="LUK 1:1-4">1:1-4</ref></char></para>
  <para style="io1">ጻማቅያ ዮሃንሳነ የሱሳ የለታ <char style="ior"><ref loc="LUK 1:5-2:52">1:5—2:52</ref></char></para>
  <para style="io1">ጻማቅያ ዮሃንሳ ኦሱዋ <char style="ior"><ref loc="LUK 3:1-20">3:1-20</ref></char></para>
  <para style="io1">የሱሳ ጽንቃታነ ፓጭያ <char style="ior"><ref loc="LUK 3:21-4:13">3:21—4:13</ref></char></para>
  <para style="io1">የሱስ ኦሱዋ ጋሊላን ዶሞዋ <char style="ior"><ref loc="LUK 4:14-9:50">4:14—9:50</ref></char></para>
  <para style="io1">የሱስ ጋሊላፐ የሩሳላመ ቦዋ <char style="ior"><ref loc="LUK 9:51-19:27">9:51—19:27</ref></char></para>
  <para style="io1">የሩሳላመንነ እዝ ዩሹዋን የሱሳ ዉርሰ ሳምንታ <char style="ior"><ref loc="LUK 19:28-23:56">19:28—23:56</ref></char></para>
  <para style="io1">ጎዳ የሱሳ ደንዱዋ፥ ቆንጨነ ሳሉዋ ቡሳ <char style="ior"><ref loc="LUK 24:1-53">24:1-53</ref></char></para>
  <chapter number="1" style="c" sid="LUK 1"/>
  <para style="p">
    <verse number="1-4" style="v" sid="LUK 1:1-4"/>ቦንቼቴዳ ቶፍሎሳ፥ ኮይሮ ባረንቱ አይፍያን በኤዳዋንቱነ ባረንቱ ቃላን ማርካቴዳዋንቱ ኑዉ ኦዴድኖ። ጻፈቴዳ የዉዋ ታ ባጋን ኡባ ጻጱዋፐ ብዳ ጼሎዋፐ ጉየ፥ ታርክያ ማራ ናጌዳ ኦግያን ነዉ ጻፋናዉ ሎአ ግዴዳዌ ታዉ ቤቴዳ።<verse eid="LUK 1:1-4"/></para>
  <para style="s1">ጻማቅያ ዮሃንሳ የለታይ ኮይሮ ኦደቴዳ</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5"/>ይሁዳ ጋድያ ካትያ ሄሮድሳ ዎድያን፥<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="fq" closed="false">ይሁዳ፦ </char><char style="ft" closed="false">ሀዋን ይሁዳ ጋድያ ጌተቴዳዌ ፍልስጼመ ጋድያ ኡባ በስያዋ።</char></note> አብያ ቄሳተ ኦሱዋ ባጋፐ ግዴዳ ዛካራሳ ጌተትያ እት ቄሳይ ደኤ።<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="1CH 24:10">1 ኦዱዋ 24:10</ref></char></note> ማቻታካ ኤልሳቤጾ ጌተትያ አሮነ ያራፐ የለቴዳዉኖ። <verse eid="LUK 1:5"/><verse number="6" style="v" sid="LUK 1:6"/>ላአቱካ ጎዳ አዛዙዋነ ሴራ ዳርሲደ ናግያዋንታነ ካ ባንታን ጾሳ ስንን ደእያ ጽላቱዋ። <verse eid="LUK 1:6"/><verse number="7" style="v" sid="LUK 1:7"/>ግዶፐ አትን ኤልሳቤጻ ማን ግዶ ድራዉ፥ የሉ ኡንቱንቶ ባዋ። ላአቱካ ላይ ሱጌዳዋንታ።<verse eid="LUK 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8"/>እት ጋላስ ዛካራስ ባረ ባጋ ካላን ጾሳ ስንን ቄሳተን ኦያ ዎደ፥ <verse eid="LUK 1:8"/><verse number="9" style="v" sid="LUK 1:9"/>ባረ ቄሳተ ዎጋ ዶያዳን ጌሻ ጎልያ ገሊደ እጻና ጩውሱዋ<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="fk" closed="false">እጻና ጩውሱዋ፦ </char><char style="ft" closed="false">ሀዋ ጉሳይ ጩዋይ ዎሳ ኮታ ጾሳኮ ጋኬ ጊደ ዎንታነ ኦማርስ ዎደ ጩውስያ ዎጋ።</char></note> ሳማይ አ ጋኬዳ። <verse eid="LUK 1:9"/><verse number="10" style="v" sid="LUK 1:10"/>እጻናይ ጩውያ ዎደ አሳይ ኡባይ ካረን ኤቂደ ዎስ ደኤ።<verse eid="LUK 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 1:11"/>ጎዳ ኪታንቻይ እጻና ያርሹዋ ሳፐ ኡሸቻና ኤቂደ አዉ ቤቴዳ። <verse eid="LUK 1:11"/><verse number="12" style="v" sid="LUK 1:12"/>ዛካራስካ በኤዳ ዎደ ዳጋሚደ ያሻን ምተቴዳ። <verse eid="LUK 1:12"/><verse number="13" style="v" sid="LUK 1:13"/>ኪታንቻይካ ቃይ ያጌዳ፥ “ዛካራሳ፥ ያዮፓ፤ ነ ዎሳይ ስሰቴዳ፥ ነ ማቻታ ኤልሳቤጻ አቱማ ናኣ የላናዉኑ። <verse eid="LUK 1:13"/><verse number="14" style="v" sid="LUK 1:14"/>አ የለታን ናሸታይነ እሻሉ ነዉ ሀናናዋ፤ ጮራቱካ እ የለቶ ድራዉ ሀሹ ጋናዋንታ፤ <verse eid="LUK 1:14"/><verse number="15" style="v" sid="LUK 1:15"/>እካ ጎዳ ስንን ዳራ ግዳናዋ። ማይያ ዎይንያ ኡሻ ግዶ ሀራ ማይያ ኡሻ አይነ ኡሸና፤ ባረ ዳይ ኡሉዋን ደእሽን አያና ጌሻይ አን ኩማናዋ።<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="NUM 6:3">ፓይ. 6:3</ref></char></note><verse eid="LUK 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 1:16"/>“እስራኤልያ አሳቱዋፐካ ጮራቱዋ ኡንቱንቱ ጎዳ ጾሳኮ፥ እ ዛራናዋ። <verse eid="LUK 1:16"/><verse number="17" style="v" sid="LUK 1:17"/>እካ ጊገና አሳ ጎዳዉ ጊግሳናዉ፥ አዎቱዋ ዎዛና ናናቱዋኮ፥ አዛዘተናዋንታካ ጽሎተ ኤራኮ ዛራናዉ፥ ኤላሳ<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="fq" closed="false">ኤላሳ፦ </char><char style="ft" closed="false">ሀዌ ጌተቴዳዌ፥ ካሰ ኤጫ ጫቁዋ ማጻፋን ናብያ ኤላስ ኦራባ ኦያ ዎልቃን ኤረቴዳዋ ድራሳ።</char></note> አያናንነ ዎልቃን ጎዳፐ ስንና ቤ።”<note caller="-" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="MAL 4:5">ሚልክ. 4:5</ref>፣ <ref loc="MAL 4:6">6</ref></char></note><verse eid="LUK 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18"/>ዛካራስካ ኪታንቻ፥ “ታን ጭማድ፥ ታማቻታካ ባረ ላይን ሱጌዳዉኖ፥ ሀዋ ታን አያን ኤራንታ?” ጌዳ።<verse eid="LUK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19"/>ኪታንቻይካ ዛሪደ፥ “ታን ጾሳ ስንን ኤቂያ ጋብሬላ፤ ሀዋ ምሽራቹዋ ነዉ ኦዳናዉ ኔኮ ኪተታድ፤<note caller="-" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="DAN 8:16">ዳኔላ 8:16</ref>፤ <ref loc="DAN 9:21">9:21</ref></char></note> <verse eid="LUK 1:19"/><verse number="20" style="v" sid="LUK 1:20"/>ሄኮ ሄ ዎድያን ሀናና ታ ቃላ ነ አማናቤና ድራዉ፥ ሀ የዉ ሀናና ጋላሳይ ጋካናዉ ኔን ዱደ ግዳናሳ፤ ሃሳያናዉካ ዳንዳያካ” ጌዳ።<verse eid="LUK 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21"/>ሄ ዎደ አሳይ፥ ዛካራስ ጌሻ ጎልያፐ ከሰናን አያዉ ጋምኤደንቶ ማላለቲደ ናጊኖ። <verse eid="LUK 1:21"/><verse number="22" style="v" sid="LUK 1:22"/>ከሴዳ ዎድያንካ ሃሳያናዉ ዳንዳይቤና፤ ጌሻ ጎልያን ሳፃ እ በኤዳዋ አኬኬድኖ፤ እካ ሃሳያናዉ ዳንዳይቤናዋ ጾርስ በሲደ፥ ዱደ ግዲደ ደኤዳ።<verse eid="LUK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23"/>ዛካራስካ ባረ ኦሱዋ ዎድያ ዉርሶ ዎደ፥ ባረ ጎለ ስሜዳ። <verse eid="LUK 1:23"/><verse number="24" style="v" sid="LUK 1:24"/>ሄዋፐ ጉይያን አ ማቻታ ኤልሳቤጻ ሻሃራደ እቼሹ አገና ባረና ገንዱ። <verse eid="LUK 1:24"/><verse number="25" style="v" sid="LUK 1:25"/>ኤልሳቤጻካ፥ “ታ ቶሽያ አሳ ግዶፐ ድጋናዉ<note caller="+" style="f"><char style="fr" closed="false">1:25 </char><char style="fq" closed="false">ታ ቶሽያ አሳ ግዶፐ ድጋናዉ፦ </char><char style="ft" closed="false">አስና ገሌዳ ምሽራታ ናኣ የለናን አቶፐ፥ እስራኤልያ አሳ ቆፋን፥ “ጾሳይ እዞ ሙር ደኤ” ያገታዉ።</char></note> ጎዳይ ባረ ማሮተን ታና ጼሎ ዎደ፥ ሀዋዳን ታዉ ኦዳ” ጋዱ።<verse eid="LUK 1:25"/></para>
  <para style="s1">የሱሳ የለታይ ካሰቲደ ኦደቴዳ</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26"/>ኡሱፑን አገናን ጾሳ ኪታንቻ ጋብሬል ጋሊላ ጋድያን ናዝሬተ ካታማ <verse eid="LUK 1:26"/><verse number="27" style="v" sid="LUK 1:27"/>ዳዊታ ያራፐ ግዴዳ ዮሴፎ ጌተትያ ብታነዉ ኦሸታ ቃሸቴዳ ዎዶራትኮ ጾሳ ማታፐ ኪተቴዳ፤ ዎዶራት ሱንይካ ማይራሞ ጌተቴ።<note caller="-" style="x"><char style="xo" closed="false">1:27 </char><char style="xt" closed="false"><ref loc="MAT 1:18">ማቶሳ 1:18</ref></char></note> <verse eid="LUK 1:27"/><verse number="28" style="v" sid="LUK 1:28"/>ኪታንቻይካ ማይራምኮ ዪደ፥ “ዳርሳደ ዶሰታዉኔ፥ ሳሮተይ ነዉ ግዶ፤ ጎዳይካ ኔናና ጋ ደኤ፤ ኔንካ ማጫዋንቱ ግዶን አንጀቴዳዉኖ”<note caller="+" style="f"><char style="fr" closed="false">1:28 </char><char style="fq" closed="false">ኔንካ ማጫዋንቱ ግዶን አንጀቴዳዉኖ፦ </char><char style="ft" closed="false">ሀ ቆፋይ በን ጭሜዳ ግሪክያ ማጻፋን ባይናዋ ግድያ ድራዉ፥ እት እት እንግልዜዋንነ አማራዋ ማጻፋንካ ባዋ።</char></note> ያጌዳ።<verse eid="LUK 1:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29"/>ማይራማካ አ ሃሳያፐ ደንዶዋን ዳርሳ ዳጋማደ፥ “ሀዌ አያ ማላ ሳሮታ ግዳኔ” ጋደ የዉዋ ቆፓዱ። <verse eid="LUK 1:29"/><verse number="30" style="v" sid="LUK 1:30"/>ኪታንቻይ እዞ፥ “ሀነ ማይራሜ፥ ጾሳ ማታን ሳባ ደማዳ ያዮፓ። <verse eid="LUK 1:30"/><verse number="31" style="v" sid="LUK 1:31"/>ኔን ሻሃራደ፥ አቱማ ናኣ የላናሳ፤ አ ሱንካ የሱሳ ጋናሳ።<note caller="-" style="x"><char style="xo" closed="false">1:31 </char><char style="xt" closed="false"><ref loc="MAT 1:21">ማቶሳ 1:21</ref></char></note> <verse eid="LUK 1:31"/><verse number="32" style="v" sid="LUK 1:32"/>እካ ዳራ ግዳናዋ፤ ኡባፐ ቃ ጾሳ ናኣ ጌተታና፤ ጎዳ ጾሳይ አ አቡ ዳዊታ ካዉተ ኦይድያ አዉ እማናዋ። <verse eid="LUK 1:32"/><verse number="33" style="v" sid="LUK 1:33"/>እካ ያቆባ ጎለን መናዉ ካዉታናዋ፤ አ ካዉተዉካ ዉርሰይ ባዋ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">1:33 </char><char style="xt" closed="false"><ref loc="2SA 7:12">2 ሳሜላ 7:12</ref>፣ <ref loc="2SA 7:13">13</ref>፣ <ref loc="2SA 7:16">16</ref>፤ <ref loc="ISA 9:7">ኢሳ. 9:7</ref></char></note><verse eid="LUK 1:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34"/>ማይራማካ ኪታንቻ፥ “ታን ዎዶራቶ ግዶ ድራዉ፥ ሀዌ ዎት ሀናናዌ?” ያጋዱ።<verse eid="LUK 1:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35"/>ኪታንቻይካ ዛሪደ እዝዉ፥ “አያና ጌሻይ ነ ቦላ ያናዋ፤ ቃ ጾሳ ዎልቃይ ኔናን ሸምፓናዋ። ሄዋ ድራዉ፥ ኔፐ የለትያዌ ጌሻ ጾሳ ናኣ ጌተታና። <verse eid="LUK 1:35"/><verse number="36" style="v" sid="LUK 1:36"/>ነ ዳባታ ኤልሳቤጻ ባረ ጭማተ ዎድያን አቱማ ናኣ ሻሃራዱ። ማን ጌተቴዳዉና ኤልሳቤጻ ሻሃሮደፐ ኡሱፑን አገና ኦይቃዱ። <verse eid="LUK 1:36"/><verse number="37" style="v" sid="LUK 1:37"/>ጾሳ ጾንያ የዉ ባዋ”<note caller="-" style="x"><char style="xo" closed="false">1:37 </char><char style="xt" closed="false"><ref loc="GEN 18:14">ዶመ 18:14</ref></char></note> ያጌዳ።<verse eid="LUK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38"/>ማይራማካ፥ “ታን ጎዳ አይላቶ፤ ኔን ጎዋዳን ሀኖ” ጋዱ። ሄዋፐ ጉይያን ኪታንቻይ እዝ ማታፐ ቤዳ።<verse eid="LUK 1:38"/></para>
  <para style="s1">ማይራማካ ኤልሳቤጾ ኦቻናዉ ባዱ</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39"/>ማይራማካ ሄ አገና ግዶን ደንዳደ ክል ዞዘትያ ይሁዳ ጋደን ደእያ እት ካታማ ኤሌላ ከሳዱ። <verse eid="LUK 1:39"/><verse number="40" style="v" sid="LUK 1:40"/>ዛካራሳ ጎለ ገላደ ኤልሳቤጾ ሳሮታዱ። <verse eid="LUK 1:40"/><verse number="41" style="v" sid="LUK 1:41"/>ኤልሳቤጻካ ማይራም ሳሮታ ስሴዳ ዎደ፥ እዝ ኡሉዋን ደእያ ሻሃራይ ጉፔዳ፤ ኤልሳቤጻካ አያና ጌሻን ኩማዱ። <verse eid="LUK 1:41"/><verse number="42" style="v" sid="LUK 1:42"/>ባረ ኮሻካ ቁ ኦደ፥ “ኔን ማጫዋንቱ ግዶፐ አንጀቴዳዉኖ። ኔፐ የለትያዌካ አንጀቶዋ። <verse eid="LUK 1:42"/><verse number="43" style="v" sid="LUK 1:43"/>ኔን ታ ጎዳ ዳያ ታኮ ያናዉ ታን ኦኔ? <verse eid="LUK 1:43"/><verse number="44" style="v" sid="LUK 1:44"/>ሄኮ ነ ሳሮታ ኮሻይ ታ ሀይን ስሰቴዳ ዎደ፥ ታ ኡሉዋን ደእያ ሻሃራይ ናሸቻን ጉፔዳ። <verse eid="LUK 1:44"/><verse number="45" style="v" sid="LUK 1:45"/>ጎዳይ ፖለቴ ጊደ እዝዉ ኦዴዳዋ አማኔዳዉና እዛ አንጀቴዳዉኖ” ያጋዱ።<verse eid="LUK 1:45"/></para>
  <para style="s1">ማይራም ጋላታ የ</para>
  <para style="r">(<ref loc="LUK 1:46-53">1:46-53</ref>)</para>
  <para style="q1">
    <verse number="46" style="v" sid="LUK 1:46"/>ማይራማካ፥</para>
  <para style="q2" vid="LUK 1:46">“ታ ሸምፓታ ታ ጎዳ ቦንቻዉ፥<verse eid="LUK 1:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="LUK 1:47"/>ታ አያናይካ ታ ጾሳ፥ ታ ልያን፥</para>
  <para style="q2" vid="LUK 1:47">ሎይ ናሸታዉ።<verse eid="LUK 1:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="LUK 1:48"/>እካ ባረ አይላት ቶሽያ ጼሌዳ።</para>
  <para style="q2" vid="LUK 1:48">ሀቼፐ ዶሚደ የለታይ ኡባይ</para>
  <para style="q2" vid="LUK 1:48">አንጀቴዳዉኔ ጊኖ።<verse eid="LUK 1:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="LUK 1:49"/>ዎልቃማ ግዴዳ እ፥</para>
  <para style="q2" vid="LUK 1:49">ዳሮ የዉዋ ታዉ ኦዳ፤</para>
  <para style="q1" vid="LUK 1:49">አ ሱንይካ ጌሻ።<verse eid="LUK 1:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50"/>አ ማሮታይ ያይያዋንቶ፥</para>
  <para style="q2" vid="LUK 1:50">የለታፐ የለታይ ጋካናዉ ደኤ።<verse eid="LUK 1:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51"/>ባረ ዎልቃን ምኖ ኪታ ኪተቴዳ፤</para>
  <para style="q2" vid="LUK 1:51">ባረንቱ ዎዛና ቆፋን ኦቶረትያዋንታ፥</para>
  <para style="q2" vid="LUK 1:51">ላሌዳ።<verse eid="LUK 1:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52"/>ሞድያዋንታ ካዉተ ማታ ኦይድያፐ ዎዳ፤</para>
  <para style="q2" vid="LUK 1:52">አሽካቱዋካ ቃይ ቁ ቁ ኦዳ።<verse eid="LUK 1:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53"/>ኮሻቴዳዋንታ ሎኦ የዉዋን ካልሴዳ፤</para>
  <para style="q2" vid="LUK 1:53">ዱራቱዋ ቃይ መላ የደርሴዳ።<verse eid="LUK 1:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54"/>ባረ ማሮተ ቆፒደ፥</para>
  <para style="q2" vid="LUK 1:54">ባረ አይልያ እስራኤልያ ማዴዳ።<verse eid="LUK 1:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55"/>ኑ አዋቶ እ ኦዴዳዋዳን፥</para>
  <para style="q2" vid="LUK 1:55">አብራሃመዉነ አ ያራዉ ጌዳዋ፥</para>
  <para style="q2" vid="LUK 1:55">መናዉ ናጋና ድራሳ”</para>
  <para style="m" vid="LUK 1:55">ያጋዱ።<verse eid="LUK 1:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56"/>ማይራማካ ሄዙ አገና ኬና ኤልሳቤጽ ማታን ጋምኦዋፐ ጉይያን ባረ ጎለ ስማዱ።<verse eid="LUK 1:56"/></para>
  <para style="s1">ጻማቅያ ዮሃንሳ የለታ</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57"/>ኤልሳቤጽዉካ የልያ ዎዲ ጋክና፥ አቱማ ናኣ የላዱ። <verse eid="LUK 1:57"/><verse number="58" style="v" sid="LUK 1:58"/>እዝ ሾራቱነ እዝ ዳቦ ግዴዳዋንቱ፥ ጎዳይ ማሮተ እዝዉ ኦዳዋ ስሲደ እዝና እትፐ ናሸቴድኖ።<verse eid="LUK 1:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 1:59"/>ሆስፑን ጋላሳን ናኣ ቃጻራናዉ ዬድኖ፤ አ፥ አዉዋ ሱንን ዛካራሳ ጊደ ሱንናዉ ኮዬድኖ።<note caller="-" style="x"><char style="xo" closed="false">1:59 </char><char style="xt" closed="false"><ref loc="LEV 12:3">ዎጋ 12:3</ref></char></note> <verse eid="LUK 1:59"/><verse number="60" style="v" sid="LUK 1:60"/>አ ዳያ ቃይ፥ “ሀነና፥ ዮሃንሳ ጌተታናዉ ኮሼ” ያጋዱ።<verse eid="LUK 1:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 1:61"/>ኡንቱንቱካ እዞ፥ “ነ ዳባቱዋፐ ሀቼ ጋካናዉ እቱካ ሀ ሱንን ጼሰትቤና” ያጌድኖ።<verse eid="LUK 1:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 1:62"/>አ አባ፥ ኦና ግያ ሱንን ጼገታናዉ ኮይንቶ ጾርስ ኦቼድኖ።<verse eid="LUK 1:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 1:63"/>አ አቡካ ጻፍያባ ኦች አኪደ፥ “ናኣ ሱንይ ዮሃንሳ” ጊደ ጻፍና፥ ኡባቱካ የዉዋን ማላለቴድኖ። <verse eid="LUK 1:63"/><verse number="64" style="v" sid="LUK 1:64"/>ሄዋንካ ዛካራሳ ዶናይ ዶየቴዳ፥ አ እንጻርሳይካ ብለትና ሃሳያ ዶሜዳ፥ ጾሳካ ጋላቴዳ።<verse eid="LUK 1:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="LUK 1:65"/>አ ሾራቱካ ደኢያሳ ኡባን ያሻን ኩሜድኖ። ሀ የዉካ ዞዘትያ ይሁዳ ጋድያ ኡባን ዳሪ ሃሳየቴዳ። <verse eid="LUK 1:65"/><verse number="66" style="v" sid="LUK 1:66"/>ሀዋካ ስሴዳዋንቱ ኡባቱ፥ “ሀ ናአይ አያ ግዳኔሻ?” ያጊደ የዉዋ ባረንቱ ዎዛናን ኦይቄድኖ፤ ጾሳይካ አናና ደእያዋ ኤሬድኖ።<verse eid="LUK 1:66"/></para>
  <para style="s1">ዛካራሳ ጋላታነ ትምቢትያ ኦዱዋ</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67"/>ዮሃንሳ አቡ ዛካራስ አያና ጌሻን ኩሚደ ትምቢትያ ያግ ኦዴዳ:<verse eid="LUK 1:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68"/>“እስራኤልያ ጎዳይ ጾሳይ አንጀቶ፤</para>
  <para style="q2" vid="LUK 1:68">ዪደ ባረ አሳ ጾሞሴዳነ ዎዜዳ።<verse eid="LUK 1:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69"/>ባረ አይልያ ዳዊተ ጎልያን፤</para>
  <para style="q2" vid="LUK 1:69">ዎልቃማ አሽያዋ ኑዉ ጊግሴዳ።<verse eid="LUK 1:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70"/>ሀዌካ በን ጎዳ ጌሻ ናባቱዋ ዶናን ኦደቶዋዳን፥<verse eid="LUK 1:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71"/>እ ኑና፥ ኑ ሞርከቱዋፐነ፥</para>
  <para style="q2" vid="LUK 1:71">ኑናና ኤቀትያዋንቱ ኩሽያፐ አሻናሳ።<verse eid="LUK 1:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72"/>ሀዋካ እ ኦዳዌ፥ ኑ አዋቶ፥</para>
  <para style="q2" vid="LUK 1:72">ማሮተ በሳናሳነ፥</para>
  <para style="q2" vid="LUK 1:72">ባረ ጌሻ ጫቁዋ ዎዛና አናሳ።<verse eid="LUK 1:72"/></para>
  <para style="q1">
    <verse number="73" style="v" sid="LUK 1:73"/>ኑ አዉዋ አብራሃሞ፥</para>
  <para style="q2" vid="LUK 1:73">ጫቄዳ ጫቁዋ ቆፓናዉ፥<verse eid="LUK 1:73"/></para>
  <para style="q1">
    <verse number="74" style="v" sid="LUK 1:74"/>ኑ ሞርከቱዋ ኩሽያፐ ከሲደ፥</para>
  <para style="q2" vid="LUK 1:74">ያሻይ ባንታን አዉ ኦናዳን፥</para>
  <para style="q2" vid="LUK 1:74">ማታ ኑዉ እሜዳ።<verse eid="LUK 1:74"/></para>
  <para style="q1">
    <verse number="75" style="v" sid="LUK 1:75"/>ሀዌኔካ፥ ኑና ኑ ዎድያ ኡባን፥</para>
  <para style="q2" vid="LUK 1:75">ጌሻተንነ ጽሎተን፥</para>
  <para style="q2" vid="LUK 1:75">ባረ ስንን ኤሳና ድራሳ።<verse eid="LUK 1:75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76"/>ዛሪደካ፥ ኔኖ፥ ታ ናአዉ፥</para>
  <para style="q2" vid="LUK 1:76">ቃ ጾሳ ናብያ ጌተታናሳ፤</para>
  <para style="q2" vid="LUK 1:76">ኦግያ ጊግሳናዉ ጎዳፐ ስንና፥</para>
  <para style="q2" vid="LUK 1:76">ባናሳ።<verse eid="LUK 1:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77"/>አሳ ናጋራ ማርያ አቶተ ኤራ፥</para>
  <para style="q2" vid="LUK 1:77">ኡንቱንቶ እማናሳ።<verse eid="LUK 1:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78"/>ሄዌካ ክልፐ ዬዳ ፖኡ፥</para>
  <para style="q2" vid="LUK 1:78">ኑና ጾሞሴዳዌ፥</para>
  <para style="q2" vid="LUK 1:78">ኑ ጾሳ ማሮተነ ቃረታ ጋሱዋና።<verse eid="LUK 1:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79"/>አ ፖኡካ ማንነ ሀይቁዋ ኩዋን፥</para>
  <para style="q2" vid="LUK 1:79">ኡቴዳዋንቶ ፖእሴ፤</para>
  <para style="q2" vid="LUK 1:79">ኑ ገድያካ ሳሮተ ኦግያን ሱርሴ።”<verse eid="LUK 1:79"/></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80"/>ናአይካ ድጪደ፥ አያናን ምኔዳ፤ እስራኤልያ አሳዉ ቤቴዳ ጋላሳይ ጋካናዉ መላ ቢታን ደኤዳ።<verse eid="LUK 1:80"/></para>
  <chapter eid="LUK 1"/>
  <chapter number="2" style="c" sid="LUK 2"/>
  <para style="s1">የሱሳ የለታባ</para>
  <para style="r">(<ref loc="MAT 1:18-25">ማቶሳ 1:18-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1"/>ሄ ዎደ<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fq" closed="false">ሄ ዎደ፥ </char><char style="ft" closed="false">ጌተቶዌ ጻማቅያ ዮሃንስ የለት ስሚደ ብሮ ጉተን ደእሽን የሱስ የለቶ ዎድያና።</char></note> ሮማ ካዉተ ጋርሳን ደእያ አሳይ ኡባይ ሱን ጻፈታናዳንነ ፓይደታናዳን አዉግስጾሰ ቄሳረፐ<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fqa" closed="false">ቄሳራ፦ </char><char style="ft" closed="false">ግያ ሱንይ ካትያ ጉሳ። ሄዌኔካ ጮራ ጋድያ ሞድያ ዎልቃይ ደእያ ጮራ ካታቱዋ ካትያ ጉሳ።</char></note> አዛዙ ከሴዳ። <verse eid="LUK 2:1"/><verse number="2" style="v" sid="LUK 2:2"/>ሄዌኔካ፥ ቀረነዮሰ<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="fqa" closed="false">ቀረነዮሳ፦ </char><char style="ft" closed="false">ጌተትያዌ ሮማ ካቲ አዉግስጾሰ፥ ሶርያ ጌተትያ ይሁዳነ ጋሊላ አዉራጃቱዋ ኦይቄዳ ጋድያን ሱንዬዳዋ።</char></note> ሶርያ ጋድያ ሞድያ ዎደ ሀኔዳ ኮይሮ አሳ ፓይዱዋ።<verse eid="LUK 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 2:3"/>ሀዋ ድራዉ እት እት አሳይ ጻፈታናዉ ባረ ካታማ ባረ ካታማ ቤዳ። <verse eid="LUK 2:3"/><verse number="4" style="v" sid="LUK 2:4"/>ዮሴፎካ ዳዊታ ጎልያፐነ ያራፐ ግድያ ድራዉ ጋሊላ አዉራጃን ደእያ ናዝሬተ ካታማፐ ደንዲደ ዳዊታ ካታማ ግዴዳዉንኮ ይሁዳን ደእያ ቤተሌመ ጌተትያ ካታማ ከሴዳ። <verse eid="LUK 2:4"/><verse number="5" style="v" sid="LUK 2:5"/>ሄ ዎደ የልያ ዎዲ ማቴዳ አዉ ኦሸታ ኡቴዳ ማይራማካ አናና እትፐ ባዱ። <verse eid="LUK 2:5"/><verse number="6" style="v" sid="LUK 2:6"/>ኡንቱንቱ ሄዋን ደእሽን እዝዉ የልያ ዎዲ ጋኪ አጌዳ። <verse eid="LUK 2:6"/><verse number="7" style="v" sid="LUK 2:7"/>እዛካ ባይራ ናኣ<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="fk" closed="false">ባይራ ናኣ፦ </char><char style="ft" closed="false">እስራኤልያ አሳይ የለቴዳ ናኣ ኡባ ጎልያንካ ጾሳዉ በስያዋ ጊኖ።</char></note> ግዴዳ አቱማ ናኣ የላዱ፤ እማይ ሸምፕያ ሳ ደማቤና ድራዉ፥ ናኣ ማዩዋን ጻጻደ ጋጳትያን<note caller="+" style="f"><char style="fr" closed="false">2:7፣ 12፣ 16 </char><char style="fk" closed="false">ጋጳትያ፦ </char><char style="ft" closed="false">ሀ ሚሻይ ምያይ ምያባይ ሳኣን ላለተናን ማና ማላ የጊደ እምያባ።</char></note> ቀራዱ።<verse eid="LUK 2:7"/></para>
  <para style="s1">ዉድያ ሄምያዋንታነ ኪታንቻቱዋ</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8"/>ሄ ጋድያን ቃማ ባረንቱ ዉድያ ሄሚደ ደምባን አቅያዋንቱ ደኢኖ። <verse eid="LUK 2:8"/><verse number="9" style="v" sid="LUK 2:9"/>ጾሳ ኪታንቻይ ቆፐናን ዪደ ኡንቱንቱ ምይያን ኤቄዳ፤ ጎዳ ቦንቹ ኡንቱንቱ ዩሹዋን ፖኤዳ ዎደ፥ ዎልቃማ ያሻይ ኡንቱንታ ኦይቄዳ። <verse eid="LUK 2:9"/><verse number="10" style="v" sid="LUK 2:10"/>ኪታንቻይ ኡንቱንታ፥ “ያዮፕተ፥ አሳዉ ኡባዉ ሀንያ ዳሮ ናሸችያ ምሽራቹዋ ታን ህንተንቶ አሃድ። <verse eid="LUK 2:10"/><verse number="11" style="v" sid="LUK 2:11"/>ሀቼ ዳዊታ ካታማን አሽያዌ የለቴዳ። እካ ጎዳ ክርስቶሳ። <verse eid="LUK 2:11"/><verse number="12" style="v" sid="LUK 2:12"/>ሀዌ ህንተንቶ ማላ ግዶ: ጋጭኖ ናአይ ማዩዋን ጻጸቲደ ጋጳትያ ግዶን ግሴዳዋ ደማንታ” ያጌዳ።<verse eid="LUK 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13"/>ቆፐናን ጮራ ጾሳ ኪታንቻቱ ኮይሮ ኪታንቻና እትፐ ቆንጬድኖ።<verse eid="LUK 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 2:14"/>ጾሳካ ጋላቲደ፥ ሀዋዳን ጌድኖ:</para>
  <para style="q1" vid="LUK 2:14">“ቦንቹ ጾሳዉ</para>
  <para style="q2" vid="LUK 2:14">ቦላ ሳሉዋን ግዶ።</para>
  <para style="q1" vid="LUK 2:14">ሳኣን እ ዶስያ አሳዉ</para>
  <para style="q2" vid="LUK 2:14">ሳሮተይ ግዶ”</para>
  <para style="m" vid="LUK 2:14">ያጌድኖ።<verse eid="LUK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15"/>ኪታንቻቱ ኡንቱንቱፐ ሻከቲደ ሳሉዋ ከሶዋፐ ጉየ፥ ዉድያ ሄምያዋንቱ፥ “ጎዳይ ኑዉ ቆንጭሴዳዋ፥ ሀዋ ሀኔዳ የዉዋ በአናዉ ቤተሌመ ቦይተ” ጌተቴድኖ።<verse eid="LUK 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16"/>ኡንቱንቱካ ኤሌሊደ ቤድኖ። ማይራሞነ ዮሴፎ ደሚደ፥ ጋጭኖ ናአይካ ጋጳትያን ግሴዳዋ በኤድኖ። <verse eid="LUK 2:16"/><verse number="17" style="v" sid="LUK 2:17"/>ሄዋፐ ጉይያን ጉ ናኣ ድራዉ ኦደቴዳዋ ቆንጭሲደ ኦዴድኖ። <verse eid="LUK 2:17"/><verse number="18" style="v" sid="LUK 2:18"/>ሀዋ ስሴዳ ኡባይ ኡንቱንቱ ኦዴዳ የዉዋን ማላለቴድኖ። <verse eid="LUK 2:18"/><verse number="19" style="v" sid="LUK 2:19"/>ማይራማ ቃይ ሀዋ ኡባ ባረ ዎዛናን ኦይቃደ ቆፓደ ጋምኣዱ። <verse eid="LUK 2:19"/><verse number="20" style="v" sid="LUK 2:20"/>ዉድያ ሄምያዋንቱካ ኡባ የዉ ኡንቱንቶ ኦደቴዳዋዳን ሀንና ደሞ ድራዉ፥ ስሴዳዎነ በኤዳዎ ኡባዉ ጾሳ ቦንቺድነ ጋላቲደ ስሜድኖ።<verse eid="LUK 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21"/>ናአዉ ሆስፑን ጋላሳ ግድና ቃጻረትያ ዎዲ ጋኮ ዎደ፥ እ አት ኡሉዋን አታናፐ ካሰ፥ ኪታንቻይ ከሶ ሱንን፥ የሱሳ ጌተቴዳ።<note caller="-" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="LEV 12:3">ዎጋ 12:3</ref>፤ <ref loc="LUK 1:31">ሉቃሳ 1:31</ref></char></note><verse eid="LUK 2:21"/></para>
  <para style="s1">የሱስ ጌሻ ጎልያን ጾሳዉ ሼቴዳ</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 2:22"/>ሙሴ ዎጋ ማራዳን ጌይያ ዎዲ<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="fk" closed="false">ጌይያ ዎዲ፦ </char><char style="ft" closed="false">አይሁዳቱዋ ማጫ አሳይ አቱማ ናኣ የሎዋፐ ጉይያን፥ “ጌሻ ግዱኩ” ያግ ቆፒኖ። ቃይካ ሄ ናአይ ቃጻረታና ጋካናዉ እዛ ሶይፐ ከሰናዳን ኦሰታዉ። ሀ ዎዲ፥ ጌይያ ዎድያ ጌተቴ።</char></note> ፖለቴዳ ዎደ ዮሴፎነ ማይራማ ጋጭኖ ናኣ ጾሳዉ ሼናዉ የሩሳላመ አክ ቤድኖ። <verse eid="LUK 2:22"/><verse number="23" style="v" sid="LUK 2:23"/>ሄዌኔካ ጎዳ ዎጋን፥ “አቱማ ናኣ ግዴዳ ባይራ ናአይ<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="fk" closed="false">ባይራ ናአይ፦ </char><char style="ft" closed="false">2:7 ጼልተ።</char></note> ኡባይ ጾሳዉ ዱማቴዳዋ ግዳናዋ” ጌተት ጻፈቴዳዋዳንነ፥<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="EXO 13:2">ከሳ 13:2</ref>፣ <ref loc="EXO 13:12">12</ref></char></note> <verse eid="LUK 2:23"/><verse number="24" style="v" sid="LUK 2:24"/>ቃይካ ጎዳ ዎጋን፥ “ላኡ ዶጎማቱዋ ዎይ ላኡ ሀራጰ ማራቱዋ” ጌተቶዋዳን፥ ጎዳዉ ያርሹዋ ያርሻናዉ አፌድኖ።<verse eid="LUK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25"/>ሄ ዎደ ጽሎነ ገንጫ ግዴዳ ስሞና ጌተትያ እት ብታኒ የሩሳላመን ደኤ። እካ፥ እስራኤልያ አሳዉ አቶተ ህዶታ ናግያዋነ አያና ጌሻይ አ ቦላን ሸምፔዳ አሳ። <verse eid="LUK 2:25"/><verse number="26" style="v" sid="LUK 2:26"/>ጎዳን ኦከቴዳ ክርስቶሳ በኤናን ሀይቀናዋ አያና ጌሻን አዉ ቆንጭሴዳ።<verse eid="LUK 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 2:27"/>እካ ሄ ዎደ አያና ጌሻይ ካለና፥ ጌሻ ጎልያ ገሌዳ። ናኣ የላዋንቱ ኤርያ ዎጋ ማራዳን፥ ኮሽያዋ አዉ ፖላናዉ ጉ ናኣ የሱሳ ኦይቂደ ገሎ ዎደ፥<verse eid="LUK 2:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 2:28"/>ስሞነ ሞክ አክ ናኣ እድሚደ ጾሳ ጋላቲደ ሀዋ ያጌዳ:<verse eid="LUK 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29"/>“ጎዳዉ፥ ኔን ቃላ ገሎ ማራዳን፥</para>
  <para style="q2" vid="LUK 2:29">ሀእ ታና ነ አይልያ ሳሩዋን ኔኮ አፋ።<verse eid="LUK 2:29"/></para>
  <para style="q1">
    <verse number="30-31" style="v" sid="LUK 2:30-31"/>ጋሱካ፥ ታ አይፋቱ፥</para>
  <para style="q2" vid="LUK 2:30-31">አሳ ኡባ ስንን ኔን ጊግሴዳ፥</para>
  <para style="q2" vid="LUK 2:30-31">አሽያ ህዶታ በኤድኖ።<verse eid="LUK 2:30-31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32"/>ሄዌካ እስራኤልያ ግደና አሳዉ፥</para>
  <para style="q2" vid="LUK 2:32">ቆንጨ እምያ ፖኡዋ።</para>
  <para style="q1" vid="LUK 2:32">ቃይ ነ አሳዉ እስራኤለዉ ቦንቹዋ።”<verse eid="LUK 2:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33"/>ዮሴፎነ አ ዳያ አ ድራዉ ሃሳየቴዳ የዎ ማላለቴድኖ። <verse eid="LUK 2:33"/><verse number="34" style="v" sid="LUK 2:34"/>ስሞንካ አንጂደ ማይራሞ፥ “ሀዌ ናአይ እስራኤልያን ጮራቶ ደንዱዋስነ ኩንደዉ ጋሶ ግዳናዉ፥ ቃይካ ኢታ ሃሳይያዋንቶ ማላ ግዳናዉ ዶረቴዳ። <verse eid="LUK 2:34"/><verse number="35" style="v" sid="LUK 2:35"/>ጮራቶካ ዎዛና ቆፋይ ቆንጮዋ ግዳናዉ፥ ነ ሸምፑካ ማሻን ቃንጾዋዳን ሴለታናዋ” ያጌዳ።<verse eid="LUK 2:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36"/>ቃይካ አሴራ ያራፐ ግዴዳ ፓኑኤላ ናታ ሃኖ ጌተትያ ናባታ ደአዉ፤ እዛካ ሎይ ጭማዱ። ባረ ዎዶሮተን ገሌዳ አስናና ላፑ ላይ ደኤዳዉኖ። <verse eid="LUK 2:36"/><verse number="37" style="v" sid="LUK 2:37"/>እዝ ላይይካ ሆስፑን ታማነ ኦይዱዋ ግዳና ጋካናዉ ጋላሳነ ቃማ ጌሻ ጎልያፐ ሻከተናን ጾማንነ ዎሳን ኪተታደ አምኤ<note caller="+" style="f"><char style="fr" closed="false">2:37 </char><char style="fk" closed="false">አምኤ፦ </char><char style="ft" closed="false">አምኤ ጉሳይ አስናይ ሀይቂና ገለናን ጋምኤዳ ማጫዉኖ። ሀ ፓይዱዋን ጻፈቴዳ ምሽራታ ላፑ ላይ ጻላላ አስናና ጋምኦዋፐ ጉየ 84 ላይ ኡባ አምኤ ግዳደ ጋምኣዱ።</char></note> ግዳደ ጋምኣዱ።<verse eid="LUK 2:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 2:38"/>ሄ ዎደካ ሺቃደ ጾሳ ጋላታዱ፤ ቃይካ የሩሳላመ አሳይ ዎዘታናዉ ናግያዋንቶ ኡባቶ ጋጭኖ ናኣ የሱሳባ ኦዳዱ።<verse eid="LUK 2:38"/></para>
  <para style="s1">ዮሴፎነ ማይራማ ናዝሬተ ስሜድኖ</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39"/>ዮሴፎነ ማይራማ ጎዳ ህግያን አዛዘቴዳዋ ኡባ ፖሎዋፐ ጉየ ጋሊላ አዉራጃን ደእያ ባረንቱ ካታማ ናዝሬተ ስሜድኖ።<note caller="-" style="x"><char style="xo" closed="false">2:39 </char><char style="xt" closed="false"><ref loc="MAT 2:23">ማቶሳ 2:23</ref></char></note> <verse eid="LUK 2:39"/><verse number="40" style="v" sid="LUK 2:40"/>ጉ ናአይካ ድጪደነ ምኒደ ቤዳ፤ አ ኤራንካ ኩሜዳ፤ ጾሳ አ ኬካተይ አ ቦላን ሸምፔዳ።<verse eid="LUK 2:40"/></para>
  <para style="s1">ጉ ናኣ የሱስ ጌሻ ጎልያን</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41"/>ዮሴፎነ ማይራማ ላይን ላይን ፓስጋ ባላ ቦንቻናዉ የሩሳላመ ካታማ ቢኖ።<note caller="-" style="x"><char style="xo" closed="false">2:41 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">ከሳ 12:1-27</ref>፤ <ref loc="DEU 16:1-8">ዛረ. 16:1-8</ref></char></note> <verse eid="LUK 2:41"/><verse number="42" style="v" sid="LUK 2:42"/>ናአዉካ ታማነ ላኡ ላይ ግዶ ዎደ ዶያዳን ባላዉ ህን የሩሳላመ ከሴድኖ። <verse eid="LUK 2:42"/><verse number="43" style="v" sid="LUK 2:43"/>ባላ ፖሎዋፐ ካላ ባረንቱ ጎለ ኡንቱንቱ ስሞደ ጉ ናኣ የሱስ ዮሴፎነ ማይራማ ኤረናን የሩሳላመን አት አጌዳ። <verse eid="LUK 2:43"/><verse number="44" style="v" sid="LUK 2:44"/>ኡንቱንቱና እትፐ ደእያዋ ማላትና እት ጋላሳ ኦግያ ሀመቴድኖ። ጉየፐ ቃይካ ባረንቱ ዳባቱዋናነ ባረንቱ ሲቀትያዋንቱ ማታን ኮሻ ዶሜድኖ።<verse eid="LUK 2:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 2:45"/>ዮ ዎደ ኮዪደ ህን የሩሳላመ ስሜድኖ። <verse eid="LUK 2:45"/><verse number="46" style="v" sid="LUK 2:46"/>ሄዙ ጋላሳፐ ጉየ፥ ታማርስያዋንቱ ግዶን የሱስ ኡቲደ ኡንቱንቱ ግያዋ ስሲደነ ኡንቱንታ ኦቺደ ጌሻ ጎልያ ጋርሳን ደእያዋ በኤድኖ። <verse eid="LUK 2:46"/><verse number="47" style="v" sid="LUK 2:47"/>ስስያዋንቱ ኡባቱካ፥ አ አኬካንነ አ ዛሩዋን ማላለቴድኖ።<verse eid="LUK 2:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 2:48"/>ዮሴፎነ አ ዳያ አ በኦ ዎደ ማላለቴድኖ። አ ዳያካ፥ “ታ ናአዉ፥ አያዉ ኑና ሀዋዳን ኦይ? ነ አቡነ ታነ ኔና ኮዪደ፥ ዳሮ መቶቴዶ” ያጋዱ።<verse eid="LUK 2:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49"/>የሱስካ ኡንቱንቶ፥ “አያዉ ታና ኮዪቴ? ታ አቡ ጎለን<note caller="+" style="f"><char style="fr" closed="false">2:49 </char><char style="fq" closed="false">ታ አቡ ጎለን፦ </char><char style="ft" closed="false">ጉሳይ፥ ታ አቡ ኪቴዳ ኦሱዋ ፖላናዉ በሴ ጉሳ።</char></note> ደአናዉ ታዉ ኮሽያዋ ኤርበይክቴ?” ያግ ዛሬዳ። <verse eid="LUK 2:49"/><verse number="50" style="v" sid="LUK 2:50"/>ሄዋ ያግ ኦዶፐ አትን፥ ኡንቱንቶ እ ኦዴዳ የዉ አያ ግንቶ ገልቤና።<verse eid="LUK 2:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51"/>ሄዋፐ ስሚደ፥ ኡንቱንቱና እትፐ ህን ናዝሬተ ቤዳ፤ ሄዋንካ ኡንቱንቶ አዛዘቴ። አ ዳያካ ሄዋ ኡባ ባረ ዎዛናን ዎዱ። <verse eid="LUK 2:51"/><verse number="52" style="v" sid="LUK 2:52"/>የሱስካ ኤራንነ ጌሳን፥ ሳባንካ ጾሳነ አሳ ስንን ድጬዳ።<note caller="-" style="x"><char style="xo" closed="false">2:52 </char><char style="xt" closed="false"><ref loc="1SA 2:26">1 ሳሜላ 2:26</ref>፤ <ref loc="PRO 3:4">ሌም. 3:4</ref></char></note><verse eid="LUK 2:52"/></para>
  <chapter eid="LUK 2"/>
  <chapter number="3" style="c" sid="LUK 3"/>
  <para style="s1">ጻማቅያ ዮሃንስ የሱሳዉ ኦግያ ጊግሴ</para>
  <para style="r">(<ref loc="MAT 3:1-12">ማቶሳ 3:1-12</ref>፤ <ref loc="MRK 1:1-8">ማር. 1:1-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1"/>ጽባርዮሳ ጌተትያ ካቲ ካዉቴዳ ታማነ እቼሸያ ላይን ጰንጸናውያ ጵላጾስ ይሁዳ ሞድያ ዎደ፥ ሄሮድሰ ጋሊላን ኦይደንያ ሻኩዋ ሞድያ ዎደ፥ አ እሻይ ፕልጶስካ እጹርያንነ ጽርኮንዶሳን ኦይደንያ ሻኩዋ ሞድያ ዎደ፥ ልሳንዮስካ አብሌነን ኦይደንያ ሻኩዋ ሞድያዋ ግዲደ ሞድ ደእሽን፥ <verse eid="LUK 3:1"/><verse number="2" style="v" sid="LUK 3:2"/>ሃንነ ቀያፋይ ቄሳቱዋ ካፓቱዋ<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fqa" closed="false">ቄሳቱዋ ካፓቱ ሃንነ ቀያፋይ፦ </char><char style="ft" closed="false">ሃና ካፖተ ዎዲ የሱስ የለታናፐ ካሰ 6-15 ላይ ጋካናሳ። ቀያፋ ጌተትያ ሃና ቦሉ 18-37 ላይ ካፖ ግዲደ የሱሳ የለታፐ ካሰ ጋምኤዳ።</char></note> ግዲደ ደእሽን፥ ጾሳ ቃላይ ዛካራሳ ናኣ ዮሃንሳኮ መላ ቢታን ዬዳ።<figure style="fig" alt="High priest" file="HK00267B.TIF" size="col" ref="3:2">ቄሳቱዋ ካፑዋ</figure> <verse eid="LUK 3:2"/><verse number="3" style="v" sid="LUK 3:3"/>ዮሃንስ ዮርዳኖሳ ሻፋ ሄራ ኡባ ቢደ፥ “ህንተ ናጋራይ አቶ ጌተታና ማላ ናጋራ ፓጺደ ጻማቀትተ” ያግ ታማርሴዳ።<verse eid="LUK 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 3:4"/>ናብያ ኢስያሳ ማጻፋን ጻፈቴዳ ቃላዳን፥<note caller="-" style="x"><char style="xo" closed="false">3:4-6 </char><char style="xt" closed="false"><ref loc="ISA 40:3-5">ኢሳ. 40:3-5</ref></char></note></para>
  <para style="q2" vid="LUK 3:4">“መላ ቢታን ዋስያ ብታንያ ኮሻይ፥</para>
  <para style="q1" vid="LUK 3:4">‘ጎዳዉ ኦግያ ጊግስተ፤</para>
  <para style="q2" vid="LUK 3:4">አ ኦግያካ ሱርስተ።<verse eid="LUK 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5"/>ኦላይ ኡባይ ኩሞ፤</para>
  <para style="q2" vid="LUK 3:5">ደሪነ ዞዚ ደንባ ግዶ፥</para>
  <para style="q2" vid="LUK 3:5">ጊገና ኦጊ ኡባይ ጊጎ፥</para>
  <para style="q2" vid="LUK 3:5">ሀንችሮ ኦጊ ኡባይ ሊቆ።<verse eid="LUK 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6"/>ሄዋ ግዶፐ፥</para>
  <para style="q2" vid="LUK 3:6">አሳይ ኡባይ ጾሳይ አሽያዋ በአና’ ”</para>
  <para style="m" vid="LUK 3:6">ያጌዳ።<verse eid="LUK 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7"/>ሀዋ ድራዉ ዮሃንስ አ ኩሽያን ጻማቀታናዉ ከሴዳ አሳዉ ሀዋዳን ኦዱዋ ዶሜዳ፥ “ሄንተኖ፥ ሾሻ ናቶ፤ ይያ ሀንቁዋፐ አታና ማላ ህንተንታ ኦን ማቄዴ?<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="MAT 12:34">ማቶሳ 12:34</ref>፤ <ref loc="MAT 23:33">23:33</ref></char></note> <verse eid="LUK 3:7"/><verse number="8" style="v" sid="LUK 3:8"/>ስም ህንተንቱ ናጋራፐ ስሜዳዋንቶ በስያ አይፍያ አይፍተ። ህንተንቱ ዎዛናን አብራሃሞ ኑ አቡ ደኤ ጎፕተ። ጾሳይ አብራሃሞ<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="fq" closed="false">አብራሃሞ ናና፦ </char><char style="ft" closed="false">አይሁዳ አሳቱ ባረንታ ጾሳይ ዶሬዳ አሳ ያግ ቆፒኖ። ጋሱነካ፥ በን ህዶታ ቃላይ ጾሳፐ ኑ አቡ አብራሃሞ እመቴዳ ያጊደ ቆፕያ ድራሳ።</char></note> ናና ሀ ሹቻቱዋፐ ደንናዉ ዳንዳዬ ያጋደ ታን ህንተንቶ ኦዳይ። <verse eid="LUK 3:8"/><verse number="9" style="v" sid="LUK 3:9"/>ሀእ ኡባ ቤጽ ም ጻጱዋን ቃንጻናዉ ጊግ ኡቴዳ፤ ስም ሎኦ አይፍያ አይፈና ምይ ኡባይ ቃንጸቲደ ታማን ኦለታናዋ።”<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="MAT 7:19">ማቶሳ 7:19</ref></char></note><verse eid="LUK 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10"/>“ያትና ሀእ ኑ አያ ኡዳኔ?” ያጊደ አ ጮራ አሳይ ኦቼዳ።<verse eid="LUK 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11"/>ዮሃንስካ፥ “ላኡ ማዩ ደእያዌ ባይናዎ እሞ፤ ቁማይ ደእያዌካ ባይናዎ ግሾ” ያግ ዛሬዳ።<verse eid="LUK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12"/>ቃራጻ ሺሽያዋንቱካ ጻማቀታናዉ ዪደ፥ “ታማርስያዎ፥ ኑ አያ ኡዳኔ?” ያግ ኦቼድኖ።<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="LUK 7:29">ሉቃሳ 7:29</ref></char></note><verse eid="LUK 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13"/>እ ኡንቱንቶ፥ “ጌተቶዋፐ አ ቃራጻ አ ሺሾፕተ” ያግ ኦዴዳ።<verse eid="LUK 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 3:14"/>ሄዋፐ ካላ ዎታዳራቱ፥ “ኑንሽ፥ አያ ኡዳኔ?” ያግ አ ኦቼድኖ።</para>
  <para style="p" vid="LUK 3:14">ዮሃንስካ፥ “አሳ ሻሉዋ ናቁዋን ቦንቂ አኮፕተ፥ ኦናነ ዎርዱዋን ሞቶፕተ፥ ህንተንቱ ድርጉ ህንተንቶ ግዳና” ያግ ዛሬዳ።<verse eid="LUK 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15"/>ሄ ዎደ አሳይ ኡባይ ክርስቶሳ ዩሳ ናጊደ ደእያ ድራዉ ዮሃንሳ፥ “ሀዌካ ክርስቶሳ ግደናን አተና” ያጊደ ባረንቱ ዎዛናን ማሌድኖ። <verse eid="LUK 3:15"/><verse number="16" style="v" sid="LUK 3:16"/>ዮሃንስ ኡባቱዋካ፥ “ታን ሃን ጻማቃይ፤ ግዶፐ አትን ታፐ ዎልቃማይነ ታንካ አ ጫማ ቃሹዋ ብላና ዳንዳየናዌ<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="fq" closed="false">አ ጫማ ቃሹዋ ብላና ዳንዳየናዌ፦ </char><char style="ft" closed="false">ሀዌ ቆማ ዎይ ዳንጋጽራት ኦሱዋ።</char></note> ብሮ ያናዋ፤ እካ አያና ጌሻንነ ታማን ጻማቃናዋ፤ <verse eid="LUK 3:16"/><verse number="17" style="v" sid="LUK 3:17"/>አ ኩሽያን ካ ዳላፐ ሻክ ጌሽያ ላይዳይ ደኤ። ካ ኡዱማን ቡኮዋ ጌሽ ፑኒደ አይፍያ ድይያን ቆሌ፤ ሽን ዳላ ቶኤና ታማን ጉዴ።”<verse eid="LUK 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 3:18"/>ዮሃንስካ ሀራ ጮራ ቃላን ጮራ አሳ ማቂደ ምሽራቹዋ ቃላ ኦዴዳ።<verse eid="LUK 3:18"/></para>
  <para style="s1">ሄሮድሰ ጻማቅያ ዮሃንሳ ቃቼዳ</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 3:19"/>ጋሊላ ሞድያ ሄሮድሳ ቃይ ባረ እሻ ፕልጶሳ ማቻቶ ሄሮድያዶ እ አኬዳ ድራዉነ ሀራካ ጮራ ኢታ ኪታ ኪተቶ ድራዉ፥ ዮሃንስ ሴሬዳ። <verse eid="LUK 3:19"/><verse number="20" style="v" sid="LUK 3:20"/>ሀዋ ድራዉ ሀ ኡባ ጉጂደ ሄሮድሰ ዮሃንሳ ቃሾ ጎለ ገልሴዳ።<note caller="-" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="MAT 14:3-4">ማቶሳ 14:3-4</ref>፤ <ref loc="MRK 6:17-18">ማር. 6:17-18</ref></char></note><verse eid="LUK 3:20"/></para>
  <para style="s1">ዮሃንስ የሱሳ ጻማቄዳ</para>
  <para style="r">(<ref loc="MAT 3:13-17">ማቶሳ 3:13-17</ref>፤ <ref loc="MRK 1:9-11">ማር. 1:9-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21"/>አሳይ ኡባይ ጻማቀት ስሞዋፐ ጉይያን የሱስ ጻማቀቴዳ። እ ዎስ ደእሽንካ ሳሉ ዶየት አጌዳ። <verse eid="LUK 3:21"/><verse number="22" style="v" sid="LUK 3:22"/>ጌሻ አያናይካ ሀራጵያ ማላቲደ አ ቦላን ዎዳ። ሳሉዋፐካ፥ “ታ ዶስያ ናአይ ኔና፤ ኔናን ታን ናሸታይ” ያግያ ቃላይ ዬዳ።<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="GEN 22:2">ዶመ 22:2</ref>፤ <ref loc="PSA 2:7">ማዝ. 2:7</ref>፤ <ref loc="ISA 42:1">ኢሳ. 42:1</ref>፤ <ref loc="MAT 1:17">ማቶሳ 1:17</ref>፤ <ref loc="MRK 1:11">ማር. 1:11</ref>፤ <ref loc="LUK 9:35">ሉቃሳ 9:35</ref></char></note><verse eid="LUK 3:22"/></para>
  <para style="s1">የሱሳ የለታይ ካሰ ጉየ ማይዛፐ ደእያ ፓይዱዋ</para>
  <para style="r">(<ref loc="MAT 1:1-17">ማቶሳ 1:1-17</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23"/>የሱስ ታማርሱዋ ዶሞደ አዉ ሀታሙ ላይ ግዴዳ፤ ጮራ አሳይካ ባረንቶ ማላቶዋዳን አ ዮሴፎ ናኣ ያጊኖ፤ ዮሴፎ ኤለ ናኣ፤ <verse eid="LUK 3:23"/><verse number="24" style="v" sid="LUK 3:24"/>ኤለ ማተ ናኣ፤ ማተ ሌዊያ ናኣ፤ ሌዊ ምልከ ናኣ፤ ምልከ ዮና ናኣ፤ ዮን ዮሴፎ ናኣ፤ <verse eid="LUK 3:24"/><verse number="25" style="v" sid="LUK 3:25"/>ዮሴፎ ማታትያ ናኣ፤ ማታት አሞጸ ናኣ፤ አሞጸ ናሆመ ናኣ፤ ናሆመ ኤስሊመ ናኣ፤ ኤስሊመ ናገ ናኣ፤ <verse eid="LUK 3:25"/><verse number="26" style="v" sid="LUK 3:26"/>ናገ ማኣተ ናኣ፤ ማኣተ ማታትዩ ናኣ፤ ማታትዩ ሴመየ ናኣ፤ ሴመይ ዮሴፎ ናኣ፤ ዮሴፎ ዮዳ ናኣ፤ <verse eid="LUK 3:26"/><verse number="27" style="v" sid="LUK 3:27"/>ዮድ ዮናና ናኣ፤ ዮናን ሬሰ ናኣ፤ ሬሰ ዘሩባቤላ ናኣ፤ ዘሩባቤል ሳላትያላ ናኣ፤ ሳላትያለ ኔለ ናኣ፤ <verse eid="LUK 3:27"/><verse number="28" style="v" sid="LUK 3:28"/>ኔል ምልከ ናኣ፤ ምልከ ሃደ ናኣ፤ ሃደ ዮሳሰ ናኣ፤ ዮሳሰ ቆሳማ ናኣ፤ ቆሳም ኤልማዶመ ናኣ፤ ኤልማዶመ ኤረ ናኣ፤ <verse eid="LUK 3:28"/><verse number="29" style="v" sid="LUK 3:29"/>ኤረ ዮሴኤ ናኣ፤ ዮሴኤ፥ ኤልኤዘራ ናኣ፤ ኤልኤዘረ፥ ዮራመ ናኣ፤ ዮራም ማጻተ ናኣ፤ ማጻተ ሌዊያ ናኣ፤ <verse eid="LUK 3:29"/><verse number="30" style="v" sid="LUK 3:30"/>ሌዊ ስሞና ናኣ፤ ስሞነ ይሁዳ ናኣ፤ ይሁዳይ ዮሴፎ ናኣ፤ ዮሴፎ ዮናና ናኣ፤ ዮናን ኤልያቄማ ናኣ፤ <verse eid="LUK 3:30"/><verse number="31" style="v" sid="LUK 3:31"/>ኤልያቄም ሜልያ ናኣ፤ ሜልየ ማይናና ናኣ፤ ማይናን ማጻተ ናኣ፤ ማጻተ ናታነ ናኣ፤ ናታነ ዳዊተ ናኣ፤ <verse eid="LUK 3:31"/><verse number="32" style="v" sid="LUK 3:32"/>ዳዊተ እሰይ ናኣ፤ እሰይ እዮቤዳ ናኣ፤ እዮቤድ ቦኤዛ ናኣ፤ ቦኤዝ ሳልሞና ናኣ፤ ሳልሞን ናህሾና ናኣ፤ <verse eid="LUK 3:32"/><verse number="33" style="v" sid="LUK 3:33"/>ናህሾን አምናዳባ ናኣ፤ አምናዳብ ራማ ናኣ፤ ራም አሪና ናኣ፤ አሪናይ ሄዝሮና ናኣ፤ ሄዝሮን ፐሬዛ ናኣ፤ ፐሬዝ ይሁዳ ናኣ፤ <verse eid="LUK 3:33"/><verse number="34" style="v" sid="LUK 3:34"/>ይሁዳይ ያቆባ ናኣ፤ ያቆብ ይሳቃ ናኣ፤ ይሳቅ አብራሃሞ ናኣ፤ አብራሃሞ ታራ ናኣ፤ ታር ናኮራ ናኣ፤ <verse eid="LUK 3:34"/><verse number="35" style="v" sid="LUK 3:35"/>ናኮር ሴሮሄ ናኣ፤ ሴሮህ ራጋዋ ናኣ፤ ራጋው ፐለጋ ናኣ፤ ፐለግ አቤራ ናኣ፤ አቤር ሳላ ናኣ፤ <verse eid="LUK 3:35"/><verse number="36" style="v" sid="LUK 3:36"/>ሳል ቃይናና ናኣ፤ ቃይናን አርፋክሲደ ናኣ፤ አርፋክሲደ ሴመ ናኣ፤ ሴም ኖሄ ናኣ፤ ኖሄ ላሜሄ ናኣ፤ <verse eid="LUK 3:36"/><verse number="37" style="v" sid="LUK 3:37"/>ላሜህ ማቱሳላ ናኣ፤ ማቱሳል ሄኖከ ናኣ፤ ሄኖክ ያሬዳ ናኣ፤ ያሬድ ማላልኤላ ናኣ፤ ማላልኤል ቃይናና ናኣ፤ <verse eid="LUK 3:37"/><verse number="38" style="v" sid="LUK 3:38"/>ቃይናን ሄኖሳ ናኣ፤ ሄኖስ ሴተ ናኣ፤ ሴት አዳማ ናኣ፤ አዳም ጾሳ ናኣ።<verse eid="LUK 3:38"/></para>
  <chapter eid="LUK 3"/>
  <chapter number="4" style="c" sid="LUK 4"/>
  <para style="s1">የሱሳዉ ሺቄዳ ጻላህያ ፓጭያ</para>
  <para style="r">(<ref loc="LUK 4:1-13">4:1-13</ref>፤ <ref loc="MAT 4:1-11">ማቶሳ 4:1-11</ref>፤ <ref loc="MRK 1:12">ማር. 1:12</ref>፣ <ref loc="MRK 1:13">13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1"/>የሱስ ጌሻ አያናን ኩሚደ ዮርዳኖሳ ሻፋፐ ስሜዳ፤ አያናን መላ ሳኣ ካለሰቲደ ቤዳ። <verse eid="LUK 4:1"/><verse number="2" style="v" sid="LUK 4:2"/>ሄዋን ኦይታሙ ጋላሳ ዳብሎሳን ፓጨቴዳ። ሄ ጋላሳቱዋን አያነ ምቤና ድራዉ ዉርሰ ፖሉዋ ሄራን እ ኮሻቴዳ።<verse eid="LUK 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3"/>ዳብሎስካ፥ “ኔን ጾሳ ናኣ ግዶፐ ሀ ሹቻ፥ ‘ኡክ ግዳ’ ጋደ አዛዛ” ያጌዳ።<verse eid="LUK 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4"/>የሱስካ፥ “ ‘አሳይ ጾሳ ቃላ ኡባፐ አትን ኡክ ጻላላን ደኤና’ ጌተት ጾሳ ቃላን ጻፈቴዳ” ያግ ዛሬዳ።<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">ዛረ. 8:3</ref></char></note><verse eid="LUK 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5"/>ዳብሎስካ ቃ ግዴዳ ደርያ የሱሳ ከሲደ አላምያ ካዉተ ኡባ ልጶ አይፊ ስማናዉ በሴዳ። <verse eid="LUK 4:5"/><verse number="6" style="v" sid="LUK 4:6"/>ዳብሎስካ፥ “ሀ ካዉተ ማታይነ ቦንቹ ኡባይ ታዉ እመቴዳ። ታን ታ ዶስያ ኦስነ እማና፤ ነዉካ እማና። <verse eid="LUK 4:6"/><verse number="7" style="v" sid="LUK 4:7"/>ሄዋ ግድያ ድራዉ፥ ነ ታ ስንን ታዉ ጎይኖፐ ሀ ኡባይ ኔሳ ግዳናዋ” ያጌዳ።<verse eid="LUK 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8"/>የሱስካ ዛሪደ፥ “ ‘ጎዳ ጾሳዉ ጎይና፥ አ ጻላላ ጎዳያ’ ጌተት ጾሳ ቃላን ጻፈቴዳ” ያጌዳ።<verse eid="LUK 4:8"/></para>
  <para style="p">
    <verse number="9-11" style="v" sid="LUK 4:9-11"/>ዳብሎስካ የሱሳ የሩሳላመ አፊደ ጌሻ ጎልያ ሁጲያ ከሲደ፥</para>
  <para style="q1" vid="LUK 4:9-11">“ ‘ጾሳይ ኔና ናጋና ማላ፥</para>
  <para style="q2" vid="LUK 4:9-11">ኪታንቻቱዋ ኪታናዋ፥</para>
  <para style="q2" vid="LUK 4:9-11">ኡንቱንቱካ ነ ገዲ ሹቻን በተና ማላ፥</para>
  <para style="q2" vid="LUK 4:9-11">ባረንቱ ኩሽያን ኔና ደንናዋንታ’ ያገቲደ፥</para>
  <para style="q1" vid="LUK 4:9-11">ጌሻ ማጻፋን ጻፈቴዳ፤</para>
  <para style="q2" vid="LUK 4:9-11">አነ ኔን ጾሳ ናኣ ግዶፐ፥</para>
  <para style="q2" vid="LUK 4:9-11">ሀዋፐ ዱገ ኔና ኦላ”<note caller="-" style="x"><char style="xo" closed="false">4:9-11 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">ማዝ. 91:11-12</ref></char></note></para>
  <para style="m" vid="LUK 4:9-11">ያጌዳ።<verse eid="LUK 4:9-11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12"/>የሱስካ ዛሪደ፥ “ ‘ነ ጎዳ ጾሳ ፓጮፓ’ ጌተቴዳ” ያጌዳ።<verse eid="LUK 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13"/>ዳብሎስካ ፓጭያ ኡባ ዉርሶዋፐ ጉየ ጉ ዎደዉ የሱሳፐ ሻከቴዳ።<verse eid="LUK 4:13"/></para>
  <para style="s1">የሱስ ጋሊላን ኦሱዋ ዶሜዳ</para>
  <para style="r">(<ref loc="MAT 4:12-17">ማቶሳ 4:12-17</ref>፤ <ref loc="MRK 1:14">ማር. 1:14</ref>፣ <ref loc="MRK 1:15">15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14"/>የሱስካ አያና ዎልቃን ጋሊላ ጋድያ ስሜዳ። አ ዋሪካ ዩሹዋን ደእያ ኡባ ጋኬዳ። <verse eid="LUK 4:14"/><verse number="15" style="v" sid="LUK 4:15"/>የሱስካ አይሁዳቱዋ ዎሳ ጎልያን ታማርሲደ አሳን ኡባን ጋላተቴዳ።<verse eid="LUK 4:15"/></para>
  <para style="s1">ናዝሬተን የሱሳ እጼድኖ</para>
  <para style="r">(<ref loc="MAT 13:53-58">ማቶሳ 13:53-58</ref>፤ <ref loc="MRK 6:1-6">ማር. 6:1-6</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16"/>እ ባረ ድጮ ካታማ ናዝሬተ ዬዳ፤ ካሰ ኦያዋዳንካ ሳምባታ ጋላስ አይሁዳቱዋ ዎሳ ጎለ ገሊደ ናባባናዉ ደንዲደ ኤቄዳ። <verse eid="LUK 4:16"/><verse number="17-19" style="v" sid="LUK 4:17-19"/>ናብያ ኢስያሳ ን ጻፈቲደ ጻጸቴዳ ማጻፋ አዉ እሜድኖ። ሄ ማጻፋ ብሊደ:</para>
  <para style="q1" vid="LUK 4:17-19">“ታን ህየሳቶ ምሽራቹዋ ኦዳናዉ</para>
  <para style="q2" vid="LUK 4:17-19">ኦከቴዳ ድራዉ ጎዳ አያናይ ታ ቦላን ደኤ።</para>
  <para style="q1" vid="LUK 4:17-19">ቃሸቴዳዋንቶ ብለ፥</para>
  <para style="q2" vid="LUK 4:17-19">ቆቃቶ ጼላና ማላ ኦዳናዉ፥</para>
  <para style="q2" vid="LUK 4:17-19">ቃይካ ናቀቴዳዋንታ ናቁዋፐ</para>
  <para style="q2" vid="LUK 4:17-19">ከሳና ማላ ዶሰቴዳ ጎዳ ላይ</para>
  <para style="q2" vid="LUK 4:17-19">ኦዳና ማላ፥ ታና ኪቴዳ”</para>
  <para style="m" vid="LUK 4:17-19">ጌተት ጻፈቴዳሳ ደሜዳ።<note caller="-" style="x"><char style="xo" closed="false">4:17-19 </char><char style="xt" closed="false"><ref loc="ISA 61:1-2">ኢሳ. 61:1-2</ref></char></note><verse eid="LUK 4:17-19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20"/>ማጻፋካ ጻጺደ አይሁዳቱዋ ዎሳ ጎልያን ኦያዎ እሚደ ኡቴዳ። አይሁዳቱዋ ዎሳ ጎልያን ደእያ አሳይ ኡባይ አ ጫድ ጼሌዳ። <verse eid="LUK 4:20"/><verse number="21" style="v" sid="LUK 4:21"/>የሱስካ፥ “ሀቼ ህንተዉ ናባበትና ህንተንቱ ስሴዳ ቃላይ ፖለቴዳ” ያጌዳ።<verse eid="LUK 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22"/>ኡባይ አዉ ማርካቴድኖ። አ ዶናፐ ከስያ አ ኬካተ ቃላፐ ደንዴዳዋን ማላለቲደ፥ “ሀዌ ዮሴፎ ናኣ ግደኔ?” ጌድኖ።<verse eid="LUK 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23"/>የሱስካ ስ ባንታን ሀ ሌምሱዋን፥ “ህንተንቱ ታዉ ‘ልያ ጎዳዉ፥ ነ ሁጲያ ፓ፥ ኔን ቅፍርናሆማን ኦና ኑ ስሶዋ ኡባ ሀ ነ ካታማንካ ቃይ ኦ’ ያጊደ ኦዲታ” ያጌዳ። <verse eid="LUK 4:23"/><verse number="24" style="v" sid="LUK 4:24"/>ቃይካ፥ “ቱሙዋ ያጋይ፥ ናቢ ባረ የለቶ ጋድያን ጋማካ ቦንቼተና።<note caller="-" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="JHN 4:44">ዮሃ. 4:44</ref></char></note><verse eid="LUK 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 4:25"/>“የዉዋን ቃይ ቱሙዋ ኦዳይ: ኤላሳ ዎድያን ሄዙ ላይነ ኡሱፑን አገና እራይ ቡከናን እጽና ሳኣ ኡባን ዎልቃማ ኮሻይ ገሌዳ ዎደ፥ እስራኤለን ጮራ አምአቱ ደኢኖ።<note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 ካታ. 17:1</ref></char></note> <verse eid="LUK 4:25"/><verse number="26" style="v" sid="LUK 4:26"/>ኤላስካ ሲዶና ጋድያን ደእያ ሰራፍታ ሄራ እት አምአትኮ ኪተቴዳፐ አትን ኦኮነ ኪተትቤና።<note caller="-" style="x"><char style="xo" closed="false">4:26 </char><char style="xt" closed="false"><ref loc="1KI 17:8-16">1 ካታ. 17:8-16</ref></char></note> <verse eid="LUK 4:26"/><verse number="27" style="v" sid="LUK 4:27"/>ናብያ ኤልሳአ ዎድያንካ እስራኤልያን ጮራ ኦሉዋ ሀርግያን<note caller="+" style="f"><char style="fr" closed="false">4:27 </char><char style="fq" closed="false">ኦሉዋ ሀርግያ፦ </char><char style="ft" closed="false">ጾሳ ቃላይ ታማርሰትያ ዎድያ ኡባን፥ “ኦሉዋ” ግያ ቃላይ ጋልባ ቦላን ሳክያ ሳኩዋ ኡባዉ አከትያዋ።</char></note> ኦይቀቴዳዋንቱ ደኢኖ፤ ሶርያ ቢታን ደእያ ንእማነፐ አትን ኡንቱንቱፐ ኦንነ ፓጽ ቤና” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">4:27 </char><char style="xt" closed="false"><ref loc="2KI 5:1-14">2 ካታ. 5:1-14</ref></char></note><verse eid="LUK 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28"/>አይሁዳቱዋ ዎሳ ጎልያን ደእያዋንቱ ኡባቱ ሀዋ ስሲደ ዳርሲደ ሀንቀቴድኖ። <verse eid="LUK 4:28"/><verse number="29" style="v" sid="LUK 4:29"/>ኡንቱንቱ ደንዲደ የሱሳ ካታማፐ ጋጻ ከሲደ ዱገ ኦላናዉ ካታማይ ኬጸቴዳ ደርያ ሁጲያ አፌድኖ። <verse eid="LUK 4:29"/><verse number="30" style="v" sid="LUK 4:30"/>ሽን የሱስ ኡንቱንቱ ግዱዋና አደ ቤዳ።<verse eid="LUK 4:30"/></para>
  <para style="s1">ኢታ አያናይ ኦይቄዳ ብታንያ</para>
  <para style="r">(<ref loc="LUK 4:31-37">4:31-37</ref>፤ <ref loc="MRK 1:21-28">ማር. 1:21-28</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31"/>ሄዋፐ ጉይያን የሱስ ጋሊላ ጋድያን ደእያ ቅፍርናሆማ ካታማ ቤዳ። ሳምባታ ጋላሳንካ አሳ ታማርሴዳ። <verse eid="LUK 4:31"/><verse number="32" style="v" sid="LUK 4:32"/>እ ታማርስያ ትምርቲ ማታን ግድያ ድራዉ ስሴዳ አሳይ ኡባይ ማላለቴድኖ።<note caller="-" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="MAT 7:28">ማቶሳ 7:28</ref>፣ <ref loc="MAT 7:29">29</ref></char></note><verse eid="LUK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 4:33"/>አይሁዳቱዋ ዎሳ ጎልያን ኢታ አያናይ ኦይቄዳ ብታኒ ደኤ፤ ባረ ኮሻ ቁ ኦ ዋሲደ፥ <verse eid="LUK 4:33"/><verse number="34" style="v" sid="LUK 4:34"/>“ሀያ ጎዶ አጋርኪ ናዝሬትያ የሱሳ፤ ኑዉ ኔናና አይ እትፐተይ ደኢ? ኑና ባይዛናዉ ያድ? ኔን ኦነንቶ ኤራድ፤ ኔን ጾሳ አዉ ኪቴዳ ጌሻ ግድኪ!” ያጌዳ።<verse eid="LUK 4:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35"/>የሱስካ፥ “ጮኡ ጋ፥ አፐካ ከሳ” ያግ ሴሬዳ። ኢታ አያናይ ብታንያ ኡንቱንቱ ግዱዋን ኩንድሲደ አይነ ቆሄናን አፐ ከሴዳ።<verse eid="LUK 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36"/>አሳይ ኡባይ ማላለቲደ እቱ እቶ፥ “ሀዌ አያ ቃሌ? ባረዉ ደእያ ማታንነ ዎልቃን ኢታ አያናቱዋ ሴሬ፤ ቃይ ኢታ አያናይካ ከሴ” ያጊደ ሃሳዬድኖ። <verse eid="LUK 4:36"/><verse number="37" style="v" sid="LUK 4:37"/>አ ዋሪካ ሄ ዩሹዋን ደእያ ጋድያ ኡባ ጋኬዳ።<verse eid="LUK 4:37"/></para>
  <para style="s1">የሱስ ጮራ ሀርጋንቻ አሳ ፓዳ</para>
  <para style="r">(<ref loc="MAT 8:14-17">ማቶሳ 8:14-17</ref>፤ <ref loc="MRK 1:29-34">ማር. 1:29-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38"/>የሱስ አይሁዳቱዋ ዎሳ ጎልያፐ ደንዲደ ስሞና ጎልያ ገሌዳ፥ ስሞና ቦሎታታ ዎልቃማ ቆጹዋ ሀርግያን ሀርገታደ ግሴዳዉንዉ የሱስ እዞ ፓናዳን አሳይ አ ዎሴዳ። <verse eid="LUK 4:38"/><verse number="39" style="v" sid="LUK 4:39"/>እ ማታን ኤቂደ ቆጹዋ ሀርግያ ሴርና፥ ሀርጊ የዲሼዳ፤ ሄ ዎድያንካ ደንዳደ ኡንቱንቶ ኪተታዱ።<verse eid="LUK 4:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40"/>አዋይ ዉሎ ዎድያን ዱማ ዱማ ሀርግያን ኦይቀቴዳ ሀርጋንቻቱዋ ኡባ አኮ አሄድኖ፤ እካ እቱዋ እቱዋ ቦላ ባረ ኩሽያ ዎደ ፓዳ። <verse eid="LUK 4:40"/><verse number="41" style="v" sid="LUK 4:41"/>ኢታ አያናቱካ፥ “ኔን ክርስቶሳ ጾሳ ናኣ” ያግ ዋሲደ ጮራ አሳፐ ከሴድኖ። እ ክርስቶሳ ግዶዋ ኡንቱንቱ ኤሬዳ ድራዉ ሃሳየና ማላ ድጌዳ።<verse eid="LUK 4:41"/></para>
  <para style="s1">የሱስ ጋሊላን ታማርሴዳ</para>
  <para style="r">(<ref loc="MAT 4:23-25">ማቶሳ 4:23-25</ref>፤ <ref loc="MRK 1:35-39">ማር. 1:35-39</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42"/>ሳአይ ዎንቶ ዎደ አሳይ ባይናሳ ቤዳ፤ አሳይ ኡባይ አ ኮዪደ እ ደኢያሳ ዬድኖ። ባረንቱፐ ሻከት ቤናዳን ድጋናዉ ኮዬድኖ። <verse eid="LUK 4:42"/><verse number="43" style="v" sid="LUK 4:43"/>እ ቃይ፥ “ህን ሀራ ካታማቶ ባደ ጾሳ ካዉተ ምሽራቹዋ ቃላ ኦዳናዉ ኮሼ፤ ታን ኪተቴዳዌ ሀዋ ድራሳ” ያጌዳ።<verse eid="LUK 4:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 4:44"/>ጋሊላን ደእያ አይሁዳቱዋ ዎሳ ጎለን ቃላ ታማርሲደ ጋምኤዳ።<verse eid="LUK 4:44"/></para>
  <chapter eid="LUK 4"/>
  <chapter number="5" style="c" sid="LUK 5"/>
  <para style="s1">የሱስ ኮይሮ ባረና ካልያዋንታ ዶሬዳ</para>
  <para style="r">(<ref loc="MAT 4:18-22">ማቶሳ 4:18-22</ref>፤ <ref loc="MRK 1:16-20">ማር. 1:16-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1"/>እት ጋላስ የሱስ ገንሳሬጸ አባ<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="fq" closed="false">ገንሳሬጸ አባ፦ </char><char style="ft" closed="false">ጋሊላ አባዉ እመቴዳ ዱማ ሱን።</char></note> ጋጻን ኤቂደ ደእሽን ጮራ አሳይ አኮ ሺቂደ ጾሳ ቃላ ስሳናዉ ሱገት ደኢኖ።<note caller="-" style="x"><char style="xo" closed="false">5:1-3 </char><char style="xt" closed="false"><ref loc="MAT 13:1">ማቶሳ 13:1</ref>፣ <ref loc="MAT 13:2">2</ref>፤ <ref loc="MRK 3:9">ማር. 3:9</ref>፣ <ref loc="MRK 3:10">10</ref>፤ <ref loc="MRK 4:1">4:1</ref></char></note> <verse eid="LUK 5:1"/><verse number="2" style="v" sid="LUK 5:2"/>ሄ ዎደ ላኡ ዎንግራቱ<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="fqa" closed="false">ዎንግርያ፦ </char><char style="ft" closed="false">ዎንግርያ ጌተቶዌ፥ ዎጋ ሃ ዎይ አባ ቦላን አሳይ ሄፍን ባጋ ፕናናዉ ጎኤትያ ሚሻ። ሀይቆ አሳይ ሞገትያዋ ግደናዋ ኤራናዉ ኮሼ።</char></note> አባ ጋጻን ኤቆዋ እ በኤዳ፤ ሞልያ ጲርያዋንቱ ቃይ ዎንግራቱዋፐ ዎደ ባረንቱ ዳባ ሜጭ ደኢኖ።<figure style="fig" alt="Fisher men in their fishing boat" file="HK00208B.TIF" size="span" ref="5:2">ሞልያ ጵርያዋንቱ ባረንቱ ዎንግሪያን</figure> <verse eid="LUK 5:2"/><verse number="3" style="v" sid="LUK 5:3"/>የሱስ ዎንግራቱዋ ግዶፐ ስሞናዉኖ ግዴዳዉንን ገሊደ ሳኣፐ ያ አባኮ ጉ ሺሻናዳን ኦቼዳ። ሄዋፐ ጉየ ዎንግርያ ቦላን ኡቲደ አሳ ታማርሱዋ ዶሜዳ።<verse eid="LUK 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4"/>ታማርሱዋ በዋፐ ጉይያን ስሞና፥ “ዎንግርያ ያ አባ ጪሙዋኮ ሺሽተ፤ ህንተንቱ ዳባካ ሞልያ ጲራናዉ ኦልተ” ያጌዳ።<verse eid="LUK 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5"/>ስሞንካ፥ “ጎዳዉ፥ ቃማ ኩመን ዳቡር አቂደ አይነካ ኦይቂበይኮ፤ ሽን ሀእ ኔን ጎዋዳን ዳባ ኦሌቶ” ያግ ዛሬዳ።<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="JHN 21:3">ዮሃ. 21:3</ref></char></note><verse eid="LUK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 5:6"/>ሄዋዳንካ ኦዳ ዎደ፥ ዳሮ ጮራ ሞልያ ኦይቄድኖ። ኡንቱንቱ ዳባቱካ ዱጸረታናዉ ሀኔድኖ።<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="JHN 21:6">ዮሃ. 21:6</ref></char></note> <verse eid="LUK 5:6"/><verse number="7" style="v" sid="LUK 5:7"/>ሀራ ዎንግርያን ደእያ ላገቱ ዪደ ማዳናዳን ዉቴድኖ፤ ኡንቱንቱ ላኡ ዎንግራቱዋንካ ሞልያ ኩንና ዎንግራቱ ምተቱሳ ዶሜድኖ።<verse eid="LUK 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 5:8"/>ስሞን ጰጽሮስካ ሀዋ በኤዳ ዎደ የሱሳ ጉልባታን ኩንዲደ፥ “ጎዳዉ፥ ታን ናጋራንቻ አሳ ግዶ ድራዉ ታፐ ሻከታ” ያጌዳ። <verse eid="LUK 5:8"/><verse number="9" style="v" sid="LUK 5:9"/>ሀዋ ጌዳዌ እነ አናና እትፐ ደእያዋንቱ ኡባይ ባረንቱ ኦይቄዳ ሞልያ ጮራተን ማላለቴድኖ። <verse eid="LUK 5:9"/><verse number="10" style="v" sid="LUK 5:10"/>ሄዋዳንካ ቃይ ስሞና ላገ ግዴዳዋንቱ ዛብድዮሳ ናናቱ ያቆብነ ዮሃንስ ማላለቴድኖ።</para>
  <para style="p" vid="LUK 5:10">የሱስካ ስሞና፥ “ያዮፓ ሀዋፐ ጉይያን አሳ ጲርያዋ ግዳናሳ” ጌዳ።<verse eid="LUK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 5:11"/>ኡንቱንቱካ ዎንግራቱዋ ሃፐ ጋጻ ከሲደ፥ ኡባባ አጊደ የሱሳ ካሌድኖ።<verse eid="LUK 5:11"/></para>
  <para style="s1">የሱስ ኦሉ ኦይቄዳ ብታንያ ፓዳ</para>
  <para style="r">(<ref loc="MAT 8:1-4">ማቶሳ 8:1-4</ref>፤ <ref loc="MRK 1:40-45">ማር. 1:40-45</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12"/>የሱስ ካታማቱዋፐ እቱዋን ደእሽን ኦሉ<note caller="+" style="f"><char style="fr" closed="false">5:12 </char><char style="fqa" closed="false">ኦሉዋ፦ </char><char style="ft" closed="false">4:27 ጼልተ።</char></note> ቦላ ኡባ ሜዳ ብታኒ ደእያዌ የሱሳ በኢደ አ ስንንካ ኩንዲደ፥ “ጎዳዉ፥ ኔን ኮዮፐ ታና ፓናዉ ዳንዳያ” ያጊደ ዎሴዳ።<verse eid="LUK 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13"/>የሱስካ ባረ ኩሽያ የድ ቦቺደ፥ “ዶሳይ ጌያ!” ጌዳ። ሄማንእያንካ ኦሉ አ የዴዳ።<verse eid="LUK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 5:14"/>የሱስ አ፥ “ሀዋ ኦስነ ኦዶፓ። ሽን ቄሳኮ ባደ ኔና በሳ። ሄዋፐ ጉየ ኦሉዋ ሀርግያፐ ፓጼዳዎ ማርካ ግዳናዳን ሙሴ ህግያን አዛዘቴዳ ያርሹዋ ሺሻ” ጌዳ።<verse eid="LUK 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15"/>ግዶ ሽን አ ዋሪ ሎይ አኪደ ቤዳ፤ ዳሮ ጮራ አሳይካ የሱስ ኦድያዋ ስሳናዉነ ባረንቱ ሀርግያፐ ፓጻናዉ ሺቄድኖ። <verse eid="LUK 5:15"/><verse number="16" style="v" sid="LUK 5:16"/>የሱስ ጮራ ዎደ ጌማሳ ቢደ ዎሴ።<verse eid="LUK 5:16"/></para>
  <para style="s1">የሱስ ቦላይ ስሌዳ ብታንያ ፓዳ</para>
  <para style="r">(<ref loc="LUK 5:18-26">5:18-26</ref>፤ <ref loc="MAT 9:2-8">ማቶሳ 9:2-8</ref>፤ <ref loc="MRK 2:3-12">ማር. 2:3-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17"/>እት ጋላስ የሱስ ታማርሲደ ደእሽን ጋሊላፐነ ይሁዳ ሄራ ኡባፐ፥ የሩሳላመ ዬዳ ፓርሳዋቱነ ህግያ ታማርስያዋንቱ ኡት ደእሽን ሀርጋንቻቱዋ ፓና ማላ ጾሳ አዉዋ ዎልቃይ አዉ እመቴዳ። <verse eid="LUK 5:17"/><verse number="18" style="v" sid="LUK 5:18"/>ሄ ዎደ ቦላይ ስሌዳ<note caller="+" style="f"><char style="fr" closed="false">5:18 </char><char style="fk" closed="false">ቦላይ ስሌዳ፦ </char><char style="ft" closed="false">ሀዋ ጉሳይ ግሪከ ቃላን “ፓራሉሞአይ” ጌተትያዋ። ሀ ቃላ ብለይ እንግልዜዋን “ፓራላይዝድ” ጉሳ። ሀ ላአቱዋካ ዳዉሮዋን ብለ እሞደ፥ ኬቼዳዋ ዎይ ቃጸና ማላ ዳቡሬዳዋ ጉሳ።</char></note> እት ብታንያ አማሬዳ አሳይ ሻንቻማን ቶክ አህ ጎለ ገልሲደ የሱሳ ስንን ዎናዉ ኮዬድኖ። <verse eid="LUK 5:18"/><verse number="19" style="v" sid="LUK 5:19"/>አሳ ጮራተፐ ደንዴዳዋን የሱሳኮ ሺቃናዉ ዳንዳይበይክኖ። ሄዋ ድራዉ ቦላዉ ግእ ጎልያ ካራ<note caller="+" style="f"><char style="fr" closed="false">5:19 </char><char style="fk" closed="false">ካራ፦ </char><char style="ft" closed="false">ሀ ፓይዱዋን ጌተቴዳ ጎልያ ካራይ ዳዉሮዋ ማላ ግደናዳን፥ ፓላስቲነ ጋደን ጎልያ ቦላን ደእያ ካራይ ገደ ቀረቲደ ኬጸቴ። ሄዌ ያቲደ ቃይ ዱፈቲደ ጋጻን ጋጻን ሀራ ምይ ተጨትና ሎይ ኬጸቴ። ሄዋ ማላ ኬጻይ ኦራ ቃላ ጫቁዋ ዎድያን ኤረቴዳዋ።</char></note> ቃሪደ አ፥ ሻንቻማና አሳ ግዶን የሱሳ ስንን ዎድኖ።<verse eid="LUK 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 5:20"/>የሱስካ ኡንቱንቱ አማኑዋ በኢደ፥ “ሀ ብታነዉ፥ ነ ናጋራይ አቶ ጌተቴዳ” ያጌዳ።<verse eid="LUK 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21"/>ሙሴ ህግያ ታማርስያዋንቱነ ፓርሳዋቱ፥ “ሀዌ ጾሳ ቦርያዌ ኦኔ? እት ጾሳፐ አትን ናጋራ አቶ ጋናዉ ኦን ዳንዳዪ?” ያግ ቆፋ ዶሜድኖ።<verse eid="LUK 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22"/>የሱስካ ኡንቱንቱ ቆፋ ኤሮ ድራዉ ሀዋዳን ጌዳ፥ “አያዉ ህንተንቱ ዎዛናን ሀዋዳን ቆፒቴ? <verse eid="LUK 5:22"/><verse number="23" style="v" sid="LUK 5:23"/>‘ነ ናጋራይ አቶ ጌተቴዳ’ ጋናዋፐነ ‘ደንዳደ ባ’ ጋናዋፐ ሀቃዌ ማቴ? <verse eid="LUK 5:23"/><verse number="24" style="v" sid="LUK 5:24"/>የዉዋን ቃይ ሀዋ ታን ጌዳዌ፥ አሳ ናአይ ቢታ ቦላን ናጋራ ማራናዉ ማታይ ደእያዋ ህንተንቱ ኤራናዳና።” ሄዋፐካ ጉንዴዳ ብታንያ፥ “ደንዳ ነ ሻንቻማ ቶካደ ነ ጎለ ባ ጋይ” ያጌዳ።<verse eid="LUK 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 5:25"/>ጉንዳይካ አሳ ስንን ደንዶዋሽን ባረ ሻንቻማ ቶኪደ ጾሳ ጋላቲደ ባረ ሶይ ቤዳ። <verse eid="LUK 5:25"/><verse number="26" style="v" sid="LUK 5:26"/>ሀ ዎደ ኡባቱካ ዳሪ ማላለቴድኖ፤ ጾሳካ ጋላቲደ፥ “ሀቼ ማላባ በኤዶ” ያጊደ ያሻን ኩሜድኖ።<verse eid="LUK 5:26"/></para>
  <para style="s1">የሱስ ሌዊያ ዶሬዳ</para>
  <para style="r">(<ref loc="LUK 5:27-32">5:27-32</ref>፤ <ref loc="MAT 9:9-13">ማቶሳ 9:9-13</ref>፤ <ref loc="MRK 2:13-17">ማር. 2:13-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27"/>ሄዋፐ ጉይያን የሱስ ከሲደ ቤዳ፤ ሌዊያ ጌተትያ ቃራጻ ሺሽያዌ፥ ቃራጻ ሺሽያሳን ኡቶዋ በኢደ፥ “ታና ካላ” ጌዳ። <verse eid="LUK 5:27"/><verse number="28" style="v" sid="LUK 5:28"/>እካ ደንዲደ ኡባባ አጊደ አ ካሌዳ።<verse eid="LUK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29"/>ሄዋፐ ስሚደ ሌዊ ባረ ጎለን ዳሮ ሾብያ ጊግሴዳ፤ ጮራ ቃራጻ ሺሽያዋንቱነ ሀራ ጮራ አሳይካ ኡንቱንቱና ኡቲደ ም ደኢኖ። <verse eid="LUK 5:29"/><verse number="30" style="v" sid="LUK 5:30"/>ፓርሳዋቱነ ህግያ ታማርስያ፥ ኡንቱንቱና ኦያዋንቱ፥ የሱሳ ካልያዋንቱ ቦላን፥ “አያዉ ቃራጻ ቃንጽያዋንቱናነ ናጋራንቻቱዋና ሚቴኔ ኡሺቴ?” ያጊደ ዙዙሜድኖ።<note caller="-" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="LUK 15:1">ሉቃሳ 15:1</ref>፣ <ref loc="LUK 15:2">2</ref></char></note><verse eid="LUK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31"/>የሱስካ፥ “ሀርጋንቻ አሳፐ አትን ፓጻ አሳዉ አክምያ ኮሸና። <verse eid="LUK 5:31"/><verse number="32" style="v" sid="LUK 5:32"/>ታን ዬዳዌ፥ ናጋራንቻቱ ባረንቱ ናጋራ ፓጺደ ስማናዳናፐ አትን፥ ጽላቱዋ ጼሳናዉ ያበይከ” ያግ ዛሬዳ።<verse eid="LUK 5:32"/></para>
  <para style="s1">የሱስ ጾማባ ኦሸቴዳ</para>
  <para style="r">(<ref loc="LUK 5:33-39">5:33-39</ref>፤ <ref loc="MAT 9:14-17">ማቶሳ 9:14-17</ref>፤ <ref loc="MRK 2:18-22">ማር. 2:18-22</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33"/>ሀዋፐ ጉይያን የሱሳ፥ “ዮሃንሳ ካልያዋንቱነ ፓርሳዋቱዋ ካልያዋንቱ ኡባ ዎደ ጾሚኖነ ዎሲኖ፤ ሽን ኔና ካልያዋንቱ ቃይ ኡባ ጋላስ ሚኖነ ኡሺኖ” ያጊደ ኦቼድኖ።<verse eid="LUK 5:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34"/>የሱስካ፥ “ምሽራይ ኡንቱንቱና ደእሽን ምያታቱ ጾማናዉ ዳንዳዪኖ? <verse eid="LUK 5:34"/><verse number="35" style="v" sid="LUK 5:35"/>የዉዋን ቃይ ምሽራይ ኡንቱንቱፐ ሻከቲደ ባና ዎዲ ያናዋ፤ ሄ ዎደ ጾማናዋንታ” ያግ ዛሬዳ።<verse eid="LUK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36"/>የሱስካ ካልያ ሌምሱዋ ኦዴዳ: “ኦራ ማዩዋፐ ፔ አኪደ ኤጫ ማዩዋ ቦላን ፕያዌ ባዋ፤ ጋሱካ ሀዋዳ ኦፐ ኦራ ማዩዋ ፔ፤ ኦራ ፊካ ኤጫ ማዩዋን ጊገና። <verse eid="LUK 5:36"/><verse number="37" style="v" sid="LUK 5:37"/>ሀዋዳንካ ኤጬዳ ጭልግያን<note caller="+" style="f"><char style="fr" closed="false">5:37 </char><char style="fk" closed="false">ጭልግያ፦ </char><char style="ft" closed="false">ሀዎ ዳዉሮዋን እመትያ ጉጃ ብለይ ኤሳ ናእያ ኦጎሩዋ።</char></note> ኦራ ዎይንያ ኤሳ ዎያዌ ባዋ፤ ዎፐ ቃይ ኦራ ዎይንያ ኤሳይ ጭልግያ ሴ፤ ኤሳይካ ጉኬ፤ ጭልጋይካ ባዬ። <verse eid="LUK 5:37"/><verse number="38" style="v" sid="LUK 5:38"/>ኦራ ዎይንያ ኤሳ፥ ኦራ ጭልግያን ዎናዉ በሴ። <verse eid="LUK 5:38"/><verse number="39" style="v" sid="LUK 5:39"/>ኤጫ ዎይንያ ኤሳ ኡሺደ ኦራ ኮይያዌ ኦንነ ባዋ፤ ጋሱካ ኤጫይ ማልኤ ግያ ድራዉ።”<verse eid="LUK 5:39"/></para>
  <chapter eid="LUK 5"/>
  <chapter number="6" style="c" sid="LUK 6"/>
  <para style="s1">የሱሳ ካልያዋንቱ ሳምባታን ትሻ ዱድኖ</para>
  <para style="r">(<ref loc="MAT 12:1-8">ማቶሳ 12:1-8</ref>፤ <ref loc="MRK 2:23-28">ማር. 2:23-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1"/>ሳምባታ ጋላስ የሱስ ባረና ካልያዋንቱና እትፐ እት ጎሻ ግዱዋና አያ ዎደ አ ካልያዋንቱ ዛርጋፐ ትሻ ዱደ ባረንቱ ኩሽያን ሽገቺደ ሙሳ ዶሜድኖ። <verse eid="LUK 6:1"/><verse number="2" style="v" sid="LUK 6:2"/>ፓርሳዋቱዋ ግዶፐ፥ “ሳምባታ ጋላሳን ኦናዉ ዎጋ ግደናዋ አያዉ ኦቴ?” ያጌድኖ። <verse eid="LUK 6:2"/><verse number="3" style="v" sid="LUK 6:3"/>የሱስ፥ “ካትያ ዳዊተነ እትፐ ደእያዋንቱ ኮሻቴዳ ዎደ ኦዳዋ ናባብ በይክቴ? <verse eid="LUK 6:3"/><verse number="4" style="v" sid="LUK 6:4"/>ዳዊተ ጾሳ ጎልያ ገሊደ ቄሳቱዋፐ አትን ሀራ አሳይ ሜናዳን ድገቴዳ፥ ጾሳዉ ያርሸቴዳ ቁማ ሜዳ። እትፐ ደእያዋንቱካ እ እምናደ ሜድኖ” ያግ ዛሬዳ።<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="LEV 24:9">ዎጋ 24:9</ref></char></note><verse eid="LUK 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 6:5"/>ሀዋፐ ካሊደ የሱስ፥ “አሳ ናአይ ሳምባታዉ ጎዳ!” ጌዳ።<verse eid="LUK 6:5"/></para>
  <para style="s1">የሱስ ኩሺ ጉንዴዳ ብታንያ ፓዳ</para>
  <para style="r">(<ref loc="MAT 12:9-14">ማቶሳ 12:9-14</ref>፤ <ref loc="MRK 3:1-6">ማር. 3:1-6</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6"/>ሀራ ሳምባታ ጋላሳን የሱስ አይሁዳቱዋ ዎስያ ጎልያ ገሊደ ታማርስ ደኤ። ሄዋንካ ኡሸቻ ኩሺ ስሌዳ ብታኒ ደኤ። <verse eid="LUK 6:6"/><verse number="7" style="v" sid="LUK 6:7"/>ህግያ ታማርስያዋንቱነ ፓርሳዋቱ የሱሳ ሞትያ ጋሱዋ ደማናዉ እ ሳምባታን አሳ ፓፐ በአና ጊደ ናግ ደኢኖ። <verse eid="LUK 6:7"/><verse number="8" style="v" sid="LUK 6:8"/>እካ ኡንቱንቱ ቆፋ ኤሪደ ኩሺ ስሌዳ ብታንያ፥ “ደንዳ አሳ ግዱዋን ኤቃ” ያጌዳ። ብታኒካ ደንድ ኤቄዳ።<verse eid="LUK 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 6:9"/>ሄዋፐ ስሚደ የሱስ፥ “ሀንንቶነ ሳምባታ ጋላሳን ሎኦባ ኦናዉ በሲዬ ኢታባ ኦናዉ በሲ? ሸምፑዋ አሻናዉ በሲዬ ዎናዉ በሲ?” ያጌዳ። <verse eid="LUK 6:9"/><verse number="10" style="v" sid="LUK 6:10"/>የሱስ ባረ ዩሹዋን ደእያ አሳ ኡባ ጼሎዋፐ ጉይያን ብታንያ፥ “ነ ኩሽያ ምጫ!” ያጌዳ። እካ ምጪደ ፓጼዳ።<verse eid="LUK 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 6:11"/>ኡንቱንቱ ሎይ ሀንቄቲደ የሱሳ ቦላ ኦናዋ ባረንቱ ግዶን ማቀቴድኖ።<verse eid="LUK 6:11"/></para>
  <para style="s1">የሱስ ታማነ ላኡ ኪተቴዳዋንታ ዶሬዳ</para>
  <para style="r">(<ref loc="MAT 10:1-4">ማቶሳ 10:1-4</ref>፤ <ref loc="MRK 3:13-19">ማር. 3:13-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12"/>ሄ ዎድያን የሱስ ደርያ ቦላ ዎሳናዉ ከሴዳ፤ ሄዋንካ ቃማ ኩመን ጾሳኮ ዎሲደ አቄዳ። <verse eid="LUK 6:12"/><verse number="13" style="v" sid="LUK 6:13"/>ሳአይ ዎንቶዋን ባረና ካልያዋንታ ጼሴዳ። ሄዋንቱፐካ ታማነ ላአቱዋ ዶሪደ፥ “ኪተቴዳዋንታ”<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="fq" closed="false">ኪተቴዳዋንታ፦ </char><char style="ft" closed="false">ሀዋ ጉሳይ ታማነ ላኡ የሱስ ኪቴዳ ሀዋራቱዋ ጉሳ።</char></note> ያጊደ ሱንዳ። <verse eid="LUK 6:13"/><verse number="14" style="v" sid="LUK 6:14"/>ኡንቱንቱ ሱንይካ: ጰጽሮሳ ጊደ እ ሱንዳ ስሞና፥ አ እሻ እንድራሳ፥ ያቆባ፥ ዮሃንሳ፥ ፕልጶሳነ ባርታላሞሳ፥ <verse eid="LUK 6:14"/><verse number="15" style="v" sid="LUK 6:15"/>ማቶሳ፥ ቶማሳ፥ እልፕዮሳ ናኣ ያቆባ፥ ባረ ጋደዉ ሴለትያ ስሞና፥ <verse eid="LUK 6:15"/><verse number="16" style="v" sid="LUK 6:16"/>ያቆባ ናኣ ይሁዳነ የሱሳ አ እሜዳ አስቆሮቱ ይሁዳ።<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="fk" closed="false">አስቆሮቱ፦ </char><char style="ft" closed="false">ሀዋ ጉሳይ አይሁዳ ጋድያን ደእያ አስቆሮቱ ጌተትያ ጋድያፐ ዬናን አተና ጉሳ። ሀ ሱን ብለይ፥ “ዎርዳንቻ”። ቃይካ፥ “ሀይቆ አ እምያዋ” ጉሳ።</char></note><verse eid="LUK 6:16"/></para>
  <para style="s1">የሱስ ጮራ አሳ ታማርሴዳነ ፓዳ</para>
  <para style="r">(<ref loc="MAT 4:23-25">ማቶሳ 4:23-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17"/>የሱስካ ኡንቱንቱና እትፐ ደርያፐ ዎደ ደምባሳን ኤቄዳ። አ ካልያዋንቱፐካ ጮራ አሳይ ሄዋን ደኤ። ቃይካ አፐ ስሳናዉነ ባረንቱ ሀርግያፐ ፓጻናዉ ይሁዳ ጋድያፐ፥ የሩሳላመ ካታማፐ፥ አባ ማታን ደእያ ጺሮሳፐነ ሲዶናፐ ዬዳ ጮራ አሳይ ሄዋን ደኢኖ። <verse eid="LUK 6:17"/><verse number="18" style="v" sid="LUK 6:18"/>ሀ አሳይካ አ ስሳናዉነ ባረንቱ ሀርግያፐ ፓጻናዉ ዬድኖ። ቱና አያናን ኦይቀቲደ መቶትያዋንቱካ ፓጼድኖ። <verse eid="LUK 6:18"/><verse number="19" style="v" sid="LUK 6:19"/>ዎልቃይ አፐ ከሲደ ኡባ ፓያ ድራዉ አሳይ ኡባይ አ ቦቻናዉ ኮዬ።<verse eid="LUK 6:19"/></para>
  <para style="s1">አንጁዋባነ መቱዋባ</para>
  <para style="r">(<ref loc="MAT 5:1-12">ማቶሳ 5:1-12</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20"/>ባረና ካልያዋንታ ጼሊደ ያጌዳ:</para>
  <para style="q1" vid="LUK 6:20">“ህንተንቱ ማንቃቱ አንጀቴዳዋንታ፤</para>
  <para style="q2" vid="LUK 6:20">አያዉ ጎፐ፥ ጾሳ ካዉተይ ህንተንቱዋ።<verse eid="LUK 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21"/>ህንተንቱ ሀእ ኮሻትያዋንቱ አንጀቴዳዋንታ፤</para>
  <para style="q2" vid="LUK 6:21">ግድን ካላንታ፤ ህንተንቱ ሀእ ዬክያዋንቱ</para>
  <para style="q2" vid="LUK 6:21">አንጀቴዳዋንታ፤</para>
  <para style="q2" vid="LUK 6:21">ግድን ሚጫንታ።<verse eid="LUK 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 6:22"/>“አሳ ናኣ ድራዉ ህንተንታ አሳይ እጽያ ዎደነ ቶችያ ዎደ፥ ህንተንቱ ሱንካ ኢታን ደንያ ዎደ፥ አንጀቴድታ። <verse eid="LUK 6:22"/><verse number="23" style="v" sid="LUK 6:23"/>ሳሉዋን ህንተንቱ አካና ዎይታይ ዳራ ግድያ ድራዉ ሄ ጋላስ ናሸቻን ጉፕተ፤ ጋሱካ ካሰ ህንተንቱ አዎቱ ናባቱዋ ቦላን ሀዋዳን ኦደ ደኤድኖ።<verse eid="LUK 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24"/>“የዉዋን ቃይ፥ ዱረ አሳቶ ህንተንቶ አየ፤</para>
  <para style="q2" vid="LUK 6:24">ህንተንቱ እሻሎ ደኡዋን ደኤድታ።<verse eid="LUK 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25"/>ህንተንቶ ሀእ ካሌዳዋንቶ አየ፤</para>
  <para style="q2" vid="LUK 6:25">ግድን ኮሻታንታ፤</para>
  <para style="q2" vid="LUK 6:25">ህንተንቶ ሀእ ሚጭያዋንቶ አየ፤</para>
  <para style="q2" vid="LUK 6:25">ግድን ካዮታንታነ ዬካንታ።<verse eid="LUK 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="LUK 6:26"/>አሳይ ኡባይ ህንተንቱ ሎኦተባ ሃሳይያ ዎደ፥</para>
  <para style="q2" vid="LUK 6:26">ህንተንቶ አየ፤</para>
  <para style="q2" vid="LUK 6:26">ካሰ ህንተንቱ አዎቱ ዎርዶ ናባቶ፥</para>
  <para style="q2" vid="LUK 6:26">ሀዋዳን ኦድኖ።<verse eid="LUK 6:26"/></para>
  <para style="s1">ሞርክያ ሲቃናዉ በሴ</para>
  <para style="r">(<ref loc="MAT 5:38-48">ማቶሳ 5:38-48</ref>፤ <ref loc="MAT 7:12">7:12</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27"/>“ሽን ታን ኦድያዋ ስስያዋንቶ ያጋይ: ህንተንቱ ሞርከቱዋ ዶስተ፤ ህንተና እጽያዋንቶ፥ ሎኡዋ ኦተ፤ <verse eid="LUK 6:27"/><verse number="28" style="v" sid="LUK 6:28"/>ህንተና ሸቂያዋንታ አንጅተ፥ ህንተና ናቂያዋንቶ፥ ዎስተ። <verse eid="LUK 6:28"/><verse number="29" style="v" sid="LUK 6:29"/>እት ባጋ ሻይያ ባቂያዎ፥ ላኤንዋካ በሳ፤ ኦንነ ነ ኮትያ አክያዎ፥ ነ ሻምጭያካ ድጎፓ።<verse eid="LUK 6:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 6:30"/>“ነዉ ደእያዋ ኔና ዎስያዎ፥ እማ፤ ነዋ አኬዳዋ፥ ዛራ ጋደ ኦቾፓ። <verse eid="LUK 6:30"/><verse number="31" style="v" sid="LUK 6:31"/>አሳይ ህንተንቶ ኦና ማላ ህንተንቱ ዶስያዋዳን፥ ህንተንቱካ ሀራዉ ሀዋዳን ኦተ።<verse eid="LUK 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32"/>“ህንተንታ ዶስያዋንታ ጻላላ ዶሶፐ አይ ጋላታይ ደኢ? ሀዋ ግዶፐ ናጋራንቻቱካ ባረና ዶስያዋንታ ዶሲኖ። <verse eid="LUK 6:32"/><verse number="33" style="v" sid="LUK 6:33"/>ህንተንቶ ሎኦባ ኦያዋንቱ ጻላላዉ ህንተንቱ ሎኦባ ኦፐ ሄዎ አይ ጋላታይ ደኢ? ናጋራንቻቱካ ሀዋዳን ኦኖ። <verse eid="LUK 6:33"/><verse number="34" style="v" sid="LUK 6:34"/>ታልኢደ ህንተዉ ዛራናዉ ዳንዳይያዋንቱ ጻላላዉ ታልኦፐ አይ ጋላታይ ደኢ? ባረ ታልኤዳዋ ዛሪደ አካናዉ ናጋራንቻቱካ ባረንቱ ጋርሳን ታልኤቲኖ። <verse eid="LUK 6:34"/><verse number="35" style="v" sid="LUK 6:35"/>ሽን ህንተንቱ፥ ህንተንቱ ሞርክያ ዶስተ፤ ኡንቱንቶካ ሎኦባ ኦተ፤ ህንተንቱፐ ታልኦዋ ዛሪድ አካናዉ ቆፖፕተ። ሀዋ ህንተንቱ ፖሎፐ ህንተንቶ ጋቲ ዳራናዋ። ቃይ ህንተንቱ ኡባፐ ቦላ ጾሳ ናና ግዳንታ። እ ኢታቶነ ጋላተናዋንቶካ ኬካ። <verse eid="LUK 6:35"/><verse number="36" style="v" sid="LUK 6:36"/>ህንተንቱ አቡ ማርያዋ ግዶዋዳን ህንተንቱካ ማርያዋንታ ግድተ።<verse eid="LUK 6:36"/></para>
  <para style="s1">ሀራ አሳ ፕርዳናዉ በሰና</para>
  <para style="r">(<ref loc="MAT 7:1-5">ማቶሳ 7:1-5</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37"/>“ኦ ቦላንካ ፕርዶፕተ፥ ህንተንቱ ቦላንካ ፕርደተና፤ ሀራ ቦላ ኩናንያ ኦፕተ፤ ህንተንቱ ቦላንካ ኩናን ኦሰተና። አቶ ጊተ፤ ጾሳይ ህንተንቶ አቶ ጋና። <verse eid="LUK 6:37"/><verse number="38" style="v" sid="LUK 6:38"/>እምተ፤ ህንተንቶ እመታና። ህንተንቱ ማኬዳ ማካን ህንተንቶ ማከታና። ባቂ ናቂና ሲል ኩም ፓላህ ላለትያ ማካ ህንተንቱ ክዉዋን እድንና” ጌዳ።<verse eid="LUK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39"/>ቃይካ የሱስ ሀዋፐ ካልያ ሌምሱዋ ኦዴዳ፤ “ቆቃይ ቆቃ ካለናዉ ዳንዳዪ? ቆቃይ ቆቃ ካለፐ ላአቱካ ኦይቀቲደ ኦላን ኩንድክኖ?<note caller="-" style="x"><char style="xo" closed="false">6:39 </char><char style="xt" closed="false"><ref loc="MAT 15:14">ማቶሳ 15:14</ref></char></note> <verse eid="LUK 6:39"/><verse number="40" style="v" sid="LUK 6:40"/>ታማርያዌ ባረና ታማርስያዋፐ አና፤ ታማርያዌ ምን ታማሮፐ ባረና ታማርሶዋ ማላ ግዳናዉ ዳንዳዬ።<verse eid="LUK 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41"/>“ነ አይፍያ ግዶን ደእያ ቱሳ ከሰናን ደኣደ ሀራ ነ ላግያ አይፍያ ግዶን ደእያ ሱላ አያዉ ጼላይ? <verse eid="LUK 6:41"/><verse number="42" style="v" sid="LUK 6:42"/>ነ አይፍያ ጋርሳን ደእያ ቱሳ በኤናን ሀራ አሳኮ ሺቃደ፥ ‘ታ እሻዉ፥ ነ አይፍያ ጋርሳፐ ሱላ ታ ከሶ?’ ያጋናዉ ዎታ ዳንዳያይ? ሀ ሎኡዋ ማላትያ ኢታዉ፥ ኮይሮታደ ነ አይፍያ ግዶን ደእያ ቱሳ ከሳ። ሄዋፐ ጉይያን ነ እሻ አይፍያ ግዶን ደእያ ሱላ ከሳናዉ ጌሻደ ጼላናዉ ዳንዳያ።<verse eid="LUK 6:42"/></para>
  <para style="s1">ምቶነ እዛ አይፌዳ አይፍያ</para>
  <para style="r">(<ref loc="MAT 7:16-20">ማቶሳ 7:16-20</ref>፤ <ref loc="MAT 12:33-35">12:33-35</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43"/>“ሎኦ ምይ ኢታ አይፍያ አይፈና፤ ሄዋዳንካ ኢታ ምይ ሎኦ አይፍያ አይፋናዉ ዳንዳየና። <verse eid="LUK 6:43"/><verse number="44" style="v" sid="LUK 6:44"/>ምይ ኡባይ ባረ አይፍያ አይፍያዋን ኤረቴ። አጉንፐ ዎደን አይፊ ማጸተና፤ ሀዋዳንካ፥ ጹንዱቂያፐ<note caller="+" style="f"><char style="fr" closed="false">6:44 </char><char style="fk" closed="false">ጹንዱቂያ፦ </char><char style="ft" closed="false">ሀ ምይ ጎምኦርያ ዛርያ ግዲደ አ አይፊ አያዉነ ማደናዋ።</char></note> ላድያ አይፍያ ማጻናዉ ዳንዳየተና።<note caller="-" style="x"><char style="xo" closed="false">6:44 </char><char style="xt" closed="false"><ref loc="MAT 12:34">ማቶሳ 12:34</ref></char></note> <verse eid="LUK 6:44"/><verse number="45" style="v" sid="LUK 6:45"/>ሎኦ አሳይ ባረ ሎኦ ዎዛናፐ ሎኦ የዉዋ ሃሳዬ። ቃይ ኢታ አሳይ ባረ ኢታ ዎዛናፐ ኢታ የዉዋ ሃሳዬ። አያዉ ጎፐ፥ አሳይ ባረ ዶናን ሃሳይያዌ ባረ ዎዛናን ኩሜዳዋ ዶናይ ሃሳይያ ድራሳ።<verse eid="LUK 6:45"/></para>
  <para style="s1">ላኡ ቆሞ ጎልያ ኬጽያ አሳ</para>
  <para style="r">(<ref loc="MAT 7:24-27">ማቶሳ 7:24-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46"/>“ታን ኦዶዋ ኦክታ፥ ሽን አያዉ ጎዳዉ፥ ጎዳዉ፥ ያጊደ ታና ጼጊቴ? <verse eid="LUK 6:46"/><verse number="47" style="v" sid="LUK 6:47"/>ታኮ ይያ ኡባይ ታ ቃላካ ስሲደ ኦሱዋን ፔሽያዌ ኦና ማላትንቶ ታ ህንተንታ በሳና፤ <verse eid="LUK 6:47"/><verse number="48" style="v" sid="LUK 6:48"/>እካ ጎልያ ኬጺደ ዳሮ ኦላ ቦኪደ ዛላ ቦላ ግንቢደ ኬጼዳ አሳ ማላቴ፤ ድኡ ድኢደ ሄ ጎልያ ሱግናካ፥ ምኖ ዛላ ቦላ ኬጸቶ ድራዉ ቃናዉ ዳንዳይቤና። <verse eid="LUK 6:48"/><verse number="49" style="v" sid="LUK 6:49"/>ቃይ ታ ቃላ ስሲደ ኦሱዋን ፔሸና ኡራይ ባሱ ባንታሳ ሻፍያ ቦላን ጎልያ ኬጼዳዋ ማላቴ። ድኡ ድኢደ ሄ ጎልያ ሱጎ ዎደ ኤለካ ኩንዴዳ፤ ሄ ጎሊካ ኢታ ዎዳ ዎዲደ ባዬዳ” ያጌዳ።<verse eid="LUK 6:49"/></para>
  <chapter eid="LUK 6"/>
  <chapter number="7" style="c" sid="LUK 7"/>
  <para style="s1">የሱስ ጼቱዋ ካፑዋ ቆማ ፓዳ</para>
  <para style="r">(<ref loc="MAT 8:5-13">ማቶሳ 8:5-13</ref>፤ <ref loc="JHN 4:43-54">ዮሃ. 4:43-54</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1"/>የሱስካ ሀዋ ኡባ አሳ ስንን ሃሳይ ዉርሶዋፐ ጉይያን ህን ቅፍርናሆማ ቤዳ። <verse eid="LUK 7:1"/><verse number="2" style="v" sid="LUK 7:2"/>ሄዋንካ እት ጼቱዋ ካፑ ደኤ። እ ዳሮፐ ዶስያ አ ቆማይ ሀርጊደ ሀያናዉ ማቴዳ። <verse eid="LUK 7:2"/><verse number="3" style="v" sid="LUK 7:3"/>እካ የሱሳባ ስሴዳ ዎደ፥ ባረ ቆማ ዎሲደ ፓና ማላ ይሁዳ ጭማቱዋ ህን አኮ ኪቴዳ።<verse eid="LUK 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 7:4"/>ኡንቱንቱካ የሱሳኮ ዪደ፥ “ሀ ብታኒ፥ ኔን አ ማዳናዳን ዳሮፐ ኮዬዳ፤ <verse eid="LUK 7:4"/><verse number="5" style="v" sid="LUK 7:5"/>ጋሱካ ኑ አሳ እ ዳሮፐ ዶሲደ አይሁዳቱዋ ዎስያ ጎልያ ኬጽሶዌካ አ” ያጊደ ዳሮፐ ዎሴድኖ።<verse eid="LUK 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 7:6"/>የሱስካ ኡንቱንቱና እትፐ ቤዳ። እካ ህን ጎልያ ሄራ ጋኬዳ ዎደ ጼቱዋ ካፑ ባረ ላገቱዋ ባረኮ ጼሲደ፥ “ታ ጎዳዉ፥ ዳቡሮፓ፤ አያዉ ጎፐ፥ ኔና ታ ጎልያ ካራፐ ጋርሳ ባጋና ገልሳናዉ ታዉ በሰና። <verse eid="LUK 7:6"/><verse number="7" style="v" sid="LUK 7:7"/>ሀዋ ድራዉ ነ ስንን ኤቃናዉካ ሀራይ አቶ በስያዋ ግድከ። ሽን ኔን ቃላ ጻላላ ኦዳ፤ ታ ቆማይካ ፓጻናዋ። <verse eid="LUK 7:7"/><verse number="8" style="v" sid="LUK 7:8"/>ታን ታፐ ቦላና ማታይ ደእያዋንቶ ኤኖ ጋደ ደእያ አሳ። ታፐ ጋርሳናካ ታን ኪትስያ ዎታዳራቱ ደኢኖ። እቱዋ፥ ‘ባ’ ያግያ ዎደ፥ ቤ፤ ሀራካ ቃይ፥ ‘ሃያ’ ጎፐ ዬ። ታ ቆማይካ፥ ሀዋ ‘ኦ’ ግያ ዎደ አዛዘቴ፤ ኦ” ያጌዳ።<verse eid="LUK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9"/>የሱስካ ሀዋ ስሲደ አ የዉዋን ማላለቴዳ፤ ጉየ ስሚደ አ ካልያ ዳሮ አሳ፥ “ታን ህንተንቶ ቱሙዋ ጋይ፤ ታን ሀዋ ማላ አማኑዋ ሀራይ አቶ፥ እስራኤልያ ጋርሳንካ በአበይከ” ያጌዳ። <verse eid="LUK 7:9"/><verse number="10" style="v" sid="LUK 7:10"/>ካሰ ኪተቴዳ አሳቱካ ጼቱዋ ካፑዋ ጎለ ጉየ ስምያ ዎደ፥ አ ቆማይ ፓጾዋ በኤድኖ።<verse eid="LUK 7:10"/></para>
  <para style="s1">የሱስ አምአት ናኣ ሀይቁዋፐ ደንዳ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11"/>ዎንትሳ ጋላስ የሱስ ባረና ካልያዋንቱናነ ጮራ አሳና እትፐ ናይኖ ጌተትያ ካታማቶ ቤድኖ። <verse eid="LUK 7:11"/><verse number="12" style="v" sid="LUK 7:12"/>የሱስ ካታማ ጋካና ጼቱዋ ዎደ፥ አሳይ ሀይቄዳ አሃ ቶኪደ ከሴድኖ። ሀይቆዌካ ባረ ዳይዉ መጽ እት ናኣ፤ አታካ አስናይ ባይና አምአቶ። ዳሮ ካታማ አሳይካ እዞ ካሌድኖ።<verse eid="LUK 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 7:13"/>የሱስካ እዞ በኤዳ ዎደ ቃረቲደ፥ “ዬኮፓ!” ያጌዳ። <verse eid="LUK 7:13"/><verse number="14" style="v" sid="LUK 7:14"/>ሺቂደ ሻንቻማ ቦቼዳ፤ ቶኮዋንቱካ ኤቄድኖ። የሱስ፥ “ኔኖ ያላጋዉ፥ ደንዳ ጋይ!” ያግና፥ <verse eid="LUK 7:14"/><verse number="15" style="v" sid="LUK 7:15"/>ብታኒ ሱር ኡቴዳ። ሃሳያካ ዶሜዳ። የሱስካ አ፥ አ ዳይዉ እሜዳ።<verse eid="LUK 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16"/>ኡባይካ ያሻን ኩሚደ፥ “ዎልቃማ ናቢ ኑ ጋርሳን ደንዴዳ፤ ጾሳይካ ባረ አሳ አሻናዉ ዬዳ!” ያጊደ ጾሳ ጋላቴድኖ። <verse eid="LUK 7:16"/><verse number="17" style="v" sid="LUK 7:17"/>ሄዌኔካ የሱሳ ዋሪ ይሁዳ ዩሹዋን ደእያ ጋድያ ኡባን ስሰቴዳ።<verse eid="LUK 7:17"/></para>
  <para style="s1">ጻማቅያ ዮሃንሳ</para>
  <para style="r">(<ref loc="MAT 11:1-19">ማቶሳ 11:1-19</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18"/>ዮሃንሳ ካልያዋንቱ ሀኖዋ ኡባ አዉ ኦዴድኖ። ዮሃንስካ ባረና ካልያዋንቱፐ ላአቱዋ ጼሲደ፥ <verse eid="LUK 7:18"/><verse number="19" style="v" sid="LUK 7:19"/>“ያናዌ ኔኔየ? ዎይ ኑን ሀራ ናጋኔ?” ያግ፥ ኡንቱንቱ ኦቻና ማላ ህን የሱሳኮ ኪቴዳ።<verse eid="LUK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20"/>አሳቱካ የሱሳኮ ዪደ፥ “ጻማቅያ ዮሃንስ፥ ያና ጌተቴዳዌ ኔኔየ? ዎይ ሀራ ናጋኔ? ያጊደ ኦቻና ማላ ኔኮ ኪቴዳ” ያጌድኖ።<verse eid="LUK 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21"/>ሄ ዎድያን የሱስ ጮራ አሳ ዱማ ዱማ ሀርግያፐ ፓዳ፤ ቱና አያናቱዋካ አሳፐ ከሴዳ፤ ጮራ ቆቃቱዋ አይፍያ ዶዬዳ። <verse eid="LUK 7:21"/><verse number="22" style="v" sid="LUK 7:22"/>የሱስካ ዮሃንስ ኪቶዋንቶ፥ “ቢደ ህንተንቱ በኤዳዋነ ስሴዳዋ ዮሃንሳዉ ኦድተ፤ ቆቃቱ ጼላናዋንታ፤ ጉንዳቱ ሀመታናዋንታ፤ ኦሉ ኦይቆዋንቱ ጌያናዋንታ፤ ቱሌዳዋንቱ ስሳናዋንታ፤ ሀይቄዳዋንቱ ደንዳናዋንታ፤ ህዬሳቶካ ምሽራቹዋ ቃላይ ኦደታናዋ። <verse eid="LUK 7:22"/><verse number="23" style="v" sid="LUK 7:23"/>ታናን በተና አሳይ ኡባይ አንጀቴዳዋንታ” ያጌዳ።<verse eid="LUK 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24"/>ዮሃንስ ኪቴዳዋንቱ ብድጎዋፐ ጉይያን የሱስ አሳዉ ዮሃንሳባ ኦዱዋ ዶሜዳ: “አያ በአናዉ ቢታ ባዙዋ ከሴድቴ? ጫርኩ ቃያ ኡሱን? <verse eid="LUK 7:24"/><verse number="25" style="v" sid="LUK 7:25"/>ዎይ አያ በአናዉ ከሴድቴ? ሎኦ ማዩዋ ማዬዳ አሳ ደኡዋ? ሎኦ ማዩዋ ማዬዳዋንቱነ ባረና ጊግስያዋንቱ ካትያ ጎለን ደኢኖ። <verse eid="LUK 7:25"/><verse number="26" style="v" sid="LUK 7:26"/>ዎይ አያ በአናዉ ከሴድቴ? ናብያ በአናዉ ከሴድቴ? ኤ፤ ታን ህንተንቶ ያጋይ፤ ህንተንቱ በአናዉ ከሶዌ ናብያፐካ አዋ። <verse eid="LUK 7:26"/><verse number="27" style="v" sid="LUK 7:27"/>ጾሳ ማጻፋን፥ ‘ነ ኦግያ ኔፐ ስንና ጊግስያ ኪታንቻ ኔፐ ስንያደ ኪታና’ ጌተት ዮሃንሳባይ ጻፈቴዳዌ ሀዋ። <verse eid="LUK 7:27"/><verse number="28" style="v" sid="LUK 7:28"/>ማጫዋንቱፐ የለቴዳዋንቱ ጋርሳን ጻማቅያ ዮሃንሳፐ አያ ኦንነ ባዋ። ጾሳ ካዉተን ቃይ ኡባፐ ላፋ ጌተትያዌካ አፐ አናዋ” ያጌዳ።<verse eid="LUK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29"/>ሀራይ አቶ ሽን ቃራጻ ከስያዋንቱ አተናን ሀዋ የሱስ ሃሳዮዋ ስሴዳ ኡባይ ዮሃንሳ ኩሽያን ጻማቀቶዋንቱ ጾሳዉ በስያ ቦንቹዋ እሜድኖ።<note caller="-" style="x"><char style="xo" closed="false">7:29፣ 30 </char><char style="xt" closed="false"><ref loc="MAT 21:32">ማቶሳ 21:32</ref>፤ <ref loc="LUK 3:12">ሉቃሳ 3:12</ref></char></note> <verse eid="LUK 7:29"/><verse number="30" style="v" sid="LUK 7:30"/>ሽን ህግያ ታማርስያዋንቱነ ፓርሳዋቱ ዮሃንሳን ጻማቀትቤና ድራዉ፥ ጾሳይ ኡንቱንቶ ቆፔዳዋ እጼድኖ።<verse eid="LUK 7:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31"/>የሱስ፥ “ስም ታን ሀ ዎድያ አሳ አያና ሌምሶ? ኡንቱንቱ አያ ማላቲኖ? <verse eid="LUK 7:31"/><verse number="32" style="v" sid="LUK 7:32"/>ኡንቱንቱ ገያሳን ኡቲደ እቱ እቱዋ ጼሲደ፥ ‘ሱሱልያ ህንተንቶ ፑንናካ</para>
  <para style="q2" vid="LUK 7:32">ካእበይክታ፤</para>
  <para style="q2" vid="LUK 7:32">ዬኩዋ የ ከሴዶሽንካ</para>
  <para style="q2" vid="LUK 7:32">ዬክበይክታ</para>
  <para style="q2" vid="LUK 7:32">ያገትያ ናና ማላቲኖ’ ጌዳ።<verse eid="LUK 7:32"/></para>
  <para style="m">
    <verse number="33" style="v" sid="LUK 7:33"/>ጻማቅያ ዮሃንስ ቁማ ሜናን ዎይንያ ኤሳካ ኡሸናን ዪና፥ ‘አ ቦላን ጋሌናይ ደኤ’ ያጌድታ። <verse eid="LUK 7:33"/><verse number="34" style="v" sid="LUK 7:34"/>ታን አሳ ናአይ ማደነ ኡሻደ ዪና፥ ‘ሀዌ ናፍሳማ፤ ዎይንያ ኤሳካ ኡሽያዋ፤ ቃራጽያዋንቶነ ናጋራንቻቶ ዳቡዋ’ ያጊታ። <verse eid="LUK 7:34"/><verse number="35" style="v" sid="LUK 7:35"/>ግዶፐ አትን ጾሳ አ ኤራተይ ባረ ኦሱዋን ቱማ ግዲደ ቤቴዳ” ያጌዳ።<verse eid="LUK 7:35"/></para>
  <para style="s1">ፓርሳዊያ ስሞና</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36"/>ፓርሳዋቱዋፐ እቱ ባረናና ቁማ ማና ማላ ሾቢና፥ የሱስ አ ሶይ ቢደ ማናዉ ኡቴዳ። <verse eid="LUK 7:36"/><verse number="37" style="v" sid="LUK 7:37"/>ሄ ካታማን ናጋራንቻ ጌተቴዳ እት ምሽራታ ደኤዉና፥ የሱስ አ ሶይን ኡቴዳዋ ስሳደ፥ አልባስጽሮሳ ጌተትያ ሹቻፐ ኦሰቴዳ አልባስጽሮሳ ባሬታ ኩሜዳ ሽቱዋ አካ ያዱ። <verse eid="LUK 7:37"/><verse number="38" style="v" sid="LUK 7:38"/>ጉየና አ ገድያ ማታን ኤቃደ፥ ዬካደ አ ገድያካ ባረ አፎን ኦካ ዶማዱ፤ እዝ አፎይ ባይዜዳ አ ገድያካ ባረ ሁጲያ ብናናን ቁጫደነ አ ገድያ የራደ ገድያን ሽቱዋካ ጫጫፋዱ።<note caller="-" style="x"><char style="xo" closed="false">7:38 </char><char style="xt" closed="false"><ref loc="MAT 26:7">ማቶሳ 26:7</ref>፤ <ref loc="MRK 14:3">ማር. 14:3</ref>፤ <ref loc="JHN 12:3">ዮሃ. 12:3</ref></char></note> <verse eid="LUK 7:38"/><verse number="39" style="v" sid="LUK 7:39"/>የሱሳ ባረ ሶይ ጼሴዳ ፓርሳዊካ ሀዋ በኢደ፥ “ሀዌ ናብያ ግዴደንቶ፥ ሀና አ ቦችያ ምሽራታ ኦነንቶነ ቃይካ እዛ ናጋራንቻ ግድያዋ እ ኤራና ሽን” ያጌዳ።<verse eid="LUK 7:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40"/>የሱስካ ዛሪደ፥ “ስሞና፥ ታን ነዉ ኦድያ የዉ ደኤ” ያግና፥</para>
  <para style="p" vid="LUK 7:40">ስሞንካ፥ “ታማርስያዎ፥ ኦዳ” ያጌዳ።<verse eid="LUK 7:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41"/>የሱስ፥ “እት ብታንያፐ ሚሻ ታልኤዳ ላኡ አሳቱ ደኢኖ። እቱዋ ማታን እቼሹ ጼቱ ዲናር፥ ቃይ የኩዋ ማታን እሻታሙ ደኤ። <verse eid="LUK 7:41"/><verse number="42" style="v" sid="LUK 7:42"/>ላአቶካ ጭግያዌ ይና፥ ላአቱዋ አጩዋካ ማር አጌዳ። ሀዋንቱፐ ሀቃዌ ሎይ ዶስያዋ ማላቲ?” ያጌዳ።<verse eid="LUK 7:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43"/>ስሞንካ ዛሪደ፥ “ዳሩዋ አጎዋ ማላቴ” ያጌዳ። የሱስካ፥ “ቱሙዋ ዛራዳ” ያጌዳ።<verse eid="LUK 7:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 7:44"/>የሱስ ምሽራትኮ ጼሊደ፥ ስሞና ሀዋዳን ያጌዳ፤ “ሀኖ ምሽራቶ በኣዲ? ታን ነ ጎለ ዪና ሀራይ አቶ ሽን ሃካ ታ ገድያዉ እማ በይካ፤ ሽን እዛ ባረ አፎን ታ ገድያ እርጽሳዱ፤ ባረ ሁጲያ ብናናንካ ቁጫዱ። <verse eid="LUK 7:44"/><verse number="45" style="v" sid="LUK 7:45"/>ኔን ታና የራ በይካ፤ ሽን እዛ ታን ገሎደፐ ዶማደ ታ ገድያ የርያዋ አጋ በይኩ። <verse eid="LUK 7:45"/><verse number="46" style="v" sid="LUK 7:46"/>ኔን ታ ሁጲያን ዛይትያ ኦካ በይካ፤ ሽን እዛ ታ ገድያን ሽቱዋ ጫጫፋዱ። <verse eid="LUK 7:46"/><verse number="47" style="v" sid="LUK 7:47"/>ሀዋ ድራዉ ታ ህንተንቶ ኦዳይ: ዳሮፐ እዛ ዶሴዳዋ ድራዉ፥ ዳሮ ናጋራይ እዝዉ ደእያዌ ማረቴዳ፤ ጉይ ማረትያዌ ጉ ዶሴ” ያጌዳ።<verse eid="LUK 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48"/>የሱስ ምሽራቶ፥ “ነ ናጋራይ ቁጨቴዳ” ያጌዳ።<verse eid="LUK 7:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49"/>የሱሳና እትፐ ቁማ ማናዉ ኡቴዳዋንቱ ባረንቱ ዎዛናን፥ “ናጋራ ማራናዉ ዳንዳይያዌ ሀዌ ኦኔ?” ያጌድኖ።<verse eid="LUK 7:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50"/>የሱስ ምሽራቶ፥ “ነ አማኑ ኔና አሼዳ፥ ሳሮተን ነ ጎለ ባ” ያጌዳ።<verse eid="LUK 7:50"/></para>
  <chapter eid="LUK 7"/>
  <chapter number="8" style="c" sid="LUK 8"/>
  <para style="s1">የሱሳ ካሌዳ ማጫዋንታ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1"/>የሱስ ሀዋፐ ስሚደ፥ ሳባኪድነ ጾሳ ካዉተ ምሽራቹዋ ቃላ ካታማንነ ሄራን ኦዲደ አዳ። ታማነ ላኡ የሱሳ ካልያዋንቱካ አናና እትፐ ደኢኖ። <verse eid="LUK 8:1"/><verse number="2" style="v" sid="LUK 8:2"/>ኢታ አያናፐነ ዎልቃማ ሀርግያፐ ፓጼዳዋንቱ እት እት ማጫዋንቱካ ደኢኖ። ሄዋንቱካ: ላፑ ጻላሂ ከሴዳ ማግዳላ ጌተትያ ካታማፐ ዬዳ ማይራሞነ፥ <verse eid="LUK 8:2"/><verse number="3" style="v" sid="LUK 8:3"/>ሄሮድሳ ጎልያን ሱን ግዴዳ ኩዛ ማቻት ዮሃኖ፥ ሶስና ጌተተዉናነ ሀራ ጮራቱዋና እትፐ ግዲደ፥ የሱሳነ አ ካልያዋንታ ሚሻን ማዴድኖ።<verse eid="LUK 8:3"/></para>
  <para style="s1">ዘረ ሌምሱዋ</para>
  <para style="r">(<ref loc="MAT 13:1-9">ማቶሳ 13:1-9</ref>፤ <ref loc="MRK 4:1-9">ማር. 4:1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4"/>ጮራ አሳይ ዳሮ ካታማቱዋፐ ሺቂደ፥ የሱሳኮ ዬዳ ዎድያን ሌምሱዋን፥ <verse eid="LUK 8:4"/><verse number="5" style="v" sid="LUK 8:5"/>“ዘርያዌ ዘረ ዘራናዉ ከሴዳ። ዘርያ ዎደ እት እት ዘረይ፥ ኦግያ ዶናን ዎደ የቴዳ። ያትና ሳሉዋ ካፉ ሄዋ ሜዳ። <verse eid="LUK 8:5"/><verse number="6" style="v" sid="LUK 8:6"/>ሀራይ ቃይ ዛላ ቦላ ዎደ ዶሌዳ ዎደ ኮሽያ ሃ ደመና ድራዉ መሌዳ። <verse eid="LUK 8:6"/><verse number="7" style="v" sid="LUK 8:7"/>ሀራ ዘረይ አጉን ጋርሳን ዎዳ። አጉንይ እትፐ ድጪደ ምቴዳ። <verse eid="LUK 8:7"/><verse number="8" style="v" sid="LUK 8:8"/>ሀራይ ሎእያ ቱኤ ቢታን ዎዳ። ዶሎዋፐ ጉይያን፥ ዘረቶዋፐ ጼቱ ኩሽያ ዳኩዋ ሞኬዳ” ያጌዳ።</para>
  <para style="s1" vid="LUK 8:8">የሱስ ሌምሱዋን ሃሳዬዳ ጋሱዋ</para>
  <para style="r" vid="LUK 8:8">(<ref loc="MAT 13:10-17">ማቶሳ 13:10-17</ref>፤ <ref loc="MRK 4:10-12">ማር. 4:10-12</ref>)</para>
  <para style="p" vid="LUK 8:8">የሱስ ሀዋ ሃሳዪደ፥ “ሀይይ ደእያ ኡባይ ስሶ” ያግ ቃላ ቁ ኦደ ዋሴዳ።<verse eid="LUK 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9"/>አ ካልያዋንቱ፥ “ሀ ሌምሱ አያ ጉሴ?” ያግ አ ኦቼድኖ። <verse eid="LUK 8:9"/><verse number="10" style="v" sid="LUK 8:10"/>እካ ዛሪደ፥<note caller="-" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="ISA 6:9">ኢሳ. 6:9</ref></char></note></para>
  <para style="p" vid="LUK 8:10">“ህንተንቶ ጾሳ ካዉተ ጹራ ኤራይ እመቴዳ፤ ሽን ሀራቶ፥ ጼሊድካ ኤረና ማላ፥ ስሲድካ አኬከና ማላ ሌምሱዋን ኦዳይ” ያጌዳ።<verse eid="LUK 8:10"/></para>
  <para style="s1">የሱስ ዘረ ሌምሱዋ ብሊደ ኦዴዳ</para>
  <para style="r">(<ref loc="MAT 13:18-23">ማቶሳ 13:18-23</ref>፤ <ref loc="MRK 4:13-20">ማር. 4:13-20</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11"/>የሱስ፥ “ዘረ ሌምሱ ሀዋ: ዘረይ ጾሳ ቃላ። <verse eid="LUK 8:11"/><verse number="12" style="v" sid="LUK 8:12"/>ኦግያ ጋጻን ዎዳ ዘረይ፥ ጉ ዎደዉ ቃላ ስስያ አሳ፤ ኤለካ ጻላሂ ዪነ፥ ኡንቱንቱ ስሶዋን አማን አተና ማላነ ቃላይ ዎዛናፐ ዶገታና ማላ ኦ። <verse eid="LUK 8:12"/><verse number="13" style="v" sid="LUK 8:13"/>ዛላ ቦላን ዎዳ ዘረይ፥ ኮይሮ ቃላ ናሸቻን ስስያዋንታ። ሄዋንቱካ ጉ ዎድያ አማንኔ ፓጪ ጋክያ ዎድያን ጻጱ ባንታ ድራዉ ኤለካ አማኑዋ ካዲኖ። <verse eid="LUK 8:13"/><verse number="14" style="v" sid="LUK 8:14"/>አጉን ጋርሳን ዎዳ ዘረይ፥ ቃላ ስስያዋንታ፤ ሽን ደኡዋ ህርጋይነ ዱረተ እሻሉ ጩሌዳዋንታ። ሄዋንቱ ሎኦ አይፍያ እማናዉ ዳንዳይክኖ። <verse eid="LUK 8:14"/><verse number="15" style="v" sid="LUK 8:15"/>ሎኦ ቱኤ ቢታን ዎዳ ዘረይ በስያዌ፥ ሎአነ ጽሎ ዎዛናን ቃላ ስሲደ ናግያ አሳነ ሄ ቃላን ምን ኤቂደ ሎኦ አይፍያ አይፍያዋንታ።<verse eid="LUK 8:15"/></para>
  <para style="s1">ጾምፕያ</para>
  <para style="r">(<ref loc="MRK 4:21-25">ማር. 4:21-25</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16"/>“ጾምፕያ ሳደ እትባን ቁምእ አግያዌ ዎይ አርሳፐ ጋርሳና ዎያዌ ኦንነ ባዋ።<note caller="-" style="x"><char style="xo" closed="false">8:16 </char><char style="xt" closed="false"><ref loc="MAT 5:15">ማቶሳ 5:15</ref>፤ <ref loc="LUK 11:33">ሉቃሳ 11:33</ref></char></note> <verse eid="LUK 8:16"/><verse number="17" style="v" sid="LUK 8:17"/>ቆንጨናን ቆሱዋን አትያባይ እት የዉነ ባዋ። ኤረተናንነ ቤትያሳ ከሰናን አታናባይ አይነ ባዋ።<note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="MAT 10:26">ማቶሳ 10:26</ref>፤ <ref loc="LUK 12:2">ሉቃሳ 12:2</ref></char></note> <verse eid="LUK 8:17"/><verse number="18" style="v" sid="LUK 8:18"/>ሄዋ ግድያ ድራዉ ሎይ አኬካን ስስተ። ዎዛናፐ ስስያዎ ኡባዉ ጉጅ አኬካይ እመታና፤ አኬከናዋፐ ሄ አዉ ደእያዋ ማላትያ አኬካይካ አከታናዋ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="MAT 25:29">ማቶሳ 25:29</ref>፤ <ref loc="LUK 19:26">ሉቃሳ 19:26</ref></char></note><verse eid="LUK 8:18"/></para>
  <para style="s1">የሱሳ ዳዮነ አ እሻቱዋ</para>
  <para style="r">(<ref loc="MAT 12:46-50">ማቶሳ 12:46-50</ref>፤ <ref loc="MRK 3:31-35">ማር. 3:31-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19"/>ሄ ዎድያን አታነ እሻቱ የሱሳና ጋከታናዉ አኮ ዬድኖ፤ ሽን አሳ ጮራተፐ ደንዶ ጋሱዋን አ ደማናዉ ዳንዳይበይክኖ። <verse eid="LUK 8:19"/><verse number="20" style="v" sid="LUK 8:20"/>እት ብታኒ፥ “ነ ዳያነ ነ እሻቱ ኔናና ጋከታናዉ ኮዮ ድራዉ ካረን ዪደ ኤቄድኖ” ያግ ኦዴዳ።<verse eid="LUK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21"/>እካ፥ “ታ ዳያነ ታ እሻቱ፥ ጾሳ ቃላ ስሲደ ኦሱዋ ቦላን ፔሽያዋንታ” ያግ ዛሬዳ።<verse eid="LUK 8:21"/></para>
  <para style="s1">የሱስ ቤታ ጮኡ ኦዳ</para>
  <para style="r">(<ref loc="MAT 8:23-27">ማቶሳ 8:23-27</ref>፤ <ref loc="MRK 4:35-41">ማር. 4:35-41</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22"/>እት ጋላስ የሱስ ባረና ካልያዋንቱና እትፐ ዎንግርያ ገሊደ፥ “አባፐ ሄፍን ቦይተ” ጌዳ። ኡንቱንቱካ ደንዲደ ሀመታ ዶሜድኖ። <verse eid="LUK 8:22"/><verse number="23" style="v" sid="LUK 8:23"/>ፕን ደእያ ዎደ፥ የሱስ ገምእሼዳ። አባን ጎቱዋ ጫርኩ ደንዶ ድራዉ፥ ዎንግርያ ጋርሳን ሃይ ኩምና ዳሮ መቶቴድኖ። <verse eid="LUK 8:23"/><verse number="24" style="v" sid="LUK 8:24"/>ኡንቱንቱ የሱሳኮ ሺቂደ፥ “ጎዳዉ፥ ጎዳዉ! ኑን ባዮይተቴ!” ያጊደ አ ቤጎድኖ።</para>
  <para style="p" vid="LUK 8:24">እካ ቤጎቲደ ጎቱዋነ ሃ ቤታ ሴርና፥ ጎቱነ ሃ ቤታይ ኤቄዳ፤ ኡባባይካ ጮኡ ጌዳ። <verse eid="LUK 8:24"/><verse number="25" style="v" sid="LUK 8:25"/>እካ፥ “ህንተንቶ አማኑ ሀቃን ደኢ?” ያጌዳ።</para>
  <para style="p" vid="LUK 8:25">ኡንቱንቱካ ያይ ማላለቲደ እቱ እቱዋ፥ “ሀዋዳን ጫርኩነ ሃይ ጮኡ ጊተ ጊና አዛዘትያዌ ሀዌ ኦኔ?” ያገቴድኖ።<verse eid="LUK 8:25"/></para>
  <para style="s1">የሱስ ጻላሂ ኦይቄዳ ብታንያ ፓዳ</para>
  <para style="r">(<ref loc="MAT 8:28-34">ማቶሳ 8:28-34</ref>፤ <ref loc="MRK 5:1-20">ማር. 5:1-20</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26"/>ጋሊላ አባፐ ሄፍንና ደእያ ገርገሰኖና ጌተትያ ጋድያ፥ የሱስነ አ ካልያዋንቱ፥ ዎንግርያን ፕኒደ ጋኬድኖ። <verse eid="LUK 8:26"/><verse number="27" style="v" sid="LUK 8:27"/>ሄ ሃፐ ፕን ሳኣ ዎ ዎደ፥ ኢታ አያናን ኦይቀቴዳ እት ብታኒ፥ ካታማፐ ከሲደ አናና ጋከቴዳ። ዳሮ ዎድያፐ ዶሚደ ማዩዋ ማየናን ካሎ ጎልያ አጊደ ዱፉዋን ደኤ።<verse eid="LUK 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 8:28"/>የሱሳ ደሞዋፐ ጉይያን፥ ዋስ አ ስንን ጉፋኒደ ዎልቃማ ኮሻን፥ “ዎልቃማ ጾሳ ናኣ የሱሳ፥ ታዉነ ነዉ አይበ እትፐተይ ደኢ? ታና ዋይሶፓርኪ፤ ታ ኔና ዎሳይ” ያጌዳ። <verse eid="LUK 8:28"/><verse number="29" style="v" sid="LUK 8:29"/>እ ሄዋ አያዉ ጌዴ ጎፐ፥ ብታንያ የግ ከሳና ማላ የሱስ አ አዛዞ ድራሳ።</para>
  <para style="p" vid="LUK 8:29">ኢታ አያናይ ብታንያ ኦይቆደፐ ዳሮ ዎደ ግዶ ድራዉ፥ ብራታ ሳንላታን ገድያነ ኩሽያ ቃሸቲደ ናገቴ። ሳንላታ ዱ አኪደ ኢታ አያናይ ካለና ባዙዋ ቤ።<verse eid="LUK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30"/>የሱስካ፥ “ነ ሱንይ ኦኔ?” ያግ ኦቼዳ። እካ ጮራ ኢታ አያናይ ገል ኡቶ ድራዉ፥ “ሌግዮና”<note caller="+" style="f"><char style="fr" closed="false">8:30 </char><char style="fq" closed="false">ሌግዮና፦ </char><char style="ft" closed="false">ሀ ሱንይ ግሪከ ጌተትያ ቃላፐ አከቴዳ። ሱን ብለይ “ጮራ” ጉሳ።</char></note> ያጌዳ። <verse eid="LUK 8:30"/><verse number="31" style="v" sid="LUK 8:31"/>ባረንታ የሱስ፥ “ህን ጪሞ ኦላ ቢተ” ያገና ማላ ዎሴድኖ።<verse eid="LUK 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32"/>ሄዋን ደእያ ዞዝያ ጋጻን ሄመትያ ጮራ ጉዱንቱ ደኢኖ። ጮራ ቱና አያናቱ፥ ሄ ጉዱንቱዋ ጋርሳ፥ “ገልተ” ጋና ማላ የሱሳ ዎሴድኖ። እካ፥ “ቢደ ገልተ” ጌዳ። <verse eid="LUK 8:32"/><verse number="33" style="v" sid="LUK 8:33"/>ኢታ አያናቱካ ብታንያፐ ከሲደ ጉዱንቱዋ ጋርሳ ገሌድኖ። ጉዱን ዉዲካ ላንቂያፐ ካጆቲደ ኤለካ አባን ምተቴድኖ።<verse eid="LUK 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34"/>ጉዱን ሄምያዋንቱ ሀኖዋ ኡባ በኦ ዎደ ሀራሳ ቢደ፥ ሄ ካታማንነ ዩሹዋን ሀኖዋ ኦዴድኖ። <verse eid="LUK 8:34"/><verse number="35" style="v" sid="LUK 8:35"/>አዬ ሀኔደንቶ በአናዉ ከሲደ፥ አሳይ የሱሳኮ ዬድኖ። ኢታ አያናይ ከሴዳ ብታኒ፥ አ ዎዛናይ ስምና ማዩዋ ማዪደ የሱሳ ገድያ ማታን ኡቶዋ በኢደ ያዬድኖ።<verse eid="LUK 8:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 8:36"/>ኢታ አያናን ኦይቀቴዳ ብታኒ ዎት ፓጼደንቶ በኤዳ አሳይ፥ ሀራ አሳዉ ኦዴድኖ። <verse eid="LUK 8:36"/><verse number="37" style="v" sid="LUK 8:37"/>ገርገሰኖና ጋድያንነ ሄ ሄራን ደእያ አሳይ ኡባይ ዳሪ ያዬዳ ድራዉ፥ የሱስ ባረንቱ ማታፐ ባና ማላ ዎሴድኖ። እካ ዎንግርያን ገሊደ ቤዳ። <verse eid="LUK 8:37"/><verse number="38" style="v" sid="LUK 8:38"/>ኢታ አያናይ ከሴዳ ብታኒካ የሱሳና ባና ጊደ፥ አ ዎሴዳ፤ ሽን የሱስ፥ <verse eid="LUK 8:38"/><verse number="39" style="v" sid="LUK 8:39"/>“ነ ጎለ ስማደ ጾሳይ ነዉ ኦ ዎልቃማባይ አየንቶ ማርካታ” ያግ የዴዳ።<verse eid="LUK 8:39"/></para>
  <para style="s1">ሀይቄዳ ናቶነ ሳከትያ ምሽራቶ</para>
  <para style="r">(<ref loc="MAT 9:18-26">ማቶሳ 9:18-26</ref>፤ <ref loc="MRK 5:21-43">ማር. 5:21-43</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40"/>የሱስ ስሜዳ ዎደ አሳይ ኡባይ ናግ ደእያ ድራዉ፥ አ ሞክ አኬድኖ። <verse eid="LUK 8:40"/><verse number="41" style="v" sid="LUK 8:41"/>ሄ ዎደ፥ አይሁደ አሳ ዎሳ ጎለዉ ሱን ግዴዳ ያእሮሳ ያገትያ ብታኒ አኮ ዬዳ። እካ የሱሳ ገድያ ስንን ኩንዲደ፥ ባረ ጎለ ገላና ማላ ዎሴዳ። <verse eid="LUK 8:41"/><verse number="42" style="v" sid="LUK 8:42"/>ጋሶተይካ ታማነ ላኡ ላይይ ኩሜዳ አዉ ደእያ እት ናታ ሀይቃናዉ ማታ ኡቶ ድራሳ።</para>
  <para style="p" vid="LUK 8:42">የሱስ ብያ ዎደ ጮራ አሳይ አ ዩሹዋን ሱገቲደ መቶድኖ። <verse eid="LUK 8:42"/><verse number="43" style="v" sid="LUK 8:43"/>ሄ አሳ ግዶን ሄ ዎድያን ታማነ ላኡ ላይ ኡባ ሱይ ጎግያ ምሽራታ ደአዉ። ባረ ደእያ ሻሉዋ ኡባ ልያ ኤርያዋንቶ ዉርስናካ ፓናዉ ዳንዳዮዌ ኦንነ ባዋ።<verse eid="LUK 8:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 8:44"/>ጉየና ያደ አ ማዩዋ ማጫራ ቦቻዱ፤ ሄ ማንእያን ኢፐ ጎግያ ሱይ ኤቂ አጌዳ። <verse eid="LUK 8:44"/><verse number="45" style="v" sid="LUK 8:45"/>የሱስ፥ “ኦኔ ታና ቦቾዌ?” ያጌዳ።</para>
  <para style="p" vid="LUK 8:45">ኡባይ ካድና ጰጽሮስ፥ “ጎዳዉ፥ አሳይ ሱገቲደ መቶትያ ዎደ፥ ‘ኦኔ ታና ቦቾዌ’ ያጋይ?” ጌዳ።<verse eid="LUK 8:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46"/>ሽን የሱስ፥ “እት አሳይ ታና ቦቼዳ፤ ዎልቃይካ ታፐ ከሶዋ ታን ኤራይ” ያጌዳ። <verse eid="LUK 8:46"/><verse number="47" style="v" sid="LUK 8:47"/>ምሽራታካ፥ የሱሳ እዛ ቦቾዌ ኤረተናን አትቤናዋ ኤራደ፥ ኮኮራደ ዮና የሱሳ ስንን ኩንዳ አጋዱ። አያ ጋሱዋን የሱሳ ቦቻደንቶ እዛ ፓጾዋ ኡባ አሳ ስንን ኦዳዱ።<verse eid="LUK 8:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 8:48"/>እካ እዝዉ፥ “ሀ ምሽራቴ! ነ አማኑ ኔና ፓዳ፤ ሳሮ ባ” ያጌዳ።<verse eid="LUK 8:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49"/>የሱስ ሃሳይ ደእሽን፥ አይሁዳ አሳ አማንያዋንቱ ሱን ሶይፐ እት ብታኒ ዬዳዌ፥ “ነ ናታ ሀያዱ፤ ስም ታማርስያዋ መቶፓ” ያጌዳ።<verse eid="LUK 8:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50"/>የሱስ ሀዋ ስሲደ፥ “ያእሮሳ፥ አማናፐ አትን፥ ያዮፓ! እዛ ፓጻናዉኑ” ያግ ዛሬዳ።<verse eid="LUK 8:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51"/>ሶይ ገሊደ: ጰጽሮሳፐ፥ ያቆባፐ፥ ዮሃንሳፐ፥ ናት አቡፐነ ናት ዳይፐ አትን፥ ኦንነ ገላናዳን ኤኖ ግቤና። <verse eid="LUK 8:51"/><verse number="52" style="v" sid="LUK 8:52"/>ኡባይ ሄ ናትዉ ዬኪደነ ካዮቲድ ደኢኖ። ሽን የሱስ፥ “ዬኮፕተ፥ ግሳዱፐ አትን ሀያበይኩ” ያጌዳ።<verse eid="LUK 8:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53"/>እዛ ሀይቄዳዋ ኤሪደ አ ቦላ ሚጬድኖ። <verse eid="LUK 8:53"/><verse number="54" style="v" sid="LUK 8:54"/>ግዶፐ አትን የሱስ እዝ ኩሽያ ኦይቂደ፥ “ሀ ናቴ፥ ቤጎታ!” ያጌዳ። <verse eid="LUK 8:54"/><verse number="55" style="v" sid="LUK 8:55"/>እዝ ሸምፑካ ስምና ኤለካ ደንዳ ኤቂና ማናባ እማና ማላ፥ የሱስ አዛዜዳ። <verse eid="LUK 8:55"/><verse number="56" style="v" sid="LUK 8:56"/>እዝ አቡነ እዝ ዳያ ማላለቴድኖ፤ ሽን የሱስ ኡንቱንታ፥ ሀኖ የዉዋ ኦስነ ኦደና ማላ አዛዜዳ።<verse eid="LUK 8:56"/></para>
  <chapter eid="LUK 8"/>
  <chapter number="9" style="c" sid="LUK 9"/>
  <para style="s1">የሱስ ባረና ካልያ ታማነ ላአቱዋ ኪቴዳ</para>
  <para style="r">(<ref loc="MAT 10:5-15">ማቶሳ 10:5-15</ref>፤ <ref loc="MRK 6:7-13">ማር. 6:7-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1"/>የሱስ ታማነ ላኡ አ ካልያዋንታ እትፐ ባረኮ ጼሲደ፥ ጻላህያ ኡባ አሳፐ ከሳናዉነ ሀርግያዋንታ ፓና ማላ ዎልቃነ ማታ እሜዳ። <verse eid="LUK 9:1"/><verse number="2" style="v" sid="LUK 9:2"/>ጾሳ ካዉተባ ኦዳናዉነ ሀርጋንቻቱዋ ፓና ማላ ኡንቱንታ ኪቴዳ። <verse eid="LUK 9:2"/><verse number="3" style="v" sid="LUK 9:3"/>እ ኡንቱንታ ኪቲደ፥ “ኦግያ ቢደ፥ ጻምኣ ግድናካ፥ ዎይ ቃርጪትያ፥ ዎይ ቁማ፥ ዎይ ሚሻ ግድናካ አያነ ኦይቆፕተ፤ ላኤንያ ማዩዋካ ኦይቆፕተ።<note caller="-" style="x"><char style="xo" closed="false">9:3-5 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">ሉቃሳ 10:4-11</ref></char></note> <verse eid="LUK 9:3"/><verse number="4" style="v" sid="LUK 9:4"/>ህንተና አሳይ ሀቃን ሞኮፐነ፥ ሄዋፐ ከሳና ጋካናዉ፥ ህንተንቱ ገሌዳ ጎልያን ጋምእተ። <verse eid="LUK 9:4"/><verse number="5" style="v" sid="LUK 9:5"/>ሄ ካታማ አሳይ ህንተና ሞከናን እጾፐ፥ ሄዋፐ ከሲደ፥ ኡንቱንቱ ህንተና ሞከናን እጾዎ ማርካ ግዳና ማላ፥ ህንተንቱ ገድያፐ ባና ሾጭ ድጊደ ቢተ” ያጌዳ።<verse eid="LUK 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 9:6"/>አ ካልያዋንቱ ቢደ፥ ቄር ካታማ ኡባን ምሽራቹዋ ቃላ ኦዲደነ ሀርጋንቻ ፓደ ዩዬድኖ።<verse eid="LUK 9:6"/></para>
  <para style="s1">ሄሮድሰ ኦዳባ</para>
  <para style="r">(<ref loc="MAT 14:1-12">ማቶሳ 14:1-12</ref>፤ <ref loc="MRK 6:14-29">ማር. 6:14-29</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7"/>ሀእ ጋሊላ ቢታ ካትያ ሄሮድሰካ ሀኔዳ የዉዋ ስሲደ ያት ጌዳ። ጋሶተይነካ እት እት አሳይ፥ “ዮሃንስ ሀይቁዋፐ ደንዴዳ” ያጌ። <verse eid="LUK 9:7"/><verse number="8" style="v" sid="LUK 9:8"/>ሀራ አሳይ፥ “ኤላስ ከሲደ ቤቴዳ” ያግያ ዎደ፥ ሀራንቱ ቃይ፥ “በን ናባቱዋፐ እቱ ሀይቁዋፐ ደንዴዳ” ያጊኖ። <verse eid="LUK 9:8"/><verse number="9" style="v" sid="LUK 9:9"/>ሄሮድሰካ፥ “ታን ዮሃንሳ ቆያ ቃንጽሳ ድጋድሽን፥ ሀዋዳን አሳይ ሃሳይያ ብታኒ ኦኔ?” ያጊደ፥ የሱሳ በአናዉ ኮዬዳ።<verse eid="LUK 9:9"/></para>
  <para style="s1">የሱስ እቼሹ ሻአ አሳ ምዚደ ካልሴዳ</para>
  <para style="r">(<ref loc="MAT 14:13-21">ማቶሳ 14:13-21</ref>፤ <ref loc="MRK 6:30-44">ማር. 6:30-44</ref>፤ <ref loc="JHN 6:1-14">ዮሃ. 6:1-14</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10"/>የሱስ ኪቶዋንቱ ስሚደ፥ ኡንቱንቱ ኦዳዋ ኡባባ የሱሳዉ ኦዴድኖ። እካ ኡንቱንታ አኪደ፥ ቤተሳይዳ ያገትያ ካታማ ማታን ደእያ ታካሳ ቤዳ። <verse eid="LUK 9:10"/><verse number="11" style="v" sid="LUK 9:11"/>አሳይ እ ደኢያሳ ኤሪደ ካልና፥ ኡንቱንታ ሞክ አኪደ ጾሳ ካዉተባ ኦዴዳ፤ ሀርግያፐ ፓጻናዉ በስያዋንታካ ፓዳ።<verse eid="LUK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12"/>ሳአይ ኦማርስያ ዎደ፥ የሱሳ ካልያ ታማነ ላአቱ አኮ ዪደ፥ “ሀ አሳይ ኡባይ ኑ ዩሹዋን ደእያ ሄራ ግዶነ ቄር ካታማቱዋ ግዶ ቢደ፥ አቅያሳነ ቁማ ደማና ማላ ሞይዛ፤ አያዉ ጎፐ ኑን ሀዋን አሳይ ባይናሳን ደኤቶ” ያጌድኖ።<verse eid="LUK 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13"/>ሽን የሱስ ኡንቱንታ፥ “አሳዉ ሜተትያባ ህንተንቱ እምተ” ያጌዳ።</para>
  <para style="p" vid="LUK 9:13">ኡንቱንቱ ዛሪደ፥ “አነ ቢደ፥ ሀ ኡባ አሳዉ ቁማ ሻመናን ዮፐ ኑዉ እቼሹ ሶሉዋፐነ ላኡ ሞልያፐ ሀራይ ባዋ፤ ሄዎ ኑን ሀ ጮራ አሳዉ ቁማ ሻማና ማላ ኮያይ?” ያጌድኖ። <verse eid="LUK 9:13"/><verse number="14" style="v" sid="LUK 9:14"/>(ጋሱካ፥ ሄዋን ደእያ አሳይ እቼሹ ሻኣ ኬና።)<note caller="+" style="f"><char style="fr" closed="false">9:14 </char><char style="fqa" closed="false">እቼሹ ሻአ፦ </char><char style="ft" closed="false">እስራኤልያ ዎጋን ማጫዌነ ቄር ናናይ ፓይደተና ድራዉ፥ እቼሹ ሻኣ ጉሳይ ማጫዋነ ቄር ናና ፓይደናን ኩሜዳዋ። ሀ ፓይዱ ደእያ ኮይሮ ማራይ በን ማጻፋ እቱዋ እቱዋን ባዋ።</char></note></para>
  <para style="p" vid="LUK 9:14">የሱስ ባረና ካልያዋንታ፥ “እሻታሙ እሻታሙ አሳ ጭታን ጭታን ሻክ ሻክ ኡትስተ” ያጌዳ።<verse eid="LUK 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 9:15"/>ኡንቱንቱካ እ ጎዋዳን ኡባ አሳካ ኡትሴድኖ። <verse eid="LUK 9:15"/><verse number="16" style="v" sid="LUK 9:16"/>የሱስካ እቼሹ ሶሉዋነ ላኡ ሞልያ ኦይቂደ፥ ፑደ ሳሉዋ ቦንጎት ጼሊደ ጾሳ ጋላቴዳ፤ ዱደ፥ አሳዉ ግሻና ማላ አ ካልያዋንቶ እሜዳ። <verse eid="LUK 9:16"/><verse number="17" style="v" sid="LUK 9:17"/>አሳይ ኡባይካ ሚደ ካሌድኖ። ኡንቱንቱፐ አቴዳ ዶካ፥ ታማነ ላኡ ሳምፓ ኩሜዳዋ ደንድኖ።<verse eid="LUK 9:17"/></para>
  <para style="s1">ጰጽሮስ የሱሳባ አዋዬዳ</para>
  <para style="r">(<ref loc="MAT 16:13-19">ማቶሳ 16:13-19</ref>፤ <ref loc="MRK 8:27-29">ማር. 8:27-29</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18"/>እት ጋላስ የሱስ ባረካ ዎስያ ዎደ፥ አ ካልያዋንቱካ አናና እትፐ ደእሽን፥ “አሳይ ታና ኦና ጊኖ?” ጊደ ኡንቱንታ ኦቼዳ።<verse eid="LUK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19"/>ኡንቱንቱ ዛሪደ፥ “አሳይ ኔና ጻማቅያ ዮሃንሳ ያጌ፤ ሀራ አሳይ ቃይ ኤላሳ<note caller="+" style="f"><char style="fr" closed="false">9:19 </char><char style="fq" closed="false">ኤላሳ፦ </char><char style="ft" closed="false">ሀ ናቢ እ ሀይቆደፐ ዳሮ ዎደፐ ጉየ፥ የሱስ ክርስቶስ ቢታ ቦላን ታማርሲደ ደርያ ቦላ ዎሳዉ ከሲደ ላመት ቦጼዳዋፐ ጉየ ባጋን አናናነ ሙሴና ሃሳዬዳ። ሄዋ ጉሳይ ሀይቂ ስሚደ ዳሮ ጮራ ዎድያፐ ጉየ ፓጻ ቆንጬዳ ጉሳ።</char></note> ያጌ፤ ሀራይ ቃይ በን ናባቱዋፐ እቱ ደንዴዳ ያጌ” ያጌድኖ።<note caller="-" style="x"><char style="xo" closed="false">9:19 </char><char style="xt" closed="false"><ref loc="MAT 14:1">ማቶሳ 14:1</ref>፣ <ref loc="MAT 14:2">2</ref>፤ <ref loc="MRK 6:14">ማር. 6:14</ref>፣ <ref loc="MRK 6:15">15</ref>፤ <ref loc="LUK 9:7">ሉቃሳ 9:7</ref>፣ <ref loc="LUK 9:8">8</ref></char></note><verse eid="LUK 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20"/>የሱስ ኡንቱንታ፥ “ህንተሽ፥ ታና ኦና ጊቴ?” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="JHN 6:68">ዮሃ. 6:68</ref>፣ <ref loc="JHN 6:69">69</ref></char></note></para>
  <para style="p" vid="LUK 9:20">ጰጽሮስካ ዛሪደ፥ “ኔን ጾሳይ ኦኬዳ ክርስቶሳ” ያጌዳ።<verse eid="LUK 9:20"/></para>
  <para style="s1">የሱሳ ካልያዋንቱ ሀናናዉ በስያባ</para>
  <para style="r">(<ref loc="MAT 10:38-39">ማቶሳ 10:38-39</ref>፤ <ref loc="MAT 16:24-26">16:24-26</ref>፤ <ref loc="MRK 8:34-38">ማር. 8:34-38</ref>፤ <ref loc="LUK 14:26-27">ሉቃሳ 14:26-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21"/>የሱስካ ኡንቱንታ፥ “ሀዋ ኦስነ ኦዶፕተ” ያግ ምንስ አዛዚደ፥ <verse eid="LUK 9:21"/><verse number="22" style="v" sid="LUK 9:22"/>“ታን፥ አሳ ናአይ፥ ዳሮ መቱዋ አካናዉ በሴ፤ ጭማቱዋን፥ ቄሳቱዋ ካፓቱዋንነ ሙሴ ህግያ ታማርስያዋንቱን እጸታናዉ ኮሼ፤ ኡንቱንቱ ታና ዎናዋንታ፤ ታንካ ሄዘን ጋላስ ሀይቁዋፐ ደንዳናዉ በሴ” ያጌዳ።<verse eid="LUK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23"/>የሱስካ አሳ ኡባ፥<note caller="-" style="x"><char style="xo" closed="false">9:23 </char><char style="xt" closed="false"><ref loc="MAT 10:38">ማቶሳ 10:38</ref>፤ <ref loc="LUK 14:27">ሉቃሳ 14:27</ref></char></note> “ታና ካላናዉ ዶስያዌ ደኦፐ፥ ባረ ሁጲያ ካዶ፤ ባረ ማስቃልያ<note caller="+" style="f"><char style="fr" closed="false">9:23 </char><char style="fk" closed="false">ማስቃልያ፦ </char><char style="ft" closed="false">ሀዋ ጉሳይ፥ እት አሳይ ባረ ላይ ኡባን ጾሳ ካሊደ ሻከተናን ቶካናዉ በስያ መቱዋነ ዋይያ።</char></note> ጋላሳን ጋላሳን ቶኪደ ታና ካሎ። <verse eid="LUK 9:23"/><verse number="24" style="v" sid="LUK 9:24"/>ባረ ሸምፑዋ አሻናዉ ዶስያዌ ኡባይ ባይዜ፤ ሽን ታ ድራዉ ባረ ሸምፑዋ ባይዝያዌ ኡባይ አሼ። <verse eid="LUK 9:24"/><verse number="25" style="v" sid="LUK 9:25"/>እት ኡራይ ሀ አላምያባ ኡባ አሺደ ባረ ሸምፑዋ ባይዞፐ ዎይ ባረዉ ፓጭሶፐ፥ አያ ማዲ? <verse eid="LUK 9:25"/><verse number="26" style="v" sid="LUK 9:26"/>አሳይ ታናንነ ታ ቃላን ዬላቶፐ፥ ታን አሳ ናአይ፥ ታ ቦንቹዋናነ ጌሻ ኪታንቻቱዋ ቦንቹዋና ይያ ዎደ አን ዬላታናዋ። <verse eid="LUK 9:26"/><verse number="27" style="v" sid="LUK 9:27"/>ታን ህንተንቶ ቱሙዋ ያጋይ፤ ሀዋን ደእያ አሳፐ፥ ጾሳ ካዉተ በአና ጋካናዉ ሀይቁዋ ሀይቀናዋንቱ እቱ እቱ ደኢኖ” ያጌዳ።<verse eid="LUK 9:27"/></para>
  <para style="s1">የሱሳ ማላይ ላመቴዳ</para>
  <para style="r">(<ref loc="MAT 17:1-8">ማቶሳ 17:1-8</ref>፤ <ref loc="MRK 9:2-8">ማር. 9:2-8</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28"/>የሱስ ሀዋ ጎዋፐ ጉይያን፥ እት ሳምንታ ኬና ጋምኢደ፥ ጰጽሮሳነ ዮሃንሳ፥ ያቆባካ አኪደ፥ ዎሳናዉ ደርያ ሁጲያ ከሴዳ።<note caller="-" style="x"><char style="xo" closed="false">9:28 </char><char style="xt" closed="false"><ref loc="2PE 1:17">2 ጰጽ. 1:17</ref>፣ <ref loc="2PE 1:18">18</ref></char></note> <verse eid="LUK 9:28"/><verse number="29" style="v" sid="LUK 9:29"/>እ ዎስሽን፥ አ ዴሙዋ ማላይ ላመቴዳ፤ አ ማዩካ ቦጺደ ጶልቄዳ። <verse eid="LUK 9:29"/><verse number="30" style="v" sid="LUK 9:30"/>ቆፐናን ላኡ አሳቱ፥ ሙሴነ ኤላስ ከስ ቤቲደ፥ የሱሳና ሃሳይ ደኢኖ። <verse eid="LUK 9:30"/><verse number="31" style="v" sid="LUK 9:31"/>ኡንቱንቱ ቦንቹዋን ቆንጭ ቤቲደ፥ የሱስ ጾሳ ቆፋ ፖላናዉ የሩሳላመን ሀይቃናዋ<note caller="+" style="f"><char style="fr" closed="false">9:31 </char><char style="fk" closed="false">ሀይቃናዋ፦ </char><char style="ft" closed="false">ግሪከ ማጻፋ ቆፋን ሀዋ ጉሳይ፥ “የሱስ ሳሉዋ ብያዋ”፤ ሀዌ ቃይ እ ሀይቁዋፐ ደንድያዋነ ያቲደ ሳሉዋ ብያዋ ኡባ ሺሽ ኦይቄዳ ቆፋ።</char></note> አናና ሃሳዬድኖ። <verse eid="LUK 9:31"/><verse number="32" style="v" sid="LUK 9:32"/>ጰጽሮሳነ አናና እትፐ ደእያዋንታ ገምእሹ ጌሮዬዳሽን፥ ኤለካ ቤጎቲደ አ ቦንቹዋነ አናና ጋ ኤቄዳ ላኡ አሳቱዋ በኤድኖ። <verse eid="LUK 9:32"/><verse number="33" style="v" sid="LUK 9:33"/>ሄ ላኡ አሳቱ፥ የሱሳ ምይያፐ ሻከትያ ዎደ፥ ጰጽሮስ የሱሳ፥ “ጎዳዉ፥ ሀዋን ደእያዌ ኑዉ ሎአ ግድያ ድራዉ፥ ሄዙ ዳስያ እቱዋ ነዉ፥ እቱዋ ሙሴዉ፥ እቱዋ ኤላሳዉ ኬጻና” ያጌዳ።<verse eid="LUK 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 9:34"/>ጰጽሮስ ሄዋ ሃሳይ ደእሽን፥ ሻሪ ዪደ ኡንቱንታ ካም አግና የሱሳ ካልያዋንቱ ያዬድኖ። <verse eid="LUK 9:34"/><verse number="35" style="v" sid="LUK 9:35"/>ሻርያፐካ፥ “ታን ዶሬዳ ታ ናአይ ሀዋ፤ እ ግያዋ ስስተ” ያግያ ቃላይ ዬዳ።<verse eid="LUK 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 9:36"/>ቃላይ ስሰቶዋፐ ጉይያን፥ የሱስ ባረ ጻላላ ግዲደ ቤቴዳ፤ ኡንቱንቱካ የዉዋ ባረንቱ ዎዛናን ኦይቂደ ሄ ዎድያን ኦንነካ አያነ ኦድቤና።<verse eid="LUK 9:36"/></para>
  <para style="s1">የሱስ ኢታ አያናን ኦይቀቴዳ ላኡ አሳቱዋ ፓዳ</para>
  <para style="r">(<ref loc="MAT 17:14-18">ማቶሳ 17:14-18</ref>፤ <ref loc="MRK 9:14-27">ማር. 9:14-27</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37"/>ዎንተ ጋላስ፥ የሱስነ ሄዙ አ ካልያዋንቱ ደርያፐ ዱገ ዎያ ዎደ፥ ጮራ አሳይ የሱሳና ጋከቴዳ። <verse eid="LUK 9:37"/><verse number="38" style="v" sid="LUK 9:38"/>ሄ ዎደ አሳፐ እት ብታኒ ባረ ኮሻ ቁ ኦደ፥ “ታማርስያዎ፥ ታዉ ደእያዌ እት ናኣ ግዶ ድራዉ፥ ኔን አ በአና ማላ ኔና ዎሳይ፤ <verse eid="LUK 9:38"/><verse number="39" style="v" sid="LUK 9:39"/>ቃይ ኢታ አያናይ ዎዛና አናን ደንዲደ አ ዋስሴ፤ ዶናና ፓሮያና ጋካናዉ አ ኮኮርሲደ፥ ኡባ ጋላስ መቶያዋፐ አትን፥ አ ኤለ የደና። <verse eid="LUK 9:39"/><verse number="40" style="v" sid="LUK 9:40"/>ኔና ካልያዋንቱ ሄ ኢታ አያና ከሳና ማላ፥ ታን ኡንቱንታ ዎሳድ፤ ሽን ዳንዳይበይክኖ” ያጌዳ።<verse eid="LUK 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41"/>የሱስ ዛሪደ ኡንቱንታ፥ “አማነና ሀ ዎድያ ደሻ አሳዉ፥ ታን ህንተናና አዉደ ጋካናዉ ደአኔ? ቃይ ህንተንቱባ አዉደ ጋካናዉ ዳንዳያኔ? ነ ናኣ ሃ አካያ” ያጌዳ።<verse eid="LUK 9:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42"/>ናአይ ዪደ ደእሽን፥ ኢታ አያናይ አ ሳኣን ኦሊደ ኮኮርሴዳ፤ የሱስ ኢታ አያና አጋ ግ ናኣ ፓደ አ አቦ ዛሪደ እሜዳ። <verse eid="LUK 9:42"/><verse number="43" style="v" sid="LUK 9:43"/>አሳይ ኡባይካ ጾሳ ዎልቃማ ዎልቃፐ ደንዶዋን ማላለቴድኖ።<verse eid="LUK 9:43"/></para>
  <para style="s1">የሱስ ባረ ሀይቁዋባ ላኤንዋ ኦዴዳ</para>
  <para style="r">(<ref loc="MAT 17:22-23">ማቶሳ 17:22-23</ref>፤ <ref loc="MRK 9:30-32">ማር. 9:30-32</ref>)</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 9:44"/>“ታና አሳ ናኣ፥ አሳይ አሳ ኩሽያን አደ እማናዋ፤ ህንተንቱ ሀ የዉዋ ዶጎፕተ” ያጌዳ። <verse eid="LUK 9:44"/><verse number="45" style="v" sid="LUK 9:45"/>ሽን እ ግያዋ ኡንቱንቱ አኬክበይክኖ። ኡንቱንቶ ገለና ማላ ኡንቱንቱፐ ጌሜዳ ድራዉ፥ ሀ የዉዋ የሱሳ ኦቻናዉ ያዬድኖ።<verse eid="LUK 9:45"/></para>
  <para style="s1">ኡባፐ አያዌ ኦኔሻ? ያግያ ኦሻ</para>
  <para style="r">(<ref loc="MAT 18:1-5">ማቶሳ 18:1-5</ref>፤ <ref loc="MRK 9:33-37">ማር. 9:33-37</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46"/>አ ካልያዋንቱ፥ “ኑ ግዶፐ ዳርያዌ ኦኔ?” ያጊደ ፓሉመቴድኖ።<note caller="-" style="x"><char style="xo" closed="false">9:46 </char><char style="xt" closed="false"><ref loc="LUK 22:24">ሉቃሳ 22:24</ref></char></note> <verse eid="LUK 9:46"/><verse number="47" style="v" sid="LUK 9:47"/>የሱስ ኡንቱንቱ ዎዛና ቆፋ ኤሪደ፥ ጉ ናኣ አሂደ፥ ባረ ማታን ኤሲደ፥ <verse eid="LUK 9:47"/><verse number="48" style="v" sid="LUK 9:48"/>“ሀ ጉ ናኣ ታ ሱንን ሞክያዌ ኦንነ ታና ሞኬዳ፤ ቃይ ታና ሞክያ ኡባይ፥ ታና ኪቴዳ ታ አባ ሞኬ። ህንተንቱ ኡባፐ ጉጽያዌ ኡባፐ ዳራ” ያጌዳ።<verse eid="LUK 9:48"/></para>
  <para style="s1">ህንተንቱ ግያዋ ጳልቀና ኡራይ ህንተንቱ ባጋ</para>
  <para style="r">(<ref loc="MRK 9:38-40">ማር. 9:38-40</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49"/>ዮሃንስካ ዛሪደ፥ “ጎዳዉ፥ እት አሳይ ነ ሱንን ኢታ አያናቱዋ ከስያዋ ኑን በኢደ፥ ኑ ባጋ ግደና ድራዉ፥ አ ድጌዶ” ያጌዳ።<verse eid="LUK 9:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50"/>ሽን የሱስ አ፥ “ህንተንቱ ግያዋ ጳልቀናዌ ህንተንቱ ባጋ ግድያ ድራዉ፥ አ ድጎፕተ” ያጌዳ።<verse eid="LUK 9:50"/></para>
  <para style="s1">ሳማርያ ካታማ አሳቱ የሱሳ ሞካናዉ ኮይበይክኖ</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51"/>የሱስ ሳሉዋ ብያ ዎዲ ማትና፥ ባረ ዎዛና ቆፋ የሩሳላመኮ ዛሬዳ። <verse eid="LUK 9:51"/><verse number="52" style="v" sid="LUK 9:52"/>ባረፐ ስንዉ ኡባ የዉዋ ጊግሳና ማላ፥ ኪተትያ አሳ ሳማርያ ካታማ ኪቴዳ። <verse eid="LUK 9:52"/><verse number="53" style="v" sid="LUK 9:53"/>ሽን እ የሩሳላመ ባናዉ ደንዴዳ ድራዉ፥ አሳይ አ ሞክበይክኖ። <verse eid="LUK 9:53"/><verse number="54" style="v" sid="LUK 9:54"/>አ ካልያዋንቱ ያቆብነ ዮሃንስ ሄዋ በኢደ፥ “ጎዳዉ፥ ኑን ኤላስ ኦዋዳን፥<note caller="+" style="f"><char style="fr" closed="false">9:54 </char><char style="fq" closed="false">ኤላስ ኦዋዳን፦ </char><char style="ft" closed="false">እት እት ጌሻ ማጻፋ ብለን፥ “ሀ አሳ ዉርሳናዉ” ያጌ።</char></note> ታማይ ሳሉዋፐ ዪደ ኡንቱንታ ማናዳን ጼሳና ማላ ኮያይ?” ያጌድኖ።<verse eid="LUK 9:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 9:55"/>ሽን የሱስ ጉየ ስሚደ፥ ኡንቱንታ ሴሬዳ።<note caller="+" style="f"><char style="fr" closed="false">9:55 </char><char style="fk" closed="false">ኡንቱንታ ሴሬዳ፦ </char><char style="ft" closed="false">እት እት ጌሻ ማጻፋን ደእያ ብለይ፥ “ኔን አይ ማላ አያነንቶ፥ ኔና ኤርኪ? አሳ ናአይ አሳ ሸምፑዋ አሻናዉ ዬዳፐ አትን፥ ባይዛናዉ ይቤና” ያጌ።</char></note> <verse eid="LUK 9:55"/><verse number="56" style="v" sid="LUK 9:56"/>“ታን፥ አሳ ናአይ፥ አሳ ሸምፑዋ አሻናዉ ዮዋፐ አትን፥ ባይዛናዉ ያበይከ” ያጌዳ። ኡንቱንቱ ሀራሳን ደእያ ቄር ካታማ ቤድኖ።<verse eid="LUK 9:56"/></para>
  <para style="s1">የሱሳ ካልያዋንታ ጋክያ ፓጭያ</para>
  <para style="r">(<ref loc="MAT 8:19-22">ማቶሳ 8:19-22</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57"/>ኡንቱንቱ ኦግያና ቢሽን፥ እት ብታኒ የሱሳ፥ “ጎዳዉ፥ ኔን ብያሳ ኡባ ታን ኔና ካላና” ያጌዳ።<verse eid="LUK 9:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58"/>የሱስ አ፥ “ዎራካናቶ ኦላይ፥ ሳሉዋ ካፋቶካ ጎሊ ደኤ፤ ሽን ታን፥ አሳ ናአይ፥ ገላ ሸምፓ አክያ ሳአይ ታዉ ባዋ” ያጌዳ።<verse eid="LUK 9:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59"/>የሱስ ሀራ ኡራ፥ “ታና ካላ” ያጌዳ።</para>
  <para style="p" vid="LUK 9:59">ሽን፥ ብታኒ፥ “ጎዳዉ፥ ታን ካስያን ባደ ታ አባ ሞጋና” ያጌዳ።<verse eid="LUK 9:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60"/>የሱስ፥ “ሀይቆዋንታ ባረንቱ ሀይቆዋንቱ ሞግኖ፤ ኔን ባደ፥ ጾሳ ካዉተባ ኦዳ” ያጌዳ።<verse eid="LUK 9:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61"/>ቃይ ሀራ ብታኒ፥ “ጎዳዉ፥ ታን ኔና ካላና፤ ሽን ኮይሩዋን ታ ሶይ አሳ ባደ ሳሮታና” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">9:61 </char><char style="xt" closed="false"><ref loc="1KI 19:20">1 ካታ. 19:20</ref></char></note><verse eid="LUK 9:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62"/>ሽን የሱስ አ፥ “ቦራ ጎሻናዉ ዶሞዌ ኦንነ ጉየ ጼሎፐ ጾሳ ካዉተዉ በሰና” ያጌዳ።<verse eid="LUK 9:62"/></para>
  <chapter eid="LUK 9"/>
  <chapter number="10" style="c" sid="LUK 10"/>
  <para style="s1">ምሽራቹዋ ቃላዉ ኪተቴዳ አሳቱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1"/>ሀዋፐ ካላ ጎዳይ ሀራ ላፑን ታሙ<note caller="+" style="f"><char style="fr" closed="false">10:1 </char><char style="fk" closed="false">ላፑን ታሙ፦ </char><char style="ft" closed="false">እት እት ጌሻ ማጻፋ ብለን፥ “ላፑን ታማነ ላአ”። አይሁዳ ዎጋን ቢታ ቦላን ደእያ አሳ ዘረይ ላፑን ታማ። ሽን ካሰ ኤጫ ግሪከ ማጻፋ ብለን ደእያዌ፥ “ላፑን ታማነ ላአ”። ኦን ኤር የሱስ ባረ ቃላ አላምያ ዩሹዋን ጋናዉ ሀ ፓይዱዋና ቃራ አሳ ሱንደ ኪተናን አገና ያግያ ቆፋይ ደኤ።</char></note> አሳ ሱንደ ላኡዋ ላኡዋ ኦደ እ ባናዉ ደእያ ካታማ ኡባ ኪቴዳ። <verse eid="LUK 10:1"/><verse number="2" style="v" sid="LUK 10:2"/>የሱስ ኡንቱንታ፥<note caller="-" style="x"><char style="xo" closed="false">10:2 </char><char style="xt" closed="false"><ref loc="MAT 9:37">ማቶሳ 9:37</ref>፣ <ref loc="MAT 9:38">38</ref></char></note></para>
  <para style="p" vid="LUK 10:2">“ቆይቻዉ ጋኬዳ ካይ ዳራ፤ ኪተትያ አሳይ ጉ። ስም ቆይጨትያ ካ ጎዳይ፥ ቆይቻዉ ኪተትያዋንታ የዳና ማላ ዎስተ። <verse eid="LUK 10:2"/><verse number="3" style="v" sid="LUK 10:3"/>ታን ዶርሳቱዋዳን ዋላቱዋ ግዶ ህንተና ኪታይ፥ ቢተ።<note caller="-" style="x"><char style="xo" closed="false">10:3 </char><char style="xt" closed="false"><ref loc="MAT 10:16">ማቶሳ 10:16</ref></char></note> <verse eid="LUK 10:3"/><verse number="4" style="v" sid="LUK 10:4"/>ህንተንቱ ኦገዉ አያነ ኦይቆፕተ: ቦርሳ፥ ቃርጪትያ፥ ጫማ፥ ግድናካ ኦይቆፕተ፤ አሳና ሳሮተቲደ ኦግያን ዎድያ ዉርሶፕተ።<note caller="+" style="f"><char style="fr" closed="false">10:4 </char><char style="fk" closed="false">አሳና ሳሮተቲደ ኦግያን ዎድያ ዉርሶፕተ፦ </char><char style="ft" closed="false">ሄ ጋላሳን ጋራተን ኦያ ሳሮታይ ዎድያ ሎይ ምያ ድራዉ፥ ሀዌ ሃሳየቴዳ።</char></note><note caller="-" style="x"><char style="xo" closed="false">10:4-11 </char><char style="xt" closed="false"><ref loc="MAT 10:7-14">ማቶሳ 10:7-14</ref>፤ <ref loc="MRK 6:8-11">ማር. 6:8-11</ref>፤ <ref loc="LUK 9:3-5">ሉቃሳ 9:3-5</ref></char></note><verse eid="LUK 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 10:5"/>“ህንተንቱ ገልያ ጎለ ኡባ ካስያን፥ ‘ሳሮተይ ሀ ጎለዉ ግዶ’ ያግተ። <verse eid="LUK 10:5"/><verse number="6" style="v" sid="LUK 10:6"/>ሄ ጎልያን ሳሮተ ዶስያ አሳይ ደኦፐ፥ ህንተንቱ ሳሮታይ ሄ ጎልያን አቃናዋ፤ ኮየናዋ ግዶፐ፥ ህንተንቱ ሳሮታይ ህንተንቶ ስማናዋ። <verse eid="LUK 10:6"/><verse number="7" style="v" sid="LUK 10:7"/>ሄ ጎልያን ኡንቱንቶ ደእያዋፐ ሚድነ ኡሺደ ደእሽተ፤ ኦሳንቻዉ አ ድርጉዋ ጭጋይ ኮሼ፤ እት ጎልያፐ ሀራ ጎልያ ዩዮፕተ።<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="1CO 9:14">1 ቆሮ. 9:14</ref>፤ <ref loc="1TI 5:18">1 ጽሞ. 5:18</ref></char></note><verse eid="LUK 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 10:8"/>“አይ ካታማነ ህንተንቱ ገልያ ዎደ፥ አሳይ ህንተና ሞክ አኪደ ምዛናዉ ሺሾዋ አያነ ሚተ። <verse eid="LUK 10:8"/><verse number="9" style="v" sid="LUK 10:9"/>ሄ ካታማትን ደእያ ሀርጋንቻቱዋ ፓደ አሳዉ፥ ‘ጾሳ ካዉተይ ህንተኮ ማቴዳ’<note caller="+" style="f"><char style="fr" closed="false">10:9 </char><char style="fq" closed="false">ጾሳ ካዉተይ ህንተኮ ማቴዳ፦ </char><char style="ft" closed="false">ሀዋ ጉሳይ፥ “ጾሳ ካዉተይ ሀዋን ዎይ ህንተንቱ ግዶን ደኤ” ጉሳ።</char></note> ያጊደ ኦድተ። <verse eid="LUK 10:9"/><verse number="10" style="v" sid="LUK 10:10"/>የዉዋን ቃይ አይ ካታማነ ገሎደ፥ አሳይ ህንተንታ ሞክ አከናዋንታ ግዶፐ ሄ ካታማ ቃአኮ ከስኔ፥ <verse eid="LUK 10:10"/><verse number="11" style="v" sid="LUK 10:11"/>‘ኑን ህንተና ዬላያናዉ፥ ሀራይ አቶ ኑ ገድያ ቦላን ደእያ ህንተንቱ ካታማ ባናካ ህንተንቶ ቆቆፌቶ<note caller="+" style="f"><char style="fr" closed="false">10:11 </char><char style="fk" closed="false">ባናካ ህንተንቶ ቆቆፌቶ፦ </char><char style="ft" closed="false">ሀዋ ጉሳይ፥ እጹዋ በስያዋ።</char></note>፤ የዉዋን ቃይ፥ ጾሳ ካዉተይ ህንተንቱኮ ማቴዳዋ ኤርተ’ ያግተ።<note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="ACT 13:51">ኪታ 13:51</ref></char></note> <verse eid="LUK 10:11"/><verse number="12" style="v" sid="LUK 10:12"/>ፕርዳ ጋላስ ሀ ካታማትፐ ሶዶማ ካታማ ጋኬዳ ሙራይ ካዉሻናዋ ያጋደ ታን ህንተዉ ኦዳይ።<note caller="-" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="GEN 19:24-28">ዶመ 19:24-28</ref>፤ <ref loc="MAT 10:15">ማቶሳ 10:15</ref>፤ <ref loc="MAT 11:24">11:24</ref></char></note><verse eid="LUK 10:12"/></para>
  <para style="s1">አማነናን እጼዳ ካታማቱዋ</para>
  <para style="r">(<ref loc="MAT 11:20-24">ማቶሳ 11:20-24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13"/>“አየ ነዉ ኮራዚነ፤ አየ ነዉ ቤተሳይደ፤ ህንተንቱን ሀኔዳ ማላታቱ ጺሮሳ ካታማንነ ሲዶና ካታማን ሀኔደንቶ፥ ሄዋን ደእያ አሳቱ ካዩዋ ማዩዋ ማዪደ፥ ብድን ቦላን ኡቲደ፥ በንፐ ባረንቱ ናጋራፐ ስማናዋንታሽን። <verse eid="LUK 10:13"/><verse number="14" style="v" sid="LUK 10:14"/>ሀዋ ድራዉ፥ ሙረትያ ጋላስ ህንተንቱፐ አደ ጺሮሳ ካታማዉነ ሲዶና ካታማዉ ሙራይ ካዉሻናዋ። <verse eid="LUK 10:14"/><verse number="15" style="v" sid="LUK 10:15"/>ሀነ ቅፍርናሆመ፥ ኔን ሳሉዋ ፑደ ቁ ጋናዉ ኮያድ? ዱገ ስኦልያ ዎናሳ።<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="ISA 14:13-15">ኢሳ. 14:13-15</ref></char></note><verse eid="LUK 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16"/>“ህንተንቱ ግያዋ ስስያ አሳይ፥ ታን ግያዋ ስሴ፤ ህንተንታ እጽያ ኡራይ ታና እጼ፤ ታና እጽያ ኡራይ ታና ኪቴዳዋካ እጼ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="MAT 10:40">ማቶሳ 10:40</ref>፤ <ref loc="MRK 9:37">ማር. 9:37</ref>፤ <ref loc="LUK 9:48">ሉቃሳ 9:48</ref>፤ <ref loc="JHN 13:20">ዮሃ. 13:20</ref></char></note><verse eid="LUK 10:16"/></para>
  <para style="s1">አ ካልያዋንቱ ኪተቴዳሳፐ ስሜድኖ</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17"/>ላፑን ታሙ አሳቱካ፥ “ጎዳዉ፥ ኢታ አያናቱካ ነ ሱንን ኑዉ አዛዘቴድኖ” ያጊደ ናሸቻን ስሜድኖ።<verse eid="LUK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18"/>የሱስካ ኡንቱንቶ፥ “ሴጻናይ ዋልቃንዳን ሳሉዋፐ ዎሽን በኣድ። <verse eid="LUK 10:18"/><verse number="19" style="v" sid="LUK 10:19"/>ስም ሾሻነ ሶጉዋ የናዳን ህንተንቱ ሞርክያ ጻላህያ ዎልቃ ጾናና ማላ ማታ እማድ። ህንተንታ ቆሀናዌ አይኔካ ደኤና። <verse eid="LUK 10:19"/><verse number="20" style="v" sid="LUK 10:20"/>ግዶፐ አትን ህንተንቱ ሱንይ ሳሉዋ ማዝጎብያን ጻፈቶ ድራዉ፥ ናሸትተፐ አትን ኢታ አያናቱ አዛዘቶ ድራዉ ናሸቶፕተ” ያጌዳ። <figure style="fig" alt="Scorpion" file="BK00058B.TIF" size="col" ref="10:19">ሶጉዋ</figure><verse eid="LUK 10:20"/></para>
  <para style="s1">የሱስ ባረ ናሸቻ ቆንጭሴዳ</para>
  <para style="r">(<ref loc="MAT 11:25-27">ማቶሳ 11:25-27</ref>፤ <ref loc="MAT 16:13-17">16:13-17</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21"/>ሄ ዎድያን የሱስ አያና ጌሻን ዳሮ ናሸቲደ፥ “ሳሉዋነ ሳኣ ጎዳዉ፥ ኔን ሀ የዉዋ ታማሮዋንቱፐነ አ ኤራንቻቱዋፐ ገንደ፥ ቄር ናናዉ ቆንጭሶ ድራዉ፥ ኔና ጋላታይ፤ ኤ፥ ታ አቦ፥ አያዉ ጎፐ፥ ሀዋ ኦናዉ ነ ሎኦ ሸነ ግዴዳ።<verse eid="LUK 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22"/>“ኡባ የዉ ታዉ ታ አቡፐ እመቴዳ። ናአይ ኦነንቶ አዉዋፐ አትሽን ኦንነ ኤርያዌ ባዋ፤ ሄዋዳንካ አዉ ኦነንቶ ናኣፐነ እ ቆንጭሳናዉ ኮዮ ኡራፐ አትን፥ ሀራይ ኦንነ ኤርያዌ ባዋ” ያጌዳ።<verse eid="LUK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23"/>ካሊደካ የሱስ ባረና ካልያዋንቱኮ ስም ዎደ፥ ኡንቱንቱ ጻላላ፥ “ህንተንቱ በእያዋ ጼልያ አይፋቱ አንጀቴዳዋንታ። <verse eid="LUK 10:23"/><verse number="24" style="v" sid="LUK 10:24"/>ታ ህንተዉ ኦድያዌ አዬ ጎፐ፥ ጮራ ናባቱነ ካታቱ ህንተንቱ በእያዋ በአናዉ አሞቴድኖሽን በእበይክኖ፤ ህንተንቱ ስስያዋካ ስሳናዉ አሞቴድኖ፤ ሽን ስስበይክኖ” ያጌዳ።<verse eid="LUK 10:24"/></para>
  <para style="s1">አሳዉ ቃረትያ ሳማርያ ብታንያ</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25"/>እት ጋላስ ህግያ ኤርያዌ እቱ የሱሳ ፓጫናዉ አኮ ዪደ፥ “ታማርስያዎ፥ መና ደኡዋ ላታናዉ፥ ታን አያ ኦ?” ያግ ኦቼዳ።<verse eid="LUK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26"/>የሱስ ዛሪደ፥ “ሙሴ ህግያ ማጻፋን ጻፈቶዌ አዬ? ኔን አያ ጋደ ብላይ?” ያጌዳ።<verse eid="LUK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27"/>ብታኒካ፥ “ሙሴ ህግያ ማጻፋይ፥ ‘ጾሳ ነ ጎዳ ፖሎ ነ ዎዛናፐ፥ ፖሎ ነ ሸምፑዋፐ፥ ፖሎ ነ ዎልቃፐነ ፖሎ ነ ቆፋፐ ሲቃ፤ ሄዋዳንካ ነ ላገካ ነ ሁጲያዳን ዶሳ’ ጌ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">10:27 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ዎጋ 19:18</ref>፤ <ref loc="DEU 6:5">ዛረ. 6:5</ref></char></note><verse eid="LUK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28"/>የሱስ አ፥ “ልከ፥ ቱሙዋ ጋዳ፤ ስም ኔንካ ሀዋ ኦ፤ ደኡዋን ደአናሳ” ያጌዳ።<verse eid="LUK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29"/>ሙሴ ህግያ ታማርስያ ብታኒ ቃይ ባረና ጽሎ ኦናዉ ኮዪደ የሱሳ፥ “ሀኖሽን፥ ታ ላገይ ኦኔ?” ያጊደ ኦቼዳ።<verse eid="LUK 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30"/>የሱስ ዛሪደ፥ “እት ብታኒ የሩሳላመፐ እያርኮ ቢደ ደእሽን፥ ኦግያ ቦላን ፓናቱ አ ደሚደ፥ አ ማዩዋ ቃሮዋፐ ጉየ ሾጪደ፥ ሀይቃናዉ ፖሉ ጎደ ኦሊደ ቤድኖ። <verse eid="LUK 10:30"/><verse number="31" style="v" sid="LUK 10:31"/>ቆፐናን እት ቄሳይ ሄ ኦግያና ብደእያዌ፥ ሾጨቲደ ኩንዴዳ ብታንያ በኤዳ ዎደ፥ አያነ ኦናን ምይያና አደ ቤዳ። <verse eid="LUK 10:31"/><verse number="32" style="v" sid="LUK 10:32"/>ሄዋዳንካ እት ሌዊ ሄ ኦግያና ብደኤ። እካ ብታንያ በኢደ፥ ምየት አዳ። <verse eid="LUK 10:32"/><verse number="33" style="v" sid="LUK 10:33"/>ሽን ሳማርያ አሳ ግዴዳ እት ብታኒ፥ ሄ ባጋና አደ፥ ሀ ብታንያኮ ዬዳ። አ በኤዳ ዎደ አዉ ቃረቴዳ።<note caller="-" style="x"><char style="xo" closed="false">10:33፣ 34 </char><char style="xt" closed="false"><ref loc="2CH 28:15">2 ኦዱዋ 28:15</ref></char></note> <verse eid="LUK 10:33"/><verse number="34" style="v" sid="LUK 10:34"/>አኮካ ሺቂደ፥ ዛይትያነ ዎይንያ ኤሳ<note caller="+" style="f"><char style="fr" closed="false">10:34 </char><char style="fk" closed="false">ዛይትያነ ዎይንያ ኤሳ፦ </char><char style="ft" closed="false">ኦራ ጫቁዋ ዎድያን ሀዋንቱ ልያዋንታ ጌተቲደ አከቲኖ። ኡባ ሀዋን ጻፈቴዳ ዛይቲ፥ ኦራ ልያ ማላታ ጌተቴ። ያይ። 5:14 ጼልተ።</char></note> አ ማይን ትጊደ፥ ቃቼዳ። ሄዋፐ ጉየ ባረ ሀርያ ቶግሲደ፥ እማይ አቅያ ጎልያ አክ ቤዳ፤ ሄዋን ብዪደ ናጌዳ። <verse eid="LUK 10:34"/><verse number="35" style="v" sid="LUK 10:35"/>ዎንተ ጋላስ ጉ ብራ ባረ ኪስያፐ ከሲደ፥ እማይ አቅያ ጎልያ ጎዳዉ እሚደ፥ ‘ሀ ብታንያ ታዉ ሎይ ብያ፤ ሀዋፐ ዳሩዋ ኔን ከሶፐካ፥ ታን ስምያ ዎደ ነዉ ጭጋና’ ያጌዳ።<verse eid="LUK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36"/>“ስም ሀ ሄዙ አሳቱዋፐ፥ ፓናቱዋ ኩሽያን ሾጨቲደ ኩንዴዳ ብታነዉ፥ ላገ ግዴዳዌ ሀቃዋ ማላቲ?” ያጌዳ።<verse eid="LUK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37"/>ህግያ ታማርስያዌካ፥ “ሄ አዉ ቃረቶዋ” ያጌዳ።</para>
  <para style="p" vid="LUK 10:37">የሱስካ አ፥ “ስም ባደ ኔንካ ሄዋዳን ኦ” ያጌዳ።<verse eid="LUK 10:37"/></para>
  <para style="s1">የሱስ ማርትነ ማይራም ሶይ ቤዳ</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38"/>የሱስ ባረና ካልያዋንቱና ኦግያ ቢደ፥ እት ሄራ ጋርሳ ጋኬዳ። ሄዋን ማርቶ ጌተትያ እት ምሽራታ ባረ ጎለን ሞካዱ።<note caller="-" style="x"><char style="xo" closed="false">10:38፣ 39 </char><char style="xt" closed="false"><ref loc="JHN 11:1">ዮሃ. 11:1</ref></char></note> <verse eid="LUK 10:38"/><verse number="39" style="v" sid="LUK 10:39"/>እዝዉካ ማይራሞ ጌተትያ ምቻታ ደአዉ፤ ሄናካ የሱሳ ገድያ ማታን ኡታደ፥ እ ኦድያዋ ሀይዛደ ደአዉ። <verse eid="LUK 10:39"/><verse number="40" style="v" sid="LUK 10:40"/>ማርታ ቃይ ሶይባ ጊግሳደ ዳቡራ ደአዉ፤ ሄዋ ድራዉ የሱሳኮ ሺቃደ፥ “ሀና ታ ምቻታ፥ ኪታ ኡባ ታ ቦላ ኦልና፥ ታን ታረካ ላባኖደ ጼላደ ጮኡ ጋይ? ሀያና ታና ማዳናዳን እዝዉ ኦዳ” ያጋዱ።<verse eid="LUK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41"/>የሱስካ ዛሪደ እዞ፥ “ማርቴ፥ ማርቴ፥ ኔን ጮራ የዉዋ ቆፓደ ህርጋ፤ ቃይካ መቶታ። <verse eid="LUK 10:41"/><verse number="42" style="v" sid="LUK 10:42"/>ሽን ኮሽያዌ እትባ፤ ማይራማ ባረፐ ኦንነ አከና ሎኦባ ዶራዱ” ያጌዳ።<verse eid="LUK 10:42"/></para>
  <chapter eid="LUK 10"/>
  <chapter number="11" style="c" sid="LUK 11"/>
  <para style="s1">የሱስ ዎሳባ ታማርሴዳ</para>
  <para style="r">(<ref loc="MAT 6:9-13">ማቶሳ 6:9-13</ref>፤ <ref loc="MAT 7:7-11">7:7-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1"/>እት ጋላስ የሱስ እትሳን ዎሳ ዎስ ደኤ። ዎሳ ዉርሶዋፐ ጉየ አ ካልያዋንቱፐ እቱ፥ “ጎዳዉ! ዮሃንስ ባረና ካልያዋንታ ዎሳ ታማርሶዋዳን፥ ኑናካ ኔን ዋግ ዎሳነንቶ ታማርሳ” ያጌዳ።<verse eid="LUK 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2"/>እካ ኡንቱንታ፥ “ጾሳ ዎሲደ ያግ ዎስተ:</para>
  <para style="q1" vid="LUK 11:2">“ ‘ሳሉዋን ደእያ ኑ አቦ፥</para>
  <para style="q2" vid="LUK 11:2">ነ ሱንይ አንጀቶ፤</para>
  <para style="q2" vid="LUK 11:2">ነ ካዉተይ ዮ፤</para>
  <para style="q2" vid="LUK 11:2">ነ ሸኒ ሳሉዋን ሀኖዋዳን ሳንካ ሀኖ፤<verse eid="LUK 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3"/>ጋላሳን ጋላሳን ኮሽያ ቁማ፥</para>
  <para style="q2" vid="LUK 11:3">ኑዉ ሀቼ እማ፤<verse eid="LUK 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4"/>ኑን ኑና ናቄዳዋንቱዋ፥</para>
  <para style="q2" vid="LUK 11:4">ኡባ አቶ ጎዋዳን፥</para>
  <para style="q2" vid="LUK 11:4">ኔንካ ኑ ናቁዋ አቶ ያጋ፤</para>
  <para style="q2" vid="LUK 11:4">ኑና ኢታፐ ናጋፐ አትን፥</para>
  <para style="q2" vid="LUK 11:4">ፓጭያን ገልሶፓ’</para>
  <para style="m" vid="LUK 11:4">ያግተ” ያጌዳ።<verse eid="LUK 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5"/>ቃይካ የሱስ ባረና ካልያዋንታ፥ “ህንተንቱፐ እቶ ሲቆ ላጊ ደእንቶ ግዶ ብላህያን አኮ ዪደ፥ ‘ታ ሲቆ ላገዉ፥ ታዉ ሄዙ ሶሉዋ ታልአ፤ <verse eid="LUK 11:5"/><verse number="6" style="v" sid="LUK 11:6"/>አያዉ ጎፐ፥ እት ታ ላገይ ዪና አ ምዝያዋ ያድ’ ያግ ዎሴዳ ጎይተ። <verse eid="LUK 11:6"/><verse number="7" style="v" sid="LUK 11:7"/>ባረ ጎለን ደእያ አ ሲቆ ላጊ ሶይፐ ሃሳዪደ፥ ‘ታና መቶፓ፤ ፐንጊ ቃሸቴዳ፤ ታናናይካ ታናና ግሴድኖ፤ ሄዋ ድራዉ ታን ደንዳደ ነዉ አይነ እማናዉ ዳንዳይከ’ ጋናዌ? <verse eid="LUK 11:7"/><verse number="8" style="v" sid="LUK 11:8"/>ታን ህንተንቶ ኦድያዌ አዬ ጎፐ፥ እ አዉ ሲቆ ላግያ ግዶ ድራዉ፥ እመነንቶኔካ ኡንኤ ድራዉ እ ኮይያዋ ኡባ እሜ። <verse eid="LUK 11:8"/><verse number="9" style="v" sid="LUK 11:9"/>ሀዋ ድራዉ፥ ‘ዎስተ፥ ህንተንቶካ እመታናዋ፤ ኮይተ፥ ደማንታ፤ ካርያ ዪደ ጼስተ፥ ህንተንቶ ዶየታናዋ’ ያጋይ። <verse eid="LUK 11:9"/><verse number="10" style="v" sid="LUK 11:10"/>ጋሱካ፥ ዎስያ ኡባይ አካናዋ፤ ኮይያ ኡራይካ ደማናዋ፤ ካርያ ዪደ ጼስያ ኡራዉ፥ ፐንጊ ዶየታናዋ።<verse eid="LUK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 11:11"/>“ህንተንቱ ግዶፐ ባረ ናአዉ፥ ሞልያ ዎስና ሾሻ፥ ቁማ እማ ጊና ሹቻ እምያ አዉ ደኢ? <verse eid="LUK 11:11"/><verse number="12" style="v" sid="LUK 11:12"/>ዎይ ቁቁልያ ዎስና ሶጉዋ እምዬ? <verse eid="LUK 11:12"/><verse number="13" style="v" sid="LUK 11:13"/>ህንተንቱ ኢታ ግድ ደኢደ ህንተንቱ ናናዉ ሎኦባ እምያዋ ኤሮፐ፥ ያትና ሳሉዋን ደእያ ህንተንቱ አዉ ባረና ዎስያዋንቶ አያና ጌሻ ዎት ዳርሲደ እማንዴሻ?” ያጌዳ።<verse eid="LUK 11:13"/></para>
  <para style="s1">የሱሳነ ብኤል-ዘቡላ</para>
  <para style="r">(<ref loc="MAT 12:22-30">ማቶሳ 12:22-30</ref>፤ <ref loc="MRK 3:20-27">ማር. 3:20-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14"/>እት ጋላስ የሱስ እት ብታንያፐ ዱድስያ አያና ከሶዋፐ ጉየ ዱደ ብታኒ ሃሳያ ዶምና፥ አሳይ ማላለቴዳ። <verse eid="LUK 11:14"/><verse number="15" style="v" sid="LUK 11:15"/>ሽን ኡንቱንቱፐ እቱ እቱ፥ “ጋሌናቱዋ ካፑዋ ብኤል-ዘቡል አዉ ዎልቃ እምና ጋሌናቱዋ ከሴ” ያጌድኖ።<note caller="-" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቶሳ 9:34</ref>፤ <ref loc="MAT 10:25">10:25</ref></char></note><verse eid="LUK 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 11:16"/>እቱ እቱ ቃይ የሱሳ ፓጫናዉ ሳሉዋፐ ማላታ በሳናዳን አፐ ኮዬድኖ።<note caller="-" style="x"><char style="xo" closed="false">11:16 </char><char style="xt" closed="false"><ref loc="MAT 12:38">ማቶሳ 12:38</ref>፤ <ref loc="MAT 16:1">16:1</ref>፤ <ref loc="MRK 8:11">ማር. 8:11</ref></char></note> <verse eid="LUK 11:16"/><verse number="17" style="v" sid="LUK 11:17"/>ሽን የሱስካ ኡንቱንቱ ቆፋ ኤሪደ ኡንቱንታ ሀዋ ያጌዳ: “ባረ ግዶን ሻከትያ ካዉተይ ኡባይ ያናዋ፤ ሻከትያ ጎሊካ ኩንዴ። <verse eid="LUK 11:17"/><verse number="18" style="v" sid="LUK 11:18"/>ያትና ሴጻና ካዉተይ ባረ ግዶን ሻከቶፐ አ ካዉተይ ዎት ኤቃናዌ? ህንተንቱ ታና፥ ‘ጻላህያ ካፑዋ ብኤል-ዘቡል ነዉ ዎልቃ እምና ከሳ’ ያግ ሃሳዪታ። <verse eid="LUK 11:18"/><verse number="19" style="v" sid="LUK 11:19"/>ስም ታን ብኤል-ዘቡላ ዎልቃን ጋሌናቱዋ ከስያዋ ግዶፐ ህንተንቱ ናናይ ኦ ዎልቃን ከሳናዋንቴ? ሀዋ ግድያ ድራዉ፥ ኡንቱንቱ ህንተንቱ ቦላን ፕርድያዋንታ ግዳናዋንታ። <verse eid="LUK 11:19"/><verse number="20" style="v" sid="LUK 11:20"/>ሽን ታን ጋሌናቱዋ ከስያዌ ጾሳ ዎልቃና ግዶፐ፥ ስም ጾሳ ካዉተይ ህንተንቱኮ ዬዳዋ ኤርተ።<verse eid="LUK 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21"/>“ዎልቃማ አሳይ በስያዋዳን ምኒደ ባረ ጎልያ ናጎፐ፥ አ ሻሉ ሎይ ናገታናዋ። <verse eid="LUK 11:21"/><verse number="22" style="v" sid="LUK 11:22"/>የዉዋን ቃይ አፐ ምኑዋ ዳርያዌ ዪደ አ ቆሆፐነ ጾኖፐ እ አማነቴዳ ቶራነ ጎንዳልያ አፐ ዎ አኪደ፥ አዉ ደእያ ሚሻ ግሸት አኬ።<verse eid="LUK 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23"/>“ታ ባጋ ግደናዌ ታናና ኤቀቴ፤ ታናና ሺሽ ቤናዌካ ላሌ።<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="MRK 9:40">ማር. 9:40</ref></char></note><verse eid="LUK 11:23"/></para>
  <para style="s1">ቱና አያናይ ካሰ የግ ቤዳ አሳኮ ስሚደ ይያ ጋሱዋ</para>
  <para style="r">(<ref loc="MAT 12:43-45">ማቶሳ 12:43-45</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24"/>“ቱና አያናይ አሳፐ ከሴዳ ዎደ፥ ባረዉ ሸምፕያ ሳ ኮዪደ፥ ሃይ ባንታሳና አ ቤ። ሸምፕያ ሳ ደመናን አቶፐ፥ ‘ታን ካሰ የጋ ከሴዳ ታ ጎልያ ስማና’ ያጌ፤ <verse eid="LUK 11:24"/><verse number="25" style="v" sid="LUK 11:25"/>ስምያ ዎደካ ጎሊ ፕተቲደ ጊጎዋ ደሜ። <verse eid="LUK 11:25"/><verse number="26" style="v" sid="LUK 11:26"/>ሄዋፐ ካላ፥ ቢደ ሀራ አፐ ኢታ ላፑ ቱና አያናቱዋ አክ ያ ገሊደ፥ ሄዋን ደኢኖ፤ ሄ ብታንያ ደኡ ኮይሮዋፐ ካላዌ ኢቶዋ ግዴ” ያጌዳ።<verse eid="LUK 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27"/>የሱስ ሀዋ ሃሳይ ደእሽን፥ እት ምሽራታ ጮራ አሳ ግዶፐ ባረ ኮሻ ቁ ኦደ፥ “ኔና የሌዳዉናነ ንዳ ነ ዳያ አንጀቴዳዉኖ” ያጋዱ። <verse eid="LUK 11:27"/><verse number="28" style="v" sid="LUK 11:28"/>የሱስ ቃይ፥ “አንጀቴዳዋንቱ ጾሳ ቃላ ስሲደ አዛዘትያዋንታ” ያግ ዛሬዳ።<verse eid="LUK 11:28"/></para>
  <para style="s1">ጾሳፐ ኦሰቶ ማላታ</para>
  <para style="r">(<ref loc="MAT 12:38-42">ማቶሳ 12:38-42</ref>፤ <ref loc="MRK 8:12">ማር. 8:12</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29"/>ጮራ አሳይ ሺቆ ዎደ የሱስ፥ “ሀ የለታይ ኢታ፤ ኦራ ማላታ ኮዬ፤ ሽን ናብያ ዮናሳ ማላታፐ ሀራይ እመተና።<note caller="-" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="MAT 16:4">ማቶሳ 16:4</ref>፤ <ref loc="MRK 8:12">ማር. 8:12</ref></char></note> <verse eid="LUK 11:29"/><verse number="30" style="v" sid="LUK 11:30"/>ጋሱካ ዮናስ ነነዌ ካታማ አሳዉ ማላታ ግዶዋዳን፥ ታን፥ አሳ ናአይካ፥ ሀ የለታዉ ማላታ ግዳና።<note caller="-" style="x"><char style="xo" closed="false">11:30 </char><char style="xt" closed="false"><ref loc="JON 3:4">ዮናሳ 3:4</ref></char></note> <verse eid="LUK 11:30"/><verse number="31" style="v" sid="LUK 11:31"/>አዋይ ሞክያሳ ጼልያ ዎደ፥ ኡሸቻ ዱገ ባጋና ደእያ ጋድያ ካታታ ሶሎሞነዉ ደእያ አ ኤራተ ስሳናዉ ቢታ ጋጻፐ ዬዳ ድራዉ፥ ፕርዳ ዎደ ሀ የለታን ደንዳደ ፕርዳናዉኑ፤ በእተ፥ ሶሎሞነፐካ አያዌ ሀዋን ደኤ።<note caller="-" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1 ካታ. 10:1-10</ref>፤ <ref loc="2CH 9:1-12">2 ኦዱዋ 9:1-12</ref></char></note> <verse eid="LUK 11:31"/><verse number="32" style="v" sid="LUK 11:32"/>ነነዌ አሳይ ፕርዳ ዎደ ህንተንቱ ቦላ ደንዲደ ፕርዳናዋንታ፤ አያዉ ጎፐ፥ ኡንቱንቱ ዮናስ ኦዶዋ ስሲደ ባረንቱ ናጋራ ፓጽ ስሜዳ ድራሳ፤ በእተ፥ ዮናሳፐ አያዌ ሀዋን ደኤ።<note caller="-" style="x"><char style="xo" closed="false">11:32 </char><char style="xt" closed="false"><ref loc="JON 3:5">ዮናሳ 3:5</ref></char></note><verse eid="LUK 11:32"/></para>
  <para style="s1">ቦላ ፖእስያ ጾምፕያ</para>
  <para style="r">(<ref loc="MAT 5:15">ማቶሳ 5:15</ref>፤ <ref loc="MAT 6:22-23">6:22-23</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33"/>“ሶይ ገልያ አሳዉ ፖአናዳን፥ ጾምፕያ ጾምፒደ ቃሳን ዎናፐ አትን፥ ጌማሳን ዎይ ፖኡዋ ካምያ የዉዋፐ ጋርሳና ዎያዌ ኦንነ ባዋ።<note caller="-" style="x"><char style="xo" closed="false">11:33 </char><char style="xt" closed="false"><ref loc="MAT 5:15">ማቶሳ 5:15</ref>፤ <ref loc="MRK 4:21">ማር. 4:21</ref>፤ <ref loc="LUK 8:16">ሉቃሳ 8:16</ref></char></note> <verse eid="LUK 11:33"/><verse number="34" style="v" sid="LUK 11:34"/>ነ አሳተዉ ነ አይፊ ጾምፕያ ማላ፤ ነ አይፊ ፓጻ ግዶፐ ነ ኩመን አሳተይካ ፖኡዋ ደሜ፤ ሽን ነ አይፊ ሀርጎፐ ነ ኩመን አሳተይካ ማ። <verse eid="LUK 11:34"/><verse number="35" style="v" sid="LUK 11:35"/>አኬካ፤ ሄዋ ግድያ ድራዉ፥ ነ ጋርሳን ደእያ ፖኡ መናዳን ናገታ። <verse eid="LUK 11:35"/><verse number="36" style="v" sid="LUK 11:36"/>ስም ነ አሳተይ ኡባይ ፖኡዋን ኩሜዳዋ ግዶፐነ፥ ሜዳ አሳተይ ኔናን ባይናዋ ግዶፐ፥ ነ አሳተይ ኡባይ፥ ጾምፒ ባረ ፖኡዋ ነ ቦላን ፖእስያዋዳን፥ ነ ቦላን ዋጋጋ ፖኡዋ ግዳናዋ” ያጌዳ።<verse eid="LUK 11:36"/></para>
  <para style="s1">የሱስ ፓርሳዋቱዋነ ሙሴ ህግያ ታማርስያዋንታ ኩናኔዳ</para>
  <para style="r">(<ref loc="MAT 23:1-36">ማቶሳ 23:1-36</ref>፤ <ref loc="MRK 12:38-40">ማር. 12:38-40</ref>፤ <ref loc="LUK 20:45-47">ሉቃሳ 20:45-47</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37"/>የሱስ ሃሳያ ዉርሶዋፐ ካላ፥ እት ፓርሳዌ ብታኒ ባረ ጎለን ቁማ ማናዳን አታሌዳ፤ የሱስካ እትፐ ገሊደ ጋይታን ኡቴዳ።<note caller="+" style="f"><char style="fr" closed="false">11:37</char><char style="fk" closed="false">ጋይታን ኡቴዳ፦ </char><char style="ft" closed="false">ቁማ ማናዉ ኡቴዳ ጉሳ።</char></note> <verse eid="LUK 11:37"/><verse number="38" style="v" sid="LUK 11:38"/>ፓርሳዊካ የሱሳ ቁማ ማናፐ ካስያን ኩሽያ ሜጨት ቤናዋ በኢደ ማላለትና፥ <verse eid="LUK 11:38"/><verse number="39" style="v" sid="LUK 11:39"/>ጎዳይካ፥ “ህንተንቶ ፓርሳዋቶ፥ ጹኣነ ሻታ ቦላ ባጋ ጌሺታ፤ ሽን ህንተንቱ ጋርሳይ ኡዝያንነ ኢታተን ኩሜዳ። <verse eid="LUK 11:39"/><verse number="40" style="v" sid="LUK 11:40"/>ህንተንቶ ኤያቶ! ቦላ ባጋ መዳዌ ጋርሳ መቤኔ? <verse eid="LUK 11:40"/><verse number="41" style="v" sid="LUK 11:41"/>ሽን ህንተንቱ ጹኣንነ ሻታ ጋርሳን ደእያዋ ህዬሳቶ እምተ፤ ሄ ዎደ ኡባባይካ ህንተዉ ጌሻ ግዳናዋ።<verse eid="LUK 11:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42"/>“ሽን ህንተንቶ ፓርሳዋቶ፥ ህንተዉ አየ! አያዉ ጎፐ፥ አኑጋፐነ ጻሎትያፐ፥ አጉፕያ ዶኡዋፐ፥ ታሙ ኩሽያፐ እት ኩሽያ ጾሳዉ እሚታ፤ ሽን ቱሙ ፕርዳነ ጾሳ ሲቅያዋ ህንተንቱ አጊታ። የዉዋን ቃይ ሄዋ አገናን ሀዋ ኦናዉ በሴ።<note caller="-" style="x"><char style="xo" closed="false">11:42 </char><char style="xt" closed="false"><ref loc="LEV 27:30">ዎጋ 27:30</ref></char></note><verse eid="LUK 11:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43"/>“ህንተንቶ ፓርሳዋቶ፥ ህንተዉ አየ! አያዉ ጎፐ፥ አይሁዳ አሳ ዎሳ ጎለን ቦንቾ ኡቱዋ፥ ገያ ግዶንካ ቦንቾ ሳሮታ ኮዪታ።<verse eid="LUK 11:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 11:44"/>“አሳይ ኤረናን ቦላና ሀመትያ ቤተና ዱፉዋ ማላትያ ድራዉ ህንተዉ አየ!” ያጌዳ።<verse eid="LUK 11:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45"/>ሙሴ ህግያ ታማርስያዋንቱፐ እቱ፥ “ታማርስያዎ፥ ኔን ሀዋ ያጋ ሃሳዮ ድራዉ ኑና ቦራዳ” ያግ ዛሬዳ።<verse eid="LUK 11:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46"/>የሱስ፥ “ህንተኖ ህግያ ኤርያዋንቶ፥ ሄንተዉ አየ! አያዉ ጎፐ፥ አሳይ ቶኪደ ዳንዳየና ዴጾ ቶኩዋ ሀራ ቶሲታ፤ ሽን ህንተንቱ ህንተ ሁጰዉ ብራያንካ ቦችክታ።<verse eid="LUK 11:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 11:47"/>“ህንተንቱ አዎቱ ዎዳ ናባቱዋ ዱፉዋ ሎይያ ድራዉ ህንተዉ አየ! <verse eid="LUK 11:47"/><verse number="48" style="v" sid="LUK 11:48"/>ስም ህንተንቱ አዎቱ ናባቱዋ ዎና፥ ህንተንቱ ኡንቱንቱ ዱፉዋ ቦላን ጎልያ ኬጽያ ድራዉ፥ ናባቱዋ ኦሱ ሎአ ያጊደ፥ ኡንቱንቱዋ ማርካቲታ። <verse eid="LUK 11:48"/><verse number="49" style="v" sid="LUK 11:49"/>ሀዋ ድራዉ፥ ጾሳ አ ኤራተይ፥ ታን ናባቱዋነ የሱስ ኪቶዋንታ ኡንቱንቱኮ ኪታና፤ ኡንቱንቱካ ሄዋንቱፐ እቱዋ እቱዋ ዎናዋንታ፤ እቱዋ እቱዋ መቶናዋንታ ያጌዳ። <verse eid="LUK 11:49"/><verse number="50" style="v" sid="LUK 11:50"/>ሀዋ ግድያ ድራዉ፥ ሀ አላሚ መቶደፐ ዶሚደ ጉኬዳ ናባቱዋ ሱዉ ሀ የለታይ ኦሸቴ። <verse eid="LUK 11:50"/><verse number="51" style="v" sid="LUK 11:51"/>አቤላፐ ዶሚደ ያርሹዋሳፐነ ጌሻ ጎልያፐ ግዱዋን ጉኬዳ ዛካራሳ ሱ ጋካናዉ ኮየቴ።<note caller="+" style="f"><char style="fr" closed="false">11:51 </char><char style="ft" closed="false">አይሁዳቱዋ ማጻፋቱዋ ጋርሳን ዶመ ማጻፋይ ኮይሮ ማጻፋ። እካ፥ አቤል አሳ ኡባፐ ኮይሩዋን እሻይ አ ዎዳዋ ኦዴ። አይሁዳቱዋ ጌሻ ማጻፋቱዋን ዉርሰ ማጻፋይ ላኤንያ ኦዱዋ ማጻፋ። ሄ ማጻፋን ዛካራስ ዉርሰን ሀይቄዳዋ ኦድያ ድራሳ ሉቃስ አቤላፐ ዛካራሳ ጋካናዉ ጌዳዌ።</char></note> ኤ! ታን ጋይ፤ ሀ የለታይ ሀዎ ኦሸትያዋ።<verse eid="LUK 11:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52"/>“ህንተንቶ ሙሴ ህግያ ኤርያዋንቶ፥ ህንተዉ አየ! አያዉ ጎፐ ኤራ ፐንግያ ዶይያ ቁልፕያ አኬድታ። ህንተንቱ ህንተ ሁጰዉካ ገልበይክታ፤ ቃይ ገላናዉ ኮይያዋንታካ ድጌድታ” ያጌዳ።<verse eid="LUK 11:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53"/>የሱስ ሄዋፐ ከሶዋፐ ጉይያን፥ ህግያ ታማርስያዋንቱነ ፓርሳዋቱ አ ኦሻን ኡርጉንሳነ ኤቀቱሳ ዶሜድኖ። <verse eid="LUK 11:53"/><verse number="54" style="v" sid="LUK 11:54"/>አ ዶናፐ ሎኤናባይ ከሶፐ ኦይቃናዉ ጌዲኖ፤ ሽን ደምበይክኖ።<verse eid="LUK 11:54"/></para>
  <chapter eid="LUK 11"/>
  <chapter number="12" style="c" sid="LUK 12"/>
  <para style="s1">ሎአ ማላትያ ኢታተፐ ናገታና ማላ ሴራ</para>
  <para style="r">(<ref loc="MAT 10:26">ማቶሳ 10:26</ref>፣ <ref loc="MAT 10:27">27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1"/>ሄ ዎድያን ጮራ ሻኣን ፓይደትያ አሳይ እቱ እቱዋ የና ጋካናዉ ሺቅ ደእሽን፥ የሱስ ባረና ካልያዋንቶ ኮይሮ ኦዳናዉ ዶሚደ፥ “ፓርሳዋቱዋ እርሹዋፐ ናገትተ፤ ሀዌካ ሎአ ማላትያ ኡንቱንቱ እምያ ኢታ ትምርትያ።<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="MAT 16:6">ማቶሳ 16:6</ref>፤ <ref loc="MRK 8:15">ማር. 8:15</ref></char></note> <verse eid="LUK 12:1"/><verse number="2" style="v" sid="LUK 12:2"/>ሽን አያንነ ካመቴዳ የዉ ቆንጭያ ከሰናን አተና፤ ቃይካ ጌሜዳ የዉ ኤረተናን አተና። <verse eid="LUK 12:2"/><verse number="3" style="v" sid="LUK 12:3"/>ሄዋ ድራዉ ህንተ ማን ሃሳዮዌ ኡባይ፥ ጋላስ ፖኡዋን ስሰታናዋ፤ ህንተንቱ አሳይ ባይናሳን ህን ግሶ ጎልያን ሀይን ሳሱኮዌ ኡባይ ቁ ጌዳ ስሰትያ ቆንጨሳን አዋየታናዋ።<verse eid="LUK 12:3"/></para>
  <para style="s1">እት ጾሳ ጻላላዉ ያያና በሴ</para>
  <para style="r">(<ref loc="MAT 10:28-31">ማቶሳ 10:28-31</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4"/>“ታናዳን አማንያዋንቶ፥ ታን ህንተዉ ያጋይ፤ ሀእ አሹዋ ዎያዋንታ፥ ሄዋፐ ካላ ቃይ አያነ ኦናዉ ዳንዳየናዋንታ ያዮፕተ። <verse eid="LUK 12:4"/><verse number="5" style="v" sid="LUK 12:5"/>የዉዋን ቃይ ህንተንቱ ኦስ ያያናዉ በስንቶ ታን ህንተንታ ኤርሳና፤ ሄዌካ ዎዋፐ ጉይያን ጋናምያን ኦላናዉ ማታይ ደእያ ጾሳ ጻላላዉ ያይተ፤ ኤ፥ አዉ ያይተ ያጋይ።<verse eid="LUK 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 12:6"/>“እቼሹ ሱንያ ካፋቱ ሳንትምያን ሻመትክኖየ? ሄዋንቱፐ እትኖነ ኡሳ ጾሳይ ዶገና። <verse eid="LUK 12:6"/><verse number="7" style="v" sid="LUK 12:7"/>ሽን ሀራይ አቶ ህንተንቱ ሁጲያን ደእያ ብናናይ ኡባይካ ፓይደቴዳዋ፤ ሀዋ ድራዉ ያዮፕተ፤ ህንተንቱ ጮራ ሱንያ ካፋቱዋፐ ዳሪታ።<verse eid="LUK 12:7"/></para>
  <para style="s1">የሱሳን አማንያዋንታነ አ እጽያዋንታ</para>
  <para style="r">(<ref loc="MAT 10:32">ማቶሳ 10:32</ref>፣ <ref loc="MAT 10:33">33</ref>፤ <ref loc="MAT 12:32">12:32</ref>፤ <ref loc="MAT 10:19">10:19</ref>፣ <ref loc="MAT 10:20">20</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8"/>“ታን ህንተዉ ኦዳይ፤ ታባ አሳ ስንን ማርካትያዎ ኦስነ ታንካ አሳ ናአይ፥ ቃይ ጾሳ ኪታንቻቱዋ ስንን ማርካታና፤ <verse eid="LUK 12:8"/><verse number="9" style="v" sid="LUK 12:9"/>ሽን አሳ ስንን ታና ካድያዋንታ ታንካ አሳ ናአይ፥ ቃይ ጾሳ ኪታንቻቱዋ ስንን ካዳና።<verse eid="LUK 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 12:10"/>“ታ ቦላ፥ አሳ ናኣ ቦላ፥ ቦርያ ቃላ ሃሳይያዌ ደኦፐ አ ናቁ አቶ ጌተታና፤ ሽን ጌሻ አያና ቦላ ቦርያ ቃላ ሃሳይያዌ ደኦፐ ቃይ አ ናቁ አቶ ጌተተና።<note caller="-" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="MAT 12:32">ማቶሳ 12:32</ref>፤ <ref loc="MRK 3:29">ማር. 3:29</ref></char></note><verse eid="LUK 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11"/>“አሳይ ህንተንታ አይሁደ ዎስያ ጎልያኮ፥ ጋድያ አይስያዋንቱኮነ ማታይ ደእያዋንቱ ስን ፕርዳዉ ሺሽያ ዎደ፥ ‘ዋግ ዛራኔሻ? ዎይ አያ ጊደ ሃሳያኔሻ?’ ያጊደ ህርጎፕተ፤ <verse eid="LUK 12:11"/><verse number="12" style="v" sid="LUK 12:12"/>አያዉ ጎፐ፥ ህንተና አያና ጌሻይ ህንተንቱ ሄ ሳትያን ሃሳያናዉ በስያባ ታማርሳናዋ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="MAT 10:19-20">ማቶሳ 10:19-20</ref>፤ <ref loc="MRK 13:11">ማር. 13:11</ref>፤ <ref loc="LUK 21:14-15">ሉቃሳ 21:14-15</ref></char></note><verse eid="LUK 12:12"/></para>
  <para style="s1">ዱረ ብታንያ ቦዛተ ኦድያ ሌምሱዋ</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13"/>አሳ ጋርሳፐ እት ብታኒ የሱሳ፥ “ታማርስያዎ፥ ኑ አቡ ሀይቂና ኑን ላታና ማላ አቴዳባ፥ ታዉ ግሻና ማላ ሀያ ጎዶ ታ እሻዉ ኦዳ” ያጌዳ።<verse eid="LUK 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14"/>የሱስ ቃይ፥ “ሀ ብታነዉ፥ ህንተንቱ ቦላን ፕርድያዋ ግዳናዳነ ሄዋ ህንተዉ ግሻናዳን ታና ኦኔ ሱንዳዌ?” ያጌዳ።<verse eid="LUK 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 12:15"/>ጉጂደካ ኡባቱዋ፥ “አሳ ሸምፖ ሻሉዋ ዱረተይ ደኡዋ እመና ድራዉ፥ ያረትያዋፐነ ዮራትያዋፐ ናገትተ፤ ዱረተ አሙዋ ኡባፐካ ህንተና ናግተ” ያጌዳ።<verse eid="LUK 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16"/>ካሊደካ ሀዋዳን ያግ ሌምሱዋ ኡንቱንቶ ኦዴዳ: “አዉ ደእያ ቢታይ ዳርሲደ ካ ሞኬዳ እት ዱረ ብታኒ ደኤ። <verse eid="LUK 12:16"/><verse number="17" style="v" sid="LUK 12:17"/>ሀ ብታኒ፥ ‘ታዉ ታ ካ ዎናዉ ግድያ ሳአይ ባንታዋ ድራዉ አያ ኦሻ?’ ያጊደ፥ ባረ ዎዛናን ቆፔዳ፤ <verse eid="LUK 12:17"/><verse number="18" style="v" sid="LUK 12:18"/>ሀዋዳን ያግ ማሌዳ፤ ‘ታን ዎታነ ጎፐ፥ ታዉ ደእያ ዬስያ ኮላደ፥ ሀራ አክያ ዬስያ መና ያጊደ ማሌዳ፤ ሄዋን ታ ካነ ታዉ ደእያ ሚሻ ኡባ ዎና። <verse eid="LUK 12:18"/><verse number="19" style="v" sid="LUK 12:19"/>ያታደ ታና፥ “ነ ካጫይ ዳሮ ሎአ፤ ነዉ ዳሮ ዎድያዉ ግድያ ማጹዋ ሺሻዳ፤ ስም ሸምፓደ ማ፥ ኡሻ፥ ናሸታ” ጋና’ ያጌዳ።<verse eid="LUK 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 12:20"/>“ሽን ጾሳይ አ፥ ‘ሀ ቦዛዉ፥ ሀቼ ቃማ ኔን ሀይቃ። ያትና ሀ ኔን ሺሼዳ ማጹ ኡባይ ኦስ ግዳናዌ?’ ያጌዳ።<verse eid="LUK 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21"/>“ባረዉ ቢታ ቦላን ሻሉዋ ሺሽያዌ፥ ጾሳ ስንን ቃይ ማንቆ ግዴዳ አሳይ ሀ ብታንያ ማላ” ያጌዳ።<verse eid="LUK 12:21"/></para>
  <para style="s1">ኡባ ዎደ ጾሳን አማነቱሳ ኮሼ</para>
  <para style="r">(<ref loc="MAT 6:25-34">ማቶሳ 6:25-34</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22"/>ሀዋፐ ካላ የሱስ ባረና ካልያዋንታ፥ “ሀዋ ድራዉ፥ ታ ህንተዉ ኦዳይ: ህንተንቱ ፓጻ ደአናዉ አያ ማኔ? ህንተንቱ ቦላዉ አያ ማያኔ? ያጊደ ህርጎፕተ።<verse eid="LUK 12:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 12:23"/>“ጋሱካ፥ ሸምፑ ቁማፐ፥ ቃይ አሳተይ ማዩዋፐ አኔ? <verse eid="LUK 12:23"/><verse number="24" style="v" sid="LUK 12:24"/>አነ ቁራቱዋ ጼልተ፤ ኡንቱንቱ ዘርክኖ፤ ጫክክኖ፤ ኡንቱንቶ ካ ሺሽያ ሳአይ ዎይ ዬሲ ባዋ፤ ሀኖፐ አትን፥ ኡንቱንታ ጾሳይ ምዜ፤ ህንተንቱ ካፋቱዋፐ ዳሮፐ ዳርክቴ? <verse eid="LUK 12:24"/><verse number="25" style="v" sid="LUK 12:25"/>ህንተንቱፐ ዳሪ ቆፒደ ዳሮ ዎድያ ደአናዉ ዳንዳይያዌ ኦኔ?<verse eid="LUK 12:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 12:26"/>“ስም ህንተንቱ ሀ ላፋባ ኦናዉ ዳንዳየናዋንታ ግዶፐ አያዉ ሀራባዉ ህርገቲቴ? <verse eid="LUK 12:26"/><verse number="27" style="v" sid="LUK 12:27"/>ጪሻቱ ዎት ድጪኖንቶ አነ ጼልተ፤ ኡንቱንቱ ኪታን ዳቡርክኖ፤ ፑቱዋ ሱቂክኖ፤ ግዶ ሽን ታን ህንተዉ ኦድያዌ፥ ሶሎሞነ ሄዋ ኬና ቦንቼቴዳዋ<note caller="+" style="f"><char style="fr" closed="false">12:27 </char><char style="fq" closed="false">ሶሎሞነ ሄዋ ኬና ቦንቼቴዳዋ፦ </char><char style="ft" closed="false">አይሁዳ አሳይ ሶሎሞነ ባረ ደኤዳ ላይ ኡባን ዳሮ ዱረተን ደኤዳ ጊደ ቆፒኖ።</char></note> ግዲደ፥ ሄ ጪሻቱዋፐ እቱዋ ማላነ ማይቤና።<note caller="-" style="x"><char style="xo" closed="false">12:27 </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">1 ካታ. 10:4-7</ref>፤ <ref loc="2CH 9:3-6">2 ኦዱዋ 9:3-6</ref></char></note> <verse eid="LUK 12:27"/><verse number="28" style="v" sid="LUK 12:28"/>ህንተንቶ ላፋ አማኑ ደእያዋንቶ፥ ያቶፐ ጾሳይ ሀቼ ቤቲደ፥ ዎንት ታማን ኤጻናዉ ኦለትያ፥ ደንባን ዶልያ ማታ ሀዋዳን ማይዝያዋ ግዶፐ፥ ህንተንታ ዎቲደ ኡንቱንቱፐ አደ ማይዘኔ?<verse eid="LUK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 12:29"/>“ሀዋ ድራዉ፥ ‘አያ ማኔ? አያ ኡሻኔ?’ ያጊደ ኡባ ዎደ ኮዮፕተነ ህርጎፕተ። <verse eid="LUK 12:29"/><verse number="30" style="v" sid="LUK 12:30"/>አያዉ ጎፐ፥ ሀዋ ደማናዉ ሀ አላምያን ደእያ ጾሳን አማነተና አሳይ ህርገቲኖ። ህንተንቶ ሀዌ ኡባይ ኮሽያዋ ሳሉዋን ደእያ ህንተንቱ አዉ ኤሬ። <verse eid="LUK 12:30"/><verse number="31" style="v" sid="LUK 12:31"/>ሄዋ ሀንያዋ አጊደ፥ ጾሳ ካዉተ ኮይተ፤ እ ህንተንታ ኮሽያዋ ኡባ እማናዋ።<verse eid="LUK 12:31"/></para>
  <para style="s1">ሳኣን ባረ ዱረተን አማነቶዌ ሳሉዋን ዋኒ?</para>
  <para style="r">(<ref loc="MAT 6:19-21">ማቶሳ 6:19-21</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32"/>“ህንተንቱ ጉ ግድንቶነ፥ ሳሉዋ ህንተንቱ አዉ ባረ ካዉተ ህንተንቶ እማናዉ ናሸቴዳ ድራዉ ያዮፕተ።<verse eid="LUK 12:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 12:33"/>“ህንተዉ ደእያዋ ዛልኢደ ማንቆ እምተ፤ ካይሱ ሺቀናሳን፥ ብልአይካ ሜናሳን፥ ሳሉዋን ዉረና ሚሻ ዳጋዪደ፥ ኤጨና ቃርጭታቱዋ ህንተንቱ ሁጰዉ ዎተ። <verse eid="LUK 12:33"/><verse number="34" style="v" sid="LUK 12:34"/>አያዉ ጎፐ፥ ህንተንቱ ዎዛናይ ህንተ ሚሻይ ደእያ ሳን ደአናዋ።<verse eid="LUK 12:34"/></para>
  <para style="s1">ምኖ ኦሳንቻ</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35"/>“ህንተ ጼሳይ ዳንጨቶዋ፥ ህንተ ጾምፒካ ፖኤዳዋ ግዶ።<note caller="-" style="x"><char style="xo" closed="false">12:35 </char><char style="xt" closed="false"><ref loc="MAT 25:1-13">ማቶሳ 25:1-13</ref></char></note> <verse eid="LUK 12:35"/><verse number="36" style="v" sid="LUK 12:36"/>ህንተንቱካ፥ ባረንቱ ጎዳይ ዪደ ፐንግያ ቆጽያ ዎደ፥ ኤለካ ዶያናዉ ቡላቻፐ ስማና ጋካናዉ ናግያ ኦሳንቻቱዋ ማላትተ።<note caller="-" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="MRK 13:34-36">ማር. 13:34-36</ref></char></note> <verse eid="LUK 12:36"/><verse number="37" style="v" sid="LUK 12:37"/>ባረንቱ ጎዳይ ሶይ ዬዳ ዎደ ቤጎት ደእሽን ደምያ ሄ ኦሳንቻቱ አንጀቴዳዋንታ። ታን ቱሙዋ ጋይ፤ እ ኡንቱንታ፥ ‘ኡትተ’ ጊደ፥ ባረ ዳንጩዋ ምንሲደ ኡንቱንቶ ቁማ አደ ሾባናዋ። <verse eid="LUK 12:37"/><verse number="38" style="v" sid="LUK 12:38"/>ጎዳይ ሄካ ብላህያን ዎይ ሄካ ብላህያፐ ካላ ዬዳ ዎደ፥ ቤጎቲደ ገንጭ ናጊደ ቤትያ ቆማቱ አንጀቴዳዋንታ። <verse eid="LUK 12:38"/><verse number="39" style="v" sid="LUK 12:39"/>ሀዋ ቃይ ኤርተ፤ ካይሱ አይ ሳትያን ይንቶ ጎልያዉ ኤርንቶ፥ ጎሊ ቦከትያ ዎደ ጮኡ ጊደ ጼለናሽን።<note caller="-" style="x"><char style="xo" closed="false">12:39፣ 40 </char><char style="xt" closed="false"><ref loc="MAT 24:43">ማቶሳ 24:43</ref>፣ <ref loc="MAT 24:44">44</ref></char></note> <verse eid="LUK 12:39"/><verse number="40" style="v" sid="LUK 12:40"/>አሳ ናአይ ቆፐና ሳትያን ያናዋ፤ ህንተንቱ ጊገት ናግተ” ያጌዳ።<verse eid="LUK 12:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41"/>ጰጽሮስካ “ጎዳዉ፥ ሀ ሌምሱዋ ኔን ኦድያዌ ኑ ጻላላሴ ሀራ ኡባዉካ እትፐ ኦዳይ?” ያጌዳ።<verse eid="LUK 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42"/>ጎዳይካ፥ “ስም ኡንቱንቱ ባረ ሶይ አሳዉ ቁማ እማናዉ በስያ ሳትያን እማና ማላ፥ አ ጎዳይ ሱንያ አማነቴዳነ ኤራንቻ ምዝያ ቆማይ ኦኔ?” ያጌዳ። <verse eid="LUK 12:42"/><verse number="43" style="v" sid="LUK 12:43"/>ጎዳይ ስምያ ዎደ ሀዋዳን ኪተቲና ደምያ ቆማይ እ አንጀቴዳዋ። <verse eid="LUK 12:43"/><verse number="44" style="v" sid="LUK 12:44"/>ታን ህንተዉ ቱሙዋ ኦዳይ፤ ደእያ ማጹዋ ኡባ ቦላን አ ሱንናዋ። <verse eid="LUK 12:44"/><verse number="45" style="v" sid="LUK 12:45"/>የዉዋን ቃይ ሄ ቆማይ፥ “ታ ጎዳይ ኤለ ዬና፤ ጋምአናዋ” ያግ ባረ ዎዛናን ቆፖፐነ አቱማነ ማጫ ቆማቱዋ ሾቻ ዶሞፐ፥ ቃይካ ኮዮዋዳን ሙሳነ ኡሻ፥ ማቱሳካ ዶሞፐ፥ <verse eid="LUK 12:45"/><verse number="46" style="v" sid="LUK 12:46"/>ሄ ቆማ ጎዳይ፥ እ ቆፐና ጋላስነ ስቤና ሳትያን ያናዋ፤ ሄ ዎድያን አ ቃንጸሬደ፥ አ ግሹዋ ካጫካ አማነናዋንቱና እትሳ ኡዳናዋ።<verse eid="LUK 12:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47"/>ባረ ጎዳ ሸንያ ኤሪደ ጊገናዌነ አ ሸንያዳን ኪተተና ቆማይ፥ እ ኢታ ኦባ ኦበታናዋ። <verse eid="LUK 12:47"/><verse number="48" style="v" sid="LUK 12:48"/>ኤርቤናዌ ቃይ ኦበታናዉ በስያዋ ኦዳዌ፥ ጉ ኦበቴ። ዳሮባይ እመቴዳ አሳ ኡባፐ፥ አፐ ዳሮባይ ኮየቴ፤ ዎልቃማ ሀዳራይ እመቶዋፐ፥ አፐ ዳርሲደ ኮየቴ።<verse eid="LUK 12:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49"/>የሱስ፥ “ታን ዬዳዌ፥ ሀ ሳኣ ቦላ ታማ ሳናሳ፤ ሀእካ ኤጼደንቶ፥ ታና አይ ኬና ናሸቻናዌሻ። <verse eid="LUK 12:49"/><verse number="50" style="v" sid="LUK 12:50"/>ታን ጻማቀታና መቱዋ ጽንቃታይ ፖለታና ጋካናዉ ዋናደ ኡንኤታይታ!<note caller="-" style="x"><char style="xo" closed="false">12:50 </char><char style="xt" closed="false"><ref loc="MRK 10:38">ማር. 10:38</ref></char></note> <verse eid="LUK 12:50"/><verse number="51" style="v" sid="LUK 12:51"/>ሀ ሳኣ ታን ዬዳዌ፥ ሳሮተ አሀናሳ ማላቲዬ? ህንተዉ ማላቶፖ። ታን ዮዌ፥ ሳሮታዉ ግደናን ሻካናሳፐ አትን። <verse eid="LUK 12:51"/><verse number="52" style="v" sid="LUK 12:52"/>አያዉ ጎፐ፥ ሀእፐ ዶምና እት ጎልያን ደእያ እቼሹ አሳቱ ሻከታናዋንታ፤ ሄዛቱ ላአቱዋ ቦላ፥ ላአቱካ ሄዛቱዋ ቦላ ደንዲደ ዋላቀታናዋንታ። <verse eid="LUK 12:52"/><verse number="53" style="v" sid="LUK 12:53"/>አዉ ናኣ ቦላ፥ ናአይካ አዉዋ ቦላ፥ አታ ናት ቦላ፥ ናታካ አት ቦላ፥ ቦሎታታ ናኣ ማች ቦላ፥ ናኣ ማቻካ ቦሎታት ቦላ፥ ዋላሳን ደንዲደ ሻከታናዋንታ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">12:53 </char><char style="xt" closed="false"><ref loc="MIC 7:6">ሚክ. 7:6</ref></char></note><verse eid="LUK 12:53"/></para>
  <para style="s1">ዎድያ ሀኖታ ኤሩዋ</para>
  <para style="r">(<ref loc="MAT 16:2-3">ማቶሳ 16:2-3</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54"/>ቃይካ የሱስ አሳዉ፥ “አዋይ ዉልያ ባጋና ህንተ ሻርያ በኦፐ፥ ‘ሀእ ሀ ሳትያን ሄኮ ዎልቃማ እራይ ቡካና ሀኔ’ ያጊታ፤ ቱሙካ ቃይ ቡኬ። <verse eid="LUK 12:54"/><verse number="55" style="v" sid="LUK 12:55"/>ዱገ ባጋና ጫርኩ ጫርኮደ፥ ‘ሀቼ ሻማናዋ’ ያጊታ፤ ጌተቶዋዳንካ ቃይ ሀኔ። <verse eid="LUK 12:55"/><verse number="56" style="v" sid="LUK 12:56"/>ህንተኖ ሎአ ማላትያ ኢታቶ፥ ሳኣነ ሳሉዋ ጼሊደ፥ ሀናናዋ ኤሪታ፤ ሽን ሀ ዎድያባ ዎት ኤራናዉ ዳንዳይክቴ?<verse eid="LUK 12:56"/></para>
  <para style="s1">ስጋተባነ ሞቱዋባ</para>
  <para style="r">(<ref loc="MAT 5:25-26">ማቶሳ 5:25-26</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57"/>“ዎደ ህንተንቱ ጽሎ ግዴዳ የዉዋ ህንተንቶ አያዉ ፕርድክቴ? <verse eid="LUK 12:57"/><verse number="58" style="v" sid="LUK 12:58"/>ነ ሞርክያና እትፐ ፕርድያ ዳና ስንን ሺቃናዉ ቦደ፥ ብሮ ኦግያ ቦላ ደእሽን ስገታ ድጋ። ሄዌ ዮፐ ኔና ጎቺደ ፕርድያ ዳናኮ አፋና፤ ዳናይካ ፖልሰዉ አ እማናዋ፤ ፖልሲ ቃሾ ጎለን የጋናዋ። <verse eid="LUK 12:58"/><verse number="59" style="v" sid="LUK 12:59"/>ታን ነዉ ኦድያዌ፥ ዉርሰ አጩዋ ጭጋና ጋካናዉ ሄዋፐ ከሳካ” ያጌዳ።<verse eid="LUK 12:59"/></para>
  <chapter eid="LUK 12"/>
  <chapter number="13" style="c" sid="LUK 13"/>
  <para style="s1">ናጋራፐ ስመና ኡባይ ያና</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1"/>ሄ ዎድያን እት እት አሳቱ የሱሳኮ ዪደ ጵላጾስ ጋሊላ አሳ ዎደ ኡንቱንቱ ሱ ያርሹዋና እትፐ ዋላኬዳዋ አዉ ኦዴድኖ። <verse eid="LUK 13:1"/><verse number="2" style="v" sid="LUK 13:2"/>የሱስካ ዛሪደ፥ “ሀዋንቱ ጋሊላ አሳቱ ሀይቄዳ ድራዉ፥ ያትና ኡንቱንቶ ሀራ ጋሊላ አሳ ኡባፐካ አደ ናጋራንቻቱዋ ግዶዋንታ ማላቲኖ? <verse eid="LUK 13:2"/><verse number="3" style="v" sid="LUK 13:3"/>ታን ያጋይ፥ ሀዋዳን ግደና፤ የዉዋን ቃይ ህንተ ናጋራ ፓጺደ ናጋራፐ ስመናን እጾፐ፥ ህንተንቱ ኡባቱካ ሄዋዳን ሀይቂታ። <verse eid="LUK 13:3"/><verse number="4" style="v" sid="LUK 13:4"/>ዎይ ሳልሆማ ግምቢ ኡንቱንቱ ቦላ ኩንዲደ፥ ዎዳ ታማነ ሆስፑን አሳቱዋ የሩሳላመን ደእያዋንቱ ኡባፐ አደ ናቆዋንታ ማላቲኖ? <verse eid="LUK 13:4"/><verse number="5" style="v" sid="LUK 13:5"/>ሀዋዳን ግደና ያጋይ፤ የዉዋን ቃይ ናጋራ ፓጻና ዮፐ ኡባቱካ ሀዋዳን ባያንታ” ያጌዳ።<verse eid="LUK 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6"/>የሱስካ ሀዋዳን ያግ ሌምሱዋ ኦዴዳ፥ “እት ብታነዉ ዎይንያ ቱራ ጎሻ ጋደን ቶከቴዳ ባላስያ ጌተትያ አይፊ ሜተትያ ምታ ደአዉ፤ ሄ ብታኒካ ምታ አይፋደንቶነ ጊደ ዬዳዌ፥ አይኔካ አይፍያ ደምቤና። <verse eid="LUK 13:6"/><verse number="7" style="v" sid="LUK 13:7"/>ዎይንያ ቱራ ናግያዋ እ፥ ‘ታን ሀ ባላስያ ጌተትያ ምትፐ አይፍያ ደማናዉ ሄዙ ላይ ስመረታደ አያነ ደማበይከ። ሄዋ ድራዉ ደካ ደን ድጋ፤ አያዉ ቢታ ጮ መልሳይ?’ ያጌዳ። <verse eid="LUK 13:7"/><verse number="8" style="v" sid="LUK 13:8"/>ናግያዌካ ዛሪደ፥ ‘ጎዳዉ፥ ታን እ ዩሹዋ ሀሩማናዉነ ፕቱዋ ኦላናዉ፥ ሀ ላይ ጻላላዉ ባሻ። <verse eid="LUK 13:8"/><verse number="9" style="v" sid="LUK 13:9"/>ስንዉ አይፎፐ ሎአ፤ ሽን አይፈናን እጾፐ ደከቱ’ ጌዳ” ያጌዳ።<verse eid="LUK 13:9"/></para>
  <para style="s1">የሱስ ቁና ምሽራቶ ሳምባታ ጋላሳ ፓዳ</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10"/>የሱስካ እት ሳምባታ ጋላስ አይሁዳ ዎሳ ጎላቱዋፐ እቱዋን ታማርስ ደኤ። <verse eid="LUK 13:10"/><verse number="11" style="v" sid="LUK 13:11"/>ሄዋንካ ታማነ ሆስፑን ላይ ኩመን ቱና አያናይ ቁንሴዳ ምሽራታ ደአዉ። እዛካ ሱራደ ኤቃናዉ አይነ ዳንዳያበይኩ። <verse eid="LUK 13:11"/><verse number="12" style="v" sid="LUK 13:12"/>የሱስካ እዞ በኤዳ ዎደ ጼሲደ፥ “ሀ ምሽራቴ፥ ነ ሀርግያፐ ፓጻዳ” ያጌዳ። <verse eid="LUK 13:12"/><verse number="13" style="v" sid="LUK 13:13"/>የሱስ ባረ ኩሽያ እዝ ቦላ ዎና፥ ሄ ዎደ ሱራ ስት ጋ ኤቃደ ባረ ጾሳ ጋላታዱ።<verse eid="LUK 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14"/>ሽን አይሁዳ ዎሳ ጎለ ካፑ ቃይ የሱስ ሳምባታን ፓዳዋ ድራዉ ሀንቀት ዛሮዋሽን አሳቱዋ፥ “ኪተታናዉ በስያ ኡሱፑን ጋላሳቱ ደኢኖ፤ ሄ ጋላሳቱን ዪደ ፓጽተፐ አትን ሳምባታን ግደና” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="EXO 20:9">ከሳ 20:9</ref>፣ <ref loc="EXO 20:10">10</ref>፤ <ref loc="DEU 5:13">ዛረ. 5:13</ref>፣ <ref loc="DEU 5:14">14</ref></char></note><verse eid="LUK 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15"/>ጎዳይካ ዛሪደ፥ “ሀ ሎአ ማላትያ ኢታ አሳቶ፥ ህንተንቱፐ እቱካ ሳምባታ ጋላስ ቦራ ማጋዱዋፐ ዎይ ሀርያ ጋጻታፐ ብሊደ ሃ ኡሻናዉ አፈኔ? <verse eid="LUK 13:15"/><verse number="16" style="v" sid="LUK 13:16"/>ሀና አብራሃሞ ያራ ግዴዳዉና፥ ታማነ ሆስፑን ላይ ኩመን ጻላሂ ቃቼዳዉና ሳምባታ ጋላስ ሄ ቃሹዋፐ ብለታናዉ በሰኬ?” ያጌዳ። <verse eid="LUK 13:16"/><verse number="17" style="v" sid="LUK 13:17"/>ሀዋ ኦዴዳ ዎደ ኤቀትያዋንቱ ኡባይ ዬላቴድኖ፤ አሳይ ኡባይ ቃይ እ ኦዳ ማላልስያ ኦሱዋን ኡባን ናሸቴድኖ።<verse eid="LUK 13:17"/></para>
  <para style="s1">ሳናፍጭያ አይፍያ ዘረ ሌምሱዋ</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18"/>የሱስካ፥ “ጾሳ ካዉተይ አያ ማላቲ? እ አያ ማላትንቶ፥ ታን ህንተንታ ዎታ በሶ? <verse eid="LUK 13:18"/><verse number="19" style="v" sid="LUK 13:19"/>ጾሳ ካዉተይ ሳናፍጭያ ጌተትያ ቄር ምት አይፍያ ማላቴ። ሄ ምት አይፍያ አሳይ አኪደ ጎሻ ጋርሳን ዘሬዳ፤ ዘረቶና ድጫደ ዎጋ ም ግዳዱ፤ ያትና ሳሉዋ ካፋቱካ እዝ አጫ ቦላ ባረንቶ ጎልያ ኬጼድኖ” ያጌዳ።<verse eid="LUK 13:19"/></para>
  <para style="s1">እርሹዋ ሌምሱዋ</para>
  <para style="r">(<ref loc="MAT 13:33">ማቶሳ 13:33</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20"/>የሱስካ ዛሪደ፥ “ጾሳ ካዉተይ አያ ማላትንቶ፥ ታን ህንተንታ ዎታ በሶ? <verse eid="LUK 13:20"/><verse number="21" style="v" sid="LUK 13:21"/>እት ምሽራታ ሄዙ ከርያ ልያ አካደ፥ ሙናቄዳ ሙናቃይ ኡባይ ደንዳና ጋካናዉ፥ አን ትጌዳ እርሹዋ ማላቴ” ያጌዳ።<verse eid="LUK 13:21"/></para>
  <para style="s1">ኡንአ ፐንግያባ</para>
  <para style="r">(<ref loc="MAT 7:13">ማቶሳ 7:13</ref>፣ <ref loc="MAT 7:14">14</ref>፣ <ref loc="MAT 7:21">21</ref>፣ <ref loc="MAT 7:22">22</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22"/>ሄዋፐ ካላ የሱስ የሩሳላመ ቢደ፥ ዎጋ ካታማንነ ቄር ካታማን ደእያ አሳ ታማርሲደ አዳ። <verse eid="LUK 13:22"/><verse number="23" style="v" sid="LUK 13:23"/>ሄ ዎደ እት ብታኒ ሺቂደ አ፥ “ጎዳዉ፥ ጾሳ ፕርዳፐ አትያዋንቱ ጉ አሳ ጻላሌ?” ያጌዳ።</para>
  <para style="p" vid="LUK 13:23">ሄዋፐ ጉየ የሱስ ኡንቱንታ፥<verse eid="LUK 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 13:24"/>“ታን ህንተንቶ ኦዳይ፤ ኡንአ ፐንግያና ገላናዉ ባጸትተ። ጮራ አሳይ ገላናዉ ኮዪኖ፤ ሽን ዳንዳይበይክኖ። <verse eid="LUK 13:24"/><verse number="25" style="v" sid="LUK 13:25"/>ጎልያዉ ደንዲደ፥ እፍ ቃቾዋፐ ጉየ ህንተንቱ ካረን ኤቂደ፥ ‘ጎዳዉ፥ ጎዳዉ፥ ኑዉ ዶያርኪ’ ያጊደ ጼሳ ዶምያ ዎደ፥ እካ ዛሪደ፥ ‘ሀቃፐ ዬድተንቶ፥ ታን ህንተንታ ኤርከ’ ያጋናዋ።<verse eid="LUK 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 13:26"/>“ሄ ዎደ ህንተንቱ፥ ‘ኑን ኔናና እትፐ ሜዶ፤ ኡሼዶ፤ ኔን ኑ ሄራንካ ታማርሳዳ’ ያጋናዋንታ።<verse eid="LUK 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 13:27"/>“የሱስ ቃይ፥ ‘ታን ህንተንቶ ኦዳይ፤ ህንተንቱ ሀቃፐ ዬድተንቶ፥ ታን ህንተንታ ኤርከ፤ ኡባቱካ ማካላንቻቱ ታ ማታፐ ሃክተ’ ያጋናዋ።<note caller="-" style="x"><char style="xo" closed="false">13:27 </char><char style="xt" closed="false"><ref loc="PSA 6:8">ማዝ. 6:8</ref></char></note><verse eid="LUK 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 13:28"/>“አብራሃሞ፥ ይሳቅ፥ ያቆብነ ናባቱ ኡባይ ህንተንቱ ካረን ኤቂሽን፥ ጾሳ ካዉተን ደእያዋንታ ህንተንቱ በእያ ዎደ፥ ህንተንቶ ዬኮነ አቻ ቁዋ ግዳናዋ።<note caller="-" style="x"><char style="xo" closed="false">13:28 </char><char style="xt" closed="false"><ref loc="MAT 22:13">ማቶሳ 22:13</ref>፤ <ref loc="MAT 25:30">25:30</ref>፤ <ref loc="MAT 13:28">13:28</ref>፣ <ref loc="MAT 13:29">29</ref>፤ <ref loc="MAT 8:11">ማቶሳ 8:11</ref>፣ <ref loc="MAT 8:12">12</ref></char></note><verse eid="LUK 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 13:29"/>“አሳይ አዋይ ዶልያሳፐነ ዉልያሳፐ፥ ቃይ ክልባጋፐነ ህርክባጋፐ ዪደ፥ ጾሳ ካዉተ ጋይታን ኡቲኖ። <verse eid="LUK 13:29"/><verse number="30" style="v" sid="LUK 13:30"/>በእተ፤ ጉየቴዳዋንቱ፥ ስንታናዋንታ፤ ስንቴዳዋንቱ ቃይ ጉየታናዋንታ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">13:30 </char><char style="xt" closed="false"><ref loc="MAT 19:30">ማቶሳ 19:30</ref>፤ <ref loc="MAT 20:16">20:16</ref>፤ <ref loc="MRK 10:31">ማር. 10:31</ref></char></note><verse eid="LUK 13:30"/></para>
  <para style="s1">የሱስ የሩሳላመን ኦዳባ</para>
  <para style="r">(<ref loc="MAT 23:37-39">ማቶሳ 23:37-39</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31"/>ሄ ዎደ ፓርሳዋቱዋፐ እቱ እቱ የሱሳኮ ዪደ፥ “ሄሮድሰ ኔና ዎናዉ ኮይያ ድራዉ፥ ሀዋፐ ባ ድጋ” ያጌድኖ።<verse eid="LUK 13:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32"/>የሱስ ዛሪደ፥ “ቢደ ሄ ዎራካናዉ፥ ‘ሀቼነ ዎንት ኢታ አያናቱዋ ከሳና፤ ሀርጋንቻቱዋካ ፓና፤ ሄዘን ጋላስ ታ ኦሱዋ ዉርሳና’ ያግተ። <verse eid="LUK 13:32"/><verse number="33" style="v" sid="LUK 13:33"/>ሀኖፐ አትን ናቢ የሩሳላመፐ ሀራሳን ሀይቃናዉ በሰና ድራዉ፥ ታን ሀቼ፥ ዎንትነ ዎንትፔሽ ኦግያ ቦላ ደአናዉ በሴ።<verse eid="LUK 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34"/>“የሩሳላመ ካታማ አሳዉ፥ የሩሳላመ ካታማ አሳዉ፥ ናባቱዋ ዎያዋንቶ፥ ህንተንቱኮ ኪተቶዋንታ ሹቻን ጫድያዋንቶ፥ ኩታታ ባረ ማራቱዋ ባረ ቀፍያፐ ጋርሳና ሺሻ ሀጵያዋዳን፥ ታን ህንተንቱ ናና እት ጋድያ ሺሻናዉ አፑ ገደ ኮያድታ! ሽን ታና ድጌድታ። <verse eid="LUK 13:34"/><verse number="35" style="v" sid="LUK 13:35"/>በእተ፤ ጾሳይ ህንተንቱ ጎልያ አይነ ኦልቤና፤ ታን ህንተንቶ ያጋይ፤ ህንተንቱ፥ ‘ጎዳ ሱንን ይያዌ አንጀቴዳዋ’ ጋና ጋካናዉ፥ ታና በእክታ” ያጌዳ።<verse eid="LUK 13:35"/></para>
  <chapter eid="LUK 13"/>
  <chapter number="14" style="c" sid="LUK 14"/>
  <para style="s1">የሱስ ሀርጋንቻ ሳምባታን ፓዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1"/>ሳምባታ ጋላስ ፓርሳዋቱዋ ሱንቱዋፐ እቱዋ ጎለ የሱስ ቁማ ማናዉ ገሌዳ ዎደ፥ አያ ኪተትንቶ በአናዉ አሳቱ ናግ ደኢኖ። <verse eid="LUK 14:1"/><verse number="2" style="v" sid="LUK 14:2"/>ቦላይ ጋፍና መቶትያ እት ብታኒ የሱሳፐ ስንና ደኤ። <verse eid="LUK 14:2"/><verse number="3" style="v" sid="LUK 14:3"/>የሱስ ህግያ ታማርስያዋንታነ ፓርሳዋቱዋ፥ “ሳምባታን ፓናዉ ዳንዳየት ዳንዳየተኔ?” ጊደ ኦቼዳ።<verse eid="LUK 14:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 14:4"/>ኡንቱንቱካ ጮኡ ጌድኖ። እ ሄ ብታንያ ቦላ ቦች ፓደ አ ሞይዜዳ። <verse eid="LUK 14:4"/><verse number="5" style="v" sid="LUK 14:5"/>የሱስ ኡንቱንታ፥ “ህንተንቱፐ ሀሪ ዎይ ቦራይ ኦላን ኩንድንቶ፥ ሳምባታ ጊደ ኤሌል ከሰናዌ ኦኔ?” ጌዳ።<note caller="-" style="x"><char style="xo" closed="false">14:5 </char><char style="xt" closed="false"><ref loc="MAT 12:11">ማቶሳ 12:11</ref></char></note><verse eid="LUK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 14:6"/>ኡንቱንቱካ ሀ የዎ እት ዛሩዋነ እማናዉ ዳንዳይበይክኖ።<verse eid="LUK 14:6"/></para>
  <para style="s1">አሽከተባ</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7"/>የሱስ ሾበቶዋንቱ ቦንቾሳ ዶርያ ዎደ ጼሊደ፥ <verse eid="LUK 14:7"/><verse number="8" style="v" sid="LUK 14:8"/>“ኦንነ ቡላቻ ጼሶፐ፥ ቦንቼቴዳሳን ኡቶፓ፤ ኦን ኤር ኔፐ አደ ቦንቼቶዌ ጼሰቴዳዋ ግዳናዋ።<note caller="-" style="x"><char style="xo" closed="false">14:8-10 </char><char style="xt" closed="false"><ref loc="PRO 25:6">ሌም. 25:6</ref>፣ <ref loc="PRO 25:7">7</ref></char></note> <verse eid="LUK 14:8"/><verse number="9" style="v" sid="LUK 14:9"/>ኔናነ አነ ጼሳዌ ዪደ፥ ‘ሀዎ፥ ኡቱዋ አዉ ዬዳ’ ያግና፤ ሄ ዎድያን ዬላታደ ጻደና ደእያ ሳን ኡቱዋ ዶማሳ፤ <verse eid="LUK 14:9"/><verse number="10" style="v" sid="LUK 14:10"/>የዉዋን ቃይ ኔን ጼሴቶ ዎደ ኔና ጼሶዌ ዪደ፥ ‘ታ ላገዉ፥ ክል ቃሳን ኡታ’ ጋና ማላ፥ ባደ ኡባፐ ሆካሳን ኡታ፤ ሄ ዎደ ኔናና እትፐ ኡቴዳዋንቱ ኡባቱዋ ስንን ነዉ ቦንቹ እመታናዋ፤ <verse eid="LUK 14:10"/><verse number="11" style="v" sid="LUK 14:11"/>ባረ ሁጲያ ቁ ኦያ ኡባይ ቶሸታናዋ፤ ባረ ሁጲያ ቶችያዋንቱ ቁ ጊኖ” ያግ ሌምሱዋ ኡንቱንቶ ኦዴዳ።<note caller="-" style="x"><char style="xo" closed="false">14:11 </char><char style="xt" closed="false"><ref loc="MAT 23:12">ማቶሳ 23:12</ref>፤ <ref loc="LUK 18:14">ሉቃሳ 18:14</ref></char></note><verse eid="LUK 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12"/>የሱስ ባረና ጼሴዳዋ ዛሪደ፥ “ኔን ላጻ ዎይ ካዉዋ ጊግሴዳ ዎደ፥ ነ ላገቱዋ ዎይ ነ እሻቱዋ ዎይ ዱረ ነ ሾራቱዋ ጼሶፓ፤ አያዉ ጎፐ፥ ኡንቱንቱ ኔና ባረንቱ ታራን ጼሲደ ኩሽያ ጭጋና ዳንዳዪኖ። <verse eid="LUK 14:12"/><verse number="13" style="v" sid="LUK 14:13"/>ሽን አታልያባ ጊግሴዳ ዎደ፥ ህዬሳቱዋ፥ ጉንዳቱዋ፥ ዶማቱዋነ ቆቃቱዋ ጼሳ። <verse eid="LUK 14:13"/><verse number="14" style="v" sid="LUK 14:14"/>ኡንቱንቱ ነዉ ኩሽያ ዛራናዉ ዳንዳየናዋንታ ግድያ ድራዉ፥ ኔን አንጀታናሳ። ጽላቱ ሀይቁዋፐ ደንድያ ዎደ ጾሳይ ነዉ ኩሽያ ዛራናዋ” ያጌዳ።<verse eid="LUK 14:14"/></para>
  <para style="s1">ዎልቃማ ባላ ሌምሱዋ</para>
  <para style="r">(<ref loc="MAT 22:1-10">ማቶሳ 22:1-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15"/>የሱስ ሃሳያ ዉርስያ ዎደ፥ ቁማ ማናዉ ኡቶ አሳፐ እቱ ሀዋ ስሲደ፥ “ጾሳ ካዉተ ጋይታን ኡትያዌ አንጀቴዳዋ” ጌዳ።<verse eid="LUK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16"/>የሱስካ ሀዋዳን ጌዳ፤ “እት ብታኒ ዳሮ ሎኦ ካዉዋ ጊግሲደ፥ ጮራ አሳቱዋ ጼሴዳ። <verse eid="LUK 14:16"/><verse number="17" style="v" sid="LUK 14:17"/>ካዉዋ ዎዲ ጋክና፥ ካሰ ጼሰቶዋንታ፥ ‘ሀእ ካዉ ጊጌዳ፥ ሃይተ’ ጊደ ጼሳና ማላ ባረ ጎለን ኪተትያ ቆማ ኡንቱንቱኮ ኪቴዳ። <verse eid="LUK 14:17"/><verse number="18" style="v" sid="LUK 14:18"/>ሽን ኡባቱካ እትፐ፥ ቤናዳን አጋና ማላ ዎሴድኖ፤ ኮይሮ ብታኒ ቆማዉ ኦዲደ፥ ‘ታን ቢታ ሻሜዳ ድራዉ ባደ በአናዉ ኮሼ፤ ሄዋ ድራዉ ሀያ ጎዶ ታዉ ሀንቀቶፓርክ’ ጌዳ።<verse eid="LUK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 14:19"/>“ላኤንያዌ ቃይ፥ ‘ታን እቼሹ ዋ ቦራቱዋ ሻሜዳዋንታ ዋጻ በአናዉ ብያ ድራዉ፥ ሀያ ጎዶ ታዉ ሀንቀቶፓርክ’ ጌዳ።<verse eid="LUK 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 14:20"/>“ሀራይ ቃይ፥ ‘ታን ማቻቶ አኬዳ ድራዉ፥ ያናዉ ዳንዳያበይከ’ ጌዳ።<verse eid="LUK 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 14:21"/>“ቆማይካ ዪደ ባረ ጎዳዉ፥ ሀኖዋ ኡባ ኦዴዳ። ሄ ዎደ ጎዳይ ዳሮ ሀንቀቲደ፥ ባረ ጎልያን ኪተትያ ቆማ፥ ‘ህን ካታማ ኦግያነ ሎሶ ኦግያ ኤሌላደ ከሳ፤ ማንቃቱዋነ ጉንዳቱዋ፥ ዶማቱዋነ ቆቃቱዋ ሃ አካደ ያ’ ጌዳ።<verse eid="LUK 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 14:22"/>“አ ቆማይካ፥ ‘ጎዳዉ፥ ኔን ታና አዛዞዋዳን ኦድ፤ ሽን ሀእካ ሀራ አሳ አክያ ሳአይ ደኤ’ ጌዳ። <verse eid="LUK 14:22"/><verse number="23" style="v" sid="LUK 14:23"/>ጎዳይካ ባረ ቆማ፥ ‘ታ ጎሊ ኩማናዳን ህን ኦግያፐ ካረ ባጋነ ድርሳ ጋጻ ኡባ ከሳደ፥ አሳ ታ ጎለ አካደ ያ። <verse eid="LUK 14:23"/><verse number="24" style="v" sid="LUK 14:24"/>አያዉ ጎፐ፥ ኮይሮ ታ ጎለ ሾበቴዳዋንቱፐ እት አሳይነ ታ ቁማ ሜና’ ጌዳ” ያጌዳ።<verse eid="LUK 14:24"/></para>
  <para style="s1">የሱሳ ካላናዉ ባረና ያርሹሳ ኮሼ</para>
  <para style="r">(<ref loc="MAT 10:37-38">ማቶሳ 10:37-38</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25"/>ጮራ አሳይ የሱሳና እትፐ ብደእያ ዎደ፥ እካ አሳኮ ጉየ ስሚደ፥ <verse eid="LUK 14:25"/><verse number="26" style="v" sid="LUK 14:26"/>“ኦንነ ታኮ ይያዌ ደኦፐ ባረ አባነ አቶ፥ ባረ ማቻቶነ ባረ ናና፥ ባረ እሻቱዋነ ምቻቱዋ፥ ባረ ደኡዋ አሸናን ታፐ አ ዶሶፐ፥ ታና ካልያዋ ጌተታናዉ ዳንዳየና።<note caller="-" style="x"><char style="xo" closed="false">14:26 </char><char style="xt" closed="false"><ref loc="MAT 10:37">ማቶሳ 10:37</ref></char></note> <verse eid="LUK 14:26"/><verse number="27" style="v" sid="LUK 14:27"/>ኦንነ ባረ ማስቃልያ ቶኪደ፥ ታ ጌዱዋ ካለናን ዮፐ፥ ታና ካልያዋ ግዳናዉ ዳንዳየና።<note caller="-" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="MAT 10:38">ማቶሳ 10:38</ref>፤ <ref loc="MAT 16:24">16:24</ref>፤ <ref loc="MRK 8:34">ማር. 8:34</ref>፤ <ref loc="LUK 9:23">ሉቃሳ 9:23</ref></char></note><verse eid="LUK 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28"/>“ህንተንቱፐ እቱ ሹቻ ጎልያ ኬጻናዉ ኮዮፐ፥ ኪታ ዉርሳናዉ ግድያ ሻሉዋ ካሰቲደ ኡት ሄተናዌ ኦኔ? <verse eid="LUK 14:28"/><verse number="29" style="v" sid="LUK 14:29"/>ሄዌ ዮፐ፥ ጎልያ ዶሚደ፥ ኪታ ዉርሳናዉ ዎልቃይ እጾፐ፥ <verse eid="LUK 14:29"/><verse number="30" style="v" sid="LUK 14:30"/>በኤዳዋንቱ ኡባይ፥ ‘ሀ ብታኒ ኬጻናዉ ዶሜዳ፤ ሽን ኪታ ዉርሳናዉ ዳንዳይቤና’ ጊደ ቅሊጪኖ።<verse eid="LUK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31"/>“ዎይ ታሙ ሻአ ኦላንቻቱዋ ኦይቄዳ እት ካቲ፥ ሀራ ላታሙ ሻአ ኦላንቻቱዋ ኦይቄዳዋንቱና ኦለታናዉ ዳንዳዮፐነ ኮይሮና፥ ታን ጾናኔ ጾንክታሻ ጊደ ኡት ቆፐኔ? <verse eid="LUK 14:31"/><verse number="32" style="v" sid="LUK 14:32"/>ባረዉ ዳንዳየተናን ዮፐ፥ ኦላዉ ይያ የኮ ካቲ ሃኩዋን ደእሽን ኪቲደ ስገታናዉ ዎሴ። <verse eid="LUK 14:32"/><verse number="33" style="v" sid="LUK 14:33"/>ስም ሀዋዳንካ ህንተንቱፐ ኦንነ ባረዉ ደእያዋ ኡባ አገናዌ፥ ታና ካልያዋ ግዳናዉ ዳንዳየና።<verse eid="LUK 14:33"/></para>
  <para style="s1">ጎኤና ማጽንያባ</para>
  <para style="r">(<ref loc="MAT 5:13">ማቶሳ 5:13</ref>፤ <ref loc="MRK 9:50">ማር. 9:50</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34"/>“ማጽኒ ሎአ፤ ሽን ሎቅሎቀናን ዮፐ፥ ላኤን አ ዎት ሎቅሎቅሳናዉ ዳንዳየቲ? <verse eid="LUK 14:34"/><verse number="35" style="v" sid="LUK 14:35"/>ቢታዉካ ሎኤና፤ ቱኤያናዉካ ማደናዋ ግዶ ድራዉ፥ አሳይ አ ኦል አጌ። ስስያ ሀይይ ደእያዌ ሀዋ ስሶ” ያጌዳ።<verse eid="LUK 14:35"/></para>
  <chapter eid="LUK 14"/>
  <chapter number="15" style="c" sid="LUK 15"/>
  <para style="s1">ባዬዳ ዶርሳ</para>
  <para style="r">(<ref loc="MAT 18:12-14">ማቶሳ 18:12-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1"/>እት ጋላስ፥ ቃራጻ ሺሽያዋንቱነ ናጋራንቻቱ ኡባይ የሱሳ ስሳናዉ አኮ ሺቄድኖ። <verse eid="LUK 15:1"/><verse number="2" style="v" sid="LUK 15:2"/>ፓርሳዋቱነ ሙሴ ህግያ ታማርስያዋንቱ፥ “ሀ ብታኒ፥ ናጋራንቻቱዋ ሺሽያዋነ ኡንቱንቱና ቁማ ምያዋ” ያጊደ ዙዙሜድኖ።<note caller="-" style="x"><char style="xo" closed="false">15:2 </char><char style="xt" closed="false"><ref loc="LUK 5:29-30">ሉቃሳ 5:29-30</ref></char></note> <verse eid="LUK 15:2"/><verse number="3" style="v" sid="LUK 15:3"/>የሱስካ ሌምሱዋን ዛሩዋ ሀዋዳን ያግ ኦዴዳ:<verse eid="LUK 15:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 15:4"/>“ጼቱ ዶርሳይ ደእያ ኡራይ ህንተንቱ ግዶፐ ደእንቶ ሄዋፐ እቱ ባይንቶ ኡዱፑ ታማነ ኡዱፑኑዋ ደንባን አጊደ ባዬዳዋ ቤታና ጋካናዉ ኮየናዌ ኦኔ? <verse eid="LUK 15:4"/><verse number="5" style="v" sid="LUK 15:5"/>ደሜዳ ዎደ ናሸቻን ባረ ሀሽያ ቦላን ዶርሳ ቶክ፥ <verse eid="LUK 15:5"/><verse number="6" style="v" sid="LUK 15:6"/>ባረ ጎለ ስሚደ፥ ባረ ዶስያዋንታነ ሾራቱዋ እትፐ ጼሲደ፥ ‘ባዬዳ ታ ዶርሳ ደሞ ድራዉ፥ ታናና እትፐ ናሸትተ’ ያጊደ ኦዴ። <verse eid="LUK 15:6"/><verse number="7" style="v" sid="LUK 15:7"/>ሄዋዳንካ ናጋራ ፓጸ ኮሸና ኡዱፑ ታማነ ኡዱፑ ጽላቱዋፐ አደ ናጋራ ፓጽያ እት ናጋራንቻን ሳሉዋን ዳሮ ናሸቻይ ግዳናዋ።<verse eid="LUK 15:7"/></para>
  <para style="s1">ባዪደ ቤቴዳ ሳንትምያ</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8"/>“ቃይካ ታሙ ናሃስያ ሳንትሚ<note caller="+" style="f"><char style="fr" closed="false">15:8</char><char style="fk" closed="false">ናሃስያ ሳንትሚ፦ </char><char style="ft" closed="false">ግሪከ ቃላ ብለን እትና፥ እት ጋላሳ ሙምያ ኦ ፔሼዳ ዎልቃ ኦሳንቻዉ ጭገትያ ሚሻ ኬና ግድያዋ ኦዴ።</char></note> ደእያ ምሽራታ ታሙዋፐ እቱ ባይንቶ ደማና ጋካናዉ ጾምፕያ ጾምፓደ፥ ጎልያ ፕታደ ሎይ ኮየናዉና እዛ ኦኔ? <verse eid="LUK 15:8"/><verse number="9" style="v" sid="LUK 15:9"/>እዛካ ደሜዳ ዎድያን ባረ ዶስያዋንታነ ባረ ሾራቱዋ እትፐ ጼሳደ፥ ‘ታፐ ባዬዳ ሳንትምያ ደሜዳ ድራዉ፥ ታናና እትፐ ናሸትተ’ ያጋደ ኦዳዉ። <verse eid="LUK 15:9"/><verse number="10" style="v" sid="LUK 15:10"/>ሄዋዳንካ ናጋራ ፓጽያ እት ናጋራንቻ ጋሶተን ጾሳ ኪታንቻቱዋ ስንን ናሸቻይ ሀናናዋ” ያጌዳ።<verse eid="LUK 15:10"/></para>
  <para style="s1">ባያ ናኣ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11"/>ጉጂደ የሱስ፥ “ላኡ ናናይ ደእያ እት ብታኒ ደኤ፤ <verse eid="LUK 15:11"/><verse number="12" style="v" sid="LUK 15:12"/>ኡንቱንቱፐካ ቴፋ ናአይ፥ ‘ነ ማጹዋፐ ታና ጋክያዋ እማ’ ጌዳ። አዉካ ባረ ማጹዋፐ ናናቶ ግሼዳ። <verse eid="LUK 15:12"/><verse number="13" style="v" sid="LUK 15:13"/>ጉ ዎድያፐ ጉይያን ቴፋ ናአይ ባረና ጋኬዳዋ ኡባ ሺሽ አኪደ ህን ሃኮ ጋደ ቤዳ፤ ሄዋን ባረ አኬዳ ሚሻ ኡባ ላል ዉርስ አጌዳ። <verse eid="LUK 15:13"/><verse number="14" style="v" sid="LUK 15:14"/>እካ ደእያዋ ኡባ ዉርሴዳዋፐ ጉይያን ሄ ጋደን ዎልቃማ ኮሻይ ገሌዳ፤ እካ መቱዋን ኡንኤቱሳ ዶሜዳ። <verse eid="LUK 15:14"/><verse number="15" style="v" sid="LUK 15:15"/>ሀዋ ድራዉ ሄ ጋደን ደእያዋንቱፐ እቱዋኮ ሺቂደ፥ ‘ታና ነዉ ቆማ ኦርኪ?’ ያግና፥ ብታኒካ ባረ ጉዱን ዉድያ ሄማና ማላ አ ደምባ የዴዳ። <verse eid="LUK 15:15"/><verse number="16" style="v" sid="LUK 15:16"/>ጉዱን ዉዲ ምያ ሀልኡዋ ማናዉ አሞቴዳ፤ ሽን ሄዌንቶካ አዉ እምያዌ ቤትቤና።<verse eid="LUK 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 15:17"/>“ባረ ባይዙዋ ኤሮ ዎደ፥ ‘ቁማይ ጾኒደ ሳኣን አትያ ታ አቦ ኦያዋንቱ አፑኔ፤ ሽን ታን ሀዋን ኮሻን ሀይቃና ማታይታ? <verse eid="LUK 15:17"/><verse number="18" style="v" sid="LUK 15:18"/>ደንዳደ ታ አቡኮ ባኔ’ ሀዋዳን ያጋና፤ ‘ታ አቦ፥ ጾሳካ ኔናካ ናቃድ፤ <verse eid="LUK 15:18"/><verse number="19" style="v" sid="LUK 15:19"/>ሀንፐ ጉየ ነ ናኣ ያገታደ ጼሰታናዉ በስከ፤ ነዉ ኪተትያዋንቱፐ እቱዋዳን ታና ዎርኪ ጋና’ ጌዳ። <verse eid="LUK 15:19"/><verse number="20" style="v" sid="LUK 15:20"/>ሄ ማንእያን ደንዲደ ባረ አቡኮ ዬዳ።</para>
  <para style="p" vid="LUK 15:20">“እ ብሮ ሃኩዋን ደእሽን፥ አዉ በኢደ፥ አዉ ቃረቴዳ፤ አኮ ዎጽ ቢደ፥ አ እድም የሬዳ።<verse eid="LUK 15:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 15:21"/>“ናአይካ፥ ‘ታ አቦ፥ ታን ጾሳካ ኔናካ ናቃድ፤ ሀንፐ ጉየ ነ ናኣ ጌተታደ ጼሰታናዉ በስከ’ ያጌዳ።<verse eid="LUK 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 15:22"/>“ሽን አዉ ባረ ኦሳንቻቱዋ፥ ‘ኤሌል ቢደ፥ ኡባፐ ዶረቴዳ ሎኦ ማዩዋ አሂደ፥ አ ማይዝተ፤ አ ብራያን ምግዱዋ፥ አ ገድያንካ ጫማ<note caller="+" style="f"><char style="fr" closed="false">15:22 </char><char style="fqa" closed="false">ምግዱዋ፥ ጫማ፦ </char><char style="ft" closed="false">ሀ ቃላቱ ናኣ አቡ፥ አ ፖሎ ዎዛናፐ አኮዋ በስያዋንታ። ምግዱ፥ ሄ ናአይ ጎለን ደእያ አሳቱዋ ኡባፐ ሎኦ ጼለቴዳዋ በሴ። ጫማይ ቃይ፥ እ ባረ አቦ አይለ ግደናዳን ናኣ ግድያዋ በሴ። አይላቱ ሄ ዎደ ጫማ ዎክኖ።</char></note> ዎተ። <verse eid="LUK 15:22"/><verse number="23" style="v" sid="LUK 15:23"/>ሞዳ ኮሩማ አሂደ ሹክተ፤ ሞይተ፥ ናሸቶይተ። <verse eid="LUK 15:23"/><verse number="24" style="v" sid="LUK 15:24"/>አያዉ ጎፐ፥ ሀዌ ታ ናአይ ሀይቄዳ፤ ሽን ሀእ ፓጼዳ፤ ባዬዳ፤ ሽን ሀእ ቤቴዳ’ ያግና፥ ናሸቻ ዶሜድኖ።<verse eid="LUK 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25"/>“ሄ ዎድያን፥ ባይራ ናአይ ጋደን ደእያዌ ዪደ ጎለኮ ማትያ ዎደ፥ የነ ዱሩዋ ኮሹንቻ ስሴዳ። <verse eid="LUK 15:25"/><verse number="26" style="v" sid="LUK 15:26"/>እካ የዉ አየንቶ ኤራናዉ ኮዪደ፥ ቆማቱዋፐ እቱዋ ጼሲደ፥ ‘ሀዌ አዬ?’ ጊደ ኦቼዳ። <verse eid="LUK 15:26"/><verse number="27" style="v" sid="LUK 15:27"/>ቆማቱካ፥ ‘ነ እሻይ ሳሮ ዬዳ ድራዉ፥ ነ አቡ ሞ ኮሩማ አዉ ሹኬዳ’ ያግ ኦዴድኖ።<verse eid="LUK 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28"/>“ባይራ ናአይ ሀንቀቲደ ጎለ ገልከ ያግ እጽና፥ አዉ ካረዉ ከሲደ፥ ገላናዳ ዎሴዳ። <verse eid="LUK 15:28"/><verse number="29" style="v" sid="LUK 15:29"/>ሽን እ ዛሪደ ባረ አባ፥ ‘ሄኮ ሀዋ ኬና ዎድያ ቆማዳን ነዉ ኪተታድ፤ ነ አዛዞዋፐ እቱዋነካ ፓጭሳ በይከ፤ ታ ላገቱዋና እትፐ ናሸታና ማላ ሀራይ አቶ እት ዴሻ ቡልኡዋነ ታዉ እማ በይካ፤ <verse eid="LUK 15:29"/><verse number="30" style="v" sid="LUK 15:30"/>ሽን ሀዌ ነ ናአይ ነ ሚሻ ጫራቱዋና እትፐ ዲፍሲደ ዪና፥ ኮ ቦራ ሹካዳ’ ያጌዳ።<verse eid="LUK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 15:31"/>“አዉካ አ፥ ‘ታ ናአዉ፥ ኔን ኡባ ጋላሳ ታናና እትፐ ደኣ፤ ታሳ ግዴዳባይ ኡባይካ ነዋ። <verse eid="LUK 15:31"/><verse number="32" style="v" sid="LUK 15:32"/>ሽን ሀዌ ነ እሻይ፥ ሀይቄዳዌ ፓጾ ድራዉነ ባዬዳዌ ቤቶ ድራዉ፥ ኑን ሚድነ ኡሺደ ናሸታናዉ በሴ’ ያጌዳ” ጊደ ኦዴዳ።<verse eid="LUK 15:32"/></para>
  <chapter eid="LUK 15"/>
  <chapter number="16" style="c" sid="LUK 16"/>
  <para style="s1">ጋርሳና ሱንተ አኬዳ ጭንጫ ብታንያ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1"/>የሱስ ባረና ካልያዋንቶ ኦዲደ፥ “እት ዱረ ብታኒ፥ ባረ ጎልያ ኡባ ቦላ ሱንዳ እት ብታኒ ደኤ፤ ሽን ሀ ብታኒ አ ሚሻ ባይዜ ያግያ ዝግርሳይ አ ጋኬዳ፤ <verse eid="LUK 16:1"/><verse number="2" style="v" sid="LUK 16:2"/>ሄዋ ድራዉ ባረ ሱንዳ ብታንያ ጼሲደ፥ ‘ሀዌ ታን ስስያ የዉ አዬ? ሀንፐ ጉየ ኔን ታ ጎልያንነ ታ ሚሻ ቦላ ታፐ ጋርሳና ሱንታደ ኪተታናዉ ዳንዳያቤና ድራዉ፥ ሀቼ ጋካናዉ ኪተቴዳዋ ሄታደ ሼ’ ያጌዳ።<verse eid="LUK 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 16:3"/>“ሱንቴዳዌ ባረ ዎዛናን፥ ‘ታ ጎዳይ ታና ሱንተፐ ኮላና ሀኔ፤ ሽን ታ ዋኖሻ? ጎሻናዉ ዎልቃይ ታዉ ባዋ፤ ዎሳናዉ ቃይ ታዉ ፖኬ። <verse eid="LUK 16:3"/><verse number="4" style="v" sid="LUK 16:4"/>ታ ኦናባ ታ ኤራይ፤ እ ታና ሱንተፐ ከሶፐ፥ ባረንቱ ጎለ ቢና፥ ታና ሞክያ ላገቱዋ ታን ደማና’ ያጌዳ።<verse eid="LUK 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5"/>“ባረ ጎዳፐ ሻሉዋ ታልኤዳ አሳቱዋ ሁጲያን ሁጲያን ጼሲደ፥ ኮይሮ ብታንያ፥ ‘ኔን ታ ጎዳፐ ዎይሳ ኬና ሻሉዋ ታልኣዲ?’ ያጌዳ።<verse eid="LUK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 16:6"/>“እካ፥ ‘ታን ጼቱ ባሬታ ኩሜዳ ዛይትያ ታልኣድ’ ያጌዳ።</para>
  <para style="p" vid="LUK 16:6">“ሱንቴዳ ብታኒካ፥ ኔን ፓራማና ዋራቃታ ሄይ፤ ኡታደ ኤለካ ‘እሻታማ’ ጋደ ጻፋ ያጌዳ።<verse eid="LUK 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 16:7"/>“ሄዋፐ ሀራ ብታንያ፥ ‘ኔን አፑኑዋ ታልኣዲ?’ ያጌዳ።</para>
  <para style="p" vid="LUK 16:7">“ ‘ጼቱ ቁንኣ ዛርጋ’ ያጌዳ።</para>
  <para style="p" vid="LUK 16:7">“ሱንይካ፥ ‘ዋራቃታ ሄይ፤ ሆስፑን ታማ ጋደ ጻፋ’ ያጌዳ።<verse eid="LUK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 16:8"/>“ሄ ሱንይ ጭንጫተን ኦዳ ድራዉ፥ አ ጎዳይ አ ጋላቴዳ፤ አያዉ ጎፐ፥ ሀ አላምያ አሳይ ባረንቱዎ ፖኡዋ አሳፐ አዳ ጭንጫቱዋ።<verse eid="LUK 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 16:9"/>“ታን ህንተንቶ ያጋይ፥ ‘ሀ አላምያ ሻሉ ዉርያ ዎደ፥ መናዉ ዉረና ጎልያን ህንተንታ ሞካና ማላ፥ ሀ ሚሻን ህንተንቶ ላግያ ደምተ። <verse eid="LUK 16:9"/><verse number="10" style="v" sid="LUK 16:10"/>ላፋ የዉዋን አማነቴዳዌ፥ ዎጋባንካ አማነቴ። ሽን ላፋ የዉዋን አማነትቤናዌ፥ ዎጋባንካ አማነተና። <verse eid="LUK 16:10"/><verse number="11" style="v" sid="LUK 16:11"/>ስም ህንተንቱ ሀ አላምያ ሻሉዋን አማነተናዋ ግዶፐ፥ ቱማተ ሻሉዋ ህንተንቶ ኦኔ ሀዳራ ጊደ እማናዌ? <verse eid="LUK 16:11"/><verse number="12" style="v" sid="LUK 16:12"/>ህንተንቱ ሀራ አሳ ሻሉዋን አማነተናዋ ግዶፐ፥ ህንተንቱ ሚሻ ኦኔ ህንተንቶ እማናዌ?’ ጌዳ።<verse eid="LUK 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13"/>“እት ካላ ላኡ ጎዳቶ ቆማታናዉ ዳንዳይያዌ አይ ቆማይካ ባዋ፤ አያዉ ጎፐ፥ እቱዋ እጺደ፥ ሀራ ዶሴ፤ ዎይ እቱዋ ቦንቺደ፥ ሀራ ካ፤ ጾሳዉነ ሻሎ ሞደታናዉ ዳንዳይክታ” ያጌዳ። <verse eid="LUK 16:13"/><verse number="14" style="v" sid="LUK 16:14"/>ሻሉዋ ዶስያ ፓርሳዋቱ ሀዋ ኡባ ስሲደ፥ የሱሳ ቦላ ቅሊጬድኖ። <verse eid="LUK 16:14"/><verse number="15" style="v" sid="LUK 16:15"/>ሽን የሱስ ኡንቱንታ፥ “ህንተንቱ አሳ ስንን ህንተንታ ጽሎ አሳ ኦያዋንታ፤ ሽን ጾሳይ ህንተንቱ ዎዛና ኤሬ፤ አያዉ ጎፐ፥ አሳ ስንን ቦንቼቴዳዌ ጾሳ ስንን ቱና ግዴ።<verse eid="LUK 16:15"/></para>
  <para style="s1">ሙሴ ህግያባነ ገሉዋ አካባ</para>
  <para style="r">(<ref loc="MAT 5:31-32">ማቶሳ 5:31-32</ref>፤ <ref loc="MAT 11:12-13">11:12-13</ref>፤ <ref loc="MRK 10:11-12">ማር. 10:11-12</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16"/>“ሙሴ ህግያነ ናባቱ ጻፌዳ ማጻፋ<note caller="+" style="f"><char style="fr" closed="false">16:16 </char><char style="fqa" closed="false">ሙሴ ህግያነ ናባቱ ማጻፋ፦ </char><char style="ft" closed="false">አይሁዳቱዋ ጌሻ ማጻፋቱዋ፤ ሄዋንታ ጉሳይ ኤጫ ጫቁዋ ማጻፋ።</char></note> ዮሃንሳ ዎድያ ጋካናዉ አሳይ አዛዘቲደ ደኤድኖ፤ ሄዋፐ ካላ ቃይ ጾሳ ካዉተይ ኦደቴዳ፤ አሳይ ኡባይ ያ ገላናዉ ኬሰቴ።<note caller="-" style="x"><char style="xo" closed="false">16:16 </char><char style="xt" closed="false"><ref loc="MAT 11:12">ማቶሳ 11:12</ref>፣ <ref loc="MAT 11:13">13</ref></char></note> <verse eid="LUK 16:16"/><verse number="17" style="v" sid="LUK 16:17"/>ሽን ህግያፐ እትባይ አትያዋፐ ሳሉነ ሳአይ አያዌ ማታቴ።<note caller="-" style="x"><char style="xo" closed="false">16:17 </char><char style="xt" closed="false"><ref loc="MAT 5:18">ማቶሳ 5:18</ref></char></note><verse eid="LUK 16:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18"/>“ባረ ማቻቶ ብሊደ ሀራሮ አክያዌ ኡባይ ዎሹሜ፤ ቃይ አስናፐ ብለቴዳ ማጫዉኖ አክያዌ ኦንነካ ዎሹሜ።<note caller="-" style="x"><char style="xo" closed="false">16:18 </char><char style="xt" closed="false"><ref loc="MAT 5:32">ማቶሳ 5:32</ref>፤ <ref loc="1CO 7:10">1 ቆሮ. 7:10</ref>፣ <ref loc="1CO 7:11">11</ref></char></note><verse eid="LUK 16:18"/></para>
  <para style="s1">ዱረ ብታንያባነ ማንቆ ግዴዳ አልኣዛራባ</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19"/>“ጋቲ ሎይደ አልኦ ግዴዳ ማዩዋ ማዪድነ ጋላሳን ጋላሳን ኦቶሩዋን ናሸቲደ ደእያ እት ዱረ ብታኒ ደኤ። <verse eid="LUK 16:19"/><verse number="20" style="v" sid="LUK 16:20"/>ቃይካ ኩመን አሳተን ማይይ ደእያ እት አልኣዛራ ጌተትያ ህዬሳይ፥ ሀ ዱረ ብታንያ ካርያን ግሴዳ። <verse eid="LUK 16:20"/><verse number="21" style="v" sid="LUK 16:21"/>ሀ ዱረ ብታንያ ሳምፓፐ ላለቴዳ ሱፓ ማናዉ አሞቴ፤ ሀራይ አቶ ካናቱካ ዪደ አ ማይ ላጪኖ።<verse eid="LUK 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22"/>“ሀ ህዬሳ ብታኒ ሀይቂና፥ ኪታንቻቱ አ አብራሃሞ ባጋ ቦንቾሳ አፌድኖ፤ ዱረ ብታኒካ ቃይ ሀይቂደ ሞገቴዳ። <verse eid="LUK 16:22"/><verse number="23" style="v" sid="LUK 16:23"/>ስኦልያን ዳሮ ሴለቲደ ደእሽን፥ ቁ ጊደ ሃኩዋን አልኣዛራ፥ አብራሃሞ ባጋን ደእያዋ በኤዳ።<verse eid="LUK 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 16:24"/>“እካ ባረ ኮሻ ቁ ኦደ፥ ‘አብራሃሞ፥ ታ አቦ፥ ታዉ ቃረታ። ሀ ታማ ሴላን መቶታ ደእያ ድራዉ፥ አልኣዛር ባረ ብራያ ጼራ ሃን ቦቺደ፥ ታ እንጻርሳ እርጽሳናዳን ሀያና ታኮ ኪታርኪ’ ያጌዳ።<verse eid="LUK 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25"/>“አብራሃሞ ቃይ፥ ‘ታ ናአዉ፥ ኔን ፓጻ ደኣደ፥ ሎኦ ደኡዋ ደእና፥ አልኣዛር ሎኤና መቶ ደኡዋ ደኤዳዋ ቆፓ። ሀእ ቃይ እ ሀዋን ናሸትያ ዎደ፥ ኔን መቱዋ ቦላ ደኣ።<verse eid="LUK 16:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 16:26"/>“ ‘ሀዋፐ ሀራይ ቃይ፥ ሀዋፐ ያ ህንተንቱኮ አናዉ ኮይያዋንቱ አናዳን፥ ያን ደእያዋንቱካ ቃይ ሃ ኑኮ ፕነናዳን፥ ኑ ግዶንነ ህንተንቱ ግዶን ዎጋ አፉ መቴዳ’ ያጌዳ።<verse eid="LUK 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 16:27"/>“ዱረ ብታኒካ፥ ‘አብራሃሞ፥ ስም ሄዋ ግዶፐ፥ ኔን አልኣዛራ ታ አቡ ጎለ የዳና ማላ፥ ኔና ዎሳይ። <verse eid="LUK 16:27"/><verse number="28" style="v" sid="LUK 16:28"/>አያዉ ጎፐ፥ ታዉ እቼሹ እሻቱ ደእያ ድራዉ፥ ኡንቱንቱ ቃይ ሀ መቱዋሳ ዬና ማላ፥ ኡንቱንቶ አልኣዛር ቢደ ማርካቶ’ ያጌዳ።<verse eid="LUK 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29"/>“አብራሃሞ ቃይ፥ ‘ሙሴነ ናባቱ ጻፌዳ ማጻፋይ ኡንቱንቶ ደኤ፤ ሄ ማጻፋይ ግያዋ ኡንቱንቱ ስሲኖ’ ያጌዳ።<verse eid="LUK 16:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 16:30"/>“ዱረ ብታኒ፥ ‘ህኢ፤ አብራሃሞ፥ ታ አቦ፥ ሄዋ ግደና፤ ሽን እት ብታኒ ሀይቁዋፐ ደንዲደ፥ ኡንቱንቱኮ ብንቶ፥ ኡንቱንቱ ባረንቱ ናጋራ ፓጺደ፥ ስማናዋንታ’ ያጌዳ።<verse eid="LUK 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 16:31"/>“አብራሃሞካ፥ ‘ኡንቱንቱ ሙሴነ ናባቱ ጻፌዳ ማጻፋ ስሰናዋ ግዶፐ፥ ሀራይ አቶ እት ኡራይ ሀይቁዋፐ ደንድ ይንቶካ አማንክኖ’ ጌዳ” ያጌዳ።<verse eid="LUK 16:31"/></para>
  <chapter eid="LUK 16"/>
  <chapter number="17" style="c" sid="LUK 17"/>
  <para style="s1">ናጋራባ የሱስ ኦዴዳ</para>
  <para style="r">(<ref loc="MAT 18:6">ማቶሳ 18:6</ref>፣ <ref loc="MAT 18:7">7</ref>፣ <ref loc="MAT 18:21">21</ref>፣ <ref loc="MAT 18:22">22</ref>፤ <ref loc="MRK 9:42">ማር. 9:42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1"/>የሱስ ባረና ካልያዋንታ፥ “አሳ ባለያዌ ዬናን አተና፤ ሽን ባለያዋ አህያ ኡራዉ አዉ አየ፤ <verse eid="LUK 17:1"/><verse number="2" style="v" sid="LUK 17:2"/>ሄ ብታኒ ሀ ጉቱዋፐ እቱዋ ባለያዋፐ፥ ጋጭያ ዎጻ ባረ ቆያን ቃሸቲደ አባን ምተትያዌ አዉ ሎአ። <verse eid="LUK 17:2"/><verse number="3" style="v" sid="LUK 17:3"/>ህንተ ሁጰዉ ናገትተ።</para>
  <para style="p" vid="LUK 17:3">“ነ እሻይ ኔና ናቆፐ፥ አ ዞራ። ቃይ ናጋራፐ እ ስሞፐ፥ አዉ አቶ ያጋ። <verse eid="LUK 17:3"/><verse number="4" style="v" sid="LUK 17:4"/>እት ጋላስ እ ኔና ላፑ ገደ ናቂደ፥ ላፑ ገደካ፥ ‘ኔና ታ ናቃድ፥ ታና ማራ’ ጊደ ኔኮ ዮፐ፥ አዉ አቶ ጋ” ያጌዳ።<verse eid="LUK 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5"/>ኪተቴዳዋንቱካ ጎዳ፥ “ኑዉ አማኑዋ ጉጃ” ያጊደ ኦቼድኖ።<verse eid="LUK 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6"/>ጎዳይካ፥ “ህንተዉ ሳናፍጭያ አይፍያ ኬና አማኑ ደእንቶ፥ ህንተንቱ ሀ ቦእያ፥ ‘ሀዋፐ ሾደታደ፥ አባን ቶከታ’ ግንቶ ህንተዉ ኤኖ ጋና” ያጌዳ።<verse eid="LUK 17:6"/></para>
  <para style="s1">ቆማይ ኦናዉ በስያ ኦሱዋ</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7"/>ቃይካ የሱስ፥ “ህንተፐ ጎሽያዌ ዎይ ምያ ሄምያ ቆማይ ደእያ አሳይ ሀቀት ደኦፐ፥ ጎሻ ጋደፐ ዎይ ምያ ጋደፐ ስሞ ዎደ ኤለካ፥ ‘ሃያ ሸምፓ አካ፥ ቁማ ማናዉ ኡታ’ ያግያዌ ኦኔ? <verse eid="LUK 17:7"/><verse number="8" style="v" sid="LUK 17:8"/>የዉዋን ቃይ፥ ‘ታ ማና ካዉዋ ጊግሳ፤ ታ ማናነ ኡሻና ጋካናዉ ምናደ ታና ኤቃደ ምዛ። ሄዋፐ ጉየ ነዉ ማ፥ ኡሻ’ ያግያዋ ግደኔ? <verse eid="LUK 17:8"/><verse number="9" style="v" sid="LUK 17:9"/>ሄ ቆማይ ኪተቴዳባ ኦዳ ድራዉ፥ ሄ ብታኒ ጋላታናዉ በሰኔ? <verse eid="LUK 17:9"/><verse number="10" style="v" sid="LUK 17:10"/>ሄዋዳንካ ህንተ ቃይ አሳይ ህንተና ኪቶ ኦሱዋ ኦዳ ዎደ፥ ‘ኑን ማደና ቆማቱዋ፤ ኑ ኦሶ ጻላላ ኦዶ’ ያግተ” ያጌዳ።<verse eid="LUK 17:10"/></para>
  <para style="s1">የሱስ ኦሉ ኦይቄዳ ታሙ አሳቱዋ ፓዳ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11"/>የሱስ የሩሳላመ ቢደ፥ ጋሊላፐነ ሳማርያ ግያ ጋዳቱዋፐ ግዱዋና አዳ። <verse eid="LUK 17:11"/><verse number="12" style="v" sid="LUK 17:12"/>እ እት ጉ ካታማቶ ገልያ ዎድያን፥ ሃኩዋን ኤቄዳ ታሙ ኦሉዋን ኦይቀቴዳዋንቱ አ በኤድኖ። ኡንቱንቱካ ሃኩዋን ኤቂደ፥ <verse eid="LUK 17:12"/><verse number="13" style="v" sid="LUK 17:13"/>ባረንቱ ኮሻ ቁ ኦደ፥ “የሱሳ፥ ጎዳዉ፥ ሀያ ጎዶ ኑና ፓርኪ!” ያጌድኖ።<verse eid="LUK 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14"/>የሱስ ኡንቱንታ በኢደ፥ “ቢደ፥ ህንተንቱ ቦላ ቄሳቱዋ በስተ” ያጌዳ።</para>
  <para style="p" vid="LUK 17:14">ኡንቱንቱካ ቄሳቱዋኮ ብደኢደ ኦሉዋፐ ፓጼድኖ።<note caller="-" style="x"><char style="xo" closed="false">17:14 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">ዎጋ 14:1-32</ref></char></note><verse eid="LUK 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 17:15"/>ኡንቱንቱፐ እቱ ባረ ሀርግያፐ ፓጼዳዋ በኢደ፥ ባረ ኮሻ ቁ ኦደ፥ ጾሳ ቦንቺደ ስሜዳ። <verse eid="LUK 17:15"/><verse number="16" style="v" sid="LUK 17:16"/>ጋላቲደካ የሱሳ ገድያ ማታን ጉልባቴዳ። ሄ ብታኒ ሳማርያ አሳ።<verse eid="LUK 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 17:17"/>የሱስ ዛሪደ፥ “ታሙ ፓጽበይክኖ? ያትና ኡዱፑናቱ ሀቃን ደኢኖ? <verse eid="LUK 17:17"/><verse number="18" style="v" sid="LUK 17:18"/>አይሁዳ አሳ ግደና ሳማርያ ብታንያፐ አትን፥ ጾሳ ቦንቻናዉ ስሜዳዋንቱ ባዋ ጉሴ?” ያጌዳ። <verse eid="LUK 17:18"/><verse number="19" style="v" sid="LUK 17:19"/>የሱስ አ፥ “ደንዳ ባ፤ ነ አማኑ ኔና ፓዳ” ያጌዳ።<verse eid="LUK 17:19"/></para>
  <para style="s1">ጾሳ ካዉተ ዩሳባ</para>
  <para style="r">(<ref loc="MAT 24:23-28">ማቶሳ 24:23-28</ref>፣ <ref loc="MAT 24:37-41">37-41</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20"/>ፓርሳዋቱ እት ጋላስ፥ “ጾሳ ካዉተይ አዉደ ያኔ?” ጊደ ኦችና የሱስ፥ “ጾሳ ካዉተይ ህንተንቱ ናግያ ኦግያን ዬና” ያግ ዛሬዳ። <verse eid="LUK 17:20"/><verse number="21" style="v" sid="LUK 17:21"/>ቃይካ፥ “ኦንነ፥ ‘ጾሳ ካዉተይ ሀዋን ደኤ’፥ ዎይ ‘ሄዋን ደኤ’ ጋናዉ ዳንዳየና፤ ጾሳ ካዉተይ ህንተንቱ ዎዛና ግዶን ደኤ” ያጌዳ።<verse eid="LUK 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22"/>የሱስ ባረና ካልያዋንቶ ኦዲደ፥ “አሳ ናአይ ቆንጭያ ጋላሳቱዋፐ እቱዋ በአናዉ ህንተንቱ አሞትያ ዎዲ ያና፤ ሽን በእክታ። <verse eid="LUK 17:22"/><verse number="23" style="v" sid="LUK 17:23"/>ቃይ ኡንቱንቱ ህንተና፥ ‘ሀዌኩ ሀዋና’ ዎይ ‘ሄዋና’ ያጋናዋንታ። ሽን ኡንቱንታ ካሊደ፥ ኡንቱንቱና ቦፕተ። <verse eid="LUK 17:23"/><verse number="24" style="v" sid="LUK 17:24"/>ዋልቃንይ ሳሉዋን ዎልቃምያ ዎደ፥ ሀ ጋጻፐ ህን ጋጻ ፖኡ ፖእያዋዳን፥ አሳ ናኣ ዩሳይካ ሄዋዳን ሀናናዋ። <verse eid="LUK 17:24"/><verse number="25" style="v" sid="LUK 17:25"/>ሽን ኮይሮቲደ አሳ ናአይ ዳሮ መቱዋ መቶታናዉነ ሄ ዎድያን ደእያ የለታን እጸታናዉ በሴ።<verse eid="LUK 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 17:26"/>“ኖሄ ዎድያን ሀኖዋዳንካ፥ አሳ ናአይ ቆንጭያ ጋላሳንካ ሄዋዳን ሀናናዋ።<note caller="-" style="x"><char style="xo" closed="false">17:26 </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">ዶመ 6:5-8</ref></char></note> <verse eid="LUK 17:26"/><verse number="27" style="v" sid="LUK 17:27"/>ኖሄ ማርካብያ ገሎ ጋላሳይ ጋካናዉ ኡንቱንቱ፥ ሚድነ ኡሺደ፥ አኪድነ አከቲደ ደእሽን፥ ባሻ ሃይ ዪደ ኡባ አሳካ ባይዜዳ።<note caller="-" style="x"><char style="xo" closed="false">17:27 </char><char style="xt" closed="false"><ref loc="GEN 7:6-24">ዶመ 7:6-24</ref></char></note><verse eid="LUK 17:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 17:28"/>“ሄዋዳንካ፥ ሎጸ<note caller="+" style="f"><char style="fr" closed="false">17:28 </char><char style="fqa" closed="false">ኖሄ፥ ሎጸ፦ </char><char style="ft" closed="false">ጾሳይ ቢታ ባሻ ሃን ባይዜዳ ዎደ፥ እ ኖሀነ አ ጎለ አሳ አሼዳ። ጾሳይ ሶዶማነ ጋሞራ ካታማቱዋ፥ እዝን ደእያ ኢታ አሳቱዋ ኡባ ታማን ባይዜዳ ዎደ፥ ሎጻነ አ ጎለ አሳ አሼዳ (ዶመ 19:1-29 ጼልተ)።</char></note> ዎድያን፥ አሳይ ሚድነ ኡሺደ፥ ዛልኢደ፥ ቶኪድነ ጎልያ ኬጺደ ደኤድኖ። <verse eid="LUK 17:28"/><verse number="29" style="v" sid="LUK 17:29"/>ሽን ሎጸ፥ ሶዶማፐ ከሶ ጋላሳን ቃይ ሳሉዋፐ ታማይነ ኤጽያ ቦንቆ ሹቻይ ቡኬዳ፤ ኡባባካ ሚደ ዉርሴዳ።<note caller="-" style="x"><char style="xo" closed="false">17:29 </char><char style="xt" closed="false"><ref loc="GEN 18:20-19:25">ዶመ 18:20—19:25</ref></char></note><verse eid="LUK 17:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 17:30"/>“አሳ ናአይ ቆንጭያ ጋላሳንካ ሀዋዳን ሀናናዋ። <verse eid="LUK 17:30"/><verse number="31" style="v" sid="LUK 17:31"/>ሄ ጋላሳን፥ ጎልያ ሁጲያን ደእያዌ፥ ጎለ ጋርሳን ደእያ ሚሻ አካናዉ ዎፖ፤ ሀዋዳንካ ጎሻ ጋደን ደእያዌ፥ ጉየ ስሞፖ።<note caller="-" style="x"><char style="xo" closed="false">17:31 </char><char style="xt" closed="false"><ref loc="MAT 24:17">ማቶሳ 24:17</ref>፣ <ref loc="MAT 24:18">18</ref>፤ <ref loc="MRK 13:15">ማር. 13:15</ref>፣ <ref loc="MRK 13:16">16</ref></char></note> <verse eid="LUK 17:31"/><verse number="32" style="v" sid="LUK 17:32"/>አነ ሎጸ ማቻትባ ቆፕተ!<note caller="-" style="x"><char style="xo" closed="false">17:32 </char><char style="xt" closed="false"><ref loc="GEN 19:26">ዶመ 19:26</ref></char></note> <verse eid="LUK 17:32"/><verse number="33" style="v" sid="LUK 17:33"/>ባረ ሸምፑዋ አሻናዉ ኮይያ ኡባይ፥ ባይዜ፤ ባረ ሸምፑዋ ባይዝያ ኡባይ፥ ደኡዋን ናጌ።<note caller="-" style="x"><char style="xo" closed="false">17:33 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቶሳ 10:39</ref>፤ <ref loc="MAT 16:25">16:25</ref>፤ <ref loc="MRK 8:35">ማር. 8:35</ref>፤ <ref loc="LUK 9:24">ሉቃሳ 9:24</ref>፤ <ref loc="JHN 12:25">ዮሃ. 12:25</ref></char></note> <verse eid="LUK 17:33"/><verse number="34" style="v" sid="LUK 17:34"/>ታ ህንተዉ ኦድያዌ አዬ ጎፐ፥ ሄ ቃማን ላኡ አሳቱ እት ግሱዋን ግሳናዋንታ፤ ኡንቱንቱፐ እቱ አከትና ላኤንያዌ አታናዋ። <verse eid="LUK 17:34"/><verse number="35" style="v" sid="LUK 17:35"/>ላኡ ማጫ አሳቱ እት ዎጻን ጋጫናዋንታ፤ እትና አከትና፥ እትና አታናዉኑ። <verse eid="LUK 17:35"/><verse number="36" style="v" sid="LUK 17:36"/>ላኡ አሳቱ ጎሻ ጋርሳን ደኢኖ፤ እቱ አከታናዋ፥ ላኤንያዌ አታናዋ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">17:36 </char><char style="xt" closed="false"><ref loc="MAT 24:40">ማቶሳ 24:40</ref></char></note><verse eid="LUK 17:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37"/>አ ካልያዋንቱ የሱሳ፥ “ጎዳዉ፥ ሄዌ ሀቃን ሀናናዌ?” ያጌድኖ።</para>
  <para style="p" vid="LUK 17:37">እካ ዛሪደ፥ “ባኩታይ ደኢያሳ ሾርቲ ሺቃናዋ” ያጌዳ።<verse eid="LUK 17:37"/></para>
  <chapter eid="LUK 17"/>
  <chapter number="18" style="c" sid="LUK 18"/>
  <para style="s1">ማንቆ ግዴዳ አምአትባነ ማካላንቻ ዳናባ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1"/>የሱስ ባረና ካልያዉንቶ፥ ሳለተናን ኡባ ጋላስ ዎሳናዳን ሌምሱዋን ኦዴዳ። <verse eid="LUK 18:1"/><verse number="2" style="v" sid="LUK 18:2"/>እካ፥ “እት ካታማን ጾሳዉ ያየናዌ፥ አሳካ ቦንቼና እት ዳናይ ደኤ። <verse eid="LUK 18:2"/><verse number="3" style="v" sid="LUK 18:3"/>ሄ ካታማን አምኤ ምሽራታ ደአዉ። እዛካ ሄ ዳናኮ ያደ፥ ‘ታ ሞርከዉነ ታዉ ደእያ የዉዋ ፕርዳ’ ያጋዱ።<verse eid="LUK 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 18:4"/>“ዳሮ ዎድያን እዝዉ ፕርደናን እጼዳ። ሽን ባረ ዎዛናን ቆፒደ፥ ‘ታን፥ ኡባ ጾሳዉ ያያና ዮፐካ፥ አሳካ ቃይ ቦንቻና ዮፐ፥ <verse eid="LUK 18:4"/><verse number="5" style="v" sid="LUK 18:5"/>ሀ አምኤ ምሽራታ ታና ላባንያ ድራዉነ ኡባ ዎደ ታኮ ያደ ታና ዳቡርሰና ማላ፥ ታን እዝዉ ፕርዳና’ ጌዳ።<verse eid="LUK 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6"/>“ሄ ማካላንቻ ዳናይ ጎዋ አኬክተ። <verse eid="LUK 18:6"/><verse number="7" style="v" sid="LUK 18:7"/>ጾሳይ ጋላስነ ቃማ ባረንታ ማዳና ማላ፥ ዳንዳያን አኮ ዋስያ ዶረታዋንቶ ፕርደኔየ? እ ኡንቱንቶ ኤለካ ዛረኔ? <verse eid="LUK 18:7"/><verse number="8" style="v" sid="LUK 18:8"/>ታን ህንተንቶ ያጋይ፤ ኡንቱንቶ ኤሌል ፕርዳና፤ ሽን አሳ ናአይ ይያ ዎደ ሀ ቢታን አማኑዋ ደማኔሻ?” ያጌዳ።<verse eid="LUK 18:8"/></para>
  <para style="s1">ኦቶረትያ ፓርሳዊያነ ባረና ካዉሽሴዳ ቃራጻ ቃንጽያ ብታንያ</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9"/>ባረንታ ጌሻ ጊደ አማነትያዋንቶነ ሀራ ኡባ ዳሪ ካያዋንቶ፥ የሱስ ሀ ሌምሱዋ ኦዴዳ: <verse eid="LUK 18:9"/><verse number="10" style="v" sid="LUK 18:10"/>“ላኡ አሳቱ ዎሳናዉ ጌሻ ጎልያ<note caller="+" style="f"><char style="fr" closed="false">18:10 </char><char style="fk" closed="false">ዎሳናዉ ጌሻ ጎልያ፦ </char><char style="ft" closed="false">አይሁዳ አሳይ ኡባ ዎደ ጌሻ ጎልያን ዎንታ ጉራንነ ጋላሳ ዎስኖ።</char></note> ገሌድኖ። ሄዋንቱፐ እቱ ፓርሳዊያ፤ እቱ ቃይ ቃራጻ ቃንጽያዋ። <verse eid="LUK 18:10"/><verse number="11" style="v" sid="LUK 18:11"/>ፓርሳዊ ደንድ ኤቂደ ባረ ዎዛናን ዎሲደ፥ ‘ጾሳዉ፥ ታን ሀራ አሳዳን: ቦንቂያዋንቱዳን፥ ማካልያዋንቱዳን፥ ዎሹምያዋንቱዳን፥ ዎይ ሀዋዳን ቃራጻ ሺሸና ድራዉ ኔና ጋላታይ። <verse eid="LUK 18:11"/><verse number="12" style="v" sid="LUK 18:12"/>ሳምንታን ላኡ ካላ ጾማይ፤ ታን ደምያ ኡባፐ ታሙ ኩሽያፐ እቱዋ እማይ’ ያጌዳ።<verse eid="LUK 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13"/>“ሽን ቃራጽያ ብታኒ ሃኩዋን ኤቂደ፥ ባረ አይፍያን ፑደ ሳሉዋ ቁ ጊደ ጼላናዉካ ኮይቤና። ሽን ባረ ትራ ባቂደ፥ ‘ጾሳዉ፥ ታን ናጋራንቻ፤ ታና ማራ’ ያጌዳ። <verse eid="LUK 18:13"/><verse number="14" style="v" sid="LUK 18:14"/>ታን ህንተንቶ ኦድያዌ አዬ ጎፐ፥ ካሰ ብታንያፐ አደ ሀ ብታኒ ጽሎ ግዲደ ባረ ጎለ ስሜዳ፤ ባረና ቁ ኦያ ኡባይ ካዉሻና፤ ባረና ቃይ ካዉሽስያ ኡራይ ቁ ጋና” ያጌዳ።<verse eid="LUK 18:14"/></para>
  <para style="s1">የሱስ ጉ ናና አንጄዳ</para>
  <para style="r">(<ref loc="MAT 19:13-15">ማቶሳ 19:13-15</ref>፤ <ref loc="MRK 10:13-16">ማር. 10:13-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15"/>የሱስ ባረ ኩሽያ ዎደ አንጃና ማላ አሳይ ጉ ናና አኪደ አኮ ዬድኖ። አ ካልያዋንቱካ በኢደ፥ አሳ አሄና ማላ ጌድኖ። <verse eid="LUK 18:15"/><verse number="16" style="v" sid="LUK 18:16"/>የሱስ ቃይ ጉ ናና ባረኮ ጼሲደ፥ “ጉ ናናይ ታኮ ያና ማላ አግተ፥ ድጎፕተ፤ ጾሳ ካዉተይ ሀዋንቱ ማላሳ። <verse eid="LUK 18:16"/><verse number="17" style="v" sid="LUK 18:17"/>ታን ህንተንቶ ቱሙዋ ኦዳይ፤ ጾሳ ካዉተ ጉ ናኣዳን አከናዋንቱ ኡባይ ሄ ካዉተ ሙለካ ገለና” ያጌዳ።<verse eid="LUK 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18"/>ይሁዳ ቢታ ሞድያዋንቱፐ እቱ፥ “ሎኦ ታማርስያዎ፥ ታን መና ደኡዋ ላታናዉ አያ ኦናዉ በሲ?” ያጊደ የሱሳ ኦቼዳ። <verse eid="LUK 18:18"/><verse number="19" style="v" sid="LUK 18:19"/>የሱስካ አዉ፥ “አያዉ ታና ሎኦ፥ ያጋይ? እት ጾሳፐ አትን፥ ሎኡ ኦንነ ባዋ፤ <verse eid="LUK 18:19"/><verse number="20" style="v" sid="LUK 18:20"/>ጾሳ አዛዛቱዋ፥ ‘ዎሹሞፓ፥ ዎፓ፥ ዉኦፓ፥ ዎርዱዋ ማርካቶፓ፥ ነ አባነ ነ ዳዮ ቦንቻ ያግያዋ ኤራ’ ” ያጊደ ዛሬዳ። <verse eid="LUK 18:20"/><verse number="21" style="v" sid="LUK 18:21"/>ብታኒ ዛሪደ፥ “ሀዋ ኡባ፥ ናአተፐ ዶማደ ናጋድ” ያጌዳ።<verse eid="LUK 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22"/>የሱስካ ሀዋ ስሲደ፥ “እትባይ ኔን ብሮን ኦናን አቶዌ ደኤ፤ ሄዌኔካ፥ ነዉ ደእያዋ ኡባ ዛልኣደ ማንቃቶ እማ፤ ሀዋ ኦፐ ሳሉዋንካ ኔን ዱረታና፤ ሄዋፐ ጉየ ታ ጌዱዋ ካላ” ያጌዳ። <verse eid="LUK 18:22"/><verse number="23" style="v" sid="LUK 18:23"/>ሄ ብታኒ ቃይ ሄዋ ስሲደ ዳሮ ዱረ ግዶ ድራዉ ዳሮ ካዮቴዳ።<verse eid="LUK 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 18:24"/>የሱስካ ሀ ብታኒ ዳሮ ካዮቶዋ በኢደ፥ “ዱረ አሳይ ጾሳ ካዉተ ገላናዉ ዎት መታንዴሻ! <verse eid="LUK 18:24"/><verse number="25" style="v" sid="LUK 18:25"/>ዱረ አሳይ ጾሳ ካዉተ ገላናዋፐ ጋሉ ማርፕያ ጾእያና አናዌ ማታቴ” ያጌዳ። <verse eid="LUK 18:25"/><verse number="26" style="v" sid="LUK 18:26"/>ሄዋ ስሴዳ አሳይ፥ “ስም ኦን አታናዉ ዳንዳዪ?” ያጌድኖ።<verse eid="LUK 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27"/>እካ ቃይ ዛሪደ፥ “አሳዉ ዳንዳየተናዌ ጾሳዉ ዳንዳየቴ” ያጌዳ። <verse eid="LUK 18:27"/><verse number="28" style="v" sid="LUK 18:28"/>ጰጽሮስ ዛሪደ፥ “ስም ኑን ኑዉ ደእያ ኡባ አጊደ ኔና ካሌዶ” ያጌዳ። <verse eid="LUK 18:28"/><verse number="29" style="v" sid="LUK 18:29"/>እካ፥ “ቱሙዋ ጋይ፥ ጾሳ ካዉተ ድራዉ ባረ ጎልያ፥ ዎይ ባረና የላዋንታ፥ ዎይ ባረ ማችያ፥ ዎይ ባረ ናና፥ ዎይ እሻቱዋ አጌዳዌ፥ <verse eid="LUK 18:29"/><verse number="30" style="v" sid="LUK 18:30"/>ሀ ዎድያን ዳሮ ዳኩዋ፥ ስን ይያ ካዉተንካ መና ደኡዋ አከናዌ ኦንነ ባዋ” ያጌዳ።<verse eid="LUK 18:30"/></para>
  <para style="s1">የሱስ ባረ ሀይቁዋባ ሄዘንዋ ኦዴዳ</para>
  <para style="r">(<ref loc="MAT 20:17-19">ማቶሳ 20:17-19</ref>፤ <ref loc="MRK 10:32-34">ማር. 10:32-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31"/>የሱስካ ታማነ ላኡ ባረና ካልያዋንታ ባረኮ ጼሲደ፥ “ስም የሩሳላመ ባና፤ አሳ ናኣባይካ ናባቱ ማጻፋን ጻፈቴዳባይ ኡባይ ያን ፖለታና። <verse eid="LUK 18:31"/><verse number="32" style="v" sid="LUK 18:32"/>አይሁደ ግደናዋንቶ አ አ እማና፥ ቅሊጫና፥ ዳሮ መቶና፥ አ ቦላን ጩቻና፤ <verse eid="LUK 18:32"/><verse number="33" style="v" sid="LUK 18:33"/>ሾጮዋፐ ጉይያን ዎና፥ ሄዘንያ ጋላስ እ ደንዳና” ያጌዳ።<verse eid="LUK 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34"/>ኡንቱንቱካ ሀ የዉዋፐ አያነ አኬክበይክኖ፤ ሀይቁካ ኡንቱንቶ አኬከትቤና ድራዉ እ ሃሳዮባካ ኤርበይክኖ። <verse eid="LUK 18:34"/><verse number="35" style="v" sid="LUK 18:35"/>የሱስ እያርኮኮ ማቴዳ ዎድያን፥ እት ቆቃ ብታኒ ዎሲደ ኦግያ ጋጻን ኡቴዳ። <verse eid="LUK 18:35"/><verse number="36" style="v" sid="LUK 18:36"/>ጮራ አሳይ አያዋ ስሲደ፥ “ሀዌ አዬሻ?” ያግ ኦቼዳ። <verse eid="LUK 18:36"/><verse number="37" style="v" sid="LUK 18:37"/>አሳይካ አዉ፥ “ናዝሬትያ የሱስ ሀዋና አ ደኤ” ያግ ዛሬድኖ።<verse eid="LUK 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38"/>እካ፥ “ዳዊተ ናኣ የሱሳ፥ ታና ማራርኪ” ጊደ ዋሴዳ። <verse eid="LUK 18:38"/><verse number="39" style="v" sid="LUK 18:39"/>አፐ ስንና ቢደ ደእያዋንቱካ፥ ጮኡ ጋናዳን ሀንቀቴድኖ። እ ቃይ፥ “ዳዊተ ናአዉ፥ ታና ማራርኪ” ጊደ ዳሪ ዋሴዳ።<verse eid="LUK 18:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40"/>የሱስካ ኤቂደ፥ ባረኮ አሀናዳን አሳዉ ኦዴዳ። <verse eid="LUK 18:40"/><verse number="41" style="v" sid="LUK 18:41"/>የሱሳኮ እ ጼቱዋ ዎድያን፥ የሱስ፥ “ታን ነዉ አያ ኦናዳን ኮያይ?” ያጊደ አ ኦቼዳ።</para>
  <para style="p" vid="LUK 18:41">እካ ዛሪደ፥ “ጎዳዉ፥ ጼላናዉ ኮያይ” ጌዳ።<verse eid="LUK 18:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42"/>የሱስካ፥ “ጼላ፥ ነ አማኑ ኔና ፓዳ” ያጌዳ። <verse eid="LUK 18:42"/><verse number="43" style="v" sid="LUK 18:43"/>ሄ ዎድያንካ ጼል አጌዳ፤ ጾሳካ ቦንቺደ አ ጌዱዋ ካሌዳ።</para>
  <para style="p" vid="LUK 18:43">አሳይ ኡባይ ብታንያ ጼሊደ፥ ጾሳ ጋላቴድኖ።<verse eid="LUK 18:43"/></para>
  <chapter eid="LUK 18"/>
  <chapter number="19" style="c" sid="LUK 19"/>
  <para style="s1">የሱሳነ ዛክዮሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1"/>የሱስ ህን እያርኮ ካታማ ገሊደ፥ ሄዋና አ ደኤ። <verse eid="LUK 19:1"/><verse number="2" style="v" sid="LUK 19:2"/>ሱንይ ዛክዮሳ ጌተትያ እት ዱረ ብታኒ ሄዋን ደኤ። እካ ቃራጽያዋንቶ ካፑዋ። <verse eid="LUK 19:2"/><verse number="3" style="v" sid="LUK 19:3"/>ዛክዮስ የሱሳ ጌተትያዌ ሀቃዌንቶ በአናዉ ኮይሽን ቃን ግዴዳዋ ድራዉ፥ አሳ ጮራተፐ ደንዶዋን በአናዉ ዳንዳይቤና። <verse eid="LUK 19:3"/><verse number="4" style="v" sid="LUK 19:4"/>የሱስ ሄ ኦግያና አያ ድራዉ፥ ስንዉ አደ እት ቦእያ ቦላ ከሴዳ።<verse eid="LUK 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 19:5"/>የሱስ ሄ ሳኣ ጋኪደ፥ ቁ ግ ፑደ ጼሊደ፥ “ዛክዮሳ፥ ሀቼ ነ ጎለን ፔሻናዉ በስያ ድራዉ ኤለ ዎ” ያጌዳ። <verse eid="LUK 19:5"/><verse number="6" style="v" sid="LUK 19:6"/>እካ ኤሌል ቦእያፐ ዎደ፥ ናሸቻን የሱሳ ሞኬዳ። <verse eid="LUK 19:6"/><verse number="7" style="v" sid="LUK 19:7"/>ሄዋን ደእያ አሳ ኡባይ ሀዋ በኢደ፥ “ሀዌ ናጋራንቻ ጎለን ገሊደ እማ ግዲደ ሾበታና ሀኔ” ጊደ ኡባቱካ ዙዙን ዶሜድኖ።<verse eid="LUK 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8"/>ዛክዮስካ ቃይ ኤቂደ ጎዳ፥ “ጎዳዉ፥ ስም ታዉ ደእያዋ ኡባፐ ባጋ ህየሳቶ እማና፤ ኦፐነካ ዎርዱዋን አኬዳዋ ግዶፐ፥ ኦይዱ ዳኩዋ ኡዳደ ዛራና” ያጌዳ።<verse eid="LUK 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9"/>የሱስካ ዛክዮሳዉ ኦዲደ፥ “ኔንካ አብራሃሞ ሼሻ ግድያ ድራዉ፥ ሀቼ አቶተይ ሀ ጎለ አሳዉ ዬዳ። <verse eid="LUK 19:9"/><verse number="10" style="v" sid="LUK 19:10"/>አያዉ ጎፐ፥ አሳ ናአይ ባዬዳዋ ኮያናዉነ አሻናዉ ዬዳ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">19:10 </char><char style="xt" closed="false"><ref loc="MAT 18:11">ማቶሳ 18:11</ref></char></note><verse eid="LUK 19:10"/></para>
  <para style="s1">ታሙ ቆማቱዋ ሌምሱዋ</para>
  <para style="r">(<ref loc="MAT 25:14-30">ማቶሳ 25:14-30</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11"/>አሳይ ሀዋ ስሲደ ደእሽን የሱስ፥ ህን የሩሳላመ ጼቱዋ ድራዉነ ኡንቱንቶ ጾሳ ካዉተይ ሀእካ ቆንጭያዋ ማላቶ ድራዉ ሌምሱዋ ኦዴዳ።<note caller="-" style="x"><char style="xo" closed="false">19:11-27 </char><char style="xt" closed="false"><ref loc="MAT 25:14-30">ማቶሳ 25:14-30</ref></char></note> <verse eid="LUK 19:11"/><verse number="12" style="v" sid="LUK 19:12"/>ሀዋዳን ያግ ዶሜዳ፤ “እት ዎልቃማ ብታኒ ባረዉ ካዉተ ቦንቹዋ አኪደ ስማናዉ፥ ህን ሃኮ ጋድያ ቤዳ። <verse eid="LUK 19:12"/><verse number="13" style="v" sid="LUK 19:13"/>ባረ ቆማቱዋ ግዶፐ ታሙዋ ጼሲደ፥ ኡንቱንቶ ታሙ ሚና<note caller="+" style="f"><char style="fr" closed="false">19:13 </char><char style="fk" closed="false">ሚና፦ </char><char style="ft" closed="false">ሚና ጌተትያዌ፥ ግሪከ ቃላን ምናሰ ግያዋ። ሀዋ ብለይ፥ ሄ ዎደ ደእያ ኦሳንቻ አሳዉ እመትያ ሄዙ አገና ድርጉዋ።</char></note> ጌተትያ ሚሻ እሞዋሽን፥ ‘ታን ስማደ ያና ጋካናዉ፥ ሀ ሚሻን ዛልእሽተ’ ያጌዳ።<verse eid="LUK 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 19:14"/>“ሽን አ ጋድያ አሳይ አ እጾ ድራዉ፥ ‘ሀ ብታኒ ኑ ቦላ ካተታናዳን ኑን ኮዮኮ’ ያጊደ፥ ጉየና እ ደኢያሳ አሳ ኪቴድኖ። <verse eid="LUK 19:14"/><verse number="15" style="v" sid="LUK 19:15"/>ግዶፐ አትን፥ ሀ ብታኒ ካተ ግዲደ ህን ባረ ጋደ ስሜዳ። ሄ ቆማቱ ሁጲያን ሁጲያን እ እሞ ሚሻን ዛልኢደ አይ ኬና ዎሴድኖንቶ ኤራናዉ ጼስሴዳ።<verse eid="LUK 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 19:16"/>“ኮይሮ ቆማይ ሺቂደ፥ ‘ጎዳዉ፥ ኔን ታዉ እሜዳ ታሙ ሚና ዎያ ታሙዋ ደማድ’ ያጌዳ። <verse eid="LUK 19:16"/><verse number="17" style="v" sid="LUK 19:17"/>አ ጎዳይ አ፥ ‘ሀያናሾ! ኔን ሎኦ ቆማ፤ ኔን ጉ የዉዋን አማነቴዳዋ ግዳደ ቤቶ ድራዉ፥ ታሙ ካታማቱዋ ቦላን ማታይ ነዉ እመቴዳ’ ያጌዳ።<verse eid="LUK 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 19:18"/>“ላኤንያዌካ ሺቂደ፥ ‘ጎዳዉ፥ ኔን ታዉ እሜዳ እቼሹ ሚና ጌተትያ ሚሻይ እቼሹዋ ዎዳ’ ያጌዳ። <verse eid="LUK 19:18"/><verse number="19" style="v" sid="LUK 19:19"/>አ ጎዳይካ አ፥ ‘ነዉ እቼሹ ካታማቱዋ ቦላን ማታይ እመቴዳ’ ያጌዳ። <verse eid="LUK 19:19"/><verse number="20" style="v" sid="LUK 19:20"/>ሀራ ሄዘንያ ቆማይ ሺቂደ፥ ‘ጎዳዉ፥ ጩርቃን ጻጻ ዎዳ ነ ሚሻ ሀዋ በአ። <verse eid="LUK 19:20"/><verse number="21" style="v" sid="LUK 19:21"/>አያዉ ጎፐ፥ ኔን ዎቤናሳፐ አክያዋ፤ ዘራቤናዋ ቆይጭያ መቀ ባይና አሳ ግድያ ድራዉ፥ ነዉ ያያድ’ ያጌዳ።<verse eid="LUK 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 19:22"/>“ጎዳይካ፥ ‘ሀ ኢታ ቆማይ፤ ኔን ሃሳዮ ቃላን ነ ቦላ ታን ፕርዳና። ዎቤናዋ አክያዋ፥ ዘራቤናዋ ቆይጭያ መቀ ባይና አሳ ግድያዋ ኤሮፐ፥ <verse eid="LUK 19:22"/><verse number="23" style="v" sid="LUK 19:23"/>ታን ያደ ታ ሚሻ ዎያና አካና ማላ፥ አያዉ ዎስያዋንቶ እማበይኪ?’ ያጌዳ።<verse eid="LUK 19:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 19:24"/>“ጎዳይካ፥ ሄዋን ኤቆዋንታ፥ ‘ሀ ሚሻ አፐ ዎ አኪደ ታሙ ሚናይ ደእያዎ እምተ’ ያጌዳ። <verse eid="LUK 19:24"/><verse number="25" style="v" sid="LUK 19:25"/>ኡንቱንቱካ፥ ‘ጎዳዉ፥ አዉ ታሙ ሚናይ ደኤ’ ያጌድኖ።<verse eid="LUK 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 19:26"/>“እካ፥ ‘ታን ህንተንቶ ኦድያዌ፥ ደእያዎ ኡባዉ ጉጀታናዋ፤ ባይናዋፐ ቃይ ሄ ደእያዌካ አከታናዋ።<note caller="-" style="x"><char style="xo" closed="false">19:26 </char><char style="xt" closed="false"><ref loc="MAT 13:12">ማቶሳ 13:12</ref>፤ <ref loc="MRK 4:25">ማር. 4:25</ref>፤ <ref loc="LUK 8:18">ሉቃሳ 8:18</ref></char></note> <verse eid="LUK 19:26"/><verse number="27" style="v" sid="LUK 19:27"/>የዉዋን ቃይ ታን ኡንቱንቱ ቦላን ካዉተናዳን ኮዬዳ ታ ሞርካቱዋ ታኮ አሂደ ታ ስንን ሹክተ’ ጌዳ” ያጌዳ።<verse eid="LUK 19:27"/></para>
  <para style="s1">የሱስ ዳሮ ቦንቹዋን የሩሳላመ ገሌዳ</para>
  <para style="r">(<ref loc="MAT 21:1-11">ማቶሳ 21:1-11</ref>፤ <ref loc="MRK 11:1-11">ማር. 11:1-11</ref>፤ <ref loc="JHN 12:12-15">ዮሃ. 12:12-15</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28"/>የሱስ ሀዋ ጎዋፐ ካላ ህን የሩሳላመ ከሳናዉ ባረና ካልያዋንቱፐ ስንቲደ ቤዳ። <verse eid="LUK 19:28"/><verse number="29" style="v" sid="LUK 19:29"/>ደብረ ዛይተ ጌተትያ ደርያ ማታን ደእያ ህን ቤተፋገን ቢታንያ ጌተትያ ሄራ ካታማቱዋኮ ሺቄዳ ዎደ ባረና ካልያዋንቱፐ ላአቱዋ፥ <verse eid="LUK 19:29"/><verse number="30" style="v" sid="LUK 19:30"/>“ህንተንቱፐ ስንን ደእያ ቄር ካታማቱዋ ቢተ፤ ያ ህንተንቱ ገልያ ዎደ፥ ኦንነ ብሮ ኡትቤና ሀረ ማራይ ቃሸት ኡቴዳዋ ደማንታ፤ አ ብሊደ ሃ አክ ዪተ። <verse eid="LUK 19:30"/><verse number="31" style="v" sid="LUK 19:31"/>ኦንነ ህንተንታ፥ ‘ሀዋ አያዉ ብሊቴ?’ ጊደ ኦቾፐ፥ ‘እ ባረ ጎዳዉ<note caller="+" style="f"><char style="fr" closed="false">19:31 </char><char style="fk" closed="false">ጎዳዉ፦ </char><char style="ft" closed="false">ሀዋን ጎዳዉ ጌተቶዌ፥ ሀረ ማራ ጎዳፐሽን፥ ጾሳ ግደና።</char></note> ኮሽያ ድራሳ’ ያግተ” ያጌዳ።<verse eid="LUK 19:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32"/>ኪተቴዳዋንቱካ ቢደ፥ የሱስ ኡንቱንቶ ኦዶዋዳን ሀንና ደሜድኖ። <verse eid="LUK 19:32"/><verse number="33" style="v" sid="LUK 19:33"/>ኡንቱንቱ ሀረ ማራ ብልያ ዎደ በኢደ ሀርያ ጎዳይ፥ “ሀረ ማራ አያዉ ብሊቴ?” ያጌዳ። <verse eid="LUK 19:33"/><verse number="34" style="v" sid="LUK 19:34"/>ኡንቱንቱካ፥ “ጎዳዉ ሀዌ ኮሼ” ያጊደ፥ <verse eid="LUK 19:34"/><verse number="35" style="v" sid="LUK 19:35"/>ሀረ ማራ የሱሳኮ አሄድኖ፤ ባረንቱ ማዩዋ አ ቦላን ዎደ የሱሳ ሀርያ ቶግሴድኖ። <verse eid="LUK 19:35"/><verse number="36" style="v" sid="LUK 19:36"/>አሳይካ የሱስ ብያ ኦግያ ቦላ ባረንቱ ማዩዋ ሂጼድኖ።<note caller="+" style="f"><char style="fr" closed="false">19:36 </char><char style="fk" closed="false">ማዩዋ ሂጼድኖ፦ </char><char style="ft" closed="false">ሀዋ ጉሳይ፥ አይሁዳ አሳ ዎጋን፥ ኤረቴዳነ ቦንቼትያ አሳዉ ኦሰትያ እማ ሞካ ዎጋ።</char></note><verse eid="LUK 19:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 19:37"/>እ ደብረ ዛይተ ጌተትያ ደርያ ዱገ አፍያ ኦግያ ማቴዳ ዎደ፥ ዳሮ ጮራ ግዴዳ አ ካልያዋንቱ በኤዳ ጾሳይ ኦዳ ማላታዉ ኡባዉ ናሸቲደ፥ ባረንቱ ኮሻ ቁ ኦደ፥<verse eid="LUK 19:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="LUK 19:38"/>“ጎዳ ሱንን ይያ ካቲ፥</para>
  <para style="q2" vid="LUK 19:38">አንጀቴዳዋ፤</para>
  <para style="q2" vid="LUK 19:38">ሳሉዋን ሳሮታይ ግዶ።</para>
  <para style="q2" vid="LUK 19:38">ቃይ ክል ቃ ሳሉዋን ደእያ፥</para>
  <para style="q1" vid="LUK 19:38">ጾሳይ ቦንቼቶ”</para>
  <para style="m" vid="LUK 19:38">ያጌድኖ።<note caller="-" style="x"><char style="xo" closed="false">19:38 </char><char style="xt" closed="false"><ref loc="PSA 118:26">ማዝ. 118:26</ref></char></note><verse eid="LUK 19:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39"/>አሳ ጋርሳን ደእያ እት እት ፓርሳዋቱ የሱሳ፥ “ታማርስያዎ፥ ኔና ካልያዋንታ ጮኡ ኦርኪ” ያጌድኖ። <verse eid="LUK 19:39"/><verse number="40" style="v" sid="LUK 19:40"/>እካ ዛሪደ፥ “ታን ህንተንቶ ኦዳይ፥ ኡንቱንቱ ጮኡ ጎፐ፥ ሹቻይካ ዋሳናዋ” ያጌዳ። <verse eid="LUK 19:40"/><verse number="41" style="v" sid="LUK 19:41"/>የሱስ የሩሳላመ ማቴዳ ዎደ፥ ካታማቶ በኢደ፥ ዬኪደ፥ <verse eid="LUK 19:41"/><verse number="42" style="v" sid="LUK 19:42"/>“ነ ሳሮታዉ ግድያዋ ኔን ሀቼ ኤራድንቶ ሎአ፤ ሽን ሀእ ሄዌ ነ አይፍያፐ ጌሜዳ። <verse eid="LUK 19:42"/><verse number="43" style="v" sid="LUK 19:43"/>አያዉ ጎፐ፥ ነ ቦላ ያና ዎዲ ደኤ፤ ሄ ዎደ ኔና እጽያዋንቱ ነ ዩሹዋን ድርሳ ድሪደ፥ ያፐነ ሃፐነ ዶዲደ፥ ኔና ኡንኤያ ዎዲ ያናዋ። <verse eid="LUK 19:43"/><verse number="44" style="v" sid="LUK 19:44"/>ኔናነ ነ ድርሳ ጋርሳን ደእያ ነ አሳ መንሬና። ጾሳይ ኔና በአናዉ ዬዳ ዎድያ ኔን ኤራቤና ድራዉ፥ ኔና እጽያዋንቱ ሹቻ ኡባ እቱዋ እቱዋ ቦላፐ ደንደ ላላናዋ” ያጌዳ።<verse eid="LUK 19:44"/></para>
  <para style="s1">የሱስ ጌሻ ጎልያን ዛልእያዋንታ የደርሴዳ</para>
  <para style="r">(<ref loc="MAT 21:12-17">ማቶሳ 21:12-17</ref>፤ <ref loc="MRK 11:15-19">ማር. 11:15-19</ref>፤ <ref loc="JHN 2:13-22">ዮሃ. 2:13-22</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45"/>ሀዋፐ ካላ የሱስ ጌሻ ጎልያ ገሊደ፥ ዛልእያዋንታ ሄዋፐ ከሴዳ። <verse eid="LUK 19:45"/><verse number="46" style="v" sid="LUK 19:46"/>የሱስ ዛሪደ፥ “ ‘ታ ጎሊ ጾሳ ዎስያ ጎልያ ግዳናዋ’ ጌተቲደ ጾሳ ቃላን ጻፈቴዳ። ሽን ህንተንቱ አ ፓኑዋ ጎንጎሉዋ ኦድታ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">19:46 </char><char style="xt" closed="false"><ref loc="ISA 56:7">ኢሳ. 56:7</ref>፤ <ref loc="JER 7:11">ኤር. 7:11</ref></char></note> <verse eid="LUK 19:46"/><verse number="47" style="v" sid="LUK 19:47"/>የሱስ ኡባ ዎደ ጌሻ ጎልያን ታማርስ ደእሽን፥ ቄሳቱዋ ካፓቱ፥ ሙሴ ህግያ ታማርስያዋንቱነ አሳ አይስያዋንቱ አ ዎናዉ ኮዪኖ።<note caller="-" style="x"><char style="xo" closed="false">19:47 </char><char style="xt" closed="false"><ref loc="LUK 21:37">ሉቃሳ 21:37</ref></char></note> <verse eid="LUK 19:47"/><verse number="48" style="v" sid="LUK 19:48"/>ሽን አሳይ ኡባይ አ ሃሳያፐ እቱነ አተናን ስስ ኡቶ ድራዉ፥ አ ዎያ ኦግያ ኡንቱንቱ ዬድኖ።<verse eid="LUK 19:48"/></para>
  <chapter eid="LUK 19"/>
  <chapter number="20" style="c" sid="LUK 20"/>
  <para style="s1">የሱሳ ማታ ቦላ ደንዴዳ ኦሻ</para>
  <para style="r">(<ref loc="MAT 21:23-27">ማቶሳ 21:23-27</ref>፤ <ref loc="MRK 11:27-33">ማር. 11:27-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1"/>እት ጋላስ የሱስ አሳ ጌሻ ጎልያን ታማርሲደነ ምሽራቹዋ ቃላ ኦዲደ ደእያ ዎደ፥ ቄሳቱዋ ካፓቱነ ሙሴ ህግያ ታማርስያዋንቱ ጋድያ ጭማቱዋና እትፐ የሱሳኮ ዬድኖ። <verse eid="LUK 20:1"/><verse number="2" style="v" sid="LUK 20:2"/>ኡንቱንቱካ፥ “ሀ የዉዋ ኔን ኦያዌ አይ ማታነንቶ ኦዳ፤ ሀ ማታካ ነዉ እሜዳዌ እ ኦኔ?” ያጊደ ኦቼድኖ። <verse eid="LUK 20:2"/><verse number="3" style="v" sid="LUK 20:3"/>እካ፥ “ታ ህንተና እት ኦሻ ኦችያዌ ደእያዋ አነ ዛርተ። <verse eid="LUK 20:3"/><verse number="4" style="v" sid="LUK 20:4"/>ዮሃንሳ ጽንቃታይ ጾሳፔ ዎይ አሳፔ?” ያግ ኦቼዳ።<verse eid="LUK 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5"/>ኡንቱንቱ ባረ ግዶን ማቀቲደ፥ “ጾሳፐ ጎፐ፥ ሄዋ ግዶፐ ‘አያዉ አማንበይክቴ’ ኑና ያጋናዋ፤ <verse eid="LUK 20:5"/><verse number="6" style="v" sid="LUK 20:6"/>‘አሳፐ’ ጎፐ፥ አሳይ ኡባይ ዮሃንስ ናብያ ግድያዋ አማንያ ድራዉ ሹቻን ኑና ደቻናዋንታ” ያጌድኖ። <verse eid="LUK 20:6"/><verse number="7" style="v" sid="LUK 20:7"/>ሀዋስ፥ “ሀቃፐ ዬደንቶ ኤሮኮ” ጊደ አዉ ዛሬድኖ። <verse eid="LUK 20:7"/><verse number="8" style="v" sid="LUK 20:8"/>የሱስካ፥ “ሀዋ ግዶፐ ታንካ፥ ታን ኦ ማታን ሀ የዉዋ ኦይታንቶ ህንተንቶ ኦድከ” ያጌዳ።<verse eid="LUK 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9"/>ሀዋፐ ስሚደ የሱስ አሳዉ ሀ ሌምሱዋ ያግ ኦዱዋ ዶሜዳ:<note caller="-" style="x"><char style="xo" closed="false">20:9 </char><char style="xt" closed="false"><ref loc="ISA 5:1">ኢሳ. 5:1</ref></char></note> “እት ብታኒ ዳሮ ዎይንያ ቱራቱዋ ቶኬዳ። ጎሻንቻቶ ኮዉ እሚደ፥ እ ህን ሀራ ጋድያ ቢደ ጮራ ዎድያ ጋምኤዳ። <verse eid="LUK 20:9"/><verse number="10" style="v" sid="LUK 20:10"/>ዎይኒ አይፍያ አይፎ ዎደ፥ ዎይንያ ጎሻ ጎዳይ ባረና ጋክያዋ አሀናዳን እት ቆማ ኮዋቱዋኮ ኪቴዳ። ኪተት ቤዳዋካ ኦቢደ፥ መላ ኩሽያ የዴድኖ። <verse eid="LUK 20:10"/><verse number="11" style="v" sid="LUK 20:11"/>ሄዋፐ ሀራ ቆማ ኪቴዳ። ኡንቱንቱ ሄዋካ ቃይ ኦቢደ፥ ቶቺደ፥ መላ ኩሽያ የዴድኖ። <verse eid="LUK 20:11"/><verse number="12" style="v" sid="LUK 20:12"/>ሀእካ ሀራ ሄዘንያ ቆማ ኪቴዳ። ኡንቱንቱካ ቃይ አ ማሱንደ፥ ህን ካረ ኦሌድኖ።<verse eid="LUK 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 20:13"/>“ሄ ዎይንያ ቱራ ጎዳይካ፥ ‘ስም አያ ኦ? አነ ሀእ ታ ዶስያ ናኣ ኪታና፤ ኦን ኤር አ ቦንቾፐነ’ ጌዳ። <verse eid="LUK 20:13"/><verse number="14" style="v" sid="LUK 20:14"/>ጎሻንቻቱ ቃይ ናኣ በኤዳ ዎደ፥ ‘ሀዌ አ ላትያዋ ግዶ ድራዉ፥ ሀይተ ዎይተ፤ ሄዋፐ ጉየ፥ ቢታይ ኑሳ ግዳናዋ’ ጊደ ዞረቴድኖ። <verse eid="LUK 20:14"/><verse number="15" style="v" sid="LUK 20:15"/>ዎይንያ ቱራ ሳኣፐ፥ ህን ካረዉ ከሲደ አ ዎድኖ።</para>
  <para style="p" vid="LUK 20:15">“ዎይንያ ቱራ ጎዳይካ ኡንቱንታ አያ ኦንዴሻ? <verse eid="LUK 20:15"/><verse number="16" style="v" sid="LUK 20:16"/>ዮፐ ሄ ጎሻንቻቱዋ፥ ዎናዋ፤ ዎይንያ ቱራ ሳኣካ ሀራንቶ እማናዋ” ያጌድኖ።</para>
  <para style="p" vid="LUK 20:16">አሳቱካ ሀዋ ስሶ ዎደ፥ “ሀዋ ማላባ አሆፖ” ያጌድኖ። <verse eid="LUK 20:16"/><verse number="17" style="v" sid="LUK 20:17"/>የሱስካ ህን ኡንቱንቱኮ ጼሊደ፥</para>
  <para style="q1" vid="LUK 20:17">“ ‘ስም ሹቻ ጎልያ ኬጽያዋንቱ ካዳ ሹቻይ፥</para>
  <para style="q2" vid="LUK 20:17">እ ዋና ጎልያ ምንስያ ሁጰ ሹቻ ግዴዳ’</para>
  <para style="m" vid="LUK 20:17">ጌተቲደ ጻፈቴዳዋ ብለይ አዬ?<note caller="-" style="x"><char style="xo" closed="false">20:17 </char><char style="xt" closed="false"><ref loc="PSA 118:22">ማዝ. 118:22</ref></char></note> <verse eid="LUK 20:17"/><verse number="18" style="v" sid="LUK 20:18"/>ሀ ሹቻ ቦላን ኩንድያ ኡባይ መኤረቴ፤ ሹቻይካ አ ቦላን ኩንድያ ኡባይ ቡንቼታናዋ” ያጌዳ።<verse eid="LUK 20:18"/></para>
  <para style="s1">ጊራ፥ ጊራኔ አጋኔ ግያ ኦሻ</para>
  <para style="r">(<ref loc="MAT 22:15-22">ማቶሳ 22:15-22</ref>፤ <ref loc="MRK 12:13-17">ማር. 12:13-17</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19"/>ሙሴ ህግያ ጻፍያዋንቱነ ቄሳቱዋ ካፓቱ የሱስ ሃሳዬዳ ሌምሱ፥ ኡንቱንቱ ቦላን ጌተቶዋ ኤሮ ድራዉ፥ ሄ ሳትያንካ አ ኦይቃናዉ ኮዬድኖ። ሽን አሳዉ ያዬድኖ። <verse eid="LUK 20:19"/><verse number="20" style="v" sid="LUK 20:20"/>የሱሳ፥ ሄ ጋድያ ሞድያዎነ አ ማታዉ አደ እማናዉ አ ዶናፐ ከስያ ቃላን ኦይቃናዉ እንጀትያ ዎድያ ናጊኖ። ሄዋ ድራዉ ጌሻ ማላቲደ ኦይናዉ ዎችያዋንታ ኪቴድኖ። <verse eid="LUK 20:20"/><verse number="21" style="v" sid="LUK 20:21"/>ሄ ኪተቶዋንቱካ የሱሳ፥ “ታማርስያዎ፥ ኔን ቱማ የዉዋ ሃሳይያዋነ ታማርስያዋ፥ ሄዋዳንካ ቃይ ጾሳ ኦግያ ቱማተን ታማርስያዋነ ኦስነ ዱማየናዋ ኑን ኤሬቶ። <verse eid="LUK 20:21"/><verse number="22" style="v" sid="LUK 20:22"/>ቃይካ ኡንቱንቱ፥ ሮማ ካትያ ቄሳረዉ ጊራ ጭጋናዉ ኮሺ ዎይ ኮሸኔ?” ያግ ኦቼድኖ።<verse eid="LUK 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23"/>እ ቃይ ኡንቱንቱ ደሻተ ኤሪደ፥ <verse eid="LUK 20:23"/><verse number="24" style="v" sid="LUK 20:24"/>“አነ ታና እት ዲናርያ<note caller="+" style="f"><char style="fr" closed="false">20:24 </char><char style="fqa" closed="false">ድናርያ፦ </char><char style="ft" closed="false">ሄ ዎደ ሮማ ቢታ አሳይ ጎኤትያ ሚሻ።</char></note> በስተ፤ ሄዋ ቦላን ደእያ ምስሊነ ጻፈቶዌ ኦና በሲ?” ጌዳ። <verse eid="LUK 20:24"/><verse number="25" style="v" sid="LUK 20:25"/>ኡንቱንቱካ፥ “ቄሳረዋ” ጊደ ዛሬድኖ። እኔካ፥ “ሄዋ ግዶፐ: ቄሳረዋ፥ ቄሳረዉ እምተ፤ ጾሳዋ፥ ጾሳዉ እምተ” ያጌዳ። <verse eid="LUK 20:25"/><verse number="26" style="v" sid="LUK 20:26"/>ኡንቱንቱካ፥ እ ሃሳዬዳ ቃላን አሳ ስንን ኦይቃናዉ ዳንዳይበይክኖ። አ ዛሩዋን ማላለቲደ ጮኡ ጌድኖ።<verse eid="LUK 20:26"/></para>
  <para style="s1">ሀይቁዋፐ ደንዱዋባ ኦሻ</para>
  <para style="r">(<ref loc="MAT 22:23-33">ማቶሳ 22:23-33</ref>፤ <ref loc="MRK 12:18-27">ማር. 12:18-27</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27"/>ሳዱቃዋናቱፐ እቱ እቱ የሱሳኮ ዪደ፥ ኦሻ አዉ ሺሼድኖ።<note caller="-" style="x"><char style="xo" closed="false">20:27 </char><char style="xt" closed="false"><ref loc="ACT 23:8">ኪታ 23:8</ref></char></note> <verse eid="LUK 20:27"/><verse number="28" style="v" sid="LUK 20:28"/>ኡንቱንቱካ የሱሳ፥<note caller="-" style="x"><char style="xo" closed="false">20:28 </char><char style="xt" closed="false"><ref loc="DEU 25:5">ዛረ. 25:5</ref></char></note> “ታማርስያዎ፥ እት ብታኒ ማቻቶ አኪደ ናኣ የለናን ሀይያዋ ግዶፐ፥ ምሽራቶ ሄዋ እሻይ ላታ አክ ናኣ የሊደ ባረ እሻዉ ዘረ ዎና ማላ ሙሴ ኑዉ ጻፌዳ። <verse eid="LUK 20:28"/><verse number="29" style="v" sid="LUK 20:29"/>እት ዎድያን ላፑ እሻቱ ደእያዋንቱፐ፥ ባይራይ ማቻቶ አኪደ የለናን ሀይቂ አጌዳ። <verse eid="LUK 20:29"/><verse number="30" style="v" sid="LUK 20:30"/>ላኤንያዌካ እዞ ላቴዳ። <verse eid="LUK 20:30"/><verse number="31" style="v" sid="LUK 20:31"/>ሄዘንያዌካ ቃይ እዞ አኬዳ፤ ላፑናቱካ እዞ አኪደ ናኣ የለናን ሀይቄድኖ። <verse eid="LUK 20:31"/><verse number="32" style="v" sid="LUK 20:32"/>ዉርሰን ምሽራታካ ሀይቃ አጋዱ። <verse eid="LUK 20:32"/><verse number="33" style="v" sid="LUK 20:33"/>ስም ላፑናቱካ ሄ ምሽራቶ አኬዳ ድራዉ፥ ሀይቁዋፐ ደንዴዳ ዎደ፥ እዛ ኦስ ማቼ ግዳኔ?” ያግ ኦቼድኖ።<verse eid="LUK 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34"/>የሱስካ፥ “ሀ አላምያ ናናይ አኪኖነ አከቲኖ። <verse eid="LUK 20:34"/><verse number="35" style="v" sid="LUK 20:35"/>ሽን ሀይቁዋፐ ደንዲደ፥ ስንፐ ይያ ዎድያን ደአናዉ በስያዋንቱ አክክኖነ አከትክኖ። <verse eid="LUK 20:35"/><verse number="36" style="v" sid="LUK 20:36"/>ኡንቱንቱ ጾሳ ኪታንቻ ማላቲደ ደእያ ድራዉ፥ ሄዋፐ ስሚደ ሀይቂክኖ። ሀይቁዋፐ ደንድያዋንታ ግድያ ድራዉ ኡንቱንቱ ጾሳ ናና። <verse eid="LUK 20:36"/><verse number="37" style="v" sid="LUK 20:37"/>ሙሴ፥ ጾሳይ አዉ ቆንጬዳ ዎራባ ጻፌዳ ታርክያ ጋርሳን፥ ጎዳ ጾሳ፥ ‘አብራሃሞ ጾሳ፥ ይሳቃ ጾሳ፥ ያቆባ ጾሳ’ ያጊደ ጼሱሳይ፥ ሀይቃዋንቱ ደንድያዋ በሴ።<note caller="-" style="x"><char style="xo" closed="false">20:37 </char><char style="xt" closed="false"><ref loc="EXO 3:6">ከሳ 3:6</ref></char></note> <verse eid="LUK 20:37"/><verse number="38" style="v" sid="LUK 20:38"/>ኡባይካ አዉ ሀይቂ ቤናዋንታ ግድያ ድራዉ፥ እ ሀይቂቤናዋንቱ ጾሳፐ አትን፥ ሀይቆዋንቱዋ ግደና” ያጌዳ።<verse eid="LUK 20:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39"/>እት እት ሙሴ ህግያ ጻፌዳዋንቱካ፥ “ታማርስያዎ፥ ሎኡዋ ሃሳያዳ” ያጌድኖ። <verse eid="LUK 20:39"/><verse number="40" style="v" sid="LUK 20:40"/>ሀዋፐ ስሚደ፥ እቱካ አ ኦቻናዉ ጻሎዌ ባዋ።<verse eid="LUK 20:40"/></para>
  <para style="s1">የሱስ ኦኔ ግያ ኦሻ</para>
  <para style="r">(<ref loc="MAT 22:41-46">ማቶሳ 22:41-46</ref>፤ <ref loc="MRK 12:35-37">ማር. 12:35-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41"/>ሀዋፐ ካላ የሱስ ኡንቱንታ፥ “አሳይ ክርስቶሳ ዎት ‘ዳዊተ ናኣ’ ያጊኖ? <verse eid="LUK 20:41"/><verse number="42-43" style="v" sid="LUK 20:42-43"/>ጋሶተይኔካ፥ ዳዊተ ባረ ሁጰዉ ማዝሙረ ማጻፋ ጋርሳን፥</para>
  <para style="q1" vid="LUK 20:42-43">“ ‘ጎዳይ ታ ጎዳ፥ “ታን ነ ሞርከቱዋ፥</para>
  <para style="q2" vid="LUK 20:42-43">ነ ገድያፐ ጋርሳና ደአናዳን ኦና ጋካናዉ፥</para>
  <para style="q2" vid="LUK 20:42-43">ታ ኡሸቻን ኡታ” ጌዳ’</para>
  <para style="m" vid="LUK 20:42-43">ያጌዳ።<verse eid="LUK 20:42-43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 20:44"/>“ስም ዳዊተ ክርስቶሳ፥ ‘ጎዳ’፥ ጊደ ጼስያዋ ግዶፐ፥ ዎት አዉ ናኣ ግዳና ዳንዳዪ?” ያጌዳ።<verse eid="LUK 20:44"/></para>
  <para style="s1">ሙሴ ህግያ ታማርስያዋንቱፐ ናገታና ማላ፥ የሱስ ሴሬዳ ሴራ</para>
  <para style="r">(<ref loc="MAT 23:1-36">ማቶሳ 23:1-36</ref>፤ <ref loc="MRK 12:38-40">ማር. 12:38-40</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45"/>አሳይ ኡባይ ስስሽን ባረና ካልያዋንቶ፥ <verse eid="LUK 20:45"/><verse number="46" style="v" sid="LUK 20:46"/>“ሙሴ ህግያ ታማርስያዋንቱፐ ናገትተ፤ ኡንቱንቱካ፥ አዱሳ ቃምሽያ ማዪደ ዩያናዉ፥ ገያይ ደእያ ሳን ቦንቾ ሳሮታ አካናዉ፥ ዎስያ ጎለን ቦንቾ ኦይድያን ኡታናዉ፥ ሾበቴዳሳን ቦንቾሳ ኮይያዋንታ። <verse eid="LUK 20:46"/><verse number="47" style="v" sid="LUK 20:47"/>ሄዋንቱካ አምአቱዋ ጎልያ ካሎይያዋንታ፤ ባረንታ በሳናዉ ዎሳ አዱስያዋንታ፤ ኡንቱንታ ኢታ ፕርዳይ ናገ” ያጌዳ።<verse eid="LUK 20:47"/></para>
  <chapter eid="LUK 20"/>
  <chapter number="21" style="c" sid="LUK 21"/>
  <para style="s1">አምአትባነ እዝ እሞታ</para>
  <para style="r">(<ref loc="MRK 12:41-44">ማር. 12:41-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1"/>የሱስ ቁ ጊደ ጼልያ ዎደ፥ ዱረ አሳይ ጌሻ ጎልያን እሞታ ሺሽያ ሚሻ ግዶን ባረንቶ ደእያዋፐ ኡንቱንቱ የግያ ዎደ በኤዳ። <verse eid="LUK 21:1"/><verse number="2" style="v" sid="LUK 21:2"/>ቃይካ እት ህዬሳ አምኤ ምሽራታ ላኡ ሰምበርያ ሄዋን የግያ ዎደ በኢደ፥ <verse eid="LUK 21:2"/><verse number="3" style="v" sid="LUK 21:3"/>“ታ ህንተዉ ቱሙዋ ጋይ፥ ሀ ህዬሳ አምኤ ምሽራታ፥ ኦፐነ ዳሩዋ እማዱ። <verse eid="LUK 21:3"/><verse number="4" style="v" sid="LUK 21:4"/>ሀ አሳይ ኡባይ ባረንቶ ፓላሆዋፐ እሜድኖ፤ ሽን እዛ ባረ ህዬሳተትሃ ዎልቃን ባረዉ ደእያዋ ኡባ እማዱ” ያጌዳ።<verse eid="LUK 21:4"/></para>
  <para style="s1">ጌሻ ጎሊ ኮለታናዋ የሱስ ካሰቲደ ኦዴዳ</para>
  <para style="r">(<ref loc="MAT 24:1-2">ማቶሳ 24:1-2</ref>፤ <ref loc="MRK 13:1-2">ማር. 13:1-2</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5"/>አ ካልያዋንቱፐ እቱ እቱ፥ “ጌሻ ጎሊ ሎኦ ሹቻንነ ባላ ሺቁዋ እሞታን ሎኤዳዋ” ያግ ሃሳይያ ዎደ የሱስ፥ <verse eid="LUK 21:5"/><verse number="6" style="v" sid="LUK 21:6"/>“ሀዌ ህንተንቱ በእያዌ ኡባይ ኮለተናን፥ ሹቻይ ሹቻ ቦላን ኬለቲደ አተና ዎዲ ያናዋ” ያጌዳ። <verse eid="LUK 21:6"/><verse number="7" style="v" sid="LUK 21:7"/>ኡንቱንቱካ፥ “ታማርስያዎ፥ ስም ሀዌ ሀናናዌ አዉዴ? ቃይካ ሀዌ ሀናናዉ ማላይ አዬ?” ያጊድ ኦቼድኖ።<verse eid="LUK 21:7"/></para>
  <para style="s1">የሱስ መቱዋ ዎዲነ ናሸቻ ዎዲ ያናዋ ኦዴዳ</para>
  <para style="r">(<ref loc="MAT 24:3-13">ማቶሳ 24:3-13</ref>፤ <ref loc="MRK 13:3-13">ማር. 13:3-13</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8"/>እካ፥ “ኦንነ ባለናዳን ናገትተ፤ ጮራ አሳይ፥ ‘ታን ክርስቶሳ’ ያጊደ ቃይካ፥ ‘ዎዲ ማቴዳ’ ያጊደ ታ ሱንን ያናዋንታ፤ ህንተንቱ ቃይ ኡንቱንታ ካሎፕተ። <verse eid="LUK 21:8"/><verse number="9" style="v" sid="LUK 21:9"/>ኦላ የዉዋነ አሳ ማካላባ ስስያ ዎደ ዳጋሞፕተ፤ ሀዌ ኮይሮ ሀናናዉ በስያዋ ግዶ ድራፐ አትን ዉርሰይ ብራ” ያጌዳ።<verse eid="LUK 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10"/>ሄዋፐ ካሊደ አሳዉ፥ “አሳይ አሳ ቦላ፥ ካዉተይካ ካዉተ ቦላ፥ ደንዳናዋ፤ <verse eid="LUK 21:10"/><verse number="11" style="v" sid="LUK 21:11"/>ዎልቃማ ቢታ ቃይ ሀናናዋ፤ ኮሻይነ ሀርጊ፥ ዱማ ዱማሳን መታናዋ፤ ያሽያ የዉነ ኡባካ ዎልቃማ ማላታይ ሳሉዋፐ ሀናናዋ።<verse eid="LUK 21:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 21:12"/>“ሀዌ ኡባይ ሀናናፐ ካስያን ቃይ አሳይ ህንተንታ ኦይቃናዋንታ፥ መቶናዋንታ፤ ህን አይሁዳቱዋ ዎሳ ጎለ አሳዉ አ እማናዋንታ፤ ቃሾ ጎለካ ገልሳናዋንታ፤ ካታቱዋ ስንንነ ሞድያዋንቱ ስንን ሺሻናዋንታ፤ ሀዌ ኡባይ ታ ሱን ጋሱዋን ህንተንታ ጋካናዋ። <verse eid="LUK 21:12"/><verse number="13" style="v" sid="LUK 21:13"/>ሀዌካ ማርካታናዉ ህንተዉ ሎኦ ካጫ ግዳናዋ። <verse eid="LUK 21:13"/><verse number="14" style="v" sid="LUK 21:14"/>ሀዋ ግድያ ድራዉ፥ አይ ዛሩዋ እማኔ ጊደ ኮይሮቲደ ህንተንቱ ኡንኤተና ማላ ሀዋ ዎዛና አተ። <verse eid="LUK 21:14"/><verse number="15" style="v" sid="LUK 21:15"/>ኤቀትያዋንቱ ኡባይ፥ ኤቀታናዉነ ላካናዉ ዳንዳየና ቃላነ አ ጭንጫተ ታን ህንተንቶ እማና።<note caller="-" style="x"><char style="xo" closed="false">21:15 </char><char style="xt" closed="false"><ref loc="LUK 12:11-12">ሉቃሳ 12:11-12</ref></char></note> <verse eid="LUK 21:15"/><verse number="16" style="v" sid="LUK 21:16"/>ህንተንታ የሌዳዋንቱነ ህንተንቱ እሻቱ፥ ህንተንቱ ዳባቱነ ህንተንቱ ላገቱካ አተናን ህንተንታ አ እማናዋንታ፤ ህንተንቱፐካ እቱዋ እቱዋ ዎናዋንታ። <verse eid="LUK 21:16"/><verse number="17" style="v" sid="LUK 21:17"/>ታ ሱን ድራዉ አሳ ኡባ ማታን እጸቴዳዋንታ ግዳንታ። <verse eid="LUK 21:17"/><verse number="18" style="v" sid="LUK 21:18"/>የዉዋን ቃይ ህንተንቱ ሁጲያ ብናናፐካ እትናነ ባዩኩ። <verse eid="LUK 21:18"/><verse number="19" style="v" sid="LUK 21:19"/>ምን ኤቂደ ህንተንቱ ሸምፑዋ አሺታ።<verse eid="LUK 21:19"/></para>
  <para style="s1">የሱስ የሩሳላመ ባየባ ኦዴዳ</para>
  <para style="r">(<ref loc="MAT 24:15-21">ማቶሳ 24:15-21</ref>፤ <ref loc="MRK 13:14-19">ማር. 13:14-19</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20"/>“የሩሳላመ ኦላ አሳን ዶደቴዳ ዎደ፥ እዝ ባየይ ማቴዳዋ ኤርተ። <verse eid="LUK 21:20"/><verse number="21" style="v" sid="LUK 21:21"/>ሄ ዎደ ይሁዳን ደእያዋንቱ ደርያኮ ባቃትኖ፤ ካታማን ደእያዋንቱ ቃይ ሄዋፐ ከስኖ፤ ባላጋርያን ደእያዋንቱካ ያ ካታማኮ ገሎፕኖ፤ <verse eid="LUK 21:21"/><verse number="22" style="v" sid="LUK 21:22"/>ጾሳ ቃላን ጻፈቴዳዌ ኡባይ ፖለታናዳን ሀዌ ሀሉዋ ከስያ ዎድያ።<note caller="-" style="x"><char style="xo" closed="false">21:22 </char><char style="xt" closed="false"><ref loc="HOS 9:7">ሆሰ 9:7</ref></char></note> <verse eid="LUK 21:22"/><verse number="23" style="v" sid="LUK 21:23"/>ቢታ ቦላን ዎልቃማ መቱ ሀናናዋ፤ ሀእ ደእያ አሳ ቦላን ሀንቁ ያናዋ፤ ሄዋ ድራዉ ሄ ዎድያን ሻሃሮዋንቶነ ንያዋንቶ አየ! <verse eid="LUK 21:23"/><verse number="24" style="v" sid="LUK 21:24"/>አሳይ ኡባይ ማሻን ሀይቃናዋንታ፤ ጾሳ ኤረና ጋድያ ኡባቱካ ኦሞዱዋን ባናዋንታ፤ የሩሳላመካ አይሁዳ ግደናዋንቱ ዎዲ ፖለታና ጋካናዉ፥ ኡንቱንቱን የቴዳዉኖ ግዳናዉኑ።<verse eid="LUK 21:24"/></para>
  <para style="s1">ክርስቶሳ ላኤን ዩሳ</para>
  <para style="r">(<ref loc="MAT 24:29-31">ማቶሳ 24:29-31</ref>፤ <ref loc="MRK 13:24-27">ማር. 13:24-27</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25"/>“አዋ፥ አገናንነ ጾልንትያ ቦላ ማላታይ ሀናናዋ፤ አባፐነ ቤታ ኮሻፐ ደንዶ ጋሱዋን ቢታ ቦላን ደእያ አሳይ ኡባይ ኡንኤታናዋንታ፤ ህርጋናዋንታ።<note caller="-" style="x"><char style="xo" closed="false">21:25 </char><char style="xt" closed="false"><ref loc="ISA 13:10">ኢሳ. 13:10</ref>፤ <ref loc="EZK 32:7">ህዝ. 32:7</ref>፤ <ref loc="JOL 2:31">ኢዩ. 2:31</ref>፤ <ref loc="REV 6:12">ሳፃ 6:12</ref>፣ <ref loc="REV 6:13">13</ref></char></note> <verse eid="LUK 21:25"/><verse number="26" style="v" sid="LUK 21:26"/>ሳሉዋ ዎልቃይ ኡባይ ቃጽያ<note caller="+" style="f"><char style="fr" closed="false">21:26 </char><char style="fqa" closed="false">ሳሉዋ ዎልቃይ ኡባይ ቃጼ፦ </char><char style="ft" closed="false">ሀዋ ጉሳይ፥ በን ዎደ አሳይ፥ ሳሉዋን ደእያ ጾልንቲ ኡባይ አያና ዎልቃና ደኤ ጊደ ቆፔ።</char></note> ድራዉ አሳይ ያሻንነ አላምያ ቦላ አዬ ያናዌሻ ያጊደ ናጉዋን ዳቡራናዋንታ። <verse eid="LUK 21:26"/><verse number="27" style="v" sid="LUK 21:27"/>ሄ ዎደ አሳ ናአይ ዎልቃንነ ዎልቃማ ቦንቹዋን ሻርያን ይያ ዎደ በአናዋንታ።<note caller="-" style="x"><char style="xo" closed="false">21:27 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳኔላ 7:13</ref>፤ <ref loc="REV 1:7">ሳፃ 1:7</ref></char></note> <verse eid="LUK 21:27"/><verse number="28" style="v" sid="LUK 21:28"/>ህንተንቱካ፥ ሀ የዉ ፖለቱሳ ዶምያ ዎደ፥ ዎዙ ጼቱዋ ድራዉ ስት ጊደ ኤቂተ፤ ፑደ ቁ ጊደ ጼልተ” ጌዳ።<verse eid="LUK 21:28"/></para>
  <para style="s1">ባላስያ ጌተትያ ም ሌምሱዋ</para>
  <para style="r">(<ref loc="MAT 24:32-35">ማቶሳ 24:32-35</ref>፤ <ref loc="MRK 13:28-31">ማር. 13:28-31</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29"/>ካሊደካ፥ ሀዋ ያግ ሌምሱዋ ኦዴዳ፥ “ዎደንፐነ ሀራ ም ኡባፐ ጼልተ፤ <verse eid="LUK 21:29"/><verse number="30" style="v" sid="LUK 21:30"/>ሀይይ አጭና በእያ ዎደ፥ ሄ ዎደ ቦኒ ማቴዳዋ ህንተንቱ ኤሪታ። <verse eid="LUK 21:30"/><verse number="31" style="v" sid="LUK 21:31"/>ሄዋዳንካ ቃይ የዋቱ ፖለትያዋ በእያ ዎደ፥ ጾሳ ካዉተታ ማቴዳዉኖ ኤርተ።<verse eid="LUK 21:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 21:32"/>“ታን ህንተዉ ቱሙዋ ጋይ፤ ሀዌ ኡባይ ፖለታና ጋካናዉ ሀ የለታይ አና። <verse eid="LUK 21:32"/><verse number="33" style="v" sid="LUK 21:33"/>ሳሉነ ሳአይ አና፤ ሽን ታ ቃላይ አና። <verse eid="LUK 21:33"/><verse number="34" style="v" sid="LUK 21:34"/>ስም ዛዋይ ባይና ደኡዋን፥ ኡሻ ዳሩዋነ ደኡዋባን ኡንኤትሽን ህንተንቱ ዎዛናይ ለፐናዳንነ ሄ ጋላሳይ ጲርያዳን ቆፐናን ህንተና ጋከናዳን ናገትተ፤ <verse eid="LUK 21:34"/><verse number="35" style="v" sid="LUK 21:35"/>ሀዌ ቢታ ኡባን ደእያዋንቱ ኡባቱዋ ቦላን ጋካናዋ። <verse eid="LUK 21:35"/><verse number="36" style="v" sid="LUK 21:36"/>ስም ይያ ኢታባ ኡባፐ ህንተንቱ አታናዳንነ አሳ ናኣ ስንንካ ኤቃናዉ ዳንዳያና ማላ፥ ኡባ ዎደ ምን ዎስተ” ያጌዳ።<verse eid="LUK 21:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37"/>የሱስ ጋላስ ጋላስ ጌሻ ጎልያን ታማርሲደ፥ ቃማ ቃማ ደብረ ዛይተ ያገትያ ደርያኮ ከሲደ አቄ። <verse eid="LUK 21:37"/><verse number="38" style="v" sid="LUK 21:38"/>አሳይ ኡባይ አ ስሳናዉ ጉራን ያ ጌሻ ጎልያ አኮ ዪኖ።<verse eid="LUK 21:38"/></para>
  <chapter eid="LUK 21"/>
  <chapter number="22" style="c" sid="LUK 22"/>
  <para style="s1">ክርስቶሳ ዎናዉ ማቀቴድኖ</para>
  <para style="r">(<ref loc="MAT 26:1-5">ማቶሳ 26:1-5</ref>፤ <ref loc="MRK 14:1-2">ማር. 14:1-2</ref>፤ <ref loc="JHN 11:45-53">ዮሃ. 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1"/>ፓስጋ ጌተትያ ማጋገ ኡክ ምያ ባላይ ማቴዳ።<note caller="-" style="x"><char style="xo" closed="false">22:1 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">ከሳ 12:1-27</ref></char></note> <verse eid="LUK 22:1"/><verse number="2" style="v" sid="LUK 22:2"/>ቄሳቱዋ ካፓቱነ ሙሴ ህግያ ጻፍያዋንቱ የሱሳ ዎት ዎነንቶ፥ ዎያ ኦግያ ጌማን ኮዪኖ፤ ሽን አሳዉ ያዪኖ። <verse eid="LUK 22:2"/><verse number="3" style="v" sid="LUK 22:3"/>ጻላሂካ ታማነ ላኡ ካልያዋንቱፐ እቱዋ ግዴዳ አስቆሮቱ ይሁዳን ገሌዳ። <verse eid="LUK 22:3"/><verse number="4" style="v" sid="LUK 22:4"/>እካ ቢደ፥ የሱሳ ዎት አ እማነንቶ ቄሳቱዋ ካፓቱዋናነ ጌሻ ጎልያ ናግያዋንቱ ካፓቱዋና እትፐ ሃሳዬዳ። <verse eid="LUK 22:4"/><verse number="5" style="v" sid="LUK 22:5"/>ኡንቱንቱካ ናሸቲደ፥ ሚሻካ ይሁዳዉ እማናዉ ዉለቴድኖ። <verse eid="LUK 22:5"/><verse number="6" style="v" sid="LUK 22:6"/>እካ ኤኖ ጌዳ፤ አሳይ ባይና ሳን የሱሳ አ እማናዉ እንጀትያ ዎድያ ኮዬ።<verse eid="LUK 22:6"/></para>
  <para style="s1">የሱስ አይሁዳቱዋ ፓስጋ ማናዉ ጊገቴዳ</para>
  <para style="r">(<ref loc="MAT 26:17-25">ማቶሳ 26:17-25</ref>፤ <ref loc="MRK 14:12-21">ማር. 14:12-21</ref>፤ <ref loc="JHN 13:21-30">ዮሃ. 13:21-30</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7"/>ማጋገ ኡክ ምያ ባላ ቦንችያ ዎዲ ጋኬዳ፤ ሄ ዎዲካ ፓስጋዉ ዶርሳ ሹካናዉ በስያ ዎድያ። <verse eid="LUK 22:7"/><verse number="8" style="v" sid="LUK 22:8"/>የሱስ ጰጽሮሳነ ዮሃንሳ፥ “ፓስጋ ቁማ ኑን ማናዳን ቢደ ጊግስተ” ጊደ ኪቴዳ።<verse eid="LUK 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 22:9"/>ኡንቱንቱካ ዛሪደ፥ “ሀቃን ጊግሳናዳን ኮያይ?” ያግ ኦቼድኖ። <verse eid="LUK 22:9"/><verse number="10" style="v" sid="LUK 22:10"/>እካ፥ “ህንተንቱ፥ ካታማ ገልያ ዎደ ኦቱዋና ሃ ቶኬዳ ብታኒ<note caller="+" style="f"><char style="fr" closed="false">22:10 </char><char style="fk" closed="false">ሃ ቶኬዳ ብታኒ፦ </char><char style="ft" closed="false">ሄ ዎደ ሄ ጋደን አሳ ጎለን ኪተትያ አቱማ ቆማይ ሃ ቶኮፐ፥ ሄ ጎሊ ዱረ ግድያዋ በሴ።</char></note> ህንተንቱና ጋከታናዋ፤ እ ገልያ ጎልያ አ ካሊደ ገልተ፤ <verse eid="LUK 22:10"/><verse number="11" style="v" sid="LUK 22:11"/>ሄ ጎልያዋካ፥ ‘ታማርስያዌ ኔና፥ “ታን፥ ታና ካልያዋንቱና እትፐ ፓስጋ ቁማ ምያ እማ ክፍሊ ሀቃ ባጋና ደኢ?” ያጌ’ ጊተ። <verse eid="LUK 22:11"/><verse number="12" style="v" sid="LUK 22:12"/>ሄ ብታኒካ ፖቅያ ቦላን ደእያ ሂጸት ኡቴዳ አኮ ክፍልያ ህንተንታ በሳናዋ፤ ሄዋንካ ሳኣ ጊግስተ” ያጌዳ።<verse eid="LUK 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 22:13"/>ኡንቱንቱ ቢደ፥ የሱስ ጎዋዳንካ ብታንያ ደሚደ ፓስጋ ቁማ ጊግሴድኖ። <verse eid="LUK 22:13"/><verse number="14" style="v" sid="LUK 22:14"/>ፓስጋ ቁማይ ሜተትያ ሳቲ ጋኮ ዎደ፥ ታማነ ላኡ ኪተቶዋንቱና እትፐ ቁማ ማናዉ ኡቴዳ። <verse eid="LUK 22:14"/><verse number="15" style="v" sid="LUK 22:15"/>እካ፥ “ታና መቱ ጋካናፐ ካስያን ህንተንቱና ሀ ፓስጋ ቁማ ማናዉ ዳሮ አሞታደ ደአይ። <verse eid="LUK 22:15"/><verse number="16" style="v" sid="LUK 22:16"/>አያዉ ጎፐ፥ ታ ህንተዉ ኦድያዌ፥ ሀዌ ጾሳ ካዉተን ፖለታና ጋካናዉ፥ ታን ላኤንዋ ሀዋፐ ሚከ” ያጌዳ።<verse eid="LUK 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 22:17"/>ጹኣ አኪደ፥ ጾሳ ጋላቲደ፥ “ሀዋ ሄይተ፥ ህንተንቱ ግዱዋን ግሸት ኡሽተ። <verse eid="LUK 22:17"/><verse number="18" style="v" sid="LUK 22:18"/>አያዉ ጎፐ፥ ታ ህንተንቶ ያጋይ፥ ጾሳ ካዉተይ ያና ጋካናዉ፥ ሀቼፐ ዶማደ ዎይንያ ኤሳ ኡሽከ” ያጌዳ።<verse eid="LUK 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19"/>ቃይ ማጋገ ኡክ አኪደ፥ ጾሳ ጋላቴዳ፤ ሄ ኡክ መን ኡንቱንቶ እሚደ፥ “ሀዌ ህንተንቶ እመትያዌ ታ አሹዋ፤ ሀዋን ታና ቆፓና ማላ ሀዋ ሚተ” ያጌዳ። <verse eid="LUK 22:19"/><verse number="20" style="v" sid="LUK 22:20"/>ካዉዋ ሞዋፐ ጉይያን፥ ካሰዋዳን ጹኣ ደን ኡንቱንቶ እሚደ፥ ሀዋዳን ያጌዳ: “ሀ ጹአይ፥ ታ ህንተንቱ ድራዉ ጉስያ ታ ሱ ቆፈያ ኦራ ጫቁዋ።<note caller="-" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="MAT 26:26-28">ማቶሳ 26:26-28</ref>፤ <ref loc="MRK 14:22-24">ማር. 14:22-24</ref>፤ <ref loc="1CO 11:23-25">1 ቆሮ. 11:23-25</ref></char></note> <verse eid="LUK 22:20"/><verse number="21" style="v" sid="LUK 22:21"/>ሽን በእተ፥ ታና አ እማናዉ ደእያ ብታኒ ጋይታን ታናና እትፐ ሜ። <verse eid="LUK 22:21"/><verse number="22" style="v" sid="LUK 22:22"/>አያዉ ጎፐ፥ ታን አሳ ናአይ ጾሳይ ጎዋዳን ባይ፤ ሽን ታና አደ እምያ ኡራዉ አዉ አየ” ያጌዳ። <verse eid="LUK 22:22"/><verse number="23" style="v" sid="LUK 22:23"/>ኡንቱንቱ ግዶፐ ሄዋ ኦናዉ ደእያዌ ኦና ግዳነንቶ፥ ባረንቱ ግዶን ኦሻ ዶሜድኖ።<verse eid="LUK 22:23"/></para>
  <para style="s1">ኡባፐ አያዌ ኦኔ? ያግያ ኦሻ</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24"/>ቃይ ባረንቱ ግዶፐ ኦን አንቶ ያገትያ ፓሉማይ ኡንቱንቱ ግዶን ከሴዳ። <verse eid="LUK 22:24"/><verse number="25" style="v" sid="LUK 22:25"/>የሱስ ኡንቱንታ ያጌዳ: “ሀ አላምያ ሞድያዋንቱ ባረንቱ አሳ ቦላ ጎዳቲኖ፤ ኡንቱንታ ሞድያዋንቱ ኬካቱዋ ጌተቲኖ። <verse eid="LUK 22:25"/><verse number="26" style="v" sid="LUK 22:26"/>ሽን ህንተንቱ ሀዋዳን ሀኖፕተ፤ የዉዋን ቃይ ህንተንቱፐ ቃ ግዴዳዌ ህንተ ኡባፐ ጉጽያዋ፤ ህንተንታ ሞድያዌካ፥ ህንተንቶ ቆማዳን ሀኖ።<note caller="-" style="x"><char style="xo" closed="false">22:26 </char><char style="xt" closed="false"><ref loc="MAT 23:11">ማቶሳ 23:11</ref>፤ <ref loc="MRK 9:35">ማር. 9:35</ref></char></note><verse eid="LUK 22:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 22:27"/>“ቁማ ማናዉ ኡቴዳዋፐነ ቁማ አሳዉ አያዋፐነ ኦን ቦንቼቲ? ቁማ ማናዉ ኡቴዳዋ ግደኔ? ታን ቃይ ህንተንቱ ግዶን ቁማ አያ ቆማ ማላ። <verse eid="LUK 22:27"/><verse number="28" style="v" sid="LUK 22:28"/>ቃይ ታን ፓጨትያ ዎድያን ህንተንቱ ታናና እትፐ ምን ኤቄዳዋንታ። <verse eid="LUK 22:28"/><verse number="29-30" style="v" sid="LUK 22:29-30"/>አ ካዉተ ኦይድያን ኡታና ማላ ታ አቡ ታና ሱንዋዳን፥ ታን ቃይ ታ ካዉተን ታ ጋይታፐ ማናዳንነ ኡሻናዳን፥ ታማነ ላኡ እስራኤልያ ያራቱዋ ቦላ ፕርዲደ፥ ካዉተ ኦይድያን ኡታና ማላ ህንተንታ ሱንድ” ያጌዳ።<verse eid="LUK 22:29-30"/></para>
  <para style="s1">ጰጽሮስ ካዳናዋ የሱስ ካሰቲደ ኦዴዳ</para>
  <para style="r">(<ref loc="MAT 26:31-35">ማቶሳ 26:31-35</ref>፤ <ref loc="MRK 14:27-31">ማር. 14:27-31</ref>፤ <ref loc="JHN 13:36-38">ዮሃ. 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31"/>ጎዳይ፥ “ስሞና፥ ስሞና፥ ታን ኦድያዋ ስሳ፤ ጻላሂ ህንተንታ አሳይ ዛርጋ ሀልእያዋዳን፥ ሀልአናዉ ጾሳ ዎሴዳ። <verse eid="LUK 22:31"/><verse number="32" style="v" sid="LUK 22:32"/>ሽን ታን ነ አማኑ ባየናዳን ነ ድራዉ ጋናታድ። ኔን ታኮ ስምያ ዎደ ነ እሻቱዋ ምንሳ” ያጌዳ። <verse eid="LUK 22:32"/><verse number="33" style="v" sid="LUK 22:33"/>ስሞን ዛሪደ፥ “ጎዳዉ፥ ታን ኔናና ቃሸታናዉነ ኔናና እትፐ ሀይቃናዉ ጊጋ ኡታድ” ያጌዳ።<verse eid="LUK 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34"/>የሱስ ቃይ፥ “ጰጽሮሳ፥ ታን ነዉ ያጋይ፤ ሀቼ ብላህያን፥ ኩቱ ዋሳናዉ ሄዙ ገደ ታና ኔን፥ ‘አ ታን ኤርከ’ ጋደ ካዳናሳ” ያጌዳ። <verse eid="LUK 22:34"/><verse number="35" style="v" sid="LUK 22:35"/>የሱስ ባረና ካልያዋንቶ፥ “ኮሮጁ፥ ቃርጪቲነ ጫማይ ባንታን ታን ህንተንታ ኪቶ ዎደ፥ ህንተንቶ እትባይ ፓጮዌ ደኢ?” ያጌዳ።</para>
  <para style="p" vid="LUK 22:35">ኡንቱንቱካ፥ “እትባይነ ኑዉ ፓጭቤና” ያጌድኖ።<note caller="-" style="x"><char style="xo" closed="false">22:35 </char><char style="xt" closed="false"><ref loc="MAT 10:9">ማቶሳ 10:9</ref>፣ <ref loc="MAT 10:10">10</ref>፤ <ref loc="MRK 6:8">ማር. 6:8</ref>፣ <ref loc="MRK 6:9">9</ref>፤ <ref loc="LUK 9:3">ሉቃሳ 9:3</ref>፤ <ref loc="LUK 10:4">10:4</ref></char></note><verse eid="LUK 22:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36"/>እካ ዛሪደ፥ “ሀእ ቃይ ኮሮጁኡ ደእያዌ አክ ቦ፤ ቃርጪት ደእያዌካ ሄዋዳን ኦ፤ ባይናዌ ቃይ ባረ ማዩዋ ዛልኢደ ማሻ ሻሞ። <verse eid="LUK 22:36"/><verse number="37" style="v" sid="LUK 22:37"/>አያዉ ጎፐ ታ ህንተዉ ያጋይ፥ ‘ሀዌ ማካላንቻቱና እትፐ ፓይደቴዳ’ ያገት ጾሳ ማጻፋን ጻፈቴዳዌ፥ ታናን ፖለተናን አተና። ኤ፥ ታዉ ጌተቴዳዌ ሀእ ፖለታናዋ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="ISA 53:12">ኢሳ. 53:12</ref></char></note><verse eid="LUK 22:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38"/>አ ካልያዋንቱ፥ “ጎዳዉ፥ ሀዋን ላኡ ማሻይ ደኤ” ያግና እካ፥ “ሄዌ ግዳናዋ” ያጌዳ።<verse eid="LUK 22:38"/></para>
  <para style="s1">የሱስ ደብረ ዛይተ ደርያን ዎሴዳ</para>
  <para style="r">(<ref loc="MAT 26:36-40">ማቶሳ 26:36-40</ref>፤ <ref loc="MRK 14:32-42">ማር. 14:32-42</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39"/>የሱስ ካታማፐ ከሲደ፥ ሀራ ጋላስ ብያዋዳንካ ደብረ ዛይተ ቤዳ። ቃይ አ ካልያዋንቱካ አ ጌዱዋ ቤድኖ። <verse eid="LUK 22:39"/><verse number="40" style="v" sid="LUK 22:40"/>ሄ ሳኣ ጋኪደ፥ “ፓጭያን ህንተንቱ ገለናን አታና ማላ፥ ዎስተ” ያጌዳ። <verse eid="LUK 22:40"/><verse number="41" style="v" sid="LUK 22:41"/>ሹቻ ኦልና ጋክያሳ ኬና ኡንቱንቱፐ ሃክ ቤዳ። ጉልባቲደ፥ <verse eid="LUK 22:41"/><verse number="42" style="v" sid="LUK 22:42"/>“ታ አቦ፥ ኔን ኮይያዋ ግዶፐ፥ ሀ መቱዋ ጹኣ ታፐ ድጋ፤ ሽን ታ ሸነ ግዶፖ፤ ነ ሸነ ግዶፐ አትን” ያጊደ ዎሴዳ። <verse eid="LUK 22:42"/><verse number="43" style="v" sid="LUK 22:43"/>ሳሉዋፐ ዪደ ምንስያ ኪታንቻይ አዉ ቤቴዳ። <verse eid="LUK 22:43"/><verse number="44" style="v" sid="LUK 22:44"/>ባረ ዎዛና ግዶን ሴለቲደ፥ ዳሪ ዎሴዳ። እ ጫዎትያ ጫዉካ ሳኣ ቦላን ጾክያ ሱ ማላቴዳ።<verse eid="LUK 22:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45"/>ዎሳፐ ደንዲደ፥ ባረና ካልያዋንቱኮ ጉየ ቢደ፥ ኡንቱንቱ ዳሮፐ ቃረቴዳ ድራዉ፥ ዳቡሪደ ገምእሾዋንታ ጼሊደ፥ <verse eid="LUK 22:45"/><verse number="46" style="v" sid="LUK 22:46"/>“አያዉ ገምእሺቴ? ፓጭያን ገለናዳን ደንድ ዎስተ” ያጌዳ።<verse eid="LUK 22:46"/></para>
  <para style="s1">የሱስ ባረ ሞርከቱዋ ኩሽያን ኦይቀቴዳ</para>
  <para style="r">(<ref loc="MAT 26:47-56">ማቶሳ 26:47-56</ref>፤ <ref loc="MRK 14:43-50">ማር. 14:43-50</ref>፤ <ref loc="JHN 18:3-11">ዮሃ. 18:3-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47"/>የሱስ ሄዋ ሃሳይ ደእሽን፥ ጮራ አሳይ ዬድኖ። ታማነ ላኡ አ ካልያዋንቱፐ እቱዋ ግዴዳ ይሁዳ ጌተትያዌ ሄ አሳ ካለደ የራናዉ የሱሳኮ ሺቄዳ። <verse eid="LUK 22:47"/><verse number="48" style="v" sid="LUK 22:48"/>የሱስ ቃይ፥ “ይሁዳዉ፥ ኔን ታና አሳ ናኣ የራደ አ እማይ?” ያጌዳ።<verse eid="LUK 22:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49"/>አ ዩሹዋን ደእያ አ ካልያዋንቱ ሀነትያ የዉዋ በኦ ዎደ አ፥ “ጎዳዉ፥ ሀ አሳ ኑን ማሻን ቃንጻኔ?” ያጌድኖ። <verse eid="LUK 22:49"/><verse number="50" style="v" sid="LUK 22:50"/>ኡንቱንቱፐ እቱ፥ ቄሳቱዋ ኡባቱዋ ካፑዋ ቆማ ሾጪደ፥ አ ኡሸቻ ሀይ ቃንጽ ኦሌዳ።<verse eid="LUK 22:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51"/>የሱስ ቃይ ዛሪደ፥ “አግተ፥ ባሽተ” ያጌዳ። ብታንያ ሀይካ ቦቺደ ፓዳ። <verse eid="LUK 22:51"/><verse number="52" style="v" sid="LUK 22:52"/>የሱስካ ባረኮ ዬዳ ቄሳቱዋ ካፓቶ፥ ጌሻ ጎልያ ናግያዋንቶ፥ ሱንቶነ ጋድያ ጭማቶ፥ “ፓኑዋ ኦይቂያዋዳን ማሻነ ጻምኣ ኦይቂደ ዪቴ? <verse eid="LUK 22:52"/><verse number="53" style="v" sid="LUK 22:53"/>ጌሻ ጎልያን ታን ጋላሳን፥ ጋላሳን ህንተንቱና ደእያ ዎደ፥ ታና ኦይቂበይክታ፤ ሽን ሀእ ሀዌ ህንተንቱ ዎደነ ማ ዎልቃ ዎደ” ያጌዳ።<verse eid="LUK 22:53"/></para>
  <para style="s1">ጰጽሮስ የሱሳ ካዴዳ</para>
  <para style="r">(<ref loc="MAT 26:57-58">ማቶሳ 26:57-58</ref>፣ <ref loc="MAT 26:69-72">69-72</ref>፤ <ref loc="MRK 14:53-54">ማር. 14:53-54</ref>፣ <ref loc="MRK 14:66-72">66-72</ref>፤ <ref loc="JHN 18:12-18">ዮሃ. 18:12-18</ref>፣ <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54"/>የሱሳ ኦይቂ ቃቺደ፥ ቄሳቱዋ ኡባ ካፑዋ ጎለ አፊደ ገልሴድኖ። ጰጽሮስካ ኡንቱንቱፐ ጉየ ሃኩዋን ኡንቱንቱ ጌዱዋ ካሌ። <verse eid="LUK 22:54"/><verse number="55" style="v" sid="LUK 22:55"/>ድርሳ ግዶን ታማ ኤደ፥ እትፐ ኡት ደእሽን፥ ጰጽሮስ ኡንቱንቱ ግዶን ዪደ ኡት አጌዳ። <verse eid="LUK 22:55"/><verse number="56" style="v" sid="LUK 22:56"/>ታማይ ፖእያ ባጋና ጰጽሮስ ኡቲደ ደእሽን፥ እት ቆማታ ሎይ ጼላደ፥ “ሀዌካ አናና እትፐ ደኤ” ያጋዱ።<verse eid="LUK 22:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57"/>ጰጽሮስ ቃይ፥ “ሀነ ምሽራቴ፥ ታን አ ኤርከ” ያግ ካዴዳ። <verse eid="LUK 22:57"/><verse number="58" style="v" sid="LUK 22:58"/>ጉ ዎድያፐ ጉይያን፥ ሀራ ብታኒ ጰጽሮሳ በኢደ፥ “ኔን ኡንቱንቱና ጋ ደኣ” ያግና፦</para>
  <para style="p" vid="LUK 22:58">ጰጽሮስ ቃይ፥ “ሀዎ ብታነዉ፥ ታን አናና ጋ ደእከ” ያጌዳ።<verse eid="LUK 22:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59"/>እት ሳተ ግድያዋ ጋምኢደ ሀራ ብታኒ ቆንጭሲደ፥ “እ ጋሊላ ጋደ አሳ ግድያ ድራዉ፥ ሀ ብታኒ አናና እትፐ ደእያዌ ቱማ” ያጌዳ። <verse eid="LUK 22:59"/><verse number="60" style="v" sid="LUK 22:60"/>ጰጽሮስ ቃይ፥ “ሀ ብታነዉ፥ ኔን ግያዌ አየንቶ ታን ኤርከ” ያጌዳ። ሄ ዎድያን እ ብሮካ ሃሳይ ደእሽን፥ ኤለካ ኩቱ ዋስ አጌዳ። <verse eid="LUK 22:60"/><verse number="61" style="v" sid="LUK 22:61"/>ጎዳይ ጉየ ስሚደ፥ ጰጽሮሳ ጼሌዳ። ጰጽሮስ ጎዳይ ባረና፥ “ሀቼ ኩቱ ዋሳና ጋካናዉ፥ ሄዙ ገደ ታና ካዳናሳ” ጌዳ ጎዳ ቃላይ አዉ ቆፈት አጌዳ። <verse eid="LUK 22:61"/><verse number="62" style="v" sid="LUK 22:62"/>ጰጽሮስ ድርሳፐ ካረ ከሲደ፥ ሴለቲደ ዬኬዳ።<verse eid="LUK 22:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63"/>የሱሳ ኦይቄዳ አሳይ ቅሊጪኖነ ሾጪኖ። <verse eid="LUK 22:63"/><verse number="64" style="v" sid="LUK 22:64"/>አ አይፍያ ጎዝ ባቂደ፥ “ኔና ባቄዳዌ ኦኔ? ናብያ ግዶፐ ኔና ደቻዋ አነ ኦዳ” ያጊደ አ ኦቼድኖ። <verse eid="LUK 22:64"/><verse number="65" style="v" sid="LUK 22:65"/>ቃይ አ ሀራ ጮራ ቦርያ ቦሬድኖ።<verse eid="LUK 22:65"/></para>
  <para style="s1">የሱሳ ፕርዳዉ አፌድኖ</para>
  <para style="r">(<ref loc="MAT 26:59-66">ማቶሳ 26:59-66</ref>፤ <ref loc="MRK 14:55-64">ማር. 14:55-64</ref>፤ <ref loc="JHN 18:19-24">ዮሃ. 18:19-24</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66"/>ሳአይ ዎንትና ጋድያ ጭማ አሳቱ፥ ቄሳቱዋ ካፓቱነ ሙሴ ህግያ ታማርስያዋንቱ፥ የሱሳ ባረንቱ ሺቄዳሳ አፊደ፥ <verse eid="LUK 22:66"/><verse number="67" style="v" sid="LUK 22:67"/>“ክርስቶስ ኔኔ? አነ ኑ ኦዳ” ያጌድኖ።</para>
  <para style="p" vid="LUK 22:67">ሽን እ፥ “ታን ህንተንቶ ኦዶፐ ታና አማንክታ፤ <verse eid="LUK 22:67"/><verse number="68" style="v" sid="LUK 22:68"/>ቃይ ህንተንታ ታን ኦቾፐ ኦድክታ፤ ዎይ ቃሹዋፐ ታና ብልክታ። <verse eid="LUK 22:68"/><verse number="69" style="v" sid="LUK 22:69"/>ሽን ሀ ሳትያፐ ዶምና ታን አሳ ናአይ፥ ሀእፐ ዶማደ፥ ዎልቃማ ጾሳ ኡሸቻ ባጋና ኡታና” ያጌዳ።<verse eid="LUK 22:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70"/>ኡንቱንቱ ኡባይ የሱሳ፥ “ያትና ኔን ጾሳ ናኤ?” ያጌድኖ።</para>
  <para style="p" vid="LUK 22:70">እካ ዛሪደ፥ “ታን ጾሳ ናኣ ግዶዋ ህንተንቱ ሃሳዬድታ” ያጌዳ። <verse eid="LUK 22:70"/><verse number="71" style="v" sid="LUK 22:71"/>ኡንቱንቱካ፥ “ኑን ኑ ሁጰዉ አ ዶናፐ ስሴዶ፤ ሀዋፐ ስንዉ አይ ማርካ ኮሺ?” ያጌድኖ።<verse eid="LUK 22:71"/></para>
  <chapter eid="LUK 22"/>
  <chapter number="23" style="c" sid="LUK 23"/>
  <para style="s1">ጵላጾስ የሱሳ ኦቼዳ</para>
  <para style="r">(<ref loc="MAT 27:1">ማቶሳ 27:1</ref>፣ <ref loc="MAT 27:2">2</ref>፣ <ref loc="MAT 27:11-14">11-14</ref>፤ <ref loc="MRK 15:1-5">ማር. 15:1-5</ref>፤ <ref loc="JHN 18:28-38">ዮሃ. 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1"/>ሄዋን ሺቄዳ ኡባቱካ እትፐ ደንዲደ፥ የሱሳ ጵላጾሳኮ አፌድኖ። <verse eid="LUK 23:1"/><verse number="2" style="v" sid="LUK 23:2"/>ኡንቱንቱካ፥ “ሀ ብታኒ ኑ አሳ ባለደ፥ አሳይ ሮመ ቢታ ካትያ ቄሳራዉ ጊራ እመና ማላ ድጊደ፥ ቃይ፥ ‘ታን ካትያ’ ያግሽን ደሜዶ” ያጊደ ሞቱዋ ዶሜድኖ።<verse eid="LUK 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3"/>ጵላጾስካ የሱሳ፥ “ሀዎ፥ አይሁዳቱዋ ካቲ ኔኔ?” ያጊደ ኦቼዳ።</para>
  <para style="p" vid="LUK 23:3">የሱስ ዛሪደ አ፥ “ኔን ጋ ደኣሳ” ያጌዳ። <verse eid="LUK 23:3"/><verse number="4" style="v" sid="LUK 23:4"/>ጵላጾስ ቄሳቱዋ ካፓቶነ አሳዉ ኦዲደ፥ “ታን ሀ ብታንያ ቦላን አይነ ኢታ ኦሱዋ ደማበይከ” ያጌዳ።<verse eid="LUK 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 23:5"/>ግዶፐ አትን ኡንቱንቱ፥ “ሀ ብታኒ ጋሊላፐ ዶሚደ፥ ሀራይ አቶ ሀዋ ጋካናዉካ፥ ይሁዳ ጋድያ ኡባ ባረ ትምርትያን ቃደ ደኤ” ያጊደ ምንስ ኦዴድኖ።<verse eid="LUK 23:5"/></para>
  <para style="s1">የሱስ ሄሮድሳ ስን ሺቄዳ</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6"/>ጵላጾስካ ሀዋ ስሲደ፥ “እ ጋሊላ አሴ?” ያጊደ ኤራናዉ ኦቼዳ። <verse eid="LUK 23:6"/><verse number="7" style="v" sid="LUK 23:7"/>ጵላጾስ ሄሮድሰ ሞድያ ጋድያፐ የሱስ ዬዳዋ ኤሬዳ ዎደ፥ ሄሮድሰካ ቃይ ሄ ዎድያን የሩሳላመን ደእያ ድራዉ፥ አኮ የሱሳ የዴዳ።<verse eid="LUK 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 23:8"/>ሄሮድሰ ዳሮ ዎድያፐ ዶሚደ የሱሳ በአናዉ አሞት ደእያ ድራዉ፥ አ በኤዳ ዎደ ዳሮፐ ናሸቴዳ። የሱሳ ዋርያ ስሴዳዋ ድራዉ፥ እ ኦራባ ኦሽን በአናዉ ህዶታን ጋምኤዳ። <verse eid="LUK 23:8"/><verse number="9" style="v" sid="LUK 23:9"/>ሄሮድሰ የሱሳ ዳሮባ ኦቼዳ፤ ሽን የሱስ አዉ አያነ ዛርቤና። <verse eid="LUK 23:9"/><verse number="10" style="v" sid="LUK 23:10"/>ቄሳቱዋ ካፓቱነ ሙሴ ህግያ ታማርስያዋንቱ ሄዋን ኤቂደ፥ የሱሳ ሎይ ሞቲደ ደኢኖ። <verse eid="LUK 23:10"/><verse number="11" style="v" sid="LUK 23:11"/>ሄሮድሰነ አ ዎታዳራቱ የሱሳ ካደ፥ አ ቦላ ቅሊጬድኖ። ቦንቼቴዳ ማዩዋ አ ማይዚደ፥ ጵላጾሳኮ ዛሪደ የዴድኖ። <verse eid="LUK 23:11"/><verse number="12" style="v" sid="LUK 23:12"/>ሄሮድሰነ ጵላጾስ ሀዋፐ ካሰና ሞርክያን ደኢኖ፤ ሽን ሄ ጋላስ ስገቴድኖ።<verse eid="LUK 23:12"/></para>
  <para style="s1">የሱሳ ሀይቃና ማላ ሞቴድኖ</para>
  <para style="r">(<ref loc="MAT 27:15-26">ማቶሳ 27:15-26</ref>፤ <ref loc="MRK 15:6-15">ማር. 15:6-15</ref>፤ <ref loc="JHN 18:39-19:16">ዮሃ. 18:39—19:16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13"/>ጵላጾስ ቄሳቱዋ ካፓቱዋ፥ አይስያዋንታነ ሀራ ጮራ አሳ እትፐ ጼሲደ፥ <verse eid="LUK 23:13"/><verse number="14" style="v" sid="LUK 23:14"/>ሀዋዳን ያጌዳ፥ “ ‘ሀ ብታኒ አሳ ማካላተዉ ደን’፥ ያጊደ ታኮ አሄድታ፤ ታንካ ህንተንቱ ስንን ብዳ ጼላደ፥ ህንተንቱ ሺሼዳ ሞቱዋን እት ባላነ አ ቦላን ደማበይከ። <verse eid="LUK 23:14"/><verse number="15" style="v" sid="LUK 23:15"/>ቃይ ሄሮድሰካ አ ቦላን አይነ ደምቤና ድራዉ፥ ሃ ኑኮ ዛር የዴዳ፤ ህንተንቱ በእያዋዳንካ፥ ሀ ብታኒ አ ሀይቆ ጋያባ አይነ ኦቤና። <verse eid="LUK 23:15"/><verse number="16" style="v" sid="LUK 23:16"/>ሀዋ ድራዉ ታን አ ሙራደ ብላና” ያጌዳ። <verse eid="LUK 23:16"/><verse number="17" style="v" sid="LUK 23:17"/><note caller="+" style="f"><char style="fr" closed="false">23:17 </char><char style="fqa" closed="false">ሀ ፓይዱ፦ </char><char style="ft" closed="false">“ጵላጾሳዉ ፓስጋ ባላ ቦንቹዋ ጋላሳን እት ኡራ ቃሹዋፐ ብልያ ዶያይ ደኤ” ያጌ። ሽን፥ ዳዉሮዋ ጌሻ ማጻፋ ኦራ ጫቁዋ ግዱዋን ሀ ፓይዱ ጻፈትቤና ጋሱ፥ ሀራ ጌሻ ማጻፋቱዋ ብለቱዋን ኡባቱዋንካ ጻፈትቤና ድራሳ።</char></note><verse eid="LUK 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18"/>አሳይ ኡባይ እትፐ ግዲደ፥ “ሀ ብታንያ ያ ድጋ! ባርባና ግያ የሱሳ ኑዉ ብላ!” ያጊደ ጫቦቴድኖ። <verse eid="LUK 23:18"/><verse number="19" style="v" sid="LUK 23:19"/>ባርባን ካታማን ዋላሳ ደንደ፥ አሳ ዎዳ ድራዉ፥ ቃሸቴዳዋ።<verse eid="LUK 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20"/>ጵላጾስ የሱሳ ብላናዉ ኮዪደ፥ አሳዉ ላኤንዋ ጉጂደ ሃሳዬዳ። <verse eid="LUK 23:20"/><verse number="21" style="v" sid="LUK 23:21"/>ሽን ኡንቱንቱ፥ “ማስቃልያ ቦላ ምስማርያን ሻደ ካቃ! ካቃ!” ያግ ዋሴድኖ።<verse eid="LUK 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22"/>ጵላጾስካ ሄዘንዋ ኡንቱንታ፥ “አያዉ? ሀ ብታኒ ኦዳ ኢታ ኦሱ አዬ? ታን አ ሀይቆ ጋያ ናቁዋ አይነ አፐ ደማበይከ፤ ሀዋ ድራዉ፥ አ ሙራደ ብላ የዳና” ያጌዳ። <verse eid="LUK 23:22"/><verse number="23" style="v" sid="LUK 23:23"/>ሽን ኡንቱንቱ ባረንቱ ኮሻ ቁ ኦደ፥ ካቀታናዳን ዳሪ ዋሴድኖ። ኡንቱንቱ ዋሱካ ጵላጾሳ ቆፋ ላሜዳ። <verse eid="LUK 23:23"/><verse number="24" style="v" sid="LUK 23:24"/>ሀዋ ድራዉ፥ ጵላጾስካ ኡንቱንቱ ኦሻይ ስማናዳን የሱሳ ቦላን ፕርዴዳ። <verse eid="LUK 23:24"/><verse number="25" style="v" sid="LUK 23:25"/>አሳ ማካላዉ ደንደነ ሸምፑዋ ዎደ፥ ቃሸቴዳ ብታንያ ብለታናዳን ኡንቱንቱ ዎሶ ድራዉ፥ ሄ ብታንያ ብሌዳ። ሽን የሱሳ ባረንቱ ሸንያዳን ኮዮዋ ኦና ማላ፥ አ እሜዳ።<verse eid="LUK 23:25"/></para>
  <para style="s1">የሱስ ማስቃልያን ካቀቴዳ</para>
  <para style="r">(<ref loc="MAT 27:31-44">ማቶሳ 27:31-44</ref>፤ <ref loc="MRK 15:21-32">ማር. 15:21-32</ref>፤ <ref loc="JHN 19:17-27">ዮሃ. 19:17-27</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26"/>የሱሳ ኦይቂ አፊደ ደእሽን፥ ስሞና ጌተትያ ቀሬና ብታኒ ሄራፐ ዪደ ደእሽን ደሚደ፥ ማስቃልያ ቶሲደ የሱሳና ባና ማላ ኦድኖ። <verse eid="LUK 23:26"/><verse number="27" style="v" sid="LUK 23:27"/>ዳሮ ጮራ አሳይነ ዬክያ ማጫዋንቱ ጉየና ካሊኖ። <verse eid="LUK 23:27"/><verse number="28" style="v" sid="LUK 23:28"/>የሱስ ጉየ ስሚደ ኡንቱንቶ፥ “ህንተኖ፥ የሩሳላመ ማጫዋንቶ፥ ህንተንቱ ሁጰዉነ ህንተንቱ ናናዉ ዬክተፐ አትን፥ ታዉ ዬኮፕተ፤ <verse eid="LUK 23:28"/><verse number="29" style="v" sid="LUK 23:29"/>‘ማን ግዴዳዋንቱነ የልቤና ኡሉ፥ ንቤና ንይ፥ አንጀቴዳዋንታ’ ጌተትያ ዎዲ ያናዋ። <verse eid="LUK 23:29"/><verse number="30" style="v" sid="LUK 23:30"/>ሄ ዎድያን፥ ‘ዞዛቶ፥ ኑ ቦላ ዎድተ፤ ዙኩላቱዋካ፥ ኑና ቆስተ’ ያጋንታ።<note caller="-" style="x"><char style="xo" closed="false">23:30 </char><char style="xt" closed="false"><ref loc="HOS 10:8">ሆሰ 10:8</ref>፤ <ref loc="REV 6:16">ሳፃ 6:16</ref></char></note> <verse eid="LUK 23:30"/><verse number="31" style="v" sid="LUK 23:31"/>ስም ቃየ ምን ሀዋዳን ሀኖፐ፥ መላ ምን ዋናናዌ?” ያጌዳ።<verse eid="LUK 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32"/>የሱሳና እትፐ ካቀታና ማላ፥ ኢታ ኦሱዋ ኦዳ ሀራ ላኡ አሳቱዋካ አፌድኖ። <verse eid="LUK 23:32"/><verse number="33" style="v" sid="LUK 23:33"/>ቄራነዉ ጌተትያሳ ጋኬዳ ዎድያን፥ የሱሳ ካቄድኖ። ኢታ ኦዋንታካ፥ እቱዋ ኡሸቻና፥ የኩዋ ሀድርሳና ካቄድኖ።<verse eid="LUK 23:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 23:34"/>የሱስ፥ “ታ አቦ፥ ኡንቱንቱ ባረንቱ ኦያዋ ኤረና ድራዉ፥ ኡንቱንቱ ናጋራ አቶ ጋ” ያጌዳ።</para>
  <para style="p" vid="LUK 23:34">ኡንቱንቱካ አ ማዩዋ ሳማ የገቲደ ግሸት አኬድኖ። <verse eid="LUK 23:34"/><verse number="35" style="v" sid="LUK 23:35"/>አሳይ ኤቂ ጼልሽን፥ ጋድያ ሞድያዋንቱ፥ “ሀራንታ አሼ፤ ጾሳን ዶረቴዳ ክርስቶስ አ ግዶፐ፥ አነ ባረ ሁጲያ አሸኔ?” ያጊደ ቅሊጬድኖ።<verse eid="LUK 23:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 23:36"/>ቃይ ዎታዳራቱካ ሺቂደ ቅሊጬድኖ፤ ጫሜዳ ዎይንያ ኤሳ አዉ አህ እሚደ፥ <verse eid="LUK 23:36"/><verse number="37" style="v" sid="LUK 23:37"/>“ሀዎ፥ ኔን አይሁዳ ካትያ ግዶፐ፥ ነ ሁጲያ አሻ!” ያጌድኖ።<verse eid="LUK 23:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38"/>ሁጲሳናካ፥ “ሀዌ አይሁዳ ካትያ” ያግያ ጻፉዋ ጻፌድኖ። <verse eid="LUK 23:38"/><verse number="39" style="v" sid="LUK 23:39"/>ኢታ ኦደ ካቀቴዳዋንቱፐ እቱ፥ ቦሪድነ ቶቺደ፥ “ሀዎ ኔን ክርስቶሳ ግድኪ? አነ አ ግዶፐ፥ ነ ሁጲያነ ኑና አሻ” ያጌዳ።<verse eid="LUK 23:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40"/>የኩ ቃይ አ፥ “ኔን ሀዋ ማላትያ ፕርዳ ቦላ ደኣደካ ጾሳዉ ያይኪ? <verse eid="LUK 23:40"/><verse number="41" style="v" sid="LUK 23:41"/>ኑን ኪተቴዳ ባላን ሙራ አኪደ ደኤቶ፤ ኑዉ በስያ ሙራ ቦላን ደኤቶ፤ ሽን ሀ ብታኒ እት ኢታባነ ኦቤና” ያግ ዛሬዳ።<verse eid="LUK 23:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 23:42"/>እ የሱሳ፥ “ኔን ነ ካዉተ ዎልቃን ይያ ዎደ፥ ታና ቆፓ” ያጌዳ። <verse eid="LUK 23:42"/><verse number="43" style="v" sid="LUK 23:43"/>የሱስካ፥ “ታን ነዉ ቱሙዋ ኦዳይ፥ ሀቼ ታናና እትፐ ጋናትያን ደአናሳ” ያጌዳ።<verse eid="LUK 23:43"/></para>
  <para style="s1">የሱሳ ሀይቁዋ</para>
  <para style="r">(<ref loc="MAT 27:45-56">ማቶሳ 27:45-56</ref>፤ <ref loc="MRK 15:33-41">ማር. 15:33-41</ref>፤ <ref loc="JHN 19:28-30">ዮሃ. 19:28-30</ref>)</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44"/>ሄ ዎደ ኡሱፑን ሳተ ግድያ ኬና፤ ሄዋፐ ኡዱፑ ሳትያ ጋካናዉ፥ ቢታ ኡባ ቦላን ማ ግዴዳ። <verse eid="LUK 23:44"/><verse number="45" style="v" sid="LUK 23:45"/>አዋይካ ባረ ፖኡዋ ድጌዳ፤ ጌሻ ጎልያ ጋርዱካ ፔቲደ ላኡዋ ከሴዳ። <verse eid="LUK 23:45"/><verse number="46" style="v" sid="LUK 23:46"/>የሱስካ ዳሮ ቁ ጌዳ ቃላን ዋሲደ፥ “ታ አቦ፥ ታን ታ ሸምፑዋ ነ ኩሽያን አ እማይ!” ያግ ስሞዋፐ ጉይያን እ ሀይቄዳ።<verse eid="LUK 23:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47"/>ጼቱዋ ካፑ ሀኔዳ የዉዋ በኤዳ ዎደ፥ “ሀ ብታኒ ቱማካ ጽሎ አሳ” ያጊደ ጾሳ ጋላቴዳ። <verse eid="LUK 23:47"/><verse number="48" style="v" sid="LUK 23:48"/>ሀዋ በአናዉ እትሳ ሺቄዳ አሳይ ኡባይ ሀኔዳ የዉዋ በኢደ፥ ባረንቱ ትራ ባቂደ ስሜድኖ። <verse eid="LUK 23:48"/><verse number="49" style="v" sid="LUK 23:49"/>የሱሳ ኤርያ አሳይ ኡባይነ ጋሊላፐ ዶሚደ አ ካሌዳ ማጫዋንቱ ሀዋ ጼሊደ፥ ሃኩዋን ኤቄድኖ።<verse eid="LUK 23:49"/></para>
  <para style="s1">የሱስ ሞገቴዳ</para>
  <para style="r">(<ref loc="MAT 27:57-61">ማቶሳ 27:57-61</ref>፤ <ref loc="MRK 15:42-47">ማር. 15:42-47</ref>፤ <ref loc="JHN 19:38-42">ዮሃ. 19:38-42</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50"/>አይሁዳ ሻንጋቱዋ ግዴዳዋንቱፐ እቱ፥ ዮሴፎ ጌተትያ ሎአነ ጽሎ ብታኒ ደኤ። <verse eid="LUK 23:50"/><verse number="51" style="v" sid="LUK 23:51"/>ሀ ብታኒ ሻንጋቱዋ ማቁዋነ ኡንቱንቱ ኦሱዋን እትፐተ ኦቤና። ጾሳ ካዉተ ዩሳ ህዶታን ናጊደ ደኤ። <verse eid="LUK 23:51"/><verse number="52" style="v" sid="LUK 23:52"/>ዮሴፎካ ጵላጾሳኮ ቢደ፥ የሱሳ አሃ አካናዉ ዎሴዳ። <verse eid="LUK 23:52"/><verse number="53" style="v" sid="LUK 23:53"/>አካናዳን ጌተቶዋፐ ጉየ፥ አሃ ቦላፐ ዎደ፥ ሎኦ ሞጉዋ ማዩዋን ጻጺደ፥ ሹቻፐ ዎጨቲደ መቴዳ፥ ኦንነ ካሰ ሞገትቤና ኦላ ግዶን ዎዳ። <verse eid="LUK 23:53"/><verse number="54" style="v" sid="LUK 23:54"/>ጋላሳይካ ሳምባታ ሞካናዉ ጊግያ ጋላሳ፤ ሳምባታይካ ገላና ሀኔ።<verse eid="LUK 23:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55"/>ጋሊላፐ ዶሚደ የሱሳና እትፐ ዬዳ ማጫዋንቱ ካሊደ፥ ዱፉዋን አ አሃ ዎቲደ ዎድኖንቶ በኤድኖ። <verse eid="LUK 23:55"/><verse number="56" style="v" sid="LUK 23:56"/>ኡንቱንቱ ሀዋፐ ሶይ ስሚደ፥ ሽቱዋነ ኦክያዋ አንሀዉ ጊግሴድኖ።</para>
  <para style="p" vid="LUK 23:56">ህግያ ማራዳን ሳምባታ ጋላስ ሸምፔድኖ።<verse eid="LUK 23:56"/></para>
  <chapter eid="LUK 23"/>
  <chapter number="24" style="c" sid="LUK 24"/>
  <para style="s1">የሱስ ሀይቁዋፐ ደንዴዳ</para>
  <para style="r">(<ref loc="MAT 28:1-10">ማቶሳ 28:1-10</ref>፤ <ref loc="MRK 16:1-8">ማር. 16:1-8</ref>፤ <ref loc="JHN 20:1-10">ዮሃ. 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1"/>ሳምንታፐ ኮይሮ ጋላሳ፥ ማጫዋንቱ ጊግሴዳ ሽቱዋ ኦይቂደ ዳሪ ጉሪደ ዱፉዋኮ ቤድኖ። <verse eid="LUK 24:1"/><verse number="2" style="v" sid="LUK 24:2"/>ሹቻይካ ዱፉዋ ዶናፐ ጎንዶረትና በኤድኖ። <verse eid="LUK 24:2"/><verse number="3" style="v" sid="LUK 24:3"/>ኡንቱንቱ ዱፉዋ ጋርሳ ኦላ ገሎ ዎደ፥ ጎዳ የሱሳ አሃ ደምበይክኖ። <verse eid="LUK 24:3"/><verse number="4" style="v" sid="LUK 24:4"/>ማጫዋንቱ ስደ ደእሽን፥ ዋጭዋጭያ ማዩዋ ማዬዳ ላኡ አሳቱ፥ ቆፐናን ኡንቱንቱ ምይያን ኤቄድኖ።<verse eid="LUK 24:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 24:5"/>ማጫዋንቱካ ያሻፐ ደንዶዋን ሳኣ ጼሊደ ደእሽን፥ ላኡ አሳቱ፥ “ደኡዋን ደእያዋ፥ አ አያዉ ሀይቆዋንቱ ግዶፐ ኮዪቴ? <verse eid="LUK 24:5"/><verse number="6-7" style="v" sid="LUK 24:6-7"/>እ ደንዴዳ፤ ሀዋን ባዋ። ቃይካ ጋሊላን ደእያ ዎድያን፥ ‘አሳ ናአይ ናጋራንቻቱዋ ኩሽያን አ እመታናዋ፤ ማስቃልያ ቦላን ካቀታናዋ፥ ሄዘን ጋላስ ሀይቁዋፐ ደንዳናዋ’ ያገቶዋ ቆፕተ” ያጌድኖ።<verse eid="LUK 24:6-7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 24:8"/>ማጫዋንቱካ ሄ ዎደ ቃላ አኬኬድኖ። <verse eid="LUK 24:8"/><verse number="9" style="v" sid="LUK 24:9"/>ኡንቱንቱካ ዱፉዋፐ ስሚደ ሀ ኡባ የዉዋ ታማነ እት ኪተቶዋንቶነ ኡንቱንታ ካልያዋንቶ ኡባቶ ኦዴድኖ። <verse eid="LUK 24:9"/><verse number="10" style="v" sid="LUK 24:10"/>ሀዋ የሱስ ኪቶዋንቶ ኦዴዳዋንቱ: ማግዳላፐ ዬዳ ማይራሞ፥ ዮሃኖ፥ ያቆባ ዳዮ ማይራሞነ ኡንቱንቱና እትፐ ደእያ ሀራ ማጫዋንታ። <verse eid="LUK 24:10"/><verse number="11" style="v" sid="LUK 24:11"/>ኡንቱንቶ ማጫዋንቱ ኦድያ ቃላይ ቃጅያዋ ማላትና አማንበይክኖ።<verse eid="LUK 24:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 24:12"/>ሽን ሄ ዎደ ጰጽሮስ ደንዲደ ዱፉዋኮ ዎጼዳ። ያ ጋኪደ ሆክ ጼልያ ዎደ፥ ጋርሳን ሞጉዋ ማዮ ጻላላይ ደእያዋ በኤዳ። ሀኖ የዉዋንካ ማላለቲደ፥ ጎለ ስሜዳ።<verse eid="LUK 24:12"/></para>
  <para style="s1">ኤማሁሳ ኦግያን የሱስ ላኡ አሳቶ ቆንጬዳ</para>
  <para style="r">(<ref loc="MRK 16:12">ማር. 16:12</ref>፣ <ref loc="MRK 16:13">13</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13"/>ሄ ጋላስ የሱሳ ካልያዋንቱፐ ላኡ አሳቱ የሩሳላመፐ ላኡ ሳትያ ሃክያ ኤማሁሳ ጌተትያ ሄራ ቢደ፤ <verse eid="LUK 24:13"/><verse number="14" style="v" sid="LUK 24:14"/>እቱ እቱዋና ሀኔዳ የዉዋ ኡባ ሃሳይ ደኢኖ። <verse eid="LUK 24:14"/><verse number="15" style="v" sid="LUK 24:15"/>ኡንቱንቱ ሃሳዪድነ ዞረቲደ ደእሽን፥ የሱስ ባረ ሁጰዉ ዪደ ኡንቱንቱ ምይያ ሺቂደ ኡንቱንቱና ቢደ ደኤ። <verse eid="LUK 24:15"/><verse number="16" style="v" sid="LUK 24:16"/>ሽን ኡንቱንቱ ባረ አይፍያን ጼሊደ አ ግድያዋ ሻክ ኤራናዉ ዳንዳይበይክኖ።<verse eid="LUK 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 24:17"/>የሱስ፥ “ህንተንቱ ኦግያ ቦላን እቱ እቱዋና ሃሳይያዌ አዬ?” ያግ ኦቼዳ። ኡንቱንቱካ ዳጋማን ለቹሚደ ኤቄድኖ። <verse eid="LUK 24:17"/><verse number="18" style="v" sid="LUK 24:18"/>ኡንቱንቱፐ እቱ ቀልዮጳ ጌተትያዌ፥ “ሀ ግዱዋን የሩሳላመን ሀኖ የዉዋ ኤረናዌ ነ ጻላላይ ሀ ጋደዉ እማ?” ያግ ዛሬዳ።<verse eid="LUK 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19"/>የሱስ፥ “እ አዬ?” ያግና፥ ኡንቱንቱካ፥ “ጾሳ ስንንነ አሳ ኡባ ስንን ቃላንነ ኪታን ምኖ ናብያ ግዴዳ ናዝሬትያ የሱሳባ ሃሳዬቶ። <verse eid="LUK 24:19"/><verse number="20" style="v" sid="LUK 24:20"/>አካ ቄሳቱዋ ካፓቱነ ኑና ሞድያዋንቱ ሀይቁዋ ፕርዳዉ አ እሜድኖ፤ ማስቃልያ ቦላን ዎድኖ። <verse eid="LUK 24:20"/><verse number="21" style="v" sid="LUK 24:21"/>ኑን ካሰና፥ ‘እስራኤልያ አሳ ዎዛናዋ’ ያግ ህዶቶዌ አ፤ ሽን ሀ የዉ ሀነቲደ አደፐ ሄዙ ቃማ ግዴዳ። <verse eid="LUK 24:21"/><verse number="22" style="v" sid="LUK 24:22"/>ኑ ግዶፐ እት እት ማጫዋንቱ ኑና ማላልሴድኖ። ኡንቱንቱ ጉራን ህን ዱፉዋ ቤድኖ፥ <verse eid="LUK 24:22"/><verse number="23" style="v" sid="LUK 24:23"/>ሽን የሱሳ አሃ ኡንቱንቱ ዮ ዎደ ሽረት ስሚደ፥ እ ደንዴዳ፤ ያግያዋ ኪታንቻቱ ኦድሽን በኤዶ ያግ ኦዴድኖ። <verse eid="LUK 24:23"/><verse number="24" style="v" sid="LUK 24:24"/>ኑ ግዶፐካ እት እት አሳይ ዱፉዋ ቢደ ኡንቱንቱ ጎዋዳን ሀንና በኤድኖ፤ ሽን የሱሳ አሃ ደምበይክኖ” ያጌድኖ።<verse eid="LUK 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25"/>የሱስ ኡንቱንቶ፥ “ህንተኖ፥ አኬከና አሳቶ፥ ህንተንቱ ዎዛናን ናባቱ ኦዶዋ ኡባ ኤለ አማነናዋንቶ፤ <verse eid="LUK 24:25"/><verse number="26" style="v" sid="LUK 24:26"/>ክርስቶስ ሀ መቱዋ አካናዉነ ባረ ቦንቹዋኮ ገላናዉ በሰኔ?” ያጌዳ። <verse eid="LUK 24:26"/><verse number="27" style="v" sid="LUK 24:27"/>ሄዋፐ ስሚደ የሱስ ሙሴ ማጻፋቱዋፐነ ናባቱ ጻፌዳ ማጻፋቱዋፐ ዶሚደ፥ ጾሳ ማጻፋቱዋ ኡባን ጻፈቴዳ ባረባ ኡንቱንቶ ብሊደ ኦዴዳ።<verse eid="LUK 24:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28"/>ኡንቱንቱ ብደእያ ሄራ ማቴዳ ዎደ፥ የሱስ ሀራሳ ብያዋ ማላቴዳ። <verse eid="LUK 24:28"/><verse number="29" style="v" sid="LUK 24:29"/>ሄ ዎደ ኡንቱንቱ አ፥ “ጋላሳይ ቃሚደ ደእያ ድራዉ፥ ኦማርሳይ ማቴዳ፤ ኑናና እትፐ አቃ!” ያግ ምንስ ዎሴድኖ። ሀዋ ድራዉ፥ እካ ኡንቱንቱና እትፐ አቃናዉ ገሌዳ። <verse eid="LUK 24:29"/><verse number="30" style="v" sid="LUK 24:30"/>ኡንቱንቱ እትፐ ጋይታን ኡቴዳ ዎደ፥ ዳቡዋ ደንደ አንጄዳ፤ መንደ ኡንቱንቶ እሜዳ። <verse eid="LUK 24:30"/><verse number="31" style="v" sid="LUK 24:31"/>ኡንቱንቱ አይፊካ አ አኬካና ማላ ዶየትና፥ የሱሳ ግድያዋ ኤሬድኖ። እካ ኡንቱንቱ ስንፐ ጌሜዳ። <verse eid="LUK 24:31"/><verse number="32" style="v" sid="LUK 24:32"/>ኡንቱንቱካ እቱ እቱዋ፥ “ቃአን እትፐ ኑ ደእሽን፥ ኑና እ ሃሳይስያ ዎድያንነ ጾሳ ማጻፋቱዋካ ኑዉ ቆንጭሲደ እ ኦድያ ዎድያን፥ ኑ ዎዛና ግዶን ታማዳን ሴሌ ግደኔ?” ጌተቴድኖ።<verse eid="LUK 24:32"/></para>
  <para style="p">
    <verse number="33-34" style="v" sid="LUK 24:33-34"/>ሄ ዎድያንካ ደንዲደ የሩሳላመ ስሜድኖ። የሱስ ኪቶ ታማነ እታቶነ ኡንቱንቱና እትፐ ደእያዋንቶ፥ “ጎዳይ ቱሙዋካ ደንዴዳ፥ ስሞናዉካ ቤቴዳ” ያጊደ ሄዋን እትፐ ሺቅ ኡቴዳዋንታ ደሜድኖ።<verse eid="LUK 24:33-34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 24:35"/>ሄ ላአቱ፥ ቃአን ሀኔዳዋነ የሱስ ዳቡዋ መንያ ዎደ ዎት አ ኤሬድኖንቶ ኡንቱንቶ ኦዴድኖ።<verse eid="LUK 24:35"/></para>
  <para style="s1">የሱስ ባረና ካልያዋንቶ ቤቴዳ</para>
  <para style="r">(<ref loc="MAT 28:16-20">ማቶሳ 28:16-20</ref>፤ <ref loc="MRK 16:14-18">ማር. 16:14-18</ref>፤ <ref loc="JHN 20:19-23">ዮሃ. 20:19-23</ref>፤ <ref loc="ACT 1:6-8">ኪታ 1:6-8</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36"/>ሀዋ ኡንቱንቱ ሃሳይ ደእሽን፥ የሱስ ኡንቱንቱ ግዶን ኤቂደ፥ “ሳሮተይ ህንተዉ ግዶ” ያጌዳ። <verse eid="LUK 24:36"/><verse number="37" style="v" sid="LUK 24:37"/>ኡንቱንቶ ሞይትልያ በኦዋ ማላትና ዳጋሚደ፥ ያሻን ኩሜድኖ። <verse eid="LUK 24:37"/><verse number="38" style="v" sid="LUK 24:38"/>እካ ኡንቱንታ፥ “አያዉ ዳጋሚቴ? አያ ድራዉ ህንተንቱ ዎዛናይ ስ? <verse eid="LUK 24:38"/><verse number="39" style="v" sid="LUK 24:39"/>ታን የሱሳ ግድያዋ ኤራናዉ፥ አነ ታ ኩሽያነ ታ ገድያ በእተ፤ ታናን ህንተንቱ በእያዋዳን፥ ሞይትለዉ አሹነ መቀይ ባዋ። አነ ታና ህንተንቱ ኩሽያን ኦይቂ በእተ” ያጌዳ።<verse eid="LUK 24:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 24:40"/>ሀዋ ያግ ስሚደ፥ ባረ ኩሽያነ ባረ ገድያ በሴዳ። <verse eid="LUK 24:40"/><verse number="41" style="v" sid="LUK 24:41"/>ኡንቱንቱካ ናሸቻፐ ደንዶዋን፥ አማነናን ማላለት ደእሽን እ፥ “ሀዋን ሜተትያዌ ህንተንቶ ደኢ?” ያግ ኡንቱንታ ኦቼዳ። <verse eid="LUK 24:41"/><verse number="42" style="v" sid="LUK 24:42"/>ኡንቱንቱካ፥ ጺጸቴዳ ሞልያፐ ላፋ ፑሩዋ አዉ እሜድኖ። <verse eid="LUK 24:42"/><verse number="43" style="v" sid="LUK 24:43"/>እካ አኪደ ኡንቱንቱ ስንን ሜዳ።<verse eid="LUK 24:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44"/>እካ፥ “ታን ህንተንቱና እትፐ ደኣደ፥ ‘ሙሴ ማጻፋን፥ ናባቱዋ ማጻፋንነ ቃላን ጻፈቶ ማዝሙረቱዋን ታ ድራዉ ጻፈቴዳ ኡባይ ፖለታናዉ በሴ’ ያጋደ ህንተንቶ ኦዴዳ የዉ ሀዋ” ያጌዳ።<verse eid="LUK 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45"/>ሄ ዎድያንካ ጾሳ ማጻፋቱዋን ጌተቶዋ አኬካና ማላ፥ ኡንቱንቱ ዎዛና ዶዬዳ። <verse eid="LUK 24:45"/><verse number="46" style="v" sid="LUK 24:46"/>ኡንቱንቶ፥ “ ‘ክርስቶሳ መቱ ጋካናዋ፤ ሄዘንያ ጋላስ ሀይቁዋፐ ደንዳናዋ። <verse eid="LUK 24:46"/><verse number="47" style="v" sid="LUK 24:47"/>አ አ ሱንን ናጋራ ፓጸይነ ማሮታ ደሙሳይ የሩሳላመፐ ዶሚደ አሳዉ ኡባዉ ኦደታናዋ’ ያገቲደ ጻፈቴዳ።<verse eid="LUK 24:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 24:48"/>“ህንተንቱካ ሀዎ ማርካቱዋ። <verse eid="LUK 24:48"/><verse number="49" style="v" sid="LUK 24:49"/>ታ ህንተንቶ፥ ታ አቡ ቃላ ገሌዳ ህዶታ የዳና፤ ሄዌ ጋካናዉነ ህንተንቶ ዎልቃይ ሳሉዋፐ እመታና ጋካናዉ፥ የሩሳላመ ካታማን ናግሽተ” ያጌዳ።<verse eid="LUK 24:49"/></para>
  <para style="s1">የሱስ ሳሉዋ ስሚደ ቤዳ</para>
  <para style="r">(<ref loc="MRK 16:19">ማር. 16:19</ref>፣ <ref loc="MRK 16:20">20</ref>፤ <ref loc="ACT 1:9-11">ኪታ 1:9-11</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50"/>ሀዋፐ ጉይያን፥ ቢታንያ ጌተትያ ካታማ ጋካናዉ፥ ኡንቱንታ አፌዳ፤ ባረ ኩሽያ ምጪደ ኡንቱንታ አንጄዳ። <verse eid="LUK 24:50"/><verse number="51" style="v" sid="LUK 24:51"/>ኡንቱንቱፐ ሻከቲደ፥ ሳሉዋ ቤዳ። <verse eid="LUK 24:51"/><verse number="52" style="v" sid="LUK 24:52"/>ኡንቱንቱ አዉ ጎይኒደ፥ ዳሮ ናሸቻን የሩሳላመ ስሜድኖ። <verse eid="LUK 24:52"/><verse number="53" style="v" sid="LUK 24:53"/>ቃይ ፓጨናን ጾሳ ጋላቲደ፥ ጌሻ ጎልያን ደኤድኖ።<verse eid="LUK 24:53"/></para>
  <chapter eid="LUK 24"/>
</usx>
