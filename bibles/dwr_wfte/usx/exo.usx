<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EXO" style="id">- Dawuro Full Bible Ethiopic Version</book>
  <para style="h">ከሳ</para>
  <para style="toc1">ከሳ ማጻፋ</para>
  <para style="toc2">ከሳ</para>
  <para style="toc3">ከሳ</para>
  <para style="mt1">ከሳ ማጻፋ</para>
  <para style="imt">ገሉዋ</para>
  <para style="ip">ከሳ ማጻፋይ “ከሳ” ጌተቶዌ እስራኤልያ አሳይ ግብጼ ጋድያ አይለተፐ ከሴዳ ድራሳ።</para>
  <para style="ip">ሀ ማጻፋዉ ኦይዱ ሁጰ ሻካቱ ደኢኖ።</para>
  <para style="ili">1. እብራዌቱ አይለተፐ ከሴዳዋነ ሲና ደርያ ኡንቱንቱ ቤዳ ቡሳባ ኦዴ።</para>
  <para style="ili">2. ጾሳይ ባረ አሳና ቃላ ጫቁዋ ገሌዳዋ፥ ኢታነ ኬካ ሻክ ኤርስያ ህግያ፥ አሳይ ካላናዉ በስያ ህጋቱዋነ አማኑዋ ህግያ እ ኡንቱንቶ እሜዳዋ ኦዴ።</para>
  <para style="ili">3. እስራኤልያ አሳዉ፥ ቄሳቱዋ ኦሱዋስነ ጾሳዉ ጎይንያ ጎይናዉ እመቴዳ ህገቱዋባ ኦዴ።</para>
  <para style="ili">4. ጾሳ ዱንካንያ ቶሳ ዎጋነ ጎይኑዋ ማራባ ኦዴ።</para>
  <para style="ip">ኡባባፐ አደ ሀ ማጻፋይ ጾሳይ አይለተን ደእያ ባረ አሳ ከስ ስሚደ፥ ኡንቱንቱ ዎደናዉ ህዶታይ ደእያ አሳ ግዳናዳን፥ እ ኡንቱንታ ዎት ኦደንቶ ኦዴ።</para>
  <para style="ip">ሀ ማጻፋን ዳርያ ባጋ ታርክያ ጎዳ ግዲደ ሺቄዳ አሳይ ባረ አሳ ግብጼፐ ከሳና ማላ፥ ጾሳይ ዶሬዳዌ ሙሳ። ማጻፋ ግዶን ዳሮፐ ኤረቴዳ ሸምፑ ታሙ አዛዛቱ ጻፈቴዳ ላታማን ሸምፑዋ።</para>
  <para style="iot">ሸምፓቱዋ ኡባቶ እመቴዳ ቃን ቆፋቱዋ</para>
  <para style="io1">እስራኤልያ አሳይ ግብጼፐ ከሱሳ <char style="ior"><ref loc="EXO 1:1-15:21">1:1—15:21</ref></char></para>
  <para style="io2">ሀ. ግብጼን አይለተ <char style="ior"><ref loc="EXO 1:1-22">1:1-22</ref></char></para>
  <para style="io2">ለ. ሙሴ የለቶዋነ ድቻ <char style="ior"><ref loc="EXO 2:1-4:31">2:1—4:31</ref></char></para>
  <para style="io2">ሐ. ሙሴነ አሮነ ፓሮና ስንን <char style="ior"><ref loc="EXO 5:1-11:10">5:1—11:10</ref></char></para>
  <para style="io2">መ. ፓስጋነ ግብጼፐ ከሱሳ <char style="ior"><ref loc="EXO 12:1-15:21">12:1—15:21</ref></char></para>
  <para style="io1">ዞኦ አባፐ ሲና ደርያ ጋካናዉ <char style="ior"><ref loc="EXO 15:22-18:27">15:22—18:27</ref></char></para>
  <para style="io1">ህግያነ ቃላ ጫቁዋ <char style="ior"><ref loc="EXO 19:1-24:18">19:1—24:18</ref></char></para>
  <para style="io1">ጌሻ ዱንካንያነ ጎይና ዎጋ <char style="ior"><ref loc="EXO 25:1-40:38">25:1—40:38</ref></char></para>
  <chapter number="1" style="c" sid="EXO 1"/>
  <para style="ms">እስራኤልያ አሳይ ግብጼፐ ከሱሳ</para>
  <para style="mr">(<ref loc="EXO 1:1-15:21">1:1—15:21</ref>)</para>
  <para style="s1">ግብጼን አይለተ</para>
  <para style="r">(<ref loc="EXO 1:1-22">1:1-22</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 1:1"/>ያቆባና ግብጼ ቤዳ እስራኤልያ አቱማ ናና ሱንይ ሀዋፐ ካሊደ ጻፈቴዳ፤ ኡንቱንቱ ኡባይካ ባረንቱ ሶይ አሳ አኪደ ቤድኖ።<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="GEN 46:8-27">ዶመ 46:8-27</ref></char></note> <verse eid="EXO 1:1"/><verse number="2" style="v" sid="EXO 1:2"/>ሄዋንቱካ: ሮቤላ፥ ስሞና፥ ሌዋ፥ ይሁዳ፥ <verse eid="EXO 1:2"/><verse number="3" style="v" sid="EXO 1:3"/>ይሳኮራ፥ ዛብሎና፥ ቢንያማ፥ <verse eid="EXO 1:3"/><verse number="4" style="v" sid="EXO 1:4"/>ዳና፥ ንፍታሌማ፥ ጋዳነ አሴራ። <verse eid="EXO 1:4"/><verse number="5" style="v" sid="EXO 1:5"/>ያቆባ ዘረቱ ኡባይ ላፑን ታማ፤ ዮሴፎ ካሰካ ግብጼ ብ ኡቴዳ። <verse eid="EXO 1:5"/><verse number="6" style="v" sid="EXO 1:6"/>ዮሴፎ፥ አ እሻቱነ ሄ የለታ ኡባይ ሀይቄዳ፤ <verse eid="EXO 1:6"/><verse number="7" style="v" sid="EXO 1:7"/>ሽን እስራኤልያ ዘረይ አይፌድኖነ ሎይ ዳሬድኖ፤ ሄ ቢታ ኩማና ጋካናዉ ኡንቱንቱ ሎይ ጮራቴድኖ።<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="ACT 7:17">ኪታ 7:17</ref></char></note><verse eid="EXO 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 1:8"/>ሄዋፐ ጉይያን፥ ዮሴፎ ኤረና ኦራ ካቲ ግብጼ ጋድያን ደንዴዳ።<note caller="-" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="ACT 7:18">ኪታ 7:18</ref></char></note> <verse eid="EXO 1:8"/><verse number="9" style="v" sid="EXO 1:9"/>እ ባረ አሳ፥ “በእተ፤ ሀ እስራኤላቱ ኑፐ ሎይ ጮራቴድኖነ ዎልቃሜድኖ። <verse eid="EXO 1:9"/><verse number="10" style="v" sid="EXO 1:10"/>ሃ ዪተ፥ አነ ኑን ኡንቱንታ ሂላን ኦይቆይተ፤ ሄዌ ዮፐ ኡንቱንቱ ካሰዋፐ ያ ዳራና። ኦን ኤር ኦላይ ደንዶፐ፥ ኡንቱንቱ ኑ ሞርከቱዋና ዳንደ፥ ኑና ኦላናነ ጋድያ የጊደ ከስ አኪደ ባናዋንታ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="ACT 7:19">ኪታ 7:19</ref></char></note><verse eid="EXO 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 1:11"/>ሄዋ ድራዉ፥ ዴጾ ኪታን ኡንቱንታ ቱጋያና ማላ፥ ኡንቱንቱ ቦላ መቀ ባይና ካፖቱዋ ሱንድኖ። ኡንቱንቱ ካትያዉ ፒቶማነ ራምሳ ጌተትያ ሚሻ ምንጅያ ካታማቱዋ ኬጼድኖ። <verse eid="EXO 1:11"/><verse number="12" style="v" sid="EXO 1:12"/>ሽን ግብጼቱ ኡንቱንታ ኡንኡዋ ዳርያ ዎደ፥ ኡንቱንቱ ጮራት የለቴድኖነ ቢታ ጋኬድኖ። ሄዋ ድራዉ፥ ግብጼቱ እስራኤላቶ ያዬድኖ፤ <verse eid="EXO 1:12"/><verse number="13" style="v" sid="EXO 1:13"/>ቃረታይ ባይና ሀኖታን አይለተን ኪትሴድኖ። <verse eid="EXO 1:13"/><verse number="14" style="v" sid="EXO 1:14"/>ቃረታይ ባይና ዎልቃማ ኪታን፥ ስምንቱዋንነ ጹብያ መዋን፥ ቃይ ሾይቃን ኦያ ኡባ ቆሞ ኪታን፥ ኡንቱንቱ ደኡዋ ጫምሴድኖ።<verse eid="EXO 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 1:15"/>ግብጼ ካቲ እብራዌ ማጫዋንታ ማርስያ ጽፓሮነ ፑሆ ጌተትያ ላኡ ማጫዋንታ ሀዋዳን ያጌዳ፤ <verse eid="EXO 1:15"/><verse number="16" style="v" sid="EXO 1:16"/>“እብራዌ ማጫ አሳቱ የልያ ዎደ ህንተንቱ ማርሲደ፥ የልሶዌ አቱማ ናኣ ግዶፐ፥ ዎተ፤ ሽን ማጫ ናቶ ግዶፐ ዎፕተ” ያጌዳ። <verse eid="EXO 1:16"/><verse number="17" style="v" sid="EXO 1:17"/>ሽን ማርስያዋንቱ ጾሳዉ ያዪደ፥ ግብጼ ካቲ ኡንቱንታ አዛዜዳዋዳን ኦበይክኖ። ኡንቱንቱ አቱማ ናና ሸምፑዋና አሼድኖ። <verse eid="EXO 1:17"/><verse number="18" style="v" sid="EXO 1:18"/>ሄዋፐ ጉይያን ግብጼ ካቲ ሄ ማርስያዋንታ ጼሲደ፥ “ህንተንቱ አያዉ ሀዋዳን ኦቴ? አቱማ ናና አያዉ ሸምፑዋና አጊቴ?” ያጊደ ኡንቱንታ ኦቼዳ። <verse eid="EXO 1:18"/><verse number="19" style="v" sid="EXO 1:19"/>ማርስያዋንቱ ዛሪደ፥ “እብራዌ ማጫ አሳቱ ግብጼ ማጫዋንቱ ማላ ግድክኖ፤ ኡንቱንቱ ምና ግድያ ድራዉ፥ ማርስያዋንቱ ጋካናፐ ካሰቲደ የል ድጊኖ” ያጌድኖ። <verse eid="EXO 1:19"/><verse number="20" style="v" sid="EXO 1:20"/>ሄዋ ድራዉ፥ ጾሳይ ማርስያዋንቶ ኬኬዳ። አሳ ፓይዱካ ጉጅ ጉጅ ቢደ፥ ካሰዋፐ ያ ጮራቴዳ። <verse eid="EXO 1:20"/><verse number="21" style="v" sid="EXO 1:21"/>ቃይ ማርስያዋንቱ ጾሳዉ ያዬዳ ድራዉ፥ ጾሳይ ኡንቱንቶ ሎኦባ ኦዳ። እቶ እቶካ ሶ አሳ እሜዳ።<verse eid="EXO 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 1:22"/>ሄዋፐ ጉይያን ካቲ ባረ አሳ ኡባ፥ “እብራዋቱዋፐ የለትያ አቱማ ናና ኡባ ናይለ ሻፋ ሃን ኦልተ፤ ሽን ማጫ ናናይ የለቶፐ፥ ሸምፑዋና አግ ባሽተ” ያጊደ አዛዜዳ።<note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="ACT 7:19">ኪታ 7:19</ref></char></note><verse eid="EXO 1:22"/></para>
  <chapter eid="EXO 1"/>
  <chapter number="2" style="c" sid="EXO 2"/>
  <para style="s1">ሙሴ የለታነ ድቻ</para>
  <para style="r">(<ref loc="EXO 2:1-4:31">2:1—4:31</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 2:1"/>ሄ ዎደ እት ሌዊያ ቆሞ ግዴዳ ብታኒ ሌዋዌ ማጫውኖ አኬዳ፤ <verse eid="EXO 2:1"/><verse number="2" style="v" sid="EXO 2:2"/>እዛ ሻሃራደ አቱማ ናኣ የላዱ። ናአይ ማላ ሎኦ ናኣ ግድያዋ እዛ በኣደ፥ ሄዙ አግና ቆሳዱ። <verse eid="EXO 2:2"/><verse number="3" style="v" sid="EXO 2:3"/>ሽን እዛ ሄዋፐ ዳሩዋ ቆሳናዉ ዳንዳየናዋ ኤራደ፥ ጫርያፐ ቁንኣ አዉ ዳዳዱ፤ ያታደ ሃይ ገለና ማላ ሽድያን ማራጋደ፥ ናኣ አ ግዶን ዎዱ፤ ናይለ ሻፋ ጌተትያ ሃ ዶናን ጫርያ ግዶን ዎዱ። <verse eid="EXO 2:3"/><verse number="4" style="v" sid="EXO 2:4"/>አ ምቻታ እ ሀንያባ በአናዉ ሃኩዋን ኤቃዱ።<verse eid="EXO 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 2:5"/>ግብጼ ካትያ ናታ ቦላ ሜጨታናዉ ናይለ ግያ ሻፋ ዎዱ፤ እዝ ማጫ ቆማቱ ሃ ዶናን ያነ ሃነ ሀመቲኖ፤ እዛ ቁንኣ ጫርያ ግዶን በኣደ፥ ባደ አካ ያና ማላ ባረ ቆማቶ ኪታዱ፤ <verse eid="EXO 2:5"/><verse number="6" style="v" sid="EXO 2:6"/>ቁንኣ ፖካደ፥ በእተ ሀዋን ቄር ናአይ ዬክ ደኤ፤ እዛ አዉ ቃረታደ፤ “ሀዌ እብራዌቱ ቄር ናናቱዋፐ እቱዋ” ያጋዱ።<verse eid="EXO 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 2:7"/>ሄ ዎደ አ ምቻታ ካትያ ናቶ፥ “ነዉ ሀ ናኣ ንናዉ እብራዌ ማጫ አሳፐ እትኖ ጼሳናዉ ቦ?” ያጋደ ኦቻዱ።<verse eid="EXO 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 2:8"/>እዛ፥ “ኤ፥ ባ” ያጋዱ። ናታ ባደ፥ ሄ ናኣ ዳዮ አሃዱ። <verse eid="EXO 2:8"/><verse number="9" style="v" sid="EXO 2:9"/>ካትያ ናታ ሄ ምሽራቶ፥ “ሀ ናኣ አፋደ፥ ታዉ ንሻ፤ ታን ነዉ ድርጉዋ ጭጋና” ያጋዱ። ምሽራታ ናኣ አፋደ፥ ንዱ። <verse eid="EXO 2:9"/><verse number="10" style="v" sid="EXO 2:10"/>ናአይ ድጭና፥ ካትያ ናትኮ አ አሃዱ፤ እ እዝዉ ናኣ ግዴዳ፤ “ታን ሃፐ አ ከሳድ” ጋደ፥ ሙሳ ጋ ሱንዱ።<note caller="-" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="ACT 7:21">ኪታ 7:21</ref></char></note><verse eid="EXO 2:10"/></para>
  <para style="s1">ሙሴ ሚድያማ ቢታ ባቃቴዳ</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 2:11"/>ሙሴ ድጭ ዎጋ ግዲደ፥ እት ጋላስ ባረ አሳይ ደእያ ሳኣ ቢደ፤ ኡንቱንቱ ዴጾ ኪታ ኪተትሽን ጼሌዳ። ግብጼ ቢታ አሳ እቱ፥ እሻቱዋ ግዴዳ እብራዋቱዋፐ እቱዋ ዋሽን በኤዳ።<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="HEB 11:24">እብራ. 11:24</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">2:11-14 </char><char style="xt" closed="false"><ref loc="ACT 7:23-28">ኪታ 7:23-28</ref></char></note> <verse eid="EXO 2:11"/><verse number="12" style="v" sid="EXO 2:12"/>እ ያ ሃ ጼልና፥ ኦንነ ባይናዋ በኢደ፥ ሄ ግብጼ ብታንያ፤ ዎደ ሻፍያ ግዶን ቆሴዳ። <verse eid="EXO 2:12"/><verse number="13" style="v" sid="EXO 2:13"/>ዎንተ ጋላስ ከሲደ፥ በእተ! ሀቼ ቃይ ላኡ እብራዌቱ ዋቲኖ። ናቄዳዋ እ፥ “ኔን ነ እሻ ግዴዳ እብራውያ አያዉ ደቻይ?” ያጊደ ኦቼዳ። <verse eid="EXO 2:13"/><verse number="14" style="v" sid="EXO 2:14"/>ሄ ብታኒ፥ “ኔና ኑ ቦላ ሞድያዋነ ዳና ኦ ሱንዳዌ ኦኔ? ኔን ሄ ግብጼ ብታንያ ዎዳዋዳን፥ ታናካ ዎናዉ ቆፓይ?” ያጌዳ። ሙሴ ሄ ዎደ፥ “ታን ኦዳባይ ኤረት ድጌዳ” ያግ ቆፒደ ያዬዳ።<verse eid="EXO 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 2:15"/>ካቲካ ሀዋ ስሴዳ ዎደ፥ ሙሳ ዎናዉ ኮዬዳ፤ ሽን ሙሴ ካትያፐ ባቃቲደ፥ ሚድያማ ጋድያን ደአናዉ ቢደ ሃ ኦላ ዶናን ኡቴዳ።<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="ACT 7:29">ኪታ 7:29</ref>፤ <ref loc="HEB 11:27">እብራ. 11:27</ref></char></note> <verse eid="EXO 2:15"/><verse number="16" style="v" sid="EXO 2:16"/>ሄ ዎደ ሚድያማ ቄሳቱዋፐ እቶ ላፑን ማጫ ናናይ ደኢኖ፤ ኡንቱንቱ ባረንቱ አዉዋ ዶርሳቱዋ ሃ ኡሻናዉ ዎንግርያን ሃ ዱቂ ኩንናዉ ዬድኖ። <verse eid="EXO 2:16"/><verse number="17" style="v" sid="EXO 2:17"/>ሄንንቻቱ ዪደ ማጫ ናና የደርሴድኖ፤ ሽን ሙሴ ደንድ ኤቂደ፥ ኡንቱንታ አሼዳነ ኡንቱንቱ ዶርሳቱዋ ሃ ኡሼዳ። <verse eid="EXO 2:17"/><verse number="18" style="v" sid="EXO 2:18"/>ኡንቱንቱ ባረንቱ አዉዋ ዮቶረኮ ዬዳ ዎደ፥ “ሀቼ ዋን ኤለካ ዬድቴ?” ያጊደ ኦቼዳ።<note caller="+" style="f"><char style="fr" closed="false">2:18</char><char style="ft" closed="false">ዮቶረ ሙሴ ቦሉዋ፤ </char><char style="ft" closed="false">አዉ ሀራ ሱንይ ራኡኤላ።</char></note> <verse eid="EXO 2:18"/><verse number="19" style="v" sid="EXO 2:19"/>ኡንቱንቱ ዛሪደ፥ “ግብጼ ጋደ አሳ እቱ ኑና ሄንንቻቱዋፐ አሼዳ፤ እ ኑዉ ሃካ ዱቂደ ዶርሳ ዉድያ ኡሼዳ” ያጌድኖ። <verse eid="EXO 2:19"/><verse number="20" style="v" sid="EXO 2:20"/>እ ባረ ማጫ ናና፥ “ያትና እ ሀቃን ደኢ? ህንተንቱ ሄ ብታንያ አያዉ አግ ባሼድቴ? አነ አ ጼሲደ፥ ምያባ ሾቢተ” ያጌዳ። <verse eid="EXO 2:20"/><verse number="21" style="v" sid="EXO 2:21"/>ሙሴ ሄ ብታንያና ያን ደአናዉ ማየቴዳ፤ ብታኒካ ባረ ናቶ ጽፓሮ ሙሴዉ ማቻቶ ኦደ እሜዳ። <verse eid="EXO 2:21"/><verse number="22" style="v" sid="EXO 2:22"/>ጽፓራ አቱማ ናኣ የልና፥ ሙሴ አ፥ “ታን አሳ ጋድያን በተ ግዳድ” ያጊደ፥ ገርሾማ ግ ሱንዳ።<verse eid="EXO 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 2:23"/>ጮራ ላይፐ ጉይያን፥ ግብጼ ካቲ ሀይቄዳ። እስራኤላቱ ባረንቱ አይለተፐ ኡንኤቲደ ዋሴድኖ፤ ኡንቱንቱ ዋሴዳ ዋሱ ፑደ ጾሳኮ ጋኬዳ። <verse eid="EXO 2:23"/><verse number="24" style="v" sid="EXO 2:24"/>ጾሳይ ኡንቱንቱ ኡንኣ ዋሱዋ ስሲደ፥ እ አብራሃመና፥ ይሳቃናነ ያቆባና ጫቄዳ ጫቁዋ ሀሳዬዳ።<note caller="-" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="GEN 15:13-14">ዶመ 15:13-14</ref></char></note> <verse eid="EXO 2:24"/><verse number="25" style="v" sid="EXO 2:25"/>ሄዋ ድራዉ፥ ጾሳይ እስራኤላቱዋ ጼሊደ ኡንቱንቱ ድራዉ ቆፔዳ።<note caller="+" style="f"><char style="fr" closed="false">2:25 </char><char style="fq" closed="false">ኡንቱንቱ ድራዉ ቆፔዳ፦ </char><char style="ft" closed="false">እት በን ብለይ ኡንቱንቶ ባረና ቆንጭሴዳ ያጌ።</char></note><verse eid="EXO 2:25"/></para>
  <chapter eid="EXO 2"/>
  <chapter number="3" style="c" sid="EXO 3"/>
  <para style="s1">ጾሳይ ሙሳ ጼሴዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 3:1"/>እት ዎደ ሙሴ ሚድያማ ጋደ ቄስያ፥ ባረ ቦሉዋ ዮቶራ ዶርሳቱዋ ሄሜ፤ እ ሄ ዉድያ ላግ አኪደ መላ ቢታ ጋጻ ጋካናዉ አፊደ ጾሳ ደርያ ሲና ጋኬዳ። <verse eid="EXO 3:1"/><verse number="2" style="v" sid="EXO 3:2"/>ሄ ሳኣን መና ጎዳ ኪታንቻይ አጫን፥ ኤጽያ ታማ ላጩዋ ግዶን አዉ ቤቴዳ፤ አጫይ ታማን ጹገትንቶካ፥ ታማይ አጫ ሜናዋ ሙሴ በኤዳ።<note caller="-" style="x"><char style="xo" closed="false">3:2-10 </char><char style="xt" closed="false"><ref loc="ACT 7:30-34">ኪታ 7:30-34</ref></char></note> <verse eid="EXO 3:2"/><verse number="3" style="v" sid="EXO 3:3"/>ሄዋ ድራዉ፥ ሙሴ፥ “ታን ያ ባደ፥ አጫይ አያዉ ታማን ሜተትቤነንቶ ሀ ኦራባ አነ በአና” ያጊደ ቆፔዳ።<verse eid="EXO 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 3:4"/>እ በአናዉ ያ ቤዳዋ መና ጎዳይ በኢደ አጫ ግዶፐ ጾሳይ አ፥ “ሙሴ! ሙሴ!” ያጊደ ጼሴዳ።</para>
  <para style="p" vid="EXO 3:4">ሙሴ፥ “አቤ” ጊደ ኮዬዳ።<verse eid="EXO 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 3:5"/>ጾሳይ አ፥ “ሃ ሺቆፓ። ኔን ኤቄዳ ቢታይ ጌሻ ግድያ ድራዉ፥ ነ ገድያን ደእያ ጫማ ከሳ” ያጌዳ። <verse eid="EXO 3:5"/><verse number="6" style="v" sid="EXO 3:6"/>ቃይካ ጾሳይ አ፥ “ታን ነ አዉዋ ጾሳ፥ አብራሃሞ ጾሳ፥ ይሳቃ ጾሳ፥ ያቆባ ጾሳ” ያጌዳ። ሙሴ ጾሳ ጼላናዉ ያዬዳ ድራዉ፥ ባረ ዴሙዋ ገንዳ።<verse eid="EXO 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 3:7"/>መና ጎዳይ ቃይካ ሀዋዳን ያጌዳ፤ “ታን ግብጼ ጋድያን ታ አሳይ ቱጋትያ ቱጋ ጌሻ በኣደ፥ ኡንቱንቱ ባረንቱ ካፖቱዋፐ ዋስያ ዋሱዋ ስሳደ፥ ታን ኡንቱንቱ መቱዋ ኡባ ሻድ። <verse eid="EXO 3:7"/><verse number="8" style="v" sid="EXO 3:8"/>ሄዋ ድራዉ፥ ታን ኡንቱንታ ግብጼ ጋድያ አሳቱዋ ኩሽያፐ አሻናዉነ ሄ ጋድያፐ ኡንቱንታ ከሳደ፥ አኮነ ሎኦ ጋድያ አሀናዉ ዎድ። ሄ ጋዲ ማይነ ኤሳይ ጎግያ ቢታ፤ ሄ ጋድያን ካናነቱ፥ ሂተቱ፥ አሞራዋናቱ፥ ፓርዛዋናቱ፥ ሂዌቱነ ያቡሳዋናቱ ሀእ ደኢኖ። <verse eid="EXO 3:8"/><verse number="9" style="v" sid="EXO 3:9"/>ሀእ እስራኤለቱዋ ዋሱ ታኮ ጋኬዳ፤ ግብጼ ጋድያ አሳቱ ኡንቱንታ ናቂያ ናቁዋ ታን በኣድ፤ <verse eid="EXO 3:9"/><verse number="10" style="v" sid="EXO 3:10"/>ሄዋ ድራዉ፥ ሀእ ባ፤ ታ አሳቱዋ፥ እስራኤላቱዋ ግብጼፐ ከሳና ማላ፥ ግብጼ ካትያኮ ታን ኔና ኪታይ” ያጌዳ።<verse eid="EXO 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 3:11"/>ሽን ሙሴ ጾሳ፥ “ካትያኮ ባናዉነ እስራኤላቱዋ ግብጼፐ ከሳናዉ ታን ኦኔ?” ያጌዳ።<verse eid="EXO 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 3:12"/>ጾሳይ አ፥ “ታን ኔናና ግዳና፤ ቃይ ታን ኔና ኪቴዳዎ ማላይ ሀዋ: ኔን ሄ አሳ ግብጼፐ ከሴዳ ዎደ፥ ሀ ደርያ ቦላን ህንተንቱ ጾሳዉ ጎይናንታ” ያጌዳ።<verse eid="EXO 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 3:13"/>ሙሴ ጾሳ፥ “ግዶ ሽን፥ ታን እስራኤለቱዋኮ ባደ፥ ኡንቱንታ፥ ‘ህንተ አዎቱዋ ጾሳይ ታና ህንተንቱኮ ኪቴዳ’ ያግና፥ ኡንቱንቱ ታና፥ ‘አ ሱንይ ኦኔ?’ ያጊደ ኦቾፐ፥ ሄ ዎደ ታን ኡንቱንቶ ዋጋ ኦዶ?” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="EXO 6:2-3">ከሳ 6:2-3</ref></char></note><verse eid="EXO 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 3:14"/>ጾሳይ ሙሳ፥ “ታን ታና፤ ኔን እስራኤለቶ፥ ‘ታና ጌተትያዌ ህንተንቱኮ ታና ኪቴዳ’ ያጋ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="REV 1:4">ሳፃ 1:4</ref>፣ <ref loc="REV 1:8">8</ref></char></note><verse eid="EXO 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 3:15"/>ጾሳይ ሙሳ ቃይ፥ “ኔን እስራኤላቶ፥ ‘መና ጎዳይ ህንተንቱ አዎቱዋ ጾሳይ፥ አብራሃሞ ጾሳይ፥ ይሳቃ ጾሳይ፥ ያቆባ ጾሳይ፥ እ ታና ህንተንቱኮ ኪቴዳ’ ያጋ፤ ሀዌ የለታፐ የለታይ ጋካናዉ ታን ሀሳየትያ መናዉ ታ ሱን።<verse eid="EXO 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 3:16"/>“ስም፤ ባደ እስራኤልያ ጭማቱዋ ሺሻደ፥ ‘መና ጎዳይ ህንተንቱ አዎቱዋ ጾሳይ፥ አብራሃሞ፥ ይሳቃነ ያቆባ ጾሳይ ታዉ ቆንጪደ፤ ታና፥ ታን ህንተንታ ጾሞሳድ፤ ግብጼን ህንተንቱ ቦላ ኦሰቴዳዋካ ታን በኣድ። <verse eid="EXO 3:16"/><verse number="17" style="v" sid="EXO 3:17"/>ታን ህንተንታ ግብጼ ጋድያ ቱጋፐ ከሳደ፥ ማይነ ኤሳይ ጎግያ ካናነቱዋ፥ ሂተቱዋ፥ አሞራዋናቱዋ፥ ፓርዛዋናቱዋ፥ ሂዌቱዋነ ያቡሳዋናቱዋ ጋድያ አፋና ጋ ኡታድ።’<verse eid="EXO 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 3:18"/>“እስራኤልያ ጭማቱ ነ ቃላ ስሳናዋንታ፤ ሄዋፐ ጉይያን ኔንነ ሄ ጭማቱ ግብጼ ካትያኮ ቢደ አ፥ ‘መና ጎዳይ፥ እብራዌቱዋ ጾሳይ፥ ኑናና ጋከቴዳ። ሀእ ኑን ሄዙ ጋላሳ ኦግያ መላ ቢታ ሀመት ቢደ፥ መና ጎዳ፥ ኑ ጾሳዉ፥ ያርሹዋ ያርሻና ማላ ኑና የዳ’ ያግተ። <verse eid="EXO 3:18"/><verse number="19" style="v" sid="EXO 3:19"/>ሽን ዎልቃማ ኩሺ፥ አ፥ ዎልቃን የድሳና ዮፐ፥ ግብጼ ካቲ ህንተንታ የደናዋ ታን ኤራይ። <verse eid="EXO 3:19"/><verse number="20" style="v" sid="EXO 3:20"/>ሄዋ ድራዉ፥ ታን ታ ኩሽያ የዳደ፥ ኡንቱንቱ ግዶን ታን ኦያ ታ ማላታቱዋ ኡባን ግብጼቱዋ ሾጫና። ሄዋፐ ጉይያን እ ህንተንታ የዳናዋ።<verse eid="EXO 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 3:21"/>“ቃይ ታን ግብጼቱዋን ሀ አሳ ሳቢሳና፤ ያቶፐ ህንተንቱ ከስያ ዎደ ኩሸ መላ ከስክታ።<note caller="-" style="x"><char style="xo" closed="false">3:21-22 </char><char style="xt" closed="false"><ref loc="EXO 12:35-36">ከሳ 12:35-36</ref></char></note> <verse eid="EXO 3:21"/><verse number="22" style="v" sid="EXO 3:22"/>እብራዌ ማጫውና ኡባታ ባረ ግብጼ ሾራትኮነ ባረ ሶን ደእያ ግብጼ ማጫ አሳ ኦናነ ግዶፐ ኢኮ ቢደ፥ ብራ ሚሻቱዋ፥ ዎርቃ ሚሻቱዋነ አቱማ ናናይነ ማጫ ናናይ ማያና ማዮቱዋ ‘እምተ’ ጊደ ኦቻናዋንታ። ሄዋዳን ኦደ ህንተንቱ ግብጼቱዋ ማጹዋ ቦንቃንታ” ያጌዳ።<verse eid="EXO 3:22"/></para>
  <chapter eid="EXO 3"/>
  <chapter number="4" style="c" sid="EXO 4"/>
  <para style="s1">ሙሴዉ ጾሳይ እሜዳ ማላታቱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 4:1"/>ሙሴ ዛሪደ፥ “ኡንቱንቱ ታና አማነናን እጾፐ፥ ዎይ ታን ኦድያዋ ስሰናን እጺደ፥ ‘መና ጎዳይ ነዉ ቆንጭቤና’ ጎፐ ዋኖ?” ያግ ዛሬዳ። <verse eid="EXO 4:1"/><verse number="2" style="v" sid="EXO 4:2"/>መና ጎዳይ አ፥ “ሄ ነ ኩሽያን ደእያዌ አዬ?” ያጊደ ኦቼዳ። እካ “ጻምኣ” ያጌዳ። <verse eid="EXO 4:2"/><verse number="3" style="v" sid="EXO 4:3"/>መና ጎዳይ አ፥ “አነ ሄ ጻምኣ ሳኣን ኦላ” ያጌዳ። ሙሴ ሄ ጻምኣ ሳኣን ኦሌዳ ዎደ ሾሻ ግዴዳ፤ ያትና፥ ሙሴ አፐ ዎጼዳ። <verse eid="EXO 4:3"/><verse number="4" style="v" sid="EXO 4:4"/>ሄዋፐ ጉይያን መና ጎዳይ አ፥ “ነ ኩሽያ የዳደ፥ አ ዱፍያ ኦይቃ” ያጌዳ። ሙሴ የዲደ ሾሻ ኦይቂና፥ ሾሻይ አ ኩሽያን ስሚደ፥ ጻምአዉ ላመቴዳ። <verse eid="EXO 4:4"/><verse number="5" style="v" sid="EXO 4:5"/>መና ጎዳይ፥ “ሀዌ ሀኔዳዌ፥ መና ጎዳይ ነ አዎቱዋ ጾሳይ፥ አብራሃማ ጾሳይ፥ ይሳቃ ጾሳይነ ያቆባ ጾሳይ ነዉ ቆንጬዳዋ ኡንቱንቱ አማናናዳና” ያጌዳ። <verse eid="EXO 4:5"/><verse number="6" style="v" sid="EXO 4:6"/>ሄዋፐ ጉይያን መና ጎዳይ አ፥ “ነ ኩሽያ ነ ሾጵያን የዳ” ያግና፥ ሙሴ ባረ ኩሽያ ሾጵያን የዴዳ፤ እ ከስ ጼሊደ፥ “ታ ኩሺ ኦሎቲደ ሻቻዳን ቦጼዳ” ያጌዳ። <verse eid="EXO 4:6"/><verse number="7" style="v" sid="EXO 4:7"/>ጾሳይ አ፥ “ነ ኩሽያ ነ ሾጵያን ዛራደ የዳ” ያጌዳ። ሙሴ ባረ ኩሽያ ባረ ሾጵያን ዛር የዲደ ከስያ ዎደ፥ “ታ ኩሺ ስሚደ ህንኮ ቦላ ማላ ግዴዳ” ያጌዳ።<verse eid="EXO 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 4:8"/>ቃይካ መና ጎዳይ አ፥ “ኡንቱንቱ ኔና አማነናን ዮፐነ ኮይሮ ማላታ አማነናን እጾፐ፥ ላኤን ማላታ ኡንቱንቱ አማናናዋንታ። <verse eid="EXO 4:8"/><verse number="9" style="v" sid="EXO 4:9"/>ሽን ኡንቱንቱ ሀ ላኡ ማላታቱዋ አማነናን ዮፐ፥ ዎይ ኔን ኦድያዋ ስሰናን እጾፐ፥ ናይለ ሻፋፐ ሃ አካደ፥ መላ ቢታን ጉሳ፤ ኔን ሻፋፐ አኬዳ ሃይ ቢታን ሱ ግዳናዋ” ያጌዳ።<verse eid="EXO 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 4:10"/>ሙሴ መና ጎዳ፥ “አቤት መና ጎዳዉ፥ ታን ሀዋፐ ካሰካ፥ ዎይ ኔን ነ ቆማዉ ሃሳዮደፐ ዶምና ታን ሃሳያናዉ ዳንዳይከ፤ ታን ዴዶታደ ሃሳያይ፤ ቃይ ታ እንጻርሳይካ ሉፋ” ያጌዳ። <verse eid="EXO 4:10"/><verse number="11" style="v" sid="EXO 4:11"/>መና ጎዳይ አ፥ “አሳዉ ዶና መዳዌ ኦኔ? አ ዱደ፥ ዎይ ቱለ ኦያዌ ኦኔ? ጼልያዋነ ቆቃ ኦያዌ ኦኔ? ታና መና ጎዳ ግድክታየ? <verse eid="EXO 4:11"/><verse number="12" style="v" sid="EXO 4:12"/>ኔን ሀእ ባ፤ ታን ኔና ሃሳያናዳን ማዳና፤ ኔን ጋናባ ታን ኔና ታማርሳና” ያጌዳ።<verse eid="EXO 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 4:13"/>ሽን ሙሴ፥ “አቤት ጎዳዉ፥ ሀያና፥ ሀዋ ኦናዉ ሀራ አሳ ኪታርኪ!” ያጌዳ። <verse eid="EXO 4:13"/><verse number="14" style="v" sid="EXO 4:14"/>ሄዋፐ ጉይያን መና ጎዳይ ሙሴዉ ሎይ ሀንቀቲደ አ፥ “ሌዊያ ግዴዳ ነ እሻ አሮኔ? እ ሎኦ ሃሳያና ዳንዳይያዋ ታን ኤራይ፤ ሀእ እ ኔናና ጋከታናዉ ዪደ ኦግያ ቦላን ደኤ፤ እ ኔና በእያ ዎደ አ ዎዛናይ ናሸታናዋ። <verse eid="EXO 4:14"/><verse number="15" style="v" sid="EXO 4:15"/>ኔን፥ ‘ያጋ፤ ያጋ’ ጋደ አዉ ኦዳና፤ ታን ህንተንታ ላኡዋካ ሃሳያናዉ ማዳናነ ህንተንቱ ኦናባ ታማርሳና። <verse eid="EXO 4:15"/><verse number="16" style="v" sid="EXO 4:16"/>እ አሳዉ ነ ድራ ሃሳያናዋ፤ ሄዌካ፥ እ ነዉ ዶና ማላ ግዳናዋ፥ ኔን አዉ ጾሳ ማላ ግዳናሳ ግያዋ። <verse eid="EXO 4:16"/><verse number="17" style="v" sid="EXO 4:17"/>ሽን ማላታቱዋ አን ኦናዉ፥ ኔን ሀ ጻምኣ አካደ ባ” ያጌዳ።<verse eid="EXO 4:17"/></para>
  <para style="s1">ሙሴ ግብጼ ስሜዳ</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 4:18"/>ሄዋፐ ጉይያን ሙሴ ባረ ቦሉዋ ዮቶረኮ ስም ቢደ፥ “ሀኖ ጋካናዉ ሸምፑዋና ደእያ አሳይ ደኦፐ በአናዉ፥ ታን ጉየ ታ አሳኮ ግብጼ ቦ?” ያጌዳ። ዮቶረ ሙሳ፥ “ኤ ባ፤ ሳሮ ጋካ” ያጌዳ። <verse eid="EXO 4:18"/><verse number="19" style="v" sid="EXO 4:19"/>ሙሴ ሚድያማ ጋድያን ደእሽን መና ጎዳይ አ፥ “ኔና ዎናዉ ኮዬዳ አሳቱ ኡባይ ሀይቂ ድጌዳ ድራዉ፥ ጉየ ግብጼ ጋድያ ስማደ ባ” ያጌዳ። <verse eid="EXO 4:19"/><verse number="20" style="v" sid="EXO 4:20"/>ሙሴ ባረ ማቻቶነ ባረ አቱማ ናና ሀርያ ቶግስ አኪደ፥ ጉየ ግብጼ ስሙሳ ዶሜዳ፤ ሙሴ ጾሳ ጻምኣ ባረ ኩሽያን ኦይቂደ ቤዳ።<verse eid="EXO 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 4:21"/>መና ጎዳይ ሙሳ፥ “ኔን ግብጼ ስማደ ብያ ዎደ፥ ታን ነዉ እሜዳ ዎልቃን ኔን ኦና ማላታቱዋ ኡባ ግብጼ ካትያ ስንን ኔን ኦናዋ ባሎፓ። ያትናካ አሳ እ የደና ማላ፥ ታን አ ዎዛና ዶንጭልሳና። <verse eid="EXO 4:21"/><verse number="22" style="v" sid="EXO 4:22"/>ሄ ዎደ ታን መና ጎዳይ፥ ግያዋ ካትያዉ ሀዋዳን ያጋደ ኦዳ፤ ‘ “እስራኤሊ ታ ባይራ ናኣ። <verse eid="EXO 4:22"/><verse number="23" style="v" sid="EXO 4:23"/>እ ታዉ ጎይናና ማላ፥ ታ ናኣ ኔን የዳና ማላ፥ ታን ነዉ ኦዳድ፤ ሽን ኔን አ የደናን እጻዳ፤ ሄዋ ድራዉ፥ ታን ነ ባይራ አቱማ ናኣ ዎና” ያጌ’ ያጋደ ኦዳ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">4:23 </char><char style="xt" closed="false"><ref loc="EXO 12:29">ከሳ 12:29</ref></char></note><verse eid="EXO 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 4:24"/>ኦግያን ሸምፕያሳን መና ጎዳይ ሙሴና ጋከቴዳ፤ አ ዎና ሀኔዳ። <verse eid="EXO 4:24"/><verse number="25" style="v" sid="EXO 4:25"/>አ ማቻታ ጽፓራ ሳልያ አካደ፥ ባረ ናኣ ቃጻራዱ። ሄ ሾኩዋን ሙሴ ገድያ<note caller="+" style="f"><char style="fr" closed="false">4:25-26 </char><char style="fqa" closed="false">ጌድያ፦ </char><char style="ft" closed="false">ሀዋ ጉሳይ “አ አቱን ቦቻዱ” ጉሳ።</char></note> ቦቻዱ። እዛ ሙሳ፥ “ኔን ታዉ ቱሙ ሱ ምሽራ” ያጋዱ። <verse eid="EXO 4:25"/><verse number="26" style="v" sid="EXO 4:26"/>መና ጎዳይ ሄዋ ድራዉ አ ዎናን አጌዳ። ሄ ዎደ ቃጻራ ማላታናዉ አ፥ “ኔን ታዉ ሱ ምሽራ” ያጋዱ።<verse eid="EXO 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 4:27"/>መና ጎዳይ አሮና፥ “ኔን ሙሴና ጋከታናዉ መላ ቢታ ባ” ያጌዳ። እ ቢደ፥ ሙሴና ጾሳ ደርያን ጋከቲደ አ የሬዳ። <verse eid="EXO 4:27"/><verse number="28" style="v" sid="EXO 4:28"/>ሄዋፐ ጉይያን ሙሴ መና ጎዳይ ባረ ቦላ ኪቴዳ ቃላ ኡባነ ኦና ማላ፥ ባረና አዛዜዳ ኦራ ማላታቱዋ ኡባ አሮናዉ ኦዴዳ። <verse eid="EXO 4:28"/><verse number="29" style="v" sid="EXO 4:29"/>ሙሴነ አሮነ ቢደ፥ እስራኤለቱዋ ጭማቱዋ ኡባ ሺሼድኖ። <verse eid="EXO 4:29"/><verse number="30" style="v" sid="EXO 4:30"/>አሮነ መና ጎዳይ ሙሴዉ ኦዴዳ ቃላ ኡባ ኡንቱንቶ ኦዴዳ። ማላታቱዋካ ሄ አሳ ስንን ኦዳ። <verse eid="EXO 4:30"/><verse number="31" style="v" sid="EXO 4:31"/>ኡንቱንቱካ አማኔድኖ። መና ጎዳይ ኡንቱንቶ ቆፔዳዋነ ኡንቱንቱ ቱጋ በኤዳዋ ስሴዳ ዎደ፥ ኡንቱንቱ ጉፋኒደ ጎይኔድኖ።<verse eid="EXO 4:31"/></para>
  <chapter eid="EXO 4"/>
  <chapter number="5" style="c" sid="EXO 5"/>
  <para style="s1">ሙሴነ አሮነ ፓሮና ስንን</para>
  <para style="r">(<ref loc="EXO 5:1-11:10">5:1—11:10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 5:1"/>ሄዋፐ ጉይያን ሙሴነ አሮነ ግብጼ ካትያኮ ዪደ አ፥ “መና ጎዳይ፥ እስራኤልያ ጾሳይ ሀዋዳን ያጌ፤ ‘ታ አሳይ ታዉ መላ ቢታን ባላ ቦንቻና ማላ፥ ኡንቱንታ የዳ’ ያጌ” ያጌድኖ። <verse eid="EXO 5:1"/><verse number="2" style="v" sid="EXO 5:2"/>ካቲ፥ “ታን አዉ አዛዘታደ እስራኤልያ የዳናዉ ሄ መና ጎዳይ ኦኔ? ታን መና ጎዳ ኤርከ፤ እስራኤልያካ የድከ” ያጌዳ። <verse eid="EXO 5:2"/><verse number="3" style="v" sid="EXO 5:3"/>ሄዋፐ ጉይያን ኡንቱንቱ፥ “እብራዌቱዋ ጾሳይ ኑናና ጋከቴዳ። ሀእ ኑን መና ጎዳ፥ ኑ ጾሳዉ፥ ያርሹዋ ያርሻናዉ ሄዙ ጋላሳ ኦግያ መላ ቢታ ግዶ ባናዉ ኑና የዳርኪ፤ ሄዌ ዮፐ፥ እ ኑና ኢታ ሀርግያን ዎይ ኦላን ዎናዋ” ያጌድኖ።<verse eid="EXO 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 5:4"/>ሽን ግብጼ ካቲ ያጌዳ፤ “ሙሴ! አሮና! አሳ አያዉ ኪታ ድጊቴ? ህንተንቱ ኪታዉ ስሚደ ቢተ” ያጌዳ። <verse eid="EXO 5:4"/><verse number="5" style="v" sid="EXO 5:5"/>ካቲ ሄ ዎደ፥ “በእተ፥ ሀ ጋድያን አሳይ ጮራቴዳ፤ ቃይ ህንተንቱ ኡንቱንታ ኪታ ድጊታ” ያጌዳ። <verse eid="EXO 5:5"/><verse number="6" style="v" sid="EXO 5:6"/>ካቲ ሄ ጋላስ ግብጼቱዋ ካፖቱዋነ እስራኤለቱዋ ዳጉዋ ሱንቱዋ አዛዚደ፥ <verse eid="EXO 5:6"/><verse number="7" style="v" sid="EXO 5:7"/>“ሀሮደዋዳን ጹብያ መያ ኡቱላ አሳዉ እሞፕተ፤ ኡንቱንቱ ኡቱላ ባረንቶ ቢደ ሺሽኖ፤ <verse eid="EXO 5:7"/><verse number="8" style="v" sid="EXO 5:8"/>ሽን ኡንቱንቱ ፓይዱዋን ካሰዋ ኬሻ ጹብያ መደ፥ ሼናዳን አዛዝተ፤ ሄ ፓይዱዋፐ ፓጭሶፕተ፤ አያዉ ጎፐ፥ ኡንቱንቱ አዛላ፤ ኡንቱንቱ፥ ‘ኑን ኑ ጾሳዉ ያርሹዋ ያርሻና ማላ፥ ኑና የዳርኪ’ ያጊደ ዋስያዌ ሀዋሳ። <verse eid="EXO 5:8"/><verse number="9" style="v" sid="EXO 5:9"/>ኡንቱንቱ ኪታን ሼካና ማላነ ዎርዱዋ ሃሳያ ስሰናን አጋና ማላ፥ ኡንቱንቶ ኦሱዋ ዴጽስተ” ያጊደ አዛዜዳ።<verse eid="EXO 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 5:10"/>ሄዋፐ ጉይያን፥ ሄ ካፖቱነ ሄ ሱንቱ ከሲደ አሳ፥ “ካቲ ሀዋዳን ያጌ፤ ‘ስም ታን ህንተንቶ ኡባካ ኡቱላ እምከ፤ <verse eid="EXO 5:10"/><verse number="11" style="v" sid="EXO 5:11"/>ህንተንቱ ኡቱላ ደማና ዳንዳይያሳፐ ህንተንቱ ሁጲያዉ ሺሽተ፤ ሽን ህንተንቱ ሼያ ጹብያ ፓይዱ ኡባካ ፓጨና’ ያጌዳ” ያጌድኖ። <verse eid="EXO 5:11"/><verse number="12" style="v" sid="EXO 5:12"/>አሳይ ኡቱላዉ ሀንያዋ ሺሻናዉ ግብጼ ቢታ ኡባን ላለቴዳ። <verse eid="EXO 5:12"/><verse number="13" style="v" sid="EXO 5:13"/>ግብጼቱዋ ካፖቱ ኡንቱንታ፥ “ህንተንቶ ኡቱላ እምያ ዎደ ህንተንቱ ሀቼ ሀቼ ኦያዋ ኬሻ ኦተ” ያጊደ ኡንቱንታ ጎደቴድኖ። <verse eid="EXO 5:13"/><verse number="14" style="v" sid="EXO 5:14"/>ግብጼቱዋ ካፖቱ እስራኤለቱዋ ዳጉዋ ሱንቱዋ ዋደ፥ “ህንተንቱ ካሰ ኦያዋ ኬሻ ጹብያ ዝኖ ዎይ ሀቼ አያዉ ኦ ዉርስበይክቴ?” ያጊደ ኦቼድኖ።<verse eid="EXO 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 5:15"/>ሄዋፐ ጉይያን እስራኤልያ ሱንቱ ቢደ ካትያዉ ማጋኔድኖ፤ ኡንቱንቱ ባረንቱ መቱዋፐ ደንዶዋን አ፥ “ኔን ነ ቆማቱዋ ሀዋዳን አያዉ ኦይ? <verse eid="EXO 5:15"/><verse number="16" style="v" sid="EXO 5:16"/>ነ ቆማቶ ኡቱላ እምክኖ፤ ሽን፥ ‘ጹብያ መተ’ ያጊኖ፤ ኑና ነ ቆማቱዋ ዋኖ፤ ሽን ባላይ ነ አሳ ቦላና” ያጌድኖ። <verse eid="EXO 5:16"/><verse number="17" style="v" sid="EXO 5:17"/>ሽን ካቲ ኡንቱንታ፥ “ሀ አዛላቱ! ህንተንቱ አዛላ! ሄዋ ድራዉ፥ ህንተንቱ ዛር ዛሪደ፥ ‘ኑን መና ጎዳዉ ያርሻና ባናዉ ኑና የዳርኪ’ ያጊታ። <verse eid="EXO 5:17"/><verse number="18" style="v" sid="EXO 5:18"/>ሀእ ቢተ፤ ኦተ፤ ኡንቱንቱ ህንተንቶ አይ ኡቱላካ እምክኖ፤ ሽን ህንተንቱ ካሰዋ ኬሻ ጹብያ መታ” ያጌዳ። <verse eid="EXO 5:18"/><verse number="19" style="v" sid="EXO 5:19"/>እስራኤላቱዋ ሱንቱ፥ “ህንተንቱ ሀቼ ሀቼ መያ ጹብያ ፓይዱዋ ካሰዋፐ ፓጭሶፕተ” ጌዳ ዎደ፥ ኡንቱንቱ መቱዋን ገሌዳዋ አኬኬድኖ። <verse eid="EXO 5:19"/><verse number="20" style="v" sid="EXO 5:20"/>ኡንቱንቱ ካትያ ማታፐ ከሲደ፥ ሙሴነ አሮነ ኡንቱንቱና ጋከታናዉ ናግያዋንታ ደሜድኖ። <verse eid="EXO 5:20"/><verse number="21" style="v" sid="EXO 5:21"/>ኡንቱንቱ፥ “ህንተና መና ጎዳይ ጼሎ! ህንተንቱ ቦላ እ ፕርዶ! ህንተንቱ ኑና ካትያናነ አ ኦሳንቻቱዋን እጽሴድታ፤ ቃይ ኡንቱንቱ ኑና ዎና ማላ፥ ማሻ ኡንቱንቱ ኩሽያን ዎድታ” ያጌድኖ።<verse eid="EXO 5:21"/></para>
  <para style="s1">ሙሴ ጾሳዉ ማጋኔዳ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 5:22"/>ሙሴ መና ጎዳኮ ስሚደ፥ “አቤት ጎዳዉ፥ ኔን ሀ አሳ ቦላ መቱዋ አያዉ አሃዲ? ኔን ታና ኪቴዳዌ ሀዋሴ? <verse eid="EXO 5:22"/><verse number="23" style="v" sid="EXO 5:23"/>ታን ነ ሱንን ካትያዉ ሃሳያናዉ ቤዳ ዎደፐ ዶምና፥ እ ሀ አሳ ቦላ መቱዋ አሄዳ። ቃይ ኔንካ ነ አሳ ሙለ አሻባካ” ያጌዳ።<verse eid="EXO 5:23"/></para>
  <chapter eid="EXO 5"/>
  <chapter number="6" style="c" sid="EXO 6"/>
  <para style="p">
    <verse number="1" style="v" sid="EXO 6:1"/>ሄዋፐ ጉይያን መና ጎዳይ ሙሳ፥ “ታን ግብጼ ካትያ ኦናባ ኔን ሀእ በአና፤ ታ ዎልቃማ ኩሽያ ጋሱዋን እ ኡንቱንታ የዳናዋ፤ ታ ዎልቃማ ኩሽያ ጋሱዋን እ ኡንቱንታ ባረ ጋድያፐ ላጊደ ከሳና” ያጌዳ።<verse eid="EXO 6:1"/></para>
  <para style="s1">ሙሴ ጼሳ</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 6:2"/>ጾሳይ ቃይካ ሙሳ፥ “ታን መና ጎዳ፤<note caller="-" style="x"><char style="xo" closed="false">6:2-3 </char><char style="xt" closed="false"><ref loc="GEN 17:1">ዶመ 17:1</ref>፤ <ref loc="GEN 28:3">28:3</ref>፤ <ref loc="GEN 35:11">35:11</ref>፤ <ref loc="EXO 3:13-15">ከሳ 3:13-15</ref></char></note> <verse eid="EXO 6:2"/><verse number="3" style="v" sid="EXO 6:3"/>ታን አብራሃመዉ፥ ይሳቃዉነ ያቆባዉ ኡባ ዳንዳይያ ጾሳ ግዳደ ቆንጫድ፤ ሽን ታን፥ መና ጎዳ ግያ ታ ሱንን፥ ታናተ ኡንቱንታ ኤርሳበይከ። <verse eid="EXO 6:3"/><verse number="4" style="v" sid="EXO 6:4"/>ቃይ ታን ኡንቱንቶ ኡንቱንቱ በተ ግዲደ ደኤዳ ካናነ ጋድያ እማናዉ ታ ቃላ ጫቁዋ ኡንቱንቱና ጫቀታድ። <verse eid="EXO 6:4"/><verse number="5" style="v" sid="EXO 6:5"/>ቃይካ ግብጼ አሳቱ አይለይያ እስራኤለቱዋ ኦልያ ታን ስሳደ፥ ታ ቃላ ጫቁዋ ሀሳያድ።<verse eid="EXO 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 6:6"/>“ሄዋ ድራዉ፥ ኔን እስራኤላቱዋ፥ ‘ታን መና ጎዳ፤ ታን ህንተንታ ግብጼቱዋ ናቁዋፐ ከሳና፤ ታን ህንተንታ ኡንቱንቱ አይለተፐካ ላአ ከሳና፤ ቃይ ታን ታ ዎልቃማ ዎልቃን ግብጼቱዋ ቦላ ኢታ ፕርዳ አሃደ ህንተንታ ዎዛና። <verse eid="EXO 6:6"/><verse number="7" style="v" sid="EXO 6:7"/>ታን ህንተንታ ታ ሁጰ አሳዳን አካናነ ታን ህንተንቱ ጾሳ ግዳና። ሄ ዎደ ህንተንቱ ታን መና ጎዳ ህንተንቱ ጾሳ ህንተንታ ግብጼቱዋ አይለተፐ ከሴዳዋ ግድያዋ ኤራና። <verse eid="EXO 6:7"/><verse number="8" style="v" sid="EXO 6:8"/>ቃይ ታን አብራሃመዉ፥ ይሳቃዉነ ያቆባዉ እማናዉ ጫቄዳ ቢታዉ አሀና፤ ሄ ጋድያ ታን ህንተንቶ ጋደ ኦደ እማና፤ ታን መና ጎዳ ያጋ’ ” ያጌዳ።<verse eid="EXO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 6:9"/>ሙሴ ሀዋ እስራኤለቶ ኦዴዳ፤ ሽን ኡንቱንቱ አያናይ መኤዳ ጋሱዋንነ መቀ ባይና አይለተ ጋሱዋን አ ቃላ ስስበይክኖ። <verse eid="EXO 6:9"/><verse number="10" style="v" sid="EXO 6:10"/>ሄዋፐ ጉይያን መና ጎዳይ ሙሳ፥ <verse eid="EXO 6:10"/><verse number="11" style="v" sid="EXO 6:11"/>“ባደ ግብጼ ካትያ፥ ‘እስራኤለቱዋ ነ ጋድያፐ ከሳደ የዳ’ ያጋደ ኦዳ” ያጌዳ። <verse eid="EXO 6:11"/><verse number="12" style="v" sid="EXO 6:12"/>ሽን ሙሴ መና ጎዳ፥ “ሀራይ አቶ እስራኤለቱ ታባ ስሰናን እጼድኖ ሽን ታን ዴዶትያ እንጻርሳን ሃሳይያዋ ካቲ ዎት ስሳኔ?” ያጌዳ። <verse eid="EXO 6:12"/><verse number="13" style="v" sid="EXO 6:13"/>መና ጎዳይ ሙሳነ አሮና፥ “ቢደ፥ ህንተንቱ እስራኤልያ አሳ ግብጼፐ ከሳና ማላ፥ ታን ህንተንታ የዴዳዋ እስራኤልያ አሳዉነ ግብጼ ካትያዉ ኦድተ” ያጊደ አዛዜዳ።<verse eid="EXO 6:13"/></para>
  <para style="s1">ሙሴነ አሮነ የለታ</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 6:14"/>ኡንቱንቱ ሶይ ሶይ ማይዛ አዎቱ ሀዋንታ። እስራኤልያዉ ባይራ ናኣ ሮቤላ አቱማ ናናይ፥ ሄኖካ፥ ፓሉ፥ ሄጽሮናነ ካርማ፤ ሀዋንቱ ሮቤላ ያራቱዋ።<verse eid="EXO 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 6:15"/>ስሞና አቱማ ናናይ፥ ይሙኤላ፥ ያሚና፥ ኦሃዳ፥ ያኪና፥ ጾሃራነ ካናነ ጋደ ምሽራትፐ የለቴዳ ሻኡላ፤ ሀዋንቱ ስሞና ያራቱዋ።<verse eid="EXO 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 6:16"/>ሌዊያ አቱማ ናናይ ባረንቱ የለታ ማራዳን ገርሾና፥ ቃሃታነ ማራራ። ሌዊ ጼታነ ሀታማነ ላፑን ላይ ደኤዳ።<note caller="-" style="x"><char style="xo" closed="false">6:16-19 </char><char style="xt" closed="false"><ref loc="NUM 3:17-20">ፓይ. 3:17-20</ref>፤ <ref loc="NUM 26:57-58">26:57-58</ref>፤ <ref loc="1CH 6:16-19">1 ኦዱዋ 6:16-19</ref></char></note><verse eid="EXO 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 6:17"/>ገርሾና አቱማ ናናይ ባረንቱ ያራን ያራን ሊብናነ ሽምአ ጌተቲኖ።<verse eid="EXO 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 6:18"/>ቃሃተ አቱማ ናናይ አምራማ፥ ይጽሃራ፥ ከብሮናነ ኡዝኤላ። ቃሃተ ጼታነ ሀታማነ ሄዙ ላይ ደኤዳ።<verse eid="EXO 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 6:19"/>ማራራ አቱማ ናናይ ማህላነ ሙሻ ግያዋንታ።</para>
  <para style="p" vid="EXO 6:19">ባረንቱ የለታ ማራን ሀዋፐ ቆሞና ጼገቴዳ ሌዊያ ያራቱ ሀዋንታ።<verse eid="EXO 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 6:20"/>አምራመ ባረ አዉዋ ምቻቶ ዮከቤዶ አኬዳ። እዛ አሮናነ ሙሳ አዉ የላዱ። አምራመ ጼታነ ሀታማነ ላፑን ላይ ደኤዳ።<verse eid="EXO 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 6:21"/>ይጽሃራ አቱማ ናናይ፥ ቆራሀ፥ ነፌጋነ ዚክራ።<verse eid="EXO 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 6:22"/>ኡዝኤላ አቱማ ናናይ፥ ምሻኤላ፥ ኤልጻፋናነ ሲትራ።<verse eid="EXO 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 6:23"/>አሮነ አምናዳባ ናቶ፥ ናኣሶና ምቻቶ ኤልሼቦ አኬዳ። ያትና እዛ አዉ ናዳባ፥ አቢሀ፥ ኤልኣዛራነ እታማራ ጌተትያ አቱማ ናና የላዱ።<verse eid="EXO 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 6:24"/>ቆረ አቱማ ናናይ፥ አሲራ፥ ኤልቃናነ አብያሳፋ፤ ሀዋንቱ ቆረ ያራቱዋ።<verse eid="EXO 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 6:25"/>አሮና ናአይ ኤልኣዛረ ፑትኤላ ናናቱዋፐ እትኖ አኬዳ፤ እዛ አዉ ፒንሃሳ የላዱ።</para>
  <para style="p" vid="EXO 6:25">ሀዋንቱ ባረንቱ ያራን ያራን ሌዋቱዋ ጎልያ ማይዛ አሳቱዋ።<verse eid="EXO 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 6:26"/>መና ጎዳይ፥ “ግብጼ ጋድያፐ እስራኤላቱዋ ኦላዉ ጊጎ ጩጉዋዳን ጩጉዋዳን ከስተ” ያጌዳዌ ሀ ሙሳነ አሮና። <verse eid="EXO 6:26"/><verse number="27" style="v" sid="EXO 6:27"/>እስራኤላቱዋ ግብጼ ጋድያፐ ከስያዋ ግብጼ ካትያዉ ሃሳዬዳዋንቱ ኡንቱንታ። ሄዋንቱካ ሙሳነ አሮና። <verse eid="EXO 6:27"/><verse number="28" style="v" sid="EXO 6:28"/>መና ጎዳይ ግብጼን ሙሴዉ ሃሳዬዳ ዎደ አ፥ <verse eid="EXO 6:28"/><verse number="29" style="v" sid="EXO 6:29"/>“ታን መና ጎዳ፤ ታን ነዉ ኦድያዋ ኡባ ኔን ግብጼ ካትያዉ ኦዳ” ያጌዳ። <verse eid="EXO 6:29"/><verse number="30" style="v" sid="EXO 6:30"/>ሽን ሙሴ መና ጎዳ፥ “ታን ዴዶትያ እንጻርሳን ሃሳይያዋ ግድሽን፥ ካቲ ታን ኦድያዋ ዎት ስሳኔ?” ያጌዳ።<verse eid="EXO 6:30"/></para>
  <chapter eid="EXO 6"/>
  <chapter number="7" style="c" sid="EXO 7"/>
  <para style="p">
    <verse number="1" style="v" sid="EXO 7:1"/>ሄዋፐ ጉይያን መና ጎዳይ ሙሳ፥ “በአ፤ ታን ኔና ግብጼ ካትያዉ ጾሳ ማላ ኦድ፤ ነ እሻይ አሮነ ነ ናብያዳን ግዳናዋ፤ <verse eid="EXO 7:1"/><verse number="2" style="v" sid="EXO 7:2"/>ታን ኔና አዛዜዳ ኡባ ኔን አዉ ኦዳሳ፤ ነ እሻ አሮነ እስራኤላቱዋ ባረ ጋድያፐ ከስ የዳና ማላ፥ ካትያዉ ኦዴ። <verse eid="EXO 7:2"/><verse number="3" style="v" sid="EXO 7:3"/>ሽን ታን ካትያ ዎዛና ልሳና፤ ታን ግብጼ ጋድያን ታ ጮራ ማላታነ ማላልስያባ ዳርሳደ ኦንቶካ፥<note caller="-" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="ACT 7:36">ኪታ 7:36</ref></char></note> <verse eid="EXO 7:3"/><verse number="4" style="v" sid="EXO 7:4"/>እ ህንተንቱ ኦድያዋ ስሰና። ሄ ዎደ ታን ታ ኩሽያ ግብጼቱዋ ቦላ ደንና፤ ታን ታ ጩጉዋ፥ ታ አሳ እስራኤልያ፥ ግብጼ አሳ ቦላን ዎልቃማ ፕርዳ አሃደ ከሳና። <verse eid="EXO 7:4"/><verse number="5" style="v" sid="EXO 7:5"/>ሄዋፐ ጉይያን ግብጼቱ፥ ታን ታ ኩሽያ ግብጼ ቦላ ደንደ፥ እስራኤላቱዋ ኡንቱንቱ ግዶፐ ከሴዳ ዎደ፥ ታን መና ጎዳ ግድያዋ ኡንቱንቱ ኤራናዋንታ” ያጌዳ።<verse eid="EXO 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 7:6"/>ሙሴነ አሮነ ልከ መና ጎዳይ ኡንቱንታ አዛዜዳዋዳን ኦድኖ። <verse eid="EXO 7:6"/><verse number="7" style="v" sid="EXO 7:7"/>ኡንቱንቱ ካትያዉ ኦድያ ዎደ፥ ሙሴ ሆስፑን ታሙ ላይ አሳ፤ አሮነ ቃይ ሆስፑን ታማነ ሄዙ ላይ አሳ።<verse eid="EXO 7:7"/></para>
  <para style="s1">አሮና ጻምአይ ሾሻ ግዴዳ</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 7:8"/>መና ጎዳይ ሙሳነ አሮና ሀዋዳን ያጌዳ፤ <verse eid="EXO 7:8"/><verse number="9" style="v" sid="EXO 7:9"/>“ካቲ ህንተንታ፥ ‘ጾሳይ ኦያ ማላታ ታና በስተ’ ግያ ዎደ፥ ኔን አሮና፥ ‘ነ ጻምኣ አካደ፥ ካትያ ስንን ኦላ’ ያጋ፤ ያቶፐ እ ሾሻ ከሳና” ያጌዳ። <verse eid="EXO 7:9"/><verse number="10" style="v" sid="EXO 7:10"/>ሙሴነ አሮነ ካትያኮ ገሊደ መና ጎዳይ ኡንቱንታ አዛዜዳዋዳን ኦድኖ፤ አሮነ ባረ ጻምኣ ካትያ ስንንነ አ ኦሳንቻቱዋ ስንን ኦልና ሾሻ ከሴዳ። <verse eid="EXO 7:10"/><verse number="11" style="v" sid="EXO 7:11"/>ሄዋፐ ጉይያን ካቲ ኤራንቻቱዋነ ብትያዋንታ ጼስስና ኡንቱንቱካ፥ ሀ ግብጼቱዋ ሻሬቾቱ ባረንቱ ማሹዋን ሄዋዳን ኦድኖ። <verse eid="EXO 7:11"/><verse number="12" style="v" sid="EXO 7:12"/>ኡንቱንቱ ኡባይካ ባረንቱ ጻምኣ ጻምኣ ኦልና፥ ጻምአቱ ሾሻ ከሴድኖ፤ ሽን አሮና ጻምአይ ኡንቱንቱ ጻምአቱዋ ምቴዳ። <verse eid="EXO 7:12"/><verse number="13" style="v" sid="EXO 7:13"/>ግዶፐነ መና ጎዳይ ኦዴዳዋዳንካ ካትያ ዎዛናይ ዶንጭሌዳ፤ እ ኡንቱንቱ ኦዱዋ ስሰናን እጼዳ።<verse eid="EXO 7:13"/></para>
  <para style="s1">ሃይ ሱዉ ላመቴዳ</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 7:14"/>መና ጎዳይ ሙሳ፥ “ካትያ ዎዛናይ ዶንጭሌዳ፤ አሳ እ የደናን እጼዳ። <verse eid="EXO 7:14"/><verse number="15" style="v" sid="EXO 7:15"/>ካቲ ሃኮ ብያ ዎደ፥ ጉራደ ኔን አኮ ባደ አናና ጋከታናዉ ናይለ ሻፋ ዶናን ኤአ፤ ሾሻዉ ላመቴዳ ጻምኣ ኦይቃ አካደ ባ። <verse eid="EXO 7:15"/><verse number="16" style="v" sid="EXO 7:16"/>ኔን አ፥ ‘መና ጎዳይ፥ እብራዌቱዋ ጾሳይ ኔና፥ መላ ቢታን ታዉ ጎይናና ማላ፥ ታ አሳ የዳ ያጊደ፥ ታና ኔኮ ኪቴዳ፤ ሽን ሀኖ ጋካናዉ ኔን ስሳበይካ። <verse eid="EXO 7:16"/><verse number="17" style="v" sid="EXO 7:17"/>መና ጎዳይ፥ ታን መና ጎዳ ግድያዋ ኔን ሀዋን ኤራና። ታን ናይለ ሻፋ ሃ ታ ኩሽያን ደእያ ጻምአን ሾጭና ሃይ ሱዉ ላመታናዋ።<note caller="-" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="REV 16:4">ሳፃ 16:4</ref></char></note> <verse eid="EXO 7:17"/><verse number="18" style="v" sid="EXO 7:18"/>ናይለ ሻፋ ሞሊካ ሀይቃናዋ፤ ሻፋይካ ጽንቃናዋ፤ ግብጼቱ ሄ ሻፋ ሃ ኡሻናዉ ዳንዳይክኖ’ ያጋደ ኦዳ” ያጌዳ።<verse eid="EXO 7:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 7:19"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ “ኔን አሮና፥ ‘ነ ጻምኣ ኦይቃደ ግብጼ ሃቱዋ ቦላ፥ ሻፋቱዋ ቦላ፥ ዜሬቶ ሃቱዋ ቦላ፥ ድኡዋ ኦላ ቦላን ነ ኩሽያ ምጫ’ ያጋ፤ እ ምጭና ኡንቱንቱ ሱዉ ላመታናዋ፤ ግብጼ ቢታ ኡባን፥ ሀራይ አትና፥ ምፐነ ሹቻፐ ዎጪደ ከሴዳ ሃ ትግያ ሚሻ ኡባ ጋርሳን ደእያ ሃይ ሱዉ ላመታና” ያጌዳ።<verse eid="EXO 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 7:20"/>ሙሴነ አሮነ መና ጎዳይ አዛዜዳዋዳን ኦድኖ። ካትያ ስንንነ አ ኦሳንቻቱዋ ስንን እ ባረ ጻምኣ ደንደ፥ ሻፋ ሃ ሾጭና ሃ ኡባይ ሱዉ ላመቴዳ። <verse eid="EXO 7:20"/><verse number="21" style="v" sid="EXO 7:21"/>ሄ ሻፋ ሃ ግዱዋን ደእያ ሞለቱ ሀይቄድኖ፤ ሻፋ ሃይ ሎይ ዜኤዳ ድራዉ፥ ግብጼ አሳይ ኡሻናዉ ዳንዳይቤና። ግብጼን ኡባ ሳን ሱይ ኩሜዳ። <verse eid="EXO 7:21"/><verse number="22" style="v" sid="EXO 7:22"/>ግብጼ ሻሬቾቱካ ባረንቱ ማሹዋን ሄዋዳን ኦድኖ፤ መና ጎዳይ ኦዴዳዋዳንካ ካትያ ዎዛናይ ዶንጭልና፥ ሙሴነ አሮነ ኦዴዳዋ ስሰናን እጼዳ። <verse eid="EXO 7:22"/><verse number="23" style="v" sid="EXO 7:23"/>ሄዋፐ ጉይያን ካቲ ሀዎ አይነ ህርገናን ባረ ሶ ስሚደ ቤዳ። <verse eid="EXO 7:23"/><verse number="24" style="v" sid="EXO 7:24"/>ግብጼ አሳይ ኡባይ ናይለ ሻፋ ሃ ኡሻናዉ ዳንዳይቤና ድራዉ፥ ኡሽያ ሃ ደማናዉ ናይለ ሻፋ ጋጻን ኦላ ቦኬድኖ።<verse eid="EXO 7:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 7:25"/>መና ጎዳይ ሃ ሾጮደፐ ላፑን ጋላሳ ግዴዳ።<verse eid="EXO 7:25"/></para>
  <chapter eid="EXO 7"/>
  <chapter number="8" style="c" sid="EXO 8"/>
  <para style="s1">ሸያ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 8:1"/>ሄዋፐ ጉይያን መና ጎዳይ ሙሳ፥ “ባ፤ ግብጼ ካትያኮ ባደ፥ ‘መና ጎዳይ ሀዋዳን ያጌ፤ “ታዉ ጎይናና ማላ፥ ታ አሳ የዳ። <verse eid="EXO 8:1"/><verse number="2" style="v" sid="EXO 8:2"/>ኔን ኡንቱንታ የደናን እጾፐ፥ ታን ነ ቢታ ኡባን ሸያ ኩንና። <verse eid="EXO 8:2"/><verse number="3" style="v" sid="EXO 8:3"/>ናይለ ሻፋን ሸ ሾሀካታና። ኡንቱንቱ ሾሀካት ከሲደ ነ ሶ፥ ነ ስርጻ፥ ነ ግሱዋ ግዶ፥ ነ ኦሳንቻቱዋ ጎልያ ግዶ ገላና፤ ነ አሳ ቦላ ከሳና፤ ነ ጮጭያነ ነ ልያ ዎያ ከርያን ገላና። <verse eid="EXO 8:3"/><verse number="4" style="v" sid="EXO 8:4"/>ሸቱ ነ ቦላ፥ ነ አሳ ቦላነ ነ ኦሳንቻቱዋ ኡባ ቦላ ከሳና” ያጌ’ ያጋደ ኦዳ” ያጌዳ።<verse eid="EXO 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 8:5"/>ሄዋፐ ጉይያን መና ጎዳይ ሙሳ፥ “ኔን አሮና፥ ‘ነ ጻምኣ ኦይቃደ፥ ሻፋቱዋ ቦላ፥ ዜሬቶ ሃቱዋ ቦላነ ድኡዋ ኦላ ቦላ ነ ኩሽያ ምጫደ ሸቱ ግብጼ ጋድያ ቦላን ከሳናዳን ኦ’ ያጋደ ኦዳ” ያጌዳ። <verse eid="EXO 8:5"/><verse number="6" style="v" sid="EXO 8:6"/>አሮነ ግብጼ ሃቱዋ ቦላ ባረ ኩሽያ ምጭና ሸቱ ከሲደ፥ ግብጼ ጋድያ ማዬድኖ። <verse eid="EXO 8:6"/><verse number="7" style="v" sid="EXO 8:7"/>ሻሬቻቱካ ባረንቱ ማሹዋን ሄዋዳን ኦድኖ፤ ኡንቱንቱካ ግብጼ ጋድያን ሸ ከሳናዳን ኦድኖ።<verse eid="EXO 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 8:8"/>ካቲ ሙሳነ አሮና ጼስሲደ፥ “ሀ ሸቱዋ ታፐነ ታ አሳፐ ድጋና ማላ፥ መና ጎዳ ህንተንቱ ዎስተ፤ ያቶፐ መና ጎዳዉ ያርሹዋ ያርሻና ማላ፥ ታን አሳ የዳና” ያጌዳ። <verse eid="EXO 8:8"/><verse number="9" style="v" sid="EXO 8:9"/>ሙሴ ካትያ፥ “ካትያዉ ሸቱ ኔፐነ ነ ሶፐ ያና ማላነ ናይለ ሻፋ ጻላላን አታና ማላ፥ ታን ነዉ፥ ነ ኦሳንቻቶነ ነ አሳዉ ዎሳና ዎድያ ኔን ኬራ” ያጌዳ። <verse eid="EXO 8:9"/><verse number="10" style="v" sid="EXO 8:10"/>ካቲ፥ “ዎንታ” ያጌዳ። ሙሴ፥ “መና ጎዳ ኑ ጾሳ፥ ማላይ ኦንነ ባይናዋ ኔን ኤራና ማላ፥ ኔን ጌዳዋዳን ሀናናዋ። <verse eid="EXO 8:10"/><verse number="11" style="v" sid="EXO 8:11"/>ሄ ሸቱ ኔፐ፥ ነ ጎልያፐ፥ ነ ኦሳንቻቱዋፐነ ነ አሳፐ ያናዋንታ፤ ኡንቱንቱካ ናይለ ሻፋ ጻላላን አታናዋንታ” ያጌዳ። <verse eid="EXO 8:11"/><verse number="12" style="v" sid="EXO 8:12"/>ሙሴነ አሮነ ካትያ ማታፐ ከሴድኖ፤ ካትያ ቦላ መና ጎዳይ አሄዳ ሸቱዋባ ሙሴ መና ጎዳኮ ዎሴዳ። <verse eid="EXO 8:12"/><verse number="13" style="v" sid="EXO 8:13"/>መና ጎዳይ ሙሴ ኦቼዳዋዳን ኦዳ፤ ሸቱ ሶን ካረንነ ደምባን ሀይቄድኖ። <verse eid="EXO 8:13"/><verse number="14" style="v" sid="EXO 8:14"/>ግብጼ አሳይ ኡንቱንታ ሺሽ ሺሺደ ዶሬድኖ፤ ቢታይ ሄዋ ጽንቁዋን ዜኤዳ። <verse eid="EXO 8:14"/><verse number="15" style="v" sid="EXO 8:15"/>ሽን ካቲ ሸቱ ባይናዋ በኤዳ ዎደ አ ዎዛናይ ዶንጭሌዳ፤ መና ጎዳይ ኦዴዳዋዳንካ፥ እ ሙሴነ አሮነ ኦዴዳ ኦዱዋ ስሰናን እጼዳ።<verse eid="EXO 8:15"/></para>
  <para style="s1">ጩቻ</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 8:16"/>መና ጎዳይ ሄዋፐ ጉይያን፥ ሙሳ “ኔን አሮና፥ ‘ነ ጻምኣ ምጫደ፥ ቢታ ባና ሾጫ’ ያጋደ ኦዳ። ግብጼ ቢታ ኡባን ባናይ ጩቻ ከሳናዋ” ያጌዳ። <verse eid="EXO 8:16"/><verse number="17" style="v" sid="EXO 8:17"/>ኡንቱቱ ሄዋዳን ኦድኖ፤ አሮነ ጻምኣ ኦይቂደ ባረ ኩሽያ ምጪደ፤ ባረ ጻምአን ቢታ ባና ሾጭና አሳነ፥ መህያ ቦላ ጩቻይ ዬዳ። ግብጼ ጋድያን ሀ ጋጻፐ ያ ጋጻ ጋካናዉ፥ ባና ኡባይ ጩቻ ከሴዳ። <verse eid="EXO 8:17"/><verse number="18" style="v" sid="EXO 8:18"/>ሻሬቻቱካ ባረንቱ ማሹዋን ሄዋዳን ኦናዉ ባጸቴድኖ፤ ሽን ዳንዳይበይክኖ። ጩቻይ አሳ ቦላነ፥ መህያ ቦላ ኩሜዳ። <verse eid="EXO 8:18"/><verse number="19" style="v" sid="EXO 8:19"/>ሻሬቻቱ ካትያ፥ “ሀዌ ጾሳ ኦሱዋ” ያጌድኖ። ሽን ካትያ ዎዛናይ ዶንጭሌዳ፤ ጾሳይ ጌዳዋዳንካ፥ እ ኡንቱንቱ ኦድያዋ ስሰናን እጼዳ።<note caller="-" style="x"><char style="xo" closed="false">8:19 </char><char style="xt" closed="false"><ref loc="LUK 11:20">ሉቃሳ 11:20</ref></char></note><verse eid="EXO 8:19"/></para>
  <para style="s1">ዱክያ ኡዱንጽያ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 8:20"/>መና ጎዳይ ሙሳ፥ “ጉራን ደንዳደ፥ ካቲ ሻፋ ቢሽን አናና ጋከታደ ኔን አ፥ ‘መና ጎዳይ ያጌ፤ “ታዉ ኦና ማላ፥ ታ አሳ የዳ፤ <verse eid="EXO 8:20"/><verse number="21" style="v" sid="EXO 8:21"/>ኔን ታ አሳ የደናን እጾፐ፥ ታን ነ ቦላ፥ ነ ኦሳንቻቱዋ ቦላ፥ ነ አሳ ቦላነ ነ ጎለቱዋ ግዶ ኡዱንጽያ ዉድያ የዳና፤ ግብጼቱዋ ጎለንነ ኡንቱንቱ ደእያ ቢታ ኡባን ኡዱንጺ ኩማናዋ። <verse eid="EXO 8:21"/><verse number="22" style="v" sid="EXO 8:22"/>ሽን ሄ ጋላስ ታ አሳይ በተ ግዲደ ደእያ ጎሸና ጋድያን ኡዱንጺ ኩመናዳን ታን ተኣደ፥ ኡንቱንቱ ቢታ ሻካና፤ ታን መና ጎዳይ፥ ሀ ጋድያ ኡባን ደእያዋ ኔን ሄዋን ኤራና። <verse eid="EXO 8:22"/><verse number="23" style="v" sid="EXO 8:23"/>ታን ታ አሳነ ነ አሳ ሻካና፤ ሀ ዎልቃማ ማላታይ ዎንት ሀናና” ያጌ’ ያጋደ ኦዳ” ያጌዳ። <verse eid="EXO 8:23"/><verse number="24" style="v" sid="EXO 8:24"/>መና ጎዳይ ሄዋፐ ጉይያን፥ ጌዳዋዳን ኦዳ፤ ካትያ ሶንነ አ ኦሳንቻቱዋ ሶን ዳሮ ኡዱንጽያ ዉዲ ዬዳ፤ ግብጼ ጋድያ ኡባ ባይዜዳ።<verse eid="EXO 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 8:25"/>ሄ ዎደ ካቲ ሙሳነ አሮና ጼስሲደ፥ “ቢተ፤ ሀ ጋድያን ህንተንቱ ጾሳዉ ያርሽተ” ያጌዳ። <verse eid="EXO 8:25"/><verse number="26" style="v" sid="EXO 8:26"/>ሽን ሙሴ፥ “ሄዌ ልከ ግደና፤ ኑን መና ጎዳ ኑ ጾሳዉ ሺሽያ ያርሾቱ ግብጼቱዋ ሸነይያዋ ግዳናዋ፤ ኑን ኡንቱንታ ሸነይያ ያርሾቱዋ ኡንቱንቱ ጼልሽን ያርሾፐ፥ ኡንቱንቱ ኑና ሹቻን ጫድክኖ? <verse eid="EXO 8:26"/><verse number="27" style="v" sid="EXO 8:27"/>ኑን መና ጎዳ፥ ኑ ጾሳዉ፥ ያርሾቱዋ ሺሻናዉ እ ኑና አዛዝያዋዳን፥ ሄዙ ጋላሳ ኦግያ መላ ቢታ ባና ኮሼ” ያጌዳ። <verse eid="EXO 8:27"/><verse number="28" style="v" sid="EXO 8:28"/>ካቲ፥ “መና ጎዳዉ፥ ህንተንቱ ጾሳዉ፥ ህንተንቱ መላ ቢታ ቢደ ያርሻና ማላ፥ ታን ህንተንታ የዳና፤ ሽን ህንተንቱ ሃኪደ ቦፕተ፤ ታዉ ሀእ ዎስተ” ያጌዳ። <verse eid="EXO 8:28"/><verse number="29" style="v" sid="EXO 8:29"/>ሙሴ፥ “ታን ነ ማታፐ ከሶ ሳኣናካ መና ጎዳ ዎሳና፤ ሀ ኡዱንጽያ ዉዲ ዎንት ካትያፐ፥ አ ኦሳንቻቱዋፐነ አ አሳፐ ክቻናዋ። ሽን መና ጎዳዉ ያርሻናዉ አሳ የደናን እጻናዉ ካቲ ኑና ዛር ጭመና ማላ አኬኮ” ያጌዳ። <verse eid="EXO 8:29"/><verse number="30" style="v" sid="EXO 8:30"/>ሄዋፐ ጉይያን ሙሴ ካትያ ማታፐ ከሲደ፥ መና ጎዳ ዎሴዳ። <verse eid="EXO 8:30"/><verse number="31" style="v" sid="EXO 8:31"/>መና ጎዳይ ሙሴ ኦቼዳዋዳን ኦዳ፤ ኡዱንያ ካትያፐ፥ አ ኦሳንቻቱዋፐነ አ አሳፐ እቱነ አተናን ክቼዳ። <verse eid="EXO 8:31"/><verse number="32" style="v" sid="EXO 8:32"/>ሽን ሀእካ ቃይ ካትያ ዎዛናይ ዶንጭልና፥ አሳ የደናን እጼዳ።<verse eid="EXO 8:32"/></para>
  <chapter eid="EXO 8"/>
  <chapter number="9" style="c" sid="EXO 9"/>
  <para style="s1">መህያ ቦላ ቦሻይ ዎዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 9:1"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ “ግብጼ ካትያኮ ባደ፥ ‘መና ጎዳይ፥ እብራዌቱዋ ጾሳይ ኔና፥ “ኡንቱንቱ ታዉ ጎይናና ማላ ታ አሳ የዳ” ያጌ። <verse eid="EXO 9:1"/><verse number="2" style="v" sid="EXO 9:2"/>ኔን የደናን እጻደ፥ ኡንቱንታ ኦይቃ ኡትያዋ ግዶፐ፥ <verse eid="EXO 9:2"/><verse number="3" style="v" sid="EXO 9:3"/>መና ጎዳ ኩሺ ደርያን ደእያ ነ መህያ ቦላ፥ ፓራቱዋ ቦላ፥ ሀረቱዋ ቦላ፥ ጋሎቱዋ ቦላ፥ ምያ ቦላ፥ ዶርሳቱዋ ቦላነ ዴሻቱዋ ቦላ ዎልቃማ ኢታ ሀርግያ የዳና። <verse eid="EXO 9:3"/><verse number="4" style="v" sid="EXO 9:4"/>ሽን ታን መና ጎዳይ እስራኤልያ መህያ ግዱዋንነ ግብጼቱዋ መህያ ግዱዋን ሻኮታ መና። እስራኤላቱ መህያፐ እቱነ ሀይቀና’ ያጋ” ያጌዳ። <verse eid="EXO 9:4"/><verse number="5" style="v" sid="EXO 9:5"/>መና ጎዳይ ዎድያ ኬሪደ፥ “ታን ዎንት ሀዋ ሀ ጋድያ ቦላን ኦና” ያጌዳ። <verse eid="EXO 9:5"/><verse number="6" style="v" sid="EXO 9:6"/>ዎንተ ጋላስ መና ጎዳይ ሄዋ ኦዳ። ግብጼ አሳ መህያ ኡባይ ሀይቄዳ፤ ሽን እስራኤልያ አሳ መህያፐ እቱነ ሀይቂቤና። <verse eid="EXO 9:6"/><verse number="7" style="v" sid="EXO 9:7"/>ካቲ ሀ የዉዋ ፓጫናዉ አሳ ኪቲደ፥ እስራኤለቱዋ መህያፐ፥ ሀራይ አቶ፥ እቱነ ሀይቂቤናዋ ኤሬዳ። ግዶፐነ ካትያ ዎዛናይ ዶንጭሎ ሳኣፐ ስመናን እጽና፥ አሳ የደናን ድጌዳ።<verse eid="EXO 9:7"/></para>
  <para style="s1">ጺባ</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 9:8"/>ሜና ጎዳይ ሄዋፐ ጉይያን፥ ሙሳነ አሮና፥ “ህንተንቱ ኩሽያ ኩንደ ጮጭያፐ ብድን ኡጭተ፤ ሙሴ ካቲ ጼልሽን፥ ሄዋ ፑደ ጫርኮ ላሎ፤ <verse eid="EXO 9:8"/><verse number="9" style="v" sid="EXO 9:9"/>ሄዌ ግብጼ ቢታ ኡባ ቦላ ሊቆ ባና ግዳናዋ፤ ግብጼ ቢታ ኡባን አሳ ቦላነ መህያ ቦላ ጊይያ ጺባይ ዎናዋ” ያጌዳ። <verse eid="EXO 9:9"/><verse number="10" style="v" sid="EXO 9:10"/>ኡንቱንቱ ጮጭያፐ ብድን አኪደ፥ ካትያ ስንን ኤቄድኖ፤ ሙሴ ሄዋ ፑደ ጫርኩዋን ላልና፥ አሳ ቦላነ መህያ ቦላ ጊይያ ጺባይ ዎ አጌዳ።<note caller="-" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="REV 16:2">ሳፃ 16:2</ref></char></note> <verse eid="EXO 9:10"/><verse number="11" style="v" sid="EXO 9:11"/>ሻሬቻቱካ ኡንቱንቱ ቦላነ ግብጼ አሳ ኡባ ቦላ ዎዳ ጺባይ ኤሱዋ ድግና፥ ሙሴ ስንን ኤቃናዉ ዳንዳይበይክኖ። <verse eid="EXO 9:11"/><verse number="12" style="v" sid="EXO 9:12"/>ሽን መና ጎዳይ ሙሴዉ ጌዳዋዳንካ፥ ካትያ ዎዛና ዶንጭልሴዳ ድራዉ፥ ሙሴነ አሮነ ኦድያዋ ካቲ ስሰናን እጼዳ።<verse eid="EXO 9:12"/></para>
  <para style="s1">ሻቻ</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 9:13"/>ሄዋፐ ጉይያን መና ጎዳይ ሙሳ፥ “ጉራን ደንዳ ባደ፥ ካትያና ጋከታደ አ፥ ‘መና ጎዳይ፥ እብራዌቱዋ ጾሳይ ኔና፥ “ታዉ ጎይናና ማላ ታ አሳ የዳ። <verse eid="EXO 9:13"/><verse number="14" style="v" sid="EXO 9:14"/>ሄዌ ዮፐ፥ ነ ቦላ፥ ነ ኦሳንቻቱዋ ቦላነ ነ አሳ ቦላ ታ ቦሻዉ ደእያ ኩመን ዎልቃ ታን ኪታና፤ ሳኣን ኡባን ታ ማል ባይናዋ ኔን ሄዋን ኤራናሳ። <verse eid="EXO 9:14"/><verse number="15" style="v" sid="EXO 9:15"/>ታን ሀኖደ ታ ኩሽያ የዳደ፥ ኔናነ ነ አሳ ኢታ ሀርግያን ሀ ሳኣ ቦላፐ ምልጽ ኡዳናሽን። <verse eid="EXO 9:15"/><verse number="16" style="v" sid="EXO 9:16"/>ታን ኔና ታ ዎልቃ በሳናዉነ ታ ሱንይ ሳኣ ኡባ ቦላን ኦደታናዉ፥ ሄዎ ታን ኔና ካተ ኦደ ዎድ።<note caller="-" style="x"><char style="xo" closed="false">9:16 </char><char style="xt" closed="false"><ref loc="ROM 9:17">ሮመ 9:17</ref></char></note> <verse eid="EXO 9:16"/><verse number="17" style="v" sid="EXO 9:17"/>ኔን ሀእካ ኦቶረታደ፥ ታ አሳ የደናን እጻዳ። <verse eid="EXO 9:17"/><verse number="18" style="v" sid="EXO 9:18"/>ሄዋ ድራዉ፥ ታን ዎንት ሀኖደ ግብጼ ግብጼ ግዶደፐ ሀቼ ጋካናዉ ኡባካ ዎ ኤረና፥ ዳሪ ዎልቃማ ሻቻ ቡክሳና። <verse eid="EXO 9:18"/><verse number="19" style="v" sid="EXO 9:19"/>ሀእ ኔን ነ መህያነ ጋደን ነዉ ደእያዋ ኡባ ኤለካ ሶ ገልሳናዳን አዛዛ፤ አያዉ ጎፐ፥ ሶይ ገለናን ብሮ ጋደን ደእያ አሳ ኡባ ቦላነ መህያ ኡባ ቦላ ሻቻይ ዎናዋ፤ ኡንቱቱ ሀይቃና” ያጌ’ ያጋ” ያጌዳ። <verse eid="EXO 9:19"/><verse number="20" style="v" sid="EXO 9:20"/>ካትያ ኦሳንቻቱዋፐ መና ጎዳ ቃላዉ ያዬዳዋንቱ ባረንቱ አይለቱዋነ ባረንቱ መህያ ኤሌሊደ ሶይ ገልሴድኖ። <verse eid="EXO 9:20"/><verse number="21" style="v" sid="EXO 9:21"/>ሽን መና ጎዳ ቃላ ካዳዋንቱ ባረንቱ አይለቱዋነ ባረንቱ መህያ ጋደን አግ ባሼድኖ።<verse eid="EXO 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 9:22"/>ሄዋፐ ጉይያን መና ጎዳይ ሙሳ፥ “ግብጼ ቢታ ኡባ ቦላን: አሳ ቦላ፥ መህያ ቦላነ ግብጼ ጎሻቱዋን ድጭያባ ኡባ ቦላ ሻቻይ ዎናዳን፥ ነ ኩሽያ ሳሉዋ ደን” ያጌዳ። <verse eid="EXO 9:22"/><verse number="23" style="v" sid="EXO 9:23"/>ሙሴ ባረ ጋትማ ሳሉዋ ዛሪደ ደንዳ ዎደ፥ ጾሳይ ጉጉንነ ሻቻ የዴዳ፤ ዋልቃንይካ ዱገ ሳአዉ ዋልቃሜዳ። ጾሳይ ግብጼ ጋድያን ሻቻ ያት ቡክሴዳ። <verse eid="EXO 9:23"/><verse number="24" style="v" sid="EXO 9:24"/>ሻቻይ ዎዳ፤ ዋልቃንይ ያነ ሃነ ዋልቃሜዳ፤ ግብጼ ጋድያን ካቲ ካተቶደፐ ዶምና፥ ግብጼ ቢታ ኡባን ዎዳ ሻቻ ኡባፐ ሄዌ አያ ኢታ ሻቻ።<note caller="-" style="x"><char style="xo" closed="false">9:24 </char><char style="xt" closed="false"><ref loc="REV 8:7">ሳፃ 8:7</ref>፤ <ref loc="REV 16:21">16:21</ref></char></note> <verse eid="EXO 9:24"/><verse number="25" style="v" sid="EXO 9:25"/>ሄ ሻቻይ ግብጼ ቢታ ኡባ ጋደን ደእያ ኡባባ፥ አሳካ መህያካ ሾጬዳ፤ ጋደን ዶሌዳባ ኡባ ዱገ ዛሪደ ብዶዬዳ፤ ም ኡባ መንሬዳ። <verse eid="EXO 9:25"/><verse number="26" style="v" sid="EXO 9:26"/>ሻቻይ ዎቤና ጋዲ እስራኤላቱ ኡቴዳ ጎሸና ጋድያ ጻላላ።<verse eid="EXO 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 9:27"/>ካቲ ኪት ሙሳነ አሮና ጼስሲደ፥ “ሀእ ስም፥ ታን ናጋራ ኦድ፤ መና ጎዳይ ቱማንቻ፤ ታንነ ታ አሳይ ባይዛንቻ። <verse eid="EXO 9:27"/><verse number="28" style="v" sid="EXO 9:28"/>ኑዉ ጉጉንይነ ሻቻይ ዳሬዳ ድራዉ፥ መና ጎዳ ዎስተ። ታን ህንተንታ የዳና፤ ስም ሀዋፐ ስንን ህንተንቱ ሀዋን ጋምእክታ” ያጌዳ። <verse eid="EXO 9:28"/><verse number="29" style="v" sid="EXO 9:29"/>ሙሴ አ፥ “ታን ሀ ካታማፐ ከሴዳ ዎደ፥ ታን ዎሳናዉ ታ ኩሽያ መና ጎዳኮ ምጫና፤ ያቶፐ ጉጉንይ አጋናዋ፤ ቃይ ሻቻ ዎይ ኤቃና፤ ሳአይ መና ጎዳዋ ግድያዋ ኔን ሄዋን ኤራና። <verse eid="EXO 9:29"/><verse number="30" style="v" sid="EXO 9:30"/>ሽን ኔንነ ነ ኦሳንቻቱ መና ጎዳዉ ጾሳዉ ሀእካ ያየናዋ ታን ኤራይ” ያጌዳ። <verse eid="EXO 9:30"/><verse number="31" style="v" sid="EXO 9:31"/>ታልባይ ጪሼዳ ድራዉነ ባንጋይ ትሼዳ ድራዉ፥ ታልባይነ ባንጋይ ሻቻን ባዬድኖ። <verse eid="EXO 9:31"/><verse number="32" style="v" sid="EXO 9:32"/>ሽን ዛርጋይነ ሞርገ ምይ ካእያ ዎዲ ብራ ግዴዳ ድራዉ፥ ሻቻን ባይበይክኖ።<verse eid="EXO 9:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 9:33"/>ሄዋፐ ጉይያን ሙሴ ካትያ ማታፐ ደንዲደ፥ ካታማፐ ጋጻ ከሴዳ። ባረ ኩሽያ መና ጎዳኮ ምጬዳ፤ ያትና ጉጉንይነ ሻቻይ አጌዳ፤ እራይካ ቢታ ቦላን ዱገ ትገትያዌ ኤቄዳ። <verse eid="EXO 9:33"/><verse number="34" style="v" sid="EXO 9:34"/>ሽን ካቲ እራይ፥ ሻቻይነ ጉጉንይ አጌዳዋ በኤዳ ዎደ ዛሪደካ ናጋራ ኦዳ፤ እካ አ ኦሳንቻቱካ ባረንቱ ዎዛና ዶንጭልሴድኖ። <verse eid="EXO 9:34"/><verse number="35" style="v" sid="EXO 9:35"/>መና ጎዳይ ሙሴ ዶናን ሃሳዬዳዋዳንካ ካትያ ዎዛናይ ዶንጭልና፥ እስራኤላቱዋ እ የደናን እጼዳ።<verse eid="EXO 9:35"/></para>
  <chapter eid="EXO 9"/>
  <chapter number="10" style="c" sid="EXO 10"/>
  <para style="s1">ቦልያ</para>
  <para style="p">
    <verse number="1-2" style="v" sid="EXO 10:1-2"/>ሄዋፐ ጉይያን ሙሳ መና ጎዳይ ሀዋዳን ያጌዳ፤ “ግብጼ ካትያኮ ባ፤ አያዉ ጎፐ፥ ታን ግብጼቱዋ ግዶን ማላነ ዎልቃማ ማላታ ታ ዎታ ኦደንቶ ህንተንቱ ህንተንቱ ናናዉነ ህንተንቱ ናና ናናቶ ኦዳና ማላ፥ ቃይ ህንተንቱካ ታን መና ጎዳ ግድያዋ ኤራና ማላ፥ ታ ዎልቃማ ማላታ ኡንቱንቱ ግዶን ኦናዉ አ ዎዛናነ አ ኦሳንቻቱዋ ዎዛና ታን ዶንጭልሳ ዎድ” ያጌዳ።<verse eid="EXO 10:1-2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 10:3"/>ሙሴነ አሮነ ካትያኮ ገሊደ አ፥ “መና ጎዳይ፥ እብራዌቱዋ ጾሳይ ኔና ሀዋዳን ያጌ፤ ‘ኔን ታዉ አዛዘተናን አዉደ ጋካናዉ እጻይ? ታዉ ጎይናና ማላ ታ አሳ የዳ። <verse eid="EXO 10:3"/><verse number="4" style="v" sid="EXO 10:4"/>ኔን ኡንቱንታ የደናን እጾፐ፥ ነ ቢታ ቦላ ታን ዎንት ቦልያ አሀና፤ <verse eid="EXO 10:4"/><verse number="5" style="v" sid="EXO 10:5"/>ቦሊ ኦንነ ቢታ ደማናዉ ዳንዳየናዳን ቢታ ካማናዋ። ህንተንቶ ሻቻፐ አቴዳ ጉባ፥ ጋደን ድጭያ ምይካ አተናን ኡባ ማናዋ። <verse eid="EXO 10:5"/><verse number="6" style="v" sid="EXO 10:6"/>ነ ጎለን ነ ሱንቱዋ ጎለንነ ግብጼ አሳ ኡባ ጎለን ኡንቱንቱ ኩማናዋንታ፤ ሄዌ ነ አዎቱዋ፥ ዎይ ነ ማይዛ አዎቱ ሀ ቢታን ኡቶደፐ ሀኖ ጋካናዉ ሙለ በእቤናባ’ ያጌ” ያጌድኖ። ሄዋፐ ጉይያን ሙሴ ካትያ ስንፐ ከሲደ ቤዳ።<verse eid="EXO 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 10:7"/>ካትያ ሱንቱ ካትያ፥ “ሀ ብታኒ ኑዉ አዉደ ጋካናዉ መቱዋ ጋሶ ግዳናዌ? ኡንቱንቱ መና ጎዳዉ፥ ባረንቱ ጾሳዉ፥ ጎይናና ማላ፥ ኔን አሳ የዳ፤ ግብጼ ቢታይ ባዬዳዋ ኔን ሀእካ አኬክኪ?” ያጌድኖ። <verse eid="EXO 10:7"/><verse number="8" style="v" sid="EXO 10:8"/>ሄዋ ድራዉ፥ ካቲ ሙሳነ አሮና ጉየ ዛሪደ፥ “ቢተ፤ መና ጎዳዉ፥ ህንተንቱ ጾሳዉ ጎይንተ፤ ሽን ብያዋንቱ ኦና ኦኔ?” ያጌዳ።<verse eid="EXO 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 10:9"/>ሙሴ፥ “ኑን ኑ ጭማ አሳነ ኑ ጉ ናናቱዋና፥ ኑ ዶርሳ ዉደቱዋናነ ሚዛ ዉደቱዋና እትፐ ባና፤ አያዉ ጎፐ፥ ኑን ብያሳን መና ጎዳ ባላ ቦንቻናዉ ኮሼ” ያጌዳ።<verse eid="EXO 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 10:10"/>ካቲ፥ “ታን ህንተንታ ህንተንቱ ናናነ ህንተንቱ ማቼቱዋ የድያዋ ግዶፐ፥ መና ጎዳይ ህንተንታ ናጋናዉ ኮሼ። ሽን በእተ፤ ህንተንቱ ህንተንቱ ዎዛናን ኢታባ ቆፔዳዌ ቆንጭያን ኤረቴ። <verse eid="EXO 10:10"/><verse number="11" style="v" sid="EXO 10:11"/>ቱይት፥ ህንተንቱ፥ ‘ጾሳዉ ጎይናና’ ጊደ ኦችያዋ ግዶፐ፥ አቱማ አሳ ጻላላይ ቢደ መና ጎዳዉ ጎይንተ” ያጌዳ። ሄዋፐ ጉይያን ሙሰነ አሮነ ካትያ ስንፐ የደርሰቲደ ከሴድኖ።<verse eid="EXO 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 10:12"/>መና ጎዳይ ሙሳ፥ “ቦሊ ግብጼ ጋድያን ከሳናዳን፥ ሻቻፐ አቲደ ጋደን ድጭያባ ኡባ ልምእ ኦና ማላ፥ ነ ኩሽያ ግብጼ ጋድያ ቦላን ምጫ” ያጌዳ።<verse eid="EXO 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 10:13"/>ሙሴ ባረ ጋትማ ግብጼ ጋድያ ቦላን ምጭና፥ መና ጎዳይ አዋይ ዶልያ ባጋ ጫርኩዋ ሄ ጋላሳነ ቃማ ኡባ ሄ ጋድያ ቦላን ጫርክሴዳ፤ ዎንቴዳ ዎደ ሄ ጫርኩ ቦልያ አሄዳ። <verse eid="EXO 10:13"/><verse number="14" style="v" sid="EXO 10:14"/>ቦሊ ግብጼ ቢታ ኡባ ቦላ ሻምእ ጊደ፥ ቢታ ኡባ ሳን ከስ ኡቴዳ። ሀዋ ኬሻ ቦልያ ቦሻይ ሄ ቢታን ሀዋፐ ካሰና ሀንቤና፤ ዎይ ሀዋፐ ስንዉነ ዛረደ ሀነና።<note caller="-" style="x"><char style="xo" closed="false">10:14-15 </char><char style="xt" closed="false"><ref loc="REV 9:2-3">ሳፃ 9:2-3</ref></char></note> <verse eid="EXO 10:14"/><verse number="15" style="v" sid="EXO 10:15"/>ቢታይ ካረጻና ጋካናዉ ቦሊ ቢታ ኡባ ካሜዳ። ሄ ቦሊ ሻቻፐ አቲደ ጋደን ድጭያባ ኡባነ ም ቦላን ደእያ አይፍያ ኡባ ምልጽ ኦዳ። ያትና ም ቦላን እርጻ ሀይይ፥ ዎይ ጋደን አታክልቲ ግብጼ ቢታ ኡባን አያይነ አትቤና።<verse eid="EXO 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 10:16"/>ካቲ ሙሳነ አሮና ኤለካ ጼስሲደ፥ “መና ጎዳ ህንተንቱ ጾሳነ ህንተንታ ታን ናቃድ፤ <verse eid="EXO 10:16"/><verse number="17" style="v" sid="EXO 10:17"/>ስም ህንተንቱ ታዉ ታ ናጋራ ሀ እት ገደ ጻላላዉ አቶ ጊተ፤ ሀ ዎያ ቦሻ ታፐ ድጋና ማላ፥ መና ጎዳ ህንተንቱ ጾሳ ዎስተ” ያጌዳ።<verse eid="EXO 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 10:18"/>ሙሴ ካትያ ማታፐ ከሲደ፥ መና ጎዳ ዎስና፤ <verse eid="EXO 10:18"/><verse number="19" style="v" sid="EXO 10:19"/>መና ጎዳይ ሄ ጫርኩዋ አዋይ ዉልያ ባጋ ዎልቃማ ጫርኮ ላምና ቦልያ ቶክ፥ ዞኦ አባኮ አፌዳ። ግብጼ ቢታ ኡባን እት ቦሊነ አትቤና። <verse eid="EXO 10:19"/><verse number="20" style="v" sid="EXO 10:20"/>ግዶፐነ፥ መና ጎዳይ ካትያ ዎዛና ዶንጭልሴዳ ድራዉ፥ እስራኤላቱዋ የደናን እጼዳ።<verse eid="EXO 10:20"/></para>
  <para style="s1">ባራ ማ</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 10:21"/>መና ጎዳይ ሙሳ፥ “ግብጼ ጋድያን አሳይ ቦች በአናዉ ዳንዳይያ ኬሻ ማይ ማና ማላ፥ ነ ኩሽያ ሳሉዋ ደን” ያጌዳ። <verse eid="EXO 10:21"/><verse number="22" style="v" sid="EXO 10:22"/>ሙሴ ባረ ኩሽያ ሳሉዋ ደንዳ፤ ግብጼ ቢታ ኡባን ሄዙ ጋላሳ ኩመን ባራ ማይ ሜዳ።<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="PSA 105:28">ማዝ. 105:28</ref>፤ <ref loc="REV 16:10">ሳፃ 16:10</ref></char></note> <verse eid="EXO 10:22"/><verse number="23" style="v" sid="EXO 10:23"/>ሄ ሄዙ ጋላሳቱዋን አሳይ ኦንነ እቱ እቱዋ በኤናን፥ ዎይ ባረ ሳኣፐ ደንዲደ ቤናን ታኬዳ። ሽን እስራኤለቱ ደእያ ሳኣን ኡባን ኡንቱንቶ ፖኡ ደኤ። <verse eid="EXO 10:23"/><verse number="24" style="v" sid="EXO 10:24"/>ካቲ ሙሳ ጼስሲደ፥ “ቢተ፤ መና ጎዳዉ ጎይንተ፤ ህንተንቱ ማቼቱካ ህንተንቱ ናናይካ ህንተናና ባናዉ ዳንዳዪኖ። ህንተንቱ ዶርሳ ዉድያነ ህንተንቱ ሚዛ ዉድያ ጻላላ የጊደ ቢተ” ያጌዳ። <verse eid="EXO 10:24"/><verse number="25" style="v" sid="EXO 10:25"/>ሽን ሙሴ አ፥ “ኑን ያርሹዋነ ጹጊደ ያርሽያ ያርሹዋ መና ጎዳ፥ ኑ ጾሳዉ፥ ሺሻናዉ፥ መህያ ኑዉ እማደ የድያዌ ኔና ጉሳካ? <verse eid="EXO 10:25"/><verse number="26" style="v" sid="EXO 10:26"/>ኑ መሂ ኡባይካ ኑናና ባናዉ ኮሼ፤ ቅንጫፍለ እቱነ ጉየ አተና። መና ጎዳ፥ ኑ ጾሳዉ፥ ጎይንያ ጎይናዉ ሄ መህያፐ ዶሪደ አካናዉ ኮሼ፤ ኑን ያ ጋከናን ደኢደ፥ መህያፐ ሀቃዋ ሀቃዋ መና ጎዳዉ ያርሻነንቶ ኤራናዉ ዳንዳዮኮ” ያጌዳ። <verse eid="EXO 10:26"/><verse number="27" style="v" sid="EXO 10:27"/>ሽን መና ጎዳይ ካትያ ዎዛና ዶንጭልስና እ ኡንቱንታ የዳናዉ ኮይቤና። <verse eid="EXO 10:27"/><verse number="28" style="v" sid="EXO 10:28"/>ሄዋፐ ጉይያን ካቲ ሙሳ፥ “ታ ማታፐ ክቻ! ላኤን ታ ስንን ለምእ ጋደ ኔና ኤራ! ኔን ታ አይፍያ ታ ዴሙዋ በኤዳ ጋላሳይካ ነዉ ሀይቆ” ያጌዳ። <verse eid="EXO 10:28"/><verse number="29" style="v" sid="EXO 10:29"/>ሙሴ አ፥ “ቱማካ፤ ኔን ጌዳዋዳን ታን ኔና ላኤን ኡባካ በእከ” ያጌዳ።<verse eid="EXO 10:29"/></para>
  <chapter eid="EXO 10"/>
  <chapter number="11" style="c" sid="EXO 11"/>
  <para style="s1">ባይራ የለቴዳዋንቱ ቦላ ዬዳ ቦሻ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 11:1"/>ሙሴዉ መና ጎዳይ፥ “ታን ግብጼ ካትያ ቦላነ አ አሳ ቦላ እት ሀራ ቦሻ የዳና፤ ሄዋፐ ጉይያን እ ህንተንታ ሀ ጋድያፐ ከስ የዳናዋ፤ እ ህንተንታ እቱነ አተናን ኡባካ የደርሳናዋ። <verse eid="EXO 11:1"/><verse number="2" style="v" sid="EXO 11:2"/>እስራኤልያ አሳይ፥ ማጫዌ አቱማዌ ባረ ሾሮቱዋፐ ብራፐነ ዎርቃፐ መቴዳ ሚሻቱዋ ኦቻና ማላ፥ ኡንቱንቶ ኦዳ” ያጌዳ። <verse eid="EXO 11:2"/><verse number="3" style="v" sid="EXO 11:3"/>መና ጎዳይ እስራኤልያ አሳቱ ግብጼቱዋ ስንን ናሸታናዳን ኦዳ። ቃይ ሙሴ ባረ ሁጲያዉካ ግብጼ ጋድያን ካትያ ኦሳንቻቱዋንነ አሳን ሎይ ዳሮ ቦንቼቴዳ አሳዳን ጼለቴዳ።<verse eid="EXO 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 11:4"/>ሙሴ ካትያ ሀዋዳን ያጌዳ፤ “መና ጎዳይ ሀዋዳን ያጌ፤ ‘ቃማ ግዶ ብላህያን ታን ግብጼ ግዱዋና አና፤ <verse eid="EXO 11:4"/><verse number="5" style="v" sid="EXO 11:5"/>ግብጼ ጋድያን ደእያ ባይራ አቱማ ናናይ ኡባይ፥ ካዉተ ኦይድያን ኡትያ ካትያ ባይራ ናኣፐ ዶሚደ፥ ዎጻን ጋጭያ ቆማት ባይራ ናኣ ጋካናዉ ባይራ የለቴዳ መሂካ አተናን ኡባይ ሀይቃናዋ። <verse eid="EXO 11:5"/><verse number="6" style="v" sid="EXO 11:6"/>ግብጼ ቢታ ኡባን ሀዋፐ ካሰ ባጋን ሀንቤናነ ስንፐካ ሀነና ዎልቃማ ዬኩ ዬከታናዋ። <verse eid="EXO 11:6"/><verse number="7" style="v" sid="EXO 11:7"/>ሽን እስራኤላቱ ግዱዋን፥ አሳ ቦላ ዎይ መህያ ቦላ ካናይነ ቦጨና’ ያጌ። ሄ ዎደ መና ጎዳይ ግብጼቱዋንነ እስራኤልያ ግዱዋን ሻኮታ መያዋ ኔን ኤራናሳ። <verse eid="EXO 11:7"/><verse number="8" style="v" sid="EXO 11:8"/>ሀ ነ ኦሳንቻቱ ኡባይ ታኮ ዪደ፥ ታ ስንን ጉፋን ጎይኒደ፥ ‘ከሳደ ባርኪ! ኔና ካልያ አሳይ ኡባይካ ቦ!’ ጋናዋንታ። ሄዋፐ ጉይያን ታን ባና” ያጌዳ። ሄዋፐ ጉይያን ሙሴ ሀንቁዋን ኤጸቲደ፥ ካትያ ስንፐ ከሲደ ቤዳ።<verse eid="EXO 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 11:9"/>ሙሴዉ መና ጎዳይ ኮይሮ፥ “ታ ማላልስያ ማላታይ ግብጼ ጋድያን ዳራና ማላ፥ ካቲ ህንተንቱ ኦድያዋ ስሰናን እጻናዋ” ያግ ዎዳ። <verse eid="EXO 11:9"/><verse number="10" style="v" sid="EXO 11:10"/>ሙሴነ አሮነ ሀ ማላልስያ ማላታ ኡባ ካትያ ስንን ኦድኖ፤ ሽን መና ጎዳይ ካትያ ዎዛና ዶንጭልሴዳ፤ ያትና እ እስራኤላቱዋ ባረ ጋድያፐ የደናን እጼዳ።<verse eid="EXO 11:10"/></para>
  <chapter eid="EXO 11"/>
  <chapter number="12" style="c" sid="EXO 12"/>
  <para style="s1">ፓስጋነ ግብጼፐ ከሱሳ</para>
  <para style="r">(<ref loc="EXO 12:1-15:21">12:1—15:21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 12:1"/>መና ጎዳይ ግብጼ ጋድያን ሙሳነ አሮና ሀዋዳን ያጌዳ፤<note caller="-" style="x"><char style="xo" closed="false">12:1-13 </char><char style="xt" closed="false"><ref loc="LEV 23:5">ዎጋ 23:5</ref>፤ <ref loc="NUM 9:1-5">ፓይ. 9:1-5</ref>፤ <ref loc="NUM 28:16">28:16</ref>፤ <ref loc="DEU 16:1-2">ዛረ. 16:1-2</ref></char></note> <verse eid="EXO 12:1"/><verse number="2" style="v" sid="EXO 12:2"/>“ሀ አግናይ ህንተንቶ ላይዉ ኮይሮ አግና ግዶ፤ <verse eid="EXO 12:2"/><verse number="3" style="v" sid="EXO 12:3"/>እስራኤልያ አሳዉ ኡባዉ ሀዋ ኦድተ፤ ሀ አግናይ ገሌዳ ታማን ጋላሳን፥ እት አሳይ ባረ ሶይ አሳዉ እት ኮልያ ዶርሳ ዎይ እት ኮልያ ዴሻ አሆ። <verse eid="EXO 12:3"/><verse number="4" style="v" sid="EXO 12:4"/>ሄ ጎለ አሳ ፓይዱ ሄ ዶርሳ ዉርስ ማናዉ ጉጾፐ፥ እነ አዉ ኡባፐ ማታትያ ሾሩ ባረንቱ ሶ አሳ ፓይዲደ እት እት አሳይ ማናዉ ዳንዳይያ ኬሻ አኬኪደ፥ ሄ መህያ ሹኪደ እትፐ ሚኖ። <verse eid="EXO 12:4"/><verse number="5" style="v" sid="EXO 12:5"/>ህንተንቱ ዶር አክያ መሂ የለቶደፐ እት ላይ ግዴዳዋ፥ አ ቦላን አይ ፓጫይነ ባይና አቱማዋ ግዶ። ህንተንቱ ዶርሳፐ ዎይ ዴሻፐ አካናዉ ዳንዳዪታ። <verse eid="EXO 12:5"/><verse number="6" style="v" sid="EXO 12:6"/>ሀ አግናዉ ታማነ ኦይደን ጋላሳ ጋካናዉ ኡንቱንታ ሄምተ፤ ሄ ጋላስ ኦማርስ እስራኤልያ አሳይ ኡባይ ኡንቱንታ ሹካናዉ ኮሼ። <verse eid="EXO 12:6"/><verse number="7" style="v" sid="EXO 12:7"/>ያቲደ ሱፐ አማሬዳዋ አኪደ፥ ኡንቱንቱ ምያ ጎለዉ ላኡ ማቃንያነ ጉባንያ ኦክኖ፤ <verse eid="EXO 12:7"/><verse number="8" style="v" sid="EXO 12:8"/>አሹዋ ሄ ጋላስ ቃማ ታማን ጺጽ ጺጺደ፥ ጫምያ ቦንጭያናነ ኡኬዳ ኡክና ሚኖ። <verse eid="EXO 12:8"/><verse number="9" style="v" sid="EXO 12:9"/>አሹዋ ቃይያ ዎይ ዶይሲደ ሞፕተ፤ ሁጲያካ ገደቱዋካ ቃን ግዶ አሹዋካ ኡባ ቃንጸናን ሙምያ ጺጽተ፤ <verse eid="EXO 12:9"/><verse number="10" style="v" sid="EXO 12:10"/>ሄ አሹዋፐ ሳአይ ዎንታና ጋካናዉ አይነ አሾፕተ፤ ሽን አማሬዳዌ አቶፐ፥ ሄዋ ጹጋናዉ ኮሼ። <verse eid="EXO 12:10"/><verse number="11" style="v" sid="EXO 12:11"/>ሙሳ ሚደ፥ ኦግያዉ ጊግያ ማዩዋ ማዪደ፥ ህንተንቱ ጫማ ህንተንቱ ገድያን ዎደ፥ ህንተንቱ ጋትማ ህንተንቱ ኩሽያን ኦይቂደ ሚታ። ኤሌል ኤሌል ሚተ፤ ሀዌ መና ጎዳ ፓስጋ።<verse eid="EXO 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 12:12"/>“ታን ሄ ጋላስ ቃማና ግብጼን አደ ባይራ የለቴዳ ኡባ፥ አሳካ፥ መህያካ ዎና፤ ግብጼ ኤቃቱዋ ኡባ ቦላካ ታን ፕርዳና፤ ታን መና ጎዳቴ። <verse eid="EXO 12:12"/><verse number="13" style="v" sid="EXO 12:13"/>ሄ ሱይ ህንተንቱ ደእያ ጎልያ ኤርስያ ማላ ግዳናዋ። ታን ሄ ሱ በኦ ዎደ፥ ህንተንታ አጋደ አና፤ ታን ግብጼ ጋድያ ቦሻን ሾጭያ ዎደ፥ ህንተንታ አይ ቦሻይካ ቦቼና።<verse eid="EXO 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 12:14"/>“ሀ ጋላሳይ ህንተንቶ ቆፕ ቆፕ ቦንችያ ጋላሳ ግዶ፤ ህንተንቱ የለታይ ኡባይ መና ጎዳ ባላ ቦንችተ፤ ሀዋ ዎጋ ኦደ ኡባ ዎደ ቦንችተ።<note caller="-" style="x"><char style="xo" closed="false">12:14-20 </char><char style="xt" closed="false"><ref loc="EXO 23:15">ከሳ 23:15</ref>፤ <ref loc="EXO 34:18">34:18</ref>፤ <ref loc="LEV 23:6-8">ዎጋ 23:6-8</ref>፤ <ref loc="NUM 28:17-25">ፓይ. 28:17-25</ref>፤ <ref loc="DEU 16:3-8">ዛረ. 16:3-8</ref></char></note><verse eid="EXO 12:14"/></para>
  <para style="s1">እርሹ ገልቤና ኡክ ባላ</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 12:15"/>“ላፑን ጋላሳይ ጋካናዉ እርሹዋ የግቤና ኡክ ሚተ፤ ሽን ኮይሮ ጋላስ እርሹዋ ህንተንቱ ሶፐ ድግተ። ሄ ኮይሮ ጋላሳፐ ዶሚደ ላፑን ጋላስ ጋካናዉ፥ እርሹዋና ደእያ ኡክ ምያ አሳይ እስራኤልያ አሳ ግዶፐ ቦሄቶ።<note caller="+" style="f"><char style="fr" closed="false">12:15 </char><char style="fk" closed="false">ቦሄቶ፦ </char><char style="ft" closed="false">ግያዌ ሀይቁዋካ በሴ።</char></note> <verse eid="EXO 12:15"/><verse number="16" style="v" sid="EXO 12:16"/>ኮይሮ ጋላስ ጌሻ ሽቁዋ ሺቅተ፤ ሀራ ጌሻ ሽቁዋ ቃይ ላፑን ጋላሳን ሺቅተ፤ አሳይ ማናዉ ቁማ ካናዋፐ አትና፥ ሀ ጋላሳ ኡባን አይነ ኦፕተ፤ ህንተንቱ ኦናባይ ሄዋ ጻላላ።<verse eid="EXO 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 12:17"/>“እርሹ ገልቤና ኡክ ባላ ቦንችተ፤ አያዉ ጎፐ፥ ታን ህንተንቱ ጩጉዋ ግብጼ ጋድያፐ ከሴዳዌ ሄ ጋላሳና። ሄ ጋላሳ፥ የለታፐ የለታይ ጋካናዉ ፕን ከስያ ዎጋ ኦደ ቦንችተ። <verse eid="EXO 12:17"/><verse number="18" style="v" sid="EXO 12:18"/>ኮይሮ አግናን፥ ሄ አግናዉ ታማነ ኦይደን ጋላሳ ኦማርሳፐ ዶሚደ፥ ላታማነ እተንዋ ኦማርስ ጋካናዉ እርሹ ገልቤና ኡክ ሚተ። <verse eid="EXO 12:18"/><verse number="19" style="v" sid="EXO 12:19"/>ላፑን ጋላሳይ ጋካናዉ እርሹ ህንተንቱ ሶን ቤቶፖ፤ እርሹ ገሌዳዋ ምያ አሳይ በተ ግድና ዎይ ሄ ቢታ አሳ ግድና፥ እስራኤልያ ግዶፐ ቦሄቶ። <verse eid="EXO 12:19"/><verse number="20" style="v" sid="EXO 12:20"/>እርሹ ገሌዳዋ አያነ ሞፕተ፤ ህንተንቱ ደእያ ሳኣን ሀቃንካ እርሹ ገልቤና ኡክ ማናዉ ኮሼ” ያጌዳ።<verse eid="EXO 12:20"/></para>
  <para style="s1">ኮይሮ ፓስጋ</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 12:21"/>ሄዋፐ ጉይያን ሙሴ እስራኤልያ ጭማቱዋ ኡባ ጼስሲደ ኡንቱንታ ሀዋዳን ያጌዳ፤ “ህንተንቱ ኤለካ ቢደ፥ ህንተንቱ ሶ አሳዉ ፓስጋዉ ኮልያ፥ ዶርሳ ዎይ ዴሻ ሹክተ። <verse eid="EXO 12:21"/><verse number="22" style="v" sid="EXO 12:22"/>ህሶጵያ ጌተትያ ሀይፐ ዳንክ አኪደ፥ ከርያን ደእያ ሱን ናቂ ከሲደ፥ ሄ ሱ ላኡ ማቃንያንነ ጉባንያ ኦክተ፤ ህንተንቱፐ እት አሳይነ ሳአይ ዎንታና ጋካናዉ ባረ ጎልያ ፐንግያፐ ካረ ከሶፖ። <verse eid="EXO 12:22"/><verse number="23" style="v" sid="EXO 12:23"/>መና ጎዳይ ግብጼቱዋ ሾጭ ዎናዉ ሄ ቢታና አያ ዎደ፥ ሱ ጉባንያንነ ላኡ ማቃንያን በአና፤ ያቲደ ካረና አና፤ ዎያዌ ህንተንቱ ሶ ገሊደ፥ ህንተንታ ዎናዳን አ ህንተንቱ ሶ ገልሰና።<note caller="-" style="x"><char style="xo" closed="false">12:23 </char><char style="xt" closed="false"><ref loc="HEB 11:28">እብራ. 11:28</ref></char></note> <figure style="fig" alt="Hyssop" file="HK00114B.TIF" size="col" ref="12:22">ህሶጲያ</figure><verse eid="EXO 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 12:24"/>“ህንተንቱ ሀ አዛዙዋ ህንተንቶነ ህንተንቱ ዘረዉ ኡባ ዎደ ዎጋ ኦደ አዛዘትተ። <verse eid="EXO 12:24"/><verse number="25" style="v" sid="EXO 12:25"/>መና ጎዳይ ካሰ እማና ጌዳዋዳን እ እምያ ቢታ ህንተንቱ ገልያ ዎደ፥ ሀ ዎጋ ናግተ። <verse eid="EXO 12:25"/><verse number="26" style="v" sid="EXO 12:26"/>ህንተንቱ ናናይ ህንተንታ፥ ‘ሀ ቦንቾ ባላ ብርሸይ አዬ?’ ያጊደ ኦችያ ዎደ፥ <verse eid="EXO 12:26"/><verse number="27" style="v" sid="EXO 12:27"/>ህንተንቱ ኡንቱንታ፥ ‘ሀዌ ጾሳ ቦንቻናዉ ያርሽያ ፓስጋ ያርሹዋ፤ አያዉ ጎፐ፥ መና ጎዳይ ግብጼ ጋድያን እስራኤልያ አሳ ጎልያ አግ አ ቢደ፥ ግብጼቱዋ ዎደ፥ ኑና አሼዳ ድራሳ’ ያግተ” ያጌዳ።</para>
  <para style="p" vid="EXO 12:27">ሄዋፐ ጉይያን አሳይ ጉልባቲደ ጎይኔዳ። <verse eid="EXO 12:27"/><verse number="28" style="v" sid="EXO 12:28"/>እስራኤላቱ መና ጎዳይ ሙሳነ አሮና አዛዜዳዋዳን ኦድኖ።<verse eid="EXO 12:28"/></para>
  <para style="s1">ግብጼቱዋ ባይራ የለታቱ ሀይቂ ዉሮባ</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 12:29"/>ቃማ ግዶ ብላህያን መና ጎዳይ ግብጼን ባይራ የለቴዳ ኡባ፥ ካዉተ ኦይድያን ኡቴዳ ካትያ ባይራ ናኣፐ ዶሚደ፥ ቃሾ ጎለን ደእያ ኦሞደቴዳዋንቱ ባይራ ናኣ ጋካናዉ፥ ቃይ ባይራ የለቴዳ መህያ ኡባ ድፕ ኦዳ።<note caller="-" style="x"><char style="xo" closed="false">12:29 </char><char style="xt" closed="false"><ref loc="EXO 4:22-31">ከሳ 4:22-31</ref></char></note> <verse eid="EXO 12:29"/><verse number="30" style="v" sid="EXO 12:30"/>ካቲ፥ አ ኦሳንቻቱ ኡባይነ ግብጼ ጋድያ አሳይ ኡባይ ቃማ ደንዴድኖ። ግብጼ ጋድያን አሳይ ሀይቂቤና ጎሊ ኡባካ ባይና ድራዉ፥ አሳይ ኮሻ ቁ ኦደ ዎልቃማ ዬኩዋ ዬኬዳ። <verse eid="EXO 12:30"/><verse number="31" style="v" sid="EXO 12:31"/>ሄ ጋላስ ቃማ ካቲ ሙሳነ አሮና ጼሲደ፥ “ደንድተ! ህንተካ እስራኤልያ አሳይካ ታ አሳ ግዱዋፐ ከስ ቢደ ህንተንቱ ኦቼዳዋዳንካ መና ጎዳዉ ጎይንተ! <verse eid="EXO 12:31"/><verse number="32" style="v" sid="EXO 12:32"/>ህንተንቱ ጌዳዋዳንካ ህንተንቱ ዶርሳ ዉድያነ ህንተንቱ መህያ ዉድያ አኪደ ቢተ! ቃይ ታዉካ ዎስተ” ያጌዳ።<verse eid="EXO 12:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 12:33"/>ግብጼ አሳይ እስራኤላቱ ጋድያፐ ኤለካ ከሳና ማላ ድርቢሴድኖ። አያዉ ጎፐ፥ ኡንቱንቱ፥ “ሄዌ ዮፐ፥ ኑን ኡባይካ ዉሬቶ” ያጌድኖ። <verse eid="EXO 12:33"/><verse number="34" style="v" sid="EXO 12:34"/>ሄዋ ድራዉ፥ እስራኤልያ አሳቱ ባረንቱ እርሹ ገልቤና ሙናቃ ከርያን ኩንደ፥ ባረንቱ ማዩዋን ጻጺደ፥ ሀሽያን ቶኬድኖ። <verse eid="EXO 12:34"/><verse number="35" style="v" sid="EXO 12:35"/>እስራኤለቱ ሙሴ ኡንቱንታ አዛዜዳዋዳን፥ ግብጼቱዋ ብራ ሚሻቱዋ፥ ዎርቃ ሚሻቱዋነ ማዩዋ፥ “እምተ” ጊደ ኦቼድኖ።<note caller="-" style="x"><char style="xo" closed="false">12:35-36 </char><char style="xt" closed="false"><ref loc="EXO 3:21-22">ከሳ 3:21-22</ref></char></note> <verse eid="EXO 12:35"/><verse number="36" style="v" sid="EXO 12:36"/>መና ጎዳይ ግብጼቱዋ ስንን ሄ አሳይ ሳበታናዳን ኦና፥ ግብጼቱ ኡንቱንቱ ኦቼዳዋ እሜድኖ። ሄዋዳን ያቲደ ኡንቱንቱ ግብጼ አሳቱዋ ማጹዋ ቦንቂ አኪደ ቤድኖ።<verse eid="EXO 12:36"/></para>
  <para style="s1">እስራኤላቱ ግብጼፐ ከሴድኖ</para>
  <para style="p">
    <verse number="37" style="v" sid="EXO 12:37"/>እስራኤላቱ ራምሳ ጌተትያ ካታማፐ ደንዲደ ሱኮታ ጌተትያ ሳኣ ገድያን ሀመቲደ ቤድኖ። አሳይ ናናነ ማጫዋንታ ጉጀናን ፓይድና፥ ኡሱፑን ጼቱ ሻአ። <verse eid="EXO 12:37"/><verse number="38" style="v" sid="EXO 12:38"/>ቃይ ኡንቱንቱና ሀራ ዳሮ አሳይ፥ ዳሮ መሂነ ዶርሳ ዴሻ ዉዲ ላገቲደ ቤዳ። <verse eid="EXO 12:38"/><verse number="39" style="v" sid="EXO 12:39"/>ግብጼፐ ኡንቱንቱ አኪደ ከሴዳ ሙናቃ እርሹ ገልቤና ኡክ ኡኬድኖ፤ አያዉ ጎፐ፥ ኡንቱንቱ ግብጼፐ ድርባን ከሴድኖ፤ ባረንቶ ሽንቃ ካናዉካ፥ ሙናቃይ ደንድና ኡካናዉካ ኡንቱንታ ጋቤና።<verse eid="EXO 12:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="EXO 12:40"/>እስራኤላቱ ግብጼ ጋድያን ደኤዳ ላይይ ኦይዱ ጼታነ ሀታማ።<note caller="-" style="x"><char style="xo" closed="false">12:40 </char><char style="xt" closed="false"><ref loc="GEN 15:13">ዶመ 15:13</ref>፤ <ref loc="GAL 3:17">ጋላ. 3:17</ref></char></note> <verse eid="EXO 12:40"/><verse number="41" style="v" sid="EXO 12:41"/>ሄ ኦይዱ ጼታነ ሀታሙ ላይይ ዉርያ ሄ ዉርሰ ጋላሳን፥ መና ጎዳ ጩጉ ኡባይ ግብጼ ጋድያፐ ከሴዳ። <verse eid="EXO 12:41"/><verse number="42" style="v" sid="EXO 12:42"/>መና ጎዳይ ባረ አሳ ናጊደ፥ ግብጼ ጋድያፐ ከስያ ዎደ ሳአይ ቃማ፤ ሄ ቃማይ የለታፐ የለታ ጋካናዉ፥ እስራኤልያ አሳይ ቤጎቲደ ናጊደ አቅያ፥ መና ጎዳዉ ዱማቴዳ ቃማ።<verse eid="EXO 12:42"/></para>
  <para style="s1">ፓስጋ ጋላሳ ቦንችያ ዎጋ</para>
  <para style="p">
    <verse number="43" style="v" sid="EXO 12:43"/>መና ጎዳይ ሙሳነ አሮና፥ “ፓስጋ ጋላሳ ቦንችያ ዎጋይ ሀዋ፤ በተ አሳይ አፐ ኡባካ ሞፖ። <verse eid="EXO 12:43"/><verse number="44" style="v" sid="EXO 12:44"/>ህንተንቱ ሻሉዋን ሻሜዳ አይሊ ህንተንቱ አ ቃጻሮዋፐ ጉይያን አፐ ሞ። <verse eid="EXO 12:44"/><verse number="45" style="v" sid="EXO 12:45"/>ሽን እማተን ህንተናና ጋምእያ እማይነ ከራ ኦያ እማይ አፐ ኡባካ ሞፖ።<verse eid="EXO 12:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="EXO 12:46"/>“ሀ ፓስጋ ህንተንቱ እት ጎለን ሚተ፤ ህንተንቱ ሄ አሹዋፐ አያነ ካረ ከሶፕተ። መቀቱዋፐ እቱዋነ መንፕተ።<note caller="-" style="x"><char style="xo" closed="false">12:46 </char><char style="xt" closed="false"><ref loc="NUM 9:12">ፓይ. 9:12</ref>፤ <ref loc="JHN 19:36">ዮሃ. 19:36</ref></char></note> <verse eid="EXO 12:46"/><verse number="47" style="v" sid="EXO 12:47"/>እስራኤልያ ማባራይ ኡባይ ፓስጋ ቦንቻናዉ ኮሼ።<verse eid="EXO 12:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="EXO 12:48"/>“በቲ ዪደ ህንተንቱ ግዶን ደእያ አሳይ መና ጎዳ ፓስጋ ቦንቻናዉ ኮዮፐ፥ ኮይሮ ሄ አቱማ አሳይ ኡባይ ቃጻረቶ። ሄዋፐ ጉይያን እ ሄ ቢታን የለቴዳ አሳዳን ሺቂደ፥ ፓስጋ ቦንቻናዉ ዳንዳዬ። ሽን ቃጻረትቤና አሳይ ኡባካ አፐ ሞፖ። <verse eid="EXO 12:48"/><verse number="49" style="v" sid="EXO 12:49"/>ህንተንቱ ቢታን የለቴዳዎካ ህንተንቱ ግዶን በተ ግዲደ ደእያዋዉካ ሄ ዎጋይ እቱዋ” ያጌዳ።<verse eid="EXO 12:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="EXO 12:50"/>እስራኤላቱ ኡባይ መና ጎዳይ ሙሳነ አሮና አዛዜዳዋዳንካ ኦድኖ። <verse eid="EXO 12:50"/><verse number="51" style="v" sid="EXO 12:51"/>ሄ ጋላስካ መና ጎዳይ እስራኤላቱዋ ኡንቱንቱ ጩጉዋን ጩጉዋን ግብጼ ጋድያፐ ከሴዳ።<verse eid="EXO 12:51"/></para>
  <chapter eid="EXO 12"/>
  <chapter number="13" style="c" sid="EXO 13"/>
  <para style="s1">ባይራ የለቴዳ ኡባይ ጾሳዉ ዱማቴዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 13:1"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="EXO 13:1"/><verse number="2" style="v" sid="EXO 13:2"/>“ባይራ የለቴዳ አቱማዋ ኡባ ታዉ ዱማያ። እስራኤልያ አሳ ግዶን ኡሉዋፐ የለቴዳ ባይራ ኡባይ፥ መህያ ግድና አሳ ግድና፥ ኡባይካ ታዋ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="NUM 3:13">ፓይ. 3:13</ref>፤ <ref loc="LUK 2:23">ሉቃሳ 2:23</ref></char></note><verse eid="EXO 13:2"/></para>
  <para style="s1">እርሹ ገልቤና ኡክ ባላ</para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 13:3"/>ሄዋፐ ጉይያን ሙሴ አሳ፥ “ግብጼፐ፥ አይለተ ጋድያፐ ህንተንቱ ከሴዳ ጋላሳ፥ ሀ ጋላሳ ሀሳይተ፤ አያዉ ጎፐ፥ መና ጎዳይ ባረ ዎልቃማ ኩሽያን ህንተንታ ከሴዳ፤ ሄዋ ድራዉ፥ እርሹ ገሌዳዋ ኡባካ ሞፕተ። <verse eid="EXO 13:3"/><verse number="4" style="v" sid="EXO 13:4"/>ህንተንቱ ሀቼ፥ ላይዉ ኮይሮ ግዴዳ አቢባ አግናን ከሲታ። <verse eid="EXO 13:4"/><verse number="5" style="v" sid="EXO 13:5"/>መና ጎዳይ ካናነቱዋ፥ ሂተቱዋ፥ አሞራዋናቱዋ፥ ሂዌቱዋነ ያቡሳዋናቱዋ ጋድያ ህንተንታ ጋያ ዎደ፥ ህንተንቱ ሀ ፓስጋ ሀ አግናን ቦንቺታ። ሄ ቢታይ ጾሳይ ህንተዉ እማና ማላ፥ ካሰ ህንተንቱ አዋቶ ጫቂ ዎዳ ቢታ። ሄ ቢታይ ማይነ ኤሳይ ጎግያ ቢታ። <verse eid="EXO 13:5"/><verse number="6" style="v" sid="EXO 13:6"/>ህንተንቱ ላፑን ጋላሳይ ጋካናዉ እርሹ የገትቤና ኡክ ማንታ፤ ላፑን ጋላሳይ መና ጎዳ ባላ ግዳናዋ። <verse eid="EXO 13:6"/><verse number="7" style="v" sid="EXO 13:7"/>ሄ ላፑን ጋላሳቱዋን እርሹ የገትቤና ኡክ ህንተንቱ ማና፤ ህንተንቱ ግዶን እርሹዋና ደእያባይ አያይነ ቤቶፖ፤ ነ ቢታ ዛዋን ሀቃንነ እርሹ ቤቶፖ።<verse eid="EXO 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 13:8"/>“ሄ ጋላስ ኔን ነ ናአዉ፥ ‘ታን ሀዋ ኦያዌ፥ ታን ግብጼፐ ከስያ ዎደ፥ መና ጎዳይ ታዉ ኦዳዋ ሀሳያናሳ’ ያጋደ ኦዳ። <verse eid="EXO 13:8"/><verse number="9" style="v" sid="EXO 13:9"/>መና ጎዳይ ህንተንታ ባረ ዎልቃማ ኩሽያን ግብጼፐ ከሴዳ ድራዉ፥ መና ጎዳ ዎጋይ ህንተንቱ ዶናፐ ዎናዳን፥ ሀ ቦንቼትያ ጋላሳይ ነ ኩሽያን ቃቼዳነ ነ ዴሙዋን ዎዳ ሀሳይስያዋ ማላ ግዳና። <verse eid="EXO 13:9"/><verse number="10" style="v" sid="EXO 13:10"/>ሄዋ ድራዉ፥ ህንተንቱ ሀ ዎጋ ላይን ላይን አ ዎድያን ቦንችተ።<verse eid="EXO 13:10"/></para>
  <para style="s1">ባይራ ናኣ</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 13:11"/>“መና ጎዳይ ህንተንቱነ ህንተንቱ ማይዛ አዋቶ እማናዉ ጫቄዳዋዳን፥ እ ህንተንታ ካናነቱዋ ጋድያ ገልሲደ፥ ሄ ጋድያ ህንተንቶ እምያ ዎደ፥ <verse eid="EXO 13:11"/><verse number="12" style="v" sid="EXO 13:12"/>ኡሉዋፐ ባይራ የለቴዳ ኡባ መና ጎዳዉ ዱማያ፤ ነ ሚዛ ባይራ የለትያ አቱማዋ ኡባይ መና ጎዳዋ።<note caller="-" style="x"><char style="xo" closed="false">13:12 </char><char style="xt" closed="false"><ref loc="EXO 34:19-20">ከሳ 34:19-20</ref>፤ <ref loc="LUK 2:23">ሉቃሳ 2:23</ref></char></note> <verse eid="EXO 13:12"/><verse number="13" style="v" sid="EXO 13:13"/>ባይራ የለትያ ሀርያ ኡባ ዶርሳ ማራን ዎዛ አካ። ዎዘናዋ ግዶፐ፥ አ ሞርግያ መን፤ ነ አቱማ ናና ግዶን ባይራ የለቴዳዋንታ ኡባ ዎዛ። <verse eid="EXO 13:13"/><verse number="14" style="v" sid="EXO 13:14"/>ስንና ያና ዎድያን ነ ናአይ ኔና፥ ‘ሀዌ አዬ?’ ያጊደ ኦቾፐ፥ ኔን አ፥ ‘መና ጎዳይ ኑና ዎልቃማ ኩሽያን ግብጼፐ፥ አይለተ ጋድያፐ ከሴዳ፤ <verse eid="EXO 13:14"/><verse number="15" style="v" sid="EXO 13:15"/>ግብጼ ካቲ ዶንጭሊደ ኑና የደናን እጽና፥ መና ጎዳይ ግብጼ ጋድያን ደእያ ባይራ ኡባ፥ አሳፐ ዶሚደ መህያ ባይራ ጋካናዉ ዎዳ። ታን አት ኡሉዋፐ ኮይሮ የለቴዳ አቱማዋ ኡባ መና ጎዳዉ ያርሽያዌነ ታ ባይራ አቱማ ናና ታን ዎዝያዌ ሄዋሳ’ ያጋ። <verse eid="EXO 13:15"/><verse number="16" style="v" sid="EXO 13:16"/>መና ጎዳይ ኑና ባረ ዎልቃማ ኩሽያን ግብጼፐ ከሴዳዎ፥ ሀዌ ህንተንቶ ኩሽያን ቃቼዳነ ዴሙዋን ዎዳ ማላ ማላ ግዳናዋ” ያጌዳ።<verse eid="EXO 13:16"/></para>
  <para style="s1">ጾሳይ ባረ አሳ ካለ ሀኖታ</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 13:17"/>ካቲ አሳ የዴዳ ዎደ፥ ጾሳይ ኡንቱንታ ፕልስጼማ ቢታና አያ ኦጊ ማታ ግዶፐነ ሄ ኦግያና ካለቤና፤ አያዉ ጎፐ፥ ጾሳይ፥ “አሳይ ኦላ በኦፐ፥ ባረ ቆፋ ላሚደ፥ ጉየ ግብጼ ስመናዳን” ያጊደ ቆፔዳ። <verse eid="EXO 13:17"/><verse number="18" style="v" sid="EXO 13:18"/>ሄዋ ድራዉ፥ ጾሳይ አሳ መላ ቢታ ኦግያና ዩሺደ፥ ዞኦ አባኮ ካለዳ። እስራኤለቱ ግብጼ ጋድያፐ ኦላዉ ጊጊደ ፑደ ከሴድኖ። <verse eid="EXO 13:18"/><verse number="19" style="v" sid="EXO 13:19"/>ዮሴፎ እስራኤልያ አሳ ጫቀ ዎዳ ድራዉ፥ ሙሴ አ መቀ ባረናና አኪደ ቤዳ፤ ዮሴፎ ኡንቱንታ፥ “ጾሳይ ቱሙፐ ህንተንታ ማዳናዉ ያናዋ፤ ሄ ዎደ ህንተንቱ ታ መቀ ሀ ሳኣፐ ፑደ ህንተናና አኪደ ቢተ” ያጊደ ኦድ ዎዳ።<note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="GEN 50:25">ዶመ 50:25</ref>፤ <ref loc="JOS 24:32">ኢያሳ 24:32</ref></char></note><verse eid="EXO 13:19"/></para>
  <para style="s1">ታማነ ሻርያ ቱሳ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 13:20"/>ኡንቱንቱ ሱኮተፐ ደንዲደ መላ ቢታ ዶናን ደእያ ኤታማን ኡቴድኖ። <verse eid="EXO 13:20"/><verse number="21" style="v" sid="EXO 13:21"/>መና ጎዳይ ኡንቱንቱ ጋላስነ ቃማ ሀመታና ማላ፥ ጋላሳን ኡንቱንታ ኦግያ በሳናዉ ሻርያ ቱሳን፥ ቃማን ኡንቱንቶ ፖእሳና ማላ ታማ ቱሳን ኡንቱንታ ካለዳ። <verse eid="EXO 13:21"/><verse number="22" style="v" sid="EXO 13:22"/>ጋላስ ሻርያ ቱሳይ ዎይ ቃማ ታማ ቱሳይ አሳ ስንፐ ክችቤና።<verse eid="EXO 13:22"/></para>
  <chapter eid="EXO 13"/>
  <chapter number="14" style="c" sid="EXO 14"/>
  <para style="s1">ዞኦ አባ ፕኔድኖ</para>
  <para style="p">
    <verse number="1-2" style="v" sid="EXO 14:1-2"/>ሄዋፐ ጉይያን ሙሳ መና ጎዳይ፤ “ኡንቱንቱ ጉየ ስሚደ ምግዶላፐነ አባፐ ግዱዋን፥ ፕሃህሮታ ማታን ኡታናዳን ኦዳ፤ ኡንቱንቱ አባ ላንቂያን ባኣል-ጻፎና ስን መላ ቢታን ኡትኖ ያጌዳ። <verse eid="EXO 14:1-2"/><verse number="3" style="v" sid="EXO 14:3"/>ካቲ፥ ‘እስራኤላቱ መላ ቢታይ ጎርድና፥ ሀንያባ ዪደ ቢታን ጮ ቶይላካቲኖ’ ያጊደ ቆፓናዋ። <verse eid="EXO 14:3"/><verse number="4" style="v" sid="EXO 14:4"/>ታን ካትያ ዎዛና ዶንጭልሳና፤ እ ኡንቱንታ የደርሳና፤ ታን ካትያንነ አ ኦላንቻቱዋ ኡባን ቦንቼታና፤ ግብጼቱካ ታን መና ጎዳ ግድያዋ ኤራና” ያጌዳ። እስራኤላቱ እ ኦዴዳዋዳን ኦድኖ።<verse eid="EXO 14:4"/></para>
  <para style="s1">እስራኤላቱዋ ካትያ ፓራይ ካሌዳ</para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 14:5"/>አሳይ ባቃት ድጌዳዋ ግብጼ ካትያዉ ኦድና፥ እነ አ ሱንቱ እስራኤላቶ ቆፔዳ ባረንቱ ቆፋ ላሚደ፥ “ኑን ሀዋ ዋቴቶ? ኑን እስራኤላቱዋ የዲደ፥ ኡንቱንቱ ኑዉ ኦያ ዎልቃፐ መላ አቴዶ” ያጌድኖ። <verse eid="EXO 14:5"/><verse number="6" style="v" sid="EXO 14:6"/>ሄዋ ድራዉ፥ እ ባረ ፓራ ጋርያ ኮሪደ፥ ባረ ኦላንቻቱዋ ባረናና አኪደ ደንዴዳ። <verse eid="EXO 14:6"/><verse number="7" style="v" sid="EXO 14:7"/>እ ኡሱፑን ጼቱ ዶረቴዳ ፓራ ጋረቱዋ፥ ግብጼ ጋድያን ደእያ ሀራ ጋረቱዋ ኡባና፥ ኡንቱንቱ ኡባዉ ካፑዋ ካፑዋ ሱንደ አኪደ ቤዳ። <verse eid="EXO 14:7"/><verse number="8" style="v" sid="EXO 14:8"/>መና ጎዳይ ግብጼ ጋደ ካትያ፥ ዎዛና ልስና፥ ጾሳ ዎልቃን ከሳ ቦላ ደእያ እስራኤልያ አሳ የደርሴዳ። <verse eid="EXO 14:8"/><verse number="9" style="v" sid="EXO 14:9"/>ሄዋፐ ጉይያን ግብጼ አሳቱ፥ ካትያ ፓራቱ ኡባይነ ፓራ ጋረቱ፥ ፓራ አሳቱነ ኦላንቻቱ እስራኤላቱዋ ካሊደ የደርሴድኖ። አባ ዶናን ባኣል-ጻፎና ስን ባዙዋን ደእያ ፕሃህሮታ ማታን ኡንቱንቱ ኡቴዳዋንታ ደሜድኖ።<verse eid="EXO 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 14:10"/>ካቲ ማት ድግና፥ እስራኤላቱ ቁ ግ ጼልያ ዎደ፥ ግብጼቱ ኡንቱንቱ ጌዱዋ ካሊደ ዬዳዋ በኤድኖ፤ ያቲደ ዳሮፐ ያዪደ፥ መና ጎዳኮ ዋሴድኖ። <verse eid="EXO 14:10"/><verse number="11" style="v" sid="EXO 14:11"/>ኡንቱንቱ ሙሳ፥ “ኔን ኑና ግብጼን ዱፉ ይና መላ ቢታን ሀይቃናዳን ከሳዲየ? ኑና ግብጼፐ አያዉ አሃድ? <verse eid="EXO 14:11"/><verse number="12" style="v" sid="EXO 14:12"/>ግብጼን ደኢደ ኑን፥ ‘ኑና አጋ ባሻ፤ ኑን ግብጼቶ ሞደታና’ ያጊደ ነዉ ኦድበይኮየ? መላ ቢታን ሀይቃናፐ ኡንቱንቶ ሞደትያዌ ኑዉ ሎአ ሽን” ያጌድኖ።<verse eid="EXO 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 14:13"/>ሽን ሙሴ አሳ፥ “ያዮፕተ፤ ምን ኤቂተ፤ መና ጎዳይ ሀቼ ህንተንታ አሽያ አሹዋ ህንተንቱ በአና። ሀቼ ህንተንቱ በእያ ግብጼቱዋ ላኤን ኡባካ በእክታ። <verse eid="EXO 14:13"/><verse number="14" style="v" sid="EXO 14:14"/>ህንተንቱ ድራዉ መና ጎዳይ ኦለታናዋ፤ ህንተንቱፐ ኮየትያዌ ጮኡ ጉሳ ጻላላ” ያጌዳ።<verse eid="EXO 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 14:15"/>መና ጎዳይ ሙሳ፥ “ኔን ታኮ አያዉ ዋሳይ? እስራኤላቱ ስንዉ ሀመታና ማላ ኦዳ። <verse eid="EXO 14:15"/><verse number="16" style="v" sid="EXO 14:16"/>ነ ጻምኣ ደንደ አባ ቦላ ምጫ፤ ሃይ ላኡ ከሲደ ሻከታናዋ፤ እስራኤላቱካ መላ ቢታና አባ ፕኒደ ባናዋንታ። <verse eid="EXO 14:16"/><verse number="17" style="v" sid="EXO 14:17"/>ታን ግብጼቱዋ ዎዛና ዶንጭልስና፥ ኡንቱንቱ ህንተንቱ ጌዱዋ ካሊደ አባን ገላናዋንታ። ታን ካትያነ አ ኦላንቻቱዋ ኡባ ቦላን፥ አ ፓራ ጋረቱዋነ አ ፓራ አሳቱዋ ቦላን ቦንቹዋ ታዉ ደማና። <verse eid="EXO 14:17"/><verse number="18" style="v" sid="EXO 14:18"/>ታን ካትያ ቦላን፥ አ ፓራ ጋረቱዋ ቦላንነ አ ፓራ አሳቱዋ ቦላን ታዉ ቦንቹዋ ደሜዳ ዎደ፥ ታን መና ጎዳ ግድያዋ ግብጼቱ ኤራናዋንታ” ያጌዳ።<verse eid="EXO 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 14:19"/>ሄዋፐ ጉይያን ጾሳ ኪታንቻይ፥ እስራኤልያ ኦላንቻቱዋፐ ስንና ሀመትያዌ፥ ጉየ አደ ኡንቱንቱፐ ጉየና ሀመቴዳ። ሻርያ ቱሳይካ ኡንቱንቱ ስንን ደእያ ሳኣፐ ጉየ ባጋ ዩዪደ፥ <verse eid="EXO 14:19"/><verse number="20" style="v" sid="EXO 14:20"/>ግብጼቱዋ ኦላንቻቱዋፐነ እስራኤለቱዋ ኦላንቻቱዋፐ ግዱዋን ኤቄዳ። ሄ ሻሪ ቃማ ኡባን እት ባጋና ምሲደ፥ ህንኮ ባጋና ፖእሴዳ፤ ያትና ቃማ ኡባ እቱ እቱዋኮ ሺቅበይክኖ።<verse eid="EXO 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 14:21"/>ሄዋፐ ጉይያን ሙሴ አባ ቦላን ባረ ኩሽያ ምጬዳ፤ መና ጎዳይ ሄ ጋላስ ቃማ ኡባን አዋይ ዶልያ ባጋፐ ዎልቃማ ጫርኩዋ የዲደ፥ አባ ጉየ ዛሪደ መላ ቢታ ከሴዳ። ሃይ ሻከቴዳ። <verse eid="EXO 14:21"/><verse number="22" style="v" sid="EXO 14:22"/>እስራኤለቱ አባ ግዱዋና መላ ቢታን ሀመቲደ፥ ሃይ ኡንቱንቶ ኡሸቻናነ ሀድርሳና ጎዳዳን ኤቂና ቤድኖ።<note caller="-" style="x"><char style="xo" closed="false">14:22 </char><char style="xt" closed="false"><ref loc="1CO 10:1-2">1 ቆሮ. 10:1-2</ref>፤ <ref loc="HEB 11:29">እብራ. 11:29</ref></char></note> <verse eid="EXO 14:22"/><verse number="23" style="v" sid="EXO 14:23"/>ግብጼቱ ኡንቱንታ የደርሴድኖ፤ ካትያ ፓራ ኡባቱ፥ አ ፓራ ጋረቱነ አ ፓራ አሳቱ ኡንቱንታ ካሊደ፥ አባ ግዶ ገሌድኖ። <verse eid="EXO 14:23"/><verse number="24" style="v" sid="EXO 14:24"/>ብሮ ዎንታ ባካሊ ዶላናፐ ካሰቲደ፥ መና ጎዳይ ታማነ ሻርያ ቱሳፐ ዱገ ዛሪደ፥ ግብጼቱዋ ኦላንቻቱዋ ጼሌዳ፤ ኡንቱንቱ ዎዛና ባይዜዳ። <verse eid="EXO 14:24"/><verse number="25" style="v" sid="EXO 14:25"/>ላጋይ ኡንቱንታ ዋይሳና ማላ፥ መና ጎዳይ ኡንቱንቱ ፓራ ጋረቱዋ ጎማ ቃዋ ድግና ግብጼቱ፥ “መና ጎዳይ ኡንቱንታ ማዲደ ግብጻ ኦልያ ድራዉ፥ አነ ኑን እስራኤልያ አሳፐ ባቃቶይተ” ያጌድኖ።<verse eid="EXO 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 14:26"/>መና ጎዳይ ሙሳ፥ “ሃይ ግብጼቱዋ ቦላ፥ ኡንቱንቱ ፓራ ጋረቱዋ ቦላነ ኡንቱንቱ ፓራ አሳቱዋ ቦላ ጉየ ጎጋና ማላ፥ ነ ኩሽያ አባ ቦላን ምጫ” ያጌዳ።<figure style="fig" alt="Horses and chariots in battle" file="HK00191B.TIF" size="span" ref="14:6">ፓራይነ ፓራ ጋረቱ ኦላን</figure> <verse eid="EXO 14:26"/><verse number="27" style="v" sid="EXO 14:27"/>ሙሴ ባረ ኩሽያ አባ ቦላን ምጬዳ፤ ሳአይ ዎንትሽን፥ አባይ ባረ ካሰ ሳኣ ጉየ ስሜዳ፤ ግብጼቱ ያ አ ግዶ ባቃትሽን፥ መና ጎዳይ ግብጼቱዋ አባ ግዱዋን አ የጌዳ። <verse eid="EXO 14:27"/><verse number="28" style="v" sid="EXO 14:28"/>ሃይ ጉየ ስሚደ፥ ፓራ ጋረቱዋ ፓራ አሳቱዋና እስራኤላቱዋ ካሊደ አባ ገሌዳ ካትያ ኦላንቻቱዋ ኡባ ምት ባሼዳ፤ ኡንቱንቱፐ እቱነ አትቤና። <verse eid="EXO 14:28"/><verse number="29" style="v" sid="EXO 14:29"/>ሽን እስራኤለቱ አባ ግዱዋና መላ ቢታን ሀመቲደ፥ ሃይ ኡንቱንቶ ኡሸቻናነ ሀድርሳና ጎዳዳን ኤቂና ቤድኖ። <verse eid="EXO 14:29"/><verse number="30" style="v" sid="EXO 14:30"/>መና ጎዳይ ሄ ጋላስ እስራኤልያ አሳ ግብጼቱዋ ኩሽያፐ ሀዋዳን አሼዳ። ቃይ እስራኤለቱ ግብጼቱ ሀይቂደ ግሴዳዋንታ አባ ዶናን በኤድኖ። <verse eid="EXO 14:30"/><verse number="31" style="v" sid="EXO 14:31"/>እስራኤላቱካ መና ጎዳይ ግብጼቱዋ ቦላ በሴዳ ዎልቃማ ዎልቃ በኤዳ ዎደ፥ አሳይ መና ጎዳዉ ያዪደ አካ አ ቆማ ሙሳካ አማኔዳ።<verse eid="EXO 14:31"/></para>
  <chapter eid="EXO 14"/>
  <chapter number="15" style="c" sid="EXO 15"/>
  <para style="s1">ሙሴ የ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 15:1"/>ሄ ዎደ ሙሴነ እስራኤልያ አሳይ ሀ የ መና ጎዳዉ የጼድኖ፤</para>
  <para style="q1" vid="EXO 15:1">“ቦንቹዋን ሎይ ቁ ቁ ጌዳ ድራዉ፥</para>
  <para style="q2" vid="EXO 15:1">ታን መና ጎዳዉ ማዝሙርያ የጻና።</para>
  <para style="q2" vid="EXO 15:1">ፓራነ ፓራ ጋርያነ ቶጌዳዋንታ አባን ኦሌዳ።<note caller="-" style="x"><char style="xo" closed="false">15:1 </char><char style="xt" closed="false"><ref loc="REV 15:3">ሳፃ 15:3</ref></char></note><verse eid="EXO 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="EXO 15:2"/>መና ጎዳይ ታ ዎልቃነ ታ ማዝሙርያ፤</para>
  <para style="q2" vid="EXO 15:2">እ ታና አሽያዋ ግዴዳ።<note caller="-" style="x"><char style="xo" closed="false">15:2 </char><char style="xt" closed="false"><ref loc="PSA 118:14">ማዝ. 118:14</ref>፤ <ref loc="ISA 12:2">ኢሳ. 12:2</ref></char></note></para>
  <para style="q2" vid="EXO 15:2">እ ታ ጾሳ፤ ታን አ ሳባና።</para>
  <para style="q2" vid="EXO 15:2">እ ታ አዉዋ ጾሳ፤</para>
  <para style="q2" vid="EXO 15:2">ታን አ ቁ ቁ ኦና።<verse eid="EXO 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="EXO 15:3"/>መና ጎዳይ ኤረቴዳ ኦላንቻ፤</para>
  <para style="q2" vid="EXO 15:3">አ ሱንይካ መና ጎዳ።<verse eid="EXO 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EXO 15:4"/>ግብጼ ካትያ ፓራ ጋረቱዋነ</para>
  <para style="q2" vid="EXO 15:4">አ ኦላንቻቱዋ አባን ኦሌዳ።</para>
  <para style="q2" vid="EXO 15:4">ግብጼ ካትያ ካፓቱ፥</para>
  <para style="q2" vid="EXO 15:4">ኡባፐ አ ሎእያዋንቱ ዞኦ አባን ሙከቴድኖ።<verse eid="EXO 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="EXO 15:5"/>ጪሞ ሃይ ኡንቱንታ ካሜዳ፤</para>
  <para style="q2" vid="EXO 15:5">ኡንቱንቱ ሹቻዳን ጪሙዋን ምተቴድኖ።<verse eid="EXO 15:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="EXO 15:6"/>“አቤት መና ጎዳዉ፥ ነ ኡሸቻ ኩሺ</para>
  <para style="q2" vid="EXO 15:6">ዎልቃን ጎቤዳዋ፤</para>
  <para style="q2" vid="EXO 15:6">መና ጎዳዉ፥ ነ ኡሸቻ ኩሺ</para>
  <para style="q2" vid="EXO 15:6">ሞርክያ መንሬዳ።<verse eid="EXO 15:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="EXO 15:7"/>ነ ቦንቹዋ ግታተን</para>
  <para style="q2" vid="EXO 15:7">ኔናና ጋዳቴዳዋንታ ኦላዳ።</para>
  <para style="q2" vid="EXO 15:7">ነ ኤጽያ ሀንቁዋ ኔን የድና፥</para>
  <para style="q2" vid="EXO 15:7">እ ኡንቱንታ ዳላዳን ሜዳ።<verse eid="EXO 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EXO 15:8"/>ነ ሲያና ከስያ ሸምፑዋን</para>
  <para style="q2" vid="EXO 15:8">ሃይ ዶረቴዳ።</para>
  <para style="q2" vid="EXO 15:8">ጎግያ ሃይካ ጎዳዳን ምን ኤቄዳ፤</para>
  <para style="q2" vid="EXO 15:8">ጪሞ ሃይ አባ ጎምፓን እርኪደ ምኔዳ።<verse eid="EXO 15:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="EXO 15:9"/>“ሞርኪ፥</para>
  <para style="q2" vid="EXO 15:9">‘ታን ኡንቱንታ የደርሳደ ኦይቃና።</para>
  <para style="q2" vid="EXO 15:9">ታን ኡንቱንቱ ማጹዋ ሻካደ፥</para>
  <para style="q2" vid="EXO 15:9">ታ ኮዬዳዋ ኡባ አካና።</para>
  <para style="q2" vid="EXO 15:9">ታን ታ ማሻ ሾዳደ፥</para>
  <para style="q2" vid="EXO 15:9">ኡንቱንታ ይሳና’ ያጊደ ጬቀቴዳ።<verse eid="EXO 15:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="EXO 15:10"/>“ሽን ነ ፔኑዋን ፑንና፥</para>
  <para style="q2" vid="EXO 15:10">አባይ ኡንቱንታ ካሜዳ።</para>
  <para style="q2" vid="EXO 15:10">ኡንቱንቱ ዎልቃማ ሃን</para>
  <para style="q2" vid="EXO 15:10">ብራታይ ምተትያዋዳን ምተቴድኖ።<verse eid="EXO 15:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="EXO 15:11"/>አቤት መና ጎዳዉ፥ ጾሳቱዋ ግዶን</para>
  <para style="q2" vid="EXO 15:11">ነ ማላይ ኦኔ?</para>
  <para style="q2" vid="EXO 15:11">ጌሻተን ቦንቼትያዌ፥</para>
  <para style="q2" vid="EXO 15:11">ቦንቹዋን ያየትያዌ፥</para>
  <para style="q2" vid="EXO 15:11">ማላልያባ ኦያዌ ነ ማላይ ኦኔ?<verse eid="EXO 15:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="EXO 15:12"/>ኔን ነ ኡሸቻ ኩሽያ ምጭና፥</para>
  <para style="q2" vid="EXO 15:12">ቢታይ ኡንቱንታ ምቴዳ።<verse eid="EXO 15:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="EXO 15:13"/>“ኔን ዎዜዳ ነ አሳ</para>
  <para style="q2" vid="EXO 15:13">አገና ነ ሲቁዋን ካለዳ።</para>
  <para style="q2" vid="EXO 15:13">ኔን ነ ዎልቃን</para>
  <para style="q2" vid="EXO 15:13">ኡንቱንታ ኔን ደእያ ጌሻ ሳኣ ገልሳዳ።<verse eid="EXO 15:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="EXO 15:14"/>ካዉተቱ ሄዋ ስሲደ</para>
  <para style="q2" vid="EXO 15:14">ኮኮሬድኖ።</para>
  <para style="q2" vid="EXO 15:14">ፕልስጼማ ጋድያ አሳቱካ</para>
  <para style="q2" vid="EXO 15:14">የሉ ኦይቄዳዋዳን ኡንኤቴድኖ።<verse eid="EXO 15:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="EXO 15:15"/>ሄ ዎደ ኤዶማ ጋደ ካፓቱ ዳጋሜድኖ።</para>
  <para style="q2" vid="EXO 15:15">ሞኣበ ጋድያ ሞድያዋንታ</para>
  <para style="q2" vid="EXO 15:15">ያሻይ ኮኮርሴዳ።</para>
  <para style="q2" vid="EXO 15:15">ካናነ አሳቱዋ ሸኒ ሀይቄዳ።<verse eid="EXO 15:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="EXO 15:16"/>አቤት መና ጎዳዉ ዳጋማይነ ያሻይ ኡንቱንታ ኦይቂና፥</para>
  <para style="q2" vid="EXO 15:16">ኡንቱንቱ ነ ዎልቃ ግታተ በኢደ፥</para>
  <para style="q2" vid="EXO 15:16">ነ አሳይ አና ጋካናዉ፥</para>
  <para style="q2" vid="EXO 15:16">ኔን ዎዜዳ አሳይ አና ጋካናዉ፥</para>
  <para style="q2" vid="EXO 15:16">ሹቻዳን ሙሚደ ኤቂኖ።<verse eid="EXO 15:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="EXO 15:17"/>አቤት መና ጎዳዉ ኔን ኡንቱንታ አሃደ፥</para>
  <para style="q2" vid="EXO 15:17">ነ ቡዞ ጋደን ደእያ ደርያ ሁጲያን ቶከቴዳ ምዳ ዎ።</para>
  <para style="q2" vid="EXO 15:17">ሄ ሳአይ</para>
  <para style="q2" vid="EXO 15:17">ኔን ነዉ ደአናዉ ኦዳ ሳኣ፥</para>
  <para style="q2" vid="EXO 15:17">ሄ ጌሻ ሳአይ ኔን ነ ኩሽያን ምንሳደ ኤሴዳ ሳኣ።<verse eid="EXO 15:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="EXO 15:18"/>መና ጎዳይ መናፐ መናዉ ካዉታናዋ።”<verse eid="EXO 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 15:19"/>ግብጼ ካትያ ፓራቱ፥ አ ፓራ ጋረቱነ አ ፓራ አሳቱ አባን ገሌዳ ዎደ፥ መና ጎዳይ ኡንቱንቱ ቦላ አባ ሃ ጉየ ዛሪደ ኡንቱንቱ ቦላ አሄዳ፤ ሽን እስራኤላቱ አባ ግዱዋና መላ ቢታን ሀመቲደ ቤድኖ ያግ የጼድኖ።<verse eid="EXO 15:19"/></para>
  <para style="s1">ማይራም የ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 15:20"/>አሮና ምቻታ፥ ናባታ ማይራማ ዳርቢያ አካዱ፤ ማጫ አሳይ ኡባይ ዳርቢያ ባቂደነ የጺደ እዞ ካሌድኖ። <verse eid="EXO 15:20"/><verse number="21" style="v" sid="EXO 15:21"/>ማይራማ ኡንቱንቶ የ የጻደ፥</para>
  <para style="q1" vid="EXO 15:21">“መና ጎዳይ ሎይ ቁ ቁ ጌዳ ድራዉ፥</para>
  <para style="q2" vid="EXO 15:21">አዉ የጽተ።</para>
  <para style="q1" vid="EXO 15:21">ፓራነ ፓራ ቶጌዳዋ</para>
  <para style="q2" vid="EXO 15:21">እ አባን ኦሌዳ” ያጋደ የጻዱ።<verse eid="EXO 15:21"/></para>
  <para style="ms">ዞኦ አባፐ ሲና ደርያ ጋካናዉ</para>
  <para style="mr">(<ref loc="EXO 15:22-18:27">15:22—18:27</ref>)</para>
  <para style="s1">ጫምያ ሃነ ሎኦ ጮራ ፑልቱዋ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 15:22"/>ሄዋፐ ጉይያን ሙሴ እስራኤልያ ዞኦ አባፐ ካለና፥ ኡንቱንቱ ሱር ጌተትያ መላ ቢታ ቤድኖ። ሄ መላ ቢታን ኡንቱንቱ ሃ ደመናን ሄዙ ጋላሳ ሀመቴድኖ። <verse eid="EXO 15:22"/><verse number="23" style="v" sid="EXO 15:23"/>ኡንቱንቱ ማራ ግያ ሳኣ ጋኬዳ ዎደ፥ ማራ ሃይ ጫሞ ግዴዳ ድራዉ፥ ኡሻናዉ ዳንዳይበይክኖ፤ ሄዋ ድራዉ፥ ሄ ሳአይ ማራ<note caller="+" style="f"><char style="fr" closed="false">15:23 </char><char style="fq" closed="false">ማራ፦ </char><char style="ft" closed="false">ሀ ሱን ብለይ እብራዌዋን “ጫሙዋ” ግያዋ።</char></note> ጌተቴዳ። <verse eid="EXO 15:23"/><verse number="24" style="v" sid="EXO 15:24"/>ሄዋ ድራዉ፥ አሳይ፥ “ኑን አያ ኡሻኔ?” ያጊደ ሙሴ ቦላ ዙዙሜዳ። <verse eid="EXO 15:24"/><verse number="25" style="v" sid="EXO 15:25"/>ሙሴ መና ጎዳዉ ዋሴዳ፤ መና ጎዳይ አ እት ም በሴዳ፤ ሙሴ ሄ ም ሃ ግዶ ኦልና፥ ሃይ ማልኤዳ። መና ጎዳይ ኡንቱንቶ ካለሰትያ ዎጋ እሜዳ፤ ያን ጾሳይ ኡንቱንታ ፓጬዳ። <verse eid="EXO 15:25"/><verse number="26" style="v" sid="EXO 15:26"/>እ ኡንቱንታ ሀዋዳን ያጌዳ፤ “መና ጎዳይ ህንተንቱ ጾሳይ ኦድያዋ ምንሲደ ስሶፐነ አ አይፍያ ስንን ልከባ ኦፐ፥ ህንተንቱ አ አዛዙዋ ሀይዞፐነ አ ዎጋ ኡባ ናጎፐ፥ ታን ግብጼቱዋ ቦላ አሄዳ ሀርግያፐ እቱዋነ ህንተንቱ ቦላ አህከ፤ አያዉ ጎፐ፥ ታን ህንተንታ ፓያ መና ጎዳቴ” ያጌዳ።<verse eid="EXO 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 15:27"/>ሄዋፐ ኡንቱንቱ ኤላማ ጋድያ ዬድኖ፤ ያን ታማነ ላኡ ሃ ፑልቶቱነ ላፑን ታሙ ዛምባ ምቱ ደኢኖ። ኡንቱንቱ ያን ሃ ዶናን ኡቴድኖ።<verse eid="EXO 15:27"/></para>
  <chapter eid="EXO 15"/>
  <chapter number="16" style="c" sid="EXO 16"/>
  <para style="s1">መና ጎዳይ ማናነ አካቱዋ ቡክሴዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 16:1"/>ግብጼፐ ከሴዳ ላኤን አግናን፥ ታማነ እቼሻን ጋላሳን እስራኤልያ አሳ ኩመንይ ኤሊማፐ ደንዲደ፥ ኤሊማፐነ ሲናፐ ግዱዋን ደእያ “ሲን” ጌተትያ መላ ቢታ ዬዳ። <verse eid="EXO 16:1"/><verse number="2" style="v" sid="EXO 16:2"/>እስራኤልያ አሳ ኡባይ መላ ቢታን ሙሴ ቦላነ አሮና ቦላ ዙዙሜድኖ። <verse eid="EXO 16:2"/><verse number="3" style="v" sid="EXO 16:3"/>እስራኤላቱ ኡንቱንታ፥ “ኑን ግብጼ ጋድያን መና ጎዳ ኩሽያን ሀይቄዶ ግዴሮኮሻ! ያን ኑን ኑዋ አሹዋ ከርያ ዩይ አ ኡቲደ፥ ኑን ኮዮ ቁማ ኡባ ሜዶ፤ ሽን ህንተንቱ ኑና ከሲደ፥ ኡባቱዋ ኮሻን ዎናዉ መላ ቢታ አሄድቴ?” ያጌድኖ።<verse eid="EXO 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 16:4"/>መና ጎዳይ ሙሳ፥ “ታን ህንተንቶ ሳሉዋፐ ኡክ ቡክሳና፤ አሳይ ኡባ ጋላስካ ከሲደ፥ ሀቼ ሀቼዉ ግድያዋ ጻላላ ማጻናዉ ኮሼ። አሳይ ታ አዛዙዋ ካልንቶ ካለነንቶ ታን ኡንቱንታ ሄዋን ፓጫና።<note caller="-" style="x"><char style="xo" closed="false">16:4 </char><char style="xt" closed="false"><ref loc="JHN 6:31">ዮሃ. 6:31</ref></char></note> <verse eid="EXO 16:4"/><verse number="5" style="v" sid="EXO 16:5"/>ኡሱፑን ጋላስ ኡንቱንቱ ሀሮደ ማጽያዎ ላኡ ኩሽያ ማጺደ፥ ካኖ” ያጌዳ።<verse eid="EXO 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 16:6"/>ሄዋ ድራዉ፥ ሙሴነ አሮነ እስራኤልያ አሳ ኡባዉ፥ “ህንተና ግብጼ ጋድያፐ ከሴዳ መና ጎዳ ግድያዋ ኦማርስ ህንተንቱ ኤራና፤ <verse eid="EXO 16:6"/><verse number="7" style="v" sid="EXO 16:7"/>ቃይ መና ጎዳ ቦንቹዋ ዎንታ ህንተንቱ በአና፤ አያዉ ጎፐ፥ አ ቦላ ህንተንቱ ዙዙሜዳዋ እ ስሴዳ፤ ህንተንቱ ኑ ቦላ ዙዙማናዉ ኑን ኦኔ?” ያጌድኖ። <verse eid="EXO 16:7"/><verse number="8" style="v" sid="EXO 16:8"/>ሄዋፐ ጉይያን ሙሴ፥ “እ ህንተንቶ ማናዉ ኦማርስ አሹዋ እሚናነ ህንተንቱ ኮይያ ኡክ ኡባ ህንተንቶ ዎንታ እምና፥ እ መና ጎዳ ግድያዋ ህንተንቱ ሄዋን ኤራና። አያዉ ጎፐ፥ ህንተንቱ አ ቦላ ዙዙሜዳዋ እ ስሴዳ። ኑን ኦኔ? ህንተንቱ ኑ ቦላ ዙዙምክታ፤ ህንተንቱ መና ጎዳ ቦላ ዙዙሚታ” ያጌዳ።<verse eid="EXO 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 16:9"/>ሙሴ አሮና፥ “ኔን እስራኤልያ አሳ ኡባ፥ ‘መና ጎዳይ ህንተንቱ ዙዙን ስሴዳ ድራዉ፥ መና ጎዳ ስን ሃ ሺቅተ’ ያጋ” ያጌዳ። <verse eid="EXO 16:9"/><verse number="10" style="v" sid="EXO 16:10"/>አሮነ እስራኤልያ አሳ ኡባዉ ኦድያ ዎደ፥ ኡንቱንቱ መላ ቢታኮ ስሚደ ጼሌድኖ፤ ሄዋን መና ጎዳ ቦንቹ ሻርያ ግዶን ቆንጭያዋ በኤድኖ። <verse eid="EXO 16:10"/><verse number="11-12" style="v" sid="EXO 16:11-12"/>መና ጎዳይ ሙሳ፥ “ታን እስራኤላቱ ዙዙን ስሳድ፤ ኔን ኡንቱንቶ፥ ‘ኦማርሳን አሹዋ ህንተንቱ ማና፤ ዎንታ ኡክ ህንተንቱ ካላና፤ ሄ ዎደ ህንተንቱ ታን መና ጎዳ ህንተንቱ ጾሳ ግድያዋ ኤራና’ ያጋደ ኦዳ” ያጌዳ።<verse eid="EXO 16:11-12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 16:13"/>ሄ ጋላስ ኦማርሳን አሹ ሜተትያ ካፎቱ ዪደ፥ እስራኤልያ አሳይ ደእያ ሳኣ ማዬድኖ፤ ቃይ ዎንታ ኡንቱንቱ ዱንካነቱዋ ዩሹዋን ከተርሳይ ኩም ኡቴዳ። <figure style="fig" alt="Israelites gathering quail" file="CO00854B.TIF" size="col" ref="16:13">አሹ መተቲያ ካፎቱዋ</figure> <verse eid="EXO 16:13"/><verse number="14" style="v" sid="EXO 16:14"/>ከተርሳይ ጽኤዳ ዎደ፥ ሳኣን ዎዳ ሻቻ ማላትያ ሱፓ ፖቁ መላ ቢታ ቦላን ቤቴዳ። <verse eid="EXO 16:14"/><verse number="15" style="v" sid="EXO 16:15"/>እስራኤለቱ ሄዋ በኤዳ ዎደ፥ ኡንቱንቱ እቱ እቱዋ፥ “ሀዌ አዬ?”<note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="1CO 10:3">1 ቆሮ. 10:3</ref></char></note> ያጌድኖ። አያዉ ጎፐ፥ ኡንቱንቱ እ አየንቶ ኤርበይክኖ።</para>
  <para style="p" vid="EXO 16:15">ያትና ሙሴ ኡንቱንታ፥ “ህንተንቶ ማናዉ መና ጎዳይ እሜዳ ኡክይ ሀዋ። <verse eid="EXO 16:15"/><verse number="16" style="v" sid="EXO 16:16"/>መና ጎዳይ ሀዋዳን ያጊደ አዛዜዳ፤ ‘ጎለ አሳዉ አዎትያዌ፥ እቶ እቶ ማናዉ ኮሽያዋ ኬሻ ሺሾ፤ ህንተንቱ ዱንካንያ ግዶን ደእያ አሳይ ሁጲያን ሁጲያን ላኡ ጻሳ ግድያዋ አክተ’ ጌዳ” ያጌዳ።<verse eid="EXO 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 16:17"/>እስራኤላቱ ሙሴ ኡንቱንቶ ኦዴዳዋዳን ኦድኖ፤ እቱ ዳርሲደ፥ እቱ ላፈደ ሺሼድኖ። <verse eid="EXO 16:17"/><verse number="18" style="v" sid="EXO 16:18"/>ኡንቱንቱ ጻሳን ማኬዳ ዎደ፥ ዳርሲደ ሺሼዳዎ ፓላህቤና፤ ላፋ ሺሼዳዎ ፓጭቤና፤ ኡባይካ ሁጲያን ሁጲያን ባረዉ ምያዋ ኬሻ ሺሼዳ።<note caller="-" style="x"><char style="xo" closed="false">16:18 </char><char style="xt" closed="false"><ref loc="2CO 8:15">2 ቆሮ. 8:15</ref></char></note> <verse eid="EXO 16:18"/><verse number="19" style="v" sid="EXO 16:19"/>ሄዋፐ ጉይያን ሙሴ ኡንቱንታ፥ “ኦንነ አፐ ዎንትዉ አሾፖ” ያጌዳ። <verse eid="EXO 16:19"/><verse number="20" style="v" sid="EXO 16:20"/>ግዶ ሽን ኡንቱንቱፐ እቱ እቱ ሙሴ ኦድያዋ አከናን አጊደ፥ ሄዋ ዎንታ ጋካናዉ ዎድኖ፤ ሄዌ ጉጹኒደ ጽንቄዳ። ሄዋ ድራዉ፥ ሙሴ ኡንቱንታ ሀንቀቴዳ። <verse eid="EXO 16:20"/><verse number="21" style="v" sid="EXO 16:21"/>ዎንታ ዎንታ አሳይ ኡባይ ባረዉ ኮሽያዋ ሺሼዳ፤ አዋይ ሆእያ ዎደ ሳኣን አቴዳዌ ሲል አጌዳ።<verse eid="EXO 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 16:22"/>ኡሱፑን ጋላሳን ኡንቱንቱ ካሰዋፐ ላኡ ኩሽያ ሺሼድኖ። ያትና ኡንቱንቱ ካፓቱ ኡባቱ ዪደ ሄዋ ሙሴዉ ኦዴድኖ። <verse eid="EXO 16:22"/><verse number="23" style="v" sid="EXO 16:23"/>እ ኡንቱንታ፥ “መና ጎዳይ አዛዜዳዌ ሀዋ፤ ዎንት ኪታይ ባይና ሸምፖ ጋላሳ፥ መና ጎዳዉ ጌሻ ሳምባታ። ሄዋ ድራዉ፥ ህንተንቱ ኡክያዋ ኡክተ፤ ህንተንቱ ዶይስያዋነ ዶይስተ፤ ፓላሄዳዋ ዎንትዉ አሽተ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">16:23 </char><char style="xt" closed="false"><ref loc="EXO 20:8-11">ከሳ 20:8-11</ref></char></note> <verse eid="EXO 16:23"/><verse number="24" style="v" sid="EXO 16:24"/>ሄዋ ድራዉ፥ ኡንቱንቱ ሙሴ አዛዜዳዋዳን ዎንትዉ ዎና ጽንቂቤና ዎይ ጉጹንቤና። <verse eid="EXO 16:24"/><verse number="25" style="v" sid="EXO 16:25"/>“ሀቼ ሚተ፤ አያዉ ጎፐ፥ ሀቼ መና ጎዳ ሳምባታ፤ ህንተንቱ አ ሀቼ ደምባን ደምክታ። <verse eid="EXO 16:25"/><verse number="26" style="v" sid="EXO 16:26"/>ህንተንቱ ኡሱፑን ጋላሳን አ ሺሻናዉ ዳንዳዪታ፤ ሽን ላፑን ጋላሳይ ሳምባታ። ሳምባታን አያይነ ደኤና” ያጌዳ።<verse eid="EXO 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 16:27"/>ላፑን ጋላሳን እት እት አሳይ ሺሻናዉ ከሴዳ፤ ሽን ኡንቱንቱ አይነ ደምበይክኖ። <verse eid="EXO 16:27"/><verse number="28" style="v" sid="EXO 16:28"/>መና ጎዳይ ሙሳ፥ “ታ አዛዛቱዋነ ታ ህግያ ናግያዋ አዉደ ጋካናዉ እጺቴ? <verse eid="EXO 16:28"/><verse number="29" style="v" sid="EXO 16:29"/>መና ጎዳይ ህንተንቶ ሳምባታ እሜዳዋ አኬክተ፤ ኡሱፑን ጋላሳን እ ህንተንቶ ላኡ ጋላሳ ኡክ እምያዌ ሄዋ ድራሳ። ላፑን ጋላስ ኡባይ ባረ ደእያ ሳኣን ደእያ ሳኣን ጋምኦ፤ ኦንነ ካረ ከሶፖ” ያጌዳ። <verse eid="EXO 16:29"/><verse number="30" style="v" sid="EXO 16:30"/>ሄዋ ድራዉ፥ አሳይ ላፑን ጋላሳን ሸምፔዳ።<verse eid="EXO 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 16:31"/>እስራኤልያ አሳይ ሄ ኡክ ማና<note caller="+" style="f"><char style="fr" closed="false">16:31 </char><char style="fq" closed="false">ማና፦ </char><char style="ft" closed="false">ሀ ቃላ ብለይ እብራዌዋን “ሀዌ አዬ” ግያዋ።</char></note> ጊደ ሱንዳ። ማናይ ዴቡዋ አይፍያዳን ቦ፤ ኤሳና ኡኬዳ ኡክዳን ማልኤ። <verse eid="EXO 16:31"/><verse number="32" style="v" sid="EXO 16:32"/>ሙሴ እስራኤልያ አሳ፥ “መና ጎዳይ አዛዜዳዌ ሀዋ፤ ‘ታን ህንተንታ ግብጼ ጋድያፐ ከሴዳ ዎደ፥ ዎራን ምዜዳ ኡክ ኡንቱንቱ በአና ማላ፥ ማናፐ ላኡ ጻሳ ግድያዋ ህንተንቱ ያና የለታዉ አሽ ዎተ’ ያጊደ አዛዜዳ” ያጌዳ።<verse eid="EXO 16:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 16:33"/>ሙሴ አሮና፥ “እት ጻሩዋ አካደ ላኡ ሊትሮ ኩመን ማና አን ቆላ፤ ያታደ ያና የለታዉ ምንጀታና ማላ፥ መና ጎዳ ስንን ዎ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">16:33 </char><char style="xt" closed="false"><ref loc="HEB 9:4">እብራ. 9:4</ref></char></note><verse eid="EXO 16:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 16:34"/>መና ጎዳይ ሙሳ አዛዜዳዋዳን ምንጀታና ማላ፥ አሮነ ማና ጾሳ ስንን ዎዳ። <verse eid="EXO 16:34"/><verse number="35" style="v" sid="EXO 16:35"/>እስራኤላቱ ባረንቱ ደእያ ጋደ ያና ጋካናዉ ኦይታሙ ላይ ማና ሜድኖ፤ ኡንቱንቱ ካናነ ጋደ ባጋ ጋካናዉ ማና ሚደ ደኤድኖ።<note caller="-" style="x"><char style="xo" closed="false">16:35 </char><char style="xt" closed="false"><ref loc="JOS 5:12">ኢያሳ 5:12</ref></char></note> <verse eid="EXO 16:35"/><verse number="36" style="v" sid="EXO 16:36"/>አሳይ ማክያ ኤረቴዳ ቁንአይ ላኡ ጻሳፐ ታሙ ዳኩዋ ዳሬ።<verse eid="EXO 16:36"/></para>
  <chapter eid="EXO 16"/>
  <chapter number="17" style="c" sid="EXO 17"/>
  <para style="s1">ዛላፐ ሃይ ፑልቴዳ</para>
  <para style="r">(<ref loc="NUM 20:1-13">ፓይ. 20:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 17:1"/>እስራኤለቱዋ ማባራ ኡባይ መና ጎዳይ አዛዜዳዋዳን፥ እት ሳኣፐ ሀራ ሳኣ ዩዪደ፥ ሲን መላ ቢታፐ ደንድ ቢደ፥ ራፍዲማ ጌተትያ ሳኣን ኡቴድኖ። ሽን አሳይ ኡሻናዉ ሃይ ሄ ሳኣን ዬዳ። <verse eid="EXO 17:1"/><verse number="2" style="v" sid="EXO 17:2"/>ኡንቱንቱ ሙሴና ዋላቀቲደ አ፥ “ኑዉ ኡሻናዉ ሃ እማ” ያጌድኖ።</para>
  <para style="p" vid="EXO 17:2">ሙሴ ዛሪደ፥ “ህንተንቱ ታናና አያዉ ዋላቀቲቴ? መና ጎዳ ህንተንቱ አያዉ ፓጪቴ?” ያጌዳ።<verse eid="EXO 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 17:3"/>ሽን አሳይ ያን ሃ ሳመቲደ፥ ሙሴ ቦላ ዙዙሜድኖ። ኡንቱንቱ አ፥ “ኔን ኑና፥ ኑ ናናነ ኑ መህያ ሳሙዋን ዎናዉ ግብጼፐ ከሳደ ፑደ አያዉ አሃድ?” ያጌድኖ።<verse eid="EXO 17:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 17:4"/>ሙሴ፥ “ታን ሀ አሳ ዋቶ? ኡንቱንቱ ታና ሹቻን ጫዳና ሀኒኖ” ያጊደ መና ጎዳኮ ዋሴዳ።<verse eid="EXO 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 17:5"/>መና ጎዳይ ሙሳ፥ “ኔን አሳፐ ስንዉ ሀመታ፤ እስራኤልያ አሳ ጭማቱዋፐ ኔናና አፋ፤ እን ኔን ናይለ ሻፋ ሃ ሾጬዳ ጻምኣ ነ ኩሽያን ኦይቃደ ባ። <verse eid="EXO 17:5"/><verse number="6" style="v" sid="EXO 17:6"/>ታን ሲና ደርያ ዛላ ቦላ ነ ስንን ኤቃና፤ ኔን ሄ ዛላ ሾጫ፤ አሳይ ኡሻናዉ አፐ ሃይ ከሳናዋ” ያጌዳ። ሙሴ እስራኤልያ ጭማቱዋ ስንን ሄዋዳን ኦዳ።<verse eid="EXO 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 17:7"/>እስራኤላቱ፥ “መና ጎዳይ ኑ ግዶን ደኢየ ባዌ?” ያጊደ ዋላቀቴዳ ድራዉነ መና ጎዳ ፓጬዳ ድራዉ፥ ሄ ሳአይ ማሳሀነ ማሪባ ጌተቲደ ሱንቴዳ።<verse eid="EXO 17:7"/></para>
  <para style="s1">እስራኤላቱ አማሌቃቱዋ ጾኔድኖ</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 17:8"/>አማሌቃቱ ዪደ፥ ራፊድማን እስራኤላቱዋና ኦላ ጋከቴድኖ። <verse eid="EXO 17:8"/><verse number="9" style="v" sid="EXO 17:9"/>ሙሴ ኢያሳ፥ “ኔን ኑዉ አሳ ዶራደ፥ ከሳደ አማሌቃቱዋና ኦለታ፤ ታን ዎንት ጾሳ ጻምኣ ኦይቃደ፥ ዞዝያ ሁጲያን ኤቃና” ያጌዳ።<verse eid="EXO 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 17:10"/>ሄዋፐ ጉየ ኢያሱ ሙሴ ጌዳዋዳን፥ አማሌቃቱዋና ኦለቴዳ። ሙሴ፥ አሮነነ ሁር ዞዝያ ሁጲያ ከሴድኖ። <verse eid="EXO 17:10"/><verse number="11" style="v" sid="EXO 17:11"/>ሙሴ ባረ ኩሽያ ደን ጋምኤዳ ኬናን ኡባን እስራኤላቱ ጾኒኖ፤ ሽን እ ባረ ኩሽያ ዱገ ዎዳ ዎደ አማሌቃቱ ጾኒኖ። <verse eid="EXO 17:11"/><verse number="12" style="v" sid="EXO 17:12"/>ሙሴ ኩሺ አርጋጬዳ ዎደ፥ ኡንቱንቱ ሹቻ አክ ዪደ፥ ሙሳ አ ቦላ ኡትሴድኖ። አሮነነ ሁር እቱ እት ባጋና እቱ ህንኮ ባጋና ግዲደ፥ አ ኩሽያ ስት ኦደ ኦይቄድኖ። ያትና አዋይ ዉላና ጋካናዉ አ ኩሺ ስት ጊደ ታኬዳ። <verse eid="EXO 17:12"/><verse number="13" style="v" sid="EXO 17:13"/>ሄዋ ድራዉ፥ ኢያሱ አማሌቃቱዋ ኦላንቻቱዋ ማሻን ጾኔዳ።<verse eid="EXO 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 17:14"/>ሄዋፐ ስምና፥ ሙሳ መና ጎዳይ ሀዋዳን ያጌዳ፤ “ሀዌ ኡባ ገደ ቆፈታና ማላ ሀዋ ማጻፋን ጻፋ። ያታደ ኢያሳ ስሰናን አጎፓ፤ አያዉ ጎፐ፥ ሳሉዋፐ ጋርሳን ታን አማሌቃ አሳቱዋ ዛር ቆፈተናዳን ጭራና ይሳና” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">17:14 </char><char style="xt" closed="false"><ref loc="DEU 25:17-19">ዛረ. 25:17-19</ref>፤ <ref loc="1SA 15:2-9">1 ሳሜላ 15:2-9</ref></char></note> <verse eid="EXO 17:14"/><verse number="15" style="v" sid="EXO 17:15"/>ሙሴ ያርሹዋ ያርሽያ ሳኣ ኬጺደ፥ “መና ጎዳይ ታዉ ጾኑዋ እሜ” ጊደ ሱንዳ። <verse eid="EXO 17:15"/><verse number="16" style="v" sid="EXO 17:16"/>እ ሀዋዳን ያጌዳ፤ “ኩሸቱ ፑደ መና ጎዳ ካዉተ አራታኮ ደንዴድኖ፤ የለታፐ የለታ ጋካናዉካ መና ጎዳይ አማሌቃቱዋና ኦለታናዋ” ያጌዳ።<verse eid="EXO 17:16"/></para>
  <chapter eid="EXO 17"/>
  <chapter number="18" style="c" sid="EXO 18"/>
  <para style="s1">ዮቶረ ሙሳ ጾሞሴዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 18:1"/>ሚድያማ ጋደ ቄሲ፥ ሙሴ ቦሉ ዮቶረ፥ ጾሳይ ሙሴዉነ አ አሳ እስራኤልያዉ ኦዳባ ኡባነ መና ጎዳይ እስራኤልያ ግብጼፐ ከሴዳዋ ስሴዳ።<verse eid="EXO 18:1"/></para>
  <para style="p">
    <verse number="2-3" style="v" sid="EXO 18:2-3"/>ሄ ዎደ ሙሴ ቦሉ፥ ዮቶረ፥ ሙሴ አኮ የዲደ ቤዳ አ ማቻቶ ጽፓሮነ እዝ ላኡ ናና አሄዳ። ኡንቱንቱፐ እቱዋ ሱንይ ገርሾማ፤<note caller="+" style="f"><char style="fr" closed="false">18:2-3 </char><char style="fq" closed="false">ገርሾማ፦ </char><char style="ft" closed="false">ሀ ሱን ብለይ እብራዌዋ ቃላን “በትያ” ግያዋ።</char></note> አያዉ ጎፐ፥ ሙሴ፥ “ታን አሳ ጋድያን በተ ግዳድ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">18:2-3 </char><char style="xt" closed="false"><ref loc="EXO 2:21-22">ከሳ 2:21-22</ref></char></note> <verse eid="EXO 18:2-3"/><verse number="4" style="v" sid="EXO 18:4"/>ላኤንዋ ሱንይ ኤልኣዛራ፤<note caller="+" style="f"><char style="fr" closed="false">18:4 </char><char style="fq" closed="false">ኤልኣዛራ፦ </char><char style="ft" closed="false">ሀ ሱን ብለይ እብራዌዋ ቃላን “ጾሳይ ታና ማዴ” ግያዋ።</char></note> አያዉ ጎፐ፥ እ፥ “ታ አዉዋ ጾሳይ ታና ማዴዳዋ፤ እ ታና ግብጼ ካትያ ማሻፐ አሼዳ” ያጌዳ።<verse eid="EXO 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 18:5"/>ሙሴ ቦሉ ዮቶረ አ አቱማ ናናነ አ ማቻትና ጾሳ ደርያ ማታን ደእያ ሙሴኮ መላ ቢታ ዬዳ። <verse eid="EXO 18:5"/><verse number="6" style="v" sid="EXO 18:6"/>እ ሙሳ፥ “ታን፥ ነ ቦሉ ዮቶረ፥ ነ ማቻትናነ እዝ ላኡ ናናቱዋና ኔኮ ያይ” ያጊደ አኮ ኪት ዎዳ።<verse eid="EXO 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 18:7"/>ሄዋ ድራዉ፥ ሙሴ ባረ ቦሉዋና ጋከታናዉ ከሲደ፥ አዉ ጎይኔዳ፥ አ የሬዳ። ኡንቱንቱ እቱ እቱዋ ሳሮደ፥ ዱንካንያ ግዶ ገሌድኖ። <verse eid="EXO 18:7"/><verse number="8" style="v" sid="EXO 18:8"/>መና ጎዳይ እስራኤልያ አሳ ድራዉ፥ ካትያ ቦላነ ግብጼቱዋ ቦላ ኦዳ ኡባ፥ ኦግያን ኡንቱንታ ጋኬዳ ዳቡራባ ኡባነ መና ጎዳይ ኡንቱንታ አሼዳዋ ሙሴ ባረ ቦሎ ኦዴዳ።<verse eid="EXO 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 18:9"/>እስራኤልያ አሳ ግብጼቱዋ ኩሽያፐ አሻናዉ መና ጎዳይ ኦዳ ሎኦ ኦሶቱዋባ ኡባ ስሲደ፥ ዮቶረ ናሸቴዳ። <verse eid="EXO 18:9"/><verse number="10" style="v" sid="EXO 18:10"/>ያቲደ “ህንተና ግብጼቱዋ ኩሽያፐነ ካትያ ኩሽያፐ አሼዳ መና ጎዳይ፥ ግብጼቱዋ ኩሽያፐ አሳ ከስ አኬዳዌ፥ እ ጋላተቶ። <verse eid="EXO 18:10"/><verse number="11" style="v" sid="EXO 18:11"/>መና ጎዳይ ሀራ ጾሳቱዋፐ ኡባፐ ዎልቃማ ግድያዋ ታን ሀእ ኤራድ፤ አያዉ ጎፐ፥ እ ሀ እስራኤልያ አሳ ቦላ ኦተረቴዳ ግብጼ ጾሳቱዋ ቦላ ሀዋ ኦዳ” ያጌዳ። <verse eid="EXO 18:11"/><verse number="12" style="v" sid="EXO 18:12"/>ሄዋፐ ጉይያን ዮቶረ፥ ሙሴ ቦሉ፥ ሹከቲደ ፖሎ ጹገትያ እት መህያ ያርሹዋነ ሀራ ያርሾ ሹከቴዳ አሹ ሜተትያ መህያ ያርሹዋ ጾሳዉ አሄዳ፤ አሮነነ እስራኤልያ ጭማቱ ኡባይ ጾሳ ስንን ሙሴ ቦሉዋና ቁማ ማናዉ ዬድኖ።<verse eid="EXO 18:12"/></para>
  <para style="s1">ዳናቱ ሱንቴድኖ</para>
  <para style="r">(<ref loc="DEU 1:9-18">ዛረ. 1:9-18</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 18:13"/>ዎንተ ጋላስ ሙሴ አሳዉ ፕርዳናዉ ኡቴዳ፤ አሳይ ሙሴ ዩሹዋን ዎንታፐ ኦማርስ ጋካናዉ ኤቄዳ። <verse eid="EXO 18:13"/><verse number="14" style="v" sid="EXO 18:14"/>ሙሴ ቦሉ ሙሴ አሳዉ ኦያዋ ኡባ በኢደ፥ “ኔን ሀ አሳዉ ኦያዌ ሀዌ አዬ? አሳይ ኡባይ ዎንታፐ ዶሚደ ኦማርስ ጋካናዉ ነ ዩሹዋን ኤቂደእሽን፥ ኔን ኔረካ ዳናዳን አያዉ ኡታድ?” ያጌዳ።<verse eid="EXO 18:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 18:15"/>ሙሴ ባረ ቦሉዋ፥ “አሳይ ጾሳ ሸንያ ኦቻናዉ ታኮ ይያ ድራሳ። <verse eid="EXO 18:15"/><verse number="16" style="v" sid="EXO 18:16"/>ኡንቱንቶ የዉ ደኦፐ ታኮ ዪኖ፤ ታን እት ኡራ ግዱዋንነ አ ሾሩዋ ግዱዋን ፕርዳይ፤ ጾሳ አዛዙዋነ ዎጋ ኡንቱንታ ኤርሳይ” ያጌዳ።<verse eid="EXO 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 18:17"/>ሙሴ ቦሉ፥ “ሀዌ ኔን ኦያባይ ሎኤና። <verse eid="EXO 18:17"/><verse number="18" style="v" sid="EXO 18:18"/>ኔንነ ኔናና ደእያ አሳይ ዳቡራ ጻላላ ግዲታ፤ ሀ ኪታይ ነዉ ሎይ ዴጾ፤ ኔን ሀዋ ኔረካ ኦናዉ ዳንዳያካ። <verse eid="EXO 18:18"/><verse number="19" style="v" sid="EXO 18:19"/>አነ ሀእ ታን ኦድያዋ ስሳ፤ ታን ኔና ዞራና፤ ጾሳይ ኔናና ግዶ። ኔን ሀ አሳ ድራዉ ጾሳ ስን አ፤ ኔን ኡንቱንቱ የዉዋ ጾሳኮ አሀ። <verse eid="EXO 18:19"/><verse number="20" style="v" sid="EXO 18:20"/>አዛዙዋነ ዎጋ ኡንቱንታ ኔን ታማርሳ፤ ኡንቱንቱ ደአና ማራነ ኦና ኦሱዋ ኡባ ኡንቱንታ በሳ። <verse eid="EXO 18:20"/><verse number="21" style="v" sid="EXO 18:21"/>ቃይ አሳ ኡባ ግዶን ዳንዳይያ አሳቱዋ፥ ጾሳዉ ያይያዋንታ፥ አማነቴዳዋንታነ ማጋንጻ ምያዋ እጽያዋንታ ዶራደ ኡንቱንቱፐ አሳዉ ሻኣ ካፓቱዋ፥ ጼቱዋ ካፓቱዋ፥ እሻታሙዋ ካፓቱዋነ ታሙዋ ካፓቱዋ ሱን። <verse eid="EXO 18:21"/><verse number="22" style="v" sid="EXO 18:22"/>ኡንቱንቱ ኡባ ዎደ አሳዉ ፕርድኖ፤ ሽን ዋይስያ የዉዋ ኡባ ኔኮ አህኖ፤ ዋይሰና የዉዋ ኡባ ኡንቱንቱ ዉርስኖ። ኡንቱንቱ ኔናና ሻከትያ ድራዉ፥ ቶኩ ነዉ ካዉሻናዋ። <verse eid="EXO 18:22"/><verse number="23" style="v" sid="EXO 18:23"/>ኔን ሄዋዳን ኦፐነ ሀዌ ጾሳ አዛዞ ግዶፐ፥ ኔን ዳንዳያና። ቃይ ሀ አሳይ ኡባይካ ባረ አላሊ ፖለትና፥ ባረ ሶ ባረ ሶ ባናዋ” ያጌዳ።<verse eid="EXO 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 18:24"/>ሙሴ ባረ ቦሉዋ ቃላ ስሴዳ፤ እ ጌዳዋ ኡባካ ኦዳ። <verse eid="EXO 18:24"/><verse number="25" style="v" sid="EXO 18:25"/>ሙሴ እስራኤልያ ኡባ ግዶፐ ዳንዳይያ አሳቱዋ ዶሪደ አሳ ካለያ ሻኣ ካፓቱዋ፥ ጼቱዋ ካፓቱዋ፥ እሻታሙዋ ካፓቱዋነ ታሙዋ ካፓቱዋ ሱንዳ። <verse eid="EXO 18:25"/><verse number="26" style="v" sid="EXO 18:26"/>ኡንቱንቱ አሳዉ ኡባ ዎደ ፕርዴድኖ፤ ኡንቱንቱ ባረና ዴጼዳ የዉዋ ሙሴኮ አሄድኖ፤ ሽን ዴጸና የዉዋ ኡባ ኡንቱንቱ ዉርሴድኖ።<verse eid="EXO 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 18:27"/>ሄዋፐ ጉይያን ሙሴ ባረ ቦሉዋ ሞይዝና ዮቶረ ባረ ጋድያ ስሜዳ።<verse eid="EXO 18:27"/></para>
  <chapter eid="EXO 18"/>
  <chapter number="19" style="c" sid="EXO 19"/>
  <para style="ms">ህግያነ ቃላ ጫቁዋ</para>
  <para style="mr">(<ref loc="EXO 19:1-24:18">19:1—24:18</ref>)</para>
  <para style="s1">ጾሳይ ሲና ደርያን ቆንጬዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 19:1"/>እስራኤልያ አሳይ ግብጼፐ ከሴዳ ሄዘን አግናን ሄ ኮይሮ ጋላሳን ሲና መላ ቢታ ጋኬድኖ። <verse eid="EXO 19:1"/><verse number="2" style="v" sid="EXO 19:2"/>ኡንቱንቱ ራፊድመፐ ደንዲደ ሲና መላ ቢታ ቢደ፥ ሄዋን ደእያ ደርያ ስን መላ ቢታን ኡቴድኖ።<verse eid="EXO 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 19:3"/>ሙሴ ጾሳኮ ፑደ ደርያ ሁጲያ ከስና፥ መና ጎዳይ ደርያ ሁጲያን አ ጼሲደ፥ “ኔን ያቆባፐ የለቴዳ እስራኤልያ አሳዉ ሀዋዳን ያጋደ ኦዳ፤ <verse eid="EXO 19:3"/><verse number="4" style="v" sid="EXO 19:4"/>‘ታን ግብጼቱዋ ቦላ አያ ኦድታንቶነ ቃይ አርጋን ቀፍያን ታን ህንተንታ ዋታ ቶካደ ታኮ አሃድታንቶነ ህንተንቱ ህንተንቱ ሁጲያዉ በኤድታ። <verse eid="EXO 19:4"/><verse number="5" style="v" sid="EXO 19:5"/>ስም ሀእ ህንተንቱ ታዉ ሎይ አዛዘቶፐነ ታ ቃላ ጫቁዋ ናጎፐ፥ አሳ ኡባ ግዶን ህንተንቱ ታዉ ቡዞ ግዳና። ኩመን ሳአይ ታዋ ግዶፐነ<note caller="-" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="DEU 4:20">ዛረ. 4:20</ref>፤ <ref loc="DEU 7:6">7:6</ref>፤ <ref loc="DEU 14:2">14:2</ref>፤ <ref loc="DEU 26:18">26:18</ref>፤ <ref loc="TIT 2:14">ቲቶ 2:14</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">19:5-6 </char><char style="xt" closed="false"><ref loc="1PE 2:9">1 ጰጽ. 2:9</ref></char></note> <verse eid="EXO 19:5"/><verse number="6" style="v" sid="EXO 19:6"/>ህንተንቱ ታ ካዉተ ቄሳቱዋነ ጌሻ አሳ ግዳና’ ያጋ፤ ኔን እስራኤላቶ ኦዳና ቃላይ ሀዋ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">19:6 </char><char style="xt" closed="false"><ref loc="REV 1:6">ሳፃ 1:6</ref>፤ <ref loc="REV 5:10">5:10</ref></char></note><verse eid="EXO 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 19:7"/>ሙሴ ጉየ ስም ቢደ፥ አሳ ካለያዋንታ ጼስ ሺሺደ፥ መና ጎዳይ ኦዳ ጌዳ ሀ ቃላቱዋ ኡባ ኡንቱንቶ ኦዴዳ። <verse eid="EXO 19:7"/><verse number="8" style="v" sid="EXO 19:8"/>አሳይ ኡባይ እት ዶና ግዲደ፥ “መና ጎዳይ ጌዳዋ ኡባ ኑን ኦና” ያጌድኖ። ሙሴካ ኡንቱንቱ ጌዳዋ መና ጎዳኮ አፌዳ።<verse eid="EXO 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 19:9"/>መና ጎዳይ ሙሳ፥ “ታን ኔናና ሃሳይሽን አሳይ ስሳናዳንነ ኡንቱንቱ ኔናን ኡባ ዎደካ አማነታናዳን፥ ታን ኔኮ ዎልቃማ ሻርያ ግዱዋና ያና” ያጌዳ። ሄዋፐ ጉይያን ሙሴ አሳይ ጌዳዋ መና ጎዳዉ ኦዴዳ።<verse eid="EXO 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 19:10"/>መና ጎዳይ ሙሳ፥ “ኔን አሳኮ ባደ ሀቼነ ዎንት ኡንቱንቱ ጌያናዳን ኦዳ። ኡንቱንቱ ባረንቱ ማዩዋ ሜጪደ፤ <verse eid="EXO 19:10"/><verse number="11" style="v" sid="EXO 19:11"/>ሄዘን ጋላሳዉ ጊግኖ። አያዉ ጎፐ፥ ሄዘን ጋላሳን አሳይ ኡባይ በእሽን፥ መና ጎዳይ ሲና ደርያ ቦላን ዎናዋ። <verse eid="EXO 19:11"/><verse number="12" style="v" sid="EXO 19:12"/>ኔን ሀ ደርያ ዩሹዋን አሳዉ ዛዋ ዎደ ኡንቱንቶ፥ ‘ደርያ ፑደ ከሰናዳን ዎይ ደርያ ጻጱዋ ቦቼናዳን ህንተንታ ኤርተ። ደርያ ቦቼዳ ኦንነ ቱሙፐ ሀይቃናዋ።<note caller="-" style="x"><char style="xo" closed="false">19:12-13 </char><char style="xt" closed="false"><ref loc="HEB 12:18-20">እብራ. 12:18-20</ref></char></note> <verse eid="EXO 19:12"/><verse number="13" style="v" sid="EXO 19:13"/>ሄ ኡራይ ሹቻን ጫደቲደ ዎይ ዎንዳፍያን ጫደቲደ ሀይቆፐ አትን፤ እ ኩሽያን ቦሸቶፖ። መሄ፥ ዎይ አሳ ግዶፐነ እ ሸምፑዋና አተና’ ያጋ። ማላካታይ ፑነትያ ዎደ፥ ሄ ዎደ ኡንቱንቱ ደርያ ፑደ ከሳና ጎፐ ከስኖ” ያጌዳ።<verse eid="EXO 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 19:14"/>ሙሴ ደርያፐ አሳኮ ዱገ ዎዳዋፐ ጉይያን ኡንቱንታ ጌያናዳን ኦድና፥ ኡንቱንቱ ባረንቱ ማዩዋ ሜጬድኖ። <verse eid="EXO 19:14"/><verse number="15" style="v" sid="EXO 19:15"/>ሄዋፐ ጉይያን አሳ እ፥ “ሄዘን ጋላሳዉ ጊግተ፤ ማችያና አቆፕተ” ያጌዳ።<verse eid="EXO 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 19:16"/>ሄዘን ጋላስ ዎንታ ጉጉን ጉንይ ስሰቴዳ። ዋልቃንይነ ዎልቃማ ሻሪ ደርያ ማዪደ ቤቴዳ፤ ማላካታይካ ፑነትያ ዎልቃማ ኮሻይ ስሰቴዳ። ሄዋ ድራዉ፥ ባረ ደእያ ሳኣን አሳይ ኡባይ ኮኮሬዳ።<note caller="-" style="x"><char style="xo" closed="false">19:16 </char><char style="xt" closed="false"><ref loc="REV 4:5">ሳፃ 4:5</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">19:16-18 </char><char style="xt" closed="false"><ref loc="DEU 4:11-12">ዛረ. 4:11-12</ref></char></note> <verse eid="EXO 19:16"/><verse number="17" style="v" sid="EXO 19:17"/>ሄዋፐ ጉይያን ሙሴ አሳ ጾሳና ጋናዉ ኡንቱንቱ ደእያ ዱንካንያፐ ከሴዳ፤ ኡንቱንቱ ደርያ ጋርሳ ደምባን ኤቄድኖ። <verse eid="EXO 19:17"/><verse number="18" style="v" sid="EXO 19:18"/>መና ጎዳይ ሲና ደርያ ቦላን ታማና ዎዳ ድራዉ፥ ሲና ደሪ ጩዋን ካመቴዳ። ዎልቃማ ጉዱዋፐ ጩዋይ ከስያዋዳን፥ አፐ ጩዋይ ፑደ ከሴዳ። አሳይ ኡባይ ሎይ ኮኮሬዳ። <verse eid="EXO 19:18"/><verse number="19" style="v" sid="EXO 19:19"/>ማላካታ ፑኑ ሎይ ዳር ዳር ቤዳ ዎደ፥ ሙሴ ሃሳይና፥ ጾሳ ኮሻይ አዉ ዛሪደ ሃሳዬዳ። <verse eid="EXO 19:19"/><verse number="20" style="v" sid="EXO 19:20"/>መና ጎዳይ ሲና ደርያ ኪክያን ዎደ፥ ሙሳ ፑደ ደርያዉ ኪክያ ጼስና ሙሴ ፑደ ከሴዳ። <verse eid="EXO 19:20"/><verse number="21" style="v" sid="EXO 19:21"/>መና ጎዳይ አ፥ “ኔን ዱገ ባደ አሳይ መና ጎዳ በአና ጊደ፥ ዛዋ አናዳንነ ኡንቱንቱፐ ዳሩ ሀይቀናዳን አሳ ሴራ። <verse eid="EXO 19:21"/><verse number="22" style="v" sid="EXO 19:22"/>ሀራይ አቶ መና ጎዳ ማታ ሺቅያ ቄሳቱካ ባረና ጌሻናዉ ኮሼ፤ ሄዌ ዮፐ፥ መና ጎዳይ ኡንቱንታ ሙራና” ያጌዳ።<verse eid="EXO 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 19:23"/>ሙሴ መና ጎዳ፥ “አሳይ ደርያ ፑደ ያናዉ ዳንዳየና፤ አያዉ ጎፐ፥ ኔን ነ ሁጲያዉ፥ ‘ሀ ሳኣ ጌሻዳን ዱማዪደ፥ ሀ ደርያ ዩሹዋን ዛዋ ዎተ’ ጋደ ኑዉ ኦዳ ዎዳ” ያጌዳ።<verse eid="EXO 19:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 19:24"/>መና ጎዳይ አ፥ “ኔን ዱገ ባደ አሮና ኔናና ፑደ አካደ ያ። ቄሳቱዋነ አሳ መና ጎዳይ ሙረናዳን፥ ኡንቱንቱ ዛዋ አደ ፑደ መና ጎዳኮ ዮፕኖ” ያጌዳ። <verse eid="EXO 19:24"/><verse number="25" style="v" sid="EXO 19:25"/>ሄዋ ድራዉ፥ ሙሴ ዱገ አሳኮ ዎደ፥ ጾሳይ ጌዳዋ ኡንቱንቶ ኦዴዳ።<verse eid="EXO 19:25"/></para>
  <chapter eid="EXO 19"/>
  <chapter number="20" style="c" sid="EXO 20"/>
  <para style="s1">ታሙ አዛዛቱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 20:1"/>ጾሳይ ሀ ቃላቱዋ ኡባ ሀዋዳን ያጊደ ሃሳዬዳ፤ <verse eid="EXO 20:1"/><verse number="2" style="v" sid="EXO 20:2"/>“ኔና ግብጼፐ አይለተ ጋድያፐ ከሴዳ መና ጎዳይ ነ ጾሳይ ታና።<verse eid="EXO 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 20:3"/>“ታፐ አትና፥ ሀራ ጾሳዉ ጎይኖፓ።<verse eid="EXO 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 20:4"/>“ቦላ ሳሉዋን ደእያ፥ ዎይ ጋርሳ ሳኣን ደእያ፥ ዎይ ሳኣፐ ጋርሳን ሃ ግዶን ደእያ አያነ ማላትሳደ ነዉ ጎይንያ ምስለቱዋ ኦፓ።<note caller="-" style="x"><char style="xo" closed="false">20:4-5 </char><char style="xt" closed="false"><ref loc="EXO 34:17">ከሳ 34:17</ref>፤ <ref loc="LEV 19:4">ዎጋ 19:4</ref>፤ <ref loc="LEV 26:1">26:1</ref>፤ <ref loc="DEU 4:15-18">ዛረ. 4:15-18</ref>፤ <ref loc="DEU 27:15">27:15</ref></char></note> <verse eid="EXO 20:4"/><verse number="5" style="v" sid="EXO 20:5"/>ኡንቱንቶ ሆኮፓ ዎይ ኡንቱንቶ ጎይኖፓ። አያዉ ጎፐ፥ ታን፥ መና ጎዳይ ነ ጾሳይ ቃናታንቻ ጾሳ፤ ታና እጽያዋንታ አዎቱዋ ናጋራ ድራዉ፥ ናና ሄዘን የለታነ ኦይደን የለታ ጋካናዉ ሙርያዋ።<note caller="-" style="x"><char style="xo" closed="false">20:5-6 </char><char style="xt" closed="false"><ref loc="EXO 34:6-7">ከሳ 34:6-7</ref>፤ <ref loc="NUM 14:18">ፓይ. 14:18</ref>፤ <ref loc="DEU 7:9-10">ዛረ. 7:9-10</ref></char></note> <verse eid="EXO 20:5"/><verse number="6" style="v" sid="EXO 20:6"/>ቃይ ታና ሲቅያነ ታ አዛዙዋ ናግያዋንቶ ሻአ የለታይ ጋካናዉ ላመተና ሲቁዋ በስያ መና ጎዳ።<verse eid="EXO 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 20:7"/>“መና ጎዳ ነ ጾሳ ሱን ጮ ደንፓ፤ አያዉ ጎፐ፥ ጾሳይ ባረ ሱን ጮ ደንያዋ ሙራና።<note caller="-" style="x"><char style="xo" closed="false">20:7 </char><char style="xt" closed="false"><ref loc="LEV 19:12">ዎጋ 19:12</ref></char></note><verse eid="EXO 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 20:8"/>“ጌሻ ኦደ፥ ሳምባታ ጋላሳ ናጋ።<note caller="-" style="x"><char style="xo" closed="false">20:8 </char><char style="xt" closed="false"><ref loc="EXO 16:23-30">ከሳ 16:23-30</ref>፤ <ref loc="EXO 31:12-14">31:12-14</ref></char></note> <verse eid="EXO 20:8"/><verse number="9" style="v" sid="EXO 20:9"/>ኔን ኦያ ኦሱዋ ኡባ ኡሱፑን ጋላሳቱዋን ኦ።<note caller="-" style="x"><char style="xo" closed="false">20:9-10 </char><char style="xt" closed="false"><ref loc="EXO 23:12">ከሳ 23:12</ref>፤ <ref loc="EXO 31:15">31:15</ref>፤ <ref loc="EXO 34:21">34:21</ref>፤ <ref loc="EXO 35:2">35:2</ref>፤ <ref loc="LEV 23:3">ዎጋ 23:3</ref></char></note> <verse eid="EXO 20:9"/><verse number="10" style="v" sid="EXO 20:10"/>ሽን ላፑን ጋላሳይ መና ጎዳ ነ ጾሳዉ ሳምባታ። ሄ ጋላስ አይ ኦሱዋነ ኦፓ፤ ኔን፥ ዎይ ነ አቱማ ናአይ፥ ዎይ ነ ማጫ ናና፥ ዎይ ነ ማጫነ አቱማ ቆማቱ፥ ዎይ ነ ሚዛይ፥ ዎይ ህንተንቱና ደእያ እስራኤልያ ግደና አሳይ ሄ ጋላሳን አይ ኪታካ ኪተቶፖ። <verse eid="EXO 20:10"/><verse number="11" style="v" sid="EXO 20:11"/>አያዉ ጎፐ፥ ኡሱፑን ጋላሳ ግዶን መና ጎዳይ ሳሉዋነ፥ ሳኣ፥ አባነ ኡንቱንቱ ግዶን ደእያ ኡባ መዳ፤ ሽን ላፑን ጋላሳን ሸምፔዳ። ሄዋ ድራዉ፥ መና ጎዳይ ሳምባታ ጋላሳ አንጄዳነ ጌሼዳ።<note caller="-" style="x"><char style="xo" closed="false">20:11 </char><char style="xt" closed="false"><ref loc="GEN 2:1-3">ዶመ 2:1-3</ref>፤ <ref loc="EXO 31:17">ከሳ 31:17</ref></char></note><verse eid="EXO 20:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 20:12"/>“መና ጎዳይ ነ ጾሳይ ነዉ እምያ ቢታን ነ ላይይ አዱቃና ማላ፥ ነ አባነ ነ ዳዮ ቦንቻ።<note caller="-" style="x"><char style="xo" closed="false">20:12 </char><char style="xt" closed="false"><ref loc="DEU 27:16">ዛረ. 27:16</ref>፤ <ref loc="MAT 15:4">ማቶሳ 15:4</ref>፤ <ref loc="MAT 19:19">19:19</ref>፤ <ref loc="MRK 7:10">ማር. 7:10</ref>፤ <ref loc="MRK 10:19">10:19</ref>፤ <ref loc="LUK 18:20">ሉቃሳ 18:20</ref>፤ <ref loc="EPH 6:2">ኤፈ. 6:2</ref>፣ <ref loc="EPH 6:3">3</ref></char></note><verse eid="EXO 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 20:13"/>“አሳ ዎፓ።<note caller="-" style="x"><char style="xo" closed="false">20:13 </char><char style="xt" closed="false"><ref loc="GEN 9:6">ዶመ 9:6</ref>፤ <ref loc="LEV 24:17">ዎጋ 24:17</ref>፤ <ref loc="MAT 5:21">ማቶሳ 5:21</ref>፤ <ref loc="MAT 19:18">19:18</ref>፤ <ref loc="MRK 10:19">ማር. 10:19</ref>፤ <ref loc="LUK 18:20">ሉቃሳ 18:20</ref>፤ <ref loc="ROM 13:9">ሮመ 13:9</ref>፤ <ref loc="JAS 2:11">ያቆባ 2:11</ref></char></note><verse eid="EXO 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 20:14"/>“ዎሹሞፓ።<note caller="-" style="x"><char style="xo" closed="false">20:14 </char><char style="xt" closed="false"><ref loc="GEN 9:6">ዶመ 9:6</ref>፤ <ref loc="LEV 24:17">ዎጋ 24:17</ref>፤ <ref loc="MAT 5:21">ማቶሳ 5:21</ref>፤ <ref loc="MAT 19:18">19:18</ref>፤ <ref loc="MRK 10:19">ማር. 10:19</ref>፤ <ref loc="LUK 18:20">ሉቃሳ 18:20</ref>፤ <ref loc="ROM 13:9">ሮመ 13:9</ref>፤ <ref loc="JAS 2:11">ያቆባ 2:11</ref></char></note><verse eid="EXO 20:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 20:15"/>“ዉኦፓ።<note caller="-" style="x"><char style="xo" closed="false">20:15 </char><char style="xt" closed="false"><ref loc="LEV 19">ዎጋ 19</ref>፤ <ref loc="LEV 11">11</ref>፤ <ref loc="MAT 19:18">ማቶሳ 19:18</ref>፤ <ref loc="MRK 10:19">ማር. 10:19</ref>፤ <ref loc="LUK 18:20">ሉቃሳ 18:20</ref>፤ <ref loc="ROM 13:9">ሮመ 13:9</ref></char></note><verse eid="EXO 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 20:16"/>“ነ ሾሩዋ ቦላን ዎርዱዋ ማርካቶፓ።<note caller="-" style="x"><char style="xo" closed="false">20:16 </char><char style="xt" closed="false"><ref loc="EXO 23:1">ከሳ 23:1</ref>፤ <ref loc="MAT 19:18">ማቶሳ 19:18</ref>፤ <ref loc="MRK 10:19">ማር. 10:19</ref>፤ <ref loc="LUK 18:20">ሉቃሳ 18:20</ref></char></note><verse eid="EXO 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 20:17"/>“ነ ሾሩዋ ጎልያ አሞቶፓ፤ ነ ሾሩዋ ማቻቶ፥ ዎይ አ ቆማ፥ ዎይ አ ቆማቶ፥ ዎይ አ ቦራ፥ ዎይ አ ሀርያ፥ ዎይ አዉ ደእያዋ አያነ አሞቶፓ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">20:17 </char><char style="xt" closed="false"><ref loc="ROM 7:7">ሮመ 7:7</ref>፤ <ref loc="ROM 13:9">13:9</ref></char></note><verse eid="EXO 20:17"/></para>
  <para style="s1">አሳ ያሻ</para>
  <para style="r">(<ref loc="DEU 5:22-33">ዛረ. 5:22-33</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 20:18"/>አሳይ ኡባይ ጉጉንይ ጉጉምያዋነ ዋልቃንይ ዎልቃምያዋ በኤዳ፤ ማላካታ ዋሱዋ ስሴዳ፤ ቃይ ደሪ ጩዋትያዋካ በኤዳ፤ አሳይ ያሻን ኮኮሪደ፥ ሃኩዋን ኤቄዳ።<note caller="-" style="x"><char style="xo" closed="false">20:18-19 </char><char style="xt" closed="false"><ref loc="HEB 12:18-19">እብራ. 12:18-19</ref></char></note> <verse eid="EXO 20:18"/><verse number="19" style="v" sid="EXO 20:19"/>ኡንቱንቱ ሙሳ፥ “ኔን ኑዉ ሃሳያ፤ ኑን ስሳና፤ ሽን ኑን ሀይቀናዳን፥ ጾሳይ ኑዉ ሃሳዮፖ” ያጌድኖ። <verse eid="EXO 20:19"/><verse number="20" style="v" sid="EXO 20:20"/>ሙሴ አሳ፥ “ጾሳይ ህንተንታ ፓጫናዉ፥ ናጋራ ህንተንቱ ኦና ማላ፥ አ ያሻይ ህንተንቱ ዎዛናን ደአናዳን፥ እ ዬዳ ድራዉ ያዮፕተ” ያጌዳ። <verse eid="EXO 20:20"/><verse number="21" style="v" sid="EXO 20:21"/>አሳይ ሃክ ኤቂደእሽን፥ ጾሳይ ደእያ ሳኣ ዎልቃማ ማኮ ሙሴ ሺቄዳ።<verse eid="EXO 20:21"/></para>
  <para style="s1">ያርሽያ ሳአቱዋን ጎኤትያ ዎጋቱዋ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 20:22"/>ሄዋፐ ጉይያን፥ መና ጎዳይ ሙሳ፥ “እስራኤልያ አሳዉ ሀዋዳን ያጋደ ኦዳ፤ ‘ታን ሳሉዋፐ ህንተንቶ ሃሳዬዳዋ ህንተንቱ ህንተንቱ ሁጲያዉ በኤድታ። <verse eid="EXO 20:22"/><verse number="23" style="v" sid="EXO 20:23"/>ታ ማታን አይ ኤቃነ ኦፕተ፤ ብራ ኤቃ ዎይ ዎርቃ ኤቃ ህንተንቶ ኦፕተ።<verse eid="EXO 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 20:24"/>“ ‘ኔን ታዉ ያርሹዋ ያርሽያ ሳኣ ኡርቃፐ መደ ነ ጹግያ ያርሹዋ፥ ነ እትፐተ ያርሹዋ፥ ነ ዶርሳቱዋነ ነ ዴሻቱዋፐ ነ ሚዛቱዋ አ ቦላ ያርሻ። ታ ሱንይ ቆፈታና ማላ ኦዳ ሳኣ ኡባን፥ ታን ህንተንቱኮ ያደ፥ ህንተንታ አንጃና። <verse eid="EXO 20:24"/><verse number="25" style="v" sid="EXO 20:25"/>ኔን ታዉ ያርሹዋ ያርሽያ ሳኣ ሹቻፐ መፐ፥ ማሰቴዳ ሹቻፐ መፓ፤ አያዉ ጎፐ፥ ኔን ማስያ ሚሻን አ ቦቾፐ፥ ነ አ ቱንሳሳ።<note caller="-" style="x"><char style="xo" closed="false">20:25 </char><char style="xt" closed="false"><ref loc="DEU 27:5-7">ዛረ. 27:5-7</ref>፤ <ref loc="JOS 8:31">ኢያሳ 8:31</ref></char></note> <verse eid="EXO 20:25"/><verse number="26" style="v" sid="EXO 20:26"/>ታ ያርሹዋ ሳኣ ፑደ ጋይያን ከሶፓ፤ አያዉ ጎፐ፥ ኔን ከስያ ዎደ፥ ነ ካሉ ቤተ’ ያጋደ ኦዳ።<verse eid="EXO 20:26"/></para>
  <chapter eid="EXO 20"/>
  <chapter number="21" style="c" sid="EXO 21"/>
  <para style="s1">አይለቱዋ ኦይቂያ ዎጋ</para>
  <para style="r">(<ref loc="GEN 15:12-18">ዶመ 15:12-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 21:1"/>“ኔን ኡንቱንቶ እማና ዎጋይ ሀዋ። <verse eid="EXO 21:1"/><verse number="2" style="v" sid="EXO 21:2"/>ኔን እብራዌ አይልያ ሻሞፐ፥ እ ነዉ ኡሱፑን ላይ ኦ፤ ሽን ላፑን ላይን እ አይነ ቃንጸናን፥ አይለተፐ ጮ ከሲደ ቦ።<note caller="-" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="LEV 25:39-46">ዎጋ 25:39-46</ref></char></note> <verse eid="EXO 21:2"/><verse number="3" style="v" sid="EXO 21:3"/>እ ባረካ ዬዳዋ ግዶፐ ባረካ ቦ፤ ባረ ማቻትና ዬዳዋ ግዶፐ፥ አ ማቻታካ አናና ቡ። <verse eid="EXO 21:3"/><verse number="4" style="v" sid="EXO 21:4"/>አ ጎዳይ አዉ ማቻቶ እሜዳዋ ግዶፐነ ማቻታ አዉ አቱማ ናና ዎይ ማጫ ናና የሌዳዋ ግዶፐ፥ ሄ ማቻታነ እዝ ናናይ አ ጎዳዋ፤ እ ባረካ ከሲደ ቦ። <verse eid="EXO 21:4"/><verse number="5" style="v" sid="EXO 21:5"/>ሽን ሄ አይሊ፥ ‘ታን ታ ጎዳ፥ ታ ማቻቶነ ታ ናና ሲቃይ፤ ታን አይለተፐ ከስከ ጎፐ፥’ <verse eid="EXO 21:5"/><verse number="6" style="v" sid="EXO 21:6"/>አ ጎዳይ አ ፕርድያዋንቱ ስን አ፤ ሄዋፐ ጉይያን ፐንገ ዎይ ፐንገ ማቃንያኮ አ አፊደ፥ አ ሀይ ጎን ሉኮ። ስም እ ባረ ደኡዋ ላይ ኡባን አዉ አይልያ ግዳናዋ።<verse eid="EXO 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 21:7"/>“አሳይ ባረ ማጫ ናቶ አይለተዉ ዛልኦፐ፥ አቱማ አይለቱ አይለተፐ ከስያዋዳን እዛ ከሱፑ። <verse eid="EXO 21:7"/><verse number="8" style="v" sid="EXO 21:8"/>እዛ ባረና ማቼተዉ ዶሪደ አፌዳ ጎዳዉ ሎአና ዮፐ፥ ጎዳይ እዞ ዎዝሳናዉ ኮሼ። እ እዝዉ አማነትቤና ድራዉ፥ እዞ አላጋዉ ዛልአናዉ አዉ ማታይ ባዋ። <verse eid="EXO 21:8"/><verse number="9" style="v" sid="EXO 21:9"/>እ እዞ ባረ ናአዉ እማናዉ ዶሮፐ፥ ማጫ ናትዉ በስያዋ እዝዉ ኦ። <verse eid="EXO 21:9"/><verse number="10" style="v" sid="EXO 21:10"/>እ ባረዉ ሀራ ማቻቶ አኮፐ፥ ኮይሮ ማቻትዉ ቁማ፥ ማዩዋ ዎይ አስናተነ ማቼተ ማታ ፓጭሶፖ። <verse eid="EXO 21:10"/><verse number="11" style="v" sid="EXO 21:11"/>እ ሀ ሄዙባቱዋ እዝዉ እማና ዮፐ፥ አይነ ሻሉዋ ጭገናን አይለተፐ ከሳደ ቡ።<verse eid="EXO 21:11"/></para>
  <para style="s1">ኢታቱ ሙረትያ ዎጋ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 21:12"/>“አሳ ሾጪደ ዎያ አሳ ቱሙፐ ዎናዉ በሴ።<note caller="-" style="x"><char style="xo" closed="false">21:12 </char><char style="xt" closed="false"><ref loc="LEV 24:17">ዎጋ 24:17</ref></char></note> <verse eid="EXO 21:12"/><verse number="13" style="v" sid="EXO 21:13"/>ሽን ኤሪደ ግደናን እ ዎያ ዎደ፥ ታን፥ ጾሳይ ጮኡ ጌዳዋ ግዶፐ፥ እ ባቃታና ሳኣ ኡንቱንቶ ታን ጊግሳና።<note caller="-" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="NUM 35:10-34">ፓይ. 35:10-34</ref>፤ <ref loc="DEU 19:1-13">ዛረ. 19:1-13</ref>፤ <ref loc="JOS 20:1-9">ኢያሳ 20:1-9</ref></char></note> <verse eid="EXO 21:13"/><verse number="14" style="v" sid="EXO 21:14"/>ሽን ኦነ ቆፒደ ኤሪደ ሀራ ብታንያ ዎፐ፥ ሄ ኡራ ታ ያርሹዋ ሳኣፐ ድጋደ፥ ሀራ ሳኣን ዎ።<verse eid="EXO 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 21:15"/>“ባረ አባ ዎይ ባረ ዳዮ ደችያ ኡራይ ኦንነ ቱሙፐ ሀይቆ።<verse eid="EXO 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 21:16"/>“አሳ ዎልቃን ኦይቂደ ዛልእያ ኡራይ ዎይ ዎልቃን ኦይቄዳ አሳይ አ ኩሽያን ቤቴዳ አሳይ ቱሙፐ ሀይቃናዉ በሴ።<note caller="-" style="x"><char style="xo" closed="false">21:16 </char><char style="xt" closed="false"><ref loc="DEU 24:7">ዛረ. 24:7</ref></char></note><verse eid="EXO 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 21:17"/>“ባረ አባ ዎይ ባረ ዳዮ ሸቂያዌ ቱሙፐ ሀይቆ።<note caller="-" style="x"><char style="xo" closed="false">21:17 </char><char style="xt" closed="false"><ref loc="LEV 20:9">ዎጋ 20:9</ref>፤ <ref loc="MAT 15:4">ማቶሳ 15:4</ref>፤ <ref loc="MRK 7:10">ማር. 7:10</ref></char></note><verse eid="EXO 21:17"/></para>
  <para style="p">
    <verse number="18-19" style="v" sid="EXO 21:18-19"/>“ላኡ አሳቱ ዋላቀቶፐ፥ እቱ የንኩዋ ሹቻን ጫዶፐ ዎይ ቦክሶፐ፥ ሄ ደሸቴዳዌ ሀይቀናን አቶዋ ግዶፐነ ሀርጊደ ግሱዋን ጋምኦፐ፥ ደንዲደ ጉፍያና ካረ ሄራን ሀመቶፐ፥ ሄ ደቼዳዌ ሀይቁዋፐ አቴ፤ ግዶፐነ እ አ ኪታ ድጌዳ ድራዉ፥ ሻሉዋ ጭጋናዉነ አ ፓናዉ ማዳና ኮሼ።<verse eid="EXO 21:18-19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 21:20"/>“አሳይ ባረ አቱማ አይልያ ዎይ ማጫ አይላቶ ጻምአን ሾጮፐነ ሄዋ ጋሱዋን ሄ ኡራይ ሄ ጎዳ ኩሽያን ሀይቂንቶ፥ ሾጬዳዌ ቱሙፐ ሙረታናዉ በሴ። <verse eid="EXO 21:20"/><verse number="21" style="v" sid="EXO 21:21"/>ሽን ሄ ደሸቴዳዌ እት ዎይ ላኡ ጋላሳን ደንዶፐ፥ ሄ አይሊ አ ሚሻ ግድያ ድራዉ፥ እ ሙረተና።<verse eid="EXO 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 21:22"/>“ላኡ አሳቱ እቱ እቱዋና ዋቲደ ሻሃራ ምሽራቶ ደቾፐነ እዛ ቦሸቶፐ፥ ሄዋፐ ሀራ ኢታ ደሸይ ዮፐ፥ ሄ ምሽራት አስናይ ኦቼዳዋነ ዳናቱ ፕርዴዳዋ አያነ ጭጎ። <verse eid="EXO 21:22"/><verse number="23" style="v" sid="EXO 21:23"/>ሽን እዝዉ ደሸይ ዳሮፐ፥ ሸምፑ ሀይቂንቶ ሸምፑዋ፥ <verse eid="EXO 21:23"/><verse number="24" style="v" sid="EXO 21:24"/>አይፍያ ድራዉ አይፍያ፥ አቻ ድራዉ አቻ፥ ኩሽያ ድራዉ ኩሽያ፥ ገድያ ድራዉ ገድያ፥ <verse eid="EXO 21:24"/><verse number="25" style="v" sid="EXO 21:25"/>ጹገ ድራዉ ጹገ፥ ማዱ ድራዉ ማዱ፥ ቆኤዳ ድራዉ ቆኡዋ አካናዉ ኮሼ።<note caller="-" style="x"><char style="xo" closed="false">21:25 </char><char style="xt" closed="false"><ref loc="LEV 24:19-20">ዎጋ 24:19-20</ref>፤ <ref loc="DEU 19:21">ዛረ. 19:21</ref>፤ <ref loc="MAT 5:38">ማቶሳ 5:38</ref></char></note><verse eid="EXO 21:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 21:26"/>“እት አሳይ ባረ አቱማ አይልያዉ ዎይ ማጫ አይላትዉ አይፍያ ባቂደ ቶይሶፐ፥ ሄ አይፍያ ድራዉ አይለተፐ ከስ የዶ። <verse eid="EXO 21:26"/><verse number="27" style="v" sid="EXO 21:27"/>ሄዋዳንካ፥ ባረ አይልያ አቻ ዎይ ባረ አይላት አቻ መንፐ፥ ሄ አቻ ድራዉ አይለተፐ ከስ የዶ።<verse eid="EXO 21:27"/></para>
  <para style="s1">መህያ ጎዳቱ ፖልያባቱዋ</para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 21:28"/>“ቦራይ ማጫ አሳ ዎይ አቱማ አሳ ቃይጪደ ዎፐ፥ ሄ ቦራይ ሹቻን ጫደቲደ ሀይቆ፤ አ አሹ ሜተቶፖ። ሽን ቦራ ጎዳይ ሙረቶፖ። <verse eid="EXO 21:28"/><verse number="29" style="v" sid="EXO 21:29"/>ሽን ቦራይ ካሰካ ቃይጭያ ሜዚ ደእያዋ ግዲና፥ አሳይ አ ጎዳዉ ኦድ ዎና፥ አ ጎዳይ ቃቼናን እጽና፥ ቦራይ አቱማ አሳ ዎይ ማጫ አሳ ዎፐ፥ ሄ ቦራይ ሹቻን ጫደቲደ ሀይቆ፤ ቃይ አ ጎዳይካ ሀይቆ። <verse eid="EXO 21:29"/><verse number="30" style="v" sid="EXO 21:30"/>ሽን እ ባረና ዎዛናዳን ኦሸቶፐ፥ ኡንቱንቱ ኦቼዳዋ አያነ ጭጊደ፥ ባረ ሸምፑዋ ዎዞ። <verse eid="EXO 21:30"/><verse number="31" style="v" sid="EXO 21:31"/>ቦራይ አቱማ ናኣ ዎይ ማጫ ናቶ ቃይጪደ ዎፐካ፥ ፕርዳይ እት ማላ ግዶ። <verse eid="EXO 21:31"/><verse number="32" style="v" sid="EXO 21:32"/>ቦራይ አቱማ አይልያ ዎይ ማጫ አይላቶ ቃይጪደ ዎፐ፥ ቦራ ጎዳይ አይልያ ጎዳዉ ሀታሙ ብራ ሳንትምያ ጭጎ። ቦራይ ሹቻን ጫደቲደ ሀይቆ።<verse eid="EXO 21:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 21:33"/>“እት አሳይ ኦላ ቁምእያ ፖኪደ፥ ዎይ ኦላ ቦኪደ ቁምኤናን አጎፐ፥ ቦራይ ዎይ ሀሪ ሄ ኦላን ኩንዶፐ፥ <verse eid="EXO 21:33"/><verse number="34" style="v" sid="EXO 21:34"/>ሄ ኦላ ጎዳይ መህያ ጋትያ ጭጎ። እ አ ጎዳዉ ጋትያ ጭጊደ፥ ሀይቄዳ መህያ ባረዉ አኮ።<verse eid="EXO 21:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 21:35"/>“እት አሳ ቦራይ ሀራ ቦራ ቃይጪደ ዎፐ፥ ፓጻ ቦራ ዛልኢደ፥ አ ጋትያነ ሀይቄዳ ቦራ ልክያን ሻክ አክኖ። <verse eid="EXO 21:35"/><verse number="36" style="v" sid="EXO 21:36"/>ሽን ሄ ቦራይ ቃይጭያዋ ግድያዌ ካሰት ኤረትሽን፥ አ ጎዳይ አ ቃቼናን አጌዳዋ ግዶፐ፥ አ ጎዳይ ቦራ ጭጎ። ያቲደ ሄ ሀይቄዳዋ ባረዉ አኮ።<verse eid="EXO 21:36"/></para>
  <chapter eid="EXO 21"/>
  <chapter number="22" style="c" sid="EXO 22"/>
  <para style="s1">አሳይ ባረዉ ደእያዋ ናግያ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 22:1"/>“እት አሳይ ቦራ ዎይ ዶርሳ ዉኢደ ሹኮፐ፥ ዎይ ዛልኦፐ፥ ቦራ ድራዉ እቼሹ ቦራ፥ ዶርሳ ድራዉ ኦይዱ ዶርሳ ጭጎ።<verse eid="EXO 22:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 22:2"/>“ካይሱ ጎልያ ቦኪደ ኦይቀቶፐነ ሾጨቲደ ሀይቂንቶ፥ ሾጬዳዌ ሱ ጉሴዳዎ ኦሸተና። <verse eid="EXO 22:2"/><verse number="3" style="v" sid="EXO 22:3"/>ሽን ሄዌ ጻልቂ ዶል ክችና ሀኖፐ፥ እ ሄ ጉኬዳ ሱ አጩዋን ኦሸቴ። ካይሱ ባረ ዉኤዳዋ ዛሮ፤ ሽን አዉ አያይነ ዮፐ፥ ባረ ዉኤዳዋ ዛራናዉ እ ዛልኤቶ። <verse eid="EXO 22:3"/><verse number="4" style="v" sid="EXO 22:4"/>እ ዉኤዳ መሂ ፓጻ ደኢደ አ ኩሽያን ቤትንቶ፥ ቦራ፥ ዎይ ሀርያ፥ ዎይ ዶርሳ ግዶፐነ፥ እ ባረ ዉኤዳዋ ላኡ ኩሽያ አደ ጭጎ።<verse eid="EXO 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 22:5"/>“እት አሳይ ባረ መህያ ደምባን ዎይ ዎይንያ ቱራ ግዶን ሄምሽን፥ መሂ ሀራ አሳ ሾይቃፐ ሞፐ፥ እ ባረ ሾይቃፐ ዎይ ባረ ዎይንያ ቱራ ኡባፐ ሎእያዋ አፍላማ ጭጎ።<verse eid="EXO 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 22:6"/>“ጻራጋይ ደንዲደ አጉን ቡራና ላኢደ፥ ዶርያን ደእያ ካ፥ ዎይ ኤቁዋን ደእያ ካ፥ ዎይ ጎሻ ኡባ ምያዋ ግዶፐ፥ ኮይሮ ጻራጋ ኦይዳ ብታኒ አጫ ጭጎ።<verse eid="EXO 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 22:7"/>“እት አሳይ ብራ ዎይ ሀራ ሚሻ ናግሳናዉ ባረ ሾሮ ሀዳራ እምና፥ ሾሩዋ ሶፐ ሄ ሚሻይ ዉኤቶፐነ ካይሱ ኦይቀትንቶ፥ ካይሱ ሄ ሚሻዉ ላኡ ኩሽያ አደ ጭጎ። <verse eid="EXO 22:7"/><verse number="8" style="v" sid="EXO 22:8"/>ሽን ካይሱ ቤተናን ዮፐ፥ ጎልያ ጎዳይ ፕርድያዋንቱኮ ሺቂደ ባረ ሾሩዋ ሚሻ ቦላ ባረ ኩሽያ ዎቤናዋ ጫቆ።<verse eid="EXO 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 22:9"/>“አሳይ አይ ሞቱዋንካ፥ ቦራ ጋሱዋን፥ ዎይ ሀርያ ጋሱዋን፥ ዎይ ዶርሳ ጋሱዋን፥ ዎይ ማዩዋ ጋሱዋን፥ ዎይ ሀራ ባዬዳዋ ጋሱዋን፥ ‘ሀዌ ታዋ’ ጊደ ሞተቶፐ፥ ላኡ ባጋይካ ባረንቱ ሞቱዋ ፕርድያዋንቱ ስን አኖ፤ ፕርድያዋንቱ ባይዛንቻ ጌዳ ኡራይ ባረ ሾሮ ላኡ ኩሽያ አደ ጭጎ።<verse eid="EXO 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 22:10"/>“አሳይ ባረ ሾሮ ሀርያ፥ ዎይ ቦራ፥ ዎይ ዶርሳ፥ ዎይ ሀራ መህያ ናግሳናዉ ሀዳራ እምና ሀይቂንቶ፥ ዎይ ደሸትንቶ፥ ዎይ ኦንነ በኤናን ቦንቃንቻይ አፎፐ፥ <verse eid="EXO 22:10"/><verse number="11" style="v" sid="EXO 22:11"/>ሀዳራ ናግያዌ ባረ ሾሩዋ መህያ ቦላ ባረ ኩሽያ ዎቤናዋ መና ጎዳ ስንን ጫቂና፥ ኡንቱንቱ ግዶን ደእያ የዉ ማየቶ። ሄ መህያ ጎዳይ ጫቁዋ አኮ፤ ጭጋ እማናዉ ኮሸና። <verse eid="EXO 22:11"/><verse number="12" style="v" sid="EXO 22:12"/>ሽን መሂ ሾሩዋፐ ዉኤቴዳዋ ግዶፐ፥ እዛዎ ጭጎ። <verse eid="EXO 22:12"/><verse number="13" style="v" sid="EXO 22:13"/>ሄ መህያ ዶአይ መንሬደ ሜዳዋ ግዶፐ፥ ማርካ ግዳናዳን ዶአይ ሚሽን አቴዳዋፐ አኪደ ዮ፤ ያቲደ መኤረቴዳ መህያ ድራዉ ጭጎፖ።<verse eid="EXO 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 22:14"/>“አሳይ ባረ ሾሩዋፐ መህያ ጋርጾፐነ አ ጎዳይ ባይና ሳኣን ሄ መሂ ደሸቶፐ ዎይ ሀይቆፐ፥ ሄ መህያ ጭጎ። <verse eid="EXO 22:14"/><verse number="15" style="v" sid="EXO 22:15"/>ሽን አ ጎዳይ አናና ደኦፐ፥ ጋርጼዳዌ ጭጎፖ፤ ከራዉ አኬዳዋ ግዶፐ፥ ከራዉ ጭግያ ሻሉ አጩዋ ጭጌዳ።<verse eid="EXO 22:15"/></para>
  <para style="s1">ጌሻ ደኡዋነ አማኑዋ ዎጋ</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 22:16"/>“እት አሳይ አስናዉ ጊጋቤና ዎዶራቶ ጭሚደ፥ እዝና ግስያዋ ግዶፐ፥ እዞ ጭሎሺደ ባረዉ ማቻቶ ኦ።<note caller="-" style="x"><char style="xo" closed="false">22:16-17 </char><char style="xt" closed="false"><ref loc="DEU 22:28-29">ዛረ. 22:28-29</ref></char></note> <verse eid="EXO 22:16"/><verse number="17" style="v" sid="EXO 22:17"/>እዝ አቡ እዞ አዉ እማናዉ እጾፐ፥ ዎዶራቶ አክያ ኡራይ ጭሎሽያዋ ኬሻ ብራ እ አቦ እሞ።<verse eid="EXO 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 22:18"/>“ብትያ ምሽራቶ ፓጻ ዎፓ።<note caller="-" style="x"><char style="xo" closed="false">22:18 </char><char style="xt" closed="false"><ref loc="DEU 18:10">ዛረ. 18:10</ref>፣ <ref loc="DEU 18:11">11</ref></char></note><verse eid="EXO 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 22:19"/>“መህያና ግስያ ኦንነ ቱሙፐ ሀይቆ።<note caller="-" style="x"><char style="xo" closed="false">22:19 </char><char style="xt" closed="false"><ref loc="LEV 22:19">ዎጋ 22:19</ref>፤ <ref loc="LEV 20:15-16">20:15-16</ref>፤ <ref loc="DEU 27:21">ዛረ. 27:21</ref></char></note><verse eid="EXO 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 22:20"/>“መና ጎዳ ጻላላሳፐ አትና፥ ሀራ ጾሳዉ ያርሽያዌ ኦንነ ሙለ ዮ።<note caller="-" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="DEU 17:2-7">ዛረ. 17:2-7</ref></char></note> <verse eid="EXO 22:20"/><verse number="21" style="v" sid="EXO 22:21"/>በቲደ ዬዳ አሳ ቆሆፕተ ዎይ ኡንኦፕተ፤ አያዉ ጎፐ፥ ህንተንቱካ ግብጼ ጋድያን በተ ግዲደ ደኤድታ።<note caller="-" style="x"><char style="xo" closed="false">22:21-22 </char><char style="xt" closed="false"><ref loc="EXO 23:9">ከሳ 23:9</ref>፤ <ref loc="LEV 19:33-34">ዎጋ 19:33-34</ref>፤ <ref loc="DEU 24:17-18">ዛረ. 24:17-18</ref>፤ <ref loc="DEU 27:19">27:19</ref></char></note> <verse eid="EXO 22:21"/><verse number="22" style="v" sid="EXO 22:22"/>አስናይ ሀይቄዳ አምአቶነ አዉ ሀይቄዳ ህዬሳ ኡንኦፕተ። <verse eid="EXO 22:22"/><verse number="23" style="v" sid="EXO 22:23"/>ህንተንቱ ኡንቱንታ ኡንኤና፥ ኡንቱንቱ ታኮ ዋሶፐ፥ <verse eid="EXO 22:23"/><verse number="24" style="v" sid="EXO 22:24"/>ታን ኡንቱንቱ ዋሱዋ ቱሙፐ ስሳና፤ ሄ ዎደ ታ ሀንቁ ህንተንቱ ቦላ ደንዳና፤ ታን ህንተንታ ማሻን ዉርሳና፤ ህንተንቱ ማቻቱ አምኤ ህንተንቱ ናናይካ አዉ ሀይቆዋንታ ግዳናዋንታ።<verse eid="EXO 22:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 22:25"/>“ህንተንቱ ግዶን ደእያ ታ አሳፐ እት ህዬሳዉ ሻሉዋ ታልኦፐ፥ ሻሉዋ ድቻዉ እምያ አሳዳን ሀኖፕተ፤ ኔን ድቻ አ ኦቾፓ።<note caller="-" style="x"><char style="xo" closed="false">22:25 </char><char style="xt" closed="false"><ref loc="LEV 25:35-38">ዎጋ 25:35-38</ref>፤ <ref loc="DEU 15:7-11">ዛረ. 15:7-11</ref>፤ <ref loc="DEU 23:19-20">23:19-20</ref></char></note> <verse eid="EXO 22:25"/><verse number="26" style="v" sid="EXO 22:26"/>ኔን አጩዋ ድራዉ ነ ላግያ ማዩዋ ኦይቆፐ፥ አዋይ ዉለናን ደእሽን አዉ ዛራ፤<note caller="-" style="x"><char style="xo" closed="false">22:26-27 </char><char style="xt" closed="false"><ref loc="DEU 24:10-13">ዛረ. 24:10-13</ref></char></note> <verse eid="EXO 22:26"/><verse number="27" style="v" sid="EXO 22:27"/>አያዉ ጎፐ፥ እ ባረ ቦላ ካምያዌ ሄን ጻላላና፤ ሀራባ አያ ማዪደ አቃናዉ ዳንዳዪ? እ ታዉ ዋሶፐ፥ ታን ቃረትያዋ ግድያ ድራዉ፥ ስሳና።<verse eid="EXO 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 22:28"/>“ጾሳ ቦላ ሸቃ ቃላ ሃሳዮፓ፥ ዎይ ነ ደርያ ሞድያዋ ሸቆፓ።<note caller="-" style="x"><char style="xo" closed="false">22:28 </char><char style="xt" closed="false"><ref loc="ACT 23:5">ኪታ 23:5</ref></char></note> <verse eid="EXO 22:28"/><verse number="29" style="v" sid="EXO 22:29"/>ነ ካ ጼራፐነ ነ ዎይንያ ጉምኤ ኩመንፐ ታዉ ያርሹዋ ሺሻ።</para>
  <para style="p" vid="EXO 22:29">“ኔን ነ አቱማ ናና ግዶን ባይራትያ ናኣ ታዉ እማናዉ ኮሼ። <verse eid="EXO 22:29"/><verse number="30" style="v" sid="EXO 22:30"/>ሚዛፐካ ዶርሳፐካ ሄዋዳን ኦ። ኡንቱንቱ ላፑን ጋላሳይ ጋካናዉ፥ ባረንቱ አየቱዋና አየቱዋና ጋምእኖ፤ ሆስፑን ጋላስ ኡንቱንታ ታዉ እማ።<verse eid="EXO 22:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 22:31"/>“ህንተንቱ ታዉ ጌሻ አሳ ግዳናዉ ኮሼ፤ ሄዋ ድራዉ፥ ባዙዋ ዶአይ መንሬደ ዎዳ መህያ አሹዋ ሞፕተ፤ ሄዋ ካናዉ ኦልተ።<note caller="-" style="x"><char style="xo" closed="false">22:31 </char><char style="xt" closed="false"><ref loc="LEV 17:15">ዎጋ 17:15</ref></char></note><verse eid="EXO 22:31"/></para>
  <chapter eid="EXO 22"/>
  <chapter number="23" style="c" sid="EXO 23"/>
  <para style="s1">ሱረ ፕርዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 23:1"/>“ዎርዶ ኦዱዋ ፑኮፓ፤ ዎርዱዋ ማርካ ግዳደ፥ ኢታ አሳ ማዶፓ።<note caller="-" style="x"><char style="xo" closed="false">23:1 </char><char style="xt" closed="false"><ref loc="EXO 20:16">ከሳ 20:16</ref>፤ <ref loc="LEV 19:11-12">ዎጋ 19:11-12</ref>፤ <ref loc="DEU 5:20">ዛረ. 5:20</ref></char></note> <verse eid="EXO 23:1"/><verse number="2" style="v" sid="EXO 23:2"/>ኢታባ ኦናዉ ጮራ አሳ ካሎፓ፤ ፕርዳ ጌላያናዉ ጮራ አሳና እታ ግዳደ ማርካቶፓ። <verse eid="EXO 23:2"/><verse number="3" style="v" sid="EXO 23:3"/>ህዬሳይ ፕርዳዉ ሺቆፐ፥ ሞቱዋን አ መቱዋ ጼላደ ማዶፓ።<note caller="-" style="x"><char style="xo" closed="false">23:3 </char><char style="xt" closed="false"><ref loc="LEV 19:15">ዎጋ 19:15</ref></char></note><verse eid="EXO 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 23:4"/>“ነ ሞርክያ ቦራይ ዎይ ሀሪ ባዬዳዋ ደሞፐ፥ ዛራደ አዉ አፋ።<note caller="-" style="x"><char style="xo" closed="false">23:4-5 </char><char style="xt" closed="false"><ref loc="DEU 22:1-4">ዛረ. 22:1-4</ref></char></note> <verse eid="EXO 23:4"/><verse number="5" style="v" sid="EXO 23:5"/>ኔና እጽስያ ብታንያ ሀሪ ጫናና ኩንዴዳዋ በኦፐ፥ ሄዋን አጎፓ፤ ማዳደ አናና ደን።<verse eid="EXO 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 23:6"/>“ፕርዳ ዳባባን ማዳደ፥ ህዬሳ አሳ ፕርዳ ጌላዮፓ።<note caller="-" style="x"><char style="xo" closed="false">23:6-8 </char><char style="xt" closed="false"><ref loc="LEV 19:15">ዎጋ 19:15</ref>፤ <ref loc="DEU 16:19">ዛረ. 16:19</ref></char></note> <verse eid="EXO 23:6"/><verse number="7" style="v" sid="EXO 23:7"/>ዎርዶ የዉዋ ኡባፐ ሃካ፤ ጌሻ ዎይ ጽሉዋ ዎፓ፤ አያዉ ጎፐ፥ ኮባ ኦዳዋ ታን ሳሮ የድከ። <verse eid="EXO 23:7"/><verse number="8" style="v" sid="EXO 23:8"/>ማታይያ (ማጋንጻ) አኮፓ፤ አያዉ ጎፐ፥ ማታዪ ጼልያዋንቱ አይፍያ ቆቅሴነ ጽላቱዋ ቃላ ምርቄ።<verse eid="EXO 23:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 23:9"/>“በትያ ናቆፕተ፤ በተ ግድያዌ አይ ኬሻ ካዮይንቶ ኤሪታ፤ አያዉ ጎፐ፥ ህንተንቱ ህንተንቱ ሁጲያዉ በተ ግዲደ ግብጼ ጋድያን ደኤድታ።<note caller="-" style="x"><char style="xo" closed="false">23:9 </char><char style="xt" closed="false"><ref loc="EXO 22:21">ከሳ 22:21</ref>፤ <ref loc="LEV 19:33-34">ዎጋ 19:33-34</ref>፤ <ref loc="DEU 24:17-18">ዛረ. 24:17-18</ref>፤ <ref loc="DEU 27:19">27:19</ref></char></note><verse eid="EXO 23:9"/></para>
  <para style="s1">ላፑን ላይነ ላፑን ጋላሳ</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 23:10"/>“ኔን ነ ጋድያ ኡሱፑን ላይዉ ጎሻደ፥ ዘራደ ካ ቆይጫ አካ።<note caller="-" style="x"><char style="xo" closed="false">23:10-11 </char><char style="xt" closed="false"><ref loc="LEV 25:1-7">ዎጋ 25:1-7</ref></char></note> <verse eid="EXO 23:10"/><verse number="11" style="v" sid="EXO 23:11"/>ላፑን ላይን ጋድያ ጎሸናን ሻቻ፤ ያቶፐ፥ ነ አሳ ግዶን ደእያ ህዬሳቱ ሄዋፐ ምያባ ደማና፤ ቃይ ኡንቱንቱፐ አትያዋ ዶአቱ ማና። ኔን ነ ዎይንያ ቱራካ ነ ዎጋራካ ሄዋዳን ኦ። <verse eid="EXO 23:11"/><verse number="12" style="v" sid="EXO 23:12"/>ኡሱፑን ጋላሳ ነ ኪታ ኪተታ፤ ነ ቦራይነ ነ ሀሪ ሸምፓና ማላነ ነ ሶን የለቴዳ አይሊነ በቲ፥ ሸምፓና ማላ፥ ላፑን ጋላስ ኦሱዋ ኦፓ።<note caller="-" style="x"><char style="xo" closed="false">23:12 </char><char style="xt" closed="false"><ref loc="EXO 20:9-11">ከሳ 20:9-11</ref>፤ <ref loc="EXO 31:15">31:15</ref>፤ <ref loc="EXO 34:21">34:21</ref>፤ <ref loc="EXO 35:2">35:2</ref>፤ <ref loc="LEV 23:3">ዎጋ 23:3</ref>፤ <ref loc="DEU 5:13-14">ዛረ. 5:13-14</ref></char></note><verse eid="EXO 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 23:13"/>“ታን ህንተንታ ጌዳዋ ኡባ ምንሲደ ኦተ፤ ሀራ ጾሳቱዋ ሱን ጼሶፕተ፤ ህንተንቱ እንጻርሳፐ ሄዌ ስሰቶፖ።<verse eid="EXO 23:13"/></para>
  <para style="s1">ዎልቃማ ባላቱዋ</para>
  <para style="r">(<ref loc="EXO 34:18-26">34:18-26</ref>፤ <ref loc="DEU 16:1-17">ዛረ. 16:1-17</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 23:14"/>“ላይን ሄዙ ገደ ህንተንቱ ታዉ ባላ ቦንችተ። <verse eid="EXO 23:14"/><verse number="15" style="v" sid="EXO 23:15"/>ማጋገ ኡክ ባላ ቦንችተ፤ ታን ህንተንታ አዛዜዳዋዳን፥ ላፑን ጋላሳ እርሹዋ የግቤና ኡክ ሚተ፤ ህንተንቱ አቢባ ጌተትያ አግናን ኬሬዳ ጋላሳቱዋን ሀ ባላ ቦንችተ፤ አያዉ ጎፐ፥ ህንተንቱ ግብጼፐ ከሴዳዌ ሄ አግናና።</para>
  <para style="p" vid="EXO 23:15">“ህንተፐ እት አሳይነ ታ ስንን መላ ኩሸ ቤቶፖ።<note caller="-" style="x"><char style="xo" closed="false">23:15 </char><char style="xt" closed="false"><ref loc="EXO 12:14-20">ከሳ 12:14-20</ref>፤ <ref loc="LEV 23:6-8">ዎጋ 23:6-8</ref>፤ <ref loc="NUM 28:17-25">ፓይ. 28:17-25</ref></char></note><verse eid="EXO 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 23:16"/>“ቃይ ህንተንቱ ህንተንቱ ጋደን ዘርና፥ ኮይሮ ጋኬዳ ካ ጫክያ ዎደ፥ ካ ጫክያ ባላ ቦንችተ።<note caller="-" style="x"><char style="xo" closed="false">23:16 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">ዎጋ 23:15-21</ref>፣ <ref loc="LEV 23:39-43">39-43</ref>፤ <ref loc="NUM 28:26-31">ፓይ. 28:26-31</ref></char></note></para>
  <para style="p" vid="EXO 23:16">“ቃይካ ላይ ዉርሰን፥ ካ አይፍያ ጋደፐ ሺሽያ ዎደ፥ ሺሹዋ ባላ ቦንችተ። <verse eid="EXO 23:16"/><verse number="17" style="v" sid="EXO 23:17"/>አቱማ አሳይ ኡባይ ኡባ ሞድያ መና ጎዳ ስንን ላይን ሄዙ ገደ ቤቶ።<verse eid="EXO 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 23:18"/>“ኔን ያርሹዋ ሱ ታዉ ሺሻደ፥ እርሹዋ የጊደ ኡኬዳ ኡክና ሺሾፓ። ታ ባላ ቦንችያ ጋላስ ያርሸቴዳ ሞዋፐ ዎንታዉ አይነ አቶፖ። <verse eid="EXO 23:18"/><verse number="19" style="v" sid="EXO 23:19"/>ነ ጋደን ባይራ ካኤዳ ካፐ ኡባፐ ሎእያዋ መና ጎዳ ሶ፥ ነ ጾሳ ሶ አሀ።<note caller="-" style="x"><char style="xo" closed="false">23:19 </char><char style="xt" closed="false"><ref loc="EXO 34:26">ከሳ 34:26</ref>፤ <ref loc="DEU 14:21">ዛረ. 14:21</ref>፤ <ref loc="DEU 26:2">26:2</ref></char></note> ዴሻ ማራ አ ዳይ ማን ዶይሶፓ።<verse eid="EXO 23:19"/></para>
  <para style="s1">ህዶታ ቃላቱዋነ ካልያ ዎጋቱዋ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 23:20"/>“ነ ኦግያን ኔና ናጋና ማላነ ታን ነዉ ጊግሴዳ ሳኣ ኔና አፋና ማላ፥ ታን ኪታንቻ ነ ስንን ኪታና። <verse eid="EXO 23:20"/><verse number="21" style="v" sid="EXO 23:21"/>እ ኦድያዋ ሀይዛ አዉ አዛዘታ፤ አ ቦላ ማካሎፓ፤ ታ ሱንይ አ ቦላ ደእያ ድራዉ፥ ህንተንቱ ናጋራ ኦያዋ ግዶፐ፥ ህንተንቶ እ አቶ ጌና። <verse eid="EXO 23:21"/><verse number="22" style="v" sid="EXO 23:22"/>እ ኦድያዋ ህንተንቱ ምንሲደ ሀይዞፐነ ታን ኦድያዋ ኡባ ኦፐ፥ ህንተንቱ ሞርከቱዋ ታን ሞርካና፤ ህንተናና ኤቀትያዋንቱና ታንካ ኤቀታና። <verse eid="EXO 23:22"/><verse number="23" style="v" sid="EXO 23:23"/>ታ ኪታንቻይ ህንተፐ ስንና ቢደ፥ ህንተንታ አሞራዋናቱዋ ጋድያ፥ ሂተቱዋ ጋድያ፥ ፓርዛዋናቱዋ ጋድያ፥ ካናነቱዋ ጋድያ፥ ሂዌቱዋ ጋድያነ ያቡሳዋናቱዋ ጋድያ አሀና። ታን ኡንቱንቱ ኡባ ይሳና። <verse eid="EXO 23:23"/><verse number="24" style="v" sid="EXO 23:24"/>ኡንቱንቱ ጾሳቱዋ ስንን ሆኮፕተ፥ ዎይ ጎይኖፕተ፥ ዎይ ኡንቱንቱ ሀኑዋ ቁሎፕተ። ህንተንቱ ኡንቱንቱ ጾሳቱዋነ ኡንቱንቱ ሹቻ ምስለቱዋ መንሬናዉ ኮሼ። <verse eid="EXO 23:24"/><verse number="25" style="v" sid="EXO 23:25"/>መና ጎዳ፥ ህንተንቱ ጾሳዉ፥ ጎይንተ፤ ያቶፐ፥ እ ህንተንቱ ቁማነ ህንተንቱ ሃ አንጃናዋ፤ ታን ሀርግያ ህንተንቱ ግዶፐ ድጋና። <verse eid="EXO 23:25"/><verse number="26" style="v" sid="EXO 23:26"/>ህንተንቱ ቢታን አይ ማጫ አሳይነ ቦሸተና፤ ማይነና። ታን ህንተንቱ ደአና ላይ ፓይዱዋ አዱሳና።<verse eid="EXO 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 23:27"/>“ታን ታ ያሻ ህንተንቱ ስንን የዳና፤ ህንተናና ጋከትያ ካዉተ ኡባ ዳጋንና፤ ህንተንቱ ሞርከቱ ኡባይ ህንተንቶ ዞኪያ ዛሪደ፥ ባቃታናዳን ታን ኦና። <verse eid="EXO 23:27"/><verse number="28" style="v" sid="EXO 23:28"/>ታን ህንተፐ ስንዉ ዱክያ ካጅያ የዳና፤ ሂዌቱዋ፥ ካናነቱዋነ ሂተቱዋ ህንተንቱ ስንፐ ላጋደ ከሳና። <verse eid="EXO 23:28"/><verse number="29" style="v" sid="EXO 23:29"/>ሽን ቢታይ መላ አተናዳንነ ባዙዋ ዶአይ ህንተንታ ዋይሰናዳን፥ እት ላይን ኡንቱንታ የደርስከ። <verse eid="EXO 23:29"/><verse number="30" style="v" sid="EXO 23:30"/>ሽን ህንተንቱ ፓይዱዋን ዳሪደ፥ ሄ ጋድያ ላታና ጋካናዉ፥ ታን ኡንቱንታ ላፋ ላፋ ላጋደ ህንተንቱ ስንፐ ከሳና። <verse eid="EXO 23:30"/><verse number="31" style="v" sid="EXO 23:31"/>ታን ህንተንቱ ዛዋ ዞኦ አባፐ ፕልስጼማ አባ፥ መላ ቢታፐ ኤፍራጺሳ ሻፋ ጋና። ሄ ጋድያን ደእያ ኡባ ታን ህንተንቱ ኩሽያን አደ እማና፤ ህንተንቱካ ኡንቱንታ ህንተንቱ ስንፐ ላጊደ ከሳና። <verse eid="EXO 23:31"/><verse number="32" style="v" sid="EXO 23:32"/>ኡንቱንቱና ዎይ ኡንቱንቱ ጾሳቱዋና ጫቁዋ ዎፕተ። <verse eid="EXO 23:32"/><verse number="33" style="v" sid="EXO 23:33"/>ኡንቱንታ ህንተንቱ ጋድያን ዎፕተ፤ ሄዌ ዮፐ ኡንቱንቱ ህንተንታ ታ ቦላ ናጋራ ኦስሳናዋንታ፤ አያዉ ጎፐ፥ ኡንቱንቱ ጾሳቶ ጎይንያዌ ቱሙፐ ህንተንቶ ጲረ ግዳናዋ” ያጌዳ።<verse eid="EXO 23:33"/></para>
  <chapter eid="EXO 23"/>
  <chapter number="24" style="c" sid="EXO 24"/>
  <para style="s1">ጾሳይ ባረ አሳዉ ገሌዳ ቃላ ጫቁዋ ምንሴዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 24:1"/>ሄዋፐ ጉየ መና ጎዳይ ሙሳ፥ “ኔን፥ አሮነ፥ ናዳበ፥ አቢህነ እስራኤልያፐ ላፑን ታሙ ጭማ አሳቱ መና ጎዳኮ ደርያ ሁጲያ ፑደ ከሲደ ሃኩዋን ጎይንተ። <verse eid="EXO 24:1"/><verse number="2" style="v" sid="EXO 24:2"/>ሽን ሙሴ፥ ኔን ኔረካ መና ጎዳኮ ሺቃ፤ ሀራ ጭማቱ ታ ማታ ዮፕኖ። ቃይ አሳይካ ኔናና ፑደ ከሶፖ” ያጌዳ።<verse eid="EXO 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 24:3"/>ሙሴ ዪደ፥ መና ጎዳ ቃላ ኡባነ አ ዎጋ ኡባ አሳዉ ኦድና አሳይ ኡባይ እት ቃላን፥ “መና ጎዳይ ኦዴዳዋ ኡባ ኑን ኦና” ያጌድኖ። <verse eid="EXO 24:3"/><verse number="4" style="v" sid="EXO 24:4"/>ሙሴ መና ጎዳይ ኦዴዳዋ ኡባ ጻፌዳ።</para>
  <para style="p" vid="EXO 24:4">ዎንተ ጋላስ ዎንታ ጉራን ደንዲደ፥ ደርያ ጻጱዋን ያርሽያ ሳኣ ግምቢደ እስራኤልያ አሳ ያራ ታማነ ላኡዋ ሱንን፥ ታማነ ላኡ ሹቻ ቱሳ ኤሴዳ። <verse eid="EXO 24:4"/><verse number="5" style="v" sid="EXO 24:5"/>እ እስራኤላቱዋፐ ያላጋ አቱማ አሳ ኪትና፥ ኡንቱንቱ ቢደ ጹግያ ያርሹዋ ሺሼድኖ፤ ቃይ እትፐተ ያርሾ ኮሩማቱዋ መና ጎዳዉ ያርሼድኖ። <verse eid="EXO 24:5"/><verse number="6" style="v" sid="EXO 24:6"/>ሙሴ ሱፐ ባጋ አኪደ ከርያን ትጌዳ፤ አቴዳ ባካ ሱ እ ያርሽያ ሳኣን ጫጫፌዳ። <verse eid="EXO 24:6"/><verse number="7" style="v" sid="EXO 24:7"/>ሄዋፐ ጉይያን ቃላ ጫቁዋ ማጻፋ አኪደ፥ አሳዉ ናባቤዳ፤ ኡንቱንቱ፥ “መና ጎዳይ ኦዴዳዋ ኡባ ኑን ኦና፤ ኑን አዛዘታና” ያጌድኖ።<verse eid="EXO 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 24:8"/>ሄዋፐ ጉይያን ሙሴ ሄ ሱ አኪደ፥ አሳ ቦላ ጫጫፊደ ኡንቱንታ፥ “በእተ፥ መና ጎዳይ ሀ ቃላ ኡባን ህንተናና ዎዳ ቃላ ጫቁዋ ሱይ ሀዋ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">24:8 </char><char style="xt" closed="false"><ref loc="MAT 26:28">ማቶሳ 26:28</ref>፤ <ref loc="MRK 14:24">ማር. 14:24</ref>፤ <ref loc="LUK 22:20">ሉቃሳ 22:20</ref>፤ <ref loc="1CO 11:25">1 ቆሮ. 11:25</ref>፤ <ref loc="HEB 9:19-20">እብራ. 9:19-20</ref>፤ <ref loc="HEB 10:29">10:29</ref></char></note><verse eid="EXO 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 24:9"/>ሙሴ፥ አሮነ፥ ናዳበ፥ አቢህነ እስራኤልያ ጭማቱዋፐ ላፑን ታሙ ፑደ ከሴድኖ። <verse eid="EXO 24:9"/><verse number="10" style="v" sid="EXO 24:10"/>እስራኤልያ ጾሳ በኤድኖ፤ አ ገድያፐ ጋርሳና ሳሉዋዳን ጌዬዳ ሳምፔርያ ጌተትያ ጶልያ ሹቻፐ ኦሰቴዳዋ ማላትያ ዉይግያ ማላባይ ደኤ። <verse eid="EXO 24:10"/><verse number="11" style="v" sid="EXO 24:11"/>ሽን ጾሳይ እስራኤልያ አሳ ካፓቱዋ ዎቤና። ኡንቱንቱ ጾሳ በኤድኖ፤ አ ስንን ሜድኖነ ኡሼድኖ።<verse eid="EXO 24:11"/></para>
  <para style="s1">ሙሴ ሲና ደርያ ሁጲያ ቦላ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 24:12"/>መና ጎዳይ ሙሳ፥ “ኔን ደርያ ፑደ ሃ ታኮ ከሳደ፥ ሀዋን ጋምአ፤ ያቶፐ ኔን ኡንቱንታ ታማርሳና ማላ፥ ታን ዎጋነ አዛዙዋ ጻፌዳ ሹቻ ነዉ እማና” ያጌዳ።<verse eid="EXO 24:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 24:13"/>ሄዋፐ ጉይያን ሙሴ ባረ ቆማ ኢያሱና ባናዉ ደንዴዳ፤ ሙሴ ጾሳ ደርያ ፑደ ከሴዳ። <verse eid="EXO 24:13"/><verse number="14" style="v" sid="EXO 24:14"/>እስራኤልያ አሳ ጭማቱዋ እ፥ “ኑን ህንተንቱኮ ስማናዉ ሀዋን ደእሽተ፤ አሮነነ ሁር ሀዋን ህንተናና ደኢኖ፤ የዉ ደእያ ኦንነ ኡንቱንቱኮ ቦ” ያጌዳ።<verse eid="EXO 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 24:15"/>ሙሴ ደርያ ፑደ ከሴዳ ዎደ፥ ሻሪ ደርያ ካሜዳ። <verse eid="EXO 24:15"/><verse number="16" style="v" sid="EXO 24:16"/>ቃይ መና ጎዳ ቦንቹ ሲና ደርያ ቦላን ኡቴዳ፤ ሄ ሻሪ ኡሱፑን ጋላሳ ማዬዳ፤ ላፑን ጋላሳን ሄ ሻርያ ግዶፐ መና ጎዳይ ሙሳ ጼሴዳ። <verse eid="EXO 24:16"/><verse number="17" style="v" sid="EXO 24:17"/>እስራኤላቶ መና ጎዳ ቦንቹ ደርያ ሁጲያን ጹግያ ታማ ማላቲደ ቤቴዳ። <verse eid="EXO 24:17"/><verse number="18" style="v" sid="EXO 24:18"/>ሄዋፐ ጉይያን ሙሴ ሄ ሻርያ ግዶ ገሊደ፥ ደርያ ፑደ ከሲደ ደርያ ሁጲያን ኦይታሙ ጋላሳነ ኦይታሙ ቃማ ጋምኤዳ።<note caller="-" style="x"><char style="xo" closed="false">24:18 </char><char style="xt" closed="false"><ref loc="DEU 9:9">ዛረ. 9:9</ref></char></note><verse eid="EXO 24:18"/></para>
  <chapter eid="EXO 24"/>
  <chapter number="25" style="c" sid="EXO 25"/>
  <para style="ms">ጌሻ ዱንካንያነ ጎይና ዎጋ</para>
  <para style="mr">(<ref loc="EXO 25:1-40:38">25:1—40:38</ref>)</para>
  <para style="s1">ጾሳ ዱንካንያ ቶካናዉ እመቴዳ እሞታ</para>
  <para style="r">(<ref loc="EXO 35:4-9">ከሳ 35:4-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 25:1"/>መና ጎዳይ ሙሴዉ ሀዋዳን ያጌዳ፤ <verse eid="EXO 25:1"/><verse number="2" style="v" sid="EXO 25:2"/>“ታዉ እምያዋ አሀናዳን ኔን እስራኤላቶ ኦዳ፤ ታዉ እማናዉ አ ዎዛናይ አ እማ እማ ግያ አሳ ኡባ እሞታ ኔን ታዉ አካ። <verse eid="EXO 25:2"/><verse number="3" style="v" sid="EXO 25:3"/>ህንተንቱ ኡንቱንቱፐ አካና እሞታይ ሀዋ: ዎርቃ፥ ብራ፥ ናሃስያ ብራታ፥ <verse eid="EXO 25:3"/><verse number="4" style="v" sid="EXO 25:4"/>ሳሉዋ ማላትያ፥ ኦቻ ቴራ ማላትያነ፥ ዞኦ ሊቆ ቃጭና፥ ዴሻ እስክያ፥ <verse eid="EXO 25:4"/><verse number="5" style="v" sid="EXO 25:5"/>ዶርሳ ኦርግያ ጋልባ ዞኦ ቃላምያን የግ ከሴዳዋ፥ ሀራ ጋልባ፥ ኦዶሩዋ፥ <verse eid="EXO 25:5"/><verse number="6" style="v" sid="EXO 25:6"/>ጾምፕያዉ ዎጋራ ዛይትያ፥ ኦክያ ዛይትያነ እጻና ሳዌያ ቅማምያ፤ <verse eid="EXO 25:6"/><verse number="7" style="v" sid="EXO 25:7"/>ቄሳቱዋ ካፑዋ ኤፉድያንነ ትራን ዎያዋን የግያ ማርግድያ ጌተትያ ሹቻቱዋነ ሀራ ጶልያ አልኦ ሹቻቱዋ አሆ።<verse eid="EXO 25:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 25:8"/>“ያቲደ ታን ኡንቱንቱ ግዶን አቃናዳን፥ ኡንቱንቱ ታዉ ጌሻ ሳኣ ጊግስኖ። <verse eid="EXO 25:8"/><verse number="9" style="v" sid="EXO 25:9"/>ልከ ታን ኔና በሴዳ ሌምሱዋ ኡባዳን ጾሳ ዱንካንያነ አ ግዶን ደእያ ሚሻቱዋ ኦተ።<verse eid="EXO 25:9"/></para>
  <para style="s1">ቃላ ጫቁዋ ታቦታ</para>
  <para style="r">(<ref loc="EXO 37:1-9">37:1-9</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 25:10"/>“ኡንቱንቱ ኦዶሩዋ ምፐ አዱሳተይ ላኡ ዋነ ባጋ፥ ጎምፓይ እት ዋነ ባጋ፥ ጌሳይ ቃይ እት ዋነ ባጋ ግዴዳ ታቦታ መኖ። <verse eid="EXO 25:10"/><verse number="11" style="v" sid="EXO 25:11"/>ሶያነ ካርያ ዋላካይ ባይና ዎርቃን ሼሻ፤ አ ዩሹዋካ ዎርቃ ትገን ዩሻ አ። <verse eid="EXO 25:11"/><verse number="12" style="v" sid="EXO 25:12"/>ሄ ታቦታዉ ኦይዱ ዎርቃ ሳጋየቱዋ ትጋደ ኦይዱ ገደቱዋን እት ባጋና ላኡ ሳጋየቱዋ፥ ቃይ የንኮ ባጋና ላኡ ሳጋየቱዋ አ። <verse eid="EXO 25:12"/><verse number="13" style="v" sid="EXO 25:13"/>ሄዋፐ ጉይያን ኦዶሩዋፐ ካሱዋ ከሳደ ዎርቃን ሼሻ። <verse eid="EXO 25:13"/><verse number="14" style="v" sid="EXO 25:14"/>ታቦታ ቶካናዉ፥ ታቦታ ምይያን ደእያ ሳጋየቱዋን ካሱዋ አ። <verse eid="EXO 25:14"/><verse number="15" style="v" sid="EXO 25:15"/>ቶክያ ካሶቱ ታቦታ ሳጋየቱዋ ግዶን ደእኖ፤ ኡንቱንቱ ሄዋፐ ኡባካ ከሶፕኖ። <verse eid="EXO 25:15"/><verse number="16" style="v" sid="EXO 25:16"/>ታቦታ ግዶን ታን ነዉ እምያ፥ ታሙ አዛዛቱ ጻፈት ኡቴዳ ላኡ ማሰቴዳ ማርካተ ሹቻቱዋ ዎ።<verse eid="EXO 25:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 25:17"/>“ዋላካይ ባይና ዎርቃፐ ላኡ ዋነ ባጋ አዱቂያ፥ እት ዋነ ባጋ አክያ አቶ ግያ ሳኣ ቁምእያ መ።<note caller="-" style="x"><char style="xo" closed="false">25:17 </char><char style="xt" closed="false"><ref loc="HEB 9:5">እብራ. 9:5</ref></char></note> <verse eid="EXO 25:17"/><verse number="18" style="v" sid="EXO 25:18"/>ቁምእያዉ ዉርሰ ላኡ ባጋ ጋጻን ላኡ ክሩቤልያ፥ ቆጸቴዳ ዎርቃፐ መ። <verse eid="EXO 25:18"/><verse number="19" style="v" sid="EXO 25:19"/>እት ክሩብያ እት ባጋ ጋጻን፥ ላኤን ክሩብያ የንኮ ባጋ ጋጻን ላኡዋካ ቁምእያና ጋ ኦይደ መ። <verse eid="EXO 25:19"/><verse number="20" style="v" sid="EXO 25:20"/>ክሩበቱ ባረንቱ ቀፍያ ደንደ፥ አቶ ግያ ሳኣ ቁምእያ ባረንቱ ቀፍያን ኩዋይ ዎኖ፤ ቃይ እቱ እቱዋኮ ስም ኡቲደ፥ ቁምእያ ጼልኖ። <verse eid="EXO 25:20"/><verse number="21" style="v" sid="EXO 25:21"/>ቁምእያ ታቦታዉ ቦላ ባጋን ዎ፤ ቃይ ታን ነዉ እምያ አዛዛቱ ጻፈቲደ ማሰቴዳ ሹቻቱዋ ታቦታ ግዶን ዎ። <verse eid="EXO 25:21"/><verse number="22" style="v" sid="EXO 25:22"/>ማርካተ ታቦታ ቦላ ቁምእያ ቦላ ደእያ ላኡ ክሩበቱዋፐ ግዱዋን ታን ኔናና ጋከታደ እስራኤልያ አሳዉ ታን እምያ አዛዙዋ ኡባ ያን ነዉ እማና።<verse eid="EXO 25:22"/></para>
  <para style="s1">ኡክ ዎያ ጻርጴዛ</para>
  <para style="r">(<ref loc="EXO 37:10-16">37:10-16</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 25:23"/>“ኦዶሩዋ ምፐ አዱሳተ ላኡ ዋ፥ ጎምፓይ እት ዋ፥ ጌሳይ ቃይ እት ዋነ ባጋ ግድያ እት ጻርጴዛ መ። <verse eid="EXO 25:23"/><verse number="24" style="v" sid="EXO 25:24"/>ያታደ ዋላካይ ባይና ዎርቃን ሼሻ፤ ቃይ አ ዩሹዋን ዎርቃ ትገ ዩሻ አ። <verse eid="EXO 25:24"/><verse number="25" style="v" sid="EXO 25:25"/>ሄዋዳንካ፥ ቃይ ጎምፓይ ታካ ግዴዳ ሻሽያ አ ቦላ ዩሻ አ። ያታደ አ ቦላ ዎርቃ ትገ ዩሻ። <verse eid="EXO 25:25"/><verse number="26" style="v" sid="EXO 25:26"/>ሄ ጻርጴዛዉ ኦይዱ ዎርቃ ሳጋየቱዋ መደ፥ ጻርጴዛ ገደቱ ደእያ ኦይዱ ጋጻን ዎ። <verse eid="EXO 25:26"/><verse number="27" style="v" sid="EXO 25:27"/>ጻርጴዛ ቶካናዉ ካሱዋ አያ ሳጋየቱ ጻርጴዛዉ ሻሽያ ጋጻን ሺቂደ ደእኖ። <verse eid="EXO 25:27"/><verse number="28" style="v" sid="EXO 25:28"/>ሄ ቶክያ ካሱዋ ኦዶሩዋፐ ከሳደ፥ ዎርቃን ኡንቱንታ ሼሻ። <verse eid="EXO 25:28"/><verse number="29" style="v" sid="EXO 25:29"/>ሄዋዳንካ፥ ቃይ ሻታቱዋነ ጭልፓቱዋ፥ ዱቂያባቱዋነ ጹአቱዋ ዋላካይ ባይና ዎርቃፐ መ። <verse eid="EXO 25:29"/><verse number="30" style="v" sid="EXO 25:30"/>ታ ስን አያ ጌሻ ኡክይ ኡባ ዎደካ ጻርጴዛ ቦላ ዮፖ።<note caller="-" style="x"><char style="xo" closed="false">25:30 </char><char style="xt" closed="false"><ref loc="LEV 24:5-8">ዎጋ 24:5-8</ref></char></note><verse eid="EXO 25:30"/></para>
  <para style="s1">ጾምፕያ ዎያ ባላ</para>
  <para style="r">(<ref loc="EXO 37:17-24">37:17-24</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 25:31"/>“ጾምፕያ ዎያ ባላ ቆጸቴዳ ዋላካይ ባይና ዎርቃፐ መ፤ ሄ ባላይ ኤቂያ ገዲካ፥ ቃይ ግዶ ቶማይካ ኡባይ ቆጸቴዳ ዎርቃፐ ኦሰታናዉ ኮሼ። አ ዋንጫቱ፥ አ ኩኩሞቱ አ ጪሻቱ ኡባይ አናና እትፐ ኦይቀት መታናዉ ኮሼ።<figure style="fig" alt="Seven-branched candlestick or lampstand" file="HK00264B.TIF" size="col" ref="25:31">ላፑን ካጨያና ደእያ ጾምፕያ ዎያ ባላቱዋ</figure> <verse eid="EXO 25:31"/><verse number="32" style="v" sid="EXO 25:32"/>ምይያና ኡሱፑን ማራቱ አዉ ከሲኖ፤ ማራቱዋፐ ሄዛቱ እት ባጋና፥ ቃይ ሄዛቱ የንኮ ባጋና ደእኖ። <verse eid="EXO 25:32"/><verse number="33" style="v" sid="EXO 25:33"/>ኡሱፑን ማራቶካ ሁጲያን ሁጲያን ሄዙ ሄዙ ኩኩሙነ ጪሻይ ደእያ ላዉዝያ ጪሻ ማላትያ ዋንጫይ ደኦ። <verse eid="EXO 25:33"/><verse number="34" style="v" sid="EXO 25:34"/>ጾምፕያ ዎያ ባላዉ ግዶ ቶማይ፥ ኩኩሞቱዋ ጪሻቱ ደእያ ላዉዝያ ጪሻ ማላትያ ኦይዱ ዋንጫይ ደኦ። <verse eid="EXO 25:34"/><verse number="35" style="v" sid="EXO 25:35"/>ላኡ ላኡ እትፐ ዋን ደእያ ሄዙ ማራቱዋፐ ጋርሳና እት እት ኩኩሙ ደኦ። <verse eid="EXO 25:35"/><verse number="36" style="v" sid="EXO 25:36"/>ኩኩማቱነ ማራቱ ኡባይ ጾምፕያ ዎያ ባላና እትፐ፥ ኦይቀት እቱዋ ግዲደ፥ ዋላካይ ባይና ዎርቃፐ ቆጸቲደ መትኖ።<verse eid="EXO 25:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="EXO 25:37"/>“ሄዋፐ ጉይያን ጾምፕያ ዎያ ባላዉ ላፑን ጾምፐቱዋ ጊግሳደ፥ ኡንቱንቱ ስን ግዶዉ ፖአና ማላ ቁ ኦደ ዎ። <verse eid="EXO 25:37"/><verse number="38" style="v" sid="EXO 25:38"/>ጾምፕያ ቶይስያ ቃጰቱዋነ ኡንቱንታ ዎያዋንታ ዋላካይ ባይና ዎርቃፐ መ። <verse eid="EXO 25:38"/><verse number="39" style="v" sid="EXO 25:39"/>ጾምፕያ ዎያ ባላይነ አን ጎኤትያ ሚሻ ኡባይ ሀታማነ እቼሹ ኪሎ ግራመ ግዴዳ ዋላካይ ባይና ዎርቃፐ መቲኖ። <verse eid="EXO 25:39"/><verse number="40" style="v" sid="EXO 25:40"/>አኬካ፤ ታን ኔና ደርያ ሁጲያን በሴዳዋዳን ኪተታ።<note caller="-" style="x"><char style="xo" closed="false">25:40 </char><char style="xt" closed="false"><ref loc="ACT 7:44">ኪታ 7:44</ref>፤ <ref loc="HEB 8:5">እብራ. 8:5</ref></char></note><verse eid="EXO 25:40"/></para>
  <chapter eid="EXO 25"/>
  <chapter number="26" style="c" sid="EXO 26"/>
  <para style="s1">ጾሳ ዱንካንያ</para>
  <para style="r">(<ref loc="EXO 36:8-38">36:8-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 26:1"/>“ቃይ ሊቆ ፑቱዋፐ ሳሉዋ ማላትያ፥ ኦቻ ቴራ ማላትያነ ሾሎላ ዞኦ ቃጭናፐ ዳደቴዳ ታሙ ጋርዳቱዋ ጾሳ ዱንካንያ ጊግሳ። ሄ ጋርዳቱዋን እት ሂላን ክሩበቱዋ ምስልያ ዳድሳ። <verse eid="EXO 26:1"/><verse number="2" style="v" sid="EXO 26:2"/>ጋርዶቱ ኡባይ እት ልከ ግድኖ፤ ጌሳይ ላታማነ ሆስፑን ዋ፤ ጎምፓይ ኦይዱ ዋ ግዶ። <verse eid="EXO 26:2"/><verse number="3" style="v" sid="EXO 26:3"/>እቼሹ ጋርዳቱዋ እትፐ ጋደ ስካ፤ የንኮ አቴዳ እቼሹ ጋርዳቱዋካ ኡንቱንቱዋዳን ኪተታ። <verse eid="EXO 26:3"/><verse number="4" style="v" sid="EXO 26:4"/>እትፐ ጋከቲደ ስከቴዳ ጋርዳቱዋፐ እት ጋርዱዋ ዉርሰ ጋጻን ሳሉዋ ማላትያ ጫርቂያፐ ማጫራ መ፤ ቃይ እትፐ ጋከት ስከቴዳ የንኮ ጋርዱዋንካ ሄዋዳን ኪተታ። <verse eid="EXO 26:4"/><verse number="5" style="v" sid="EXO 26:5"/>እትፐ ጋከቴዳ እት ጋርዱዋ ቦላ እሻታሙ ማጫራ፥ ቃይ እትፐ ጋከቴዳ የንኮ ጋርዱዋ ቦላካ እሻታሙ ማጫራ መ፤ ሄ ማጫራቱ ኡባይካ እቱ እቶ ማራን ደእኖ። <verse eid="EXO 26:5"/><verse number="6" style="v" sid="EXO 26:6"/>ሄዋፐ ጉይያን ዎርቃፐ እሻታሙ ኦይቂያዋንታ መደ ጾሳ ዱንካኒ እቱዋ ግዳና ማላ፥ ሄ ጋርዳቱዋ ጋጻ ጋጻ ሄ ኦይቂያዋንቱን ኦይ።<verse eid="EXO 26:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 26:7"/>“ቃጭናፐ መቴዳ ጾሳ ዱንካንያ ቦላና ካማና ማላ፥ ታማነ እት ጋርዳቱዋ ዴሻ እስክያፐ ዳዳደ፥ እት ዱንካንያ መ። <verse eid="EXO 26:7"/><verse number="8" style="v" sid="EXO 26:8"/>ታማነ እት ጋርዳቱካ እት ልከ ግድኖ፤ እት እት ጋርዱዋ ጌሳይ ሀታሙ ዋ፥ ጎምፓይ ኦይዱ ዋ ግዶ። <verse eid="EXO 26:8"/><verse number="9" style="v" sid="EXO 26:9"/>እቼሹ ጋርዳቱዋ እት ባጋና፥ ኡሱፑን ጋርዳቱዋ ቃይ የንኮ ባጋና ጋደ ስካ። ኡሱፑን ጋርዱ ዳኮቲደ፥ ዱንካንያዉ ስን ባጋና ዳቡለቶ። <verse eid="EXO 26:9"/><verse number="10" style="v" sid="EXO 26:10"/>ጋ ስኬዳ ጋርዳቱዋፐ እት ጋርዱዋ ጋጻን እሻታሙ ማጫራ መ፤ ቃይ ጋ ስኬዳ የንኮ ጋርዳቱዋፐ ጋጻን እሻታሙ ማጫራ መ። <verse eid="EXO 26:10"/><verse number="11" style="v" sid="EXO 26:11"/>እሻታሙ ናሃስያ ኦይቂያዋ መደ፥ ማጫራቱዋ ግዶ ገልሳ፤ ያታደ ዱንካንያ እትፐ ጋ ኦይ። ያቶፐ ሀ ላኡ ኦይቀቴዳ ካምያዋንቱ እቱዋ ግዳና። <verse eid="EXO 26:11"/><verse number="12" style="v" sid="EXO 26:12"/>ሀ ዱንካንያ ጋርዳቱዋፐ ፓላሄዳ ባጋ ጋርዱ ጾሳ ዱንካንያዉ ጉየና ካቀቶ። <verse eid="EXO 26:12"/><verse number="13" style="v" sid="EXO 26:13"/>ዱንካንያ ጋርዶቱ ላኡ ባጋናካ እት እት ዋ ኬሻ ፓላህኖ፤ ሄ ፓላሄዳዋንቱ ጾሳ ዱንካንያ ካማና ማላ፥ ላኡ ባጋ ምይያና ካቀትኖ።<verse eid="EXO 26:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 26:14"/>“ዴሻ አጎዛፐ መቴዳ ዱንካንያ ቦላና ካማናዉ ዶርሳ ኦርግያ ጋልባ ዞኦ ቃላምያን የግ ከሴዳዋ ጊግሳ፤ ቃይ አ ቦላና ካማናዉ ቁምእያ ሀራ ጋልባፐ ጊግሳ።<verse eid="EXO 26:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 26:15"/>“ጾሳ ዱንካንያ ጻጋግያዋንታ ስት ጌዳ ኦዶሩዋፐ ከሳ። <verse eid="EXO 26:15"/><verse number="16" style="v" sid="EXO 26:16"/>እት እት ጻጋግያዉ ጌሳይ ታሙ ዋ፥ ጎምፓይ እት ዋነ ባጋ ግዶ። <verse eid="EXO 26:16"/><verse number="17" style="v" sid="EXO 26:17"/>እት እት ጻጋግያዉ እቱዋ እቱዋና ጋ ኦይያ ላኡ ፖ መ። ጾሳ ዱንካንያ ጻጋገቱዋ ኡባካ ሄዋዳን ኪተታ፤ <verse eid="EXO 26:17"/><verse number="18" style="v" sid="EXO 26:18"/>ጾሳ ዱንካንያዉ ገድሳ ባጋና ላታሙ ጻጋግያዋ መ። <verse eid="EXO 26:18"/><verse number="19" style="v" sid="EXO 26:19"/>እት እት ጻጋግያዉ ላኡ ፖይ ገልያ ኦይታሙ ሉኩዋ፥ ኡባካ ብራፐ ጊግሳ። <verse eid="EXO 26:19"/><verse number="20" style="v" sid="EXO 26:20"/>ጾሳ ዱንካንያዉ ሁጲሳ ባጋና፥ ላታሙ ጻጋግያዋ መ። <verse eid="EXO 26:20"/><verse number="21" style="v" sid="EXO 26:21"/>እት እት ጻጋግያዉ ላኡ ገደቱ፥ ሙለ ኦይታሙ ገደቱ፥ ብራፐ ጊግኖ። <verse eid="EXO 26:21"/><verse number="22" style="v" sid="EXO 26:22"/>ቃይ ጾሳ ዱንካንያዉ ጉየ ጋጻን አዋይ ዉልያ ባጋና ኡሱፑን ጻጋግያ መ። <verse eid="EXO 26:22"/><verse number="23" style="v" sid="EXO 26:23"/>ጉየን ደእያ ጋጻቶ ላኡ ጻጋግያ ጊግሳ። <verse eid="EXO 26:23"/><verse number="24" style="v" sid="EXO 26:24"/>ሄዋ ድራዉ፥ እት ጻጱዋን ላኡ ፖ ጊጋ ጼራ ጋካናዉ እታ ግድ ምግዱዋን ኦይቀታናዉ በሴ፤ ላኡ ጋጻ ኦይያ ጻጋጋቱካ ሀራ ጻጋጊ ኦሰቶዋዳን ኦሰታናዉ በሴ። <verse eid="EXO 26:24"/><verse number="25" style="v" sid="EXO 26:25"/>ሄዋ ድራዉ እት እት ጻጋግያዉ ጋርሳና ላኡ ላኡ ፖይ ገልያ ሉካቱ ደኢኖ፤ ኡባና ሆስፑን ጻጋገቱነ ብራፐ ኦሰቴዳ ታማነ ኡሱፑን ፖይ ገልያ ሉካቱ ደኢኖ።<verse eid="EXO 26:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 26:26"/>“ቃይ ኦዶሮቱዋፐ ቱቁመትያ ሜጋ ከሳ። ጾሳ ዱንካንያዉ እት ባጋ ምይያን ደእያ ጻጋገቶ እቼሹ ቱቁመትያ ሜጋ፥ <verse eid="EXO 26:26"/><verse number="27" style="v" sid="EXO 26:27"/>ቃይ የንኮ ባጋ ምይያን ደእያ ጻጋገቶ እቼሹ ቱቁመትያ ሜጋቱዋ ጊግሳ። ሄዋዳንካ፥ ጾሳ ዱንካንያዉ ጉየ አዋይ ዉልያ ባጋና ዉርሰ ጋጻን ደእያ ጻጋገቶ እቼሹ ቱቁመትያ ሜጋ መ። <verse eid="EXO 26:27"/><verse number="28" style="v" sid="EXO 26:28"/>ግዶ ቱቁመትያ ሜጋይ ጻጋገቶ ግዶ ሄራና ሀ ጋጻፐ ያ ጋጻ ጋካናዉ ፕን ከሳናዉ ኮሼ። <verse eid="EXO 26:28"/><verse number="29" style="v" sid="EXO 26:29"/>ጻጋገቱዋ ዎርቃን ሼሻደ፥ ቱቁመትያ ሜጋቱ አያ ሳጋየቱዋ ዎርቃፐ መ፤ ቃይ ቱቁመትያ ሜጋቱዋካ ዎርቃን ሼሻ። <verse eid="EXO 26:29"/><verse number="30" style="v" sid="EXO 26:30"/>ጾሳ ዱንካንያ ታን ኔና ደርያ ቦላን በሴዳዋዳን ኦደ ቶካ።<verse eid="EXO 26:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 26:31"/>“ሳሉዋ ማላትያ፥ ኦቻ ቴራ ማላትያነ ሾሎላ ዞኦ ቃጭናፐነ ሊቆ ሊኑዋፐ እት ጋርዱዋ ኪተታ፤ ሄ ጋርዱዋ ቦላ እት ሂላን ክሩበቱዋ ምስልያ ስክሳ። <verse eid="EXO 26:31"/><verse number="32" style="v" sid="EXO 26:32"/>ያታደ ዎርቃን ሼሼዳ ኦይዱ፥ ኦዶሩዋ ቱሳቱዋን ደእያ ዎርቃፐ ኦሰቴዳ ካቂያዋን ካቃ። ሄ ኦይዱ ቱሳቱ ብራፐ መዳ ኦይዱ ፖይ ገልያሳን ገልኖ። <verse eid="EXO 26:32"/><verse number="33" style="v" sid="EXO 26:33"/>ሄ ጋርዱዋ ጾሳ ዱንካንያ ካራን ደእያ ኦይቂያዋንቱፐ ጋርሳና ካቄዳ፥ ቃላ ጫቁዋ ታቦታ ጋርዱዋፐ ጉየ ባጋን ዎ፤ ያቶፐ ሄ ጋርዱ ጌሻ ሳኣ ኡባፐ አዳ ጌሻ ሳኣፐ ሻካና።<note caller="-" style="x"><char style="xo" closed="false">26:33 </char><char style="xt" closed="false"><ref loc="HEB 6:19">እብራ. 6:19</ref>፤ <ref loc="HEB 9:3-5">9:3-5</ref></char></note> <verse eid="EXO 26:33"/><verse number="34" style="v" sid="EXO 26:34"/>አቶ ግያ ሳኣ ቁምእያ ኡባፐ አዳ ጌሻ ሳኣን ደእያ ቃላ ጫቁዋ ታቦታ ቦላ ዎ። <verse eid="EXO 26:34"/><verse number="35" style="v" sid="EXO 26:35"/>ጻርጴዛ ጋርዱዋፐ ካረና፥ ጾሳ ዱንካንያን ጌሻ ሳኣ ግዱዋን ሁጲሳ ባጋን ዎ፤ ጾምፕያ ዎያ ባላ ቃይ አ ባጋን ገድሳ ባጋና ዎ።<verse eid="EXO 26:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 26:36"/>“ዱንካንያ ገልያ ፐንግያዉ ሳሉዋ ማላትያ፥ ኦቻ ቴራ ማላትያነ ሾሎላ ዞኦ ቃጭናፐነ ሊቆ ሊኑዋፐ ጽልፕያን አሌቅስያዋን ኦሰቴዳ ጋርዱዋ መ። <verse eid="EXO 26:36"/><verse number="37" style="v" sid="EXO 26:37"/>ጋርዱዋ እቼሹ ቱሳቱዋ ኦዶሮቱዋፐ ከሳደ፥ ዎርቃን ሼሻ፤ ካቂያዋንቱካ ዎርቃፐ ኦሰቴዳዋንታ ግድኖ፤ ቱሳቶ ናሃስያ ብራታፐ ትጋደ እቼሹ ፖቱ ገልያዋ መ።<verse eid="EXO 26:37"/></para>
  <chapter eid="EXO 26"/>
  <chapter number="27" style="c" sid="EXO 27"/>
  <para style="s1">ጹግያ ያርሹዋ ያርሽያ ሳኣ</para>
  <para style="r">(<ref loc="EXO 38:1-7">38:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 27:1"/>“ኦዶሩዋፐ ያርሽያ ሳኣ ኬጻ። ሄ ያርሽያ ሳአዉ ጌሳይ እቼሹ ዋ ግዶ፤ ጎምፓይነ እት ልከ፥ እቼሹ እቼሹ ዋ፤ ቃተይ ሄዙ ዋ፥ ኦይዱ ጋጻና ደኦ። <verse eid="EXO 27:1"/><verse number="2" style="v" sid="EXO 27:2"/>ዉርሰ ጋጻን ጋጻን እት እት ካጭያ መ፤ ካጨቱ ያርሽያ ሳኣና እትፐ ኦይቀቲደ መትኖ። ያታደ ያርሽያ ሳኣ ናሃስያ ብራታን ሼሻ። <verse eid="EXO 27:2"/><verse number="3" style="v" sid="EXO 27:3"/>አን ጎኤትያ ሚሻቱዋ፥ ብድን ከስያ ባልደቱዋ፥ አካፋቱዋ፥ ሱ ትግያ ኩይጻሮቱዋ፥ ቃጲያ፥ ሴልያባ ኦይቂያ ሚሻ ናሃስያ ብራታፐ መ። <verse eid="EXO 27:3"/><verse number="4" style="v" sid="EXO 27:4"/>ያታደ ናሃስያ ብራታፐ ዛዝርያ መ፤ ቃይ አ ኦይዱ ጋጻን ኦይዱ ሳጋየቱዋ መ። <verse eid="EXO 27:4"/><verse number="5" style="v" sid="EXO 27:5"/>ያታደ ያርሽያ ሳአዉ ግዶ ባጋን ኦይደ ዎ <verse eid="EXO 27:5"/><verse number="6" style="v" sid="EXO 27:6"/>ኦዶሩዋፐ ያርሽያ ሳአዉ ካሶቱዋ ከሳደ፥ ናሃስያ ብራታን ሼሻ። <verse eid="EXO 27:6"/><verse number="7" style="v" sid="EXO 27:7"/>ያርሽያ ሳኣ ቶክያ ዎደ ማዳና ማላ፥ ሄ ካሱዋ ላኡ ምይያና ደእያ ሳጋየቱዋን አ። <verse eid="EXO 27:7"/><verse number="8" style="v" sid="EXO 27:8"/>ታን ኔና ደርያ ቦላን በሴዳዋዳን፥ ያርሽያ ሳኣ ጻዉላፐ መደ፥ ጎምፓ መላ ከስኖ።<verse eid="EXO 27:8"/></para>
  <para style="s1">ጾሳ ዱንካንያዉ ዳባባ ዩሹዋ</para>
  <para style="r">(<ref loc="EXO 38:9-20">38:9-20</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 27:9"/>“ጾሳ ዱንካንያዉ አሳይ ሺቅያ ዳባባ ጊግሳ። ዳባባይ ገድሳ ባጋና ጼቱ ዋ አዱቆ፤ ሄ ዳባባዉ ሊቆ ሊኑዋፐ ዳደቴዳ ጋርዳቱዋ ጊግሳ። <verse eid="EXO 27:9"/><verse number="10" style="v" sid="EXO 27:10"/>አዉ ናሃስያ ብራታፐ ላታሙ ቱሳቱዋነ ቱሳቱ ኤቂያ ላታሙ ፖይ ገልያ ሉኩዋ ኦ፤ ኡንቱንቱ ሁጲያን ቃይ ብራፐ ካቂያዋንታነ ቱሳቱዋ ሁጲያን ቃችያዋንታ ኦ። <verse eid="EXO 27:10"/><verse number="11" style="v" sid="EXO 27:11"/>ሄዋዳንካ፥ ዳባባዉ ሁጲሳ ባጋና ጼቱ ዋ አዱቆ፤ ቃይ ላታሙ ቱሳቱዋናነ ሄ ቱሳቶ ላታሙ ናሃስያ ፖይ ገልያ ሉኮቱዋና ደእያ ጋርዱ ደኦ። ያቲደ ብራፐ ኦሰቴዳ ካቂያዋንቱነ ቱሳቱዋ ሁጲያን ቃችያዋንቱ ዳባባዉ ደእኖ።<verse eid="EXO 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 27:12"/>“ዳባባዉ አዋይ ዉልያ ባጋ ጎምፓይ እሻታሙ ዋ አኮ፤ ታሙ ቱሳቱነ፥ ቱሳቶ ታሙ ፖይ ገልያ ሉካቱ ደእያ ጋርዶቱ አዉ ደእኖ። <verse eid="EXO 27:12"/><verse number="13" style="v" sid="EXO 27:13"/>ቃይ አዋይ ዶልያ ባጋ ዳባባ ጎምፓይካ እሻታሙ ዋ ግዶ። <verse eid="EXO 27:13"/><verse number="14" style="v" sid="EXO 27:14"/>ዳባባ ገልያ ሳኣፐ አዋይ ዶልያ ባጋና ታማነ እቼሹ ዋ አዱቂያ ጋርዶቱ ደእኖ፤ ኡንቱንቶ ሄዙ ቱሳቱነ ሄዙ ፖይ ገልያ ሉኮቱ ደእኖ። <verse eid="EXO 27:14"/><verse number="15" style="v" sid="EXO 27:15"/>ሄዋዳንካ፥ ህንኮ ባጋና ጋርዶቱ ታማነ እቼሹ ዋ አዱቂያ ጋርዶቱ ደእኖ፤ ኡንቱንቶ ሄዙ ቱሳቱነ ቱሳቶ ሄዙ ፖይ ገልያ ሉኮቱ ደእኖ።<verse eid="EXO 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 27:16"/>“ዳባባ ገልያ ሳአዉ ላታሙ ዋ አዱቂያ ጋርዱዋ ጊግሳ፤ ሄዌካ ሳሉዋ ማላትያ፥ ኦቻ ቴራ ማላትያነ፥ ሾሎላ ዞኦ ቃጭናፐነ ሊቆ ሊኑዋፐ ዳደቴዳዋ፥ ጽልፕያን አሌቅስያዋን ጊግሳ። ኦይዱ ቱሳቱዋነ ቱሳቶ ኦይዱ ፖይ ገልያ ሉኮቱዋ ጊግሳ። <verse eid="EXO 27:16"/><verse number="17" style="v" sid="EXO 27:17"/>ዳባባ ዩሹዋን ደእያ ቱሳቱዋ ኡባዉ ብራፐ ኦሰቴዳ ቃችያዋንቱነ ካቂያዋንቱ፥ ናሃስያፐ ኦሰቴዳ ፖይ ገልያ ሉኮቱ ደእኖ። <verse eid="EXO 27:17"/><verse number="18" style="v" sid="EXO 27:18"/>ዳባባይ አዱሳተይ ጼቱ ዋ፥ ጎምፓይ እሻታሙ ዋ ግዶ፤ ፑድያ እቼሹ ዋ ቂያ ሊቁዋን ዳደቴዳ ሊኑዋፐ ኦሰቴዳ ጋርዶቱ ደእኖ፤ ያቲደ ቱሳቱዋ ናሃስያፐ ኦሰቴዳ ፖይ ገልያ ሉኮቱ ግድኖ።<verse eid="EXO 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 27:19"/>“ጾሳ ዱንካንያን ኦያ ኦሶ ጎኤትያ ሚሻ ኡባይ፥ ኡንቱንቱ ጎአይ አያ ግዶፐነ፥ ጾሳ ዱንካንያ ገቱ ኡባናነ ዳባባ ገቱ ኡባናካ ጉጅና፥ ናሃስያ ብራታፐ መቲኖ።<verse eid="EXO 27:19"/></para>
  <para style="s1">ጾምፕያ ዛይትያ</para>
  <para style="r">(<ref loc="LEV 24:1-4">ዎጋ 24:1-4</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 27:20"/>“ጾምፒ ቶኤናን ኤጺደ ደአና ማላ፥ አዉ ኮሽያ ጽሎ ዛይትያ ዎጋራ ቴራ ጫዲደ ጉምእና ከሴዳዋ ነዉ አሀና ማላ፥ እስራኤላቱዋ አዛዛ። <verse eid="EXO 27:20"/><verse number="21" style="v" sid="EXO 27:21"/>አሮነነ አ ናናይ፥ ጾምፒ ጾሳ ስንን ቃሜዳ ሳአይ ዎንታና ጋካናዉ ፖአና ማላ፥ መና ጎዳ ዱንካንያ ግዶን፥ ማርካተ ታቦታ ስንን ደእያ ጋርዱዋፐ ካረና ኤኖ። ሀዌ እስራኤልያ አሳዉ መናዉ ዎ ዎጋ ግዲደ ደኦ።<verse eid="EXO 27:21"/></para>
  <chapter eid="EXO 27"/>
  <chapter number="28" style="c" sid="EXO 28"/>
  <para style="s1">ቄሳቱዋ ካፓቱዋ ማዩዋ</para>
  <para style="r">(<ref loc="EXO 39:1-7">39:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 28:1"/>“ነ እሻ አሮናነ አ ናና ናዳባ፥ አቢሀ፥ ኤልኣዛራነ እታማራ ኔኮ አሃደ፤ ኡንቱንቱ ቄሳቱዋ ግዲደ ታዉ ኦና ማላ፥ እስራኤልያ አሳ ግዶፐ ኡንቱንታ ዱማያ። <verse eid="EXO 28:1"/><verse number="2" style="v" sid="EXO 28:2"/>አዉ ቦንቹዋነ ፑላ እማና ማላ፥ ነ እሻ አሮናዉ ቄሳተ ማዮቱዋ ጊግሳ። <verse eid="EXO 28:2"/><verse number="3" style="v" sid="EXO 28:3"/>ታን አዳ ኤራ እሜዳ ኩሽያ ሂላ ኤርያ አሳ ኡባ ጼሳደ፥ አሮናዉ ማዮቱዋ ጊግሳና ማላ ኦዳ፤ እ ቄሴ ግዲደ፥ ታዉ ኦናዉ ዱማታናዋ። <verse eid="EXO 28:3"/><verse number="4" style="v" sid="EXO 28:4"/>ኡንቱንቱ ጊግሳና ማዮቱካ ሀዋንታ: ትራን ዎያዋ፥ ኤፉድያ፥ አዱሳ ማዩዋ፥ አሌቀቲደ ዳደቴዳ አዱሳ ሻምጭያ፥ ሻሽያነ ሀራ ዳንጩዋ። ነ እሻይ አሮነነ አ ናናይ ቄሳቱዋ ግዲደ ታዉ ኦደ ጌሻ ማዮቱዋ ማያና ማላ፥ ስክያዋንቱ ጊግሲኖ። <verse eid="EXO 28:4"/><verse number="5" style="v" sid="EXO 28:5"/>ኩሽያ ሂላ ኤርያዋንቱካ ሀ ማዮቱዋ ጊግሳናዉ ዎርቃ፥ ሳሉዋ ማላትያ፥ ኦቻ ቴራ ማላትያነ ሾሎላ ዞኦ ቃጭናነ ሊቆ ሊኑዋ ጎኤትኖ።<verse eid="EXO 28:5"/></para>
  <para style="s1">ኤፉድያ</para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 28:6"/>“ኤፉድያ ጌተትያ ማዩዋ ዎርቃፐ፥ ሳሉዋ ማላትያ ቃጭናፐ፥ ኦቻ ቴራ ማላትያ ቃጭናፐ፥ ሾሎላ ዞኦ ቃጭናፐነ ሊቆ ሊኑዋ ቃጭናፐ ኩሽያ ሂላንቻቱ አሌቂሲደ ጊግሲኖ። <verse eid="EXO 28:6"/><verse number="7" style="v" sid="EXO 28:7"/>ላኡ ባጋይ ጋከቲደ እቱዋ ግዳና ማላ፥ ላኡ ሀሽያ ቦላ ጋደ ኦይያ ጫርቂ ደኦ። <verse eid="EXO 28:7"/><verse number="8" style="v" sid="EXO 28:8"/>ሂላንቻይ አሌቂሲደ ዳዴዳ ዳንጩካ ኤፉድያና እታ ግዲደ፥ ዎርቃፐ፥ ሳሉዋ ማላትያ፥ ኦቻ ቴራ ማላትያነ ሾሎላ ዞኦ ቃጭናፐነ ሌእስ ባቄዳ ሊኑዋፐ ኦሰቶ።<verse eid="EXO 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 28:9"/>“ማርግድያ ጌተትያ ላኡ ሹቻቱዋ አሃደ፥ እስራኤልያ ናናቱዋ ሱን ኡንቱንቱ ቦላ ዎጫደ ጻፋ። <verse eid="EXO 28:9"/><verse number="10" style="v" sid="EXO 28:10"/>ኡንቱንቱ የለታ ማራዳን እት ሹቻ ቦላ ኡሱፑን ሱን፥ ህንኮ ሹቻ ቦላ ቃይ አቴዳ ኡሱፑናቱዋ ሱን ዎጫደ ጻፋ። <verse eid="EXO 28:10"/><verse number="11" style="v" sid="EXO 28:11"/>ማታፋ ቦላ ሱን ዎጪደ ጻፍያዋዳን፥ ሄ ላኡ ሹቻቱዋ ቦላ እስራኤልያ ናናቱዋ ሱን ዎጫደ ጻፋ፤ ሄ ሹቻቱዋ ዎርቃፐ መዳ ሹቻ ኦይቂያዋ ቦላ ዎ። <verse eid="EXO 28:11"/><verse number="12" style="v" sid="EXO 28:12"/>ያታደ ታማነ ላኡ እስራኤልያ ዘረ ሀሳይያዋ ግዳና ማላ፥ ሀ ላኡ ሹቻቱዋ ኤፉድያና ኦይዳ ሀሽያ ጫርቂያን ዎ፤ ያቶፐ መና ጎዳ ስንን ኡባደ ቆፈታና ማላ፥ ሀ ሱንቱዋ አሮነ ባረ ሀሽያን ቶኮ። <verse eid="EXO 28:12"/><verse number="13" style="v" sid="EXO 28:13"/>ሄ ሹቻቱዋ ኦይቂያዋ ዎርቃፐ መ። <verse eid="EXO 28:13"/><verse number="14" style="v" sid="EXO 28:14"/>ቃይ ዋላካይ ባይና ዎርቃፐ ዎዶሩዋዳን ዶቄዳ ላኡ ሳንሳላታቱዋ ጊግሳደ፥ ሄ ላኡ ሹቻ ኦይቂያዋንቱና ጋ ኦይ።<verse eid="EXO 28:14"/></para>
  <para style="s1">ትራን ዎያዋ</para>
  <para style="r">(<ref loc="EXO 39:8-21">39:8-21</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 28:15"/>“ጾሳ ሸኒ አየንቶ ኦቺደ ኤርያ ትራን ዎያዋ ኩሽያ ሂላንቻን ኦስሳ። ሄ ትራን ዎያዋ ኤፉድያ ዳዴዳዋዳን፥ ዎርቃፐ፥ ሳሉዋ ማላትያ፥ ኦቻ ቴራ ማላትያነ ሾሎላ ዞኦ ቃጭናፐነ ሊቆ ሊኑዋፐ ዳዳ። <verse eid="EXO 28:15"/><verse number="16" style="v" sid="EXO 28:16"/>አዉ ኦይዱ ጋጻይ ደኤ፤ ጌሳይካ ጎምፓይ እት እት ታካ ግዲደ ዳኮቶ። <verse eid="EXO 28:16"/><verse number="17" style="v" sid="EXO 28:17"/>ሄዋፐ ጉይያን አ ቦላ ኦይዱ ማራን አልኦ ሹቻቱዋ ዎ፤ ኮይሮ ማራን ዎዳ ሹቻይ፥ ሳርድዮና፥ ቶጳዝዮንያነ ጶልያ እንቁዋ። <verse eid="EXO 28:17"/><verse number="18" style="v" sid="EXO 28:18"/>ላኤን ማራን ባሉርያ፥ ሳምፔርያነ አልማዝያ ግያ አልኦ ሹቻቱዋ፤ <verse eid="EXO 28:18"/><verse number="19" style="v" sid="EXO 28:19"/>ሄዘን ማራን ያክንትያ፥ ከልቀዶንያነ አመተስጽኖስያ፤ <verse eid="EXO 28:19"/><verse number="20" style="v" sid="EXO 28:20"/>ኦይደን ማራን ብራል፥ ማርግድያ፥ ያስጲድያ። ሀዋንቱ ኡባይ ዎርቃፐ ኦሰቴዳ ሹቻ ኦይቂያዋ ቦላ ኡትኖ። <verse eid="EXO 28:20"/><verse number="21" style="v" sid="EXO 28:21"/>እስራኤልያ ናናቱዋ ሱን ፓይዱዋዳን፥ ሹቻቱዋ ፓይዱካ ታማነ ላኡዋ ግድኖ፤ እቱ እቱ ማታፋዳን ዎጨቲደ፥ ታማነ ላኡ ዛራቱዋ ሱንይ ሄ ሹቻቱዋን ጻፈቶ።<verse eid="EXO 28:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 28:22"/>“ትራን ዎያዎ ዎዶሩዋዳን ዶቀቴዳ ሳንሳላታ ዋላካይ ባይና ዎርቃፐ መ። <verse eid="EXO 28:22"/><verse number="23" style="v" sid="EXO 28:23"/>ላኡ ዎርቃ ምግዳቱዋ መደ፥ ትራን ዎያዎ ቆሞ ጋጻ ጋደ ኦይ ዎ። <verse eid="EXO 28:23"/><verse number="24" style="v" sid="EXO 28:24"/>ሄ ላኡ ዎርቃ ሳንሳላታቱዋ ትራን ዎያዎ ጋጻን ደእያ ምግዶቱዋና ጋደ ኦይ። <verse eid="EXO 28:24"/><verse number="25" style="v" sid="EXO 28:25"/>ሄ ሳንሳላታቶ የንኮ ባጋ ጼራ ቃይ ኤፉድያዉ ስን ባጋና፥ ሀሽያ ጫርቂያን ደእያ ሹቻ ኦይቂያዋንቱና ጋ ቃቻ። <verse eid="EXO 28:25"/><verse number="26" style="v" sid="EXO 28:26"/>ቃይካ ላኡ ዎርቃ ምግዳቱዋ መደ፥ ኤፉድያፐ ጋርሳን ካሊደ ደእያ ትራን ዎያዎ ሶ ባጋና ደእያ ላኡ ጋጻ ጼራን አ። <verse eid="EXO 28:26"/><verse number="27" style="v" sid="EXO 28:27"/>ሄዋዳንካ፥ ዎርቃፐ ሀራ ላኡ ምግዳቱዋ መደ፤ ኤፉድያዉ ስን ባጋና፥ ሀሽያ ጫርቂያፐ ጋርሳ ባጋና፥ ኤፉድያ ጼሳን ቃችያዋፐ ቆሞና፥ ስኩ ጋከቴዳ ሳኣ ማታን ካረና ኡንቱንታ ኦይ። <verse eid="EXO 28:27"/><verse number="28" style="v" sid="EXO 28:28"/>ትራን ዎያዋን ደእያ ምግዳቱዋ ኤፉድያን ደእያ ምግዶቱዋና ጋደ፥ ሳሉዋ ማላትያ ባቀን ቃቻ፤ ያቶፐ፥ ትራን ዎያዌ ጼሳፐ ቆሞና ደእያ ድራዉ፥ ቃሹ ሾልኤና።<verse eid="EXO 28:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 28:29"/>“አሮነ ጌሻ ሳኣ ገልያ ዎደ፥ ሀ ትራን ዎያ መና ጎዳ ሸንያ በስያዌ ደእያ እስራኤልያ ዛራቱዋ ሱንቱዋ ቶኮ። ያቶፐ ታን መና ጎዳይ ኡባደ ታ አሳ ሀሳያና። <verse eid="EXO 28:29"/><verse number="30" style="v" sid="EXO 28:30"/>ቃይ ኡሪምያነ ቱሚምያ ጌተትያዋንታ ትራን ዎያዋን የጋ። አሮነ መና ጎዳ ስን አደ፥ ባረ ትራን ዎ አኪደ ገሎ። ታ ሸኒ አየንቶ እስራኤልያ አሳ ኤርሳና ማላ፥ እ ታ ስንን ኦናዉ ገልያ ዎደ ኡባን ባረ ትራ ኪስያፐ ይሶፖ።<note caller="-" style="x"><char style="xo" closed="false">28:30 </char><char style="xt" closed="false"><ref loc="NUM 27:21">ፓይ. 27:21</ref>፤ <ref loc="DEU 33:8">ዛረ. 33:8</ref>፤ <ref loc="EZR 2:63">እዝራ 2:63</ref>፤ <ref loc="NEH 7:65">ናህ. 7:65</ref></char></note><verse eid="EXO 28:30"/></para>
  <para style="s1">ሀራ ቄሳቱዋ ካፑዋ ማዩዋነ ቄሳቱዋ ማዩዋ</para>
  <para style="r">(<ref loc="EXO 39:22-31">39:22-31</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 28:31"/>“ኤፉድያፐ ጋርሳና ማይያ አዱሳ ማዩዋ ኡባ ሳሉዋ ማላትያ ጫርቂያፐ ጊግሳ። <verse eid="EXO 28:31"/><verse number="32" style="v" sid="EXO 28:32"/>ሄ አዱሳ ማዮ ቆያ አያ ሳኣ መ። ሄ ሳአይ ፔተናዳን፥ ዩሻ አደ ጉጃ ጉጃ ስካ። <verse eid="EXO 28:32"/><verse number="33" style="v" sid="EXO 28:33"/>አዱሳ ማዩዋ ዱገ ባጋ ማጫራ ዩሹዋን ሳሉዋ ማላትያ፥ ኦቻ ቴራ ማላትያነ ሾሎላ ዞኦ ሮማንያ አይፍያ ቴራ ምስለቱዋ መ። ያታደ ኡንቱንቱ ግዱዋን ዎርቃፐ ኦሰቴዳ ዳዋላቱዋ ዋላካን ኦ። <verse eid="EXO 28:33"/><verse number="34" style="v" sid="EXO 28:34"/>ዎርቃ ዳዋላቱነ ሮማንያ ቴራ ምስለቱ ሄ አዱሳ ማዩዋ ዱገ ባጋ ጼራዉ ዩሹዋን ዋላካን አኖ። <verse eid="EXO 28:34"/><verse number="35" style="v" sid="EXO 28:35"/>አሮነ ቄሳተን ኦያ ዎደ፥ ሀ አዱሳ ማዩዋ ማዮ፤ መና ጎዳ ስን ጌሻ ሳኣ ገልያ ዎደነ ከስያ ዎደ፥ ዳዋላይ ዋሳና። ሄዋ ድራዉ እ ሀይቀና።<verse eid="EXO 28:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 28:36"/>“ዋላካይ ባይና ዎርቃፐ እት አሌቁዋ መደ ማታፋ ቦላ ዎጭያዋዳን፥ አ ቦላ ዎጫደ፥ ‘መና ጎዳዉ ጌሻ ግዲደ ዱማቴዳ’ ያጋደ ጻፋ። <verse eid="EXO 28:36"/><verse number="37" style="v" sid="EXO 28:37"/>ሁጲያን ጻጽያ ሻሽያፐ ጻደና ዴሙዋን ቃቻና ማላ፥ ሳሉዋ ማላትያ ባቀ አን አ። <verse eid="EXO 28:37"/><verse number="38" style="v" sid="EXO 28:38"/>አሮነ አ ባረ ዴሙዋን ዎ፤ ሄዋን እስራኤልያ አሳይ መና ጎዳዉ ጌሻ ያርሾ እምያዋን ፓጫይ ደኦፐ፥ ሄ ባይዙዋ አሮነ ቶኬ። አሳይ አህያዋ ኡባ መና ጎዳይ አካና ማላ፥ እ ሄዋ ኡባ ገደካ ባረ ደሙዋን ዎናዉ ኮሼ።<verse eid="EXO 28:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="EXO 28:39"/>“አሮና አዱሳ ሻምጭያ ሊቆ ሊኑዋፐ ዳዳ፤ ሁጲያን ጻጽያ ሻሽያካ ሊኑዋፐ ጊግሳ። ቃይ ዳንጩዋ ጽልፕያን አሌቅስያዋን ስክሳ። <verse eid="EXO 28:39"/><verse number="40" style="v" sid="EXO 28:40"/>አሮና ናናዉ ቦንቾነ አሌቆ ግዳና ማላ፥ አዱሳ ሻምጭያ፥ ዳንጮቱዋነ ሁጲያን ጻጽያ ሻሸቱዋ ጊግሳ። <verse eid="EXO 28:40"/><verse number="41" style="v" sid="EXO 28:41"/>ኔን ሀ ማዮቱዋ ነ እሻ አሮናነ አ ናና ማይዜዳዋፐ ጉይያን፥ ኡንቱንታ ቄሰተን ሱንደ ታዉ ኦና ማላ ኦካደ ዱማያ።<verse eid="EXO 28:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="EXO 28:42"/>“ኡንቱንቱ ካሉ ካመታና ማላ ጋርሳና ማይያ ማዩዋ፥ ጼሳፐ ቢደ ዎድርያ ጋካናዉ ካምያዋ፥ ሊቆ ሊኑዋ ቃጭናፐ ዳዳደ ጊግሳ። <verse eid="EXO 28:42"/><verse number="43" style="v" sid="EXO 28:43"/>አሮነነ አ ናናይ ጾሳ ዱንካንያ ገልያ ዎደ፥ ዎይ ያርሹዋ ያርሽያ ጌሻ ሳኣን ቄሳተን ኦናዉ ሺቅያ ዎደ፥ ሀ ማዮቱዋ ማይኖ። ሄዋዳን ሀኖፐ፥ ኡንቱንቱ ባረንቱ ቦላ ባይዙዋነ ሀይቁዋ አህክኖ።</para>
  <para style="p" vid="EXO 28:43">“ሀዌ አሮናዉነ አ ዛረቶ መናዉ ዎጋ ግዶ።<verse eid="EXO 28:43"/></para>
  <chapter eid="EXO 28"/>
  <chapter number="29" style="c" sid="EXO 29"/>
  <para style="s1">ቄሳተ ሱን እሚደ ፖልያ ዎጋቱዋ</para>
  <para style="r">(<ref loc="LEV 8:1-36">ዎጋ 8:1-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 29:1"/>“አሮነነ አ ናናይ ቄሳቱዋ ግዲደ ታዉ ኦና ማላ፥ ኔን ኡንቱንታ ዱማያናዉ ሀዋዳን ኦ፤ ትላ ቦላና ደእያ እት ኮሩማ፥ ላኡ ዶርሳ ኮለቱዋ አካ፤ <verse eid="EXO 29:1"/><verse number="2" style="v" sid="EXO 29:2"/>ሙሩታ ዛርጋ ልያ አካደ፥ እርሹዋ የገናን ኡክ ኡካ፤ ቃይ እርሹዋ የገናን ዛይትያን ኮምፑዋ ኮምፓ፤ ሄዋዳንካ፥ እርሹዋ የገናን ሌኦ ኡክ ኡካደ፥ ዛይትያ ኦካ። <verse eid="EXO 29:2"/><verse number="3" style="v" sid="EXO 29:3"/>ኔን ኡንቱንታ ሳምፓን ዎደ፥ ኮሩማናነ ላኡ ዶርሳ ኮለቱዋና እትፐ ታዉ ሺሻ።<verse eid="EXO 29:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 29:4"/>“ያታደ አሮናነ አ ናና ጾሳ ዱንካንያ ፐንገ አሃደ፥ ሃን ኡንቱንታ ሜጫ። <verse eid="EXO 29:4"/><verse number="5" style="v" sid="EXO 29:5"/>ሄዋፐ ጉይያን ማዮቱዋ አካደ፥ አዱሳ ሻምጭያ፥ ኤፉድያ ጋርሳና ማይያ አዱሳ ማዩዋ፥ ኤፉድያነ ትራን ዎያዋ አሮና ማይዛደ ኤፉድያ ሂላን ዳደቴዳ ዳንጩዋን ዳንጭሳ። <verse eid="EXO 29:5"/><verse number="6" style="v" sid="EXO 29:6"/>ሻሽያካ አ ሁጲያን ጻጻደ፥ ‘ጾሳዉ ጌሻ ግዲደ ዱማቴዳ’ ያግያዌ ጻፈቴዳ አሌቁዋ ስን ደሙዋን ሻሽያ ምይያን አ። <verse eid="EXO 29:6"/><verse number="7" style="v" sid="EXO 29:7"/>ኦክያ ዛይትያካ አካደ፥ አ ሁጲያን ትጋደ ኦካ። <verse eid="EXO 29:7"/><verse number="8" style="v" sid="EXO 29:8"/>አ ናናካ አሃደ አዱሳ ሻምጭያ ማይዛ። <verse eid="EXO 29:8"/><verse number="9" style="v" sid="EXO 29:9"/>ሻሽያካ ኡንቱንቱ ሁጲያን ጻጻ። ሄዋፐ ጉይያን አሮናነ አ ናና ዳንጩዋ ዳንጭሳ። ቄሳተይ ኡንቱንቶ መና ዎጋ ግዶ። ስም አሮናነ አ ናና ያታደ ቄሳቱዋ ኦሳ።<verse eid="EXO 29:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 29:10"/>“ኮሩማ፥ ጾሳ ዱንካንያ ስን ኔን አህና፥ አሮነነ አ ናናይ አ ሁጲያን ባረንቱ ኩሽያ ዎኖ። <verse eid="EXO 29:10"/><verse number="11" style="v" sid="EXO 29:11"/>ኮሩማ፥ መና ጎዳ ዱንካንያ ገልያ ፐንግያን መና ጎዳ ማታን ሹካ። <verse eid="EXO 29:11"/><verse number="12" style="v" sid="EXO 29:12"/>ኮሩማ ሱፐ አማሬዳዋ ነ ብራያን አካደ፥ ያርሽያ ሳኣ ቦላ ደእያ ካጨቱዋ ኦክሽን አቴዳዋ ያርሽያ ሳኣፐ ጋርሳ ባጋና ጉሳ። <verse eid="EXO 29:12"/><verse number="13" style="v" sid="EXO 29:13"/>ሄዋፐ ጉይያን ቃን አሹዋ ካሜዳ ሞያ ኡባ፥ ትርያ ጼራ ቦላ ደእያ ሞያ፥ ላኡ ክላሆቱዋነ ኡንቱንታ ካሜዳ ሞያ አካደ፥ ያርሽያ ሳኣ ቦላ ጹጋ። <verse eid="EXO 29:13"/><verse number="14" style="v" sid="EXO 29:14"/>ሽን ኮሩማ አሹዋ፥ አ ጋልባነ አ ማራጭያን ደእያ ቶጪያ አሳይ ኡቶ ሄራፐ ሃሳደ ጹጋ፤ ሄዌ ናጋራ ድራዉ ያርሽያ ያርሹዋ።<verse eid="EXO 29:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 29:15"/>“ላኡ ዶርሳ ኮለቱዋፐ እቱዋ ኔን አክና፥ አሮነነ አ ናናይ ባረንቱ ኩሽያ አ ሁጲያን ዎኖ። <verse eid="EXO 29:15"/><verse number="16" style="v" sid="EXO 29:16"/>ያቶፐ ዶርሳ ኮልያ ሹካደ፥ ሱ ያርሽያ ሳኣ ምይያን ኡባ ሳኣን ፑሻካ። <verse eid="EXO 29:16"/><verse number="17" style="v" sid="EXO 29:17"/>ዶርሳ ኮልያ አሹዋ ቃንጸሬደ፥ ቃን አሹዋካ ገድያ ሜጫደ ሁጲያ ቦላነ ሀራ ቆሞ አሾቱዋ ቦላ ኡንቱንታ ዎ፤ <verse eid="EXO 29:17"/><verse number="18" style="v" sid="EXO 29:18"/>ሄዋፐ ጉይያን፥ ዶርሳ ኮልያ ኡባና ያርሽያ ሳኣን ጹጋ፤ ሄዌ መና ጎዳዉ ጹገትያ ያርሹዋ፥ ሳዉዋ ቶሽኩ ግያ ያርሹዋነ መና ጎዳዉ ታማን ያርሽያ ያርሹዋ።<note caller="-" style="x"><char style="xo" closed="false">29:18 </char><char style="xt" closed="false"><ref loc="EPH 5:2">ኤፈ. 5:2</ref>፤ <ref loc="PHP 4:18">ፕልጵ. 4:18</ref></char></note><verse eid="EXO 29:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 29:19"/>“ቃይ የንኮ ዶርሳ ኮልያ አሮነነ አ ናናይ ባረንቱ ኩሽያ አ ሁጲያን ዎና ማላ ኔን አሀ። <verse eid="EXO 29:19"/><verse number="20" style="v" sid="EXO 29:20"/>ሄ ዶርሳ ኮልያ ሹካደ፥ አ ሱፐ አማሬዳዋ አካደ፥ አሮናዉነ አ ናናዉ ኡሸቻ ሀይቱዋ ጼራ፥ ኡንቱንቱ ኡሸቻ ኩሸቶ ዎጋ ብራቱዋነ ኡንቱንቱ ኡሸቻ ገደቶ ዎጋ ብራቱዋ ኦካ፤ ሄዋፐ ጉይያን፥ አቴዳ ሱ ያርሽያ ሳኣ ምይያን ኡባ ሳኣን ፑሻካ። <verse eid="EXO 29:20"/><verse number="21" style="v" sid="EXO 29:21"/>ያርሽያ ሳኣን ደእያ ሱፐ አማሬዳዋነ ትግያ ዛይትያፐካ አማሬዳዋ አካ፥ አሮና ቦላነ አ ማዩዋ ቦላ፥ አ ናናቱዋ ቦላነ ኡንቱንቱ ማዩዋ ቦላ ፑሻካ። እነ አ ናናይ፥ ኡንቱንቱ ማዩ ጾሳ ኦሶ ዱማታናዋ።<verse eid="EXO 29:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 29:22"/>“ሀ ዶርሳ ኮልያፐ ሞዋ፥ ናስያ፥ ቃን አሹዋ ቦላ ደእያ ሞያ፥ ትርያ ጼራ ቦላ ደእያ ሞያ፥ ላኡ ክላሆቱዋ፥ ኡንቱንታ ካሜዳ ሞያነ ኡሸቻ ባጋና ደእያ ጉየ ገድያ አካ፤ ሀዌ ቄሳተ ሱን እምያ ዎደ ሹክያ ዶርሳ። <verse eid="EXO 29:22"/><verse number="23" style="v" sid="EXO 29:23"/>መና ጎዳ ስንን ዎዳ እርሹ ገልቤና ኡክ፥ ሳምፓፐ ዛይቲ ዋላከትቤና ኡክ፥ ዛይትያና ኡኬዳ እት ኮምፑዋነ እት ሌኦ ኡክ አካ። <verse eid="EXO 29:23"/><verse number="24" style="v" sid="EXO 29:24"/>ኔን ሀ ቁማ ኡባ አሮና ኩሽያንነ አ ናናቱዋ ኩሽያን ዎደ ዉጻካናዳን ኦ። ኡንቱንታ መና ጎዳ ስንን ፑደነ ዱገነ ቃኖ። <verse eid="EXO 29:24"/><verse number="25" style="v" sid="EXO 29:25"/>ሄዋፐ ጉይያን ኡንቱንቱ ኩሽያፐ ሀዋንታ አካደ፥ ያርሽያ ሳኣ ቦላ ዎደ፥ ጹግያ ያርሹዋና ጋደ፥ መና ጎዳዉ ሳዉዋ ቶሽኩ ጋናዳን፥ ያርሽያ ሳኣ ቦላ ታማን ጹጋ። <verse eid="EXO 29:25"/><verse number="26" style="v" sid="EXO 29:26"/>አሮነ ቄሳ ግዲደ ሱንትያ ዎደ ሹኬዳ ዶርሳ ኮልያ አንጎሱዋ አካደ፥ መና ጎዳ ስንን ቃያ ያርሹዋዳን ቃ፤ ሄዌ ኔና ጋክያ ነ ምያ ግሹዋ ግዳናዋ።<verse eid="EXO 29:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 29:27"/>“ሄ ሹኬዳ ዶርሳ አሹዋ ቆሞቱዋፐ፥ ያርሹዋ ኦደ ቃዳ አንጎሱዋነ ጾሳ ስንን ፑደ ቶኬዳ ገድያ ጌሻ፤ ሄዋንቱ አሮናዉነ አ ናናዉ ግሹዋ ግዳናዋንታ። <verse eid="EXO 29:27"/><verse number="28" style="v" sid="EXO 29:28"/>እስራኤላቱ መና ጎዳዉ እምያ እትፐተ ያርሹዋፐ ቃያ ባጋዉ ዎጋይ፥ ኡባ ገደካ እስራኤልያ አሳፐ ሺቆደ አሮናዉነ አ ናናዉ ጋክያ ግሹዋ ግዶ።<verse eid="EXO 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 29:29"/>“አሮና ቄሳተ ጌሻ ማዩ አ ሀይቁዋፐ ጉይያን አ ዛረቶ ደኦ፤ ኡንቱንቱ ቄሳቱዋ ካፑዋ ግድያ ዎደ ሀ ማዩዋ ኦከታናዉነ ዱማታናዉ ማይኖ። <verse eid="EXO 29:29"/><verse number="30" style="v" sid="EXO 29:30"/>አ ናናቱዋፐ አ ሳኣን ቄሳቱዋ ግዲደ፥ ጌሻ ሳኣን ኦናዉ ጾሳ ዱንካንያ ይያ ናአይ፥ ሄ ማዩዋ ላፑን ጋላሳዉ ማዮ።<verse eid="EXO 29:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 29:31"/>“አሮነነ አ ናናይ ቄሳቱዋ ግዲደ ሱንትያ ዎደ ሹከቴዳ ዶርሳ ኮልያ አሹዋ አካደ፥ ጌሻ ሳኣን ዶይሳ። <verse eid="EXO 29:31"/><verse number="32" style="v" sid="EXO 29:32"/>አሮነነ አ ናናይ ዶርሳ ኦርግያ አሹዋካ ማሶፍያን ደእያ ኡክ ጾሳ ዱንካንያ ገልያ ፐንግያን ሚኖ። <verse eid="EXO 29:32"/><verse number="33" style="v" sid="EXO 29:33"/>ኡንቱንቱ ቄሳቱዋ ግዲደ ሱንታናዉነ ዱማታናዉ ናጋራይ አቶ ጌተታናዳን ያርሸቴዳ ሀ ያርሾቱዋ ሚኖ። ሽን ሄ ያርሾቱ ጌሻ ግዴዳ ድራዉ፥ ሀራ አሳይ ኦነ ሞፖ። <verse eid="EXO 29:33"/><verse number="34" style="v" sid="EXO 29:34"/>ቄስያ ግዲደ ሱንትያ ዎደ ሹኬዳ ዶርሳ ኮልያ አሹዋፐ ዎይ ኡክፐ ዎንታ ጋካናዉ ፓላሂደ አቆፐ፥ ታማን ጹገቶ፤ ጌሻ ግዴዳ ድራዉ ሜተቶፖ።<verse eid="EXO 29:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 29:35"/>“አሮነነ አ ናናይ ቄሳቱዋ ግዲደ ሱንትያ ዎደ ዎያ ዎጋ ልከ ታን ኔና አዛዜዳዋዳን ኦደ፥ ላፑን ጋላሳ ጋርሳን ፖላ። <verse eid="EXO 29:35"/><verse number="36" style="v" sid="EXO 29:36"/>ናጋራይ አቶ ጌተታናዳን ሀቼ ሀቼ ናጋራ ያርሹዋዳን እት ኮሩማ ያርሻ። ሄዋን ያርሽያ ሳኣ ጌሻ፤ ያታደ ያርሽያ ሳኣ ዱማያናዉ ኦካ። <verse eid="EXO 29:36"/><verse number="37" style="v" sid="EXO 29:37"/>ያርሽያ ሳኣ ናጋራ አቶ ግያ ዎጋ ላፑን ጋላሳን ፖላደ፥ አ ዱማያ። ያቶፐ ያርሽያ ሳአይ ጌሻ ኡባፐ እቱዋ ግዴዳ ጌሻ። አ ቦችያ ኡባይካ ጌያና።<verse eid="EXO 29:37"/></para>
  <para style="s1">ሀቼ ሀቼ ሺሽያ ያርሹዋ</para>
  <para style="r">(<ref loc="NUM 28:1-8">ፓይ. 28:1-8</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="EXO 29:38"/>“ያርሽያ ሳኣን ኔን ሀቼ ሀቼ ሺሻና ያርሹ ሀዋ። የለቶደፐ እት ላይ ግዴዳ ላኡ ዶርሳ ኦርገቱዋ ያርሻ። <verse eid="EXO 29:38"/><verse number="39" style="v" sid="EXO 29:39"/>ዶርሳ ኮለቱዋፐ እቱዋ ዎንታ፥ ቃይ ላኤንዋ ኦማርስ ያርሻ። <verse eid="EXO 29:39"/><verse number="40" style="v" sid="EXO 29:40"/>ኮይሮ ዶርሳ ማራና እት ኪሎ ግራመ ግዴዳ ሙሩታ ዛርጋ ልያ እት ሊትሮ ጉምኤቴዳ ዛይትያን ሙናቃደ ያርሻ፤ እት ሊትሮ ዎይንያ ኤሳካ ኡሻ ያርሹዋ ኦደ ያርሻ። <verse eid="EXO 29:40"/><verse number="41" style="v" sid="EXO 29:41"/>ላኤን ዶርሳ ኦርግያ ኦማርስ ያርሻደ ዎንታዋ ኬሻ፥ ልያ፥ ዛይትያነ ዎይንያ ኤሳ ሺሻ። ሄዌ መና ጎዳዉ ታማን ያርሸትያ፥ ሳዉዋ ቶሽኩ ግያ ያርሹዋ ግዳናዋ።<verse eid="EXO 29:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="EXO 29:42"/>“ሀ ጹግያ ያርሹ ይያ የለታ ኡባን ጾሳ ዱንካንያ ገልያ ፐንግያን መና ጎዳ ስንን ፓጭ ባይናን ያርሸታናዉ ኮሼ። ታን ያን ህንተንቱና ጋከታደ፥ ኔናና ሃሳያና። <verse eid="EXO 29:42"/><verse number="43" style="v" sid="EXO 29:43"/>ቃይ ያን ታን እስራኤላቱዋና ጋከታናዉ፥ ታ ቦንቹካ ሄ ሳኣ ዱማ ሳኣ ከሳና።<verse eid="EXO 29:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="EXO 29:44"/>“ሄዋ ድራዉ፥ ታን ጾሳ ዱንካንያነ ያርሽያ ሳኣ ዱማያና፤ ኡንቱንቱ ታዉ ቄሳቱዋ ግዲደ ታዉ ኦና ማላ፥ አሮናነ አ ናና ታን ዱማያና። <verse eid="EXO 29:44"/><verse number="45" style="v" sid="EXO 29:45"/>ያታደ ታን እስራኤለቱዋ ግዶን ደአና፤ ቃይ ታን ኡንቱንቱ ጾሳ ግዳና። <verse eid="EXO 29:45"/><verse number="46" style="v" sid="EXO 29:46"/>ታን ኡንቱንቱ ግዶን ደአና ማላ፥ ግብጼፐ ኡንቱንታ ከሴዳ መና ጎዳ ኡንቱንቱ ጾሳ ግድያዋ ኡንቱንቱ ኤራና። ኤ፥ ታን መና ጎዳ ኡንቱንቱ ጾሳ።<verse eid="EXO 29:46"/></para>
  <chapter eid="EXO 29"/>
  <chapter number="30" style="c" sid="EXO 30"/>
  <para style="s1">እጻና ጩዋይያ ሚሻ</para>
  <para style="r">(<ref loc="EXO 37:25-28">37:25-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 30:1"/>“እጻና ጩዋይያ ሚሻ ኦዶሮቱዋፐ መ፤ <verse eid="EXO 30:1"/><verse number="2" style="v" sid="EXO 30:2"/>አዉ ኦይዱ ጋጻይ ደኦ፤ አዱሳተይ እት ዋ፥ ጎምፓይ እት ዋ፥ ጌሳይ ላኡ ዋ ግዶ፤ ካጨቱካ አናና እቱዋ ግዲደ ኦይቀት መትኖ። <verse eid="EXO 30:2"/><verse number="3" style="v" sid="EXO 30:3"/>አዉ ቦላ ዶና፥ ኦይዱ ባጋ ኡባነ አ ካጨቱዋ ዋላካይ ባይና ዎርቃን ሼሻ፤ አ ዩሹዋንካ ዎርቃ ትገ ዩሻ አ። <verse eid="EXO 30:3"/><verse number="4" style="v" sid="EXO 30:4"/>ሄ ዎርቃ ትገፐ ጋርሳና እጻና ጩዋይያ ሳጽንያዉ ዎርቃፐ ላኡ ሳጋየቱዋ መ፤ ያታደ ያ ባጋናነ ሀ ባጋና ላኡዋ ላኡዋ ኦይ። ሄዋንታ ቶክያ ዎደ ካሱዋ አናዉ ማዳናሳ። <verse eid="EXO 30:4"/><verse number="5" style="v" sid="EXO 30:5"/>ካሶቱዋ ኦዶሮቱዋፐ ከሳደ፥ ኡንቱንታ ዎርቃን ሼሻ። <verse eid="EXO 30:5"/><verse number="6" style="v" sid="EXO 30:6"/>ሀ ያርሽያ ሚሻ ቃላ ጫቁዋ ታቦታ ስንን ካቀቴዳ ጋርዱዋፐ ካረ ባጋና፥ ሄዋካ ታን ኔናና ጋከትያ ቃላ ጫቁዋ ታቦታ ቦላ ደእያ አቶ ግያ ሳኣ ቁምእያ ስንን ዎ።<verse eid="EXO 30:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 30:7"/>“አሮነ ዎንታ ዎንታ ጾምፐቱዋ ጊግሳናዉ ይያ ዎደ፥ ሳዊያ እጻና ያርሽያ ሳኣን ጩዋዮ። <verse eid="EXO 30:7"/><verse number="8" style="v" sid="EXO 30:8"/>አሮነ ኦማርስ ጾምፐቱዋ ፖእስያ ዎደ፥ ዛረደካ እጻና ጩዋዮ፤ ያቶፐ፥ እጻናይ መና ጎዳ ስንን ይያ የለታዉ ኡባደ ጩዋታና። <verse eid="EXO 30:8"/><verse number="9" style="v" sid="EXO 30:9"/>ሀ እጻና ጩውስያ ሚሻን ሀራ አይ እጻናነ፥ ዎይ ጹግያ ያርሹዋ፥ ዎይ ካ ያርሹዋ ያርሾፓ፤ ኡሻ ያርሹዋካ አ ቦላ ትጎፖ። <verse eid="EXO 30:9"/><verse number="10" style="v" sid="EXO 30:10"/>አሮነ ላይፐ እት ገደ ናጋራፐ ማረታናዉ ሹክያ መህያ ሱ አኪደ፥ ሄ ያርሽያ ሳኣ ቦላ ደእያ ካጨቱዋ ቦላ ዎ። ያቲደ ጌሽያ ዎጋ ፖሎ። ሀ ዎጋይ ስንና ያና ዎደቱዋ ኡባን ላይን ላይን ፖለቶ። ሀ እጻናይ ጩውያ ሚሻይ መና ጎዳዉ ዱማት ሎይ ጌዬዳዋ ግዶ” ያጌዳ።<verse eid="EXO 30:10"/></para>
  <para style="s1">ዱንካንያዉ ሺቅያ ሚሻ</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 30:11"/>ሄዋፐ ጉይያን መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="EXO 30:11"/><verse number="12" style="v" sid="EXO 30:12"/>“ኔን እስራኤልያ አሳ ፓይዱዋን አካናዉ ኡንቱንታ ፓይድያ ዎደ፥ እት እት ኡራይ ፓይደቲደ፥ ባረ ሸምፑዋ ዎዛናዉ መና ጎዳዉ ሻሉዋ ጭጎ። ኔን ኡንቱንታ ፓይድያ ዎደ፥ ኡንቱንቱ ቦላ ቦሻይ ዬና። <verse eid="EXO 30:12"/><verse number="13" style="v" sid="EXO 30:13"/>ፓይዱዋን ገልያ አሳይ ሁጲያን ሁጲያን ዱንካንያን ኤረትያ ሚዛና ልክያን ብራ ጭጎ። እት እት ኡራይ ሀዋ መና ጎዳዉ እሞታ ኦደ እሞ።<note caller="-" style="x"><char style="xo" closed="false">30:13 </char><char style="xt" closed="false"><ref loc="EXO 38:25-26">ከሳ 38:25-26</ref>፤ <ref loc="MAT 17:24">ማቶሳ 17:24</ref></char></note> <verse eid="EXO 30:13"/><verse number="14" style="v" sid="EXO 30:14"/>ፓይዱዋን ገልያ አሳይ ላይይ ላታሙ ኩሜዳዌነ ሄዋፐ ቦላ ኡባይ፥ መና ጎዳዉ እምያዋ አሆ። <verse eid="EXO 30:14"/><verse number="15" style="v" sid="EXO 30:15"/>ህንተንቱ ህንተንቱ ናጋራፐ ማረታናዉ መና ጎዳዉ እሙዋ እምሽን፥ ዱሪካ ማንቁካ እት ልክያ እማናፐ አትና፥ ዱሪ ዳርሲደ ዎይ ማንቁ ላፈደ እሞፖ። <verse eid="EXO 30:15"/><verse number="16" style="v" sid="EXO 30:16"/>ናጋራፐ ማረታናዉ ጭግያ ሻሉዋ እስራኤልያ አሳፐ አካደ፥ መና ጎዳ ዱንካንያ ግዶ ኦሶ ፔሻ። ሀ ሻሉ ህንተንቱ ናጋራፐ ማረታናዉ፥ መና ጎዳ ስንን እስራኤልያ አሳዋ ሀሳይያዋ ግዳናዋ” ያጌዳ።<verse eid="EXO 30:16"/></para>
  <para style="s1">ሜቻ ከርያ</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 30:17"/>ሄዋፐ ጉይያን መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="EXO 30:17"/><verse number="18" style="v" sid="EXO 30:18"/>“ሜቻ ከርያነ አ ዎያዋ ናሃስያፐ መደ ጾሳ ዱንካንያፐነ ያርሽያ ሳኣፐ ግዱዋን ዎ፤ አን ሃ ትጋ።<note caller="-" style="x"><char style="xo" closed="false">30:18 </char><char style="xt" closed="false"><ref loc="EXO 38:8">ከሳ 38:8</ref></char></note> <verse eid="EXO 30:18"/><verse number="19" style="v" sid="EXO 30:19"/>አሮነነ አ ናናይ ባረንቱ ኩሽያነ ባረንቱ ገድያ ሜጨታና። <verse eid="EXO 30:19"/><verse number="20" style="v" sid="EXO 30:20"/>ኡንቱንቱ ሀይቀና ማላ፥ ጾሳ ዱንካንያ ገልያ ዎደ፥ አዉደነ ሄ ሃን ሜጨትኖ። ቃይ መና ጎዳዉ ታማን ያርሹዋ ያርሻናዉ ያርሽያ ሳኣ ማታ ሺቄዳ ዎደ፥ <verse eid="EXO 30:20"/><verse number="21" style="v" sid="EXO 30:21"/>ኡንቱንቱ ሀይቀና ማላ፥ ባረንቱ ኩሽያነ ባረንቱ ገድያ ሜጨትኖ። ሀዌ አሮናዉነ አ ዛረቶ፥ ይያ የለታ ኡባዉ መናዉ ዎጋ ግዳናዋ” ያጌዳ።<verse eid="EXO 30:21"/></para>
  <para style="s1">ኦከትያ ዛይትያ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 30:22"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤<note caller="-" style="x"><char style="xo" closed="false">30:22-38 </char><char style="xt" closed="false"><ref loc="EXO 37:29">ከሳ 37:29</ref></char></note> <verse eid="EXO 30:22"/><verse number="23" style="v" sid="EXO 30:23"/>“ሙሩታ ቅማመቱዋ፥ ሄዋንቱካ፥ ኡሱፑን ኪሎ ግራመ ጉክያ ካርቢያ፥ ሄዙ ኪሎ ግራመ ሳዊያ ቃራፋ፥ ሄዙ ኪሎ ግራመ ሳዊያ ጉንጨቻነ <verse eid="EXO 30:23"/><verse number="24" style="v" sid="EXO 30:24"/>ኡሱፑን ኪሎ ግራመ ዝምባኑዋ አካ። ሀ ኡባይካ ዱንካንያን ኤረትያ ሚዛና ልክያን ግዶ። ሄዋ ቦላካ ኦይዱ ሊትሮ ዎጋራ ዛይትያ ጉጃ። <verse eid="EXO 30:24"/><verse number="25" style="v" sid="EXO 30:25"/>ሀዋንታ ሽቱዋ ኦያ ኤራን ዋላካደ፥ ሳዊያ ጌሻ ኦክያ ዛይተ ከሳ። <verse eid="EXO 30:25"/><verse number="26" style="v" sid="EXO 30:26"/>ያታደ ጾሳ ዱንካንያ፥ ቃላ ጫቁዋ ታቦታ፥ <verse eid="EXO 30:26"/><verse number="27" style="v" sid="EXO 30:27"/>ጻርጴዛነ አ ቦላ ዎያ ሚሻ ኡባ፥ ጾምፕያ ዎያ ባላነ አ ሚሻቱዋ፥ እጻና ጩዋይያ ሚሻ፥ <verse eid="EXO 30:27"/><verse number="28" style="v" sid="EXO 30:28"/>ጹግያ ያርሹዋ ያርሽያ ሳኣነ አን ደእያ ኡባ ሚሻቱዋ፥ ሜቻ ከርያነ አ ዎያዋ ኦካ። <verse eid="EXO 30:28"/><verse number="29" style="v" sid="EXO 30:29"/>ኡንቱንቱ ሎይ ጌሻ ግዳና ማላ፥ ኔን ኡንቱንታ ዱማያ፤ ኡንቱንታ ቦችያዌ ኡባይካ ጌሻ ግዳናዋ።<verse eid="EXO 30:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 30:30"/>“ሄዋፐ ጉይያን አሮነነ አ ናናይ ቄሳቱዋ ግዲደ ታዉ ኦና ማላ፥ ኡንቱንታ ኦካደ ዱማያ፤ <verse eid="EXO 30:30"/><verse number="31" style="v" sid="EXO 30:31"/>እስራኤልያ አሳዉ ሀዋዳን ያጋደ ኦዳ፤ ‘ሀዌ ይያ የለታዉካ ኦከትያ ታ ጌሻ ዛይተ ግዶ፤ <verse eid="EXO 30:31"/><verse number="32" style="v" sid="EXO 30:32"/>ሀ ዛይትያ አሳ ቦላን ጉሶፓ፤ ቃይ አይ ዛይቲካ ሄዋ ኦዳ ልክያን ኦፓ። እ ጌሻ ግዴዳ ድራዉ፥ ህንተንቱካ አ ጌሻባዳን ቆፕተ። <verse eid="EXO 30:32"/><verse number="33" style="v" sid="EXO 30:33"/>ሀዋ ማላ ሽቱዋ ጊግስያ ኡራይነ ቄሳቱዋ ግደና ሀራ አሳ ኦክያ ኡራይ ኦንነ ባረ አሳ ግዶፐ ቦሄቶ’ ያጋ” ያጌዳ።<verse eid="EXO 30:33"/></para>
  <para style="s1">እጻናባ</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 30:34"/>ሄዋፐ ጉየ መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ “ሳዊያ ቅማመቱዋ: ም ጮሻ፥ ያ ጎለን ደእያ ሽቱዋ፥ ሳዊያ ሽድያነ ሳዊያ ጌሻ እጻና አካ፤ ኡንቱንቱ ኡባ ዴጹካ እት ልከ ግዶ። <verse eid="EXO 30:34"/><verse number="35" style="v" sid="EXO 30:35"/>ሽቱዋዳን ዋላከቴዳ እጻና ኦደ፥ ኡንቱንቱን ጎኤታ፤ ዋላካይ ባይናዋነ ጌሻ ግዳናዳን፥ አን ማጽንያ የጋ። <verse eid="EXO 30:35"/><verse number="36" style="v" sid="EXO 30:36"/>አፐ አማሬዳዋ አካደ ሊቅሳደ ጫዳ፤ ያታደ ታን ኔናና ጋከትያ ጾሳ ዱንካንያ ግዶን ቃላ ጫቁዋ ታቦታ ስንን ዎ። እ ነዉ ሎይ ጌሻ ግዳናዋ። <verse eid="EXO 30:36"/><verse number="37" style="v" sid="EXO 30:37"/>ሀዋ መዳዋ ልክያን ሀራ እጻና መፕተ። ሄዌ መና ጎዳዉ ዱማ ጌሻ ግድያዋ ኤርተ። <verse eid="EXO 30:37"/><verse number="38" style="v" sid="EXO 30:38"/>ሀዋ ማላትያዋ መደ፥ አ ሳዉዋ ስንጊደ ናሸታናዉ ኮይያ ኡራይ ደኦፐ፥ እ ባረ አሳ ግዶፐ ቦሄቶ” ያጌዳ።<verse eid="EXO 30:38"/></para>
  <chapter eid="EXO 30"/>
  <chapter number="31" style="c" sid="EXO 31"/>
  <para style="s1">ባጻልኤላነ ኦሆልኣባ</para>
  <para style="r">(<ref loc="EXO 35:30-36:1">35:30—36:1</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 31:1"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="EXO 31:1"/><verse number="2" style="v" sid="EXO 31:2"/>“በአ፤ ታን ይሁዳ ዛረ ግዴዳ ሁራ ናኣ ናኣ፥ ኡራ ናኣ፥ ባጻልኤላ ዶራድ። <verse eid="EXO 31:2"/><verse number="3" style="v" sid="EXO 31:3"/>አ ታን ጾሳ አያናን፥ ሂላን፥ አኬካንነ ኦሱዋ ኡባ ኦያ ኤራን ኩንድ፤ <verse eid="EXO 31:3"/><verse number="4" style="v" sid="EXO 31:4"/>ሄዌካ ሂላን ኪታ ሀልቹዋ ከሲደ፥ ዎርቃፐ፥ ብራፐነ ናሃስያፐ ዱማ ዱማባ እ ኦናሳ። <verse eid="EXO 31:4"/><verse number="5" style="v" sid="EXO 31:5"/>ሄዋዳንካ፥ ሹቻ ማሲደ ጊግሳናዳንነ፥ ም ማሳናዉ ሀራ ኦሱዋ ኡባ እ ኦናሳ።<verse eid="EXO 31:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 31:6"/>“ሄዋ ቦላካ ቃይ አ ማዳና ማላ፥ ዳና ዛረ ግዴዳ አህሳማካ ናኣ ኦሆልኣባ ሱንድ። ታን ኔና አዛዜዳዋ ኡባ ኡንቱንቱ ኦና ማላ፥ ኩሽያ ሂላ ኤርያዋንቶ ኡባቶ ኤራ እማድ። <verse eid="EXO 31:6"/><verse number="7" style="v" sid="EXO 31:7"/>ኡንቱንቱ ኦናዉ: ጾሳ ዱንካንያ፥ ቃላ ጫቁዋ ታቦታ፥ አ ቦላ ዎያ አቶ ግያ ሳኣ ቁምእያ፥ ጾሳ ዱንካንያ ግዶን ጎኤትያ ሚሻ ኡባ፥ <verse eid="EXO 31:7"/><verse number="8" style="v" sid="EXO 31:8"/>ጻርጴዛነ አ ሚሻቱዋ፥ ጾምፕያ ዎያ ባላ ዋላካይ ባይና ዎርቃፐ ኦሰቴዳዋነ አ ሚሻ ኡባና፥ እጻና ጩውስያ ሚሻ፥ <verse eid="EXO 31:8"/><verse number="9" style="v" sid="EXO 31:9"/>ጹግያ ያርሹዋ ያርሽያ ሳኣነ አ ሚሻ ኡባና፥ ሜጨትያ ከርያነ አ ዎያዋና፥ <verse eid="EXO 31:9"/><verse number="10" style="v" sid="EXO 31:10"/>ዳደቴዳ ማዩዋ፥ ቄሳቱዋ ኡባቱዋ ካፑ አሮነ ማያና ጌሻ ቄሳተ ማዮቱዋነ አ አቱማ ናናይ ቄሳተ ኦደ ማያና ማዩዋ፥ <verse eid="EXO 31:10"/><verse number="11" style="v" sid="EXO 31:11"/>ቃይ ኦከትያ ዛይትያነ ጌሻ ሳአዉ ሳዉዋ ቶሽኩ ግያ እጻና። ኡንቱንቱ ሀዋ ኡባ ታን ኔና አዛዜዳዋዳን ኦኖ” ያጌዳ።<verse eid="EXO 31:11"/></para>
  <para style="s1">ሳምባታ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 31:12"/>ሄዋፐ ጉይያን መና ጎዳይ ሙሳ ሀዋዳን ያጊደ አዛዜዳ፤ <verse eid="EXO 31:12"/><verse number="13" style="v" sid="EXO 31:13"/>“እስራኤልያ አሳ ኔን፥ ‘ታ ሳምባታ ቦንችተ። ሄዌ ታን መና ጎዳይ ህንተንታ ታዉ ጌሻ ኦደ ዶሬዳዋ በስያዋ ግዲደ፥ ያና የለታ ኡባዉ ታፐነ ህንተፐ ግዱዋን ማላታ ግዳናዋ። <verse eid="EXO 31:13"/><verse number="14" style="v" sid="EXO 31:14"/>ህንተንቶ እ ጌሻ ግድያ ድራዉ፥ ሳምባታ ቦንችተ። አ ቱንስያዌነ ሄ ጋላሳን ኦያ አሳይ ኡባይ አሳ ግዶፐ ሀይቁዋን ቦሄቶ። <verse eid="EXO 31:14"/><verse number="15" style="v" sid="EXO 31:15"/>ኡሱፑን ጋላሳቱዋን ኔን ኦሱዋ ኦ፤ ሽን ላፑን ጋላሳይ መና ጎዳዉ ዱማቴዳ ሸምፖ ሳምባታ፤ ሳምባታ ጋላሳን አይ ኦሶነ ኦያ ኦንነ ሀይቆ።<note caller="-" style="x"><char style="xo" closed="false">31:15 </char><char style="xt" closed="false"><ref loc="EXO 20:8-11">ከሳ 20:8-11</ref>፤ <ref loc="EXO 23:12">23:12</ref>፤ <ref loc="EXO 34:21">34:21</ref>፤ <ref loc="EXO 35:2">35:2</ref>፤ <ref loc="LEV 23:3">ዎጋ 23:3</ref>፤ <ref loc="DEU 5:12-14">ዛረ. 5:12-14</ref></char></note> <verse eid="EXO 31:15"/><verse number="16" style="v" sid="EXO 31:16"/>እስራኤላቱ ሀ ሳምባታ ጋላሳ የለታፐ የለታዉ መና ቃላ ጫቁዋ ኦደ ቦንችኖ። <verse eid="EXO 31:16"/><verse number="17" style="v" sid="EXO 31:17"/>መና ጎዳይ ኡሱፑን ጋላሳቱዋን ሳሉዋነ ሳኣ መዳ ድራዉነ ቃይ ላፑን ጋላሳን ታን ኪታ አጋደ ሸምፔዳ ድራዉ፥ ታ ግዱዋንነ እስራኤላቱ ግዱዋን ሀዌ መናዉ ማላታ ግዳና’ ያጋ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">31:17 </char><char style="xt" closed="false"><ref loc="EXO 20:11">ከሳ 20:11</ref></char></note><verse eid="EXO 31:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 31:18"/>መና ጎዳይ ሙሴዉ ሲና ደርያ ቦላን ሃሳይያዋ ዉርሴዳ ዎደ፥ ጾሳይ ባረ ብራያን ጻፌዳ ታሙ አዛዙዋ ኦይቂደ ላኡ ማሰቴዳ ቃላ ጫቁዋ ሹቻቱዋ ሙሴዉ እሜዳ።<verse eid="EXO 31:18"/></para>
  <chapter eid="EXO 31"/>
  <chapter number="32" style="c" sid="EXO 32"/>
  <para style="s1">ዎርቃፐ መቴዳ ማራ</para>
  <para style="r">(<ref loc="DEU 9:6-29">ዛረ. 9:6-29</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 32:1"/>አሳይ ሙሴ ደርያፐ ዎናን ሎይ ጋምኤዳዋ በኤዳ ዎደ፥ አሮና ዩሹዋን ሺቂደ፥ “ሃያ፤ ኔን ኑና ካለያ ጾሳቱዋ ኑዉ መ። ግብጼ ጋድያፐ ኑና ከሴዳ ሙሳ ግዶፐ፥ እ ዋኔደንቶነ ኑን ኤሮኮ!” ያጌድኖ።<note caller="-" style="x"><char style="xo" closed="false">32:1 </char><char style="xt" closed="false"><ref loc="ACT 7:40">ኪታ 7:40</ref></char></note> <verse eid="EXO 32:1"/><verse number="2" style="v" sid="EXO 32:2"/>አሮነ ኡንቱንታ፥ “ህንተንቱ ማቻቱዋ ሀይንነ ህንተንቱ አቱማ ናናነ ማጫ ናናቱዋ ሀይን ደእያ ዎርቃ ከሲደ፥ ታዉ አኪደ አህተ” ያጌዳ። <verse eid="EXO 32:2"/><verse number="3" style="v" sid="EXO 32:3"/>ሄዋፐ ጉይያን አሳይ ኡባይ ባረ ሀይ ዎርቃ ከሲደ፥ አሮናዉ አሄድኖ። <verse eid="EXO 32:3"/><verse number="4" style="v" sid="EXO 32:4"/>እ ሄዋ ኡንቱንቱ ኩሽያፐ አኪደ፥ ሲልሴዳዋፐ ጉይያን ቆጽያባን ቆጺደ፥ ማራ ማላትያ ኤቃ ኦደ መዳ።<note caller="-" style="x"><char style="xo" closed="false">32:4 </char><char style="xt" closed="false"><ref loc="1KI 12:28">1 ካታ. 12:28</ref>፤ <ref loc="ACT 7:41">ኪታ 7:41</ref></char></note></para>
  <para style="p" vid="EXO 32:4">አሳይ፥ “እስራኤላቶ፥ ህንተንታ ግብጼ ጋድያፐ ከሴዳ ህንተንቱ ጾሳቱ ሀዋንታ” ያጌዳ። <verse eid="EXO 32:4"/><verse number="5" style="v" sid="EXO 32:5"/>አሮነ ሀዋ በኤዳ ዎደ፥ ሄ ማራ ስንን ያርሽያ ሳኣ ግምቢደ፥ “ዎንታ መና ጎዳ ባላ ጋላሳ ግዳናዋ” ያጊደ ኤርሴዳ። <verse eid="EXO 32:5"/><verse number="6" style="v" sid="EXO 32:6"/>ሄዋ ድራዉ፥ ዎንተ ጋላስ አሳይ ጉራን ደንዲደ፥ ጹግያ ያርሹዋ ሺሼዳ፤ እትፐተ ያርሹዋካ ያርሼዳ። ያቲደ አሳይ ማናዉነ ኡሻናዉ ኡቴዳ። ም ኡሽ ስሚደ፥ ቃይ ዱራናዉ ደንዴዳ።<note caller="-" style="x"><char style="xo" closed="false">32:6 </char><char style="xt" closed="false"><ref loc="1CO 10:7">1 ቆሮ. 10:7</ref></char></note><verse eid="EXO 32:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 32:7"/>ያንና መና ጎዳይ ሙሳ፥ “ኔን ኤለካ ዱገ ዎ፤ አያዉ ጎፐ፥ ነ አሳይ፥ ኔን ግብጼፐ ከሳደ አሄዳዌ ናጋራ ኦደ፥ ባረንቱ ሁጲያ ቱንሴድኖ። <verse eid="EXO 32:7"/><verse number="8" style="v" sid="EXO 32:8"/>ታን ኡንቱንታ አዛዜዳ ኦግያፐ ኡንቱንቱ ኤለካ ሸርእ ጌድኖ። ዎርቃ ሲልሴዳ ማራ ማላትሲደ፥ ባረንቶ ኤቃ መደ አዉ ጎይኔድኖ፤ አዉ ያርሼድኖ። ኡንቱንቱ፥ ‘እስራኤላቶ፥ ህንተንታ ግብጼ ጋድያፐ ከሴዳ ህንተንቱ ጾሳቱ ሀዋንታ’ ያጌድኖ” ያጌዳ።<verse eid="EXO 32:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 32:9"/>መና ጎዳይ ሙሳ፥ “ታን ሀ አሳ በኣድ፤ ኡንቱንቱ ሞርጊ ሌፋቴዳ አሳ። <verse eid="EXO 32:9"/><verse number="10" style="v" sid="EXO 32:10"/>ሀእ ታ ሀንቁ ኡንቱንቱ ቦላ ኤጽ ከስና፥ ታን ኡንቱንታ ባይዛናዋ ኔን ታና ድጎፓ። ያታደ ታን ኔና ዎልቃማ ካዉተ ኦና” ያጌዳ።<verse eid="EXO 32:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 32:11"/>ሽን ሙሴ መና ጎዳ ባረ ጾሳ ሀዋዳን ያጊደ ዎሴዳ፤ “አቤት መና ጎዳዉ ኔን ነ ዎልቃማ ዎልቃንነ ነ ምኖ ኩሽያን ግብጼፐ ከሳደ አሄዳ ነ አሳ ቦላ ነ ሀንቁ አያዉ ኤጽ ከስ?<note caller="-" style="x"><char style="xo" closed="false">32:11-14 </char><char style="xt" closed="false"><ref loc="NUM 14:13-19">ፓይ. 14:13-19</ref></char></note> <verse eid="EXO 32:11"/><verse number="12" style="v" sid="EXO 32:12"/>ግብጼቱ፥ ‘ጾሳይ ኡንቱንታ ደረቱዋ ቦላን ዎናዉነ ጋድያፐ ፕት ይሳናዉ፥ ኢታ ሀልቹዋን ከሴዳ’ አያዉ ግኖ? ነ ያሽያ ሀንቁዋፐ ስማ፤ ነ አሳ ይሳናዉ ቆፖዋ አጋ ባሻ። <verse eid="EXO 32:12"/><verse number="13" style="v" sid="EXO 32:13"/>ነ አይለቱዋ አብራሃማ፥ ይሳቃነ ያቆባ ሀሳያ፤ ኔን ኡንቱንቶ፥ ‘ታን ህንተንቱ ዛርያ ሳሉዋ ጾልንተቱዋዳን ዳርሳና፤ ሀ ታን ህንተንቶ እማና ጌዳ ጋድያ ኡባካ ህንተንቱ ዛርያዉ እማና፤ ኡንቱንቱ ሄ ጋድያ መናዉ ላታና’ ጋደ ነ ሁጲያን ኔን ጫቄዳ ቃላ ሀሳያ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">32:13 </char><char style="xt" closed="false"><ref loc="GEN 22:16-17">ዶመ 22:16-17</ref>፤ <ref loc="GEN 17:8">17:8</ref></char></note> <verse eid="EXO 32:13"/><verse number="14" style="v" sid="EXO 32:14"/>ሄዋ ድራዉ፥ መና ጎዳይ ባረ አሳ ቦላ ኢታባ አሀናዉ ኦዴዳዋ አጊደ፥ ኡንቱንታ ማሬዳ።<verse eid="EXO 32:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 32:15"/>ሄዋፐ ጉይያን ሙሴ ታሙ አዛዛቱ ኡንቱንቱን ጻፈት ኡቴዳ ላኡ ማርካተ ሹቻቱዋ ባረ ኩሽያን ኦይቂደ፥ ደርያፐ ዱገ ዎዳ። ሄ ሹቻቱ ላኡ ባጋናካ ጻፈቴድኖ። <verse eid="EXO 32:15"/><verse number="16" style="v" sid="EXO 32:16"/>ሄ ማሰቴዳ ሹቻቱዋ ጊግሴዳዌ ጾሳ፤ ሹቻ ቦላ ዎጪደ ጻፌዳዌካ ጾሳ።<verse eid="EXO 32:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 32:17"/>ኢያሱ አሳ ጫቡዋ ስሴዳ ዎደ፥ ሙሳ ሀዋዳን ያጌዳ፤ “ዱንካኔዳ ሳኣን ኦላ ዋሱ ስሰቴ” ያጌዳ።<verse eid="EXO 32:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 32:18"/>ሙሴ ዛሪደ፥ “ታን ስስያዌ ሀዌ የፐ አትና፥ ጾኔዳዋንቱ ኮሻ ዎይ ጾነቴዳዋንቱ ኮሻ ግደና” ያጌዳ።<verse eid="EXO 32:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 32:19"/>ሙሴ ዱንካኔዳ ሳኣ ማቴዳ ዎደ፥ ማራነ ዱሩዋ በኢደ ሎይ ሀንቀቲደ ባረ ኩሽያን ኦይቆ ማርካተ ሹቻቱዋ ደርያ ጻጱዋን ኦሊደ መንሬዳ። <verse eid="EXO 32:19"/><verse number="20" style="v" sid="EXO 32:20"/>ኡንቱንቱ መዳ ማራካ አኪደ፥ ታማን ጹጌዳ፤ ሄዋፐ ጉይያን ሊቃና ጋካናዉ ጋጪደ ሃ ቦላ ላሊደ፥ እስራኤልያ አሳይ ኡሻናዳን ኦዳ።<verse eid="EXO 32:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 32:21"/>ሄዋፐ ጉይያን፥ ሙሴ አሮና፥ “ሀ አሳይ ኔና ዋትኔ ኔን ኡንቱንታ ሀዋ ማላ ዎልቃማ ናጋራዉ ካለዳዌ?” ያጌዳ።<verse eid="EXO 32:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 32:22"/>አሮንካ ዛሪደ፥ “ታ ጎዳዉ፥ ሀንቀቶፓ፤ ሀ አሳይ ኢታ ኦናዉ አይ ኬሻ ኮይንቶ ኔን ኤራሳ። <verse eid="EXO 32:22"/><verse number="23" style="v" sid="EXO 32:23"/>ኡንቱንቱ ታና፥ ‘ኑና ካለያ ጾሳቱዋ ኑዉ መ። አያዉ ጎፐ፥ ሀ ኑና ግብጼፐ አሄዳ ሙሴ እ ዋኔደንቶነ ኑን ኤሮኮ!’ ያጌድኖ። <verse eid="EXO 32:23"/><verse number="24" style="v" sid="EXO 32:24"/>ታን ኡንቱንታ፥ ‘ህንተ ቦላ ደእያ ዎርቃ ከሲደ፥ ሀምተ’ ያጋድ። ሄዋፐ ጉይያን ኡንቱንቱ ታዉ እሜዳ ዎርቃ ታን ታማን የግና፥ ሀ ማራይ ከሴዳ” ያጌዳ።<verse eid="EXO 32:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 32:25"/>አሮነ አሳ ገደ ጮ የድ አግና፥ አሳይ ባረ ሞርከቱዋ ስንን ካዉሺደ ካቴዳዋ ሙሴ በኤዳ። <verse eid="EXO 32:25"/><verse number="26" style="v" sid="EXO 32:26"/>ሄዋ ድራዉ፥ ሙሴ ዱንካኔዳ ሳኣ ገልያ ፐንግያን ኤቂደ ሀዋዳን ያጌዳ፤ “መና ጎዳ ባጋ ግዴዳ አሳይ ኦንነ ታኮ ዮ!” ያጌዳ። ሌዋቱ ኡባይ አኮ ሺቄድኖ።<verse eid="EXO 32:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 32:27"/>ሄዋፐ ጉይያን እ ኡንቱንታ፥ “መና ጎዳይ እስራኤልያ ጾሳይ ሀዋዳን ያጌ፤ ‘አሳይ ኡባይ ማሻ ባረ ጼሳን ጼሳን ዳንጮ፤ ዱንካኔዳ ሳኣን ጋጻፐ ጋጻ ጋካናዉ፥ ጉየዉነ ስንዉነ ስመረቶ፤ እቱ እቱ ባረ እሻ፥ ባረ ላግያነ ባረ ሾሩዋ ዎ ያጌ’ ” ያጌዳ። <verse eid="EXO 32:27"/><verse number="28" style="v" sid="EXO 32:28"/>ሌዋቱ ሙሴ አዛዜዳዋዳን ኦድኖ፤ ሄ ጋላስ አሳፐ ሄዙ ሻኣ ኬሻይ ሀይቄዳ። <verse eid="EXO 32:28"/><verse number="29" style="v" sid="EXO 32:29"/>ሄዋፐ ጉይያን ሙሴ ሌዋቱዋ፥ “ሀቼ ህንተንቱ ጾሳዉ ዱማቴድታ፤ አያዉ ጎፐ፥ ህንተንቱ ህንተንቱ ናናነ ህንተንቱ እሻቱዋ ዎናዉካ አዛዘቴድታ፤ ሀቼ መና ጎዳይ ህንተንታ አንጃና” ያጌዳ።<verse eid="EXO 32:29"/></para>
  <para style="s1">ሙሴ እስራኤልያ አሳዉ ዎሴዳ</para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 32:30"/>ዎንትሳ ጋላስ ሙሴ አሳ፥ “ህንተንቱ ዎልቃማ ናጋራ ኦድታ፤ ሽን ሀእ ታን መና ጎዳኮ ፑደ ደርያ ከሳና፤ ህንተንቱ ናጋራ ታን አቶ ጊሳንታንቶነ” ያጌዳ። <verse eid="EXO 32:30"/><verse number="31" style="v" sid="EXO 32:31"/>ያትና ሙሴ መና ጎዳኮ ስም ቢደ ሀዋዳን ያጌዳ፤ “ሀ አሳይ ዎልቃማ ናጋራ ኦዳ፤ ኡንቱንቱ ባረንቶ ዎርቃፐ ጾሳቱዋ መድኖ። <verse eid="EXO 32:31"/><verse number="32" style="v" sid="EXO 32:32"/>ሽን ሀያና፥ ሀእ ኡንቱንቱ ናጋራ አቶ ያጋ፤ ሄዌ ዮፐ፥ ኔን ጻፌዳ ማዝጎብያፐ ታና ቁጫ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">32:32 </char><char style="xt" closed="false"><ref loc="PSA 69:28">ማዝ. 69:28</ref>፤ <ref loc="REV 3:5">ሳፃ 3:5</ref></char></note><verse eid="EXO 32:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 32:33"/>መና ጎዳይ ዛሪደ ሙሳ፥ “ታን ታ ማዝጋባፐ ቁጫናዌ ታ ቦላ ናጋራ ኦዳ አሳቱዋ ሱን። <verse eid="EXO 32:33"/><verse number="34" style="v" sid="EXO 32:34"/>ሀእ ባደ፥ ሀ አሳ ታን ነዉ ኦዴዳ ሳኣ ካለ፤ ታ ኪታንቻይካ ኔና ካለና፤ ሽን ታን ሙራናዉ ዎዲ ጋክና፥ ኡንቱንታ ኡንቱንቱ ናጋራ ድራዉ ሙራና” ያጌዳ።<verse eid="EXO 32:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 32:35"/>አሮነ ዎርቃፐ ማራ ምስልያ መናዳን አሳይ ኦዳ ድራዉ፥ መና ጎዳይ አሳ ቦላ ዎልቃማ ቦሻ የዴዳ።<verse eid="EXO 32:35"/></para>
  <chapter eid="EXO 32"/>
  <chapter number="33" style="c" sid="EXO 33"/>
  <para style="p">
    <verse number="1" style="v" sid="EXO 33:1"/>ሄዋፐ ጉይያን መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ “ኔንነ ኔን ግብጼፐ ከሴዳ አሳይ ሀ ሳኣፐ ደንድተ፤ ‘ታን ህንተንቱ ያራቶ እማና’ ያጋደ ዎዳ ጋድያ ቢተ። ሄ ጋዲ ታን አብራሃመዉ፥ ይሳቃዉነ ያቆባዉ እማና ያጋደ ጫቃ ዎዳ ጋድያ።<note caller="-" style="x"><char style="xo" closed="false">33:1 </char><char style="xt" closed="false"><ref loc="GEN 12:7">ዶመ 12:7</ref>፤ <ref loc="GEN 26:3">26:3</ref>፤ <ref loc="GEN 28:13">28:13</ref></char></note> <verse eid="EXO 33:1"/><verse number="2" style="v" sid="EXO 33:2"/>ታን ህንተንቱ ስንን ኪታንቻ ኪታደ፥ ካናነቱዋ፥ አሞረቱዋ፥ ሂተቱዋ፥ ፓርዘቱዋ፥ ሂዌቱዋነ ያቡሳቱዋ የደርሳና። <verse eid="EXO 33:2"/><verse number="3" style="v" sid="EXO 33:3"/>ማይነ ኤሳይ ጎግያ ሄ ጋድያ ቢተ። ሽን ህንተንቱ ሞርጊ ሌፋቶ አሳ ግዴዳ ድራዉ፥ ታን ህንተንታ ኦግያን ይሳናዉ፥ ህንተናና ቢከ” ያጌዳ።<verse eid="EXO 33:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 33:4"/>አሳይ ሄ ያሽያ ኦዱዋ ስሲደ ሎይ ዬኬዳ። ሄ ዎድያፐ ዶሚደ ኡባይካ ባረ አሌቁዋ አያዋ አግ ባሼዳ። <verse eid="EXO 33:4"/><verse number="5" style="v" sid="EXO 33:5"/>አያዉ ጎፐ፥ መና ጎዳይ ሙሳ ሀዋዳን ያግ ዎዳ፤ “እስራኤልያ ሀዋዳን ያጋ፤ ‘ህንተ ሞርጊ ሌፋቶ አሳ። ታን ህንተናና ሀራይ አቶ ጉ ዎድያ ብንቶካ፥ ታን ህንተንታ ይሳና። ሀእ ስም ህንተንቱ አሌቁዋ ከስ ድግተ፤ ያቶፐ ታን ህንተንታ ኦናባ ቃቻና’ ያጋ” ያጌዳ። <verse eid="EXO 33:5"/><verse number="6" style="v" sid="EXO 33:6"/>እስራኤላቱ ሲና ደርያፐ ዶሚደ ባረንቱ አሌቆቱዋ ከስ ዎድኖ።<verse eid="EXO 33:6"/></para>
  <para style="s1">ጋከትያ ዱንካንያ</para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 33:7"/>ሙሴ ዱንካንያ አክ አፊደ፥ አሳይ ዱንካኖ ሳኣፐ ካረና ሃሲደ ጌዳ። ሄ ዱንካኒ፥ “ጋከትያ ዱንካንያ” ጌተቲደ ጼሰቴዳ። መና ጎዳ ኦቻናዉ ኮይያ ኡባይ ዱንካኖ ሳኣፐ ካረና ደእያ ጋከትያ ዱንካንያ ቤ። <verse eid="EXO 33:7"/><verse number="8" style="v" sid="EXO 33:8"/>ሙሴ ሄ ዱንካንያ ቤዳ ዎደ፥ አዉደነ አሳይ ኡባይ ደንዲደ፥ ባረ ዱንካንያ ፐንግያን ፐንግያን ኤቄ፤ ሙሴ ሄ ዱንካንያ ገላና ጋካናዉ አ ጼሌ። <verse eid="EXO 33:8"/><verse number="9" style="v" sid="EXO 33:9"/>ሙሴ ጋከትያ ዱንካንያ ግዶ ገሌዳ ዎደ፥ ሻርያ ቱሳይ ዱገ ዎ፤ መና ጎዳይ ሙሴና ሻርያፐ ሃሳይሽን፥ ሄ ዱንካንያ ፐንግያን ጋምኤ። <verse eid="EXO 33:9"/><verse number="10" style="v" sid="EXO 33:10"/>ሻርያ ቱሳ ሄ ዱንካንያ ገልያ ፐንግያን በኤዳ ዎደ ኡባን፥ አሳይ ኡባይ ባረ ዱንካንያ ፐንግያን ፐንግያን ጾሳዉ ጎይኔ። <verse eid="EXO 33:10"/><verse number="11" style="v" sid="EXO 33:11"/>አሳይ ባረ ላግያና ሃሳይያዋዳን መና ጎዳይ ሙሴና ስንን ኤቂደ፥ ሃሳዬ። ሄዋፐ ጉይያን ሙሴ አሳይ ዱንካኔዳ ሳኣ ጉየ ስሜ፤ ሽን አ ማድያ ያላጋይ፥ ነዊ ናኣ ኢያሱ፥ ጋከትያ ዱንካንያፐ ሻከተና።<verse eid="EXO 33:11"/></para>
  <para style="s1">ሙሳነ መና ጎዳ ቦንቹዋ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 33:12"/>ሙሴ መና ጎዳ ሀዋዳን ያጌዳ፤ “ኔን ታና፥ ‘ሀ አሳ ካለ’ ያጋዳ፤ ሽን ታናና ኔን ኦና ኪታንንቶ፥ ታና ኤርሳበይካ። ኔን፥ ‘ታን ኔና ሱንን ኤራይ፤ ቃይካ ኔን ታናን ናሸታዳ’ ያጋዳ። <verse eid="EXO 33:12"/><verse number="13" style="v" sid="EXO 33:13"/>ኔን ታና ናሼዳዋ ግዶፐ፥ ታን ኔና ኤራና ማላነ ስንዉካ ኔና ናሸቻደ ደአና ማላ፥ ነ ኦግያ ታና በሳ። ሀ አሳይ ነ አሳ ግድያዋ ሀሳያ” ያጌዳ።<verse eid="EXO 33:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 33:14"/>መና ጎዳይ ዛሪደ፥ “ታን ኔናና ባና፤ ታን ኔና ሸምፕሳና” ያጌዳ።<verse eid="EXO 33:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 33:15"/>ያትና ሙሴ አ፥ “ኔን ኑናና ቤናዋ ግዶፐ፥ ሀዋፐ ኑና የዶፓ። <verse eid="EXO 33:15"/><verse number="16" style="v" sid="EXO 33:16"/>ኔን ኑናና ቤናን ዮፐ፥ ታናንነ ነ አሳን ኔን ናሸቴዳዋ አሳይ ኡባይ ዎት ኤራናዌ? ቢታ ኡባን ደእያ ሀራ አሳ ኡባፐ ታናነ ነ አሳ ዱማይያዌ ሀራባይ አዬ?” ያጌዳ።<verse eid="EXO 33:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 33:17"/>መና ጎዳይ ሙሳ፥ “ታን ኔናን ናሸቴዳ ድራዉነ ኔና ነ ሱንን ኤርያ ድራዉ፥ ኔን ታና ኦቼዳ ሀ የዉዋ ታን ኦና” ያጌዳ።<verse eid="EXO 33:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 33:18"/>ያትና ሙሴ፥ “ነ ቦንቹዋ ታና በሳርኪ?” ያጌዳ።<verse eid="EXO 33:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 33:19"/>መና ጎዳይ፥ “ታን ታ ሎኦተ ኡባ ነ ስንና አና፤ ታ ጌሻ ሱንካ ነ ስንን አዋያና። ታን መና ጎዳ፤ ታን ሎአናዉ ኮይያዋንቶ ሎአና፤ ቃይ ቃረታናዉ ኮይያዋንቶካ ቃረታና።<note caller="-" style="x"><char style="xo" closed="false">33:19 </char><char style="xt" closed="false"><ref loc="ROM 9:15">ሮመ 9:15</ref></char></note> <verse eid="EXO 33:19"/><verse number="20" style="v" sid="EXO 33:20"/>ሽን ኔን ታ ዴሙዋ በአካ፤ አያዉ ጎፐ፥ ኦንነ ታና በኢደ ሸምፑዋና ደኤና” ያጌዳ።<verse eid="EXO 33:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 33:21"/>ሄዋፐ ጉይያን መና ጎዳይ፥ “ኔን ዛላ ቦላ ኤቃናዉ ሀዋን ታ ማታን ሳአይ ደኤ። <verse eid="EXO 33:21"/><verse number="22" style="v" sid="EXO 33:22"/>ታ ቦንቹ አያ ዎደ፥ ታን ኔና ጳልቀቴዳ ዛላ ግዶን ዎና፤ ታን አና ጋካናዉ፥ ታ ኩሽያን ኔና ካማና። <verse eid="EXO 33:22"/><verse number="23" style="v" sid="EXO 33:23"/>ሄዋፐ ጉይያን ታን ታ ኩሽያ ድግና፥ ኔን ታ ዞኪያ በአናሳ፤ ሽን ታ ሶምእ በኤተና” ያጌዳ።<verse eid="EXO 33:23"/></para>
  <chapter eid="EXO 33"/>
  <chapter number="34" style="c" sid="EXO 34"/>
  <para style="s1">ላኤንዋ መቴዳ ማሰቴዳ ሹቻቱዋ</para>
  <para style="r">(<ref loc="DEU 10:1-5">ዛረ. 10:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 34:1"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ “ኮይሮዋንታ ማላትያ ላኡ ሹቻቱዋ ማሳደ ጊግሳ፤ ያቶፐ ታን ሄ ማሰቴዳ ሹቻቱዋ ቦላ ካሰ ኔን መንዳ ሹቻቱዋ ቦላን ደእያ ቃላቱዋ ጻፋና። <verse eid="EXO 34:1"/><verse number="2" style="v" sid="EXO 34:2"/>ዎንታ ዎንታ ፑደ ሲና ደርያ ከሳናዉ ጊጋ፤ ያታደ ታና ያን ደርያ ሁጲያን ኤቃ ናጋ። <verse eid="EXO 34:2"/><verse number="3" style="v" sid="EXO 34:3"/>ኔናና ኦንነ ከሶፖ፤ ዎይ ደርያ ቦላ ሀቃንካ ቤቶፖ፤ ሀራይ አቶ ዶርሳ ዉዲ ዎይ መህያ ዉዲካ ደርያ ስንን ሄመቶፖ” ያጌዳ።<verse eid="EXO 34:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 34:4"/>ሄዋ ድራዉ፥ ሙሴ ኮይሮ ሹቻቱዋ ማላትያ ላኡ ሹቻቱዋ ማሲደ መና ጎዳይ አዛዜዳዋዳን፥ ሹቻቱዋ ባረ ኩሽያን ኦይቂደ፥ ዎንታ ጉራና ፑደ ሲና ደርያ ከሴዳ። <verse eid="EXO 34:4"/><verse number="5" style="v" sid="EXO 34:5"/>መና ጎዳይ ሻርያን ዱገ ዎደ፥ አናና ያን ኤቄዳ፤ “ታን መና ጎዳ” ያጊደ ባረ ሱን አዋዬዳ። <verse eid="EXO 34:5"/><verse number="6" style="v" sid="EXO 34:6"/>መና ጎዳይ ሙሴ ስንና ሀዋዳን ያጊደ አዋዪደ አዳ፤ “ታን መና ጎዳ፤ ታን መና ጎዳ፤ ቃረታይነ ማሮተይ ኩሜዳ ጾሳ፥ ዳንዳያንቻ፥ አገና ሲቁ ዳሬዳዋነ ዳሪ አማነትያዋ።<note caller="-" style="x"><char style="xo" closed="false">34:6 </char><char style="xt" closed="false"><ref loc="EXO 20:5-6">ከሳ 20:5-6</ref>፤ <ref loc="NUM 14:18">ፓይ. 14:18</ref>፤ <ref loc="DEU 5:9-10">ዛረ. 5:9-10</ref>፤ <ref loc="DEU 7:9-10">7:9-10</ref></char></note> <verse eid="EXO 34:6"/><verse number="7" style="v" sid="EXO 34:7"/>ታን ታ አገና ሲቁዋ ሻአቶ ናግያዋ፤ ኢታተ፥ ማካላነ ናጋራ አቶ ያግያዋ። ግዶፐካ፥ ባይዞዋ ሙረናን አገናዋ፤ አዎቱዋ ናጋራ ድራዉ ናናነ ናናቱዋ ናና፥ ሄዘን የለታነ ኦይደን የለታ ጋካናዉ ሙርያዋ” ያጊደ አዋዬዳ።<verse eid="EXO 34:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 34:8"/>ሄዋፐ ጉየ ሙሴ ኤለካ ቢታን ጉፋኒደ ጎይኔዳ፤ <verse eid="EXO 34:8"/><verse number="9" style="v" sid="EXO 34:9"/>“አቤት ጎዳዉ፥ ኔን ታናን ናሸቴዳዋ ግዶፐ፥ ኑናና እትፐ ደንዳ። ሀዌ አሳይ ሞርጊ ሌፋቴዳዋ ግዶፐነ፥ ኑ ኢታተነ ኑ ናጋራ አቶ ያጋደ፥ ኑና ነ አሳ ኦ” ያጌዳ።<verse eid="EXO 34:9"/></para>
  <para style="s1">ቃላ ጫቁ ኦራጼዳ</para>
  <para style="r">(<ref loc="EXO 23:14-19">ከሳ 23:14-19</ref>፤ <ref loc="DEU 7:1-5">ዛረ. 7:1-5</ref>፤ <ref loc="DEU 16:1-17">16:1-17</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 34:10"/>ያትና መና ጎዳይ ሀዋዳን ያጌዳ፤ “ታን ህንተናና ቃላ ጫቁዋ ገላድ፤ ሀዋፐ ካሰ ሳኣ ኡባን ደእያ ካዉተ ኡባን ሀን ኤረና ማላልስያባ ነ አሳ ኡባ ስንን ኦና፤ ታን መና ጎዳይ፥ ህንተንቶ ኦያ ኪታይ አይ ኬሻ ማላልስያበንቶ ኔን ኡንቱንቱ ግዶን ደእያ አሳይ ኡባይ በአና። <verse eid="EXO 34:10"/><verse number="11" style="v" sid="EXO 34:11"/>ሀቼ ታን ህንተንታ አዛዝያ አዛዙዋ ናግተ፤ ህንተንቱ ስንፐ አሞረቱዋ፥ ካናነቱዋ፥ ሂተቱዋ፥ ፓርዘቱዋ፥ ሂዌቱዋነ ያቡሳቱዋ ታን የደርሳና። <verse eid="EXO 34:11"/><verse number="12" style="v" sid="EXO 34:12"/>ኡንቱንቱ ህንተንቶ ጲረ ግደና ማላ፥ ህንተንቱ ብያ ጋድያን ደእያ አሳና ቃላ ጫቁዋ ገሎፕተ። <verse eid="EXO 34:12"/><verse number="13" style="v" sid="EXO 34:13"/>ኡንቱንቱ ያርሽያ ሳኣ ኮልተ፤ ኡንቱንቱ ጎይንያ ሹቻቱዋካ መንሬተ፤ ቃይ አሼሮ ጌተትያ ኡንቱንቱ ማጫ ጾሳት ካሻ ቃንጸሬ ኦልተ።<note caller="-" style="x"><char style="xo" closed="false">34:13 </char><char style="xt" closed="false"><ref loc="DEU 16:21">ዛረ. 16:21</ref></char></note> <verse eid="EXO 34:13"/><verse number="14" style="v" sid="EXO 34:14"/>ታን መና ጎዳይ ቃናትያ ጾሳ ግድያ ድራዉ፥ ታፐ ሀራ ጾሳቶ ጎይኖፕተ።<verse eid="EXO 34:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 34:15"/>“ሄ ጋድያን ደእያ አሳቱዋና አያ ቃላ ጫቁዋካ ገሎፕተ፤ አያዉ ጎፐ፥ ኡንቱንቱ ታናን አማነተናን እጺደ ባረንቱ ጾሳቱዋ ካልያ ዎደነ ኡንቱንቶ ያርሽያ ዎደ፥ ኡንቱንቱ ህንተናካ ሾባና፤ ህንተንቱ ኡንቱንቱ ያርሾቱዋ ማና። <verse eid="EXO 34:15"/><verse number="16" style="v" sid="EXO 34:16"/>ቃይ ህንተንቱ ኡንቱንቱ ማጫ ናናቱዋፐ ዶሪደ፥ ህንተንቱ አቱማ ናናቶ እማና፤ ሄ ዎደ ሄ ማጫ ናናይ ታናን አማነተናን እጺደ፥ ባረንቱ ጾሳቱዋ ካሊደ፥ ህንተንቱ አቱማ ናናካ ባረንቱዋዳን ኦስሳናዋንታ።<verse eid="EXO 34:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 34:17"/>“ህንተንቶ ጎይንያ ጾሳቱዋ አያፐካ ሲልሲደ መፕተ።<note caller="-" style="x"><char style="xo" closed="false">34:17 </char><char style="xt" closed="false"><ref loc="EXO 20:4">ከሳ 20:4</ref>፤ <ref loc="LEV 19:4">ዎጋ 19:4</ref>፤ <ref loc="DEU 5:8">ዛረ. 5:8</ref>፤ <ref loc="DEU 27:15">27:15</ref></char></note><verse eid="EXO 34:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 34:18"/>“ማጋገ ኡክ ባላ ቦንችተ፤ ታን ህንተንታ አዛዜዳዋዳን፥ ላፑን ጋላሳዉ እርሹ ገለናን ኡከቴዳ ኡክ ሚተ፤ ሄዋካ ህንተንቱ ግብጼፐ ከሴዳ አቢባ አግናን ኦተ።<note caller="-" style="x"><char style="xo" closed="false">34:18 </char><char style="xt" closed="false"><ref loc="EXO 12:14-20">ከሳ 12:14-20</ref>፤ <ref loc="LEV 23:6-8">ዎጋ 23:6-8</ref>፤ <ref loc="NUM 28:16-25">ፓይ. 28:16-25</ref></char></note><verse eid="EXO 34:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 34:19"/>“አት ኡሉዋፐ ባይራ የለትያ አቱማ ናኣ ኡባይ ታዋ፤ ህንተንቱ መህያ ኡባፐ ቦራ ግድና፥ ዎይ ዶርሳ ግድና፥ ባይራይ ታዋ፤<note caller="-" style="x"><char style="xo" closed="false">34:19 </char><char style="xt" closed="false"><ref loc="EXO 13:2">ከሳ 13:2</ref></char></note> <verse eid="EXO 34:19"/><verse number="20" style="v" sid="EXO 34:20"/>ኮይሮ የለቴዳ ሀርያ ማራ ዶርሳ ማራና ላማደ ዎዛ፤ ዎዛና ዮፐ፥ አ ቆያ መንደ ዎ። ነ ናናቱዋፐ ባይራ የለቴዳ አቱማ ናኣ ኡባ ዎዛ።<note caller="-" style="x"><char style="xo" closed="false">34:20 </char><char style="xt" closed="false"><ref loc="EXO 13:13">ከሳ 13:13</ref></char></note></para>
  <para style="p" vid="EXO 34:20">“ኦንነ እምያዋ ኦይቀናን፥ መላ ኩሽያና ታ ስንን ቤቶፖ።<verse eid="EXO 34:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 34:21"/>“ኡሱፑን ጋላሳ ኦተ፤ ሽን ላፑን ጋላሳን ሸምፕተ፤ ጎሽያ ዎድያን ቃይ ካ ጫክያ ዎድያን ላፑን ጋላሳን ሸምፕተ።<note caller="-" style="x"><char style="xo" closed="false">34:21 </char><char style="xt" closed="false"><ref loc="EXO 20:9-10">ከሳ 20:9-10</ref>፤ <ref loc="EXO 23:12">23:12</ref>፤ <ref loc="EXO 31:15">31:15</ref>፤ <ref loc="EXO 35:2">35:2</ref>፤ <ref loc="LEV 23:3">ዎጋ 23:3</ref>፤ <ref loc="DEU 5:13-14">ዛረ. 5:13-14</ref></char></note><verse eid="EXO 34:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 34:22"/>“ባይራ ዘረቴዳ ዛርጋ ህንተንቱ ጫክያ ዎደ፥ ሳምንታቱዋ ባላ ቦንችተ፤ ላይ ዉርሰ ካ ሺሽያ ዎደካ፥ ሺሹዋ ባላ ቦንችተ።<note caller="-" style="x"><char style="xo" closed="false">34:22 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">ዎጋ 23:15-21</ref>፤ <ref loc="NUM 28:26-31">ፓይ. 28:26-31</ref></char></note> <verse eid="EXO 34:22"/><verse number="23" style="v" sid="EXO 34:23"/>ላይን ሄዙ ገደ እስራኤልያ አቱማ አሳይ ኡባይ ኡባ ሞድያ ጾሳ፥ እስራኤልያ መና ጎዳ ስንን ቤትኖ። <verse eid="EXO 34:23"/><verse number="24" style="v" sid="EXO 34:24"/>ካዉተቱዋ ታን ህንተንቱ ስንፐ የደርሳደ ከሳና፤ ያታደ ህንተንቱ ዛዋ ታን አሳና። መና ጎዳ ህንተንቱ ጾሳ ስንን ህንተንቱ ላይን ሄዙ ገደ ቤታናዉ ፑደ ከስያ ዎደ፥ ኦንነ ህንተንቱ ጋድያ አሞተና።<verse eid="EXO 34:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 34:25"/>“ህንተንቱ ታዉ ሱ ያርሹዋ ያርሽያ ዎደ፥ እርሹዋ የጊደ ኡኬዳ ኡክና ያርሾፕተ። ፓስጋ ቦንችያ ጋላሳዉ ያርሼዳ ያርሹዋፐ ዎንትዉ አያይነ አቶፖ።<note caller="-" style="x"><char style="xo" closed="false">34:25 </char><char style="xt" closed="false"><ref loc="EXO 12:10">ከሳ 12:10</ref></char></note><verse eid="EXO 34:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 34:26"/>“ህንተንቱ ጋደን ባይራ ካኤዳ ካፐ ኮይሮ ሙሩታ መና ጎዳ ህንተንቱ ጾሳ ጎልያ አህተ።<note caller="-" style="x"><char style="xo" closed="false">34:26 </char><char style="xt" closed="false"><ref loc="DEU 24:21">ዛረ. 24:21</ref>፤ <ref loc="DEU 26:2">26:2</ref></char></note></para>
  <para style="p" vid="EXO 34:26">“ዴሻ ማራ አ አት ማን ዶይሶፕተ” ያጌዳ።<verse eid="EXO 34:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 34:27"/>መና ጎዳይ ሙሳ፥ “ታን ኔናናነ እስራኤልያ አሳና ቃላ ጫቁዋ ገልያዌ ሀ ቃላቱ ግያ ማራና ግድያ ድራዉ፥ ሀ ቃላቱዋ ጻፋ” ያጌዳ። <verse eid="EXO 34:27"/><verse number="28" style="v" sid="EXO 34:28"/>ሙሴ ቁማ ሜናንነ ሃ ኡሸናን፥ ኦይታሙ ጋላሳነ ኦይታሙ ቃማ መና ጎዳና ያን ጋምኤዳ፤ ቃላ ጫቁዋ ቃላቱዋ፥ ታሙ አዛዙዋ ማሰቴዳ ሹቻን ጻፌዳ።<verse eid="EXO 34:28"/></para>
  <para style="s1">ሙሴ ሶምእ ፖኤዳ</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 34:29"/>ሙሴ ጾሳና ሃሳዪደ ጋምኤዳ ድራዉ፥ ሄ ላኡ ማርካተ ሹቻቱዋ እ ባረ ኩሽያን ኦይቂደ ሲና ደርያፐ ዱገ ዎዳ ዎደ፥ አ ሶምኢ ፖኤዳ፤ ሽን እ ሄዋ ኤርቤና።<note caller="-" style="x"><char style="xo" closed="false">34:29-35 </char><char style="xt" closed="false"><ref loc="2CO 3:7-16">2 ቆሮ. 3:7-16</ref></char></note> <verse eid="EXO 34:29"/><verse number="30" style="v" sid="EXO 34:30"/>አሮነነ እስራኤልያ አሳይ ኡባይ ሙሳ ጼሊደ፥ አ ሶምኢ ጶልያዋ በኤድኖ፤ ኡንቱንቱ አኮ ሺቃናዉ ያዬድኖ። <verse eid="EXO 34:30"/><verse number="31" style="v" sid="EXO 34:31"/>ሽን ሙሴ ኡንቱንታ ጼስና አሮነነ ሽቁዋ ካለያ ካፓቱ ኡባይ አኮ ስሜድኖ፤ እ ኡንቱንታ ሃሳይሴዳ። <verse eid="EXO 34:31"/><verse number="32" style="v" sid="EXO 34:32"/>ሄዋፐ ጉይያን እስራኤልያ አሳይ ኡባይ አኮ ሺቅና መና ጎዳይ አዉ ሲና ደርያን እሜዳ አዛዙዋ ኡባ እ ኡንቱንቶ እሜዳ።<verse eid="EXO 34:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 34:33"/>ሙሴ ኡንቱንቶ ኦድያዋ ዉርሴዳ ዎደ፥ ባረ ዴሙዋ ናጻላን ካሜዳ። <verse eid="EXO 34:33"/><verse number="34" style="v" sid="EXO 34:34"/>ሽን ሙሴ መና ጎዳ ስን አናና ሃሳያናዉ ገልያ ዎደ አዉደነ ከሳና ጋካናዉ፥ ናጻላ ባረ ሶምኡዋፐ ቃር ድጌ። ሄዋፐ ከሲደ፥ መና ጎዳይ አዛዜዳዋ እስራኤልያ አሳዉ ኦዴ። <verse eid="EXO 34:34"/><verse number="35" style="v" sid="EXO 34:35"/>ኦድያ ዎደ፥ ኡንቱንቱ አ ሶምኢ ጶልያዋ በኤድኖ። ሄዋ ድራዉ፥ ሙሴ መና ጎዳና ሃሳያናዉ ባና ጋካናዉ፥ ባረ ዴሙዋ ዛረደካ ናጻላን ካሜ።<verse eid="EXO 34:35"/></para>
  <chapter eid="EXO 34"/>
  <chapter number="35" style="c" sid="EXO 35"/>
  <para style="s1">ሳምባታ ቦንችያ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 35:1"/>ሙሴ እስራኤልያ አሳ ሽቁዋ ኡባ ሺሺደ ሀዋዳን ያጌዳ፤ “ህንተንቱ ኦና ማላ፥ መና ጎዳይ አዛዜዳዌ ሀዋ: <verse eid="EXO 35:1"/><verse number="2" style="v" sid="EXO 35:2"/>ሳምንታ ግዶን ኡሱፑን ጋላሳ ኪታ ኪተትተ፤ ሽን ላፑን ጋላሳይ ህንተንቶ ጌሻ ጋላሳ፤ መና ጎዳዉካ ሸምፖ ሳምባታ። ሄ ጋላሳን አይ ኦሶነ ኦያ ኡራይ ኦንነ ሀይቃናዉ በሴ።<note caller="-" style="x"><char style="xo" closed="false">35:2 </char><char style="xt" closed="false"><ref loc="EXO 20:8-11">ከሳ 20:8-11</ref>፤ <ref loc="EXO 23:12">23:12</ref>፤ <ref loc="EXO 31:15">31:15</ref>፤ <ref loc="EXO 34:21">34:21</ref>፤ <ref loc="LEV 23:3">ዎጋ 23:3</ref>፤ <ref loc="DEU 5:12-14">ዛረ. 5:12-14</ref></char></note> <verse eid="EXO 35:2"/><verse number="3" style="v" sid="EXO 35:3"/>ሳምባታ ጋላሳን ህንተንቱ ሶን ሶን ታማ ኤፕተ” ያጌዳ።<verse eid="EXO 35:3"/></para>
  <para style="s1">ጾሳ ዱንካንያ ኦሶ ሺሽያ ሚሻ</para>
  <para style="r">(<ref loc="EXO 25:1-9">25:1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 35:4"/>ሙሴ እስራኤልያ ማባራዉ ሙልያዉ ሀዋዳን ያጌዳ፤ “መና ጎዳይ ሀዋዳን ያጊደ አዛዜዳ: <verse eid="EXO 35:4"/><verse number="5" style="v" sid="EXO 35:5"/>ህንተንቶ ደእያዋፐ መና ጎዳዉ እምያዋ አህተ፤ መና ጎዳዉ እምያዋ አሀናዉ ኮይያ ኦንነ ዎርቃ፥ ብራ፥ ናሃስያ፥ <verse eid="EXO 35:5"/><verse number="6" style="v" sid="EXO 35:6"/>ሳሉዋ ማላትያ ቃጭና፥ ኦቻ ቴራ ማላትያ ቃጭና፥ ሾሎላ ዞኦ ቃጭናነ ሊቆ ሱፍያ፥ ዴሻ ጋልባ፥ <verse eid="EXO 35:6"/><verse number="7" style="v" sid="EXO 35:7"/>ዶርሳ ኮልያ ጋልባ ዞኦ ቃላምያን የግ ከሴዳዋ፥ ቁምእያ፥ ኦዶሩዋ፥ <verse eid="EXO 35:7"/><verse number="8" style="v" sid="EXO 35:8"/>ጾምፕያዉ ዎጋራ ዛይትያ፥ ኦከትያ ዛይትያነ እጻና ሳዌያ ቅማምያ፤ <verse eid="EXO 35:8"/><verse number="9" style="v" sid="EXO 35:9"/>ኤፉድያንነ ትራን ዎያዋን የግያ ማርግድያ ጌተትያ ሹቻቱዋነ ሀራ ጶልያ አልኦ ሹቻቱዋ አሆ።<verse eid="EXO 35:9"/></para>
  <para style="s1">ጾሳ ዱንካንያ ኦናዉ እመቴዳ አዛዙዋ</para>
  <para style="r">(<ref loc="EXO 39:32-43">39:32-43</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 35:10"/>“ህንተንቱ ግዶን ደእያ ኩሽያ ሂላ ኤራንቻ ኡባቱ ዪደ፥ መና ጎዳይ አዛዜዳ ኡባ ኦኖ: <verse eid="EXO 35:10"/><verse number="11" style="v" sid="EXO 35:11"/>መና ጎዳ ዱንካንያ፥ አ ካምያ ዱንካንያነ አ ካምያዋ፥ ኦይቂያዋ፥ ጻጋገቱዋ፥ ሽካላቱዋ፥ ቱሳቱዋነ ኡንቱንቱ ኤቂያ ሉኮቱዋ፥ <verse eid="EXO 35:11"/><verse number="12" style="v" sid="EXO 35:12"/>ታቦታነ አ ቶክያ ካሱዋ፥ አቶ ግያ ሳኣ ቁምእያዋነ ታቦታ ገንያ ጋርዱዋ፤ <verse eid="EXO 35:12"/><verse number="13" style="v" sid="EXO 35:13"/>ጻርጴዛነ አ ቶክያ ካሱዋ፥ አ ሚሻቱዋ ኡባነ ጾሳ ስንን ዎያ ጌሻ ኡክ፤ <verse eid="EXO 35:13"/><verse number="14" style="v" sid="EXO 35:14"/>ጾምፕያ ዎያ ባላነ አን ማራና ደእያ ጾምፐቱዋ፥ ሚሻቱዋ፥ ጾምፕያ ዛይትያ፥ <verse eid="EXO 35:14"/><verse number="15" style="v" sid="EXO 35:15"/>እጻና ጩዋይያ ሳጽንያነ አ ቶክያ ካሱዋ፥ ኦከትያ ዛይትያነ ሳዊያ እጻና፥ ጾሳ ዱንካንያ ፐንግያ ጋርዱዋ፤ <verse eid="EXO 35:15"/><verse number="16" style="v" sid="EXO 35:16"/>ጹግያ ያርሹዋ ያርሽያ ሳኣነ አ ናሃስያ ዛዝርያ፥ አ ቶክያ ካሶቱዋነ አ ሚሻቱዋ ኡባ፥ ናሃስያፐ ኦሰቴዳ ሜቻ ከርያነ አ ዎያዋ፤ <verse eid="EXO 35:16"/><verse number="17" style="v" sid="EXO 35:17"/>ሶይ ዳባባ ጎዳ ጋርዳቱዋ፥ ቱሳቱዋነ ኡንቱንቱ ገደቱዋ፥ ዳባባ ሶ ግዶ ገልያ ፐንግያ ጋርዱዋ፤ <verse eid="EXO 35:17"/><verse number="18" style="v" sid="EXO 35:18"/>ጾሳ ዱንካንያ ግያ ሽካላቱዋ፥ ዳባባ ግዶ ገቱዋ ኡንቱንቱ ዎዶሮቱዋ፤ <verse eid="EXO 35:18"/><verse number="19" style="v" sid="EXO 35:19"/>ጌሻ ሳኣን ኦደ ጎኤታናዉ ዳደቴዳ ማዮቱዋ፥ ቄሲ አሮነ ማይያ ጌሻ ማዩዋ አ ናናይ ቄሰተ ኪታ ኦደ ማይያ ማዩዋ መኖ” ያጌዳ።<verse eid="EXO 35:19"/></para>
  <para style="s1">አሳይ አሄዳ እሞታ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 35:20"/>ሄዋፐ ጉይያን እስራኤልያ ማባራይ ኡባይ ሙሴ ስንፐ ከሴዳ። <verse eid="EXO 35:20"/><verse number="21" style="v" sid="EXO 35:21"/>እማናዉ ኮዬዳዋንቱነ ኡንቱንቱ ዎዛናይ ኡንቱንታ እማ እማ ጌዳዋንቱ ኡባይ ዬድኖ፤ መና ጎዳ ዱንካንያዉ፥ አ ግዶን ኦያ ኦሱዋ ኡባዉነ ጌሻ ማዮ ኮሽያዋ ኡባ አሄድኖ። <verse eid="EXO 35:21"/><verse number="22" style="v" sid="EXO 35:22"/>እማና ኮዬዳ አቱማዋ ኡባይነ ማጫዌ ኡባይ ዪደ፥ ዎርቃፐ መዳ አሌቂያዋንታ፥ ሀይ ጉድቻቱዋ፥ ምግዳቱዋ፥ ሀራ ዎርቃ አሌቂያዋንታ አሂደ መና ጎዳዉ እሞታ ኦደ እሜድኖ። <verse eid="EXO 35:22"/><verse number="23" style="v" sid="EXO 35:23"/>ሳሉዋ ማላትያ ቃጭናይ፥ ኦቻ ቴራ ማላትያ ቃጭናይ፥ ሾሎላ ዞኦ ቃጭናይ፥ ዎይ ሊኑዋ ጌተትያ ሊቆ ቃጭናይ፥ ዎይ ዴሻ አጎዛ፥ ዶርሳ ኦርግያ ጋልባ ዞኦ ቃላምያን የግ ከሴዳዌ፥ ዎይ ማንቻላይ ደእያ አሳይ ኡባይ አሄዳ። <verse eid="EXO 35:23"/><verse number="24" style="v" sid="EXO 35:24"/>ብራ ዎይ ናሃስያ እማናዉ ዳንዳይያ ኡባይ ባረንቱ እሙዋ መና ጎዳዉ እሜድኖ፤ ቃይ ኦዶሩ ደእያ አሳይ ኡባይ ዱማ ዱማ ኦሶ ኦዶሩዋ አሄዳ።<verse eid="EXO 35:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 35:25"/>ኩሽያ ሂላ ኤርያ ማጫ አሳይ ኡባይ ባረንቱ ኩሽያን ሱቄዳ ሳሉዋ ማላትያ ቃጭና፥ ኦቻ ቴራ ማላትያ ቃጭና፥ ሾሎላ ዞኦ ቃጭናነ ሊቆ ሊኑዋ አሄድኖ። <verse eid="EXO 35:25"/><verse number="26" style="v" sid="EXO 35:26"/>ቃይካ እሙዋ እማናዉ ኮዬዳ ማጫ አሳይ ኡባይ ዴሻ አጎዛ ዳዴድኖ። <verse eid="EXO 35:26"/><verse number="27" style="v" sid="EXO 35:27"/>ካፓቱ ኤፉድያንነ ትራን ዎያዋን ዎያ ማርግድያነ ሀራ ቦንቼቴዳ ሹቻቱዋ አሄድኖ። <verse eid="EXO 35:27"/><verse number="28" style="v" sid="EXO 35:28"/>ኡንቱንቱ ቃይካ ጾምፕያዉ፥ ሳዊያ እጻናዉነ ኦካናዉ ሀንያ ዎጋራ ዛይትያነ ቅማምያ አሄድኖ። <verse eid="EXO 35:28"/><verse number="29" style="v" sid="EXO 35:29"/>እስራኤላቱ አሳይ ኡባይ፥ አቱማዌነ ማጫዌ፥ ኡንቱንቱ ኦናዳን መና ጎዳይ ሙሴ ባጋና አዛዜዳ ኦሶ ሀንያ እሙዋ ኡባ ባረንቱ ሸንያን መና ጎዳዉ አሄድኖ።<verse eid="EXO 35:29"/></para>
  <para style="s1">ጾሳ ዱንካንያ ኦያ ኩሽያ ሂላንቻቱዋ</para>
  <para style="r">(<ref loc="EXO 31:1-11">31:1-11</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 35:30"/>ሙሴ እስራኤልያ አሳ ሀዋዳን ያጌዳ፤ “በእተ፤ መና ጎዳይ ይሁዳ ዛርያፐ ሁራ ናኣ ናኣ፥ ኡራ ናኣ፥ ባጻልኤላ ዶሬዳ። <verse eid="EXO 35:30"/><verse number="31" style="v" sid="EXO 35:31"/>መና ጎዳይ አ ጾሳ አያናን፥ ሂላን፥ አኬካንነ ኦሱዋ ኡባ ኦያ ኤራን ኩንዳ። <verse eid="EXO 35:31"/><verse number="32" style="v" sid="EXO 35:32"/>ሄዌካ ሂላን ኪታ ሀልቹዋ ከሲደ፥ ዎርቃፐ፥ ብራፐነ ናሃስያፐ ዱማ ዱማባ እ ኡዳናሳ። <verse eid="EXO 35:32"/><verse number="33" style="v" sid="EXO 35:33"/>ሄዋዳንካ፥ አልኦ ሹቻ ማሲደ ጊግሳናሳ፤ ም ማሳናሳነ ኡባ ቆሞ ኦሱዋ ሂላን ኦናሳ። <verse eid="EXO 35:33"/><verse number="34" style="v" sid="EXO 35:34"/>ሄዋ ቦላካ ቃይ አስነ ዳና ዛርያ አህሳማካ ናኣ ኦሆልኣባዉ፥ ሀራ አሳ ታማርስያ ኤራ እሜዳ። <verse eid="EXO 35:34"/><verse number="35" style="v" sid="EXO 35:35"/>ኡንቱንቱ ኡባ ቆሞ ኦሱዋ ኦናዳን፥ ሂላን ኦያዋንታ፥ ኦሱዋ ሀልቹዋ ከስያዋንታ፥ ሳሉዋ ማላትያ ቃጭናን፥ ኦቻ ቴራ ማላትያ ቃጭናን፥ ሾሎላ ዞኦ ቃጭናንነ ሊኑዋ ቃጭናን አሌቁዋ ዳድያዋንታነ ሸማይነቱዋ ግዳናዳን፥ ጾሳይ ኡንቱንቱ ኤራተን ኩንዳ። ኡንቱንቱ ኡባይካ ኡባ ቆሞ ኦሱዋ ሉጺደ ኤርያ ኤራንቻ ግዴድኖ።<verse eid="EXO 35:35"/></para>
  <chapter eid="EXO 35"/>
  <chapter number="36" style="c" sid="EXO 36"/>
  <para style="p">
    <verse number="1" style="v" sid="EXO 36:1"/>“ሄዋ ድራዉ፥ ባጻልኤል፥ ኦሆልኣብነ መና ጎዳ ዱንካንያ ኬጻና ማላነ ኦሶ ግድያ ኤራ መና ጎዳይ እምና፥ ሉጼዳ አሳይ ኡባይ መና ጎዳይ አዛዜዳዋዳን ኡባባ ኦና” ያጌዳ።<verse eid="EXO 36:1"/></para>
  <para style="s1">አሳይ እሜዳ እሞታ ጮራተ</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 36:2"/>ሄዋፐ ጉይያን ሙሴ ባሳልኤላ፥ ኦሆልኣባነ መና ጎዳይ ዱማ ኤራ እሜዳዋንቱ ኦሱዋ ኦናዉ ያና ኮይያ ኡባ ጼሲደ ሺሼዳ። <verse eid="EXO 36:2"/><verse number="3" style="v" sid="EXO 36:3"/>እስራኤልያ አሳይ ጾሳ ዱንካንያ ኦናዉነ ኦሶ ግድያ እሞታ ኡባ ሙሴፐ አኬድኖ። ቃይ አሳይ ባረ ሸንያን ጮ እምያ እሞታ ዎንታ ዎንታ ጉጅ ጉጂደ አህያዋ አግቤና። <verse eid="EXO 36:3"/><verse number="4" style="v" sid="EXO 36:4"/>ያትና ጾሳ ዱንካንያ ኦያ ኤራይ ኩሜዳ አሳይ ኡባይ ባረንቱ ኦሱዋ አግ ባሺደ፥ <verse eid="EXO 36:4"/><verse number="5" style="v" sid="EXO 36:5"/>ሙሳ ሀዋዳን ያጌድኖ፤ “አሳይ መና ጎዳይ አዛዜዳ ኦሶ ኮሽያዋፐ ሎይ ዳርያዋ አሂደ ደኤ” ያጌድኖ።<verse eid="EXO 36:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 36:6"/>ሙሴ ዱንካኔዳ ሳኣን ደእያ አሳዉ ሀዋዳን ያጊደ አዛዜዳ፤ “ላኤን አይ አቱማ አሳይካ አይ ማጫ አሳይካ ጾሳ ዱንካንያ ኦሶ እምያዋ እማናዉ አሆፖ” ያግና፥ አሳይ አህያዋ አግ ባሼዳ። <verse eid="EXO 36:6"/><verse number="7" style="v" sid="EXO 36:7"/>አያዉ ጎፐ፥ ኡንቱንቱ አሄዳ እሞታይ ኦሱዋ ኡባ ኦናዉ ግዲደ ፓላሄ።<verse eid="EXO 36:7"/></para>
  <para style="s1">ጾሳ ዱንካንያ ኦሱዋባ</para>
  <para style="r">(<ref loc="EXO 26:1-37">26:1-37</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 36:8"/>ኦሱዋ ኦያዋንቱ ግዶፐ ሂላ ዳርያዋንቱ ኡባቱ ሊቆ ሊኑዋፐነ ሳሉዋ ማላትያ፥ ኦቻ ቴራ ማላትያነ ሾሎላ ዞኦ ቃጭናፐ ዳደቴዳ ታሙ ጋርዱቱዋፐ ጾሳ ዱንካንያ ጊግሴድኖ። ሄ ጋርዳቱዋን እት ሂላይ ክሩበቱዋ ምስልያ ዳዴዳ። <verse eid="EXO 36:8"/><verse number="9" style="v" sid="EXO 36:9"/>ጋርዶቱ ኡባይ እት ልከ ግዲደ፥ ጌሳይ ላታማነ ሆስፑን ዋ፤ ጎምፓይ ኦይዱ ዋ። <verse eid="EXO 36:9"/><verse number="10" style="v" sid="EXO 36:10"/>እቼሹ ጋርዳቱዋ እትፐ ጋደ ስኬድኖ፤ ቃይ የንኮ አቴዳ እቼሹ ጋርዳቱዋካ ኡንቱንቱዋዳን ኦድኖ። <verse eid="EXO 36:10"/><verse number="11" style="v" sid="EXO 36:11"/>እትፐ ጋደ ስኬዳ ጋርዱቱዋፐ እት ጋርዱዋ ዉርሰ ጋጻን ሳሉዋ ማላትያ ጫርቂያፐ ማጫራ መድኖ። ቃይ እትፐ ጋከት ስከቴዳ የንኮ ጋርዱዋንካ ሄዋዳን ኦድኖ። <verse eid="EXO 36:11"/><verse number="12" style="v" sid="EXO 36:12"/>ኡንቱንቱ እትፐ ጋከቴዳ እት ጋርዱዋ ቦላ እሻታሙ ማጫራ፥ ቃይ እትፐ ጋከቴዳ የንኮ ጋርዱዋ ቦላካ እሻታሙ ማጫራ መድኖ። ሄ ማጫራቱ ኡባይካ እቱ እቶ ማራን ደኢኖ። <verse eid="EXO 36:12"/><verse number="13" style="v" sid="EXO 36:13"/>ሄዋፐ ጉይያን፥ ዎርቃፐ እሻታሙ ኦይቂያዋ መድኖ። ዱንካኒ እቱዋ ግዳና ማላ፥ ሄ ጋርዳቱዋ ጋጻ ጋጻ ሄ ኦይቂያዋንቱን ኦይድኖ።<verse eid="EXO 36:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 36:14"/>ጾሳ ዱንካንያ ቦላና ካምያ ዱንካንያዉ ታማነ እት ጋርዳቱዋ ዴሻ አጎዛፐ ዳዴድኖ። <verse eid="EXO 36:14"/><verse number="15" style="v" sid="EXO 36:15"/>ታማነ እት ጋርዳቱካ እት ልከ፤ እት እት ጋርዱዋ ጌሳይ ሀታሙ ዋ፥ ጎምፓይ ኦይዱ ዋ። <verse eid="EXO 36:15"/><verse number="16" style="v" sid="EXO 36:16"/>እቼሹ ጋርዳቱዋ እት ባጋና፥ ኡሱፑን ጋርዳቱዋ ቃይ የንኮ ባጋና ጋደ ስኬድኖ። <verse eid="EXO 36:16"/><verse number="17" style="v" sid="EXO 36:17"/>ሄዋፐ ጉይያን ጋ ስኬዳ ጋርዳቱዋፐ እት ጋርዱዋ ጋጻን እሻታሙ ማጫራ መድኖ። ቃይካ ጋ ስኬዳ የንኮ ጋርዳቱዋፐ ዉርሰ ጋርዱዋ ጋጻን እሻታሙ ማጫራ መድኖ። <verse eid="EXO 36:17"/><verse number="18" style="v" sid="EXO 36:18"/>ላኡ ባጋና ደእያ ጋርዳቱዋ ጋደ እት ዱንካነ ኦናዉ ናሃስያፐ እሻታሙ ኦይቂያዋ መድኖ። <verse eid="EXO 36:18"/><verse number="19" style="v" sid="EXO 36:19"/>ሄዋፐ ጉይያን ዱንካንያ ካማናዉ ዶርሳ ኦርግያ ጋልባ ዞኦ ቃላምያን የግ ከሴዳዋ ጊግሴድኖ፤ ቃይ አ ቦላና ካማናዉ ቁምእያ ጊግሴድኖ።<verse eid="EXO 36:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 36:20"/>ጾሳ ዱንካንያ ጻጋግያዋንታ ስት ጌዳ ኦዶሮቱዋፐ ከሴድኖ። <verse eid="EXO 36:20"/><verse number="21" style="v" sid="EXO 36:21"/>እት እት ጻጋግያዉ ጌሳይ ታሙ ዋ፤ ጎምፓይ እት ዋነ ባጋ። <verse eid="EXO 36:21"/><verse number="22" style="v" sid="EXO 36:22"/>እት እት ጻጋግያዉ እቱዋ እቱዋና ጋ ኦይያ ላኡ ፖቱዋ መድኖ። ጾሳ ዱንካንያ ጻጋገቱዋ ኡባካ ሄዋዳን ኦድኖ። <verse eid="EXO 36:22"/><verse number="23" style="v" sid="EXO 36:23"/>ጾሳ ዱንካንያዉ ገድሳ ባጋና ላታሙ ጻጋገቱዋ መድኖ። <verse eid="EXO 36:23"/><verse number="24" style="v" sid="EXO 36:24"/>እት እት ጻጋግያዉ ላኡ ገደቱዋ፥ ኡባና ኦይታሙ ፖይ ገልያ ሉካቱዋ ብራፐ ጊግሴድኖ። <verse eid="EXO 36:24"/><verse number="25" style="v" sid="EXO 36:25"/>ጾሳ ዱንካንያዉ ሁጲሳ ባጋና ላታሙ ጻጋገቱዋ መድኖ። <verse eid="EXO 36:25"/><verse number="26" style="v" sid="EXO 36:26"/>እት እት ጻጋግያዉ ላኡ ፖይ ገልያ ሉካቱዋ፥ ኡባና ኦይታሙ ፖይ ገልያ ሉካቱዋ ብራፐ ጊግሴድኖ። <verse eid="EXO 36:26"/><verse number="27" style="v" sid="EXO 36:27"/>ጾሳ ዱንካንያዉ ጉየ ጋጻን አዋይ ዉልያ ባጋና ኡሱፑን ጻጋገቱዋ መድኖ። <verse eid="EXO 36:27"/><verse number="28" style="v" sid="EXO 36:28"/>ጾሳ ዱንካንያ ጉየ ጋጻን ደእያ ጋጻቶ ላኡ ጻጋገቱዋ ጊግሴድኖ። <verse eid="EXO 36:28"/><verse number="29" style="v" sid="EXO 36:29"/>ሀ ላኡ ጋጻቱዋን ደእያ ጻጋገቱዋ ጻጱዋፐ ጼራ ጋካናዉ ዳቡላ ግድ ቢደ፥ ጼራን እት ሳጋይያን ገል ኦይቀቴድኖ። ኡንቱንቱ ላአቱካ ሄዋዳን ሀኔድኖ። <verse eid="EXO 36:29"/><verse number="30" style="v" sid="EXO 36:30"/>ሄዋ ድራዉ፥ እት እት ጻጋግያዉ ጋርሳና ላኡ ላኡ ገደቱ ደኢኖ፤ ኡባና ሆስፑን ጻጋገቱነ ብራፐ ኦሰቴዳ ታማነ ኡሱፑን ገደቱ ደኢኖ።<verse eid="EXO 36:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 36:31"/>ቃይ ኡንቱንቱ ኦዶሮቱዋፐ ሽካላቱዋ ከሴድኖ፤ ጾሳ ዱንካንያዉ እት ባጋ ምይያን ደእያ ጻጋገቶ እቼሹ ሽካላቱዋ፥ <verse eid="EXO 36:31"/><verse number="32" style="v" sid="EXO 36:32"/>ቃይ የንኮ ባጋ ምይያን ደእያ ጻጋገቶ እቼሹ ሽካላቱዋ ጊግሴድኖ። ሄዋዳንካ፥ ጾሳ ዱንካንያዉ ጉየ አዋይ ዉልያ ባጋና ዉርሰ ጋጻን ደእያ ጻጋገቶ እቼሹ ሽካላቱዋ መድኖ። <verse eid="EXO 36:32"/><verse number="33" style="v" sid="EXO 36:33"/>ግዶ ሽካሊ ጻጋገቶ ግዶ ሄራና፥ ሀ ጋጻፐ ያ ጋጻ ጋካናዉ ፕን ከሳናዳን ኦድኖ። <verse eid="EXO 36:33"/><verse number="34" style="v" sid="EXO 36:34"/>ጻጋገቱዋ ዎርቃን ሼሺደ፥ ሽካላቱ አያ ሳጋየቱዋ ዎርቃፐ መድኖ፤ ቃይ ሽካላቱዋካ ዎርቃን ሼሼድኖ።<verse eid="EXO 36:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 36:35"/>ሳሉዋ ማላትያ፥ ኦቻ ቴራ ማላትያነ፥ ሾሎላ ዞኦ ቃጭናፐነ ሊቆ ሊኑዋፐ እት ጋርዱዋ ኦድኖ። ሄ አ ቦላ እት ሂላይ ክሩበቱዋ ምስልያ ስኬዳ። <verse eid="EXO 36:35"/><verse number="36" style="v" sid="EXO 36:36"/>ጋርዱዋ ኦይዱ ቱሳቱዋ ኦዶሩዋፐ ጊግሲደ፥ ዎርቃን ሼሼድኖ። ያቲደ ዎርቃ ካቂያዋንታ ኡንቱንቶ ጊግሴድኖ። ቃይ ቱሳቱዋ ኤስያ ኦይዱ ገደቱዋ ብራፐ መድኖ። <verse eid="EXO 36:36"/><verse number="37" style="v" sid="EXO 36:37"/>ጾሳ ዱንካንያ ገልያ ፐንግያዉ ሳሉዋ ማላትያ፥ ኦቻ ቴራ ማላትያነ ሾሎላ ዞኦ ቃጭናፐነ ሊቆ ሊኑዋፐ ዳደቴዳዋ፥ ጽልፕያ አሌቅስያዋን ጋርዱዋ ጊግሴድኖ። <verse eid="EXO 36:37"/><verse number="38" style="v" sid="EXO 36:38"/>ቃይ ኡንቱንታ ካቂያ እቼሹ ቱሳቱዋ፥ ካቂያ ባላና ደእያዋንታ መድኖ። ቱሳቱ ጉምቦቱዋነ ቃችያዋንታ ዎርቃን ሼሼድኖ። ቃይ ኡንቱንቱ ፖይ ገልያ ሉኮቱዋ እቼሻቱዋካ ናሃስያፐ መድኖ።<verse eid="EXO 36:38"/></para>
  <chapter eid="EXO 36"/>
  <chapter number="37" style="c" sid="EXO 37"/>
  <para style="s1">ታቦታ ኦሱዋባ</para>
  <para style="r">(<ref loc="EXO 25:10-22">25:10-22</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 37:1"/>ባጻልኤል ኦዶሩዋ ምፐ ታቦታ ጊግሴዳ። ሄ ታቦታይ አዱሳተይ ላኡ ዋነ ባጋ አዱቄ፤ ጎምፓይ እት ዋነ ባጋ አኬ፤ ጌሳይካ እት ዋነ ባጋ ቄ። <verse eid="EXO 37:1"/><verse number="2" style="v" sid="EXO 37:2"/>ሄ ታቦታ ጊግሲደ፥ ሶያነ ካርያ ዋላካይ ባይና ዎርቃን ሼሼዳ፤ ዩሹዋካ ዎርቃ ትገን ዩሽ አዳ። <verse eid="EXO 37:2"/><verse number="3" style="v" sid="EXO 37:3"/>ቃይ ኦይዱ ዎርቃ ሳጋየቱዋ ትጊደ፥ ታቦታዉ ኦይዱ ገደቱዋን፥ እት ባጋና ላኡ ሳጋየቱዋ፥ ቃይ የንኮ ባጋና ላኡ ሳጋየቱዋ አዳ። <verse eid="EXO 37:3"/><verse number="4" style="v" sid="EXO 37:4"/>ያቲደ ኦዶሮቱዋፐ ካሱዋ ከሲደ ኡንቱንታካ ዎርቃን ሼሼዳ። <verse eid="EXO 37:4"/><verse number="5" style="v" sid="EXO 37:5"/>ታቦታ ቶካናዉ፥ ታቦታ ምይያን ደእያ ሳጋየቱዋን ካሱዋ አዳ።<verse eid="EXO 37:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 37:6"/>ዋላካይ ባይና ዎርቃፐ ላኡ ዋነ ባጋ አዱቂያ፥ እት ዋነ ባጋ አክያ አቶ ግያ ሳኣ ቁምእያ መዳ። <verse eid="EXO 37:6"/><verse number="7" style="v" sid="EXO 37:7"/>ቁምእያዉ ዉርሰ ላኡ ባጋ ጋጻን ላኡ ክሩቤላቱዋ ቆጸቴዳ ዎርቃፐ መዳ። <verse eid="EXO 37:7"/><verse number="8" style="v" sid="EXO 37:8"/>እት ክሩብያ እት ባጋ ጋጻን፥ ላኤን ክሩብያ የንኮ ባጋ ጋጻን፥ ላኡዋካ ቁምእያና ጋ ኦይደ መዳ። <verse eid="EXO 37:8"/><verse number="9" style="v" sid="EXO 37:9"/>ክሩበቱ ባረንቱ ቀፍያ ደንደ፥ አቶ ግያ ሳኣ ካምያ ቁምእያ ባረንቱ ቀፍያን ኩዋይ ዎድኖ፤ ቃይ እቱ እቱዋኮ ስም ኡቲደ፥ ቁምእያ ጼሊኖ።<verse eid="EXO 37:9"/></para>
  <para style="s1">ጻርጴዛ</para>
  <para style="r">(<ref loc="EXO 25:23-30">25:23-30</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 37:10"/>ቃይ አዱሳተይ ላኡ ዋ፥ ጎምፓይ እት ዋ፥ ጌሳይካ እት ዋነ ባጋ ግዴዳ ጻርጴዛ ኦዶሩዋፐ መዳ። <verse eid="EXO 37:10"/><verse number="11" style="v" sid="EXO 37:11"/>ዋላካይ ባይና ዎርቃን ሼሼዳ። ዩሹዋካ ዎርቃ ትገ ዩሽ አዳ። <verse eid="EXO 37:11"/><verse number="12" style="v" sid="EXO 37:12"/>ሄዋዳንካ፥ ጎምፓይ ታካ ግዴዳ ሻሽያ አ ቦላ ዩሽ አዳ። ያቲደ አ ቦላ ዎርቃ ትገ ዩሼዳ። <verse eid="EXO 37:12"/><verse number="13" style="v" sid="EXO 37:13"/>ኦይዱ ዎርቃ ሳጋየቱዋ መደ ኦይዱ ገደቱ መቴዳ ኦይዱ ጋጻቱዋና ኦይዳ። <verse eid="EXO 37:13"/><verse number="14" style="v" sid="EXO 37:14"/>ጻርጴዛ ቶካናዉ ካሱዋ አያ ሳጋየቱ ጻርጴዛዉ ሻሽያ ጋጻን ሺቂደ መቴድኖ። <verse eid="EXO 37:14"/><verse number="15" style="v" sid="EXO 37:15"/>ጻራጴዛ ቶክያ ካሶቱዋካ ኦዶሩዋፐ ከሲደ፥ ዎርቃን ሼሼዳ። <verse eid="EXO 37:15"/><verse number="16" style="v" sid="EXO 37:16"/>ሄዋዳንካ፥ ጻርጴዛ ቦላ ዎያ ዱማ ዱማ ሚሻቱዋ ዋላካይ ባይና ዎርቃፐ መዳ፤ ሄዋንቱካ ሳነቱዋነ ጭልፓቱዋ፥ ቃይ ኡሻ ያርሹዋ ትግያ ከረቱዋነ ጹአቱዋ።<verse eid="EXO 37:16"/></para>
  <para style="s1">ጾምፕያ ዎያ ባላ</para>
  <para style="r">(<ref loc="EXO 25:31-40">25:31-40</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 37:17"/>ሄዋፐ ጉይያን እ ጾምፕያ ዎያ ባላ ቆጸቴዳ ዋላካይ ባይና ዎርቃፐ መዳ፤ ሄ ባላ ኤስያ ገድያካ፥ ግዶ ቶማካ ቆጼዳ ዎርቃፐ መዳ። አ ኩኩሞቱዋ፥ አ ልጮቱዋን አ ጪሻቱዋ ኡባ አናና እትፐ ጾምፒደ መዳ። <verse eid="EXO 37:17"/><verse number="18" style="v" sid="EXO 37:18"/>ምይያና ኡሱፑን ማራቱዋ መዳ፤ ማራቱዋ ሄዛቱዋ እት ባጋና፥ ቃይ ሄዛቱዋ የንኮ ባጋና ከሴዳ። <verse eid="EXO 37:18"/><verse number="19" style="v" sid="EXO 37:19"/>ኡሱፑን ማራቶካ ሁጲያን ሁጲያን ሄዙ ሄዙ ኩኩሙነ ጪሻቱ ደእያ ላዉዝያ ጪሻ ማላትያ ዋንጫ መዳ፤ <verse eid="EXO 37:19"/><verse number="20" style="v" sid="EXO 37:20"/>ጾምፕያ ዎያ ባላዉ ግዶ ቶማይ፥ ኩኩሞቱዋ ጪሻቱ ደእያ ጪሻ ማላትያ ኦይዱ ዋንጫን አሌቀት ኡቴዳ። <verse eid="EXO 37:20"/><verse number="21" style="v" sid="EXO 37:21"/>ላኡ ላኡ እትፐ ዋን ደእያ ሄዙ ማራቱዋፐ ጋርሳና እት እት ኩኩማይ መት ኡቴዳ ኡባይካ ኡሱፑን ኩኩሞ። <verse eid="EXO 37:21"/><verse number="22" style="v" sid="EXO 37:22"/>ኩኩማቱነ ማራቱ ኡባይ ጾምፕያ ዎያ ባላና እትፐ ኦይቀት እቱዋ ግዲደ፥ ዋላካይ ባይና ዎርቃፐ ቆጸቲደ መቴድኖ።<verse eid="EXO 37:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 37:23"/>እ ቃይ ጾምፕያ ዎያ ባላዉ ላፑን ጾምፐቱዋ፥ ጾምፕያ ቶይስያ ቃጰቱዋነ ኡንቱንታ ዎያዋንታ ዋላካይ ባይና ዎርቃፐ መዳ። <verse eid="EXO 37:23"/><verse number="24" style="v" sid="EXO 37:24"/>ጾምፕያ ዎያ ባላነ አን ጎኤትያ ሚሻ ኡባ መናዉ ሀታማነ እቼሹ ኪሎ ግራመ ግዴዳ ዋላካይ ባይና ዎርቃ ዉርሴዳ።<verse eid="EXO 37:24"/></para>
  <para style="s1">እጻና ጩዊስያ ሳጽንያ</para>
  <para style="r">(<ref loc="EXO 30:1-5">30:1-5</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 37:25"/>ቃይ እጻና ጩውስያ ሳኣ ኦዶሩዋፐ መዳ። አዉ ኦይዱ ጋጻይ ደኤ፤ አዱሳተይ እት ዋ፤ ጎምፓይ እት ዋ፥ ጌሳይ ላኡ ዋ። አ ካጨቱካ አናና እቱዋ ግዲደ ኦይቀት መቴዳዋንታ። <verse eid="EXO 37:25"/><verse number="26" style="v" sid="EXO 37:26"/>አዉ ቦላ ዶና፥ ኦይዱ ባጋ ኡባነ አ ካጨቱዋ ዋላካይ ባይና ዎርቃን ሼሺደ፥ አ ዩሹዋካ ዎርቃ ትገ ዩሽ አዳ። <verse eid="EXO 37:26"/><verse number="27" style="v" sid="EXO 37:27"/>ሄ ዎርቃ ትገፐ ጋርሳና እጻና ጩውስያ ሳጽንያ ዎርቃፐ ላኡ ሳጋየቱዋ መዳ፤ ያቲደ ያ ባጋናነ ሀ ባጋና ላኡዋ ላኡዋ ኦይዳ። ሄዋንቱ ቶክያ ዎደ ካሱዋ አናዉ ማዳናዳና። <verse eid="EXO 37:27"/><verse number="28" style="v" sid="EXO 37:28"/>ካሶቱዋ ኦዶሩዋፐ ከሲደ፥ ኡንቱንታ ዎርቃን ሼሼዳ።<verse eid="EXO 37:28"/></para>
  <para style="s1">ዛይትያነ እጻና</para>
  <para style="r">(<ref loc="EXO 30:22-38">30:22-38</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 37:29"/>ቃይ ጌሻ ኦከትያ ዛይትያነ ሳዉዋ ቶሽኩ ግያ ሎኦ እጻና ሽቱዋ ኦያ ኤራን ጊግሴዳ።<note caller="-" style="x"><char style="xo" closed="false">37:29 </char><char style="xt" closed="false"><ref loc="EXO 30:22-38">ከሳ 30:22-38</ref></char></note><verse eid="EXO 37:29"/></para>
  <chapter eid="EXO 37"/>
  <chapter number="38" style="c" sid="EXO 38"/>
  <para style="s1">ጹግያ ያርሹዋ ያርሽያ ሳኣ</para>
  <para style="r">(<ref loc="EXO 27:1-8">27:1-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 38:1"/>ኦዶሩዋፐ ጹግያ ያርሹዋ ያርሽያ ሳኣ ኬጼዳ። ሄ ያርሽያ ሳአዉ ጌሳይ ሄዙ ዋ፥ ጎምፓይነ አዱሳተይ እት ልከ፥ እቼሹ እቼሹ ዋ ግዲደ፥ ኦይዱ ጋጻና ደእያዋ ኦድኖ። <verse eid="EXO 38:1"/><verse number="2" style="v" sid="EXO 38:2"/>ኦይዱ ጋጻቱዋ ዉርሰ ጋጻን ጋጻን እት እት ካጭያ መዳ። ሄ ካጨቱ ያርሽያ ሳኣና እትፐ ኦይቀቲደ ኦሰቴድኖ። ያትና ያርሽያ ሳኣ ናሃስያ ብራታን ሼሼዳ። <verse eid="EXO 38:2"/><verse number="3" style="v" sid="EXO 38:3"/>አን ጎኤትያ ኡባ ሚሻቱዋ፥ ባልደቱዋ፥ አካፋቱዋ፥ ብድን ሺሽያ ኩይጻሮቱዋ፥ አሹዋ ኦይቂያ ዛምቤልያነ ታማ ጮጨቱዋ ኡባ ናሃስያ ብራታፐ መዳ። <verse eid="EXO 38:3"/><verse number="4" style="v" sid="EXO 38:4"/>ያቲደ ናሃስያ ብራታፐ ዛዝርያ ያርሽያ ሳአዉ ጊግሲደ ያርሽያ ሳአዉ ዱገ ግዶ ባጋን ደእያ ሻሽያ ቦላ ዎዳ። <verse eid="EXO 38:4"/><verse number="5" style="v" sid="EXO 38:5"/>ናሃስያ ብራታፐ መዳ ዛዝርያዉ ኦይዱ ጋጻን ካሱዋ አናዉ ኦይዱ ሳጋየቱዋ መዳ። <verse eid="EXO 38:5"/><verse number="6" style="v" sid="EXO 38:6"/>ኦዶሩዋፐ ያርሽያ ሳአዉ ካሱዋ ከሲደ፥ ናሃስያ ብራታን ሼሼዳ። <verse eid="EXO 38:6"/><verse number="7" style="v" sid="EXO 38:7"/>ያርሽያ ሳኣ ቶክያ ዎደ ማዳና ማላ፥ ሀ ካሱዋ ላኡ ምይያና ደእያ ሳጋየቱዋን አዳ። ያርሽያ ሳኣ ግዱዋ ኮፋ ከሲደ፥ ጻዉላፐ መዳ።<verse eid="EXO 38:7"/></para>
  <para style="s1">ሜቻ ከርያ</para>
  <para style="r">(<ref loc="EXO 30:18">30:18</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 38:8"/>ናሃስያ ብራታፐ ሜቻ ከርያነ አ ዎያዋ መዳ፤ ሄ ብራታይ ጋከ ዱንካንያ ፐንግያን ኦያ ማጫ አሳቱ አሄዳ ሄረጋፐ አከቴዳ።<verse eid="EXO 38:8"/></para>
  <para style="s1">ጾሳ ዱንካንያ ዳባባ</para>
  <para style="r">(<ref loc="EXO 27:9-19">27:9-19</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 38:9"/>ሄዋፐ ጉይያን ዳባባ ጊግሴዳ። ዳባባዉ ገድሳ ባጋ አዱሳተዉ ጼቱ ዋ ኦደ፥ ሊቆ ሊኑዋፐ ዳደቴዳ ጋርዳቱዋ ጊግሴዳ። <verse eid="EXO 38:9"/><verse number="10" style="v" sid="EXO 38:10"/>አዉ ናሃስያ ብራታፐ ላታሙ ቱሳቱዋነ ቱሳቱ ኤቂያ ናሃስያ ሉካቱዋ ኦዳ፤ ኡንቱንቱ ሁጲያን ቃይ ብራፐ መቴዳ ካቂያዋንታነ ቱሳቱዋ ሁጲያን ቃችያዋንታ ኦዳ። <verse eid="EXO 38:10"/><verse number="11" style="v" sid="EXO 38:11"/>ዳባባዉ ሁጲሳ ባጋ አዱሳተይ ጼቱ ዋ አዱሳ፤ ቃይ ላታሙ ቱሳቱነ ሄ ቱሳቶ ላታሙ ናሃስያ ገደቱ ደኢኖ። ያቲደ ብራፐ መቴዳ ካቂያዋንቱነ ቱሳቱዋ ሁጲያን ቃችያዋንቱ ደኢኖ። <verse eid="EXO 38:11"/><verse number="12" style="v" sid="EXO 38:12"/>አዋይ ዉልያ ባጋ ዳባባ ጎምፓይ እሻታሙ ዋ አካ ግዲደ፥ ታሙ ቱሳቱነ ቱሳቶ ታሙ ገደቱ ደእያ ጋርዳቱዋ ጊግሴዳ፤ ሄ ቱሳቱዋ ሁጲያን ብራፐ መቴዳ ካቂያዋንታነ ቱሳቱዋ ሁጲያን ቃችያዋንታ ኦዳ። <verse eid="EXO 38:12"/><verse number="13" style="v" sid="EXO 38:13"/>ቃይ አዋይ ዶልያ ባጋ ዳባባ ጎምፓይ እሻታሙ ዋ አካ። <verse eid="EXO 38:13"/><verse number="14" style="v" sid="EXO 38:14"/>ዳባባ ገልያ ሳኣፐ እት ባጋና ታማነ እቼሹ ዋ አዱቂያ ጋርዶቱ፥ ሄዙ ቱሳቱነ ቱሳቶ ሄዙ ገደቱ ደኢኖ። <verse eid="EXO 38:14"/><verse number="15" style="v" sid="EXO 38:15"/>ሄዋዳንካ፥ ዳባባ ገልያ ሳኣፐ ህንኮ ባጋና፥ ታማነ እቼሹ ዋ አዱቂያ ጋርዶቱ፥ ኡንቱንቶ ሄዙ ቱሳቱነ ቱሳቶ ሄዙ ገደቱ ደኢኖ። <verse eid="EXO 38:15"/><verse number="16" style="v" sid="EXO 38:16"/>ዳባባ ዩሹዋን ደእያ ጋርዶቱ ኡባይ ሊቆ ሊኑዋፐ ዳደቴዳዋንታ። <verse eid="EXO 38:16"/><verse number="17" style="v" sid="EXO 38:17"/>ሄ ቱሳቱዋ ገደቱ ናሃስያፐ፥ ካቂያዋንቱነ ቱሳቱዋ ሁጲያን ቃችያዋንቱ ብራፐ ኦሰቴድኖ፤ ኡንቱንቱ ሁጲ ብራን ሼሸቴዳ። ሄዋ ድራዉ፥ ዳባባ ዩሹዋን ደእያ ቱሳቱዋ ኡባ ሁጲያን ብራፐ ኦሰቴዳ ቃችያዋንቱ ደኢኖ። <verse eid="EXO 38:17"/><verse number="18" style="v" sid="EXO 38:18"/>ዳባባ ገልያ ሳኣን ካቂያ ጋርዱ ሳሉዋ ማላትያ ኦቻ ቴራ ማላትያነ ሾሎላ ዞኦ ቃጭናፐነ ሊቆ ሊኑዋፐ ዳድያዋ ጽልፕያን አሌቂስያዋን ጊግሴዳዋ። አዉ አዱሳተይ ላታሙ ዋ፤ ጌሳይ ዳባባ ጋርዳቱዋ ልከ፥ እቼሹ ዋ። <verse eid="EXO 38:18"/><verse number="19" style="v" sid="EXO 38:19"/>ናሃስያ ብራታፐ ኦሰቴዳ ኦይዱ ቱሳቱነ ቱሳቶ ኦይዱ ገደቱ ደኢኖ። ኡንቱንቱ ካቂያዋንቱነ ቱሳቱዋ ሁጲያን ቃችያዋንቱ ብራፐ መቴድኖ፤ ኡንቱንቱ ሁጰቱካ ብራን ሼሸቴድኖ። <verse eid="EXO 38:19"/><verse number="20" style="v" sid="EXO 38:20"/>ጾሳ ዱንካንያ ሽካላቱ ኡባይነ አ ዩሹዋን ደእያ ዳባባ ሽካላቱ ኡባይ ናሃስያ ብራታፐ መቴዳዋንታ።<verse eid="EXO 38:20"/></para>
  <para style="s1">ጾሳ ዱንካንያን ጎኤትያ ሚሻቱዋ</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 38:21"/>ጾሳ ዱንካንያዉ፥ ሄዌካ ቃላ ጫቁዋ ዱንካንያዉ፥ ጎኤቴዳ ሚሻቱዋ ሌዋቱ ፓይዴድኖ። ሄ ሚሻቱዋ ቄስያ አሮና ናኣ እታማራ ካፖተ ጋርሳን ደእያ ሌዋቱ ማዝጋባን ጻፋናዳን ሙሴ አዛዜዳ።<verse eid="EXO 38:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 38:22"/>ይሁዳ ዛረ ግዴዳ ሆራ ናኣ ናኣ፥ ኡራ ናኣ፥ ባጻልኤል መና ጎዳይ ሙሳ አዛዜዳ ኡባ ኦዳ። <verse eid="EXO 38:22"/><verse number="23" style="v" sid="EXO 38:23"/>ዳና ዛረ ግዴዳ አህሳማካ ናኣ ኦሆልኣብ አናና ደኤ፤ እ ኩሽያ ሂላንቻነ ኦያባዉ ኮይሮ ሀልቹዋ ከስያዋ፤ ቃይ ሳሉዋ ማላትያ፥ ኦቻ ቴራ ማላትያነ ሾሎላ ዞኦ ቃጭናንነ ሊቆ ሊኑዋን ዳዲደ፥ ጽልፕያን አሌቂስያ አሳ።<verse eid="EXO 38:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 38:24"/>ጾሳ ዱንካንያ ኦሶ ጾሳዉ እመቴዳ ዎርቃይ ጾሳ ዱንካንያን ኤረትያ ሚዛናን ዎና፥ እት ሻአ ኪሎ ግራምያ ዴጼዳ። <verse eid="EXO 38:24"/><verse number="25" style="v" sid="EXO 38:25"/>ፓይዱዋን ደእያ ማባራ አሳፐ ቤቴዳ ብራይ ጾሳ ዱንካንያን ኤረትያ ሚዛናን ዎና፥ 3,430 ኪሎ ግራምያ ዴጼዳ።<note caller="-" style="x"><char style="xo" closed="false">38:25-26 </char><char style="xt" closed="false"><ref loc="EXO 30:11-16">ከሳ 30:11-16</ref></char></note> <verse eid="EXO 38:25"/><verse number="26" style="v" sid="EXO 38:26"/>አሳ ፓይድያ ዎደ ፓይደቴዳ አቱማ አሳይ ኡባይ ሁጲያን ሁጲያን ጾሳ ዱንካንያን ኤረትያ ሚዛናን ዎና፥ ኡሱፑን ግራመ ኬሻ እሜዳ። ፓይደቴዳ አሳይ ላታሙ ላይ ኩሜዳዌነ ላታሙዋፐ ቦላና ደእያዌ ኡባይ 603,550.<note caller="-" style="x"><char style="xo" closed="false">38:26 </char><char style="xt" closed="false"><ref loc="MAT 17:24">ማቶሳ 17:24</ref></char></note> <verse eid="EXO 38:26"/><verse number="27" style="v" sid="EXO 38:27"/>ጾሳ ዱንካንያ ጋርዱዋ ኤሴዳ ጼቱ ፖይ ገልያ ሉኮቱ 3,400 ኪሎ ግራመ ብራን ኦሰቴድኖ። ሄዌካ እት እት ገድያዉ ሀታማነ ኦይዱ ኪሎ ግራመ ብራ። <verse eid="EXO 38:27"/><verse number="28" style="v" sid="EXO 38:28"/>አቴዳ ሀታሙ ኪሎ ግራመ ትግያ ብራ ቱሳቱዋን ካቂያዋንታ መናዉ፥ ቱሳቱዋ ሁጲያን ሼሻናዉነ ኡንቱንቱ ሁጲያን ቃችያዋንታ መናዉ ጎኤቴድኖ። <verse eid="EXO 38:28"/><verse number="29" style="v" sid="EXO 38:29"/>ሄዋዳንካ፥ አሳይ ጾሳዉ አሄዳ ናሃስያ ብራታይ 2,425 ኪሎ ግራመ። <verse eid="EXO 38:29"/><verse number="30" style="v" sid="EXO 38:30"/>ሄ ናሃስያ ብራታፐ ጾሳ ዱንካንያ ገልያ ሳኣን ኤቂያ ቱሳቱዋ ገደቱ፥ ናሃስያ ያርሽያ ሳኣ ግያ ያርሽያ ሳአይ፥ አ ግዶን ሂጼዳ ናሃስያ ዛዝሪነ አ ግዶን ጎኤትያ ዱማ ዱማ ሚሻ ኡባይ መቴ። <verse eid="EXO 38:30"/><verse number="31" style="v" sid="EXO 38:31"/>ሄዋዳንካ፥ ቃይ ዳባባ ዩሹዋን ደእያ ድርሳነ ገልያ ሳኣ ፐንጊ ኤቄዳ ገደቱ፥ ቃይ ጾሳ ዱንካኒነ አ ዩሹዋን ደእያ ዳባባ ድርሳይ ገቴዳ ሽካላቱ ኡባይ ሄ ናሃስያ ብራታፐ መቴድኖ።<verse eid="EXO 38:31"/></para>
  <chapter eid="EXO 38"/>
  <chapter number="39" style="c" sid="EXO 39"/>
  <para style="s1">ቄሳቱ ማይያ ማዩዋ</para>
  <para style="r">(<ref loc="EXO 28:1-14">28:1-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 39:1"/>ቄሳቱ ጾሳ ዱንካንያን ኦያ ዎደ ጎኤትያ ማዩዋ፥ ሳሉዋ ማላትያ፥ ኦቻ ቴራ ማላትያነ ሾሎላ ዞኦ ቃጭናፐ ዳዴድኖ። አሮነ ማይያ ጌሻ ቄሳተ ማዩዋካ መና ጎዳይ ሙሳ አዛዜዳዋዳን ኦድኖ።<verse eid="EXO 39:1"/></para>
  <para style="s1">ኤፉድያ</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 39:2"/>እ ኤፉድያ፥ ዎርቃፐ፥ ሳሉዋ ማላትያ፥ ኦቻ ቴራ ማላትያነ ሾሎላ ዞኦ ቃጭናፐነ ሊቆ ሊኑዋፐ ዳዴዳ። <verse eid="EXO 39:2"/><verse number="3" style="v" sid="EXO 39:3"/>ኡንቱንቱ ዎርቃ ቆጺደ፥ ሌእያ ዬቻዳ፥ አፐ ቃራር ቃራሪደ፥ ቃጭና ከሴድኖ። ያቲደ ሳሉዋ ማላትያ፥ ኦቻ ቴራ ማላትያነ ሾሎላ ዞኦ ቃጭናነ ሊቆ ሊኑዋ ጋደ፥ ኩሽያ ሂላንቻቱ ዳዴድኖ። <verse eid="EXO 39:3"/><verse number="4" style="v" sid="EXO 39:4"/>ላኡ ባጋይ ጋከቲደ እቱዋ ግዳና ማላ፥ ላኡ ሀሽያ ቦላ ጋደ ኦይያ ጫርቂያ ጊግሴድኖ። <verse eid="EXO 39:4"/><verse number="5" style="v" sid="EXO 39:5"/>መና ጎዳይ ሙሳ አዛዜዳዋዳን፥ ሂላይ አሌቂሲደ ዳዴዳ ዳንጩካ ኤፉድያና እታ ግዲደ፥ ዎርቃፐ ሳሉዋ ማላትያ፥ ኦቻ ቴራ ማላትያነ ሾሎላ ዞኦ ቃጭናፐነ ሊቆ ሊኑዋፐ ዳደቴዳ።<verse eid="EXO 39:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 39:6"/>ኡንቱንቱ ማርግድያ ጌተትያ ላኡ ሹቻቱዋ ጊግሲደ፥ ዎርቃፐ መዳ ሹቻ ኦይቂያዋ ቦላ ማራና ዎድኖ። ማታፋ ቦላ ሱን ዎጪደ ጻፍያዋዳን፥ ሄ ሹቻቱዋ ቦላ ታማነ ላኡ እስራኤልያ ናናቱዋ ሱን ዎጪደ ጻፌድኖ። <verse eid="EXO 39:6"/><verse number="7" style="v" sid="EXO 39:7"/>ጾሳይ ሙሳ አዛዜዳዋዳን፥ ታማነ ላኡ እስራኤልያ ዘረ ሀሳይያዋ ግዳና ማላ፥ ሀ ሹቻቱዋ ኤፉድያና ኦይዳ ሀሽያ ጫርቂያን ዎዳ።<verse eid="EXO 39:7"/></para>
  <para style="s1">ትራን ዎያዋ</para>
  <para style="r">(<ref loc="EXO 28:15-30">28:15-30</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 39:8"/>እ ትራን ዎያዋ ኩሽያ ሂላንቻን ኦስሴዳ። ሄ ትራን ዎያዋ ኤፉድያ ዎርቃፐ ዳዴዳዋዳን፥ ሳሉዋ ማላትያ፥ ኦቻ ቴራ ማላትያነ ሾሎላ ዞኦ ቃጭናፐነ ሊቆ ሊኑዋፐ ዳድሴዳ። <verse eid="EXO 39:8"/><verse number="9" style="v" sid="EXO 39:9"/>አዉ ኦይዱ ጋጻይ ደኤ፤ ጌሳይነ ጎምፓይ እት እት ታካ፤ ግዴዳዋ ዳኮዬድኖ። <verse eid="EXO 39:9"/><verse number="10" style="v" sid="EXO 39:10"/>ሄዋፐ ጉይያን አ ቦላ ኦይዱ ማራን አልኦ ሹቻቱዋ ዎድኖ፤ ኮይሮ ማራን ዎዳ ሹቻይ፥ ሳርድዮና፥ ቶጳዝዮንያነ ጶልያ እንቁዋ፤ <verse eid="EXO 39:10"/><verse number="11" style="v" sid="EXO 39:11"/>ላኤን ማራን ባሉራ፥ ሳምፔርያነ አልማዝያ ጌተትያ አልኦ ሹቻቱዋ፤ <verse eid="EXO 39:11"/><verse number="12" style="v" sid="EXO 39:12"/>ሄዘን ማራን ያክንትያ፥ ከልቀዶንያነ አመተስጽኖስያ፤ <verse eid="EXO 39:12"/><verse number="13" style="v" sid="EXO 39:13"/>ኦይደን ማራን ብራል፥ ማርግድያነ ያስጲድያ። ሄዋንታ ኡባ ዎርቃፐ ኦሰቴዳ ሹቻ ኦይቂያዋ ቦላ ዎድኖ። <verse eid="EXO 39:13"/><verse number="14" style="v" sid="EXO 39:14"/>እስራኤልያ ናናቱዋ ሱን ፓይዱዋዳን፥ ሹቻቱዋ ፓይዱካ ታማነ ላኡዋ፤ እቱ እቱ ማታፋዳን ዎጨቲደ፥ ታማነ ላኡ ዛራቱዋ ሱንይ ሄ ሹቻቱዋን ጻፈቴዳ።<verse eid="EXO 39:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 39:15"/>ትራን ዎያዎ ዎዶሩዋዳን ዶቀቴዳ ሳንሳላታ ዋላካይ ባይና ዎርቃፐ መድኖ። <verse eid="EXO 39:15"/><verse number="16" style="v" sid="EXO 39:16"/>ላኡ ዎርቃፐ መዳ ሹቻ ኦይቂያዋንታ ኦድኖ፤ ያቲደ ላኡ ዎርቃ ምግዳቱዋ መዳዋንታ፥ ትራን ዎያዎ ቆሞ ጋጻ ጋጻቱዋና ጋደ ኦይሰድኖ። <verse eid="EXO 39:16"/><verse number="17" style="v" sid="EXO 39:17"/>ሄ ላኡ ዎርቃ ሳንሳላታቱዋ ትራን ዎያዎ ጋጻቱዋን ደእያ ምግዶቱዋና ጋ ኦይድኖ። <verse eid="EXO 39:17"/><verse number="18" style="v" sid="EXO 39:18"/>ሄ ሳንሳላታቶ ህንኮ ባጋ ጼራ ቃይ ኤፉድያዉ ስን ባጋና፥ ሀሽያ ጫርቂያን ደእያ ሹቻ ኦይቂያዋንቱና ጋ ቃቼድኖ። <verse eid="EXO 39:18"/><verse number="19" style="v" sid="EXO 39:19"/>ቃይካ ላኡ ዎርቃ ምግዳቱዋ መደ፥ ኤፉድያፐ ካሊደ ደእያ ትራን ዎያዎ ሶይ ባጋና ደእያ ላኡ ጋጻቱዋ ጼራን አድኖ። <verse eid="EXO 39:19"/><verse number="20" style="v" sid="EXO 39:20"/>ሄዋዳንካ፥ ዎርቃፐ ሀራ ላኡ ምግዳቱዋ መደ፥ ኤፉድያዉ ስን ባጋና፥ ሀሽያ ጫርቂያፐ ጋርሳ ባጋና ኤፉድያ ጼሳን ቃችያዋፐ ቆሞና፥ ስኩ ጋከቴዳ ሳኣ ማታን ካረና ኡንቱንታ ኦይድኖ። <verse eid="EXO 39:20"/><verse number="21" style="v" sid="EXO 39:21"/>መና ጎዳይ ሙሳ አዛዜዳዋዳን፥ ትራን ዎያዋን ደእያ ምግዳቱዋ ኤፉድያን ደእያ ምግዳቱዋና ጋደ፥ ሳሉዋ ማላትያ ባቀን ቃችና ትራን ዎያዌ ጼሳፐ ቆሞና ደእያ ድራዉ፥ ቃሹ ሾልኤና።<verse eid="EXO 39:21"/></para>
  <para style="s1">ቄሳቱ ማይያ ሀራ ማዮቱዋ</para>
  <para style="r">(<ref loc="EXO 28:31-43">28:31-43</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 39:22"/>ኤፉድያፐ ጋርሳና ማይያ አዱሳ ማዩዋ እ ሳሉዋ ማላትያ ጫርቂያፐ ጊግሴዳ፤ ሄዌ ሸማይንያ ኦሱዋ። <verse eid="EXO 39:22"/><verse number="23" style="v" sid="EXO 39:23"/>ሄ አዱሳ ማዮ ቆያ አያ ሳኣ መድኖ፤ ሄ ሳአይ ፔተናዳን፥ ዩሽ አደ ጉጅ ጉጅ ስኬድኖ። <verse eid="EXO 39:23"/><verse number="24" style="v" sid="EXO 39:24"/>ኡንቱንቱ አዱሳ ማዩዋ ዱገ ባጋ ማጫራ ዩሹዋን ሳሉዋ ማላትያ፥ ኦቻ ቴራ ማላትያነ ሾሎላ ዞኦ ዶቀቴዳ ሮማንያ ቴራ ምስለቱዋ መድኖ። <verse eid="EXO 39:24"/><verse number="25" style="v" sid="EXO 39:25"/>ኡንቱንቱ ቃይ ዎርቃፐ ዳላቱዋ መደ፥ አዱሳ ማዮ ዱገ ባጋ ጋጻ ዩሽ አደ፥ ሮማንያ ምስለቱዋ ግዱዋን፥ ዋላካን አድኖ። <verse eid="EXO 39:25"/><verse number="26" style="v" sid="EXO 39:26"/>አሮነ ሄ ማዮ ዱገ ባጋ ማጫራ ዩሽ አደ፥ ዳላነ ሮማንያ ቴራ ምስልያ ዋላኪደ አድኖ። ሄዌ መና ጎዳይ ሙሳ አዛዜዳዋዳን፥ ኡንቱንቱ ጾሳ ዱንካንያ ኦሱዋ ኦደ ማያናሳ።<verse eid="EXO 39:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 39:27"/>ኡንቱንቱ አሮናዉነ አ ናናዉ ሼማይንያ ሊኑዋፐ አዱሳ ሻምጭያ ጊግሴድኖ። <verse eid="EXO 39:27"/><verse number="28" style="v" sid="EXO 39:28"/>ቃይ አሮነ ሁጲያን ጻጽያ ሻሽያ፥ አ ናናዉ ቆበቱዋነ ጋርሳና ማይያ ማዮቱዋ ሊቆ ሊኑዋፐ ዳዲደ ጊግሴድኖ። <verse eid="EXO 39:28"/><verse number="29" style="v" sid="EXO 39:29"/>ኡንቱንቱ መና ጎዳይ ሙሳ አዛዜዳዋዳን ሳሉዋ ማላትያ፥ ኦቻ ቴራ ማላትያነ ሾሎላ ዞኦ ቃጭናፐነ ሊቆ ሊኑዋፐ ዳዲደ፥ ኩሽያ ሂላን አሌቂሲደ፥ ዳንጩዋ ጊግሴድኖ።<verse eid="EXO 39:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 39:30"/>ኡንቱንቱ ጌሻ አለቁዋ ምስልያ ዋላካይ ባይና ዎርቃፐ መደ፥ ማታፋ ቦላ ዎጭያዋዳን፥ አ ቦላ፥ “መና ጎዳዉ ጌሻ ግዲደ ዱማቴዳ” ያግያዋ ዎጪደ ጻፌድኖ። <verse eid="EXO 39:30"/><verse number="31" style="v" sid="EXO 39:31"/>ሄዋፐ ጉይያን ሁጲያን ሻሽያፐ ጻደን ቃቻናዳን፥ መና ጎዳይ ሙሳ አዛዜዳዋዳን ሳሉዋ ማላትያ ባቀ አን አደ ቃቼድኖ።<verse eid="EXO 39:31"/></para>
  <para style="s1">ሙሴ ኦሱዋ ኡባ ጾሞሴዳ</para>
  <para style="r">(<ref loc="EXO 35:10-19">35:10-19</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="EXO 39:32"/>ጾሳ ዱንካንያ ኪታይ ኡባይ ፖለቴዳ። እስራኤላቱ ኡባባካ መና ጎዳይ ሙሳ አዛዜዳዋዳን ኦድኖ። <verse eid="EXO 39:32"/><verse number="33" style="v" sid="EXO 39:33"/>ሄዋፐ ጉይያን ኡንቱንቱ ጾሳ ዱንካንያ ሙሴኮ አሄድኖ፤ ሄዌካ: ዱንካንያነ አ ሚሻ ኡባ፥ ጋ ኦይያዋ፥ ጻጋገቱዋ፥ ሽካላቱዋነ፥ ቱሳቱ ኤቂያ ሳጽነቱዋ፥ <verse eid="EXO 39:33"/><verse number="34" style="v" sid="EXO 39:34"/>ቦላ ካማደ ዶርሳ ኦርግያ ጋልባ ዞኦ ቃላምያን የግ ከሴዳዋ፥ ሀራ ጋልባፐ መዳ ቁምእያ፥ ታቦታ ገንያ ጋርዱዋ፥ <verse eid="EXO 39:34"/><verse number="35" style="v" sid="EXO 39:35"/>ቃላ ጫቁዋ ታቦታ፥ አ ቶክያ ካሶቱዋነ አቶ ግያ ሳኣ ቁምእያ፥ <verse eid="EXO 39:35"/><verse number="36" style="v" sid="EXO 39:36"/>ጻርጴዛነ አ ሚሻ ኡባ ጾሳ ስንን ዎያ ጌሻ ኡክ፥ <verse eid="EXO 39:36"/><verse number="37" style="v" sid="EXO 39:37"/>ዋላካይ ባይና ዎርቃፐ ኦሰቴዳ ጾምፕያ ዎያ ባላነ አን ማራን ደእያ ጾምፐቱዋ፥ ኡንቱንቱ ሚሻቱዋ ኡባነ ጾምፕያ ዛይትያ፥ <verse eid="EXO 39:37"/><verse number="38" style="v" sid="EXO 39:38"/>እጻና ጩዋይያ ዎርቃ ሳጽንያ፥ ኦከትያ ዛይትያ፥ ሳዊያ እጻና፥ ጾሳ ዱንካንያ ፐንግያ ጋርዱዋ፥ <verse eid="EXO 39:38"/><verse number="39" style="v" sid="EXO 39:39"/>ናሃስያፐ ኦዳ ያርሽያ ሳኣ፥ አ ናሃስያ ዛዝሪያና፥ አ ቶክያ ካሱዋ፥ አ ሚሻቱዋ ኡባ፥ ሜቻ ከርያነ አ ዎያዋ፥ <verse eid="EXO 39:39"/><verse number="40" style="v" sid="EXO 39:40"/>ዳባባ ገንያ ጋርዳቱዋ፥ አ ቱሳቱዋ፥ ኡንቱንቱ ኤቂያ ሳጽነቱዋ፥ ዳባባ ገልያ ፐንገቱዋ ጋርዱዋ፥ ዳባባ ዎዶሮቱዋነ ሽካላቱዋ፥ ጾሳ ዱንካንያ መናዉ ኮሽያ ሚሻቱዋ ኡባ፤ <verse eid="EXO 39:40"/><verse number="41" style="v" sid="EXO 39:41"/>ቄሳቱ ጌሻ ሳኣን ኦደ ጎኤታናዉ ዳደቴዳ ማዮቱዋ፥ አሮነ ጌሻ ማዩዋነ አ ናናይ ቄሳተ ኦደ ማይያ ማዮቱዋ።<verse eid="EXO 39:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="EXO 39:42"/>እስራኤላቱ ኦሱዋ ኡባካ መና ጎዳይ ሙሳ አዛዜዳዋዳን ኡባባ ኦድኖ። <verse eid="EXO 39:42"/><verse number="43" style="v" sid="EXO 39:43"/>ሙሴ ኦሱዋ ኡባ ጾሞስ ጼሊደ፥ ኡንቱንቱ መና ጎዳይ አዛዜዳዋዳን ኦዳዋ በኤዳ። ሄዋ ድራዉ፥ ሙሴ ኡንቱንታ አንጄዳ።<verse eid="EXO 39:43"/></para>
  <chapter eid="EXO 39"/>
  <chapter number="40" style="c" sid="EXO 40"/>
  <para style="s1">ጾሳ ዱንካንያ ቶከ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 40:1"/>ሄዋፐ ጉይያን መና ጎዳይ ሙሳ፥ <verse eid="EXO 40:1"/><verse number="2" style="v" sid="EXO 40:2"/>“ኮይሮ አግናዉ ኮይሮ ጋላስ፥ ኔን መና ጎዳ ዱንካንያ ቶካ። <verse eid="EXO 40:2"/><verse number="3" style="v" sid="EXO 40:3"/>ቃላ ጫቁዋ ታቦታ አ ግዶን ዎ፤ ሄ ታቦታ ጋርዱዋን ካማ። <verse eid="EXO 40:3"/><verse number="4" style="v" sid="EXO 40:4"/>ጻርጴዛ ገልሳደ፥ አ ቦላ ዎናዉ ኮሽያባ ኡባ ጊግሳደ አ ቦላ ዎ። ያታደ ጾምፐቱዋ ዎያ ባላ ሶ ገልሳደ፥ አ ቦላ ጾምፐቱዋ ኤ። <verse eid="EXO 40:4"/><verse number="5" style="v" sid="EXO 40:5"/>እጻና ጩዋይያ ዎርቃ ሳጽንያ ቃላ ጫቁዋ ታቦታፐ ስንና ዎደ፥ ጾሳ ዱንካንያ ገልያ ጋርዱዋ ሶታ።<verse eid="EXO 40:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 40:6"/>“ጹግያ ያርሹዋ ያርሽያ ሳኣ ጾሳ ዱንካንያፐ ስንና ዎ። <verse eid="EXO 40:6"/><verse number="7" style="v" sid="EXO 40:7"/>ሜቻ ከርያ ጾሳ ዱንካንያፐነ ያርሽያ ሳኣፐ ግዱዋን ዎደ፥ አን ሃ ትጋ። <verse eid="EXO 40:7"/><verse number="8" style="v" sid="EXO 40:8"/>ጾሳ ዱንካንያፐ ካረና ዩሻ አደ ዳባባ ጊግሳደ ዳባባ ገልያ ሳኣን ጋርዱዋ ሶታ።<verse eid="EXO 40:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 40:9"/>“ኦክያ ዛይትያ አካደ፥ ጾሳ ዱንካንያነ አ ግዶን ደእያ ኡባባ ኦካ፤ አነ አ ግዶን ጎኤትያ ሚሻ ኡባ ዱማያ፤ ያቶፐ እ ጌሻ ግዳናዋ። <verse eid="EXO 40:9"/><verse number="10" style="v" sid="EXO 40:10"/>ሄዋፐ ጉይያን ጹግያ ያርሹዋ ያርሽያ ሳኣነ አዉ ጎኤትያ ሚሻ ኡባ ኦካ፤ ያርሽያ ሳኣ ዱማያ፤ ያቶፐ እ ኡባፐ አያ ጌሻ ግዳናዋ። <verse eid="EXO 40:10"/><verse number="11" style="v" sid="EXO 40:11"/>ሜቻ ከርያነ አ ኡትስያ ሚሻ ኦካደ ኡንቱንታ ዱማያ።<verse eid="EXO 40:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 40:12"/>“ኔን አሮናነ አ ናና ጾሳ ዱንካንያ ገልያ ፐንገ አሃደ፥ ሃን ኡንቱንታ ሜጫ። <verse eid="EXO 40:12"/><verse number="13" style="v" sid="EXO 40:13"/>ሄዋፐ ጉይያን ቄሰተ ጌሻ ማዩዋ አሮና ማይዛደ፥ እ ታዉ ቄሰተን ኦናዳን፥ አ ኦካደ ዱማያ። <verse eid="EXO 40:13"/><verse number="14" style="v" sid="EXO 40:14"/>አ አቱማ ናናካ አሃደ ሻምጭያ ማይዛ። <verse eid="EXO 40:14"/><verse number="15" style="v" sid="EXO 40:15"/>ኡንቱንቱ ታዉ ቄሰተን ኦናዳን፥ ኡንቱንቱ አዉዋ ኦኬዳዋዳን፥ ኡንቱንታካ ኦካ። ኡንቱንቱ ኦካይ ኡንቱንታካ ኡንቱንቱ ስን የለታ ኡባ ቄሳቱዋ ኦያዋ” ያጌዳ።<verse eid="EXO 40:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 40:16"/>ሙሴ ኡባባካ ጾሳይ ባረና አዛዜዳዋዳን ኦዳ።<verse eid="EXO 40:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 40:17"/>ሄዋ ድራዉ፥ ግብጼፐ ኡንቱንቱ ከሴዳ ላኤን ላይን፥ ኮይሮ አግናዉ ኮይሮ ጋላሳን ጾሳ ዱንካኒ ቶኬቴዳ። <verse eid="EXO 40:17"/><verse number="18" style="v" sid="EXO 40:18"/>ሙሴ ጾሳ ዱንካንያ ኤስያ ዎደ፥ ሳጽነቱዋ ኡንቱንቱ ሳኣን ሳኣን ዎዳ፤ ጻጋገቱዋነ ቱሳ አዳ፤ ሽካላቱዋካ ገልሴዳ። <verse eid="EXO 40:18"/><verse number="19" style="v" sid="EXO 40:19"/>ሄዋፐ ጉየ ሙሴ መና ጎዳይ አዛዜዳዋዳን፥ ሀ ኤሴዳዋ ቦላን ዱንካንያ ጌዳ፤ ሄ ኤሱዋ ቦላን ካሙዋ ካሜዳ።<verse eid="EXO 40:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 40:20"/>ያቲደ ታሙ አዛዛቱ ጻፈቴዳ ማርካተ ቃላ አፊደ፥ ታቦታ ግዶን ዎዳ፤ ቶክያ ካሱዋ ታቦታን አዳ፤ አቶ ግያ ሳኣ ቁምእያ ታቦታ ቦላ ዎዳ። <verse eid="EXO 40:20"/><verse number="21" style="v" sid="EXO 40:21"/>ሄዋፐ ጉይያን ታቦታ ጾሳ ዱንካንያ ገልሴዳ፤ ገንያ ጋርዱዋ ሶቲደ፥ መና ጎዳይ አዛዜዳዋዳን ቃላ ጫቁዋ ታቦታ ካሜዳ።<verse eid="EXO 40:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 40:22"/>መና ጎዳይ ሙሳ አዛዜዳዋዳን፥ ሙሴ ጻርጴዛ መና ጎዳ ዱንካንያን ገልሲደ፥ ጋርዱዋፐ ካረና ሁጲሳ ባጋና ዎዳ። <verse eid="EXO 40:22"/><verse number="23" style="v" sid="EXO 40:23"/>አ ቦላ መና ጎዳ ስንን ዎያ ጌሻ ኡክ ጊግሴዳ።<verse eid="EXO 40:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 40:24"/>መና ጎዳይ ሙሳ አዛዜዳዋዳን፥ ጾምፕያ ዎያ ባላ ጾሳ ዱንካንያ ግዶ ገልሲደ፥ ጻርጴዛ ሄፍንና፥ ጾሳ ዱንካንያዉ ገድሳ ባጋና ዎዳ፤ <verse eid="EXO 40:24"/><verse number="25" style="v" sid="EXO 40:25"/>ቃይ ጾምፐቱዋ መና ጎዳ ስንን ኦይዳ።<verse eid="EXO 40:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 40:26"/>መና ጎዳይ አዛዜዳዋዳን፥ እጻና ጩዋይያ ዎርቃ ሳጽንያ ጾሳ ዱንካንያ ግዶን ጋርዱዋ ስን ባጋና ዎዳ፤ <verse eid="EXO 40:26"/><verse number="27" style="v" sid="EXO 40:27"/>አ ቦላ ሳዊያ እጻና ጩዋዬዳ። <verse eid="EXO 40:27"/><verse number="28" style="v" sid="EXO 40:28"/>ሄዋፐ ጉይያን ጾሳ ዱንካንያ ፐንግያን ጋርዱዋ ሶቴዳ።<verse eid="EXO 40:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 40:29"/>ጹግያ ያርሹዋ ያርሽያ ሳኣ ጾሳ ዱንካንያ ገልያ ፐንግያ ምይያን ዎዳ፤ አ ቦላ ጹግያ ያርሹዋነ ካ ያርሹዋ መና ጎዳይ አዛዜዳዋዳን ያርሼዳ።<verse eid="EXO 40:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 40:30"/>ጾሳይ ሙሳ አዛዜዳዋዳን፥ ሜቻ ከርያ ጾሳ ዱንካንያፐነ ያርሽያ ሳኣፐ ግዱዋን ዎዳ። ያቲደ ሜጨታናዉ ሃ አን ትጌዳ። <verse eid="EXO 40:30"/><verse number="31" style="v" sid="EXO 40:31"/>ሙሴ፥ አሮነነ አ ናናይ ባረንቱ ኩሽያነ ገድያ አን ሜጨቲኖ። <verse eid="EXO 40:31"/><verse number="32" style="v" sid="EXO 40:32"/>መና ጎዳይ ሙሳ አዛዜዳዋዳን፥ ኡንቱንቱ ጾሳ ዱንካንያ ገሌዳ ዎደ ዎይ ያርሽያ ሳኣኮ ሺቄዳ ዎደ አዉደነ ሜጨቲኖ።<verse eid="EXO 40:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 40:33"/>ጾሳ ዱንካንያነ ያርሽያ ሳኣ ዩሽ አደ ዳባባ ከሴዳ፤ ሄ ዳባባ ፐንግያን ጋርዱዋ ሶቴዳ። ሄዋዳን ኦደ፥ ሙሴ ኦሱዋ ፖሌዳ።<verse eid="EXO 40:33"/></para>
  <para style="s1">ጾሳ ቦንቹ ጾሳ ዱንካንያ ኩሜዳ</para>
  <para style="r">(<ref loc="NUM 9:15-23">ፓይ. 9:15-23</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 40:34"/>ሄዋፐ ጉይያን ሻሪ ጾሳ ዱንካንያ ካሜዳ፤ መና ጎዳ ቦንቹካ አ ኩሜዳ።<note caller="-" style="x"><char style="xo" closed="false">40:34 </char><char style="xt" closed="false"><ref loc="1KI 8:10-11">1 ካታ. 8:10-11</ref>፤ <ref loc="ISA 6:4">ኢሳ. 6:4</ref>፤ <ref loc="EZK 43:4-5">ህዝ. 43:4-5</ref>፤ <ref loc="REV 15:8">ሳፃ 15:8</ref></char></note> <verse eid="EXO 40:34"/><verse number="35" style="v" sid="EXO 40:35"/>ሻሪ ጾሳ ዱንካንያ ቦላ ኡቴዳ ድራዉነ መና ጎዳ ቦንቹ አ ግዶን ኩሜዳ ድራዉ፥ ሙሴ አ ግዶ ገላናዉ ዳንዳይቤና።<verse eid="EXO 40:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 40:36"/>እስራኤላቱ ባረንቱ ኦግያ ኡባን፥ ሄ ሻሪ ጾሳ ዱንካንያፐ ደንድያ ዎደ አዉደነ አ ካሊደ ሀመታ ዶምኖ። <verse eid="EXO 40:36"/><verse number="37" style="v" sid="EXO 40:37"/>ሽን ሄ ሻሪ ደንዳና ዮፐ፥ እ ደንድያ ጋላሳይ ጋካናዉ ኡንቱንቱካ ቃጽክኖ። <verse eid="EXO 40:37"/><verse number="38" style="v" sid="EXO 40:38"/>ኡንቱንቱ ኦግያ ኡባን መና ጎዳ ሻሪ እስራኤልያ አሳይ ኡባይ በእሽን፥ ጋላስ ጋላስ ጾሳ ዱንካንያ ካሜነ ቃማ ቃማ ቃይ ታማይ ሄ ሻርያ ግዶን ኤጼ።<verse eid="EXO 40:38"/></para>
  <chapter eid="EXO 40"/>
</usx>
