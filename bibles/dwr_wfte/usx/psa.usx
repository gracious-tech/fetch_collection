<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- Dawuro Full Bible Ethiopic Version</book>
  <para style="h">ማዝሙርያ</para>
  <para style="toc1">ማዝሙርያ ማጻፋ</para>
  <para style="toc2">ማዝሙርያ</para>
  <para style="toc3">ማዝ.</para>
  <para style="mt1">ማዝሙርያ ማጻፋ</para>
  <para style="imt">ገሉዋ</para>
  <para style="ip">ዳዊታ ማዝሙሪ (ማዝሙርያ ማጻፋይ) ጌሻ ማጻፋ ግዶን ማዝሙርያነ ዎሳ ማጻፋ ግዲደ ኤረቴ። ሀ ማጻፋ ጊግሴዳዋንቱ አዱሳ ዎደቱዋ ግዶን ቤቴዳ ዱማ ዱማ አሳቱዋ። እት እት ማዝሙረቱዋ ካቲ ዳውት ጻፌዳዌ አማነቴ። ሀ ማዝሙረቱዋነ ሀ ዎሳቱዋ ሺሺደ፥ ባረንቱ ጎይኑዋ ዎድያን ጎኤቲድ ጋምኤዳዋንቱ እስራኤልያ አሳቱዋ። ጉየፐ ጋምኢደ ባረንቱ ጌሻ ማጻፋቱዋ ግዶን ገልሴድኖ።</para>
  <para style="ip">ሀዋንቱ አያናፐ ጻፈቴዳ ግንጻቱ ጮራ ቆሞ፤ ኡንቱንቱካ ጋላትያነ ጾሳዉ ጎይንያ ግንጻቱዋ፥ ጾሳይ ማዳና ማላ፥ ናጋና ማላነ ሳሮ ዎና ማላ ዎስያ ዎሳቱዋ፥ ናጋራፐ ማረታናዉ ሺሽያ ዎሳቱዋ፥ ጾሳ አንጁዋባ ኦድያ ጋላታ ሳባቱዋነ ሞርከቱዋ ሙራና ማላ ጾሳዉ ኦድያ ማጋናቱዋ። ሀ ዎሳቱ እት ኡራይ ባረካ ዎሴዳ ዎሳቱዋነ ጮራ አሳይ እትፐ ዎሴዳ ዎሳቱዋ። ኡንቱንቱፐ እቱ እቱ እት ኡራ ዎዛናን ስሰቴዳ ሴላ ቆንጭስያዋንታ። ሀራቱ ቃይ ጾሳ አሳይ ኡባይ ኮይያዋነ አሳዉ ኡባዉ ስሰትያ ሀኖታቱዋ በስያዋንታ።</para>
  <para style="ip">የሱስ ታማርሲደ ማዝሙርያ ማጻፋፐ ቦች ቦች አኪደ ታማርሴዳ። ኦራ ጫቁዋ ጻፌዳዋንቱካ አን ጻፈቴዳዋፐ ባረንቱ ጻፍያ ማጻፋ ግዶ ገልሴድኖ። ዎሳ ጎላታ ኤቆደፐ ዶማደ፥ ማዝሙርያ ማጻፋ ጎይኑዋ ዎጋዉ ጎኤትያ ዎልቃማ ምንጁዋባዳን ፓይዳዉ።</para>
  <para style="iot">ሸምፓቱዋ ኡባቶ እመቴዳ ቃን ቆፋቱዋ</para>
  <para style="io1">1. ኮይሮ ማጻፋ <char style="ior"><ref loc="PSA 1-41">ማዝ. 1—41</ref></char></para>
  <para style="io1">2. ላኤን ማጻፋ <char style="ior"><ref loc="PSA 42-72">ማዝ. 42—72</ref> </char></para>
  <para style="io1">3. ሄዘን ማጻፋ <char style="ior"><ref loc="PSA 73-89">ማዝ. 73—89</ref> </char></para>
  <para style="io1">4. ኦይደን ማጻፋ <char style="ior"><ref loc="PSA 90-106">ማዝ. 90—106</ref></char></para>
  <para style="io1">5. እቼሸን ማጻፋ <char style="ior"><ref loc="PSA 107-150">ማዝ. 107—150</ref></char></para>
  <chapter number="1" style="c" sid="PSA 1"/>
  <para style="ms">ኮይሮ ማጻፋ</para>
  <para style="mr">(<ref loc="PSA 1-41">1—41</ref>)</para>
  <para style="s1">ሎኦ አሳነ ኢታ አሳ ሀመታ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1"/>ኢታቱዋ ዞርያን ቤናዌ፥</para>
  <para style="q2" vid="PSA 1:1">ዎይ ናጋራንቻቱዋ ኦግያን ኤቀናዌ፥</para>
  <para style="q3" vid="PSA 1:1">ቅሊጭያዋንቱ ሺቁዋን ኡተናዌ፥</para>
  <para style="q3" vid="PSA 1:1">ሄዌ አንጀቴዳዋ።<verse eid="PSA 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2"/>ሽን መና ጎዳ ህግያን እ ናሸቴ፤</para>
  <para style="q2" vid="PSA 1:2">አ ህግያ ጋላስነ ቃማ ቆፔ።<verse eid="PSA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3"/>ሄዌ ጎግያ ሃ ጻጱዋን ቶከቲደ፥<note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="JER 17:8">ኤር. 17:8</ref></char></note></para>
  <para style="q2" vid="PSA 1:3">አይፍያ አግናን አይፍያ፥</para>
  <para style="q2" vid="PSA 1:3">ባረ ሀይካ ቆቆፈና ም ማላ።</para>
  <para style="q2" vid="PSA 1:3">እ ኦያ ኡባይ አዉ ሀኔ።<verse eid="PSA 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4"/>ሽን ኢታቱ ሄዋ ማላ ግድክኖ፤</para>
  <para style="q2" vid="PSA 1:4">ጫርኩ ፕት አፍያ ሱላ ማላ።<verse eid="PSA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5"/>ሄዋ ድራዉ፥ ኢታቱዋ ቦላ ጾሳይ ፕርዳና፤</para>
  <para style="q2" vid="PSA 1:5">ናጋራንቻቱካ ጽሎቱዋ ሺቁዋን ኤቂክኖ።<verse eid="PSA 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6"/>አያዉ ጎፐ፥ መና ጎዳይ ጽሎቱዋ ኦግያ ኤሬ፤</para>
  <para style="q2" vid="PSA 1:6">ሽን ኢታቱዋ ኦጊ ያና።<verse eid="PSA 1:6"/></para>
  <chapter eid="PSA 1"/>
  <chapter number="2" style="c" sid="PSA 2"/>
  <para style="s1">ጾሳን ዶረቴዳ ካትያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1"/>አማነናዋንቱ አያዉ ደንዲኖ?<note caller="-" style="x"><char style="xo" closed="false">2:1-2 </char><char style="xt" closed="false"><ref loc="ACT 4:25-26">ኪታ 4:25-26</ref></char></note></para>
  <para style="q2" vid="PSA 2:1">ቃይ ካዉተቱ አያዉ ፓናባ ማቀቲኖ?<verse eid="PSA 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2"/>ሳኣ ካተቱ ደንዴድኖ፤</para>
  <para style="q2" vid="PSA 2:2">አሳ ሞድያዋንቱ እትፐ ሺቄድኖ።</para>
  <para style="q2" vid="PSA 2:2">ኡንቱንቱ መና ጎዳ ቦላነ</para>
  <para style="q2" vid="PSA 2:2">እ ኦኬዳዋ ቦላ እትፐ ሺቄድኖ።<verse eid="PSA 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3"/>ኡንቱንቱ፥ “ኑን ኡንቱንቱ ሳንሳላታ ዱይተ፤</para>
  <para style="q2" vid="PSA 2:3">ኡንቱንቱ ኑና ቃችያዋካ ዎራ ኦሎይተ” ያጊኖ።<verse eid="PSA 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4"/>ሳሉዋን ባረ አራታን ኡቴዳዌ</para>
  <para style="q2" vid="PSA 2:4">ኡንቱንቱ ቦላ ሚጬ፤</para>
  <para style="q1" vid="PSA 2:4">ጎዳይ ኡንቱንቱ ቦላ ቅሊጬ።<verse eid="PSA 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5"/>እ ባረ ሀንቁዋን ኡንቱንታ ሴሬ፤</para>
  <para style="q2" vid="PSA 2:5">ባረ ዎልቃማ ሀንቁዋን ኡንቱንታ ያሽሴ።<verse eid="PSA 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6"/>ጎዳይ፥ “ታን ታ ጌሻ ደርያ ጽዮነ ቦላ</para>
  <para style="q2" vid="PSA 2:6">ታ ካትያ ካዉድ” ያጌ።<verse eid="PSA 2:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 2:7"/>ሄ ካቲ፥ “ታን መና ጎዳ ህግያ አዋያና፤<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="ACT 13:37">ኪታ 13:37</ref>፤ <ref loc="HEB 1:5">እብራ. 1:5</ref>፤ <ref loc="HEB 5:5">5:5</ref></char></note></para>
  <para style="q2" vid="PSA 2:7">እ ታና፥ ‘ኔን ታ ናኣ፤</para>
  <para style="q2" vid="PSA 2:7">ታን ሀች ነዉ አዉዋ ግዳድ።<verse eid="PSA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8"/>ኔን ታና ኦቻ፤</para>
  <para style="q2" vid="PSA 2:8">ታን ካዉተ ኡባ ነዉ እማና፤</para>
  <para style="q2" vid="PSA 2:8">ሳኣ ኡባይ ነባ ግዳናዋ።<verse eid="PSA 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9"/>ኔን ብራታ ጻምአን ኡንቱንታ መንሬና፤<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="REV 2:26-27">ሳፃ 2:26-27</ref>፤ <ref loc="REV 12:5">12:5</ref>፤ <ref loc="REV 19:15">19:15</ref></char></note></para>
  <para style="q2" vid="PSA 2:9">ኡንቱንታ ኔን ኡርቃ ሚሻ መንያዋዳን ሊቅሳና’ ያጌ” ያጌዳ።<verse eid="PSA 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10"/>ሄዋ ድራዉ፥ ህንተኖ ካተቶ፥ ኤያቶፕተ፤</para>
  <para style="q2" vid="PSA 2:10">ሀ ሳኣ ሞድያዋንቶ፥ ህንተና ናግተ!<verse eid="PSA 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11"/>መና ጎዳዉ ያሻተን ኦተ፤</para>
  <para style="q2" vid="PSA 2:11">ኮኮርሳን አዛዘትተ።<verse eid="PSA 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12"/>ጾሳይ ሀንቀትና፥ ኦግያን ህንተ የናዳን ሱረ ዎዛናን አዉ ጎይንተ፤</para>
  <para style="q2" vid="PSA 2:12">አያዉ ጎፐ፥ አ ሀንቁ ኤለካ ኤጽ ከሳና።</para>
  <para style="q1" vid="PSA 2:12">ባቃት አን ቆሰት አትያ ኡባቱ አንጀቴዳዋንታ።<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="2SA 15:13-17:22">2 ሳሜላ 15:13—17:22</ref></char></note><verse eid="PSA 2:12"/></para>
  <chapter eid="PSA 2"/>
  <chapter number="3" style="c" sid="PSA 3"/>
  <para style="d">ባረ ናኣ አበሰሎማፐ ባቃቴዳ ዎደ ዳዊታ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1"/>አቤት መና ጎዳዉ፥ ታ ሞርከቱ አያ ጮራቴድኖ!</para>
  <para style="q2" vid="PSA 3:1">ታ ቦላ አፑናቱ ደንዲኖ!<verse eid="PSA 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2"/>ዳሮቱ፥ “ጾሳይ አ አሸና” ያጊደ</para>
  <para style="q2" vid="PSA 3:2">ታዋ ሃሳዪኖ።<verse eid="PSA 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3"/>ሽን አቤት መና ጎዳዉ፥ ኔን ታ ዩሹዋን ጎንዳለ።</para>
  <para style="q2" vid="PSA 3:3">ታና ቦንችስያዌነ ታ ሱን ቁ ኦያዌ ኔናቴ።<verse eid="PSA 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4"/>ታን ታ ቃላ ቂሳደ መና ጎዳኮ ዋሳይ።</para>
  <para style="q2" vid="PSA 3:4">ባረ ጌሻ ደርያፐ ታዉ እ ዛሬ።<verse eid="PSA 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5"/>መና ጎዳይ ታና ናግያ ድራዉ፥</para>
  <para style="q2" vid="PSA 3:5">ታን ግሳደ ገምእሻይነ ቤጎታይ።<verse eid="PSA 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6"/>ታን ታና ዶዲደ ደንዴዳ፥</para>
  <para style="q2" vid="PSA 3:6">ታሙ ሻኣ አሳቶካ ያይከ።<verse eid="PSA 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7"/>አቤት መና ጎዳዉ፥ ደንዳ!</para>
  <para style="q2" vid="PSA 3:7">አቤት ታ ጾሳዉ፥ ታና አሻ!</para>
  <para style="q1" vid="PSA 3:7">አያዉ ጎፐ፥ ኔን ታ ሞርከቱዋ ኡባ ጎጎጩዋ ሾጫዳ፤</para>
  <para style="q2" vid="PSA 3:7">ኢታቱዋ አቻካ መንዳ።<verse eid="PSA 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8"/>አሹ ጾሳዋ፤</para>
  <para style="q2" vid="PSA 3:8">ጾሳዉ፥ ነ አሳ ኔን አንጃ።<verse eid="PSA 3:8"/></para>
  <chapter eid="PSA 3"/>
  <chapter number="4" style="c" sid="PSA 4"/>
  <para style="s1">ማዶ ኦማርስ ሺቅያ ዎሳ</para>
  <para style="d">ዛማረቱዋ ካፖ ዲቱዋን የጸቴዳ፥ ዳዊታ ማዝሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 4:1"/>አቤት ታና ጽልስያ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 4:1">ታን ኔና ጼስያ ዎደ፥ ታዉ ኮያ።</para>
  <para style="q3" vid="PSA 4:1">ታን ኡንኤቴዳ ዎደ፥ ታና ሸምፕሳዳ።</para>
  <para style="q3" vid="PSA 4:1">ታዉ ኔን ቃረታደ ታ ዎሳ ስሳ።<verse eid="PSA 4:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2"/>ህንተኖ አሳቶ፥ አዉደ ጋካናዉ ታ ቦንቹዋ ካዉሺቴ?</para>
  <para style="q2" vid="PSA 4:2">ሾር ባይናባካ አዉደ ጋካናዉ ህንተ ሲቂቴ?</para>
  <para style="q1" vid="PSA 4:2">ዎርዱዋ አዉደ ጋካናዉ ጫድ ኦይቂ ካሊቴ?<verse eid="PSA 4:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3"/>ሽን መና ጎዳይ ጾሳ አሳቱዋ</para>
  <para style="q2" vid="PSA 4:3">ባረዉ ዱማይ ዎዳዋ ህንተ ኤርተ።</para>
  <para style="q1" vid="PSA 4:3">ታን መና ጎዳ ጼስያ ዎደ፥</para>
  <para style="q2" vid="PSA 4:3">እ ታዉ ስሴ።<verse eid="PSA 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4"/>ሀንቀትተ፥ ሽን ህንተ ሀንቁዋን ናጋራ ኦፕተ።<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="EPH 4:26">ኤፈ. 4:26</ref></char></note></para>
  <para style="q2" vid="PSA 4:4">ሂጻን ግስያ ዎደ፥</para>
  <para style="q2" vid="PSA 4:4">ህንተ ዎዛና ብድተነ ስርጵ ጊተ።<verse eid="PSA 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5"/>ልከ ያርሹዋ ያርሽተነ</para>
  <para style="q2" vid="PSA 4:5">መና ጎዳን አማነትተ።<verse eid="PSA 4:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6"/>ዳሮቱ፥ “ኑና ሎኦባ በሳናዌ ኦኔ?” ያጊኖ።</para>
  <para style="q2" vid="PSA 4:6">አቤት መና ጎዳዉ፥ ኔን ኑና ኬካ አይፍያን ጼላ።<verse eid="PSA 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7"/>ኔን ታ ዎዛናን ዎልቃማ ናሸቻ ኩንዳ።</para>
  <para style="q2" vid="PSA 4:7">ሄዌነ፥ ካ አይፊነ ኦራ ዎይንያ ኤሳይ፥</para>
  <para style="q2" vid="PSA 4:7">ባረንቶ ዳርና ናሸትያ ናሸቻፐካ ዳርያዋ።<verse eid="PSA 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8"/>አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 4:8">ነ ጻላላይ ታና ሳሩዋን ናጋ ዎያ ድራዉ፥</para>
  <para style="q2" vid="PSA 4:8">ታን ግሳደ ሳሮተን ገምእሻይ።<verse eid="PSA 4:8"/></para>
  <chapter eid="PSA 4"/>
  <chapter number="5" style="c" sid="PSA 5"/>
  <para style="s1">ዎንታ ዎሳ</para>
  <para style="d">ዛማረቱዋ ካፖ ሱሱላቱዋን የጸቴዳ፥ ዳዊታ ማዝሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 5:1"/>አቤት መና ጎዳዉ፥ ታን ኦድያዋ ሀይዛ፤</para>
  <para style="q2" vid="PSA 5:1">ታ ኦልያነ ስሳ።<verse eid="PSA 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2"/>ታ ካትያዉነ ታ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 5:2">ታና ማዳ ጋደ ታ ኔኮ ዋስይያ ድራዉ፥</para>
  <para style="q2" vid="PSA 5:2">ታ ዎሳ ስሳ።<verse eid="PSA 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3"/>አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 5:3">ዎንታ ዎንታ ጉራን ኔን ታ ቃላ ስሳሳ።</para>
  <para style="q1" vid="PSA 5:3">ዎንታ ዎንታ ጉራን ታን ታ ዎሳ ነ ስን ሺሻደ፥</para>
  <para style="q2" vid="PSA 5:3">ኔን ታዉ እምያ ዛሩዋ አካና ጋደ ናጋይ።<verse eid="PSA 5:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4"/>ኔን ኢታተን ናሸተና ጾሳ፤</para>
  <para style="q2" vid="PSA 5:4">ኢታባይ ኔናና ደኤና።<verse eid="PSA 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5"/>ጬቀትያዋንቱ ነ ስንን ኤቂክኖ፤</para>
  <para style="q2" vid="PSA 5:5">ኢታባ ኦያ ኡባቱዋ ኔን እጻ።<verse eid="PSA 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 5:6"/>ዎርዱዋ ሃሳይያዋንታካ ኔን ይሳሳ።</para>
  <para style="q2" vid="PSA 5:6">ሱ ጉስያዋንታነ ጭምያ አሳቱዋ፥</para>
  <para style="q1" vid="PSA 5:6">ጾሳይ ሸነቴ።<verse eid="PSA 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7"/>ሽን ታን ነ ማሮታ ዳሩዋን</para>
  <para style="q2" vid="PSA 5:7">ነ ጎልያ ገላና።</para>
  <para style="q1" vid="PSA 5:7">ነ ጌሻ ጎልያኮ ስማደ፥</para>
  <para style="q2" vid="PSA 5:7">ነዉ ያሻተን ጎይናና።<verse eid="PSA 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8"/>አቤት መና ጎዳዉ፥ ታና ነ ጽሎተን ካለ፤</para>
  <para style="q2" vid="PSA 5:8">ታ ሞርከቱዋ ድራዉ ጋደ፥</para>
  <para style="q2" vid="PSA 5:8">ነ ኦግያ ታ ስንን ሱርሳ።<verse eid="PSA 5:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9"/>ኡንቱንቱ ዶናፐ ከስያዌ አማንና።<note caller="-" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="ROM 3:13">ሮመ 3:13</ref></char></note></para>
  <para style="q2" vid="PSA 5:9">ኡንቱንቱ ዎዛናንካ ገኒ ኩሜዳ፤</para>
  <para style="q2" vid="PSA 5:9">ኡንቱንቱ ዶናይ ዶየቴዳ ዱፉዋ ማላ፤</para>
  <para style="q2" vid="PSA 5:9">ኡንቱንቱ ባረንቱ እንጻርሳን ጭሚኖ።<verse eid="PSA 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10"/>አቤት ጾሳዉ፥ ኡንቱንታ ኔን ፕርዳ፤</para>
  <para style="q2" vid="PSA 5:10">ኡንቱንቱ ኮባይ ኡንቱንታ አክ ቦ።</para>
  <para style="q1" vid="PSA 5:10">ኡንቱንቱ ናጋራይ ዳሮ ግዴዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 5:10">ኔን ኡንቱንታ የደርሳ፤</para>
  <para style="q2" vid="PSA 5:10">አያዉ ጎፐ፥ ኡንቱንቱ ነ ቦላ ማካሌድኖ።<verse eid="PSA 5:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11"/>ሽን ኔኮ ባቃት ቆሰት አትያ ኡባይ ናሸትኖ፤</para>
  <para style="q2" vid="PSA 5:11">ኡንቱንቱ ኡባ ገደ ናሸቻን የጽኖ።</para>
  <para style="q1" vid="PSA 5:11">ኔንካ ኡንቱንታ ናጋና፤</para>
  <para style="q2" vid="PSA 5:11">ነ ሱን ሲቅያ ኡባቱ ኔናን ሎይ ናሸትኖ።<verse eid="PSA 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12"/>አያዉ ጎፐ፥ አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 5:12">ቱሙካ ኔን ጽሉዋ አንጃሳ።</para>
  <para style="q1" vid="PSA 5:12">ኔን ጎንዳሊ ካምያዋዳን ነ ኬካተን አ ካማሳ።<verse eid="PSA 5:12"/></para>
  <chapter eid="PSA 5"/>
  <chapter number="6" style="c" sid="PSA 6"/>
  <para style="s1">ኡንኦ ዎድያን ሺቄዳ ዎሳ</para>
  <para style="d">ዛማረቱዋ ካፖ ዲቱዋን የጸቴዳ፥ ዳዊታ ማዝሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1"/>አቤት መና ጎዳዉ፥ ነ ሀንቁዋን ታና ሴሮፓርኪ፤<note caller="-" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="PSA 38:1">ማዝ. 38:1</ref></char></note></para>
  <para style="q2" vid="PSA 6:1">ዎይ ነ ይሉዋን ታና ሙሮፓርኪ።<verse eid="PSA 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2"/>አቤት መና ጎዳዉ፥ ታን ላባኔዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 6:2">ታና ማራርኪ።</para>
  <para style="q1" vid="PSA 6:2">አቤት መና ጎዳዉ፥ ታ ዎዛናይ ማዱጾ ድራዉ፥ ታና ፓ።<verse eid="PSA 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3"/>ታ ሸምፓታ ዳሮፐ ኡንኤታዱ፤</para>
  <para style="q2" vid="PSA 6:3">ሽን ጾሳዉ፥ ታና ማዳናዉ ኔን አዉደ ጋካናዉ ጋምአይ?<verse eid="PSA 6:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4"/>አቤት ጾሳዉ፥ ኔን ስማደ፥ ታና አሻ፤</para>
  <para style="q2" vid="PSA 6:4">ነ ማሮታ ዳሩዋን ታና ከሳ አካ።<verse eid="PSA 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5"/>ሀይቄዳ ኡራይ ኦንነ ኔና ሀሳየና፤</para>
  <para style="q2" vid="PSA 6:5">ዱፉዋን ኔና ጋላትያዌ ባዋ።<verse eid="PSA 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6"/>ታን ኦልያን ዳቡራድ፤</para>
  <para style="q2" vid="PSA 6:6">ቃማ ኡባን ታን ዬካደ፥ ታ ሂጻ እርጽሳድ፤</para>
  <para style="q2" vid="PSA 6:6">ታ ቦርኮካ ታ አፎን ሙሱሳድ።<verse eid="PSA 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7"/>ታ ሞርከቱዋ ኡባ ጋሱዋን ታን አፎጼዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 6:7">ታ አይፊ ጋልጄዳ፤</para>
  <para style="q2" vid="PSA 6:7">ታ አይፊ ደመናን እጼዳ።<verse eid="PSA 6:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8"/>መና ጎዳይ ታን ዬክያ ዬኩዋ ስሴዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 6:8">ህንተኖ፥ ኢታ ኦያ ኡባቶ፥</para>
  <para style="q2" vid="PSA 6:8">ገደ ታፐ ሻከትተ።<note caller="-" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="MAT 7:23">ማቶሳ 7:23</ref>፤ <ref loc="LUK 13:27">ሉቃሳ 13:27</ref></char></note><verse eid="PSA 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9"/>መና ጎዳይ ታ ዋትዋቱዋ ስሴዳ፤</para>
  <para style="q2" vid="PSA 6:9">መና ጎዳይ ታ ዎሳነ ስሴ።<verse eid="PSA 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10"/>ታ ሞርከ ኡባቱ ዬላትኖነ ቱጋትኖ።</para>
  <para style="q2" vid="PSA 6:10">ኡንቱንቱ ቆፐናን ዬላቲደ፥ ጉየ ስምኖ።<verse eid="PSA 6:10"/></para>
  <chapter eid="PSA 6"/>
  <chapter number="7" style="c" sid="PSA 7"/>
  <para style="s1">የደሳ ዎድያን ጽሎ አሳ ዎሳ</para>
  <para style="d">ቢንያማ ዛርያ ኩዛዋ ዳዊተ፥ ጾሳኮ ዝላሌዳ ዝላሳ።</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 7:1"/>አቤት መና ጎዳዉ፥ ታ ጾሳዉ፥ ታን ኔኮ ባቃታደ ቆሰታይ።</para>
  <para style="q1" vid="PSA 7:1">ታና የደርስያ ኡባቱዋፐ ኔን ታና አሻ አካ።<verse eid="PSA 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2"/>ኔን ታና አሸናባ ግዶፐ፥</para>
  <para style="q2" vid="PSA 7:2">ኡንቱንቱ ታና ጋሙዋዳን ቦንቂደ፥</para>
  <para style="q2" vid="PSA 7:2">ኦንነ አሸናን መንሬና።<verse eid="PSA 7:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3-4" style="v" sid="PSA 7:3-4"/>አቤት መና ጎዳዉ ታ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 7:3-4">ታን አሳ ናቄዳዋ ግዶፐ፥</para>
  <para style="q1" vid="PSA 7:3-4">ሄዌነ ታ ላግያዉ ሎኡዋ ድራዉ ኢታ ዛሬዳዋ ግዶፐነ፥</para>
  <para style="q2" vid="PSA 7:3-4">ዎይ ጋሱ ባይናን ታ ሞርክያ ቦንቄዳዋ ግዶፐ፥</para>
  <para style="q1" vid="PSA 7:3-4">ሀዋ ማላ የዎቱዋፐ እቱዋነ ታን ኦዳዋ ግዶፐ፥<verse eid="PSA 7:3-4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 7:5"/>ታ ሞርኪ ታና የደርሲደ ኦይቆ።</para>
  <para style="q2" vid="PSA 7:5">ታና ሳኣን የሬ፤</para>
  <para style="q2" vid="PSA 7:5">ያቲደ፥ ታና ቢታን ኦል ባሾ።<verse eid="PSA 7:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6"/>አቤት መና ጎዳዉ፥ ነ ሀንቁዋን ደንዳ ኤቃ፤</para>
  <para style="q2" vid="PSA 7:6">ታ ሞርከቱዋ ኤጽያ ሀንቁዋ ቦላ ደንዳ።</para>
  <para style="q1" vid="PSA 7:6">ታ ጾሳዉ ጎዳዉ፥ ቤጎታ፤ ቱሙዋ ፕርዳ።<verse eid="PSA 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7"/>ካዉተቱዋ ሺቁ ነ ዩሹዋን ሺቆ፤</para>
  <para style="q2" vid="PSA 7:7">ኔን ኡንቱንቱፐ ቦላና ግዳደ ሃና።<verse eid="PSA 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 7:8"/>መና ጎዳይ ካዉተቱዋ ቦላ ፕርዴ።</para>
  <para style="q2" vid="PSA 7:8">አቤት መና ጎዳዉ፥ ታዉ ታ ጽሎተዳን ፕርዳ፤</para>
  <para style="q1" vid="PSA 7:8">አቤት ኡባፐ ቃዉ፥ ታ ሱረተዳን ፕርዳ።<verse eid="PSA 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9"/>ቆፋነ ዎዛና ብዳደ ኤርያ ጽሎ ጾሳዉ፥<note caller="-" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="REV 2:23">ሳፃ 2:23</ref></char></note></para>
  <para style="q2" vid="PSA 7:9">ኢታቱዋ ገንያ ኔን ይሳ።</para>
  <para style="q1" vid="PSA 7:9">ሽን ጽሉዋ ሳሮታን ምንሳ ዎ።<verse eid="PSA 7:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10"/>ዎዛና ጽሉዋ አሽያ ጾሳይ</para>
  <para style="q2" vid="PSA 7:10">ታዉ ጎንዳለ።<verse eid="PSA 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11"/>ጾሳይ ጽሉዋ ፕርድያዋ፤</para>
  <para style="q2" vid="PSA 7:11">እ ሀች ሀች ሀንቀትያ ጾሳ።<verse eid="PSA 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12"/>አሳይ ባረ ናጋራ ፓጺደ ስመናን እጾፐ፥</para>
  <para style="q2" vid="PSA 7:12">ጾሳይ ባረ ማሻ ሌፌ፤</para>
  <para style="q1" vid="PSA 7:12">እ ባረ ዎንዳፍያ ጊግሴ።<verse eid="PSA 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13"/>እ ባረ ዎያ ኦላ ሚሻቱዋ ጊግሴ፤</para>
  <para style="q2" vid="PSA 7:13">ታማ ላጩዋዳን ጶልያ ባረ ዎንዳፍያ ቶራ ጊግሴ።<verse eid="PSA 7:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14"/>ኢታተ ሻሃሬዳ፥</para>
  <para style="q2" vid="PSA 7:14">ገንያ ሻሃራ ሻሃሬዳዌ፥ ዎርዱዋ የሌ።<verse eid="PSA 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15"/>ሀራ አሳቶ ኦላ ቦኬዳ አሳይ</para>
  <para style="q2" vid="PSA 7:15">ባረ ቦኬዳ ኦላን ባረዉ ኩንዴ።<verse eid="PSA 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16"/>እ አህያ ገኒ አ ሁጲያዉ ስሜ።</para>
  <para style="q2" vid="PSA 7:16">አ ማካላይነ አ ሁጲያዉ ስሜ።<verse eid="PSA 7:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17"/>መና ጎዳ ጽሎተ ድራዉ፥</para>
  <para style="q2" vid="PSA 7:17">ታን አ ጋላታና፤</para>
  <para style="q1" vid="PSA 7:17">ቃይ ኡባፐ ቂያ መና ጎዳ ሱንዉ፥</para>
  <para style="q2" vid="PSA 7:17">ታን ጋላታ የጻና።<verse eid="PSA 7:17"/></para>
  <chapter eid="PSA 7"/>
  <chapter number="8" style="c" sid="PSA 8"/>
  <para style="s1">ጾሳ አንጋይ መታ ቦላን</para>
  <para style="d">ዛማረቱዋ ካፖ ሱሱላቱዋን የጸቴዳ፥ ዳዊታ ማዝሙርያ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1"/>አቤት መና ጎዳዉ፥ ኑ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 8:1">ነ ሱንይ ሳኣ ኡባ ቦላን አያ ቦንቼቴዴሻ!</para>
  <para style="b" vid="PSA 8:1"/>
  <para style="q1" vid="PSA 8:1">ኔን ነ ቦንቹዋ ሳሎቱዋፐ ቦላን</para>
  <para style="q2" vid="PSA 8:1">ቁ ቁ ኦ ዎዳ።<verse eid="PSA 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2"/>ኔን ነ ሞርከቱዋ ድራዉ፥</para>
  <para style="q2" vid="PSA 8:2">ነ ባልጋራነ ነዉ ማንድያዋ ስርጵ ኦናዉ፥</para>
  <para style="q2" vid="PSA 8:2">ጉ ናናቱዋ ዶናን</para>
  <para style="q2" vid="PSA 8:2">ምያ ናናቱዋ ዶናን ጋላታ ኩንዳ።<note caller="-" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="MAT 21:16">ማቶሳ 21:16</ref></char></note><verse eid="PSA 8:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3"/>ኔን ነ ብራቱዋን መዳ ነ ሳሎቱዋ፥</para>
  <para style="q2" vid="PSA 8:3">ሳኣን ሳኣን ኔን ዎዳ አግናነ</para>
  <para style="q2" vid="PSA 8:3">ጾልንተቱዋ ታን በእያ ዎደ፥<verse eid="PSA 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4"/>ኔን አሳባ ቆፓናዉ አሳይ አዬ?<note caller="-" style="x"><char style="xo" closed="false">8:4 </char><char style="xt" closed="false"><ref loc="JOB 7:17-18">ኢዮባ 7:17-18</ref>፤ <ref loc="PSA 144:3">ማዝ. 144:3</ref>፤ <ref loc="HEB 2:6-8">እብራ. 2:6-8</ref></char></note></para>
  <para style="q2" vid="PSA 8:4">ዎይ ኔን አዉ ህርጋናዉ እ አዬ?<verse eid="PSA 8:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5"/>አ ኔን ጾሳፐ አማሬዳዋ ጉዳ፤</para>
  <para style="q2" vid="PSA 8:5">ቦንቹዋነ ግታተ ካላቻ አ ሁጲያን ዎዳ።<verse eid="PSA 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6"/>አ ኔን ነ መዳ መተ ኡባ ቦላን</para>
  <para style="q2" vid="PSA 8:6">ሞድያዋ ኦደ ሱንዳ፤<note caller="-" style="x"><char style="xo" closed="false">8:6 </char><char style="xt" closed="false"><ref loc="1CO 15:27">1 ቆሮ. 15:27</ref>፤ <ref loc="EPH 1:22">ኤፈ. 1:22</ref>፤ <ref loc="HEB 2:8">እብራ. 2:8</ref></char></note></para>
  <para style="q2" vid="PSA 8:6">ኡባባ አ ገድያፐ ጋርሳና ዎዳ።<verse eid="PSA 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7"/>ዶርሳቱዋነ ቦራቱዋ፥ ሳኣ ዶአቱዋነ፥<verse eid="PSA 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 8:8"/>ሳሉዋ ካፎቱዋ፥ አባ ሞለቱዋነ፥</para>
  <para style="q2" vid="PSA 8:8">አባይ ጎግያሳን ዋያዋንታ ኡባካ</para>
  <para style="q1" vid="PSA 8:8">አ ሞድሳዳ።<verse eid="PSA 8:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9"/>አቤት ጾሳዉ፥ ኑ ጾሳዉ፥ ነ ሱንይ</para>
  <para style="q2" vid="PSA 8:9">ሳኣ ኡባን አያ ቦንቼቴዴሻ!<verse eid="PSA 8:9"/></para>
  <chapter eid="PSA 8"/>
  <chapter number="9" style="c" sid="PSA 9"/>
  <para style="s1">ኢታ ቦላን ፕርዳ</para>
  <para style="d">ዛማረቱዋ ካፖ፥ “ናኣ ሀይቁዋን” የጸቴዳ፥ ዳዊታ ማዝሙርያ።</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 9:1"/>አቤት መና ጎዳዉ፥ ታን ኔና ታ ኩመን ዎዛናፐ ጋላታና፤</para>
  <para style="q1" vid="PSA 9:1">ኔን ኦዳ ማላልስያ</para>
  <para style="q2" vid="PSA 9:1">ነ ኦሱዋ ኡባካ ኦዳና።<verse eid="PSA 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2"/>ኔናን ናሸታናነ ሀሹ ጋና።</para>
  <para style="q1" vid="PSA 9:2">ኡባፐ ቂያ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 9:2">ታን ነ ሱንዉ ጋላታ የጻና።<verse eid="PSA 9:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3"/>ታ ሞርከቱ ጉየ ስምያ ዎደ፥</para>
  <para style="q2" vid="PSA 9:3">ነ ስንፐ በት ያና።<verse eid="PSA 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4"/>ኔን ታዉ ጽሎ ፕርዳ ፕርዳዳ፤</para>
  <para style="q1" vid="PSA 9:4">ኔን ጽሎተን ፕርዳደ፥</para>
  <para style="q2" vid="PSA 9:4">ነ ካዉተ አራታን ኡታዳ።<verse eid="PSA 9:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5"/>ኔን ካዉተ ሴራዳ፤</para>
  <para style="q2" vid="PSA 9:5">ኢታቱዋካ ይሳዳ።</para>
  <para style="q1" vid="PSA 9:5">ኔን ኡንቱንቱ ሱን መ መናዉካ ቁጫ ድጋዳ።<verse eid="PSA 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6"/>ሞርከቱ መና ዩዋ ዬድኖ፤</para>
  <para style="q2" vid="PSA 9:6">ቃይ ኡንቱንቱ ካታማቱዋ ኡባና ቆላ ድጋዳ።</para>
  <para style="q1" vid="PSA 9:6">ኡንቱንቱ ኡባና ዶገት አቴድኖ።<verse eid="PSA 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7"/>ሽን መና ጎዳይ መናዉ ካተቲደ ደኤ፤</para>
  <para style="q2" vid="PSA 9:7">እ ባረ ካዉተ አራታ ፕርዳዉ ጊግሴዳ።<verse eid="PSA 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8"/>ሀ ሳኣ ጽሎተን ፕርዳና፤</para>
  <para style="q2" vid="PSA 9:8">አሳቱዋካ ሱረተን ፕርዳና።<verse eid="PSA 9:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9"/>መና ጎዳይ ኡንኤቴዳዋንቶ ባቃት አትያዋ፤</para>
  <para style="q2" vid="PSA 9:9">መቶ ዎድያንካ ገል አትያ ጌሱዋ።<verse eid="PSA 9:9"/></para>
  <para style="q3">
    <verse number="10" style="v" sid="PSA 9:10"/>ነ ሱን ኤርያዋንቱ ኔናን አማነቲኖ፤</para>
  <para style="q2" vid="PSA 9:10">አያዉ ጎፐ፥ መና ጎዳዉ፥ ኔን ኔና ኮይያዋንታ የጋ አጋ በይካ።<verse eid="PSA 9:10"/></para>
  <para style="b"/>
  <para style="q3">
    <verse number="11" style="v" sid="PSA 9:11"/>ጽዮነ ደርያን ካተት ኡቴዳ መና ጎዳዉ ጋላታ የጽተ።</para>
  <para style="q2" vid="PSA 9:11">እ ኦዳ ኡባባካ አሳ ኡባዉ ኦድተ።<verse eid="PSA 9:11"/></para>
  <para style="q3">
    <verse number="12" style="v" sid="PSA 9:12"/>አያዉ ጎፐ፥ ሱ ጉስያዋንቶ</para>
  <para style="q2" vid="PSA 9:12">ሀሉዋ ከስያ ጾሳይ</para>
  <para style="q2" vid="PSA 9:12">ናቀቴዳዋንቱ ዋሱዋ ሸነኮ ጌና።<verse eid="PSA 9:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13-14" style="v" sid="PSA 9:13-14"/>አቤት መና ጎዳዉ፥ ጽዮነ አሳ ካርያን ታን ኤቃደ፥</para>
  <para style="q2" vid="PSA 9:13-14">ነ ጋላታ ኦዳና ማላነ</para>
  <para style="q2" vid="PSA 9:13-14">ሄዋን ነ አቶተን ሎይ ናሸታና ማላ፥</para>
  <para style="q2" vid="PSA 9:13-14">ታ ሞርከቱ ታና የደርስያዋ በአ።</para>
  <para style="q1" vid="PSA 9:13-14">ኔን ነ ማሮታን፥ ሀይቁዋፐ ታና አሻ።<verse eid="PSA 9:13-14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15"/>ካዉተቱ ባረንቱ ቦኬዳ ኦላን ባረንቶ ኩንዴድኖ።</para>
  <para style="q2" vid="PSA 9:15">ኡንቱንቱ ቆስ ዎዳ ጲሪ ኡንቱንቱ ገድያ ኦይቄዳ።<verse eid="PSA 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16"/>መና ጎዳይ ባረ ጽሎ ፕርዳን ባረዉ ኤረቴዳ፤</para>
  <para style="q2" vid="PSA 9:16">ኢታ አሳይ ባረ ኩሽያን ኦዳ ኦሱዋ ጲርያን ኦይቀቴዳ።<verse eid="PSA 9:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17"/>ኢታቱ ዱፉዋ ባና፤</para>
  <para style="q2" vid="PSA 9:17">ጾሳ ዶግያ ካዉተቱ ኡባይካ ኡንቱንቱዳን ሀናና።<verse eid="PSA 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18"/>ህዬሳይ ኡባ ገደ ዶገት አተና፤</para>
  <para style="q2" vid="PSA 9:18">ዎይ መቶታንቻይ ዎዳ ህዶታይ መናዉ የና።<verse eid="PSA 9:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19"/>አቤት መና ጎዳዉ፥ አሳይ ነ ቦላ ደንዲደ፥</para>
  <para style="q2" vid="PSA 9:19">ባረ ዎልቃን ጬቀተና ማላ፥ ኔን ደንዳ!</para>
  <para style="q1" vid="PSA 9:19">ነ ስንን ካዉተቱዋ ቦላ ኔን ፕርዳ።<verse eid="PSA 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20"/>አቤት መና ጎዳዉ፥ ኡንቱንታ ኔን ያሽሳ፤</para>
  <para style="q2" vid="PSA 9:20">ኡንቱንቱ አሳ ግድያዋ ኔን ኡንቱንታ ኤርሳ።<verse eid="PSA 9:20"/></para>
  <chapter eid="PSA 9"/>
  <chapter number="10" style="c" sid="PSA 10"/>
  <para style="s1">ፕርዳ ደማናዉ ሺቄዳ ዎሳ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1"/>አቤት መና ጎዳዉ፥ አያዉ ሃካደ ኤቃይ?</para>
  <para style="q2" vid="PSA 10:1">መቱዋ ዎድያን አያዉ ኔን ጌማይ?<verse eid="PSA 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2"/>ባረ ኦቶሩዋን ኢታ አሳይ ህዬሳ ሻንካቴ።</para>
  <para style="q2" vid="PSA 10:2">ኡንቱንቱ ባረንቱ ፓላ ማቁዋን ባረንቶ ኦይቀትኖ።<verse eid="PSA 10:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3"/>ሄ ኢታይ ባረ ዎዛና ኢታ አሙዋን ጬቀቴ፤</para>
  <para style="q2" vid="PSA 10:3">ዮራንቻይ መና ጎዳ ቦላ ኢታ ቃላ ሃሳዬነ ካዴ።<verse eid="PSA 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4"/>ኢታይ ባረ ኦቶሩዋን ጾሳ ኮየና፤</para>
  <para style="q2" vid="PSA 10:4">ባረ ቆፋ ኡባንካ ጾሳ አይነ ኮየና።<verse eid="PSA 10:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5"/>ኡባባይ አዉ ኡባ ዎደካ ኩሜ፤</para>
  <para style="q2" vid="PSA 10:5">እ ኦቶሩዋ ጴጻሌ።</para>
  <para style="q1" vid="PSA 10:5">ነ ህጊ አዉ ገለና፤</para>
  <para style="q2" vid="PSA 10:5">ባረ ሞርከቱዋ ቦላን እ ቅሊጬ።<verse eid="PSA 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6"/>ባረ ዎዛናን እ፥ “ታና አያይነ ቃና።</para>
  <para style="q2" vid="PSA 10:6">ታና ኡባካ መቱ ጋከና” ያጊደ ቆፔ።<verse eid="PSA 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7"/>አ ዶናን ሸቃይ፥</para>
  <para style="q2" vid="PSA 10:7">ዎርዱነ ማንደይ ኩሜዳ።<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="ROM 3:14">ሮመ 3:14</ref></char></note></para>
  <para style="q1" vid="PSA 10:7">ባረ እንጻርሳን ገነባነ ኢታባ ሃሳያናዉ ኤሌሌ።<verse eid="PSA 10:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8"/>ሄራን ቆሰትያሳን እ ዙጊደ ኡቴ።</para>
  <para style="q2" vid="PSA 10:8">ባረ ዎያዋ ዎናዉ ቆሰት ናጊደ፥</para>
  <para style="q2" vid="PSA 10:8">ዎልቃይ ባይና አሽከቱዋ ጼሌ።<verse eid="PSA 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 10:9"/>ባረ ቆሰትያሳን ጌሚደ፥</para>
  <para style="q2" vid="PSA 10:9">ህዬሳ ኦይቃናዉ ጋሙዋዳን ዙጌ።</para>
  <para style="q1" vid="PSA 10:9">እ ህዬሳ ኦይቂደ፥ ባረ ጲርያን ጎቺደ አፌ።<verse eid="PSA 10:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10"/>ያትና፥ ዎልቃይ ባይና ህዬሳይ ሾጨቴ፤</para>
  <para style="q2" vid="PSA 10:10">ንፕ ጌነ ሄ ምኑዋን ጾነቴ።<verse eid="PSA 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11"/>እ ባረ ዎዛናን፥ “ጾሳይ ታና ዶግ ክቼዳ።</para>
  <para style="q2" vid="PSA 10:11">ባረ ሶምኡዋ ታፐ ገን ክቼዳ፤</para>
  <para style="q2" vid="PSA 10:11">ኡባካ እ በኤና” ያጌ።<verse eid="PSA 10:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12"/>አቤት መና ጎዳዉ፥ ደንዳ።</para>
  <para style="q2" vid="PSA 10:12">ጾሳዉ፥ ነ ኩሽያ ቁ ኦደ ደን፤</para>
  <para style="q2" vid="PSA 10:12">ህዬሳ ዶጎፓ።<verse eid="PSA 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13"/>ናጋራንቻ ኡራይ ባረ ዎዛናን፥</para>
  <para style="q2" vid="PSA 10:13">ጾሳ አያዉ ካ?</para>
  <para style="q1" vid="PSA 10:13">ባረ ቆፋንካ፥ “ጾሳይ ታና ሙረና”</para>
  <para style="q2" vid="PSA 10:13">አያዉ ያጊ?<verse eid="PSA 10:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14"/>ሽን ጾሳዉ፥ ኔን ቱሙካ በኣሳ፤</para>
  <para style="q2" vid="PSA 10:14">መቱዋካ ዋይያካ ጼላሳ።</para>
  <para style="q1" vid="PSA 10:14">ኔን ኡባ ዎደ ኑና ማዳናዉ ጊጋ ኡታዳ።</para>
  <para style="q2" vid="PSA 10:14">ዪአቶ ኔን ማዱዋ።</para>
  <para style="q1" vid="PSA 10:14">ቆሄቴዳዌ ኔን ማዳናዳን ባረና ነዉ ሼ።<verse eid="PSA 10:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15"/>ገንያዋንቱ ዎልቃ ኔን ዉርሳ፤</para>
  <para style="q2" vid="PSA 10:15">ኢታ አሳቱዋካ ሄዋዳ ኦ።</para>
  <para style="q1" vid="PSA 10:15">ላኤን ኡንቱንቱ ግዶን ኢታተይ ቤተና ማላ ኡንቱንታ ሙራ።<verse eid="PSA 10:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16"/>መና ጎዳይ መ መናዉ ካተቲደ ደኤ፤</para>
  <para style="q2" vid="PSA 10:16">ሀራ ካዉተቱ አ ቢታፐ ያና።<verse eid="PSA 10:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17"/>አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 10:17">ኔን ባረንታ ካዉሽያዋንቱ አሙዋ ስሳሳ።</para>
  <para style="q1" vid="PSA 10:17">ኔን ኡንቱንታ ምንሳ።<verse eid="PSA 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18"/>ይአቶነ ኡንኤቴዳዋንቶ ቱሙዋ ፕርዳ፤</para>
  <para style="q2" vid="PSA 10:18">ሳኣን ደእያ አሳይ፥ ኡንቱንታ ያሽሰና ማላ፥</para>
  <para style="q1" vid="PSA 10:18">ኡንቱንቱ ዋሱዋ ስሳሳ።<verse eid="PSA 10:18"/></para>
  <chapter eid="PSA 10"/>
  <chapter number="11" style="c" sid="PSA 11"/>
  <para style="s1">ጽሎቱዋ ጬቁዋ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ዳዊታ ማዝሙርያ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 11:1"/>ታን መና ጎዳ ግዶን ባቃታ ቆሰታ አታይ።</para>
  <para style="q2" vid="PSA 11:1">ያትና፥ ህንተ ታና አያዉ፥</para>
  <para style="q2" vid="PSA 11:1">“ካፉዋዳን ነ ደርያ ባቃታ” ያጊቴ?<verse eid="PSA 11:1"/></para>
  <para style="q3">
    <verse number="2" style="v" sid="PSA 11:2"/>ሄኮ ናጋራንቻቱ፥</para>
  <para style="q2" vid="PSA 11:2">ዎዛና ጌሻቱዋ ማን ጫዳናዉ፥</para>
  <para style="q2" vid="PSA 11:2">ባረንቱ ዎንዳፍያ ባቀ ቦላን ፖ ቶሊኖ።<verse eid="PSA 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3"/>ባሱ ባይያ ዎደ፥</para>
  <para style="q2" vid="PSA 11:3">ጽሉ አያ ኦናዉ ዳንዳዪ?<verse eid="PSA 11:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4"/>መና ጎዳይ ባረ ጌሻ ሳኣን ደኤ፤</para>
  <para style="q2" vid="PSA 11:4">ባረ ሳሉዋ ካዉተ አራታን፥</para>
  <para style="q1" vid="PSA 11:4">መና ጎዳይ አሳ ጼሌ፤</para>
  <para style="q2" vid="PSA 11:4">ጾሳ አይፊ አሳ ብዴ።<verse eid="PSA 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5"/>መና ጎዳይ ጽሉዋ ብዴ።</para>
  <para style="q2" vid="PSA 11:5">ሽን ኢታቱዋነ ኮባባ ሲቅያዋንታ</para>
  <para style="q1" vid="PSA 11:5">እ ሎይ እጼ።<verse eid="PSA 11:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6"/>ጾሳይ ኢታቱዋ ቦላን ኤጽያ ታማ ቦንቁዋነ</para>
  <para style="q2" vid="PSA 11:6">ኤጽያ ዲንያ ቡክሳና።</para>
  <para style="q1" vid="PSA 11:6">ይስያ ጎትያ ጫርኩዋን ኡንቱንታ ሙራና።<verse eid="PSA 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7"/>መና ጎዳይ ጽሎ ግዴዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 11:7">ጽሎተ ዶሴ።</para>
  <para style="q1" vid="PSA 11:7">ሱረ አሳቱ አ ስን በአና።<verse eid="PSA 11:7"/></para>
  <chapter eid="PSA 11"/>
  <chapter number="12" style="c" sid="PSA 12"/>
  <para style="s1">ኢታ አላምያፐ አታናዉ ሺቄዳ ዎሳ</para>
  <para style="d">ዛማረቱዋ ካፖ ዲን የጸቴዳ፥ ዳዊታ ማዝሙርያ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 12:1"/>መና ጎዳዉ፥ ኑና ማዳርኪ?</para>
  <para style="q2" vid="PSA 12:1">አያዉ ጎፐ፥ ጾሳ አሳይ ኡባካ ባዋ፤</para>
  <para style="q3" vid="PSA 12:1">አሳ ግዶን አማነትያዌ ይክቼዳ።<verse eid="PSA 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2"/>ኡባ ዎደካ እቱ እቶ ዎርዱዋ ሃሳዪኖ፤</para>
  <para style="q2" vid="PSA 12:2">እቱ እቱዋ ሸሌሽያ እንጻርሳን ባለዋን ሃሳዪኖ።<verse eid="PSA 12:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3"/>አቤት መና ጎዳዉ፥ ሀ ሸሌሽያ ዶና ባራ።</para>
  <para style="q2" vid="PSA 12:3">ኦቶሩዋን ጬቀትያ እንጻርሳ ኡባ ኔን ጭጋ ኦላ።<verse eid="PSA 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4"/>ኡንቱንቱ፥ “ኑን ኑ እንጻርሳን ጾናና፤</para>
  <para style="q2" vid="PSA 12:4">ኑ መተርሻይ ኑዋ፤ ኑ ጎዳይ ኦኔ?” ያግኖ።<verse eid="PSA 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5"/>መና ጎዳይ፥ “ህዬሳቱ ኡንኤቴዳ ድራዉነ፥</para>
  <para style="q2" vid="PSA 12:5">መቶታንቻቱዋ ኦልያ ድራዉ፥</para>
  <para style="q2" vid="PSA 12:5">ሀእ ታን ደንዳና።</para>
  <para style="q2" vid="PSA 12:5">ታን ኡንቱንቱ አሞትያ ሳሮተን ኡንቱንታ ዎና” ያጌ።<verse eid="PSA 12:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6"/>ጾሳ ቃላቱ ዋላክ ባይና ጌሻቱዋ፤</para>
  <para style="q2" vid="PSA 12:6">ጮጭያ ታማን ላፑን ገደ ትገቴዳ ብራዳን ጌዬዳዋንታ።<verse eid="PSA 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7"/>አቤት መና ጎዳዉ፥ ኔን ኡንቱንታ ሳሮተን ናጋነ</para>
  <para style="q2" vid="PSA 12:7">ሀዋ ማላ አሳፐ መናዉ ኡንቱንታ አሻ።<verse eid="PSA 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8"/>አሳ ግዱዋን ኢታይ ቦንቼቴዳ ዎደ፥</para>
  <para style="q2" vid="PSA 12:8">ኢታቱ ኡባ ሳና ስመረቴድኖ።<verse eid="PSA 12:8"/></para>
  <chapter eid="PSA 12"/>
  <chapter number="13" style="c" sid="PSA 13"/>
  <para style="s1">ባረ ጾሳን አማነቴዳ አሳ ዎሳ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ዳዊታ ማዝሙርያ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1"/>አቤት መና ጎዳዉ፥ አዉደ ጋካናዉ ኔን ታና ዶጋይ?</para>
  <para style="q2" vid="PSA 13:1">መናዉ ታና ዶጋይ?</para>
  <para style="q2" vid="PSA 13:1">አዉደ ጋካናዉ ኔን ታፐ ጌማይ?<verse eid="PSA 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2"/>ታን ታ ቆፋና ባጸትያዌ</para>
  <para style="q2" vid="PSA 13:2">አዉደ ጋካናሴ?</para>
  <para style="q1" vid="PSA 13:2">ኡባ ጋላስ ካዩ ታ ዎዛናን ደአናዌ</para>
  <para style="q2" vid="PSA 13:2">አዉደ ጋካናሴ?</para>
  <para style="q1" vid="PSA 13:2">ታ ሞርከቱ ታ ቦላ ጎባናዌ</para>
  <para style="q2" vid="PSA 13:2">አዉደ ጋካናሴ?<verse eid="PSA 13:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3"/>መና ጎዳዉ ታ ጾሳዉ፥ ሃ ታኮ ጼላደ፥</para>
  <para style="q2" vid="PSA 13:3">ታዉ ዛራ።</para>
  <para style="q1" vid="PSA 13:3">ታ አይፍያ ፖእሳደ፥</para>
  <para style="q2" vid="PSA 13:3">ሀይቁዋፐ ታና አሻ።<verse eid="PSA 13:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4"/>“ኑን አ ጾኔዶ” ያጊደ፥</para>
  <para style="q2" vid="PSA 13:4">ታ ሞርከቱ ጬቀተናዳን ተአ።</para>
  <para style="q1" vid="PSA 13:4">ታ ኩንደን ኡንቱንቱ ናሸተናዳን ድጋ።<verse eid="PSA 13:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5"/>ሽን አገና ነ ማሮታን ታን አማነታይ፤</para>
  <para style="q2" vid="PSA 13:5">ኔን ታና አሽያ ድራዉ፥ ታን ናሸታይ።<verse eid="PSA 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6"/>መና ጎዳዉ፥ ታን ነዉ የጻና፤</para>
  <para style="q2" vid="PSA 13:6">አያዉ ጎፐ፥ ኔን ታዉ ኬካዳ።<verse eid="PSA 13:6"/></para>
  <chapter eid="PSA 13"/>
  <chapter number="14" style="c" sid="PSA 14"/>
  <para style="s1">ጾሳይ ባይና አሳቱዋ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ዳዊታ ማዝሙርያ።</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 14:1"/>ኤያቱ ባረንቱ ዎዛናን፥<note caller="-" style="x"><char style="xo" closed="false">14:1-3 </char><char style="xt" closed="false"><ref loc="ROM 3:10-12">ሮመ 3:10-12</ref></char></note> “ጾሳይ ባዋ” ያጊኖ።</para>
  <para style="q1" vid="PSA 14:1">ኡንቱንቱ ደኡ ባዬዳ።</para>
  <para style="q2" vid="PSA 14:1">ኡንቱንቱ ሸነይያዋ ኦኖ፤</para>
  <para style="q3" vid="PSA 14:1">ሎእያዋ ኦያ አሳይ ባዋ።<verse eid="PSA 14:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2"/>ጾሳ ኮይያ ኤራንቻቱ ደእንቶነ</para>
  <para style="q2" vid="PSA 14:2">በአናዉ፥ መና ጎዳይ ሳሉዋፐ ዱገ አሳ ጼሌ።<verse eid="PSA 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3"/>ሽን ኡባይካ ዎራ ስሜድኖ፤</para>
  <para style="q2" vid="PSA 14:3">ኡባይካ ኡባና ጎኤናባ ግዴድኖ።</para>
  <para style="q1" vid="PSA 14:3">ሎእያዋ ኦያ ኦንነ ባዋ፤</para>
  <para style="q2" vid="PSA 14:3">ሀራይ አቶ እቱነ ባዋ።<verse eid="PSA 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4"/>መና ጎዳይ፥ “ሀዋንቱ ታ አሳ፥</para>
  <para style="q2" vid="PSA 14:4">አሳይ ቁማ ምያዋዳን ቦንቂ ሚኖ።</para>
  <para style="q1" vid="PSA 14:4">ኢታ አሳቱ ቱሙ አያነ አኬክክኖ?</para>
  <para style="q2" vid="PSA 14:4">ኡንቱንቱ ታና ዎስክኖ” ያጌዳ።<verse eid="PSA 14:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5"/>ሽን ጾሳይ ጽሎ አሳቱዋና ደእያ ድራዉ፥</para>
  <para style="q2" vid="PSA 14:5">ኢታቱ ሄዋን ዳጋማና።<verse eid="PSA 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6"/>ኡንቱንቱ ህዬሳቱዋ ቆፋ ሀልሲኖ፤</para>
  <para style="q2" vid="PSA 14:6">ሽን መና ጎዳይ ህዬሳቱ ባቃቲደ፥ ቆሰት አትያ ሳኣ።<verse eid="PSA 14:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7"/>እስራኤልያዉ አቶተይ ጽዮነፐ ዬረኔ!</para>
  <para style="q2" vid="PSA 14:7">መና ጎዳይ ኡንቱንቱ ደኡዋ ዛርያ ዎደ፥</para>
  <para style="q1" vid="PSA 14:7">ያቆባ ዘረይ ናሸታና፤</para>
  <para style="q2" vid="PSA 14:7">እስራኤልያ አሳይ ናሸቻ ፖጩ ጋና።<verse eid="PSA 14:7"/></para>
  <chapter eid="PSA 14"/>
  <chapter number="15" style="c" sid="PSA 15"/>
  <para style="s1">ጾሳይ አሳፐ ኮይያዌ አዬ?</para>
  <para style="d">ዳዊታ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1"/>አቤት ጾሳዉ፥ ነ ዱንካንያን ጋምአናዌ ኦኔ?</para>
  <para style="q2" vid="PSA 15:1">ነ ጌሻ ደርያን ኔናና ደአናዌ ኦኔ?<verse eid="PSA 15:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2"/>ሱረ ደኡዋ ደእያዋ፥</para>
  <para style="q2" vid="PSA 15:2">ጽሎባ ኦያዋ፥</para>
  <para style="q2" vid="PSA 15:2">ባረ ዎዛናፐ ቱሙዋ ሃሳይያዋ፥<verse eid="PSA 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 15:3"/>ሀራ አሳ ሱን ባይዘናዋ፥</para>
  <para style="q2" vid="PSA 15:3">ባረ ላግያ ቦላ ኢታባ ኦናዋ፥</para>
  <para style="q2" vid="PSA 15:3">ባረ ሾሩዋ ዝግረናዋ፤<verse eid="PSA 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4"/>መና ጎዳን እጸቴዳ አሳቱዋ ካያዌ፥</para>
  <para style="q2" vid="PSA 15:4">ሽን ጾሳዉ ያይያ አሳቱዋ ቦንችያዌ፥</para>
  <para style="q2" vid="PSA 15:4">ባረ ጫቄዳዋ አያ ዴጽናካ ፖልያዌ፥<verse eid="PSA 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5"/>ባረ ሚሻ ድቻዉ እመናዌ፥</para>
  <para style="q2" vid="PSA 15:5">ጽሎ አሳቱዋ ቆሀናዉ</para>
  <para style="q2" vid="PSA 15:5">ማታይያ አከናዌ።</para>
  <para style="b" vid="PSA 15:5"/>
  <para style="q2" vid="PSA 15:5">ሀ የዎቱዋ ኦያዌ፥</para>
  <para style="q2" vid="PSA 15:5">መናዉካ ቃጸና።<verse eid="PSA 15:5"/></para>
  <chapter eid="PSA 15"/>
  <chapter number="16" style="c" sid="PSA 16"/>
  <para style="s1">ጾሳይ ታ ላታ</para>
  <para style="d">ዳዊታ ዎሳ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1"/>አቤት ጾሳዉ፥</para>
  <para style="q2" vid="PSA 16:1">ታን ኔኮ ባቃቴዳ ድራዉ፥ ታና ናጋ።<verse eid="PSA 16:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2"/>ታን መና ጎዳዉ፥ “ኔን ታ ጎዳ፤</para>
  <para style="q2" vid="PSA 16:2">ኔፐ አትን፥ ሀራ ሎኡ ታዉ ባዋ” ያጋይ።<verse eid="PSA 16:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3"/>ሳኣን ደእያ ጌሻቱ</para>
  <para style="q2" vid="PSA 16:3">አይ ማላ ጋላተቴድኖ!</para>
  <para style="q1" vid="PSA 16:3">ታ ናሸቻይ ኡባይ ኡንቱንቱና እትፐ ግድያዋ።<verse eid="PSA 16:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4"/>ዎርዶ ጾሳቱዋ ካልያዋንቱ</para>
  <para style="q2" vid="PSA 16:4">ባረንቱ ቦላ መቱዋ ዳርሲኖ።</para>
  <para style="q1" vid="PSA 16:4">ሽን ታን ኡንቱንቱ ዎርዶ ጾሳቶ ያርሽከ፤</para>
  <para style="q2" vid="PSA 16:4">ታን ኡንቱንቱ ሱን ጼስከ።<verse eid="PSA 16:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5"/>ታ መና ጎዳዉ፥ ታ ደኡዋ ላታይነ ጹአይ ኔና፤</para>
  <para style="q2" vid="PSA 16:5">ታና ኮሽያ ኡባ ኔን ታዉ እማሳ።</para>
  <para style="q1" vid="PSA 16:5">ታ ደኡዋ ሳማይ ኔና።<verse eid="PSA 16:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6"/>ኔን ታዉ ዋዳ ሳማይ አይ ኬሻ ሎኤ!</para>
  <para style="q2" vid="PSA 16:6">ኤ ታ ላታይ ቱሙዋፐ ሎአ!<verse eid="PSA 16:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7"/>ታና ዞርያ መና ጎዳ ጋላታይ፤</para>
  <para style="q2" vid="PSA 16:7">ብላሄካ ታ ዎዛናይ ታና ሴሬ።<verse eid="PSA 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8"/>ታን ኡባ ገደ መና ጎዳ ታፐ ስንያይ<note caller="-" style="x"><char style="xo" closed="false">16:8-11 </char><char style="xt" closed="false"><ref loc="ACT 2:25-28">ኪታ 2:25-28</ref></char></note></para>
  <para style="q2" vid="PSA 16:8">እ ታፐ ኡሸቻ ባጋና ደእያ ድራዉ፥</para>
  <para style="q2" vid="PSA 16:8">ታን ህርግከ።<verse eid="PSA 16:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9"/>ሄዋ ድራዉ፥ ታ ዎዛናይ ናሸቴ፤</para>
  <para style="q2" vid="PSA 16:9">ታ ሸምፑካ ሀሹ ጌ።</para>
  <para style="q1" vid="PSA 16:9">ታ ቦላይካ ህርግ ባይናን ደኤ።<verse eid="PSA 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10"/>ታና ስኦልያዉ አደ እማካ፤<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="ACT 13:35">ኪታ 13:35</ref></char></note></para>
  <para style="q2" vid="PSA 16:10">ኔን ነ ጌሻ ሙስሳካ።<verse eid="PSA 16:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11"/>ኔን ታና ደኡዋ ኦግያ በሳሳ።</para>
  <para style="q2" vid="PSA 16:11">ታን ነ ማታን ደእና፥ ታ ናሸቻይ ፖለቴ፤</para>
  <para style="q2" vid="PSA 16:11">ነ ኡሸቻ ባጋና እንጂ መናዉ ደኤ።<verse eid="PSA 16:11"/></para>
  <chapter eid="PSA 16"/>
  <chapter number="17" style="c" sid="PSA 17"/>
  <para style="s1">ጌሻ አሳ ዎሳ</para>
  <para style="d">ዳዊታ ዎሳ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 17:1"/>አቤት መና ጎዳዉ፥ ታ ጽሎ ኦችያዋ ስሳ፤</para>
  <para style="q2" vid="PSA 17:1">ታ ዋሱዋ ሀይዛ።</para>
  <para style="q3" vid="PSA 17:1">ታን ጭመና እንጻርሳፐ ዎስያ ዎሳኮ፥</para>
  <para style="q3" vid="PSA 17:1">ነ ሀይ ዛራ።<verse eid="PSA 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2"/>ታ ሻትንይ ነ ስንፐ ዮ፤</para>
  <para style="q2" vid="PSA 17:2">ነ አይፊ ልከ ግድያዋ ጼሎ።<verse eid="PSA 17:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3"/>ኔን ቃማን ታና ጾሞሳዳ፤</para>
  <para style="q2" vid="PSA 17:3">ታ ዎዛና ፓጫዳ።</para>
  <para style="q1" vid="PSA 17:3">ሽን ታ ቦላፐ አይነካ ደማካ።</para>
  <para style="q2" vid="PSA 17:3">ታ እንጻርሳይካ ባለትቤና።<verse eid="PSA 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4"/>ታን ሀራ አሳቱዋዳን ኢታ ቃላ ሃሳይከ፤</para>
  <para style="q2" vid="PSA 17:4">ታን ነ አዛዙዋ ናግያ ድራዉ፥ ገነ ኦግያ ካላበይከ።<verse eid="PSA 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5"/>ታ ገዲ በተና ማላ፥</para>
  <para style="q2" vid="PSA 17:5">ታ ታንጉ ነ ኦግያፐ ጋጻ ከስቤና።<verse eid="PSA 17:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6"/>አቤት ጾሳዉ፥ ኔን ስስያ ድራዉ፥</para>
  <para style="q2" vid="PSA 17:6">ታን ኔና ዎሳይ።</para>
  <para style="q1" vid="PSA 17:6">ነ ሀይ ታኮ ዛራደ፥</para>
  <para style="q2" vid="PSA 17:6">ታን ነዉ ኦድያዋ ሀይዛ።<verse eid="PSA 17:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7"/>ባረንቱ ሞርከቱዋፐ ባቃትያዋንታ</para>
  <para style="q2" vid="PSA 17:7">ነ ኡሸቻ ኩሽያን ቆሳደ አሽያዎ፥</para>
  <para style="q2" vid="PSA 17:7">ነ ሎኦተ ማላልስያ ኦግያን በሳ።<verse eid="PSA 17:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8"/>ነ አይፍያ ጭሩዋዳን ታና ናጋ፤</para>
  <para style="q2" vid="PSA 17:8">ነ ቀፍያ ግዶን ታና ቆሳ።<verse eid="PSA 17:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9"/>ታና ኡንእ ዎዳ ኢታቱዋፐነ</para>
  <para style="q2" vid="PSA 17:9">ዶድ ዎዳ ጻላ ሞርከቱዋ ኩሽያፐ</para>
  <para style="q2" vid="PSA 17:9">ታና ቆሳ።<verse eid="PSA 17:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10"/>ኡንቱንቶ ቃረት ባዋ፤</para>
  <para style="q2" vid="PSA 17:10">ኦቶሩዋን ሃሳዪኖ።<verse eid="PSA 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11"/>ታን ብያሳኣ ኡባን ኡንቱንቱ ታና ዶዲኖ።</para>
  <para style="q2" vid="PSA 17:11">ታና ቢታን አ የጋናዉ ጼሊኖ።<verse eid="PSA 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12"/>ኡንቱንቱ ባረንቶ ምያዋ ኮይያ ጋሞቱዋ ማላ፤</para>
  <para style="q2" vid="PSA 17:12">ጌማን ዙግ ናግያ ዎዳላ ጋሞቱዋ ማላ።<verse eid="PSA 17:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13"/>አቤት መና ጎዳዉ፥ ደንዳ።</para>
  <para style="q2" vid="PSA 17:13">ታ ሞርከቱዋና ኤቀታደ ጾና፤</para>
  <para style="q2" vid="PSA 17:13">ነ ማሻን ኢታቱዋፐ ታና አሻ አካ።<verse eid="PSA 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14"/>አቤት መና ጎዳዉ፥ ሀዋ ማላ አሳፐ፥</para>
  <para style="q2" vid="PSA 17:14">ኡንቱንቱ ካጫይ ሀ ሳኣ ደኡዋ ጻላላ ግድያ አሳፐ</para>
  <para style="q2" vid="PSA 17:14">ነ ኩሽያን ታና አሻ።</para>
  <para style="q2" vid="PSA 17:14">ኔን ኡንቱንቶ ምንጄዳ ቦሻን ኡንቱንታ ሙራ፤</para>
  <para style="q2" vid="PSA 17:14">ሄ ቦሻይነ ኡንቱንቱ ናናቶ ግዲደ፥</para>
  <para style="q2" vid="PSA 17:14">ኡንቱንቱ ናናቱዋ ናናቶካ ፓላሆ።<verse eid="PSA 17:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15"/>ሽን ታን ጽሎተን ነ ሶምእያ በአና።</para>
  <para style="q2" vid="PSA 17:15">ታን ደንድያ ዎደ፥ ነ ማላ በኣደ ናሸታና።<verse eid="PSA 17:15"/></para>
  <chapter eid="PSA 17"/>
  <chapter number="18" style="c" sid="PSA 18"/>
  <para style="s1">ጾኑዋ ማዝሙርያ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ ዳዊታ ማዝሙርያ። መና ጎዳይ አ ሞርክያፐነ ሳኦላ ኩሽያፐ አሼዳ ዎደ ዳዊ ተ መና ጎዳዉ ሀ የ የጼዳ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 18:1"/>አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 18:1">ታ ዎልቃዉ፥ ታን ኔና ሲቃይ።<verse eid="PSA 18:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2"/>መና ጎዳይ ታዉ ዎጋ ዛላ፤</para>
  <para style="q2" vid="PSA 18:2">ታን ኦላፐ ናገትያ ሚጻ፤</para>
  <para style="q1" vid="PSA 18:2">እ ታና አሽያዋ።</para>
  <para style="q2" vid="PSA 18:2">ታ ጾሳይ ታን አኮ ባቃትያ ታ ዎጋ ዛላ።</para>
  <para style="q1" vid="PSA 18:2">እ ታ ጎንዳልያ፤ እ ታና አሽያ ዎልቃ፤</para>
  <para style="q2" vid="PSA 18:2">እ ታን ቆሰታ አትያ ሳኣ።<verse eid="PSA 18:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3"/>ጋላታይ በስያ መና ጎዳ ታን ጼሳይ፤</para>
  <para style="q2" vid="PSA 18:3">እ ታ ሞርከቱዋፐ ታና አሼ።<verse eid="PSA 18:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4"/>ሀይቁዋ ዎዶሩ ታና ቃቼዳ፤</para>
  <para style="q2" vid="PSA 18:4">ባሻይ ድኡዋዳን ታና ዳጋንዳ።<verse eid="PSA 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5"/>ዱፉዋ ዎዶሩ ታና ቃቼዳ፤</para>
  <para style="q2" vid="PSA 18:5">ሀይቁ ጲርያዳን ታና ኦይቄዳ።<verse eid="PSA 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6"/>ታና መቱ ኢስና፥ መና ጎዳ ጼሳድ፤</para>
  <para style="q2" vid="PSA 18:6">“ታና ማዳ” ጋደ ታ ጾሳዉ ዋሳድ።</para>
  <para style="q1" vid="PSA 18:6">እ ባረ ጌሻ ሳኣን ታ ኮሻ ስሴዳ፤</para>
  <para style="q2" vid="PSA 18:6">ታን ዋሴዳ ዋሱ አ ሀይን ዎዳ።<verse eid="PSA 18:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7"/>ዎና ጾሳይ ሀንቀቴዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 18:7">ቢታይ ዪቂዪቂደ ቃጼዳ፤</para>
  <para style="q2" vid="PSA 18:7">ደረቱዋ ጻጱ ጋጅ ጋጂደ ኮኮሬዳ።<verse eid="PSA 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8"/>አ ሲያፐ ሀንቁዋ ጩዋይ ጩዋቴዳ፤</para>
  <para style="q2" vid="PSA 18:8">አ ዶናፐ ምያ ታማ ላጩነ ጹግያ ቦንቁ ከሴዳ።<verse eid="PSA 18:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9"/>ሳሉዋ እ ጳልቂደ፥ ዱገ ዎዳ፤</para>
  <para style="q2" vid="PSA 18:9">ሄ ዎደ አ ገድያፐ ጋርሳና ስቅመቴዳ ሻሪ ደኤ።<verse eid="PSA 18:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10"/>ቀፍያና ደእያ ኪታንቻ ክሩብያን ኡቲደ ፓሌዳ፤</para>
  <para style="q2" vid="PSA 18:10">ጫርኩዋ ቀፍያ አኪደ ኤሌሌዳ።<verse eid="PSA 18:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11"/>ባረና ማን ካሜዳ፤</para>
  <para style="q2" vid="PSA 18:11">አ ዱንካኒ እራና ስቅመቴዳ ሻርያ።<verse eid="PSA 18:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12"/>አ ስንን ደእያ ዎልቃማ ፖኡዋፐ</para>
  <para style="q2" vid="PSA 18:12">ሻቻይነ ታማ ላጩ ከሴዳ፤</para>
  <para style="q1" vid="PSA 18:12">ከሲደ ስቅመቴዳ ሻርያ አደ ቤዳ።<verse eid="PSA 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13"/>ቃይ መና ጎዳይ ጉጉንዳን ሳሉዋፐ ጉሜዳ፤</para>
  <para style="q2" vid="PSA 18:13">ኡባፐ ቂያ ጾሳይ ዋልቃንንነ ታማ ላጩዋን ቆንጬዳ።<verse eid="PSA 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14"/>ባረ ዎንዳፍያ ጩብያ የዲደ፥</para>
  <para style="q2" vid="PSA 18:14">ባረ ሞርከቱዋ ላሌዳ፤</para>
  <para style="q2" vid="PSA 18:14">ዋልቃን ፖኡዋ ኪቲደ፥ ኡንቱንታ የደርሴዳ።<verse eid="PSA 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15"/>አቤት መና ጎዳዉ፥ ኔን ሴሬዳ ዎደነ፥</para>
  <para style="q2" vid="PSA 18:15">ሀንቀታደ ፔኑቄዳ ዎደ፥</para>
  <para style="q2" vid="PSA 18:15">አባ ሃይ ግሴዳ ቢታይ ቤቴዳ።</para>
  <para style="q2" vid="PSA 18:15">ቃይ ሳኣ ባሱካ ቆንጬዳ።<verse eid="PSA 18:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16"/>ጾሳይ ቦላፐ ኩሽያ ዱገ የዲደ፥</para>
  <para style="q2" vid="PSA 18:16">ታና ኦይቄዳ፤</para>
  <para style="q2" vid="PSA 18:16">ጪሞ ሃፐ ታና ከሴዳ።<verse eid="PSA 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17"/>እ ታና ታ ዎልቃማ ሞርክያፐነ፥</para>
  <para style="q2" vid="PSA 18:17">ታና እጽያዋንቱፐ አሼዳ።</para>
  <para style="q1" vid="PSA 18:17">አያዉ ጎፐ፥ ኡንቱንቱ ታዉ ሎይ ዳሮ ዎልቃማ።<verse eid="PSA 18:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18"/>ታ ዋይያ ጋላስ ኡንቱንቱ ታ ቦላ ደንዴድኖ፤</para>
  <para style="q2" vid="PSA 18:18">ሽን መና ጎዳይ ታና ዘምፕስያዋ።<verse eid="PSA 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19"/>እ ታና አኮ ሳኣ ከሴዳ፤</para>
  <para style="q2" vid="PSA 18:19">ታናን ናሸቴዳ ድራዉ፥ ታና አሼዳ።<verse eid="PSA 18:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20"/>ታ ጽሎተዳን መና ጎዳይ ታዉ ጭጌዳ፤</para>
  <para style="q2" vid="PSA 18:20">ታ ኩሽያ ጌሻተዳን እ ታዉ ዛሬዳ።<verse eid="PSA 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21"/>ታን መና ጎዳ ኦግያ ካላድ፤</para>
  <para style="q2" vid="PSA 18:21">ታን ታ ጾሳ አጋደ ዎራ ባበይከ።<verse eid="PSA 18:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22"/>ታን አ ህግያ ኡባ ናጋድ፤</para>
  <para style="q2" vid="PSA 18:22">አ ዎጋ ፖልያዋ አጋበይከ።<verse eid="PSA 18:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23"/>ታን አ ስንን ሱረ ደኣድ፤</para>
  <para style="q2" vid="PSA 18:23">ታን ታና ናጋራፐ ናጋድ።<verse eid="PSA 18:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24"/>ሄዋ ድራዉ፥ መና ጎዳይ ታዉ ታ ጽሎተዳንነ</para>
  <para style="q2" vid="PSA 18:24">ታ ኩሺ አ ስንን ጌሻ ግድያዋዳን ዛሬዳ።<verse eid="PSA 18:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25"/>አቤት ጾሳዉ፥ አማነትያዋንቶ ኔን አማነትያዋ፤</para>
  <para style="q2" vid="PSA 18:25">ሱረቶ ኔንካ ሱረ።<verse eid="PSA 18:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26"/>ጌሻቶ ኔንካ ጌሻ፤</para>
  <para style="q2" vid="PSA 18:26">ሽን ጌላቶ ኔን ጭንጫ።<verse eid="PSA 18:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27"/>ባረንታ ሆክስያዋንታ አሻሳ፤</para>
  <para style="q2" vid="PSA 18:27">ሽን ባረንታ ቂስያዋንታ ኔን ዝቂሳሳ።<verse eid="PSA 18:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28"/>አቤት መና ጎዳዉ፥ ኔን ታ ጾምፕያ ፖእሳሳ፤</para>
  <para style="q2" vid="PSA 18:28">ታ ጾሳይ ፖእስና፥ ታ ማይ ክቼ።<verse eid="PSA 18:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29"/>ነ ማዱዋን ታን ታ ሞርከ ዎታዳራቱዋ ኦላይ፤</para>
  <para style="q2" vid="PSA 18:29">ታ ጾሳን ታን ኡንቱንቱ ሚጻ ጼራና ጉፓ አይ።<verse eid="PSA 18:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30"/>ጾሳ ኦጊ ሱረ።</para>
  <para style="q2" vid="PSA 18:30">መና ጎዳ ቃላይ ጌሻ።</para>
  <para style="q1" vid="PSA 18:30">አኮ ባቃትያ ኡባቶ እ ጎንዳለ።<verse eid="PSA 18:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31"/>ጾሳፐ አትና፥ ሀራ መና ጎዳይ ባዋ፤</para>
  <para style="q2" vid="PSA 18:31">ኑ ጾሳፐ አትና፥ ሀራ ዎጋ ዛል ባዋ።<verse eid="PSA 18:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32"/>ታዉ ዎልቃ እምያዌነ</para>
  <para style="q2" vid="PSA 18:32">ታ ኦግያ ሳሮ ኦያዌ ጾሳተኔ።<verse eid="PSA 18:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33"/>እ ታ ገድያ ገንእያ ገድያዳን ምንሴ፤<note caller="-" style="x"><char style="xo" closed="false">18:33 </char><char style="xt" closed="false"><ref loc="HAB 3:19">እምባ. 3:19</ref></char></note></para>
  <para style="q2" vid="PSA 18:33">ታና ቃ ሳአቱዋን ሳሮተን ዎ።<verse eid="PSA 18:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34"/>እ ታ ኩሽያ ኦላ ሜዘዬ፤</para>
  <para style="q2" vid="PSA 18:34">ሄዋ ድራዉ፥ ታን ታ ቀስያን</para>
  <para style="q2" vid="PSA 18:34">ናስያ ግያ ብራታ ዎንዳፍያ ዳፋደ ዱካይ።<verse eid="PSA 18:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35"/>ታና አሽያ ነ ጎንዳልያ ኔን ታዉ እማዳ።</para>
  <para style="q2" vid="PSA 18:35">ነ ኡሸቻ ኩሺ ታና ዘምፕሴ፤</para>
  <para style="q2" vid="PSA 18:35">ነ ሎኦ ኦይይ ታና ቂሴ።<verse eid="PSA 18:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36"/>ታ ሀመትያሳ አሳሳ፤</para>
  <para style="q2" vid="PSA 18:36">ሄዋ ድራዉ፥ ታ ገዲ ሀልጽቤና።<verse eid="PSA 18:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37"/>ታ ሞርከቱዋ ታን የደርሳ ኦይቃድ፤</para>
  <para style="q2" vid="PSA 18:37">ታን ኡንቱንታ ይሰናን ደኣደ ጉየ ስማበይከ።<verse eid="PSA 18:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38"/>ታን ኡንቱንታ ላኤን ደንደናዳን ሾጫድ፤</para>
  <para style="q2" vid="PSA 18:38">ኡንቱንቱ ታ ገድያን ኩንዴድኖ።<verse eid="PSA 18:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39"/>ኦላዉ ታና ዎልቃ ዳንጭሳዳ፤</para>
  <para style="q2" vid="PSA 18:39">ታናና ጋዳትያዋንታ ታዉ ጉልባትሳዳ።<verse eid="PSA 18:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40"/>ታ ሞርከቱዋ ታ ስንፐ ጉየ ባቃትሳዳ፤</para>
  <para style="q2" vid="PSA 18:40">ታና እጽያዋንታ ታን ይሳድ።<verse eid="PSA 18:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41"/>ባረንታ ማዳና ማላ ዋሴድኖ፥</para>
  <para style="q2" vid="PSA 18:41">ሽን ኦንነ ኡንቱንታ አሽቤና።</para>
  <para style="q1" vid="PSA 18:41">መና ጎዳካ ኡንቱንቱ ጼሴድኖ፥</para>
  <para style="q2" vid="PSA 18:41">ሽን እ ኡንቱንቶ ኮይቤና።<verse eid="PSA 18:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42"/>ጫርኩ ፕቲደ አፍያ ባናዳን ታን ኡንቱንታ ሊቅሳድ፤</para>
  <para style="q2" vid="PSA 18:42">ኦግያን ደእያ ኡርቃዳንካ ኡንቱንታ የድ።<verse eid="PSA 18:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43"/>ማካላ አሳፐ ታና አሻዳ።</para>
  <para style="q2" vid="PSA 18:43">ታና ካዉተቱዋ ቦላን ሱንዳ፤</para>
  <para style="q2" vid="PSA 18:43">ታን ኤረና አሳይ ታዉ ሞደቴዳ።<verse eid="PSA 18:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 18:44"/>ኡንቱንቱ ታ ዎርያ ስሲደ፥ ታዉ አዛዘቲኖ፤</para>
  <para style="q2" vid="PSA 18:44">አላጋ ደረ አሳይካ ታ ስንን ሆኪኖ።<verse eid="PSA 18:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45"/>ኡንቱንቱ ዎዛና ካሃ አጊኖ።</para>
  <para style="q2" vid="PSA 18:45">ባረንቱ ናገትያ ሚጻፐ ኮኮሪደ ዪኖ።<verse eid="PSA 18:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46"/>መና ጎዳይ ደኤ!</para>
  <para style="q2" vid="PSA 18:46">ጾሳይ፥ ታ ዎጋ ዛላይ ጋላተቶ!</para>
  <para style="q1" vid="PSA 18:46">ታና አሽያ ጾሳይ ቁ ቁ ጎ!<verse eid="PSA 18:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47"/>እ ታ ሀሉዋ ከስያ ጾሳ፤</para>
  <para style="q2" vid="PSA 18:47">ካዉተቱዋ ታፐ ጋርሳና ሞድስያዋ፤<verse eid="PSA 18:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 18:48"/>ታ ሞርከቱዋፐ ታና አሽያዋ።</para>
  <para style="q2" vid="PSA 18:48">አቤት ጾሳዉ፥ ኔን ታናና ጋዳትያዋንቱ ቦላን</para>
  <para style="q2" vid="PSA 18:48">ታና ቁ ቁ ኦሳ፤</para>
  <para style="q2" vid="PSA 18:48">ማካላንቻ አሳቱዋፐ ኔን ታና አሻሳ።<verse eid="PSA 18:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49"/>ሄዋ ድራዉ፥ ታን ኔና ካዉተቱዋ ግዶን ጋላታና፤<note caller="-" style="x"><char style="xo" closed="false">18:49 </char><char style="xt" closed="false"><ref loc="ROM 15:9">ሮመ 15:9</ref></char></note></para>
  <para style="q2" vid="PSA 18:49">ታን መና ጎዳ ሱን ሳባና።<verse eid="PSA 18:49"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50"/>ጾሳይ ባረ ካትያዉ ጾኑዋ ቦላን ጾኑዋ እሜ።</para>
  <para style="q2" vid="PSA 18:50">ባረ ኦኬዳ፥ ዳዊተዉነ አ ዘረዉ፥</para>
  <para style="q2" vid="PSA 18:50">ሎኦተ መናዉ በሴ።<verse eid="PSA 18:50"/></para>
  <chapter eid="PSA 18"/>
  <chapter number="19" style="c" sid="PSA 19"/>
  <para style="s1">ጾሳይ ጽሎተ አዋ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ዳዊታ ማዝሙርያ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1"/>ሳሎቱ ጾሳ ቦንቹዋ ሃሳዪኖነ</para>
  <para style="q2" vid="PSA 19:1">ሳሎቱዋ ጉፋን እ ባረ ኩሽያን ኦዳዋ አዋዬ።<verse eid="PSA 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2"/>እት ጋላሳይ የንኮ ጋላሳዉ ሄዋ ኦዴ፤</para>
  <para style="q2" vid="PSA 19:2">እት ቃማይካ የንኮ ቃማዉ ኤራተ ቆንጭሴ።<verse eid="PSA 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3"/>ሃሳይ ዎይ ቃላይ ባዋ፤</para>
  <para style="q2" vid="PSA 19:3">ኡንቱንቱ ኮሻይካ ስሰተና።<verse eid="PSA 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4"/>ግዶፐካ፥ ኡንቱንቱ ሃሳያ ኮሻይ ሳኣ ኡባን ላለቴዳ፤<note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="ROM 10:18">ሮመ 10:18</ref></char></note></para>
  <para style="q2" vid="PSA 19:4">ኡንቱንቱ ቃላይካ ሳኣ ጋጻ ጋኬዳ።</para>
  <para style="b" vid="PSA 19:4"/>
  <para style="q1" vid="PSA 19:4">ጾሳይ አዋይ ደእያ ሳኣ ሳሉዋን ጊግሴዳ።<verse eid="PSA 19:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 19:5"/>ናሸቲደ ካረ ሶፐ ከስያ ምሽራዳን፥</para>
  <para style="q2" vid="PSA 19:5">ዎ ናስያዉ ጊጌዳ ዎንቻዳን፥</para>
  <para style="q2" vid="PSA 19:5">አዋይ ዎንታ ዎንታ ከሴ።<verse eid="PSA 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6"/>አዋይ እት ባጋ ሳሉዋ ጋጻፐ ሞኪደ፥</para>
  <para style="q2" vid="PSA 19:6">ሀራ ባጋ ሳሉዋ ጋጻ ጋካናስ ቤ፤</para>
  <para style="q1" vid="PSA 19:6">አ ሆኡዋፐ ጌምያዌ አያይነ ባዋ።<verse eid="PSA 19:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7"/>መና ጎዳ ህጊ ሱረ፤</para>
  <para style="q2" vid="PSA 19:7">ሸምፑዋ ዛሬ።</para>
  <para style="q1" vid="PSA 19:7">መና ጎዳይ ኦድያዌ አማነትያዋ፤</para>
  <para style="q2" vid="PSA 19:7">አኬካይ ፓጬዳዋንቶ ኤራተ እሜ።<verse eid="PSA 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8"/>መና ጎዳ ዎጋይ ልከ፤</para>
  <para style="q2" vid="PSA 19:8">ዎዛና ናሸቼ።</para>
  <para style="q1" vid="PSA 19:8">መና ጎዳ አዛዙ ጌሻ፤</para>
  <para style="q2" vid="PSA 19:8">ዎዛና ፖእሴ።<verse eid="PSA 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9"/>መና ጎዳዉ ያይያዌ ጌሻተ፤</para>
  <para style="q2" vid="PSA 19:9">ሄዌ መናዉካ ኤቂድ ደእያዋ።</para>
  <para style="q1" vid="PSA 19:9">መና ጎዳ ፕርዳይ ቱማነ ጽሉዋ።<verse eid="PSA 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10"/>ዎርቃፐነ ዋላክ ባይና ዎርቃፐ አደ ዶሰቴ፤</para>
  <para style="q2" vid="PSA 19:10">ኤሳፐነ ኤሳ እልሉዋፐ አ ማልኤ።<verse eid="PSA 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11"/>ቃይ ታና ነ ቆማ ናገታናዳን ዞሬ፤</para>
  <para style="q2" vid="PSA 19:11">ነ ህግያ ናጉ ዳሮ ጎኤ።<verse eid="PSA 19:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12"/>ባረ ሁጲያ ባላ ደምያዌ ኦኔ?</para>
  <para style="q2" vid="PSA 19:12">አቤት ጾሳዉ፥ ጌሜዳ ናጋራፐ ታና ጌሻ።<verse eid="PSA 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13"/>ቃይ ታን፥ ነ ቆማይ፥</para>
  <para style="q2" vid="PSA 19:13">ጻላን ናጋራ ኦናዳን፥</para>
  <para style="q2" vid="PSA 19:13">ኔን ታና ናጋ።</para>
  <para style="q2" vid="PSA 19:13">ታና ናጋራዉ ሞድሶፓ፤</para>
  <para style="q2" vid="PSA 19:13">ሄ ዎደ ታን ሱረ ግዳደ፥</para>
  <para style="q2" vid="PSA 19:13">ዎልቃማ ባይዙዋፐ ጌያና።<verse eid="PSA 19:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14"/>አቤት መና ጎዳዉ፥ ታ ዎጋ ዛላዉ፥</para>
  <para style="q2" vid="PSA 19:14">ታና ዎዜዳዎ፥</para>
  <para style="q1" vid="PSA 19:14">ታ ዶናፐ ከስያ ቃላይነ</para>
  <para style="q2" vid="PSA 19:14">ታ ዎዛና ቆፋይ ኔና ናሸችያዋ ግዶ።<verse eid="PSA 19:14"/></para>
  <chapter eid="PSA 19"/>
  <chapter number="20" style="c" sid="PSA 20"/>
  <para style="s1">ካትያዉ ዎሳ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ዳዊታ ማዝሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 20:1"/>ኔን መቶቴዳ ዎደ መና ጎዳይ ነ ዎሳ ስሶ፤</para>
  <para style="q2" vid="PSA 20:1">ያቆባ ጾሳ ሱንይ ኔና ምንሶ።<verse eid="PSA 20:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2"/>ባረ ጌሻ ሳኣፐ ነዉ ማዱዋ ኪቶ፤</para>
  <para style="q2" vid="PSA 20:2">ጽዮነፐ ኔና ዘምፕሶ።<verse eid="PSA 20:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3"/>ነ ያርሹዋ ኡባ እ ነዉ ሀሳዮ፤</para>
  <para style="q2" vid="PSA 20:3">ነ ጹግያ ያርሹዋን ናሸቶ።<verse eid="PSA 20:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4"/>ነ ዎዛና አሙዋ ነዉ እሞ፤</para>
  <para style="q2" vid="PSA 20:4">ነ ሀልቹዋ ኡባ ፖሎ።<verse eid="PSA 20:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5"/>ነ ጾኑዋ ድራዉ፥ ኑን ናሸቻዉ ሆምቦጫና፤</para>
  <para style="q2" vid="PSA 20:5">ኑ ጾሳ ሱንን ኑ ባንድራ ቁ ኦና።</para>
  <para style="q1" vid="PSA 20:5">ኔን ዎሴዳዋ ኡባ መና ጎዳይ ነዉ እሞ።<verse eid="PSA 20:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6"/>መና ጎዳይ ባረ ዶሬዳ ካትያዉ</para>
  <para style="q2" vid="PSA 20:6">ጾኑዋ እምያዋ ታን ብሮ ኤራይ።</para>
  <para style="q1" vid="PSA 20:6">እ ባረ ጌሻ ሳሉዋን ስሳና፤</para>
  <para style="q2" vid="PSA 20:6">ባረ ኡሸቻ ኩሽያን ዎልቃማ ጾኑዋ አዉ እማና።<verse eid="PSA 20:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7"/>እቱ እቱ ባረንቱ ኦላ ፓራይ ጎችያ ጋርያን፥</para>
  <para style="q2" vid="PSA 20:7">ሀራቱ ባረንቱ ፓራን ጬቀቲኖ፤</para>
  <para style="q2" vid="PSA 20:7">ሽን ኑን መና ጎዳ ኑ ጾሳ ዎልቃን ጬቀቴቶ።<verse eid="PSA 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8"/>ኡንቱንቱ በቲደ ኩንዳና፤</para>
  <para style="q2" vid="PSA 20:8">ሽን ኑን ደንዲደ፥ ምን ኤቃና።<verse eid="PSA 20:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9"/>አቤት መና ጎዳዉ፥ ካትያዉ ጾኑዋ እማ፤</para>
  <para style="q2" vid="PSA 20:9">ኑን ኔና ጼስያ ዎደ ስሳ።<verse eid="PSA 20:9"/></para>
  <chapter eid="PSA 20"/>
  <chapter number="21" style="c" sid="PSA 21"/>
  <para style="s1">ጾኑዋ ድራዉ ጋላታ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ዳዊታ ማዝሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1"/>አቤት መና ጎዳዉ፥ ካቲ ነ ምኖተን ሀሹ ጌ፤</para>
  <para style="q2" vid="PSA 21:1">ኔን እሜዳ ጾኑዋን እ አያ ናሸቲ!<verse eid="PSA 21:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2"/>ኔን አ ዎዛና አሙዋ አዉ እማዳ፤</para>
  <para style="q2" vid="PSA 21:2">ቃይ እ ኔና ባረ እንጻርሳን ኦቼዳዋ ድጋባካ።<verse eid="PSA 21:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3"/>ኔን ሎኦ አንጁዋን አ ሞካሳ፤</para>
  <para style="q2" vid="PSA 21:3">ጌሻ ዎርቃ ካላቻ አ ሁጲያን ዎሳ።<verse eid="PSA 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4"/>ኔን ደኡዋ አዉ እማናዳን ኔና ዎሴዳ፤</para>
  <para style="q2" vid="PSA 21:4">አዉ ጮራ ላይነ አዱሳ ደኡዋ እማዳ።<verse eid="PSA 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5"/>ኔን ጾኑዋ እሜዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 21:5">አ ቦንቹ ዳሬ፤ ግታተነ አንጋ አዉ እማዳ።<verse eid="PSA 21:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6"/>ኔን አዉ መና አንጁዋ እማሳ፤</para>
  <para style="q2" vid="PSA 21:6">ኔን እትፐ ደእያዋን አ ናሸቻሳ።<verse eid="PSA 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7"/>ካቲ መና ጎዳን አማነቴ።</para>
  <para style="q2" vid="PSA 21:7">ኡባፐ ቂያ ጾሳ ሎኦተ ድራዉ፥</para>
  <para style="q1" vid="PSA 21:7">እ ቃጸና።<verse eid="PSA 21:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8"/>ነ ኩሺ ነ ሞርከቱዋ ኡባ ኩቱታና፤</para>
  <para style="q2" vid="PSA 21:8">ነ ኡሸቻይ ኔና እጽያዋንታ ደማና።<verse eid="PSA 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9"/>ኔን ቆንጭያ ዎደ፥</para>
  <para style="q2" vid="PSA 21:9">ኡንቱንታ ጮጭያ ታማዳን ጹጋና።</para>
  <para style="q1" vid="PSA 21:9">መና ጎዳይ ባረ ሀንቁዋ ሱሉዋን ኡንቱንታ ምታና፤</para>
  <para style="q2" vid="PSA 21:9">አ ታማይካ ኡንቱንታ ም ይሳና።<verse eid="PSA 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10"/>ኔን ኡንቱንቱ ናናቱዋ ቢታፐ፥</para>
  <para style="q2" vid="PSA 21:10">ኡንቱንቱ ዘረካ አሳ ግዶፐ ይሳና።<verse eid="PSA 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11"/>ነ ሞርከቱ ነ ቦላ ሺቅኖነ</para>
  <para style="q2" vid="PSA 21:11">ኢታባ ማቀቲኖ፤ ሽን ፖልክኖ።<verse eid="PSA 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12"/>አያዉ ጎፐ፥ ኔን ኡንቱንታ ነ ዎንዳፍያ ፖን ዱካናዉ ባብሳና፤</para>
  <para style="q2" vid="PSA 21:12">ባብሳደ ጉየ ዛራደ ባቃትሳና።<verse eid="PSA 21:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13"/>አቤት መና ጎዳዉ፥ ነ ምኖተን ቁ ቁ ጋ፤</para>
  <para style="q2" vid="PSA 21:13">ነ ዎልቃ ድራዉ ነዉ ጋላታ ማዝሙርያ የጼቶ።<verse eid="PSA 21:13"/></para>
  <chapter eid="PSA 21"/>
  <chapter number="22" style="c" sid="PSA 22"/>
  <para style="s1">ጽሎ አሳ መቱዋነ ህዶታ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ዳዊታ ማዝሙርያ። ዎንታ ጉራ “ገንእያ” የዳን የጸቴዳ ዳዊታ ማዝሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1"/>ታ ጾሳዉ፥ ታ ጾሳዉ፥ ታና አያዉ አጋዲ?<note caller="-" style="x"><char style="xo" closed="false">22:1 </char><char style="xt" closed="false"><ref loc="MAT 27:46">ማቶሳ 27:46</ref>፤ <ref loc="MRK 15:34">ማር. 15:34</ref></char></note></para>
  <para style="q2" vid="PSA 22:1">ታና ማዳ ጋደ ታን ነዉ ዋትዋትያ ዎደ፥</para>
  <para style="q3" vid="PSA 22:1">አያዉ ታፐ ሃካይ?<verse eid="PSA 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2"/>አቤት ታ ጾሳዉ፥ ጋላሳን ኡባን ታን ነዉ ዋሳይ፤</para>
  <para style="q2" vid="PSA 22:2">ሽን ኔን ታዉ አላካ።</para>
  <para style="q1" vid="PSA 22:2">ቃማን ኡባንካ ነዉ ዋሳይ፥</para>
  <para style="q2" vid="PSA 22:2">ሽን ዎፓ ደምከ።<verse eid="PSA 22:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3"/>ግዶፐነ፥ ኔን ጌሻ።</para>
  <para style="q2" vid="PSA 22:3">እስራኤልያ ጋላታይ ነ አራታ ዩሹዋን ደኤ።<verse eid="PSA 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4"/>ካሰ ኑ አዎቱ ኔናን አማነቴድኖ፤</para>
  <para style="q2" vid="PSA 22:4">ኔናን አማነትና፥ ኔን ኡንቱንታ አሻዳ።<verse eid="PSA 22:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5"/>ነዉ ዋሲደ አቴድኖ፤</para>
  <para style="q2" vid="PSA 22:5">ኔናን አማነቲደ ዬላትበይክኖ።<verse eid="PSA 22:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6"/>ሽን ታን አሳ ግድከ፤ ታን ጉጹንያ።</para>
  <para style="q2" vid="PSA 22:6">ታን አሳን ካተዳዋነ ቅሊጨቴዳዋ።<verse eid="PSA 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7"/>ታና በእያ ኡባቱ ቅኖ፤<note caller="-" style="x"><char style="xo" closed="false">22:7 </char><char style="xt" closed="false"><ref loc="MAT 27:39">ማቶሳ 27:39</ref>፤ <ref loc="MRK 15:29">ማር. 15:29</ref>፤ <ref loc="LUK 23:35">ሉቃሳ 23:35</ref></char></note></para>
  <para style="q2" vid="PSA 22:7">ኡንቱንቱ ታና ጽት ጼሊኖነ ባረንቱ ሁጲያ ቃኖ።<verse eid="PSA 22:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8"/>ያቶፐ፥ “እ መና ጎዳን አማነቴዳ፤<note caller="-" style="x"><char style="xo" closed="false">22:8 </char><char style="xt" closed="false"><ref loc="MAT 27:43">ማቶሳ 27:43</ref></char></note></para>
  <para style="q2" vid="PSA 22:8">አያዉ አ አሸኔ?</para>
  <para style="q1" vid="PSA 22:8">መና ጎዳይ አ ዶሶፐ፥</para>
  <para style="q2" vid="PSA 22:8">አነ አ አሾ” ያጊኖ።<verse eid="PSA 22:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9"/>ግዶፐነ፥ ታና ታ አት ኡሉዋፐ ሱረ የልሴዳዌ ኔና፤</para>
  <para style="q2" vid="PSA 22:9">ታ አት ን ምያ ዎደካ ታን አማነታናዳን ኦዳ።<verse eid="PSA 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10"/>ታን የለቶደፐ ዶማደ ኔናን ድጫድ፤</para>
  <para style="q2" vid="PSA 22:10">ታ አት ኡሉዋፐ ዶማደካ፥ ኔን ታ ጾሳ።<verse eid="PSA 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11"/>መቱ ታኮ ማትያ ድራዉነ</para>
  <para style="q2" vid="PSA 22:11">ታና ማድያዌ ባይና ድራዉ፥</para>
  <para style="q1" vid="PSA 22:11">ሀእ ኔን ታፐ ሃኮፓ።<verse eid="PSA 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12"/>ዳሮ ሞርከቱ ኮሩማ ቦራቱዋዳን ታና ዶዲኖ፤</para>
  <para style="q2" vid="PSA 22:12">ቃይጭያ ባሳነ ቢታ ቦራቱዋዳን ታና ዶዲኖ።<verse eid="PSA 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13"/>መንሬያነ ጉድያ ጋሙዋዳን</para>
  <para style="q2" vid="PSA 22:13">ባረንቱ ዶና ታ ቦላ ሀንጊኖ።<verse eid="PSA 22:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14"/>ታን ሃዳን ጎጋድ፤</para>
  <para style="q2" vid="PSA 22:14">ታ መቀቱ ባረንቱ ኩሻፐ ኮለቴድኖ።</para>
  <para style="q1" vid="PSA 22:14">ታ ዎዛናይ ኤሳ ሙቃዳ ማላ፥</para>
  <para style="q2" vid="PSA 22:14">ታ ግዶን ሴር ዉሬ።<verse eid="PSA 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15"/>ታ ቆ ኮንኣዳን መሌ፤</para>
  <para style="q2" vid="PSA 22:15">ታ እንጻርሳይ ኮክያና ኦይቀቴ።</para>
  <para style="q1" vid="PSA 22:15">ኔን ታና ሀይቄዳ አሳዳን ባናን የጋዳ።<verse eid="PSA 22:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16"/>ካናቱ ታና ተኤድኖ፤</para>
  <para style="q2" vid="PSA 22:16">ኢታ አሳቱ ታ ዩሹዋን ዶዴድኖ።</para>
  <para style="q1" vid="PSA 22:16">ታ ኩሸቱዋነ ታ ገደቱዋ ጫዲኖ።<verse eid="PSA 22:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17"/>ታ መቀቱዋ ኡባ ታን ፓይዳይ።</para>
  <para style="q2" vid="PSA 22:17">ታ ሞርከቱ ታና ጼሊኖነ ደረቂኖ።<verse eid="PSA 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18"/>ታ ማዩዋ ሻክ አኪኖ፤<note caller="-" style="x"><char style="xo" closed="false">22:18 </char><char style="xt" closed="false"><ref loc="MAT 27:35">ማቶሳ 27:35</ref>፤ <ref loc="MRK 15:24">ማር. 15:24</ref>፤ <ref loc="LUK 23:34">ሉቃሳ 23:34</ref>፤ <ref loc="JHN 19:24">ዮሃ. 19:24</ref></char></note></para>
  <para style="q2" vid="PSA 22:18">ታ አዱሳ ማዩዋን ሳማ የጊኖ።<verse eid="PSA 22:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19"/>አቤት መና ጎዳዉ፥ ኔን ታፐ ሃኮፓ።</para>
  <para style="q2" vid="PSA 22:19">አቤት ታ ዎልቃዉ፥ ታና ማዳናዉ ኤለካ ሃያ።<verse eid="PSA 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20"/>ታና ማሻፐ አሻ፤</para>
  <para style="q2" vid="PSA 22:20">ታ አልኦ ደእያ ካናቱዋ ዎልቃፐ አሻ።<verse eid="PSA 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21"/>ጋሞቱዋ ዶናፐ ታና አሻ፤</para>
  <para style="q2" vid="PSA 22:21">ቃይጭያ ባዙዋ ቦራቱዋ ካጭያፐ ታና ናጋ።<verse eid="PSA 22:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22"/>ታን ነ ሱን ታ እሻቶ ኦዳና፤<note caller="-" style="x"><char style="xo" closed="false">22:22 </char><char style="xt" closed="false"><ref loc="HEB 2:12">እብራ. 2:12</ref></char></note></para>
  <para style="q2" vid="PSA 22:22">ማባራ ሺቁዋንካ ኔና ጋላታና።<verse eid="PSA 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23"/>ህንተኖ፥ መና ጎዳዉ ያይያዋንቶ፥ አ ጋላትተ።</para>
  <para style="q2" vid="PSA 22:23">ህንተኖ፥ ያቆባ ዘረቶ፥</para>
  <para style="q2" vid="PSA 22:23">ኡባይካ አ ቦንችተ።</para>
  <para style="q2" vid="PSA 22:23">ህንተኖ፥ እስራኤልያ ዘረቶ፥</para>
  <para style="q2" vid="PSA 22:23">ኡባቱካ ቦንቹዋን አዉ ያይተ።<verse eid="PSA 22:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24"/>እ ናቀቴዳዋንታ ካና፤</para>
  <para style="q2" vid="PSA 22:24">ኡንቱንታ ጋኬዳ ቆሁዋ ታዉ አይ መቴ ጌና።</para>
  <para style="q1" vid="PSA 22:24">ባረ ሶምኡዋ ኡንቱንቱፐ ገንና፤</para>
  <para style="q2" vid="PSA 22:24">ሽን ኡንቱንቱ ማዶ አኮ ዋስያ ዎድያን፥</para>
  <para style="q2" vid="PSA 22:24">ኡንቱንቱ ዋሱዋ ስሴ።<verse eid="PSA 22:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25"/>ታን ኔን ኦዳ ሎኦ ኦሱዋ ድራዉ፥</para>
  <para style="q2" vid="PSA 22:25">ኩንዳ ሺቁዋን ጋላታና።</para>
  <para style="q1" vid="PSA 22:25">ታን ሺቀቴዳዋ ነዉ ያይያ አሳ ስንን ጋና።<verse eid="PSA 22:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26"/>ህዬሳቱ ሚደ ካላና።</para>
  <para style="q2" vid="PSA 22:26">መና ጎዳ ኮይያዋንቱ አ ጋላታና።</para>
  <para style="q1" vid="PSA 22:26">ኡንቱንቱ መናዉ ደአና።<verse eid="PSA 22:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27"/>ሳኣ ጋጻ ጋካናዉ አሳይ ኡባይ</para>
  <para style="q2" vid="PSA 22:27">ሀሳዪደ፥ መና ጎዳኮ ስማና።</para>
  <para style="q1" vid="PSA 22:27">አሳ ዛረ ኡባይ አዉ ጎይናና።<verse eid="PSA 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28"/>አያዉ ጎፐ፥ ካተትያ ማታይ መና ጎዳዋ፤</para>
  <para style="q2" vid="PSA 22:28">ካዉተቱዋ እ ሞዴ።<verse eid="PSA 22:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29"/>ሳኣን ደእያ ዱረ አሳቱ ኡባይ</para>
  <para style="q2" vid="PSA 22:29">አዉ ጎይናና።</para>
  <para style="q1" vid="PSA 22:29">ባረንታ ሀይቁዋፐ አሻናዉ ዳንዳየናዋንቱነ</para>
  <para style="q2" vid="PSA 22:29">ባናዉ ላመትያዋንቱ ኡባቱ አዉ ጉልባታና።<verse eid="PSA 22:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30"/>ይያ ዘረይ አዉ ኪተታና፤</para>
  <para style="q2" vid="PSA 22:30">አሳይ ጎዳ ኦሱዋ ይያ የለታዉ ኦዳና።<verse eid="PSA 22:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31"/>ብሮ የለትቤና አሳይካ አ ጽሎተ ኦዳና።</para>
  <para style="q2" vid="PSA 22:31">“ጾሳይ ባረ አሳ አሼዳ” ያግያዌ ኦደታና።<verse eid="PSA 22:31"/></para>
  <chapter eid="PSA 22"/>
  <chapter number="23" style="c" sid="PSA 23"/>
  <para style="s1">ሎኦ ሄንንቻ</para>
  <para style="d">ዳዊታ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1"/>መና ጎዳይ ታ ሄንንቻ፤</para>
  <para style="q2" vid="PSA 23:1">ታዉ አያይነ ፓጨና።<verse eid="PSA 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 23:2"/>ታና አጫ ቆሩዋን ሸምፕሴ፤<note caller="-" style="x"><char style="xo" closed="false">23:2 </char><char style="xt" closed="false"><ref loc="REV 7:17">ሳፃ 7:17</ref></char></note></para>
  <para style="q2" vid="PSA 23:2">ዎፑ ጌዳ ሃኮ ላጌ።<verse eid="PSA 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 23:3"/>ታ ደኡዋ ኦራጽሴ።</para>
  <para style="q2" vid="PSA 23:3">ባረ ሱን ድራዉ፥ ታና ጽሎተ ኦግያን ካለ።<verse eid="PSA 23:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4"/>ኔን ታ ጾሳይ ታናና ደእያ ድራዉ፥</para>
  <para style="q2" vid="PSA 23:4">ታን ጵ ጎ ማ ዛንጋራ ግዱዋና ቦፐካ፥</para>
  <para style="q2" vid="PSA 23:4">ኢታባዉ ያይከ።</para>
  <para style="q2" vid="PSA 23:4">ነ ጋትማይነ ነ ጉፊ ታና ምንኖ።<verse eid="PSA 23:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5"/>ታ ሞርከቱዋ ስንን ታዉ ግብራ ማካዳ።</para>
  <para style="q2" vid="PSA 23:5">ታና ሞካድ፥ ታ ሁጲያ ዛይትያ ኦካዳ።</para>
  <para style="q1" vid="PSA 23:5">ታ ዋንጫይ ፓላሂደ ጎጋና ጋካናዉ ኩንዳ።<verse eid="PSA 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6"/>ነ ኬካተይነ ማሮተይ</para>
  <para style="q2" vid="PSA 23:6">ታ ደኡዋ ላይ ኡባን ቱሙዋፐ ታና ካላና።</para>
  <para style="q1" vid="PSA 23:6">ታን መና ጎዳ ጎልያን መናዉ ደአና።<verse eid="PSA 23:6"/></para>
  <chapter eid="PSA 23"/>
  <chapter number="24" style="c" sid="PSA 24"/>
  <para style="s1">ጌሻ ጎልያ ገሉዋ ማዝሙርያ</para>
  <para style="d">ዳዊታ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1"/>ሳአይነ ሳኣን ኩሜዳዌ ኡባይ መና ጎዳዋ፤<note caller="-" style="x"><char style="xo" closed="false">24:1 </char><char style="xt" closed="false"><ref loc="1CO 10:26">1 ቆሮ. 10:26</ref></char></note></para>
  <para style="q2" vid="PSA 24:1">ቢታይነ ቢታን ደእያባይ ኡባይ አዋ።<verse eid="PSA 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2"/>አያዉ ጎፐ፥ ሳኣ ዎልቃማ አባ ቦላን እ ሂጼዳ፤</para>
  <para style="q2" vid="PSA 24:2">ጪሞ ሃ ቦላን ምንሲደ ኤሴ።<verse eid="PSA 24:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3"/>መና ጎዳ ደርያ ግአናዌ ኦኔ?</para>
  <para style="q2" vid="PSA 24:3">አ ጌሻ ሳኣን ኤቃናዌ ኦኔ?<verse eid="PSA 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4"/>አ ኩሺ ናጋራፐ ጌዬዳዋ፥</para>
  <para style="q2" vid="PSA 24:4">አ ዎዛናይ ጌሻ ግዴዳዋ፥<note caller="-" style="x"><char style="xo" closed="false">24:4 </char><char style="xt" closed="false"><ref loc="MAT 5:8">ማቶሳ 5:8</ref></char></note></para>
  <para style="q2" vid="PSA 24:4">ኤቃዉ ጎይነናዋ፥</para>
  <para style="q2" vid="PSA 24:4">ዎርዱዋን ጫቀናዋ።<verse eid="PSA 24:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5"/>እ መና ጎዳፐ አንጁዋ አካና፤</para>
  <para style="q2" vid="PSA 24:5">አሽያ ጾሳፐ እ ጽሎተ ፕርድዳ አካና።<verse eid="PSA 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6"/>ጾሳኮ ጼልያ አሳይነ</para>
  <para style="q2" vid="PSA 24:6">ያቆባ ጾሳ ስን ኮይያ አሳይ ሀዋንቱ ማላ።<verse eid="PSA 24:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7"/>ፐንገቱ ዶየትተ! ቦንቾ ካቲ ገላና ማላ፤</para>
  <para style="q2" vid="PSA 24:7">በን ፐንጋቱ አ ናሸቻን ሞክተ!<verse eid="PSA 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8"/>ሄ ቦንቾ ካቲ ኦኔ?</para>
  <para style="q2" vid="PSA 24:8">ምኑነ ዎልቃማይ መና ጎዳቴ!</para>
  <para style="q1" vid="PSA 24:8">ኦላዉካ እ ዎልቃማ መና ጎዳቴ!<verse eid="PSA 24:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9"/>ፐንገቱ ዶየትተ! ቦንቾ ካቲ ገላና ማላ፤</para>
  <para style="q2" vid="PSA 24:9">በን ፐንጋቱ አ ናሸቻን ሞክተ!<verse eid="PSA 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10"/>ሀ ቦንቾ ካቲ ኦኔ?</para>
  <para style="q2" vid="PSA 24:10">ሀ ቦንቾ ካቲ ሳሉዋ መተቱዋ መና ጎዳቴ!<verse eid="PSA 24:10"/></para>
  <chapter eid="PSA 24"/>
  <chapter number="25" style="c" sid="PSA 25"/>
  <para style="d">ዳዊተ ማዝሙርያ<note caller="+" style="f"><char style="fr" closed="false">25:0 </char><char style="ft" closed="false">ቆፐናባይ ጋክያ ዎደ ሺቅያ ዎሳ።</char></note></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 25:1"/>አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 25:1">ታ ሸምፑዋፐ ኔና ዎሳይ።<verse eid="PSA 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2"/>አቤት ታ ጾሳዉ፥ ታን ኔናን አማነታይ፤</para>
  <para style="q2" vid="PSA 25:2">ታና ዬላዮፓ፤ ታ ሞርከቱዋ ሀይ ከሶፓ።<verse eid="PSA 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3"/>ኔናን ሂዶታ ኦያዋንቱ ዬላትክኖ፤</para>
  <para style="q2" vid="PSA 25:3">ሽን ጋሱ ባይናን ገንያዋንቱ ዬላታና።<verse eid="PSA 25:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4"/>አቤት መና ጎዳዉ፥ ታና ነ ኦግያ በሳ፤</para>
  <para style="q2" vid="PSA 25:4">ነ ኦግያ ታና ታማርሳ።<verse eid="PSA 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5"/>ኔን ታና አሽያ ጾሳ ግድያ ድራዉ፥</para>
  <para style="q2" vid="PSA 25:5">ነ ቱማተን ታና ካለነ ታማርሳ።</para>
  <para style="q1" vid="PSA 25:5">ጋላሳ ኩመንን ታን ኔናን ህዶታ ኦይ።<verse eid="PSA 25:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6"/>አቤት መና ጎዳዉ፥ በኒደፐ ደእያ ነ ቃረታነ</para>
  <para style="q2" vid="PSA 25:6">ነ ኬካተ ሀሳያ።<verse eid="PSA 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7"/>ታ ያላጋተ ናጋራነ ባይዙዋ ሀሳዮፓ።</para>
  <para style="q2" vid="PSA 25:7">አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 25:7">ነ ኬካተነ ሎኦተ ሀሳያ።<verse eid="PSA 25:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8"/>መና ጎዳይ ኬካነ ሱረ፤</para>
  <para style="q2" vid="PSA 25:8">ሄዋ ድራዉ፥ ናጋራንቻቱዋ ባረ ኦግያ ታማርሴ።<verse eid="PSA 25:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9"/>አሽከቱዋ ሱረተን ካለ፤</para>
  <para style="q2" vid="PSA 25:9">አሽከቱዋ ባረ ኦግያ ታማርሴ።<verse eid="PSA 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10"/>መና ጎዳ ጫቁዋነ አ አዋዩዋ ናግያዋንቶ</para>
  <para style="q2" vid="PSA 25:10">አ ኦጊ ኡባይ ቱማተነ ኬካተ።<verse eid="PSA 25:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11"/>አቤት መና ጎዳዉ፥ ታ ናጋራይ ሎይ ዳራ፤</para>
  <para style="q2" vid="PSA 25:11">ግዶፐካ፥ ነ ሱን ድራዉ፥ አቶ ያጋ።<verse eid="PSA 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12"/>መና ጎዳዉ ያይያ አሳይ ኦኔ?</para>
  <para style="q2" vid="PSA 25:12">እ ዶሪደ ካላና ኦግያ ጾሳይ አ ታማርሳና።<verse eid="PSA 25:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13"/>እ ኡባ ገደካ ሎኦ ደኡሳ ደአና፤</para>
  <para style="q2" vid="PSA 25:13">አ ዘረቱ ቢታ ላታና።<verse eid="PSA 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14"/>መና ጎዳይ ባረዉ ያይያዋንቶ፥</para>
  <para style="q2" vid="PSA 25:14">ባረ ጹራ ሻክያዋ፤</para>
  <para style="q1" vid="PSA 25:14">እ ኡንቱንቶ ባረ ጫቁዋካ ቆንጭሴ።<verse eid="PSA 25:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15"/>መና ጎዳይ ታ ገድያ ጲርያፐ ከስያ ድራዉ፥</para>
  <para style="q2" vid="PSA 25:15">ታ አይፊ ማዶ ኡባ ገደ አኮ ጼሌ።<verse eid="PSA 25:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16"/>ጾሳዉ፥ ታን ታረካ ደእያ ቆሄቴዳ አሳ ግድያ ድራዉ፥</para>
  <para style="q2" vid="PSA 25:16">ሃ ታኮ ስማ፤ ነ ማሮተ ታና በሳ።<verse eid="PSA 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17"/>ታዉ ህርጋይ ዳሬዳ፤</para>
  <para style="q2" vid="PSA 25:17">ታ መቱዋፐ ታና ኔን ዎዛ።<verse eid="PSA 25:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18"/>ታ መቱዋነ ታ ቱጋ ኔን በአ።</para>
  <para style="q2" vid="PSA 25:18">ታ ናጋራ ኡባ አቶ ጋ።<verse eid="PSA 25:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19"/>ታ ሞርከቱ አይ ኬሻ ዳሬደንቶነ በአ፤</para>
  <para style="q2" vid="PSA 25:19">ኡንቱንቱ ታና ዎናዳን እጽያዋ ጼላ።<verse eid="PSA 25:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20"/>ኔን ታና ናጋ፤ ኔን ታና አሻ፤</para>
  <para style="q2" vid="PSA 25:20">ታን ኔኮ ባቃቴዳ ድራዉ፥ ታና ዬላዮፓ።<verse eid="PSA 25:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21"/>ታን ኔናን ሂዶታ ኦዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 25:21">ሱረተይነ ቱማተይ ታና ናጎ።<verse eid="PSA 25:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22"/>አቤት ጾሳዉ፥ እስራኤልያ አሳ</para>
  <para style="q2" vid="PSA 25:22">ኡንቱንቱ መቱዋ ኡባፐ ኔን አሻ።<verse eid="PSA 25:22"/></para>
  <chapter eid="PSA 25"/>
  <chapter number="26" style="c" sid="PSA 26"/>
  <para style="s1">ጌሻ አሳ ዎሳ</para>
  <para style="d">ዳዊታ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1"/>አቤት መና ጎዳዉ፥ ታን ሱረተን ሀመቴዳ ድራዉነ፥</para>
  <para style="q2" vid="PSA 26:1">ስ ባይናን መና ጎዳ አማነቴዳ ድራዉ፥</para>
  <para style="q3" vid="PSA 26:1">ታዉ ፕርዳ።<verse eid="PSA 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2"/>አቤት መና ጎዳዉ፥ ታና ፓጫ፥ ታና ብዳ፤</para>
  <para style="q2" vid="PSA 26:2">ታ ዎዛና ጾሞሳ።<verse eid="PSA 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3"/>አያዉ ጎፐ፥ አገና ነ ሲቁ ታ ስንን ደኤ፤</para>
  <para style="q2" vid="PSA 26:3">ታን ነ ቱማተ ኦግያን ሀመታይ።<verse eid="PSA 26:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4"/>ታን ጭምያ አሳቱዋና እትፐ ኡትከ፤</para>
  <para style="q2" vid="PSA 26:4">ሎአ ማላትያ ኢታቱዋ ማባራን ገልከ።<verse eid="PSA 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5"/>ኢታ ኦያ አሳቱዋ ሺቁዋ ታን እጻይ፤</para>
  <para style="q2" vid="PSA 26:5">ማካላንቻቱዋና እትፐ ኡትከ።<verse eid="PSA 26:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6"/>አቤት መና ጎዳዉ፥ ታን ቆሀቤናዋ በሳናዉ</para>
  <para style="q2" vid="PSA 26:6">ታ ኩሽያ ሜጫይ።</para>
  <para style="q1" vid="PSA 26:6">ነዉ ያርሽያ ሳኣ ዩያይ፤<verse eid="PSA 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7"/>ነ ጋላታ የ የጻይነ</para>
  <para style="q2" vid="PSA 26:7">ኔን ኦዳ ኦራባ ኡባ ኦዳይ።<verse eid="PSA 26:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8"/>አቤት መና ጎዳዉ፥ ኔን ደእያ ጎልያ፥</para>
  <para style="q2" vid="PSA 26:8">ነ ቦንቹ አቅያ ሳኣ ታን ዶሳይ።<verse eid="PSA 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9"/>ታና ናጋራንቻቱዋና እትፐ ፕቶፓ፤</para>
  <para style="q2" vid="PSA 26:9">ዎይ አሳ ዎያዋንቱና እትፐ ይሶፓ።<verse eid="PSA 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10"/>ኡንቱንቱ ኩሽያን ኢታ ሀልቹ ደኤ፤</para>
  <para style="q2" vid="PSA 26:10">ቃይ ኡንቱንቱ ኡሸቻ ኩሽያን ማታዪ ኩም ኡቴዳ።<verse eid="PSA 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11"/>ሽን ታና ግዶፐ፥ ታን ሱረተን ሀመታይ።</para>
  <para style="q2" vid="PSA 26:11">ታና ዎዛ፤ ታዉ ቃረታ።<verse eid="PSA 26:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12"/>ታ ገዲ ደምባ ሳኣን ኤቄዳ፤</para>
  <para style="q2" vid="PSA 26:12">ታን ዎልቃማ ሺቁዋን መና ጎዳ ጋላታና።<verse eid="PSA 26:12"/></para>
  <chapter eid="PSA 26"/>
  <chapter number="27" style="c" sid="PSA 27"/>
  <para style="s1">ጾሳና ደእያ አሳ አማኑዋ</para>
  <para style="d">ዳዊታ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1"/>መና ጎዳይ ታዉ ፖኦነ ታና አሽያዋ፤</para>
  <para style="q2" vid="PSA 27:1">ያትና፥ ታን ኦዉ ያያንታ?</para>
  <para style="q3" vid="PSA 27:1">መና ጎዳይ ታ ደኡ ናገትያ ሚጻ፤</para>
  <para style="q3" vid="PSA 27:1">ያትና፥ ታን ኦዉ ዳጋማንታ?<verse eid="PSA 27:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2"/>ኢታ አሳቱ፥ ታ እጽያዋንቱነ ታ ሞርከቱ</para>
  <para style="q2" vid="PSA 27:2">ታና ዎናዉ ታኮ ዎጽያ ዎደ፥</para>
  <para style="q1" vid="PSA 27:2">ኡንቱንቱ ባረንቶ በቲደ ኩንዳና።<verse eid="PSA 27:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3"/>ሞርክያ ቶራይ ታና ዶድንቶካ</para>
  <para style="q2" vid="PSA 27:3">ታ ዎዛናይ ያየና።</para>
  <para style="q1" vid="PSA 27:3">ኦላይ ታ ቦላ ዶድንቶካ፥</para>
  <para style="q2" vid="PSA 27:3">ታን መና ጎዳን አማነታይ።<verse eid="PSA 27:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4"/>ታን መና ጎዳ እትባ ኦቻድ፤</para>
  <para style="q2" vid="PSA 27:4">ታን ሄዋ ኮያድ፤</para>
  <para style="q2" vid="PSA 27:4">ሄዌነ፥ ታን ታ ደኡዋ ላይ ኡባን፥</para>
  <para style="q2" vid="PSA 27:4">መና ጎዳ ጎልያን ደአናዋ፤</para>
  <para style="q2" vid="PSA 27:4">ቃይካ ታን መና ጎዳ ሎኦተ በአናዋነ</para>
  <para style="q2" vid="PSA 27:4">አ ጎልያን አ ኮያናዋ።<verse eid="PSA 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5"/>ሄዋ ድራዉ፥ መቱዋ ጋላሳን</para>
  <para style="q2" vid="PSA 27:5">እ ታና ባረ ደእያ ሳን ገንና፤</para>
  <para style="q2" vid="PSA 27:5">ባረ ዱንካንያን እ ታና ቆስ አሻና።</para>
  <para style="q2" vid="PSA 27:5">እ ታና ቃ ሹቻ ቦላን ኤሳና።<verse eid="PSA 27:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6"/>ሄ ዎደ ታን ታና ዶዴዳ ታ ሞርከቱዋፐ፥</para>
  <para style="q2" vid="PSA 27:6">ግታታደ ቁ ቁ ያጋና።</para>
  <para style="q1" vid="PSA 27:6">ታን አ ዱንካንያን ናሸታደ ያርሹዋ ያርሻና።</para>
  <para style="q2" vid="PSA 27:6">ታን መና ጎዳዉ ዲጻናነ የጻና።<verse eid="PSA 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7"/>አቤት መና ጎዳዉ፥ ታን ኔና ጼስያ ዎደ፥</para>
  <para style="q2" vid="PSA 27:7">ኔን ታዉ ኮያ፤</para>
  <para style="q2" vid="PSA 27:7">ታዉ ቃረታ፤ ታና ስሳ።<verse eid="PSA 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8"/>ኔን፥ “ታ ስን ኮይተ” ጌዳ ዎደ፥</para>
  <para style="q2" vid="PSA 27:8">ታ ዎዛናይ፥ “አቤት መና ጎዳዉ፥ ኤኖ፤</para>
  <para style="q2" vid="PSA 27:8">ታን ነ ስን ኮያና” ያጌዳ።<verse eid="PSA 27:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9"/>ነ ስን ታፐ ገንፓ።</para>
  <para style="q2" vid="PSA 27:9">ታና ማዴዳዎ፥ ታና ነ ቆማ</para>
  <para style="q2" vid="PSA 27:9">ሀንቀታደ ጉየ ዛሮፓ።</para>
  <para style="q2" vid="PSA 27:9">አቤት ታና አሽያ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 27:9">ታና ኦሎፓነ አጎፓ።<verse eid="PSA 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10"/>ታ አዉነ ታ አታ ታና አግንቶነ</para>
  <para style="q2" vid="PSA 27:10">መና ጎዳይ ታና ሺሽ አካና።<verse eid="PSA 27:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11"/>አቤት መና ጎዳዉ፥ ነ ኦግያ ታና ታማርሳ፤</para>
  <para style="q2" vid="PSA 27:11">ታ ሞርከቱዋ ድራዉ፥ ታና ሱረ ኦግያ ካለ።<verse eid="PSA 27:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12"/>ታና ናስያ ዎርዶ ማርካቱ ታ ቦላ ኢታተን ደንዴዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 27:12">ታና ታ ሞርከቱዋ አሞ አደ እሞፓ።<verse eid="PSA 27:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13"/>መና ጎዳ ኬካተ ታን ፓጻ ደኣደ በአናዋ አማናይ።<verse eid="PSA 27:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14"/>መና ጎዳን ሂዶታ ዎ፤</para>
  <para style="q2" vid="PSA 27:14">ምናደነ ዎዛናማደ፥ መና ጎዳን ሂዶታ ዎ።<verse eid="PSA 27:14"/></para>
  <chapter eid="PSA 27"/>
  <chapter number="28" style="c" sid="PSA 28"/>
  <para style="s1">ማዱዋ ደማናዉ ዎሳነ ጋላታ</para>
  <para style="d">ዳዊታ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1"/>አቤት መና ጎዳዉ፥ ታ ዛላዉ፥ ታን ኔና ጼሳይ፤</para>
  <para style="q2" vid="PSA 28:1">ታን ኔና ጼስና፥ ታዉ ስሳ እጾፓ።</para>
  <para style="q3" vid="PSA 28:1">ነ ጮኡ ጎፐ፥</para>
  <para style="q3" vid="PSA 28:1">ታን ዱፉዋ ቤዳ አሳቱዋ ማላ ግዳይ።<verse eid="PSA 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2"/>“ማዶ” ጋደ ታን ኔና ጼስያ ዎደነ</para>
  <para style="q2" vid="PSA 28:2">ነ ኡባፐ ጌሻ ዱንካንያኮ ዛራደ፥</para>
  <para style="q2" vid="PSA 28:2">ታ ኩሽያ ምጭያ ዎደ፥</para>
  <para style="q2" vid="PSA 28:2">ኔን ታ ዋትዋቱዋ ስሳ።<verse eid="PSA 28:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3"/>ኢታ ኦያ ኢታ አሳቱዋና ታና ጋደ ኦይቆፓ፤</para>
  <para style="q2" vid="PSA 28:3">ሄዋንቱ ባረንቱ ዎዛናን ኮባባ ቆፕ ኡቲደ፥</para>
  <para style="q2" vid="PSA 28:3">ባረንቱ ዶናን ባረንቱ ሾሩዋና ሳሮባ ሃሳይያዋንታ።<verse eid="PSA 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4"/>ኡንቱንቱ ኦሱዋዳንነ ኡንቱንቱ ኦሱዋ ኢታተዳን፥</para>
  <para style="q2" vid="PSA 28:4">ኡንቱንቶ ጭጋ፤<note caller="-" style="x"><char style="xo" closed="false">28:4 </char><char style="xt" closed="false"><ref loc="REV 22:12">ሳፃ 22:12</ref></char></note></para>
  <para style="q2" vid="PSA 28:4">ኡንቱንቱ ኩሺ ኦዳባዉ ኡንቱንቶ ዛራ።</para>
  <para style="q2" vid="PSA 28:4">ኡንቱንቶ በስያ ኢታ ኡንቱንቶ ዛራ።<verse eid="PSA 28:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5"/>ኡንቱንቱ ጾሳ ኦሱዋነ አ ኩሺ መዳዋ</para>
  <para style="q2" vid="PSA 28:5">ዶሰናን እጼዳ ድራዉ፥ ጾሳይ ኡንቱንታ ኮላና፤</para>
  <para style="q2" vid="PSA 28:5">ዛሪደ ኡንቱንታ ኡባካ ኬጸና።<verse eid="PSA 28:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6"/>ታ ዋትዋቱዋ ስሴዳ ድራዉ፥ መና ጎዳይ ጋላተቶ።<verse eid="PSA 28:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7"/>መና ጎዳይ ታዉ ዎልቃነ ጎንዳለ፤</para>
  <para style="q2" vid="PSA 28:7">ታ ዎዛናይ አን አማነቴ፤</para>
  <para style="q2" vid="PSA 28:7">ሄዋን ታን ማደታድ።</para>
  <para style="q2" vid="PSA 28:7">ሄዋ ድራዉ፥ ታ ዎዛናይ አን ናሸቴ፤</para>
  <para style="q2" vid="PSA 28:7">ታን የን አ ሳባና።<verse eid="PSA 28:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8"/>መና ጎዳይ ባረ አሳዉ ዎልቃ፤</para>
  <para style="q2" vid="PSA 28:8">እ ባረ ኦኬዳ ካትያ አሽያ ሚጻ።<verse eid="PSA 28:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9"/>ጾሳዉ፥ ነ አሳ አሻ፤</para>
  <para style="q2" vid="PSA 28:9">ነዉ ግድያዋንታ አንጃ።</para>
  <para style="q1" vid="PSA 28:9">ኡንቱንታ ሄምያዌ ኔና ግዳ፤</para>
  <para style="q2" vid="PSA 28:9">ኔን ኡንቱንታ መናዉካ ቶካ።<verse eid="PSA 28:9"/></para>
  <chapter eid="PSA 28"/>
  <chapter number="29" style="c" sid="PSA 29"/>
  <para style="s1">ጾሳ ኮሻ ዎልቃ</para>
  <para style="d">ዳዊታ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 29:1"/>ህንተኖ ሳሉዋን ደእያ መታቶ፥</para>
  <para style="q2" vid="PSA 29:1">መና ጎዳባ ኦድተ፤</para>
  <para style="q1" vid="PSA 29:1">“ቦንቹነ ዎልቃይ መና ጎዳዋ” ጊደ ኦድተ።<verse eid="PSA 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2"/>መና ጎዳ ቦንቾ ሱን ጋላትተ፤</para>
  <para style="q2" vid="PSA 29:2">አ ጌሻተ ፑላዉ መና ጎዳዉ ጎይንተ።<verse eid="PSA 29:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3"/>መና ጎዳ ጉንይ ሃቱዋ ቦላን ስሰቴ።</para>
  <para style="q2" vid="PSA 29:3">ቦንቾ ጾሳይ ጉጉንዳን ጉሜ፤</para>
  <para style="q1" vid="PSA 29:3">መና ጎዳይ ዎልቃማ ሃቱዋ ቦላን ጉሜ።<verse eid="PSA 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4"/>መና ጎዳ ጉንይ ዎልቃማ፤</para>
  <para style="q2" vid="PSA 29:4">መና ጎዳ ጉንይ፥ “ሆላ!” ጊስያዋ።<verse eid="PSA 29:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5"/>መና ጎዳ ጉንይ ዝጋቱዋ መንሬ፤</para>
  <para style="q2" vid="PSA 29:5">ሊባኖሳ ግያ ቢታን ደእያ ዝጋቱዋካ፥</para>
  <para style="q1" vid="PSA 29:5">መና ጎዳይ መንሬ።<verse eid="PSA 29:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6"/>ሊባኖሳ ደረቱዋ ጋሎ ማራዳን ቡራቅሴ፤</para>
  <para style="q2" vid="PSA 29:6">ስርዮና ግያ ዎልቃማ ደርያ መንዳን ጲጽልሴ።<verse eid="PSA 29:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7"/>መና ጎዳ ኮሻይ፥</para>
  <para style="q2" vid="PSA 29:7">ዋልቃን ዎልቃምሴ።<verse eid="PSA 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8"/>መና ጎዳ ኮሻይ ባዙዋ ቃ፤</para>
  <para style="q2" vid="PSA 29:8">መና ጎዳይ ቃዴሳ ባዙዋ ቃ።<verse eid="PSA 29:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9"/>መና ጎዳ ኮሻይ ዎላቱዋ ቃ፤</para>
  <para style="q2" vid="PSA 29:9">ም ሀይካ ቆቆፌ።</para>
  <para style="q1" vid="PSA 29:9">ያትና፥ እ ደእያ ሳኣን ደእያዋንቱ፥</para>
  <para style="q2" vid="PSA 29:9">“ቦንቹ ጾሳዉ ግዶ” ያጊኖ።<verse eid="PSA 29:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10"/>መና ጎዳይ ድኡዋ ሃ ቦላ ባረ ካዉተ አራታ ዎደ ኡቴዳ፤</para>
  <para style="q2" vid="PSA 29:10">መና ጎዳይ ባረ ካዉተ አራታን ኡቲደ፥</para>
  <para style="q2" vid="PSA 29:10">መናዉ ካተቴዳ።<verse eid="PSA 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11"/>መና ጎዳይ ባረ አሳዉ ዎልቃ እሜ።</para>
  <para style="q2" vid="PSA 29:11">መና ጎዳይ ባረ አሳ ሳሮተን አንጄ።<verse eid="PSA 29:11"/></para>
  <chapter eid="PSA 29"/>
  <chapter number="30" style="c" sid="PSA 30"/>
  <para style="s1">ጋላታ ዎሳ</para>
  <para style="d">ዳዊታ ማዝሙርያ፥ ጌሻ ጎልያ አንጅስያ ጋላስ የጼዳዋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1"/>አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 30:1">ኔን ታና ጪሙዋፐ ከሴዳ ድራዉነ</para>
  <para style="q3" vid="PSA 30:1">ታ ሞርከቱዋን፥ “ሀሹ አዉ” ጊሳቤና ድራዉ፥</para>
  <para style="q3" vid="PSA 30:1">ታን ኔና ቁ ቁ ኦና።<verse eid="PSA 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2"/>አቤት መና ጎዳዉ ታ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 30:2">ኔን ታና ማዳናዳን፥ ታን ኔና ጼሳድ፤</para>
  <para style="q2" vid="PSA 30:2">ኔን ታና ፓዳ።<verse eid="PSA 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3"/>አቤት መና ጎዳዉ፥ ታና ዱፉዋ ቤናዳን ናጋዳ፤</para>
  <para style="q2" vid="PSA 30:3">ዱገ ጪሞ ኦላን ገለናዳን፥</para>
  <para style="q2" vid="PSA 30:3">ኔን ታና ፓጻ አሻዳ።<verse eid="PSA 30:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4"/>ህንተኖ ጾሳ አሳቶ፥ መና ጎዳዉ የጽተ፤</para>
  <para style="q2" vid="PSA 30:4">አ ጌሻ ሱንካ ጋላትተ።<verse eid="PSA 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5"/>አ ሀንቁ ጉ ዎድያሳ፥</para>
  <para style="q2" vid="PSA 30:5">ሽን አ ኬካተይ ደኡዋ ላይ ኡባሳ።</para>
  <para style="q1" vid="PSA 30:5">ቃማ ዬኪደ አቆፐ፥</para>
  <para style="q2" vid="PSA 30:5">ዎንታ ዛዋይ ባይና ናሸቻ ግዴ።<verse eid="PSA 30:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6"/>ታን ዎፓን ደእያ ዎደ፥</para>
  <para style="q2" vid="PSA 30:6">“ስም ታን ኡባካ ቃጽከ” ያጋድ።<verse eid="PSA 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7"/>አቤት መና ጎዳዉ፥ ኔን ታዉ ኬኬዳ ዎደ፥</para>
  <para style="q2" vid="PSA 30:7">ታና ዎልቃማ ደርያዳን ምንሳደ ኤሳዳ።</para>
  <para style="q1" vid="PSA 30:7">ሽን ኔን ነ ስን ዎራ ዛሬዳ ዎደ፥</para>
  <para style="q2" vid="PSA 30:7">ታን ዳጋማድ።<verse eid="PSA 30:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8"/>አቤት መና ጎዳዉ፥ ታን ኔና ጼሳድ፤</para>
  <para style="q2" vid="PSA 30:8">ታን መና ጎዳኮ ማሮተዉ ሀዋዳን ያጋደ ዎሳድ፤<verse eid="PSA 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9"/>“ታን ሀይቂያዋፐ ዎይ</para>
  <para style="q2" vid="PSA 30:9">ዱፉዋን ገልያዋፐ አያ ደማኒ?</para>
  <para style="q1" vid="PSA 30:9">ባናዉ ላመቴዳ አሳይ ኔና ጋላቲ?</para>
  <para style="q2" vid="PSA 30:9">ኔን አማነትያዋ ኦዲ?<verse eid="PSA 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10"/>አቤት መና ጎዳዉ፥ ታና ኔን ስሳ፤</para>
  <para style="q2" vid="PSA 30:10">ታዉ ቃረታ።</para>
  <para style="q1" vid="PSA 30:10">አቤት መና ጎዳዉ፥ ኔን ታዉ ማዱዋ ግዳ” ያጋድ።<verse eid="PSA 30:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11"/>ታ ዬኩዋ የዉ ላማዳ።</para>
  <para style="q2" vid="PSA 30:11">ካዩዋ ማዩዋ ታፐ ቃራደ፥</para>
  <para style="q2" vid="PSA 30:11">ናሸቻ ታና ማይዛዳ።<verse eid="PSA 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12"/>ሄዋ ድራዉ፥ ታን ኔና</para>
  <para style="q2" vid="PSA 30:12">ሳባናፐ አትና፥ ጮኡ ጊከ።</para>
  <para style="q1" vid="PSA 30:12">አቤት መና ጎዳዉ ታ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 30:12">ታን ኔና መናዉካ ጋላታና።<verse eid="PSA 30:12"/></para>
  <chapter eid="PSA 30"/>
  <chapter number="31" style="c" sid="PSA 31"/>
  <para style="s1">መቱዋ ዎደ ዎሳ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ዳዊታ ማዝሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1"/>አቤት መና ጎዳዉ፥ ታን ኔኮ ባቃታይ፤</para>
  <para style="q2" vid="PSA 31:1">አዉደነ ታና ዬላዮፓ።</para>
  <para style="q3" vid="PSA 31:1">ነ ጽሎተን ታና አሻ።<verse eid="PSA 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2"/>ነ ሀይ ታኮ የጋ፤</para>
  <para style="q2" vid="PSA 31:2">ኤለካ ታና አሻ።</para>
  <para style="q1" vid="PSA 31:2">ኔን ታን ጌምያ ዛላነ</para>
  <para style="q2" vid="PSA 31:2">ታና አሽያ ምኖ ጌሱዋ ታዉ ግዳ።<verse eid="PSA 31:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3"/>ኤ፥ ኔን ታዉ ዛላነ ጌሱዋ፤</para>
  <para style="q2" vid="PSA 31:3">ነ ሱን ድራዉ፥ ኔን ታና ካለነ ነ ኦግያ በሳ።<verse eid="PSA 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4"/>ኔን ታዉ ጌምያ ሳ ግድያ ድራዉ፥</para>
  <para style="q2" vid="PSA 31:4">ኡንቱንቱ ታዉ ቆስ ዎዳ ጲርያፐ ታና ኔን ናጋ።<verse eid="PSA 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5"/>አቤት መና ጎዳዉ፥ ቱሙዋ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 31:5">ታን ታ ሸምፑዋ ነ ኩሽያን ዎይ፤<note caller="-" style="x"><char style="xo" closed="false">31:5 </char><char style="xt" closed="false"><ref loc="LUK 23:46">ሉቃሳ 23:46</ref></char></note></para>
  <para style="q3" vid="PSA 31:5">ኔን ታና ዎዛ።<verse eid="PSA 31:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6"/>ፓና ኤቃቶ ጎይንያዋንታ ታን እጻይ፤</para>
  <para style="q2" vid="PSA 31:6">ሽን ታን መና ጎዳን አማነታይ።<verse eid="PSA 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7"/>ታ መቱዋ ኔን በኤዳ ድራዉነ</para>
  <para style="q2" vid="PSA 31:7">ታ ቱጋ ኔን ኤሬዳ ድራዉ፥</para>
  <para style="q1" vid="PSA 31:7">ታን አገና ነ ሲቁዋን ናሸታናነ</para>
  <para style="q2" vid="PSA 31:7">ናሸቻን ኖጩ ጋና።<verse eid="PSA 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8"/>ኔን ታና ሞርክያ ኩሽያን አደ እማባካ፤</para>
  <para style="q2" vid="PSA 31:8">ታ ገደቶካ ላአተ እማዳ።<verse eid="PSA 31:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9"/>አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 31:9">ታን መቱዋን ገሌዳ ድራዉ፥ ታዉ ቃረታ።</para>
  <para style="q1" vid="PSA 31:9">ታን ዳሮ ምሸቴዳ ድራዉ፥ ታን መቱዋን፥</para>
  <para style="q2" vid="PSA 31:9">ታ አሹካ፥ ታ ሸምፑካ ዳቡሬዳ።<verse eid="PSA 31:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10"/>ምሹዋ ዳሩዋን ታ ደኡ ጭሬዳ፤</para>
  <para style="q2" vid="PSA 31:10">ታ ላይቱካ ኦልሽን ዉሬድኖ።</para>
  <para style="q1" vid="PSA 31:10">መቱዋ ዳሩዋን ታ ዎልቃይ እጽና፤</para>
  <para style="q2" vid="PSA 31:10">ታ መቀቱካ አርጋጬድኖ።<verse eid="PSA 31:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11"/>ታ ሞርከቱዋ ኡባዉ ቅያ ግዳድ</para>
  <para style="q2" vid="PSA 31:11">ታን ታ ሾሮቶ ዬላ፥</para>
  <para style="q1" vid="PSA 31:11">ታና ኤርያዋንቶካ ያሽስያዋ ግዳድ።</para>
  <para style="q2" vid="PSA 31:11">ኦግያን ታና በኤዳዋንቱካ ታፐ ባቃቲኖ።<verse eid="PSA 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12"/>ታን ሀይቄዳዋዳን ዶገታድ፤</para>
  <para style="q2" vid="PSA 31:12">መእና ኦሌዳ ኦቱዋ ማላ ግዳድ።<verse eid="PSA 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13"/>ታን ዳሮቱዋ ሳሱከ ስሳድ፤</para>
  <para style="q2" vid="PSA 31:13">ዳጋማይ ኡባ ሳን ደኤ።</para>
  <para style="q1" vid="PSA 31:13">ኡንቱንቱ ታ ቦላ ሺቅኖነ ታና ዎናዉ ማቀቲኖ።<verse eid="PSA 31:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14"/>ሽን መና ጎዳዉ፥ ታን ኔናን አማነታይ፥</para>
  <para style="q2" vid="PSA 31:14">ኔን ታ ጾሳ ያጋይ።<verse eid="PSA 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15"/>ታ ደኡዋ ላይይ ነ ኩሽያና።</para>
  <para style="q2" vid="PSA 31:15">ታና የደርስያ ታ ሞርከቱዋ ኩሽያፐ ታና ኔን አሻ።<verse eid="PSA 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16"/>ነ ቆማ ቦላን ነ ሶምኡዋ ፖእሳ፤</para>
  <para style="q2" vid="PSA 31:16">አገና ነ ሲቁዋን ታና አሻ።<verse eid="PSA 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17"/>አቤት መና ጎዳዉ፥ ታን ኔና ጼስያ ድራዉ</para>
  <para style="q2" vid="PSA 31:17">ታና ዬላዮፓ።</para>
  <para style="q1" vid="PSA 31:17">ሽን ኢታቱ ዬላትኖ፤</para>
  <para style="q2" vid="PSA 31:17">ኡንቱንቱ ዱፉዋን ገሊደ፥ ስርጵ ጊኖ።<verse eid="PSA 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18"/>ኦቶሩዋንነ ካያን ጽሎቱዋ ቦላ</para>
  <para style="q2" vid="PSA 31:18">ጻሊደ ሃሳይያ ድራዉ፥</para>
  <para style="q1" vid="PSA 31:18">ኡንቱንቱ ዎርዶትያ ዶና ጮኡ ኦ።<verse eid="PSA 31:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19"/>ነዉ ያይያዋንቶ ኔን ምንጄዳነ</para>
  <para style="q2" vid="PSA 31:19">ኔኮ ባቃትያዋንቶ አሳ ስንን፥</para>
  <para style="q2" vid="PSA 31:19">ኔን ኦዳ ነ ኬካተይ አያ ዳሬ!<verse eid="PSA 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20"/>ኔን ኡንቱንታ ነ ስንን ጌማ ሳኣን ገንደ፥</para>
  <para style="q2" vid="PSA 31:20">አሳ ማቁዋፐ አሻሳ።</para>
  <para style="q1" vid="PSA 31:20">ኔን ኡንቱንታ ነ ዱንካንያን ቆሳደ፥</para>
  <para style="q2" vid="PSA 31:20">ኢታ እንጻርሳፐ አሻሳ።<verse eid="PSA 31:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21"/>ታን ሞርኪ ዶዴዳ ካታማ ግዶን ደእያ ዎደ፥</para>
  <para style="q2" vid="PSA 31:21">እ ታና ማላልስያ ባረ አገና ሲቁዋ በሴዳ ድራዉ፥</para>
  <para style="q1" vid="PSA 31:21">መና ጎዳይ ጋላተቶ።<verse eid="PSA 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22"/>ታን ዳጋማደ፥</para>
  <para style="q2" vid="PSA 31:22">“ታን ነ ስንፐ ክቻድ” ያጋድ።</para>
  <para style="q1" vid="PSA 31:22">ሽን ታና ማዳና ማላ፥ ኔና ጼሴዳ ዎደ፥</para>
  <para style="q2" vid="PSA 31:22">ታ ዋሱዋ ኔን ስሳዳ።<verse eid="PSA 31:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23"/>ህንተኖ፥ ጾሳ አሳቶ፥ መና ጎዳ ሲቅተ።</para>
  <para style="q2" vid="PSA 31:23">መና ጎዳይ አማነትያዋንታ ናጌ፤</para>
  <para style="q2" vid="PSA 31:23">ሽን ኦቶራንቻቶ ኡንቱንቱ ጋትያ ዉርስ ጭጌ።<verse eid="PSA 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24"/>ህንተኖ፥ መና ጎዳን ህዶታ ኦያዋንቶ፥</para>
  <para style="q2" vid="PSA 31:24">ምንተነ ዎዛናምተ።<verse eid="PSA 31:24"/></para>
  <chapter eid="PSA 31"/>
  <chapter number="32" style="c" sid="PSA 32"/>
  <para style="s1">ናጋራ ፓጹሳነ ማሮታ ደሙሳ</para>
  <para style="d">ዳዊተ አኬካን ጻፌዳ ግንጹዋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1"/>አ ባይዙ አቶ ጌተቴዳነ</para>
  <para style="q2" vid="PSA 32:1">አ ናጋራይ ካመቴዳ ኡራይ አንጀቴዳዋ።<note caller="-" style="x"><char style="xo" closed="false">32:1-2 </char><char style="xt" closed="false"><ref loc="ROM 4:7-8">ሮመ 4:7-8</ref></char></note><verse eid="PSA 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2"/>መና ጎዳይ አ ኢታተ ፓይደና አሳይነ</para>
  <para style="q2" vid="PSA 32:2">አ ቆፋን ባለ ባይና አሳይ አንጀቴዳዋ።<verse eid="PSA 32:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3"/>ታ ናጋራ ፓጸናን ደኣደ፥</para>
  <para style="q2" vid="PSA 32:3">ታን ጋላሳ ኩመን ኦሌዳዎ</para>
  <para style="q2" vid="PSA 32:3">ታ አሳተይ ዳቡሬዳ።<verse eid="PSA 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4"/>ጋላስነ ቃማ ነ ኩሺ ታ ቦላ ዴጼዳ።</para>
  <para style="q2" vid="PSA 32:4">ሃይ ቦንያ አዋን መሊደ ዉርያዋዳን፥</para>
  <para style="q2" vid="PSA 32:4">ታ ዎልቃይ ዉሬዳ።<verse eid="PSA 32:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5"/>ታን ታ ናጋራ ነዉ ፓጻድ፤</para>
  <para style="q2" vid="PSA 32:5">ታ ኢታተካ ኔፐ ገንበይከ፤</para>
  <para style="q1" vid="PSA 32:5">“ታ ባይዙዋ መና ጎዳዉ ፓጻና” ጋድ።</para>
  <para style="q2" vid="PSA 32:5">ያትና፥ ኔን ታና ዴጼዳ ናጋራ አቶ ያጋዳ።<verse eid="PSA 32:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6"/>ሄዋ ድራዉ፥ ጾሳ አሳ ግድያ ኦንነ፥</para>
  <para style="q2" vid="PSA 32:6">ኔን ቤትያ ዎደ፥ ኔና ዎሶ።</para>
  <para style="q1" vid="PSA 32:6">ዎልቃማ ሃይ ኩንያ ዎደ፥</para>
  <para style="q2" vid="PSA 32:6">ቱሙዋፐ ሄ ኡራ ጋከና።<verse eid="PSA 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7"/>ኔን ታዉ ቆሰትያ ሳኣ፤</para>
  <para style="q2" vid="PSA 32:7">ኔን ታና መቱዋፐ ናጋሳ።</para>
  <para style="q1" vid="PSA 32:7">አቶተ የ የጽያዋንታ ታ ዩሹዋን ዎዳ።<verse eid="PSA 32:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8"/>ጾሳይ፥ “ታን ኔና ኤርሳናነ፥</para>
  <para style="q2" vid="PSA 32:8">ኔን ባናዉ በስያ ኦግያ ኔና ታማርሳና፤</para>
  <para style="q1" vid="PSA 32:8">ታን ኔና ዞራናነ ናጋና።<verse eid="PSA 32:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9"/>ብጻላንነ ፑሉዋን ኦይቀተናን አዛዘተና፥</para>
  <para style="q2" vid="PSA 32:9">ዎዛናይ ባይና ባቁሉዋዳን</para>
  <para style="q2" vid="PSA 32:9">ዎይ ፓራዳን ህንተ ሀኖፕተ” ያጌ።<verse eid="PSA 32:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10"/>ኢታቶ ቱጋይ ዳራና፤</para>
  <para style="q2" vid="PSA 32:10">ሽን መና ጎዳን አማነትያዋንታ፥</para>
  <para style="q2" vid="PSA 32:10">አገና ሲቁ ዶዳና።<verse eid="PSA 32:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11"/>ህንተኖ፥ ጽሎቶ፥</para>
  <para style="q2" vid="PSA 32:11">መና ጎዳን ናሸትተነ “ሀሹ!” ጊተ፤</para>
  <para style="q2" vid="PSA 32:11">ህንተኖ፥ ዎዛና ሱረቶ፥ ናሸቻዉ የጽተ።<verse eid="PSA 32:11"/></para>
  <chapter eid="PSA 32"/>
  <chapter number="33" style="c" sid="PSA 33"/>
  <para style="s1">ማርያ ጾሳ ሳቡሳ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1"/>ህንተኖ፥ ጽሎቶ መና ጎዳዉ ናሸቻን የጽተ፤</para>
  <para style="q2" vid="PSA 33:1">ሱረ አሳቱ አ ጋላታናዉ በሴ።<verse eid="PSA 33:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2"/>ማስንቁዋ ዲጺደ፥</para>
  <para style="q2" vid="PSA 33:2">መና ጎዳ ጋላትተ፤</para>
  <para style="q2" vid="PSA 33:2">ታሙ ባቀን ዋጸቴዳ ዲካ አዉ ዲጽተ።<verse eid="PSA 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3"/>ኦራ የ የጽተ፤</para>
  <para style="q2" vid="PSA 33:3">ሎይ ዲጺደ፥ ቃላ ቂሲደ የጽተ።<verse eid="PSA 33:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4"/>መና ጎዳ ቃላይ ሱርያ፤</para>
  <para style="q2" vid="PSA 33:4">እ ኦያ ኦሱዋ ኡባይ አማነትያዋ።<verse eid="PSA 33:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5"/>መና ጎዳይ ጽሎተነ ቱሙ ፕርዳ ዶሴ፤</para>
  <para style="q2" vid="PSA 33:5">አገና አ ሲቁ ሳኣ ኩሜዳ።<verse eid="PSA 33:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6"/>መና ጎዳ ቃላን ሳሎቱ መቴድኖ።</para>
  <para style="q2" vid="PSA 33:6">አ ዶናፐ ከስያ ሸምፑዋን</para>
  <para style="q2" vid="PSA 33:6">ኡንቱንቱን ደእያ መታቱካ ኦሰቴድኖ።<verse eid="PSA 33:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7"/>ዎልቃማ አባ ሃ እ እትሳን ኤልሴዳ፤</para>
  <para style="q2" vid="PSA 33:7">ሄ ጪሞ ሃ ምንጃ ሳን ዜሬዳ።<verse eid="PSA 33:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8"/>ሳኣ ኡባይ መና ጎዳ ያዮ፤</para>
  <para style="q2" vid="PSA 33:8">ሳኣን ደእያ አሳይ ኡባይ አ ቦንቾ።<verse eid="PSA 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9"/>አያዉ ጎፐ፥ እ ሃሳይና ሀኔዳ፤</para>
  <para style="q2" vid="PSA 33:9">እ አዛዝና፥ ምኒደ ኤቄዳ።<verse eid="PSA 33:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10"/>መና ጎዳ ኤረና ካዉተቱዋ ዞረታ ጾሳይ ላሌ፤</para>
  <para style="q2" vid="PSA 33:10">ኡንቱንቱ ሀልቹዋካ መላ ከሴ።<verse eid="PSA 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11"/>መና ጎዳ ሀልቹ መናዉ ኤቂደ ደኤ፤</para>
  <para style="q2" vid="PSA 33:11">አ ዎዛና ቆፋይካ የለታ ኡባ ጋካናዉ ደኤ።<verse eid="PSA 33:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12"/>ጾሳይ መና ጎዳ ግዴዳ ካዉተይ፥</para>
  <para style="q2" vid="PSA 33:12">እ ባረሳ ኦደ ዶሬዳ አሳይ አንጀቴዳዋ።<verse eid="PSA 33:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13"/>መና ጎዳይ ሳሉዋና ዱገ ጼሊደ፥</para>
  <para style="q2" vid="PSA 33:13">አሳ ኡባ በኤ።<verse eid="PSA 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14"/>ጾሳይ ባረ ደኢያሳፐ ሳኣን ደእያ ኡባ ጼሌ።<verse eid="PSA 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15"/>እ ኡንቱንቱ ኡባ ዎዛና መዳ፤</para>
  <para style="q2" vid="PSA 33:15">ኡንቱንቱ ኦያዋ ኡባ ኤሬ።<verse eid="PSA 33:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16"/>ካቲ ባረ ዎታዳራ ጮራተን አተና፤</para>
  <para style="q2" vid="PSA 33:16">ኦላንቻይ ባረ ዎልቃ ምኖተን ከስ አከና።<verse eid="PSA 33:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17"/>ኦላ ፓራይ ጾንሳና ጊደ ናግያዌ መላ፤</para>
  <para style="q2" vid="PSA 33:17">እ ባረ ዎልቃ ምኖተን አሻናዉ ዳንዳየና።<verse eid="PSA 33:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18"/>መና ጎዳ አይፈቱ አዉ ያይያነ</para>
  <para style="q2" vid="PSA 33:18">አገና አ ሲቁዋን ህዶታ ኦያ አሳቱዋ ቦላና።<verse eid="PSA 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19"/>ሄዌነ፥ ኡንቱንታ ሀይቁዋፐ አሻናሳነ</para>
  <para style="q2" vid="PSA 33:19">ኮሻ ዎድያን ፓጻ ዎናሳ።<verse eid="PSA 33:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20"/>ኑን መና ጎዳን ህዶታ ኦቶ፤</para>
  <para style="q2" vid="PSA 33:20">እ ኑና ማድያዋነ ኑ ጎንዳልያ።<verse eid="PSA 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21"/>ኑን አ ጌሻ ሱንን አማነትያ ድራዉ፥</para>
  <para style="q2" vid="PSA 33:21">ኑ ዎዛናይ አን ናሸቴ።<verse eid="PSA 33:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22"/>አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 33:22">ኑን ኔናን ህዶታ ኦያዋዳን፥</para>
  <para style="q2" vid="PSA 33:22">አገና ነ ሲቁ ኑናና ግዶ።<verse eid="PSA 33:22"/></para>
  <chapter eid="PSA 33"/>
  <chapter number="34" style="c" sid="PSA 34"/>
  <para style="s1">ጾሳይ ፕርድያዋ ግዶዎ ሳቡሳ</para>
  <para style="d">ባረና የደርሴዳ አብመሌካ ስንፐ ጎይያዋ ማላቲደ ቤዳ ዎደ፥ ዳዊታ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1"/>ታን መና ጎዳ ኡባ ዎደ ጋላታና፤</para>
  <para style="q2" vid="PSA 34:1">አ ጋላታይ አይ ዎደነ ታ ዶናፐ ፓጨና።<verse eid="PSA 34:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2"/>ታን መና ጎዳን ጬቀታይ፤</para>
  <para style="q2" vid="PSA 34:2">ናቀቴዳዋንቱ ሄዋ ስሲደ ናሸትኖ።<verse eid="PSA 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3"/>ታናና ግዲደ፥ መና ጎዳ ግታይተ።</para>
  <para style="q2" vid="PSA 34:3">አነ እትፐ አ ሱን ቁ ቁ ኦይተ።<verse eid="PSA 34:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4"/>ታን መና ጎዳ ኮያድ፤</para>
  <para style="q2" vid="PSA 34:4">እ ታዉ ዛሬዳ፤</para>
  <para style="q2" vid="PSA 34:4">ታን ያይያዋ ኡባፐ ታና እ አሼዳ።<verse eid="PSA 34:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5"/>ኔኮ ጼልያዋንቱ ናሸቲኖ፤</para>
  <para style="q2" vid="PSA 34:5">ኡንቱንቱ ሶምኢ ኡባካ ዬላተና።<verse eid="PSA 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6"/>ሀ ህዬሳ ብታኒ ዋሴዳ፤</para>
  <para style="q2" vid="PSA 34:6">መና ጎዳይ አ ዋሱዋ ስሴዳ፤</para>
  <para style="q1" vid="PSA 34:6">አ መቱዋ ኡባፐ አ አሼዳ።<verse eid="PSA 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7"/>መና ጎዳ ኪታንቻይ አ ያይያ አሳቱዋ ናጌ፤</para>
  <para style="q2" vid="PSA 34:7">እ ኡንቱንቱ ዩሹዋን ግዲደ፥ ኡንቱንታ አሼ።<verse eid="PSA 34:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8"/>መና ጎዳይ ኬካ ግድያዋ ጼል በእተ።<note caller="-" style="x"><char style="xo" closed="false">34:8 </char><char style="xt" closed="false"><ref loc="1PE 2:3">1 ጰጽ. 2:3</ref></char></note></para>
  <para style="q2" vid="PSA 34:8">አኮ ባቃትያ አሳይ አንጀቴዳዋ።<verse eid="PSA 34:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9"/>ህንተኖ፥ አ ጌሻ አሳቶ፥ መና ጎዳዉ ያይተ፤</para>
  <para style="q2" vid="PSA 34:9">አያዉ ጎፐ፥ አዉ ያይያ ኡባቶ አያይነ ፓጨና።<verse eid="PSA 34:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10"/>ጋሞቱካ ምያዌ ይና ኮሻቲኖ፤</para>
  <para style="q2" vid="PSA 34:10">ሽን መና ጎዳ ኮይያዋንቶ ሎኦባይ ፓጨና።<verse eid="PSA 34:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11"/>ታ ታማረቶ፥ ሃ ዪተ፤ ስስተ፤</para>
  <para style="q2" vid="PSA 34:11">መና ጎዳ ያሻ ታን ህንተና ታማርሳና።<verse eid="PSA 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12"/>ሎኦ ደኡዋ ደአናዉነ</para>
  <para style="q2" vid="PSA 34:12">ኬካባ በአና ማላ፥<note caller="-" style="x"><char style="xo" closed="false">34:12-16 </char><char style="xt" closed="false"><ref loc="1PE 3:10-12">1 ጰጽ. 3:10-12</ref></char></note></para>
  <para style="q2" vid="PSA 34:12">ባረ ላይይ አዱቃናዉ ኮይያ አሳይ ኦኔ?<verse eid="PSA 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13"/>ነ እንጻርሳይ ኢታባ ሃሳየናዳን፥</para>
  <para style="q2" vid="PSA 34:13">ነ ዶናይካ ጭሜናዳን ተአ።<verse eid="PSA 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14"/>ኢታፐ ሻከታ፤ ሎኦባ ኦ፤</para>
  <para style="q2" vid="PSA 34:14">ሳሮተ ሎይ ኮያደ ካላ።<verse eid="PSA 34:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15"/>መና ጎዳ አይፊ ጽሎቱዋኮ ጼሌ፤</para>
  <para style="q2" vid="PSA 34:15">ቃይ አ ሀይይካ ኡንቱንቱ ዋሱዋ ሀይዜ።<verse eid="PSA 34:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16"/>ኡንቱንታ ሀሳይስያዋ ቢታፐ ይሳና ማላ፥</para>
  <para style="q2" vid="PSA 34:16">መና ጎዳይ ኢታ ኦያዋንታ፥</para>
  <para style="q2" vid="PSA 34:16">ባረ ሀንቁዋ ሶምኡዋን ጼሌ።<verse eid="PSA 34:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17"/>ጽሎቱ ዋሲኖ፤</para>
  <para style="q2" vid="PSA 34:17">መና ጎዳይ ኡንቱንቱ ዋሱዋ ስሴ።</para>
  <para style="q1" vid="PSA 34:17">እ ኡንቱንቱ መቱዋ ኡባፐ አሼ።<verse eid="PSA 34:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18"/>መና ጎዳይ ዎዛናይ መኤዳዋንቶ ማታና፤</para>
  <para style="q2" vid="PSA 34:18">ቃይ ባረንቱ ህዶታ ቃንጼዳዋንታ አሼ።<verse eid="PSA 34:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19"/>ጽሎ አሳ መቱ ዳራ፤</para>
  <para style="q2" vid="PSA 34:19">ሽን መና ጎዳይ አ ሄ ኡባፐ አሼ።<verse eid="PSA 34:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20"/>ጾሳይ አ ምን ናግያ ድራዉ፥<note caller="-" style="x"><char style="xo" closed="false">34:20 </char><char style="xt" closed="false"><ref loc="JHN 19:36">ዮሃ. 19:36</ref></char></note></para>
  <para style="q2" vid="PSA 34:20">አ መቀፐ እቱነ መኤና።<verse eid="PSA 34:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21"/>ኢታቱዋ ኢታተይ ዎና፤</para>
  <para style="q2" vid="PSA 34:21">ጽሎቱዋ እጽያዋንቱ ፕርደታና።<verse eid="PSA 34:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22"/>መና ጎዳይ ባረ ቆማቱዋ አሼ።</para>
  <para style="q2" vid="PSA 34:22">አኮ ባቃቲደ ኦንነ ፕርደተና።<verse eid="PSA 34:22"/></para>
  <chapter eid="PSA 34"/>
  <chapter number="35" style="c" sid="PSA 35"/>
  <para style="s1">ናቀቴዳ አሳ ዎሳ</para>
  <para style="d">ዳዊታ ማዝሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1"/>አቤት መና ጎዳዉ፥ ታናና ኤቀትያዋንቱና ኔን ኤቀታ፤</para>
  <para style="q2" vid="PSA 35:1">ታናና ኦለትያዋንቱና ኔን ኦለታ።<verse eid="PSA 35:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2"/>ጎንዳልያነ ሀራ ኦላ ሚሻ ኦይቃደ፥</para>
  <para style="q2" vid="PSA 35:2">ታና ማዳናዉ ደንዳ።<verse eid="PSA 35:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3"/>ታና የደርስያዋንቱ ቦላን</para>
  <para style="q2" vid="PSA 35:3">ነ ቶራነ ማሻ ደን።</para>
  <para style="q1" vid="PSA 35:3">ታና፥ “ታን ኔና አሽያዋ” ያጋ።<verse eid="PSA 35:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4"/>ታ ሸምፑዋ ዎናዉ ኮይያዋንቱ፥</para>
  <para style="q2" vid="PSA 35:4">ዬላትኖነ ካዉሽኖ፤</para>
  <para style="q2" vid="PSA 35:4">ታ ቦላ ኢታባ ማቀትያዋንቱ ካዉሺደ ጉየ ስምኖ።<verse eid="PSA 35:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5"/>መና ጎዳ ኪታንቻይ ኡንቱንታ የደርስያ ዎደ፥</para>
  <para style="q2" vid="PSA 35:5">ኡንቱንቱ ጫርኩዋ ስንን ደእያ ሱላዳን ሀንኖ።<verse eid="PSA 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6"/>መና ጎዳ ኪታንቻይ፥</para>
  <para style="q2" vid="PSA 35:6">ኡንቱንታ ደቻና ሀንያ ዎደ፥</para>
  <para style="q2" vid="PSA 35:6">ኡንቱንቱ ኦጊ ማነ ሀል ግዶ።<verse eid="PSA 35:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7"/>ጮ ታና ኦይቃናዉ ባረንቱ ጲርያ ዎድኖ፤</para>
  <para style="q2" vid="PSA 35:7">ቃይካ ጮ ታና ኩንድሳናዉ ኦላ ቦኬድኖ።<verse eid="PSA 35:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8"/>ኤረናን ደእሺና፥ ኡንቱንቱ ቦላን ባሻይ ፑቱ ጎ።</para>
  <para style="q2" vid="PSA 35:8">ኡንቱንቱ ዎዳ ጲሪ ኡንቱንታ ኦይቆ፤</para>
  <para style="q2" vid="PSA 35:8">ኡንቱንቱ ባሻ ኦላን ኩንድኖ።<verse eid="PSA 35:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9"/>ሄ ዎደ ታን መና ጎዳን ናሸታና፤</para>
  <para style="q2" vid="PSA 35:9">እ አሼዳ ድራዉ፥ ታን ናሸቻ ኖጩ ጋና።<verse eid="PSA 35:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10"/>ታ ኩመን አሳተይ ኔና፥</para>
  <para style="q2" vid="PSA 35:10">“አቤት መና ጎዳዉ፥ ነ ማል ኦኔ?</para>
  <para style="q1" vid="PSA 35:10">ህዬሳ ዎልቃማ ኩሽያፐ ዎ አካሳ።</para>
  <para style="q2" vid="PSA 35:10">ህዬሳነ መቶታንቻ ቦንቂ ምያዋንቱ ኩሽያፐ አሻሳ” ያጋና።<verse eid="PSA 35:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11"/>ዎርዱዋ ማርካትያዋንቱ ታ ቦላ ደንዲኖ።</para>
  <para style="q2" vid="PSA 35:11">ታን ኤረናባን ታና ሞቲኖ።<verse eid="PSA 35:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12"/>ታን ሎኡዋ ኦዳዋ ኩሽያ ኢታ ዛሪኖ፤</para>
  <para style="q2" vid="PSA 35:12">ያትና፥ ታን ታረካ አታድ።<verse eid="PSA 35:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13"/>ሽን ታን ኡንቱንቱ ሀርጌዳ ዎደ፥</para>
  <para style="q2" vid="PSA 35:13">ማቃ ማያድ፤ ታ አሳተ ጾማን ዳቡርሳድ።</para>
  <para style="q1" vid="PSA 35:13">ታ ዎሳይ ዛሩዋ ደመናን አቴዳ።<verse eid="PSA 35:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 35:14"/>ታ ሁጲያ ዝቂ ኦደ፥ ታ ዳቦ፥</para>
  <para style="q2" vid="PSA 35:14">ዎይ ታ እሻዉ ዬክያዋዳን ዬካድ።</para>
  <para style="q1" vid="PSA 35:14">እት አሳይ ባረ አትዉ ካዮትያዋዳን ታ ሁጲያ ኦይቃደ፥</para>
  <para style="q2" vid="PSA 35:14">ዬካደ ሀመታድ።<verse eid="PSA 35:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15"/>ሽን ኡንቱንቱ ታን በቴዳዋን ናሸቲደ፥</para>
  <para style="q2" vid="PSA 35:15">ታ ቦላ ሺቄድኖ።</para>
  <para style="q1" vid="PSA 35:15">ታን ኤረና ጋሱዋን ታና ዋደ፥</para>
  <para style="q2" vid="PSA 35:15">አጉዋ እጼድኖ።<verse eid="PSA 35:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16"/>ኢታ አሳይ ቅሊጭያዋዳን ኡንቱንቱ ታና ቅሊጪኖ፤</para>
  <para style="q2" vid="PSA 35:16">ኡንቱንቱ ይሎቲደ፥ ባረንቱ አቻ ጋርጬድኖ።<verse eid="PSA 35:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17"/>አቤት ጾሳዉ፥ ኔን አዉደ ጋካናዉ</para>
  <para style="q2" vid="PSA 35:17">ጮኡ ጋደ ጼላይ?</para>
  <para style="q1" vid="PSA 35:17">ኡንቱንቱ ኢታ ኦሱዋፐ ታና አሻ፤</para>
  <para style="q2" vid="PSA 35:17">ሀ ጋሞቱዋ ማላ አሳቱዋፐ ታ አልኦ ሸምፑዋ አሻ።<verse eid="PSA 35:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18"/>ሄ ዎደ ግታ ሺቁዋን ታን ነዉ ጋላታ እማና፤</para>
  <para style="q2" vid="PSA 35:18">ጮራ አሳ ሺቁዋን ታን ኔና ሳባና።<verse eid="PSA 35:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19"/>ጋሱ ባይናን ታና ሞርክያዋንቱ ናሸቶፕኖ፤<note caller="-" style="x"><char style="xo" closed="false">35:19 </char><char style="xt" closed="false"><ref loc="PSA 69:4">ማዝ. 69:4</ref>፤ <ref loc="JHN 15:25">ዮሃ. 15:25</ref></char></note></para>
  <para style="q2" vid="PSA 35:19">ታና ጮ እጽያዋንቱ ታ ቦላ ስምኤቶፕኖ።<verse eid="PSA 35:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20"/>ኡንቱንቱ ሳሮባ ሃሳይያዋ አጊደ፥</para>
  <para style="q2" vid="PSA 35:20">ቢታን ጮኡ ጊደ ደእያ አሳቱዋ ቦላን</para>
  <para style="q2" vid="PSA 35:20">ዎርዱዋ መደ ሃሳዪኖ።<verse eid="PSA 35:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21"/>ኡንቱንቱ ባረንቱ እንጻርሳ ታ ቦላ ቃራዪደ፥</para>
  <para style="q2" vid="PSA 35:21">“ኤ፥ ኤ፥ ኔን ኦዳዋ</para>
  <para style="q2" vid="PSA 35:21">ኑን ኑ አይፍያን በኤዶ” ያጊኖ።<verse eid="PSA 35:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22"/>አቤት መና ጎዳዉ፥ ኔን ሀዋ በኣደ፤</para>
  <para style="q2" vid="PSA 35:22">ጮኡ ጎፓ።</para>
  <para style="q1" vid="PSA 35:22">አቤት ጾሳዉ፥ ኔን ታፐ ሃኮፓ።<verse eid="PSA 35:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23"/>አቤት ታ ጎዳዉ፥ ታ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 35:23">ታ ድራዉ ደንዳ፤ ቤጎታ</para>
  <para style="q2" vid="PSA 35:23">ታ ዶና ግዳደ ሞተታ።<verse eid="PSA 35:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24"/>አቤት መና ጎዳዉ፥ ታ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 35:24">ነ ጽሎተን ታና ሻትን፤</para>
  <para style="q2" vid="PSA 35:24">ታ ሞርከቱዋ ናሸቾፓ።<verse eid="PSA 35:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25"/>ኡንቱንቱ ባረንቶ፥ “ሀሹ፥ ሀሹ፥</para>
  <para style="q2" vid="PSA 35:25">ኑን ኑ ዎዛናን አሞቴዳዋ ጋዶ።</para>
  <para style="q1" vid="PSA 35:25">ኑን አ ምቴዶ” ጋናዳን ኦፓ።<verse eid="PSA 35:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26"/>ታ ዋይያን ናሸትያዋንቱ ኡባይ</para>
  <para style="q2" vid="PSA 35:26">ዬላትኖነ ካዉሽኖ።</para>
  <para style="q1" vid="PSA 35:26">ታ ቦላን ኦቶረትያዋንቱ</para>
  <para style="q2" vid="PSA 35:26">ዬላነ ካዉሻ ማይኖ።<verse eid="PSA 35:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27"/>ታን ሻትምያዋ ዶስያዋንቱ</para>
  <para style="q2" vid="PSA 35:27">ናሸቲደ፥ “ሀሹ!” ጊኖ።</para>
  <para style="q1" vid="PSA 35:27">ኡንቱንቱ ኡባ ገደ፥ “ባረ ቆማ ሳሮተን</para>
  <para style="q2" vid="PSA 35:27">ናሸትያ መና ጎዳይ ግታቶ” ያግኖ።<verse eid="PSA 35:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28"/>ጋላሳ ኩመንን ታ እንጻርሳይ፥</para>
  <para style="q2" vid="PSA 35:28">ነ ጽሎተባነ ነ ጋላታባ ኦዳና።<verse eid="PSA 35:28"/></para>
  <chapter eid="PSA 35"/>
  <chapter number="36" style="c" sid="PSA 36"/>
  <para style="s1">ናጋራንቻ ኢታተነ ጾሳ ሎኦተ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ መና ጎዳ ቆማ ዳዊታ ማዝሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1"/>ኢታ አሳይ ባረ ዎዛናን ደእያ ኢታተ ኮሻ ሀይዜ።<note caller="-" style="x"><char style="xo" closed="false">36:1 </char><char style="xt" closed="false"><ref loc="ROM 3:18">ሮመ 3:18</ref></char></note></para>
  <para style="q2" vid="PSA 36:1">ጾሳዉ ያይያዌ አ ቆፋን ባዋ።<verse eid="PSA 36:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2"/>አያዉ ጎፐ፥ እ ባረና ሎይ ናሼ፤</para>
  <para style="q2" vid="PSA 36:2">ሄዎ እ ባረ ናጋራ ደማናዉነ እጻናዉ ዳንዳየና።<verse eid="PSA 36:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3"/>አ ዶናፐ ከስያ ሃሳያይ ገንያነ ዎርዱዋ።</para>
  <para style="q2" vid="PSA 36:3">አዳ ኤራባነ ሎኦባ ኦያዋ እ አጌዳ።<verse eid="PSA 36:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4"/>እ ባረ ሂጻን ደኢደካ ገንያባ ኦናዉ ሀልቼ።</para>
  <para style="q2" vid="PSA 36:4">እ ሎኦ ግደና ኦግያን ኤቄዳ፤</para>
  <para style="q1" vid="PSA 36:4">እ ኢታባ እጸና።<verse eid="PSA 36:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5"/>አቤት መና ጎዳዉ፥ አገና ነ ሲቁ ሳሎቱዋ ጋኬ፤</para>
  <para style="q2" vid="PSA 36:5">ነ ቱማተይካ ቦላ ሻርያዳን ቄ።<verse eid="PSA 36:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6"/>ነ ጽሎተይ ኡባፐ ቃ ደረቱዋ ማላ፤</para>
  <para style="q2" vid="PSA 36:6">ነ ፕርዳይካ ኡባፐ ዝቃ ጪማ ማላ።</para>
  <para style="q1" vid="PSA 36:6">አቤት መና ጎዳዉ፥ ኔን አሳካ ዶኣካ ናጋሳ።<verse eid="PSA 36:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7"/>አቤት ጾሳዉ፥ አገና ነ ሲቁ አይባ አልኦቤ!</para>
  <para style="q2" vid="PSA 36:7">አሳይ ነ ቀፍያ ግዶ ባቃት አቴ።<verse eid="PSA 36:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8"/>ኡንቱንቱ ነ ሶ ግዶን ፓላሆ ማዳፐ ሚደ ካሊኖ፤</para>
  <para style="q2" vid="PSA 36:8">ነ ኬካተ ሻፋፐ ኔን ኡንቱንታ ኡሻሳ።<verse eid="PSA 36:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9"/>አያዉ ጎፐ፥ ደኡዋ ፑልቱ ነ ማታን ደኤ፤</para>
  <para style="q2" vid="PSA 36:9">ነ ፖኡዋን ኑን ፖኡዋ በኤቶ።<verse eid="PSA 36:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10"/>ኔና ኤርያዋንታ ኔን ሲቅያ ሲቁዋነ</para>
  <para style="q2" vid="PSA 36:10">ሱረቶ ኬክያ ኬካ አጎፓ።<verse eid="PSA 36:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11"/>ኦቶራንቻ ገዲ ታና የፖ፤</para>
  <para style="q2" vid="PSA 36:11">ናጋራንቻቱዋ ኩሺ ታና የደርሶፖ።<verse eid="PSA 36:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12"/>ኢታ አሳቱ ኩንዴዳዋንታ በእተ፤</para>
  <para style="q2" vid="PSA 36:12">ኡንቱንቱ ኩንዴድኖ፤ ደንዳናዉካ ዳንዳይክኖ።<verse eid="PSA 36:12"/></para>
  <chapter eid="PSA 36"/>
  <chapter number="37" style="c" sid="PSA 37"/>
  <para style="s1">ኢታቱዋነ ሎአቱዋ ዉርሰ</para>
  <para style="d">ዳዊታ ማዝሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1"/>ኢታ ኦያዋንቱ ድራዉ ይሎቶፓ።</para>
  <para style="q2" vid="PSA 37:1">ናጋራ ኦያዋንታ ቃናቶፓ።<verse eid="PSA 37:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2"/>አያዉ ጎፐ፥ ኡንቱንቱ ማታዳን ኤለካ መላና፤</para>
  <para style="q2" vid="PSA 37:2">ሹሌዳ ቦንጭያዳን ኡንቱንቱ ቆቆፈታና።<verse eid="PSA 37:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3"/>ኔን መና ጎዳን አማነታ፤ ሎኦባ ኦ።</para>
  <para style="q2" vid="PSA 37:3">ያታደ ቢታን ፓላህና ደአ።<verse eid="PSA 37:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4"/>መና ጎዳን ናሸታ፤</para>
  <para style="q2" vid="PSA 37:4">እ ነዉ ነ ዎዛና አሙዋ እማና።<verse eid="PSA 37:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5"/>ነ ኦግያ ሀዳራ መና ጎዳዉ እማ።</para>
  <para style="q2" vid="PSA 37:5">አን አማነታ፤ እ ነዉ ኦና።<verse eid="PSA 37:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6"/>እ ነ ጽሎተ ዎንታ ጻልቂያዳን፥</para>
  <para style="q2" vid="PSA 37:6">ቃይ ነ የዉዋ ፕርዳ ጋላሳ ሴታ አዋዳን ፖእሳና።<verse eid="PSA 37:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7"/>መና ጎዳ ስንን ጮኡ ጋደ፥</para>
  <para style="q2" vid="PSA 37:7">እ ኦናዉ፥ ዳንዳያን ናጋ።</para>
  <para style="q1" vid="PSA 37:7">ኡንቱንቱ ኢታ ሀልቹ ፖለትና፥</para>
  <para style="q2" vid="PSA 37:7">ዱረቴዳ አሳቱዋ ቦላ ይሎቶፓ።<verse eid="PSA 37:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8"/>ሀንቁዋ አጋ፤ ይሉዋፐ ተኤታ።</para>
  <para style="q2" vid="PSA 37:8">ይሎቶፓ፤ አያዉ ጎፐ፥ ሄዌ መቱዋን የጌ።<verse eid="PSA 37:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9"/>ኢታ ኦያዋንቱ ቆለቲደ ያና፤</para>
  <para style="q2" vid="PSA 37:9">ሽን መና ጎዳን ህዶታ ኦያዋንቱ ቢታ ላታና።<verse eid="PSA 37:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10"/>ኢታ ኦያዋንቱ ጉ ዎድያፐ ጉይያን ደእክኖ፤</para>
  <para style="q2" vid="PSA 37:10">ኔን ኡንቱንታ ኮይንቶካ ኡንቱንቱ ቤትክኖ።<verse eid="PSA 37:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11"/>ሽን አሽከቱ ቢታ ላታና፤<note caller="-" style="x"><char style="xo" closed="false">37:11 </char><char style="xt" closed="false"><ref loc="MAT 5:5">ማቶሳ 5:5</ref></char></note></para>
  <para style="q2" vid="PSA 37:11">ኡንቱንቱ ግታ ሳሮተን ናሸቲደ ደአና።<verse eid="PSA 37:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12"/>ኢታ አሳይ ጽሎ አሳ ቦላ ማቀቴነ</para>
  <para style="q2" vid="PSA 37:12">ባረ አቻ ጋርጬ።<verse eid="PSA 37:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13"/>ሽን ጎዳይ ኢታቱዋ ቦላን ሚጬ፤</para>
  <para style="q2" vid="PSA 37:13">አያዉ ጎፐ፥ ኡንቱንቱ ፕርዳ ጋላሳይ ይያዋ እ ኤሬ።<verse eid="PSA 37:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14"/>ኢታ አሳቱ ህዬሳቱዋነ መቶታንቻቱዋ ኡንጋናዉነ</para>
  <para style="q2" vid="PSA 37:14">ሱረተን ሀመትያዋንታ ዎናዉ፥</para>
  <para style="q1" vid="PSA 37:14">ባረንቱ ማሻ ሾዴድኖነ</para>
  <para style="q2" vid="PSA 37:14">ባረንቱ ዎንዳፍያ ዳፌድኖ።<verse eid="PSA 37:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15"/>ሽን ኡንቱንቱ ማሻይ ኡንቱንቱ ዎዛና አይፍያን ገላና፤</para>
  <para style="q2" vid="PSA 37:15">ኡንቱንቱ ዎንዳፊካ መአና።<verse eid="PSA 37:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16"/>ጽሎ ደእያ ጉባይ</para>
  <para style="q2" vid="PSA 37:16">ጮራ ኢታ አሳቶ ደእያ ዳሮባፐ ሎአ።<verse eid="PSA 37:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17"/>አያዉ ጎፐ፥ ኢታቱዋ ዎልቃይ መአና፤</para>
  <para style="q2" vid="PSA 37:17">ሽን ጽሎቱዋ መና ጎዳይ ዘምፕሴ።<verse eid="PSA 37:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18"/>ሱረ አሳቱዋ ኦግያ መና ጎዳይ ኤሬ፤</para>
  <para style="q2" vid="PSA 37:18">ኡንቱንቱ ላታይካ መናዉ ኡንቱንቱዋ ግዳና።<verse eid="PSA 37:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19"/>ኢታ ዎድያን ሱረ አሳቱ ዬላትክኖ፤</para>
  <para style="q2" vid="PSA 37:19">ኮሻ ዎድያን ኡንቱንቱ ካላና።<verse eid="PSA 37:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20"/>ሽን ኢታ አሳቱ ሀይቃና።</para>
  <para style="q2" vid="PSA 37:20">መና ጎዳ ሞርከቱ ጋምኤና ደምባ ጪሻ ማላ፤</para>
  <para style="q2" vid="PSA 37:20">ኡንቱንቱ ጩዋዳን ያና።<verse eid="PSA 37:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21"/>ኢታ አሳይ ታልእ አኪደ ጭገና፤</para>
  <para style="q2" vid="PSA 37:21">ሽን ጽሎ አሳይ ቃረቲደ እሜ።<verse eid="PSA 37:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22"/>መና ጎዳን አንጀቴዳዋንቱ ቢታ ላታና፤</para>
  <para style="q2" vid="PSA 37:22">ሽን ሸቀቴዳዋንቱ ቆለት ያና።<verse eid="PSA 37:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23"/>አሳ ኦጊ መና ጎዳ ናሸቾፐ፥</para>
  <para style="q2" vid="PSA 37:23">ጎዳይ አ ታንጉዋ ካለነ ምንሴ።<verse eid="PSA 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24"/>እ በቶፐካ ኩንደና፤</para>
  <para style="q2" vid="PSA 37:24">አያዉ ጎፐ፥ መና ጎዳይ አ ኩሽያ ኦይቂደ ዘምፕሴ።<verse eid="PSA 37:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25"/>ታን ካሰ ያላጋ፤ ሀእ ስም ጭማድ፤</para>
  <para style="q2" vid="PSA 37:25">ሽን ጽሎ አሳይ ጮ አትና፥</para>
  <para style="q2" vid="PSA 37:25">ዎይ አ ናናቱ ምያዋ ይ ዎስሽን፥</para>
  <para style="q2" vid="PSA 37:25">ታን ኡባካ በአ ኤርከ።<verse eid="PSA 37:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26"/>እ ኡባ ዎደካ ኬካ፤</para>
  <para style="q2" vid="PSA 37:26">ጮ ታልኤ።</para>
  <para style="q1" vid="PSA 37:26">አ ናናቱካ ሀራቶ አንጆ ግዳናዋንታ።<verse eid="PSA 37:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27"/>ኢታፐ ሃካ፤ ሎኦባ ኦ።</para>
  <para style="q2" vid="PSA 37:27">ያቶፐ፥ ኔን አዱሳ ላይ ደአና።<verse eid="PSA 37:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28"/>አያዉ ጎፐ፥ መና ጎዳይ ጽሎባ ዶሴ።</para>
  <para style="q2" vid="PSA 37:28">ጾሳ አሳቱዋ እ አገና፤</para>
  <para style="q2" vid="PSA 37:28">ጽሎቱ መናዉ ናገቲኖ።</para>
  <para style="q2" vid="PSA 37:28">ሽን ኢታቱዋ ዘረይ ቆለታና።<verse eid="PSA 37:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29"/>ጽሎቱ ቢታ ላታናነ</para>
  <para style="q2" vid="PSA 37:29">ያን መናዉ ደአና።<verse eid="PSA 37:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30"/>ጽሉዋ ዶናይ አዳ ኤራ ኦዴ፤</para>
  <para style="q2" vid="PSA 37:30">አ እንጻርሳይካ ጽሎባ ሃሳዬ።<verse eid="PSA 37:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31"/>አ ጾሳ ህጊ አ ዎዛናን ደኤ፤</para>
  <para style="q2" vid="PSA 37:31">አ ገዲካ አፐ ሀልጸና።<verse eid="PSA 37:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32"/>ኢታ አሳይ ጽሎ አሳ ዎቼነ</para>
  <para style="q2" vid="PSA 37:32">ዎናዉ ኮዬ።<verse eid="PSA 37:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33"/>ሽን መና ጎዳይ ጽሎ አሳ አ ኩሽያን አገና፤</para>
  <para style="q2" vid="PSA 37:33">ፕርዳዉ ኤቂያ ዎደካ አ ቦላ ፕርድሰና።<verse eid="PSA 37:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34"/>መና ጎዳን ህዶታ ዎደ፥ አ ኦግያ ናጋ።</para>
  <para style="q2" vid="PSA 37:34">ኔን ቢታ ላታና ማላ፥</para>
  <para style="q1" vid="PSA 37:34">እ ኔና ዳርሳና።</para>
  <para style="q2" vid="PSA 37:34">ኢታ አሳቱ ቆለቲደ ይሽና፥</para>
  <para style="q2" vid="PSA 37:34">ኔን በአና።<verse eid="PSA 37:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35"/>ታን እት ዳጋንያ ኢታ ብታንያ፥</para>
  <para style="q2" vid="PSA 37:35">ዎላዳን ዳሼዳዋ በኣድ።<verse eid="PSA 37:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36"/>ሽን ታን ሄ ሳና</para>
  <para style="q2" vid="PSA 37:36">ስማደ አያ ዎደ እ ዬዳ፤</para>
  <para style="q1" vid="PSA 37:36">ኮይናካ እ ቤትቤና።<verse eid="PSA 37:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37"/>አነ ሎኦ አሳ አኬካ፤ ሱረ አሳ በአ፤</para>
  <para style="q2" vid="PSA 37:37">አያዉ ጎፐ፥ ሳሮ አሳዉ ፖሉ ሎአና።<verse eid="PSA 37:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38"/>ሽን ባይዛንቻቱ ኡባ ያና፤</para>
  <para style="q2" vid="PSA 37:38">ኢታቱዋ ፖሉካ ቆለት ያና።<verse eid="PSA 37:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39"/>ጽሎቱዋ አቶተይ መና ጎዳፐ ዬ፤</para>
  <para style="q2" vid="PSA 37:39">መቱዋ ዎደ እ ኡንቱንቶ ናገት አትያ ሳኣ።<verse eid="PSA 37:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40"/>መና ጎዳይ ጽሎቱዋ ማዴነ አሼ።</para>
  <para style="q2" vid="PSA 37:40">ኡንቱንቱ አኮ ባቃቴዳ ድራዉ፥</para>
  <para style="q1" vid="PSA 37:40">እ ኡንቱንታ ኢታቱዋፐ ዎ አኬነ አሼ።<verse eid="PSA 37:40"/></para>
  <chapter eid="PSA 37"/>
  <chapter number="38" style="c" sid="PSA 38"/>
  <para style="s1">ኡንኤቴዳ አሳ ዎሳ</para>
  <para style="d">ዳዊታ ሀሳይስያዋ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1"/>አቤት መና ጎዳዉ፥ ነ ሀንቁዋን ታና ሴሮፓ፤</para>
  <para style="q2" vid="PSA 38:1">ነ ይሉዋን ታና ሙሮፓ።<verse eid="PSA 38:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2"/>ነ ዎንዳፍያ ፖይ ታና ጫድ ድጌድኖ፤</para>
  <para style="q2" vid="PSA 38:2">ነ ኩሺካ ታና ናቂ ኦይቄዳ።<verse eid="PSA 38:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3"/>ኔን ላንጬዳ ድራዉ፥ ታ ቦላይ ፓጻ ግደና፤</para>
  <para style="q2" vid="PSA 38:3">ታ ናጋራ ድራዉ፥ ታ አሳተይ ሳራ ግደና።<verse eid="PSA 38:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4"/>ታ ኢታተይ ድኡዋዳን ታና ሙኬዳ፤</para>
  <para style="q2" vid="PSA 38:4">ደንደና ዎልቃማ ቶኩዋዳን ታዉ ዴጼዳ።<verse eid="PSA 38:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5"/>ታን ናጋራ ኦዳ ኤያተ ድራዉ፥</para>
  <para style="q2" vid="PSA 38:5">ታ ማዱይ ጊሻ ኦይቂደ ጽንቄዳ።<verse eid="PSA 38:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6"/>ታን ሆካድነ ቁናድ።</para>
  <para style="q2" vid="PSA 38:6">ጋላሳ ኩመን ዬካደ ፔሻድ።<verse eid="PSA 38:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7"/>ታ አሹዋ ምሹ ጹጌ፤</para>
  <para style="q2" vid="PSA 38:7">ታ ቦላይ ፓጻ ግደና።<verse eid="PSA 38:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8"/>ታን ዳቡራድነ ንፕ ጋድ፤</para>
  <para style="q2" vid="PSA 38:8">ታ ዎዛናይ ድድቅያ ድራዉ ኦላይ።<verse eid="PSA 38:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9"/>አቤት ጾሳዉ፥ ታ አሙ ኡባይ ነዉ ኤረቴ፤</para>
  <para style="q2" vid="PSA 38:9">ታን ኦልያዌ ኔፐ ጌምቤና።<verse eid="PSA 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10"/>ታ ዎዛና አይፍያን ድድቄ፤</para>
  <para style="q2" vid="PSA 38:10">ታ ዎልቃይ እጽና፤</para>
  <para style="q1" vid="PSA 38:10">ታ አይፊካ ጼላ እጼዳ።<verse eid="PSA 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11"/>ታ ማይ ድራዉ፥</para>
  <para style="q2" vid="PSA 38:11">ታ ሾሮቱካ ታ ላገቱካ ሃኩዋን ኤቄድኖ።</para>
  <para style="q1" vid="PSA 38:11">ታ ዳቦቱካ ታፐ ሃኬድኖ።<verse eid="PSA 38:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12"/>ታና ዎናዉ ኮይያዋንቱ፥</para>
  <para style="q2" vid="PSA 38:12">ባረንቱ ጲርያ ታዉ የጊኖ።</para>
  <para style="q1" vid="PSA 38:12">ታና ቆሀናዉ ኮይያዋንቱ፥</para>
  <para style="q2" vid="PSA 38:12">“ኤቃሻ፤ ኑን ኔና ደማና” ያጊደ፥</para>
  <para style="q2" vid="PSA 38:12">ማንዲኖነ ጋላሳ ኩመን ታ ቦላ ያኢኖ።<verse eid="PSA 38:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13"/>ሄ ዎደ ታን ቱለ አሳ ማላ፥ ስስከ፤</para>
  <para style="q2" vid="PSA 38:13">ታን ዱደ አሳ ማላ፥ ዶናነ ፖክከ።<verse eid="PSA 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14"/>ኤ፥ ታን ስሰናነ</para>
  <para style="q2" vid="PSA 38:14">ዶናይ ዛረና አሳ ማላ።<verse eid="PSA 38:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15"/>ሽን አቤት መና ጎዳዉ፥ ታን ኔናን ህዶታ ኦይ።</para>
  <para style="q2" vid="PSA 38:15">አቤት መና ጎዳዉ፥ ታ ጾሳዉ፥ ኔን ታዉ ዛሩዋ እማና።<verse eid="PSA 38:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16"/>ታን ጾሳ፥ “ታ ገዲ በትና፥</para>
  <para style="q2" vid="PSA 38:16">ኡንቱንቱ፥ ‘አዉ ሀሹ’ ጋናዳንነ</para>
  <para style="q2" vid="PSA 38:16">ታ ቦላ ጬቀታናዳን ኦፓ” ያጋይ።<verse eid="PSA 38:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17"/>ታን ኩንዳና ሀናይ፤</para>
  <para style="q2" vid="PSA 38:17">ታ ሳኩካ ታና የደናን እጼዳ።<verse eid="PSA 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18"/>ታን ታ ኢታ ኦሱዋ ፓጻይ፤</para>
  <para style="q2" vid="PSA 38:18">ታን ታ ናጋራ ጋሱዋን ካዮታይ።<verse eid="PSA 38:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19"/>ታ ሞርከቱ ጎባነ ዎልቃማ፤</para>
  <para style="q2" vid="PSA 38:19">ታና ጮ እጽያዋንቱ ጮራ።<verse eid="PSA 38:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20"/>ታን ሎኦባ ኦና፥</para>
  <para style="q2" vid="PSA 38:20">ታዉ ኢታ ዛርያ አሳቱ፥</para>
  <para style="q1" vid="PSA 38:20">ታን ሎኦባ ካልያ ድራዉ፥ ታና ኤቀቲኖ።<verse eid="PSA 38:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21"/>አቤት መና ጎዳዉ፥ ታና የጎፓ።</para>
  <para style="q2" vid="PSA 38:21">አቤት ታ ጾሳዉ፥ ታፐ ኔን ሃኮፓ።<verse eid="PSA 38:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22"/>አቤት መና ጎዳዉ፥ ታና አሽያዎ፥</para>
  <para style="q2" vid="PSA 38:22">ታና ማዳናዉ ኤሌላ።<verse eid="PSA 38:22"/></para>
  <chapter eid="PSA 38"/>
  <chapter number="39" style="c" sid="PSA 39"/>
  <para style="s1">መቱ ጋካ አሳ ፓጸ</para>
  <para style="d">ዳዊተ ዛማረቱዋ ካፑዋ ጁዱቶ የጼዳ አማኑዋ ቃላ (1 ኦዱዋ 25:3)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 39:1"/>ታን፥ “ታ እንጻርሳን ናጋራ ኦናዳን፥</para>
  <para style="q2" vid="PSA 39:1">ታ ኦግያ ናጋና።</para>
  <para style="q3" vid="PSA 39:1">ኢታ አሳቱ ታ ስንን ደእያ ዎደ፥</para>
  <para style="q3" vid="PSA 39:1">ታ ዶና ባራና” ያጋድ።<verse eid="PSA 39:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2"/>ሽን ታን ዱድያዳን ጮኡ ጋድ፤</para>
  <para style="q2" vid="PSA 39:2">ታን ሀራይ አቶ ሎኦባ ሃሳይያዋካ አግና፥</para>
  <para style="q1" vid="PSA 39:2">ታ ዋዪ ያ ዳሬዳ።<verse eid="PSA 39:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 39:3"/>ታ ዎዛናይ ታ ጋርሳን ሴሌዳ፤</para>
  <para style="q2" vid="PSA 39:3">ታ ቆፋይ ፖዱ ጊደ፥ ኤጽ ከሴዳ።</para>
  <para style="q1" vid="PSA 39:3">ያትና፥ ታ እንጻርሳን ሀዋዳን ያጋድ፤<verse eid="PSA 39:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4"/>“አቤት መና ጎዳዉ፥ ታ ደኡዋ ዉርሰነ</para>
  <para style="q2" vid="PSA 39:4">ታ ደአናዉ አቴዳ ጋላሳ ታና በሳ።</para>
  <para style="q1" vid="PSA 39:4">ቃይ ታ ደኡ ዉራናዉ አይ ኬሻ ኤሌልንቶ፥ ታና ኤርሳ።<verse eid="PSA 39:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5"/>ኔን ታ ላይ ጺ ታካ ኬሻ ከሳዳ።</para>
  <para style="q2" vid="PSA 39:5">ታ ላይይ ነ ስንን ባይናዋ ማላ፤</para>
  <para style="q2" vid="PSA 39:5">ቱሙዋፐ አሳይ ኡባይ እት ገደ ሸምፕያ ጫርኩዋ ማላ።<verse eid="PSA 39:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6"/>ቱሙዋፐ አሳይ ኤሹዋዳን ሀመቴ፤</para>
  <para style="q2" vid="PSA 39:6">ቱሙዋፐ ጮ መላ ስመረቴ።</para>
  <para style="q1" vid="PSA 39:6">እ ማጹዋ ሺሼ፤ ሽን አካና አሳ ኤረና።<verse eid="PSA 39:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7"/>“አቤት ጎዳዉ፥ ሀእ ስም፥</para>
  <para style="q2" vid="PSA 39:7">ታን ናግያዌ አዬ?</para>
  <para style="q1" vid="PSA 39:7">ታን ህዶታ ኦያዌ ኔናና።<verse eid="PSA 39:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8"/>ታ ባይዙዋ ኡባፐ ታና አሻ፤</para>
  <para style="q2" vid="PSA 39:8">ኤያቱዋን ታና ቶሽሶፓ።<verse eid="PSA 39:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9"/>ሀዋ ኡባ ኦዳዌ</para>
  <para style="q2" vid="PSA 39:9">ኔና ግድያ ድራዉ፥ ታን ዱዳድ፤</para>
  <para style="q1" vid="PSA 39:9">ዶናነ ፖጋበይከ።<verse eid="PSA 39:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10"/>ነ ቦሻ ታ ቦላፐ ደን።</para>
  <para style="q2" vid="PSA 39:10">ነ ኩሽያ ምኖተ ጋሱዋን ታን ዳቡራድ።<verse eid="PSA 39:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11"/>ኔን አሳ አ ናጋራ ድራዉ፥ ሴራሳነ ሙራሳ፤</para>
  <para style="q2" vid="PSA 39:11">አ አልኦ ሸምፑዋ ብልኣዳን ዉርሳሳ።</para>
  <para style="q1" vid="PSA 39:11">ቱሙዋፐ አሳይ ኡባይ እት ገደ ጫርክያ ጫርኩዋ ማላ።<verse eid="PSA 39:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12"/>“አቤት መና ጎዳዉ፥ ታ ዎሳ ስሳ፤</para>
  <para style="q2" vid="PSA 39:12">ታና ማዳናዉ ታ ዋሱዋ ሀይዛ።</para>
  <para style="q1" vid="PSA 39:12">ታ አፎ ጮኡ ጎፓ፤</para>
  <para style="q2" vid="PSA 39:12">አያዉ ጎፐ፥ ታን ታ አዎቱዋ ኡባዳን በተነ እማ ግዳደ፥</para>
  <para style="q2" vid="PSA 39:12">ኔናና ደአይ።<verse eid="PSA 39:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13"/>ታን ሻከታናፐነ ያናፐ፥</para>
  <para style="q2" vid="PSA 39:13">ካሰታደ ናሸታና ማላ፥</para>
  <para style="q2" vid="PSA 39:13">ሀእ ታና አጋ” ያጋድ።<verse eid="PSA 39:13"/></para>
  <chapter eid="PSA 39"/>
  <chapter number="40" style="c" sid="PSA 40"/>
  <para style="s1">ጋላታ ማዝሙርያ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ዳዊታ ማዝሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1"/>ታን መና ጎዳ ዳንዳያን ናጋድ፤</para>
  <para style="q2" vid="PSA 40:1">እ ታኮ ስሚደ፥ ታ ዋሱዋ ስሴዳ።<verse eid="PSA 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2"/>ባሻ ኦላፐ፥ ሀልያ ኡርቃፐ ታና ከሴዳ።</para>
  <para style="q2" vid="PSA 40:2">ታ ገድያ ዛላ ቦላን ኤሴዳ፤</para>
  <para style="q2" vid="PSA 40:2">ቃይ ታ ሀመካ ሳሩዋ ኦዳ።<verse eid="PSA 40:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3"/>እ ታ ዶናን ኦራ የ ዎዳ፤</para>
  <para style="q2" vid="PSA 40:3">ሄ የይነ፥ “ኑ ጾሳይ ጋላተቶ” ያግያዋ።</para>
  <para style="q1" vid="PSA 40:3">ዳሮቱ በኢደ፥ ያያናነ መና ጎዳን አማነታና።<verse eid="PSA 40:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4"/>መና ጎዳ ባረዉ አማነትያዋ ኦዳ አሳይ፥</para>
  <para style="q2" vid="PSA 40:4">ኦቶራንቻቱዋኮ ጼለናዌነ፥</para>
  <para style="q2" vid="PSA 40:4">ዎርዳንቻቱዋኮ ስመና አሳይ አንጀቴዳዋ።<verse eid="PSA 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5"/>አቤት መና ጎዳዉ፥ ታ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 40:5">ኔን ዳሮ ማላልስያባ ኦዳ፤</para>
  <para style="q1" vid="PSA 40:5">ኔናና ልከትያዌ ኦንነ ባዋ!</para>
  <para style="q2" vid="PSA 40:5">ኔን ኑዉ ቆፔዳ ሎኦ ቆፋ</para>
  <para style="q2" vid="PSA 40:5">ኦንነ ፓይዳናዉ ዳንዳየና።</para>
  <para style="q2" vid="PSA 40:5">ሄዌ ታን ኦድና፥ ዉርያዋ ግደና።<verse eid="PSA 40:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6"/>ኔን ያርሹዋነ እሙዋ ኮያባካ፤<note caller="-" style="x"><char style="xo" closed="false">40:6-8 </char><char style="xt" closed="false"><ref loc="HEB 10:5-7">እብራ. 10:5-7</ref></char></note></para>
  <para style="q2" vid="PSA 40:6">ሽን ስሳና ማላ፥ ታዉ ሀይ ዶያዳ።</para>
  <para style="q1" vid="PSA 40:6">ጹግያ ያርሹዋነ ናጋራ ያርሹዋ ኔን ኮያባካ።<verse eid="PSA 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7"/>ሄዋፐ ጉይያን ታን፥ “ጻ ማጻፋን</para>
  <para style="q2" vid="PSA 40:7">ታባይ ጻፈቴዳዋዳን፥ ታን ያድ።<verse eid="PSA 40:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8"/>አቤት ታ ጾሳዉ፥ ታን ኔን ኮይያዋ ኦናዉ ዶሳይ፤</para>
  <para style="q2" vid="PSA 40:8">ነ ህጊ ታ ዎዛና ግዶን ደኤ” ያጋድ።<verse eid="PSA 40:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9"/>ዎልቃማ ሺቁዋን ታን፥ “ነ ጽሎተ”</para>
  <para style="q2" vid="PSA 40:9">ምሽራቹዋ ኦዳና።</para>
  <para style="q1" vid="PSA 40:9">አቤት መና ጎዳዉ፥ ኔን ኤርያዋዳንካ፥</para>
  <para style="q2" vid="PSA 40:9">ታን ታ ዶናን ኦድያዋ አጋበይከ።<verse eid="PSA 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10"/>ታን ነ ጽሎተ ታ ዎዛና ግዶን ቆሳበይከ፤</para>
  <para style="q2" vid="PSA 40:10">ኔን አማነትያዋነ አሽያዋ ኦዳድ።</para>
  <para style="q1" vid="PSA 40:10">ቃይ አገና ነ ሲቁዋነ ነ ቱማተ፥</para>
  <para style="q2" vid="PSA 40:10">ነ ዎልቃማ ሺቁዋፐ ገንበይከ።<verse eid="PSA 40:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11"/>አቤት መና ጎዳዉ፥ ነ ማሮተ ታፐ ሃሶፓ።</para>
  <para style="q2" vid="PSA 40:11">አገና ነ ሲቁነ ነ ቱማተይ</para>
  <para style="q2" vid="PSA 40:11">ታና ኡባ ዎደ ናጎ።<verse eid="PSA 40:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12"/>አያዉ ጎፐ፥ ፓይዱ ባይና ኢታባይ ታና ዶዴዳ።</para>
  <para style="q2" vid="PSA 40:12">ታ ኢታተይ ታና ጋኪደ ጎዜዳ፤</para>
  <para style="q2" vid="PSA 40:12">ታን ጼላናዉ ዳንዳይከ።</para>
  <para style="q2" vid="PSA 40:12">ታ ኢታ ኦሱ ታ ሁጲያ ብናናፐ ዳሬዳ፤</para>
  <para style="q2" vid="PSA 40:12">ታ ዎዛናይ ታ ግዶን ሴሬዳ።<verse eid="PSA 40:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13"/>አቤት መና ጎዳዉ፥ ታና አሻናዉ ኤኖ ጋ፤</para>
  <para style="q2" vid="PSA 40:13">አቤት መና ጎዳዉ፥ ታና ማዳናዉ ኤሌላ።<verse eid="PSA 40:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14"/>ታና ዎናዉ ኮይያዋንቱ</para>
  <para style="q2" vid="PSA 40:14">ኡባካ ዬላትኖነ ካዉሽኖ።</para>
  <para style="q1" vid="PSA 40:14">ታን ቆሄታናዋ አሞትያዋንቱ</para>
  <para style="q2" vid="PSA 40:14">ካዉሺደ ጉየ ስምኖ።<verse eid="PSA 40:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15"/>ታ ቦላ፥ “አዉ ሀሹ! ሀሹ!”</para>
  <para style="q2" vid="PSA 40:15">ጌዳዋንቱ ጾነቴዳ ድራዉ፥ ዬላትኖ።<verse eid="PSA 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16"/>ሽን ኔና ኮይያ ኡባቱ፥</para>
  <para style="q2" vid="PSA 40:16">ኔናን ናሸትኖነ ሀሹ ጊኖ።</para>
  <para style="q1" vid="PSA 40:16">ቃይ ነ አቶተ ዶስያዋንቱ ኡባቱ፥</para>
  <para style="q2" vid="PSA 40:16">“መና ጎዳይ ግታቶ!” ያግኖ።<verse eid="PSA 40:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17"/>ታን ህዬሳነ መቶታንቻ፤</para>
  <para style="q2" vid="PSA 40:17">ታዋ ጎዳይ ቆፖ።</para>
  <para style="q1" vid="PSA 40:17">ታና ማድያዌነ አሽያዌ ኔና፤</para>
  <para style="q2" vid="PSA 40:17">አቤት ታ ጾሳዉ፥ ጋምኦፓ።<verse eid="PSA 40:17"/></para>
  <chapter eid="PSA 40"/>
  <chapter number="41" style="c" sid="PSA 41"/>
  <para style="s1">ሀርጋንቻ አሳ ዎሳ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ዳዊታ ማዝሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1"/>ህዬሳዉ ቆፕያ አሳይ አንጀቴዳዋ፤</para>
  <para style="q2" vid="PSA 41:1">መቱዋ ጋላስ መና ጎዳይ አ አሼ።<verse eid="PSA 41:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2"/>መና ጎዳይ አ ናጊደ፥ ፓጻ ዎ።</para>
  <para style="q2" vid="PSA 41:2">እነ ቢታ ቦላን አንጀቴዳዋ ግዴ፤</para>
  <para style="q1" vid="PSA 41:2">ጾሳይ አ አ ሞርከቱዋ አሞ አደ እመና።<verse eid="PSA 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3"/>መና ጎዳይ አ ሀርግያ ሂን ደእሺናካ ማዴ፤</para>
  <para style="q2" vid="PSA 41:3">እ ሳከትናካ፥ አ ፓ።<verse eid="PSA 41:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4"/>ታና ግዶፐ፥ ታን፥ “አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 41:4">ታን ኔና ናቄዳ ድራዉ፥ ታና ማራ፤</para>
  <para style="q1" vid="PSA 41:4">ሀርግያፐካ ታና ፓ” ያጋድ።<verse eid="PSA 41:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5"/>ታ ሞርከቱ ኢታባን ታና ሃሳዪደ፥</para>
  <para style="q2" vid="PSA 41:5">“እ አዉደ ሀይቃንዴሻ?</para>
  <para style="q1" vid="PSA 41:5">ቃይ አ ሱንይካ አዉደ ያንዴሻ?” ያጊኖ።<verse eid="PSA 41:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6"/>ታና በአናዉ ይያ ኦንነ ታዉ ዎርዶባ ኦዴ፤</para>
  <para style="q2" vid="PSA 41:6">ባረ ዎዛናን ታና ዝግርያዋ ብዴ።</para>
  <para style="q1" vid="PSA 41:6">ሄዋፐ ጉይያን፥ ካረ ከሲደ፥</para>
  <para style="q2" vid="PSA 41:6">ያነ ሃነ ኦዱዋ ላሌ።<verse eid="PSA 41:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7"/>ታና እጽያ ኡባቱ</para>
  <para style="q2" vid="PSA 41:7">እትፐ ታ ቦላን ሳሱኪኖ፤</para>
  <para style="q1" vid="PSA 41:7">“ኢታባይ አ ቦላ ጋኬ” ጊደ ቆፒኖ።<verse eid="PSA 41:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8"/>ኡንቱንቱ “አ ኢታ ሀርጊ ኦይቄዳ፤</para>
  <para style="q2" vid="PSA 41:8">እ ሄ ግሴዳሳፐ ኡባካ ደንደና” ያጊኖ።<verse eid="PSA 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9"/>ሀራይ አትና፥ ታን አማነትያ ታ ሲቆ ላጊ፥<note caller="-" style="x"><char style="xo" closed="false">41:9 </char><char style="xt" closed="false"><ref loc="MAT 26:23">ማቶሳ 26:23</ref>፤ <ref loc="MRK 14:18">ማር. 14:18</ref>፤ <ref loc="LUK 22:21">ሉቃሳ 22:21</ref>፤ <ref loc="JHN 13:18">ዮሃ. 13:18</ref></char></note></para>
  <para style="q2" vid="PSA 41:9">ታን ባርሴዳዌ ታ ኩሽያ ሳኤዳ።<verse eid="PSA 41:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10"/>ሽን አቤት መና ጎዳዉ፥ ኔን ታና ማራ፤</para>
  <para style="q2" vid="PSA 41:10">ታን ኡንቱንቱ ኩሽያ ከሳናዳን፥</para>
  <para style="q2" vid="PSA 41:10">ታና ሀርግያ ሂፐ ደን።<verse eid="PSA 41:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11"/>ኔን ታናን ናሸታናዋ ታን ኤራይ፤</para>
  <para style="q2" vid="PSA 41:11">አያዉ ጎፐ፥ ታ ሞርኪ ታና፥</para>
  <para style="q2" vid="PSA 41:11">ጾኒደ ጋይረና።<verse eid="PSA 41:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12"/>ኔን ታና ታ ሱረተ ድራዉ ዘምፕሳዳ፤</para>
  <para style="q2" vid="PSA 41:12">ነ ስንን ታና መናዉ ዎዳ።<verse eid="PSA 41:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13"/>መና ጎዳይ፥ እስራኤልያ ጾሳይ፥</para>
  <para style="q2" vid="PSA 41:13">መናፐ መና ጋካናዉ ጋላተቶ።<note caller="-" style="x"><char style="xo" closed="false">41:13 </char><char style="xt" closed="false"><ref loc="PSA 106:48">ማዝ. 106:48</ref></char></note></para>
  <para style="b" vid="PSA 41:13"/>
  <para style="q1" vid="PSA 41:13">አመንእ። አመንእ።<verse eid="PSA 41:13"/></para>
  <chapter eid="PSA 41"/>
  <chapter number="42" style="c" sid="PSA 42"/>
  <para style="ms">ላኤን ማጻፋ</para>
  <para style="mr">(<ref loc="PSA 42-72">ማዝ. 42—72</ref>)</para>
  <para style="s1">የደሳ ዎደ ዎሳ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ቆረ ናናቱዋ አኬካ ግንጹዋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1"/>ጋራይ ጎግያ ሃ ላሞትያዋዳን፥</para>
  <para style="q2" vid="PSA 42:1">አቤት ጾሳዉ፥ ሄዋዳን ታንካ ኔና ላሞታይ።<verse eid="PSA 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2"/>“ታን ባደ፥ ጾሳ ስን</para>
  <para style="q2" vid="PSA 42:2">በአናዌ አዉዴሻ?” ጋደ፥</para>
  <para style="q1" vid="PSA 42:2">ጾሳ፥ ደኡዋ ጾሳ በአናዉ ሳመታይ።<verse eid="PSA 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3"/>አሳቱ ኡባ ገደ፥ “ነ ጾሳይ ሀቃን ደኢ?”</para>
  <para style="q2" vid="PSA 42:3">ያግያ ዎደ፥ ታዉ ጋላስነ ቃማ ታ አፎይ ቁማ ግዴዳ።<verse eid="PSA 42:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4"/>ታን ኡንቱንቱ ባላ ቦንቻናዉ፥</para>
  <para style="q2" vid="PSA 42:4">ሺቄዳ ዳሮ አሳ ግዱዋና</para>
  <para style="q2" vid="PSA 42:4">ሳልፕያን ሆምቦጭሺናነ</para>
  <para style="q2" vid="PSA 42:4">ጋላታ የ የጽሽን፥</para>
  <para style="q1" vid="PSA 42:4">ጾሳ ጎለ ካለዳዋ ቆፕያ ዎደ፥</para>
  <para style="q2" vid="PSA 42:4">ታ ዎዛናይ ካዮቲደ፥ ግዶን ሴሬዳ።<verse eid="PSA 42:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5"/>ታ ሸምፓቴ፥ ታን አያዉ ካዮታይታ?</para>
  <para style="q2" vid="PSA 42:5">ቃይ አያዉ ጃባካታይታ?</para>
  <para style="q1" vid="PSA 42:5">ታን ጾሳን ህዶታ ዎና።</para>
  <para style="q2" vid="PSA 42:5">አያዉ ጎፐ፥ ታን ብሮ</para>
  <para style="q2" vid="PSA 42:5">ታና አሽያዋነ ታ ጾሳ ጋላታና።<verse eid="PSA 42:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6"/>ታ ዎዛናይ ካዮቴዳ፤ ሄዋ ድራዉ፥</para>
  <para style="q2" vid="PSA 42:6">ታን ዮርዳኖሳ ቢታን፥ ሄርሞነ ቃን፥</para>
  <para style="q1" vid="PSA 42:6">ሚዛረ ደርያን ኤቃደ ኔና ሀሳያይ።<verse eid="PSA 42:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7"/>ነ ሶሱዋ ጉንን ጪሙ ጪማዉ ጼሴ፤</para>
  <para style="q2" vid="PSA 42:7">ቃይ ነ ቤታይነ ነ ሆቢ ኡባይ</para>
  <para style="q2" vid="PSA 42:7">ታ ቦላና ጎጌዳ።<verse eid="PSA 42:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8"/>ጋላስ መና ጎዳይ አገና ባረ ሲቁዋ ታዉ ኪቴ።</para>
  <para style="q2" vid="PSA 42:8">ቃማካ አ የይ ታናና ደኤ፤</para>
  <para style="q2" vid="PSA 42:8">ሄ የይካ ታን ታ ደኡዋ ጾሳ ዎስያ ዎሳ።<verse eid="PSA 42:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9"/>ጾሳ፥ ታ ዎጋ ዛላ ታን፥</para>
  <para style="q2" vid="PSA 42:9">“አያዉ ታና ዶጋዲ?</para>
  <para style="q1" vid="PSA 42:9">ታን አያዉ ታ ሞርክያን ናቀታደ ካዮታደ ሀመቶ?” ያጋይ።<verse eid="PSA 42:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10"/>ታ ሞርከቱ ታና፥</para>
  <para style="q2" vid="PSA 42:10">“ነ ጾሳይ ሀቃን ደኢ?” ያጊደ፥</para>
  <para style="q2" vid="PSA 42:10">ታ መቀ መንደ ቦሪኖ።<verse eid="PSA 42:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11"/>ታ ሸምፓቴ፥ ታን አያዉ ካዮታይታ?</para>
  <para style="q2" vid="PSA 42:11">ቃይ አያዉ ጃባካታይታ?</para>
  <para style="q1" vid="PSA 42:11">ጾሳን ህዶታ ዎና።</para>
  <para style="q2" vid="PSA 42:11">አያዉ ጎፐ፥ ታን ሀእካ</para>
  <para style="q2" vid="PSA 42:11">ታና አሽያዋነ ታ ጾሳ ጋላታና።<verse eid="PSA 42:11"/></para>
  <chapter eid="PSA 42"/>
  <chapter number="43" style="c" sid="PSA 43"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1"/>አቤት ጾሳዉ፥ ታና ሻትን።</para>
  <para style="q2" vid="PSA 43:1">ጾሳ ኤረና አሳቱዋና ታ ሞቱዋ ኔን ሞተታ።</para>
  <para style="q1" vid="PSA 43:1">ጭምያ ኢታ አሳቱዋፐ ታና ኔን አሻ።<verse eid="PSA 43:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2"/>ጾሳዉ፥ ታን ናገታ አትያ ሚጻይ ኔና።</para>
  <para style="q2" vid="PSA 43:2">ኔን ታና አያዉ አጋይ? ታን አያዉ ታ ሞርክያን፥</para>
  <para style="q2" vid="PSA 43:2">ናቀታደ ካዮታደ ሀመቶ?<verse eid="PSA 43:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3"/>ነ ፖኡዋነ ነ ቱሙዋ ታዉ ኪታ፤</para>
  <para style="q2" vid="PSA 43:3">ኡንቱንቱ ታና ካለኖ።</para>
  <para style="q1" vid="PSA 43:3">ነ ጌሻ ደርያ ኔን ደኢያሳ አፍኖ።<verse eid="PSA 43:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4"/>ሄ ዎደ ታን ታ ጾሳ ያርሹዋ ሳኣ፥</para>
  <para style="q2" vid="PSA 43:4">ታና ናሸችያ ጾሳኮ ባና።</para>
  <para style="q1" vid="PSA 43:4">አቤት ጾሳዉ፥ ታ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 43:4">ታን ዲ ዲጻደ፥ ኔና ሳባና።<verse eid="PSA 43:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5"/>ታ ሸምፓቴ፥ ታን አያዉ ካዮታይታ?</para>
  <para style="q2" vid="PSA 43:5">ቃይ አያዉ ጃባካታይታ?</para>
  <para style="q1" vid="PSA 43:5">ታን ጾሳን ህዶታ ዎና።</para>
  <para style="q2" vid="PSA 43:5">አያዉ ጎፐ፥ ታን ብሮ</para>
  <para style="q2" vid="PSA 43:5">ታና አሽያዋነ ታ ጾሳ ጋላታና።<verse eid="PSA 43:5"/></para>
  <chapter eid="PSA 43"/>
  <chapter number="44" style="c" sid="PSA 44"/>
  <para style="s1">ጾሳይ ናጋናዳን ዎሳ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ቆረ ናናቱዋ አኬካ ግንጹዋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1"/>አቤት ጾሳዉ፥ አዳ ዎድያን፥</para>
  <para style="q2" vid="PSA 44:1">ኔን ኦዳዋ ኑን ኑ ሀይን ስሴዶ፥</para>
  <para style="q3" vid="PSA 44:1">ኑ አዎቱዋ ዎድያንካ ነ ኦዳዋ ኑዉ ኦዴድኖ።<verse eid="PSA 44:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2"/>ካዉተቱዋ ኔን ነ ኩሽያን ላጋደ ከሳዳ፤</para>
  <para style="q2" vid="PSA 44:2">ኑ አዎቱዋ ኡንቱንቱ ቢታን ቶካናዉ፤</para>
  <para style="q2" vid="PSA 44:2">ሀራ ካዉተቱዋ ሙራዳ፤</para>
  <para style="q2" vid="PSA 44:2">ሽን ነ አሳቱዋ አሳዳ።<verse eid="PSA 44:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3"/>ኡንቱንቱ ባረንቱ ማሻን ኦሊደ፥</para>
  <para style="q2" vid="PSA 44:3">ሄ ቢታ ከስበይክኖ፤</para>
  <para style="q1" vid="PSA 44:3">ኡንቱንቱ ባረንቱ ኩሽያ ምኖተን ጾንበይክኖ።</para>
  <para style="q2" vid="PSA 44:3">ሽን ኔን ኡንቱንታ ሲቄዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 44:3">ኡንቱንቱ ነ ኡሸቻ ኩሽያ፥</para>
  <para style="q2" vid="PSA 44:3">ነ ቀስያነ ነ ስን ፖኡዋ ዎልቃን ጾኔድኖ።<verse eid="PSA 44:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4"/>ያቆባ አሳዉ ጾኑዋ አዛዝያ፥</para>
  <para style="q2" vid="PSA 44:4">ታ ካቲነ ታ ጾሳይ ኔና።<verse eid="PSA 44:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5"/>ኔናን ግዲደ፥ ኑ ሞርከቱዋ ኑን ሱግ ኦላና፤</para>
  <para style="q2" vid="PSA 44:5">ነ ሱንን ኑ ኤቀትያዋንታ ኑን የና።<verse eid="PSA 44:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6"/>ታን ታ ቶራን አማነትከ፤</para>
  <para style="q2" vid="PSA 44:6">ታ ማሻይካ ታና አሸና።<verse eid="PSA 44:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7"/>ሽን ኔን ኑና ኑ ሞርከቱዋፐ አሻዳ፤</para>
  <para style="q2" vid="PSA 44:7">ቃይ ኑና እጽያዋንታ ኔን ካዉሻዳ።<verse eid="PSA 44:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8"/>ኑን ኡባ ዎደ ጾሳን ጬቀቴቶ፤</para>
  <para style="q2" vid="PSA 44:8">ነ ሱንዉ መናዉ ጋላታ እማና።<verse eid="PSA 44:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9"/>ሽን ሀእ ኔን ኑና አጋዳ፤ ካዉሻዳ፤</para>
  <para style="q2" vid="PSA 44:9">ኑ ቶራ አሳና እትፐ ኦላ ባካ።<verse eid="PSA 44:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10"/>ኑ ሞርከቱዋ ስንፐ ኑና ባቃትሳዳ፤</para>
  <para style="q2" vid="PSA 44:10">ኑ ኤቀትያዋንቱ ኑባ ቦንቄድኖ።<verse eid="PSA 44:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11"/>ኔን ኑና ዶርሳቱዋዳን ሹካዉ አደ እማዳ፤</para>
  <para style="q2" vid="PSA 44:11">ቃይ ካዉተቱዋ ግዶን ኑና ላላዳ።<verse eid="PSA 44:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12"/>ኔን ነ አሳ ህራይሱዋን ዛልኣዳ፤</para>
  <para style="q2" vid="PSA 44:12">አያ ዎያነ ደማበይካ።<verse eid="PSA 44:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13"/>ኔን ኑና ኑ ሾሮቱ ቦርያዋ፥</para>
  <para style="q2" vid="PSA 44:13">ቃይ ኑ ሄራን ደእያዋንቱ ቅሊጭያዋነ ሚጭያዋ ኦዳ።<verse eid="PSA 44:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14"/>ኔን ኑና ካዉተቱዋ ግዶን ቶሳ ከሳዳ፤</para>
  <para style="q2" vid="PSA 44:14">ኑና ኡንቱንቱ ባረንቱ ሁጲያ ቃ ቃ ቅያዋ ኦዳ።<verse eid="PSA 44:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15"/>ታን ጋላሳ ኩመንን ቶሸታድ።</para>
  <para style="q2" vid="PSA 44:15">ታ ሶምእያ ዬላይ ካሜዳ።<verse eid="PSA 44:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16"/>ታና ሸቂያዋንቱነ ቦርያዋንቱ ጋሱዋን፥</para>
  <para style="q2" vid="PSA 44:16">ታና ሞርክያዋንቱነ ማንድያዋንቱ ጋሱዋና።<verse eid="PSA 44:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17"/>ኑን ኔና ዶግቤናዋ ግዶፐካ፥</para>
  <para style="q2" vid="PSA 44:17">ዎይ ነ ጫቁዋ መንቤናዋ ግዶፐካ፥</para>
  <para style="q1" vid="PSA 44:17">ሀዌ ኡባይ ኑ ቦላ ሀኔዳ።<verse eid="PSA 44:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18"/>ኑ ዎዛናይ ኔፐ ጉየ ስምቤና፤</para>
  <para style="q2" vid="PSA 44:18">ኑ ገዲ ነ ኦግያፐ ጋጻ ከስቤና።<verse eid="PSA 44:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19"/>ሽን ኔን ኑና መንሬደ ዶኣ ግዶን የጋዳ፤</para>
  <para style="q2" vid="PSA 44:19">ጵ ጎ ማን ካማዳ።<verse eid="PSA 44:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20"/>ኑ ጾሳ ሱን ኑን ዶጌደንቶ፥</para>
  <para style="q2" vid="PSA 44:20">ሀራ ጾሳ ዎሳናዉ ኑን ኑ ኩሽያ ምጬደንቶ፥<verse eid="PSA 44:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21"/>ዎዛናን ጌሜዳ ጹራ ጾሳይ ኤርያ ድራዉ፥</para>
  <para style="q2" vid="PSA 44:21">እ ሀዋ ብዲደ ደመኔ?<verse eid="PSA 44:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22"/>ሽን ነ ድራዉ፥ ጋላሳ ኡባን ኑና ዎኖ፤<note caller="-" style="x"><char style="xo" closed="false">44:22 </char><char style="xt" closed="false"><ref loc="ROM 8:36">ሮመ 8:36</ref></char></note></para>
  <para style="q2" vid="PSA 44:22">ሹካናዉ አፍያ ዶርሳዳን ፓይደቴዶ።<verse eid="PSA 44:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23"/>አቤት መና ጎዳዉ፥ ደንዳ! አያዉ ገምእሻይ?</para>
  <para style="q2" vid="PSA 44:23">ቤጎታ! መናዉ ኑና አጎፓ።<verse eid="PSA 44:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24"/>ነ ሶምኡዋ ኑፐ አያዉ ገንይ?</para>
  <para style="q2" vid="PSA 44:24">ኑ ቆሁዋነ ኑ ኡንኣ አያዉ ዶጋይ?<verse eid="PSA 44:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25"/>ኑን ባናን ዱገ ኦለቴዶ፤</para>
  <para style="q2" vid="PSA 44:25">ኑ አሳተይካ ቢታና ኦይቀቴዳ።<verse eid="PSA 44:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26"/>አቤት ጾሳዉ፥ ደንዳ! ኑና ማዳ!</para>
  <para style="q2" vid="PSA 44:26">አገና ነ ሲቁዋ ድራዉ፥ ኑና ዎዛ።<verse eid="PSA 44:26"/></para>
  <chapter eid="PSA 44"/>
  <chapter number="45" style="c" sid="PSA 45"/>
  <para style="s1">ሲቁዋ ግንጹዋ</para>
  <para style="d">ቆረ ናናቱ ዛማረቱዋ ካፖ ጪሻ ዋ ግያ ዋን የጼዳ የ. አኬካን ጻፈቴዳ ሲቁዋ የ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1"/>ታን ታ የ ካትያ ስሳና፥</para>
  <para style="q2" vid="PSA 45:1">ታ ዎዛናይ ሎኦ ቆፋ ፑልቴ፤</para>
  <para style="q3" vid="PSA 45:1">ታ እንጻርሳይ ሎኦ ጻፍያ አሳ ብእርያ ማላ።<verse eid="PSA 45:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2"/>አሳ ኡባፐ ኔን ማላንቻነ፤</para>
  <para style="q2" vid="PSA 45:2">ነ ሃሳያይ ናሸያዋ ግዳና ማላ፥</para>
  <para style="q1" vid="PSA 45:2">ጾሳይ ኔና መናዉ አንጄዳ።<verse eid="PSA 45:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3"/>ዎልቃማ ካትያዉ፥</para>
  <para style="q2" vid="PSA 45:3">ነ ማሻ ነ ጼሳን ዳንጫ፤</para>
  <para style="q2" vid="PSA 45:3">ቦንቹነ ግታተይ ነዋ።<verse eid="PSA 45:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4"/>ነ ቱማተ፥ አሽከተነ ጽሎተ ድራዉ፥</para>
  <para style="q2" vid="PSA 45:4">ነ አንጋ ማያደ፥ ጾናናዉ ፕሪጻ።</para>
  <para style="q1" vid="PSA 45:4">ነ ኡሸቻ ኩሺ ማላልስያባ በሶ።<verse eid="PSA 45:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5"/>ነ ፖይ ቃራ፤</para>
  <para style="q2" vid="PSA 45:5">ኡንቱንቱ ካትያ ሞርከቱዋ ዎዛና አይፍያ ጫድኖ።</para>
  <para style="q1" vid="PSA 45:5">ካዉተቱ ነ ገድያን ኩንድኖ።<verse eid="PSA 45:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6"/>አቤት ጾሳዉ፥</para>
  <para style="q2" vid="PSA 45:6">ነ ካዉተ አራታይ መ መናዉ ደኤ፤<note caller="-" style="x"><char style="xo" closed="false">45:6-7 </char><char style="xt" closed="false"><ref loc="HEB 1:8-9">እብራ. 1:8-9</ref></char></note></para>
  <para style="q2" vid="PSA 45:6">ነ ካዉተ ጻምአይካ ሱረተ ጻምኣ።<verse eid="PSA 45:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7"/>ኔን ጽሎተ ሲቃሳ፤</para>
  <para style="q2" vid="PSA 45:7">ጌላተ እጻ።</para>
  <para style="q1" vid="PSA 45:7">ጾሳይ፥ ነ ጾሳይ፥ ኔና</para>
  <para style="q2" vid="PSA 45:7">ነ ላገቱዋፐ አደ፥</para>
  <para style="q2" vid="PSA 45:7">ናሸቻ ዛይትያ ኦኬዳዌ ሄዋሳ።<verse eid="PSA 45:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8"/>ካዋራን፥ ጎዳረ ኡንነ ብርጉድያን፥</para>
  <para style="q2" vid="PSA 45:8">ነ ማዩ ኡባይ ፑሻከቴዳ።</para>
  <para style="q1" vid="PSA 45:8">ዳንጋርሳ ዛልያን አሌቀቴዳ፥</para>
  <para style="q2" vid="PSA 45:8">ነ ካዉተ ጎልያን ዲጽያዋንቱ ኔና ናሸቺኖ።<verse eid="PSA 45:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9"/>ካትያ ጎልያን ደእያ ማጫ አሳቱዋ ግዶን፥</para>
  <para style="q2" vid="PSA 45:9">ካተቱዋ ማጫ ናናቱ ደኢኖ፤</para>
  <para style="q2" vid="PSA 45:9">ካታታ ጌሻ ዎርቃን አሌቀታደ፥</para>
  <para style="q2" vid="PSA 45:9">ኔፐ ኡሸቻ ባጋን ኤቃዱ።<verse eid="PSA 45:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10"/>ታ ናቴ፥ ስሳ፤ ሀይዛ፤</para>
  <para style="q2" vid="PSA 45:10">ነ ሀይ ሃ የጋ።</para>
  <para style="q1" vid="PSA 45:10">ነ ዛርያነ ነ አዉዋ ጎልያ ዶጋ።<verse eid="PSA 45:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11"/>ነ ፑላ ካቲ አሞቴ፤</para>
  <para style="q2" vid="PSA 45:11">እ ነዉ ጎዳ ግድያ ድራዉ፥ አዉ አዛዘታ።<verse eid="PSA 45:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12"/>ጽሮሳ አሳይ እዝዉ እሞታ አኪደ ያና፤</para>
  <para style="q2" vid="PSA 45:12">ዱረቱ ኔና አዉዳሻና።<verse eid="PSA 45:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13"/>ካትያ ናታ ካትያ ጎልያ ግዶን ዋታ ሎአይ!</para>
  <para style="q2" vid="PSA 45:13">እዝ ቡላቻ ማዩካ ዎርቃ ቃጭናን ዳደቴዳ።<verse eid="PSA 45:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14"/>ባረ አሌቆ ማዩዋ ማያደ፥ ካትያኮ ሞይዘታዉ፤</para>
  <para style="q2" vid="PSA 45:14">እዝ ላገ ናናቱ ዎዶሮቱ፥</para>
  <para style="q2" vid="PSA 45:14">እዞ ካሊደ፥ አ ስን አሄድኖ።<verse eid="PSA 45:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15"/>ኡንቱንቱ ናሸቲደነ ሆምቦጪደ ዪደ፥</para>
  <para style="q2" vid="PSA 45:15">ካትያ ጎልያ ገሊኖ።<verse eid="PSA 45:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16"/>ካትያዉ፥ ነ አዎቱዋ ኮታ ነ ናናቱ አካና።</para>
  <para style="q2" vid="PSA 45:16">ኔን ኡንቱንታ ቢታ ኡባ ቦላን ሱንና።<verse eid="PSA 45:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17"/>ታን ነ ሱንይ የለታ ኡባን ሀሳየታናዳን ኦና።</para>
  <para style="q2" vid="PSA 45:17">ሄዋ ድራዉ፥ አሳይ መ መናዉ ኔና ጋላታና።<verse eid="PSA 45:17"/></para>
  <chapter eid="PSA 45"/>
  <chapter number="46" style="c" sid="PSA 46"/>
  <para style="s1">ጾሳይ ኑናና ደኤ</para>
  <para style="d">ዛማረቱዋ ካፖ ቆረ ናናቱ እምና የጸቴዳ፥ ዎዶሮ ናና የ ሂላን ጻፈቴዳ የ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1"/>ጾሳይ ኑን ናገት አትያ ሳነ ኑዉ ዎልቃ።</para>
  <para style="q2" vid="PSA 46:1">ኑና መቱ ጋክያ ዎደ፥</para>
  <para style="q3" vid="PSA 46:1">ማዳናዉ እ ኡባ ገደ ማታን ደኤ።<verse eid="PSA 46:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2"/>ሄዋ ድራዉ፥ ቢታይ ቃጽንቶካ፥</para>
  <para style="q2" vid="PSA 46:2">ዎይ ደረቱ አባን ኩንድንቶካ፥</para>
  <para style="q1" vid="PSA 46:2">ኑን ያዮኮ።<verse eid="PSA 46:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3"/>አባ ቤታይ ጉሚደ፥ ሆሙዋ ማይንንቶካ፥</para>
  <para style="q2" vid="PSA 46:3">አ ዎልቃማ ሆቢያን ደረቱ ዪቂዪቂንቶካ፥</para>
  <para style="q2" vid="PSA 46:3">ኑን ያዮኮ።<verse eid="PSA 46:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4"/>እት ሻፋይ ደኤ።</para>
  <para style="q2" vid="PSA 46:4">ሄ ሻፋይ ጎጊደ፥ ጾሳ ካታማ፥</para>
  <para style="q1" vid="PSA 46:4">ኡባፐ ቂያ ጾሳይ ደእያ ጌሻ ሳኣ ናሸቼ።<verse eid="PSA 46:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5"/>ጾሳይ አ ግዶን ደእያ ድራዉ፥</para>
  <para style="q2" vid="PSA 46:5">ሄ ካታማይ ቃጸና።</para>
  <para style="q1" vid="PSA 46:5">ዎንታ ጉራን ጾሳይ አ ማዳና።<verse eid="PSA 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6"/>ጋድያ አሳይ ሻባረቴ፤</para>
  <para style="q2" vid="PSA 46:6">ካዉተቱ ቃጺኖ።</para>
  <para style="q1" vid="PSA 46:6">ጾሳይ ባረ ቃላ ስሴዳ ዎደ፥ ሳአይ ሴሬ።<verse eid="PSA 46:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7"/>መተ ኡባ ጎዳይ ኑናና ደኤ፤</para>
  <para style="q2" vid="PSA 46:7">ያቆባ ጾሳይ ኑን ቆሰት አትያ ሳኣ።<verse eid="PSA 46:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8"/>ሃ ዪተ፤ መና ጎዳይ ኦሱዋ ጼልተ፤</para>
  <para style="q2" vid="PSA 46:8">እ ሳኣን አሄዳ ባሻ በእተ።<verse eid="PSA 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9"/>እ ሳኣ ጋጻ ጋካናዉ ደእያ ኦላ ተኤ፤</para>
  <para style="q2" vid="PSA 46:9">ዎንዳፍያ መን፤</para>
  <para style="q2" vid="PSA 46:9">ቶራ መን፤</para>
  <para style="q2" vid="PSA 46:9">ጎንዳልያካ ታማን ጹጌ።<verse eid="PSA 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10"/>ዎፑ ጊተ፤ ታን ጾሳ ግድያዋ ኤርተ።</para>
  <para style="q2" vid="PSA 46:10">ታን ካዉተቱዋ ግዶን ቃይ።</para>
  <para style="q1" vid="PSA 46:10">ቃይ ቢታ ቦላንካ ቃይ።<verse eid="PSA 46:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11"/>ኡባፐ ዎልቃማ መና ጎዳይ ኑናና ደኤ፤</para>
  <para style="q2" vid="PSA 46:11">ያቆባ ጾሳይ ኑን ቆሰት አትያ ሳኣ።<verse eid="PSA 46:11"/></para>
  <chapter eid="PSA 46"/>
  <chapter number="47" style="c" sid="PSA 47"/>
  <para style="s1">ጾሳይ አላምያ ኡባ ካትያ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ቆረ ናናቱዋ ማዝሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 47:1"/>ካዉተቱ ኡባይ ህንተ ኩሽያ ባቂተ፤</para>
  <para style="q2" vid="PSA 47:1">ቃላ ቁ ኦደ፥ ጾሳዉ ጋላታ የጽተ።<verse eid="PSA 47:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2"/>ኡባፐ ቂያ መና ጎዳይ ያየታናዉ በሴ፤</para>
  <para style="q2" vid="PSA 47:2">ሳኣ ኡባ ቦላን እ ዎልቃማ ካትያ።<verse eid="PSA 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3"/>ጋድያ አሳ ኑፐ ጋርሳና፥</para>
  <para style="q2" vid="PSA 47:3">ካዉተቱዋካ ኑ ገድያፐ ጋርሳና ዎደ፥</para>
  <para style="q1" vid="PSA 47:3">ኑዉ ሞድሴ።<verse eid="PSA 47:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4"/>እ ኑዉ ላትያ ቢታ ዶሬዳ፤</para>
  <para style="q2" vid="PSA 47:4">ሄ ቢታይ፥ እ ሲቅያ ያቆባ ዛራቱ ጬቀትያዋ።<verse eid="PSA 47:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5"/>ጾሳይ ፑደ ካዉተ አራታ ከሴዳ።</para>
  <para style="q2" vid="PSA 47:5">መና ጎዳይ ፑደ ከስያ ዎደ፥</para>
  <para style="q2" vid="PSA 47:5">ናሸቻ ሆምቦጨይነ ማላካታ ፑናይ ስሰቴዳ።<verse eid="PSA 47:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6"/>ጾሳ ሳቢተ፤ ኤ፥ አ ሳቢተ።</para>
  <para style="q2" vid="PSA 47:6">ኑ ካትያ ሳቢተ፤ ኤ፥ አ ሳቢተ።<verse eid="PSA 47:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7"/>ጾሳይ ሳኣ ኡባ ካትያ ግድያ ድራዉ፥</para>
  <para style="q2" vid="PSA 47:7">ጋላታ ሳባ ሳቢተ።<verse eid="PSA 47:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8"/>ጾሳይ ባረ ጌሻ ካዉተ አራታን ኡቴዳ፤</para>
  <para style="q2" vid="PSA 47:8">ጾሳይ ካዉተቱዋ ኡባ ሞዴ።<verse eid="PSA 47:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9"/>ካዉተቱዋ ካፓቱ፥</para>
  <para style="q2" vid="PSA 47:9">አብራሃማ ጾሳ አሳቱዋና እትፐ ሺቂኖ።</para>
  <para style="q1" vid="PSA 47:9">አያዉ ጎፐ፥ ሳኣን ደእያ ዎልቃማቱ ኡባይ ጾሳሳ፤</para>
  <para style="q2" vid="PSA 47:9">እ ሎይ ቁ ጌዳ።<verse eid="PSA 47:9"/></para>
  <chapter eid="PSA 47"/>
  <chapter number="48" style="c" sid="PSA 48"/>
  <para style="s1">ጾሳ ካታማት ጽዮኖ</para>
  <para style="d">ቆራሀ ናናቱዋ ማዛሙርያ፤ የ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1"/>መና ጎዳይ ዎልቃማ።</para>
  <para style="q2" vid="PSA 48:1">ኑ ጾሳ ካታማን አ ጌሻ ደርያን አ ጋላታይ አዉ በሴ።<verse eid="PSA 48:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2"/>ጾሳ ደርያ ጽዮነ ቃነ ሎአ።<note caller="-" style="x"><char style="xo" closed="false">48:2 </char><char style="xt" closed="false"><ref loc="MAT 5:35">ማቶሳ 5:35</ref></char></note></para>
  <para style="q2" vid="PSA 48:2">ፑደሃ ባጋና ደእያ</para>
  <para style="q1" vid="PSA 48:2">ሄ ዎልቃማ ካትያ ካታማይ ሳኣ ኡባዉ ናሸቻ።<verse eid="PSA 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3"/>ሄ ካታማ ግምቢያ ግዶን፥</para>
  <para style="q2" vid="PSA 48:3">ባረናን ሳሮ አሳይ ደእያዋ ጾሳይ በሴዳ።<verse eid="PSA 48:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4"/>ካተቱ ባረንቱ ቶራንቻቱዋና እትፐ ሺቄድኖ፤</para>
  <para style="q2" vid="PSA 48:4">ጽዮነ ኦላናዉ ዬድኖ።<verse eid="PSA 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5"/>አ በኢደ፥ ማላለቲድነ ዳጋሚደ፥</para>
  <para style="q2" vid="PSA 48:5">ባቃቴድኖ።<verse eid="PSA 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6"/>ኡንቱንቱ ሄዋን ደእሺና፥</para>
  <para style="q2" vid="PSA 48:6">ኡንቱንታ ያሻ ኮኮርሳይ ኦይቄዳ፤</para>
  <para style="q2" vid="PSA 48:6">ኦይይ ኦይቄዳ ምሽራቲዳን ኡንኤቴድኖ።<verse eid="PSA 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7"/>አዋይ ዶልያ ባጋ ዎልቃማ ጫርኩዋን፥</para>
  <para style="q2" vid="PSA 48:7">መእያ ታርሴሰ ማርካብያዳን ኡንቱንቱ ኮኮሬድኖ።<verse eid="PSA 48:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8"/>ኑን ስሴዳዋዳንካ፥</para>
  <para style="q2" vid="PSA 48:8">ኡባፐ ዎልቃማ መና ጎዳ ካታማን፥</para>
  <para style="q2" vid="PSA 48:8">ኑ ጾሳ ካታማን፥ እ ኦዳዋ በኤዶ።</para>
  <para style="q2" vid="PSA 48:8">ጾሳይ ሄ ካታማ መናዉ ምንስ ኤሴ።<verse eid="PSA 48:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9"/>አቤት ጾሳዉ፥ ነ ጌሻ ጎልያ ግዶን</para>
  <para style="q2" vid="PSA 48:9">አገና ነ ሲቁዋ ቆፔዶ።<verse eid="PSA 48:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10"/>አቤት ጾሳዉ፥ ነ ሱንዳንካ፥</para>
  <para style="q2" vid="PSA 48:10">ነ ጋላታይ ሳኣ ጋጻ ጋኬዳ።</para>
  <para style="q1" vid="PSA 48:10">ነ ኡሸቻ ኩሺ ጽሎተን ኩሜዳዋ።<verse eid="PSA 48:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11"/>ነ ፕርዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 48:11">ጽዮነ አሳይ ናሸቴ፤</para>
  <para style="q1" vid="PSA 48:11">ይሁዳ ሞቱካ ናሸቲኖ።<verse eid="PSA 48:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12"/>ጽዮነ ዩሹዋን ሀመትተ፤</para>
  <para style="q2" vid="PSA 48:12">እ ዩሹዋን ያነ ሃነ ስመረትተ።</para>
  <para style="q1" vid="PSA 48:12">እ ዎችያ ሳ ፓይድተ።<verse eid="PSA 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13"/>ይያ የለታዉ ኦዳናዳን፥</para>
  <para style="q2" vid="PSA 48:13">እዝ ግምቢያ አኬክተነ እዝ አኮ ግምቢያ ጾሞስተ።<verse eid="PSA 48:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14"/>ህንተ፥ “መ መናዉ</para>
  <para style="q2" vid="PSA 48:14">ሀ ጾሳይ ኑ ጾሳ፤</para>
  <para style="q1" vid="PSA 48:14">እ ኑና ሀይቃና ጋካናዉ ካለና” ያጊደ ኦድተ።<verse eid="PSA 48:14"/></para>
  <chapter eid="PSA 48"/>
  <chapter number="49" style="c" sid="PSA 49"/>
  <para style="s1">ዱረታን አማነቱሳይ ሀዳ ግዱሳ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ቆረ ናናቱዋ ማዝሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 49:1"/>ህንተኖ፥ አሳቶ፥ ኡባቱካ ሀዋ ስስተ።</para>
  <para style="q2" vid="PSA 49:1">ህንተኖ፥ ሳኣን ደእያዋንቶ፥</para>
  <para style="q3" vid="PSA 49:1">ኡባቱካ ሀዋ ሀይዝተ።<verse eid="PSA 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2"/>ቃይ ዝቃይካ፥</para>
  <para style="q2" vid="PSA 49:2">ዱሪ ማንቁካ ስስተ።<verse eid="PSA 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3"/>ታ ዎዛና ቆፋይ ጪማ፤</para>
  <para style="q2" vid="PSA 49:3">ታ ዶናይ አዳ ኤራተ ሃሳዬ።<verse eid="PSA 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4"/>ታ ሀይ ሌምሱዋኮ የጋና፤</para>
  <para style="q2" vid="PSA 49:4">ዲ ዲጻደ፥</para>
  <para style="q1" vid="PSA 49:4">ታን አ ብለ ቆንጭሳና።<verse eid="PSA 49:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5"/>መቶ ጋላሳይ ይያ ዎድያንነ ባለያ ሞርከቱ፥</para>
  <para style="q2" vid="PSA 49:5">ታና ዶድያ ዎደ፥</para>
  <para style="q1" vid="PSA 49:5">ታን አያዉ ያያይታ?<verse eid="PSA 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6"/>ታ ሞርከቶ፥</para>
  <para style="q2" vid="PSA 49:6">ባረንቱ ደእያዋን አማነትያዋንቶነ</para>
  <para style="q2" vid="PSA 49:6">ባረንቱ ዱረተ ዳሩዋን ጬቂያዋንቶ</para>
  <para style="q2" vid="PSA 49:6">አያዉ ያያይታ?<verse eid="PSA 49:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7"/>አይ አሳይነ ባረና ዎዛናዉ፥</para>
  <para style="q2" vid="PSA 49:7">ዎይ ባረ ሸምፑዋ ጋትያ ጾሳዉ ጭጋናዉ ዳንዳየና።<verse eid="PSA 49:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8"/>አያዉ ጎፐ፥ አሳ ሸምፑዋ ጋቲ አልአ።</para>
  <para style="q2" vid="PSA 49:8">አይ ጋትያ ጭግናካ ግደና።<verse eid="PSA 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9"/>እ መናዉ ደአናዳን፥</para>
  <para style="q2" vid="PSA 49:9">ዎይ እ ሀይቀናዳን ኦናዉ ጋከና።<verse eid="PSA 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10"/>ኤያቱነ ቦዛቱ ሀይቂያዋዳን፥</para>
  <para style="q2" vid="PSA 49:10">አዳ ኤራንቻቱካ ይያዋነ</para>
  <para style="q2" vid="PSA 49:10">ባረንቱ ማጹዋ ሀራቶ የጊደ ብያዋ</para>
  <para style="q2" vid="PSA 49:10">አሳይ ኡባይ በኤ።<verse eid="PSA 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11"/>ኡንቱንቱ ባረንቱ ቢታ ባረንቱዋ ጊናካ፥</para>
  <para style="q2" vid="PSA 49:11">ዱፉ መናዉ ኡንቱንቱ ጎለነ የለታፐ የለታ ጋካናዉ</para>
  <para style="q2" vid="PSA 49:11">ኡንቱንቱ ደእያ ሳኣ ግዳናዋ።<verse eid="PSA 49:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12"/>አሳይ አይ ግታቶፐካ ፓጻ አተና፤</para>
  <para style="q2" vid="PSA 49:12">እ ዶኣዳን ሀይቃና።<verse eid="PSA 49:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13"/>ባረካ ባረንቱ ሁጲያን አማነትያዋንቱ ካጫይነ</para>
  <para style="q2" vid="PSA 49:13">ኡንቱንቱ ቃላ ቱማ ግያዋንቱ ዉርሰይ ሀዋ።<verse eid="PSA 49:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14"/>ሹካዉ ዶረቴዳ ዶርሳቱዋዳን፥</para>
  <para style="q2" vid="PSA 49:14">ኡንቱንቱ ዱፎ ዶረቴድኖ፤</para>
  <para style="q1" vid="PSA 49:14">ሀይቁ ኡንቱንቱ ሄንንቻ ግዳናዋ።</para>
  <para style="q2" vid="PSA 49:14">ሱረቱ ዎንታ ኡንቱንቱ ዱፉዋ ቦላ ሀመታና፤</para>
  <para style="q2" vid="PSA 49:14">ኡንቱንቱ ባረንቱ ደእያ ጎልያፐ ሃኪደ፥ ዱፉዋን ዎቃና።<verse eid="PSA 49:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15"/>ሽን ጾሳይ ታና ዎዛና፤</para>
  <para style="q2" vid="PSA 49:15">እ ታ ሸምፑዋ ሀይቁዋ ዎልቃፐ አሻና።<verse eid="PSA 49:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16"/>አሳይ ዱረትያ ዎደነ፥</para>
  <para style="q2" vid="PSA 49:16">አ ቦንቹ ዳርያ ዎደ ያዮፓ።<verse eid="PSA 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17"/>አያዉ ጎፐ፥ እ ሀይቂደ፥</para>
  <para style="q2" vid="PSA 49:17">አይነ አኪደ ቤና፤</para>
  <para style="q1" vid="PSA 49:17">አ ዱረታይ አናና እትፐ ዱፉዋ ቤና።<verse eid="PSA 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18"/>አሳይ ፓጻ ደእያ ዎድያን፥</para>
  <para style="q2" vid="PSA 49:18">“ታዉ ኩሜዳ” ጎፐነ፥</para>
  <para style="q2" vid="PSA 49:18">ኡባባይ አዉ ጊጌዳ ድራዉ ጋላተቶፐነ፥<verse eid="PSA 49:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 49:19"/>ስሚደ ፖኡዋ በኤና ባረ ማይዛ አዎቱዋና ጋከቴ።<verse eid="PSA 49:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20"/>ኤር ባይናን ግታቴዳ አሳይ ዶኣዳን ሀይቃና።<verse eid="PSA 49:20"/></para>
  <chapter eid="PSA 49"/>
  <chapter number="50" style="c" sid="PSA 50"/>
  <para style="s1">ቱሞ ጎይና</para>
  <para style="d">አሳፋ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1"/>ዎልቃማ ጾሳይ፥ መና ጎዳይ ሃሳዬ።</para>
  <para style="q2" vid="PSA 50:1">አዋይ ዶልያሳፐ ዉልያሳ ጋካናዉ</para>
  <para style="q3" vid="PSA 50:1">ሳኣን ደእያ አሳ ጼሴ።<verse eid="PSA 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2"/>ፑላይ ኩመን ሎአ ግድያ ጽዮነፐ ጾሳይ ፖኤ።<verse eid="PSA 50:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3"/>ኑ ጾሳይ ያና፤ ጮኡ ጌና።</para>
  <para style="q2" vid="PSA 50:3">ኤጽያ ታማይ አ ስንና፤</para>
  <para style="q2" vid="PSA 50:3">ዎልቃማ ጎቲ አ ዩሹዋና።<verse eid="PSA 50:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4"/>ጾሳይ ባረ አሳ ፕርዲደ፥</para>
  <para style="q2" vid="PSA 50:4">ሳሎቱዋነ ሳኣ ጼሴ።<verse eid="PSA 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5"/>“ያርሹዋ ያርሽያዋን፥</para>
  <para style="q2" vid="PSA 50:5">ታናና ጫቀቴዳ ጾሳ አሳቱዋ፥</para>
  <para style="q2" vid="PSA 50:5">ታኮ ሺሽተ” ያጌዳ።<verse eid="PSA 50:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6"/>ጾሳይ ፕርድያዋ ግድያ ድራዉ፥</para>
  <para style="q2" vid="PSA 50:6">ሳሎቱ አ ጽሎተ ኦዲኖ።<verse eid="PSA 50:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7"/>“ታ አሳዉ፥ ስሳ! ታን ነዉ ኦዳይ።</para>
  <para style="q2" vid="PSA 50:7">እስራኤልያ አሳዉ፥ ታን ነ ቦላ ማርካታይ።</para>
  <para style="q1" vid="PSA 50:7">ታን ጾሳ፥ ነ ጾሳ።<verse eid="PSA 50:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8"/>ነ ያርሹዋ ድራዉነ</para>
  <para style="q2" vid="PSA 50:8">ኔን ኡባ ገደ ሺሽያ ጹግያ ያርሹዋ ድራዉ፥</para>
  <para style="q1" vid="PSA 50:8">ታን ኔና ሴርከ።<verse eid="PSA 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9"/>ሄዋዳንካ፥ ነ ድርሳፐ ኮሩማቱዋ፥</para>
  <para style="q2" vid="PSA 50:9">ዎይ ነ ስኩዋፐ ዴሻቱዋ አካናዉ ኮይከ።<verse eid="PSA 50:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10"/>አያዉ ጎፐ፥ ዎራን ደእያ ዶአቱ ኡባቱ ታዋንታ፤</para>
  <para style="q2" vid="PSA 50:10">ሻኡ ደርያ ቦላን ደእያ መሄቱካ ታዋንታ።<verse eid="PSA 50:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11"/>ታን ቃ ደርያን ደእያ ካፎቱዋ ኡባ ኤራይ፤</para>
  <para style="q2" vid="PSA 50:11">ደምባን ደእያ መተቱ ታዋንታ።<verse eid="PSA 50:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12"/>ታና ኮሽንቶነ፥ ታን ነዉ ኦድከ:</para>
  <para style="q2" vid="PSA 50:12">አያዉ ጎፐ፥ ሳአይነ ሳኣን ኩሜዳዌ ኡባይ ታዋ።<verse eid="PSA 50:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13"/>ታን ኮሩማቱዋ አሹዋ ማይታ?</para>
  <para style="q2" vid="PSA 50:13">ዎይ ዴሻቱዋ ሱ ኡሻይታ?<verse eid="PSA 50:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14"/>ሄዋ ድራዉ፥ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 50:14">ኔን እምያ ያርሹ ጋላታ ግዶ፤</para>
  <para style="q1" vid="PSA 50:14">ኡባፐ ቂያ ጾሳዉ ነ ቃንገ ጋ።<verse eid="PSA 50:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15"/>ያታደ፥ መቱዋ ጋላስ ታና ጼሳ።</para>
  <para style="q2" vid="PSA 50:15">ታን ኔና አሻና፤ ኔንካ ታና ቦንቻና” ያጌ።<verse eid="PSA 50:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 50:16"/>ሽን ጾሳይ ኢታ አሳ ሀዋዳን ያጌ፤</para>
  <para style="q2" vid="PSA 50:16">ታ ህግያ ኔን ዛራ ዛራደ አያዉ ኦዳይ?</para>
  <para style="q1" vid="PSA 50:16">ዎይ ታ ጫቁዋ ነ ዶናን አያዉ ሃሳያይ?<verse eid="PSA 50:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17"/>ኔን ታ ትምርትያ እጻዳ፤</para>
  <para style="q2" vid="PSA 50:17">ታ ቃላካ ሀይ ቦላና አዳ።<verse eid="PSA 50:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18"/>ኔን ካይሱዋ በኤዳ ዎደ፥</para>
  <para style="q2" vid="PSA 50:18">አናና ዳቦታዳ፤</para>
  <para style="q1" vid="PSA 50:18">ሻርሙጽያዋንቱ ማባራን ገላዳ።<verse eid="PSA 50:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19"/>ኔን ነ ዶና ኢታባ ሃሳያናዉ ብላ የዳሳ።</para>
  <para style="q2" vid="PSA 50:19">ነ እንጻርሳይካ ዎርዱዋ ሃሳያ ሜዘቴዳ።<verse eid="PSA 50:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20"/>ነ ኡቴዳሳን ነ እሻ ኢሳደ ሃሳያዳ፤</para>
  <para style="q2" vid="PSA 50:20">ነ አት ናኣ ዝግራሳ።<verse eid="PSA 50:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21"/>ኔን ሀዋ ኡባ ኦያ ዎደ፥</para>
  <para style="q2" vid="PSA 50:21">ታን ጮኡ ጌዳ ድራዉ፥</para>
  <para style="q1" vid="PSA 50:21">ታናካ ነ ማላ ጋደ ቆፓዳ።</para>
  <para style="q2" vid="PSA 50:21">ሽን ሀእ ታን ኔና ሴራይነ</para>
  <para style="q2" vid="PSA 50:21">ነ ባላ ነ ስንን ፓይዳይ።<verse eid="PSA 50:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22"/>“ህንተኖ፥ ጾሳ ዶግያዋንቶ፥ ሀዋ አኬክተ።</para>
  <para style="q2" vid="PSA 50:22">ሄዌ ዮፐ፥ ታን ህንተና መንሬና፤</para>
  <para style="q2" vid="PSA 50:22">ሄ ዎደ ህንተና አሽያዌ ባዋ።<verse eid="PSA 50:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23"/>ታዉ ጋላታ እምያ አሳይ ታና ቦንቼ።</para>
  <para style="q2" vid="PSA 50:23">ባረ ኦግያ ሱርስያ አሳ</para>
  <para style="q2" vid="PSA 50:23">ታን ጾሳ አቶተ በሳና” ያጌ።<note caller="-" style="x"><char style="xo" closed="false">50:23 </char><char style="xt" closed="false"><ref loc="2SA 12:1-15">2 ሳሜላ 12:1-15</ref></char></note><verse eid="PSA 50:23"/></para>
  <chapter eid="PSA 50"/>
  <chapter number="51" style="c" sid="PSA 51"/>
  <para style="s1">ማሮተ ደማናዉ ሺቄዳ ዎሳ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ በርሳብና ሻርሙጼዳ ሀኖታ ትምቢትያ ኦድያ ናታን አዉ ኦዲደ ስምና፥ ዳዊታ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1"/>አቤት ጾሳዉ፥ አገና ነ ሲቁዋዳን ታና ማራ፤</para>
  <para style="q2" vid="PSA 51:1">ነ ቃረታ ዳሩዋዳን ታ ባይዙዋ ቁጫ።<verse eid="PSA 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2"/>ታ ኢታተፐ ታና ሙለ ሜጫ፤</para>
  <para style="q2" vid="PSA 51:2">ታ ናጋራፐ ታና ጌሻ።<verse eid="PSA 51:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3"/>አያዉ ጎፐ፥ ታ ባይዙዋ ታን ኤራይ፤</para>
  <para style="q2" vid="PSA 51:3">ታ ናጋራይ ኡባ ገደ ታ ስንና።<verse eid="PSA 51:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4"/>ታን ኔና፥ ነ ጻላላ ናቃድ፤<note caller="-" style="x"><char style="xo" closed="false">51:4 </char><char style="xt" closed="false"><ref loc="ROM 3:4">ሮመ 3:4</ref></char></note></para>
  <para style="q2" vid="PSA 51:4">ነ አይፍያ ስንን ኢታባ ኦድ።</para>
  <para style="q1" vid="PSA 51:4">ሄዋ ድራዉ፥ ሃሳያደካ ኔን ልከ፤</para>
  <para style="q2" vid="PSA 51:4">ፕርዳደካ ኔን ጽሉዋ።<verse eid="PSA 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5"/>ታን የለቶደፐካ ቱሙ ናጋራንቻ፤</para>
  <para style="q2" vid="PSA 51:5">ታ አት ኡሉዋን ብሮ አትያ ዎደፐ ዶማደካ፥</para>
  <para style="q2" vid="PSA 51:5">ታን ናጋራንቻ።<verse eid="PSA 51:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6"/>ሄኮ ኔን ዎዛና ግዶ ቱማተ ኮያሳ፤</para>
  <para style="q2" vid="PSA 51:6">ሄዋ ድራዉ፥ ነ አዳ ኤራተ ታ ጋርሳን ታማርሳ።<verse eid="PSA 51:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7"/>ሂሶጵያ ግያ ቦንጭያን ኔን ታና ጌሻ፤</para>
  <para style="q2" vid="PSA 51:7">ታን ጌያና።</para>
  <para style="q1" vid="PSA 51:7">ታና ሜጫ፤</para>
  <para style="q2" vid="PSA 51:7">ታን ሻቻፐ አአደ ቦጻና።<verse eid="PSA 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8"/>ኔን ታና ናሸቻነ</para>
  <para style="q2" vid="PSA 51:8">ሀሹ ግያዋ ስሳ፤</para>
  <para style="q2" vid="PSA 51:8">ኔን ታና መንሬዳባ ግዶፐካ፥</para>
  <para style="q2" vid="PSA 51:8">ዛራደ ናሸቻ።<verse eid="PSA 51:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9"/>ታ ናጋራፐ ነ ስን ዎራ ዛራ፤</para>
  <para style="q2" vid="PSA 51:9">ታ ኢታተ ኡባ ቁጫ።<verse eid="PSA 51:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10"/>አቤት ጾሳዉ፥ ጌሻ ዎዛና ታ ግዶን መ፤</para>
  <para style="q2" vid="PSA 51:10">ምንስያ አያና ታ ግዶን ኦራ።<verse eid="PSA 51:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11"/>ታና ነ ስንፐ ኦሎፓ፤</para>
  <para style="q2" vid="PSA 51:11">ነ ጌሻ አያና ታፐ አኮፓ።<verse eid="PSA 51:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12"/>ነ አቶተ ናሸቻ ታዉ ዛራደ እማ፤</para>
  <para style="q2" vid="PSA 51:12">ታን ነዉ ኤኖ ጋደ አዛዘታናዳን፥</para>
  <para style="q2" vid="PSA 51:12">ታና ዘምፕሳ።<verse eid="PSA 51:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13"/>ሄ ዎደ ታን ባይዛንቻቱዋ ነ ኦግያ ታማርሳና፤</para>
  <para style="q2" vid="PSA 51:13">ሄ ናጋራንቻቱነ ኔኮ ስማና።<verse eid="PSA 51:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14"/>አቤት ጾሳዉ፥ ታና አሽያ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 51:14">ሱ ጉሴዳ ናጋራፐ ታና አሻ፤</para>
  <para style="q1" vid="PSA 51:14">ሄ ዎደ ታ እንጻርሳይ ነ ጽሎተባ የጻና።<verse eid="PSA 51:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15"/>አቤት ጎዳዉ፥ ታ ዶና ዶያ፤</para>
  <para style="q2" vid="PSA 51:15">ያቶፐ፥ ታ እንጻርሳይ ነ ጋላታ አዋያና።<verse eid="PSA 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16"/>ኔን ያርሹዋን ናሸታንቶ ታ ነዉ ሺሻናሽን፥</para>
  <para style="q2" vid="PSA 51:16">ኔን ያርሹዋን ናሸታካ።<verse eid="PSA 51:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17"/>ጾሳዉ ያርሽያ ያርሹ</para>
  <para style="q2" vid="PSA 51:17">አሽከ አያና፤ አቤት ጾሳዉ፥</para>
  <para style="q1" vid="PSA 51:17">“ናጋራ ኦናን አጋርክታሻ” ግያ፥</para>
  <para style="q2" vid="PSA 51:17">መኤዳ ዎዛና ኔን ካካ።<verse eid="PSA 51:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18"/>አቤት ጾሳዉ፥ ነ ዶሱዋን ጽዮንዉ ኬካ፤</para>
  <para style="q2" vid="PSA 51:18">የሩሳላመ ግምበቱዋ ግምባ።<verse eid="PSA 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19"/>ሄ ዎደ ጽሎ ያርሹዋን፥</para>
  <para style="q2" vid="PSA 51:19">ጹግያ ያርሹዋንነ፥</para>
  <para style="q2" vid="PSA 51:19">መህያ አሹዋ ዉርስ ጹግያ ያርሹዋን ኔን ናሸታና።</para>
  <para style="q2" vid="PSA 51:19">ቃይ ኮሩማቱ ነ ያርሽያሳን ያርሸታና።<note caller="-" style="x"><char style="xo" closed="false">51:19 </char><char style="xt" closed="false"><ref loc="1SA 22:9-10">1 ሳሜላ 22:9-10</ref></char></note><verse eid="PSA 51:19"/></para>
  <chapter eid="PSA 51"/>
  <chapter number="52" style="c" sid="PSA 52"/>
  <para style="s1">ኢታቱዋ ዉርሰ ካጫ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ኤዶማ ቢታ አሳ ግድያ ዶይቅ ሳኦላኮ ቢደ፥ “ዳዊተ አብመሌካ ጎለ ቤዳ” ያጊደ ኦዲደ ስምና ዳዊታ አኬካ ግንጹዋ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 52:1"/>ኔኖ፥ ዎልቃማ ብታንያዉ፥</para>
  <para style="q2" vid="PSA 52:1">ጾሳ አሳቱዋ ቦላ ኢታባ ኦያዋዳን፥</para>
  <para style="q3" vid="PSA 52:1">ጋላሳ ኡባን አያዉ ጬቀታይ?<verse eid="PSA 52:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2"/>ኔኖ፥ ዎርዶባ ሀንያዎ፥</para>
  <para style="q2" vid="PSA 52:2">ኔን ሀራቱዋ ይሳናዉ ማቀታሳ።</para>
  <para style="q1" vid="PSA 52:2">ነ እንጻርሳይ ኩሳ ማቂልያ ማላ።<verse eid="PSA 52:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3"/>ኔን ሎኡዋፐ ኢታ ሲቃሳ፤</para>
  <para style="q2" vid="PSA 52:3">ቃይ ቱሙዋ ሃሳይያዋፐ፥</para>
  <para style="q2" vid="PSA 52:3">ዎርዱዋ ሃሳይያዋ ዶሳሳ።<verse eid="PSA 52:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4"/>ኔኖ፥ ዎርዳንቻዉ፥</para>
  <para style="q2" vid="PSA 52:4">ኔን ቆህያ ቃላ ኡባ ሲቃሳ።<verse eid="PSA 52:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5"/>ሽን ጾሳይ ኔና መናዉ ይሳና።</para>
  <para style="q2" vid="PSA 52:5">እ ኔና ዳፋናነ ነ ጎልያፐ ቦንቂደ ከሳና፤</para>
  <para style="q1" vid="PSA 52:5">እ ኔና ፓጻ ደእያዋንቱ ግዶፐ ቆላና።<verse eid="PSA 52:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6"/>ጽሎቱ ሀዋ በኢደ ያያና።</para>
  <para style="q2" vid="PSA 52:6">ኡንቱንቱ ሀዋዳን ያጊደ፥ ነ ቦላ ሚጫና፤<verse eid="PSA 52:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7"/>“ጾሳ ባረዉ ጌሱዋ ኦቤና፥</para>
  <para style="q2" vid="PSA 52:7">ባረ ዱረተ ዳሩዋን አማነቴዳ፥</para>
  <para style="q1" vid="PSA 52:7">ኢታ ኦሱዋን ምኔዳ ብታንያ</para>
  <para style="q2" vid="PSA 52:7">ሀዋ በእተ!” ያጋና።<verse eid="PSA 52:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8"/>ሽን ታን ጾሳ ጎልያን አጭያ ዎጋራ ማላ።</para>
  <para style="q2" vid="PSA 52:8">አገና አ ሲቁዋን ታን መ መናዉ አማነታይ።<verse eid="PSA 52:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9"/>ኔን ኦዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 52:9">ታ ኔና ጋላታና፥</para>
  <para style="q2" vid="PSA 52:9">ታን ኔን ኬካ ግድያ ድራዉ ነ ሱንን ህዶታ ዎይ።</para>
  <para style="q2" vid="PSA 52:9">ታን ጾሳ አሳቱዋ ስንን ኔና ሳባና።<verse eid="PSA 52:9"/></para>
  <chapter eid="PSA 52"/>
  <chapter number="53" style="c" sid="PSA 53"/>
  <para style="s1">አሳ ኢታተ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ዳዊታ አኬካ ግንጹዋ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 53:1"/>ቦዛቱ ባረንቱ ዎዛናን፥<note caller="-" style="x"><char style="xo" closed="false">53:1-3 </char><char style="xt" closed="false"><ref loc="ROM 3:10-12">ሮመ 3:10-12</ref></char></note></para>
  <para style="q2" vid="PSA 53:1">“ጾሳይ ባዋ” ያጊኖ።</para>
  <para style="q3" vid="PSA 53:1">ኡንቱንቱ ደኡ ባዬዳ።</para>
  <para style="q3" vid="PSA 53:1">ኡንቱንቱ ሸነይያባ ኦኖ፤</para>
  <para style="q3" vid="PSA 53:1">ሎእያባ ኦያ አሳይ ባዋ።<verse eid="PSA 53:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2"/>ጾሳ ኮይያ ኤራንቻቱ ደእንቶነ በአናዉ፥</para>
  <para style="q2" vid="PSA 53:2">ጾሳይ ሳሉዋፐ ዱገ አሳ ጼሌ።<verse eid="PSA 53:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3"/>ኡንቱንቱ ኡባይካ ጾሳፐ ሃኬድኖ፤</para>
  <para style="q2" vid="PSA 53:3">ኡባይካ እትፐ ቱኔድኖ።</para>
  <para style="q1" vid="PSA 53:3">ሎኡዋ ኦያ አሳይ ባዋ፤</para>
  <para style="q2" vid="PSA 53:3">ሀራይ አቶ እቱነ ባዋ።<verse eid="PSA 53:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4"/>ጾሳይ፥ “ሀዋንቱ ታ አሳ ቦንቂ ምያ ኢታ አሳቱ</para>
  <para style="q2" vid="PSA 53:4">ቱሙ አይነ ኤርክኖ?</para>
  <para style="q1" vid="PSA 53:4">ኡንቱንቱ ታና ዎስክኖ” ያጌ።<verse eid="PSA 53:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5"/>ኡንቱንቱ ካሰ ዳጋም ኤረናዋ ኬሻ ዳጋማና።</para>
  <para style="q2" vid="PSA 53:5">አያዉ ጎፐ፥ ጾሳይ ባረ አሳ ሞርክያዋንቱ መቀ ላላና።</para>
  <para style="q1" vid="PSA 53:5">ጾሳይ ኡንቱንታ ካዳ ድራዉ፥ ኡንቱንቱ ዬላታና።<verse eid="PSA 53:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6"/>እስራኤልያዉ አቶተይ ጽዮነፐ ዬረኔ!</para>
  <para style="q2" vid="PSA 53:6">ጾሳይ ባረ አሳ ኦሞዱዋ ዛርያ ዎደ፥</para>
  <para style="q1" vid="PSA 53:6">ያቆባ ዛራቱ ናሸታና፤</para>
  <para style="q2" vid="PSA 53:6">እስራኤልያ አሳይ ናሸቻዉ ፖጩ ጋና።<verse eid="PSA 53:6"/></para>
  <chapter eid="PSA 53"/>
  <chapter number="54" style="c" sid="PSA 54"/>
  <para style="s1">ሞርክያ ኩሽያፐ አታናዉ ሺቄዳ ዎሳ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ዚፋን ደእያ አሳቱ ሳኦላኮ ቢደ፥ “ዳውት ኑ ቢታን ቆሰቴዳ” ያጊደ ኦዲደ ስምና ዳዊተ አኬካን ዲጼዳ ግንጹዋ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1"/>አቤት ጾሳዉ፥ ነ ሱንን ታና አሻ፤</para>
  <para style="q2" vid="PSA 54:1">ነ ዎልቃን ታና ሻትን።<verse eid="PSA 54:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2"/>አቤት ጾሳዉ፥ ታ ዎሳ ስሳ፤</para>
  <para style="q2" vid="PSA 54:2">ታ ዶና ሃሳያ ሀይዛ።<verse eid="PSA 54:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3"/>ኦቶራንቻቱ ታ ቦላ ደንዲኖ፤</para>
  <para style="q2" vid="PSA 54:3">ዳጋንያ አሳቱ ታና ዎናዉ ኮዪኖ።</para>
  <para style="q1" vid="PSA 54:3">ኡንቱንቱ ጾሳ አላለ ጊክኖ።<verse eid="PSA 54:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4"/>ሄኮ ጾሳይ ታና ማድያዋ፤</para>
  <para style="q2" vid="PSA 54:4">ጎዳይ ታና ዘምፕስያዋ።<verse eid="PSA 54:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5"/>አቤት ጾሳዉ፥ ታ ሞርከቶ ኡንቱንቱ ኢታተ ዛራ።</para>
  <para style="q2" vid="PSA 54:5">ኔን አማነትያዋ ግድያዋዳን፥</para>
  <para style="q2" vid="PSA 54:5">ኡንቱንታ ይሳ።<verse eid="PSA 54:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6"/>አቤት መና ጎዳዉ፥ ታን ታ ሸንያን ነዉ ያርሻና፤</para>
  <para style="q2" vid="PSA 54:6">ኔን ኬካ ግድያ ድራዉ፥</para>
  <para style="q1" vid="PSA 54:6">ታን ነ ሱን ጋላታና።<verse eid="PSA 54:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7"/>አያዉ ጎፐ፥ ኔን ታና</para>
  <para style="q2" vid="PSA 54:7">ታ መቱዋ ኡባፐ አሻዳ፤</para>
  <para style="q1" vid="PSA 54:7">ታ ሞርከቱ ጾነትያዋ ታ አይፍያን በኣድ።<verse eid="PSA 54:7"/></para>
  <chapter eid="PSA 54"/>
  <chapter number="55" style="c" sid="PSA 55"/>
  <para style="s1">ላገይ ካዴዳ አሳ ዎሳ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ዳዊተ አኬካን ዲጼዳ ዲ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 55:1"/>አቤት ጾሳዉ፥ ታ ዎሳ ስሳ፤</para>
  <para style="q2" vid="PSA 55:1">ታ ማጋና አይ መቴ ጎፓ።<verse eid="PSA 55:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 55:2"/>ሀይዛ፤ ታ ዎሳ ስሳ፤</para>
  <para style="q2" vid="PSA 55:2">ታ ቆፋይ ታና ዋይስና፥</para>
  <para style="q2" vid="PSA 55:2">ታን ሻባረታድ።<verse eid="PSA 55:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 55:3"/>ሄዌነ፥ ታ ሞርከቱዋ ኮሻፐነ፥</para>
  <para style="q2" vid="PSA 55:3">ኢታቱዋ ናቁዋፐ ደንዴዳዋና።</para>
  <para style="q1" vid="PSA 55:3">ኡንቱንቱ ታ ቦላ መቱዋ አሂኖነ</para>
  <para style="q2" vid="PSA 55:3">ባረንቱ ሀንቁዋን ታና ሞርኪኖ።<verse eid="PSA 55:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4"/>ታ ዎዛና አይፍያን ድድቄ፤</para>
  <para style="q2" vid="PSA 55:4">ሀይቁዋ ህርጋይ ታና ማሽሴዳ።<verse eid="PSA 55:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5"/>ታና ያሻይነ ኮኮርሳይ ኦይቄዳ፤</para>
  <para style="q2" vid="PSA 55:5">ዳጋማይ ታና ዎ ድጌዳ።<verse eid="PSA 55:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6"/>ታን፥ “ታዉ ሀራጵያዳን ቀፊ ደኤረኔሻ።</para>
  <para style="q2" vid="PSA 55:6">ያንንቶ ታን ፓላ ባደ ሸምፓና ሽን፤<verse eid="PSA 55:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7"/>ታን ሃካደ ባና ሽን፤</para>
  <para style="q2" vid="PSA 55:7">ባዙዋን ደአና ሽን።<verse eid="PSA 55:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8"/>ታን ጎትያፐነ ኡሹዋፐ፥</para>
  <para style="q2" vid="PSA 55:8">አትያሳ ኤሌላደ ጋካና ሽን” ያጋድ።<verse eid="PSA 55:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9"/>አቤት ጾሳዉ፥ ታን ካታማ ግዶን</para>
  <para style="q2" vid="PSA 55:9">ዋላሳነ ዋታ በኤዳ ድራዉ፥</para>
  <para style="q1" vid="PSA 55:9">ኢታቱዋ ሃሳያ ቡሉቃ።<verse eid="PSA 55:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10"/>ኢታቱ ጋላስነ ቃማ፥</para>
  <para style="q2" vid="PSA 55:10">ግምቢያ ዩዪኖ፤</para>
  <para style="q1" vid="PSA 55:10">ኢታተይነ ኮባይ ካታማ ግዶን ደኤ።<verse eid="PSA 55:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11"/>ባሻይ አ ግዶን ደኤ፤</para>
  <para style="q2" vid="PSA 55:11">ናቁካ ጭሙካ አ ጉታራፐ ሻከተና።<verse eid="PSA 55:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12"/>ታና ቦርያዌ ታ ሞርክያ ግደና፤</para>
  <para style="q2" vid="PSA 55:12">ግድንቶ ታን ዳንዳያና።</para>
  <para style="q1" vid="PSA 55:12">ታ ቦላ ጬቀትያዌ ታና እጽያዋ ግደና፤</para>
  <para style="q2" vid="PSA 55:12">ግድንቶ ታን አፐ ቆሰታና።<verse eid="PSA 55:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13"/>ሽን ሀዋ ኡባ ኦያዌ አሳ፥</para>
  <para style="q2" vid="PSA 55:13">ታ ላግያ፥</para>
  <para style="q1" vid="PSA 55:13">ታ ዳቡዋነ ታ ሲቁዋ።<verse eid="PSA 55:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14"/>ኑን እቱ እቱዋና ኡሎባ ሃሳዬዶ፤</para>
  <para style="q2" vid="PSA 55:14">ኑን ጾሳ ጎልያን አሳና እትፐ ስመረቴዶ።<verse eid="PSA 55:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15"/>ታ ሞርከቱ ዎዲ ጋከናን ሀይቂኖ፤</para>
  <para style="q2" vid="PSA 55:15">ኡንቱንቱ ፓጻ ሞገትኖ።</para>
  <para style="q1" vid="PSA 55:15">አያዉ ጎፐ፥ ኢታተይ</para>
  <para style="q2" vid="PSA 55:15">ኡንቱንቱ ግዶንነ ኡንቱንቱ ደእያ ሳን ደኤ።<verse eid="PSA 55:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16"/>ሽን ታን ጾሳ ጼሳይ፤</para>
  <para style="q2" vid="PSA 55:16">መና ጎዳይ ታና አሼ።<verse eid="PSA 55:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17"/>ዎንታ፥ ጋላስነ ኦማርስ</para>
  <para style="q2" vid="PSA 55:17">ታን ዋሳናነ ታ መቱዋ አዉ ኦዳና፤</para>
  <para style="q1" vid="PSA 55:17">እ ታና ስሳና።<verse eid="PSA 55:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18"/>ዳሮቱ ታና ሞርኮፐካ፥</para>
  <para style="q2" vid="PSA 55:18">እ ታና ኦላ ቶራፐ አሼ።<verse eid="PSA 55:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19"/>በንፐ ካዉተ አራታን ኡቴዳ ጾሳይ፥</para>
  <para style="q2" vid="PSA 55:19">ታ ዎሳ ስሲደ ባረንቱ ኦግያ ላመናዋንታነ</para>
  <para style="q2" vid="PSA 55:19">ባረዉ ያየናዋንታ፥</para>
  <para style="q2" vid="PSA 55:19">እ ካዉሻና።<verse eid="PSA 55:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20"/>ታ ላጊ ባረ ዳቦቱዋ ቆሀናዉ፥</para>
  <para style="q2" vid="PSA 55:20">ባረ ኩሽያ ደንዳ፤</para>
  <para style="q2" vid="PSA 55:20">ኡንቱንቱና ጫቀቴዳ ጫቁዋ ኮሌዳ።<verse eid="PSA 55:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21"/>አ ሃሳያይ ኦይሳፐካ አዳ ሹጋ፤</para>
  <para style="q2" vid="PSA 55:21">ሽን ባረ ዎዛናን ሞርኬዳ።</para>
  <para style="q1" vid="PSA 55:21">አ ቃላቱ ዛይትያፐካ አደ ዎሎላቲኖ፤</para>
  <para style="q2" vid="PSA 55:21">ሽን ኩሳ ማሻዳን ቃንጼድኖ።<verse eid="PSA 55:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22"/>ነ ቶኩዋ መና ጎዳን ዎ፤</para>
  <para style="q2" vid="PSA 55:22">እ ኔና ዘምፕሳና።</para>
  <para style="q1" vid="PSA 55:22">ጾሳይ አዉደነ ጽሎቱ</para>
  <para style="q2" vid="PSA 55:22">ሻባረታናዳን ኦና።<verse eid="PSA 55:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23"/>ሽን አቤት ጾሳዉ፥ ኔን</para>
  <para style="q2" vid="PSA 55:23">ኢታ አሳቱዋ ጪሞ ኦላን ዱገ ኦላና።</para>
  <para style="q1" vid="PSA 55:23">ሱ ጉስያዋንቱነ ጭምያዋንቱ፥</para>
  <para style="q2" vid="PSA 55:23">ባረንቱ ደአና ላይዉ ባጋነ ደእክኖ፤</para>
  <para style="q1" vid="PSA 55:23">ሽን ታን ኔናን አማነታና።<note caller="-" style="x"><char style="xo" closed="false">55:23</char><char style="xt" closed="false"><ref loc="1SA 21:13-15">1 ሳሜላ 21:13-15</ref></char></note><verse eid="PSA 55:23"/></para>
  <chapter eid="PSA 55"/>
  <chapter number="56" style="c" sid="PSA 56"/>
  <para style="s1">ጾሳን ዘምፑዋ ዎሳ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ፕልስጼማ አሳቱ አ ጋተ ግያ ካታማን ኦሞዴዳ ዎደ፥ ዳዊታ ማዝሙርያ። ሃኮ ሳን ዎላ ቦላን ኡቴዳ ዶጎማትስ ጌተቲደ ሱሱልያን የጸቴዳ ማዝሙርያ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 56:1"/>አቤት ጾሳዉ፥ አሳቱ ታና የደርስያ ድራዉነ</para>
  <para style="q2" vid="PSA 56:1">ጋላሳ ኡባንካ ታ ሞርከቱ ታና ኡንኤዳ ድራዉ፥</para>
  <para style="q3" vid="PSA 56:1">ታዉ ቃረታ።<verse eid="PSA 56:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2"/>ታ ሞርከቱ ጋላሳ ኡባን</para>
  <para style="q2" vid="PSA 56:2">ታና የደርሲኖ፤</para>
  <para style="q1" vid="PSA 56:2">ጮራቱ ኦቶሩዋን ታና ኡንኤኖ።<verse eid="PSA 56:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3"/>ታን ያዬዳ ዎደ፥</para>
  <para style="q2" vid="PSA 56:3">ኔናን አማነታይ።<verse eid="PSA 56:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 56:4"/>ታን ጾሳን አማነታይ፤</para>
  <para style="q2" vid="PSA 56:4">ታን አ ቃላ ጋላትያ ጾሳን</para>
  <para style="q2" vid="PSA 56:4">አማነታይነ ያይከ።</para>
  <para style="q2" vid="PSA 56:4">አሳይ ታና አያ ኦኔ?<verse eid="PSA 56:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5"/>ጋላሳ ኡባን ታ ሞርከቱ፥</para>
  <para style="q2" vid="PSA 56:5">ታዉ መቱዋ መኖ፤</para>
  <para style="q1" vid="PSA 56:5">ኡንቱንቱ ኡባ ገደ ታዉ ኢታባ ቆፒኖ።<verse eid="PSA 56:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6"/>ኡንቱንቱ ታ ቦላ ማቀቲኖ፤</para>
  <para style="q2" vid="PSA 56:6">ኩኩሊደ ዎቺኖነ</para>
  <para style="q2" vid="PSA 56:6">ታ ኦግያ ናጊኖ፤</para>
  <para style="q2" vid="PSA 56:6">ታና ዎናዉ ኮዪኖ።<verse eid="PSA 56:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7"/>ኡንቱንቱ ኢታተ ድራዉ፥ ኡንቱንታ የዶፓ፤</para>
  <para style="q2" vid="PSA 56:7">ነ ሀንቁዋን ሄ አሳቱዋ ዝቂ ኦ።<verse eid="PSA 56:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8"/>ኔን ታን ቶይላካቶዋ ፓይዳዳ።</para>
  <para style="q2" vid="PSA 56:8">ታን ዎይሳ አፎ ጉሳድታንቶ፥ ኔን ኤራሳ።</para>
  <para style="q1" vid="PSA 56:8">ኡንቱንቱ ነ ማዝጎብያን ደእክኖ?<verse eid="PSA 56:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9"/>ታን ኔና ጼስያ ዎደ፥</para>
  <para style="q2" vid="PSA 56:9">ታ ሞርከቱ ጉየ ስማና።</para>
  <para style="q1" vid="PSA 56:9">ጾሳይ ታ ባጋ ግድያዋ ታን ኤራይ።<verse eid="PSA 56:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10"/>ታን አ ቃላ ጋላትያ ጾሳይ፥</para>
  <para style="q2" vid="PSA 56:10">ታን አ ቃላ ጋላትያ መና ጎዳ፥<verse eid="PSA 56:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11"/>ታን ሄ ጾሳን አማነታይ፤ ያይከ።</para>
  <para style="q2" vid="PSA 56:11">አሳይ ታና አይ ኦኔ?<verse eid="PSA 56:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12"/>አቤት ጾሳዉ፥ ታን፥</para>
  <para style="q2" vid="PSA 56:12">ነዉ ሺቀቴዳዋ ኦና፤</para>
  <para style="q1" vid="PSA 56:12">ሄዋ ጋላታ ያርሹዋ ታን ነዉ እማና።<verse eid="PSA 56:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13"/>አያዉ ጎፐ፥ ኔን ታና ሀይቁዋፐ፥</para>
  <para style="q2" vid="PSA 56:13">ታ ገድያ ኩንደፐ አሻዳ።</para>
  <para style="q1" vid="PSA 56:13">ሄዋ ድራዉ፥ እ ፓጻ ደእያዋንቱ ቦላን ፖእስያ ፖኡዋን</para>
  <para style="q2" vid="PSA 56:13">ጾሳ ስንን ታን ሀመታይ።<note caller="-" style="x"><char style="xo" closed="false">56:13 </char><char style="xt" closed="false"><ref loc="1SA 22:1">1 ሳሜላ 22:1</ref>፤ <ref loc="1SA 24:3">24:3</ref></char></note><verse eid="PSA 56:13"/></para>
  <chapter eid="PSA 56"/>
  <chapter number="57" style="c" sid="PSA 57"/>
  <para style="s1">ማዱዋ ደማናዉ ሺቄዳ ዎሳ</para>
  <para style="d">ዛማረቱዋ ካፖ፥ ጎንጎሎ ግዶፐ ሳኦላፐ ባቃቲደ ብ ስምና ዳዊታ ዎሳ። “ይሶፓ” ጌተትያ ዎሳን የጸቴዳ ዎሳ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 57:1"/>ታና ማራ፤ አቤት ጾሳዉ፥ ታና ማራ፤</para>
  <para style="q2" vid="PSA 57:1">ታን ኔኮ ባቃታይ።</para>
  <para style="q1" vid="PSA 57:1">ባሻይ አና ጋካናዉ፥</para>
  <para style="q3" vid="PSA 57:1">ነ ቀፍያ ግዶን ባቃታደ አታይ።<verse eid="PSA 57:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2"/>ታን ኡባፐ ቂያ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 57:2">ታዉ ኡባባ ኦያ ጾሳዉ ዋሳይ።<verse eid="PSA 57:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3"/>ጾሳይ ሳሉዋፐ ማዱዋ ኪቲደ፥ ታና አሻና፤</para>
  <para style="q2" vid="PSA 57:3">ታና ናቂያዋንታ ካዉሻና፤</para>
  <para style="q1" vid="PSA 57:3">ጾሳይ አገና ባረ ሲቁዋነ</para>
  <para style="q2" vid="PSA 57:3">ባረ ቱማተ ታዉ ኪታና።<verse eid="PSA 57:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4"/>ታን ታ ሞርከቱዋ ግዶን፥</para>
  <para style="q2" vid="PSA 57:4">አሳ ቦንቂደ ምያ ጋሙዋ ማላቱዋ ግዶን ደአይ።</para>
  <para style="q1" vid="PSA 57:4">ኡንቱንቱ አቻይ ቶራነ ዎንዳፍያ ማላ፤</para>
  <para style="q2" vid="PSA 57:4">ኡንቱንቱ እንጻርሳይ ኩሳ ማሻ ማላ።<verse eid="PSA 57:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5"/>አቤት ጾሳዉ፥ ኔን ሳሎቱዋፐ ቦላና ቁ ቁ ጋ፤</para>
  <para style="q2" vid="PSA 57:5">ነ ቦንቹ ሳኣ ኡባ ቦላ ደኦ።<verse eid="PSA 57:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6"/>ኡንቱንቱ ታ ገድያዉ ጲርያ ዎድኖ፤</para>
  <para style="q2" vid="PSA 57:6">ታን መቶታደ ሆካድ።</para>
  <para style="q1" vid="PSA 57:6">ኡንቱንቱ ታ ኦግያን ኦላ ቦኬድኖ፤</para>
  <para style="q2" vid="PSA 57:6">ሽን ሄ ኦላን ባረንቶ ኩንዴድኖ።<verse eid="PSA 57:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7"/>ታ ዎዛናይ ምኒደ ደኤ፤</para>
  <para style="q2" vid="PSA 57:7">አቤት ጾሳዉ፥ ታ ዎዛናይ ምኒደ ደኤ።</para>
  <para style="q1" vid="PSA 57:7">ታን ነዉ የጻናነ ኔና ሳባና።<verse eid="PSA 57:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8"/>ታ ሸምፓቴ፥ ቤጎታ!</para>
  <para style="q2" vid="PSA 57:8">ዲዉነ ማስንቆ፥ ቤጎትተ!</para>
  <para style="q1" vid="PSA 57:8">ታንካ ዎንታ ጉራና ቤጎታና።<verse eid="PSA 57:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9"/>አቤት ጾሳዉ፥ ታን ኔና አሳ ግዶን ጋላታና፤</para>
  <para style="q2" vid="PSA 57:9">ቃይ ካዉተ ግዶን ኔና ሳባና።<verse eid="PSA 57:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10"/>አያዉ ጎፐ፥ አገና ነ ሲቁ ዎልቃማ፤</para>
  <para style="q2" vid="PSA 57:10">ሳሎቱዋ ጋኬዳ።</para>
  <para style="q1" vid="PSA 57:10">ነ ቱማተይካ ቦላ ሻርያዳን ቄ።<verse eid="PSA 57:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11"/>አቤት ጾሳዉ፥</para>
  <para style="q2" vid="PSA 57:11">ሳሎቱዋፐ ቦላና ቁ ቁ ጋ!</para>
  <para style="q1" vid="PSA 57:11">ነ ቦንቹ ሳኣ ኡባ ቦላ ግዶ።<verse eid="PSA 57:11"/></para>
  <chapter eid="PSA 57"/>
  <chapter number="58" style="c" sid="PSA 58"/>
  <para style="s1">ጾሳይ ናጋራንቻቱዋ ሙራናዳን ሺቆ ዎሳ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ዳዊታ ዎሳ። “ይሶፓ” ጌተትያ ማዝሙርያ ዋጹዋን የጸቴዳ ዎሳ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 58:1"/>ህንተኖ ደርያ ሞድያዋንቶ፥</para>
  <para style="q2" vid="PSA 58:1">ቱሙዋፐ ልክያ ሃሳዪቴ?</para>
  <para style="q1" vid="PSA 58:1">አሳ ኡባ ግዶን ጽሉዋ ፕርዲቴ?<verse eid="PSA 58:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2"/>ግደና፥ ህንተ ዎዛናን ኢታባ ሀልቺታ፤</para>
  <para style="q2" vid="PSA 58:2">ቢታን ህንተ ኩሺ ማካላባ ኦዳ።<verse eid="PSA 58:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3"/>ኢታ አሳይ አት ኡሉዋፐ ዶሚደ ባሌ፤</para>
  <para style="q2" vid="PSA 58:3">የለቶደፐ ዶሚደ፥</para>
  <para style="q1" vid="PSA 58:3">ባይዜነ ዎርዱዋ ሃሳዬ።<verse eid="PSA 58:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4"/>ኡንቱንቱ ሾሻዳን ይሻና ደኢኖ፤</para>
  <para style="q2" vid="PSA 58:4">ቱለ ሀሱዋዳን ሀይ ቱጬድኖ።<verse eid="PSA 58:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5"/>ብትያዌ አይ ኬሻ ሂላንቻ ግዶፐካ፥</para>
  <para style="q2" vid="PSA 58:5">ሀሱ አ ሳሱከ ስሰና።<verse eid="PSA 58:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6"/>አቤት ጾሳዉ፥ ኡንቱንቱ አቻ</para>
  <para style="q2" vid="PSA 58:6">ኡንቱንቱ ጋፓታ ግዶን መን፤</para>
  <para style="q2" vid="PSA 58:6">አቤት መና ጎዳዉ፥ ጋሞቱዋ ካስልያ ካ።<verse eid="PSA 58:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7"/>ኡንቱንቱ ጎግ ይያ ሃዳን ይኖ።</para>
  <para style="q2" vid="PSA 58:7">ኡንቱንቱ ባረንቱ ዎንዳፍያ ዱክያ ዎደ፥</para>
  <para style="q2" vid="PSA 58:7">ፖ ጼራን ጫድያ አይፊ ዮ።<verse eid="PSA 58:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8"/>ኡንቱንቱ ሙሺደ ሳሶ ከስያ ያዳን ሀንኖ፤</para>
  <para style="q2" vid="PSA 58:8">አት ኡሉዋፐ ቦሸቲደ የለቴዳ፥</para>
  <para style="q2" vid="PSA 58:8">ፖኡዋ በኤና ናኣዳን ሀንኖ።<verse eid="PSA 58:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9"/>ኡንቱንቱ አጉን ግዲደ ዳሻናፐ ካሰ፥</para>
  <para style="q2" vid="PSA 58:9">ኡንቱንቱ ብሮ ፑትያን ደእሽን፥</para>
  <para style="q1" vid="PSA 58:9">ጾሳይ ኡንቱንታ ባረ ሀንቁዋን ይሳና።<verse eid="PSA 58:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10"/>ሀሉዋ ከስያዋ በእያ ዎደ፥</para>
  <para style="q2" vid="PSA 58:10">ጽሎቱ ናሸታና።</para>
  <para style="q1" vid="PSA 58:10">ኢታቱዋ ሱን ባረንቱ ገድያ ሜጨታና።<verse eid="PSA 58:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11"/>ሄ ዎደ አሳይ፥</para>
  <para style="q2" vid="PSA 58:11">“ቱሙካ ጽሎቶ ዎይቱ ደኤ፤</para>
  <para style="q2" vid="PSA 58:11">ቱሙካ ሳኣ ቦላ ፕርድያ ጾሳይ ደኤ” ያጋና።<note caller="-" style="x"><char style="xo" closed="false">58:11</char><char style="xt" closed="false"><ref loc="1SA 19:11">1 ሳሜላ 19:11</ref></char></note><verse eid="PSA 58:11"/></para>
  <chapter eid="PSA 58"/>
  <chapter number="59" style="c" sid="PSA 59"/>
  <para style="s1">ኢታቱዋ ኤቀቲደ ሺቆ ዎሳ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ዳዊታ ዎናዉ አ ጎልያ ናጋና ማላ ሳኦል አሳቱዋ ኪት ስምና ዳዊታ ማዝሙርያ። “ይሶፓ” ጊደ ዲ ጊግሱዋን የጸቴዳ ዎሳ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 59:1"/>አቤት ታ ጾሳዉ፥ ታ ሞርከቱዋፐ ታና አሻ፤</para>
  <para style="q2" vid="PSA 59:1">ታ ቦላ ደንድያዋንቱፐ ታና ናጋ።<verse eid="PSA 59:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2"/>ኢታ ኦያዋንቱፐ ታና አሻ አካ፤</para>
  <para style="q2" vid="PSA 59:2">ሱ ጉስያ አሳቱዋፐ ታና አሻ።<verse eid="PSA 59:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3"/>አቤት ጾሳዉ፥ ኡንቱንቱ ታና ዎናዉ</para>
  <para style="q2" vid="PSA 59:3">ኩኩሊደ ናግያዋ በአ!</para>
  <para style="q1" vid="PSA 59:3">ሄ ዎልቃማ ኢታ አሳቱ ታ ቦላ ያኢኖ።</para>
  <para style="q2" vid="PSA 59:3">አቤት መና ጎዳዉ፥ ታ ባይዙዋ ድራዉ</para>
  <para style="q2" vid="PSA 59:3">ዎይ ታ ናጋራ ድራዉ ግደና።<verse eid="PSA 59:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4"/>ኡንቱንቱ ታና ኦላናዉ ዎ ጃምያዌ፥</para>
  <para style="q2" vid="PSA 59:4">ታ ባላ ድራሳ ግደና።</para>
  <para style="q1" vid="PSA 59:4">ቤጎታ፥ ታኮ ሃ ያደ በአ።<verse eid="PSA 59:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5"/>አቤት ኡባፐ ዎልቃማ መታ ኡባ ጎዳ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 59:5">እስራኤልያ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 59:5">ካዉተቱዋ ኡባ ፕርዳናዉ ቤጎታ፤</para>
  <para style="q2" vid="PSA 59:5">ማካላ ኦያዋንታ ማሮፓ።<verse eid="PSA 59:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6"/>ኡንቱንቱ ኦማርሳን ስሚኖ፤</para>
  <para style="q2" vid="PSA 59:6">ካናቱዋዳን ቦጪደ፥ ካታማ ግዶን ዩዪኖ።<verse eid="PSA 59:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7"/>ሄኮ፥ ኡንቱንቱ ባረንቱ ዶናን ሃሳዪደ ሳልክኖ፤</para>
  <para style="q2" vid="PSA 59:7">ኡንቱንቱ እንጻርሳይ ማሻ ማላ።</para>
  <para style="q1" vid="PSA 59:7">ኡንቱንቱ ብሮ፥ “ኦንነ ስሰና” ጊደ ቆፒኖ።<verse eid="PSA 59:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8"/>ሽን አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 59:8">ኔን ኡንቱንቱ ቦላ ሚጫሳ፤</para>
  <para style="q2" vid="PSA 59:8">ካዉተቱዋ ኡባ ቦላ ቅሊጫሳ።<verse eid="PSA 59:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9"/>ጾሳዉ፥ ኔን ታዉ ቆሰታ አትያ ሳኣ ግድያ ድራዉ፥</para>
  <para style="q2" vid="PSA 59:9">ታን ነ ዎልቃን አማነታይ።<verse eid="PSA 59:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 59:10"/>ታ ጾሳይ አገና ባረ ሲቁዋን ታኮ ያና፤</para>
  <para style="q2" vid="PSA 59:10">ታ ጾሳይ ታ ሞርከቱዋ ጾንያዋ እ ታና በሳና።<verse eid="PSA 59:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11"/>ታ አሳቱ ዶገና ማላ፥ ኔን ኡንቱንታ ዎፓ።</para>
  <para style="q2" vid="PSA 59:11">አቤት ጾሳዉ፥ ኑ ጎንዳልያዉ፥</para>
  <para style="q2" vid="PSA 59:11">ነ ዎልቃን ኡንቱንታ ላላደ ጾና።<verse eid="PSA 59:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12"/>ኡንቱንቱ ባረንቱ ዶና ናጋራ ድራዉነ</para>
  <para style="q2" vid="PSA 59:12">ባረንቱ እንጻርሳ ቃላ ድራዉ፥</para>
  <para style="q2" vid="PSA 59:12">ባረንቱ ኦቶሩዋን ኦይቀትኖ።</para>
  <para style="q2" vid="PSA 59:12">ኡንቱንቱ ሸቃ ድራዉነ ኡንቱንቱ ሃሳይያ ዎርዱዋ ድራዉ፥<verse eid="PSA 59:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 59:13"/>ነ ሀንቁዋን ኡንቱንታ ይሳ።</para>
  <para style="q2" vid="PSA 59:13">ጾሳይ ያቆባ ዛራቱዋ ሞድያዋነ</para>
  <para style="q2" vid="PSA 59:13">ሳኣ ጋጻ ጋካናዉ ደእያ ቢታ ሞድያዋ አሳይ ኤራና ማላ፥</para>
  <para style="q2" vid="PSA 59:13">ኡንቱንታ ሙለ አተናዳን ይሳ።<verse eid="PSA 59:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14"/>ታ ሞርከቱ ኦማርሳን ስሚኖ፤</para>
  <para style="q2" vid="PSA 59:14">ካናቱዋዳን ቦጪደ፥</para>
  <para style="q2" vid="PSA 59:14">ካታማ ግዶን ዩዪኖ።<verse eid="PSA 59:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15"/>ኡንቱንቱ ምያዋ ደማናዉ ቶይላካቲኖ፤</para>
  <para style="q2" vid="PSA 59:15">ካላና ዮፐ ላዊኖ።<verse eid="PSA 59:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16"/>ሽን ታን ነ ዎልቃ ሳባና፤</para>
  <para style="q2" vid="PSA 59:16">ዎንታ አገና ነ ሲቁዋባ የጻና።</para>
  <para style="q1" vid="PSA 59:16">አያዉ ጎፐ፥ ኔን ታዉ ታ ዋይያ ጋላስ፥</para>
  <para style="q2" vid="PSA 59:16">ታን ባቃታ አትያ ሳነ ቆሰታ አትያሳ ግዳዳ።<verse eid="PSA 59:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17"/>አቤት ታዉ ዎልቃ ግዴዳ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 59:17">ታን ኔና ሳባና።</para>
  <para style="q1" vid="PSA 59:17">አያዉ ጎፐ፥ ታን ቆሰታ አትያ ሳአይነ</para>
  <para style="q2" vid="PSA 59:17">አገና ሲቁዋ ታና በስያ ጾሳይ ኔና።<note caller="-" style="x"><char style="xo" closed="false">59:17 </char><char style="xt" closed="false"><ref loc="2SA 8:13">2 ሳሜላ 8:13</ref>፤ <ref loc="1CH 18:12">1 ኦዱዋ 18:12</ref></char></note><verse eid="PSA 59:17"/></para>
  <chapter eid="PSA 59"/>
  <chapter number="60" style="c" sid="PSA 60"/>
  <para style="s1">ጾሳይ አሽያዋ ቆንጭስያ ዎሳ</para>
  <para style="d">ዛማረቱዋ ካፖ፥ ማስጰጾምያንነ ሶባላን ደኤዳ ሶርያ አሳቱዋና ኦለቴዳ ዎደነ፥ ዮኣብ ጉየ ስሚደ ማጽንያ ዛንጋራን ታማነ ላኡ ሻኡ አሳ ዎዳ ዎደ፥ ዳውት ትምርትያዉ ጻፌዳ ዎሳ። አድልያ ጪሻ ዋ. ማርካተ ዎሳ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 60:1"/>አቤት ጾሳዉ፥ ኔን ኑና አጋዳ፤</para>
  <para style="q2" vid="PSA 60:1">ኑና መንዳ።</para>
  <para style="q1" vid="PSA 60:1">ኔን ኑና ሀንቀታዳ፤</para>
  <para style="q2" vid="PSA 60:1">ሽን ሀእ ኑኮ ስማ።<verse eid="PSA 60:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2"/>ኔን ቢታ ቃዳነ ዛእሳዳ፤</para>
  <para style="q2" vid="PSA 60:2">ቢታይ ኮኮርያ ድራዉ፥ ኔን አ ዛኡዋ ባራ።<verse eid="PSA 60:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3"/>ኔን ነ አሳ መቱዋ በሳዳ፤</para>
  <para style="q2" vid="PSA 60:3">ኔን ኑና ጋንድጋርስያ ዎይንያ ኡሻዳ።<verse eid="PSA 60:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4"/>ነዉ ያይያዋንቱ፥</para>
  <para style="q2" vid="PSA 60:4">ባረንቱ ሞርክያ ዎንዳፍያፐ አታና ማላ፥</para>
  <para style="q2" vid="PSA 60:4">ማላ እማዳ።<verse eid="PSA 60:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5"/>ኔን ሲቅያዋንቱ አታና ማላ፥</para>
  <para style="q2" vid="PSA 60:5">ነ ኡሸቻ ኩሽያን ኑና አሻ፤</para>
  <para style="q2" vid="PSA 60:5">ኔን ኑዉ አላ።<verse eid="PSA 60:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6"/>ጾሳይ ባረ ጌሻ ሳኣን ሀዋዳን ያጌዳ፤</para>
  <para style="q2" vid="PSA 60:6">“ታን ጾናደ ሰኬማ ቢታ ሻካና፤</para>
  <para style="q2" vid="PSA 60:6">ቃይ ሱኮታ ዛንጋራ ልካና።<verse eid="PSA 60:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7"/>ጋላኣደ ታዋ፤ ምናሰካ ታሳ፤</para>
  <para style="q2" vid="PSA 60:7">ኤፍሬም ታ ሁጲያ ናግያ ቆብያ፤</para>
  <para style="q1" vid="PSA 60:7">ይሁዳይ ታ ካዉተ ጻምኣ።<verse eid="PSA 60:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8"/>ሞኣበ ታን ሜጨትያ ኩይጻሩዋ፤</para>
  <para style="q2" vid="PSA 60:8">ኤዶም ታዋ ግድያዋ ኤርሳናዉ ታ ጫማ አ ቦላ ዎይ፤</para>
  <para style="q1" vid="PSA 60:8">ታን ፕልስጼማ ጾናደ ገሬራይ” ያጌዳ።<verse eid="PSA 60:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9"/>ግምበቴዳ ካታማኮ፥ ታና ኦኔ አፋናዌ?</para>
  <para style="q2" vid="PSA 60:9">ኤዶማ ጋካናዉ ታና ኦኔ ካለናዌ?<verse eid="PSA 60:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10"/>አቤት ጾሳዉ፥ ኑና አጌዳዌ ኔና ግድኪ?</para>
  <para style="q2" vid="PSA 60:10">አቤት ጾሳዉ፥ ኔን ኑ ቶራንቻቱዋና ኦላዉ ከሳካ።<verse eid="PSA 60:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11"/>አሳ ማዱ ፓና ድራዉ፥</para>
  <para style="q2" vid="PSA 60:11">ሞርክያና ኦለታናዉ ኔን ኑና ማዳ።<verse eid="PSA 60:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12"/>ጾሳ ዎልቃን ኑ ሞርከቱዋ ኑን ጾናና፤</para>
  <para style="q2" vid="PSA 60:12">ኑ ሞርከቱዋ የናዌ አ።<verse eid="PSA 60:12"/></para>
  <chapter eid="PSA 60"/>
  <chapter number="61" style="c" sid="PSA 61"/>
  <para style="s1">ናጋናዳን ሺቆ ዎሳ</para>
  <para style="d">ዳዊተ ዛማረቱዋ ካፖ ዲን የጼዳ ማዝሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 61:1"/>አቤት ጾሳዉ፥ ኔን ታ ዋሱዋ ስሳ፤</para>
  <para style="q2" vid="PSA 61:1">ታ ዎሳ ሀይዛ።<verse eid="PSA 61:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2"/>ታ ዎዛናይ ህዶታ ቃንጾ ዎደ፥</para>
  <para style="q2" vid="PSA 61:2">ታን ቢታ ጋጻፐ ኔና ጼሳይ።</para>
  <para style="q1" vid="PSA 61:2">ታፐ ቂያ ዛላኮ፥ ታና ካለ።<verse eid="PSA 61:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3"/>አያዉ ጎፐ፥ ኔን ታዉ ጌሱዋነ</para>
  <para style="q2" vid="PSA 61:3">ታን ታ ሞርከቱዋፐ ናገትያ ግምቢያ ድርሳ።<verse eid="PSA 61:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4"/>ታን ነ ዱንካንያን መናዉ ደአርክታ!</para>
  <para style="q2" vid="PSA 61:4">ታን ነ ቀፍያ ሀጳ ግዶን ሳሮ አታርክታ!<verse eid="PSA 61:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5"/>አቤት ጾሳዉ፥ ኔን ታ ቃንገ ስሳዳ።</para>
  <para style="q2" vid="PSA 61:5">ነ ሱን ያይያዋንቱ</para>
  <para style="q2" vid="PSA 61:5">ላትያ ላታ ታዉካ እማዳ።<verse eid="PSA 61:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6"/>ካትያ ላይ አዱሳ፤</para>
  <para style="q2" vid="PSA 61:6">እ የለታፐ የለታ ጋካናዉ ደኦ።<verse eid="PSA 61:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7"/>እ ጾሳ ስንን መናዉ ካተቶ፤</para>
  <para style="q2" vid="PSA 61:7">አገና ነ ሲቁዋንነ ነ ቱማተን አ ናጋ።<verse eid="PSA 61:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8"/>ያትያዋ ግዶፐ፥ ታን</para>
  <para style="q2" vid="PSA 61:8">ታ ቃንገ ጋላሳን ጋላሳን ጋደ፥</para>
  <para style="q2" vid="PSA 61:8">ነ ሱን ኡባ ገደ ሳባና።<verse eid="PSA 61:8"/></para>
  <chapter eid="PSA 61"/>
  <chapter number="62" style="c" sid="PSA 62"/>
  <para style="s1">ህዶታይ ጾሳ ቦላ ጻላላን</para>
  <para style="d">ዳዊተ ዛማረቱዋ ካፑዋ ጁዱቶ የጼዳ ማዝሙርያ።</para>
  <para style="r">(<ref loc="1CH 25:3">1 ኦዱዋ 25:3</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 62:1"/>ጾሳ ጻላላን ታን ሸምፑዋ ደማድ፤</para>
  <para style="q2" vid="PSA 62:1">ታ አቶተይ አፐ ዬ።<verse eid="PSA 62:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2"/>አ ጻላላይ ታ ዛላነ ታ አቶተ፤</para>
  <para style="q2" vid="PSA 62:2">እ ታን ቆሰታ አትያ ሳኣ ግድያ ድራዉ፥</para>
  <para style="q2" vid="PSA 62:2">አይነ ህርግከ።<verse eid="PSA 62:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3"/>ዎድያ ጎዳነ ቃጽያ ድርሳ ማላትያ አሳ ዎናዉ፥</para>
  <para style="q2" vid="PSA 62:3">ህንተ አዉደ ጋካናዉ ደንዲቴ?<verse eid="PSA 62:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4"/>ኡንቱንቱ አ ቦንቾ ሳኣፐ</para>
  <para style="q2" vid="PSA 62:4">አ ዎናዋ ጻላላ ኮዪኖ፤</para>
  <para style="q2" vid="PSA 62:4">ኡንቱንቱ ዎርዱዋን ናሸቲኖ።</para>
  <para style="q2" vid="PSA 62:4">ባረንቱ ዶናን አንጂኖ፤</para>
  <para style="q2" vid="PSA 62:4">ሽን ባረንቱ ዎዛናን ሸቂኖ።<verse eid="PSA 62:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5"/>ታ ሸምፓታ ጾሳ ጻላላን ሸምፑዋ ደማዱ፤</para>
  <para style="q2" vid="PSA 62:5">ታን ህዶታን ናግያዌ አፐ ዬ።<verse eid="PSA 62:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6"/>አ ጻላላይ ታ ዛላነ ታ አቶተ፤</para>
  <para style="q2" vid="PSA 62:6">እ ታን ቆሰታ አትያ ሳኣ ግድያ ድራዉ፥</para>
  <para style="q2" vid="PSA 62:6">አይነ ህርግከ።<verse eid="PSA 62:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7"/>ታ አቶተይነ ታ ቦንቹ ጾሳና፤</para>
  <para style="q2" vid="PSA 62:7">እ ታ ምኖ ዛላነ ታ ጌሱዋ።<verse eid="PSA 62:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8"/>አሳዉ፥ ኡባ ዎደ ጾሳን አማነትተ፤</para>
  <para style="q2" vid="PSA 62:8">እ ኑዉ ጌሱዋ ግድያ ድራዉ፥</para>
  <para style="q2" vid="PSA 62:8">ህንተ ዎዛና ቆፋ አዉ ኦድተ።<verse eid="PSA 62:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9"/>አሳይ ኡባይ እት ገደ ሸምፕያ ጫርኩዋ ማላ፤</para>
  <para style="q2" vid="PSA 62:9">ቂና ዝቂና፥ አሳይ መላ።</para>
  <para style="q1" vid="PSA 62:9">ሚዛንያን ዎናካ ኡንቱንቱ አይነ ዴጽክኖ፤</para>
  <para style="q2" vid="PSA 62:9">ኡንቱንቱ እት ገደ ሸምፕያ ጫርኩዋፐካ ካዉሺኖ።<verse eid="PSA 62:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10"/>ማካላን ሺሾዋን አማነቶፕተ፤</para>
  <para style="q2" vid="PSA 62:10">ዉእ ሺሺደ ዱረታናዉ ሀልቾፕተ።</para>
  <para style="q1" vid="PSA 62:10">ህንተ ዱረተይ ዳሮፐካ፥</para>
  <para style="q2" vid="PSA 62:10">ህንተ ዎዛና አ ቦላ ዎፕተ።<verse eid="PSA 62:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11"/>ጾሳይ እት ገደ ኦዴዳ፥ ታን</para>
  <para style="q2" vid="PSA 62:11">ላኡ የዉዋ ስሳድ፤ “ዎልቃይ ጾሳሳ።<verse eid="PSA 62:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 62:12"/>አገና ሲቁ ጎዳዋ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">62:12 </char><char style="xt" closed="false"><ref loc="JOB 34:11">ኢዮባ 34:11</ref>፤ <ref loc="JER 17:10">ኤር. 17:10</ref>፤ <ref loc="MAT 16:27">ማቶሳ 16:27</ref>፤ <ref loc="ROM 2:6">ሮመ 2:6</ref>፤ <ref loc="REV 2:23">ሳፃ 2:23</ref></char></note></para>
  <para style="q2" vid="PSA 62:12">አቤት ጾሳዉ፥ ኔን አሳ ኡባዉ</para>
  <para style="q1" vid="PSA 62:12">አ ኦሱዋዳን ኦሱዋዳን ዛራና።<note caller="-" style="x"><char style="xo" closed="false">62:12</char><char style="xt" closed="false"><ref loc="1SA 23:14">1 ሳሜላ 23:14</ref></char></note><verse eid="PSA 62:12"/></para>
  <chapter eid="PSA 62"/>
  <chapter number="63" style="c" sid="PSA 63"/>
  <para style="s1">ጾሳ ኮዩሳ</para>
  <para style="d">ይሁዳ ባዙዋን ደእያ ዎደ ዳዊታ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1"/>አቤት ጾሳዉ፥ ኔን ታ ጾሳ፤</para>
  <para style="q2" vid="PSA 63:1">ታ ዎዛናይ ኔና ላሞቴ፤</para>
  <para style="q3" vid="PSA 63:1">ታ አሹካ ኔና አሞቴ።</para>
  <para style="q1" vid="PSA 63:1">መል ዛኤዳ፥ ሃ ባይና ቢታዳን</para>
  <para style="q2" vid="PSA 63:1">ታ ኩመን አሳተይ ኔና ሳመቴ።<verse eid="PSA 63:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2"/>ታን ኔና ጌሻ ሳኣን በኣድ፤</para>
  <para style="q2" vid="PSA 63:2">ነ ዎልቃካ ነ ቦንቹዋካ ታን በኣድ።<verse eid="PSA 63:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3"/>አገና ነ ሲቁ ደኡዋፐ ሎእያ ድራዉ፥</para>
  <para style="q2" vid="PSA 63:3">ታ እንጻርሳይ ኔና ቦንቻና።<verse eid="PSA 63:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4"/>ታ ደኡዋ ላይን ታን ኔና ጋላታና፤</para>
  <para style="q2" vid="PSA 63:4">ነ ሱንን ታ ኩሽያ ፑደ ምጫና።<verse eid="PSA 63:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5"/>አሳይ ሎኦ ቁማ ካልያዋዳን፥</para>
  <para style="q2" vid="PSA 63:5">ታ ሸምፓታ ኔናን ካላና።</para>
  <para style="q1" vid="PSA 63:5">ታን ታ እንጻርሳን ናሸቻ የን ኔና ጋላታና።<verse eid="PSA 63:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6"/>ታን ታ ግሱዋን ኔና ሀሳያይ፤</para>
  <para style="q2" vid="PSA 63:6">ቃማ ኡባን ነባ ቆፓይ፤<verse eid="PSA 63:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7"/>አያዉ ጎፐ፥ ኔን ታና ማዴዳዋ።</para>
  <para style="q2" vid="PSA 63:7">ታን ነ ቀፍያ ኩዋን ኡታደ፥ ናሸቻዉ የጻይ።<verse eid="PSA 63:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8"/>ታን ነ ማታ ሺቃ ኡታይ፤</para>
  <para style="q2" vid="PSA 63:8">ነ ኡሸቻ ኩሺ ታና ኦይቂደ ናጌ።<verse eid="PSA 63:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9"/>ሽን ታና ዎና ኮይያዋንቱ፥</para>
  <para style="q2" vid="PSA 63:9">ቢታ ጋርሳ ጪሞ ሳኣን ሞገታና።<verse eid="PSA 63:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10"/>ኡንቱንቱ ማሻዉ አደ እመታና፤</para>
  <para style="q2" vid="PSA 63:10">ኡንቱንቱ ባባርቂያ ካተ ግዳና።<verse eid="PSA 63:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11"/>ሽን ካቲ ጾሳን ናሸታና።</para>
  <para style="q2" vid="PSA 63:11">ጾሳ ሱንን ጫቂያ ኡባይ አ ጋላታና፤</para>
  <para style="q2" vid="PSA 63:11">ሽን ዎርዱዋ ሃሳይያዋንቱ ዶናይ ጎርደታና።<verse eid="PSA 63:11"/></para>
  <chapter eid="PSA 63"/>
  <chapter number="64" style="c" sid="PSA 64"/>
  <para style="s1">ናጋናዳን ሺቆ ዎሳ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ዳዊታ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1"/>አቤት ጾሳዉ፥ ታን ማጋንያ ማጋና ኔን ስሳ።</para>
  <para style="q2" vid="PSA 64:1">ታን ታ ሞርከቶ ያያድ፤ ታና አሻ።<verse eid="PSA 64:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2"/>ኢታቱዋ ማቁዋፐነ፥</para>
  <para style="q2" vid="PSA 64:2">ኢታ ኦያዋንቱ ሽቁዋፐ ታና ገን።<verse eid="PSA 64:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3"/>ኡንቱንቱ ባረንቱ እንጻርሳ ማሻዳን ሌፌድኖ፤</para>
  <para style="q2" vid="PSA 64:3">ቃይ ማርዘ ቃላቱዋ፥</para>
  <para style="q2" vid="PSA 64:3">ዎንዳፍያ ፖዳን ዱካናዉ ጊግሴድኖ።<verse eid="PSA 64:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4"/>ኡንቱንቱ ቆሰቲደ፥</para>
  <para style="q2" vid="PSA 64:4">ባረንቱ ዎንዳፍያ ጽሎ አሳ ቦላ ዳፊኖ፤</para>
  <para style="q2" vid="PSA 64:4">አኬካይ ባይናን ዱኪኖ፤ ኡንቱንቱ ያይክኖ።<verse eid="PSA 64:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5"/>ኡንቱንቱ ባረንቱ ኢታ ማቆ እቱ እቱዋ ምንኖ፤</para>
  <para style="q2" vid="PSA 64:5">ባረንቱ ጲርያ ቆስያሳ ዞረቲኖ።</para>
  <para style="q1" vid="PSA 64:5">ኡንቱንቱ፥ “ኑና ኦን በአኔ?” ያጊኖ።<verse eid="PSA 64:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6"/>ኡንቱንቱ ኢታባ ማቀቲደ፥</para>
  <para style="q2" vid="PSA 64:6">“ኑን ሎኦ ማቁዋ ማቀቴዶ” ያጊኖ።</para>
  <para style="q1" vid="PSA 64:6">ሄዌነ፥ አሳዉ ዎዛናይነ ካሀይ ጪማ ግድያዋ በሴ።<verse eid="PSA 64:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7"/>ሽን ጾሳይ ኡንቱንታ ባረ ዎንዳፍያን ዱካና፤</para>
  <para style="q2" vid="PSA 64:7">ኡንቱንቱ አኬከናን ማዱጻና።<verse eid="PSA 64:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8"/>ኡንቱንቱ ማቁዋ ድራዉ፥</para>
  <para style="q2" vid="PSA 64:8">እ ኡንቱንታ ይሳና፤</para>
  <para style="q2" vid="PSA 64:8">ኡንቱንታ በእያ ኡባይ ሁጲያ ቃና።<verse eid="PSA 64:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9"/>ሄ ዎደ አሳይ ኡባይ ጾሳዉ ያያና፤</para>
  <para style="q2" vid="PSA 64:9">አ ኦሱዋባ ኦዳናነ ዛር ዛሪደ ቆፓና።<verse eid="PSA 64:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10"/>ጽሎቱ መና ጎዳን ናሸትኖነ፥</para>
  <para style="q2" vid="PSA 64:10">አኮ ባቃቲደ አቲኖ፤</para>
  <para style="q2" vid="PSA 64:10">ዎዛና ሱረቱ ኡባይ ጋላትኖ።<verse eid="PSA 64:10"/></para>
  <chapter eid="PSA 64"/>
  <chapter number="65" style="c" sid="PSA 65"/>
  <para style="s1">ጋላታ ማዝሙርያ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ዳዊታ ማዛሙርያ፥ ሳባ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1"/>አቤት ጾሳዉ፥ ጽዮነን ነዉ ጋላታይ በሴ፤</para>
  <para style="q2" vid="PSA 65:1">ኑን ነዉ ሺቀቴዳዋካ ጋና።<verse eid="PSA 65:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2"/>አቤት ዎሳ ስስያዎ፥</para>
  <para style="q2" vid="PSA 65:2">አሳይ ኡባይ ኔኮ ያና።<verse eid="PSA 65:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3"/>ኑ ናጋራይ ኑና ሙኬዳ ዎደ፥</para>
  <para style="q2" vid="PSA 65:3">ነ ኑዉ አቶተ እማዳ።<verse eid="PSA 65:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4"/>ኔን ዶሬዳነ ነ ችሎታን ኡታናዉ</para>
  <para style="q2" vid="PSA 65:4">ማታ ሺሽያ አሳይ አንጀቴዳዋ።</para>
  <para style="q1" vid="PSA 65:4">ኑን ነ ሶን፥ ጌሻ ዱንካንያን</para>
  <para style="q2" vid="PSA 65:4">ደእያ ሎኦባን ኩሜዶ።<verse eid="PSA 65:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5"/>አቤት ኑና አሽያ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 65:5">ማላልስያ ነ ጽሎ ኦሱዋን ኔን ኑዉ አላሳ።</para>
  <para style="q1" vid="PSA 65:5">ሳኣ ጋጻፐ ጋጻ ጋካናዉ፥</para>
  <para style="q2" vid="PSA 65:5">ሃኮ አባቱዋፐካ ሄፍንን ደእያ አሳ ኡባዉ፥</para>
  <para style="q2" vid="PSA 65:5">አማነትያዌ ኔና።<verse eid="PSA 65:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6"/>ኔን ኔና ዎልቃ ዳንጭሳደ፤</para>
  <para style="q2" vid="PSA 65:6">ዎልቃማ ደረቱዋ ነ ምኖተን ኤሳዳ።<verse eid="PSA 65:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7"/>ኔን አባ ኮሻነ፥</para>
  <para style="q2" vid="PSA 65:7">ቤታ ጉን ስርጵ ኦሳ፤</para>
  <para style="q2" vid="PSA 65:7">ቃይ አሳይ ደንድያ ደንዱዋ እርጽሳሳ።<verse eid="PSA 65:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8"/>ሄዋዳን ኔን ኦዳ ማላታ ድራዉ፥</para>
  <para style="q2" vid="PSA 65:8">ሳኣ ጋጻ ጋካናዉ ደእያ አሳይ ኡባይ ነዉ፥ “ሆላ!” ጌ።</para>
  <para style="q1" vid="PSA 65:8">አዋይ ሞክያሳፐ ዉልያሳ ጋካናዉ ደእያ አሳ ኡባ ናሸቻዳ።<verse eid="PSA 65:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9"/>ኔን ቢታ ናጋደ እራ ቡክሳሳ፤</para>
  <para style="q2" vid="PSA 65:9">ያታደ ዳሮ ቱኤያሳ።</para>
  <para style="q1" vid="PSA 65:9">አሳዉ ካይ ሞካና ማላ፥</para>
  <para style="q2" vid="PSA 65:9">ጾሳ ፑልቶቱ ሃን ኩሜድኖ፤</para>
  <para style="q2" vid="PSA 65:9">ሄዋዳን ኦደ ኔን ጊግሳዳ።<verse eid="PSA 65:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10"/>ካቻ ዎና ማላነ ጉሉዋ ሹግሳና ማላ፥</para>
  <para style="q2" vid="PSA 65:10">ኔን ያፋራን ሃ ኩንሳ፤</para>
  <para style="q2" vid="PSA 65:10">ካይ ሞካና ማላ አንጃሳ።<verse eid="PSA 65:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11"/>ላይ ካሎ ላይ ኦሳ፤</para>
  <para style="q2" vid="PSA 65:11">ኔን አያ ሳአይ ኡባይ ኩም ፓላሄ።<verse eid="PSA 65:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12"/>ኔን ሄን ሳኣ ማታን ኩንሳ፤</para>
  <para style="q2" vid="PSA 65:12">ዞዘቱዋካ ናሸቻ ዳንጭሳሳ።<verse eid="PSA 65:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13"/>ኔን ሄን ጋድያ ዶርሳ ዉድያ ማይዛሳ፤</para>
  <para style="q2" vid="PSA 65:13">ዛንጋራ ቢታካ ካ ኩን።</para>
  <para style="q1" vid="PSA 65:13">ኡንቱንቱ ናሸቻዉ ሆምቦጪኖነ የጺኖ።<verse eid="PSA 65:13"/></para>
  <chapter eid="PSA 65"/>
  <chapter number="66" style="c" sid="PSA 66"/>
  <para style="s1">እትፐተ ጋላታ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ ሳባ፥ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 66:1"/>ሳኣን አሳ ኡባዉ፥ ህንተ ቃላ ቂሲደ፥</para>
  <para style="q2" vid="PSA 66:1">ናሸቻን ጾሳ ጋላትተ።<verse eid="PSA 66:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 66:2"/>“ጾሳ ሱንይ ቦንቼቶ!” ጊደ የጽተ፤</para>
  <para style="q2" vid="PSA 66:2">ቦንቾ ጋላታ አዉ እምተ።<verse eid="PSA 66:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3"/>ጾሳዉ ሀዋዳን ያግተ፤</para>
  <para style="q2" vid="PSA 66:3">“ነ ኦሶቱ ዋን ማላልስያዋንቴ!</para>
  <para style="q1" vid="PSA 66:3">ነ ዎልቃይ ዳሬዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 66:3">ነ ሞርከቱ ያሻዉ ነ ስንን ኮኮሪኖ።<verse eid="PSA 66:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4"/>ሳኣን ደእያ ኡባቱ ነዉ ጎይኒኖ፤</para>
  <para style="q2" vid="PSA 66:4">ኔና ሳቢኖ፤</para>
  <para style="q2" vid="PSA 66:4">ነ ሱንዉ ጋላታ የጺኖ” ያግተ።<verse eid="PSA 66:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5"/>ሃይተ፤ ጾሳይ ኦዳዋ በእተ፤</para>
  <para style="q2" vid="PSA 66:5">እ አሳ ግዶን ማላልስያ ኦሱዋ ኦዳ።<verse eid="PSA 66:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6"/>እ አባ ሃ ሻኬዳ፤<note caller="-" style="x"><char style="xo" closed="false">66:6 </char><char style="xt" closed="false"><ref loc="EXO 14:21">ከሳ 14:21</ref>፤ <ref loc="JOS 3:14-17">ኢያሳ 3:14-17</ref></char></note></para>
  <para style="q2" vid="PSA 66:6">ቃይ በን ኑ አዎቱ ዮርዳኖሳ ሻፋ፥</para>
  <para style="q2" vid="PSA 66:6">ባረንቱ ገድያን ሀመቲደ፥ መላ ቢታን ፕኔድኖ።</para>
  <para style="q2" vid="PSA 66:6">ሄዋን እ ኦዳባን ኑን ናሸቴዶ።<verse eid="PSA 66:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7"/>እ ባረ ዎልቃን መናዉ ሞዴ።</para>
  <para style="q2" vid="PSA 66:7">ካዉተቱዋ ባረ አይፍያን ጼሌ፤</para>
  <para style="q2" vid="PSA 66:7">ሄዋ ድራዉ፥ ማካልያዋንቱ አ ቦላ ደንዶፕኖ።<verse eid="PSA 66:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8"/>አሳቶ፥ ኑ ጾሳ ጋላትተ፤</para>
  <para style="q2" vid="PSA 66:8">ህንተ አ ጋላትያ ጋላታይ ስሰቶ።<verse eid="PSA 66:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9"/>እ ኑና ፓጻ ዎዳ፤</para>
  <para style="q2" vid="PSA 66:9">ኑን ኩንደናዳን ናጌዳ።<verse eid="PSA 66:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10"/>አቤት ጾሳዉ፥ ኔን ኑና ፓጫዳ፤</para>
  <para style="q2" vid="PSA 66:10">ብራ ጌሻናዉ ታማን ፓጭያዋዳን፥</para>
  <para style="q2" vid="PSA 66:10">ኑና ጌሻዳ።<verse eid="PSA 66:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11"/>ኔን ኑና ጲርያን ገልሳዳ።</para>
  <para style="q2" vid="PSA 66:11">ኑ ዞኩዋንካ ዴጾባ ቶሳዳ።<verse eid="PSA 66:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12"/>ሞርከቱ ኑ ሁጲያን ቶጋናዳን ኦዳ።</para>
  <para style="q2" vid="PSA 66:12">ኑን ሃ ግዱዋናነ ታማ ግዱዋና አዶ፤</para>
  <para style="q2" vid="PSA 66:12">ሽን ሀእ ኑና እሻልያ ሳ አሃዳ።<verse eid="PSA 66:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13"/>ታን ጹግያ ያርሹዋና ነ ጎልያ ገላደ፥</para>
  <para style="q2" vid="PSA 66:13">ታ ቃንግያ ነዉ ጋና።<verse eid="PSA 66:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14"/>ታን መቶቴዳ ዎደ፥</para>
  <para style="q2" vid="PSA 66:14">ታ ዶናን ሺቀቴዳ ቃንግያ፥</para>
  <para style="q2" vid="PSA 66:14">ታ እንጻርሳፐ ከሴዳዋ፥ ታን ጋና።<verse eid="PSA 66:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15"/>ታን ነዉ ጹጊደ ያርሽያ፥</para>
  <para style="q2" vid="PSA 66:15">ዶርሳ ኦርገቱዋ ሺሻና።</para>
  <para style="q1" vid="PSA 66:15">ኮሩማ ቦራቱዋነ ዴሻ ኦርገቱዋ ነዉ ያርሻና፤</para>
  <para style="q2" vid="PSA 66:15">ሄ ያርሾቱዋ ጩዋይ ሳሉዋ ጋካና።<verse eid="PSA 66:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16"/>ህንተኖ፥ ጾሳዉ ያይያዋንቶ፥</para>
  <para style="q2" vid="PSA 66:16">ኡባቱ ሃ ዪደ፥ ስስተ።</para>
  <para style="q1" vid="PSA 66:16">ጾሳይ ታዉ ኦዳዋ ታን ህንተዉ ኦዳና።<verse eid="PSA 66:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17"/>ታ ቃላ ቁ ኦደ ታን ጾሳ ዎሳድ፤</para>
  <para style="q2" vid="PSA 66:17">ታ እንጻርሳን አዉ ጋላታ ሺሻድ።<verse eid="PSA 66:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18"/>ታን ታ ዎዛናን ናጋራ ገንደንቶ፥</para>
  <para style="q2" vid="PSA 66:18">ጎዳይ ታና ስሰና።<verse eid="PSA 66:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19"/>ሽን ጾሳይ ቱሙዋፐ ታና ስሴዳ፤</para>
  <para style="q2" vid="PSA 66:19">ታ ዎሳካ ሀይዜዳ።<verse eid="PSA 66:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20"/>ጾሳይ ታ ዎሳ እጽቤና ድራዉ፥</para>
  <para style="q2" vid="PSA 66:20">ቃይ አገና ባረ ሲቁዋ ታዉ ድግቤና ድራዉ፥ ጋላቴቶ።<verse eid="PSA 66:20"/></para>
  <chapter eid="PSA 66"/>
  <chapter number="67" style="c" sid="PSA 67"/>
  <para style="s1">ጋላታ ማዝሙርያ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ዲን ዋጸቴዳ ማዝሙርያ፥ ሳባ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 67:1"/>ጾሳይ ኑዉ ቃረቶነ ኑና አንጆ፤</para>
  <para style="q2" vid="PSA 67:1">ባረ ሶምእያ ኑ ቦላን ፖእሶ።<verse eid="PSA 67:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2"/>ነ ኦገቱ ሀ ሳኣ ቦላን፥</para>
  <para style="q2" vid="PSA 67:2">ነ አሽያ ዎልቃይካ፥</para>
  <para style="q2" vid="PSA 67:2">ካዉተቱዋ ኡባ ግዱዋን ኤረትኖ።<verse eid="PSA 67:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3"/>አቤት ጾሳዉ፥ አሳይ ኔና ጋላቶ፤</para>
  <para style="q2" vid="PSA 67:3">አሳይ ኡባይ ኔና ጋላቶ።<verse eid="PSA 67:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4"/>ካዉተቱ ኡባይ፥ “ሀሹ!” ጊደ፥</para>
  <para style="q2" vid="PSA 67:4">ናሸቻዉ ዪኖ።</para>
  <para style="q1" vid="PSA 67:4">አያዉ ጎፐ፥ ኔን አሳ ጽሎተን ፕርዳሳ፤</para>
  <para style="q2" vid="PSA 67:4">ቃይ ሳኣን ደእያ ካዉተቱዋ ካለሳ።<verse eid="PSA 67:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5"/>አቤት ጾሳዉ፥ አሳይ ኔና ጋላቶ፤</para>
  <para style="q2" vid="PSA 67:5">አሳይ ኡባይ ኔና ጋላቶ።<verse eid="PSA 67:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6"/>ቢታይ ካ ሞኬዳ፤</para>
  <para style="q2" vid="PSA 67:6">ጾሳይ፥ ኑ ጾሳይ ኑና አንጄዳ።<verse eid="PSA 67:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7"/>ጾሳይ ኑና አንጄዳ።</para>
  <para style="q2" vid="PSA 67:7">ሳኣ ጋጻ ጋካናዉ ደእያ አሳይ ኡባይ አዉ ያዮ።<verse eid="PSA 67:7"/></para>
  <chapter eid="PSA 67"/>
  <chapter number="68" style="c" sid="PSA 68"/>
  <para style="s1">ጾኑዋ ማዝሙርያ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ዳውት ጻፌዳ ማዛሙርያ፥ የ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 68:1"/>ጾሳይ ደንዶ፤ አ ሞርከቱ ላለትኖ።</para>
  <para style="q2" vid="PSA 68:1">አ እጽያዋንቱ አ ስንፐ ባቃትኖ።<verse eid="PSA 68:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2"/>ጩዋይ ጫርኩዋን ፑነትያዋዳን፥</para>
  <para style="q2" vid="PSA 68:2">ኔን ኡንቱንታ ፑና ይሳ።</para>
  <para style="q1" vid="PSA 68:2">ሙቃዳይ ታማን ሙሽያዋዳን፥</para>
  <para style="q2" vid="PSA 68:2">ኢታቱ ጾሳ ስንፐ ይኖ።<verse eid="PSA 68:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3"/>ሽን ጽሎቱ ሀሹ ጊኖ፤</para>
  <para style="q2" vid="PSA 68:3">ጾሳ ስንን ናሸትኖ፤</para>
  <para style="q2" vid="PSA 68:3">ናሸቻን እልልኖ።<verse eid="PSA 68:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4"/>ጾሳዉ የጽተ፤ አ ሱን ሳቢተ።</para>
  <para style="q2" vid="PSA 68:4">ሻርያ ቦላን ጋልፍያዋ ቁ ቁ ኦተ ከስተ፤</para>
  <para style="q1" vid="PSA 68:4">አ ሱንይ መና ጎዳ፤</para>
  <para style="q2" vid="PSA 68:4">አ ስንን ናሸትተ።<verse eid="PSA 68:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5"/>ጾሳይ ባረ ደእያ ጌሻ ሳኣን፥</para>
  <para style="q2" vid="PSA 68:5">አዉ ባይና ናናቶ አዉዋ፤</para>
  <para style="q2" vid="PSA 68:5">ቃይ አስናይ ሀይቄዳ ማጫ አሳቶ ዳና።<verse eid="PSA 68:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6"/>ጾሳይ ባረካ ደእያዋንቶ ጎለ አሳ እሜ።</para>
  <para style="q2" vid="PSA 68:6">ቃሾ ጎልያን ደእያዋንታ ብሊደ፥</para>
  <para style="q2" vid="PSA 68:6">ኡንቱንታ እሻሉዋን ዎ።</para>
  <para style="q2" vid="PSA 68:6">ሽን ማካላንቻቱ መሌዳ ቢታን ደኢኖ።<verse eid="PSA 68:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7"/>አቤት ጾሳዉ፥ ኔን ነ አሳ ካለዳ ዎደ፥</para>
  <para style="q2" vid="PSA 68:7">ኔን ኡንቱንቱና መላ ባዙዋ ቤዳ ዎደ፥<verse eid="PSA 68:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8"/>ሲና ደርያን ቆንጬዳ ጾሳ ስንን፥</para>
  <para style="q2" vid="PSA 68:8">እስራኤልያ ጾሳ ስንን ቢታይ ቃጼዳ፤</para>
  <para style="q2" vid="PSA 68:8">ሳሎቱ እራ ዱገ ትጌድኖ።<note caller="-" style="x"><char style="xo" closed="false">68:8 </char><char style="xt" closed="false"><ref loc="EXO 19:18">ከሳ 19:18</ref></char></note><verse eid="PSA 68:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9"/>አቤት ጾሳዉ፥ ኔን እራ ዳርሳደ ቡክሳዳ፤</para>
  <para style="q2" vid="PSA 68:9">መላ ቢታ ዛራደ ኦራዳ።<verse eid="PSA 68:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10"/>ነ አሳይካ ያን ኡቴዳ።</para>
  <para style="q2" vid="PSA 68:10">አቤት ጾሳዉ፥ ነ ኬካተን፥</para>
  <para style="q2" vid="PSA 68:10">ህዬሳቶ ኮሽያባ ጊግሳደ እማዳ።<verse eid="PSA 68:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11"/>ጎዳይ ኪታ ኪቴዳ፤</para>
  <para style="q2" vid="PSA 68:11">ሄ ኪታ አፌዳ ማጫ አሳቱ ዳራ።<verse eid="PSA 68:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12"/>ኡንቱንቱ፥ “ሞርከ ካተቱነ</para>
  <para style="q2" vid="PSA 68:12">ኡንቱንቱ ቶራንቻቱ ጉየ ባቃቴድኖ፤</para>
  <para style="q2" vid="PSA 68:12">ሶን አቴዳ ማጫ አሳቱ ኦሞዱዋ ሻከቴድኖ።<verse eid="PSA 68:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13"/>ኡንቱንቱ፥ ጶልያ ዎርቃ ቀፍያና ደእያ፥</para>
  <para style="q2" vid="PSA 68:13">ብራፐ መቴዳ ሀራጵያ ምስልያ፥</para>
  <para style="q2" vid="PSA 68:13">ኦሞዱዋ ደሞደ፥ ህንተንቱ፥</para>
  <para style="q2" vid="PSA 68:13">ዶርሳ ስኩዋ ግዶን አያዉ ግሴድቴ?” ያጌድኖ።<verse eid="PSA 68:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14"/>ኡባ ዳንዳይያ ጾሳይ፥</para>
  <para style="q2" vid="PSA 68:14">ካተቱዋ ላሌዳ ዎደ፥</para>
  <para style="q1" vid="PSA 68:14">ጻልሞና አሳ ቦላ ሻቻ ቡክሴዳ።<verse eid="PSA 68:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15"/>ባሳነ ደረቱ ዎጋ ዎልቃማ ደረቱዋ፤</para>
  <para style="q2" vid="PSA 68:15">ባሳነ ደረቱ ዳሮ ጼራቱ ደእያዋንታ።<verse eid="PSA 68:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16"/>ዳሮ ጼራቱ ደእያ ደረቶ፥</para>
  <para style="q2" vid="PSA 68:16">ጾሳይ ባረሳ ኦናዉ ዶሬዳ አሳ፥</para>
  <para style="q2" vid="PSA 68:16">ህንተ አያዉ ቃናቲደ ጼሊቴ?</para>
  <para style="q2" vid="PSA 68:16">መና ጎዳይ አን መናዉ ደአናዋ።<verse eid="PSA 68:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17"/>ጾሳ ኦላ ፓራ ጋረቱ</para>
  <para style="q2" vid="PSA 68:17">ታሙ ሻኣንነ ሻኡ ገደ ሻአን ፓይደትያዋንታ፤</para>
  <para style="q2" vid="PSA 68:17">ጎዳይ ሲና ደርያፐ ባረ ጌሻ ሳኣ ዬዳ።<verse eid="PSA 68:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18"/>ኦሞደቴዳ ዳሮቱዋ አኪደ፥</para>
  <para style="q2" vid="PSA 68:18">እ ፑደ ቃ ከሴዳ።<note caller="-" style="x"><char style="xo" closed="false">68:18 </char><char style="xt" closed="false"><ref loc="EPH 4:8">ኤፈ. 4:8</ref></char></note></para>
  <para style="q1" vid="PSA 68:18">አሳፐ፥ ሀራይ አቶ ማካላንቻ አሳፐካ እሙዋ አኬዳ።</para>
  <para style="q2" vid="PSA 68:18">መታ ኡባ ጎዳይ ያን ደአና።<verse eid="PSA 68:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19"/>ጋላሳን ጋላሳን ኑ ቶኩዋ ቶክያ ጎዳይ፥</para>
  <para style="q2" vid="PSA 68:19">ኑና አሽያ ጾሳይ ጋላተቶ።<verse eid="PSA 68:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20"/>ኤ፥ ኑ ጾሳይ ኑና አሽያ ጾሳቴ!</para>
  <para style="q2" vid="PSA 68:20">ሀይቁዋፐ አትያዌ፥</para>
  <para style="q1" vid="PSA 68:20">ኡባ ሞድያ መና ጎዳይ አሽናዳ።<verse eid="PSA 68:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21"/>ጾሳይ ቱሙዋፐ ባረ ሞርከቱዋ፥</para>
  <para style="q2" vid="PSA 68:21">ጉግያ ክንቻና፤</para>
  <para style="q2" vid="PSA 68:21">ናጋራ ኦግያን ሀመትያ፥</para>
  <para style="q2" vid="PSA 68:21">ጎፋራንቻቱዋ ሁጲያ ጳልቃና።<verse eid="PSA 68:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22"/>ጎዳይ ያጌዳ፤ “ታን ህንተ ሞርከቱዋ፥</para>
  <para style="q2" vid="PSA 68:22">ባሳነፐ ዛራደ አሀና፤</para>
  <para style="q2" vid="PSA 68:22">ታን ኡንቱንታ ጪሞ አባ ግዶፐ ከሳደ ጉየ አሀና።<verse eid="PSA 68:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23"/>ሄዌነ፥ ኔን ነ ሞርከቱዋ፥</para>
  <para style="q2" vid="PSA 68:23">ሱ ግዱዋና ጮልባያ የደ ሀመታናሳነ፤</para>
  <para style="q2" vid="PSA 68:23">ነ ካናቱካ ሞርክያ ሱፐ፥</para>
  <para style="q2" vid="PSA 68:23">ባረንቱ ግሹዋ እንጻርሳን ላጫናሳ” ያጌዳ።<verse eid="PSA 68:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24"/>አቤት ጾሳዉ፥ ነ ሳልፒ፥</para>
  <para style="q2" vid="PSA 68:24">ታ ጾሳ ታ ካትያ ሳልፒ፥</para>
  <para style="q2" vid="PSA 68:24">ጌሻ ጎልያ ገልያ ዎደ ኡባዉ ቤቴ።<verse eid="PSA 68:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25"/>የጽያዋንቱ ስንና፤ ዲጽያዋንቱ ጉየና፤</para>
  <para style="q2" vid="PSA 68:25">ቃይ ካራቡዋ ባቂያ ዎዶሮቱ ግዱዋና።<verse eid="PSA 68:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26"/>ኡንቱንቱ፥ “ጾሳ ኩንዳ ሺቁዋን ጋላትተ፤</para>
  <para style="q2" vid="PSA 68:26">ህንተኖ፥ እስራኤልያ ዘረቶ፥</para>
  <para style="q1" vid="PSA 68:26">መና ጎዳ ጋላትተ” ያጊኖ።<verse eid="PSA 68:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27"/>ሄ ሳልፕያን ኡባፐ ቴፋትያ፥</para>
  <para style="q2" vid="PSA 68:27">ቢንያማ ዛራቱ ኮይሮ ቤቲኖ።</para>
  <para style="q1" vid="PSA 68:27">ካሊደ ይሁዳ ካፓቱ ባረንቱ ጭታና ደኢኖ፤</para>
  <para style="q2" vid="PSA 68:27">ዉርሰን ዛብሎና ካፓቱነ ንፍታሌማ ካፓቱ ቤቲኖ።<verse eid="PSA 68:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28"/>አቤት ጾሳዉ፥ ነ ዎልቃ ቆንጭሳ።</para>
  <para style="q2" vid="PSA 68:28">አቤት ኑዉ ኦዳ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 68:28">ነ ምኖተ በሳ።<verse eid="PSA 68:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29"/>ሄዋ ድራዉ፥ የሩሳላመን ደእያ</para>
  <para style="q2" vid="PSA 68:29">ነ ጌሻ ጎልያ ካተቱ ዪደ፥</para>
  <para style="q2" vid="PSA 68:29">ነዉ እሞታ እማና።<verse eid="PSA 68:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30"/>ዶኣዳን ማቃ ግዶን ደእያ ግብጼ አሳቱዋ ኔን ሴራ።</para>
  <para style="q2" vid="PSA 68:30">ቦራቱዋነ ማራቱዋ ዉድያ፥</para>
  <para style="q2" vid="PSA 68:30">ማላትያ ካዉተቱዋ ኔን የደርሳ።</para>
  <para style="q2" vid="PSA 68:30">ኡንቱንቱ ጉልባቲደ፥ ባረንቱ ብራ ነዉ እማና ጋካናዉ፥</para>
  <para style="q2" vid="PSA 68:30">ኔን ኡንቱንታ ሴራ።</para>
  <para style="q2" vid="PSA 68:30">ኦለታናዉ ዬሞትያ አሳቱዋ ላላ።<verse eid="PSA 68:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31"/>ኪተቴዳ ካፓቱ ግብጼፐ ያና፤</para>
  <para style="q2" vid="PSA 68:31">ቶጳታ ባረ ኩሽያ ኤለ ጾሳኮ ምጫና።<verse eid="PSA 68:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32"/>ህንተኖ፥ ሳኣ ካዉተቶ፥</para>
  <para style="q2" vid="PSA 68:32">ጾሳዉ የጽተ፤<verse eid="PSA 68:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33"/>ሳሎቱዋን፥ በንፐ ደእያ ሳሎቱዋን ብያ ጎዳ ሳቢተ።</para>
  <para style="q2" vid="PSA 68:33">ስስተ! እ ባረ ኮሻ፥</para>
  <para style="q2" vid="PSA 68:33">ባረ ዎልቃማ ጉን ኪቴ።<verse eid="PSA 68:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34"/>ጾሳ ዎልቃባ አዋይተ፤</para>
  <para style="q2" vid="PSA 68:34">አ አንጋይ እስራኤልያ ቦላና፤</para>
  <para style="q1" vid="PSA 68:34">አ ዎልቃይካ ሳሉዋና።<verse eid="PSA 68:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35"/>ጾሳይ ባረ ጌሻ ጎልያፐ ቆንጮደ፥ ማላልሴ።</para>
  <para style="q2" vid="PSA 68:35">እስራኤልያ ጾሳይ ባረ አሳዉ ምኖተነ ዎልቃ እሜ።</para>
  <para style="q1" vid="PSA 68:35">መና ጎዳይ ጋላተቶ።<verse eid="PSA 68:35"/></para>
  <chapter eid="PSA 68"/>
  <chapter number="69" style="c" sid="PSA 69"/>
  <para style="s1">ማዱዋ ደማናዉ ሺቆ ዎሳ</para>
  <para style="d">ዛማረቱዋ ካፖ፥ ጪሻ ዋ ግያ ዋጹዋን የጸቴዳ ዳዊታ ማዝሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 69:1"/>አቤት ጾሳዉ፥ ታና አሻ፤</para>
  <para style="q2" vid="PSA 69:1">አያዉ ጎፐ፥ ሃይ ታዉ ቆያ ጋኬዳ።<verse eid="PSA 69:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2"/>ገዲ ኤቂያ ሳአይ ባይና ጫርያን ሙከታድ፤</para>
  <para style="q2" vid="PSA 69:2">ጪሞ ሃ ግዶ ገላድ፤</para>
  <para style="q2" vid="PSA 69:2">ሃ ዙሉ ታ ቦላ ባና ሀኔ።<verse eid="PSA 69:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3"/>ማዶ ዋሳደ ዳቡራይ፤</para>
  <para style="q2" vid="PSA 69:3">ታ ኮቶኒካ መሌዳ።</para>
  <para style="q1" vid="PSA 69:3">ታ ጾሳይ አሌ ጋደ ጼልሽን፥</para>
  <para style="q2" vid="PSA 69:3">ታ አይፊ ጋልጄዳ።<verse eid="PSA 69:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4"/>ታና ጮ እጽያዋንቱ፥</para>
  <para style="q2" vid="PSA 69:4">ታ ሁጲያ ብናናፐ ዳራ።<note caller="-" style="x"><char style="xo" closed="false">69:4 </char><char style="xt" closed="false"><ref loc="PSA 35:19">ማዝ. 35:19</ref>፤ <ref loc="JHN 15:25">ዮሃ. 15:25</ref></char></note></para>
  <para style="q1" vid="PSA 69:4">ዎርዱዋን ታና ሞርክያዋንቱነ፥</para>
  <para style="q2" vid="PSA 69:4">ይሳናዉ ኮይያዋንቱ ዳሬድኖ።</para>
  <para style="q1" vid="PSA 69:4">ታን ዎልቃን አካቤና ሚሻ ታና ጭግሲኖ።<verse eid="PSA 69:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5"/>አቤት ጾሳዉ፥ ታ ባይዙዋ ኤያተ ኔን ኤራሳ፤</para>
  <para style="q2" vid="PSA 69:5">ታን ኦዳ ናጋራይ ኔፐ ቆሰተና።<verse eid="PSA 69:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6"/>አቤት ጎዳዉ፥ ኡባፐ ዎልቃማ መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 69:6">ኔና ህዶታን ናግያዋንቱ፥</para>
  <para style="q2" vid="PSA 69:6">ታ ጋሱዋን ዬላቶፕኖ።</para>
  <para style="q2" vid="PSA 69:6">አቤት እስራኤልያ ጾሳዉ፥ ኔኮ ሺቅያዋንቱ</para>
  <para style="q2" vid="PSA 69:6">ታ ጋሱዋን ካዉሾፕኖ።<verse eid="PSA 69:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7"/>ታን ቦርያ ዳንዳዬዳዌነ</para>
  <para style="q2" vid="PSA 69:7">ታ ሶምኢ ዬላ ማዬዳዌ ነ ድራሳ።<verse eid="PSA 69:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8"/>ታን ታ እሻቶ እማ፥</para>
  <para style="q2" vid="PSA 69:8">ቃይ ታ አት ናናቶ አላጋ ግዳድ።<verse eid="PSA 69:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9"/>ታን ነ ጎልያዉ ሴለትያ ሴላይ፥</para>
  <para style="q2" vid="PSA 69:9">ታና ታማዳን ጉዴ፤<note caller="-" style="x"><char style="xo" closed="false">69:9 </char><char style="xt" closed="false"><ref loc="JHN 2:17">ዮሃ. 2:17</ref>፤ <ref loc="ROM 15:3">ሮመ 15:3</ref></char></note></para>
  <para style="q2" vid="PSA 69:9">ኔና ቦርያዋንቱ ቦሪ ታ ቦላ ዎዳ።<verse eid="PSA 69:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10"/>ታን ጾማደ፥ ታ ሁጲያ ካዉሼዳዌ፥</para>
  <para style="q2" vid="PSA 69:10">ታዉ ቅሊጩዋ ግዴዳ።<verse eid="PSA 69:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11"/>ታን ካዩዋ ማዩዋ ማዬዳ ዎደ፥</para>
  <para style="q2" vid="PSA 69:11">ኡንቱንቶ ቶሳዉ ግዳድ።<verse eid="PSA 69:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12"/>ካታማ ፐንግያን ኡትያዋንቱ ታና ቅሊጪኖ፤</para>
  <para style="q2" vid="PSA 69:12">ማትያዋንቱ ታባ የ ከሲኖ።<verse eid="PSA 69:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13"/>ሽን አቤት መና ጎዳዉ፥ ታና ግዶፐ፥</para>
  <para style="q2" vid="PSA 69:13">ታን ኔና ዎሳይ።</para>
  <para style="q1" vid="PSA 69:13">አቤት ጾሳዉ፥ ነ ዶስያ ዎድያን፥</para>
  <para style="q2" vid="PSA 69:13">አገና ነ ሲቁዋ ዳሩዋን፥</para>
  <para style="q2" vid="PSA 69:13">ኔን አሻና ጌዳዋዳን ታዉ ዛሩዋ እማ።<verse eid="PSA 69:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14"/>ጫርያን ሙከተናዳን ታና አሻ።</para>
  <para style="q2" vid="PSA 69:14">ታና እጽያዋንቱፐ፥</para>
  <para style="q2" vid="PSA 69:14">ጪሞ ሃቱዋፐ ኔን ከሳ አካ።<verse eid="PSA 69:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15"/>ሃ ድኡዋን ታና አፍሶፓ፤</para>
  <para style="q2" vid="PSA 69:15">ዎይ ጪሞ ኦላን ታና ምትሶፓ፤</para>
  <para style="q2" vid="PSA 69:15">ዎይ ዱፉዋ ዶና ታ ቦላ ጎርድሶፓ።<verse eid="PSA 69:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16"/>አቤት መና ጎዳዉ፥ አገና ነ ሲቁዋ ኬካተዳን፥</para>
  <para style="q2" vid="PSA 69:16">ታዉ ዛሩዋ እማ።</para>
  <para style="q1" vid="PSA 69:16">ነ ቃረታ ዳሩዋዳን ታኮ ስማ።<verse eid="PSA 69:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17"/>ታፐ ነ ቆማፐ ነ ሶምኡዋ ገንፓ፤</para>
  <para style="q2" vid="PSA 69:17">ታን ዋየትያ ድራዉ፥ ታዉ ኤለ ዛሩዋ እማ።<verse eid="PSA 69:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18"/>ኔን ታኮ ሺቃ፤ ታና ዎዛ፤</para>
  <para style="q2" vid="PSA 69:18">ታ ሞርከቱዋፐ ታና ላአ ከሳ።<verse eid="PSA 69:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19"/>ታን ቦርያ፥ ዬላነ፥</para>
  <para style="q2" vid="PSA 69:19">ካዉሻ አኬዳዋ ኔን ኤራሳ።</para>
  <para style="q1" vid="PSA 69:19">አያዉ ጎፐ፥ ታ ሞርከቱዋ ኡባ ኔን በኣሳ።<verse eid="PSA 69:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20"/>ቦሪ ታ ዎዛና ፓጸናዳን መን ድራዉ፤</para>
  <para style="q2" vid="PSA 69:20">ህዶታ ቃንጻድ።</para>
  <para style="q1" vid="PSA 69:20">ታዉ ቃረትያዋ ኮያድ።</para>
  <para style="q2" vid="PSA 69:20">ሽን እቱነ ባዋ፤</para>
  <para style="q2" vid="PSA 69:20">ታና ምንያ አሳ ጼላድ፤ ሽን ደማበይከ።<verse eid="PSA 69:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21"/>ታን ኮሻቴዳ ዎደ፥</para>
  <para style="q2" vid="PSA 69:21">ታዉ ጫምያ ቁማ አድኖ።<note caller="-" style="x"><char style="xo" closed="false">69:21 </char><char style="xt" closed="false"><ref loc="MAT 27:48">ማቶሳ 27:48</ref>፤ <ref loc="MRK 15:36">ማር. 15:36</ref>፤ <ref loc="LUK 23:36">ሉቃሳ 23:36</ref>፤ <ref loc="JHN 19:28-29">ዮሃ. 19:28-29</ref></char></note></para>
  <para style="q1" vid="PSA 69:21">ታን ሳመቴዳ ዎደ፥</para>
  <para style="q2" vid="PSA 69:21">ታዉ ጫላ ዎይንያ ኤሳ እሜድኖ።<verse eid="PSA 69:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22"/>ኡንቱንቱ ምያ ሳምፓይ ኡንቱንቶ ጲረ ግዶ።<note caller="-" style="x"><char style="xo" closed="false">69:22-23 </char><char style="xt" closed="false"><ref loc="ROM 11:9-10">ሮመ 11:9-10</ref></char></note></para>
  <para style="q2" vid="PSA 69:22">ኡንቱንቱ ያርሹዋ ያርሺደ፥</para>
  <para style="q2" vid="PSA 69:22">ምያ ግብራይ ኡንቱንቶ ግትያ ግዶ።<verse eid="PSA 69:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23"/>ጼለናዳን ኡንቱንቱ አይፊ ጎዘቶ፤</para>
  <para style="q2" vid="PSA 69:23">ኡንቱንቱ ጋዱዋ ኡባ ገደ ኮኮርሳ።<verse eid="PSA 69:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24"/>ነ ሀንቁዋ ኡንቱንቱ ቦላ ትጋ፤</para>
  <para style="q2" vid="PSA 69:24">ነ ሱሎ ሀንቁ ኡንቱንታ የደርሲደ ኦይቆ።<verse eid="PSA 69:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25"/>ኡንቱንቱ ካምቡ መላ ደኦ፤<note caller="-" style="x"><char style="xo" closed="false">69:25 </char><char style="xt" closed="false"><ref loc="ACT 1:20">ኪታ 1:20</ref></char></note></para>
  <para style="q2" vid="PSA 69:25">ኡንቱንቱ ዱንካንያን ኦንነ ደኦፖ።<verse eid="PSA 69:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26"/>አያዉ ጎፐ፥ ኡንቱንቱ፥</para>
  <para style="q2" vid="PSA 69:26">ኔን ሙሬዳዋንታ የደርሲኖ፤</para>
  <para style="q2" vid="PSA 69:26">ቃይ ኔን ደቼዳዋንቱ ቱጋባ</para>
  <para style="q2" vid="PSA 69:26">ደንደ ሃሳዪኖ።<verse eid="PSA 69:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27"/>ኔን ኡንቱንቱ ናጋራ ቦላ</para>
  <para style="q2" vid="PSA 69:27">ናጋራ ጉጃናዳን አጋ፤</para>
  <para style="q2" vid="PSA 69:27">ነ ማሮተፐ ኡንቱንታ አያይነ ጋኮፖ።<verse eid="PSA 69:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28"/>ኡንቱንቱ ደኡዋ ማጻፋፐ ቁጨትኖ፤<note caller="-" style="x"><char style="xo" closed="false">69:28 </char><char style="xt" closed="false"><ref loc="EXO 32:32">ከሳ 32:32</ref>፤ <ref loc="REV 3:5">ሳፃ 3:5</ref>፤ <ref loc="REV 13:8">13:8</ref>፤ <ref loc="REV 17:8">17:8</ref></char></note></para>
  <para style="q2" vid="PSA 69:28">ጽሎ አሳና ማዝጋበቶፕኖ።<verse eid="PSA 69:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29"/>ታን ሳከታደነ ቱጋታደ ደአይ።</para>
  <para style="q2" vid="PSA 69:29">አቤት ጾሳዉ፥ ታና አሻደ፥</para>
  <para style="q2" vid="PSA 69:29">ሳሮ ሳኣን ዎ።<verse eid="PSA 69:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30"/>ታን ጾሳ ሱን የን ጋላታና፤</para>
  <para style="q2" vid="PSA 69:30">ጋላታ እሙዋን አ ዳርሳና።<verse eid="PSA 69:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31"/>ሄዌካ፥ ቦራ ያርሽያዋፐ</para>
  <para style="q2" vid="PSA 69:31">ዎይ ካጫማ ኮሩማ ያርሽያዋፐ</para>
  <para style="q2" vid="PSA 69:31">አደ፥ መና ጎዳ ናሸቻና።<verse eid="PSA 69:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32"/>ናቀቴዳዋንቱ ታና ጾሳይ፥</para>
  <para style="q2" vid="PSA 69:32">አሼዳዋ በኢደ ናሸትኖ።</para>
  <para style="q1" vid="PSA 69:32">ህንተኖ ጾሳኮ ሺቅያዋንቶ፥</para>
  <para style="q2" vid="PSA 69:32">ህንተ ዎዛናይ ምነቶ።<verse eid="PSA 69:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33"/>አያዉ ጎፐ፥ መና ጎዳይ ህዬሳቱዋ ስሴ፤</para>
  <para style="q2" vid="PSA 69:33">ቃሾ ጎልያን ደእያ ባረ አሳካ ካና።<verse eid="PSA 69:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34"/>ሳሉነ ሳአይ፥ ቃይ አባይነ</para>
  <para style="q2" vid="PSA 69:34">አ ግዶን ዎጽ ቃጽያ ኡባቱ ጾሳ ጋላትኖ።<verse eid="PSA 69:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35"/>አያዉ ጎፐ፥ ጾሳይ ጽዮነ አሻና፤</para>
  <para style="q2" vid="PSA 69:35">ይሁዳ ካታማቱዋ ዛሪደ ኬጻና።</para>
  <para style="q1" vid="PSA 69:35">አ አሳይ ያን ደአናነ ሄ ቢታይ ኡንቱንቱሳ ግዳናዋ።<verse eid="PSA 69:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 69:36"/>አ ቆማቱዋ ናናቱ ሄ ቢታ ላታና፤</para>
  <para style="q2" vid="PSA 69:36">አ ሱን ሲቅያዋንቱ ያን ደአና።<verse eid="PSA 69:36"/></para>
  <chapter eid="PSA 69"/>
  <chapter number="70" style="c" sid="PSA 70"/>
  <para style="s1">ኡንኣ ዋሱዋ</para>
  <para style="d">ዛማረቱዋ ካፖ ዳዊታ ሀሳይስያዋ ማዛሙርያ።</para>
  <para style="r">(<ref loc="PSA 40:13-17">40:13-17</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1"/>አቤት ጾሳዉ፥ ታና አሻናዉ ኤኖ ጋ፤</para>
  <para style="q2" vid="PSA 70:1">አቤት መና ጎዳዉ፥ ታና ማዳናዉ ኤሌላ።<verse eid="PSA 70:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2"/>ታና ዎናዉ ኮይያዋንቱ</para>
  <para style="q2" vid="PSA 70:2">ዬላትኖነ ካዉሽኖ።</para>
  <para style="q1" vid="PSA 70:2">ታን ቆሄታናዋ አሞትያዋንቱ፥</para>
  <para style="q2" vid="PSA 70:2">ካዉሺደ ጉየ ስምኖ።<verse eid="PSA 70:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3"/>ታ ቦላ፥ “አዉ ሀሹ! ሀሹ!”</para>
  <para style="q2" vid="PSA 70:3">ጌዳዋንቱ ጾነቴዳ ድራዉ ዬላትኖ።<verse eid="PSA 70:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4"/>ሽን ኔና ኮይያ ኡባቱ፥</para>
  <para style="q2" vid="PSA 70:4">ኔናን ናሸትኖነ ሀሹ ጊኖ።</para>
  <para style="q1" vid="PSA 70:4">ቃይ ነ አቶተ ዶስያዋንቱ ኡባቱ፥</para>
  <para style="q2" vid="PSA 70:4">“ጾሳይ ግታቶ!” ያግኖ።<verse eid="PSA 70:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5"/>ታን ህዬሳነ መቶታንቻ፤</para>
  <para style="q2" vid="PSA 70:5">አቤት ጾሳዉ፥ ኤለ ታኮ ሃያ።</para>
  <para style="q1" vid="PSA 70:5">ታና ማድያዌነ አሽያዌ ኔና፤</para>
  <para style="q2" vid="PSA 70:5">አቤት መና ጎዳዉ፥ ጋምኦፓ።<verse eid="PSA 70:5"/></para>
  <chapter eid="PSA 70"/>
  <chapter number="71" style="c" sid="PSA 71"/>
  <para style="s1">ጾሳ ማዱዋ ደማናዉ ሺቆ ዎሳ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1"/>አቤት መና ጎዳዉ፥ ታን ኔኮ ባቃታይ፤</para>
  <para style="q2" vid="PSA 71:1">አዉደነ ታና ዬላዮፓ።<verse eid="PSA 71:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2"/>ነ ጽሎተን ታና ዎ አካ፤</para>
  <para style="q2" vid="PSA 71:2">ነ ሀይ ታኮ የጋደ፥ ታና አሻ።<verse eid="PSA 71:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3"/>ኔን ታዉ ኡባ ዎደ ጌምያ ምኖ ዛላነ፥</para>
  <para style="q2" vid="PSA 71:3">ታና አሽያ ምኖ ጌሱዋ ግዳ።</para>
  <para style="q1" vid="PSA 71:3">ታ አታና ማላ ነ አዛዛ።</para>
  <para style="q2" vid="PSA 71:3">ኤ፥ ኔን ታ ዛላነ ታ ጌሱዋ።<verse eid="PSA 71:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4"/>አቤት ታ ጾሳዉ፥ ኢታቱዋ ኩሽያፐ፥</para>
  <para style="q2" vid="PSA 71:4">ኢታ ኦያዋንቱፐነ</para>
  <para style="q2" vid="PSA 71:4">ቃረት ባይና አሳቱዋ ዎልቃፐ ታና አሻ።<verse eid="PSA 71:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5"/>አያዉ ጎፐ፥ አቤት ኡባ ሞድያ መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 71:5">ኔን ታን ህዶታን ናግያዋነ</para>
  <para style="q2" vid="PSA 71:5">ታ ያላጋተ ዎድያፐ ዶማደ፥</para>
  <para style="q2" vid="PSA 71:5">ታን አማነትያዋ ግዳዳ።<verse eid="PSA 71:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6"/>ታን የለትያ ዎድያፐ ዶማደ ኔናን ዘምፓድ፤</para>
  <para style="q2" vid="PSA 71:6">ታ አት ኡሉዋፐ ዎደፐ ዶማደ፥</para>
  <para style="q2" vid="PSA 71:6">ኔን ታና ናጋዳ።</para>
  <para style="q2" vid="PSA 71:6">ኡባ ገደካ ታ ጋላታይ ኔሳ።<verse eid="PSA 71:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7"/>ኔን ታዉ ባቃታ አትያ ዎልቃማ ሳኣ ግዴዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 71:7">ታ ደኡ ዳሮ አሳዉ ሌምሶ ግዴዳ።<verse eid="PSA 71:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8"/>ጋላሳ ኡባን ታ ዶናይ፥</para>
  <para style="q2" vid="PSA 71:8">ነ ጋላታንነ ነ ቦንቹዋን ኩሜዳ።<verse eid="PSA 71:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9"/>ታን ጭሜዳ ዎድያን ታና ኦሎፓ፤</para>
  <para style="q2" vid="PSA 71:9">ታ ዎልቃይ እጼዳ ዎድያን ታና አጎፓ።<verse eid="PSA 71:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10"/>አያዉ ጎፐ፥ ታ ሞርከቱ ታ ቦላ ሃሳዪኖ፥</para>
  <para style="q2" vid="PSA 71:10">ታና ዎናዉ ኮይያዋንቱ</para>
  <para style="q2" vid="PSA 71:10">እትፐ ሺቂደ ማቀቲኖ።<verse eid="PSA 71:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11"/>ኡንቱንቱ፥ “ጾሳይ አ አጌዳ፤</para>
  <para style="q2" vid="PSA 71:11">የደርሲደ አ ኦይቄቶ።</para>
  <para style="q1" vid="PSA 71:11">አያዉ ጎፐ፥ አ አሻናዌ ኦንነ ባዋ” ያጊኖ።<verse eid="PSA 71:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12"/>አቤት ጾሳዉ፥ ታፐ ኔን ሃኮፓ።</para>
  <para style="q1" vid="PSA 71:12">አቤት ታ ጾሳዉ፥ ታና ማዳናዉ ኤሌላ።<verse eid="PSA 71:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13"/>ታና ሞትያዋንቱ ዬላቲደ ይኖ።</para>
  <para style="q2" vid="PSA 71:13">ታና ቆሀናዉ ኮይያዋንቱ፥</para>
  <para style="q2" vid="PSA 71:13">ዬላነ ካዉሻ ማይኖ።<verse eid="PSA 71:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14"/>ሽን ታና ግዶፐ፥</para>
  <para style="q2" vid="PSA 71:14">ኡባ ገደ ኔና ህዶታን ናጋና።</para>
  <para style="q1" vid="PSA 71:14">ታን ጉጃ ጉጃደ ኔና ጋላታና።<verse eid="PSA 71:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15"/>ዎይሰንቶ ልክያ ኤራና ዮፐካ፥</para>
  <para style="q2" vid="PSA 71:15">ታ ዶናይ ጋላሳ ኡባን ነ ጽሎተባነ</para>
  <para style="q2" vid="PSA 71:15">አሽያ ነ ኦሱዋባ ኦዳና።<verse eid="PSA 71:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16"/>ታን ኡባ ሞድያ መና ጎዳ ዎልቃን ያና፤</para>
  <para style="q2" vid="PSA 71:16">ነ ጻላላይ ጽሎ ግድያዋ አዋያና።<verse eid="PSA 71:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17"/>አቤት ጾሳዉ፥ ኔን፥</para>
  <para style="q2" vid="PSA 71:17">ታ ያላጋተፐ ዶማደ ታና ታማርሳዳ።</para>
  <para style="q1" vid="PSA 71:17">ሀእ ጋካናዉ ታን ነ ማላልስያ ኦሱዋባ ኦዳይ።<verse eid="PSA 71:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18"/>አቤት ጾሳዉ፥ ነ ዎልቃነ ነ ምኖተ፥</para>
  <para style="q2" vid="PSA 71:18">ይያ የለታ ኡባዉ ኦዳና ጋካናዉ፥</para>
  <para style="q2" vid="PSA 71:18">ታን ጭማደ ፑሉሞፐካ ታና አጎፓ።<verse eid="PSA 71:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19"/>አቤት ጾሳዉ፥ ነ ጽሎተይ፥</para>
  <para style="q2" vid="PSA 71:19">ቦላ ሳሉዋ ጋኬዳ።</para>
  <para style="q1" vid="PSA 71:19">አቤት ዎልቃማባ ኦዳ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 71:19">ነ ማል ኦንነ ባዋ።<verse eid="PSA 71:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20"/>ኔን ታ ቦላ ዳሮ መቱዋ አሃዳ፤</para>
  <para style="q2" vid="PSA 71:20">ግዶፐነ፥ ኔን ታ ደኡዋ ዛራደ ኦራጽሳና፤</para>
  <para style="q2" vid="PSA 71:20">ኔን ታና ቢታ ግዶ ጪሞ ኦላ ገለናዳን ናጋና።<verse eid="PSA 71:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21"/>ኔን ታ ቦንቹዋ ካሰዋፐ ዳርሳና፤</para>
  <para style="q2" vid="PSA 71:21">ኔን ታና ዛረደካ ምንና።<verse eid="PSA 71:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22"/>አቤት ታ ጾሳዉ፥ ነ ቱማተ ድራዉ፥</para>
  <para style="q2" vid="PSA 71:22">ታን ኔና ዲን ጋላታና።</para>
  <para style="q1" vid="PSA 71:22">አቤት እስራኤልያ ጌሻዉ፥</para>
  <para style="q2" vid="PSA 71:22">ታን ማስንቁዋን ኔና ሳባና።<verse eid="PSA 71:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23"/>ታን ዲጻደ፥ ናሸቻዉ ታ ቃላ ቁ ኦደ የጻና፤</para>
  <para style="q2" vid="PSA 71:23">ኔን ታና አሼዳ ድራዉ፥ ታን ኔና ሳባና።<verse eid="PSA 71:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24"/>ታ እንጻርሳይ ነ ጽሎ ኦሱዋባ ኡባ ጋላስ ኦዳና፤</para>
  <para style="q2" vid="PSA 71:24">አያዉ ጎፐ፥ ታና ቆሀናዉ ኮይያዋንቱ፥</para>
  <para style="q2" vid="PSA 71:24">ዬላቴድኖነ ካዉሼድኖ።<verse eid="PSA 71:24"/></para>
  <chapter eid="PSA 71"/>
  <chapter number="72" style="c" sid="PSA 72"/>
  <para style="s1">ካትያዉ ሺቆ ዎሳ</para>
  <para style="d">ሶሎሞና የ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1"/>አቤት ጾሳዉ፥ ካቲ ነ ሱረተን ፕርዳናዳን፥</para>
  <para style="q2" vid="PSA 72:1">ኔን አ ታማርሳ፤</para>
  <para style="q3" vid="PSA 72:1">ኑ ካትያዉ ነ ጽሎተ እማ።<verse eid="PSA 72:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2"/>ያቶፐ፥ እ ነ አሳዉ ጽሎተን ፕርዶ፤</para>
  <para style="q2" vid="PSA 72:2">ናቀቴዳዋንቶካ ሱረተን ዳናቶ።<verse eid="PSA 72:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3"/>ደረቱ ሳሮተ አይፍያ፥</para>
  <para style="q2" vid="PSA 72:3">ዞዘቱካ ጽሎተ አይፍያ ነ አሳዉ አይፍኖ።<verse eid="PSA 72:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4"/>ሄ ካቲ አሳ ግዶን ናቀቴዳዋንቱ ድራዉ ሞተቶ፤</para>
  <para style="q2" vid="PSA 72:4">ህዬሳቱዋ እ አሾ፤</para>
  <para style="q2" vid="PSA 72:4">ኡቁንያዋንታ እ መንሬ።<verse eid="PSA 72:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5"/>አዋይነ አግናይ ደእያ ዎደ ኡባን፥</para>
  <para style="q2" vid="PSA 72:5">የለታፐ የለታ ጋካናዉ፥ አሳይ አዉ ያዪኖ።<verse eid="PSA 72:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6"/>ካቲ ሾይቃን ቡክያ እራነ</para>
  <para style="q2" vid="PSA 72:6">ጋድያ ካልስያ እራ ማላ ግዶ።<verse eid="PSA 72:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7"/>እ ደእያ ላይ ኡባን ጽሉ ዳሻና፤</para>
  <para style="q2" vid="PSA 72:7">አግናይ ያና ጋካናዉ ሳሮተይ ዳራና።<verse eid="PSA 72:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8"/>አባፐ አባ ጋካናዉ፥</para>
  <para style="q2" vid="PSA 72:8">ቃይ ኤፍራጺሳ ሻፋፐ ሳኣ ጋጻ ጋካናዉ እ ሞዶ።<note caller="-" style="x"><char style="xo" closed="false">72:8 </char><char style="xt" closed="false"><ref loc="ZEC 9:10">ዛካ. 9:10</ref></char></note><verse eid="PSA 72:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9"/>ባዙዋ አሳቱ አዉ ሆክኖ፤</para>
  <para style="q2" vid="PSA 72:9">አ ሞርከቱ ባና ላጭኖ።<verse eid="PSA 72:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10"/>ታርሴሳነ ሃን ዶደቴዳ ቢታ ካተቱ፥</para>
  <para style="q2" vid="PSA 72:10">አዉ ጊራ ጊርኖ።</para>
  <para style="q1" vid="PSA 72:10">ሼባነ ሳባ ካተቱ፥</para>
  <para style="q2" vid="PSA 72:10">አዉ እሞታ አይኖ።<verse eid="PSA 72:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11"/>ካተቱ ኡባይ አዉ ጉልባትኖ፤</para>
  <para style="q2" vid="PSA 72:11">ካዉተቱ ኡባይ አዉ ኪተትኖ።<verse eid="PSA 72:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12"/>አ ጼስያ ህዬሳቱዋ፥ ናቀቴዳዋንታነ</para>
  <para style="q2" vid="PSA 72:12">ማድያዌ ባይናዋንታ እ አሼ።<verse eid="PSA 72:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13"/>ህዬሳቶነ ማንቆቶ እ ቃረቴ፤</para>
  <para style="q2" vid="PSA 72:13">ህዬሳቱዋ ሸምፑዋ አሼ።<verse eid="PSA 72:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14"/>ኡንቱንታ ናቁዋፐነ ማካላፐ እ ዎዜ።</para>
  <para style="q2" vid="PSA 72:14">ኡንቱንቱ ሱይ አ ስንን አልአ።<verse eid="PSA 72:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15"/>ካቲ ሸምፑዋ ጋምኦ፤</para>
  <para style="q2" vid="PSA 72:15">ሼባ ቢታ ዎርቃይ አዉ እመቶ።</para>
  <para style="q1" vid="PSA 72:15">ፓጨናን አዉ ዎሳይ ዎሰቶ፤</para>
  <para style="q2" vid="PSA 72:15">ጋላሳ ኡባን እ አንጀቶ።<verse eid="PSA 72:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16"/>ቢታን ዳሮ ካይ ሞኮ፤</para>
  <para style="q2" vid="PSA 72:16">ደረቱ ካን ካመትኖ።</para>
  <para style="q1" vid="PSA 72:16">ቢታይ ሊባኖሰ ደሪ ሞክያዋዳን ካ ሞኮ፤</para>
  <para style="q2" vid="PSA 72:16">ማታይ ደምባ ኩምያዋዳን አሳይ ካታማ ኩሞ።<verse eid="PSA 72:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17"/>ካትያ ሱንይ መናዉ ደኦ፤</para>
  <para style="q2" vid="PSA 72:17">አዋይ ደኤዳ ኬሻ ኡባን ጼገቲደ፥ ጋምኦ።</para>
  <para style="q1" vid="PSA 72:17">አሳይ ኡባይ አ ባጋና አንጀታና፤</para>
  <para style="q2" vid="PSA 72:17">ካዉተቱ ኡባይ አ፥ “አንጀታ” ያጊደ አንጃና።<verse eid="PSA 72:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18"/>ማላልስያባ ባረካ ኦያ መና ጎዳ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 72:18">እስራኤልያ ጾሳዉ ጋላታይ ግዶ።<verse eid="PSA 72:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19"/>አ ቦንቾ ሱንይ መናዉ ጋላተቶ፤</para>
  <para style="q2" vid="PSA 72:19">አ ቦንቹ ሳኣ ኡባ ኩሞ።</para>
  <para style="q1" vid="PSA 72:19">አመንእ። አመንእ።<verse eid="PSA 72:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20"/>እሰይ ናኣ ዳዊታ ዎሳይ ሀዋን ፖለቴዳ።<verse eid="PSA 72:20"/></para>
  <chapter eid="PSA 72"/>
  <chapter number="73" style="c" sid="PSA 73"/>
  <para style="ms">ሄዘን ማጻፋ</para>
  <para style="mr">(<ref loc="PSA 73-89">73—89</ref>)</para>
  <para style="s1">ጽሎ ፕርዳ ጾኑዋ</para>
  <para style="d">አሳፋ የ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1"/>ጾሳይ እስራኤልያዉ ቱሙዋፐ ሎአ፤</para>
  <para style="q2" vid="PSA 73:1">ዎዛና ጌሻቶ እ ኬካ።<verse eid="PSA 73:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2"/>ሽን ታና ግዶፐ፥ ታ ገዲ፥</para>
  <para style="q2" vid="PSA 73:2">በታናዉ ጉ አቴዳ፤</para>
  <para style="q2" vid="PSA 73:2">ታ ገዲ ሀልጻናዉ ማቴዳ።<verse eid="PSA 73:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3"/>አያዉ ጎፐ፥ ኢታ አሳቶ ሳሮተይ ደእያዋ በኣደ፥</para>
  <para style="q2" vid="PSA 73:3">ሄ ኦቶራንቻቱዋ ዱረተን ታን ቃናታድ።<verse eid="PSA 73:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4"/>ኡንቱንቶ ቱግ ባዋ።</para>
  <para style="q2" vid="PSA 73:4">ኡንቱንቱ ቦላይ ፓጻነ ምና።<verse eid="PSA 73:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5"/>ኡንቱንቱ ሀራ አሳይ ቱጋትያዋዳን ቱጋትክኖ፤</para>
  <para style="q2" vid="PSA 73:5">ኡንቱንቱ ሀራ አሳዋዳን መቱዋን ሾጨትበይክኖ።<verse eid="PSA 73:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6"/>ሄዋ ድራዉ፥ ኡንቱንቱ ኦቶሩዋ፥</para>
  <para style="q2" vid="PSA 73:6">አሌቁዋዳን ቆያን አኖ፤</para>
  <para style="q2" vid="PSA 73:6">ማካላ አፍላዳን ማዪኖ።<verse eid="PSA 73:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7"/>ኡንቱንቱ ዎዛናይ ኢታባ ፑልቴ።</para>
  <para style="q2" vid="PSA 73:7">ኡንቱንቱ ቆፋይ ኢታ ሀልቹዋ ኩሜዳ።<verse eid="PSA 73:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8"/>ኡንቱንቱ ቅሊጪኖነ ኢታባ ሃሳዪኖ፤</para>
  <para style="q2" vid="PSA 73:8">ኡንቱንቱ ባረንቱ ኦቶሩዋን፥</para>
  <para style="q2" vid="PSA 73:8">ሀራቱዋ ኡንኤናዉ ናሲኖ።<verse eid="PSA 73:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9"/>ኡንቱንቱ ሳሉዋን ደእያ ጾሳ፥</para>
  <para style="q2" vid="PSA 73:9">ባረንቱ ዶናን ጫሺኖ።</para>
  <para style="q1" vid="PSA 73:9">ሳኣን ደእያ አሳ ቦላካ፥</para>
  <para style="q2" vid="PSA 73:9">ባረንቱ እንጻርሳን ኦቶሩዋ ሃሳዪኖ።<verse eid="PSA 73:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10"/>ሀራይ አቶ፥ ጾሳ አሳይካ ኡንቱንቱኮ ስማና፤</para>
  <para style="q2" vid="PSA 73:10">ኡንቱንቱ ኦድያዋካ ኤለ አማናና።<verse eid="PSA 73:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11"/>ኡንቱንቱ፥ “ጾሳይ ኑባ አይነ ኤረና፤</para>
  <para style="q1" vid="PSA 73:11">ኡባፐ ቂያ ጾሳይ አይነ በኤና” ያጊኖ።<verse eid="PSA 73:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12"/>ስም ኢታቱ ሀዋ ማላ፤</para>
  <para style="q2" vid="PSA 73:12">ኡንቱንቱ ኡባ ገደካ እንጀትና ደኢኖ፤</para>
  <para style="q2" vid="PSA 73:12">ኡንቱንቱ ጉጅ ጉጅ ዱረቲኖ።<verse eid="PSA 73:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13"/>ያቶፐ፥ ታን ታ ዎዛና ጌሻ ኦዳዌነ</para>
  <para style="q2" vid="PSA 73:13">ታን ታ ጽሎተ በሳናዉ፥</para>
  <para style="q2" vid="PSA 73:13">ታ ኩሽያ ሜጨቴዳዌ ቱሙዋፐ መላ።<verse eid="PSA 73:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14"/>ጋላሳ ኩመንን ታን መቱዋን ሾጨታድ፤</para>
  <para style="q2" vid="PSA 73:14">ዎንታን ዎንታን ሙረታድ።<verse eid="PSA 73:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15"/>ታን ኢታቱዋዳን፥ ኡንቱንቱ ግያዋ ጌደንቶ፥</para>
  <para style="q2" vid="PSA 73:15">ታን ነ አሳዉ አማነተናዋ ግዳና።<verse eid="PSA 73:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16"/>ታን ሀ ኡባ የዉዋ ኤራናዉ ቆፕያ ዎደ፥</para>
  <para style="q2" vid="PSA 73:16">ታዉ ኤረተና ዴጾባ ግዴዳ።<verse eid="PSA 73:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17"/>ሽን ታን ጾሳ ጌሻ ሳኣ ገሌዳ ዎደ፥</para>
  <para style="q2" vid="PSA 73:17">ኢታቱዋ ዉርሰ ካጫ አኬካድ።<verse eid="PSA 73:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18"/>ኡንቱንታ ኔን ቱሙዋፐ ሀልጽያ ሳኣን ኡትሳሳ፤</para>
  <para style="q2" vid="PSA 73:18">ኔን ኡንቱንታ ኩንድሳሳነ ባይዛሳ።<verse eid="PSA 73:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19"/>ኡንቱንቱ አኬከናን ዬድኖ፤</para>
  <para style="q2" vid="PSA 73:19">ዳጋማን እቱ አተናን ሙለ ዉሬድኖ።<verse eid="PSA 73:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20"/>እት አሳይ ቤጎትያ ዎደ፥</para>
  <para style="q2" vid="PSA 73:20">እ አኩሙዋን በኤዳባይ ዶገትያዋዳን፥</para>
  <para style="q2" vid="PSA 73:20">አቤት ጎዳዉ፥ ኔን ደንድያ ዎደ፥</para>
  <para style="q2" vid="PSA 73:20">ኡንቱንቱ ዶገታና።<verse eid="PSA 73:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21"/>ታን ይሎቴዳ ዎደነ</para>
  <para style="q2" vid="PSA 73:21">ታ ዎዛናን ሴለቴዳ ዎደ፥<verse eid="PSA 73:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="PSA 73:22"/>አይነ አኬከናን ዶንጭላድ፤</para>
  <para style="q2" vid="PSA 73:22">ታን ነ ስንን ሚዛ ማላ ግዳድ።<verse eid="PSA 73:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23"/>ሽን ታን ኡባ ገደካ ኔናና ደአይ፤</para>
  <para style="q2" vid="PSA 73:23">ታ ኡሸቻ ኩሽያ ኔን ኦይቃዳ።<verse eid="PSA 73:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24"/>ነ ዞርያን ታና ካለሳ፤</para>
  <para style="q2" vid="PSA 73:24">ሄዋፐ ጉይያን ኔን ታና ቦንቾ አፋና።<verse eid="PSA 73:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25"/>ታዉ ሳሉዋን ኔፐ አትና፥</para>
  <para style="q2" vid="PSA 73:25">ሀራይ ኦን ደኢ?</para>
  <para style="q1" vid="PSA 73:25">ታን ኔፐ አትና፥</para>
  <para style="q2" vid="PSA 73:25">ሳኣን ሀራባ አያነ አሞትከ።<verse eid="PSA 73:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26"/>ታ ዎልቃይነ ታ ዎዛናይ ዳቡራናዉ ዳንዳዬ፤</para>
  <para style="q2" vid="PSA 73:26">ሽን ጾሳይ ታ ዎዛና ምንስያዋነ፥</para>
  <para style="q2" vid="PSA 73:26">መናዉ ታና ጋኬዳ ሳማ።<verse eid="PSA 73:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27"/>ኔፐ ሃክያዋንቱ ያና፤</para>
  <para style="q2" vid="PSA 73:27">ኔና አማነተናዋንታ ኡባ ኔን ዉርሳና።<verse eid="PSA 73:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28"/>ሽን ታና ግዶፐ፥</para>
  <para style="q2" vid="PSA 73:28">ታን ጾሳ ማታን ደእያዌ ታዉ ሎአ።</para>
  <para style="q1" vid="PSA 73:28">ታን ኡባ ሞድያ መና ጎዳ፥</para>
  <para style="q2" vid="PSA 73:28">ታዉ ባቃታ አትያ ሳኣ ኦድ።</para>
  <para style="q1" vid="PSA 73:28">ሄዋ ድራዉ፥ አ ኦሱዋ ኡባ ታን ኦዳና።<verse eid="PSA 73:28"/></para>
  <chapter eid="PSA 73"/>
  <chapter number="74" style="c" sid="PSA 74"/>
  <para style="s1">ጋዲ ላአ ከሳናዳን ሺቆ ዎሳ</para>
  <para style="d">አሳፍ አኬካን ጻፌዳ ግንጹዋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 74:1"/>አቤት ጾሳዉ፥ ኔን ኑና መናዉ አያዉ አጋዲ?</para>
  <para style="q2" vid="PSA 74:1">ነ ሀንቁ ነ ቆሩዋን ደእያ ዶርሳቱዋ ቦላ፥</para>
  <para style="q3" vid="PSA 74:1">አያዉ ሱሌዴ?<verse eid="PSA 74:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2"/>ኔን በን ዶሬዳ አሳ፥ ኔን</para>
  <para style="q2" vid="PSA 74:2">ነዉ ቡዞ ኦደ ዎዜዳ ዛራቱዋ ሀሳያ።</para>
  <para style="q1" vid="PSA 74:2">ኔን ደኤዳ ጽዮነ ደርያ ቆፓ።<verse eid="PSA 74:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3"/>አነ ነ ጌሻ ጎሊ ኮለቴዳ ሳኣ ያደ ጼላ።</para>
  <para style="q2" vid="PSA 74:3">ሞርከቱ አን ደእያባ ኡባ ይሴድኖ።<verse eid="PSA 74:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4"/>ነ ሞርከቱ ነ ጌሻ ጎልያ ግዶን፥</para>
  <para style="q2" vid="PSA 74:4">“ኑን ጾኔዶ” ያጊደ ገሬሬድኖ።</para>
  <para style="q1" vid="PSA 74:4">ጾኑዋ ማላታ ያጊደ፥ ባረንቱ ባንድራ ኤሴድኖ።<verse eid="PSA 74:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5"/>ኡንቱንቱ ም ቃንጻናዉ ባረንቱ ካልታ፥</para>
  <para style="q2" vid="PSA 74:5">ቁ ኦደ፥ ኤቄዳ አሳቱዋዳን ሀኔድኖ።<verse eid="PSA 74:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6"/>ኡንቱንቱ ማሰቴዳ ሳንቃ ኡባ፥</para>
  <para style="q2" vid="PSA 74:6">ባረንቱ ካልታንነ ማዶሻንነ መን የጌድኖ።<verse eid="PSA 74:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7"/>ጌሻ ጎልያ ታማን ጹጊደ ይሴድኖ፤</para>
  <para style="q2" vid="PSA 74:7">ነዉ ጎይንያ ሳኣ ቱንሴድኖ።<verse eid="PSA 74:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8"/>ባረንቱ ዎዛናን፥ “ኡንቱንታ ኑን፥</para>
  <para style="q2" vid="PSA 74:8">ኡባና ይሳና” ያጊደ ቆፔድኖ።</para>
  <para style="q1" vid="PSA 74:8">ቢታን አሳይ ጾሳዉ ጎይንያ ሳኣ ኡባ ታማን ጹጌድኖ።<verse eid="PSA 74:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9"/>ሄ ዎደ ማላይ ኑዉ እመተናን እጼዳ፤</para>
  <para style="q2" vid="PSA 74:9">ትምቢትያ ኦድያዌ እቱነ ባዋ።</para>
  <para style="q1" vid="PSA 74:9">ሀዋዳን ሀኒደ፥ ዎይሳ ዎድያ ደአነንቶ፥</para>
  <para style="q2" vid="PSA 74:9">ኤርያ አሳይ ኑ ግዶን እቱነ ባዋ።<verse eid="PSA 74:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10"/>አቤት ጾሳዉ፥ ነ ሞርከቱ፥</para>
  <para style="q2" vid="PSA 74:10">ዎይሳ ዎድያ ነ ቦላ ቅሊጫኔ?</para>
  <para style="q1" vid="PSA 74:10">ኡንቱንቱ ነ ሱን መናዉ ቦራኔ?<verse eid="PSA 74:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11"/>ነ ኩሽያ ሺሻ አካደ አያዉ ጋምአይ?</para>
  <para style="q2" vid="PSA 74:11">ነ ኡሸቻ ኩሽያ ነ ቁማዩዋፐ ከሳደ ኡንቱንታ ይሳ።<verse eid="PSA 74:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12"/>ግዶፐነ፥ አቤት ጾሳዉ፥</para>
  <para style="q2" vid="PSA 74:12">ኔን በንፐካ ታ ካትያ፤</para>
  <para style="q2" vid="PSA 74:12">ኔን ቢታ ቦላ አቶተ አሃዳ።<verse eid="PSA 74:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13"/>ነ ዎልቃማ ዎልቃን ኔን አባ ሻካዳ፤</para>
  <para style="q2" vid="PSA 74:13">አ ግዶን ደእያ ዳዊያ ሁጰቱዋ ኔን ቆጻዳ።<verse eid="PSA 74:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14"/>ሌዋታና ግያ ዳዊያ ሁጰቱዋ ቆጻደ፥</para>
  <para style="q2" vid="PSA 74:14">አ አሹዋ ባዙዋን ደእያ መታቶ፥</para>
  <para style="q2" vid="PSA 74:14">ቁማ ኦደ እሜዳዌ ኔና።<note caller="-" style="x"><char style="xo" closed="false">74:14 </char><char style="xt" closed="false"><ref loc="JOB 41:1">ኢዮባ 41:1</ref>፤ <ref loc="PSA 104:26">ማዝ. 104:26</ref>፤ <ref loc="ISA 27:1">ኢሳ. 27:1</ref></char></note><verse eid="PSA 74:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15"/>ኔን ፑልቶቱዋ ዶያ የዳዳ፤</para>
  <para style="q2" vid="PSA 74:15">ኡባ ገደ ጎግያ ሻፋቱዋ ቃይ መልሳዳ።<verse eid="PSA 74:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16"/>ጋላሳይ ነዋ፤ ቃማይካ ነዋ፤</para>
  <para style="q2" vid="PSA 74:16">ቃይ አዋነ አግና ኡንቱንቱ ሳኣን ዎዳዌ ኔና።<verse eid="PSA 74:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17"/>ቢታዉ ዛዋ ዎዳዌ፥</para>
  <para style="q2" vid="PSA 74:17">ባልጉዋነ ቦንያ መዳዌ ኔና።<verse eid="PSA 74:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18"/>ሽን አቤት መና ጎዳዉ፥ ነ ሞርከቱ፥</para>
  <para style="q2" vid="PSA 74:18">ኔና ዎት ቅሊጬድኖንቶ፥</para>
  <para style="q2" vid="PSA 74:18">ቦዛ አሳቱ ነ ሱን ዎት ቦሬድኖንቶ ሀሳያ።<verse eid="PSA 74:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19"/>ነዉ ሞደትያዋንቱ ሸምፑዋ</para>
  <para style="q2" vid="PSA 74:19">ኢታ ሞርከቶ አደ እሞፓ።</para>
  <para style="q1" vid="PSA 74:19">መቶታንቻቱዋ መናዉ ዶጎፓ።<verse eid="PSA 74:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20"/>ኑ ቢታን ደእያ ማ ሳአይ ኡባይ፥</para>
  <para style="q2" vid="PSA 74:20">ማካላንቻቱዋን ኩሜዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 74:20">ኔን ኑዉ ጫቄዳ ጫቁዋ ቆፓ።<verse eid="PSA 74:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21"/>ናቀቴዳዋንታ ዬላዮፓ፤</para>
  <para style="q2" vid="PSA 74:21">ህዬሳቱነ መቶታንቻቱ ነ ሱን ጋላትኖ።<verse eid="PSA 74:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22"/>አቤት ጾሳዉ፥ ደንዳ፤ ነ የዉዋ ሞተታ።</para>
  <para style="q2" vid="PSA 74:22">ገዞ አሳቱ ጋላሳ ኡባን፥</para>
  <para style="q2" vid="PSA 74:22">ነ ቦላ ቅሊጬዳዋ ሀሳያ።<verse eid="PSA 74:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23"/>ነ ሞርከቱ ነ ቦላ ዋስያ ዋሱዋነ</para>
  <para style="q2" vid="PSA 74:23">ኔና እጽያዋንቱ፥</para>
  <para style="q2" vid="PSA 74:23">ፓጭ ባይናን ቅሊጭያ ቅሊጩዋ ዶጎፓ።<verse eid="PSA 74:23"/></para>
  <chapter eid="PSA 74"/>
  <chapter number="75" style="c" sid="PSA 75"/>
  <para style="s1">ጾሳይ ፕርድያዋ ግዱሳ</para>
  <para style="d">ዛማረቱዋ ካፖ አሳፍ። “ይሶፓ” ጌተትያ ዲ ዋን የጼዳ የ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 75:1"/>ነዉ ጋላታ እሜቶ፤ አቤት ጾሳዉ፥ ኔና ጋላቴቶ፤</para>
  <para style="q2" vid="PSA 75:1">“ነ ሱንይ ዎጋ” ጊደ አዋዬቶነ፥</para>
  <para style="q3" vid="PSA 75:1">ማላልስያ ነ ኦሱዋ ኡባ ኦዴቶ።<verse eid="PSA 75:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2"/>ጾሳይ፥ “ዶራደ ኬሬዳ ጋላስ፥</para>
  <para style="q2" vid="PSA 75:2">ሱረ ፕርዳ ፕርዳናዌ ታና።<verse eid="PSA 75:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3"/>ሳአይነ አን ደእያዋንቱ ኡባይ ቃጽናካ፥</para>
  <para style="q2" vid="PSA 75:3">አ ቱሳ ምንሳ ኤስያዌ ታና።<verse eid="PSA 75:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4"/>ታን ኦቶራንቻቱዋ፥ ኦቶረቶፕተ ያጋይ፤</para>
  <para style="q2" vid="PSA 75:4">ኢታቱዋካ፥ ህንተ ካጭያ ደንፕተ።<verse eid="PSA 75:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5"/>ህንተ ካጭያ ቂስ በሶፕተ፤</para>
  <para style="q2" vid="PSA 75:5">ዛቱሪደ ሃሳዮፕተ ያጋይ” ያጌ።<verse eid="PSA 75:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6"/>ቦንቹ አዋይ ዶልያሳፐ</para>
  <para style="q2" vid="PSA 75:6">ዎይ ዉልያሳፐ</para>
  <para style="q2" vid="PSA 75:6">ዎይ ባዙዋፐ ዬና።<verse eid="PSA 75:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7"/>ሽን ፕርድያዌ ጾሳ፤</para>
  <para style="q2" vid="PSA 75:7">እ እቱዋ ቦላ ፕርዴ፤</para>
  <para style="q2" vid="PSA 75:7">እቱዋ ሻትን።<verse eid="PSA 75:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8"/>መና ጎዳ ኩሽያን እት ዋንጫይ ደኤ፤</para>
  <para style="q2" vid="PSA 75:8">ሄ ዋንጫይ ጾሳ ሀንቁዋ ዎይንያ ኤሳን ኩም ኡቴዳ።</para>
  <para style="q1" vid="PSA 75:8">እ ሄዋፐ ኡሻ ትግና፥</para>
  <para style="q2" vid="PSA 75:8">ሳኣን ደእያ ኢታ አሳቱ ሄዋ ኡሻና፤</para>
  <para style="q2" vid="PSA 75:8">ኡንቱንቱ ኦርጩዋካ አሸናን ጭንግሲደ ኡሻና።<verse eid="PSA 75:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9"/>ሽን ታን ያቆባ ጾሳባ ኦዳናነ</para>
  <para style="q2" vid="PSA 75:9">መናዉ አ ሳባና።<verse eid="PSA 75:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10"/>እ ኢታ አሳቱዋ ካጭያ ኡባ መንና፥</para>
  <para style="q2" vid="PSA 75:10">ሽን ጽሎቱዋ ካጪ ቁ ቁ ጋና።<verse eid="PSA 75:10"/></para>
  <chapter eid="PSA 75"/>
  <chapter number="76" style="c" sid="PSA 76"/>
  <para style="s1">ጾሳ ጾኑዋ</para>
  <para style="d">ዛማረቱዋ ካፖ ዲ ዋን የጸቴዳ፥ አሳፋ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 76:1"/>ጾሳይ ይሁዳን ኤረቴዳዋ፤</para>
  <para style="q2" vid="PSA 76:1">አ ሱንይ እስራኤልያን ዎልቃማ።<verse eid="PSA 76:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2"/>አ ዱንካኒ ሳሌማና፤</para>
  <para style="q2" vid="PSA 76:2">እ ደኢያሳይ ጽዮነና።<verse eid="PSA 76:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3"/>እ፥ ሄዋን ጾንገትያ፥</para>
  <para style="q2" vid="PSA 76:3">ሞርከቱዋ ዎንዳፍያ ጩብያ፥ ጎንዳልያ፥ ማሻነ</para>
  <para style="q2" vid="PSA 76:3">ሀራ ኦላ ሚሻቱዋ መንሬዳ።<verse eid="PSA 76:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4"/>አቤት ጾሳዉ፥ ነ ቦንቹ አይ ኬሻ ግቴ!</para>
  <para style="q2" vid="PSA 76:4">ኔን ነ ሞርከቱዋ ጾናደ፥</para>
  <para style="q2" vid="PSA 76:4">ደርያፐ ስምያ ዎደ፥</para>
  <para style="q2" vid="PSA 76:4">ነ አንጋይ አይባ ያሽያዌ!<verse eid="PSA 76:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5"/>ጎባ ቶራንቻቱ፥</para>
  <para style="q2" vid="PSA 76:5">ባረንቶ ደእያዋ ኡባ ቦንቀት ክቼድኖ።</para>
  <para style="q1" vid="PSA 76:5">ሀእ ስም ኡንቱንቱ፥</para>
  <para style="q2" vid="PSA 76:5">ዎልቃማ ገምእሹዋ ገምእሼድኖ፤</para>
  <para style="q2" vid="PSA 76:5">ኡንቱንቱፐ እቱነ ባረ ኩሽያ ደንቤና።<verse eid="PSA 76:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6"/>አቤት ያቆባ ጾሳዉ፥ ኔን ሴሬዳ ዎደ፥</para>
  <para style="q2" vid="PSA 76:6">ፓራ አሳቱነ ፓራቱ ኩንዶ ሳን አቴድኖ።<verse eid="PSA 76:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7"/>ሽን አቤት ጾሳዉ፥ ኔን ያሻሳ!</para>
  <para style="q2" vid="PSA 76:7">ነ ሀንቁ ሱሌዳ ዎደ፥</para>
  <para style="q2" vid="PSA 76:7">ነ ስንን ኦኔ ኤቃናዌ?<verse eid="PSA 76:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8"/>ኔን ፕርዳ ሳሉዋፐ ስሴዳ ዎደ፥</para>
  <para style="q2" vid="PSA 76:8">ሳኣን ደእያ አሳይ ያዪደ፥ ጮኡ ጌዳ።<verse eid="PSA 76:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9"/>ኔን ሳኣን ቆሄቴዳዋንታ አሻናዉ፥</para>
  <para style="q2" vid="PSA 76:9">ፕርዳዉ ደንዴዳ ዎደ፥ ሄዌ ሀኔዳ።<verse eid="PSA 76:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10"/>አሳ ሀንቁ ዳሬዳ ኬሻ ኔን ጋላተታሳ።</para>
  <para style="q2" vid="PSA 76:10">ኦላፐ አቴዳ አሳቱ ኡባይ፥</para>
  <para style="q2" vid="PSA 76:10">ነ ባላ ጋላሳቱዋ ቦንቻና።<verse eid="PSA 76:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11"/>መና ጎዳዉ፥ ህንተ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 76:11">ሺቀትተ፥ ሄዋካ ጋተ።</para>
  <para style="q1" vid="PSA 76:11">ህንተኖ ሾሮ ካዉተቶ፥</para>
  <para style="q2" vid="PSA 76:11">ያየታናዉ በስያዎ እሞታ አህተ።<verse eid="PSA 76:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12"/>እ ካፖቱዋ ኦቶሩዋ ካዉሼ፤</para>
  <para style="q2" vid="PSA 76:12">ዎልቃማ ካተቱዋካ እ ያሽሴ።<verse eid="PSA 76:12"/></para>
  <chapter eid="PSA 76"/>
  <chapter number="77" style="c" sid="PSA 77"/>
  <para style="s1">ምንዋ ዎሳ</para>
  <para style="d">አሳፍ ዛማረቱዋ ካፖ ጁዱቶ የጼዳ፥ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1"/>ታን ጾሳዉ ማጋናይ፤</para>
  <para style="q2" vid="PSA 77:1">ታና ስሶ ጋደ ታን ጾሳ ዎሳይ።<verse eid="PSA 77:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2"/>ታን ታ መቱዋ ጋላስ ጎዳ ኮያይ።</para>
  <para style="q2" vid="PSA 77:2">ቃማን ታን ሸምፐናን ታ ኩሸቱዋ አኮ ምጫይ፤</para>
  <para style="q2" vid="PSA 77:2">ግዶፐነ፥ ታን ምነታናዉ ዳንዳይከ።<verse eid="PSA 77:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3"/>ታን ጾሳባ ቆፕያ ዎደ፥ ኦላይ፤</para>
  <para style="q2" vid="PSA 77:3">ታን አባ ዩሻ ቆፕያ ዎደ፥</para>
  <para style="q2" vid="PSA 77:3">ታ ሸምፑ ዳቡሬ።<verse eid="PSA 77:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4"/>ኔን ቃማ ኡባ ታና ገምእሹዋ ድጋደ አህሳሳ።</para>
  <para style="q2" vid="PSA 77:4">ታን ሎይ ህርግያ ድራዉ፥</para>
  <para style="q2" vid="PSA 77:4">ሃሳያናዉ ዳንዳይከ።<verse eid="PSA 77:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5"/>ታን አዳ ጋላሳቱዋ ቆፓይ፤</para>
  <para style="q2" vid="PSA 77:5">ካሰ ላይቱዋካ ሀሳያይ።<verse eid="PSA 77:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6"/>ታን ቆፋ ሼካደ አቃይ፤</para>
  <para style="q2" vid="PSA 77:6">ታ ዎዛናይ ዩሽ ቆፕያ ዎደ፥</para>
  <para style="q1" vid="PSA 77:6">ታን ታ ሁጲያ ሀዋዳን ያጋደ ኦቻይ፤<verse eid="PSA 77:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7"/>“ጎዳይ ኑና መናዉ አግ ባሻኔ?</para>
  <para style="q2" vid="PSA 77:7">ዛረደ እ ኑና ኬካ በሰኔ?<verse eid="PSA 77:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8"/>አ ሲቁ አቴዴ?</para>
  <para style="q2" vid="PSA 77:8">እ ጌዳዌ ሀዋፐ ስንናዉ ሳኣን ኦኔ?<verse eid="PSA 77:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9"/>ጾሳይ ማርያዋ ዶጌዴ?</para>
  <para style="q2" vid="PSA 77:9">ባረ ቃረታካ ሀንቁዋን ላሜዴ?” ያጋደ ኦቻይ።<verse eid="PSA 77:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10"/>ቃይካ ታን፥ “ታና ቆሄዳዌ፥</para>
  <para style="q2" vid="PSA 77:10">ኡባፐ ቂያ ጾሳ ኡሸቻ ኩሺ፥</para>
  <para style="q2" vid="PSA 77:10">ካሰፐ ማድያ ማዱዋ አጌዳዋ” ያጋይ።<verse eid="PSA 77:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11"/>መና ጎዳዉ፥ ነ ኦሶቱዋ ታን ቆፓና።</para>
  <para style="q2" vid="PSA 77:11">ኤ፤ ኔን በን ዎደ፥</para>
  <para style="q2" vid="PSA 77:11">ኦዳ ማላልስያባቱዋ ኡባ ታን ሀሳያና።<verse eid="PSA 77:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12"/>ነ ኦዳዋ ኡባ፥</para>
  <para style="q2" vid="PSA 77:12">ታን ዛራ ዛራደ ቆፓና፤</para>
  <para style="q2" vid="PSA 77:12">ነ ዎልቃማ ኦሶቱዋ ኡባ ታን ዩሻ ቆፓና።<verse eid="PSA 77:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13"/>አቤት ጾሳዉ፥ ነ ኦጊ ጌሻ፤</para>
  <para style="q2" vid="PSA 77:13">አይ ጾስነ ኑ ጾሳ ማላ ዎልቃማ ግደና።<verse eid="PSA 77:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14"/>ኔን ማላልስያባ ኦያ ጾሳ።</para>
  <para style="q2" vid="PSA 77:14">አሳ ግዶን ነ ዎልቃ ቆንጭስያዋ።<verse eid="PSA 77:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15"/>ነ አሳ፥ ያቆባነ ዮሴፎ ዘረቱዋ፥</para>
  <para style="q2" vid="PSA 77:15">ነ ቀስያን ዎዛዳ።<verse eid="PSA 77:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16"/>አቤት ጾሳዉ፥ ሃቱ ኔና በኤድኖ፤</para>
  <para style="q2" vid="PSA 77:16">ሃቱ ኔና በኢደ ያዬድኖ።</para>
  <para style="q1" vid="PSA 77:16">አባ ጪማቱካ ኮኮሬድኖ።<verse eid="PSA 77:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17"/>ሻረቱ እራ ዱገ ዛሪደ ትጌድኖ፤</para>
  <para style="q2" vid="PSA 77:17">ጉጉንይ ሳሉዋን ጉሜዳ።</para>
  <para style="q1" vid="PSA 77:17">ነ ዋልቃንይ ያን ሃን ዋልቃሜዳ።<verse eid="PSA 77:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18"/>ነ ጉጉንይ ጉንይ ጎትያ ግዶን ኮሹሜዳ፤</para>
  <para style="q2" vid="PSA 77:18">ነ ዋልቃን ጶለይ ሳኣ ፖእሴዳ።</para>
  <para style="q1" vid="PSA 77:18">ቢታይካ ጋጅ ጋጂደ ኮኮሬዳ።<verse eid="PSA 77:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19"/>ኔን አባ ግዱዋና ሀመታሳ፤</para>
  <para style="q2" vid="PSA 77:19">ጪሞ አባ ግዱዋና አሳ፤</para>
  <para style="q2" vid="PSA 77:19">ግዶፐነ፥ ነ ገዲ የዳ ሳአይ ቤተና።<verse eid="PSA 77:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20"/>ሙሴነ አሮና ኩሽያን</para>
  <para style="q2" vid="PSA 77:20">ኔን ነ አሳ ዶርሳ ዉድያዳን ካለዳ።<verse eid="PSA 77:20"/></para>
  <chapter eid="PSA 77"/>
  <chapter number="78" style="c" sid="PSA 78"/>
  <para style="s1">ጾሳነ አ አሳ</para>
  <para style="d">አሳፍ አኬካን ጻፌዳ ግንጹዋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1"/>ታ አሳዉ፥ ታን ህንተና ታማርስያዋ ስስተ፤</para>
  <para style="q2" vid="PSA 78:1">ታ ዶናፐ ከስያ ቃላ ሀይዝተ።<verse eid="PSA 78:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2"/>ታን ኡንቱንቶ ሃሳይያ ዎደ፥</para>
  <para style="q2" vid="PSA 78:2">ሌምሱዋን ሃሳያይ፤<note caller="-" style="x"><char style="xo" closed="false">78:2 </char><char style="xt" closed="false"><ref loc="MAT 13:35">ማቶሳ 13:35</ref></char></note></para>
  <para style="q2" vid="PSA 78:2">በኒደፐ ጌሜዳ የዎቱዋ ቆንጭሳና።<verse eid="PSA 78:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3"/>ኑን ስሴዳነ ኤሬዳ የዎቱዋ፥</para>
  <para style="q2" vid="PSA 78:3">ቃይ ኑ አዎቱ ኑዉ ኦዴዳ የዎቱዋ ሃሳያና።<verse eid="PSA 78:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4"/>ሄ የዎቱዋ ኑን ኡንቱንቱ ናናቱዋፐ ቆሶኮ፤</para>
  <para style="q2" vid="PSA 78:4">መና ጎዳዉ በስያ ጋላታ፥</para>
  <para style="q1" vid="PSA 78:4">አ ዎልቃነ ማላልስያ አ ኦሱዋ፥</para>
  <para style="q2" vid="PSA 78:4">ይያ የለታዉካ ኑን ኦዳና።<verse eid="PSA 78:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5"/>እ ያቆባ ዛረቶ አዛዙዋ፥</para>
  <para style="q2" vid="PSA 78:5">እስራኤልያ አሳዉ ህግያ እሜዳ።</para>
  <para style="q1" vid="PSA 78:5">ካሰ ኑ አዎቱ ባረንቱ ናናቱዋ፥</para>
  <para style="q2" vid="PSA 78:5">ሄ ህገቱዋ ታማርሳና ማላ አዛዜዳ።<verse eid="PSA 78:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6"/>ሄዌነ፥ ካልያ የለታይ፥</para>
  <para style="q2" vid="PSA 78:6">ሄ ብሮ የለታና ናናቱ ኤራናዳናነ</para>
  <para style="q2" vid="PSA 78:6">ኡንቱንቱካ ባረንቱ ናናቶ ኦዳናዳና።<verse eid="PSA 78:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7"/>ያትና፥ ሄ ናናቱ ጾሳን አማነታናዳን፤</para>
  <para style="q2" vid="PSA 78:7">እ ኦዳባካ ዶገናዳንነ</para>
  <para style="q1" vid="PSA 78:7">አ አዛዙዋ ናጋናዳና።<verse eid="PSA 78:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8"/>ኡንቱንቱ ካሰ ባረንቱ አዎቱዋዳን ዎዛና ሙመነ</para>
  <para style="q2" vid="PSA 78:8">ማካላንቻ አሳ ግደናዳንነ</para>
  <para style="q1" vid="PSA 78:8">ጾሳን ኤቀናነ አማነተና የለታ ግደናዳና።<verse eid="PSA 78:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9"/>ኤፍሬማ አሳቱ፥ ኦላዉ፥</para>
  <para style="q2" vid="PSA 78:9">ዎንዳፍያና ፖ ጊግሲደ፥</para>
  <para style="q2" vid="PSA 78:9">ኦላ ጋላስ ጉየ ስሜድኖ።<verse eid="PSA 78:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10"/>ኡንቱንቱ ጾሳ ጫቁዋ ናግበይክኖ፤</para>
  <para style="q2" vid="PSA 78:10">አ ህግያዳን ሀመተናን እጼድኖ።<verse eid="PSA 78:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11"/>ኡንቱንቱ እ ኦዳ ዎልቃማ ኦሱዋነ</para>
  <para style="q2" vid="PSA 78:11">ኡንቱንታ እ በሴዳ ማላታ ዶጌድኖ።<verse eid="PSA 78:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12"/>እ ኡንቱንቱ አዎቱዋ ስንን ግብጼ ቢታን፥</para>
  <para style="q2" vid="PSA 78:12">ጾኣነ ደምባን ማላታ ኦዳ።<note caller="-" style="x"><char style="xo" closed="false">78:12 </char><char style="xt" closed="false"><ref loc="EXO 7:8-12:32">ከሳ 7:8—12:32</ref></char></note><verse eid="PSA 78:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13"/>አባ ሻኪደ፥ ግዱዋና ኡንቱንታ ፕንዳ፤<note caller="-" style="x"><char style="xo" closed="false">78:13 </char><char style="xt" closed="false"><ref loc="EXO 14:21-22">ከሳ 14:21-22</ref></char></note></para>
  <para style="q2" vid="PSA 78:13">እ ሃ ሻኪደ፥</para>
  <para style="q2" vid="PSA 78:13">ያነ ሃነ ሻኪደ ጎዳዳን ኤሴዳ።<verse eid="PSA 78:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14"/>እ ኡንቱንታ ጋላስ ሻርያን፥<note caller="-" style="x"><char style="xo" closed="false">78:14 </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">ከሳ 13:21-22</ref></char></note></para>
  <para style="q2" vid="PSA 78:14">ቃማ ታማ ፖኡዋን ካለዳ።<verse eid="PSA 78:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15"/>እ ባዙዋን ዛላ ጳልቂደ፥<note caller="-" style="x"><char style="xo" closed="false">78:15-16 </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">ከሳ 17:1-7</ref>፤ <ref loc="NUM 20:2-13">ፓይ. 20:2-13</ref></char></note></para>
  <para style="q2" vid="PSA 78:15">ጪሙዋፐ ዳሮ ሃ ኡንቱንታ ኡሼዳ።<verse eid="PSA 78:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16"/>ዛላፐ ሃ ፑልትሲደ፥</para>
  <para style="q2" vid="PSA 78:16">ሻፋዳን ዱገ ጎግሴዳ።<verse eid="PSA 78:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17"/>ሽን ኡንቱንቱ አ ቦላ ናጋራ ኦሱዋ ገደ ጉጄድኖ፤</para>
  <para style="q2" vid="PSA 78:17">ኡባፐ ቂያ ጾሳ ቦላ፥</para>
  <para style="q2" vid="PSA 78:17">ባዙዋን ማካሌድኖ።<verse eid="PSA 78:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18"/>ባረንቱ አሞቴዳ ቁማ ኦችያዋን</para>
  <para style="q2" vid="PSA 78:18">ጾሳ ኤሪደ ፓጬድኖ።<note caller="-" style="x"><char style="xo" closed="false">78:18-31 </char><char style="xt" closed="false"><ref loc="EXO 16:2-15">ከሳ 16:2-15</ref>፤ <ref loc="NUM 11:4-23">ፓይ. 11:4-23</ref>፣ <ref loc="NUM 11:31-35">31-35</ref></char></note><verse eid="PSA 78:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19"/>ኡንቱንቱ ጾሳ ቦላ ሀዋዳን ያጊደ ሃሳዬድኖ፤</para>
  <para style="q2" vid="PSA 78:19">“ባዙዋን ጾሳይ ኑዉ ቁማ አናዉ ዳንዳዪ?<verse eid="PSA 78:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20"/>ዛላ ሾጭና፥ ፑልቱ ከሲደ፥</para>
  <para style="q2" vid="PSA 78:20">ሻፋይ ጎጌዳ፤</para>
  <para style="q2" vid="PSA 78:20">ሽን ኡክ እ ኑዉ እማናዉ ዳንዳዪ?</para>
  <para style="q2" vid="PSA 78:20">ዎይ ባረ አሳዉ አሹዋ እማናዉ ዳንዳዪ?” ያጌድኖ።<verse eid="PSA 78:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21"/>መና ጎዳይ ሄዋ ስሴዳ ዎደ፥</para>
  <para style="q2" vid="PSA 78:21">ኡንቱንቱ ቦላ ዳሮ ሀንቀቴዳ።</para>
  <para style="q1" vid="PSA 78:21">ያቆባ ዛራቱዋ ቦላ ታማይ ኤጼዳ፤</para>
  <para style="q2" vid="PSA 78:21">እስራኤልያ ቦላ አ ሀንቁ ዳር ዳር ቤዳ።<verse eid="PSA 78:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22"/>አያዉ ጎፐ፥ ኡንቱንቱ ጾሳን አማንበይክኖ፤</para>
  <para style="q2" vid="PSA 78:22">ዎይ እ አሽያዋን አማነትበይክኖ።<verse eid="PSA 78:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23"/>ግዶፐነ፥ እ ቦላ ሳሉዋ አዛዚደ፥</para>
  <para style="q2" vid="PSA 78:23">ሳሉዋ ፐንግያ ዶዬዳ።<verse eid="PSA 78:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24"/>ኡንቱንቱ ማናዉ፥ ኡንቱንቶ ማና ቡክሴዳ፤<note caller="-" style="x"><char style="xo" closed="false">78:24 </char><char style="xt" closed="false"><ref loc="JHN 6:31">ዮሃ. 6:31</ref></char></note></para>
  <para style="q2" vid="PSA 78:24">ሳሉዋ ቁማ ኡንቱንቶ እሜዳ።<verse eid="PSA 78:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25"/>ኪታንቻቱዋ ኡክ አሳይ ሜዳ፤</para>
  <para style="q2" vid="PSA 78:25">ጾሳይ ኡንቱንቶ ቁማ ዳርሲደ እሜዳ።<verse eid="PSA 78:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26"/>አዋይ ዶልያ ባጋ ጫርኩ ጫርካናዳን ኦዳ፤</para>
  <para style="q2" vid="PSA 78:26">ባረ ዎልቃን ገድሳ ባጋ ጫርኩዋ ደንዳ።<verse eid="PSA 78:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27"/>እ አሳዉ አሹዋ ባና ኬሻ ኪቴዳ፤</para>
  <para style="q2" vid="PSA 78:27">ፓልያ ካፎቱዋ አባ ዶና ሻፍያ ኬሻ ቡክሴዳ።<verse eid="PSA 78:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28"/>ኡንቱንቱ ደእያ ሳን፥</para>
  <para style="q2" vid="PSA 78:28">ዱንካንያ ዩሹዋን ዎድኖ።<verse eid="PSA 78:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29"/>ኡንቱንቱ አሞቴዳዋ ኡንቱንቶ እሜዳ፤</para>
  <para style="q2" vid="PSA 78:29">ኡንቱንቱ ሚደ፥ ባረንቱ ጋንጅያ ኩንድኖ።<verse eid="PSA 78:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30"/>ሽን ኡንቱንቱ ባረንቱ አሞቴዳ አሹዋ ካለናን ደእሺን፥</para>
  <para style="q2" vid="PSA 78:30">አሹ ኡንቱንቶ ብሮ ዶናን ደእሺን፥<verse eid="PSA 78:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31"/>ጾሳ ሀንቁ ኡንቱንቱ ቦላ ዎዳ፤</para>
  <para style="q2" vid="PSA 78:31">ኡንቱንቱ ግዶፐ ምኖ አሳቱዋነ</para>
  <para style="q2" vid="PSA 78:31">እስራኤልያፐ ያላጋ አሳቱዋ ዎዳ።<verse eid="PSA 78:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32"/>ሀዌ ኡባይ ሀንናካ፥</para>
  <para style="q2" vid="PSA 78:32">ኡንቱንቱ ናጋራ ኦያዋ አግበይክኖ።</para>
  <para style="q1" vid="PSA 78:32">ባረ ማላታ ኡባ ኦናካ፥ አማንበይክኖ።<verse eid="PSA 78:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33"/>ሄዋ ድራዉ፥ እ ኡንቱንቱ ጋላሳቱዋ ጫርኩዋዳን፥</para>
  <para style="q2" vid="PSA 78:33">ኡንቱንቱ ላይቱዋካ አኬከናን ይሴዳ።<verse eid="PSA 78:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34"/>ጾሳይ ኡንቱንቱፐ ዎያ ዎደ፥</para>
  <para style="q2" vid="PSA 78:34">አቴዳዋንቱ ናጋራ ፓጺደ፥</para>
  <para style="q2" vid="PSA 78:34">ጾሳ ምን ኮዬድኖ።<verse eid="PSA 78:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35"/>ኡንቱንቱ ጾሳይ ኡንቱንቶ ዛላ ግዴዳዋነ</para>
  <para style="q2" vid="PSA 78:35">ኡባፐ ቂያ ጾሳይ፥</para>
  <para style="q2" vid="PSA 78:35">ኡንቱንታ ዎዝያዋ ግዴዳዋ ሀሳዬድኖ።<verse eid="PSA 78:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36"/>ሽን ኡንቱንቱ ባረንቱ እንጻርሳን አዉ ዎርዶቲደ፥</para>
  <para style="q2" vid="PSA 78:36">ባረንቱ ዶናን ጭሜድኖ።<verse eid="PSA 78:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37"/>ኡንቱንቱ ዎዛናይ ጾሳን ኤቀና፤</para>
  <para style="q2" vid="PSA 78:37">እ ኡንቱንቱና ጫቀቴዳ ጫቁዋ አማነትክኖ።<verse eid="PSA 78:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38"/>ሽን እ ኡንቱንታ ማርያዌ፤</para>
  <para style="q2" vid="PSA 78:38">ኡንቱንቱ ኢታተ አቶ ጌዳ።</para>
  <para style="q1" vid="PSA 78:38">ኡንቱንታ ይስቤና፤ ዳሮ ገደ ባረ ሀንቁዋ ተኤዳ፤</para>
  <para style="q2" vid="PSA 78:38">ባረ ሀንቁዋ ኡላ ኡባና ኡንቱንቱ ቦላ የድቤና።<verse eid="PSA 78:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39"/>አያዉ ጎፐ፥ ኡንቱንቱ አሹዋ ጻላላ ግድያዋነ</para>
  <para style="q2" vid="PSA 78:39">ያ ጫርኬዳሳፐ ሃ ስመና፥</para>
  <para style="q2" vid="PSA 78:39">ጫርኩዋ ማላ ግድያዋ ሀሳዬዳ።<verse eid="PSA 78:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40"/>ኡንቱንቱ ባዙዋን አ ቦላ አፑ ገደ ማካሌድኖ!</para>
  <para style="q2" vid="PSA 78:40">መላ ባዙዋን አፑ ገደ ላንጭሴድኖ!<verse eid="PSA 78:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41"/>ኡንቱንቱ ዛር ዛሪደ፥ ጾሳ ፓጬድኖ፤</para>
  <para style="q2" vid="PSA 78:41">እስራኤልያ ጌሻ ሀንቀድኖ።<verse eid="PSA 78:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42"/>ኡንቱንቱ አ ዎልቃባ ዶጌድኖ፤</para>
  <para style="q2" vid="PSA 78:42">እ ኡንቱንቱ ሞርከቱዋፐ ዎዜዳ ጋላሳ፥<verse eid="PSA 78:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43"/>እ ግብጼ ቢታን ማላታ፥</para>
  <para style="q2" vid="PSA 78:43">ጾኣነ ደምባን ማላልስያባ፥</para>
  <para style="q2" vid="PSA 78:43">ኦዳ ዎድያ ሀሳይበይክኖ።<verse eid="PSA 78:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44"/>ኡንቱንቱ ሻፋ ሃቱዋ ሱዉ ላሜዳ፤<note caller="-" style="x"><char style="xo" closed="false">78:44 </char><char style="xt" closed="false"><ref loc="EXO 7:17-21">ከሳ 7:17-21</ref></char></note></para>
  <para style="q2" vid="PSA 78:44">ሄዋ ድራዉ፥ ግብጼ አሳቱ፥</para>
  <para style="q2" vid="PSA 78:44">ሄ ሻፋቱዋፐ ኡሻናዉ ዳንዳይበይክኖ።<verse eid="PSA 78:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45"/>ኡንቱንታ ዋይስያ ኡዱንጸቱዋነ</para>
  <para style="q2" vid="PSA 78:45">ኡንቱንቱ ቢታ ባይዝያ ሸቱዋ ኪቴዳ።<note caller="-" style="x"><char style="xo" closed="false">78:45 </char><char style="xt" closed="false"><ref loc="EXO 8:1-6">ከሳ 8:1-6</ref>፣ <ref loc="EXO 8:20-24">20-24</ref></char></note><verse eid="PSA 78:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46"/>ኡንቱንቶ ዶሌዳ ካ ጎንዶ፥<note caller="-" style="x"><char style="xo" closed="false">78:46 </char><char style="xt" closed="false"><ref loc="EXO 10:12-15">ከሳ 10:12-15</ref></char></note></para>
  <para style="q2" vid="PSA 78:46">ኡንቱንቱ ኦደ ዳቡሬዳዋ ቦልያዉ እሜዳ።<verse eid="PSA 78:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47"/>ኡንቱንቱ ዎይንያ ቱራ ሻቻን፥</para>
  <para style="q2" vid="PSA 78:47">ኡንቱንቱ ባላስያ ግያ ምካ ጫርኩዋን ይሴዳ።<note caller="-" style="x"><char style="xo" closed="false">78:47-48 </char><char style="xt" closed="false"><ref loc="EXO 9:22-25">ከሳ 9:22-25</ref></char></note><verse eid="PSA 78:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48"/>ኡንቱንቱ ሚዛቱዋ ሻቻን ዎዳ፤</para>
  <para style="q2" vid="PSA 78:48">ኡንቱንቱ ዶርሳ ዉድያ፥</para>
  <para style="q2" vid="PSA 78:48">ቂያ ዋልቃንን መሬስ ዉርሴዳ።<verse eid="PSA 78:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49"/>ኡንቱንቱ ቦላ ባረ ሱልያ ሀንቁዋ፥</para>
  <para style="q2" vid="PSA 78:49">ላንጭያነ እጹዋ፥</para>
  <para style="q2" vid="PSA 78:49">ባይዝያ ኪታንቻቱዋ ጩጉዋን የዴዳ።<verse eid="PSA 78:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50"/>ባረ ሀንቁዋ አ የዴዳ።</para>
  <para style="q2" vid="PSA 78:50">ኡንቱንታ ኢታ ሀርግያዉ አደ እሜዳፐ አትና፥</para>
  <para style="q2" vid="PSA 78:50">ሀይቁዋፐ አሽቤና።<verse eid="PSA 78:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51"/>ግብጼን የለቴዳ ባይራ ናናቱዋ ኡባ ዎዳ።<note caller="-" style="x"><char style="xo" closed="false">78:51 </char><char style="xt" closed="false"><ref loc="EXO 12:29">ከሳ 12:29</ref></char></note></para>
  <para style="q2" vid="PSA 78:51">ካማ ዱንካንያን ደእያ ኮይሮ ናናቱዋ ኡባ ዉርሴዳ።<verse eid="PSA 78:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52"/>ሽን እ ባረ አሳ ዶርሳዳን ከሴዳ፤<note caller="-" style="x"><char style="xo" closed="false">78:52 </char><char style="xt" closed="false"><ref loc="EXO 13:17-22">ከሳ 13:17-22</ref></char></note></para>
  <para style="q2" vid="PSA 78:52">ዉድያዳን ባዙዋን ሄሜዳ።<verse eid="PSA 78:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53"/>እ ኡንቱንታ ሳሩዋን ካለዳ፤</para>
  <para style="q2" vid="PSA 78:53">ሄዋ ድራዉ፥ ኡንቱንቱ ያይበይክኖ፤</para>
  <para style="q2" vid="PSA 78:53">ሽን ኡንቱንቱ ሞርከቱዋ አባይ ሙኬዳ።<note caller="-" style="x"><char style="xo" closed="false">78:53 </char><char style="xt" closed="false"><ref loc="EXO 14:26-28">ከሳ 14:26-28</ref></char></note><verse eid="PSA 78:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54"/>ያቲደ እ ኡንቱንታ ባረ ጌሻ ቢታ፥</para>
  <para style="q2" vid="PSA 78:54">ባረ ኡሸቻ ኩሽያን ጾኔዳ ደርያ አሄዳ።<note caller="-" style="x"><char style="xo" closed="false">78:54 </char><char style="xt" closed="false"><ref loc="EXO 15:17">ከሳ 15:17</ref>፤ <ref loc="JOS 3:14-17">ኢያሳ 3:14-17</ref></char></note><verse eid="PSA 78:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55"/>እ ኡንቱንቱ ስንፐ ካዉተቱዋ ላጊደ፥</para>
  <para style="q2" vid="PSA 78:55">ኡንቱንቱ ቢታ ሻኪደ፥<note caller="-" style="x"><char style="xo" closed="false">78:55 </char><char style="xt" closed="false"><ref loc="JOS 11:16-23">ኢያሳ 11:16-23</ref></char></note></para>
  <para style="q1" vid="PSA 78:55">እስራኤልያ ዛረቶ ግሼዳ።</para>
  <para style="q2" vid="PSA 78:55">ባረ አሳ ኡንቱንቱ ጎልያን ዎዳ።<verse eid="PSA 78:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56"/>ግዶፐነ፥ ኡባፐ ቂያ ጾሳ ቦላ ማካሊደ፥</para>
  <para style="q2" vid="PSA 78:56">አ ፓጬድኖ።<note caller="-" style="x"><char style="xo" closed="false">78:56 </char><char style="xt" closed="false"><ref loc="JDG 2:11-15">ዳና. 2:11-15</ref></char></note></para>
  <para style="q1" vid="PSA 78:56">አ አዛዙዋካ ናግበይክኖ።<verse eid="PSA 78:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57"/>ኡንቱንቱ ባረንቱ አዎቱዋዳን፥</para>
  <para style="q2" vid="PSA 78:57">ማካላንቻቱዋነ ካዳንቻቱዋ ግዴድኖ።</para>
  <para style="q1" vid="PSA 78:57">ጌላ ቶራዳን ዎራ ዎድኖ።<verse eid="PSA 78:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58"/>ኡንቱንቱ ባረንቱ ጎይንያ ቃ ሳአቱዋን አ ይሎዬድኖ፤</para>
  <para style="q2" vid="PSA 78:58">ባረንቱ ኤቃቱዋን አ ቃናትሴድኖ።<verse eid="PSA 78:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59"/>ያትና፥ ጾሳይ ሀዋ ስሲደ ሀንቀቴዳ፤</para>
  <para style="q2" vid="PSA 78:59">እስራኤልያ ሙለካ ካዳ።<verse eid="PSA 78:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60"/>ሴሎን እ ደኤዳ ሳኣ፥</para>
  <para style="q2" vid="PSA 78:60">አሳ ግዶን እ ደኤዳ ባረ ዱንካንያ አጌዳ።<note caller="-" style="x"><char style="xo" closed="false">78:60 </char><char style="xt" closed="false"><ref loc="JOS 18:1">ኢያሳ 18:1</ref>፤ <ref loc="JER 7:12-14">ኤር. 7:12-14</ref>፤ <ref loc="JER 26:6">26:6</ref></char></note><verse eid="PSA 78:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61"/>ጾሳ ዎልቃዉነ ቦንቾ፥ ማላታ ግዴዳ፥</para>
  <para style="q2" vid="PSA 78:61">ታቦታ ሞርከቱዋ ኩሽያን አደ ኦሞድሴዳ።<note caller="-" style="x"><char style="xo" closed="false">78:61 </char><char style="xt" closed="false"><ref loc="1SA 4:4-22">1 ሳሜላ 4:4-22</ref></char></note><verse eid="PSA 78:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62"/>እ ባረ አሳዉ ሀንቀቴዳ፤</para>
  <para style="q2" vid="PSA 78:62">እ ኡንቱንታ ማሻዉ አደ እሜዳ።<verse eid="PSA 78:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63"/>ኡንቱንቱ ዎዳላቱ ኡባይ ኦላን ሀይቄድኖ፤</para>
  <para style="q2" vid="PSA 78:63">ያትና፥ ኡንቱንቱ ዎዶሮቱ አስና ገለናን አቴድኖ።<verse eid="PSA 78:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64"/>ኡንቱንቱ ቄሳቱ ማሻን ዉሬድኖ።</para>
  <para style="q2" vid="PSA 78:64">ግዶፐነ፥ ኡንቱንቱ ማቼቱ፥</para>
  <para style="q2" vid="PSA 78:64">ባረንቱ አስናቶ ዬከናዳን ድገቴድኖ።<verse eid="PSA 78:64"/></para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65"/>ሄዋፐ ጉይያን፥ ጎዳይ ገምእሹዋፐ</para>
  <para style="q2" vid="PSA 78:65">ዎይ ዎይንያ ኤሳ ማዋፐ ቤጎትያ አሳዳን ቤጎቴዳ።<verse eid="PSA 78:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66"/>እ ባረ ሞርከቱዋ ጉየ ዛሪደ ሾጬዳ፤</para>
  <para style="q2" vid="PSA 78:66">ኡንቱንታ መናዉ ዬላዬዳ።<verse eid="PSA 78:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67"/>ዮሴፎ ዱንካንያ ካዳ፤</para>
  <para style="q2" vid="PSA 78:67">ኤፍሬማ ዛርያ ዶርቤና።<verse eid="PSA 78:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68"/>ሽን እ ይሁዳ ዛርያነ</para>
  <para style="q2" vid="PSA 78:68">ሲቅያ ጽዮነ ደርያ ዶሬዳ።<verse eid="PSA 78:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69"/>ሄዋን እ ባረ ጌሻ ጎልያ ሳሉዋዳን ቃን ኬጼዳ፤</para>
  <para style="q2" vid="PSA 78:69">ሳኣዳን መናዉ ኤሴዳ።<verse eid="PSA 78:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70"/>ባረ ቆማ ዳዊታ ዶሪደ፥</para>
  <para style="q2" vid="PSA 78:70">ዶርሳ ዉድያ ሄምያ ሳፐ አኬዳ።<note caller="-" style="x"><char style="xo" closed="false">78:70-71 </char><char style="xt" closed="false"><ref loc="1SA 16:11-12">1 ሳሜላ 16:11-12</ref>፤ <ref loc="2SA 7:8">2 ሳሜላ 7:8</ref>፤ <ref loc="1CH 17:7">1 ኦዱዋ 17:7</ref></char></note><verse eid="PSA 78:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71"/>ዶርሳ ሄምሽን፥ ባረ አሳ ያቆባ፥</para>
  <para style="q2" vid="PSA 78:71">ባረ ቡዙዋ እስራኤልያ ሄንናዉ አኪደ አሄዳ።<verse eid="PSA 78:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72"/>ያትና፥ ዳውት ኡንቱንታ ሱረ ዎዛናፐ ሄሜዳ፤</para>
  <para style="q2" vid="PSA 78:72">ቃይ ባረ ሂላ ኩሽያን ካለዳ።<verse eid="PSA 78:72"/></para>
  <chapter eid="PSA 78"/>
  <chapter number="79" style="c" sid="PSA 79"/>
  <para style="s1">ጋድያ ላአተዉ ሺቄዳ ዎሳ</para>
  <para style="d">አሳፋ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 79:1"/>አቤት ጾሳዉ፥ አይሁዳ ግደና አሳቱ ነ ቢታ ቦላ ላቴድኖ።</para>
  <para style="q2" vid="PSA 79:1">ነ ጌሻ ጎልያ ቱንሴድኖ፤<note caller="-" style="x"><char style="xo" closed="false">79:1 </char><char style="xt" closed="false"><ref loc="2KI 25:8-10">2 ካታ. 25:8-10</ref>፤ <ref loc="2CH 36:17-19">2 ኦዱዋ 36:17-19</ref>፤ <ref loc="JER 52:12-14">ኤር. 52:12-14</ref></char></note></para>
  <para style="q3" vid="PSA 79:1">የሩሳላመ ኮለሬድኖ።<verse eid="PSA 79:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2"/>ኡንቱንቱ ነ ቆማቱዋ አሃ፥</para>
  <para style="q2" vid="PSA 79:2">ሳሉዋ ካፎ ቁማ ኦደ፥ እሜድኖ።</para>
  <para style="q1" vid="PSA 79:2">ቃይ ነ ጌሻቱዋ አሹዋ ሳኣ ዶአቶ እሜድኖ።<verse eid="PSA 79:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3"/>ኡንቱንቱ ሱ የሩሳላመ ዩሹዋን፥</para>
  <para style="q2" vid="PSA 79:3">ሃዳን ጉሴድኖ፤</para>
  <para style="q2" vid="PSA 79:3">ኡንቱንቱ አሃ ሞግያዌ ዬዳ።<verse eid="PSA 79:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4"/>ኑ ሾሮቶ ኑን ሸቂያዋ ግዴዶ፤</para>
  <para style="q2" vid="PSA 79:4">ኑ ሄራን ደእያዋንቱ፥</para>
  <para style="q2" vid="PSA 79:4">ሚጭያዋነ ቅያዋ ግዴዶ።<verse eid="PSA 79:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5"/>አቤት መና ጎዳዉ፥ ሀዌ አዉደ ጋካናዉ ሀናኔ?</para>
  <para style="q2" vid="PSA 79:5">ኔን መናዉ ሀንቀታይ?</para>
  <para style="q1" vid="PSA 79:5">ነ ቃናትያ ሀንቁ ታማዳን ኤጻኔ?<verse eid="PSA 79:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6"/>ኔና ኤረና አሳቱዋ ቦላነ</para>
  <para style="q2" vid="PSA 79:6">ነ ሱን ጼሰና ካዉተቱዋ ቦላ ነ ሀንቁዋ ጉሳ።<verse eid="PSA 79:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7"/>አያዉ ጎፐ፥ ኡንቱንቱ ያቆባ ዘረቱዋ ዎድኖነ</para>
  <para style="q2" vid="PSA 79:7">ኡንቱንቱ ደኢያሳ ባይዜድኖ።<verse eid="PSA 79:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8"/>ካሰ ኑ አዎቱዋ ኢታተ ኑ ቦላ ፓይዶፓ።</para>
  <para style="q2" vid="PSA 79:8">ኤለካ ነ ማሮታ ኑዉ ኪታ፤</para>
  <para style="q2" vid="PSA 79:8">አያዉ ጎፐ፥ ኑን ሎይ መቶቴዶ።<verse eid="PSA 79:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9"/>አቤት ኑና አሽያ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 79:9">ነ ሱን ቦንቹዋ ድራዉ፥ ኑና ማዳ።</para>
  <para style="q1" vid="PSA 79:9">ነ ሱን ድራዉ፥ ኑና አሻ፤</para>
  <para style="q2" vid="PSA 79:9">ኑ ናጋራ አቶ ያጋ።<verse eid="PSA 79:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10"/>አሳቱ አያዉ፥ “ኡንቱንቱ ጾሳይ ሀቃን ደኢ?” ያጋኔ?</para>
  <para style="q2" vid="PSA 79:10">ነ ቆማቱዋ ሱ ኡንቱንቱ ጉሴዳዋ ሀሉዋ፥</para>
  <para style="q2" vid="PSA 79:10">ኔን ከስያዋ ኑን ጼልሽን፥</para>
  <para style="q2" vid="PSA 79:10">ኡንቱንቱ ግዱዋን ቆንጭሳ።<verse eid="PSA 79:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11"/>ቃሸቴዳ አሳቱዋ ኦሊ ነ ስን ጋኮ።</para>
  <para style="q2" vid="PSA 79:11">ሀይቆ ፕርደቴዳዋንታ ነ ዎልቃ ግታተዳን አሻ።<verse eid="PSA 79:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12"/>አቤት ጾሳዉ፥ ኑ ሾሮ ካዉተቱ ኔና ቦሬዳዋ፥</para>
  <para style="q2" vid="PSA 79:12">ሀሉዋ ላፑን ኩሽያ ኡንቱንቱ ክዉዋን እድን።<verse eid="PSA 79:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13"/>ሄ ዎደ ኑን ነ አሳቱ፥ ነ ዉድያ ዶርሳቱ፥</para>
  <para style="q2" vid="PSA 79:13">መናዉ ጋላታ ነዉ እማና፤</para>
  <para style="q2" vid="PSA 79:13">የለታፐ የለታ ጋካናዉ ኔና ዛር ዛሪደ ጋላታና።<verse eid="PSA 79:13"/></para>
  <chapter eid="PSA 79"/>
  <chapter number="80" style="c" sid="PSA 80"/>
  <para style="s1">እስራኤልያ ካዉተይ ዛር ኤቃናዳን ሺቆ ዎሳ</para>
  <para style="d">ዛማረቱዋ ካፖ አሳፍ የጼዳ፥ ጪሻ ግያ ዋን የጸቴዳ ማዛሙርያ፥ ማርካተ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 80:1"/>አቤት እስራኤልያ ሄንንቻዉ፥</para>
  <para style="q2" vid="PSA 80:1">ዮሴፎ አሳ ዉድያዳን ካለያዎ፥<note caller="-" style="x"><char style="xo" closed="false">80:1 </char><char style="xt" closed="false"><ref loc="EXO 25:22">ከሳ 25:22</ref></char></note></para>
  <para style="q2" vid="PSA 80:1">ክሩበቱዋ ግያ ኪታንቻቱዋፐ፥</para>
  <para style="q3" vid="PSA 80:1">ቦላና ደእያ አራታን ኡቴዳዎ፥ ፖአ፥ ኔን ኑና ስሳ።<verse eid="PSA 80:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 80:2"/>ኤፍሬማ፥ ቢንያማነ ምናሰ ስንን ቆንጫ።</para>
  <para style="q2" vid="PSA 80:2">ነ ዎልቃ ደንደ ኑና አሻናዉ ሃያ።<verse eid="PSA 80:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3"/>አቤት ጾሳዉ፥ ኑና ዛራ፤</para>
  <para style="q2" vid="PSA 80:3">ኑን አታናዳን፥ ነ ሶምኡዋ ኑዉ ፖእሳ።<verse eid="PSA 80:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4"/>አቤት ኡባፐ ዎልቃማ መታ ኡባ ጎዳዉ፥ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 80:4">ነ አሳ ዎሳ ቦላ አዉደ ጋካናዉ ሀንቀታይ?<verse eid="PSA 80:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5"/>ኔን ኡንቱንታ ዬኩዋ ቁማዳን ምዛዳ፤</para>
  <para style="q2" vid="PSA 80:5">ቃይ አፎ ሃዳን ኡሻዳ።<verse eid="PSA 80:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6"/>ኑ ሾሮቱ ኑ ቢታ አካናዉ፥</para>
  <para style="q2" vid="PSA 80:6">ባረንቱ ግዶን ዋላቀታናዳን ኦዳ፤</para>
  <para style="q2" vid="PSA 80:6">ኑ ሞርከቱ ኑ ቦላ ሚጬድኖ።<verse eid="PSA 80:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7"/>አቤት ኡባፐ ዎልቃማ ጾሳዉ፥ ኑና ዛራ፤</para>
  <para style="q2" vid="PSA 80:7">ኑን አታናዳን፥ ነ ሶምኡዋ ኑዉ ፖእሳ።<verse eid="PSA 80:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8"/>ኔን ግብጼፐ ዎይንያ አኑዋ አሃዳ፤</para>
  <para style="q2" vid="PSA 80:8">አይሁዳ ግደና አሳቱዋ የደርሳዳ፥ ኡንቱንቱ ቢታን አ ቶካዳ።<verse eid="PSA 80:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9"/>ኔን ዎራ ቡዳ፤</para>
  <para style="q2" vid="PSA 80:9">ያትና፥ ጻጱዋ የድ ዳሺደ፥</para>
  <para style="q2" vid="PSA 80:9">ቢታ ኡባ ጋኬዳ።<verse eid="PSA 80:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10"/>ደረቱ አ ኩዋን፥</para>
  <para style="q2" vid="PSA 80:10">ልባኖሳ ዝጋቱ አ ታሸቱዋን ካመቴድኖ።<verse eid="PSA 80:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11"/>ባረ ታሸቱዋ ሜድተራነ አባ ጋካናዉ፥</para>
  <para style="q2" vid="PSA 80:11">ቃይ ባረ ጼራቱዋ ኤፍራጺሳ ሻፋ ጋካናዉ የዴዳ።<verse eid="PSA 80:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12"/>ያትና፥ ኦግያና አያ ኡባይ፥</para>
  <para style="q1" vid="PSA 80:12">አ አይፍያ ዱናዳን፥</para>
  <para style="q2" vid="PSA 80:12">አ ዩሹዋን ደእያ ግምቢያ አያዉ ኮላዲ?<verse eid="PSA 80:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13"/>ባዙዋ ጉዱንይ አ ቦላ ዱሪደ ባይዜ፤</para>
  <para style="q2" vid="PSA 80:13">ቃይ ጋደን ዎጽ ቃጽያ መታቱ ኡባይ አ ሚኖ።<verse eid="PSA 80:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14"/>አቤት መታ ኡባ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 80:14">ኔን ኑኮ ስማ።</para>
  <para style="q1" vid="PSA 80:14">ሳሉዋና ዱገ ጼላደ በአ፤</para>
  <para style="q2" vid="PSA 80:14">ሀ ዎይንያ ናጋ።<verse eid="PSA 80:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 80:15"/>እ ነ ኡሸቻ ኩሺ ቶኬዳ ጻጱዋ፤</para>
  <para style="q2" vid="PSA 80:15">ኔን ነዉ ጋደ ድቼዳ ፑትያ።<verse eid="PSA 80:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16"/>ነ ሞርከቱ ነ ዎይንያ ቡድኖ፤</para>
  <para style="q2" vid="PSA 80:16">ታማን ጹጌድኖ።</para>
  <para style="q1" vid="PSA 80:16">ሄዋ ድራዉ፥ ኔን ኡንቱንታ ነ ሀንቁዋ ሱሉዋን ይሳ።<verse eid="PSA 80:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17"/>ነ ኩሺ፥ ነ ኡሸቻን ደእያ አሳ፥</para>
  <para style="q2" vid="PSA 80:17">ኔን ነዉ ጋደ ድቼዳ አሳ ናጎ።<verse eid="PSA 80:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18"/>ያቶፐ፥ ኑን ኔፐ ጉየ ስሞኮ።</para>
  <para style="q1" vid="PSA 80:18">ኑና ፓጻ ዎ፤ ነ ሱን ኑን ጋላታና።<verse eid="PSA 80:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19"/>አቤት ኡባፐ ዎልቃማ መና ጎዳ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 80:19">ኑና ዛራ፤ ኑን አታናዳን፥</para>
  <para style="q2" vid="PSA 80:19">ነ ሶምኡዋ ኑዉ ፖእሳ።<verse eid="PSA 80:19"/></para>
  <chapter eid="PSA 80"/>
  <chapter number="81" style="c" sid="PSA 81"/>
  <para style="s1">ባላ ማዝሙርያ</para>
  <para style="d">ዛማረቱዋ ካፖ ሱሱላቱዋን የጸቴዳ፥ አሳፍ ጻፌዳዋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1"/>ኑዉ ዎልቃ ግድያ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 81:1">ህንተ ቃላ ቁ ኦደ የጽተ፤</para>
  <para style="q3" vid="PSA 81:1">ያቆባ ጾሳ ሳቢተ።<verse eid="PSA 81:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2"/>የ ዶምተ፤ ካራቡዋ ባቂተ፤</para>
  <para style="q2" vid="PSA 81:2">ዲንነ ማስንቁዋን ሎአ የ ስስተ።<verse eid="PSA 81:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3"/>አግናይ ጼርያ ዎደነ፥</para>
  <para style="q2" vid="PSA 81:3">አግናይ ዶይስያ ዎደ</para>
  <para style="q2" vid="PSA 81:3">ባላ ጋላሳን ማላካታ ፑንተ።<note caller="-" style="x"><char style="xo" closed="false">81:3 </char><char style="xt" closed="false"><ref loc="NUM 10:10">ፓይ. 10:10</ref></char></note><verse eid="PSA 81:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4"/>ሀዌ እስራኤልያዉ ህግያ፤</para>
  <para style="q2" vid="PSA 81:4">ያቆባ ጾሳፐ እመቴዳ ዎጋ።<verse eid="PSA 81:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5"/>ግብጼ ቢታ እ ሾጬዳ ዎደ፥</para>
  <para style="q2" vid="PSA 81:5">ዮሴፎ አሳዉ ሀ ዎጋ አዋዬዳ።</para>
  <para style="q1" vid="PSA 81:5">ታን ኤረና ኮሻ ሀዋዳን ያግያዋ ስሳድ።<verse eid="PSA 81:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6"/>“ህንተ ሀሽያፐ ቶኩዋ ዎድ፤</para>
  <para style="q2" vid="PSA 81:6">ህንተ ኩሽያ ጹብያፐ ሸምፕሳድ።<verse eid="PSA 81:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7"/>ህንተ መቱዋ ዎደ ታና ጼሴድታ፤</para>
  <para style="q2" vid="PSA 81:7">ህንተና አሻድ፤<note caller="-" style="x"><char style="xo" closed="false">81:7 </char><char style="xt" closed="false"><ref loc="EXO 17:7">ከሳ 17:7</ref>፤ <ref loc="NUM 20:13">ፓይ. 20:13</ref></char></note></para>
  <para style="q2" vid="PSA 81:7">ታን ጉምያ ሻርያ ግዶን ጌሜዳሳፐ ህንተና አላድ።</para>
  <para style="q2" vid="PSA 81:7">ማሪባ ግያ ፑልቱዋ ማታን ታን ህንተና ፓጫድ።<verse eid="PSA 81:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8"/>ታ አሳዉ፥ ታን ህንተና ሴርያዋ ስስተ፤</para>
  <para style="q2" vid="PSA 81:8">ሀእ እስራኤላቶ፥ ሀይዜርክተ!<verse eid="PSA 81:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9"/>ህንተ ግዶን አላጋ ጾስ ደኦፖ፤<note caller="-" style="x"><char style="xo" closed="false">81:9-10 </char><char style="xt" closed="false"><ref loc="EXO 20:2-3">ከሳ 20:2-3</ref>፤ <ref loc="DEU 5:6-7">ዛረ. 5:6-7</ref></char></note></para>
  <para style="q2" vid="PSA 81:9">ሀራ ጾሳዉ ጎይኖፕተ።<verse eid="PSA 81:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10"/>ታን፥ መና ጎዳ ህንተ ጾሳ፥</para>
  <para style="q2" vid="PSA 81:10">ህንተና ግብጼ ቢታፐ ከሳደ አሄዳዋ።</para>
  <para style="q1" vid="PSA 81:10">ነ ዶና ሎይ ሀንጋ፤</para>
  <para style="q2" vid="PSA 81:10">ታን ኔና ዳርሳደ ባርሳና።<verse eid="PSA 81:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11"/>“ሽን ታ አሳቱ ታ ቃላ ስስበይክኖ፤</para>
  <para style="q2" vid="PSA 81:11">እስራኤላቱ ታዉ አዛዘትበይክኖ።<verse eid="PSA 81:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12"/>ሄዋ ድራዉ፥ ታን ኡንቱንቱ ባረንቱ ቆፋ ካላና ማላ፥</para>
  <para style="q2" vid="PSA 81:12">ኤኖ ጌና ዎዛናዉ አደ እማድ።<verse eid="PSA 81:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13"/>ታ አሳይ ታና ስሴደንቶ፥</para>
  <para style="q2" vid="PSA 81:13">እስራኤላቱ ታ ኦግያ ካሌደንቶ አዬ ደኢ!<verse eid="PSA 81:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14"/>ታን ኡንቱንቱ ሞርክያ ኤለ ጾናና ሽን፤</para>
  <para style="q2" vid="PSA 81:14">ኡንቱንቱ ባልጋራቱዋ ቦላ ታ ኩሽያ ዎና ሽን።<verse eid="PSA 81:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15"/>መና ጎዳ እጽያዋንቱ አ ስንን ሆካና፥</para>
  <para style="q2" vid="PSA 81:15">ኡንቱንቱ ሙሩካ መናሳ ግዳናዋ።<verse eid="PSA 81:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16"/>ታን ህንተና ሎኦ ዛርጋ ምዛና፤</para>
  <para style="q2" vid="PSA 81:16">ቃይ ኤሳ፥ ሹቻ ጎንጎሉዋፐ ካልሳና” ያጌ።<verse eid="PSA 81:16"/></para>
  <chapter eid="PSA 81"/>
  <chapter number="82" style="c" sid="PSA 82"/>
  <para style="s1">ጾሳይ ኡባፐ ቦላ</para>
  <para style="d">አሳፋ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1"/>ጾሳይ ሳሉዋ ሺቁዋ ሺሼ።</para>
  <para style="q2" vid="PSA 82:1">ጾሳቱዋ ግዶን ሀዋዳን ያጊደ ፕርዴ፤<verse eid="PSA 82:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2"/>“ህንተ አዉደ ጋካናዉ ጌላ ፕርዳ ፕርዲቴ፤</para>
  <para style="q2" vid="PSA 82:2">ላኤን ኢታቱዋ ባጋ ግዶፕተ።<verse eid="PSA 82:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3"/>ህዬሳቶነ አዉ ባይናዋንቶ ሞተትተ፤</para>
  <para style="q2" vid="PSA 82:3">ማንቆነ ናቀቴዳ አሳቱዋ ማታ ናግስተ።<verse eid="PSA 82:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4"/>ዳቡራንቻቱዋነ መቶታንቻቱዋ አሽተ፤</para>
  <para style="q2" vid="PSA 82:4">ኢታቱዋ ኩሽያፐ ኡንቱንታ ዎ አክተ።<verse eid="PSA 82:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5"/>“ህንተ አይነ ኤርክታነ አይነ አኬክክታ፤</para>
  <para style="q2" vid="PSA 82:5">ህንተ ማን ሀመቲታ።</para>
  <para style="q1" vid="PSA 82:5">ጽሎተይ ይና፥ ቢታይ ዪቂዪቄ።<verse eid="PSA 82:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6"/>ታን ህንተና፥ ‘ህንተ ጾሳቱዋ፤<note caller="-" style="x"><char style="xo" closed="false">82:6 </char><char style="xt" closed="false"><ref loc="JHN 10:34">ዮሃ. 10:34</ref></char></note></para>
  <para style="q2" vid="PSA 82:6">ህንተ ኡባይካ ኡባፐ ቂያ ጾሳ ናናቱዋ።<verse eid="PSA 82:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7"/>ግዶፐነ፥ ህንተ አሳይ ሀይቂያዋዳን ሀይቃና።</para>
  <para style="q2" vid="PSA 82:7">ቃይ ሀራ ካፓቱ ኩንዴዳዋዳን፥</para>
  <para style="q2" vid="PSA 82:7">ህንተካ ኩንዳና’ ያጋይ” ያጌ።<verse eid="PSA 82:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8"/>አቤት ጾሳዉ፥ ደንዳ፤ ሳኣ ፕርዳ፤</para>
  <para style="q2" vid="PSA 82:8">ካዉተይ ኡባይ ነዋ።<verse eid="PSA 82:8"/></para>
  <chapter eid="PSA 82"/>
  <chapter number="83" style="c" sid="PSA 83"/>
  <para style="s1">እስራኤልያ ሞርከቱዋ ቦላ ሺቄዳ ዎሳ</para>
  <para style="d">አሳፋ ማዛሙርያ፥ የ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 83:1"/>አቤት ጾሳዉ፥ ጮኡ ጎፓ፤</para>
  <para style="q2" vid="PSA 83:1">ስርጵ ጎፓ፤</para>
  <para style="q3" vid="PSA 83:1">አቤት ጾሳዉ፥ ሙሞፓ።<verse eid="PSA 83:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2"/>በአ! ነ ሞርከቱ ነ ቦላ ደንዲኖ፤</para>
  <para style="q2" vid="PSA 83:2">ኔና እጽያዋንቱ ነ ቦላ ማካሊኖ።<verse eid="PSA 83:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3"/>ኡንቱንቱ ነ አሳ ቦላን ጌማን ያኢኖ፤</para>
  <para style="q2" vid="PSA 83:3">ኔን ሲቅያ አሳቱዋ ቦላ ማቀቲኖ።<verse eid="PSA 83:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4"/>ኡንቱንቱ፥ “ሃይተ፥ ኡንቱንቱ ካዉተ ይሶይቴ፤</para>
  <para style="q2" vid="PSA 83:4">እስራኤልያ ግያ ሱን፥</para>
  <para style="q2" vid="PSA 83:4">መናዉ ሀሳየተናዳን ኦይተ” ያጊኖ።<verse eid="PSA 83:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5"/>ኡንቱንቱ እት ዎዛና ግዲደ፥</para>
  <para style="q2" vid="PSA 83:5">እትፐ ማቀቲኖነ፥</para>
  <para style="q2" vid="PSA 83:5">ነ ቦላ ጫቁዋ ጫቀቲኖ።<verse eid="PSA 83:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6"/>ጫቀትያዋንቱነ</para>
  <para style="q2" vid="PSA 83:6">ኤዶማነ እስማኤላ አሳቱዋ፥</para>
  <para style="q1" vid="PSA 83:6">ሞኣባ ዛራቱዋነ አጋር ዛራቱዋ፤<verse eid="PSA 83:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7"/>ገባላ አሳቱዋ፥ አሞና አሳቱዋ፥</para>
  <para style="q2" vid="PSA 83:7">አማሌቃ አሳቱዋ፥</para>
  <para style="q1" vid="PSA 83:7">ፕልስጼማ አሳቱዋነ ጺሮሳ አሳቱዋ።<verse eid="PSA 83:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8"/>አሶረ አሳቱካ ኡንቱንቱና እትፐ ጋከቴድኖ፤</para>
  <para style="q2" vid="PSA 83:8">አሶራቱካ ሎጸ ዛረቶ ዎልቃማ ማዱዋ ግዴድኖ።<verse eid="PSA 83:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9"/>ኔን ምድያማ አሳቱዋ ቦላነ</para>
  <para style="q2" vid="PSA 83:9">ስሳራነ ያብና ቦላ፥</para>
  <para style="q1" vid="PSA 83:9">ቂሾና ሻፋን ኦዳዋዳን ኡንቱንቱ ቦላ ኦ።<note caller="-" style="x"><char style="xo" closed="false">83:9 </char><char style="xt" closed="false"><ref loc="JDG 4:6-22">ዳና. 4:6-22</ref>፤ <ref loc="JDG 7:1-23">7:1-23</ref></char></note><verse eid="PSA 83:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10"/>ኡንቱንቱ ኤንዶረን ዬድኖ፤</para>
  <para style="q2" vid="PSA 83:10">ኡንቱንቱ አሃይ ሞገተናን ቢታን ዎቄዳ።<verse eid="PSA 83:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11"/>ኡንቱንቱ ካፖቱዋ፥</para>
  <para style="q2" vid="PSA 83:11">ኔን ኦሬባነ ዛኤባ ኦዳዋዳን ኦ፤<note caller="-" style="x"><char style="xo" closed="false">83:11 </char><char style="xt" closed="false"><ref loc="JDG 7:25">ዳና. 7:25</ref>፤ <ref loc="JDG 8:12">8:12</ref></char></note></para>
  <para style="q2" vid="PSA 83:11">ኡንቱንታ ሞድያዋንታ</para>
  <para style="q2" vid="PSA 83:11">ኔን ዘባሀነ ጻልሙናአ ይሴዳዋዳን ይሳ።<verse eid="PSA 83:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12"/>ሄዋንቱነ፥ “ኑን ጾሳ አሳ ቢታ</para>
  <para style="q2" vid="PSA 83:12">ኑዉ ቡዞታና” ያጌዳዋንታ።<verse eid="PSA 83:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13"/>አቤት ታ ጾሳዉ፥ ኡንቱንታ ባናዳን ላላ፤</para>
  <para style="q2" vid="PSA 83:13">ጫርኩ አፍያ ሱላዳን ኦ።<verse eid="PSA 83:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14"/>ጻራጋይ ዎራ ሚደ ዉርስያዋዳን፥</para>
  <para style="q2" vid="PSA 83:14">ታማ ላጩ ደርያ ማይያዋዳን፥<verse eid="PSA 83:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 83:15"/>ሄዋዳንካ ነ ኡሹዋን ኡንቱንታ የደርሳ፤</para>
  <para style="q2" vid="PSA 83:15">ነ ጎትያን ኡንቱንታ ዳጋን።<verse eid="PSA 83:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16"/>አቤት መና ጎዳዉ፥ አሳይ ነ ሱን ኮያና ማላ፥</para>
  <para style="q2" vid="PSA 83:16">ኔን ኡንቱንቱ ሶምኡዋ ዬላ ማይዛ።<verse eid="PSA 83:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17"/>ኡንቱንቱ መናዉ ዬላትኖነ ህርግኖ፤</para>
  <para style="q2" vid="PSA 83:17">ካዉሺደ ይኖ።<verse eid="PSA 83:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18"/>ነ ሱንይካ መና ጎዳ ግድያዋ፥</para>
  <para style="q2" vid="PSA 83:18">ነ ጻላላይ ኡባፐ ቃ ጾሳ፥</para>
  <para style="q2" vid="PSA 83:18">ሳኣ ኡባ ሞድያዋ ኡንቱንቱ ኤርኖ።<verse eid="PSA 83:18"/></para>
  <chapter eid="PSA 83"/>
  <chapter number="84" style="c" sid="PSA 84"/>
  <para style="s1">ጾሳ ጎልያ ላሞቱሳ</para>
  <para style="d">ዛማረቱዋ ካፖ ሱሱላቱዋን የጸቴዳ፥ ቆረ ናናቱ ጻፌዳ ማዝሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 84:1"/>አቤት ኡባፐ ዎልቃማ መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 84:1">ኔን ደኢያሳይ አያ ሎኢ!<verse eid="PSA 84:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2"/>ታን መና ጎዳ ጌሻ ጎልያ ዳባባ ላሞታይ፤</para>
  <para style="q2" vid="PSA 84:2">ታ ኩመን አሳተይ ደኡዋ ጾሳዉ ናሸቻን የጼ።<verse eid="PSA 84:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3"/>አቤት ኡባፐ ዎልቃማ መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 84:3">ታ ካትያዉ፥ ታ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 84:3">ነዉ ያርሽያ ሳኣ ማታን፥</para>
  <para style="q2" vid="PSA 84:3">ሱንያ ካፋታ ባረዉ ደኢያሳ ደማዱ።</para>
  <para style="q1" vid="PSA 84:3">ሀራጳታካ ባረዉ ቁቁልያ ጎልያ ያን ኬጻዱ።<verse eid="PSA 84:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4"/>ነ ጌሻ ጎልያን ደእያዋንቱነ</para>
  <para style="q2" vid="PSA 84:4">መናዉ ኔና ሳቢያዋንቱ አንጀቴዳዋንታ።<verse eid="PSA 84:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5"/>ዎልቃ ኔፐ ደምያዋንቱ፥</para>
  <para style="q2" vid="PSA 84:5">ባረንቱ ዎዛናን ጽዮነ አፍያ ኦግያ ባናዉ</para>
  <para style="q2" vid="PSA 84:5">አሞትያዋንቱ አንጀቴዳዋንታ።<verse eid="PSA 84:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6"/>ዬኩዋ ዛንጋራና ኡንቱንቱ አያ ዎደ፥</para>
  <para style="q2" vid="PSA 84:6">ሄ ሳአይ ፑልቱዋ ከሴ።</para>
  <para style="q1" vid="PSA 84:6">ባሳ እራይካ ቡኪደ፥</para>
  <para style="q2" vid="PSA 84:6">ያን ደልእያ ግስሴ።<verse eid="PSA 84:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7"/>ኡንቱንቱ ብያ ዎደ፥ ዎልቃ ጉጅ ጉጂደ ባና።</para>
  <para style="q2" vid="PSA 84:7">ኡንቱንቱ ጾሳ ስንን ጽዮነን ቤታና።<verse eid="PSA 84:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8"/>አቤት ኡባፐ ዎልቃማ መና ጎዳዉ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 84:8">ታ ዎሳ ኔን ስሳ።</para>
  <para style="q1" vid="PSA 84:8">አቤት ያቆባ ጾሳዉ፥ ሀይዛ።<verse eid="PSA 84:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9"/>አቤት ጾሳዉ፥ ኑ ጎንዳልያ በአ፤</para>
  <para style="q2" vid="PSA 84:9">ኔን ዶሬዳ ካትያ ነ ኬካ አይፍያን ጼላ።<verse eid="PSA 84:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10"/>ታን ሀራ ሳኣን ሻኡ ጋላሳ ደአናፐ</para>
  <para style="q2" vid="PSA 84:10">ጾሳ ጎልያን እት ጋላሳ ደእያዌ ሎአ።</para>
  <para style="q1" vid="PSA 84:10">ኢታቱዋ ዱንካንያን ደአናዋፐ</para>
  <para style="q2" vid="PSA 84:10">ታ ጾሳ ጎልያ ፐንግያ ናግያዌ ታዉ ሎአ።<verse eid="PSA 84:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11"/>መና ጎዳይ ጾሳይ ኑዉ ጎንዳለነ ፖኡዋ፤</para>
  <para style="q2" vid="PSA 84:11">መና ጎዳይ ኑዉ ቦንቹዋነ ኬካተ እሜ።</para>
  <para style="q1" vid="PSA 84:11">ሱረተን ሀመትያዋንታ እ ሎኦባ ኡባ ድገና።<verse eid="PSA 84:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12"/>አቤት ኡባፐ ዎልቃማ መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 84:12">ኔናን አማነትያዋንቱ አንጀቴዳዋንታ።<verse eid="PSA 84:12"/></para>
  <chapter eid="PSA 84"/>
  <chapter number="85" style="c" sid="PSA 85"/>
  <para style="s1">አሳ ሳሮተዉ ሺቄዳ ዎሳ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ቆራሀ ናናቱዋ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1"/>አቤት መና ጎዳዉ፥ ኔን ነ ቢታዉ ኬካዳ፤</para>
  <para style="q2" vid="PSA 85:1">ያቆባ አሳ ኦሞዱዋፐ ዛራዳ።<verse eid="PSA 85:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2"/>ኔን ነ አሳ ናቁዋ አቶ ጋዳ፤</para>
  <para style="q2" vid="PSA 85:2">ኡንቱንቱ ናጋራ ኡባ ካማዳ።<verse eid="PSA 85:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3"/>ኔን ነ ሀንቁዋ ኡባ አጋዳ፤</para>
  <para style="q2" vid="PSA 85:3">ነ ሀንቁዋ ሱሉዋፐካ ስማዳ።<verse eid="PSA 85:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4"/>አቤት ኑና አሽያ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 85:4">ኑና ጉየ ዛራ።</para>
  <para style="q1" vid="PSA 85:4">ኔን ኑዉ ሀንቀቴዳዋ አጋ።<verse eid="PSA 85:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5"/>ኔን ኑና መናዉ ሀንቀታይ?</para>
  <para style="q2" vid="PSA 85:5">ነ ሀንቁዋ የለታ ኡባ ጋካናዉ ጋምእሳይ?<verse eid="PSA 85:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6"/>ነ አሳይ ኔናን ናሸታና ማላ፥</para>
  <para style="q2" vid="PSA 85:6">ኑና ኦራ።<verse eid="PSA 85:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7"/>አቤት መና ጎዳዉ፥ አገና ነ ሲቁዋ ኑና በሳ፤</para>
  <para style="q2" vid="PSA 85:7">ኔን ኑና አሻ።<verse eid="PSA 85:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8"/>ታን መና ጎዳይ ጾሳይ ኦድያዋ ስሳና።</para>
  <para style="q2" vid="PSA 85:8">ኑን ኑ ቦዛ ኦግያ ጉየ ባና ዮፐ፥</para>
  <para style="q1" vid="PSA 85:8">እ ኑዉ፥ ባረ አሳዉ፥ “ሳሮተ እማና” ጊደ ኦዴ።<verse eid="PSA 85:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9"/>ቱሙካ ጾሳዉ ያይያዋንታ አሻናዉ</para>
  <para style="q2" vid="PSA 85:9">እ ማታን ደኤ፤</para>
  <para style="q2" vid="PSA 85:9">ሄዌነ፥ አ ቦንቹ ኑ ቢታን ደአናሳ።<verse eid="PSA 85:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10"/>አገና ሲቁነ ቱማተይ</para>
  <para style="q2" vid="PSA 85:10">እትፐ ጋከታና።</para>
  <para style="q1" vid="PSA 85:10">ጽሎተይነ ሳሮተይ፥</para>
  <para style="q2" vid="PSA 85:10">እትፐ የረታና።<verse eid="PSA 85:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11"/>ቱማተይ ሳኣፐ ፑደ ከሳና፤</para>
  <para style="q2" vid="PSA 85:11">ጾሳ ጽሎተይ ሳሉዋፐ ዱገ ጼላና።<verse eid="PSA 85:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12"/>ኤ፥ መና ጎዳይ ኬካባ እማና፤</para>
  <para style="q2" vid="PSA 85:12">ኑ ቢታይካ ሎኦ ካ ሞካና።<verse eid="PSA 85:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13"/>ጽሎተይ ጾሳፐ ስንና ሄመታና፤</para>
  <para style="q2" vid="PSA 85:13">አዉ ኦግያ ጊግሳና።<verse eid="PSA 85:13"/></para>
  <chapter eid="PSA 85"/>
  <chapter number="86" style="c" sid="PSA 86"/>
  <para style="s1">መቱዋ ዎደ ዎሳ</para>
  <para style="d">ዳውት ዎሴዳ ዎሳ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1"/>አቤት ጎዳዉ፥ ታን ህዬሳነ፥</para>
  <para style="q2" vid="PSA 86:1">መቶታንቻ አሳ ግድያ ድራዉ፥</para>
  <para style="q3" vid="PSA 86:1">ታ ዋሱዋ ስሳደ፥ ታዉ አላ።<verse eid="PSA 86:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2"/>ታን ጾሳ አሳ ግድያ ድራዉ፥</para>
  <para style="q2" vid="PSA 86:2">ታና ፓጻ ዎ።</para>
  <para style="q1" vid="PSA 86:2">ኔናን አማነትያ ታና፥ ነ ቆማ አሻ።</para>
  <para style="q2" vid="PSA 86:2">ኔን ታ ጾሳ።<verse eid="PSA 86:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3"/>አቤት ጾሳዉ፥ ታን ጋላሳ ኡባ</para>
  <para style="q2" vid="PSA 86:3">ኔኮ ዋስያ ድራዉ፥</para>
  <para style="q2" vid="PSA 86:3">ታዉ ቃረታ።<verse eid="PSA 86:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4"/>አቤት ጾሳዉ፥ ታን ታ ሸምፑዋፐ</para>
  <para style="q2" vid="PSA 86:4">ኔና ዎስያ ድራዉ፥</para>
  <para style="q2" vid="PSA 86:4">ታና፥ ነ ቆማ ናሸቻ።<verse eid="PSA 86:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5"/>አቤት ጾሳዉ፥ ኔን ኬካነ አቶ ግያዋ፤</para>
  <para style="q2" vid="PSA 86:5">ኔና ጼስያ ኡባዉ ነ ሲቁ ዳራ።<verse eid="PSA 86:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6"/>አቤት መና ጎዳዉ፥ ታ ዎሳ ስሳ፤</para>
  <para style="q2" vid="PSA 86:6">ታን ዋትዋትያ ዋትዋቱዋ ሀይዛ።<verse eid="PSA 86:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7"/>ኔን ታዉ አልያ ድራዉ፥</para>
  <para style="q2" vid="PSA 86:7">ታ መቱዋ ጋላሳን ታን ኔኮ ዋሳይ።<verse eid="PSA 86:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8"/>አቤት ጎዳዉ፥ ጾሳቱዋ ግዶን ነ ማል ባዋ፤</para>
  <para style="q2" vid="PSA 86:8">ነ ኦሱዋ ማላ ኦሱካ ባዋ።<verse eid="PSA 86:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9"/>አቤት ጎዳዉ፥ ኔን መዳ ካዉተ አሳይ ኡባይ ዪደ፥<note caller="-" style="x"><char style="xo" closed="false">86:9 </char><char style="xt" closed="false"><ref loc="REV 15:4">ሳፃ 15:4</ref></char></note></para>
  <para style="q2" vid="PSA 86:9">ነ ስንን ጉልባታና፤ ኡንቱንቱ ነ ሱን ቦንቻና።<verse eid="PSA 86:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10"/>አያዉ ጎፐ፥ ኔን ዎልቃማ፤</para>
  <para style="q2" vid="PSA 86:10">ኔን ማላልስያባ ኦሳ።</para>
  <para style="q1" vid="PSA 86:10">ነ ጻላላይ ጾሳ።<verse eid="PSA 86:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11"/>አቤት መና ጎዳዉ፥ ታን ነ ቱሙዋን ሀመታና ማላ፥</para>
  <para style="q2" vid="PSA 86:11">ታና ነ ኦግያ ታማርሳ።</para>
  <para style="q1" vid="PSA 86:11">ታን ነ ሱንዉ ያያና ማላ፥</para>
  <para style="q2" vid="PSA 86:11">ታዉ እት ዎዛና እማ።<verse eid="PSA 86:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12"/>አቤት ጎዳዉ ታ ጾሳዉ፥ ታን ኔና፥</para>
  <para style="q2" vid="PSA 86:12">ታ ኩመን ዎዛናፐ ጋላታና።</para>
  <para style="q1" vid="PSA 86:12">ነ ሱን መናዉ ቦንቻና።<verse eid="PSA 86:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13"/>አያዉ ጎፐ፥ ነ ሲቁ ታዉ ዳራ፤</para>
  <para style="q2" vid="PSA 86:13">ኔን ታና ዱፉዋን ገልያዋፐ አሻዳ።<verse eid="PSA 86:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14"/>አቤት ጎዳዉ፥ ኦቶራንቻ አሳቱ ታ ቦላ ደንዴድኖ፤</para>
  <para style="q2" vid="PSA 86:14">ዳጋንያ አሳቱዋ ጩጉ ታና ዎናዉ ኮዬ።</para>
  <para style="q1" vid="PSA 86:14">ኡንቱንቱ ኔና አላለ ጊክኖ።<verse eid="PSA 86:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15"/>ሽን አቤት ጎዳዉ፥ ኔን</para>
  <para style="q2" vid="PSA 86:15">ቃረትያነ ማርያ ጾሳ፤</para>
  <para style="q2" vid="PSA 86:15">ሀንቀታናዉ ጋምኣሳ፤</para>
  <para style="q2" vid="PSA 86:15">ሲቁነ አማነቱሳይ ዳርያዋ።<verse eid="PSA 86:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16"/>ታኮ ስማደ ታዉ ቃረታ።</para>
  <para style="q2" vid="PSA 86:16">ነ ቆማዉ ዎልቃ እማ፤</para>
  <para style="q2" vid="PSA 86:16">ነ ቆማት ናኣ ታና አሻ።<verse eid="PSA 86:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17"/>አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 86:17">ነ ኬካተ ማላታ ታና በሳ።</para>
  <para style="q1" vid="PSA 86:17">ኔን ታና ማዴዳዋነ ምንዳዋ በእያ ዎደ፥</para>
  <para style="q2" vid="PSA 86:17">ታና እጽያዋንቱ ሄዋን ዬላታና።<verse eid="PSA 86:17"/></para>
  <chapter eid="PSA 86"/>
  <chapter number="87" style="c" sid="PSA 87"/>
  <para style="s1">የሩሳላመ ሳባ</para>
  <para style="d">ቆራሀ ናናቱዋ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1"/>መና ጎዳ ካታማይ ጌሻ ደርያን ኬጸቴዳ።<verse eid="PSA 87:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 87:2"/>መና ጎዳይ ጽዮነ ፐንገቱዋ፥</para>
  <para style="q2" vid="PSA 87:2">ያቆብ ደእያ ሳኣ ኡባፐ አደ ዶሴ።<verse eid="PSA 87:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3"/>ሀኔ ጾሳ ካታማቴ፥</para>
  <para style="q2" vid="PSA 87:3">ነ ድራዉ ቦንቼቴዳባይ፥</para>
  <para style="q2" vid="PSA 87:3">ሀዋዳን ያግ ኦደቴ፦<verse eid="PSA 87:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4"/>“ታና ኤርያ ካዉተቱዋ ግዶፐ፥</para>
  <para style="q2" vid="PSA 87:4">ግብጼነ ባብሎነ ጋ ማዝጎባና፤</para>
  <para style="q1" vid="PSA 87:4">ፕልስጼመ፥ ጺሮሰነ ቶጵያ አሳይ፥</para>
  <para style="q2" vid="PSA 87:4">ያን የለቴድኖ።”<verse eid="PSA 87:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5"/>ጾሳይ፥ “ካዉተ ኡባይ ጽዮነን የለቴዳዋ” ያጋና።</para>
  <para style="q2" vid="PSA 87:5">ኡባፐ ቂያ ጾሳይ እዞ ምንሳና።<verse eid="PSA 87:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6"/>መና ጎዳይ አሳ ጻፍያ ማዝጎብያን፥</para>
  <para style="q2" vid="PSA 87:6">“ሀዌ ጽዮነን የለቴዳዋ” ያጊደ ጻፋና።<verse eid="PSA 87:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7"/>ኡንቱንቱ የጺደ ዱሪደ፥</para>
  <para style="q2" vid="PSA 87:7">“ኑ አንጁ ኡባይ ጽዮነፐ ፑልቴ” ያጋና።<verse eid="PSA 87:7"/></para>
  <chapter eid="PSA 87"/>
  <chapter number="88" style="c" sid="PSA 88"/>
  <para style="s1">ማዱዋ ደማናዉ ሺቆ ዋሱዋ</para>
  <para style="d">ዛማረቱዋ ካፖ፥ ቆራሀ ናናቱዋ ማዛሙርያ፥ ማዱዋ ዎሳ፥ ኤዝራህያ ሄማነ አኬካን ጻፌዳ ግንጹዋ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 88:1"/>አቤት መና ጎዳዉ፥ ታና አሽያ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 88:1">ታን ጋላስ ነዉ ዋሳይ፤</para>
  <para style="q3" vid="PSA 88:1">ቃማካ ነ ስንን ዬካይ።<verse eid="PSA 88:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2"/>ታ ዎሳይ ነ ስን ጋኮ፤</para>
  <para style="q2" vid="PSA 88:2">ነ ሀይ ታ ዋሱዋኮ ዛራ።<verse eid="PSA 88:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3"/>አያዉ ጎፐ፥ ታ ደኡ መቱዋን ኩሜዳ፤</para>
  <para style="q2" vid="PSA 88:3">ታን ሀይቃና ማታድ።<verse eid="PSA 88:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4"/>ታን ዱፉዋን ገልያ አሳቱዋና ፓይደታድ፤</para>
  <para style="q2" vid="PSA 88:4">ዎልቃይ ባይና አሳ ግዳድ።<verse eid="PSA 88:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5"/>ታን አሃቱዋ ግዶን አጌዳ አሳ ማላ፤</para>
  <para style="q2" vid="PSA 88:5">ዎደ ዱፉዋን የጌዳ አሳቱዋ ማላ።</para>
  <para style="q1" vid="PSA 88:5">ታን ነ ኡባ ዶጌዳ፥</para>
  <para style="q2" vid="PSA 88:5">ነ ማዱዋፐ ሃኬዳ አሳቱዋ ማላ።<verse eid="PSA 88:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6"/>ኔን ታና ጪሞ ኦላን፥</para>
  <para style="q2" vid="PSA 88:6">ህርክ ማ ሳኣን የጋዳ።<verse eid="PSA 88:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7"/>ነ ሀንቁ ታና ዴጼ፤</para>
  <para style="q2" vid="PSA 88:7">ነ ሀንቁዋ ቤታይ ታና ኡባና ሙኬዳ።<verse eid="PSA 88:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8"/>ኔን ታ ዳቦቱዋ ታፐ ሃሳዳ፤</para>
  <para style="q2" vid="PSA 88:8">ኡንቱንቶ ታና ሸነይያዋ ኦዳ።</para>
  <para style="q1" vid="PSA 88:8">ታን ዶደታድ፤</para>
  <para style="q2" vid="PSA 88:8">ከሳ አካናዉካ ዳንዳይከ።<verse eid="PSA 88:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 88:9"/>አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 88:9">ካዩዋ ጋሱዋን ታ አይፈቱ ጋልጄድኖ።</para>
  <para style="q1" vid="PSA 88:9">ኡባ ጋላስ ታን ኔኮ ዋሳይ፤</para>
  <para style="q2" vid="PSA 88:9">ታ ኩሽያ ኔኮ ምጫድ።<verse eid="PSA 88:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10"/>ኔን ሀይቄዳዋንቶ</para>
  <para style="q2" vid="PSA 88:10">ማላልስያባ ኦይ?</para>
  <para style="q2" vid="PSA 88:10">ኡንቱንቱ ደንዲደ ኔና ጋላቲኖ?<verse eid="PSA 88:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11"/>አገና ነ ሲቁ</para>
  <para style="q2" vid="PSA 88:11">ዱፉዋ ግዶን ሃሳየቲ?</para>
  <para style="q2" vid="PSA 88:11">ኔን አማነትያዌካ ባየ ሳኣን ኦደቲ?<verse eid="PSA 88:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12"/>ነ ማላልስያ ኦሱካ ማን ኤረቲ?</para>
  <para style="q2" vid="PSA 88:12">ዎይ ነ ጽልቶተይ ዶገቴዳ አሳቱዋ ቢታን ደኢ?<verse eid="PSA 88:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13"/>አቤት መና ጎዳዉ፥ ታን ኔኮ ዋሳይ፤</para>
  <para style="q2" vid="PSA 88:13">ዎንታን ዎንታን ታ ዎሳይ ነ ስን ጋኬ።<verse eid="PSA 88:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14"/>አቤት መና ጎዳዉ፥ ታና ኔን አያዉ አጋይ?</para>
  <para style="q1" vid="PSA 88:14">ነ ሶምኡዋ ታፐ አያዉ ገንይ?<verse eid="PSA 88:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15"/>ያላጋተፐ ዶማደ፥</para>
  <para style="q2" vid="PSA 88:15">ታን ቱጋታድነ ሀይቃና ማታድ።</para>
  <para style="q1" vid="PSA 88:15">ታን ነዉ ዳጋማደ ሂዶታ ቃንጻድ።<verse eid="PSA 88:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16"/>ነ ሱልያ ሀንቁ ታ ቦላ ኡሾቴዳ፤</para>
  <para style="q2" vid="PSA 88:16">ነ ዳጋማይ ታና ባይዜዳ።<verse eid="PSA 88:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17"/>ኡንቱንቱ ጋላሳ ኡባ ድኡዋዳን ታና ዶዴድኖ፤</para>
  <para style="q2" vid="PSA 88:17">ታና ሙኬድኖ።<verse eid="PSA 88:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18"/>ኔን ታ ላገቱዋነ ታ ሲቆቱዋ ታፐ ሃሳዳ፤</para>
  <para style="q2" vid="PSA 88:18">ማ ጻላላይ ታዉ ዳቦ።<note caller="-" style="x"><char style="xo" closed="false">88:18 </char><char style="xt" closed="false"><ref loc="1KI 4:31">1 ካታ. 4:31</ref></char></note><verse eid="PSA 88:18"/></para>
  <chapter eid="PSA 88"/>
  <chapter number="89" style="c" sid="PSA 89"/>
  <para style="s1">መቱዋ ማዝሙርያ</para>
  <para style="d">ኤዝራህያ ኤታና አኬካን ጻፈቴዳ ግንጹዋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 89:1"/>አቤት መና ጎዳዉ፥ አገና ነ ሲቁዋባ፥</para>
  <para style="q2" vid="PSA 89:1">ታን መናዉ የጻና።</para>
  <para style="q1" vid="PSA 89:1">ጾሳይ አማነትያዋ ጋደ፥</para>
  <para style="q3" vid="PSA 89:1">የለታ ኡባዉ ታ ዶናን አዋያና።<verse eid="PSA 89:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2"/>ታን አገና ነ ሲቁ መናዉ ኤቄዳዋነ</para>
  <para style="q2" vid="PSA 89:2">ኔን ነ ቱማተ ሳሉዋዳን ምንሳደ ኤሴዳዋ ኦዳና።<verse eid="PSA 89:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3"/>ኔን፥ “ታን ዶሬዳዋና ጫቁዋ ጫቀታድ።</para>
  <para style="q2" vid="PSA 89:3">ታ ቆማ ዳዊታዉ ሀዋዳን ያጋደ ጫቃድ፤<verse eid="PSA 89:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4"/>‘ታን ነ ዘረ መናዉ ካዉና፤<note caller="-" style="x"><char style="xo" closed="false">89:4 </char><char style="xt" closed="false"><ref loc="2SA 7:12-16">2 ሳሜላ 7:12-16</ref>፤ <ref loc="1CH 17:11-14">1 ኦዱዋ 17:11-14</ref>፤ <ref loc="PSA 132:11">ማዝ. 132:11</ref>፤ <ref loc="ACT 2:30">ኪታ 2:30</ref></char></note></para>
  <para style="q2" vid="PSA 89:4">ነ ካዉተ አራታ የለታ ኡባዉ ምንሳና’ ” ያጋዳ።<verse eid="PSA 89:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5"/>አቤት መና ጎዳዉ፥ ሳሎቱ፥</para>
  <para style="q2" vid="PSA 89:5">ነ ማላልስያ ኦሱዋ ኦድኖ፤</para>
  <para style="q2" vid="PSA 89:5">ነ አማነትያዋ ኪታንቻቱዋ ሺቁ ኦድኖ።<verse eid="PSA 89:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6"/>ሳሉዋን መና ጎዳና ልከታናዉ ዳንዳይያዌ ኦኔ?</para>
  <para style="q2" vid="PSA 89:6">ሳሉዋ መተቱዋ ግዶን ቃይ መና ጎዳ ማል ኦኔ?<verse eid="PSA 89:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7"/>ጌሻቱዋ ሺቁዋ ግዶን ጾሳይ ያየቴዳዋ።</para>
  <para style="q2" vid="PSA 89:7">ባረና ዶዴዳዋንቱ ኡባፐ አደ፥ ሎይ ዳጋንያዋ።<verse eid="PSA 89:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8"/>አቤት ኡባፐ ዎልቃማ መና ጎዳዉ፥ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 89:8">ኔናዳን ዎልቃማይ ኦኔ?</para>
  <para style="q1" vid="PSA 89:8">አቤት መና ጎዳዉ፥ ኔን ኡባባንካ አማነትያዋ።<verse eid="PSA 89:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9"/>ኔን ቡልአከትያ አባ ዎልቃ አዛዛሳ።</para>
  <para style="q2" vid="PSA 89:9">ደንድያ ቤታካ ጮኡ ኦሳ።<verse eid="PSA 89:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10"/>ኔን ራኣባ ግያ አባ ዳዊያ፥</para>
  <para style="q2" vid="PSA 89:10">ዎ የጌዳዋዳን መንሬዳ፤</para>
  <para style="q2" vid="PSA 89:10">ነ ሞርከቱዋ ነ ዎልቃማ ቀስያን ላላዳ።<verse eid="PSA 89:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11"/>ሳሎቱ ነዋንታ፤ ሳአይካ ነዋ፤</para>
  <para style="q2" vid="PSA 89:11">ቢታነ አን ኩሜዳ ኡባባ ኔን መዳ።<verse eid="PSA 89:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12"/>ሁጲሳነ ገድሳ ኔን መዳ፤</para>
  <para style="q2" vid="PSA 89:12">ታቦራነ ሄርሞነ ግያ ዎልቃማ ደረቱ</para>
  <para style="q2" vid="PSA 89:12">ናሸቻን ነ ሱን ሳቢኖ።<verse eid="PSA 89:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13"/>ነዉ ዎልቃማ ቄሲ ደኤ፤</para>
  <para style="q2" vid="PSA 89:13">ነ ኩሺ ምና፤</para>
  <para style="q2" vid="PSA 89:13">ነ ኡሸቻይ ዎልቃማ።<verse eid="PSA 89:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14"/>ጽሎተይነ ሱረ ፕርዳይ</para>
  <para style="q2" vid="PSA 89:14">ነ ካዉተ አራታዉ ባሶ።</para>
  <para style="q1" vid="PSA 89:14">አገና ሲቁነ ቱማተይ ነ ስንን ቢኖ።<verse eid="PSA 89:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15"/>አቤት መና ጎዳዉ፥ ናሸቻን እልልያዋንቱነ</para>
  <para style="q2" vid="PSA 89:15">ነ ሶምኡዋ ፖኡዋን ሀመትያዋንቱ አንጀቴዳዋንታ።<verse eid="PSA 89:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16"/>ነ ሱንን ጋላሳ ኡባ ናሸቲኖ፤</para>
  <para style="q2" vid="PSA 89:16">ነ ጽሎተ ድራዉ፥</para>
  <para style="q2" vid="PSA 89:16">ኡንቱንቱ ኔና ቁ ቁ ኦኖ።<verse eid="PSA 89:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17"/>ኡንቱንቱ ጬቀትያ ዎልቃይ ኔና፤</para>
  <para style="q2" vid="PSA 89:17">ነ ናሹዋን ኑ ካጪ ቁ ቁ ያጌዳ።<verse eid="PSA 89:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18"/>ኑ ጎንዳሊ፥ ኑ መና ጎዳሳ፤</para>
  <para style="q2" vid="PSA 89:18">ኑ ካቲካ፥ እስራኤልያ ጌሻ ሳ።<verse eid="PSA 89:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19"/>በን ኔን ነ አማነቴዳ አሳቶ፥</para>
  <para style="q2" vid="PSA 89:19">እት ገደ አኩሙዋን ኦዳዳ፤</para>
  <para style="q1" vid="PSA 89:19">“አሳ ግዶፐ ዶሬዳዎ ካዉተ አራታ እማዳ።<verse eid="PSA 89:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20"/>ታ ቆማ ዳዊታ ካተ ከሳድ፤<note caller="-" style="x"><char style="xo" closed="false">89:20 </char><char style="xt" closed="false"><ref loc="1SA 13:14">1 ሳሜላ 13:14</ref>፤ <ref loc="ACT 13:22">ኪታ 13:22</ref>፤ <ref loc="1SA 16:12">1 ሳሜላ 16:12</ref></char></note></para>
  <para style="q2" vid="PSA 89:20">ታ ጌሻ ዛይትያን ኦካደ።<verse eid="PSA 89:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21"/>ታ ኩሺ አናና ደአና፤</para>
  <para style="q2" vid="PSA 89:21">ታ ቀሲካ አ ምንና።<verse eid="PSA 89:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22"/>አ አይ ሞርኪነ ጾነና፤</para>
  <para style="q2" vid="PSA 89:22">አይ ኢታ አሳይነ አ ቶቼና።<verse eid="PSA 89:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23"/>ታን አ ሞርከቱዋ አ ስንን ክንቼሬና፤</para>
  <para style="q2" vid="PSA 89:23">አ እጽያዋንታ ሾጫ የጋና።<verse eid="PSA 89:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24"/>ታ ቱማተይነ ታ አገና ሲቁ</para>
  <para style="q2" vid="PSA 89:24">አናና እትፐ ግዳና።</para>
  <para style="q1" vid="PSA 89:24">ታ ሱንን አ ካጪ ቁ ቁ ጋና።<verse eid="PSA 89:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25"/>ታን አ ካዉተ መደትራንያ አባ ጋካናዉ አሳና፤</para>
  <para style="q2" vid="PSA 89:25">አ ዛዋካ፥</para>
  <para style="q1" vid="PSA 89:25">ኤፍራጼሰነ ጸግሮሰ ሻፋ ጋካናዉ አሳና።<verse eid="PSA 89:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26"/>ዳዊተ ታና፥ ‘ኔን ታ አዉዋ፥</para>
  <para style="q2" vid="PSA 89:26">ታ ጾሳነ ታና አሽያ ዛላ’ ያጊደ ጼሳና።<verse eid="PSA 89:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27"/>ታን አ ባይራ ናኣ ኦና፤<note caller="-" style="x"><char style="xo" closed="false">89:27 </char><char style="xt" closed="false"><ref loc="PSA 1:5">1:5</ref></char></note></para>
  <para style="q2" vid="PSA 89:27">ሳኣን ደእያ ካተቱዋ ኡባፐ አ ዳርሳና።<verse eid="PSA 89:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28"/>ታን አገና ታ ሲቁዋ</para>
  <para style="q2" vid="PSA 89:28">አዉ መናዉ ናጋና።</para>
  <para style="q1" vid="PSA 89:28">ታን አናና ቃላ ጫቁዋ ምንና።<verse eid="PSA 89:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29"/>ታን አ ዘረ መናዉ ምንሳደ ኤሳና፤</para>
  <para style="q2" vid="PSA 89:29">አ ካዉተ አራታካ ሳሉዋዳን ጋምኤና።<verse eid="PSA 89:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30"/>“ሽን አ ዘረቱ ታ ህግያ አጎፐ፥</para>
  <para style="q2" vid="PSA 89:30">ቃይ ኡንቱንቱ ታ ዎጋዳን ሀመተናን እጾፐ፥<verse eid="PSA 89:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 89:31"/>ኡንቱንቱ ታ አዋዩዋ ሻሮፐ፥</para>
  <para style="q2" vid="PSA 89:31">ታ አዛዙዋ ናጋና ዮፐ፥<verse eid="PSA 89:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 89:32"/>ታን ኡንቱንቱ ናጋራ ድራዉ ጋትማን፥</para>
  <para style="q2" vid="PSA 89:32">ኡንቱንቱ ኢታተ ድራዉ፥ ልሱዋን፥</para>
  <para style="q2" vid="PSA 89:32">ሾጫደ ሙራና።<verse eid="PSA 89:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33"/>ሽን ታን አገና ታ ሲቁዋ አፐ አክከ፤</para>
  <para style="q2" vid="PSA 89:33">ዎይ ታን አዉ አማነትያዋ አግከ።<verse eid="PSA 89:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34"/>ታን ኡንቱንቱና ጫቀቴዳ ጫቁዋ ኮልከ፤</para>
  <para style="q2" vid="PSA 89:34">ታ ዶናፐ ከሴዳ ቃላ ላምከ።<verse eid="PSA 89:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35"/>“እት ገደካ መናዉ</para>
  <para style="q2" vid="PSA 89:35">ታ ጌሻተን ጫቃ ድጋድ፤</para>
  <para style="q1" vid="PSA 89:35">ዳዊተዉ ዎርዶትከ።<verse eid="PSA 89:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36"/>ሄዌነ፥ አ ዘረይ መናዉ ደአና፤</para>
  <para style="q2" vid="PSA 89:36">አ ካዉተ አራታይካ ታ ስንን አዋዳን ጋምአና።<verse eid="PSA 89:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37"/>ሳሉዋን አማነትያ ማርካ ግድያ አግናዳን፥</para>
  <para style="q2" vid="PSA 89:37">ሄ ካዉተይ መናዉ ምን ኤቂ ደአና” ያጋዳ።<verse eid="PSA 89:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38"/>ሽን ሀእ ኔን</para>
  <para style="q2" vid="PSA 89:38">ኦካደ ካተዬዳዋ ቦላ ዳሮ ሀንቀታዳ፤</para>
  <para style="q1" vid="PSA 89:38">አ እጻዳነ አጋዳ።<verse eid="PSA 89:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39"/>ኔን ነ ቆማና ጫቀቴዳ ጫቁዋ ካዳዳ፤</para>
  <para style="q2" vid="PSA 89:39">አ ካላቻ ባናን ኦላደ ቱንሳዳ።<verse eid="PSA 89:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40"/>ኔን አ ካታማ ግምቢያ ኡባ ላላዳ፤</para>
  <para style="q2" vid="PSA 89:40">እ ናገትያ ሚጻ ኡባ ባይዛዳ።<verse eid="PSA 89:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41"/>ኦግያና አያ ኡባቱ አ ቦንቄድኖ፤</para>
  <para style="q2" vid="PSA 89:41">እ ባረ ሾሮቶ ቅሊጮ ግዴዳ።<verse eid="PSA 89:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42"/>ኔን አ ሞርከቶ ጾኑዋ እማዳ፤</para>
  <para style="q2" vid="PSA 89:42">ኡንቱንታ ኡባቱዋ ናሸቻዳ።<verse eid="PSA 89:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43"/>ኔን አ ማሻ ጼራ ቃላምኣዳ፤</para>
  <para style="q2" vid="PSA 89:43">ኔን ኦላን አ ማዳባካ።<verse eid="PSA 89:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44"/>ኔን አ ካዉታ ጻምኣ</para>
  <para style="q2" vid="PSA 89:44">አ ኩሽያፐ ዎ አካዳ፤</para>
  <para style="q2" vid="PSA 89:44">ቃይ አ ካዉተ አራታ ቢታን ኦላዳ።<verse eid="PSA 89:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45"/>ኔን አ ያላጋተ ዎድያ ቃምሳዳ፤</para>
  <para style="q2" vid="PSA 89:45">ቃይ አ ዬላ ማይዛዳ።<verse eid="PSA 89:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46"/>አቤት መና ጎዳዉ፥ አዉደ ጋካናዉ ቆንጭኪ?</para>
  <para style="q2" vid="PSA 89:46">ኔን መናዉ ጌማይ?</para>
  <para style="q1" vid="PSA 89:46">ነ ሀንቁ ታማዳን አዉደ ጋካናዉ ኤጻኔ?<verse eid="PSA 89:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47"/>ታ ላይይ አይ ኬሻ ቃንንቶ ቆፓ፤</para>
  <para style="q2" vid="PSA 89:47">አሳ ኡባ ጮ መላ መዲ?<verse eid="PSA 89:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48"/>አሳይ ሀይቀናን ጮ ደአናዉ ዋን ዳንዳዪ?</para>
  <para style="q1" vid="PSA 89:48">ቃይ ዱፉዋን ገለናዳን፥</para>
  <para style="q2" vid="PSA 89:48">ባረና አሻናዉ ዋን ዳንዳዪ?<verse eid="PSA 89:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49"/>አቤት ጎዳዉ፥ ኔን ነ ቱማተን ዳዊተዉ ጫቄዳ፥</para>
  <para style="q2" vid="PSA 89:49">አገና በን ነ ሲቁ ሀቃን ደኢ?<verse eid="PSA 89:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50"/>አቤት ጎዳዉ፥ ነ ቆማይ</para>
  <para style="q2" vid="PSA 89:50">ዎይሳ ቦረቴደንቶ ኔን ሀሳያ።</para>
  <para style="q1" vid="PSA 89:50">ታን አሳ ኡባ ቦርያ ዎታ ዳንዳያድታንቶ ቆፓ።<verse eid="PSA 89:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51"/>አቤት መና ጎዳዉ፥ ሞርከቱ ቅሊጬድኖ፤</para>
  <para style="q2" vid="PSA 89:51">ኔን ዶራደ ኦኬዳ ካትያ፥</para>
  <para style="q2" vid="PSA 89:51">ታንጉዋን ታንጉዋን ቅሊጬዳዋ ቆፓ።<verse eid="PSA 89:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52"/>መና ጎዳይ መ መናዉ ጋላተቶ!</para>
  <para style="q2" vid="PSA 89:52">አመንእ። አመንእ።<verse eid="PSA 89:52"/></para>
  <chapter eid="PSA 89"/>
  <chapter number="90" style="c" sid="PSA 90"/>
  <para style="ms">ኦይደን ማጻፋ</para>
  <para style="mr">(<ref loc="PSA 90-106">90—106</ref>)</para>
  <para style="s1">አሳ ናኣ ደኡዋ</para>
  <para style="d">ጾሳ አሳይ ሙሴ ዎሴዳ ዎሳ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1"/>ጎዳዉ፥ ኔን የለታ ኡባን፥</para>
  <para style="q2" vid="PSA 90:1">ኑን ደእያ ሳኣ ግዳዳ።<verse eid="PSA 90:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2"/>ደረቱ መታናፐ ካሰ፥</para>
  <para style="q2" vid="PSA 90:2">ዎይ ኔን ሳኣ ኦናፐ ካሰ፥</para>
  <para style="q2" vid="PSA 90:2">መናፐ መና ጋካናዉካ ኔን ጾሳ።<verse eid="PSA 90:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3"/>ኔን አሳ ናናቱዋ፥ “አሳ ናቶ፥</para>
  <para style="q2" vid="PSA 90:3">ጉየ ቢታዉ ስምተ” ያጋደ፥</para>
  <para style="q2" vid="PSA 90:3">ኡንቱንታ ጉየ ኡንቱንቱ መቴዳ ቢታዉ ዛራሳ።<verse eid="PSA 90:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4"/>ሻኡ ላይይ ነዉ ዝን አ ጋላሳ ማላ፤<note caller="-" style="x"><char style="xo" closed="false">90:4 </char><char style="xt" closed="false"><ref loc="2PE 3:8">2 ጰጽ. 3:8</ref></char></note></para>
  <para style="q2" vid="PSA 90:4">ዎይ ቃማ ግዶፐ እት ሳትያ ማላ።<verse eid="PSA 90:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5"/>ኔን አሳ ቆፐናን ድኡዋዳን አፋሳ።</para>
  <para style="q2" vid="PSA 90:5">ኡንቱንቱ አኩሙዋ ማላ፤</para>
  <para style="q2" vid="PSA 90:5">ዎንታ ዎንታ ዶልያ ማታ ማላ።<verse eid="PSA 90:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6"/>ሄ ማታይካ ዎንታ ዎደ ድጪደ ጪሼ፤</para>
  <para style="q2" vid="PSA 90:6">ኦማርስያ ዎደ ሹል መሌ።<verse eid="PSA 90:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7"/>ኑን ነ ይሉዋን ዉሬዶ፤</para>
  <para style="q2" vid="PSA 90:7">ነ ሀንቁዋ ሱሉዋን ዳጋሜዶ።<verse eid="PSA 90:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8"/>ኔን ኑ ኢታ ኦሱዋ</para>
  <para style="q2" vid="PSA 90:8">ነ ስንን ዎዳ፤</para>
  <para style="q2" vid="PSA 90:8">ቃይ ኑ ጌሜዳ ናጋራ</para>
  <para style="q2" vid="PSA 90:8">ነ ስን ፖኡዋኮ አዳ።<verse eid="PSA 90:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9"/>ኑ ጋላሳ ኡባይ ነ ሀንቁዋን አዳ፤</para>
  <para style="q2" vid="PSA 90:9">ኑ ላይ እት ኦልያዳን ዉርሴዶ።<verse eid="PSA 90:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10"/>ኑ ደኡዋ ላይይ ላፑን ታማ፤</para>
  <para style="q2" vid="PSA 90:10">ዎይ ምኖፐ፥ ሆስፑን ታማ፤</para>
  <para style="q2" vid="PSA 90:10">ሄዌካ መቱዋነ ቱጋ።</para>
  <para style="q2" vid="PSA 90:10">ኑ ላይይ ኤለካ አ፤</para>
  <para style="q2" vid="PSA 90:10">ኑንካ ኤለካ ክቼቶ።<verse eid="PSA 90:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11"/>ነ ሀንቁዋ ዎልቃ ኤርያዌ ኦኔ?</para>
  <para style="q2" vid="PSA 90:11">ነ ሀንቁዋ ሱሉ ያሽያዋ።<verse eid="PSA 90:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12"/>ሄዋ ድራዉ፥ ኑ ላይ በስያዋዳን፥</para>
  <para style="q2" vid="PSA 90:12">ጎኤታና ማላ አዳ ኤራ ኑና ታማርሳ።<verse eid="PSA 90:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13"/>አቤት መና ጎዳዉ፥ ነ ሀንቁ አዉደ ጋካናሴ?</para>
  <para style="q2" vid="PSA 90:13">ሀያና፤ ነ ቆማቶ ቃረታ!<verse eid="PSA 90:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14"/>ኑ ላይ ኡባን</para>
  <para style="q2" vid="PSA 90:14">ኑን ናሸታናዳንነ የጻናዳን፥</para>
  <para style="q2" vid="PSA 90:14">ዎንታ ዎንታ አገና ነ ሲቁዋን ኑና ካልሳ።<verse eid="PSA 90:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15"/>ኔን ኑና መቶዬዳ ጋላሳቱዋ ኬሻነ</para>
  <para style="q2" vid="PSA 90:15">ኑን ቱጋ በኤዳ ላይቱዋ ኬሻ፥</para>
  <para style="q2" vid="PSA 90:15">ኑና ናሸቻ።<verse eid="PSA 90:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16"/>ኑዉ ነ ቆማቶ ነ ኦሱ ቆንጮ፤</para>
  <para style="q2" vid="PSA 90:16">ነ ቦንቾ ዎልቃይ ኡንቱንቱ ናናቶ ቤቶ።<verse eid="PSA 90:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17"/>ጎዳ ኑ ጾሳ ኬካተይ ኑ ቦላን ግዶ፤</para>
  <para style="q2" vid="PSA 90:17">ኑ ኩሽያ ኦሱዋ ኑዉ ሱርሳ።</para>
  <para style="q1" vid="PSA 90:17">ኤ፥ ኑ ኩሽያ ኦሱዋ ሱርሳ።<verse eid="PSA 90:17"/></para>
  <chapter eid="PSA 90"/>
  <chapter number="91" style="c" sid="PSA 91"/>
  <para style="s1">ጾሳይ ኑና ናግያዋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 91:1"/>ኡባፐ ቂያ ጾሳን ናገቲደ ደእያዌ፥</para>
  <para style="q2" vid="PSA 91:1">ኡባፐ ዎልቃማ ጾሳ ኩዋ ግዶን አቄ፤<verse eid="PSA 91:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2"/>መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 91:2">“ኔን ታዉ ጌሱዋነ ባቃታ አትያ ሳኣ፤</para>
  <para style="q2" vid="PSA 91:2">ኔን ታን አማንያ ታ ጾሳ” ያጋና።<verse eid="PSA 91:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3"/>እ ኔና ሻንካንቻቱዋ ግትያፐካ፥</para>
  <para style="q2" vid="PSA 91:3">ዎ ዉርስያ ኢታ ሀርግያፐካ አሻና።<verse eid="PSA 91:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4"/>እ ባረ ባለቱዋን ኔና ካማና፤</para>
  <para style="q2" vid="PSA 91:4">አ ቀፈቱዋ ጋርሳ ኔን ባቃታደ ቆሰታ አታና።</para>
  <para style="q1" vid="PSA 91:4">አ አማነቱሳይ ነዉ ጎንዳለ።<verse eid="PSA 91:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5"/>ኔን ቃማ ዳጋንያባዉ፥</para>
  <para style="q2" vid="PSA 91:5">ዎይ ጋላስ ጾንገትያባዉ ያያካ፤<verse eid="PSA 91:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6"/>ዎይ ማን ኦይቂያ ሀርግያዉ፥</para>
  <para style="q2" vid="PSA 91:6">ዎይ ጋላሳ ሴታን ዉርስያ ኢታ ሀርግያ ህርጋካ።<verse eid="PSA 91:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7"/>ሻአይ ነ ምይያን፥</para>
  <para style="q2" vid="PSA 91:7">ቃይ ታሙ ሻአይ ኔፐ ኡሸቻ ባጋና ኩንዳና፤</para>
  <para style="q2" vid="PSA 91:7">ሽን ኔና አያይነ ቦቼና።<verse eid="PSA 91:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8"/>ኔን ነ አይፍያ ጻላላን ጼላና፤</para>
  <para style="q2" vid="PSA 91:8">ኢታቱ ሙረትያዋካ በአና።<verse eid="PSA 91:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9"/>መና ጎዳ ኔን ነዉ ባቃታ አትያ ሳኣ ኦዳ ድራዉነ፥</para>
  <para style="q2" vid="PSA 91:9">ኡባፐ ቂያ ጾሳ ነዉ፥</para>
  <para style="q2" vid="PSA 91:9">ደእያ ሳኣ ኦዳ ድራዉ፥<verse eid="PSA 91:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10"/>ኢታባይ ኔና ቦቼና፤</para>
  <para style="q2" vid="PSA 91:10">ቦሻይካ ነ ጎልያ ሺቀና።<verse eid="PSA 91:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11"/>አያዉ ጎፐ፥ ነ ኦግያን ኡባን</para>
  <para style="q2" vid="PSA 91:11">ኔና ናጋና ማላ፥<note caller="-" style="x"><char style="xo" closed="false">91:11 </char><char style="xt" closed="false"><ref loc="MAT 4:6">ማቶሳ 4:6</ref>፤ <ref loc="LUK 4:10">ሉቃሳ 4:10</ref></char></note></para>
  <para style="q1" vid="PSA 91:11">ጾሳይ ባረ ኪታንቻቱዋ አዛዛና።<verse eid="PSA 91:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12"/>ነ ገዲ ሹቻን በተና ማላ፥<note caller="-" style="x"><char style="xo" closed="false">91:12 </char><char style="xt" closed="false"><ref loc="MAT 4:6">ማቶሳ 4:6</ref>፤ <ref loc="LUK 4:11">ሉቃሳ 4:11</ref></char></note></para>
  <para style="q2" vid="PSA 91:12">ኪታንቻቱ ባረንቱ ኩሽያን ኔና ደንና።<verse eid="PSA 91:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13"/>ኔን ጋሙዋነ ሾሻ ቦላን ሄመታና፤<note caller="-" style="x"><char style="xo" closed="false">91:13 </char><char style="xt" closed="false"><ref loc="LUK 10:19">ሉቃሳ 10:19</ref></char></note></para>
  <para style="q2" vid="PSA 91:13">ቃይ ዎዳላ ጋሙዋነ ዎያ ሾሻ ኔን የና።<verse eid="PSA 91:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14"/>መና ጎዳይ ሀዋዳን ያጌ፤</para>
  <para style="q2" vid="PSA 91:14">“እ ታና ሲቄዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 91:14">ታን አ አሻና።</para>
  <para style="q2" vid="PSA 91:14">እ ታ ሱን ኤሬዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 91:14">ታን አ ናጋና።<verse eid="PSA 91:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15"/>እ ታና ጼግያ ዎደ፥</para>
  <para style="q2" vid="PSA 91:15">ታን አዉ ኮያና።</para>
  <para style="q1" vid="PSA 91:15">መቱዋን ታን አናና እትፐ ግዳና፤</para>
  <para style="q2" vid="PSA 91:15">ታን አ አሻናነ ቦንቻና።<verse eid="PSA 91:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16"/>ታን አ ላይ አዱሳደ ካልሳና፤</para>
  <para style="q2" vid="PSA 91:16">ታ አቶተ አ በሳና” ያጌ።<verse eid="PSA 91:16"/></para>
  <chapter eid="PSA 91"/>
  <chapter number="92" style="c" sid="PSA 92"/>
  <para style="s1">ጋላታ ማዝሙርያ</para>
  <para style="d">ማዝሙርያ፥ ሳምባታ ጋላሳዉ የጽያዋ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 92:1"/>መና ጎዳ ጋላትያዌ ሎአ።</para>
  <para style="q2" vid="PSA 92:1">አቤት ኡባፐ ቂያ ጾሳዉ፥</para>
  <para style="q3" vid="PSA 92:1">ነ ሱን ሳቢያዌ ሎአ።<verse eid="PSA 92:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2"/>ዎንታን አገና ነ ሲቁዋ፥</para>
  <para style="q2" vid="PSA 92:2">ቃማን ነ አማነትያዋ ግድያዋ አዋይያዌ ሎአ።<verse eid="PSA 92:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3"/>ታሙ ባቀን ዋጸቴዳ ዲነ፥</para>
  <para style="q2" vid="PSA 92:3">ማስንቁዋን ዲጽያዌ ሎአ።<verse eid="PSA 92:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4"/>አያዉ ጎፐ፥ አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 92:4">ነ ዎልቃማ ኦሱዋን</para>
  <para style="q2" vid="PSA 92:4">ታና ናሸቼዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 92:4">ነ ኩሽያ ኦሱዋ ድራዉ፥</para>
  <para style="q2" vid="PSA 92:4">ታን ናሸቻዉ የጻይ።<verse eid="PSA 92:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5"/>አቤት መና ጎዳዉ፥ ነ ኦሱ አይ ኬሻ ግቴ!</para>
  <para style="q2" vid="PSA 92:5">ነ ቆፋይ አይ ኬሻ ጪሜ!<verse eid="PSA 92:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6"/>ኤያ አሳይ ኤራናዉ ዳንዳየና፤</para>
  <para style="q2" vid="PSA 92:6">ዶንጭሌዳ አሳይካ አኬካናዉ ዳንዳየና።<verse eid="PSA 92:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7"/>ሄዌነ፥ ኢታቱ ማታዳን ድጮፐካ፥</para>
  <para style="q2" vid="PSA 92:7">ኢታ ኦያ ኡባቱ ዳሾፐካ፥</para>
  <para style="q2" vid="PSA 92:7">ኡንቱንቱ መናዉ ያና።<verse eid="PSA 92:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8"/>ሽን አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 92:8">ኔን መናዉ ኡባፐ ቃ።<verse eid="PSA 92:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9"/>አቤት መና ጎዳዉ፥ ነ ሞርከቱ ያናዋነ</para>
  <para style="q2" vid="PSA 92:9">ኢታ ኦያ ኡባቱ ትስክ ጋናዋ ኑን ኤረቶ።<verse eid="PSA 92:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10"/>ታ ካጭያ ባዙዋ መን ካጭያዳን ቂሳዳ፤</para>
  <para style="q2" vid="PSA 92:10">ሎኦ ዛይትያ ታና ኦካዳ።<verse eid="PSA 92:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11"/>ታ ሞርከቱ ጾነቴዳዋ ታ አይፍያን በኣድ፤</para>
  <para style="q2" vid="PSA 92:11">ታ ኢታ ሞርከቱዋ ዋሱዋ ታ ሀይን ስሳድ።<verse eid="PSA 92:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12"/>ጽሎቱ ዛምባዳን ዳሻና፤</para>
  <para style="q2" vid="PSA 92:12">ቃይ ሊባኖሳ ዝጋዳን ድጫና።<verse eid="PSA 92:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13"/>ኡንቱንቱካ መና ጎዳ ዳባባን ቶከቴዳ ም ማላ፤</para>
  <para style="q2" vid="PSA 92:13">ኡንቱንቱ ኑ ጾሳ ጌሻ ጎልያን ዳሻና።<verse eid="PSA 92:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14"/>ኡንቱንቱ ኤጪደካ አይፋና፤</para>
  <para style="q2" vid="PSA 92:14">ኡንቱንቱ መናዉ እርጻነ ፓጻ።<verse eid="PSA 92:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15"/>ኡንቱንቱ፥ “መና ጎዳይ ሱረ፤</para>
  <para style="q2" vid="PSA 92:15">እ ታዉ ዎጋ ዛላ፤ ኢታተ አን ባዋ” ያጋና።<verse eid="PSA 92:15"/></para>
  <chapter eid="PSA 92"/>
  <chapter number="93" style="c" sid="PSA 93"/>
  <para style="s1">ጾሳይ ካትያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1"/>መና ጎዳይ ካተቴዳ!</para>
  <para style="q2" vid="PSA 93:1">መና ጎዳይ ቦንቹዋ ማዬዳ፤</para>
  <para style="q3" vid="PSA 93:1">ዎልቃ ዳንጬዳ።</para>
  <para style="q3" vid="PSA 93:1">ሳአይ ምኒደ ኤቄዳ፤ ኡባካ ቃጸና።<verse eid="PSA 93:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2"/>ነ ካዉተ አራታይ በኒደፐ ኤቄዳ፤</para>
  <para style="q2" vid="PSA 93:2">ኔን መናደፐ ደኣሳ።<verse eid="PSA 93:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3"/>አቤት መና ጎዳዉ፥ ጪሞ ሻፋቱ ጉሜዳ፤</para>
  <para style="q2" vid="PSA 93:3">ጪሞ ሻፋቱ ባረ ጉን ቁ ኦዳ።<verse eid="PSA 93:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4"/>ሳሉዋን ደእያ መና ጎዳይ ዳሮ ሃ ጉንፐካ፥</para>
  <para style="q2" vid="PSA 93:4">አባ በታቱዋፐካ አዳ ዎልቃማ።<verse eid="PSA 93:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5"/>አቤት መና ጎዳዉ፥ ኔን ኦዴዳባይ አማነትያዋ፤</para>
  <para style="q2" vid="PSA 93:5">ነ ጎሊ መናዉ ጌሻተን አሌቃና።<verse eid="PSA 93:5"/></para>
  <chapter eid="PSA 93"/>
  <chapter number="94" style="c" sid="PSA 94"/>
  <para style="s1">ጾሳይ ኡባ ቦላ ፕርድያዋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1"/>አቤት መና ጎዳዉ፥ ኔን ኩሽያ ጭገትያ ጾሳ።</para>
  <para style="q2" vid="PSA 94:1">አቤት ኩሽያ ጭገትያ ጾሳዉ፥ ነ ቦንቹዋ በሳ።<verse eid="PSA 94:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2"/>አቤት ሳኣ ፕርድያዎ፥ ደንዳ፤</para>
  <para style="q2" vid="PSA 94:2">ኦቶራንቻቶ በስያ ሙሩዋ እማ።<verse eid="PSA 94:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3"/>አቤት መና ጎዳዉ፥ አዉደ ጋካናዉ ጋምአኔ?</para>
  <para style="q2" vid="PSA 94:3">ኢታቱ አዉደ ጋካናዉ ናሸታኔ?<verse eid="PSA 94:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4"/>ኢታ ኦያ ኡባቱ፥</para>
  <para style="q2" vid="PSA 94:4">ባረንቱ ኦቶሮ ቃላ ሃሳዪኖ፤</para>
  <para style="q2" vid="PSA 94:4">ኡንቱንቱ ጬቀቲኖ።<verse eid="PSA 94:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5"/>አቤት መና ጎዳዉ፥ ኡንቱንቱ ነ አሳ ሊቂሲኖ፤</para>
  <para style="q2" vid="PSA 94:5">ነ ላታ ናቂኖ።<verse eid="PSA 94:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6"/>ኡንቱንቱ አምኤቱዋነ በተቱዋ ዎኖ፤</para>
  <para style="q2" vid="PSA 94:6">አዉ ባይናዋንታካ ዎኖ።<verse eid="PSA 94:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7"/>ያቲደ ኡንቱንቱ፥ “መና ጎዳይ ኑና በኤና፤</para>
  <para style="q2" vid="PSA 94:7">ያቆባ ጾሳይ አኬከና” ያጊኖ።<verse eid="PSA 94:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8"/>ህንተኖ፥ አሳ ግዶፐ አዳ ዳማቶ፥ አኬክተ!</para>
  <para style="q2" vid="PSA 94:8">ህንተኖ ኤያቶ፥ አዉደ ኤራንቻ ግዳንቴ?<verse eid="PSA 94:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9"/>ሀይ መዳ ጾሳይ ስሰኔ?</para>
  <para style="q2" vid="PSA 94:9">አይፍያ መዳዌ በኤኔ?<verse eid="PSA 94:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10"/>ካዉተ ሴርያዌ ሙረኔ?</para>
  <para style="q2" vid="PSA 94:10">አሳ ኤራ ታማርስያዌ ባረዉ ኤረኔ?<note caller="-" style="x"><char style="xo" closed="false">94:10 </char><char style="xt" closed="false"><ref loc="1CO 3:20">1 ቆሮ. 3:20</ref></char></note><verse eid="PSA 94:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11"/>መና ጎዳይ አሳ ቆፋይ መላ ግድያዋ ኤሬ።<verse eid="PSA 94:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12"/>አቤት መና ጎዳዉ፥ ኔን ሴርያዌነ</para>
  <para style="q2" vid="PSA 94:12">ነ ህግያፐ ታማርስያ አሳይ አንጀቴዳዋ።<verse eid="PSA 94:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13"/>ኢታቱ ኩንድያ ኦላይ ቦከታና ጋካናዉ፥</para>
  <para style="q2" vid="PSA 94:13">መቱ ጋክያ ጋላሳን ኔን አ ሸምፕሳሳ።<verse eid="PSA 94:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14"/>መና ጎዳይ ባረ አሳ አገና፤</para>
  <para style="q2" vid="PSA 94:14">እ ባረ ላታ አገና።<verse eid="PSA 94:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15"/>ፕርዳይ ስሚደ ጽሎ ፕርዳ ግዳናዋ፤</para>
  <para style="q2" vid="PSA 94:15">ዎዛና ሱረቱ ኡባይ ሄ ጽሎ ፕርዳ ማዳና።<verse eid="PSA 94:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16"/>ማካላንቻቱዋ ቦላ</para>
  <para style="q2" vid="PSA 94:16">ታ ድራዉ ደንድያዌ ኦኔ?</para>
  <para style="q1" vid="PSA 94:16">ኢታ ኦያዋንቱና</para>
  <para style="q2" vid="PSA 94:16">ታ ድራዉ ኤቀቴዳዌ ኦኔ?<verse eid="PSA 94:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17"/>መና ጎዳይ ታና ማደነንቶ፥</para>
  <para style="q2" vid="PSA 94:17">ታን ኤለካ ዱፉዋን ገላደ ስርጵ ጋና ሽን።<verse eid="PSA 94:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18"/>አቤት መና ጎዳዉ፥ ታን፥</para>
  <para style="q2" vid="PSA 94:18">“ታ ገዲ ሀልጼ” ያጌዳ ዎደ፥</para>
  <para style="q2" vid="PSA 94:18">አገና ነ ሲቁ ታዉ ዘምፖ ግዴዳ።<verse eid="PSA 94:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19"/>ታና ህርጋይ ዎያ ዎደ፥</para>
  <para style="q2" vid="PSA 94:19">ኔን ታና ዎፑ ኦደ ናሸቻሳ።<verse eid="PSA 94:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20"/>ህግያ ባለያ ጌላ ዳናቱዋና</para>
  <para style="q2" vid="PSA 94:20">ኔን ዙፐታይ?<verse eid="PSA 94:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21"/>ጽሎቱዋ ዎናዉ ኡንቱንቱ እትፐ ቶበቲኖ፤</para>
  <para style="q2" vid="PSA 94:21">ሱረቱዋ ቦላ ሀይቁዋ ፕርዲኖ።<verse eid="PSA 94:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22"/>ግዶፐነ፥ መና ጎዳይ ታን ባቃታ አቴዳ ሳኣ፤</para>
  <para style="q2" vid="PSA 94:22">ታ ጾሳይ ታን ቆሰትያ ዛላ።<verse eid="PSA 94:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23"/>ኡንቱንቱ ኢታተ ድራዉ፥ እ ኡንቱንታ ሙራና፤</para>
  <para style="q2" vid="PSA 94:23">ኡንቱንቱ ናጋራ ድራዉ፥ እ ኡንቱንታ ይሳና፤</para>
  <para style="q2" vid="PSA 94:23">ኤ፥ መና ጎዳይ ኑ ጾሳይ ኡንቱንታ ይሳና።<verse eid="PSA 94:23"/></para>
  <chapter eid="PSA 94"/>
  <chapter number="95" style="c" sid="PSA 95"/>
  <para style="s1">ጋላሳ ጋላሳ ማዝሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1"/>ሃይተ፤ አነ መና ጎዳ ሳቦይተ።</para>
  <para style="q2" vid="PSA 95:1">ኑና አሽያ ዛላዉ ናሸቻዉ የጾይተ።<verse eid="PSA 95:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2"/>አ ስን ጋላታና ሺቆይተ።</para>
  <para style="q2" vid="PSA 95:2">ጋላታ የ ናሸቻን የጾይተ።<verse eid="PSA 95:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3"/>አያዉ ጎፐ፥ መና ጎዳይ ዎልቃማ ጾሳ፥</para>
  <para style="q2" vid="PSA 95:3">ጾሳቱዋ ኡባ ቦላ ዎልቃማ ካትያ።<verse eid="PSA 95:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4"/>ቢታ ጪማቱ አ ኩሽያን ደኢኖ፤</para>
  <para style="q2" vid="PSA 95:4">ደርያ ሁጰቱካ አዋ።<verse eid="PSA 95:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5"/>አባ ሃይካ አዋ፤</para>
  <para style="q2" vid="PSA 95:5">ሄዋ እ መዳ፤</para>
  <para style="q2" vid="PSA 95:5">መላ ቢታካ አ ኩሺ ኦዳ።<verse eid="PSA 95:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6"/>ሃይተ፤ ሆኪደ አነ አዉ ጎይኖይተ፤</para>
  <para style="q2" vid="PSA 95:6">ኑና መዳ መና ጎዳ ስንን ጉልባቶይተ።<verse eid="PSA 95:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7"/>አያዉ ጎፐ፥ እ ኑ ጾሳ።<note caller="-" style="x"><char style="xo" closed="false">95:7-8 </char><char style="xt" closed="false"><ref loc="HEB 3:15">እብራ. 3:15</ref>፤ <ref loc="HEB 4:7">4:7</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">95:7-11 </char><char style="xt" closed="false"><ref loc="HEB 3:7-11">እብራ. 3:7-11</ref></char></note></para>
  <para style="q2" vid="PSA 95:7">ኑን አ ቆሩዋን ደእያ አሳቱዋ፤</para>
  <para style="q2" vid="PSA 95:7">ኑን እ ሄምያ አ ዶርሳ ዉደቱዋ።</para>
  <para style="b" vid="PSA 95:7"/>
  <para style="q2" vid="PSA 95:7">ጾሳይ ህንተና ግያዋ ሀች ስስተ!<verse eid="PSA 95:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 95:8"/>“ካሰ ህንተ ማይዛ አዎቱ፥</para>
  <para style="q2" vid="PSA 95:8">ማሪባ ግያ ሳኣን ሀኔዳዋዳን፥<note caller="-" style="x"><char style="xo" closed="false">95:8 </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">ከሳ 17:1-7</ref>፤ <ref loc="NUM 20:2-13">ፓይ. 20:2-13</ref></char></note></para>
  <para style="q2" vid="PSA 95:8">ሄ ጋላስ ማሳ ባዙዋን እጼዳዋዳን፥</para>
  <para style="q2" vid="PSA 95:8">ህንተካ ዞርያ አከናን እጾፕተ።<verse eid="PSA 95:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9"/>ኡንቱንቱ ታ ኦሱዋ በኢደካ፥</para>
  <para style="q2" vid="PSA 95:9">ታና ኤቀቴድኖነ ፓጬድኖ።<verse eid="PSA 95:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10"/>ታን ሄ የለታ ኦይታሙ ላይ ሻተታድ፤</para>
  <para style="q2" vid="PSA 95:10">‘ኡንቱንቱ ኡባ ዎደ ባረንቱ ዎዛናን ባሊኖ፤</para>
  <para style="q2" vid="PSA 95:10">ኡንቱንቱ ታ ኦግያ ኤርበይክኖ ያጋድ።<verse eid="PSA 95:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11"/>ሄዋዳንካ ቃይ፥ ታን ሀንቀታ ጫቃደ፥<note caller="-" style="x"><char style="xo" closed="false">95:11 </char><char style="xt" closed="false"><ref loc="NUM 14:20-23">ፓይ. 14:20-23</ref>፤ <ref loc="DEU 1:34-36">ዛረ. 1:34-36</ref>፤ <ref loc="DEU 12:9-11">12:9-11</ref>፤ <ref loc="HEB 4:3-5">እብራ. 4:3-5</ref></char></note></para>
  <para style="q2" vid="PSA 95:11">ኡንቱንቱ ታ ሸምፑዋሳ ኡባካ ገልክኖ’ ያጋድ” ያጌ።<verse eid="PSA 95:11"/></para>
  <chapter eid="PSA 95"/>
  <chapter number="96" style="c" sid="PSA 96"/>
  <para style="s1">ጾሳይ ኡባፐ ቦላ ካትያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1"/>መና ጎዳዉ ኦራ የ የጽተ፤</para>
  <para style="q2" vid="PSA 96:1">ሳኣን ደእያ አሳይ፥ ኡባይ መና ጎዳዉ የጽተ።<verse eid="PSA 96:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2"/>መና ጎዳዉ የጽተ፤ አ ሱን ሳቢተ፤</para>
  <para style="q2" vid="PSA 96:2">እ አሽያ ምሽራቹዋ ጋላሳን ጋላሳን ኦድተ።<verse eid="PSA 96:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3"/>ካዉተ ግዶን አ ቦንቹዋ፥</para>
  <para style="q2" vid="PSA 96:3">አሳ ኡባ ግዶን አ ማላልስያ ኦሱዋባ አዋይተ።<verse eid="PSA 96:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4"/>አያዉ ጎፐ፥ መና ጎዳይ ዎልቃማ፤</para>
  <para style="q2" vid="PSA 96:4">ግታ ጋላታይ አዉ በሴ።</para>
  <para style="q1" vid="PSA 96:4">ጾሳቱዋ ኡባፐ አደ እ ያየታናዉ በሴ።<verse eid="PSA 96:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5"/>ሀራ አሳ ጾሳቱ ኡባይ ኤቃቱዋ፤</para>
  <para style="q2" vid="PSA 96:5">ሽን መና ጎዳይ ሳሎቱዋ መዳ ጾሳ።<verse eid="PSA 96:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6"/>ቦንቹነ አንጋይ አ ዩሹዋን ደኤ፤</para>
  <para style="q2" vid="PSA 96:6">ምኖተይነ ፑላይ አ ጌሻ ጎልያን ደኤ።<verse eid="PSA 96:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7"/>ህንተኖ፥ አሳ ዛረቶ ኡባቶ፥</para>
  <para style="q2" vid="PSA 96:7">መና ጎዳባ ኦድተ፤<note caller="-" style="x"><char style="xo" closed="false">96:7-9 </char><char style="xt" closed="false"><ref loc="PSA 29:1-2">ማዝ. 29:1-2</ref></char></note></para>
  <para style="q1" vid="PSA 96:7">“ቦንቹነ ዎልቃይ መና ጎዳሳ” ጊደ ኦድተ።<verse eid="PSA 96:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8"/>“ቦንቹ አ ሱንሳ”</para>
  <para style="q2" vid="PSA 96:8">ጊደ መና ጎዳባ ኦድተ።</para>
  <para style="q1" vid="PSA 96:8">ያርሹዋ አኪደ፥ አ ዳባባ ገልተ።<verse eid="PSA 96:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9"/>አ ጌሻተ ፑላን መና ጎዳዉ ጎይንተ፤</para>
  <para style="q2" vid="PSA 96:9">ቢታን ደእያ አሳ ኡባዉ፥ አ ስንን ኮኮርተ።<verse eid="PSA 96:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10"/>ካዉተቱዋ ግዶን፥ “መና ጎዳይ ካተቴዳ!</para>
  <para style="q2" vid="PSA 96:10">ሳአይ ምን ኤቄዳ፤ ኡባካ ቃጸና።</para>
  <para style="q1" vid="PSA 96:10">እ አሳ ቦላ ሱረተን ፕርዳና” ያግተ።<verse eid="PSA 96:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11"/>ሳሎቱ ናሸትኖ፤ ሳአይካ ሀሹ ጎ፤</para>
  <para style="q2" vid="PSA 96:11">አባይነ አ ግዶን ኩሜዳዌ ጉሞ።<verse eid="PSA 96:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12"/>ሾይቃይነ ሾይቃን ደእያ ኡባይ ናሸቶ!</para>
  <para style="q2" vid="PSA 96:12">ዎራን ደእያ ም ኡባይካ ናሸቻን አ ስንን የጻና።<verse eid="PSA 96:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 96:13"/>አያዉ ጎፐ፥ መና ጎዳይ ዬ፤</para>
  <para style="q2" vid="PSA 96:13">እ ሳኣ ቦላን ፕርዳናዉ ዬ፤</para>
  <para style="q1" vid="PSA 96:13">እ ሀ ሳኣ ቦላ ጽሎተን፥</para>
  <para style="q2" vid="PSA 96:13">አሳ ቦላካ ቱማተን ፕርዳና።<verse eid="PSA 96:13"/></para>
  <chapter eid="PSA 96"/>
  <chapter number="97" style="c" sid="PSA 97"/>
  <para style="s1">ጾሳይ ኡባፐ ቦላ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1"/>መና ጎዳይ ካዉቴዳ።</para>
  <para style="q2" vid="PSA 97:1">ሳኣን ደእያ አሳይ ናሸቶ፤</para>
  <para style="q3" vid="PSA 97:1">ሃኮ ሃን ዶደቶ ሳን ደእያ አሳቱካ ናሸትኖ።<verse eid="PSA 97:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2"/>ሻሪነ ጵ ጎ ማይ አ ዶዴዳ።</para>
  <para style="q2" vid="PSA 97:2">ጽሎተይነ ቱማተይ አ ካዉተ አራታዉ ባሶ።<verse eid="PSA 97:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3"/>ታማይ አፐ ስንና ቤ፤</para>
  <para style="q2" vid="PSA 97:3">አ ዶዴዳ ሞርከቱዋ ጹጌ።<verse eid="PSA 97:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4"/>አ ዋልቃንይ ሳኣ ፖእሴ፤</para>
  <para style="q2" vid="PSA 97:4">ቢታይ ሄዋ በኢደ ኮኮሬ።<verse eid="PSA 97:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5"/>መና ጎዳ ስንን፥ ሳኣ ኡባ ጎዳ ስንን</para>
  <para style="q2" vid="PSA 97:5">ዎጋ ደረቱ ኤሳ ሙቃዳዳን ሙሺኖ።<verse eid="PSA 97:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6"/>ሳሎቱ አ ጽሎተ አዋዪኖ፤</para>
  <para style="q2" vid="PSA 97:6">አሳይ ኡባይ አ ቦንቹዋ በኤ።<verse eid="PSA 97:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7"/>ዎርዶ ጾሳቶ ጎይንያዋንቱነ</para>
  <para style="q2" vid="PSA 97:7">ሄ ጎኤና ኤቃቱዋን ጬቀትያዋንቱ ኡባይ ዬላትኖ።</para>
  <para style="q1" vid="PSA 97:7">ጾሳቱ ኡባይ ጾሳዉ ጉልባትኖ።<verse eid="PSA 97:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8"/>አቤት መና ጎዳዉ፥ ጽዮነ አሳይ፥</para>
  <para style="q2" vid="PSA 97:8">ነ ጽሎ ፕርዳ ስሲደ ናሸቴ፤</para>
  <para style="q1" vid="PSA 97:8">ይሁዳ ካታማቱዋ አሳይካ ሀሹ ጌ።<verse eid="PSA 97:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9"/>አቤት መና ጎዳዉ፥ ኔን ሳኣ ኡባፐ ቃሳ፤</para>
  <para style="q2" vid="PSA 97:9">ጾሳቱዋ ኡባፐ ኔን ቁ ጋሳ።<verse eid="PSA 97:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10"/>መና ጎዳ ሲቅያዋንቱ ኢታ እጽተ።</para>
  <para style="q2" vid="PSA 97:10">እ ባረዉ አማነትያ አሳቱዋ ሸምፑዋ ናጌ፤</para>
  <para style="q2" vid="PSA 97:10">ቃይ ኡንቱንታ ኢታቱዋ ኩሽያፐ አሼ።<verse eid="PSA 97:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11"/>ጽሎቶ ፖኡ ፖኤ፤</para>
  <para style="q2" vid="PSA 97:11">ዎዛና ሱረቶ ናሸቻይ ደኤ።<verse eid="PSA 97:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12"/>ህንተኖ ጽሎቶ፥ መና ጎዳን ናሸትተ፤</para>
  <para style="q2" vid="PSA 97:12">አ ጌሻ ሱን ጋላትተ።<verse eid="PSA 97:12"/></para>
  <chapter eid="PSA 97"/>
  <chapter number="98" style="c" sid="PSA 98"/>
  <para style="s1">ጾሳይ አላምያ ሞድያዋ</para>
  <para style="d">ማዝሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1"/>መና ጎዳዉ ኦራ የ የጽተ፤</para>
  <para style="q2" vid="PSA 98:1">አያዉ ጎፐ፥ እ ማላልስያባ ኦዳ።</para>
  <para style="q1" vid="PSA 98:1">አ ኡሸቻ ኩሺነ አ ጌሻ ቄሲ</para>
  <para style="q2" vid="PSA 98:1">አዉ ጾኑዋ እሜዳ።<verse eid="PSA 98:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2"/>መና ጎዳይ ባረ ጾኑዋ ኤርሴዳ፤</para>
  <para style="q2" vid="PSA 98:2">እ አሽያዋ ካዉተቶ ቆንጭሴዳ።<verse eid="PSA 98:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3"/>እ እስራኤልያ ሶ አሳ ሲቅያዋነ</para>
  <para style="q2" vid="PSA 98:3">ኡንቱንቶ አማነትያዋ ሀሳዬዳ።</para>
  <para style="q1" vid="PSA 98:3">ሳኣ ጋጻ ጋካናዉ ደእያ አሳይ ኡባይ</para>
  <para style="q2" vid="PSA 98:3">ኑ ጾሳይ አሽያዋ በኤዳ።<verse eid="PSA 98:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4"/>ሳኣ ቦላን ደእያ አሳ ኡባይ፥</para>
  <para style="q1" vid="PSA 98:4">መና ጎዳዉ ናሸቻን የጽተ፤</para>
  <para style="q2" vid="PSA 98:4">ቃላ ቁ ኦደ፥ ናሸቻ ሳባ ሳቢተ።<verse eid="PSA 98:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5"/>ዲ መና ጎዳዉ ዲጽተ፤</para>
  <para style="q2" vid="PSA 98:5">ዲንነ የን ጾሳ ሳቢተ።<verse eid="PSA 98:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6"/>ጹሩምባነ ሎኩዋ ፑኒደ፥</para>
  <para style="q2" vid="PSA 98:6">ናሸቻን መና ጎዳ ኑ ካትያ ስንን ሆምቦጭተ።<verse eid="PSA 98:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7"/>አባይነ አባ ግዶን ኩሜዳዌ ኡባይ ጉሞ።</para>
  <para style="q2" vid="PSA 98:7">ሳአይነ ሳኣ ቦላን ደእያ ኡባይ የጾ።<verse eid="PSA 98:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8"/>ሻፋቱ እትፐ ባረንቱ ኩሽያ ባቂኖ።</para>
  <para style="q2" vid="PSA 98:8">ቄር ደረቱ መና ጎዳ ስንን እትፐ ናሸቻን የጽኖ።<verse eid="PSA 98:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9"/>አያዉ ጎፐ፥ እ ሳኣ ቦላን ዳናታናዉ ዬ።</para>
  <para style="q2" vid="PSA 98:9">እ ሀ ሳኣ ቦላ ጽሎተን፥</para>
  <para style="q2" vid="PSA 98:9">አሳ ቦላካ ሱረተን ዳናታና።<verse eid="PSA 98:9"/></para>
  <chapter eid="PSA 98"/>
  <chapter number="99" style="c" sid="PSA 99"/>
  <para style="s1">ጾሳይ ጽሉዋነ ጌሻ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1"/>መና ጎዳይ ካዉቴዳ!<note caller="-" style="x"><char style="xo" closed="false">99:1 </char><char style="xt" closed="false"><ref loc="EXO 25:22">ከሳ 25:22</ref></char></note> ሄዎ አሳቱ ኮኮርኖ።</para>
  <para style="q2" vid="PSA 99:1">ክሩበቱዋፐ ግዱዋን ካዉተ አራታ ቦላ ኡቴዳ፤</para>
  <para style="q3" vid="PSA 99:1">ሄዎ ቢታይ ቃጾ፤<verse eid="PSA 99:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2"/>መና ጎዳይ ጽዮነን ዎልቃማ፤</para>
  <para style="q2" vid="PSA 99:2">ካዉተ ኡባፐ እ ቁ ቁ ጌዳ።<verse eid="PSA 99:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3"/>ዳሮፐ ያሽያ አ ዎልቃማ ሱን፥</para>
  <para style="q2" vid="PSA 99:3">ኡንቱንቱ ኡባይ ጋላትኖ።</para>
  <para style="q1" vid="PSA 99:3">እ ጌሻ!<verse eid="PSA 99:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4"/>ኔን፥ ዎልቃማ ካቲ፥ ልከ ፕርዳ ዶሳሳ።</para>
  <para style="q2" vid="PSA 99:4">ኔን ያቆባ አሳዉ ሱረተ ምንሳዳ።</para>
  <para style="q1" vid="PSA 99:4">ጽሎተነ ልከ ፕርዳ ኤሳዳ።<verse eid="PSA 99:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5"/>መና ጎዳ ኑ ጾሳ ቁ ቁ ኦተ፤</para>
  <para style="q2" vid="PSA 99:5">አ ገዲ የያሳን ጉፋኒደ አዉ ጎይንተ።</para>
  <para style="q1" vid="PSA 99:5">እ ጌሻ!<verse eid="PSA 99:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6"/>ሙሴነ አሮነ አ ቀሰቱዋ ግዱዋፐ ላአቱዋ፤</para>
  <para style="q2" vid="PSA 99:6">ሳሜልካ አ ሱንን ዎሴዳዋንቱፐ እቱዋ።</para>
  <para style="q1" vid="PSA 99:6">ኡንቱንቱ መና ጎዳዉ ዋሴድኖ፤</para>
  <para style="q2" vid="PSA 99:6">እካ ኡንቱንቶ አሌዳ።<verse eid="PSA 99:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7"/>እ ሻርያ ቱሳ ግዱዋና ኡንቱንቶ ሃሳዬዳ፤<note caller="-" style="x"><char style="xo" closed="false">99:7 </char><char style="xt" closed="false"><ref loc="EXO 33:9">ከሳ 33:9</ref></char></note></para>
  <para style="q2" vid="PSA 99:7">ኡንቱንቱ እ እሜዳ ህግያነ ዎጋ ናጌድኖ።<verse eid="PSA 99:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8"/>አቤት መና ጎዳዉ፥ ኑ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 99:8">ኔን ኡንቱንቱ ዎሳ ስሳዳ።</para>
  <para style="q1" vid="PSA 99:8">ኔን ኡንቱንቱ ኢታተ ድራዉ ሙሬዳዋ ግዶፐካ፥</para>
  <para style="q2" vid="PSA 99:8">ኡንቱንቶ አቶ ጌዳ ጾሳ።<verse eid="PSA 99:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9"/>መና ጎዳ ኑ ጾሳ፥ ቁ ቁ ኦተ፤</para>
  <para style="q2" vid="PSA 99:9">አ ጌሻ ደርያ ቦላን አዉ ጎይንተ፤</para>
  <para style="q2" vid="PSA 99:9">አያዉ ጎፐ፥ መና ጎዳይ ኑ ጾሳይ ጌሻ!<verse eid="PSA 99:9"/></para>
  <chapter eid="PSA 99"/>
  <chapter number="100" style="c" sid="PSA 100"/>
  <para style="s1">ጾሳ ጋላታናዳን ሺቄዳ ጼሳ</para>
  <para style="d">ጋላታ እምያ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1"/>ሳኣን ደእያ አሳ ኡባዉ፥</para>
  <para style="q2" vid="PSA 100:1">መና ጎዳዉ ህንተ ቃላ ቁ ኦደ የጽተ።<verse eid="PSA 100:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 100:2"/>መና ጎዳዉ ናሸቻን ኦተ፤</para>
  <para style="q2" vid="PSA 100:2">ናሸቻ የና አ ስን ሺቅተ።<verse eid="PSA 100:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3"/>መና ጎዳይ ጾሳ ግድያዋ ኤርተ፤</para>
  <para style="q2" vid="PSA 100:3">ኑና መዳዌ አ፤ ኑን አዋንታ።</para>
  <para style="q1" vid="PSA 100:3">ኑን አ አሳቱዋነ አ ቆሩዋን ደእያ ዶርሳቱዋ።<verse eid="PSA 100:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4"/>አ ፐንግያ ጋላታና፥</para>
  <para style="q2" vid="PSA 100:4">አ ዳባባ ሳባና ገልተ፤</para>
  <para style="q1" vid="PSA 100:4">አ ጋላትተነ አ ሱን ሳቢተ።<verse eid="PSA 100:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5"/>አያዉ ጎፐ፥ መና ጎዳይ ኬካ።<note caller="-" style="x"><char style="xo" closed="false">100:5 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1 ኦዱዋ 16:34</ref>፤ <ref loc="2CH 5:13">2 ኦዱዋ 5:13</ref>፤ <ref loc="2CH 7:3">7:3</ref>፤ <ref loc="EZR 3:11">እዝራ 3:11</ref>፤ <ref loc="PSA 106:1">ማዝ. 106:1</ref>፤ <ref loc="PSA 107:1">107:1</ref>፤ <ref loc="PSA 118:1">118:1</ref>፤ <ref loc="PSA 136:1">136:1</ref>፤ <ref loc="JER 33:11">ኤር. 33:11</ref></char></note></para>
  <para style="q2" vid="PSA 100:5">አገና አ ሲቁ መናሳ፤</para>
  <para style="q1" vid="PSA 100:5">እ የለታፐ የለታ ጋካናዉ አማነትያዋ።<verse eid="PSA 100:5"/></para>
  <chapter eid="PSA 100"/>
  <chapter number="101" style="c" sid="PSA 101"/>
  <para style="s1">ካቲ ጾሳዉ ገልያ ቃላ ጫቁዋ</para>
  <para style="d">ዳዊታ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1"/>ታን አገና ሲቁዋባነ ጽሎ ፕርዳባ የጻና፤</para>
  <para style="q2" vid="PSA 101:1">አቤት መና ጎዳዉ፥ ታን ነዉ የጻና።<verse eid="PSA 101:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2"/>ታን ሱረ ኦግያባ ቆፓና።</para>
  <para style="q2" vid="PSA 101:2">ኔን ታኮ አዉደ ያን?</para>
  <para style="q1" vid="PSA 101:2">ታን ታ ጎልያን ሱረተን ሀመታና።<verse eid="PSA 101:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3"/>ታን ታ አይፍያን ፖኮባ ጼልከ።</para>
  <para style="q2" vid="PSA 101:3">ጾሳፐ ዎራ ስሜዳ አሳቱዋ ኦሱዋ እጻይ፤</para>
  <para style="q2" vid="PSA 101:3">ኡንቱንቱ ሙለካ ታናና ግድክኖ።<verse eid="PSA 101:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4"/>ዎዛና ጌላተይ ታፐ ሃኮ፤</para>
  <para style="q2" vid="PSA 101:4">ኢታተ ታን ኤርከ።<verse eid="PSA 101:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5"/>ጌማን ባረ ሾሩዋ ዝግርያዋ፥</para>
  <para style="q2" vid="PSA 101:5">ታን ስርጵ ኦና።</para>
  <para style="q1" vid="PSA 101:5">ኦቶረትያነ አይያ አሳ ታን ዳንዳይከ።<verse eid="PSA 101:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6"/>ኡንቱንቱ ታናና ደአና ማላ፥</para>
  <para style="q2" vid="PSA 101:6">ቢታ ቦላ ደእያ አማነትያዋንታ፥</para>
  <para style="q2" vid="PSA 101:6">ታን ኬካ አይፍያን ጼላይ።</para>
  <para style="q1" vid="PSA 101:6">ሱረተን ሀመትያ አሳይ ታዉ ኪተታና።<verse eid="PSA 101:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7"/>ጭምያዌ ታ ጎልያን ደኤና፤</para>
  <para style="q2" vid="PSA 101:7">ዎርዱዋ ሃሳይያዌ ታ ስንን ጋምኤና።<verse eid="PSA 101:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8"/>ቢታን ደእያ ኢታ አሳ ኡባ፥</para>
  <para style="q2" vid="PSA 101:8">ታን ጋላስ ጋላስ ይሳና፤</para>
  <para style="q2" vid="PSA 101:8">ኢታ ኦያዋንታ ኡባ፥</para>
  <para style="q2" vid="PSA 101:8">ታን መና ጎዳ ካታማፐ ቆላና።<verse eid="PSA 101:8"/></para>
  <chapter eid="PSA 101"/>
  <chapter number="102" style="c" sid="PSA 102"/>
  <para style="s1">መቱዋ ቦላ ደእያ አሳ ዎሳ</para>
  <para style="d">መና ጎዳ ስንን ባረና ዶጊደ ባረ ካዩዋ ጉስያ ዎደ፥ ቱጋቴዳ አሳይ ዎሴዳ ዎሳ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1"/>አቤት መና ጎዳዉ፥ ታ ዎሳ ስሳ፤</para>
  <para style="q2" vid="PSA 102:1">ታ ዋሱ ኔኮ ጋኮ።<verse eid="PSA 102:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2"/>ታ ዋይያ ጋላስ፥</para>
  <para style="q2" vid="PSA 102:2">ነ ሶምኡዋ ታፐ ገንፓ።</para>
  <para style="q1" vid="PSA 102:2">ነ ሀይ ታኮ የጋ፤</para>
  <para style="q2" vid="PSA 102:2">ታን ነዉ ዋስያ ዎደ፥ ታና ኤለካ አላ።<verse eid="PSA 102:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3"/>አያዉ ጎፐ፥ ታ ላይይ ጩዋዳን ዬ፤</para>
  <para style="q2" vid="PSA 102:3">ታ መቀይካ ታማ ቦንቁዋዳን ኤጼ።<verse eid="PSA 102:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4"/>ታ ዎዛናይ ሾጭ የጌዳ መላ ማታዳን ሀናድ፤</para>
  <para style="q2" vid="PSA 102:4">ቁማይካ ታዉ ሜተተና።<verse eid="PSA 102:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5"/>ታን ታ ቃላ ቁ ኦደ ኦላይ፤</para>
  <para style="q2" vid="PSA 102:5">ታ ጋልባይ መቀና ኦይቀቴዳ።<verse eid="PSA 102:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6"/>ታን ባዙዋን ደእያ አንኩዋ ማላ፥</para>
  <para style="q2" vid="PSA 102:6">ዎይ ኮለቴዳ ጎልያን ደእያ ጉቱዋ ማላ።<verse eid="PSA 102:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7"/>ታን ግስና፥ ገምእሹ ዬና፤</para>
  <para style="q2" vid="PSA 102:7">ታን ጎልያ ሁጲያን ባረካ ኡቴዳ ካፉዋ ማላ።<verse eid="PSA 102:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8"/>ታ ሞርከቱ ጋላሳ ኡባን ታና ጫሺኖ፤</para>
  <para style="q2" vid="PSA 102:8">ታና ቅሊጭያዋንቱ ታ ሱንን ሸቂኖ።<verse eid="PSA 102:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9"/>ታን ብድን ቁማዳን ማይ፤</para>
  <para style="q2" vid="PSA 102:9">ቃይ ታ አፎ ታ ኡሻና ዋላካይ።<verse eid="PSA 102:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10"/>ኔን ታና ፑደ ደንደ፥</para>
  <para style="q2" vid="PSA 102:10">ነ ሀንቁዋ ድራዉ ዎራ ኦላዳ።<verse eid="PSA 102:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11"/>ታ ደኡዋ ላይይ ኦማርሳ ኩዋ ማላ፤</para>
  <para style="q2" vid="PSA 102:11">ታን ማታዳን ሹላይ።<verse eid="PSA 102:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12"/>ሽን አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 102:12">ኔን ካዉተ አራታን መናዉ ኡታዳ፤</para>
  <para style="q2" vid="PSA 102:12">ነ ሱንይካ የለታፐ የለታ ጋካናዉ ሀሳየታና።<verse eid="PSA 102:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13"/>ኔን ደንዳደ፥ ጽዮነዉ ቃረታ፤</para>
  <para style="q2" vid="PSA 102:13">አያዉ ጎፐ፥ ኔን እዞ ማርያ ዎዲ ጋኬዳ፤</para>
  <para style="q2" vid="PSA 102:13">ሀዌ ኔን ዶሬዳ ዎድያ።<verse eid="PSA 102:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14"/>እዛ ኮለቴዳዋ ግዶፐካ፥</para>
  <para style="q2" vid="PSA 102:14">ነ ቆማቱ እዞ ሲቂኖ።</para>
  <para style="q1" vid="PSA 102:14">እዛ ባዬዳዋ ግዶፐካ፥</para>
  <para style="q2" vid="PSA 102:14">ኡንቱንቱ እዝዉ ቃረቲኖ።<verse eid="PSA 102:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15"/>ካዉተቱ መና ጎዳ ሱንዉ ያያና፤</para>
  <para style="q2" vid="PSA 102:15">ሳኣ ካተቱ ኡባይ አ አንጋዉ ዳጋማና።<verse eid="PSA 102:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16"/>አያዉ ጎፐ፥ መና ጎዳይ ጽዮነ ዛረ ኬጺደ፥</para>
  <para style="q2" vid="PSA 102:16">እ ባረ ግታተ በሳና።<verse eid="PSA 102:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17"/>እ ፑቴሳቱዋ ዎሳ ስሳና፤</para>
  <para style="q2" vid="PSA 102:17">ኡንቱንቱ ዋሱዋ ካና።<verse eid="PSA 102:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18"/>ብሮ የለታና አሳቱ መና ጎዳ ጋላታና ማላ፥</para>
  <para style="q2" vid="PSA 102:18">ሀዌ ይያ የለታዉ ጻፈቶ።<verse eid="PSA 102:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19"/>መና ጎዳይ ቃን ደእያ ባረ ጌሻ ሳኣፐ ዱገ ጼሌዳ፤</para>
  <para style="q2" vid="PSA 102:19">እ ሳሉዋፐ ዱገ ሳኣ ጾሞሴዳ።<verse eid="PSA 102:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20"/>ሄዌነ፥ ቃሸቴዳ አሳቱዋ ኦልያ ስሳናሳነ</para>
  <para style="q2" vid="PSA 102:20">ሀይቆ ፕርደቴዳ አሳቱዋ ብላናሳ።<verse eid="PSA 102:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21"/>ሄዋ ድራዉ፥ መና ጎዳ ሱንይ ጽዮነን ኦደታናነ</para>
  <para style="q2" vid="PSA 102:21">አ ጋላታይ የሩሳላመን አዋየታና።<verse eid="PSA 102:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22"/>አሳይነ ካዉተይ እትፐ ሺቂደ፥</para>
  <para style="q2" vid="PSA 102:22">መና ጎዳዉ ሄ ዎደ ጎይናና።<verse eid="PSA 102:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23"/>እ ታን ያላጋተን ደኢና፥</para>
  <para style="q2" vid="PSA 102:23">ታ ዎልቃ ዉርሴዳ፤</para>
  <para style="q2" vid="PSA 102:23">ታ ላይ ቃንዬዳ።<verse eid="PSA 102:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24"/>ያትና፥ ታን፥ “አቤት ታ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 102:24">ታ ላይይ ብሮ ግዶትያ ዎደ፥</para>
  <para style="q2" vid="PSA 102:24">ታና አፎፓ” ያጋይ።</para>
  <para style="b" vid="PSA 102:24"/>
  <para style="q2" vid="PSA 102:24">አቤት ጾሳዉ፥ ኔን የለታፐ የለታ ጋካናዉ ደኣሳ።<verse eid="PSA 102:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25"/>ኔን በን ሳኣ መዳ፤<note caller="-" style="x"><char style="xo" closed="false">102:25-27 </char><char style="xt" closed="false"><ref loc="HEB 1:10-12">እብራ. 1:10-12</ref></char></note></para>
  <para style="q2" vid="PSA 102:25">ሳሉካ ነ ኩሽያ ኦሱዋ።<verse eid="PSA 102:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26"/>ሄዋንቱ ኡባይ ያና፤ ሽን ኔን ደአና፤</para>
  <para style="q2" vid="PSA 102:26">ኡንቱንቱ ኡባይካ አፍላዳን ዉራና።</para>
  <para style="q1" vid="PSA 102:26">ኔን ኡንቱንታ ጩርቃ አፍላዳን ላማና፤</para>
  <para style="q2" vid="PSA 102:26">ኡንቱንቱካ አና።<verse eid="PSA 102:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27"/>ሽን ኔን ኔናካ፤ ነ ላይይ ኡባ ዉረና።<verse eid="PSA 102:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28"/>ኑን ነ ቆማቱዋ፤</para>
  <para style="q2" vid="PSA 102:28">ኑ ናናቱ ሳሮተን ደአና።</para>
  <para style="q1" vid="PSA 102:28">ኡንቱንቱ ዘረይካ ነ ስንን ምኒደ ኤቃና።<verse eid="PSA 102:28"/></para>
  <chapter eid="PSA 102"/>
  <chapter number="103" style="c" sid="PSA 103"/>
  <para style="s1">ጾሳ ሲቁዋ</para>
  <para style="d">ዳውት ጻፌዳዋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1"/>ታ ሸምፓቴ፥ መና ጎዳ ጋላታ!</para>
  <para style="q2" vid="PSA 103:1">ታ ኩመን አሳተዉ፥ አ ጌሻ ሱን ጋላታ።<verse eid="PSA 103:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2"/>ታ ሸምፓቴ፥ መና ጎዳ ጋላታ!</para>
  <para style="q2" vid="PSA 103:2">እ ነዉ ኦዳ ኬካተ ኡባ ዶጎፓ።<verse eid="PSA 103:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3"/>እ ነ ናጋራ ኡባ አቶ ጌ፤</para>
  <para style="q2" vid="PSA 103:3">እ ነ ሀርግያ ኡባፐ ኔና ፓ።<verse eid="PSA 103:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4"/>እ ኔና ዱፉዋን ገለናዳን አሼ፤</para>
  <para style="q2" vid="PSA 103:4">አገና ሲቁዋንነ ማሮታን ኔና አንጄ።<verse eid="PSA 103:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5"/>አርጋንዳን ኔን ያላጋና ማላ፥</para>
  <para style="q2" vid="PSA 103:5">እ ነ ደኡዋ ኡባን ኔና ሎኦባ ካልሴ።<verse eid="PSA 103:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6"/>መና ጎዳይ ናቀቴዳዋንቶ</para>
  <para style="q2" vid="PSA 103:6">ጽሎባ ኦነ ሱርያን ፕርዴ።<verse eid="PSA 103:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7"/>እ ባረ ኦግያ ሙሳ፥</para>
  <para style="q2" vid="PSA 103:7">ባረ ኦሱዋ እስራኤልያ አሳዉ ኤርሴዳ።<verse eid="PSA 103:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8"/>መና ጎዳይ ቃረትያዋነ ማርያዋ፤<note caller="-" style="x"><char style="xo" closed="false">103:8 </char><char style="xt" closed="false"><ref loc="JAS 5:11">ያቆባ 5:11</ref></char></note></para>
  <para style="q2" vid="PSA 103:8">እ ሀንቀታናዉ ኤሌለናዋነ</para>
  <para style="q2" vid="PSA 103:8">አገና ሲቁ ዳሩዋ።<verse eid="PSA 103:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9"/>እ ኡባ ገደ ሴረና፤ መናዉ ሀንቀተና።<verse eid="PSA 103:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10"/>እ ኑና ኑ ናጋራዳን ኦቤና፤</para>
  <para style="q2" vid="PSA 103:10">ኑ ኢታተዳን ኑዉ ዛርቤና።<verse eid="PSA 103:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11"/>ሳሉ ሳኣፐ ቂያዋዳን፥</para>
  <para style="q2" vid="PSA 103:11">መና ጎዳዉ ያይያዋንቶ አገና አ ሲቁ ዳራ።<verse eid="PSA 103:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12"/>አዋይ ዶልያሳፐ አዋይ ዉልያሳይ ሃክያዋዳን፥</para>
  <para style="q2" vid="PSA 103:12">መና ጎዳይ ኑ ባይዙዋ ኑፐ ሃሴ።<verse eid="PSA 103:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13"/>አዉ ባረ ናናቶ ቃረትያዋዳን፥</para>
  <para style="q2" vid="PSA 103:13">መና ጎዳይ ባረዉ ያይያዋንቶ ቃረቴ።<verse eid="PSA 103:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14"/>አያዉ ጎፐ፥ ኑን አያፐ መቴደንቶ እ ኤሬ፤</para>
  <para style="q2" vid="PSA 103:14">ኑን ቢታ ግድያዋ እ አኬኬ።<verse eid="PSA 103:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15"/>አሳ ግዶፐ፥ አ ደኡ ማታ ማላ፤</para>
  <para style="q2" vid="PSA 103:15">እ ባዙዋ ጪሻዳን ጪሼ፤<verse eid="PSA 103:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16"/>ጫርኩ አ ቦላ ጫርክና ዬዳ፤</para>
  <para style="q2" vid="PSA 103:16">እ ዶሌዳ ሳአይ ኤረተና።<verse eid="PSA 103:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17"/>ሽን መና ጎዳዉ ያይያዋንቶ፥</para>
  <para style="q2" vid="PSA 103:17">አገና አ ሲቁ መናፐ መና ጋካናሳ።</para>
  <para style="q1" vid="PSA 103:17">አ ጽሎተይካ ናኣ ናአዉ ጋካናሳ።<verse eid="PSA 103:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18"/>አ ጫቁዋ ናግያዋንቱሳነ</para>
  <para style="q2" vid="PSA 103:18">አ አዛዙዋ ፖላናዉ ሀሳይያዋንቱሳ።<verse eid="PSA 103:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19"/>መና ጎዳይ ሳሎቱዋን ባረ ካዉተ አራታ ኤሴዳ፤</para>
  <para style="q2" vid="PSA 103:19">አ ካዉተይ ኡባ ሞዴ።<verse eid="PSA 103:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20"/>ህንተኖ፥ አ ኪታንቻቶ፥</para>
  <para style="q2" vid="PSA 103:20">አ አዛዙዋ ፖልያ ዎልቃማቶ፥</para>
  <para style="q1" vid="PSA 103:20">እ ግያዋ ስስስያዋንቶ፥</para>
  <para style="q2" vid="PSA 103:20">መና ጎዳ ጋላትተ!<verse eid="PSA 103:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21"/>ህንተኖ ሳሉዋን ደእያ ምኖቶ፥</para>
  <para style="q2" vid="PSA 103:21">አ ሸንያ ኦያ ቆማቶ፥</para>
  <para style="q1" vid="PSA 103:21">መና ጎዳ ጋላትተ!<verse eid="PSA 103:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22"/>ህንተኖ፥</para>
  <para style="q2" vid="PSA 103:22">እ ሞድያ ሳኣ ኡባ መታቶ፥</para>
  <para style="q2" vid="PSA 103:22">ኡባይካ መና ጎዳ ጋላትተ!</para>
  <para style="b" vid="PSA 103:22"/>
  <para style="q2" vid="PSA 103:22">ታ ሸምፓቴ፥ መና ጎዳ ጋላታ!<verse eid="PSA 103:22"/></para>
  <chapter eid="PSA 103"/>
  <chapter number="104" style="c" sid="PSA 104"/>
  <para style="s1">ጾሳዉ ሺቅያ ጋላታ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1"/>ታ ሸምፓቴ፥ መና ጎዳ ጋላታ!</para>
  <para style="q2" vid="PSA 104:1">አቤት መና ጎዳዉ ታ ጾሳዉ፥ ኔን አይ ኬሻ ግቴ!</para>
  <para style="q1" vid="PSA 104:1">ኔን ቦንቹዋነ አንጋ ማያዳ።<verse eid="PSA 104:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2"/>ፖኡዋ አፍላዳን ጉሎታዳ።</para>
  <para style="q2" vid="PSA 104:2">ኔን ሳሉዋ ዱንካንያዳን ቶላዳ።<verse eid="PSA 104:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 104:3"/>ነ ጎልያ ሳሉዋ ጉፋንዋ ቦላን ኬጻሳ።</para>
  <para style="q2" vid="PSA 104:3">ሻርያ ፓራ ጋርያ ከሳሳ፤</para>
  <para style="q2" vid="PSA 104:3">ጫርኩዋ ቀፍያን ቶጋሳ።<verse eid="PSA 104:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4"/>ኔን ጫርኮቱዋ ነ ኪታንቻ፥<note caller="-" style="x"><char style="xo" closed="false">104:4 </char><char style="xt" closed="false"><ref loc="HEB 1:7">እብራ. 1:7</ref></char></note></para>
  <para style="q2" vid="PSA 104:4">ታማ ላጩዋካ ነ ቆማ ከሳሳ።<verse eid="PSA 104:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5"/>ኔን ሳኣ አ ባሱዋ ቦላ ኤሳዳ፤</para>
  <para style="q2" vid="PSA 104:5">እ መ መናዉካ ቃጸና።<verse eid="PSA 104:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6"/>ዎልቃማ አባይ ቢታ ቦላን አፍላዳን ምጨቴዳ፤</para>
  <para style="q2" vid="PSA 104:6">ሃይ ዎልቃማ ደረቱዋ ካሜዳ።<verse eid="PSA 104:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7"/>ሽን ነ ጎደትና ሃቱ ባቃቴድኖ፤</para>
  <para style="q2" vid="PSA 104:7">ነ አዛዙዋ ስሲደ፥ ኤሌሌድኖ።<verse eid="PSA 104:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8"/>ኡንቱንቱ ዎጋ ደረቱዋፐ ዱገ ዛንጋራ፥</para>
  <para style="q2" vid="PSA 104:8">ኔን ኡንቱንቶ ጊግሴዳ ሳኣ ጎጌድኖ።<verse eid="PSA 104:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9"/>ሃቱ ስሚደ ቢታ ካመናዳን፥</para>
  <para style="q2" vid="PSA 104:9">ኡንቱንቱ አናዉ ዳንዳየና ዛዋ ኤሳዳ።<verse eid="PSA 104:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10"/>ኔን ፑልቶቱዋ ዛንጋራን ፑልትሳሳ፤</para>
  <para style="q2" vid="PSA 104:10">ኡንቱንቱ ሃይ ደረቱዋ ግዱዋና ጎጌ።<verse eid="PSA 104:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11"/>ጎግያዋፐ ባዙዋ ዶአቱ ኡባይ ኡሺኖ፤</para>
  <para style="q2" vid="PSA 104:11">ደንባ ሃረቱ ባረንቱ ሳሙዋ አፐ አሊኖ።<verse eid="PSA 104:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12"/>ሳሉዋ ካፎቱ ሄ ሃ ማታን ባረንቱ ጎልያ ኬጺደ፥</para>
  <para style="q2" vid="PSA 104:12">ታሽያ ግዶን የጺኖ።<verse eid="PSA 104:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13"/>ኔን ዎልቃማ ደረቱዋ ቦላን</para>
  <para style="q2" vid="PSA 104:13">ሳሉዋፐ እራ ቡክሳሳ፤</para>
  <para style="q2" vid="PSA 104:13">ቢታካ ነ ኩሽያ ኦሱዋ አይፍያን ካልሳሳ።<verse eid="PSA 104:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14"/>ኔን መህያዉ ማታ፥</para>
  <para style="q2" vid="PSA 104:14">አሳዉ ካ ሞክሳሳ።</para>
  <para style="q1" vid="PSA 104:14">ሄዌነ፥ አሳይ ቢታ ኦደ፥</para>
  <para style="q2" vid="PSA 104:14">ቢታፐ ካ ደማናሳ።<verse eid="PSA 104:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 104:15"/>አሳ ዎዛና ናሸችያ ዎይንያ፥</para>
  <para style="q2" vid="PSA 104:15">ሶምኡዋ ሽጭስያ ዛይትያነ</para>
  <para style="q2" vid="PSA 104:15">ዎልቃ ኩንያ ቁማ ሞክሳሳ።<verse eid="PSA 104:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16"/>መና ጎዳ ምቱ፥</para>
  <para style="q2" vid="PSA 104:16">እ ቶኬዳ ሊባኖሳ ዝጋቱ፥</para>
  <para style="q2" vid="PSA 104:16">ዳሮ እራ ኡሺኖ።<verse eid="PSA 104:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17"/>ኡንቱንቱን ካፎቱ ባረንቱ ጎልያ ኬጺኖ፤</para>
  <para style="q2" vid="PSA 104:17">ቆለቱካ ጺዳ ቦላ ኬጺደ ደኢኖ።<verse eid="PSA 104:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18"/>ቃ ደረቱዋ ቦላን ጋራቱ ደኢኖ፤</para>
  <para style="q2" vid="PSA 104:18">ቃይ ጉፓለቱ ሹቻ ጎንጎሉዋን ቆሰቲኖ።<verse eid="PSA 104:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19"/>ዎድያ ፓይዱዋ ኤርሳና ማላ፥</para>
  <para style="q2" vid="PSA 104:19">ኔን አግና መዳ።</para>
  <para style="q1" vid="PSA 104:19">አዋይ ባረ ዉልያ ዎድያ ኤሬ።<verse eid="PSA 104:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20"/>ኔን ቃማ መዳ፤</para>
  <para style="q2" vid="PSA 104:20">ማን ዶአይ ኡባይ ከሴ።<verse eid="PSA 104:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21"/>ዎዳላ ጋሞቱ ሻንካቲደ ጉዲኖ፤</para>
  <para style="q2" vid="PSA 104:21">ኡንቱንቱ ባረንቶ ምያዋ ጾሳፐ ኮዪኖ።<verse eid="PSA 104:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22"/>አዋይ ከስያ ዎደ፥</para>
  <para style="q2" vid="PSA 104:22">ጉየ ስሚደ ባረንቱ ጌሱዋን ግሲኖ።<verse eid="PSA 104:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23"/>ሄ ዎደ አሳይ ባረ ኦሶ ከሴ፤</para>
  <para style="q2" vid="PSA 104:23">ሳአይ ቃማና ጋካናዉ ኦ።<verse eid="PSA 104:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24"/>አቤት መና ጎዳዉ፥ ነ ኦሱ አይ ኬሻ ዳሬ!</para>
  <para style="q2" vid="PSA 104:24">ነ አዳ ኤራተን ኔን ኡንቱንቱ ኡባ መዳ፤</para>
  <para style="q2" vid="PSA 104:24">ሳአይ ኔን መዳዋን ኩሜዳ።<verse eid="PSA 104:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25"/>አባይ ህንን ሄዌሽ፤ እ ዎልቃማነ አኮ፤</para>
  <para style="q2" vid="PSA 104:25">ፓይዱ ባይና ቃጽያ መታቱዋን፥</para>
  <para style="q2" vid="PSA 104:25">ግታቱዋንነ ጉቱዋን ኩሚደ ደኤ።<verse eid="PSA 104:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26"/>ሄዋ ቦላን ማርካባቱ ቢኖ፤<note caller="-" style="x"><char style="xo" closed="false">104:26 </char><char style="xt" closed="false"><ref loc="JOB 41:1">ኢዮባ 41:1</ref>፤ <ref loc="PSA 74:14">ማዝ. 74:14</ref>፤ <ref loc="ISA 27:1">ኢሳ. 27:1</ref></char></note></para>
  <para style="q2" vid="PSA 104:26">ቃይ ኔን መዳ ሌዋታና ግያ ዳዊ አን ካኤ።<verse eid="PSA 104:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27"/>ኔን ኡንቱንታ ኮሽያ ዎድያን</para>
  <para style="q2" vid="PSA 104:27">ኡንቱንቶ ቁማ እማና ማላ፥</para>
  <para style="q2" vid="PSA 104:27">ኡንቱንቱ ኡባይ ኔና ጼሊኖ።<verse eid="PSA 104:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28"/>ኔን ኡንቱንቶ እምና፥ ኡንቱንቱ ማጺኖ፤</para>
  <para style="q2" vid="PSA 104:28">ኔን ነ ኩሽያፐ የግና፥</para>
  <para style="q2" vid="PSA 104:28">ኡንቱንቱ ሎኦባ ካሊኖ።<verse eid="PSA 104:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29"/>ኔን ነ ሶምኡዋ ገንያ ዎደ ዳጋሚኖ።</para>
  <para style="q2" vid="PSA 104:29">ነ ሸምፑዋ ኔን አክያ ዎደ ሀይቂደ፥</para>
  <para style="q2" vid="PSA 104:29">ባረንቱ ቢታዉ ስሚኖ።<verse eid="PSA 104:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30"/>ሽን ኔን ነ ሸምፑዋ ኪትያ ዎደ፥</para>
  <para style="q2" vid="PSA 104:30">ሀራቱ መቲኖ፤ ቢታካ ኦራሳ።<verse eid="PSA 104:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31"/>መና ጎዳ ቦንቹ መናዉ ደኦ፤</para>
  <para style="q2" vid="PSA 104:31">መና ጎዳይ ባረ ኦሱዋን ናሸቶ።<verse eid="PSA 104:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32"/>እ ቢታ ጼልና፥ ቢታይ ቃጼ፤</para>
  <para style="q2" vid="PSA 104:32">ቃይ እ ደረቱዋ ቦንችና፥ ደረቱ ጩዋቲኖ።<verse eid="PSA 104:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33"/>ታን ታ ደኡዋ ኡባን መና ጎዳዉ የጻና፤</para>
  <para style="q2" vid="PSA 104:33">ታን ደኤዳ ላይ ኡባን ታ ጾሳ ሳባና።<verse eid="PSA 104:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34"/>ታን መና ጎዳን ናሸትያ ድራዉ፥</para>
  <para style="q2" vid="PSA 104:34">ታ ቆፋይ አ ናሸቾ።<verse eid="PSA 104:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35"/>ናጋራንቻቱ ቢታፐ ይኖ፤</para>
  <para style="q2" vid="PSA 104:35">ሀዋፐ ስንዉ ኢታቱ ደኦፕኖ።</para>
  <para style="b" vid="PSA 104:35"/>
  <para style="q1" vid="PSA 104:35">ታ ሸምፓቴ፥ መና ጎዳ ጋላታ! መና ጎዳ ጋላትተ!<verse eid="PSA 104:35"/></para>
  <chapter eid="PSA 104"/>
  <chapter number="105" style="c" sid="PSA 105"/>
  <para style="s1">ማላልስያ እስራኤልያ ታርክያ</para>
  <para style="r">(<ref loc="1CH 16:8-22">1 ኦዱዋ 16:8-22</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1"/>መና ጎዳ ጋላትተ፤ አ ሱን ጼስተ።</para>
  <para style="q2" vid="PSA 105:1">እ ኦዳዋ ካዉተቱዋ ግዱዋን ኤርስተ።<verse eid="PSA 105:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2"/>አ ሳቢተ፤ ጋላታ የ አዉ የጽተ።</para>
  <para style="q2" vid="PSA 105:2">አ ማላልስያ ኦሱዋ ኡባባ ኦድተ።<verse eid="PSA 105:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3"/>አ ጌሻ ሱንን ጬቀትተ፤</para>
  <para style="q2" vid="PSA 105:3">መና ጎዳ ኮይያ ዎዛናቱ ናሸትኖ።<verse eid="PSA 105:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4"/>መና ጎዳነ አ ዎልቃ ጾሞስተ፤</para>
  <para style="q2" vid="PSA 105:4">ኡባ ገደ አ ስን ኮይተ።<verse eid="PSA 105:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 105:5"/>እ ኦዳ ማላልስያባ፥</para>
  <para style="q2" vid="PSA 105:5">አ ማላታነ እ ፕርዴዳ ፕርዳ ሀሳይተ።<verse eid="PSA 105:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 105:6"/>ህንተኖ፥</para>
  <para style="q2" vid="PSA 105:6">አ ቆማ አብራሃማ ዘረቶ፥</para>
  <para style="q2" vid="PSA 105:6">ዶረቴዳ ያቆባ ናቶ።<verse eid="PSA 105:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7"/>እ መና ጎዳ ኑ ጾሳ፤</para>
  <para style="q2" vid="PSA 105:7">አ ቱሞ ፕርዳይካ ሳኣ ኡባ ቦላና።<verse eid="PSA 105:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8"/>እ ባረ ጫቁዋ መናዉ፥</para>
  <para style="q2" vid="PSA 105:8">ባረ አዛዜዳ ቃላ ሻኡ የለታ ጋካናዉ ናጌ።<verse eid="PSA 105:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9"/>ሄዌነ፥ እ፥ አብራሃማና ጫቀቴዳ ጫቁዋ፥<note caller="-" style="x"><char style="xo" closed="false">105:9 </char><char style="xt" closed="false"><ref loc="GEN 12:7">ዶመ 12:7</ref>፤ <ref loc="GEN 17:8">17:8</ref>፤ <ref loc="GEN 26:3">26:3</ref></char></note></para>
  <para style="q2" vid="PSA 105:9">ይሳቃዉ ጫቄዳ ጫቁዋ፥<verse eid="PSA 105:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10"/>ያቆባዉ ዎጋ፥<note caller="-" style="x"><char style="xo" closed="false">105:10-11 </char><char style="xt" closed="false"><ref loc="GEN 28:13">ዶመ 28:13</ref></char></note></para>
  <para style="q2" vid="PSA 105:10">እስራኤልያዉካ መና ጫቁዋ</para>
  <para style="q2" vid="PSA 105:10">ኦደ ምንሴዳ።<verse eid="PSA 105:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11"/>ሀዋዳን ያጌዳ፤</para>
  <para style="q2" vid="PSA 105:11">“ነዉ ካናነ ቢታ እማና፤</para>
  <para style="q1" vid="PSA 105:11">እ ነ ዘረቶ ላታ ግዳና” ያጌዳ።<verse eid="PSA 105:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12"/>ጾሳ አሳቱ ፓይዱዋን ጺ ጉነ</para>
  <para style="q2" vid="PSA 105:12">ካናነ ቢታን በተ ግዲደ ደእያ ዎደ፥<verse eid="PSA 105:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13"/>እት ጋድያፐ ሀራ ጋድያ፥</para>
  <para style="q2" vid="PSA 105:13">እት ካዉተፐ ሀራ ካዉተ ዩዬድኖ።<verse eid="PSA 105:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14"/>ጾሳይ ኡንቱንታ ኦንነ ናቃናዉ እምቤና፤<note caller="-" style="x"><char style="xo" closed="false">105:14-15 </char><char style="xt" closed="false"><ref loc="GEN 20:3-7">ዶመ 20:3-7</ref></char></note></para>
  <para style="q2" vid="PSA 105:14">ኡንቱንቱ ድራዉ ካተቱዋ ሴሪደ፥<verse eid="PSA 105:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15"/>“ታን ኦኬዳዋንታ ቦቾፕተ፤</para>
  <para style="q2" vid="PSA 105:15">ታ ትምቢትያ ኦድያዋንታ ቆሆፕተ” ያጌዳ።<verse eid="PSA 105:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16"/>ጾሳይ ቢታን ኮሻ የዲደ፥<note caller="-" style="x"><char style="xo" closed="false">105:16 </char><char style="xt" closed="false"><ref loc="GEN 41:53-57">ዶመ 41:53-57</ref></char></note></para>
  <para style="q2" vid="PSA 105:16">ኡንቱንቱ ካ ኡባ ይሴዳ።<verse eid="PSA 105:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17"/>ሽን እ ባረ አሳ አሻናዉ፥<note caller="-" style="x"><char style="xo" closed="false">105:17 </char><char style="xt" closed="false"><ref loc="GEN 37:28">ዶመ 37:28</ref>፤ <ref loc="GEN 45:5">45:5</ref></char></note></para>
  <para style="q2" vid="PSA 105:17">እት ብታንያ ግብጼ ኪቴዳ፤</para>
  <para style="q2" vid="PSA 105:17">ሄ ብታኒ አይለ ግዲደ ዛልኤቴዳ ዮሴፋ።<verse eid="PSA 105:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18"/>አ ገደቱ ብራታን ቃሸቴድኖ፤<note caller="-" style="x"><char style="xo" closed="false">105:18-19 </char><char style="xt" closed="false"><ref loc="GEN 39:20-40:23">ዶመ 39:20—40:23</ref></char></note></para>
  <para style="q2" vid="PSA 105:18">ኡንቱንቱ አ ሳንሳላታን ቃቼድኖ።<verse eid="PSA 105:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19"/>እ ካሰ ኦዴዳዌ ፖለታና ጋካናዉ፥</para>
  <para style="q2" vid="PSA 105:19">መና ጎዳ ቃላይ አ ፓጬዳ።<verse eid="PSA 105:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20"/>ግብጼ ካቲ ኪቲደ ቃሾ ጎልያፐ ከሴዳ፥<note caller="-" style="x"><char style="xo" closed="false">105:20 </char><char style="xt" closed="false"><ref loc="GEN 41:14">ዶመ 41:14</ref></char></note></para>
  <para style="q2" vid="PSA 105:20">ጋድያ ሞድያዌ ብሌዳ።<verse eid="PSA 105:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21"/>እካ፥ አ ባረ ጎልያዉ ጎዳ ኦዳነ።<note caller="-" style="x"><char style="xo" closed="false">105:21 </char><char style="xt" closed="false"><ref loc="GEN 41:39-41">ዶመ 41:39-41</ref></char></note></para>
  <para style="q2" vid="PSA 105:21">ባረዉ ደእያዋ ኡባ ቦላ ሱንዳ።<verse eid="PSA 105:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22"/>ባረዉ ዋና ካፖቱዋ አዛዛና ማላነ</para>
  <para style="q2" vid="PSA 105:22">ባረ ጭማቱዋ ዞራና ማላ ማታዬዳ።<verse eid="PSA 105:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23"/>ሄዋፐ ጉይያን፥ እስራኤሊ ግብጼ ገሌዳ፥<note caller="-" style="x"><char style="xo" closed="false">105:23 </char><char style="xt" closed="false"><ref loc="GEN 46:6">ዶመ 46:6</ref>፤ <ref loc="GEN 47:11">47:11</ref></char></note></para>
  <para style="q2" vid="PSA 105:23">ያይቆበ ካመ ቢታን በተ ግዲደ ደኤዳ።<verse eid="PSA 105:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24"/>መና ጎዳይ ባረ አሳ ዳሮ ጮራዬዳ፤<note caller="-" style="x"><char style="xo" closed="false">105:24-25 </char><char style="xt" closed="false"><ref loc="EXO 1:7-14">ከሳ 1:7-14</ref></char></note></para>
  <para style="q2" vid="PSA 105:24">ኡንቱንቱ ሞርከቱዋፐ ኡንቱንታ አደ ምን።<verse eid="PSA 105:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25"/>እ ግብጼ አሳይ ባረ አሳ እጻናዳንነ</para>
  <para style="q2" vid="PSA 105:25">ባረ ቆማቱዋ ጭማናዳን ኦዳ።<verse eid="PSA 105:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26"/>ሄዋፐ ጉይያን፥ ባረ ቆማ ሙሳነ<note caller="-" style="x"><char style="xo" closed="false">105:26 </char><char style="xt" closed="false"><ref loc="EXO 3:1-4:17">ከሳ 3:1—4:17</ref></char></note></para>
  <para style="q2" vid="PSA 105:26">ባረ ዶሬዳ አሮና ኡንቱንቱኮ ኪቴዳ።<verse eid="PSA 105:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27"/>ኡንቱንቱ ግብጼ አሳቱዋ ስንን ጾሳ ማላታ፥</para>
  <para style="q2" vid="PSA 105:27">ካመ ቢታን ኦራባ ኦድኖ።<verse eid="PSA 105:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28"/>ጾሳይ ማ ኪቲደ፥<note caller="-" style="x"><char style="xo" closed="false">105:28 </char><char style="xt" closed="false"><ref loc="EXO 10:21-23">ከሳ 10:21-23</ref></char></note></para>
  <para style="q2" vid="PSA 105:28">ሄ ቢታ ምሴዳ፤</para>
  <para style="q2" vid="PSA 105:28">ሽን ግብጼ አሳቱ አ አዛዙዋ እጼድኖ።<verse eid="PSA 105:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29"/>እ ኡንቱንቱ ሃ ሱዉ ላሚደ፥<note caller="-" style="x"><char style="xo" closed="false">105:29 </char><char style="xt" closed="false"><ref loc="EXO 7:17-21">ከሳ 7:17-21</ref></char></note></para>
  <para style="q2" vid="PSA 105:29">ሞለቱዋ ዎዳ።<verse eid="PSA 105:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30"/>ኡንቱንቱ ቢታ ኡባ፥<note caller="-" style="x"><char style="xo" closed="false">105:30 </char><char style="xt" closed="false"><ref loc="EXO 8:1-6">ከሳ 8:1-6</ref></char></note></para>
  <para style="q2" vid="PSA 105:30">ካትያ ጎልያካ ሸ ኩሜዳ።<verse eid="PSA 105:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31"/>እ አዛዝና፥ ኡዱንጺነ ቢኒ<note caller="-" style="x"><char style="xo" closed="false">105:31 </char><char style="xt" closed="false"><ref loc="EXO 8:16-17">ከሳ 8:16-17</ref>፣ <ref loc="EXO 8:20-24">20-24</ref></char></note></para>
  <para style="q2" vid="PSA 105:31">ኡንቱንቱ ቢታ ኡባ ቦላ ሻምእሻምኤዳ።<verse eid="PSA 105:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32"/>ኡንቱንቱ ቢታ ቦላን እራ ድራዉ</para>
  <para style="q2" vid="PSA 105:32">ሻቻ ዋልቃንና ቡክሴዳ።<note caller="-" style="x"><char style="xo" closed="false">105:32-33 </char><char style="xt" closed="false"><ref loc="EXO 9:22-25">ከሳ 9:22-25</ref></char></note><verse eid="PSA 105:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33"/>እ ኡንቱንቱ ዎይንያ ቱራነ</para>
  <para style="q2" vid="PSA 105:33">ባላስያ ግያ ም ሾጬዳ፤</para>
  <para style="q2" vid="PSA 105:33">ኡንቱንቱ ቢታን ደእያ ምካ ክንቼሬዳ።<verse eid="PSA 105:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34"/>እ አዛዝና፥ ቦሊነ</para>
  <para style="q2" vid="PSA 105:34">ፓይዱ ባይና ቡምቡረይ ከሴዳ።<note caller="-" style="x"><char style="xo" closed="false">105:34-35 </char><char style="xt" closed="false"><ref loc="EXO 10:12-15">ከሳ 10:12-15</ref></char></note><verse eid="PSA 105:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35"/>ኡንቱንቱ ቢታን ዶሌዳ ካ ኡባ ሜዳ፤</para>
  <para style="q2" vid="PSA 105:35">ሳኣፐ እርጻባ ኡባካ ም ይሴዳ።<verse eid="PSA 105:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36"/>ጾሳይ ግብጼ አሳቱዋ ጎለ ባይራ ናናቱዋ ኡባ ዎዳ፤<note caller="-" style="x"><char style="xo" closed="false">105:36 </char><char style="xt" closed="false"><ref loc="EXO 12:29">ከሳ 12:29</ref></char></note></para>
  <para style="q2" vid="PSA 105:36">ኮይሮ የለቴዳ ኡባ ይሴዳ።<verse eid="PSA 105:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37"/>ሄዋፐ ጉይያን፥ እ እስራኤልያ አሳ</para>
  <para style="q2" vid="PSA 105:37">ዎርቃነ ብራ አሌቁዋና ከሴዳ፤<note caller="-" style="x"><char style="xo" closed="false">105:37-38 </char><char style="xt" closed="false"><ref loc="EXO 12:33-36">ከሳ 12:33-36</ref></char></note></para>
  <para style="q2" vid="PSA 105:37">ኡንቱንቱ ግዶፐ ኩንዲደ አቴዳዌ ኦንነ ባዋ።<verse eid="PSA 105:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38"/>ግብጼ አሳቱ ኡንቱንቶ ዳሮ ያዬዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 105:38">ኡንቱንቱ ከሴዳዋን ናሸቴድኖ።<verse eid="PSA 105:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39"/>ጾሳይ ኡንቱንታ ካማናዉ ሻርያ ምጬዳ፤<note caller="-" style="x"><char style="xo" closed="false">105:39 </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">ከሳ 13:21-22</ref></char></note></para>
  <para style="q2" vid="PSA 105:39">ቃማ ኡንቱንቶ ፖእሳናዉ ታማ ጊግሴዳ።<verse eid="PSA 105:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40"/>ኡንቱንቱ ምያዋ ኦችና፥</para>
  <para style="q2" vid="PSA 105:40">አካ ማላትያ ካፎቱዋ ኡንቱንቶ የዴዳ፤<note caller="-" style="x"><char style="xo" closed="false">105:40 </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">ከሳ 17:1-7</ref>፤ <ref loc="NUM 20:2-13">ፓይ. 20:2-13</ref></char></note></para>
  <para style="q2" vid="PSA 105:40">ኡንቱንታ ሳሉዋ ቁማ ካልሴዳ።<verse eid="PSA 105:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41"/>እ ሹቻ ጳልቂና፥</para>
  <para style="q2" vid="PSA 105:41">ሃይ ፑልቴዳ፤</para>
  <para style="q2" vid="PSA 105:41">ሻፋዳን ባዙዋን ጎጌዳ።<verse eid="PSA 105:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42"/>እ ባረ ቆማ አብራሃማዉ፥</para>
  <para style="q2" vid="PSA 105:42">ገሌዳ ጌሻ ቃላ ሀሳዬዳ።<verse eid="PSA 105:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43"/>እ ባረ አሳ ናሸቻን፥</para>
  <para style="q2" vid="PSA 105:43">ባረ ዶሬዳዋንታ እልልሳን ከሴዳ።<verse eid="PSA 105:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44"/>እ ኡንቱንቶ ሀራ አሳቱዋ ቢታ እሜዳ፤<note caller="-" style="x"><char style="xo" closed="false">105:44 </char><char style="xt" closed="false"><ref loc="JOS 11:16-23">ኢያሳ 11:16-23</ref></char></note></para>
  <para style="q2" vid="PSA 105:44">ኡንቱንቱ ሀራቱ ዳቡሬዳ ጎሻ ላቴድኖ።<verse eid="PSA 105:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45"/>ሄዋ እ ኦዳዌ ኡንቱንቱ አ ዎጋ</para>
  <para style="q2" vid="PSA 105:45">ናጋናዳናነ አ ህግያ ኦናዳና።</para>
  <para style="b" vid="PSA 105:45"/>
  <para style="q1" vid="PSA 105:45">መና ጎዳ ጋላትተ!<verse eid="PSA 105:45"/></para>
  <chapter eid="PSA 105"/>
  <chapter number="106" style="c" sid="PSA 106"/>
  <para style="s1">ጾሳይ ባረ አሳዉ በስያ ኬካተ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1"/>መና ጎዳ ጋላትተ!<note caller="-" style="x"><char style="xo" closed="false">106:1 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1 ኦዱዋ 16:34</ref>፤ <ref loc="2CH 5:13">2 ኦዱዋ 5:13</ref>፤ <ref loc="2CH 7:3">7:3</ref>፤ <ref loc="EZR 3:11">እዝራ 3:11</ref>፤ <ref loc="PSA 100:5">ማዝ. 100:5</ref>፤ <ref loc="PSA 107:1">107:1</ref>፤ <ref loc="PSA 118:1">118:1</ref>፤ <ref loc="PSA 136:1">136:1</ref>፤ <ref loc="JER 33:11">ኤር. 33:11</ref></char></note></para>
  <para style="q2" vid="PSA 106:1">እ ኬካ ግድያ ድራዉነ፥</para>
  <para style="q3" vid="PSA 106:1">አገና አ ሲቁ መናዋ ግድያ ድራዉ፥</para>
  <para style="q3" vid="PSA 106:1">መና ጎዳ ጋላትተ።<verse eid="PSA 106:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2"/>መና ጎዳይ ኦዳ ዎልቃማ ኦሱዋ ኦዳናዉ፥</para>
  <para style="q2" vid="PSA 106:2">ዎይ አ ጋላታ ኡባ ቆንጭሳናዉ፥ ዳንዳይያዌ ኦኔ?<verse eid="PSA 106:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3"/>ፕርዳ ናግያዋንቱነ፥</para>
  <para style="q2" vid="PSA 106:3">ኡባ ገደ ጽሎባ ኦያዋንቱ አንጀቴዳዋንታ።<verse eid="PSA 106:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4"/>አቤት መና ጎዳዉ፥ ኔን ነ አሳዉ ኬክያ ዎደ፥</para>
  <para style="q2" vid="PSA 106:4">ታናካ ቆፓ፤</para>
  <para style="q2" vid="PSA 106:4">ኡንቱንታ ኔን አሽያ ዎደ፥</para>
  <para style="q2" vid="PSA 106:4">ታዉካ አላ።<verse eid="PSA 106:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5"/>ሄዌነ፥ ነ ዶሬዳ አሳዉ፥</para>
  <para style="q2" vid="PSA 106:5">ሳአይ ሎእና፥ ታን በአናዳና፤</para>
  <para style="q2" vid="PSA 106:5">ነ አሳ ናሸቻ ታንካ ናሸታናዳንነ</para>
  <para style="q2" vid="PSA 106:5">ነዋንቱና እትፐ ታንካ ጋላታናዳና።<verse eid="PSA 106:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6"/>ኑን ኑ አዎቱዋዳን ናጋራ ኦዶ፤</para>
  <para style="q2" vid="PSA 106:6">ባይዞባነ ኢታባ ኦዶ።<verse eid="PSA 106:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7"/>ኑ አዎቱ ግብጼን ደእያ ዎደ፥</para>
  <para style="q2" vid="PSA 106:7">ነ ማላልስያ ኦሱዋ ቆፕበይክኖ።<note caller="-" style="x"><char style="xo" closed="false">106:7 </char><char style="xt" closed="false"><ref loc="EXO 14:10-12">ከሳ 14:10-12</ref></char></note></para>
  <para style="q1" vid="PSA 106:7">አገና ነ ሲቁዋ ዳሮተ ኡንቱንቱ ሀሳይበይክኖ፤</para>
  <para style="q2" vid="PSA 106:7">ዞኦ አባ ላንቂያን ነ ቦላ ማካሌድኖ።<verse eid="PSA 106:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8"/>ግዶፐካ እ ባረ ሱን ድራዉ፥</para>
  <para style="q2" vid="PSA 106:8">ባረ ዎልቃማ ዎልቃ ኤርሳናዉ ኡንቱንታ አሼዳ።<verse eid="PSA 106:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9"/>እ ዞኦ አባ አዛዝና፥ አባይ መሌዳ፤<note caller="-" style="x"><char style="xo" closed="false">106:9-12 </char><char style="xt" closed="false"><ref loc="EXO 14:21-31">ከሳ 14:21-31</ref></char></note></para>
  <para style="q2" vid="PSA 106:9">ባዙዋን ካለያዋዳን፥</para>
  <para style="q2" vid="PSA 106:9">ጪማ ግዱዋና ኡንቱንታ ካለደ ፕንዳ።<verse eid="PSA 106:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10"/>እ ኡንቱንታ እጽያዋንቱ ኩሽያፐ አሼዳ፤</para>
  <para style="q2" vid="PSA 106:10">ሞርከቱዋ ኩሽያፐ ኡንቱንታ ዎዜዳ።<verse eid="PSA 106:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11"/>ኡንቱንቱ ሞርከቱዋ ሃይ ምቴዳ፤</para>
  <para style="q2" vid="PSA 106:11">ኡንቱንቱፐ እቱነ አትቤና።<verse eid="PSA 106:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12"/>ሄ ዎደ እስራኤላቱ አ ቃላ አማኔድኖ፤<note caller="-" style="x"><char style="xo" closed="false">106:12 </char><char style="xt" closed="false"><ref loc="EXO 15:1-21">ከሳ 15:1-21</ref></char></note></para>
  <para style="q2" vid="PSA 106:12">አ ሳቤድኖ።<verse eid="PSA 106:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13"/>ግዶፐነ፥ ኡንቱንቱ እ ኦዳዋ</para>
  <para style="q2" vid="PSA 106:13">ኤለካ ዶጌድኖ።</para>
  <para style="q1" vid="PSA 106:13">አ ዞርያ ናገናን ባረንቱ ኮዬዳዋ ኦድኖ።<verse eid="PSA 106:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14"/>ባዙዋን ደኢድ፥ ኡንቱንቱ</para>
  <para style="q2" vid="PSA 106:14">ዳሮፐ አሞቴድኖ፤<note caller="-" style="x"><char style="xo" closed="false">106:14-15 </char><char style="xt" closed="false"><ref loc="NUM 11:4-34">ፓይ. 11:4-34</ref></char></note></para>
  <para style="q2" vid="PSA 106:14">ቃይ መላ ቢታን ጾሳ ፓጬድኖ።<verse eid="PSA 106:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15"/>ሄዋዳን እ ኡንቱንቱ ዎሴዳዋ እሜዳ፤</para>
  <para style="q2" vid="PSA 106:15">ሽን ኡንቱንቱ ሸምፖ ግልቃተ ኪቴዳ።<verse eid="PSA 106:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16"/>አሳቱ ባዙዋን ባረንቱ ዱንካንያን ደኢድ፥</para>
  <para style="q2" vid="PSA 106:16">ሙሳነ መና ጎዳዉ ዱማቴዳ፥</para>
  <para style="q2" vid="PSA 106:16">ቆማ አሮና ቃናቴዳ ዎደ፥<note caller="-" style="x"><char style="xo" closed="false">106:16-18 </char><char style="xt" closed="false"><ref loc="NUM 16:1-35">ፓይ. 16:1-35</ref></char></note><verse eid="PSA 106:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17"/>ቢታይ ዶየቲደ ዳታና ምቴዳ፤</para>
  <para style="q2" vid="PSA 106:17">አቤሮና አ ጎልያ አሳቱዋና ሞጌዳ።<verse eid="PSA 106:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18"/>ቃይ ኡንቱንቱ ማባራ ግዶን ታማይ ኤጽና፥</para>
  <para style="q2" vid="PSA 106:18">ላጩ ሄ ኢታ አሳቱዋ ጹጌዳ።<verse eid="PSA 106:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19"/>ኮሬባ ደርያን ደኢድ፥</para>
  <para style="q2" vid="PSA 106:19">ዎርቃ ሙሽሲደ ማራ ምስልያ መድኖ፤<note caller="-" style="x"><char style="xo" closed="false">106:19-23 </char><char style="xt" closed="false"><ref loc="EXO 32:1-14">ከሳ 32:1-14</ref></char></note></para>
  <para style="q2" vid="PSA 106:19">ሄ ምስልያዉ ጎይኔድኖ።<verse eid="PSA 106:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20"/>ኡንቱንቱ ባረንቱ ቦንቾ ጾሳ</para>
  <para style="q2" vid="PSA 106:20">ማታ ምያ ሚዛ ምስልያን ላሜድኖ።<verse eid="PSA 106:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21"/>ኡንቱንቱ ባረና አሼዳ ጾሳ ዶጌድኖ፤</para>
  <para style="q2" vid="PSA 106:21">እ ግብጼን ዎልቃማ ኦሱዋ፥<verse eid="PSA 106:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22"/>ካመ ቢታን ማላልስያባነ፥</para>
  <para style="q2" vid="PSA 106:22">ዞኦ አባን፥ “ሆላ!” ጊስያባ ኦዳ።<verse eid="PSA 106:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23"/>ሄዋ ድራዉ፥ ጾሳይ ኡንቱንታ ይሳና ጌዳ፤</para>
  <para style="q2" vid="PSA 106:23">ሽን ይሰና ማላ፥ አ ሀንቁዋ ዛራናዉ፥</para>
  <para style="q1" vid="PSA 106:23">ጾሳይ ዶሬዳ ሙሴ ግዱዋን ኤቄዳ።<verse eid="PSA 106:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24"/>ሄዋፐ ጉይያን፥ ኡንቱንቱ</para>
  <para style="q2" vid="PSA 106:24">አ ቃላ አማነና ድራዉ፥</para>
  <para style="q2" vid="PSA 106:24">ሄ ሎኦ ቢታ ካድኖ።<note caller="-" style="x"><char style="xo" closed="false">106:24-26 </char><char style="xt" closed="false"><ref loc="NUM 14:1-35">ፓይ. 14:1-35</ref></char></note><verse eid="PSA 106:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25"/>ኡንቱንቱ ባረንቱ ዱንካንያ ግዶን</para>
  <para style="q2" vid="PSA 106:25">ዙዙሜድኖነ</para>
  <para style="q1" vid="PSA 106:25">መና ጎዳ ቃላዉ አዛዘትበይክኖ።<verse eid="PSA 106:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26"/>ሄዋ ድራዉ፥ እ ኡንቱንታ ባዙዋን አጋናዋ፥</para>
  <para style="q2" vid="PSA 106:26">ባረ ኩሽያ ደንደ ጫቄዳ።<verse eid="PSA 106:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27"/>ኡንቱንቱ ዘረ ካዉተቱዋ ግዶን አጋናዉነ</para>
  <para style="q2" vid="PSA 106:27">ቢታን ኡንቱንታ ላላናዉ ጫቄዳ።<note caller="-" style="x"><char style="xo" closed="false">106:27 </char><char style="xt" closed="false"><ref loc="LEV 26:33">ዎጋ 26:33</ref></char></note><verse eid="PSA 106:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28"/>ሄዋፐ ጉይያን፥ ኡንቱንቱ ፓኦራን ደእያ ባኣላ ኤቃዉ፥</para>
  <para style="q2" vid="PSA 106:28">ጎይንያዉንቱና እትፐ ጋከቴድኖ፤<note caller="-" style="x"><char style="xo" closed="false">106:28-31 </char><char style="xt" closed="false"><ref loc="NUM 25:1-13">ፓይ. 25:1-13</ref></char></note></para>
  <para style="q2" vid="PSA 106:28">ሸምፑ ባይና ኤቃቶ ያርሸቴዳ ያርሹዋ ሜድኖ።<verse eid="PSA 106:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29"/>ኡንቱንቱ ባረንቱ ኦሱዋን መና ጎዳ ሀንቀድኖ፤</para>
  <para style="q2" vid="PSA 106:29">ኡንቱንቱ ግዶን ኢታ ሀርጊ ዎዳ።<verse eid="PSA 106:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30"/>ሽን ፒንሃስ ደንዲደ፥</para>
  <para style="q2" vid="PSA 106:30">ኡንቱንቱ ባይዙዋ ፕርድና፥</para>
  <para style="q2" vid="PSA 106:30">ኢታ ሀርጊ ኡንቱንቱ ቦላፐ ክቼዳ።<verse eid="PSA 106:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31"/>ሄዌነ፥ የለታፐ የለታ ጋካናዉ፥</para>
  <para style="q2" vid="PSA 106:31">መናዉ አዉ ጽሎተ ግዲደ ፓይደቴዳ።<verse eid="PSA 106:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32"/>ማሪባ ፑልቱዋ ማታን መና ጎዳ ሀንቀድኖ፤<note caller="-" style="x"><char style="xo" closed="false">106:32-33 </char><char style="xt" closed="false"><ref loc="NUM 20:2-13">ፓይ. 20:2-13</ref></char></note></para>
  <para style="q2" vid="PSA 106:32">ኡንቱንቱ ጋሱዋን ሙሴ ቦላ መቱ ጋኬዳ።<verse eid="PSA 106:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33"/>አያዉ ጎፐ፥ ኡንቱንቱ አ ሀንቀድኖ፤</para>
  <para style="q2" vid="PSA 106:33">ሙሴ ዶናፐ በሰና ቃላይ ከሴዳ።<verse eid="PSA 106:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34"/>መና ጎዳይ ይስተ ጊና፥</para>
  <para style="q2" vid="PSA 106:34">ኡንቱንቱ ካናነ አሳቱዋ ይስበይክኖ።<note caller="-" style="x"><char style="xo" closed="false">106:34-36 </char><char style="xt" closed="false"><ref loc="JDG 2:1-3">ዳና. 2:1-3</ref>፤ <ref loc="JDG 3:5-6">3:5-6</ref></char></note><verse eid="PSA 106:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35"/>ሄዋፐካ፥ ኡንቱንቱ ሄ አሳቱዋና</para>
  <para style="q2" vid="PSA 106:35">ገለት አከቲደ፥ ዋላከቴድኖነ፤</para>
  <para style="q2" vid="PSA 106:35">ኡንቱንቱ ደኡዋ ዎጋ ካሌድኖ።<verse eid="PSA 106:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36"/>ጾሳ አሳቱ ኡንቱንቱ ኤቃዉ ጎይኔድኖ፤</para>
  <para style="q2" vid="PSA 106:36">ሄዌነ፥ ኡንቱንቶ ጲረ ግዴዳ።<verse eid="PSA 106:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37"/>ኡንቱንቱ ባረንቱ አቱማነ ማጫ ናናቱዋ</para>
  <para style="q2" vid="PSA 106:37">ጻላሄቶ ያርሼድኖ።<note caller="-" style="x"><char style="xo" closed="false">106:37 </char><char style="xt" closed="false"><ref loc="2KI 17:17">2 ካታ. 17:17</ref></char></note><verse eid="PSA 106:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38"/>ኡንቱንቱ፥ ጽሎ ሱ</para>
  <para style="q2" vid="PSA 106:38">ካናነ ኤቃቶ ያርሸድኖ፥</para>
  <para style="q2" vid="PSA 106:38">ባረንቱ አቱማነ ማጫ ናናቱዋ ሱ ጉሰድኖ፤<note caller="-" style="x"><char style="xo" closed="false">106:38 </char><char style="xt" closed="false"><ref loc="NUM 35:33">ፓይ. 35:33</ref></char></note></para>
  <para style="q2" vid="PSA 106:38">ሄ ሱን ቢታይ ቱኔዳ።<verse eid="PSA 106:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39"/>ሄዋዳን ኡንቱንቱ ባረንቱ ኦሱዋን ቱኔድኖነ፥</para>
  <para style="q2" vid="PSA 106:39">ሻርሙጻዳን ኡንቱንቱ ባረንቱ ጾሳዉ አማነተናን እጼድኖ።<verse eid="PSA 106:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40"/>ሄዋ ድራዉ፥ መና ጎዳ ሀንቁ፥</para>
  <para style="q2" vid="PSA 106:40">አ አሳ ቦላ ኤጽ ከሴዳ፤<note caller="-" style="x"><char style="xo" closed="false">106:40-46 </char><char style="xt" closed="false"><ref loc="JDG 2:14-18">ዳና. 2:14-18</ref></char></note></para>
  <para style="q1" vid="PSA 106:40">እ ባረዋንታ ሸነቴዳ።<verse eid="PSA 106:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41"/>እ ኡንቱንታ ሀራ ጋድያ አሳቱዋ ኩሽያን አደ እሜዳ፤</para>
  <para style="q2" vid="PSA 106:41">ኡንቱንቱ እጼዳዋንቱ ኡንቱንታ ሞዴድኖ።<verse eid="PSA 106:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42"/>ኡንቱንቱ ሞርከቱ ኡንቱንታ ናቄድኖነ</para>
  <para style="q2" vid="PSA 106:42">ባረንቱ ሸንያዳን አይሴድኖ።<verse eid="PSA 106:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43"/>እ ኡንቱንታ ዳሮ ገደ አሼዳ፤</para>
  <para style="q2" vid="PSA 106:43">ሽን ኡንቱንቱ ማካላዉ ዳንጭ ደንዴድኖ፤</para>
  <para style="q2" vid="PSA 106:43">ባረንቱ ናጋራ ጋሱዋን ዬድኖ።<verse eid="PSA 106:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44"/>ግዶፐነ፥ እ ኡንቱንቱ ዋሴዳ ዋሱዋ ስሲደ፥</para>
  <para style="q2" vid="PSA 106:44">ኡንቱንቱ ዋይያ ቆፔዳ።<verse eid="PSA 106:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45"/>እ ኡንቱንቱ ድራዉ፥ ባረ ጫቁዋ ሀሳዬዳ፤</para>
  <para style="q2" vid="PSA 106:45">አገና ባረ ሲቁዋ ዳሩዋዳን ኡንቱንታ ማሬዳ።<verse eid="PSA 106:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46"/>ኡንቱንታ ኦሞዴዳ ኡባይ ኡንቱንቶ ቃረታናዳን ኦዳ።<verse eid="PSA 106:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47"/>አቤት መና ጎዳዉ፥ ኑ ጾሳዉ፥ ኑና አሻ።<note caller="-" style="x"><char style="xo" closed="false">106:47-48 </char><char style="xt" closed="false"><ref loc="1CH 16:35-36">1 ኦዱዋ 16:35-36</ref></char></note></para>
  <para style="q2" vid="PSA 106:47">ኑን ነ ጌሻ ሱን ጋላታናዳንነ</para>
  <para style="q2" vid="PSA 106:47">ነ ቦንቹዋን ጬቀታናዳን፥</para>
  <para style="q2" vid="PSA 106:47">ካዉተቱዋ ግዶፐ ኑና ሺሻ።<verse eid="PSA 106:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48"/>መና ጎዳይ፥ እስራኤልያ ጾሳይ</para>
  <para style="q2" vid="PSA 106:48">መናፐ መና ጋካናዉ ጋላተቶ!</para>
  <para style="q1" vid="PSA 106:48">አሳይ ኡባይ፥ “አመንእ!” ጎ።</para>
  <para style="b" vid="PSA 106:48"/>
  <para style="q2" vid="PSA 106:48">መና ጎዳ ጋላትተ!<verse eid="PSA 106:48"/></para>
  <chapter eid="PSA 106"/>
  <chapter number="107" style="c" sid="PSA 107"/>
  <para style="ms">እቼሸን ማጻፋ</para>
  <para style="mr">(<ref loc="PSA 107-150">107—150</ref>)</para>
  <para style="s1">መቱዋ ኡባፐ አሽያ ጾሳ ጋላትተ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1"/>መና ጎዳ ጋላትተ!<note caller="-" style="x"><char style="xo" closed="false">107:1 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1 ኦዱዋ 16:34</ref>፤ <ref loc="2CH 5:13">2 ኦዱዋ 5:13</ref>፤ <ref loc="2CH 7:3">7:3</ref>፤ <ref loc="EZR 3:11">እዝራ 3:11</ref>፤ <ref loc="PSA 100:5">ማዝ. 100:5</ref>፤ <ref loc="PSA 106:1">106:1</ref>፤ <ref loc="PSA 118:1">118:1</ref>፤ <ref loc="PSA 136:1">136:1</ref>፤ <ref loc="JER 33:11">ኤር. 33:11</ref></char></note> አያዉ ጎፐ፥</para>
  <para style="q2" vid="PSA 107:1">እ ኬካ፤ አገና አ ሲቁ መናሳ።<verse eid="PSA 107:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2"/>መና ጎዳይ አሼዳዋንቱነ፥</para>
  <para style="q2" vid="PSA 107:2">ሞርከቱዋ ኩሽያፐ ዎዜዳዋንቱ፥</para>
  <para style="q2" vid="PSA 107:2">ሄዋዳን ጊደ ሃሳይኖ።<verse eid="PSA 107:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3"/>ኡንቱንታ እ ቢታቱዋፐ፥</para>
  <para style="q2" vid="PSA 107:3">አዋይ ዶልያሳፐነ ዉልያሳፐ፥</para>
  <para style="q2" vid="PSA 107:3">ሁጲሳነ ገድሳ ባጋፐ</para>
  <para style="q2" vid="PSA 107:3">ሺሼዳዋንታ።<verse eid="PSA 107:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4"/>ኡንቱንቱፐ እቱ እቱ ባዙዋ ቢታን ዩዬድኖ።</para>
  <para style="q2" vid="PSA 107:4">ባረንቱ ደእያ ካታማ ብያ ኦግያ፥</para>
  <para style="q2" vid="PSA 107:4">ደማናዉ ዳንዳይበይክኖ።<verse eid="PSA 107:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5"/>ኡንቱንቱ ኮሻቴድኖነ ሳመቴድኖ፤</para>
  <para style="q2" vid="PSA 107:5">ኡንቱንቱ ይባቴድኖ።<verse eid="PSA 107:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6"/>ኡንቱንቱ መቶቴዳ ዎደ፥</para>
  <para style="q2" vid="PSA 107:6">መና ጎዳዉ ዋሴድኖ፤</para>
  <para style="q1" vid="PSA 107:6">እ ኡንቱንታ ኡንቱንቱ ዋይያፐ አሼዳ።<verse eid="PSA 107:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7"/>ኡንቱንቱ ደአና ካታማ ጋካናዉ፥</para>
  <para style="q2" vid="PSA 107:7">እ ኡንቱንታ ስታ ኦግያና ካለዳ።<verse eid="PSA 107:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8"/>አገና አ ሲቆነ፥</para>
  <para style="q2" vid="PSA 107:8">እ አሳዉ ኦዳ ማላልስያባዉ፥</para>
  <para style="q2" vid="PSA 107:8">ኡንቱንቱ መና ጎዳ ጋላትኖ።<verse eid="PSA 107:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9"/>አያዉ ጎፐ፥ እ ሳመቴዳዋንታ አሌ፤</para>
  <para style="q2" vid="PSA 107:9">ኮሻቴዳዋንታካ ሎኦባ ካልሴ።<verse eid="PSA 107:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10"/>ኡንቱንቱፐ እቱ እቱ</para>
  <para style="q2" vid="PSA 107:10">ጵ ጎ ማ ግዶን ኡቴድኖ፤</para>
  <para style="q1" vid="PSA 107:10">ኡንቱንቱ ብራታ ሳንሳላታን ዋየቴድኖ።<verse eid="PSA 107:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11"/>አያዉ ጎፐ፥ ኡንቱንቱ ጾሳ ቃላዉ ማካሌድኖነ፥</para>
  <para style="q2" vid="PSA 107:11">ኡባፐ ቂያ ጾሳ ዞርያ ካድኖ።<verse eid="PSA 107:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12"/>እ ኡንቱንታ ቱጋ ኦሱዋን ዳቡርሴዳ፤</para>
  <para style="q2" vid="PSA 107:12">ኡንቱንቱ ኩንዴድኖ፤</para>
  <para style="q2" vid="PSA 107:12">ሽን ኡንቱንታ ማድያዌ ዬዳ።<verse eid="PSA 107:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13"/>ኡንቱንቱ መቶቴዳ ዎደ፥ መና ጎዳዉ ዋሴድኖ፤</para>
  <para style="q2" vid="PSA 107:13">እ ኡንቱንታ ኡንቱንቱ ዋይያፐ አሼዳ።<verse eid="PSA 107:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14"/>ባረቶ ማፐካ ከሴዳ፤</para>
  <para style="q2" vid="PSA 107:14">ኡንቱንቱ ቃሸቴዳ ብራታ ሳንሳላታካ ዱዳ።<verse eid="PSA 107:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15"/>አገና አ ሲቆነ</para>
  <para style="q2" vid="PSA 107:15">እ አሳዉ ኦዳ ማላልስያዎ</para>
  <para style="q2" vid="PSA 107:15">ኡንቱንቱ መና ጎዳ ጋላትኖ።<verse eid="PSA 107:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16"/>አያዉ ጎፐ፥ እ ናሃስያፐ ኦሰቴዳ ፐንግያ መንዳ፤</para>
  <para style="q2" vid="PSA 107:16">ብራታ ኩልቡዋካ ኬዳ።<verse eid="PSA 107:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17"/>ኡንቱንቱፐ እቱ እቱ ቦዛ ግዴድኖ፤</para>
  <para style="q2" vid="PSA 107:17">ባረንቱ ኦዳ ናጋራ ጋሱዋንነ፥</para>
  <para style="q2" vid="PSA 107:17">ባረንቱ ኢታተ ጋሱዋን ቱጋቴድኖ።<verse eid="PSA 107:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18"/>ኡንቱንቱ ቁማ ኡባ ሸነቲደ፥</para>
  <para style="q2" vid="PSA 107:18">ሀይቆ ማቴድኖ።<verse eid="PSA 107:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19"/>ኡንቱንቱ መቶቴዳ ዎደ፥ መና ጎዳዉ ዋሴድኖ፤</para>
  <para style="q2" vid="PSA 107:19">እ ኡንቱንታ ኡንቱንቱ ዋይያፐ አሼዳ።<verse eid="PSA 107:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20"/>እ ባረ ቃላ ኪቲደ፥ ኡንቱንታ ፓዳ፤</para>
  <para style="q2" vid="PSA 107:20">ዱፉዋን ገልያዋፐ አሼዳ።<verse eid="PSA 107:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21"/>አገና አ ሲቆነ</para>
  <para style="q2" vid="PSA 107:21">እ አሳዉ ኦዳ ማላልስያዎ</para>
  <para style="q2" vid="PSA 107:21">ኡንቱንቱ መና ጎዳ ጋላትኖ።<verse eid="PSA 107:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22"/>ኡንቱንቱ አዉ ጋላታ ያርሹዋ ያርሽኖ፤</para>
  <para style="q2" vid="PSA 107:22">ቃይ ናሸቻ የን እ ኦዳዋ ኦድኖ።<verse eid="PSA 107:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23"/>ኡንቱንቱፐ እቱ እቱ፥</para>
  <para style="q2" vid="PSA 107:23">ማርካብያን ዎልቃማ አባ ቦላን ቤድኖ።</para>
  <para style="q1" vid="PSA 107:23">ኡንቱንቱ ሄ ዎልቃማ አባ ቦላ ባረንቱ ኦሱዋ ኦያዋንታ።<verse eid="PSA 107:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24"/>ኡንቱንቱ መና ጎዳ ኦሱዋ፥</para>
  <para style="q2" vid="PSA 107:24">እ ጪማ ጋርሳን ኦዳ ማላልስያባ በኤድኖ።<verse eid="PSA 107:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25"/>እ አዛዚደ፥ ጎትያ ደንዳ፤</para>
  <para style="q2" vid="PSA 107:25">አባ ሆቢ ቃጼዳ።<verse eid="PSA 107:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26"/>ኡንቱንቱ ፑደ ሳሉዋ ጩጉደቴድኖ፤</para>
  <para style="q2" vid="PSA 107:26">ሄዋፐ ዱገ ጪማ ዎድኖ።</para>
  <para style="q1" vid="PSA 107:26">ሄ ኢታ መቱ ጋክና፥ ኡንቱንቱ ዎዛናይ ቶዩ ጌዳ።<verse eid="PSA 107:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27"/>ኡንቱንቱ ማቴዳ አሳዳን</para>
  <para style="q2" vid="PSA 107:27">በቲደ ጋንድጋሬድኖ፤</para>
  <para style="q2" vid="PSA 107:27">ኡንቱንቱ ኤራይካ ጆሌዳ።<verse eid="PSA 107:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28"/>ኡንቱንቱ መቶቴዳ ዎደ፥ መና ጎዳዉ ዋሴድኖ፤</para>
  <para style="q2" vid="PSA 107:28">እ ኡንቱንታ ኡንቱንቱ ዋይያፐ አሼዳ።<verse eid="PSA 107:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29"/>እ ጎትያ ጮኡ ኦዳ፤</para>
  <para style="q2" vid="PSA 107:29">አባ ቤታካ ስርጵ ኦዳ።<verse eid="PSA 107:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30"/>ጮኡ ጌዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 107:30">ኡንቱንቱ ናሸቴድኖ፤</para>
  <para style="q1" vid="PSA 107:30">ጾሳይ ኡንቱንታ ኡንቱንቱ አሞቴዳ ካታማ አሄዳ።<verse eid="PSA 107:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31"/>አገና አ ሲቆነ</para>
  <para style="q2" vid="PSA 107:31">እ አሳዉ ኦዳ ማላልስያባዉ</para>
  <para style="q2" vid="PSA 107:31">ኡንቱንቱ መና ጎዳ ጋላትኖ።<verse eid="PSA 107:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32"/>ኡንቱንቱ አ አሳቱዋ ሺቁዋን ቁ ቁ ኦኖ፤</para>
  <para style="q2" vid="PSA 107:32">ቃይ ጭማቱዋ ሺቁዋን አ ጋላትኖ።<verse eid="PSA 107:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33"/>ጾሳይ ሻፋቱዋ መልሴዳ፤</para>
  <para style="q2" vid="PSA 107:33">ፑልቶቱካ ጎገናዳን ተኤዳ።<verse eid="PSA 107:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34"/>ሄዋን ደእያ አሳቱዋ ኢታተ ድራዉ፥</para>
  <para style="q1" vid="PSA 107:34">ሞክያ አራዳ ቢታካ፥</para>
  <para style="q2" vid="PSA 107:34">ሞከና መላ ቢታዉ ላሜዳ።<verse eid="PSA 107:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35"/>እ ዛሪደ መላ ባዙዋን ሃይ ኤላናዳን፥</para>
  <para style="q2" vid="PSA 107:35">ቃይ መላ ቢታን ፑልቱ ቃናዳን ኦዳ።<verse eid="PSA 107:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36"/>ኮሸቴዳዋንታ ሄ ሳኣን ዎዳ፤</para>
  <para style="q2" vid="PSA 107:36">ኡንቱንቱ ባረንቶ ደእያ ካታማ ኬጼድኖ።<verse eid="PSA 107:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37"/>ኡንቱንቱ ባረንቱ ጎሻን ዘሪደ፥</para>
  <para style="q2" vid="PSA 107:37">ዎይንያ ቶኪደ፥</para>
  <para style="q2" vid="PSA 107:37">ዳሮ ሙሩታ ሺሼድኖ።<verse eid="PSA 107:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38"/>እ ኡንቱንታ አንጅና፥ ኡንቱንቱ ሎይ ጮራቴድኖ፤</para>
  <para style="q2" vid="PSA 107:38">ኡንቱንቱ መህያካ ጉቤና።<verse eid="PSA 107:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39"/>አሳቱ ጾነትያ ዎደነ ኡንቱንቱ ኡቁና፥</para>
  <para style="q2" vid="PSA 107:39">መቱዋነ ካዩዋ ጋሱዋን ካዉሽያ ዎደ፥<verse eid="PSA 107:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40"/>ጾሳይ ካፖቱዋ ካዳዋ በሴ፤</para>
  <para style="q2" vid="PSA 107:40">ኦጊ ባይና ባዙዋን ቶይላካታናዳን እ ኡንቱንታ ኦ።<verse eid="PSA 107:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41"/>ሽን እ ህዬሳቱዋ ቱጋፐ ከሲደ፥</para>
  <para style="q2" vid="PSA 107:41">ኡንቱንቱ ጎለ አሳ ዶርሳ ዉድያዳን ጮራዬ።<verse eid="PSA 107:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42"/>ሱረ አሳቱ እ ኦያዋ በኢደ ናሸቲኖ፤</para>
  <para style="q2" vid="PSA 107:42">ሽን ኢታ አሳቱ ኡባይ ጮኡ ጊኖ።<verse eid="PSA 107:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43"/>አዳ ኤራንቻ ግድያዌ ሀ የዉዋ ቆፖ፤</para>
  <para style="q2" vid="PSA 107:43">መና ጎዳ አገና ሲቁዋ አኬኮ።<verse eid="PSA 107:43"/></para>
  <chapter eid="PSA 107"/>
  <chapter number="108" style="c" sid="PSA 108"/>
  <para style="s1">ዎንታ ሳባነ ጋላታ</para>
  <para style="d">ዳዊታ ማዛሙርያ፥ የ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1"/>አቤት ጾሳዉ፥ ታ ዎዛናይ ምኒደ ደኤ።</para>
  <para style="q2" vid="PSA 108:1">ታን ነዉ ታ ኩመን ዎዛናፐ የጻናነ ኔና ሳባና።<verse eid="PSA 108:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2"/>ዲዉነ ማስንቆ ቤጎትተ!</para>
  <para style="q2" vid="PSA 108:2">ታንካ ዎንታ ጉራና ቤጎታና።<verse eid="PSA 108:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3"/>አቤት መና ጎዳዉ፥ ታን ኔና አሳ ግዶን ጋላታና፤</para>
  <para style="q2" vid="PSA 108:3">ቃይ ካዉተ ግዶን ኔና ሳባና።<verse eid="PSA 108:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4"/>አያዉ ጎፐ፥ አገና ነ ሲቁ ዎልቃማ፤</para>
  <para style="q2" vid="PSA 108:4">ሳሉዋፐ ቦላዉ አ።</para>
  <para style="q1" vid="PSA 108:4">ነ ቱማተይካ ቦላ ሻርያዳን ቄ።<verse eid="PSA 108:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5"/>አቤት ጾሳዉ፥ ሳሎቱዋፐ ቦላና</para>
  <para style="q2" vid="PSA 108:5">ቁ ቁ ጋ!</para>
  <para style="q1" vid="PSA 108:5">ነ ቦንቹ ሳኣ ኡባ ቦላ ግዶ።<verse eid="PSA 108:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6"/>ኔን ሲቅያዋንቱ አታና ማላ፥</para>
  <para style="q2" vid="PSA 108:6">ነ ኡሸቻ ኩሽያን ኑና አሻ፤</para>
  <para style="q2" vid="PSA 108:6">ኔን ታዉ አላ።<verse eid="PSA 108:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7"/>ጾሳይ ባረ ጌሻ ሳኣን ሀዋዳን ያጌዳ፤</para>
  <para style="q2" vid="PSA 108:7">“ታን ጾናደ ሰኬማ ቢታ ሻካና፤</para>
  <para style="q2" vid="PSA 108:7">ቃይ ሱኮታ ዛንጋራ ግሻና።<verse eid="PSA 108:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8"/>ጋላኣደ ታዋ፤ ምናሰካ ታሳ፤</para>
  <para style="q2" vid="PSA 108:8">ኤፍሬም ታ ሁጲያ አሽያ ቆብያ፤</para>
  <para style="q1" vid="PSA 108:8">ይሁዳይ ታ ካዉተ ጻምኣ።<verse eid="PSA 108:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9"/>ሞኣበ ታን ሜጨትያ ኩይጻሩዋ፤</para>
  <para style="q2" vid="PSA 108:9">ኤዶም ታዋ ግድያዋ ኤርሳናዉ</para>
  <para style="q2" vid="PSA 108:9">ታ ጫማ አ ቦላ ዎይ።</para>
  <para style="q2" vid="PSA 108:9">ታን ፕልስጼማ ጾናደ ገሬራይ” ያጌዳ።<verse eid="PSA 108:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10"/>ግምበቴዳ ካታማኮ፥ ታና ኦኔ አፋናዌ?</para>
  <para style="q2" vid="PSA 108:10">ኤዶማ ጋካናዉ ታና ኦኔ ካለናዌ?<verse eid="PSA 108:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11"/>አቤት ጾሳዉ፥ ኑና አጌዳዌ ኔና ግድኪ?</para>
  <para style="q2" vid="PSA 108:11">አቤት ጾሳዉ፥ ኔን ኑ ቶራንቻቱዋና ኦላዉ ከሳካ።<verse eid="PSA 108:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12"/>አሳ ማዱ ፓና ድራዉ፥</para>
  <para style="q2" vid="PSA 108:12">ሞርክያና ኦለታናዉ ኔን ኑና ማዳ።<verse eid="PSA 108:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13"/>ጾሳ ዎልቃን ኑን ኑ ሞርከቱዋ ጾናና፤</para>
  <para style="q2" vid="PSA 108:13">ኑ ሞርከቱዋ የናዌ አ።<verse eid="PSA 108:13"/></para>
  <chapter eid="PSA 108"/>
  <chapter number="109" style="c" sid="PSA 109"/>
  <para style="s1">ሞርክያ ቦላ ሺቆ ዎሳ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ዳውት ጻፌዳ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1"/>አቤት ታን ጋላትያ ጾሳዉ፥</para>
  <para style="q2" vid="PSA 109:1">ኔን ታዉ ጮኡ ጎፓ።<verse eid="PSA 109:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2"/>አያዉ ጎፐ፥ ኢታ ዎርዳንቻ አሳቱ፥</para>
  <para style="q2" vid="PSA 109:2">ባረንቱ ዶና ታ ቦላ ዶዬድኖ፤</para>
  <para style="q2" vid="PSA 109:2">ኡንቱንቱ ዎርዶ እንጻርሳን ታ ቦላ ሃሳዪኖ።<verse eid="PSA 109:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3"/>ኡንቱንቱ እጾ ቃላና ታና ዶዲኖ፤</para>
  <para style="q2" vid="PSA 109:3">ጋሱ ባይናን ታናና ኦለቲኖ።<verse eid="PSA 109:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4"/>ታን ኡንቱንታ ሲቃይነ ኡንቱንቶ ዎሳይ፤</para>
  <para style="q2" vid="PSA 109:4">ግዶፐካ፥ ኡንቱንቱ ታና ሞቲኖ።<verse eid="PSA 109:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5"/>ታን ሎኡዋ ኦና፥</para>
  <para style="q2" vid="PSA 109:5">ኡንቱንቱ ታዉ ኢታ ዛሪኖ፤</para>
  <para style="q2" vid="PSA 109:5">ታን ኡንቱንታ ሲቅና፥ ኡንቱንቱ ታና እጺኖ።<verse eid="PSA 109:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6"/>ታ ሞርክያ ቦላ ኢታ ዳና ሱን፤</para>
  <para style="q2" vid="PSA 109:6">ሞታንቻይ አ ኡሸቻን ኤቆ።<verse eid="PSA 109:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7"/>አ ብድያ ዎደ፥ እ ባይዛንቻ ግዲደ ቤቶ፤</para>
  <para style="q2" vid="PSA 109:7">አ ዎሳይካ አዉ ስሚደ ጎመቶ!<verse eid="PSA 109:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8"/>አ ላይይ ቃሞ፤<note caller="-" style="x"><char style="xo" closed="false">109:8 </char><char style="xt" closed="false"><ref loc="ACT 1:20">ኪታ 1:20</ref></char></note></para>
  <para style="q2" vid="PSA 109:8">አ ሱንተካ ሀራይ አኮ!<verse eid="PSA 109:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9"/>አ ናናቱ አዉዋ ዪደ ዪእኖ፤</para>
  <para style="q2" vid="PSA 109:9">አ ማቻታ አምኤ ግዱ!<verse eid="PSA 109:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10"/>አ ናናቱ ዩይ ዩዪደ ዎስኖ፤</para>
  <para style="q2" vid="PSA 109:10">ባረንቱ ደእያ ኦናፐካ የደርሰትኖ!<verse eid="PSA 109:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11"/>አ ማጹዋ ኡባ አጮ ኦይቆ፤</para>
  <para style="q2" vid="PSA 109:11">እ ዳቡሪደ ከሴዳባ ኡባ አላጋይ ቦንቆ!<verse eid="PSA 109:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12"/>ኦንነ አዉ ኬካባ ኦፖ፥</para>
  <para style="q2" vid="PSA 109:12">ዎይ አዉዋ ዬዳ አ ናናቶ ቃረቶፖ!<verse eid="PSA 109:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13"/>አ ናናቱ ኡባይ ዉር ይኖ፤</para>
  <para style="q2" vid="PSA 109:13">ካልያ የለታን አ ሱንይ ዶገቶ።<verse eid="PSA 109:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14"/>አ አዎቱዋ ናጋራይ መና ጎዳ ስንን ቆፈቶ፤</para>
  <para style="q2" vid="PSA 109:14">አ አት ናጋራይ ኡባካ ቁጨቶፖ!<verse eid="PSA 109:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15"/>ሄ ናጋራይ ኡባ ገደ መና ጎዳ ስንን ቤቶ፤</para>
  <para style="q2" vid="PSA 109:15">ኡንቱንታ ሀሳይስያዌ ሳኣፐ ቆለት ክቾ!<verse eid="PSA 109:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16"/>አያዉ ጎፐ፥ እ</para>
  <para style="q2" vid="PSA 109:16">ኬካባ ኦናዉ ኡባካ ቆፕቤና፤</para>
  <para style="q2" vid="PSA 109:16">ህዬሳቱዋ፥ መቶታንቻቱዋነ</para>
  <para style="q2" vid="PSA 109:16">ዎዛናይ ማዱጼዳዋንታ የደርሲደ ዎዳ።<verse eid="PSA 109:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17"/>እ ሸቃናዉ ዶሴዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 109:17">እካ ሸቀቴዳዋ ግዶ!</para>
  <para style="q1" vid="PSA 109:17">እ አንጃናዉ ዶሰና ድራዉ፥</para>
  <para style="q2" vid="PSA 109:17">አንጁ አፐ ሃኮ!<verse eid="PSA 109:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18"/>እ ሸቂደ ሳለና፤</para>
  <para style="q2" vid="PSA 109:18">አ ሸቃይ ሃዳን አ ቦላ ካ!</para>
  <para style="q1" vid="PSA 109:18">ዛይትያዳን አ መቀን ገሎ!<verse eid="PSA 109:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19"/>አፍላዳን አ ካሞ፤</para>
  <para style="q2" vid="PSA 109:19">ሳቂያዳን ኡባ ገደ አ ጼሳን ደኦ!<verse eid="PSA 109:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20"/>ሀዌ ታና ሞትያዋንቶነ</para>
  <para style="q2" vid="PSA 109:20">ታና ኢታን ዝግርያዋንቶ፥</para>
  <para style="q1" vid="PSA 109:20">መና ጎዳይ እምያ ዎይቱዋ ግዶ!<verse eid="PSA 109:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21"/>ሽን አቤት ኡባ ሞድያ መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 109:21">ነ ሱን ድራዉ፥ ታና ማዳ።</para>
  <para style="q1" vid="PSA 109:21">አገና ነ ሲቁዋነ</para>
  <para style="q2" vid="PSA 109:21">ነ ኬካተ ድራዉ፥ ታና አሻ።<verse eid="PSA 109:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22"/>አያዉ ጎፐ፥ ታን</para>
  <para style="q2" vid="PSA 109:22">ህዬሳነ መቶታንቻ አሳ፤</para>
  <para style="q2" vid="PSA 109:22">ታ ዎዛናይካ ማዱንጼዳ።<verse eid="PSA 109:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23"/>ታን ኦማርሳ ኩዋዳን ያና ሀናይ፤</para>
  <para style="q2" vid="PSA 109:23">ታን ቦልያዳን ቆቆፈታይ።<verse eid="PSA 109:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24"/>ጾምሽን ታ ጉልባታይ እጼዳ፤</para>
  <para style="q2" vid="PSA 109:24">ታ ቦላይካ ላፌ።<verse eid="PSA 109:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25"/>ታና ሞትያዋንቶ ቅሊጭያዋ ግዳድ፤<note caller="-" style="x"><char style="xo" closed="false">109:25 </char><char style="xt" closed="false"><ref loc="MAT 27:39">ማቶሳ 27:39</ref>፤ <ref loc="MRK 15:29">ማር. 15:29</ref></char></note></para>
  <para style="q2" vid="PSA 109:25">ኡንቱንቱ ታና በኢደ፥ ባረንቱ ሁጲያ ቃኖ።<verse eid="PSA 109:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26"/>አቤት መና ጎዳዉ ታ ጾሳዉ፥ ታና ማዳ፤</para>
  <para style="q2" vid="PSA 109:26">አገና ነ ሲቁዋዳን ታና አሻ።<verse eid="PSA 109:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27"/>አቤት መና ጎዳዉ፥ ሄዌ</para>
  <para style="q2" vid="PSA 109:27">ነ ኩሽያ ግዴዳዋነ</para>
  <para style="q2" vid="PSA 109:27">ሄዋ ኔን ኦዳዋ ታ ሞርከቱ ኤርኖ።<verse eid="PSA 109:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28"/>ኡንቱንቱ ታና ሸቆፐነ፥</para>
  <para style="q2" vid="PSA 109:28">ኔን ታና አንጃ!</para>
  <para style="q1" vid="PSA 109:28">ታ ቦላ ደንድያዋንቱ ዬላትኖ፤</para>
  <para style="q2" vid="PSA 109:28">ሽን ታና ነ ቆማ ናሸቻ።<verse eid="PSA 109:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29"/>ታና ሞትያዋንቱ ካዉሻ ማይኖ፤</para>
  <para style="q2" vid="PSA 109:29">ባረንቱ ዬላካ ኩታዳን ቁማይኖ።<verse eid="PSA 109:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30"/>ታን ታ እንጻርሳን መና ጎዳ ዳሮፐ ጋላታና፤</para>
  <para style="q2" vid="PSA 109:30">ዳሮ አሳይ ሺቄዳሳን አ ጋላታና።<verse eid="PSA 109:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31"/>አያዉ ጎፐ፥ እ ህዬሳ ድራዉ ሞተቴ፤</para>
  <para style="q2" vid="PSA 109:31">ሀይቆ ፕርድያ አሳፐካ አ አሼ።<verse eid="PSA 109:31"/></para>
  <chapter eid="PSA 109"/>
  <chapter number="110" style="c" sid="PSA 110"/>
  <para style="d">ጾሳይ ዶሬዳ ካትያ ዳውት ጻፌዳ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1"/>መና ጎዳይ ታ ጎዳ፥<note caller="-" style="x"><char style="xo" closed="false">110:1 </char><char style="xt" closed="false"><ref loc="MAT 22:44">ማቶሳ 22:44</ref>፤ <ref loc="MRK 12:36">ማር. 12:36</ref>፤ <ref loc="LUK 20:42-43">ሉቃሳ 20:42-43</ref>፤ <ref loc="ACT 2:34-35">ኪታ 2:34-35</ref>፤ <ref loc="1CO 15:25">1 ቆሮ. 15:25</ref>፤ <ref loc="EPH 1:20-22">ኤፈ. 1:20-22</ref>፤ <ref loc="COL 3:1">ቆል. 3:1</ref>፤ <ref loc="HEB 1:13">እብራ. 1:13</ref>፤ <ref loc="HEB 8:1">8:1</ref>፤ <ref loc="HEB 10:12-13">10:12-13</ref></char></note></para>
  <para style="q2" vid="PSA 110:1">“ታን ነ ሞርከቱዋ ኔን ገድያን</para>
  <para style="q3" vid="PSA 110:1">የ ኤቂያዋ ኦና ጋካናዉ፥</para>
  <para style="q3" vid="PSA 110:1">ሀዋን ታፐ ኡሸቻ ባጋና ኡታ” ያጌዳ።<verse eid="PSA 110:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2"/>መና ጎዳይ ነ ምኖተ ጻምኣ ጽዮነፐ ኪታና፤</para>
  <para style="q2" vid="PSA 110:2">ያትና፥ “ነ ሞርከቱዋ ሞዳ!” ያጋና።<verse eid="PSA 110:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3"/>ኔን ነ ሞርከቱዋና ኦለትያ ጋላስ፥</para>
  <para style="q2" vid="PSA 110:3">ነ አሳይ ኤኖ ጋና።</para>
  <para style="q1" vid="PSA 110:3">ዎንታ ጉራ ከተርሳዳን፥</para>
  <para style="q2" vid="PSA 110:3">ነ ዎዳላ አሳይ ኔኮ ጌሻ ደረቱዋን ሺቃና።<verse eid="PSA 110:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4"/>መና ጎዳይ፥ “ማልካ ጸደቅ ቄስያ ግዴዳዋዳን፥</para>
  <para style="q2" vid="PSA 110:4">ኔንካ መናዉ ቄስያ ግዳና” ያጊደ ጫቄዳ፤</para>
  <para style="q1" vid="PSA 110:4">እ ባረ ቆፋ ላመና።<note caller="-" style="x"><char style="xo" closed="false">110:4 </char><char style="xt" closed="false"><ref loc="HEB 5:6">እብራ. 5:6</ref>፤ <ref loc="HEB 6:20">6:20</ref>፤ <ref loc="HEB 7:17">7:17</ref>፣ <ref loc="HEB 7:21">21</ref></char></note><verse eid="PSA 110:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5"/>ጎዳይ ነ ኡሸቻን ደኤ፤</para>
  <para style="q2" vid="PSA 110:5">ባረ ሀንቁዋ ጋላስ እ ካተቱዋ ክንቼሬና።<verse eid="PSA 110:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6"/>ካዉተ ቦላ እ ፕርዳና፤</para>
  <para style="q2" vid="PSA 110:6">ኦላ ደምባቱዋካ አሃ ጻላላ ኦና፤</para>
  <para style="q2" vid="PSA 110:6">ሳኣን ኡባን ደእያ ካተቱዋ እ መንሬና።<verse eid="PSA 110:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7"/>ካቲ ኦግያ ማታን ደእያ ሃ ፑልቱዋፐ ኡሺደ፥</para>
  <para style="q2" vid="PSA 110:7">እ ባረ ሁጲያ ቁ ኦና።<verse eid="PSA 110:7"/></para>
  <chapter eid="PSA 110"/>
  <chapter number="111" style="c" sid="PSA 111"/>
  <para style="s1">ጾሳዉ ሺቅያ ጋላታ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1"/>መና ጎዳ ጋላትተ! ሱረቱ ሺቅያ ሺቁዋን፥</para>
  <para style="q2" vid="PSA 111:1">ታን ታ ፖሎ ዎዛናፐ መና ጎዳ ጋላታና።<verse eid="PSA 111:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2"/>መና ጎዳ ኦሶቱ አይ ኬሻ ግቴ!</para>
  <para style="q2" vid="PSA 111:2">ኡንቱንቱን ናሸትያዋንቱ ኡባይ ኡንቱንታ ቆፓናዉ በሴ።<verse eid="PSA 111:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3"/>አ ኦሶቱ ቦንቹዋንነ</para>
  <para style="q2" vid="PSA 111:3">አንጋን ኩሜዳዋንታ።</para>
  <para style="q1" vid="PSA 111:3">አ ጽሎተይካ መናዉ ደኤ።<verse eid="PSA 111:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4"/>እ ባረ ማላልስያ ኦሶቱ፥</para>
  <para style="q2" vid="PSA 111:4">ሀሳየታናዳን ኦዳ።</para>
  <para style="q1" vid="PSA 111:4">መና ጎዳይ ቃረትያዋነ ማርያዋ።<verse eid="PSA 111:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5"/>ባረዉ ያይያዋንቶ ቁማ እ እሜ፤</para>
  <para style="q2" vid="PSA 111:5">እ ባረ ጫቁዋ መናዉካ ቆፔ።<verse eid="PSA 111:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6"/>አላጋቱዋ ቢታ እምያዋን</para>
  <para style="q2" vid="PSA 111:6">እ ባረ ኦሱዋ ዎልቃ ባረ አሳ በሴዳ።<verse eid="PSA 111:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7"/>አ ኩሽያ ኦሶቱ ቱማነ ልከ፤</para>
  <para style="q2" vid="PSA 111:7">አ ዎጋቱካ ኡባይ አማነትያዋንታ።<verse eid="PSA 111:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8"/>ኡንቱንቱነ መ መናዉ ኤቂደ ደእያዋንታ፤</para>
  <para style="q2" vid="PSA 111:8">ቱማተንነ ሱረተን እመቴዳዋንታ።<verse eid="PSA 111:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9"/>እ ባረ አሳ ዎዚደ ከሴዳ፤</para>
  <para style="q2" vid="PSA 111:9">እ ባረ ጫቁዋ ኡንቱንቱና መናዉ ዎዳ።</para>
  <para style="q1" vid="PSA 111:9">አ ሱንይ ጌሻነ፥ “ሆላ!” ጊስያዋ።<verse eid="PSA 111:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10"/>ኤራተዉ ኮይሩ መና ጎዳዉ ያይያዋ፤<note caller="-" style="x"><char style="xo" closed="false">111:10 </char><char style="xt" closed="false"><ref loc="JOB 28:28">ኢዮባ 28:28</ref>፤ <ref loc="PRO 1:7">ሌም. 1:7</ref>፤ <ref loc="PRO 9:10">9:10</ref></char></note></para>
  <para style="q2" vid="PSA 111:10">አ ዎጋ ኦያዋንቶ ሎኦ አኬካይ ደኤ።</para>
  <para style="q1" vid="PSA 111:10">ጾሳይ መናዉ ጋላተቶ!<verse eid="PSA 111:10"/></para>
  <chapter eid="PSA 111"/>
  <chapter number="112" style="c" sid="PSA 112"/>
  <para style="s1">ሎኦ አሳ ናሸቻ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1"/>መና ጎዳ ጋላትተ! መና ጎዳዉ ያይያነ፥</para>
  <para style="q2" vid="PSA 112:1">አ አዛዙዋ ፖላናዉ ዳሮፐ ናሸትያ አሳይ፥</para>
  <para style="q3" vid="PSA 112:1">አንጀቴዳዋ።<verse eid="PSA 112:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2"/>አ ናናቱ ቢታን ዎልቃማ ግዳና፤</para>
  <para style="q2" vid="PSA 112:2">ሱረ አሳቱዋ የለታይ አንጀታና።<verse eid="PSA 112:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3"/>ሻሉነ ዱረተይ አ ጎልያን ደኤ፤</para>
  <para style="q2" vid="PSA 112:3">አ ጽሎተይካ መናዉ ደአና።<verse eid="PSA 112:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4"/>ሱረ አሳዉ፥</para>
  <para style="q2" vid="PSA 112:4">ኬካ፥ ጽሎነ ቃረትያ አሳቶ፥</para>
  <para style="q2" vid="PSA 112:4">ማ ግዶን ፖኡ ፖኤ።<verse eid="PSA 112:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5"/>ኬካተን ጮ ታልእያ ኡራዉ፥</para>
  <para style="q2" vid="PSA 112:5">ባረ ኦሱዋ ሱረተን ኦያ ኡራዉ፥</para>
  <para style="q2" vid="PSA 112:5">ኬካባይ ያና።<verse eid="PSA 112:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6"/>ጽሎ አሳይ አዉደነ ኩንደና፤</para>
  <para style="q2" vid="PSA 112:6">መናዉ እ ሀሳየታና።<verse eid="PSA 112:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7"/>ኢታባ እ ስሶፐካ ዳጋመና፤</para>
  <para style="q2" vid="PSA 112:7">አያዉ ጎፐ፥ አ ዎዛናይ ቃጸና፤</para>
  <para style="q1" vid="PSA 112:7">መና ጎዳን እ አማነቴ።<verse eid="PSA 112:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8"/>አ ዎዛናይ ጻላ ግድያ ድራዉ፥</para>
  <para style="q2" vid="PSA 112:8">ኡባካ እ ያየና፤</para>
  <para style="q2" vid="PSA 112:8">ዉርሰን ባረ ሞርከቱ ጾነትና በአና።<verse eid="PSA 112:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9"/>እ ህዬሳ አሳዉ ዳርሲደ እሜዳ፤<note caller="-" style="x"><char style="xo" closed="false">112:9 </char><char style="xt" closed="false"><ref loc="2CO 9:9">2 ቆሮ. 9:9</ref></char></note></para>
  <para style="q2" vid="PSA 112:9">ቃይ አ ጽሎተይ መናዉ ደኤ፤</para>
  <para style="q1" vid="PSA 112:9">አ ካጪ ቦንቹዋን ቁ ጌ።<verse eid="PSA 112:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10"/>ኢታ አሳይ ሄዋ በኢደ ይሎቴ፤</para>
  <para style="q2" vid="PSA 112:10">አቻ ጋርጪደ፥ ጮ ዬ።</para>
  <para style="q1" vid="PSA 112:10">ኢታ አሳ አሙ ጮ አታናዋ።<verse eid="PSA 112:10"/></para>
  <chapter eid="PSA 112"/>
  <chapter number="113" style="c" sid="PSA 113"/>
  <para style="s1">ጾሳ ኬካተ ቆንጭስያ ጋላታ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1"/>መና ጎዳ ጋላትተ! ህንተኖ መና ጎዳ ቆማቶ፥</para>
  <para style="q2" vid="PSA 113:1">መና ጎዳ ሱን ጋላትተ!<verse eid="PSA 113:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2"/>መና ጎዳ ሱንይ ሀቼፐ መና ጋካናዉ ጋላተቶ!<verse eid="PSA 113:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3"/>አዋይ ዶልያሳፐ ቢደ</para>
  <para style="q2" vid="PSA 113:3">ዉልያሳ ጋካናዉካ መና ጎዳ ሱንይ ጋላተቶ!<verse eid="PSA 113:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4"/>መና ጎዳይ ካዉተ ኡባፐ ቦላና ሞድያዋ፤</para>
  <para style="q2" vid="PSA 113:4">አ ቦንቹካ ሳሎቱዋፐ ቂያዋ።<verse eid="PSA 113:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5"/>መና ጎዳ ኑ ጾሳ ማል ኦኔ?</para>
  <para style="q1" vid="PSA 113:5">እ ቦላ ቃን ካዉተ አራታን ኡቴዳ።<verse eid="PSA 113:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6"/>እ ሳሎቱዋነ ሳኣ ጼላናዉ</para>
  <para style="q2" vid="PSA 113:6">ዱገ ሆኬ።<verse eid="PSA 113:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7"/>እ ህዬሳ ባናፐ ቁ ኦ፤</para>
  <para style="q2" vid="PSA 113:7">መቶታንቻካ ብድን ፕቱዋፐ ደን።<verse eid="PSA 113:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8"/>ባረ አሳ ሞድያዋንቱና ኡትሴ።<verse eid="PSA 113:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9"/>ማይነ ምሽራቶ ናናቱዋ አቶ ኦደ፥</para>
  <para style="q2" vid="PSA 113:9">ናሸቺደ እ ጎልያን እዞ ቦንችሴ።</para>
  <para style="p" vid="PSA 113:9">መና ጎዳ ጋላትተ!<verse eid="PSA 113:9"/></para>
  <chapter eid="PSA 113"/>
  <chapter number="114" style="c" sid="PSA 114"/>
  <para style="s1">ፓስጋ ማዝሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1"/>እስራኤልያ አሳይ ግብጼ ቢታፐ ከሴዳ ዎደ፥<note caller="-" style="x"><char style="xo" closed="false">114:1 </char><char style="xt" closed="false"><ref loc="EXO 12:51">ከሳ 12:51</ref></char></note></para>
  <para style="q2" vid="PSA 114:1">ያቆባ ጎልያ አሳይ፥</para>
  <para style="q3" vid="PSA 114:1">አላጋ ቃላን ሃሳይያ አሳ የጊደ ቤዳ ዎደ፥<verse eid="PSA 114:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2"/>ይሁዳ አሳይ ጎዳዉ ጌሻ አሳ ግዴዳ፤</para>
  <para style="q2" vid="PSA 114:2">እስራኤልያ አሳይካ አዉ ሞደቴድኖ።<verse eid="PSA 114:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3"/>ዞኦ አባይ ሄዋ በኢደ ባቃቴዳ፤<note caller="-" style="x"><char style="xo" closed="false">114:3 </char><char style="xt" closed="false"><ref loc="EXO 14:21">ከሳ 14:21</ref>፤ <ref loc="JOS 3:16">ኢያሳ 3:16</ref></char></note></para>
  <para style="q2" vid="PSA 114:3">ዮርዳኖሳ ሻፋይካ ጉየ ስሜዳ።<verse eid="PSA 114:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4"/>ደረቱ ዴሻቱዋዳን ቡራቄድኖ፤</para>
  <para style="q2" vid="PSA 114:4">ዞዘቱካ ዶርሳ ማራዳን ጉፈረቴድኖ።<verse eid="PSA 114:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5"/>አባዉ፥ ኔና ባቃትሴዳዌ አዬ?</para>
  <para style="q2" vid="PSA 114:5">ዮርዳኖሳ ሻፋዉ፥ አያዉ ጉየ ስማዲ?<verse eid="PSA 114:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6"/>ህንተኖ ደረቶ፥ ዴሻቱዋዳን</para>
  <para style="q2" vid="PSA 114:6">አያዉ ቡራቄድቴ?</para>
  <para style="q1" vid="PSA 114:6">ህንተኖ ዞዛቶ፥ ዶርሳ ማራዳን፥</para>
  <para style="q2" vid="PSA 114:6">አያዉ ጉፈረቴድቴ?<verse eid="PSA 114:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7"/>ኔኖ ቢታዉ፥ ጎዳ ስንን፥</para>
  <para style="q2" vid="PSA 114:7">ያቆባ ጾሳ ስንን ኮኮራ።<verse eid="PSA 114:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8"/>እ ሹቻ ዜሬቶ ሃ ከሴዳዋ፤<note caller="-" style="x"><char style="xo" closed="false">114:8 </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">ከሳ 17:1-7</ref>፤ <ref loc="NUM 20:2-13">ፓይ. 20:2-13</ref></char></note></para>
  <para style="q2" vid="PSA 114:8">ዛላ፥ ሃ ፑልቱዋ ኦዳዋ።<verse eid="PSA 114:8"/></para>
  <chapter eid="PSA 114"/>
  <chapter number="115" style="c" sid="PSA 115"/>
  <para style="s1">እት ቱሙ ጾሳ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1"/>አቤት መና ጎዳዉ፥ ኑ ግሻ ግደና፤</para>
  <para style="q2" vid="PSA 115:1">ኑ ግሻ ግደናን፥ አገና ነ ሲቆዉነ</para>
  <para style="q3" vid="PSA 115:1">ነ ቱማተ ድራዉ፥ ነ ሱን ቦንቻ።<verse eid="PSA 115:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2"/>ካዉተቱ አያዉ፥</para>
  <para style="q2" vid="PSA 115:2">“ኡንቱንቱ ጾሳይ ሀቃን ደኢ?” ጊኖ?<verse eid="PSA 115:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3"/>ኑ ጾሳይ ሳሉዋና፤</para>
  <para style="q2" vid="PSA 115:3">እ ባረ ዶሴዳዋ አይ ግዶፐካ ኦ።<verse eid="PSA 115:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4"/>ሽን ኡንቱንቱ ኤቃቱ ብራነ ዎርቃ፤<note caller="-" style="x"><char style="xo" closed="false">115:4-8 </char><char style="xt" closed="false"><ref loc="PSA 135:15-18">ማዝ. 135:15-18</ref>፤ <ref loc="REV 9:20">ሳፃ 9:20</ref></char></note></para>
  <para style="q2" vid="PSA 115:4">ኡንቱንቱ አሳ ኩሽያን መቴዳዋንታ።<verse eid="PSA 115:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5"/>ኡንቱንቶ ዶናይ ደኤ፤ ሽን ሃሳይክኖ፤</para>
  <para style="q2" vid="PSA 115:5">አይፊ ደኤ፤ ሽን ጼልክኖ።<verse eid="PSA 115:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6"/>ኡንቱንቶ ሀይይ ደኤ፤ ሽን ስስክኖ፤</para>
  <para style="q2" vid="PSA 115:6">ሲ ደኤ፤ ሽን ስንግክኖ።<verse eid="PSA 115:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7"/>ኡንቱንቶ ኩሺ ደኤ፤ ሽን ኦይቂ ኤርክኖ፤</para>
  <para style="q2" vid="PSA 115:7">ገዲካ ደኤ፤ ሽን ሀመትክኖ፤</para>
  <para style="q2" vid="PSA 115:7">ኡንቱንቱ ባረንቱ ፕላንቲያና ኮሻ ስስክኖ።<verse eid="PSA 115:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8"/>ኡንቱንታ መያዋንቱነ፥</para>
  <para style="q2" vid="PSA 115:8">ኡንቱንቱን አማነትያዋንቱ ኡባይ ኡንቱንቱ ማላ ግድኖ።<verse eid="PSA 115:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9"/>ህንተኖ፥ እስራኤልያ አሳቶ፥</para>
  <para style="q2" vid="PSA 115:9">መና ጎዳን አማነትተ!</para>
  <para style="q1" vid="PSA 115:9">እ ህንተና ማድያዋነ ህንተ ጎንዳልያ።<verse eid="PSA 115:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10"/>ህንተኖ፥ አሮና ጎልያ አሳቶ፥</para>
  <para style="q2" vid="PSA 115:10">መና ጎዳን አማነትተ!</para>
  <para style="q1" vid="PSA 115:10">እ ህንተና ማድያዋነ ህንተ ጎንዳልያ።<verse eid="PSA 115:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11"/>ህንተኖ፥ መና ጎዳዉ ያይያዋንቶ፥</para>
  <para style="q2" vid="PSA 115:11">መና ጎዳን አማነትተ!</para>
  <para style="q1" vid="PSA 115:11">እ ህንተና ማድያዋነ ህንተ ጎንዳልያ።<verse eid="PSA 115:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12"/>መና ጎዳይ ኑና ቆፔ፤ እ ኑና አንጃና።</para>
  <para style="q2" vid="PSA 115:12">እ እስራኤልያ አሳቱዋ አንጃና።</para>
  <para style="q1" vid="PSA 115:12">እ አሮና ጎልያ አሳቱዋ አንጃና።<verse eid="PSA 115:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13"/>መና ጎዳዉ ያይያዋንታ፥</para>
  <para style="q2" vid="PSA 115:13">ጉቱዋካ ግታቱዋካ እ ጋ አንጃና።<note caller="-" style="x"><char style="xo" closed="false">115:13 </char><char style="xt" closed="false"><ref loc="REV 11:18">ሳፃ 11:18</ref>፤ <ref loc="REV 19:5">19:5</ref></char></note><verse eid="PSA 115:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14"/>መና ጎዳይ ህንተናካ ህንተ ናናቱዋካ ዳርሶ!<verse eid="PSA 115:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15"/>ሳሉዋነ ሳኣ መዳ መና ጎዳን አንጀትተ!<verse eid="PSA 115:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16"/>ቦላ ቃ ሳሉ መና ጎዳዋ፤</para>
  <para style="q2" vid="PSA 115:16">ሽን ሳኣ እ አሳዉ እሜዳ።<verse eid="PSA 115:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17"/>ሀይቄዳዋንቱ፥ ዱፉዋን ጮኡ ጌዳዋንቱ፥</para>
  <para style="q2" vid="PSA 115:17">መና ጎዳ ጋላትክኖ።<verse eid="PSA 115:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18"/>ሽን ኑን፥ ፓጻ ደእያዋንቱ፥</para>
  <para style="q2" vid="PSA 115:18">ሀቼፐ ዶሚደ</para>
  <para style="q2" vid="PSA 115:18">መና ጋካናዉ መና ጎዳ ጋላቴቶ።</para>
  <para style="b" vid="PSA 115:18"/>
  <para style="q1" vid="PSA 115:18">መና ጎዳ ጋላትተ!<verse eid="PSA 115:18"/></para>
  <chapter eid="PSA 115"/>
  <chapter number="116" style="c" sid="PSA 116"/>
  <para style="s1">ሀይቁዋፐ አቴዳ አሳ ጋላታ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1"/>እ ታ ኮሻነ ታ ዋትዋቱዋ ስሴዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 116:1">ታን መና ጎዳ ሲቃይ።<verse eid="PSA 116:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2"/>እ ባረ ሀይ ታኮ የጌዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 116:2">ታን ፓጻ ደኤዳ ኬናን ኡባን አ ጼሳና።<verse eid="PSA 116:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3"/>ሀይቁ ጲርያዳን ታና ኦይቃናዉ ሀኔዳ፤</para>
  <para style="q2" vid="PSA 116:3">ሞገታና ህርጋይ ታና ኢሴዳ።</para>
  <para style="q1" vid="PSA 116:3">ታና ኡንአይ ቶሌዳ።<verse eid="PSA 116:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4"/>ሄ ዎደ ታን፥ “አቤት መና ጎዳዉ፥ ሀዳራ!</para>
  <para style="q2" vid="PSA 116:4">ታና አሻ” ያጋደ መና ጎዳ ሱን ጼሳድ።<verse eid="PSA 116:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5"/>መና ጎዳይ ኬካነ ጽሉዋ፤</para>
  <para style="q2" vid="PSA 116:5">ኑ ጾሳይ ቃረትያዋ።<verse eid="PSA 116:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6"/>መና ጎዳይ አሽከ ዎዛናይ ደእያዋንታ ናጌ፤</para>
  <para style="q2" vid="PSA 116:6">ታን መቶቴዳ ዎደ፥ እ ታና አሼዳ።<verse eid="PSA 116:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7"/>ታ ሸምፓቴ፥ ስም ዎፑ ጋ፤</para>
  <para style="q2" vid="PSA 116:7">አያዉ ጎፐ፥ መና ጎዳይ ነዉ ኬኬዳ።<verse eid="PSA 116:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8"/>መና ጎዳይ ታና ሀይቁዋፐ፥</para>
  <para style="q2" vid="PSA 116:8">ታ አይፍያ አፎፐ፥</para>
  <para style="q2" vid="PSA 116:8">ታ ገድያካ ብያፐ አሼዳ።<verse eid="PSA 116:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9"/>ሄዋ ድራዉ፥ ታን፥</para>
  <para style="q2" vid="PSA 116:9">ፓጻ ደእያዋንቱ ግዶን፥</para>
  <para style="q2" vid="PSA 116:9">መና ጎዳ ስንን ሀመታይ።<verse eid="PSA 116:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10"/>ታን፥ “ታና ኡንአይ ቶሌዳ” ግያ ዎደካ፥<note caller="-" style="x"><char style="xo" closed="false">116:10 </char><char style="xt" closed="false"><ref loc="2CO 4:13">2 ቆሮ. 4:13</ref></char></note></para>
  <para style="q2" vid="PSA 116:10">ታ አማኑዋ አጋበይከ።<verse eid="PSA 116:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11"/>ታን ዳጋማደ፥ “አሳይ ኡባይ ዎርዱዋ” ያጋድ።<verse eid="PSA 116:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12"/>እ ታዉ ኬኬዳ ኬካተ ድራዉ፥</para>
  <para style="q2" vid="PSA 116:12">ታን መና ጎዳዉ አይ ጭጋናዉ ዳንዳያይታ?<verse eid="PSA 116:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13"/>ታን ጹኣ ዎይንያ ኤሳ ጋላታዉ ሺሻደ፥</para>
  <para style="q2" vid="PSA 116:13">እ ታና አሾ ድራዉ፥</para>
  <para style="q1" vid="PSA 116:13">መና ጎዳ ሱን ጼሳና።<verse eid="PSA 116:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14"/>አ አሳ ኡባ ስንን</para>
  <para style="q2" vid="PSA 116:14">ታን ቃንግያ መና ጎዳዉ ጋና።<verse eid="PSA 116:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15"/>ጌሻቱዋ ሀይቁ መና ጎዳ ስንን፥</para>
  <para style="q2" vid="PSA 116:15">ሎይ ዳሮፐ ቦንቼቴዳዋ።<verse eid="PSA 116:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16"/>አቤት መና ጎዳዉ፥ ታን ነ ቆማ፤</para>
  <para style="q2" vid="PSA 116:16">ኤ፥ ታን ነ ቆማ፥ ነ ቆማት ናኣ።</para>
  <para style="q1" vid="PSA 116:16">ታና ቃሹዋፐ ኔን ብላዳ።<verse eid="PSA 116:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17"/>አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 116:17">ታን ጋላታ ያርሹዋ ነዉ ያርሻና፤</para>
  <para style="q2" vid="PSA 116:17">ነ ሱን ጼሳና።<verse eid="PSA 116:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18"/>አሳ ኡባ ስንን፥</para>
  <para style="q2" vid="PSA 116:18">ታን ቃንገቴዳ ቃንገ መና ጎዳዉ ጋና።<verse eid="PSA 116:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19"/>ሄዋካ ታን ጋናዌ፥</para>
  <para style="q2" vid="PSA 116:19">የሩሳላመን ደእያ መና ጎዳ ጎልያ ዳባባና።</para>
  <para style="b" vid="PSA 116:19"/>
  <para style="q1" vid="PSA 116:19">መና ጎዳ ጋላትተ!<verse eid="PSA 116:19"/></para>
  <chapter eid="PSA 116"/>
  <chapter number="117" style="c" sid="PSA 117"/>
  <para style="s1">ጋላታ ጼሳ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1"/>ካዉተቶ ኡባቶ፥ መና ጎዳ ጋላትተ!<note caller="-" style="x"><char style="xo" closed="false">117:1 </char><char style="xt" closed="false"><ref loc="ROM 15:11">ሮመ 15:11</ref></char></note></para>
  <para style="q2" vid="PSA 117:1">አሳይ ኡባይ፥ አ ግታይተ!<verse eid="PSA 117:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2"/>አያዉ ጎፐ፥ አገና አ ሲቁ ኑዉ ዎልቃማ፤</para>
  <para style="q2" vid="PSA 117:2">መና ጎዳይ መናዉካ አማነትያዋ።</para>
  <para style="b" vid="PSA 117:2"/>
  <para style="q1" vid="PSA 117:2">መና ጎዳ ጋላትተ!<verse eid="PSA 117:2"/></para>
  <chapter eid="PSA 117"/>
  <chapter number="118" style="c" sid="PSA 118"/>
  <para style="s1">ጾኖ ሺቆ ጋላታ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1"/>መና ጎዳ ጋላትተ! አያዉ ጎፐ፥ እ ኬካ።<note caller="-" style="x"><char style="xo" closed="false">118:1 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1 ኦዱዋ 16:34</ref>፤ <ref loc="2CH 5:13">2 ኦዱዋ 5:13</ref>፤ <ref loc="2CH 7:3">7:3</ref>፤ <ref loc="EZR 3:11">እዝራ 3:11</ref>፤ <ref loc="PSA 100:5">ማዝ. 100:5</ref>፤ <ref loc="PSA 106:1">106:1</ref>፤ <ref loc="PSA 107:1">107:1</ref>፤ <ref loc="PSA 136:1">136:1</ref>፤ <ref loc="JER 33:11">ኤር. 33:11</ref></char></note></para>
  <para style="q2" vid="PSA 118:1">አገና አ ሲቁ መናዋ።<verse eid="PSA 118:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2"/>እስራኤልያ አሳይ፥</para>
  <para style="q2" vid="PSA 118:2">“አገና አ ሲቁ መናዋ” ያጎ።<verse eid="PSA 118:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3"/>አሮና ጎልያ አሳይ፥</para>
  <para style="q2" vid="PSA 118:3">“አገና አ ሲቁ መናዋ” ያጎ።<verse eid="PSA 118:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4"/>መና ጎዳዉ ያይያዋንቱ ኡባይ፥</para>
  <para style="q2" vid="PSA 118:4">“አገና አ ሲቁ መናዋ” ያግኖ።<verse eid="PSA 118:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5"/>ታን ኡንኤቴዳ ዎደ መና ጎዳዉ ዋሳድ፤</para>
  <para style="q2" vid="PSA 118:5">እ ታ ዋሱዋ አሊደ፥ ታና ላአ ከሴዳ።<verse eid="PSA 118:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6"/>መና ጎዳይ ታናና ደእያ ድራዉ፥</para>
  <para style="q2" vid="PSA 118:6">ታን ያይከ።<note caller="-" style="x"><char style="xo" closed="false">118:6 </char><char style="xt" closed="false"><ref loc="HEB 13:6">እብራ. 13:6</ref></char></note></para>
  <para style="q1" vid="PSA 118:6">አስ ታና አይ ኦ?<verse eid="PSA 118:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7"/>መና ጎዳይ ታና ማዳናዉ ታናና ደኤ፤</para>
  <para style="q2" vid="PSA 118:7">ታ ሞርከቱ ጾነቴዳዋንታ ታን በአና።<verse eid="PSA 118:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8"/>አሳን አማነትያዋፐ፥</para>
  <para style="q2" vid="PSA 118:8">መና ጎዳኮ ባቃትያዌ ሎአ።<verse eid="PSA 118:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9"/>ዳናቱዋን አማነትያዋፐ፥</para>
  <para style="q2" vid="PSA 118:9">መና ጎዳኮ ባቃትያዌ ሎአ።<verse eid="PSA 118:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10"/>ካዉተቱ ኡባይ ታና ዶድ ኦይቄድኖ፤</para>
  <para style="q2" vid="PSA 118:10">ሽን መና ጎዳ ሱንን ታን ኡንቱንታ ጾናድ።<verse eid="PSA 118:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11"/>ኡንቱንቱ ታና ዶዴድኖ፤</para>
  <para style="q2" vid="PSA 118:11">ኡባ ሳና ዶድ ኦይቄድኖ፤</para>
  <para style="q2" vid="PSA 118:11">ሽን መና ጎዳ ሱንን ታን ኡንቱንታ ጾናድ።<verse eid="PSA 118:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12"/>ኡንቱንቱ ማይ ዶድያዋዳን፥</para>
  <para style="q2" vid="PSA 118:12">ታ ዩሹዋን ዶዴድኖ።</para>
  <para style="q1" vid="PSA 118:12">ሽን አጉንይ ታማን ኤጽያዋዳን</para>
  <para style="q2" vid="PSA 118:12">ኤጽ ዬድኖ።</para>
  <para style="q1" vid="PSA 118:12">መና ጎዳ ሱንን ታን ኡንቱንታ ጾናድ።<verse eid="PSA 118:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13"/>ታና ሱግ የግና፥ ኩንዳና ሀናይ፤</para>
  <para style="q2" vid="PSA 118:13">ሽን መና ጎዳይ ታና ማዴዳ።<verse eid="PSA 118:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14"/>መና ጎዳይ ታዉ ዎልቃነ ምኖተ፤<note caller="-" style="x"><char style="xo" closed="false">118:14 </char><char style="xt" closed="false"><ref loc="EXO 15:2">ከሳ 15:2</ref>፤ <ref loc="ISA 12:2">ኢሳ. 12:2</ref></char></note></para>
  <para style="q2" vid="PSA 118:14">እ ታና አሽያዋ ግዴዳ።<verse eid="PSA 118:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15"/>ኦላ ጾኒደ ስምያ አሳይ፥</para>
  <para style="q2" vid="PSA 118:15">ጽሎቱዋ ዱንካንያን ሆምቦጪደ፥ ግያዋ ስስተ።</para>
  <para style="q1" vid="PSA 118:15">ኡንቱንቱ፥ “መና ጎዳ ኡሸቻ ኩሺ ዎልቃማባ ኦዳ!<verse eid="PSA 118:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 118:16"/>መና ጎዳ ኡሸቻ ኩሺ ጾኑዋ እሜዳ!</para>
  <para style="q2" vid="PSA 118:16">መና ጎዳ ኡሸቻ ኩሺ ዎልቃማባ ኦዳ!” ያጊኖ።<verse eid="PSA 118:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17"/>ታን ሀይቂከ፤</para>
  <para style="q2" vid="PSA 118:17">ፓጻ ደአናነ መና ጎዳይ ኦዳዋ አዋያና።<verse eid="PSA 118:17"/></para>
  <para style="q3">
    <verse number="18" style="v" sid="PSA 118:18"/>መና ጎዳይ ታና ኢታ ሙሩዋ ሙሬ፤</para>
  <para style="q2" vid="PSA 118:18">ሽን ሀይቆ አደ እምቤና።<verse eid="PSA 118:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19"/>ታን ግዶ ገላደ መና ጎዳ ጋላታና ማላ፥</para>
  <para style="q2" vid="PSA 118:19">ጌሻ ጎልያ ፐንገቱዋ አነ ታዉ ዶይተ።<verse eid="PSA 118:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20"/>ሀዌ መና ጎዳ ፐንግያ፤</para>
  <para style="q2" vid="PSA 118:20">ሀ ፐንግያና ጽሎቱዋ ጻላላይ ገሊኖ።<verse eid="PSA 118:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21"/>ኔን ታና ስሴዳ ድራዉነ</para>
  <para style="q2" vid="PSA 118:21">ጾኑዋ እሜዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 118:21">ታን ኔና ጋላታይ።<verse eid="PSA 118:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22"/>ግምቢያዋንቱ ካደ እጼዳ ሹቻይ፥<note caller="-" style="x"><char style="xo" closed="false">118:22 </char><char style="xt" closed="false"><ref loc="LUK 20:17">ሉቃሳ 20:17</ref>፤ <ref loc="ACT 4:11">ኪታ 4:11</ref>፤ <ref loc="1PE 2:7">1 ጰጽ. 2:7</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">118:22-23</char><char style="xt" closed="false"><ref loc="MAT 21:42">ማቶሳ 21:42</ref>፤ <ref loc="MRK 12:10-11">ማር. 12:10-11</ref></char></note></para>
  <para style="q2" vid="PSA 118:22">ጎዳ ጻጱዋ ምንስያ፥ ኡባፐ አያ ሹቻ ግዴዳ።<verse eid="PSA 118:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23"/>ሀዌ መና ጎዳይ ኦዳዋ፤</para>
  <para style="q2" vid="PSA 118:23">ቃይ ኑ አይፍያዉካ ማላልስያዋ።<verse eid="PSA 118:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24"/>ሀዌ ጋላሳይ መና ጎዳይ መዳ ጋላሳ።</para>
  <para style="q2" vid="PSA 118:24">አነ ኑን አን ናሸቶይተነ እልሎይተ።<verse eid="PSA 118:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25"/>አቤት መና ጎዳዉ፥ ሀእ ኑና አሻርኪ!</para>
  <para style="q2" vid="PSA 118:25">አቤት መና ጎዳዉ፥ ሀእ ኑዉ እንጀያርኪ!<note caller="-" style="x"><char style="xo" closed="false">118:25 </char><char style="xt" closed="false"><ref loc="MAT 21:9">ማቶሳ 21:9</ref>፤ <ref loc="MRK 11:9">ማር. 11:9</ref>፤ <ref loc="JHN 12:13">ዮሃ. 12:13</ref></char></note><verse eid="PSA 118:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26"/>መና ጎዳ ሱንን ይያ አሳይ አንጀቴዳዋ ግዶ!<note caller="-" style="x"><char style="xo" closed="false">118:26 </char><char style="xt" closed="false"><ref loc="MAT 21:9">ማቶሳ 21:9</ref>፤ <ref loc="MAT 23:39">23:39</ref>፤ <ref loc="MRK 11:9">ማር. 11:9</ref>፤ <ref loc="LUK 13:35">ሉቃሳ 13:35</ref>፤ <ref loc="LUK 19:38">19:38</ref>፤ <ref loc="JHN 12:13">ዮሃ. 12:13</ref></char></note></para>
  <para style="q2" vid="PSA 118:26">ኑን መና ጎዳ ጌሻ ጎልያፐ ህንተና አንጄቶ።<verse eid="PSA 118:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27"/>መና ጎዳይ ጾሳ፤ እ ኑ ቦላን ፖእሴዳ።</para>
  <para style="q2" vid="PSA 118:27">እርጻ ታሽያ ኦይቂደ፥ አያና ጋላሳ ቦንችተ፤</para>
  <para style="q2" vid="PSA 118:27">ያርሹዋ ቦላን ደእያ ካጭያኮ አተ።<verse eid="PSA 118:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28"/>ኔን ታ ጾሳ፤ ታን ኔና ጋላታና።</para>
  <para style="q2" vid="PSA 118:28">ኔን ታ ጾሳ፤ ታን ኔና ግታያና።<verse eid="PSA 118:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29"/>መና ጎዳ ጋላትተ! አያዉ ጎፐ፥ እ ኬካ፤</para>
  <para style="q2" vid="PSA 118:29">አገና አ ሲቁ መናዋ።<verse eid="PSA 118:29"/></para>
  <chapter eid="PSA 118"/>
  <chapter number="119" style="c" sid="PSA 119"/>
  <para style="s1">ጾሳ ህግያዉ እመቴዳ ሳባ</para>
  <para style="qa">አለፍ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1"/>ባረንቱ ኦግያን ቶሺ ባይናዋንቱነ፥</para>
  <para style="q2" vid="PSA 119:1">መና ጎዳ ህግያዳን ሀመትያዋንቱ፥</para>
  <para style="q3" vid="PSA 119:1">አንጀቴዳዋንታ።<verse eid="PSA 119:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2"/>እ ኦዴዳዋ ኦያዋንቱነ</para>
  <para style="q2" vid="PSA 119:2">ባረንቱ ኩመን ዎዛናፐ አ ሲቅያዋንቱ፥</para>
  <para style="q2" vid="PSA 119:2">አንጀቴዳዋንታ።<verse eid="PSA 119:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3"/>ኡንቱንቱ ባላባ ኦክኖ፤</para>
  <para style="q2" vid="PSA 119:3">ጾሳ ኦግያን ሀመቲኖ።<verse eid="PSA 119:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4"/>ነ ዎጋዉ አማነቲደ ናጋና ማላ፥</para>
  <para style="q2" vid="PSA 119:4">ኔን ኑና አዛዛዳ።<verse eid="PSA 119:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5"/>ነ አዋዮ አዛዘትያዋን</para>
  <para style="q2" vid="PSA 119:5">ታ ኦጊ ምናናዳን አሞታይ።<verse eid="PSA 119:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6"/>ያቶፐ፥ ነ አዛዙዋ ኡባ ሀይዛደ፥</para>
  <para style="q2" vid="PSA 119:6">ታን ኡባካ ዬላትከ።<verse eid="PSA 119:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7"/>ነ ጽሎ ፕርዳ ታማራደ፥</para>
  <para style="q2" vid="PSA 119:7">ታን ኔና ሱረ ዎዛናፐ ጋላታና።<verse eid="PSA 119:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8"/>ታን ነ አዋዩዋዳን ኦና፤</para>
  <para style="q2" vid="PSA 119:8">ታና ኡባካ የጎፓ።<verse eid="PSA 119:8"/></para>
  <para style="qa">ቤት</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9"/>ያላጋይ ባረ ኦግያ ጌሻ ኦደ</para>
  <para style="q2" vid="PSA 119:9">ዎት ናጋናዉ ዳንዳዪ?</para>
  <para style="q1" vid="PSA 119:9">ነ ቃላይ ግያዋዳን ደኦፐ ዳንዳዬ።<verse eid="PSA 119:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10"/>ታን ታ ፖሎ ዎዛናፐ ኔና ኮያይ፤</para>
  <para style="q2" vid="PSA 119:10">ነ አዛዞቱዋፐ ዎራ ሀመተናዳን ታና ናጋ።<verse eid="PSA 119:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11"/>ታን ኔና ናቀናዳን</para>
  <para style="q2" vid="PSA 119:11">ነ ቃላ ታ ዎዛናን ዎድ።<verse eid="PSA 119:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12"/>አቤት መና ጎዳዉ፥ ኔን ጋላተታ!</para>
  <para style="q2" vid="PSA 119:12">ነ አዋዩዋ ታና ታማርሳ።<verse eid="PSA 119:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13"/>ነ ዶናፐ ከሴዳ ፕርዳ ኡባ፥</para>
  <para style="q2" vid="PSA 119:13">ታን ታ እንጻርሳን ኦዳይ።<verse eid="PSA 119:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14"/>ዱረተን ናሸትያዋዳን፥</para>
  <para style="q2" vid="PSA 119:14">ታን ኔን ኦዴዳ ቃላን ናሸታይ።<verse eid="PSA 119:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15"/>ነ ዎጋቱዋ ዛራ ዛራደ ቆፓይነ</para>
  <para style="q2" vid="PSA 119:15">ነ ኦግያ ሎይ አኬካይ።<verse eid="PSA 119:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16"/>ታን ነ አዋዩዋን ናሸታይ፤</para>
  <para style="q2" vid="PSA 119:16">ነ ቃላካ ታን ዶግከ።<verse eid="PSA 119:16"/></para>
  <para style="qa">ጋሜል</para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17"/>ታን ፓጻ ደአና ማላነ</para>
  <para style="q2" vid="PSA 119:17">ነ ቃላዉ አዛዘታና ማላ፥</para>
  <para style="q2" vid="PSA 119:17">ታዉ ነ ቆማው ኬካባ ኦ።<verse eid="PSA 119:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18"/>ነ ህግያ ግዶን ደእያ ማላልስያ ቱማተ፥</para>
  <para style="q2" vid="PSA 119:18">ታን በአና ማላ፥ ታ አይፍያ ዶያ።<verse eid="PSA 119:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19"/>ታን ሀ ሳኣን እማ፤</para>
  <para style="q2" vid="PSA 119:19">ነ አዛዞቱዋ ታፐ ገንፓ።<verse eid="PSA 119:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20"/>ታን ኡባ ዎደ፥</para>
  <para style="q2" vid="PSA 119:20">ነ ፕርዳ ሎይ ላሞታይ።<verse eid="PSA 119:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21"/>ኦቶረትያዋንቱ፥ ሸቀቴዳዋንታ፥</para>
  <para style="q2" vid="PSA 119:21">ነ አዛዙዋፐ ዎራ ሀመትያዋንታ፥</para>
  <para style="q2" vid="PSA 119:21">ኔን ሴራሳ።<verse eid="PSA 119:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22"/>ታን ኔን ኦዴዳዋ ኦዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 119:22">ኡንቱንቱ ቦርያነ ኡንቱንቱ ካያ ታ ቦላፐ ድጋ።<verse eid="PSA 119:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23"/>ሀራይ አቶ ካፓቱ ሺቂደ፥</para>
  <para style="q2" vid="PSA 119:23">ታ ቦላ ማቀቶፐካ፥</para>
  <para style="q2" vid="PSA 119:23">ታን፥ ነ ቆማይ፥ ነ አዋዩዋ ዛራ ዛራደ ቆፓና።<verse eid="PSA 119:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24"/>ኔን ኦዴዳ ቃላቱ ታና ናሸቺኖ፤</para>
  <para style="q2" vid="PSA 119:24">ኡንቱንቱ ታና ዞሪኖ።<verse eid="PSA 119:24"/></para>
  <para style="qa">ዳሌጽ</para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25"/>ታን ሀይቃና ሀናይ፤</para>
  <para style="q2" vid="PSA 119:25">ኔን ጌዳ ቃላዳን ታ ሸምፑዋ አሻ።<verse eid="PSA 119:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26"/>ታን ታ ኦግያዋ ነዉ ኦድና፥</para>
  <para style="q2" vid="PSA 119:26">ኔን ታና ስሳዳ፤</para>
  <para style="q2" vid="PSA 119:26">ስም፥ ነ አዋዩዋ ታና ታማርሳ።<verse eid="PSA 119:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27"/>ነ ዎጋ ኦግያ ታና አኬክሳ፤</para>
  <para style="q2" vid="PSA 119:27">ማላልስያ ነ ኦሱዋ</para>
  <para style="q2" vid="PSA 119:27">ታን ዛራ ዛራደካ ቆፓና።<verse eid="PSA 119:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28"/>ካዩ ዳሬዳዋን ታ ሸምፑ ዳቡሬዳ፤</para>
  <para style="q2" vid="PSA 119:28">ኔን ጌዳ ቃላዳን ታና ምንሳ።<verse eid="PSA 119:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29"/>ዎርዶ ኦግያ ታፐ ሃሳ፤</para>
  <para style="q2" vid="PSA 119:29">ነ አ ኬካተን ነ ህግያ ታና ታማርሳ።<verse eid="PSA 119:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30"/>ቱሙዋ ኦግያ ዶራድ፤</para>
  <para style="q2" vid="PSA 119:30">ነ ፕርዳ ሀይዛድ።<verse eid="PSA 119:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31"/>አቤት መና ጎዳዉ፥ ታን</para>
  <para style="q2" vid="PSA 119:31">ኔን ኦዴዳዋ ምንሳ ኦይቃድ፤</para>
  <para style="q2" vid="PSA 119:31">ስም ታና ዬላዮፓ!<verse eid="PSA 119:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32"/>ኔን ታ ዎዛና ላአ ከሴዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 119:32">ታን ነ አዛዙዋ ኦግያን ዎጻይ።<verse eid="PSA 119:32"/></para>
  <para style="qa">ሄ</para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33"/>አቤት መና ጎዳዉ፥ ነ አዋዩዋ ብለ</para>
  <para style="q2" vid="PSA 119:33">ታና ታማርሳ፤</para>
  <para style="q2" vid="PSA 119:33">ታን ዉርሰይ ጋካናዉ አ ናጋና።<verse eid="PSA 119:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34"/>ታን ነ ህግያ ናጋና ማላነ</para>
  <para style="q2" vid="PSA 119:34">ታ ኩመን ዎዛናፐ ታን አዉ አዛዘታና ማላ፥</para>
  <para style="q2" vid="PSA 119:34">ኔን ታዉ አኬካ እማ።<verse eid="PSA 119:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35"/>ነ አዛዙዋ ኦግያን ታና ካለ፤</para>
  <para style="q2" vid="PSA 119:35">አያዉ ጎፐ፥ ታን አን ናሸታይ።<verse eid="PSA 119:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36"/>ታ ዎዛና አሙዋኮ ግደናን፥</para>
  <para style="q2" vid="PSA 119:36">ኔን ኦዴዳ ቃላኮ ዛራ።<verse eid="PSA 119:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37"/>ፓናባ ጼለና ማላ፥</para>
  <para style="q2" vid="PSA 119:37">ታ አይፈቱዋ ተአ፤</para>
  <para style="q2" vid="PSA 119:37">ነ ኦግያን ታ ደኡዋ ኦራ።<verse eid="PSA 119:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38"/>ኔን ያየታና ማላ፥</para>
  <para style="q2" vid="PSA 119:38">ኔን ገሎ ቃላ ታዉ፥</para>
  <para style="q2" vid="PSA 119:38">ነ ቆማዉ ፖላ።<verse eid="PSA 119:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39"/>ያሽያ ቦርያ ታፐ ድጋ።</para>
  <para style="q1" vid="PSA 119:39">ነ ፕርዳይ አይ ማላ ሎኤ!<verse eid="PSA 119:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40"/>ታን ነ ዎጋ ናጋናዉ አሞታይ፤</para>
  <para style="q2" vid="PSA 119:40">ኔን ጽሉዋ ግድያ ድራዉ፥</para>
  <para style="q2" vid="PSA 119:40">ታ ደኡዋ ኦራ።<verse eid="PSA 119:40"/></para>
  <para style="qa">ዋዉ</para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41"/>አቤት መና ጎዳዉ፥ አገና ነ ሲቁዋ ታና በሳ፤</para>
  <para style="q2" vid="PSA 119:41">ኔን ጌዳ ቃላዳን ታና አሻ።<verse eid="PSA 119:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42"/>ታን ነ ቃላን አማነትያ ድራዉ፥</para>
  <para style="q2" vid="PSA 119:42">ታና ቦርያዋንቶ ዛራናዉ ዳንዳያይ።<verse eid="PSA 119:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43"/>ታን ነ ፕርዳን ናሸቻ ኦያ ድራዉ፥</para>
  <para style="q2" vid="PSA 119:43">ታ እንጻርሳፐ ቱማተ ቃላ ይሶፓ።<verse eid="PSA 119:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44"/>ታን ኡባ ገደ፥ መ መናዉካ</para>
  <para style="q2" vid="PSA 119:44">ነ ህግያዉ አዛዘታና።<verse eid="PSA 119:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45"/>ታን ነ ዎጋ ፖልያ ድራዉ፥</para>
  <para style="q2" vid="PSA 119:45">አኩዋን ሀመታና።<verse eid="PSA 119:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46"/>ታን ካተቱዋ ስንን ኤቃደ፥</para>
  <para style="q2" vid="PSA 119:46">ኔን ኦዴዳባ ኦዳደ ዬላትከ።<verse eid="PSA 119:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47"/>ታን ዶስያ ነ አዛዞቱዋን ናሸታይ<verse eid="PSA 119:47"/></para>
  <para style="q2">
    <verse number="48" style="v" sid="PSA 119:48"/>ታን ሲቅያ ነ አዛዞቱዋ ቦንቻይ፤</para>
  <para style="q2" vid="PSA 119:48">ነ አዋዩዋካ ዛራ ዛራደ ቆፓና።<verse eid="PSA 119:48"/></para>
  <para style="qa">ዛዉ</para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49"/>ኔን ታዉ፥ ነ ቆማዉ፥</para>
  <para style="q2" vid="PSA 119:49">እሜዳ ቃላ ቆፓ፤</para>
  <para style="q2" vid="PSA 119:49">ሄ ቃላን ታን ሂዶታ ኦይ።<verse eid="PSA 119:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50"/>ኔን፥ “ታን ኔና ፓጻ ዎና”</para>
  <para style="q2" vid="PSA 119:50">ጌዳ ቃላይ ታ ቱጋ ዎደ ታና ምንዳ።<verse eid="PSA 119:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51"/>ኦቶራንቻቱ ታና ልክያፐ አደ ሸቂኖ፤</para>
  <para style="q2" vid="PSA 119:51">ሽን ታን ነ ህግያፐ ሸርእ ጊከ።<verse eid="PSA 119:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52"/>አቤት መና ጎዳዉ፥ በኒደፐ ደእያ ነ ፕርዳ ታን ሀሳያይ፤</para>
  <para style="q2" vid="PSA 119:52">ሄዋን ታን ምነታይ።<verse eid="PSA 119:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53"/>ኢታቱ ነ ህግያዉ አዛዘተናዋ በእና፥</para>
  <para style="q2" vid="PSA 119:53">ይሉ ታና ዎዳ።<verse eid="PSA 119:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54"/>ታን ደእያ አላጋ ቢታን፥</para>
  <para style="q2" vid="PSA 119:54">ነ አዋዩ ታዉ የ ግዴዳ።<verse eid="PSA 119:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55"/>አቤት መና ጎዳዉ፥ ታን ቃማ ነ ሱን ቆፓይ፤</para>
  <para style="q2" vid="PSA 119:55">ነ ህግያካ ናጋይ።<verse eid="PSA 119:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56"/>ነ ዎጋዉ አዛዘትያዌ ታዉ አንጆ ግዴዳ።<verse eid="PSA 119:56"/></para>
  <para style="qa">ሄት</para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57"/>አቤት መና ጎዳዉ፥ ታና ጋኬዳ ሳማይ ኔና፤</para>
  <para style="q2" vid="PSA 119:57">ታን ነ ቃላዉ አዛዘታና ያጋይ።<verse eid="PSA 119:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58"/>ታን ታ ኩመን ዎዛናፐ ኔና ዎሳይ።</para>
  <para style="q1" vid="PSA 119:58">ኔን ጌዳ ቃላዳን ታዉ ቃረታ።<verse eid="PSA 119:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59"/>ታን ታ ኦግያ አኬካ ጼላደ፥</para>
  <para style="q2" vid="PSA 119:59">ኔን ኦዴዳባኮ ስማድ።<verse eid="PSA 119:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60"/>ታን ነ አዛዙዋ ናጋናዉ፥</para>
  <para style="q2" vid="PSA 119:60">ኤሌላናፐ አትና ታክከ።<verse eid="PSA 119:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61"/>ኢታቱ ታና ዎዶሩዋን ቃቾፐካ፥</para>
  <para style="q2" vid="PSA 119:61">ታን ነ ህግያ ዶጋበይከ።<verse eid="PSA 119:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62"/>ነ ጽሎ ፕርዳ ድራዉ፥ ኔና ጋላታናዉ፥</para>
  <para style="q2" vid="PSA 119:62">ታን ቃማ ብላሄ ደንዳይ።<verse eid="PSA 119:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63"/>ታን ነዉ ያይያዋንቱ ኡባዉነ</para>
  <para style="q2" vid="PSA 119:63">ነ ዎጋ ናግያዋንቶ ዳቦ።<verse eid="PSA 119:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64"/>አቤት መና ጎዳዉ፥ ሳአይ</para>
  <para style="q2" vid="PSA 119:64">አገና ነ ሲቁዋን ኩሜዳ፤</para>
  <para style="q2" vid="PSA 119:64">ነ አዋዩዋ ታና ታማርሳ።<verse eid="PSA 119:64"/></para>
  <para style="qa">ጼት</para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65"/>አቤት መና ጎዳዉ፥ ነ ጌዳ ቃላዳን፥</para>
  <para style="q2" vid="PSA 119:65">ታዉ ነ ቆማዉ ኬካባ ኦዳ።<verse eid="PSA 119:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66"/>ታን ነ አዛዞቱዋን አማነትያ ድራዉ፥</para>
  <para style="q2" vid="PSA 119:66">ሎኦ ፕርዳነ ኤራተ ታና ታማርሳ።<verse eid="PSA 119:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67"/>ታን ሙረታናፐ ካሰ ዎራ ሀመታድ፤</para>
  <para style="q2" vid="PSA 119:67">ሽን ሀእ ነ ቃላዉ አዛዘታይ።<verse eid="PSA 119:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68"/>ኔን ኬካ፤ ኔን ኬካባ ኦሳ፤</para>
  <para style="q2" vid="PSA 119:68">ነ አዋዩዋ ታና ታማርሳ።<verse eid="PSA 119:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69"/>ኦቶራንቻቱ ታና ዎርዱዋ ኦኪኖ፤</para>
  <para style="q2" vid="PSA 119:69">ሽን ታን ነ ዎጋ ታ ኩመን ዎዛናፐ ናጋና።<verse eid="PSA 119:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70"/>ኡንቱንቱ ዎዛናይ ኡባካ ዶንጭሎዋንታ፤</para>
  <para style="q2" vid="PSA 119:70">ሽን ታን ነ ህግያን ናሸታይ።<verse eid="PSA 119:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71"/>ታን ሙረቴዳዌ ታዉ ሎኤዳ፤</para>
  <para style="q2" vid="PSA 119:71">አያዉ ጎፐ፥ ነ አዋዩዋ ታማራናዉ ታና ማዴዳ።<verse eid="PSA 119:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72"/>ዳሮ ሻኡ ዎርቃፐነ ብራፐ፥</para>
  <para style="q2" vid="PSA 119:72">ነ ዶናፐ ከሴዳ ህጊ ታዉ አ።<verse eid="PSA 119:72"/></para>
  <para style="qa">ዮድ</para>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73"/>ታና ነ ኩሺ መዳነ ጊግሴዳ።</para>
  <para style="q2" vid="PSA 119:73">ነ አዛዙዋ ታን ታማራና ማላ፥</para>
  <para style="q2" vid="PSA 119:73">ታዉ አኬካ እማ።<verse eid="PSA 119:73"/></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74"/>ታን ነ ቃላን ህዶታ ዎያ ኦዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 119:74">ነዉ ያይያዋንቱ ታና በኢደ ናሸትኖ።<verse eid="PSA 119:74"/></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75"/>አቤት መና ጎዳዉ፥ ነ ፕርዳይ ጽላ ግድያዋነ</para>
  <para style="q2" vid="PSA 119:75">ኔን አማነቴዳዋ ግዶ ድራዉ ታና ሙሬዳዋ ኤራይ።<verse eid="PSA 119:75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76"/>ኔን ታዉ ነ ቆማዉ ጌዳ ቃላዳን፥</para>
  <para style="q2" vid="PSA 119:76">አገና ነ ሲቁ ታና ምንሶ።<verse eid="PSA 119:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77"/>ታን ፓጻ ደአና ማላ፥ ታዉ ቃረታ፤</para>
  <para style="q2" vid="PSA 119:77">አያዉ ጎፐ፥ ነ ህጊ ታና ናሸቼ።<verse eid="PSA 119:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78"/>ኦቶራንቻቱ ዎርዱዋን</para>
  <para style="q2" vid="PSA 119:78">ታና ሞትያ ድራዉ፥ ዬላትኖ።</para>
  <para style="q1" vid="PSA 119:78">ታና ግዶፐ፥ ታን ነ ዎጋቱዋ</para>
  <para style="q2" vid="PSA 119:78">ዛራ ዛራደ ቆፓይ።<verse eid="PSA 119:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79"/>ነዉ ያይያዋንቱነ፥</para>
  <para style="q2" vid="PSA 119:79">ኔን ኦዴዳባ ኤርያዋንቱ ኡባይ፥</para>
  <para style="q2" vid="PSA 119:79">ታኮ ዪኖ።<verse eid="PSA 119:79"/></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80"/>ታን ዬላተና ማላ፥</para>
  <para style="q2" vid="PSA 119:80">ነ አዋዮ አዛዘትያዋን</para>
  <para style="q2" vid="PSA 119:80">ቶሺ ባይናዋ ግዳርክታ!<verse eid="PSA 119:80"/></para>
  <para style="qa">ካፍ</para>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81"/>ኔን ታና አሻና ማላ፥</para>
  <para style="q2" vid="PSA 119:81">ታን ናጋደ ዳቡራይ፤</para>
  <para style="q2" vid="PSA 119:81">ታን ነ ቃላን ህዶታ ኦይ።<verse eid="PSA 119:81"/></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82"/>ኔን ጌዳ ቃላይ ፖለትና</para>
  <para style="q2" vid="PSA 119:82">በአናዉ ጼሊደ፥ ታ አይፊ ጋልጄዳ።</para>
  <para style="q1" vid="PSA 119:82">ታን፥ “ኔን ታና አዉደ ምንኒሻ?” ያጋይ።<verse eid="PSA 119:82"/></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83"/>ጩዋን ካቄዳ ኦጎሩዋ ግዳደ ጉንዳድ፤</para>
  <para style="q2" vid="PSA 119:83">ግዶፐነ፥ ነ አዋዩዋ ባልከ።<verse eid="PSA 119:83"/></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84"/>ታን ነ ቆማይ አዉደ ጋካናዉ ናጎ?</para>
  <para style="q1" vid="PSA 119:84">ታና የደርስያዋንታ ኔን አዉደ ፕርዳኒ?<verse eid="PSA 119:84"/></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85"/>ነ ህግያ ናገና ኦቶራንቻቱ፥</para>
  <para style="q2" vid="PSA 119:85">ታና ኩድሳና ጊደ፥ ታዉ ኦላ ቦኪኖ።<verse eid="PSA 119:85"/></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86"/>ነ አዛዞቱ ኡባይ አማንያዋንታ።</para>
  <para style="q2" vid="PSA 119:86">ታና አሳቱ ዎርዱዋን የደርስያ ድራዉ፥</para>
  <para style="q2" vid="PSA 119:86">ሀእ ታና ማዳ!<verse eid="PSA 119:86"/></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87"/>ኡንቱንቱ ታና ዎ ድጌድኖሽን፤</para>
  <para style="q2" vid="PSA 119:87">ታን ነ ዎጋ አጋበይከ።<verse eid="PSA 119:87"/></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88"/>አገና ነ ሲቁዋን ታ ደኡዋ ናጋ፤</para>
  <para style="q2" vid="PSA 119:88">ሄዌነ፥ ኔን ነ ዶናፐ ኦዴዳዋ ታን ናጋናሳ።<verse eid="PSA 119:88"/></para>
  <para style="qa">ላሜድ</para>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89"/>አቤት መና ጎዳዉ፥ ነ ቃላይ መናሳ፤</para>
  <para style="q2" vid="PSA 119:89">እካ ሳሉዋን ምኒደ ደኤ።<verse eid="PSA 119:89"/></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90"/>ኔን የለታፐ የለታ ጋካናዉ አማነትያዋ።</para>
  <para style="q2" vid="PSA 119:90">ኔን ሀ ሳኣ ባሳደ ኤሳዳ፤</para>
  <para style="q2" vid="PSA 119:90">እካ ምኒደ ደኤ።<verse eid="PSA 119:90"/></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91"/>ኔን ጌዳዋዳን ኡባባይካ</para>
  <para style="q2" vid="PSA 119:91">ሀች ጋካናዉ ምኒደ ደኤ፤</para>
  <para style="q2" vid="PSA 119:91">አያዉ ጎፐ፥ ኡባቱካ ነ ቆማቱዋ።<verse eid="PSA 119:91"/></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92"/>ነ ህጊ ታና ናሸችያባ ግደነንቶ፥</para>
  <para style="q2" vid="PSA 119:92">ታ ቱጋ ዎደ ታን ያና ሽን።<verse eid="PSA 119:92"/></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93"/>ነ ዎጋ ኡባካ ዶግከ፤</para>
  <para style="q2" vid="PSA 119:93">አያዉ ጎፐ፥ ኔን አን ታና ፓጻ ዎዳ።<verse eid="PSA 119:93"/></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94"/>ታን ነዋቴ፤ ታና አሻ፤</para>
  <para style="q2" vid="PSA 119:94">አያዉ ጎፐ፥ ታን ነ ዎጋ ናጋናዉ ኮያይ።<verse eid="PSA 119:94"/></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95"/>ኢታቱ ታና ይሳናዉ ኩኩሊደ ናጊኖ፤</para>
  <para style="q2" vid="PSA 119:95">ሽን ታን ኔን ኦዴዳዋ ቆፓይ።<verse eid="PSA 119:95"/></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96"/>ፖሎ ጌተቶባዉ ኡባባዉ ዛዋይ ደእያዋ ታን በኣድ፤</para>
  <para style="q2" vid="PSA 119:96">ሽን ነ ህግያዉ ዛዋይ ባዋ።<verse eid="PSA 119:96"/></para>
  <para style="qa">ሜም</para>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97"/>ታን ነ ህግያ ዋታ ዶሳይታ!</para>
  <para style="q1" vid="PSA 119:97">ጋላሳ ኩመን ታን ቆፕያዌ አ።<verse eid="PSA 119:97"/></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98"/>ነ አዛዞቱ ኡባ ዎደካ ታናና ደእያ ድራዉ፥</para>
  <para style="q2" vid="PSA 119:98">ኡንቱንቱ ታና ታ ሞርከቱዋፐ አዳ ኤራንቻ ከሲኖ።<verse eid="PSA 119:98"/></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99"/>ታን ኔን ኦዴዳዋ ቆፕያ ድራዉ፥</para>
  <para style="q2" vid="PSA 119:99">ታና ታማርሴዳ ኡባፐካ አዳ አኬካይ ታዉ ደኤ።<verse eid="PSA 119:99"/></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100"/>ታን ነ ዎጋዉ አዛዘትያ ድራዉ፥</para>
  <para style="q2" vid="PSA 119:100">ጭማቱዋፐ አደ አኬካይ።<verse eid="PSA 119:100"/></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101"/>ታን ነ ቃላዉ አዛዘታናዉ ኮይያ ድራዉ፥</para>
  <para style="q2" vid="PSA 119:101">ታ ገድያ ኢታ ኦግያ ኡባፐ ናጋድ።<verse eid="PSA 119:101"/></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102"/>ኔን ታና ታማርሴዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 119:102">ታን ነ ፕርዳፐ ዎራ ባበይከ።<verse eid="PSA 119:102"/></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103"/>ነ ቃላይ አያ ማልኢ!</para>
  <para style="q2" vid="PSA 119:103">ኤሳ እልሉዋፐካ አደ፥</para>
  <para style="q2" vid="PSA 119:103">ታ ዶናን ማልኤ።<verse eid="PSA 119:103"/></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104"/>ነ ዎጋፐ አኬካ ደማድ፤</para>
  <para style="q2" vid="PSA 119:104">ሄዋ ድራዉ፥ ታን ጌላ ኦግያ ኡባ እጻይ።<verse eid="PSA 119:104"/></para>
  <para style="qa">ኖን</para>
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105"/>ነ ቃላይ ታ ገድያዉ ጾምፕያ፥</para>
  <para style="q2" vid="PSA 119:105">ታ ኦግያዉካ ፖኡዋ።<verse eid="PSA 119:105"/></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106"/>ነ ጽሎ ፕርዳዳን ደአናዉ፥</para>
  <para style="q2" vid="PSA 119:106">ታን ጫቄዳ ጫቁዋ ምንና።<verse eid="PSA 119:106"/></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107"/>ታን ዳሮ ቱጋታድ፤</para>
  <para style="q2" vid="PSA 119:107">አቤት መና ጎዳዉ፥ ኔን ጌዳ ቃላዳን</para>
  <para style="q2" vid="PSA 119:107">ታና ፓጻ ዎ።<verse eid="PSA 119:107"/></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108"/>አቤት መና ጎዳዉ፥ ታ ዶናፐ ከስያ ጋላታ፥ ያርሹዋ አካ፤</para>
  <para style="q2" vid="PSA 119:108">ታና ፕርዳ ታማርሳ።<verse eid="PSA 119:108"/></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109"/>ታ ሸምፑ መቱዋ ቦላ ደእንቶካ፥</para>
  <para style="q2" vid="PSA 119:109">ታን ነ ህግያ ዶግከ።<verse eid="PSA 119:109"/></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110"/>ኢታቱ ታዉ ግትያ የጌድኖ፤</para>
  <para style="q2" vid="PSA 119:110">ሽን ታን ነ ዎጋፐ ሸርእ ጋበይከ።<verse eid="PSA 119:110"/></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111"/>ኔን ኦዴዳባይ መናዉ ታዋ፤</para>
  <para style="q2" vid="PSA 119:111">ኤ፥ እ ታ ዎዛናዉ ናሸቻ።<verse eid="PSA 119:111"/></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112"/>ታን መናዉ፥ ዉርሰ ጋካናዉ</para>
  <para style="q2" vid="PSA 119:112">ነ አዋዩዋዳን ኦናዉ ቃቻድ።<verse eid="PSA 119:112"/></para>
  <para style="qa">ሳምከት</para>
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113"/>ታን ላኡ ቆፋይ ደእያ አሳቱዋ እጻይ፤</para>
  <para style="q2" vid="PSA 119:113">ሽን ነ ህግያ ሲቃይ።<verse eid="PSA 119:113"/></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114"/>ኔን ታዉ ቆሰታ አትያ ሳነ</para>
  <para style="q2" vid="PSA 119:114">ታ ጎንዳልያ፤</para>
  <para style="q2" vid="PSA 119:114">ታን ነ ቃላን ህዶታ ኦይ።<verse eid="PSA 119:114"/></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115"/>ታን ታ ጾሳ አዛዙዋ ናጋና ማላ፥</para>
  <para style="q2" vid="PSA 119:115">ህንተኖ፥ ኢታባ ኦያዋንቶ፥</para>
  <para style="q2" vid="PSA 119:115">ታፐ ሃክተ!<verse eid="PSA 119:115"/></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116"/>ኔን ጌዳ ቃላዳን ታና ምንሳ፤</para>
  <para style="q2" vid="PSA 119:116">ያቶፐ፥ ታን ፓጻ ደአና።</para>
  <para style="q1" vid="PSA 119:116">ታን ህዶታን ናግያባን ታና ዬላዮፓ።<verse eid="PSA 119:116"/></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117"/>ታና ዘምፕሳ፤ ያቶፐ፥</para>
  <para style="q2" vid="PSA 119:117">ታን ሳሮ ደአና፤</para>
  <para style="q2" vid="PSA 119:117">ታን ኡባ ዎደ ነ አዋዩዋ ሀይዛና።<verse eid="PSA 119:117"/></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118"/>ነ አዋዩዋፐ ዎራ ብያዋንታ ኡባ ኔን አካካ፤</para>
  <para style="q2" vid="PSA 119:118">ኡንቱንቱ ጭሙ ጮ መላ።<verse eid="PSA 119:118"/></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119"/>ሳኣን ደእያ ኢታቱዋ ኡባ</para>
  <para style="q2" vid="PSA 119:119">ኔን ፕቱዋዳን ፓይዳሳ፤</para>
  <para style="q2" vid="PSA 119:119">ሄዋ ድራዉ፥ ታን ኔን ኦዴዳባ ሲቃይ።<verse eid="PSA 119:119"/></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120"/>ታ ቦላይ ነዉ ያዪደ ኮኮሬዳ፤</para>
  <para style="q2" vid="PSA 119:120">ታን ነ ፕርዳዉ ያያይ።<verse eid="PSA 119:120"/></para>
  <para style="qa">ኤ</para>
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121"/>ልከባነ ጽሎባ ኦድ፤</para>
  <para style="q2" vid="PSA 119:121">ታና ኡቁንያዋንቶ ኦሎፓ።<verse eid="PSA 119:121"/></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122"/>ታና ነ ቆማ ማዳናዉ ዋሰ ግዳ፤</para>
  <para style="q2" vid="PSA 119:122">ታና ኦቶራንቻቱዋን ኡቁንሶፓ።<verse eid="PSA 119:122"/></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123"/>ኔን፥ “ኔና አሻና”</para>
  <para style="q2" vid="PSA 119:123">ጌዳ ጽሎ ቃላ ፖሎ ጋደ ናግሽን፥</para>
  <para style="q2" vid="PSA 119:123">ታ አይፊ ጋልጄዳ።<verse eid="PSA 119:123"/></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124"/>ታዉ፥ ነ ቆማዉ፥ ኔን</para>
  <para style="q2" vid="PSA 119:124">አገና ነ ሲቁዋዳን ኦ፤</para>
  <para style="q2" vid="PSA 119:124">ነ አዋዩዋካ ታና ታማርሳ።<verse eid="PSA 119:124"/></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125"/>ታን ነ ቆማ፤</para>
  <para style="q2" vid="PSA 119:125">ኔን ኦድያባ ታን ኤራና ማላ፥</para>
  <para style="q2" vid="PSA 119:125">አኬካ ታዉ እማ።<verse eid="PSA 119:125"/></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126"/>አቤት መና ጎዳዉ፥ አሳቱ</para>
  <para style="q2" vid="PSA 119:126">ነ ህግያ መንዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 119:126">ኔን ፕርዳና ዎዲ ሀአ።<verse eid="PSA 119:126"/></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127"/>ታን ነ አዛዙዋ</para>
  <para style="q2" vid="PSA 119:127">ዎርቃፐ አደ ሲቃይ፤</para>
  <para style="q1" vid="PSA 119:127">ኤ፥ ጌሻ ዎርቃፐካ አደ ሲቃይ።<verse eid="PSA 119:127"/></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128"/>ሄዋ ድራዉ፥ ታን</para>
  <para style="q2" vid="PSA 119:128">ነ ዎጋቱ ኡባይ ግያዋዳን ሀመታይ፤</para>
  <para style="q2" vid="PSA 119:128">ጌላ ኦግያ ኡባ ታን እጻይ።<verse eid="PSA 119:128"/></para>
  <para style="qa">ፐ</para>
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129"/>ኔን ኦዴዳባይ ማላልስያባ፤</para>
  <para style="q2" vid="PSA 119:129">ሄዋ ድራዉ፥ ታን አዉ አዛዘታይ።<verse eid="PSA 119:129"/></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130"/>ነ ቃላ ብለይ ፖኡዋ እሜ፤</para>
  <para style="q2" vid="PSA 119:130">አኬካይ ፓጬዳዋንቶ አኬካ እሜ።<verse eid="PSA 119:130"/></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131"/>ታን ነ አዛዞ፥</para>
  <para style="q2" vid="PSA 119:131">ዳሮ ሳመታደ ታ ዶና ዶያይ።<verse eid="PSA 119:131"/></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132"/>ሃ ታኮ ስማ፤</para>
  <para style="q2" vid="PSA 119:132">ነ ሱን ሲቅያዋንቱ ኡባዉ</para>
  <para style="q2" vid="PSA 119:132">ኔን ኦያዋዳን ታዉካ ቃረታ።<verse eid="PSA 119:132"/></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133"/>ኔን ጌዳ ቃላዳን</para>
  <para style="q2" vid="PSA 119:133">ታ ሄመታ ሱርሳ፤</para>
  <para style="q2" vid="PSA 119:133">አይ ናጋራይነ ታና ሞዶፖ።<verse eid="PSA 119:133"/></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134"/>ታን ነ ዎጋዉ አዛዘታናዉ፥</para>
  <para style="q2" vid="PSA 119:134">ታና ኡቁኔዳዋንቱ ኩሽያፐ ዎዛ።<verse eid="PSA 119:134"/></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135"/>ታ ቦላ፥ ነ ቆማ ቦላ፥</para>
  <para style="q2" vid="PSA 119:135">ነ ሶምኡዋ ፖእሳ፤</para>
  <para style="q2" vid="PSA 119:135">ነ አዋዩዋካ ታማርሳ።<verse eid="PSA 119:135"/></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136"/>ነ ህግያዉ አሳይ አዛዘትቤና ድራዉ፥</para>
  <para style="q2" vid="PSA 119:136">ታ አይፍያፐ አፎይ ሻፋዳን ጎጌ።<verse eid="PSA 119:136"/></para>
  <para style="qa">ጻደ</para>
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137"/>አቤት መና ጎዳዉ፥ ኔን ጽሉዋ፤</para>
  <para style="q2" vid="PSA 119:137">ነ ፕርዳይካ ልከ።<verse eid="PSA 119:137"/></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138"/>ኔን ኦዴዳባይ</para>
  <para style="q2" vid="PSA 119:138">ጽሉዋነ ኡባ አማነትያዋ።<verse eid="PSA 119:138"/></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139"/>ታ ሞርከቱ ነ ቃላ ቶቼዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 119:139">ነ ቃላ ምሹ ታ ጎምፓን ኤጽ ከሴዳ።<verse eid="PSA 119:139"/></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140"/>ኔን ጌዳ ቃላይ ዳሮፐ አማነትያዋ፤</para>
  <para style="q2" vid="PSA 119:140">ታን፥ ነ ቆማይ አ ሲቃይ።<verse eid="PSA 119:140"/></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141"/>ታን ጉነ ካቴዳ አሳ፤</para>
  <para style="q2" vid="PSA 119:141">ግዶፐነ፥ ታን ነ ዎጋ ዶግከ።<verse eid="PSA 119:141"/></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142"/>ነ ጽሎተይ መናዉ ደኤ፤</para>
  <para style="q2" vid="PSA 119:142">ነ ህጊካ ቱማ።<verse eid="PSA 119:142"/></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143"/>መቱነ ቱጋይ ታና ጋኬዳ፤</para>
  <para style="q2" vid="PSA 119:143">ሽን ነ አዛዞቱ ታና ናሸቺኖ።<verse eid="PSA 119:143"/></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144"/>ኔን ኦዴዳባይ መናዉካ ጽሉዋ፤</para>
  <para style="q2" vid="PSA 119:144">ታን ፓጻ ደአና ማላ፥ አኬካ ታዉ እማ።<verse eid="PSA 119:144"/></para>
  <para style="qa">ቆፍ</para>
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145"/>አቤት መና ጎዳዉ፥ ኩመን ዎዛናፐ፥</para>
  <para style="q2" vid="PSA 119:145">ነዉ ዋሳድ፤ ታዉ አላ።</para>
  <para style="q1" vid="PSA 119:145">ታንካ ነ አዋዩዋ አዛዘታና።<verse eid="PSA 119:145"/></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146"/>ታን ነዉ ዋሳድ፤ ታና አሻ፤</para>
  <para style="q2" vid="PSA 119:146">ታንካ ኔን ኦዴዳባ ኦና።<verse eid="PSA 119:146"/></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147"/>ጻልቂ ዶለና ጉራን ደንዳደ፥</para>
  <para style="q2" vid="PSA 119:147">“ታና ማዳ” ጋደ ነዉ ዋሳይ።</para>
  <para style="q1" vid="PSA 119:147">ኔን ታዉ ጌዳ ቃላን ህዶታ ኦይ።<verse eid="PSA 119:147"/></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148"/>ነ ቃላባ ዛራ ዛራደ ቆፓናዉ፥</para>
  <para style="q2" vid="PSA 119:148">ቃማ ኡታ አቃይ።<verse eid="PSA 119:148"/></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149"/>አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 119:149">አገና ነ ሲቁዋ ድራዉ፥ ታዋ ስሳ፤</para>
  <para style="q2" vid="PSA 119:149">ነ ጽሎ ፕርዳዳን ታና ፓጻ ዎ።<verse eid="PSA 119:149"/></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150"/>ኢታባዉ ታና የደርስያዋንቱ፥</para>
  <para style="q2" vid="PSA 119:150">ታኮ ማቴድኖ፤</para>
  <para style="q2" vid="PSA 119:150">ኡንቱንቱ ነ ህግያፐ ሃኪኖ።<verse eid="PSA 119:150"/></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151"/>ሽን አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 119:151">ኔን ታ ማታን ደኣሳ፤</para>
  <para style="q2" vid="PSA 119:151">ነ አዛዞቱ ኡባይካ ቱማ።<verse eid="PSA 119:151"/></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152"/>ታን በንፐ ዶማደ፥</para>
  <para style="q2" vid="PSA 119:152">ኔን ኦዴዳባ ታማራድ፤</para>
  <para style="q1" vid="PSA 119:152">አ ኔን መናዉ ምንሳ ኤሳዳ።<verse eid="PSA 119:152"/></para>
  <para style="qa">ሬሽ</para>
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153"/>ታ ቱጋ በኣደ፥ ታና አሻ፤</para>
  <para style="q2" vid="PSA 119:153">አያዉ ጎፐ፥ ታን ነ ህግያ ዶጋበይከ።<verse eid="PSA 119:153"/></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154"/>ታ ድራዉ ሞተታደ ታና ዎዛ፤</para>
  <para style="q2" vid="PSA 119:154">ኔን ጌዳ ቃላዳን ታና ፓጻ ዎ።<verse eid="PSA 119:154"/></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155"/>ነ አዋዩዋ ኡንቱንቱ አከና ድራዉ፥</para>
  <para style="q2" vid="PSA 119:155">አቶተይ ኢታቱዋፐ ሃኩዋን ደኤ።<verse eid="PSA 119:155"/></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156"/>አቤት መና ጎዳዉ፥ ነ ቃረታይ ዳራ፤</para>
  <para style="q2" vid="PSA 119:156">ነ ጽሎ ፕርዳዳን ታና ፓጻ ዎ።<verse eid="PSA 119:156"/></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157"/>ታ ሞርከቱነ ታና የደርስያዋንቱ ዳራ፤</para>
  <para style="q2" vid="PSA 119:157">ሽን ታን ኔን ኦዴዳዋፐ ሸርእ ጊከ።<verse eid="PSA 119:157"/></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158"/>ኡንቱንቱ ነ አዛዞቱዋ ናገና ድራዉ፥</para>
  <para style="q2" vid="PSA 119:158">ታን ካድያዋንታ በኣደ ሸነታድ።<verse eid="PSA 119:158"/></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159"/>አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 119:159">ታን ነ ዎጋ ሲቅያ ሲቁዋ ቆፓ፤</para>
  <para style="q2" vid="PSA 119:159">አገና ነ ሲቁዋዳን ታና ፓጻ ዎ።<verse eid="PSA 119:159"/></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160"/>ነ ቃላይ ኮይሮፐካ ቱማ፤</para>
  <para style="q2" vid="PSA 119:160">ነ ጽሎ ፕርዳይ ኡባይካ መናዉ ደኤ።<verse eid="PSA 119:160"/></para>
  <para style="qa">ሺን</para>
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161"/>ካፓቱ ታና ጮ የደርሲኖ፤</para>
  <para style="q2" vid="PSA 119:161">ሽን ታ ዎዛናይ ነ ቃላዉ ያዬ።<verse eid="PSA 119:161"/></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162"/>ዳሮባ ኦሞዴዳ አሳይ ናሸትያዋዳን፥</para>
  <para style="q2" vid="PSA 119:162">ኔን ጌዳ ቃላን ታን ናሸታይ።<verse eid="PSA 119:162"/></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163"/>ታን ዎርዱዋ እጻይነ ሸነታይ፤</para>
  <para style="q2" vid="PSA 119:163">ሽን ነ ህግያ ሲቃይ።<verse eid="PSA 119:163"/></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164"/>ነ ጽሎ ፕርዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 119:164">ታን ኔና ጋላሳን ላፑ ገደ ጋላታይ።<verse eid="PSA 119:164"/></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165"/>ነ ህግያ ሲቅያዋንቶ</para>
  <para style="q2" vid="PSA 119:165">ኩመን ሳሮተይ ደኤ፤</para>
  <para style="q2" vid="PSA 119:165">ኡንቱንታ ኡባካ አያይነ ባናዉ ዳንዳየና።<verse eid="PSA 119:165"/></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166"/>አቤት መና ጎዳዉ፥ ታን</para>
  <para style="q2" vid="PSA 119:166">ነ አቶተ ሂዶታን ናጋይ፤</para>
  <para style="q2" vid="PSA 119:166">ነ አዛዞቱዋካ ኦይ።<verse eid="PSA 119:166"/></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167"/>ታን ኔን ኦዴዳባ ናጋይ፤</para>
  <para style="q2" vid="PSA 119:167">ታን ዳሮፐ አ ሲቃይ።<verse eid="PSA 119:167"/></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168"/>ታን ነ ዎጋዉነ</para>
  <para style="q2" vid="PSA 119:168">ኔን ኦዴዳዎ አዛዘታና፤</para>
  <para style="q2" vid="PSA 119:168">አያዉ ጎፐ፥ ታ ኦግያ ኡባ ኔን በኣሳ።<verse eid="PSA 119:168"/></para>
  <para style="qa">ታዉ</para>
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169"/>አቤት መና ጎዳዉ፥ ታ ዋሱ፥</para>
  <para style="q2" vid="PSA 119:169">ነ ስን ጋኮ፤</para>
  <para style="q2" vid="PSA 119:169">ኔን ጌዳ ቃላዳን ታዉ አኬካ እማ።<verse eid="PSA 119:169"/></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170"/>ታ ዋትዋቱ ነ ስን ጋኮ፤</para>
  <para style="q2" vid="PSA 119:170">ኔን ጌዳ ቃላዳን ታና አሻ።<verse eid="PSA 119:170"/></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171"/>ኔን ነ አዋዩዋ</para>
  <para style="q2" vid="PSA 119:171">ታና ታማርስያ ድራዉ፥</para>
  <para style="q2" vid="PSA 119:171">ታ ዶናፐ ጋላታይ ፑልታና።<verse eid="PSA 119:171"/></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172"/>ነ አዛዞቱ ኡባይ ጽሎ ግድያ ድራዉ፥</para>
  <para style="q2" vid="PSA 119:172">ታ እንጻርሳይ ነ ቃላባ የጻና።<verse eid="PSA 119:172"/></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173"/>ታን ነ ዎጋ ዶሬዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 119:173">ነ ኩሺ ታና ማዳናዉ ጊጌዳዋ ግዶ።<verse eid="PSA 119:173"/></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174"/>አቤት መና ጎዳዉ፥ ኔን</para>
  <para style="q2" vid="PSA 119:174">ታና አሻና ማላ ላሞታይ፤</para>
  <para style="q2" vid="PSA 119:174">ነ ህጊካ ታና ናሸቼ።<verse eid="PSA 119:174"/></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175"/>ታን ኔና ጋላታና ማላ፥</para>
  <para style="q2" vid="PSA 119:175">ታና ፓጻ ዎ፤</para>
  <para style="q2" vid="PSA 119:175">ነ ፕርዳይካ ታና ማዶ።<verse eid="PSA 119:175"/></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176"/>ታን ባዬዳ ዶርሳዳን ብቻራይ፤</para>
  <para style="q2" vid="PSA 119:176">ታና ነ ቆማ ኮያ፤</para>
  <para style="q2" vid="PSA 119:176">አያዉ ጎፐ፥ ታን ነ አዛዙዋ ዶጋበይከ።<verse eid="PSA 119:176"/></para>
  <chapter eid="PSA 119"/>
  <chapter number="120" style="c" sid="PSA 120"/>
  <para style="s1">ጭምያዋንቱፐነ ዎርዶቱዋፐ አታናዉ ሺቆ ዎሳ</para>
  <para style="d">ፑደ ከሲደ የጼዳ የ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1"/>ታ ዋይያ ዎደ ታን መና ጎዳ ጼሳድ፤</para>
  <para style="q2" vid="PSA 120:1">እ ታዉ ኮዬዳ።<verse eid="PSA 120:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2"/>አቤት መና ጎዳዉ፥ ዎርዶትያ ዶናቱዋፐነ፥</para>
  <para style="q2" vid="PSA 120:2">ጭምያ እንጻርሳቱዋፐ ታና አሻ።<verse eid="PSA 120:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3"/>ህንተኖ ዎርዳንቻቶ፥</para>
  <para style="q2" vid="PSA 120:3">ጾሳይ ህንተና ዋታንዴሻ?</para>
  <para style="q1" vid="PSA 120:3">ስም ሀራባ አያ ጉጃንዴሻ?<verse eid="PSA 120:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4"/>ቶራንቻቱዋ ፖ ቃራን እ ህንተና ጫዳናዋ፤</para>
  <para style="q2" vid="PSA 120:4">ታማ ቦንቁዋን እ ህንተና ጹጋና።<verse eid="PSA 120:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5"/>አየ ታኖ! ህንተናና ደእያዌ መሸካ</para>
  <para style="q2" vid="PSA 120:5">ዎይ ቄዳረ አሳና ደእያዋ ማላ ኢታ።<verse eid="PSA 120:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6"/>ሳሮተ እጽያ አሳቱዋና</para>
  <para style="q2" vid="PSA 120:6">ታን ዳሮ ዎድያ ደኣድ።<verse eid="PSA 120:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7"/>ታን ሳሮ አሳ፤</para>
  <para style="q2" vid="PSA 120:7">ሽን ታን ሳሮተባ ሃሳይያ ዎደ፥</para>
  <para style="q2" vid="PSA 120:7">ኡንቱንቱ ኦላዋ ሃሳዪኖ!<verse eid="PSA 120:7"/></para>
  <chapter eid="PSA 120"/>
  <chapter number="121" style="c" sid="PSA 121"/>
  <para style="s1">ጾሳይ ኑና ናግያዋ</para>
  <para style="d">ፑደ ከሲደ የጼዳ የ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1"/>ታን ቁ ጋደ ዎጋ ደረቱዋ ጼላይ፤</para>
  <para style="q2" vid="PSA 121:1">ታዉ ማዱ ሀቃፐ ያንዴሻ?<verse eid="PSA 121:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2"/>ታዉ ማዱ</para>
  <para style="q2" vid="PSA 121:2">ሳሉዋነ ሳኣ መዳ መና ጎዳፐ ዬ።<verse eid="PSA 121:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3"/>እ ነ ገድያ ሀልጽሰና፤</para>
  <para style="q2" vid="PSA 121:3">ኔና ናግያዌ ገምእሸና።<verse eid="PSA 121:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4"/>እስራኤልያ ናግያዌ፥</para>
  <para style="q2" vid="PSA 121:4">ኡባካ ግሰናነ ገምእሸና።<verse eid="PSA 121:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5"/>መና ጎዳይ ኔና ናግያዋ።</para>
  <para style="q2" vid="PSA 121:5">መና ጎዳይ ነዉ ኡሸቻ ባጋና ግዲደ፥</para>
  <para style="q2" vid="PSA 121:5">ኔና ኩዋይያዋ።<verse eid="PSA 121:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6"/>ጋላስ ኔና አዋይ ሜና፤</para>
  <para style="q2" vid="PSA 121:6">ቃማካ አግናይ ኔና ቆሄና።<verse eid="PSA 121:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7"/>መና ጎዳይ ቆህያዋ ኡባፐ ኔና ናጋና፤</para>
  <para style="q2" vid="PSA 121:7">እ ነ ሸምፑዋ ናጋና።<verse eid="PSA 121:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8"/>መና ጎዳይ ነ ቡሳ፥ ነ ዩሳ፥</para>
  <para style="q2" vid="PSA 121:8">ሀቼፐ መና ጋካናዉ ናጋና።<verse eid="PSA 121:8"/></para>
  <chapter eid="PSA 121"/>
  <chapter number="122" style="c" sid="PSA 122"/>
  <para style="s1">የሩሳላምዉ ሺቄዳ ሳባ</para>
  <para style="d">ፑደ ከሲደ የጼዳ የ፥ ዳውት ጻፌዳዋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1"/>ኡንቱንቱ ታና፥ “አነ መና ጎዳ ጎልያ ቦይተ” ያግና፥</para>
  <para style="q2" vid="PSA 122:1">ታን ናሸታድ።<verse eid="PSA 122:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2"/>ኔኖ የሩሳላመ ካታማቴ፥</para>
  <para style="q2" vid="PSA 122:2">ኑን ነ ፐንገቱዋና ገሊደ ኤቄዶ!<verse eid="PSA 122:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3"/>የሩሳላመ ካታማይ፥</para>
  <para style="q2" vid="PSA 122:3">ዳንቲደ ምን ኬጸቴዳ ካታማ።<verse eid="PSA 122:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4"/>መና ጎዳ አዋዩዋዳን፥</para>
  <para style="q2" vid="PSA 122:4">እስራኤልያ ዛራቱ፥</para>
  <para style="q1" vid="PSA 122:4">መና ጎዳ ጋላታናዉ ይያ ካታማይ ሀዋ።<verse eid="PSA 122:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5"/>ዳዊታ ዘረፐ ካተቴዳዋንቱ</para>
  <para style="q2" vid="PSA 122:5">ባረንቱ አሳዉ ፕርዳናዉ ያን ኡቴድኖ።<verse eid="PSA 122:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6"/>የሩሳላመ ሳሮተዉ</para>
  <para style="q2" vid="PSA 122:6">ሀዋዳን ያጊደ ዎስተ፤</para>
  <para style="q1" vid="PSA 122:6">“ኔና ሲቅያዋንቶ</para>
  <para style="q2" vid="PSA 122:6">ኡንቱንቱ ኦያዌ ኡባይ ሱሮ!<verse eid="PSA 122:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7"/>ነ ግምበቱዋ ግዶን ሳሩ ደኦ!</para>
  <para style="q2" vid="PSA 122:7">ነ ጌሳቱዋካ ቦችያባይ ዮ!” ያጊደ ዎስተ።<verse eid="PSA 122:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8"/>ታ እሻቱዋነ ታ ዳቦቱዋ ድራዉ ጋደ፥</para>
  <para style="q2" vid="PSA 122:8">“ነ ግዶን ሳሩ ደኦ!” ያጋይ።<verse eid="PSA 122:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9"/>መና ጎዳ ኑ ጾሳ ጎልያ ድራዉ ጋደ፥</para>
  <para style="q2" vid="PSA 122:9">ታን የሩሳላመ ዱረታናዉ ዎሳና።<verse eid="PSA 122:9"/></para>
  <chapter eid="PSA 122"/>
  <chapter number="123" style="c" sid="PSA 123"/>
  <para style="s1">ማሮታ ደማናዉ ሺሾ ዎሳ</para>
  <para style="d">ፑደ ከሲደ የጼዳ የ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1"/>ኔኖ፥ ካዉተ አራታን ሳሉዋን ኡቴዳዎ፥</para>
  <para style="q2" vid="PSA 123:1">ታን ፑደ ኔኮ ጼላይ።<verse eid="PSA 123:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2"/>ቆማይ ባረ ጎዳ ኩሽያ ጼልያዋዳንነ</para>
  <para style="q2" vid="PSA 123:2">ቆማታ ባረ ጎዳት ኩሽያ ጼልያዋዳን፥</para>
  <para style="q2" vid="PSA 123:2">ሄዋዳንካ እ ኑና ማራና ጋካናዉ፥</para>
  <para style="q2" vid="PSA 123:2">ኑ አይፊ መና ጎዳኮ፥ ኑ ጾሳኮ፥ ጼሌ።<verse eid="PSA 123:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3"/>ኑና ማራ፤ አቤት መና ጎዳዉ፥ ኑና ማራ።</para>
  <para style="q2" vid="PSA 123:3">አያዉ ጎፐ፥ ኑዉ ካ ዳሬዳ።<verse eid="PSA 123:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4"/>ኑን እሻሉዋን ደእያዋንቱ ሸቃነ</para>
  <para style="q2" vid="PSA 123:4">ኦቶራንቻቱዋ ካያ ካሌዶ።<verse eid="PSA 123:4"/></para>
  <chapter eid="PSA 123"/>
  <chapter number="124" style="c" sid="PSA 124"/>
  <para style="s1">ጾሳይ እስራኤልያ አሽያዋ</para>
  <para style="d">ፑደ ከሲደ የጼዳ የ፥ ዳውት ጻፌዳዋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1"/>መና ጎዳይ ኑ ባጋ ግደነንቶ፥ ኑን ዋናኔሻ?</para>
  <para style="q2" vid="PSA 124:1">እስራኤልያ አሳቱ ዛሩዋ ሀዋዳን ያጊደ ዛሪኖ፤<verse eid="PSA 124:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2"/>“መና ጎዳይ ኑ ባጋ ግደነንቶ፥</para>
  <para style="q2" vid="PSA 124:2">ኑ ቦላን አሳይ ደንዴዳ ዎደ፥<verse eid="PSA 124:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 124:3"/>ኡንቱንቱ ኑ ቦላን ሀንቁዋ ሱሊደ፥</para>
  <para style="q2" vid="PSA 124:3">ኑና ፓጻ ምታና ሽን።<verse eid="PSA 124:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4"/>ድኡ ኑና ሜጪደ፤</para>
  <para style="q2" vid="PSA 124:4">ሻፋ ሃይ ኑና ሙካና ሽን፤<verse eid="PSA 124:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5"/>ኩን ሃይ ኑና ማና ሽን” ያግኖ።<verse eid="PSA 124:5"/></para>
  <para style="b"/>
  <para style="q2">
    <verse number="6" style="v" sid="PSA 124:6"/>ኑና ኑ ሞርከቱዋ ማታን፥</para>
  <para style="q2" vid="PSA 124:6">ጾንስቤና መና ጎዳይ ጋላተቶ።<verse eid="PSA 124:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7"/>ኑን ሻንካንቻቱዋ ጲርያፐ፥</para>
  <para style="q2" vid="PSA 124:7">ካፉ ከስ አክያዋዳን ከስ አኬዶ።</para>
  <para style="q1" vid="PSA 124:7">ጵሪ መኤዳ፥ ኑንካ ከስ አክ አቴዶ!<verse eid="PSA 124:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8"/>ኑ ማዱ</para>
  <para style="q2" vid="PSA 124:8">ሳሉዋነ ሳኣ መዳ መና ጎዳ ሱንፐ ዬ።<verse eid="PSA 124:8"/></para>
  <chapter eid="PSA 124"/>
  <chapter number="125" style="c" sid="PSA 125"/>
  <para style="s1">ጾሳይ ባረ አሳዉ ዋሰ</para>
  <para style="d">ፑደ ከሲደ የጼዳ የ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1"/>መና ጎዳን አማነትያዋንቱ ቃጻናዉ ዳንዳየና፥</para>
  <para style="q2" vid="PSA 125:1">መናዉ ደእያ ጽዮነ ደርያ ማላ።<verse eid="PSA 125:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2"/>ደረቱ</para>
  <para style="q2" vid="PSA 125:2">የሩሳላመ ካታማ ዩሹዋን ደእያዋዳን፥</para>
  <para style="q2" vid="PSA 125:2">ሀቼፐ መና ጋካናዉ፥</para>
  <para style="q2" vid="PSA 125:2">መና ጎዳይ ባረ አሳ ዩሹዋን ደኤ።<verse eid="PSA 125:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3"/>ጽሎቱ ባረንቱ ኩሽያ ኢታተዉ ደንና ማላ፥</para>
  <para style="q2" vid="PSA 125:3">ኢታቱዋ አይሱዋ ጻምአይ፥</para>
  <para style="q2" vid="PSA 125:3">ጽሎቶ እመቴዳ ቢታ ቦላን ጋምኤና።<verse eid="PSA 125:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4"/>አቤት መና ጎዳዉ፥ ኬካ አሳቶነ፥</para>
  <para style="q2" vid="PSA 125:4">ዎዛና ሱረ አሳቶ ኬካባ ኦ።<verse eid="PSA 125:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5"/>ባረንቱ ጌላ ኦግያ ስምያዋንታ፥</para>
  <para style="q2" vid="PSA 125:5">መና ጎዳይ ኢታ ኦያዋንቱና እትፐ ሙራ።</para>
  <para style="q1" vid="PSA 125:5">እስራኤልያዉ ሳሩ ግዶ!<verse eid="PSA 125:5"/></para>
  <chapter eid="PSA 125"/>
  <chapter number="126" style="c" sid="PSA 126"/>
  <para style="s1">ኦሞዱዋፐ ስሜዳዋንቱ ማዝሙርያ</para>
  <para style="d">ፑደ ከሲደ የጼዳ የ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1"/>መና ጎዳይ ኑና ኦሞደቴዳዋንታ ዛሪደ፥</para>
  <para style="q2" vid="PSA 126:1">ጽዮነ አሄዳ ዎደ፥ ኑዉ አኩሙዋ ማላቴዳ።<verse eid="PSA 126:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2"/>ሄ ዎደ ኑን ዳሮ ናሸት፥ ሚጪደ፥</para>
  <para style="q2" vid="PSA 126:2">ናሸቻ የ የጼዶ።</para>
  <para style="q1" vid="PSA 126:2">ያትና፥ ሀራ ካዉተቱ ባረንቱ ግዶን፥</para>
  <para style="q2" vid="PSA 126:2">“ሀዋንቶ መና ጎዳይ ዎልቃማባ ኦዳ” ያጌድኖ።<verse eid="PSA 126:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3"/>ቱሙካ መና ጎዳይ ኑዉ ዎልቃማባ ኦዳ፤</para>
  <para style="q2" vid="PSA 126:3">ኑንካ ሎይ ናሸቴዶ።<verse eid="PSA 126:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4"/>አቤት መና ጎዳዉ፥ ኔጌባ ባዙዋን እራ ቡክሳደ፥</para>
  <para style="q2" vid="PSA 126:4">ሻፋ ሃ ዛራ ኩንያዋዳን፥</para>
  <para style="q2" vid="PSA 126:4">ኑዉካ ኑ ካጫ ኦራ።<verse eid="PSA 126:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5"/>ዬኪደ ዘሬዳዋንቱ፥</para>
  <para style="q2" vid="PSA 126:5">ናሸቻን የጺደ ጫካና።<verse eid="PSA 126:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6"/>ዘረ ቶኪደ፥ ዬኪደ ቤዳዋንቱ፥</para>
  <para style="q2" vid="PSA 126:6">ናሸቻ የ የጺደ፥</para>
  <para style="q2" vid="PSA 126:6">ምርቂያ ቶኪደ ስማና።<verse eid="PSA 126:6"/></para>
  <chapter eid="PSA 126"/>
  <chapter number="127" style="c" sid="PSA 127"/>
  <para style="s1">ጾሳን አማነታናዳን እመቴዳ ዞርያ</para>
  <para style="d">ፑደ ከሲደ የጼዳ የ፥ ሶሎሞን ጻፌዳዋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1"/>መና ጎዳይ ጎልያ ኬጻና ዮፐ፥</para>
  <para style="q2" vid="PSA 127:1">ኬጽያዋንቱ ጮ መላ ዳቡሪኖ።</para>
  <para style="q1" vid="PSA 127:1">መና ጎዳይ ካታማ ናጋና ዮፐ፥</para>
  <para style="q2" vid="PSA 127:1">ናግያዋንቱ ጮ መላ ናጊኖ።<verse eid="PSA 127:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2"/>ኔን ዎንታ ጉራን ደንድያዌ፥</para>
  <para style="q2" vid="PSA 127:2">ኦማርስ ቃምሳደ ግስያዌ፥</para>
  <para style="q2" vid="PSA 127:2">ቁማዉ ህርጋደ ቱጋትያዌ ጮ መላ፤</para>
  <para style="q2" vid="PSA 127:2">አያዉ ጎፐ፥ ጾሳይ ባረ ሲቅያዋንቶ ሸምፑዋ እሜ።<verse eid="PSA 127:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3"/>ናናይ መና ጎዳፐ እመትያ እሞታ፤</para>
  <para style="q2" vid="PSA 127:3">የሎቱ ቱሙዋፐ ዎይቱዋ።<verse eid="PSA 127:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4"/>እት ኡራይ ባረ ያላጋተን የሌዳ አቱማ ናናቱ፥</para>
  <para style="q2" vid="PSA 127:4">ኦላንቻ ኩሽያን ደእያ ቶራቱዋ ማላ።<verse eid="PSA 127:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5"/>ሄ ቃርጪታን ደእያ ዎንዳፍያ ቶራቱዋዳን፥</para>
  <para style="q2" vid="PSA 127:5">ዳሮ ናናቱ ደእያ አሳይ አንጀቴዳዋ።</para>
  <para style="q1" vid="PSA 127:5">አያዉ ጎፐ፥ እ ባረ ሞርከቱዋና፥</para>
  <para style="q2" vid="PSA 127:5">ካታማ ፐንግያን ሞተትያ ዎደ፥ ኡባካ ጾነተና።<verse eid="PSA 127:5"/></para>
  <chapter eid="PSA 127"/>
  <chapter number="128" style="c" sid="PSA 128"/>
  <para style="s1">ጾሳዉ አዛዘቱሳን ቤትያ አንጁዋ</para>
  <para style="d">ፑደ ከሲደ የጼዳ የ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1"/>መና ጎዳዉ ያይያዋንቱነ፥</para>
  <para style="q2" vid="PSA 128:1">አ ኦግያን ሀመትያዋንቱ ኡባይ አንጀቴዳዋንታ።<verse eid="PSA 128:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2"/>ኔን ነ ዳቡራ አይፍያ ማና፤</para>
  <para style="q2" vid="PSA 128:2">ኔን ናሸታናነ ነዉ ሎኦ ግዳና።<verse eid="PSA 128:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3"/>ነ ማቻታ ነ ሶን አይፍያ ዶርኮኬዳ፥</para>
  <para style="q2" vid="PSA 128:3">ዎይንያ ቱራ ማላ ግዳና።</para>
  <para style="q1" vid="PSA 128:3">ነ ናናቱካ ነ ጋይታ ዩሹዋን፥</para>
  <para style="q2" vid="PSA 128:3">ዎጋራ ፑትያ ማላ ግዳና።<verse eid="PSA 128:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4"/>መና ጎዳዉ ያይያ አሳይ</para>
  <para style="q2" vid="PSA 128:4">ቱሙዋፐ ሄዋዳን አንጀታና።<verse eid="PSA 128:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5"/>መና ጎዳይ ኔና ጽዮነፐ አንጆ!</para>
  <para style="q2" vid="PSA 128:5">ኔን ደኤዳ ላይ ኡባን</para>
  <para style="q1" vid="PSA 128:5">የሩሳላመ ሎኦተ ኔና በሶ።<verse eid="PSA 128:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6"/>ነ ናናቱዋ ናናቱዋ በአ!</para>
  <para style="b" vid="PSA 128:6"/>
  <para style="q2" vid="PSA 128:6">እስራኤልያዉ ሳሩ ግዶ!<verse eid="PSA 128:6"/></para>
  <chapter eid="PSA 128"/>
  <chapter number="129" style="c" sid="PSA 129"/>
  <para style="s1">እስራኤሊ ሞርክያፐ አታናዉ ሺሾ ዎሳ</para>
  <para style="d">ፑደ ከሲደ የጼዳ የ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1"/>እስራኤልያ አሳይ ሀዋዳን ያጎ፤</para>
  <para style="q2" vid="PSA 129:1">“ኡንቱንቱ ታ ያላጋተደፐ ዶሚደ፥</para>
  <para style="q3" vid="PSA 129:1">ታና ኡቅኔድኖ።<verse eid="PSA 129:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2"/>ኤ፥ ኡንቱንቱ ታ ያላጋተደፐ ዶሚደ፥</para>
  <para style="q2" vid="PSA 129:2">ታና ኡቅኔድኖ፤</para>
  <para style="q2" vid="PSA 129:2">ሽን ኡንቱንቱ ታና ይስበይክኖ።<verse eid="PSA 129:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3"/>ታ ዞክያ ቃይጼርያን ሾጭ ሾጪደ፥</para>
  <para style="q2" vid="PSA 129:3">ጎሼዳ ሾይቃ ማላትሴድኖ” ያጎ።<verse eid="PSA 129:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4"/>ሽን መና ጎዳይ ጽሎ ግዴዳዌ</para>
  <para style="q2" vid="PSA 129:4">ኢታቱዋ ቃሹዋፐ ታና ብል የዴዳ።<verse eid="PSA 129:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5"/>ጽዮነ እጽያ ኡባይ፥</para>
  <para style="q2" vid="PSA 129:5">ዬላቲደ ጉየ ስሞ።<verse eid="PSA 129:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6"/>ጎልያ ሁጲያን ሞኪደ፥</para>
  <para style="q2" vid="PSA 129:6">ድጫናፐ ካሰቲደ መልያ ማታ ማላ ግዶ።<verse eid="PSA 129:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7"/>ሄ ማታ ቡጫናዉ ኩሽያን ዳንክያዌ፥</para>
  <para style="q2" vid="PSA 129:7">ዎይ ምርቂያ ቃችያዌ ኦንነ ባዋ።<verse eid="PSA 129:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8"/>ሄ ኦግያና አያዋንቱ፥</para>
  <para style="q2" vid="PSA 129:8">“መና ጎዳይ ዎልቃ እሞ” ጊና፥ ጫክያዋንቱ፥</para>
  <para style="q1" vid="PSA 129:8">“መና ጎዳይ አንጆ” ግያዌ ደኤና።<verse eid="PSA 129:8"/></para>
  <chapter eid="PSA 129"/>
  <chapter number="130" style="c" sid="PSA 130"/>
  <para style="s1">ማዱዋ ደማናዉ ሺቄዳ ዎሳ</para>
  <para style="d">ፑደ ከሲደ የጼዳ የ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1"/>አቤት መና ጎዳዉ፥ ታን መቱዋ ጪማን ደኣደ፥</para>
  <para style="q2" vid="PSA 130:1">ኔኮ ዋሳይ።<verse eid="PSA 130:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 130:2"/>አቤት ጎዳዉ፥ ታ ኮሻ ስሳ፤</para>
  <para style="q2" vid="PSA 130:2">ታን ዋትዋትያ ዋትዋቱዋ ነ ሀይይ ሀይዞ።<verse eid="PSA 130:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3"/>አቤት መና ጎዳዉ፥ ኔን፥</para>
  <para style="q2" vid="PSA 130:3">ኑ ናጋራ ማዝጎብያን ጻፌደንቶ፥</para>
  <para style="q2" vid="PSA 130:3">አቤት ጎዳዉ፥ ዎን ኦን ፕርዳፐ አታናዉ ዳንዳዪ?<verse eid="PSA 130:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4"/>ሽን ኑን ኔና ቦንቺደ አዛዘታና ማላ፥</para>
  <para style="q2" vid="PSA 130:4">ኑዉ አቶ ያጋሳ።<verse eid="PSA 130:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5"/>ታን መና ጎዳ ናጋይ፤</para>
  <para style="q2" vid="PSA 130:5">ኤ፥ ታን አ ላሞታን ናጋይ፤</para>
  <para style="q1" vid="PSA 130:5">አ ቃላንካ ህዶታ ኦይ።<verse eid="PSA 130:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6"/>ሳአይ አዉደ ዎንታንዴሻ</para>
  <para style="q2" vid="PSA 130:6">ጊደ ናግያ ቃማ ዛባይንያቱዋፐ አአደ፥</para>
  <para style="q2" vid="PSA 130:6">ታን ኡንቱንቱፐካ አደ፥</para>
  <para style="q2" vid="PSA 130:6">ጎዳ ላሞታን ናጋይ።<verse eid="PSA 130:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7"/>እስራኤልያ አሳዉ፥ መና ጎዳን ህዶታ ኦተ፤</para>
  <para style="q2" vid="PSA 130:7">አያዉ ጎፐ፥ አገና ሲቁ መና ጎዳና፤</para>
  <para style="q2" vid="PSA 130:7">ቃይ እ ኡባ ገደ አሳ አሻናዉ ኮዬ።<verse eid="PSA 130:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8"/>እስራኤልያ አሳ</para>
  <para style="q2" vid="PSA 130:8">ኡንቱንቱ ናጋራ ኡባፐ አሻናዌ አ።<note caller="-" style="x"><char style="xo" closed="false">130:8 </char><char style="xt" closed="false"><ref loc="MAT 1:21">ማቶሳ 1:21</ref>፤ <ref loc="TIT 2:14">ቲቶ 2:14</ref></char></note><verse eid="PSA 130:8"/></para>
  <chapter eid="PSA 130"/>
  <chapter number="131" style="c" sid="PSA 131"/>
  <para style="s1">ጾሳን አማነቱሳ</para>
  <para style="d">ፑደ ከሲደ የጼዳ የ፥ ዳውት ጻፌዳዋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1"/>አቤት መና ጎዳዉ፥ ታን ዎዛናን አይያዋ አጋድ፤</para>
  <para style="q2" vid="PSA 131:1">ታ አይፍያን ኦቶሩዋን ጼላበይከ።</para>
  <para style="q1" vid="PSA 131:1">ዎልቃማባዉ ዎይ ኤራናዉ ዳንዳየና</para>
  <para style="q2" vid="PSA 131:1">ማላልስያባዉ ታን ህርግከ።<verse eid="PSA 131:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2"/>ሄዋ አጋደ ን ዱጼዳ ናአይ</para>
  <para style="q2" vid="PSA 131:2">ባረ አት ማታን ጮኡ ግያዋዳን፥</para>
  <para style="q2" vid="PSA 131:2">ታን ጮኡ ጋድ።</para>
  <para style="q2" vid="PSA 131:2">ኤ፥ ዎፑ ጌዳ ናኣዳን ታን ዎፑ ጋድ።<verse eid="PSA 131:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3"/>እስራኤልያ አሳዉ፥ ሀቼፐ</para>
  <para style="q2" vid="PSA 131:3">መና ጋካናዉ መና ጎዳን ህዶታ ኦተ።<verse eid="PSA 131:3"/></para>
  <chapter eid="PSA 131"/>
  <chapter number="132" style="c" sid="PSA 132"/>
  <para style="s1">ጌሻ ጎልያ ሳባናዉ ሺቆ ማዝሙርያ</para>
  <para style="d">ፑደ ከሲደ የጼዳ የ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1"/>አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 132:1">ዳዊታነ እ ዳንዳዬዳ መቱዋ ቆፓ።<verse eid="PSA 132:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2"/>መና ጎዳዉ እ ጫቄዳዋ፥</para>
  <para style="q2" vid="PSA 132:2">ያቆባ ጾሳዉ፥ ዎልቃማዉ</para>
  <para style="q1" vid="PSA 132:2">እ ሀዋዳን ያጊደ ገፔዳዋ ሀሳያ፤<verse eid="PSA 132:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3"/>“ሀዋፐ ጉይያን ታን ታ ጎለ ገልከ፥</para>
  <para style="q2" vid="PSA 132:3">ዎይ ታ ሂጻን ግስከ።<verse eid="PSA 132:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 132:4"/>ታን ታ አይፍያ ጪልምከ፥</para>
  <para style="q2" vid="PSA 132:4">ዎይ ገምእሽከ።<verse eid="PSA 132:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 132:5"/>ሄዌነ፥ ታን መና ጎዳዉ ሳኣ፥</para>
  <para style="q2" vid="PSA 132:5">ያቆባ ጾሳዉ፥ ዎልቃማዉ</para>
  <para style="q2" vid="PSA 132:5">ደኢያሳ ጊግሳና ጋካናሳ” ያጌዳ።<verse eid="PSA 132:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6"/>ሄኮ፥ ኑን ታቦታባ፥</para>
  <para style="q2" vid="PSA 132:6">ቤተሌመን ስሴዶ፤<note caller="-" style="x"><char style="xo" closed="false">132:6-10 </char><char style="xt" closed="false"><ref loc="2CH 6:41-42">2 ኦዱዋ 6:41-42</ref></char></note></para>
  <para style="q1" vid="PSA 132:6">ይኣሪማ ግያ ቢታን አ ኑን ደሜዶ።<verse eid="PSA 132:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7"/>ኑን፥ “አነ እ ደኢያሳ ቦይተ፤</para>
  <para style="q2" vid="PSA 132:7">አ ገዲ የያሳን ጉፋኒደ፥</para>
  <para style="q2" vid="PSA 132:7">አዉ ጎይኔቶ” ያጌዶ።<verse eid="PSA 132:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8"/>አቤት መና ጎዳዉ፥ ደንዳ!</para>
  <para style="q2" vid="PSA 132:8">ነ ምኖተዉ ማላ ግድያ ነ ታቦታና፥</para>
  <para style="q2" vid="PSA 132:8">ነ ጌሻ ጎልያ ገላደ ደአ።<verse eid="PSA 132:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9"/>ነ ቄሳቱ ጽሎተ ማይኖ፤</para>
  <para style="q2" vid="PSA 132:9">ነ አሳቱ ናሸቻዉ የጽኖ።<verse eid="PSA 132:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10"/>ነ ቆማ ዳዊታ ድራዉ፥</para>
  <para style="q2" vid="PSA 132:10">ኔን ኦኬዳ ካትያ አጎፓ።<verse eid="PSA 132:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11"/>መና ጎዳይ ዳዊታዉ ላመተና ጫቁዋ</para>
  <para style="q2" vid="PSA 132:11">ሀዋዳን ያጊደ ጫቄዳ፤<note caller="-" style="x"><char style="xo" closed="false">132:11 </char><char style="xt" closed="false"><ref loc="2SA 7:12-16">2 ሳሜላ 7:12-16</ref>፤ <ref loc="1CH 17:11-14">1 ኦዱዋ 17:11-14</ref>፤ <ref loc="PSA 89:3-4">ማዝ. 89:3-4</ref>፤ <ref loc="ACT 2:30">ኪታ 2:30</ref></char></note></para>
  <para style="q1" vid="PSA 132:11">“ነ ጉልባታፐ የለቴዳ ነ ናናቱዋፐ እቱዋ</para>
  <para style="q2" vid="PSA 132:11">ታን ካዉና።<verse eid="PSA 132:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12"/>ነ ናናቱ ታ ጫቁዋነ</para>
  <para style="q2" vid="PSA 132:12">ታን ታማርስያ ትምርትያ ናጎፐ፥</para>
  <para style="q2" vid="PSA 132:12">ኡንቱንቱ ናናቱካ ነ ካዉተ አራታን መናዉ ኡታና” ያጌዳ።<verse eid="PSA 132:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13"/>መና ጎዳይ ጽዮነ ዶሬዳ፤</para>
  <para style="q2" vid="PSA 132:13">ባረዉ ደኢያሳ ኦናዉካ አሞቲደ፥</para>
  <para style="q2" vid="PSA 132:13">ሀዋዳን ያጌዳ፤<verse eid="PSA 132:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14"/>“ሀዌ ታዉ መናዉ ደእያ ሳኣ፤</para>
  <para style="q2" vid="PSA 132:14">ታን አሞቴዳ ድራዉ፥ ሀዋን ኡታና።<verse eid="PSA 132:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15"/>ታን ዳሮ ካ እማደ ጽዮኖ አንጃና፤</para>
  <para style="q2" vid="PSA 132:15">እዝን ደእያ ህዬሳቱዋካ ቁማ ካልሳና።<verse eid="PSA 132:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16"/>እዝን ደእያ ቄሳቱ ዋካ</para>
  <para style="q2" vid="PSA 132:16">ታን አቶተ ማይዛና፤</para>
  <para style="q2" vid="PSA 132:16">እዝን ጾሳ አሳቱካ ናሸቻዉ የጻና።<verse eid="PSA 132:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17"/>“ሀ ሳኣን፥</para>
  <para style="q2" vid="PSA 132:17">ዳዊታ ዘረፐ እቱዋ ካዉና፤<note caller="-" style="x"><char style="xo" closed="false">132:17 </char><char style="xt" closed="false"><ref loc="1KI 11:36">1 ካታ. 11:36</ref></char></note></para>
  <para style="q2" vid="PSA 132:17">ታን ኦኬዳ ካትያ ካዉተ ጋምኤና።<verse eid="PSA 132:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18"/>ታን አ ሞርከቱዋ ዬላ ማይዛና፤</para>
  <para style="q2" vid="PSA 132:18">ሽን አ ሁጲያን ደእያ ካዉተ ካላቻይ ጶላና” ያጌዳ።<verse eid="PSA 132:18"/></para>
  <chapter eid="PSA 132"/>
  <chapter number="133" style="c" sid="PSA 133"/>
  <para style="s1">እሻቱዋ ሲቆ ሺቄዳ ሳባ</para>
  <para style="d">ፑደ ከሲደ የጼዳ የ፥ ዳውት ጻፌዳዋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1"/>እሻቱ እትፐተን ደእያዌ አይባ ሎኦቤነ ናሸችያቤ!<verse eid="PSA 133:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2"/>ሄዌ ሁጲያ ኦክና፥ ቡቻና ጎግያ፥</para>
  <para style="q2" vid="PSA 133:2">አሮና ቡቻና ጎጊደ</para>
  <para style="q1" vid="PSA 133:2">አ ማዩዋ ሞርግያ ጋክያ አልኦ ዛይትያ ማላ።<verse eid="PSA 133:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3"/>ሄዌ ሄርሞነ ደርያ ከተርሳይ፥</para>
  <para style="q2" vid="PSA 133:3">ጽዮነ ደረቱዋ ጋክያዋ ማላ።</para>
  <para style="q1" vid="PSA 133:3">መና ጎዳይ ሄዋን አንጁዋ፥ መና ደኡዋ እሜዳ።<verse eid="PSA 133:3"/></para>
  <chapter eid="PSA 133"/>
  <chapter number="134" style="c" sid="PSA 134"/>
  <para style="s1">ጾሳ ጋላቱሳ</para>
  <para style="d">ፑደ ከሲደ የጼዳ የ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1"/>ህንተኖ መና ጎዳ ቆማቶ፥</para>
  <para style="q2" vid="PSA 134:1">መና ጎዳ ጎልያን ቃማ ኦያዋንቶ፥</para>
  <para style="q3" vid="PSA 134:1">ኡባይካ ሃ ዪደ፥ መና ጎዳ ጋላትተ።<verse eid="PSA 134:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2"/>ጌሻ ጎልያን ህንተ ኩሽያ ምጪደ፥</para>
  <para style="q2" vid="PSA 134:2">መና ጎዳ ጋላትተ።<verse eid="PSA 134:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3"/>ሳሉዋነ ሳኣ መዳ መና ጎዳይ፥</para>
  <para style="q2" vid="PSA 134:3">ህንተና ጽዮነፐ አንጆ።<verse eid="PSA 134:3"/></para>
  <chapter eid="PSA 134"/>
  <chapter number="135" style="c" sid="PSA 135"/>
  <para style="s1">ጋላታ ማዝሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1"/>መና ጎዳ ጋላትተ!</para>
  <para style="b" vid="PSA 135:1"/>
  <para style="q1" vid="PSA 135:1">ህንተኖ መና ጎዳ ቆማቶ፥</para>
  <para style="q2" vid="PSA 135:1">መና ጎዳ ሱን ጋላትተ!<verse eid="PSA 135:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2"/>ህንተኖ መና ጎዳ ጎልያ ግዶን፥</para>
  <para style="q2" vid="PSA 135:2">ኑ ጾሳ ጎልያ ዳባባን ኤቄዳዋንቶ፥</para>
  <para style="q1" vid="PSA 135:2">ጾሳ ጋላትተ!<verse eid="PSA 135:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3"/>መና ጎዳይ ኬካ ግድያ ድራዉ፥</para>
  <para style="q2" vid="PSA 135:3">መና ጎዳ ጋላትተ!</para>
  <para style="q1" vid="PSA 135:3">እ ሎአ ግድያ ድራዉ፥</para>
  <para style="q2" vid="PSA 135:3">አ ሱን ሳቢተ!<verse eid="PSA 135:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4"/>መና ጎዳይ ያቆባ ባረ ሁጰው፥</para>
  <para style="q2" vid="PSA 135:4">እስራኤልያ አሳካ ባረዉ ቡዞ ኦደ ዶሬዳ።<verse eid="PSA 135:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5"/>መና ጎዳይ ዎልቃማ ግድያዋነ</para>
  <para style="q2" vid="PSA 135:5">ኑ ጎዳይ ጾሳቱዋ ኡባፐ ቂያዋ፥</para>
  <para style="q2" vid="PSA 135:5">ታን ኤራይ።<verse eid="PSA 135:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6"/>ሳሉዋንካ ሳንካ፥</para>
  <para style="q2" vid="PSA 135:6">አባቱዋንነ ኡንቱንቱ ጪሞቱዋ ኡባ ግዶንካ፥</para>
  <para style="q1" vid="PSA 135:6">መና ጎዳይ ባረ ዶሴዳዋ ኡባ ኦ።<verse eid="PSA 135:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7"/>እራ ቶኮ ሻርያ ሳኣ ጋጻፐ እ ደን፤</para>
  <para style="q2" vid="PSA 135:7">እ እራና ዋልቃን ኪቴ፤</para>
  <para style="q2" vid="PSA 135:7">ባረ ምንጅያ ሳኣፐ ጫርኩዋ ከሴ።<verse eid="PSA 135:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8"/>ግብጼ ቢታን አሳ ናናቱዋፐነ፥</para>
  <para style="q2" vid="PSA 135:8">መህያ ማራፐ፥</para>
  <para style="q2" vid="PSA 135:8">ባይራ የለቴዳዋንታ ዎዳ።<verse eid="PSA 135:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9"/>ኔኖ ግብጼ፥ ፓርኦናነ አ ቆማቱዋ ሙራናዉ፥</para>
  <para style="q2" vid="PSA 135:9">ህንተንቱ ግዶን ኦራባነ ማላልስያባ የዴዳ።<verse eid="PSA 135:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10"/>እ ዳሮ ካዉተቱዋ ባይዜዳ፤</para>
  <para style="q2" vid="PSA 135:10">ዎልቃማ ካተቱዋካ ዎዳ።<verse eid="PSA 135:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11"/>አሞረቱዋ ካትያ ስሆና፥</para>
  <para style="q2" vid="PSA 135:11">ባሳነ ካትያ ኦጋነ፥</para>
  <para style="q2" vid="PSA 135:11">ካናነ ካተቱዋ ኡባ ዎዳ።<verse eid="PSA 135:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12"/>ኡንቱንቱ ቢታ ባረ አሳቱዋ፥</para>
  <para style="q2" vid="PSA 135:12">እስራኤላቱዋ ላትሴዳ።<verse eid="PSA 135:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13"/>አቤት መና ጎዳዉ፥ ነ ሱንይ መናዉ ደአና፤</para>
  <para style="q2" vid="PSA 135:13">የለታፐ የለታ ጋካናዉ መና ጎዳይ ሀሳየታና።<verse eid="PSA 135:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14"/>መና ጎዳይ ባረ አሳዉ ፕርዳና፤</para>
  <para style="q2" vid="PSA 135:14">እ ባረ ቆማቶ ቃረታና።<verse eid="PSA 135:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15"/>ጋድያ አሳቱዋ ኤቃቱ አሳ ኩሺ</para>
  <para style="q2" vid="PSA 135:15">ብራፐነ ዎርቃፐ መዳዋንታ።<note caller="-" style="x"><char style="xo" closed="false">135:15-18 </char><char style="xt" closed="false"><ref loc="PSA 115:4-8">ማዝ. 115:4-8</ref>፤ <ref loc="REV 9:20">ሳፃ 9:20</ref></char></note><verse eid="PSA 135:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16"/>ኡንቱንቶ ዶናይ ደኤ፥ ሽን ሃሳይክኖ፤</para>
  <para style="q2" vid="PSA 135:16">አይፊ ደኤ፥ ሽን ጼልክኖ።<verse eid="PSA 135:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17"/>ሀይይ ደኤ፥ ሽን ስስክኖ፤</para>
  <para style="q2" vid="PSA 135:17">ኡንቱንቱ ዶናን ሸምፑ ባዋ።<verse eid="PSA 135:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18"/>ኡንቱንታ መዳዋንቱነ፥</para>
  <para style="q2" vid="PSA 135:18">ኡንቱንቱን አማነትያዋንቱ፥</para>
  <para style="q2" vid="PSA 135:18">ኡባይ ኡንቱንቱዳን ሀንኖ።<verse eid="PSA 135:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19"/>እስራኤልያ ጎልያ አሳቶ፥</para>
  <para style="q2" vid="PSA 135:19">መና ጎዳ ጋላትተ፤</para>
  <para style="q1" vid="PSA 135:19">አሮና ጎልያ አሳቶ፥</para>
  <para style="q2" vid="PSA 135:19">መና ጎዳ ጋላትተ፤<verse eid="PSA 135:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20"/>ሌዊያ ጎልያ አሳቶ፥</para>
  <para style="q2" vid="PSA 135:20">መና ጎዳ ጋላትተ፤</para>
  <para style="q1" vid="PSA 135:20">መና ጎዳዉ ያይያዋንቶ፥</para>
  <para style="q2" vid="PSA 135:20">ኡባይ መና ጎዳ ጋላትተ።<verse eid="PSA 135:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21"/>የሩሳላመን ደእያ መና ጎዳይ</para>
  <para style="q2" vid="PSA 135:21">ጽዮነን ጋላተቶ!</para>
  <para style="b" vid="PSA 135:21"/>
  <para style="q1" vid="PSA 135:21">መና ጎዳ ጋላትተ!<verse eid="PSA 135:21"/></para>
  <chapter eid="PSA 135"/>
  <chapter number="136" style="c" sid="PSA 136"/>
  <para style="s1">ጋላታ ማዝሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1"/>መና ጎዳ ጋላትተ! አያዉ ጎፐ፥ እ ኬካ፤<note caller="-" style="x"><char style="xo" closed="false">136:1 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1 ኦዱዋ 16:34</ref>፤ <ref loc="2CH 5:13">2 ኦዱዋ 5:13</ref>፤ <ref loc="2CH 7:3">7:3</ref>፤ <ref loc="EZR 3:11">እዝራ 3:11</ref>፤ <ref loc="PSA 100:5">ማዝ. 100:5</ref>፤ <ref loc="PSA 106:1">106:1</ref>፤ <ref loc="PSA 107:1">107:1</ref>፤ <ref loc="PSA 118:1">118:1</ref>፤ <ref loc="JER 33:11">ኤር. 33:11</ref></char></note></para>
  <para style="q2" vid="PSA 136:1">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2"/>ጾሳቱዋ ጾሳ ጋላትተ!</para>
  <para style="q2" vid="PSA 136:2">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3"/>ጎዳቱዋ ጎዳ ጋላትተ!</para>
  <para style="q2" vid="PSA 136:3">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4"/>አ ጻላላይ ዎልቃማ ማላልስያባ ኦ፤</para>
  <para style="q2" vid="PSA 136:4">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5"/>ባረ አዳ ኤራን እ ሳሎቱዋ መዳ፤<note caller="-" style="x"><char style="xo" closed="false">136:5 </char><char style="xt" closed="false"><ref loc="GEN 1:1">ዶመ 1:1</ref></char></note></para>
  <para style="q2" vid="PSA 136:5">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6"/>ቢታ ሃ ቦላን ምጬዳ፤<note caller="-" style="x"><char style="xo" closed="false">136:6 </char><char style="xt" closed="false"><ref loc="GEN 1:2">ዶመ 1:2</ref></char></note></para>
  <para style="q2" vid="PSA 136:6">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7"/>ዎልቃማ ፖኦቱዋ መዳ፤<note caller="-" style="x"><char style="xo" closed="false">136:7-9 </char><char style="xt" closed="false"><ref loc="GEN 1:16">ዶመ 1:16</ref></char></note></para>
  <para style="q2" vid="PSA 136:7">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8"/>አዋይ ጋላስ ሞዳናዳን ኦዳ፤</para>
  <para style="q2" vid="PSA 136:8">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9"/>አግናይነ ጾልንተቱ</para>
  <para style="q2" vid="PSA 136:9">ቃማ ሞዳናዳን ኦዳ፤</para>
  <para style="q2" vid="PSA 136:9">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10"/>እ ግብጼ ቢታን ባይራቱዋ ዎዳ፤<note caller="-" style="x"><char style="xo" closed="false">136:10 </char><char style="xt" closed="false"><ref loc="EXO 12:29">ከሳ 12:29</ref></char></note></para>
  <para style="q2" vid="PSA 136:10">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11"/>እስራኤልያ አሳ፥</para>
  <para style="q2" vid="PSA 136:11">ግብጼፐ ካለደ ከሴዳ፤<note caller="-" style="x"><char style="xo" closed="false">136:11 </char><char style="xt" closed="false"><ref loc="EXO 12:51">ከሳ 12:51</ref></char></note></para>
  <para style="q2" vid="PSA 136:11">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12"/>ባረ ምኖ ኩሽያን፥</para>
  <para style="q2" vid="PSA 136:12">ባረ ዎልቃማ ቀስያን ሀዋ ኦዳ፤</para>
  <para style="q2" vid="PSA 136:12">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13"/>ዞኦ አባ ሻክ የጌዳ፤<note caller="-" style="x"><char style="xo" closed="false">136:13-15 </char><char style="xt" closed="false"><ref loc="EXO 14:21-29">ከሳ 14:21-29</ref></char></note></para>
  <para style="q2" vid="PSA 136:13">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14"/>እስራኤልያ አሳ፥</para>
  <para style="q2" vid="PSA 136:14">ሄ አባ ግዱዋና ፕንዳ፤</para>
  <para style="q2" vid="PSA 136:14">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15"/>ግብጼ ካትያነ አ ኦላንቻቱዋ</para>
  <para style="q2" vid="PSA 136:15">ዞኦ አባን ሙክሴዳ፤</para>
  <para style="q2" vid="PSA 136:15">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16"/>እ ባረ አሳ ካለደ፥</para>
  <para style="q2" vid="PSA 136:16">ባዙዋና አዳ፤</para>
  <para style="q2" vid="PSA 136:16">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17"/>ዎልቃማ ካተቱዋ ሾጬዳ፤</para>
  <para style="q2" vid="PSA 136:17">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18"/>ኤረቴዳ ካተቱዋ ዎዳ፤</para>
  <para style="q2" vid="PSA 136:18">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19"/>አሞረቱዋ ካትያ ስሆና ዎዳ፤<note caller="-" style="x"><char style="xo" closed="false">136:19 </char><char style="xt" closed="false"><ref loc="NUM 21:21-30">ፓይ. 21:21-30</ref></char></note></para>
  <para style="q2" vid="PSA 136:19">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20"/>ቃይ ባሳነ ካትያ ኦጋ ዎዳ፤<note caller="-" style="x"><char style="xo" closed="false">136:20 </char><char style="xt" closed="false"><ref loc="NUM 21:31-35">ፓይ. 21:31-35</ref></char></note></para>
  <para style="q2" vid="PSA 136:20">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21"/>ያቲደ ኡንቱንቱ ቢታ ባረ አሳ ላትሴዳ፤</para>
  <para style="q2" vid="PSA 136:21">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22"/>ባረ ቆማ እስራኤልያ ላትሴዳ፤</para>
  <para style="q2" vid="PSA 136:22">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23"/>እ ኑን ካዉሼዳ ዎደካ ኑና ቆፔዳ፤</para>
  <para style="q2" vid="PSA 136:23">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24"/>ኑና ኑ ሞርከቱዋፐ አሼዳ፤</para>
  <para style="q2" vid="PSA 136:24">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25"/>መታ ኡባዉ ቁማ እሜ፤</para>
  <para style="q2" vid="PSA 136:25">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26"/>ሳሉዋ ጾሳ ጋላትተ!</para>
  <para style="q2" vid="PSA 136:26">አገና አ ሲቁ መናዋ።<verse eid="PSA 136:26"/></para>
  <chapter eid="PSA 136"/>
  <chapter number="137" style="c" sid="PSA 137"/>
  <para style="s1">ኦሞዱዋን ደእያ እስራኤልያ ዬኩዋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1"/>ባብሎነ ሻፋቱዋ ማታን ኡቲደ፥</para>
  <para style="q2" vid="PSA 137:1">ኑን ጽዮነ ቆፔዳ ዎደ ዬኬዶ።<verse eid="PSA 137:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2"/>ሄ ሳኣን ኑን፥</para>
  <para style="q2" vid="PSA 137:2">ኑ ዲ ሃ ማታን ድጭያ ም ቦላ ካቄዶ።<verse eid="PSA 137:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3"/>ኑና ኦሞዴዳ አሳቱ፥</para>
  <para style="q2" vid="PSA 137:3">ኑን የጺደ፥ ኡንቱንታ ናሸቻና ማላ፥</para>
  <para style="q1" vid="PSA 137:3">“ጽዮነ የፐ እቱዋ አነ ኑዉ የጽተ” ያጌድኖ።<verse eid="PSA 137:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4"/>መና ጎዳ የ፥ ኑን፥</para>
  <para style="q2" vid="PSA 137:4">አላጋ ቢታን ዎት የጻኔ?<verse eid="PSA 137:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5"/>የሩሳላመ ካታማቴ፥ ታን ኔና ዶጎፐ፥</para>
  <para style="q2" vid="PSA 137:5">ታ ኡሸቻ ኩሺ ባረ ኦሱዋ ዶጎ።<verse eid="PSA 137:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6"/>ታን ኔና ሀሳየናን አጎፐነ</para>
  <para style="q2" vid="PSA 137:6">ታ ናሸቻ ኡባፐ አደ የሩሳላመ ዶሰናን አጎፐ፥</para>
  <para style="q2" vid="PSA 137:6">ታ እንጻርሳይ ኮክያና ኦይቀቶ።<verse eid="PSA 137:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7"/>አቤት መና ጎዳዉ፥ የሩሳላመ ኦሞደትያ ጋላስ፥</para>
  <para style="q2" vid="PSA 137:7">ኤዶማ አሳቱ ኦዳዋ ሀሳያ፤</para>
  <para style="q2" vid="PSA 137:7">ኡንቱንቱ፥ “ኮልተ! ኮልተ!</para>
  <para style="q2" vid="PSA 137:7">ህርክ ጻጱዋ ጋካናዉ ላልተ!” ያጌዳዋ ዶጎፓ።<verse eid="PSA 137:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8"/>ባብሎነ ቢታዉ፥ ኔንካ ባያና!<note caller="-" style="x"><char style="xo" closed="false">137:8 </char><char style="xt" closed="false"><ref loc="REV 18:6">ሳፃ 18:6</ref></char></note></para>
  <para style="q2" vid="PSA 137:8">ኔን ኑ ቦላን ኦዳ ኢታ ኦሱዋ፥</para>
  <para style="q2" vid="PSA 137:8">ነ ቦላ ኦያዌ አንጀቴዳዋ።<verse eid="PSA 137:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9"/>ነ ጉ ናናቱዋ ኦይቂደ፥</para>
  <para style="q2" vid="PSA 137:9">ዛላ ቦላ ሾጭያዌ አንጀቴዳዋ።<verse eid="PSA 137:9"/></para>
  <chapter eid="PSA 137"/>
  <chapter number="138" style="c" sid="PSA 138"/>
  <para style="s1">ጋላታ ዎሳ</para>
  <para style="d">ዳውት ጻፌዳዋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1"/>አቤት መና ጎዳዉ፥ ታን ታ ኩመን ዎዛናፐ ኔና ጋላታና፤</para>
  <para style="q2" vid="PSA 138:1">ጾሳቱዋ ስንን ኔና ሳባና።<verse eid="PSA 138:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2"/>ነ ጌሻ ጎልያኮ ስማደ፥</para>
  <para style="q2" vid="PSA 138:2">ነዉ ጎይናደ፥ አገና ነ ሲቁዋነ ነ ቱማተ ድራዉ፥</para>
  <para style="q2" vid="PSA 138:2">ታን ነ ሱን ጋላታይ፤</para>
  <para style="q2" vid="PSA 138:2">አያዉ ጎፐ፥ ኔን ነ ሱንነ ነ ቃላ፥</para>
  <para style="q2" vid="PSA 138:2">ኡባፐ አደ ቁ ኦዳ።<verse eid="PSA 138:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3"/>ታን ጼሴዳ ጋላስ ታዉ ኮያዳ፤</para>
  <para style="q2" vid="PSA 138:3">ነ ምኖተን ታና ምንሳዳ።<verse eid="PSA 138:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4"/>አቤት መና ጎዳዉ፥ ሳኣን ደእያ ካተቱ ኡባይ፥</para>
  <para style="q2" vid="PSA 138:4">ኔና ጋላትኖ፤</para>
  <para style="q2" vid="PSA 138:4">አያዉ ጎፐ፥ ኡንቱንቱ ነ ዶናፐ ከሴዳ ቃላ ስሴድኖ።<verse eid="PSA 138:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5"/>መና ጎዳ ቦንቹ ዎልቃማ ግድያ ድራዉ፥</para>
  <para style="q2" vid="PSA 138:5">ኡንቱንቱ መና ጎዳ ኦግያዋ የጻና።<verse eid="PSA 138:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6"/>መና ጎዳይ ቦላ ቃን ደኦፐካ፥</para>
  <para style="q2" vid="PSA 138:6">ህዬሳቱዋ ኬካ አይፍያን ጼሌ።</para>
  <para style="q1" vid="PSA 138:6">ሽን ኦቶራንቻቱዋ እ ሃኩዋን ኤሬ።<verse eid="PSA 138:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7"/>ታን መቱዋ ግዱዋና ሀመቶፐካ፥</para>
  <para style="q2" vid="PSA 138:7">ኔን ታና ደኡዋን ናጋሳ።</para>
  <para style="q1" vid="PSA 138:7">ታ ሞርከቱዋ ሀንቁዋ ቦላ ነ ኩሽያ ምጫሳ፤</para>
  <para style="q2" vid="PSA 138:7">ነ ኡሸቻን ታና አሻሳ።<verse eid="PSA 138:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8"/>መና ጎዳይ ታዉ ጊደ ቆፔዳዋ ፖላና፤</para>
  <para style="q2" vid="PSA 138:8">አቤት መና ጎዳዉ፥ አገና ነ ሲቁ መናዋ።</para>
  <para style="q1" vid="PSA 138:8">ነ ኩሽያ ኦሱዋ አጋ አጎፓ።<verse eid="PSA 138:8"/></para>
  <chapter eid="PSA 138"/>
  <chapter number="139" style="c" sid="PSA 139"/>
  <para style="s1">ኡባ ኤርያ ጾሳ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ዳውት ጻፌዳ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1"/>አቤት መና ጎዳዉ፥ ኔን ታና ብዳደ ኤራዳ።<verse eid="PSA 139:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2"/>ታን አዉደ ኡትንቶነ</para>
  <para style="q2" vid="PSA 139:2">አዉደ ኤቂንቶ፥ ኔን ኤራሳ፤</para>
  <para style="q2" vid="PSA 139:2">ኔን ታ ቆፋ ኡባ ሃኩዋን ኤራሳ።<verse eid="PSA 139:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3"/>ታን ብያሳነ፥</para>
  <para style="q2" vid="PSA 139:3">ሸምፕያ ሳ ጾሞሳሳ፤</para>
  <para style="q2" vid="PSA 139:3">ታ ኦገቱዋ ኡባ ኔን ኤራሳ።<verse eid="PSA 139:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4"/>አቤት መና ጎዳዉ፥ ታን ታ እንጻርሳን</para>
  <para style="q2" vid="PSA 139:4">እት ቃላ ሃሳያናፐ ካሰታደ፥</para>
  <para style="q2" vid="PSA 139:4">ኔን ታ ቆፋ ኡባ ኤራሳ።<verse eid="PSA 139:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5"/>ኔን ታ ዩሹዋን ደኣሳ፤</para>
  <para style="q2" vid="PSA 139:5">ነ ኩሽያን ታና ናጋሳ።<verse eid="PSA 139:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6"/>ነ ኤራይ ታና ሎይ ማላልሴ፤</para>
  <para style="q2" vid="PSA 139:6">ታን አኬካናዉ ዳንዳይያሳፐ ቃ።<verse eid="PSA 139:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7"/>ታን ነ አያናፐ ሀቃ ባናዉ ዳንዳያይታ?</para>
  <para style="q2" vid="PSA 139:7">ዎይ ነ ስንፐ ሀቃ ባቃታናዉ ዳንዳያይታ?<verse eid="PSA 139:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8"/>ፑደ ሳሉዋ ከሶፐ፥</para>
  <para style="q2" vid="PSA 139:8">ኔን ያን ደኣሳ!</para>
  <para style="q1" vid="PSA 139:8">ዱገ ስኦልያ ዎንቶካ፥</para>
  <para style="q2" vid="PSA 139:8">ኔን ያን ደኣሳ።<verse eid="PSA 139:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9"/>አዋይ ሞክያሳ ባጋ ፓላደ ቦፐ፥</para>
  <para style="q2" vid="PSA 139:9">ዎይ አዋይ ዉልያሳ ባጋን ሃካደ ደኦፐ፥<verse eid="PSA 139:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10"/>ሄ ሳንካ ነ ኩሺ ታና ካለ፤</para>
  <para style="q2" vid="PSA 139:10">ነ ኡሸቻ ኩሺ ታና ዘምፕሴ።<verse eid="PSA 139:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11"/>ታን፥ “ማዉ፥ ታና ገን፤</para>
  <para style="q2" vid="PSA 139:11">ፖኡዋ፥ ቃማዉ ላመታ” ያግንቶካ፥<verse eid="PSA 139:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 139:12"/>ማ ዳሩ ነዉ መና፤</para>
  <para style="q2" vid="PSA 139:12">ቃማይ ጋላሳዳን ፖኤ፤</para>
  <para style="q2" vid="PSA 139:12">አያዉ ጎፐ፥ ነዉ ማይ ፖኡዋ ማላ።<verse eid="PSA 139:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13"/>ኔን ታ ግዶ አሳተ ኡባ መዳ፤</para>
  <para style="q2" vid="PSA 139:13">ታ አት ኡሉዋን ታና ኔን ዋጻ መዳ።<verse eid="PSA 139:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14"/>ኔን ታና ማላልስያባነ ኦራባ ኦደ መዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 139:14">ታን ኔና ጋላታይ።</para>
  <para style="q1" vid="PSA 139:14">ነ ኦሶቱ ማላልስያዋንታ!</para>
  <para style="q2" vid="PSA 139:14">ታን ቃይ ሄዋ ዉርሳደ ኤራይ።<verse eid="PSA 139:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15"/>ታን ጌማ ሳኣን መትያ ዎደ፥</para>
  <para style="q2" vid="PSA 139:15">ታ መቀቱ ኔፐ ጌምበይክኖ።</para>
  <para style="q1" vid="PSA 139:15">ታ ቦላይ ታ አት ኡሉዋ ጪማ ግዶን</para>
  <para style="q2" vid="PSA 139:15">ሂላን አሌቀቲደ ኦሰትያ ዎደ፥<verse eid="PSA 139:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 139:16"/>የለትቤና ታ አሳተ ነ አይፊ በኤዳ።</para>
  <para style="q2" vid="PSA 139:16">ብሮ እቱነ ዶመተናን ደእሽን፥</para>
  <para style="q2" vid="PSA 139:16">ታዉ ኔን ጊግሴዳ ጋላሳቱ ኡባቱ</para>
  <para style="q2" vid="PSA 139:16">ነ ማዝጎብያን ጻፈቴድኖ።<verse eid="PSA 139:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17"/>አቤት ጾሳዉ፥</para>
  <para style="q2" vid="PSA 139:17">ነ ቆፋቱ አያ ጮራቴድኖ!</para>
  <para style="q1" vid="PSA 139:17">ኡንቱንታ ኤራናዌ አያ ዋይሲ!<verse eid="PSA 139:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18"/>ታን ኡንቱንታ ፓይድንቶ፥</para>
  <para style="q2" vid="PSA 139:18">ኡንቱንቱ ሻፍያፐ ዳራና ሽን።</para>
  <para style="q1" vid="PSA 139:18">ታን ቤጎትያ ዎደ፥</para>
  <para style="q2" vid="PSA 139:18">ሀእካ ኔናና ደአይ።<verse eid="PSA 139:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19"/>አቤት ጾሳዉ፥ ኔን ኢታቱዋ ዎድንቶ አዬ ደኢ!</para>
  <para style="q2" vid="PSA 139:19">ሱ ጉስያ አሳቱ ታፐ ሃክኖ!<verse eid="PSA 139:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20"/>ኡንቱንቱ ነ ቦላ ኢታባ ሃሳዪኖ፤</para>
  <para style="q2" vid="PSA 139:20">ነ ሞርከቱ ነ ሱን ባይዚኖ።<verse eid="PSA 139:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21"/>አቤት መና ጎዳዉ፥ ኔና እጽያዋንታ</para>
  <para style="q2" vid="PSA 139:21">ታን እጽክታ?</para>
  <para style="q1" vid="PSA 139:21">ነ ቦላ ደንድያዋንታ</para>
  <para style="q2" vid="PSA 139:21">ታን ሸነትክታ?<verse eid="PSA 139:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22"/>ታን ኡንቱንታ ኡባ እጻይ፤</para>
  <para style="q2" vid="PSA 139:22">ኡንቱንታ ታን ታ ሞርከቱዋዳን ፓይዳይ።<verse eid="PSA 139:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23"/>አቤት ጾሳዉ፥</para>
  <para style="q2" vid="PSA 139:23">ታና ብዳደ፥ ታ ዎዛና ኤራ፤</para>
  <para style="q2" vid="PSA 139:23">ታና ፓጫደ፥ ታ ኡንኤትያ ቆፋ ኤራ።<verse eid="PSA 139:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24"/>አነ ታናን ኢታባይ ደኦፐ ጼላ፤</para>
  <para style="q2" vid="PSA 139:24">መና ኦግያን ታና ካለ።<verse eid="PSA 139:24"/></para>
  <chapter eid="PSA 139"/>
  <chapter number="140" style="c" sid="PSA 140"/>
  <para style="s1">ኢታቱዋ ቦላ ሺቄዳ ዎሳ</para>
  <para style="d">ዛማረቱዋ ካፖ የጸቴዳ፥ ዳውት ጻፌዳ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1"/>አቤት መና ጎዳዉ፥ ኢታ አሳቱዋፐ ታና አሻ፤</para>
  <para style="q2" vid="PSA 140:1">ማካላንቻ አሳቱዋፐ ታና ናጋ።<verse eid="PSA 140:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2"/>ኡንቱንቱ ኡባ ዎደ፥</para>
  <para style="q2" vid="PSA 140:2">ኢታባ ኦናዉ ማቀቲኖ፤</para>
  <para style="q2" vid="PSA 140:2">ኡባ ጋላስካ፥</para>
  <para style="q2" vid="PSA 140:2">ዋላሳ ደንናዉ ቆፒኖ።<verse eid="PSA 140:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3"/>ኡንቱንቱ ባረንቱ እንጻርሳ ሾሻዋዳን ቃራዪኖ፤<note caller="-" style="x"><char style="xo" closed="false">140:3 </char><char style="xt" closed="false"><ref loc="ROM 3:13">ሮመ 3:13</ref></char></note></para>
  <para style="q2" vid="PSA 140:3">ኡንቱንቱ ዶናፐ አሳ ዎያ ሀሱዋ ሾሻ ይሻ ማላ ሃሳያይ ከሴ።<verse eid="PSA 140:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4"/>አቤት መና ጎዳዉ፥ ኢታ አሳቱዋ ኩሽያፐ፥</para>
  <para style="q2" vid="PSA 140:4">ታና አሻ፤</para>
  <para style="q2" vid="PSA 140:4">ታ ገድያ ቃጻናዉ ቆፕያ ማካላንቻ አሳቱዋፐ ታና ናጋ።<verse eid="PSA 140:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5"/>ኦቶራንቻ አሳቱ ታዉ ዲዛ ጊግሴድኖ፤</para>
  <para style="q2" vid="PSA 140:5">ግትያ ሂጼድኖ፤</para>
  <para style="q2" vid="PSA 140:5">ታና ኦይቃናዉ ጲርያ ኦግያን ዎድኖ።<verse eid="PSA 140:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6"/>ታን መና ጎዳ፥ “ኔን ታ ጾሳ” ያጋይ።</para>
  <para style="q2" vid="PSA 140:6">አቤት መና ጎዳዉ፥ ታን ዋትዋትያ ዋትዋቱዋ ስሳ።<verse eid="PSA 140:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7"/>አቤት ኡባ ሞድያ መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 140:7">ታና አሽያ ምኖ፥</para>
  <para style="q2" vid="PSA 140:7">ኦላ ጋላስ ታዉ ጎንዳለ ግዳዳ።<verse eid="PSA 140:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8"/>አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 140:8">ኢታቶ ኡንቱንቱ አሙዋ እሞፓ፤</para>
  <para style="q2" vid="PSA 140:8">ኡንቱንቱ ኢታ ማቁዋ ፖልሶፓ።<verse eid="PSA 140:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9"/>ታ ሞርከቱዋን ታና ጾንሶፓ፤</para>
  <para style="q2" vid="PSA 140:9">ኡንቱንቱ ዶናፐ ከስያ ኢታባይ ኡንቱንቶ ስሞ።<verse eid="PSA 140:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10"/>ኡንቱንቱ ቦላ ጹግያ ቦንቁ ቆለቶ፤</para>
  <para style="q2" vid="PSA 140:10">ኡንቱንቱ ታማን ኦለትኖ፤</para>
  <para style="q2" vid="PSA 140:10">ሄዋፐ ላኤን ደንደና ኦላን ኦለትኖ።<verse eid="PSA 140:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11"/>ዝግርያዋንታ ቢታይ ቶኮፖ፤</para>
  <para style="q2" vid="PSA 140:11">ማካላንቻ አሳቱዋ ኢታባይ ሻንካቲደ ኦይቆ።<verse eid="PSA 140:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12"/>መና ጎዳይ ህዬሳቶ ፕርድያዋነ፥</para>
  <para style="q2" vid="PSA 140:12">መቶታንቻቱዋ ማታ ናግስያዋ ኤራይ።<verse eid="PSA 140:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13"/>ቱሙፐ ጽሎቱ ነ ሱን ጋላታና፤</para>
  <para style="q2" vid="PSA 140:13">ሱረ አሳቱ ነ ስንን ደአና።<verse eid="PSA 140:13"/></para>
  <chapter eid="PSA 140"/>
  <chapter number="141" style="c" sid="PSA 141"/>
  <para style="s1">ኦማርሳ ዎሳ</para>
  <para style="d">ዳውት ጻፌዳ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1"/>አቤት መና ጎዳዉ፥ ታን ኔና ጼሳይ፤</para>
  <para style="q2" vid="PSA 141:1">ታና ማዳናዉ ኤሌላ።</para>
  <para style="q1" vid="PSA 141:1">ታን ኔኮ ዋስያ ዎደ፥ ታ ኮሻ ስሳ!<verse eid="PSA 141:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2"/>ታ ዎሳይ እጻና ጩዋዳን፥</para>
  <para style="q2" vid="PSA 141:2">ነ ስን ሺቆ፤<note caller="-" style="x"><char style="xo" closed="false">141:2 </char><char style="xt" closed="false"><ref loc="REV 5:8">ሳፃ 5:8</ref></char></note></para>
  <para style="q2" vid="PSA 141:2">ታን ታ ኩሽያ ምጭያዌ፥</para>
  <para style="q2" vid="PSA 141:2">ነዉ ኦማርሳ ያርሹዋ ማላ ግዶ።<verse eid="PSA 141:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3"/>አቤት መና ጎዳዉ፥ ታ ዶና ናግያዋ ዎ፤</para>
  <para style="q2" vid="PSA 141:3">ታ መተርሻቱዋ ፐንግያን ዛባይንያ ኤሳ።<verse eid="PSA 141:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4"/>ባይዙዋ ኦያ አሳቱዋና፥</para>
  <para style="q2" vid="PSA 141:4">ኢታ ኦሱዋ ኦና ማላ፥</para>
  <para style="q2" vid="PSA 141:4">ታ ዎዛና ኢታባኮ ዛሮፓ።</para>
  <para style="q2" vid="PSA 141:4">ኡንቱንቱ ግብራካ ታና ሙዞፓ።<verse eid="PSA 141:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5"/>ጽሎ አሳይ ታና አገና ሲቁዋን</para>
  <para style="q2" vid="PSA 141:5">ሴራናዉነ ሙራናዉ ዳንዳዬ፤</para>
  <para style="q2" vid="PSA 141:5">ኡንቱንቱ ታና ባቆፐ ሄዌ ታ ሁጲያን ዛይትያ ኦክያዋ ማላ፤</para>
  <para style="q2" vid="PSA 141:5">አያዉ ጎፐ፥ ታን ኡባ ገደካ</para>
  <para style="q2" vid="PSA 141:5">ኢታቱዋ ኦሱዋ ቦላ ዎሳይ።<verse eid="PSA 141:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6"/>ኡንቱንቱ ዳናቱ ዛላ አፉዋና፥</para>
  <para style="q2" vid="PSA 141:6">ዱገ ኦለትያ ዎደ፥</para>
  <para style="q2" vid="PSA 141:6">ታ ቃላይ ቱማ ግድያዋ ኡንቱንቱ አሳይ ኤራና።<verse eid="PSA 141:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7"/>ቢታይ ጎሸትያዋዳንነ</para>
  <para style="q2" vid="PSA 141:7">ጉሉ መኤረትያዋዳን</para>
  <para style="q2" vid="PSA 141:7">ኡንቱንቱ መቀይካ ዱፉዋ ዶናን ላለታና።<verse eid="PSA 141:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8"/>አቤት ኡባ ሞድያ መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 141:8">ታ አይፊ ኔና ጼሌ፤</para>
  <para style="q2" vid="PSA 141:8">ታን ኔኮ ባቃታደ አታይ፤</para>
  <para style="q2" vid="PSA 141:8">ታና ሀይቆ አደ እሞፓ።<verse eid="PSA 141:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9"/>ኡንቱንቱ ታዉ ዎዳ ግትያፐነ፥</para>
  <para style="q2" vid="PSA 141:9">ኢታ ኦያዋንቱ ጲርያፐ ታና ናጋ።<verse eid="PSA 141:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10"/>ታን ሳሮ አያ ዎደ፥</para>
  <para style="q2" vid="PSA 141:10">ኢታቱ ባረንቱ ዎዳ ግትያን ኦይቀትኖ።<verse eid="PSA 141:10"/></para>
  <chapter eid="PSA 141"/>
  <chapter number="142" style="c" sid="PSA 142"/>
  <para style="s1">ጾሳ ማዱዋ ደማናዉ ሺቄዳ ዎሳ</para>
  <para style="d">አኬካን ጻፈቴዳ ዳዊታ ግንጹዋ፥ ጎንጎሎ ግዶን ደእያ ዎደ አ ዎሳ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1"/>ታ ቃላ ቁ ኦደ፥ መና ጎዳዉ ዋሳይ።</para>
  <para style="q2" vid="PSA 142:1">ታ ቃላ ቁ ኦደ፥</para>
  <para style="q2" vid="PSA 142:1">መና ጎዳዉ ዋትዋታይ።<verse eid="PSA 142:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2"/>ታ ቆሁዋ ኡባ አዉ ማጋናይ፤</para>
  <para style="q2" vid="PSA 142:2">ታ መቱዋ ኡባ አዉ ኦዳይ።<verse eid="PSA 142:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3"/>ታን ህዶታ ቃንጻና ማቲያ ዎደ፥ ኔን ታ ኦግያ ኤራሳ።</para>
  <para style="q2" vid="PSA 142:3">ታን ሀመትያ ኦግያን ታዉ ግትያ ቆስ ዎድኖ።<verse eid="PSA 142:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4"/>ታን ታ ዩሹዋ ጼልያ ዎደ፥</para>
  <para style="q2" vid="PSA 142:4">ታና ማድያዌ እቱነ ባዋ፤</para>
  <para style="q2" vid="PSA 142:4">ታን ቆሰታ አትያ ሳአይ ባዋ፤</para>
  <para style="q2" vid="PSA 142:4">ታና ናግያዌካ ባዋ።<verse eid="PSA 142:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5"/>አቤት መና ጎዳዉ፥ ታን፥</para>
  <para style="q2" vid="PSA 142:5">ነዉ ሀዋዳን ጋደ ዋሳይ፤</para>
  <para style="q1" vid="PSA 142:5">“ኔን ታን ባቃታደ አትያ ሳኣ፤</para>
  <para style="q2" vid="PSA 142:5">ታን ፓጻ ደእሽን፥ ታና ጋኬዳ ሳማይ ኔና” ያጋይ።<verse eid="PSA 142:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6"/>ታን ሎይ መቶትያ ድራዉ፥</para>
  <para style="q2" vid="PSA 142:6">ታ ዋሱዋ ሀይዛ።</para>
  <para style="q1" vid="PSA 142:6">ታና የደርስያዋንቱ፥</para>
  <para style="q2" vid="PSA 142:6">ታዉ ሎይ ዎልቃሜዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 142:6">ታና ኡንቱንቱፐ አሻ።<verse eid="PSA 142:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7"/>ታን ነ ሱን ጋላታና ማላ፥</para>
  <para style="q2" vid="PSA 142:7">ታና ቃሹዋፐ ብላ።</para>
  <para style="q1" vid="PSA 142:7">ኔን ታዉ ኬክያ ድራዉ፥</para>
  <para style="q2" vid="PSA 142:7">ጽሎቱ ታ ዩሹዋን ሺቃና።<verse eid="PSA 142:7"/></para>
  <chapter eid="PSA 142"/>
  <chapter number="143" style="c" sid="PSA 143"/>
  <para style="s1">ጾሳ ማዱዋ ደማናዉ ሺቄዳ ዎሳ</para>
  <para style="d">ዳውት ጻፌዳ ማዛሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1"/>አቤት መና ጎዳዉ፥ ታ ዎሳ ስሳ፤ ታ ዋትዋቱዋ ሀይዛ።</para>
  <para style="q2" vid="PSA 143:1">ኔን ጽሉዋነ አማነትያዋ ግድያ ድራዉ፥</para>
  <para style="q3" vid="PSA 143:1">ታዉ ዛሩዋ እማ።<verse eid="PSA 143:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2"/>ነ ስንን ጽሎ ግዳና አሳይ ባዋ፤<note caller="-" style="x"><char style="xo" closed="false">143:2 </char><char style="xt" closed="false"><ref loc="ROM 3:20">ሮመ 3:20</ref>፤ <ref loc="GAL 2:16">ጋላ. 2:16</ref></char></note></para>
  <para style="q2" vid="PSA 143:2">ሄዋ ድራዉ፥ ታና ነ ቆማ ፕርዳዉ ሺሾፓ።<verse eid="PSA 143:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3"/>ታና ታ ሞርኪ የደርሲደ፥</para>
  <para style="q2" vid="PSA 143:3">ቢታና ጋ ክንቼሬዳ፤</para>
  <para style="q2" vid="PSA 143:3">በን ሀይቄዳ አሳቱዋዳን ታና ማን ዎዳ።<verse eid="PSA 143:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4"/>ሄዋ ድራዉ፥ ታን ህዶታ ቃንጻድ፤</para>
  <para style="q2" vid="PSA 143:4">ታ ዎዛናይካ ይባቴዳ።<verse eid="PSA 143:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5"/>ታን በን ዎደቱዋ ሀሳያይ፤</para>
  <para style="q2" vid="PSA 143:5">ኔን ኦዳ ኦሱዋ ኡባ ዛራ ዛራደ ቆፓይነ</para>
  <para style="q2" vid="PSA 143:5">ነ ኩሺ ኦዳዋ አኬካይ።<verse eid="PSA 143:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6"/>ታን ታ ኩሽያ ኔኮ ምጫድ፤</para>
  <para style="q2" vid="PSA 143:6">መላ ቢታይ ሃ ኮይያዋዳን፥</para>
  <para style="q2" vid="PSA 143:6">ታ ሸምፑ ኔና ሳመቴ።<verse eid="PSA 143:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7"/>አቤት መና ጎዳዉ፥ ታዉ ዛሩዋ እማናዉ ኤሌላ!</para>
  <para style="q2" vid="PSA 143:7">ታን ህዶታ ቃንጻድ።</para>
  <para style="q1" vid="PSA 143:7">ታን ዱገ ዱፉዋን ገልያ አሳቱዋ ማላ ግደናዳን፥</para>
  <para style="q2" vid="PSA 143:7">ነ ሶምኡዋ ታፐ ገንፓ።<verse eid="PSA 143:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8"/>ታን ኔና አማነትያ ድራዉ፥</para>
  <para style="q2" vid="PSA 143:8">ዎንታ ዎንታ አገና ነ ሲቁዋ ታና በሳ።</para>
  <para style="q1" vid="PSA 143:8">ታን ታ ሸምፑዋፐ ኔና ዎስያ ድራዉ፥</para>
  <para style="q2" vid="PSA 143:8">ታን ባናዉ በስያ ኦግያ ታና ታማርሳ።<verse eid="PSA 143:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9"/>አቤት መና ጎዳዉ፥ ታን ኔኮ ባቃቴዳ ድራዉ፥</para>
  <para style="q2" vid="PSA 143:9">ታና ታ ሞርከቱዋፐ አሻ።<verse eid="PSA 143:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10"/>ኔን ታ ጾሳ ግድያ ድራዉ፥</para>
  <para style="q2" vid="PSA 143:10">ታን ነ ሸንያ ኦና ማላ፥ ታና ታማርሳ፤</para>
  <para style="q2" vid="PSA 143:10">ሎኦ አያናን ታና ሱረ ኦግያ ካለ።<verse eid="PSA 143:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11"/>አቤት መና ጎዳዉ፥ ነ ሱን ድራዉ፥ ታና አሻ፤</para>
  <para style="q2" vid="PSA 143:11">ነ ጽሎተን ታና መቱዋፐ ከሳ።<verse eid="PSA 143:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12"/>አገና ነ ሲቁዋን ታ ሞርከቱዋ ዎ፤</para>
  <para style="q2" vid="PSA 143:12">ታ ባልጋራቱዋ ኡባ ይሳ፤</para>
  <para style="q2" vid="PSA 143:12">አያዉ ጎፐ፥ ታን ነ ቆማ።<verse eid="PSA 143:12"/></para>
  <chapter eid="PSA 143"/>
  <chapter number="144" style="c" sid="PSA 144"/>
  <para style="s1">ጾኑዋ ማዝሙርያ</para>
  <para style="d">ዳውት ጻፌዳዋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1"/>መና ጎዳይ፥ ታ ዛላይ ጋላተቶ! እ ታ ኩሽያ ኦላዉ፥</para>
  <para style="q2" vid="PSA 144:1">ታ ብራቱዋካ ቶራዉ ሎህሴ።<verse eid="PSA 144:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2"/>እ ታና ሲቅያ ጾሳነ ታ ጌሱዋ፤</para>
  <para style="q2" vid="PSA 144:2">እ ታ ሚጻነ ታና አሽያዋ።</para>
  <para style="q1" vid="PSA 144:2">እ ታ ጎንዳልያነ ታን ባቃታደ አትያ ሳኣ።</para>
  <para style="q2" vid="PSA 144:2">ካዉተቱዋ እ ታዉ ሞድስያዋ።<verse eid="PSA 144:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3"/>አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 144:3">ኔን አዉ ቆፕያ አሳይ እ አዬ?<note caller="-" style="x"><char style="xo" closed="false">144:3 </char><char style="xt" closed="false"><ref loc="JOB 7:17-18">ኢዮባ 7:17-18</ref>፤ <ref loc="PSA 8:4">ማዝ. 8:4</ref></char></note></para>
  <para style="q1" vid="PSA 144:3">ኔን ናገትያ አሳ ናአይ አዬ?<verse eid="PSA 144:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4"/>አሳይ እት ገደ ጫርክያ ጫርኩዋ ማላ፤</para>
  <para style="q2" vid="PSA 144:4">አ ጋላሳቱካ አያ ኩዋ ማላ።<verse eid="PSA 144:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5"/>አቤት መና ጎዳዉ፥ ነ ሳሉዋ ዳካደ ዱገ ዎ!</para>
  <para style="q2" vid="PSA 144:5">ዎጋ ደረቱዋ ቦቻ፤ ኡንቱንቱካ ጩዋትኖ!<verse eid="PSA 144:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6"/>ዋልቃን የዳደ ነ ሞርከቱዋ ላላ!</para>
  <para style="q2" vid="PSA 144:6">ነ ዎንዳፍያ ፖ የዳደ ኡንቱንታ የደርሳ!<verse eid="PSA 144:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7"/>ቦላና ነ ኩሽያ ዱገ የዳደ፥</para>
  <para style="q2" vid="PSA 144:7">ታና ጪሞ ሃቱዋፐ ጎቻደ ከሳ፤</para>
  <para style="q2" vid="PSA 144:7">አላጋ አሳቱዋ ኩሽያፐ ታና ዎ አካ።<verse eid="PSA 144:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8"/>ኡንቱንቱ ቱሙዋ ሃሳይክኖ፥</para>
  <para style="q2" vid="PSA 144:8">ጫቂደካ ዎርዱዋ ሃሳዪኖ።<verse eid="PSA 144:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9"/>አቤት ጾሳዉ፥ ታን</para>
  <para style="q2" vid="PSA 144:9">ነዉ ኦራ የ የጻና፤</para>
  <para style="q2" vid="PSA 144:9">ታሙ ባቀን ዋጸቴዳ ዲን ነዉ ዲጻና።<verse eid="PSA 144:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10"/>ካተቶ ጾኑዋ እማሳ፤</para>
  <para style="q2" vid="PSA 144:10">ነ ቆማ ዳዊታ አሻሳ።<verse eid="PSA 144:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11"/>ታና ኢታ ማሻፐ አሻሳ፤</para>
  <para style="q2" vid="PSA 144:11">አላጋ አሳቱዋ ኩሽያፐ ታና ዎ አካ።</para>
  <para style="q1" vid="PSA 144:11">ኡንቱንቱ ቱሙዋ ሃሳያና ጊደ ጫቂደካ፥</para>
  <para style="q2" vid="PSA 144:11">ዎርዱዋ ሃሳዪኖ።<verse eid="PSA 144:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12"/>ኑ አቱማ ናናቱ፥</para>
  <para style="q2" vid="PSA 144:12">ባረንቱ ያላጋተን ዶልቂዶልቂደ፥</para>
  <para style="q2" vid="PSA 144:12">ድጭያ ም ማላ ግድኖ።</para>
  <para style="q2" vid="PSA 144:12">ኑ ማጫ ናናቱካ ካትያ ጎልያ ዞዝያን፥</para>
  <para style="q2" vid="PSA 144:12">አሌቆ ኤሴዳ ቱቅያ ማላ ግድኖ።<verse eid="PSA 144:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13"/>ኑ ድየቱ፥</para>
  <para style="q2" vid="PSA 144:13">ዳሮ ዱማ ዱማ ቆሞ ካን ኩምኖ፤</para>
  <para style="q2" vid="PSA 144:13">ኑ ደምባቱዋን ደእያ ዶርሳቱ ሻኣ፥</para>
  <para style="q2" vid="PSA 144:13">ታሙ ሻኣ የልኖ።<verse eid="PSA 144:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 144:14"/>ኑ ሚዛቱ ብራስኖ፤</para>
  <para style="q2" vid="PSA 144:14">ኡንቱንቱ ሳልኤሰናን የለቲደ ጮራትኖ።</para>
  <para style="q1" vid="PSA 144:14">ኑ ኦገቱዋን ዳጋማ ዋሱ ስሰቶፖ።<verse eid="PSA 144:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15"/>ሀ የዉ ቱሙ ሀንያ አሳቱ፥</para>
  <para style="q2" vid="PSA 144:15">አንጀቴዳዋንታ።</para>
  <para style="q1" vid="PSA 144:15">ኡንቱንቱ ጾሳይ መና ጎዳ ግድያ አሳቱ</para>
  <para style="q2" vid="PSA 144:15">አንጀቴዳዋንታ።<verse eid="PSA 144:15"/></para>
  <chapter eid="PSA 144"/>
  <chapter number="145" style="c" sid="PSA 145"/>
  <para style="s1">ጋላታ ጾሳዉ</para>
  <para style="d">ዳውት ጻፌዳ ጋላታ ሳባ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1"/>አቤት ታ ጾሳዉ፥ ታ ካትያዉ፥ ታን ኔና ግታያናነ፥</para>
  <para style="q2" vid="PSA 145:1">ነ ሱን መ መናዉ ጋላታና።<verse eid="PSA 145:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2"/>ታን ኔና ኡባ ጋላስ ሳባና፤</para>
  <para style="q2" vid="PSA 145:2">ነ ሱንካ መ መናዉ ጋላታና።<verse eid="PSA 145:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3"/>መና ጎዳይ ዎልቃማ፤ ቃ ጋላታይ አዉ በሴ።</para>
  <para style="q2" vid="PSA 145:3">አ ግታተይ አሳ ቆፋፐ አ።<verse eid="PSA 145:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4"/>እት የለታይ ሀራ የለታዉ</para>
  <para style="q2" vid="PSA 145:4">ኔን ኦዳዋ ኦዳና፤</para>
  <para style="q2" vid="PSA 145:4">ነ ማላልስያ ኦሶቱዋካ አዋያና።<verse eid="PSA 145:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5"/>ኡንቱንቱ ነ ቦንቹዋነ</para>
  <para style="q2" vid="PSA 145:5">ነ አንጋ ግታተባ ሃሳያና፤</para>
  <para style="q2" vid="PSA 145:5">ታንካ ነ ማላልስያ ኦሱዋ</para>
  <para style="q2" vid="PSA 145:5">ዛራ ዛራደ ቆፓና።<verse eid="PSA 145:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6"/>አሳይ፥ “ሆላ!” ጊስያ ነ ኦሱዋ ዎልቃባ ሃሳያና፤</para>
  <para style="q2" vid="PSA 145:6">ታንካ ነ ግታተ አዋያና።<verse eid="PSA 145:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7"/>ኡንቱንቱ ነ ኬካተ ዳሩዋ ኦዳና፤</para>
  <para style="q2" vid="PSA 145:7">ነ ጽሎተባካ የጻና።<verse eid="PSA 145:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8"/>መና ጎዳይ ቃረትያዋነ ማርያዋ፤</para>
  <para style="q2" vid="PSA 145:8">እ ሀንቀታናዉ ኤሌለናዋነ፤</para>
  <para style="q2" vid="PSA 145:8">ዳንዳያንቻነ አገና ሲቁ ዳርያዋ።<verse eid="PSA 145:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9"/>መና ጎዳይ ኡባዉ ኬካ፤</para>
  <para style="q2" vid="PSA 145:9">እ ባረ መዳ ኡባዉ ቃረትያዋ።<verse eid="PSA 145:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10"/>አቤት መና ጎዳዉ፥</para>
  <para style="q2" vid="PSA 145:10">ነ መታ ኡባይ ኔና ጋላታና፤</para>
  <para style="q2" vid="PSA 145:10">ነ አሳቱ ኡባይካ ኔና ሳባና።<verse eid="PSA 145:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11"/>ኡንቱንቱ ነ ካዉተ ቦንቹዋባ ሃሳያና፤</para>
  <para style="q2" vid="PSA 145:11">ነ ዎልቃባ ኦዳና።<verse eid="PSA 145:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12"/>ሄዌነ፥ ነ ዎልቃማ ኦሱዋባነ</para>
  <para style="q2" vid="PSA 145:12">ነ ካዉተ ቦንቹዋ አንጋባ</para>
  <para style="q2" vid="PSA 145:12">አሳ ኤርሳና።<verse eid="PSA 145:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13"/>ነ ካዉተይ መና ካዉተ፤</para>
  <para style="q2" vid="PSA 145:13">ነ ማታይ የለታ ኡባ ጋካናሳ።</para>
  <para style="b" vid="PSA 145:13"/>
  <para style="q1" vid="PSA 145:13">መና ጎዳይ ባረ ጌዳ ቃላዉ ኡባዉ አማነትያዋ፤</para>
  <para style="q2" vid="PSA 145:13">እ ባረ ኦሱዋ ኡባን ቃረትያዋ።<verse eid="PSA 145:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14"/>መና ጎዳይ ሆኬዳዋንታ ኡባ ዘምፕሴ፤</para>
  <para style="q2" vid="PSA 145:14">ኩንዴዳዋንታ ኡባ ደን።<verse eid="PSA 145:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15"/>ኡባ አይፊ ኔኮ ጼሌ፤</para>
  <para style="q2" vid="PSA 145:15">ኡንቱንታ ኮሽያ ዎድያን ኔን ኡንቱንቶ ቁማ እማሳ።<verse eid="PSA 145:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16"/>ኔን ነ ኩሽያፐ እማ፤</para>
  <para style="q2" vid="PSA 145:16">ፓጻ ደእያዋንታ ኡባ አሙዋ አላ።<verse eid="PSA 145:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17"/>መና ጎዳይ ባረ ኦግያን ኡባን ጽሉዋ፤</para>
  <para style="q2" vid="PSA 145:17">እ ባረ ኦሱዋ ኡባን ቃረትያዋ።<verse eid="PSA 145:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18"/>መና ጎዳይ ባረና ጼስያ ኡባዉ፥</para>
  <para style="q2" vid="PSA 145:18">ቱሙዋን ባረና ጼስያ ኡባዉ ማታን ደኤ።<verse eid="PSA 145:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19"/>እ ባረዉ ያይያዋንቱ ኡባዉ፥</para>
  <para style="q2" vid="PSA 145:19">አሙዋ ኩን።</para>
  <para style="q1" vid="PSA 145:19">ቃይ እ ኡንቱንቱ ዋሱዋ ስሲደ፥</para>
  <para style="q2" vid="PSA 145:19">ኡንቱንታ አሼ።<verse eid="PSA 145:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20"/>መና ጎዳይ ባረና ሲቅያዋንታ ኡባ ናጌ፤</para>
  <para style="q2" vid="PSA 145:20">ሽን ኢታቱዋ ኡባ ይሳና።<verse eid="PSA 145:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21"/>ታን ታ ዶናን መና ጎዳ ጋላታና።</para>
  <para style="q2" vid="PSA 145:21">መታ ኡባይ አ ጌሻ ሱን</para>
  <para style="q2" vid="PSA 145:21">መ መናዉ ጋላቶ!<verse eid="PSA 145:21"/></para>
  <chapter eid="PSA 145"/>
  <chapter number="146" style="c" sid="PSA 146"/>
  <para style="s1">ማዳ ጾሳዉ ጋላታ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1"/>መና ጎዳ ጋላትተ!</para>
  <para style="b" vid="PSA 146:1"/>
  <para style="q2" vid="PSA 146:1">ታ ሸምፓቴ መና ጎዳ ጋላታ!<verse eid="PSA 146:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2"/>ታ ደኡዋ ላይ ኡባን፥</para>
  <para style="q2" vid="PSA 146:2">ታን መና ጎዳ ጋላታና፤</para>
  <para style="q2" vid="PSA 146:2">ታን ደኤዳ ኬናን ኡባን</para>
  <para style="q2" vid="PSA 146:2">ታ ጾሳ ሳባና።<verse eid="PSA 146:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3"/>አሳይ አሻናዉ ዳንዳየና ድራዉ፥</para>
  <para style="q2" vid="PSA 146:3">አሳ ካፓቱዋን አማነቶፕተ።<verse eid="PSA 146:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4"/>ኡንቱንቱ ሸምፑ ከስያ ዎደ፥</para>
  <para style="q2" vid="PSA 146:4">ኡንቱንቱ ቢታዉ ስሚኖ፤</para>
  <para style="q2" vid="PSA 146:4">ኡንቱንቱ ሀልቹ ኡባይ</para>
  <para style="q2" vid="PSA 146:4">ሄ ጋላስካ አት አጌ።<verse eid="PSA 146:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5"/>ያቆባ ጾሳይ ማድያ ኡራይነ</para>
  <para style="q2" vid="PSA 146:5">መና ጎዳ ባረ ጾሳ ባረዉ ህዶታ ኦያ ኡራይ፥</para>
  <para style="q2" vid="PSA 146:5">አንጀቴዳዋ።<verse eid="PSA 146:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6"/>መና ጎዳይ ሳሉዋነ ሳኣ፥</para>
  <para style="q2" vid="PSA 146:6">ዎልቃማ አባነ አ ግዶን ደእያዋ ኡባ፥</para>
  <para style="q2" vid="PSA 146:6">መዳዋ፤<note caller="-" style="x"><char style="xo" closed="false">146:6 </char><char style="xt" closed="false"><ref loc="ACT 4:24">ኪታ 4:24</ref>፤ <ref loc="ACT 14:15">14:15</ref></char></note></para>
  <para style="q2" vid="PSA 146:6">እ መናዉካ አማነትያዋ።<verse eid="PSA 146:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7"/>እ ናቀቴዳዋንቶ ፕርድያዋ፤</para>
  <para style="q2" vid="PSA 146:7">ኮሻቴዳዋንቶ ቁማ እምያዋ።</para>
  <para style="b" vid="PSA 146:7"/>
  <para style="q1" vid="PSA 146:7">መና ጎዳይ ቃሸቴዳዋንታ ብሌ፤<verse eid="PSA 146:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 146:8"/>መና ጎዳይ ቆቀቱዋ ጼልሴ።</para>
  <para style="q2" vid="PSA 146:8">መና ጎዳይ ኩንዴዳዋንታ ደን፤</para>
  <para style="q1" vid="PSA 146:8">መና ጎዳይ ጽሎቱዋ ሲቄ።<verse eid="PSA 146:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9"/>መና ጎዳይ በተቱዋ ናጌ።</para>
  <para style="q2" vid="PSA 146:9">አምኤቱዋነ አዉ ባይና ናናቱዋ ማዴ፤</para>
  <para style="q2" vid="PSA 146:9">ሽን ኢታቱዋ ኦግያ ባለ።<verse eid="PSA 146:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10"/>መና ጎዳይ መናዉ ካተቴ።</para>
  <para style="q2" vid="PSA 146:10">ጽዮኔ፥ ነ ጾሳይ፥</para>
  <para style="q2" vid="PSA 146:10">የለታፐ የለታ ጋካናዉ ካተታና።</para>
  <para style="b" vid="PSA 146:10"/>
  <para style="q2" vid="PSA 146:10">መና ጎዳ ጋላትተ!<verse eid="PSA 146:10"/></para>
  <chapter eid="PSA 146"/>
  <chapter number="147" style="c" sid="PSA 147"/>
  <para style="s1">ኡባ ዳንዳይያ ጾሳዉ ሺቅያ ጋላታ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1"/>መና ጎዳ ጋላትተ! ኑ ጾሳ ሳቢያዌ ሎአ፤</para>
  <para style="q2" vid="PSA 147:1">አ ሳቢያዌ ናሸችያባነ በስያዋ።<verse eid="PSA 147:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2"/>መና ጎዳይ የሩሳላመ ኦራና፤</para>
  <para style="q2" vid="PSA 147:2">እስራኤልያ አሳቱዋፐ በቴዳዋንታካ ሺሻና።<verse eid="PSA 147:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3"/>ዎዛናይ መኤዳዋንታ እ ፓ፤</para>
  <para style="q2" vid="PSA 147:3">ኡንቱንቱ ማዱካ እ ቃቼ።<verse eid="PSA 147:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4"/>እ ጾልንተቱዋ</para>
  <para style="q2" vid="PSA 147:4">ኡንቱንቱ ፓይዱዋን ኤሬ፤</para>
  <para style="q2" vid="PSA 147:4">ኡንቱንታ ኡባካ ኡንቱንቱ ሱንን ሱንን ጼሴ።<verse eid="PSA 147:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5"/>ኑ ጎዳይ ዎልቃማ፤ አ ዎልቃይ ዳራ፤</para>
  <para style="q2" vid="PSA 147:5">አ አኬካይ ልክያፐ አያዋ።<verse eid="PSA 147:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6"/>መና ጎዳይ ናቀቴዳዋንታ ዘምፕሴ፤</para>
  <para style="q2" vid="PSA 147:6">ሽን ኢታቱዋ ቢታን ዱገ ኦሌ።<verse eid="PSA 147:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7"/>መና ጎዳዉ ጋላታ የ የጽተ፤</para>
  <para style="q2" vid="PSA 147:7">ኑ ጾሳዉ ዲ ዲጽተ።<verse eid="PSA 147:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8"/>እ ሳሉዋ ሻርያ ካሜ፤</para>
  <para style="q2" vid="PSA 147:8">ሳአዉ እራ ቡክሴ፤</para>
  <para style="q2" vid="PSA 147:8">ቄሪ ደረቱዋ ቦላ ማታ ሞክሴ።<verse eid="PSA 147:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9"/>መሄቶነ ዋስያ ቁሩዋ ማራቶ፥</para>
  <para style="q2" vid="PSA 147:9">ምያዋ እ እሜ።<verse eid="PSA 147:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10"/>እ ናሸትያዌ ፓራቱዋ ዎልቃንነ፥</para>
  <para style="q2" vid="PSA 147:10">ቶራንቻቱ ምኖተን ግደና።<verse eid="PSA 147:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11"/>መና ጎዳይ ባረዉ ያይያዋንቱንነ</para>
  <para style="q2" vid="PSA 147:11">አገና አ ሲቁዋን፥</para>
  <para style="q2" vid="PSA 147:11">ባረንቱ ህዶታ ዎዳዋንቱን ናሸቴ።<verse eid="PSA 147:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12"/>የሩሳላመ ካታማቴ፥ መና ጎዳ ጋላታ!</para>
  <para style="q2" vid="PSA 147:12">ጽዮኔ፥ ነ ጾሳ ጋላታ!<verse eid="PSA 147:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13"/>አያዉ ጎፐ፥ እ፥</para>
  <para style="q2" vid="PSA 147:13">ነ ፐንግያ ኩልባቱዋ ምንሴ፤</para>
  <para style="q2" vid="PSA 147:13">ነ ግዶን ደእያ ነ አሳካ አንጄ።<verse eid="PSA 147:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14"/>እ ነ ዛዋ ሳሮተን ናጌ፤</para>
  <para style="q2" vid="PSA 147:14">ኔና ሎይ ሎእያ ዛርጋ ካልሴ።<verse eid="PSA 147:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15"/>እ ባረ ኪታ ሳአዉ ኪቴ፤</para>
  <para style="q2" vid="PSA 147:15">አ ቃላይካ ኤለ ጋኬ።<verse eid="PSA 147:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16"/>እ ሻቻ ቡሉኩዋዳን ምጬ፤</para>
  <para style="q2" vid="PSA 147:16">ከተርሳ ብድንዳን ላሌ።<verse eid="PSA 147:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17"/>እ ባረ ዎልቃማ ሻቻ</para>
  <para style="q2" vid="PSA 147:17">ሹቻዳን ዱገ ኦሌ።</para>
  <para style="q1" vid="PSA 147:17">ሄ ሜጉዋን ኤቃናዉ ኦንነ ዳንዳየና።<verse eid="PSA 147:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18"/>እ ባረ ቃላ ኪቲደ፥</para>
  <para style="q2" vid="PSA 147:18">ሻቻ ሙሽሴ።</para>
  <para style="q1" vid="PSA 147:18">እ ጫርኩዋ ጫርክስና፥ ሃይ ጎጌ።<verse eid="PSA 147:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19"/>እ ባረ ቃላ ያቆባ ዘረዉ፥</para>
  <para style="q2" vid="PSA 147:19">ባረ አዋዩዋነ ፕርዳ</para>
  <para style="q1" vid="PSA 147:19">እስራኤልያ አሳዉ አዋዬ።<verse eid="PSA 147:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20"/>እ ሀራ ካዉተ አሳዉ፥</para>
  <para style="q2" vid="PSA 147:20">ሀዋ ኦቤና፤</para>
  <para style="q2" vid="PSA 147:20">ኡንቱንቱ አ ፕርዳ ኤርክኖ።</para>
  <para style="b" vid="PSA 147:20"/>
  <para style="q2" vid="PSA 147:20">መና ጎዳ ጋላትተ!<verse eid="PSA 147:20"/></para>
  <chapter eid="PSA 147"/>
  <chapter number="148" style="c" sid="PSA 148"/>
  <para style="s1">መታይ ኡባይ ጾሳ ጋላቶ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1"/>መና ጎዳ ጋላትተ!</para>
  <para style="b" vid="PSA 148:1"/>
  <para style="q2" vid="PSA 148:1">ሳሎቱዋን ደእያዋንቶ፥ መና ጎዳ ጋላትተ፤</para>
  <para style="q3" vid="PSA 148:1">ቦላ ቃን ደእያዋንቶ፥ አ ጋላትተ።<verse eid="PSA 148:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2"/>ህንተኖ፥ አ ኪታንቻቶ፥</para>
  <para style="q2" vid="PSA 148:2">ኡባቱ አ ጋላትተ።</para>
  <para style="q1" vid="PSA 148:2">ሳሉዋን ደእያ አ ኦላንቻቶ፥</para>
  <para style="q2" vid="PSA 148:2">ኡባቱ አ ጋላትተ።<verse eid="PSA 148:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3"/>አዋዉ፥ አግናዉ፥ አ ጋላትተ፤</para>
  <para style="q2" vid="PSA 148:3">ፖእያ ጾልንተቶ፥ ኡባቶ አ ጋላትተ።<verse eid="PSA 148:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4"/>ህንተኖ፥ ኡባፐ ቦላ ቃን ደእያ ሳሎቶ፥</para>
  <para style="q2" vid="PSA 148:4">አ ጋላትተ።</para>
  <para style="q1" vid="PSA 148:4">ሳሉዋፐ ቦላና ደእያ ሃቶ፥</para>
  <para style="q2" vid="PSA 148:4">አ ጋላትተ።<verse eid="PSA 148:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5"/>ኡንቱንቱ ኡባቱ መና ጎዳ ሱን ጋላትኖ፤</para>
  <para style="q2" vid="PSA 148:5">አያዉ ጎፐ፥ እ አዛዝና፥</para>
  <para style="q1" vid="PSA 148:5">ኡንቱንቱ ኡባይካ መቴድኖ።<verse eid="PSA 148:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6"/>እ ኡንቱንታ መ መናዉ</para>
  <para style="q2" vid="PSA 148:6">ኡንቱንቱ ሳኣን ሳኣን ዎዳ።</para>
  <para style="q1" vid="PSA 148:6">ኡንቱንቱ ኡባካ እጻናዉ ዳንዳየና አዛዙዋ እ ኡንቱንቶ እሜዳ።<verse eid="PSA 148:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7"/>ሳኣን ደእያዋንቶ፥ መና ጎዳ ጋላትተ!</para>
  <para style="q2" vid="PSA 148:7">አባን ደእያ መታቶ፥ ዎልቃማ አባ ጪማቶ፥</para>
  <para style="q2" vid="PSA 148:7">ኡባቱካ አ ጋላትተ።<verse eid="PSA 148:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8"/>ህንተኖ፥ ዋልቃንዉ፥</para>
  <para style="q2" vid="PSA 148:8">ሻቻዉ፥ ሻርያዉ፥ ጫጋናዉ፥</para>
  <para style="q1" vid="PSA 148:8">አ አዛዙዋ ፖልያ ጎትያዉ፥</para>
  <para style="q2" vid="PSA 148:8">ኡባቱካ አ ጋላትተ።<verse eid="PSA 148:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9"/>ህንተኖ፥ ደረቶ፥ ዞዘቶ፥</para>
  <para style="q2" vid="PSA 148:9">ምያ አይፍያ አይፍያ ምቶ፥ ዝጋቶ፥</para>
  <para style="q2" vid="PSA 148:9">ኡባቱካ አ ጋላትተ።<verse eid="PSA 148:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10"/>መሄቶ፥ ዶአቶ፥</para>
  <para style="q2" vid="PSA 148:10">ሳኣና ጎሸትያ መታቶ፥</para>
  <para style="q2" vid="PSA 148:10">ፓልያ ካፎቶ፥</para>
  <para style="q2" vid="PSA 148:10">ኡባቱካ አ ጋላትተ።<verse eid="PSA 148:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11"/>ሳኣ ካተቶ፥ ካዉተ አሳቶ፥</para>
  <para style="q2" vid="PSA 148:11">ካፓቶ፥ አሳ ሞድያዋንቶ፥</para>
  <para style="q1" vid="PSA 148:11">ኡባቱካ አ ጋላትተ።<verse eid="PSA 148:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12"/>ዎዳላቶ፥ ዎዶራቶ፥</para>
  <para style="q2" vid="PSA 148:12">ጭማቶ፥ ናናቶ፥</para>
  <para style="q1" vid="PSA 148:12">ኡባቱካ አ ጋላትተ!<verse eid="PSA 148:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13"/>ኡንቱንቱ ኡባቱ መና ጎዳ ሱን ጋላትኖ፤</para>
  <para style="q2" vid="PSA 148:13">አያዉ ጎፐ፥ አ ሱንይ ኡባፐ ቦላና ደእያዋ፤</para>
  <para style="q1" vid="PSA 148:13">አ ቦንቹ ሳሎቱዋፐካ ሳኣፐካ ቦላና ቃን ደኤ።<verse eid="PSA 148:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14"/>አ ባጋ ግድያ፥ አዉ ማታትያ እስራኤልያ አሳቱ፥</para>
  <para style="q2" vid="PSA 148:14">አ ጋላታና ማላ፥ እ ኡንቱንታ ምንሴ።</para>
  <para style="b" vid="PSA 148:14"/>
  <para style="q1" vid="PSA 148:14">መና ጎዳ ጋላትተ!<verse eid="PSA 148:14"/></para>
  <chapter eid="PSA 148"/>
  <chapter number="149" style="c" sid="PSA 149"/>
  <para style="s1">ጾኑዋ ማዝሙርያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1"/>መና ጎዳ ጋላትተ! መና ጎዳዉ ኦራ የ የጽተ!</para>
  <para style="q2" vid="PSA 149:1">አማንያዋንቱ ሺቁዋን አ ሳቢተ!<verse eid="PSA 149:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2"/>እስራኤልያ አሳቱ</para>
  <para style="q2" vid="PSA 149:2">ባረንታ መዳዋን ናሸትኖ።</para>
  <para style="q1" vid="PSA 149:2">ጽዮነ አሳቱ ባረንቱ ካትያን ሎይ ናሸትኖ።<verse eid="PSA 149:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3"/>ዱሪደ፥ ካራቡዋ ባቂደነ፥</para>
  <para style="q2" vid="PSA 149:3">ዲ ዲጺደ፥ አ ሱን ሳቢኖ።<verse eid="PSA 149:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4"/>አያዉ ጎፐ፥ ጾሳይ ባረ አሳን ናሸቴ፤</para>
  <para style="q2" vid="PSA 149:4">ናቀቴዳዋንቶ ጾኑዋ እሚደ፥</para>
  <para style="q1" vid="PSA 149:4">እ ኡንቱንታ ቦንቼ።<verse eid="PSA 149:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5"/>አሳቱ ባረንቱ ጾኑዋን ናሸትኖ፤</para>
  <para style="q2" vid="PSA 149:5">ቃማን ኡባን ናሸቻዉ የጽኖ።<verse eid="PSA 149:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6"/>ኡንቱንቱ ዶናን ጾሳ ጋላታይ፥</para>
  <para style="q2" vid="PSA 149:6">ኡንቱንቱ ኩሽያንካ ላኡ ባጋ ኩሳ ማሻይ ደኦ።<verse eid="PSA 149:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7"/>ሄዌካ፥ ኡንቱንቱ ካዉተቶ፥</para>
  <para style="q2" vid="PSA 149:7">ሀሉዋ ከሳናሳነ አሳቱዋ ሙራናሳ።<verse eid="PSA 149:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8"/>ኡንቱንቱ ካተቱዋ ሳንሳላታን፥</para>
  <para style="q2" vid="PSA 149:8">ኡንቱንቱ ኦላ ጋዳዋቱዋካ ብራታን ቃቻናሳነ፥<verse eid="PSA 149:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9"/>ኡንቱንቱ ቦላ ጻፈቴዳ ፕርዳ ፖላናሳ።</para>
  <para style="q2" vid="PSA 149:9">ሄዌ ጾሳ አሳቱዋ ኡባዉ ጾኑዋ።</para>
  <para style="b" vid="PSA 149:9"/>
  <para style="q1" vid="PSA 149:9">መና ጎዳ ጋላትተ!<verse eid="PSA 149:9"/></para>
  <chapter eid="PSA 149"/>
  <chapter number="150" style="c" sid="PSA 150"/>
  <para style="s1">ጾሳ ጋላትተ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1"/>መና ጎዳ ጋላትተ!</para>
  <para style="b" vid="PSA 150:1"/>
  <para style="q2" vid="PSA 150:1">አ ጌሻ ሳኣን ጾሳ ጋላትተ፤</para>
  <para style="q3" vid="PSA 150:1">አ ዎልቃማ ሳሉዋን አ ጋላትተ።<verse eid="PSA 150:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2"/>አ ዎልቃማ ኦሳቱዋ ድራዉ፥ አ ጋላትተ፤</para>
  <para style="q2" vid="PSA 150:2">ኡባፐ አያ አ ግታተዳን አ ጋላትተ።<verse eid="PSA 150:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3"/>ማላካታ ፑኒደ፥ አ ጋላትተ፤</para>
  <para style="q2" vid="PSA 150:3">ዲነ ማስንቁዋ ዲጺደ፥</para>
  <para style="q1" vid="PSA 150:3">አ ጋላትተ።<verse eid="PSA 150:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4"/>ዳርቢያ ባቂደነ ዱሪደ፥</para>
  <para style="q2" vid="PSA 150:4">አ ጋላትተ፤</para>
  <para style="q1" vid="PSA 150:4">ዲ ዲጺድነ ሎኩዋ ፑኒደ፥ አ ጋላትተ።<verse eid="PSA 150:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5"/>ዳዋላ ቃደ፥ አ ጋላትተ፤</para>
  <para style="q2" vid="PSA 150:5">ዳዋላ ሾጪደ፥ አ ጋላትተ።<verse eid="PSA 150:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6"/>ፓጻ ሸምፓቱ ኡባቱ፥</para>
  <para style="q2" vid="PSA 150:6">መና ጎዳ ጋላትኖ!</para>
  <para style="b" vid="PSA 150:6"/>
  <para style="q1" vid="PSA 150:6">መና ጎዳ ጋላትተ!<verse eid="PSA 150:6"/></para>
  <chapter eid="PSA 150"/>
</usx>
