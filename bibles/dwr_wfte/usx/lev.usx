<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LEV" style="id">- Dawuro Full Bible Ethiopic Version</book>
  <para style="h">ዎጋ</para>
  <para style="toc1">ዎጋ ማጻፋ</para>
  <para style="toc2">ዎጋ</para>
  <para style="toc3">ዎጋ</para>
  <para style="mt1">ዎጋ ማጻፋ</para>
  <para style="imt">ገሉዋ</para>
  <para style="ip">“ዎጋ ማጻፋይ” በን እስራኤልያ ጋድያን ደእያ ጎይና ዎጋነ አማኑዋ ትምርትያን አሳይ አቅያ ማራቱዋ ኦዴ። ሄዋዳንካ ቃይ ሀ ዎጋቱዋነ ሀ ማራቱዋ ኦሱዋን ፔሽያ አዎተይ ደእያ ቄሳቱዋባ ኦዴ።</para>
  <para style="ip">ማጻፋዉ ሁጰ ቆፋይ ጾሳ ጌሻተ ኦድያዋ። ቃይካ ጾሳዉ ያርሹዋ አዩሳን ጾሳና ደእያ እትፐተ ናጊደ፥ ጾሳዉነ ኡንቱንቶ ደእያ ጫቁዋና ኦይቀቴዳ ብለይ ደእያ ዎጋ እሞዋ በሴ። ጉጂደካ ጾሳ አሳይ ሀ ጌሻ ግዴዳ እስራኤልያ ጾሳና ኡንቱንቶ ማታ ጋከይ ደአና ማላ፥ ኡንቱንቱ ዋኒደ አዉ ጎይናናዉ በስንቶ ኦዴ።</para>
  <para style="ip">ማጻፋ ግዶን ዳሮ ኤረቴዳ አዛዙ፥ የሱስ ላኤን ዎልቃማ አዛዙዋ ጊደ ሱንዳ አዛዙዋ። ሄዌነ ሸምፑዋ 19 ፓይዱዋ 18 ቤትያዋ፤ እካ፥ “አሳ ኡባ ነ ሁጲያዳን ዶሳ” ያግያዋ።</para>
  <para style="iot">ሸምፓቱዋ ኡባቶ እመቴዳ ቃን ቆፋቱዋ</para>
  <para style="io1">እሞታነ ያርሹዋ <char style="ior"><ref loc="LEV 1:1-7:38">1:1—7:38</ref></char></para>
  <para style="io1">አሮነነ አ ናናቱ ቄሰ ግድይያ ዎጋነ ኡንቱንቱ ኦሱዋ <char style="ior"><ref loc="LEV 8:1-10:20">8:1—10:20</ref></char></para>
  <para style="io1">ጌይያ ዎጋን ጌሻ ግድያዋነ ግደናዋ ሻኩሳ <char style="ior"><ref loc="LEV 11:1-15:33">11:1—15:33</ref></char></para>
  <para style="io1">ናጋራይ አቶ ጌተትያ ጋላሳ <char style="ior"><ref loc="LEV 16:1-34">16:1-34</ref></char></para>
  <para style="io1">ደኡዋ ጌሻተነ ጎይኑዋ ዎጋ <char style="ior"><ref loc="LEV 17:1-27:34">17:1—27:34</ref></char></para>
  <chapter number="1" style="c" sid="LEV 1"/>
  <para style="ms">እሞታነ ያርሹዋ</para>
  <para style="mr">(<ref loc="LEV 1:1-7:38">1:1—7:38</ref>)</para>
  <para style="s1">ጹግያ ያርሹዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 1:1"/>መና ጎዳና ጋከትያ ዱንካንያ ግዶፐ መና ጎዳይ ሙሳ ጼሲደ፥ ሀዋዳን ያጊደ ሃሳዬዳ፤ <verse eid="LEV 1:1"/><verse number="2" style="v" sid="LEV 1:2"/>“እስራኤልያ አሳዉ ሀዋዳን ያጋደ ኦዳ፤ ‘ህንተፐ ኦንነ መና ጎዳዉ ያርሹዋ ሺሽያ ዎደ፥ ሄ ባረ ሺሽያ ያርሹዋ ባረ መህያፐ ዎይ ባረ ዶርሳ ዎይ ዴሻ ዉድያፐ አሆ። <verse eid="LEV 1:2"/><verse number="3" style="v" sid="LEV 1:3"/>ሄ ያርሹ መህያ ዉድያፐ ጹግያ ያርሹዋ ግዶፐ፥ አቱማዋ ግዲደ፥ ትላ ቦላና ደእያዋ ግዶ። መና ጎዳይ አካና ማላ፥ እ ሄ ያርሹዋ መና ጎዳ ዱንካንያ ገልያ ፐንግያን ያርሾ። <verse eid="LEV 1:3"/><verse number="4" style="v" sid="LEV 1:4"/>ያርሹዋ ሺሽያ ብታኒ ጹጊደ ያርሻናዉ አሄዳ ባረ መህያ ሁጲያን ባረ ኩሽያ ዎ። ሄዌ አ ናጋራ አቶ ጋናዉ ጾሳይ አኬዳ ያርሹዋ ግዳናዋ። <verse eid="LEV 1:4"/><verse number="5" style="v" sid="LEV 1:5"/>እ ኮሩማ መና ጎዳ ስንን ሹክና፤ አሮና ናናይ ቄሳቱ ሄ ሱ አሂደ፥ መና ጎዳ ዱንካንያ ገልያ ፐንግያን ደእያ ያርሽያ ሳኣ ምይያ ኡባን ጉስኖ። <verse eid="LEV 1:5"/><verse number="6" style="v" sid="LEV 1:6"/>ሄዋፐ ጉይያን፥ እ ጹግያ ያርሾ መህያ ጋልባ ቃሮ፤ አሹዋ አ ቆሙዋን ቆሙዋን ከሶ። <verse eid="LEV 1:6"/><verse number="7" style="v" sid="LEV 1:7"/>ቄስያ አሮና ናናይ ያርሽያ ሳኣ ቦላን ታማ ኤደ፥ ም ዎኖ። <verse eid="LEV 1:7"/><verse number="8" style="v" sid="LEV 1:8"/>ሄዋፐ ጉይያን፥ አሮና ናናይ ቄሳቱ ሄ ከሴዳ አሹዋ ሁጲያነ ሞዋ ጉጂደ፥ ያርሽያ ሳኣ ቦላን ታማን ደእያ ም ቦላን ማሪደ ዎኖ። <verse eid="LEV 1:8"/><verse number="9" style="v" sid="LEV 1:9"/>ሽን ሄ ብታኒ ቃን አሹዋነ ገደቱዋ ሃን ሜጮ። ያቲደ ቄሲ ሄዋ ኡባካ አሂደ፥ ያርሽያ ሳኣ ቦላ ጹጎ፤ ሄዌ መና ጎዳዉ ታማን ጹግያ፥ ሳዉዋ ቶሹኩ ግያ ያርሹዋ ግዳናዋ።<verse eid="LEV 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 1:10"/>“ ‘ጹግያ ያርሾ እ እምያ እሙ ዶርሳ ዉድያፐ ዎይ ዴሻ ዉድያፐ አከትያዋ ግዶፐ፥ አቱማዋ ግዲደ፥ ትላ ቦላና ደእያዋ ግዶ። <verse eid="LEV 1:10"/><verse number="11" style="v" sid="LEV 1:11"/>ሄ መህያ ያርሽያ ሳኣፐ ሁጲሳ ባጋና መና ጎዳ ስንን ሹኮ። አሮና ናናይ ቄሳቱ አ ሱ አኪደ፥ ያርሽያ ሳኣ ምይያ ኡባ ቦላን ጉስኖ። <verse eid="LEV 1:11"/><verse number="12" style="v" sid="LEV 1:12"/>ሄዋፐ ጉይያን፥ ሄ ብታኒ አ ቆሙዋን ቆሙዋን ከሴዳ አሹዋ ኡባ ቄሲ አኪደ፥ ሁጲያነ ሞዋ ጉጂደ፥ ያርሽያ ሳኣ ቦላን ታማን ደእያ ም ቦላን ዎ። <verse eid="LEV 1:12"/><verse number="13" style="v" sid="LEV 1:13"/>ሽን ቃን አሹዋነ ገደቱዋ ሃን ሜጮ፤ ያቲደ ቄሲ ሄዋ ኡባ አሂደ ያርሽያ ሳኣ ቦላን ጹጎ፤ ሄዌ መና ጎዳዉ ታማን ጹግያ፥ ሳዉዋ ቶሹኩ ግያ ያርሹዋ ግዳናዋ።<verse eid="LEV 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 1:14"/>“ ‘መና ጎዳዉ ያርሽያ ጹግያ ያርሹ ካፉዋ ግዶፐ፥ ሀራጵያ ማራ፥ ዎይ ዶጎሙዋ አሆ። <verse eid="LEV 1:14"/><verse number="15" style="v" sid="LEV 1:15"/>ቄሲ ሄዋ አኪደ፥ ቆያ ምርቆ፤ ያቲደ ያርሽያ ሳኣ ቦላን ደእያ ታማን ጹጎ። አ ሱይ ያርሽያ ሳኣ ቦላፐ ምይያና ዱገ ጎግ ጭንጎ፤ <verse eid="LEV 1:15"/><verse number="16" style="v" sid="LEV 1:16"/>ኡሎ ግዱዋ ባለቱዋና ከሲደ፥ ያርሽያ ሳኣፐ አዋይ ዶልያ ባጋና፥ ብድን ቆልያ ሳኣን ኦሎ። <verse eid="LEV 1:16"/><verse number="17" style="v" sid="LEV 1:17"/>እ ሄ ካፉዋ ቀፈቱዋ ኦይቂደ ጳልቆ፥ ሽን ኡባና ዳኮፖ። ሄዋፐ ጉይያን፥ ቄሲ ያርሽያ ሳኣ ቦላን ደእያ ታማን ዎደ ጹጎ፤ ሄዌ መና ጎዳዉ ታማን ጹግያ፥ ሳዉዋ ቶሹኩ ግያ ያርሹዋ ግዳናዋ።<verse eid="LEV 1:17"/></para>
  <chapter eid="LEV 1"/>
  <chapter number="2" style="c" sid="LEV 2"/>
  <para style="s1">ካ ያርሹዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 2:1"/>“ ‘ኦንነ ካ ያርሹዋ መና ጎዳዉ ሺሽያ ዎደ፥ ሄ ያርሹ ሊቆ ልያ ግዶ፤ አ ቦላ ዎጋራ ዛይትያነ እጻና ጉጆ። <verse eid="LEV 2:1"/><verse number="2" style="v" sid="LEV 2:2"/>ሄዋ እ አሮና ናናቱዋኮ ቄሳቱዋኮ አሆ፤ ቄሳቱ ሄ ሊቆ ልያፐነ ዛይትያፐ እት ኩሽያ ኩን አኪደ፥ እጻና ኡባና አክ፥ ሀሳይስያዋ ኦደ፥ ያርሽያ ሳኣ ቦላ ታማን ጹጎ። ሄዌ መና ጎዳዉ ታማን ጹግያ፥ ሳዉዋ ቶሹኩ ግያ ያርሹዋ ግዳናዋ። <verse eid="LEV 2:2"/><verse number="3" style="v" sid="LEV 2:3"/>ካ ያርሹዋፐ አቴዳዌ አሮናሳነ አ ናናቱዋሳ። ሄዌ መና ጎዳዉ ታማን ጹገትያ ጌሻ ያርሹዋ ኡባፐ እቱዋ ግዴዳ ጌሻ ያርሹዋ።<verse eid="LEV 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 2:4"/>“ ‘ያርሾ ሺሽያ ኡክይ ጮጭያን ካኤዳዋ ግዶፐ፥ ዛይትያን ሙናቄዳ ሊቆ ልያፐ ኡከቴዳ እርሹ የገትቤና ኮምፖ፥ ዎይ ዛይትያን ኦከቴዳ፥ እርሹ የገትቤና ሌኦ ኡክ ግዶ።<verse eid="LEV 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 2:5"/>“ ‘ያርሾ ሺሽያ ኡክይ ባሽያን ኡከቴዳዋ ግዶፐ፥ ዛይትያን ሙናቄዳ፥ እርሹ ባይና፥ ሊቆ ልያፐ ጊጌዳዋ ግዶ። <verse eid="LEV 2:5"/><verse number="6" style="v" sid="LEV 2:6"/>አ መንደ አ ቦላ ዛይትያ ትጎ፤ ሄዋ ካ ያርሹዋ ኦደ ሺሾ።<verse eid="LEV 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 2:7"/>“ ‘ነ ያርሾ ሺሽያ ካ ያርሹ ድስትያን ካኤዳዋ ግዶፐ፥ ዛይትያን ሙናቄዳ ሊቆ ልያፐ ካኤዳዋ ግዶ። <verse eid="LEV 2:7"/><verse number="8" style="v" sid="LEV 2:8"/>ሀዋዳን ጊግሴዳ ካ ያርሹዋ መና ጎዳዉ አሀ፤ ቄስያዉ እማ። ቄሲ ሄዋ አኪደ ያርሽያ ሳኣ ሺሾ። <verse eid="LEV 2:8"/><verse number="9" style="v" sid="LEV 2:9"/>ቄሲ ሄ ካ ያርሹዋፐ አኪደ፥ ሀሳይስያዋ ኦደ፥ ያርሽያ ሳኣ ቦላን ጹግያ ያርሹዋዳን ታማን ጹጎ፤ ሄዌ መና ጎዳዉ ታማን ጹግያ፥ ሳዉዋ ቶሹኩ ግያ ያርሹዋ ግዳናዋ። <verse eid="LEV 2:9"/><verse number="10" style="v" sid="LEV 2:10"/>ካ ያርሹዋፐ አቴዳዌ አሮነሳነ አ ናናቱዋሳ። ሄዌ መና ጎዳዉ ታማን ጹጌዳ፥ ጌሻ ያርሹዋ ኡባፐ እቱዋ ግዴዳ ጌሻ ያርሹዋ።<verse eid="LEV 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 2:11"/>“ ‘ጾሳዉ ህንተ አህያ አይ ካ ያርሹነ እርሹዋና ደእያዋ ግዶፖ፤ አያዉ ጎፐ ኔን እርሹዋ ዎይ ኤሳ እልሉዋ ጾሳዉ ታማን ጹጋደ ያርሻናዉ ኮሸና። <verse eid="LEV 2:11"/><verse number="12" style="v" sid="LEV 2:12"/>ህንተ ላይን ላይን ጫከትያ ካፐ ጼራ ከሲደ፥ ጾሳዉ አሀናዉ ዳንዳዪታ፤ ሽን ሄዋ ሳዉዋ ቶሹኩ ግያ ያርሹዋ ኦደ፥ ጾሳዉ ያርሽያ ሳኣ ቦላን ጹገተና። <verse eid="LEV 2:12"/><verse number="13" style="v" sid="LEV 2:13"/>ኔን ሺሽያ ካ ያርሹዋ ኡባን ማጽንያ የጋ፤ አያዉ ጎፐ፥ ነ ጾሳ ቃላ ጫቁዋ ማጽንያ አጎፓ። ሄዋ ድራዉ ነ ካ ያርሹዋ ኡባ ማጽንያን ማልኤ። <verse eid="LEV 2:13"/><verse number="14" style="v" sid="LEV 2:14"/>ኔን ኮይሮ ካፐ ጼራ ከሳደ መና ጎዳዉ አህያ ዎደ፥ ሄ ካይ ጺጸቲደ ሀርጸቴዳ ትሻ ካ ግዳናዉ ኮሼ። <verse eid="LEV 2:14"/><verse number="15" style="v" sid="LEV 2:15"/>አ ቦላ ዛይትያ ትጋ፤ እጻናካ አን ዎ፤ ሄዌ ካ ያርሹዋ። <verse eid="LEV 2:15"/><verse number="16" style="v" sid="LEV 2:16"/>ቄሲ ሄ ዛይቲ ትገቴዳ ሀርጸቴዳ ካፐ ሻኩዋ አኪደ፥ እጻና ኡባናካ ሀሳይስያዋ ኦደ ታማን መና ጎዳዉ ጹጎ።<verse eid="LEV 2:16"/></para>
  <chapter eid="LEV 2"/>
  <chapter number="3" style="c" sid="LEV 3"/>
  <para style="s1">እትፐተ ያርሹዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 3:1"/>“ ‘እት አሳይ እትፐተ ያርሾ ባረ ዉድያፐ ማጫዋ ግድና አቱማዋ ግድና እት መህያ ሺሽያ ዎደ፥ ሄ መሂ ትላ ቦላና ደእያዋ መና ጎዳ ስንን ሺሾ። <verse eid="LEV 3:1"/><verse number="2" style="v" sid="LEV 3:2"/>ያርሻናዉ አሄዳ መህያ ሁጲያን ባረ ኩሽያ ዎደ፥ ጾሳ ዱንካንያ ፐንግያን ሹኮ። ሄዋፐ ጉይያን፥ ቄሳቱ አሮና ናናይ ሱ ያርሽያ ሳኣ ምይያ ኡባ ቦላን ጉሶ። <verse eid="LEV 3:2"/><verse number="3" style="v" sid="LEV 3:3"/>እትፐተ ያርሹዋፐ ታማን ጹግያ ያርሹዋ ኦደ መና ጎዳዉ ሺሾ፤ ሄዌካ ቃን አሹዋ ማዬዳ ሀንዳ ኡባይነ አናና ጋያ ሀንዳይ፥ <verse eid="LEV 3:3"/><verse number="4" style="v" sid="LEV 3:4"/>ላኡ ክላሆቱዋ፥ ኡንቱንቱ ቦላ ደእያ ሀንዳ፥ ጋይልያ ማታን ደእያ ሀንዳነ ትርያ ጼራ ቦላ ደእያ ሀንዳ ክላሆቱዋና ጋደ አኬ። <verse eid="LEV 3:4"/><verse number="5" style="v" sid="LEV 3:5"/>አሮና አቱማ ናናይ ሄዋ ሀራ ጹግያ ያርሹዋና ያርሽያ ሳኣ ቦላ ደእያ ም ቦላ ዎደ ጹግኖ፤ ሄዌ መና ጎዳዉ ታማን ጹግያ፥ ሳዉዋ ቶሹኩ ግያ ያርሹዋ ግዳናዋ።<verse eid="LEV 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 3:6"/>“ ‘መና ጎዳዉ እትፐተ ያርሹዋ ሺሽያ ኡራይ ዶርሳ ግድና ዴሻ፥ ማጫዋ ግድና አቱማዋ ትላ ቦላና ደእያዋ ሺሾ። <verse eid="LEV 3:6"/><verse number="7" style="v" sid="LEV 3:7"/>እት ኡራይ ዶርሳ ማራ ያርሽያዋ ግዶፐ፥ መና ጎዳ ስንን ሺሾ፤ <verse eid="LEV 3:7"/><verse number="8" style="v" sid="LEV 3:8"/>ባረ ኩሽያ አ ሁጲያን ዎደ፥ ዱንካንያ ስንን ሹኮ። ሄዋፐ ጉይያን፥ አሮና አቱማ ናናይ ሱ ኦይቂደ፥ ያርሽያ ሳኣ ምይያ ኡባ ቦላን ጉስኖ። <verse eid="LEV 3:8"/><verse number="9" style="v" sid="LEV 3:9"/>እትፐተ ያርሹዋፐ ታማን ጹግያ ያርሹዋ ኦደ፥ መና ጎዳዉ ሺሾ፤ ሄዌካ፥ ዚዝያፐ ቃንጼዳ ናስያ፥ ኡሎ ግዶ አሹዋ ማዬዳ ሞያነ ሀዋንታ ጋ ኦይያ ሞያ ኡባ፥ <verse eid="LEV 3:9"/><verse number="10" style="v" sid="LEV 3:10"/>ላኡ ክላሆቱዋ፥ ኡንቱንቱ ቦላ ደእያ ሀንዳነ ጋይልያ ማታን ደእያ ሞያ፥ ትርያ ጼራ ቦላ ደእያ ሞያ ክላሆቱዋና ጋደ አኬ። <verse eid="LEV 3:10"/><verse number="11" style="v" sid="LEV 3:11"/>ቄሲ ሄ ቁማ ያርሹዋ መና ጎዳዉ ታማን ጹግያ ያርሽያ ሳኣ ቦላ ዎደ ጹጎ።<verse eid="LEV 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 3:12"/>“ ‘አ ያርሹ ዴሻ ግዶፐ፥ እ ሄዋ መና ጎዳ ስንን ሺሾ። <verse eid="LEV 3:12"/><verse number="13" style="v" sid="LEV 3:13"/>ያቲደ አ ሁጲያን ባረ ኩሽያ ዎደ፥ ጾሳ ዱንካንያ ስንን ሹኮ። ሄዋፐ ጉይያን፥ አሮና አቱማ ናናይ ሱ ኦይቂደ፥ ያርሽያ ሳኣ ዩሹዋን ኡባን ጉሲኖ። <verse eid="LEV 3:13"/><verse number="14" style="v" sid="LEV 3:14"/>እ ሄ ያርሽያዋፐ አኪደ፥ ታማን ጹግያ ያርሹዋ ኦደ መና ጎዳዉ ሺሾ፤ ሄዌካ ቃን አሹዋ ማዬዳ ሀንዳ ኡባነ ሄ ሀንዳ ጋ ኦይያ ሀራ ሀንዳ፥ <verse eid="LEV 3:14"/><verse number="15" style="v" sid="LEV 3:15"/>ላኡ ክላሆቱዋ፥ ኡንቱንቱ ቦላ ደእያ ሀንዳነ ጋይልያ ማታን ደእያ ሞያነ ትርያ ጼራ ቦላ ደእያ ሞያ ክላሆቱዋና ጋደ አኬ። <verse eid="LEV 3:15"/><verse number="16" style="v" sid="LEV 3:16"/>ቄሲ ሄ ቁማ ታማን ጹግያ፥ ሳዉዋ ቶሹኩ ግያ ያርሹዋ ኦደ ያርሽያ ሳኣ ቦላ ጹጎ። ሀንዳ ኡባይ መና ጎዳሳ።<verse eid="LEV 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 3:17"/>“ ‘ሀንዳነ ሱ ህንተ ደእያ ሳኣን ሀቃንነ ሞፕተ። ሀዌ ህንተንቶነ ህንተ የለታዉ መናዉ ናገትያ ዎጋ’ ያጋደ ኦዳ” ያጌዳ።<verse eid="LEV 3:17"/></para>
  <chapter eid="LEV 3"/>
  <chapter number="4" style="c" sid="LEV 4"/>
  <para style="s1">ቆፐናን ኦዳ ናጋራ ያርሹዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 4:1"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="LEV 4:1"/><verse number="2" style="v" sid="LEV 4:2"/>“ኔን እስራኤልያ አሳዉ ሀዋዳን ያጋደ ኦዳ፤ ‘ኦንነ ቆፐናን ናጋራ ኦፐነ፥ መና ጎዳ አዛዞቱዋፐ እቱዋ ሀቃዋነ መንፐ፥ ሀዋፐ ካሊደ ደእያ ዎጋ ናጎ።<verse eid="LEV 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 4:3"/>“ ‘ቄስያ ካፑ ናጋራ ኦፐነ ሄ ናጋራይ አሳ ባይዛንቻ ከስያዋ ግዶፐ፥ እ ባረ ኦዳ ናጋራ ድራዉ፥ ትላ ቦላና ደእያ ኮሩማ መና ጎዳዉ ናጋራ ያርሹዋ ኦደ አሆ። <verse eid="LEV 4:3"/><verse number="4" style="v" sid="LEV 4:4"/>ሄ ኮሩማ መና ጎዳ ዱንካንያ ፐንገ አደ፥ ኮሩማ ሁጲያን ባረ ኩሽያ ዎደ፥ መና ጎዳ ስንን ሹኮ። <verse eid="LEV 4:4"/><verse number="5" style="v" sid="LEV 4:5"/>ቄስያ ካፑ ኮሩማ ሱፐ አማሬዳዋ አኪደ፥ መና ጎዳ ዱንካንያ አፎ። <verse eid="LEV 4:5"/><verse number="6" style="v" sid="LEV 4:6"/>ባረ ኩሽያ ብራያ ሱን ቱሽ ቱሽ ከሲደ፥ መና ጎዳ ዱንካንያ ጋርዱዋ ስንን መና ጎዳ ስንን ላፑ ገደ ዱኮ። <verse eid="LEV 4:6"/><verse number="7" style="v" sid="LEV 4:7"/>ሄዋፐ ጉይያን፥ ቄስያ ካፑ አማሬዳ ሱ አኪደ፥ መና ጎዳ ዱንካንያ ግዶን መና ጎዳ ስንን ሳዊያ እጻና ጩውስያ ሳጽንያ ቦላ ደእያ ካጨቱዋ ቦላ ጾክሶ። አቴዳ ሱ ቃይ ጾሳ ዱንካንያ ገልያ ሳኣ ባጋና ደእያ ጹግያ ያርሹዋ ያርሽያ ሳኣፐ ጋርሳ ባጋና ደእያ ሳኣን ጉሶ። <verse eid="LEV 4:7"/><verse number="8" style="v" sid="LEV 4:8"/>ናጋራ ያርሾ ሹከቴዳ ሀ ኮሩማ ሞዋ ኡባ፥ ቃን አሹዋ ማዬዳ ሀንዳነ ኡንቱንታ ጋ ኦይያ ሞዋ፥ <verse eid="LEV 4:8"/><verse number="9" style="v" sid="LEV 4:9"/>ላኡ ክላሆቱዋ፥ ኡንቱንታ ማዬዳ ሀንዳነ ጋይልያ ማታን ደእያ ሞያነ ትርያ ጼራ ቦላ ደእያ ሞያ ክላሆቱዋና እትፐ ከሲደ አኮ። <verse eid="LEV 4:9"/><verse number="10" style="v" sid="LEV 4:10"/>እትፐተ ያርሾ ሹከቴዳ ኮሩማፐ አኬዳ ሞዋዳን አኮ። ቄስያ ካፑ ጹግያ ያርሹዋ ያርሽያ ሳኣ ቦላን ጹጎ። <verse eid="LEV 4:10"/><verse number="11" style="v" sid="LEV 4:11"/>ሽን ኮሩማ ጋልባ፥ አ አሹዋ ኡባ፥ አ ሁጲያነ፥ አ ገደቱዋ፥ ቃን አሹዋ፥ ቶጭያ፥ <verse eid="LEV 4:11"/><verse number="12" style="v" sid="LEV 4:12"/>ኮሩማ አሹዋፐ አቴዳዋ ኡባ ዱንካኔዳ ሳኣፐ ካረ ከሲደ፤ ብድን ቆልያ ዎጋዳን ጌሻ ግዴዳ ሳኣ አፎ፤ ያን ም ታማን ጹጎ።<verse eid="LEV 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 4:13"/>“ ‘እስራኤልያ ማባራይ ኡባይ ቆፐናን ናጋራ ኦፐነ፥ መና ጎዳ አዛዞቱዋፐ እቱዋ ሀቃዋነ መንፐ፥ ኡንቱንቱ ባይዛንቻ ግዲደ ፓይደታና። <verse eid="LEV 4:13"/><verse number="14" style="v" sid="LEV 4:14"/>ኡንቱንቱ ኦዳ ናጋራይ ኤረትያ ዎደ፥ ናጋራ ያርሾ ሀንያ ኮሩማ ጾሳ ዱንካንያ ስን አህኖ። <verse eid="LEV 4:14"/><verse number="15" style="v" sid="LEV 4:15"/>ሄ ማባራ ጭማቱ መና ጎዳ ስንን ባረንቱ ኩሽያ ኮሩማ ሁጲያ ቦላን ዎደ፥ ሄ ኮሩማ መና ጎዳ ስንን ሹክኖ። <verse eid="LEV 4:15"/><verse number="16" style="v" sid="LEV 4:16"/>ሄዋፐ ጉይያን፥ ቄስያ ካፑ ኮሩማ ሱፐ ጉ አኪደ፥ ጾሳ ዱንካንያ ግዶ ገሎ፤ <verse eid="LEV 4:16"/><verse number="17" style="v" sid="LEV 4:17"/>እ ባረ ኩሽያ ብራያ ሱን ቱሽ ቱሽ ከሲደ፥ ጋርዱዋ ስን ባጋና መና ጎዳ ስንን ላፑ ገደ ዱኮ። <verse eid="LEV 4:17"/><verse number="18" style="v" sid="LEV 4:18"/>ቃይ አማሬዳ ሱ አኪደ፥ መና ጎዳ ዱንካንያ ግዶን ስንን እጻና ጩውስያ ሳጽንያ ቦላ ደእያ ካጨቱዋ ቦላ ጾክሶ። አቴዳ ሱ ቃይ መና ጎዳ ዱንካንያ ገልያሳ ባጋና ደእያ ጹግያ ያርሹዋ ያርሽያ ሳኣፐ ጋርሳ ባጋና ደእያ ሳኣን ጉሶ። <verse eid="LEV 4:18"/><verse number="19" style="v" sid="LEV 4:19"/>ሞዋ ኡባ አኪደ፥ ያርሽያ ሳኣ ቦላን ጹጎ። <verse eid="LEV 4:19"/><verse number="20" style="v" sid="LEV 4:20"/>ናጋራ ያርሾ ሹከቴዳ ኮሩማ ኦዳዋዳን ሀ ኮሩማካ ኦ። ሄዋዳን ኦደ፥ ቄሲ ናጋራ አቶ ጊስያ ዎጋ ፖላና፤ አሳይካ ናጋራፐ ማረታናዋ። <verse eid="LEV 4:20"/><verse number="21" style="v" sid="LEV 4:21"/>ሄዋፐ ጉይያን፥ ኮሩማ ዱንካኔዳ ሳኣፐ ካረ ከሲደ፥ ካሰ ኮሩማ ጹጌዳዋዳን አካ ጹጎ፤ ሀዌ ማባራ ናጋራዉ ያርሽያ ያርሹዋ።<verse eid="LEV 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 4:22"/>“ ‘አሳ ካለያ ሱንቱዋፐ እቱ ቆፐናን ናጋራ ኦፐነ መና ጎዳይ አ ጾሳይ አ አዛዜዳ አዛዙዋፐ እቱዋ ሀቃዋነ መንፐ፥ ሄ ኡራይ ባይዛንቻ። <verse eid="LEV 4:22"/><verse number="23" style="v" sid="LEV 4:23"/>እ ባረ ኦዳ ናጋራ ኤሬዳዋፐ ጉይያን፥ ትላ ቦላና ደእያ እት ዴሻ ኦርግያ አሆ። <verse eid="LEV 4:23"/><verse number="24" style="v" sid="LEV 4:24"/>ሄ ዴሻ ኦርግያ ሁጲያን ባረ ኩሽያ ዎደ ጹግያ ያርሹ መና ጎዳ ስንን ሹከትያ ሳኣን ሹኮ፤ ሄዌ ናጋራ ያርሹዋ። <verse eid="LEV 4:24"/><verse number="25" style="v" sid="LEV 4:25"/>ቄስያ ካፑ ናጋራ ያርሹዋ ሱ ግዶ ባረ ኩሽያ ብራያ ቱሽ ቱሽ ከሲደ፥ ጹግያ ያርሹዋ ያርሽያ ሳኣ ቦላ ደእያ ካጨቱዋ ቦላ ጾክሶ፤ አቴዳ ሱ ቃይ ጹግያ ያርሹዋ ያርሽያ ሳኣፐ ጋርሳ ባጋና ደእያ ሳኣን ጉሶ። <verse eid="LEV 4:25"/><verse number="26" style="v" sid="LEV 4:26"/>ሞዋ ኡባ እትፐተ ያርሹዋ ሞዋ ያርሽያዋዳን ያርሽያ ሳኣ ቦላን ያርሾ። ሀዋዳን ኦደ፥ ቄሲ ብታንያ ናጋራ አቶ ጊሴ፤ ብታኒካ ባረ ናጋራፐ ማረታናዋ።<verse eid="LEV 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 4:27"/>“ ‘ሄ ማባራ አሳፐ እቱ ቆፐናን ናጋራ ኦፐነ መና ጎዳ አዛዙዋፐ እቱዋ ሀቃዋነ መንፐ፥ ሄ ኡራይ ባይዛንቻ ግዲደ ፓይደቴ።<note caller="-" style="x"><char style="xo" closed="false">4:27-31 </char><char style="xt" closed="false"><ref loc="NUM 15:27-28">ፓይ. 15:27-28</ref></char></note> <verse eid="LEV 4:27"/><verse number="28" style="v" sid="LEV 4:28"/>እ ባረ ኦዳ ናጋራይ አዉ ኤረቴዳዋፐ ጉይያን፥ ትላ ቦላና ደእያ ማጫ ዴሻቶ ባረ ናጋራዉ አሆ። <verse eid="LEV 4:28"/><verse number="29" style="v" sid="LEV 4:29"/>ባረ ኩሽያ ናጋራ ያርሹዋ ኦደ ሹክያ ዴሻት ሁጲያን ዎ፤ ያቲደ ጹግያ ያርሹዋ ያርሽያ ሳኣን ናጋራ ያርሹዋ ኦደ ሹኮ። <verse eid="LEV 4:29"/><verse number="30" style="v" sid="LEV 4:30"/>ሄዋፐ ጉይያን፥ ቄስያ ካፑ ሄ ዴሻት ሱፐ ባረ ኩሽያ ብራያን አኪደ፥ ጹግያ ያርሹዋ ያርሽያ ሳኣ ቦላ ደእያ ካጨቱዋ ቦላ ጾክሶ፤ አቴዳ ሱ ኡባ ያርሽያ ሳኣፐ ጋርሳ ባጋና ደእያ ሳኣን ጉሶ። <verse eid="LEV 4:30"/><verse number="31" style="v" sid="LEV 4:31"/>ሞዋ ኡባ እትፐተ ያርሾ ሹኬዳ መህያፐ ከስያዋዳን፥ ሄ ዴሻት ሞዋካ ቆሪደ ከስ አኪደ፥ ያርሽያ ሳኣ ቦላ ዎደ፥ መና ጎዳዉ ሳዉዋ ቶሹኩ ግያ ያርሹዋ ግዳና ማላ ጹጎ። ሄዋዳን ኦደ፥ ቄሲ ሄ ብታንያ ናጋራ አቶ ጊሴ፤ ብታኒካ ባረ ናጋራፐ ማረቴ።<verse eid="LEV 4:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 4:32"/>“ ‘ሄ ብታኒ ባረ ናጋራ ያርሾ ዶርሳ ሺሻናዉ ኮዮፐ፥ ትላ ቦላና ደእያ ማጫውኖ አሆ። <verse eid="LEV 4:32"/><verse number="33" style="v" sid="LEV 4:33"/>እ ባረ ኩሽያ ሄ ዶርሳት ሁጲያን ዎደ ጹግያ ያርሾ ሹክያ መሂ ሹከትያ ሳኣን እዞ ሹኮ። <verse eid="LEV 4:33"/><verse number="34" style="v" sid="LEV 4:34"/>ሄዋፐ ጉይያን፥ ቄሲ ናጋራ ያርሹዋ ግዴዳ ሄ ዶርሳት ሱን ባረ ብራያ ቱሽ ቱሽ ከሲደ፥ ጹግያ ያርሹዋ ያርሽያ ሳኣ ቦላ ደእያ ካጨቱዋ ቦላ ጾክሶ፤ አቴዳ ሱ ቃይ ያርሽያ ሳኣፐ ጋርሳ ባጋና ደእያ ሳኣን ጉሶ። <verse eid="LEV 4:34"/><verse number="35" style="v" sid="LEV 4:35"/>እትፐተ ያርሾ ሹከቴዳ ሞዋ ቃሪደ ከስያዋዳን፥ ሄ ዶርሳት ሞዋካ ቃሪደ ከሶ። ያቲደ፥ ያርሽያ ሳኣ ቦላ መና ጎዳዉ ታማን ጹግያ ያርሹዋ ቦላ ዎደ ጹጎ። ሀዋዳን ኦደ፥ ቄሲ ሄ ብታንያ ናጋራ አቶ ጊሴ። ብታኒካ ባረ ናጋራፐ ማረታናዋ።<verse eid="LEV 4:35"/></para>
  <chapter eid="LEV 4"/>
  <chapter number="5" style="c" sid="LEV 5"/>
  <para style="s1">ናጋራ ያርሹ ሺቅያ ጋሱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 5:1"/>“ ‘አይ አሳይነ ማርካዉ ጼሰቲደ ባረ በኤዳዋ ዎይ ባረ ኤሬዳዋ ጉታራን ማርካተናን እጾፐ፥ ሄዌ አዉ ናጋራ፤ ሄዋ ድራዉ እ ባረ ናጋራን ኦሸቴ።<verse eid="LEV 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LEV 5:2"/>“ ‘ቃይ አይ አሳይነ ኤረናን ደኢደ ቱናባ፥ ዶኣ ባኩታ ዎይ መህያ ባኩታ ዎይ ሳኣና ጎሸትያ ዶአቱዋ ባኩታ ቦቾፐ፥ ቱና ግድያዋ እ ኤሬዳ ዎድያፐ ዶሚደ ባይዛንቻ ግዴዳ።<verse eid="LEV 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 5:3"/>“ ‘ቃይካ አይ አሳይነ ኤረናን ደኢደ፥ አሳ ቦላፐ ጎግያ ቱንስያባ አያ ግድናካ ቦቾፐ፥ ሄዌ ቱና ግድያዋ እ ኤሬዳ ዎድያፐ ዶሚደ ባይዛንቻ ግዴዳ።<verse eid="LEV 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 5:4"/>“ ‘ዎይ ቃይ አይ አሳይነ ኢታባ ግድና ሎኦባ ኦናዉ ኤለካ ጫቆፐነ ባረ ጫቄዳዋካ እ አኬከናን ዮፐ፥ እ አኬኬዳ ዎድያፐ ዶሚደ ባይዛንቻ ግዴዳ።<verse eid="LEV 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 5:5"/>“ ‘አይ አሳይነ ሀ ኦደቴዳ ባይዛቱዋፐ እቱዋ ኦዳዋ ግዶፐ፥ ባረ ኦዳ ናጋራ ፓጾ። <verse eid="LEV 5:5"/><verse number="6" style="v" sid="LEV 5:6"/>እ ባረ ኦዳ ናጋራ ድራዉ መና ጎዳዉ ባረ ዉድያ ግዶፐ ማጫ ዶርሳ ዎይ ማጫ ዴሻ ናጋራ ያርሹዋ ኦደ ሺሾ። ቄሲ አኪደ፥ ሄ ብታንያ ናጋራ አቶ ጊሳናዋ።<verse eid="LEV 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 5:7"/>“ ‘አሳይ ባረ ኦዳ ናጋራዉ ያርሻናዉ፥ ዶርሳ ዎይ ዴሻ ሻማናዉ አዉ ሻሉ ግዳና ዮፐ፥ ላኡ ሀራጰቱዋ፥ ዎይ ላኡ ዶጎማቱዋ፥ እቱዋ ናጋራ ያርሹዋ ኦደ፥ ቃይ እቱዋ ጹግያ ያርሹዋ ኦደ መና ጎዳዉ አሆ። <verse eid="LEV 5:7"/><verse number="8" style="v" sid="LEV 5:8"/>እ ኡንቱንታ ቄስያዉ እሞ። ቄሲ ላኡ ሀራጰቱዋፐ እትንዉ ቆያ ሙጨናን ጮ ምርቂደ፥ ናጋራ ያርሹዋ ኦደ ያርሾ። <verse eid="LEV 5:8"/><verse number="9" style="v" sid="LEV 5:9"/>ያቲደ ሄ ናጋራ ያርሹዋ ሱፐ አማሬዳዋ አኪደ፥ ያርሽያ ሳኣ ምይያን ጫጫፎ፤ አቴዳ ሱ ያርሽያ ሳኣፐ ጋርሳ ባጋና ጉሶ፤ ሄዌ ናጋራ ያርሹዋ። <verse eid="LEV 5:9"/><verse number="10" style="v" sid="LEV 5:10"/>የንኮ ሀራጳቶ ቃይ ህጊ አዛዝያዋዳን፥ ጹግያ ያርሹዋ ኦደ ጹጎ። ቄሲ ሄዋዳን ኦደ፥ ብታኒ ኦዳ ናጋራ አቶ ጊሳናዉ ያርሹዋ ያርሼ፤ ብታኒካ ባረ ናጋራፐ ማረታናዋ።<verse eid="LEV 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 5:11"/>“ ‘ሽን እት ኡራዉ ላኡ ዎጋ ዶጎማቱዋ ዎይ ላኡ ሀራጰቱዋ አሀናዉ ሻሉ ግዳና ዮፐ፥ ላኡ ኪሎ ግራመ ሊቆ ልያ ባረ ናጋራዉ ሺሽያ ያርሹዋ ኦደ አሆ። ሄ ሊ ናጋራ ያርሹዋ ግድያ ድራዉ፥ ዎጋራ ዛይቲ ዎይ እጻናይ አን ጉጀቶፖ። <verse eid="LEV 5:11"/><verse number="12" style="v" sid="LEV 5:12"/>እ ሄዋ አሂደ ቄስያዉ እሞ፤ ቄሲ ሄ ልያፐ እት ኩሽያ ኩን አኪደ፥ መና ጎዳዉ ሺሽያ ሀራ ያርሹዋ ቦላ ዎደ፥ ሀሳይስያዋ ኦደ ያርሽያሳን ደእያ ታማን ጹጎ፤ ሄዌ ናጋራ ያርሹዋ። <verse eid="LEV 5:12"/><verse number="13" style="v" sid="LEV 5:13"/>ሀ ጌተቴዳዋንቱፐ ሀቃዋንነ ግዶ ብታኒ ኦዳ ናጋራዉ ቄሲ ሀዋዳን ኦደ፥ ብታኒ ኦዳ ናጋራ አቶ ጊሴ፤ ብታኒካ ባረ ናጋራፐ ማረታናዋ። ካ ያርሹዋዳንካ አቴዳዋ ቄሲ አኮ ያጋደ ኦዳ’ ” ያጌዳ።<verse eid="LEV 5:13"/></para>
  <para style="s1">ናቁዋ ያርሹዋ</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 5:14"/>መና ጎዳይ ሙሴዉ ሀዋዳን ያጊደ ኦዴዳ፤ <verse eid="LEV 5:14"/><verse number="15" style="v" sid="LEV 5:15"/>“ኦንነ መና ጎዳዉ ጌሽ ዎዳ ሚሻቱዋ ቦላ አማነተናን ዮፐ ቃይ ኤረናን ናጋራ ኦፐ፥ ባረ ናቆ ባረ ዉድያ ግዶፐ ትላ ቦላና ደእያ እት ዶርሳ ኦርግያ መና ጎዳዉ አሆ። አ ጋቲካ መና ጎዳ ዱንካንያን ኤረትያ ሚዛናን ዎና ኤረቶ፤ ሄዌ ናቁዋ ያርሹዋ። <verse eid="LEV 5:15"/><verse number="16" style="v" sid="LEV 5:16"/>መና ጎዳዉ ዱማይ ዎዳ ሚሻቱዋ ቦላ እ ናጋራ ኦዳ ድራዉ፥ እ ሄ ሚሻቱዋ ጋትያ ጭጎ፤ ካሰ ጋትያ ቦላ ጼቱዋፐ ላታሙ ኩሽያ ጉጂደ ቄስያዉ እሞ። ቄሲ ሄ ናቁዋ ያርሾ አሄዳ ዶርሳ ያርሺደ፥ ብታንያ ናጋራ አቶ ጊሴ፤ ብታኒካ ባረ ናቁዋፐ ማረታናዋ።<verse eid="LEV 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 5:17"/>“አይ አሳይነ ኤረናን ደኢደ፥ መና ጎዳይ፥ ‘ኦፓ’ ጊደ አዛዜዳዋፐ እቱዋ ኦደ ናጋራን ገሎፐ፥ እ ኤራና ዮፐ ባይዛንቻ ግድያ ድራዉ፥ ባረ ናጋራን ኦሸቴ። <verse eid="LEV 5:17"/><verse number="18" style="v" sid="LEV 5:18"/>እ ባረ ዉድያፐ ትላ ቦላና ደእያ እት ዶርሳ ኦርግያ ናቁዋ ያርሾ ቄስያኮ አሆ። ሄ ዶርሳይ ናቆ ጭግያ ጋትያ ከስያዋ ግዶ፤ ያቶፐ ቄሲ ሄ ዶርሳ ያርሺደ፥ ብታንያ ናቁዋ አቶ ጊሴ፤ ብታኒካ ባረ ናቁዋፐ ማረቴ። <verse eid="LEV 5:18"/><verse number="19" style="v" sid="LEV 5:19"/>ሄዌ ናቁዋ ያርሹዋ። እ ቱሙካ መና ጎዳ ናቄዳ” ያጌዳ።<verse eid="LEV 5:19"/></para>
  <chapter eid="LEV 5"/>
  <chapter number="6" style="c" sid="LEV 6"/>
  <para style="p">
    <verse number="1" style="v" sid="LEV 6:1"/>መና ጎዳይ ሙሴዉ ሀዋዳን ያጌዳ፤<note caller="-" style="x"><char style="xo" closed="false">6:1-7 </char><char style="xt" closed="false"><ref loc="NUM 5:5-8">ፓይ. 5:5-8</ref></char></note> <verse eid="LEV 6:1"/><verse number="2" style="v" sid="LEV 6:2"/>“መና ጎዳይ ኦንነ ናጋራ ኦደ ባረ ሾሩዋ ዎርዶቲደ ጭሞፐ ሀዋፐ ካሊደ ደእያ ህገቱዋ እሜዳ: ሾሩዋ ማታን ሀዳራ ዎባ ዎይ ኦይደ ታልኤዳባ ካዶፐ፥ ዎይ አሳዋ ቦንቆፐ፥ ዎይ ባረ ሾሩዋ ቦላን ሱገ ኦፐ፥ <verse eid="LEV 6:2"/><verse number="3" style="v" sid="LEV 6:3"/>ዎይ ባዬዳዋ ደሚደ ታ በአበይከ ጎፐነ ዎርዱዋን ጫቆፐ፥ ሀዋንታ ማላትያዋንቱፐ እቱዋ ኦፐ፥ <verse eid="LEV 6:3"/><verse number="4" style="v" sid="LEV 6:4"/>እ ሀቃዋነ ግዶ፥ ኦደ፥ ሄዋን ናጋራንቻ ግዶፐ፥ ባረ ቦንቂ አኬዳዋ፥ ዎይ ኦይና ካዲደ አኬዳዋ፥ ዎይ ሀዳራ እሜዳዋ ዎይ፥ ባይና ደሜዳዋ፥ <verse eid="LEV 6:4"/><verse number="5" style="v" sid="LEV 6:5"/>ዎይ ዎርዱዋን ጫቂ አኬዳዋ ኡባካ አ ጎዳዉ ዛሮ። ቃይ ባረ ናቁዋ ያርሹዋ ያርሽያ ጋላስ ባረ አኬዳዋ ቦላ ጼቱዋፐ ላታሙ ኩሽያ ጉጂደ አ ጎዳዉ እሞ። <verse eid="LEV 6:5"/><verse number="6" style="v" sid="LEV 6:6"/>ቃይካ ባረ ናቁዋ ድራዉ መና ጎዳዉ ያርሽያ ያርሾ ባረ ዉድያ ግዶፐ ትላ ቦላና ደእያ እት ዶርሳ ኦርግያ ቄስያኮ አሆ። ሄ ዶርሳ ጋቲ ሱረ ቆፈቴዳዋ ግዶ። <verse eid="LEV 6:6"/><verse number="7" style="v" sid="LEV 6:7"/>ቄሲ ሄ ዶርሳ መና ጎዳ ስንን ያርሺደ፥ ብታንያ ናቁዋ አቶ ጊሴ፤ ብታኒካ ባረ ናቁዋ ኡባፐ ማረታናዋ” ያጌዳ።<verse eid="LEV 6:7"/></para>
  <para style="s1">ዉርስ ጹግያ ያርሹዋ</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 6:8"/>መና ጎዳይ ሙሴዉ ሀዋዳን ያጊደ ኦዴዳ፤ <verse eid="LEV 6:8"/><verse number="9" style="v" sid="LEV 6:9"/>“አሮናነ አ አቱማ ናናቱዋ ሀዋዳን ያጋደ አዛዛ፤ ‘ጹግያ ያርሾ ደእያ ዎጋይ ሀዋ: ጹግያ ያርሹ ቃማይ ዎንታና ጋካናዉ ያርሽያ ሳኣን ደኦ። ታማይካ ያርሽያ ሳኣን ኡባ ዎደ ኤጺደ ደኦ። <verse eid="LEV 6:9"/><verse number="10" style="v" sid="LEV 6:10"/>ቄሲ ሊኑዋፐ ዳደቴዳ ቃምሽያነ ሱርያ ማዪደ፥ ጹግያ ያርሹዋ ታማይ ም ስምና አቴዳ ብድን ደንደ፥ ያርሽያ ሳ ምይያን ላሎ። <verse eid="LEV 6:10"/><verse number="11" style="v" sid="LEV 6:11"/>ሄዋፐ ጉይያን፥ ሄ ማዩዋ ቃር ዎ ሀራ ማዩዋ ማዪደ፥ ሄ ብድን ዱንካኔዳ ሳኣፐ ጋጻ አፊደ፥ ህግያዳን ጌዬዳ ሳኣን ቆሎ። <verse eid="LEV 6:11"/><verse number="12" style="v" sid="LEV 6:12"/>ያርሽያ ሳኣ ቦላ ደእያ ታማይ ቶኤናን ኡባ ዎደ ኤጺደ ደኦ። ቄሲ ዎንታ ዎንታ ም አን ጉጅ ጉጂደ ዎ። ጹግያ ያርሹዋካ ሄ ም ቦላ ማራን ዎደ፥ እትፐተ ያርሹዋ ሀንዳ አ ቦላ ጹጎ። <verse eid="LEV 6:12"/><verse number="13" style="v" sid="LEV 6:13"/>ታማይ ያርሽያ ሳኣ ቦላ ኡባ ዎደ ኤጺደ ደኦ፤ ቶአናዉ ኮሸና።<verse eid="LEV 6:13"/></para>
  <para style="s1">ካ ያርሹዋ</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 6:14"/>“ ‘ካ ያርሾ እመቴዳ ዎጋይ ሀዋ: አሮና አቱማ ናና ግድያ ቄሳቱ ያርሽያ ሳኣፐ ስን ባጋና መና ጎዳ ስንን ሺሽኖ። <verse eid="LEV 6:14"/><verse number="15" style="v" sid="LEV 6:15"/>ቄሲ ሎኦ ልያፐ ኮጵያዋነ ዛይትያ አኪደ፥ ካ ያርሹዋ ቦላ ደእያ እጻና ኡባካ ደንደ፥ መና ጎዳዉ ሳዉዋ ቶሹኩ ግያ ያርሹዋ ኦደ፥ ሀሳይስያዋ ግዳናዳን ያርሽያ ሳኣ ቦላ ጹጎ። <verse eid="LEV 6:15"/><verse number="16" style="v" sid="LEV 6:16"/>ሄዋፐ አቴዳዋ አሮንነ አ አቱማ ናናይ ሚኖ፤ ሄዋ ኡንቱንቱ እርሹ የገትቤና ኡክ ኦ ኡኪደ፥ ዱንካንያ ዳባባ ግዶን ደእያ ጌሻ ሳኣን ሚኖ። <verse eid="LEV 6:16"/><verse number="17" style="v" sid="LEV 6:17"/>ሄ ኡክይ እርሹዋ የገናን ኡከቶ። ሄዋ ታዉ ታማን ጹግያ ያርሹዋፐ ኡንቱንታ ጋክያዋ ታን ኡንቱንቶ እማድ። ናጋራ ያርሹዋዳንነ ናቁዋ ያርሹዋዳን እካ ሎይደ ጌሻ። <verse eid="LEV 6:17"/><verse number="18" style="v" sid="LEV 6:18"/>መና ጎዳዉ ታማን ጹግያ ያርሹዋፐ ኡንቱንታ ጋክያዋ ግድያ ድራዉ፥ ይያ ላይቱዋንካ አሮና ዛረ ግድያ አቱማዋንቱ ኡባይ ሄዋ ሚኖ። ሄ ያርሹዋ ቦችያ አያይነ ጌሻ ግዳና’ ያጋ” ያጌዳ።<verse eid="LEV 6:18"/></para>
  <para style="s1">ቄስያ ካፑዋ ሱንያ ዎደ ያርሸትያ ካ ያርሹዋ</para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 6:19"/>መና ጎዳይ ቃይካ ሙሴዉ ሀዋዳን ያጊደ ኦዴዳ፤ <verse eid="LEV 6:19"/><verse number="20" style="v" sid="LEV 6:20"/>“አሮንነ አ አቱማ ናናቱዋፐ ቄሳተ ካፖተዉ ኦከትያ ጋላስ ላኡ ኪሎ ግራመ ግድያ ሎኦ ልያ ካ ያርሹዋ ኦደ መና ጎዳዉ አህኖ። ሄዋፐ ባጋ ዎንታ፥ ባጋ ኦማርስ ያርሽኖ። <verse eid="LEV 6:20"/><verse number="21" style="v" sid="LEV 6:21"/>ሄ ሊ ዛይትያን ሙናቀት ሎኦ ዋላከቲደ ባሽያን ኡከቶ፤ ቡንቻደ፥ ሳዉዋ ቶሹኩ ግያ ካ ያርሹዋ ኦደ መና ጎዳዉ ሺሻ። <verse eid="LEV 6:21"/><verse number="22" style="v" sid="LEV 6:22"/>ቃይ አሮና አቱማ ናናቱዋፐ አ ቄሰተ ካፖተ ኦሶ ኦከትያ ኡባይካ ሄ ዎጋ ኦኖ። ሄዌ መና ጎዳዉ ኡባ ገደ ያርሽያ ያርሹዋ ግዲደ ኡባና ጹገቶ። <verse eid="LEV 6:22"/><verse number="23" style="v" sid="LEV 6:23"/>ቄሲ ሺሽያ ካ ያርሹዋፐ ጉየ አተናን ዉር ጹገቶ፤ አፐ አያይነ ሜተቶፖ” ያጌዳ።<verse eid="LEV 6:23"/></para>
  <para style="s1">ናጋራ ያርሹዋ ዎጋ</para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 6:24"/>መና ጎዳይ ሙሴዉ ሀዋዳን ያጊደ ኦዴዳ፤ <verse eid="LEV 6:24"/><verse number="25" style="v" sid="LEV 6:25"/>“አሮናሳነ አ አቱማ ናናቶ፥ ሀዋዳን ያጋ፤ ‘ናጋራ ያርሹዋ ዎጋይ ሀዋ: መና ጎዳዉ ጹግያ ያርሾ ሺሽያ መሂ ሹከትያ ሳኣን ናጋራ ያርሾ ሺሽያ መሂካ ሄዋን ጾሳ ስንን ሹከቶ፤ እካ ጌሻ ያርሹዋ ኡባፐ እቱዋ ግዴዳ ጌሻ ያርሹዋ። <verse eid="LEV 6:25"/><verse number="26" style="v" sid="LEV 6:26"/>ሄ ያርሹዋ ያርሽያ ቄሲ ዱንካንያ ዳባባ ግዶን ደእያ ጌሻ ሳኣን ሞ። <verse eid="LEV 6:26"/><verse number="27" style="v" sid="LEV 6:27"/>ሄ አሹዋ ቦችያ አያይነ ጌሻ ግዳናዋ፤ ቃይ ሹክሺን አይ ማዩዋ ቦላነ ሱይ ጨቶፐ፥ ሄ ማዩ ጌሻ ሳኣን ሜጨቶ። <verse eid="LEV 6:27"/><verse number="28" style="v" sid="LEV 6:28"/>አሹ ዶይሰቴዳ ኡርቃ ሚሻይ መኦ፤ ማዳብያ ብራታ ድስትያን ዶይሴዳዋ ግዶፐ፥ ሄ ድስትያ ቃጪደ ሃን ሾክ ድጋናዉ ኮሼ። <verse eid="LEV 6:28"/><verse number="29" style="v" sid="LEV 6:29"/>ቄሳቱዋ ዛርያፐ አቱማ አሳ ግዴዳ ኦንነ ሄ አሹዋ ሞ፤ ሄ አሹ ጌሻ ኡባፐ እቱዋ ግዴዳ ሎይ ጌሻ። <verse eid="LEV 6:29"/><verse number="30" style="v" sid="LEV 6:30"/>ግዶ ሽን ጌሻ ሳኣን ናጋራ አቶ ጊሳናዉ አ ሱ አኪደ፥ ዱንካንያ ግዶ ገልሴዳ አይ መህያ አሹዋነ ማናዉ ኮሸና፤ እ ታማን ጹገታናዉ ኮሼ።<verse eid="LEV 6:30"/></para>
  <chapter eid="LEV 6"/>
  <chapter number="7" style="c" sid="LEV 7"/>
  <para style="s1">ናቁዋ ያርሹዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 7:1"/>“ ‘ናቁዋ ያርሹዋ ዎጋይ ሀዋ: እካ ጌሻ ኡባፐ እቱዋ ግዴዳ ጌሻ ያርሹዋ። <verse eid="LEV 7:1"/><verse number="2" style="v" sid="LEV 7:2"/>ጹግያ ያርሾ ሺሽያ መህያ ሹክያ ሳኣን ናቁዋ ያርሹዋ መህያካ ሹክኖ፤ አ ሱካ ያርሽያ ሳኣ ምየቱዋን ጭኖ። <verse eid="LEV 7:2"/><verse number="3" style="v" sid="LEV 7:3"/>ቃይ አ ሀንዳ ኡባ: ሄዌካ ናስያ ሀንዳ፥ ቃን አሹዋ ማዬዳ ሀንዳ፥ <verse eid="LEV 7:3"/><verse number="4" style="v" sid="LEV 7:4"/>ላኡ ክላሆቱዋ፥ ሽንጭያ ማታን ደእያ ኡንቱንቱ ማዬዳ ሀንዳነ ትርያ ጼራ ቦላ ደእያ ሞያ ክላሆቱዋና እትፐ ያርሹዋ ኦደ ሺሾ። <verse eid="LEV 7:4"/><verse number="5" style="v" sid="LEV 7:5"/>ታማን ጹጊደ መና ጎዳዉ ያርሽያ ያርሹዋዳን፥ ሄ ሺቄዳ ሀንዳ ቄሲ ያርሽያ ሳኣ ቦላን ጹጎ፤ ሄዌ ናቁዋ ያርሹዋ። <verse eid="LEV 7:5"/><verse number="6" style="v" sid="LEV 7:6"/>ቄስያ ዛረ ግዴዳ አቱማ አሳይ ኡባይ ሄ ያርሹዋ አሹዋ ሞ። ሄ ያርሹ ጌሻ ያርሹዋ ኡባፐ እቱዋ ግድያ ድራዉ፥ ጌሻ ሳኣን ሞ።<verse eid="LEV 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 7:7"/>“ ‘ናቁዋ ያርሹ ናጋራ ያርሹዋካ ማላ፤ ኡንቱንቱ ላኡዋ ዎጋይ እቱዋ። ሄዌነ ያርሸቴዳ መህያ አሹ ናጋራ አቶ ጊሳናዉ ያርሹዋ ያርሼዳ ቄስያዉ እመቴ። <verse eid="LEV 7:7"/><verse number="8" style="v" sid="LEV 7:8"/>ኦንነ ጹግያ ያርሹዋ አሆፐ ያርሽያ ቄሲ ሄ መህያ ጋልባ ባረዉ አኮ። <verse eid="LEV 7:8"/><verse number="9" style="v" sid="LEV 7:9"/>ጮጭያን ኮምፐቴዳ ካ ያርሹዋ ኡባይነ ኦቱዋን ዶይሰቴዳ ዎይ ባሽያን ኡከቴዳ ኡባይካ ሄ ያርሹዋ ያርሼዳ ቄስያዉ እመቴ። <verse eid="LEV 7:9"/><verse number="10" style="v" sid="LEV 7:10"/>ቃይ ዛይትያን ሙናቀቴዳ ዎይ ሙናቀትቤና ካ ያርሹዋ ኡባይ አሮና አቱማ ናናቶ ኡባዉ እመቴ፤ ኡንቱንቱ ሄዋ ቃራን ግሽ አክኖ።<verse eid="LEV 7:10"/></para>
  <para style="s1">እትፐተ ያርሹዋ</para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 7:11"/>“ ‘አሳይ እትፐተ ያርሹዋ መና ጎዳዉ ያርሽያ ዎደ አዉ ደእያ ዎጋይ ሀዋ: <verse eid="LEV 7:11"/><verse number="12" style="v" sid="LEV 7:12"/>እ ሺሽያ እትፐተ ያርሹ ጋላታ ያርሹዋ ግዶፐ፥ ሄ ያርሹዋና እትፐ ዛይትያን ሙናቄዳ፥ እርሹዋ የገናን ኡኬዳ ኡክ፥ ዛይትያን ኦከቴዳ፥ እርሹ ገልቤና ሌኦ ዳቡዋነ ዛይትያን ሎይ ሙናቄዳ፥ ሊቆ ልያፐ ኡከቴዳ ኮምፑዋ ሺሾ። <verse eid="LEV 7:12"/><verse number="13" style="v" sid="LEV 7:13"/>ሄ ጋላታዉ ሺሽያ እትፐተ ያርሹዋና እትፐ እርሹዋ የጌዳ ሙናቃፐ ኡከቴዳ ኡክካ እሞታ ኦደ ሺሾ። <verse eid="LEV 7:13"/><verse number="14" style="v" sid="LEV 7:14"/>ቃይ ሄ ኡባ ቆሞ ኡክቱዋፐካ እ እቱዋ እቱዋ ደንደ፥ መና ጎዳዉ ያርሹዋ ኦደ አሆ። ሄዌ እትፐተ ያርሹዋ ሱ ጫጫፌዳ ቄስያዉ እመቶ። <verse eid="LEV 7:14"/><verse number="15" style="v" sid="LEV 7:15"/>ሄ መህያ አሹ ጋላታዉ ሺቅያ እትፐተዉ ያርሸቴዳ ጋላስ ሜተቶ፤ ዎንታዉ አያይነ አቶፖ።<verse eid="LEV 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 7:16"/>“ ‘ሽን አ ያርሹ ሺቄዳዋ ጋያ ዎይ ባረ ዶሱዋን ጮ እምያ ያርሹዋ ግዶፐ፥ ሄ ያርሹዋ አሹ ሄ ያርሼዳ ጋላስ ሜተቶ፤ አፐ አትያዋ ቃይ ዎንተ ጋላስካ ሜተቶ። <verse eid="LEV 7:16"/><verse number="17" style="v" sid="LEV 7:17"/>ሄ ያርሹዋ አሹዋፐ ፓላሂደ ሄዘን ጋላሳ ጋካናዉ ጋምእያዌ ደኦፐ፥ ሄዌ ታማን ጹገቶ። <verse eid="LEV 7:17"/><verse number="18" style="v" sid="LEV 7:18"/>እት አሳይ ሺሼዳ እትፐተ ያርሹዋ አሹዋፐ ሀቃዌነ ሄዘን ጋላስ ሜተቶፐ፥ አ ያርሹ አከተና፤ እ ያርሼዳዋዳንካ ፓይደተና። ሄ ያርሹ ቱና፤ አፐ ሜዳ ኦንነ ባረ ናጋራን ኦሸቴ።<verse eid="LEV 7:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 7:19"/>“ ‘ቱናባ አያነ ቦቼዳ አሹ ሜተቶፖ፤ እ ታማን ጹገታናዉ ኮሼ። አሹ ጌሻ አሹዋ ግዶፐ፥ ዎጋን ጌሻ ግድያ አሳይ ኦንነ ማና ጎፐ ሞ። <verse eid="LEV 7:19"/><verse number="20" style="v" sid="LEV 7:20"/>ሽን እት አሳይ ቱና ግድ ኡቲደ፥ መና ጎዳዉ ሺሼዳ እትፐተ ያርሹዋ አሹዋፐ ምያዋ ግዶፐ፥ ሄ አሳይ ባረ አሳ ግዶፐ ቦሄቶ። <verse eid="LEV 7:20"/><verse number="21" style="v" sid="LEV 7:21"/>ቃይ እት አሳይ ቱናባ አያነ ቦቾፐ አሳ ቱናተ ግድና ዎይ ቱና መህያ ግድና፥ ዎይ ሀራ ሸነይያ ቱናባ ቦቾፐ ስሚደ መና ጎዳዉ ያርሼዳ እትፐተ ያርሹዋ አሹዋፐ ሞፐ፥ ሄ ኡራይ ባረ አሳ ግዶፐ ቦሄቶ’ ያጋ” ያጌዳ።<verse eid="LEV 7:21"/></para>
  <para style="s1">ሱነ ሞዋ ሙሳይ ድገቴዳ</para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 7:22"/>መና ጎዳይ ሙሴዉ ሀዋዳን ያጊደ ኦዴዳ፤ <verse eid="LEV 7:22"/><verse number="23" style="v" sid="LEV 7:23"/>“እስራኤልያ አሳዉ ሀዋዳን ያጋ፤ ‘ኮሩማ ዎይ ዶርሳ ዎይ ዴሻ አሹዋን ሞያ ዛዋ ሙለካ ሞፕተ። <verse eid="LEV 7:23"/><verse number="24" style="v" sid="LEV 7:24"/>ሀይቄዳ መህያ ዎይ ዶአይ ዎዳ መህያ ሞያካ ሀራባዉ ጎኤትተፐ አትና፥ አፐ አያነ ሞፕተ። <verse eid="LEV 7:24"/><verse number="25" style="v" sid="LEV 7:25"/>አያዉ ጎፐ፥ መና ጎዳዉ ታማን ጹግያ ያርሾ ሺሽያ መህያ ሞያ ምያ ኦንነ ባረ አሳ ግዶፐ ቦሄቶ። <verse eid="LEV 7:25"/><verse number="26" style="v" sid="LEV 7:26"/>ህንተ ደእያ ሳኣን ሀቃን ግዶፐካ፥ ካፉዋ ሱ፥ መህያ ሱ ዎይ ሀራባ አያ ሱነ ሞፕተ።<note caller="-" style="x"><char style="xo" closed="false">7:26-27 </char><char style="xt" closed="false"><ref loc="GEN 9:4">ዶመ 9:4</ref>፤ <ref loc="LEV 17:10-14">ዎጋ 17:10-14</ref>፤ <ref loc="LEV 19:26">19:26</ref>፤ <ref loc="DEU 12:16">ዛረ. 12:16</ref>፣ <ref loc="DEU 12:23">23</ref>፤ <ref loc="DEU 15:23">15:23</ref></char></note> <verse eid="LEV 7:26"/><verse number="27" style="v" sid="LEV 7:27"/>ሱ ምያ አይ አሳይነ፥ ሄ አሳይ ባረ አሳ ግዶፐ ቦሄቶ’ ያጋ” ያጌዳ።<verse eid="LEV 7:27"/></para>
  <para style="s1">ቄስያ ጋክያ ግሹዋ</para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 7:28"/>መና ጎዳይ ሙሴዉ ሀዋዳን ያጊደ ኦዴዳ፤ <verse eid="LEV 7:28"/><verse number="29" style="v" sid="LEV 7:29"/>“እስራኤልያ አሳዉ ሀዋዳን ያጋ፤ ‘መና ጎዳዉ እትፐተ ያርሹዋ ሺሽያ አይ አሳይነ ሄ እትፐተ ያርሹዋፐ ሻኪደ፥ ባረ ሁጰ እሞታ ዱማዪደ መና ጎዳዉ ሺሾ። <verse eid="LEV 7:29"/><verse number="30" style="v" sid="LEV 7:30"/>ሄዋ እ መና ጎዳዉ ታማን ጹግያ ያርሹዋ ኦደ፥ ባረ ኩሽያን አኪደ አሆ፤ ቃይ ሞዋካ አንጎሱዋና አሆ፤ አንጎሱዋ ዉጻክያ ያርሹዋ ኦደ፥ መና ጎዳ ስንን ቃ። <verse eid="LEV 7:30"/><verse number="31" style="v" sid="LEV 7:31"/>ቄሲ ያርሽያ ሳኣ ቦላን ሞዋ ጹጎ፤ ሽን አንጎሱ አሮናሳነ አ አቱማ ናናቶ እመቶ። <verse eid="LEV 7:31"/><verse number="32" style="v" sid="LEV 7:32"/>ህንተ እትፐተ ያርሹዋፐ ኡሸቻ ገድያ እሞታ ኦደ ቄስያዉ እምተ። <verse eid="LEV 7:32"/><verse number="33" style="v" sid="LEV 7:33"/>ሄዌ ኡሸቻ ገዲ አሮና አቱማ ናናቱዋፐ እትፐተ ያርሹዋ ሱነ ሞድያ ያርሽያዎ አ ጋክያ አ ግሹዋ። <verse eid="LEV 7:33"/><verse number="34" style="v" sid="LEV 7:34"/>ታን እስራኤልያ አሳ እትፐተ ያርሹዋፐ ቃዳ አንጎሱዋነ ያርሾ ሺሼዳ ገድያ አካደ፥ ቄስያ አሮናሳነ አ አቱማ ናናቶ እማድ፤ ሄዌ ኡንቱንታ ጋክያ ኡንቱንቱ ግሹዋ ግድያ ድራዉ፥ እስራኤልያ አሳይ መናዉ ሄዋ ኡንቱንቶ እሚደ ደአና’ ያጋደ ኦዳ” ያጌዳ።<verse eid="LEV 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 7:35"/>አሮንነ አ አቱማ ናናይ ቄስያ ግዲደ፥ መና ጎዳዉ ኦናዉ ሱንቴዳ ጋላስ መና ጎዳዉ ሺሼዳ ታማን ጹግያ ያርሹዋፐ ሄዌ ኡንቱንቶ ግሹዋ ግዲደ እመቴዳ። <verse eid="LEV 7:35"/><verse number="36" style="v" sid="LEV 7:36"/>መና ጎዳይ ኡንቱንቱ ቄሰተዉ ኦከቴዳ ጋላስ፥ ሄዋ ኡንቱንቶ እማና ማላ፥ እስራኤልያ አሳ ኡባ አዛዜዳ፤ ስን የለታን ኡባንካ ሀዌ ዎጋ ግዲደ ኦሰቴ።<verse eid="LEV 7:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 7:37"/>ስም ሀዋንቱ፥ ጹግያ ያርሾ፥ ካ ያርሾ፥ ናጋራ ያርሾ፥ ናቁዋ ያርሾ፥ ቄሳተዉ ኦከትያ ዎደ ያርሽያ ያርሾነ እትፐተ ያርሾ እመቴዳ ዎጋቱዋ። <verse eid="LEV 7:37"/><verse number="38" style="v" sid="LEV 7:38"/>ሀ ዎጋቱ እስራኤልያ አሳይ ሲና መላ ሳኣን ባረንቱ ያርሹዋ መና ጎዳዉ ያርሻና ማላ መና ጎዳይ አዛዜዳ ጋላስ፥ ሲና ደርያ ቦላን መና ጎዳይ ሙሳ አዛዜዳ ዎጋቱዋ።<verse eid="LEV 7:38"/></para>
  <chapter eid="LEV 7"/>
  <chapter number="8" style="c" sid="LEV 8"/>
  <para style="s1">አሮነነ አ ናናቱ ቄስያ ግድያ ዎጋነ ኡንቱንቱ ኦሱዋ</para>
  <para style="r">(<ref loc="LEV 8:1-10:20">8:1—10:20</ref>፤ <ref loc="EXO 29:1-37">ከሳ 29:1-37</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 8:1"/>መና ጎዳይ ሙሴዉ ሀዋዳን ያጊደ ኦዴዳ፤ <verse eid="LEV 8:1"/><verse number="2" style="v" sid="LEV 8:2"/>“አሮናነ አ አቱማ ናናቱዋ ቃይ ኡንቱንቱና እትፐ፥ ቄሳተ ማዩዋ፥ ኦክያ ዛይትያ፥ ናጋራ ያርሾ ሹክያ ኮሩማ፥ ላኡ ዶርሳ ኦርገቱዋነ፥ እርሹዋ የገናን ኡኬዳ ኡክ ዎዳ ማሶፍያ አካደ ያ። <verse eid="LEV 8:2"/><verse number="3" style="v" sid="LEV 8:3"/>ቃይ እስራኤልያ አሳ ኡባካ ጼሳደ፥ ዱንካንያ ካረ ሺሻ” ያጌዳ።<verse eid="LEV 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 8:4"/>ሙሴ መና ጎዳይ አዛዜዳዋዳን ኦዳ፤ አሳይካ ኡባይ ዱንካንያ ካረን ሺቄዳ። <verse eid="LEV 8:4"/><verse number="5" style="v" sid="LEV 8:5"/>ሙሴ አሳዉ፥ “ኦና ማላ መና ጎዳይ አዛዜዳዌ ሀዋ” ያጌዳ።<verse eid="LEV 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 8:6"/>ሙሴ አሮናነ አ አቱማ ናናቱዋ አሂደ፥ ሃን ሜጬዳ። <verse eid="LEV 8:6"/><verse number="7" style="v" sid="LEV 8:7"/>አሮና ቃምሽያ ማይዜዳ፤ ዳንጩዋካ ዳንጭሴዳ። ቃይ አዱሳ ቃምሽያ ማይዚደ፥ አ ቦላን ኤፉድያ ማይዜዳ። ኤፉድያ ሂላቲደ ዳዴዳ ሳቂያን አሮናና ጋደ ቃቼዳ። <verse eid="LEV 8:7"/><verse number="8" style="v" sid="LEV 8:8"/>ቃይ ትራን ዎያዋ አሮና ቦላን አደ፥ አ ግዶን ኡሪምያነ ቱሚምያ ዎዳ።<figure style="fig" alt="Urim and Thummim" file="HK00261B.TIF" size="col" ref="8:8">ኡሪምያነ ቱሚምያ</figure> <verse eid="LEV 8:8"/><verse number="9" style="v" sid="LEV 8:9"/>ቃይካ አሮና ሁጲያን ሻሽያ ኤንጩርሳ ዎዳ። መና ጎዳይ ሙሳ አዛዜዳዋዳን ሄ ኤንጩርሳ ቦላን ስን ባጋና ዎርቃ ማዳልያ፥ ዎርቃፐ መዳ ካላቻ ምስልያ ዎዳ።<verse eid="LEV 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 8:10"/>ያቶዋፐ ጉይያን ሙሴ ኦክያ ዛይትያ አኪደ፥ ዱንካንያነ ዱንካንያ ግዶን ደእያ ሚሻ ኡባ ኦኬዳ፤ ኡንቱንታ ጌሼዳ። <verse eid="LEV 8:10"/><verse number="11" style="v" sid="LEV 8:11"/>ቃይ ሄ ዛይትያፐ አኪደ፥ ያርሽያ ሳኣ ቦላ ላፑ ገደ ጫጫፌዳ፤ ያርሽያ ሳኣ፥ አ ሚሻቱዋ፥ ሜቻ ከርያነ አ ዎያዋ፥ ጌሻናዉ ሄ ዛይትያን ኦኬዳ። <verse eid="LEV 8:11"/><verse number="12" style="v" sid="LEV 8:12"/>ቃይ ሄ ኦክያ ዛይትያፐ አማራ አሮና ሁጲያን ትጊደ፥ አ ጌሼዳ። <verse eid="LEV 8:12"/><verse number="13" style="v" sid="LEV 8:13"/>መና ጎዳይ ሙሳ አዛዜዳዋዳን፥ ሙሴ አሮና አቱማ ናናቱዋ ስንዉ አደ፥ ቃምሽያ ማይዜዳ፤ ዳንጩዋን ዳንጭሴዳ። ኡንቱንቱ ሻሽያ ኤንጩርሳ ዎዳ።<verse eid="LEV 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 8:14"/>ሄዋፐ ጉይያን፥ ናጋራ ያርሾ ኮሩማ ሙሴ አዳ፤ አሮንነ አ አቱማ ናናይ ሄ ኮሩማ ሁጲያን ባረንቱ ኩሽያ ዎድኖ። <verse eid="LEV 8:14"/><verse number="15" style="v" sid="LEV 8:15"/>ሙሴ ሄ ኮሩማ ሹኬዳ፤ አ ሱፐ ባረ ብራያን አኪደ፥ ያርሽያ ሳኣ ካጨቱዋ ኦኪደ፥ ያርሽያ ሳኣ ጌሼዳ፤ ቃይ ያርሽያ ሳኣ ናጋራ አቶ ጊሳናዉ አቴዳ ሱ አፐ ጋርሳና ጉሲደ፥ ጾሳዉ ጌሼዳ። <verse eid="LEV 8:15"/><verse number="16" style="v" sid="LEV 8:16"/>ቃን አሹዋ ካሜዳ ሀንዳ ኡባ፥ ትርያ ጼራ ቦላ ደእያ ሞያ፥ ላኡ ክላሆቱዋነ ኡንቱንታ ካሜዳ ሀንዳ አኪደ፥ ሙሴ ያርሽያ ሳኣ ቦላን ዎደ ጹጌዳ። <verse eid="LEV 8:16"/><verse number="17" style="v" sid="LEV 8:17"/>ሽን መና ጎዳይ ሙሳ አዛዜዳዋዳን፥ ጋልባ፥ ኮሩማፐ አቴዳዋነ ቶጭያ ዱንካኔዳ ሳኣፐ ጋጻ ከሲደ፥ ታማን ጹጌዳ።<verse eid="LEV 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 8:18"/>ያት ስሚደ ሙሴ ጹግያ ያርሾ ሀንያ ዶርሳ ኦርግያ አሄዳ፤ አሮንነ አ አቱማ ናናይ ሄ ዶርሳ ኦርግያ ሁጲያን ባረንቱ ኩሽያ ዎድኖ። <verse eid="LEV 8:18"/><verse number="19" style="v" sid="LEV 8:19"/>ሙሴ ሄ ዶርሳ ኦርግያ ሹኬዳ፤ አ ሱ ያርሽያ ሳኣ ምይያ ኡባን ጉሴዳ። <verse eid="LEV 8:19"/><verse number="20" style="v" sid="LEV 8:20"/>ቃይ ዶርሳ ኦርግያ አሹዋካ አ ቆሙዋን ቆሙዋን ቃንጼዳ፤ ቃንጸ፥ ሁጲያነ ሞያ ያርሽያ ሳኣ ቦላ ዎደ ሙሴ ጹጌዳ። <verse eid="LEV 8:20"/><verse number="21" style="v" sid="LEV 8:21"/>ቃን አሹዋነ ገደቱዋ ሃን ሜጮዋፐ ጉይያን፥ ዶርሳ ኡባና መና ጎዳዉ ታማን ጹግያ፥ ሳዉዋ ቶሹኩ ግያ ያርሹዋ ኦደ፥ መና ጎዳይ ሙሳ አዛዜዳዋዳን ያርሽያ ሳኣ ቦላን ዎደ ጹጌዳ።<verse eid="LEV 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 8:22"/>ሄዋፐ ጉይያን፥ ቄሰተዉ ኦከትያ ዎደ ሺሽያ ላኤን ዶርሳ ሙሴ አሄዳ፤ አሮንነ አ አቱማ ናናይ ሄ ዶርሳ ሁጲያን ባረንቱ ኩሽያ ዎድኖ። <verse eid="LEV 8:22"/><verse number="23" style="v" sid="LEV 8:23"/>ሙሴ ሄ ዶርሳ ሹኬዳ፤ አ ሱፐ አኪደ፥ አሮናዉ ኡሸቻ ሀይ ጼራ፥ ኡሸቻ ኩሽያ ዎጋ ብራያነ፥ ኡሸቻ ገድያ ዎጋ ብራያ ኦኬዳ። <verse eid="LEV 8:23"/><verse number="24" style="v" sid="LEV 8:24"/>ቃይ ሙሴ አሮና አቱማ ናናቱዋካ ስንዉ አሂደ፥ ሄ ሱፐ አኪደ፥ ኡንቱንቱ ኡሸቻ ሀይ ጼራ፥ ኡንቱንቱ ኡሸቻ ኩሽያ ዎጋ ብራያነ ኡንቱንቱ ኡሸቻ ገድያ ዎጋ ብራያ ኦኬዳ። ሄዋፐ ጉይያን፥ ሙሴ አቴዳ ሱ ያርሽያ ሳኣ ምይያ ኡባን ጉሴዳ።<verse eid="LEV 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 8:25"/>ያቲደ ሞዋ፥ ናስያ፥ ቃን አሹዋ ማዬዳ ሞያ፥ ትርያ ጼራ ቦላ ደእያ ሞያ፥ ላኡ ክላሆቱዋነ ኡንቱንታ ማዬዳ ሀንዳነ ኡሸቻ ገድያ አኬዳ። <verse eid="LEV 8:25"/><verse number="26" style="v" sid="LEV 8:26"/>ቃይ እርሹዋ የገናን ኡኬዳ ኡክ ዎያ መና ጎዳ ስንን ደእያ ማሶፍያፐ እት ኮምፑዋ፥ ዛይትያና ኡኬዳ እት ኡክነ እት ሌኦ ኡክ አኪደ፥ ሀዋንታ ሞያ ቦላንነ ኡሸቻ ገድያ ቦላን ዎዳ። <verse eid="LEV 8:26"/><verse number="27" style="v" sid="LEV 8:27"/>እ ሀ ቁማ ኡባ አሮና ኩሽያንነ አ አቱማ ናናቱዋ ኩሽያን ዎዳ፤ ኡንቱንቱ መና ጎዳ ስንን ቃያ ያርሹዋ ኦደ ቃድኖ። <verse eid="LEV 8:27"/><verse number="28" style="v" sid="LEV 8:28"/>ሄዋፐ ጉይያን፥ ሙሴ ሄ ቁማ ኡንቱንቱ ኩሽያፐ አክ፥ ጹግያ ያርሹዋና ጋደ፥ ቄሰተዉ ኦከትያ ዎደ መና ጎዳዉ ታማን ጹጊደ ሺሽያ፥ ሳዉዋ ቶሹኩ ግያ ያርሹዋዳን፥ ያርሽያ ሳኣ ቦላን ዎደ ጹጌዳ። <verse eid="LEV 8:28"/><verse number="29" style="v" sid="LEV 8:29"/>ቃይ ሙሴ አንጎሱዋ አኪደ፥ ቃያ ያርሹዋ ኦደ መና ጎዳ ስንን ቃዳ፤ መና ጎዳይ ሙሳ አዛዜዳዋዳን፥ ቄሳተዉ ኦከትያ ዎደ ያርሽያ ዶርሳ ኦርግያ አሹዋፐ ሄዌ ሙሳ ጋክያ አ ግሹዋ።<verse eid="LEV 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 8:30"/>ሙሴ ኦክያ ዛይትያፐነ ያርሽያ ሳኣ ቦላን ደእያ ሱፐ አኪደ፥ አሮና ቦላነ አ ማዩዋ ቦላ፥ ቃይ አ አቱማ ናናቱዋ ቦላነ፥ ኡንቱንቱ ማዩዋ ቦላካ ጫጫፌዳ፤ ያቲደ አሮናነ አ ማዩዋ ቃይ አ ናናቱዋነ አ ናናቱዋ ማዩዋካ ጌሼዳ።<verse eid="LEV 8:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 8:31"/>ሙሴ አሮናነ አ አቱማ ናናቱዋ ሀዋዳን ያጌዳ፤ “አሹዋ ጋከትያ ዱንካንያ ካረን ዶይስተ፤ ‘አሮንነ አ ናናይ ሄዋ ሚኖ’ ያጋደ ታን አዛዜዳዋዳን፥ ቄሳተዉ ኦከትያ ዎደ ሺሽያ ያርሹዋ ዎያ ማሶፍያ ግዶን ደእያ ያርሹዋ ኡክና ሄዋን ሚተ። <verse eid="LEV 8:31"/><verse number="32" style="v" sid="LEV 8:32"/>ሄ አሹዋፐነ ኡክፐ ፓላሄዳዌ ደኦፐ ታማን ጹግተ። <verse eid="LEV 8:32"/><verse number="33" style="v" sid="LEV 8:33"/>ቄሳተዉ ኦክያ ዎጋይ ላፑን ጋላሳ አክያ ድራዉ፥ ሄ ህንተ ቄሳተዉ ኦከትያ ላፑን ጋላሳይ ዉራናዉ፥ ዱንካንያ ፐንገፐ ካረ ከሶፕተ። <verse eid="LEV 8:33"/><verse number="34" style="v" sid="LEV 8:34"/>ሀ ሀች ኦሰቴዳዌ መና ጎዳይ አዛዝና፥ ህንተ ናጋራ አቶ ጊሳናዉ ኦሰቴዳ። <verse eid="LEV 8:34"/><verse number="35" style="v" sid="LEV 8:35"/>ዱንካንያ ፐንግያን ላፑን ጋላሳ ኩመን ጋላስነ ቃማነ ታክተ፤ መና ጎዳ ዎጋካ ናግተ፤ እጾፐ ህንተ ሀይቃና። ታና መና ጎዳይ አዛዜዳዌ ሀዋ” ያጌዳ። <verse eid="LEV 8:35"/><verse number="36" style="v" sid="LEV 8:36"/>አሮንነ አ ናናይ መና ጎዳይ ሙሴ ባጋና አዛዜዳዋ ኡባ ኦድኖ።<verse eid="LEV 8:36"/></para>
  <chapter eid="LEV 8"/>
  <chapter number="9" style="c" sid="LEV 9"/>
  <para style="s1">አሮን ጾሳዉ ሺሽያ ያርሹዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 9:1"/>ሆስፑን ጋላሳን ሙሴ አሮናነ አ ናናቱዋ፥ ቃይ እስራኤልያ ጭማቱዋካ ጼሴዳ። <verse eid="LEV 9:1"/><verse number="2" style="v" sid="LEV 9:2"/>አሮና ሀዋዳን ያጌዳ፤ “ናጋራ ያርሾ እት ኮሩማ፥ ቃይ ጹግያ ያርሾ እት ዶርሳ ኦርግያ መና ጎዳ ስን ሺሻ። መሄቱ ላኡካ ትላ ቦላና ደእያዋንታ ግድኖ። <verse eid="LEV 9:2"/><verse number="3" style="v" sid="LEV 9:3"/>ቃይ እስራኤልያ አሳ ሀዋዳን ያጋ፤ ‘መና ጎዳይ ህንተንቶ ቆንጭያ ድራዉ፥ መና ጎዳ ስንን ያርሻናዉ፥ ናጋራ ያርሾ እት ዴሻ ኦርግያ፥ ጹግያ ያርሾ ትላ ቦላና ደእያ እት ላይ ማራነ እት ላይ ዶርሳ አሆ። <verse eid="LEV 9:3"/><verse number="4" style="v" sid="LEV 9:4"/>እትፐተ ያርሾ እት ኮሩማ፥ እት ዶርሳ ኦርግያነ ዛይትያን ሙናቀቴዳ ካ ያርሹዋ አህተ ያጋ’ ” ያጌዳ።<verse eid="LEV 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 9:5"/>ኡንቱንቱ ሙሴ አዛዜዳዋ ኡባ ጾሳ ዱንካንያ ስን አሄድኖ፤ ያቲደ ማባራ ኡባይ ሺቂደ፥ መና ጎዳ ስንን ኤቄድኖ። <verse eid="LEV 9:5"/><verse number="6" style="v" sid="LEV 9:6"/>ሙሴ ኡንቱንታ፥ “መና ጎዳ ቦንቹ ህንተንቶ ቆንጫና ማላ፥ ህንተ ኦናዳን መና ጎዳይ ህንተና አዛዜዳዌ ሀዋ” ያጌዳ።<verse eid="LEV 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 9:7"/>ቃይ ሙሴ አሮናዉ ሀዋዳን ያጌዳ፤ “ያርሽያ ሳኮ ሃ ሺቃ፤ ነ ናጋራ ያርሹዋነ ነ ጹግያ ያርሹዋ ያርሻ፤ ያታደ ነ ሁጰ ናጋራነ ነ አሳ ናጋራካ አቶ ጊሳ። ቃይ መና ጎዳይ አዛዜዳዋዳን፥ አሳይ ሺሽያ ያርሹዋ ያርሻደ፥ ኡንቱንቱ ናጋራካ አቶ ጊሳ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="HEB 7:27">እብራ. 7:27</ref></char></note><verse eid="LEV 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 9:8"/>አሮን ያርሽያ ሳኮ ዪደ፥ ባረ ሁጰ ናጋራዉ ያርሹዋ ኦ ሺሼዳ ኮሩማ ሹኬዳ። <verse eid="LEV 9:8"/><verse number="9" style="v" sid="LEV 9:9"/>አሮና አቱማ ናናይ ሱፐ አኪደ አዉ አሄድኖ፤ እ ባረ ኩሽያ ብራያ ሄ ሱን የድ ከሲደ፥ ያርሽያ ሳኣ ካጨቱዋ ቦቼዳ፤ አቴዳ ሱካ ያርሽያ ሳኣፐ ጋርሳ ባጋና ጉሴዳ። <verse eid="LEV 9:9"/><verse number="10" style="v" sid="LEV 9:10"/>መና ጎዳይ ሙሳ አዛዜዳዋዳን፥ ቃይ ሄ ናጋራ ያርሹዋ አሹዋፐ ሞዋ፥ ክላሆቱዋነ ትርያ ጼራ ቦላ ደእያ ሞያ ያርሽያ ሳኣ ቦላን ዎደ ጹጌዳ። <verse eid="LEV 9:10"/><verse number="11" style="v" sid="LEV 9:11"/>ሽን አቴዳ አሹዋነ ጋልባ ዱንካኔዳ ሳኣፐ ካረ ከሲደ ጹጌዳ።<verse eid="LEV 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 9:12"/>ሄዋፐ ጉይያን፥ አሮን ጹግያ ያርሹዋ ሹኬዳ፤ አ ናናይ ሱ አኪደ አዉ አሄድኖ፤ እ ያርሽያ ሳኣ ምይያ ኡባን ጉሴዳ። <verse eid="LEV 9:12"/><verse number="13" style="v" sid="LEV 9:13"/>ቃይ ኡንቱንቱ ጹግያ ያርሹዋ ቆሙዋን ቆሙዋን ከሲደ፥ ሁጲያናካ አዉ አሄድኖ፤ እ ያርሽያ ሳኣ ቦላን ዎደ ጹጌዳ። <verse eid="LEV 9:13"/><verse number="14" style="v" sid="LEV 9:14"/>ቃን አሹዋነ ገደቱዋካ ሃን ሜጪደ፥ ያርሽያ ሳኣ ቦላን ደእያ ጹግያ ያርሹዋ ቦላን ዎደ ጹጌዳ።<verse eid="LEV 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 9:15"/>ሄዋፐ ጉይያን፥ አሮን አሳ ያርሹዋ ሺሼዳ፤ እ አሳ ናጋራ ያርሾ ግድያ ዴሻ ኦርግያ አኪደ ሹኬዳ፤ ካሰ ባረዋዳንካ ኡንቱንቱ ናጋራዉ ያርሼዳ። <verse eid="LEV 9:15"/><verse number="16" style="v" sid="LEV 9:16"/>ቃይ እ ጹግያ ያርሹዋ መህያ አሂደ፥ ዎጋይ አዛዝያዋዳን ኦደ ያርሼዳ። <verse eid="LEV 9:16"/><verse number="17" style="v" sid="LEV 9:17"/>ካ ያርሹዋካ ሺሼዳ፤ አፐ እት ኮጵያ ግድያዋ አኪደ፥ ዎንታ ዎንታ ጹግያ ያርሹዋፐ ሀራ አ ቦላን ዎደ ጹጌዳ።<verse eid="LEV 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 9:18"/>አሮን ቃይካ አሳ እትፐተ ያርሾ ኮሩማነ ዶርሳ ኦርግያ ሹኬዳ፤ አ አቱማ ናናይ ሱ አዉ አሄድኖ፤ እ ሄ ሱ አኪደ፥ ያርሽያ ሳኣ ምይያ ኡባ ጉሴዳ።<note caller="-" style="x"><char style="xo" closed="false">9:18 </char><char style="xt" closed="false"><ref loc="LEV 3:1-11">ዎጋ 3:1-11</ref></char></note> <verse eid="LEV 9:18"/><verse number="19" style="v" sid="LEV 9:19"/>ቃይ ኮሩማነ ዶርሳ ኦርግያ አሹዋፐ ሞዋ፥ ናስያ፥ ቃን አሹዋ ማዬዳ ሀንዳ፥ ክላሆቱዋነ ትርያ ጼራ ቦላ ደእያ ሞያ አሮና ናናይ አዉ አሄድኖ። <verse eid="LEV 9:19"/><verse number="20" style="v" sid="LEV 9:20"/>ኡንቱንቱ ሄ ሀንዳ አንጎሱዋ ቦላ ዎና፥ አሮን ያርሽያ ሳኣ ቦላን ሄዋ ጹጌዳ። <verse eid="LEV 9:20"/><verse number="21" style="v" sid="LEV 9:21"/>ሽን ሙሴ አዛዜዳዋዳን፥ አሮን አንጎሶቱዋነ ኡሸቻ ገድያ ቃያ ያርሹዋ ኦደ፥ መና ጎዳ ስንን ቃዳ።<verse eid="LEV 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 9:22"/>ሄዋፐ ጉይያን፥ አሮን ባረ ኩሽያ አሳኮ ዛር ደንደ ኡንቱንታ አንጄዳ። እ ናጋራ ያርሹዋ፥ ጹግያ ያርሹዋነ እትፐተ ያርሹዋ ያርሾዋፐ ጉይያን፥ ያርሽያ ሳኣፐ ዱገ ዎዳ።<note caller="-" style="x"><char style="xo" closed="false">9:22 </char><char style="xt" closed="false"><ref loc="NUM 6:22-26">ፓይ. 6:22-26</ref></char></note> <verse eid="LEV 9:22"/><verse number="23" style="v" sid="LEV 9:23"/>ሙሴነ አሮን መና ጎዳ ዱንካንያ ግዶ ገሌድኖ፤ ኡንቱንቱ ሄዋፐ ከሴዳ ዎደ፥ አሳ አንጄድኖ። ያትና መና ጎዳ ቦንቹ አሳ ኡባዉ ቤቴዳ። <verse eid="LEV 9:23"/><verse number="24" style="v" sid="LEV 9:24"/>መና ጎዳ ስንፐ ታማይ ዎደ፥ ያርሽያ ሳኣ ቦላን ደእያ ጹግያ ያርሹዋነ ሞያ ሜዳ። አሳይ ኡባይ ሄዋ በኤዳ ዎደ እልሌዳ፤ ቃይ ኡንቱንቱ ባረንቱ ሶምኡዋን ሳኣ ቦቺደ ጉፋኔድኖ።<verse eid="LEV 9:24"/></para>
  <chapter eid="LEV 9"/>
  <chapter number="10" style="c" sid="LEV 10"/>
  <para style="s1">ናዳብነ አብሁ ኦዳ ናጋራ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 10:1"/>አሮና አቱማ ናናይ፥ ናዳብነ አብሁ፥ ባረንቱ እጻና ጩውስያ ሚሻ አኪደ፥ አ ቦላን ታማ ዎድኖ፤ ታማ ቦላ ቃይ እጻና ቆሌድኖ፤ ያቲደ፥ መና ጎዳይ ኡንቱንታ አዛዝቤና፥ ሀራ ታማ መና ጎዳ ስንን ሺሼድኖ። <verse eid="LEV 10:1"/><verse number="2" style="v" sid="LEV 10:2"/>ሄዋ ጋሱዋን መና ጎዳ ስንፐ ታማይ ዪደ፥ ኡንቱንታ ሜዳ፤ ኡንቱንቱካ መና ጎዳ ስንን ሀይቄድኖ። <verse eid="LEV 10:2"/><verse number="3" style="v" sid="LEV 10:3"/>ሄዋፐ ጉይያን፥ ሙሴ አሮና፥ “መና ጎዳይ፥</para>
  <para style="q1" vid="LEV 10:3">“ ‘ታን ታ ማታ ሺቅያዋንታ</para>
  <para style="q2" vid="LEV 10:3">ታ ጌሻተ በሳና።</para>
  <para style="q1" vid="LEV 10:3">ቃይ አሳ ኡባ ስንን</para>
  <para style="q2" vid="LEV 10:3">ታን ቦንቼታና’ ”</para>
  <para style="m" vid="LEV 10:3">ጊደ ሃሳዬዳዌ በአ ሀዋ ያጌዳ። አሮን ጮኡ ጌዳ።<verse eid="LEV 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 10:4"/>ሙሴ አሮና አዉዋ እሻ ኡዝኤላ አቱማ ናናቱዋ፥ ምሻኤላነ ኤልጻፋና ጼጊደ፥ “ሃ ዪተ፤ ህንተ አዉዋ እሻ ናናቱዋ አሃ ጾሳ ዱንካንያ ስንፐ ደንደ፥ ዱንካኔዳ ሳኣፐ ጋጻ ከስተ” ያጌዳ። <verse eid="LEV 10:4"/><verse number="5" style="v" sid="LEV 10:5"/>ሄዋ ድራዉ ኡንቱንቱ ዪደ፥ ሙሴ አዛዜዳዋዳን፥ ባረንቱ ቄሰተ ማዩዋና ኡንቱንቱ አሃ ቶኪደ፥ ዱንካኔዳ ሳኣፐ ጋጻ ከሴድኖ።<verse eid="LEV 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 10:6"/>ሄዋፐ ጉይያን፥ ሙሴ አሮናነ አ አቱማ ናናቱዋ፥ ኤልኣዛራነ እታማራ ሀዋዳን ያጌዳ፤ “ህንተ ሀይቀና ማላነ፥ መና ጎዳይ ማባራ ኡባ ቦላን ሀንቀተና ማላ፥ ህንተ ሁጲያ ሜድሶፕተ፤ ህንተ ማዩዋካ ፔፕተ። ሽን ህንተ እሻቱ፥ እስራኤልያ አሳቱ፥ መና ጎዳይ ባረ ኤዳ ታማን ጹጌዳዋንቶ ዬካና ጎፐ ኡንቱንቱ ዬክኖ። <verse eid="LEV 10:6"/><verse number="7" style="v" sid="LEV 10:7"/>ቃይካ ህንተ ዱንካንያ ፐንግያፐ ካረ ከሶፐ ህንተ ሀይቃና፤ አያዉ ጎፐ ጾሳይ ኦክያ ዛይቲ ህንተ ቦላን ደኤ” ያጌዳ። ኡንቱንቱካ ሙሴ ጌዳዋዳን ኦድኖ።<verse eid="LEV 10:7"/></para>
  <para style="s1">ቄሳቱዋ ዎጋ</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 10:8"/>መና ጎዳይ አሮና ሀዋዳን ያጌዳ፤ <verse eid="LEV 10:8"/><verse number="9" style="v" sid="LEV 10:9"/>“ህንተ ሀይቀና ማላ፥ ዱንካንያ ግዶ ገልያ ዎደ፥ ኔንካ ነ ናናይካ ዎይንያ ኤሳ ዎይ ሀራ ማይያ ኡሻ ኡሾፕተ፤ ሄዌ ስንፐ ያና የለታዉካ መናዉ ህገ ግዲደ ደአና። <verse eid="LEV 10:9"/><verse number="10" style="v" sid="LEV 10:10"/>ህንተ ጌሻነ ጌሻ ግደናባ ቃይ ቱናነ ቱና ግደናባ ሻኪደ ኤርተ። <verse eid="LEV 10:10"/><verse number="11" style="v" sid="LEV 10:11"/>መና ጎዳይ ሙሴ ባጋና ኦዴዳ ዎጋ ኡባካ እስራኤልያ አሳ ታማርስተ” ያጌዳ።<verse eid="LEV 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 10:12"/>ሙሴ አሮናነ አቴዳ አ አቱማ ናናቱዋ ኤልኣዛራነ እታማራ ሀዋዳን ያጌዳ፤ “መና ጎዳዉ ታማን ጹግያ ያርሹዋፐ አቴዳ ካ ያርሹዋ አኪደ፤ እርሹዋ የገናን ኡክተ፤ ያቲደ እ ሎይ ጌሻ ግድያ ድራዉ፥ ያርሽያ ሳኣ ማታን አ ሚተ።<note caller="-" style="x"><char style="xo" closed="false">10:12-13 </char><char style="xt" closed="false"><ref loc="LEV 6:14-18">ዎጋ 6:14-18</ref></char></note> <verse eid="LEV 10:12"/><verse number="13" style="v" sid="LEV 10:13"/>መና ጎዳዉ ታማን ጹግያ ያርሹዋፐ ሄዌ ኔናነ ነ አቱማ ናናቱዋ ጋክያ ህንተ ግሹዋ ግድያ ድራዉ፥ ሄዋ ህንተ ጌሻ ሳኣን ሚተ፤ አያዉ ጎፐ፥ ጾሳይ ታና ሄዋዳን ኦና ማላ አዛዜዳ። <verse eid="LEV 10:13"/><verse number="14" style="v" sid="LEV 10:14"/>ሽን ቃዳ አንጎሱዋነ ሺቄዳ ገድያ ኔን፥ ነ አቱማ ናናይነ ነ ማጫ ናናይ ዎጋዳን ጌሻ ሳኣን ሚተ። አያዉ ጎፐ፥ ሄዌ እስራኤልያ አሳይ ሺሽያ እትፐተ ያርሹዋፐ ኔናነ ነ አቱማ ናናቱዋ ጋክያ ህንተ ግሹዋ።<note caller="-" style="x"><char style="xo" closed="false">10:14-15 </char><char style="xt" closed="false"><ref loc="LEV 7:30-34">ዎጋ 7:30-34</ref></char></note> <verse eid="LEV 10:14"/><verse number="15" style="v" sid="LEV 10:15"/>መና ጎዳዉ ያርሼዳ ገድያነ ቃዳ አንጎሱዋ አሳይ ታማን ጹግያ ሞያና እትፐ ጋደ፥ መና ጎዳ ስንን ቃያ ያርሹዋዳን ቃናዉ አሀና። መና ጎዳይ አዛዜዳዋዳን፥ ሄዌ ነዉነ ኔናና ደእያ ነ አቱማ ናናቶ መናዉ ህንተና ጋክያ ህንተ ግሹዋ ግዳናዋ” ያጌዳ።<verse eid="LEV 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 10:16"/>ሙሴ ናጋራ ያርሹዋ ዴሻይ ዋኔደንቶነ ኤራናዉ ኮዪደ ኦቼዳ፤ እ ጹገት ድጌዳዋ ኤሬዳ ዎደ፥ አቴዳ አሮና አቱማ ናናቱዋ፥ ኤልኣዛራነ እታማራ ሀንቀቴዳ፤ ኡንቱንቱ፥ <verse eid="LEV 10:16"/><verse number="17" style="v" sid="LEV 10:17"/>“ናጋራ ያርሹ ሎይ ጌሻ ግዴዳዋንቱ ግዱዋፐ እቱዋ ግዴዳ ጌሻ፤ ቃይ ሄዌካ አሳ ናጋራ መና ጎዳ ስንን አቶ ጊሳና ማላ ህንተንቶ እመቴዳ፤ ያትና ህንተ አ ሎይ ጌሻ ሳኣን አያዉ ምበይክቴ?<note caller="-" style="x"><char style="xo" closed="false">10:17 </char><char style="xt" closed="false"><ref loc="LEV 6:24-26">ዎጋ 6:24-26</ref></char></note> <verse eid="LEV 10:17"/><verse number="18" style="v" sid="LEV 10:18"/>ሄ መህያ ሱይ መና ጎዳ ዱንካንያ ግዶ ገልቤናዋ ግዶደ፥ ታን ህንተና አዛዜዳዋዳን፥ ህንተ አ ሄ ጌሻ ሳኣን ማናዉ በሴ፤ ሽን አጌድታ” ያጌዳ።<verse eid="LEV 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 10:19"/>አሮን ሙሳ፥ “በአ፤ አሳቱ ሀች ባረንቱ ናጋራ ያርሹዋነ ጹግያ ያርሹዋ መና ጎዳ ስን አሄድኖ፤ ግዶፐነ ቃይ ሀዋ ማላባይ ታ ቦላ ጋኬዳ። ያትና ዎን ታን ናጋራ ያርሹዋ ሀች ሜዳዋ ግድንቶነ፥ መና ጎዳይ ናሸታናዋ ሽን አቴዴሻ?” ያጌዳ። <verse eid="LEV 10:19"/><verse number="20" style="v" sid="LEV 10:20"/>ሙሴ ሄዋ ስሴዳ ዎደ፥ ሄ ዛሩ አ አሌዳ።<verse eid="LEV 10:20"/></para>
  <chapter eid="LEV 10"/>
  <chapter number="11" style="c" sid="LEV 11"/>
  <para style="ms">ጌይያ ዎጋን ጌሻ ግድያዋነ ግደናዋ ሻኩሳ</para>
  <para style="mr">(<ref loc="LEV 11:1-15:33">11:1—15:33</ref>)</para>
  <para style="s1">ማናዉ በስያ መታቱዋ</para>
  <para style="r">(<ref loc="DEU 14:3-21">ዛረ. 14:3-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 11:1"/>መና ጎዳይ ሙሳነ አሮና ሀዋዳን ያጌዳ፤ <verse eid="LEV 11:1"/><verse number="2" style="v" sid="LEV 11:2"/>“እስራኤልያ አሳዉ ሀዋዳን ያጊደ ኦድተ፤ ‘ቢታ ቦላን ደእያ መህያ ኡባፐ ህንተ ማና መሄቱነ ዶአቱ ሀዋንታ። <verse eid="LEV 11:2"/><verse number="3" style="v" sid="LEV 11:3"/>ጹጉንይ ዉር ጳልቀቴዳዋንታነ ዋሞትያ መሄቱዋ ኡባ ሚተ። <verse eid="LEV 11:3"/><verse number="4" style="v" sid="LEV 11:4"/>ሽን ዋሞ ጻላላ ዋሞትያዋንታ ዎይ ቃይ ጹጉን ጻላላይ ጳልቀቴዳዋንታ ሞፕተ። ጋሉ ዋሞቴ ሽን ጹጉንይ ጳልቀትቤና ድራዉ እ ህንተንቶ ቱና። <verse eid="LEV 11:4"/><verse number="5" style="v" sid="LEV 11:5"/>ጉፓሊ ዋሞቴ ሽን ጹጉንይ ጳልቀትቤና ድራዉ እ ህንተንቶ ቱና። <verse eid="LEV 11:5"/><verse number="6" style="v" sid="LEV 11:6"/>ሀርባይን ዋሞቴ ሽን ሞፕተ፤ አያዉ ጎፐ፥ እ ዋሞትያዋ ግዶፐነ፥ አዉ ጹጉንይ ጳልቀ ግደና ድራዉ፥ እ ህንተንቶ ቱና። <verse eid="LEV 11:6"/><verse number="7" style="v" sid="LEV 11:7"/>ጉዱንካ ሞፕተ፤ አያዉ ጎፐ፥ አዉ ጹጉንይ ጳልቀ ግዶፐነ፥ ዋሞተና ድራዉ፥ እ ህንተንቶ ቱና። <verse eid="LEV 11:7"/><verse number="8" style="v" sid="LEV 11:8"/>ህንተ ሀዋንቱ አሹዋ ሞፕተ፤ ኡንቱንቱ ባኩታካ ቦቾፕተ፤ ኡንቱንቱ ህንተንቶ ቱና።<verse eid="LEV 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 11:9"/>“ ‘ሃ ግዶን ደእያ መታቱዋ ኡባፐ ህንተ ማናዋንቱ ሀዋንታ። አባ ግዶን ግድና ዎይ ቃይ ጎግያ ሃ ግዶን ግድና ደእያ ኡባፐ ሞልያ ማላ ቀፊነ ፖቁ ደእያ ኡባ ሚተ። <verse eid="LEV 11:9"/><verse number="10" style="v" sid="LEV 11:10"/>ሽን አባ ግዶን ዎይ ሻፋን ሻምእሻምእያ መታቱዋፐነ ሸምፑ ደእያ፥ ቃጽያ መታቱዋፐ ሞልያ ማላ ቀፊነ ፖቁ ባይና ኡባይ ህንተንቶ ቱና። <verse eid="LEV 11:10"/><verse number="11" style="v" sid="LEV 11:11"/>ሀዋንቱ ህንተንቶ ቱና፤ ኡንቱንቱ አሹዋ ሞፕተ፤ ኡንቱንቱ ባኩታካ ቦቾፕተ። <verse eid="LEV 11:11"/><verse number="12" style="v" sid="LEV 11:12"/>ቀፊነ ፖቁ ባይና ሃ ግዶን ደእያ መታቱ ኡባይ ህንተንቶ ቱና።<verse eid="LEV 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 11:13"/>“ ‘ካፎቱዋፐ ቱና ግድያ ድራዉ ህንተ ሜናዋንቱ ሀዋንታ: አርጋን፥ ባዙዋ አንኩዋ፥ ካረ አንኩዋ፥ <verse eid="LEV 11:13"/><verse number="14" style="v" sid="LEV 11:14"/>ጽንግልያ፥ ቆል ዛርያ ኡባ፥ <verse eid="LEV 11:14"/><verse number="15" style="v" sid="LEV 11:15"/>ቁሩዋ ዛርያ ኡባ፥ <verse eid="LEV 11:15"/><verse number="16" style="v" sid="LEV 11:16"/>ሶጎንያ፥ ሀዛዝያ፥ ሃ ካፉዋ፥ ጋጭያ ዛርያ ኡባ፥ <verse eid="LEV 11:16"/><verse number="17" style="v" sid="LEV 11:17"/>ቄር ጉቱዋ፥ ብዩዋ፥ ዎጋ ጉቱዋ፥ <verse eid="LEV 11:17"/><verse number="18" style="v" sid="LEV 11:18"/>ሃ ኩቱዋ፥ ሞልያ ካፉዋ፥ ባኩታ ምያ አንኩዋ፥ <verse eid="LEV 11:18"/><verse number="19" style="v" sid="LEV 11:19"/>ሽማላነ ሳቢሳ ግያ ሃ ካፎቱዋ ዛርያ ኡባ፥ ጅንጅላትያነ ሻልያ።<verse eid="LEV 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 11:20"/>“ ‘ቀፍያና ደእያ ኦይዱ ገድያን ሀመትያ ቄር መታቱ ኡባይ ህንተንቶ ቱና። <verse eid="LEV 11:20"/><verse number="21" style="v" sid="LEV 11:21"/>ግዶፐነ፥ ቀፊ ደእያ ኦይዱ ገድያን ሀመትያዋንቱፐ ኡንቱንቱ ገድያፐ ቦላና ጉፓናዉ ማድያ ገዲ ደእያዋንታ ሚተ። <verse eid="LEV 11:21"/><verse number="22" style="v" sid="LEV 11:22"/>ሄዋንቱካ፥ ቦልያ ዛርያ ኡባ፥ ኡኩቦ ዛርያ ኡባነ ቡምቡረ ዛርያ ኡባ። <verse eid="LEV 11:22"/><verse number="23" style="v" sid="LEV 11:23"/>ሽን ሀራ ቀፍያና ደእያ ኦይዱ ገዲ ደእያ መታቱ ኡባይ ህንተንቶ ቱና።<verse eid="LEV 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 11:24"/>“ ‘ሀዋንቱ ህንተና ቱንሳና፤ ኡንቱንቱ ባኩታ ቦችያ ኡባይ ኦማርስ ጋካናዉ ቱና ግዳናዋ። <verse eid="LEV 11:24"/><verse number="25" style="v" sid="LEV 11:25"/>ሀዋንቱ ባኩታ ደንያ ኦንነ ባረ ማዩዋ ሜጮ፤ ሽን ግዶፐነ ኦማርስ ጋካናዉ እ ቱና። <verse eid="LEV 11:25"/><verse number="26" style="v" sid="LEV 11:26"/>ጹጉንይ ደኢደ ጳልቀ ግደናዋንታ ዎይ ቃይ፥ ዋሞተናዋንቱ ኡባይ ህንተንቶ ቱና፤ ኡንቱንቱ አሃ ቦችያ ኦንካ ቃይ ቱና። <verse eid="LEV 11:26"/><verse number="27" style="v" sid="LEV 11:27"/>ኦይዱ ገደቱዋን ሀመትያ መህያ ኡባፐ አዳነቱዋ ግንድያ ማላ ግንድያን ሀመትያዋንቱ ህንተንቶ ቱና፤ ቃይ ኡንቱንቱ ባኩታ ቦችያ ኦንካ ኦማርስ ጋካናዉ ቱና። <verse eid="LEV 11:27"/><verse number="28" style="v" sid="LEV 11:28"/>ሄዋንቱ ባኩታ ደንያ ኦንነ ባረ ማዩዋ ሜጮ፤ ሽን ግዶፐነ ኦማርስ ጋካናዉ እ ቱና። ኡንቱንቱካ ህንተንቶ ቱና።<verse eid="LEV 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 11:29"/>“ ‘ሳኣና ሀመትያዋንቱፐ ሀዋንቱ ህንተንቶ ቱና: ኦጩ፥ ኤጨሪ፥ ዱማ ዱማ ቆሞ ዛሪ፥ <verse eid="LEV 11:29"/><verse number="30" style="v" sid="LEV 11:30"/>ጌግ፥ ሀይላሹ፥ ኮርቺ፥ ዋካላይነ ሻቃንቻይ። <verse eid="LEV 11:30"/><verse number="31" style="v" sid="LEV 11:31"/>ሳኣና ሀመትያ ኡባቱዋፐ ህንተንቶ ቱና ግድያዋንቱ ሄዋንታ፤ ኡንቱንቱፐ ሀዬዳዋ ቦችያ ኡባይ ኦማርስ ጋካናዉ ቱና። <verse eid="LEV 11:31"/><verse number="32" style="v" sid="LEV 11:32"/>ኡንቱንቱፐ ሀይቄዳዌ አያ ቦላ ኩንዶፐካ ሄ ኡንቱንቱ አ ቦላ ኩንዴዳ ሚሻይ ቱና፤ ም ሚሻ ዎይ ማዩዋ ዎይ ጋልባ ዎይ ኬሻቱዋ ግድናካ፥ ጎኤትያ ሚሻ ኡባ ሃ ግዶን ዎተ፤ ሄዌ ኦማርስ ጋካናዉ ቱና፤ ሄዋፐ ጉይያን፥ ጌሻ ግዳናዋ። <verse eid="LEV 11:32"/><verse number="33" style="v" sid="LEV 11:33"/>ሀ ሳኣና ሀመትያዋንቱፐ እቱዋ ባኩታይ አይ ኡርቃ ሚሻ ግዶን ኩንዶፐካ፥ አ ግዶን ደእያባይ ኡባይ ቱና፤ ሄ ሚሻ መንተ። <verse eid="LEV 11:33"/><verse number="34" style="v" sid="LEV 11:34"/>ሄ ሚሻ ግዶን ደእያ ሃፐ ሜተትያ አይ ቁማ ቦላ ጾኮፐካ፥ ሄ ቁማይ ቱና፤ ቃይ ኡሽያባ አያነ ግዶ፥ ሄ ሚሻ ግዶን ደኦፐ፥ እካ ቱና። <verse eid="LEV 11:34"/><verse number="35" style="v" sid="LEV 11:35"/>ሀዋንቱ አሃይ አ ቦላ ኩንድያባይ አያ ግዶፐካ ቱና። ጮጭያ ዎይ ካያ ኡርቃ ሚሻ ግዶፐካ መንተ፤ ኡንቱንቱ ህንተንቶ ቱና። <verse eid="LEV 11:35"/><verse number="36" style="v" sid="LEV 11:36"/>ሀዋንቱ ባኩታይ ቦችያባይ ኡባይ ቱና ግዶፐነ፥ ፑልቱነ ሃ ኦላይ ጌሻ። <verse eid="LEV 11:36"/><verse number="37" style="v" sid="LEV 11:37"/>ኡንቱንቱ ባኩታፐ እቱ ዘራናዉ ዎዳ ዘረ ካ ቦላ ኩንዶፐ፥ ሄዌ ቱነና። <verse eid="LEV 11:37"/><verse number="38" style="v" sid="LEV 11:38"/>ሽን ሄ ዘረ ቦላ ሃይ ጉክ ስምና፥ ኡንቱንቱ ባኩታፐ እቱነ አ ቦላ ኩንዶፐ፥ ሄ ዘረይ ህንተንቶ ቱና።<verse eid="LEV 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 11:39"/>“ ‘ቃይ ህንተ ምያ መሄቱዋፐ እቱ ሀይቂና፥ አ ባኩታ ቦችያ ኦንነ ኦማርስ ጋካናዉ ቱና። <verse eid="LEV 11:39"/><verse number="40" style="v" sid="LEV 11:40"/>ኦንነ ሄ መህያ ባኩታፐ ሞፐ፥ ባረ ማዩዋ ሜጮ፤ ኦማርስ ጋካናዉ እ ቱና፤ ቃይ ኦንነ አ ባኩታ ቶኪደ ደንፐ፥ ባረ ማዩዋ ሜጮ፤ ኦማርስ ጋካናዉ እ ቱና።<verse eid="LEV 11:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LEV 11:41"/>“ ‘ሳኣና ጎሸትያ መታ ኡባይ ህንተንቶ ቱና፤ አ ሞፕተ። <verse eid="LEV 11:41"/><verse number="42" style="v" sid="LEV 11:42"/>ኡሉዋን ጎሸትያዋ ግድና፥ ዎይ ኦይዱ ገድያን ሀመትያዋ ግድና፥ ዎይ ቃይ ዳሮ ገዲ ደእያዋ ግድናካ፥ ሳኣና ጎሸትያ መታ ኡባይ ቱና ግድያ ድራዉ አ ሞፕተ። <verse eid="LEV 11:42"/><verse number="43" style="v" sid="LEV 11:43"/>ሳኣና ጎሸትያ መታቱዋ ኡባን ሚደ ህንተ ሁጲያዉ ቱኖፕተ፤ ቃይ ኡንቱንቱን ህንተ አሳተ ቱንሶፕተ። <verse eid="LEV 11:43"/><verse number="44" style="v" sid="LEV 11:44"/>ታን፥ መና ጎዳይ፥ ህንተ ጾሳ። ታን ጌሻ ግድያ ድራዉ፥ ህንተካ ህንተና ዱማዪደ፥ ጌሻ ግድተ። ሳኣና ጎሸትያዋንቱን ህንተ አሳተ ቱንሶፕተ።<note caller="-" style="x"><char style="xo" closed="false">11:44 </char><char style="xt" closed="false"><ref loc="LEV 19:2">ዎጋ 19:2</ref>፤ <ref loc="1PE 1:16">1 ጰጽ. 1:16</ref></char></note> <verse eid="LEV 11:44"/><verse number="45" style="v" sid="LEV 11:45"/>አያዉ ጎፐ፥ ታን ህንተ ጾሳ ግዳናዉ፥ ህንተና ግብጼ ጋድያፐ ከሴዳ መና ጎዳ። ሄዋ ድራዉ፥ ታን ጌሻ ግድያ ድራዉ፥ ህንተካ ጌሻ ግድተ ያግተ ያጌዳ።<verse eid="LEV 11:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 11:46"/>“ ‘መሄቱዋ፥ ካፎቱዋ፥ ሃ ግዶን ፓጻ ቃጽያ መታቱዋ ኡባቱነ ሳኣና ሀመትያ መታቱዋ ኡባቱዋ ዎጋይ ሀዋ። <verse eid="LEV 11:46"/><verse number="47" style="v" sid="LEV 11:47"/>ሄዌነ ህንተ ቱናነ ጌሻ፥ ቃይ ሸምፑ ደእያ መታቱዋፐ ምያዋንታነ ሜናዋንታ ሻኪደ ኤራናሳ።’ ”<verse eid="LEV 11:47"/></para>
  <chapter eid="LEV 11"/>
  <chapter number="12" style="c" sid="LEV 12"/>
  <para style="s1">ማጫ አሳይ የል ስሚደ ጌይያ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 12:1"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="LEV 12:1"/><verse number="2" style="v" sid="LEV 12:2"/>“እስራኤልያ አሳዉ ሀዋዳን ያጋደ ኦዳ፤ ‘እት ማጫዉና ሻሃራደ አቱማ ናኣ የሎፐ፥ ባረ ፒላይ ዬዳ ዎደ እዛ ቱና ግድያዋዳንካ፥ ሄዋዳን እዛ ላፑን ጋላሳይ ጋካናዉ ቱና ግዳናኑ። <verse eid="LEV 12:2"/><verse number="3" style="v" sid="LEV 12:3"/>ሆስፑን ጋላስ ናአይ ቃጻረታናዉ ኮሼ።<note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="GEN 17:12">ዶመ 17:12</ref>፤ <ref loc="LUK 2:21">ሉቃሳ 2:21</ref></char></note> <verse eid="LEV 12:3"/><verse number="4" style="v" sid="LEV 12:4"/>ሄዋፐ ጉይያን፥ ማጫዉና ባረ ፒላ ሱይ ጽአና ጋካናዉ፥ ሀታማነ ሄዙ ጋላሳ ጋምኡ፤ ቃይ ባረ ጌይያ ጋላሳቱ ዉራና ጋካናዉ፥ ጌሻባ አያነ ቦቹፑ፤ ጾሳ ጌሻ ሳኣካ ገሉፑ።<verse eid="LEV 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 12:5"/>“ ‘ሽን እት ማጫዉና ማጫ ናቶ የሎፐ፥ ባረ ፒላይ ዬዳ ዎደ እዛ ቱና ግድያዋዳንካ፥ ሀዋዳን ላኡ ሳምንታ ጋካናዉ፥ እዛ ቱና ግዳና፤ ሄዋፐ ጉይያን፥ ባረ ፒላ ሱይ ጽአና ጋካናዉ ኡሱፑን ታማነ ኡሱፑን ጋላሳ ጋምኡ።<verse eid="LEV 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 12:6"/>“ ‘ማጫዉና አቱማ ናኣ ግድና ማጫ ናኣ ግድና የላደ፥ ባረ ጌይያ ዎድያ ዉርሶዋፐ ጉይያን፥ ጹግያ ያርሾ እት ላይ ዶርሳነ ናጋራ ያርሾ ቃይ እት ሀራጵያ ማራ ዎይ እት ማራ ዶጎሙዋ ጾሳ ዱንካንያ ፐንግያን ደእያ ቄስያኮ አሁ። <verse eid="LEV 12:6"/><verse number="7" style="v" sid="LEV 12:7"/>ቄሲ ሄዋ መና ጎዳ ስንን ያርሺደ፥ እዝ ናጋራ አቶ ጊሴ፤ ያቶፐ እዛ ባረ የሉዋ ሱ ጎገፐ ጌያዉ። አቱማ ናኣ ዎይ ማጫ ናኣ የልያ ማጫዉን ዎጋይ ሄዋ።<verse eid="LEV 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 12:8"/>“ ‘ሽን እት ላይ ዶርሳ ኦርግያ አሀናዉ እዝዉ ሻሉ ግዳና ዮፐ፥ ላኡ ማራ ዶጎማቱዋ ዎይ ላኡ ማራ ሀራጳቱዋ አሁ፤ ኡንቱንቱፐ እቱ ጹግያ ያርሹዋሳ፤ እቱ ቃይ ናጋራ ያርሹዋሳ፤ ያቶፐ ቄሲ ሄዋንታ ያርሺደ፥ እዝ ናጋራ አቶ ጊሴ፤ እዛካ ጌሻ ግዳዉ’ ያጋ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">12:8 </char><char style="xt" closed="false"><ref loc="LUK 2:24">ሉቃሳ 2:24</ref></char></note><verse eid="LEV 12:8"/></para>
  <chapter eid="LEV 12"/>
  <chapter number="13" style="c" sid="LEV 13"/>
  <para style="s1">ጋልባ ሀርግያ ጼልያዋን ከሴዳ ህገቱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 13:1"/>መና ጎዳይ ሙሳነ አሮና ሀዋዳን ያጌዳ፤ <verse eid="LEV 13:1"/><verse number="2" style="v" sid="LEV 13:2"/>“አይ አሳ ቦላነ ጋፉ ቤቶፐ፥ ዎይ ሳ ማዱይ ዎይ እላሁ ከሶፐነ ቃይ ሄዌካ አ ጋልባን ዎልቃማ ጋልባ ሀርግያዉ ላመቶፐ፥ ሄ ብታንያ ቄስያ አሮናኮ ዎይ ቄስያ ግድያ አ አቱማ ናናቱዋፐ እቱዋኮ አህኖ። <verse eid="LEV 13:2"/><verse number="3" style="v" sid="LEV 13:3"/>ቄሲ አ ጋልባ ቦላን ደእያ ማዱ በኦ። ሄ ማዱጼዳ ሳኣን ደእያ እስኪ ቦጾፐነ፥ ማዱይካ ኦላቶፐ፥ ሄዌ ዎልቃማ ጋልባ ሀርገ። ቄሲ ሄዋ በኢደ፥ ሄ ብታኒ ቱና ግድያዋ ኤርሶ። <verse eid="LEV 13:3"/><verse number="4" style="v" sid="LEV 13:4"/>ሽን አ ጋልባ ቦላን ደእያ ሻቱ ቦጽንቶካ፥ ጋልባፐ ሉኪደ ኦላትቤናዋ ግዶፐነ ሄ ማዱ ቦላን ደእያ እስኪ ቦጽቤናዋ ግዶፐ፥ ቄሲ ሄ ብታንያ ዱማ ክፍልያን ላፑን ጋላሳ ጎርዲደ ዎ። <verse eid="LEV 13:4"/><verse number="5" style="v" sid="LEV 13:5"/>ላፑን ጋላሳን ቄሲ አ ዛረደካ በኦ፤ እ በእያ ዎደ ማዱይ ብታንያ ጋልባ ቦላን አከናን ካሰዋዳንካ ደኦፐ፥ ቄሲ ሄ ብታንያ ላኤንዋካ ዱማ ክፍልያን ላፑን ጋላሳ ጎርዲደ ዎ። <verse eid="LEV 13:5"/><verse number="6" style="v" sid="LEV 13:6"/>ቃይካ ላፑን ጋላሳን ቄሲ አ፤ በእያ ዎደ ማዱይ አክያዋ አጊደ ይ ይ ቦፐነ ሞፐ፥ ቄሲ እ ጌሻ ግድያዋ ኤርሶ። ሄዌ ሻቱዋፐ አትና ሀራባ ግደና፤ ሄዋ ድራዉ፥ እ ባረ ማዩዋ ሜጪደ ጌሻ ግዴ። <verse eid="LEV 13:6"/><verse number="7" style="v" sid="LEV 13:7"/>ሽን እ ጌያናዉ ባረና ቄስያ በሴዳዋፐ ጉይያን፥ ሄ ሻቱ አ ጋልባ ቦላን ያ አክ አክ ቦፐ፥ እ ላኤንዋ ባረና በሳናዉ ቄስያኮ ቦ። <verse eid="LEV 13:7"/><verse number="8" style="v" sid="LEV 13:8"/>ቄሲካ አ በኦ፤ ሄ ሻቱ ብታንያ ጋልባ ቦላን ያ አክ አክ ቦፐ፥ ቄሲ እ ቱና ግድያዋ ኤርሶ፤ አያዉ ጎፐ ሄዌ ዎልቃማ ጋልባ ሀርግያ።<verse eid="LEV 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 13:9"/>“ኦናነ ዎልቃማ ጋልባ ሀርጊ ኦይቆፐ፥ ቄስያኮ አ አህኖ። <verse eid="LEV 13:9"/><verse number="10" style="v" sid="LEV 13:10"/>ቄሲ አ በኦ፤ በእያ ዎደ አ ጋልባ ቦላን ቦ ጋፉ ደኦፐ፥ ሄ ጋፉ እስክያካ ቦዉ ላሞፐነ ሄ ጋፉዋ ግዶን አሹ ሙን ኡቴዳዋ ግዶፐ፥ <verse eid="LEV 13:10"/><verse number="11" style="v" sid="LEV 13:11"/>ሄዌ አ ጋልባ ቦላን ጋምኤዳ ዎልቃማ ጋልባ ሀርግያ ግድያ ድራዉ፥ ቄሲ እ ቱና ግድያዋ ኤርሶ። እ ቱና ግድያዌ ኤረት ድጌዳ ድራዉ፥ አ ዱማ ክፍልያን ጎርዳናዉ ኮሸና።<verse eid="LEV 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 13:12"/>“ቃይ ዎልቃማ ጋልባ ሀርጊ ብታንያ ጋልባ ቦላን አኪደ፥ ሁጲያፐ ገድያ ጋካናዉ ኡባን ማዬዳዋ ግዶፐ፥ ቄሲ በኦ። <verse eid="LEV 13:12"/><verse number="13" style="v" sid="LEV 13:13"/>ሄ ዎልቃማ ጋልባ ሀርጊ አ ቦላ ኡባ ማዮፐ፥ ቄሲ እ ጌሻ ግድያዋ ኤርሶ፤ አ ቦላይ ኡባናካ ላመቲደ ቦ ግዴዳ ድራዉ፥ እ ጌሻ። <verse eid="LEV 13:13"/><verse number="14" style="v" sid="LEV 13:14"/>ሽን ሄ ማዱ ግዶን ሙኔዳ አሹ ቤቶፐ እ ቱና። <verse eid="LEV 13:14"/><verse number="15" style="v" sid="LEV 13:15"/>ቄሲ ሄ ሙኔዳ አሹዋ፤ በኢደ ሄ ብታኒ ቱና ግድያዋ ኤርሶ። ሄ ሙኔዳ አሹ ዎልቃማ ጋልባ ሀርግያ ግድያ ድራዉ፥ እ ቱና። <verse eid="LEV 13:15"/><verse number="16" style="v" sid="LEV 13:16"/>ሽን ሄ ሙኔዳ አሹ ቃይካ ላመቲደ ቦጾፐ፥ ሄ ብታኒ ቄስያኮ ዮ። <verse eid="LEV 13:16"/><verse number="17" style="v" sid="LEV 13:17"/>ቄሲ አ በኦ፤ አ ማዱይ ቦጼዳዋ ግዶፐ፥ ሄ ብታኒ ጌሻ ግድያዋ ቄሲ ኤርሶ፤ ያቶፐ እ ጌሻ ግዳናዋ።<verse eid="LEV 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 13:18"/>“እት አሳ ቦላ ማዱይ ዎደ ፓጽና፥ <verse eid="LEV 13:18"/><verse number="19" style="v" sid="LEV 13:19"/>አ ሳኣን ቦ ጋፉ ቤቶፐ ዎይ ዞኤዳ እላሁ ከሶፐ፥ ሄ ኡራይ ባረና ቄስያ በሶ። <verse eid="LEV 13:19"/><verse number="20" style="v" sid="LEV 13:20"/>ቄሲ አ በኦ፤ ሄ ማዱይ ኦላቶፐነ ማዱ ቦላን ደእያ እስኪካ ላመቲደ ቦጾፐ፥ ሄ ብታኒ ቱና ግድያዋ ቄሲ ኤርሶ። ሄዌ ማዱና ዶሜዳ ዎልቃማ ጋልባ ሀርግያ። <verse eid="LEV 13:20"/><verse number="21" style="v" sid="LEV 13:21"/>ሽን ቄሲ በእያ ዎደ፥ እስኪ ቦጽቤናዋ ግዶፐነ ማዱይካ ጋልባ ሉኪደ ኦላትቤናዋ ግዶፐ፥ ቃይ ይ ይ ቦፐ፥ ቄሲ አ ዱማ ክፍልያን ላፑን ጋላሳ ጎርዲደ ዎ። <verse eid="LEV 13:21"/><verse number="22" style="v" sid="LEV 13:22"/>ሄዌ አ ጋልባ ቦላን አክ አኪደ ቦፐ፥ ሄ ብታኒ ቱና ግድያዋ ቄሲ ኤርሶ፤ አያዉ ጎፐ፥ ሄዌ ጋልባ ሀርግያ። <verse eid="LEV 13:22"/><verse number="23" style="v" sid="LEV 13:23"/>ሽን ሄ እላሁ አክ አክ ቤናን እትሳ ጻላላን ደኦፐ፥ ሄዌ ማዱይ ፓጼዳ ማላ ግድያ ድራዉ፥ ሄ ብታኒ ጌሻ ግድያዋ ቄሲ ኤርሶ።<verse eid="LEV 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 13:24"/>“እት አሳ ጋልባ ታማይ ሞፐነ ሄ ሜዳ ሳኣን ቦጼዳ ዎይ ዞኤዳ እላሁ ከሶፐ፥ <verse eid="LEV 13:24"/><verse number="25" style="v" sid="LEV 13:25"/>ቄሲ ሄ ሳኣ በኦ፤ አ ሳኣን ደእያ እስኪ ቦጾፐነ ማዱይካ ሉኪደ ኦላቶፐ፥ ሄዌ ዎልቃማ ጋልባ ሀርግያ። እ ታማይ ሜዳሳና ከሴዳ፤ ሄዋ ድራዉ ቄሲ እ ቱና ግድያዋ ኤርሶ። <verse eid="LEV 13:25"/><verse number="26" style="v" sid="LEV 13:26"/>ሽን ቄሲ በእያ ዎደ፥ ሄ እላሁዋ ቦላን ደእያ እስኪ ቦጽቤናዋ ግዶፐነ ማዱይካ ጋልባ ሉኪደ ኦላትቤናዋ ግዶፐ፥ ቃይ ይ ይ ቤዳዋ ግዶፐ፥ ቄሲ አ ዱማ ክፍልያን ላፑን ጋላሳ ጎርዲደ ዎ። <verse eid="LEV 13:26"/><verse number="27" style="v" sid="LEV 13:27"/>ላፑን ጋላሳን ቄሲ አ በኦ፤ ሄ ዎደ ሄ ሳአይ አክ አክ ቦፐ፥ እ ቱና ግድያዋ ቄሲ ኤርሶ። ሄዌ ዎልቃማ ጋልባ ሀርግያ። <verse eid="LEV 13:27"/><verse number="28" style="v" sid="LEV 13:28"/>ሽን ሄ እላሁ ጋልባ ቦላን አከናን አጊደ እት ሳኣን ኡቶፐነ ኡባ ቃይ ይ ይ ቦፐ፥ ሄዌ ታማይ ሜዳሳን አቴዳ ማላ ግድያ ድራዉ፥ እ ጌሻ ግድያዋ ቄሲ ኤርሶ።<verse eid="LEV 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 13:29"/>“እት አቱማ አሳዉ ዎይ ማጫ አሳዉ ሁጲያ ዎይ ጋጩዋ ቦላን ማዱይ ከሶፐ፥ <verse eid="LEV 13:29"/><verse number="30" style="v" sid="LEV 13:30"/>ቄሲ ሄ ማዱ በኦ። እ በእያ ዎደ ማዱይ ጋልባ ሉኪደ ኦላቶፐነ አ ቦላን ደእያ እስኪካ አድልያ ጪሻ ማላትያ ሌኦ ግዶፐ፥ ሄ ብታኒ ቱና ግድያዋ ቄሲ ኤርሶ። ሄዌ ሁጲያ ዎይ ጋጩዋ ቦላን ከስያ ቃጨቹዋነ ዎልቃማ ጋልባ ሀርግያ። <verse eid="LEV 13:30"/><verse number="31" style="v" sid="LEV 13:31"/>ቃይ ቄሲ ሄ ሀርግያ በእያ ዎደ፥ እ ጋልባ ሉኪደ ኦላትቤናዋ ግዶፐነ ካረ እስኪካ አ ቦላ ዮፐ፥ ሄ ቃጨቹዋ ሀርግያና ደእያ ብታንያ ቄሲ ዱማ ክፍልያን ላፑን ጋላሳ ጎርዲደ ዎ። <verse eid="LEV 13:31"/><verse number="32" style="v" sid="LEV 13:32"/>ላፑን ጋላሳን ቄሲ ሄ ሀርግያ፤ በእያ ዎደ ቃጨቹዋ ሀርጊ አከናዋ ግዶፐ፥ አ ቦላን አድልያ ጪሻ ማላትያ እስኪ ባይናዋ ግዶፐነ፥ እካ ጋልባ ሉኪደ ኦላትቤናዋ ግዶፐ፥ <verse eid="LEV 13:32"/><verse number="33" style="v" sid="LEV 13:33"/>ሄ ብታኒ ሄ ማዱ ዩሹዋን ደእያ እስክያ ሜዶ፤ ቃጨችያ ሳኣን ደእያ እስክያ ማታ ሜዶፖ። ቄሲ ሄ ብታንያ ዱማ ክፍልያን ሀራ ላፑን ጋላሳ ጎርዲደ ዎ። <verse eid="LEV 13:33"/><verse number="34" style="v" sid="LEV 13:34"/>ላፑን ጋላሳን ቄሲ ሄ ቃጨችያ ሳኣ በእያ ዎደ፤ ሄዌ ብታንያ ጋልባ ቦላን አካና ዮፐ ጋልባ ሉኪደ ኦላታና ዮፐ፥ ሄ ብታኒ ጌሻ ግድያዋ ቄሲ ኤርሶ። ብታኒካ ባረ ማዩዋ ሜጪደ፥ ጌሻ ግዴ። <verse eid="LEV 13:34"/><verse number="35" style="v" sid="LEV 13:35"/>ሽን እ ጌዬዳዋፐ ጉይያን፥ ቃጨችያዌ ሄ ብታንያ ጋልባ ቦላን አክ አክ ቦፐ፥ <verse eid="LEV 13:35"/><verse number="36" style="v" sid="LEV 13:36"/>ቄሲ አ በእያ ዎደ ሄ ቃጨችያዌ አኬዳዋ ግዶፐ፥ ቄሲ አድልያ ጪሻ ማላትያ እስክያ ኮዮፖ፤ አያዉ ጎፐ፥ ሄ ብታኒ ቱኔዳ። <verse eid="LEV 13:36"/><verse number="37" style="v" sid="LEV 13:37"/>ሽን ቄሲ በእያ ዎደ፥ ሄ ቃጨችያሳይ አክቤናዋ ግዶፐነ ካረ እስኪካ አ ቦላ ዶለዳዋ ግዶፐ፥ ሄ ቃጨችያሳይ ፓጼዳ። ሄ ብታኒካ ጌሻ ግድያ ድራዉ፥ እ ጌሻ ግድያዋ ቄሲ ኤርሶ።<verse eid="LEV 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LEV 13:38"/>“እት አቱማ አሳ ዎይ ማጫ አሳ ጋልባ ቦላ ቦ እላሁ ከሶፐ፥ <verse eid="LEV 13:38"/><verse number="39" style="v" sid="LEV 13:39"/>ቄሲ አ፤ በእያ ዎደ ሄ ኡንቱንቱ ጋልባ ቦላን ደእያ እላሁ ሾሎላ ቦ ግዶፐ፥ ሄዌ ጋልባ ቦላን ጮ ከሴዳዋ፤ ሄ ብታኒካ ጌሻ።<verse eid="LEV 13:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LEV 13:40"/>“እት አሳዉ ሁጲያ ብናናይ ቆቆፈቶፐ፥ እ ቦኣ፤ ግዶፐ አትና እ ጌሻ። <verse eid="LEV 13:40"/><verse number="41" style="v" sid="LEV 13:41"/>ቃይ እት አሳዉ ሁጲያ ብናናይ ስንና ቦአቶፐ፥ አ ቲሻይ ሜዳ፤ ግዶፐ አትና እ ጌሻ። <verse eid="LEV 13:41"/><verse number="42" style="v" sid="LEV 13:42"/>ሽን አ ቦኣ ዎይ አ ቲሻይ ሜዳሳ ቦላን ዞኦ ዎይ ቦ ማዱይ ከሶፐ፥ ሄዌ አ ቦኣን ዎይ ቲሻይ ሜዳሳን ከሴዳ ዎልቃማ ጋልባ ሀርግያ። <verse eid="LEV 13:42"/><verse number="43" style="v" sid="LEV 13:43"/>አ ቄሲ፤ በእያ ዎደ አ ቦኣ ዎይ ቲሻይ ሜዳሳ ቦላን ደእያ ማዱይ ጋልባ ቦላን ከስያ ዎልቃማ ጋልባ ሀርግያዳን ዞኦ ግዶፐ፥ <verse eid="LEV 13:43"/><verse number="44" style="v" sid="LEV 13:44"/>ሄ ብታኒ ቱሙካ ዎልቃማ ጋልባ ሀርጊ ሳክያ ሀርጋንቻ። እ ቱና ግድያ ድራዉ እ ቱና ግድያዋ ቄሲ ኤርሶ፤ አያዉ ጎፐ ሀርጊ አ ሁጲያን ደኤ።<verse eid="LEV 13:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LEV 13:45"/>“ዎልቃማ ጋልባ ሀርጊ ኦይቄዳ አሳይ ፔቴዳ ማዩዋ ማዮ፤ ባረ ሁጲያ ፕጾፖ፤ ባረ መተርሻካ ካሞ፤ ያቲደ፥ ባረ ቃላ ቁ ኦደ፥ ‘ታን ቱና፥ ታን ቱና!’ ያጎ። <verse eid="LEV 13:45"/><verse number="46" style="v" sid="LEV 13:46"/>ሄ ሀርጊ አ ቦላ ደኤዳ ኬሻን ኡባን እ ቱና። እ ቱና ግድያ ድራዉ፥ አሳፐ ሻከቲደ ዱንካኔዳ ሳኣፐ ካረና ባረካ ደኦ።<verse eid="LEV 13:46"/></para>
  <para style="s1">ሳላይ ከስያ ዎደ ኦያ ዎጋ</para>
  <para style="p">
    <verse number="47" style="v" sid="LEV 13:47"/>“አይ ማዩዋ ቦላነ ቦሮቄዳ ሳአይ ቤቶፐ፥ ሄ ማዩ ሱፈ ግድና ዎይ ሊኖ ግድና፥ <verse eid="LEV 13:47"/><verse number="48" style="v" sid="LEV 13:48"/>ቃጭናፐ ዎይ ሻሉዋፐ ዳደቴዳ ሊኖ ዎይ ሱፈ ግድና፥ ጋልባ ዎይ ጋልባፐ ኦሰቴዳ ማዩዋ ግድና፥ <verse eid="LEV 13:48"/><verse number="49" style="v" sid="LEV 13:49"/>ሄ ማዩዋ ቦላ ከሲደ ቦሮቁ ማታ ማላትያ ዎይ ዞኦ ማላ በሶፐ፥ እ ቃጭናፐ ዎይ ሻሉዋፐ ዳደቴዳዋ ግድና፥ ጋልባ ዎይ ጋልባፐ ኦሰቴዳ ማዩዋ ግድናካ፥ ሄዌ ቦሮቁ ከሴዳ ድራዉ፥ ሄዋ ቄስያ በሳናዉ ኮሼ። <verse eid="LEV 13:49"/><verse number="50" style="v" sid="LEV 13:50"/>ቄሲ ሄ ቦሮቁዋ በኢደ፥ ሄ ቦሮቁዋና ደእያ ማዩዋ ዱማ ክፍልያን ላፑን ጋላሳ ጎርዲደ ዎ። <verse eid="LEV 13:50"/><verse number="51" style="v" sid="LEV 13:51"/>ላፑን ጋላሳን ቄሲ ሄ ማዩዋ በእያ ዎደ፤ ሄ ማዩዋ ቦላን አክ አክ ቦፐ፥ እ ቃጭና ዎይ ሻሎ ማዩዋ ግድና፥ ጋልባ ዎይ ጋልባፐ ኦሰቴዳ ማዮ ግድናካ፥ ሄዌ እቱዋፐ እቱዋ ኦይቂያ ቦሮቆ ግድያ ድራዉ፥ ሄ ማዩ ቱና። <verse eid="LEV 13:51"/><verse number="52" style="v" sid="LEV 13:52"/>ቃይ ሄ ማዩ ቃጭና ዎይ ሻሎ ማዮ ግድና፥ ሊኖ ዎይ ሱፈ ግድና፥ ጋልባፐ ኦሰቴዳዋ አያ ግድናካ፥ ቄሲ አ ጹጎ። ሄዌ እቱዋፐ እቱዋ ኦይቂያ ቦሮቆ ግድያ ድራዉ፥ እ ጹገታናዉ በሴ።<verse eid="LEV 13:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LEV 13:53"/>“ቃይካ ቄሲ በእያ ዎደ፥ ሄ ቦሮቁ ማዩዋ ቦላ አክቤናዋ ግዶፐ፥ እ ቃጭና ዎይ ሻሎ ማዮ ዎይ ጋልባፐ ኦሰቴዳዋ አያ ግድናካ፥ <verse eid="LEV 13:53"/><verse number="54" style="v" sid="LEV 13:54"/>ሄ ቦሮቁ ደእያ ማዩዋ ሜጫናዳን ቄሲ አዛዞ። ሄዋፐ ጉይያን፥ ሄ ማዩዋ ዱማ ክፍልያን ሀራ ላፑን ጋላሳ ጎርዲደ ዎ። <verse eid="LEV 13:54"/><verse number="55" style="v" sid="LEV 13:55"/>ሄ ቦሮቆ ሳአይ ደእያ ማዩዋ ሜጮዋፐ ጉይያን፥ ቃይካ ቄሲ በእያ ዎደ ሄ ቦሮቁ ባረ ማላ ላምቤናዋ ግዶፐ፥ እ አክ አክ ባና ዮፐካ ቱና። ሄ ቦሮቆ ሳአይ ማዮ ጉየ ባጋና ዎይ ስን ባጋና ደእንካ፥ ሄ ማዩ ታማን ጹገታናዉ ኮሼ። <verse eid="LEV 13:55"/><verse number="56" style="v" sid="LEV 13:56"/>ሽን ሄ ማዩዋ ሜጭ ስምና ቄሲ በእያ ዎደ ቦሮቁ ይ ይ ቦፐ፥ እ ጋልባ ግድና፥ ቃጭና ዎይ ሻሎ ማዮ ግድናካ፥ ሄ ቦሮቁ ደእያ ሳኣ ቄሲ ዳኪደ ከስ ድጎ። <verse eid="LEV 13:56"/><verse number="57" style="v" sid="LEV 13:57"/>ሄዋፐ ጉይያን፥ ማዩዋ ቦላ ስሚደካ ከሶፐ፥ ሄ ማዩ ቃጭና ዎይ ሻሎ ማዮ ግድና፥ ጋልባፐ ኦሰቴዳዋ አያ ግድናካ፥ ሄዌ አክ አክ ብያ ቦሮቆ ሳ ግድያ ድራዉ፥ ሄ ቦሮቁ ደእያ ማዩ ታማን ጹገታናዉ በሴ። <verse eid="LEV 13:57"/><verse number="58" style="v" sid="LEV 13:58"/>ሽን ሜጨቴዳ ማዩ ቃጭና ዎይ ሻሎ ማዮ ግድና፥ ዎይ ጋልባፐ ኦሰቴዳ አያ ማዮ ግድናካ፥ ቦሮቆ ሳአይ አ ቦላፐ ዮፐ፥ ሄ ማዩ ላኤንዋ ሜጨቶ፤ ሄዋፐ ጉይያን፥ እ ጌሻ ግዴ።<verse eid="LEV 13:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LEV 13:59"/>“እት ማዩ ሱፈ ዎይ ሊኖ ግድና፥ ቃጭና ዎይ ሻሎ ማዮ ግድና፥ ዎይ ቃይ ጋልባፐ ኦሰቴዳዋ ግድናካ፥ ሄ ማዩዋ ጌሻ ዎይ ቱና ጊሳናዉ ዳንዳይያ ቦሮቆ ሳኣ ዎጋይ ሀዋ” ያጌዳ።<verse eid="LEV 13:59"/></para>
  <chapter eid="LEV 13"/>
  <chapter number="14" style="c" sid="LEV 14"/>
  <para style="s1">ጋልባ ሀርግያፐ ፓጽያ አሳይ ጌይያ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 14:1"/>መና ጎዳይ ሙሴዉ ሀዋዳን ያጊደ ኦዴዳ፤ <verse eid="LEV 14:1"/><verse number="2" style="v" sid="LEV 14:2"/>“ዎልቃማ ጋልባ ሀርጊ ኦይቄዳ ብታኒ ጌይያ ጋላስ ኦናዉ ኮሽያ ዎጋይ ሀዋ። ሄ ብታንያ ቄስያኮ አፋናዉ ኮሼ።<note caller="-" style="x"><char style="xo" closed="false">14:2 </char><char style="xt" closed="false"><ref loc="MAT 8:4">ማቶሳ 8:4</ref>፤ <ref loc="MRK 1:44">ማር. 1:44</ref>፤ <ref loc="LUK 5:14">ሉቃሳ 5:14</ref>፤ <ref loc="LUK 17:14">17:14</ref></char></note> <verse eid="LEV 14:2"/><verse number="3" style="v" sid="LEV 14:3"/>ቄሲ አሳይ ዱንካኔዳ ሳኣፐ ጋጻ ከሲደ፥ አ ሀርግያ በኦ። ሄ ዎደ ዎልቃማ ጋልባ ሀርጊ ብታንያ ቦላፐ ዬዳዋ ግዶፐ፥ <verse eid="LEV 14:3"/><verse number="4" style="v" sid="LEV 14:4"/>ቄሲ ፓጻ ደእያ ላኡ ጌሻ ካፎቱዋ፥ ጽድያ ም፥ ዞኦ ቃጭናነ ህሶጵያ ቦንጭያ ሄ ዎልቃማ ጋልባ ሀርግያፐ ጌይያ ብታንያ ድራዉ አሀናዳን ኡንቱንታ አዛዞ። <verse eid="LEV 14:4"/><verse number="5" style="v" sid="LEV 14:5"/>ሄዋፐ ጉይያን፥ ቃይ ቄሲ ላኡ ካፎቱዋፐ እቱዋ ከርያን ደእያ ፑልቶ ሃ ቦላ ሹካናዳን አዛዞ። <verse eid="LEV 14:5"/><verse number="6" style="v" sid="LEV 14:6"/>ፓጻ ደእያ ካፉዋ፥ ቃይ ዝጋና፥ ዞኦ ቃጭናናነ ህሶጵያ ቦንጭያና አክ አፊደ፥ ከርያን ደእያ ፑልትያ ሃ ቦላ ሹኬዳ ካፉዋ ሱ ግዶ ናቆ። <verse eid="LEV 14:6"/><verse number="7" style="v" sid="LEV 14:7"/>ከሴዳ ሱ ሄ ዎልቃማ ጋልባ ሀርግያፐ ፓጽያ ብታንያ ቦላ ላፑ ገደ ጫጫፎ፤ ያቲደ ሄ ብታኒ ጌሻ ግድያዋ ኤርሶ፤ ፓጻ ደእያ ካፉዋ ገደ ደምባ የዶ።<verse eid="LEV 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 14:8"/>“ሄ ሀርግያፐ ጌዬዳ ብታኒ ባረ ማዩዋ ሜጮ፤ ባረ ቦላን ደእያ እስክያ ኡባ ሜደቶ፤ ባረ ቦላካ ሜጨቶ፤ ያቶፐ እ ጌሻ ግዳናዋ። ሄዋፐ ጉይያን፥ እ ዱንካኔዳ ሳኣ ዮ፤ ሽን ግዶፐነ ባረ ዱንካንያ ገለናን ላፑን ጋላሳ ካረና ጋምኦ። <verse eid="LEV 14:8"/><verse number="9" style="v" sid="LEV 14:9"/>ላፑን ጋላሳን ባረ ሁጲያ፥ ቡቻ፥ ጎማነ ባረ ቦላን ደእያ ሀራ እስክያ ኡባ ሜደቶ፤ ቃይ ባረ ማዩዋ ሜጮ፤ ባረ ቦላካ ሜጨቶ፤ ሄዋፐ ጉይያን፥ እ ጌሻ ግዳናዋ።<verse eid="LEV 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 14:10"/>“ሆስፑን ጋላሳን ትላ ቦላና ደእያ ላኡ ዶርሳ ማራቱዋነ እት ላይ ግዴዳ እት ዶርሳቶ አሆ፤ ቃይ ካ ያርሾ ዛይትያን ሙናቀቴዳ ኡሱፑን ኪሎ ግራመ ልያነ እት ሊትሮ ዎጋራ ዛይትያዉ ሄዘን ኩሽያ አሆ። <verse eid="LEV 14:10"/><verse number="11" style="v" sid="LEV 14:11"/>አ ጌሽያ ቄሲ ብታንያ እ አሄዳዋንቱና እትፐካ መና ጎዳ ዱንካንያ ፐንገ መና ጎዳ ስን ሺሾ።<verse eid="LEV 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 14:12"/>“ቄሲካ ላኡ ዶርሳ ማራቱዋፐ እቱዋ አኪደ፥ ሊትሮ ሄዘን ኩሽያ ዛይትያና እትፐ ናቁዋ ያርሹዋ ኦደ ሺሾ፤ ሄ ሺሼዳዋ ቃይ ቃያ ያርሹዋ ኦደ መና ጎዳ ስንን ቃ። <verse eid="LEV 14:12"/><verse number="13" style="v" sid="LEV 14:13"/>ያቲደ እ ሄ ዶርሳ ማራ ናጋራ ያርሹዋነ ጹግያ ያርሹዋ ሹክያ ጌሻ ሳኣን ሹኮ፤ ናጋራ ያርሹዋዳን ናቁዋ ያርሹካ ቄስያዉ እመቴ፤ እካ ሎይ ጌሻ። <verse eid="LEV 14:13"/><verse number="14" style="v" sid="LEV 14:14"/>ቄሲ ናቁዋ ያርሹዋ ሱፐ ጉ አኪደ፥ ሄ ጌይያ ብታንያዉ ኡሸቻ ባጋ ሀይ ጼራ፥ ኡሸቻ ኩሽያዉ ዎጋ ብራያነ ኡሸቻ ገድያዉ ዎጋ ብራያ ኦኮ። <verse eid="LEV 14:14"/><verse number="15" style="v" sid="LEV 14:15"/>ሄዋፐ ጉይያን፥ ቄሲ ዎጋራ ዛይትያፐ ጉ አኪደ፥ ባረ ሀድርሳ ኩሽያ ጎምፓን ትጎ።<verse eid="LEV 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 14:16"/>“ሄ ሀድርሳ ኩሽያ ጎምፓን ደእያ ዎጋራ ዛይትያን ባረ ኡሸቻ ኩሽያ ብራያ ናቂደ፥ መና ጎዳ ስንን ላፑ ገደ ጫጫፎ። <verse eid="LEV 14:16"/><verse number="17" style="v" sid="LEV 14:17"/>ያት ስሚደ ባረ ኩሽያ ጎምፓን አቴዳ ዛይትያፐ አኪደ፥ ጌይያ ብታንያዉ ኡሸቻ ሀይ ጼራ፥ ኡሸቻ ኩሽያዉ ዎጋ ብራያነ ኡሸቻ ገድያዉ ዎጋ ብራያ ካሰ ናቁዋ ያርሹዋ ሱ ኦከቴዳ ሳኣን ኦኮ። <verse eid="LEV 14:17"/><verse number="18" style="v" sid="LEV 14:18"/>ቃይ ባረ ኩሽያ ጎምፓን አቴዳ ዛይትያ ቄሲ ጌይያ ብታንያ ሁጲያን ጉሶ፤ ያቲደ መና ጎዳ ስንን ሄ ብታንያ ናጋራ አቶ ጊሶ።<verse eid="LEV 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 14:19"/>“ሄዋፐ ጉይያን ቄሲ ባረ ቱናተፐ ጌይያ ብታንያ ናጋራ አቶ ጊሳናዉ ናጋራ ያርሾ ሺሼዳ መህያ ሹኬ፤ ሄዋፐ ስሚደ ቃይ ጹግያ ያርሾ ሺሼዳ መህያ ያርሼ። <verse eid="LEV 14:19"/><verse number="20" style="v" sid="LEV 14:20"/>ቃይ ቄሲ ሄ ጹግያ ያርሹዋ ካ ያርሹዋና እትፐ ያርሽያ ሳኣ ቦላን ዎደ ጹጌ፤ ያቲደ ብታንያ ናጋራ አቶ ጊሴ፤ ብታኒካ ጌሻ ግዴ።<verse eid="LEV 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 14:21"/>“ሽን ብታኒ ሄዋ ኡባ አሀናዉ ዳንዳየና ማንቆ ግዶፐ፥ ጾሳ ስንን ቃደ አ ናጋራ አቶ ጊሳናዉ፥ ባረ ናቁዋ ያርሾ እት ዶርሳ ማራ አሆ። ቃይ ካ ያርሾካ ዎጋራ ዛይትያን ሙናቀቴዳ ላኡ ኪሎ ግራመ ሎኦ ልያነ እት ሊትሮ ሄዘን ኩሽያ ዛይትያ እትፐ አሆ። <verse eid="LEV 14:21"/><verse number="22" style="v" sid="LEV 14:22"/>ቃይካ ባረዉ ዳንዳዬዳዋዳን ላኡ ማራ ሀራጰቱዋ ዎይ ላኡ ማራ ዶጎማቱዋ፥ እቱዋ ናጋራ ያርሾ፥ እቱዋ ቃይ ጹግያ ያርሾ አሆ።<verse eid="LEV 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 14:23"/>“ሆስፑን ጋላሳን ባረ ናጋራፐ ጌያናዉ ብታኒ ሀዋንታ ቄስያኮ መና ጎዳ ዱንካንያ ፐንገ መና ጎዳ ስን አሆ። <verse eid="LEV 14:23"/><verse number="24" style="v" sid="LEV 14:24"/>ቄሲ ናቁዋ ያርሾ አሄዳ ዶርሳ ማራነ ልትሮ ሄዘን ኩሸ ዛይትያ አኪደ፥ ቃያ ያርሹዋ ኦደ መና ጎዳ ስንን ቃ። <verse eid="LEV 14:24"/><verse number="25" style="v" sid="LEV 14:25"/>ያቲደ ናቁዋ ያርሾ አሄዳ ዶርሳ ማራ ሹኪደ ሄ ናቁዋ ያርሹዋ ሱፐ ጉ አኪደ፥ ሀ ጌይያ ብታንያዉ ኡሸቻ ሀይ ጼራ፥ ኡሸቻ ኩሽያዉ ዎጋ ብራያነ ኡሸቻ ገድያዉ ዎጋ ብራያ ኦኮ። <verse eid="LEV 14:25"/><verse number="26" style="v" sid="LEV 14:26"/>ቃይ ቄሲ ዛይትያፐ ጉ ባረ ሀድርሳ ኩሽያ ጎምፓን ትጎ። <verse eid="LEV 14:26"/><verse number="27" style="v" sid="LEV 14:27"/>ሄ ሀድርሳ ኩሽያ ጎምፓን ደእያ ዛይትያፐ ኡሸቻ ኩሽያ ጼራን ጉ አኪደ፥ መና ጎዳ ስንን ላፑ ገደ ጫጫፎ። <verse eid="LEV 14:27"/><verse number="28" style="v" sid="LEV 14:28"/>ቃይካ ቄሲ ባረ ኩሽያ ጎምፓን ደእያ ዛይትያፐ ጉ አኪደ፥ ጌይያ ብታንያዉ ኡሸቻ ሀይ ጼራ፥ ኡሸቻ ኩሽያዉ ዎጋ ብራያነ ኡሸቻ ገድያዉ ዎጋ ብራያ ካሰ ናቁዋ ያርሹዋ ሱ ኦከቴዳ ሳኣን ኦኮ። <verse eid="LEV 14:28"/><verse number="29" style="v" sid="LEV 14:29"/>ቃይ መና ጎዳ ስንን ብታንያ ናጋራ አቶ ጊሳናዉ፥ ቄሲ ባረ ኩሽያን አቴዳ ዛይትያ ጌይያ ብታንያ ሁጲያን ኦኮ። <verse eid="LEV 14:29"/><verse number="30" style="v" sid="LEV 14:30"/>ሄዋፐ ጉይያን፥ ሄ አዉ ባረዉ ዳንዳዬዳዋዳን ሀራጵያ ማራ ግድና ዎይ ማራ ዶጎሙዋ ግድና፥ <verse eid="LEV 14:30"/><verse number="31" style="v" sid="LEV 14:31"/>እቱዋ ናጋራ ያርሾ ላኤንዋ ቃይ ጹግያ ያርሾ ካ ያርሹዋና እትፐ ያርሾ። ቃይ ቄሲካ ሄ ጌይያ ብታንያዉ መና ጎዳ ስንን አ ናጋራ አቶ ጊሶ። <verse eid="LEV 14:31"/><verse number="32" style="v" sid="LEV 14:32"/>ባረ ቦላን ደእያ ዎልቃማ ጋልባ ሀርግያፐ ጌያናዉ ኮሽያ ዎጋ ፖላናዉ ማንቆታይ ድጌዳ ኡራዉ ደእያ ዎጋይ ስም ሀዋ” ያጌዳ።<verse eid="LEV 14:32"/></para>
  <para style="s1">ጎልያ ቦላ ከስያ ቦሮቁዋ</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 14:33"/>መና ጎዳይ ሙሳነ አሮና ሀዋዳን ያጌዳ፥ <verse eid="LEV 14:33"/><verse number="34" style="v" sid="LEV 14:34"/>“ታን ህንተንቶ አቆ ኦደ እምያ ካናነ ቢታ ህንተ ገልያ ዎደ፥ ቃይ ሄ ጋድያን ደእያ ህንተ ኬፐ እቱዋን ታን ቦሮቁዋ የድያ ዎደ፥ <verse eid="LEV 14:34"/><verse number="35" style="v" sid="LEV 14:35"/>ሄ ጎልያዉ ቄስያኮ ቢደ፥ ‘ታ ሶን አያ ቦሮቀንቶ ደኤ’ ያጊደ ኦዶ። <verse eid="LEV 14:35"/><verse number="36" style="v" sid="LEV 14:36"/>ጎለን ደእያባይ ኡባይ ቱና ጌተተናዳን፥ ቄሲ ቦሮቁዋ በአናዉ ገላናፐ ካሰቲደ፥ ሶን ደእያዋ ኡባ ካረ ከሳናዳን አዛዞ፤ ያት ስምና ቄሲ በአናዉ ጎለ ገሎ። <verse eid="LEV 14:36"/><verse number="37" style="v" sid="LEV 14:37"/>ሄዋን በእያ ዎደ፥ ቦሮቆ ሳአይ ጎዳ ቦላን ማታ ማላትያ፥ ዎይ ዞኦ ማላ በሶፐነ ቃይ ጎዳፐ ኦላቲደ ግዶ ገሎፐ፥ <verse eid="LEV 14:37"/><verse number="38" style="v" sid="LEV 14:38"/>ቄሲ ጎለፐ ካረ ከሲደ፥ ጎልያ ላፑን ጋላሳ ጋካናዉ ጎርዶ። <verse eid="LEV 14:38"/><verse number="39" style="v" sid="LEV 14:39"/>ላፑን ጋላሳን ቄሲ ሄ ጎልያ ዛረደ፤ ጼልያ ዎደ ሄ ቦሮቁ ጎልያ ጎዳ ቦላን አኮፐ፥ <verse eid="LEV 14:39"/><verse number="40" style="v" sid="LEV 14:40"/>ቦሮቁ ደእያ ሹቻቱዋ ኡባ ጎዳፐ ሾዲደ፥ ካታማፐ ጋጻ ያ ቱኔዳ ሳአዉ ኦላናዳን አዛዞ። <verse eid="LEV 14:40"/><verse number="41" style="v" sid="LEV 14:41"/>ቃይ ጎዳ ዱፌዳ ኡርቃ ሶ ባጋና ቦክሽን፥ ዩሽ አደ ቆቆፋናዳን ኦ፤ ያቲደ ሄ ቆቆፌዳ ኡርቃ ካታማፐ ጋጻን ደእያ ቱና ሳኣን ኦልኖ። <verse eid="LEV 14:41"/><verse number="42" style="v" sid="LEV 14:42"/>ሄዋፐ ጉይያን፥ ሄ ሾዴዳ ሹቻቱ ሳኣን ሀራ ሹቻቱዋ ዎኖ፤ ቃይ ሀራ ኡርቃንካ ጎልያ ዱፍኖ።<verse eid="LEV 14:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LEV 14:43"/>“ሹቻቱዋ ሾድ ድግና፥ ቃይ ኡርቃካ ቆቆፊደ ሀራ ኡርቃ ዱፊ ስምና፥ ላኤንዋ ስሚደ ቦሮቁ ጎልያ ግዶን አኮፐ፥ <verse eid="LEV 14:43"/><verse number="44" style="v" sid="LEV 14:44"/>ቄሲ ሄዋ በእያ ዎደ፤ ቦሮቁ ሄ ጎልያ ግዶን አኮፐ፥ ሄዌ እቱዋፐ እቱዋ ኦይቂያ ቦሮቆ ግድያ ድራዉ፥ ሄ ጎሊ ቱና። <verse eid="LEV 14:44"/><verse number="45" style="v" sid="LEV 14:45"/>ሄዋ ድራዉ እ ሄ ጎልያ፥ አ ሹቻ፥ አ ምነ እ ዱፈቴዳ ኡርቃ ኡባ ኮሎ፤ ሄዋንታ ካታማፐ ጋጻ አፊደ፥ ቱና ሳኣን ኦሎ። <verse eid="LEV 14:45"/><verse number="46" style="v" sid="LEV 14:46"/>ቃይ ሄ ጎሊ ጎርዳን ታክያ ዎድያን አ ግዶ ገልያ ኦንነ ሳአይ ቃማና ጋካናዉ ቱና። <verse eid="LEV 14:46"/><verse number="47" style="v" sid="LEV 14:47"/>ሄ ጎልያን ግስያ ኡራይ ዎይ ቁማ ምያ ኡራይ ባረ ማዩዋ ሜጮ።<verse eid="LEV 14:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LEV 14:48"/>“ሽን ቄሲ ዪደ ጼልያ ዎደ፥ ጎሊ ዱፈት ስምና ላኤንዋ ስሚደ አካና ዮፐ፥ ቦሮቁ ዬዳ ድራዉ፥ ሄ ጎሊ ጌሻ ግድያዋ ቄሲ ኤርሶ። <verse eid="LEV 14:48"/><verse number="49" style="v" sid="LEV 14:49"/>ጎልያ ጌሻናዉ ላኡ ካፎቱዋ፥ ጽድያ ም፥ ዞኦ ቃጭናነ ህሶጵያ ቦንጭያ አሆ። <verse eid="LEV 14:49"/><verse number="50" style="v" sid="LEV 14:50"/>ካፎቱዋፐ እቱዋ ከርያን ደእያ ፑልቱዋ ሃ ቦላን ሹኮ። <verse eid="LEV 14:50"/><verse number="51" style="v" sid="LEV 14:51"/>ሄዋፐ ጉይያን ጽድያ፥ ህሶጵያ ቦንጭያ፥ ዞኦ ቃጭናነ ፓጻ ደእያ ካፉዋ እትፐ አኪደ፥ ከርያን ደእያ ሹኬዳ ካፉዋ ሱንነ ፑልቱዋ ሃን የግ ከሲደ፥ ላፑ ገደ ሄ ጎልያ ጫጫፎ። <verse eid="LEV 14:51"/><verse number="52" style="v" sid="LEV 14:52"/>ያቲደ ሄ ጎልያ ቄሲ ካፉዋ ሱን፥ ፑልቱዋ ሃን፥ ፓጻ ደእያ ካፉዋን፥ ጽድያን፥ ህሶጵያ ቦንጭያንነ ዞኦ ቃጭናን ጌሾ። <verse eid="LEV 14:52"/><verse number="53" style="v" sid="LEV 14:53"/>ቃይ ፓጻ ደእያ ካፉዋ ካታማፐ ጋጻ ህን ደምባ የዶ። ሄዋዳን ኦደ፥ ጎልያ ጌሽያ ዎጋ ፖሌ፤ ጎሊካ ጌሻ ግዴ።<verse eid="LEV 14:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="LEV 14:54"/>“አይ ዎልቃማ ጋልባ ሀርገ ግዶፐካ ሀዌ ዎጋ፤ ቃጨችያዋ ግድና፥ <verse eid="LEV 14:54"/><verse number="55" style="v" sid="LEV 14:55"/>ማዩዋ ቦላን ዎይ ጎልያ ቦላን ከስያ ቦሮቆ ግድና፥ <verse eid="LEV 14:55"/><verse number="56" style="v" sid="LEV 14:56"/>ጋፉዋ ግድና፥ ሳ ማዱ ግድና ዎይ እላሁዋ ግድናካ፥ <verse eid="LEV 14:56"/><verse number="57" style="v" sid="LEV 14:57"/>እትባይ ቱና ግድያዋነ ጌሻ ግድያዋ ኤርሳናዉ ዎልቃማ ጋልባ ሀርግያነ ቦሮቁዋ ዎጋይ ሀዋ” ያጌዳ።<verse eid="LEV 14:57"/></para>
  <chapter eid="LEV 14"/>
  <chapter number="15" style="c" sid="LEV 15"/>
  <para style="s1">አሳ ቦላፐ ጎግያ ቱንስያባ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 15:1"/>መና ጎዳይ ሙሳነ አሮና ሀዋዳን ያጌዳ፤ <verse eid="LEV 15:1"/><verse number="2" style="v" sid="LEV 15:2"/>“እስራኤልያ አሳዉ ሀዋዳን ያጊደ ኦድተ፤ ‘አይ አሳ አቱንፐ አያይኔካ ጎጎፐ፥ ሄ ጎግያባይ ቱና። <verse eid="LEV 15:2"/><verse number="3" style="v" sid="LEV 15:3"/>ሄ ጎግያዋፐ ደንዴዳዋን ሄ ኡራይ ቱና ግድያ ዎጋይ ሀዋ: ሄ ጎግያባይ አገናን ጎግናካ ዎይ ቃይ ጎግያዋ አግንቶካ ሄ አ ግዶን ደእያባይ አ ቱንሴ።<verse eid="LEV 15:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 15:4"/>“ ‘አ ቦላፐ አያይኔካ ጎግያ አሳይ ግስያ አይ ግሱካ ቱና፤ ቃይ እ ኡትያባይ አያ ግዶፐካ ቱና። <verse eid="LEV 15:4"/><verse number="5" style="v" sid="LEV 15:5"/>አ ግሱዋ ቦችያ ኦንነ ባረ ማዩዋ ሜጮ፤ ባረ ቦላካ ሜጨቶ፤ ቃይ ኦማርስ ጋካናዉ እ ቱና። <verse eid="LEV 15:5"/><verse number="6" style="v" sid="LEV 15:6"/>ጎግያዋና ደእያ አሳይ ኡቴዳዋ ቦላ ኡትያ ኦንነ ባረ ማዩዋ ሜጮ፤ ባረ ቦላካ ሜጨቶ፤ ቃይ ኦማርስ ጋካናዉ እ ቱና።<verse eid="LEV 15:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 15:7"/>“ ‘ጎግያባይ ደእያ አሳ ቦላ ቦችያ ኦንነ ባረ ማዩዋ ሜጮ፤ ባረ ቦላካ ሜጨቶ፤ ቃይ ኦማርስ ጋካናዉ እ ቱና።<verse eid="LEV 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 15:8"/>“ ‘ጎግያባይ ደእያ አሳይ ጌሻ አሳ ቦላ ጩቾፐ፥ ሄ አሳይ ባረ ማዩዋ ሜጮ፤ ባረ ቦላካ ሜጨቶ፤ ቃይ ኦማርስ ጋካናዉ እ ቱና።<verse eid="LEV 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 15:9"/>“ ‘ቃይ ጎግያባይ ደእያ አሳይ ኡትያ አይ ኮራይካ ቱና። <verse eid="LEV 15:9"/><verse number="10" style="v" sid="LEV 15:10"/>ባረፐ ጋርሳና ደእያዋ አያን ግዶፐካ ቦችያ ኦንነ ኦማርስ ጋካናዉ ቱና፤ ቃይ ሄዋንታ ማላትያዋንታ ቶክያ ኦንነ ባረ ማዩዋ ሜጮ፤ ባረ ቦላካ ሜጨቶ፤ ቃይ ኦማርስ ጋካናዉ እ ቱና።<verse eid="LEV 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 15:11"/>“ ‘ጎግያዋና ደእያ አሳይ ባረ ኩሽያ ሜጨተናን ደኢደ ቦችያ አሳይ ኦንነ ባረ ማዩዋ ሜጮ፤ ባረ ቦላካ ሜጨቶ፤ ቃይ ኦማርስ ጋካናዉ እ ቱና።<verse eid="LEV 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 15:12"/>“ ‘ቃይ ጎግያባይ ደእያ አሳይ ቦችያ ኡርቃ ሚሻ ኡባ መንተ፤ ምፐ ኦሰቴዳ ሚሻ ኡባይ ቃይ ሃን ሜጨቶ።<verse eid="LEV 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 15:13"/>“ ‘ጎግያባይ ደእያ አሳይ ሄ ጎግያዋፐ ጌይያ ዎደ፥ ባረዉ ላፑን ጋላሳ ፓይዶ። ባረ ማዩዋ ሜጮ፤ ባረ ቦላካ ፑልቱዋ ሃን ሜጨቶ፤ ያቲደ እ ጌሻ ግዴ። <verse eid="LEV 15:13"/><verse number="14" style="v" sid="LEV 15:14"/>ሆስፑን ጋላስ ላኡ ማራ ሀራጰቱዋ ዎይ ላኡ ማራ ዶጎማቱዋ አኪደ፥ መና ጎዳ ዱንካንያ ፐንግያ መና ጎዳ ስን ዪደ፥ ቄስያዉ ኡንቱንታ እሞ። <verse eid="LEV 15:14"/><verse number="15" style="v" sid="LEV 15:15"/>ቄሲ ሀራጰቱዋፐ እቱዋ ናጋራ ያርሾ፥ ላኤንዋ ቃይ ጹግያ ያርሾ ያርሼ፤ ያቲደ ቄሲ ብታንያ ቦላፐ ጎግያዋ ድራዉ መና ጎዳ ስንን አ ናጋራ አቶ ጊሴ።<verse eid="LEV 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 15:16"/>“ ‘አይ አቱማ አሳይነ ባረ አቱማተፐ ዘረይ ጉኮፐ፥ ባረ ኩመን ቦላ ሃን ሜጨቶ፤ ቃይ ኦማርስ ጋካናዉ እ ቱና። <verse eid="LEV 15:16"/><verse number="17" style="v" sid="LEV 15:17"/>አቱማተፐ ጉኬዳ ዘረይ ቦቼዳ ማዩዋ ኡባይ ዎይ ጋልባ ኡባይ ሃን ሜጨቶ፤ ቃይ ኦማርስ ጋካናዉ እ ቱና። <verse eid="LEV 15:17"/><verse number="18" style="v" sid="LEV 15:18"/>ቃይ እት አቱማ አሳይ ማጫ አሳና ግስና፥ አ አቱማተፐ ዘረይ ጉኮፐ፥ ላኡካ ሃን ሜጨትኖ፤ ቃይ ኦማርስ ጋካናዉ ኡንቱንቱ ቱና።<verse eid="LEV 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 15:19"/>“ ‘ማጫ አሳዉ አግናን አግናን ይያ ፒላይ ዮፐ፥ ላፑን ጋላሳ ጋካናዉ እዛ ቱና፤ ቃይ እዞ ቦችያ ኦንነ ኦማርስ ጋካናዉ ቱና።<verse eid="LEV 15:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 15:20"/>“ ‘ሄ ፒላ ዎደ እዛ ግስያዌ ኡባይ ቱና፤ ቃይ እዛ ኡትያዌ ኡባይካ ቱና። <verse eid="LEV 15:20"/><verse number="21" style="v" sid="LEV 15:21"/>እዛ ግስያ ግሱዋ ቦችያ ኡባይ ባረ ማዩዋ ሜጮ፤ ሃንካ ሜጨቶ፤ ኦማርስ ጋካናዉ እ ቱና። <verse eid="LEV 15:21"/><verse number="22" style="v" sid="LEV 15:22"/>እዛ ኡትያዋ ቦችያ ኡባይ ባረ ማዩዋ ሜጮ፤ ባረ ቦላካ ሜጨቶ፤ ቃይ ኦማርስ ጋካናዉ እ ቱና። <verse eid="LEV 15:22"/><verse number="23" style="v" sid="LEV 15:23"/>እዛ ግስያ ግሱዋ ግድናካ ዎይ እዛ ኡትያዋ ቦችያ ኦንነ ኦማርስ ጋካናዉ ቱና።<verse eid="LEV 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 15:24"/>“ ‘አይ አቱማ አሳይነ ሄ ፒላ ዎደ ኢናና ግሶፐ፥ ሄ ፒላይ ቃይ አ ቦቾፐ፥ ላፑን ጋላሳ ጋካናዉ እ ቱና፤ እ ግስያ ግሱ ኡባይካ ቱና።<verse eid="LEV 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 15:25"/>“ ‘እት ማጫ ምሽራትዉ እዝ ፒላ ዎድያ ግደናን ሀራ ዎድያን ሱይ ጎጎፐ፥ ዎይ ቃይ እዝ ፒላይካ ባረ ዎድያፐ አደ ኤቀናን እጺደ ጎጎፐ፥ እ ኤቃና ጋካናዉ እዛ ቱና። ባረ ፒላ ዎድያን ቱና ግድያዋዳን፥ ሄ ዎደካ እዛ ቱና። <verse eid="LEV 15:25"/><verse number="26" style="v" sid="LEV 15:26"/>ሄ ሱይ ኢፐ ጎግያ ዎድያን እዛ ግሴዳ ግሱ ኡባይ፥ ባረ ፒላ ዎደ እዛ ግሴዳ ግሱዋካ ማላ ቱና፤ ቃይ እዛ ኡትያባይ ኡባይካ ባረ ፒላ ዎደ እዛ ኡትያባይ ቱና ግድያዋዳን ቱና። <verse eid="LEV 15:26"/><verse number="27" style="v" sid="LEV 15:27"/>ቃይ ሄ ቱኔዳባቱዋ ቦችያ ኦንነ ቱና፤ እ ባረ ማዩዋ ሜጮ፤ ባረ ቦላካ ሜጨቶ፤ ቃይ ኦማርስ ጋካናዉ እ ቱና።<verse eid="LEV 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 15:28"/>“ ‘እዝፐ ጎግያባይ ኤቆፐ፥ እዛ ሄ ዎድያፐ ዶማደ ላፑን ጋላሳ ፓይዱ፤ ሄዋፐ ጉይያን፥ እዛ ጌሻ ግዳና። <verse eid="LEV 15:28"/><verse number="29" style="v" sid="LEV 15:29"/>ሆስፑን ጋላሳን እዛ ላኡ ማራ ሀራጰቱዋ ዎይ ላኡ ማራ ዶጎማቱዋ አካደ፥ ጾሳ ዱንካንያ ፐንግያ ቄስያኮ አሁ። <verse eid="LEV 15:29"/><verse number="30" style="v" sid="LEV 15:30"/>ቄሲ ሀራጰቱዋፐ እቱዋ ናጋራ ያርሾ እቱዋ ቃይ ጹግያ ያርሾ ያርሾ። ያቲደ ቄሲ ኢፐ ጎግያዋ ቱናተ ድራዉ መና ጎዳ ስንን እ ናጋራ አቶ ጊሴ።<verse eid="LEV 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 15:31"/>“ ‘ባረንቱ ግዶን ደእያ ጾሳ ዱንካንያ ቱንሲደ እስራኤልያ አሳይ ሀይቀናዳን፥ ኔን ሀዋዳን ኦደ ኡንቱንቱ ባረና ቱንስያዋፐ ሻከቲደ ደአናዳን ናጋ።<verse eid="LEV 15:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 15:32"/>“ ‘አ ቦላፐ አያይኔካ ጎግያ አሳዉነ አ አቱማተፐ ጉኬዳ ዘረን ቱንያ አሳዉ፥ <verse eid="LEV 15:32"/><verse number="33" style="v" sid="LEV 15:33"/>ቃይ ባረ ፒላ ጋሱዋን ቱንያ ማጫ አሳዉ፥ አቱማ ግድና ማጫዋ ግድና ጎግያባይ ደእያ አሳዉነ ቱኔዳ ማጫ አሳና ግስያ አቱማ አሳዉ እመቴዳ ዎጋይ ሄዋ’ ያግተ” ያጌዳ።<verse eid="LEV 15:33"/></para>
  <chapter eid="LEV 15"/>
  <chapter number="16" style="c" sid="LEV 16"/>
  <para style="s1">ናጋራይ አቶ ጌተትያ ጋላሳ</para>
  <para style="r">(<ref loc="LEV 16:1-34">16:1-34</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 16:1"/>አሮና አቱማ ናናይ ላኡ መና ጎዳ ስን ሺቂደ ሀይቄዳዋፐ ጉይያን፥ መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ። <verse eid="LEV 16:1"/><verse number="2" style="v" sid="LEV 16:2"/>“መና ጎዳይ ሙሳ፥ ነ እሻይ አሮን ታቦታ ቦላን ደእያ አቶ ግያ ሳኣ ቁምእያ ስንን ጋርዱዋፐ ጉየ ባጋና ደእያ ኡባፐ አዳ ጌሻ ሳኣ ኡባ ዎደ ጮ ገለናዳን አዉ ኦዳ። ጮ ገሎፐ እ ሀይቃና፤ አያዉ ጎፐ፥ ታን ሻርያ ግዶና አቶ ግያ ሳኣ ቁምእያ ቦላን ቆንጫይ።<note caller="-" style="x"><char style="xo" closed="false">16:2 </char><char style="xt" closed="false"><ref loc="HEB 6:19">እብራ. 6:19</ref></char></note> <verse eid="LEV 16:2"/><verse number="3" style="v" sid="LEV 16:3"/>አሮን ናጋራ ያርሾ እት ኮሩማነ ቃይ ጹግያ ያርሾ እት ዶርሳ ኦርግያ አኪደ፥ ሄ ኡባፐ አዳ ጌሻ ሳኣ ገሎ።<note caller="-" style="x"><char style="xo" closed="false">16:3 </char><char style="xt" closed="false"><ref loc="HEB 9:7">እብራ. 9:7</ref></char></note><verse eid="LEV 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 16:4"/>“አሮን ሊኑዋፐ ኦሰቴዳ ጌሻ ቃምሽያነ ሊኑዋፐ ኦሰቴዳ ጋርሳና ማይያ ማዩዋ ማዮ። ቃይ ሊኑዋፐ ኦሰቴዳ ዳንጩዋ ዳንጮ፤ ሄዋዳንካ ቃይ ባረ ሁጲያን ሊኑዋፐ ኦሰቴዳ ሻሽያ ኤንጩርሳ ዎ። ሀዋንቱ ጌሻ ማዮቱዋ ግድያ ድራዉ፥ እ ባረ ቦላ ሃን ሜጨት ክቺደ ማዮ።<verse eid="LEV 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 16:5"/>“እስራኤልያ አሳ ማባራይ ናጋራ ያርሾ ላኡ ዴሻ ኮለቱዋ፥ ጹግያ ያርሾካ እት ዶርሳ ኮልያ አሮናዉ አይኖ። <verse eid="LEV 16:5"/><verse number="6" style="v" sid="LEV 16:6"/>አሮን ባረ ናጋራነ ባረ ሶ አሳ ናጋራ አቶ ጊሳናዉ ኮሩማ ያርሾ። <verse eid="LEV 16:6"/><verse number="7" style="v" sid="LEV 16:7"/>ሄዋፐ ጉይያን፥ ላኡ ዴሻ ኮለቱዋ አፊደ፥ መና ጎዳ ዱንካንያ ፐንግያን መና ጎዳ ስንን ኤሶ። <verse eid="LEV 16:7"/><verse number="8" style="v" sid="LEV 16:8"/>ያቲደ ሄ ላኡ ዴሻቱዋን ሳማ የግና እቱ መና ጎዳሳ፤ እቱ ቃይ ባዙዋ የድያዋ ግዴ። <verse eid="LEV 16:8"/><verse number="9" style="v" sid="LEV 16:9"/>አሮን መና ጎዳዉ ሳማይ ከሴዳ ዴሻ አሂደ፥ ናጋራ ያርሾ ኦደ ያርሾ። <verse eid="LEV 16:9"/><verse number="10" style="v" sid="LEV 16:10"/>ሽን ባዙዋ የድያ ሳማይ ከሴዳ ዴሻ ፓጻ ደእሽን መና ጎዳዉ ሺሾ፤ ባዙዋ አ የደርስያ ዎደ፥ አሳ ናጋራ አቶ ጊሴ።<verse eid="LEV 16:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 16:11"/>“አሮን ባረ ናጋራነ ባረ ሶ አሳ ናጋራ አቶ ጊሳናዉ፥ እት ኮሩማ ናጋራ ያርሹዋ ኦደ ሺሾ። ያቲደ ባረ ናጋራ ያርሾ ሄ ኮሩማ ሹኮ። <verse eid="LEV 16:11"/><verse number="12" style="v" sid="LEV 16:12"/>ቃይ መና ጎዳ ስንን ደእያ ያርሽያ ሳኣፐ እጻና ጩውስያ ሚሻ ኩመን ቦንቁዋነ፥ ሊቅ ጋጨቴዳ ላኡ ኮጵያ ሳዊያ እጻና አኪደ፥ ጋርዱዋ ግዶ አሆ። <verse eid="LEV 16:12"/><verse number="13" style="v" sid="LEV 16:13"/>እ ሀይቀናዳን፥ እጻና ጩዋይ ታቦታ ቦላን ደእያ አቶ ግያ ሳኣ ቁምእያ ካማና ማላ፥ እጻና መና ጎዳ ስንን ደእያ ታማን ዎ። <verse eid="LEV 16:13"/><verse number="14" style="v" sid="LEV 16:14"/>ቃይ ሄ ኦርግያ ሱፐ ጉ አኪደ፥ ባረ ብራያ አን ናቂደ፥ አቶ ግያ ሳኣ ቁምእያዉ ስን ባጋ ጫጫፎ፤ ቃይ አቶ ግያ ሳኣ ቁምእያፐ ስን ባጋና ደእያ ሳኣካ ላፑ ገደ ጫጫፎ።<verse eid="LEV 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 16:15"/>“ሄዋፐ ጉይያን አሳ ናጋራ ያርሾ ግድያ ዴሻ ሹኪደ፥ አ ሱ ጋርዱዋ ግዶ አሆ፤ ኮሩማ ሱ ጫጫፌዳዋዳን፥ አቶ ግያ ሳኣ ቁምእያ ስንነ አቶ ግያ ሳኣ ቁምእያፐ ስን ባጋና ደእያ ሳኣ ጫጫፎ።<note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="HEB 9:12">እብራ. 9:12</ref></char></note> <verse eid="LEV 16:15"/><verse number="16" style="v" sid="LEV 16:16"/>ያቲደ ኡባፐ አዳ ጌሻ ሳኣ እስራኤልያ አሳ ቱናተፐነ ናጋራፐ ጌሼ። ቃይ ኡንቱንቱ ቱናባ ኦሽን፥ ኡንቱንቱ ግዶን ደእያ ጾሳ ዱንካንያካ ሄዋዳን ኦደ ጌሾ። <verse eid="LEV 16:16"/><verse number="17" style="v" sid="LEV 16:17"/>እ ኡባፐ አዳ ጌሻ ሳኣ ገሊደ፥ ባረ ናጋራ፥ ባረ ሶ አሳ ናጋራነ ኩመን እስራኤልያ አሳ ናጋራ አቶ ጊሲደ ከሳና ጋካናዉ፥ ኦንነ ጾሳ ዱንካንያ ግዶን ደኦፖ።<verse eid="LEV 16:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 16:18"/>“ሄዋፐ ጉይያን እ መና ጎዳ ስንን ደእያ ያርሽያ ሳኣ ዪደ አ ናጋራ አቶ ጊሶ። ኮሩማ ሱፐነ ዴሻ ሱፐ ጉ ጉ አኪደ፥ ያርሽያ ሳኣ ዩሹዋን ደእያ ካጨቱዋ ኦኮ። <verse eid="LEV 16:18"/><verse number="19" style="v" sid="LEV 16:19"/>ቃይ ሄ ሱፐ ጉ ባረ ብራያን አኪደ፥ ላፑ ገደ ያርሹዋ ሳኣ ቦላ ጫጫፊደ፥ እስራኤልያ አሳ ቱናተፐ ሄ ያርሹዋ ሳኣ ጌሾ።<verse eid="LEV 16:19"/></para>
  <para style="s1">ዎራ የድያ ዴሻ</para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 16:20"/>“አሮን ኡባፐ አዳ ጌሻ ሳኣ፥ ጾሳ ዱንካንያነ ያርሽያ ሳኣ ጌሽያ ዎጋ ፖሌዳዋፐ ጉይያን፥ ፓጻ ደእያ ዴሻ ሺሾ። <verse eid="LEV 16:20"/><verse number="21" style="v" sid="LEV 16:21"/>አሮን ባረ ላኡ ኩሸቱዋ ፓጻ ደእያ ዴሻ ሁጲያን ዎደ፥ እስራኤልያ አሳ ናቁዋ ኡባ፥ ኡንቱንቱ ማካላ ኡባ፥ ኡንቱንቱ ናጋራ ኡባ ፓጾ፤ ያቲደ ሄ ዴሻ ሁጲያን ሄዋ ቶሲደ ሄ ዴሻ አፋናዳን ጊግሴዳ አሳ ቦላን ባዙዋ የዶ። <verse eid="LEV 16:21"/><verse number="22" style="v" sid="LEV 16:22"/>እ ዴሻ ባዙዋ የድና፥ ዴሻይ ኡንቱንቱ ናጋራ ኡባ ቶኪደ፥ አሳይ ባይና ሳኣ ባዙዋ ቦ።<verse eid="LEV 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 16:23"/>“ሄዋፐ ጉይያን፥ አሮን ጾሳ ዱንካንያ ቢደ ኡባፐ አዳ ጌሻ ሳኣ ገሌዳ ዎደ፥ ካሰ ባረ ማዬዳ ሊኑዋፐ ኦሰቴዳ ማዩዋ ቃሪደ ሄዋን ዎ።<note caller="-" style="x"><char style="xo" closed="false">16:23 </char><char style="xt" closed="false"><ref loc="EZK 44:19">ህዝ. 44:19</ref></char></note> <verse eid="LEV 16:23"/><verse number="24" style="v" sid="LEV 16:24"/>ጌሻ ሳኣን እ ባረ ቦላ ሃን ሜጨቲደ፥ ሀራ ማዩዋ ማዪደ ከሶ፤ ያቲደ ጹግያ ያርሹዋ ባረዋነ አሳዋ ያርሺደ፥ ባረ ናጋራነ አሳ ናጋራ አቶ ጊሴ። <verse eid="LEV 16:24"/><verse number="25" style="v" sid="LEV 16:25"/>ቃይ ሄዋዳንካ ናጋራ ያርሹዋ ሀንዳ ያርሽያ ሳኣ ቦላን ዎደ ጹጎ።<verse eid="LEV 16:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 16:26"/>“ዎራ የድያ ዴሻ አፌዳ ብታኒካ ባረ ማዩዋ ሜጮ፤ ባረ ቦላካ ሃን ሜጨቶ። ያት ስሚደ ዱንካኔዳሳ ዮ።<verse eid="LEV 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 16:27"/>“ናጋራ አቶ ጊሳናዉ አሮን ኡባፐ አያ ጌሻ ሳኣ ገሌዳ ዎደ፥ ናጋራ ያርሹዋ ኮሩማ ሱነ ዴሻ ሱ አኪደ ገሌዳ፤ ሀእ ህንተ ሄ ኮሩማነ ሄ ዴሻነ ዱንካኔዳ ሳኣፐ ጋጻ ከስተ። ኡንቱንቱ ጋልባ፥ ኡንቱንቱ አሹዋነ ኡንቱንቱ ቶጭያ ታማን ጹግተ።<note caller="-" style="x"><char style="xo" closed="false">16:27 </char><char style="xt" closed="false"><ref loc="HEB 13:11">እብራ. 13:11</ref></char></note> <verse eid="LEV 16:27"/><verse number="28" style="v" sid="LEV 16:28"/>ሄዋ ታማን ጹጌዳ ብታኒ ባረ ማዩዋ ሜጮ፤ ባረ ቦላካ ሃን ሜጨቶ፤ ሄዋፐ ጉይያን፥ ዱንካኔዳ ሳኣ ዮ።<verse eid="LEV 16:28"/></para>
  <para style="s1">ናጋራ አቶ ጊስያ ጋላሳ ቦንችያዋ</para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 16:29"/>“ሀዌ ህንተንቶ መናዉካ ዎጋ ግዶ: ላፑን አግናይ ገሌዳ ታሙን ጋላሳን ህንተ ሁጲያ ካዉሽተ፤ እስራኤልያ አሳ ግድና ዎይ ቃይ ህንተ ግዶን ደእያ ሀራ ቢታ አሳ ግድናካ፥ አይ ኦሶነ ኦፕተ።<note caller="-" style="x"><char style="xo" closed="false">16:29-34 </char><char style="xt" closed="false"><ref loc="LEV 23:26-32">ዎጋ 23:26-32</ref>፤ <ref loc="NUM 29:7-11">ፓይ. 29:7-11</ref></char></note> <verse eid="LEV 16:29"/><verse number="30" style="v" sid="LEV 16:30"/>አያዉ ጎፐ፥ ህንተና ጌሻናዉ፥ ህንተ ናጋራ አቶ ጊስያ ጋላሳይ ሄ ጋላሳ። ህንተካ መና ጎዳ ስንን ህንተ ናጋራ ኡባፐ ጌያና። <verse eid="LEV 16:30"/><verse number="31" style="v" sid="LEV 16:31"/>ሄዌ ህንተ ዋና ሸምፑዋ ሸምፕያ ሳምባታ ጋላሳ። ሄ ጋላሳን ህንተ ሁጲያ ካዉሽተ፤ ሄዌ ህንተንቶ መናዉካ ዎጋ ግዶ። <verse eid="LEV 16:31"/><verse number="32" style="v" sid="LEV 16:32"/>ቃይ ባረ አዉዋ ኮታን ቄሰ ግዳናዳን ኦከትያዌነ ዱማትያ አሳይ ጌሻ ግዴዳ ሊኑዋፐ ዳደቴዳ ማዩዋ ማዪደ፥ ናጋራ አቶ ጊስያ ዎጋ ፖሎ። <verse eid="LEV 16:32"/><verse number="33" style="v" sid="LEV 16:33"/>እ ኡባፐ አያ ጌሻ ሳኣ፥ ጾሳ ዱንካንያ፥ ያርሽያ ሳኣ፥ ቄሳቱ ዋነ እስራኤልያ አሳ ኡባ ጌሾ። <verse eid="LEV 16:33"/><verse number="34" style="v" sid="LEV 16:34"/>እስራኤልያ አሳ ናጋራ ኡባ አቶ ጊስያ ዎጋ ህንተ ላይን ላይን እት ገደ ኦናዳን፥ ሀዌ ህንተንቶ መናዉካ ዎጋ ግዶ” ያጌዳ። ሙሴ መና ጎዳይ አዛዜዳዋዳን ኦዳ።<verse eid="LEV 16:34"/></para>
  <chapter eid="LEV 16"/>
  <chapter number="17" style="c" sid="LEV 17"/>
  <para style="ms">ደኡዋ ጌሻተነ ጎይኑዋ ዎጋ</para>
  <para style="mr">(<ref loc="LEV 17:1-27:34">17:1—27:34</ref>)</para>
  <para style="s1">ሱይ ሜተተናዳን ድገቱሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 17:1"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="LEV 17:1"/><verse number="2" style="v" sid="LEV 17:2"/>“አሮናዉ አ አቱማ ናናቶነ እስራኤልያ አሳ ኡባዉ ሀዋዳን ያጋደ ኦዳ፤ ‘መና ጎዳይ አዛዜዳዌ ሀዋ: <verse eid="LEV 17:2"/><verse number="3" style="v" sid="LEV 17:3"/>እስራኤልያ አሳፐ ኦንነ ቦራ ዎይ ዶርሳ ዎይ ዴሻ ዱንካኔዳ ሳኣን ዎይ ዱንካኔዳ ሳኣፐ ጋጻና ሹኪደ፥ <verse eid="LEV 17:3"/><verse number="4" style="v" sid="LEV 17:4"/>መና ጎዳዉ እሞታ ኦደ እማናዉ መና ጎዳ ዱንካንያ ፐንግያ መና ጎዳ ስን አሀና ዮፐ፥ ሄ ሱን እ ኦሸቴ፤ ሄ አሳይ ሱ ጉሴዳ። ሄዋ ድራዉ እ ባረ አሳ ግዶፐ ቦሄቶ። <verse eid="LEV 17:4"/><verse number="5" style="v" sid="LEV 17:5"/>ሄዋ ድራዉ እስራኤልያ አሳይ ባረንቱ ያርሹዋ መህያ ጮ ደምባን ሹክያዋ አጊደ፥ ሃ መና ጎዳኮ፥ መና ጎዳ ዱንካንያ ፐንግያን ደእያ ቄስያኮ አህኖ። ቄሲ ሄዋ አኪደ፥ መና ጎዳዉ እትፐተ ያርሹዋ ኦደ ሹኮ። <verse eid="LEV 17:5"/><verse number="6" style="v" sid="LEV 17:6"/>ቃይ ቄሲ መና ጎዳ ዱንካንያ ፐንግያን ደእያ መና ጎዳዉ ያርሽያ ሳኣ ቦላን ሄ ሱ ጫጫፎ፤ ሀንዳካ መና ጎዳዉ ሳዉዋ ቶሹኩ ግያ ያርሹዋ ኦደ ጹጎ። <verse eid="LEV 17:6"/><verse number="7" style="v" sid="LEV 17:7"/>እስራኤልያ አሳይ ጾሳ ካልያዋ አጊደ ካሌዳ ጻላሄቶ ላኤን ባረንቱ ያርሹዋ ያርሾፕኖ። ሀዌ ኡንቱንቶነ ይያ የለታ ኡባዉ መናዉ ዎጋ ግዶ’ ያጋ።<verse eid="LEV 17:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 17:8"/>“ኡንቱንታ ሀዋዳን ያጋ፤ ‘እስራኤልያ አሳፐ ግድና ዎይ ኡንቱንቱ ግዶን ደእያ ሀራ ቢታ አሳፐ ግድናካ፥ ኦንነ ጹግያ ያርሹዋ ዎይ ሀራ ያርሹዋ ሺሽያ ዎደ፥ <verse eid="LEV 17:8"/><verse number="9" style="v" sid="LEV 17:9"/>መና ጎዳዉ ያርሻናዉ መና ጎዳ ዱንካንያ ፐንግያ አሀና ዮፐ፥ ሄ አሳይ ባረ አሳ ግዶፐ ቦሄቶ።<verse eid="LEV 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 17:10"/>“ ‘እስራኤልያ አሳፐ ዎይ ኡንቱንቱ ግዶን ደእያ ሀራ ቢታ አሳፐ ኦንነ ሱ ሞፐ፥ ሄ ሱ ምያ አሳ ቦላን ታን ታ ዴሙዋ ቱካና፤ ታን ሄ ብታንያ አሳ ግዶን ቦሀና።<note caller="-" style="x"><char style="xo" closed="false">17:10 </char><char style="xt" closed="false"><ref loc="GEN 9:4">ዶመ 9:4</ref>፤ <ref loc="LEV 7:26-27">ዎጋ 7:26-27</ref>፤ <ref loc="LEV 19:26">19:26</ref>፤ <ref loc="DEU 12:16">ዛረ. 12:16</ref>፣ <ref loc="DEU 12:23">23</ref>፤ <ref loc="DEU 15:23">15:23</ref></char></note> <verse eid="LEV 17:10"/><verse number="11" style="v" sid="LEV 17:11"/>አያዉ ጎፐ አሹዋ ማዬዳ ኡባ ደኡ አ ሱ ግዶን ደኤ፤ ሱይካ ቃይ ደኡዋ ሸምፑ አ ግዶን ደእያዋፐ ደንዴዳዋን ናጋራ አቶ ጊስያዋ ግድያ ድራዉ፥ ህንተ ናጋራ አቶ ጊሳናዳን፥ ታን ህንተንቶ ያርሽያ ሳኣ ቦላን ያርሻናዳን እማድ።<note caller="-" style="x"><char style="xo" closed="false">17:11 </char><char style="xt" closed="false"><ref loc="HEB 9:22">እብራ. 9:22</ref></char></note> <verse eid="LEV 17:11"/><verse number="12" style="v" sid="LEV 17:12"/>ሄዋ ድራዉ ታን እስራኤልያ አሳ፥ “ህንተፐ ዎይ ህንተ ግዶን ደእያ ሀራ ቢታ አሳፐ ኦንነ ሱ ሞፖ” ያጋድ።<verse eid="LEV 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 17:13"/>“ ‘እስራኤልያ አሳፐ ዎይ ኡንቱንቱ ግዶን ደእያ ሀራ ቢታ አሳፐ ኦንነ ምያ ዶኣ ዎይ ካፉዋ ሻንካቲደ ዎፐ፥ አ ሱ ሳኣን ጉሲደ፥ ቢታ ካሞ። <verse eid="LEV 17:13"/><verse number="14" style="v" sid="LEV 17:14"/>አያዉ ጎፐ አሹዋ ማዬዳ ኡባ ሸምፑ አ ሱ ግዶና። ሄዋ ድራዉ ታን እስራኤልያ አሳ፥ “አሹዋ ማዬዳ መታ ኡባ ሸምፑካ አ ሱ ግዶን ደእያ ድራዉ፥ ሱ ሞፕተ፤ ቃይ ምያ ኦንነ ባረ አሳ ግዶፐ ቦሄቶ” ያጋድ።<verse eid="LEV 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 17:15"/>“ ‘እስራኤልያ አሳ ግድና ዎይ ኡንቱንቱ ግዶን ደእያ ሀራ ቢታ አሳ ግድና፥ ኦንነ ባኩታ ዎይ ዶአይ ኦይቂደ ዎዳ አሹዋ ሞፐ፥ ባረ ማዩዋ ሜጮ፤ ባረ ቦላካ ሜጨቶ፤ ያቲደ ኦማርስ ጋካናዉ እ ቱና። ሄዋፐ ጉይያን፥ እ ጌሻ። <verse eid="LEV 17:15"/><verse number="16" style="v" sid="LEV 17:16"/>ባረ ማዩዋ ሜጫና ዮፐ፥ ባረ ቦላካ ሜጨታና ዮፐ፥ እ ባረ ናጋራን ኦሸቴ’ ያጋ” ያጌዳ።<verse eid="LEV 17:16"/></para>
  <chapter eid="LEV 17"/>
  <chapter number="18" style="c" sid="LEV 18"/>
  <para style="s1">ድገቴዳ ማጫነ አቱማ አሳ ግሱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 18:1"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="LEV 18:1"/><verse number="2" style="v" sid="LEV 18:2"/>“እስራኤልያ አሳ ሀዋዳን ያጋ፤ ‘ታን፥ መና ጎዳይ፥ ህንተ ጾሳ። <verse eid="LEV 18:2"/><verse number="3" style="v" sid="LEV 18:3"/>ህንተ ካሰ ደኤዳ ግብጼ ቢታ አሳይ ኦያዋዳን ኦፕተ፤ ዎይ ሀእ ታን ህንተና አፍያ ካናነ ቢታ አሳይ ኦያዋዳንካ ኦፕተ፤ ኡንቱንቱ ዎጋካ ካሎፕተ። <verse eid="LEV 18:3"/><verse number="4" style="v" sid="LEV 18:4"/>ህንተ ታ አዛዙዋ ኦተ፤ ታ ዎጋካ ናግተ፤ ቃይ አን ቢተ። ታን፥ መና ጎዳይ፥ ህንተ ጾሳ። <verse eid="LEV 18:4"/><verse number="5" style="v" sid="LEV 18:5"/>ሄዋ ድራዉ ታ አዛዙዋነ ታ ዎጋ ናጎፐ፥ ህንተ ፓጻ ደአና። ታን መና ጎዳ።<note caller="-" style="x"><char style="xo" closed="false">18:5 </char><char style="xt" closed="false"><ref loc="NEH 9:29">ናህ. 9:29</ref>፤ <ref loc="EZK 18:9">ህዝ. 18:9</ref>፤ <ref loc="EZK 20:11-13">20:11-13</ref>፤ <ref loc="LUK 10:28">ሉቃሳ 10:28</ref>፤ <ref loc="ROM 10:5">ሮመ 10:5</ref>፤ <ref loc="GAL 3:12">ጋላ. 3:12</ref></char></note><verse eid="LEV 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 18:6"/>“ ‘ህንተፐ ኦንነ አሹዋ አሙዋ ፖላናዉ ባረ ማታ ዳቡዋና ግሶፖ። ታን ጾሳ። <verse eid="LEV 18:6"/><verse number="7" style="v" sid="LEV 18:7"/>ነ አሹዋ አሙዋ ፖላናዉ ነ ዳይና ግሶፓ፤ ነ አዉዋ ካዉሾፓ። እዛ ነ ዳዮ፤ ኢናና ግሶፓ። <verse eid="LEV 18:7"/><verse number="8" style="v" sid="LEV 18:8"/>ነ አሹዋ አሙዋ ፖላናዉ ነ አዉዋ ማቻትና ግሶፓ፤ ነ አዉዋ ካዉሾፓ።<note caller="-" style="x"><char style="xo" closed="false">18:8 </char><char style="xt" closed="false"><ref loc="LEV 20:11">ዎጋ 20:11</ref>፤ <ref loc="DEU 22:30">ዛረ. 22:30</ref>፤ <ref loc="DEU 27:20">27:20</ref></char></note><verse eid="LEV 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 18:9"/>“ ‘ነ አሹዋ አሙዋ ፖላናዉ ነ ምቻትና ግሶፓ፤ ዎይ ቃይ ሶን የለቴዳ ዎይ ካረን የለቴዳ ነ አዉዋ ዎይ ነ ዳይ ናትናካ ግሶፓ።<note caller="-" style="x"><char style="xo" closed="false">18:9 </char><char style="xt" closed="false"><ref loc="LEV 20:17">ዎጋ 20:17</ref>፤ <ref loc="DEU 27:22">ዛረ. 27:22</ref></char></note><verse eid="LEV 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 18:10"/>“ ‘ነ አሹዋ አሙዋ ፖላናዉ ነ ናኣ ናትና ዎይ ነ ናት ናትና ግሶፓ። ነ ሁጲያዉ ኔና ካዉሻሳ። <verse eid="LEV 18:10"/><verse number="11" style="v" sid="LEV 18:11"/>ነ አሹዋ አሙዋ ፖላናዉ ነ አዉዋ ማቻት ናትና ግሶፓ፤ እዛ ነ ምቻቶ ግድያ ድራዉ ኢናና ግሶፓ። <verse eid="LEV 18:11"/><verse number="12" style="v" sid="LEV 18:12"/>ነ አሹዋ አሙዋ ፖላናዉ ነ አዉዋ ምቻትና ግሶፓ። እዛ ነ አዎ ማታ ዳቦ።<note caller="-" style="x"><char style="xo" closed="false">18:12-14 </char><char style="xt" closed="false"><ref loc="LEV 20:19-20">ዎጋ 20:19-20</ref></char></note> <verse eid="LEV 18:12"/><verse number="13" style="v" sid="LEV 18:13"/>አሹዋ አሙዋ ፖላናዉ ነ ዳይ ምቻትና ግሶፓ፤ እዛ ነ ዳይዉ ማታ ዳቦ። <verse eid="LEV 18:13"/><verse number="14" style="v" sid="LEV 18:14"/>ነ አዉዋ እሻ ካሉዋ ቃራደ ነ አሹዋ አሙዋ ፖላናዉ አ ማቻትና ግሶፓ፤ እዛ ነ አዉዋ እሻ ማቻቶ። <verse eid="LEV 18:14"/><verse number="15" style="v" sid="LEV 18:15"/>ነ አሹዋ አሙዋ ፖላናዉ ነ ናኣ ማቻትና ግሶፓ፤ እዛ ነ ናኣ ማቻቶ ግድያ ድራዉ፥ ኢናና ግሶፓ።<note caller="-" style="x"><char style="xo" closed="false">18:15 </char><char style="xt" closed="false"><ref loc="LEV 20:12">ዎጋ 20:12</ref></char></note> <verse eid="LEV 18:15"/><verse number="16" style="v" sid="LEV 18:16"/>ነ አሹዋ አሙዋ ፖላናዉ ነ እሻ ማቻትና ግሶፓ፤ ግሶፐ ነ እሻ ካዉሻሳ።<note caller="-" style="x"><char style="xo" closed="false">18:16 </char><char style="xt" closed="false"><ref loc="LEV 20:21">ዎጋ 20:21</ref></char></note><verse eid="LEV 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 18:17"/>“ ‘ነ አሹዋ አሙዋ ፖላናዉ ምሽራትናነ እ ናትናነ ላኡዋና ግሶፓ። እ ናት ናትና ዎይ ቃይ እ ናኣ ናትናካ ግሶፓ፤ ኡንቱንቱ እዝዉ ማታ ዳቦ ግድያ ድራዉ፥ ሄዌ ሻርሙጻ።<note caller="-" style="x"><char style="xo" closed="false">18:17 </char><char style="xt" closed="false"><ref loc="LEV 20:14">ዎጋ 20:14</ref>፤ <ref loc="DEU 27:23">ዛረ. 27:23</ref></char></note><verse eid="LEV 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 18:18"/>“ ‘ነ ማቻታ ፓጻ ደእሽን፥ ነ ማቻት ምቻቶ አካደ ነ አሹዋ አሙዋ ፖላናዉ ኢናና ግሶፓ።<verse eid="LEV 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 18:19"/>“ ‘ነ አሹዋ አሙዋ ፖላናዉ ፒላይ ዪና ቱና ኡቴዳ ምሽራትና ግሶፓ።<note caller="-" style="x"><char style="xo" closed="false">18:19 </char><char style="xt" closed="false"><ref loc="LEV 20:18">ዎጋ 20:18</ref></char></note><verse eid="LEV 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 18:20"/>“ ‘ኔን ቱነናዳን ነ ሾሩዋ ማቻትና ግሶፓ።<note caller="-" style="x"><char style="xo" closed="false">18:20 </char><char style="xt" closed="false"><ref loc="LEV 20:10">ዎጋ 20:10</ref></char></note><verse eid="LEV 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 18:21"/>“ ‘ነ ጾሳ ሱን ቱንሳናዉ ነ ናናቱዋፐ እቱዋነ ታማን ጹጊደ፥ ሞሎካ ግያ ኤቃዉ ያርሻናዳን እሞፓ። ታን መና ጎዳ።<note caller="-" style="x"><char style="xo" closed="false">18:21 </char><char style="xt" closed="false"><ref loc="LEV 20:1-5">ዎጋ 20:1-5</ref></char></note><verse eid="LEV 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 18:22"/>“ ‘ማጫ አሳና ግስያዋዳን አቱማ አሳና ግሶፓ፤ ሄዌ ሸነይያባ።<note caller="-" style="x"><char style="xo" closed="false">18:22 </char><char style="xt" closed="false"><ref loc="LEV 20:13">ዎጋ 20:13</ref></char></note><verse eid="LEV 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 18:23"/>“ ‘ኔን ቱነናዳን አይ መህያናነ ግሶፓ፥ ቃይ ማጫ አሳይካ መህያና ግሳናዉ መህያ ስን አፖ። ሄዌ ዎጋይ ባይናዋ።<note caller="-" style="x"><char style="xo" closed="false">18:23 </char><char style="xt" closed="false"><ref loc="EXO 22:19">ከሳ 22:19</ref>፤ <ref loc="LEV 20:15-16">ዎጋ 20:15-16</ref>፤ <ref loc="DEU 27:21">ዛረ. 27:21</ref></char></note><verse eid="LEV 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 18:24"/>“ ‘ታን ህንተ ስንፐ የደርስያ ካዉተቱ ሀ ኦሶቱዋን ቱኔዳ ድራዉ፥ ህንተ ሀዋንታ ማላትያዋቱዋን ቱኖፕተ። <verse eid="LEV 18:24"/><verse number="25" style="v" sid="LEV 18:25"/>ሀራይ አቶ ኡንቱንቱ ቢታይካ ቱኔዳ ድራዉ፥ አ ናጋራዉ ታን አ ሙራድ፤ ቢታይካ ባረናን ደእያዋንታ ጩቼዳ። <verse eid="LEV 18:25"/><verse number="26" style="v" sid="LEV 18:26"/>ሽን ህንተ ታ ህግያነ ታ አዛዙዋ ናግተፐ አትና፥ እስራኤልያ አሳ ግድና ዎይ ህንተ ግዶን ደእያ ሀራ ቢታ አሳፐ ኦንነ ሀዋ ማላ ቱና ኦሱዋ ኦፕተ።<verse eid="LEV 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 18:27"/>“ ‘ህንተፐ ካሰ ሀ ጋድያን ደኤዳ አሳቱ ሀዋ ማላ ቱናባ ኦዳ ድራዉ፥ ቢታይ ቱኔዳ። <verse eid="LEV 18:27"/><verse number="28" style="v" sid="LEV 18:28"/>ህንተ ሀ ቢታ ቱንሶፐ፥ ህንተፐ ካሰ ደኤዳ ካዉተቱዋ ሀ ቢታይ ጩቼዳዋዳን፥ ህንተናካ ጩቼናዳን ናገትተ። <verse eid="LEV 18:28"/><verse number="29" style="v" sid="LEV 18:29"/>ሄዋንታ ማላትያ ቱና ኦሶቱዋፐ እቱዋነ ኦያ አሳይ ደኦፐ፥ ሄ አሳይ ባረ አሳ ግዶፐ ቦሄቶ።<verse eid="LEV 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 18:30"/>“ ‘ሄዋ ድራዉ ህንተፐ ካሰ ደኤዳ አሳቱ ኦዳ ቱና ኦሶቱዋ ኡባ ኦደ ህንተ ቱነናዳን፥ ህንተ ታ አዛዙዋ ናግተ፤ ታን፥ መና ጎዳይ፥ ህንተ ጾሳ’ ያጋ” ያጌዳ።<verse eid="LEV 18:30"/></para>
  <chapter eid="LEV 18"/>
  <chapter number="19" style="c" sid="LEV 19"/>
  <para style="s1">ጌሻተነ ልከ ፕርዳ ህገቱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 19:1"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="LEV 19:1"/><verse number="2" style="v" sid="LEV 19:2"/>“እስራኤልያ አሳዉ ኡባዉ ሀዋዳን ያጋደ ኦዳ፤ ‘ታን፥ መና ጎዳይ፥ ህንተ ጾሳይ ጌሻ ግድያ ድራዉ፥ ህንተካ ጌሻ ግድተ።<note caller="-" style="x"><char style="xo" closed="false">19:2 </char><char style="xt" closed="false"><ref loc="LEV 11:44-45">ዎጋ 11:44-45</ref>፤ <ref loc="1PE 1:16">1 ጰጽ. 1:16</ref></char></note><verse eid="LEV 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 19:3"/>“ ‘ህንተፐ እቱነ አተናን ባረ አባነ ባረ ዳዮ ቦንቾ፤ ታ ሳምባታቱዋካ ቦንችተ። ታን፥ ጾሳይ፥ ህንተ ጾሳ።<note caller="-" style="x"><char style="xo" closed="false">19:3 </char><char style="xt" closed="false"><ref loc="EXO 20:8">ከሳ 20:8</ref>፣ <ref loc="EXO 20:12">12</ref>፤ <ref loc="DEU 5:12">ዛረ. 5:12</ref>፣ <ref loc="DEU 5:16">16</ref></char></note><verse eid="LEV 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 19:4"/>“ ‘ታና አጊደ ኤቃቶ ጎይኖፕተ፤ ዎይ ቃይ ብራታፐ ሲልሴዳ፥ ጾሳቱዋ ህንተንቶ መፕተ። ታን፥ መና ጎዳይ፥ ህንተ ጾሳ።<note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="LEV 26:1">ዎጋ 26:1</ref>፤ <ref loc="EXO 20:23">ከሳ 20:23</ref>፤ <ref loc="EXO 34:17">34:17</ref>፤ <ref loc="DEU 27:15">ዛረ. 27:15</ref></char></note><verse eid="LEV 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 19:5"/>“ ‘ህንተ እትፐተ ያርሹዋ መና ጎዳዉ ያርሽያ ዎደ፥ ሄ ያርሹ ህንተ ድራዉ አከታናዳን፥ በስያዋዳን ያርሽተ። <verse eid="LEV 19:5"/><verse number="6" style="v" sid="LEV 19:6"/>ሄ ያርሹ ህንተ ያርሼዳ ጋላሳን ዎይ ዎንተ ጋላሳን ሜተቶ፤ ሄዘን ጋላሳይ ጋካናዉ አቴዳዌ ደኦፐ ሄዌ ጹገቶ። <verse eid="LEV 19:6"/><verse number="7" style="v" sid="LEV 19:7"/>ሄዛን ጋላሳን አ ሞፐ፥ ሄዌ ሸነይያባ፤ ታን ሄዋ አክከ። <verse eid="LEV 19:7"/><verse number="8" style="v" sid="LEV 19:8"/>ሄዋ ምያ ኦንነ ባረ ናጋራን ኦሸቴ፤ አያዉ ጎፐ፥ እ መና ጎዳዉ ጌሻ ግዴዳዋ ቱንሴዳ። ሄ አሳይ ባረ አሳ ግዶፐ ቦሄቶ።<verse eid="LEV 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 19:9"/>“ ‘ህንተ ጋድያን ሞኬዳ ካ ህንተ ጫክያ ዎደ፥ ጋድያ ጋጻ ጋካናዉ ጫኮፕተ፤ ቃይ ጫካፐ ስምና ደእያ ቃርምያካ ቃርሞፕተ።<note caller="-" style="x"><char style="xo" closed="false">19:9-10 </char><char style="xt" closed="false"><ref loc="LEV 23:22">ዎጋ 23:22</ref>፤ <ref loc="DEU 24:19-22">ዛረ. 24:19-22</ref></char></note> <verse eid="LEV 19:9"/><verse number="10" style="v" sid="LEV 19:10"/>ነ ዎይንያ አይፍያ ሙለ ማጻደ ም ካሎዮፓ፤ ሳኣን ዎዳ ዎይንያ አይፍያካ ማጾፓ፤ ሄዋ ህዬሳቶነ በተቶ አጋ። ታን፥ መና ጎዳይ፥ ህንተ ጾሳ።<verse eid="LEV 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 19:11"/>“ ‘ህንተ ዉኦፕተ።</para>
  <para style="p" vid="LEV 19:11">“ ‘ዎርዶቶፕተ።</para>
  <para style="p" vid="LEV 19:11">“ ‘እቱ እቱዋ ጭሞፕተ።<note caller="-" style="x"><char style="xo" closed="false">19:11 </char><char style="xt" closed="false"><ref loc="EXO 20:15">ከሳ 20:15</ref>፣ <ref loc="EXO 20:16">16</ref>፤ <ref loc="DEU 5:19">ዛረ. 5:19</ref>፣ <ref loc="DEU 5:20">20</ref></char></note><verse eid="LEV 19:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 19:12"/>“ ‘ታ ሱንን ዎርዱዋን ጫቆፕተ፤ ያቲደ ህንተ ጾሳ ሱን ቱንሶፕተ። ታን መና ጎዳ።<note caller="-" style="x"><char style="xo" closed="false">19:12 </char><char style="xt" closed="false"><ref loc="EXO 20:7">ከሳ 20:7</ref>፤ <ref loc="DEU 5:11">ዛረ. 5:11</ref>፤ <ref loc="MAT 5:33">ማቶሳ 5:33</ref></char></note><verse eid="LEV 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 19:13"/>“ ‘ነ ሾሩዋ ሱጎፓ፤ ዎይ ቦንቆፓ።</para>
  <para style="p" vid="LEV 19:13">“ ‘ከራ ኦያ ብታንያ ድርጉዋ ድጋደ፥ እት ቃማነ ነ ማታን አይሶፓ።<note caller="-" style="x"><char style="xo" closed="false">19:13 </char><char style="xt" closed="false"><ref loc="DEU 24:14-15">ዛረ. 24:14-15</ref></char></note><verse eid="LEV 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 19:14"/>“ ‘ቱልያ ሸቆፓ፤ ዎይ ቃይ ቆቅያ ስንን ቢያዋ ዎፓ፤ ሽን ኔን ጾሳዉ ያያ። ታን መና ጎዳ።<note caller="-" style="x"><char style="xo" closed="false">19:14 </char><char style="xt" closed="false"><ref loc="DEU 27:18">ዛረ. 27:18</ref></char></note><verse eid="LEV 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 19:15"/>“ ‘ፕርዳ ፕርዳደ ደሽሶፓ፤ ህዬሳ አ ህዬሳተ ድራዉ ማዳደ ፕርዶፓ፤ ዱርያካ አ ዱረተ ድራዉ ያያደ አጎፓ። ሽን ነ ሾሮ ቱማተን ፕርዳ።<note caller="-" style="x"><char style="xo" closed="false">19:15 </char><char style="xt" closed="false"><ref loc="EXO 23:6-8">ከሳ 23:6-8</ref>፤ <ref loc="DEU 16:19">ዛረ. 16:19</ref></char></note><verse eid="LEV 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 19:16"/>“ ‘ነ አሳ ግዶን ኢታ ዝግርሳ አካደ ዩዮፓ።</para>
  <para style="p" vid="LEV 19:16">“ ‘ነ ሾሩዋ ዎያዋ አያነ ኦፓ። ታን መና ጎዳ።<verse eid="LEV 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 19:17"/>“ ‘ነ እሻ ነ ዎዛናን እጾፓ።</para>
  <para style="p" vid="LEV 19:17">“ ‘ነ ሾሩዋ ጋሱዋን ኔን ናጋራ ኦና ማላ፥ አ ሴራ።<verse eid="LEV 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 19:18"/>“ ‘ኩሽያ ጭጎፓ፤ ቃይ ነ አሳፐ እቶነ ኡሉዋን ቅምያ ኦይቆፓ። ሽን ነ ሾሩዋ ነ ሁጲያዳን ሲቃ። ታን መና ጎዳ።<note caller="-" style="x"><char style="xo" closed="false">19:18 </char><char style="xt" closed="false"><ref loc="MAT 5:43">ማቶሳ 5:43</ref>፤ <ref loc="MAT 19:19">19:19</ref>፤ <ref loc="MAT 22:39">22:39</ref>፤ <ref loc="MRK 12:31">ማር. 12:31</ref>፤ <ref loc="LUK 10:27">ሉቃሳ 10:27</ref>፤ <ref loc="ROM 13:9">ሮመ 13:9</ref>፤ <ref loc="GAL 5:14">ጋላ. 5:14</ref>፤ <ref loc="JAS 2:8">ያቆባ 2:8</ref></char></note><verse eid="LEV 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 19:19"/>“ ‘ታ አዛዞቱዋ ናጋ።</para>
  <para style="p" vid="LEV 19:19">“ ‘ነ መህያፐ እት ቆሞ መህያ ሀራ ቆሞ ዱማ መህያን ብራስሶፓ።</para>
  <para style="p" vid="LEV 19:19">“ ‘እት ሾይቃን ላኡ ቆሞ ዘረ ዘሮፓ።</para>
  <para style="p" vid="LEV 19:19">“ ‘ቃይ ላኡ ቆሙዋፐ ዳደቴዳ ማዩዋ ማዮፓ።<note caller="-" style="x"><char style="xo" closed="false">19:19 </char><char style="xt" closed="false"><ref loc="DEU 22:9-11">ዛረ. 22:9-11</ref></char></note><verse eid="LEV 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 19:20"/>“ ‘እት አሳይ ሀራ አሳ ገላናዉ ጊጋ ኡቴዳ ዳንጋጽራትና ግሶፐ፥ ቃይ ሄ ዳንጋጽራታካ ባረ ዳንጋጽረተፐ ዎዘታቤናኖ ግዶፐ፥ ኡንቱንቱ ሙረታናዉ በሴ፤ ሽን እዛ ባረ ዳንጋጽረተፐ ዎዘታቤና ድራዉ፥ ኡንቱንታ ዎናዉ ኮሸና። <verse eid="LEV 19:20"/><verse number="21" style="v" sid="LEV 19:21"/>ግዶፐነ ሄ ብታኒ ባረ ናቁዋ ያርሾ ግድያ ዶርሳ ኦርግያ ጾሳ ዱንካንያኮ መና ጎዳ ስን አሆ። <verse eid="LEV 19:21"/><verse number="22" style="v" sid="LEV 19:22"/>ቄሲ ሄ ናቁዋ ያርሹዋ ዶርሳ አኪደ፥ ብታኒ ኦዳ ናጋራ መና ጎዳ ስንን አቶ ጊሴ፤ እ ኦዳ ናጋራይካ አቶ ጌተታና።<verse eid="LEV 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 19:23"/>“ ‘ህንተ ካናነ ቢታ ገልያ ዎደ፥ አይፍያ ምያ አይ ቆሞ ም ቶኮፐካ፥ ሄ ም አይፍያ ሜተተናዋዳን ፓይድተ፤ ሄዙ ላይይ ዉራናዉ ሄ ም አይፊ ሜተተና፤ አ ሞፕተ። <verse eid="LEV 19:23"/><verse number="24" style="v" sid="LEV 19:24"/>ኦይደን ላይን ሄ ም አይፊ ኡባይ መና ጎዳዉ ጋላታ ሺሽያ ጌሻ ያርሹዋ ግዳናዋ። <verse eid="LEV 19:24"/><verse number="25" style="v" sid="LEV 19:25"/>ሽን ሄ ም አይፊ ህንተንቶ ሎይ ዳራና ማላ፥ እቼሸን ላይ አይፍያ ሚተ። ህንተ ሀዋዳን ኦፐ፥ ህንተ ም አይፊ ዳራና። ታን መና ጎዳይ ህንተ ጾሳ።<verse eid="LEV 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 19:26"/>“ ‘ሱይ አ ግዶን ደእያ አይ አሹዋካ ሞፕተ።</para>
  <para style="p" vid="LEV 19:26">“ ‘ካዮፕተ ዎይ ሻሬቾፕተ።<note caller="-" style="x"><char style="xo" closed="false">19:26 </char><char style="xt" closed="false"><ref loc="GEN 9:4">ዶመ 9:4</ref>፤ <ref loc="LEV 7:26-27">ዎጋ 7:26-27</ref>፤ <ref loc="LEV 17:10-14">17:10-14</ref>፤ <ref loc="DEU 12:16">ዛረ. 12:16</ref>፣ <ref loc="DEU 12:23">23</ref>፤ <ref loc="DEU 15:23">15:23</ref>፤ <ref loc="DEU 18:10">18:10</ref></char></note><verse eid="LEV 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 19:27"/>“ ‘ህንተ ሁጲያ ብናና ጋርሳና ዩሽ አደ ቃንጾፕተ፤ ቃይ ህንተ ቡቻካ ዩሽ አደ ቃንጾፕተ።<note caller="-" style="x"><char style="xo" closed="false">19:27-28 </char><char style="xt" closed="false"><ref loc="LEV 2:5">ዎጋ 2:5</ref>፤ <ref loc="DEU 14:1">ዛረ. 14:1</ref></char></note><verse eid="LEV 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 19:28"/>“ ‘ሀይቄዳ አሳ ድራዉ ህንተ ቦላ ቃንጸሬፕተ፤ ዎይ ጫቻ ማላታ ህንተ ቦላን ከሶፕተ። ታን መና ጎዳ።<verse eid="LEV 19:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 19:29"/>“ ‘ቢታይ ዎዳላ ቱናተን ኩሜዳዋ ግደና ማላ፥ ነ ናቶ ሻርሙጻ ኦሶ አ እማደ ቱንሶፓ።<note caller="-" style="x"><char style="xo" closed="false">19:29 </char><char style="xt" closed="false"><ref loc="DEU 23:17">ዛረ. 23:17</ref></char></note><verse eid="LEV 19:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 19:30"/>“ ‘ታ ሳምባታቱዋ ቦንችተ፤ ታዉ ጎይንያ ሳኣካ ቦንችተ። ታን መና ጎዳ።<note caller="-" style="x"><char style="xo" closed="false">19:30 </char><char style="xt" closed="false"><ref loc="LEV 26:2">ዎጋ 26:2</ref></char></note><verse eid="LEV 19:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 19:31"/>“ ‘ሞይትልያ ሃሳይስያዋንቱኮነ ሻሬቾቱዋኮ ቦፕተ፤ ህንተ ቱነና ማላ ኡንቱንታ ኮዮፕተ። ታን፥ መና ጎዳይ፥ ህንተ ጾሳ።<note caller="-" style="x"><char style="xo" closed="false">19:31 </char><char style="xt" closed="false"><ref loc="DEU 18:11">ዛረ. 18:11</ref>፤ <ref loc="1SA 28:3">1 ሳሜላ 28:3</ref>፤ <ref loc="2KI 23:4">2 ካታ. 23:4</ref>፤ <ref loc="ISA 8:19">ኢሳ. 8:19</ref></char></note><verse eid="LEV 19:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 19:32"/>“ ‘ፑሉሜዳ አሳነ ጭሜዳ አሳ በእያ ዎደ ኡቴዳ ሳኣፐ ደንዳ ኤቃ፤ ኡንቱንታ ቦንቻ፤ ነ ጾሳዉ ያያ። ታን መና ጎዳ።<verse eid="LEV 19:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 19:33"/>“ ‘ህንተ ጋድያን ህንተናና ደእያ በተቱዋ ቦላን ሱገባ ኦፕተ።<note caller="-" style="x"><char style="xo" closed="false">19:33-34 </char><char style="xt" closed="false"><ref loc="EXO 22:21">ከሳ 22:21</ref>፤ <ref loc="DEU 24:17-18">ዛረ. 24:17-18</ref>፤ <ref loc="DEU 27:19">27:19</ref></char></note> <verse eid="LEV 19:33"/><verse number="34" style="v" sid="LEV 19:34"/>ህንተ ጋድያን ህንተናና ደእያ በተ አሳ ህንተ ቢታ አሳዳን ጼልተ፤ አ ህንተ ሁጲያዳን ሲቅተ። አያዉ ጎፐ፥ ህንተካ ካሰ ግብጼ ጋድያን በተ ግዲደ ደኤድታ። ታን፥ መና ጎዳይ፥ ህንተ ጾሳ።<verse eid="LEV 19:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 19:35"/>“ ‘ህንተ ጌሳ ልክያባን፥ ሚዛናን ዎደ ልክያባንነ ማክያባን ዎርዶቶፕተ።<note caller="-" style="x"><char style="xo" closed="false">19:35-36 </char><char style="xt" closed="false"><ref loc="DEU 25:13-16">ዛረ. 25:13-16</ref>፤ <ref loc="PRO 20:10">ሌም. 20:10</ref>፤ <ref loc="EZK 45:10">ህዝ. 45:10</ref></char></note> <verse eid="LEV 19:35"/><verse number="36" style="v" sid="LEV 19:36"/>ህንተ ኪሉዋ ሚዛናይ፥ ህንተ ማክያባይነ ልክያ ሚሻቱ ኡባይ ልከ ግድኖ። ታን ህንተና ግብጼ ጋድያፐ ከሳደ አሄዳ መና ጎዳ ህንተ ጾሳ። <verse eid="LEV 19:36"/><verse number="37" style="v" sid="LEV 19:37"/>ህንተ ታ ህግያነ ታ አዛዙዋ ኡባ ናግተነ ኦተ። ታን መና ጎዳ ያጋ’ ” ያጌዳ።<verse eid="LEV 19:37"/></para>
  <chapter eid="LEV 19"/>
  <chapter number="20" style="c" sid="LEV 20"/>
  <para style="s1">አዛዘተናን እጽና ጋክያ ሙራ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 20:1"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="LEV 20:1"/><verse number="2" style="v" sid="LEV 20:2"/>“እስራኤልያ አሳዉ ሀዋዳን ያጋደ ኦዳ፥ ‘እስራኤልያ አሳፐ ግድና፥ ዎይ በቲደ ዪደ እስራኤልያ ግዶን ደእያ ሀራ ቢታ አሳፐ ግድናካ፥ ኦንነ ባረ ናናቱዋፐ እቱዋ ሞሎካ ግያ ኤቃዉ አደ እሞፐ፥ ሄ አሳይ ሀይቆ፤ ሄ ቢታ አሳይ አ ሹቻን ጫዲደ ዎ። <verse eid="LEV 20:2"/><verse number="3" style="v" sid="LEV 20:3"/>ታን ሄ ብታንያ እጻና፤ አ አሳ ግዶፐ ሾዳደ አ ይሳና። አያዉ ጎፐ፥ እ ባረ ናናቱዋፐ እቱዋ ሞሎካ ግያ ኤቃዉ እምያዋን፥ ታ ዱንካንያ ቱንሴዳ፤ ታ ጌሻ ሱንካ ካዉሽሴዳ። <verse eid="LEV 20:3"/><verse number="4" style="v" sid="LEV 20:4"/>ሄ ብታኒ ባረ ናናቱዋፐ እቱዋ ሞሎካዉ እምያ ዎደ፥ ሄ ቢታ አሳይ በኢደ፥ ሸነኮ ጎፐ፥ ቃይ ብታንያካ ዎናን አጎፐ፥ <verse eid="LEV 20:4"/><verse number="5" style="v" sid="LEV 20:5"/>ታን ታ ሁጲያዉ ሄ ብታንያነ ሄ ሶ አሳ እጻና፤ ሞሎከና ሻርሙጻናዉ አ ካልያ ኡባቱዋ ኡንቱንቱ አሳ ግዶፐ ቦህተ።<verse eid="LEV 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 20:6"/>“ ‘አይ አሳይነ ታናን አማነተናን እጺደ፥ ሞይትልያ ሃሳይስያዋንታነ ሻሬቾቱዋ ኦቻናዉ ቦፐ፥ ታን አ እጻና፤ አ አሳ ግዶፐካ ይሳና።<verse eid="LEV 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 20:7"/>“ ‘ታን፥ መና ጎዳይ፥ ህንተ ጾሳ ግድያ ድራዉ፥ ስም ህንተ ህንተና ዱማይተ፤ ቃይ ጌሻ ግድተ። <verse eid="LEV 20:7"/><verse number="8" style="v" sid="LEV 20:8"/>ታ ህግያ ናግተነ ኦተ። ታን ህንተና ጌሽያ መና ጎዳ።<verse eid="LEV 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 20:9"/>“ ‘አይ አሳይነ ባረ አዉዋ ዎይ ባረ ዳዮ ሸቆፐ ሀይቆ። እ ባረ አዉዋ ዎይ ባረ ዳዮ ሸቄዳ ድራዉ፥ አ ሱ አጩ አ ቦላና።<note caller="-" style="x"><char style="xo" closed="false">20:9 </char><char style="xt" closed="false"><ref loc="EXO 21:17">ከሳ 21:17</ref>፤ <ref loc="MAT 15:4">ማቶሳ 15:4</ref>፤ <ref loc="MRK 7:10">ማር. 7:10</ref></char></note><verse eid="LEV 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 20:10"/>“ ‘እት አሳይ ባረ ሾሩዋ ማቻትና ግሶፐ፥ ሄ ግሴዳ ብታኒነ ምሽርታ ላኡካ ሀይቂኖ።<note caller="-" style="x"><char style="xo" closed="false">20:10 </char><char style="xt" closed="false"><ref loc="EXO 20:14">ከሳ 20:14</ref>፤ <ref loc="LEV 18:20">ዎጋ 18:20</ref>፤ <ref loc="DEU 5:18">ዛረ. 5:18</ref></char></note> <verse eid="LEV 20:10"/><verse number="11" style="v" sid="LEV 20:11"/>ባረ አዉዋ ማቻትና ግሴዳ አሳይ ባረ አዉዋ ካዉሽሴዳ፤ ኡንቱንቱ ላኡካ ሀይቂኖ። ኡንቱንቱ ሱ አጩ ኡንቱንቱ ቦላና።<note caller="-" style="x"><char style="xo" closed="false">20:11 </char><char style="xt" closed="false"><ref loc="LEV 18:8">ዎጋ 18:8</ref>፤ <ref loc="DEU 22:30">ዛረ. 22:30</ref>፤ <ref loc="DEU 27:20">27:20</ref></char></note> <verse eid="LEV 20:11"/><verse number="12" style="v" sid="LEV 20:12"/>እት አሳይ ባረ ናኣ ማቻትና ግሶፐ፥ ኡንቱንቱ ላኡካ ሀይቂኖ። ኡንቱንቱ ቱናባ ኦድኖ። ኡንቱንቱ ሱ አጩ ኡንቱንቱ ቦላና።<note caller="-" style="x"><char style="xo" closed="false">20:12 </char><char style="xt" closed="false"><ref loc="LEV 18:15">ዎጋ 18:15</ref></char></note><verse eid="LEV 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 20:13"/>“ ‘እት አቱማ አሳይ ማጫ አሳና ግስያዋዳን አቱማ አሳና ግሶፐ፥ ኡንቱንቱ ላኡካ ቱናባ ኦዳ ድራዉ ሀይቂኖ። ኡንቱንቱ ሱ አጩ ኡንቱንቱ ቦላና።<note caller="-" style="x"><char style="xo" closed="false">20:13 </char><char style="xt" closed="false"><ref loc="LEV 18:22">ዎጋ 18:22</ref></char></note> <verse eid="LEV 20:13"/><verse number="14" style="v" sid="LEV 20:14"/>እት አሳይ ናቶነ አቶነ እትፐ አክያዋ ግዶፐ፥ ሄዌ ቱናባ፤ ህንተ ግዶን ቱናተይ ደኤና ማላ፥ እነ ኡንቱንቱነ ታማን ጹገትኖ።<note caller="-" style="x"><char style="xo" closed="false">20:14 </char><char style="xt" closed="false"><ref loc="LEV 18:17">ዎጋ 18:17</ref>፤ <ref loc="DEU 27:23">ዛረ. 27:23</ref></char></note><verse eid="LEV 20:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 20:15"/>“ ‘እት አሳይ መህያና ግሶፐ፥ እ ሀይቆ፤ ሄ ማጫ መሀቶካ ዎተ።<note caller="-" style="x"><char style="xo" closed="false">20:15-16 </char><char style="xt" closed="false"><ref loc="EXO 22:19">ከሳ 22:19</ref>፤ <ref loc="LEV 18:23">ዎጋ 18:23</ref>፤ <ref loc="DEU 27:21">ዛረ. 27:21</ref></char></note> <verse eid="LEV 20:15"/><verse number="16" style="v" sid="LEV 20:16"/>እት ማጫ አስ መህያና ግሶፐ ሄ ምሽራቶነ ሄ መህያ ላኡዋካ ዎተ፤ ኡንቱንቱ ሀይቂኖ። ኡንቱንቱ ሱ አጩ ኡንቱንቱ ቦላና።<verse eid="LEV 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 20:17"/>“ ‘እት አሳይ ባረ ምቻቶ ባረ አዉዋ ናትና ዎይ ባረ ዳይ ናትና ግሶፐ፥ ሄዌ ፖኮባ። ኡንቱንቱ ባረንቱ አሳ ግዶፐ ቦሄትኖ። እ ባረ ምቻቶ ካዉሼዳ ድራዉ፥ እ ባረ ናጋራን ኦሸቴ።<note caller="-" style="x"><char style="xo" closed="false">20:17 </char><char style="xt" closed="false"><ref loc="LEV 18:9">ዎጋ 18:9</ref>፤ <ref loc="DEU 27:22">ዛረ. 27:22</ref></char></note> <verse eid="LEV 20:17"/><verse number="18" style="v" sid="LEV 20:18"/>እት አሳይ ፒላይ ዬዳ ማጫን ካሉዋ ቃሪደ ኢናና ግሶፐ፥ ኡንቱንቱ ላኡካ ባረንቱ አሳ ግዶፐ ቦሄትኖ። አያዉ ጎፐ እ እዝ ሱይ ጎግያ ፑልቱዋ ካሎዬዳ፤ እዛካ ባረ ሱይ ጎግያ ፑልቱዋ ካሎያዱ።<note caller="-" style="x"><char style="xo" closed="false">20:18 </char><char style="xt" closed="false"><ref loc="LEV 18:19">ዎጋ 18:19</ref></char></note><verse eid="LEV 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 20:19"/>“ ‘ነ ዳይ ምቻትና ዎይ ነ አዉዋ ምቻትና ግሶፓ፤ አያዉ ጎፐ፥ ሄዋ ኦያዌ ባረ ማታ ዳቡዋ ካዉሽያዋ። ህንተ ላኡካ ህንተ ናጋራን ኦሸታና።<note caller="-" style="x"><char style="xo" closed="false">20:19-20 </char><char style="xt" closed="false"><ref loc="LEV 18:12-14">ዎጋ 18:12-14</ref></char></note> <verse eid="LEV 20:19"/><verse number="20" style="v" sid="LEV 20:20"/>እት አሳይ ባረ አዉዋ እሻ ማቻትና ግሶፐ፥ እ ባረ አዉዋ እሻ ካዉሽሴዳ። ኡንቱንቱ ባረንቱ ናጋራን ኦሸታና፤ ኡንቱንቱ ላኡካ ናኣ የለናን ሀይቃና።<note caller="-" style="x"><char style="xo" closed="false">20:20 </char><char style="xt" closed="false"><ref loc="LEV 18:16">ዎጋ 18:16</ref></char></note> <verse eid="LEV 20:20"/><verse number="21" style="v" sid="LEV 20:21"/>እት አሳይ ባረ እሻ ማቻቶ አኮፐ፥ ሄዌ ቱናተ። እ ባረ እሻ ካዉሽሴዳ፤ ኡንቱንቱ ላኡካ ናኣ የልክኖ።<verse eid="LEV 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 20:22"/>“ ‘ስም ህንተ ደአናዳን፥ ታን ህንተና ገልስያ ቢታይ ህንተና ጩቼና ማላ፥ ህንተ ታ ህግያነ ታ አዛዙዋ ናግተነ ኦተ። <verse eid="LEV 20:22"/><verse number="23" style="v" sid="LEV 20:23"/>ታን ህንተ ስንፐ ይስያ አሳቱዋ ደኡዋ ዎጋ ካሎፕተ። ኡንቱንቱ ሀዋ ኡባ ኦዳ ድራዉ፥ ታን ኡንቱንታ ሸነታድ። <verse eid="LEV 20:23"/><verse number="24" style="v" sid="LEV 20:24"/>ሽን ታን ህንተና፥ “ኡንቱንቱ ቢታ ህንተ ላታና፤ ህንተ ሄ ቢታ ህንተዋ ኦናዳን፥ ሄ ማይነ ኤሳይ ጎግያ ቢታ ታን ህንተንቶ እማና” ያጋድ። ታን ህንተና ሀራ አሳቱዋፐ ዱማያ ከሴዳ መና ጎዳ ህንተ ጾሳ።<verse eid="LEV 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 20:25"/>“ ‘ሄዋ ድራዉ ህንተ ጌሻ ግዴዳ መሄቱዋነ ካፎቱዋ ጌሻ ግደናዋንቱፐ ሻኪደ ኤርተ። ታን ሀዋንቱ ህንተንቶ ቱና ጋ ዎዳ መሄቱዋን፥ ካፎቱዋንነ ሳኣን ቃጸረትያባቱዋን ኡባን ህንተ ሁጲያ ቱንሶፕተ። <verse eid="LEV 20:25"/><verse number="26" style="v" sid="LEV 20:26"/>ታን መና ጎዳይ ጌሻ ግድያ ድራዉነ ህንተ ታዋ ግዳና ማላ ህንተና ሀራ አሳፐ ዱማዬዳ ድራዉ፥ ህንተካ ታዉ ጌሻ ግድተ።<verse eid="LEV 20:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 20:27"/>“ ‘እት አቱማ አሳይ ዎይ ማጫ አሳይ ሞይትልያና ሃሳይያዋ ዎይ ሻሬቾ ግዶፐ፥ ኡንቱንቱ ሀይቃናዉ በሰ። ኡንቱንቱ ሹቻን ጫደትኖ። ኡንቱንቱ ሱ አጩ ኡንቱንቱ ቦላና’ ያጋ” ያጌዳ።<verse eid="LEV 20:27"/></para>
  <chapter eid="LEV 20"/>
  <chapter number="21" style="c" sid="LEV 21"/>
  <para style="s1">ቄሳቱዋ ጌሻተ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 21:1"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፥ “ቄስያ ግድያ አሮና አቱማ ናናቶ ሀዋዳን ያጋደ ኦዳ፤ ‘ህንተፐ ኦንነ <verse eid="LEV 21:1"/><verse number="2" style="v" sid="LEV 21:2"/>ባረ ማታ ዳቦ፥ ባረ ዳይ፥ ባረ አዉዋ፥ ባረ አቱማ ናኣ፥ ባረ ማጫ ናት፥ ባረ እሻ፥ <verse eid="LEV 21:2"/><verse number="3" style="v" sid="LEV 21:3"/>ዎይ አስና ገለናን፥ ደእያ ባረ ምቻት አሃ ግዳና ዮፐ፥ ሀይቄዳ አሳ አሃ ኦዋነ ቦቺደ፥ ባረና ቱንሶፖ። <verse eid="LEV 21:3"/><verse number="4" style="v" sid="LEV 21:4"/>ቃይ አኩዋንነ ገሉዋን ዳቦቴዳ አሳ አሃ ቦቺደካ ባረና ቱንሶፖ።<verse eid="LEV 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 21:5"/>“ ‘ቄሳቱ ሀይቄዳዎ ካዮታናዉ ባረንቱ ሁጲያ ሜደቶፕኖ፤ ባረንቱ ቡቻካ ቃንን ቃንጾፕኖ፤ ዎይ ቃይ ባረንቱ ቦላካ ቃንጸሬፕኖ።<note caller="-" style="x"><char style="xo" closed="false">21:5 </char><char style="xt" closed="false"><ref loc="LEV 19:27-28">ዎጋ 19:27-28</ref>፤ <ref loc="DEU 14:1">ዛረ. 14:1</ref></char></note> <verse eid="LEV 21:5"/><verse number="6" style="v" sid="LEV 21:6"/>ኡንቱንቱ ባረንቱ ጾሳዉ ጌሻ ግድኖ፤ ቃይ ባረንቱ ጾሳ ሱንካ ቱንሶፕኖ። አያዉ ጎፐ ኡንቱንቱ መና ጎዳዉ ታማን ጹጊደ ያርሽያ፥ ቁማ ያርሹዋ ሺሽያዋንታ፤ ሄዋ ድራዉ፥ ኡንቱንቱ ጌሻ ግዳናዉ በሴ።<verse eid="LEV 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 21:7"/>“ ‘ቃይካ ቄሳቱ ሻርሙጻ ማጫ አሳ፥ ዎዶሮተይ አከት ድጌዳ ማጫ አሳ፥ ዎይ አስናይ የዴዳ ማጫ አሳ አኮፕኖ። አያዉ ጎፐ፥ ቄሳቱ ባረንቱ ጾሳዉ ጌሻ። <verse eid="LEV 21:7"/><verse number="8" style="v" sid="LEV 21:8"/>ቄሲ ህንተ ጾሳዉ ቁማ ያርሹዋ ሺሽያዋ ግድያ ድራዉ፥ እ ሀራ አሳፐ ዱማቶ። ታን ህንተና ጌሽያ ህንተ መና ጎዳይ ጌሻ ግድያ ድራዉ፥ እካ ጌሻ ግዶ። <verse eid="LEV 21:8"/><verse number="9" style="v" sid="LEV 21:9"/>አይ ቄስያ ናቶ ግዶፐካ ሻርሙጻደ ባረና ቱንሶፐ፥ ሄና ባረ አዉዋ ካዉሻዱ። እዛ ታማን ጹገታደ ሀይቁ።<verse eid="LEV 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 21:10"/>“ ‘ቄስያ ኡባቱዋ ካፑ፥ አ ሁጲያን ኦከትያ ዛይቲ ጉኬዳ ድራዉነ እ ቄሰተ ማዩዋ ማያናዉ ዱማቴዳ አሳ ግድያ ድራዉ፥ ባረ ሁጲያ ብናና ካሎ ዎፖ፤ ዎይ ባረ ማዩዋካ ፔፖ። <verse eid="LEV 21:10"/><verse number="11" style="v" sid="LEV 21:11"/>አይ አሃ ግዶፐካ፥ ደእያ ሳኣ እ ገሎፖ፤ ሀራይ አቶ ባረ አዉዋ ዎይ ባረ ዳይ አሃ ግዶፐካ፥ ባረና ሄዋን ቱንሶፖ። <verse eid="LEV 21:11"/><verse number="12" style="v" sid="LEV 21:12"/>አ ጌሻናዉ ኦክያ ጾሳ ዛይቲ አ ቦላን ደእያ ድራዉ፥ ቄሲ ጾሳ ዱንካንያፐ ከሶፖ፤ ጾሳ ዱንካንያካ ቱንሶፖ። ታን መና ጎዳ።<verse eid="LEV 21:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 21:13"/>“ ‘ቄሲ ዎዶሮ ማጫ ናቶ አኮ። <verse eid="LEV 21:13"/><verse number="14" style="v" sid="LEV 21:14"/>አስናይ ሀይቄዳ ምሽራቶ፥ ዎይ አስናይ የዴዳ ምሽራቶ፥ ዎይ ዎሹማ ምሽራቶ አኮፖ። ሽን ባረ አሳ ግዶፐ ዎዶሮ ማጫ ናቶ ዶሪደ አኮ። <verse eid="LEV 21:14"/><verse number="15" style="v" sid="LEV 21:15"/>ያናና ዮፐ፥ እ ባረ አሳ ግዶን ባረ ዘረ ግድያ ባረ ናናቱዋ ቱንሳና። ታን አ ጌሽያዌ፥ መና ጎዳ ያጋ’ ” ያጌዳ።<verse eid="LEV 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 21:16"/>መና ጎዳይ ሙሳ፥ ሀዋዳን ያጌዳ፤ <verse eid="LEV 21:16"/><verse number="17" style="v" sid="LEV 21:17"/>“ኔን አሮናዉ ሀዋዳን ያጋደ ኦዳ፤ ‘ስንና ይያ ነ ዘረፐ ቦላይ ትላ ግደና አሳይ ኦንነ ቁማ ያርሹዋ ታዉ እማናዉ ሺቆፖ። <verse eid="LEV 21:17"/><verse number="18" style="v" sid="LEV 21:18"/>አያዉ ጎፐ ቦላይ ትላ ግደና አሳይ ኦንነ ሺቃናዉ በሰና። ቆቃ፥ ዎይ ዎባ፥ ዎይ ደሙ ናርጰቴዳ፥ ዎይ ፓጫ ቦላይ ደእያ አሳይ፥ <verse eid="LEV 21:18"/><verse number="19" style="v" sid="LEV 21:19"/>ዎይ ገድያ ዎይ ኩሽያ ስላይ፥ <verse eid="LEV 21:19"/><verse number="20" style="v" sid="LEV 21:20"/>ዎይ ቁናይ፥ ዎይ ድንኪ፥ ዎይ አይፊ ሳክያ አሳይ፥ ዎይ ፑሱ ኦይቄዳ አሳይ፥ ዎይ እላሁ ኦይቄዳ አሳይ፥ ዎይ ጎይሮ ግድናካ ቦላይ ትላ ግደና አሳይ፥ ኦንነ ሺቆፖ። <verse eid="LEV 21:20"/><verse number="21" style="v" sid="LEV 21:21"/>ቄስያ አሮና ዛርያፐ ቦላይ ትላ ግደና አሳይ ኦንነ መና ጎዳዉ ታማን ጹግያ ያርሹዋ ሺሻናዉ ሺቆፖ። አዉ ቦላይ ትላ ግደናዋ ግዶዋፐ ህን ባጋን፥ ባረ ጾሳዉ ቁማ ያርሹዋ ሺሻናዉ እ በሰና። <verse eid="LEV 21:21"/><verse number="22" style="v" sid="LEV 21:22"/>እ ጌሻ ቁማነ ቃይ ጌሻ ኡባፐ እቱዋ ግዴዳ ጌሻ ያርሹዋ ባረ ጾሳ ቁማካ ማናዉ ዳንዳዬ። <verse eid="LEV 21:22"/><verse number="23" style="v" sid="LEV 21:23"/>ሽን አዉ ቦላይ ትላ ግደና ድራዉ፥ እ ታ ዱንካንያ ቱንሰናዳን፥ ጋርዱዋኮ ዎይ ያርሽያ ሳኣኮ ሺቆፖ። አያዉ ጎፐ፥ ኡንቱንታ ጌሽያዌ ታን መና ጎዳ ያጋ’ ” ያጌዳ።<verse eid="LEV 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 21:24"/>ሙሴ አሮናዉ፥ አ አቱማ ናናዉነ እስራኤልያ አሳዉ ኡባዉ ሀዋ ኦዴዳ።<verse eid="LEV 21:24"/></para>
  <chapter eid="LEV 21"/>
  <chapter number="22" style="c" sid="LEV 22"/>
  <para style="s1">እሞታ ጌሻተ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 22:1"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="LEV 22:1"/><verse number="2" style="v" sid="LEV 22:2"/>“ታ ጌሻ ሱን ኡንቱንቱ ቱንሰና ማላ፥ እስራኤልያ አሳይ ታዉ ዱማዬዳ እሞታ አሮንነ አ አቱማ ናናይ ቦንቹዋን አኪደ፥ ጌሻተን ናጋና ማላ፥ ኡንቱንቶ ኦዳ። ታን መና ጎዳ።<verse eid="LEV 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 22:3"/>“ኡንቱንቶ ሀዋዳን ያጋ፤ ‘ስንና ይያ የለታ ኡባን ህንተ ዛርያፐ ኦንነ ቱን ኡቲደ፥ እስራኤልያ አሳይ መና ጎዳዉ ዱማዬዳ ጌሻ ያርሹዋኮ ሺቆፐ፥ ሄ አሳይ ታ ስንፐ ቦሄቶ። ታን መና ጎዳ።<verse eid="LEV 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 22:4"/>“ ‘አሮና ዛርያፐ ዎልቃማ ጋልባ ሀርጊ ደእያ፥ ዎይ ቦላፐ አያይኔካ ጎግያ ኦንነ ጌያና ጋካናዉ፥ ጌሻ ያርሹዋፐ ሞፖ። አሃ ቦቺደ ቱኔዳዋ ዎይ አ አቱማተፐ ዘረይ ጉኬዳ ኡራ ቦችያ ኦንነ ቱና። <verse eid="LEV 22:4"/><verse number="5" style="v" sid="LEV 22:5"/>ዎይ ቃይ ሳኣና ጎሸትያ፥ ቱንስያዋንታ፥ ዎይ አይ ማላ ቱናተ ግዶፐነ ቱንስያ አሳ ቦችያ ኡራይ፥ <verse eid="LEV 22:5"/><verse number="6" style="v" sid="LEV 22:6"/>ዎይ ሄዋ ማላባ አያነ ቦችያ አሳይ፥ ኦማርስ ጋካናዉ እ ቱና፤ ባረ ቦላ ሃን ሜጨተናን ደኢደ፥ ሄ ጌሻ ያርሹዋፐ እ ማናዉ ኮሸና። <verse eid="LEV 22:6"/><verse number="7" style="v" sid="LEV 22:7"/>አዋይ ዉልያ ዎደ እ ጌሻ ግዴ፤ ሄዋፐ ጉይያን፥ ሄ ጌሻ ያርሹዋፐ ባረና ጋክያዋ ሞ ጋሱካ ሄዌ አ ቁማ። <verse eid="LEV 22:7"/><verse number="8" style="v" sid="LEV 22:8"/>ባረዉ ሀይቄዳዋ ዎይ ዶአይ ዎዳ መህያ አሹዋ ሞፖ፤ ሄዌ ቱንስያባ። ታን መና ጎዳ።<verse eid="LEV 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 22:9"/>“ ‘ቄሳቱ ታ ዎጋ፤ ናገናን እጾፐ፥ ኡንቱንቱ አ ቱንሲደ አ ናጋራን ሀይቃና። ኡንቱንታ ጌሽያዌ ታና መና ጎዳ።<verse eid="LEV 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 22:10"/>“ ‘ሄ ጌሻ ያርሹዋ ቄስያ ሶ አሳፐ አትና፥ ሀራ አሳይ ሞፖ፤ ቄስያ ሶ ዬዳ እማ ግድና፥ ዎይ ቃጻረቲደ ኦያ ቆማ ግድናካ ሞፖ። <verse eid="LEV 22:10"/><verse number="11" style="v" sid="LEV 22:11"/>ሽን ቄሲ ባረ ብራን ሻሜዳ አይልያ ዎይ አ ሶን የለቴዳ አይሊ ሄ ቁማፐ ሞ። <verse eid="LEV 22:11"/><verse number="12" style="v" sid="LEV 22:12"/>ቄስያ ግደና ሀራ አሳ ገሌዳ ቄስያ ናታ ሄ ጌሻ ያርሹዋፐ ሙፑ። <verse eid="LEV 22:12"/><verse number="13" style="v" sid="LEV 22:13"/>ሽን ቄስያ ናታ አስናይ ሀይቂና፥ ዎይ አስናይ የድና፥ ናኣ የለናን ካሰ ባረ ዎዶሮተን ደእያዋዳን ስማደ ባረ አዉዋ ጎለ ዮፐ፥ አ ባረ አዉዋ ጋክያ ቁማፐ ሙ። ሽን ሀራ አሳይ ኦንነ ሄዋፐ ሞፖ።<verse eid="LEV 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 22:14"/>“ ‘እት አሳይ ኤረናን ደኢደ ጌሻ ያርሹዋፐ ሞፐ፥ ሄ እ ሜዳ ቁማ ጋትያ ቦላ ጼቱዋፐ ላታሙ ኩሽያ ጉጂደ ቄስያዉ እሞ። <verse eid="LEV 22:14"/><verse number="15" style="v" sid="LEV 22:15"/>እስራኤልያ አሳይ መና ጎዳዉ ያርሽያ ጌሻ ያርሹዋ ቄሳቱ ቱንሶፕኖ። <verse eid="LEV 22:15"/><verse number="16" style="v" sid="LEV 22:16"/>ኡንቱንቱ ባረንቱ አሄዳ ጌሻ ያርሹዋ ባረዉ ሚደ፥ ባረንቱ ናጋራን ኦሸታናዳን፥ ቄሳቱ ኦናዉ ኮሸና። አያዉ ጎፐ፥ ኡንቱንታ ጌሽያዌ፥ ታን መና ጎዳ ያጋ’ ” ያጌዳ።<verse eid="LEV 22:16"/></para>
  <para style="s1">አከተና ያርሾቱዋ</para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 22:17"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፥ <verse eid="LEV 22:17"/><verse number="18" style="v" sid="LEV 22:18"/>“አሮናዉ፥ አ ናናቶነ እስራኤልያ አሳ ኡባዉ ሀዋዳን ያጋደ ኦዳ፤ ‘እስራኤልያ አሳፐ ግድና ዎይ ኡንቱንቱ ግዶን ደእያ በትያፐ ኦንነ መና ጎዳዉ ጹግያ ያርሹዋ ባረ ዶሱዋን ጮ እምያ ዎይ ባረ ሺቆዋ ጋናዉ ያርሽያ ዎደ፥ <verse eid="LEV 22:18"/><verse number="19" style="v" sid="LEV 22:19"/>ሄ ያርሹ አከታና ማላ፥ ኮሩማፐ ዎይ ዶርሳፐ ዎይ ዴሻፐ ትላ ቦላና ደእያ አቱማዋ ግዶ። <verse eid="LEV 22:19"/><verse number="20" style="v" sid="LEV 22:20"/>ቦላይ ትላ ግደናዌ አያ ግዶፐነ አከተና ድራዉ፥ ሄዋ ሺሾፓ።<note caller="-" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="DEU 17:1">ዛረ. 17:1</ref></char></note><verse eid="LEV 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 22:21"/>“ ‘ቃይ ኦና ግዶፐነ ባረ ሺቆዋ ጋናዉ እትፐተ ያርሹዋ ጾሳዉ ያርሽያ ዎደ፥ ዎይ ባረ መህያፐ ባረ ዶሱዋን ጮ እምያ እሞታ መና ጎዳዉ ሺሽያ ዎደ፥ ሄዌ አከታና ማላ እ ትላ ቦላና ደእያዋ ግዶ። <verse eid="LEV 22:21"/><verse number="22" style="v" sid="LEV 22:22"/>ህንተ መህያፐ ቆቅያ፥ ዎይ መኡዋ፥ ዎይ ጉንዳ፥ ዎይ ጊይያ ማይይ፥ ዎይ ፑሱ፥ ዎይ እላሁ ደእያዋ መና ጎዳዉ ያርሾፕተ፤ ቃይ ታማን ጹግያ ያርሹዋ ኦደካ ያርሽያ ሳኣ ቦላን መና ጎዳዉ ሺሾፕተ። <verse eid="LEV 22:22"/><verse number="23" style="v" sid="LEV 22:23"/>አ ቦላን ፓጫ መታይ ዎይ ፓጫባይ ደእያ ኮሩማ ዎይ ዶርሳ እት አሳይ ባረ ዶሱዋን ጮ እምያ ያርሾ ሺሻናዉ ዳንዳዬ፤ ሽን ሺቁ ጋ ግዶፐ፥ ሄዌ አከተና። <verse eid="LEV 22:23"/><verse number="24" style="v" sid="LEV 22:24"/>ሳንግሰቴዳዋ ዎይ ቆጸቴዳዋ ዎይ ካይ ማይቴዳዋ ዎይ ቃንጸቴዳዋ መና ጎዳዉ ያርሾፕተ። ህንተ ጋድያን ሄዋ ማላባ ኦፕተ። <verse eid="LEV 22:24"/><verse number="25" style="v" sid="LEV 22:25"/>ህንተ ግዶን ደእያ አላጋ አሳቱዋፐ አኬዳ ሄዋ ማላ መህያካ ህንተ ጾሳዉ ቁማ ኦደ ሺሾፕተ። ኡንቱንቱ ቦላይ ትላ ግደናዋ ጋሱዋን ኡንቱንቱን ፖኩ ደእያ ድራዉ፥ ኡንቱንቱ ህንተ ድራዉ አከትክኖ’ ያጋ” ያጌዳ።<verse eid="LEV 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 22:26"/>ቃይካ መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፥ <verse eid="LEV 22:26"/><verse number="27" style="v" sid="LEV 22:27"/>“ሚዛ ማራይ ዎይ ዶርሳ ማራይ ዎይ ዴሻ ማራይ የለትያ ዎደ፥ ላፑን ጋላሳ ባረ ዳይና ጋምኦ። ሆስፑን ጋላሳፐ ዶሚደ፥ መና ጎዳዉ ታማን ጹጊደ ሺሽያ ያርሾ ኦደ ሺሻናዉ ዳንዳየቴ። <verse eid="LEV 22:27"/><verse number="28" style="v" sid="LEV 22:28"/>ምያቶ፥ ዶርሳቶ፥ ዎይ ዴሻቶ እ ማራና እት ጋላስ ሹኮፕተ።<verse eid="LEV 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 22:29"/>“ህንተ ጋላታ ያርሹዋ መና ጎዳዉ ሺሽያ ዎደ፥ ህንተ ያርሹ አከታናዳን ያርሽተ። <verse eid="LEV 22:29"/><verse number="30" style="v" sid="LEV 22:30"/>ሄ ያርሹ ሄ ጋላስካ ሜተታናዉ ኮሼ፤ አፐ አያነ ዎንትዉ አሾፕተ። ታን መና ጎዳ።<verse eid="LEV 22:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 22:31"/>“ታ አዛዙዋ ናግተነ ኦተ። ታን መና ጎዳ። <verse eid="LEV 22:31"/><verse number="32" style="v" sid="LEV 22:32"/>ቃይ ታ ጌሻ ሱን ህንተ ቱንሶፕተ፤ እስራኤልያ አሳ ግዶን ታን ጌሻ ግድያዌ ኤረታናዉ በሴ። ህንተና ጌሽያዌ፥ ታን መና ጎዳ። <verse eid="LEV 22:32"/><verse number="33" style="v" sid="LEV 22:33"/>ህንተዉ ጾሳ ግዳናዉ፥ ህንተና ግብጼ ጋድያፐ ከሴዳዌ ታና። ታን መና ጎዳ” ያጌዳ።<verse eid="LEV 22:33"/></para>
  <chapter eid="LEV 22"/>
  <chapter number="23" style="c" sid="LEV 23"/>
  <para style="s1">አማኑዋ ባላ ቦንችያ ማራ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 23:1"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="LEV 23:1"/><verse number="2" style="v" sid="LEV 23:2"/>“እስራኤልያ አሳዉ ሀዋዳን ያጋደ ኦዳ፤ ‘ጌሻ ሺቁዋ ግ አዋዪደ፥ ህንተ ቦንቻናዉ በስያ ኬረቴዳ መና ጎዳ ባላቱ ሀዋንታ።<verse eid="LEV 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 23:3"/>“ ‘ህንተ ኡሱፑን ጋላሳ ኦሱዋ ኦታ፤ ሽን ላፑን ጋላስ ህንተ ሸምፕያ ሳምባታ ጋላሳ፤ ሄ ጋላሳን ጌሻ ሺቁዋ ሺቅተ፤ አያ ኦሶነ ኦፕተ፤ ህንተ ደእያ ሳኣን ኡባን ሄዌ መና ጎዳዉ ሳምባታ።<note caller="-" style="x"><char style="xo" closed="false">23:3 </char><char style="xt" closed="false"><ref loc="EXO 20:8-10">ከሳ 20:8-10</ref>፤ <ref loc="EXO 23:12">23:12</ref>፤ <ref loc="EXO 31:15">31:15</ref>፤ <ref loc="EXO 34:21">34:21</ref>፤ <ref loc="EXO 35:2">35:2</ref>፤ <ref loc="DEU 5:12-14">ዛረ. 5:12-14</ref></char></note><verse eid="LEV 23:3"/></para>
  <para style="s1">ፓስጋ ባላነ ማጋገ ኡክ ባላ</para>
  <para style="r">(<ref loc="NUM 28:16-25">ፓይ. 28:16-25</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 23:4"/>“ ‘ኡንቱንቱ ዎድያን ዎድያን ጌሻ ሺቁዋ ኦ አዋዪደ ህንተ ቦንቻናዉ በስያ መና ጎዳ ባላቱ ሀዋንታ። <verse eid="LEV 23:4"/><verse number="5" style="v" sid="LEV 23:5"/>ኮይሮ አግናን ታማነ ኦይደን ጋላስ ሳአይ ኦማርስያ ዎደ፥ መና ጎዳ ፓስጋይ ዶሜ።<note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="EXO 12:1-13">ከሳ 12:1-13</ref>፤ <ref loc="DEU 16:1-2">ዛረ. 16:1-2</ref></char></note><verse eid="LEV 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 23:6"/>“ ‘ቃይ ሄ አግናንካ ታማነ እቼሸን ጋላሳይ መና ጎዳ ማጋገ ኡክ ባላ ጋላሳ፤ ሄዋ ድራዉ ላፑን ጋላሳቱዋን እርሹ ገልቤና ኡክ ሚተ።<note caller="-" style="x"><char style="xo" closed="false">23:6-8 </char><char style="xt" closed="false"><ref loc="EXO 12:14-20">ከሳ 12:14-20</ref>፤ <ref loc="EXO 23:15">23:15</ref>፤ <ref loc="EXO 34:18">34:18</ref>፤ <ref loc="DEU 16:3-8">ዛረ. 16:3-8</ref></char></note> <verse eid="LEV 23:6"/><verse number="7" style="v" sid="LEV 23:7"/>ሄ ጋላሳቱዋፐ ኮይሮ ጋላሳን ጌሻ ሺቁዋ ሺቅተ፤ ዳቡርስያ ኦሱዋ አያነ ኦፕተ። <verse eid="LEV 23:7"/><verse number="8" style="v" sid="LEV 23:8"/>ላፑን ጋላሳ ኡባ መና ጎዳዉ ታማን ጹግያ ያርሹዋ ሺሽተ፤ ላፑን ጋላሳን ቃይ ጌሻ ሺቁዋ ሺቅተ፤ ዳቡርስያ ኦሱዋ አያነ ኦፕተ’ ያጋ” ያጌዳ።<verse eid="LEV 23:8"/></para>
  <para style="s1">ባይራ ካ</para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 23:9"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="LEV 23:9"/><verse number="10" style="v" sid="LEV 23:10"/>“እስራኤልያ አሳዉ ሀዋዳን ያጋደ ኦዳ፤ ‘ታን ህንተንቶ እምያ ቢታ ገሊደ፥ ህንተ ካ ጫክያ ዎደ፥ ሄ ካዉ ኮይሮ አይፍያ ምርቂያ ቄስያኮ አክ ዪተ። <verse eid="LEV 23:10"/><verse number="11" style="v" sid="LEV 23:11"/>መና ጎዳይ ህንተዋ አካና ማላ፥ ሳምባታ ዎንተ ጋላስ ቄሲ ሄ ምርቂያ ጾሳ ስንን ቃ። <verse eid="LEV 23:11"/><verse number="12" style="v" sid="LEV 23:12"/>ሄ ህንተ ምርቂያ ቃዳ ጋላስ ትላ ቦላና ደእያ እት ላይ ዶርሳ ኦርግያ ጹግያ ያርሹዋ ኦደ መና ጎዳዉ ሺሽተ። <verse eid="LEV 23:12"/><verse number="13" style="v" sid="LEV 23:13"/>ሄ ያርሹዋና እትፐ ዎጋራ ዛይትያን ሙናቀቴዳ ላኡ ኪሎ ግራመ ሎኦ ልያ ካ ያርሹዋ ኦደ ሺሽተ፤ ሄዌ መና ጎዳዉ ታማን ጹግያ፥ ሳዉዋ ቶሹኩ ግያ ያርሹዋ ግዳናዋ፤ ሄዋናካ ቃይ እትፐ እት ሊትሮ ግድያ ዎይንያ ኤሳ ሺሽተ። <verse eid="LEV 23:13"/><verse number="14" style="v" sid="LEV 23:14"/>ሀ ያርሹዋ ህንተ ህንተ ጾሳዉ ሺሽያ ጋላሳይ ጋካናዉ፥ ኦራ ጋኬዳ ካፐ ኡክ፥ ዎይ ጺጻ ግድና፥ ቃይያ ግድናካ ሞፕተ። ሀዌ ህንተ ደእያ ሳኣን ኡባን ስንና ይያ የለታዉ ኡባዉ መናዉ ዎጋ።<verse eid="LEV 23:14"/></para>
  <para style="s1">ሳምንታቱዋ ባላ</para>
  <para style="r">(<ref loc="NUM 28:26-31">ፓይ. 28:26-31</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 23:15"/>“ ‘ህንተ ቃያ ያርሹዋ ምርቂያ አሄዳ ሳምባታ ዎንተፐ ዶሚደ፥ ላፑን ሳምንታ ኩመን ፓይድተ።<note caller="-" style="x"><char style="xo" closed="false">23:15-21 </char><char style="xt" closed="false"><ref loc="EXO 23:16">ከሳ 23:16</ref>፤ <ref loc="EXO 34:22">34:22</ref>፤ <ref loc="DEU 16:9-12">ዛረ. 16:9-12</ref></char></note> <verse eid="LEV 23:15"/><verse number="16" style="v" sid="LEV 23:16"/>ላፑን ሳምባታ ዎንተ ጋላሳይ ጋካናዉ፥ እሻታሙ ጋላሳ ፓይዲደ፥ ኦራ ጋኬዳ ካ ያርሹዋ መና ጎዳዉ ሺሽተ። <verse eid="LEV 23:16"/><verse number="17" style="v" sid="LEV 23:17"/>ህንተ አቅያ ሳኣፐ ላኡ ኪሎ ግራመ ግድያ ሎኦ ልያፐ እርሹዋ የጊደ ኡኬዳ ላኡ ኡክ ቃናዉ አክ ዪተ። ሄዌ ኮይሮ ጋኬዳ ካ አይፍያፐ መና ጎዳዉ ያርሹዋ ግዴ። <verse eid="LEV 23:17"/><verse number="18" style="v" sid="LEV 23:18"/>ሄ ኡክና እትፐ ትላ ቦላና ደእያ እት ላይ ግዴዳ ላፑን ዶርሳ ማራቱዋ፥ እት ኮሩማነ ላኡ ዶርሳ ኦርገቱዋ ሺሽተ። ካ ያርሹዋናነ ኡሻ ያርሹዋና እትፐ መና ጎዳዉ ታማን ጹግያ፥ ሳዉዋ ቶሹኩ ግያ ያርሹዋ ኦደ ያርሽተ። <verse eid="LEV 23:18"/><verse number="19" style="v" sid="LEV 23:19"/>ቃይ እት ዴሻ ኦርግያ ናጋራ ያርሾ፥ እት ላይ ግዴዳ ላኡ ዶርሳ ኦርገቱዋካ እትፐተ ያርሾ ሺሽተ።<verse eid="LEV 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 23:20"/>“ ‘ቄሲ ሄ ኮይሮ ጋኬዳ ካ አይፍያ ኡክነ ሄ ላኡ ዶርሳቱዋ ቃያ ያርሹዋ ኦደ፥ መና ጎዳ ስንን ቃ፤ ሄዋንቱ መና ጎዳዉ ጌሻ፤ ቃይ ቄስያዉካ ግሹዋ። <verse eid="LEV 23:20"/><verse number="21" style="v" sid="LEV 23:21"/>ሄ ጋላስካ አዋዪደ ጌሻ ሺቁዋ ሺቅተ፤ ዳቡርስያ ኦሶ አያነ ኦፕተ። ሀዌ ህንተ ደእያ ሳን ኡባን ስንና ይያ የለታዉ ኡባዉ መናዉ ዎጋ።<verse eid="LEV 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 23:22"/>“ ‘ህንተ ጋድያን ሞኬዳ ካ ህንተ ጫክያ ዎደ፥ ህንተ ሾይቃ ጋጻ ጋካናዉ ጫኮፕተ፤ ጫክሽን አትያ ቃርምያካ ቆሮፕተ፤ ሄዋ ህዬሳቶነ በተቶ አግ ባሽተ። ታን፥ መና ጎዳይ፥ ህንተ ጾሳ’ ያጋ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">23:22 </char><char style="xt" closed="false"><ref loc="LEV 19:9-10">ዎጋ 19:9-10</ref>፤ <ref loc="DEU 24:19-22">ዛረ. 24:19-22</ref></char></note><verse eid="LEV 23:22"/></para>
  <para style="s1">ማላካታ ፑንያ ባላ</para>
  <para style="r">(<ref loc="NUM 29:1-6">ፓይ. 29:1-6</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 23:23"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፥ <verse eid="LEV 23:23"/><verse number="24" style="v" sid="LEV 23:24"/>“እስራኤልያ አሳዉ ሀዋዳን ያጋደ ኦዳ፤ ‘ላፑን አግናን ኮይሮ ጋላሳ ሸምፖ ጋላሳ ኦደ ቦንችተ፤ ሀሳይሱዋ ማላካታይካ ፑነትያ ዎደ፥ ጌሻ ሺቁዋ ሺቅተ። <verse eid="LEV 23:24"/><verse number="25" style="v" sid="LEV 23:25"/>ሄ ጋላሳን መና ጎዳዉ ታማን ጹግያ ያርሹዋ ሺሽተፐ አትና፥ ዳቡርስያ ኦሱዋ አያነ ኦፕተ’ ያጋ” ያጌዳ።<verse eid="LEV 23:25"/></para>
  <para style="s1">ናጋራ አቶ ጊስያ ጋላሳ</para>
  <para style="r">(<ref loc="NUM 29:7-11">ፓይ. 29:7-11</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 23:26"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፥<note caller="-" style="x"><char style="xo" closed="false">23:26-32 </char><char style="xt" closed="false"><ref loc="LEV 16:29-34">ዎጋ 16:29-34</ref></char></note> <verse eid="LEV 23:26"/><verse number="27" style="v" sid="LEV 23:27"/>“ሀ ላፑን አግናዉ ታማን ጋላሳይ ናጋራ አቶ ጊስያ ጋላሳ፤ ሄ ጋላስ ጌሻ ሺቁዋ ሺቅተ፤ ቃይ ህንተ ሁጲያ ካዉሽተ፤ ያቲደ መና ጎዳዉ ታማን ጹግያ ያርሹዋ ሺሽተ። <verse eid="LEV 23:27"/><verse number="28" style="v" sid="LEV 23:28"/>ሄ ጋላሳይ መና ጎዳ ህንተ ጾሳ ስንን ህንተ ናጋራይ አቶ ጌተታና ማላ፥ ህንተ ናጋራ አቶ ጊስያ ጋላሳ ግድያ ድራዉ፥ ሄ ጋላስ አይ ኦሱዋነ ኦፕተ። <verse eid="LEV 23:28"/><verse number="29" style="v" sid="LEV 23:29"/>ሄ ጋላስ ባረናተ ካዉሸና አሳይ ኦንነ ባረ አሳ ግዶፐ ቦሄቶ። <verse eid="LEV 23:29"/><verse number="30" style="v" sid="LEV 23:30"/>ሄ ጋላስ አያ ኦሱዋ ግዶፐነ ኦያ አሳ ታን አ አሳ ግዶፐ ይሳና። <verse eid="LEV 23:30"/><verse number="31" style="v" sid="LEV 23:31"/>ሄ ጋላስ አይ ኦሱዋነ ኦፕተ። ሀዌ ህንተ ደእያ ሳን ኡባን ስንና ይያ የለታዉ ኡባዉ መናዉ ዎጋ። <verse eid="LEV 23:31"/><verse number="32" style="v" sid="LEV 23:32"/>ሄዌ ህንተ ዋና ሸምፑዋ ሸምፕያ ሳምባታ ጋላሳ። ሄ ጋላሳን ህንተ ሁጲያ ካዉሽተ። ሄ አግናን ኡዱፑን ጋላሳን ኦማርሳፐ ዶሚደ፥ ታማን ጋላሳ ኦማርሳይ ጋካናዉ፥ ህንተ ሳምባታ ቦንችተ” ያጌዳ።<verse eid="LEV 23:32"/></para>
  <para style="s1">ዳስያ ባላ</para>
  <para style="r">(<ref loc="NUM 29:12-40">ፓይ. 29:12-40</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 23:33"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፥<note caller="-" style="x"><char style="xo" closed="false">23:33-36 </char><char style="xt" closed="false"><ref loc="DEU 16:13-15">ዛረ. 16:13-15</ref></char></note> <verse eid="LEV 23:33"/><verse number="34" style="v" sid="LEV 23:34"/>“እስራኤልያ አሳዉ ሀዋዳን ያጋደ ኦዳ፤ ‘ሀ ላፑን አግናን ታማነ እቼሸን ጋላሳፐ ዶሚደ፥ ላፑን ጋላሳይ መና ጎዳዉ ዳስያ ባላ። <verse eid="LEV 23:34"/><verse number="35" style="v" sid="LEV 23:35"/>ሄ ጋላሳቱዋፐ ኮይሮ ጋላሳን ጌሻ ሺቁዋ ሺቅተ፤ ዳቡርስያ ኦሱዋ አያነ ኦፕተ። <verse eid="LEV 23:35"/><verse number="36" style="v" sid="LEV 23:36"/>ላፑን ጋላሳን ኡባን መና ጎዳዉ ታማን ጹግያ ያርሹዋ ሺሽተ፤ ሆስፑን ጋላሳን ቃይ ጌሻ ሺቁዋ ሺቅተ፤ መና ጎዳዉ ታማን ያርሽያ ያርሹዋካ ሺሽተ። ሄ ጋላሳይ ህንተ ሺቁዋ ፖልያ ጋላሳ ግድያ ድራዉ፥ ዳቡርስያ ኦሱዋ አያነ ኦፕተ።<verse eid="LEV 23:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 23:37"/>“ ‘ታማን ጹግያ ያርሹዋነ ካ ያርሹዋ፥ ቃይ ሀራ ያርሾቱዋ ኡባነ ኡሻ ያርሹዋ፥ ኮሽያዋ ኬና ኬሬዳ ጋላሳን መና ጎዳዉ ሺሻናዉ፥ ህንተ ጌሻ ሺቁዋ ኦደ አዋያና መና ጎዳ ባላቱ ሀዋንታ። <verse eid="LEV 23:37"/><verse number="38" style="v" sid="LEV 23:38"/>ሀ ባላቱ መና ጎዳ ሳምባታቱዋፐ፥ ህንተ እሞታ ኦደ መና ጎዳዉ እምያዋንቱፐ፥ ሺቁዋ ጋያዋንቱፐነ ህንተ ህንተ ዶሱዋን ጮ እምያዉንቱፐ ዱማ።<verse eid="LEV 23:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 23:39"/>“ ‘ላፑን አግናን ታማነ እቼሸን ጋላሳን ህንተ ጋድያን ሞኬዳዋ ጫኪደ ሺሼዳዋፐ ጉይያን፥ መና ጎዳ ባላ ላፑን ጋላሳ ቦንችተ፤ ኮይሮ ጋላሳይነ ሆስፑን ጋላሳይ ህንተንቶ ዋና ሸምፖ ጋላሳ። <verse eid="LEV 23:39"/><verse number="40" style="v" sid="LEV 23:40"/>ኮይሮ ጋላሳን ሎኦ ም አይፍያፐ፥ ዛምባ ታሽያፐ፥ እርጻ ሀይና ደእያ ም ታሽያፐነ ሻፋ ማታን ድጭያ ሌኦ ታሽያፐ አኪደ፥ መና ጎዳ ህንተ ጾሳ ስንን ናሸቲደ፥ ላፑን ጋላሳ ባላ ቦንችተ። <verse eid="LEV 23:40"/><verse number="41" style="v" sid="LEV 23:41"/>ሄ ባላ ላይን ላይን ላፑን ጋላሳ መና ጎዳዉ ቦንችተ። ሄዌ ስንና ይያ የለታዉ ኡባዉ መናዉ ዎጋ። ህንተ ሄዋ ላፑን አግናን ቦንችተ። <verse eid="LEV 23:41"/><verse number="42" style="v" sid="LEV 23:42"/>ሄ ላፑን ጋላሳ ህንተ ዳስያን ደእተ፤ እስራኤልያ ቢታ አሳ ግድያ ኡባይ ዳስያን ደእተ። <verse eid="LEV 23:42"/><verse number="43" style="v" sid="LEV 23:43"/>ሄዌ ስንና ይያ የለታይ ኡባይ እስራኤልያ አሳ ታን ግብጼፐ ከሴዳ ዎደ፥ ኡንቱንቱ ዳስያን ደአናዳን ኦዳዋ ኤራናሳ። ታን መና ጎዳ ህንተ ጾሳ’ ያጋ” ያጌዳ።<verse eid="LEV 23:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LEV 23:44"/>ሄዋዳን ኦደ፥ ሙሴ መና ጎዳ ባላቱዋ ቦንችያ ዎጋ እስራኤልያ አሳዉ ኦዴዳ።<verse eid="LEV 23:44"/></para>
  <chapter eid="LEV 23"/>
  <chapter number="24" style="c" sid="LEV 24"/>
  <para style="s1">ጾምፐቱዋ ናጉዋ</para>
  <para style="r">(<ref loc="EXO 27:20-21">ከሳ 27:20-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 24:1"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፥ <verse eid="LEV 24:1"/><verse number="2" style="v" sid="LEV 24:2"/>“ጾምፒ ቶኤናን ኤጺደ ደአና ማላ፥ አሳይ ኮሽያ ዛይትያ ዎጋራ ቴራ ጫዲደ ጉምእና ከስያ ጌሻ ነዉ አሀና ማላ፥ እስራኤላቱዋ አዛዛ። <verse eid="LEV 24:2"/><verse number="3" style="v" sid="LEV 24:3"/>መና ጎዳ ዱንካንያ ግዶን ደእያ ማርካተ ጋርዱዋፐ ካረ ባጋና፥ ኦማርሳፐ ዎንታ ጋካናዉ፥ አሮን መና ጎዳ ስንን ሄ ጾምፕያ ኡባ ዎደ ኤ። ስንና ይያ የለታዉ ኡባዉ ሄዌ መናዉ ዎጋ። <verse eid="LEV 24:3"/><verse number="4" style="v" sid="LEV 24:4"/>ጾምፕያ ዎያ፥ ዋላካይ ባይና ዎርቃ ባላ ቦላ ደእያ ጾምፐቱ መና ጎዳ ስንን ኡባ ዎደ ኤጻናዳን አሮን ናጎ።<verse eid="LEV 24:4"/></para>
  <para style="s1">ጾሳዉ ሺሽያ ኡክ</para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 24:5"/>“ላታማነ ኦይዱ ኪሎ ግራመ ግድያ ሊቆ ልያ አካደ ታማነ ላኡ ኡክ ኡካ።<note caller="-" style="x"><char style="xo" closed="false">24:5 </char><char style="xt" closed="false"><ref loc="EXO 25:30">ከሳ 25:30</ref></char></note> <verse eid="LEV 24:5"/><verse number="6" style="v" sid="LEV 24:6"/>ሄ ኡክቱዋ ኡሱፑናቱዋ እቱዋ እቱዋ ቦላ ኡሱፑናቱዋ እቱዋ እቱዋ ቦላን መና ጎዳ ስንን ደእያ ዋላካይ ባይና ዎርቃ ጻራጴዛ ቦላን ዎ። <verse eid="LEV 24:6"/><verse number="7" style="v" sid="LEV 24:7"/>መና ጎዳዉ ታማን ጹጋናዉ ሺሼዳ ቁማ ያርሹዋ ግድያዋ ኤርሳናዉ፥ ላኡ ማራቱዋ ማታን ማታን ጌሻ እጻና ሀሳይስያዋ ኦደ ዎ። <verse eid="LEV 24:7"/><verse number="8" style="v" sid="LEV 24:8"/>ሀ ኡክ ሳምባታን ሳምባታን ኡባ ዎደ አሮን መና ጎዳ ስንን እስራኤልያ አሳ ድራዉ ዎ። ሄዌ እስራኤልያ አሳይ ኡባ ዎደ ኦናዉ ኮሽያ ቃላ ጫቁዋ። <verse eid="LEV 24:8"/><verse number="9" style="v" sid="LEV 24:9"/>ሄዌ አሮናዉነ አ አቱማ ናናቶ እመቶ፤ እ መና ጎዳዉ ታማን ጹግያ ያርሹዋፐ ዎጋዳን አሮናነ አ ናናቱዋ ጋክያ ኡባፐ ጌሻ ግዴዳ ያርሹዋፐ እቱዋ ግድያ ጌሻ ያርሹዋ ግድያ ድራዉ፥ ኡንቱንቱ ሄዋ ጌሻ ሳኣን ሚኖ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">24:9 </char><char style="xt" closed="false"><ref loc="MAT 12:4">ማቶሳ 12:4</ref>፤ <ref loc="MRK 2:26">ማር. 2:26</ref>፤ <ref loc="LUK 6:4">ሉቃሳ 6:4</ref></char></note><verse eid="LEV 24:9"/></para>
  <para style="s1">ልከነ ሱረ ፕርዳ ሌምሱዋ</para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 24:10"/>አታ እስራኤልያ አሳ፥ አዉ ቃይ ግብጼ አሳ ግድያ እት ብታኒ ደኤ። እት ጋላስ እ ሀራ እስራኤልያ አሳ ግድያ እቱዋና ዱንካኔዳ ሳኣን ዋቴዳ። <verse eid="LEV 24:10"/><verse number="11" style="v" sid="LEV 24:11"/>ሀ አዉ አታ እስራኤልያ አሳ ግዴዳ ብታኒ ዋታ ግዶን ጾሳ ሱን ሸቄዳ። ያትና አ ሙሴኮ አሄድኖ። ሄ ብታንያ አታ ዳና ያራ ግድያ ጺብራ ናቶ። እ ሱንይካ ሻሎሚቶ። <verse eid="LEV 24:11"/><verse number="12" style="v" sid="LEV 24:12"/>ሀ ብታንያ ዋታነንቶ መና ጎዳ ሸኒ ኡንቱንቶ ቆንጫና ጋካናዉ፥ ኡንቱንቱ አ ቃሾ ጎልያን ዎድኖ።<verse eid="LEV 24:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 24:13"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፥ <verse eid="LEV 24:13"/><verse number="14" style="v" sid="LEV 24:14"/>“ሄ ሸቀዳ ብታንያ ዱንካኔዳ ሳኣፐ ጋጻ ከሳ፤ እ ሸቅሽን ስሴዳ አሳይ ኡባይ ባረንቱ ኩሽያ አ ሁጲያ ቦላን ዎኖ፤ ያቶፐ እስራኤልያ አሳ ማባራይ ኡባይ አ ሹቻን ጫዲደ ዎ። <verse eid="LEV 24:14"/><verse number="15" style="v" sid="LEV 24:15"/>እስራኤልያ አሳዉ ሀዋዳን ያጋደ ኦዳ፤ አይ አሳይነ ባረ ጾሳ ሸቆፐ፥ እ ባረ ናጋራን ኦሸቴ። <verse eid="LEV 24:15"/><verse number="16" style="v" sid="LEV 24:16"/>መና ጎዳ ሱን ሸቂያ አሳይ ሀይቆ፤ እስራኤልያ አሳ ማባራይ ኡባይ አ ሹቻን ጫዶ። በቲደ ዬዳዋ ግድና ዎይ ቢታ አሳ ግድናካ መና ጎዳ ሱን ሸቆፐ ሀይቆ።<verse eid="LEV 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 24:17"/>“ ‘አሳ ዎያ አሳይ ሀይቆ።<note caller="-" style="x"><char style="xo" closed="false">24:17 </char><char style="xt" closed="false"><ref loc="EXO 21:12">ከሳ 21:12</ref></char></note> <verse eid="LEV 24:17"/><verse number="18" style="v" sid="LEV 24:18"/>አሳ መህያ ዎያ አሳይ ኦንነ ባረ ዎዳ መህያ ድራዉ ፓጻ መህያ ጭጎ። <verse eid="LEV 24:18"/><verse number="19" style="v" sid="LEV 24:19"/>እት አሳይ ባረ ሾሩዋ ቆሆፐ፥ እ ኦዳዋዳን አ ቦላንካ ኦሰቶ። <verse eid="LEV 24:19"/><verse number="20" style="v" sid="LEV 24:20"/>መንፐ መኦ፤ አይፍያ ድራዉ አይፍያ፤ አቻ ድራዉ አቻ። አሳ ቦላን ቆሁዋ ጋዳ ኦንካ እ ጋዳ ቆሁዋ ማላይ አ ቦላንካ ጋኮ።<note caller="-" style="x"><char style="xo" closed="false">24:20 </char><char style="xt" closed="false"><ref loc="EXO 21:23-25">ከሳ 21:23-25</ref>፤ <ref loc="DEU 19:21">ዛረ. 19:21</ref>፤ <ref loc="MAT 5:38">ማቶሳ 5:38</ref></char></note> <verse eid="LEV 24:20"/><verse number="21" style="v" sid="LEV 24:21"/>መህያ ዎዳ አሳይ መህያ ጭጎ፤ ሽን አሳ ዎዳ አሳይ ሀይቆ። <verse eid="LEV 24:21"/><verse number="22" style="v" sid="LEV 24:22"/>በትያዉካ እስራኤልያ አሳዉ ህጊ እት ማላ ግዶ፤ አያዉ ጎፐ ታን መና ጎዳ ህንተ ጾሳ’ ያጋ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">24:22 </char><char style="xt" closed="false"><ref loc="NUM 15:16">ፓይ. 15:16</ref></char></note><verse eid="LEV 24:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 24:23"/>ሄዋ ኡባ ሙሴ እስራኤልያ አሳዉ ኡባዉ ኦዴዳ፤ ኡንቱንቱ ሄ ሸቀዳ ብታንያ ዱንካኔዳ ሳኣፐ ጋጻ ከሲደ፥ ሹቻን ጫዲደ ዎድኖ። ያቲደ እስራኤልያ አሳይ መና ጎዳይ ሙሳ አዛዜዳዋዳን ኦድኖ።<verse eid="LEV 24:23"/></para>
  <chapter eid="LEV 24"/>
  <chapter number="25" style="c" sid="LEV 25"/>
  <para style="s1">ሳምባታ ላይ</para>
  <para style="r">(<ref loc="DEU 15:1-11">ዛረ. 15:1-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 25:1"/>ሲና ደርያ ቦላን መና ጎዳይ ሙሴዉ ሀዋዳን ያጌዳ፤<note caller="-" style="x"><char style="xo" closed="false">25:1 </char><char style="xt" closed="false"><ref loc="EXO 23:10-11">ከሳ 23:10-11</ref></char></note> <verse eid="LEV 25:1"/><verse number="2" style="v" sid="LEV 25:2"/>“ኔን እስራኤልያ አሳዉ ሀዋዳን ያጋደ ኦዳ፤ ‘ታን ህንተንቶ እምያ ቢታ ህንተ ገልያ ዎደ፥ ቢታይካ መና ጎዳ ሳምባታ ቦንቾ። <verse eid="LEV 25:2"/><verse number="3" style="v" sid="LEV 25:3"/>ኡሱፑን ላይ ኩመን ህንተ ሾይቃን ዘርተ፤ ቃይ ኡሱፑን ላይ ኩመንካ ህንተ ዎይንያ ቱራ ጼራ ጹንቂተ፤ አ አይፍያካ ማጽ አክተ። <verse eid="LEV 25:3"/><verse number="4" style="v" sid="LEV 25:4"/>ሽን ላፑን ላይይ ቢታዉ ሸምፖ ሳምባታ፤ ሄዌ መና ጎዳዉካ ሳምባታ። ሄ ላፑን ላይን ህንተ ሾይቃን ዘሮፕተ፤ ህንተ ዎይንያ ጼራካ ጹንቆፕተ። <verse eid="LEV 25:4"/><verse number="5" style="v" sid="LEV 25:5"/>ህንተ ጋድያን አዛባ ግዲደ ሞክያዋካ ጫኮፕተ፤ ቃይ ጹንቀናን ደእሽን ጮ አይፌዳ ዎይንያካ ሺሾፕተ። ሄ ላይይ ቢታዉ ኡባና ሸምፖ ላይ ግዶ። <verse eid="LEV 25:5"/><verse number="6-7" style="v" sid="LEV 25:6-7"/>ሄ ሳምባታ ላይን ቢታይ ኦሰታና ዮፐ ህንተንቶ፥ ህንተ ማጫነ አቱማ ቆማቶ፥ ህንተንቶ ከራ ኦያዋንቶ፥ በቲደ ዪደ ህንተናና ደእያዋንቶ፥ ህንተ መህያዉነ ህንተ ጋድያን ደእያ ዶአቶ ግድያ ቁማ እማና፤ ቢታይ ሞክያባይ ኡባይ ሜተቶ።<verse eid="LEV 25:6-7"/></para>
  <para style="s1">ማሮተ ላይ</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 25:8"/>“ ‘ላይቱዋ ግዶን ደእያ ላፑን ሳምባታቱዋ ፓይዳ፤ ላፑን ሳምባታቱዋ ላይ ፓይዱ ላፑ ገደ ላፑና፤ ሄዌካ ኦይታማነ ኡዱፑን ላይ። <verse eid="LEV 25:8"/><verse number="9" style="v" sid="LEV 25:9"/>ሄዋፐ ጉይያን፥ ላፑን አግናን፥ ታማን ጋላሳን ቦንቼትያ ናጋራ አቶ ጊስያ ጋላሳን ማላካታ ፑንያ አሳ ህንተ ጋድያን ኡባን ኪትተ። <verse eid="LEV 25:9"/><verse number="10" style="v" sid="LEV 25:10"/>እሻታማን ላይ ዱማዪደ፥ ሄ ጋድያን ደእያ ኡባዉ ላአተ አዋይተ። ሄዌ ህንተንቶ እሻታማን ላይ ባላ። ሄ ዎድያን ህንተ ኡባይካ ህንተ ጋድያዉነ ህንተ ያራዉ ያራዉ ስምተ። <verse eid="LEV 25:10"/><verse number="11" style="v" sid="LEV 25:11"/>ሄ ላይይ ህንተንቶ እሻታማን ላይ ባላ። ሄ ላይን ዘሮፕተ፤ አዛባ ግዲደ ሞኬዳዋካ ጫኮፕተ፤ ቃይ ህንተ አ ጼራ ጹንቀናን አይፌዳ ዎይንያ አይፍያካ ሺሾፕተ። <verse eid="LEV 25:11"/><verse number="12" style="v" sid="LEV 25:12"/>ሄዌ እሻታማን ላይ ባላ ግድያ ድራዉ፥ እ ህንተንቶ ጌሻ፤ ጎሸናን ጮ ደምባን ሞኬዳዋ ሚተ።<verse eid="LEV 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 25:13"/>“ ‘ሀ እሻታማን ላይ ባላ ዎደ አሳይ ኡባይ ባረ ጋድያ ስሞ።<verse eid="LEV 25:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 25:14"/>“ ‘ህንተ ህንተ ሾሩዋፐ ጋድያ ሻሞፐ፥ ዎይ ቃይ አዉ ዛልኦፐ፥ እቱ እቱዋ ጭሞፕተ። <verse eid="LEV 25:14"/><verse number="15" style="v" sid="LEV 25:15"/>ህንተ እሻታማን ላይ ባላፐ ጉይያን ደእያ ላይቱዋ ፓይዱዋዳን ህንተ ሾሩዋፐ ሻምተ፤ ህንተ ሾሩካ ቃይ ጋዲ ካ ሞካናዉ ደእያ ላይቱዋ ፓይዱዋዳን ዛልኦ። <verse eid="LEV 25:15"/><verse number="16" style="v" sid="LEV 25:16"/>ላይቱዋ ፓይዱ ዳሮ ግዶፐ፥ ጋቲ ዳሬ፤ ላይቱዋ ፓይዱ ጉጾፐ፥ ጋቲካ ጉጼ። አያዉ ጎፐ፥ ህንተ ጫካና ካ ጫካ ፓይዱዋዳን ህንተ ሾሩ ህንተንቶ ዛልኤ። <verse eid="LEV 25:16"/><verse number="17" style="v" sid="LEV 25:17"/>ህንተ እቱ እቱዋ ጭሞፕተ፤ ሽን ህንተ ህንተ ጾሳዉ ያይተ። ታን መና ጎዳይ፥ ህንተ ጾሳ።<verse eid="LEV 25:17"/></para>
  <para style="s1">ላፑን ላይ መቱዋ</para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 25:18"/>“ ‘ታ አዛዙዋ ኦተ፤ ታ ህግያካ ናግተነ ኦተ፤ ያቶፐ ህንተ ሀ ጋድያን ሳሮተን ደአና። <verse eid="LEV 25:18"/><verse number="19" style="v" sid="LEV 25:19"/>ቢታይ ባረ አይፍያ ህንተንቶ እማና፤ ህንተ ካላና ጋካናዉ ማና፤ ቃይ ሄ ቢታንካ ህንተ ሳሮተን ደአና። <verse eid="LEV 25:19"/><verse number="20" style="v" sid="LEV 25:20"/>ህንተ፥ “ኑን ዘራና ዮፐ፥ ቃይ ካካ ጫኪደ ሺሻና ዮፐ፥ ላፑን ላይን አያ ማኔ?” ጎፐ፥ <verse eid="LEV 25:20"/><verse number="21" style="v" sid="LEV 25:21"/>ታን ኡሱፑን ላይን ታ አንጁዋ ህንተ ቦላን ኪታና፤ ያቶፐ ቢታይ ሄዙ ላይዉ ግድያ አይፍያ አይፋና። <verse eid="LEV 25:21"/><verse number="22" style="v" sid="LEV 25:22"/>ሆስፑን ላይን ህንተ ህንተ ጋድያን ዘርያ ዎደካ፥ ካሰ ሻቻ ካ ማና፤ ቃይ ህንተ ዘርያ ካ አይፍያ ኡዱፑን ላይን ሺሻና ጋካናዉካ፥ ሻቻ ካ ማና።<verse eid="LEV 25:22"/></para>
  <para style="s1">አቁዋ ዛርያ ዎጋ</para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 25:23"/>“ ‘ቢታይ ታዋ ግድያ ድራዉነ ህንተካ ሀ ጋድያን እማነ በተ ግዲደ ደእያ ድራዉ፥ ቢታ ላኤን ስመናዳን ባይዞፕተ። <verse eid="LEV 25:23"/><verse number="24" style="v" sid="LEV 25:24"/>ህንተ ኦይቄዳ ጋድያን ኡባን ደእያ ጋድያ ጎዳቱ ዎዛና ማላ፥ ኡንቱንቱ ማታ ናጋናዉ ኮሼ።<verse eid="LEV 25:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 25:25"/>“ ‘ነ እሻይ ህዬሲደ ባረ ጋድያፐ ዛልኦፐ፥ አዉ ማታትያ ዳቡ ዪደ፥ ሄ ጋድያ አዉ ዎዞ። <verse eid="LEV 25:25"/><verse number="26" style="v" sid="LEV 25:26"/>አዉ ሄ ጋድያ ዎዝያ ዳቡ ዮፐ፥ ቃይ እካ ስም ዱረቲደ ዎዝያ ሚሻ ደሞፐ፥ <verse eid="LEV 25:26"/><verse number="27" style="v" sid="LEV 25:27"/>ባረ ዛልኤዳ ዎድያፐ ዶሚደ ደእያ ላይ ፓይዲደ፥ አቴዳ ላይ ሚሻ ሻሜዳዎ ዛሮ፤ ያቲደ እ ባረ ጋድያዉ ስሞ። <verse eid="LEV 25:27"/><verse number="28" style="v" sid="LEV 25:28"/>ሽን አዉ ሄ ጋድያ ዎዛናዉ ግድያ ሻሉ ዮፐ፥ እሻታማን ላይ ባላይ ጋካናዉ ጋዲ ሻሜዳ ብታንያ ኩሽያን ጋምኦ፤ እሻታማን ላይ ባላ ዎደ፥ አ ጋዲ አዉ ስሞ፤ እካ ባረ ጋድያዉ ስሞ።<verse eid="LEV 25:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 25:29"/>“ ‘ግምበት ኡቴዳ ካታማ ግዶን እት አሳይ ደእያ ጎልያ ሀራ ኡራዉ ዛልኦፐ፥ እ ዛልኦሳፐ ቢደ እት ላይ ጋካናዉ ደእያ ዎድያን ዛሪደ ዎዛናዉ አዉ ማታይ ደኤ። <verse eid="LEV 25:29"/><verse number="30" style="v" sid="LEV 25:30"/>እት ላይ ኩመን ግዶን ዎዛና ዮፐ፥ ሄ ግምበቴዳ ካታማ ግዶን ደእያ ጎሊ ሻሜዳዎ ናኣ ናአዉ መናዉ አዋ ግዴ። እሻታማን ላይ ባላ ዎደካ ስመና። <verse eid="LEV 25:30"/><verse number="31" style="v" sid="LEV 25:31"/>ሽን ግምበትቤና ሄራቱዋን ደእያ ጎለቱ ሾይቃ ማላ። ኡንቱንቱ ዎዘቲኖ፤ እሻታማን ላይ ባላ ዎደካ ዛልኤዳዎ ስሚኖ።<verse eid="LEV 25:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 25:32"/>“ ‘ግዶፐነ ሌዋቱዋ ካታማቱዋን ደእያ ባረንቱ ጎልያ ሌዋቱ ባረንቱ ኮዬዳ ዎድያን ዎዝ አካናዉ ዳንዳዪኖ። <verse eid="LEV 25:32"/><verse number="33" style="v" sid="LEV 25:33"/>ሌዋቱዋፐ እት አሳይ ኡንቱንቱ ካታማ ግዶን ደእያ ጎልያ ዛልኢደ ዎዛና ዮፐ፥ ሄ ኡንቱንቱ ካታማ ግዶን ደእያ ጎሊ እሻታማን ላይ ባላ ዎደ ስሜ። አያዉ ጎፐ፥ ሌዋቱዋ ካታማ ግዶን ደእያ ጎለቱ እስራኤልያ አሳ ግዶን ሌዋቶ አቆ። <verse eid="LEV 25:33"/><verse number="34" style="v" sid="LEV 25:34"/>ሽን ኡንቱንቱ ካታማ ዩሹዋን ኡንቱንቱ ኡባዉ እትፐ ደእያ ቢታይ ኡንቱንቶ መናዉ አቆ ግድያ ድራዉ ዛልኤተና።<verse eid="LEV 25:34"/></para>
  <para style="s1">ማንቄዳ አሳዉ ታልእያዋ</para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 25:35"/>“ ‘ቃይ ነ እሻይ ህዬሲደ ባረና ዳንዳያና ዮፐ፥ እማዳንነ በትያዳን እ ኔናና ደአና ማላ፥ ኔን አ ማዳ።<note caller="-" style="x"><char style="xo" closed="false">25:35 </char><char style="xt" closed="false"><ref loc="DEU 15:7-8">ዛረ. 15:7-8</ref></char></note> <verse eid="LEV 25:35"/><verse number="36" style="v" sid="LEV 25:36"/>ነ እሻ ኔናና ዎናዉ አፐ ድቻ አኮፓ፤ ዎይ ዎያ ሞፓ። ሽን ኔን ነ ጾሳዉ ያያ። <verse eid="LEV 25:36"/><verse number="37" style="v" sid="LEV 25:37"/>ነ ብራ አዉ ድቻዉ ታልኦፓ፤ ነ ቁማካ አዉ ዎያን ዛልኦፓ።<note caller="-" style="x"><char style="xo" closed="false">25:37 </char><char style="xt" closed="false"><ref loc="EXO 22:25">ከሳ 22:25</ref>፤ <ref loc="DEU 23:19-20">ዛረ. 23:19-20</ref></char></note> <verse eid="LEV 25:37"/><verse number="38" style="v" sid="LEV 25:38"/>ህንተዉ ካናነ ቢታ እማናዉነ ህንተ ጾሳ ግዳናዉ፥ ህንተና ግብጼ ጋድያፐ ከሴዳዌ፥ ታን መና ጎዳይ፥ ህንተ ጾሳ።<verse eid="LEV 25:38"/></para>
  <para style="s1">አይለቱ አይለተፐ ከስያዋ</para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 25:39"/>“ ‘ነዉ ዳቦ ግድያ እስራኤልያ አሳይ ማንቂደ፥ ባረና ነዉ አይለተዉ ዛልኦፐ፥ ኔን አ አይልያዳን ኦስሶፓ።<note caller="-" style="x"><char style="xo" closed="false">25:39-46 </char><char style="xt" closed="false"><ref loc="EXO 21:2-6">ከሳ 21:2-6</ref>፤ <ref loc="DEU 15:12-18">ዛረ. 15:12-18</ref></char></note> <verse eid="LEV 25:39"/><verse number="40" style="v" sid="LEV 25:40"/>እ ከራ ኦያ አሳዳንነ በትያዳን ኔናና ደኦ፤ እሻታማን ላይ ባላይ ጋካናዉ እ ነዉ ኦ። <verse eid="LEV 25:40"/><verse number="41" style="v" sid="LEV 25:41"/>ሄ ዎደ እ ባረ ናናቱዋናካ እትፐ ነ ጎለፐ ከሲደ ባረ ጎልያ አሳኮ ቦ፤ ባረ አዉዋ ጋድያኮካ ስሞ። <verse eid="LEV 25:41"/><verse number="42" style="v" sid="LEV 25:42"/>እስራኤላቱ ታን ግብጼ ጋድያፐ ከሴዳ ታ አይለቱዋ ግድያ ድራዉ፥ ኡንቱንቱ አይለተዉ ዛልኤቶፕኖ። <verse eid="LEV 25:42"/><verse number="43" style="v" sid="LEV 25:43"/>ኔን ኡንቱንቶ መቀ ኢታደ ሞዶፓ፤ ሽን ኔን ነ ጾሳዉ ያያ።<verse eid="LEV 25:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LEV 25:44"/>“ ‘ነዉ አቱማነ ማጫ አይለቱ ደአና ማላ ኮዮፐ፥ ነ ዩሹዋን ደእያ ካዉተቱዋፐ ሻማ። <verse eid="LEV 25:44"/><verse number="45" style="v" sid="LEV 25:45"/>ቃይ ህንተ ጋድያን ደእያ በተቱዋፐነ ህንተ ጋድያን ደእሽን የለቴዳ ኡንቱንቱ ሶ አሳፐ ሻማናዉ ዳንዳዪታ፤ ኡንቱንቱ ህንተንቶ አቆ ግድኖ። <verse eid="LEV 25:45"/><verse number="46" style="v" sid="LEV 25:46"/>ህንተፐ ጉይያን ህንተ ናናይ ኡንቱንታ መናዉ ላታና ማላ፥ ህንተ ናናዉ እምተ። ህንተ ኡንቱንቱፐ ኡባ ዎደካ አይልያ ሻማናዉ ዳንዳዪታ፤ ሽን ህንተ እሻ ግድያ እስራኤልያ አሳ መቀ ኢሲደ ሞዶፕተ።<verse eid="LEV 25:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LEV 25:47"/>“ ‘ነ ማታን ደእያ እማ ዎይ በተ አሳይ ዱረትና፥ ቃይ አ ማታን ደእያ ነ እሻይ ማንቂደ፥ ሄ ነ ማታን ደእያ እማዉ ዎይ በትያዉ ዎይ እማ ብታንያ ዛርያፐ እቶ ባረና ዛልኦፐ፥ <verse eid="LEV 25:47"/><verse number="48" style="v" sid="LEV 25:48"/>እ ዛልኤት ስምና አ ዎዛናዉ ዳንዳየቴ፤ አ እሻቱዋፐ እቱ አ ዎዞ። <verse eid="LEV 25:48"/><verse number="49" style="v" sid="LEV 25:49"/>ዎይ አ አዉዋ እሻይ፥ ዎይ አ አዉዋ እሻ ናአይ አ ዎዞ፤ ዎይ አ ያራፐ አዉ ማታ ዳቦ ግድያ አሳይ አ ዎዞ፤ ዎይ ቃይ እ ባረ ሁጲያዉ ዱረቶፐ እ ባረና ዎዞ። <verse eid="LEV 25:49"/><verse number="50" style="v" sid="LEV 25:50"/>እ ባረና ሻሜዳ ብታንያና እትፐ ግዲደ፥ እ ባረና ዛልኤዳ ላይፐ ዶሚደ እሻታማን ላይ ባላይ ጋካናዉ ደእያ ላይ ፓይዶ፤ አ ብልያ ጋቲ ሄ ላይ ፓይዱዋ ኬሻ ግዶ። እ ባረና ሻሜዳዋና ጋምኤዳ ዎድያ ጋቲ እት አሳይ ከራ ኦደ ደምያ ሚሻ ኬሻ ግዶ። <verse eid="LEV 25:50"/><verse number="51" style="v" sid="LEV 25:51"/>እሻታማን ላይ ባላይ ጋካናዉ ብሮ ዳሮ ላይይ አቴዳዋ ግዶፐ፥ ባረ ዛልኤቴዳ ጋትያፐ ሄ ላይ ፓይዱዋን ባረና ዎዝያ ጋትያ ጭጎ። <verse eid="LEV 25:51"/><verse number="52" style="v" sid="LEV 25:52"/>ቃይ እሻታማን ላይ ባላይ ጋካናዉ አቴዳ ላይይ ጉ ግዶፐ፥ ባረና ሻሜዳዋና እትፐ ፓይዲደ፥ ሄ ላይ ፓይዱዋን ባረና ዎዝያ ጋትያ ጭጎ። <verse eid="LEV 25:52"/><verse number="53" style="v" sid="LEV 25:53"/>እ ላይን ላይን ከራ ኦያ አሳዳን ባረና ሻሜዳዋና ደኦፐ አትና፥ ህንተ ጼሊደ እስራኤልያ አሳ ግድያ ብታንያ መቀ ኢሲደ ሞዶፕተ።<verse eid="LEV 25:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="LEV 25:54"/>“ ‘ሽን እ ሄዋ ማላ ኦግያን ዎዘታና ዮፐ፥ እሻታማን ላይ ባላይ ጋክያ ዎደ እነ አ ናናይ ቆማተፐ ከስኖ። <verse eid="LEV 25:54"/><verse number="55" style="v" sid="LEV 25:55"/>አያዉ ጎፐ፥ እስራኤልያ አሳይ ታ ቆማቱዋቴ፤ ታን ግብጼ ጋድያፐ ከሴዳ ታ ቆማቱዋ። ታን፥ መና ጎዳይ፥ ህንተ ጾሳ’ ያጋ” ያጌዳ።<verse eid="LEV 25:55"/></para>
  <chapter eid="LEV 25"/>
  <chapter number="26" style="c" sid="LEV 26"/>
  <para style="s1">አዛዘትና ቤትያ አንጁዋ</para>
  <para style="r">(<ref loc="DEU 7:12-24">ዛረ. 7:12-24</ref>፤ <ref loc="DEU 28:1-14">28:1-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 26:1"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ህንተ ኡንቱንቶ ጎይናናዉ ኤቃቱዋ መፕተ፤ ቃይ ሀዉልትያ፥ ማሰቴዳ ምስልያ ዎይ ማሰቴዳ ሹቻ ኤሶፕተ። ታን፥ መና ጎዳይ፥ ህንተ ጾሳ። <verse eid="LEV 26:1"/><verse number="2" style="v" sid="LEV 26:2"/>ታ ሳምባታቱዋ ናግተ፤ ታ ዱንካንያ ቦንችተ፤ ታን መና ጎዳ።<verse eid="LEV 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 26:3"/>“ህንተ ታ ህግያን ቦፐ፥ ታ አዛዞቱዋካ ናጎፐነ ኦፐ፥<note caller="-" style="x"><char style="xo" closed="false">26:3-5 </char><char style="xt" closed="false"><ref loc="DEU 11:13-15">ዛረ. 11:13-15</ref>፤ <ref loc="DEU 28:1-14">28:1-14</ref></char></note> <verse eid="LEV 26:3"/><verse number="4" style="v" sid="LEV 26:4"/>ታን ህንተንቶ እራ ዎድያን ቡክሳና፤ ቢታይካ ካ ዳርሲደ ሞካና፤ ደምባ ምቱካ አይፍያ አይፋና። <verse eid="LEV 26:4"/><verse number="5" style="v" sid="LEV 26:5"/>ህንተ ካ ቡክያ ዎድያፐ ቢደ ዎይንያ አይፍያ ማጽያ ዎዲ ጋካናዉ ካ ቆጻና፤ ቃይ ዎይንያ አይፍያ ማጹካ ቢደ ካ ዘርያ ዎዲ ጋካናዉ ዉረና። ህንተ ካላና ጋካናዉ ቁማ ማና፤ ቃይ ህንተ ህንተ ቢታንካ ሳሩዋን ደአና።<verse eid="LEV 26:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 26:6"/>“ታን ቢታዉ ሳሮተ እማና፤ ኦንነ ያሽሰናን ህንተ ግሳና። ኢታ ዶአቱዋ ታን ጋድያፐ ይሳና፤ ህንተ ጋድያን ላኤን ኦላይ ደንደና። <verse eid="LEV 26:6"/><verse number="7" style="v" sid="LEV 26:7"/>ህንተ ሞርከቱዋ ህንተ የደርሳና፤ ህንተ ስንን ኡንቱንቱ ማሻን ሀይቃና። <verse eid="LEV 26:7"/><verse number="8" style="v" sid="LEV 26:8"/>ህንተፐ እቼሹ ጼቱዋ የደርሳና፤ ቃይ ጼቱ ታሙ ሻኣ የደርሳና። ህንተ ሞርከቱ ህንተ ስንን ማሻን ሀይቃና።<verse eid="LEV 26:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 26:9"/>“ታን ታ ዴሙዋ ህንተኮ ዛራና፤ ህንተና አይፍሳና፤ ህንተና ዳርሳና። ቃይ ታን ታ ጫቁዋ ህንተናና ምንሳና። <verse eid="LEV 26:9"/><verse number="10" style="v" sid="LEV 26:10"/>ህንተ ሻቻ ካ ማና፤ ቃይ ሀ ላይ ካ ዎናዉ፥ ሻቻ ካ ድጊደ ሳኣ ከሳና። <verse eid="LEV 26:10"/><verse number="11" style="v" sid="LEV 26:11"/>ታን ታ ደእያ ሳኣ ህንተ ግዶን ኦና፤ ታን ህንተና ሻትከ። <verse eid="LEV 26:11"/><verse number="12" style="v" sid="LEV 26:12"/>ታን ህንተ ግዱዋን ሀመታና፤ ቃይ ህንተ ጾሳ ግዳና፤ ህንተካ ታ አሳ ግዳንታ።<note caller="-" style="x"><char style="xo" closed="false">26:12 </char><char style="xt" closed="false"><ref loc="2CO 6:16">2 ቆሮ. 6:16</ref></char></note> <verse eid="LEV 26:12"/><verse number="13" style="v" sid="LEV 26:13"/>ህንተ ግብጼቶ አይልያ ግደናዳን፥ ግብጼ ጋድያፐ ህንተና ከሴዳዌ ታን መና ጎዳይ ህንተ ጾሳ። ታን ህንተ አይለተ ሞርገ ም መንድ፤ ቃይ ህንተካ ቁ ጊደ ሄመታናዳን ኦድ።<verse eid="LEV 26:13"/></para>
  <para style="s1">አዛዘተናን እጽና ጋክያ ሙራ</para>
  <para style="r">(<ref loc="DEU 28:15-68">ዛረ. 28:15-68</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 26:14"/>“ሽን ህንተ ታን ግያዋ ስሰናን እጾፐነ፥ ሀ አዛዞቱዋ ኡባካ ኦናን እጾፐ፥ <verse eid="LEV 26:14"/><verse number="15" style="v" sid="LEV 26:15"/>ታ ዎጋ ህንተ ካኦፐ፥ ቃይ ታ አዛዞቱዋ ኡባ ኦናን እጺደ ታ ጫቁዋ መንናዉ ህንተ ታ ህግያ ሻቶፐ፥ <verse eid="LEV 26:15"/><verse number="16" style="v" sid="LEV 26:16"/>ሄ ዎደ ታን ህንተ ቦላ ሀዋ ኦና: ህንተ አኬከናን ደእሽን ያሻ፥ ግልቃተ፥ ህንተ አይፍያ ጆልስያነ ህንተና ሎይ ሀርግስያ ምሹዋ ህንተ ቦላ አሀና። ህንተ ዘረ ዘራና፤ ሽን እ ሀዳ፤ አያዉ ጎፐ፥ ሄዋ ህንተ ሞርከቱ ማና። <verse eid="LEV 26:16"/><verse number="17" style="v" sid="LEV 26:17"/>ታን ታ ሶምኡዋ ህንተ ቦላ ቱካና፤ ህንተ ሞርከቱዋ ስንን ህንተ ኩንዳና፤ ህንተና እጺያዋንቱ ህንተና ሞዳና፤ ቃይ ኦንነ የደርሰናን ህንተ ባቃታና።<verse eid="LEV 26:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 26:18"/>“ሀዋ ኡባ ኦናካ ህንተ ታና ስሰናን እጾፐ፥ ታን ህንተ ናጋራ ድራዉ ህንተ ሙራ ላፑን ዳኩዋ ጉጃና። <verse eid="LEV 26:18"/><verse number="19" style="v" sid="LEV 26:19"/>ህንተ ዎልቃ ኦቶሩዋ ታን መንና፤ ሳሉዋ ብራታ ማላ ኦና፤ ህንተ ቢታካ ናሃስያ ግያ ብራታ ማላ ኦና። <verse eid="LEV 26:19"/><verse number="20" style="v" sid="LEV 26:20"/>ህንተ ዎልቃይ ሀዳሳን ዉራና፤ አያዉ ጎፐ፥ ህንተ ቢታይ ካ ሞከና፤ ጋድያን ደእያ ምቱካ አይፍያ አይፍክኖ።<verse eid="LEV 26:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 26:21"/>“ህንተ ታዉ እጼዶ ጎፐነ ታን ግያዋካ ስሰናን እጾፐ፥ ህንተ ናጋራ ኬሻ ላፑን ዳኩዋ ቦሻ ታን ህንተ ቦላን አሀና። <verse eid="LEV 26:21"/><verse number="22" style="v" sid="LEV 26:22"/>ታን ህንተ ቦላ ባዙዋ ዶአቱዋ የዳና፤ ኡንቱንቱ ህንተ ናናቱዋ ቦንቃና፤ ህንተ መሄቱዋ ይሳና፤ ህንተ ፓይዱዋካ ጉና፤ ሄዋ ጋሱዋን ህንተ ሀመትያ ኦጊ ባዙዋ ግዳናዋ።<verse eid="LEV 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 26:23"/>“ሀ ኡባ ሙራንካ ህንተ ታኮ ስመናን እጻድ ጊደ ቦፐ፥ <verse eid="LEV 26:23"/><verse number="24" style="v" sid="LEV 26:24"/>ሄ ዎደ ታንካ ህንተንቶ እጻድ ጋና፤ ቃይ ህንተ ናጋራ ድራዉ ታን ታ ሁጲያዉ ህንተና ላፑን ዳኩዋ ሙራና። <verse eid="LEV 26:24"/><verse number="25" style="v" sid="LEV 26:25"/>ታ ጫቁዋ መንዳ ሀሉዋ ከስያ ማሻ ታን ህንተ ቦላ አሀና፤ ህንተ ህንተ ካታማቱዋን ሺቆፐካ፥ ታን ህንተ ቦላን ኢታ ሀርግያ የዳና። ቃይ ህንተካ ህንተ ሞርከቱዋ ኩሽያን አደ እመታና። <verse eid="LEV 26:25"/><verse number="26" style="v" sid="LEV 26:26"/>ህንተ ካ ታን ይስያ ዎደ፥ ታሙ ማጫ አሳቱ እት ባሽያን ኡክ ኡካና፤ ሄዋካ ሚዛናን ልኪደ ሻካና፤ ህንተ ሄዋ ማና፥ ሽን ካልክታ።<verse eid="LEV 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 26:27"/>“ሀ ኡባንካ ህንተ ታን ግያዋ ስሰናን እጻድ ጊደ ቦፐ፥ <verse eid="LEV 26:27"/><verse number="28" style="v" sid="LEV 26:28"/>ሄ ዎደ ታንካ ህንተ ቦላ ሀንቁዋን ደንዳና፤ ህንተ ናጋራ ድራዉ ታን ታ ሁጲያዉ ህንተና ላፑን ዳኩዋ ሙራን። <verse eid="LEV 26:28"/><verse number="29" style="v" sid="LEV 26:29"/>ህንተ ህንተ አቱማ ናናቱዋነ ህንተ ማጫ ናናቱዋ አሹዋ ማና። <verse eid="LEV 26:29"/><verse number="30" style="v" sid="LEV 26:30"/>ህንተ ጎይንያ ቃ ሳኣ ታን ኮላና፤ ህንተ እጻና ያርሽያ ሳኣካ ይሳና። ታን ህንተ አሃ ህንተ ኤቃቱዋ አሃ ቦላን ኦላና፤ ታን ህንተና ሙለ ሻታና። <verse eid="LEV 26:30"/><verse number="31" style="v" sid="LEV 26:31"/>ታን ህንተ ካታማቱዋ መላ ኦና፤ ህንተ ጎይንያ ሳአቱዋካ ኮለሬና፤ ህንተ ሳዊያ ያርሹዋካ ስንግከ።<verse eid="LEV 26:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 26:32"/>“ታን ህንተ ቢታ ይሳና፤ ያቶፐ ሄ ህንተ ጋድያን ዪደ ኡትያ ሞርከቱካ ሄዋን ማላለታና። <verse eid="LEV 26:32"/><verse number="33" style="v" sid="LEV 26:33"/>ታን ህንተና ካዉተቱዋ ግዶን ላላና፤ ህንተ ቦላንካ ታ ማሻ ሾዳና። ህንተ ቢታይ ባያና፤ ህንተ ካታማቱካ መላ ግዳና። <verse eid="LEV 26:33"/><verse number="34" style="v" sid="LEV 26:34"/>ሄ ህንተ ህንተ ሞርከቱዋ ጋድያን ደእያ ዎደ፥ ባዪደ ጮ ደእያ ህንተ ቢታይ ባረ ሳምባታቱዋ ቦንቺደ ናሸታና። ሄ ዎደ ህንተ ቢታይ ሸምፓናነ ባረ ሳምባታቱዋ ቦንቺደ ናሸታና። <verse eid="LEV 26:34"/><verse number="35" style="v" sid="LEV 26:35"/>ህንተ ሄ ጋድያን ደኤዳ ዎድያን ኡባን ህንተ ሳምባታቱዋን ደምቤና ሸምፑዋ ሀእ ባዪደ ጮ ደእያ ዎድያን ደማና።<verse eid="LEV 26:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LEV 26:36"/>“ህንተ ህንተ ሞርከቱዋ ጋድያን ደእያ ዎደ፥ ህንተፐ ሻከቲደ ጉየ አቲደ ደእያዋንቱ ዎዛናን ታን ያሻ የዳና፤ ጫርኩ ቃያ ቦንጭያ ኮሻይ ኡንቱንታ ሻቢራና፤ ኡንቱንቱ ማሻፐ ባቃትያዋዳን ባቃታና፤ ቃይ ኡንቱንቱ ኦንነ የደርሰናን ኩንዳና። <verse eid="LEV 26:36"/><verse number="37" style="v" sid="LEV 26:37"/>ህንተና የደርስያዌ ባይናን ደእሽን፥ ህንተ ኦላፐ ባቃትያዋዳን እቱ እቱዋና በታና፤ ቃይ ህንተ ህንተ ሞርከቱዋ ስንን ኤቃናዉካ ህንተንቶ አያ ዎልቂነ ደኤና። <verse eid="LEV 26:37"/><verse number="38" style="v" sid="LEV 26:38"/>ህንተ ካዉተቱዋ ግዶን ባያና፤ ህንተ ሞርከቱዋ ቢታይካ ህንተና ምታና። <verse eid="LEV 26:38"/><verse number="39" style="v" sid="LEV 26:39"/>ህንተፐ ሻከቲደ ህንተ ሞርከቱዋ ጋድያን አቴዳዋንቱ ባረንቱ ናጋራ ጋሱዋንነ ባረንቱ አዎቱዋ ናጋራ ጋሱዋን ግልቃና።<verse eid="LEV 26:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LEV 26:40"/>“ሽን ኡንቱንቱ ታን ኡንቱንቶ እጼዳ ጋናዳንነ ኡንቱንቱ ሞርከቱዋ ቢታዉ ኡንቱንታ የዳናዳን ኦዳ ባረንቱ ናጋራ፥ ባረንቱ ማይዛ አዎቱዋ ናጋራ፥ ኡንቱንቱ ታና ጭሜዳ ጭሙዋነ ኡንቱንቱ ታዉ እጻድ ጌዳዋ ፓጾፐ፥ <verse eid="LEV 26:40"/><verse number="41" style="v" sid="LEV 26:41"/>ሄዋን ቃይ ኡንቱንቱ አዛዘተና ዎዛናይካ ዝቂ ጎፐነ ኡንቱንቱ ባረንቱ ናጋራ ሙራ አኮፐ፥ <verse eid="LEV 26:41"/><verse number="42" style="v" sid="LEV 26:42"/>ሄ ዎደ ታን ያቆባና ጫቀቴዳ ታ ጫቁዋ ሀሳያና፤ ቃይ ይሳቃናነ አብራሃመና ጫቀቴዳ ታ ጫቁዋ ሀሳያና፤ ቢታካ ሀሳያና።<note caller="-" style="x"><char style="xo" closed="false">26:42 </char><char style="xt" closed="false"><ref loc="GEN 17:7-8">ዶመ 17:7-8</ref>፤ <ref loc="GEN 26:3-4">26:3-4</ref>፤ <ref loc="GEN 28:13-14">28:13-14</ref></char></note> <verse eid="LEV 26:42"/><verse number="43" style="v" sid="LEV 26:43"/>ኡንቱንቱ ይ ድግና፥ ኡንቱንቱ ቢታይ መላ አታና፤ ሄ ኡንቱንቱ ይና ባይያዋ ግዲደ ጮ ደእያ ዎድያን ቢታይ ባረ ሳምባታቱዋ ቦንቺደ ናሸታና። ኡንቱንቱ ታ አዛዙዋ ካዳ ድራዉነ ኡንቱንቱ ሸምፑካ ታ ዎጋ ሻቴዳ ድራዉ፥ ኡንቱንቱ ባረንቱ ናጋራ ሙራ አካና።<verse eid="LEV 26:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LEV 26:44"/>“ግዶፐነ ኡንቱንቱ ባረንቱ ሞርከቱዋ ጋድያን ደእያ ዎደ፥ ኡንቱንቱ ኡባና ያና ጋካናዉነ ኡንቱንቱና ደእያ ታ ጫቁዋካ መንና ጋካናዉ፥ ታን ኡንቱንታ ኦልከ፤ ቃይ ሻትከ። ታን፥ መና ጎዳይ፥ ኡንቱንቱ ጾሳ። <verse eid="LEV 26:44"/><verse number="45" style="v" sid="LEV 26:45"/>ታን ኡንቱንቱ ጾሳ ግዳናዉ፥ ካዉተቱ ጼልሽን፥ ግብጼ ጋድያፐ ከሴዳ ኡንቱንቱ ማይዛ አዎቱዋና ታን ጫቀቴዳ ጫቁዋ ኡንቱንቱ ድራዉ ሀሳያና። ታን መና ጎዳ።<verse eid="LEV 26:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 26:46"/>“መና ጎዳይ ሲና ደርያ ቦላን ሙሴ ባጋና ባረፐነ እስራኤልያ አሳፐ ግዱዋን ዎዳ ዎጋቱ፥ አዛዞቱነ ህገቱ ሀዋንታ” ያጌዳ።<verse eid="LEV 26:46"/></para>
  <chapter eid="LEV 26"/>
  <chapter number="27" style="c" sid="LEV 27"/>
  <para style="s1">ጾሳዉ እምያዋ ሺሽያ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 27:1"/>መና ጎዳይ ሙሳ ሀዋዳን ያጌዳ፤ <verse eid="LEV 27:1"/><verse number="2" style="v" sid="LEV 27:2"/>“እስራኤልያ አሳዉ ሀዋዳን ያጋደ ኦዳ፤ ‘እት አሳይ መና ጎዳዉ እማናዉ ሺቆፐ፥ ኔን ቆፕያዋዳን ሄ አሳ ድራዉ ሚሻ ጭጎ። <verse eid="LEV 27:2"/><verse number="3" style="v" sid="LEV 27:3"/>ሄዌነ ላታሙ ላይፐ ቢደ ኡሱፑን ታሙ ላይ ጋካናዉ ደእያ አቱማዎ ኡሱፑን ጼቱ ግራምያ ዴጽያ ጻጋራ ብራ ጭጎ። <verse eid="LEV 27:3"/><verse number="4" style="v" sid="LEV 27:4"/>ማጫ አሳ ግዶፐ ቃይ ሀታሙ ጻጋራ ብራ ጭጎ። <verse eid="LEV 27:4"/><verse number="5" style="v" sid="LEV 27:5"/>ቃይ እቼሹ ላይፐ ቢደ ላታሙ ላይ ጋካናዉ ደእያ አቱማዎ ላታሙ ጻጋራ ብራነ ማጫንዉ ታሙ ጻጋራ ብራ ጭጎ። <verse eid="LEV 27:5"/><verse number="6" style="v" sid="LEV 27:6"/>ቃይካ እት አግናፐ ቢደ እቼሹ ላይ ጋካናዉ ደእያ አቱማዎ እቼሹ ጻጋራ ብራነ ማጫንዉ ሄዙ ጻጋራ ብራ ጭጎ። <verse eid="LEV 27:6"/><verse number="7" style="v" sid="LEV 27:7"/>ሄዋዳንካ ቃይ ኡሱፑን ታሙ ላይነ ሄዋፐ ቦላና ደእያ አቱማዎ ታማነ እቼሹ ጻጋራ ብራነ ማጫንዉ ታሙ ጻጋራ ብራ ጭጎ። <verse eid="LEV 27:7"/><verse number="8" style="v" sid="LEV 27:8"/>ቃይ ሺቄዳ ብታኒ ኔን ቆፕዳዋ ጭጋናዉ ዳንዳየና ዳሮ ማንቆ ግዶፐ፥ እ ባረ ሺቁዋ ጋናዉ እሜዳ አሳ አሂደ ቄስያ ስንን ኤሶፐ ሺቄዳ ብታኒ ጭጋናዉ ዳንዳይያዋ ኬና ቆፒደ ቄሲ ጋማቶ።<verse eid="LEV 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 27:9"/>“ ‘እ ሺቀቴዳዌ አሳይ መና ጎዳዉ ያርሽያ ሳኣ ማላ መህያ ያርሻናዉ ግዶፐ፥ ሄዋ ማላ አሳይ መና ጎዳዉ እምያ መሂ ኡባይ ጌሻ። <verse eid="LEV 27:9"/><verse number="10" style="v" sid="LEV 27:10"/>እ ሄ መህያ ድራዉ ሀራ መህያ እሞፖ፤ ዎይ አ ሀራ መህያና ላሞፖ። ሎኡዋ ኢታና ዎይ ቃይ ኢታካ ሎኡዋና ላሞፖ፤ ሽን እ ላሞፐ፥ ኮይሮ መህያነ ላምያ እሜዳ መሂ ላኡካ ጌሻ። <verse eid="LEV 27:10"/><verse number="11" style="v" sid="LEV 27:11"/>እ ሺቀቴዳ መሂ መና ጎዳዉ ያርሹዋ ኦደ ሺሻናዉ ጌሻ ግደና መህያ ግዶፐ፥ ሄ ብታኒ ሄ መህያ ቄስያ ስን አሆ። <verse eid="LEV 27:11"/><verse number="12" style="v" sid="LEV 27:12"/>ሎኦ ግድና ኢታ ግድና፥ ቄሲ ሄ መህያ ጋማቶ፤ ያቶፐ ቄሲ ጋማቴዳዌ አ ጋትያ ግዶ። <verse eid="LEV 27:12"/><verse number="13" style="v" sid="LEV 27:13"/>ሽን ሄ መህያ ጎዳይ አ ዛሪደ ዎዛናዉ ኮዮፐ፥ ሄ መህያ ጋትያ ቦላ ጼቱዋፐ ላታሙ ኩሽያ ጉጆ።<verse eid="LEV 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 27:14"/>“ ‘እት አሳይ ባረ ጎልያ ጌሻ ግዳናዳን መና ጎዳዉ ዱማዮፐ፥ ሎኦ ግድና ኢታ ግድና፥ ቄሲ ሄ ጎልያ ጋማቶ። ያቶፐ ቄሲ ጋማቴዳዋዳን አ ጋቲ ሄዋዳንካ ግዶ። <verse eid="LEV 27:14"/><verse number="15" style="v" sid="LEV 27:15"/>ቃይ ባረ ጎልያ ጾሳዉ ጌሻ ኦ ዱማዬዳ አሳይ ዛረደ ዎዛናዉ ኮዮፐ፥ ሄ ጎልያ ጋትያ ቦላን ጼቱዋፐ ላታሙ ኩሽያ ጉጆ፤ ያቶፐ ጎሊ አሳ ግዴ።<verse eid="LEV 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 27:16"/>“ ‘እት አሳይ ባረ ላታ ጋድያፐ ሻኪደ ጌሻ ኦ መና ጎዳዉ ዱማዮፐ፥ ሄ ጋድያ ጋቲ አን ዘርያ ዘረን ቆፈቶ። ሄዌነ ላታሙ ኪሎ ግራመ ባንጋ ዘርያ ኬሻ ሾይቃ ግዶፐ፥ ታሙ ጻጋራ ብራ ጭጎ። <verse eid="LEV 27:16"/><verse number="17" style="v" sid="LEV 27:17"/>እ ባረ ጋድያ እሻታማን ላይ ባላፐ ዶሚደ ጌሻ ኦ ጾሳዉ ዱማዮፐ፥ ሄ ጋድያዉ ኩመን ጋትያ ጭጎ። <verse eid="LEV 27:17"/><verse number="18" style="v" sid="LEV 27:18"/>ሽን እ ባረ ጋድያ እሻታማን ላይ ባላይ አ ስምና ጌሻ ኦ ጾሳዉ ዱማዮፐ፥ ካሊደ ደእያ እሻታማን ላይ ባላይ ጋካናዉ ደእያ ዎድያ ቄሲ ፓይዶ፤ ያቶፐ አ ኩመን ጋትያፐ ዎ። <verse eid="LEV 27:18"/><verse number="19" style="v" sid="LEV 27:19"/>ሄ ጋድያ ጌሻ ኦ ጾሳዉ ዱማዬዳ አሳይ ዛረ ዎዛናዉ ኮዮፐ፥ እ ጋማተቴዳ ሚሻ ቦላ ጼቱዋፐ ላታሙ ኩሽያ ጉጆ፤ ያቶፐ ጋዲ ስሚደ አዋ ግዴ። <verse eid="LEV 27:19"/><verse number="20" style="v" sid="LEV 27:20"/>ሽን እ ጋድያ ዛረደ፥ ዎዛናፐ ካሰቲደ ሀራ አሳዉ ዛልኦፐ፥ ሄ ጋድያ ዎዛናዉ ዳንዳየና። <verse eid="LEV 27:20"/><verse number="21" style="v" sid="LEV 27:21"/>እሻታማን ላይ ባላይ ጋክና ጋዲ የደቲያ ዎደ፥ ሄ ጋዲ ላኤን ጉየ አካናዋዳን መና ጎዳዉ ጌሻ ግዴ። ሄ ግሹ ቄስያሳ።<verse eid="LEV 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 27:22"/>“ ‘እት አሳይ ሀራ አሳፐ ሻሜዳ ጋድያ ጌሻ ኦ መና ጎዳዉ ዱማያናዉ ኮዮፐ፥ <verse eid="LEV 27:22"/><verse number="23" style="v" sid="LEV 27:23"/>ካልያ እሻታማን ላይ ባላይ ጋካናዉ ደእያ ጋትያ ቄሲ ጋማቶ፤ ብታኒ ሄ ጋላስካ ሄ ግምትያ ጭጎ፤ ሄ ሚሻይ መና ጎዳዉ ዱማቴዳ ሚሻ ግዳናዋ። <verse eid="LEV 27:23"/><verse number="24" style="v" sid="LEV 27:24"/>እሻታማን ላይ ባላይ ጋክያ ዎደ፥ ሄ ጋዲ ኮይሮ ላታን አኪደ ዛልኤዳ ብታንያዉ ስሜ።<verse eid="LEV 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 27:25"/>“ ‘አ ጋቲ ጾሳ ዱንካንያን ኤረቲያ ሚዛናን ጋማተቴ።<verse eid="LEV 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 27:26"/>“ ‘ሽን ኦንነ ባይራ የለቴዳ መህያ መና ጎዳዉ ዱማዪደ ሺሻናዉ ዳንዳየና፤ አያዉ ጎፐ፥ እ ካሰካ መና ጎዳሳ። ሚዛ ማራ ግድና ዎይ ዶርሳ ማራ ግድናካ እ መና ጎዳዋ። <verse eid="LEV 27:26"/><verse number="27" style="v" sid="LEV 27:27"/>ሄ መሂ ጌሻ ግዳና ዮፐ፥ ነ ጋማቴዳ ጋትያ ቦላ ጼቱዋፐ ላታሙ ኩሽያ ጉጂደ አ ጎዳይ ዛረደ ዎዞ። እ ዎዛና ዮፐ፥ ነ ጋማቴዳ ጋትያን ሀራ አሳዉ ዛልኤቴዳ።<verse eid="LEV 27:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 27:28"/>“ ‘እት አሳይ ባረዋፐ መና ጎዳዉ እሜዳዌ አያ ግዶፐካ፥ አሳ ግድና መህያ ግድና፥ ዎይ አ ላታን ጋኬዳ ጋደ ግድናካ፥ ዛልኤተናነ ዎዘተና። ዱማዬዳዌ ኡባባይ መና ጎዳዉ ጌሻ ኡባፐ እቱዋ ግዴዳ ጌሻ ያርሹዋ።<note caller="-" style="x"><char style="xo" closed="false">27:28 </char><char style="xt" closed="false"><ref loc="NUM 18:14">ፓይ. 18:14</ref></char></note> <verse eid="LEV 27:28"/><verse number="29" style="v" sid="LEV 27:29"/>አሳ ግዶፐ ሻከቲደ ያናዳን እመቴዳ አሳይ ዎዘቶፖ፤ ሄ አሳይ ሀይቆ።<verse eid="LEV 27:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 27:30"/>“ ‘ቢታ አስራታይ ኡባይ ጋድያፐ ሞኬዳ ካ ግድና ዎይ ም አይፍያ ግድናካ መና ጎዳሳ። ሄዌ መና ጎዳዉ ጌሻ።<note caller="-" style="x"><char style="xo" closed="false">27:30-33 </char><char style="xt" closed="false"><ref loc="NUM 18:21">ፓይ. 18:21</ref>፤ <ref loc="DEU 14:22-29">ዛረ. 14:22-29</ref></char></note> <verse eid="LEV 27:30"/><verse number="31" style="v" sid="LEV 27:31"/>እት አሳይ ባረ አስራታ ዎዛናዉ ኮዮፐ፥ አ ጋትያ ቦላን ጼቱዋፐ ላታሙ ኩሽያ ጉጆ። <verse eid="LEV 27:31"/><verse number="32" style="v" sid="LEV 27:32"/>ሚዛ አስራታ ግድና፥ ዶርሳ አስራታ ግድና፥ ዎይ ዴሻ አስራታ ግድናካ፥ ሄንንቻ ጋትማፐ ጋርሳና አያ ሀቃዌነ ታሙን መና ጎዳዉ ጌሻ። <verse eid="LEV 27:32"/><verse number="33" style="v" sid="LEV 27:33"/>ታሙን መህያ ኢታ ግድና ሎኦ ግድናካ ዶሮፖ፤ ዎይ አ ሀራና ላሞፖ። ላሞፐነ ኮይሮዌነ ላምያ እሜዳዌነ ላኡካ ጾሳዉ ጌሻ ግዲኖፐ አትና፥ ዛሪደ ዎዛናዉ ዳንዳየና’ ያጋ” ያጌዳ።<verse eid="LEV 27:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LEV 27:34"/>ሲና ደርያ ቦላን መና ጎዳይ ሙሴ ባጋና እስራኤልያ አሳ አዛዜዳ አዛዞቱ ሀዋንታ።<verse eid="LEV 27:34"/></para>
  <chapter eid="LEV 27"/>
</usx>
