<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Dawuro Full Bible Ethiopic Version</book>
  <para style="h">1 ዮሃንሳ ኪታ</para>
  <para style="toc1">ዮሃንስ ጻፌዳ ኮይሮ ኪታ</para>
  <para style="toc2">1 ዮሃንሳ ኪታ</para>
  <para style="toc3">1 ዮሃ.</para>
  <para style="mt1">ዮሃንስ</para>
  <para style="mt2">ጻፌዳ ኮይሮ ኪታ</para>
  <para style="imt">ገሉዋ</para>
  <para style="ip">የሱስ ኪቴዳ ዮሃንስ ጻፌዳ ኮይሮ ኪታይ፥ ላኡ ሁጰ ቆፋቱዋ ኦይቄዳ፤ ሄዋንቱካ: ናባብያዋንቶ ጾሳናነ አ ናኣ የሱስ ክርስቶሳና እትፐተይ ደአናዳን መንናሳነ ሀ እትፐተ ይሳናዉ ዳንዳይያ ዎርዶ ትምርትያፐ ኡንቱንቱ ሃካና ማላ፥ ምንሲደ አኬክሳናሳ። ሄ ዎደ ደንዴዳ ዎርዶ ትምርቲ “ኢታተይ ፑልትያዌ ሀ ኑን ደእያ ዎልቃማ አላምያና ጋከትያ ጋከና ግድያ ድራዉ፥ ጾሳ ናአይ የሱስ ሙለካ አሳ ግዳናዉ ዎይ፥ አሳተ ኤሻይ አዉ ደአናዉ ዳንዳየና” ያግያዋ። ሄ አስታማራቱ፥ “አቶተ ጉሳይ አላምያ ደኦ ኡንኤትያዋፐ ላአ ከስያዋ” ያጊኖ። ሄዋ ቦላካ ቃይ “ኢታነ ኬካ ሻኪደ ኦይቂያዋ ዎይ፥ ሀራ አሳዉ ሲቁዋ በስያዋ ግዶፐካ፥ አቶተና ኡንቱንታ ጋያባይ ባዋ” ያጊኖ።</para>
  <para style="ip">ጻፊ ሀ ትምርትያ ኤቀቲደ፥ “የሱስ ክርስቶስ ፖሎ አሳ፤ የሱሳን አማንያዋንቱነ ጾሳ ሲቅያዋንቱ ኡባይ ባረንቱ ግዶንካ እቱ እቱዋና ሲቀታናዉ በሴ” ያጊደ ኦዴዳ።</para>
  <para style="iot">ሸምፓቱዋ ኡባቶ እመቴዳ ቃን ቆፋቱዋ</para>
  <para style="io1">ገሉዋ <char style="ior"><ref loc="1JN 1:1-4">1:1-4</ref></char></para>
  <para style="io1">ፖኡዋነ ማ <char style="ior"><ref loc="1JN 1:5-2:29">1:5—2:29</ref></char></para>
  <para style="io1">ጾሳ ናናነ ጻላህያ ናና <char style="ior"><ref loc="1JN 3:1-24">3:1-24</ref></char></para>
  <para style="io1">ቱሙዋነ ባለዋ <char style="ior"><ref loc="1JN 4:1-6">4:1-6</ref></char></para>
  <para style="io1">ሲቁዋ ኦሱዋ <char style="ior"><ref loc="1JN 4:7-21">4:7-21</ref></char></para>
  <para style="io1">ጾንያ አማኑዋ <char style="ior"><ref loc="1JN 5:1-21">5:1-21</ref></char></para>
  <chapter number="1" style="c" sid="1JN 1"/>
  <para style="s1">ደኡዋ ቃላ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1"/>ኑን ኮይሩዋፐ ዶሚደ ደእያ፥ ኑ አይፍያን በኢደ፥ ኑ ኩሽያን አ ቦች በኤዳ ደኡዋ ቃላባ ህንተንቶ ጻፌቶ። ኑን አ በኤዶ፤ ኑ ኩሺካ አ ቦች በኤዳ።<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="JHN 1:1">ዮሃ. 1:1</ref></char></note> <verse eid="1JN 1:1"/><verse number="2" style="v" sid="1JN 1:2"/>ሄ ደኡ ቆንጭና፥ ኑን አ በኢደ፥ አባ ህንተንቶ ማርካቴቶ፤ ቃይ ጾሳ አዉዋ ማታን ደእያ ኑዉ ቆንጬዳ መና ደኡዋባ ህንተንቶ ኦዴቶ።<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="JHN 1:14">ዮሃ. 1:14</ref></char></note> <verse eid="1JN 1:2"/><verse number="3" style="v" sid="1JN 1:3"/>ቃይ ኑናና ህንተንቶ እትፐተይ ደአና ማላ፥ ኑን በኤዳዋነ ስሴዳዋ ህንተንቶ ኦዴቶ፤ ኑዉ አዉዋናነ አ ናኣ የሱስ ክርስቶሳና እትፐተይ ደኤ። <verse eid="1JN 1:3"/><verse number="4" style="v" sid="1JN 1:4"/>ኑን ኑ ናሸቻይ ፖለታና ማላ፥ ሀዋ ህንተንቶ ጻፌቶ።<verse eid="1JN 1:4"/></para>
  <para style="s1">ጾሳይ ፖኡዋ</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5"/>ኑን ጾሳ ናኣፐ ስሲደ፥ ህንተንቶ ኦድያ ኪታይ፥ “ጾሳይ ፖኡዋ፤ አን ማይ ሙለካ ባዋ” ያግያዋ። <verse eid="1JN 1:5"/><verse number="6" style="v" sid="1JN 1:6"/>ኑን ኑዉ አናና እትፐተይ ደኤ ጊደ ማን ደኦፐ፥ ኑ ሃሳያንነ ኑ ኦሱዋን ዎርዶቴቶ። <verse eid="1JN 1:6"/><verse number="7" style="v" sid="1JN 1:7"/>ሽን ፖኡዋን እ ደእያዋዳን፥ ኑንካ ፖኡዋን ደኦፐ፥ ኑዉ እቶ እቱዋና እትፐተይ ደኤ፤ ቃይ አ ናኣ፥ የሱስ ክርስቶሳ ሱይ ናጋራ ኡባፐ ኑና ጌሼ።<verse eid="1JN 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8"/>ኑን ናጋራ ኦበይኮ ጎፐ፥ ኑረካ ኑና ጭሜቶ፤ ኑናን ቱማተይካ ባዋ። <verse eid="1JN 1:8"/><verse number="9" style="v" sid="1JN 1:9"/>ሽን ኑን ጾሳዉ ኑ ናጋራ ፓጾፐ፥ እ ኑ ናጋራ አቶ ጋናዉነ ኑ ባይዞ ኦሱዋ ኡባፐ ኑና ጌሻናዉ፥ አማነትያዋነ ቱሙዋ ኦያዋ። <verse eid="1JN 1:9"/><verse number="10" style="v" sid="1JN 1:10"/>ኑን ናጋራ ኦበይኮ ጎፐ፥ ጾሳ ዎርዱዋ ጌቶ፤ አ ቃላይካ ኑ ዎዛናን ደኤና።<verse eid="1JN 1:10"/></para>
  <chapter eid="1JN 1"/>
  <chapter number="2" style="c" sid="1JN 2"/>
  <para style="s1">ክርስቶስ ኑዉ ጋናትያዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1"/>ታ ናቶ፥ ናጋራ ህንተ ኦናዳን፥ ታን ሀዋ ህንተንቶ ጻፋይ፤ ሽን ኦንነ ናጋራ ኦፐ፥ አዉዋ ማታን ኑዉ ጋናትያ የሱስ ክርስቶስ፥ ጽሉ፥ ደኤ። <verse eid="1JN 2:1"/><verse number="2" style="v" sid="1JN 2:2"/>ቃይ ኑን ኑ ናጋራ አቶ ጌተቱሳ ክርስቶሳ ባጋና ደሜቶ፤ ክርስቶስ ያርሸቴዳዌ አሳ ኡባ ናጋራ ድጋናሳፐ አትን፥ ኑ ናጋራ ጻላላ ድጋናሳ ግደና።<verse eid="1JN 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3"/>ኑን ጾሳ አዛዙዋ ናጎፐ፥ ቱሙ አ ኤርያዋ ሄዋን ሻካናዉ ዳንዳዬቶ። <verse eid="1JN 2:3"/><verse number="4" style="v" sid="1JN 2:4"/>እት ኡራይ፥ “ታን አ ኤራይ” ጊደ፥ ቃይ አ አዛዙዋ ናገናን አጎፐ፥ ሄ ኡራይ ዎርዱዋ፤ ቱማተይካ አን ባዋ። <verse eid="1JN 2:4"/><verse number="5" style="v" sid="1JN 2:5"/>ሽን አ ቃላዉ አዛዘትያ ኦና ግዶፐነ፥ ሄ ኡራይ ጾሳ ሲቅያዌ ቱሙ ፖለቴዳ። ኑን ጾሳን ደእያዋ ሀዌ ኑና ኤርሴ። ሄዌካ፥ <verse eid="1JN 2:5"/><verse number="6" style="v" sid="1JN 2:6"/>“ታን፥ ጾሳን ደአይ” ግያ ኦንነ ክርስቶስ ደኤዳዋዳን ደአናዉ በሴ።<verse eid="1JN 2:6"/></para>
  <para style="s1">ኦራ አዛዙዋ</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7"/>ታ ሲቃቶ፥ ታን ህንተንቶ ኮይሩዋፐ ደእያ ኤጫ አዛዙዋ ጻፋይፐ አትን፥ ኦራ አዛዙዋ ጻፍከ፤ ሄ ኤጫ አዛዙ ህንተ ስሴዳ ቃላ።<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዮሃ. 13:34</ref></char></note> <verse eid="1JN 2:7"/><verse number="8" style="v" sid="1JN 2:8"/>ግዶፐካ፥ ታን ህንተንቶ ላኤንዋ ኦራ አዛዙዋ ጻፋይ፤ ሄ አዛዙዋ ቱማተይካ ክርስቶሳንነ ህንተናን ቤቴ። አያዉ ጎፐ፥ ማይ ዬ፤ ቱሙ ፖኡ ሀእ ፖኤ።<verse eid="1JN 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9"/>ፖኡዋን ደአይ ጊደ፥ ባረ እሻ እጽያ ኦንነ ሀኖ ጋካናዉካ ማን ደኤ። <verse eid="1JN 2:9"/><verse number="10" style="v" sid="1JN 2:10"/>ባረ እሻ ሲቅያ ኦንነ ፖኡዋን ደኤ፤ ሄ ኡራን ሀራ ኡራ ቢያባይ አያይነ ባዋ። <verse eid="1JN 2:10"/><verse number="11" style="v" sid="1JN 2:11"/>ሽን ባረ እሻ እጽያ ኦንነ ማን ደኤ፤ ማን ሀመቴ። ማይ አ አይፍያ ቆቅስ ዎዳ ድራዉ፥ ሀቃ ብንቶነ ኤረና።<verse eid="1JN 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1JN 2:12"/>ታ ናቶ፥ ጾሳይ ክርስቶሳ ሱን ድራዉ፥</para>
  <para style="q2" vid="1JN 2:12">ህንተ ናጋራ አቶ ያጌዳ ድራዉ፥</para>
  <para style="q2" vid="1JN 2:12">ታን ህንተንቶ ጻፋይ።<verse eid="1JN 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="1JN 2:13"/>አዋቶ፥ ኮይሩዋፐ ደእያዋ ህንተ ኤሬዳ ድራዉ፥</para>
  <para style="q2" vid="1JN 2:13">ህንተንቶ ጻፋይ።</para>
  <para style="q1" vid="1JN 2:13">ያላጋቶ፥</para>
  <para style="q2" vid="1JN 2:13">ጻላህያ ካፑዋ ህንተ ጾኔዳ ድራዉ፥</para>
  <para style="q2" vid="1JN 2:13">ህንተንቶ ጻፋይ።</para>
  <para style="q2" vid="1JN 2:13">ጉ ናቶ፥ ጾሳ አዉዋ ህንተ ኤሬዳ ድራዉ፥</para>
  <para style="q2" vid="1JN 2:13">ህንተንቶ ጻፋይ።<verse eid="1JN 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="1JN 2:14"/>አዋቶ፥ ኮይሩዋፐ ደእያዋ ህንተ ኤሬዳ ድራዉ፥</para>
  <para style="q2" vid="1JN 2:14">ህንተንቶ ጻፋይ።</para>
  <para style="q1" vid="1JN 2:14">ያላጋቶ፥</para>
  <para style="q2" vid="1JN 2:14">ህንተ ምኖ ግድያ ድራዉነ</para>
  <para style="q1" vid="1JN 2:14">ጾሳ ቃላይ ህንተናን ደእያ ድራዉ፥</para>
  <para style="q2" vid="1JN 2:14">ቃይ ጻላህያ ካፑዋ ህንተ ጾኔዳ ድራዉ፥</para>
  <para style="q2" vid="1JN 2:14">ህንተንቶ ጻፋይ።<verse eid="1JN 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15"/>ሀ አላምያ ዎይ አላምያን ደእያ አያነ ሲቆፕተ። ህንተ ሀ አላምያ ሲቆፐ፥ ጾሳ ሲቁ ህንተናን ባዋ። <verse eid="1JN 2:15"/><verse number="16" style="v" sid="1JN 2:16"/>አያዉ ጎፐ፥ ሀ አላምያን ደእያ ኡባባይ፥ ሄዌካ: አሳተ አሙ፥ አይፍያን ጼሊደ ካጄልያዌነ ባረ ደእያዋን ጬቀትያዌ ሀ አላምያፐ ዬዳዋፐ አትን፥ ጾሳፐ ይቤና። <verse eid="1JN 2:16"/><verse number="17" style="v" sid="1JN 2:17"/>ሀ አላሚነ ሀ አላምያን አሳይ አሞትያ ኡባባይ አና። ሽን ጾሳይ ጌዳዋ ኦያ ኡራይ መናዉ ደአና።<verse eid="1JN 2:17"/></para>
  <para style="s1">ክርስቶሳ ኤቀትያዋፐ ናገትያዋ</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18"/>ታ ናቶ፥ ዎድያ ዉርሰይ ማታቴዳ፤ ክርስቶሳ ኤቀትያዌ ስንፐ ያናዋ ህንተ ስሴዳዋዳን፥ ሀራይ አቶ ሀእካ አ ኤቀትያዋንቱ ጮራቱ ደንዴድኖ። ሄዋ ድራዉ፥ ዎድያ ዉርሰይ ማታቴዳዋ ኑን ሄዋን ኤሬቶ። <verse eid="1JN 2:18"/><verse number="19" style="v" sid="1JN 2:19"/>ሀ ኤቀትያዋንቱ ኑ ባጋ ግደና ድራዉ፥ ኑ ግዶፐ ከሴድኖ፤ አያዉ ጎፐ፥ ኡንቱንቱ ኑ ባጋ ግድያባ ግድንቶነ፥ ኑ ግዶን ደአና፤ ሽን ኡንቱንቱፐ ኦንነ ኑ ባጋ ግደናዌ ኤረታና ማላ፥ ኑ ግዶፐ ከሴድኖ።<verse eid="1JN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20"/>ሽን ክርስቶስ ህንተ ቦላ ጌሻ አያና ጉሴዳ፤ ቃይ ህንተ ኡባይ ቱሙዋ ኤሪታ። <verse eid="1JN 2:20"/><verse number="21" style="v" sid="1JN 2:21"/>ቱሙዋ ህንተ ኤርያ ድራዉነ ቃይ ቱሙዋን ዎርዱ አያይነ ባይናዋ ህንተ ኤርያ ድራዉ፥ ታን ህንተንቶ ጻፋይፐ አትን፥ ቱሙዋ ህንተ ኤረና ድራዉ ጻፍከ።<verse eid="1JN 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22"/>የሱስ ኦከቴዳ ክርስቶሳ ግድያዋ ኤርከ ግያ ኡራፐ አትን፥ ዎርዱ ኦኔ? ሄዌ ጾሳ አዉዋነ ናኣ ኤርከ ግያዌ ክርስቶሳ ኤቀትያዋ። <verse eid="1JN 2:22"/><verse number="23" style="v" sid="1JN 2:23"/>ጾሳ ናኣ ኤርከ ግያ ኦናነ ጾሳ አዉካ ኤረና፤ ጾሳ ናኣ ኤራይ ግያ ኦናነ ቃይ ጾሳ አዉካ ኤሬ።<verse eid="1JN 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24"/>ሄዋ ድራዉ፥ ኮይሩዋፐ ህንተ ስሴዳዋ ህንተ ዎዛናን ምንሲደ ናግተ። ኮይሩዋፐ ስሴዳዋ ህንተ ናጎፐ፥ ህንተንቶ ቃይ ጾሳ ናኣናነ ጾሳ አዉዋና እትፐተይ ደአና። <verse eid="1JN 2:24"/><verse number="25" style="v" sid="1JN 2:25"/>ቃይ ክርስቶስ ባረ ሁጰዉ ኑዉ እማና ጌዳዌ መና ደኡዋ።<verse eid="1JN 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26"/>ታን ሀዋ ህንተንቶ ሄ ህንተና ባለያ አሳቱዋ ድራዉ ጻፋድ። <verse eid="1JN 2:26"/><verse number="27" style="v" sid="1JN 2:27"/>ሽን ክርስቶስ ህንተ ቦላ ባረ ጌሻ አያና ጉሴዳ። ጌሻ አያናይ ህንተናን ደእያ ድራዉ፥ ኦንነ ህንተና ታማርሳና ኮሸና፤ አያዉ ጎፐ፥ አ ጌሻ አያናይ ህንተና ኡባባ ታማርሴ። እ ታማርስያዌ ቱሙዋፐ አትን ዎርዱዋ ግደና። ሄዋ ድራዉ አያና ጌሻ ትምርተዉ አዛዘቲደ፥ ክርስቶሳና እትፐተን ደእተ።<verse eid="1JN 2:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28"/>ታ ናቶ፥ ቃይ እ ቆንጭያ ዎደ፥ ኑን ያሽ ባይናዋንታ ግዳናዳንነ፥ አ ዩሳ ጋላስ አ ስንን ኑን ዬላተናዳን፥ አናና እትፐተን ደእተ። <verse eid="1JN 2:28"/><verse number="29" style="v" sid="1JN 2:29"/>ክርስቶስ ጽሎ ግድያዋ ህንተ ኤሮፐ፥ ጽሎባ ኦያ ኡባይ ጾሳ ናኣ ግድያዋ ኤራናዉ በሴ።<verse eid="1JN 2:29"/></para>
  <chapter eid="1JN 2"/>
  <chapter number="3" style="c" sid="1JN 3"/>
  <para style="s1">ጾሳ ናናቱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1"/>ኑን ጾሳ ናናቱዋ ጌተቲደ ጼሰታና ማላ፥ ጾሳይ ኑና አይ ኬና ሲቄደንቶነ በእተ። ኑን ቱሙካ አ ናናቱዋ። ሀ አላሚ ጾሳ ኤረና ድራዉ፥ ኑናካ ኤረና።<note caller="-" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="JHN 1:12">ዮሃ. 1:12</ref></char></note> <verse eid="1JN 3:1"/><verse number="2" style="v" sid="1JN 3:2"/>ታ ሲቃቶ፥ ሀእ ኑን ጾሳ ናናቱዋ፤ ኑን አያ ሀናነንቶ ብሮ ኤረትቤና፤ ሽን ክርስቶስ ቆንጭያ ዎደ፥ ኑን አ ማላታናዋ ኤሬቶ። አያዉ ጎፐ፥ እ ቱሙ አ ግድያዋ ኑን ኩመንን በአና። <verse eid="1JN 3:2"/><verse number="3" style="v" sid="1JN 3:3"/>ቃይ ክርስቶሳ በአና ጊደ ናሸቻን ናግያ ኦንነ ክርስቶስ ጌሻ ግዴዳዋዳን፥ ባረና ጌሼ።<verse eid="1JN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4"/>ናጋራ ኦያ ኡባይ ጾሳ ህግያ መን፤ አያዉ ጎፐ፥ ናጋራይ ጾሳ ህግያ መንሳ። <verse eid="1JN 3:4"/><verse number="5" style="v" sid="1JN 3:5"/>ክርስቶስ አሳ ናጋራ ይሳናዉ ቆንጬዳዋ ህንተ ኤሪታ፤ አን ናጋራይ ባዋ።<note caller="-" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="JHN 1:29">ዮሃ. 1:29</ref></char></note> <verse eid="1JN 3:5"/><verse number="6" style="v" sid="1JN 3:6"/>ክርስቶሳን ደእያ ኦንነ ናጋራ ኦደ ደኤና፤ ቃይ ናጋራ ኦደ ደእያ ኦንነ አ በእቤና ዎይ ኤርቤና።<verse eid="1JN 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7"/>ታ ናቶ፥ ኦንነ ህንተና ባለፖ። ክርስቶስ ጽሎ ግድያዋዳን፥ ጽሎባ ኦያ ኡራይ ጽሉዋ። <verse eid="1JN 3:7"/><verse number="8" style="v" sid="1JN 3:8"/>ጻላህያ ካፑ ኮይሩዋፐ ናጋራ ኦዳ ድራዉ፥ ናጋራ ኡባ ዎደ ኦያ ኡራይ ጻላህያ ካፑዋሳ፤ ሄዋ ድራዉ፥ ጾሳ ናአይ ጻላህያ ካፑዋ ኦሱዋ ይሳናዉ ቆንጬዳ። <verse eid="1JN 3:8"/><verse number="9" style="v" sid="1JN 3:9"/>ጾሳ ናናቱዋ ግድያ ኡባይ ጾሳ መታይ ኡንቱንቱን ደእያ ድራዉ፥ ናጋራ ኡባ ዎደ ኦክኖ፤ ቃይ ጾሳይ ኡንቱንቱ አዉዋ ግድያ ድራዉ፥ ናጋራ ኦናዉ ዳንዳይክኖ። <verse eid="1JN 3:9"/><verse number="10" style="v" sid="1JN 3:10"/>ጾሳ ናናቱ ግዱዋንነ ጻላህያ ካፑዋ ናናቱዋ ግዶን ደእያ ዱማተይ ሀዋን ኤረቴ፤ ጽሎባ ኦናዋንቱነ ዎይ ባረ እሻ ሲቀናዋንቱ ኦንነ ጾሳ ናናቱዋ ግድክኖ።<verse eid="1JN 3:10"/></para>
  <para style="s1">እቱ እቱዋና ሲቀትያዋ</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11"/>አያዉ ጎፐ፥ ኮይሩዋፐ ህንተ ስሴዳ ኪታይ፥ “እቱ እቱዋና ሲቀታናዉ በሴ” ያግያዋ።<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዮሃ. 13:34</ref></char></note> <verse eid="1JN 3:11"/><verse number="12" style="v" sid="1JN 3:12"/>ኑን ቃዬላ ማላ ግዳናዉ በሰና። ቃዬል ጻላህያ ካፑዋሳ፤ ሄዋ ግዶ ድራዉ፥ ባረ እሻ ዎዳ። እ ባረ እሻ አያዉ ዎዴ? እ ኦዳ ኦሱ ኢታ ግድና፥ አ እሻይ ኦዳ ኦሱ ሎአ ግዴዳ ድራዉ ዎዳ።<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="GEN 4:8">ዶመ 4:8</ref></char></note><verse eid="1JN 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13"/>ታናዳን ጾሳ ካልያዋንቶ፥ ሀ ሳኣ አሳይ ህንተና እጾፐ፥ ኦራባ ጎፕተ። <verse eid="1JN 3:13"/><verse number="14" style="v" sid="1JN 3:14"/>ኑን አማንያዋንታ ሲቅያ ድራዉ፥ ሀይቁዋፐ ደኦ ፕኔዳዋ ኤሬቶ፤ አማንያዋንታ ሲቀና ኡራይ ኦንነ ሀይቁዋ ግዶን ደኤ። <verse eid="1JN 3:14"/><verse number="15" style="v" sid="1JN 3:15"/>አማንያዋንታ እጽያ ኦንነ ሸምፑዋ ዎዳዋ፤ ቃይ ሸምፑዋ ዎዳዋን መና ደኡ ባይናዋ ህንተ ኤሪታ። <verse eid="1JN 3:15"/><verse number="16" style="v" sid="1JN 3:16"/>ክርስቶስ ባረ ሸምፑዋ ኑ ድራዉ አደ እሜዳዋን ሲቁ አየንቶ ኑን ኤሬዶ፤ ኑንካ አማንያዋንቱ ድራዉ፥ ኑ ሸምፑዋ አደ እማናዉ በሴ። <verse eid="1JN 3:16"/><verse number="17" style="v" sid="1JN 3:17"/>ሽን ዱረ አሳይ ኦንነ ባረ እሻይ መቶትያዋ በኢደ፥ አዉ ቃረተናን እጾፐ፥ ባረ ዎዛናን ጾሳ ሲቃይ ጋናዉ ዋን ዳንዳዪ? <verse eid="1JN 3:17"/><verse number="18" style="v" sid="1JN 3:18"/>ታ ናቶ፥ ኑን ኦሱዋንነ ቱማተን ሲቀቶይተፐ አትን፥ ጮ ሃሳያን ዎይ ቦላ ዶናን ሲቀታናዉ በሰና።<verse eid="1JN 3:18"/></para>
  <para style="s1">ጾሳ ስንን አማነቲደ ኤቂያዋ</para>
  <para style="p">
    <verse number="19-20" style="v" sid="1JN 3:19-20"/>ኑን ቱሙዋ ባጋን ደእያዋ ሄዋን ኤራና፤ ቃይ ኑ ዎዛናይ ኑ ቦላ ፕርድያ ዎደ ኡባን፥ ጾሳ ስንን ቱማተ ኑና ሄዋን ኤርሴ። አያዉ ጎፐ፥ ጾሳይ ኑ ዎዛናፐ ዎልቃማ፤ ቃይ እ ኡባባ ኤሬ።<verse eid="1JN 3:19-20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 3:21"/>ታ ሲቃቶ፥ ኑ ዎዛናይ ኑ ቦላ ፕርደናዋ ግዶፐ፥ ኑን ጾሳ ስንን ያዮኮ። <verse eid="1JN 3:21"/><verse number="22" style="v" sid="1JN 3:22"/>ኑን አ አዛዙዋ ናግያ ድራዉነ አ ናሸችያባ ኦያ ድራዉ፥ ዎስያ ኡባባ አፐ አኬቶ። <verse eid="1JN 3:22"/><verse number="23" style="v" sid="1JN 3:23"/>ጾሳ አዛዙ ሀዋ: ክርስቶስ ኑና አዛዜዳዋዳንካ፥ ጾሳ ናኣ የሱስ ክርስቶሳ ሱንን ኑን አማናናዳንነ እቱ እቱዋና ሲቀታናዳን ጾሳይ ኑና አዛዜዳ። <verse eid="1JN 3:23"/><verse number="24" style="v" sid="1JN 3:24"/>ጾሳ አዛዙዋ ናግያ ኦንነ ጾሳ ግዶን ደኤ፤ ጾሳይካ አ ግዶን ደኤ፤ ጾሳይ ኑዉ እሜዳ አ አያና ባጋና እ ኑ ግዶን ደእያዋ ኑን ኤሬቶ።<verse eid="1JN 3:24"/></para>
  <chapter eid="1JN 3"/>
  <chapter number="4" style="c" sid="1JN 4"/>
  <para style="s1">ቱማንቻ አያናነ ዎርዶ አያና</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1"/>ታ ሲቆቶ፥ ጾሳ አያናይ ታናን ደኤ ግያ ኡባ አማኖፕተ፤ ሽን ኡንቱንቱን ደእያ አያናይ ጾሳፔየ ዎይ ግደነንቶ ፓጭተ። አያዉ ጎፐ፥ ጮራ ዎርዶ ናባቱ ኡባሳ ቤድኖ። <verse eid="1JN 4:1"/><verse number="2" style="v" sid="1JN 4:2"/>ጾሳ አያና ግድያዋ ህንተ ሀዋን ኤራና፤ “የሱስ ክርስቶስ አሳ ግዲደ ዬዳዋ አማናይ” ግያ ኦናንነ ደእያ አያናይ ኡባይ ጾሳፐ ዬ። <verse eid="1JN 4:2"/><verse number="3" style="v" sid="1JN 4:3"/>ቃይ ክርስቶስ አሳ ግዲደ ዬዳዋ አማናይ ጌናዋ አያናይ ኡባይ ጾሳፐ ይቤና፤ አን ክርስቶሳ ኤቀትያ አያናይ ደኤ። ህንተ ሄዌ ያናዋ ካሰ ስሴድታ፤ እ ሀራይ አቶ ሀእካ ሀ አላምያን ደኤ።<verse eid="1JN 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4"/>ታ ናቶ፥ ህንተ ጾሳዋንታ፤ ህንተ ግዶን ደእያ ጌሻ አያናይ ሀ አላምያን ደእያ አያናፐ ዳሮ ዎልቃምያ ድራዉ፥ ዎርዶ ናባቱዋ ህንተ ጾኔድታ። <verse eid="1JN 4:4"/><verse number="5" style="v" sid="1JN 4:5"/>ኡንቱንቱ ሀ አላምያ አሳ ግድያ ድራዉ፥ ሀ አላምያባ ሃሳዪኖ፤ ሀ አላምያ አሳይካ ኡንቱንቱ ሃሳያ ስሴ። <verse eid="1JN 4:5"/><verse number="6" style="v" sid="1JN 4:6"/>ኑን ጾሳዋንታ፤ ጾሳ ኤርያ ኦንነ ኑን ግያዋ ስሴ። ጾሳ ኤረና ኦንነ ኑን ግያዋ ስሰና። ኑን ቱሙ አያናነ ዎርዶ አያና ሄዋን ሻኬቶ።<verse eid="1JN 4:6"/></para>
  <para style="s1">ጾሳይ ሲቁዋ</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7"/>ታ ሲቃቶ፥ ሲቁ ጾሳፐ ይያ ድራዉ፥ አነ እቱ እቱዋና ሲቀቶይተ። ሲቀትያ ኦንነ ጾሳ ናና፤ ጾሳካ ኤሪኖ። <verse eid="1JN 4:7"/><verse number="8" style="v" sid="1JN 4:8"/>ጾሳ ኤሻይ ሲቆ ግድያ ድራዉ፥ ሲቀና ኡራይ ኦንነ ጾሳ ኤረና። <verse eid="1JN 4:8"/><verse number="9" style="v" sid="1JN 4:9"/>ጾሳይ ኑና ባረ ሲቁዋ ሀዋን በሴዳ፤ ኑን አ ባጋና ደኡዋ ደማና ማላ፥ ባረ እት ናኣ ሀ አላምያ ኪቴዳ። <verse eid="1JN 4:9"/><verse number="10" style="v" sid="1JN 4:10"/>ሲቁዋ ግያዌ ሀዋ፤ ጾሳይ ኑና ሲቂደ፥ ኑን ኑ ናጋራፐ ማሮተ ደሜዳ ባረ ናኣ ኑዉ ኪቴዳፐ አትን፥ ኑን አ ሲቄዳዋና ግደና።<verse eid="1JN 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11"/>ታ ሲቆቶ፥ ጾሳይ ኑና ሀዋዳን ሲቄዳዋ ግዶፐ፥ ኑንካ እቱ እቱዋና ሲቀታናዉ በሴ። <verse eid="1JN 4:11"/><verse number="12" style="v" sid="1JN 4:12"/>ጾሳ ኦንነ ሙለካ በእቤና፤ ኑን እቱ እቱዋና ሲቀቶፐ፥ ጾሳይ ኑ ግዶን ደኤ፤ አ ሲቁካ ኑ ግዶን ፖለቴዳ።<verse eid="1JN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13"/>ጾሳይ ባረ አያና ኑዉ እሜዳ ድራዉ፥ ኑን ጾሳ ግዶን ደእያዋነ እካ ኑ ግዶን ደእያዋ ኤሬቶ። <verse eid="1JN 4:13"/><verse number="14" style="v" sid="1JN 4:14"/>ጾሳ አዉ ባረ ናኣ ሀ አላምያ አሽያዋ ግዳናዉ ኪቴዳዋ ኑን በኢደ ማርካቴቶ። <verse eid="1JN 4:14"/><verse number="15" style="v" sid="1JN 4:15"/>የሱስ ጾሳ ናኣ ግድያዋ ማርካትያ ኦ ግዱዋንነ ጾሳይ ደኤ፤ እካ ጾሳ ግዶን ደኤ። <verse eid="1JN 4:15"/><verse number="16" style="v" sid="1JN 4:16"/>ጾሳይ ኑና ሲቅያዋ ኑን ኑ ሁጰዉ ኤሬቶነ አማኔቶ።</para>
  <para style="p" vid="1JN 4:16">ጾሳይ ሲቁዋ። ሲቁዋን ደእያ ኦንነ ጾሳ ግዶን ደኤ፤ ጾሳይካ አ ግዶን ደኤ። <verse eid="1JN 4:16"/><verse number="17" style="v" sid="1JN 4:17"/>ኑ ደኡ ሀ አላምያን ክርስቶስ ደኤዳዋ ማላ ግድያ ድራዉ፥ ፕርዳ ጋላስ ኑን ያየና ማላ፥ ሲቁ ኑ ግዶን ፖለቴዳ። <verse eid="1JN 4:17"/><verse number="18" style="v" sid="1JN 4:18"/>ሲቁዋን ያሽ ባዋ፤ ጋሱካ ቱሙ ሲቁ ያሻ ከስ ኦሌ። ያሻይነ ሙራይ እትፐ ብያ ድራዉ፥ ያይያ ኡራ ሲቁ ኩመን ግደና።<verse eid="1JN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19"/>ጾሳይ ኮይሮ ኑና ሲቄዳ ድራዉ፥ ኑን አ ሲቄዶ። <verse eid="1JN 4:19"/><verse number="20" style="v" sid="1JN 4:20"/>ኦንነ፥ “ታን ጾሳ ሲቃይ” ጊደ ባረ እሻ እጾፐ፥ እ ዎርዱዋ። አያዉ ጎፐ፥ በኤዳ ባረ እሻ ሲቀናዌ በእቤና ጾሳ ሲቃናዉ ዋን ዳንዳዪ? <verse eid="1JN 4:20"/><verse number="21" style="v" sid="1JN 4:21"/>ቃይ ክርስቶስ ኑዉ እሜዳ አዛዙ ሀዋ፤ ጾሳ ሲቅያ ኡራይ ባረ እሻካ ሲቃናዉ በሴ።<verse eid="1JN 4:21"/></para>
  <chapter eid="1JN 4"/>
  <chapter number="5" style="c" sid="1JN 5"/>
  <para style="s1">ሀ አላምያ ጾንያዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1"/>ኦከቴዳ ክርስቶሳ ያጊደ፥ የሱሳ አማንያ ኡባይ ጾሳ ናና፤ ቃይ ጾሳ አዉዋ ሲቅያ ኦንነ አ ናናቱዋካ ሲቄ። <verse eid="1JN 5:1"/><verse number="2" style="v" sid="1JN 5:2"/>ኑን ጾሳ ሲቅያዋንነ አ አዛዙዋ ናግያዋን፥ ጾሳ ናናቱዋ ሲቅያዋ ኤሬቶ። <verse eid="1JN 5:2"/><verse number="3" style="v" sid="1JN 5:3"/>አያዉ ጎፐ፥ ኑን ጾሳ ሲቅያዌ አ አዛዙዋ ናግያዋ፤ አ አዛዙካ ዴጾ ግደና። <verse eid="1JN 5:3"/><verse number="4" style="v" sid="1JN 5:4"/>አያዉ ጎፐ፥ ጾሳ ናኣ ግድያ ኦንነ ሀ አላምያ ጾናናዉ ዳንዳዬ፤ ኑንካ ሀ አላምያ ጾናናዌ ኑ አማኑዋና። <verse eid="1JN 5:4"/><verse number="5" style="v" sid="1JN 5:5"/>ሀ አላምያ ጾናናዉ ዳንዳይያዌ ኦኔ? የሱስ ጾሳ ናኣ ግድያዋ አማንያዋ ጻላላይ ጾናና።<verse eid="1JN 5:5"/></para>
  <para style="s1">ክርስቶሳዋ ማርካቴዳዋ</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6"/>ጽንቃታ ሃናነ ሀይቁዋ ሱና ዬዳዌ ሀዋ፤ እካ የሱስ ክርስቶሳ፤ ሃናነ ሱና<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="fk" closed="false">ሃናነ ሱና፦ </char><char style="ft" closed="false">የሱስ ሀ አላምያ ዪደ ጽንቃታ ሃ ጻላላና ግደናን ባረ ሀይቁዋ ሱን ዬዳ። ሄዋ ጉሳይ እ አሳ ኩሽያን ጻማቀቱሳ ጻላላ ግደናን፥ ሀ አላምያን ሀይቄዳ ጉሳ።</char></note> እ ዬዳዋፐ አትን፥ ሃ ጻላላና ይቤና። ጌሻ አያናይ ቱማ ግድያ ድራዉ፥ ሄዌ ቱማ ግድያዋ እ ባረ ሁጰዉ ማርካቴ። <verse eid="1JN 5:6"/><verse number="7" style="v" sid="1JN 5:7"/>አያዉ ጎፐ፥ ሄዙ ማርካቱ ደኢኖ። <verse eid="1JN 5:7"/><verse number="8" style="v" sid="1JN 5:8"/>ሄዋንቱ፥ ጾሳ አያና፥ ሃነ ሱ፤ ሀ ሄዛቱ እቱ እቱዋዋ ጳልቂክኖ። <verse eid="1JN 5:8"/><verse number="9" style="v" sid="1JN 5:9"/>ኑን አሳይ ማርካትያዋ አማኖፐ፥ ጾሳይ ማርካትያዌ አሳዋፐ ሎይ አ፤ አያዉ ጎፐ፥ ጾሳይ ባረ ናኣባ ማርካቴዳ ማርካተይ ሀዋ። <verse eid="1JN 5:9"/><verse number="10" style="v" sid="1JN 5:10"/>ጾሳ ናኣ አማንያ ኡራ ዎዛናን ሀ ማርካተይ ደኤ። ጾሳ አማነና ኡራይ ኦንነ ጾሳይ ባረ ናአዉ ማርካቴዳ ማርካተ አማንቤና ድራዉ፥ ጾሳ ዎርዱዋ ጌ።<verse eid="1JN 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 5:11"/>ስም ማርካተይ ሀዋ፤ ጾሳይ ኑዉ መና ደኡዋ እሜዳ፤ ሄዌካ አ ናኣን ደኤ። <verse eid="1JN 5:11"/><verse number="12" style="v" sid="1JN 5:12"/>ጾሳ ናአይ ደእያ ኦስነ ደኡ ደኤ፤ ጾሳ ናአይ ባይና ኦስነ ደኡ ባዋ።<verse eid="1JN 5:12"/></para>
  <para style="s1">መና ደኡዋ</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13"/>ጾሳ ናኣ ሱንን አማንያ ህንተንቶ መና ደኡ ደእያዋ ህንተ ኤራና ማላ፥ ሀዋ ህንተንቶ ጻፋድ። <verse eid="1JN 5:13"/><verse number="14" style="v" sid="1JN 5:14"/>ጾሳይ ኮይያዋዳን፥ አይነ ኑን አ ዎሶፐ፥ እ ስስያዋ ኑን ኤርያ ድራዉ፥ አ ስንን ያዮኮ። <verse eid="1JN 5:14"/><verse number="15" style="v" sid="1JN 5:15"/>ኑን ዎስያ ኡባን እ ስስያዋ ኤሮፐ፥ ኑን አ ዎሴዳዋ እ ዛሬዳዋ ኤሬቶ።<verse eid="1JN 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16"/>ኦንነ ሀይቁ በሰና ናጋራ ባረ እሻይ ኦሽን በኦፐ፥ ጾሳ ዎሳናዉ በሴ፤ ሀይቁ በሰና ናጋራ ኦዳዋንቶ ጾሳይ ደኡዋ እማና። ሀይቁ በስያ ናጋራይ ደኤ፤ ታን ህንተና ሄዎ ጾሳ ዎስተ ጊከ። <verse eid="1JN 5:16"/><verse number="17" style="v" sid="1JN 5:17"/>ባይዞ ኦሱ ኡባይ ናጋራ፤ ሽን ሀይቁ በሰና ናጋራይ ደኤ።<verse eid="1JN 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18"/>ጾሳ ናናይ ኦንነ ናጋራ ኡባ ዎደ ኦናዋ ኑን ኤሬቶ። አያዉ ጎፐ፥ ጾሳ ናአይ ኡንቱንታ ናጌ፤ ቃይ ጻላህያ ካፑካ ኡንቱንታ ቆሀናዉ ዳንዳየና። <verse eid="1JN 5:18"/><verse number="19" style="v" sid="1JN 5:19"/>ኑን ጾሳዋንታ ግድያዋነ ሀ አላሚ ኡባይ ጻላህያ ካፑዋን ሞደቴዳዌ ኤሬቶ።<verse eid="1JN 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20"/>ኑን ቱሙ ጾሳ ኤራናዳን፥ ጾሳ ናአይ ዬዳዋነ ኑዉ አኬካ እሜዳዋ ኤሬቶ። ኑን ቱሙ ጾሳ ግዶን፥ አ ናኣ የሱስ ክርስቶሳ ግዶን ደኤቶ፤ እ ቱሙ ጾሳነ መና ደኡዋ።<verse eid="1JN 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21"/>ታ ናቶ፥ ኤቃቱዋፐ ህንተ ሁጲያ ናግተ።<verse eid="1JN 5:21"/></para>
  <chapter eid="1JN 5"/>
</usx>
