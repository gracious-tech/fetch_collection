<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EZR" style="id">- Dawuro Full Bible Ethiopic Version</book>
  <para style="h">እዝራ</para>
  <para style="toc1">እዝራ ማጻፋ</para>
  <para style="toc2">እዝራ</para>
  <para style="toc3">እዝራ</para>
  <para style="mt1">እዝራ ማጻፋ</para>
  <para style="imt">ገሉዋ</para>
  <para style="ip">እዝራ ማጻፋይ ሀኔዳዋ ኦድያ ላኡ ማጻፋቱዋ ካልያዋ። ሀ ማጻፋይ አይሁዳቱዋፐ ኦሞደቲደ ቤዳ አማሬዳ አሳቱ ባብሎነፐ ስሜዳዋነ የሩሳላመን አሳዉ ደኡካ ጎይኑካ ኦራጼዳዋ ኦዴ። ሀ ሀኖታቱ ሀዋፐ ካሊደ ጻፈቴድኖ።</para>
  <para style="ili">1. ኦሞዱዋን ቤዳ አይሁዳቱዋፐ ፓርሰ ካትያ ቂሮሳ ሸንያን ኮይሮ ስምያዋንቱ ባብሎናፐ ስሜድኖ።</para>
  <para style="ili">2. ጌሻ ጎሊ ዛሬ ኬጸቲደ አንጀቴዳ። ጾሳዉ ጎይናይካ ዛሬ ዶመቴዳ።</para>
  <para style="ili">3. እት አማሬዳ ዎድያፐ ስሚደ፥ ጾሳ ህግያ ሎይደ ኤርያ እዝር ካለና፥ ሀራ አይሁዳቱ የሩሳላመ ስሜድኖ። እዝር እስራኤልያ አሳ አያና ደኡዋ ካሰ ሳኣ ዛራናዉ፥ አሳይ አያና ደኡዋነ እትፐተ ደኡዋ ዎ የጊደ ምንሳናዳን ማዴዳ።</para>
  <para style="iot">ሸምፓቱዋ ኡባቶ እመቴዳ ቃን ቆፋቱዋ</para>
  <para style="io1">ኦሞዱዋፐ ኮይሮ ስሙዋ <char style="ior"><ref loc="EZR 1:1-2:70">1:1—2:70</ref></char></para>
  <para style="io1">ጌሻ ጎልያ ዛረ ኬጻነ አንጁዋ <char style="ior"><ref loc="EZR 3:1-6:22">3:1—6:22</ref></char></para>
  <para style="io1">እዝር ሀራ ኦሞደቴዳዋንቱና ስሙሳ <char style="ior"><ref loc="EZR 7:1-10:44">7:1—10:44</ref></char></para>
  <chapter number="1" style="c" sid="EZR 1"/>
  <para style="ms">ኦሞዱዋፐ ኮይሮ ስሙዋ</para>
  <para style="mr">(<ref loc="EZR 1:1-2:70">1:1—2:70</ref>)</para>
  <para style="s1">አይሁዳ አሳይ ባረንቱ ቢታ ስማና ማላ ቂሮስ አዋዬዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 1:1"/>ፓርሰ ካቲ ቂሮስ ካተቴዳ ኮይሮ ላይን፥ ትምቢትያ ኦድያ ኤርማሳ ባጋና መና ጎዳይ ሃሳዬዳዋ ፖሌዳ። ፓርሰ ካቲ ቂሮስ ባረ ካዉተ ግዶን ኡባ ሳን ሀዋዳን ያጊደ አዋያናዳንነ ጻፊደ ዎናዳን መና ጎዳይ አ አያና ደንዳ፤<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="JER 25:11">ኤር. 25:11</ref>፤ <ref loc="JER 29:10">29:10</ref></char></note> <verse eid="EZR 1:1"/><verse number="2" style="v" sid="EZR 1:2"/>“ፓርሰ ካቲ ቂሮስ ሀዋዳን ያጌ፤ ‘መና ጎዳይ ሳሉዋ ጾሳይ ሳኣ ካዉተቱዋ ኡባ ታዉ እሜዳ፤ ቃይ ይሁዳን ደእያ የሩሳላመን ታን አዉ ጌሻ ጎልያ ኬጻናዳን ታና ሱንዳ።<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ISA 44:28">ኢሳ. 44:28</ref></char></note> <verse eid="EZR 1:2"/><verse number="3" style="v" sid="EZR 1:3"/>ጾሳ አሳ ግዴዳ ኦንነ ያ ቦ። አ ጾሳይ አናና ግዶ! ህንተንቱ ይሁዳን ደእያ የሩሳላመ ቢደ፥ ያን የሩሳላመን ደእያ መና ጎዳ፥ እስራኤልያ ጾሳ ጌሻ ጎልያ ዛረደ ኬጽተ። <verse eid="EZR 1:3"/><verse number="4" style="v" sid="EZR 1:4"/>ዱማ ዱማ ቢታን ደእያ አሳይ ኡባይ አይሁዳቱዋፐ አቴዳዋንቱ ብራ፥ ዎርቃ፥ ዱማ ዱማ ሚሻቱዋነ መህያ እሚደ ማድኖ፤ ቃይ የሩሳላመን ደእያ ጾሳ ጎለውካ ባረንቱ ሸንያን እምያ እሞታ እምኖ’ ያጌዳ” ያጌ።<verse eid="EZR 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 1:5"/>ሄዋፐ ጉይያን፥ ይሁዳ ዛራቱነ ቢንያማ ዛራቱዋ ካፓቱ፥ ቄሳቱ ነ ሌዋቱ፥ ቃይ ጾሳይ ኡንቱንቱ ዎዛና ደንዳ ኡባቱ የሩሳላመን መና ጎዳ ጎልያ ኬጻናዉ ባናዉ ደንዴድኖ። <verse eid="EZR 1:5"/><verse number="6" style="v" sid="EZR 1:6"/>ቃይ ኡንቱንቱ ሾሩዋን ደእያዋንቱካ ባረንቱ ሸንያን እሜዳዋ ቦላ ጉጂደ፥ ብራ ሚሻነ ዎርቃ ሻሉዋ፥ ሀራ ዱማ ዱማ ሚሻቱዋነ መህያ እሚደ፥ ኡንቱንታ ማዴድኖ። <verse eid="EZR 1:6"/><verse number="7" style="v" sid="EZR 1:7"/>ሄዋ ቦላካ ቃይ ካቲ ቂሮስ ናቡካዳናጾረ የሩሳላመፐ አፊደ ባረ ጾሳቱዋ ጎለን ዎዳ መና ጎዳ ጎልያ ሚሻቱዋ እሜዳ። <verse eid="EZR 1:7"/><verse number="8" style="v" sid="EZR 1:8"/>ፓርሰ ካቲ ቂሮስ ሚሻቱዋ ዎያ ጎልያ ካፑዋ ምትረዳታን ከስሲድነ ፓይድሲደ፥ ይሁዳ ሞድያ ሸሽባጻራ ኩሽያን ሼዳ። <verse eid="EZR 1:8"/><verse number="9" style="v" sid="EZR 1:9"/>ስሜዳ ሚሻ ፓይዱ ሀዋ: ሀታሙ ዎርቃ ሳነቱዋ፥ እት ሻአ ብራ ሳነቱዋ፥ ላታማነ ኡዱፑን ጎሎዶቱዋ፥ <verse eid="EZR 1:9"/><verse number="10" style="v" sid="EZR 1:10"/>ዎርቃፐ ኦሰቴዳ ሀታሙ ሚሻቱዋ፥ ብራፐ ኦሰቴዳ ኦይዱ ጼታነ ታሙ ሚሻቱዋነ እት ሻአ ሀራ ዱማ ዱማ ሚሻቱዋ። <verse eid="EZR 1:10"/><verse number="11" style="v" sid="EZR 1:11"/>ዎርቃ ሚሻቱነ ብራ ሚሻ ፓይዱ ኡባና እቼሹ ሻአነ ኦይዱ ጼታ፤ ሀ ሚሻቱዋ ኡባ ኦሞዱዋን ቤዳ አሳይ ባብሎነፐ የሩሳላመ ስምያ ዎደ ሸሽባጻር አኪደ ዬዳ።<verse eid="EZR 1:11"/></para>
  <chapter eid="EZR 1"/>
  <chapter number="2" style="c" sid="EZR 2"/>
  <para style="s1">ኦሞዱዋፐ ስሜዳ እስራኤልያ አሳ ፓይዱዋ</para>
  <para style="r">(<ref loc="NEH 7:4-73">ናህ. 7:4-73</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 2:1"/>ባብሎነ ካቲ ናቡካዳናጾረ ኦሞዲደ፥ ባረ ጋድያ አፌዳ አሳፐ ፑደ ባረንቱ ካታማ ካታማ፥ የሩሳላመነ ይሁዳ ስሜዳ አሳቱ ሀዋፐ ካልያዋንታ። <verse eid="EZR 2:1"/><verse number="2" style="v" sid="EZR 2:2"/>ኡንቱንቱ ዛሩባቤላ፥ ኢያሳ፥ ናህምያ፥ ሳራያ፥ ራኤላያ፥ ማርድክዮሳ፥ ብልሻና፥ ምስፓራ፥ ብግዋያ፥ ረሁማነ ባኣና።</para>
  <para style="p" vid="EZR 2:2">ኦሞዱዋፐ ስሜዳ እስራኤልያ አሳ ፓይዱ ሀዋ።<verse eid="EZR 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 2:3"/>ፓርኦሻ ያራቱ 2,172.<verse eid="EZR 2:3"/></para>
  <para style="m">
    <verse number="4" style="v" sid="EZR 2:4"/>ሻፋጽያ ያራቱ 372.<verse eid="EZR 2:4"/></para>
  <para style="m">
    <verse number="5" style="v" sid="EZR 2:5"/>አራሀ ያራቱ 775.<verse eid="EZR 2:5"/></para>
  <para style="m">
    <verse number="6" style="v" sid="EZR 2:6"/>ኢያሱነ ዮኣባ ናና ግድያ ፓሀት-ሞኣባ ያራቱ 2,812.<verse eid="EZR 2:6"/></para>
  <para style="m">
    <verse number="7" style="v" sid="EZR 2:7"/>ኤላማ ያራቱ 1,254.<verse eid="EZR 2:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="EZR 2:8"/>ዛቱ ያራቱ 945.<verse eid="EZR 2:8"/></para>
  <para style="m">
    <verse number="9" style="v" sid="EZR 2:9"/>ዛካያ ያራቱ 760.<verse eid="EZR 2:9"/></para>
  <para style="m">
    <verse number="10" style="v" sid="EZR 2:10"/>ባና ያራቱ 642.<verse eid="EZR 2:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="EZR 2:11"/>በባያ ያራቱ 623.<verse eid="EZR 2:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="EZR 2:12"/>አዝጋዳ ያራቱ 1,222.<verse eid="EZR 2:12"/></para>
  <para style="m">
    <verse number="13" style="v" sid="EZR 2:13"/>አዶንቃማ ያራቱ 666.<verse eid="EZR 2:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="EZR 2:14"/>ብግዋያ ያራቱ 2,056.<verse eid="EZR 2:14"/></para>
  <para style="m">
    <verse number="15" style="v" sid="EZR 2:15"/>አዲና ያራቱ 454.<verse eid="EZR 2:15"/></para>
  <para style="m">
    <verse number="16" style="v" sid="EZR 2:16"/>ህዝቂያሳ ያራ ግድያ አጼራ ያራቱ 98.<verse eid="EZR 2:16"/></para>
  <para style="m">
    <verse number="17" style="v" sid="EZR 2:17"/>በጻያ ያራቱ 323.<verse eid="EZR 2:17"/></para>
  <para style="m">
    <verse number="18" style="v" sid="EZR 2:18"/>ዮራ ያራቱ 112.<verse eid="EZR 2:18"/></para>
  <para style="m">
    <verse number="19" style="v" sid="EZR 2:19"/>ሀሹማ ያራቱ 223.<verse eid="EZR 2:19"/></para>
  <para style="m">
    <verse number="20" style="v" sid="EZR 2:20"/>ግባራ ያራቱ 95.<verse eid="EZR 2:20"/></para>
  <para style="m">
    <verse number="21" style="v" sid="EZR 2:21"/>ቤተሌመ አሳይ 123.<verse eid="EZR 2:21"/></para>
  <para style="m">
    <verse number="22" style="v" sid="EZR 2:22"/>ናጾፋ ካታማ አሳይ 56.<verse eid="EZR 2:22"/></para>
  <para style="m">
    <verse number="23" style="v" sid="EZR 2:23"/>አናቶታ ካታማ አሳይ 128.<verse eid="EZR 2:23"/></para>
  <para style="m">
    <verse number="24" style="v" sid="EZR 2:24"/>አዝማዌታ ካታማ አሳይ 42.<verse eid="EZR 2:24"/></para>
  <para style="m">
    <verse number="25" style="v" sid="EZR 2:25"/>ቅርያት-ይኣሪማ፥ ካፊራነ ባኤሮታ ካታማቱዋ አሳይ 743.<verse eid="EZR 2:25"/></para>
  <para style="m">
    <verse number="26" style="v" sid="EZR 2:26"/>ራማነ ገባአ ካታማቱዋ አሳይ 621.<verse eid="EZR 2:26"/></para>
  <para style="m">
    <verse number="27" style="v" sid="EZR 2:27"/>ምክማሳ ካታማ አሳይ 122.<verse eid="EZR 2:27"/></para>
  <para style="m">
    <verse number="28" style="v" sid="EZR 2:28"/>ቤቴለነ አታ ካታማቱዋ አሳይ 223.<verse eid="EZR 2:28"/></para>
  <para style="m">
    <verse number="29" style="v" sid="EZR 2:29"/>ናቦ ካታማ አሳይ 52.<verse eid="EZR 2:29"/></para>
  <para style="m">
    <verse number="30" style="v" sid="EZR 2:30"/>ማግቢሻ ካታማ አሳይ 156.<verse eid="EZR 2:30"/></para>
  <para style="m">
    <verse number="31" style="v" sid="EZR 2:31"/>ላኤን ኤላማ ካታማ አሳይ 1,254.<verse eid="EZR 2:31"/></para>
  <para style="m">
    <verse number="32" style="v" sid="EZR 2:32"/>ሀሪማ ካታማ አሳይ 320.<verse eid="EZR 2:32"/></para>
  <para style="m">
    <verse number="33" style="v" sid="EZR 2:33"/>ሎዳ፥ ሀዲዳነ ኦኖ ካታማቱዋ አሳይ 725.<verse eid="EZR 2:33"/></para>
  <para style="m">
    <verse number="34" style="v" sid="EZR 2:34"/>እያርኮ ካታማ አሳይ 345.<verse eid="EZR 2:34"/></para>
  <para style="m">
    <verse number="35" style="v" sid="EZR 2:35"/>ሳናአ ካታማ አሳይ 3,630.<verse eid="EZR 2:35"/></para>
  <para style="m">
    <verse number="36" style="v" sid="EZR 2:36"/>ሀዋንቱ ኦሞዱዋፐ ስሜዳ ቄሳቱ ዋ:</para>
  <para style="m" vid="EZR 2:36">ኢያሱ ያራ ግድያ ያዳያ ያራቱ 973፤<verse eid="EZR 2:36"/></para>
  <para style="m">
    <verse number="37" style="v" sid="EZR 2:37"/>እሜራ ያራቱ 1,052፤<verse eid="EZR 2:37"/></para>
  <para style="m">
    <verse number="38" style="v" sid="EZR 2:38"/>ፓሽሁራ ያራቱ 1,247፤<verse eid="EZR 2:38"/></para>
  <para style="m">
    <verse number="39" style="v" sid="EZR 2:39"/>ሀሪማ ያራቱ 1,017።<verse eid="EZR 2:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="EZR 2:40"/>ሀዋንቱ ኦሞዱዋፐ ስሜዳ ሌዋቱዋ:</para>
  <para style="m" vid="EZR 2:40">ሆዳዊያ ያራ ግድያ ኢያሱነ ቃድምኤላ ያራቱ 74፤<verse eid="EZR 2:40"/></para>
  <para style="m">
    <verse number="41" style="v" sid="EZR 2:41"/>አሳፋ ያራ ግድያ ማዝሙርያ የጽያዋንቱ 128፤<verse eid="EZR 2:41"/></para>
  <para style="m">
    <verse number="42" style="v" sid="EZR 2:42"/>ፐንግያ ናግያ ሻሉማ፥ አጼራ፥ ጻልሞና፥ አቁባ፥ ሀጺጻነ ሾባያ ያራቱ 139.<verse eid="EZR 2:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="EZR 2:43"/>ጌሻ ጎልያን ኦያ ቆማቱዋ ያራቱዋ: ጺሀ ያራቱዋ፥ ሀሱፋ ያራቱዋ፥ ጻባኦታ ያራቱዋ፥ <verse eid="EZR 2:43"/><verse number="44" style="v" sid="EZR 2:44"/>ቄሮሳ ያራቱዋ፥ ስኣሀ ያራቱዋ፥ ፓዶና ያራቱዋ፥ <verse eid="EZR 2:44"/><verse number="45" style="v" sid="EZR 2:45"/>ላባና ያራቱዋ፥ ሀጋባ ያራቱዋ፥ አቁባ ያራቱዋ፥ <verse eid="EZR 2:45"/><verse number="46" style="v" sid="EZR 2:46"/>ሀጋባ ያራቱዋ፥ ሻምላያ ያራቱዋ፥ ሀናና ያራቱዋ፥ <verse eid="EZR 2:46"/><verse number="47" style="v" sid="EZR 2:47"/>ግዴላ ያራቱዋ፥ ጋሃራ ያራቱዋ፥ ራኣያ ያራቱዋ፥ <verse eid="EZR 2:47"/><verse number="48" style="v" sid="EZR 2:48"/>ራጺና ያራቱዋ፥ ናቆዳ ያራቱዋ፥ ጋዛማ ያራቱዋ፥ <verse eid="EZR 2:48"/><verse number="49" style="v" sid="EZR 2:49"/>ኡዛ ያራቱዋ፥ ፓሴሀ ያራቱዋ፥ በሳያ ያራቱዋ፥ <verse eid="EZR 2:49"/><verse number="50" style="v" sid="EZR 2:50"/>አስና ያራቱዋ፥ መኡኒማ ያራቱዋ፥ ናፍሲማ ያራቱዋ፥ <verse eid="EZR 2:50"/><verse number="51" style="v" sid="EZR 2:51"/>ባቅቡቃ ያራቱዋ፥ ሀቁፋ ያራቱዋ፥ ሀርሁራ ያራቱዋ፥ <verse eid="EZR 2:51"/><verse number="52" style="v" sid="EZR 2:52"/>ባጽሉታ ያራቱዋ፥ ማሂዳ ያራቱዋ፥ ሀርሻ ያራቱዋ፥ <verse eid="EZR 2:52"/><verse number="53" style="v" sid="EZR 2:53"/>ባርቆሳ ያራቱዋ፥ ስሳራ ያራቱዋ፥ ተማሀ ያራቱዋ፥ <verse eid="EZR 2:53"/><verse number="54" style="v" sid="EZR 2:54"/>ናጺሀ ያራቱዋነ ሀጺፋ ያራቱዋ።<verse eid="EZR 2:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="EZR 2:55"/>ሶሎሞነ ቆማቱዋ ያራቱዋ: ሶጻያ ያራቱዋ፥ ሀሶፈሬታ ያራቱዋ፥ ፓሩዳ ያራቱዋ፥ <verse eid="EZR 2:55"/><verse number="56" style="v" sid="EZR 2:56"/>ያእላ ያራቱዋ፥ ዳርቆና ያራቱዋ፥ ግዴላ ያራቱዋ፥ <verse eid="EZR 2:56"/><verse number="57" style="v" sid="EZR 2:57"/>ሻፋጽያ ያራቱዋ፥ ሀጺላ ያራቱዋ፥ ፖከረት-ሀጻባይማ ያራቱዋነ አማ ያራቱዋ። <verse eid="EZR 2:57"/><verse number="58" style="v" sid="EZR 2:58"/>ጌሻ ጎልያን ኦያ ቆማቱዋ ያራቱነ ሶሎሞነ ቆማቱዋ ያራቱዋ ፓይዱ ኡባና ሄዙ ጼታነ ኡዱፑን ታማነ ላኡዋ።<verse eid="EZR 2:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="EZR 2:59"/>ሀራቱካ ቃይ ተልመላሀ፥ ተልሀርሻ፥ ካሩባ፥ አዳናነ እሜራ ግያ ካታማቱዋፐ የሩሳላመ ፑደ ቤድኖ። ሽን ኡንቱንቱ፤ ባረንቱ አዎቱ እስራኤልያ ሼሻ ግድያዋ ኤርሳናዉ ዳንዳይበይክኖ። <verse eid="EZR 2:59"/><verse number="60" style="v" sid="EZR 2:60"/>ሄዋንቱ ዳላያ፥ ጾቢያነ ናቆዳ ያራቱዋ፤ ኡንቱንቱ ፓይዱካ ኡባና ኡሱፑን ጼታነ እሻታማነ ላኡዋ።<verse eid="EZR 2:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="EZR 2:61"/>ቄሳቱ ዋፐ ሀባያ ያራቱ፥ ሀቆጻ ያራቱነ ባርዝላያ ያራቱ ስሜድኖ። ሀዌ ባርዝላያ ግያዌ ጋላኣደ ቢታ አሳ ግድያ ባርዝላያ ናቶ አኪደ፥ ባረ ቦሉዋ ሱንን ጼሰቴዳ። <verse eid="EZR 2:61"/><verse number="62" style="v" sid="EZR 2:62"/>ሀዋንቱ ባረንቱ የለታ ጻጱዋ ኤራናዉ የለታ ማጻፋን ኮዬድኖ፥ ሽን ደምበይክኖ። ሄዋ ድራዉ፥ ኡንቱንቱ ቱናዳን ፓይደቲደ፥ ቄሰተን ኦናዳንነ ቄሰ ግደናዳን ድገቴድኖ። <verse eid="EZR 2:62"/><verse number="63" style="v" sid="EZR 2:63"/>ቃይ ኡሪምያንነ ቱሚምያን ሻክ ፕርድያ ቄሲ ደንዳና ጋካናዉ፥ ኡንቱንቱ ጌሻ ቁማፐ ማናዉ ዳንዳየናዋ አይሁዳቱዋ ሞድያዌ ኡንቱንታ አዛዜዳ።<note caller="-" style="x"><char style="xo" closed="false">2:63 </char><char style="xt" closed="false"><ref loc="NUM 27:21">ፓይ. 27:21</ref></char></note><verse eid="EZR 2:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="EZR 2:64"/>ኦሞዱዋፐ ይሁዳ ቢታ ስሜዳ አሳ ፓይዱ ኡባና 42,360. <verse eid="EZR 2:64"/><verse number="65" style="v" sid="EZR 2:65"/>ሄዋ ቦላካ ቃይ 7,337 አቱማ ቆማቱነ ማጫ ቆማቱነ 200 አቱማዋነ ማጫ ማዝሙርያ የጽያዋንቱካ ስሜድኖ። <verse eid="EZR 2:65"/><verse number="66" style="v" sid="EZR 2:66"/>ኡንቱንቱ ፓራቱዋ ፓይዱ 736፤ ኡንቱንቱ ባቁሎቱ 245፤ <verse eid="EZR 2:66"/><verse number="67" style="v" sid="EZR 2:67"/>ኡንቱንቱ ጋሎቱ 435፤ ኡንቱንቱ ሀረቱ ቃይ 6,720.<verse eid="EZR 2:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="EZR 2:68"/>ኡንቱንቱ የሩሳላመን ካሰ መና ጎዳ ጎሊ ደእያ ሳኣ ጋኬዳ ዎደ፥ ያራቱ ካፓቱዋፐ አማሬዳዋንቱ መና ጎዳ ጎሊ ካሰ ባረ ሳኣን ኬጸታና ማላ፥ ባረንቱ ሸንያን እሞታ እሜድኖ። <verse eid="EZR 2:68"/><verse number="69" style="v" sid="EZR 2:69"/>እቱ እቱ ባረዉ ዳንዳይያዋ ኬሻ ኬሻ ሀ ጾሳ ጎልያ ኦሶ እሜዳ፤ ኡንቱንቱ ኡባና 500 ኪሎ ግራምያ ዴጽያ ዎርቃ፥ 2,800 ኪሎ ግራምያ ዴጽያ ብራነ 100 ቄሳቱዋ ማዩዋ እሜድኖ።<verse eid="EZR 2:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="EZR 2:70"/>ሄዋፐ ጉይያን ቄሳቱ፥ ሌዋቱነ አሳፐ አማሬዳዋንቱ የሩሳላመን ኡቴድኖ፤ ማዝሙርያ የጽያዋንቱ፥ ፐንግያ ናግያዋንቱነ ጌሻ ጎልያን ኦያ ቆማቱ የሩሳላመ ዩሹዋን ደእያ ካታማቱዋን ኡቴድኖ፤ ቃይ አቴዳ እስራኤልያ አሳቱ ኡባይ ባረንቱ ካታማቱዋን ካታማቱዋን ኡቴድኖ።<note caller="-" style="x"><char style="xo" closed="false">2:70 </char><char style="xt" closed="false"><ref loc="1CH 9:2">1 ኦዱዋ 9:2</ref>፤ <ref loc="NEH 11:3">ናህ. 11:3</ref></char></note><verse eid="EZR 2:70"/></para>
  <chapter eid="EZR 2"/>
  <chapter number="3" style="c" sid="EZR 3"/>
  <para style="ms">ጌሻ ጎልያ ዛረ ኬጻነ አንጁዋ</para>
  <para style="mr">(<ref loc="EZR 3:1-6:22">3:1—6:22</ref>)</para>
  <para style="s1">ያርሽያ ሳኣ ኬጻነ ጎይንያ ዎጋ ዛረ ዶመባ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 3:1"/>ላፑን አግናይ ጋክያ ዎደ እስራኤልያ አሳይ ባረንቱ ካታማ ካታማ ስሜድኖ፥ ኡንቱንቱ ኡባይ እት አሳዳን የሩሳላመን ሺቄድኖ። <verse eid="EZR 3:1"/><verse number="2" style="v" sid="EZR 3:2"/>ዮጸዴቃ ናኣ ኢያሱነ አ ካልያ ቄሳቱ ቃይ ሳላትያላ ናኣ ዛሩባቤልነ አ ዳቦቱ ጾሳ አሳ ሙሴ ህግያን ካሰ ጻፈቴዳዋዳን ጹግያ ያርሹዋ ያርሻናዉ፥ እስራኤልያ ጾሳዉ ያርሽያ ሳኣ ጊግሴድኖ።<note caller="-" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="EXO 27:1">ከሳ 27:1</ref></char></note> <verse eid="EZR 3:2"/><verse number="3" style="v" sid="EZR 3:3"/>ኡንቱንቱ ሄ ጋድያን ደእያ አሳዉ ያዮፐነ፥ አገናን ያርሹዋ ያርሽያ ሳኣ ካሰ እ ኮለቴዳ ሳኣን ዛረደ ኬጼድኖ። ጊግሲደ፥ ጹግያ ያርሹዋ መና ጎዳዉ ዎንታነ ኦማርስ ኡባ ዎደ ያርሼድኖ።<note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="NUM 28:1-8">ፓይ. 28:1-8</ref></char></note> <verse eid="EZR 3:3"/><verse number="4" style="v" sid="EZR 3:4"/>ካሰ ጻፈቴዳዋዳንካ ኡንቱንቱ ዳስያ ባላ ቦንቼድኖ፤ ጹግያ ያርሹዋካ ሀቼዉ ሀቼዉ በስያዋ ፓይዱዋ ፓጭሰናን ያርሼድኖ።<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="NUM 29:12-38">ፓይ. 29:12-38</ref></char></note> <verse eid="EZR 3:4"/><verse number="5" style="v" sid="EZR 3:5"/>ቃይ ኡባ ዎደ ያርሽያ ጹግያ ያርሹዋ፥ አግናይ ጼርያ ዎደ ያርሽያ ያርሹዋነ መና ጎዳ ጌሻ ባላቱዋን ያርሽያ ያርሹዋ ኡባካ ያርሼድኖ። ሄዋ ቦላካ አሳይ ባረ ሸንያን መና ጎዳዉ እሜዳ እሞታ ኡባካ ያርሼድኖ።<note caller="-" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="NUM 28:11-29:39">ፓይ. 28:11—29:39</ref></char></note> <verse eid="EZR 3:5"/><verse number="6" style="v" sid="EZR 3:6"/>ላፑን አግናን ኮይሮ ጋላሳን ኡንቱንቱ መና ጎዳዉ ጹግያ ያርሹዋ ያርሽያዋ ዶሜድኖ፤ ሽን ሄ ዎደ መና ጎዳ ጌሻ ጎልያ ኬጽያ ባሱ ብሮ ባሰትቤና።<verse eid="EZR 3:6"/></para>
  <para style="s1">ጌሻ ጎልያ ዛረ ኬጽያዋ ዶሜድኖ</para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 3:7"/>ሄዋፐ ጉይያን፥ ሹቻ ማስያዋንቶነ አናጸቶ ሻሉዋ ግሺደ ቃጻሬድኖ። ፓርሰ ካቲ ቂሮስ ኡንቱንቶ አዛዜዳ ድራዉ፥ ሊባኖሳፐ ዝጋ አባ ፕንደ፥ ዮጰ አሀናዉ ሲዶናነ ጺሮሳ ቢታ አሳዉ ቁማ፥ ኡሻነ ዛይትያ እሜድኖ።<verse eid="EZR 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 3:8"/>ሄዋፐ ጉይያን፥ ኡንቱንቱ የሩሳላመን ደእያ ጾሳ ጎሊ ደእያ ሳኣ ጋኬዳ ላኤን ላይን ላኤን አግናን፥ ሳላትያላ ናአይ ዛሩባቤለ፥ ዮጸዴቃ ናኣ ኢያሱነ ኡንቱንቱ ዳቦቱ፥ ቄሳቱ፥ ሌዋቱነ ኦሞዱዋፐ ስሚደ፥ የሩሳላመ ዬዳ አሳይ ኡባይ ኪታ ዶሜድኖ። ቃይ መና ጎዳ ጎልያ ኪታ አዎተን ጼላና ማላ፥ ላታሙ ላይ ግዴዳዋንታነ ላታሙ ላይፐ አዳ ሌዋቱዋ ሱንድኖ። <verse eid="EZR 3:8"/><verse number="9" style="v" sid="EZR 3:9"/>ሌዊያ ዛርያ ግድያ ኢያሱ፥ አ ናናይነ አ ዳቦቱ፥ ሆዳዊያ ያራ ግድያ ቃድምኤልነ አ ናናይ እትፐ ግዲደ፥ ጾሳ ጎልያ ኪታ አዎተን ጼሌድኖ፤ ቃይ ሄናዳዳ ያራ ግድያ ሌዋቱካ ኡንቱንቱ ማዴድኖ።<verse eid="EZR 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 3:10"/>ግምቢያዋንቱ መና ጎዳ ጌሻ ጎልያ ግምባናዉ ባሱዋ ባስ ዉርሴዳ ዎደ፥ ቄሳቱ ባረንቱ ማዩዋ ማይ ጹሩምባ ኦይቂደ፥ ቃይ አቱማ አሳ ግድያ አሳፋ ያራቱዋ፥ ሌዋቱካ፥ ዳላ ኦይቂደ፥ እስራኤልያ ካትያ ዳዊታ ዎጋዳን መና ጎዳ ጋላታናዉ ኤቄድኖ።<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="1CH 25:1">1 ኦዱዋ 25:1</ref></char></note> <verse eid="EZR 3:10"/><verse number="11" style="v" sid="EZR 3:11"/>ኡንቱንቱ መና ጎዳ ጋላቲድነ ቃንጸናን ማዝሙርያን ሳቢደ፥ ሀዋዳን ያጊደ፥ አዉ የጼድኖ፤<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1 ኦዱዋ 16:34</ref>፤ <ref loc="2CH 5:13">2 ኦዱዋ 5:13</ref>፤ <ref loc="2CH 7:3">7:3</ref>፤ <ref loc="PSA 100:5">ማዝ. 100:5</ref>፤ <ref loc="PSA 106:1">106:1</ref>፤ <ref loc="PSA 107:1">107:1</ref>፤ <ref loc="PSA 118:1">118:1</ref>፤ <ref loc="PSA 136:1">136:1</ref>፤ <ref loc="JER 33:11">ኤር. 33:11</ref></char></note></para>
  <para style="q1" vid="EZR 3:11">“መና ጎዳይ ሎአ፤</para>
  <para style="q2" vid="EZR 3:11">እ እስራኤልያ ሲቅያ ሲቁ መናዋ” ያጌድኖ።</para>
  <para style="m" vid="EZR 3:11">ቃይ መና ጎዳ ጎልያ ባሱ ባሰቴዳ ድራዉ፥ አሳይ ኡባይ ባረንቱ ቃላ ቁ ኦደ ሆምቦጪደ፥ መና ጎዳ ጋላቴድኖ። <verse eid="EZR 3:11"/><verse number="12" style="v" sid="EZR 3:12"/>ሽን ካሰ ጎልያ በኤዳ ጭማ ቄሳቱ ዋፐ፥ ጭማ ሌዋቱዋፐነ ጭማ ጎልያ ካፓቱዋፐ ዳራቱ ሀእ ጌሻ ጎልያ ግምባናዉ ባሰቴዳ ባሱዋ በኤዳ ዎደ፥ ባረንቱ ቃላ ቁ ኦደ ዬኬድኖ፤ ሀራቱ ማታ ናሸቲደ ሆምቦጬድኖ። <verse eid="EZR 3:12"/><verse number="13" style="v" sid="EZR 3:13"/>ሄዋ ድራዉ፥ ናሸቲደ ሆምቦጭያዋ ዬክያዋፐ ሻክ ኤራናዉ ዳንዳየትቤና። አያዉ ጎፐ፥ ኡንቱንቱ ሎይ ኮሹምያ ድራዉ፥ ኡንቱንቱ ኮሹንቻይካ ሃኮ ሳን ስሰቴ።<verse eid="EZR 3:13"/></para>
  <chapter eid="EZR 3"/>
  <chapter number="4" style="c" sid="EZR 4"/>
  <para style="s1">ጌሻ ጎልያ ዛረ ኬጸና ማላ ድጋናዉ ደንዴዳዋንታ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 4:1"/>ኦሞዱዋፐ ስሜዳ አሳቱ መና ጎዳዉ፥ እስራኤልያ ጾሳዉ ጌሻ ጎልያ ኬጽያዋ ይሁዳነ ቢንያማ ሞርከቱ ስሴድኖ። <verse eid="EZR 4:1"/><verse number="2" style="v" sid="EZR 4:2"/>ዛሩባቤላኮነ ጎልያ ካፓቱዋኮ ዪደ፥ ሀዋዳን ያጌድኖ፤ “አሶረ ካቲ አስራዶን<note caller="+" style="f"><char style="fr" closed="false">4:2 </char><char style="fq" closed="false">አስራዶን፦ </char><char style="ft" closed="false">ሀ ቃላ ብለይ እብራዌዋን፥ “ኤሳር-ሃዶን” ግያዋ።</char></note> ኑና ሀ ሳአዉ አሄዳ ጋላሳፐ ዶሚደ፥ ኑንካ ህንተንቱ ጾሳ ኮዬቶነ ያርሼቶ። ሄዋ ድራዉ፥ ኑንካ ህንተናና እትፐ አነ ኬጾይተ” ያጌድኖ።<note caller="-" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="2KI 17:24-41">2 ካታ. 17:24-41</ref></char></note><verse eid="EZR 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 4:3"/>ሽን ዛሩባቤለ፥ ኢያሱነ እስራኤልያ ዛራቱዋ ካፓቱ ኡንቱንቶ ዛሪደ፥ ሀዋዳን ያጌድኖ፤ “ኑ ጎልያ ኬጻናዉ ኑዉነ ህንተንቶ አይ እትፐተነ ባዋ። ሽን ፓርሰ ካቲ ቂሮስ አዛዜዳዋዳን፥ ኑ ጻላላይ መና ጎዳዉ እስራኤልያ ጾሳዉ ኬጻና” ያጌድኖ።<verse eid="EZR 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZR 4:4"/>ሄዋፐ ጉይያን፥ ይሁዳ ቢታ አሳቱ ኬጸናዳን፥ ሄ ጋድያን ደእያ አሳቱ ሀሽያ ሾጬድኖነ ያሽሴድኖ። <verse eid="EZR 4:4"/><verse number="5" style="v" sid="EZR 4:5"/>ቃይ ፓርሰ ካትያ ቂሮሳ ላይይ ዉራናዉነ አፐ ስሚደ ዳርዮስ ፓርሰን ካተቴዳ ዎዲ ጋካናዉ፥ ኡንቱንቱ ይሁዳ አሳቱዋ ዞረታ ላላናዉ ዞረትያዋንታ ማታዬድኖ።<note caller="+" style="f"><char style="fr" closed="false">4:5 </char><char style="fk" closed="false">ዳርዮስ፦ </char><char style="ft" closed="false">ዳርዮሳ ታርኪ ፓይዱዋ 24ፐ ዶሚደ ጻፈቴዳ። ፓይዱዋ 6-23 ጋካናዉ ጻፈቴዳ ታርኪ ጌሻ ጎሊ ኬጸቶደፐ እት ጼቱ ላይ ግድያዋ ጋምእና ሀኔዳባ።</char></note><verse eid="EZR 4:5"/></para>
  <para style="s1">የሩሳላመ ላኤንዋ ኬጸተናዳን ድገቴዳ</para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 4:6"/>አርጸክስሰ ካዉተ ዶመን፥ ኡንቱንቱ ይሁዳነ የሩሳላመ አሳ ሞታናዉ ፓይልያ ዶዬድኖ።<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="EST 1:1">አስ. 1:1</ref></char></note><verse eid="EZR 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 4:7"/>አርጸክስሰ ካተት ደእሽን፥ ብሽላም፥ ምትረዳት፥ ጻብኤልነ ኡንቱንቱና እትፐ ኦያዋንቱና ግዲደ፥ ፓርሰ ካትያ አርጸክስሳዉ ዳብዳቢያ ጻፌድኖ፤ ሄ ዳብዳቢ ሶርያ ጋደ ፕዶልያንነ ቃላን ጻፈቴዳ።<verse eid="EZR 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 4:8"/>ዎታዳራ ሞድያ ረሁምነ ጻፍያ ሽምሻይ የሩሳላመባ ሀዋዳን ያጊደ፥ ካትያ አርጸክስሳዉ ዳብዳቢያ ጻፌድኖ፤ <verse eid="EZR 4:8"/><verse number="9" style="v" sid="EZR 4:9"/>“ሀ ዳብዳቢ ቢታ ሞድያ ረሁማፐ፥ ጻፍያ ሽምሻያፐ፥ በን ኤላማ ቢታን ደእያ ሱሳፐ፥ ኤሬካፐነ ባብሎነፐ ዬዳ ፕርድያነ ዳናትያ ኡንቱንቱ ያራቱዋፐነ <verse eid="EZR 4:9"/><verse number="10" style="v" sid="EZR 4:10"/>ግታነ ቦንቼቴዳ ካትያ አሳናፋር ኦሞድ አሂደ፥ ሳማርያንነ ኤፍራጺሳ ሻፋፐ አዋይ ዉልያ ባጋ ጋድያን ዎዳ አሳ ኡባፐ ጻፌቴዳ” ያጌድኖ።<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="fk" closed="false">አሳናፋር፦ </char><char style="ft" closed="false">እብራዌዋን “ኦስናፓር” ጌተቴ። ሀ ካቲ ቃይ “አሱርባንፓል” ጌተቴ።</char></note><verse eid="EZR 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 4:11"/>ኡንቱንቱ አዉ ኪቴዳ ዳብዳቢ ሀዋዳን ያጌ፤ “ካትያ አርጸክስሳዉ፥ ኤፍራጺሳ ሻፋፐ አዋይ ዉልያ ባጋ ጋድያን ደእያ ነ ቆማቱዋፐ፦<verse eid="EZR 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 4:12"/>“ካትያዉ፥ ነ ማታፐ ሃ ኑኮ ዬዳ አይሁዳቱ የሩሳላመ ቢደ፥ ሄ ማካላንቻነ ኢታ ካታማ ዛሪደ ኬጽ ደእያዋ ኤራ። አ ግምቢያ ኦራጽሲኖ፤ አ ጻጱዋካ ኦራጽሲኖ። <verse eid="EZR 4:12"/><verse number="13" style="v" sid="EZR 4:13"/>ቃይ ካትያዉ፥ ሀ ካታማይ ኬጸትያባ ግዶፐነ አ ግምቢያካ ኦራጽስያባ ግዶፐ፥ ሄዋፐ ጉይያን፥ ኡንቱንቱ ጊራነ ቃራጻ ቃንጸናዋ ኤራ። ሄዋፐ ደንዴዳዋን ካትያ ጎለዉ ገልያ ሚሻይ ፓጫ ግዳና። <verse eid="EZR 4:13"/><verse number="14" style="v" sid="EZR 4:14"/>ኑን ካቲ ሱንና ኦያዋንታ ግድያ ግሻዉነ ካቲ ካዉሽሽን በአናዉ ኮየና ድራዉ፥ ሀዋ ኔን ኤራና ማላ ጊደ ኪቴቶ። <verse eid="EZR 4:14"/><verse number="15" style="v" sid="EZR 4:15"/>ሄዋ ድራዉ፥ ካሰ ነ አዎቱዋ ታርክያ ማጻፋይ ኮየቲደ ጼለቶ፤ ሄዋን ጻፈቴዳዋፐ ኔን ሀ ካታማይ በንፐካ ዶሚደ፥ ማካላንቻ ካታማ ግድያዋነ ካተቶነ ቢታቶ መቱዋ መዳዋ ግድያዋ ኤራናዉ ዳንዳያሳ። ሄዋፐ ደንዴዳዋን እ ኮለቴዳ። <verse eid="EZR 4:15"/><verse number="16" style="v" sid="EZR 4:16"/>ሄዋ ድራዉ፥ ሀ ካታማይ ኬጸትያዋ ግዶፐነ አ ግምቢያካ ኦራጽስያዋ ግዶፐ፥ ኤፍራጺሳ ሻፋፐ አዋይ ዉልያ ባጋ ቢታይ ነ ኩሽያፐ ከሴዳዋ ኤራ” ያጌድኖ።<verse eid="EZR 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZR 4:17"/>ካቲ ሀዋዳን ያግያ ዛሩዋ ኡንቱንቶ የዴዳ፤ “ዎታዳራቱዋ ሞድያ ረሁማ፥ ጻፍያ ሽምሻያ፥ ሳማርያንነ ኤፍራጺሳ ሻፋፐ አዋይ ዉልያ ባጋ ጋድያን ደእያ ኡንቱንቱና ኦያ አሳ ኡባዉ፥ ህንተንታ ሳሮ ጋይ። <verse eid="EZR 4:17"/><verse number="18" style="v" sid="EZR 4:18"/>ህንተንቱ ታዉ የዴዳ ዳብዳቢ ብለቲደ ናባበቴዳ። <verse eid="EZR 4:18"/><verse number="19" style="v" sid="EZR 4:19"/>ታን አዛዝና፥ ካሰ ታርኪ ኮየቲደ ጼለቴዳ፤ ሀ ካታማይ በንፐካ ዶሚደ፥ ካተቶ ማካላንቻ ግድያዌነ መቱዋ መያዋንቱ ደእያ ሳኣ ግድያዌ ኤረቴዳ። <verse eid="EZR 4:19"/><verse number="20" style="v" sid="EZR 4:20"/>የሩሳላመን ዎልቃማ ካተቱ ካዉቴድኖ፤ ኤፍራጺሳ ሻፋፐ አዋይ ዉልያ ባጋ ቢታፐካ ሄ ካተቱ ጊራነ ቃራጻ አኬድኖ። <verse eid="EZR 4:20"/><verse number="21" style="v" sid="EZR 4:21"/>ሄዋ ድራዉ፥ ታን ኡንቱንቶ ኦተ ግያ አዛዙዋ እማና ጋካናዉ፥ ሀ አሳቱ ሄ ካታማ ኬጽያዋ ኤሳና ማላ ኦድተ። <verse eid="EZR 4:21"/><verse number="22" style="v" sid="EZR 4:22"/>ህንተንቱ ሀ የዉዋ ሸነኮ ጌና ማላ ናገትተ። አያዉ ጎፐ፥ ካተቶ መቱዋ ዳርሳናዉ ኮሸና” ያጊደ ኪቴዳ።<verse eid="EZR 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZR 4:23"/>ካትያ አርጸክሲሳ ዳብዳቢ ረሁማዉ፥ ጻፍያ ሽምሻያዉነ ኡንቱንቱና ኦያ ኡባቶ ናባበቴዳ ዎደ፥ የሩሳላመን ደእያ አይሁዳ አሳቱዋኮ ኤሌል ቢደ፥ ኡንቱንቱ ኬጽያዋ ዎልቃን ተኤድኖ።<verse eid="EZR 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 4:24"/>የሩሳላመን ደእያ ጾሳ ጎልያ ኪታይ ፓርሳ ካቲ ዳርዮሰ ካተቴዳ ላኤን ላይይ ጋካናዉ፥ ኤቆ ሳኣን አት አጌዳ።<note caller="-" style="x"><char style="xo" closed="false">4:24—5:1 </char><char style="xt" closed="false"><ref loc="HAG 1:1">ሃገ 1:1</ref>፤ <ref loc="ZEC 1:1">ዛካ. 1:1</ref></char></note><verse eid="EZR 4:24"/></para>
  <chapter eid="EZR 4"/>
  <chapter number="5" style="c" sid="EZR 5"/>
  <para style="s1">ጌሻ ጎልያ ኦሱ ዛረ ዶመቱሳባ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 5:1"/>ሄ ዎድያን ትምቢትያ ኦድያዋንቱ ሃገነ እዶ ናአይ ዛካራስ ይሁዳንነ የሩሳላመን ደእያ አይሁዳ አሳቶ እስራኤልያ ጾሳ ሱንን ትምቢትያ ኦዴድኖ። <verse eid="EZR 5:1"/><verse number="2" style="v" sid="EZR 5:2"/>ሳላትያላ ናአይ ዛሩብ-ባቤልነ ዮጸዴቃ ናአይ ኢያሱ ደንዲደ፥ የሩሳላመን ደእያ ጾሳ ጎልያ ዛረደ ኬጻናዉ ዶሜድኖ። ትምቢትያ ኦድያዋንቱካ ኡንቱንቱና እትፐ ግዲደ፥ ኡንቱንታ ማዴድኖ።<note caller="-" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="HAG 1:12">ሃገ 1:12</ref>፤ <ref loc="ZEC 4:6-9">ዛካ. 4:6-9</ref></char></note><verse eid="EZR 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 5:3"/>ሄ ዎደ፥ ኤፍራጺሳ ሻፋፐ አዋይ ዉልያ ባጋ ቢታ ሞድያ ታታናያ ግያዌ፥ ሻታርቦዝና ግያዌነ ኡንቱንቱና ኦያዋንቱ ዪደ፥ “ህንተንቱ ሀ ጎልያ ኬጻና ማላነ ፖላና ማላ፥ ህንተንቶ ኦኔ ኦዴዳዌ?” ያጊደ ኦቼድኖ። <verse eid="EZR 5:3"/><verse number="4" style="v" sid="EZR 5:4"/>ኡንቱንቱ ቃይ፥ “ሀዋ ግምቢያ አሳቱዋ ሱንይ ኦና ኦኔ?” ያጊደ ኦቼድኖ። <verse eid="EZR 5:4"/><verse number="5" style="v" sid="EZR 5:5"/>ሽን ሄ የዉ ዳርዮሳኮ ጋክና፥ አ ማታፐ ዳብዳቢ ጻፈቲደ ያና ጋካናዉ፥ ኡንቱንቱ ባረንቱ ኦሱዋ አግበይክኖ፤ አያዉ ጎፐ፥ ኡንቱንቱ ጾሳ አይፊ አይሁዳ ጭማቱዋ ቦላን ደኤ።<verse eid="EZR 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 5:6"/>ኤፍራጺሳ ሻፋፐ አዋይ ዉልያ ባጋ ቢታ ሞድያ ታታናይ፥ ሻታርቦዝንነ ኡንቱንቱና ኦያዋንቱ ካትያ ዳርዮሳዉ ኪቴዳ ዳብዳቢ <verse eid="EZR 5:6"/><verse number="7" style="v" sid="EZR 5:7"/>ሀዋዳን ያጌ፦</para>
  <para style="p" vid="EZR 5:7">“ካትያ ዳርዮሳ፥ ኩመን ሳሮተይ ነዉ ግዶ!<verse eid="EZR 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 5:8"/>“ኑን ይሁዳ ጋድያን ደእያ ዎልቃማ ጾሳ ጎልያኮ ቤዶ። ሄ ሹቻን ኬጸቴዳ፤ ቃይ ግምቢያ ጋርሳንካ ምይ ዎዳ። ኦሱካ ዎልቃማ አኬካንነ ኤሌል ኦሰቲደ ደኤ።<verse eid="EZR 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZR 5:9"/>“ኡንቱንቱ ጭማቱዋ ኑን ሀዋዳን ያጊደ ኦቼዶ፤ ‘ሀ ጎልያ ኬጻና ማላነ ፖላና ማላ፥ ህንተንቶ ኦኔ ኦዴዳዌ?’ ያጊደ ኦቼዶ። <verse eid="EZR 5:9"/><verse number="10" style="v" sid="EZR 5:10"/>ቃይ ነዉ ጻፊደ ኤርሳና ማላ፥ ኡንቱንታ ሀ ኪታን ካለያዋንቱ ሱንይካ ኦነንቶ ኦቼዶ።<verse eid="EZR 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 5:11"/>“ኡንቱንቱ ሀዋዳን ያጊደ ዛሬድኖ፤ ‘ኑን ሳሉዋነ ሳኣ ጾሳ ቆማቱዋ፤ ቃይ ኑን እስራኤልያ ካትያ ግታይ ዳሮ ላይፐ ካሰ ባጋን ኬጽ ፖሌዳ ጌሻ ጎልያ ዛረ ኬጸቶ። <verse eid="EZR 5:11"/><verse number="12" style="v" sid="EZR 5:12"/>ኑ አዎቱ ሳሉዋ ጾሳ ሀንቀዳ ድራዉ፥ እ ኡንቱንታ ባብሎነ ካትያ ናቡካዳናጾራ ኩሽያን አ እምና፥ እ ሀ ጎልያ ኮል አጌዳ፤ አሳካ ባብሎነ ጋድያ ኦሞዶ አኪደ ቤዳ።<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="2KI 25:8-12">2 ካታ. 25:8-12</ref>፤ <ref loc="2CH 36:17-20">2 ኦዱዋ 36:17-20</ref>፤ <ref loc="JER 52:12-15">ኤር. 52:12-15</ref></char></note><verse eid="EZR 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 5:13"/>“ ‘ሽን ባብሎነ ካቲ ቂሮስ ባረ ካተቴዳ ኮይሮ ላይን፥ ጾሳ ጎልያ፥ ሀዋ ዛረ ኬጻና ማላ፥ አዋዩዋ ከሴዳ።<note caller="-" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="EZR 1:2-11">እዝራ 1:2-11</ref></char></note> <verse eid="EZR 5:13"/><verse number="14" style="v" sid="EZR 5:14"/>ናቡካዳናጾረ የሩሳላመን ደእያ ጾሳ ጎልያፐ አክ አፊደ፥ ባብሎነ ቢታን ደእያ ባረ ጾሳቱዋ ጎለን ዎዳ ዎርቃነ ብራ ሚሻቱዋካ ቂሮስ ዛሪደ የዴዳ።</para>
  <para style="p" vid="EZR 5:14">“ ‘ሄ ሚሻቱ ካቲ ቂሮስ ይሁዳ ቢታ ሞዳና ማላ ዶሬዳ ሸሽባጻራ ኩሽያን ሼቴድኖ። <verse eid="EZR 5:14"/><verse number="15" style="v" sid="EZR 5:15"/>ካቲ ቂሮስ አ ሀዋዳን ያጌዳ፤ “ሀ ሚሻቱዋ አካ አፋደ የሩሳላመን ደእያ ጌሻ ጎልያን ዎ፤ ቃይ ጾሳ ጎልያካ ካሰ እ ደእያ ሳኣን ኬጻ” ያጌዳ። <verse eid="EZR 5:15"/><verse number="16" style="v" sid="EZR 5:16"/>ሄዋፐ ጉይያን፥ ሸሽባጻር ዪደ፥ ጾሳ ጎልያ የሩሳላመን ባሴዳ። እ ሀእካ ዉርቤናዋ ግዶፐነ፥ ሄ ዎደፐ ዶሚደ፥ ኬጸቲደ ደኤ’ ያጌድኖ።<verse eid="EZR 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZR 5:17"/>“ሀእ ስም ሀ የዉ ካትያ ናሸችያባ ግዶፐ፥ አነ ካቲ ቂሮስ ሀ ጎልያ የሩሳላመን ኬጻና ማላ፥ ቱሙካ አዋዩዋ ከሴደንቶ ኤራናዉ ካሰ አዳ ባብሎነ ካተቱዋ ታርክያ ማዝጎባይ ኮየቲደ ጼለቶ። ሄዋፐ ጉይያን፥ ካቲ ኑን ሀ የዉዋ ዋታናዉ በስንቶ ቃቼዳ ቆፋ ኑዉ ኪቶ” ያጊደ ጻፌድኖ።<verse eid="EZR 5:17"/></para>
  <chapter eid="EZR 5"/>
  <chapter number="6" style="c" sid="EZR 6"/>
  <para style="s1">ቂሮስ ካሰ አዛዜዳ አዛዙ ኮየቲደ ቤቴዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 6:1"/>ሄዋ ድራዉ፥ ካቲ ዳርዮስ አዛዝና፥ ባብሎነ ሚሻቱዋ ዎያ ጎለን ደእያ ታርክያ ማዝጋባቱዋ ኡንቱንቱ ኮዬድኖ። <verse eid="EZR 6:1"/><verse number="2-3" style="v" sid="EZR 6:2-3"/>ሽን ባብሎነ ካታማን ግደናን ደእሽን፥ ሜዶና ጋድያን ደእያ አህምታ ግያ ካታማን እት ጻጸቶ ማጻፋይ ቤቴዳ። ሄ ማጻፋን ጻፈቴዳባይ ሀዋዳን ያጌ፤<note caller="+" style="f"><char style="fr" closed="false">6:2-3 </char><char style="fk" closed="false">አህምታ፦ </char><char style="ft" closed="false">ሀ ካታማይ ቃይ ኤክባታና ጌተቴ።</char></note> “ዎደናዉ ዶገተናዳን፥ ካቲ ቂሮስ ባረ ካተቴዳ ኮይሮ ላይን፥ የሩሳላመን ደእያ ጾሳ ጎልያ ድራዉ፥ ሀዋዳን ያግያ አዋዩዋ ከሴዳ፤ ጾሳ ጎልያ ግድያ፥ ያርሹዋ ያርሽያ ሳአይ ዛረደ ኬጸቶ፤ አ ባሱካ ባሰቶ። ሄ ጌሻ ጎሊ ኡሱፑን ታሙ ዋ አዱሳነ ኡሱፑን ታሙ ዋ አካ ግዶ። <verse eid="EZR 6:2-3"/><verse number="4" style="v" sid="EZR 6:4"/>ቃይ ሄዙ ማራን ዎልቃማ ሹቻይ ዎና፥ ሄ ማራቱዋ ቦላን ቦላና እት ማራ ምይ ዎ። ሄዎ ኮሽያ ሚሻይ ኡባይ ካትያ ጎለን ሚሻ ዎያ ጎልያፐ እመቶ። <verse eid="EZR 6:4"/><verse number="5" style="v" sid="EZR 6:5"/>ናቡካዳናጾረ፤ ‘የሩሳላመን ደእያ ጾሳ ጎልያፐ ባብሎነ አሄዳ ጾሳ ጌሻ ጎልያ ዎርቃነ ብራ ሚሻቱ ጾሳ ጎልያዉ ጉየ የሩሳላመ ስሚደ፤ ጾሳ ጌሻ ጎልያን ደእኖ’ ያጌዳ።<verse eid="EZR 6:5"/></para>
  <para style="s1">ካትያ ዳርዮስ ኦሱ ኦሰታናዳን አዛዜዳ</para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 6:6"/>“ህንተንቶ ኤፍራጺሳ ሻፋፐ አዋይ ዉልያ ባጋ ቢታ ሞድያ ታታናያ፥ ሻታርቦዝናነ ኡንቱንቱና ኦያ ኡባደ፥ ሄ ጎልያኮ ሺቆፕተ። <verse eid="EZR 6:6"/><verse number="7" style="v" sid="EZR 6:7"/>ሀ አሳቱ ኬጽያ ጾሳ ጎልያ ኦሶ በ ግዶፕተ። አይሁዳቱዋ ሞድያዌነ አይሁዳ ጭማቱ ጾሳ ጎልያ ካሰ እ ደእያ ሳኣን ዛሪደ ኬጽኖ።<verse eid="EZR 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 6:8"/>“ቃይ ሀ አይሁዳ ጭማቱ ጾሳ ጎልያ ኬጽያ ዎደ፥ ኡንቱንቱ ኦያ ኪታይ ኤቀና ማላ፥ ኡንቱንቶ ኮሽያ ሻሉዋ ኡባ ኤፍራጺሳ ሻፋፐ አዋይ ዉልያ ባጋ ቢታፐ ሺሼዳ ካትያ ጊራ ሚሻፐ ህንተንቱ ኡንቱንቶ እማና ማላ፥ ታን አዛዛድ። <verse eid="EZR 6:8"/><verse number="9" style="v" sid="EZR 6:9"/>የሩሳላመን ደእያ ቄሳቱ ሳሉዋ ጾሳዉ ጹግያ ያርሹዋ ያርሻናዉ ኮሽያባይ ኮሩማቱዋ ግድና፥ ዶርሳ ኮልያ ግድና ቃይ ዶርሳ ማራቱዋ ግዶፐነ ኡንቱንቶ እምተ። ቃይ አያነ ፓጭሰናን ኡንቱንቱ ኮይያ ዛርጋ፥ ማጽንያ፥ ዎይንያ ኤሳነ ዛይትያ ኡንቱንቶ ሀቼ ሀቼ እምተ። <verse eid="EZR 6:9"/><verse number="10" style="v" sid="EZR 6:10"/>ሄዋ ህንተንቱ እምያዌ ኡንቱንቱ ሳሉዋ ጾሳ ሎይ ናሸችያ ያርሹዋ ያርሻናሳነ ካትያነ አ ናና ደኡዋ ድራዉካ ዎሳናዳና።<verse eid="EZR 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 6:11"/>“ሀ አዋዩዋ ላምያ ኦንነ ደኦፐ፥ ‘አ ጎልያ ቱሳ ሾዲደ፥ ሄ ቱሳ ጼራ ፖጼዳዋን ሉከቲደ ሀይቆ፤ አ ኬይካ ፕቱዋ ኦልያ ሳኣ ግዶ’ ጋደ ጉጃደካ አዛዛድ። <verse eid="EZR 6:11"/><verse number="12" style="v" sid="EZR 6:12"/>ሀ አዛዙዋ ላማናዉነ ቃይ የሩሳላመን ደእያ ጾሳ ጎልያ ኮላናዉ ኩሽያ ደንያ አይ ካትያ ዎይ አሳ ግድና፥ ባረ ሱንይ ጼሰታና ማላ የሩሳላመ ዶሬዳ ጾሳይ አ ይሶ። ታን ዳርዮስ ሀዋ አዛዛድ። ሀ የዉዋ አሳይ ኡባይ ምኖተን ፖሎ” ያጌ።<verse eid="EZR 6:12"/></para>
  <para style="s1">ጌሻ ጎልያ አንጁዋ ባላ</para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 6:13"/>ሄዋፐ ጉይያን፥ ኤፍራጺሳ ሻፋፐ አዋይ ዉልያ ባጋ ቢታ ሞድያ ታታናይ፥ ሻታርቦዝንነ ኡንቱንቱና ኦያ ኡባቱ ካቲ ዳርዮስ አዛዜዳዋዳን ምኖተን ኦደ ፖሌድኖ። <verse eid="EZR 6:13"/><verse number="14" style="v" sid="EZR 6:14"/>ሄዋ ድራዉ፥ አይሁዳ ጭማቱ ባረንቱ ኪታ አገናን ኦድኖ፤ ቃይ ትምቢትያ ኦድያዌ ሀዌነ እዶ ናአይ ዛካራስ ኦዴዳ ቃላንካ ምንሴድኖ። እስራኤልያ ጾሳይ አዛዜዳዋዳንነ ፓርሰ ቢታ ካተቱ ቂሮስ፥ ዳርዮስነ አርጸክሲሰ አዋዬዳዋዳን ጌሻ ጎሊ ኬጸቲደ ዉሬዳ።<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="HAG 1:1">ሃገ 1:1</ref>፤ <ref loc="ZEC 1:1">ዛካ. 1:1</ref></char></note> <verse eid="EZR 6:14"/><verse number="15" style="v" sid="EZR 6:15"/>ዳርዮስ ካተቴዳ ኡሱፑን ላይን አዳረ ጌተትያ አግናን ሄዘን ጋላሳን፥ ጎልያ ኪታይ ፖለቴዳ።<verse eid="EZR 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 6:16"/>ሄዋፐ ጉይያን፥ እስራኤልያ አሳይ፥ ቄሳቱ፥ ሌዋቱነ ኦሞዱዋፐ ስሜዳ አሳይ ኡባይ ጾሳ ጎልያ አንጁዋ ባላ ናሸቻን ቦንቼድኖ። <verse eid="EZR 6:16"/><verse number="17" style="v" sid="EZR 6:17"/>ሄ ጾሳ ጎልያ አንጁዋ ባላ ቦንችያ ዎደ፥ ኡንቱንቱ እት ጼቱ ኮሩማቱዋ፥ ላኡ ጼቱ ዶርሳ ኦርገቱዋነ ኦይዱ ጼቱ ዶርሳ ማራቱዋ ያርሼድኖ፤ ቃይ ናጋራ ያርሾ ታማነ ላኡ እስራኤልያ ዛራቱዋ ፓይዱዋን ታማነ ላኡ ዴሻ ኦርገቱዋካ ያርሼድኖ። <verse eid="EZR 6:17"/><verse number="18" style="v" sid="EZR 6:18"/>ሙሴ ማጻፋን ጻፈቴዳዋዳን፥ የሩሳላመን ደእያ ጾሳዉ ኦና ማላ፥ ቄሳቱ ዋ ባረንቱ ማራዳንነ ሌዋቱዋካ ኡንቱንቱ ዘረዳን ዎድኖ።<verse eid="EZR 6:18"/></para>
  <para style="s1">ፓስጋ ባላ</para>
  <para style="p">
    <verse number="19" style="v" sid="EZR 6:19"/>ኦሞዱዋፐ ስሜዳ አሳቱ ኮይሮ አግናን ታማነ ኦይደን ጋላሳን ፓስጋ ባላ ቦንቼድኖ።<note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="EXO 12:1-20">ከሳ 12:1-20</ref></char></note> <verse eid="EZR 6:19"/><verse number="20" style="v" sid="EZR 6:20"/>ቃይ ቄሳቱ ነ ሌዋቱ ባረና ጌሼድኖ፤ ሄዋ ድራዉ፥ ኡንቱንቱ ኡባይካ ጌሻ። ሄዋፐ ጉይያን፥ ሌዋቱ ኦሞዱዋፐ ስሜዳ ኡባዉ፥ ቄሳቶነ ባረንቱ ሁጲያዉ ፓስጋ ዶርሳ ሹኬድኖ። <verse eid="EZR 6:20"/><verse number="21" style="v" sid="EZR 6:21"/>ኦሞዱዋፐ ስሜዳ እስራኤልያ አሳይነ አይሁዳ ግደና አሳቱ ኦያ ቱናተፐ ባረንታ ሻክ፥ መና ጎዳኮ፥ እስራኤልያ ጾሳኮ ስሜዳ አሳይ ኡባይ ፓስጋ ሜድኖ። <verse eid="EZR 6:21"/><verse number="22" style="v" sid="EZR 6:22"/>ቃይ ኡንቱንቱ ላፑን ጋላሳዉ ማጋገ ኡክ ባላ ናሸቻን ቦንቼድኖ፤ አያዉ ጎፐ፥ መና ጎዳይ ኡንቱንቱ ናሸቼዳ፤ ቃይ መና ጎዳ፥ ሄዌካ እስራኤልያ ጾሳ ጎልያ ኡንቱንቱ ኬጺደ ፖላና ማላ፥ አሶረ ካትያ ቆፋ ጾሳይ ላምና፥ ካቲ ኡንቱንታ ማዴዳ።<verse eid="EZR 6:22"/></para>
  <chapter eid="EZR 6"/>
  <chapter number="7" style="c" sid="EZR 7"/>
  <para style="s1">እዝር ሀራ ኦሞደቴዳዋንቱና ስሙሳ</para>
  <para style="r">(<ref loc="EZR 7:1-10:44">7:1—10:44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 7:1"/>ሄዋፐ ስሚደ፥ ዳሮ ዎድያፐ ጉይያን፥ ፓርሰ ቢታን አርጸክስስ ካተቴዳ ዎድያን እዝራ ጌተትያ እት አሳይ ደኤዳ። እ ሳራያ ናኣ፤ ሳራይ አዛርያ ናኣ፤ አዛሪ ህልቂያ ናኣ፤ ህልቂ ሻሉማ ናኣ፤ <verse eid="EZR 7:1"/><verse number="2" style="v" sid="EZR 7:2"/>ሻሉም ጻዶቃ ናኣ፤ ጻዶቀ አህጹባ ናኣ፤ አህጹብ አማርያ ናኣ፤ <verse eid="EZR 7:2"/><verse number="3" style="v" sid="EZR 7:3"/>አማር አዛርያ ናኣ፤ አዛሪ ማራዮታ ናኣ፤ ማራዮት ዛራህያ ናኣ፤ <verse eid="EZR 7:3"/><verse number="4" style="v" sid="EZR 7:4"/>ዛራሂ ኡዛ ናኣ፤ ኡዝ ቡቃ ናኣ፤ <verse eid="EZR 7:4"/><verse number="5" style="v" sid="EZR 7:5"/>ቡቅ አብሹአ ናኣ፤ አብሹእ ፒንሃሳ ናኣ፤ ፒንሃስ ኤልኣዛራ ናኣ፤ ኤልኣዛረ ቄሰ ኡባቱዋ ካፑዋ አሮና ናኣ።<verse eid="EZR 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 7:6"/>ሀ እዝር ባብሎነፐ ፑደ ዬዳ። እ መና ጎዳይ፥ እስራኤልያ ጾሳይ እሜዳ ሙሴ ህግያ ሎይ ጻናዬዳ ኤራንቻ ጻፍያ። መና ጎዳ አ ጾሳ ኩሺ አ ቦላ ደእያ ድራዉ፥ እ ኦቼዳዋ ኡባ ካቲ አዉ እሜዳ። <verse eid="EZR 7:6"/><verse number="7" style="v" sid="EZR 7:7"/>እስራኤልያ አሳፐ አማሬዳዋንቱነ ቃይ ቄሳቱ ዋፐ፥ ሌዋቱዋፐ፥ ማዝሙርያ የጽያዋንቱፐ፥ ፐንግያ ናግያዋንቱፐነ ጌሻ ጎልያ ቆማቱዋፐ አማሬዳዋንቱ ካቲ አርጸክስስ ካተቴዳ ላፑን ላይን እዝራና እትፐ ፑደ የሩሳላመ ቤድኖ። <verse eid="EZR 7:7"/><verse number="8" style="v" sid="EZR 7:8"/>ካቲ ካተቴዳ ላፑን ላይን እቼሻን አግናን እዝር የሩሳላመ ጋኬዳ። <verse eid="EZR 7:8"/><verse number="9" style="v" sid="EZR 7:9"/>ኮይሮ አግናን ኮይሮ ጋላሳን ባብሎነፐ ፑደ ቡሳ ዶሚደ፥ እቼሻን አግናን ኮይሮ ጋላሳን የሩሳላመ ጋኬዳ። አያዉ ጎፐ፥ አ ጾሳ ሎኦ ኩሺ አ ቦላን ደኤ። <verse eid="EZR 7:9"/><verse number="10" style="v" sid="EZR 7:10"/>ሄዋ ጻላላ ግደናን እዝር መና ጎዳ ህግያ ጻናያናዉነ ኦናዉ፥ ቃይ እስራኤልያን አ ዎጋነ አ ፕርዳ ታማርሳናዉ ባረ ዎዛና ጊግስ ዎዳ።<verse eid="EZR 7:10"/></para>
  <para style="s1">ካቲ አርጸክስስ እዝራዉ ጻፊ እሜዳ ዳብዳቢያ</para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 7:11"/>መና ጎዳይ እስራኤልያዉ እሜዳ ህግያ ጻናዪደ፥ ሎይ ኤርያ ቄሰነ ጻፍያ ግድያ እዝራዉ ካቲ አርጸክሲሰ ዱቅ እሜዳ ዳብዳቢ ሀዋዳን ያጌ፦<verse eid="EZR 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 7:12"/>“ካተቱዋ ካትያ አርጸክስሳፐ፥ ቄስያነ ሳሉዋ ጾሳ ህግያ ሎይ ጻፍያ እዝራ፥ ሳሮተይ ነዉ ግዶ!<verse eid="EZR 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 7:13"/>“ታ ካዉተ ግዱዋን ደእያ እስራኤልያ አሳፐ ኦንነ፥ ቄሳቱ ዋፐ ዎይ ሌዋቱዋፐ ግዶፐነ፥ የሩሳላመ ባናዉ ኮይያ አሳይ ኡባይ ኔናና እትፐ ባናዳን ታን ኦዳድ። <verse eid="EZR 7:13"/><verse number="14" style="v" sid="EZR 7:14"/>ታንነ ታናና ዞረትያ ላፑን አሳቱ እትፐ ግዲደ፥ ኔን ነ ኩሽያን ደእያ ጾሳ ህግያዳን፥ ባደ ይሁዳንነ የሩሳላመን ደእያ ሀኖታይ አይ ማለንቶ ኦቻናዳን ኔና ኪቴቶ። <verse eid="EZR 7:14"/><verse number="15" style="v" sid="EZR 7:15"/>አዉ ደእያ ሳአይ የሩሳላመን ደእያ እስራኤልያ ጾሳዉ፥ ታን ካቲነ ታናና ዞረትያ አሳቱ ኑ ሸንያን እሜዳ ዎርቃነ ብራ እሞታቱዋ ኔን አካደ ባ። <verse eid="EZR 7:15"/><verse number="16" style="v" sid="EZR 7:16"/>ሄዋ ቦላካ ቃይ ኔን ባብሎነ ቢታ ኩመንፐ ደሜዳ ብራነ ዎርቃ ኡባ፥ ቃይ አሳይነ ቄሳቱ የሩሳላመን ደእያ ባረንቱ ጾሳ ጎልያዉ ባረንቱ ሸንያን እሜዳ እሞታካ አካደ ባ። <verse eid="EZR 7:16"/><verse number="17" style="v" sid="EZR 7:17"/>ሀ ሚሻን ኮሩማቱዋ፥ ዶርሳ ኦርገቱዋነ ዶርሳ ማራቱዋ፥ ቃይ ካ ያርሾነ ኡሻ ያርሾ ሻማነንቶ ኤራ፥ የሩሳላመን ደእያ ህንተንቱ ጾሳ ጎልያን ያርሽያ ሳኣን ያርሻ።<verse eid="EZR 7:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZR 7:18"/>“ሄዋፐ ፓላሂደ አቴዳ ብራነ ዎርቃ ኔንነ ኔናና ደእያ ነ ቢታ አሳቱ ኦናዉ ኮይያዋ ህንተንቱ ጾሳ ሸንያዳን ኦተ። <verse eid="EZR 7:18"/><verse number="19" style="v" sid="EZR 7:19"/>ቃይ ህንተንቱ ጾሳ ጎልያ ግዶን ኦሰትያ ኦሶ ህንተንቱ ጎኤታና ማላ፥ ኑን ነዉ እሜዳ ሚሻቱዋ ኡባ የሩሳላመ ጾሳ ስንን ዎ። <verse eid="EZR 7:19"/><verse number="20" style="v" sid="EZR 7:20"/>ሀዋፐ ሀራባይ ህንተንቱ ጾሳ ጎልያዉ ኮሽያባይ አያነ ግዶፐ፥ ሄዎ ኮሽያ ሻሉዋ ካትያ ጎለን ሻሉዋ ዎያ ጎልያፐ አካናዉ ዳንዳያሳ።<verse eid="EZR 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 7:21"/>“ሄዋ ድራዉ፥ ሀእ ታን ካቲ አርጸክስስ ኤፍራጺሳ ሻፋፐ አዋይ ዉልያ ባጋ ቢታን ደእያ ሻሉዋ ጎለን አዎተይ ደእያ ኡባቶ ሀ አዛዙዋ እማድ። ቄስያ ግድያነ ሳሉዋ ጾሳ ህግያ ሎይ ጻፍያ እዝር ህንተንታ ኦችያዋ አያነ ግዶፐነ አዉ እምተ። <verse eid="EZR 7:21"/><verse number="22" style="v" sid="EZR 7:22"/>ቃይ ሄዙ ሻአነ ኦይዱ ጼቱ ኪሎ ግራመ ዴጽያ ብራ፥ እት ጼቱ ኩንታለ ዛርጋ፥ ላኡ ሻአ ሊትሮ ዎይንያ ኤሳነ ላኡ ሻአ ሊትሮ ዎጋራ ዛይትያ፥ ቃይ ኮሽያ ኬሻ ማጽንያና ኡባ እዝራዉ እምተ። <verse eid="EZR 7:22"/><verse number="23" style="v" sid="EZR 7:23"/>ካትያ ቦላነ ካትያ ናና ካዉተ ቦላ ሀንቁ ዬና ማላ፥ ሳሉዋ ጾሳይ አዛዜዳዋ ኡባ ሳሉዋ ጾሳ ጎልያዉ አያነ አሸናን እምተ። <verse eid="EZR 7:23"/><verse number="24" style="v" sid="EZR 7:24"/>ቃይ ቄሳቱ ዋፐ፥ ሌዋቱዋፐ፥ ማዝሙርያ የጽያዋንቱፐ፥ ፐንግያ ናግያዋንቱፐ፥ ጾሳ ጎልያ ቆማቱዋፐነ ዱማ ዱማ ኦሱዋ ኦያ አሳ ኡባፐ ህንተንቱ ጊራነ ቃራጻ አካናዉ ህንተንቶ አይ ማትነ ባዋ።<verse eid="EZR 7:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZR 7:25"/>“ኔኖ እዝራ፥ ኔን ቃይ፥ ነዉ ጾሳይ እሜዳ ኤራተዳን ኤፍራጺሳ ሻፋፐ አዋይ ዉልያ ባጋ ቢታን ደእያ ነ ጾሳ ህግያ ኤርያ አሳ ቦላ ፕርዳና ማላ፥ ዳናቱዋነ ፕርድያዋንታ ሱን። ቃይ ሄ ህግያ ኤረናዋንቱ ደኦፐ፥ ኡንቱንቱ ታማርስተ። <verse eid="EZR 7:25"/><verse number="26" style="v" sid="EZR 7:26"/>ነ ጾሳ ህግያዉነ ካትያ ህግያዉ አዛዘተና ኦንነ ደኦፐ፥ እ ኤለካ ሀይቁዋን፥ የደሳን፥ አ ሻሉዋ ቦንቂያዋን ዎይ ቃሹዋን ሙረቶ” ያጌ።<verse eid="EZR 7:26"/></para>
  <para style="s1">እዝር ጾሳ ጋላቴዳ</para>
  <para style="p">
    <verse number="27" style="v" sid="EZR 7:27"/>የሩሳላመን ደእያ መና ጎዳ ጎልያ ሀዋዳን ሎይና ማላ፥ ካትያ ዎዛናን ሀ ቆፋ ዎዳ መና ጎዳዉ፥ ኑ አዎቱዋ ጾሳዉ ጋላታይ ግዶ! <verse eid="EZR 7:27"/><verse number="28" style="v" sid="EZR 7:28"/>ቃይ ካትያ፥ ካትያና ዞረትያዋንቱነ አናና ኦያ ዎልቃማ ካፓቱዋ ኡባ ስንን ባረ አገና ሲቁዋ ታዉ በሴዳ መና ጎዳ፥ ታ ጾሳ ኩሺ ታናና ደእያ ድራዉ፥ ታን ምነታድ። ቃይ እስራኤልያ ካፓቱዋፐ ታናና ፑደ ቢደ፥ የሩሳላመ ባና ማላ ሺሻይ።<verse eid="EZR 7:28"/></para>
  <chapter eid="EZR 7"/>
  <chapter number="8" style="c" sid="EZR 8"/>
  <para style="s1">እዝራና እትፐ ኦሞዱዋፐ ስሜዳ አሳ ፓይዱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 8:1"/>ካቲ አርጸክስስ ካተቴዳ ዎደ ታናና እትፐ ባብሎነ ቢታፐ ፑደ ዬዳ፥ የሩሳላመ ዬዳ ዛራቱዋ ካፓቱ ሀዋንታ፤ ኡንቱንቱ የለታ ማራይካ ሀዋ:<verse eid="EZR 8:1"/></para>
  <para style="li">
    <verse number="2" style="v" sid="EZR 8:2"/>ፒንሃሳ ያራፐ ገርሾማ፥ እታማራ ያራፐ ዳኔላ፥ ዳዊታ ያራፐ ሀጹኡሻ፥<verse eid="EZR 8:2"/></para>
  <para style="li">
    <verse number="3" style="v" sid="EZR 8:3"/>ሸካንያ ያራፐ፥ ፓርኦሻ ያራፐ ዛካራስነ ኡንቱንቱ የለታ ማራይ ጻፈቴዳ ሀራ እት ጼታነ እሻታሙ አቱማዋንታ፥<verse eid="EZR 8:3"/></para>
  <para style="li">
    <verse number="4" style="v" sid="EZR 8:4"/>ፓሀት-ሞኣባ ያራፐ ዛራህያ ናኣ ኤልዮኤናያነ አናና እትፐ ሀራ ላኡ ጼቱ አቱማዋንታ፥<verse eid="EZR 8:4"/></para>
  <para style="li">
    <verse number="5" style="v" sid="EZR 8:5"/>ዛቱ ያራፐ ያሃዝኤላ ናኣ ሸካንያነ አናና እትፐ ሀራ ሄዙ ጼቱ አቱማዋንታ፥<verse eid="EZR 8:5"/></para>
  <para style="li">
    <verse number="6" style="v" sid="EZR 8:6"/>አዲና ያራፐ ዮናታና ናኣ ኤቤዳነ አናና እትፐ ሀራ እሻታሙ አቱማዋንታ፥<verse eid="EZR 8:6"/></para>
  <para style="li">
    <verse number="7" style="v" sid="EZR 8:7"/>ኤላማ ያራፐ አታልያ ናኣ ይሻእያነ አናና እትፐ ሀራ ላፑን ታሙ አቱማዋንታ፥<verse eid="EZR 8:7"/></para>
  <para style="li">
    <verse number="8" style="v" sid="EZR 8:8"/>ሻፋጽያ ያራፐ ምካኤላ ናኣ ዛባድያነ አናና እትፐ ሀራ ሆስፑን ታሙ አቱማዋንታ፥<verse eid="EZR 8:8"/></para>
  <para style="li">
    <verse number="9" style="v" sid="EZR 8:9"/>ዮኣባ ዛርያፐ ይህኤላ ናኣ ኦባድያነ አናና እትፐ ሀራ ላኡ ጼታነ ታማነ ሆስፑን አቱማዋንታ፥<verse eid="EZR 8:9"/></para>
  <para style="li">
    <verse number="10" style="v" sid="EZR 8:10"/>ባና ያራፐ ዮሲፍያ ናኣ ሻሎሚታነ አናና እትፐ ሀራ እት ጼታነ ኡሱፑን ታሙ አቱማዋንታ፥<verse eid="EZR 8:10"/></para>
  <para style="li">
    <verse number="11" style="v" sid="EZR 8:11"/>በባያ ያራፐ በባያ ናኣ ዛካራሳነ አናና እትፐ ሀራ ላታማነ ሆስፑን አቱማዋንታ፥<verse eid="EZR 8:11"/></para>
  <para style="li">
    <verse number="12" style="v" sid="EZR 8:12"/>አዝጋዳ ያራፐ ሀቃጻና ናኣ ዮሀናናነ አናና እትፐ ሀራ እት ጼታነ ታሙ አቱማዋንታ፥<verse eid="EZR 8:12"/></para>
  <para style="li">
    <verse number="13" style="v" sid="EZR 8:13"/>አዶንቃማ ያራፐ ዉርሰን ስሜዳዋንቱ፥ ኤልፈሌጻ፥ ይኡኤላ፥ ሻማእያነ ኡንቱንቱና እትፐ ሀራ ኡሱፑን ታሙ አቱማዋንታነ፥<verse eid="EZR 8:13"/></para>
  <para style="li">
    <verse number="14" style="v" sid="EZR 8:14"/>ቃይ ብግዋያ ያራፐካ ኡታያ፥ ዛኩራነ ኡንቱንቱና እትፐ ሀራ ላፑን ታሙ አቱማዋንታ።<verse eid="EZR 8:14"/></para>
  <para style="s1">እዝር ጌሻ ጎልያን ኦያ ሌዋቱዋ ደሜዳ</para>
  <para style="p">
    <verse number="15" style="v" sid="EZR 8:15"/>ታን እዝር ኡንቱንቱ አሃዋ ግያ ሳኣኮ ጎግያ ሻፋ ኤለካ ሺሻይ። ኑን ሄ ሳኣን ዱንካኒደ፥ ሄዙ ጋላሳ ታኬዶ። ቃይ ታን ሄ ሳኣን ደእያ አሳነ ቄሳቱ ዋ ቆፕያ ዎደ፥ ሌዊያ ዛራቱዋፐ እቱዋነ ደማበይከ። <verse eid="EZR 8:15"/><verse number="16" style="v" sid="EZR 8:16"/>ሄዋ ድራዉ፥ ካፑዋ ኤልኤዛራ፥ አርኤላ፥ ሻማእያ፥ ኤልናታና፥ ያሪባ፥ ኤልናታና፥ ናታና፥ ዛካራሳነ ማሹላማ ግያዋንታነ ቃይ አዳ ኤራንቻ አሳ ግድያ ዮያሪባነ ኤልናታና ጼሳድ። <verse eid="EZR 8:16"/><verse number="17" style="v" sid="EZR 8:17"/>ኑ ጾሳ ጎልያን ኦያ አሳ ኑዉ የዳና ማላ፥ ካስፍያ ግያ ሳኣን ደእያ ሌዋቶ ካፑዋ ግድያ እዶኮነ አ አቱማ ዳቦቱዋኮ፥ ሄዋንቱካ ጌሻ ጎልያ ቆማ ግድያዋንቱኮ ኡንቱንታ ኪታድ። <verse eid="EZR 8:17"/><verse number="18" style="v" sid="EZR 8:18"/>ኑ ጾሳ ሎኦ ኩሺ ኑ ቦላን ደእያ ድራዉ፥ ሸረብያ አ ናናነ አ እሻቱዋና፥ ኡባና ታማነ ሆስፑኑዋ ኡንቱንቱ ኑዉ የዴድኖ። እ እስራኤልያ ናኣ ሌዊያ ዛርያ ግድያ ማህላ ያራነ ሎይ አኬካይ ደእያ አሳ። <verse eid="EZR 8:18"/><verse number="19" style="v" sid="EZR 8:19"/>ቃይ ሀሻብያ፥ ማራራ ያራ ግድያ ይሻእያራ፥ አ ናናነ አ እሻቱዋ ላታሙዋና የዴድኖ። <verse eid="EZR 8:19"/><verse number="20" style="v" sid="EZR 8:20"/>ሄዋ ቦላካ ሌዋቱዋ ማዳናዳን ጊደ፥ ዳዊተነ አናና ኦያ ካፓቱ ሱንዳ ጌሻ ጎልያ ቆማቱዋፐካ ላኡ ጼታነ ላታሙዋ የዴድኖ። ሄዋንቱ ኡባቱ ባረንቱ ሱንን ጻፈቴድኖ።<verse eid="EZR 8:20"/></para>
  <para style="s1">እዝር አሳይ ዎሳናዳንነ ጾማናዳን አዛዜዳ</para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 8:21"/>ሄዋፐ ጉይያን፥ ኑ ጾሳ ስንን ኑ ሁጲያ ካዉሺደ፥ እ ኑ ኦግያን ኑዉ፥ ኑ ናናቱዋነ ኑ ማጹዋ ኡባዉ ሳሮተ እማናዳን ዎሳና ማላ፥ ሄዋን አሃዋ ሻፋን ኤለካ ታን ጾማ አዋያድ። <verse eid="EZR 8:21"/><verse number="22" style="v" sid="EZR 8:22"/>አያዉ ጎፐ፥ ካትያዉ ኑን ካሰ፥ “ኑ ጾሳ ሎኦ ኩሺ አ ኮይያዋንቱና እትፐ ደኤ፤ ሽን አ ዎልቃማ ሀንቁ አ አግያዋንቱ ቦላን ደኤ” ያጊደ ኦዴዳ ድራዉ፥ ኑን ብያ ኦግያን ደእያ ሞርከቱዋፐ ኑና ናጋናዳን ኦላንቻቱዋነ ፓራ አሳቱዋ እማናዳን ካትያ ኦቻናዉ ታን ዬላታድ።<verse eid="EZR 8:22"/></para>
  <para style="s1">ጌሻ ጎልያ እሞታባ</para>
  <para style="p">
    <verse number="23" style="v" sid="EZR 8:23"/>ሄዋ ድራዉ፥ ኑን ጾሚደ፥ ጾሳ ዎሴዶ፤ እ ኑ ዎሳ ስሴዳ።<verse eid="EZR 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 8:24"/>ቄሳቱ ዋ ካፓቱዋፐ ሸረብያ፥ ሀሻብያነ ሀራ ኡንቱንቱ ዳቦ ግዴዳ ታሙ አቱማ አሳቱዋ ታን ዶራድ። <verse eid="EZR 8:24"/><verse number="25" style="v" sid="EZR 8:25"/>ካቲ፥ ካትያና ዞረትያዋንቱ፥ ካትያና ኦያዋንቱነ እስራኤልያ ኡባይ ኑ ጾሳ ጎልያዉ እሜዳ ብራ ዎርቃነ፥ ሚሻቱዋ ኡባ ልካደ ኡንቱንቱ ኩሽያን ሼድ። <verse eid="EZR 8:25"/><verse number="26" style="v" sid="EZR 8:26"/>ታን ኡንቱንቶ ልኬዳባይ ሀዋ: ላታማነ ላኡ ሻአ ኪሎ ግራመ ዴጽያ ብራ፥ ሄዙ ሻአነ ኦይዱ ጼቱ ኪሎ ግራመ ዴጽያ ብራፐ ኦሰቴዳ ጼቱ ሚሻቱዋ፥ ሄዙ ሻአነ ኦይዱ ጼቱ ኪሎ ግራመ ዴጽያ ዎርቃ፥ <verse eid="EZR 8:26"/><verse number="27" style="v" sid="EZR 8:27"/>ሆስፑን ኪሎ ግራመነ ኦይዱ ጼቱ ግራመ ዴጽያ ዎርቃፐ ኦሰቴዳ ላታሙ ሳነቱዋነ ዎርቃዳን አልኦነ ሙሩታ ግዴዳ ናሃስያፐ ኦሰቴዳ ላኡ ሳነቱዋ።<verse eid="EZR 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZR 8:28"/>ሄዋፐ ጉይያን፥ ታን ኡንቱንቶ ሀዋዳን ያጋድ፤ “ህንተነ ሀ ሚሻቱ ኡባይካ መና ጎዳዉ ዱማቴድታ፤ ሀ ብራይነ ዎርቃይ አሳይ ባረ ሸንያን መና ጎዳዉ፥ ህንተንቱ አዎቱዋ ጾሳዉ እሜዳዋ። <verse eid="EZR 8:28"/><verse number="29" style="v" sid="EZR 8:29"/>የሩሳላመን ደእያ መና ጎዳ ጎልያን ሻሉዋ ዎያ ጎልያ ጋኪደ፥ ቄስያ ካፓቱዋ ስንን፥ ሌዋቱዋ ስንንነ እስራኤልያ ዛራቱዋ ካፓቱዋ ስንን እማና ጋካናዉ፥ ሀ ሚሻቱዋ ሎይ ናግተ” ያጋድ። <verse eid="EZR 8:29"/><verse number="30" style="v" sid="EZR 8:30"/>ሄዋ ድራዉ፥ ቄሳቱ ነ ሌዋቱ የሩሳላመን ደእያ ኑ ጾሳ ጎልያዉ አፋናዉ ብራ፥ ዎርቃነ ሀራ ሚሻቱዋ ኡባ ሚዛንያን ልኪደ ሼቴድኖ።<verse eid="EZR 8:30"/></para>
  <para style="s1">የሩሳላመ ስማባ</para>
  <para style="p">
    <verse number="31" style="v" sid="EZR 8:31"/>ሄዋፐ ጉይያን፥ ኑን ኮይሮ አግናን ታማነ ላኤን ጋላሳን የሩሳላመ ባናዉ አሃዋ ሻፋ ማታፐ ደንዴዶ። ብያ ዎደ፥ ኑ ቦላን ደእያ ኑ ጾሳ ሎኦ ኩሺ ኑ ብያ ኦግያን ደእያ ሞርከቱዋፐነ ፓኖቱዋፐ ኑና ናጌዳነ አሼዳ። <verse eid="EZR 8:31"/><verse number="32" style="v" sid="EZR 8:32"/>ኑን የሩሳላመ ጋኪደ፥ ያን ሄዙ ጋላሳ ኡቴዶ።<verse eid="EZR 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EZR 8:33"/>ኦይደን ጋላስ ብራ፥ ዎርቃነ ሀራ ሚሻቱዋ ኡባካ ልኪደ፥ ኦርዮና ናኣ ቄስያ ማረሞታዉ ሼዶ። ፒንሃሳ ናኣ ኤልኣዛረ፥ ሌዊያ ግድያ ኢያሱ ናኣ ዮዛባድነ ቢኑያ ናኣ ኖኣደ አናና እትፐ ደኢኖ። <verse eid="EZR 8:33"/><verse number="34" style="v" sid="EZR 8:34"/>ኡባባይካ ፓይደቴዳነ ልከቴዳ፤ ኡባና አያ ኬሻ ግዴደንቶ፥ ሄ ዎደ ጻፈቴዳ።<verse eid="EZR 8:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EZR 8:35"/>ሄዋፐ ጉይያን፥ ኦሞዱዋፐ ስሜዳ አሳይ እስራኤልያ ጾሳዉ ጹግያ ያርሹዋ ያርሼድኖ። ኡንቱንቱ እስራኤልያ ኡባ ድራዉ፥ ታማነ ላኡ ኮሩማቱዋ፥ ኡዱፑን ታማነ ኡሱፑን ዶርሳ ኦርገቱዋነ ላፑን ታማነ ላፑን ዶርሳ ማራቱዋ፥ ቃይ ናጋራ ያርሾካ ታማነ ላኡ ዴሻ ኦርገቱዋ ያርሼድኖ። ሀዌ ኡባይ ጹግያ ያርሹዋ ግዲደ፥ መና ጎዳዉ ሺቄዳ። <verse eid="EZR 8:35"/><verse number="36" style="v" sid="EZR 8:36"/>ኡንቱንቱ ቃይ ካቲ አዛዜዳ አዛዙዋካ ካትያፐ ጋርሳና ቢታ ሞድያዋንቱነ ኤፍራጺሳ ሻፋፐ አዋይ ዉልያ ባጋ ቢታ ሞድያዋንቶ እሜድኖ፤ ኡንቱንቱ እስራኤልያ አሳነ ጾሳ ጎልያ ኪታ ማዴድኖ።<verse eid="EZR 8:36"/></para>
  <chapter eid="EZR 8"/>
  <chapter number="9" style="c" sid="EZR 9"/>
  <para style="s1">እዝር አይሁዳ ግደና አሳቱዋና ፖለቴዳ አካነ ገሉዋ ሴሬዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 9:1"/>ሀ ኡባባይ ሀኔዳዋፐ ጉይያን፥ አሳ ካለያዋንቱ ታኮ ዪደ፥ ሀዋዳን ያጌድኖ፤ “እስራኤልያ አሳይ፥ ሀራይ አቶ ቄሳቱ ካ ሌዋቱካ፥ ባረንቱ ሄራን ደእያ አይሁዳ ግደና አሳቱዋፐ ባረንታ ሻክበይክኖ። ኡንቱንቱካ ካናነቱ፥ ሂተቱ፥ ፓርዛዋናቱ፥ ያቡሳዋናቱ፥ አሞናቱ፥ ሞኣባቱ፥ ግብጼቱነ አሞራዋናቱ ኦያዋዳን ቱና ኦሱዋ ኦኖ። <verse eid="EZR 9:1"/><verse number="2" style="v" sid="EZR 9:2"/>ቃይ ባረንቶነ ባረንቱ ናናዉ አይሁዳ ግደና ማጫ ናናቱዋፐ ማቻቶ ኦደ አኬድኖ፤ ሄዋፐ ደንዴዳዋን ጌሻ ዘረቱ አይሁዳ ግደናዋንቱና ዋላከቴድኖ። ካለያዋንቱነ ካፓቱ አማነተናዋንታ ግዲደ፥ ሀዋ ማላ ኦናዉ ስን ጼራ ግደድኖ”።<verse eid="EZR 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 9:3"/>ታን ሀ የዉዋ ስሴዳ ዎደ፥ ታ ማዩዋነ ታ ቁማዩዋ ፔድ፤ ታ ሁጲያ ብናናነ ታ ቡቻካ ሾዳድ፤ ቃይ ዳሮ ዳጋማደ ኡታ አጋድ። <verse eid="EZR 9:3"/><verse number="4" style="v" sid="EZR 9:4"/>ኦሞዱዋፐ ስሜዳ አሳይ ኦዳ ናጋራ ድራዉ፥ እስራኤልያ ጾሳይ ኦዴዳ ቃላዉ ያዪደ አሳይ ኡባይ ታን ደእያ ሳኣ ታኮ ሺቄዳ። ኦማርሳ ያርሹዋ ያርሽያ ዎዲ ጋካናስካ ዳጋማደ ኡቶ ሳኣፐ ታን ደንዳበይከ።<verse eid="EZR 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 9:5"/>ሽን ኦማርስ ያርሹዋ ያርሽያ ዎዲ ጋክያ ዎደ፥ ታ ማዩነ ታ ቁማዩ ፖሸት ኡት ደእሽን፥ ታን ካዉሻደ ኡቶ ሳኣፐ ደንዳድ። ቃይ ጉልባታደ መና ጎዳ፥ ታ ጾሳኮ፥ ታ ኩሽያ ደንደ፥ ሀዋዳን ያጋደ ዎሳድ፤ <verse eid="EZR 9:5"/><verse number="6" style="v" sid="EZR 9:6"/>“አቤት ታ ጾሳዉ፥ ታን ታ ስን ኔኮ ፑደ ደንናዉካ ያያይነ ዬላታይ፤ አያዉ ጎፐ፥ ኑ ናጋራይ ዶረቲደ፥ ኑ ሁጲያፐ ፑደ አዳ፤ ኑ ናቁካ ሳሉዋ ጋኬዳ። <verse eid="EZR 9:6"/><verse number="7" style="v" sid="EZR 9:7"/>ኑን ኑ ማይዛ አዎቱዋ ዎድያፐ ዶሚደ፥ ሀቼ ጋካናዉ፥ ኔና ሎይ ናቄዶ። ኑ ናጋራፐ ደንደዳዋን ኑን፥ ኑ ካተቱነ ኑ ቄሳቱ ሀእዋዳንካ አላጋ ካተቱዋ ኩሽያን ማሻዉ፥ ኦሞዶ፥ ቦንቂያዋነ ዉርሰ ዬላዉ አደ እመቴዶ።<verse eid="EZR 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 9:8"/>“ሽን ሀእ ኑዉ ጉ ማሮተ ዎዲ እመቴዳ፤ አያዉ ጎፐ፥ መና ጎዳይ ኑ ጾሳይ ኑፐ አማሬዳ ዘረቱ አታና ማላ ኦዳ፤ ሀ ጌሻ ሳኣን እ ኑና ሳሮተን ዎዳ። ኑ ጾሳይ ኑ አይፍያ ዶዬዳ፤ ቃይ ኑ አይለተፐካ ኑዉ ጉ ኦራ ደኡዋ እሜዳ። <verse eid="EZR 9:8"/><verse number="9" style="v" sid="EZR 9:9"/>ኑን አይልያ ግዶፐነ፥ ኑ ጾሳይ ኑና አይለተን አግቤና፤ ኑ ደኡዋ ኦራዳ። ቃይ ኑ ጾሳ ጎልያ ኬጻና ማላ፥ ኮለቴዳዋ ኦራና ማላነ ይሁዳንነ የሩሳላመን ኑን ሳሮተን ደአና ማላ፥ ፓርሰ ቢታ ካተቱዋ ስንን ኑዉ ባረ አገና ሲቁዋ በሴዳ።<verse eid="EZR 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 9:10"/>“ሽን ኑ ጾሳዉ፥ ሀእ ያትና፥ ኑን ዋጋናዉ ዳንዳዬቶ? አያዉ ጎፐ፥ ኑን ሀእካ ነ አዛዙዋ አግ አጌዶ። <verse eid="EZR 9:10"/><verse number="11" style="v" sid="EZR 9:11"/>ትምቢትያ ኦድያ ነ ቆማቱዋ ባጋና ኔን ሀዋዳን ያጋዳ፤ ‘ህንተ ላታናዉ ገልያ ጋዲ ሄ ጋድያን ደእያ አሳ ቱናተፐ ደንዴዳዋን ቱኔዳ፤ ሀ ጋጻፐ ቢደ፥ ህን ጋጻ ጋካናዉ፥ ኡንቱንቱ አ ባረንቱ ቱና ኪታን ኩንድኖ። <verse eid="EZR 9:11"/><verse number="12" style="v" sid="EZR 9:12"/>ሄዋ ድራዉ፥ ህንተንቱ ምኖ ግዳና ማላ፥ ሄ ጋድያ አይፍያ ማና ማላነ መናዉ ህንተንቱ ናናቶ ላትሳና ማላ፥ ህንተንቱ ማጫ ናና ኡንቱንቱ አቱማ ናናዉ እሞፕተ፤ ኡንቱንቱ ማጫ ናናካ ህንተንቱ አቱማ ናናዉ አኮፕተ። ኡንቱንቱ ሳሮተንነ ዱረተን ደአና ማላካ አሞቶፕተ’።<note caller="-" style="x"><char style="xo" closed="false">9:12 </char><char style="xt" closed="false"><ref loc="EXO 34:11-16">ከሳ 34:11-16</ref>፤ <ref loc="DEU 7:1-5">ዛረ. 7:1-5</ref></char></note><verse eid="EZR 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 9:13"/>“ኑ ቦላ ጋኬዳ ኢታባይ ኡባይ ኑ ኢታ ኦሱዋፐነ ኑ ዎልቃማ ናቁዋፐ ደንዴዳዋና። ግዶፐነ፥ ኔን ኑ ጾሳይ ኑ ናጋራ ዳሩዋ ኬሻ ኑና ፕርዳበይካ፤ ሽን ኑፐ አማሬዳዋንታ ዘረዉ አሻዳ። <verse eid="EZR 9:13"/><verse number="14" style="v" sid="EZR 9:14"/>ያትና፥ ኑን ሀእካ ዛረደ፥ ሀዋ ማላ ቱናባ ኦያ አሳቱዋና እሙዋንነ አኩዋን ዋላከቲደ፥ ነ አዛዙዋ እጼዶ ጋኔ? ቃይ ሀ አቴዳ ጉ ዘረቱካ ያና ጋካናዉ፥ ነ ሀንቁ ኑ ቦላን ዳረኔየ? <verse eid="EZR 9:14"/><verse number="15" style="v" sid="EZR 9:15"/>መና ጎዳዉ፥ እስራኤልያ ጾሳዉ፥ ኔን ጽሉዋ። ኑ ናቁዋፐ ደንዴዳዋን ኑፐ እቱነ ነ ስንን ኤቃናዉ ዳንዳየናዋ ግዶፐነ፥ ኑን ዘረዉ አቴዳዋንቱ ሀቼ ሀዋን ነ ስንን ደኤቶ” ያጋድ።<verse eid="EZR 9:15"/></para>
  <chapter eid="EZR 9"/>
  <chapter number="10" style="c" sid="EZR 10"/>
  <para style="s1">አሳይ እዝራዉ እሞ ዛሩዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 10:1"/>እዝር ጾሳ ጎልያ ስንን ኩንድ ዬኪደ ዎስያ ዎደነ ናጋራካ ፓጽያ ዎደ፥ እስራኤልያ አሳፐ ዳሩ፥ ማጫዌ፥ አቱማዌነ ናናይ ኡባይ አኮ ሺቂደ፥ ምሻ ዬኩዋ አናና ዬኬድኖ። <verse eid="EZR 10:1"/><verse number="2" style="v" sid="EZR 10:2"/>ሄዋፐ ጉይያን፥ ኤላማ ያራ ግዴዳ ይህኤላ ናአይ ሻካነ ሀዋዳን ያጌዳ፤ “ኑን ሀ ቢታን ደእያ አይሁዳ ግደና ማጫዋንታ አኬዳ ድራዉ፥ ኑ ጾሳዉ አማነትበይኮ። ግዶፐነ፥ ቃይ እስራኤልያዉ ሀእካ ህዶታይ ደኤ። <verse eid="EZR 10:2"/><verse number="3" style="v" sid="EZR 10:3"/>ሄዋ ድራዉ ታ ጎዳዉ፥ ኔንነ ኑ ጾሳ አዛዞ ያይያዋንቱ ዞሬዳዋዳን ኑን ሀ ማቻቱዋነ ኡንቱቱፐ የለቴዳ ናና ኡባ የዳናዉ ኑ ጾሳና ጫቀቶይተ። ሀዌ ኡባይ ህጊ ግያዋዳን ፖለቶ። <verse eid="EZR 10:3"/><verse number="4" style="v" sid="EZR 10:4"/>ሀ የዉዋ ኑን ዎት ኦነንቶ፥ ኑና ካለናዌ ነ ኦሱዋ ግድያ ድራዉ፥ ደንዳ! ምና! ኑንካ ኔና ማዳና”።<verse eid="EZR 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 10:5"/>እዝር ደንድ ኤቂደ፥ ካለያ ቄሳቱ ዋ፥ ሌዋቱዋነ እስራኤልያ አሳ ኡባ ሀ ጌተቴዳዋዳን ኦና ማላ ጫቂሴዳ፤ ኡንቱንቱካ ጫቄድኖ። <verse eid="EZR 10:5"/><verse number="6" style="v" sid="EZR 10:6"/>ሄዋፐ ጉይያን፥ እዝር ጾሳ ጎልያ ስንፐ ደንዲደ፥ ኤልያሽባ ናአይ ያሆሀናን ደእያ ክፍልያ ገሌዳ። ኩመን ቃማ ኦሞዱዋፐ ስሜዳ አሳቱዋ ናጋራዉ ዬኪደ አቄዳ ድራዉ፥ ሄ ሳኣን ቁማ ምቤና፤ ሃካ ኡሽቤና።<verse eid="EZR 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 10:7"/>ሄዋፐ ጉይያን፥ ኦሞዱዋፐ ስሜዳ አሳይ ኡባይ የሩሳላመ ሺቃና ማላ፥ ይሁዳ ኡባንነ የሩሳላመን አዋዩዋ አዋዬድኖ። <verse eid="EZR 10:7"/><verse number="8" style="v" sid="EZR 10:8"/>ሀ ሄዙ ጋላሳ ግዶን ሄ ሳኣ ሺቀና ኦንነ ደኦፐ፥ አዉ ደእያባይ ኡባይ አፐ አከታናዳንነ እካ ኦሞዱዋፐ ስሜዳ ሺቁዋፐ ሻከቲደ የደርሰታናዳን ካፓቱነ ጭማቱ ኩሼድኖ።<verse eid="EZR 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZR 10:9"/>ሄ ጌተቴዳ ሄዙ ጋላሳቱ ዉረናን ደእሽን፥ ኡዱፑን አግናን ላታማን ጋላሳን ይሁዳነ ቢንያማ አሳይ ኡባይ የሩሳላመ ሺቂደ፥ ሀ ዴጾ የዉዋፐነ ዎልቃማ እራፐ ደንደዳዋን ኮኮሪደ፥ ጾሳ ጎልያ ስንን ደእያ ዳባባን ኡቴድኖ። <verse eid="EZR 10:9"/><verse number="10" style="v" sid="EZR 10:10"/>ሄዋፐ ጉይያን እዝር ደንድ ኤቂደ፥ ኡንቱንታ ሀዋዳን ያጌዳ፤ “አይሁዳ ግደና ማጫ አሳቱዋፐ ማቼቱዋ አኪደ ናቄድታ፤ ሄ ጋሱዋን እስራኤልያ አሳ ናቁዋ ካሰዋፐካ ያ ዳርሴድታ። <verse eid="EZR 10:10"/><verse number="11" style="v" sid="EZR 10:11"/>ሀእ ህንተንቱ ናጋራ መና ጎዳዉ፥ ህንተንቱ ማይዛ አዎቱዋ ጾሳዉ ፓጽተ፤ እ ዶስያባካ ኦተ። ሄ ቢታን ደእያ አይሁዳ ግደና አሳቱዋፐነ አይሁዳ ግደና ህንተንቱ ማቼቱዋፐ ሻከትተ”።<verse eid="EZR 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 10:12"/>ሄ ሳኣን ሺቄዳ ሺቁ ባረንቱ ኮሻ ቁ ኦደ፥ ሀዋዳን ያጌድኖ፤ “ኔን ኑዉ ኦዴዳዋዳን ኑን ኦናዉ በሰ። <verse eid="EZR 10:12"/><verse number="13" style="v" sid="EZR 10:13"/>ሽን አሳ ፓይዱ ጮራ፤ እራይ ዎልቃም ቡክያ ባልጉዋ። ያትያ ድራዉ፥ ኑን እራፐ አትያ ሳአይ ባይና ሳኣን ሀዋን ኤቃናዉ ዳንዳዮኮ። ቃይ ኑን ሀ የዉዋን ሎይ ናቄዳ ድራዉ፥ ሀዌ እት ጋላሳን ዎይ ላኡ ጋላሳን ጊግያባ ግደና። <verse eid="EZR 10:13"/><verse number="14" style="v" sid="EZR 10:14"/>ሄዋ ድራዉ፥ ሀ ሺቄዳ አሳ ኮታን ኑ ካፓቱ ኮሽያዋ ኦኖ። ሀ የዉዋፐ ደንዴዳዋን ኑ ጾሳ ዎልቃማ ሀንቁ ኑፐ ስማና ጋካናዉ፥ ኑ ካታማቱዋን ደእያ አይሁዳ ግደና ማጫዋንታ አኬዳ ኡባይ ኬሬዳ ዎድያን የሩሳላመ ዪኖ፤ ቃይ ሄ ካታማቱዋ ጭማቱነ ፕርድያዋንቱካ ኡንቱንቱና ዪኖ” ያጌድኖ። <verse eid="EZR 10:14"/><verse number="15" style="v" sid="EZR 10:15"/>አሳሄላ ናአይ ዮናታንነ ቲቅዋ ናአይ ያህዛይ ጻላላይ ኡንቱንቱ ቆፋ ጳልቄድኖ፤ ቃይ ማሹላምነ ሌዊያ ግዴዳ ሻባታይ ጳልቂያዋንታ ማዴድኖ።<verse eid="EZR 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 10:16"/>ሄዋ ድራዉ፥ ኦሞዱዋፐ ስሜዳ አሳይ ሄ ጌዳዋዳን ኦድኖ። ቄሲ እዝር ኡባ ዛራቱዋፐካ ካፓቱዋ ኡንቱንቱ ሱንን ሱንን ዶሬዳ። ታማን አግናን ኮይሮ ጋላሳን ካፓቱ የዉዋ ቆር ጼላናዉ ዶሜድኖ። <verse eid="EZR 10:16"/><verse number="17" style="v" sid="EZR 10:17"/>ኮይሮ አግናን ኮይሮ ጋላሳይ ጋክያ ዎደ፥ አይሁዳ ግደና ማጫዋንታ አኬዳ አሳቱዋ ኡባ ቆሪደ ዉርሴድኖ።<verse eid="EZR 10:17"/></para>
  <para style="s1">አይሁዳ ግደናዋንቱፐ ማችያ አኬዳ አሳ ሱን</para>
  <para style="p">
    <verse number="18" style="v" sid="EZR 10:18"/>አይሁዳ ግደና ማጫ አሳቱዋፐ ማችያ አኬዳዋንቱ ሀዋፐ ካሊደ ጻፈቴዳዋንታ።</para>
  <para style="p" vid="EZR 10:18">ቄሳቱ ዋፐ: ዮጸዴቃ ናና ግዴዳ ኢያሱነ አ እሻቱዋ ያራፐ ማእሴያ፥ ኤልኤዛራ፥ ያሪባነ ጋዳልያ። <verse eid="EZR 10:18"/><verse number="19" style="v" sid="EZR 10:19"/>ሀዋንቱ ባረንቱ አይሁዳ ግደና ማቼቱዋ የዳናዉ ጫቄድኖ፤ ቃይ ባረንቱ ናቁዋ ድራዉ፥ ዉድያፐ እት ዶርሳ ኦርግያ ናቁዋ ያርሹዋ ኦደ ያርሼድኖ። <verse eid="EZR 10:19"/><verse number="20" style="v" sid="EZR 10:20"/>እሜራ ያራን አይሁዳ ግደና ማቼቱዋ አኬዳዋንቱ ሀናናነ ዛባድያ። <verse eid="EZR 10:20"/><verse number="21" style="v" sid="EZR 10:21"/>ሀሪማ ያራቱዋፐ ማእሴያ፥ ኤላሳ፥ ሻማእያ፥ ይህኤላነ ኦዝያና። <verse eid="EZR 10:21"/><verse number="22" style="v" sid="EZR 10:22"/>ፓሽሁራ ያራቱዋፐ ኤልዮኤናያ፥ ማእሴያ፥ እስማኤላ፥ ናታንኤላ፥ ዮዛባዳነ ኤልኣሳ።<verse eid="EZR 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZR 10:23"/>ሌዋቱዋፐ: ዮዛባዳ፥ ሻማእያ፥ ቃሊጻ ግያ ቀላያ፥ ፓታህያ፥ ይሁዳነ ኤልኤዛራ።<verse eid="EZR 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 10:24"/>ማዝሙርያ የጽያዋንቱፐ: ኤልያሽባ።</para>
  <para style="p" vid="EZR 10:24">ፐንግያ ናግያዋንቱፐ: ሻሉማ፥ ጸለማነ ኡራ።<verse eid="EZR 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZR 10:25"/>ቃይ ሀራ እስራኤልያ አሳፐ: ፓርኦሻ ያራቱዋፐ ራምያ፥ ይዝያ፥ ማልክያ፥ ምያሚና፥ ኤልኣዛራ፥ ማልክያነ ባናያ።<verse eid="EZR 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EZR 10:26"/>ኤላማ ያራቱዋፐ ማታንያ፥ ዛካራሳ፥ ይህኤላ፥ አብዳ፥ ይረሞታነ ኤላሳ።<verse eid="EZR 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EZR 10:27"/>ዛቱ ያራቱዋፐ ኤልዮኤናያ፥ ኤልያሽባ፥ ማታንያ፥ ይረሞታ፥ ዛባዳነ አዚዛ።<verse eid="EZR 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZR 10:28"/>በባያ ያራቱዋፐ ያሆሀናና፥ ሀናንያ፥ ዛባያነ አትላያ።<verse eid="EZR 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EZR 10:29"/>ባና ያራቱዋፐ ማሹላማ፥ ማሉካ፥ አዳያ፥ ያሹባ፥ ሻኣላነ ይረሞታ።<verse eid="EZR 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZR 10:30"/>ፓሀት-ሞኣባ ያራቱዋፐ አድናሀ፥ ካላላ፥ ባናያ፥ ማእሴያ፥ ማታንያ፥ ባጻልኤላ፥ ቢኑያነ ምናሳ።<verse eid="EZR 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EZR 10:31"/>ሀሪማ ያራቱዋፐ ኤልኤዛራ፥ ይሽያ፥ ማልክያ፥ ሻማእያ፥ ሽምኦና፥ <verse eid="EZR 10:31"/><verse number="32" style="v" sid="EZR 10:32"/>ቢንያማ፥ ማሉካነ ሻማርያ።<verse eid="EZR 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EZR 10:33"/>ሀሹማ ያራቱዋፐ ማታናያ፥ ማታታ፥ ዛባዳ፥ ኤልፈሌሳ፥ የረማያ፥ ምናሳነ ሽምአ።<verse eid="EZR 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="EZR 10:34"/>ባና ያራቱዋፐ ማእዳያ፥ አምራማ፥ ኡኤላ፥ <verse eid="EZR 10:34"/><verse number="35" style="v" sid="EZR 10:35"/>ባናያ፥ በድያ፥ ካሉሀ፥ <verse eid="EZR 10:35"/><verse number="36" style="v" sid="EZR 10:36"/>ዋንያ፥ ማረሞታ፥ ኤልያሽባ፥ <verse eid="EZR 10:36"/><verse number="37" style="v" sid="EZR 10:37"/>ማታንያ ማታናያነ ያእሳ።<verse eid="EZR 10:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="EZR 10:38"/>ቢኑያ ያራቱዋፐ ሽምአ፥ <verse eid="EZR 10:38"/><verse number="39" style="v" sid="EZR 10:39"/>ሸሌምያ፥ ናታና፥ አዳያ፥ <verse eid="EZR 10:39"/><verse number="40" style="v" sid="EZR 10:40"/>ማክናዳባያ፥ ሻሻያ፥ ሻራያ፥ <verse eid="EZR 10:40"/><verse number="41" style="v" sid="EZR 10:41"/>አዛርኤላ፥ ሸሌምያ፥ ሻማርያ፥ <verse eid="EZR 10:41"/><verse number="42" style="v" sid="EZR 10:42"/>ሻሉማ፥ አማርያነ ዮሴፎ።<verse eid="EZR 10:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="EZR 10:43"/>ናቦ ያራቱዋፐ ይእኤላ፥ ማቲትያ፥ ዛባዳ፥ ዛቢና፥ ያዳያ፥ ዩኤላነ ባናያ።<verse eid="EZR 10:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="EZR 10:44"/>ሀዋንቱ ኡባቱ አይሁዳ ግደና ማቼቱዋ አኬዳዋንታ። እቱ እቱ ሀራይ አቶ ናናካ የሌድኖ።<verse eid="EZR 10:44"/></para>
  <chapter eid="EZR 10"/>
</usx>
