<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="REV" style="id">- Dawuro Full Bible Ethiopic Version</book>
  <para style="h">ዮሃንሳ ሳፃ</para>
  <para style="toc1">ዮናንሳዉ ዬዳ ሳፃ</para>
  <para style="toc2">ዮሃንሳ ሳፃ</para>
  <para style="toc3">ሳፃ</para>
  <para style="mt2">ዮሃንሳዉ</para>
  <para style="mt1">ዬዳ ሳፃ</para>
  <para style="imt">ገሉዋ</para>
  <para style="ip">ዮሃንሳዉ ዬዳ ሳጻይ ጻፈቴዳዌ፥ አማንያ አሳቱ የሱስ ክርስቶሳ ባረንቱ ጎዳ ኦደ፥ ጌሻተን ደኤዳ ድራዉ፥ ኡንቱንታ መቱነ ዋዪ ጋኬዳ ዎድያና። ጻፍያ ሁጰ ቆፋይ፥ ናባብያዋንቱ ህዶታይ ኩመን ግዳናዳን፥ ኡንቱንታ መንናሳነ ባረንታ ጋኬዳ የደሳነ መቱዋ ግዶን ባረንቱ አማኑዋን ምናናዳን፥ ኡንቱንታ ምንሳናሳ።</para>
  <para style="ip">ማጻፋ ግዶን ዳርያ ባጋይ ዳራነ ካል ካሊደ ቆንጬዳ ሳጻቱዋ ኦይቄዳዋ። ሳጻቱ ሄ ላይን ደእያ አማንያ አሳዉ ገልያዋንታ። ሽን ሀራቶ ጹራ ግዲደ ቆንጨና ሃሳያን ሺቄድኖ። ማዝሙርያ አዝማች ዛረትያዋዳን፥ ሀ ማጻፋ ግዶን ደእያ ሁጰ የዋቱዋ ዱማ ዱማ ሳጻቱ ባጋና ዱማ ዱማ ማላንነ ዱማ ዱማ ምስልያ ፓይዳቱዋን ዛር ዛሪደ ሺቄድኖ። ሀ ማጻፋ ጼልያዋን ዱማ ዱማ ቆፋይ ደኦፐነ አዉ ግዶ ቆፋይ ቆንጬ። ሄዌነ፥ “ጾሳይ ጎዳ ግዴዳ ክርስቶሳ ባጋና ላኤና ሀኖታን፥ ባረ ሞርከቱዋ፥ ሴጻናናካ እትፐ፥ እት ገደ ዉርሰ ጾኑዋ ጾናና። ፖሌዳዋፐ ጉይያን ባረዉ አማነቲደ ደኤዳ፥ ባረ ባጋቱዋ ኦራ ሳሉዋነ ኦራ ሳኣ አንጁዋ ላትሳና” ያግያዋ።</para>
  <para style="iot">ሸምፓቱዋ ኡባቶ እመቴዳ ቃን ቆፋቱዋ</para>
  <para style="io1">ገሉዋ <char style="ior"><ref loc="REV 1:1-8">1:1-8</ref></char></para>
  <para style="io1">ሳፃ ዶያነ ላፑ ዎሳ ጎለቶ ኪተቴዳ ኪታ <char style="ior"><ref loc="REV 1:9-3:22">1:9—3:22</ref></char></para>
  <para style="io1">ማጻፋነ ላፑ ማታፋቱዋ <char style="ior"><ref loc="REV 4:1-8:1">4:1—8:1</ref></char></para>
  <para style="io1">ላፑ ማላካታቱዋ <char style="ior"><ref loc="REV 8:2-11:19">8:2—11:19</ref></char></para>
  <para style="io1">ዳዊያነ ላኡ መሄቱዋ <char style="ior"><ref loc="REV 12:1-13:18">12:1—13:18</ref></char></para>
  <para style="io1">ዱማ ዱማ ሳጻቱዋ <char style="ior"><ref loc="REV 14:1-15:8">14:1—15:8</ref></char></para>
  <para style="io1">ጾሳ ሀንቁዋ ላፑ ጹአቱዋ <char style="ior"><ref loc="REV 16:1-21">16:1-21</ref></char></para>
  <para style="io1">ባብሎነ ባሻ፥ ዱኣ፥ ዎርዶ ናብያነ ሴጻናይ ጾነትያዋ <char style="ior"><ref loc="REV 17:1-20:10">17:1—20:10</ref></char></para>
  <para style="io1">ዉርሰ ፕርዳ <char style="ior"><ref loc="REV 20:11-15">20:11-15</ref></char></para>
  <para style="io1">ኦራ ሳሉዋ፥ ኦራ ሳኣነ ኦራ የሩሳላሞ <char style="ior"><ref loc="REV 21:1-22:5">21:1—22:5</ref></char></para>
  <para style="io1">ዉርሰ ቁትያ <char style="ior"><ref loc="REV 22:6-21">22:6-21</ref></char></para>
  <chapter number="1" style="c" sid="REV 1"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1"/>ኤሌል ሀናናዉ በስያዋ ባረ ኦሳንቻቱዋ በሳና ማላ፥ ጾሳይ የሱስ ክርስቶሳዉ እሜዳ ሳጻይ ሀዋ፤ የሱስ ባረ ኪታንቻ ኪቲደ፥ ሀ ሳፃ ባረ ኦሳንቻ ዮሃንሳ ኤርሴዳ። <verse eid="REV 1:1"/><verse number="2" style="v" sid="REV 1:2"/>ዮሃንስ በኢደ ቱማተን ኦዴዳ ኡባባይ፥ ጾሳ ቃላነ የሱስ ክርስቶሳ ማርካተ። <verse eid="REV 1:2"/><verse number="3" style="v" sid="REV 1:3"/>ሀ ማጻፋ ናባብያ ኡራይ<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="fk" closed="false">ናባብያ ኡራይ፦ </char><char style="ft" closed="false">ሀዋ ጉሳይ ኡባ አሳይ እትፐ ጾሳ ጎሸትያ ዎደን ሄዋንቶ ቃላ ናባብያ ኡራይ አንጀቴዳዋ ጉሳ።</char></note> አንጀቴዳዋ፤ ቃይ ሀ ትምቢትያ ማጻፋ ስስያዋንቱነ ሀ ማጻፋን ጻፈቴዳዋ ናግያዋንቱ አንጀቴዳዋንታ፤ አያዉ ጎፐ፥ ሀ የዉ ፖለታናዉ ዎዲ ማታቴዳ።<verse eid="REV 1:3"/></para>
  <para style="s1">ኢስያን ደእያ ላፑ ዎሳ ጎለቶ ኪተቴዳ ሳሮታ</para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 1:4"/>ታን ዮሃንስ፥ ኢስያ ጋድያን<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="fk" closed="false">ኢስያ ጋድያ፦ </char><char style="ft" closed="false">1:4—3:22 ደእያዌ ዳብዳቢያ ግዲደ ጻፈቴዳ። ኢስያ ጋዲ አዋይፊ ዶልያ ባጋና ደእያ ሮመ ካዉተ ግዲደ ሀእ ሀ ዎድያን ቱርከ ጋድያ ጊደ ጼሰትያዋ።</char></note> ደእያ ላፑ ዎሳ ጎለቶ ያጋይ፤</para>
  <para style="q2" vid="REV 1:4">ካሰ ደእያ ጾሳፐ፥</para>
  <para style="q2" vid="REV 1:4">ሀእካ ደእያ ጾሳፐ፥</para>
  <para style="q2" vid="REV 1:4">ስንፐካ ያና ጾሳፐ፥</para>
  <para style="q2" vid="REV 1:4">ቃይ አ ካዉተ ኦይድያ ስንን ደእያ ላፑ አያናቱዋፐ፥</para>
  <para style="q2" vid="REV 1:4">አ ኬካተይነ ሳሮተይ፥</para>
  <para style="q2" vid="REV 1:4">ህንተንቶ ግዶ።<note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="EXO 3:14">ከሳ 3:14</ref>፤ <ref loc="REV 4:5">ሳፃ 4:5</ref></char></note><verse eid="REV 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 1:5"/>ቃይ አማነቴዳ ማርካ፥</para>
  <para style="q2" vid="REV 1:5">ሀይቁዋፐ ኮይሮ ደንዴዳ ናኣፐ፥</para>
  <para style="q2" vid="REV 1:5">ሳኣ ካታቱዋ ሞድያ የሱስ ክርስቶሳፐ፥</para>
  <para style="q2" vid="REV 1:5">አ ኬካተይነ ሳሮተይ፥</para>
  <para style="q2" vid="REV 1:5">ህንተንቶ ግዶ።</para>
  <para style="q1" vid="REV 1:5">እ ኑና ሲቄነ፥</para>
  <para style="q2" vid="REV 1:5">ቃይ ኑ ናጋራ አይለተፐካ፥</para>
  <para style="q2" vid="REV 1:5">ባረ ሱን ኑና ከሴዳ።<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="ISA 55:4">ኢሳ. 55:4</ref>፤ <ref loc="PSA 89:27">ማዝ. 89:27</ref></char></note><verse eid="REV 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 1:6"/>ኑና ባረ ጾሳዉነ አዎ ኦና ማላ፥</para>
  <para style="q2" vid="REV 1:6">እ ኑና ካታቱዋነ፥</para>
  <para style="q2" vid="REV 1:6">ቄሳቱዋ ኦዳ፤</para>
  <para style="q2" vid="REV 1:6">አዉ መናፐ መና ጋካናዉ፥ ቦንቹነ</para>
  <para style="q2" vid="REV 1:6">ሞድያ ዎልቃይ ግዶ። አመንእ።<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="EXO 19:6">ከሳ 19:6</ref>፤ <ref loc="REV 5:10">ሳፃ 5:10</ref></char></note><verse eid="REV 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 1:7"/>በእተ፥</para>
  <para style="q2" vid="REV 1:7">የሱስ ሻርያን ዬ።</para>
  <para style="q1" vid="REV 1:7">አሳይ ኡባይ፥ ሀራይ አቶ፥</para>
  <para style="q2" vid="REV 1:7">አ ጫዴዳዋንቱካ፥ አ በአና፤</para>
  <para style="q2" vid="REV 1:7">ሳኣን ደእያ አሳይ ኡባይ፥</para>
  <para style="q2" vid="REV 1:7">አ ጋሱዋን ዬካናዋንታ።</para>
  <para style="q1" vid="REV 1:7">ሀዌ ቱሙፐ ሀናናዋ። አመንእ።<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳኔላ 7:13</ref>፤ <ref loc="MAT 24:30">ማቶሳ 24:30</ref>፤ <ref loc="MRK 13:26">ማር. 13:26</ref>፤ <ref loc="LUK 21:27">ሉቃሳ 21:27</ref>፤ <ref loc="1TH 4:17">1 ተስ. 4:17</ref>፤ <ref loc="ZEC 12:10">ዛካ. 12:10</ref>፤ <ref loc="JHN 19:34">ዮሃ. 19:34</ref>፣ <ref loc="JHN 19:37">37</ref></char></note><verse eid="REV 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8"/>ካሰ ደእያዌ፥ ሀእካ ደእያዌ፥ ስንፐካ ያና ጎዳይ፥ ኡባፐ ዎልቃማ ጾሳይ፥ “ኡባባዉ አልፋይነ ኦሜጋይ፥ ኮይሩነ ዉርሰይ ታና”<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="fq" closed="false">አልፋይነ ኦሜጋይ፦ </char><char style="ft" closed="false">ሀዋ ጉሳይ ኦራ ጫቁ ኮይሮ ግሪከ ቃላን ጻፈቴዳ ድራዉ፥ ኮይሩነ ዉርሰይ ጋናዉ ኮዪደ፥ አልፋ ግያ ግሪከ ኮይሮ ፕዶልያ አኪደ ዉርሰዉ ቃይ ኦሜጋ ግያ ዉርሰን ደእያ ፕዶልያ አኬድኖ። ሀዋንታ ጉሳይ ሌምሱዋን ዳዉሮዋ ፕዶላቱዋ አክንቶ [አ - ዝ] ያግያዋ ማላ ጉሳ።</char></note> ያጌ።<note caller="-" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="REV 22:13">ሳፃ 22:13</ref>፤ <ref loc="EXO 3:14">ከሳ 3:14</ref></char></note><verse eid="REV 1:8"/></para>
  <para style="s1">ክርስቶስ ሳጻን ቆንጬዳዋ</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9"/>ታን ዮሃንስ፥ ህንተንቱ እሻይ፥ ህንተናና የሱስ ክርስቶሳ ዋይያነ አ ካዉተ ቃይ አ ዳንዳያ እትፐ ሻከትያዌ፥ ጾሳ ቃላ ኦዴዳ ድራዉነ የሱሳዋ ማርካቴዳ ድራዉ፥ ፒጽሞ ግያ ሃይ ዶዶ ቢታን ደኣድ። <verse eid="REV 1:9"/><verse number="10" style="v" sid="REV 1:10"/>ጎዳ ጋላሳን ታን አያናን ደአይ፤ ታን ታፐ ጉየና ማላካታ ዋሱዋ ማላ ዎልቃማ ኮሻ ስሳድ። <verse eid="REV 1:10"/><verse number="11" style="v" sid="REV 1:11"/>ሄ ኮሻይ ታና፥ “ኔን በእያዋ ማጻፋን ጻፋ፤ ኢስያን ደእያ ላፑ ዎሳ ጎለቶ፥ ኤፈሶና፥ ሳምርኔሳ፥ ጰርጋሞና፥ ትያጽሮና፥ ሳርዴሳ፥ ፕላደልፍያ፥ ሎዶቅያ ዎሳ ጎለቶ ዬዳ” ያጌዳ።<verse eid="REV 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12"/>ታን ታዉ ኦድያ ኮሻ በአናዉ ጉየ ስማድ፤ ጾምፕያ ዎያ ላፑ ዎርቃ ባላቱዋ በኣድ። <verse eid="REV 1:12"/><verse number="13" style="v" sid="REV 1:13"/>ሄ ባላቱዋ ግዶን አሳ ናኣ ማላትያዋ በኣድ፤ አዱሳ አፍላ ባረ ገድያ ጋ ማዪደ፥ ዎርቃ ዳንጩዋ ባረ ትራን ዩሽ አዳ።<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳኔላ 7:13</ref>፤ <ref loc="DAN 10:5">10:5</ref></char></note> <verse eid="REV 1:13"/><verse number="14" style="v" sid="REV 1:14"/>አ ሁጲነ አ ሁጲያ ብናናይ ቦ ዶርሳ እስክያነ ሄዋፐካ አደ ሻቻ ማላቴ፤ አ አይፊካ ታማ ላጩዋ ማላቴ።<note caller="-" style="x"><char style="xo" closed="false">1:14-15 </char><char style="xt" closed="false"><ref loc="DAN 7:9">ዳኔላ 7:9</ref>፤ <ref loc="DAN 10:6">10:6</ref></char></note> <verse eid="REV 1:14"/><verse number="15" style="v" sid="REV 1:15"/>አ ገዲካ ጮጭያ ታማን ቴሪደ ጶልያ ናሃስያ ግያ ብራታ ማላቴ፤ አ ኮሻይካ ዎልቃማ ሻፋ ጉን ማላ።<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="EZK 1:24">ህዝ. 1:24</ref>፤ <ref loc="EZK 43:2">43:2</ref></char></note> <verse eid="REV 1:15"/><verse number="16" style="v" sid="REV 1:16"/>እ ባረ ኡሸቻ ኩሽያን ላፑ ጾልንታቱዋ ኦይቄዳ። አ ዶናፐ ላኡ ባጋና ቃረቴዳ ማሻይ ከሴዳ። አ ዴሙካ ሎይ ፖእያ አዋይፍያ ማላቴ።<verse eid="REV 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 1:17"/>ታን አ በኤዳ ዎደ ሀይቄዳዋዳን ሀናደ፥ አ ገድያ ማታን ኩንዳድ። ባረ ኡሸቻ ኩሽያ ታ ቦላ ዎደ፥ ታና ሀዋዳን ያጌዳ፤ “ያዮፓ፤ ኮይሩካ ዉርሰይካ ታና።<note caller="-" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="ISA 44:6">ኢሳ. 44:6</ref>፤ <ref loc="ISA 48:12">48:12</ref>፤ <ref loc="REV 2:8">ሳፃ 2:8</ref>፤ <ref loc="REV 22:13">22:13</ref></char></note> <verse eid="REV 1:17"/><verse number="18" style="v" sid="REV 1:18"/>ታን ደኡዋን ደእያዋ። ታን ሀይቃድ፤ ሽን በአ፥ መ መናዉካ ደኡዋን ደአይ። ሀይቁዋ ቁልፒነ ስኦልያ ቁልፒ ታ ኩሽያን ደኤ። <verse eid="REV 1:18"/><verse number="19" style="v" sid="REV 1:19"/>ስም ኔን በኤዳባነ ሀእ ደእያዋ፥ ቃይ ስንፐ ሀናናባ ጻፋ። <verse eid="REV 1:19"/><verse number="20" style="v" sid="REV 1:20"/>ኔን ታ ኡሸቻ ኩሽያን በኤዳ ላፑ ጾልንታቱዋ ብለይነ ቃይ ጾምፓቱዋ ዎያ ላፑ ዎርቃ ባላቱዋ ብለይ ሀዋ፤ ላፑ ጾልንታቱ ላፑ ዎሳ ጎለቱዋ ኪታንቻቱዋ፤<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="fk" closed="false">ኪታንቻቱዋ፦ </char><char style="ft" closed="false">ሀዋንታ ጉሳይ አማንያዋንታ ካለያ ጭማቱዋ ዎይ አማንያዋንቶ ኪተቴዳዋንታ።</char></note> ዎሳ ጎልያ ላፑ ዎርቃ ባላቱ ላፑ ዎሳ ጎልያ።”<verse eid="REV 1:20"/></para>
  <chapter eid="REV 1"/>
  <chapter number="2" style="c" sid="REV 2"/>
  <para style="s1">(1) የሱስ ኤፈሶነን ደእያ ዎሳ ጎለዉ ጎዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1"/>ኤፈሶነን ደእያ ዎሳ ጎለ ኪታንቻዉ ሀዋዳን ያጋደ ጻፋ:</para>
  <para style="b" vid="REV 2:1"/>
  <para style="p" vid="REV 2:1">“ባረ ኡሸቻ ኩሽያን ላፑ ጾልንትያ ኦይቄዳዌ፥ ጾምፓቱዋ ዎያ ላፑ ዎርቃ ባላቱዋ ግዱዋና ሀመትያዌ ሀዋዳን ያጌ። <verse eid="REV 2:1"/><verse number="2" style="v" sid="REV 2:2"/>ታን ነ ኪታ፥ ነ ዳቡራነ ነ ገንጩዋ ኤራይ። ቃይ ኔን ኢታ አሳቱዋ ገንጫናዉ ዳንዳያቤናዋካ ታን ኤራይ፤ የሱስ ኪቴዳዋንታ ግደናን ደኢደ ባረንታ፥ ‘ኑን የሱስ ኪቴዳዋንታ’ ግያዋንታ ኔን ጾሞሳደ፥ ኡንቱንቱ ዎርዶ ግድያዋ ደሜዳዋካ ኤራይ። <verse eid="REV 2:2"/><verse number="3" style="v" sid="REV 2:3"/>ኔን ገንጫዳ፤ ቃይ ታ ሱን ድራዉካ መቱዋ ዳንዳያዳ፤ ዳቡራበይካ። <verse eid="REV 2:3"/><verse number="4" style="v" sid="REV 2:4"/>ሽን ታን ኔና ካያባይ ደኤ፤ አያዉ ጎፐ፥ ኔን ካሰ ነ ሲቁዋ አጋዳ። <verse eid="REV 2:4"/><verse number="5" style="v" sid="REV 2:5"/>ስም ኔን ሀቃፐ ኩንዳድንቶ አኬካ። ነ ናጋራፐ ስማ፤ ኔን ካሰ ኦያ ኦሱዋ ኦ። ሄዌ ዮፐ፥ ታን ኔኮ ያና፤ ያደ ኔን ነ ናጋራፐ ስማና ዮፐ፥ ኔን ጾምፕያ ዎያ ነ ባላ አ ሳኣፐ አካ ድጋና። <verse eid="REV 2:5"/><verse number="6" style="v" sid="REV 2:6"/>ሽን እትባ ሎይዳ፤ ኒቆላዋቱዋ ኦሱዋ፥ ታን እጽያዋ ኔንካ እጻዳ።<verse eid="REV 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 2:7"/>“ስሳናዉ ሀይይ ደእያ ኡራይ ጌሻ አያናይ ዎሳ ጎለቶ ግያዋ ስሶ፤ ታን ጾንያ ኡራዉ ጾሳ ገነትያን ሞክያ ደኡዋ ም አይፍያ ማናዉ እማና ያጌ”</para>
  <para style="m" vid="REV 2:7">ያጋደ ጻፋ።<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="GEN 2:9">ዶመ 2:9</ref>፤ <ref loc="REV 22:2">ሳፃ 22:2</ref>፤ <ref loc="EZK 28:13">ህዝ. 28:13</ref>፤ <ref loc="EZK 31:8">31:8</ref></char></note><verse eid="REV 2:7"/></para>
  <para style="s1">(2) የሱስ ሳምርኔሳን ደእያ ዎሳ ጎለዉ ጎዋ</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8"/>ሳምርኔሳን ደእያ ዎሳ ጎለ ኪታንቻዉ ሀዋዳን ያጋደ ጻፋ:</para>
  <para style="b" vid="REV 2:8"/>
  <para style="p" vid="REV 2:8">“ሀይቄዳዌ፥ ሀይቁዋፐካ ደንዴዳዌ፥ ኮይሩነ ዉርሰይ ሀዋዳን ያጌ።<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="ISA 44:6">ኢሳ. 44:6</ref>፤ <ref loc="ISA 48:12">48:12</ref>፤ <ref loc="REV 1:17">ሳፃ 1:17</ref>፤ <ref loc="REV 22:13">22:13</ref></char></note> <verse eid="REV 2:8"/><verse number="9" style="v" sid="REV 2:9"/>ታን ነ ዋይያነ ነ ህዬሳተ ኤራይ፤ ሽን ኔን ዱረ። አይሁዳ ግደናን ደኢደ ባረንታ፥ ኑን አይሁዳ ግያዋንቱ ቦርያዋ ታን ኤራይ፤ ሽን ኡንቱንቱ ሴጻና ማባራን ደኢኖ። <verse eid="REV 2:9"/><verse number="10" style="v" sid="REV 2:10"/>ኔን ዋየታና ዋየዉ ያዮፓ። በአ፥ ጻላህያ ካፑ ህንተፐ አማሬዳዋንታ ጾሞሳናዉ ቃሾ ጎለን የጋና፤ ታሙ ጋላሳ ጋካናዉ ህንተንቱ ዋየታና። ሀይቃና ጋካናስካ አማነቴዳዋ ግዳ፤ ታን ነዉ ደኡዋ ካላቻ<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="fk" closed="false">ደኡዋ ካላቻ፦ </char><char style="ft" closed="false">ቦንቼቴዳ ደኡዋ።</char></note> እማና።<verse eid="REV 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 2:11"/>“ሀይይ ደእያ ኡራይ ጌሻ አያናይ ዎሳ ጎለቶ ግያዋ ስሶ!</para>
  <para style="p" vid="REV 2:11">“ጾንያ ኡራይ ላኤንዋ ሀይቁዋን<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="fk" closed="false">ላኤንዋ ሀይቁዋ፦ </char><char style="ft" closed="false">ኮይሮ ሀይቁ አሹ ሸምፑዋፐ ሻከትያዋ ግዶደ፥ ላኤን ሀይቁ ሸምፑ መናዉ መቶቲደ ደእያ ሀይቁዋ።</char></note> ቆሄተና ያጌ”</para>
  <para style="m" vid="REV 2:11">ያጋደ ጻፋ።<verse eid="REV 2:11"/></para>
  <para style="s1">(3) የሱስ ጰርጋሞናን ደእያ ዎሳ ጎለዉ ጎዋ</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12"/>ጰርጋሞናን ደእያ ዎሳ ጎለ ኪታንቻዉ ሀዋዳን ያጋደ ጻፋ:</para>
  <para style="b" vid="REV 2:12"/>
  <para style="p" vid="REV 2:12">“ላኡ ባጋና ሌፈቴዳ ማሻይ ደእያዌ ሀዋዳን ያጌ። <verse eid="REV 2:12"/><verse number="13" style="v" sid="REV 2:13"/>‘ታን ኔን ደእያ ሳኣ ኤራይ። ኔን ሴጻና ካዉተ ኦይዲ ደእያ ሳኣን<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="fq" closed="false">ሴጻና ካዉተ ኦይዲ፦ </char><char style="ft" closed="false">ሀዋ ብለይ ሎይደ ቆንጨ ግደና፥ ሽን ሀዌ በስያዌ ጾሳ ኤረናን እጼዳዋንቱ ጎይንያ ጎይና ሳኣ ጋና ዳንዳየቴ።</char></note> ደኣሳ፤ ታ ሱን ምንሳ ናጋሳ። ሀራይ አቶ፥ ሴጻናይ ደእያ ሳኣን ህንተንቱ ማታን አሳይ ዎዳ ታን አማንያ ማርካይ አንትጳስ ደእያ ዎደካ ታና አማንያዋ አጋ በይካ። <verse eid="REV 2:13"/><verse number="14" style="v" sid="REV 2:14"/>ሽን ታን ኔና ቦርያ ጉባይ ደኤ፤ እስራኤልያ አሳይ ኤቃዉ ያርሼዳ ቁማ ማናዳንነ ዎሹማናዳን ኡንቱንታ ናጋራ ኦስሴዳ ባላቃ ታማርሴዳ ባላማ ትምርትያ ታማርያ አማሬዳ አሳቱ ኔናና ደኢኖ።<note caller="-" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="NUM 25:5">ፓይ. 25:5</ref>፣ <ref loc="NUM 25:7">7</ref>፤ <ref loc="NUM 31:16">31:16</ref>፤ <ref loc="DEU 23:4">ዛረ. 23:4</ref>፤ <ref loc="NUM 25:1-3">ፓይ. 25:1-3</ref></char></note> <verse eid="REV 2:14"/><verse number="15" style="v" sid="REV 2:15"/>ሄዋዳንካ፥ ቃይ ኒቆላዋቱዋ ትምርትያ ታማርያ አሳቱ ኔናና ደኢኖ። <verse eid="REV 2:15"/><verse number="16" style="v" sid="REV 2:16"/>ሄዋ ድራዉ፥ ኔን ነ ናጋራፐ ስማ፤ ሄዌ ዮፐ፥ ታን ኔኮ ኤለካ ያና፤ ሄ አሳቱዋና ታ ዶናፐ ከስያ ማሻን ኦለታና።<verse eid="REV 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 2:17"/>“ ‘ሀይይ ደእያ ኡራይ ጌሻ አያናይ ዎሳ ጎለቶ ግያዋ ስሶ። ጾንያ ኡራዉ ታን ጌማን ደእያ ማናፐ አማሬዳዋ እማና። ቃይ ታን ቦ ሹቻካ አዉ እማና፤ አክያ ኡራፐ አትን፥ ኦንነ ኤረና ኦራ ሱንይ ሄ ሹቻ ቦላ ጻፈት ኡቴዳ’ ያጌ”</para>
  <para style="m" vid="REV 2:17">ያጋደ ጻፋ።<note caller="-" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="EXO 16:14-15">ከሳ 16:14-15</ref>፤ <ref loc="EXO 16:33-34">16:33-34</ref>፤ <ref loc="JHN 6:48-50">ዮሃ. 6:48-50</ref>፤ <ref loc="ISA 62:2">ኢሳ. 62:2</ref>፤ <ref loc="ISA 65:15">65:15</ref></char></note><verse eid="REV 2:17"/></para>
  <para style="s1">(4) የሱስ ትያጽሮነን ደእያ ዎሳ ጎለዉ ጎዋ</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18"/>ትያጽሮነን ደእያ ዎሳ ጎልያ ኪታንቻዉ ሀዋዳን ያጋደ ጻፋ:</para>
  <para style="p" vid="REV 2:18">“ጾሳ ናአይ፥ ታማ ላጩዋ ማላትያ አይፊ ደእያዌ፥ ቃይ ጮጭያ ታማን ቴሪደ ጶልያ ናሃስያ ጌተትያ ብራታ ማላትያ ገዲ ደእያዌ፥ ሀዋዳን ያጌ። <verse eid="REV 2:18"/><verse number="19" style="v" sid="REV 2:19"/>ታን ነ ኦሱዋ፥ ነ ሲቁዋ፥ ነ አማኑዋ፥ ነ ማዱዋነ ነ ገንጩዋ ኤራይ፤ ኔን ኮይሮ ኦያዋፐ ሀእ ዳርሳደ ኦያዋ ታን ኤራይ። <verse eid="REV 2:19"/><verse number="20" style="v" sid="REV 2:20"/>ሽን ታን ኔና ካያባይ ደኤ፤ ባረና፥ ታን ናባቶ ያግያ ምሽራቶ ኤልዛቤሎ ሸነኮ ጋዳ፤ ሄ ምሽራታ ታ ኦሳንቻቱ ዎሹማናዳንነ ኤቃዉ ያርሼዳ ቁማ ማናዳን፥ ታማርሳዉነ ባለዉ።<note caller="-" style="x"><char style="xo" closed="false">2:20 </char><char style="xt" closed="false"><ref loc="1KI 16:31">1 ካታ. 16:31</ref>፤ <ref loc="2KI 9:22">2 ካታ. 9:22</ref>፣ <ref loc="2KI 9:30">30</ref></char></note> <verse eid="REV 2:20"/><verse number="21" style="v" sid="REV 2:21"/>እዛ ባረ ናጋራፐ ስማና ማላ፥ ታን እዝዉ ዎድያ እማድ፤ ሽን ዎሹማናዉ ካጄልያዋፐ እዛ ስማናዉ ኮያበይኩ። <verse eid="REV 2:21"/><verse number="22" style="v" sid="REV 2:22"/>በእተ፥ ታን እዞ ግሱዋን ኩንድስና፤ ሳኩዋን እዛ ዋየታና። እዝና ዎሹምያዋንቱ ሄ እዝና ኦያ ናጋራፐ ስማና ዮፐ፥ ኡንቱንታካ ዎልቃማ ዋይያን የጋና። <verse eid="REV 2:22"/><verse number="23" style="v" sid="REV 2:23"/>ታን እዝ ናናካ ዎና፤ ቃይ ዎሳ ጎልያ ኡባይካ ታን አሳ ቆፋነ አሙዋ ኤርያዋ ግድያዋ ኤራና፤ ታን ህንተንቶ ህንተንቱ ኪታ ማላ እማና።<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="PSA 7:9">ማዝ. 7:9</ref>፤ <ref loc="JER 17:10">ኤር. 17:10</ref>፤ <ref loc="PSA 62:12">ማዝ. 62:12</ref></char></note><verse eid="REV 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 2:24"/>“ትያጽሮነን ደእያ ሀራቶ፥ ሀ ኢታ ትምርትያ ታማርቤናዋንቶ፥ ሀራቱ፥ ሴጻና ጪሞ የዉዋ ግያዋ ህንተንቱ ታማርቤይክታ፤ ታን ህንተንታ ሀራ ዴጹዋ ቶስከ ጋይ። <verse eid="REV 2:24"/><verse number="25" style="v" sid="REV 2:25"/>ሽን ታን ያና ጋካናዉ ህንተንቶ ደእያዋ ሎይ ናግተ።<verse eid="REV 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="REV 2:26"/>“ጾኔዳዎነ ዉርሰይ ጋካናዉ፥ ታ ኪታ ናጌዳዎ፥ አሳ ዛርያ ኡባ ሞዳና ማላ፥ ታን ታ አዉዋፐ አኬዳ ማታ ማላ አዉ እማና፤<verse eid="REV 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="REV 2:27"/>“እ አሳ ዛርያ ኡባ ብራታ ጻምኣን ሞዳናነ፥</para>
  <para style="q2" vid="REV 2:27">ኡርቃፐ መታ ሚሻ መንያዋዳን መንና።<note caller="-" style="x"><char style="xo" closed="false">2:27 </char><char style="xt" closed="false"><ref loc="PSA 2:8-9">ማዝ. 2:8-9</ref></char></note><verse eid="REV 2:27"/></para>
  <para style="mi">
    <verse number="28" style="v" sid="REV 2:28"/>ቃይ ታን አዉ ባካልያ ጾልንትያ እማና። <verse eid="REV 2:28"/><verse number="29" style="v" sid="REV 2:29"/>ስሳናዉ ሀይይ ደእያ ኡራይ ጌሻ አያናይ ዎሳ ጎለቶ ግያዋ ስሶ ያጌ”</para>
  <para style="m" vid="REV 2:29">ያጋደ ጻፋ።<verse eid="REV 2:29"/></para>
  <chapter eid="REV 2"/>
  <chapter number="3" style="c" sid="REV 3"/>
  <para style="s1">(5) የሱስ ሳርዴሳን ደእያ ዎሳ ጎለዉ ጎዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1"/>ሳርዴሳን ደእያ ዎሳ ጎልያ ኪታንቻዉ ሀዋዳን ያጋደ ጻፋ:</para>
  <para style="b" vid="REV 3:1"/>
  <para style="p" vid="REV 3:1">“ጾሳ አያና ላፑናቱነ ላፑ ጾልንታቱ ደእያዌ ሀዋዳን ያጌ። ታን ነ ኪታ ኤራይ፤ አሳይ ኔና ሸምፑዋና ደኣሳ ግንቶካ፥ ኔን ሀይቃዳ። <verse eid="REV 3:1"/><verse number="2" style="v" sid="REV 3:2"/>ቤጎታ! አቴዳዋነ ሀይቃናዉ ማቴዳዋ መን። አያዉ ጎፐ፥ ነ ኪታይ ታ ጾሳ ስንን ፖሎ ግደናዋ ታን ደማድ። <verse eid="REV 3:2"/><verse number="3" style="v" sid="REV 3:3"/>ስም ኔን አኬዳዋነ ስሴዳዋ አኬካ፤ ናጋ፤ ነ ናጋራፐካ ስማ። ኔን ቤጎተናዋ ግዶፐ፥ ታን ኔኮ ካይሱዋዳን ያና፤ ታን ዎይሳደ ያነንቶ ኔን ኤራካ። <verse eid="REV 3:3"/><verse number="4" style="v" sid="REV 3:4"/>ሽን ባረንቱ ማዩዋ ቅትስቤና አማሬዳ አሳቱ ሳርዴሳን ኔናና ደኢኖ። ኡንቱንቱ ቦ ማዩዋ ማዪደ ታናና ሀመታና፤ አያዉ ጎፐ፥ ኡንቱንቱ ቦ ማዩዋ ማያናዉ በስያዋንታ። <verse eid="REV 3:4"/><verse number="5" style="v" sid="REV 3:5"/>ጾንያዌ ሄዋዳንካ ቦ ማዩዋ ማያና። ታን አ ሱን ደኡዋ ማጻፋፐ<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="fk" closed="false">ደኡዋ ማጻፋ፦ </char><char style="ft" closed="false">ጾሳ አሳቱዋ ሱንይ ጻፈትያ ማጻፋ።</char></note> ቁጭከ፤ ታን ታ አቡ ስንንነ አ ኪታንቻቱዋ ስንን እ ታዋ ግድያዋ ማርካታና።<note caller="-" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="EXO 32:32-33">ከሳ 32:32-33</ref>፤ <ref loc="PSA 69:28">ማዝ. 69:28</ref>፤ <ref loc="REV 20:12">ሳፃ 20:12</ref>፤ <ref loc="MAT 10:32">ማቶሳ 10:32</ref>፤ <ref loc="LUK 12:8">ሉቃሳ 12:8</ref></char></note><verse eid="REV 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 3:6"/>“ስሳናዉ ሀይይ ደእያ ኡራይ ጌሻ አያናይ ዎሳ ጎለቶ ግያዋ ስሶ ያጌ”</para>
  <para style="m" vid="REV 3:6">ያጋደ ጻፋ።<verse eid="REV 3:6"/></para>
  <para style="s1">(6) የሱስ ፕላደልፍያን ደእያ ዎሳ ጎለዉ ጎዋ</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7"/>ፕላደልፍያን ደእያ ዎሳ ጎልያ ኪታንቻዉ ሀዋዳን ያጋደ ጻፋ:</para>
  <para style="b" vid="REV 3:7"/>
  <para style="pi" vid="REV 3:7">“ዳዊተ ቁልፕያ<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="fq" closed="false">ዳዊተ ቁልፕያ፦ </char><char style="ft" closed="false">ሀዋ ጉሳይ ዳዊተ ካዉተ አይሱዋ ማታ ኦድያዋ።</char></note> ኦይቄዳዌ፥ ኦንነ ጎርዳናዉ ዳንዳየናዳን ዶይያዌ፥ ቃይ ኦንነ ዶያናዉ ዳንዳየናዳን ጎርድያዌ ጌሻይነ፥ ቱማንቻይ ሀዋዳን ያጌ።<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="ISA 22:22">ኢሳ. 22:22</ref>፤ <ref loc="JOB 12:14">ኢዮባ 12:14</ref></char></note> <verse eid="REV 3:7"/><verse number="8" style="v" sid="REV 3:8"/>ታን ነ ኪታ ኤራይ። በአ፥ ታን ነ ስንን ኦንነ ጎርዳናዉ ዳንዳየና ፐንግያ ዎድ፤ አያዉ ጎፐ፥ ነ ዎልቃይ ጉ ግዶፐነ፥ ታ ቃላ ናጋዳነ ታ ሱንካ ኤርከ ጋበይካ። <verse eid="REV 3:8"/><verse number="9" style="v" sid="REV 3:9"/>በአ፥ አይሁዳ ግድክኖ ሽን ባረና፥ ‘ኑን አይሁዳ’ ጊደ ዎርዶትያ ሴጻና አይሁዳ ዎሳ ጎልያ ታን አሃደ፥ ነ ስንን ጎይንሳናነ ኔና ሲቅያዋካ ኡንቱንታ ኤርሳና።<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="ISA 49:23">ኢሳ. 49:23</ref>፤ <ref loc="ISA 60:14">60:14</ref>፤ <ref loc="ISA 43:4">43:4</ref></char></note> <verse eid="REV 3:9"/><verse number="10" style="v" sid="REV 3:10"/>ኔን ገንጩዋን ታ አዛዙዋ ናጌዳ ድራዉ፥ ሳኣን ደእያ አሳ ፓጫናዉ ኩመን ሳኣ ቦላ ይያ ዋይያ ዎድያፐ ታንካ ኔና ናጋና። <verse eid="REV 3:10"/><verse number="11" style="v" sid="REV 3:11"/>ታን ኤለካ ያና፤ ኦንነ ነ ካላቻ አከና ማላ፥ ነዉ ደእያዋ ምንሳ ኦይቃ። <verse eid="REV 3:11"/><verse number="12" style="v" sid="REV 3:12"/>ታን ጾንያ ኡራ ታ አዉዋ ጌሻ ጎልያን ቱሳ ኦና፤ እ ሄዋፐ ኡባካ ከሰና። ታን ታ ጾሳ ሱን፥ ታ ጾሳ ካታማ ሱንነ ታ ጾሳ ማታፐ ዎና ኦራ የሩሳላመ ሱን አ ቦላ ጻፋና። ቃይ ታን ታ ኦራ ሱንካ አ ቦላ ጻፋና። <verse eid="REV 3:12"/><verse number="13" style="v" sid="REV 3:13"/>ስሳናዉ ሀይይ ደእያ ኡራይ ጌሻ አያናይ ዎሳ ጎለቶ ግያዋ ስሶ ያጌ”</para>
  <para style="m" vid="REV 3:13">ያጋደ ጻፋ።<verse eid="REV 3:13"/></para>
  <para style="s1">(7) የሱስ ሎዶቅያን ደእያ ዎሳ ጎለዉ ጎዋ</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14"/>ሎዶቅያን ደእያ ዎሳ ጎልያ ኪታንቻዉ ሀዋዳን ያጋደ ጻፋ:</para>
  <para style="b" vid="REV 3:14"/>
  <para style="p" vid="REV 3:14">“አማነቴዳ ቱማንቻ ማርካይ፥ ጾሳይ መዳዋ ኮይሩ፥ አመንእ ግያዌ ሀዋዳን ያጌ። <verse eid="REV 3:14"/><verse number="15" style="v" sid="REV 3:15"/>ታን ነ ኪታ ኤራይ። ኔን እርጻ ግዳካ፤ ዎይ ሴልያዋ ግዳካ፤ እርጻ ዎይ ሴልያዋ ግዳርኪ። <verse eid="REV 3:15"/><verse number="16" style="v" sid="REV 3:16"/>ኔን እርጻ ዎይ ሴልያዋ ግደናን፥ ዶምቦሎላ ግድያ ድራዉ፥ ታን ኔና ታ ዶናፐ ጩቻና ሀናይ። <verse eid="REV 3:16"/><verse number="17" style="v" sid="REV 3:17"/>አያዉ ጎፐ ኔን፥ ‘ታን ዱረ፤ ሚሻና ደአይ፤ ታና አይነ ኮሸና’ ያጋሳ። ሽን ኔን መቶትያ አሳ፥ ቃረያ አሳ፥ ህዬሳ፥ ቆቃነ ካሎቴዳ አሳ ግድያዋ ኤራካ። <verse eid="REV 3:17"/><verse number="18" style="v" sid="REV 3:18"/>ሄዋ ድራዉ፥ ኔን ዱረታና ማላ፥ ታማን ጌዬዳ ዎርቃ፥ ኔና ዬላይያ ነ ካሉዋ ካማናዉ ቦ ማዩዋነ ቃይ ሎይ ጼላናዉ ነ አይፍያ ኦክያ ልያ ታፐ ሻማናዳን፥ ታን ኔና ዞራይ። <verse eid="REV 3:18"/><verse number="19" style="v" sid="REV 3:19"/>ታን ሲቅያ ኡባ ሴራይነ ሙራይ፤ ስም ሎይ ሴለታ፤ ነ ናጋራፐካ ስማ።<note caller="-" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="PRO 3:12">ሌም. 3:12</ref>፤ <ref loc="HEB 12:6">እብራ. 12:6</ref></char></note> <verse eid="REV 3:19"/><verse number="20" style="v" sid="REV 3:20"/>በአ፥ ታን ካረን ኤቃደ ጼሳይ። ኦንነ ታን ጼስያዋ ስሲደ፥ ካርያ ዶዮፐ፥ ታን አኮ ገላደ አናና እትፐ ካዉዋ ማና፤ እካ ታናና እትፐ ማና። <verse eid="REV 3:20"/><verse number="21" style="v" sid="REV 3:21"/>ቃይ ታን ጾናደ ታ አዉዋና አ ካዉተ ኦይድያን ኡቴዳዋዳን፥ ጾንያ ኡራዉ ታናና ታ ካዉተ ኦይድያን ኡትያ ማታ እማና።<verse eid="REV 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 3:22"/>“ስስያ ሀይይ ደእያ ኡራይ ጌሻ አያናይ ዎሳ ጎለቶ ግያዋ ስሶ ያጌ ያጋደ ጻፋ”</para>
  <para style="m" vid="REV 3:22">ያጌዳ።<verse eid="REV 3:22"/></para>
  <chapter eid="REV 3"/>
  <chapter number="4" style="c" sid="REV 4"/>
  <para style="s1">ጾሳይ ዮሃንሳ ባረ ካዉተ ኦይድያ ስን አሄዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1"/>ሄዋፐ ጉይያን፥ ታን ሳሉዋን ዶያ ፐንግያ በኣድ፤ ቃይ ታዉ ማላካታዳን ኦድሽን፥ ታን ስሴዳ ኮይሮ ኮሻይ ታና፤ “ሀዋፐ ጉይያን፥ ሀናናዉ በስያዋ ታን ኔና በሳና፤ ሃ ከሳ” ያጌዳ። <verse eid="REV 4:1"/><verse number="2" style="v" sid="REV 4:2"/>ኤለካ ታን ጌሻ አያና ሞዱዋ ግዶ ገላ አጋድ። በእተ፥ ሳሉዋን ካዉተ ኦይዲ ደኤ፤ ሄ ኦይድያን እቱ ኡቴዳ።<note caller="-" style="x"><char style="xo" closed="false">4:2-3 </char><char style="xt" closed="false"><ref loc="EZK 1:26-28">ህዝ. 1:26-28</ref>፤ <ref loc="EZK 10:1">10:1</ref></char></note> <verse eid="REV 4:2"/><verse number="3" style="v" sid="REV 4:3"/>ሄ ኡቴዳዋ ማላይ አልኦ እያስጲድያ ሹቻዳንነ አልኦ ሰርድኖነ ሹቻዳን ጶሌ። ካዉታ ኦይዲ ዙሉዋን ዩይ አደ ኡባ ባጋና አልኦ ማርግድያ ሹቻዳን ጶሌ። <verse eid="REV 4:3"/><verse number="4" style="v" sid="REV 4:4"/>ሄ ካዉተ ኦይድያ ዩይ አደ፥ ሀራ ላታማነ ኦይዱ ካዉተ ኦይደቱ ደኢኖ፤ ኡንቱንቱን ቦ ማዩዋ ማዪደ፥ ሁጲያን ዎርቃ ካላቻ ዎዳ ላታማነ ኦይዱ ጭማቱ ኡቴድኖ። <verse eid="REV 4:4"/><verse number="5" style="v" sid="REV 4:5"/>ካዉተ ኦይድያፐ ዋልቃንይ፥ ኮሹንቻይነ ጉጉን ጉንይ ከሴዳ፤ ቃይ ካዉተ ኦይድያ ስንን ላፑ ጾምፓቱ ፖኢኖ። ሄዋንቱ ጾሳ ላፑ አያናቱዋ።<note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="EXO 19:16">ከሳ 19:16</ref>፤ <ref loc="REV 8:5">ሳፃ 8:5</ref>፤ <ref loc="REV 11:19">11:19</ref>፤ <ref loc="REV 16:18">16:18</ref>፤ <ref loc="EZK 1:13">ህዝ. 1:13</ref>፤ <ref loc="REV 1:4">ሳፃ 1:4</ref>፤ <ref loc="ZEC 4:2">ዛካ. 4:2</ref></char></note> <verse eid="REV 4:5"/><verse number="6" style="v" sid="REV 4:6"/>ካዉተ ኦይድያ ስንን ብርልያ ማላትያ ቡርጩኩዋ አባይ ደኤ።<note caller="-" style="x"><char style="xo" closed="false">4:6-7 </char><char style="xt" closed="false"><ref loc="EZK 1:5-10">ህዝ. 1:5-10</ref>፤ <ref loc="EZK 10:14">10:14</ref></char></note></para>
  <para style="p" vid="REV 4:6">ሄ ካዉተ ኦይድያፐ ስንናነ ጉየና አ ማታን ዩይ አደ፥ አይፊ ኩሜዳ ኦይዱ ደኡዋን ደእያ መታቱ ደኢኖ። <verse eid="REV 4:6"/><verse number="7" style="v" sid="REV 4:7"/>ኮይሮ ደኡዋን ደእያ መታይ ጋሙዋ ማላቴ፤ ላኤን ሚዛ ማራ ማላቴ፤ ሄዘንዋ ሶምእ አሳ ዴሙዋ ማላቴ፤ ቃይ ኦይደን ፓልያ አርጋን ማላቴ። <verse eid="REV 4:7"/><verse number="8" style="v" sid="REV 4:8"/>ኦይዱ ደኡዋን ደእያ መታቶ ሁጲያን ሁጲያን ኡሱፑን ቀፊ ደኤ፤ ኡንቱንቶ ቦላን ጋርሳንካ ኡባ ሳን አይፊ ኩሜዳ። ኡንቱንቱ ቃማነ ጋላስ፥</para>
  <para style="q1" vid="REV 4:8">“ጌሻዉ፥ ጌሻዉ፥ ጌሻዉ፥</para>
  <para style="q2" vid="REV 4:8">ካሰ ደእያዎ፥ ሀእካ ደእያዎ፥</para>
  <para style="q2" vid="REV 4:8">ቃይ ስንፐ ያናዎ፥</para>
  <para style="q2" vid="REV 4:8">ጎዳዉ፥ ኡባፐ ዎልቃማ ጾሳዉ”</para>
  <para style="m" vid="REV 4:8">ግያዋ አግክኖ።<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="EZK 1:18">ህዝ. 1:18</ref>፤ <ref loc="EZK 10:12">10:12</ref>፤ <ref loc="ISA 6:2-3">ኢሳ. 6:2-3</ref></char></note> <verse eid="REV 4:8"/><verse number="9" style="v" sid="REV 4:9"/>ሄ መታቱ ካዉተ ኦይድያን ኡቴዳ መ መናዉ ደኡዋን ደእያዋ ማዝሙርያን ሳቤዳ ዎደ፥ ቦንቼዳ ዎደነ ጋላቴዳ ዎደ፥ <verse eid="REV 4:9"/><verse number="10" style="v" sid="REV 4:10"/>ላታማነ ኦይዱ ጭማቱ ካዉተ ኦይድያን ኡቴዳ መ መናዉ ደእያዋ ስንን ጉፋኒደ፥ አዉ ጎይኒኖ፤ ባረንቱ ካላቻ ካዉተ ኦይድያ ስንን ዎደ ሀዋዳን ያጊኖ።<verse eid="REV 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11"/>“ኑ ጎዳዉ ጾሳዉ፥</para>
  <para style="q2" vid="REV 4:11">ኔን ቦንቹዋ፥</para>
  <para style="q2" vid="REV 4:11">ሳባነ ዎልቃ አካናዉ በሳሳ።</para>
  <para style="q2" vid="REV 4:11">አያዉ ጎፐ፥ ኡባባ ኔን መዳ፤</para>
  <para style="q2" vid="REV 4:11">ቃይ ኡባባይካ፥ ኔን ኮዬዳዋዳን ሀኔዳነ ደኤዳ”</para>
  <para style="m" vid="REV 4:11">ያጊኖ።<verse eid="REV 4:11"/></para>
  <chapter eid="REV 4"/>
  <chapter number="5" style="c" sid="REV 5"/>
  <para style="s1">ማጻፋነ ዶርሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1"/>እት ጻጸቶ ማጻፋይ<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="fqa" closed="false">ጻጸቶ ማጻፋ፦ </char><char style="ft" closed="false">ሀዋ ጉሳይ ዋራቃታን ዎይ ጋልባን ጻፈቴዳ ጻጸትያ ማጻፋ ግዲደ፥ ዳሮ ካረ ባጋና እት ዎይ ላኡ ቦላ ባጋ ጋልባን ማታፋይ አታመቴ።</char></note> ካዉተ ኦይድያን ኡቴዳዋ ኡሸቻ ኩሽያን ደእያዋ በኣድ፤ ሄ ጻጸቶ ማጻፋይ ላኡ ባጋናካ ጻፈት ኡቴዳ፤ ቃይ ላፑ ማታፋይ አ ቦላ አታመቴዳ።<note caller="-" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="EZK 2:9-10">ህዝ. 2:9-10</ref>፤ <ref loc="ISA 29:11">ኢሳ. 29:11</ref></char></note> <verse eid="REV 5:1"/><verse number="2" style="v" sid="REV 5:2"/>ታን እት ዎልቃማ ኪታንቻይ ባረ ቃላ ቁ ኦደ፥ “ማታፋ ዶዪደ፥ ጻጸቶ ማጻፋ ብላናዉ በስያ ኡራይ ኦኔ?” ያጊደ፥ አዋይያዋ በኣድ። <verse eid="REV 5:2"/><verse number="3" style="v" sid="REV 5:3"/>ሳሉዋን ግድና ዎይ ሳኣን ግድና፥ ዎይ ሳኣፐ ጋርሳን<note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="fk" closed="false">ሳኣፐ ጋርሳን፦ </char><char style="ft" closed="false">ሀይቄዳዋንታ ጉሳ።</char></note> ግድና፥ ሄ ጻጸቶ ማጻፋ ብላናዉ ዎይ አ ግዱዋ ጼላናዉ ኦንነ በስያዌ ባዋ።<verse eid="REV 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 5:4"/>ጻ ማጻፋ ብላናዉ ዎይ አ ግዱዋ ጼላናዉ በስያ ኡራይ ባይና ድራዉ፥ ታን ዳሮ ዬካድ። <verse eid="REV 5:4"/><verse number="5" style="v" sid="REV 5:5"/>ጭማቱዋፐ እቱ ታና፥ “ዬኮፓ፤ በአ፥ ይሁዳ ዛርያ ግዴዳ ጋሙ፥ ዳዊተ ዛሪ ጾኔዳ። እ ማታፋ ዶያናዉነ ጻጸቶ ማጻፋ ብላናዉ በሴ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="GEN 49:9">ዶመ 49:9</ref>፤ <ref loc="ISA 11:1">ኢሳ. 11:1</ref>፣ <ref loc="ISA 11:10">10</ref></char></note><verse eid="REV 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6"/>ታን ካዉተ ኦይድያፐ፥ ደኡዋን ደእያ ኦይዱ መታቱዋፐነ ቃይ ጭማቱዋፐ ግዱዋን፥ ሹከቴዳ ዶርሳ ማላቲደ ኤቄዳዋ በኣድ፤ አዉ ላፑ ካጨቱነ ላፑ አይፈቱ ደኢኖ። ሄዋንቱ አላምያ ኡባ ኪተቴዳ ጾሳ ላፑ አያናቱዋ።<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="ISA 53:7">ኢሳ. 53:7</ref>፤ <ref loc="ZEC 4:10">ዛካ. 4:10</ref></char></note> <verse eid="REV 5:6"/><verse number="7" style="v" sid="REV 5:7"/>ሄ ዶርሳይ ቢደ፥ ካዉተ ኦይድያ ቦላ ኡቴዳዋ ኡሸቻ ኩሽያፐ ጻጸቶ ማጻፋ አኬዳ። <verse eid="REV 5:7"/><verse number="8" style="v" sid="REV 5:8"/>እ ሄ ጻጸቶ ማጻፋ አኬዳ ዎደ፥ ደኡዋን ደእያ ኦይዱ መታቱነ ላታማነ ኦይዱ ጭማቱ አ ስንን ኩንዴድኖ። ኡንቱንቱ ሁጲያን ሁጲያን ዲነ እጻናይ ኩሜዳ ዎርቃ ሚሻ ኦይቄድኖ። ሄ እጻናይ ጌሻቱ ጾሳ ዎስያዋ።<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="PSA 141:2">ማዝ. 141:2</ref></char></note> <verse eid="REV 5:8"/><verse number="9" style="v" sid="REV 5:9"/>ኡንቱንቱ፥</para>
  <para style="q1" vid="REV 5:9">“ጻ ማጻፋ አካናዉነ፥</para>
  <para style="q2" vid="REV 5:9">ማታፋ ዶያደ፥</para>
  <para style="q2" vid="REV 5:9">ጼላናዉ ነዉ በሴ።</para>
  <para style="q2" vid="REV 5:9">አያዉ ጎፐ፥ ኔን ሹከታዳ።</para>
  <para style="q1" vid="REV 5:9">ኔን ቆሙዋ ኡባፐ፥</para>
  <para style="q2" vid="REV 5:9">ዱማ ዱማ ጋድያ ቃላ ኡባፐ፥</para>
  <para style="q2" vid="REV 5:9">ያራ ኡባፐነ፥ ዛርያ ኡባፐ፥</para>
  <para style="q2" vid="REV 5:9">ነ ሱን፥ ጾሳዉ አሳ ዎዛዳ።<note caller="-" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="PSA 33:3">ማዝ. 33:3</ref>፤ <ref loc="PSA 98:1">98:1</ref>፤ <ref loc="ISA 42:10">ኢሳ. 42:10</ref></char></note><verse eid="REV 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10"/>ኑ ጾሳዉ ኦና ማላ፥</para>
  <para style="q2" vid="REV 5:10">ኡንቱንታ ኔን፥ ካታቱዋነ፥</para>
  <para style="q2" vid="REV 5:10">ቄሳቱዋ ኦዳ።</para>
  <para style="q2" vid="REV 5:10">ቃይ ኡንቱንቱ ሳአንካ ሞዳና”</para>
  <para style="q2" vid="REV 5:10">ያጊደ ኦራ ማዝሙርያ የጺኖ።<note caller="-" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="EXO 19:6">ከሳ 19:6</ref>፤ <ref loc="REV 1:6">ሳፃ 1:6</ref></char></note><verse eid="REV 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11"/>ሄዋፐ ጉይያን፥ ታን ጼላደ፥ ካዉተ ኦይድያ፥ ደኡዋን ደእያ ኦይዱ መታቱዋነ ጭማቱዋ ዩይ አደ ኤቄዳ ዳሮ ኪታንቻቱዋ ኮሻ ስሳድ፤ ኡንቱንቱ ሻኣንነ ሚሎንያን ፓይደቴድኖ።<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="DAN 7:10">ዳኔላ 7:10</ref></char></note> <verse eid="REV 5:11"/><verse number="12" style="v" sid="REV 5:12"/>ሄ ኪታንቻቱ ባረንቱ ቃላ ቁ ኦደ፥</para>
  <para style="q1" vid="REV 5:12">“ሹከቴዳ ዶርሳይ</para>
  <para style="q2" vid="REV 5:12">ዎልቃ፥ ዱረተ፥</para>
  <para style="q2" vid="REV 5:12">አዳ ኤራ፥</para>
  <para style="q2" vid="REV 5:12">ምኖተ፥</para>
  <para style="q2" vid="REV 5:12">ቦንቹዋ፥ ሳባ፥</para>
  <para style="q2" vid="REV 5:12">ጋላታ አካናዉ በሴ!”</para>
  <para style="m" vid="REV 5:12">ያጌድኖ።<verse eid="REV 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 5:13"/>ሄዋፐ ጉይያን፥ ሳኣን፥ ሳሉዋን፥ ሳኣፐ ጋርሳንነ አባ ግዱዋን ደእያ መታ ኡባይነ ቃይ ሄዋንቱን ደእያ መታ ኡባይ፥</para>
  <para style="q1" vid="REV 5:13">“ካዉተ ኦይድያ ቦላ፥</para>
  <para style="q2" vid="REV 5:13">ኡቴዳዎነ ዶርሳዉ፥</para>
  <para style="q2" vid="REV 5:13">ጋላታይ፥ ቦንቹ፥</para>
  <para style="q2" vid="REV 5:13">ሳባይነ ዎልቃይ፥</para>
  <para style="q2" vid="REV 5:13">መ መናዉ ግዶ!”</para>
  <para style="m" vid="REV 5:13">ያጊደ የጽሽን ስሳድ።<verse eid="REV 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 5:14"/>ደኡዋን ደእያ ኦይዱ መታቱ፥ “አመንእ” ያግና፥ ጭማቱ ጉፋኒደ ጎይኔድኖ።<verse eid="REV 5:14"/></para>
  <chapter eid="REV 5"/>
  <chapter number="6" style="c" sid="REV 6"/>
  <para style="s1">ሄ ጻጸ ማጻፋ ማታፋ ዶያ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1"/>ዶርሳይ ላፑ ማታፋቱዋፐ እቱዋ ዶይሽን በኣድ፤ ቃይ ሸምፑዋና ደእያ ኦይዱ መታቱዋፐ እቱ ጉጉን ጉን ማላትያ ኮሻን፥ “ሃያ!” ያግያዋ፥ ታን ስሳድ። <verse eid="REV 6:1"/><verse number="2" style="v" sid="REV 6:2"/>ታን እት ቦ ፓራ በኣድ። ሄ ፓራ ቶጌዳዌ ዎንዳፍያ ኦይቄዳ፤ ቃይ አዉ ካላቻይ እመቴዳ። ኦላ እ ጾኒድነ ቃይካ ጾናናዉ ከሴዳ።<note caller="-" style="x"><char style="xo" closed="false">6:2 </char><char style="xt" closed="false"><ref loc="ZEC 1:8">ዛካ. 1:8</ref>፤ <ref loc="ZEC 6:3">6:3</ref>፣ <ref loc="ZEC 6:6">6</ref></char></note><verse eid="REV 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3"/>ዶርሳይ ላኤን ማታፋ ዶዬዳ ዎደ፥ ሸምፑዋና ደእያ መታቱዋ ላኤን፥ “ሃያ!” ያግያዋ፥ ታን ስሳድ። <verse eid="REV 6:3"/><verse number="4" style="v" sid="REV 6:4"/>ቃይ ሀራ ዳማ ፓራይ ከሴዳ። አሳይ እቱ እቱዋና ሹከታና ማላ፥ ሄ ፓራ ቶጌዳዎ ሳኣን ሳሮተ ድግያ ዎልቃይ እመቴዳ። ዎጋ ማሻይ አዉ እመቴዳ።<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="ZEC 1:8">ዛካ. 1:8</ref>፤ <ref loc="ZEC 6:2">6:2</ref></char></note><verse eid="REV 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5"/>ዶርሳይ ሄዘን ማታፋ ዶዬዳ ዎደ፥ ደኡዋን ደእያ መታቱዋ ሄዘን፥ “ሃያ!” ያግያዋ፥ ታን ስሳድ። ያታደ ካረ ፓራይ ከሴዳዋ በኣድ፤ ቃይ ሄ ፓራ ቶጌዳዌ ባረ ኩሽያን ሚዛንያ ኦይቄዳ።<note caller="-" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="ZEC 6:2">ዛካ. 6:2</ref>፣ <ref loc="ZEC 6:6">6</ref></char></note> <verse eid="REV 6:5"/><verse number="6" style="v" sid="REV 6:6"/>ታን ደኡዋን ደእያ ኦይዱ መታቱዋ ግዶፐ ኮሻ ማላትያባ ስሳድ። ሄ ኮሻይ፥ “እት ጋላሳ ኦሶ ድርጉ ባጋ ኪሉዋ ዛርጋ፤ ቃይ እት ጋላሳ ኦሶ ድርጉ እት ኪሉዋ ባጋ ባንጋ። ሽን ዛይትያነ ዎይንያ ኤሳ ቆሆፓ” ያግያዋ ስሳድ።<verse eid="REV 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7"/>ዶርሳይ ኦይደን ማታፋ ዶዬዳ ዎደ፥ ደኡዋን ደእያ መታቱዋ ኦይደን፥ “ሃያ!” ያግያዋ፥ ታን ስሳድ። <verse eid="REV 6:7"/><verse number="8" style="v" sid="REV 6:8"/>ታን ግራጨ ፓራይ ከሴዳዋ በኣድ። ሄ ፓራ ቶጌዳዋ ሱንይ ሀይቁዋ፤ አ ጌዱዋ ስኦሊ ካሌዳ። ሀይቁነ ስኦሊ ሳኣፐ ኦይደን ኩሽያ ኦላን፥ ኮሻን፥ ሀርግያን፥ ዶኣን ዎሳና ማላ፥ ኡንቱንቶ ማታይ እመቴዳ።<note caller="-" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="EZK 14:21">ህዝ. 14:21</ref></char></note><verse eid="REV 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9"/>ዶርሳይ እቼሸን ማታፋ ዶዬዳ ዎደ፥ ኡንቱንቱ ጾሳ ቃላ ኦዴዳ ድራዉነ ባረንቱ ማርካተን አማነቴዳ ድራዉ፥ ሹኬዳ አሳ ሸምፑዋ ያርሹዋ ያርሽያ ሳፐ ጋርሳን በኣድ። <verse eid="REV 6:9"/><verse number="10" style="v" sid="REV 6:10"/>ኡንቱንቱ ባረንቱ ቃላ ቁ ኦደ፥ “ኡባ ሞድያ ጎዳዉ፥ ጌሻዉ፥ ቱማንቻዉ፥ ሳኣን ደእያ አሳ ቦላ አዉደ ፕርዳይ? ቃይ ኑ ሱ አዉደ ጭገታይ?” ያጌድኖ። <verse eid="REV 6:10"/><verse number="11" style="v" sid="REV 6:11"/>ኡንቱንቶ ሁጲያን ሁጲያን ቦ ማዩ እመቴዳ። ኡንቱንቱዋዳን ሀይቃናዉ በስያ ኡንቱንቱ ላገ ኦሳንቻቱዋ ፓይዱነ ኡንቱንቱ እሻቱዋ ፓይዱ ኩማና ጋካናዉ፥ ኡንቱንቱ አማሬዳ ዎድያ ታክሻና ማላ፥ ኡንቱንቶ ኦደቴዳ።<verse eid="REV 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12"/>ዶርሳይ ኡሱፑን ማታፋ ዶዬዳ ዎደ፥ ታን በኣድ፤ ቢታይ ሎይ ቃጼዳ። አዋይፊ ካረ ማዩዋዳን ካረጼዳ፤ አገናይካ ሙለ ሱ ማላቴዳ። <verse eid="REV 6:12"/><verse number="13" style="v" sid="REV 6:13"/>ባላስያ ግያ ምት ጋምኤ አይፊ፥ ዎልቃማ ጫርኩ ቃና፥ ሳኣን ቆቆፈትያዋዳን፥ ጾልንታቱ ሳሉዋፐ ሳኣን ቆቆፈቴድኖ።<note caller="-" style="x"><char style="xo" closed="false">6:13-14 </char><char style="xt" closed="false"><ref loc="ISA 34:4">ኢሳ. 34:4</ref></char></note> <verse eid="REV 6:13"/><verse number="14" style="v" sid="REV 6:14"/>ሳሉ ጻጸቶ ማጻፋይ ጻጸትያዋዳን፥ ጻጸቲደ ይ አጌዳ፤ ደር ኡባቱነ ሃን ዶደቴዳ ሳአይ ኡባይ ባረንቱ ደኢያሳፐ ክች አጌድኖ። <verse eid="REV 6:14"/><verse number="15" style="v" sid="REV 6:15"/>ሄዋፐ ጉይያን፥ ሳኣ ካታቱ፥ ደርያ ሞድያዋንቱ፥ ሻላቃቱ፥ ዱራቱ፥ ዎልቃማቱ፥ ቃይ ሀራ አሳይ ኡባይ፥ አይለቱ፥ ዎማናቱ፥ ደርያ ከሲደ፥ ጎንጎሉዋ ግዶንነ ደርያን ደእያ ዛላ ጉየ ባጋን ቆሰቴድኖ።<note caller="-" style="x"><char style="xo" closed="false">6:15 </char><char style="xt" closed="false"><ref loc="ISA 2:19">ኢሳ. 2:19</ref>፣ <ref loc="ISA 2:21">21</ref></char></note> <verse eid="REV 6:15"/><verse number="16" style="v" sid="REV 6:16"/>ያቲደ ደረቱዋነ ሹቻ፥ “ካዉተ ኦይድያን ኡቴዳዋ አይፍያፐነ ዶርሳ ሀንቁዋፐ ኑ ቦላ ኩንዲደ፥ ኑና ገንርክቴሻ!<note caller="-" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="HOS 10:8">ሆሰ 10:8</ref>፤ <ref loc="LUK 23:30">ሉቃሳ 23:30</ref></char></note> <verse eid="REV 6:16"/><verse number="17" style="v" sid="REV 6:17"/>አያዉ ጎፐ፥ ኡንቱንቶ ዎልቃማ ሀንቁዋ ጋላሳይ ጋክ ክቼዳ፤ ሄ ሀንቁዋ ዳንዳያናዌ ኦኔ?” ያጌድኖ።<note caller="-" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="JOL 2:11">ኢዩ. 2:11</ref>፤ <ref loc="MAL 3:2">ሚልክ. 3:2</ref></char></note><verse eid="REV 6:17"/></para>
  <chapter eid="REV 6"/>
  <chapter number="7" style="c" sid="REV 7"/>
  <para style="s1">እስራኤልያ አሳፐ 144,000 አሳቱዋ ሶምእያን ማታፋይ ዎዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1"/>ሄዋፐ ጉይያን፥ ታን ኦይዱ ኪታንቻቱ ኦይዱ ባጋ ሳኣ ጋጻን ኤቄዳዋንታ በኣድ። ሄ ኪታንቻቱ ሳኣ ቦላን፥ ዎይ አባ ቦላን፥ ዎይ አይ ም ቦላን፥ ጫርኩ ጫርከናዳን ተኤድኖ።<note caller="-" style="x"><char style="xo" closed="false">7:1 </char><char style="xt" closed="false"><ref loc="JER 49:36">ኤር. 49:36</ref>፤ <ref loc="DAN 7:2">ዳኔላ 7:2</ref>፤ <ref loc="ZEC 6:5">ዛካ. 6:5</ref></char></note> <verse eid="REV 7:1"/><verse number="2" style="v" sid="REV 7:2"/>ቃይካ ደኡዋ ጾሳ ማታፋ ኦይቂደ ሀራ ኪታንቻይ አዋይ ሞክያሳፐ ከስያዋ ታን በኣድ። ሄ ኪታንቻይ ባረ ኮሻ ቁ ኦደ፥ ሳኣነ አባ ቆሀናዉ ዎልቃይ እመቴዳ ኦይዱ ኪታንቻቱዋ <verse eid="REV 7:2"/><verse number="3" style="v" sid="REV 7:3"/>ጼሲደ፥ “ኑ ጾሳ ኦሳንቻቱዋ ዴሙዋን ኑን ማታፋ ዎና ጋካናዉ፥ ሳኣ ግድና ዎይ አባ ግድና፥ ዎይ ም ግድናካ ቆሆፕተ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="EZK 9:4">ህዝ. 9:4</ref>፣ <ref loc="EZK 9:6">6</ref></char></note><verse eid="REV 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 7:4"/>ታን ጾሳ ማታፋ ዴሙዋን ዎዳዋንቱ ፓይዱዋ ስሳድ። እስራኤልያ ዛርያ ኡባፐ እት ጼታነ ኦይታማነ ኦይዱ ሻአ አሳቱዋ ዴሙዋን ማታፋይ ዎዳ።<verse eid="REV 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 7:5"/>ይሁዳ ዛርያፐ፥</para>
  <para style="q2" vid="REV 7:5">ታማነ ላኡ ሻኣ ዴሙዋን ማታፋይ፥</para>
  <para style="m" vid="REV 7:5">ዎዳ።</para>
  <para style="q1" vid="REV 7:5">ሮቤላ ዛርያፐ፥</para>
  <para style="q2" vid="REV 7:5">ታማነ ላኡ ሻኣ።</para>
  <para style="q1" vid="REV 7:5">ጋደ ዛርያፐ፥</para>
  <para style="q2" vid="REV 7:5">ታማነ ላኡ ሻኣ።<verse eid="REV 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 7:6"/>አሴራ ዛርያፐ፥</para>
  <para style="q2" vid="REV 7:6">ታማነ ላኡ ሻኣ።</para>
  <para style="q1" vid="REV 7:6">ንፍታሌመ ዛርያፐ፥</para>
  <para style="q2" vid="REV 7:6">ታማነ ላኡ ሻኣ።</para>
  <para style="q1" vid="REV 7:6">ምናሰ ዛርያፐ፥</para>
  <para style="q2" vid="REV 7:6">ታማነ ላኡ ሻኣ።<verse eid="REV 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 7:7"/>ስሞና ዛርያፐ</para>
  <para style="q2" vid="REV 7:7">ታማነ ላኡ ሻኣ።</para>
  <para style="q1" vid="REV 7:7">ሌዊያ ዛርያፐ</para>
  <para style="q2" vid="REV 7:7">ታማነ ላኡ ሻኣ።</para>
  <para style="q1" vid="REV 7:7">ይሳኮራ ዛርያፐ</para>
  <para style="q2" vid="REV 7:7">ታማነ ላኡ ሻኣ።<verse eid="REV 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 7:8"/>ዛብሎና ዛርያፐ፥</para>
  <para style="q2" vid="REV 7:8">ታማነ ላኡ ሻኣ።</para>
  <para style="q1" vid="REV 7:8">ዮሴፎ ዛርያፐ፥</para>
  <para style="q2" vid="REV 7:8">ታማነ ላኡ ሻኣ።</para>
  <para style="q1" vid="REV 7:8">ቢንያማ ዛርያፐ፥</para>
  <para style="q2" vid="REV 7:8">ታማነ ላኡ ሻኣ</para>
  <para style="q2" vid="REV 7:8">ዴሙዋን ማታፋይ፥</para>
  <para style="m" vid="REV 7:8">ዎዳ።<verse eid="REV 7:8"/></para>
  <para style="s1">ቦ ማዩዋ ማዬዳ ጮራ አሳቱዋ</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9"/>ሄዋፐ ጉይያን፥ ዛርያ ኡባፐ፥ ቆሙዋ ኡባፐ፥ ያራ ኡባፐነ ዱማ ዱማ ጋድያ ቃላ ኡባፐ ኦንነ ፓይዳናዉ ዳንዳየና ዛዋይ ባይና ጮራ አሳ ታን በኣድ። ሄ አሳይ ቦ ማዩዋ ማዪደ፥ ዛምባ ሀይ ባረንቱ ኩሽያን ኦይቂደ፥ ካዉተ ኦይድያ ስንንነ ዶርሳ ስንን ኤቄዳ። <verse eid="REV 7:9"/><verse number="10" style="v" sid="REV 7:10"/>ኡንቱንቱ ባረንቱ ቃላ ቁ ኦደ፥</para>
  <para style="q1" vid="REV 7:10">“ኑ አቶተይካ፥</para>
  <para style="q2" vid="REV 7:10">ካዉተ ኦይድያን ኡቴዳ፥</para>
  <para style="q2" vid="REV 7:10">ኑ ጾሳፐነ ዶርሳፐ ዬ”</para>
  <para style="m" vid="REV 7:10">ያጌድኖ።<verse eid="REV 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 7:11"/>ኪታንቻቱ ኡባይ ካዉተ ኦይድያ፥ ጭማቱዋነ ደኡዋን ደእያ ኦይዱ መታ ዩይ አደ ኤቄድኖ። ኡንቱንቱ ካዉተ ኦይድያ ስንን ባረንቱ ዴሙዋን ጉፋኒደ ጾሳዉ ጎይኒደ፥<verse eid="REV 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="REV 7:12"/>“አመንእ!</para>
  <para style="q2" vid="REV 7:12">አንጁ፥ ቦንቹ፥</para>
  <para style="q2" vid="REV 7:12">አዳ ኤራተይ፥</para>
  <para style="q2" vid="REV 7:12">ጋላታይ፥ ሳባይ፥</para>
  <para style="q2" vid="REV 7:12">ዎልቃይ፥ ምኖተይ፥</para>
  <para style="q2" vid="REV 7:12">መናፐ መና ጋካናዉ ኑ ጾሳዉ ግዶ።</para>
  <para style="q1" vid="REV 7:12">አመንእ!”</para>
  <para style="m" vid="REV 7:12">ያጌድኖ።<verse eid="REV 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13"/>ጭማቱዋፐ እቱ ታና፥ “ሀ ቦ ማዩዋ ማዬዳ አሳቱ ኦኔ? ኡንቱንቱ ሀቃፐ ዬድኖ?” ያጊደ ኦቼዳ።<verse eid="REV 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14"/>ታን፥ “ታ ጎዳዉ፥ ኔን ኤራሳ” ያጋድ። እ ታና ሀዋዳን ያጌዳ፦</para>
  <para style="b" vid="REV 7:14"/>
  <para style="q1" vid="REV 7:14">“ሀዋንቱ ዳሮ ዋይያ ዋየቲደ ዬዳዋንታ።</para>
  <para style="q2" vid="REV 7:14">ኡንቱንቱ ባረንቱ ማዩዋ ዶርሳ ሱን ሜጪደ፥</para>
  <para style="q2" vid="REV 7:14">ቦጼዳዋንታ።<note caller="-" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="DAN 12:1">ዳኔላ 12:1</ref>፤ <ref loc="MAT 24:21">ማቶሳ 24:21</ref>፤ <ref loc="MRK 13:19">ማር. 13:19</ref></char></note><verse eid="REV 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="REV 7:15"/>ሄዋ ድራዉ፥</para>
  <para style="q2" vid="REV 7:15">ኡንቱንቱ ጾሳ ካዉተ ኦይድያ ስንን ኤቂደ፥</para>
  <para style="q2" vid="REV 7:15">ቃማነ ጋላስ፥ አ ጌሻ ጎልያን፥</para>
  <para style="q2" vid="REV 7:15">አዉ ኦኖ።</para>
  <para style="q1" vid="REV 7:15">ቃይ እ ባረ ካዉተ ኦይድያን ኡቴዳዌ፥</para>
  <para style="q2" vid="REV 7:15">ኡንቱንቱ ግዱዋን ደአና።<verse eid="REV 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="REV 7:16"/>ሀዋፐ ስንናዉ ኡባካ፥</para>
  <para style="q2" vid="REV 7:16">ኡንቱንቱ ኮሻትክኖ፤</para>
  <para style="q2" vid="REV 7:16">ዎይ ሳመትክኖ።</para>
  <para style="q2" vid="REV 7:16">አዋይ ኡንቱንታ ሜና፤</para>
  <para style="q2" vid="REV 7:16">ቃይ አይ ሴላይካ ኡንቱንታ ጉደና።<note caller="-" style="x"><char style="xo" closed="false">7:16 </char><char style="xt" closed="false"><ref loc="ISA 49:10">ኢሳ. 49:10</ref></char></note><verse eid="REV 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 7:17"/>አያዉ ጎፐ፥ ካዉተ ኦይደዉ፥</para>
  <para style="q2" vid="REV 7:17">ግዱዋን ኡቴዳ ዶርሳይ፥</para>
  <para style="q2" vid="REV 7:17">ኡንቱንታ ሄማና።</para>
  <para style="q2" vid="REV 7:17">ደኡዋ ሃ ፑልቱዋኮካ፥</para>
  <para style="q2" vid="REV 7:17">ኡንቱንታ ካለና።</para>
  <para style="q2" vid="REV 7:17">ጾሳይካ ኡንቱንቱ አይፍያ አፎ ኡባ ቁጭ ድጋና”</para>
  <para style="m" vid="REV 7:17">ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="PSA 23:1">ማዝ. 23:1</ref>፣ <ref loc="PSA 23:2">2</ref>፤ <ref loc="EZK 34:23">ህዝ. 34:23</ref>፤ <ref loc="ISA 49:10">ኢሳ. 49:10</ref>፤ <ref loc="ISA 25:8">25:8</ref></char></note><verse eid="REV 7:17"/></para>
  <chapter eid="REV 7"/>
  <chapter number="8" style="c" sid="REV 8"/>
  <para style="s1">ጻጸ ማጻፋ ላፑን ማታፋይ ዶየቴዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1"/>ዶርሳይ ላፑን ማታፋ ዶዬዳ ዎደ፥ ባካ ሳትያ ግድያዋ ኬና ሳሉ ጮኡ ጌዳ።<verse eid="REV 8:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 8:2"/>ሄዋፐ ጉይያን፥ ታን ላፑ ኪታንቻቱዋ ጾሳ ስንን ኤቂያዋንታ በኣድ፤ ኡንቱንቶ ላፑ ማላካታይ እመቴዳ።<verse eid="REV 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3"/>እጻና ጩዋይያ ዎርቃ ሚሻ ኦይቄዳ ሀራ ኪታንቻይ ዪደ፥ ያርሽያ ሳ ማታን ኤቄዳ። ዎርቃፐ መቴዳ ያርሽያሳይ ካዉተ ኦይድያ ስንን ደኤ፤ ሄ ያርሽያ ሳ ቦላ ጌሻ ኡባቱዋ ዎሳ ጉጃና ማላ፥ ኪታንቻዉ ዳሮ እጻናይ እመቴዳ።<note caller="-" style="x"><char style="xo" closed="false">8:3 </char><char style="xt" closed="false"><ref loc="AMO 9:1">አሞጻ 9:1</ref>፤ <ref loc="EXO 30:1">ከሳ 30:1</ref>፣ <ref loc="EXO 30:3">3</ref></char></note> <verse eid="REV 8:3"/><verse number="4" style="v" sid="REV 8:4"/>እጻና ጩዋይ ጌሻቱዋ ዎሳና እትፐ ሄ ኪታንቻ ኩሽያፐ ፑደ ጾሳኮ ቤዳ። <verse eid="REV 8:4"/><verse number="5" style="v" sid="REV 8:5"/>ሄዋፐ ጉይያን፥ ኪታንቻይ እጻና ጩዋይያዋ አኪደ፥ ያርሽያ ሳፐ ታማ ቦንቁዋ አኪደ፥ አን ኩንዳ። ሄ እጻና ጩዋይያዋ ዱገ ሳኣ ኦልና፥ ጉጉንይ ጉሜዳ። ዋልቃንይ ዎልቃሜዳ፤ ቃይ ቢታይካ ቃጼዳ።<note caller="-" style="x"><char style="xo" closed="false">8:5 </char><char style="xt" closed="false"><ref loc="REV 11:19">ሳፃ 11:19</ref>፤ <ref loc="REV 16:18">16:18</ref>፤ <ref loc="LEV 16:12">ዎጋ 16:12</ref>፣ <ref loc="LEV 16:18">18</ref>፤ <ref loc="EZK 10:2">ህዝ. 10:2</ref>፤ <ref loc="EXO 19:16">ከሳ 19:16</ref></char></note><verse eid="REV 8:5"/></para>
  <para style="s1">ማላካታቱ ፑነቴድኖ</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6"/>ቃይ ላፑ ማላካታ ኦይቂደ ላፑ ኪታንቻቱ ማላካታ ፑናናዉ ጊጌድኖ።<verse eid="REV 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7"/>ኮይሮ ኪታንቻይ ባረ ማላካታ ፑንና ሱና ዋላከቴዳ ሻቻይነ ታማይ ሳኣን ቡኬዳ። ሳኣፐ ሄዘን ኩሺ ጉደቴዳ፤ ምፐካ ሄዘን ኩሺ ጉደቴዳ፤ ማታ ኡባይካ ጉደቴዳ።<note caller="-" style="x"><char style="xo" closed="false">8:7 </char><char style="xt" closed="false"><ref loc="EXO 9:23-25">ከሳ 9:23-25</ref>፤ <ref loc="EZK 38:22">ህዝ. 38:22</ref></char></note><verse eid="REV 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8"/>ላኤን ኪታንቻይካ ባረ ማላካታ ፑኔዳ። ዎልቃማ ደርያ ማላትያባይ ታማን ኤጺደ፥ አባን የገቴዳ፤ ያትና፥ አባፐ ሄዘን ኩሺ ሱ ግዴዳ። <verse eid="REV 8:8"/><verse number="9" style="v" sid="REV 8:9"/>አባን ደኡዋን ደእያ መታቱዋ ሄዘን ኩሺ ሀይቄዳ፤ ማርካበቱዋፐካ ሄዘን ኩሺ ዬዳ።<verse eid="REV 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10"/>ሄዘን ኪታንቻይ ባረ ማላካታ ፑንና ሻፋፐነ ፑልቱዋ ሃፐ ሄዘን ኩሽያ ቦላ ሳሉዋፐ ጾምፕያዳን ኤጽያ ዎልቃማ ጾልንቲ ዎዳ።<note caller="-" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="ISA 14:12">ኢሳ. 14:12</ref></char></note> <verse eid="REV 8:10"/><verse number="11" style="v" sid="REV 8:11"/>ሄ ጾልንትያ ሱንይ ጫሙዋ ጌተቴ። ሃፐ ሄዘን ኩሺ ጫሜዳ፤ ቃይ ሃይ ጫሜዳ ድራዉ፥ ዳሮ አሳይ ሄ ሃ ኡሺደ ሀይቄዳ።<note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="JER 9:15">ኤር. 9:15</ref></char></note><verse eid="REV 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12"/>ኦይደን ኪታንቻይ ባረ ማላካታ ፑኔዳ። አዋፐ፥ አገናፐነ ጾልንትያፐ ሄዘን ኩሺ ደሸቴዳ፤ ኡንቱንቱ ፖኡዋፐካ ሄዘን ኩሺ ሜዳ። ሄዋ ድራዉ፥ ጋላሳፐ ሄዘን ኩሺ፥ ቃማፐካ ሄዘን ኩሺ ሜዳ።<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="ISA 13:10">ኢሳ. 13:10</ref>፤ <ref loc="EZK 32:7">ህዝ. 32:7</ref>፤ <ref loc="JOL 2:10">ኢዩ. 2:10</ref>፣ <ref loc="JOL 2:31">31</ref>፤ <ref loc="JOL 3:15">3:15</ref></char></note><verse eid="REV 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13"/>እት አርጋንይ ሳሉዋን ፓልያዋ ታን በኣድ። ሄ አርጋንይ ባረ ቃላ ቁ ኦደ፥ “ሄዙ ኪታንቻቱ ፑናና በስያ የኮ ማላካታይ ፑነትያ ዎደ፥ ሳኣን ደእያ አሳዉ አዬሮ! አዬሮ! አዬሮ!” ያግያዋ ስሳድ።<verse eid="REV 8:13"/></para>
  <chapter eid="REV 8"/>
  <chapter number="9" style="c" sid="REV 9"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1"/>ሄዋፐ ጉይያን፥ እቼሸን ኪታንቻይ ባረ ማላካታ ፑንና ሳሉዋፐ ዱገ ሳኣ ኩንዴዳ ጾልንትያ በኣድ። ሄ ጾልንተዉ ጪሞ ኦላ<note caller="+" style="f"><char style="fr" closed="false">9:1 </char><char style="fk" closed="false">ጪሞ ኦላ፦ </char><char style="ft" closed="false">ሀዋ ጉሳይ ጋርሳ ባጋ ቢታን ዳርስ ጪማቲደ ደእያ ኢታ አያናቱ ባረንቱ ዉርሰ ሙራ ጋላሳይ ጋካናዉ ቃሸቲደ ደኢያሳ።</char></note> ቁልፒ እመቴዳ። <verse eid="REV 9:1"/><verse number="2" style="v" sid="REV 9:2"/>ጾልንቲ ጪሞ ኦላ ዶዬዳ፤ አኮ ጮጭያፐ ከስያ ጩዋ ማላ ጩዋይ ሄ ጪሞ ኦላፐ ከሴዳ። ቃይ አዋይነ ሳአይ ሄ ጪሞ ኦላፐ ከሴዳ ጩዋን ሜድኖ።<note caller="-" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="GEN 19:28">ዶመ 19:28</ref></char></note><verse eid="REV 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 9:3"/>ጩዋፐ ቦሊ ዱገ ሳኣ ዬዳ። ሳኣን ደእያ ሶጋቶ ደእያ ዎልቃ ማላ ዎልቃይ ቦለዉካ እመቴዳ።<note caller="-" style="x"><char style="xo" closed="false">9:3 </char><char style="xt" closed="false"><ref loc="EXO 10:12-15">ከሳ 10:12-15</ref></char></note> <verse eid="REV 9:3"/><verse number="4" style="v" sid="REV 9:4"/>ጾሳ ማታፋይ ዴሙዋን ባይና አሳ ጻላላ ቆሀናፐ አትን፥ ሳኣን ደእያ ማታ ዎይ አጭያ ም ግድና ዎይ አይ ም ግድናካ ቆሄና ማላ፥ ቦለዉ ኦደቴዳ።<note caller="-" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="EZK 9:4">ህዝ. 9:4</ref></char></note> <verse eid="REV 9:4"/><verse number="5" style="v" sid="REV 9:5"/>ቦሊ ሄ አሳ እቼሹ አገና ግድያዋ ፓጻ ካአና ማላ፥ ማታይ እመቴዳዋፐ አትን፥ አዉ አሳ ዎናዉ ማታይ እመትቤና። ሶጉ አሳ ዱኪደ ሴልስያዋ ኬና ቦሊ ሴልሴ። <verse eid="REV 9:5"/><verse number="6" style="v" sid="REV 9:6"/>ሄ ጋላሳቱዋን አሳይ ሀይቁዋ ኮያና፤ ሽን ደመና። ቃይ ሀይቃናዉካ አሞታና፤ ሽን ሀይቁ አሳፐ ባቃታና።<note caller="-" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="JOB 3:21">ኢዮባ 3:21</ref>፤ <ref loc="JER 8:3">ኤር. 8:3</ref></char></note><verse eid="REV 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7"/>ቦሊ ኦላዉ ጊግ ኡቴዳ ፓራ ማላቴ። ቦልያ ሁጲያን ዎርቃ ማላትያ ካላቻይ ደኤ፤ አ ዴሙካ አሳ ዴሙዋ ማላቴ።<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="JOL 2:4">ኢዩ. 2:4</ref></char></note> <verse eid="REV 9:7"/><verse number="8" style="v" sid="REV 9:8"/>አ ብናናይካ ማጫ አሳ ብናናይዳ አዱቄ፤ አ አቻይካ ጋሙዋ አቻ ማላቴ።<note caller="-" style="x"><char style="xo" closed="false">9:8 </char><char style="xt" closed="false"><ref loc="JOL 1:6">ኢዩ. 1:6</ref></char></note> <verse eid="REV 9:8"/><verse number="9" style="v" sid="REV 9:9"/>አ ትራይ ብራታን ኦዳ ጎንዳልያ ማላትያዋን ጎዘት ኡቴዳ፤ ቃይ አ ቀፍያ ኮሻይ ኦላ ባናዉ ፕሪጽያ ፓራቱ ጎችያ ጋርያ ኮሻ ማላ።<note caller="-" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="JOL 2:5">ኢዩ. 2:5</ref></char></note> <verse eid="REV 9:9"/><verse number="10" style="v" sid="REV 9:10"/>አዉ ሶጉዋ ዱፍያ ማላትያ ዱፊ ደኤ፤ አ ዱፍያን ዱክያባይ ደኤ። ሄ ዱፍያን እቼሹ አገና ግድያዋ አሳ ቆሀናዳን፥ አዉ ማታይ እመቴዳ። <verse eid="REV 9:10"/><verse number="11" style="v" sid="REV 9:11"/>አ ሞድያ ካቲ ደኤ። ሄ ካቲ ጪሞ ኦላ ኪታንቻ። አ ሱንይካ እብራይስጸ ቃላን አብዶና፤ ቃይ ግሪከ ቃላን አጶልዮና ጌተቴ። አጶልዮና ግያዎ ብለይ፥ ይስያዋ ግያዋ።<verse eid="REV 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12"/>ኮይሮ አዬሮ ግያዌ አዳ፤ በአ፥ ብሮ ሀራ ላኡ አዬሮ ግያዌ ያናዋ።<verse eid="REV 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13"/>ኡሱፑን ኪታንቻይ ባረ ማላካታ ፑኔዳ። ጾሳ ስንን ኤቄዳ ዎርቃፐ መዳ ያርሽያሳን ደእያ ኦይዱ ጋጻ ካጨቱዋፐ እት ኮሻ ስሳድ።<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="EXO 30:1-3">ከሳ 30:1-3</ref></char></note> <verse eid="REV 9:13"/><verse number="14" style="v" sid="REV 9:14"/>ሄ ኮሻይ ማላካታይ ደእያ ኡሱፑን ኪታንቻ፥ “ኤፍራጺሳ ግያ ዎጋ ሻፋን ቃሸቴዳ ኦይዱ ኪታንቻቱዋ ብላ” ያጌዳ። <verse eid="REV 9:14"/><verse number="15" style="v" sid="REV 9:15"/>አሳ ዛርያፐ ሄዘን ኩሽያ ዎናዉ፥ ሀ ሳትያዉ፥ ጋላሳዉ፥ አገናዉነ ላይዉ ጊግስ ዎዳ፥ ኦይዱ ኪታንቻቱ ብለቴድኖ። <verse eid="REV 9:15"/><verse number="16" style="v" sid="REV 9:16"/>ኦላ ፓራ ቶግያ አሳ ፓይዱ ላኡ ጼቱ ሚሎነ ግድያዋ ታን ስሳድ።<verse eid="REV 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 9:17"/>ቃይካ ታን ሳጻን ፓራቱዋነ ሄ ፓራቱዋ ቶጌዳ አሳ በኣድ። አሳዉ ትራን ዎያ ብራታ ጎንዳልያ ማላይ ደኤ። ሄ ትራን ዎያ ብራታ ጎንዳልያ ማላይ ታማዳን ዞኦ፤ ሳማይያ፤ ቃይ ኤጽያ ዲንያ ማላ። ፓራቱዋ ሁጲ ጋሙዋ ሁጲያ ማላ። ኡንቱንቱ ዶናፐ ታማይ፥ ጩዋይነ አድልያ ጪሻ ማላትያ ኤጽያ ዲንያ ታማይ ከሴዳ። <verse eid="REV 9:17"/><verse number="18" style="v" sid="REV 9:18"/>ፓራቱዋ ዶናፐ ከሴዳ ታማን፥ ጩዋንነ ኤጽያ ዲንያን ሀ ሄዙ ቦሻቱዋን አሳ ዛርያፐ ሄዘን ኩሺ ሀይቄዳ። <verse eid="REV 9:18"/><verse number="19" style="v" sid="REV 9:19"/>አያዉ ጎፐ፥ ፓራቶ ዎልቃይ ዶናንነ ዱፍያን ደኤ። ኡንቱንቱ ዱፊካ ሁጲያና ደእያ ሾሻ ማላቴ፤ ሄዋን ኡንቱንቱ አሳ ቆሂኖ።<verse eid="REV 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20"/>ሀ ቦሻቱዋን ሀይቀናን አቴዳ አሳይ ባረ ኩሽያን ኦያዋ አግቤና። ቃይ ዎርቃፐ፥ ብራፐ፥ ናሃስያ ጌተትያ ብራታፐ ሹቻፐነ ምፐ ኦሰቴዳ፥ ጼላናዉ ዎይ ስሳናዉ ዎይ ሀመታናዉ ዳንዳየና ኤቃዉነ ጻላህያዉ ጎይንያዋካ አግቤና።<note caller="-" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="PSA 115:4-7">ማዝ. 115:4-7</ref>፤ <ref loc="PSA 135:15-17">135:15-17</ref>፤ <ref loc="DAN 5:23">ዳኔላ 5:23</ref></char></note> <verse eid="REV 9:20"/><verse number="21" style="v" sid="REV 9:21"/>አሳይ ኤሪድ ዎዳዋ፥ ዎይ ባረ ብቴዳዋ፥ ዎይ ባረ ዎሹሜዳዋ፥ ዎይ ባረ ዉኤዳዋ አጊደ፥ ባረ ናጋራፐ ስምቤና።<verse eid="REV 9:21"/></para>
  <chapter eid="REV 9"/>
  <chapter number="10" style="c" sid="REV 10"/>
  <para style="s1">ኪታንቻነ ጉ ማጻፋ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1"/>ቃይካ ታን ሀራ ዎልቃማ ኪታንቻይ ሳሉዋፐ ከሲደ፥ ዱገ ዎያዋ በኣድ። ሻርያ እ ማይ ኡቴዳ፤ ቃይ ዙሉ አ ሁጲያ ዩይ አ ኡቴዳ። አ ዴሙካ አዋ ማላ፤ አ ገዲካ ታማ ቱሳ ማላ። <verse eid="REV 10:1"/><verse number="2" style="v" sid="REV 10:2"/>ሄ ኪታንቻይ ዶያ ደእያ እት ጉ ጻጸቶ ማጻፋ ባረ ኩሽያን ኦይቄዳ። ባረ ኡሸቻ ገድያ አባ ቦላ ኤሲደ፥ ባረ ሀድርሳ ገድያ ቢታ ቦላ ኤሴዳ። <verse eid="REV 10:2"/><verse number="3" style="v" sid="REV 10:3"/>ጉድያ ጋሙዋዳን፥ ዎልቃፐ ጉዴዳ። እ ጉዴዳዋፐ ጉይያን፥ ላፑ ጉጉንቱ አናና ጉንን ሃሳዬድኖ።<verse eid="REV 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 10:4"/>ኡንቱንቱ ጉሜዳ ዎደ ታን ጻፋናዉ ቆፓድ። ሽን ሳሉዋፐ፥ “ላፑ ጉጉንቱ ሃሳዬዳዋ አሳዉ ቃቶፓነ ጻፎፓ” ያግያ ኮሻይ ታዉ ስሰቴዳ።<verse eid="REV 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5"/>ሄዋፐ ጉየ፥ አባ ቦላንነ ቢታ ቦላን ኤቂደእሽን ታን በኤዳ ኪታንቻይ፥ ባረ ኡሸቻ ኩሽያ ሳሉዋ ፑደ ምጬዳ።<note caller="-" style="x"><char style="xo" closed="false">10:5-7 </char><char style="xt" closed="false"><ref loc="EXO 20:11">ከሳ 20:11</ref>፤ <ref loc="DEU 32:40">ዛረ. 32:40</ref>፤ <ref loc="DAN 12:7">ዳኔላ 12:7</ref>፤ <ref loc="AMO 3:7">አሞጻ 3:7</ref></char></note> <verse eid="REV 10:5"/><verse number="6" style="v" sid="REV 10:6"/>ሳሉዋነ ሳሉዋን ደእያ ኡባባ፥ ሳኣነ ሳኣን ደእያ ኡባባ፥ አባነ አባን ደእያ ኡባባ፥ መዳ መ መናዉ ደእያ ጾሳ ሱንን ጫቄዳ። ያቲደ፥ “ዎዲ ዉራናዉ ጋምኤና። <verse eid="REV 10:6"/><verse number="7" style="v" sid="REV 10:7"/>ሽን ላፑን ኪታንቻይ ባረ ማላካታ ፑንያ ዎደ፥ ጾሳይ ናባቱዋ ግዴዳ ባረ ቆማቶ ቃላ ኦድ ዎዳዋዳንካ፥ እ ጹሬዳ ቆፋይ ፖለታና” ያጌዳ።<verse eid="REV 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8"/>ሄዋፐ ጉይያን፥ ሳሉዋፐ ሃሳይሽን ታን ስሴዳ ኮሻይ ላኤንዋ ዛሪደ ታና፥ “አባ ቦላንነ ቢታ ቦላን ኤቄዳ ኪታንቻ ኩሽያን ዶያ ደእያ ጻጸቶ ማጻፋ ባደ አካ” ያግያዋ ስሳድ።<note caller="-" style="x"><char style="xo" closed="false">10:8-10 </char><char style="xt" closed="false"><ref loc="EZK 2:8-3:3">ህዝ. 2:8—3:3</ref></char></note><verse eid="REV 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9"/>ታን ሄ ኪታንቻኮ ባደ፥ ጉ ጻጸቶ ማጻፋ ታዉ እማና ማላ፥ አ ኦቻድ። እ ታና፥ “አካደ ማ፤ ማጻፋይ ነ ኡሉዋ ጫምሳናዋ፤ ሽን ነ ዶናን ኤሳዳን፥ እ ማልአናዋ” ያጌዳ።<verse eid="REV 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 10:10"/>ሄዋፐ ጉየ፥ ታን ኪታንቻ ኩሽያፐ ሄ ጉ ጻጸቶ ማጻፋ አካደ ማድ፤ ታ ዶናን ማጻፋይ ኤሳዳን ማልኤዳ። ሽን ታን ሜዳዋፐ ጉይያን፥ ታ ኡሎ ግዱ ጫሜዳ። <verse eid="REV 10:10"/><verse number="11" style="v" sid="REV 10:11"/>ቃይካ ታና፥ “ያራ ኡባ፥ ዛርያ ኡባ፥ ዱማ ዱማ ቢታ ቃላነ ካታቱዋባ ኔን ትምቢትያ ቃንጸናን ሃሳያናዉ በሴ” ያጌዳ።<verse eid="REV 10:11"/></para>
  <chapter eid="REV 10"/>
  <chapter number="11" style="c" sid="REV 11"/>
  <para style="s1">ላኡ ማርካቱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1"/>ሄዋፐ ጉየ፥ ማቃ ማላትያ ልክያ ጻምአይ ታዉ እመቴዳ፤ ታና ጌዳዌ ሀዋ፤ “ባደ ጾሳ ጌሻ ጎልያነ ያርሽያ ሳ ልካ። ሄዋን ጎይንያዋንታካ ፓይዳ።<note caller="-" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="EZK 40:3">ህዝ. 40:3</ref>፤ <ref loc="ZEC 2:1-2">ዛካ. 2:1-2</ref></char></note> <verse eid="REV 11:1"/><verse number="2" style="v" sid="REV 11:2"/>ሽን ጌሻ ጎለዉ ካረ ባጋ አጋ ባሻ፤ ሄዋ ልኮፓ። አያዉ ጎፐ፥ ሄ ሳአይ አይሁዳ ግደና አሳዉ እመቴዳ። አይሁዳ ግደና አሳይ ጌሻ ካታማ ኦይታማነ ላኡ አገናዉ የና።<note caller="-" style="x"><char style="xo" closed="false">11:2 </char><char style="xt" closed="false"><ref loc="LUK 21:24">ሉቃሳ 21:24</ref></char></note> <verse eid="REV 11:2"/><verse number="3" style="v" sid="REV 11:3"/>ታን ጋብያ ማዬዳ ታ ላኡ ማርካቱዋ ኪታና፤ ኡንቱንቱ እት ሻአነ ላኡ ጼታነ ኡሱፑን ታሙ ጋላሳን ጾሳ ኪታ ኦዳና” ያጌዳ።<verse eid="REV 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4"/>ሄ ላኡ ማርካቱ ሀ ሳኣ ጎዳ ስንን ኤቂያ ጾምፕያ ዎያ ላኡ ባላቱዋ።<note caller="-" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="ZEC 4:3">ዛካ. 4:3</ref>፣ <ref loc="ZEC 4:11-14">11-14</ref></char></note> <verse eid="REV 11:4"/><verse number="5" style="v" sid="REV 11:5"/>ኦንነ ኡንቱንታ ቆሀናዉ ኮዮፐ፥ ኡንቱንቱ ዶናፐ ታማይ ከሲደ ኡንቱንቱ ሞርከቱዋካ ይሴ። ቃይ ኦንነ ኡንቱንታ ቆሀናዉ ኮዮፐ፥ ሄዋዳንካ ሀይቃና። <verse eid="REV 11:5"/><verse number="6" style="v" sid="REV 11:6"/>ኡንቱንቱ ጾሳ ኪታ ኦድያ ዎድያን እራይ ቡከናዳን፥ ሳሉዋ ጎርዳናዉ ኡንቱንቶ ማታይ ደኤ። ኡንቱንቶ ሃ ሱ ከስያ ማታይካ ደኤ፤ ቃይ ኡንቱንቱ ባረና ኮሽያ ዎደ፥ ሳኣ ዱማ ዱማ ቦሻን ሾጫናዉ ኡንቱንቶ ማታይ ደኤ።<note caller="-" style="x"><char style="xo" closed="false">11:6 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 ካታ. 17:1</ref>፤ <ref loc="EXO 7:17-19">ከሳ 7:17-19</ref>፤ <ref loc="1SA 4:8">1 ሳሜላ 4:8</ref></char></note><verse eid="REV 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7"/>ኡንቱንቱ ባረንቱ ማርካተ ዉርሴዳዋፐ ጉይያን፥ ጪሞ ኦላፐ ፑደ ከስያ ዶአይ ኡንቱንቱና ኦለታና። ሄ ዶአይ ኡንቱንታ ጾኒደ ዎና።<note caller="-" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="DAN 7:7">ዳኔላ 7:7</ref>፣ <ref loc="DAN 7:21">21</ref>፤ <ref loc="REV 13:5-7">ሳፃ 13:5-7</ref>፤ <ref loc="REV 17:8">17:8</ref></char></note> <verse eid="REV 11:7"/><verse number="8" style="v" sid="REV 11:8"/>ኡንቱንቱ ጎዳይ ማስቃልያ ቦላን ምስማርያን ሸቲደ ሱለቴዳ ካታማ ዎጋ ኦግያን ኡንቱንቱ አሃይ ግሳናዋ። ሄ ካታማይ ሌምሱዋን ሶዶማ ዎይ ግብጼ ጌተቲደ ጼሰቴ።<note caller="-" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="ISA 1:9-10">ኢሳ. 1:9-10</ref></char></note> <verse eid="REV 11:8"/><verse number="9" style="v" sid="REV 11:9"/>ቃይ ያራ ኡባፐ፥ ቆሙዋ ኡባፐ፥ ዱማ ዱማ ቢታ ቃላፐነ ዛርያ ኡባፐ ዬዳ አሳይ ኡንቱንቱ አሃ ሄዙ ጋላሳነ ባጋ በአና። አሃይ ሞገተና ማላ፥ ሄ አሳይ ድጋና። <verse eid="REV 11:9"/><verse number="10" style="v" sid="REV 11:10"/>ሳኣን ደእያ አሳይ ሀ ትምቢትያ ኦድያ ላኡ አሳቱዋ ሀይቁዋን ናሸታና። አሳይ ኡንቱንቱ ሀይቁዋ እቱ እቱዋና እሞታ ላመቲደ ቦንቻናዋ፤ አያዉ ጎፐ፥ ሳኣን ደእያ አሳ ኡንቱንቱ ዳርስ መቶድኖ።<verse eid="REV 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 11:11"/>ሄዙ ጋላሳነ ባጋፐ ጉይያን፥ ደኡዋ ሸምፑዋ ጾሳይ ኡንቱንቱን ሸምፕና፥ ኡንቱንቱ ደንድ ኤቄድኖ። ኡንቱንታ በኤዳ ኡባይ ኢታ ያሻ ያዬዳ።<note caller="-" style="x"><char style="xo" closed="false">11:11 </char><char style="xt" closed="false"><ref loc="EZK 37:10">ህዝ. 37:10</ref></char></note> <verse eid="REV 11:11"/><verse number="12" style="v" sid="REV 11:12"/>ሄዋፐ ጉይያን፥ ሄ ትምቢትያ ኦድያ ላኡ አሳቱ ሳሉዋፐ፥ “ሃ ፑደ ከስተ” ግያ ዎልቃማ ኮሻ ስሴድኖ። ባረንቱ ሞርከቱ ባረንታ ጼልሽን፥ ኡንቱንቱ ሻርያን ገሊደ፥ ፑደ ሳሉዋ ቤድኖ።<note caller="-" style="x"><char style="xo" closed="false">11:12 </char><char style="xt" closed="false"><ref loc="2KI 2:11">2 ካታ. 2:11</ref></char></note><verse eid="REV 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 11:13"/>ሄ ሳትያን ቢታይ ሎይ ቃጽና ካታማፐ ታሙን ኩሺ ዬዳ። ቃይ ቢታ ቃን ላፑ ሻአ አሳይ ሀይቄዳ። አቴዳ አሳይ ሎይ ኮኮር ያዪደ፥ ሳሉዋ ጾሳ ግታተ ሳቤዳ።<verse eid="REV 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14"/>ላኤን አዬሮ ግያዌ አዳ። ሽን አኬክተ፤ ሄዘን አዬሮ ግያዌ ኤለካ ያናዋ።<verse eid="REV 11:14"/></para>
  <para style="s1">ላፑን ማላካታ</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15"/>ሄዋፐ ጉይያን፥ ላፑን ኪታንቻይካ ባረ ማላካታ ፑኔዳ። ሳሉዋን፥</para>
  <para style="q1" vid="REV 11:15">“አላምያ ካዉተይ</para>
  <para style="q2" vid="REV 11:15">ሀእ ኑ ጎዳሳነ</para>
  <para style="q1" vid="REV 11:15">ክርስቶሳሳ፤</para>
  <para style="q2" vid="REV 11:15">ቃይ መናፐ መና ጋካናዉ</para>
  <para style="q1" vid="REV 11:15">እ ሞዳና”</para>
  <para style="m" vid="REV 11:15">ያግያ ዎልቃማ ኮሻይ ስሰቴዳ።<note caller="-" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="EXO 15:18">ከሳ 15:18</ref>፤ <ref loc="DAN 2:44">ዳኔላ 2:44</ref>፤ <ref loc="DAN 7:14">7:14</ref>፣ <ref loc="DAN 7:27">27</ref></char></note><verse eid="REV 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 11:16"/>ባረንቱ ኦይድያን ኡቴዳ ላታማነ ኦይዱ ጭማቱ ጾሳ ስንን ዱገ ጉፋኒደ፥ ጾሳዉ ጎይኒደ ሀዋዳን ያጌድኖ፤<verse eid="REV 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 11:17"/>“ሀእ ደእያዎ፥</para>
  <para style="q2" vid="REV 11:17">ካሰፐካ ደእያዎ፥ ጎዳዉ፥</para>
  <para style="q1" vid="REV 11:17">ኡባፐ ዎልቃማ ጾሳዉ፥</para>
  <para style="q2" vid="REV 11:17">ነዉ ዎልቃማ ዎልቃይ ደእያ ድራዉነ፥</para>
  <para style="q2" vid="REV 11:17">ኔን ሞዳናዉ ዶሜዳ ድራዉ፥</para>
  <para style="q2" vid="REV 11:17">ኑን ኔና ጋላቴቶ።<verse eid="REV 11:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18"/>አይሁዳ ግደና አሳይ ሀንቀቴዳ፤</para>
  <para style="q2" vid="REV 11:18">ነ ሀንቁካ ዬዳ።</para>
  <para style="q1" vid="REV 11:18">ሀይቄዳዋንቱ ፕርደትያ ዎዲ ሀአ፤</para>
  <para style="q2" vid="REV 11:18">ቃይ ኔን ነ ኦሳንቻቶ፥ ናባቶ፥</para>
  <para style="q2" vid="REV 11:18">ጌሻቶ፥ ነ ሱንዉ ያይያዋንቶ፥</para>
  <para style="q2" vid="REV 11:18">ቃቶነ ላፋቶ ኡንቱንቱ ኦሱዋዳን፥</para>
  <para style="q2" vid="REV 11:18">እምያ ዎዲካ ሀአ።</para>
  <para style="q2" vid="REV 11:18">ሳኣ ይስያዋንታካ ኔን ይስያ ዎዲ ሀአ”</para>
  <para style="m" vid="REV 11:18">ያጌድኖ።<note caller="-" style="x"><char style="xo" closed="false">11:18 </char><char style="xt" closed="false"><ref loc="PSA 2:5">ማዝ. 2:5</ref>፤ <ref loc="PSA 110:5">110:5</ref>፤ <ref loc="PSA 115:13">115:13</ref></char></note><verse eid="REV 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19"/>ሳሉዋን ደእያ ጾሳ ጌሻ ጎሊ ዶየቴዳ፤ አ ጌሻ ጎልያን ጾሳ ቃላ ጫቁዋ ታቦታይ ቤቴዳ። ቃይ ዋልቃንይ ዎልቃሜዳ፤ ጉንይ ስሰቴዳ፤ ጉጉንይ ጉሜዳ፤ ቢታይ ቃጼዳ፤ ዎልቃማ ሻቻይካ ሻጬዳ።<verse eid="REV 11:19"/></para>
  <chapter eid="REV 11"/>
  <chapter number="12" style="c" sid="REV 12"/>
  <para style="s1">ታን ምሽራቶ፥ ናኣነ ዳዊያ በኣድ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1"/>ሄዋፐ ጉይያን፥ ሳሉዋን ዎልቃማ ማላይ ቤቴዳ። አዋ ማዬዳ እት ምሽራታ፥ አገና ቦላ ኤቄዳዉና፥ ታማነ ላኡ ጾልንትያ ካላቻ ባረ ሁጲያን ዎዳዉና ሄዋን ደአዉ። <verse eid="REV 12:1"/><verse number="2" style="v" sid="REV 12:2"/>ሄ ምሽራታ ሻሃራ፤ እዞ የሉዋ ኦይይ፥ ኡንኤና ዋሳዱ።<verse eid="REV 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 12:3"/>ሀራ እት ዎልቃማ ማላይ ሳሉዋን ቤቴዳ። ታሙ ካጭያና ደእያ ላፑ ሁጲያን ካላቻ ዎዳ እት ዎልቃማ ዞኦ ዳዊ ደኤ።<note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="DAN 7:7">ዳኔላ 7:7</ref></char></note> <verse eid="REV 12:3"/><verse number="4" style="v" sid="REV 12:4"/>ሄ ዳዊ ባረ ዱፍያን ሄዘን ኩሸ ጾልንትያ ሳሉዋፐ ዳፊደ፥ ሳኣን ኦሌዳ። ሄ ዳዊ የለት ዎሳናካ ናኣ ማናዉ የላና ሀንያ ምሽራት ስንን ኤቄዳ።<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="DAN 8:10">ዳኔላ 8:10</ref></char></note><verse eid="REV 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 12:5"/>ምሽራታ አቱማ ናኣ፥ አይሁዳ ግደና አሳ ኡባ ብራታ ጻምኣን ሞዳናዋ የላዱ። ሽን ናአይ ጾሳኮነ አ አራታኮ፥ ፑደ ኤለካ አከቴዳ።<note caller="-" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="ISA 66:7">ኢሳ. 66:7</ref>፤ <ref loc="PSA 2:9">ማዝ. 2:9</ref></char></note> <verse eid="REV 12:5"/><verse number="6" style="v" sid="REV 12:6"/>ምሽራታ እት ሻአነ ላኡ ጼታነ ኡሱፑን ታሙ ጋላሳዉ ምዚደነ ኡሺደ ዎናዉ ጾሳይ ጊግስ ዎዳ ሳኣ ባዙዋ ባቃታዱ።<verse eid="REV 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7"/>ሄዋፐ ጉይያን፥ ሳሉዋን ኦላይ ደንዴዳ። ምካኤል ባረ ኪታንቻቱዋና እትፐ ዳዊያ ኦለቴዳ፤ ዳዊካ ባረ ኪታንቻቱዋና ግዲደ፥ ዛር ኦለቴዳ።<note caller="-" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="DAN 10:13">ዳኔላ 10:13</ref>፣ <ref loc="DAN 10:21">21</ref>፤ <ref loc="DAN 12:1">12:1</ref>፤ <ref loc="DAN 9">ዳኔላ 9</ref></char></note> <verse eid="REV 12:7"/><verse number="8" style="v" sid="REV 12:8"/>ሽን ዳዊ ጾነትና ዳዊያስነ አ ኪታንቻቶ ሳሉዋን ሳአይ ዬዳ። <verse eid="REV 12:8"/><verse number="9" style="v" sid="REV 12:9"/>ዎልቃማ ዳዊ፥ ጻላህያ ካፑዋ ዎይ ሴጻና ግያዌ፥ በን ሾሻይ፥ አላምያ ኡባ ባለያዌ ኦለቴዳ፤ እ ባረ ኪታንቻቱዋና እትፐ ዱገ ሳአዉ ኦለቴዳ።<verse eid="REV 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10"/>ሄዋፐ ጉይያን፥ ታን ሳሉዋፐ ሀዋዳን ያግያ ኮሻ ስሳድ፤</para>
  <para style="q1" vid="REV 12:10">“ጾሳ አቶተይ ሀእ ዬዳ።</para>
  <para style="q2" vid="REV 12:10">ጾሳይ ባረዉ ካተ ግድያዋዳንካ፥</para>
  <para style="q2" vid="REV 12:10">ባረ ዎልቃ በሴዳ፤</para>
  <para style="q2" vid="REV 12:10">አ ክርስቶስ ባረ ማታ በሴዳ።</para>
  <para style="q1" vid="REV 12:10">አያዉ ጎፐ፥</para>
  <para style="q2" vid="REV 12:10">ቃማነ ጋላስ ጾሳ ስንን ኤቂደ፥</para>
  <para style="q2" vid="REV 12:10">ኑ እሻቱዋ ሞትያዌ፥</para>
  <para style="q2" vid="REV 12:10">ሳሉዋፐ ዱገ ኦለቴዳ።<note caller="-" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="JOB 1:9-11">ኢዮባ 1:9-11</ref>፤ <ref loc="ZEC 3:1">ዛካ. 3:1</ref></char></note><verse eid="REV 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 12:11"/>ኑ እሻቱ ዶርሳ ሱንነ፥</para>
  <para style="q2" vid="REV 12:11">ባረንቱ ቱሙ ማርካተን</para>
  <para style="q2" vid="REV 12:11">ዳዊያ ኦለቲደ ጾኔድኖ።</para>
  <para style="q2" vid="REV 12:11">ቃይ ኡንቱንቱ ባረንቱ ሸምፑዋ አ እምያዎ፥</para>
  <para style="q2" vid="REV 12:11">ቃረትበይክኖ።<verse eid="REV 12:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="REV 12:12"/>ሄዋ ድራዉ፥</para>
  <para style="q2" vid="REV 12:12">ሳሉነ ሳሉዋ ግዶን ደእያዋንቱ፥</para>
  <para style="q2" vid="REV 12:12">ናሸትተ።</para>
  <para style="q2" vid="REV 12:12">ሽን ሳአዉነ አባዉ አዬሮ!</para>
  <para style="q1" vid="REV 12:12">አያዉ ጎፐ፥</para>
  <para style="q2" vid="REV 12:12">ጻላህያ ካፑ፥</para>
  <para style="q2" vid="REV 12:12">ባረዉ ጉ ዎዲ አቴዳዋ ኤርያ ድራዉ፥</para>
  <para style="q2" vid="REV 12:12">ዎልቃማ ሀንቁዋን፥</para>
  <para style="q2" vid="REV 12:12">ዱገ ህንተንቱኮ ዎዳ”</para>
  <para style="m" vid="REV 12:12">ያጌዳ።<verse eid="REV 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13"/>ቃይ ዳዊ ባረና ዱገ ሳኣ ኦሌዳዋ በኤዳዋፐ ጉይያን፥ ሄ አቱማ ናኣ የሌዳ ምሽራቶ የደርሱዋ ዶሜዳ። <verse eid="REV 12:13"/><verse number="14" style="v" sid="REV 12:14"/>ምሽራቶ ሾሻይ ቆሄና ማላ፥ ሄዙ ላይነ ባጋ ማደነ ኡሻደ እዛ ናገትያሳ ባዙዋ ፓላደ ባና ማላ፥ ላኡ ዎልቃማ አርጋን ቀፊ እዝዉ እመቴዳ።<note caller="-" style="x"><char style="xo" closed="false">12:14 </char><char style="xt" closed="false"><ref loc="DAN 7:25">ዳኔላ 7:25</ref>፤ <ref loc="DAN 12:7">12:7</ref></char></note><verse eid="REV 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 12:15"/>ሄዋፐ ጉይያን፥ ምሽራቶ ድኡ ድኢደ አፋና ማላ፥ ሾሻይ ሻፋ ሃ ኬና ሃ ባረ ዶናፐ ምሽራት ጌዱዋን ጉሴዳ። <verse eid="REV 12:15"/><verse number="16" style="v" sid="REV 12:16"/>ሽን ቢታይ ምሽራቶ ማዴዳ፤ ቢታይ ባረ ዶና ዶዪደ፥ ዳዊያ ዶናፐ ከሴዳ ሃ ምት አጌዳ። <verse eid="REV 12:16"/><verse number="17" style="v" sid="REV 12:17"/>ዳዊ ምሽራትዉ ዳርስ ሀንቀቲደ፥ እዝ ዘረ ጾሳ አዛዙዋ ናግያ ኡባቱዋነ የሱስ ቆንጭሴዳ ቱሙ አማነትያዋንታ ኦላናዉ፥ <verse eid="REV 12:17"/><verse number="18" style="v" sid="REV 12:18"/>ቢደ አባ ዶናን ደእያ ሻፍያን ኤቄዳ።<verse eid="REV 12:18"/></para>
  <chapter eid="REV 12"/>
  <chapter number="13" style="c" sid="REV 13"/>
  <para style="s1">ታን አባፐ ከስያ ላኡ ዶአቱዋ በኣድ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1"/>ሄዋፐ ጉይያን፥ እት ዶአይ አባፐ ከስሽን፥ ታን በኣድ። አዉ ታሙ ካጪነ ላፑ ሁጲ ደኤ፤ አ ታሙ ካጭያ ቦላን ታሙ ካላቻይ ደኤ። አ ሁጲያንካ ቦርያ ሱንይ ጻፈት ኡቴዳ።<note caller="-" style="x"><char style="xo" closed="false">13:1 </char><char style="xt" closed="false"><ref loc="DAN 7:3">ዳኔላ 7:3</ref>፤ <ref loc="REV 17:3">ሳፃ 17:3</ref>፣ <ref loc="REV 17:7-12">7-12</ref></char></note> <verse eid="REV 13:1"/><verse number="2" style="v" sid="REV 13:2"/>ታን በኤዳ ዶአይ ማህያ ማላቴ፤ አ ገዲ ባባን ጌተትያ ኢታ ዱኣ ገድያ ማላቴ፤ አ ዶናይ ጋሙዋ ዶና ማላቴ። ዳዊ ባረ ዎልቃ፥ ባረ ካዉተ ኦይድያነ ባረ ዎልቃማ ማታ ሄ ዶአዉ እሜዳ።<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="DAN 7:4-6">ዳኔላ 7:4-6</ref></char></note><verse eid="REV 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 13:3"/>ሄ ዶኣ ሁጰቱዋፐ እቱ ሀይቄዳዋ ማላትያዋ ታን በኣድ፤ ሽን ዎያ ማይይ ፓጼዳ። ሳኣ አሳይ ኡባይ ማላለቲደ፥ ሄ ዱኣ ጌዱዋ ካሌዳ። <verse eid="REV 13:3"/><verse number="4" style="v" sid="REV 13:4"/>ዳዊ ባረ ማታ ዶአዉ እሜዳ ድራዉ፥ አሳይ ኡባይ ዳዊያዉ ጎይኔዳ። ቃይ ሄ አሳይ፥ “ዶኣ ማላይ ኦኔ? አናና ኦለታናዉ ኦን ዳንዳዪ?” ያጊደ፥ ዶአዉ ጎይኔዳ።<verse eid="REV 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5"/>ሄ ዶአዉ ፓላ የዉዋነ ቦርያ ሃሳይያ ዶናይ እመቴዳ። ኦይታማነ ላኡ አገናዉ ኦና ማላ፥ አዉ ማታይ እመቴዳ።<note caller="-" style="x"><char style="xo" closed="false">13:5-6 </char><char style="xt" closed="false"><ref loc="DAN 7:8">ዳኔላ 7:8</ref>፣ <ref loc="DAN 7:25">25</ref>፤ <ref loc="DAN 11:36">11:36</ref></char></note> <verse eid="REV 13:5"/><verse number="6" style="v" sid="REV 13:6"/>ሄ ዶአይ ጾሳ፥ አ ሱን፥ እ ደኢያሳነ ሳሉዋን ደእያ ኡባቱዋ ቦርያ ዶሜዳ። <verse eid="REV 13:6"/><verse number="7" style="v" sid="REV 13:7"/>ሄ ዶአይ ጾሳ አሳቱዋና ኦለቲደ፥ ኡንቱንታ ጾናና ማላ፥ አዉ ማታይ እመቴዳ። ቆሙዋ ኡባ፥ ያራ ኡባ፥ ዱማ ዱማ ቢታ ቃላ ኡባነ ዛርያ ኡባ ሞድያ ማታይ አዉ እመቴዳ።<note caller="-" style="x"><char style="xo" closed="false">13:7 </char><char style="xt" closed="false"><ref loc="DAN 7:21">ዳኔላ 7:21</ref></char></note> <verse eid="REV 13:7"/><verse number="8" style="v" sid="REV 13:8"/>ሳአይ መታናፐ ካሰ ሹከቴዳ ዶርሳ ደኡዋ ማጻፋን ሱንይ ጻፈትቤና አሳይ፥ ሳኣን ደእያዌ ኡባይ፥ ሄ ዶአዉ ጎይናና።<note caller="-" style="x"><char style="xo" closed="false">13:8 </char><char style="xt" closed="false"><ref loc="PSA 69:28">ማዝ. 69:28</ref></char></note><verse eid="REV 13:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="REV 13:9"/>ስስያ ሀይይ ደእያ ኡራይ ስሶ።<verse eid="REV 13:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 13:10"/>ኦሞደታና አሳይ ደኦፐ፥</para>
  <para style="q2" vid="REV 13:10">ኦንነ ኦሞደታናዋ።</para>
  <para style="q1" vid="REV 13:10">ማሻን ሹከታና አሳይ ደኦፐ፥</para>
  <para style="q2" vid="REV 13:10">ኦንነ ማሻን ሹከታናዋ።</para>
  <para style="q1" vid="REV 13:10">ጌሻቱዋ ዳንዳያይነ፥</para>
  <para style="q2" vid="REV 13:10">አማኑ ሀዋን ኤረታናዋ።<note caller="-" style="x"><char style="xo" closed="false">13:10 </char><char style="xt" closed="false"><ref loc="JER 15:2">ኤር. 15:2</ref>፤ <ref loc="JER 43:11">43:11</ref></char></note><verse eid="REV 13:10"/></para>
  <para style="s1">ታን ሳኣፐ ከስያ ዶኣ በኣድ</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11"/>ሄዋፐ ጉይያን፥ ሀራ ዶአይ ሳኣፐ ከስያዋ ታን በኣድ። ዶርሳ ካጭያ ማላትያ ላኡ ካጪ አዉ ደኤ፤ ሽን ሄ ዶአይ ዳዊያዳን ሃሳዬዳ። <verse eid="REV 13:11"/><verse number="12" style="v" sid="REV 13:12"/>ሄ ዶአይ ኮይሮ ዶኣ ዎልቃማ ማታ ኡባ አ ስንን ኦዳ። ሳአይነ ሳኣን ደእያ አሳይ ኡባይ አ ዎያ ማይይ ፓጼዳ ኮይሮ ዶአዉ ጎይናና ማላ፥ ሄ ዶአይ ጎዳቴዳ። <verse eid="REV 13:12"/><verse number="13" style="v" sid="REV 13:13"/>ሄ ላኤን ዶአይ ዎልቃማ ማላታቱዋ ኦዳ፤ ሀራይ አቶ ታማ ሳሉዋፐ አሳ ኡባ ስን ሳኣ ዎና ጋካናዉ ማላታቱዋ ኦዳ። <verse eid="REV 13:13"/><verse number="14" style="v" sid="REV 13:14"/>ኮይሮ ዶኣ ስንን ኦናዉ፥ አዉ እመቴዳ ማላታቱዋን ሳኣን ደእያ አሳ ኡባ እ ባለዳ። ማሻን ማይቶፐነ ፓጻ ደእያ ኮይሮ ዶኣ ቦንቾ ምስልያ ጊግሳናዳን፥ ሳኣ አሳ ኡባዉ ላኤን ዶአይ ኦዴዳ። <verse eid="REV 13:14"/><verse number="15" style="v" sid="REV 13:15"/>ቃይ ኮይሮ ዶኣ ምስሊ ሃሳያናዳንነ ባረዉ ጎይነና ኡባ ዎናዳን፥ ላኤን ዶአይ ባረ ሸምፑዋ ኮይሮ ዶኣ ምስልያን ሸምፑዋ ገልሳናዉ አዛዘቴዳ።<verse eid="REV 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 13:16"/>አሳይ ኡባይ ዎጋይነ ቄራይ፥ ማንቁነ ዱሪ፥ ዎማኑነ አይሊ ባረ ኡሸቻ ኩሽያን ዎይ ባረ ዴሙዋን ማላ ዎናዳን፥ ሄ ላኤን ዶአይ ጎዳቴዳ። <verse eid="REV 13:16"/><verse number="17" style="v" sid="REV 13:17"/>ሄ ዶኣ ሱንይ ዎይ አ ሱን ፓይዱ ደእያ ማላይ ባይና አሳይ ኦንነ ዛልአናዉነ ሻማናዉ ዳንዳየና።<verse eid="REV 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18"/>አዳ ኤራተይ ሀዋን ደኤ። ኤራይ ደእያ ኦንነ ሄ ዶኣ ፓይዱዋ ብለ ኤሮ፤ አያዉ ጎፐ፥ ሄ ፓይዱ እት አሳ ሱን። አ ፓይዱ ኡሱፑን ጼታነ ኡሱፑን ታማነ ኡሱፑና።<verse eid="REV 13:18"/></para>
  <chapter eid="REV 13"/>
  <chapter number="14" style="c" sid="REV 14"/>
  <para style="s1">ታን ዶርሳነ 144,000 አሳቱዋ በኣድ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1"/>ሄዋፐ ጉይያን፥ ታን በኣድ። በእተ፥ ዶርሳይ ጽዮነ ደርያ ቦላ ኤቄዳ። አ ሱንይነ አ አቡ ሱንይ ዴሙዋን ጻፈቴዳ፥ እት ጼታነ ኦይታማነ ኦይዱ ሻአ አሳቱ አናና እትፐ ደኢኖ።<note caller="-" style="x"><char style="xo" closed="false">14:1 </char><char style="xt" closed="false"><ref loc="EZK 9:4">ህዝ. 9:4</ref>፤ <ref loc="REV 7:3">ሳፃ 7:3</ref></char></note> <verse eid="REV 14:1"/><verse number="2" style="v" sid="REV 14:2"/>ሳሉዋፐ ኩን ሃ ጉንነ ዳዳ ጉን ማላትያ ዎልቃማ ኮሻ ታን ስሳድ። ቃይ ታን ስሴዳ ኮሻይ ዲ ዲጽያዋንቱ ባረንቱ ዲ ዲጽና ስሰትያ ኮሻ ማላቴ። <verse eid="REV 14:2"/><verse number="3" style="v" sid="REV 14:3"/>እት ጼታነ ኦይታማነ ኦይዱ ሻአ አሳቱ ካዉተ ኦይድያ ስንን፥ ኦይዱ ፓጻ ደእያ መታቱዋ ስንንነ ጭማቱዋ ስንን ኤቄድኖ። ሳኣፐ ዎዘቴዳ ኡንቱንቱፐ አትን፥ ሀራይ ኦንነ ታማራናዉ ዳንዳየና ኦራ ማዝሙርያ የጼድኖ። <verse eid="REV 14:3"/><verse number="4" style="v" sid="REV 14:4"/>ሀዋንቱ ጌሻ አሳቱዋ ግድያ ድራዉ፥ ማጫዋንቱና ጋከቲደ ባረና ቱንስበይክኖ። ዶርሳይ<note caller="+" style="f"><char style="fr" closed="false">14:4 </char><char style="fq" closed="false">ዶርሳ፦ </char><char style="ft" closed="false">የሱሳዉ እመቴዳ ሱን።</char></note> ብያሳ ኡባ ኡንቱንቱ ካሊኖ። ኡንቱንቱ ጾሳዉነ ዶርሳዉ ባይራ ግዳናዉ፥ ሳኣ አሳ ግዶፐ ዎዘቴዳዋንታ። <verse eid="REV 14:4"/><verse number="5" style="v" sid="REV 14:5"/>ኡንቱንቱ ኡባካ ዎርዶት ኤርክኖ፤ ኡንቱንቱን ባይዙ ባዋ።<note caller="-" style="x"><char style="xo" closed="false">14:5 </char><char style="xt" closed="false"><ref loc="ZEP 3:13">ሶፎ. 3:13</ref></char></note><verse eid="REV 14:5"/></para>
  <para style="s1">ታን ጾሳ ኪታንቻ በኣድ</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6"/>ሳኣን ደእያ አሳ ኡባዉ፥ ዛርያ ኡባዉ፥ ቆሙዋ ኡባዉ፥ ዱማ ዱማ ቢታ ቃላ ኡባዉነ ያራ ኡባዉ መና ዎንጋላ ምሽራቹዋ አዋያናዉ፥ ቦላ ሳሉዋን ፓልያ ሀራ ኪታንቻ ታን በኣድ። <verse eid="REV 14:6"/><verse number="7" style="v" sid="REV 14:7"/>ሄ ኪታንቻይ ባረ ቃላ ቁ ኦደ፥ “ጾሳዉ ያይተ፤ አ ቦንችተ። አያዉ ጎፐ፥ ሳኣ አሳ እ ፕርድያ ሳቲ ጋኬዳ። ሳሉዋ፥ ሳኣ፥ አባነ ሃ ፑልቱዋ መዳ ጾሳዉ ጎይንተ” ያጌዳ።<verse eid="REV 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8"/>ሀራ ላኤን ኪታንቻይ፥ “ዎልቃማ ባብሎና ኩንዳዱ፤ እዛ ኩንዴዳ ጋሱነካ አሳ ዛርያ ኡባ ኢታ ኦሱዋ ኦስስያ ድራሳ” ያጊደ፥ ኮይሮ ኪታንቻ ካሌዳ።<note caller="-" style="x"><char style="xo" closed="false">14:8 </char><char style="xt" closed="false"><ref loc="ISA 21:9">ኢሳ. 21:9</ref>፤ <ref loc="JER 51:8">ኤር. 51:8</ref>፤ <ref loc="REV 18:2">ሳፃ 18:2</ref></char></note><verse eid="REV 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9"/>ሄዘን ኪታንቻይ ባረ ኮሻ ቁ ኦደ፥ ሀዋዳን ያጊደ፥ ኮይሮ ላኡ ኪታንቻቱዋ ካሌዳ፤ “ዶአዉነ አ ምስለዉ ጎይንያ ኦንነ ቃይ አ ማላ ባረ ዴሙዋን ዎይ ባረ ኩሽያን ዎያ ኦንነ ደኦፐ፥ <verse eid="REV 14:9"/><verse number="10" style="v" sid="REV 14:10"/>ጾሳይ ባረ ዎልቃማ ሀንቁዋ ቡርጩኩዋን ኩንዳ ሀንቁዋ ዎይንያ ኤሳ እ ኡሻና። ሄዋ ኦዳ ኡባይ ጌሻ ኪታንቻቱዋ ስንንነ ዶርሳ ስንን፥ ታማንነ ኤጽያ ዲንያን ፓጻ ካኤታና።<note caller="-" style="x"><char style="xo" closed="false">14:10 </char><char style="xt" closed="false"><ref loc="ISA 51:17">ኢሳ. 51:17</ref>፤ <ref loc="GEN 19:24">ዶመ 19:24</ref>፤ <ref loc="EZK 38:22">ህዝ. 38:22</ref></char></note> <verse eid="REV 14:10"/><verse number="11" style="v" sid="REV 14:11"/>ኡንቱንታ ፓጻ ካእያ ታማ ጩዋይ መ መናዉ ጩዋታና። ዶአዉነ ሄ ዶኣ ምስለዉ ጎይንያ ኦስነ ቃይ ሄ ዶኣ ሱን ማላታና ደእያ ኦስነ ቃማነ ጋላስ ሸምፑ ባዋ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">14:11 </char><char style="xt" closed="false"><ref loc="ISA 34:10">ኢሳ. 34:10</ref></char></note><verse eid="REV 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 14:12"/>ጾሳዉ አዛዘትያነ የሱሳዉ አማነትያ ጌሻቱ ዳንዳይያ ዳንዳያይ ሀዋና።<verse eid="REV 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13"/>ሄዋፐ ጉይያን ሳሉዋፐ፥ “ሀዋ ጻፋ፤ ሀዋፐ ስንዉ ጎዳን ሀይቂያዋንቱ አንጀቴዳዋንታ” ያግያ ኮሻ ታን ስሳድ።</para>
  <para style="p" vid="REV 14:13">አያናይ፥ “ቱማ፤ ኡንቱንቱ ባረንቱ ዳቡራፐ ሸምፓና፤ አያዉ ጎፐ፥ ኡንቱንቱ ሎኦ ኪታዉ፥ ጾሳይ ሎኡዋን ዛራና” ያጌ።<verse eid="REV 14:13"/></para>
  <para style="s1">ታን ቆይቻ ዎድያ በኣድ</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14"/>ቃይካ ታን በኣድ። በእተ፥ ቦ ሻሪ ደኤ። ሻርያ ቦላን አሳ ናኣ ማላትያዌ ኡቴዳ፤ አ ሁጲያን ዎርቃ ካላቻይ፥ ቃይ አ ኩሽያን ቃራ ባጫይ ደኤ።<note caller="-" style="x"><char style="xo" closed="false">14:14 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳኔላ 7:13</ref></char></note> <verse eid="REV 14:14"/><verse number="15" style="v" sid="REV 14:15"/>ሀራ ኪታንቻይ ጌሻ ጎልያፐ ከሲደ፥ ሻርያ ቦላን ኡቴዳዎ ባረ ቃላ ቁ ኦደ፥ “ቆይቻ ሳቲ ጋኬዳ ድራዉ፥ ነ ባጫ የዳደ ካ ቆይጫ፤ አያዉ ጎፐ፥ ሳኣ ካይ መሌዳ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">14:15 </char><char style="xt" closed="false"><ref loc="JOL 3:13">ኢዩ. 3:13</ref></char></note> <verse eid="REV 14:15"/><verse number="16" style="v" sid="REV 14:16"/>ሻርያ ቦላን ኡቴዳዌ፥ ባረ ባጫ ሳኣ የዲደ፥ ሳኣ ካ ጫኬዳ።<verse eid="REV 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17"/>ቃይካ ሳሉዋን ደእያ ጌሻ ጎልያፐ ሀራ ኪታንቻይ ከሴዳ፤ አዉካ ኩሳ ባጫይ ደኤ።<verse eid="REV 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 14:18"/>ታማዉ ካፖ ግዴዳ ሀራ ኪታንቻይ ያርሽያ ሳፐ ከሲደ፥ ኩሳ ባጫይ ደእያ ኪታንቻዉ ባረ ቃላ ቁ ኦደ፥ “ዎይንያ አይፊ ቴሬዳ ድራዉ፥ ነ ኩሳ ባጫ የዳደ፥ ሳኣን ደእያ ዎይንያ ቱራፐ ሆንዶዳ አይፍያ ቃንጻ!” ያጌዳ። <verse eid="REV 14:18"/><verse number="19" style="v" sid="REV 14:19"/>ሄ ኪታንቻይ ባረ ባጫ ሳኣ የዲደ፥ ሳኣን ደእያ ዎይንያፐ ሆንዶዳ አይፍያ ቃንጼዳ፤ ጾሳ ዎልቃማ ሀንቁዋ ሄ ዎይንያ ጉምእያ ኦላን የጌዳ። <verse eid="REV 14:19"/><verse number="20" style="v" sid="REV 14:20"/>ካታማፐ ጋጻን ደእያ ዎይንያ አይፍያ ጉምእያ ኦላን ዎይንያ አይፊ ጉምኤቴ። ሱይ ከሲደ፥ ሄ ዎይንያ ጉምእያ ኦላፐ ሄዙ ጼቱ ኪሎ ሚትርያ ኬና ሃኪደ፥ ፓራዉ ፑሉዋ ጋክያዋ ኬና ቁ ጊደ ኤሌዳ።<note caller="-" style="x"><char style="xo" closed="false">14:20 </char><char style="xt" closed="false"><ref loc="ISA 63:3">ኢሳ. 63:3</ref>፤ <ref loc="LAM 1:15">ሴላ 1:15</ref>፤ <ref loc="REV 19:15">ሳፃ 19:15</ref></char></note><verse eid="REV 14:20"/></para>
  <chapter eid="REV 14"/>
  <chapter number="15" style="c" sid="REV 15"/>
  <para style="s1">ታን ቡርጩኩዋ አባ ቤኣድ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1"/>ታን ሳሉዋን ሀራ ዎልቃማነ ማላልስያ ማላ በኣድ። ጾሳ ሀንቁ ኡንቱንቱ ቦላን ፖለትያ ድራዉ፥ ዉርሰ ላፑ ቦሻና ደእያ ላፑ ኪታንቻቱ ደኢኖ።<verse eid="REV 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 15:2"/>ቃይካ ታን ቡርጩኩዋ አባ ማላትያዋ ታማና ዋላከቴዳዋ በኣድ። ቃይ ዶኣ፥ አ ምስልያነ አ ሱን ፓይዱዋ ጾኔዳዋንታ በኣድ። ጾሳይ ኡንቱንቶ እሜዳ ዲቱዋ ኦይቂደ፥ ቡርጩኩዋ ማላትያ አባ ማታን ኡንቱንቱ ኤቄድኖ። <verse eid="REV 15:2"/><verse number="3" style="v" sid="REV 15:3"/>ኡንቱንቱ፥ ጾሳ ኦሳንቻ ሙሴ ማዝሙርያነ ዶርሳ ማዝሙርያ ሀዋዳን የጼድኖ።</para>
  <para style="q1" vid="REV 15:3">“ጎዳዉ፥ ኡባፐ ዎልቃማ ጾሳዉ፥</para>
  <para style="q2" vid="REV 15:3">ነ ኪታይ ግታነ ማላልስያዋ።</para>
  <para style="q1" vid="REV 15:3">አሳ ዛርያ ኡባ ካተዉ፥</para>
  <para style="q2" vid="REV 15:3">ነ ኦጊ ጽሉዋነ ቱሙዋ።<note caller="-" style="x"><char style="xo" closed="false">15:3 </char><char style="xt" closed="false"><ref loc="EXO 15:1">ከሳ 15:1</ref></char></note><verse eid="REV 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4"/>ጎዳዉ፥ ነዉ ያየናዌነ</para>
  <para style="q2" vid="REV 15:4">ነ ሱን ቦንቼናዌ ኦኔ?</para>
  <para style="q1" vid="REV 15:4">አያዉ ጎፐ፥ ጌሻይ ነ ጻላላ።</para>
  <para style="q2" vid="REV 15:4">አሳ ዛርያ ኡባይ ዪደ፥</para>
  <para style="q2" vid="REV 15:4">ነ ስንን ጎይናና፤</para>
  <para style="q2" vid="REV 15:4">አያዉ ጎፐ፥ ነ ጽሎ ኪታይ</para>
  <para style="q2" vid="REV 15:4">ኡባዉ ቆንጬዳ”</para>
  <para style="m" vid="REV 15:4">ያጊደ የጺኖ።<note caller="-" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="JER 10:7">ኤር. 10:7</ref>፤ <ref loc="PSA 86:9">ማዝ. 86:9</ref></char></note><verse eid="REV 15:4"/></para>
  <para style="s1">ላፑ ቦሻና ደእያ ላፑ ኪታንቻቱዋ</para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5"/>ሄዋፐ ጉይያን፥ ታን ሳሉዋን ደእያ ጌሻ ጎሊ ዶየቶዋ ሄዌካ ማርካተ ዱንካንያ በኣድ።<note caller="-" style="x"><char style="xo" closed="false">15:5 </char><char style="xt" closed="false"><ref loc="EXO 38:21">ከሳ 38:21</ref></char></note> <verse eid="REV 15:5"/><verse number="6" style="v" sid="REV 15:6"/>ላፑ ቦሻና ደእያ ላፑ ኪታንቻቱ ጌሻ ጎልያፐ ከሴድኖ። ኡንቱንቱ ጶሊደ ቦጽያ ላይኑዋ ማዩዋ ማዬድኖ፤ ባረንቱ ትራ ዎርቃ ዳንጩዋን ዩሽ አደ ቃቼድኖ። <verse eid="REV 15:6"/><verse number="7" style="v" sid="REV 15:7"/>ደኡዋን ደእያ ኦይዱ መታቱዋፐ እቱ፥ መ መናዉ ጋካናዉ ደእያ ጾሳ ሀንቁ ኩሜዳ ላፑ ዎርቃ ከረቱዋ ላፑ ኪታንቻቶ እሜዳ። <verse eid="REV 15:7"/><verse number="8" style="v" sid="REV 15:8"/>ጾሳ ቦንቹዋፐነ አ ዎልቃፐ ዬዳ ጩዋይ ጌሻ ጎልያ ኩሜዳ። ላፑ ኪታንቻቱ አሄዳ ላፑ ቦሻቱ ፖለታና ጋካናዉ፥ ጌሻ ጎልያ ኦንነ ገላናዉ ዳንዳይቤና።<note caller="-" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="EXO 40:34">ከሳ 40:34</ref>፤ <ref loc="1KI 8:10-11">1 ካታ. 8:10-11</ref>፤ <ref loc="2CH 5:13-14">2 ኦዱዋ 5:13-14</ref>፤ <ref loc="ISA 6:4">ኢሳ. 6:4</ref></char></note><verse eid="REV 15:8"/></para>
  <chapter eid="REV 15"/>
  <chapter number="16" style="c" sid="REV 16"/>
  <para style="s1">ጾሳ ሀንቁ ኩሜዳ ከረቱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1"/>ሄዋፐ ጉይያን፥ ላፑ ኪታንቻቶ፥ “ቢደ ጾሳ ሀንቁዋ ላፑ ከርያፐ ሳኣን ጉስተ” ያጊደ፥ ጌሻ ጎልያፐ ሃሳይያ ዎልቃማ ኮሻ ታን ስሳድ።<verse eid="REV 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2"/>ኮይሮ ኪታንቻይ ቢደ፥ ባረ ከርያን ደእያዋ ሳኣን ጉስና፥ ዶኣ ማላይ ደእያዋንቱ ቦላነ ሄ ዶኣ ምስለዉ ጎይንያዋንቱ ቦላ ሎይ ሳክያ ማይ ከሴዳ።<note caller="-" style="x"><char style="xo" closed="false">16:2 </char><char style="xt" closed="false"><ref loc="EXO 9:10">ከሳ 9:10</ref></char></note><verse eid="REV 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3"/>ላኤን ኪታንቻይ ባረ ከርያን ደእያዋ አባን ጉስና አባ ሃይ ሀይቄዳ አሳ ሱ ማላቴዳ። ቃይ አባን ደእያ መታ ኡባይካ ሀይቂ አጌዳ።<verse eid="REV 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4"/>ሄዘን ኪታንቻይ ባረ ከርያን ደእያዋ ሻፋቱዋንነ ፑልታቱዋን ጉስና ኡንቱንቱ ሱ ግዴድኖ።<note caller="-" style="x"><char style="xo" closed="false">16:4 </char><char style="xt" closed="false"><ref loc="EXO 7:17-21">ከሳ 7:17-21</ref>፤ <ref loc="PSA 78:44">ማዝ. 78:44</ref></char></note> <verse eid="REV 16:4"/><verse number="5" style="v" sid="REV 16:5"/>ሃዉ አዎትያ ኪታንቻይ ሀዋዳን ያግያዋ፥ ታን ስሳድ፤</para>
  <para style="q1" vid="REV 16:5">“ካሰካ ሀእካ ደእያ ጎዳዉ፥</para>
  <para style="q2" vid="REV 16:5">ጌሻዉ፥ ሀ ፕርዳ ፕርዴዳ ድራዉ፥</para>
  <para style="q2" vid="REV 16:5">ኔን ጽሉዋ።<verse eid="REV 16:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 16:6"/>ኡንቱንቱ ጌሻቱዋ ሱነ፥</para>
  <para style="q2" vid="REV 16:6">ናባቱዋ ሱ ጉሴዳ ድራዉ፥</para>
  <para style="q2" vid="REV 16:6">ኔን ኡንቱንታ ኡሻናዉ፥</para>
  <para style="q2" vid="REV 16:6">ሱ ኡንቱንቶ እማዳ።</para>
  <para style="q1" vid="REV 16:6">ኡንቱንቱ ባረንቶ፥</para>
  <para style="q2" vid="REV 16:6">በስያዋ አኬድኖ”</para>
  <para style="m" vid="REV 16:6">ያጌዳ።<verse eid="REV 16:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 16:7"/>ያርሹዋ ያርሽያ ሳፐ፥</para>
  <para style="q2" vid="REV 16:7">“ጎዳዉ፥ ኡባፐ ዎልቃማ ጾሳዉ፥</para>
  <para style="q2" vid="REV 16:7">ነ ፕርዳይ ቱሙዋነ ጽሉዋ!”</para>
  <para style="m" vid="REV 16:7">ያግያ ኮሻ ታን ስሳድ።<verse eid="REV 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8"/>ኦይደን ኪታንቻይ ባረ ከርያን ደእያዋ አዋይፍያ ቦላን ጉስና ባረ ታማ ሴላን አሳ ጉዳናዉ፥ አዋይፈዉ ማታይ እመቴዳ። <verse eid="REV 16:8"/><verse number="9" style="v" sid="REV 16:9"/>አሳይ ዎልቃማ ሴላን ጉደቲደ ሀ ቦሻቱዋ ቦላን ማታይ ደእያ ጾሳ ሱን ቦሬዳ። ሽን ባረ ናጋራፐ ስምቤናነ ጾሳ ግታተካ ቦንችቤና።<verse eid="REV 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10"/>እቼሸን ኪታንቻይ ባረ ከርያን ደእያዋ ዶኣ ካዉተ ኦይድያ ቦላ ጉስና፥ ሄ ዶኣ ካዉተይ ሜዳ። አሳይ ባረ ሴላ ድራዉ፥ ባረ እንጻርሳ ሳኤዳ።<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="EXO 10:21">ከሳ 10:21</ref></char></note> <verse eid="REV 16:10"/><verse number="11" style="v" sid="REV 16:11"/>ቃይ አሳይ ባረ ሴላ ድራዉነ ባረ ማይ ድራዉ ሳሉዋ ጾሳ ሸቄዳ። ሽን ባረ ኦዳ ናጋራፐ ስምቤና።<verse eid="REV 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12"/>ኡሱፑን ኪታንቻይ ባረ ከርያን ደእያዋ ዎጋ ኤፍራጺሳ ጌተትያ ሻፋን ጉስና አዋይ ዶልያ ባጋፐ ያና ካታቶ ኦጊ ጊጋናዳን፥ ሃይ መሌዳ።<note caller="-" style="x"><char style="xo" closed="false">16:12 </char><char style="xt" closed="false"><ref loc="ISA 11:15">ኢሳ. 11:15</ref></char></note> <verse eid="REV 16:12"/><verse number="13" style="v" sid="REV 16:13"/>ሄዋፐ ጉይያን፥ ታን ሼያ ማላትያ ሄዙ ቱና አያናቱ ዳዊያ ዶናፐ፥ ዱኣ ዶናፐነ ዎርዱዋ ትምቢትያ ኦድያዋ ዶናፐ ከስሽን በኣድ። <verse eid="REV 16:13"/><verse number="14" style="v" sid="REV 16:14"/>ኡንቱንቱ ማላቱዋ ኦያ ጻላሀቱዋ አያናቱዋ። ሄ ሄዙ ኢታ አያናቱ ኡባፐ ዎልቃማ ጾሳ ዎልቃማ ጋላሳን፥ ሳኣ ካታቱዋ ኡባ ኦላዉ ሺሻናዉ ባና።<verse eid="REV 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 16:15"/>“በአ፥ ታን ካይሱዋዳን ያና። አሳ ስንን ካሎ ሀመቲደ ዬላተና ማላ፥ ገምእሸናን ባረ ማዩዋ ማዪደ ናግያ ኡራይ አንጀቴዳዋ!” ያጌዳ።<verse eid="REV 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16"/>ሄ ኢታ አያናቱ ካተቱዋ እብራይስጸ ቃላን አርማገዶና<note caller="+" style="f"><char style="fr" closed="false">16:16 </char><char style="fq" closed="false">አርማገዶና፦ </char><char style="ft" closed="false">ሀ ቃላዉ ኮይሮት ደእያ እብራይስጽያ መታይ፥ “ሀር-ማግዶ” ያግያዋ ግዲደ፥ “ሀር-ማግዶ” ግያዎ ደእያ ብለይ፥ “ሜግዶ-ዞዝያ” ያግያዋ። ሀዋ ጉሳይ በን ዎድያን አሳይ ጮራ ኦላ ኦለቴዳ ሳኣ ጉሳ።</char></note> ጌተትያ ሳኣ ሺሼድኖ።<note caller="-" style="x"><char style="xo" closed="false">16:16 </char><char style="xt" closed="false"><ref loc="2KI 23:29">2 ካታ. 23:29</ref>፤ <ref loc="ZEC 12:11">ዛካ. 12:11</ref></char></note><verse eid="REV 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17"/>ላፑን ኪታንቻይ ባረ ከርያን ደእያዋ ጫርኩዋን ጉስና፥ ጌሻ ጎልያን ደእያ አራታፐ፥ “ፖለቴዳ” ያግያ ዎልቃማ ኮሻይ ዬዳ። <verse eid="REV 16:17"/><verse number="18" style="v" sid="REV 16:18"/>ሄዋፐ ጉይያን፥ ዋልቃንይ ዎልቃሜዳ፤ ጉንይ ስሰቴዳ፤ ጉጉንይካ ጉሜዳ። ቃይ ቢታይ ፓላ ቃ ቃጼዳ። አሳይ ሳኣን መቶደፐካ ቢታይ ሄዋ ማላ ቃ ቃጽ ኤረና፤ ሄዌ ኡባፐ አዳ ቃ። <verse eid="REV 16:18"/><verse number="19" style="v" sid="REV 16:19"/>ዎልቃማ ካታማይ ሄዙ ከሲደ ዛኤዳ። ቢታ ኡባን ደእያ ካታማቱ ዬድኖ። ጾሳይ ዎልቃማ ባብሎኖ ቆፒደ፥ ባረ ኢታ ሀንቁዋ ዎይንያ ኤሳይ ኩሜዳ ቡርጩኩዋፐ ዎይንያ ኤሳ ባብሎኖ ኡሼዳ።<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="ISA 51:17">ኢሳ. 51:17</ref></char></note> <verse eid="REV 16:19"/><verse number="20" style="v" sid="REV 16:20"/>አባን ዶደቴዳ ቢታይ ኡባይ ዬዳ፤ ደሪካ ቤትቤና። <verse eid="REV 16:20"/><verse number="21" style="v" sid="REV 16:21"/>አሳ ቦላ ኦይታሙ ኪሎ ኬና ዴጽያ ዎልቃማ ሻቻይ ሳሉዋፐ ዎዳ። አሳይ ሄ ሻቻ ቦሻ ድራዉ፥ ጾሳ ቦሬዳ፤ አያዉ ጎፐ፥ ቦሻይ ዳሮ ዎልቃማ።<note caller="-" style="x"><char style="xo" closed="false">16:21 </char><char style="xt" closed="false"><ref loc="EXO 9:23">ከሳ 9:23</ref>፤ <ref loc="REV 11:19">ሳፃ 11:19</ref></char></note><verse eid="REV 16:21"/></para>
  <chapter eid="REV 16"/>
  <chapter number="17" style="c" sid="REV 17"/>
  <para style="s1">ባብሎነ ቦላ ያና ሙራ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1"/>ሄዋፐ ጉይያን፥ ላፑ ከረቱ ደእያ ላፑ ኪታንቻቱዋፐ እቱ ታኮ ዪደ፥ ታና ሀዋዳን ያጌዳ፤ “ሃያ፤ ዳሮ ሻፋቱዋ ጋጻን ደእያ ዎሹምያ፥ ዎልቃማ ካታማታ፥ ዋና ሙረታነንቶ፥ ታን ኔና በሳና። <verse eid="REV 17:1"/><verse number="2" style="v" sid="REV 17:2"/>ሳኣን ደእያ ካታቱ እዝና ዎሹሜድኖ፤ ሳኣን ደእያ አሳይካ እዝ ዎይንያ ኤሳ ኡሽ ማቲደ እዝና ዎሹሜዳ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">17:2 </char><char style="xt" closed="false"><ref loc="ISA 23:17">ኢሳ. 23:17</ref>፤ <ref loc="JER 51:7">ኤር. 51:7</ref></char></note><verse eid="REV 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3"/>ሄ ኪታንቻይ ታና አያናን ባዙዋ አፌዳ። ሄዋን ታን እት ምሽራቶ ቦርያ ሱንይ ቦላ ኡባን ጻፈት ኡቴዳ ዞኦ ዶኣ ቶጌዳዉኖ በኣድ፤ ሄ ዶአዉ ላፑ ሁጲያን ታሙ ካጪ ደኤ። <verse eid="REV 17:3"/><verse number="4" style="v" sid="REV 17:4"/>ሄ ምሽራታ ቴራ ኦቻ ማላትያ ማዩዋነ ዞኦ ማዩዋ ማያዱ፤ እዛ ቃይ ዎርቃን፥ ቦንቾ ሹቻንነ እንቁዋ ጌተትያ አልኦ ሹቻን አሌቃዱ። እዛ ዎሹምያ ቱናባይነ ሸነይያባይ ኩሜዳ ዎርቃ ቡርጩኩዋ ባረ ኩሽያን ኦይቃዱ።<note caller="-" style="x"><char style="xo" closed="false">17:4 </char><char style="xt" closed="false"><ref loc="JER 51:7">ኤር. 51:7</ref></char></note> <verse eid="REV 17:4"/><verse number="5" style="v" sid="REV 17:5"/>እዝ ዴሙዋን ጹራ የዉዋ ብለይ ደእያ ሱንይ፥</para>
  <para style="b" vid="REV 17:5"/>
  <para style="pc" vid="REV 17:5">“ዎልቃማ ባብሎኖ፤</para>
  <para style="pc" vid="REV 17:5">ሳኣን ደእያ</para>
  <para style="pc" vid="REV 17:5">ዎሹምያዋንቶነ</para>
  <para style="pc" vid="REV 17:5">ሳኣን ደእያ</para>
  <para style="pc" vid="REV 17:5">ሸነይያባዉ አቶ”</para>
  <para style="m" vid="REV 17:5">ያግያዌ ጻፈት ኡቴዳ።<verse eid="REV 17:5"/></para>
  <para style="b"/>
  <para style="m">
    <verse number="6" style="v" sid="REV 17:6"/>ቃይ ሄ ምሽራታ ጌሻቱዋ ሱነ የሱሳዉ ማርካትሽን ዎዳዋንቱ ሱ ኡሻደ ማቴዳዉኖ ታን በኣደ ማላለታድ።<verse eid="REV 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 17:7"/>ኪታንቻይ ታና፥ “ኔን አያዉ ሀዋዳን ማላለታዲ? ታን ነዉ ምሽራት ጹራ የዉዋነ እዛ ቶኬዳ ላፑ ሁጲያን ታሙ ካጪ ደእያ ዱኣ ጹራ የዉዋ ኦዳና። <verse eid="REV 17:7"/><verse number="8" style="v" sid="REV 17:8"/>ኔን በኤዳ ዶአይ ካሰ ደኤ፤ ሽን ሀእ ባዋ። ሄ ዶአይ ጪሞ ኦላፐ ኤለ ከሲደ፥ ባሻዉ ባናዋ። አላሚ መቶደፐ ዶሚደ፥ ደኡዋ ማጻፋን ኡንቱንቱ ሱንይ ጻፈትቤና ሳኣን ደእያ አሳይ ዶኣ በኢደ ማላለታና። አያዉ ጎፐ፥ እ ካሰ ደኤ፤ ሀእ ባዋ፤ ሽን ስንፐ ያናዋ።<note caller="-" style="x"><char style="xo" closed="false">17:8 </char><char style="xt" closed="false"><ref loc="DAN 7:7">ዳኔላ 7:7</ref>፤ <ref loc="REV 11:7">ሳፃ 11:7</ref>፤ <ref loc="PSA 69:28">ማዝ. 69:28</ref></char></note><verse eid="REV 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 17:9"/>“ሀዌ አዳ ኤራተነ አኬካ ኮዬ። ላፑ ሁጲ ምሽራታ ኡትያ ላፑ ደረቱዋ፤ ሄዋንቱ ቃይ ላፑ ካታቱዋ። <verse eid="REV 17:9"/><verse number="10" style="v" sid="REV 17:10"/>ኡንቱንቱፐ እቼሹ ካታቱ ኩንዴድኖ። እቱ ሀእ ጋካናስካ ሞዴ፤ የኮ ካቲ ይቤና። እ ዪደ፥ ጉ ዎድያ ታካናዉ በሴ። <verse eid="REV 17:10"/><verse number="11" style="v" sid="REV 17:11"/>ካሰ ደኤዳ ዶአይ፥ ሀእ ባይናዌ፥ እ ባረ ሁጰዉ ሆስፑን ዱኣ። እ ላፑ ዶአቱዋፐ እቱዋ፤ እ ያናዉ ቤ።<verse eid="REV 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12"/>“ኔን በኤዳ ታሙ ካጨቱ ሞዳናዉ ዶምቤና ታሙ ካተቱዋ። ሽን ኡንቱንቱ ዶኣና እትፐ እት ሳተዉ ካተቱዋዳን ሞዳናዉ ኡንቱንቶ ማታይ እመታና።<note caller="-" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="DAN 7:24">ዳኔላ 7:24</ref></char></note> <verse eid="REV 17:12"/><verse number="13" style="v" sid="REV 17:13"/>ኡንቱንቶ ኡባዉ እት ቆፋይ ደኤ፤ ኡንቱንቱ ባረንቱ ዎልቃነ ባረንቱ ማታ ዶአዉ እማና። <verse eid="REV 17:13"/><verse number="14" style="v" sid="REV 17:14"/>ኡንቱንቱ ዶርሳና ኦለታና፤ ሽን ዶርሳይነ ዶርሳና ደእያዋንቱ፥ እ ጼጌዳዋንቱነ ዶሬዳዋንቱ፥ አ ካልያ አማነቴዳዋንቱ፥ ሄ ካተቱዋ ጾናና፤ አያዉ ጎፐ፥ እ ጎዳቱዋ ጎዳነ ካተቱዋ ካትያ” ያጌዳ።<verse eid="REV 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15"/>ኪታንቻይ ቃይካ ታና ሀዋዳን ያጌዳ፤ “ጫራታ ኡቴዳ ሄ ኔን በኤዳ ሃይ ያራቱዋ፥ ጮራ አሳ፥ አሳ ዛራቱዋነ ዱማ ዱማ ቢታ ቃላ። <verse eid="REV 17:15"/><verse number="16" style="v" sid="REV 17:16"/>ቃይ ኔን በኤዳ ታሙ ካጪነ ዶአይ ዎሹመዉኖ እጻናዋንታ። ኡንቱንቱ እዝዉ ደእያ ኡባባ አክ ድጋና። ቃይ እዞ ካሎ አሻናነ እዝ አሹዋ ም ድጋና፤ ያቲደ ኡንቱንቱ እዞ ታማን ጉዳና። <verse eid="REV 17:16"/><verse number="17" style="v" sid="REV 17:17"/>አያዉ ጎፐ፥ ጾሳ ቃላይ ቱማታና ጋካናዉ፥ ኡንቱንቱ ቆፋይ እቱዋ ግዳናዳን፥ ኡንቱንቱ ባረንቱ ሞድያ ዎልቃ ዶአዉ እማናዳንነ ጾሳይ ቆፔዳዋ ኡንቱንቱ ኦናዳን፥ ኡንቱንቱ ዎዛናን ጾሳይ አሙዋ ዎዳ።<verse eid="REV 17:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 17:18"/>“ሄ ኔን በኤዳ ምሽራታ ሳኣ ካተቱዋ ሞድያ ዎልቃማ ካታማቶ” ያጌዳ።<verse eid="REV 17:18"/></para>
  <chapter eid="REV 17"/>
  <chapter number="18" style="c" sid="REV 18"/>
  <para style="s1">ባብሎን ኩንደ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1"/>ሄዋፐ ጉይያን፥ ዎልቃማ ማታይ ደእያ ሀራ ኪታንቻይ ሳሉዋፐ ዎሽን፥ ታን በኣድ። ሄ ኪታንቻ ቦንቹ ሳኣ ፖእሴዳ።<verse eid="REV 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 18:2"/>ሄ ኪታንቻይ ባረ ኮሻ ቁ ኦደ፥</para>
  <para style="q1" vid="REV 18:2">“እዛ ኩንዳዱ!</para>
  <para style="q2" vid="REV 18:2">ዎልቃማ ባብሎና ኩንዳዱ!</para>
  <para style="q1" vid="REV 18:2">ባብሎና ጻላሀቱ አቅያሳ ግዳዱ፤</para>
  <para style="q2" vid="REV 18:2">ኢታ አያናቱ ኡባቱነ፥</para>
  <para style="q2" vid="REV 18:2">እጸትያ ኢታ ካፋቱ ኡባቱ ኢን ደኢኖ።<note caller="-" style="x"><char style="xo" closed="false">18:2 </char><char style="xt" closed="false"><ref loc="ISA 13:21">ኢሳ. 13:21</ref>፤ <ref loc="ISA 21:9">21:9</ref>፤ <ref loc="JER 50:39">ኤር. 50:39</ref>፤ <ref loc="JER 51:8">51:8</ref>፤ <ref loc="REV 14:8">ሳፃ 14:8</ref></char></note><verse eid="REV 18:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="REV 18:3"/>አያዉ ጎፐ፥ አሳ ዛርያ ኡባ፥</para>
  <para style="q2" vid="REV 18:3">ባረ ማይያ ዎይንያ ኤሳ ኡሽና፥</para>
  <para style="q2" vid="REV 18:3">እዝና ዎሹሜድኖ።</para>
  <para style="q2" vid="REV 18:3">ቃይካ ሳኣ ካታቱ፥</para>
  <para style="q2" vid="REV 18:3">እዝና ዎሹሜድኖ።</para>
  <para style="q2" vid="REV 18:3">እዝ እሻሎ ዎልቃ ጋሱዋን፥</para>
  <para style="q2" vid="REV 18:3">ሳኣን ደእያ ዛልአንቻቱ ዱረቴድኖ”</para>
  <para style="m" vid="REV 18:3">ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">18:3 </char><char style="xt" closed="false"><ref loc="ISA 23:17">ኢሳ. 23:17</ref>፤ <ref loc="JER 51:7">ኤር. 51:7</ref></char></note><verse eid="REV 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 18:4"/>ሄዋፐ ጉይያን፥</para>
  <para style="q2" vid="REV 18:4">ታን ሳሉዋፐ፥</para>
  <para style="q2" vid="REV 18:4">ሀዋዳን ያግያ ሀራ ኮሻ ስሳድ፤</para>
  <para style="q2" vid="REV 18:4">“ታ አሳዉ፥ ኢፐ ከስተ!</para>
  <para style="q1" vid="REV 18:4">እዝ ናጋራ እዝና ኮጾፕተ!</para>
  <para style="q2" vid="REV 18:4">እዝ ሙራ ግሸቶፕተ።<verse eid="REV 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5"/>አያዉ ጎፐ፥ እዝ ናጋራይ፥</para>
  <para style="q2" vid="REV 18:5">ሳሉዋ ጋካናዉ ዶረት ኡቴዳ።</para>
  <para style="q1" vid="REV 18:5">ጾሳይ እዝ ኢታ ባይዙዋ፥ ሀሳዬዳ።<note caller="-" style="x"><char style="xo" closed="false">18:5 </char><char style="xt" closed="false"><ref loc="GEN 18:20-21">ዶመ 18:20-21</ref>፤ <ref loc="JER 51:9">ኤር. 51:9</ref></char></note><verse eid="REV 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6"/>እዛ እሜዳዋ ኬና ዛሪደ፥</para>
  <para style="q2" vid="REV 18:6">እዝዉ እምተ። እዛ ኦዳዎ፥</para>
  <para style="q2" vid="REV 18:6">ላኡ ኩሽያ እዝዉ ቃንጽተ።</para>
  <para style="q2" vid="REV 18:6">እዛ ህንተንቶ ጊግሴዳ ኡሻፐ፥</para>
  <para style="q2" vid="REV 18:6">ላኡ ኩሽያ ኡሻ፥</para>
  <para style="q2" vid="REV 18:6">እዝ ቡርጩኩዋ ኩንተ።<note caller="-" style="x"><char style="xo" closed="false">18:6 </char><char style="xt" closed="false"><ref loc="PSA 137:8">ማዝ. 137:8</ref>፤ <ref loc="JER 50:29">ኤር. 50:29</ref></char></note><verse eid="REV 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 18:7"/>እዛ ቦንቼቴዳዋነ፥</para>
  <para style="q2" vid="REV 18:7">እሻሌዳዋ ኬና፥</para>
  <para style="q2" vid="REV 18:7">እዞ ቱጋይተነ ካዮይተ።</para>
  <para style="q2" vid="REV 18:7">እዛ ባረ ዎዛናን፥</para>
  <para style="q1" vid="REV 18:7">‘ታን ካታቲዳን ኡታይ፤</para>
  <para style="q2" vid="REV 18:7">ታን አስናይ ባይና ማጫዉኖ ግድከ፤</para>
  <para style="q2" vid="REV 18:7">ቃይ ኡባካ ካዮትከ’ ያጋዉ።<note caller="-" style="x"><char style="xo" closed="false">18:7 </char><char style="xt" closed="false"><ref loc="ISA 47:7-9">ኢሳ. 47:7-9</ref></char></note><verse eid="REV 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8"/>ሄዋ ድራዉ፥ እዝ ቦሻ ኡባይ፥</para>
  <para style="q2" vid="REV 18:8">ሀርጊ፥ ካዩነ ኮሻይ፥</para>
  <para style="q2" vid="REV 18:8">እዞ እት ጋላስ ኦይቃና።</para>
  <para style="q2" vid="REV 18:8">ቃይ እዛ ታማን ጉደታና፤</para>
  <para style="q2" vid="REV 18:8">አያዉ ጎፐ፥</para>
  <para style="q2" vid="REV 18:8">እዝ ቦላ ፕርድያ ጎዳ ጾሳይ፥ ዎልቃማ”</para>
  <para style="m" vid="REV 18:8">ያጌዳ።<verse eid="REV 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9"/>ሳኣ ካታቱ፥ እዝና ዎሹሚደ እሻሌዳዋንቱ ሄ ካታማታ ጉደትና፥ ከስያ ጩዋ በኤዳ ዎደ፥ ካታማትዉ ኡንቱንቱ ዋሳናነ ዬካና።<note caller="-" style="x"><char style="xo" closed="false">18:9-10 </char><char style="xt" closed="false"><ref loc="EZK 26:16-17">ህዝ. 26:16-17</ref></char></note> <verse eid="REV 18:9"/><verse number="10" style="v" sid="REV 18:10"/>ኡንቱንቱ ሄ ካታማት ኡጋዉ ያዬዳ ድራዉ፥ ሃክ ኤቂደ፥ “ሀ ዎልቃማ ካታማቴ! ዎልቃማ ካታማቴ! ባብሎኔ፥ ነዉ አዬሮ! ኔን አይ ማላ ቱጋታኒሻ። ኔን እት ሳትያ ግዶን ነ ፕርዳ አካዳ” ያጋና።<verse eid="REV 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11"/>ኡንቱንቱ ማርካብያ ጫና ሀዋፐ ስንናዉ ሻምያባይ ባይና ድራዉ፥ ሳኣን ደእያ ዛልአንቻቱ ሄ ካታማትዉ ዋሳናነ ካዮታና።<note caller="-" style="x"><char style="xo" closed="false">18:11 </char><char style="xt" closed="false"><ref loc="EZK 27:31">ህዝ. 27:31</ref>፣ <ref loc="EZK 27:36">36</ref></char></note> <verse eid="REV 18:11"/><verse number="12" style="v" sid="REV 18:12"/>ኡንቱንቱ ዎርቃ፥ ብራ፥ ቦንቾ ሹቻ፥ እንቁዋ ጌተትያ አልኦ ሹቻ፥ ቴራ ኦቻ ማላትያ ማዩዋ፥ ሱፍያ ማላ ማዩዋ፥ ሀርያ ጌተትያ ማዩዋ፥ ዞኦ ማዩዋ፥ ኡባ ቆሞ ሳዊያ ም፥ ኡባ ቆሙዋን ኦዳ ዳንጋርሳ አቻ፥ አልኦ ምፐ መቴዳባ፥ ናሃስያ፥ ብራታ፥ እብነበረድያ ጌተትያ ሹቻ፥<note caller="-" style="x"><char style="xo" closed="false">18:12-13 </char><char style="xt" closed="false"><ref loc="EZK 27:12">ህዝ. 27:12</ref>፣ <ref loc="EZK 27:13">13</ref>፣ <ref loc="EZK 27:22">22</ref></char></note> <verse eid="REV 18:12"/><verse number="13" style="v" sid="REV 18:13"/>ቃራፋ፥ ቅማምያ፥ እጻና፥ ሽቱዋ፥ ሳዊያ እጻና ልያ፥ ዎይንያ ኤሳ፥ ዎጋራ ዛይትያ፥ ሊቄዳ ልያ፥ ዛርጋ፥ ሚዛ፥ ዶርሳ፥ ፓራነ ፓራይ ጎችያ ጋርያ፥ ኡንቱንቱ አይለቱዋነ ሀራይ አቶ አሳ ሸምፑነ ሻምያባይካ ባዋ።<verse eid="REV 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="REV 18:14"/>ዛልአንቻቱ ምሽራትዉ፥</para>
  <para style="q2" vid="REV 18:14">“ኔን አሞቴዳ፥</para>
  <para style="q2" vid="REV 18:14">ሎኦባይ ኡባይ ኔፐ ሀል ድጌዳ።</para>
  <para style="q2" vid="REV 18:14">ነ ደኡነ፥</para>
  <para style="q2" vid="REV 18:14">አሌቀትያባይ ኡባይ ይድጌዳ።</para>
  <para style="q2" vid="REV 18:14">ኔን ላኤን ኡንቱንታ ኡባካ ደማካ”</para>
  <para style="m" vid="REV 18:14">ያጌድኖ።<verse eid="REV 18:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 18:15"/>ሄ ካታማትን ዛልኢደ ዱረቴዳ ዛልአንቻቱ እዝ ኡጋዉ ያዪደ፥ ኢፐ ሃኪደ ኤቃና። ኡንቱንቱ ዬካናነ ካዮታና።<note caller="-" style="x"><char style="xo" closed="false">18:15 </char><char style="xt" closed="false"><ref loc="EZK 27:31">ህዝ. 27:31</ref>፣ <ref loc="EZK 27:36">36</ref></char></note> <verse eid="REV 18:15"/><verse number="16" style="v" sid="REV 18:16"/>ቃይ፥</para>
  <para style="q1" vid="REV 18:16">“ሱፍያ ጌተትያ፥</para>
  <para style="q2" vid="REV 18:16">ክርያን ዳደቴዳ ማዩዋ፥</para>
  <para style="q2" vid="REV 18:16">ቴራ ኦቻ ማላትያ፥</para>
  <para style="q2" vid="REV 18:16">ማዩዋነ ዞኦ ማዩዋ ማያደ፥</para>
  <para style="q2" vid="REV 18:16">ዎርቃ አሌቁዋን፥</para>
  <para style="q2" vid="REV 18:16">ቦንቾ ሹቻንነ፥</para>
  <para style="q2" vid="REV 18:16">እንቁዋ ጌተትያ አልኦ ሹቻን አሌቄዳ፥</para>
  <para style="q2" vid="REV 18:16">ሄ ዎልቃማ ካታማትዉ አዬሮ!<verse eid="REV 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 18:17"/>ሀዋ ኬና ዎልቃማ ማጹ ኡባይ፥</para>
  <para style="q2" vid="REV 18:17">እት ሳትያ ግዶን፥ ድፕ ግ ይ አጌዳ”</para>
  <para style="m" vid="REV 18:17">ያጌድኖ።</para>
  <para style="p" vid="REV 18:17">ማርካብያ ላግያ ኡባቱ፥ ማርካብያን ብያ ኡባቱ፥ ማርካብያን ኦያ ኡባቱነ አባን ኦ ጎኤትያ ኡባቱ ሃክ ኤቄድኖ።<note caller="-" style="x"><char style="xo" closed="false">18:17 </char><char style="xt" closed="false"><ref loc="ISA 23:14">ኢሳ. 23:14</ref>፤ <ref loc="EZK 27:26-30">ህዝ. 27:26-30</ref></char></note> <verse eid="REV 18:17"/><verse number="18" style="v" sid="REV 18:18"/>ሄ ካታማታ ጉደትና ከስያ ጩዋ በኤዳ ዎደ ባረንቱ ኮሻ ቁ ኦደ፥ “ሀ ዎልቃማ ካታማቶ ማላትያ ካታማይ ኡባካ ባዋ” ያጌድኖ።<note caller="-" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="EZK 27:32">ህዝ. 27:32</ref></char></note><verse eid="REV 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 18:19"/>ኡንቱንቱ ባረንቱ ሁጲያን ባና ቆሊደ፥ ዋሴድኖነ ካዮቴድኖ፤</para>
  <para style="q1" vid="REV 18:19">“አባን ማርካባቱ ደእያ ኡባ፥</para>
  <para style="q2" vid="REV 18:19">ባረ ማቁዋን ዱረዬዳ፥</para>
  <para style="q2" vid="REV 18:19">ዎልቃማ ካታማትዉ አዬሮ!</para>
  <para style="q2" vid="REV 18:19">ቃይ እዝዉ ደእያባይ ኡባይ</para>
  <para style="q2" vid="REV 18:19">እት ሳትያ ግዶን ይ አጌዳ።<note caller="-" style="x"><char style="xo" closed="false">18:19 </char><char style="xt" closed="false"><ref loc="EZK 27:30-34">ህዝ. 27:30-34</ref></char></note><verse eid="REV 18:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="REV 18:20"/>ሄ ካታማታ ዬዳ ድራዉ፥</para>
  <para style="q2" vid="REV 18:20">ሳሎ፥ ናሸታ!</para>
  <para style="q1" vid="REV 18:20">ጌሻቶ፥ የሱስ ኪቴዳዋንቶ፥</para>
  <para style="q2" vid="REV 18:20">ናባቶ፥ ናሸትተ!</para>
  <para style="q2" vid="REV 18:20">አያዉ ጎፐ፥</para>
  <para style="q2" vid="REV 18:20">እዛ ህንተንታ ኦዳዋ ድራዉ፥</para>
  <para style="q2" vid="REV 18:20">ጾሳይ እዞ ፕርዴዳ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">18:20 </char><char style="xt" closed="false"><ref loc="DEU 32:43">ዛረ. 32:43</ref>፤ <ref loc="JER 51:48">ኤር. 51:48</ref></char></note><verse eid="REV 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="REV 18:21"/>ሄዋፐ ጉይያን፥</para>
  <para style="q2" vid="REV 18:21">ዎልቃማ ኪታንቻይ፥</para>
  <para style="q2" vid="REV 18:21">ዎጻ ማላትያ ዎልቃማ ሹቻ፥</para>
  <para style="q2" vid="REV 18:21">ደን አባን ኦሊደ ሀዋዳን ያጌዳ፤</para>
  <para style="q1" vid="REV 18:21">“ዎልቃማ ካታማታ፥</para>
  <para style="q2" vid="REV 18:21">ባብሎና፥ ሱግና ሀዋዳን ኩንዳና፤</para>
  <para style="q2" vid="REV 18:21">እዛ ሀቼፐ ስንዉ፥ ኡባካ ቤቱኩ።<note caller="-" style="x"><char style="xo" closed="false">18:21 </char><char style="xt" closed="false"><ref loc="JER 51:63-64">ኤር. 51:63-64</ref>፤ <ref loc="EZK 26:21">ህዝ. 26:21</ref></char></note><verse eid="REV 18:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="REV 18:22"/>ዲ ዲጽያዋንቱነ፥</para>
  <para style="q2" vid="REV 18:22">ማዝሙርያ የጽያዋንቱ፥</para>
  <para style="q2" vid="REV 18:22">ሱሱልያነ ማላካታ ፑንያዋንቱ፥</para>
  <para style="q2" vid="REV 18:22">ኮሻይ ሀዋፐ ህን ባጋን፥</para>
  <para style="q2" vid="REV 18:22">ነ ግዶን ኡባካ ስሰተና።</para>
  <para style="q1" vid="REV 18:22">ኩሽያ ሂላ ኤርያ ኦንነ፥</para>
  <para style="q2" vid="REV 18:22">ላኤን ኡባካ ደኤና።</para>
  <para style="q1" vid="REV 18:22">ዎጻ ኮሻይካ</para>
  <para style="q2" vid="REV 18:22">ሀዋፐ ስንዉ ነ ግዶን ስሰተና።<note caller="-" style="x"><char style="xo" closed="false">18:22 </char><char style="xt" closed="false"><ref loc="EZK 26:13">ህዝ. 26:13</ref>፤ <ref loc="ISA 24:8">ኢሳ. 24:8</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">18:22-23 </char><char style="xt" closed="false"><ref loc="JER 7:34">ኤር. 7:34</ref>፤ <ref loc="JER 25:10">25:10</ref></char></note><verse eid="REV 18:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="REV 18:23"/>ጾምፕያ ፖኡካ ላኤንዋ ነ ግዶን ፖኤና።</para>
  <para style="q2" vid="REV 18:23">አክያዋ ኮሻይነ ገለዉን ኮሻይ፥</para>
  <para style="q2" vid="REV 18:23">ስንዉ ነ ግዶን ስሰተና።</para>
  <para style="q2" vid="REV 18:23">ነ ዛልአንቻቱ ሳኣ ኡባን፥</para>
  <para style="q2" vid="REV 18:23">ኤረቴዳ ዎልቃማቱዋ።</para>
  <para style="q2" vid="REV 18:23">ነ ብትያዋን አሳ ዛርያ ኡባይ ጭመቴዳ።<verse eid="REV 18:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="REV 18:24"/>ናባቱዋ ሱይ፥</para>
  <para style="q2" vid="REV 18:24">ጌሻቱዋ ሱይነ፥</para>
  <para style="q2" vid="REV 18:24">ሳኣን ሀይቄዳ ኡባቱዋ ሱይ፥</para>
  <para style="q2" vid="REV 18:24">እዝን ቤቴዳ ድራዉ፥</para>
  <para style="q1" vid="REV 18:24">ባብሎና፥ ሙረታዱ”</para>
  <para style="m" vid="REV 18:24">ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">18:24 </char><char style="xt" closed="false"><ref loc="JER 51:49">ኤር. 51:49</ref></char></note><verse eid="REV 18:24"/></para>
  <chapter eid="REV 18"/>
  <chapter number="19" style="c" sid="REV 19"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1"/>ሄዋፐ ጉይያን፥ ሳሉዋን ጮራ አሳ ኮሻዳን ኮሹምያ ዎልቃማ ኮሻይ ሀዋዳን ያግያዋ ታን ስሳድ፤</para>
  <para style="q1" vid="REV 19:1">“ጾሳ ጋላታይ ጋኮ።</para>
  <para style="q2" vid="REV 19:1">አቶተይ፥ ቦንቹነ ዎልቃይ፥</para>
  <para style="q2" vid="REV 19:1">ኑ ጾሳሳ።<verse eid="REV 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="REV 19:2"/>አ ፕርዳይ ቱሙዋነ ጽሉዋ።</para>
  <para style="q2" vid="REV 19:2">ጫራታደ ሳኣ ቱንሴዳ፥</para>
  <para style="q2" vid="REV 19:2">ዎልቃማ ጫራቶ ጾሳይ ፕርዴዳ፤</para>
  <para style="q2" vid="REV 19:2">ጾሳ ኦሳንቻቱዋ እዛ ዎዳ ድራዉ፥</para>
  <para style="q1" vid="REV 19:2">ጾሳይ እዞ ሙሬዳ”</para>
  <para style="m" vid="REV 19:2">ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">19:2 </char><char style="xt" closed="false"><ref loc="DEU 32:43">ዛረ. 32:43</ref>፤ <ref loc="2KI 9:7">2 ካታ. 9:7</ref></char></note><verse eid="REV 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="REV 19:3"/>አሳይ ላኤንዋ ባረ ኮሻ ቁ ኦደ፥</para>
  <para style="q2" vid="REV 19:3">“ጾሳ ጋላታይ ጋኮ።</para>
  <para style="q1" vid="REV 19:3">ሄ ካታማታ መ መናዉ ጩዋታና”</para>
  <para style="m" vid="REV 19:3">ያጌድኖ።<note caller="-" style="x"><char style="xo" closed="false">19:3 </char><char style="xt" closed="false"><ref loc="ISA 34:10">ኢሳ. 34:10</ref></char></note><verse eid="REV 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 19:4"/>ላታማነ ኦይዱ ጭማቱነ ሸምፑዋና ደእያ ኦይዱ መታቱ ካዉተ ኦይድያን ኡቴዳ ጾሳዉ ጉፋኒደ፥ “አመንእ። ጾሳ ጋላታይ ጋኮ” ያጊደ ጎይኔድኖ።<verse eid="REV 19:4"/></para>
  <para style="s1">ዶርሳ ቡላቻዉ ጼስያ ጼሳ</para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 19:5"/>ሄዋፐ ጉይያን፥</para>
  <para style="q2" vid="REV 19:5">“ጾሳ አይላቱ ኡባይ፥</para>
  <para style="q1" vid="REV 19:5">ጾሳዉ ያይያ ጉይ፥</para>
  <para style="q2" vid="REV 19:5">ዳሩ ኡባይ ኑ ጾሳ ጋላትተ”</para>
  <para style="m" vid="REV 19:5">ያግያ ኮሻይ ካዉተ ኦይድያፐ ከሴዳ።<note caller="-" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="PSA 115:13">ማዝ. 115:13</ref></char></note><verse eid="REV 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 19:6"/>ሄዋፐ ጉይያን፥ ጮራ አሳዳን ኮሹምያ፥ ዎልቃማ ሻፋዳን ጉምያ፥ ዎልቃማ ጉጉንዳን ጉጉምያ ኮሻ ታን ስሳድ። ሄ ኮሻይ፥</para>
  <para style="q1" vid="REV 19:6">“ጾሳ ጋላታይ ጋኮ።</para>
  <para style="q2" vid="REV 19:6">አያዉ ጎፐ፥ ኑ ጎዳይ፥</para>
  <para style="q1" vid="REV 19:6">ኡባፐ ዎልቃማ ጾሳይ ካዉቴዳ።<note caller="-" style="x"><char style="xo" closed="false">19:6 </char><char style="xt" closed="false"><ref loc="EZK 1:24">ህዝ. 1:24</ref>፤ <ref loc="PSA 93:1">ማዝ. 93:1</ref>፤ <ref loc="PSA 97:1">97:1</ref>፤ <ref loc="PSA 99:1">99:1</ref></char></note><verse eid="REV 19:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 19:7"/>ዶርሳ ቡላቻ ጋላሳይ ጋኬዳ ድራዉነ፥</para>
  <para style="q2" vid="REV 19:7">ገለዉናካ ቡላቻዉ ባረና ጊግሴዳ ድራዉ፥</para>
  <para style="q2" vid="REV 19:7">ኑን ፓሽኮይተነ ናሸቶይተ፤</para>
  <para style="q2" vid="REV 19:7">ቃይ ዶርሳ ቦንቾይተ።<verse eid="REV 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 19:8"/>ገለዉንዉ ማያናዉ፥</para>
  <para style="q2" vid="REV 19:8">ሱፍያ ጌተትያ ክርያን ዳደቴዳ፥</para>
  <para style="q2" vid="REV 19:8">ጶልያ ቦ ማዩ እመቴዳ።</para>
  <para style="q2" vid="REV 19:8">ሱፍያ ጌተትያ ክርያን ዳደቴዳ ማዩ፥</para>
  <para style="q2" vid="REV 19:8">ጌሻቱዋ ጽሎ ኦሱዋ”</para>
  <para style="m" vid="REV 19:8">ያግያዋ፥ ታን ስሳድ።<verse eid="REV 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9"/>ሄዋፐ ጉይያን፥ ኪታንቻይ ታና፥ “ ‘ዶርሳ ቡላቻዉ ጼሰቴዳዋንቱ አንጀቴዳዋንታ’ ያጋደ ጻፋ” ያጌዳ። ሄ ኪታንቻይ ቃይካ ታና፥ “ሀዌ ጾሳ ቱሙ ቃላ” ያጌዳ።<verse eid="REV 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10"/>ሄዋፐ ጉየ ታን አዉ ጎይናናዉ አ ገድያን ኩንዳድ። ሽን እ ታና፥ “ሄዋ ኦፓ። ታን ነ ማላነ የሱስ ኡንቱንቶ ቆንጭሴዳ ቱማተ ኦይቄዳ ነ እሻቱዋ ኡባ ማላ አይልያ። ጾሳዉ ጎይና። አያዉ ጎፐ፥ የሱስ ቆንጭሴዳ ቱማተይ ትምቢትያ ኦድያዎ ደንያዋ” ያጌዳ።<verse eid="REV 19:10"/></para>
  <para style="s1">ቦ ፓራ ቶጌዳዋ</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11"/>ያትና፥ ሳሉ ዶየቴዳዋ ታን በኣድ። ሄዋን ቦ ፓራይ ደኤ፤ ሄ ፓራ ቶጌዳዌ አማነትያዋነ ቱማንቻ ጊደ ጼሰቴ። ቶጌዳዌ ጽሎተን ፕርዴነ ባረ ኦላካ ኦለቴ።<note caller="-" style="x"><char style="xo" closed="false">19:11 </char><char style="xt" closed="false"><ref loc="EZK 1:1">ህዝ. 1:1</ref>፤ <ref loc="PSA 96:13">ማዝ. 96:13</ref>፤ <ref loc="ISA 11:4">ኢሳ. 11:4</ref></char></note> <verse eid="REV 19:11"/><verse number="12" style="v" sid="REV 19:12"/>አ አይፊ ታማ ላጩዋ ማላቴ፤ ቃይ እ ባረ ሁጲያን ዳሮ ካላቻ ዎዳ። አ ቦላ ጻፈት ኡቴዳ ሱንይ ደኤ፤ ሽን ሄ ሱንይ አየንቶነ አፐ አትን፥ ኦንነ ኤረና።<note caller="-" style="x"><char style="xo" closed="false">19:12 </char><char style="xt" closed="false"><ref loc="DAN 10:6">ዳኔላ 10:6</ref></char></note> <verse eid="REV 19:12"/><verse number="13" style="v" sid="REV 19:13"/>እ ማዬዳ ማዩ ሱን ናቂ ከሴዳዋ። አ ሱንይካ ጾሳ ቃላ። <verse eid="REV 19:13"/><verse number="14" style="v" sid="REV 19:14"/>ሳሉዋ ዎታዳራቱ ቦ ጌሻ ሱፍያ ጌተትያ ክርያን ዳደቴዳ ማዩዋ ማዪደ፥ ቦ ፓራቱዋ ቶጊደ፥ አ ጌዱዋ ካሊኖ። <verse eid="REV 19:14"/><verse number="15" style="v" sid="REV 19:15"/>አሳ ዘረ እ ይስያ ኩሳ ማሻይ አ ዶናፐ ከሴ። ብራታ ጻምኣን አሳ እ ሞዳና። ኡባፐ ዎልቃማ ጾሳይ ባረ ሀንቁዋ ዎይንያ ኤሳይ ጉምኤትያሳን፥ ጉምኢደ በሳና።<note caller="-" style="x"><char style="xo" closed="false">19:15 </char><char style="xt" closed="false"><ref loc="PSA 2:9">ማዝ. 2:9</ref>፤ <ref loc="ISA 63:3">ኢሳ. 63:3</ref>፤ <ref loc="JOL 3:13">ኢዩ. 3:13</ref>፤ <ref loc="REV 14:20">ሳፃ 14:20</ref></char></note> <verse eid="REV 19:15"/><verse number="16" style="v" sid="REV 19:16"/>አ ማዩዋ ቦላነ አ ዎድርያ ቦላ፥ “ካታቱዋ ካትያነ ጎዳቱዋ ጎዳ” ያግያ ሱንይ ጻፈት ኡቴዳ።<verse eid="REV 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17"/>ሄዋፐ ጉይያን፥ ታን እት ኪታንቻይ አዋን ኤቄዳዋ በኣድ። ሄ ኪታንቻይ ሳሉዋን ቂደ ፓልያ ካፉዋ ኡባቶ ባረ ኮሻ ቁ ኦደ፥ “ሃ ዪተ። ጾሳ ካዎ እትሳ ሺቅተ።<note caller="-" style="x"><char style="xo" closed="false">19:17-18 </char><char style="xt" closed="false"><ref loc="EZK 39:17-20">ህዝ. 39:17-20</ref></char></note> <verse eid="REV 19:17"/><verse number="18" style="v" sid="REV 19:18"/>ዪደ ካታቱዋ አሹዋ፥ ሻላቃቱዋ አሹዋካ ዎታዳራቱዋ አሹዋ ሚተ፤ ፓራቱዋ አሹዋካ ፓራቱዋ ቶጌዳዋንቱ አሹዋካ ሚተ፤ ቃይ አሳ ኡባ አሹዋ አይልያዋነ ዎማኑዋ፥ ቃዋነ ሆካዋ ሚተ” ያጌዳ።<verse eid="REV 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19"/>ፓራ ቶጌዳዋናነ አ ዎታዳራቱዋና ኦለታናዉ፥ ዶአይነ ሳኣ ካታቱ ቃይ ኡንቱንቱ ዎታዳራቱ እት ሳኣ ሺቅ ኡቴዳዋንታ ታን በኣድ። <verse eid="REV 19:19"/><verse number="20" style="v" sid="REV 19:20"/>ሄ ዶአይ አ ስንን ማላታ ኦዳ ዎርዶ ናብያና እትፐ ኦይቀቴዳ። ዶኣ ማላይ ደእያዋንታነ ዶኣ ምስለዉ ጎይኔዳዋንታ እ ባለዳዌ ሄ ኦያ ማላታቱዋና። ዶአይነ ዎርዱዋ ትምቢትያ ኦድያዌ ላአቱካ ዲንያን ኤጽያ ታማ አባን ፓጻ የገቴድኖ። <verse eid="REV 19:20"/><verse number="21" style="v" sid="REV 19:21"/>ኡንቱንቱ ዎታዳራቱ ፓራ ቶጌዳዋ ዶናፐ ከስያ ማሻን ሀይቄድኖ። ካፋቱ ኡባቱ ኡንቱንቱ አሹዋፐ ባረንቶ ዳንዳዬዳዋ ኬና ሜድኖ።<verse eid="REV 19:21"/></para>
  <chapter eid="REV 19"/>
  <chapter number="20" style="c" sid="REV 20"/>
  <para style="s1">ሻአ ላይ ካዉተ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1"/>ጪሞ ኦላ ቁልፕያነ ዎልቃማ ሳንላታ ባረ ኩሽያን ኦይቄዳ እት ኪታንቻይ ሳሉዋፐ ይያዋ ታን በኣድ። <verse eid="REV 20:1"/><verse number="2" style="v" sid="REV 20:2"/>ኪታንቻይ ዳዊያ፥ ሄ በን ሾሻ፥ ጻላህያ ካፑዋ ዎይ ሴጻና ግያዋ ኦይቄዳ፤ ያቲደ ሻአ ላይዉ ቃቼዳ።<note caller="-" style="x"><char style="xo" closed="false">20:2 </char><char style="xt" closed="false"><ref loc="GEN 3:1">ዶመ 3:1</ref></char></note> <verse eid="REV 20:2"/><verse number="3" style="v" sid="REV 20:3"/>ኪታንቻይ ጪሞ ኦላን አ የጊደ፥ ሻአ ላይይ ዉራናዉ፥ አሳ ዘረ ላኤንዋ ባለተና ማላ፥ ሄ ጪሞ ኦላ ቁልፕ ጎርዲደ አታሜዳ። ሄዋፐ ጉይያን፥ ዳዊ አማሬዳ ዎድያ ብለታናዉ በሴ።<verse eid="REV 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4"/>ሄዋፐ ጉይያን፥ ታን አራታቱዋነ ኡንቱንቱን ኡቴዳዋንታ በኣድ፤ ኡንቱንቶ ፕርድያ ማታይ እመቴዳ። የሱስ ቆንጭሴዳ ቱሙዋነ ጾሳ ቃላ አዋዬዳ ድራዉ፥ ባረንቱ ቆያ ቃንጸቴዳ አሳ ሸምፑዋካ ታን በኣድ። ኡንቱንቱ ዶአዉ ዎይ ዶኣ ምስለዉ ጎይንበይክኖ። ኡንቱንቱ ዶኣ ማላ ባረንቱ ዴሙዋን ዎይ ባረንቱ ኩሽያን ዎቤይክኖ። ኡንቱንቱ ሀይቁዋፐ ደንዲደ፥ ክርስቶሳና እትፐ ካተቱዋዳን ሻአ ላይዉ ሞዴድኖ።<note caller="-" style="x"><char style="xo" closed="false">20:4 </char><char style="xt" closed="false"><ref loc="DAN 7:9">ዳኔላ 7:9</ref>፣ <ref loc="DAN 7:22">22</ref></char></note> <verse eid="REV 20:4"/><verse number="5" style="v" sid="REV 20:5"/>ሀይቄዳዋንቱፐ ጮራቱ ሻአ ላይይ ዉራና ጋካናዉ፥ ሀይቁዋፐ ደንድበይክኖ። ሄዌ ኮይሮ ደንዱዋ። <verse eid="REV 20:5"/><verse number="6" style="v" sid="REV 20:6"/>ኮይሮ ደንዱዋን ደንዴዳዋንቱ አንጀቴዳዋንታነ ጾሳ አሳቱዋ። ኡንቱንቱ ቦላ ላኤን ሀይቆ ዎልቃይ ባዋ። ኡንቱንቱ ጾሳዉነ ክርስቶሳዉ ቄሳቱዋ ግዳና፤ ኡንቱንቱ አናና እትፐ ሻአ ላይዉ ሞዳና።<verse eid="REV 20:6"/></para>
  <para style="s1">ሴጻናይ ጾነቴዳ</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7"/>ሻአ ላይይ ዉሬዳዋፐ ጉይያን፥ ሴጻናይ ቃሹዋፐ ብለታና። <verse eid="REV 20:7"/><verse number="8" style="v" sid="REV 20:8"/>እ ሳኣን ኡባ ሳን ደእያ አሳ ዘረ ባለናዉ ከሳና፤ ሄዌ ጎጋነ ማጎጋ ጌተትያዋ። ሴጻናይ አባ ሻፍያ ኬና ዘረ ኦላዉ ሺሻና።<note caller="-" style="x"><char style="xo" closed="false">20:8 </char><char style="xt" closed="false"><ref loc="EZK 7:2">ህዝ. 7:2</ref>፤ <ref loc="EZK 38:2">38:2</ref>፣ <ref loc="EZK 38:9">9</ref>፣ <ref loc="EZK 38:15">15</ref></char></note> <verse eid="REV 20:8"/><verse number="9" style="v" sid="REV 20:9"/>ሄ ዛራቱ ቢታ ኡባ ማዪደ ጌሻቱዋ ሄራነ ጾሳይ ሲቅያ ካታማቶ ዩይ አ ኤቄድኖ። ሽን ታማይ ሳሉዋፐ ዎደ፥ ኡንቱንታ ሜዳ።<verse eid="REV 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 20:10"/>ዶአይነ ዎርዶ ናቢ የገቴዳ ኤጽያ ዲንያ ታማ አባን ጻላህያ ካፑ፥ አሳ ዘረ ባለዳዌ፥ የገቴዳ። ኡንቱንቱ ቃማነ ጋላስ መ መናዉ ፓጻ ካኤታና።<verse eid="REV 20:10"/></para>
  <para style="s1">ዉርሰ ፕርዳ</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11"/>ሄዋፐ ጉይያን፥ ታን ዎልቃማ ቦ አራታነ ሄ አራታን ኡቴዳዋ በኣድ። ሳአይነ ሳሉ አ ስንፐ ባቃቴድኖ፤ ላኤን ቤትበይክኖ።<note caller="-" style="x"><char style="xo" closed="false">20:11-12 </char><char style="xt" closed="false"><ref loc="DAN 7:9-10">ዳኔላ 7:9-10</ref></char></note> <verse eid="REV 20:11"/><verse number="12" style="v" sid="REV 20:12"/>ሀይቄዳዋንቱ፥ ቁ ግያዋንቱነ ጉቱ አራታ ስንን ኤቄዳዋንታ ታን በኣድ። ማጻፋቱ ዶየቴድኖ፤ ሀራ ማጻፋይ፥ ደኡዋ ማጻፋይካ ዶየቴዳ። ሀይቄዳዋንቱ ባረንቱ ኦሱዋዳን፥ ማጻፋቱዋን ጻፈት ኡቴዳዋዳንካ ፕርደቴድኖ። <verse eid="REV 20:12"/><verse number="13" style="v" sid="REV 20:13"/>አባይ ባረ ግዶን ደእያ ሀይቄዳዋንታ እሜዳ፤ ሀይቁነ ስኦሊ ባረንቱ ግዶን ደእያ ሀይቄዳዋንታ እሜድኖ። ኡባይካ ባረንቱ ኦሱዋዳን ፕርደቴድኖ። <verse eid="REV 20:13"/><verse number="14" style="v" sid="REV 20:14"/>ሄዋፐ ጉይያን፥ ሀዩነ ስኦሊ ታማ አባን የገቴድኖ። ሄ ታማ አባይ ላኤን ሀይቁዋ። <verse eid="REV 20:14"/><verse number="15" style="v" sid="REV 20:15"/>ደኡዋ ማጻፋን ባረ ሱንይ ጻፈትቤና አሳይ ኦንነ ታማ አባን የገቴዳ።<verse eid="REV 20:15"/></para>
  <chapter eid="REV 20"/>
  <chapter number="21" style="c" sid="REV 21"/>
  <para style="s1">ኦራ ሳሉዋነ ኦራ ሳኣ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1"/>ሄዋፐ ጉይያን፥ ታን ኦራ ሳሉዋነ ኦራ ሳኣ በኣድ። ኮይሮ ሳሉነ ኮይሮ ሳአይ ዬዳ። አባይካ ዬዳ።<note caller="-" style="x"><char style="xo" closed="false">21:1 </char><char style="xt" closed="false"><ref loc="ISA 65:17">ኢሳ. 65:17</ref>፤ <ref loc="ISA 66:22">66:22</ref>፤ <ref loc="2PE 3:13">2 ጰጽ. 3:13</ref></char></note> <verse eid="REV 21:1"/><verse number="2" style="v" sid="REV 21:2"/>ጌሻ ካታማታ ኦራ የሩሳላመ፥ ባረ አስናዉ ማያደ ጊጌዳ ገልያ ዎዶሮ ናቲዳን፥ ጊጋ ኡቴዳዉና ሳሉዋፐ ጾሳ ማታፐ ዱገ ዎዉኖ ታን በኣድ።<note caller="-" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="ISA 52:1">ኢሳ. 52:1</ref>፤ <ref loc="ISA 61:10">61:10</ref>፤ <ref loc="REV 3:12">ሳፃ 3:12</ref></char></note><verse eid="REV 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 21:3"/>ዎልቃማ ኮሻይ አራታፐ ሀዋዳን ያጊደ፥ ሃሳይሽን፥ ታን ስሳድ፤ “ጾሳ ጎሊ አሳና ደኤ፤ ጾሳይ አሳና እትፐ ደአና። ኡንቱንቱ አ አሳ ግዳና፤ ጾሳይ ባረ ሁጰዉ ኡንቱንቱና ደአና። እ ኡንቱንቱ ጾሳ ግዳና።<note caller="-" style="x"><char style="xo" closed="false">21:3 </char><char style="xt" closed="false"><ref loc="EZK 37:27">ህዝ. 37:27</ref>፤ <ref loc="LEV 26:11">ዎጋ 26:11</ref>፣ <ref loc="LEV 26:12">12</ref></char></note> <verse eid="REV 21:3"/><verse number="4" style="v" sid="REV 21:4"/>ጾሳይ ኡንቱንቱ አይፍያ አፎ ኡባ ቁጫና። ሀዋፐ ስንናዉ ሀይቁነ ካዩ ዎይ ዋሱነ ሳኩ ባዋ። አያዉ ጎፐ፥ ኤጫባይ ዬዳ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">21:4 </char><char style="xt" closed="false"><ref loc="ISA 25:8">ኢሳ. 25:8</ref>፤ <ref loc="ISA 35:10">35:10</ref>፤ <ref loc="ISA 65:19">65:19</ref></char></note><verse eid="REV 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5"/>አራታን ኡቴዳዌ፥ “ታን ኡባባ ኦራጽሳይ” ያጌዳ። ቃይካ ጉጂደ ታና፥ “ታን ሃሳይያዌ አማነትያዋነ ቱማ ግድያ ድራዉ ጻፋ” ያጌዳ። <verse eid="REV 21:5"/><verse number="6" style="v" sid="REV 21:6"/>ቃይካ ታና ሀዋዳን ያጌዳ፤ “ፖለቴዳ። ታን አልፋነ ኦሜጋ፤ ዶመነ ፖሉዋ። ሳመቴዳ ኦናነ ታን ደኡዋ ሃ ፑልቱዋፐ ጮ ኡሻና። <verse eid="REV 21:6"/><verse number="7" style="v" sid="REV 21:7"/>ጾንያ ኡራይ ኦንነ ሀዋ ኡባ ላታና። ታን አዉ ጾሳ ግዳና፤ እካ ታ ናኣ ግዳና።<note caller="-" style="x"><char style="xo" closed="false">21:7 </char><char style="xt" closed="false"><ref loc="2SA 7:14">2 ሳሜላ 7:14</ref>፤ <ref loc="PSA 89:26-27">ማዝ. 89:26-27</ref></char></note> <verse eid="REV 21:7"/><verse number="8" style="v" sid="REV 21:8"/>ሽን ያይያዋንቱ፥ አማነናዋንቱ፥ ቱናቱ፥ ሸምፑዋ ዎያዋንቱ፥ ዎሹምያዋንቱ፥ ብትያዋንቱ፥ ኤቃዉ ጎይንያዋንቱነ ዎርዶትያዋንቱ ኡባይ ደእያ ሳአይ ታማይነ ኤጽያ ዲኒ ኤጽያ አባ ግዳናዋ። ሄዌ ላኤን ሀይቁዋ” ያጌዳ።<verse eid="REV 21:8"/></para>
  <para style="s1">ኦራ የሩሳላሞ</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9"/>ላፑ ዉርሰ ቦሻቱ ኩሜዳ ላፑ ከረቱዋ ኦይቄዳ ላፑ ኪታንቻቱዋፐ እቱ ታኮ ዪደ ታና፥ “ሃያ። ታን ኔና ገለዉኖ ዶርሳ ማቻቶ በሳና” ያጌዳ። <verse eid="REV 21:9"/><verse number="10" style="v" sid="REV 21:10"/>ኪታንቻይ ታና ዳሮ ቃ ደርያ ሁጲያ አያናን ከሲደ ጌሻ ካታማታ፥ የሩሳላማ ሳሉዋፐ ጾሳ ማታፐ ዱገ ዎዉኖ ታና በሴዳ።<note caller="-" style="x"><char style="xo" closed="false">21:10 </char><char style="xt" closed="false"><ref loc="EZK 40:2">ህዝ. 40:2</ref></char></note> <verse eid="REV 21:10"/><verse number="11" style="v" sid="REV 21:11"/>ሄ ካታማታ ጾሳ ቦንቹዋን ፖአዉ። ሄ ካታማት ፖኡ ያስጲድያ ጌተትያ አልኦ ሹቻ ማላ፤ ብርሊያዳን ጶላዉ። <verse eid="REV 21:11"/><verse number="12" style="v" sid="REV 21:12"/>ሄ ካታማትዉ ታማነ ላኡ ፐንገቱነ ሄ ፐንገቱዋን ታማነ ላኡ ኪታንቻቱ ናግያ ዎልቃማ አዱሳ ድርሳይ ደኤ። ፐንገቱዋን ታማነ ላኡ እስራኤልያ ዛራቱዋ ሱንይ ጻፈት ኡቴዳ።<note caller="-" style="x"><char style="xo" closed="false">21:12-13 </char><char style="xt" closed="false"><ref loc="EZK 48:30-35">ህዝ. 48:30-35</ref></char></note> <verse eid="REV 21:12"/><verse number="13" style="v" sid="REV 21:13"/>አዋይ ዶልያ ባጋና ሄዙ ፐንገቱ ደኢኖ። ቃይ ህርክ ባጋና ሄዙ ፐንገቱነ ሁጲሳ ባጋና ሄዙ ፐንገቱ ደኢኖ። አዋይ ዉልያ ባጋናካ ሄዙ ፐንገቱ ደኢኖ። <verse eid="REV 21:13"/><verse number="14" style="v" sid="REV 21:14"/>ካታማት ድርሳይ ዶርሳይ ኪቴዳ ታማነ ላአቱዋ ሱንይ ጻፈቴዳ ታማነ ላኡ ሹቻቱዋ ቦላ ግምበቴዳ።<verse eid="REV 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 21:15"/>ታናና ሃሳዬዳ ኪታንቻዉ ካታማቶ፥ እዝ ፐንገቱዋነ እዝ ድርሳ ልክያ ዎርቃ ጋትማይ ደኤ።<note caller="-" style="x"><char style="xo" closed="false">21:15 </char><char style="xt" closed="false"><ref loc="EZK 40:3">ህዝ. 40:3</ref></char></note> <verse eid="REV 21:15"/><verse number="16" style="v" sid="REV 21:16"/>ካታማትዉ ኦይዱ ጋጻይ ደኤ፤ ካታማት ጌሳይነ ጎምፓይ እት ማላ። ኪታንቻይ ካታማቶ ባረ ጋትማን ልኬዳ። ካታማታ ላኡ ሻአነ ላኡ ጼቱ ኪሎ ሚትርያ ግዳዱ፤ ካታማት ጌሳይ፥ ጎምፓይነ ቃተይ እት ማላ። <verse eid="REV 21:16"/><verse number="17" style="v" sid="REV 21:17"/>ኪታንቻይ ቃይ ድርሳካ ልኬዳ። አሳ ኩሽያን እት ጼታነ ኦይታማነ ኦይዱ ዋ ግዴዳ። ሄዌ ኦንነ ልክያ ኦግያን ኪታንቻይ ልክናዳ።<verse eid="REV 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 21:18"/>ካታማት ድርሳይ ያስጲድያ ጌተትያ ሹቻን ድረቴዳ። ካታማታ ብርሊያዳን ጶልያ ጌሻ ዎርቃን መታዱ።<note caller="-" style="x"><char style="xo" closed="false">21:18-21 </char><char style="xt" closed="false"><ref loc="ISA 54:11-12">ኢሳ. 54:11-12</ref></char></note> <verse eid="REV 21:18"/><verse number="19" style="v" sid="REV 21:19"/>ካታማት ድርሳዉ ሂጸቴዳ ሹቻይ ቦንቼቴዳ ሹቻ ኡባን አሌቀቴዳ፤ ኮይሮ ሂጸቴዳ ሹቻይ ያስጲድያ፤ ላኤን ሳምፔርያ፤ ሄዘን ከልቀዶንያ፤ ኦይደን ባሉርያ፤ <verse eid="REV 21:19"/><verse number="20" style="v" sid="REV 21:20"/>እቼሸን ሳርዶንክሳ፤ ኡሱፑን ሳርድዮና፤ ላፑን ክርስትሎባ፤ ሆስፑን ብራል፤ ኡዱፑን ቶጳዝዮንያ፤ ታሙን ክርስጵራሲሳ፤ ታማነ እተን ያክንትያ፤ ታማነ ላኤን አመተስጽኖስያ።<verse eid="REV 21:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 21:21"/>ታማነ ላኡ ፐንገቱ ታማነ ላኡ እንቁዋ ጌተትያ አልኦ ሹቻ፤ እት እት ፐንጊ እት እንቁዋን ኦሰቴዳ። ካታማት ኦጊ ብርልያ ማላ ጌሻ ዎርቃ።<verse eid="REV 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22"/>ጎዳይ፥ ኡባፐ ዎልቃማ ጾሳይነ ዶርሳይ ካታማት ጌሻ ጎልያ ግድያ ድራዉ፥ ታን ሄ ካታማትን ጌሻ ጎልያ በአበይከ። <verse eid="REV 21:22"/><verse number="23" style="v" sid="REV 21:23"/>ካታማትዉ ፖእያ አዋይ ዎይ አገናይ ኮሸና። አያዉ ጎፐ፥ ጾሳ ቦንቹ ሄ ካታማትን ፖኤ፤ ዶርሳይካ ሄ ካታማትዉ ጾምፕያ።<note caller="-" style="x"><char style="xo" closed="false">21:23 </char><char style="xt" closed="false"><ref loc="ISA 60:19-20">ኢሳ. 60:19-20</ref></char></note> <verse eid="REV 21:23"/><verse number="24" style="v" sid="REV 21:24"/>አሳ ዘረይ ካታማት ፖኡዋን ሀመታና። ሳኣ ካታቱካ ባረንቱ ቦንቹዋ ሄ ካታማትኮ አሀና።<note caller="-" style="x"><char style="xo" closed="false">21:24 </char><char style="xt" closed="false"><ref loc="ISA 60:3">ኢሳ. 60:3</ref></char></note> <verse eid="REV 21:24"/><verse number="25" style="v" sid="REV 21:25"/>ካታማት ፐንገቱ ኡባ ጋላስካ ዶያ ደአና፤ ኡባካ ጎርደትክኖ። አያዉ ጎፐ፥ ሄዋን ቃማይ ባዋ። <verse eid="REV 21:25"/><verse number="26" style="v" sid="REV 21:26"/>አሳ ዘረ ግታተይነ ቦንቹ ሄ ካታማትኮ ሺቃና። <verse eid="REV 21:26"/><verse number="27" style="v" sid="REV 21:27"/>ሽን ቱናባይ ዎይ ካዉሻባ ኦያዌ፥ ዎይ ዎርዶትያዌ ኦንነ ሄ ካታማቶ ገለና። ቃይ ዶርሳ ደኡዋ ማጻፋን ሱንይ ጻፈቴዳዋንቱ ጻላላይ ሄ ካታማቶ ገላና።<note caller="-" style="x"><char style="xo" closed="false">21:27 </char><char style="xt" closed="false"><ref loc="ISA 52:1">ኢሳ. 52:1</ref>፤ <ref loc="EZK 44:9">ህዝ. 44:9</ref></char></note><verse eid="REV 21:27"/></para>
  <chapter eid="REV 21"/>
  <chapter number="22" style="c" sid="REV 22"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1"/>ሄዋፐ ጉይያን፥ ኪታንቻይ ታና ጾሳ ካዉተ ኦይድያፐነ ዶርሳ ካዉተ ኦይድያፐ ጎግያ ብርሊያዳን ጶልያ ደኡዋ ሃ ሻፋ በሴዳ።<note caller="-" style="x"><char style="xo" closed="false">22:1 </char><char style="xt" closed="false"><ref loc="EZK 47:1">ህዝ. 47:1</ref>፤ <ref loc="ZEC 14:8">ዛካ. 14:8</ref></char></note> <verse eid="REV 22:1"/><verse number="2" style="v" sid="REV 22:2"/>ሄ ሻፋይ ካታማ ኦግያ ግዱዋና ዱገ ጎጌ። ሻፋፐ ሄፍን ባጋናነ ሀፍን ባጋና አገናን እት ገደነ ላይን ታማነ ላኡ ገደ አይፍያ ደኡዋ ምይ ደኤ። ሄ ም ቦንቹ ደእያዌ፥ ዛርያ ኡባ ሀርግያፐ ፓናሳ።<note caller="-" style="x"><char style="xo" closed="false">22:2 </char><char style="xt" closed="false"><ref loc="GEN 2:9">ዶመ 2:9</ref>፤ <ref loc="EZK 47:12">ህዝ. 47:12</ref></char></note><verse eid="REV 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 22:3"/>ሄ ካታማን ጾሳ ሸቃይ አይነ ባዋ። ጾሳ ካዉተ ኦይዲነ ዶርሳ ካዉተ ኦይዲ ሄ ካታማን ደአና። ጾሳ ኦሳንቻቱ ጾሳዉ ጎይናና።<note caller="-" style="x"><char style="xo" closed="false">22:3 </char><char style="xt" closed="false"><ref loc="ZEC 14:11">ዛካ. 14:11</ref></char></note> <verse eid="REV 22:3"/><verse number="4" style="v" sid="REV 22:4"/>ኡንቱንቱ አ ዴሙዋ በአና፤ አ ሱንይ ኡንቱንቱ ዴሙዋን ጻፈታና። <verse eid="REV 22:4"/><verse number="5" style="v" sid="REV 22:5"/>ሄዋፐ ስንዉ ሀራ ቃማይ ባዋ። ኡንቱንቶ ጾምፕያ ዎይ አዋ ፖኡዋ ኮሸና፤ አያዉ ጎፐ፥ ጎዳይ ጾሳይ ኡንቱንቶ ጾምፕያ ግዳናዋ። ኡንቱንቱ መ መናዉ ካተታና።<note caller="-" style="x"><char style="xo" closed="false">22:5 </char><char style="xt" closed="false"><ref loc="ISA 60:19">ኢሳ. 60:19</ref>፤ <ref loc="DAN 7:18">ዳኔላ 7:18</ref></char></note><verse eid="REV 22:5"/></para>
  <para style="s1">የሱሳ ዩሳ</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6"/>ሄዋፐ ጉይያን፥ ኪታንቻይ ታና ሀዋዳን ያጌዳ፤ “ሀ ታን ሃሳይያዌ ቱሙዋነ አማነትያዋ። ናባቶ ባረ ጌሻ አያና እምያ ጎዳይ ጾሳይ፥ ማታን ሀናናዉ በስያዋ ባረ ኦሳንቻቱዋ በሳናዉ ባረ ኪታንቻ ኪቴዳ” ያጌዳ።<verse eid="REV 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7"/>የሱስ፥ “በአ! ታን ኤለካ ያና። ሀ ማጻፋን ደእያ ትምቢትያ ናግያዋንቱ አንጀቴዳዋንታ” ያጌዳ።<verse eid="REV 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8"/>ታን ዮሃንስ፥ ሀ ኡባባ ስሳድነ በኣድ። ታን ሀዋ ስሴዳ ዎደነ በኤዳ ዎደ፥ ሄዋ ታና በሴዳ ኪታንቻዉ ጎይናናዉ፥ አ ገድያን ኩንዳድ። <verse eid="REV 22:8"/><verse number="9" style="v" sid="REV 22:9"/>ሽን ኪታንቻይ ታና፥ “ሄዋ ኦፓ። ታን ኔናዳንነ ናበ ግዴዳ ነ እሻቱዋዳን፥ ቃይ ማጻፋን ደእያባዉ አዛዘትያ ኡባቱዋዳን አይልያ። ጾሳዉ ጎይና” ያጌዳ።<verse eid="REV 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 22:10"/>ሄዋፐ ጉይያን፥ ኪታንቻይ ታና፥ “ሀናና ጌዳ ሀ ማጻፋ ቃላ ማታፋን ጎርዶፓ። አያዉ ጎፐ፥ ሀ ኡባባይ ፖለትያ ዎዲ ማታቴዳ። <verse eid="REV 22:10"/><verse number="11" style="v" sid="REV 22:11"/>ኢታባ ኦያዌ ጉጂደካ ኢታባ ኦ፤ ቱናይ ጉጂደካ ቱኖ። ሎኦባ ኦያዌ ጉጂደካ ሎኦባ ኦ፤ ጌሻይነ ጉጂደካ ጌሻ ግዶ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">22:11 </char><char style="xt" closed="false"><ref loc="DAN 12:10">ዳኔላ 12:10</ref></char></note><verse eid="REV 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12"/>የሱስ፥ “በአ! ታን ኤለካ ያና። አሳ ኡባዉ አ ኦሱዋዳን እማናዉ፥ ታ ዎይታ አካ ያና።<note caller="-" style="x"><char style="xo" closed="false">22:12 </char><char style="xt" closed="false"><ref loc="ISA 40:10">ኢሳ. 40:10</ref>፤ <ref loc="ISA 62:11">62:11</ref>፤ <ref loc="PSA 28:4">ማዝ. 28:4</ref>፤ <ref loc="JER 17:10">ኤር. 17:10</ref></char></note> <verse eid="REV 22:12"/><verse number="13" style="v" sid="REV 22:13"/>ታን አልፋነ ኦሜጋ፤ ኮይሩዋነ ዉርሰ፤ ዶመነ ፖሉዋ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">22:13 </char><char style="xt" closed="false"><ref loc="REV 1:8">ሳፃ 1:8</ref>፣ <ref loc="REV 1:17">17</ref>፤ <ref loc="REV 2:8">2:8</ref>፤ <ref loc="ISA 44:6">ኢሳ. 44:6</ref>፤ <ref loc="ISA 48:12">48:12</ref></char></note><verse eid="REV 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 22:14"/>ባረንቱ ማዩዋ ጌሽ ሜጭያዋንቱ አንጀቴዳዋንታ። ደኡዋ ም አይፍያ ማናዉነ ካታማ ፐንግያና ገላናዉ ኡንቱንቶ ማታይ እመቴዳ።<note caller="-" style="x"><char style="xo" closed="false">22:14 </char><char style="xt" closed="false"><ref loc="GEN 2:9">ዶመ 2:9</ref>፤ <ref loc="GEN 3:22">3:22</ref></char></note> <verse eid="REV 22:14"/><verse number="15" style="v" sid="REV 22:15"/>ሽን ካናቱ፥ ብትያዋንቱ፥ ዎሹምያዋንቱ፥ ሸምፑዋ ዎያዋንቱ፥ ኤቃዉ ጎይንያዋንቱነ ባረንቱ ሃሳያንነ ባረንቱ ኪታን ዎርዶትያዋንቱ ካረና ደኢኖ።<verse eid="REV 22:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16"/>“ታን የሱስ፥ ሀ የዉዋ ህንተንቶ ዎሳ ጎለቱዋን ማርካታና ማላ፥ ታ ኪታንቻ ኪታድ። ታን ዳዊታ ጎልያ የለታ። ታን ፖእስያ ዎንታ ባካልያ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">22:16 </char><char style="xt" closed="false"><ref loc="ISA 11:1">ኢሳ. 11:1</ref>፣ <ref loc="ISA 11:10">10</ref></char></note><verse eid="REV 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17"/>ጌሻ አያናይነ ገለዉና፥ “ሃያ” ያጊኖ። ቃይ ሀዋ ስስያዌ ኦንነ፥ “ሃያ” ያጎ። ሳመቴዳ አሳይ ኦንነ ሃ ዮ። ደኡዋ ሃ ኮይያ አሳይ ኦንነ ጮ አኮ።<note caller="-" style="x"><char style="xo" closed="false">22:17 </char><char style="xt" closed="false"><ref loc="ISA 55:1">ኢሳ. 55:1</ref></char></note><verse eid="REV 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18"/>ታን ሀ ማጻፋን ጻፈቴዳ ሀናና ጌዳ ቃላ ስስያ ኦናነ ዞራይ። ኦንነ ሀ ቃላ ቦላ እትባ ጉጆፐ፥ ጾሳይ ሀ ማጻፋን ጻፈቴዳ ቦሻ አ ቦላ ጉጃና። <verse eid="REV 22:18"/><verse number="19" style="v" sid="REV 22:19"/>ኦንነ ማጻፋን ደእያ ትምቢትያ ቃላፐ አያነ ፓጭሶፐ፥ ሀ ማጻፋ ግዶን ቆንጭሴዳ ደኡዋ ም አይፍያፐነ ጌሻ ካታማፐ አ ጋክያ ግሹዋ ጾሳይ ፓጭሳና።<note caller="-" style="x"><char style="xo" closed="false">22:19 </char><char style="xt" closed="false"><ref loc="DEU 4:2">ዛረ. 4:2</ref>፤ <ref loc="DEU 12:32">12:32</ref></char></note><verse eid="REV 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20"/>ሀ ኡባባዉ ማርካትያዌ፥ “ቱማ! ታን ኤለካ ያና” ያጌ።</para>
  <para style="p" vid="REV 22:20">አመንእ። ጎዳ የሱሳ፥ ኔን ሃያ።<verse eid="REV 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21"/>ጎዳ የሱስ ክርስቶሳ አ ኬካተይ ህንተናና<note caller="+" style="f"><char style="fr" closed="false">22:21 </char><char style="fk" closed="false">ህንተናና፦ </char><char style="ft" closed="false">ጮራ ሀራ ብለቱዋን፥ ጾሳ አሳ ኡባና ያጌ።</char></note> ኡባና ግዶ። አመንእ።<verse eid="REV 22:21"/></para>
  <chapter eid="REV 22"/>
</usx>
