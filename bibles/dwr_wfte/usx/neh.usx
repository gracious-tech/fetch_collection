<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="NEH" style="id">- Dawuro Full Bible Ethiopic Version</book>
  <para style="h">ናህምያ</para>
  <para style="toc1">ናህምያ ማጻፋ</para>
  <para style="toc2">ናህምያ</para>
  <para style="toc3">ናህ.</para>
  <para style="mt1">ናህምያ ማጻፋ</para>
  <para style="imt">ገሉዋ</para>
  <para style="ip">“ናህምያ” ግያ ሱን ብለይ እብራዌዋን “ጾሳይ ምን” ግያዋ ግዶደ፥ ጾሳይ ባረ አሳ ባረ ህዶታ ቃላዳን ኦሞዱዋፐ ዛሪደ ምንያዋ በሴ። ናህምያ ማጻፋ ሄዙሳን ሻክ በአናዉ ዳንዳየቴ:</para>
  <para style="ili">1. ይሁዳ ቢታ አይሳና ማላ፥ ፓርሰ ካቲ ኪቴዳ ናህሚ ካለና፥ የሩሳላመ ድርሳ ግምቢ ኦራጼዳዋ ኦድያ ታርክያ። ሄዋፐካ ቃይ ናህሚ አሳ እትፐተነ አማኑዋ ዎጋ ኦራስጽሴዳዋ።</para>
  <para style="ili">2. ጾሳ ህግያ ማጻፋ እዝር ናባቤዳዋነ አሳይካ ባረ ናጋራ ፓጼዳዋ ኦድያ ግሹዋ።</para>
  <para style="ili">3. ናህሚ ይሁዳ ጋድያ ሞድያዋ ግዲደ ኦዳ ሀራ ሀራባቱዋ ኦድያ ግሹዋ።</para>
  <para style="ip">ሀ ማጻፋን ዳሪደ ቤትያ ታርኪ ናህሚ ጾሳ ሎይ አማኔዳዋነ እ ጾሳ ዎሴዳ ዎሳቱዋባ ኦድያ ታርክያ።</para>
  <para style="iot">ሸምፓቱዋ ኡባቶ እመቴዳ ቃን ቆፋቱዋ</para>
  <para style="io1">ናህሚ የሩሳላመ ስሙሳ <char style="ior"><ref loc="NEH 1:1-2:20">1:1—2:20</ref></char></para>
  <para style="io1">የሩሳላመ ድርሳ አሳይ ዛረ ግምቤዳ <char style="ior"><ref loc="NEH 3:1-7:73">3:1—7:73</ref></char></para>
  <para style="io1">ሙሴ ህጊ ዛረ ናባበቱሳነ ቃላ ጫቁዋ ኦራጽሱዋ <char style="ior"><ref loc="NEH 8:1-10:39">8:1—10:39</ref></char></para>
  <para style="io1">ናህሚ የሩሳላመን ኦዳ ላምያ <char style="ior"><ref loc="NEH 11:1-13:31">11:1—13:31</ref></char></para>
  <chapter number="1" style="c" sid="NEH 1"/>
  <para style="ms">ናህሚ የሩሳላመ ስሙሳ</para>
  <para style="mr">(<ref loc="NEH 1:1-2:20">1:1—2:20</ref>)</para>
  <para style="s1">ናህሚ የሩሳላመ ድራዉ ኡንኤት ዎሴዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 1:1"/>ሀካልያ ናኣ ናህምያ ቃላይ ሀዋ። አርጸክስስ ፓርሰ ቢታን ካዉቶደፐ ላታማን ላይን፥ ክስሌዋ ጌተትያ አግናን፥ ታን ናህሚ ዋና ካታማ ግዴዳ ሱሳን ደአይ። <verse eid="NEH 1:1"/><verse number="2" style="v" sid="NEH 1:2"/>ታ እሻቱዋፐ እቱ፥ ሀናና ጎሳይ ሀራ አሳቱዋና እትፐ ግዲደ፥ ይሁዳፐ ታኮ ዬዳ፤ ታን ኦሞዱዋ ብቤናዋንቱባነ የሩሳላመባ ኡንቱንታ ኦቻድ። <verse eid="NEH 1:2"/><verse number="3" style="v" sid="NEH 1:3"/>ኡንቱንቱ ዛሪደ፥ “ኦሞዱዋን ብቤናዋንቱነ ደኡዋን ደእያዋንቱ ዎልቃማ መቱዋንነ ዬላ ግዶን ደኢኖ። የሩሳላመ ግምቢያ ድርሳይ ኮለቴዳ፤ ቃይ ግምቢያ ድርሳ ፐንገቱካ ታማን ጹገቴድኖ” ያጌድኖ።<verse eid="NEH 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 1:4"/>ታን ሀዋ ኡባ ስሴዳ ዎደ ኡታደ ዬካድ። ዳሮ ጋላሳ ካዮታ ጾማደ፥ ሳሉዋ ጾሳ፥ ሀዋዳን ያጋደ ዎሳድ፤ <verse eid="NEH 1:4"/><verse number="5" style="v" sid="NEH 1:5"/>“መና ጎዳዉ፥ ሳሉዋ ጾሳዉ፥ ዎልቃማዉነ ቦንቼቴዳ ጾሳዉ፥ ዶስያዋንቶነ ነ አዛዙዋ ናግያዋንቶ ነ አገና ሲቁዋ ጫቁዋ ናግያ ጾሳዉ፥ <verse eid="NEH 1:5"/><verse number="6" style="v" sid="NEH 1:6"/>ታን ነ ቆማይ ቃይ ነ ቆማቱዋ ግዴዳ እስራኤልያ አሳ ድራዉ ቃማነ ጋላስ ኔና ዎስያ ዎሳ ነ ሀይይ ስሶ፤ ነ አይፊካ ዱገ ታኮ ጼሎ። ኑን እስራኤልያ አሳይ ኦዳ ናጋራ ኡባ ነዉ ፓጻይ፤ ቱሙካ ታንነ ታ ማይዛ አዎቱ ኔና ናቄዶ። <verse eid="NEH 1:6"/><verse number="7" style="v" sid="NEH 1:7"/>ኑን ነ ቦላን ሎይ ኢታ ናጋራ ኦዶ፤ ኔን ነ ቆማ ሙሴ ባጋና ኑ እሜዳ አዛዙዋ፥ ዎጋነ ህግያ ናግበይኮ። <verse eid="NEH 1:7"/><verse number="8" style="v" sid="NEH 1:8"/>ነ ቆማ ሙሴዉ ኔን ሀዋዳን ያጋደ ኦዴዳ ቃላ ሀያና ቆፓ፤ ‘ህንተኖ፥ እስራኤልያ አሳቶ፥ ህንተንቱ ታዉ አማነተናን እጾፐ፥ ታን ህንተንታ አይሁዳ ግደና ቢታቱዋን ላላና።<note caller="-" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="LEV 26:33">ዎጋ 26:33</ref></char></note> <verse eid="NEH 1:8"/><verse number="9" style="v" sid="NEH 1:9"/>ሽን ህንተንቱ ታኮ ስሚደ፥ ታ አዛዙዋ ናጎፐ፥ ህንተንቱ ሀራይ አቶ ሳኣ ጋጻ ጋካናዉ ላለትንቶካ፥ ታን ህንተንቱ ታዉ ጎይናና ማላ፥ ታን ታ ሱንዉ ዶሬዳ ሳአዉ ዛራደ ሺሻና’ ጌዳዋ ቆፓ።<note caller="-" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="DEU 30:1-5">ዛረ. 30:1-5</ref></char></note><verse eid="NEH 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 1:10"/>“ሀዋንቱ ኔን ነ ዎልቃማ ዎልቃንነ ነ ምኖ ቀስያን ዎዛ አኬዳ ነ ቆማቱዋነ ነ አሳቱዋ። <verse eid="NEH 1:10"/><verse number="11" style="v" sid="NEH 1:11"/>አቤት መታ ጎዳዉ፥ ታን ነ ቆማይ ዎስያ ዎሳነ ኔና ቦንቻናዉ ዶስያ፥ ነ ቆማቱዋ ዎሳ ነ ሀይይ ስሶ። ታን ነ ቆማይ ሀቼ ኦናዉ ኮዬዳባይ ታዉ ኡሸቻናዳን፥ ካትያ ዎዛና ሹግሳደ ታና ማዳ” ያጋድ።</para>
  <para style="p" vid="NEH 1:11">ታን ሄ ዎደ ካትያዉ ኤሳ ትግያዋ።<verse eid="NEH 1:11"/></para>
  <chapter eid="NEH 1"/>
  <chapter number="2" style="c" sid="NEH 2"/>
  <para style="s1">ናህሚነ አርጸክሲሰ የሩሳላመባ ሃሳዬድኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 2:1"/>አርጸክስስ ካተቴዳ ላታማን ላይን፥ ኒሳና ግያ አግናን፥ እት ጋላስ ካትያ ስንን ዎይንያ ኤሳይ ደእያዋ አካደ፥ ታን አዉ እማድ። ሄ ጋላሳፐ አትና፥ ካሰ ኡባካ ካትያ ስንን ካዮታ ኤርከ። <verse eid="NEH 2:1"/><verse number="2" style="v" sid="NEH 2:2"/>ሄዋ ድራዉ፥ ካቲ ታና፥ “ኔና ሳክያባይ ባዋ፤ ሽን ሀዋ ኬሻ አያዉ ካዮታዲ? ሀዌ ነ ዎዛና ካዮዬዳባይ እት አየንቶ ደእያዋ በሰ” ያጌዳ።</para>
  <para style="p" vid="NEH 2:2">ሄዋፐ ጉየ ታን ሎይ ያያ ዛራደ፥ <verse eid="NEH 2:2"/><verse number="3" style="v" sid="NEH 2:3"/>“ካቲ መናዉ ደኦ! ታ ማይዛ አዎቱ ሞገቴዳ ካታማይ ኮለቲደ ይና፥ ቃይ ሄ ካታማ ግምቢያ ድርሳ ፐንገቱካ ታማን ጹገትክችና፥ ታን አያዉ ካዮትክታ?” ያጋድ።<note caller="-" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="2KI 25:8-10">2 ካታ. 25:8-10</ref>፤ <ref loc="2CH 36:19">2 ኦዱዋ 36:19</ref>፤ <ref loc="JER 52:12-14">ኤር. 52:12-14</ref></char></note><verse eid="NEH 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 2:4"/>ካቲካ ዛሪደ፥ “ያትና፥ ሀእ ታን ነዉ አያ ኦናዳን ኮያይ?” ያጌዳ።</para>
  <para style="p" vid="NEH 2:4">ታን ሳሉዋ ጾሳ ዎሳ ስማደ፥ <verse eid="NEH 2:4"/><verse number="5" style="v" sid="NEH 2:5"/>ካትያ ሀዋዳን ያጋድ፤ “ካትያዉ፥ ታን ኔና ናሸችያዋ ግዶፐ፥ ቃይ ታ ኦችያዋ ኔን እማናዉ ዶሶፐ፥ ይሁዳ ቢታ፥ ታ ማይዛ አዎቱ ሞገቴዳ ካታማ ባደ፥ ሄ ካታማ ዛራደ ኬጻና ማላ፥ ታና የዳርኪ”።<verse eid="NEH 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 2:6"/>ሄ ዎደ፥ ካታታ ካትያ አርጸክሲሳ ኤለካ ኡት ደእሽን፥ ካቲ፥ “ነ ብያ ኦጊ ዎይሳ ዎድያ አካናዌ? ቃይ ኔን አዉደ ስማኒ?” ያጊደ ታና ኦቼዳ። ታንካ ታ ስማና ዎድያ አዉ ኦዳድ፤ ካቲ ናሸቲደ፥ ታና የዴዳ።<verse eid="NEH 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NEH 2:7"/>ቃይካ ካትያ ታን ሀዋዳን ያጋድ፤ “ካትያዉ፥ ኔና ናሸችያዋ ግዶፐ፥ ታን ይሁዳ ጋካናዉ፥ ሄ ቢታና አደ ባና ማላ፥ ኤፍራጺሳ ሻፋፐ አዋይ ዉልያ ባጋ ቢታ ሞድያዋንቶ ዳብዳቢ ጻፈቶ። <verse eid="NEH 2:7"/><verse number="8" style="v" sid="NEH 2:8"/>ቃይ ጌሻ ጎልያ ግምቢያ ድርሳ ፐንግያ ጊግሳናዉ፥ ካታማ ግምቢያ ድርሳ ድራናዉነ ታን ደእያ ጎልያ ኬጻናዉ ታዉ ም እማና ማላ፥ ካትያ ዎራ ናግያ አሳፋዉካ ዳብዳቢ ጻፈቶ” ያጋድ። ጾሳ ሎኦ ኩሺ ታናና ደእያ ድራዉ፥ ካቲ ታን ኦቼዳዋ ኡባ እሜዳ።<verse eid="NEH 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 2:9"/>ካቲ ታናና አማሬዳ ኦላ ጋዳዋቱዋነ ፓራ አሳቱዋ የዴዳ፤ ኡንቱንቱና እትፐ ኤፍራጺሳ ሻፋፐ አዋይ ዉልያ ባጋ ቢታ ባደ ጋካደ፥ ካቲ የዴዳ ዳብዳቢያ ሄ ጋድያ ሞድያዋንቶ እማድ። <verse eid="NEH 2:9"/><verse number="10" style="v" sid="NEH 2:10"/>ሽን ቤት-ሆሮና ጋደ አሳ ግዴዳ ሳንባላጽነ አሞና ጋድያ ካፑዋ ግዴዳ ጾቢ፥ “እስራኤልያ አሳዉ ሎኦባ ኦያ አሳይ ዬዳ” ግያዋ ስሴዳ ዎደ፥ ሎይ ሀንቀቴድኖ።<verse eid="NEH 2:10"/></para>
  <para style="s1">ናህሚ የሩሳላመ ግምቢያ ድርሳባ ጼሌዳ</para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 2:11"/>ታን የሩሳላመ ያደ ሄዙ ጋላሳ ያን ጋምኣድ። <verse eid="NEH 2:11"/><verse number="12" style="v" sid="NEH 2:12"/>ግዶ ሽን፥ የሩሳላመዉ ታን ኦናዳን ታ ጾሳይ ታ ዎዛናን ዎዳ ቆፋ ኦነ ኦዳበይከ። ሄዋፐ ጉይያን፥ ታናና ደእያ አሳፐ አማሬዳዋንታ አካደ፥ ቃማን ደንዳደ ባድ። ሄ ዎደ ታን ቶጌዳዋፐ ሀራ ቶጋ መሂ ኑዉ ባዋ። <verse eid="NEH 2:12"/><verse number="13" style="v" sid="NEH 2:13"/>ታን ብላህያን ደንዳደ፥ ዛንጋራ ግምቢያ ድርሳ ፐንግያና ከሳደ፥ ዳዊያ ፑልቱዋ ጌተትያ ሳኣና አደ፥ ፕቱዋ ኦልያ ግምቢያ ድርሳ ፐንግያ ጌተትያ ፐንግያ ጋካናዉ ባድ። ሄዋን ኮለቴዳ የሩሳላመ ግምቢያ ድርሳነ ቃይ ታማን ጹገቴዳ ግምቢያ ድርሳ ፐንገቱዋ አኬካደ ጼላድ። <verse eid="NEH 2:13"/><verse number="14" style="v" sid="NEH 2:14"/>ሄዋፐ ስማደ፥ ፑልቱዋ ግምቢያ ድርሳ ፐንግያኮነ ዳጋቴዳ ካትያ ሃይ ደእያ ሳኣ ባድ። ግዶ ሽን፥ ታን ቶጌዳ ቶጋ መሂ አያ ኦግያ ደማበይከ። <verse eid="NEH 2:14"/><verse number="15" style="v" sid="NEH 2:15"/>ሄዋ ድራዉ፥ ቃማን ሃይ ጎግያ ካካ ግዱዋና አ ግምቢያ ጼላድ። ሄዋፐ ጉይያን፥ ጉየ ስማደ ዛንጋራ ፐንግያና ካታማ ገላድ።<verse eid="NEH 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NEH 2:16"/>ሄዋን ደእያ ካፓቱዋፐ ኦንነ ታን ሀቃ ባድታንቶ፥ ዎይ ቃይ አያ ኦድታንቶነ ኤርቤና። አያዉ ጎፐ፥ ታን አይሁዳቶ፥ ቄሳቶ፥ ቦንቼቴዳ አሳቶ፥ ካፓቶነ ኪታ ኪተታናዉ ደእያ አሳፐ ኦነ ታ ቆፋ ብሮ ኦዳበይከ። <verse eid="NEH 2:16"/><verse number="17" style="v" sid="NEH 2:17"/>ሄዋፐ ጉይያን፥ ታን ኡንቱንቶ ሀዋዳን ያጋድ፤ “ኑን አይ ማላ መቱዋ ግዱዋን ደእንቶ በኢታ፤ አያዉ ጎፐ፥ የሩሳላመ ካታማይ ኮለቴዳ፤ ቃይ ግምቢያ ድርሳ ፐንገቱካ ታማን ጹገቴድኖ። ሽን ሀዋፐ ስንዉ ኑን ሀዋዳን ካዉሺደ ደኤናዳን፥ አነ ደንዲደ፥ የሩሳላመ ግምቢያ ድርሳ ዛረደ ግምቦይተ” ያጋድ። <verse eid="NEH 2:17"/><verse number="18" style="v" sid="NEH 2:18"/>ቃይ ታ ጾሳ ሎኦ ኩሺ ታናና ደእያዋነ ካቲ ታዉ ኦዴዳዋ ኡባ ኡንቱንቶ ኦዳድ።</para>
  <para style="p" vid="NEH 2:18">ኡንቱንቱካ፥ “አነ ደንዶይተነ ዛረደ ግምቦይተ” ያጌድኖ። ባረንቱ ኩሽያ ሎኦ ኦሶ ምንሴድኖ።<verse eid="NEH 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 2:19"/>ሽን ቤት-ሆሮና ጋድያ አሳ ግዴዳ ሳንባላጽ፥ አሞና ጋድያ ኦሳንቻ ግዴዳ ጾቢነ አራባ ጋድያ አሳ ግዴዳ ጌሼም ሀዋ ስሴዳ ዎደ፥ ኑ ቦላን ቅሊጪደ ሚጬድኖ። ቃይ፥ “ሀዌ ህንተንቱ ኦያባይ አዬ? ዎይ ቃይ ካትያ ቦላን ማካላናዉ ኮዪቴ?” ያጊደ ኦቼድኖ።<verse eid="NEH 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NEH 2:20"/>ታን ዛራደ፥ “ሳሉዋ ጾሳይ ኑዉ እንጀያና፤ ኑን አ ቆማቱ ግምቢያ ዶማና። ሽን የሩሳላመን ደእያባፐ ህንተንታ ጋክያ ግሹዋ ግድና፥ ማታ ግድና፥ ዎይ ህንተንቱ ዶገተናዳን ቆፍስያባይ ህንተንቶ ባዋ” ያጋድ።<verse eid="NEH 2:20"/></para>
  <chapter eid="NEH 2"/>
  <chapter number="3" style="c" sid="NEH 3"/>
  <para style="s1">የሩሳላመ ድርሳ አሳይ ዛረ ግምቤዳ</para>
  <para style="r">(<ref loc="NEH 3:1-7:73">3:1—7:73</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 3:1"/>ሄዋፐ ጉይያን፥ ቄሰ ኡባቱዋ ካፑ ኤልያሽብነ ሀራ ቄሳቱ ዶርሳ ፐንግያ ግምቢያ ድርሳ ዛረ ግምቢደ፥ ጾሳዉ ዱማዬድኖ፤ ሳንቃካ አድኖ። ኡንቱንቱ ጼቱ አዱሳ ማማነ ሀናንኤላ አዱሳ ማማ ጋካናዉ ግምቤዳ ግምቢያ ጾሳዉ ዱማዬድኖ።<verse eid="NEH 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="NEH 3:2"/>ኡንቱንቱ ጋጻን ደእያ ሳኣ እያርኮ አሳይ ግምቤዳ።</para>
  <para style="p" vid="NEH 3:2">ኡንቱንቱ ጋጻን ደእያ ሳኣ እምራ ናአይ ዛኩር ግምቤዳ።<verse eid="NEH 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 3:3"/>ሀስናአ ናናይ ሞልያ ፐንግያ ግምቢያ ድርሳ ግምቤድኖ። ኡንቱንቱ ፐንገ ም ኤሲደ፥ ሳንቃካ አድኖ፤ ቃይ ሳንቃዉ ጎርድያ ምነ ም ገልስያ ኩልቡዋ ጊግሴድኖ።<verse eid="NEH 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 3:4"/>ኡንቱንቱ ጋጻን ደእያ ሳኣ ሀቆጻ ናኣ ግዴዳ ኦርዮና ናአይ ማረሞት ግምቤዳ።</para>
  <para style="p" vid="NEH 3:4">አ ጋጻን ደእያ ሳኣ ማሸዛቤላ ናኣ በረክያ ናአይ ማሹላም ግምቤዳ።</para>
  <para style="p" vid="NEH 3:4">አ ጋጻን ደእያ ሳኣ ባኣና ናአይ ጻዶቀ ግምቤዳ።<verse eid="NEH 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NEH 3:5"/>አ ጋጻን ደእያ ሳኣ ታቆአ ካታማ አሳቱ ግምቤድኖ፤ ግዶ ሽን፥ ሄ ካታማ ካፓቱ ባረንቶ እመቴዳ ኪታ እጼድኖ።<verse eid="NEH 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 3:6"/>ፓሴሀ ናአይ ዮዳሄነ ባሶድያ ናአይ ማሹላም ኤጫ ፐንግያ ግምቢያ ድርሳ ግምቤድኖ። ኡንቱንቱ ፐንገ ም ኤሲደ፥ ሳንቃካ አድኖ፤ ቃይ ሳንቃዉ ጎርድያ ምነ ም ገልስያ ኩልቡዋ ጊግሴድኖ።<verse eid="NEH 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NEH 3:7"/>ኡንቱንቱ ጋጻን ደእያ ሳኣ ጋባኦና ካታማ አሳ ግድያ ማላጼነ መሮኖታ ካታማ አሳ ግዴዳ ያዶን ግምቤድኖ። ቃይ ጋባኦናነ ምጽጳ ካታማቱዋ አሳቱካ ኡንቱንቱና እትፐ ግዲደ፥ ኤፍራጺሳ ሻፋፐ አዋይ ዉልያ ባጋ ቢታ ሞድያዌ ደእያ ጎልያ ጋካናዉ ደእያ ሳኣ ግምቤድኖ።<verse eid="NEH 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NEH 3:8"/>ዎርቃ ትግያ ሀርሃያ ናአይ ኡዝኤል ኡንቱንቱ ጋጻን ደእያ ሳኣ ግምቤዳ። ቃይ አ ጋጻን ደእያ ሳኣ ሽቱዋ መያ ሀናኒ ግምቤዳ። ኡንቱንቱ ላኡ እትፐ አኮ ግምቢያ ጌተትያ ሳኣ ጋካናዉ፥ የሩሳላመ ግምቢያ ግምቤድኖ።<verse eid="NEH 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 3:9"/>ኡንቱንቱ ጋጻን ደእያ ሳኣ ሁራ ናአይ፥ የሩሳላመ ዎራዳ ሻኩዋ ሞድያ ራፋይ ግምቤዳ።<verse eid="NEH 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 3:10"/>ሀሩማፋ ናአይ ያዳይ ባረ ጎልያፐ ስን ባጋና ደእያ ሳኣ ግምቤዳ።</para>
  <para style="p" vid="NEH 3:10">አ ጋጻን ደእያ ሳኣ ሀሻባንያ ናአይ ሀጹኡሽ ግምቤዳ።<verse eid="NEH 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 3:11"/>ሀሪማ ናአይ ማልኬነ ፓሀት-ሞኣባ ናአይ ሀሹብ አ ጋጻን ደእያ ሳኣነ እቶነ አዱሳ ግምቢያ ግምቤድኖ።<verse eid="NEH 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 3:12"/>ኡንቱንቱ ጋጻን ደእያ ሳኣ ሀሎሄሻ ናአይ፥ የሩሳላመ ዎራዳ ላኤን ሻኩዋ ሞድያ ሻሉምነ አ ማጫ ናናይ ግምቤድኖ።<verse eid="NEH 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NEH 3:13"/>ሀኑንነ ዛኖሀ ካታማን ደእያ አሳቱ እትፐ ዛንጋራ ፐንግያ ግምቢያ ድርሳ ግምቤድኖ። ኡንቱንቱ ፐንግያን ሳንቃ አደ፥ ሳንቃዉ ጎርድያ ምነ ም ገልስያ ኩልቡዋ ጊግሴድኖ። ቃይ ፕቱዋ ኦልያ ፐንግያ ግምቢያ ድርሳ ጋካናዉ፥ ሻአ ዋ አዱሳ ግምቢያ ጉጂደ ግምቤድኖ።<verse eid="NEH 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NEH 3:14"/>ረካባ ናአይ፥ ቤት-ሀካሬማ ዎራዳ ሞድያ ማልኪ ፕቱዋ ኦልያ ፐንግያ ግምቢያ ድርሳ ግምቤዳ። ፐንግያን ሳንቃ አደ፥ ሳንቃዉ ጎርድያ ምነ ም ገልስያ ኩልቡዋ ጊግሴዳ።<verse eid="NEH 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NEH 3:15"/>ኮልሆዛ ናአይ፥ ምጽጳ ዎራዳ ሞድያ ሻሉም ፑልቱዋ ፐንግያ ግምቢያ ድርሳ ዛረደ ግምቤዳ። እ ፐንግያዉ ጼራ ጊግሴዳዋፐ ጉይያን፥ ሳንቃ አዳ፤ ሳንቃዉ ጎርድያ ምነ ም ገልስያ ኩልቡዋ ጊግሴዳ። ሄዋ ቦላካ ቃይ፥ ሸላሀ ጌተትያ ዳጋቴዳ ሃይ ደእያ ባጋና ካትያ አታክልትያ ሳኣፐ ዶሚደ፥ ዳዊታ ካታማፐ ዬዳ አታክልትያ ጋካናዉ ደእያ ግምቢያ ግምቤዳ።<verse eid="NEH 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NEH 3:16"/>ሄዋፐ ካልያዋ አዝቡቃ ናአይ፥ ቤትጹራ ዎራዳ ሻኩዋ ሞድያ ናህሚ ግምቤዳ፤ እ ዳዊታ ዱፉዋፐ ስን ባጋና ደእያ ሳኣ ጋካናዉ፥ ዳጋቴዳ ሃይ ደእያ ሳኣ ጋካናዉነ ዎልቃማቱዋ ጎልያ ጋካናዉ ደእያ ሳኣ ግምቤዳ።<verse eid="NEH 3:16"/></para>
  <para style="s1">ሌዋቱ ግምቢያ ድርሳ ድሬድኖ</para>
  <para style="p">
    <verse number="17" style="v" sid="NEH 3:17"/>ሄዋፐ ካልያዋ ባና ናኣ ረሁማ አዎተ ግዶን ደእያ፥ ሌዋቱ ግምቤድኖ።</para>
  <para style="p" vid="NEH 3:17">ኡንቱንቱ ጋጻን ደእያ ሳኣ ቃኢላ ዎራዳ ሻኩዋ ሞድያ ሀሻቢ ባረ ዎራዳ ሱንን ግምቤዳ።<verse eid="NEH 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NEH 3:18"/>አፐ ካልያዋ ሄናዳዳ ናአይ፥ ቃኢላ ዎራዳ ላኤን ሻኩዋ ሞድያ ባዋይነ አ እሻቱ ግምቤድኖ።<verse eid="NEH 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 3:19"/>ኡንቱንቱ ጋጻን ደእያ ሳኣ ኢያሱ ናአይ፥ ምጽጳ ዎራዳ ሞድያ ኤጼር ግምቤዳ፤ እ ኦላ ሚሻ ዎያ ጎልያፐ ስን ባጋና ደእያ ሳኣ ጋካናዉነ ግምቢያዉ ዞዝያ ጋካናዉ ደእያ ሳኣ ግምቤዳ።<verse eid="NEH 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NEH 3:20"/>አፐ ካልያዋ ዛባያ ናአይ ባሩክ ግምቢያ ጋጻፐ ዶም፥ ቢደ ቄስያ ኡባቱዋ ካፑዋ ኤልያሽባ ጎልያ ፐንግያ ጋካናዉ፥ ምኖተን ግምቤዳ።<verse eid="NEH 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NEH 3:21"/>አፐ ካልያዋ ሀቆጻ ናኣ ግዴዳ ኦርዮና ናአይ ማረሞት ኤልያሽባ ጎልያ ፐንግያፐ ዶም፥ ቢደ ጎልያ ዉርሰ ጋካናዉ ግምቤዳ።<verse eid="NEH 3:21"/></para>
  <para style="s1">ቄሳቱ ግምቢያ ድርሳ ድሬድኖ</para>
  <para style="p">
    <verse number="22" style="v" sid="NEH 3:22"/>አፐ ካልያ ሄራ ጋድያን ደእያ ቄሳቱ ግምቤድኖ።<verse eid="NEH 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NEH 3:23"/>ኡንቱንቱፐ ካልያዋ ቢንያመነ ሀሹብ ባረንቱ ጎልያ ስንን ደእያ ሳኣ ግምቤድኖ።</para>
  <para style="p" vid="NEH 3:23">ኡንቱንቱፐ ካልያዋ አናንያ ናኣ ግዴዳ ማእሴያ ናአይ አዛረ ባረ ጎልያ ምይያን ደእያ ሳኣ ግምቤዳ።<verse eid="NEH 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NEH 3:24"/>አፐ ካልያዋ አዛርያ ጎልያፐ ዶም፥ ቢደ ግምቢ ዙቀት ስሞ ሳኣ ጋካናዉ ደእያ ሳኣ ሄናዳዳ ናአይ ቢኑይ ግምቤዳ።<verse eid="NEH 3:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NEH 3:25"/>ኡዛያ ናአይ ፓላል ግምቢያ ዙቀት ስሞ ሳፐ ዶም፥ ቢደ ናግያዋንቱ ዎችያ ማማፐ ቆሞ ባጋና ኦይቀት ኬጸቴዳ ካትያ ጎልያ ቃ ግምቢያ ስን ጋካናዉ ደእያ ሳኣ ግምቤዳ።</para>
  <para style="p" vid="NEH 3:25">አፐ ካልያዋ ፓርኦሻ ናአይ ፓዳይነ <verse eid="NEH 3:25"/><verse number="26" style="v" sid="NEH 3:26"/>ጌሻ ጎልያ ቆማቱ፥ ኦፌላን ደእያዋንቱ ግምቤድኖ፤ ኡንቱንቱ ሃ ፐንግያ ግምቢያ ድርሳ ስንና አዋይ ዶልያ ባጋና ደእያ ሳኣነ ማማ ግምቢያ ጋካናዉ ደእያ ሳኣ ግምቤድኖ።<verse eid="NEH 3:26"/></para>
  <para style="s1">ግምቢያ ድርሳ ድሬዳ ሀራ አሳቱዋ</para>
  <para style="p">
    <verse number="27" style="v" sid="NEH 3:27"/>ኡንቱንቱፐ ካልያዋ ታቆአ ካታማ አሳይ ግምቢያፐ ስንን ሀራ ባጋና ደኢያሳፐ ቢደ፥ ኦፌላ ግምቢያ ድርሳፐ ሃክ ደእያ ዎልቃማ ማማ ግምቢያ ጋካናዉ ደእያ ሳኣ ግምቤድኖ።<verse eid="NEH 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NEH 3:28"/>እት እት ቄሳቱ ካ ፓራ ፐንግያ ግምቢያ ድርሳፐ ቆሞና ደእያ ባረንቱ ጎልያ ስንና፥ ሁጲሳ ባጋና ደእያ ሳኣ ግምቤድኖ።<verse eid="NEH 3:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NEH 3:29"/>ኡንቱንቱፐ ካልያዋ እሜራ ናአይ ጻዶቀ ባረ ጎልያ ስንን ደእያ ሳኣ ግምቤዳ።</para>
  <para style="p" vid="NEH 3:29">አፐ ካልያዋ አዋይ ዶልያ ፐንግያ ናግያ ሻካንያ ናአይ ሻማኤ ግምቤዳ።<verse eid="NEH 3:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NEH 3:30"/>አፐ ካልያዋ ሸሌምያ ናአይ ሀናኒነ ጻላፋዉ ኡሱፑን ናኣ ግዴዳ ሀኑን ግምቤድኖ።</para>
  <para style="p" vid="NEH 3:30">ኡንቱንቱፐ ካልያዋ በረክያ ናአይ ማሹላም ባረ ደእያ ክፍለቱዋ ስንን ደእያ ሳኣ ግምቤዳ።<verse eid="NEH 3:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NEH 3:31"/>አፐ ካልያዋ ጾሞስያ ግምቢያ ድርሳ ፐንግያ ስንን ደእያ ጌሻ ጎልያ ቆማቱነ ዛልአንቻቱ ጎልያ ጋካናዉ ደእያ ሳኣ ዎርቃ ትግያ ማልክ ግምቤዳ። ቃይካ እ ግምቢያ ጋጻን ቦላ ባጋና ደእያ ክፍልያ ጋካናዉ ደእያ ሳኣካ ግምቤዳ።<verse eid="NEH 3:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NEH 3:32"/>ዎርቃ ትግያዋንቱነ ዛልአንቻቱ ሄ ክፍልያፐ ዶሚደ፥ ዶርሳ ፐንግያ ግምቢያ ድርሳ ጋካናዉ ደእያ ሳኣ ግምቤድኖ።<verse eid="NEH 3:32"/></para>
  <chapter eid="NEH 3"/>
  <chapter number="4" style="c" sid="NEH 4"/>
  <para style="s1">ግምቢ ሽረት ግምበተናዳን ድጋናዉ ደንዴዳ ቆፋ</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 4:1"/>ኑን ግምቢያ ድርሳ ኪታ ዶሜዳዋ ሳንባላጽ ስሴዳ ዎደ ሀንቁዋ ኤጽ ከሴዳ፤ ቃይ ሎይ ይሎቲደ፥ ኑና ቅሊጬዳ። <verse eid="NEH 4:1"/><verse number="2" style="v" sid="NEH 4:2"/>ባረ ላገቱዋነ ሳማርያ ኦላንቻቱ ስንን እ ሀዋዳን ያጌዳ፤ “ሀዋንቱ፥ ሀ ፓና አይሁዳቱ አያ ኦኖ? ካታማ ዛረደ ግምባናዉ ኮዪኖየ? ያርሹዋካ ያርሻናዉ ኮዪኖ? ኦሱዋ እት ጋላስ ዉርሳናዋ ኡንቱንቶ ማላቲየ? ግምቢያዉ ሹቻ ዛር ደኡዋን ዎናዉ ዳንዳየት?”<verse eid="NEH 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 4:3"/>አ ምይያን ኤቄዳ አሞና ጋድያ አሳ ግዴዳ ጾቢካ ቃይ ሀዋዳን ያጌዳ፤ “ኡንቱንቱ ቃይ አያነ ግምቢያ ግምባናዉ ዳንዳዪዬ? ኡንቱንቱ ግምቢያ ድርሳ ግምቢያ ቦላን ዎራካናይ ከስንቶነ ኩንድ አጋና”።<verse eid="NEH 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 4:4"/>ሄዋፐ ጉይያን፥ ታን ሀዋዳን ያጋደ ዎሳድ፤ “ኑ ጾሳዉ፥ ኡንቱንቱ ኑና ዎት ዎት ቅሊጭንቶ ሀዋ ስሳ! ኡንቱንቱ ኑና ሸቂያ ሸቃይ ኡንቱንቱ ሁጲያን ስሞ። ባረንቶ ደእያ አቁዋ ቦንቀት ክቺደ፥ አላጋ ጋድያን ኦሞደቴዳ አሳ ግድኖ። <verse eid="NEH 4:4"/><verse number="5" style="v" sid="NEH 4:5"/>ኡንቱንቱ ናቁዋ ገንፓ፤ ኡንቱንቱ ናጋራካ ነ ስንፐ ሙለ ቁጮፓ። አያዉ ጎፐ፥ ግምቢያ ግምቢያዋንታ ኑና ሸቃን ካዉሼድኖ”።<verse eid="NEH 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 4:6"/>ኑን ግምቢያ ድርሳ ኦሱዋ አገናን ኦዳ። ቃይ አሳይካ ኦሱዋ ምኖተን ኦያ ድራዉ፥ ግምቢያ ድርሳ ቃተይ ኤለካ ባካ ኬሻ ግድ አጌዳ።<verse eid="NEH 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NEH 4:7"/>ሳንባላጽ፥ ጾቢ፥ አራባ ጋድያ አሳይ፥ አሞና ጋድያ አሳይነ አሽዶዳ ካታማ አሳይ የሩሳላመ ግምቢያ ድርሳ ኪታይ ሎኦ ሀኖተን ኦሰቲደ ደእያዋነ ኮለቴዳ ሳአቱካ ባረቴዳ ዎደ ሎይ ሀንቀቴድኖ። <verse eid="NEH 4:7"/><verse number="8" style="v" sid="NEH 4:8"/>ሄዋፐ ደንዴዳዋን እትፐ የሩሳላመ ዪደ ኑና ኦላናዉነ ሻቢርሳናዉ ማቀቴድኖ። <verse eid="NEH 4:8"/><verse number="9" style="v" sid="NEH 4:9"/>ሽን ኑን ኑ ጾሳኮ ዎሴዶ፤ ኡንቱቱፐ ደንዴዳዋን ቃማነ ጋላስ ናግያ ናጋንቻቱዋካ ዎዶ።<verse eid="NEH 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 4:10"/>ሄ ዎድያን ይሁዳ አሳይ ሀዋዳን ያጌድኖ፤ “ቶኩዋ ቶክያዌ ካሰዋፐ ኑና ላባን፤ ቃይ ደንናዉ ኮሽያ ግምቢያፐ ኮለቴዳ ዳሮ ሹቻይካ ብሮ ደኤ። ያትና፥ ኑን ሀቼ ሀ ግምቢያ ዋቲደ ግምባናዉ ዳንዳዬቶ?”<verse eid="NEH 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 4:11"/>ኑ ሞርከቱ፥ “ኑን ቢደ ኡንቱንቱ ግዶ ጋካናዉ፥ ኡንቱንቱ ኦሱዋ ኦናዳን ተአናዉነ ኡንቱንታ ዎና ጋካናዉ፥ ኡንቱንቱ ኤርክኖ” ያጌድኖ።<verse eid="NEH 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 4:12"/>ግዶ ሽን፥ አይሁዳቱ ዛር ዛር ኑኮ ዪደ፥ “ኡንቱንቱ ሙለ ባጋና ዪደ፥ ኑና ኦላናዋንታ” ያጊደ ኑዉ ኦዴድኖ።<verse eid="NEH 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NEH 4:13"/>ሄዋ ድራዉ፥ ኑ አሳፐ ማሻ፥ ቶራነ ዎንዳፍያ ኦይቂደ አሳ ኡንቱንቱ ዛርያን ዛርያን ማራደ፥ ኪታይ ዉርቤና ሄራን ግምቢያፐ ዞኮ ባጋና ናጋናዳን ዎድ። <verse eid="NEH 4:13"/><verse number="14" style="v" sid="NEH 4:14"/>አሳይ ሻቢረቴዳዋ ታን በኤዳ ዎደ፥ ደንዳ ኤቃደ፥ ኡንቱንታ፥ ኡንቱንቱ ካለያዋንታነ ሀራ ካፓቱዋ ኡባ ሀዋዳን ያጋድ፤ “ኑ ሞርከቶ ያዮፕተ! ጎዳይ ዎልቃማነ ሆላ ጌተትያዋ ግድያዋ ሀሳይተ። ሄዋ ድራዉ፥ ህንተንቱ ዛረቶ፥ ህንተንቱ አቱማ ናናቶ፥ ህንተንቱ ማጫ ናናቶ፥ ህንተንቱ ማችያዉነ ህንተንቱ ጎልያዉ ኦለትተ” ያጋድ።<verse eid="NEH 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NEH 4:15"/>ኑ ሞርከቱ ኑና ቆሀናዉ ማቀቴዳዋ ኑን ኤሬዳዋ ኡንቱንቱ ስሴድኖ። ቃይ ጾሳይካ ኡንቱንቱ ማቁዋ ሀዳ ከሴዳዋ አኬኬድኖ።</para>
  <para style="p" vid="NEH 4:15">ሄዋፐ ጉይያን፥ ኑን ኡባይካ ስሚደ፥ ኑ ግምቢያ ድርሳ ኦሱዋ ዶሜዶ። <verse eid="NEH 4:15"/><verse number="16" style="v" sid="NEH 4:16"/>ሄ ዎድያፐ ዶሚደ፥ ታ ቆማቱዋፐ ባካይ ኦሱዋ ኦያ ዎደ፥ ባካይ ትራን ዎያ ኦላ ሚሻ ማዪደ፥ ቶራ፥ ጎንዳልያነ ዎንዳፍያ ኦይቂደ ናጋናዳን ኦድ። ቃይ ካፓቱካ ይሁዳ አሳ ኡባፐ ጉየና ኤቂደ ምንኖ። <verse eid="NEH 4:16"/><verse number="17" style="v" sid="NEH 4:17"/>ግምቢያ ድርሳ ግምቢያዋንቱነ ኮሽያዋ ቶክያዋንቱ ኡባይ እት ኩሽያን ኦላ ሚሻ ኦይቂደ፥ እት ኩሽያን ኦሱዋ ኦኖ። <verse eid="NEH 4:17"/><verse number="18" style="v" sid="NEH 4:18"/>ግምቢያ ኦሱዋ ኦያ ኡባይ ማሻ ባረ ጼሳን ዳንጭ ዳንጭ ኡቴዳ። ማላካታ ፑንያዌካ ኡባ ዎደ ታፐ ሻከት ኤረና።<verse eid="NEH 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 4:19"/>አሳ ካለያዋንታ፥ ካፓቱዋነ አሳ ኡባ ታን ሀዋዳን ያጋድ፤ “ግምቢያ ድርሳ ኪታይ ዎልቃማነ ሎይ አካ ግድያዋፐ ደንዴዳዋን፥ ኑን እቱ እቱዋፐ ሻከቲደ ሃኬዶ። <verse eid="NEH 4:19"/><verse number="20" style="v" sid="NEH 4:20"/>ሄዋ ድራዉ፥ ህንተንቱ ማላካታ ፑና ስስያ ዎደ፥ እ ፑነትያ ሳኣ ታኮ ሃ ሺቅተ። ኑ ጾሳይካ ኑ ድራዉ ኦለታናዋ”። <verse eid="NEH 4:20"/><verse number="21" style="v" sid="NEH 4:21"/>ኦሱዋ ዎንቱማ ሳሉ ዞእያ ዎድያፐ ዶሚደ፥ ኦማርስ ጾልንቲ ከሳና ጋካናዉ ኦያ ዎደ ኡባን፥ ባጋይ ኦያ ዎደ፥ ባጋይ ቶራ ኦይቂደ ናጊኖ።<verse eid="NEH 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NEH 4:22"/>ሄ ዎደ ታን አሳዉ ሀዋዳን ያጋድ፤ “ቃማን ኑና ናጋናዉነ ጋላስ ቃይ ኪታ ኦናዉ ህንተንቱ ኡባይካ ህንተንቱ ቆማቱካ የሩሳላመን አቅተ”። <verse eid="NEH 4:22"/><verse number="23" style="v" sid="NEH 4:23"/>ሄዋ ድራዉ፥ ታና ግድና፥ ታ እሻቱዋ ግድና፥ ታ ቆማቱዋ ግድና፥ ዎይ ቃይ ታና ናግያዋንታ ግድናካ፥ ኑን ኡባይካ ኑ ማዩዋ ከሰናን አቄቶ፤ ቃይ ኑ ኦላ ሚሻይካ፥ ኑፐ ኡባካ ሻከተና።<verse eid="NEH 4:23"/></para>
  <chapter eid="NEH 4"/>
  <chapter number="5" style="c" sid="NEH 5"/>
  <para style="s1">ህዬሳቱ ናቀቴናዳን ናህም ኦዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 5:1"/>አቱማዌነ ማጫዌ ባረንቱ ዛርያ ግዴዳ አይሁዳቱ ቦላን ዎልቃማ ጫቡዋ ከሴድኖ። <verse eid="NEH 5:1"/><verse number="2" style="v" sid="NEH 5:2"/>ኡንቱንቱ ሀዋዳን ያጌድኖ፤ “ኑን፥ ኑ አቱማ ናናይነ ኑ ማጫ ናናይ ጮራ፤ ሄዋ ድራዉ፥ ኑን ሚደ ፓጻ ደአና ማላ፥ ኑዉ ካይ ኮሼ”።<verse eid="NEH 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 5:3"/>ሀራቱ ቃይ፥ “ኑና ጋኬዳ ኢታ ኮሻፐ ኑና አሽያ ቁማ ደማና ጊደ፥ ኑ ጎሻይ፥ ኑ ዎይንያ ቱራ ሳአይነ ኑ ኬይ አተናን አሳዉ ኦይዶ” ያጌድኖ።<verse eid="NEH 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 5:4"/>ሀራቱካ ቃይ ሀዋዳን ያጌድኖ፤ “ኑ ጎሻዉነ ኑ ዎይንያ ቱራ ሳቶ ካቲ ኦቼዳ ጊራ ጭጋናዉ ሚሻ ታልእያ አኬዶ። <verse eid="NEH 5:4"/><verse number="5" style="v" sid="NEH 5:5"/>አይሁዳ ዛራቱዋና ኑን እት አሹዋ፤ ኑ ናናይካ ኡንቱንቱ ናና ማላ። ሽን ኑን ኑ የሌዳ ናና አይለተዉ አደ እማናዉ ግደቴዶ፤ ኡባ ቃይ ኑ ማጫ ናናቱዋፐ እቱ እቱ አይለተዉ ዛልኤቴድኖ። ግዶፐነ፥ ኑ ጎሻይነ ኑ ዎይንያ ቱራ ሳአቱ ኑፐ አከት ድጎ ድራዉ፥ ኑን አይነ ኦናዉ ዳንዳዮኮ”።<verse eid="NEH 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 5:6"/>ኡንቱንቱ ጫቡዋነ ሀ ቃላ ታን ስሴዳ ዎደ፥ ሎይ ሀንቀታድ። <verse eid="NEH 5:6"/><verse number="7" style="v" sid="NEH 5:7"/>ኦናዋ ታ ዎዛናን ቆፓደ፥ አሳ ካለያዋንታነ ካፓቱዋ ጼሳደ፦ “ህንተንቱ ህንተንቱ ዛራቱዋ የሉዋ ጭግስያዋን ኡቁኒታ” ያጋደ ኡንቱንታ ሞታድ።<note caller="-" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="EXO 22:25">ከሳ 22:25</ref>፤ <ref loc="LEV 25:35-37">ዎጋ 25:35-37</ref>፤ <ref loc="DEU 23:19-20">ዛረ. 23:19-20</ref></char></note></para>
  <para style="p" vid="NEH 5:7">ሄ መቱዋባ ሃሳዪደ ብላናዉ ዎልቃማ ሺቁዋ ኡንቱንቱና ኡዳድ። <verse eid="NEH 5:7"/><verse number="8" style="v" sid="NEH 5:8"/>ሀዋዳን ያጋድ፤ “አይሁዳ ግደናዋንቶ ዛልኤቴዳ አይሁዳ ዛርያ ግዴዳ ኑ እሻቱዋ ዎዛናዉ ኑን ኑ ዎልቃይ ዳንዳዬዳዋ ኡባ ኦዶ። ሽን ህንተንቱ ቃይ፥ ህንተንቱ እሻቱዋ ግዴዳ ህንተንቱ ዛርያ ህንተንቶ ባረንታ ዛልአና ማላ ኦደ ደኢታ”። ካለያዋንቶ ዛርያ ቃላይ ይና፥ ጮኡ ያጌድኖ።<verse eid="NEH 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 5:9"/>ታን ቃይካ ሀዋዳን ያጋድ፤ “ህንተንቱ ኦያባይ ልከ ግደና፤ ኑ ሞርከቱ፥ አይሁዳ ግደናዋንቱ ኑ ቦላን ቅሊጨና ማላ፥ ኑ ጾሳዉ ያያናዉነ ልከ ግድያባ ኦናዉ ህንተንቶ በሰኔ? <verse eid="NEH 5:9"/><verse number="10" style="v" sid="NEH 5:10"/>ታን ታ ሁጲያዉ፥ ታ እሻቱዋነ ታ ቆማቱካ ኡንቱንቶ ሚሻነ ካ ታልኤዶ፤ ግዶ ሽን፥ አነ ኡንቱንቱፐ የሉዋ አክያዋ አጎይተ። <verse eid="NEH 5:10"/><verse number="11" style="v" sid="NEH 5:11"/>ኡንቱንቱ ጎሻቱዋ፥ ዎይንያ ቱራ ሳአቱዋ፥ ዛይትያ ዎጋራቱዋነ ጎለቱዋ ኡባካ ኡንቱንቶ ሀቼ ዛርተ። ቃይ ሚሻን፥ ካን፥ ዎይንያ ኤሳን ግድና ዛይትያን፥ ህንተንቱ ኡንቱንቱፔ አኬዳ ጼቱዋፐ እት ኩሽያ የሉዋ ኡባ ኡንቱንቶ ኤለካ ዛርተ”።<verse eid="NEH 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NEH 5:12"/>ኡንቱንቱካ ዛሪደ፥ ሀዋዳን ያጌድኖ፤ “ኑን ኡባባካ ኡንቱንቱዋ ዛሪደ፥ ኡንቱንቶ እማና፤ ኡንቱንታ አያነ ኦቾኮ። ኔን ጋደ ደእያዋዳን፥ ኑን ኦና”።</para>
  <para style="p" vid="NEH 5:12">ሄዋፐ ጉየ ቄሳቱ ዋ ሃ ታኮ ጼጋደ፥ ባረንቱ ጌዳ ቃላ ፖላና ማላ፥ ጫቀናዳን ኦድ። <verse eid="NEH 5:12"/><verse number="13" style="v" sid="NEH 5:13"/>ሄዋፐ ጉይያን፥ ታ ማዩዋ ቆቆፋደ ሀዋዳን ያጋድ፤ “ኦንነ ህንተፐ ባረ ጌዳ ቃላ ፖለናን ዮፐ፥ ጾሳይ አ ሀዋዳን አ ጎልያፐነ አ አቁዋፐ ቆቆፎ፤ እካ ቆቆፈቲደ መላ አቶ”።</para>
  <para style="p" vid="NEH 5:13">ሺቄዳ አሳይ ኡባይ እት ቃላን፥ “አመንእ” ያጊደ መና ጎዳ ጋላቴድኖ። አሳይ ኡባይ ባረ ጫቄዳዋዳን ኦዳ።<verse eid="NEH 5:13"/></para>
  <para style="s1">ናህምያ ጋራተ</para>
  <para style="p">
    <verse number="14" style="v" sid="NEH 5:14"/>አርጸክስስ ካተቴዳ ላታማን ላይፐ ቢደ፥ ሀታማነ ላኤን ላይ ጋካናዉ፥ ታን ይሁዳ ሞድያዋ ግዳደ ሱንታድ። ሄ ታማነ ላኡ ላይን፥ ታና ግድና ዎይ ታ እሻቱ ሞድያዎ በስያ ቁማ ድርጉዋ አክበይኮ። <verse eid="NEH 5:14"/><verse number="15" style="v" sid="NEH 5:15"/>ሽን ታፐ ካሰና ሞድያዋንቱ አሳዉ ዴጾ ቶኮ ግዲደ፥ ሀቼ ሀቼ ካውነ ዎይንያ ኡሻው ኦይታሙ ጻጋራ ብራ ጭግሴድኖ። ሀራይ አቶ አይስያዋንቶ ቆማቱካ ባረንቱ አሳ ቦላን ጎዳ ማላትሲደ ጋምኤድኖ። ግዶፐነ፥ ታን ጾሳዉ ያዬዳ ድራዉ፥ ሄዋዳን ኦበይከ። <verse eid="NEH 5:15"/><verse number="16" style="v" sid="NEH 5:16"/>ታናተ ኡባ የሩሳላመ ግምቢያ ድርሳ ኦሶ እማድፐ አትን፥ ታ ሁጰው አይ ጋድያነ ሻማበይከ። ታ ቆማቱካ ኡባይ ታናና ሄ ኪታን እትፐ ጋምኤድኖ። <verse eid="NEH 5:16"/><verse number="17" style="v" sid="NEH 5:17"/>ኑ ሄራን ደእያ አይሁዳ ግደናዋንቱፐ ኑኮ ዬዳ አሳይ ባይናን ደእሽን፥ ሀቼ ሀቼ ታናና ታ ማሶፍያን ምያ አይሁዳቱነ ኡንቱንታ ካለያዋንቱ ፓይዱ ጼታነ እሻታማ። <verse eid="NEH 5:17"/><verse number="18" style="v" sid="NEH 5:18"/>ሀቼ ሀቼ እት ቦራ፥ ኡሱፑን ዶረቴዳ ዶርሳቱዋነ ዳሮ ኩቶቱዋ ሹክ ሹኪደ፥ አሳዉ ሺሽኖ፤ ቃይ ታሙ ጋላሳን እት ገደ ዳሮ ባ ዎይንያ ኤሳ ኡንቱንቶ አጊኖ። ሽን አሳ ቦላን ደእያ ቶኩ ዴጹዋ ግድያዋ ታን ኤርያ ድራዉ፥ ጋድያ ሞድያዎ በስያ ቁማ ድርጉዋ ኦቻበይከ።<verse eid="NEH 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 5:19"/>“ታ ጾሳዉ፥ ታን ሀ አሳዉ ኦዳ ሎኦተ ኡባ ቆፓደ፥ ታዉካ ሎኦተ ኦ” ያጋድ።<verse eid="NEH 5:19"/></para>
  <chapter eid="NEH 5"/>
  <chapter number="6" style="c" sid="NEH 6"/>
  <para style="s1">ኦሱ ኦሰት ፖለተናዳን ደንዴዳ የዉዋ ጾኑዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 6:1"/>ሳምባላጽ፥ ጾቢ፥ አራባ ጋድያ አሳ ግድያ ገሼምነ ሀራ ኑ ሞርከቱ ኑን ግምቢያ ድርሳ ኦደ ፖሌዳዋነ ቃይ ኦሰትቤና ፓጫ ሳአይካ እቱነ አትቤናዋ ስሴድኖ። ግዶ ሽን፥ ኑን ግምቢያ ድርሳ ፐንገቱዋን ብሮ ሳንቃ ገልስበይኮ። <verse eid="NEH 6:1"/><verse number="2" style="v" sid="NEH 6:2"/>ሄዋ ኡንቱንቱ ስሴዳ ዎደ፥ ሳንባላጽነ ገሼም ሀዋዳን ያጊደ፥ ታኮ ኪቴድኖ፤ “ኦና ጌተትያ ደምባን ደእያ ቄር ካታማቱዋፐ እቱዋን ያደ ኑናና ጋከታ”። ሽን ኡንቱንቱ ታ ቦላ ኢታ ኦናዉ ማቀቴድኖ።<verse eid="NEH 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 6:3"/>ሄዋ ድራዉ፥ ታን ኡንቱንቶ ሀዋዳን ያጋደ ዛራ ኪታንቻቱዋ ኪታድ፤ “ታዉ ዳሮ ኪታይ ደኤ፤ ሄዋ ድራዉ፥ ታን ህንተንቱ ግያ ሳኣ ባናዉ ዳንዳይከ። ታን ዱገ ህንተንቱኮ ቢና፥ ኪታይ አያዉ በቲ?” <verse eid="NEH 6:3"/><verse number="4" style="v" sid="NEH 6:4"/>ሄ ኪታ ዛር ዛር ኦይዱ ገደ ታኮ ኪቴድኖ፤ ሽን ታን እት ማላ ዛሩዋ ኡንቱንቶ እማድ።<verse eid="NEH 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NEH 6:5"/>እቼሸንዋን ሳምባላጽ ባረ ቆማ ቦላ ዶያ ደእያ ዳብዳቢያ ታኮ ኪቴዳ። <verse eid="NEH 6:5"/><verse number="6" style="v" sid="NEH 6:6"/>ዳብዳቢካ ሀዋዳን ያጌ፤ “ኔንነ ነ ዛርያ ግዴዳ አይሁዳቱ ማካላናዉ ቆፔዳዋነ ሄዋፐ ደንዴዳዋን ግምቢያ ድርሳ ግምቢያዋ ሾሮ ጋድያን ደእያ አሳይ ኡባይ ሃሳይያዋ ገሼም ታዉ ኦዴዳ። ቃይ ኔን ኔና ካትያ ከሳናዉ ኮይያዋነ፤ <verse eid="NEH 6:6"/><verse number="7" style="v" sid="NEH 6:7"/>ኔን ይሁዳ ካትያ ግድያዋ የሩሳላመን አዋያና ማላ፥ ትምቢትያ ኦድያዋንታ ነ ዎዳዋካ እ ታዉ ኦዴዳ። ሀ ዋርያ ካቲ ስሱሳይ አተና። ሄዋ ድራዉ፥ ታናና ጋከታደ ዞረታናዉ ሃያ”።<verse eid="NEH 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NEH 6:8"/>ታንካ፥ “ሀ ኔን ግያ የዉዋ ኡባይ ኡባካ ቱማ ግደናዋነ ኔን ጮ መዳዋ” ያጋደ ዛራድ።<verse eid="NEH 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 6:9"/>ኑ ኦያ ኪታይ ፖለተና ማላ፥ “ኡንቱንቱ ኩሺ ኦሶ ዳቡር ክቼዳ” ያጊደ ኡንቱንቱ ኑና ያሽሲደ ጋምኤድኖ።</para>
  <para style="p" vid="NEH 6:9">ሄዋ ድራዉ፥ “ኑ ጾሳዉ ሀእ ታና ምንርኪ” ያጋደ ታን ዎሳድ።<verse eid="NEH 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 6:10"/>ሄዋፐ ጉይያን፥ ሶፐ ከሰናዳን ጎርድ ዎዳ ማሄጻብኤላ ናኣ ናኣ ዳላያ ናኣ ሻማእያኮ ባድ። እ ታዉ ሀዋዳን ያጌዳ፤ “እት ቃማ አዉደንቶ ኡንቱንቱ ኔና ዎናዉ ያና ደእያ ድራዉ፥ ኔንነ ታን ጾሳ ጎልያ ግዶ ገሊደ፥ ጾሳ ጌሻ ጎልያ ግዶን ጾሳ ጌሻ ጎልያ ፐንገቱዋ ጎርዲደ ጋከቶይተ”።<verse eid="NEH 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 6:11"/>ታን ሀዋዳን ያጋደ ዛራድ፤ “ታና ማላትያ አሳይ ባቃቲ? ዎይ ቃይ ታና ማላትያ አሳይ ጌሻ ጎልያ ግዶ ገሊደ፥ ባረ ሸምፑዋ አሺ? ታን ሄዋ ኡባካ ኦከ”። <verse eid="NEH 6:11"/><verse number="12" style="v" sid="NEH 6:12"/>ታ የዉዋ ቆፕያ ዎደ፥ ቱሙካ አ ጾሳይ ኪቴዳ ትምቢትያ ኦድያዋ ግደናዋነ ጾቢነ ሳንባላጽ አ ሚሻን ሻሜዳ ድራዉ፥ ታ ቦላ ዎርዶ ትምቢትያ ኦድያዋ ግድያዋ አኬካድ። <verse eid="NEH 6:12"/><verse number="13" style="v" sid="NEH 6:13"/>እ ሚሻን ሻመቴዳ ጋሱ ታን ያያደ፥ እ ግያዋዳን ኦደ ታን ናጋራን ገላናዳና። ያትና፥ ኡንቱንቱ ኡባይ ሄዋ ስሴዳ ዎደ፥ ታና ካስያባ ታ ቦላን ደማናሳ።<verse eid="NEH 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NEH 6:14"/>“ታ ጾሳዉ፥ ጾቢነ ሳንባላጽ ኦዳዋ ቆፓ። ኖኣዶ ጌተትያ ማጫ ትምቢትያ ኦድያናነ ሀራ ትምቢትያ ኦድያዋንቱ ኡባይ ታና ያሽሳናዉ ኡንቱንቱ ኦዳዋ ኡባካ ቆፓ” ያጋድ።<verse eid="NEH 6:14"/></para>
  <para style="s1">ግምቢያ ድርሳ ኦሱ ፖለቴዳ</para>
  <para style="p">
    <verse number="15" style="v" sid="NEH 6:15"/>ግምቢያ ድርሳ ኪታይ እሻታማነ ላኡ ጋላሳን፥ ኤሉላ ጌተትያ አግናን ላታማነ እቼሻን ጋላሳን ፖለቴዳ። <verse eid="NEH 6:15"/><verse number="16" style="v" sid="NEH 6:16"/>ኑ ዩሹዋን ደእያ ካዉተቱዋ ግዶን ደእያ ኑ ሞርከቱ ሄዋ ስሴዳ ዎደ ያዬድኖነ ዬላቴድኖ። አያዉ ጎፐ፥ ሀዌ ኪታይ ኑ ጾሳይ ማድና ኦሰቴዳዋ አኬኬድኖ።<verse eid="NEH 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NEH 6:17"/>ሄ ዎድያን አይሁዳቱዋ ካለያዋንቱ ጾቢያዉ ጮራ ዳብዳበቱዋ ጻፌድኖ፤ ጾቢ ዛሪደ፥ ኡንቱንቶ ጻፌዳ። <verse eid="NEH 6:17"/><verse number="18" style="v" sid="NEH 6:18"/>አያዉ ጎፐ፥ እ አራሀ ናኣ ሻካንያ ናቶ አኬዳ ድራዉነ አ ናአይ ያሆሀናን በረክያ ናኣ ማሹላማ ናቶ አኬዳ ድራዉ፥ ይሁዳፐ ዳራቱ አናና ጫቀት ኡቴድኖ። <verse eid="NEH 6:18"/><verse number="19" style="v" sid="NEH 6:19"/>ኡንቱንቱ ጾቢ ኦዳ ሎኦባ ኡባ ታ ስንን ሃሳይኖ፤ ቃይ ታን ግያዋካ አዉ ኦዲኖ። ጾቢካ ታና ያሽሳናዉ ዳብዳበቱዋ ጻፍ የዴ።<verse eid="NEH 6:19"/></para>
  <chapter eid="NEH 6"/>
  <chapter number="7" style="c" sid="NEH 7"/>
  <para style="p">
    <verse number="1" style="v" sid="NEH 7:1"/>ግምቢያ ኪታይ ዉርና፥ ፐንገቱዋንካ ሳንቃይ ገሌዳ። ቃይ ፐንግያ ናግያዋንቱ፥ ማዝሙርያ የጽያዋንቱነ ሌዋቱ ባረንቱ ኪታን ኪታን ገሌድኖ። <verse eid="NEH 7:1"/><verse number="2" style="v" sid="NEH 7:2"/>ሄዋፐ ጉይያን፥ የሩሳላመ ካታማ አይስያ ማታ ታ እሻ ሀናናዉነ ጌሱዋ ጋዳዋ ሀናንያዉ እማድ። ሀናኒ ሀራ ኡባፐ አዳ ቱማንቻነ ጾሳዉ ያይያ አሳ። <verse eid="NEH 7:2"/><verse number="3" style="v" sid="NEH 7:3"/>ታን ኡንቱንታ ሀዋዳን ያጋደ አዛዛድ፤ “ዎንታ አዋይ ከሲደ ሆአና ጋካናዉ፥ የሩሳላመ ግምቢያ ፐንገቱዋ ዶዮፕተ። ቃይ ኦማርስ ናግያዋንቱ ባረንቱ ኦሱዋ ዉርሲደ ባናፐ ካሰቲደ፥ ፐንገቱዋ ሎይ ጎርዳናዳን ኦተ። ሄዋ ቦላካ የሩሳላመን ደእያ አሳፐ ዶሪደ፥ እቱ እቱ ካላን ካላን ናጋናዳንነ ቃይ ሀራቱ ባረንቱ ሄራን ደኢደ፥ ባረንቱ ጎልያ ኬሻ ኬሻ ናጋናዳን ኦተ” ያጋድ።<verse eid="NEH 7:3"/></para>
  <para style="s1">ኦሞዱዋፐ ስሜዳ አሳ ሱን</para>
  <para style="r">(<ref loc="EZR 2:1-70">እዝራ 2:1-70</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 7:4"/>ሄ ዎደ የሩሳላመ ካታማይ ሎይ አኮነ ዎልቃማ፤ ሽን አ ግዶን ደእያ አሳ ፓይዱ ሎይ ጉ። ቃይ ዳሮ ጎሊካ ብሮ ኬጸትቤና። <verse eid="NEH 7:4"/><verse number="5" style="v" sid="NEH 7:5"/>ሄዋፐ ጉይያን፥ አሳ ካለያዋንታ፥ ካፓቱዋነ አሳ ኡባ ሺሻደ ኡንቱንቱ የለታ ማራን ማራን ማዝጋባና ማላ፥ ጾሳይ ታና ቆፍሴዳ። ኦሞዱዋፐ ካሰቲደ ስሜዳ አሳ የለታ ማራ ማጻፋካ ደማድ፤ ሄ ማጻፋን ጻፈቴዳዌ ሀዋ።<verse eid="NEH 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 7:6"/>ባብሎነ ካቲ ናቡካዳናጾረ ኦሞዲደ፥ ባረ ጋድያ አፌዳ አሳፐ ጉየ ባረንቱ ካታማ ካታማ የሩሳላመነ ይሁዳ ስሜዳ አሳቱ ሀዋፐ ካልያዋንታ። <verse eid="NEH 7:6"/><verse number="7" style="v" sid="NEH 7:7"/>ኡንቱንቱ ካፓቱ ዛሩባቤላ፥ ኢያሳ፥ ናህምያ፥ አዛርያ፥ ራኣምያ፥ ናሀማና፥ ማርድክዮሳ፥ ብልሻና፥ ምስፐሬታ፥ ብግዋያ፥ ናሁማነ ባኣና።</para>
  <para style="p" vid="NEH 7:7">ኦሞዱዋፐ ስሜዳ እስራኤልያ አሳ ፓይዱ ሀዋ።<verse eid="NEH 7:7"/></para>
  <para style="b"/>
  <para style="m">
    <verse number="8" style="v" sid="NEH 7:8"/>ፓርኦሻ ያራቱ 2,172.<verse eid="NEH 7:8"/></para>
  <para style="m">
    <verse number="9" style="v" sid="NEH 7:9"/>ሻፋጽያ ያራቱ 372.<verse eid="NEH 7:9"/></para>
  <para style="m">
    <verse number="10" style="v" sid="NEH 7:10"/>አራሀ ያራቱ 652. <verse eid="NEH 7:10"/><verse number="11" style="v" sid="NEH 7:11"/>ኢያሱነ እዮኣባ ናና ግዴዳ ፓሀት-ሞኣባ ያራቱ 2,818.<verse eid="NEH 7:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="NEH 7:12"/>ኤላማ ያራቱ 1,254.<verse eid="NEH 7:12"/></para>
  <para style="m">
    <verse number="13" style="v" sid="NEH 7:13"/>ዛቱ ያራቱ 845.<verse eid="NEH 7:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="NEH 7:14"/>ዛካያ ያራቱ 760.<verse eid="NEH 7:14"/></para>
  <para style="m">
    <verse number="15" style="v" sid="NEH 7:15"/>ቢኑያ ያራቱ 648.<verse eid="NEH 7:15"/></para>
  <para style="m">
    <verse number="16" style="v" sid="NEH 7:16"/>በባያ ያራቱ 628.<verse eid="NEH 7:16"/></para>
  <para style="m">
    <verse number="17" style="v" sid="NEH 7:17"/>አዝጋዳ ያራቱ 2,322.<verse eid="NEH 7:17"/></para>
  <para style="m">
    <verse number="18" style="v" sid="NEH 7:18"/>አዶንቃማ ያራቱ 667.<verse eid="NEH 7:18"/></para>
  <para style="m">
    <verse number="19" style="v" sid="NEH 7:19"/>ብግዋያ ያራቱ 2,067.<verse eid="NEH 7:19"/></para>
  <para style="m">
    <verse number="20" style="v" sid="NEH 7:20"/>አዲና ያራቱ 655.<verse eid="NEH 7:20"/></para>
  <para style="q3">
    <verse number="21" style="v" sid="NEH 7:21"/>ህዝቂያሳ ያራ ግዴዳ አጼራ ያራቱ 98.<verse eid="NEH 7:21"/></para>
  <para style="m">
    <verse number="22" style="v" sid="NEH 7:22"/>ሀሹማ ያራቱ 328.<verse eid="NEH 7:22"/></para>
  <para style="m">
    <verse number="23" style="v" sid="NEH 7:23"/>በጻያ ያራቱ 324.<verse eid="NEH 7:23"/></para>
  <para style="m">
    <verse number="24" style="v" sid="NEH 7:24"/>ሀሪፋ ያራቱ 112.<verse eid="NEH 7:24"/></para>
  <para style="m">
    <verse number="25" style="v" sid="NEH 7:25"/>ጋባኦና ያራቱ 95.<verse eid="NEH 7:25"/></para>
  <para style="q3">
    <verse number="26" style="v" sid="NEH 7:26"/>ቤተሌመነ ናጾፋ ካታማቱዋ አሳይ 188.<verse eid="NEH 7:26"/></para>
  <para style="m">
    <verse number="27" style="v" sid="NEH 7:27"/>አናቶታ ካታማ አሳይ 128.<verse eid="NEH 7:27"/></para>
  <para style="q3">
    <verse number="28" style="v" sid="NEH 7:28"/>ቤት-አዝማዌቱዋ ካታማ አሳይ ኦይታማነ ላኡዋ።<verse eid="NEH 7:28"/></para>
  <para style="q3">
    <verse number="29" style="v" sid="NEH 7:29"/>ቅርያት-ይኣሪማ፥ ካፊራነ ባኤሮታ ካታማቱዋ አሳይ 743.<verse eid="NEH 7:29"/></para>
  <para style="m">
    <verse number="30" style="v" sid="NEH 7:30"/>ራማነ ገባአ ካታማቱዋ አሳይ 621.<verse eid="NEH 7:30"/></para>
  <para style="m">
    <verse number="31" style="v" sid="NEH 7:31"/>ምክማሳ ካታማ አሳይ 122.<verse eid="NEH 7:31"/></para>
  <para style="m">
    <verse number="32" style="v" sid="NEH 7:32"/>ቤቴለነ አታ ካታማቱዋ አሳይ 123.<verse eid="NEH 7:32"/></para>
  <para style="m">
    <verse number="33" style="v" sid="NEH 7:33"/>ላኤን ናቦ ጌተትያ ካታማ አሳይ 52.<verse eid="NEH 7:33"/></para>
  <para style="m">
    <verse number="34" style="v" sid="NEH 7:34"/>ላኤን ኤላማ ያራቱ 1,254.<verse eid="NEH 7:34"/></para>
  <para style="m">
    <verse number="35" style="v" sid="NEH 7:35"/>ሀሪማ ካታማ አሳይ 320.<verse eid="NEH 7:35"/></para>
  <para style="m">
    <verse number="36" style="v" sid="NEH 7:36"/>ያርኮ ካታማ አሳይ 345.<verse eid="NEH 7:36"/></para>
  <para style="q3">
    <verse number="37" style="v" sid="NEH 7:37"/>ሎዳ፥ ሀዲዳነ ኦኖ ካታማቱዋ አሳይ 721.<verse eid="NEH 7:37"/></para>
  <para style="m">
    <verse number="38" style="v" sid="NEH 7:38"/>ሳናአ ካታማ አሳይ 3,930.<verse eid="NEH 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NEH 7:39"/>ሀዋፐ ካልያዋንቱ ኦሞዱዋፐ ስሜዳ ቄሳቱ ዋ:</para>
  <para style="m" vid="NEH 7:39">ኢያሱ ያራ ግዴዳ ያዳያ ያራቱ 973፤<verse eid="NEH 7:39"/></para>
  <para style="m">
    <verse number="40" style="v" sid="NEH 7:40"/>እሜራ ያራቱ 1,052፤<verse eid="NEH 7:40"/></para>
  <para style="m">
    <verse number="41" style="v" sid="NEH 7:41"/>ፓሽሁራ ያራቱ 1,247፤<verse eid="NEH 7:41"/></para>
  <para style="m">
    <verse number="42" style="v" sid="NEH 7:42"/>ሀሪማ ያራቱ 1,017.<verse eid="NEH 7:42"/></para>
  <para style="b"/>
  <para style="m">
    <verse number="43" style="v" sid="NEH 7:43"/>ሀዋፐ ካልያዋንቱ ኦሞዱዋፐ ስሜዳ ሌዋቱዋ:</para>
  <para style="m" vid="NEH 7:43">ሆዳዊያ ያራ ግዴዳ ኢያሱነ ቃድምኤላ ያራቱ 74፤ <verse eid="NEH 7:43"/><verse number="44" style="v" sid="NEH 7:44"/>አሳፋ ያራ ግዴዳ ማዝሙርያ የጽያዋንቱ 148፤ <verse eid="NEH 7:44"/><verse number="45" style="v" sid="NEH 7:45"/>ጌሻ ጎልያ ፐንግያ ናግያ</para>
  <para style="q2" vid="NEH 7:45">ሻሉማ፥ አጼራ፥ ጻልሞና፥ አቁባ፥ ሀጺጻነ ሾባያ ያራቱ 138.<verse eid="NEH 7:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="NEH 7:46"/>ሀዋንቱ ኦሞዱዋፐ ስሚደ፥</para>
  <para style="q2" vid="NEH 7:46">ጌሻ ጎልያን ኦያ ቆማቱዋ ያራቱዋ:</para>
  <para style="m" vid="NEH 7:46">ጺሀ ያራቱዋ፥ ሀሱፋ ያራቱዋ፥ ጻባኦታ ያራቱዋ፥ <verse eid="NEH 7:46"/><verse number="47" style="v" sid="NEH 7:47"/>ቄሮሳ ያራቱዋ፥ ሲአ ያራቱዋ፥ ፓዶና ያራቱዋ፥ <verse eid="NEH 7:47"/><verse number="48" style="v" sid="NEH 7:48"/>ላባና ያራቱዋ፥ ሀጋባ ያራቱዋ፥ ሻልማያ ያራቱዋ፥ <verse eid="NEH 7:48"/><verse number="49" style="v" sid="NEH 7:49"/>ሀናና ያራቱዋ፥ ግዴላ ያራቱዋ፥ ጋሃራ ያራቱዋ፥ <verse eid="NEH 7:49"/><verse number="50" style="v" sid="NEH 7:50"/>ራኣያ ያራቱዋ፥ ራጺና ያራቱዋ፥ ናቆዳ ያራቱዋ፥ <verse eid="NEH 7:50"/><verse number="51" style="v" sid="NEH 7:51"/>ጋዛማ ያራቱዋ፥ ኡዛ ያራቱዋ፥ ፓሴሀ ያራቱዋ፥ <verse eid="NEH 7:51"/><verse number="52" style="v" sid="NEH 7:52"/>በሳያ ያራቱዋ፥ መኡኒማ ያራቱዋ፥ ናፉሸሲማ ያራቱዋ፥ <verse eid="NEH 7:52"/><verse number="53" style="v" sid="NEH 7:53"/>ባቅቡቃ ያራቱዋ፥ ሀቁፋ ያራቱዋ፥ ሀርሁራ ያራቱዋ፥ <verse eid="NEH 7:53"/><verse number="54" style="v" sid="NEH 7:54"/>ባጽሊታ ያራቱዋ፥ ማሂዳ ያራቱዋ፥ ሀርሻ ያራቱዋ፥ <verse eid="NEH 7:54"/><verse number="55" style="v" sid="NEH 7:55"/>ባርቆሳ ያራቱዋ፥ ስሳራ ያራቱዋ፥ ተማሀ ያራቱዋ፥ <verse eid="NEH 7:55"/><verse number="56" style="v" sid="NEH 7:56"/>ናጺሀ ያራቱዋነ ሀጺፋ ያራቱዋ።<verse eid="NEH 7:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="NEH 7:57"/>ሀዋፐ ካልያዋንቱ ኦሞዱዋፐ ስሜዳ ሶሎሞነ ቆማቱዋ ያራቱዋ:</para>
  <para style="m" vid="NEH 7:57">ሶጻያ ያራቱዋ፥ ሶፈሬታ ያራቱዋ፥ ፓሪዳ ያራቱዋ፥ <verse eid="NEH 7:57"/><verse number="58" style="v" sid="NEH 7:58"/>ያእላ ያራቱዋ፥ ዳርቆና ያራቱዋ፥ ግዴላ ያራቱዋ፥ <verse eid="NEH 7:58"/><verse number="59" style="v" sid="NEH 7:59"/>ሻፋጽያ ያራቱዋ፥ ሀጺላ ያራቱዋ፥ ፖከረት-ሀጻባይማ ያራቱዋነ አሞና ያራቱዋ።<verse eid="NEH 7:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="NEH 7:60"/>ኦሞዱዋፐ ስሚደ፥ ጌሻ ጎልያን ኦያ ቆማቱዋ ያራቱነ ሶሎሞነ ቆማቱዋ ያራቱ ፓይዱ ኡባና 392.<verse eid="NEH 7:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="NEH 7:61"/>ሀራቱካ ቃይ፥ ተልመላሀ፥ ተልሀርሻ፥ ካሩባ፥ አዶናነ እሜራ ጌተትያ ካታማቱዋፐ የሩሳላመ ስሜድኖ። ሽን ኡንቱንቱ ዎይ ኡንቱንቱ አዎቱ እስራኤልያ ሼሻ ግድያዋ ኤርሳናዉ ዳንዳይበይክኖ። <verse eid="NEH 7:61"/><verse number="62" style="v" sid="NEH 7:62"/>ሄዋንቱ ዳላያ፥ ጾቢያነ ናቆዳ ያራቱዋ፤ ኡንቱንቱ ፓይዱካ ኡባና 642.<verse eid="NEH 7:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="NEH 7:63"/>ቄሳቱ ዋፐ ቃይ ሆባያ ያራቱ፥ ሀቆጻ ያራቱነ ባርዝላያ ያራቱ የሩሳላመ ስሜድኖ። ሀዌ ባርዝላያ ግያዌ ጋላኣደ ቢታ አሳ ግዴዳ ባርዝላያ ናቶ አኪደ፥ ባረ ቦሉዋ ሱን አኬዳ። <verse eid="NEH 7:63"/><verse number="64" style="v" sid="NEH 7:64"/>ሀዋንቱ ባረንቱ የለታ ጻጱዋ ኤራናዉ የለታ ማጻፋን ኮዬድኖ፥ ሽን ደምቤይክኖ። ሄዋ ድራዉ፥ ኡንቱንቱ ቱናዳን ፓይደቲደ፥ ቄሰተን ኦናዳን ድገቴድኖ። <verse eid="NEH 7:64"/><verse number="65" style="v" sid="NEH 7:65"/>ቃይ ጌሻ ሳማቱዋን ሻክ ፕርድያ ቄሲ ደንዳና ጋካናዉ፥ ኡንቱንቱ ጌሻ ቁማፐ ማናዉ ዳንዳየናዋ አይሁዳቱዋ ሞድያዌ ኡንቱንቶ ኦዴዳ።<note caller="-" style="x"><char style="xo" closed="false">7:65 </char><char style="xt" closed="false"><ref loc="EXO 28:30">ከሳ 28:30</ref>፤ <ref loc="DEU 33:8">ዛረ. 33:8</ref></char></note><verse eid="NEH 7:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="NEH 7:66"/>ኦሞዱዋፐ ይሁዳ ቢታ ስሜዳ አሳ ፓይዱ ኡባና 42,360. <verse eid="NEH 7:66"/><verse number="67" style="v" sid="NEH 7:67"/>ሄዋ ቦላካ ቃይ 7,337 አቱማ ቆማቱነ ማጫ ቆማቱ ማዝሙርያ የጽያ 245 አቱማዋነ ማጫ አሳቱ ስሜድኖ። <verse eid="NEH 7:67"/><verse number="68" style="v" sid="NEH 7:68"/>ኦሞዱዋፐ ኡባና ስሜዳ አሳ ፓራቱዋ ፓይዱ 736፤ ባቁሎቱ 245፤ <verse eid="NEH 7:68"/><verse number="69" style="v" sid="NEH 7:69"/>ጋሎቱ 435፤ ሀረቱ ቃይ 6,720.<verse eid="NEH 7:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="NEH 7:70"/>ያራቱዋ ካፓቱዋፐ አማሬዳዋንቱ ኦሶ እሞታ እሜድኖ። ቢታ ሞድያዌ ሆስፑን ኪሎ ግራመ ዎርቃ፥ 50 ድስተቱዋነ 530 ቄሳቱዋ ማዮቱዋ እሜዳ። <verse eid="NEH 7:70"/><verse number="71" style="v" sid="NEH 7:71"/>ያራቱዋ ካፓቱ 168 ኪሎ ግራመ ዎርቃነ 1,250 ኪሎ ግራመ ብራ እሜድኖ። <verse eid="NEH 7:71"/><verse number="72" style="v" sid="NEH 7:72"/>አቴዳ አሳይ ኡባና 168 ኪሎ ግራመ ዎርቃ፥ 1,100 ኪሎ ግራመ ብራነ 67 ቄሳቱዋ ማዮቱዋ እሜድኖ።<verse eid="NEH 7:72"/></para>
  <para style="p">
    <verse number="73" style="v" sid="NEH 7:73"/>ሄዋፐ ጉይያን ቄሳቱ፥ ሌዋቱ፥ ፐንግያ ናግያዋንቱ፥ ማዝሙርያ የጽያዋንቱ፥ አሳፐ ዳሮቱነ ጌሻ ጎልያ ቆማቱ፥ ኡባና እስራኤልያ ኡባይ ባረንቱ ካታማን ካታማን ኡቴድኖ።<note caller="-" style="x"><char style="xo" closed="false">7:73 </char><char style="xt" closed="false"><ref loc="1CH 9:2">1 ኦዱዋ 9:2</ref>፤ <ref loc="NEH 11:3">ናህ. 11:3</ref></char></note><verse eid="NEH 7:73"/></para>
  <chapter eid="NEH 7"/>
  <chapter number="8" style="c" sid="NEH 8"/>
  <para style="s1">ሙሴ ህጊ ዛረ ናባበቱሳነ ቃላ ጫቁዋ ኦራጹሳ</para>
  <para style="r">(<ref loc="NEH 8:1-10:39">8:1—10:39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 8:1"/>ላፑን አግናይ ጋኮ ዎደ፥ እስራኤልያ አሳይ ኡባይካ ባረንቱ ካታማን ካታማን ኡቴድኖ። ሄ አግናን ኡንቱንቱ ኡባይካ እትፐ ሃ ፐንግያ ስንን ደእያ ዳባባን ሺቄድኖ። መና ጎዳይ ሙሴ ባጋና እስራኤልያ አሳዉ እሜዳ ህግያ ማጻፋ አሀና ማላ፥ ጻፍያ እዝራ ኦቼድኖ። <verse eid="NEH 8:1"/><verse number="2" style="v" sid="NEH 8:2"/>ያትና፥ ላፑን አግናን ኮይሮ ጋላሳን፥ አቱማዌ ማጫዌ፥ አኬካናዉ ዳንዳይያ አሳይ ኡባይ ሺቄዳ ሳኣን እዝር ህግያ ማጻፋ አሄዳ። <verse eid="NEH 8:2"/><verse number="3" style="v" sid="NEH 8:3"/>ሃ ፐንግያ ስንን ደእያ ዳባባን ኤቂደ፥ አቱማዎ ማጫዎ፥ አኬካናዉ ዳንዳይያ አሳ ኡባዉ ህግያ ማጻፋ ዎንታፐ ጋላሳ ሴታይ ጋካናዉ ናባቤዳ፤ አሳይካ ሎይ ሀይዚደ ስሴዳ።<verse eid="NEH 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 8:4"/>እዝር ኤቂደ ናባባናዉ ምፐ ጊግሴዳ ጉታራ ቦላን ኤቄዳ። አፐ ኡሸቻ ባጋና ማቲትያ፥ ሻማእያ፥ አናያ፥ ኦርዮና፥ ህልቂያነ ማእሴያ ጌተትያ አሳቱ ኤቄድኖ። ሀድርሳ ባጋና ቃይ ፓዳያ፥ ምሻኤላ፥ ማልክያ፥ ሀሹማ፥ ሀሽባዳናሀ፥ ዛካራሳነ ማሹላማ ጌተትያ አሳቱ ኤቄድኖ።<verse eid="NEH 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NEH 8:5"/>እዝር አሳ ኡባፐ ቂያ ሳኣን ኤቄዳ ድራዉ፥ ኡባይካ አ ሎይደ ጼልሽን፥ ኡንቱንቱ ስንን ህግያ ማጻፋ ዶዬዳ። ሄ ዎደ ኡንቱንቱ ኡባይ ኡቴዳ ሳፐ ደንድ ኤቄድኖ። <verse eid="NEH 8:5"/><verse number="6" style="v" sid="NEH 8:6"/>እዝር መና ጎዳ፥ ዎልቃማ ጾሳ ጋላቴዳ። አሳይ ኡባይ ባረንቱ ኩሽያ ፑደ ደንደ፥ “አመንእ፥ አመንእ” ያጌድኖ። ቃይ ኡንቱንቱ ሶምእ ሳኣ ቦቻና ጋካናዉ ጉፋኒደ፥ መና ጎዳዉ ጎይኔድኖ።<verse eid="NEH 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NEH 8:7"/>ሄዋፐ ጉይያን ደንዲደ፥ ባረንቱ ደእያ ሳኣን ኤቄድኖ። ኢያሳ፥ ባና፥ ሸረብያ፥ ያሚና፥ አቁባ፥ ሻባታያ፥ ሆድያ፥ ማእሴያ፥ ቃሊጻ፥ አዛርያ፥ ዮዛባዳ፥ ሀናናነ ፓላያ ጌተትያ ሌዋቱ ህግያ አሳይ አኬካናዳን ኦድኖ። <verse eid="NEH 8:7"/><verse number="8" style="v" sid="NEH 8:8"/>ኡንቱንቱ ጾሳ ህግያ ማጻፋፐ ናባቢደ፥ ቃይ ናባበቴዳዌ ዋግንቶ፥ አሳይ ኤራና ማላ፥ ብል ቆንጭሴድኖ።<verse eid="NEH 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 8:9"/>አሳይ ህግያ ቃላ ስሴዳ ዎደ፥ ባረንቱ ዎዛናን ምሸቲደ ዬኬድኖ። ሄዋ ድራዉ፥ ቢታ ሞድያ ናህሚ፥ ቄሰነ ጻፍያ ግዴዳ እዝርነ አሳዉ ማጻፋ ብልያ ሌዋቱ አሳ ሀዋዳን ያጌድኖ፤ “ሀ ጋላሳይ መና ጎዳዉ፥ ህንተንቱ ጾሳዉ፥ ጌሻ ጋላሳ ግድያ ድራዉ፥ እቱነ ካዮቶፕተነ ዬኮፕተ” ያጌድኖ።<verse eid="NEH 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 8:10"/>ቃይ ናህሚ ጉጂደካ ሀዋዳን ያጌዳ፤ “ቢተ፥ ሞዋ ሚተ፤ ማልእያዋካ ኡሽተ፤ ቃይ ባይናዋንቶካ ህንተዋፐ ሻክ እምተ። አያዉ ጎፐ፥ ሀቼ ጋላሳይ ኑ ጾሳዉ ጌሻ ጋላሳ። መና ጎዳ ናሸቻይ ህንተንቶ ዎልቃ ግድያ ድራዉ ካዮቶፕተ” ያጌዳ።<verse eid="NEH 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NEH 8:11"/>ሌዋቱካ ቃይ፥ “ሀዌ ጌሻ ጋላሳ ግድያ ድራዉ፥ ካዮቶፕተ፤ ሀይዝተ” ያጊደ አሳ ጮኡ ኦድኖ። <verse eid="NEH 8:11"/><verse number="12" style="v" sid="NEH 8:12"/>ሄዋፐ ጉይያን፥ አሳይ ናሸቻን ማናዉነ ኡሻናዉ ቃይ ባይናዋንቶካ ዴእያዋፐ ሻክ እማናዉ ቤድኖ። አያዉ ጎፐ፥ ኡንቱንቱ ኦዴዳ ቃላ ስሴድኖነ አኬኬድኖ።<verse eid="NEH 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NEH 8:13"/>አግናዉ ላኤን ጋላስ ዛራቱዋ ካፓቱ፥ ቄሳቱ ነ ሌዋቱ ህግያ ቃላ ኡንቱንቶ ብርሻና ማላ፥ እዝራኮ ዬድኖ። <verse eid="NEH 8:13"/><verse number="14" style="v" sid="NEH 8:14"/>ሄዋን ታማሪደ፥ ላፑን አግናን ዳስያ ባላ ቦንችያ ዎደ፥ እስራኤልያ አሳይ ኡባይ ዳስያ ግዶን ኡታናዳን መና ጎዳይ ሙሴ ባጋና አዛዜዳዋ አኬኬድኖ።<note caller="-" style="x"><char style="xo" closed="false">8:14-15 </char><char style="xt" closed="false"><ref loc="LEV 23:33-36">ዎጋ 23:33-36</ref>፣ <ref loc="LEV 23:39-43">39-43</ref>፤ <ref loc="DEU 16:13-15">ዛረ. 16:13-15</ref></char></note> <verse eid="NEH 8:14"/><verse number="15" style="v" sid="NEH 8:15"/>ሄዋ ድራዉ፥ ካታማቱዋ ኡባንነ የሩሳላመን ሀዋዳን ያጊደ አዋዬድኖ፤ “ደርያ ሁጲያ ከስተ፤ ዛይትያ ዎጋራፐ፥ ዎራን ዶልያ ዎጋራፐ፥ ባርሴነትያ ምፐ፥ ዛምባ ምፐነ ሀይይ ደእያ ም ኡባፐ ህግያን ጻፈቴዳዋዳን፥ ዳስያ ዳሳናዉ ታሽያ አህተ” ያጌድኖ።<verse eid="NEH 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NEH 8:16"/>ሄዋ ድራዉ፥ አሳይ ቢደ ም ታሽያ አሄድኖ፤ ባረንቱ ጎልያ ቦላን ደእያ ደምባ ሳኣን፥ ባረንቱ ግቢያን፥ ጾሳ ጌሻ ጎልያ ዳባባን፥ ሃ ፐንግያ ዳባባንነ ኤፍሬማ ፐንግያ ዳባባን ዳስያ ዳሴድኖ። <verse eid="NEH 8:16"/><verse number="17" style="v" sid="NEH 8:17"/>ኦሞዱዋፐ ስሜዳ አሳይ ኡባይ ዳስያ ዳሴዳ፥ አ ግዶን ኡቴድኖ። ነዌ ናኣ ኢያሱ ዎድያፐ ዶሚደ፥ ሄ ጋላሳይ ጋካናዉ፥ ኡንቱንቱ ሀዋ ማላ ባላ ቦንች ኤርክኖ። ሄዋ ድራዉ፥ ኡባይካ ሎይ ናሸቴድኖ። <verse eid="NEH 8:17"/><verse number="18" style="v" sid="NEH 8:18"/>ባላይ ዶመቶደፐ ቢደ ዉራና ጋካናዉ፥ ሀቼ ሀቼ እዝር ጾሳ ህግያ ማጻፋፐ አሳዉ ናባቤዳ። ባላ ላፑን ጋላሳ ቦንቾዋፐ ጉይያን፥ ሆስፑን ጋላሳን ህጊ አዛዝያዋዳን ጌሻ ሽቁዋ ኦድኖ።<verse eid="NEH 8:18"/></para>
  <chapter eid="NEH 8"/>
  <chapter number="9" style="c" sid="NEH 9"/>
  <para style="s1">እስራኤልያ አሳይ ባረንቱ ናጋራ ፓጼድኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 9:1"/>ሄ አግናን ላታማነ ኦይደን ጋላሳን እስራኤልያ አሳይ ጾሚደ፥ ማቃ ማዪደነ ባረንቱ ሁጲያን ባና ቆሊደ፥ እት ሳኣ ሺቄድኖ። <verse eid="NEH 9:1"/><verse number="2" style="v" sid="NEH 9:2"/>ባረንታ አላጋ ጋደ አሳ ኡባፐ ሻኬድኖ። ሄዋፐ ጉይያን ደንድ ኤቂደ፥ ኡንቱንቱነ ካሰ ኡንቱንቱ አዎቱ ኦዳ ናጋራ ኡባ ፓጼድኖ። <verse eid="NEH 9:2"/><verse number="3" style="v" sid="NEH 9:3"/>ሄዋን ኡንቱንቱ ኤቂደእሽን፥ ሄዙ ሳትያ ግድያዋ መና ጎዳ ኡንቱንቱ ጾሳ ህግያ ማጻፋይ ኡንቱንቶ ናባበቴዳ። ቃይ ሀራ ሄዙ ሳትያ ግድያዋ ባረንቱ ናጋራ ፓጺድነ መና ጎዳዉ፥ ባረንቱ ጾሳዉ፥ ጎይኒደ ጋምኤድኖ።<verse eid="NEH 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 9:4"/>ሌዋቱዋፐ አማሬዳዋንቱ ሽቁዋ ቦላን ከሲደ፥ ኮሻ ቁ ኦደ መና ጎዳኮ፥ ባረንቱ ጾሳኮ፥ ዋሴድኖ። ሄዋንቱካ ኢያሳ፥ ባና፥ ቃድምኤላ፥ ሻባንያ፥ ቡና፥ ሸረብያ፥ ባናነ ካናና።<verse eid="NEH 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NEH 9:5"/>ሌዋቱዋፐ ኢያሱ፥ ቃድምኤል፥ ባን፥ ሀሻባኔ፥ ሸረቤ ሆዴ፥ ሻባነነ ፓታሄ እስራኤልያ አሳ ሀዋዳን ያጌድኖ፤ “ደንድ ኤቂደ፥ መናፐ መናዉ ደእያ መና ጎዳ ህንተንቱ ጾሳ ጋላትተ! ኡባፐነ ሳባ ኡባ ቦላና ቁ ቁ ጌዳነ ቦንቼቴዳ ጾሳ ሱን ሳቢተ” ያጌድኖ።<verse eid="NEH 9:5"/></para>
  <para style="s1">ናጋራ ፓጽያ ዎሳ</para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 9:6"/>ሄዋፐ ጉይያን፥ እስራኤልያ አሳይ ሀዋዳን ያጊደ ዎሴድኖ፤ “መና ጎዳዉ፥ ነ ጻላላይ ጾሳ! ኔን ሳሎቱዋነ ሳሎቱዋን ደእያ መታ ኡባ፥ ሳኣነ አ ቦላን ደእያ መታ ኡባነ አባቱዋነ ኡንቱንቱ ግዶን ደእያ መታ ኡባ መዳ፤ ኡባዉ ሸምፑዋ እማዳ። ሳሉዋ መታቱ ኡባይ ነዉ ጎይኒኖ።<verse eid="NEH 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NEH 9:7"/>“ኔን መታ ኡባ ጎዳ! ኔን አብራማ ኡራ ጌተትያ ካላዳዋቱ ካታማፐ ዶራደ ከሳዳ፤ አ ሱንካ ላማደ፥ አብራሃማ ያጋደ ሱንዳ።<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="GEN 11:31">ዶመ 11:31</ref>፤ <ref loc="GEN 12:1">12:1</ref>፤ <ref loc="GEN 17:5">17:5</ref></char></note> <verse eid="NEH 9:7"/><verse number="8" style="v" sid="NEH 9:8"/>እ ነዉ አማነትያ አሳ ግድያዋ በኣደ፥<note caller="-" style="x"><char style="xo" closed="false">9:8 </char><char style="xt" closed="false"><ref loc="GEN 15:18-21">ዶመ 15:18-21</ref></char></note> ካናነቱ፥ ሂተቱዋ፥ አሞራዋናቱዋ፥ ፓርዛዋናቱዋ፥ ያቡሳቱዋነ ገርጌሳቱዋ ጋድያ አ ዛረቶ ላታ ጋድያ ኦደ እማናዉ አዉ ቃላ ጫቁዋ ገላዳ። ኔን ጽሎ ግድያ ድራዉ፥ ነ ጌዳ ቃላካ ፖላዳ።<verse eid="NEH 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 9:9"/>“ኔን ካሰ ኑ ማይዛ አዎቱዋ ግብጼ ጋድያን ጋኬዳ ቱጋ በኣዳ፤<note caller="-" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="EXO 3:7">ከሳ 3:7</ref>፤ <ref loc="EXO 14:10-12">14:10-12</ref></char></note> ቃይ ዞኦ አባ ጌተትያ አባ ማታን ደኢደ ኡንቱንቱ፥ ‘ኑና ማዳርኪ!’ ያጊደ ዋሴዳ ዋሱዋካ ስሳዳ። <verse eid="NEH 9:9"/><verse number="10" style="v" sid="NEH 9:10"/>ግብጼ ካቲ፥ አ ጋድያ ካፓቱነ ሄ ጋድያ አሳይ ኡባይ እስራኤልያ አሳ ቦላን ኦቶረቴዳ ድራዉ፥ ኡንቱንቱ ቦላን ማላታነ ማላልስያባ ኦዳ።<note caller="-" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="EXO 7:8-12:32">ከሳ 7:8—12:32</ref></char></note> ሄዋፐ ደንዴዳዋን፥ ሀቼ ጋካናዉ፥ ነ ሱንይ ቦንቹዋን ጼገታናዳን ኦዳ። <verse eid="NEH 9:10"/><verse number="11" style="v" sid="NEH 9:11"/>አባ ያነ ሃነ ሻካደ፥ ግዱዋና ነ አሳ መላ ቢታና ፕንዳ። ሽን ሹቻይ ጪሞ ሃን ኦልና፥ ጪሙዋ ዱገ ዎያዋዳን፥ ኡንቱንቱ የደርስያ ሞርከቱዋ አባን ምትሳደ ይሳዳ።<note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="EXO 14:21-29">ከሳ 14:21-29</ref>፤ <ref loc="EXO 15:4-5">15:4-5</ref></char></note> <verse eid="NEH 9:11"/><verse number="12" style="v" sid="NEH 9:12"/>እስራኤልያ አሳ ጋላስ ሻርያ ቱሳን ካለደ፥ ቃማ ቃይ ኡንቱንቱ ሀመትያ ኦግያን ፖአና ማላ፥ ታማ ቱሳ ኡንቱንቱ ስንን ኤሳደ ካለዳ።<note caller="-" style="x"><char style="xo" closed="false">9:12 </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">ከሳ 13:21-22</ref></char></note><verse eid="NEH 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NEH 9:13"/>“ኔን ሳሉዋፐ ዎደ፥ ነ አሳ ሲና ደርያ ቦላን ሃሳይሳዳ። ሱረ ፕርዳነ ቱማ ግዴዳ ህግያ ቃይ ሎኦ ዎጋነ አዛዙዋ ኡንቱንቶ እማዳ።<note caller="-" style="x"><char style="xo" closed="false">9:13-14 </char><char style="xt" closed="false"><ref loc="EXO 19:18-23:33">ከሳ 19:18—23:33</ref></char></note> <verse eid="NEH 9:13"/><verse number="14" style="v" sid="NEH 9:14"/>ጌሻ ነ ሳምባታ ኡንቱንቱ ቦንቻና ማላ፥ ኡንቱንታ ታማርሳዳ። ነ ቆማ ሙሴ ባጋና ኡንቱንቶ አዛዙዋ፥ ዎጋነ ህግያ እማዳ። <verse eid="NEH 9:14"/><verse number="15" style="v" sid="NEH 9:15"/>ኡንቱንቱ ኮሻቴዳ ዎደ ሳሉዋፐ ቁማ እማዳ፤ ቃይ ኡንቱንቱ ሳመቴዳ ዎደ ዛላፐ ሃ ፑልትሳዳ። ኔን ኡንቱንቶ እማናዉ ጫቄዳ ጋድያ ገሊደ ላታና ማላ አዛዛዳ።<note caller="-" style="x"><char style="xo" closed="false">9:15 </char><char style="xt" closed="false"><ref loc="EXO 16:4-15">ከሳ 16:4-15</ref>፤ <ref loc="EXO 17:1-7">17:1-7</ref>፤ <ref loc="DEU 1:21">ዛረ. 1:21</ref></char></note><verse eid="NEH 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NEH 9:16"/>“ሽን ኑ ማይዛ አዎቱ ኦቶረቴድኖ። ኦድና ስሰና ሞርግያ ኦርዶ ግዲደ፥ ነዉ አዛዘትበይክኖ።<note caller="-" style="x"><char style="xo" closed="false">9:16-17 </char><char style="xt" closed="false"><ref loc="NUM 14:1-4">ፓይ. 14:1-4</ref>፤ <ref loc="DEU 1:26-33">ዛረ. 1:26-33</ref></char></note> <verse eid="NEH 9:16"/><verse number="17" style="v" sid="NEH 9:17"/>አዛዘተናን እጼድኖ፤ ቃይ ኔን ኡንቱንቶ ኦዳ ማላልስያባ ኡባ ሀሳይበይክኖ።<note caller="-" style="x"><char style="xo" closed="false">9:17 </char><char style="xt" closed="false"><ref loc="EXO 34:6">ከሳ 34:6</ref>፤ <ref loc="NUM 14:18">ፓይ. 14:18</ref></char></note> ኡንቱንቱ ሞርግያ ኦርዶ ግዴድኖ፤ ቃይ ባረንቱ ማካላፐ ደንዴዳዋን፥ ግብጼ ጋድያ ጉየ አይለተዉ ዛሪደ ካለና ማላ፥ ካፑዋ ባረንቶ ዶሬድኖ። ግዶ ሽን፥ ኔን አቶ ግያ ጾሳ፤ ኬካነ ማርያዋ። ሲቁዋን ኩሜዳዋነ ሀንቆ ኤሌለናዋ። ሄዋ ድራዉ፥ ነ ሲቁ መናሳ፤ ኔን ኡንቱንታ አጋ በይካ።<verse eid="NEH 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NEH 9:18"/>“ኡንቱንቱ ማራ ማላትያ ኤቃ መደ፥ ‘ህንተና ግብጼ ጋድያፐ ከሴዳ ህንተንቱ ጾሳይ ሀዋ’ ያጊደ ኔና ዎልቃማ ሸቃ ሸቆፐካ፥<note caller="-" style="x"><char style="xo" closed="false">9:18 </char><char style="xt" closed="false"><ref loc="EXO 32:1-4">ከሳ 32:1-4</ref></char></note> <verse eid="NEH 9:18"/><verse number="19" style="v" sid="NEH 9:19"/>ነ ዳሮ ማሮተ ድራዉ፥ ኔን ኡንቱንታ ሄ ጋድያ ዎራን አጋ በይካ። ኡንቱንቱ ብያ ኦግያ ካለና ማላ፥ ጋላስ ሻርያ ቱሳይ፥ ቃይ ኡንቱንቱ ኦግያ ፖእሳና ማላ፥ ቃማ ታማ ቱሳይ ኡንቱንቱፐ ሃክቤና።<note caller="-" style="x"><char style="xo" closed="false">9:19-21 </char><char style="xt" closed="false"><ref loc="DEU 8:2-4">ዛረ. 8:2-4</ref></char></note> <verse eid="NEH 9:19"/><verse number="20" style="v" sid="NEH 9:20"/>ኡንቱንታ ታማርሳና ማላ፥ ነ ሎኦ አያና ኡንቱንቶ እማዳ። ማናዉ ማና ኡንቱንቱ ዶናፐ ፓጭሳበይካ፤ ቃይ ኡንቱንቱ ሳሞካ ሃ እማዳ። <verse eid="NEH 9:20"/><verse number="21" style="v" sid="NEH 9:21"/>ኦይታሙ ላይ ኡባ ኡንቱንቱ ዎራን ሀመትያ ዎደ፥ ኡንቱንቶ ኮሽያባፐ እትባነ ይሳባካ። ኡንቱንቱ ማዩ ዉርቤና፤ ኡንቱንቱ ገዲካ ጋፍቤና።<verse eid="NEH 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NEH 9:22"/>“ባረንቱ ዛዋን ደእያ ጋጻ ቢታቱዋነ ካዉተቱዋ ኡንቱንቱ ጾኒደ ኦይቃናዳን ኦዳ።<note caller="-" style="x"><char style="xo" closed="false">9:22 </char><char style="xt" closed="false"><ref loc="NUM 21:21-35">ፓይ. 21:21-35</ref></char></note> ስሆና ጌተትያ ካቲ ሞድያ ሀሰቦና ጋድያነ ኦጋ ጌተትያ ካቲ ሞድያ ባሳነ ጋድያ ኡንቱንቱ ላቴድኖ። <verse eid="NEH 9:22"/><verse number="23" style="v" sid="NEH 9:23"/>ኡንቱንቱ ዘረቱዋ ፓይዱዋ ሳሉዋ ጾልንትያዳን ዳርሳዳ።<note caller="-" style="x"><char style="xo" closed="false">9:23 </char><char style="xt" closed="false"><ref loc="GEN 15:5">ዶመ 15:5</ref>፤ <ref loc="GEN 22:17">22:17</ref>፤ <ref loc="JOS 3:14-17">ኢያሳ 3:14-17</ref></char></note> ካሰ ኡንቱንቱ አዋቶ ገልሳናነ ላትሳና ጋደ ኔን ኦዴዳ ጋድያ ኡንቱንታ ገልሳዳ። <verse eid="NEH 9:23"/><verse number="24" style="v" sid="NEH 9:24"/>ኡንቱንቱ ካናነ ጋድያ ላቴድኖ፤<note caller="-" style="x"><char style="xo" closed="false">9:24 </char><char style="xt" closed="false"><ref loc="JOS 11:23">ኢያሳ 11:23</ref></char></note> ሄ ጋድያን ደእያ ካናነ አሳ ኡባ ኡንቱንቱ ስንን ኔን ካዉሻዳ። ኡንቱንቱ ካናነ አሳ ቦላን፥ ኡንቱንቱ ካተቱዋ ቦላንነ ሄ ጋድያን ደእያ አሳ ኡባ ቦላን ባረንቱ ዶሴዳዋ ኦና ማላ፥ ኡንቱንቱ ኩሽያን አ እማዳ። <verse eid="NEH 9:24"/><verse number="25" style="v" sid="NEH 9:25"/>ቃይ ኡንቱንቱ ዩሹ ግምበቴዳ ካታማቱዋነ አራዳ ቢታ ጾኒደ አኬድኖ፤<note caller="-" style="x"><char style="xo" closed="false">9:25 </char><char style="xt" closed="false"><ref loc="DEU 6:10-11">ዛረ. 6:10-11</ref></char></note> ቃይካ ሎኦባይ ኡባይ ኩሜዳ ጎልያ፥ ቦከቴዳ ሃ ኦላቱዋ፥ ዎይንያ ቱራ ሳኣ፥ ዎጋራቱዋነ ሀራ አይፍያ እምያ ዳሮ ምቱዋ ላቴድኖ። ሄዋፐ ም ካሊደ ኦርዴድኖ፤ ነ ዎልቃማ ኬካተን ኡንቱንቱ ናሸቴድኖ።<verse eid="NEH 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NEH 9:26"/>“ግዶፐካ፥ ነ አሳቱ አዛዘተናን እጺደ፥ ነ ቦላን ማካሌድኖ፤<note caller="-" style="x"><char style="xo" closed="false">9:26-28 </char><char style="xt" closed="false"><ref loc="JDG 2:11-16">ዳና. 2:11-16</ref></char></note> ነ ህግያዉካ ዞኪያ ዛሬድኖ። ኔኮ ኡንቱንቱ ስማናዳን ኡንቱንቶ ምንሲደ ኦዴዳ ትምቢትያ ኦድያዋንታ ዎድኖ። ሎይ ዎልቃማ ሸቃ ኔና ሸቄድኖ። <verse eid="NEH 9:26"/><verse number="27" style="v" sid="NEH 9:27"/>ሄዋፐ ደንዴዳዋን ኡንቱንታ ኡንኤያ ሞርከቱዋ ኩሽያን አ እማዳ፤ ሞርከቱ ኡንቱንታ ኡንኤዳ ዎደ ኔኮ ዋሴድኖ። ኡንቱንቱ ዋሱዋ ሳሉዋን ግዳ ስሳደ ነ ማሮተ ዳሩዋዳን፥ ኡንቱንታ ኡንቱንቱ ሞርከቱዋ ኩሽያፐ አሽያዋንታ ኪታዳ።<verse eid="NEH 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NEH 9:28"/>“ሽን ኡንቱንቱ ሸምፑዋ ደሚደ ዛረደ፥ ነ ስንን ናጋራ ኦድኖ። ኔንካ ዛራደ ኡንቱንቱ ሞርከቱዋ ኩሽያን አደ እምና፥ ኡንቱንቱ ሞርከቱ ኡንቱንታ ሞደድኖ። ሽን ሀእካ ኡንቱንቱ ኔኮ ዋስና፥ ኡንቱንቱ ዋሱዋ ሳሉዋን ግዳደ ስሳዳ። ነ ማሮተን ኡንቱንታ ዛራ ዛራደካ አሻ አካዳ።<verse eid="NEH 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NEH 9:29"/>“ነ ህግያኮ ኡንቱንቱ ስማና ማላ፥ ኔን ኡንቱንቶ ምንሳደ ኦዳዳ፤<note caller="-" style="x"><char style="xo" closed="false">9:29 </char><char style="xt" closed="false"><ref loc="LEV 18:5">ዎጋ 18:5</ref></char></note> ሽን ኡንቱንቱ ኦቶረቴድኖ፤ ነ አዛዙዋካ እጼዶ ያጌድኖ። አሳይ አዛዘቶፐ ደኡዋ ደምያ ነ ህግያ አድኖ፤ ቃይ ሞርግያ ኦርዶ ግድ፥ ነዉ ዞኪያ ዛሪደ፥ አዛዘተናን እጼድኖ። <verse eid="NEH 9:29"/><verse number="30" style="v" sid="NEH 9:30"/>ግዶፐነ፥ ዳሮ ላይ ኡንቱንታ ዳንዳያዳ፤<note caller="-" style="x"><char style="xo" closed="false">9:30 </char><char style="xt" closed="false"><ref loc="2KI 17:13-18">2 ካታ. 17:13-18</ref>፤ <ref loc="2CH 36:15-16">2 ኦዱዋ 36:15-16</ref></char></note> ትምቢትያ ኦድያዋንቱ ባጋና ነ አያናን ኡንቱንቶ ምንሳደ ኦዳዳ፤ ሽን ኡንቱንቱ ስስበይክኖ። ሄዋፐ ደንዴዳዋን አይሁዳ ግደና ካዉተቱ ኡንቱንታ ሞዳና ማላ፥ ኡንቱንቱ ኩሽያን አ እማዳ። <verse eid="NEH 9:30"/><verse number="31" style="v" sid="NEH 9:31"/>ሽን ኔን ኬካነ ማርያ ጾሳ ግድያ ድራዉ፥ ነ ዎልቃማ ማሮተን ኡንቱንታ ኡባና አጋበይካነ ይሳባካ።<verse eid="NEH 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NEH 9:32"/>“ኑ ጾሳዉ፥ ዎልቃማዉ፥ ዎልቃማነ ያየቴዳ ጾሳዉ፥<note caller="-" style="x"><char style="xo" closed="false">9:32 </char><char style="xt" closed="false"><ref loc="2KI 15:19">2 ካታ. 15:19</ref>፣ <ref loc="2KI 15:29">29</ref>፤ <ref loc="2KI 17:3-6">17:3-6</ref>፤ <ref loc="EZR 4:2">እዝራ 4:2</ref>፣ <ref loc="EZR 4:10">10</ref></char></note> ነ አገና ሲቁዋ ቃላ ጫቁዋ ናግያዋ፥ ኑ ቦላን ጋኬዳ መቱ ነ ስንን ላፋባ ማላቶፖ። በን አሶረ ካተቱዋ ዎድያፐ ዶሚደ፥ ሀቼ ጋካናዉ፥ ኑ ቦላን፥ ኑ ካተቱዋ ቦላን፥ ኑ ካፓቱ ቦላን፥ ኑ ቄሳቱዋ ቦላን፥ ኑ ትምቢትያ ኦድያዋንቱ ቦላን፥ ኑ ማይዛ አዎቱዋ ቦላንነ ነ አሳ ኡባ ቦላን ዎልቃማ መቱ ጋኬዳ። <verse eid="NEH 9:32"/><verse number="33" style="v" sid="NEH 9:33"/>ኑና ጋኬዳዋን ኡባን ኔን ጽሉዋ። አያዉ ጎፐ፥ ኑን ኔና ናቆፐካ ኔን አማነትያዋ አጋ በይካ። <verse eid="NEH 9:33"/><verse number="34" style="v" sid="NEH 9:34"/>ኑ ካተቱ፥ ኑ ካፓቱ፥ ኑ ቄሳቱ ነ ኑ ማይዛ አዎቱ ነ ህግያ ናግበይክኖ፤ ቃይ ኔን ኡንቱንቶ እሜዳ አዛዙዋነ ነ ምንሳ ኦዴዳዋካ ስስበይክኖ። <verse eid="NEH 9:34"/><verse number="35" style="v" sid="NEH 9:35"/>ኔን ኡንቱንቱ ካዉተን ኡንቱንቶ ዎልቃማ አንጁዋ እማዳ፤ ቃይ አኮነ ሞክያ ቢታካ ኡንቱንቶ እማዳ፤ ሽን ኡንቱንቱ ነዉ ጎይንበይክኖነ ባረንቱ ኢታ ኦሱዋፐ ስምበይክኖ።<verse eid="NEH 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NEH 9:36"/>“ሄዋፐ ደንዴዳዋን፥ ኑን ሀቼ አይልያ ግድያዋ በአ። ቃይ ሄዌካ ኡንቱንቱ አ አይፍያነ እ እምያ አንጁዋ ኡባ ማና ማላ፥ ኑ ማይዛ አዋቶ ኔን እሜዳ ሄ ጋድያን፥ ኑን አይልያ ግዴዶ። <verse eid="NEH 9:36"/><verse number="37" style="v" sid="NEH 9:37"/>ኑ ናጋራ ድራዉ፥ ኔን ኑ ቦላን ደንዳ ካተቱ ጋድያ አንጁዋ ኡባ ኡንቱንቱ ጎኤቲኖ። ቃይ ኑ ቦላንነ ኑ መህያ ቦላን ባረንቱ ኮዬዳዋ ኦኖ፤ ኑንካ ዎልቃማ መቱዋ ግዶን ደኤቶ” ያጌድኖ።<verse eid="NEH 9:37"/></para>
  <para style="s1">አሳይ ባረንቱ ማየቴዳ ቃላ ጫቁዋ ፓራሜዳ</para>
  <para style="p">
    <verse number="38" style="v" sid="NEH 9:38"/>ሀኔዳ የዉዋ ኡባ ድራዉ፥ ኑን ሃሳዪደ ጫቄዳ ጫቁዋ ጻፌዶ፤ ሄ ኑን ጻፌዳ ጫቁዋ ዋራቃታ ቦላን ኑ ካፓቱ፥ ኑ ሌዋቱነ ኑ ቄሳቱ ባረንቱ ማታፋ ዎድኖ።<verse eid="NEH 9:38"/></para>
  <chapter eid="NEH 9"/>
  <chapter number="10" style="c" sid="NEH 10"/>
  <para style="p">
    <verse number="1" style="v" sid="NEH 10:1"/>ሀዋፐ ካልያ አሳቱ ሄ ማታፋይ ዎዳ ዋራቃታ ቦላን ፓራሜድኖ። ሄዋንቱካ ሀካልያ ናኣ ጋድያ ሞድያ ናህምያ፤ ቄሳቱ ዋፐ: ሰደቅያሳ፥ <verse eid="NEH 10:1"/><verse number="2" style="v" sid="NEH 10:2"/>ሳራያ፥ አዛርያ፥ ኤርማሳ፥ <verse eid="NEH 10:2"/><verse number="3" style="v" sid="NEH 10:3"/>ፓሽሁራ፥ አማርያ፥ ማልክያ፥ <verse eid="NEH 10:3"/><verse number="4" style="v" sid="NEH 10:4"/>ሀጹኡሻ፥ ሻባንያ፥ ማሉካ፥ <verse eid="NEH 10:4"/><verse number="5" style="v" sid="NEH 10:5"/>ሀሪማ፥ ማረሞታ፥ ኦባድያ፥ <verse eid="NEH 10:5"/><verse number="6" style="v" sid="NEH 10:6"/>ዳኔላ፥ ግነቶና፥ ባሩካ፥ <verse eid="NEH 10:6"/><verse number="7" style="v" sid="NEH 10:7"/>ማሹላማ፥ አቢያ፥ ምያሚና፥ <verse eid="NEH 10:7"/><verse number="8" style="v" sid="NEH 10:8"/>ማኣዝያ፥ ብልጋያነ ሻማእያ።<verse eid="NEH 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NEH 10:9"/>ሌዋቱዋፐ: አዛንያ ናኣ ኢያሳ፥ ሄናዳዳ ያራ ግዴዳ ቢኑያ፥ ቃድምኤላነ <verse eid="NEH 10:9"/><verse number="10" style="v" sid="NEH 10:10"/>ኡንቱንቱ እሻቱዋ ሻባንያ፥ ሆድያ፥ ቃሊጻ፥ ፓላያ፥ ሀናና፥ <verse eid="NEH 10:10"/><verse number="11" style="v" sid="NEH 10:11"/>ሚካ፥ ራሆባ፥ ሀሻብያ፥ <verse eid="NEH 10:11"/><verse number="12" style="v" sid="NEH 10:12"/>ዛኩራ፥ ሸረብያ፥ ሻባንያ፥ <verse eid="NEH 10:12"/><verse number="13" style="v" sid="NEH 10:13"/>ሆድያ፥ ባናነ ባኒና።<verse eid="NEH 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NEH 10:14"/>ቃይ አሳ ካለያዋንቱፐ: ፓርኦሻ፥ ፓሀት-ሞኣባ፥ ኤላማ፥ ዛታ፥ ባና፥ <verse eid="NEH 10:14"/><verse number="15" style="v" sid="NEH 10:15"/>ቡና፥ አዝጋዳ፥ በባያ፥ <verse eid="NEH 10:15"/><verse number="16" style="v" sid="NEH 10:16"/>አዶንያ፥ ብግዋያ፥ አዲና፥ <verse eid="NEH 10:16"/><verse number="17" style="v" sid="NEH 10:17"/>አጼራ፥ ህዝቂያሳ፥ አዙራ፥ <verse eid="NEH 10:17"/><verse number="18" style="v" sid="NEH 10:18"/>ሆድያ፥ ሀሹማ፥ በጻያ፥ <verse eid="NEH 10:18"/><verse number="19" style="v" sid="NEH 10:19"/>ሀሪፋ፥ አናቶታ፥ ነባያ፥ <verse eid="NEH 10:19"/><verse number="20" style="v" sid="NEH 10:20"/>ማግፕኣሻ፥ ማሹላማ፥ ሄዚራ፥ <verse eid="NEH 10:20"/><verse number="21" style="v" sid="NEH 10:21"/>ማሸዛቤላ፥ ጻዶቃ፥ ያዱአ፥ <verse eid="NEH 10:21"/><verse number="22" style="v" sid="NEH 10:22"/>ፓላጽያ፥ ሀናና፥ አናያ፥ <verse eid="NEH 10:22"/><verse number="23" style="v" sid="NEH 10:23"/>ሆሼአ፥ ሀናንያ፥ ሀሹባ፥ <verse eid="NEH 10:23"/><verse number="24" style="v" sid="NEH 10:24"/>ሀሎሄሻ፥ ፒልሀ፥ ሾቤቃ፥ <verse eid="NEH 10:24"/><verse number="25" style="v" sid="NEH 10:25"/>ረሁማ፥ ሀሻብና፥ ማእሴያ፥ <verse eid="NEH 10:25"/><verse number="26" style="v" sid="NEH 10:26"/>አኪያ፥ ሀናና፥ አናና፥ <verse eid="NEH 10:26"/><verse number="27" style="v" sid="NEH 10:27"/>ማሉካ፥ ሀሪማነ ባኣና።<verse eid="NEH 10:27"/></para>
  <para style="s1">እስራኤልያ አሳይ ጫቀቴዳ ቃላ ጫቁዋ</para>
  <para style="p">
    <verse number="28" style="v" sid="NEH 10:28"/>ቃይ አቴዳ አሳይካ ቄሳቱ፥ ሌዋቱ፥ ፐንግያ ናግያዋንቱ፥ ማዝሙርያ የጽያዋንቱ፥ ጌሻ ጎልያ ቆማቱነ ጾሳ ህግያዉ አዛዘታናዉ አይሁዳ ግደናዋንቱፐ ባረና ሻኬዳ ኡባይ፥ ቃይ ኡንቱንቱ ማቻቱ፥ ኡንቱንቱ አቱማ ናናይ፥ ኡንቱንቱ ማጫ ናናይነ የዉዋ አኬካናዉ አሳ ጋማ ጋኬዳ ኡባይ፥ <verse eid="NEH 10:28"/><verse number="29" style="v" sid="NEH 10:29"/>ባረና ካለያዋና ሀ ጫቁዋን ማየቴድኖ። ሄዌካ ባረ ቆማ ሙሴ ባጋና ጾሳይ ኡንቱንቶ እሜዳ ህግያዳን ባናዉ፥ መና ጎዳ ኑ ጾሳ አዛዙዋ፥ ፕርዳነ ዎጋ ናጋናሳነ ኦናሳ። ሄዌ ዮፐ፥ ጾሳይ የድያ ሸቃይ ባረንቱ ቦላ ያናዳን ማየቴድኖ።<verse eid="NEH 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NEH 10:30"/>ኡንቱንቱ ሀዋዳን ያጊደ ጫቄድኖ፤ “ኑ ማጫ ናና አይሁዳ ግደና ጋድያ አቱማ ናናቶ እሞኮ፤ ቃይ ኡንቱንቱ ማጫ ናናካ ኑ አቱማ ናናቶ ማቻቶ ኦደ አኮኮ።<note caller="-" style="x"><char style="xo" closed="false">10:30 </char><char style="xt" closed="false"><ref loc="EXO 34:16">ከሳ 34:16</ref>፤ <ref loc="DEU 7:3">ዛረ. 7:3</ref></char></note><verse eid="NEH 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NEH 10:31"/>“አይሁዳ ግደና ጋድያ አሳቱ ካ ግድና ዎይ ሀራባ አያነ ሳምባታ ጋላስ ዎይ ሀራ ባላ ጋላስ ዛልአናዉ አሆፐ፥ ኡንቱንቱፐ ሻሞኮ።</para>
  <para style="p" vid="NEH 10:31">“ላፑን ላይይ ጋክያ ዎደ፥ ኑ ጋድያ ጎሾኮ፤ ኑን ታልኤዳ አጩዋ ኦቾኮ።<note caller="-" style="x"><char style="xo" closed="false">10:31 </char><char style="xt" closed="false"><ref loc="EXO 23:10-11">ከሳ 23:10-11</ref>፤ <ref loc="LEV 25:1-7">ዎጋ 25:1-7</ref>፤ <ref loc="DEU 15:1-2">ዛረ. 15:1-2</ref></char></note><verse eid="NEH 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NEH 10:32"/>“ጌሻ ጎልያ ኦሶ እቼሹ ግራመ ዴጽያ ብራ ላይን ላይን አገናን እማና።<note caller="-" style="x"><char style="xo" closed="false">10:32 </char><char style="xt" closed="false"><ref loc="EXO 30:11-16">ከሳ 30:11-16</ref></char></note> <verse eid="NEH 10:32"/><verse number="33" style="v" sid="NEH 10:33"/>ሄዌ አያዉ ጎፐ፥ ጾሳ ስንን ዎያ ኡክሳ፥ ሀቼ ሀቼ ያርሽያ ካ ያርሹዋ ሳኣ፥ ጹግያ ያርሾ ሹክያ መህያዉ፥ ሳምባታ ጋላሳን፥ አግናይ ጼርያ ዎደነ ላይን ደእያ ሀራ ባላቱዋን ያርሽያ ያርሾነ ሀራ ጌሻ ሚሻ ኡባሳ፤ ቃይ እስራኤልያ አሳ ናጋራ አቶ ጊሳናዉ ያርሽያ ያርሾነ ኑ ጾሳ ጌሻ ጎልያ ኦሶ ኮሽያ ኡባባሳ።<verse eid="NEH 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NEH 10:34"/>“ኑን ቄሳቶ፥ ሌዋቶነ ሀራ አሳ ኡባዉ ሳማ የጌዶ። አያዉ ጎፐ፥ ህግያን ጻፈቴዳዋዳን መና ጎዳዉ፥ ኑ ጾሳዉ፥ ያርሽያ ሳኣን ያርሹዋ ጹግያ ም ኑ ጾሳ ጌሻ ጎልያዉ ኦ ያራይ አሀናዉ በስንቶ ኤራናሳ።<verse eid="NEH 10:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NEH 10:35"/>“ላይን ላይን ኑ ጋድያ አይፍያ ኮይሮ ጋክያዋነ አይፍያ እምያ ዱማ ዱማ ምቱዋፐ ኑን ኮይሮ ማጼዳ አይፍያ ኡባ መና ጎዳ ጌሻ ጎልያ አገናን አሂደ እማና።<note caller="-" style="x"><char style="xo" closed="false">10:35 </char><char style="xt" closed="false"><ref loc="EXO 23:19">ከሳ 23:19</ref>፤ <ref loc="EXO 34:26">34:26</ref>፤ <ref loc="DEU 26:2">ዛረ. 26:2</ref></char></note><verse eid="NEH 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NEH 10:36"/>“ህግያን ጻፈቴዳዋዳን ኑን ኡባይካ ኮይሮ የለትያ ኑ አቱማ ናና ኑ ጾሳ ጌሻ ጎልያን ኦያ ቄሳቱ ዋኮ አሂደ፥ ጾሳዉ ዱማያና፤ ቃይ ኑ ሚዛቱ፥ ኑ ዶርሳቱነ ኑ ዴሻቱ የልያ ኮይሮ ማራ ኡባካ ያ አሂደ፥ ቄሳቶ እማና።<note caller="-" style="x"><char style="xo" closed="false">10:36 </char><char style="xt" closed="false"><ref loc="EXO 13:2">ከሳ 13:2</ref></char></note><verse eid="NEH 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="NEH 10:37"/>“ኑን ኑ ጋድያን ዶልያ ካ አይፍያ ኮይሩዋ፥ ቃይ ኑ ም ኡባ አይፍያ፥ ዎይንያነ ዛይትያ እሞታ ኦደ፥ ኑ ጾሳ ጌሻ ጎልያ ሃ ቄሳቱ ዋኮ አሀና። ቃይ ሌዋቱ ኑ ካታማቱዋን ደእያ ቢታ ኡባ አይፍያ አስራታ አክያዋንታ ግድያ ድራዉ፥ ኑ ቢታይ አይፌዳዋፐ ኡባፐ አስራታ ኡንቱንቶ እማና።<note caller="-" style="x"><char style="xo" closed="false">10:37 </char><char style="xt" closed="false"><ref loc="NUM 18:21">ፓይ. 18:21</ref></char></note> <verse eid="NEH 10:37"/><verse number="38" style="v" sid="NEH 10:38"/>ሌዋቱ አስራታ ሺሽያ ዎደ፥ አሮና ያራ ግዴዳ ቄሳቱ ኡንቱንቱና እትፐ ደአናዉ በሰ። ሌዋቱካ አስራታ ሺሾዋፐ ጉይያን፥ አስራታፐ ከሴዳ አስራታ ኑ ጾሳ ጌሻ ጎልያ አሂደ፥ ሻሉዋ ዎያ ክፍልያን ዎኖ።<note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="NUM 18:26">ፓይ. 18:26</ref></char></note> <verse eid="NEH 10:38"/><verse number="39" style="v" sid="NEH 10:39"/>እስራኤልያ አሳይነ ሌዋቱ ካ፥ ዎይንያነ ዎጋራ ዛይትያ እሞታ፥ ጌሻ ጎልያ ሚሻቱነ ጌሻ ጎልያን ኦያ ቄሳቱ፥ ፐንግያ ናግያዋንቱነ ማዝሙርያ የጽያዋንቱ ደእያ ክፍለቱዋ አሂኖ።</para>
  <para style="p" vid="NEH 10:39">“ኑን ኑ ጾሳ ጌሻ ጎልያ ኦሱዋ ኡባካ ሸነኮ ጎኮ” ያጊደ ጫቄድኖ።<verse eid="NEH 10:39"/></para>
  <chapter eid="NEH 10"/>
  <chapter number="11" style="c" sid="NEH 11"/>
  <para style="ms">ናህሚ የሩሳላመን ኦዳ ላምያ</para>
  <para style="mr">(<ref loc="NEH 11:1-13:31">11:1—13:31</ref>)</para>
  <para style="s1">የሩሳላመን ደእያ አሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 11:1"/>አሳ ካለያዋንቱ የሩሳላመን ደኤድኖ። ቃይ ህንኮ አሳፐካ ታሙዋፐ እቱ እቱ ጌሻ ካታማን የሩሳላመን ደአና ማላ፥ ሳማ የጊደ ዶሬድኖ። ሽን ሀራ ኡዱፑን ኩሽያ አሳይ ባረንቱ ካታማቱዋን ደኤድኖ። <verse eid="NEH 11:1"/><verse number="2" style="v" sid="NEH 11:2"/>የሩሳላመን ደአናዉ ባረንቱ ሸንያን ማዬዳ አሳ ኡባ አሳይ አንጄዳ።<verse eid="NEH 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NEH 11:3"/>ሀራ ካታማቱዋን ደእያ እስራኤልያ አሳይ፥ ቄሳቱ፥ ሌዋቱ፥ ጌሻ ጎልያ ቆማቱነ ሶሎሞነ ቆማቱዋ ያራቱ ኡባይ ባረንቱ ካታማን ካታማን ደእያ ጋድያ ኦይቂደ ደኤድኖ። ሽን ሀዋፐ ካሊደ ጻፈቴዳዋንቱ፥ የሩሳላመን ደአናዉ ዬዳ ጋድያ ካለያዋንታ።<note caller="-" style="x"><char style="xo" closed="false">11:3 </char><char style="xt" closed="false"><ref loc="NEH 7:73">ናህ. 7:73</ref></char></note><verse eid="NEH 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 11:4"/>ይሁዳ ዛርያፐ ዬዳ ካለያዋንቱ ፓሬሳ ያራ ግዴዳ አታያነ ሼላ ያራ ግዴዳ ማእሴያ። አታይ ኦዝያና ናኣ፤ ኦዝያነ ዛካራሳ ናኣ፤ ዛካራስ አማርያ ናኣ፤ አማር ሻፋጽያ ናኣ፤ ሻፋጽ ማላልኤላ ናኣ። <verse eid="NEH 11:4"/><verse number="5" style="v" sid="NEH 11:5"/>ማእሴይ ባሩካ ናኣ፤ ባሩክ ኮልሆዛ ናኣ፤ ኮልሆዝ ሀዛያ ናኣ፤ ሀዛይ አዳያ ናኣ፤ አዳይ ዮያሪባ ናኣ፤ ዮያሪብ ዛካራሳ ናኣ። <verse eid="NEH 11:5"/><verse number="6" style="v" sid="NEH 11:6"/>ፓሬሳ ያራፐ ዎልቃማ ግዴዳ 468 አሳቱ የሩሳላመን ደኤድኖ።<verse eid="NEH 11:6"/></para>
  <para style="p">
    <verse number="7-8" style="v" sid="NEH 11:7-8"/>ቢንያማ ዛርያፐ ዬዳ ካለያዋንቱ ሳላ፥ ጋባያነ ሳላያ። ሳሉ ማሹላማ ናኣ፤ ማሹላም ዮኤዳ ናኣ፤ ዮኤድ ፓዳያ ናኣ፤ ፓዳይ ቆላያ ናኣ፤ ቆላይ ማእሴያ ናኣ፤ ማእሴይ እትኤላ ናኣ፤ እትኤል ይሻእያ ናኣ። ሙለና 928 ቢንያማ ዛራቱ የሩሳላመን ደኤድኖ። <verse eid="NEH 11:7-8"/><verse number="9" style="v" sid="NEH 11:9"/>ዚክራ ናአይ ዩኤል ኡንቱንቱ ካፑዋ፤ ቃይ ሀሳኑአ ናአይ ይሁዳይ ካታማን ላኤን ማራጊ ደእያ ካፑዋ።<verse eid="NEH 11:9"/></para>
  <para style="p">
    <verse number="10-11" style="v" sid="NEH 11:10-11"/>ቄሳቱ ዋፐ ዬዳ ካለያዋንቱ ዮያሪባ ናኣ ያዳያ፥ ያኪናነ ሳራያ። ሳራይ ህልቂያ ናኣ፤ ህልቂ ማሹላማ ናኣ፤ ማሹላም ጻዶቃ ናኣ፤ ጻዶቀ ማራዮታ ናኣ፤ ማራዮት ጾሳ ጌሻ ጎልያ ካፑዋ ግዴዳ አህጹባ ያራ። <verse eid="NEH 11:10-11"/><verse number="12" style="v" sid="NEH 11:12"/>ኡንቱንቱና እትፐ ጾሳ ጌሻ ጎልያ ኦሱዋ ኦዳዋንቱ ኡባና 822. ቃይ ሀራ ካለያዌ አዳያ፤ አዳይ ይሮሃማ ናኣ፤ ይሮሃም ፓላልያ ናኣ፥ ፓላሊ አሞጻ ናኣ፤ አሞጽ ዛካራሳ ናኣ፤ ዛካራስ ፓሽሁራ ናኣ፤ ፓሽሁር ማልክያ ናኣ። <verse eid="NEH 11:12"/><verse number="13" style="v" sid="NEH 11:13"/>አዳያና እትፐ ደእያ አሳይ ኡባና 242. ቃይካ ሀራ ካለያዌ አማሻሳያ፤ አማሻሳይ አዛርኤላ ናኣ፤ አዛርኤል አህዛያ ናኣ፤ አህዛይ ማሽለሞታ ናኣ፤ ማሽለሞት እሜራ ናኣ። <verse eid="NEH 11:13"/><verse number="14" style="v" sid="NEH 11:14"/>አማሻሳያና እትፐ ደእያ ኦላንቻቱ ኡባና 128. ኡንቱንቱ ካፑ ሀግዶልማ ናኣ ዛብድኤላ።<verse eid="NEH 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NEH 11:15"/>ሌዋቱዋፐ ዬዳ ካለያዋንቱፐ እቱ ሻማእያ፤ ሻማኤ ሀሹባ ናኣ፤ ሀሹብ አዝርቃማ ናኣ፤ አዝርቃም ሀሻብያ ናኣ፤ ሀሻቢ ቡና ናኣ። <verse eid="NEH 11:15"/><verse number="16" style="v" sid="NEH 11:16"/>ቃይ ሀራቱ ሻባታያነ ዮዛባዳ፤ ኡንቱንቱ ጾሳ ጌሻ ጎልያፐ ካረና ኦሰትያ ኦሶቶ አዎትያ ሌዋቱ ካፓቱዋ። <verse eid="NEH 11:16"/><verse number="17" style="v" sid="NEH 11:17"/>ቃይካ ሀራይ ማታንያ፤ እ ጋላታ ዎሳ ዎስያ ዎደ ጋላታ ማዝሙርያ የጽያዋንቶ ካፑዋ፤ እ አሳፋ ያራፐ የለቴዳ ዛብዳ ናኣ ናኣ፥ ሚካ ናኣ። ባረናና እትፐ የጽያዋንቱ ግዶን ባቅቡቀ ላኤን። ቃይ ሀራይካ አብዳ፤ እ ሻሙአ ናኣ፤ ሻሙእ ጋላላ ናኣ፤ ጋላል ይዱቱና ናኣ። <verse eid="NEH 11:17"/><verse number="18" style="v" sid="NEH 11:18"/>ኡባና 284 ሌዋቱ ጌሻ ካታማን የሩሳላመን ደኤድኖ።<verse eid="NEH 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 11:19"/>ፐንግያ ናግያዋንቱፐ አቁባ፥ ጻልሞናነ ኡንቱንቱና እትፐ ኦያ ሀራ 172.<verse eid="NEH 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NEH 11:20"/>አቴዳ ቄሳቱ፥ ሌዋቱነ እስራኤልያ አሳይ ኡባይ ባረንቱ ጋዲ ደእያ ሳኣን ደእያ ሳኣን ዱማ ዱማ ይሁዳ ካታማቱዋን ደኤድኖ። <verse eid="NEH 11:20"/><verse number="21" style="v" sid="NEH 11:21"/>ሽን ጌሻ ጎልያ ቆማቱ የሩሳላመ ካታማን እት ባጋና ደእያ ኦፌላ ጌተትያ ሄራን ደኤድኖ። ጺህነ ግሽፕነ ላኡ ኡንቱንታ ካለያዋንታ።<verse eid="NEH 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NEH 11:22"/>የሩሳላመን ደእያ ሌዋቶ ካፑ ኡዛ። እ ባና ናኣ፤ ባን ሀሻብያ ናኣ፤ ሀሻቢ ማታንያ ናኣ፤ ማታኒ ሚካ ናኣ። ኡዝ ጌሻ ጎልያን የጽያዋንቶ ካፑዋ ግዴዳ አሳፋ ያራ። <verse eid="NEH 11:22"/><verse number="23" style="v" sid="NEH 11:23"/>ኡንቱንቱ ሀቼ ሀቼ ኦናባዉ ካትያፐ ኡንቱንቶ እመቴዳ አዛዙ ደኤ።<verse eid="NEH 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NEH 11:24"/>ይሁዳ ናኣ ዛራሀ ያራፐ የለቴዳ ማሸዛቤላ ናኣ ፓታሄ እስራኤልያ አሳ ጼልያ ኡባባዉ ኡንቱንቱ ዶና ግዲደ፥ ካትያ ማታን ደኤ።<verse eid="NEH 11:24"/></para>
  <para style="s1">ሀራ ቄር ካታማቱዋን ደኤዳ አሳ</para>
  <para style="p">
    <verse number="25" style="v" sid="NEH 11:25"/>አሳፐ ዳራቱ ባረንቱ ጎሻ ጎሻ ማታን ደእያ ቄር ካታማቱዋን ደኤድኖ። ሄዋ ድራዉ፥ ይሁዳ ዛራቱ ቅርያት-አርባአን፥ ድቦናን፥ ያቃብጽኤላንነ ሄዋ ሄራን ደእያ ቄር ካታማቱዋን ደኤድኖ። <verse eid="NEH 11:25"/><verse number="26" style="v" sid="NEH 11:26"/>ኡንቱንቱ ቃይ የሹአን፥ ሞላዳን፥ ቤት-ጳሌጻን፥ <verse eid="NEH 11:26"/><verse number="27" style="v" sid="NEH 11:27"/>ሀጻር-ሹኣላን፥ በርሳቤሀንነ ሄዋ ሄራን ደእያ ቄር ካታማቱዋን፥ <verse eid="NEH 11:27"/><verse number="28" style="v" sid="NEH 11:28"/>ጽቅላጋን፥ ማኮናንነ ሄዋ ሄራን ደእያ ቄር ካታማቱዋን ደኤድኖ። <verse eid="NEH 11:28"/><verse number="29" style="v" sid="NEH 11:29"/>ቃይካ ኤንርሞናን፥ ጾርኣንነ ያርሙታንካ ደኤድኖ። <verse eid="NEH 11:29"/><verse number="30" style="v" sid="NEH 11:30"/>ሄዋ ጻላላ ግደናን ዛኖሀን፥ አዱላማንነ ሄዋ ሄራን ደእያ ቄር ካታማቱዋንነ ላክሻንነ ሄዋ ሄራን ደእያ ጎሻን፥ ቃይ አዜቃንነ ሄዋ ሄራን ደእያ ቄር ካታማቱዋንካ ደኤድኖ። ሄዋ ድራዉ፥ ይሁዳ አሳይ ኡባና በርሳበሄፐ ቢደ፥ ህኖማ ዛንጋራ ጋካናዉ ደእያ ሳኣን ደኤድኖ።<verse eid="NEH 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NEH 11:31"/>ቢንያማ ዛራቱ ቤቴለንነ ሄዋ ሄራን ደእያ ቄር ካታማቱዋንነ ገባአን፥ ምክማሳን፥ አያን፥ <verse eid="NEH 11:31"/><verse number="32" style="v" sid="NEH 11:32"/>አናቶታን፥ ኖባን፥ አናንያን፥ <verse eid="NEH 11:32"/><verse number="33" style="v" sid="NEH 11:33"/>ሀጾራን፥ ራማን፥ ግታይማን፥ <verse eid="NEH 11:33"/><verse number="34" style="v" sid="NEH 11:34"/>ሀዲዳን፥ ጻቦኢማን፥ ናባላጻን <verse eid="NEH 11:34"/><verse number="35" style="v" sid="NEH 11:35"/>ሎዳን፥ ኦኖንነ ኩሽያ ሂላቱ ዛንጋራ ግያ ሳንካ ደኤድኖ። <verse eid="NEH 11:35"/><verse number="36" style="v" sid="NEH 11:36"/>ይሁዳን ደኤዳ ሌዋቱዋፐ ዳራቱ ቢንያማ አሳና እትፐ ደአናዳን ኦሰቴድኖ።<verse eid="NEH 11:36"/></para>
  <chapter eid="NEH 11"/>
  <chapter number="12" style="c" sid="NEH 12"/>
  <para style="s1">ኦሞዱዋፐ ስሜዳ ቄሳቱዋነ ሌዋቱዋ ሱን</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 12:1"/>ሳላትያላ ናኣ ዛሩባቤላናነ ቄሰ ኡባቱዋ ካፑዋ ኢያሱና ኦሞዱዋፐ ስሜዳ ቄሳቱ ሀዋንታ: ሳራያ፥ ኤርማሳ፥ እዝራ፥ <verse eid="NEH 12:1"/><verse number="2" style="v" sid="NEH 12:2"/>አማርያ፥ ማሉካ፥ ሀጹኡሻ፥ <verse eid="NEH 12:2"/><verse number="3" style="v" sid="NEH 12:3"/>ሻካንያ፥ ረሁማ፥ ማረሞታ፥ <verse eid="NEH 12:3"/><verse number="4" style="v" sid="NEH 12:4"/>እዳ፥ ግነቶና፥ አቢያ፥ <verse eid="NEH 12:4"/><verse number="5" style="v" sid="NEH 12:5"/>ምያሚና፥ ማኣድያ፥ ብልጋ፥ <verse eid="NEH 12:5"/><verse number="6" style="v" sid="NEH 12:6"/>ሻማእያ፥ ዮያሪባ፥ ያዳያ፥ <verse eid="NEH 12:6"/><verse number="7" style="v" sid="NEH 12:7"/>ሳላ፥ አሞካ፥ ህልቂያነ ያዳያ። ሀዋንቱ ኢያሱ ላይን ቄሳቶነ ቄሳቱዋ ያራቶ ካፑዋ ግዴዳዋንታ።<verse eid="NEH 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NEH 12:8"/>ኡንቱንቱና እትፐ ስሜዳ ሌዋቱ ኢያሳ፥ ቢኑያ፥ ቃድምኤላ፥ ሸረብያ፥ ይሁዳነ ማታንያ። ማታኒ ሀራ ባረናና ኦያዋንቱና እትፐ ጋላታ ማዝሙርያ የጽያዋንቶ ካፑዋ። <verse eid="NEH 12:8"/><verse number="9" style="v" sid="NEH 12:9"/>ኡንቱንቱና እትፐ የጽያ ባቅቡቀነ ኡኖን ኡንቱንቱፐ ስንና ሃ ስም ኤቂደ የጺኖ።<verse eid="NEH 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 12:10"/>ኢያሱ ዮያቂማ የሌዳ፤ ዮያቂም ኤልያሽባ የሌዳ፤ ኤልያሽብ ዮያዳአ የሌዳ፤ <verse eid="NEH 12:10"/><verse number="11" style="v" sid="NEH 12:11"/>ዮያዳእ ዮናታና የሌዳ፤ ዮናታን ያዱአ የሌዳ። <verse eid="NEH 12:11"/><verse number="12" style="v" sid="NEH 12:12"/>ዮያቂም ቄሰ ኡባቱዋ ካፑዋ ግዴዳ ላይ፥ ሀዋፐ ካሊደ ጻፈቴዳዋንቱ፥ ቄሳቱዋ ያራቱ ካፑዋ ግዴድኖ።</para>
  <para style="p" vid="NEH 12:12">ሳራያ ያራ ካፑ ማራያ።</para>
  <para style="p" vid="NEH 12:12">ኤርማሳ ያራ ካፑ ሀናንያ።<verse eid="NEH 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NEH 12:13"/>እዝራ ያራ ካፑ ማሹላማ።</para>
  <para style="p" vid="NEH 12:13">አማርያ ያራ ካፑ ያሆሀናና።<verse eid="NEH 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NEH 12:14"/>ማሉካ ያራ ካፑ ዮናታና።</para>
  <para style="p" vid="NEH 12:14">ሻባንያ ያራ ካፑ ዮሴፎ።<verse eid="NEH 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NEH 12:15"/>ሀሪማ ያራ ካፑ አዲና።</para>
  <para style="p" vid="NEH 12:15">ማራዮታ ያራ ካፑ ህልቃያ።<verse eid="NEH 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NEH 12:16"/>እዶ ያራ ካፑ ዛካራሳ።</para>
  <para style="p" vid="NEH 12:16">ግነቶና ያራ ካፑ ማሹላማ።<verse eid="NEH 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NEH 12:17"/>አቢያ ያራ ካፑ ዚክራ።</para>
  <para style="p" vid="NEH 12:17">ምንያምናነ ማኣድያ ያራ ካፑ ፕልጻያ።<verse eid="NEH 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NEH 12:18"/>ብልጋ ያራ ካፑ ሻሙአ።</para>
  <para style="p" vid="NEH 12:18">ሻማእያ ያራ ካፑ ዮናታና።<verse eid="NEH 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 12:19"/>ዮያሪባ ያራ ካፑ ማታናያ።</para>
  <para style="p" vid="NEH 12:19">ያዳያ ያራ ካፑ ኡዛ።<verse eid="NEH 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NEH 12:20"/>ሳላያ ያራ ካፑ ቃላያ።</para>
  <para style="p" vid="NEH 12:20">አሞካ ያራ ካፑ ኤቤራ።<verse eid="NEH 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NEH 12:21"/>ህልቂያ ያራ ካፑ ሀሻብያ።</para>
  <para style="p" vid="NEH 12:21">ያዳያ ያራ ካፑ ናታንኤላ።<verse eid="NEH 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NEH 12:22"/>ሌዋቱ ካፓቱ ኤልያሽብ፥ ዮያዳእ፥ ዮሀናንነ ያዱእ ቄሰ ካፑዋ ግዴዳ ዱማ ዱማ ላይን ጻፈቴድኖ። ቃይ ቄሳቱ ፓርሰ ጋድያ አሳ ግዴዳ ዳርዮስ ካተቴዳ ላይን ጻፈቴድኖ። <verse eid="NEH 12:22"/><verse number="23" style="v" sid="NEH 12:23"/>ግዶ ሽን፥ ሌዋቱ ያራቱ ካፓቱ ማዝጎብያን ጻፈቴዳዌ ኤልያሽባ ናኣ ናኣ ዮሀናን ሀይቃና ጋካናዉ ደእያ ዎድያ ጻላላና።<verse eid="NEH 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NEH 12:24"/>ሌዋቱዋ ካለያዋንቱ ሀሻብያ፥ ሸረብያነ ቃድምኤላ ናኣ ኢያሳ። ኡንቱንቱ ጾሳ አሳ ግዴዳ ካቲ ዳዊተ አዛዜዳዋዳን፥ ላኡዋን ሻከት ኤቂደ፥ ካላን ካላን ጾሳ ቦንቺኖነ አዉ ጋላታ ማዝሙርያ የጺኖ።<verse eid="NEH 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NEH 12:25"/>ጌሻ ጎልያ ግምቢያ ፐንግያ ማታን ኬጸቴዳ ዱማ ዱማ ሻሉዋ ዎያ ጎልያ ናግያዋንቱ ማታንያ፥ ባቅቡቅያ፥ ኦባድያ፥ ማሹላማ፥ ጻልሞናነ አቁባ ግያዋንታ። <verse eid="NEH 12:25"/><verse number="26" style="v" sid="NEH 12:26"/>ሀዋንቱ ዮጸዴቃ ናኣ ናኣ፥ ኢያሱ ናኣ ዮያቂም፥ ጋድያ ሞድያ ናህሚነ ቄሰነ ጻፍያ ግዴዳ እዝር ደኤዳ ላይን ኦድኖ።<verse eid="NEH 12:26"/></para>
  <para style="s1">ናህሚ የሩሳላመ ካታማ ግምቢያ አንጅስያ ባላ ኦዳ</para>
  <para style="p">
    <verse number="27" style="v" sid="NEH 12:27"/>የሩሳላመ ግምቢ ግምበቲደ ዉሬዳ ባላ ቦንችያ ዎደ፥ ሌዋቱ ባረንቱ ደኢያሳፐ ሳፐ ኮየቲደ፥ የሩሳላመ ዬድኖ፤ ዳላን፥ ዲንነ ማስንቁዋን ጋላታ ማዝሙርያ ናሸቻን የጺደ፥ ባላ ቦንቼድኖ። <verse eid="NEH 12:27"/><verse number="28" style="v" sid="NEH 12:28"/>ሀ ባላ ቦንቻናዉ ሌዋቱዋ ዛራቱ፥ ማዝሙርያ የጽያዋንቱ ኡባይ ባረንቱ ኬጺደ ኡቴዳ የሩሳላመ ዩሹዋፐነ ናጾፋቱ ጋድያን ደእያ ቄር ካታማቱዋፐ፥ <verse eid="NEH 12:28"/><verse number="29" style="v" sid="NEH 12:29"/>ቤት-ገልጋላፐ፥ ገባአፐነ አዝማዌታፐ ሺቂደ ዬድኖ። <verse eid="NEH 12:29"/><verse number="30" style="v" sid="NEH 12:30"/>ሄዋፐ ጉይያን፥ ቄሳቱ ነ ሌዋቱ ባረንቱ ሁጲያዉ ጌዬድኖ፤ ቃይ አሳይ ኡባይ፥ ግምቢያ ፐንገቱነ ግምቢ ጾሳዉ ጌያናዳን ኦያ ዎጋ ፖሌድኖ።<verse eid="NEH 12:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NEH 12:31"/>ታን ይሁዳ ካለያዋንታ ግምቢያ ቦላን ሺሻይ፤ ቃይ ማዝሙርያ የጽያዋንታካ ላኡ ጩጉዋን ሻካደ ጾሳ ጋላታና ማላ ኦድ። እት ጩጉ ግምቢያ ሁጲያና ኡሸቻ ስሚደ፥ ፕቱዋ ኦልያ ፐንግያ ባጋ ቤዳ። <verse eid="NEH 12:31"/><verse number="32" style="v" sid="NEH 12:32"/>ሆሻይነ ይሁዳ ካለያዋንቱፐ ባጋቱ ኡንቱቱፐ ጉየና ካሊኖ። <verse eid="NEH 12:32"/><verse number="33" style="v" sid="NEH 12:33"/>ሀራቱ ቃይ ኡንቱንቱና ደእያዋንቱ አዛርያ፥ እዝራ፥ ማሹላማ፥ <verse eid="NEH 12:33"/><verse number="34" style="v" sid="NEH 12:34"/>ይሁዳ፥ ቢንያማ፥ ሻማእያ፥ ኤርማሳነ <verse eid="NEH 12:34"/><verse number="35" style="v" sid="NEH 12:35"/>ጹሩምባ ኦይቂደ ቄሳቱ ዋ። ቃይ ኡንቱንቱፐ ጉየና ዬዳዌ ዛካራሳ፤ ዛካራስ ዮናታና ናኣ፤ ዮናታን ሻማእያ ናኣ፤ ሻማኤ ማታንያ ናኣ፤ ማታኒ ምካያ ናኣ፤ ምካይ ዛኩራ ናኣ፤ ዛኩር አሳፋ ናኣ። <verse eid="NEH 12:35"/><verse number="36" style="v" sid="NEH 12:36"/>ዛካራሳ ያራ ግዴዳ ሻማኤ፥ አዛርኤል፥ ምላላይ፥ ግላላይ፥ ማኣይ፥ ናታንኤል፥ ይሁዳይነ ሀናን ጾሳ አሳ ግዴዳ ዳዊተ ጾሳዉ የጽያ ዎደ ጎኤትያ የ ሚሻ ኡባ አኪደ፥ ዛካራሳፐ ጉየና ካሌድኖ። ኡንቱንቱ ጩጉዋ ካለያዌነ ጻፍያዌ እዝራ። <verse eid="NEH 12:36"/><verse number="37" style="v" sid="NEH 12:37"/>ፑልቱዋ ፐንግያኮ ጋኮዋፐ ጉይያን፥ ዳዊታ ካታማኮ ስሚደ፥ ግምቢያ ቦላን ደእያ ጸካ ከሴድኖ፤ ዳዊታ ጎለ አደ፥ ካታማፐ አዋይ ዶልያ ባጋና ደእያ ሃ ፐንግያኮ ቤድኖ።<verse eid="NEH 12:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="NEH 12:38"/>ላኤን ማዝሙርያ የጽያዋንቱ ጩጉ ግምቢያ ሁጲያ ኦይቂደ፥ ሀድርሳ ስሚደ ቤዳ። ታን አሳፐ ባጋና እትፐ ግዳደ ኡንቱንቱፐ ጉየና ካላድ። እቶንያ አዱሳ ግምቢያፐ አደ፥ አኮ ግምቢያ ጌተትያ ሳኣ ጋኬዳ። <verse eid="NEH 12:38"/><verse number="39" style="v" sid="NEH 12:39"/>ቃይ ሄዋፐካ ስሚደ፥ ኤፍሬማ ፐንግያ፥ ኤጫ ፐንግያ፥ ሞልያ ፐንግያ፥ ሀናንኤላ አዱሳ ግምቢያነ ጼቱ አዱሳ ግምቢያ ጋካናስካ ቤዳ። ዉርሰን ዶርሳ ፐንግያ ማታና ቢደ፥ ናግያዋንቱ ፐንግያ ጋኪደ ኤቄዳ።<verse eid="NEH 12:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="NEH 12:40"/>ማዝሙርያን ጾሳ ጋላትያ ላኡ ጩጉካ ጾሳ ጌሻ ጎልያኮ ጋኬድኖ፤ ቃይ ታንካ ታናና እትፐ ደእያ ካለያዋና ጋካድ። <verse eid="NEH 12:40"/><verse number="41" style="v" sid="NEH 12:41"/>ኑፐ ሀራቱ ሀዋፐ ካሊደ ጻፈቴዳ፥ ጹሩምባ ፑንያ ቄሳቱ ካ ጋኬድኖ። ሄዋንቱካ ኤልያቂማ፥ ማእሴያ፥ ምንያምና፥ ምካያ፥ ኤልዮኤናያ፥ ዛካራሳነ ሀናንያ። <verse eid="NEH 12:41"/><verse number="42" style="v" sid="NEH 12:42"/>ኡንቱንቱ ካሊደ ጋኬዳዋንቱ ማእሴያ፥ ሻማእያ፥ ኤልኣዛራ፥ ኡዛ፥ ያሆሀናና፥ ማልክያ፥ ኤላማነ ኤጼራ። ኑን ኡባይ ደንድ ኤቆዋፐ ጉይያን፥ ማዝሙርያ የጽያዋንቱ ይዝራሄ ኡንቱንታ ካለና፥ ባረንቱ ኮሻ ቁ ኦደ የጼድኖ።<verse eid="NEH 12:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="NEH 12:43"/>ሄ ጋላስ ዳሮ ያርሹዋ አሳይ ጾሳዉ ያርሼዳ፤ አያዉ ጎፐ፥ ጾሳይ ኡንቱንቱ ዎልቃማ ናሸቻን ናሸቼዳ፤ ማጫ አሳይካ ናናይካ ናሸቴድኖ። ሄዋ ድራዉ፥ የሩሳላመ አሳይ ናሸትያ ናሸቻይ ሃኩዋን ስሰቴዳ።<verse eid="NEH 12:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NEH 12:44"/>ሄ ጋላስ አሳይ እምያ እሞታቱዋ፥ አስራታነ ላይን ካእያ ካ አይፍያ ኮይሩዋ ሺሺደ፥ ሚሻቱዋ ዎያ ጎለን ዎደ፥ ናግያ ካፓቱዋ ዶሬድኖ። ሀ ዶሬዳ አሳቱ ዱማ ዱማ ካታማቱዋን ደእያ ሾይቃቱዋፐ ህጊ አዛዝያዋዳን፥ ቄሳቶነ ሌዋቶ በስያ ቆሙዋ ሺሽኖ። አያዉ ጎፐ፥ ይሁዳ አሳይ ኡባይ ቄሳቱ ዋንነ ሌዋቱዋን ሎይ ናሸቴድኖ። <verse eid="NEH 12:44"/><verse number="45" style="v" sid="NEH 12:45"/>ኡንቱንቱ ጾሳይ አዛዜዳዋ ኦድኖ፤ ቃይ ጌይያ ዎጋካ ፖሌድኖ። ኡንቱንቱ ጻላላ ግደናን፥ ማዝሙርያ የጽያዋንቱነ ፐንግያ ናግያዋንቱ ዳዊተነ አ ናኣ ሶሎሞነ አዛዜዳ ኦሱዋ ፖሌድኖ።<note caller="-" style="x"><char style="xo" closed="false">12:45 </char><char style="xt" closed="false"><ref loc="1CH 25:1-8">1 ኦዱዋ 25:1-8</ref>፤ <ref loc="1CH 26:12">26:12</ref></char></note> <verse eid="NEH 12:45"/><verse number="46" style="v" sid="NEH 12:46"/>ካሰ ዳዊታነ አሳፋ ዎድያፐ ዶሚደካ ማዝሙርያ የጽያዋንቱ ጩጉዋ ካለያዋንቱ ጾሳ የን ጋላታናዉነ ቦንቻናዉ ደእያዌ ኤረቲደ ደእያዋ። <verse eid="NEH 12:46"/><verse number="47" style="v" sid="NEH 12:47"/>ዛሩባቤላ ላይንነ ናህምያ ላይን እስራኤልያ ኡባይ ማዝሙርያ የጽያዋንቶነ ፐንግያ ናግያዋንቶ በስያ ቆሙዋ ሀቼ ሀቼ እሜድኖ፤ ቃይ ሌዋቶካ ኡንቱንቶ ዱማዬዳ ቆሙዋ እሜድኖ። ሌዋቱካ ቃይ አሮና ያራቱዋ ግዴዳ ቄሳቶ ኡንቱንቶ ዱማዬዳ ቆሙዋ እሜድኖ።<verse eid="NEH 12:47"/></para>
  <chapter eid="NEH 12"/>
  <chapter number="13" style="c" sid="NEH 13"/>
  <para style="s1">እስራኤልያ አሳይ አላጋ አሳፐ ሻከቴዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="NEH 13:1"/>ሄ ጋላስ አሳይ ኡባይ ስስሽን፥ ሙሴ ማጻፋይ ናባበቴዳ፤ ሄ ዎደ ኡንቱንቱ፥ “ሞኣበ ጋድያ አሳይነ አሞና ጋድያ አሳይ ጾሳ ማባራን ጋከታናዉ በሰና” ግያ ሳኣ ማጻፋ ግዶን ደሜድኖ።<note caller="-" style="x"><char style="xo" closed="false">13:1-2 </char><char style="xt" closed="false"><ref loc="DEU 23:3-5">ዛረ. 23:3-5</ref></char></note> <verse eid="NEH 13:1"/><verse number="2" style="v" sid="NEH 13:2"/>አያዉ ጎፐ፥ እስራኤልያ አሳይ ግብጼፐ ከሲደ፥ ካናነ ብያ ዎደ፥ ሞኣባነ አሞና ጋድያ አሳይ ኡንቱንቶ ካነ ሃ እመናን እጼድኖ። ሄዋ ቦላካ ቃይ እስራኤልያ አሳ ሸቃና ማላ፥ ባላማዉ ሻሉዋ እሚደ ሻሜድኖ። ግዶ ሽን፥ ኑ ጾሳይ ሸቃ አንጆ ላሜዳ።<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="NUM 22:1-6">ፓይ. 22:1-6</ref></char></note> <verse eid="NEH 13:2"/><verse number="3" style="v" sid="NEH 13:3"/>ሀ ህግያ እስራኤልያ አሳይ ስሴዳ ዎደ፥ አላጋ ዛርያ ዋላካይ ደእያ ኡባ እስራኤልያፐ ሻኬዳ።<verse eid="NEH 13:3"/></para>
  <para style="s1">ናህሚ ባዬዳ ዎጋ ኦራጽሴዳ</para>
  <para style="p">
    <verse number="4" style="v" sid="NEH 13:4"/>ሄዋፐ ካሰቲደ፥ ጌሻ ጎልያን ሚሻቱዋ ዎያ ክፍለቶ ካፑዋ ግዴዳ ኤልያሽብ ጾቢያና ዳቦታ መ ዎዳ። <verse eid="NEH 13:4"/><verse number="5" style="v" sid="NEH 13:5"/>ሄዋፐ ደንደዳዋን ካ እሞታ፥ እጻና፥ ጌሻ ጎልያን ደእያ ዱማ ዱማ ሚሻቱዋ፥ ካፐ ዎይንያፐነ ዛይትያፐ ሌዋቶ፥ ማዝሙርያ የጽያዋንቶነ ፐንግያ ናግያዋንቶ እምያ አስራታነ ቄሳቶ እምያ ቆሙዋ ዎያ ዎጋ ክፍልያ ኤልያሽብ ጾቢ አቃና ማላ፥ አዉ ጊግሴዳ።<verse eid="NEH 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NEH 13:6"/>ሀ ኡባባይ ሀንያ ዎደ ታን የሩሳላመን ደእከ። አያዉ ጎፐ፥ አርጸክሲስ ባብሎነ ጋድያን ካተቴዳ ሀታማነ ላኤን ላይን ታን ስማደ ባብሎነ ጋድያ ካትያኮ ባ ክቻድ። ግዶ ሽን፥ ጉ ዎድያፐ ጉይያን፥ ካትያ ኦቻደ፥ <verse eid="NEH 13:6"/><verse number="7" style="v" sid="NEH 13:7"/>የሩሳላመ ስማደ ያድ። ጾሳ ጌሻ ጎሊ ደእያ ሳኣን ኤልያሽብ ጾቢያዉ አቅያ ክፍልያ ጊግሲደ፥ እ ኦዳ ኢታባ አኬካድ። <verse eid="NEH 13:7"/><verse number="8" style="v" sid="NEH 13:8"/>ሎይ ሀንቀታደ፥ ጾቢያ ሶይ ሻሉዋ ኡባ ክፍልያፐ ከሳደ፥ ካረ ኦላድ። <verse eid="NEH 13:8"/><verse number="9" style="v" sid="NEH 13:9"/>ክፍልያካ ቃይ ዎጋዳን ጌሻና ማላ አዛዛድ። ጾሳ ጌሻ ጎልያ ሚሻቱዋ፥ ካ፥ እሞታነ እጻና ዛራደ ሄ ሳኣ ገልሳድ።<verse eid="NEH 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NEH 13:10"/>ቃይ አሳይ ሌዋቶነ ማዝሙርያ የጽያዋንቶ በስያ ቁማዉ እምቤና ድራዉ፥ ሌዋቱነ ማዝሙርያ የጽያዋንቱ ኡባይ ባረንቱ ኪታ አጊደ፥ ጎሻዉ ጉየ ቤዳዋ በኣድ።<note caller="-" style="x"><char style="xo" closed="false">13:10 </char><char style="xt" closed="false"><ref loc="DEU 12:19">ዛረ. 12:19</ref></char></note> <verse eid="NEH 13:10"/><verse number="11" style="v" sid="NEH 13:11"/>ሄዋ ድራዉ፥ ታን ካፓቱዋ፥ “ጾሳ ጌሻ ጎልያ ኦሱዋ አያዉ ኦል አጌድቴ?” ያጋደ ሀንቀታድ። ሄዋፐ ጉይያን፥ ኡንቱንታ ጼጋደ ኡባካ ኡንቱንቱ ኦሶ ኦሱዋ ዛራድ። <verse eid="NEH 13:11"/><verse number="12" style="v" sid="NEH 13:12"/>ያትና፥ ይሁዳ አሳይ ኡባይ ካፐ፥ ዎይንያፐነ ዛይትያፐ እምያ አስራታ ጌሻ ጎልያ ሚሻቱዋ ዎያ ጎልያ ዛሪደ፥ አሁዋ ዶሜዳ።<note caller="-" style="x"><char style="xo" closed="false">13:12 </char><char style="xt" closed="false"><ref loc="MAL 3:10">ሚልክ. 3:10</ref></char></note> <verse eid="NEH 13:12"/><verse number="13" style="v" sid="NEH 13:13"/>ታን ቄስያ ሸሌምያ፥ ጻፍያ ጻዶቃነ ሌዊያ ፓዳያ ሚሻ ዎያ ጎልያዉ ካፑዋ ኦደ ሱንድ። ቃይ ማታንያ ናኣ ናኣ ዛኩራ ናአይ ሀናን ኡንቱንታ ማድያዋ። ሀዋንቱ ኡባይካ ኮሽያዋ ኡባ ባረንቱ እሻቶ ሻክ ሻክ እምያዋን አማነትያዋንታ ግዴድኖ።<verse eid="NEH 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NEH 13:14"/>“ታ ጾሳዉ ታና ቆፓ፤ ቃይ ነ ጌሻ ጎልያ ኪታይ ጊጋና ማላ፥ ታን ኦዳ ሎኦ ኦሱዋካ ዶጎፓ” ያጋደ ታን ዎሳድ።<verse eid="NEH 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NEH 13:15"/>ሄ ዎድያን ታን ይሁዳን ደእያ አሳይ ሳምባታ ጋላስ ዎይንያ ጉምእሽን በኣድ፤ ሀራቱካ ቃይ ካ፥ ዎይንያ ኤሳ፥ ዎይንያ አይፍያ፥ ባላስያ አይፍያነ ሄዋንታ ማላትያባቱዋ ባረንቱ ሀርያን ጫኒደ፥ ሳምባታ ጋላሳን የሩሳላመ አህያዋ በኣድ። ሄዋ ድራዉ፥ ኡንቱንቱ ሳምባታ ጋላሳን ዛልኤናዳን ታን ኡንቱንቶ ምንሳደ ኦዳድ።<note caller="-" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="EXO 20:8-10">ከሳ 20:8-10</ref>፤ <ref loc="DEU 5:12-14">ዛረ. 5:12-14</ref>፤ <ref loc="JER 17:21-22">ኤር. 17:21-22</ref></char></note> <verse eid="NEH 13:15"/><verse number="16" style="v" sid="NEH 13:16"/>ሄዋ ቦላካ ቃይ የሩሳላመን ደእያ ጺሮሳ ጋድያ አሳቱ ሞልያነ ሀራ እት እት ዛልኤ ሚሻቱዋ አሂደ፥ ሳምባታን የሩሳላመን ይሁዳ አሳዉ ዛልኢኖ። <verse eid="NEH 13:16"/><verse number="17" style="v" sid="NEH 13:17"/>ሄዋ ድራዉ፥ ታን ይሁዳ ካለያዋና ሀዋዳን ያጋ ዋላቀታድ፤ “ሀዋ ማላ ኢታ ኦሱዋ ኦደ፥ ሳምባታ አያዉ ቱንሲቴ? <verse eid="NEH 13:17"/><verse number="18" style="v" sid="NEH 13:18"/>ጾሳይ ሀዋ ማላ መቱዋ ኑ ቦላንነ ኑ ካታማ ቦላን አሄዳዌ፥ ካሰ ህንተንቱ አዎቱ ሄዋ ማላ ኢታባ ኦና ግደኔየ? ሀእ ህንተንቱ ቃይ ሳምባታ ቱንሲደ፥ እስራኤልያ ቦላን ሀራ ሀንቁዋ አሀናዉ ሀኒታ” ያጋድ።<verse eid="NEH 13:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NEH 13:19"/>ሄዋፐ ጉይያን፥ ሳምባታ ጋላሳፐ ካሰቲደ ደእያ ጋላሳን ሳአይ ለለምእያ ዎደ፥ የሩሳላመ ግምቢያ ፐንገቱ ጎርደታናዳንነ ሳምባታይ አናዉ ዶየተናዳን ታን አዛዛድ። ቃይ ሳምባታ ጋላሳን አይ ዛልእያነ አኪደ ገለናዳን ናጋና ማላ፥ ታ ቆማቱዋፐ እቱዋ እቱዋ ግምቢያ ፐንግያን ኤሳድ። <verse eid="NEH 13:19"/><verse number="20" style="v" sid="NEH 13:20"/>ሄዋ ድራዉ፥ ዱማ ዱማ ዛልኤ ሚሻቱዋ አህያ ዛልአንቻቱ እቱዋፐ ቢደ ላኡዋ ጋካናዉ፥ የሩሳላመ ግምቢያፐ ጋጻ ባጋና አቄድኖ። <verse eid="NEH 13:20"/><verse number="21" style="v" sid="NEH 13:21"/>ሽን ታን ኡንቱንታ ሀዋዳን ያጋደ ሴራድ፤ “ግምቢያፐ ጋጻና ዋናናዉ አቂቴ? ህንተንቱ ላኤን ሄዋዳን ኦፐ፥ ታን ዎልቃንካ ህንተንታ ተአና” ያጋድ። ሄ ጋላሳፐ ጉይያን፥ ላኤን ሳምባታ ጋላስ ሙለ ይበይክኖ። <verse eid="NEH 13:21"/><verse number="22" style="v" sid="NEH 13:22"/>ሌዋቱ ባረንቱ ሁጲያ ጌሻናዳንነ ሳምባታ ጋላሳይካ ጌሻ ግዳና ማላ፥ ግምቢያ ፐንገቱዋ ናጋናዳን ታን አዛዛድ።</para>
  <para style="p" vid="NEH 13:22">“ታ ጾሳዉ፥ ሀ ኡባባ ድራዉ፥ ኔን ታና ቆፓ፤ ቃይ ነ አገና ሲቁዋ ድራዉ፥ ኔን ታዉ ቃረታ” ያጋደ ዎሳድ።<verse eid="NEH 13:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NEH 13:23"/>ሄ ዎደ ቃይካ ታን ይሁዳ አቱማ አሳፐ እቱ እቱ ማችያ አሽዶዳ፥ አሞናነ ሞኣበ ጋደቱዋፐ አኬዳዋ በኣድ።<note caller="-" style="x"><char style="xo" closed="false">13:23-25 </char><char style="xt" closed="false"><ref loc="EXO 34:11-16">ከሳ 34:11-16</ref>፤ <ref loc="DEU 7:1-5">ዛረ. 7:1-5</ref></char></note> <verse eid="NEH 13:23"/><verse number="24" style="v" sid="NEH 13:24"/>ኡባ ቃይ ኢታባይ ኡንቱንቱ ናናቱዋፐ ባጋይ አሽዶዳ ጋድያ ዎይ እት እት ሀራ ጋድያ ቃላን ሃሳዪኖፐ አትና፥ ባረንቱ ጋድያ፥ ይሁዳ ቃላን ሃሳያናዉ ዳንዳይክኖ። <verse eid="NEH 13:24"/><verse number="25" style="v" sid="NEH 13:25"/>ታን ኡንቱንቱና ኦሸታድነ ኡንቱንታ ሸቃድ፤ ቃይ ኡንቱንቱፐ እቱዋ እቱዋ ደቻደ፥ ኡንቱንቱ ሁጲያ ብናና ሾዳድ። ሄዋ ጻላላ ግደናን ኡንቱንቱ ላኤን ባረንቱ ማጫ ናና ኡንቱንቱ አቱማ ናናቶ እመናዳንነ ኡንቱንቱ ማጫ ናናካ ባረንቶነ ባረንቱ አቱማ ናናቶ አከናዳን ጾሳ ሱንን ጫቀታድ። <verse eid="NEH 13:25"/><verse number="26" style="v" sid="NEH 13:26"/>ቃይካ ኡንቱንታ ሀዋዳን ያጋድ፤ “ካትያ ሶሎሞነ ናጋራ ኦዳዌ አላጋ ጋድያ ማጫ አሳቱዋፐ ደንዴዳዋና ግደኔየ? ሶሎሞነ ማላ ካቲ ሀራ ዳሮ ጋድያ ካተቱዋ ግዶንካ ባዋ፤ ጾሳይካ አ ዶሴዳ ድራዉ፥ እስራኤልያ አሳ ኡባ ቦላን ካተዬዳ። ግዶ ሽን፥ ሀራይ አቶ አካ አላጋ ጋድያ ማጫ አሳቱ ሀዋ ማላ ናጋራ ኦስሴድኖ።<note caller="-" style="x"><char style="xo" closed="false">13:26 </char><char style="xt" closed="false"><ref loc="2SA 12:24-25">2 ሳሜላ 12:24-25</ref>፤ <ref loc="1KI 11:1-8">1 ካታ. 11:1-8</ref></char></note> <verse eid="NEH 13:26"/><verse number="27" style="v" sid="NEH 13:27"/>ያትና፥ ኑንካ ቃይ ህንተንቱ ዞርያ ስሲደ፥ አላጋ ማጫ አሳ አኪደነ ሄዋ ማላ ኢታባ ኦደ፥ ጾሳ ናቃኔየ?” ያጋድ።<verse eid="NEH 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NEH 13:28"/>ቄስያ ኡባቱዋ ካፑዋ ኤልያሽባ ናናቱዋፐ እቱ ዮያዳአ፤ ሽን አ ናናቱዋፐ እቱ ቤት-ሆሮና ካታማ አሳ ግድያ ሳንባላጻ ናቶ አኬዳ። ያትና፥ ታን አ ታ ደእያ ሳኣፐ የደርሳድ።<note caller="-" style="x"><char style="xo" closed="false">13:28 </char><char style="xt" closed="false"><ref loc="NEH 4:1">ናህ. 4:1</ref></char></note><verse eid="NEH 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NEH 13:29"/>“ታ ጾሳዉ፥ ሀዋንቱ ቄሰተ ዎጋ ቱንሴዳዋነ ኔን ቄሳቱ ዋናነ ሌዋቱዋና ዎዳ ቃላ ጫቁዋ ኮሌዳዋ በአ” ያጋደ ታን ዎሳድ።<verse eid="NEH 13:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NEH 13:30"/>ኡንቱንታ አላጋ ግዴዳ የዉዋ ኡባፐ ጌሾዋፐ ጉይያን፥ ቄሳቶነ ሌዋቶ ኡንቱንቱ ኦሱዋ ኦሱዋ እማድ። <verse eid="NEH 13:30"/><verse number="31" style="v" sid="NEH 13:31"/>ቃይ ያርሹዋ ጹግያ ምይካ ዎድያን ዎድያን ያና ማላነ አሳይካ ባረዉ አይፌዳዋፐ ኮይሮ አይፍያ እሞታ ኦደ አሀና ማላ፥ ዎጋ ዎድ።</para>
  <para style="p" vid="NEH 13:31">“ታ ጾሳዉ፥ ነ ሎኦተን ታና ቆፓ” ያጋደ ታን ዎሳድ።<verse eid="NEH 13:31"/></para>
  <chapter eid="NEH 13"/>
</usx>
