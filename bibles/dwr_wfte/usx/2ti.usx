<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Dawuro Full Bible Ethiopic Version</book>
  <para style="h">2 ጽሞቶሳ</para>
  <para style="toc1">ጳውሎስ ጽሞቶሳዉ ጻፌዳ ላኤን ኪታ</para>
  <para style="toc2">2 ጽሞቶሳ</para>
  <para style="toc3">2 ጽሞ.</para>
  <para style="mt2">ጳዉሎስ</para>
  <para style="mt">ጽሞቶሳዉ</para>
  <para style="mt2">ጻፌዳ ላኤን ኪታ</para>
  <para style="imt">ገሉዋ</para>
  <para style="ip">ሀዌ ጳዉሎስ ጽሞቶሳዉ ጻፌዳ ላኤን ኪታይ፥ ጳዉሎስ ማታ ባረና ማድያነ ኦሱዋ ባረናና እትፐ ኦያ ዎዳላ፥ ጽሞቶሳ ዞሬዳ ዞርያ ኦይቄዳዋ። አ ዞርያፐ ዳርያ ባጋይ ዳንዳያን ገንጫና በሴ ግያዋ። ጽሞቶሳዉ ዞርያነ መንዋ ቃላይ እመቴዳዌ፥ የሱስ ክርስቶሳባ አማነትያዋ ግዲደ ማርካታናዳን፥ ምሽራቹዋ ቃላነ ኤጫ ቃላ ጫቁዋ ትምርትያ ምንሲደ ኦይቃናዳንነ መትያባይነ ኤቀትያባይ ዳሮፐካ ታማርስያዋንነ ምሽራቹዋ ቃላ ኦድያዋን ምናናሳ።</para>
  <para style="ip">ጽሞቶስ ኤያተን ኦሰትያ ፓና መላ ፓሉማፐ ሃካና ማላ፥ ዱማ ምኖ ኦዱ አዉ ኦደቴዳ። አያዉ ጎፐ፥ ሄዋ ማላ ኦዱ ስስያዋንታ ባይዝያዋፐ አትን፥ ሀራ እ እምያ ጎእ ባዋ።</para>
  <para style="ip">ሄዋን ኡባን ጽሞቶስ ሀሳያናዉ በስያባይ ጳዉሎሳ ደኡዋነ አ ሀኖታ ሎኦ ቆፋ፥ ሄዋፐካ አ አማኑዋ፥ አ ገንጩዋ፥ አ ሲቁዋ አ ዳንዳያነ የደሳን አ ጋኬዳ መቱዋ ሌምሱዋን ካላናዳና።</para>
  <para style="iot">ሸምፓቱዋ ኡባቶ እመቴዳ ቃን ቆፋቱዋ</para>
  <para style="io1">ገሉዋ <char style="ior"><ref loc="2TI 1:1-2">1:1-2</ref></char></para>
  <para style="io1">ጽሞቶሳዉ እመቴዳ ማቁዋ <char style="ior"><ref loc="2TI 1:3-2:13">1:3—2:13</ref></char></para>
  <para style="io1">አሳይ ካድያ ዎደ አማነት ቤቱሳ <char style="ior"><ref loc="2TI 2:14-4:5">2:14—4:5</ref></char></para>
  <para style="io1">ሄ ዎደ ደእያባቱዋነ ኮሽያ ካለያ ኦጋቱዋ <char style="ior"><ref loc="2TI 4:6-18">4:6-18</ref></char></para>
  <para style="io1">ዉርሰ ቁትያ <char style="ior"><ref loc="2TI 4:19-22">4:19-22</ref></char></para>
  <chapter number="1" style="c" sid="2TI 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1"/>ታን ጳዉሎስ፥ ጾሳይ እማና ጌዳ ክርስቶስ የሱሳና ኑዉ ደእያ ደኡዋባ ኦዳናዉ፥ ጾሳይ ጌዳዋዳን፥ ክርስቶስ የሱስ ኪቴዳዌ፥ <verse eid="2TI 1:1"/><verse number="2" style="v" sid="2TI 1:2"/>ታ ሲቆ ናኣ ጽሞቶሳዉ ሀ ዳብዳቢያ ጻፋይ።</para>
  <para style="s1" vid="2TI 1:2">ጽሞቶሳዉ እመቴዳ ዞርያ</para>
  <para style="p" vid="2TI 1:2">ጾሳ አዉዋፐነ ኑ ጎዳ ክርስቶስ የሱሳፐ፥ አ ኬካተይ፥ ማሮተይነ ሳሮተይ ነዉ ግዶ።<verse eid="2TI 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3"/>ታ ዛራቱ ኦዳዋዳን፥ ታንካ ታና ዞርያ ጌሻ ዎዛናፐ ኦያ ጾሳ ቃማነ ጋላስ ዎስያ ዎሳን ኡባ ዎደ ኔና ሀሳይያ ድራዉ፥ አ ጋላታይ። <verse eid="2TI 1:3"/><verse number="4" style="v" sid="2TI 1:4"/>ታን ነ አፎ ሀሳያ ሀሳያደ ናሸታና ማላ፥ ኔና በአናዉ ዳሮ ላሞታይ።<verse eid="2TI 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TI 1:5"/>ኔናን ደእያ ዎርዶ ባይና አማኑዋ ሀሳያይ። ሄ አማኑ በን ነ ዳይ ዳይ ሎይድንነ ነ ዳይ ኤዉኒቅን ደእያ አማኑዋ ማላ፤ ቃይ ኔናንካ ሄዌ ደእያዋ ኤራድ። <verse eid="2TI 1:5"/><verse number="6" style="v" sid="2TI 1:6"/>ሄዋ ድራዉ፥ ታን ታ ኩሽያ ላኡዋ ነ ቦላ ዎዳ ዎደ፥<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="fq" closed="false">ታን ታ ኩሽያ ላኡዋ ነ ቦላ ዎዳ ዎደ፦ </char><char style="ft" closed="false">ሀዌ በስያዌ፥ አማንያ አሳ ካለናዳን ጌሻ አያናይ ኦሶ ዶርና ቱማተን ካለያዋንቱ ቃላ ኦዳናዉ ዎይ ታማርሳናዉ ጾሳይ ኦኬዳዋንቱ ቦላን ባረንቱ ኩሽያ ዎደ ዎስያዋ በሴ። 1 ጽም። 1:4 ጼልተ።</char></note> ጾሳይ ነዉ እሜዳ እሙዋ ኔን ዶሽሰና ማላ፥ ኔና ሀሳይሳይ። <verse eid="2TI 1:6"/><verse number="7" style="v" sid="2TI 1:7"/>አያዉ ጎፐ፥ ጾሳይ ኑዉ ዎልቃ፥ ሲቁዋነ ኑ ሁጲያ ናግያዋ እምያ ጌሻ አያና እሜዳፐ አትን፥ ያሻ አያና እምቤና።<verse eid="2TI 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8"/>ስም፥ ኑ ጎዳዉ ማርካትያዋን ዎይ አ ድራዉ ቃሹዋን ደእያ ታዋንካ ዬላቶፓ። ሽን ጾሳይ ነዉ እምያ ዎልቃ ኬናን ታናና ምሽራቹዋ ቃላዉ ዋየታ። <verse eid="2TI 1:8"/><verse number="9" style="v" sid="2TI 1:9"/>ጾሳይ ባረ ቆፋንነ ባረ አ ኬካተን ኑና አሺደ፥ ባረ አሳ ኦናዉ ጼሶዋፐ አትን፥ ኑን ኦዳ ኦሱዋ ድራዉ ግደና። እ ሀ አ ኬካተ ክርስቶስ የሱሳ ባጋና ዎዲ ዶመታናፐ ካሰ ኑዉ እሜዳ። <verse eid="2TI 1:9"/><verse number="10" style="v" sid="2TI 1:10"/>ሽን ሀእ ሀ አ ኬካተይ ኑና አሽያ ክርስቶስ የሱሳ ዩሳን ኑዉ ቆንጬዳ። ቃይ ሀይቁዋ ዎልቃካ እ ይሴዳ። ዎንጋላ ምሽራቹዋ ባጋና ባየና ደኡዋ ኑዉ ቆንጭሴዳ።<verse eid="2TI 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11"/>ታን የሱስ ኪቴዳዋነ አይሁዳ ግደና አሳ ታማርስያዋ ግዳደ፥ ዎንጋላ ምሽራቹዋ ኦዳና ማላ፥ ጾሳይ ታና ዶሬዳ። <verse eid="2TI 1:11"/><verse number="12" style="v" sid="2TI 1:12"/>ቃይ ታን ሀ መቱዋ አክያዌ ሄዋ ድራሳ። ሽን ታን አማኔዳዋ ኤርያ ድራዉ፥ ዬላትከ። ቃይ እ ታዉ እሜዳ ሀዳራ ሄ ጋላሳይ ጋካናዉ፥ እ ናጋናዉ ዳንዳይያዋ ኤራይ።<verse eid="2TI 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 1:13"/>ታን ኔና ታማርሴዳ ቱሙ ቃላ ሌምሱዋ ኡዳ ኦይቃደ፥ ክርስቶስ የሱሳን ኑዉ ደእያ አማኑዋንነ ሲቁዋን ደአ። <verse eid="2TI 1:13"/><verse number="14" style="v" sid="2TI 1:14"/>ኑ ግዶን ደእያ ጌሻ አያና ባጋና ነዉ ሀዳራ እሜዳ ሎኦባ ናጋ።<verse eid="2TI 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15"/>ኢስያ ግያ ቢታን ደእያ ኡባቱ ታፐ ባቃቴዳዋ ኤራሳ፤ ኡንቱንቱ ግዶን ፕገሉስነ ሄርሞገኔስ ደኢኖ።<verse eid="2TI 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 1:16"/>ሄነስፎሩ ታና ዳሮ ዎደ መንዳ ድራዉ፥ ጎዳይ አ ሶይ አሳዉ ማሮተ እሞ። ቃይ ታን ቃሾ ጎለን ደእያዋ እ ዬላትቤና። <verse eid="2TI 1:16"/><verse number="17" style="v" sid="2TI 1:17"/>ሽን ሮመ ግያ ካታማ ጋኬዳሳና ታና ሎይ ኮዪደ ደሜዳ። <verse eid="2TI 1:17"/><verse number="18" style="v" sid="2TI 1:18"/>ሄ ጋላስ ጎዳፐ ማሮተ ደማናዳን፥ ጎዳይ አዉ እሞ። ቃይ ኤፈሶና ግያ ካታማን እ ታና አይ ኬና ማዴደንቶነ ኔን ሎይ ኤራሳ።<verse eid="2TI 1:18"/></para>
  <chapter eid="2TI 1"/>
  <chapter number="2" style="c" sid="2TI 2"/>
  <para style="s1">ክርስቶሳዉ ሎኦ ዎታዳራ ግዲደ መቱዋ አክያዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1"/>ስም ታ ናአዉ፥ ክርስቶስ የሱሳን ደእያ አ ኬካተን ምና። <verse eid="2TI 2:1"/><verse number="2" style="v" sid="2TI 2:2"/>ቃይ ዳሮ ማርካቱ ደእያ ሳን ታፐ ኔን ስሴዳ የዋቱዋ ሀራቱዋ ታማርሳናዉ ዳንዳይያ አማነቴዳ አሳቶ ሀዳራ እማ።<verse eid="2TI 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3"/>ክርስቶሳ የሱሳዉ አማነቴዳ ዎታዳራዳን፥ ታናና ዋየታ። <verse eid="2TI 2:3"/><verse number="4" style="v" sid="2TI 2:4"/>ኦላ ብያ ዎታዳራይ ባረ ካፑዋ ናሸቻናዉ፥ ዎታዳራ ግደና አሳይ ኦያ ኪታን ዋላከተና። <verse eid="2TI 2:4"/><verse number="5" style="v" sid="2TI 2:5"/>ቃይ ዎን ኬሰትያ ኡራይካ ዎጋዳን ዎጻና ዮፐ፥ ዎይታ አከና። <verse eid="2TI 2:5"/><verse number="6" style="v" sid="2TI 2:6"/>ዳሮ ዳቡሪደ ኦዳ ቢታ ጎሽያ ብታኒ ሺቄዳ ካፐ ባረና ጋክያዋ ኮይሮ አካናዉ በሴ። <verse eid="2TI 2:6"/><verse number="7" style="v" sid="2TI 2:7"/>ኔን ኡባባ አኬካናዳን፥ ጎዳይ ኔና ዳንዳይሳና ድራዉ፥ ታን ግያዋ ቆፓ።<verse eid="2TI 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8"/>ታን ዎንጋላ ምሽራቹዋ ኦድያዋዳን፥ ሀይቁዋፐ ደንዴዳ ዳዊተ ዛርያ የሱስ ክርስቶሳ ቆፓ። <verse eid="2TI 2:8"/><verse number="9" style="v" sid="2TI 2:9"/>ታን ዎንጋላ ምሽራቹዋ ኦድያ ድራዉ፥ ኢታባ ኦዳዋዳን፥ ሀራይ አቶ ቃሸታና ጋካናዉ ዋየታይ። ሽን ጾሳ ቃላይ ቃሸተና። <verse eid="2TI 2:9"/><verse number="10" style="v" sid="2TI 2:10"/>ሄዋ ድራዉ፥ ታን ጾሳይ ዶሬዳ አሳቱካ ክርስቶስ የሱሳን ደእያ አቶተ መና ቦንቹዋና ደማናዳን፥ ኡንቱንቱ ድራዉ፥ ታን ኡባባን ዋየታይ።<verse eid="2TI 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 2:11"/>ሀዌ፥</para>
  <para style="q1" vid="2TI 2:11">“ኑን አናና እትፐ ሀይቄዳዋ ግዶፐ፥</para>
  <para style="q2" vid="2TI 2:11">አናና እትፐ ደአና።<verse eid="2TI 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12"/>ኑን ገንጮፐ፥</para>
  <para style="q2" vid="2TI 2:12">አናና እትፐ ካተታና።</para>
  <para style="q1" vid="2TI 2:12">ኑን አ ካዶፐ፥</para>
  <para style="q2" vid="2TI 2:12">እካ ኑና ካዳና።<verse eid="2TI 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13"/>ኑን አማነተናን አጎፐካ፥</para>
  <para style="q2" vid="2TI 2:13">እ አማነትያዋ ግዲደ ደአናዋ።</para>
  <para style="q1" vid="2TI 2:13">አያዉ ጎፐ፥ እ ባረና ባረ ሁጰዉ</para>
  <para style="q2" vid="2TI 2:13">ኤርከ ጋናዉ ዳንዳየና”</para>
  <para style="m" vid="2TI 2:13">ግያዌ ቱሙ ሃሳያ።<verse eid="2TI 2:13"/></para>
  <para style="s1">ምኖ ኦሳንቻ</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14"/>ኔን ነ አሳ ሀዋ ሀሳይሳ፤ ኡንቱንቱ ቃላን ፓሉመተና ማላ፥ ጾሳ ስንን ዞራ። ሄዌ ስስያ አሳ ባይዝያዋፐ አትን፥ አይነ ጎኤና። <verse eid="2TI 2:14"/><verse number="15" style="v" sid="2TI 2:15"/>ኔን ጾሳ ቱማተ ቃላ ሱረተን ኦድያዋነ ቃይ አ ኦሶ ዬላተና ኦሳንቻ ግዳደ፥ ጾሳይ ሳቢያ አሳዳን፥ ነ ሁጲያ ጾሳዉ እማናዉ ምና። <verse eid="2TI 2:15"/><verse number="16" style="v" sid="2TI 2:16"/>ሽን ሀ ሳአዉ እንጀትያ ማደና ሃሳያፐ ኔና ናጋ። አያዉ ጎፐ፥ ሄዌ ጾሳፐ አሳ ሃሴ። <verse eid="2TI 2:16"/><verse number="17" style="v" sid="2TI 2:17"/>ቃይ ኡንቱንቱ ታማርስያዌ ቦላ ጭቱዋዳን ኡባሳ ጋካናሳ። ሄ ታማርስያዋንቱፐ ላአቱ ሄመነዮሳነ ፕሊጾሳ። <verse eid="2TI 2:17"/><verse number="18" style="v" sid="2TI 2:18"/>ኡንቱንቱ ቱሙዋ ኦግያ አጊደ፥ “ሀይቁዋፐ ደንድያዌ ካሰ አድጌዳ” ያጊደ አማሬዳ አማንያ አሳቱዋ አማኑዋ ባይዚኖ።<verse eid="2TI 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 2:19"/>ግዶፐካ፥ ጾሳይ ኤሴዳ ምኖ ቱሳይ ቃጻና ዳንዳየና። ቃይ አ ቦላን፥ “ጎዳይ ባረዋንታ ኤሬ”፤ ቃይ “ጎዳዋ ግድያ ኦንነ ኢታ ኦሱዋ አጎ” ያግያ ቃላቱ ጻፈቴድኖ።<note caller="-" style="x"><char style="xo" closed="false">2:19 </char><char style="xt" closed="false"><ref loc="NUM 16:5">ፓይ. 16:5</ref></char></note><verse eid="2TI 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20"/>እት ዎልቃማ ጎለን ዎርቃፐነ ብራፐ መቴዳ ሚሻ ጻላላ ግደናን፥ ምፐነ ኡርቃፐ መቴዳ ሚሻቱካ ደኢኖ። ሄዋንቱፐ ባጋቱ ቦንቾ ኦሱዋ ኡንቱንቱን ኦናዉ፥ ቃይ ባጋቱ ቶሸትያባ ኡንቱንቱን ኦናዉ መቴድኖ። <verse eid="2TI 2:20"/><verse number="21" style="v" sid="2TI 2:21"/>ሄዋ ድራዉ፥ ኦንነ ሀ ኢታባ ኡባፐ ባረና ጌሾፐ፥ እ ባረ ጎዳ ጎእያ ኦሱዋ ኦናዉ ባረና እሜዳ ድራዉ፥ ቦንቾ ኦሱዋ ኦያ ሚሻ ግዳናዋ። ቃይ ሎኦ ኦሱዋ ኡባ ኦናዉ ጊገቴዳዋ ግዳናዋ።<verse eid="2TI 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22"/>ሽን ኔን ኢታ ዎዳላተ አሙዋፐ ባቃታ። ባረንታ ማዳናዉ ጌሻ ዎዛናፐ ጎዳ ጼስስያዋንቱና እትፐ፥ ጽሎተ፥ አማኑዋ፥ ሲቆተነ ሳሮተ ምንሳደ ካላ።<verse eid="2TI 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2TI 2:23"/>ሽን ኤያቱዋ ፓሉሚነ አይነ ኤረናዋንቱ ፓሉሚ ዋላሳ ካለያዋ ኤራደ አፐ ባቃታ። <verse eid="2TI 2:23"/><verse number="24" style="v" sid="2TI 2:24"/>ጎዳ ቆማይ ኡባዉ ኬክያዋ፥ ሎይ ታማርስያዋነ ዳንዳያንቻ ግዳናዉ በሴፐ አትን፥ ዋላቀታናዉ በሰና። <verse eid="2TI 2:24"/><verse number="25" style="v" sid="2TI 2:25"/>ቃይ እ ባረና እጽያዋንታ አሽከተን ሴርያዋ ግዳናዉ በሴ። ኡንቱንቱ ባረንቱ ናጋራፐ ስሚደ፥ ቱማተ ኤራናዳን ጾሳይ ኦነንቶ፥ ኦን ኤር። <verse eid="2TI 2:25"/><verse number="26" style="v" sid="2TI 2:26"/>ቃይ ኡንቱንቱ ባረንቱ ዎዛና ቆፋዉ ስሚደ፥ ኡንቱንታ ባረ ኮዬዳባዉ አዛዘታና ማላ ኦይቄዳ ጻላህያ ካፑዋ ዳባፐ ከስ አካና።<verse eid="2TI 2:26"/></para>
  <chapter eid="2TI 2"/>
  <chapter number="3" style="c" sid="2TI 3"/>
  <para style="s1">ዉርሰ ጋላሳቱዋን ሀናናዉ ደእያ ኢታ የዋቱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1"/>ሽን ዉርሰ ጋላስ ዋይስያ ዎዲ ያናዋ አኬካ። <verse eid="2TI 3:1"/><verse number="2" style="v" sid="2TI 3:2"/>አያዉ ጎፐ፥ አሳይ ባረና ሲቅያዋንታ፥ ሻሉዋ ሲቅያዋንታ፥ ጬቀትያዋንታ፥ አይያዋንታ፥ ቦርያዋንታ፥ ባረና የሌዳዋንቶ አዛዘተናዋንታ፥ ጋላተናዋንታ፥ ጌሻተይ ባይናዋንታ፥ <verse eid="2TI 3:2"/><verse number="3" style="v" sid="2TI 3:3"/>ሲቁ ባይናዋንታ፥ ስገተናዋንታ፥ ዝግርሳንቻቱዋ፥ ባረና ናገናዋንታ፥ ኬከናዋንታ፥ ሎኦባ ዶሰናዋንታ፥ <verse eid="2TI 3:3"/><verse number="4" style="v" sid="2TI 3:4"/>ኡባ ኤርከ ግያዋንታ፥ ድርቢያዋንታ፥ ኦቶሩዋን ሱገትያዋንታ፥ ቃይ ጾሳፐ አደ፥ እሻሉዋ ዶስያዋንታ ግዳና። <verse eid="2TI 3:4"/><verse number="5" style="v" sid="2TI 3:5"/>ኡንቱንቱ ጾሳዉ ጎይንያዋ ማላቲኖ፤ ሽን አ ዎልቃ ካዴድኖ። ሄዋንቱ ማላ አሳቱዋኮ ሺቆፓ።<verse eid="2TI 3:5"/></para>
  <para style="p">
    <verse number="6-7" style="v" sid="2TI 3:6-7"/>አያዉ ጎፐ፥ ኡንቱንቱፐ እቱ እቱ አሳ ጎልያ ገሊደ፥ ናጋራይ ዴጼዳዋንታ፥ ዱማ ዱማ አሙዋን ሱገትያዋንታ፥ ኡባ ዎደ ታማሪደ፥ ቱማተ ኤራ አካናዉ ሙለ ዳንዳይቤና ዳቡራንቻ ማጫዋንታ ባለኖ። <verse eid="2TI 3:6-7"/><verse number="8" style="v" sid="2TI 3:8"/>ያኔስነ ያምባሬስ<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="fq" closed="false">ያኔስነ ያምባሬስ፦ </char><char style="ft" closed="false">ሀ ሱንቱ ኤጫ ጫቁዋ ማጻፋን ባዋ። ሽን ጮራ አሳይ ግያ ቆፋይ፥ “ሀዋንቱ ሙሴ እስራኤልያ አሳ ግብጼፐ ከሲደ ካለናዉ ቆፔዳ ዎደ፥ አናና ኤቀቴዳ ሙሩንያዋንታ” ያግያዋና። ከሳ 7:11፣ 12 ጼልተ።</char></note> ሙሴ የዉዋ ጳልቆዋዳን፥ ሄዋዳን ቃይ ሀዋንቱ፥ ሱረ ቆፋይ ባይናዋንታ አማኑዋን ኩንዴዳዋንቱ፥ ቱማተባ ጳልቂኖ።<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="EXO 7:11">ከሳ 7:11</ref></char></note> <verse eid="2TI 3:8"/><verse number="9" style="v" sid="2TI 3:9"/>ሽን ያኔሳ ኤያተይነ ያምባሬሳ ኤያተይ ቃይ ቆንጬዳዋዳን፥ ኡንቱንቱ ኤያተይካ አሳ ኡባዉ ቆንጫና ድራዉ፥ ኡንቱንቱ ካሰዋፐ አደ ድጭክኖ።<verse eid="2TI 3:9"/></para>
  <para style="s1">ዉርሰ ዞርያ</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10"/>ሽን ኔን ታ ትምርትያ፥ ታ ሀኖታነ ታ ቆፋ፥ ታ አማኑዋነ ታ ዳንዳያ፥ ታ ሲቁዋነ ታ ገንጩዋ፥ <verse eid="2TI 3:10"/><verse number="11" style="v" sid="2TI 3:11"/>ታ የደሳነ ታ ዋይያ በኣዳ። አንጾክያነ፥ እቆንዮነነ ልስጽራ ግያ ካታማቱዋን ታና ጋኬዳባነ ታን ዳንዳዬዳ የደሳ ኤራሳ። ጎዳይ ታና ሄ ኡባፐ አሼዳ። <verse eid="2TI 3:11"/><verse number="12" style="v" sid="2TI 3:12"/>ቱማተን ክርስቶስ የሱሳን ጾሳ ማላቲደ ደአናዉ ዶስያ ኡባይ የደርሰታና። <verse eid="2TI 3:12"/><verse number="13" style="v" sid="2TI 3:13"/>ሽን ኢታ አሳቱነ ባለያዋንቱ ሀራቱዋ ባለደነ ባረንቱ ሁጰዉ ባሊደ፥ ካሰፐ ኢት ኢት ቢኖ።<verse eid="2TI 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 3:14"/>ሽን ኔን ሄ ቱማተ ኦፐ ታማሬደንቶነ ኤራደ፥ ኔን ታማሬዳዋንነ ኤሬዳዋን ምናደ ደአ። <verse eid="2TI 3:14"/><verse number="15" style="v" sid="2TI 3:15"/>ኔን ጉ ናአተፐ ዶማደ ክርስቶስ የሱሳ አማናደ፥ አቶተይ ቤትያ አዳ ኤራ እማናዉ ዳንዳይያ ጌሻ ማጻፋቱዋ ኤራዳ። <verse eid="2TI 3:15"/><verse number="16-17" style="v" sid="2TI 3:16-17"/>ጾሳ ማጻፋ ኡባን ጾሳ አያናይ ደኤ። ቃይ ሄ ማጻፋቱ ጾሳዉ ኦያ አሳይ ኩመንነ ሎኦ ኦሱዋ ኡባዉ ጊጌዳዋ ግዳና ማላ፥ ቱማተ ታማርሳናዉ፥ ባላ ሴራናዉ፥ ባይዙዋ ሱርሳናዉነ ጽሎተ ደኦ ዞርያ እማናዉ ማዲኖ።<verse eid="2TI 3:16-17"/></para>
  <chapter eid="2TI 3"/>
  <chapter number="4" style="c" sid="2TI 4"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1"/>ታን ኔና ጾሳ ስንንነ፥ ደኡዋን ደእያ አሳነ ሀይቄዳ አሳ ፕርዳናዉ ደእያ ክርስቶስ የሱሳ ስንን፥ ቃይ አ ዩሳንነ አ ካዉተን ኔና ዞራይ። <verse eid="2TI 4:1"/><verse number="2" style="v" sid="2TI 4:2"/>ቃላ ኦዳ። ዎዲ እንጀትና እንጀታና ይና፥ ምናደ ኦዳ። ዳሮ ዳንዳያን አሳ ታማርሳደ ሱርሳ፥ ሴራነ ዞራ። <verse eid="2TI 4:2"/><verse number="3" style="v" sid="2TI 4:3"/>አያዉ ጎፐ፥ አሳይ ቱሙ ትምርትያ ስሰናን እጽያ ዎዲ ያናዋ። ሽን አሳይ ባረንቱ አሙዋ ካሊደ፥ ስሳናዉ ናሸችያዋ ኦድያ ታማርስያዋንታ ጉጅ ጉጅ ሺሻና። <verse eid="2TI 4:3"/><verse number="4" style="v" sid="2TI 4:4"/>ኡንቱንቱ ቱሙ የዉዋ ስስያዋ አጊደ፥ ቶሳ ስሳናዉ ባረንቱ ሀይ ዎራ ዛራና። <verse eid="2TI 4:4"/><verse number="5" style="v" sid="2TI 4:5"/>ሽን ኔን ኡባባን ነ ሁጲያ ናጋናዉ በሴ። ዋይያ ዳንዳያ። ዎንጋላ ምሽራቹዋ ኦድያዌ ኦያ ኦሱዋ ኦ። ጾሳ ቆማዳን፥ ነ ኦያ ኦሱዋ ኡባ ፖላ።<verse eid="2TI 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6"/>ታና ግዶፐ፥ ታ ሱይ ጉኪደ ያርሸትያ ዎዲነ ቃይ ሀ ደኡዋ አጋደ ብያ ዎዲ ጋኬዳ። <verse eid="2TI 4:6"/><verse number="7" style="v" sid="2TI 4:7"/>ታን ሎኦ ባጽያ ባጸታድ፤ ዎ ዎጻደ ዉርሳድ፤ አማኑዋካ ናጋድ። <verse eid="2TI 4:7"/><verse number="8" style="v" sid="2TI 4:8"/>ስንፐ ታዉ ጽሎተ ካላቻይ ጊግ ኡቴዳ። ሄዋ ጽሎ ፕርዳ ፕርድያ ጎዳይ ሄ ጋላስ ታዉ እማና። ቃይ ክርስቶስ ቆንጫናዋ ዶስያ ኡባ ሳፐ አትን፥ ታ ጻላላሳ ግደና።<verse eid="2TI 4:8"/></para>
  <para style="s1">አ ቡዞ አላላቱዋባ</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9"/>ታኮ ኤለካ ያናዉ ምና። <verse eid="2TI 4:9"/><verse number="10" style="v" sid="2TI 4:10"/>አያዉ ጎፐ፥ ዴማስ ሀ አላምያ ዶሲደ፥ ታና አጊደ፥ ተሰሎንቀ ግያ ካታማ ቤዳ። ቀርቂስ ጋላትያ ግያ ጋድያ ቢና፥ ቃይ ቲቶ ድልማጽያ ግያ ጋድያ ቤዳ። <verse eid="2TI 4:10"/><verse number="11" style="v" sid="2TI 4:11"/>ሉቃሳ ጻላላይ ታናና ደኤ። ማርቆስ ታና ኪታን ሎይ ማዳናዉ ዳንዳይያ ድራዉ፥ አ ደማደ ኔናና አካደ ያ። <verse eid="2TI 4:11"/><verse number="12" style="v" sid="2TI 4:12"/>ሽን ታን ትክቆሳ ኤፈሶና ግያ ካታማ ኪታድ። <verse eid="2TI 4:12"/><verse number="13" style="v" sid="2TI 4:13"/>ኔን ያደ፥ ጽሮኣዳ ግያ ካታማን ካርፖሳዋን ታን የጋደ ዬዳ ታ ጋብያነ ቃይ ማጻፋቱዋ ታዉ አካደ ያ። ሽን ዱማያደ ጋልባን ጻፈቴዳ ማጻፋቱዋ አያ ግዶፐነ፥ አከናን ዮፓ።<verse eid="2TI 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14"/>ብራታ ቆጽያ እስክንድር ታና ዳሮ ቆሄዳ፤ ጎዳይ አዉ አ ኦሱዋዳን ዛራና። <verse eid="2TI 4:14"/><verse number="15" style="v" sid="2TI 4:15"/>እ ኑን ኦድያዋ ሎይ ጳልቂያ ድራዉ፥ ኔን አፐ ኔና ናጋ።<verse eid="2TI 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16"/>ኮይሮ ታና ሞትያ ዎደ፥ ኡባይካ አጌዳዋፐ አትን፥ ታና ኦንነ ማድቤና። ጾሳይ ሄዋ ኡንቱንቶ ፓይዶፖ። <verse eid="2TI 4:16"/><verse number="17" style="v" sid="2TI 4:17"/>ሽን ታን ኩመን ኪታ አይሁዳ ግደና አሳይ ኡባይ ስሳናዉ ኦዳና ማላ፥ ጎዳይ ታ ማታን ኤቂደ፥ ታዉ ዎልቃ እሜዳ። ቃይ ጋሙዋ ዶናፐካ ታና አሼዳ። <verse eid="2TI 4:17"/><verse number="18" style="v" sid="2TI 4:18"/>ጎዳይ ታና ኢታባ ኡባፐ አሺደ፥ ባረ ሳሉዋ ካዉተ ሳሮተን አፋና፤ አዉ መ መናዉ ቦንቹ ግዶ። አመንእ።<verse eid="2TI 4:18"/></para>
  <para style="s1">ዉርሰ ሳሮታ</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19"/>ጵርስቂልዉ፥ አቂላስነ ሄነስፎሩ ሶይ አሳዉ ታ ሳሮታ ኦዳ። <verse eid="2TI 4:19"/><verse number="20" style="v" sid="2TI 4:20"/>ኤራስጾስ ቆሮንቶሳ ግያ ካታማን አቴዳ። ሽን ጽሮፊሞስ ሳከቴዳ ድራዉ፥ ምሊጸ ግያ ካታማን አ ዎድ። <verse eid="2TI 4:20"/><verse number="21" style="v" sid="2TI 4:21"/>ባልጉ ዎናፐ ካሰ ያናዉ ምና።</para>
  <para style="p" vid="2TI 4:21">ኤዉቡሉስ፥ ጱዴስ፥ ሊኖስነ ቅላዉደ ቃይ ሀራ እሻቱ ኡባይካ ኔና ሳሮ ሳሮ ጊኖ።<verse eid="2TI 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22"/>ጎዳይ ነ አያናና ግዶ። አ ኬካተይ ህንተናና ኡባና ግዶ። አመንእ።<verse eid="2TI 4:22"/></para>
  <chapter eid="2TI 4"/>
</usx>
