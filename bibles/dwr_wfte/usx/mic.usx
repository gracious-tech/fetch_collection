<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MIC" style="id">- Dawuro Full Bible Ethiopic Version</book>
  <para style="h">ሚክያሳ</para>
  <para style="toc1">ሚክያሳ ትምቢትያ</para>
  <para style="toc2">ሚክያሳ</para>
  <para style="toc3">ሚክ.</para>
  <para style="mt1">ሚክያሳ ትምቢትያ</para>
  <para style="imt">ገሉዋ</para>
  <para style="ip">ትምቢትያ ኦድያ ሚክያስ ኢስያሳ ዎደ ደኤዳ አሳ። እ የለቴዳዌ ገድሳ ባጋ ይሁዳ ካዉተ ግዶን ደእያ እት ጉ ጋጻረ ካታማና። አሞጽ ሁጲሳ ካዉተ ቦላ ባሻይ ያናዋ ኦዴዳዋዳን፥ ሚክያስካ ሄ ጋሶቱዋን ይሁዳ ካዉተ ቦላ ባሻይ ጋካናዋ ኦዴዳ። አሳይ ፕርዳ ጌላይያ፥ ሄ ሸነይያ ኦሱዋ ቦላ ጾሳይ ፕርዳ አሀናዋ ምንሲደ ኤርሴዳ። ግዶፐነ ሚክያሳ ትምቢትያ ቃላይ ስንፐ ሎኦባቱ ያናዉ ደእያዋ በስያ ዳሮ ማላታቱዋካ ጉጂደ ኦይቄዳ።</para>
  <para style="ip">ዱማዪደ ምንስ ጼላናዉ በስያ ክፍላቱ ጾሳ ሞዱዋ ጋርሳን ኩመን ሳአይ ሳሩዋ ደማናዋ (4:1-4)፤ ዳዊታ ካዉተ ቱራፐ ዎልቃማ ካቲ ደንዲደ፥ አሳዉ ሳሩዋ እማናዋ (5:2-4)፤ ሄዋዳንካ ቃይ እስራኤልያን ትምቢትያ ኦዴዳዋንቱ ቃላይ መጽ እት ጽቅስያን ኩሸትያዋ ኦድያዋንታ። ሄ ጽቅሲ ኦዲደ፥ “እ ኑፐ ኮይያዌ: ኑን ልከባ ኦናዋ፥ ኬካተይ ኩሜዳ ሲቁዋ በሳናዋነ ኑ ጾሳና ኩመን አሽከተን ሀመታናዋ” (6:8)።</para>
  <para style="iot">ሸምፓቱዋ ኡባቶ እመቴዳ ቃን ቆፋቱዋ</para>
  <para style="io1">1. ጎዳይ ባረ አሳ ሙራና <char style="ior"><ref loc="MIC 1:1-2:11">1:1—2:11</ref></char></para>
  <para style="io1">2. ስን ህዶታ <char style="ior"><ref loc="MIC 2:12-13">2:12-13</ref></char></para>
  <para style="io1">3. ጾሳይ ኢታ ካለያዋንታነ ዎርዶ ናባቱዋ ሙራና <char style="ior"><ref loc="MIC 3:1-12">3:1-12</ref></char></para>
  <para style="io1">4. ኦራ እስራኤላትን ኦራ ጌሻ ጎልያ <char style="ior"><ref loc="MIC 4:1-5:15">4:1—5:15</ref></char></para>
  <para style="io1">5. እስራኤልያ ናቁ ቆንጩሳ <char style="ior"><ref loc="MIC 6:1-7:7">6:1—7:7</ref></char></para>
  <para style="io1">6. አሳይ ጾሳኮ ስሙሳ <char style="ior"><ref loc="MIC 7:8-20">7:8-20</ref></char></para>
  <chapter number="1" style="c" sid="MIC 1"/>
  <para style="s1">ጎዳይ ባረ አሳ ሙራና</para>
  <para style="r">(<ref loc="MIC 1:1-2:11">1:1—2:11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1"/>እዮኣታም፥ አካዝነ ህዝቂያስ ካል ካሊደ ይሁዳን ካተቴዳ ዎደ፥ ሞረሸታ ካታማ አሳ ግድያ ሚክያሳኮ ዬዳ መና ጎዳ ቃላይ ሀዋ፤ እ በኤዳ ሳጻይ ሳማርያዋነ የሩሳላመባ።<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2KI 15:32-16:20">2 ካታ. 15:32—16:20</ref>፤ <ref loc="2KI 18:1-20:21">18:1—20:21</ref>፤ <ref loc="2CH 27:1-7">2 ኦዱዋ 27:1-7</ref>፤ <ref loc="2CH 28:1-32:33">28:1—32:33</ref></char></note><verse eid="MIC 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 1:2"/>ህንተኖ፥ አሳዉ ኡባዉ፥ ስስተ! ቃይ ሳአዉነ ሳኣን ደእያ ኡባ ገደ፥ ሀዋ ስስተ! ኡባ ሞድያ መና ጎዳይ ህንተ ቦላ ማርካቴ፤ እ ባረ ጌሻ ጌሻ ጎልያን ህንተዋ ሃሳየ። <verse eid="MIC 1:2"/><verse number="3" style="v" sid="MIC 1:3"/>በእተ፥ መና ጎዳይ ባረ ደእያ ጌሻ ሳኣፐ ዬ፤ ዱገ ዪደ፥ ደረቱዋ ሁጲያን ሀመቴ። <verse eid="MIC 1:3"/><verse number="4" style="v" sid="MIC 1:4"/>ኤሳ ሙቃዳይ ታማን ሴርያዋዳን፥ ደረቱ አ ገድያፐ ጋርሳና ሲላና፤ ኡንቱንቱ ደርያፐ ዛንጋራይ ዱገ ጎግያ ሃዳን ጎጋና።<verse eid="MIC 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 1:5"/>ሀዌ ኡባይ ሀንያዌ ያቆባ ዛራቱዋ ባይዙዋ ግሻሳነ እስራኤልያ አሳ ናጋራ ግሻሳ። ያቆባ ዛራቱዋ ባይዞ ጋሱዋ ግዴዳዌ ኦኔ? ኡንቱንቱ ካታማ ሳማርያ ግደኔ? ይሁዳ አሳይ ጎይንያ ቃ ሳአይ ሀቄ? የሩሳላመ ግደኔየ? <verse eid="MIC 1:5"/><verse number="6" style="v" sid="MIC 1:6"/>ሄዋ ድራዉ፥ ጾሳይ ሀዋዳን ያጌ፤ “ታን ሳማርያ፥ ደምባን ኬለቴዳ ቡርጨ ሹቻነ ዎይንያ ቱራ ቶክያ ሳ ኦና። ቃይ ታን አ ሹቻ ቡርጭያ ዱገ ዛንጋራዉ ኦላና፤ አ ባሱዋካ ካሎያና። <verse eid="MIC 1:6"/><verse number="7" style="v" sid="MIC 1:7"/>አ ኤቃ ምስለቱ ኡባይ ክንቼታና፤ አ ኤቃ ጎልያን ኦያ ሻርሙጻቶ እመቴዳ ሻርሙጻ የዉ ኡባይ ታማን ጹገታናዋ፤ ታን አ ኤቃቱዋ ኡባ ይሳና። አያዉ ጎፐ፥ ሄ የዉ ኡባይካ ሻርሙጺደ ደሜዳዋ ግድያ ድራዉ፥ እካ ቃይ ስሚደ፥ ሀራ ሻርሙጻዉ እመታና” ያጌ።<verse eid="MIC 1:7"/></para>
  <para style="s1">ዬኩዋነ ዋሱዋ</para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 1:8"/>ሄዋ ድራዉ፥ ታን ዬካናነ ዋሳና፤ ካሎ ጺራነ መላ ገድያን ሀመታና፤ ዎራካናዳን ዋሳና፤ ቃይ ሶጎንያዳንካ አየ ጋና። <verse eid="MIC 1:8"/><verse number="9" style="v" sid="MIC 1:9"/>አያዉ ጎፐ፥ ሳማርያ ማዱይ ፓጻናዉ ዳንዳየናዋ። ሄ ቱጋይ ይሁዳ ጋድያ ጋኬዳ፤ ቃይ ታ አሳይ ደእያ የሩሳላመ ካታማ ፐንግያካ ማቴዳ።<verse eid="MIC 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 1:10"/>ጋተ ካታማን ደእያ ኑ ሞርከቶ ሄዋ ኦዶፕተ፤ ኡንቱንቱ ስንን ሙለ ዬኮፕተ። ቤት-ኦፍራ ካታማን ባናን ጎንዶረትተ። <verse eid="MIC 1:10"/><verse number="11" style="v" sid="MIC 1:11"/>ህንተኖ፥ ሻፊራ ካታማን ደእያዋንቶ፥ ካሎቲደ ዬላቲደ፥ ኦሞዶ ቢተ። ጻእናና ካታማን ደእያዋንቱ ያፐ ከሳናዉ ጻልክኖ። ቤት-ኤጼላ ካታማይ ዬኩ ደኢያሳ ግድያ ድራዉ፥ እ ህንተንቶ አትያሳ ግዳናዉ ዳንዳየና። <verse eid="MIC 1:11"/><verse number="12" style="v" sid="MIC 1:12"/>መቱ መና ጎዳፐ የሩሳላመ ፐንገ ጋካናዉ ዬዳ ድራዉ፥ ማሮታን ደእያ አሳይ፥ “ሎኦባይ ያንዴሻ!” ጊደ ናጊደ ዳቡሬዳ።<verse eid="MIC 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MIC 1:13"/>ህንተኖ፥ ላክሻ ካታማን ደእያዋንቶ፥ ጋርያ ጎችያ ፓራቱዋ ዋጽተ። የሩሳላመ አሳይ ናጋራ ኦናዳን ጋሱዋ ግዴዳዌ ህንተና፤ አያዉ ጎፐ፥ ጽዮነ አሳ ናጋራይ ኮይሮ ህንተ ቦላ ቤቴዳ። <verse eid="MIC 1:13"/><verse number="14" style="v" sid="MIC 1:14"/>ሄዋ ድራዉ፥ ህንተኖ ይሁዳ አሳቶ፥ ህንተ ቢደ፥ ሞረሸታ-ጋተ ካታማ አሳዉ እሞታ እማና። አክዚባ ካታማ አሳይካ እስራኤልያ ካተቱዋ ጭምያዋንታ ግዳና።<verse eid="MIC 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MIC 1:15"/>ህንተኖ፥ ማሬሻ ካታማን ደእያዋንቶ፥ መና ጎዳይ ህንተና ጾንያዋ ህንተ ቦላ አሀና፤ ቦንቼቴዳ እስራኤልያ ካለያዋንቱ አዱላማ ጎንጎሉዋን ቆሰታና። <verse eid="MIC 1:15"/><verse number="16" style="v" sid="MIC 1:16"/>ህንተኖ፥ ይሁዳ አሳቶ፥ ህንተ ሲቅያ ናናይ ህንተፐ ኦሞደቲደ ባናዉ ደእያ ድራዉ፥ ህንተ ሁጲያ ሜደትተ፤ ህንተ ሁጲያካ አንኩዋ ሁጲያዳን ቦአይተ።<verse eid="MIC 1:16"/></para>
  <chapter eid="MIC 1"/>
  <chapter number="2" style="c" sid="MIC 2"/>
  <para style="s1">ህዬሳቱዋ ኡቁንያዋንቱ ቦላን ጋካናዉ ደእያ ኢታ ካጫ</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 2:1"/>ኢታባ ሀልችያዋንቶ፥ ቃይ ባረንቱ ሂጻን ደኢደ፥ ኢታባ ዎት ኦነንቶ ቆፕያዋንቶ አየ አና! ዎልቃይ ኡንቱንቱ ኩሽያን ደእያ ድራዉ፥ ሳአይ ዎንትያ ዎደ፥ ባረንቱ ሀልቹዋ ፖሊኖ። <verse eid="MIC 2:1"/><verse number="2" style="v" sid="MIC 2:2"/>ኡንቱንቱ ጎሻ ጋድያ አሞቶፐ፥ አሳዋ ዎልቃን አክ አጊኖ፤ ጎለቱዋ ኮዮፐካ አክ አጊኖ። አሳ ማታ የደ፥ አ ላታ ጮ ቦንቂኖ።<verse eid="MIC 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 2:3"/>ሄዋ ድራዉ፥ መና ጎዳይ ሀዋዳን ያጌ፤ “በእተ፥ ታን ህንተ ቦላን ኢታባ አሀናዉ ሀልቻይ፤ ሄዋፐ ህንተ ከስ አካናዉ ዳንዳይክታ። ሄዌ ኢታ ዎደ ግድያ ድራዉ፥ ህንተ ኦቶረቲደ ስመረታናዉ ዳንዳይክታ። <verse eid="MIC 2:3"/><verse number="4" style="v" sid="MIC 2:4"/>ሄ ጋላስ ኡንቱንቱ ህንተ ቦላን ሌምስ ሌምሲደ ቅሊጫና፤ ቃይ ሀዋዳን ያግ ዝላሊደ፥ ህንተና ህዶታ ቃንጽሳና፤</para>
  <para style="q1" vid="MIC 2:4">“ኑን ኡባይካ ኡባና ዬዶ።</para>
  <para style="q2" vid="MIC 2:4">መና ጎዳይ ኑ ጋድያ አኪደ፥</para>
  <para style="q2" vid="MIC 2:4">ማካላንቻቶ ግሽ ግሺደ፥</para>
  <para style="q2" vid="MIC 2:4">እም ድጌዳ ያጋና” ያጌ።<verse eid="MIC 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 2:5"/>ሄዋ ድራዉ፥ ጋድያ ኤጻን ግሽያ ዎደ፥ መና ጎዳ ሺቁዋ ግዶን ነ ሳማ ከስያ እት አሳይነ ደኤና።<verse eid="MIC 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MIC 2:6"/>አሳይ ታና ሀዋዳን ያጌ፤ “ኑ ቦላ ትምቢትያ ኦዶፓ። ‘ሀዌ ሀዌ ህንተ ቦላ ሀናና’ ጊደ ኦንነ ሃሳያናዉ ኮሸና። ሄዋ ማላ ካዉሻይ ኑ ቦላ ሙለካ ዬና” ያጊኖ።<verse eid="MIC 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MIC 2:7"/>ታን ኡንቱንታ፥ “ህንተኖ ያቆባ ዛረቶ፥ ‘መና ጎዳ አያናይ ዳንዳያንቻ ግደኔየ? እ ሄዋ ማላባ ኦየ?’ ያጊደ ህንተ ኦቻናዉ በሲ?” ያጋድ።</para>
  <para style="p" vid="MIC 2:7">ጾሳይ ሀዋዳን ያጌ፤ “ሱረ ኦግያን ብያዋንቶ ታ ቃላይ ሎኦባ ኦ ግደኔ? <verse eid="MIC 2:7"/><verse number="8" style="v" sid="MIC 2:8"/>ሽን ማታ ዎድያፐ ዶሚደ፥ ታ አሳይ እቱ እቱዋ ቦላ ሞርክያዳን ደንዴዳ። ህንተ ሳሮ አሳቱዋ ማዩዋ፥ ኦላ ቆፋይ ሙለካ ባይናን አማነቲደ አያ አሳቱዋ ማዩዋ ቃር አኪታ፤ <verse eid="MIC 2:8"/><verse number="9" style="v" sid="MIC 2:9"/>ታ አሳ ግዶን ደእያ ማጫ አሳቱዋ ኡንቱንቱ ሎኦ ጎልያፐ ላግ ከሲታ፤ ታ አንጁዋካ ኡንቱንቱ ናናቱ ቦላፐ መናዉ አክ ድጊታ። <verse eid="MIC 2:9"/><verse number="10" style="v" sid="MIC 2:10"/>ደንዲደ ቢተ! ሀዌ ህንተንቶ ሸምፕያ ሳ ግደና። አያዉ ጎፐ፥ ሀ ሳአይ ቱናተፐ ደንዴዳዋን ዳሮ ባዬዳ።<verse eid="MIC 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MIC 2:11"/>“እት ጭምያ ዎርዳንቻይ ዪደ፥ ‘ህንተዉ ስንፐ ዎይንያ ኤሳይነ ማይያ ኡሻይ ጉፈታና’ ያጊደ ዎርዱዋ ትምቢትያ ኦድንቶ፥ እ ህንተንቶ ትምቢትያ ኦድያዋ ግዳና።<verse eid="MIC 2:11"/></para>
  <para style="s1">ስን ህዶታ</para>
  <para style="r">(<ref loc="MIC 2:12-13">2:12-13</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MIC 2:12"/>“ህንተኖ፥ ያቆባ ዛረቶ፥ ታን ህንተና ኡባካ ሺሻና፤ ታን እስራኤልያ አሳፐ አቴዳዋንታ ቱሙዋፐ ኡባካ ሺሻና። ዶርሳቱ ካሉዋን ሺቅያዋዳንነ ዶርሳ ዉዲ ሄን ጋደን ሺቅያዋዳን፥ ታን ኡንቱንታ እትፐ ሺሻደ ዎና። ሄ ሳአይ ዳሮ አሳ ሻባረቱሳን ኩማና። <verse eid="MIC 2:12"/><verse number="13" style="v" sid="MIC 2:13"/>ኡንቱንታ ከስያዌ ኡንቱንቱፐ ስንቲደ ከሳና፤ ኡንቱንቱካ ፐንግያ መንደ፥ ሄዋና ከሲደ ባና። መና ጎዳይ ባረ ሁጲያን ኡንቱንቶ ካትያ ግዲደ፥ ኡንቱንታ ስንዉ አደ፥ ኡንቱንታ ካለና” ያጌ።<verse eid="MIC 2:13"/></para>
  <chapter eid="MIC 2"/>
  <chapter number="3" style="c" sid="MIC 3"/>
  <para style="s1">ጾሳይ ኢታ ካለያዋንታነ ዎርዶ ናባቱዋ ሙራና</para>
  <para style="r">(<ref loc="MIC 3:1-12">3:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 3:1"/>ታን ሀዋዳን ያጋድ፤ “ህንተኖ፥ ያቆባ ዛራቱዋ ካፓቶነ እስራኤልያ አሳ ካለያዋንቶ፥ ስስተ! ህንተ ሱረ ፕርዳ ኤራናዉ ህንተንቶ በሰኔየ? <verse eid="MIC 3:1"/><verse number="2" style="v" sid="MIC 3:2"/>ህንተ ሎኡዋ እጺደ፥ ኢታ ዶሲታ። ታ አሳፐ ኡንቱንቱ ጋልባ ቃሪታ፤ ኡንቱንቱ አሹዋካ ኡንቱንቱ መቀፐ ሻኪታ። <verse eid="MIC 3:2"/><verse number="3" style="v" sid="MIC 3:3"/>ህንተ ታ አሳ አሹዋ ሚታ፤ ኡንቱንቱ ጋልባካ ኡንቱንቱፐ ቃሪታ፤ ኡንቱንቱ መቀ መንሬደ፥ ኡንቱንቱ አሹዋካ ጻሩዋን የጋናዉ ሙጽያዋዳን ሙጸረቲታ” ያጋድ።<verse eid="MIC 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MIC 3:4"/>ሄ ዎደ ኡንቱንቱ መና ጎዳኮ ዋሳና፥ ሽን እ ኡንቱንቶ ዛረና፤ እ ባረ ዴሙዋ ሄ ዎደ ኡንቱንቱፐ ቆሳና፤ አያዉ ጎፐ፥ ኡንቱንቱ ኢታ ኦሱዋ ኦድኖ።<verse eid="MIC 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 3:5"/>ባረ አሳ ዎራ ካለያ ትምቢትያ ኦድያዋንቱባ መና ጎዳይ ሀዋዳን ያጌ፤ “ህንተዉ ምያዋ እምያ ዎደ፥ ‘ነዉ ሳአይ ሳራ’ ያጊታ፤ ሽን ህንተና ቁማ ምዘናዋ ቦላ ኦላ አዋዪታ። <verse eid="MIC 3:5"/><verse number="6" style="v" sid="MIC 3:6"/>ሄዋ ድራዉ፥ ህንተንቶ ጋላሳይ ቃማ ግዳናፐ አትና፥ ሳፃ በእክታ፤ ሳአይካ ማናፐ አትና፥ ላኤን ሙሩንክታ። ትምቢትያ ኦድያዋንቶ አዋይ ዉልና፥ ጋላሳይ ማና። <verse eid="MIC 3:6"/><verse number="7" style="v" sid="MIC 3:7"/>ሳፃ በእያዋንቱ ዬላታና፤ ሙሩንያዋንቱካ ካዉሻና። ጾሳ ማታፐ ኡንቱንቶ ዛሩ ባይና ድራዉ፥ ኡንቱንቱ ዬላቲደ፥ ኡባይካ ባረንቱ ዶና ኦይቃና” ያጌ።<verse eid="MIC 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 3:8"/>ሽን ታና ግዶፐ፥ ታን ያቆባ ዛረቶ ኡንቱንታ ባይዙዋ፥ እስራኤልያ አሳስካ ኡንቱንቱ ናጋራ ኦዳና ማላ፥ ዎልቃን፥ መና ጎዳ አያናን፥ ሱረ ፕርዳንነ ምኖተን ኩማድ። <verse eid="MIC 3:8"/><verse number="9" style="v" sid="MIC 3:9"/>ህንተኖ፥ ሱረ ፕርዳ እጽያነ ስታ የዉዋካ ዶቂያዋንቶ ያቆባ ዛራቱዋ ካፓቶነ እስራኤልያ አሳ ሞድያዋንቶ፥ ሀዋ ስስተ። <verse eid="MIC 3:9"/><verse number="10" style="v" sid="MIC 3:10"/>ህንተ ጽዮነ ካታማ ሱ ጉሲደ ኬጺታ፤ የሩሳላመ ካታማካ ማካላን ኬጺታ። <verse eid="MIC 3:10"/><verse number="11" style="v" sid="MIC 3:11"/>አ ካፓቱ ማታይያን ፕርዲኖ፤ አ ቄሳቱ ድርጉዋን ታማርሲኖ፤ ቃይ አ ትምቢትያ ኦድያዋንቱካ ሚሻ ቃንጽና ሙሩኒኖ። ሽን ያቲደካ፥ “መና ጎዳይ ኑ ግዶን ደኤ ግደኔ? ኑ ቦላ አያ ኢታባይካ ዬና” ያጊደ መና ጎዳን አማነቲኖ። <verse eid="MIC 3:11"/><verse number="12" style="v" sid="MIC 3:12"/>ሄዋ ድራዉ፥ ህንተ ጋሱዋን ጽዮነ ደርያ ሾይቃዳን ጎሸታና፤ የሩሳላመ ካታማይካ ኮለቲደ እትሳን ዶረቴዳ ሱፓ ሹቻ ግዳናዋ። ጌሻ ጎልያ ኬጸቴዳ ሳአይካ ዎራ ግዳናዋ።<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="JER 26:18">ኤር. 26:18</ref></char></note><verse eid="MIC 3:12"/></para>
  <chapter eid="MIC 3"/>
  <chapter number="4" style="c" sid="MIC 4"/>
  <para style="s1">ኦራ እስራኤላትን ኦራ ጌሻ ጎልያ</para>
  <para style="r">(<ref loc="HOS 4:1-5:15">ሆሰ 4:1—5:15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 4:1"/>ዉርሰ ጋላሳቱዋን መና ጎዳ ጌሻ ጎልያ ኬጸቴዳ ደሪ ደረቱዋ ኡባፐ ቂደ ቤታና፤ ከራ ኡባቱዋፐካ ቦላና ቁ ቁ ጋና። ጋድያ አሳይ አኮ ዛታና። <verse eid="MIC 4:1"/><verse number="2" style="v" sid="MIC 4:2"/>ዳሮ ካዉተቱዋ አሳይ ዪደ፥ “ሃይተ፤ መና ጎዳ ደርያ፥ ያቆባ ጾሳ ጌሻ ጎልያ አነ ፑደ ከሶይተ። እ ኮይያዋዳን ኑን ባና ማላ፥ እ ኑና ባረ ኦግያ ታማርሳና” ያጋና። አያዉ ጎፐ፥ ህጊ ጽዮነፐ፥ መና ጎዳ ቃላይካ የሩሳላመፐ ከሳና። <verse eid="MIC 4:2"/><verse number="3" style="v" sid="MIC 4:3"/>እ ዳሮ አሳቱ ግዱዋን ፕርዳና፤<note caller="-" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="JOL 3:10">ኢዩ. 3:10</ref></char></note> ሃኩዋን ደእያ ምኖ ካዉተቱዋ ፓሉምያካ ሻካና። ኡንቱንቱ ባረንቱ ማሻ ማራሻ፥ ባረንቱ ቶራካ ባጫ ከሳናዉ ቆጻና፤ ካተተይ ካዉተ ቦላ ማሻ ደንና። ሀዋፐ ጉይያን፥ ኡንቱንቱ ኡባና ኦላ ትምርትያ ታማርክኖ። <verse eid="MIC 4:3"/><verse number="4" style="v" sid="MIC 4:4"/>ሽን አሳይ ኡባይ ባረ ዎይንያ ቱራ ኩዋንነ ባላስያ ኩዋን ዎፑ ጊደ ኡታና፤<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="ZEP 3:10">ሶፎ. 3:10</ref></char></note> አይ አሳይነ ኡንቱንታ ያሽሰና። አያዉ ጎፐ፥ ኡባፐ ዎልቃማ መና ጎዳይ ሀዋ ሃሳዬዳ።<verse eid="MIC 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 4:5"/>አሳይ ኡባይ ባረ መና ጎዳ ጾሳ ሱንን ሀመታና፤ ሽን ኑን መና ጎዳ ኑ ጾሳ ሱንን መፐ መናዉ ሀመታና።<verse eid="MIC 4:5"/></para>
  <para style="s1">እስራኤልያ አሳይ ኦሞዱዋፐ ስማና</para>
  <para style="p">
    <verse number="6" style="v" sid="MIC 4:6"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ሄ ጋላስ ታን ዎባቱዋ ሺሻና፤ ቃይ ኦሞዱዋን ሃኮ ሳኣ ቤዳዋንታነ ታን ቱጋዬዳዋንታካ ሺሻና። <verse eid="MIC 4:6"/><verse number="7" style="v" sid="MIC 4:7"/>ታን ዎባቱዋ ዉሪደ አቴዳ አቶዋንታ ኦና፤ ቃይ ኦሞዱዋን ሃኮ ሳኣ ቤዳዋንታካ ምኖ ካዉተ ከሳና። ሄ ዎድያፐ ዶማደ መና ጋካናዉ፥ ታን መና ጎዳይ ጽዮነ ደርያን ኡንቱንቱ ቦላ ካተታና” ያጌ።<verse eid="MIC 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 4:8"/>ኔኖ፥ መና ጎዳ አሳ ዎችያ የሩሳላመ ቃ ግምቢያዉ፥ ነዉ ካሰ ነ ሞድያ ማታይ፥ ቃይ የሩሳላመ ካዉተ ዛዋይ ኡባይካ ስማና።<verse eid="MIC 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MIC 4:9"/>ሀእ ኔን ኮሻ ቁ ኦደ ዋስያዌነ የሉ ኦይቄዳ ምሽራቲዳን ኡንኤያዌ አያሴ? ነዉ ካቲ ባይና ግሻሴየ? ዎይ ኔና ዞርያዌ ዬዳ ድራሴ? <verse eid="MIC 4:9"/><verse number="10" style="v" sid="MIC 4:10"/>ህንተኖ፥ ጽዮነ አሳቶ፥ የሉ ኦይቄዳ ምሽራቲዳን ኦሊደ ጎንዶረትተ። አያዉ ጎፐ፥ ህንተ ካታማፐ ከስያዌ አተና፤ ከሲደ ደምባን ደአና፤ ሄዋፐካ ባብሎነ ባና። ግዶፐነ፥ ያን ህንተ አታና፤ መና ጎዳይ ህንተና ህንተ ሞርከቱዋ ኩሽያፐ ዎዛና።<verse eid="MIC 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MIC 4:11"/>ሽን ሀእ ዳሮ ካዉተቱ ነ ቦላ ሺቄድኖ፤ ሺቂደ፥ “የሩሳላመ ቱኖ፤ ኑ አይፊካ ጽዮነ ደረቆ” ያጊኖ። <verse eid="MIC 4:11"/><verse number="12" style="v" sid="MIC 4:12"/>ሽን ኡንቱንቱ መና ጎዳ ቆፋ ኤርክኖ፤ አ ሀልቹዋካ አኬክክኖ። ካ ቡክያ ኡዱማዉ ሺሼዳ ምርቂያዳን፥ መና ጎዳይ ኡንቱንታ ሙራናዉ ሺሼዳ።<verse eid="MIC 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MIC 4:13"/>ህንተኖ፥ የሩሳላመ አሳቶ፥ ደንድተ፤ ደንዲደ፥ ህንተ ሞርከቱዋ ቆጽተ። ታን ህንተ ካጭያ ብራታ፥ ህንተ ቅንጫፍልያካ ናሃሰ ኦና። ህንተ ዳሮ ካዉተቱዋ ክንቼሬና፤ ኡንቱንቱ ሱገን ሺሼዳባ ኡባ ህንተ መና ጎዳዉ ዱማያና፤ ህንተ፥ ኡንቱንቱ አቁዋካ ሳኣ ኡባ ጎዳዉ እማና ያጌ።<verse eid="MIC 4:13"/></para>
  <chapter eid="MIC 4"/>
  <chapter number="5" style="c" sid="MIC 5"/>
  <para style="p">
    <verse number="1" style="v" sid="MIC 5:1"/>ህንተኖ፥ የሩሳላመ አሳቶ፥ ህንተ ኦላንቻቱዋ ሺሽተ! አያዉ ጎፐ፥ ኑን ሞርከቱዋን ዳደቴዳ፤ ኡንቱንቱካ እስራኤልያ ካለያዋ ጋፓታ ጋትማን ሾጫናዉ ሀኒኖ።<verse eid="MIC 5:1"/></para>
  <para style="s1">ቤተሌመፐ ካለያዌ ከሳናዌ ትምቢትያን ኦደቴዳ</para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 5:2"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ኔኖ ኤፍራታ፥ ቤተሌመ ካታማዉ፥ ኔን ይሁዳ ካታማቱዋ ግዶን ጉ፤ ሽን አዉ ደንዱ በንፐ ዶሚደ፥ መናፐ ግዴዳዌ፥ እስራኤልያ አሳ ሞድያዌ ታዉ ኔፐ ከሳና” ያጌ።<note caller="-" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="MAT 2:6">ማቶሳ 2:6</ref>፤ <ref loc="JHN 7:42">ዮሃ. 7:42</ref></char></note><verse eid="MIC 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 5:3"/>ሄዋ ድራዉ፥ የሉዋ ኦይቀትያ ምሽራታ ሄ ናኣ የላና ጋካናዉ፥ መና ጎዳይ እስራኤልያ አሳ ሞርከቱዋ ኩሽያን አደ እማና። ሄዋፐ ጉይያን፥ ኦሞዱዋን ደእያ አ እሻቱ ስሚደ፥ ባረንቱ አሳና ዋላከታና። <verse eid="MIC 5:3"/><verse number="4" style="v" sid="MIC 5:4"/>እ ያና፤ መና ጎዳ ምኖተን፥ መና ጎዳ ባረ ጾሳ ሱን ግታተን ባረ አሳ ሄማና። እ ሳኣ ጋጻ ጋካናዉ ዎልቃማ ግድያ ድራዉ፥ ኡንቱንቱ ሳሮተን ደአና። <verse eid="MIC 5:4"/><verse number="5" style="v" sid="MIC 5:5"/>እ ኡንቱንቶ ሳሮተ ግዳናዋ።</para>
  <para style="s1" vid="MIC 5:5">መና ጎዳይ እስራኤልያ አሳ አሻናነ ኡንቱንቱ ሞርከቱዋካ ይሳና</para>
  <para style="p" vid="MIC 5:5">አሶረ ጋድያ አሳቱ ኑ ጋድያ ዎራጅያ ዎደነ ኑ ጌሱዋካ የደርሲደ ገልያ ዎደ፥ ኑን አሳ ሄማናዉነ ካለናዉ ግድያነ ግዲደ ፓላህያ አሳ ደንደ፥ ኡንቱንቱና ኦላ ጋከታና። <verse eid="MIC 5:5"/><verse number="6" style="v" sid="MIC 5:6"/>ኡንቱንቱ አሶረ ጋድያ ኦላን ጾናና፤ ቃይ ሄ ጋድያን ደእያ ናምሩድ ኬጼዳ ጋድያ ሞዳና። አሶረ ጋድያ አሳቱ ኑ ጋድያ ዎራጅያ ዎደነ ኑ ዛዋካ የያ ዎደ፥ ኑ ጋድያ ሞድያዌ ኑና ኡንቱንቱፐ አሻና።<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="GEN 10:8-11">ዶመ 10:8-11</ref></char></note><verse eid="MIC 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MIC 5:7"/>ያቆባ ዛራቱ አትያዋንቱ ዳሮ ጋደ አሳ ግዶን መና ጎዳይ ኪቴዳ ጮኩዋ ማላነ ማታ ቦላን ዎያ ፑስያ ማላ ግዳናዋ። ጮኩነ ፑስ ያናዉ አሳ አዛዙዋ ናገናዋዳን፥ እስራኤልያ አሳይካ መና ጎዳፐ አትና፥ አሳ ናገና። <verse eid="MIC 5:7"/><verse number="8" style="v" sid="MIC 5:8"/>ያቆባ ዛራቱ አትያዋንቱ ካዉተቱዋ ግዶን፥ ዳሮ አሳ ግዶን፥ ባዙዋ ዶአቱዋ ግዶን ደእያ ጋሙዋ ማላነ ዶርሳ ዉድያ ግዶን ደእያ ዎዳላ ጋሙዋ ማላ ግዳናዋ። እ ሄዋና ካንያ ዎደ የረረቴነ መንሬ፤ ኦንነ አሻናዉ ዳንዳየና። <verse eid="MIC 5:8"/><verse number="9" style="v" sid="MIC 5:9"/>ነ ኩሺ ኔናና ኤቀትያዋንቱ ቦላ ደንዳና፤ ነ ሞርከቱ ኡባይካ ያና።<verse eid="MIC 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 5:10"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ሄ ጋላስ ታን ነ ፓራቱዋ ነ ግዶፐ ይሳና፤ ነ ፓራ ጋረቱዋካ መንሬና። <verse eid="MIC 5:10"/><verse number="11" style="v" sid="MIC 5:11"/>ታን ነ ጋድያ ካታማቱዋ ይሳና፤ ነ ጌሱዋካ ኡባ ላላና። <verse eid="MIC 5:11"/><verse number="12" style="v" sid="MIC 5:12"/>ቃይ ነ ካዩዋ ታን ይሳና፤ ሙሩንያዋንቱካ ሀዋፐ ስንናዉ ነ ግዶን ደእክኖ። <verse eid="MIC 5:12"/><verse number="13" style="v" sid="MIC 5:13"/>ታን ነ ኤቃ ምስለቱዋነ ነ ጎይናናዉ ኤሴዳ ሹቻቱዋ ነ ግዶፐ ይሳና፤ ሀዋፐ ስንናዉ ኔን ነ ኩሽያን መዳባዉ ጎይናካ። <verse eid="MIC 5:13"/><verse number="14" style="v" sid="MIC 5:14"/>ታን አሼሮ ግያ ጾሳት ምስልያ ነ ግዶፐ ቆላና፤ ነ ካታማቱዋካ ይሳና። <verse eid="MIC 5:14"/><verse number="15" style="v" sid="MIC 5:15"/>ታዉ አዛዘትቤና ካዉተቱዋ ቦላ ይሉዋንነ ሀንቁዋን ታን ሀሉዋ ከሳና” ያጌ።<verse eid="MIC 5:15"/></para>
  <chapter eid="MIC 5"/>
  <chapter number="6" style="c" sid="MIC 6"/>
  <para style="s1">እስራኤልያ ናቁ ቆንጩሳ</para>
  <para style="r">(<ref loc="MIC 6:1-7:7">6:1—7:7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1"/>መና ጎዳይ እስራኤልያ አሳና ሞተትያዋ ስስተ።</para>
  <para style="p" vid="MIC 6:1">“ደንዳ! ደንዳደ ቃ ደረቱዋ ስንን ፕርደታ፤ ኔን ግያዋ ደረቱካ ስስኖ። <verse eid="MIC 6:1"/><verse number="2" style="v" sid="MIC 6:2"/>ህንተኖ ደረቶ፥ ህንተኖ፥ ሳአይ ኤቄዳ ምኖ ባሶቶ፥ መና ጎዳይ ሞትያ ሞቱዋ ስስተ። መና ጎዳይ ባረ አሳና ሞተቴ፤ እስራኤልያ አሳና እ ፓሉመቴ።”<verse eid="MIC 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 6:3"/>መና ጎዳይ ኡንቱንታ ሀዋዳን ያጌ፤ “ታ አሳዉ፥ ታን ህንተና ዋታድታ? ታን ህንተንቶ ዋናደ ቶኩዋ ግዳድታ? አነ ታዉ ኦድተ! <verse eid="MIC 6:3"/><verse number="4" style="v" sid="MIC 6:4"/>ታን ህንተና ግብጼ ጋድያፐ ከሳድ፤ ቃይ ህንተና አይለተፐ ዎዛድ። ህንተና ካለና ማላ ሙሳ፥ አሮናነ ሚርያሞ ህንተዉ ኪታድ።<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="EXO 4:10-16">ከሳ 4:10-16</ref>፤ <ref loc="EXO 12:50-51">12:50-51</ref>፤ <ref loc="EXO 15:20">15:20</ref></char></note> <verse eid="MIC 6:4"/><verse number="5" style="v" sid="MIC 6:5"/>ታ አሳዉ፥ ሞኣባ ካትያ ባላቅ ሀልቼዳዋነ ብኦራ ናአይ ባላም አዉ ዛሬዳዋ ሀሳያ። ሺጽማ ግያ ሳፐ ገልጋል ኔን ብያ ዎደ፥ ኦግያን ሀኔዳዋ አነ ሀሳያ። ሄዋ ሀሳዮፐ፥ ታን መና ጎዳይ ኔና አሻናዉ ኦዳ ኦሱዋ ኔን አኬካና” ያጌ።<note caller="-" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="NUM 22:2-24:25">ፓይ. 22:2—24:25</ref>፤ <ref loc="JOS 3:1-4:19">ኢያሳ 3:1—4:19</ref></char></note><verse eid="MIC 6:5"/></para>
  <para style="s1">መና ጎዳይ ባረ አሳፐ ኮይያዋ</para>
  <para style="p">
    <verse number="6" style="v" sid="MIC 6:6"/>መና ጎዳ፥ ቃ ሳኣን ደእያ ጾሳ ስንን ጎይናናዉ ያደ ታን አያ አካደ ሺቆ? አዉ ጹገትያ ያርሹዋ ግዳና ማላ፥ እት ላይ ግዴዳ ኮሩማቱዋ አካደ፥ አ ስን ዮሻ? <verse eid="MIC 6:6"/><verse number="7" style="v" sid="MIC 6:7"/>መና ጎዳይ ሻአ ዶርሳ ኦርገቱዋን ዎይ ታሙ ሻአ ሻፋቱዋን ደእያ ሃ ኬሻ ዎጋራ ዛይትያን ናሸታንዴ? ታ ናቁዋ ድራዉ፥ ታ ባይራ ናኣ፥ ታ ሸምፑዋ ናጋራ ግሻዉካ ታ የሉዋ እሞሻ?<verse eid="MIC 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 6:8"/>ሀይ አሳዉ፥ መና ጎዳይ ነዉ ሎኦባ ኦድ ዎዳቴ። መና ጎዳይ ኔፐ ኮይያዌ አዬ ጎፐ፥ ኔን ሱረባ ኦናዋ፥ አገና ሲቁዋ በሳናዋነ አሽከተን ነ ጾሳና ሀመታናዋ።<verse eid="MIC 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MIC 6:9"/>መና ጎዳዉ ያይያዌ አዳ ኤራተ። የሩሳላመ ካታማ አሳ ጾሳይ ሀዋዳን ያጌ፤ “ሙራና ጋትማነ ሄ ጋትማ ጊግሴዳዌካ ኦነንቶ አኬክተ። <verse eid="MIC 6:9"/><verse number="10" style="v" sid="MIC 6:10"/>ናጋራንቻ ጎልያን ደእያ ናጋራን ሺሼዳ ሻሉዋነ ታ እጽያ ዎርዶ ማክያ ሚሻቱዋ ታን ዶጋኔየ? <verse eid="MIC 6:10"/><verse number="11" style="v" sid="MIC 6:11"/>ያትና፥ ሀ ዎርዶ ሚዛናን ልክያዋነ ዎርዶ ሚሻን ማክያ አሳ ናጋራ ታን ዋታደ አቶ ጋናዉ ዳንዳያይታ? <verse eid="MIC 6:11"/><verse number="12" style="v" sid="MIC 6:12"/>ሄ ካታማ ዱረቱ ማካላን ኩሜዳዋንታ፤ አን ደእያ አሳይ ኡባይ ዎርዱዋ። ኡንቱንቱ ዶና ግዶን ደእያ ኡንቱንቱ እንጻርሳይካ ባረ ሁጲያዉ ጌላ።<verse eid="MIC 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MIC 6:13"/>“ሄዋ ድራዉ፥ ታን ህንተ ናጋራ ጋሱዋን ህንተና ይሳናዉነ ድጋናዉ ደንዳድ። <verse eid="MIC 6:13"/><verse number="14" style="v" sid="MIC 6:14"/>ህንተ ማና፥ ሽን ካልክታ፤ ናፍሳይካ ህንተፐ ዱጸና። ህንተ ቡሪደ ሺሻና፥ ሽን ህንተንቶ ዳጋተና፤ ህንተ ዳጋዬዳዋካ ታን ኦላ የዳደ ይሳና። <verse eid="MIC 6:14"/><verse number="15" style="v" sid="MIC 6:15"/>ህንተ ካ ዘራና፥ ሽን ጋክና ጫክክታ፤ ዎጋራ ቴራ ጉምአና፥ ሽን ሄ ዛይትያ ኦከትክታ፤ ዎይንያ ቴራካ ህንተ ጉምአና፥ ሽን አ ኤሳ ኡሽክታ። <verse eid="MIC 6:15"/><verse number="16" style="v" sid="MIC 6:16"/>ህንተ ካትያ ኦምራ ዎጋ፥ አ ናኣ ካትያ አካባ ጎለ ኢታ ኦሱዋነ ኡንቱንቱ ዞርያ ካሌዳ ድራዉ፥ ታን ህንተና ይሳና፤ ታን ህንተና አሳይ ኡባይ ቦርያባ ኦና። አሳይ ኡባይ ህንተና ሸቂያ ሸቃካ ህንተ ቶካና” ያጌ።<note caller="-" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="1KI 16:23-34">1 ካታ. 16:23-34</ref>፤ <ref loc="1KI 21:25-26">21:25-26</ref></char></note><verse eid="MIC 6:16"/></para>
  <chapter eid="MIC 6"/>
  <chapter number="7" style="c" sid="MIC 7"/>
  <para style="s1">እስራኤልያ አሳ ቱናተ</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 7:1"/>አየ አና ታኖ! ታን ቴራይ ማጸት ዉር ክችና ዪደ፥ ዎይንያ ቱራፐነ ባላስያ ምፐ ባረ አሞቴዳዋ ደማናዉ ዳንዳይቤና ኮሻቴዳ ብታንያ ማላ ግዳ ክቻድ። <verse eid="MIC 7:1"/><verse number="2" style="v" sid="MIC 7:2"/>ጾሳ ዶስያ ኬካ አሳይ ጋድያን ሙለካ ባዋ፤ አሳ ጋርሳን ሱረ አሳይ ዬዳ። አሳይ ኡባይ አሳ ሱ ጉሳናዉ ዙጊድ ናጌ፤ ቃይ ኡባይካ ባረ እሻ ግትያን ኦይቃናዉ ካሌ። <verse eid="MIC 7:2"/><verse number="3" style="v" sid="MIC 7:3"/>ኡንቱንቱ ኩሸቱ ላኡካ ኢታባ ኦናዉ ሎህ ኡቴድኖ። ካፑነ ዳናይ ማታይያ ኦቺኖ፤ ዎልቃማ አሳቱ ባረንቱ አሞቴዳዋ ኦዲኖ፤ ኡንቱንቱ ኡባይካ እትፐ ኢታ ኦኖ። <verse eid="MIC 7:3"/><verse number="4" style="v" sid="MIC 7:4"/>ኡንቱንቱ ጋርሳን ኤበሎ ኬካ ግያዌ አጉን ማላ፤ ቃይ ኤበሎ ሱረ ግያዌ ጎምኦርያ ማላ። ጾሳይ ትምቢትያ ኦድያዋንቱ ባጋና ኦዴዳዋዳን፥ እ ባረ አሳ ሙሪያ ጋላሳይ ጋኬዳ፤ ኡንቱንቱ ሻቢረትያ ዎዲካ ሀአ።<verse eid="MIC 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 7:5"/>ነ ሾሩዋ አማኖፓ፤ ነ ላግያካ አማነቶፓ። ኔን ቆማደ አቅያ ነ ማቻትዉካ ኦድያዋካ አኬካደ ኦዳ። <verse eid="MIC 7:5"/><verse number="6" style="v" sid="MIC 7:6"/>አያዉ ጎፐ፥ ናአይ ባረ አዉዋ ካ፤ ናታ ባረ ዳይ ቦላ፥ ናኣ ማቻታካ ባረ ቦሎታት ቦላ ደንድኖ፤ አዎ አዉ ሶ አሳይ ሞርከ ግዴ።<note caller="-" style="x"><char style="xo" closed="false">7:6 </char><char style="xt" closed="false"><ref loc="MAT 10:35-36">ማቶሳ 10:35-36</ref>፤ <ref loc="LUK 12:53">ሉቃሳ 12:53</ref></char></note><verse eid="MIC 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MIC 7:7"/>ሽን ታና ግዶፐ፥ ታን ህዶታን መና ጎዳ ጼላሻና፤ ታና አሽያ ጾሳ ታን ናጋሻና፤ ታ ጾሳይ ታዋ ስሳና።<verse eid="MIC 7:7"/></para>
  <para style="s1">አሳይ ጾሳኮ ስሙሳ</para>
  <para style="r">(<ref loc="MIC 7:8-20">7:8-20</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 7:8"/>ታ ሞርክያዉ፥ ታ መቱዋን ናሸቶፓ። ታን ኩንዶፐካ ደንዳና፤ ታን ማን ኡቶፐካ፥ መና ጎዳይ ታዉ ፖአና። <verse eid="MIC 7:8"/><verse number="9" style="v" sid="MIC 7:9"/>ታን ጾሳ ናቃድ፤ ሄዋ ድራዉ፥ እ ታዉ ሞተቲደ፥ ታ ፕርዳ ከሳና ጋካናዉ፥ ታን አ ሀንቁዋ ዳንዳያና። እ ታና ፖኡዋ ከሳና፤ ታንካ እ አሽያ አሹዋ በአና። <verse eid="MIC 7:9"/><verse number="10" style="v" sid="MIC 7:10"/>ሄ ዎደ ታ ሞርኪካ በአና፤ ቃይ ታና፥ “መና ጎዳይ ነ ጾሳይ ሀቃን ደኢ?” ያግ ያግ ቅሊጭያዌ ዬላ ማያና፤ እ ኦግያን ደእያ ኡርቃዳን የትሽንካ ታን ታ አይፍያን በአና።<verse eid="MIC 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MIC 7:11"/>ህንተኖ፥ እስራኤልያ አሳቶ፥ ህንተ ካታማ ግምቢያ ድርሳቱ ድረትያ ጋላሳይ ያና፤ ሄ ጋላስ ህንተ ዛዋይካ አካና። <verse eid="MIC 7:11"/><verse number="12" style="v" sid="MIC 7:12"/>ሄ ጋላስ ህንተ አሳይ ህንተኮ ስማና። ኡንቱንቱ አሶረ ጋድያፐ፥ ግብጼ ካታማቱዋፐ፥ ኤፍራጺሳ ሻፋ ሄራን ደእያ ሳአቱዋፐነ ቃይ ሃኮ ሳን ደእያ አባቱዋ ዶናፐነ ቃ ደረቱዋፐ ህንተኮ ስማና። <verse eid="MIC 7:12"/><verse number="13" style="v" sid="MIC 7:13"/>ሽን ቢታይ አን ደእያ አሳ ኢታተ ጋሱዋን አሳይ ባይና መላ ግዳና።<verse eid="MIC 7:13"/></para>
  <para style="s1">መና ጎዳይ እስራኤልያዉ ቃረቴዳ ቃረታ</para>
  <para style="p">
    <verse number="14" style="v" sid="MIC 7:14"/>ኔን ነ አሳ፥ አራዳ ቢታይ ዩሹዋን ደእያ ባዙዋን ባረካ ደእያ ነ ቡዞ ዶርሳ ዉድያ ነ ጋትማን ሄማ። ኡንቱንቱ ካሰዋዳንካ ባሳነንነ ጋላኣደን ሄመትኖ።<verse eid="MIC 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MIC 7:15"/>መና ጎዳይ፥ “ህንተ ግብጼ ጋድያፐ ከሴዳ ዎድያዳን፥ ታን ህንተና ማላልስያባ በሳና” ያጌ።<verse eid="MIC 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MIC 7:16"/>ካዉተቱ ኡባይ ሄዋ በኢደ ዬላታና፤ ኡንቱንቱ ዎልቃይካ ሀዳ ግድያ ድራዉ፥ ኡንቱንቱ ዬላቲደ፥ ባረንቱ ዶና ኦይቃና፤ ኡንቱንቱ ሀይይካ ቱላና። <verse eid="MIC 7:16"/><verse number="17" style="v" sid="MIC 7:17"/>ኡንቱንቱ ሾሻዳን፥ ቢታ ላጫና፤ ሳኣና ትራን ጎሸትያ መታቱዋዳን ኮኮሪደ፥ ባረንቱ ጌሱዋፐ ከሳና። ዎልቃማ ዳጋማን መና ጎዳኮ፥ ኑ ጾሳኮ፥ ስማና፤ ኡንቱንቱ ኔና ያዪደ ደአና።<verse eid="MIC 7:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MIC 7:18"/>ናቁዋ አቶ ያግያዌ፥ ባረ አሳ አቴዳዋንቱ ማካላ ፓይደናዌ ነ ማላ ጾሳይ ኦኔ? ኔን ሀንቁ ሀንቆሽን፥ መናዉ ደአ አጋካ፤ አያዉ ጎፐ፥ ኔን ነ አሳዉ ነ አገና ሲቁዋ በስያዋን ናሸታሳ። <verse eid="MIC 7:18"/><verse number="19" style="v" sid="MIC 7:19"/>ኔን ኑዉ ቃይካ ቃረታና፤ ኑ ናቁዋ ነ ገድያን የና፤ ኤ ኑ ናጋራካ አባ ጪሙዋን ኦላና። <verse eid="MIC 7:19"/><verse number="20" style="v" sid="MIC 7:20"/>ኔን በንፐካ ዶማደ ኑ ማይዛ አዋቶ ገፓደ ጫቄዳዋዳን፥ አብራሃማነ ያቆባ ዛረ ግዴዳ ነ አሳዉ ነ አማነትያዋነ ነ አገና ሲቁዋ በሳና።<verse eid="MIC 7:20"/></para>
  <chapter eid="MIC 7"/>
</usx>
