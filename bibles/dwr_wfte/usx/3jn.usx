<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Dawuro Full Bible Ethiopic Version</book>
  <para style="h">3 ዮሃንሳ ኪታ</para>
  <para style="toc1">ዮሃንስ ጻፌዳ ሄዘን ኪታ</para>
  <para style="toc2">3 ዮሃንሳ ኪታ</para>
  <para style="toc3">3 ዮሃ.</para>
  <para style="mt1">ዮሃንስ</para>
  <para style="mt2">ጻፌዳ ሄዘን ኪታ</para>
  <para style="imt">ገሉዋ</para>
  <para style="ip">ዮሃንሳ ሄዘን ኪታ፥ የሱስ ኪቴዳ አማንያ አሳ ካለያ ጭማ ዮሃንስ ጻፌዳ። እ ጻፌዳዌካ ጋዮሳ ግያ እት ዎሳ ጎልያ ካለያዋሳ። ጻፊ፥ ጋዮስ ሀራ አማንያዋንታ ማዴዳ ድራዉ አ ጋላቴ፤ ሀራ ባጋና ቃይ ድዮትራፍሳ ጌተትያ መቱዋ መያ ብታንያፐ ናገታና ማላ አኬክሴ።</para>
  <para style="iot">ሸምፓቱዋ ኡባቶ እመቴዳ ቃን ቆፋቱዋ</para>
  <para style="io1">ገሉዋ <char style="ior"><ref loc="3JN 1:1-4">1-4</ref></char></para>
  <para style="io1">ጋዮስ ጋላተቶዋ <char style="ior"><ref loc="3JN 1:5-8">5-8</ref> </char></para>
  <para style="io1">ድዮትራፍሰ ናገታናዳን ኦደቶዋ <char style="ior"><ref loc="3JN 1:9-10">9-10</ref></char></para>
  <para style="io1">ድመጽሮስ ጋላተቶዋ <char style="ior"><ref loc="3JN 1:11-12">11-12</ref></char></para>
  <para style="io1">ዉርሰ ቁትያ <char style="ior"><ref loc="3JN 1:13-15">13-15</ref></char></para>
  <chapter number="1" style="c" sid="3JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1"/>ታን አማንያዋንታ ካለያ ጭማይ፥ ቱሙ ሲቅያ ታ ሲቁዋ ጋዮሳዉ ሀ ዳብዳቢያ ጻፋይ።<note caller="-" style="x"><char style="xo" closed="false">1 </char><char style="xt" closed="false"><ref loc="ACT 19:29">ኪታ 19:29</ref>፤ <ref loc="ROM 16:23">ሮመ 16:23</ref>፤ <ref loc="1CO 1:14">1 ቆሮ. 1:14</ref></char></note> <verse eid="3JN 1:1"/><verse number="2" style="v" sid="3JN 1:2"/>ታ ሲቆ፥ ኔን ጾሳና ደእያ ደኡ ሎአ ግድያዋ ታን ኤርያዋዳን፥ ኔና አያይነ ዋይሰና ማላነ ቃይ ነ አሳተይ ፓጻ ግዳና ማላ፥ ጾሳ ዎሳይ። <verse eid="3JN 1:2"/><verse number="3" style="v" sid="3JN 1:3"/>አያዉ ጎፐ፥ አማሬዳ እሻቱ ዪደ፥ ኡባ ዎደ ኔን ቱማተን ደእያዋነ ነ ቱማተባ ማርካቴዳ ዎደ፥ ታን ዳሮ ናሸታድ። <verse eid="3JN 1:3"/><verse number="4" style="v" sid="3JN 1:4"/>ታ ናናይ<note caller="+" style="f"><char style="fr" closed="false">4 </char><char style="fq" closed="false">ታ ናናይ፦ </char><char style="ft" closed="false">ጎዳ አማኒደ ካልያዋንታ ጉሳ።</char></note> ቱማተን ደእያዋ ስስያዋፐ አደ፥ ታና ናሸችያባይ ባዋ።<verse eid="3JN 1:4"/></para>
  <para style="s1">ጋዮሳባ አሳይ ማርካቴ</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5"/>ታ ሲቆ፥ ኑ እሻቱ እማ ግዶፐካ፥ ኔን ኡንቱንቶ ኦያ ኦሱዋ ኡባን አማነቴዳ ኦሱዋ ኦዳ። <verse eid="3JN 1:5"/><verse number="6" style="v" sid="3JN 1:6"/>ቃይ ኡንቱንቱ ነ ሲቁዋባ አማንያ አሳቶ ማርካቴድኖ፤ ኡንቱንቱ ቃንጸናን ባረ ኦግያ ባና ማላ ጾሳይ ዶስያዋዳን፥ ኔን ሎኦባ ኦደ ኡንቱንታ ማዳርኪ። <verse eid="3JN 1:6"/><verse number="7" style="v" sid="3JN 1:7"/>አያዉ ጎፐ፥ ጾሳ አማነናዉንቱፐ አይነ አከናን፥ ክርስቶሳ ሱን ድራዉ ከሴድኖ። <verse eid="3JN 1:7"/><verse number="8" style="v" sid="3JN 1:8"/>ሄዋ ድራዉ፥ ኑን ቱማተ ኡንቱንቱና እትፐ ኦና ማላ፥ ሀዋንቱ ማላ አሳቱዋ ማዳናዉ በሴ።<verse eid="3JN 1:8"/></para>
  <para style="s1">ድዮትራፍሰ ሴረቴዳ፤ ድመጽሮስ ሳበቴዳ</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9"/>ታን አማንያዋንቶ፥ ዳብዳቢያ ጻፋድ፤ ሽን ኡንቱንቱ ካፑዋ ግዳናዉ ኮይያ ድዮትራፍሰ ኑን ግያዋ አከና። <verse eid="3JN 1:9"/><verse number="10" style="v" sid="3JN 1:10"/>ሄዋ ድራዉ፥ ታን ያ ብያ ዎደ፥ እ ኑ ቦላን ሃሳይያ ኢታ ሃሳያነ እ ኦዳ ኦሱዋ ህንተንቶ ኦዳና፤ ቃይ እ ሄዌ ጉጼዳ ጊደ፥ ኑ እሻቱ ይያ ዎደ ሞከና፤ ሀራይ አቶ ኡንቱንታ ሞካናዉ ኮይያዋንታካ ድጊደ፥ አማንያዋንቱ ግዶፐ ከሴ።<verse eid="3JN 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11"/>ታ ሲቆ፥ ሎኦባፐ አትን፥ ኢታባ ማላቶፓ። ሎኦባ ኦያ ኦንነ ጾሳ አሳ፤ ሽን ኢታባ ኦያ ኦንነ ጾሳ ኤረና።<verse eid="3JN 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12"/>ድመጽሮስ ሎአ ግድያዋ አሳይ ኡባይ ማርካቴ፤ ቱማተይ ባረ ሁጲያንካ አባ ማርካቴ። ኑንካ ቃይ አባ ማርካቴቶ፤ ኑ ማርካተይ ቱማ ግድያዋ ህንተካ ኤሪታ።<verse eid="3JN 1:12"/></para>
  <para style="s1">ዉርሰ ሳሮታ</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13"/>ታን ነዉ ጻፋናዉ ኮዬዳ ዳሮባይ ደኤ፤ ሽን ዋራቃታንነ ቃላምያን ጻፋናዉ ኮይከ። <verse eid="3JN 1:13"/><verse number="14" style="v" sid="3JN 1:14"/>ሽን ታን ማታን ኔናና ጋከታናዉ ቆፓይ፤ ሄ ዎደ ኑን ጋከቲደ ሃሳያና።<verse eid="3JN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15"/>ሳሮተይ ኔናና ግዶ።</para>
  <para style="p" vid="3JN 1:15">ነ ዳባቱ ኔና ሳሮ ሳሮ ያጊኖ። ኑ ዳባቱዋ ኡባ ኡንቱንቱ ሱን ሱን ጼሳደ፥ ታና ሳሮ ሳሮ ጌዳ ያጋ።<verse eid="3JN 1:15"/></para>
  <chapter eid="3JN 1"/>
</usx>
