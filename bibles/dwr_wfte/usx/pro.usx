<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Dawuro Full Bible Ethiopic Version</book>
  <para style="h">ሌምሱዋ</para>
  <para style="toc1">ሌምሱዋ ማጻፋ</para>
  <para style="toc2">ሌምሱዋ</para>
  <para style="toc3">ሌም.</para>
  <para style="mt1">ሌምሱዋ ማጻፋ</para>
  <para style="imt">ገሉዋ</para>
  <para style="ip">ሌምሱዋ ማጻፋይ ሂላ ሃሳያንነ ሌምሱዋ ሃሳያን ጊጌዳ ኦሱዋነ አማኑዋ ትምርትያ። እ ዳሮ ባጋ አሳ ደኡዋን ሀች ሀች ጋከትያ ሀኖቱዋባ ኦዴ። ኮይሮ ዶሚደካ፥ “አዳ ኤራተዉ ዶመይ ጾሳዉ ያይያዋ” ያግ ሀሳይሲደ ዶሜ። እ ታማርስያዌ አማኑዋ ዎጋን አሳይ ኦናባ ጻላላ ግደናን፥ አሳይ ባረ ሀች ሀች ደኡዋን ሀናናዉ በስያ ሎኦ ኤሻነ ኦናዉ በስያ ሎኦ ኦሱዋ ጉጂደ ታማርሴ። ሀ ማጻፋ ግዶን አሽከተባን፥ አሳዉ ቃረትያዋንነ አማነትያዋን ዳሮ ትምርቲ ሌምሱዋን እመቴዳ።</para>
  <para style="iot">ሸምፓቱዋ ኡባቶ እመቴዳ ቃን ቆፋቱዋ</para>
  <para style="io1">ሌምሳቱዋ ዎቲደ ጎኤታነንቶ <char style="ior"><ref loc="PRO 1:1-7">1:1-7</ref></char></para>
  <para style="io1">አዳ ኤራተ ኮያናዳን እመቴዳ ማቁዋ <char style="ior"><ref loc="PRO 1:8-7:27">1:8—7:27</ref></char></para>
  <para style="io1">አዳ ኤራተ ሳቢደ ኦደቴዳ ማዝሙርያ <char style="ior"><ref loc="PRO 8:1-9:18">8:1—9:18</ref></char></para>
  <para style="io1">ሶሎሞና ሌምሳቱዋ <char style="ior"><ref loc="PRO 10:1-29:27">10:1—29:27</ref></char></para>
  <para style="io1">አጉራ ሃሳያ <char style="ior"><ref loc="PRO 30:1-33">30:1-33</ref></char></para>
  <para style="io1">ሊሙኤላ ዳያ ባረ ናኣ ታማርሴዳ ትምርትያ <char style="ior"><ref loc="PRO 31:1-31">31:1-31</ref></char></para>
  <chapter number="1" style="c" sid="PRO 1"/>
  <para style="s1">ሌምሳቱዋ ዎት ጎኤታነንቶ</para>
  <para style="r">(<ref loc="PRO 1:1-7">1:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1"/>ሀዋንቱ እስራኤልያ ካትያ ዳዊታ ናኣ ሶሎሞና ሌምሳቱዋ።<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="1KI 4:32">1 ካታ. 4:32</ref></char></note> <verse eid="PRO 1:1"/><verse number="2" style="v" sid="PRO 1:2"/>ሌምሶቱ አሳይ አዳ ኤራተ፥ ሴራነ ኤራ ሃሳያ አኬካናዉ ማዲኖ። <verse eid="PRO 1:2"/><verse number="3" style="v" sid="PRO 1:3"/>ኡንቱንቱ አዳ ኤራተን፥ ደአና ደኡዋ፥ ጽሎተ፥ ሱረ ፕርዳነ ሱረተ ታማርስያዋንታ፥ <verse eid="PRO 1:3"/><verse number="4" style="v" sid="PRO 1:4"/>ቦዛቶ አኬካ፥ ዎዳላቶ ኤራተነ ዎዛናማተ እምያዋንታ። <verse eid="PRO 1:4"/><verse number="5" style="v" sid="PRO 1:5"/>አዳ ኤራንቻቱ ሀ ሌምሳቱዋ ስሲደ፥ ኤራ ጉጂኖ፤ አኬካንቻ አሳቱካ ሎኦ ዞርያ አኪኖ። <verse eid="PRO 1:5"/><verse number="6" style="v" sid="PRO 1:6"/>ሄዋዳን ሌምሳቱዋነ ኡንቱንቱ ብለ፥ አዳ ኤራንቻቱዋ ሃሳያነ ኡንቱንቱ ቃንእሸቱዋ አኬካናዉ ዳንዳየቴ።<verse eid="PRO 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 1:7"/>አዳ ኤራተዉ ዶመይ መና ጎዳዉ ያይያዋ፤ ሽን ቦዛቱ አዳ ኤራተነ ሴራ ካኖ።<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="JOB 28:28">ኢዮባ 28:28</ref>፤ <ref loc="PSA 111:10">ማዝ. 111:10</ref>፤ <ref loc="PRO 9:10">ሌም. 9:10</ref></char></note><verse eid="PRO 1:7"/></para>
  <para style="s1">አዳ ኤራተ ኮያናዳን እመቴዳ ዞርያ</para>
  <para style="r">(<ref loc="PRO 1:1-7:27">ሌም. 1:1—7:27</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 1:8"/>ታ ናአዉ፥ ነ አቡ ዞርያ ስሳ፤ ነ ዳያ ታማርስያዋካ ዶጎፓ። <verse eid="PRO 1:8"/><verse number="9" style="v" sid="PRO 1:9"/>ሄዌ ነ ሁጲያዉ ቦንቾ ካላቻ፤ ነ ቆያዉካ ሀብልያ ግዳናዋ።<verse eid="PRO 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 1:10"/>ታ ናአዉ፥ ኔና ናጋራንቻቱ ባለፐ፥ ኤኖ ጎፓ። <verse eid="PRO 1:10"/><verse number="11" style="v" sid="PRO 1:11"/>ኡንቱንቱ ኔና፥ “ኑናና ደንዳ፤ አሳ ዎናዉ ቆሰቲደ ናጎይተ፤ ጋሱ ዮፐነ ጽሎቱዋ ዎናዉ ቆሰት ኡቶይተ፤ <verse eid="PRO 1:11"/><verse number="12" style="v" sid="PRO 1:12"/>ስኦሊ ምትያዋዳን፥ ኑንካ ኡንቱንታ ፓጻ ደእሺና ምቶይተ፤ ኑን ኡንቱንታ ጪሞ ኦላን ኦልያ አሳቱዋዳን ኦና። <verse eid="PRO 1:12"/><verse number="13" style="v" sid="PRO 1:13"/>ኑን አልኦ ሚሻ ኡባ ደማና፤ ኑ ጎልያካ ኦሞዱዋን ኩንና፤ <verse eid="PRO 1:13"/><verse number="14" style="v" sid="PRO 1:14"/>ኑናና ዙፐቱዋን፤ ደሜዳዋካ እትፐ ግሸታና” ያጋና።<verse eid="PRO 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 1:15"/>ታ ናአዉ፥ ኡንቱንቱና ኦግያ ሀመቶፓ፤ ነ ገድያ ኡንቱንቱ ሎሱዋ የሶፓ። <verse eid="PRO 1:15"/><verse number="16" style="v" sid="PRO 1:16"/>አያዉ ጎፐ፥ ኡንቱንቱ ኢታባ ኦናዉ ዎጺኖ፤ አሳ ሱ ጉሳናዉ ኤሌሊኖ። <verse eid="PRO 1:16"/><verse number="17" style="v" sid="PRO 1:17"/>ካፉ ጼልሽን፥ አ ኦይቃናዉ ዳባ የግያዌ አይነ ማደና። <verse eid="PRO 1:17"/><verse number="18" style="v" sid="PRO 1:18"/>ሽን ኡንቱንቱ ባረንቱ ሱ ጉሳናዉ ባረንቶ ዎጽማድያ ምጪኖ፤ ባረንቱ ሸምፑዋ ዎናዉ ቆሰት ኡቲኖ። <verse eid="PRO 1:18"/><verse number="19" style="v" sid="PRO 1:19"/>ቦንቂያን ጎኣ ደምያ ኡባቱዋ ዉርሰይ ሄዋ ማላ፤ ሄዌ እዛዉ ሸምፑዋ አኬ።<verse eid="PRO 1:19"/></para>
  <para style="s1">አዳ ኤራተ እጾፐ ኔና ኤራ!</para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 1:20"/>አዳ ኤራተታ ኦግያን ጼሳዉ፤ ጉታራን ባረ ቃላ ቁ ኦደ ስሳዉ።<note caller="-" style="x"><char style="xo" closed="false">1:20-21 </char><char style="xt" closed="false"><ref loc="PRO 8:1-3">ሌም. 8:1-3</ref></char></note> <verse eid="PRO 1:20"/><verse number="21" style="v" sid="PRO 1:21"/>አዳ ኤራተታ አሳይ ሺቅያ ሳኣን ኤቃደ ጼሳዉ፤ ካታማ ገልያ ፐንግያን ኤቃደ፥<verse eid="PRO 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 1:22"/>“ህንተኖ፥ አኬካይ ፓጬዳዋንቶ፥ ህንተ አኬካ ፓጫ አዉደ ጋካናዉ ዶሲቴ? ቅሊጭያዋንቶ፥ ቅሊጭያዋን አዉደ ጋካናዉ ናሸቲቴ? ቦዛቶ፥ ኤራተ አዉደ ጋካናዉ እጺቴ? <verse eid="PRO 1:22"/><verse number="23" style="v" sid="PRO 1:23"/>ታ ሴራኮ ስሞፐ፤ ታን ታ ኤራ ህንተ ቦላ ጉሳና፤ ታ ቃላካ ህንተና ታማርሳና። <verse eid="PRO 1:23"/><verse number="24" style="v" sid="PRO 1:24"/>ታን ጼሴዳ ዎደ፥ ህንተ ኮየናን እጼድታ፤ ታን ኩሽያ ምጭናካ፥ ኦንነ አኬክቤና። <verse eid="PRO 1:24"/><verse number="25" style="v" sid="PRO 1:25"/>ታ ዞርያ ኡባ ካድታ፤ ታ ሴራካ አክበይክታ። <verse eid="PRO 1:25"/><verse number="26" style="v" sid="PRO 1:26"/>ሄዋ ድራዉ፥ ህንተና መቱ ጋክያ ዎደ፥ ታን ህንተ ቦላ ሚጫና፤ ህንተና ባሻይ ጋክያ ዎደ፥ ታን ቅሊጫና። <verse eid="PRO 1:26"/><verse number="27" style="v" sid="PRO 1:27"/>ዳጋማይ ኡሹዋዳን ህንተ ቦላ ይያ ዎደ፥ መቱ ጎትያዳን ህንተ ቦላ ይያ ዎደ፥ ቱጋይነ ዋዪ ህንተ ቦላ ጋክያ ዎደ፥ ታን ህንተና ቅሊጫና።<verse eid="PRO 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 1:28"/>“ሄ ዎደ ኡንቱንቱ ታና ጼሳና፤ ሽን ታን ኮይከ፤ ኡንቱንቱ ታና ምንሲደ ኮያና፤ ሽን ደምክኖ። <verse eid="PRO 1:28"/><verse number="29" style="v" sid="PRO 1:29"/>አያዉ ጎፐ፥ ኡንቱንቱ ኤራተ እጼድኖ፤ መና ጎዳዉ ያይያዋ ዶርበይክኖ። <verse eid="PRO 1:29"/><verse number="30" style="v" sid="PRO 1:30"/>ታ ዞርያ አክበይክኖ፤ ታ ሴራ ኡባካ ካድኖ። <verse eid="PRO 1:30"/><verse number="31" style="v" sid="PRO 1:31"/>ሄዋ ድራዉ፥ ኡንቱንቱ ባረንቱ ኦዳ ኦሱዋ አይፍያ ማና፤ ባረንቱ ቆፔዳ ቆፋ አይፍያካ ካላና። <verse eid="PRO 1:31"/><verse number="32" style="v" sid="PRO 1:32"/>አኬካይ ፓጬዳዋንታ አዳ ኤራተፐ ሃክያዌ ዎ፤ ቦዛቱዋ ሸነኮ ግያዌ ይሴ። <verse eid="PRO 1:32"/><verse number="33" style="v" sid="PRO 1:33"/>ሽን ታን ኦድያዋ ስስያዋንቱ ኡባይ ዎፑ ጊደ፥ ሳሮ ደአና፤ መቱዋ ህርጋፐካ ሸምፓና” ያጋዉ።<verse eid="PRO 1:33"/></para>
  <chapter eid="PRO 1"/>
  <chapter number="2" style="c" sid="PRO 2"/>
  <para style="s1">አዳ ኤራተፐ ቤትያ አንጁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 2:1"/>ታ ናአዉ፥ ኔን ታ ግያዋ አኮፐ፥ ታ አዛዙዋካ ነ ግዶን ምንጆፐ፥ <verse eid="PRO 2:1"/><verse number="2" style="v" sid="PRO 2:2"/>አዳ ኤራተ ሀይዞፐ፥ ነ ዎዛናፐ አኬኮፐ፥ <verse eid="PRO 2:2"/><verse number="3" style="v" sid="PRO 2:3"/>ኤራተ ጼሶፐ፥ አኬካካ ቁ ኦደ ጼሳ። <verse eid="PRO 2:3"/><verse number="4" style="v" sid="PRO 2:4"/>አሳይ ብራ ዎይ ቆሴዳ ሚሻ ኮይያዋዳን፥ ኔን ኤራተ ኮያ። <verse eid="PRO 2:4"/><verse number="5" style="v" sid="PRO 2:5"/>ሄ ዎደ ኔን መና ጎዳዉ ያዬ ግያዌ አየንቶ አኬካና፤ ጾሳካ ሎይደ ኤራና። <verse eid="PRO 2:5"/><verse number="6" style="v" sid="PRO 2:6"/>አያዉ ጎፐ፥ መና ጎዳይ አዳ ኤራተ እሜ፤ አፐ ኤራተይነ አኬካይ ቤቴ። <verse eid="PRO 2:6"/><verse number="7" style="v" sid="PRO 2:7"/>እ ሱረቶ ማድያ ዞርያ ምንጄ፤ ቶሺ ባይናን ሀመትያዋንቶካ እ ጎንዳልያ። <verse eid="PRO 2:7"/><verse number="8" style="v" sid="PRO 2:8"/>ቱሙዋ ፕርዳ ኦግያ ናጌ፤ ባረዉ አማነትያዋንቱ ኦግያካ ናጌ።<verse eid="PRO 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 2:9"/>ሄ ዎደ ኔን ጽሎተ፥ ሱረ ፕርዳ፥ ሱረተነ ሎኦ ኦሱዋ ኡባ ኤራና። <verse eid="PRO 2:9"/><verse number="10" style="v" sid="PRO 2:10"/>አያዉ ጎፐ፥ አዳ ኤራተይ ነ ዎዛና ገላና፤ ኤራተይካ ነ ሸምፖ ናሸቻ ግዳና። <verse eid="PRO 2:10"/><verse number="11" style="v" sid="PRO 2:11"/>ኔና አዱስ ቆፕያዌ ናጋና፤ አኬካይካ ኔና ናጋና። <verse eid="PRO 2:11"/><verse number="12" style="v" sid="PRO 2:12"/>አዳ ኤራተይ ኔና ኢታ አሳቱዋ ኦግያፐ ናጋና፤ ጌላባ ሃሳይያዋንቱፐ አሻና። <verse eid="PRO 2:12"/><verse number="13" style="v" sid="PRO 2:13"/>ኡንቱንቱ ናጋራ ማን ደአናዉ፥ ጽሎተ ኦግያ አጊኖ። <verse eid="PRO 2:13"/><verse number="14" style="v" sid="PRO 2:14"/>ኢታ ኦያዋን ናሸቲኖ፤ ጌላባን ሀሹ ጊኖ። <verse eid="PRO 2:14"/><verse number="15" style="v" sid="PRO 2:15"/>ኡንቱንቱ ኦያዌ ምርቀ፤ ኡንቱንቱ ደኡካ ጌላ።<verse eid="PRO 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 2:16"/>አዳ ኤራተይ ዎሹምያ ምሽራትፐነ ሸሌሽያ ቃላን ሃሳይያ ላገትፐ ኔና አሻና። <verse eid="PRO 2:16"/><verse number="17" style="v" sid="PRO 2:17"/>እዛ ባረ ናአተ አስና አጋዉ፤ ባረ ጾሳ ስንን ጫቀቴዳ ጫቁዋካ ዶጋዉ። <verse eid="PRO 2:17"/><verse number="18" style="v" sid="PRO 2:18"/>እዝ ጎለ ብያዌ ሀይቃናዉ ብያዋ፤ እዝ ኦጊ ሀይቆ ካለ። <verse eid="PRO 2:18"/><verse number="19" style="v" sid="PRO 2:19"/>ኢኮ ብያ ኦንካ ጉየ ስመና፤ ደኡዋ ኦግያካ ደመና። <verse eid="PRO 2:19"/><verse number="20" style="v" sid="PRO 2:20"/>ሄዋ አጋደ፥ ኔን ሎኦ አሳቱዋ ሌምሱዋ ካላ፤ ጽሎ አሳቱዋ ደኡዋካ ቁላ። <verse eid="PRO 2:20"/><verse number="21" style="v" sid="PRO 2:21"/>አያዉ ጎፐ፥ ሱረ አሳቱነ ቶሺ ባይና አሳቱ ቢታን ጋምኢደ ደአና። <verse eid="PRO 2:21"/><verse number="22" style="v" sid="PRO 2:22"/>ሽን ኢታቱ ቢታፐ ቆለታና፤ አማንተናዋንቱካ ሾደቲደ ያና።<verse eid="PRO 2:22"/></para>
  <chapter eid="PRO 2"/>
  <chapter number="3" style="c" sid="PRO 3"/>
  <para style="s1">ጾሳን አማነትያዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 3:1"/>ታ ናአዉ፥ ታን ኔና ታማርስያዋ ዶጎፓ፤ ታ አዛዞቱዋካ ነ ዎዛናን ዎ። <verse eid="PRO 3:1"/><verse number="2" style="v" sid="PRO 3:2"/>አያዉ ጎፐ፥ ኡንቱንቱ ነ ላይ አዱሳና፤ እሻሎ ደኡዋነ ሳሮተ ነዉ ጉጃና። <verse eid="PRO 3:2"/><verse number="3" style="v" sid="PRO 3:3"/>አገና ሲቁነ ቱማተይ ኔፐ ሃኮፕኖ፤ ኡንቱንታ ነ ቆያን ቃቻ፤ ነ ዎዛናንካ ኡንቱንታ ጻፋ። <verse eid="PRO 3:3"/><verse number="4" style="v" sid="PRO 3:4"/>ያቶፐ፥ ኔን ጾሳነ አሳ ስንን ሳበታናነ ናሸታና።<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="LUK 2:52">ሉቃሳ 2:52</ref></char></note><verse eid="PRO 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 3:5"/>ነ ፖሎ ዎዛናን መና ጎዳ አማነታ፤ ነ አኬካን ዘምፖፓ። <verse eid="PRO 3:5"/><verse number="6" style="v" sid="PRO 3:6"/>ኔን ኦያ ኦሱዋ ኡባን አ ስንያ፤ እ ኔና ሱረ ኦግያ ካለና። <verse eid="PRO 3:6"/><verse number="7" style="v" sid="PRO 3:7"/>ኔና ነ ሁጲያን አዳ ኤራንቻ ከሶፓ፤ መና ጎዳዉ ያያ፤ ኢታፐካ ሃካ።<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="ROM 12:16">ሮመ 12:16</ref></char></note> <verse eid="PRO 3:7"/><verse number="8" style="v" sid="PRO 3:8"/>ሄዌ ነ ቦላ ፓጻ ዎና፤ ነ መቀካ ምንሳና። <verse eid="PRO 3:8"/><verse number="9" style="v" sid="PRO 3:9"/>መና ጎዳ ነ ዱረተን ቦንቻ፤ ኮይሮ አይፌዳ ካ ኡባፐካ ጼራ አዉ እምያዋን አ ቦንቻ። <verse eid="PRO 3:9"/><verse number="10" style="v" sid="PRO 3:10"/>ያቶፐ፥ ነ ዬሰቱዋን ካይ ኩማና፤ ነ ባካ አይፈ ዎይንያ ኤሳይ ኩሚደ ፓላሀና።<verse eid="PRO 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 3:11"/>ታ ናአዉ፥ መና ጎዳ ሴራ ካፓ፤ እ ኔና ሴርያ ዎደካ ላንጮፓ።<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="JOB 5:11">ኢዮባ 5:11</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">3:11-12 </char><char style="xt" closed="false"><ref loc="HEB 12:5-6">እብራ. 12:5-6</ref></char></note> <verse eid="PRO 3:11"/><verse number="12" style="v" sid="PRO 3:12"/>አያዉ ጎፐ፥ አዉ ባረ ሲቅያ ናኣ ሴርያዋዳን፥ መና ጎዳይ ባረ ዶስያ ኡራ ሴሬ።<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="REV 3:19">ሳፃ 3:19</ref></char></note> <verse eid="PRO 3:12"/><verse number="13" style="v" sid="PRO 3:13"/>አዳ ኤራተ ደምያ ኡራይ፥ አኬካካ ባረዋ ኦያ ኡራይ አንጀቴዳዋ። <verse eid="PRO 3:13"/><verse number="14" style="v" sid="PRO 3:14"/>አያዉ ጎፐ፥ አፐ ደምያ ጎአይ ዎርቃፐነ ብራፐ ደምያ ጎኣፐ አነ ኬኬ። <verse eid="PRO 3:14"/><verse number="15" style="v" sid="PRO 3:15"/>አዳ ኤራተይ እንቁዋፐ ሎይ አልኤ፤ ኔን ደማናዉ አሞትያ ኡባይ አዳ ኤራተና ልከተና። <verse eid="PRO 3:15"/><verse number="16" style="v" sid="PRO 3:16"/>አዳ ኤራተይ ነ ላይ አዱሴ፤ እ ነዉ ዱረተነ ቦንቹዋ ጉጄ። <verse eid="PRO 3:16"/><verse number="17" style="v" sid="PRO 3:17"/>አ ኦገቱ ናሸችያ ኦገቱዋ፤ አ ሎሱዋ ኡባይካ ሳሩዋ። <verse eid="PRO 3:17"/><verse number="18" style="v" sid="PRO 3:18"/>እ ባረና ኦይቂያዋንቶ ደኡዋ ም፤ አ ምንስ ኦይቂያ ኡባቱካ አንጀቴዳዋንታ።<verse eid="PRO 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 3:19"/>መና ጎዳይ ባረ አዳ ኤራተን ሳኣ መዳ፤ ባረ አኬካንካ ሳሎቱዋ ምንሴዳ። <verse eid="PRO 3:19"/><verse number="20" style="v" sid="PRO 3:20"/>አ ኤራተን ሻፋቱ ጎጊኖ፤ ሻራቱዋፐካ እራይ ቡኬ።<verse eid="PRO 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 3:21"/>ታ ናአዉ፥ ሎኦ አዳ ኤራተነ አዱስ ቆፕያዋ ናጋ፤ ኡንቱንቱ ኔፐ ሻከቶፕኖ። <verse eid="PRO 3:21"/><verse number="22" style="v" sid="PRO 3:22"/>ኡንቱንቱ ነዉ ደኡዋ ግዳና፤ ኡንቱንቱ ነዉ እሻሉዋነ ናሸቻ ደኡዋ እማና። <verse eid="PRO 3:22"/><verse number="23" style="v" sid="PRO 3:23"/>ሄ ዎደ ኔን ነ ኦግያን ህርግ ባይናን ሀመታና፤ ነ ገዲካ በተና። <verse eid="PRO 3:23"/><verse number="24" style="v" sid="PRO 3:24"/>ኔን ግሴዳ ዎደ፥ ያያካ፤ ግሳደካ ማልኦ ገምእሹዋ ገምእሻና። <verse eid="PRO 3:24"/><verse number="25" style="v" sid="PRO 3:25"/>አኬከናን ጋክያ ባሻዉ፥ ዎይ ኢታቱ ይያ ዮ ያያካ። <verse eid="PRO 3:25"/><verse number="26" style="v" sid="PRO 3:26"/>አያዉ ጎፐ፥ መና ጎዳይ ነዉ አማነትያዋ ግዳና፤ ነ ገዲካ ጲርያን ኦይቀተናዳን፥ እ ኔና ናጋና።<verse eid="PRO 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 3:27"/>ነዉ ዎልቃይ ደእሺና፥ መቶቴዳዎ ሎኦባ ኦያዋ አጎፓ። <verse eid="PRO 3:27"/><verse number="28" style="v" sid="PRO 3:28"/>ሀእ ነዉ ደእሺና፥ ነ ሾሮ፥ “ስማደ ያ፤ ታን ነዉ ዎንት እማና” ያጎፓ። <verse eid="PRO 3:28"/><verse number="29" style="v" sid="PRO 3:29"/>ኔናን አማነቲደ፥ ነ ማታን ደእሺና፥ ነ ሾሩዋ ቦላ ኢታባ ኦናዉ ቆፖፓ። <verse eid="PRO 3:29"/><verse number="30" style="v" sid="PRO 3:30"/>ኔና ናቂቤና አሳ፥ ጮ ሞቶፓ። <verse eid="PRO 3:30"/><verse number="31" style="v" sid="PRO 3:31"/>ሱገ ኦያ አሳቱዋ ቁሎፓ፤ ኡንቱንቱ ኢታ ኦሱዋካ ካሎፓ። <verse eid="PRO 3:31"/><verse number="32" style="v" sid="PRO 3:32"/>አያዉ ጎፐ፥ መና ጎዳይ ኢታ ኦያዋንታ እጼ፤ ሽን ሱረቱዋ እ ኡሎፐ ሲቄ። <verse eid="PRO 3:32"/><verse number="33" style="v" sid="PRO 3:33"/>መና ጎዳ ሸቃይ ኢታ ኦያዋንቱ ሶይና፤ ሽን አ አንጁ ሱረባ ሀንያዋንቱ ሶይና። <verse eid="PRO 3:33"/><verse number="34" style="v" sid="PRO 3:34"/>ኦቶረቲደ ቅሊጭያዋንታ ጾሳይካ ቅሊጬ፤ ሽን ባረንታ ካዉሽያዋንታ ናሼ።<note caller="-" style="x"><char style="xo" closed="false">3:34 </char><char style="xt" closed="false"><ref loc="JAS 4:6">ያቆባ 4:6</ref>፤ <ref loc="1PE 5:5">1 ጰጽ. 5:5</ref></char></note> <verse eid="PRO 3:34"/><verse number="35" style="v" sid="PRO 3:35"/>አዳ ኤራንቻቱ ቦንቹዋ ደማና፤ ሽን ቦዛቱ ካዉሻና።<verse eid="PRO 3:35"/></para>
  <chapter eid="PRO 3"/>
  <chapter number="4" style="c" sid="PRO 4"/>
  <para style="s1">ጭንጫተፐ ቤትያ ጎኣ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 4:1"/>ታ ናቶ፥ ህንተ አቡ ዞርያ ስስተ፤ ሎይ ሀይዝተ፤ ያቶፐ፥ ህንተ አኬካና። <verse eid="PRO 4:1"/><verse number="2" style="v" sid="PRO 4:2"/>ታን ህንተዉ ሎኦ ትምርትያ እምያ ድራዉ፥ ታ ትምርትያ አጎፕተ። <verse eid="PRO 4:2"/><verse number="3" style="v" sid="PRO 4:3"/>ታን ታ ሁጲያንካ ታ አቦ ናኣ፤ ታ አትዉካ አ ሲቅያ መጽ እት ናኣ። <verse eid="PRO 4:3"/><verse number="4" style="v" sid="PRO 4:4"/>ታ አቡ ታና ታማርሲደ፥ ሀዋዳን ያጌዳ፤ “ታን ኦድያዌ ነዉ ገሎ፤ ታ አዛዙዋ ናጋ፤ ያቶፐ፥ ኔን ፓጻ ደአና። <verse eid="PRO 4:4"/><verse number="5" style="v" sid="PRO 4:5"/>አዳ ኤራተነ አኬካ ደማ፤ ታን ነዉ ኦዴዳዋ ዶጎፓ፤ ታ ቃላፐ ከሶፓ። <verse eid="PRO 4:5"/><verse number="6" style="v" sid="PRO 4:6"/>አዳ ኤራተዉ ዞክያ ዛሮፓ፤ አያዉ ጎፐ፥ እ ኔና አሻና፤ አ ሲቃ፤ እ ኔና ናጋና። <verse eid="PRO 4:6"/><verse number="7" style="v" sid="PRO 4:7"/>አዳ ኤራተይ ኡባፐ አያ ድራዉ፥ አዳ ኤራተ ደማ። አኬካይ ነ ደእያዋ ኡባ ዉርስ አኮፐካ አ ደማ። <verse eid="PRO 4:7"/><verse number="8" style="v" sid="PRO 4:8"/>ኔን አ ቦንቻ፤ እካ ኔና ቁ ቁ ኦና፤ ኔን አ ኦይቆፐ፥ እ ኔና ቦንቻና። <verse eid="PRO 4:8"/><verse number="9" style="v" sid="PRO 4:9"/>እ ነ ሁጲያን ሳባ ካላቻ ዎና፤ ቦንቾ ካላቻ እማና” ያጌዳ።<verse eid="PRO 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 4:10"/>ታ ናአዉ፥ ስሳ፤ ታን ግያዋካ አካ፤ ነ ደኡዋ ላይይካ አዱቃና። <verse eid="PRO 4:10"/><verse number="11" style="v" sid="PRO 4:11"/>ታን ኔና አዳ ኤራተ ኦግያ ካለና፤ ሱረ ሎሱዋናካ አፋና። <verse eid="PRO 4:11"/><verse number="12" style="v" sid="PRO 4:12"/>ኔን ሀመትያ ዎደ፥ ነ ሀመትያሳን ቢያዌ ደኤና፤ ዎጾፐካ በታካ። <verse eid="PRO 4:12"/><verse number="13" style="v" sid="PRO 4:13"/>ታማሬዳዋ ሀሳያ፥ የዶፓ፤ ትምርቲ ነዉ ደኡዋ ግዴዳ ድራዉ፥ ሎይ ናጋ። <verse eid="PRO 4:13"/><verse number="14" style="v" sid="PRO 4:14"/>ናጋራንቻቱዋ ኦግያ የፓ፤ ኢታ አሳቱዋ ኦግያንካ ሀመቶፓ፤ <verse eid="PRO 4:14"/><verse number="15" style="v" sid="PRO 4:15"/>አፐ ሃካ፤ አን ሀመቶፓ፤ አፐ ጉየ ስማ፤ ያታደ ነ ኦግያን ባ። <verse eid="PRO 4:15"/><verse number="16" style="v" sid="PRO 4:16"/>አያዉ ጎፐ፥ ኡንቱንቱ ኢታባ ኦና ጋካናዉ፥ ገምእሻናዉ ዳንዳይክኖ፤ ኡንቱንቱ አሳ በናን ኡንቱንታ ገምእሹ አፈና። <verse eid="PRO 4:16"/><verse number="17" style="v" sid="PRO 4:17"/>ኡንቱንቱ ናጋራ ኡክዳን ሚኖ፤ ሱገ ኦሱዋካ ኡሻዳን ኡሺኖ።<verse eid="PRO 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 4:18"/>ጽሎቱዋ ኦጊ ሴታ ጋላሳይ ጋካናዉ፥ ጉጅ ጉጅ ፖእያ ዎንታ ጻልቂያ ማላ። <verse eid="PRO 4:18"/><verse number="19" style="v" sid="PRO 4:19"/>ሽን ናጋራንቻቱዋ ኦጊ ጵ ጎ ማ ማላ፤ ኡንቱንቱ ዎት በትንቶካ ኤርክኖ።<verse eid="PRO 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 4:20"/>ታ ናአዉ፥ ታን ኦድያዋ ስሳ፤ ታን ኦድያዋካ ሎይደ ሀይዛ። <verse eid="PRO 4:20"/><verse number="21" style="v" sid="PRO 4:21"/>ታን ኦዴዳባቱ ነ አይፍያፐ ጌሞፕኖ፤ ኡንቱንታ ነ ዎዛናን ዎ። <verse eid="PRO 4:21"/><verse number="22" style="v" sid="PRO 4:22"/>አያዉ ጎፐ፥ ኡንቱንታ ደምያ አሳዉ ኡባዉ ደኡዋ እሚኖ፤ ኡንቱንቱ ቦላዉካ ፓጻተ እሚኖ። <verse eid="PRO 4:22"/><verse number="23" style="v" sid="PRO 4:23"/>ኡባባፐካ ነ ዎዛና ምንሳደ ናጋ፤ አያዉ ጎፐ፥ ደኡ አፐ ፑልቴ። <verse eid="PRO 4:23"/><verse number="24" style="v" sid="PRO 4:24"/>ነ ዶናፐ ገነ ሃሳያ ድጋ፤ ዎርዶ ሃሳያ ነ ዶናፐ ድጋ። <verse eid="PRO 4:24"/><verse number="25" style="v" sid="PRO 4:25"/>ስት ጋደ ስንዉ ጼላ፤ ነ አይፊ ነ ስንን ደእያዋ ትሽ ኦደ ጼሎ። <verse eid="PRO 4:25"/><verse number="26" style="v" sid="PRO 4:26"/>ነ ገድያዉ ሀመትያ ኦግያ ሱርሳ፤ ሱረ ኦግያ ጻላላን ሀመታ።<note caller="-" style="x"><char style="xo" closed="false">4:26 </char><char style="xt" closed="false"><ref loc="HEB 12:13">እብራ. 12:13</ref></char></note> <verse eid="PRO 4:26"/><verse number="27" style="v" sid="PRO 4:27"/>ሱረ ኦግያፐ ኡሸቻ ሀድርሳ ጎፓ፤ ነ ገዲ ኢታሳ ቤናዳን ናጋ።<verse eid="PRO 4:27"/></para>
  <chapter eid="PRO 4"/>
  <chapter number="5" style="c" sid="PRO 5"/>
  <para style="s1">ዎሹማፐ ሃካ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 5:1"/>ታ ናአዉ፥ ታ አዳ ኤራተ ሀይዛ፤ ነ ሀይ ታ አኬካኮ የጋ። <verse eid="PRO 5:1"/><verse number="2" style="v" sid="PRO 5:2"/>ያቶፐ፥ አዱሳ ቆፋይ ነዉ ደአና፤ ነ ሃሳያይካ ነ ኤራተ ቆንጭሳና።<verse eid="PRO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 5:3"/>ዎሹምያ ማጫ ምሽራት እንጻርሳፐ ኤሳ እልሉ ጾኬ፤ እ ሃሳያይ ኦይሳፐካ አ ሹጌ። <verse eid="PRO 5:3"/><verse number="4" style="v" sid="PRO 5:4"/>ሽን እዛ ዉርሰን ጎዳረ ኡዳን ጫማዉ፤ ላኡ ባጋን ቃንጽያ ማሻዳን ቃንጽያኖ፤ <verse eid="PRO 5:4"/><verse number="5" style="v" sid="PRO 5:5"/>እ ገደቱ ሀይቁዋኮ ዱገ ቢኖ፤ እ ሀመታይ ስት ኦደ፥ ዱፉዋ አፌ። <verse eid="PRO 5:5"/><verse number="6" style="v" sid="PRO 5:6"/>እዛ ደኡዋ ኦግያ ቆፑኩ፤ እ ኦገቱ ጌላ፤ ሽን ጌላ ግድያዋካ አ ኤሩኩ።<verse eid="PRO 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 5:7"/>ታ ናቶ፥ ሀእካ ታን ኦድያዋ ስስተ፤ ታን ግያዋፐ ከሶፕተ። <verse eid="PRO 5:7"/><verse number="8" style="v" sid="PRO 5:8"/>ዎሹምያ ማጫ ምሽራት ሄራ ቦፕተ፤ እ ጎልያ ፐንግያኮ ሺቆፕተ። <verse eid="PRO 5:8"/><verse number="9" style="v" sid="PRO 5:9"/>ሄዌ ዮፐ፥ ህንተ ህንተንቱ ቦንቹዋ ሀራቶ አደ እማና። ህንተንቱ ህንተንቱ ያላጋተን መቀ ባይና አሳቱዋ ኩሽያን ሀይቃና። <verse eid="PRO 5:9"/><verse number="10" style="v" sid="PRO 5:10"/>ህንተንቱ ማጹዋ አላጋ አሳቱ አካና። ህንተ ዳቡሪደ ሺሼዳዌ ሀራ አሳዉ ግዳናዋ። <verse eid="PRO 5:10"/><verse number="11" style="v" sid="PRO 5:11"/>ዉርሰን ህንተ አሹነ ህንተ አሳተይ ግልቂና፥ ህንተ ኦላና። <verse eid="PRO 5:11"/><verse number="12" style="v" sid="PRO 5:12"/>ቃይ ሀዋዳን ያጋንታ፤ “ታን ትምርትያ አያዉ እጻድታሻ! ታ ዎዛናይካ ሴራ አያዉ ካዴሻ! <verse eid="PRO 5:12"/><verse number="13" style="v" sid="PRO 5:13"/>ታን ታና ታማርስያዋንቱ ኦዴዳዋ አካበይከ፤ ታና ዞርያዋንቱ ዞርያካ ሀይዛበይከ። <verse eid="PRO 5:13"/><verse number="14" style="v" sid="PRO 5:14"/>ሄዋ ድራዉ፥ ታን አሳይ ሺቄዳ ሺቁዋን፥ አኬከናን ካዉሻናዉ ደአይ” ያጋና።<verse eid="PRO 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 5:15"/>ነ ማቻትዉ አማነቴዳዋ ግዳ፤ እዝ ጻላላ ሲቃ። <verse eid="PRO 5:15"/><verse number="16" style="v" sid="PRO 5:16"/>ሀራ ማጫንፐ የለቴዳ ነ ናናቱ፥ ነዉ ሎኦባ ኦክኖ። <verse eid="PRO 5:16"/><verse number="17" style="v" sid="PRO 5:17"/>ኡንቱንቱ ኔና ማዳናዉ ድጭኖ፤ አላጋ ግዶፕኖ።<verse eid="PRO 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 5:18"/>ሄዋ ድራዉ ነ ማቻትና ናሸታ፤ ያላጋተን ኔን አኬዳ ነ ማቻትፐ ናሸቻ ኮያ። <verse eid="PRO 5:18"/><verse number="19" style="v" sid="PRO 5:19"/>ሎእያ ጋራትዳንነ ናሸችያ ገንአቲዳን፥ እ ንይ ኡባ ዎደካ ኔና አሎ፤ ኡባ ዎደ እ ሲቁ ኔና ኦሞዶ። <verse eid="PRO 5:19"/><verse number="20" style="v" sid="PRO 5:20"/>ታ ናአዉ፥ ዎሹምያ ምሽራታ ኔና አያዉ ኦሞዳይ? ሀራ አሳ ማቻቶ አያዉ ቆማይ?<verse eid="PRO 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 5:21"/>አያዉ ጎፐ፥ አሳይ ኦያዋ ኡባ መና ጎዳይ በኤ፤ እ ሀመትያ ሎሱዋ ኡባ ጼሌ። <verse eid="PRO 5:21"/><verse number="22" style="v" sid="PRO 5:22"/>ናጋራንቻ እ ኦዳ ናጋራይ ኦይቄ። አ ናጋራ ግቲ አ ቃቼ። <verse eid="PRO 5:22"/><verse number="23" style="v" sid="PRO 5:23"/>እ ባረ ቦዛተን ሀሌዳ፤ ባረ ሁጲያ ናግቤና ድራዉ ሀይቄዳ።<verse eid="PRO 5:23"/></para>
  <chapter eid="PRO 5"/>
  <chapter number="6" style="c" sid="PRO 6"/>
  <para style="s1">ሀች ሀች ደኦ ማድያ ትምርትያ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 6:1"/>ታ ናአዉ፥ ኔን ሚሻ ታልኤዳ ነ ሾሮ ዋሰ ገሌዳዋ ግዶፐ፥ ኔን ኤረና ኡራዉ ነ ኩሽያ ባቃደ ገፔዳዋ ግዶፐ፥ <verse eid="PRO 6:1"/><verse number="2" style="v" sid="PRO 6:2"/>ኔን ገፔዳ ገፋ ግትያን ገሌዳዋ ግዶፐ፥ ነ ዶናፐ ከሴዳ ቃላን ኦይቀቴዳዋ ግዶፐ፥ <verse eid="PRO 6:2"/><verse number="3" style="v" sid="PRO 6:3"/>ስም ኔን ነ ሾሩዋ ኩሽያን ገላዳ። ሄዋ ድራዉ፥ ታ ናአዉ፥ ሄዋፐ ከሳናዉ ኮዮፐ፥ ኤለ ነ ሾሩዋ ጎለ ባ፤ ዋሰተ እ ነ ቦላፐ ዎና ማላ፥ አዉዳሻደ አ ዎሳ። <verse eid="PRO 6:3"/><verse number="4" style="v" sid="PRO 6:4"/>ሀዋ ኦናን ደኣደ ገምእሾፓ፤ ሸምፑዋካ ሸምፖፓ። <verse eid="PRO 6:4"/><verse number="5" style="v" sid="PRO 6:5"/>ሻንካንቻቱዋፐ ገንአታ ከሳ አክያዋዳን፥ ዳባፐ ካፋታ አትያዋዳን፥ ነ ሁጲያ አሻ።<verse eid="PRO 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 6:6"/>ኔኖ አዛላዉ፥ ቃጮቱዋኮ ባ፤ ኡንቱንቱፐ ታማራ። ያቲደ አዳ ኤራንቻ ግዳ። <verse eid="PRO 6:6"/><verse number="7" style="v" sid="PRO 6:7"/>ቃጮቱዋ ኦስሳናዉ፥ ካፑ ዎይ ኡንቱንታ ሞድያዌ ባዋ፤ <verse eid="PRO 6:7"/><verse number="8" style="v" sid="PRO 6:8"/>ሽን ባረንቶ ማናባ ቦንያን ምንጂኖ፤ ካ ጫክያ ዎደካ ባረንቶ ኮሽያ ቁማ ሺሺኖ። <verse eid="PRO 6:8"/><verse number="9" style="v" sid="PRO 6:9"/>ኔኖ አዛላዉ፥ ኔን አዉደ ጋካናዉ ገምእሻይ? ነ ገምእሹዋፐካ አዉደ ደንዳይ? <verse eid="PRO 6:9"/><verse number="10" style="v" sid="PRO 6:10"/>ኔን ቃይካ ጉ ግሳሳ፤ ጉ ገምእሻሳ፤ ኩሽያ ሺሻ አካደ፥ ጉ ሸምፓሳ።<note caller="-" style="x"><char style="xo" closed="false">6:10-11 </char><char style="xt" closed="false"><ref loc="PRO 24:33-34">ሌም. 24:33-34</ref></char></note> <verse eid="PRO 6:10"/><verse number="11" style="v" sid="PRO 6:11"/>ያትያ ዎደ ህዬሳተይ ፓንጋዳን፥ ፓጫይ ኦላ ሚሻ ኦይቄዳ አሳዳን፥ ነ ቦላ ያና።<verse eid="PRO 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 6:12"/>ኢታ አሳይነ ባላ አሳይ፥ ዩይ ዩዪደ ዎርዱዋ ኦዴ፤ <verse eid="PRO 6:12"/><verse number="13" style="v" sid="PRO 6:13"/>እ ባረ አይፍያን ስምኤ፤ ባረ ገድያን በሴ፤ ባረ ብራያን ጾርሴ። <verse eid="PRO 6:13"/><verse number="14" style="v" sid="PRO 6:14"/>አ ዎዛናን ጌላተይ ደኤ፤ እ ኢታባ ቆፔ፤ ኡባ ገደካ እ ዋላሳ መ። <verse eid="PRO 6:14"/><verse number="15" style="v" sid="PRO 6:15"/>ሄዋ ጋሱዋን ባሻይ አኬከናን አ ቦላ ያና፤ እ ሀሳየናን መአና፤ መኢደካ ፓጸና።<verse eid="PRO 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 6:16"/>መና ጎዳይ እጽያ ኡሱፑን የዎቱ ደኢኖ፤ እ ላፑንያዋ ኢስ እጼ:<verse eid="PRO 6:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 6:17"/>ካደ ጼልያ አይፍያ፥</para>
  <para style="q2" vid="PRO 6:17">ዎርዶትያ እንጻርሳ፥</para>
  <para style="q2" vid="PRO 6:17">ጌሻ አሳቱዋ ሱ ጉስያ ኩሽያ፥<verse eid="PRO 6:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 6:18"/>ኢታባ ማቂያ ዎዛና፥</para>
  <para style="q2" vid="PRO 6:18">ኢታባኮ ኤሌሊደ ዎጽያ ገድያ፥<verse eid="PRO 6:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 6:19"/>ዎርዱዋ ቦላ ዎርዱዋ ጉጅ ጉጂደ ኦድያ ዎርዶ ማርካ፥</para>
  <para style="q2" vid="PRO 6:19">እሻቱዋ ግዶን ዋላሳ መያ አሳ።<verse eid="PRO 6:19"/></para>
  <para style="s1">ዎሹምያ አሳይ ሙረተናን አተና</para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 6:20"/>ታ ናአዉ፥ ነ አቡ አዛዙዋ ፖላ፤ ነ አታ ኔና ታማርሴዳዋካ አጎፓ፤ <verse eid="PRO 6:20"/><verse number="21" style="v" sid="PRO 6:21"/>ኡንቱንታ ኡባ ገደ ነ ዎዛናን ኦይቃ፤ ነ ቆያንካ ቃቻ። <verse eid="PRO 6:21"/><verse number="22" style="v" sid="PRO 6:22"/>ኔን ሀመትያ ዎደ፥ ኡንቱንቱ ኔና ካለና፤ ኔን ግስያ ዎደ፥ ኡንቱንቱ ኔና ናጋና፤ ኔን ቤጎትያ ዎደካ፥ ኡንቱንቱ ኔና ዞራና። <verse eid="PRO 6:22"/><verse number="23" style="v" sid="PRO 6:23"/>አያዉ ጎፐ፥ ሀ አዛዞቱ ጾምፕያ፤ ትምርተቱካ ፖኡዋ፤ ቃይ ሴራይካ ደኡዋኮ አፍያ ኦግያ። <verse eid="PRO 6:23"/><verse number="24" style="v" sid="PRO 6:24"/>ሀ አዛዞቱነ ሀ ትምርተቱ ኢታ ማጫንፐነ ሀራ ምሽራት ሸሌሽያ እንጻርሳፐ ኔና ናጋና። <verse eid="PRO 6:24"/><verse number="25" style="v" sid="PRO 6:25"/>እ ማላ ነ ዎዛናን አሞቶፓ፤ እ አይፍያ ሎኦተን ኦሞደቶፓ። <verse eid="PRO 6:25"/><verse number="26" style="v" sid="PRO 6:26"/>እት አቱማ አሳይ ጫራቶ እት ኡክ ጋትያን ደማናዉ ዳንዳዬ፤ ሽን አስናይ ደእያ ምሽራትና ዎሹሙሳይ ሸምፑዋ ዎሴ። <verse eid="PRO 6:26"/><verse number="27" style="v" sid="PRO 6:27"/>እት አሳይ ታማ እድምና፥ አ ማዩ ሜተተናን አታናዉ ዳንዳዪ? <verse eid="PRO 6:27"/><verse number="28" style="v" sid="PRO 6:28"/>እት አሳይ ታማ ቦንቁዋ የ ሀመትና፥ አ ገዲ ጹገተናን አታኔ? <verse eid="PRO 6:28"/><verse number="29" style="v" sid="PRO 6:29"/>አሳ ማቻትኮ ገልያ ኡራይ ሄዋካ ማላ፤ እዞ ቦችያ ኡባይ ሙረተናን አተና። <verse eid="PRO 6:29"/><verse number="30" style="v" sid="PRO 6:30"/>ካይሱ ኮሻቲደ፥ ባረዉ ማናዉ ዉኦፐ፥ አሳይ አ ካና። <verse eid="PRO 6:30"/><verse number="31" style="v" sid="PRO 6:31"/>ሽን እ ኦይቀቴዳዋ ግዶፐ፥ ላፑን ዳኩዋ ጭጋና፤ ባረ ሶ ሚሻ ኡባካ እማና። <verse eid="PRO 6:31"/><verse number="32" style="v" sid="PRO 6:32"/>ሽን ዎሹምያ አሳይ ዎዛና ፓጫ፤ ሄ ኡራይ ባረ ሸምፑዋ ባይዜ። <verse eid="PRO 6:32"/><verse number="33" style="v" sid="PRO 6:33"/>ማዱጻናነ ቶሸታና። ኡባ ዎደካ እ ቦረቲደ ደአና። <verse eid="PRO 6:33"/><verse number="34" style="v" sid="PRO 6:34"/>አያዉ ጎፐ፥ ማጫ ምሽራት አስናይ ምሸቲደ፥ ሀንቁዋ ሱላና፤ ባረ ሀሉዋ ከስያ ዎደ፥ አዉ ቃረተና። <verse eid="PRO 6:34"/><verse number="35" style="v" sid="PRO 6:35"/>እ አያ አጫካ አከና፤ አይ ኬሻ እሙካ አ ሀንቁዋ ዶሽሰና።<verse eid="PRO 6:35"/></para>
  <chapter eid="PRO 6"/>
  <chapter number="7" style="c" sid="PRO 7"/>
  <para style="s1">ዎሹምያ ምሽራት ጭሙዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 7:1"/>ታ ናአዉ፥ ታ ቃላ ናጋ፤ ታ አዛዙዋካ ነ ጋርሳን ቆሳ። <verse eid="PRO 7:1"/><verse number="2" style="v" sid="PRO 7:2"/>ነዉ ፓጻ ደአናዉ ታ አዛዝያዋ ኦ፤ ታ ትምርትያካ ነ አይፍያ ቡሉዋዳን ናጋ። <verse eid="PRO 7:2"/><verse number="3" style="v" sid="PRO 7:3"/>ሀሳይስያዋዳን ኡንቱንታ ነ ብራቱዋን ቃቻ፤ ነ ዎዛናንካ ጻፋ። <verse eid="PRO 7:3"/><verse number="4" style="v" sid="PRO 7:4"/>አዳ ኤራተ ነ ምቻትዳን፥ አኬካካ ነ ማታ ዳቡዋዳን ጼላ። <verse eid="PRO 7:4"/><verse number="5" style="v" sid="PRO 7:5"/>ኡንቱንቱ ኔና ጫራትያ ምሽራትፐነ ባረ ቃላን ሸሌሽያ ሀራ ምሽራትፐ ናጋና።<verse eid="PRO 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 7:6"/>እት ጋላስ ታን ታ ጎልያ ማስኮትያና ካረ ጼላድ፤ <verse eid="PRO 7:6"/><verse number="7" style="v" sid="PRO 7:7"/>ዎዛና ኩንቤና ዎዳላ ናናቱዋ በኣድ። ኡንቱንቱ ግዶፐ እቱ ሎይ ቦዛ። <verse eid="PRO 7:7"/><verse number="8" style="v" sid="PRO 7:8"/>ሄ ዎዳላይ ኦግያና ቢደ፥ እት ዎሹምያ ማጫ ምሽራት ጎልያ ማታና አዳ፤ እ ጎለ አፍያ ኦግያኮ ፕኒደ፥ እ ጎልያ ሄራን ሀመቴ። <verse eid="PRO 7:8"/><verse number="9" style="v" sid="PRO 7:9"/>ሄ ዎደ ሳአይ ቃማናዉ ለምእለምኤ። <verse eid="PRO 7:9"/><verse number="10" style="v" sid="PRO 7:10"/>ሄዋፐ ጉይያን፥ ምሽራታ አ ደማዱ። እዛ ጫራቶ ግድያዋ እዝ ማዩ ኤርሴ። እዛ አሳ ጭማናዉ ቆፓደ ከሳዱ። <verse eid="PRO 7:10"/><verse number="11" style="v" sid="PRO 7:11"/>እዛ ጻላነ ዬላይ ባይና ማጫ አሳ፤ ሶን ዎፑ ጋደ ኡቱኩ። <verse eid="PRO 7:11"/><verse number="12" style="v" sid="PRO 7:12"/>እዛ እት ገደ ኦግያን፥ እት ገደ ገያን፥ ዳባባ ኡባን ኤቃደ ናጋዉ።<verse eid="PRO 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 7:13"/>አ ሄ ናኣ ቆማደ የራዱ፤ እዛ አ አይፍያ ዬል ባይናን ትሽ ኦ ጼላደ ሀዋዳን ያጋዱ፤ <verse eid="PRO 7:13"/><verse number="14" style="v" sid="PRO 7:14"/>“ታን ታ ያርሹዋ ያርሻደ፥ ታ ቃንገ ሀእ ጋ ስማይ። <verse eid="PRO 7:14"/><verse number="15" style="v" sid="PRO 7:15"/>ያታደ ኔና ጾሞሳናዉ ከሳድ፤ ኔና ሎይ ኮያድ፤ ሀእ ስም ደማድ። <verse eid="PRO 7:15"/><verse number="16" style="v" sid="PRO 7:16"/>ታን ግብጼፐ ዬዳ፥ አሌቄዳ አንሶላ ታ ሂጻን የጋድ። <verse eid="PRO 7:16"/><verse number="17" style="v" sid="PRO 7:17"/>ታን ካዋራ፥ አልሙንያነ ቃራፋ ጌተትያ ቅማማቱዋፐ ከሴዳ ሽቱዋ ታ ሂጻን ጫጫፋድ። <verse eid="PRO 7:17"/><verse number="18" style="v" sid="PRO 7:18"/>ሃያ፤ አነ ዎንታና ጋካናዉ ሲቁዋ አሎይተ፤ ቆመቲደካ ናሸቶይተ፤ <verse eid="PRO 7:18"/><verse number="19" style="v" sid="PRO 7:19"/>አያዉ ጎፐ፥ ታ አስናይ ሶን ግደና፤ ሃኮ ሳ ቤዳ። <verse eid="PRO 7:19"/><verse number="20" style="v" sid="PRO 7:20"/>ሚሻ ቃርጪታ ኩን አኪደ ቤዳ ድራዉ፥ አገናይ ዶይሳና ጋካናዉ ጎለ ስመና” ያጋዱ።<verse eid="PRO 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 7:21"/>ባረ ማልኦ ሃሳያን አ ሸሌሻዱ፤ ባረ ሊቆ እንጻርሳን ጭማዱ። <verse eid="PRO 7:21"/><verse number="22" style="v" sid="PRO 7:22"/>ያትና፥ ኤለካ እ እዞ ካሊደ፥ ብ አጌዳ። ቦራይ ሹክያሳ ላገትያዋዳን፥ ጋራይ ኤሌሊደ ጲርያን ገልያዋዳን፥ <verse eid="PRO 7:22"/><verse number="23" style="v" sid="PRO 7:23"/>ቶራይ አ ዎዛና ጫድያዋዳን ሀኔዳ። ዳባ ግዶ ገሌዳ ካፉዋ ማላቴዳ። ሀዌ ኡባይ አ ሸምፑዋ ባይዛናዉ ሀንያዋ ኤርቤና።<verse eid="PRO 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 7:24"/>ታ ናናዉ፥ አነ ሀእ ስስተ፤ ታ ዶናፐ ከስያ ቃላካ ሀይዝተ። <verse eid="PRO 7:24"/><verse number="25" style="v" sid="PRO 7:25"/>ነ ቆፋይ ሄ ማጫ ምሽራትና ቦፖ፤ እ ኦግያን ገላደ ባለቶፓ። <verse eid="PRO 7:25"/><verse number="26" style="v" sid="PRO 7:26"/>አ ጫዳደ ኦሌዳዋንቱ ኡንደኔዳዋንታ፤ አ ዎዳዋንቱካ ሎይ ዳራ። <verse eid="PRO 7:26"/><verse number="27" style="v" sid="PRO 7:27"/>እ ሶያይ ዱፉዋኮ አፍያ ኦግያ፤ ሄ ኦጊ ዱገ ሀይቁዋ ጌሱዋ ካለ።<verse eid="PRO 7:27"/></para>
  <chapter eid="PRO 7"/>
  <chapter number="8" style="c" sid="PRO 8"/>
  <para style="s1">አዳ ኤራተ ሳቢደ ኦዴዳ ማዝሙርያ</para>
  <para style="r">(<ref loc="PRO 8:1-9:18">8:1—9:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 8:1"/>ቱሙ አዳ ኤራተታ ጼሰኬ?<note caller="-" style="x"><char style="xo" closed="false">8:1-3 </char><char style="xt" closed="false"><ref loc="PRO 1:20-21">ሌም. 1:20-21</ref></char></note> አኬካይካ ባረ ቃላ ቁ ኦኔ? <verse eid="PRO 8:1"/><verse number="2" style="v" sid="PRO 8:2"/>ኦግያ ዶናን ደእያ ዞዘቱዋ ቦላነ ኦገቱ ዳንትያሳን እዛ ኤቃዉ፤ <verse eid="PRO 8:2"/><verse number="3" style="v" sid="PRO 8:3"/>ድርሳ ፐንግያ ማታን፥ ካታማ ገልያ ፐንግያን ኤቃደ፥ ባረ ቃላ ቁ ኦደ፥ ሀዋዳን ያጋዉ፤ <verse eid="PRO 8:3"/><verse number="4" style="v" sid="PRO 8:4"/>“ህንተኖ አሳቶ፥ ታን ህንተና ጼሳይ፤ ታን አሳ ኡባ ጼሳይ። <verse eid="PRO 8:4"/><verse number="5" style="v" sid="PRO 8:5"/>ህንተኖ አኬካይ ፓጬዳዋንቶ፥ ሂላ ደማናዉ ታማርተ። ህንተኖ ቦዛቶ፥ አኬካ ደምተ። <verse eid="PRO 8:5"/><verse number="6" style="v" sid="PRO 8:6"/>ታን ዳሮ ሎኦባ ኦድያ ድራዉ ስስተ፤ ታን ሱረባ ኦዳናዉ ታ መተርሻ ዶያይ። <verse eid="PRO 8:6"/><verse number="7" style="v" sid="PRO 8:7"/>ታ ዶናይ ቱሙዋ ሃሳዬ፤ ታ መተርሻይ ዎርዶባ እጼ። <verse eid="PRO 8:7"/><verse number="8" style="v" sid="PRO 8:8"/>ታ ዶናይ ሃሳይያዌ ኡባይ ቱማ፤ ጌላ ዎይ ምርቀ ግደና። <verse eid="PRO 8:8"/><verse number="9" style="v" sid="PRO 8:9"/>አኬካይ ደእያ ኡራዉ ታ ሃሳያይ ልከ፤ ኤራይ ደእያዋንቶ ታ ሃሳያይ ቆንጨ።<verse eid="PRO 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 8:10"/>“ብራ አጊደ፥ ታ ዞርያ ዶርተ፤ በርተ ዎርቃካ አጊደ፥ ኤራተ ዶርተ። <verse eid="PRO 8:10"/><verse number="11" style="v" sid="PRO 8:11"/>አያዉ ጎፐ ታን፥ አዳ ኤራተታ፥ እንቁዋ ግያ ዳሮ አልኦ ሹቻፐካ አይ፤ ኔን አሞትያዌ ኡባይካ ታናና ላገታናዉ ዳንዳየና።<verse eid="PRO 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 8:12"/>“ታዉ፥ አዳ ኤራተትዉ አኬካይ ደኤ፤ ኤራተይካ አዱሳ ቆፋይካ ታናና እትፐ ደኢኖ። <verse eid="PRO 8:12"/><verse number="13" style="v" sid="PRO 8:13"/>መና ጎዳዉ ያይያዌ ኢታተ እጽያዋ፤ ታን ኦቶሩዋነ አዩዋ እጻይ፤ ኢታሳ አፍያ ኦግያነ ዎርዱዋ ሃሳያ ዶስከ። <verse eid="PRO 8:13"/><verse number="14" style="v" sid="PRO 8:14"/>ዞሪነ ሎኦ ኤራይ ታዋንታ፤ አኬካይነ ዎልቃይነ ታዉ ደኢኖ። <verse eid="PRO 8:14"/><verse number="15" style="v" sid="PRO 8:15"/>ካተቱ ታናን ካዉቲኖ፤ ቃይ ሞድያዋንቱ ሱረ ህግያ ታናን ከሲኖ። <verse eid="PRO 8:15"/><verse number="16" style="v" sid="PRO 8:16"/>ካፓቱ ታን ማድና፥ አሳ ሞድኖ፤ ሳኣን ጋድያ ሞድያ ዎልቃማ አሳቱዋ ኡባካ ታን ማዳይ።<verse eid="PRO 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 8:17"/>“ታን ታና ሲቅያዋንታ ሲቃይ፤ ታና ምንሲደ ኮይያዋንቱካ ደማና። <verse eid="PRO 8:17"/><verse number="18" style="v" sid="PRO 8:18"/>ዱረተይነ ቦንቹ ታናና ደኢኖ፤ ዉረና አቁነ እንጂ ታ ማታና። <verse eid="PRO 8:18"/><verse number="19" style="v" sid="PRO 8:19"/>ህንተ ታፐ ደምያ አይፊ በርተ ዎርቃፐነ ታ ጫርሻይ ሙሽስ ከሴዳ ብራፐ አ። <verse eid="PRO 8:19"/><verse number="20" style="v" sid="PRO 8:20"/>ታን ጽሎተ ኦግያን ሀመታይ፤ ሱረ ፕርዳ ሎሱዋና አይ። <verse eid="PRO 8:20"/><verse number="21" style="v" sid="PRO 8:21"/>ታና ሲቅያዋንቶ ታን ማጹዋ እማና፤ ኡንቱንቱ ጎልያካ ታን ሚሻን ኩንና።<verse eid="PRO 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 8:22"/>“መና ጎዳይ ታና ባረ ኦሱዋ ኡባፐ ኮይሮ መዳ፤<note caller="-" style="x"><char style="xo" closed="false">8:22 </char><char style="xt" closed="false"><ref loc="REV 3:14">ሳፃ 3:14</ref></char></note> በንፐካ አ ኦሶ ዶመይ ታና። <verse eid="PRO 8:22"/><verse number="23" style="v" sid="PRO 8:23"/>በን ዎደ፥ ቢታይ ሳአይ መታናፐ ካሰ ታን ሱንታድ። <verse eid="PRO 8:23"/><verse number="24" style="v" sid="PRO 8:24"/>ዎልቃማ አባቱ ባይና ዎደ፥ ሃ ፑልቶቱ እቤና ዎደ፥ ሄ ዎደ ታን የለታድ። <verse eid="PRO 8:24"/><verse number="25" style="v" sid="PRO 8:25"/>ደረቱነ ደቱ መታናፐ ካሰ ታን የለታድ። <verse eid="PRO 8:25"/><verse number="26" style="v" sid="PRO 8:26"/>መና ጎዳይ ሳኣነ ሳኣን ደእያ ጋደቱዋ ኡባ መናፐ ካሰ፥ ዎይ እት ኮጰ ግድያ ባናይ አላምያን ኦሰታናፐ ካሰ ታን የለታድ።<verse eid="PRO 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 8:27"/>“መና ጎዳይ ሳሎቱዋ ምጬዳ ዎደነ ዎልቃማ አባቱዋፐ ቦላና ደእያ ሳሉዋ ጊግሴዳ ዎደ፥ ታን ያን ደአይ። <verse eid="PRO 8:27"/><verse number="28" style="v" sid="PRO 8:28"/>መና ጎዳይ ሻረቱዋ ቦላን ዎዳ ዎደ፥ ዎልቃማ አባ ፑልቶቱዋ ሴዳ ዎደ፥ <verse eid="PRO 8:28"/><verse number="29" style="v" sid="PRO 8:29"/>አባ ሃቱ ባረንቶ እመቴዳ ዛዋፐ ፕኒደ፥ ቦላዉ አናዳን፥ እ ኡንቱንታ አዛዜዳ ዎደ፥ ሳኣ ባሱዋ እ ባሴዳ ዎደ፥ ታን ያን ደአይ። <verse eid="PRO 8:29"/><verse number="30" style="v" sid="PRO 8:30"/>ሄ ዎደ ታን አ ማታን ኤረቴዳ ኦሳንቻ፤ ኡባ ጋላስ ታን ናሸቻን ኩማይ፤ ታዉካ አ ስንን ናሸታይ። <verse eid="PRO 8:30"/><verse number="31" style="v" sid="PRO 8:31"/>እ መዳዌ ኡባይ፥ ሳአይካ አሳ ናናቱካ ታና ናሸቺኖ።<verse eid="PRO 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="PRO 8:32"/>“ሀእካ ስም ታ ናቶ፥ ስስተ፤ ታን ኦድያዋዳን ኦያዋንቱ አንጀቴዳዋንታ። <verse eid="PRO 8:32"/><verse number="33" style="v" sid="PRO 8:33"/>ታ ትምርትያ ስስተ፤ አዳ ኤራንቻ ግድተ፤ ስሴዳዋ ሸነኮ ጎፕተ። <verse eid="PRO 8:33"/><verse number="34" style="v" sid="PRO 8:34"/>ታና ስስያ ኡራይ፥ ሀች ሀች ታ ፐንገን ቤትያ ኡራይ፥ ታ ጎለ ገልያሳንካ ናግያ ኡራይ አንጀቴዳዋ። <verse eid="PRO 8:34"/><verse number="35" style="v" sid="PRO 8:35"/>ታና ደምያዌ ደኡዋ ደሜ፤ መና ጎዳፐ እ ሳባ ደሜ። <verse eid="PRO 8:35"/><verse number="36" style="v" sid="PRO 8:36"/>ሽን ታና ደመናን አግያ ኡራይ ባረና ቆሄ፤ ታና እጽያ ኡባቱ፥ ሀይቁዋ ሲቂኖ” ያጋዉ።<verse eid="PRO 8:36"/></para>
  <chapter eid="PRO 8"/>
  <chapter number="9" style="c" sid="PRO 9"/>
  <para style="s1">አዳ ኤራተነ ቦዛተ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 9:1"/>አዳ ኤራተታ ባረ ጎልያ ኬጻዱ፤ ሄ ጎልያዉ ላፑን ቱሳቱዋ ኤሳዱ። <verse eid="PRO 9:1"/><verse number="2" style="v" sid="PRO 9:2"/>እዛ ባረ ጊግስያ ሾብያዉ ሞ መህያ ሹካዱ፤ ዎይንያ ኤሳካ አጋደ ጊግሳዱ። ማዳ ስንዉ አዱ። <verse eid="PRO 9:2"/><verse number="3" style="v" sid="PRO 9:3"/>ያታደ አሳ ጼሳናዉ ባረ ቆማቱዋ ኪታዱ። ቆማቱ ካታማዉ ቃ ሳኣን ኤቂደ፥ <verse eid="PRO 9:3"/><verse number="4" style="v" sid="PRO 9:4"/>“ህንተኖ፥ ኤራይ ፓጬዳዋንቶ ሀዋ ገልተ!” ያጌድኖ። ቦዛቱዋካ እዛ ሀዋዳን ያጋዱ፤ <verse eid="PRO 9:4"/><verse number="5" style="v" sid="PRO 9:5"/>“ሃ ዪተ፤ ታ ቁማ ሚተ፤ ታን አጌዳ ዎይንያ ኤሳካ ኡሽተ! <verse eid="PRO 9:5"/><verse number="6" style="v" sid="PRO 9:6"/>ቦዛተ አጊደ፥ ደኡዋን ደእተ፤ አኬካ ኦግያን ሀመትተ” ያጋዉ።<verse eid="PRO 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 9:7"/>ቅሊጭያ ኡራ ሴርያ አሳይ ባረዉ ቦርያ አኬ፤ ኢታ ኡራ ዞርያዌካ ባረዉ ቆሄቴ። <verse eid="PRO 9:7"/><verse number="8" style="v" sid="PRO 9:8"/>ቅሊጭያ ኡራ ዞሮፓ፤ እ ኔና እጻና። አዳ ኤራንቻ ኡራ ዞራ፤ እ ኔና ዶሳና። <verse eid="PRO 9:8"/><verse number="9" style="v" sid="PRO 9:9"/>አዳ ኤራንቻ ኡራ ታማርሳ፤ ያቶፐ፥ እ ካሰዋፐካ አዳ ኤራንቻ ግዳናዋ። ጽሎ ኡራካ ታማርሳ፤ ያቶፐ እ ኤራ ጉጃና።<verse eid="PRO 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 9:10"/>አዳ ኤራተዉ ዶመይ መና ጎዳዉ ያይያዋ፤ ጌሻ ጾሳ ኤርያዌ አኬክያዋ።<note caller="-" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="JOB 28:28">ኢዮባ 28:28</ref>፤ <ref loc="PSA 111:10">ማዝ. 111:10</ref>፤ <ref loc="PRO 1:7">ሌም. 1:7</ref></char></note> <verse eid="PRO 9:10"/><verse number="11" style="v" sid="PRO 9:11"/>ታናን ነ ላይይ ዳራና፤ ነ ደኡዋ ላይይካ አዱቃና። <verse eid="PRO 9:11"/><verse number="12" style="v" sid="PRO 9:12"/>ኔን አዳ ኤራንቻ ግዶፐ፥ ነ ሁጲያዉ ጎኤታሳ። ኔን ቅሊጭያዋ ግዶፐካ፥ ነ ሁጲያዉ ቆሄታሳ።<verse eid="PRO 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 9:13"/>ቦዛ ምሽራታ ዋላሳ ዳራዉ፤ እዛ ባረና ናገናዉኖ። እዛ አይነ ኤሩኩ። <verse eid="PRO 9:13"/><verse number="14" style="v" sid="PRO 9:14"/>እዛ ባረ ካረን፥ ዎይ ካታማዉ ቃ ሳኣን ኦይድያን ኡታዉ። <verse eid="PRO 9:14"/><verse number="15" style="v" sid="PRO 9:15"/>ሱረ ባረንቱ ኦግያ ኦይቂደ ብያ አሳ ጼሳደ፥ <verse eid="PRO 9:15"/><verse number="16" style="v" sid="PRO 9:16"/>“ህንተኖ፥ ኤራይ ፓጬዳዋንቶ፥ ታኮ ሃ ዪተ” ያጋዉ። አኬካይ ባይናዋካ፥ <verse eid="PRO 9:16"/><verse number="17" style="v" sid="PRO 9:17"/>“ዉኢደ ኡሽያ ሃይ ማልኤ፤ ጌማን ምያ ቁማይካ ናሸቼ” ያጋዉ። <verse eid="PRO 9:17"/><verse number="18" style="v" sid="PRO 9:18"/>ሽን እ ሀይቄዳ አሳይ ያን ደእያዋ፥ እዝ እማቱካ ዱፉዋ ጪሞ ግዶን ደእያዋ ኤረና።<verse eid="PRO 9:18"/></para>
  <chapter eid="PRO 9"/>
  <chapter number="10" style="c" sid="PRO 10"/>
  <para style="s1">ሶሎሞና ሌምሳቱዋ</para>
  <para style="r">(<ref loc="PRO 10:1-29:27">10:1—29:27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1"/>ሀዋንቱ ሶሎሞና ሌምሳቱዋ። አዳ ኤራንቻ ናአይ ባረ አዉዋ ናሸቼ፤ ሽን ቦዛ ናአይ ባረ አቶ ካዮዬ።<verse eid="PRO 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 10:2"/>ናጋራን ደሜዳ ሚሻይ ጎኤና፤ ሽን ጽሎተይ ሀይቁዋፐ አሼ።<verse eid="PRO 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 10:3"/>መና ጎዳይ ጽሎቱዋ ኮሻይሰና፤ ሽን ናጋራንቻቱዋ አሙዋ ፖልሰና።<verse eid="PRO 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 10:4"/>አዛላተይ ማንቂሴ፤ ሽን ምኒደ ኦያዌ ዱረዬ።<verse eid="PRO 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 10:5"/>አዳ ኤራንቻ ኡራይ ካ ቦንያን ሺሼ፤ ሽን ካ ጫክያ ዎደ ገምእሽያ ኡራይ ካዉሼ።<verse eid="PRO 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 10:6"/>ጽሎ አሳይ አንጀቴ፤ ሽን ናጋራንቻ ዶና ማካላይ ካሜ።<verse eid="PRO 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 10:7"/>ጽሉዋ ሱንይ አንጁዋን ጼሰቲደ ደኤ፤ ሽን ናጋራንቻቱዋ ሱንይ ዶገቴ።<verse eid="PRO 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 10:8"/>አዳ ኤራንቻቱ አዛዜዳዋ ኦኖ፤ ሽን ቦዛተን ጮ ዶናትያዋንቱ ባሻዉ ቢኖ።<verse eid="PRO 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 10:9"/>ሱረ አሳይ ሳሮ ደኤ፤ ሽን ጌላ ኡራይ ባረ ባይዙዋን ኦይቀቴ።<verse eid="PRO 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 10:10"/>አሳ ቦላ ስምእያ ኡራይ መቱዋ አዬ።</para>
  <para style="p" vid="PRO 10:10">ቦዛተን ጮ ዶናትያዋንቱ ባሻዉ ቢኖ።<verse eid="PRO 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 10:11"/>ጽሉዋ ሃሳያይ ደኡዋ ፑልትያ፤ ሽን ናጋራንቻ ሃሳያይ ማካላተ ገን።<verse eid="PRO 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 10:12"/>እጹ ፓሉምያ ደን፤ ሽን ሲቁ ባይዙዋ ኡባ ፓይደና።<note caller="-" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="JAS 5:20">ያቆባ 5:20</ref>፤ <ref loc="1PE 4:8">1 ጰጽ. 4:8</ref></char></note><verse eid="PRO 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 10:13"/>ዎዛናማ አሳይ አዳ ኤራን ሃሳዬ፤ ሽን ቦዛ ኡራይ ጻምአን ሾጨቴ።<verse eid="PRO 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 10:14"/>አዳ ኤራንቻቱ ኤራ ዳጋዪኖ፤ ሽን ቦዛ ሃሳያ ሃሳይያ ኡራይ ባረና ባይዜ።<verse eid="PRO 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 10:15"/>ዱርያ ሚሻይ ድረቴዳ ካታማ ማላ፥ ባረ ጎዳ ናጌ፤ ሽን ህዬሳተይ ህዬሳ ይሴ።<verse eid="PRO 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 10:16"/>ጽሎ ኡራ አ ሎኦ ኦሱ ደኦ ካለ፤ ሽን ኢታ ኡራ ዉርሰይ ሙሩዋ አሄ።<verse eid="PRO 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 10:17"/>ሴርና ኤኖ ግያ ኡራይ ደኡዋ ኦግያን ሀመቴ፤ ሽን ሴርና እጽያ ኡራይ ባሌ።<verse eid="PRO 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 10:18"/>እጺደ ባረ እጽያዋ ኤርሰና ኡራይ ዎርዳንቻ፤ ዝግርሳ ላልያ ኡራይካ ቦዛ።<verse eid="PRO 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 10:19"/>ዳሮ ሃሳያ ግዶን ናጋራይ የና፤ ሽን ባረ ዶና ሺሽ አክያ ኡራይ አዳ ኤራንቻ።<verse eid="PRO 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 10:20"/>ጽሉዋ እንጻርሳይ ትገቴዳ ጌሻ ብራ ማላ፤ ሽን ኢታ ኡራ ቆፋዉ ጋቲ ጉ።<verse eid="PRO 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 10:21"/>ጽሎ ኡራ ሃሳያይ ዳሮ አሳ ጎኤ፤ ሽን ቦዛቱ ባረንቱ ዎዛና ፓጫን ሀይቂኖ።<verse eid="PRO 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 10:22"/>መና ጎዳ አንጁ ዱረ ከሴ፤ እ ሄ ዱረተን መቱዋ ዋላከና።<verse eid="PRO 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 10:23"/>ቦዛ ኡራዉ ኢታባ ኦያዌ ካሳ ማላ፤ ሽን ዎዛናማ ኡራይ አዳ ኤራተን ናሸቴ።<verse eid="PRO 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 10:24"/>ኢታ ኡራይ ህርጌዳባይ አ ቦላ ጋካናዋ፤ ሽን ጽሉ አሞቴዳዌ እመታናዋ።<verse eid="PRO 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 10:25"/>ጎቱ ደንዲደ አደ፥ ናጋራንቻቱ ፕተት ይኖ፤ ሽን ጽሎቱ መናዉ ምኒደ ደአና።<verse eid="PRO 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 10:26"/>ጫላይ አቻ ዝልእስያዋዳንነ ጩዋይ አይፍያ ፖግያዋዳን፥ አዛላ ኡራ ኪትያዌ ይሎዬ።<verse eid="PRO 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 10:27"/>መና ጎዳዉ ያይያዌ ላይ አዱሴ፤ ሽን ናጋራንቻ ኡራ ላይይ ቃሜ።<verse eid="PRO 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 10:28"/>ጽሎ ኡራይ ስንና ናሸቻይ ያና ጊደ ናጌ፤ ሽን ኢታ ኡራይ ስንና ያና ጊደ ናግያዌ አያይነ ባዋ።<verse eid="PRO 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 10:29"/>መና ጎዳ ኦጊ ጽሎቶ ባቃት አትያ ሳኣ፤ ሽን ኢታ ኦያዋንቶ ባሻ።<verse eid="PRO 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 10:30"/>ጽሎቱ ደኢያሳፐ ሾደትክኖ፤ ሽን ኢታቱ ቢታ ቦላ ደእክኖ።<verse eid="PRO 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 10:31"/>ጽሎ አሳይ አዳ ኤራተ ሃሳዬ፤ ሽን ጌላባ ሃሳይያ እንጻርሳይ ቃንጸታና።<verse eid="PRO 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="PRO 10:32"/>ጽሎ አሳይ በስያ ሃሳያ ኤሬ፤ ሽን ኢታ አሳይ ጌላ ሃሳዬ።<verse eid="PRO 10:32"/></para>
  <chapter eid="PRO 10"/>
  <chapter number="11" style="c" sid="PRO 11"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 11:1"/>መና ጎዳይ ዎርዱዋ ሚዛናን ልክያዋንታ እጼ፤ ሽን ልከ ሚዛናን ልክያዋንቱን ናሸቴ።<verse eid="PRO 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 11:2"/>ኦቶሩ ይያ ዎደ ካዉሻተይ ዬ፤ ሽን አሽከተና አዳ ኤራተይ ዬ።<verse eid="PRO 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 11:3"/>ጽሎቱዋ ኡንቱንቱ ሱረተይ ካለ፤ ሽን አማነተናዋንታ ኡንቱንቱ ጌላተይ ይሴ።<verse eid="PRO 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 11:4"/>ሀንቁዋ ጋላስ ዱረተይ ጎኤና፤ ሽን ጽሎተይ ሀይቁዋፐ አሼ።<verse eid="PRO 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 11:5"/>ቦሪ ባይና ኡራ ኦግያ አ ጽሎተይ ሱርሴ፤ ሽን ኢታ ኡራይ ባረ ኢታተን ኩንዴ።<verse eid="PRO 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 11:6"/>ሱረቱዋ ኡንቱንቱ ጽሎተይ አሼ፤ ሽን አማነተናዋንታ ኡንቱንቱ አሙ ጲረ ግዲደ ኦይቃና።<verse eid="PRO 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 11:7"/>ኢታ አሳይ ሀይቂያ ዎደ፥ እ ናግያ ህዶታይካ አናና እትፐ ሀይቄ፤ እ ባረ ዎልቃን ጬቀትያዌ ኡባይካ ዬ።<verse eid="PRO 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 11:8"/>ጽሉ መቱዋፐ አቴ፤ አ ድራዉ ኢታ ቦላ መቱ ዬ።<verse eid="PRO 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 11:9"/>ጾሳ ኤረና ብታኒ ባረ ዶናን አሳ ይሴ፤ ሽን ጽሎቱ ኤራን አቲኖ።<verse eid="PRO 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 11:10"/>ጽሎቱ ቦንቼትያ ዎደ፥ ካታማይ ናሸቴ፤ ቃይ ኢታቱ ሀይቂያ ዎደ፥ ሀሹ ጌ።<verse eid="PRO 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 11:11"/>ጽሎቱዋ አንጁዋ ጋሱዋን ካታማይ ድጬ፤ ሽን ኢታ ኡራ ሃሳያይ ካታማ ይሴ።<verse eid="PRO 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 11:12"/>ባረ ሾሩዋ ካያ ኡራዉ ዎዛናይ ባዋ፤ ሽን አኬካንቻ ኡራይ ጮኡ ጌ።<verse eid="PRO 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 11:13"/>ዝግርያ አሳይ ጹራ ላሌ፤ ሽን አማነትያ አሳይ ጹራ ገን።<verse eid="PRO 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 11:14"/>ካለያዌ ዮፐ፥ ካዉተይ ኩንዴ፤ ሽን ዳሮ ዞርያዋንቱ ደኦፐ፥ ሳሩ ደኤ።<verse eid="PRO 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 11:15"/>ኤረና ኡራዉ ዋሰ ግድያ አሳይ ቱሙዋፐ መቶታና፤ ሄዋፐ ዋሰ ግደናን እጽያዌ ሎአ።<verse eid="PRO 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 11:16"/>ኡሉ ኬካ ምሽራታ ቦንቼታዉ፤ ሽን መቀ ኢታ አሳይ ዱረተ ጻላላ ዱረቴ።<verse eid="PRO 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 11:17"/>ኬካ አሳይ ባረዉ ሎኦባ ኦ፤ ሽን መቀ ኢታ አሳይ ባረና ቆሄ።<verse eid="PRO 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 11:18"/>ኢታ አሳይ ደምያ ሚሻይ ጭምያ ሚሻ፤ ሽን ጽሎተ ዘርያ ኡራይ ቱሙ ዎይቱዋ ጫካና።<verse eid="PRO 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 11:19"/>ጽሎተን ምኒደ ደእያ ኡራይ ፓጻ ደአና፤ ሽን ኢታተ ካልያ ኡራይ ሀይቃና።<verse eid="PRO 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 11:20"/>መና ጎዳይ ኢታ ቆፋይ ደእያ አሳቱዋ እጼ፤ ሽን ሱረ ሀመትያዋንቱን ናሸቴ።<verse eid="PRO 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 11:21"/>ኢታ አሳይ ሙረተናን አተና፤ ሽን ጽሎቱ አታናዋንታ።<verse eid="PRO 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 11:22"/>አዱሳ ቆፍ ባይና ፑላንቻ ማጫ ምሽራት ፑላይ ጉዱን ሲያን አዳ ዎርቃ አሌቁዋ ማላ።<verse eid="PRO 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 11:23"/>ጽሎቱዋ አሙዋ ፖሉ ሎኦ ጻላላ፤ ሽን ኢታቱዋ አሙዋ ፖሉ ሀንቁዋ ጻላላ።<verse eid="PRO 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 11:24"/>እት እት አሳቱ ባረንቱ ሚሻ አሳዉ ጮ ላሊኖ፤ ሽን ኡንቱንቱ አቁ ያ ዳሬ። ሀራ አሳቱ ቃይ ባረንቱ ሚሻዉ ሎይ ኡዘቲኖ፤ ሽን ኡንቱንቱ አቁ ሃ ፓጬ።<verse eid="PRO 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 11:25"/>ኬካ አሳይ ዱረታና፤ ሀራቱዋ ማድያ አሳይ ማደታና።<verse eid="PRO 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 11:26"/>ካይ አልእና ዛልአናዉ ምንጅያ ኡራ አሳይ ሸቄ። ሽን ባረ ካ አሳይ ኮይያ ዎደ ዝልእያ አሳ አንጄ።<verse eid="PRO 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 11:27"/>ሎኦባ ምንሲደ ኮይያ ኡራይ ናሸቻ ደሜ፤ ሽን ኢታባ ኮይያ ኡራ ኢታባይ ደሜ።<verse eid="PRO 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 11:28"/>ባረ ዱረተን አማነትያ አሳይ ኩንዳና፤ ሽን ጽሎቱ ባልጉዋ ምዳን ዳሻና።<verse eid="PRO 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 11:29"/>ባረ ሶ አሳ ቦላ ጫቡዋ ደንያ ኡራይ ጎኤታናባይ አያይነ ባዋ። ቦዛቱካ አዳ ኤራንቻቶ ቆማ ግዳና።<verse eid="PRO 11:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 11:30"/>ጽሎ አሳይ ደኡዋ አይፍያ አይፍያ ም ማላ፤ ሸምፑዋ አሽያዋንቱ አዳ ኤራንቻቱዋ።<verse eid="PRO 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 11:31"/>ጽሎቱ ሳኣን ባረንቱ ኦሱዋ ጋትያ አክያዋ ግዶፐ፥ ኢታቱነ ናጋራንቻቱ ባረንቱ ኦሶ አካና ጋቲ ዋን ዳራንዴሻ!<note caller="-" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="1PE 4:18">1 ጰጽ. 4:18</ref></char></note><verse eid="PRO 11:31"/></para>
  <chapter eid="PRO 11"/>
  <chapter number="12" style="c" sid="PRO 12"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 12:1"/>ሴርያዋ ዶስያ ኡራይ ኤራተ ዶሴ፤ ሽን ሴራ እጽያ ኡራይ ዶንጭሎዋ።<verse eid="PRO 12:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 12:2"/>ሎኦ አሳይ መና ጎዳፐ ሳባ ደሜ፤ ሽን መና ጎዳይ ኢታቱዋ ፕርዴ።<verse eid="PRO 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 12:3"/>አሳ ኢታተይ ምንሲደ ኤሰና፤ ሽን ጽሎቱዋ ጻጱ ቃጸና።<verse eid="PRO 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 12:4"/>ዎዛናማ ምሽራታ ባረ አስናዉ ካላቻ ማላ፤ ሽን ባረ አስና ካዉሽያ ምሽራታ አ መቀ ምያ አጃጅያ ማላ።<verse eid="PRO 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 12:5"/>ጽሎቱዋ ቆፋይ ሱረ፤ ሽን ኢታቱዋ ዞሪ ጭሙዋ።<verse eid="PRO 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 12:6"/>ኢታቱዋ ሃሳያይ አሳ ዎናሳ፤ ሽን ጽሎቱዋ ሃሳያይ ኡንቱንታ አሼ።<verse eid="PRO 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 12:7"/>ኢታ አሳቱ ኩንዳና፤ ኡንቱንቶ ዘረይካ ደኤና፤ ሽን ጽሎቱዋ ዘረይ ምኒደ ደአና።<verse eid="PRO 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 12:8"/>አሳይ ባረ አዳ ኤራተ ኬሻ ጋላተቴ፤ ሽን ጌላ ቆፋይ ደእያ አሳይ ካቴ።<verse eid="PRO 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 12:9"/>ዱረ አሳ ማላቲደ፥ መቱዋን ደእያ አሳፐ ጮ አሳ ማላቲደ፥ ኦደ ባረ ደኡዋ ሱግያ አሳይ ኬካ።<verse eid="PRO 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 12:10"/>ጽሎ አሳይ ባረ መህያዉ ቃረቴ፤ ሽን ኢታ አሳ ኬካተዉ መቀ ባዋ።<verse eid="PRO 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 12:11"/>ባረ ቢታ ምንስ ኦያ ኡራይ ካ ካሌ፤ ሽን ፓናባ የደርስያ ኡራዉ አኬካይ ፓጬዳዋ።<verse eid="PRO 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 12:12"/>ኢታቱ ናጋራንቻ አሳቱዋ ኦሞዱዋ አካናዉ አሞቲኖ፤ ሽን ጽሎቱዋ ጻጱ ዳሺደ ደአና።<verse eid="PRO 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 12:13"/>ኢታ አሳ አ ዶናፐ ከሴዳ ሃሳያይ ጲረ ግዲደ ኦይቄ፤ ሽን ጽሉ መቱዋፐ ከስ አኬ።<verse eid="PRO 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 12:14"/>አሳይ ባረ ዶናፐ ከስያ ቃላን ሎኦባ ካሌ፤ ባረ ኦዳ ኦሱዋ ጋትያካ አኬ።<verse eid="PRO 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 12:15"/>ቦዛ አሳይ ብያ ቡሳይ አዉ አ ሁጲያን ልከ ማላቴ፤ ሽን አዳ ኤራንቻ አሳይ ዞርያ ስሴ።<verse eid="PRO 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 12:16"/>ቦዛ ኡራ ሀንቁ ኤለካ ኤረቴ፤ ሽን ጭንጫ አሳይ ቦርያ ካደ አ።<verse eid="PRO 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 12:17"/>ቱሙዋ ሃሳይያ አሳይ ሱረባ ኦዴ፤ ሽን ዎርዱዋ ማርካይ ዎርዱዋን ኦዴ።<verse eid="PRO 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 12:18"/>አኬከናን ሃሳይያ ሃሳያይ ጩብያዳን ጫዴ፤ ሽን አዳ ኤራንቻ እንጻርሳይ ፓ።<verse eid="PRO 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 12:19"/>ዎርዶ ሃሳያይ ጉ ዎድያሳ፤ ሽን ቱሞ ሃሳያይ መናዉ ደአና።<verse eid="PRO 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 12:20"/>ኢታ ቆፕያዋንቱ ዎዛናን ጭሙ ደኤ፤ ሽን ሳሮባ ዞረትያዋንቱ ዎዛናን ናሸቻይ ኩሜ።<verse eid="PRO 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 12:21"/>ጽሎቱዋ መቱ ጋከና፤ ሽን ኢታቶ መቶፐ አትና፥ ሀራባይ ደኤና።<verse eid="PRO 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 12:22"/>መና ጎዳይ ዎርዳንቻቱዋ እጼ፤ ሽን ቱማንቻ አሳቱዋን እ ናሸቴ።<verse eid="PRO 12:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 12:23"/>ጭንጫ አሳይ ባረ ኤራ ቆሴ፤ ሽን ቦዛቱ ባረንቱ ቦዛተ ኦዲኖ።<verse eid="PRO 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 12:24"/>ምኒደ ኦያ ኡራይ ደርያ ሞዴ፤ ሽን አዛላይ ሞደቴ።<verse eid="PRO 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 12:25"/>ህርግያዌ አሳ ናሸቻ ድጌ፤ ሽን ሎኦተና ደእያ ሃሳያይ አ ናሸቼ።<verse eid="PRO 12:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 12:26"/>ጽሎ አሳይ ባረ ሾሩዋ ዞሪደ፥ ሱረ ኦግያ ካለ፤ ሽን ኢታቱዋ ኦጊ ቱሙዋፐ ሃሴ።<verse eid="PRO 12:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 12:27"/>አዛላ አሳይ ሻንካቲደ አሄዳ አሹዋ ካና፤ ሽን ምን ኦደ ደሜዳ ኡራይ ባረ ዱረታዉ ቦንቹዋ እሜ።<verse eid="PRO 12:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 12:28"/>ጽሎተ ኦግያን ደኡ ደኤ፤ ሄ ኦግያን ሀይቁ ባዋ።<verse eid="PRO 12:28"/></para>
  <chapter eid="PRO 12"/>
  <chapter number="13" style="c" sid="PRO 13"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 13:1"/>ኤራንቻ ናአይ ባረ አዉዋ ሴራ ስሴ፤ ሽን ቅሊጭያዌ ሴራ ስሰና።<verse eid="PRO 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 13:2"/>አሳይ ባረ ዶናፐ ከስያ ቃላን ሎኦባ አኬ፤ ሽን አማንተናዋንቱ ማካላባ አሞቲኖ።<verse eid="PRO 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 13:3"/>ባረ ዶና ናግያ ኡራይ ባረ ሸምፑዋ ናጌ፤ ሽን ኤለካ ሃሳይያ ኡራይ ባረና ይሴ።<verse eid="PRO 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 13:4"/>አዛላይ አሞቴ፤ ሽን አያነ ደመና፤ ሽን ምኒደ ኦያዋንቱ ካላና።<verse eid="PRO 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 13:5"/>ጽሎ አሳቱ ዎርዱዋ ሃሳያ እጺኖ። ሽን ኢታ አሳቱዋ ሃሳያይ ዬላዬነ ካዉሼ።<verse eid="PRO 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 13:6"/>ሱረ ደኡዋ ደእያ ኡራ አ ጽሎተይ ናጌ፤ ሽን ናጋራንቻ አ ናጋራይ ኩንድሴ።<verse eid="PRO 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 13:7"/>ባረና ዱረ ማላትስያ አሳይ ደኤ፤ ሽን አዉ አያይነ ባዋ፤ ሀራይ ቃይ ባረና ህዬሳ ማላትስያዌ ደኤ፤ ሽን አዉ ዳሮ ዱረታይ ደኤ።<verse eid="PRO 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 13:8"/>አሳይ ባረ ሻሉዋን ባረ ሸምፑዋ ዎዛናዉ ዳንዳዬ፤ ሽን ህዬሳ ያሽስያዌ ባዋ።<verse eid="PRO 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 13:9"/>ጽሎቱዋ ጾምፒ ፖጩም ፖኤ፤ ሽን ኢታቱዋ ጾምፒ ቶአና።<verse eid="PRO 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 13:10"/>ኦቶሩ ዋላሳ የሌ፤ ሽን ዞርያ አክያዋንቱ አዳ ኤራንቻ።<verse eid="PRO 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 13:11"/>ዳቡር ባይናን ደሜዳ ሚሻይ ኤለካ ዬ፤ ሽን ምን ኦደ ደሜዳ ዱረታይ፥ ዳር ዳሪደ ቤ።<verse eid="PRO 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 13:12"/>ኮይያዌ ፖለተናን ጋምእያዌ ካዮዬ፤ ሽን አሞቴዳዌ ፖለትያዌ ናሸቼ።<verse eid="PRO 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 13:13"/>ዞርያ ካያ ኡራይ መቱዋን ገሌ፤ ሽን አዛዙዋ ቦንችያ ኡራይ ሳሩዋን ደአና።<verse eid="PRO 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 13:14"/>አዳ ኤራንቻይ እምያ ትምርቲ ደኡዋ ፑልቶ፤ ሄዌ አሳይ ሀይቁዋ ጲርያፐ ከስ አካናዉ ማዴ።<verse eid="PRO 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 13:15"/>አኬካይ ደእያ ኡራይ ቦንቼቴ፤ ሽን አማነተናን አግያዌ ባሻዉ አፌ።<verse eid="PRO 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 13:16"/>ጭንጫ አሳይ ኡባይ ኤራን ኦ፤ ሽን ቦዛይ ባረ ቦዛተ ቆንጭሴ።<verse eid="PRO 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 13:17"/>አሳይ ኪቴዳ ኢታ ኪታንቻይ፥ መቱዋን ገሊኖ፤ ሽን አማንያ አሳቱ ኪቴዳዌ፥ ሳሮተ አሂኖ።<verse eid="PRO 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 13:18"/>ሴራ እጽያ አሳይ ህዬሴነ ዬላቴ፤ ሽን ሴርና ስስያ ኡራይ ቦንቼቴ።<verse eid="PRO 13:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 13:19"/>አሞቴዳዋ ደምያዌ ሎይ ናሸቼ፤ ሽን ኢታቱ ኢታፐ ሃካናዉ ኮይክኖ።<verse eid="PRO 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 13:20"/>አዳ ኤራንቻ አሳቱዋና ሀመትያ አሳይ አዳ ኤራንቻ ግዴ፤ ሽን ቦዛ አሳቱዋና ሀመትያ አሳይ መቱዋን ገሌ።<verse eid="PRO 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 13:21"/>ናጋራንቻቱዋ ኢታ ካጫይ ካሌ፤ ሽን ጽሎቱ ሎኦ ኦሱዋ ዎይቱዋ አካና።<verse eid="PRO 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 13:22"/>ሎኦ አሳይ ባረ ናናቱዋ ናናቱዋ ላትሴ፤ ሽን ናጋራንቻ ዱረታይ ጽሎ ዳጋቴ።<verse eid="PRO 13:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 13:23"/>ህዬሳ ጎሻይ ዳሮ ካ አይፋናዉ ዳንዳዬ፤ ሽን ሱረ ፕርዳይ ፓጬዳዋ ጋሱዋን ዬ።<verse eid="PRO 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 13:24"/>ቃይጼርያን ዋናዉ ቃረትያ ኡራይ ባረ ናኣ እጼ፤ ሽን ባረ ናኣ ሲቅያ ኡራይ ምኒደ ሴሬ።<verse eid="PRO 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 13:25"/>ጽሉ አ ኡሉ ካላና ጋካናዉ ሜ፤ ሽን ናጋራንቻይ ኮሻቴ።<verse eid="PRO 13:25"/></para>
  <chapter eid="PRO 13"/>
  <chapter number="14" style="c" sid="PRO 14"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 14:1"/>አዳ ኤራንቻ ምሽራታ ባረ ጎልያ ኬጻዉ፤ ሽን ቦዛታ ባረ ጎልያ ባረ ኩሽያን ኮላዉ።<verse eid="PRO 14:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 14:2"/>ሱረ ሀመትያ አሳይ መና ጎዳዉ ያዬ፤ ሽን ባረ ኦግያ ጌላይያ አሳይ መና ጎዳ ካ።<verse eid="PRO 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 14:3"/>ቦዛ ሃሳያይ አ ዞክያዉ ጻምኣ አዬ፤ ሽን አዳ ኤራንቻቱዋ እንጻርሳይ ኡንቱንታ ናጌ።<verse eid="PRO 14:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 14:4"/>ቦራቱ ባይና ሳን ዬሲ መላ ደኤ፤ ሽን ነዉ ጎሽያ ዎልቃማ ቦራቱ ደኦፐ፥ ነ ዬስያን ካይ ኩሜ።<verse eid="PRO 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 14:5"/>አማነትያ ማርካይ ኡባ ገደ ቱሙዋ ኦዴ፤ ሽን ዎርዱዋ ማርካይ ዎርዱዋ ጻላላ ሃሳዬ።<verse eid="PRO 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 14:6"/>ቅሊጭያዌ አዳ ኤራተ ኮዬ፤ ሽን ደመና፤ አኬካይ ደእያ አሳይ ኤራተ ደማናዌ አ ዋይሰና።<verse eid="PRO 14:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 14:7"/>ቦዛ አሳፐ ሃካ፤ አያዉ ጎፐ፥ ኔን አ ሃሳያፐ ኤራ ደማካ።<verse eid="PRO 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 14:8"/>ጭንጫ አሳይ ባረ ኦያዋ ኤርያ ድራዉ፥ አዳ ኤራንቻ፤ ሽን ቦዛ አሳይ አይነ ኤረናንካ ኤርያዋ ማላትያ ድራዉ ጭሜ።<verse eid="PRO 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 14:9"/>ቦዛቱ ናጋራ ኦደ፥ ካዮትያዋ አጊደ ቅሊጪኖ፤ ሽን ሱረቱ ባረንቱ ናጋራይ አቶ ጌተታናዋ ኮዪኖ።<verse eid="PRO 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 14:10"/>ባረ ዎዛና ካዩዋ እዛዉ ኤሬ፤ አ ናሸቻካ ኦንነ አናና ኮጸና።<verse eid="PRO 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 14:11"/>ኢታቱዋ ጎሊ ኮለተና፤ ሽን ሱረቱዋ ጎሊ ምኒደ ደአና።<verse eid="PRO 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 14:12"/>አሳዉ ልከ ማላትያ ኦጊ ደኤ፤ ሽን ቢና፥ አ ዉርሰይ ሀይቁዋን ከስ የጌ።<note caller="-" style="x"><char style="xo" closed="false">14:12 </char><char style="xt" closed="false"><ref loc="PRO 16:25">ሌም. 16:25</ref></char></note><verse eid="PRO 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 14:13"/>ሚቻንካ ዎዛናይ ካዮት ኤሬ፤ ናሸቻ ዉርሰይካ ካዩዋ ግዳናዉ ዳንዳዬ።<verse eid="PRO 14:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 14:14"/>ኢታ አሳይ ባረ ኢታ ኦሱዋ ጋትያ አካና፤ ሎኦ አሳይካ ባረ ሎኦ ኦሱዋ ጋትያ አካና።<verse eid="PRO 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 14:15"/>ቦዛ አሳይ ኡባ አማኔ፤ ሽን ጭንጫይ አኬኪደ ታንጌ።<verse eid="PRO 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 14:16"/>አዳ ኤራንቻ አሳይ መና ጎዳ ያዬ፤ ኢታፐካ ሃኬ፤ ሽን ቦዛይ አላለ ጌናነ ኤሌሌ።<verse eid="PRO 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 14:17"/>ኤለ ሀንቀትያ አሳቱ ቦዛ ኦሱዋ ኦኖ። ሽን ጭንጫቱ ዳንዳያንቻ።<verse eid="PRO 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 14:18"/>ቦዛቱ ባረንቱ ቦዛተ ጋትያ አኪኖ፤ ሽን ጭንጫቱ ኤራተ ካላቻዳን ዎናዋንታ።<verse eid="PRO 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 14:19"/>ኢታ አሳቱ ሎኦ አሳቱዋ ስንን ሆኪደ፥ ማሮታ ዎሳና። ናጋራንቻቱካ ጽሎቱዋ ፐንግያን ሆካና።<verse eid="PRO 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 14:20"/>ህዬሳይ ባረ ሾሩዋንካ ዶሰተና፤ ሽን ዱረቶ ዳሮ ላገቱ ደኢኖ።<verse eid="PRO 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 14:21"/>ባረ ሾሩዋ ካያ አሳይ ናጋራ ኦ፤ ሽን ህዬሳ ማድያዌ አንጀቴዳዋ።<verse eid="PRO 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 14:22"/>ኢታባ ማቀትያዋንቱ ባሊኖ ግድክኖ? ሽን ሎኦባ ኦናዉ ሀልችያዋንቱ ቱማተነ አገና ሲቁዋ ደሚኖ።<verse eid="PRO 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 14:23"/>ምኒደ ኦያዋን ኡባን ጎአይ ደኤ፤ ሽን ጮ መላ ሃሳያይ ህዬሳተ ጻላላ አዬ።<verse eid="PRO 14:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 14:24"/>አዳ ኤራንቻቶ ኡንቱንቱ ዱረተይ ካላቻ፤ ሽን ቦዛቱ ባረንቱ ቦዛተ ጉጅ ጉጂደ ቦዚኖ።<verse eid="PRO 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 14:25"/>ቱሙ ማርካይ ሸምፑዋ አሼ፤ ሽን ዎርዱዋ ማርካይ ባለ።<verse eid="PRO 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 14:26"/>መና ጎዳዉ ያይያ ኡራዉ ምኖ ጌሱ ደኤ። እ አ ናናቶካ ባቃቲደ አትያ ሳኣ ግዳናዋ።<verse eid="PRO 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 14:27"/>መና ጎዳዉ ያይያዌ ደኡዋ ፑልቶ፤ ሄዋ ድራዉ፥ መና ጎዳዉ ያይያዌ ሀይቁዋ ጲርያፐ አሼ።<verse eid="PRO 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 14:28"/>ካትያ ግታተይ እ ሞድያ አሳ ጮራተና፤ ሽን እ ሞድያ አሳይ ዮፐ፥ እካ ፓና።<verse eid="PRO 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 14:29"/>ዳንዳያንቻ አሳዉ ዎልቃማ አኬካይ ደኤ፤ ሽን ኤለ ሀንቀትያ አሳይ ባረ ቦዛተ ቆንጭሴ።<verse eid="PRO 14:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 14:30"/>ዎፑ ጌዳ ዎዛናይ ቦላ ፓጻ ዎ፤ ሽን ቃናቲ ቦላዉ አጃጅያ ሀርግያ ማላ።<verse eid="PRO 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 14:31"/>ህዬሳቱዋ ናቂያ አሳይ ኡንቱንታ መዳዋ ጫሼ፤ ሽን መቶታንቻቶ ኬክያ አሳይ ጾሳ ቦንቼ።<verse eid="PRO 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="PRO 14:32"/>ኢታቱ ባረንቱ ኢታ ኦሱዋን ኩንዳና፤ ሽን ጽሎቱ ባረንቱ ሱረተን ሀይቁዋፐ ናገታና።<verse eid="PRO 14:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="PRO 14:33"/>አኬካንቻ አሳ ዎዛናን አዳ ኤራተይ ኩሜዳ፤ ሽን ቦዛቱ አዳ ኤራተ አያነ ኤርክኖ።<verse eid="PRO 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="PRO 14:34"/>ጽሎተይ እት ካዉተ አሳ ቁ ቁ ኦ፤ ሽን ናጋራይ አይ አሳነ ካዉሼ።<verse eid="PRO 14:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="PRO 14:35"/>ካቲ ኤራንቻ ቆማን ናሸቴ፤ ሽን ዬላይያ ኦሱዋ ኦያ ቆማ ሀንቀቴ።<verse eid="PRO 14:35"/></para>
  <chapter eid="PRO 14"/>
  <chapter number="15" style="c" sid="PRO 15"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 15:1"/>ሊቆ ዛሩ ሀንቁዋ ዛርቢሴ፤ ሽን ፖዶላ ቃላይ ሀንቁዋ ደን።<verse eid="PRO 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 15:2"/>አዳ ኤራንቻ እንጻርሳይ ኤራ ሎይ፤ ሽን ቦዛቱዋ ዶናይ ቦዛተ ፑልቴ።<verse eid="PRO 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 15:3"/>መና ጎዳ አይፈቱ ኡባሳ ጼሊኖ፤ ኢታ ኦያዋንታካ ሎኡዋ ኦያዋንታካ በኢኖ።<verse eid="PRO 15:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 15:4"/>ሊቆ ሃሳያይ ደኡዋ ም ማላ፤ ሽን ጭምያ ሃሳያይ አያና መን።<verse eid="PRO 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 15:5"/>ቦዛ አሳይ ባረ አዉዋ ሴራ ካ፤ ሽን ባረ አዉዋ ሴራ አክያ አሳይ ጭንጫ።<verse eid="PRO 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 15:6"/>ጽሎ ኡራ ጎልያን ዳሮ ሚሻይ ደኤ፤ ሽን ኢታዉ ገልያ ሚሻይ መቱዋ አዬ።<verse eid="PRO 15:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 15:7"/>አዳ ኤራንቻቱዋ ዶናይ ኤራ ዘሬ፤ ሽን ቦዛቱዋ ዎዛናይ ሄዋ ማላ ግደና።<verse eid="PRO 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 15:8"/>መና ጎዳይ ኢታቱዋ ያርሹዋ ሸነቴ፤ ሽን ሱረቱዋ ዎሳይ አ ናሸቼ።<verse eid="PRO 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 15:9"/>መና ጎዳይ ኢታ አሳቱዋ ሄመታ ሸነቴ፤ ሽን ጽሎተ ካልያዋንታ እ ሲቄ።<verse eid="PRO 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 15:10"/>ሱረ ኦግያ አጌዳ አሳ ኢታ ሙሩ ናጌ፤ ሴራ እጽያ አሳይ ሀይቄ።<verse eid="PRO 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 15:11"/>ዱፉነ ባሻይ መና ጎዳ ስንን ቆንጭያን ቤቲኖ። ያትና፥ አሳ ዎዛና ቆፋይ ዋን አፐ ጌማኔ?<verse eid="PRO 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 15:12"/>ቅሊጭያ አሳይ ሴርያዋ ዶሰና፤ አዳ ኤራንቻቱዋፐካ ዞርያ ኦቼና።<verse eid="PRO 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 15:13"/>ዎዛናይ ናሸትና፥ ሶምኢ ፖኤ፤ ሽን ዎዛናይ ካዮቶፐ፥ ሄ አያናይ መኤ።<verse eid="PRO 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 15:14"/>አኬክያ ዎዛናይ ደእያ አሳይ ኤራተ ኮዬ፤ ሽን ቦዛቱ ባረንቱ ቦዛተን ናሸቲኖ።<verse eid="PRO 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 15:15"/>ህዬሳቱዋ ደኡ ኡባ ጋላስካ ባጸ። ሽን ናሸትያ አሳቱ ኡባ ገደካ ባረንቱ ደኡዋን አሊኖ።<verse eid="PRO 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 15:16"/>ዋላሳይ ደእያ ዎልቃማ አቁዋፐ መና ጎዳ ያሻተይ ደእያ ጉባይ ኬካ።<verse eid="PRO 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 15:17"/>ዋላሳይ ደእያ ሳን ሞ አሹዋ ማናፐ ሲቁ ደእያ ሳን ሳን ምያዌ ኬካ።<verse eid="PRO 15:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 15:18"/>ሀንቀትያ አሳይ ዋላሳ ከሴ፤ ሽን ሀንቀታናዉ ኤሌለና አሳይ ዋላሳ እርጽሴ።<verse eid="PRO 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 15:19"/>አዛላ ኡራ መቱ አ ኦግያ ኡባን አጉን ድርሳ ማላ፤ ሽን ሱረ ኡራ ኦጊ ደምባ።<verse eid="PRO 15:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 15:20"/>ጭንጫ ናአይ ባረ አዉዋ ናሸቼ፤ ሽን ቦዛ ናአይ ባረ አቶ ካ።<verse eid="PRO 15:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 15:21"/>ዎዛን ባይና አሳይ ባረ ቦዛተን ናሸቴ፤ ሽን ዎዛናማ አሳይ ልከባ ኦ።<verse eid="PRO 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 15:22"/>ዞረታይ ዮፐ፥ ሀልቼዳዌ ፖለተና፤ ዳሮ ዞርያዋንቱ ደእያ ሳን ሀልቼዳዌ ፖለቴ።<verse eid="PRO 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 15:23"/>ኦሸቴዳዎ ልከ ዛሩዋ ዛርያዌ ሄ ኡራ ናሸቼ፤ ሃሳያ ልከ ዎድያን ሃሳይያዌ አይባ ሎኦቤ!<verse eid="PRO 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 15:24"/>አዳ ኤራንቻይ ቦላዉ ካለያ ደኡዋ ኦግያን ሀመቴፐ አትና፥ ዱገ ዱፉዋ ዎያ ኦግያን ሀመተና።<verse eid="PRO 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 15:25"/>መና ጎዳይ ኦቶራንቻቱዋ ጎልያ ኮላና፤ ሽን አምአቲ ዛዋ ናጌ።<verse eid="PRO 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 15:26"/>መና ጎዳይ ኢታቱዋ ቆፋ ሸነቴ፤ ሽን ጌሻ ቃላይ አ ናሸቼ።<verse eid="PRO 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 15:27"/>ዎርዱዋን ዎያ ደማናዉ ጃምያ አሳይ ባረ ሶ አሳ ቦላ መቱዋ አዬ፤ ሽን ማታይያ እጽያ አሳይ ፓጻ ደአና።<verse eid="PRO 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 15:28"/>ጽሎ አሳይ ሃሳያናፐ ካሰቲደ ቆፔ፤ ሽን ኢታቱዋ እንጻርሳይ ፓላባ ፑልቴ።<verse eid="PRO 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 15:29"/>መና ጎዳይ ኢታቱዋፐ ሃኬ፤ ሽን ጽሎቱዋ ዎሳ ስሴ።<verse eid="PRO 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 15:30"/>ፓሽኪደ ጼልያ ጼላይ ዎዛና ናሸቼ፤ ምሽራቹዋ ኦዱካ ቦላ ፓ።<verse eid="PRO 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 15:31"/>ደኡዋ እምያ ዞርያ ስስያ አሳይ አዳ ኤራንቻቱዋና እትፐ ደአና።<verse eid="PRO 15:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="PRO 15:32"/>ሴራ እጽያ አሳይ ባረና ቆሄ፤ ሽን ሴራ አክያ አሳይ አኬካ ደሜ።<verse eid="PRO 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="PRO 15:33"/>መና ጎዳዉ ያይያዌ አሳ አዳ ኤራተ ታማርሴ፤ ቦንቼታና ኮዬዳ አሳይ ኮይሮ ባረና ካዉሻናዉ ኮሼ።<verse eid="PRO 15:33"/></para>
  <chapter eid="PRO 15"/>
  <chapter number="16" style="c" sid="PRO 16"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 16:1"/>አሳይ ባረ ዎዛናን ሀልቼ፤ ሽን ልከ ዛሩ መና ጎዳፐ ቤቴ።<verse eid="PRO 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 16:2"/>አሳይ ኦያ ኦሱዋ ኡባይ አዉ ልከ ማላቴ፤ ሽን መና ጎዳይ ኮይሮ ደንዱዋ ቆፋ ይግ ጼሌ።<verse eid="PRO 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 16:3"/>ነ ኦያዋ ኡባ ሀዳራ መና ጎዳዉ እማ፤ ያቶፐ፥ ኔን ሀልቼዳዌ ፖለታና።<verse eid="PRO 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 16:4"/>መና ጎዳይ መዳዋ ኡባ ባረ ሀልቾ መዳ፤ ሀንንቶካ ማካላንቻቱዋ ዉርሰይ ባየ።<verse eid="PRO 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 16:5"/>መና ጎዳይ ኦቶረትያ ኡባ ሸነቴ፤ ኡንቱንቱ ሙረተናን አትክኖ።<verse eid="PRO 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 16:6"/>አገና ሲቁዋንነ አማነትያዋን ናጋራይ አቶ ጌተቴ፤ አሳይ መና ጎዳዉ ያይያዋን ኢታባ ኦናን ናገቴ።<verse eid="PRO 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 16:7"/>አሳ ሀመታይ መና ጎዳ ናሸችያዋ ግዶፐ፥ ሄ ኡራዉ ባረ ሞርከቱዋናካ ሳሮ ደአናዳን፥ ጾሳይ ኦ።<verse eid="PRO 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 16:8"/>ጽሎተን ቤትያ ጉባይ ዎርዱዋን ደምያ ዳሮ ዎያፐ ኬካ።<verse eid="PRO 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 16:9"/>አሳይ ባረ ዎዛናን ባረ ኦናባ ሀልቼ፤ ሽን ሀልቹ መና ጎዳይ ማድና ፖለቴ።<verse eid="PRO 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 16:10"/>ካቲ ጾሳፐ አኬዳ ማታን ፕርዴ፤ ፕርዲደ እ ባለና።<verse eid="PRO 16:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 16:11"/>ሚዛናቱነ ማክያ ሚሻቱ አማንያዋንታ ግዳናዳን፥ መና ጎዳይ ኮዬ፤ ዛልእያዋ ኡባን ጭሙ ደኤናዳን ኮዬ።<verse eid="PRO 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 16:12"/>ካተቱ ባይዙዋ ኦሱዋ ሸነቲኖ፤ አያዉ ጎፐ፥ ኡንቱንቱ ካዉተ አራታይ ጽሎተን ኤቄ።<verse eid="PRO 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 16:13"/>ካተቱ ጽሎ እንጻርሳን ናሸቲኖ፤ ቱሙዋ ሃሳይያዋንታካ ዶሲኖ።<verse eid="PRO 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 16:14"/>ካትያ ሀንቁ ሀይቁዋ ኪታንቻ ማላ፤ ሽን አዳ ኤራንቻ አሳይ ሀንቁዋ እርጽሳናዉ አዉዳሼ።<verse eid="PRO 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 16:15"/>ካትያ ሶምኢ ፓሽኮፐ፥ ሄዌ ስም ደኡዋ። እ ናሽያዌ ባሳ እራ አህያ ሻርያ ማላ።<verse eid="PRO 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 16:16"/>አዳ ኤራተ ደምያዌ ዎርቃ ደምያዋፐ ኬካ፤ አኬካ ደምያዌ ብራ ደምያዋፐካ አ።<verse eid="PRO 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 16:17"/>ሱረቱ ብያ ኦጊ ኢታይ ደኢያሳፐ ሃኩዋና አ፤ ባረ ሄመታ ናግያ ኡራይ ባረ ሸምፑዋ ናጌ።<verse eid="PRO 16:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 16:18"/>ኦቶሩዋ ጌዱዋ ባሻይ ካሌ፤ አዩዋ ጌዱዋካ ኩንደይ ካሌ።<verse eid="PRO 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 16:19"/>አይያዋንቱና ዙፐቲደ፥ ኦሞዱዋ ሻክ አካናፐ አሽከ ግዲደ፥ ህዬሲደ ደእያዌ ኬካ።<verse eid="PRO 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 16:20"/>መና ጎዳ ቃላ ሎይደ ሀይዝያ ኡራዉ እ ኦያዌ ኡባይ እንጀታና፤ ጾሳን አማነትያ ኡራይ አንጀቴዳዋ።<verse eid="PRO 16:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 16:21"/>ባረ ቆፋን አዳ ኤራንቻ ግዴዳ አሳይ አኬካንቻ ጌተቴ፤ ሎኦ ቃላይ ኤራተ ጉጄ።<verse eid="PRO 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 16:22"/>ጭንጫ ኡራዉ ኤራተይ ደኡዋ ፑልቱዋ ማላ፤ ሽን ቦዛቱዋ ሴርያዌ ጮ ዎድያ ዉርስያዋ።<verse eid="PRO 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 16:23"/>አዳ ኤራንቻ አሳይ ሃሳያናፐ ካሰቲደ ቆፔ፤ አሳይ አክያ ሃሳያ ሃሳዬ።<verse eid="PRO 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 16:24"/>ሎኦ ቃላይ ኤሳ እልሉዋዳን ማልኤ፤ ቦላካ ማዴነ ፓ።<verse eid="PRO 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 16:25"/>አሳዉ ሱረ ማላትያ ኦጊ ደኤ፤ ሽን ዉርሰን ሀይቆ ጋ።<note caller="-" style="x"><char style="xo" closed="false">16:25 </char><char style="xt" closed="false"><ref loc="PRO 14:12">ሌም. 14:12</ref></char></note><verse eid="PRO 16:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 16:26"/>ኮሻይ አሳይ ምኒደ ኦናዳን ደን።<verse eid="PRO 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 16:27"/>ኢታ አሳይ ኢታባ ሀልቼ፤ አ ሃሳያይካ ጹግያ ታማ ማላ።<verse eid="PRO 16:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 16:28"/>ጌላ አሳይ ዋላሳ ደን፤ ዝግርያ አሳይ አማነትያ ላገቱዋ ሻኬ።<verse eid="PRO 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 16:29"/>ማካላ አሳይ ባረ ሾሩዋ ጭሜ፤ ሎኦ ግደና ኦግያዉ እ አ ካለ።<verse eid="PRO 16:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 16:30"/>ባረ አይፍያ ስምእያ አሳይ ጌላባ ቆፔ፤ ባረ መተርሻ ሳኢደ ማንድያ አሳይ ኢታባ ፖሌ።<verse eid="PRO 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 16:31"/>ፑሉሜዳ ሁጲ ቦንቾ ካላቻ፤ ሄዌካ ቤትያዌ ጽሎ ደኡዋ ደእና።<verse eid="PRO 16:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="PRO 16:32"/>ዎልቃማ አሳ ግድያዋፐ፥ ሀንቀታናዉ ኤሌለና አሳ ግድያዌ ሎአ፤ ዳሮ ካታማቱዋ ኦሊደ ኦይቂያዋፐ፥ አሳይ ባረ ሁጲያ ሞድያዌ አ።<verse eid="PRO 16:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="PRO 16:33"/>አሳይ ሳማ የጌ፤ ሽን መና ጎዳይ ኡባባ ዉርሰ ቃቼ።<verse eid="PRO 16:33"/></para>
  <chapter eid="PRO 16"/>
  <chapter number="17" style="c" sid="PRO 17"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 17:1"/>ዋላሳይ ደእያ ሳን ደእያ ዎልቃማ ግብራፐ ሳሩነ ዎፓይ ደእያ ሳን መላ ኡክ ፖቁዋ ምያዌ ኬካ።<verse eid="PRO 17:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 17:2"/>ጭንጫ ቆማይ ባረ ጎዳ ናኣ ፓና ላፋ ሞዴ፤ ያቲደ እሻቱዋና እትፐ ላቴ።<verse eid="PRO 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 17:3"/>ዎርቃይነ ብራይ ታማን ፓጨትያዋዳን፥ መና ጎዳይ አሳ ዎዛና ፓጬ።<verse eid="PRO 17:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 17:4"/>ኢታ አሳይ ኢታ ኡራ ሃሳያ ስሴ፤ ዎርዳንቻይካ ማካላ ኦዱዋ ሀይዜ።<verse eid="PRO 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 17:5"/>ህዬሳቱዋ ቦላ ቅሊጭያ አሳይ ኡንቱንታ መዳ ጾሳ ቦሬ፤ ሀራ አሳ ጋክያ መቱዋን ናሸትያ አሳይ ሙረተናን አተና።<verse eid="PRO 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 17:6"/>ናናቱዋ ናናቱ ጭሜዳ አሳቶ ካላቻ፤ አዎቱነ አየቱ ባረንቱ ናናቶ ቦንቾ።<verse eid="PRO 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 17:7"/>ዳሮ ሎኦ ሃሳያይ ቦዛ ኡራዉ ጊገና፤ ሄዋፐካ አዋ ዎርዱዋ ሃሳያይ አሳ ሞድያዎ ጊገና።<verse eid="PRO 17:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 17:8"/>ማታይያ እምያዎ ማታዪ ብታ ማላ፤ እ ስሜዳ ሳኣ ኡባይ አዉ እንጀቴ።<verse eid="PRO 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 17:9"/>ናቀቲደ ባረ ናቁዋ ገንያ ኡራይ ሲቁዋ ኮዬ፤ ሽን የዉዋ ዛር ዛሪደ ዎጭያ ኡራይ፥ አማነትያ ላገቱዋ ሻኬ።<verse eid="PRO 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 17:10"/>ቦዛይ ጼቱ ገደ ልሱዋን ሾጭና ኤርያዋፐ አኬካይ ደእያ አሳይ ጮ ሴርና ኤራይ አ።<verse eid="PRO 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 17:11"/>ኢታ አሳይ ማካላባ ጻላላ ኮዬ፤ ሄዋ ድራዉ፥ መቀ ባይና ካፑ አ ቦላ ኪተታና።<verse eid="PRO 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 17:12"/>ቦዛተይ ኦይቄዳ ኡራና ጋከትያዋፐ ማራቱዋ ቦንቂ አክ ድጌዳ ማሀትና ጋከትያዌ ኬካ።<verse eid="PRO 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 17:13"/>ሎኡዋ ኦዳዋ ኩሽያ ኢታ ዛርያ ኡራዉ ኢታይ አ ሶፐ ኡባካ ክቼና።<verse eid="PRO 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 17:14"/>ዋላሳይ ዶሚደ፥ ዜሩዋ ስያ ሃ ማላ፤ ሄዋ ድራዉ፥ ዋላሳፐ ካሰታደ ፓሉምያ አጋ።<verse eid="PRO 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 17:15"/>ናጋራንቻ ጽልስያዌነ ጽሉዋ ቦላ ፕርድያዌ ኡንቱንቱ ላኡካ መና ጎዳ ሸነይያ ኦሱዋ።<verse eid="PRO 17:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 17:16"/>አኬካካ ደማናዉ አሙ አዉ ባይናን ደእሽን፥ ቦዛ ኩሽያን ደእያ ሚሻይ አ አያ ማዳነ?<verse eid="PRO 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 17:17"/>ላጊ ኡባ ዎደካ ሲቄ፤ እሻይካ መቱዋ ዎደ ማዳናዉ የለቴ።<verse eid="PRO 17:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 17:18"/>አኬካይ ፓጬዳ አሳይ ኤረና ኡራ አጩዋ ጭጋናዉ ዋስያ ገሌ።<verse eid="PRO 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 17:19"/>ዋላሳ ዶስያ አሳይ ናጋራ ዶሴ፤ ኡባ ገደ ጬቀትያ አሳይ ባየ ባረ ቦላ ጼሴ።<verse eid="PRO 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 17:20"/>ጌላ ቆፋይ ደእያ አሳይ ሎኦባ ደመና፤ ጭምያዋ ሃሳይያ አሳይካ መቱዋን ገሌ።<verse eid="PRO 17:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 17:21"/>ቦዛ ናኣ የሌዳ አዉ ካዮቴ፤ ቦዛ ናኣ አዎ ናሸቻይ ባዋ።<verse eid="PRO 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 17:22"/>ዎዛናይ ናሸትያዌ አሳዉ ሎኦ ለ፤ ሽን ካዮትያ አያናይ አሳዉ ዎልቃ ይሴ።<verse eid="PRO 17:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 17:23"/>ኢታ አሳይ ፕርዳ ጌላያናዉ ጌማን ማታይያ አኬ።<verse eid="PRO 17:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 17:24"/>አኬካይ ደእያ ኡራይ አዳ ኤራተ ስንን ዎደ ቤ፤ ሽን ቦዛ አይፊ ቢታ ሳኣ ዩሹዋ ዩዪደ ጼሌ።<verse eid="PRO 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 17:25"/>ቦዛ ናአይ ባረ አዉዋ ካዮዬ፤ ባረና የሌዳ አቶካ ዝልእሴ።<verse eid="PRO 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 17:26"/>ጽሎ አሳ ሙርያዌ፥ ሱረ አሳካ ደችያዌ ሎአ ግደና።<verse eid="PRO 17:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 17:27"/>አማሬኤዳ ቃላ ሃሳይያ አሳይ ኤራንቻ፤ ዎፓ አያናይ ደእያ አሳይካ አኬካንቻ።<verse eid="PRO 17:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 17:28"/>ቦዛ ኡራይ ጮኡ ጎፐነ ባረ ዶና ባሮፐ፥ ኤራንቻ ማላቴ።<verse eid="PRO 17:28"/></para>
  <chapter eid="PRO 17"/>
  <chapter number="18" style="c" sid="PRO 18"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 18:1"/>ሻከታናዉ ኮይያ አሳይ ባረ አሙዋ ካሌ፤ ሎኦ ኤራ ኡባካ ጳልቄ።<verse eid="PRO 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 18:2"/>ቦዛይ ባረ ቆፋ ቆንጭሳናዋ ጻላላ ዶስያዋፐ አትና፥ ሀራ አሳፐ ኤራ አካናዉ ዶሰና።<verse eid="PRO 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 18:3"/>ኢታተይ ይያ ዎደ፥ ካ፥ ካዉሻይነ ዬላይ አ ካሊደ ይ አጊኖ።<verse eid="PRO 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 18:4"/>አሳ ዶናፐ ከስያ ሃሳያይ ጪሞ ሃ ማላ፤ አዳ ኤራተ ፑልቱካ ጎግያ ሃ ማላ።<verse eid="PRO 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 18:5"/>ባይዛንቻ ማዲደ፥ ጽሉዋ ፕርዳ ጌላይያዌ ሎአ ግደና።<verse eid="PRO 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 18:6"/>ቦዛ አሳይ ባረ ሃሳያን ዋላሳ ደን፤ አ ዶናፐ ከስያ ቃላይ አ ቦላ ጻምኣ ጼሴ።<verse eid="PRO 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 18:7"/>ቦዛ አሳይ፥ ሃሳዪደ ባረና ቆሄ፤ አ ሃሳያይ ግትያ ግዲደ፥ አ ኦይቄ።<verse eid="PRO 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 18:8"/>ዝግርሳ ቃላይ ማልኦ ቁማ ማላ፤ ናሸቺደ ዱገ ጋንጅያ ጋኬ።<verse eid="PRO 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 18:9"/>ባረ ኦያ ኦሱዋን አዛልያ አሳይ ባይዝያ ኡራፐ አይነ ዱማተና።<verse eid="PRO 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 18:10"/>መና ጎዳ ሱንይ ምኖ ግምቢያ ማላ፤ ጽሎ አሳይ ያ ዎጺደ ሳሮ አታና።<verse eid="PRO 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 18:11"/>ሽን ዱረ አሳቶ ኡንቱንቱ ዱረተይ ዩሹ ግምበቴዳ ካታማ ማላ፤ ኡንቱንቱ ቆፋን ኡንቱንቱ ዱረተይ ምኖ ድርሳዳን ኡንቱንታ ናግያዋ ማላቴ።<verse eid="PRO 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 18:12"/>አሳይ ኩንዳናፐ ካሰ አ ዎዛናይ ኦቶረቴ፤ ቦንቼትያዋፐካ ባረ ሁጲያ ዝቂ ኦያዌ ስንቴ።<verse eid="PRO 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 18:13"/>ስሰናን ደኢድ ዛርያዌ፥ ሄዌ ሄ ኡራዉ ቦዛተነ ዬላ።<verse eid="PRO 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 18:14"/>አሳ አያናይ ሀርግያ ዳንዳያናዳን ማዴ፤ ሽን አያናይ መኤረት ክቾፐ፥ አ ኦን ዳንዳያኔ?<verse eid="PRO 18:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 18:15"/>አኬካንቻ አሳቱ ታማራናዉ ሎይ ኮዪኖ፤ አዳ ኤራይ ደእያዋካ ሀይዚኖ።<verse eid="PRO 18:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 18:16"/>እምያዌ እምያዎ ኦግያ ዶዬ፤ ዎልቃማ አሳናካ ኤርሴ።<verse eid="PRO 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 18:17"/>ካሰቲደ ዳናን ሞትያ ኡራይ ባልጋራይ ዪደ አ ኦቻና ጋካናዉ፥ ኡባ ገደካ ሄ ኡራይ ጽሉዋ ማላቴ።<verse eid="PRO 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 18:18"/>ሳማ የግያዌ ፓሉምያ ተኤ፤ ላኡ ዎልቃማ ባልጋራቱዋካ ሻኬ።<verse eid="PRO 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 18:19"/>ናቀቴዳ እሻይ ግምበቴዳ ካታማፐ አደ ምኔ፤ አ ፓሉሚካ ብራታ ጎርዱዋ ማላ።<verse eid="PRO 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 18:20"/>ባረ ዶናን ሃሳዬዳዋፐ አሳይ ባረ ጋንጅያ ኩን፤ ባረ እንጻርሳፐ ከሴዳዋን ካሌ።<verse eid="PRO 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 18:21"/>ኔን ሃሳዬዳዌ ኔና ዎ ዎይ ዎ፤ ሄዋ ድራዉ፥ ኔን ነ ሃሳያ ጋሱዋን ይያዋ አካናዉ ደኣሳ።<verse eid="PRO 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 18:22"/>ማቻቶ ደሜዳ አሳይ ሎኦባ ደሜዳ፤ ሄ ኡራይ መና ጎዳንካ ናሸቴ።<verse eid="PRO 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 18:23"/>ህዬሳ አሳይ አዉዳሺደ ሃሳዬ፤ ሽን ዱሪ ፔኑቄቲደ ዛሬ።<verse eid="PRO 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 18:24"/>ዳሮ ላጊ ደእያ አሳይ ያና፤ ሽን እሻፐ አደ አማንያ ላጊ ደኤ።<verse eid="PRO 18:24"/></para>
  <chapter eid="PRO 18"/>
  <chapter number="19" style="c" sid="PRO 19"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 19:1"/>ዎርዶ ሃሳያ ሃሳይያ ቦዛፐ ባረ ደኡዋን ቶሺ ባይና ህዬሳ አሳይ ኬካ።<verse eid="PRO 19:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 19:2"/>ኤር ባይና ሴላይ ሎአ ግደና፤ ሀመቲደ ኤሌልያ ኡራይካ ዎራ ቤ።<verse eid="PRO 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 19:3"/>እት እት አሳይ ባረ ቦዛተን ባረ ደኡዋ ባይዜ፤ ያቲደ ቃይ መና ጎዳ ቦላ ይሎቴ።<verse eid="PRO 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 19:4"/>ዱረተይ ዳሮ ላገቱዋ ጉጄ፤ ሽን ህዬሳተይ ደእያ ላገቱዋካ ዱ።<verse eid="PRO 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 19:5"/>ዎርዶ ማርካይ ሙረተናን ቤና፤ ዎርዱዋ ሃሳይያዋንቱካ ከስ አክክኖ።<verse eid="PRO 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 19:6"/>ዳሮ አሳይ ሞድያ አሳ ስን ኮዬ፤ ጮ እምያ ኡራና አሳይ ኡባይ ዳቦቴ።<verse eid="PRO 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 19:7"/>ህዬሳ አሳ አ እሻቱ ኡባይ እጺኖ፤ ሄዋፐካ አዋ አ ላገቱ አፐ ሃኪኖ፤ እ ኡንቱንታ አዉዳሺደ ካልናካ፥ ኡንቱንቱ አ ጋ ኦይክኖ።<verse eid="PRO 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 19:8"/>አዳ ኤራተ ደምያዌ ባረና ሲቄ፤ አኬካ ካርህ ኦ ኦይቂያዌ ሎኦባ ደሜ።<verse eid="PRO 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 19:9"/>ዎርዶ ማርካይ ሙረተናን አተና፤ ዎርዱዋ ሃሳይያዌካ ያና።<verse eid="PRO 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 19:10"/>ቦዛ ኡራዉ እሻሎ ደኡ በሰና፤ ሄዋፐካ አይሊ ካፖቱዋ ሞድያዌ ኢታ ዳሬ።<verse eid="PRO 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 19:11"/>አዳ ኤራተይ አሳዉ ዳንዳያ እሜ፤ ባይዜዳ ኡራዉ አቶ ግያዌካ ቦንችሴ።<verse eid="PRO 19:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 19:12"/>ካትያ ሀንቁ ጋሙዋ ጉዱዋ ማላ፤ ሽን አ ሳባይ ማታ አጭስያ ከተርሳ ማላ።<verse eid="PRO 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 19:13"/>ቦዛ ናአይ ባረ አዉዋ ይሴ፤ ዋላሳንቻ ማቻታካ ጎሊ ኡባ ገደ ጾክያ ጾኩዋ ማላ።<verse eid="PRO 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 19:14"/>እት አሳይ ጎልያነ ማጹዋ ባረ አዉዋፐ ላታናዉ ዳንዳዬ፤ ሽን አኬካንቻ ማቻቶ መና ጎዳይ እሜ።<verse eid="PRO 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 19:15"/>ጮ ዞልፓካትያ ኡራዉ ገምእሹ ዬ፤ ኦሱዋ ኦና አሳይ ኮሻቴ።<verse eid="PRO 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 19:16"/>አዛዙዋ ናጊደ ኦያ አሳይ፥ ባረ ሸምፑዋ ናጌ፤ ሽን ሸነኮ ግያ አሳይ ሀይቄ።<verse eid="PRO 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 19:17"/>ህዬሳዉ ኬክያ አሳይ መና ጎዳዉ ታልኤ፤ እ ሄ ሎኦ ኦሱዋ አጩዋ ጭጌ።<verse eid="PRO 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 19:18"/>ስምያ ህዶታይ ደእሺና፥ ነ ናናቱዋ ሴራ፤ ሴራና ዮፐ፥ ኔን ኡንቱንታ ባይዛዳ።<verse eid="PRO 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 19:19"/>ሀንቁዋ ሱልያ አሳይ ባረ ጋትያ አኮ፤ አ አጋ፤ ኔን አ አሽያዋ ግዶፐ፥ ሀራቱዋካ ኔን አ ሄዋዳን ኦናዌ አተና።<verse eid="PRO 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 19:20"/>ዞርያ ስሳ፤ ትምርትያካ አካ። ያቶፐ፥ ኔን ዉርሰን አዳ ኤራንቻ ግዳናሳ።<verse eid="PRO 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 19:21"/>አሳይ ዳሮባ ሀልቼ፤ ሽን መና ጎዳይ ጌዳዌ ፖለቴ።<verse eid="PRO 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 19:22"/>አሳፐ ኮየትያዌ አገና ሲቁዋ፤ ዎርዳንቻ ግዳናፐ ህዬሳ ግድያዌ ኬካ።<verse eid="PRO 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 19:23"/>መና ጎዳዉ ያይያዌ ደኦ ካለ፤ አዉ ያይያ አሳይ ካሊደ ደኤ፤ ኢታባይካ አ ቦቼና።<verse eid="PRO 19:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 19:24"/>እት እት አሳይ ዳሮ አዛላ፤ ዎጽያን ቱሼዳ ሶሉዋካ ፑደ ባራናዉ ዋየቴ።<verse eid="PRO 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 19:25"/>ኔን ቅሊጭያዋ ሾጮፐ፥ አኬካይ ፓጬዳዌ ጭንጫተ ታማራና፤ አኬካንቻ አሳ ኔን ሴሮፐ፥ እ ኤራተ ደማና።<verse eid="PRO 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 19:26"/>ባረ አዉዋ ቦንቂያ ናአይ፥ ባረ አቶካ ሶፐ ከሲደ የደርስያ ናአይ፥ ሄ ናአይ ዬላነ ካዉሻ አህያ ናኣ።<verse eid="PRO 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 19:27"/>ታ ናአዉ፥ ኔን ዞርያ ስስያዋ አጌዳዋ ግዶፐ፥ ኤራዉ ዞክያ ዛራዳ።<verse eid="PRO 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 19:28"/>ዎርዶ ማርካይ ሱረ ፕርዳ ቦላ ቅሊጬ፤ ኢታ አሳ ዶናይ ኢታተ ጉጂደ ምቴ።<verse eid="PRO 19:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 19:29"/>ቅሊጭያዋንቶ ፕርዳይ፥ ቦዛቶካ ዋይ ኮሼ።<verse eid="PRO 19:29"/></para>
  <chapter eid="PRO 19"/>
  <chapter number="20" style="c" sid="PRO 20"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 20:1"/>ዳሮ ማይያ ኡሻ ኡሽያዌ ዳሮ ብድሴነ ዋላሴ፤ ማትያ አሳይ ዎዛናይ ፓጬዳ አሳ።<verse eid="PRO 20:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 20:2"/>ካትያ ሀንቁ ጋሙዋ ጉደ ማላ፤ አ ይሎይያ አሳይ ባረ ሸምፑዋ ቦላ ፕርዴ።<verse eid="PRO 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 20:3"/>ፓሉምያፐ ጋጻን ደእያዌ አዎ ቦንቾ፤ ሽን ቦዛ አሳይ ኡባይ ዋላቀታናዉ ኤሌሌ።<verse eid="PRO 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 20:4"/>አዛላ ጎሻንቻይ ዎድያ ናጊደ ጎሸና፤ ሄዋ ድራዉ፥ ካ ጫክያ ዎደ እ ዎሴ፤ ሽን አያካ ደመና።<verse eid="PRO 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 20:5"/>አሳ ዎዛና ሀልቹ ጪሞ ኦላ ግዶን ደእያ ሃ ማላ፤ ሽን ዎዛናማ አሳይ ሄዋ ዱቂደ ከሴ።<verse eid="PRO 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 20:6"/>ዳሮ አሳቱ ባረንቱ ኬካተ ኦዲኖ፤ ሽን ቱሙ አማነትያ አሳ ደማናዌ ኦኔ?<verse eid="PRO 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 20:7"/>ጽሎ አሳይ ቶሺ ባይና ደኡዋ ደኤ፤ አ ካሊደ፥ አ ናናቱካ አንጀቴዳዋንታ።<verse eid="PRO 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 20:8"/>ካቲ ፕርዳናዉ ባረ ካዉተ አራታን ኡቴዳ ዎደ፥ ኢታ ኡባ ባረ አይፍያን ሀርቂደ ከሴ።<verse eid="PRO 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 20:9"/>“ታ ዎዛና ጌሻድ፤ ታናን ናጋርካ ባዋ” ያጋናዉ ዳንዳይያ አሳይ ደአኔሻ?<verse eid="PRO 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 20:10"/>መና ጎዳይ ዎርዱዋ ሚዛናን ይግያዋንታነ ልከ ግደናባን ማክያዋንታ እጼ።<verse eid="PRO 20:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 20:11"/>ናአይ ጌሻነ ሱረ ግድያዌ እ ኦያ ኦሱዋን ኤረቴ።<verse eid="PRO 20:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 20:12"/>ስስያ ሀይነ ጼልያ አይፍያነ፥ ኡንቱንታ ላኡዋካ መና ጎዳይ መዳ።<verse eid="PRO 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 20:13"/>ገምእሹዋን ነ ዎድያ ዉርሶፓ፤ ኔን ህዬሳና። ቤጎታ፤ ያቶፐ፥ ኔን ካ ካላና።<verse eid="PRO 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 20:14"/>ሻምያ አሳይ፥ “ቆሄ! ቆሄ!” ያጌ፤ ሽን ቤዳዋፐ ጉይያን፥ “ገሉዋን ሻማድ” ያጊደ ጬቀቴ።<verse eid="PRO 20:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 20:15"/>ኤራይ ኩሜዳ ሃሳያይ ዎርቃፐካ እንቁዋ ግያ ዳሮ አልኦ ሹቻፐካ አዳ አልኦባ።<verse eid="PRO 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 20:16"/>ኤረና አሳዉ ዋስያ ገልያ ኡራ ማዩዋ ቃር አክተ፤ እማ አሳዉ ዋስያ ገልያ ኡራ ማዩዋ ኦይቂተ።<verse eid="PRO 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 20:17"/>ዎርዱዋን ደሜዳ ካይ አሳ ማልኤ፤ ሽን አቅ ከሲደ፥ ዶና ግዶን ሻፍያዳን ሀኔ።<verse eid="PRO 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 20:18"/>ዞርያ አካደ ነ ሀልችያዋ ሀልቻ፤ ዞርያ አከናን ደኣደ ኦላዉ ቦፓ።<verse eid="PRO 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 20:19"/>ዝግርያ አሳይ ጹራ ገንና፤ ሄዋ ድራዉ፥ ኦዳንቻ ኡራና ጋከቶፓ።<verse eid="PRO 20:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 20:20"/>አሳይ ባረ አዉዋ ዎይ ባረ አቶ ሸቆፐ፥ አ ደኡዋ ጾምፕያ ጵ ጎ ማን ቶአና።<verse eid="PRO 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 20:21"/>ኮይሩዋን ኤለካ ሺቄዳ አቁ ዉርሰን አንጀተና።<verse eid="PRO 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 20:22"/>ነዉ ኢታ ኦዳ ኡራዉ፥ “ታንካ አዉ ኢታ ኦና” ጎፓ፤ መና ጎዳን አማነታደ ናጋ፤ እ ኔና አሻና።<verse eid="PRO 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 20:23"/>መና ጎዳይ ላኡ ቆሞ ሚዛናቱዋ ሸነቴ፤ ዎርዱዋ ሚዛናቱካ አ ናሸችክኖ።<verse eid="PRO 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 20:24"/>አሳይ ባናዉ በስያ ኦግያ መና ጎዳይ ካለ፤ ያትና፥ አሳይ ባረ ደኡዋን ባና ኦግያ ዎቲደ አኬካናዉ ዳንዳዪ?<verse eid="PRO 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 20:25"/>እትባ ኤሌሊደ፥ “ሀዋ ታን ጾሳዉ እማድ” ግ ድግያዌነ ጉየፐ ዝንቆትያዌ፥ ሄዌ አሳ ኦይቂያ ጲረ።<verse eid="PRO 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 20:26"/>አዳ ኤራንቻ ካቲ ማካላንቻቱዋ ሻኪደ ኤሬ፤ እ ኡንቱንታ ቃረተናን ሙሬ።<verse eid="PRO 20:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 20:27"/>አሳ አያናይ መና ጎዳዉ ጾምፕያ፤ ሄዋ ድራዉ፥ እ ኑ ግዶ አሳተ ኡባ ፕልግ ጼሌ።<verse eid="PRO 20:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 20:28"/>አገና ሲቁነ አማነትያዌ ካትያ ናጊኖ፤ አ ካዉተ አራታይ አገና ሲቁዋን ምኔ።<verse eid="PRO 20:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 20:29"/>ያላጋቱዋ ቦንቹ ኡንቱንቱ ዎልቃ፤ ጭማቶካ ኡንቱንቱ ፑሉንይ ኡንቱንቶ ቦንቹዋ።<verse eid="PRO 20:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 20:30"/>ምኖ ሙሩ ኢታተ ሾዴ፤ ዋያዌ ኢታ ዎዛና ላማናዉ ዳንዳዬ።<verse eid="PRO 20:30"/></para>
  <chapter eid="PRO 20"/>
  <chapter number="21" style="c" sid="PRO 21"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 21:1"/>ካትያ ዎዛናይ መና ጎዳ ኩሽያና፤ እ አ ዎዛና ጎግያ ሃ ዛርያዋዳን፥ ባረ ኮዬዳሳ ዛሬ።<verse eid="PRO 21:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 21:2"/>አሳይ ኦያዌ ኡባይ እዛዎ ልከ ማላቴ፤ ሽን መና ጎዳይ አ ዎዛና ቆፋ ፓጬ።<verse eid="PRO 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 21:3"/>ያርሹዋ ያርሽያዋፐካ አደ፥ ጽሎባነ ሱረባ ኦያዋ መና ጎዳይ ዶሴ።<verse eid="PRO 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 21:4"/>ኢታቱ ኦቶረትያዋንነ አይያዋን ኤረቲኖ፤ ሄዌካ ናጋራ።<verse eid="PRO 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 21:5"/>ምኖ ኦሳንቻ ሀልቹ ዱረዬ፤ ሽን ኤሌልያ ኡባይ ህዬሳና።<verse eid="PRO 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 21:6"/>ዎርዶቲደ ዳጋዬዳ ዱረታይ ፐንቱዋ ሱሉዋዳን ዬ፤ ሄዋ ኮይያዋንቱ ሀይቁዋ ኮዪኖ።<verse eid="PRO 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 21:7"/>ኢታቱ ሱረባ ኦናዉ እጽያ ድራዉ፥ ኡንቱንቱ ማካላ ኦሱ ኡንቱንታ አኪደ ቤ።<verse eid="PRO 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 21:8"/>ባይዛንቻቱ ጌላ ኦግያን ሀመቲኖ፤ ሽን ጌሻቱ ሱረባ ኦኖ።<verse eid="PRO 21:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 21:9"/>ዋላቀትያ ማቻትና እት ጎልያን ደእያዋፐ ሄ ጎልያ ካሻን ደእያዌ ኬካ።<verse eid="PRO 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 21:10"/>ኢታቱ ኢታባ ኦናዉ አሞቲኖ፤ ባረንቱ ሾሮቶ ቃረትክኖ።<verse eid="PRO 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 21:11"/>ቅሊጭያዌ ሙረቴዳ ዎደ፥ ዎዛናይ ፓጬዳ ኡራይ አዳ ኤራ ታማሬ፤ ቃይ ዎዛናማ ኡራይ ታማሪደ፥ ኤራ ደሜ።<verse eid="PRO 21:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 21:12"/>ጽሎ ጾሳይ ኢታቱዋ ሶን ኦሰትያዋ ኡባ በኤ፤ ኡንቱንታ አ የጊደ ይሴ።<verse eid="PRO 21:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 21:13"/>ህዬሳ ዋሱዋ ስሳናፐ ጊደ፥ ባረ ሀይ ቱጭያ ኡራይ፥ እካ ዋሳና፤ አልያዌ ያና።<verse eid="PRO 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 21:14"/>ጌማን እምያ እሙ ሀንቁዋ ዶሽሴ። አፍላ ግዱዋና እሜዳ ማታዪ ሱሎ ሀንቁዋ እርጽሴ።<verse eid="PRO 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 21:15"/>ሱረ ፕርዳይ ፕርደቴዳ ዎደ፥ ሄዌ ጽሎ ናሸቻ፤ ሽን ኢታ ኦያዋንቶ ዳጋማ።<verse eid="PRO 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 21:16"/>አኬካ ኦግያፐ ሀድሬዳ ኡራ ሀይቁ ናጌ።<verse eid="PRO 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 21:17"/>አ እንጅያን ደአና ግያ ኡራይ ማንቄ፤ ዎይንያ ኤሳነ ዛይትያ ዶስያ አሳይ ዱረተና።<verse eid="PRO 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 21:18"/>እት እት ገደነ ጾሳ አሳቱዋ አሻናዉ ኢታ አሳቱ ሙረቲኖ፤ አማነተና አሳቱካ ሱረ አሳቱዋ ድራዉ ሙረቲኖ።<verse eid="PRO 21:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 21:19"/>ዋላቀትያነ ይሎትያ ማቻትና ደአናፐ ባዙዋን ደእያዌ ኬካ።<verse eid="PRO 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 21:20"/>ዎዛናማ ኡራ ሶን ማልኦ ቁማይነ ኦይሳይ ምንጀቴ፤ ሽን ቦዛ አሳይ ባረዉ ደእያዋ ኡባ ም ድጌ።<verse eid="PRO 21:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 21:21"/>ጽሎተነ አገና ሲቁዋ ኮይያ ኡራ ላይይ አዱቄ፤ ቃይ ሄ ኡራይ ጽሎተነ ቦንቹዋ ደሜ።<verse eid="PRO 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 21:22"/>ዎዛናማ አሳይ ዎልቃማ ኦላንቻቱ ደእያ ካታማ ኦሊደ ኦይቄ፤ ኡንቱንቱ አማነቴዳ ምኖ ጌሱዋካ ላሌ።<verse eid="PRO 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 21:23"/>ባረ ዶናነ ባረ እንጻርሳ ናግያ አሳይ ባረና መቱዋፐ ናጌ።<verse eid="PRO 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 21:24"/>ኦቶረትያነ አይያ አሳይ ቅሊጭያዋ ጌተቴ፤ እ ኦቶራንቻ ግዴዳ ድራዉ፥ አሳዉ ቆፐና።<verse eid="PRO 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 21:25"/>አዛላ አሙ ዎ፤ አያዉ ጎፐ፥ እ ኦናዉ ኮየና።<verse eid="PRO 21:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 21:26"/>አዛላይ ጋላሳ ኩመን ዳሮባ ደማናዉ አሞቴ፤ ሽን ጽሉ ባረዉ አሸናን እሜ።<verse eid="PRO 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 21:27"/>ጾሳይ ኢታቱዋ ያርሹዋ ሸነቴ፤ ሄዋፐካ ኡንቱንቱ አዉ ኢታ ቆፋን ሺሽያ ያርሹዋ አ ሸነቴ።<verse eid="PRO 21:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 21:28"/>ዎርዶ ማርካይ ያና፤ ሽን ቆፒደ አኬካን ሃሳይያ ኡራ ሃሳያይ አከታና።<verse eid="PRO 21:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 21:29"/>ኢታ አሳይ ታዋ ጻላላይ ልከ ጌ፤ ሽን ሱረ አሳይ ዩሽ ቆፔ።<verse eid="PRO 21:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 21:30"/>አሳይ ባረ አዳ ኤራተን፥ አኬካንነ ዞርያን መና ጎዳና ኤቀታናዉ ዳንዳየና።<verse eid="PRO 21:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 21:31"/>ኦላዉ ፓራ ኮራናዉ ዳንዳየቴ፤ ሽን ኦላ ጾንስያዌ መና ጎዳ።<verse eid="PRO 21:31"/></para>
  <chapter eid="PRO 21"/>
  <chapter number="22" style="c" sid="PRO 22"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 22:1"/>ሎኦ ሱንይ ዳሮ ዱረተፐ አ፤ ሳበትያዌካ ብራፐነ ዎርቃፐ አ።<verse eid="PRO 22:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 22:2"/>ዱርያነ ማንቁዋ ኡባካ መና ጎዳይ መዳ፤ ሄዋን ኡንቱንቱ ላኡካ ቃራ።<verse eid="PRO 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 22:3"/>ጭንጫ አሳይ ኢታ በኢደ፥ ቆሰት አ፤ ሽን አኬካይ ፓጬዳ አሳይ መቱዋን ገሊደ ቆሄቴ።<verse eid="PRO 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 22:4"/>ኔን አሽከ ግዶፐነ መና ጎዳዉ ያዮፐ፥ ዱረተ፥ ቦንቹዋነ ደኡዋ ደማና።<verse eid="PRO 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 22:5"/>ኢታ ኡራ ኦግያን አጉንይነ ጲሪ ደኤ፤ ሽን ባረና ናግያ አሳይ ኡንቱንቱፐ ሃኬ።<verse eid="PRO 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 22:6"/>ናአይ ዋኒደ ደአና በስንቶ ታማርሳ፤ ያቶፐ፥ እ ጭሚደካ ሄዋ አገና።<verse eid="PRO 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 22:7"/>ዱሪ ህዬሳ ሞዴ፤ ታልእ አኬዳዌ ታልእያ እሜዳዎ አይለ ግዴ።<verse eid="PRO 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 22:8"/>ናጋራ ዘርያ ኡራይ ዋይያ ጫኬ፤ ሀራቱዋ እ ቱጋይያ ቱጋ ጻምአይ መኤና።<verse eid="PRO 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 22:9"/>ኬካ አሳይ ባረ ቁማፐ ህዬሳዉ ጮ እምያ ድራዉ አንጀታና።<verse eid="PRO 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 22:10"/>ቅሊጭያ አሳ ከሳ ድጎፐ፥ ፓሉሚ፥ ዋላሳይነ ቦሪ ክቻና።<verse eid="PRO 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 22:11"/>ኔን ዎዛና ጌሻተነ ኬካ ሃሳያ ዶሶፐ፥ ካቲ ኔናና ዳቦቴ።<verse eid="PRO 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 22:12"/>መና ጎዳይ ኤረተ ናጌ፤ ሽን ዎርዳንቻቱዋ ቃላ እ አ የጌ።<verse eid="PRO 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 22:13"/>ቦዛ አሳይ፥ “ታን ካረ ከሶፐ፥ ጋሙ ታና ማና፤ ታና ኦግያን አሳይ ዎና” ያጌ።<verse eid="PRO 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 22:14"/>ዎሹምያ ማጫ ምሽራት ዶናይ ጪሞ ኦላ ማላ፤ መና ጎዳይ ሀንቀቴዳ ኡራይ አ ግዶን ኩንዴ።<verse eid="PRO 22:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 22:15"/>ናኣ ዎዛና አዛላተይ ባቂ ኦይቄ፤ ሽን ቃይጼርያን ሙርያዌ አፐ ሃሴ።<verse eid="PRO 22:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 22:16"/>ባረዉ ማጹዋ ጉጃና ጊደ፥ ህዬሳ ናቂያዌ ዱርያዉ እሙዋ እምያዌ ላኡካ ህዬሳና።<verse eid="PRO 22:16"/></para>
  <para style="s1">ሀታሙ አዳ ኤራ ሃሳያቱዋ</para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 22:17"/>ነ ሀይ ሃ የጋደ፥ አዳ ኤራንቻይ ኦድያዋ ስሳ፤ ነ ዎዛናካ ታ ኤራኮ ዛራ። <verse eid="PRO 22:17"/><verse number="18" style="v" sid="PRO 22:18"/>አያዉ ጎፐ፥ ኡንቱንታ ነ ዎዛናን ዎፐነ ነ ዶናንካ ኡንቱንቱ ኡባ ሀሳዮፐ፥ ኔን ናሸታና። <verse eid="PRO 22:18"/><verse number="19" style="v" sid="PRO 22:19"/>ነ አማኑ መና ጎዳን ግዳና ማላ፥ ታን ኔና ሀች ታማርሳድ። <verse eid="PRO 22:19"/><verse number="20" style="v" sid="PRO 22:20"/>ታን ነዉ ዞሪነ ኤራተይ ደእያ ሀታሙ ሌምሳቱዋ ጻፎዌሽ! <verse eid="PRO 22:20"/><verse number="21" style="v" sid="PRO 22:21"/>ኔና ኪቴዳዎ ኔን ልከ ዛሩዋ ዛራና ማላ፥ ታን ኔና ቱማተ ታማርሳድ።<verse eid="PRO 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 22:22"/>ህዬሳቶ አያይነ ባይና ድራዉ፥ ኡንቱንቱዋ ቦንቆፓ፤ ችሎታንካ መቶታንቻቱዋ ማታ ይሶፓ።<verse eid="PRO 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 22:23"/>አያዉ ጎፐ፥ መና ጎዳይ ኡንቱንቱ ድራዉ ሞተታና፤ ኡንቱንታ ቦንቄዳዋንታካ እ ቦንቃና።<verse eid="PRO 22:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 22:24"/>ሀንቀትያ ኡራና ላገቶፓ፤ ሀንቀታናዉ ኤሌልያ ኡራናካ ዙፐቶፓ።<verse eid="PRO 22:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 22:25"/>ኔን አ ሀኑዋ ሜዘቶፐ፥ ጉየፐ አጋናዉ ዳንዳያካ።<verse eid="PRO 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 22:26"/>አሳዉ አጩዋ ታ ቃንጻና ጋደ ዋስያ ገሎፓ።<verse eid="PRO 22:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 22:27"/>ኔን ቃንጽያዌ ዮፐ፥ ነ ግስያ ሂጻይ አተናን፥ ነዉ ደእያባይ ኡባይ አከታና።<verse eid="PRO 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 22:28"/>ነ ማይዛ አዎቱ ቶኬዳ በን ዛዋ ሾዶፓ።<verse eid="PRO 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 22:29"/>ባረ ኦሱዋ ሎሀተን ኦያ አሳ በኣድ? እ ካተቶ ኦፐ አትና፥ ጮ አሳቶ ኦና።<verse eid="PRO 22:29"/></para>
  <chapter eid="PRO 22"/>
  <chapter number="23" style="c" sid="PRO 23"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 23:1"/>ኔን አሳ ሞድያዋና እትፐ ቁማ ማናዉ ኡቴዳ ዎደ፥ ነ ስንን ደእያዋ ሎይደ አኬካ። <verse eid="PRO 23:1"/><verse number="2" style="v" sid="PRO 23:2"/>ኔን ዳሮ ዮራ አሳ ግዶፐ፥ ናገታ። <verse eid="PRO 23:2"/><verse number="3" style="v" sid="PRO 23:3"/>እ ኔና ፓጫናዉ ዳንዳይያ ድራዉ፥ አዳ ማልኦ ቁማዉ ያዉነቶፓ።<verse eid="PRO 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 23:4"/>ዱረታናዉ ዳቡሮፓ፤ ሄዋ ማላ ኬስያ አጋናዉ ጭንጫ ግዳ። <verse eid="PRO 23:4"/><verse number="5" style="v" sid="PRO 23:5"/>ሄዋ ማላ ዱረተይ ኔን ጼልሽን ያና፤ ቀፍያ ከሲደ አርጋንዋዳን፥ ሳሉዋ ፓላና።<verse eid="PRO 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 23:6"/>ኡዝያ ቁማ ሞፓ፤ አ ማልኦ ቁማካ ማናዉ አሞቶፓ። <verse eid="PRO 23:6"/><verse number="7" style="v" sid="PRO 23:7"/>ማላትሳናዉ እ ኔና፥ “ማ፤ ኡሻ” ያጌፐ አትና፥ አ ዎዛናይ ኔናና ደኤና። <verse eid="PRO 23:7"/><verse number="8" style="v" sid="PRO 23:8"/>ኔን ሜዳ ላፋ ቁማ ጮሻና፤ ነ ጋላታይካ መላ ግዳና።<verse eid="PRO 23:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 23:9"/>ቦዛዉ ሎኦባ ሃሳዮፓ፤ አያዉ ጎፐ፥ ነ አዳ ኤራ ሃሳያ እ ካና።<verse eid="PRO 23:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 23:10"/>በን ዛዋ ሾዶፓ፤ ቃይ አዉ ባይና ናናቱዋ ጋድያ ዛዋ ሱጎፓ፤ <verse eid="PRO 23:10"/><verse number="11" style="v" sid="PRO 23:11"/>አያዉ ጎፐ፥ ኡንቱንታ አሽያ ጾሳይ ምኖ፤ እ ኡንቱንቱ ድራዉ ኔናና ሞተታና።<verse eid="PRO 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 23:12"/>ነ አስታማሪ ነዉ ኦድያዋ ሀይዛ፤ ነ ሀይካ ኤራ ቃላኮ ዛራ።<verse eid="PRO 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 23:13"/>ናኣ ሴረናን አጎፓ፤ ኔን አ ቃይጼርያን ዋፐ፥ እ ሀይቀና። <verse eid="PRO 23:13"/><verse number="14" style="v" sid="PRO 23:14"/>ኔን አ ቃይጼርያን ዋፐ፥ አ ሸምፑዋ ሀይቁዋፐ አሻሳ።<verse eid="PRO 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 23:15"/>ታ ናአዉ፥ ኔን ነ ዎዛናን አዳ ኤራንቻ ግዶፐ፥ ታ ዎዛናይካ ናሸታና፤ <verse eid="PRO 23:15"/><verse number="16" style="v" sid="PRO 23:16"/>ነ እንጻርሳይ ሱረባ ሃሳዮፐ፥ ታ ዎዛናይ ናሸቴ።<verse eid="PRO 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 23:17"/>ናጋራንቻቱዋ ቃናቶፓ፤ ሽን ኡባ ገደ መና ጎዳዉ ያይያዋ አጎፓ። <verse eid="PRO 23:17"/><verse number="18" style="v" sid="PRO 23:18"/>ያቶፐ ነዉ ስንናዉ ሳአይ ኬካና፤ ነ ህዶታይካ የና።<verse eid="PRO 23:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 23:19"/>ታ ናአዉ፥ ስሳ፤ ዎዛናማ ግዳ፤ ነ ዎዛና ሱረ ኦግያን ዎ። <verse eid="PRO 23:19"/><verse number="20" style="v" sid="PRO 23:20"/>ዳሮ ዎይንያ ኤሳ ኡሽያዋንቱናነ አሹዋ ሙሳዉ ያረትያዋንቱና ዙፐቶፓ፤ <verse eid="PRO 23:20"/><verse number="21" style="v" sid="PRO 23:21"/>አያዉ ጎፐ፥ ማትያዋንቱነ ዮራንቻቱ ማንቃና፤ ገምእሹዋ ዳሩ አሳ ዉሬዳ ጩርቃ ማይዝሴ።<verse eid="PRO 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 23:22"/>ኔና የሌዳ ነ አቡ ኦድያዋ ስሳ፤ ነ አታካ ኤጬዳ ዎደ ካፓ። <verse eid="PRO 23:22"/><verse number="23" style="v" sid="PRO 23:23"/>ቱሙዋ፥ አዳ ኤራተ፥ ትምርትያነ አኬካ ሻማፐ አትና፥ ኡባካ ዛልኦፓ። <verse eid="PRO 23:23"/><verse number="24" style="v" sid="PRO 23:24"/>ጽሎ ናኣ አቡ ሎይ ናሸታና፤ ዎዛናማ ናኣ የሌዳ ኡራይካ አን ሀሹ ጋና። <verse eid="PRO 23:24"/><verse number="25" style="v" sid="PRO 23:25"/>ነ አቡነ ነ አታ ናሸትኖ፤ ኔና የሌዳናካ ሀሹ ጉ።<verse eid="PRO 23:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 23:26"/>ታ ናአዉ፥ ታ ዞርያ ሀይዛ፤ ታን ሀንያዋዳን ሀና። <verse eid="PRO 23:26"/><verse number="27" style="v" sid="PRO 23:27"/>አያዉ ጎፐ፥ ዎሹምያ ምሽራታ ጪሞ ኦላ ማላ፤ ጫራቱዋ ኦይቂያ ማቻታካ ኡንአ ኦላ ማላ። <verse eid="PRO 23:27"/><verse number="28" style="v" sid="PRO 23:28"/>አ ፓኑዋዳን ቆሰታ ኡታደ ናጋዉ፤ አማነተና አቱማ አሳ አሳ ግዶን ዳርሳዉ።<verse eid="PRO 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 23:29"/>“ዎ!” ግያ ዋሱ ኦሴ? ካዩ ኦሴ? ዋላሳይ ኦሴ? ዙዙንይ ኦሴ? ጋሱ ባይናን ማዱጽያዌ ኦሴ? አይፊ ዞእያዌ ኦሴ? <verse eid="PRO 23:29"/><verse number="30" style="v" sid="PRO 23:30"/>ዎይንያ ኤሳ ኡሺደ ጋምእያዋንቱሳ ግደኔ? ዋላከቴዳ ዎይንያ ኤሳ ኡሽ ኡሽ በእያዋንቱሳ ግደኔ? <verse eid="PRO 23:30"/><verse number="31" style="v" sid="PRO 23:31"/>ዎይንያ ኤሳይ ዞኤዳ ዎደ፥ አ ማላይ ብርልያ ግዶን ጶልያ ዎደ፥ ኡሽሽን ዋላላቲደ ገልያ ዎደ፥ አ ጼሎፓ። <verse eid="PRO 23:31"/><verse number="32" style="v" sid="PRO 23:32"/>ዉርሰን እ ሾሻዳን ዱኬ፤ ሙሉሙቀ ሾሻዳንካ ባረ ይሻ ፑኬ። <verse eid="PRO 23:32"/><verse number="33" style="v" sid="PRO 23:33"/>ነ አይፊ በእ ኤረናዋ በአና፤ ነ ዎዛናይካ ሱረ ቆፓናዉነ ሃሳያናዉ ዳንዳየና። <verse eid="PRO 23:33"/><verse number="34" style="v" sid="PRO 23:34"/>ኔን አባ ግዶን ሆቢ ቃያ ማርካብያ ጼራን ግሴዳ ኡራ ማላ ግዳና። <verse eid="PRO 23:34"/><verse number="35" style="v" sid="PRO 23:35"/>ኔን፥ “ኡንቱንቱ ታና ደቼድኖ፤ ሽን ታን ቆሄታበይከ። ኡንቱንቱ ታና ዋድኖ፤ ሽን ታዉ ኤረትቤና። ሀራ ኡሻ ኡሻናዉ ታን አዉደ ደንዳንድታሻ?” ያጋና።<verse eid="PRO 23:35"/></para>
  <chapter eid="PRO 23"/>
  <chapter number="24" style="c" sid="PRO 24"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 24:1"/>ታ ናአዉ፥ ኢታ አሳቱዋ ማላ ግዳርክታሻ ጎፓ፤ ኡንቱንቱና ዳቦታናዉካ አሞቶፓ፤ <verse eid="PRO 24:1"/><verse number="2" style="v" sid="PRO 24:2"/>አያዉ ጎፐ፥ ኡንቱንቱ ኡባ ገደ ማካላባ ማቀቲኖ፤ ባረንቱ እንጻርሳን ገንያባ ሃሳዪኖ።<verse eid="PRO 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 24:3"/>ጎሊ አዳ ኤራተን ኬጸቴ፤ አኬካንካ ምኔ። <verse eid="PRO 24:3"/><verse number="4" style="v" sid="PRO 24:4"/>ኤራይ ደኦፐ፥ ቆልኡ አልኦባንነ ሎኦባን ኡባን ኩሜ።<verse eid="PRO 24:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 24:5"/>ዎዛናማ ኡራዉ ዎልቃማ ዎልቃይ ደኤ፤ ኤራንቻ አሳይካ ምኖተ ጉጄ። <verse eid="PRO 24:5"/><verse number="6" style="v" sid="PRO 24:6"/>ኔን ኦላዉ ከሳናፐ ካሰታደ ሀልቹዋ ሀልቻናዉ ኮሼ፤ ዳሮ ዞርያዋንቱ ዞርያን ጾኑ ቤቴ።<verse eid="PRO 24:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 24:7"/>ቦዛይ አዳ ኤራተ አኬካናዉ ዳንዳየና፤ ሀቃ ያአንካ ኦድያዌ አይነ ባዋ።<verse eid="PRO 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 24:8"/>ኢታ ኦናዉ ሀልችያ ኡራይ ገናንቻ ጌተታና። <verse eid="PRO 24:8"/><verse number="9" style="v" sid="PRO 24:9"/>ቦዛተ ቆፋይ ናጋራ፤ አሳይ ቅሊጭያዋ እጼ።<verse eid="PRO 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 24:10"/>ኔን መቱዋ ጋላስ ላፎፐ፥ ነ ዎልቃይ ጉ ግያዋ።<verse eid="PRO 24:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 24:11"/>ሀይቃናዉ በሰናን፥ ሀይቆ ፕርዲደ አፍያዋንታ አሻ፤ ዎና ሀንያ ዎደ ጮኡ ጋደ ጼሎፓ። <verse eid="PRO 24:11"/><verse number="12" style="v" sid="PRO 24:12"/>ኔን፥ “ኑን ሀዋ ኤርበይኮ” ያጎፐ፥ ዎዛና ኤርያዌ እ በኤኔ? ነ ደኡዋ ናግያዌ ኤረኔ? አሳ ኡባዉ አ ኦሱዋ ኦሱዋዳን ዛረኔ?<verse eid="PRO 24:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 24:13"/>ታ ናአዉ፥ ኤሳ ማ፤ ኤሳይ ሎአ። ኤሳ እልሉ ጎጎጩዋን ማልኤ። <verse eid="PRO 24:13"/><verse number="14" style="v" sid="PRO 24:14"/>አዳ ኤራተይካ ሄዋ ማላ፤ እ ነ ሸምፖ ማልኦ ግድያዋ ኤራ። ኔን አ ደምያዋ ግዶፐ፥ ስንና ያና ህዶታይ ነዋ፤ ኔን አካና ጋደ ህዶታን ናግያዌካ የና።<verse eid="PRO 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 24:15"/>ጽሉዋ ጎልያነ ማጹዋ ቦንቃናዉ ቆፕያ ኢታ አሳዳን ሀኖፓ። <verse eid="PRO 24:15"/><verse number="16" style="v" sid="PRO 24:16"/>ጽሎ አሳይ ላፑን ገደ ኩንዶፐካ ደንዴ፤ ሽን ኢታቱ መቱዋን ያና።<verse eid="PRO 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 24:17"/>ነ ሞርኪ ኩንድያ ዎደ ናሸቶፓ፤ እ በትያ ዎደካ፥ “ሀሹ!” ጎፓ። <verse eid="PRO 24:17"/><verse number="18" style="v" sid="PRO 24:18"/>ኔን ናሸቶፐ፥ መና ጎዳይ ሄዋ በኢደ ናሸተና፤ አ ሀንቀትያዋካ አግ አጋና።<verse eid="PRO 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 24:19"/>ኢታ ኦያዋንቱ ድራዉ ህርጎፓ፤ ኡንቱንቱ ማላ ግዳርክታሻ ጎፓ። <verse eid="PRO 24:19"/><verse number="20" style="v" sid="PRO 24:20"/>አያዉ ጎፐ፥ ኢታ ኡራዉ ስንና ያና ህዶታይ ባዋ፤ ኢታቱዋ ጾምፒካ ቶአና።<verse eid="PRO 24:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 24:21"/>ታ ናአዉ፥ መና ጎዳዉነ ካትያዉ ያያ፤ ኡንቱንቶ ማካልያዋንቱናካ ዙፐቶፓ። <verse eid="PRO 24:21"/><verse number="22" style="v" sid="PRO 24:22"/>አያዉ ጎፐ፥ ሄዋ ማላ አሳቱዋ ቆፐና መቱ ጋኬ፤ ካትያፐነ ጾሳፐ ያና መቱዋ ኦኔ ኤርያዌ?<verse eid="PRO 24:22"/></para>
  <para style="s1">ሀራ አዳ ኤራ ሃሳያቱዋ</para>
  <para style="m">
    <verse number="23" style="v" sid="PRO 24:23"/>አዳ ኤራንቻቱ ጉጂደካ ሀዋዳን ያጌድኖ፦</para>
  <para style="p" vid="PRO 24:23">ፕርዲደ ማድያዌ ሎአ ግደና። <verse eid="PRO 24:23"/><verse number="24" style="v" sid="PRO 24:24"/>ባይዛንቻ፥ “ኔን ባይዛባካ” ያግያ ዳና አሳይ ሸቃና፤ ካዉተቱካ አ እጻና። <verse eid="PRO 24:24"/><verse number="25" style="v" sid="PRO 24:25"/>ባይዛንቻ ሙርያዋንቱ ሎይ ናሸታናነ አንጀታና።<verse eid="PRO 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 24:26"/>ሱረ ዛሩዋ ዛርያዌ ዳቦቶ ማላታ ማላ።<verse eid="PRO 24:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 24:27"/>ካሰታደ ነ ጋድያ ኦ፤ ካካ ዘራ፤ ሄዋፐ ጉይያን፥ ነ ጎልያ ኬጻ።<verse eid="PRO 24:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 24:28"/>ነ ሾሩዋ ቦላ ጋሱ ባይናን ማርካቶፓ፤ ነ ዶናንካ ጭሞፓ። <verse eid="PRO 24:28"/><verse number="29" style="v" sid="PRO 24:29"/>“እ ታዉ ኦዳዋዳን፥ ታን አዉ ኦና፤ ታን አዉ አ ኦሱዋ ኩሽያ ዛራና” ያጎፓ።<verse eid="PRO 24:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 24:30"/>ታን እት ጋላስ፥ እት አዛላነ አኬካይ ፓጬዳ ብታንያ ጋደን ደእያ ዎይንያ ቱራ ግዱዋና አድ። <verse eid="PRO 24:30"/><verse number="31" style="v" sid="PRO 24:31"/>አያ ዎደ፥ አጉንይነ ሻራፋይ ጎዝ ዎዳ፤ ዩሹዋን ሹቻ ግምቢካ ኮለት ክቼዳ። <verse eid="PRO 24:31"/><verse number="32" style="v" sid="PRO 24:32"/>ታን አ በኤዳ ዎደ፥ ቆፓድ፤ ታን በኤዳዋፐ ትምርትያ ታማራድ። <verse eid="PRO 24:32"/><verse number="33" style="v" sid="PRO 24:33"/>ኔን ጉ ልጵ ጋ፤ ጉ ገምእሻ፤ ነ ኩሽያካ ሺሻደ ጉ ሸምፓ አካ።<note caller="-" style="x"><char style="xo" closed="false">24:33-34 </char><char style="xt" closed="false"><ref loc="PRO 6:10-11">ሌም. 6:10-11</ref></char></note> <verse eid="PRO 24:33"/><verse number="34" style="v" sid="PRO 24:34"/>ሄዋፐ ጉይያን፥ ህዬሳተይ ፓኑዋዳን ያና፤ ፓጫይካ ኦላ ሚሻ ኦይቄዳ አሳዳን ፑቱ ጋና።<verse eid="PRO 24:34"/></para>
  <chapter eid="PRO 24"/>
  <chapter number="25" style="c" sid="PRO 25"/>
  <para style="s1">ሶሎሞን ጻፌዳ ሀራ ሌምሳቱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1"/>ሀዋንቱካ ቃይ፥ ይሁዳ ካትያ ህዝቂያሳ አሳቱ ዱቂደ ጻፌዳ ሶሎሞና ሌምሳቱዋ።<verse eid="PRO 25:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 25:2"/>ጹራ ገንያዌ ጾሳዉ ቦንቾ፤ ጹራ ፕልጊደ ከስያዌ ቃይ ካተቶ ቦንቾ።<verse eid="PRO 25:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 25:3"/>ሳሎቱዋ ቃተነ ሳኣ ጪማተ አሳይ ጋከናዋዳን፥ ካተቱዋ ቆፋካ አሳይ ኤራናዉ ዳንዳየና።<verse eid="PRO 25:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 25:4"/>ብራፐ ቅታ ድጋ፤ ሄዋፐ ጉይያን፥ ዎጋጪ ቆጺደ፥ ሎኦባ ከሳና።<verse eid="PRO 25:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 25:5"/>ካትያ ስንፐ ኢታቱዋ ድጋ፤ ያቶፐ፥ አ ካዉተ አራታይ ጽሎተን ምን ኤቃና።<verse eid="PRO 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 25:6"/>ካትያ ስን አያ ዎደ ጬቀቶፓ፤ ዎልቃማ አሳቱዋፐ ግዱዋን ሳኣ ኮዮፓ።<note caller="-" style="x"><char style="xo" closed="false">25:6-7 </char><char style="xt" closed="false"><ref loc="LUK 14:8-10">ሉቃሳ 14:8-10</ref></char></note> <verse eid="PRO 25:6"/><verse number="7" style="v" sid="PRO 25:7"/>ኔፐ ግታትያ አሳዉ ሳኣ እማናዉ ካፑ ኔና ደንና ካዉሽያዋፐ፥ ካፑ ኔና፥ “ሀዋኮ ቁ ጋ” ግያዌ ነዉ ኬካ።<verse eid="PRO 25:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 25:8"/>ነ አይፍያን በኤዳዋ ማርካታናዉ ዳባባ ባናዉ ኤሌሎፓ፤ አያዉ ጎፐ፥ ኔን ማርካታ ስምና፥ ሀራ አሳይ ነ ማርካተይ ባላ ግድያዋ ቆንጭሶፐ፥ ኔን ዬላታና። <verse eid="PRO 25:8"/><verse number="9" style="v" sid="PRO 25:9"/>ኔፐነ ነ ሾሩዋፐ ግዱዋን ፓሉሚ መቶፐ፥ አናና ሃሳያደ ነ ፓሉምያ ዉርሳ። ሀራ አሳ ጹራ ቆንጭሶፓ። <verse eid="PRO 25:9"/><verse number="10" style="v" sid="PRO 25:10"/>ሄዌ ዮፐ፥ ኔን ኦድያዋ ስሴዳ አሳይ ኔና ካዉሻና፤ ሄዋን ነ ሱንይ ላኤን ስመናዳን ባያና።<verse eid="PRO 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 25:11"/>ኮሽያ ዎድያን ሃሳየቴዳ ልከ ቃላይ ብራ ቦላ ትጌዳ ዎርቃ አሌቁዋ ማላ።<verse eid="PRO 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 25:12"/>ሀይዝያ ኡራ ኤራንቻ አሳይ ዞርያ ዞሪ ሀይን ዎዳ ዎርቃ ዎይ ጌሻ ዎርቃፐ ኦዳ አሌቁዋ ማላ።<verse eid="PRO 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 25:13"/>ካ ጫክያ ቦንያን እርጻ ሃይ ኡሽና አልያዋዳን፥ ኪትና አማነትያ አሳይ ባረና ኪትያዋንታ ናሸቼ።<verse eid="PRO 25:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 25:14"/>እመናባ “እማና” ያጊደ ጬቀትያ አሳይ እራይ ባይና ሻርያነ ጫርኩዋ ማላ።<verse eid="PRO 25:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 25:15"/>ዳንዳያንቻ አሳይ ደርያ ሞድያዎ ኦዲደ አማን፤ ሊቆ ቃላይ መቀ አደ ገሌ።<verse eid="PRO 25:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 25:16"/>ኤሳ ደሞፐ፥ ካላና ጋካናዉ ማ፤ ሽን ዳርሶፐ፥ ኔን ጮሻና። <verse eid="PRO 25:16"/><verse number="17" style="v" sid="PRO 25:17"/>ኔና ኡፊደ እጸናዳን፥ ነ ሾሩዋ ጎለ ኡባ ገደ ቦፓ።<verse eid="PRO 25:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 25:18"/>ባረ ሾሩዋ ቦላ ዎርዱዋን ማርካትያ አሳይ ጋትማይ፥ ማሻይነ ቃራ አዳይ አሳ ቆህያዋ ኬሻ ቆሄ።<verse eid="PRO 25:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 25:19"/>መቱዋ ዎደ አማነተና ኡራን ዘምፕያዌ ቃጽያ ማታን ጮምያዋነ ስሌዳ ገድያን ሀመትያዋ ማላ።<verse eid="PRO 25:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 25:20"/>ካዮት ኡቴዳ አሳዉ የ የጽያዌ ሜጉዋ ጋላስ ማዩዋ ቃርያዋነ ማዱ ቦላ ጫላባ ትግያዋ ማላ።<verse eid="PRO 25:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 25:21"/>ነ ሞርኪ ኮሻቶፐ፥ ምዛ፤ ሳመቶፐ፥ ኡሻ።<note caller="-" style="x"><char style="xo" closed="false">25:21-22 </char><char style="xt" closed="false"><ref loc="ROM 12:20">ሮመ 12:20</ref></char></note> <verse eid="PRO 25:21"/><verse number="22" style="v" sid="PRO 25:22"/>አያዉ ጎፐ፥ ኔን ሄዋ ኦያዌ አ ሁጲያን ታማ ቦንቁዋ ካሺደ ቆልያዋ ማላ። መና ጎዳይካ ነዉ ዎይታና።<verse eid="PRO 25:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 25:23"/>ዶላሃ ባጋ ጫርኩ እራ አህያዋዳን፥ ዝግርሳይ ሀንቁዋ አዬ።<verse eid="PRO 25:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 25:24"/>ዋላቀትያ ማቻትና እት ጎልያን ደአናፐ ጎልያ ካሻን ደእያዌ ኬካ።<verse eid="PRO 25:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 25:25"/>ዳቡሬዳ ኡራይ እርጻ ሃ ኡሺደ አልያዋዳን፥ ሃኮ ቢታፐ ይያ ሎኦ ኦዱ ናሸቼ።<verse eid="PRO 25:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 25:26"/>ኢታ አሳ ስንን ኩንድያ ጽሎ አሳይ ቡሉቀቴዳ ፑልቱዋነ ባዬዳ ኦላ ሃ ማላ።<verse eid="PRO 25:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 25:27"/>ዳሮ ኤሳ ምያዌ ሎአ ግደና፤ ሄዋዳንካ፥ ባረ ቦንቹዋ ኮይያዌ ቦንችሰና።<verse eid="PRO 25:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 25:28"/>ባረ ሁጲያ ናገና አሳይ ድርሳይ መኤዳ ካታማ ማላ።<verse eid="PRO 25:28"/></para>
  <chapter eid="PRO 25"/>
  <chapter number="26" style="c" sid="PRO 26"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 26:1"/>ቦንያን ሻቻይ፥ ካ ጫክያ ዎድያንካ እራይ ኮሸናዋዳን፥ ቦዛዉ ቦንቹ ኮሸና።<verse eid="PRO 26:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 26:2"/>ካፎቱ ያነ ሃነ ፓሊደ፥ አሳ ቆሄናዋዳን፥ ጋሱ ባይናን ሸቂያ ሸቃይ አሳ ጋከና።<verse eid="PRO 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 26:3"/>ፓራዉ ልሱዋ፥ ሀርያዉ ፓጾሩዋ ኮሽያዋዳን፥ ቦዛ ዞክያዉ ዋ ኮሼ።<verse eid="PRO 26:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 26:4"/>ቦዛ ኡራዉ አ ቦዛተዳን ዛሮፓ፤ ዛሮፐ ኔንካ አ ማላ ግዳና።<verse eid="PRO 26:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 26:5"/>ቦዛ ኡራዉ አ ቦዛተዳን ዛራ፤ ሄዌ ዮፐ፥ እ ባረና ኤራንቻዳን ፓይዳና።<verse eid="PRO 26:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 26:6"/>ቦዛ አሳ ቦላ ኪታ ኪትያዌ ባረ ገድያ ቃንጽያዋነ ዎያዋ ኡሽያዋ ማላ።<verse eid="PRO 26:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 26:7"/>ቦዛ ኡራ ሌምሱ ዎባ ኡራ ገድያ ማላ ማደና።<verse eid="PRO 26:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 26:8"/>ቦዛ ኡራ ቦንችያ አሳይ ሹቻ ያምባርሻ ቦላ ቃች ዎደ ዩሽያ አሳ ማላ።<verse eid="PRO 26:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 26:9"/>ቦዛ ኡራ ሌምሱ ማቴዳ አሳይ ባረ ኩሽያ ጫዴዳ አጉን ከሳናዉ ባጸትያዋ ማላ።<verse eid="PRO 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 26:10"/>ቦዛ አሳ ዎይ ባረዉ ኦግያና አያ አሳ ኦሶ ቃጻርያ አሳይ ደሜዳ አሳ ኡባ ጫዳናዳን ዎንዳፍያ ዱክያ አሳ ማላ።<verse eid="PRO 26:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 26:11"/>ካናይ ባረ ጮሻ ጉየ ስሚደ ምያዋዳን፥ ቦዛይ ባረ ቦዛተ ኦሱዋ ዛር ዛር ኦ።<verse eid="PRO 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 26:12"/>ባረካ ባረና፥ “ታን አዳ ኤራንቻ” ግያ አሳ በኣድ? አፐ ቦዛ ኡራዉ ስንፐ ሎኦ ህዶታይ ደኤ።<verse eid="PRO 26:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 26:13"/>አዛላይ፥ “ኦግያን ጋሙ ደኤ፤ ያሽያ ጋሙ አኮ ኦግያን ዩዬ” ያጌ።<verse eid="PRO 26:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 26:14"/>ፐንጊ ባረ ማጻፍያን ያነ ሃነ ቃጽያዋዳን፥ አዛላይካ ባረ ሂጻን ያነ ሃነ አ ዎ።<verse eid="PRO 26:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 26:15"/>እት እት አሳቱ ዳሮ አዛላ፤ ኡንቱንቱ ሀራይ አትና፥ ዎጽያን ቱሼዳ ሶሉዋካ ፑደ ባራናዉ ዳቡሪኖ።<verse eid="PRO 26:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 26:16"/>አዛላ አሳይ ማርካና ኦድያ ላፑን ኤራንቻቱዋፐካ ባረና አዳ ኤራንቻ ጊደ ቆፔ።<verse eid="PRO 26:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 26:17"/>ባረና ጋያዌ ባይና ሳን ፓላማዉ አያ አሳይ ኦግያና ብያ ካና ሀይ ኦይቂያ አሳ ማላ።<verse eid="PRO 26:17"/></para>
  <para style="p">
    <verse number="18-19" style="v" sid="PRO 26:18-19"/>ባረ ሾሩዋ፥ “ታን ካሳዉ ኦድ” ያጊደ ጭምያ አሳይ፥ ጎዪደ ታማ ጺፋ ኦልያ፥ ዎይ ዎያ ጩብያ ደንያ አሳ ማላ።<verse eid="PRO 26:18-19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 26:20"/>ምይ ዉሮፐ፥ ታማይ ቶኤ፤ ዝግርያዌ ዮፐ፥ ዋላሳይ አቴ።<verse eid="PRO 26:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 26:21"/>ጺጹንይ ቦንቁዋ ዳርስያዋዳንነ ምይ ታማ ዳርስያዋዳን፥ ፓሉማንቻ አሳይ ዋላሳ ዳርሴ።<verse eid="PRO 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 26:22"/>ዝግርሳ ቃላይ ማልኦ ቁማ ማላ፤ ናሸቺደ ዱገ ጋንጅያ ጋኬ።<verse eid="PRO 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 26:23"/>ዎዛናን ኢታባይ ደእሺና፥ ባረ እንጻርሳን ጭሙዋ ቃላ ሃሳይያ አሳይ ብራን ሼሼዳ ኡርቃ ሚሻ ማላ።<verse eid="PRO 26:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 26:24"/>ሎኦ ማላትያ ኢታ አሳይ ባረ ዎዛናን ደእያ ኢታተ ባረ ናሾ ሃሳያን ገን። <verse eid="PRO 26:24"/><verse number="25" style="v" sid="PRO 26:25"/>አ ዎዛናን ላፑን ቱናተይ ኩም ኡቴዳ ድራዉ፥ እ ሎኦ ቃላ ሃሳዮፐካ አ አማኖፓ። <verse eid="PRO 26:25"/><verse number="26" style="v" sid="PRO 26:26"/>ባረ ሞርከተ እ ገንፐካ፥ እ ኦያ ኢታተይ ሺቁዋን ቆንጫና።<verse eid="PRO 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 26:27"/>ሀራቶ ኦላ ቦክያ ኡራይ ሄ ኦላን ባረዉ ኩንዳና፤ ሀራቱ ቦላ ሹቻ ጎንዶርስያ ኡራ ቦላ ሄ ሹቻይ ስሚደ ጎንዶረታና።<verse eid="PRO 26:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 26:28"/>ዎርዶትያ እንጻርሳይ ባረ ቆሄዳ አሳቱዋ እጼ፤ ጭምያ ሃሳያይ ባየ አሄፐ አትን፥ ሀራባ አሄና።<verse eid="PRO 26:28"/></para>
  <chapter eid="PRO 26"/>
  <chapter number="27" style="c" sid="PRO 27"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 27:1"/>ዎንት ሀናናባን ጬቀቶፓ፤ ዎንት አሀናባ ኔን ኤራካ።<note caller="-" style="x"><char style="xo" closed="false">27:1 </char><char style="xt" closed="false"><ref loc="JAS 4:13-16">ያቆባ 4:13-16</ref></char></note><verse eid="PRO 27:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 27:2"/>ኔና ሀራ አሳይ ጋላቶፐ አትና፥ ኔን ኔና ኔረካ ጋላቶፓ፤ አሳይ ነ ድራዉ ማርካቶፐ አትና፥ ኔን ነ ኬካተ ኦዶፓ።<verse eid="PRO 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 27:3"/>ሹቻይ ዎልቃማ ቶኩዋ፤ ሻፈቱዋ ቶክያዌካ ዴጼ፤ ሽን ቦዛ ኡራይ ደንያ ዋላሳይ ኡንቱንቱ ላኡዋፐካ ዴጼ።<verse eid="PRO 27:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 27:4"/>ሀንቆ ቃረት ባዋ፤ ይሉካ ባይዝያ ድኡዋ ማላ፤ ሽን ቃናትያን ኡባ ጋፖ።<verse eid="PRO 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 27:5"/>ጌሜዳ ሲቁዋፐ ባልያ ዎደ ቆንጭያን ሴርያዌ ኬካ።<verse eid="PRO 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 27:6"/>ሞርኪ ኔና ዳሮ ገደ የርያዋፐ ሲቁ ኔና ደችያዌ ኬካ።<verse eid="PRO 27:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 27:7"/>ካሌዳ ኡራ ኤሳ እልሉ ኢቴ፤ ሽን ኮሻቴዳ ኡራ ጫምያባይካ ማልኤ።<verse eid="PRO 27:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 27:8"/>ባረ ጎልያ አጊደ ዩይያ አሳይ፥ ባረ ጎልያፐ ሃካደ ፓልያ ካፋት ማላ።<verse eid="PRO 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 27:9"/>ሽቱነ ሳዊያ እጻናይ አሳ ናሸችያዋዳን፥ ሲቁዋ ላግያ ዞሪካ ናሸቼ።<verse eid="PRO 27:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 27:10"/>ነ ሲቆ ላግያነ ነ አዉዋ ሲቆ ላግያ አጎፓ፤ ኔና መቴዳ ዎደ ነ እሻ ጎለ ቦፓ። ሃኩዋን ደእያ እሻፐ ማታን ደእያ ሾሩ ኬካ።<verse eid="PRO 27:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 27:11"/>ታ ናአዉ፥ ኔን አዳ ኤራንቻ ግዳ። ያትንቶ ታን ናሸታናነ ታና ቦርያዋንቱ ኦሻካ ዛራና።<verse eid="PRO 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 27:12"/>ጭንጫ አሳይ መቱ ይያ ዎደ በኢደ ቆሰቴ፤ ሽን አኬካይ ፓጬዳ አሳይ ስት ግ ቢደ፥ መቱዋን ገሌ፤ ያቲደ ጉየፐ አዬ አና ያጌ።<verse eid="PRO 27:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 27:13"/>ኤረና አሳዉ ዋስያ ገልያ ኡራ ማዩዋ ቃር አክተ፤ እማ አሳዉ፥ ዋስያ ገሌዳ ኡራ ማዩዋ ኦይቂተ።<verse eid="PRO 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 27:14"/>ዎንታ ጉራን ባረ ቃላ ቁ ኦደ፥ ባረ ሾሩዋ ሳሮትያዌ አ ሸቂያዋ ማላ።<verse eid="PRO 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 27:15"/>ዋላቀታደ ዱጸና ማቻታነ እራይ ቡክያ ዎደ ጾኪደ አገና ጎሊ እት ማላ። <verse eid="PRO 27:15"/><verse number="16" style="v" sid="PRO 27:16"/>ጫርኩዋ ተአናዉ ዎይ ዛይትያ ጩጩሚደ ኦይቃናዉ ዳንዳየተናዋዳን፥ እዞ ጮኡ ኦናዉ ዳንዳየተና።<verse eid="PRO 27:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 27:17"/>ብራታይ ብራታ ፖሽያዋዳን፥ አሳይ እቱ እቱዋፐ ታማሬ።<verse eid="PRO 27:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 27:18"/>ባላስያ ግያ ምቶ እሻልሲደ ናጌዳ ኡራይ እ አይፍያ ማና፤ ባረና አይሴዳዋ ካቦይያ ቆማይ ቦንቼታና።<verse eid="PRO 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 27:19"/>ሃይ ማስቶትያዳን ሶምኡዋ በስያዋዳን፥ አሳ ዎዛናይ እዛዉ ኤሻ በሴ።<verse eid="PRO 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 27:20"/>ሀይቁነ ባሻይ ካል ኤርክኖ፤ ሄዋዳንካ፥ አሳ አይፊ ካለና።<verse eid="PRO 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 27:21"/>ብራይነ ዎርቃይ ታማን ፓጨቲደ ጌይያዋዳን፥ አሳይካ ባረ አክያ ጋላታን ፓጨቴ።<verse eid="PRO 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 27:22"/>ቦዛ አሳ ካና ኡዱላን የጋደ፥ ኡዱላ ምን ጫድንቶ፥ አፐ ቦዛተይ ክቼና።<verse eid="PRO 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 27:23"/>ነ ዶርሳቱ ደእያ ሀኖታ ሎይደ ኤራ፤ ነ መህያ ዉድያካ ዎዛናፐ ሄማ። <verse eid="PRO 27:23"/><verse number="24" style="v" sid="PRO 27:24"/>አያዉ ጎፐ፥ ዱረተይ መናዉ ደኤና፤ ካላቻይካ የለታፐ የለታዉ አናን አጋናዉ ዳንዳዬ። <verse eid="PRO 27:24"/><verse number="25" style="v" sid="PRO 27:25"/>መላ ማታይ ቡጨቴዳዋፐ፥ አጫ ማታይ ከሴዳዋፐነ ደርያ ቦላን ደእያ ማታይ ሺቄዳዋፐ ጉይያን፥ <verse eid="PRO 27:25"/><verse number="26" style="v" sid="PRO 27:26"/>ዶርሳቱዋ እስክያፐ ኔን ነዉ ማይያዋ ከሳና፤ አማሬዳ ዴሻቱዋ ዛልኤዳ ብራንካ ነዉ ጋድያ ሻማና። <verse eid="PRO 27:26"/><verse number="27" style="v" sid="PRO 27:27"/>አትያ ዴሻቱዋ ማይ ነዉ፥ ነ ሶ አሳዉነ ነ ማጫ ቆማቶ ቁማ ግዳናዋ።<verse eid="PRO 27:27"/></para>
  <chapter eid="PRO 27"/>
  <chapter number="28" style="c" sid="PRO 28"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 28:1"/>ኢታቱ ኦንነ የደርሰናን ባቃቲኖ፤ ሽን ጽሎቱ ጋሙዋ ማላ ጻላ።<verse eid="PRO 28:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 28:2"/>እት ካዉተይ ማካላንቻ ግዶፐ፥ አ ሞድያዋንቱ ላመት ላመት ሞድኖ። ሽን ካለያዋንቱ አዳ ኤራንቻነ አኬካንቻ ግድያ ዎደ፥ ምኖ ግዲደ፥ ዳሮ ዎድያ ታኬ።<verse eid="PRO 28:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 28:3"/>ህዬሳቱዋ ኡቁንያ ዳናይ ካ ይስያ ዎልቃማ እራ ማላ።<verse eid="PRO 28:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 28:4"/>ህግያ ቦንቼና ኡራይ ባይዛንቻ ሳቤ፤ ሽን ህግያ ቦንችያዌ ባይዛንቻቱዋ ቆፋ ጳልቄ።<verse eid="PRO 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 28:5"/>ኢታ አሳቶ ሱረ ፕርዳባይ ገለና፤ ሽን መና ጎዳዉ ጎይንያዋንቶ ኡባባይካ ገሌ።<verse eid="PRO 28:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 28:6"/>ጌላ አሳ ግዲደ፥ ዱረ ግድያዋፐ ሱረ አሳ ግዲደ፥ ህዬሳ ግድያዌ ኬካ።<verse eid="PRO 28:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 28:7"/>ህግያ ናግያ ዎዳላይ አኬካንቻ። ሽን ፓና ሹፉሮቱዋና ዙፐትያዌ ባረ አዉዋ ዬላዬ።<verse eid="PRO 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 28:8"/>ሚሻ ድቻዉ እምያዋንነ የሉዋን ዱረትያ አሳይ ሄ ማጹዋ ህዬሳቶ ኬክያ አሳዉ ሺሼ።<verse eid="PRO 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 28:9"/>ህግያ ስሳናፐ ጊደ፥ ባረ ሀይ ዎራ ዛርያ ኡራ ዎሳይ ጾሳ ሸነይያዋ።<verse eid="PRO 28:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 28:10"/>ሱረቱዋ ኢታ ኦግያ ካለያ ኡራይ ባረ ቦኬዳ ኦላን ባረዉ ኩንዳና፤ ሽን ጌሻ አሳይ ሎኦባ ላታና።<verse eid="PRO 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 28:11"/>ዱረ አሳይ ባረና አዳ ኤራንቻ ጊደ ቆፔ፤ ሽን አኬካይ ደእያ ህዬሳይ አ ፓጬ።<verse eid="PRO 28:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 28:12"/>ጽሎቱ ጾኔዳ ዎደ፥ አሳይ ኡባይ ናሸቴ፤ ሽን ኢታቱ ማታ ኦይቄዳ ዎደ፥ አሳይ ቆሰቴ።<verse eid="PRO 28:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 28:13"/>ባረ ናጋራ ገንያ ኡራይ አጨና፤ ሽን ፓጽያዌነ ናጋራ አግያዌ ማረታናዋ።<verse eid="PRO 28:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 28:14"/>መና ጎዳዉ ኡባ ገደ ያይያ አሳይ አንጀቴዳዋ፤ ሽን ባረ ዎዛና ጉዙንያ አሳይ መቱዋን ገላና።<verse eid="PRO 28:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 28:15"/>ህዬሳ አሳ ሞድያ ኢታ ዳናይ ጉድያ ጋሙዋነ ኮሻቴዳ ባባርቂያ ማላ።<verse eid="PRO 28:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 28:16"/>ዎዛን ፓጬዳ ዳናይ ባረ አሳ ናቄ፤ ሽን አሳ ናቂያዋ እጽያዌ ዳሮ ላይ ሞዳና።<verse eid="PRO 28:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 28:17"/>አሳ ዎዳ አሳይ ሀይቃና ጋካናዉ ባቃቲደ ደኤ፤ አ ኦንነ ሺሽ አከና።<verse eid="PRO 28:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 28:18"/>ቦሪ ባይናን ሀመትያ ኡራይ ቆሄተናን አታናዋ፤ ሽን ጌላ አሳይ እት ኩን ኩንዳና።<verse eid="PRO 28:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 28:19"/>ባረ ጋድያ ኦያ ኡራይ ካ ካሌ። ሽን ሹፉሮቱዋ ካልያ ኡራይ ኡባ ገደ ህዬሲደ ደኤ።<verse eid="PRO 28:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 28:20"/>አማነቴዳ ኡራይ ዳሮ አንጀታና፤ ሽን ዱረታናዉ ጃምያዌ ሙረተናን አተና።<verse eid="PRO 28:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 28:21"/>ሻኪደ ማድያዌ ሎኤና፤ ሽን አሳይ ጉ ኡክ ድራዉ ጊደካ፥ ባላባ ኦኖ።<verse eid="PRO 28:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 28:22"/>ኡዘትያ ኡራይ ዱረታናዉ ጃሜ፤ ባረና ህዬሳተይ ኦይቃናዋካ ኤረና።<verse eid="PRO 28:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 28:23"/>አሳ ጮ ሳቢያ ኡራፐ ሴርያ ኡራይ ጉየፐ ጋላተቴ።<verse eid="PRO 28:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 28:24"/>ባረ አዉዋፐነ ባረ አትፐ ዉኢደ፥ “ታን አይነ ናጋራ ኦበይከ” ያግያ ኡራይነ ባይዝያ ኡራይ እት ማላ።<verse eid="PRO 28:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 28:25"/>ኡዘትያ ኡራይ ዋላሳ ደን፤ ሽን መና ጎዳን አማነትያዌ ካሌ።<verse eid="PRO 28:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 28:26"/>ባረናን አማነትያ አሳይ ቦዛ፤ ሽን አዳ ኤራተን ሀመትያዌ ሳሮ ደኤ።<verse eid="PRO 28:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 28:27"/>ህዬሳዉ እምያ ኡራዉ ፓጨና፤ ሽን ኡንቱንታ በአናፐ ጊደ ጪልምያዌ ሸቃ አካና።<verse eid="PRO 28:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 28:28"/>ኢታ አሳቱ ሱንትያ ዎደ፥ አሳይ ቆሰቴ፤ ሽን ኡንቱንቱ ይያ ዎደ፥ ጽሎቱ ጮራቲኖ።<verse eid="PRO 28:28"/></para>
  <chapter eid="PRO 28"/>
  <chapter number="29" style="c" sid="PRO 29"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 29:1"/>ዳሮ ገደ ሴርና እጺደ፥ ሞርጊ ሌዳ ኡራይ ሀሳየናን መአና፤ ሄ ኡራዉ ፓጹካ ባዋ።<verse eid="PRO 29:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 29:2"/>ጽሎ አሳቱ ሱንትያ ዎደ አሳይ ናሸቴ፤ ሽን ኢታቱ ቢታ ሞድያ ዎደ አሳይ ኦሌ።<verse eid="PRO 29:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 29:3"/>አዳ ኤራ ዶስያ አሳይ ባረ አዉዋ ናሸቼ፤ ሽን ዎሹምያ ማጫ አሳቱዋ ሄራን ዩይያ አሳይ ባረ ሚሻ ዉርሴ።<verse eid="PRO 29:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 29:4"/>ቱሙዋ ፕርድያ ካቲ ባረ ካዉተ ዎፑ ኦ፤ ሽን ማታይያ ማናዉ ዮራትያዌ ባረ ካዉተ ባይዜ።<verse eid="PRO 29:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 29:5"/>ባረ ሾሩዋ ሳቢደ ሃሳይያ ኡራይ፥ አ ገድያዉ ግትያ የጌ።<verse eid="PRO 29:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 29:6"/>ኢታ አሳይ ግቲ ኦይቂያዋዳን፥ ባረ ናጋራን ኦይቀቴ፤ ሽን ጽሎ አሳይ ናሸታናዉነ የጻናዉ ዳንዳዬ።<verse eid="PRO 29:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 29:7"/>ጽሎ አሳይ ህዬሳ ማታ ቦንቼ፤ ሽን ኢታ አሳይ ሄዋ ማላ ኤራ ኡባካ ኤረና።<verse eid="PRO 29:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 29:8"/>ቅሊጭያዋንቱ ካታማን ዋላሳ ደንኖ፤ ሽን አዳ ኤራንቻ አሳቱ ሀንቁዋ እርጽሲኖ።<verse eid="PRO 29:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 29:9"/>አዳ ኤራንቻ አሳይ ቦዛ አሳ ፕርዳ ጎለ አፎፐ፥ ቦዛይ ሀንቀቴነ ቅ፤ አዉ ያቶፐ ሳሩ ዬ።<verse eid="PRO 29:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 29:10"/>ሱ ጉሳናዉ ጃምያ አሳቱ ሱረ አሳ እጺኖ፤ ቃይ ጽሎ አሳካ ዎናዉ ኮዪኖ።<verse eid="PRO 29:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 29:11"/>ቦዛ አሳይ ባረ ሀንቁዋ የድ በሴ፤ ሽን አዳ ኤራ አሳይ ባረ ሀንቁዋ ምቴ።<verse eid="PRO 29:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 29:12"/>እት ሱንቴዳ ኡራይ ዎርዱዋ ኦዱዋ አኮፐ፥ አ ኦሳንቻቱ ኡባይ ኢታ ከሲኖ።<verse eid="PRO 29:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 29:13"/>ህዬሳይነ አሳ ናቂያ አሳይ እትባ ኮጺኖ፤ ኡንቱንቱ ላኦካ አይፍያ መና ጎዳይ ጼልሴ።<verse eid="PRO 29:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 29:14"/>እት ካቲ ህዬሳዉ ሱረ ፕርዶፐ፥ እ ባረ ካዉተን ጋምአና።<verse eid="PRO 29:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 29:15"/>ቃይጼሪነ ሴራይ ናናቶ አዳ ኤራ እሜ፤ ሽን የዳን ድጬዳ ናአይ ባረ አቶ ካዉሼ።<verse eid="PRO 29:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 29:16"/>ኢታ አሳቱ ዳርያ ዎደ፥ ናጋራይ ዳሬ፤ ሽን ጽሎቱ ኡንቱንቱ ኩንደ በአና።<verse eid="PRO 29:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 29:17"/>ነ ናኣ ሴራ፤ ያቶፐ፥ እ ነዉ ሳሩዋ እማና፤ እ ኔና ናሸቻና።<verse eid="PRO 29:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 29:18"/>ጾሳይ ካለያ ካለሱዋ አከና ደሪ የዳ፤ ሽን ህግያ ናግያ ኡራይ አንጀቴዳዋ።<verse eid="PRO 29:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 29:19"/>ቆማይ ጮ ኦዶ ጻላን ሴረት ኤረና፤ ኦዱ አዉ ገልንቶካ እ አዛዘተና።<verse eid="PRO 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 29:20"/>ኤሌሌ ኤሌሌ ሃሳይያ ኡራ በአ ኤራይሻ? አፐ ቦዛ ኡራዉ ስንናዉ ዳሮ ህዶታይ ደኤ።<verse eid="PRO 29:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 29:21"/>ነ ቆማዉ ናአተፔ ዶምና፥ እ ኮይያዋ ኡባ አዉ እማ ሜዘዮፐ፥ እት ጋላስ ነዉ ደእያዋ ኡባ አካናዉ እ ካጄላናዌ አተና።<verse eid="PRO 29:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 29:22"/>ሀንቀትያ አሳይ ዋላሳ ደን፤ ኤለ ይሎትያ አሳይ ዳሮ ናጋራ ኦ።<verse eid="PRO 29:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 29:23"/>ኦቶሩ አሳ ካዉሼ፤ ሽን ሆክያ አያናይ ደእያ አሳይ ቦንቼቴ።<verse eid="PRO 29:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 29:24"/>ካይሱዋና ሻክያ ኡራይ ባረና እጽያ አሳ፤ እ ዳባባን ቱሙዋ ኦዶፐካ ሙረቴ፤ ቱሙዋ ኦዳና ዮፐ ቃይ፥ ጾሳይ አ ሙራና።<verse eid="PRO 29:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 29:25"/>አሳዉ ያይያዌ ሄ ኡራዉ ጲረ ግዴ፤ ሽን መና ጎዳን አማነትያ አሳይ ሳሮ ደኤ።<verse eid="PRO 29:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 29:26"/>ዳሮቱ ሱንተይ ደእያ አሳቱዋ አዉዳሺኖ፤ ሽን ሱረ ፕርዳይ መና ጎዳ ማታፐ ቤቴ።<verse eid="PRO 29:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 29:27"/>ጽሎቱ ናጋራንቻቱዋ ሸነቲኖ፤ ናጋራንቻቱካ ሱረ ኡራ ሸነቲኖ።<verse eid="PRO 29:27"/></para>
  <chapter eid="PRO 29"/>
  <chapter number="30" style="c" sid="PRO 30"/>
  <para style="s1">አጉር ሃሳያ</para>
  <para style="r">(<ref loc="PRO 30:1-33">30:1-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1"/>ሀዋፐ ካሊደ ጻፈቴዳዌ ያቃ ናአይ አጉር ሃሳዬዳ ሃሳያ። ሄ ብታኒ እቴላስነ ኡካላዉ ሀዋ ሃሳዬዳ። <verse eid="PRO 30:1"/><verse number="2" style="v" sid="PRO 30:2"/>ቱሙ ታን አይ አሳፐካ ቦዛ ዳራይ፤ አሳዉ ደእያ አኬካይ ታዉ ባዋ። <verse eid="PRO 30:2"/><verse number="3" style="v" sid="PRO 30:3"/>ታን አዳ ኤራ ታማራበይከ፤ ጌሻ ጾሳባካ አያነ ኤርከ። <verse eid="PRO 30:3"/><verse number="4" style="v" sid="PRO 30:4"/>ሳሉዋ ፑደ ከሲደ፥ ዱገ ዎዳዌ ኦኔ? ጫርኩዋ ባረ ኩሽያን ኦይቄዳዌ፥ ሃ ባረ አፍላን ዪጬዳዌ፥ ሳኣ ጋጻ አ ሳኣን ሳኣን ዎዳዌ ኦኔ? አነ ኤሮፐ አ ሱን ታዉ ኦዳ። አ ናኣ ኦና ጋይ?<verse eid="PRO 30:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 30:5"/>ጾሳይ ኦድያ ቃላይ ኡባይ ቱማ፤ ባረኮ ባቃቲደ ብያ ኡባዉ እ ጎንዳለ። <verse eid="PRO 30:5"/><verse number="6" style="v" sid="PRO 30:6"/>አ ቃላ ቦላ አያነ ጉጆፓ፤ ጉጆፐ እ ኔና ሴራና፤ ኔን ዎርዳንቻ ግድያዋካ እ ቆንጭሳና።<verse eid="PRO 30:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 30:7"/>አቤት መና ጎዳዉ፥ ታን ኔና ላኡባቱዋ ኦቻይ፤ ታን ሀይቃና ጋካናዉ፥ ኡንቱንታ ታና ድጎፓ። <verse eid="PRO 30:7"/><verse number="8" style="v" sid="PRO 30:8"/>ኮይሩዋን፥ ታን አሳ ጭመናዳንነ ዎርዱዋ ሃሳየናዳን ታና ናጋ፤ ላኤንዋን፥ ታዉ ኮሽያ ኬሻ ቁማ እማፐ አትና፥ ታና ዱረ ዎይ ማንቆ ከሶፓ። <verse eid="PRO 30:8"/><verse number="9" style="v" sid="PRO 30:9"/>ሄዌ ዮፐ፥ ዱረ ግዳደ፥ “መና ጎዳይ ኦኔ?” ጋደ ኔና ካዳና፤ ዎይ ማንቆ ግዳደ፥ ዉአና፤ ያታደ ታ ጾሳ ሱን ቦርሳና።<verse eid="PRO 30:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 30:10"/>ኔና ሸቀና ማላነ እ ሸቂና ነዉ ጎመተና ማላ፥ ቆማ አ ጎዳን ሞቶፓ።<verse eid="PRO 30:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 30:11"/>ባረንቱ አዎቱዋ ሸቂያነ ባረንቱ አየቱዋ አንጀና አሳቱ ደኢኖ። <verse eid="PRO 30:11"/><verse number="12" style="v" sid="PRO 30:12"/>ዳሮ ቱና ቱን ኡቲደ፥ ባረንታ ጌሻዳን ፓይድያ አሳቱ ደኢኖ። <verse eid="PRO 30:12"/><verse number="13" style="v" sid="PRO 30:13"/>ኦቶሩዋ ኩሜዳ አሳቱነ አሳ ካደ ጼልያ አሳቱ ደኢኖ። <verse eid="PRO 30:13"/><verse number="14" style="v" sid="PRO 30:14"/>ኡንቱንቱ አቻይ ማሻ ማላ ግድና፥ ኡንቱንቱ ጎጎጩካ ጎሎዱዋ ማላ ግድና፥ ህዬሳቱዋነ መቶታንቻቱዋ ናቂደ፥ ኡንቱንቱዋ ቦንቂያ አሳቱ ደኢኖ።<verse eid="PRO 30:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 30:15"/>ኡላትዉ ላኡ ማጫ ናናቱ ደኢኖ። ኡንቱንቱ፥ “ሀማ! ሀማ!” ያጊደ ዋሲኖ። ኡባካ ካል ኤረና ሄዙባቱ ደኢኖ፤ ኦይደን ቃይ ኡባ፥ “ግዳና” ግ ኤረና።<verse eid="PRO 30:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 30:16"/>ሄዋንቱካ:</para>
  <para style="q2" vid="PRO 30:16">ዱፉዋ፥</para>
  <para style="q2" vid="PRO 30:16">ማይነ ማጫ አሳ፥</para>
  <para style="q2" vid="PRO 30:16">ሃ ካልስ ኤረና መላ ቢታነ፥</para>
  <para style="q1" vid="PRO 30:16">“ታዉ ግዳና!” ግ ኤረና ታማ።<verse eid="PRO 30:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 30:17"/>ባረ አዉዋ ቅሊጭያ ናኣ አይፍያ፥ ባረ አታ ጭምና ካያ ናኣ አይፍያ፥ ዛንጋራን ደእያ ቁሮቱ ዎጫና፤ አ አሹዋ አንኮቱ ማና።<verse eid="PRO 30:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 30:18"/>ታና ሄዙባቱ ማላልሲኖ፤ ኦይደን ኡባ ታዉ ገለና።<verse eid="PRO 30:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 30:19"/>ሄዋንቱካ:</para>
  <para style="q2" vid="PRO 30:19">አርጋንይ ሳሉዋና ፓልያ ፓሉዋ፥</para>
  <para style="q2" vid="PRO 30:19">ሾሻይ ሹቻ ቦላና ሶሎልያ ሶሎለ፥</para>
  <para style="q2" vid="PRO 30:19">ማርካቢ አባ ቦላን ሶልድያ ሶልዱዋነ</para>
  <para style="q2" vid="PRO 30:19">ዎዳላይነ ወዶራታ ሲቁዋ ዶምያ ዶመ።<verse eid="PRO 30:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 30:20"/>ዎሹምያ ምሽራታ ሀንያ ሀኑካ ሄዋ ማላ። አ ሙሳ ማዉ፤ ሽን ሜዳዋፐ ጉይያን፥ ባረ ዶና ቁጫ ድጋደ፥ “ታን አይነ ባይዛበይከ” ያጋዉ።<verse eid="PRO 30:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 30:21"/>ሄዙ የዎቱዋን ቢታይ ቃጼ፤ ኦይደንዋ ኡባ ቶካናዉካ ዳንዳይቤና።<verse eid="PRO 30:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 30:22"/>ሄዋንቱካ:</para>
  <para style="q2" vid="PRO 30:22">አይሊ ካተቴዳ ዎደ፥</para>
  <para style="q2" vid="PRO 30:22">ቦዛይ ካ ካሌዳ ዎደ፥<verse eid="PRO 30:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 30:23"/>አሳይ እጼዳ ምሽራታ አስና ገሌዳ ዎደነ፥</para>
  <para style="q2" vid="PRO 30:23">ማጫ ቆማታ ባረ ጎዳቶ ላቴዳ ዎደ መትያ ሀኖታ።<verse eid="PRO 30:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 30:24"/>ሳኣ ቦላ ኦይዱ ጉ መታቱ ደኢኖ፤ ሽን ኡንቱንቱ ሎይ አዳ ኤራንቻ።<verse eid="PRO 30:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 30:25"/>ሄዋንቱካ:</para>
  <para style="q2" vid="PRO 30:25">ጩንጫለቱዋ፥ ጩንጫለቱ ዎልቃይ ባይና መታ፤</para>
  <para style="q2" vid="PRO 30:25">ሽን ባረንቶ ምያዋ ቦንያን ሺሺደ፥ ምንጂኖ።<verse eid="PRO 30:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 30:26"/>ጉፓለቱዋ፥ ጉፓለቱ ጉ ዎልቃይ ደእያዋንታ፤</para>
  <para style="q2" vid="PRO 30:26">ሽን ባረንቱ ጎልያ ሹቻ ጎንጎሉዋን ኬጺኖ።<verse eid="PRO 30:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 30:27"/>ቦለቱዋ፥ ቦለቶ ካቲ ባዋ፤</para>
  <para style="q2" vid="PRO 30:27">ሽን ኡንቱንቱ ኡባይካ ማራን ዛቲኖ።<verse eid="PRO 30:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 30:28"/>ዛራቱዋ፥ ዛራቱ ኩሽያን ኦይቂናካ ኦይቀቲኖ፤</para>
  <para style="q2" vid="PRO 30:28">ሽን ኡንቱንቱ ሀራይ አትና፥ ካትያ ጎለንካ ደኢኖ።<verse eid="PRO 30:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 30:29"/>ባረንቱ ማታ በሲደ ሀመትያ ሄዙ መታቱ ደኢኖ፤ ኦይደንካ ሎኦ ሄመታ ሀመቴ።<verse eid="PRO 30:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 30:30"/>ሄዋንቱካ:</para>
  <para style="q2" vid="PRO 30:30">ዶኣ ኡባፐ ምንያነ ያዪደ ባቃት ኤረና ጋሙዋ፤<verse eid="PRO 30:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 30:31"/>አየቱዋ ግዶን አዪደ ሀመትያ አዉረ ኩቱዋ፥</para>
  <para style="q2" vid="PRO 30:31">ዴሻ ኦርግያነ፥</para>
  <para style="q2" vid="PRO 30:31">ባረ ኦላንቻቱዋ ግዶን ኤቂያ ካትያ።<verse eid="PRO 30:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="PRO 30:32"/>ኔን ቦዛደ ኦቶረቴዳዋ ግዶፐነ፥ ኢታባ ኦናዉ ሀልቼዳዋ ግዶፐ፥ አነ ታክ ጋደ ቆፓ።<verse eid="PRO 30:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="PRO 30:33"/>ማ ቡክያዌ ኦይሳ ከስያዋዳን፥ ሲያ ይምፕያዌካ ሱ አህያዋዳን፥ ሄዋዳን ሀንቁዋ ደንያዌ ዋላሳ አዬ።<verse eid="PRO 30:33"/></para>
  <chapter eid="PRO 30"/>
  <chapter number="31" style="c" sid="PRO 31"/>
  <para style="s1">ልሙኤላ ዳያ ባረ ናኣ ታማርሴዳ ትምትትያ</para>
  <para style="r">(<ref loc="PRO 31:1-31">31:1-31</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1"/>ሀዋፐ ካሊደ ጻፈቴዳ ሃሳያይ፥ ካትያ ልሙኤላ አታ ካትያ ልሙኤላ ታማርሴዳዋ።<verse eid="PRO 31:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 31:2"/>“ላ ታ ናአዉ፥ ታ ኡሉዋፐ ዎዳዎ፥ ታን ሺቀታደ የሌዳዎ፥ <verse eid="PRO 31:2"/><verse number="3" style="v" sid="PRO 31:3"/>ማጫ አሳን ነ ዎልቃ ዉርሶፓ፤ ሄ ካተቱዋ ባይዝያ ማጫ አሳቱዋን ነ አካታ ይሶፓ።<verse eid="PRO 31:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 31:4"/>“ልሙኤላ፥ ሀዌ ካተቶ በሰና፤ ዎይንያ ኤሳ ኡሽያዌ ካተቶ በሰና፤ ማይያ ኡሻ ኡሽያዌ አሳ ቦላ ሱንቴዳዋንቶ በሰና። <verse eid="PRO 31:4"/><verse number="5" style="v" sid="PRO 31:5"/>ኡንቱንቱ ኡሽያ ዎደ ህግያ ባሊኖ፤ ናቀቴዳ አሳ ማታ ሸነኮ ጊኖ። <verse eid="PRO 31:5"/><verse number="6" style="v" sid="PRO 31:6"/>ማይያ ኡሻ ሀይቃና ሀንያ ኡራዉነ ሳአይ ኢቴዳ ኡራዉ እምተ። <verse eid="PRO 31:6"/><verse number="7" style="v" sid="PRO 31:7"/>ኡንቱንቱ ባረንቱ ማንቆተነ ባረንቱ ቱጋ ደኡዋ ዶጋና ማላ ኡሽኖ።<verse eid="PRO 31:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 31:8"/>“ባረንቱ መቱዋ ኦዳናዉ ዳንዳየናዋንቱ ድራዉ ኔን ኦዳ፤ ማድያዌ ባይናዋንቱ ማታ ድራዉ ኔን ደንዳ። <verse eid="PRO 31:8"/><verse number="9" style="v" sid="PRO 31:9"/>ኡንቱንቶ ሱረ ፕርዳ ፕርዳ፤ ህዬሳቱዋነ መቶታንቻቱዋ ማታ ናጋ” ያጋደ ታማርሳዱ።<verse eid="PRO 31:9"/></para>
  <para style="s1">ዎዛናማ ማቻቶ</para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 31:10"/>ዎዛናማ ማቻቶ ኦን ደማናዉ ዳንዳዪ? እንቁዋ ግያ አልኦ ሹቻፐካ እዛ አልአዉ። <verse eid="PRO 31:10"/><verse number="11" style="v" sid="PRO 31:11"/>እ አስናይ እዞ ኡባባንካ አማኔ፤ አዉ ደአናዉ በስያዋፐ አያይነ ፓጨና። <verse eid="PRO 31:11"/><verse number="12" style="v" sid="PRO 31:12"/>አ ባረ ደኡዋ ላይ ኡባን አዉ ሎኦባፐ አትና፥ ኢታባ ኦኩ።<verse eid="PRO 31:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 31:13"/>ሱፍያነ ላይኑዋ አ ኮያደ፥ ናሸታደ ባረ ኩሽያን ኦዉ። <verse eid="PRO 31:13"/><verse number="14" style="v" sid="PRO 31:14"/>አ ዛልአንቻቱዋ ማርካባቱዋ ማላ፤ ባረ ቁማ ሃኮ ቢታፐ አያዉ። <verse eid="PRO 31:14"/><verse number="15" style="v" sid="PRO 31:15"/>አ ባረ ሶ አሳዉ ቁማ ካናዉነ ባረ ማጫ ቆማቶ ኦሱዋ ግሻናዉ፥ ሳአይ ብሮ ቃማ ደእሺና ደንዳዉ። <verse eid="PRO 31:15"/><verse number="16" style="v" sid="PRO 31:16"/>ጋድያ አ ኮያደ ሻማዉ፤ ባረ ኩሽያን ኦደ ደሜዳ ሻሉዋን ዎይንያ ቱራ ቶካዉ።<verse eid="PRO 31:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 31:17"/>አ ጎባ ኦሳንቻ ግድያዋ ጻላላ ግደናን፥ ምኖነ ጭንጫ አሳ። <verse eid="PRO 31:17"/><verse number="18" style="v" sid="PRO 31:18"/>አ ባረ ዎያ ደማናዉ ምናደ ዛልአዉ፤ አ ኦደ ቃምስያ ድራዉ፥ ባረ ጾምፕያ ኤለ ቶይሱኩ። <verse eid="PRO 31:18"/><verse number="19" style="v" sid="PRO 31:19"/>አ ባረ ስንድሪታን ሱቃደ፥ ባረ አፍላ ዳዳዉ።<verse eid="PRO 31:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 31:20"/>አ ህዬሳቶነ መቶታንቻቶ ባረዋፐ ጮ እማዉ።<verse eid="PRO 31:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 31:21"/>እ ሶ አሳይ ኡባይ ሆእያ ማዩዋ ማዬዳ ድራዉ፥ ሻቻይ ቡክንቶ፥ አ ህርጉኩ። <verse eid="PRO 31:21"/><verse number="22" style="v" sid="PRO 31:22"/>አርሳ ቦላን ሂጽያ ማዩዋ ስካዉ፤ ሊኑዋፐ ዳደቴዳ ኦቻ ቴራ ማላትያ ማዩዋካ ባረዉ ማያዉ።<verse eid="PRO 31:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 31:23"/>ጋድያ ጭማቱ ሺቅያ ዱቡሻን እ አስናይ ቦንቼቴዳ አሳ።<verse eid="PRO 31:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 31:24"/>ሊኑዋፐ ማዩዋነ ሳቂያ ኦ ኦደ፥ ዛልአንቻቶ ዛልአዉ።<verse eid="PRO 31:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 31:25"/>እዛ ምኖነ ቦንቾ አሳ፤ ይያ ላይቶ እዛ ኡባካ ህርጉኩ። <verse eid="PRO 31:25"/><verse number="26" style="v" sid="PRO 31:26"/>አዳ ኤራን አ ሃሳያዉ፤ አማንያ ዞሪ እ እንጻርሳፐ ከሴ። <verse eid="PRO 31:26"/><verse number="27" style="v" sid="PRO 31:27"/>አ ባረ ሶ አሳ ደኡዋ እንጀያናዉ ኡባ ገደ ኦሱዋ ኦደ ደአዉ፤ አዛላ ሀኑ እ ቦላን ቤት ኤረና።<verse eid="PRO 31:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 31:28"/>እዝ ናናቱ ደንድ ኤቂደ፥ እዞ ናሺኖ፤ እዝ አስናይካ እዞ ጋላቲደ፥ <verse eid="PRO 31:28"/><verse number="29" style="v" sid="PRO 31:29"/>“ሎኦባ ኦዳ ዳሮ ማጫ አሳቱ ደኢኖ፤ ሽን ኔን ኡንቱንቱ ኡባፐ አሳ” ያጌ።<verse eid="PRO 31:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 31:30"/>ማላ ሎኦተይ አላለ ከሰና፤ ፑልካ ያና፤ ሽን መና ጎዳዉ ያይያ ምሽራታ፥ እዛ ጋላተታናዉ በሳዉ። <verse eid="PRO 31:30"/><verse number="31" style="v" sid="PRO 31:31"/>አ ኦዳባዉ ኡባዉ እዉ እዝ ኩሽያ ዛርተ፤ እዛ ኦዳ ኦሱ ኡባይ ዳባባን እዞ ጋላትሶ።<verse eid="PRO 31:31"/></para>
  <chapter eid="PRO 31"/>
</usx>
