<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Dawuro Full Bible Ethiopic Version</book>
  <para style="h">አሞጻ</para>
  <para style="toc1">አሞጻ ትምቢትያ</para>
  <para style="toc2">አሞጻ</para>
  <para style="toc3">አሞጻ</para>
  <para style="mt1">አሞጻ ትምቢትያ</para>
  <para style="imt">ገሉዋ</para>
  <para style="ip">ሀ ትምቢትያን ኦደቴዳ ኪታይ ጌሻ ማጻፋ ግዶን ሀራቱዋፐ አዱሳ ዎድያፐ ካሰና ጻፈቴዳ ማጻፋይ አሞጻ ትምቢትያ ማጻፋ። አሞጽ ይሁዳን ደእያ እት ካታማፐ ዬዳ አሳ ግዶፐነ፥ ክርስቶሳ የለታፐ ካሰ፥ ሆስፑን ጼቱ ላይዉ ባጋ ሄራን ሀ ኪታ ሁጲሳ ባጋና ደእያ እስራኤልያ ካዉተዉ አዳ። ሄ ዎዲ ዳሮ ዱረተይ፥ አያና ደኡዋንካ አሳይ ድጬዳነ አማንያ ሀኖተይ ቤቴዳ ዎደ። ግዶፐነ አሞጽ ዱረተይ ዱረ አሳ ጻላላዉ እመቴዳዋ በኤዳ፤ ቃይ ሀራ ባጋና ሱረ ፕርዳይ ይያዌነ ህዬሳቱዋ ኡቁንያዌ ጋድያን ዳሬዳዋ በኤዳ። አማኑዋ ኦይቀ ግዶፐካ ቱሙዋፐ ሃኬዳዋ፥ ሎኦ ማላትያ ኢታይ ኩሜዳዋነ አኑ ባይና ሳሮተይ ደእያዋካ በኤዳ። ሄዋ ጋሱዋን ጾሳይ ባረ አሳ ቦላ ሙሩዋ አሀናዋ ሀንቁዋንነ ጻላን ኩሚደ ኦዴዳ። ሄዋናካ፥ “ሱረ ፕርዳይ ሻፋ ሃዳን ጎጎ” ያጊደ ቆፍሴዳ። ሄዋዳን ሀኖፐ፥ “ኡባ ሞድያ ጎዳይ አቴዳ እስራኤልያ አሳዉ ቃረቲደ ማራነንቶነ ኦን ኤሪ!” ያጌዳ (5:15)።</para>
  <para style="iot">ሸምፓቱዋ ኡባቶ እመቴዳ ቃን ቆፋቱዋ</para>
  <para style="io1">1. አሳ ዘረ ኡባይ ባረ ዎንጃላን ኦሸትያዋ <char style="ior"><ref loc="AMO 1:1-3:2">1:1—3:2</ref></char></para>
  <para style="io1">2. እስራኤልያነ ሳማርያ ባሻ <char style="ior"><ref loc="AMO 3:3-6:14">3:3—6:14</ref></char></para>
  <para style="io1">3. እስራኤልያ ሙሩዋባ አሞጽ በኤዳ እቼሹ ሳጻቱዋ <char style="ior"><ref loc="AMO 7:1-9:10">7:1—9:10</ref></char></para>
  <para style="io1">4. እስራኤልያ ፖኦ ህዶታ <char style="ior"><ref loc="AMO 9:11-15">9:11-15</ref></char></para>
  <chapter number="1" style="c" sid="AMO 1"/>
  <para style="s1">አሳ ዘረ ኡባይ ባረ ዎንጃላን ኦሸትያዋ</para>
  <para style="r">(<ref loc="AMO 1:1-3:2">1:1—3:2</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1"/>ኦዝያነ ይሁዳ ጋድያን ካትያ፥ ቃይ ዮኣሻ ናአይ እዮርባም እስራኤልያ ጋድያን ካትያ ግዲደ ደኤዳ ላይን ታቆአ ጋድያን ዶርሳ ሄምያዋንቱፐ እቱ አሞጽ፥ ቢታይ ቃጻናፐ ላኡ ላይፐ ካሰ እስራኤልያባ በኤዳ ሳጻይ ሀዋ።<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2KI 15:1-7">2 ካታ. 15:1-7</ref>፤ <ref loc="2CH 26:1-23">2 ኦዱዋ 26:1-23</ref>፤ <ref loc="2KI 14:23-29">2 ካታ. 14:23-29</ref></char></note><verse eid="AMO 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2"/>እ ሀዋዳን ያጌዳ፤<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="JOL 3:16">ኢዩ. 3:16</ref></char></note> “መና ጎዳይ ጽዮነ ደርያን ጉዴ፤ የሩሳላመ ካታማንካ ባረ ኮሻ ስሴ። ሄንንቻቱ መህያ ሄምያ ሄን ጋደቱ መሊኖ፤ ቃርመሎሳ ደርያ ሁጲያን ደእያ እርጻይካ ሹሌ” ያጌዳ።<verse eid="AMO 1:2"/></para>
  <para style="ms">እስራኤልያ ዩሹዋን ደእያ ጋደቱዋ ቦላን ጾሳይ ፕርድያ ፕርዳ</para>
  <para style="ms">ሶርያ</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ዳማስቆ አሳይ ዛር ዛሪደ ኦዳ ናጋራ ድራዉ፥ ታን ኡንቱንታ ሙረናን አግከ። አያዉ ጎፐ፥ ኡንቱንቱ ጋላኣደ ቢታ አሳ ብራታ አቻና ደእያ ጋርያን የሲደ ቆጼድኖ።<note caller="-" style="x"><char style="xo" closed="false">1:3-5 </char><char style="xt" closed="false"><ref loc="ISA 17:1-3">ኢሳ. 17:1-3</ref>፤ <ref loc="JER 49:23-27">ኤር. 49:23-27</ref>፤ <ref loc="ZEC 9:1">ዛካ. 9:1</ref></char></note> <verse eid="AMO 1:3"/><verse number="4" style="v" sid="AMO 1:4"/>ሄዋ ድራዉ፥ ታን ካትያ ሀዛኤላ ጎልያን ታማ የዳና፤ የድና ሄ ታማይ ካትያ በንሀዳዳ ጌሱዋካ ማና። <verse eid="AMO 1:4"/><verse number="5" style="v" sid="AMO 1:5"/>ታን ዳማስቆ ካታማ ፐንግያ ኩልቡዋ መንና፤ አዌና ዛንጋራን ደእያ አሳ የደርሳናነ ካተቱዋ ጻምኣ ኦይቄዳዋካ ቤት-ኤዴናፐ ይሳና፤ ቃይ ሶርያ ጋድያ አሳይካ ኦሞደቲደ፥ ቂራ ግያሳ ባና” ያጌ መና ጎዳይ።<verse eid="AMO 1:5"/></para>
  <para style="s1">ፕልስጼማ</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ጋዛ ካታማ አሳይ ዛር ዛሪደ ኦዳ ናጋራ ድራዉ፥ ታን ኡንቱንታ ሙረናን አግከ። አያዉ ጎፐ፥ ኡንቱንቱ ጋድያን ደእያ አሳ ኡባ ኦሞዲደ፥ ኤዶማ ጋድያ አሳዉ ባይዜድኖ።<note caller="-" style="x"><char style="xo" closed="false">1:6-8 </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">ኢሳ. 14:29-31</ref>፤ <ref loc="JER 47:1-7">ኤር. 47:1-7</ref>፤ <ref loc="EZK 25:15-17">ህዝ. 25:15-17</ref>፤ <ref loc="JOL 3:4-8">ኢዩ. 3:4-8</ref>፤ <ref loc="ZEP 2:4-7">ሶፎ. 2:4-7</ref>፤ <ref loc="ZEC 9:5-7">ዛካ. 9:5-7</ref></char></note> <verse eid="AMO 1:6"/><verse number="7" style="v" sid="AMO 1:7"/>ሄዋ ድራዉ፥ ታን ጋዛ ካታማ ድርሳን ታማ የዳና፤ ሄ ታማይ ካታማ ጌሱዋካ ማና። <verse eid="AMO 1:7"/><verse number="8" style="v" sid="AMO 1:8"/>አሽዶዳን ደእያ አሳ ታን የደርሳናነ ካተቱዋ ጻምኣ ኦይቄዳዋካ አስቀሎናፐ ይሳና። ኤቅሮና ካታማን ደእያ አሳካ ሙራና፤ ቃይ ፕልስጼማ ጋድያ አሳፐ አቴዳዋንቱካ ሀይቃና። ታን ኡባ ሞድያ መና ጎዳይ ሀዋ ኦዳይ” ያጌ።<verse eid="AMO 1:8"/></para>
  <para style="s1">ጺሮሳ</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ጺሮሳ ካታማ አሳይ ዛር ዛሪደ ኦዳ ናጋራ ድራዉ፥ ታን ኡንቱንታ ሙረናን አግከ። አያዉ ጎፐ፥ ኡንቱንቱ ጫቀቴዳ እሻተ ጫቁዋ አደ፥ ኦሞደቴዳ አሳ ኡባ ኤዶማ አሳዉ ባይዜድኖ።<note caller="-" style="x"><char style="xo" closed="false">1:9-10 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">ኢሳ. 23:1-18</ref>፤ <ref loc="EZK 26:1-28:19">ህዝ. 26:1—28:19</ref>፤ <ref loc="JOL 3:4-8">ኢዩ. 3:4-8</ref>፤ <ref loc="ZEC 9:1-4">ዛካ. 9:1-4</ref>፤ <ref loc="MAT 11:21-22">ማቶሳ 11:21-22</ref>፤ <ref loc="LUK 10:13-14">ሉቃሳ 10:13-14</ref></char></note> <verse eid="AMO 1:9"/><verse number="10" style="v" sid="AMO 1:10"/>ሄዋ ድራዉ፥ ታን ጺሮሳ ካታማ ድርሳን ታማ የዳና፤ ሄ ታማይ ካታማ ጌሱዋካ ማና” ያጌ።<verse eid="AMO 1:10"/></para>
  <para style="s1">ኤዶማ</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ኤዶማ ጋድያ አሳይ ዛር ዛሪደ ኦዳ ናጋራ ድራዉ፥ ታን ኡንቱንታ ሙረናን አግከ። አያዉ ጎፐ፥ ኡንቱንቱ ባረንቱ እሻቱዋ እስራኤላቱዋ ማሻን የደርሴድኖ፤ ኡንቱንቱ ኡንቱንቶ ቃረትበይክኖ። ኡንቱንቱ ኡባ ገደ ሀንቀቲኖ፤ ኡንቱንቱ ይሉ መናዉካ ስመና።<note caller="-" style="x"><char style="xo" closed="false">1:11-12 </char><char style="xt" closed="false"><ref loc="ISA 34:5-17">ኢሳ. 34:5-17</ref>፤ <ref loc="ISA 63:1-6">63:1-6</ref>፤ <ref loc="JER 49:7-23">ኤር. 49:7-23</ref>፤ <ref loc="EZK 25:12-14">ህዝ. 25:12-14</ref>፤ <ref loc="EZK 35:1-15">35:1-15</ref>፤ <ref loc="OBA 1:1-14">አብድ. 1-14</ref>፤ <ref loc="MAL 1:2-5">ሚልክ. 1:2-5</ref></char></note> <verse eid="AMO 1:11"/><verse number="12" style="v" sid="AMO 1:12"/>ሄዋ ድራዉ፥ ታን ቴማና ካታማ ቦላ ታማ የዳና፤ ሄ ታማይ ቦጽራ ካታማ ጌሶቱዋ ማና” ያጌ።<verse eid="AMO 1:12"/></para>
  <para style="s1">አሞና</para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13"/>መና ጎዳይ ሀዋዳን ያጌ፤ “አሞና ጋድያ አሳይ ዛር ዛሪደ ኦዳ ናጋራ ድራዉ፥ ታን ኡንቱንታ ሙረናን አግከ። አያዉ ጎፐ፥ ኡንቱንቱ ባረንቱ ዛዋ አሳናዉ ጋላኣደ ጋድያን ደእያ ሻሃራ ማጫ አሳቱ ኡሉዋ ዳኬድኖ።<note caller="-" style="x"><char style="xo" closed="false">1:13-15 </char><char style="xt" closed="false"><ref loc="JER 49:1-6">ኤር. 49:1-6</ref>፤ <ref loc="EZK 21:28-32">ህዝ. 21:28-32</ref>፤ <ref loc="EZK 25:1-7">25:1-7</ref>፤ <ref loc="ZEP 2:8-11">ሶፎ. 2:8-11</ref></char></note> <verse eid="AMO 1:13"/><verse number="14" style="v" sid="AMO 1:14"/>ሄዋ ድራዉ፥ ታን ራባ ካታማ ድርሳን ታማ የዳና፤ ሄ ታማይ ካታማ ጌሶቱዋ ማና። ሄዋፐ ጉይያን፥ ኦላ ጋላስ ዋሱ ዳራና፤ ቃይ ኦላንቻቱ ጎትያዳን ዎልቃማና። <verse eid="AMO 1:14"/><verse number="15" style="v" sid="AMO 1:15"/>ኡንቱንቱ ካቲነ አናና ኦያ ካፓቱ ኡባይ ኦሞደቲደ እትፐ ባና” ያጌ መና ጎዳይ።<verse eid="AMO 1:15"/></para>
  <chapter eid="AMO 1"/>
  <chapter number="2" style="c" sid="AMO 2"/>
  <para style="s1">ሞኣባ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ሞኣባ ጋድያ አሳይ ዛር ዛሪደ ኦዳ ናጋራ ድራዉ፥ ታን ኡንቱንታ ሙረናን አግከ። አያዉ ጎፐ፥ ኡንቱንቱ ኤዶማ ጋድያ ካትያ መቀ ብድን ከሳና ጋካናዉ ጹጌድኖ።<note caller="-" style="x"><char style="xo" closed="false">2:1-3 </char><char style="xt" closed="false"><ref loc="ISA 15:1-16:14">ኢሳ. 15:1—16:14</ref>፤ <ref loc="ISA 25:10-12">25:10-12</ref>፤ <ref loc="JER 48:1-47">ኤር. 48:1-47</ref>፤ <ref loc="EZK 25:8-11">ህዝ. 25:8-11</ref>፤ <ref loc="ZEP 2:8-11">ሶፎ. 2:8-11</ref></char></note> <verse eid="AMO 2:1"/><verse number="2" style="v" sid="AMO 2:2"/>ሄዋ ድራዉ፥ ታን ሞኣባ ጋድያን ታማ የዳና፤ ሄ ታማይ ቅርዮታ ካታማ ጌሶቱዋ ማና። ሞኣባ ጋድያ አሳይ ሻቢርሳ ግዶን፥ ኦላ ዋሱዋ ግዱዋንነ ማላካታ ፑኑዋ ግዶን ሀይቂ ዉራና። <verse eid="AMO 2:2"/><verse number="3" style="v" sid="AMO 2:3"/>ታን ሞኣባ ጋድያ ሞድያዋ ይሳና፤ ቃይ ካፓቱዋ ኡባካ አናና እትፐ ዎና” ያጌ መና ጎዳይ።<verse eid="AMO 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ይሁዳ ጋድያ አሳይ ዛር ዛሪደ ኦዳ ናጋራ ድራዉ፥ ታን ኡንቱንታ ሙረናን አግከ። አያዉ ጎፐ፥ ኡንቱንቱ መና ጎዳ ህግያ እጼድኖ፤ አ አዛዙዋካ ናግበይክኖ። ኡንቱንቱ አዎቱ ካሌዳ ዎርዶ ጾሳቱ ኡንቱንታካ ባለድኖ። <verse eid="AMO 2:4"/><verse number="5" style="v" sid="AMO 2:5"/>ሄዋ ድራዉ፥ ታን ይሁዳ ጋድያ ቦላ ታማ የዳና፤ ሄ ታማይ የሩሳላመ ጌሶቱዋ ማና” ያጌ።<verse eid="AMO 2:5"/></para>
  <para style="s1">እስራኤልያ ቦላን ጾሳይ ፕርድያ ፕርዳ</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6"/>መና ጎዳይ ሀዋዳን ያጌ፤ “እስራኤልያ አሳይ ዛር ዛሪደ ኦዳ ናጋራ ድራዉ፥ ታን ኡንቱንታ ሙረናን አግከ። አያዉ ጎፐ፥ ኡንቱንቱ ሚሻ አካና ድራዉ፥ ጽሉዋ ዛልኢኖ፤ ቃይ ጫማ አጩዋ አካና ግሻዉካ ህዬሳ ዛልኢኖ። <verse eid="AMO 2:6"/><verse number="7" style="v" sid="AMO 2:7"/>ማንቆቱዋ ጋድያ ባናን ኩንድሲደ፥ ኡንቱንቱ ሁጲያ የኖ፤ ናቀቴዳዋንቱ ፕርዳካ ጌላዪኖ። ቃይ አዉነ ናአይ ላኡ እት ምሽራቶ ዎሹምያዋን ታ ጌሻ ሱን ሎይ ቱንሲኖ። <verse eid="AMO 2:7"/><verse number="8" style="v" sid="AMO 2:8"/>ኡንቱንቱ አሳፐ አጮ ኦይቄዳ ማዩዋ ያርሽያ ሳኣን ኡባ ማታን ሂጺደ፥ አን ግሲኖ፤ ቃይ አሳፐ ማቃጮ ኦደ አኬዳ ዎይንያ ኤሳ ባረንቱ ጾሳ ጎልያን ኡሺኖ።<verse eid="AMO 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 2:9"/>“ግዶፐነ፥ ዝጋዳን አዱቂደ፥ ዎላዳን ምኔዳ አሞረ ጋድያ አሳቱዋ ኡንቱንቱ ስንፐ ይሴዳዌ ታና። ታን ኡንቱንቶ ቦላ አይፍያናካ ጋርሳ ጻጱዋናካ ኡባ ይሳድ።<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="DEU 3:8-11">ዛረ. 3:8-11</ref></char></note> <verse eid="AMO 2:9"/><verse number="10" style="v" sid="AMO 2:10"/>ታን ህንተና ግብጼ ጋድያፐ ከሳደ፥ ባዙዋን ኦይታሙ ላይ ካለድ፤ ቃይ አሞረቱ ቢታካ ህንተንቶ ላታ ኦደ እማድ።<verse eid="AMO 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 2:11"/>“ህንተ አቱማ ናናቱ ግዶፐ ትምቢትያ ኦድያዋንታ፥ ህንተ ያላጋ አሳ ግዶፐካ ባረና ጾሳዉ ዱማዬዳ ናዝራዌቱዋ ደንድ። ህንተኖ፥ እስራኤልያ አሳቶ፥ ሀዌ ቱማ ግደኔ? ሀዋ ታን ጾሳይ ኦዳድ።<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="NUM 6:1-8">ፓይ. 6:1-8</ref></char></note> <verse eid="AMO 2:11"/><verse number="12" style="v" sid="AMO 2:12"/>ሽን ህንተ ሄ ናዝራዌቱዋ ጫቁዋ ኮልሲደ፥ ዎይንያ ኤሳ ኡሼድታ፤ ትምቢትያ ኦድያዋንታካ፥ ‘ትምቢትያ ኦዶፕተ’ ያጊደ አዛዜድታ።<verse eid="AMO 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 2:13"/>“በእተ፥ ካ ዳርሲደ ጫኔዳ ጋሪ መእያዋዳን፥ ታን ህንተና መንና። <verse eid="AMO 2:13"/><verse number="14" style="v" sid="AMO 2:14"/>ፓላ ዎጽያዌ ባቃቲደ ከስ አከና፤ ምኖ ዎልቃይ እጻና፤ ኦላንቻይካ ባረ ሸምፑዋ አሸና። <verse eid="AMO 2:14"/><verse number="15" style="v" sid="AMO 2:15"/>ዎንዳፍያን ዱክያዌ ባረ ሳኣን ኤቃናዉ ዳንዳየና፤ ገድያ ኤሱካ ከስ አከና፤ ፓራዉካ ባረ ሸምፑዋ አሸና። <verse eid="AMO 2:15"/><verse number="16" style="v" sid="AMO 2:16"/>ሄ ጋላስ ሀራይ አቶ ኦላንቻቱዋ ግዶን ሎይ ጻላንቻ ግያዋንቱካ ካሎ ጺራ ባቃታና” ያጌ መና ጎዳይ።<verse eid="AMO 2:16"/></para>
  <chapter eid="AMO 2"/>
  <chapter number="3" style="c" sid="AMO 3"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1"/>ህንተኖ እስራኤልያ አሳቶ፥ መና ጎዳይ ህንተ ቦላ፥ ግብጼ ጋድያፐ እ ከሴዳ አሳ ኡባ ቦላ ሃሳዬዳዋ ስስተ። <verse eid="AMO 3:1"/><verse number="2" style="v" sid="AMO 3:2"/>“ሳኣን ደእያ አሳ ኡባፐ ታን ህንተ ጻላላ ዶራድ። ሄዋ ድራዉ፥ ህንተ ኦዳ ናጋራ ኡባዉ ታን ህንተና ሙራና” ያጌ።<verse eid="AMO 3:2"/></para>
  <para style="s1">እስራኤልያነ ሳማርያ ባሻ</para>
  <para style="r">(<ref loc="AMO 3:3-6:14">3:3—6:14</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 3:3"/>ላኡ አሳቱ ቆፋይ እታ ግደናን ደኢደ እትፐ ሀመቲኖ?<verse eid="AMO 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 3:4"/>ጋሙ ኦይቂያዋ ደመናን ዎራን ጮ ጉዲየ? ዎይ ዎዳላ ጋሙ አየንቶ የደርሲደ ኦይቀናን ባረ ጌሱዋን ዳሪየ?<verse eid="AMO 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 3:5"/>ኦይቃናዉ የጌዳ ግትያ ግዶን ካይ ዮፐ፥ ካፉ ጮ ኦይቀቲ? ዎይ ጲሪ አየንቶ ኦይቂያባይ ባይናን ጮ ፕሪ?<verse eid="AMO 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 3:6"/>ካታማ ግዶን ኦላ ማላካታይ ፑነትያ ዎደ፥ አሳይ ያሻን ኮኮረኔየ? ዎይ መና ጎዳይ ኪተናን ደእሽን፥ ባሻይ እት ካታማ ቦላን ዪየ?<verse eid="AMO 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 3:7"/>ቱሙዋፐ ኡባ ሞድያ መና ጎዳይ ባረ ጹራ ትምቢትያ ኦድያ ባረ ቆማቶ ካሰቲደ ቆንጭሰናን ደኢደ፥ አያነ ኦና።<verse eid="AMO 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 3:8"/>ጋሙ ጉድና፥ ያየናዌ ኦኔ? ኡባ ሞድያ መና ጎዳይ ኦድና፥ ትምቢትያ ኦደናዌ ኦኔ?<verse eid="AMO 3:8"/></para>
  <para style="s1">ሳማርያ ኩንደ</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 3:9"/>አሽዶዳ ካታማንነ ግብጼ ካትያ ጎለቱዋን ደእያ ኡባቶ ሀዋዳን ያጊደ አዋይተ፤ “ሳማርያ ደረቱዋ ቦላ ሺቅተ፤ ሺቂደ ያን ሀንያ ዎልቃማ ዋጨነ ሱገ ኦሱዋ በእተ” ያግተ።<verse eid="AMO 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 3:10"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ሀ አሳቱ ሱረባ ኦያዋ ኤርክኖ፤ ሱገንነ ቦንቂደ አሄዳ ሻሉዋን ባረንቱ ጎልያ ኩን ዎድኖ” ያጌ። <verse eid="AMO 3:10"/><verse number="11" style="v" sid="AMO 3:11"/>ሄዋ ድራዉ፥ ኡባ ሞድያ ጾሳይ ሀዋዳን ያጌ፤ “ሞርኪ ህንተ ቢታ ዶዳና፤ ህንተ ጌሱዋ ላላና፤ ህንተ ዱረቱዋ ጎልያካ ቦንቃና” ያጌ።<verse eid="AMO 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ሄንንቻይ ጋሙዋ ዶናፐ ዶርሳ ዎ አክያ ዎደ፥ ዶርሳዉ ላኡ ገደቱዋ ዎይ ዱጻ ሀይ ዎ አክያዋዳን፥ ሄዋዳንካ ሳማርያ ጋድያን እሻሉዋን ኡቴዳ እስራኤልያ አሳፐ አማሬዳዋንቱ ጻላላይ አታና” ያጌ።<verse eid="AMO 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13"/>መና ጎዳይ፥ ኡባፐ ዎልቃማ ጾሳይ መና ጎዳይ ሀዋዳን ያጌ፤ “ሀዋ ስስተ፤ ያቆባ ዛራቱዋ ቦላ ማርካትተ። <verse eid="AMO 3:13"/><verse number="14" style="v" sid="AMO 3:14"/>ታን እስራኤልያ አሳ ኡንቱንቱ ናጋራ ድራዉ ሙሪያ ጋላስ፥ ቤቴለ ካታማን ደእያ ያርሽያ ሳኣ ኮላና፤ ያርሽያ ሳኣን ደእያ ካጨቱካ መኢደ፥ ሳኣን ዎና።<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="2KI 23:15">2 ካታ. 23:15</ref></char></note> <verse eid="AMO 3:14"/><verse number="15" style="v" sid="AMO 3:15"/>ባልጉዋን ኡንቱንቱ ደእያ ጎልያነ ቦንያን ኡንቱንቱ ደእያ ጎልያ ኡባ ታን ይሳና። ዳንጋርሳ ዛልያን አሌቂሲደ፥ ኡንቱንቱ ኬጼዳ ጎሊካ ኮለታና፤ ቃይ ዎልቃማ ዎልቃማ ጎለቱ ኡባይካ ያና” ያጌ መና ጎዳይ።<verse eid="AMO 3:15"/></para>
  <chapter eid="AMO 3"/>
  <chapter number="4" style="c" sid="AMO 4"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 4:1"/>ህንተኖ፥ ሳማርያ ማጫዋንቶ፥ ባሳነ ጋድያ ማጫ ሚዛቱዋዳን ሞዳዋንቶ፥ ሀዋ ስስተ! ህንተ ህዬሳቱዋ ኡቁኒታ፤ ማንቆቱዋካ ቱጋዪታ። ህንተ አስናቱዋካ፥ “ኑዉ ኡሻ ሀምተ” ያጊታ። <verse eid="AMO 4:1"/><verse number="2" style="v" sid="AMO 4:2"/>ኡባ ሞድያ መና ጎዳይ ሀዋዳን ያጊደ፥ ባረ ጌሻተን ጫቃ፤ “ህንተ ማጋን ኦይቂደ ጎሸታና ጋላሳይነ ህንተፐ አቴዳ አማሬዳዋንቱካ ማጋን ኦይቂደ ብያ ሞለቱዋዳን ሀናና ጋላሳይ ያና። <verse eid="AMO 4:2"/><verse number="3" style="v" sid="AMO 4:3"/>ህንተ ኡባይካ ድርሳ ጾእያና ጎችና ከሲደ፥ ሄርሞነን ኦለታና” ያጊደ ጫቄዳ መና ጎዳይ።<verse eid="AMO 4:3"/></para>
  <para style="s1">እስራኤልያ አሳይ ባረ ባላፐ ታማራናዉ ዳንዳይበይክኖ</para>
  <para style="p">
    <verse number="4-5" style="v" sid="AMO 4:4-5"/>ኡባ ሞድያ መና ጎዳይ ሀዋዳን ያጌ፤ “ህንተኖ፥ እስራኤልያ አሳቶ፥ ቢተ፤ ቤቴለ ቢደ፥ ናጋራ ኦተ፤ ጋልጋላካ ቢደ፥ ናጋራ ጉጂደ ኦተ። ዎንታ ዎንታ ህንተ ያርሹዋ ያርሽተ፤ ሄዘን ጋላስ ጋላስ ህንተ አስራታ አህተ። እርሹዋ የጊደ ኡኬዳ ኡክ ጹጊደ፥ ጋላታ ያርሹዋ ያርሽተ። ህንተ ህንተ ዶሱዋን እምያዋ ድራዉ፥ ኦቶረቲደ አዋይተ። አያዉ ጎፐ፥ ህንተ ኦናዉ ዶስያዌ ሄዋ” ያጌ።<verse eid="AMO 4:4-5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 4:6"/>ቃይካ መና ጎዳይ ሀዋዳን ያጌ፤ “ህንተ ካታማ ኡባን ታን ኮሻ የዳደ፥ ሀራይ አቶ ህንተ ማታን ዳጽያባካ ይሳድ፤ ሽን ህንተ ሄዋንካ ታኮ ስምበይክታ። <verse eid="AMO 4:6"/><verse number="7" style="v" sid="AMO 4:7"/>ካ ጫክያ ዎዲ ጋካናዉ ብሮ ሄዙ አግናይ ደእሽን፥ ታን ህንተንቶ እራ ተኣድ። ታን እት ካታማን እራ ቡክሳደ ሀራ ካታማን ቡከናዳን ድጋድ፤ እት ሾይቃን ቡኬዳ፤ ሀራ ቡክቤና ሾይቃይ ቃይ መሌዳ። <verse eid="AMO 4:7"/><verse number="8" style="v" sid="AMO 4:8"/>ሄዋ ድራዉ፥ ላኡ ዎይ ሄዙ ካታማቱዋ አሳይ ሃ ኡሻናዉ እት ካታማ ቤድኖ፤ ሽን አልበይክኖ። ሄዋንካ ቃይ ህንተ ታኮ ስምበይክታ” ያጌ መና ጎዳይ።<verse eid="AMO 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 4:9"/>መና ጎዳይ፥ “ታን ህንተ ካ ቦላን ሀርግያ የዳድ፤ ህንተ አታክልትያነ ህንተ ዎይንያ ቱራ፥ ህንተ ባላስያ ምነ ህንተ ዎጋራ ኡባ ቦሊ ሜዳ፤ ሽን ህንተ ሄዋንካ ታኮ ስምበይክታ” ያጌ።<verse eid="AMO 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 4:10"/>መና ጎዳይ፥ “ታን ግብጼ አሳቱዋ ቦላ ኢታ ሀርግያ የዴዳዋዳን፥ ህንተ ቦላንካ ቦሻ የዳድ፤ ህንተ ዎዳላ ናናቱዋ ማሻን ዎድ፤ ህንተ ፓራቱካ ኦሞደታናዳን ኡዳድ። ህንተ ሞን ሀይቄዳ አሳ አሃ ጽንቁዋን ህንተና ኡላድ፤ ሽን ህንተ ሄዋንካ ታኮ ስምበይክታ” ያጌ።<verse eid="AMO 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 4:11"/>መና ጎዳይ፥ “ሶዶማነ ጋሞራ ካታማቱዋ ይሴዳዋዳን፥ ህንተፐካ ዳሮቱዋ ይሳድ፤ ሀ አቴዳ ህንተካ ታማፐ ኤጺደ አቴዳ ጺፋ ማላ፤ ሽን ህንተ ሄዋንካ ታኮ ስምበይክታ” ያጌ።<note caller="-" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="GEN 19:24">ዶመ 19:24</ref></char></note><verse eid="AMO 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 4:12"/>ጾሳይ፥ “ሄዋ ድራዉ፥ እስራኤልያ አሳቶ፥ ታን ህንተና ሄዋዳን ኦደ ሙራና ሀናይ። ታን ህንተና ሀዋዳን ኦደ ሙራና ሀንያ ድራዉ፥ እስራኤልያ አሳዉ፥ ህንተ ጾሳና ጋከታናዉ ጊግተ” ያጌ።<verse eid="AMO 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 4:13"/>ደረቱዋ ጊግሴዳዌ፥ ጫርኩዋካ መዳዌ፥ ባረ ዎዛና ቆፋ አሳዉ ቆንጭስያዌ፥ ዎንታ ፖኡዋ ማዉ ላምያዌ፥ ጋድያን ደእያ ቃ ደረቱዋ የያዌ፥ አዉ ሱንይ መና ጎዳ፥ ኡባፐ ዎልቃማ ጾሳ።<verse eid="AMO 4:13"/></para>
  <chapter eid="AMO 4"/>
  <chapter number="5" style="c" sid="AMO 5"/>
  <para style="s1">እስራኤልያ አሳይ ናጋራ ፓጻና ማላ ኦደቴዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1"/>እስራኤልያ አሳቶ፥ ታን ህንተ ቦላ ዝላልያ ዝላሳ ስስተ!<verse eid="AMO 5:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2"/>“ወዶሮ እስራኤላታ ኩንዳዱ፤</para>
  <para style="q2" vid="AMO 5:2">ስም ላኤን ደንዱኩ።</para>
  <para style="q1" vid="AMO 5:2">ሳኣን ኦለታዱ፤</para>
  <para style="q2" vid="AMO 5:2">እዞ ደንያዌካ ባዋ!” ያጋድ።<verse eid="AMO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3"/>ኡባ ሞድያ መና ጎዳይ ሀዋዳን ያጌ፤ “ሻኡ ኦላንቻቱዋ ኦላዉ የድያ እስራኤልያ ካታማዉ ጼቱ ኦላንቻቱዋ ጻላላይ አታና፤ ጼቱ ኦላንቻቱዋ ኦላዉ የድያ እስራኤልያ ካታማዉ ቃይ ታሙ ኦላንቻቱዋ ጻላላይ አታና” ያጌ።<verse eid="AMO 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4"/>መና ጎዳይ እስራኤልያ አሳዉ ሀዋዳን ያጌ፤ “ታና ኮይተ፤ ያቶፐ፥ ህንተ ደኡዋን ደአና። <verse eid="AMO 5:4"/><verse number="5" style="v" sid="AMO 5:5"/>ሽን ቤቴለ ኮዮፕተ። ገልጋላ ገሎፕተ። በርሳበሄ ፕኖፕተ። አያዉ ጎፐ፥ ገልጋል ኦሞደታና፤ ቤቴልካ ያና” ያጌ።<verse eid="AMO 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 5:6"/>መና ጎዳ ኮይተ፤ ያቶፐ፥ ህንተ ደኡዋን ደአና። ሄዌ ዮፐ፥ እ ዮሴፎ ዛርያ ታማዳን ጹጋና፤ ቤቴለን ደእያ አሳካ ታማይ ማና። ሄ ታማ ኡንቱንቶ ኦንነ ቶይሰና።<verse eid="AMO 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 5:7"/>ህንተኖ፥ ሱረ ፕርዳ ጌላዬዳዋንቶ፥ ጽሎተካ ሳኣን ኦልያዋንቶ፥ ሀዋ ስስተ።<verse eid="AMO 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 5:8"/>ፕልያድሳ ጌተትያ ላፑን ጾልንተቱዋነ ኦርዮና ጌተትያ ጾልንተቱዋ ጭታ መዳዌ፥<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="JOB 9:9">ኢዮባ 9:9</ref>፤ <ref loc="JOB 38:31">38:31</ref></char></note> ባራ ማ ዎንታዉ፥ ጋላሳ ፖኡዋካ ቃማዉ ላምያዌነ አባን ደእያ ሃቱዋ ፑደ ሳሉዋ ጼሲደ፥ ሳኣ ምጨ ቦላ ዱገ ትግያዌ፥ አዉ ሱንይ መና ጎዳ። <verse eid="AMO 5:8"/><verse number="9" style="v" sid="AMO 5:9"/>እ ጌሶቱዋ ላላናዉ ዎልቃማቱዋ ቦላ ባሻ አዬ።<verse eid="AMO 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 5:10"/>ህንተ ፕርዳ ጉታራን ሴርያዋ እጺታ፤ ቱሙዋ ኦድያዋካ ሸነቲታ። <verse eid="AMO 5:10"/><verse number="11" style="v" sid="AMO 5:11"/>ህንተ ህዬሳቱዋ የደ፥ ኡንቱንቱ ካካ ኡንቱንቱፐ ቦንቂደ አኬድታ። ያቲደ ማሰቴዳ ሹቻን ጎለቱዋ ግምቤድታ፤ ሽን ህንተ ሄ ጎለቱዋን ደእክታ። ሎእያ ዎይንያ ቱራቱዋካ ቶኬድታ፤ ሽን ህንተ ሄ ዎይንያ ኤሳ ኡሽክታ። <verse eid="AMO 5:11"/><verse number="12" style="v" sid="AMO 5:12"/>አያዉ ጎፐ፥ ህንተ ናቁ አፑነንቶነ ህንተ ናጋራይካ አይ ኬሻ ዎልቃመንቶ ታን ኤራይ። ህንተ ጽሎቱዋ ናቂታ፤ ማታይያካ አኪታ፤ ቃይ ጉታራን ህዬሳቱዋ ፕርዳ ጌላዪታ። <verse eid="AMO 5:12"/><verse number="13" style="v" sid="AMO 5:13"/>ሄዋ ድራዉ፥ ሀዋ ማላ ዎድያን ጭንጫ አሳይ ጮኡ ጌ፤ አያዉ ጎፐ፥ ዎዲ ኢታ።<verse eid="AMO 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 5:14"/>ደኡዋን ደአናዉ ሎኦባፐ አትና፥ ኢታባ ኦፕተ፤ ያቶፐ፥ ህንተ ግያዋዳን፥ መና ጎዳይ፥ ኡባፐ ዎልቃማ መና ጎዳይ ህንተናና ግዳናዋ። <verse eid="AMO 5:14"/><verse number="15" style="v" sid="AMO 5:15"/>ኢታባ እጽተ። ሎኦባ ዶስተ። ፕርዳ ጉታራንካ ሱረ ፕርዳ ፕርድተ። ያቶፐ፥ ኦን ኤሪ፥ ጾሳይ፥ ኡባፐ ዎልቃማ ጾሳይ ዮሴፎ ዘረቱዋፐ አቴዳ አማሬዳዋንቶ ቃረታነንቶነ።<verse eid="AMO 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16"/>ሄዋ ድራዉ፥ ጎዳይ፥ ኡባፐ ዎልቃማ መና ጎዳይ ሀዋዳን ያጌ፤ “ዳባባ ኡባን ዋሱ ከሳና፤ ኦገ ኡባንካ አሳይ፥ ‘አየ፥ አየ!’ ጋና። ጎሻንቻቱ ዬኮ፥ ዝላልያዋንቱካ ዝላሳዉ ጼሰታና። <verse eid="AMO 5:16"/><verse number="17" style="v" sid="AMO 5:17"/>ዎይንያ ቱራ ሳ ኡባን ዬኩ ደአና፤ አያዉ ጎፐ፥ ታን ህንተና ሙራናዉ ህንተ ግዶና አና” ያጌ መና ጎዳይ።<verse eid="AMO 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="AMO 5:18"/>ህንተኖ፥ መና ጎዳ ጋላሳይ ያናዳን አሞትያዋንቶ፥ ህንተንቶ አየ አና! መና ጎዳ ጋላሳ አያዉ አሞቲቴ? ሄ ጋላሳይ ማፐ አትና፥ ፖኦ ጋላሳ ግደና። <verse eid="AMO 5:18"/><verse number="19" style="v" sid="AMO 5:19"/>ሄ ጋላስ ህንተ ጋሙዋፐ ባቃት አትያ ዎደ፥ ማሂ ጋከትያ አሳ ማላ፥ ሄዋፐካ ቃይ ባቃት ባረ ጎለ ገሊደ፥ ባረ ኩሽያ ጎዳን ዘምፕስያ ዎደ፥ ሾሻይ ዱክያ አሳ ማላ ግዳናዋ። <verse eid="AMO 5:19"/><verse number="20" style="v" sid="AMO 5:20"/>መና ጎዳ ጋላሳይ ማፐ አትና፥ ፖኦ ግደና፤ ባራ ማፐ አትና፥ ፖኦ ሾራይ ሙለካ ባዋ!<verse eid="AMO 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="AMO 5:21"/>ጾሳይ ሀዋዳን ያጌ፤ “ታን ህንተ ቦንችያ ባላቱዋ እጻድነ ሸነታድ፤ ህንተ ጌሻ ሺቁካ ታና ናሸችክኖ።<note caller="-" style="x"><char style="xo" closed="false">5:21-22 </char><char style="xt" closed="false"><ref loc="ISA 1:11-14">ኢሳ. 1:11-14</ref></char></note> <verse eid="AMO 5:21"/><verse number="22" style="v" sid="AMO 5:22"/>ህንተ ታዉ ጹግያ ያርሹዋነ ካ ያርሹዋካ ያርሺታ፤ ሽን ታን ሄዋ አክከ። ቃይ ህንተ ታዉ ጋላታዉ አህያ እትፐተ ያርሹዋ ሞ መሄቱዋካ ጼልከ። <verse eid="AMO 5:22"/><verse number="23" style="v" sid="AMO 5:23"/>ህንተ ማዝሙርያ ጫንጨ ታ ማታፐ ሃስተ፤ ህንተ ዲጽያ ዲካ ስስከ። <verse eid="AMO 5:23"/><verse number="24" style="v" sid="AMO 5:24"/>ሽን ሱረ ፕርዳይ ፑልቶ ሃዳን፥ ጽሎተይካ ቶኤና ሻፋ ሃዳን ጎጎ።<verse eid="AMO 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="AMO 5:25"/>“ህንተኖ፥ እስራኤልያ አሳቶ፥ ታን ህንተና ባዙዋን ኦይታሙ ላይ ካለያ ዎደ፥ ታዉ ያርሹዋ ያርሼድቴ? ዎይ እሞታ እሜድቴ?<note caller="-" style="x"><char style="xo" closed="false">5:25-27 </char><char style="xt" closed="false"><ref loc="ACT 7:42-43">ኪታ 7:42-43</ref></char></note> <verse eid="AMO 5:25"/><verse number="26" style="v" sid="AMO 5:26"/>ሄ ዎደ ህንተ ህንተ ኩሽያን መዳ ካትያ ሳኩታ ግያ ኤቃነ ኬዋና ግያ ህንተ ጾልንትያ ጾሳ ኤቃ ቶኬድታ። <verse eid="AMO 5:26"/><verse number="27" style="v" sid="AMO 5:27"/>ሄዋ ድራዉ፥ ታን ህንተና ኦሞድሳደ ዳማስቆ ካታማፐ አደ ሃኮ ሳ የዳና” ያጌ። ሀዋ ግያዌ አዉ ሱንይ ኡባፐ ዎልቃማ ጾሳ ጌተትያ መና ጎዳቴ።<verse eid="AMO 5:27"/></para>
  <chapter eid="AMO 5"/>
  <chapter number="6" style="c" sid="AMO 6"/>
  <para style="s1">እስራኤልያ ዩዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 6:1"/>ህንተኖ፥ እስራኤልያ አሳይ ማዱዋ ኦችያ ቦንቼቴዳ እስራኤልያ ጋድያ ካፓቶ፥ ህንተኖ፥ ጽዮነን እሻሉዋን ደእያዋንቶ፥ ሳማርያ ካታማንካ ህርግ ባይናን ኡቴዳዋንቶ፥ ህንተንቶ አየ አና! <verse eid="AMO 6:1"/><verse number="2" style="v" sid="AMO 6:2"/>አነ ካልነ ግያ ካታማ ቢደ በእተ። ሄዋፐ ቃይ ሀማታ ግያ ዎልቃማ ካታማ ቢደ፥ ያና ቃይ ዱገ ፕልስጼማቱዋ ካታማ ጋተ ዎተ። ኡንቱንቱ ህንተ ላኡ ካዉተቱዋፐ ኬኪኖ? ኡንቱንቱ ጋዲ ህንተ ጋድያፐ አኪ? <verse eid="AMO 6:2"/><verse number="3" style="v" sid="AMO 6:3"/>ህንተኖ፥ ኢታ ጋላሳይ ኤለካ ዬና ጊደ፥ ሱገ ኦሱዋ ኦያዋንቶ፥ <verse eid="AMO 6:3"/><verse number="4" style="v" sid="AMO 6:4"/>ዳንጋርሳ ዛልያፐ ኦዳ አርሳን ግስያዋንቶ፥ ምንጻፍያንካ እንጀቲደ ኡትያዋንቶ፥ ቃይ ዶርሳ ዉድያፐ ቦልት ቦልታቱዋነ ሚዛ ዛዳሉዋፐ ሞ ማራ አሹዋ ምያዋንቶ፥ <verse eid="AMO 6:4"/><verse number="5" style="v" sid="AMO 6:5"/>ዳዊተዳን የ ሚሻ ህንተንቶ ጊግሲደ፥ ማስንቁዋን ዱማ ዱማ የ የጽያዋንቶ፥ <verse eid="AMO 6:5"/><verse number="6" style="v" sid="AMO 6:6"/>ዎይንያ ኤሳ ከርያና ጋንያዋንቶ፥ ሎይ አልኦ ሽቱዋካ ኦከትያዋንቶ፥ ዮሴፎ ዛራቱዋ ባይዛድ አይነ ካዮተናዋንቶ፥ ህንተንቶ አየ አና! <verse eid="AMO 6:6"/><verse number="7" style="v" sid="AMO 6:7"/>ሄዋ ድራዉ፥ ኦሞደቲደ ባናዋንቱፐ ኮይሮቱ ህንተና ግዳና፤ ሄ ዎደ ህንተ እንጀ ደኡሳይነ ህንተ እሻልያዌ አታና።<verse eid="AMO 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8"/>መና ጎዳይ፥ ኡባፐ ዎልቃማ መና ጎዳይ ጾሳይ ሀዋዳን ያጊደ፥ ባረካ ባረናን ጫቄዳ፤ “ታን ያቆባ ኦቶሩዋ እጻይ፤ ኡንቱንቱ ጌሱዋካ ሸነታድ፤ ታን ካታማነ ካታማን ደእያ ኡባ ኡንቱንቱ ሞርከቶ አደ እማና” ያጌዳ።<verse eid="AMO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9"/>እት ጎልያን ታሙ አሳይ አቶፐ፥ ኡንቱንቱካ ሀይቃና። <verse eid="AMO 6:9"/><verse number="10" style="v" sid="AMO 6:10"/>ኡንቱንቱ ዳቦቱዋፐ እቱ አሃ ሞጋናዉ ጎለፐ ከሲደ አፋና፤ ሄ ጎልያ ቆልኦን ደእያ ብታንያ፥ “ኔናና አቴዳ ሀራ አሳይ ደኢ?” ያጊደ ኦቻና። እ ዛሪደ፥ “ባዋ” ያጋና። ኦችያዌ፥ “ሀይዛ፥ ሀይዛ! መና ጎዳ ሱን ኑን ጼሳናዉ ኮሸና” ያጋና።<verse eid="AMO 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 6:11"/>መና ጎዳይ አዛዝና፥ ዎጋ ጎለቱ ኮለታና፤ ቄር ጎለቱካ መኤረታና። <verse eid="AMO 6:11"/><verse number="12" style="v" sid="AMO 6:12"/>ፓራቱ ዛላ ቦላን ጋልፋናዉ ዳንዳዪኖ? ዎይ ቃይ ጎሻንቻይ ቦራ ዋጺደ፥ አባ ጎሻናዉ ዳንዳዪ? ሽን ህንተ ቱሙ ፕርዳ ማርዝያዉ፥ ጽሎተ አይፍያካ ጫሞ ላሜድታ። <verse eid="AMO 6:12"/><verse number="13" style="v" sid="AMO 6:13"/>ህንተ ሎዳባራ ካታማ ጾኔዳ ድራዉ ናሸቲታ፤ ቃይ፥ “ኑን ቃርናይማ ካታማካ ኑ ምኖተን ኦይቄዶ” ያጊታ።<verse eid="AMO 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 6:14"/>መና ጎዳይ፥ ኡባፐ ዎልቃማ ጾሳይ ሀዋዳን ያጌ፤ “ህንተኖ፥ እስራኤልያ አሳቶ፥ ታን ህንተ ቦላ እት ካዉተ ደንና፤ ኡንቱንቱ ህንተና ሀማታ ፕኑዋፐ ዶሚደ፥ አራባ ዎምባ ጋካናዉ ቱጋያና” ያጌ።<verse eid="AMO 6:14"/></para>
  <chapter eid="AMO 6"/>
  <chapter number="7" style="c" sid="AMO 7"/>
  <para style="ms">እስራኤልያ ሙሩዋባ አሞጽ በኤዳ እቼሹ ሳጻቱዋ</para>
  <para style="mr">(<ref loc="AMO 7:1-9:10">7:1—9:10</ref>)</para>
  <para style="s1">ቦሊ ያናዋ በስያ ሳፃ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1"/>ኡባ ሞድያ መና ጎዳይ ታና ሳፃ በሴዳ። ሄ ሳጻን ታን ካትያ ጋክያ ካይ ጫከቴዳዋፐ ጉይያን፥ ላኤንዋ ጫሬዳ ጫርሻ ቦላ እ ቦልያ ዉድያ መሽን በኣድ። <verse eid="AMO 7:1"/><verse number="2" style="v" sid="AMO 7:2"/>ኡንቱንቱ እርጻባ ኡባ ሚደ ዉርሴዳ ዎደ ታን፥ “አቤት ኡባ ሞድያ መና ጎዳዉ፥ ሀያና አቶ ጋርኪ! ያቆባ ዛራቱ ዋኒደ አታናዉ ዳንዳዪኖ? ኡንቱንቱ ቄር ጉቱዋቴ!” ያጋድ።<verse eid="AMO 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3"/>ሄዋ ድራዉ፥ መና ጎዳይ ቃረቴዳ፥ ባረ ቆፋ ላሜዳ፤ ላሚደ ሀዋዳን ያጌዳ፤ “ሀ ኔን በኤዳባይ ፖለተናዋ” ያጌዳ መና ጎዳይ።<verse eid="AMO 7:3"/></para>
  <para style="s1">ታማን ፕርዳናዋ በስያ ሳፃ</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4"/>ኡባ ሞድያ መና ጎዳይ ታና ሀራ ሳፃ በሴዳ። ኡባ ሞድያ መና ጎዳይ ባረ አሳ ፕርዳናዉ ታማ ጼሴዳ፤ ሄ ታማይ ዎልቃማ ጪማ አባ ም ድጊደ፥ ቢታካ ጹጋናዉ ዶሜዳ። <verse eid="AMO 7:4"/><verse number="5" style="v" sid="AMO 7:5"/>ያትና ታን ሀዋዳን ያጋድ፤ “አቤት ኡባ ሞድያ መና ጎዳዉ፥ ሀያና ሀ ታማ ቶይሳርኪ! ያቆባ ዛራቱ ዋኒደ አታናዉ ዳንዳዪኖ? ኡንቱንቱ ቄር ጉቱዋቴ!” ያጋድ።<verse eid="AMO 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6"/>ሄዋ ድራዉ፥ መና ጎዳይ ቃረቴዳ፥ ባረ ቆፋ ላሜዳ፤ ላሚደ ኡባ ሞድያ መና ጎዳይ ሀዋዳን ያጌዳ፤ “ሀዌካ ቃይ ፖለተናዋ” ያጌዳ።<verse eid="AMO 7:6"/></para>
  <para style="s1">ግምቢያ ስታተ ልክያ ቱምቢያ በስያ ሳፃ</para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7"/>ቃይካ እ ታና ሀራ ሳፃ በሴዳ። ታን ሄ ሳጻን በእያ ዎደ፥ ጎዳይ ግምቢያ ስታተ ልክያ ቱምቢያ ኦይቂደ፥ ቱምቢያን ልከቲደ ግምበቴዳ ግምቢያ ማታን ኤቄዳ። <verse eid="AMO 7:7"/><verse number="8" style="v" sid="AMO 7:8"/>መና ጎዳይ ታና፥ “አሞጻ፥ ሀ ኔን ጼልያዌ አዬ?” ያጊደ ኦቼዳ።</para>
  <para style="p" vid="AMO 7:8">ታን፥ “ቱምቢያ” ያጋድ።</para>
  <para style="p" vid="AMO 7:8">መና ጎዳይ ታና፥ “በአ፥ ታን ታ አሳ እስራኤልያ ግዶን ቱምቢያ የጋይ፤ ታን ኡንቱንታ ሙረናን አከ። <verse eid="AMO 7:8"/><verse number="9" style="v" sid="AMO 7:9"/>ይሳቃ ዛራቱ ጎይንያ ቃ ሳአቱ ኮለታና፤ እስራኤልያ ጌሻ ሳአቱካ ያና፤ ቃይ እዮርባማ ካዉተ ቦላካ ታን ማሻና ደንዳና” ያጌዳ።<verse eid="AMO 7:9"/></para>
  <para style="s1">አሞጻነ አሜስያሳ</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10"/>ቤቴለ ካታማን ቄስያ ግዲደ ደእያ አሜስያሴ እስራኤልያ ካትያ እዮርባመኮ ሀዋዳን ያጊደ ኪቴዳ፤ “አሞጽ እስራኤልያ አሳ ግዶን ደኢደ፥ ነ ቦላ ማቀቴዳ፤ እ ባረ ኦዱዋን ጋድያ ባይዜ። <verse eid="AMO 7:10"/><verse number="11" style="v" sid="AMO 7:11"/>አያዉ ጎፐ፥ እ ሀዋዳን ያጌ፤ ‘እዮርባም ማሻን ሀይቃና፤ እስራኤልያ አሳይካ ባረንቱ ጋድያፐ ኦሞደቲደ ባና’ ያጌ” ያጌዳ።<verse eid="AMO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12"/>ያትና አሜስያሴ አሞጻ ሀዋዳን ያጌዳ፤ “ኔኖ ትምቢትያ ኦድያዎ፥ ባ፤ ህን ይሁዳ ቢታ ባቃታ ባደ፥ ያን ቁማ ማ፤ ትምቢትያ ያን ኦዳ። <verse eid="AMO 7:12"/><verse number="13" style="v" sid="AMO 7:13"/>ሽን ሀዌ ቤቴለ ካቲ ጎይንያ ሳኣነ ካዉተ ጌሻ ሳ ግድያ ድራዉ፥ ላኤን ሀ ሳኣን ትምቢትያ ኦዶፓ” ያጌዳ።<verse eid="AMO 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14"/>አሞጽ ዛሪደ፥ አማስያስ ሀዋዳን ያጌዳ፤ “ታን መህያ ሄምያዋነ ኡንቱንቱ አይፍያ ማጽያዋፐ አትና፥ ትምቢትያ ኦድያዋ ዎይ ትምቢትያ ኦድያዋ ናኣ ግድከ። <verse eid="AMO 7:14"/><verse number="15" style="v" sid="AMO 7:15"/>ሽን መና ጎዳይ ታና ዶርሳ ዉድያ ሄምያ ሳፐ አኪደ፥ ‘ባደ ታ አሳዉ እስራኤልያዉ ትምቢትያ ኦዳ’ ያጌዳ። <verse eid="AMO 7:15"/><verse number="16" style="v" sid="AMO 7:16"/>ሀእ ስም መና ጎዳይ ግያዋ ስሳ! ኔን፥ ‘እስራኤልያ ቦላ ትምቢትያ ኦዶፓ፤ ይሳቃ ዛራቱዋ ቦላካ ማርካቶፓ’ ያጋዳ። <verse eid="AMO 7:16"/><verse number="17" style="v" sid="AMO 7:17"/>ሄዋ ድራዉ፥ መና ጎዳይ ሀዋዳን ያጌ፤ ‘ነ ማቻታ ካታማ ግዶን ሻርሙጻ ግዳናዋ፤ ነ አቱማ ናናቱነ ነ ማጫ ናናይ ማሻን ሀይቃና፤ ነ ቢታይካ ዎዶሩዋን ሻከታና፤ ቃይ ኔን ነ ሁጲያዉካ አላጋ ጋድያን ሀይቃና። እስራኤልያ አሳይካ ባረንቱ ጋድያፐ ኦሞደቲደ ቱማ ባና’ ያጌ” ያጌዳ።<verse eid="AMO 7:17"/></para>
  <chapter eid="AMO 7"/>
  <chapter number="8" style="c" sid="AMO 8"/>
  <para style="s1">ቴራይ ኩሜዳ ኬሻ በስያ ሳፃ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1"/>ኡባ ሞድያ መና ጎዳይ ታና ሀራ ሳፃ በሴዳ፤ ሄዌካ፥ ቴራይ ኩሜዳ ኬሻ። <verse eid="AMO 8:1"/><verse number="2" style="v" sid="AMO 8:2"/>እ ታና፥ “አሞጻ፥ ሀ ኔን በእያዌ አዬ?” ያጊደ ኦቼዳ።</para>
  <para style="p" vid="AMO 8:2">ታን፥ “ቴራይ ኩሜዳ ኬሻ በአይ” ያጋድ።</para>
  <para style="p" vid="AMO 8:2">ያትና መና ጎዳይ ታዉ ሀዋዳን ያጌዳ፤ “ታ አሳ እስራኤላዉ ዉርሰይ<note caller="+" style="f"><char style="fr" closed="false">8:2 </char><char style="fqa" closed="false">ዉርሰይ፦ </char><char style="ft" closed="false">ግያዌ እብራይስጸ ቃላን “ቴራ” ማላቴ።</char></note> ጋኬዳ፤ ሀዋፐ ስንናዉ ታን ኡንቱንታ ሙረናን አከ” ያጌዳ።<verse eid="AMO 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 8:3"/>ኡባ ሞድያ መና ጎዳይ ሀዋዳን ያጌ፤ “ሄ ጋላስ ካትያ ጎልያን የጽያ የይ ዬኮ ላመታናዋ፤ ሀይቄዳ አሳ አሃይ ሙለ ሳኣን ዳራና፤ ቃይ ጮኡ ጊና፥ ያን ሃን ኦለታና” ያጌ።<verse eid="AMO 8:3"/></para>
  <para style="s1">እስራኤልያ ኩንደ</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 8:4"/>ህንተኖ፥ መቶታንቻቱዋ የያዋንቶ፥ ጋድያን ደእያ ህዬሳቱዋካ ይሳናዉ ኮይያዋንቶ፥ ሀዋ ስስተ! <verse eid="AMO 8:4"/><verse number="5" style="v" sid="AMO 8:5"/>ህንተ ሀዋዳን ያጊታ፤ “ኑን ካ ዛልአናዉ አግናይ ጼርያ ባላይ አዉደ አኔ! ቃይ ኑን ኑ ዛልእያ ዶማናዉ ሳምባታይ አዉደ አንዴሻ! ያትንቶ ኑን ካ ጉባን ማክ ማኪደ፥ ዳሮ ሚሻ አኪደ ባይዛና። ቃይ ዎርዶ ሚዛናን ልኪ ልኪደ፥ አሳ ጭማና። <verse eid="AMO 8:5"/><verse number="6" style="v" sid="AMO 8:6"/>ኑን ህዬሳ ብራን፥ መቶታንቻካ መጽ ላኡ ገድያ ጫማን ሻማና፤ ቃይ ዛርጋ ሀርቁዋ ሙሩታ ዛርጋ ጋትያን ባይዛና” ያጊታ።<verse eid="AMO 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7"/>መና ጎዳይ ያቆብ ጬቀትያ ባረ ሱንን ሀዋዳን ያጊደ ጫቄዳ፤ “ታን ኡንቱንቱ ኦዳ ኢታ ኦሱዋ ሙለካ ዶግከ። <verse eid="AMO 8:7"/><verse number="8" style="v" sid="AMO 8:8"/>ቢታይ ቃጽያዌነ ጋድያን ደእያ አሳይ ኡባይ ዬክያዌ ሄዋ ጋሱዋና ግደኔየ? ኤ ናይለ ሻፋይ ኩንደ ቃጽያዋዳን፥ ቢታ ኡባይ ቃጺደ ባልቡቀታና፤ ቃይ ሄ ኩን ዎያዋዳን ዎና” ያጌዳ።<verse eid="AMO 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 8:9"/>ኡባ ሞድያ መና ጎዳይ ሀዋዳን ያጌ፤ “ሄ ጋላስ ታን አዋ ሴታ ጋላስ ዉልሳና፤ ሳኣካ ጋላስ ምሳና። <verse eid="AMO 8:9"/><verse number="10" style="v" sid="AMO 8:10"/>ታን ህንተ ባላ ናሸቻ ካዮ፥ ህንተ የካ ዬኮ ላማና። መጽ እት ናአይ ሀይቂና ዬክያ አሳዳን፥ ህንተ ህንተ ሁጲያ ሜደቲደ ዋሩዋ ማያናዳን፥ ታን ህንተና ኦና። ሄ ጋላሳ ዉርሰይ ዳሮ ጫሞ ግዳናዋ” ያጌ።<verse eid="AMO 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 8:11"/>ኡባ ሞድያ መና ጎዳይ ሀዋዳን ያጌ፤ “በእተ፥ ታን ቢታ ኡባ ቦላን ኮሻ የድያ ጋላሳቱ ዪኖ። ታን ኮሻ የድያ ጋላስ፥ አሳይ ስሳናዉ መና ጎዳ ቃላ ዪደ ኮሻታናፐ አትና፥ ካ ዪደ ኮሻተና ዎይ ሃ ዪደ ሳመተና። <verse eid="AMO 8:11"/><verse number="12" style="v" sid="AMO 8:12"/>አሳይ አዋይ ዉልያ ባጋ አባፐ አዋይ ዶልያ ባጋ አባ ጋካናዉነ ሁጲሳፐ ገድሳ ጋካናዉ ብቻራና። ኡንቱንቱ መና ጎዳ ቃላ ኮያናዉ ያነ ሃነ ዎጻና፥ ሽን ደምክኖ። <verse eid="AMO 8:12"/><verse number="13" style="v" sid="AMO 8:13"/>ሄ ጋላስ ማላ ሎኦ ዎዶራቱነ ዎዳላቱ ሳሙዋን ዚል አጋና። <verse eid="AMO 8:13"/><verse number="14" style="v" sid="AMO 8:14"/>ሳማርያ ኤቃቱዋን ጫቂያዋንቱ፥ ‘ዳና ጾሳይ ኤሮ!’ ያግያዋንቱነ፥ ‘በርሳቤሀ ጾሳይ ኤሮ’ ያግያዋንቱ ኩንዳና። ኡንቱንቱ ላኤን ሙለካ ደንድክኖ” ያጌ።<verse eid="AMO 8:14"/></para>
  <chapter eid="AMO 8"/>
  <chapter number="9" style="c" sid="AMO 9"/>
  <para style="s1">ጾሳ ፕርዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1"/>ያርሽያ ሳኣ ማታን ጎዳይ ኤቃ ደእሽን፥ ታን በኣድ። እ ታና ሀዋዳን ያጌዳ፤ “ባሱ ቃጻናዳን፥ ጌሻ ማቅዳስያ ጉምቡዋ ሾጫ፤ አሳ ኡባ ሁጲያን መንሬ። ሄዋፐ አትያ አሳ ታን ማሻን ዎና። ባቃትያ አሳይ ከስ አከና፤ ከስ አኬዳ አስካ ፓጻ አተና። <verse eid="AMO 9:1"/><verse number="2" style="v" sid="AMO 9:2"/>ኡንቱንቱ ጋድያ ቦኪደ፥ ስኦልያዉ ዱገ ዎፐካ፥ ታን ኡንቱንታ ሄዋፐ ከሳና። ሳሉዋ ፑደ ከሶፐካ፥ ታን ኡንቱንታ ሄዋፐ ዱገ ዎና። <verse eid="AMO 9:2"/><verse number="3" style="v" sid="AMO 9:3"/>ኡንቱንቱ ቃርመሎሳ ደርያ ጼራን ቆሰቶፐካ፥ ታን ኡንቱንታ ኮያደ ሄዋፐ ከሳና። አባ ጪሙዋ ግዶ ገሊደ፥ ታ ስንፐ ጌሞፐካ፥ ታን ዳዊያ አዛዝና፥ እ ኡንቱንታ ዱካና። <verse eid="AMO 9:3"/><verse number="4" style="v" sid="AMO 9:4"/>ቃይ ባረንቱ ሞርከቱዋን ኦሞደቲደ፥ ኡንቱንቱ ቦፐካ፥ ያን ኡንቱንቱ ማሻን ሀይቃናዳን፥ ታን አዛዛና፤ ታን ኡንቱንታ ኢታ አይፍያን ጼላናፐ አትና፥ ሎኦ አይፍያን ጼልከ” ያጌዳ።<verse eid="AMO 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 9:5"/>ጎዳይ፥ ኡባፐ ዎልቃማ መና ጎዳይ ሳኣ ቦቼ፤ ሳአይ ሴሬ፤ ቃይ ሳኣን ደእያባይ ኡባይካ ዬኬ። ናይለ ሻፋይ ኩንደ ባልቡቀትያዋዳን፥ ቢታ ኡባይ ባልቡቀቴ፤ ቃይ ሄ ኩን ዎያዋዳንካ ዎ። <verse eid="AMO 9:5"/><verse number="6" style="v" sid="AMO 9:6"/>እ ባረዉ ደእያ ሳኣ ሳሉዋን ጊግሴ፤ አ ባሱዋካ ሳኣን ባሴ። ቃይ እ አባ ሃቱዋ ጼሲደ፥ ጋድያ ቦላን ዱገ ጉሴ፤ አዉ ሱንይ መና ጎዳ።<verse eid="AMO 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 9:7"/>መና ጎዳይ ሀዋዳን ያጌ፤ “ህንተኖ፥ እስራኤልያ አሳቶ፥ ህንተ ታዉ ቶጵያ አሳ ማላ ግድክቴየ? ታን ህንተና ግብጼ ጋድያፐ ከሴዳዋዳን፥ ፕልስጼማ አሳ ካፍቶራፐ፥ ቃይ ሶርያ አሳካ ቂራፐ ከሳድ” ያጌ።<verse eid="AMO 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 9:8"/>መና ጎዳይ ሀዋዳን ያጌ፤ “በእተ፥ ኡባ ሞድያ መና ጎዳ አይፊ ናጋራንቻ ካዉተ ቦላን ደኤ። ታን አ ጋድያ ቦላፐ ይሳና፤ ሽን ታን ያቆባ ዛርያ ኡባና ይስከ።<verse eid="AMO 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 9:9"/>“በእተ፥ ካ ዛዝርያን ዛዝርያዋዳን፥ እስራኤልያ አሳ ካዉተቱዋ ኡባ ግዶን ዛዝራናዳን፥ ታን አዛዛና፤ ሽን ኡንቱንቱ ግዶን አማነትያዋንቱፐ እቱነ ሳኣን ዎደ የና። <verse eid="AMO 9:9"/><verse number="10" style="v" sid="AMO 9:10"/>‘ኑና አያ ኢታባይነ ጋከና ዎይ ደመና’ ያግያ ታ አሳ ግዶን ደእያ ናጋራንቻቱ ኡባይ ማሻን ዉራና” ያጌ።<verse eid="AMO 9:10"/></para>
  <para style="s1">እስራኤልያ ፖኦ ህዶታ</para>
  <para style="r">(<ref loc="AMO 9:11-15">9:11-15</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11"/>ቃይካ ጾሳይ፥ “ሄ ጋላስ ታን ኮለቲደ ኩንዴዳ ጎልያዳን ሀኔዳ ዳዊታ ካዉተ ደንና፤ ጾኤቴዳ ሳአቱዋካ ባራና፤ ቃይ ኮለቴዳሳካ ኦራና፤ ታን አ በንዋዳን ኦደ ኬጻና።<note caller="-" style="x"><char style="xo" closed="false">9:11-12 </char><char style="xt" closed="false"><ref loc="ACT 15:16-18">ኪታ 15:16-18</ref></char></note> <verse eid="AMO 9:11"/><verse number="12" style="v" sid="AMO 9:12"/>ሄዌነ እስራኤልያ አሳይ ኤዶማ ጋድያፐ አቴዳዋንታነ ታ ሱንን ጼሰቴዳ ካዉተቱዋ ኡባ ላታናሳ” ያጌ። ሀዋ ኦያዌ ታና መና ጎዳ።<verse eid="AMO 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 9:13"/>መና ጎዳይ ሀዋዳን ያጌ፤ “በእተ፥ ካ ጫክያዋንቱ ጫኪደ ዉርሰናን ደእሽን፥ ጋድያ ጎሽያዋንቱ ጋክያ ዎዲ፥ ዎይንያ ቴራ ጉምእያዋንቱካ ጉምኢደ ዉርሰናን ደእሽን፥ ዎይንያ ዘርያዋንቱ ጋክያ ጋላሳቱ ያና። ሄ ዎደ ደረቱ ማልኦ ዎይንያ ኤሳ ጾካና፤ ዞዘቱዋ ኡባፐካ ዎይንያ ኤሳይ ጎጋና። <verse eid="AMO 9:13"/><verse number="14" style="v" sid="AMO 9:14"/>ኦሞዱዋን ቤዳ ታ አሳ እስራኤልያ ዛራደ እሻልሳና። ኡንቱንቱ ኮለቴዳ ካታማቱዋ ዛረ ኬጺደ፥ ኡንቱንቱን ደአና። ዎይንያ ቱራካ ቶኪደ፥ አፐ ዎይንያ ኤሳ ኡሻና። ቃይ አታክልተቱዋካ ቶኪደ፥ ኡንቱንቱ አይፍያ ማና። <verse eid="AMO 9:14"/><verse number="15" style="v" sid="AMO 9:15"/>ታን እስራኤልያ ኡንቱንቱ ጋድያን ቶካና፤ ኡንቱንቱ ታን ኡንቱንቶ እሜዳ ጋድያፐ ላኤን ሙለካ ሾደትክኖ” ያጌ። ሀዋ ኦድያዌ መና ጎዳ ህንተ ጾሳ።<verse eid="AMO 9:15"/></para>
  <chapter eid="AMO 9"/>
</usx>
