<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Dawuro Full Bible Ethiopic Version</book>
  <para style="h">ያቆባ ኪታ</para>
  <para style="toc1">ያይቆብ ጻፌዳ ኪታ</para>
  <para style="toc2">ያቆባ ኪታ</para>
  <para style="toc3">ያቆባ</para>
  <para style="mt1">ያቆብ</para>
  <para style="mt2">ጻፌዳ ኪታ</para>
  <para style="imt">ገሉዋ</para>
  <para style="ip">ሀ ኪታ ጻፌዳ ያቆብ ጎዳ የሱሳ እሻፐ አትን ታማነ ላኡ የሱሳ ካልያዋንቱፐ እቱዋ ግደና። እካ የሩሳላመን ደእያ አማንያ አሳ ካለያ ጭማ (ጋል 2:9)። ሀ ኪታይ ጻፈቴዳዌ እት ዎሳ ጎላትዉ ግደናን ሮመ ካዉተ ግዶን ላለቴዳ አይሁዳ አማንያዋንቱ ኡባቱዋሳ ግዴዳ፥ ኑናካ ሀቼ ሀቼ ደኡዋ ካለያ ቆፋቱዋ ኦይቄዳ። ጻፈቴዳዌካ “አላምያ ኡባን ላለቴዳ ጾሳ አሳሳ”። ሀ ማጻፋ ጻፌዳዌ አዳ ኤራተ ኑን ኦሱዋን ፔሽያ ሂላነ አማንያ አሳ ኤሻነ ሀኖታ ታማርስያ ኦግያ ካለሱዋ እምያ የዋቱዋ ምስልያዳን ቆንጭያን በሴ።</para>
  <para style="ip">ህዬሳተባ፥ ዱረተባ፥ ፓጭያባ፥ ሎኦ ኤሻባ፥ ቃናትያባ፥ አማኑዋባነ ሎኦ ኦሱዋባ፥ እንጻርሳ ማዱዋባነ ቆሁዋባ፥ አዳ ኤራተባ፥ እቱ እቱዋና ዋላቀትያባ፥ ኦቶሩዋባነ አሽከተባ፥ ሀራ አሳ ቦላ ፕርድያዋ፥ ጬቁዋባ ዎይ አዩዋባ፥ ገንጫባነ ዎሳባ፥ አማንያ አሳይ ደአናዉ በስያ ኦግያ ኡባ ጻፌዳ።</para>
  <para style="ip">ኪታይካ ክርስትና ደኡዋን አማኑ ኦሱዋን ፔሻና ሀኖታባ ቆንጭሲደ በሴ።</para>
  <para style="iot">ሸምፓቱዋ ኡባቶ እመቴዳ ቃን ቆፋቱዋ</para>
  <para style="io1">ገሉዋ 1:1</para>
  <para style="io1">አማኑዋነ አዳ ኤራተ <char style="ior"><ref loc="JAS 1:2-8">1:2-8</ref></char></para>
  <para style="io1">ህዬሳተባነ ዱረተ <char style="ior"><ref loc="JAS 1:9-11">1:9-11</ref></char></para>
  <para style="io1">ፓጭያ <char style="ior"><ref loc="JAS 1:12-18">1:12-18</ref></char></para>
  <para style="io1">ጾሳ ቃላ ስሱሳነ ኦሱዋ ቦላ ፔሹሳ <char style="ior"><ref loc="JAS 1:19-27">1:19-27</ref></char></para>
  <para style="io1">ሀነና ኦግያን እቱ ሀራዉ ማደና ማላ እመቴዳ ኦዱዋ <char style="ior"><ref loc="JAS 2:1-13">2:1-13</ref></char></para>
  <para style="io1">አማኑዋነ ኦሱዋ <char style="ior"><ref loc="JAS 2:14-26">2:14-26</ref></char></para>
  <para style="io1">አማንያ አሳነ እንጻርሳፐ ከስያ ሃሳያ <char style="ior"><ref loc="JAS 3:1-18">3:1-18</ref></char></para>
  <para style="io1">አማንያ አሳነ ሀ አላምያ <char style="ior"><ref loc="JAS 4:1-5:6">4:1—5:6</ref></char></para>
  <para style="io1">ዱማ ዱማ የዎ እመቴዳ ማቁዋ <char style="ior"><ref loc="JAS 5:7-20">5:7-20</ref></char></para>
  <chapter number="1" style="c" sid="JAS 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1"/>ታን ያቆብ ጾሳ አይሊነ ጎዳ የሱስ ክርስቶሳ አይሊ፥ ቢታ ኡባን ላለቴዳ ታማነ ላኡ ዘረቶ<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fk" closed="false">ቢታ ኡባን ላለቴዳ ታማነ ላኡ ዘረቶ፦ </char><char style="ft" closed="false">ያቆብ ጊደ ደእያ ቆፋይ፥ ጎዳ ካልያ አማንያዋንታ ግዲደ ታማነ ላኡ እስራኤልያ ዘረቱዋዳን ባረንቱ ሞርከቱዋን ቢታ ኡባ ላለት ጋኬዳዋንታ ጉሳ።</char></note> ሳሮታ ኪታይ።<verse eid="JAS 1:1"/></para>
  <para style="s1">ዳንዳያ፥ አማኑዋ፥ አዳ ኤራተ</para>
  <para style="p">
    <verse number="2-3" style="v" sid="JAS 1:2-3"/>ታናዳን ጾሳ ካልያዋንቶ፥ ህንተ አማኑ ፓጨትያዌ ህንተንቶ ዳንዳያ እማናዋ ኤሪደ፥ ዱማ ዱማ ፓጪ ህንተና ጋክያ ዎደ፥ ሄዋ ኩመን ናሸቻዳን ፓይድተ። <verse eid="JAS 1:2-3"/><verse number="4" style="v" sid="JAS 1:4"/>ህንተ ዳንዳያይ አይነ ባል ባይናን ህንተና ምኔዳዋንታነ ፓጭ ባይናዋንታ ኦደ፥ ባረ ኦሱዋ ፖሎ። <verse eid="JAS 1:4"/><verse number="5" style="v" sid="JAS 1:5"/>ሽን ህንተፐ ኦንነ ባረዉ አዳ ኤራተይ ዮፐ፥ ካናን ኡባዉ ኬካተን እምያ ጾሳ ዎሶ። እ አዉ እማና። <verse eid="JAS 1:5"/><verse number="6" style="v" sid="JAS 1:6"/>ሽን እ አያንነ ስናን አማኑዋን ጾሳ ዎሶ። አያዉ ጎፐ፥ ስያ ኡራይ ጫርኩ ሱግና ቃጽያ አባ ቤታ ማላ። <verse eid="JAS 1:6"/><verse number="7-8" style="v" sid="JAS 1:7-8"/>አያዉ ጎፐ፥ ላኡ ቆፋይ ደእያ ኡራይ፥ ባረ ኦግያ ኡባን ባረ ቆፋ ቃቼናዌ፥ ሄ ኡራይ ጎዳፐ አይነ ደማናዉ ቆፖፖ።<verse eid="JAS 1:7-8"/></para>
  <para style="s1">ህዬሳ አሳነ ዱረ አሳ ናሸቻ</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9"/>ሽን ህዬሳ እሻይ ጾሳይ አ ቁ ኦዳ ዎደ ናሸቶ። <verse eid="JAS 1:9"/><verse number="10" style="v" sid="JAS 1:10"/>ቃይ ዱረ እሻይካ ጾሳይ አ ካዉሽሴዳ ዎደ ናሸቶ። አያዉ ጎፐ፥ ዱረ ብታኒ ማታ ግዶን ድጭያ ጪሻዳን ያና።<note caller="-" style="x"><char style="xo" closed="false">1:10-11 </char><char style="xt" closed="false"><ref loc="ISA 40:6-7">ኢሳ. 40:6-7</ref></char></note> <verse eid="JAS 1:10"/><verse number="11" style="v" sid="JAS 1:11"/>አያዉ ጎፐ፥ አዋይ ባረ ሴላና ከሲደ፥ ማታ መልስና፥ ጪሻይ ዬ፤ ቃይ አ ማላ ሎኦተይካ ዬ፤ ሄዋዳንካ ቃይ ዱረ ብታኒ ባረዋ ኦደ ያና።<verse eid="JAS 1:11"/></para>
  <para style="s1">አሳ ቦላ ጋክያ ፓጭያ</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12"/>ዋይያን ገንጭያ ኡራይ አንጀቴዳዋ፤ አያዉ ጎፐ፥ ሄ ዋይያ ጾኔዳዋፐ ጉይያን፥ ጾሳይ ባረና ሲቅያዋንቶ እማና ጌዳ ደኡዋ ካላቻ<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="fk" closed="false">ደኡዋ ካላቻ፦ </char><char style="ft" closed="false">ቦንቼቴዳ ደኡዋ ጉሳ።</char></note> እ አካና። <verse eid="JAS 1:12"/><verse number="13" style="v" sid="JAS 1:13"/>ኦንነ ፓጨቴዳ ዎደ፥ “ታና ጾሳይ ፓጬ” ጎፖ። አያዉ ጎፐ፥ ጾሳይ ኢታን ፓጨታናዉ ዳንዳየና፤ ቃይ እ ባረ ሁጰዉ ኦናነ ፓጨና። <verse eid="JAS 1:13"/><verse number="14" style="v" sid="JAS 1:14"/>ሽን አሳይ ሁጲያን ሁጲያን ባረ ሁጰ ኢታ አሙዋን ጎሸትያ ዎደነ ጭመትያ ዎደ ፓጨቴ። <verse eid="JAS 1:14"/><verse number="15" style="v" sid="JAS 1:15"/>ሄዋፐ ጉይያን፥ አሙ ሻሃሪደ፥ ናጋራ የሌ፤ ቃይ ናጋራይ ድጪደ፥ ሀይቁዋ የሌ።<verse eid="JAS 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16"/>ታናዳን ጾሳ ካልያዋንቶ፥ ጭመቶፕተ። <verse eid="JAS 1:16"/><verse number="17" style="v" sid="JAS 1:17"/>ሎኦ እሙዋ ኡባይነ ኩመን ዎይታ ኡባይ ሳሉዋፐ ዬ። ሳሉዋ ፖኡዋ መዳ አዉዋፐ ዬ፤ ጾሳይ ባረ ሁጰዉ ዱማተናነ ዎይ ባረ ኩዋ ላመና። <verse eid="JAS 1:17"/><verse number="18" style="v" sid="JAS 1:18"/>ኑን እ መዳ መታቱዋ ግዶን ቃሳ አካናዳን፥ ኑና ባረ ሸንያን ቱሙ ቃላን የሌዳ።<verse eid="JAS 1:18"/></para>
  <para style="s1">ስሴዳዋ ኦሱዋን ፔሽያዋ</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19"/>ታናዳን ጾሳ ካልያዋንቶ፥ ሀዋ ሀሳይተ፤ አሳይ ኡባይ ስሳናዉ ኤሌሎ፤ ሽን ሃሳያናዉነ ሀንቀታናዉ ኤሌሎፖ። <verse eid="JAS 1:19"/><verse number="20" style="v" sid="JAS 1:20"/>አያዉ ጎፐ፥ አሳ ሀንቁ ጾሳይ ኮይያ ጽሎተ አሄና። <verse eid="JAS 1:20"/><verse number="21" style="v" sid="JAS 1:21"/>ሄዋ ድራዉ፥ ቱና ሀኖታ ኡባነ ኢታተ ኡባ ህንተፐ ይሲደ፥ ጾሳይ ህንተ ዎዛናን ቶኬዳ ህንተ ሸምፑዋ አሻናዉ ዳንዳይያ ቃላ አሽከተን አክተ።<verse eid="JAS 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22"/>ሽን ጾሳ ቃላ ኦሱዋን ፔሽተፐ አትን፥ ስሳ ጻላላን ህንተ ሁጲያ ጭሞፕተ። <verse eid="JAS 1:22"/><verse number="23" style="v" sid="JAS 1:23"/>አያዉ ጎፐ፥ ቃላ ስሲደ ኦና ኡራይ ደኦፐ፥ እ ባረ ማላ ማስቶትያ ጼልያ ኡራ ማላ። <verse eid="JAS 1:23"/><verse number="24" style="v" sid="JAS 1:24"/>እ ባረና ጼሊደ ቤ፤ ኤለካ እ አይ ማለንቶነ ዶግ አጌ። <verse eid="JAS 1:24"/><verse number="25" style="v" sid="JAS 1:25"/>ሽን ኦንነ አይለተፐ ከስያ ባል ባይና ህግያ ጼሊደ፥ አን አቅያዌ ቃይ አ ናግያዌ፥ ስሴዳዋካ ዶገናዌ፥ ሄ ኡራይ ባረ ኦያ ኦሱዋን አንጀታና።<verse eid="JAS 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26"/>ባረ እንጻርሳ ናገናን ባረና ጭሚደ፥ ባረዉ ጾሳ ጎይንያዋ ማላትያ ኡራይ ደኦፐ፥ አ ጎይናይ መላ። <verse eid="JAS 1:26"/><verse number="27" style="v" sid="JAS 1:27"/>ጾሳ አዉዋ ስንን ፖኩ ባይና ጌሻ ጎይናይ ሀዋ፤ ሄዌ ሀቃዌ ጎፐ፥ አታ አዉ ባይና ናናቱዋነ ዋየትያ አምኤቱዋ ማዳናዋነ ሳኣ ናጋራ ቅታፐ ባረ ሁጲያ ናጋናዋ።<verse eid="JAS 1:27"/></para>
  <chapter eid="JAS 1"/>
  <chapter number="2" style="c" sid="JAS 2"/>
  <para style="s1">ህዬሳ ካናዉ በሰና</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1"/>ታናዳን ጾሳ ካልያዋንቶ፥ ህንተ ኑ ቦንቾ ጎዳ የሱስ ክርስቶሳ አማን ደኢደ፥ ዴሙዋ ጼሊደ፥ አሳ ቦንቾፕተ። <verse eid="JAS 2:1"/><verse number="2" style="v" sid="JAS 2:2"/>አያዉ ጎፐ፥ ዎርቃ ምግዱዋ ዎደ፥ ሎኦ ማዩዋ ማዬዳ እት አሳይ ህንተ ሺቁዋ ዮፐ፥ ቃይ ጩርቃ ማዩዋ ማዬዳ ህዬሳ አስካ ዮፐ፥ <verse eid="JAS 2:2"/><verse number="3" style="v" sid="JAS 2:3"/>ሎኦ ማዩዋ ማዬዳ ብታንያ ህንተ አ ቦንቺደ አ፥ “ኔን ሀዋን ኡባፐ ሎእያ ኦይድያን ኡታ” ጊደ ቃይ ህዬሳ ብታንያ፥ “ኔን ህንና ኤቃሻ፤ ዎይ ሀዋን ታ ገድያ ማታን ሳኣን ኡታ” ጎፐ፥ <verse eid="JAS 2:3"/><verse number="4" style="v" sid="JAS 2:4"/>ያትና ህንተ ህንተ ግዶን ሻኮተ መያዋንታነ ኢታ ቆፋና ደእያ ዳናቱዋ ግድክቴዬ?<verse eid="JAS 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5"/>ታናዳን ጾሳ ካልያዋንቶ፥ ስስተ፤ ጾሳይ ሀ ሳኣን ደእያ ህዬሳ አሳይ አማኑዋን ዱረታናዉነ ባረና ሲቅያዋንቶ እማና ጌዳ ሳሉዋ ካዉተ ላታናዉ ዶርቤነዬ? <verse eid="JAS 2:5"/><verse number="6" style="v" sid="JAS 2:6"/>ሽን ህንተ ህዬሳቱዋ ቶቼድታ። ዱረቱ ህንተና ቱጋይያዋንታ ግድክኖዬ? ኡንቱንቱ ህንተና ዳናን ሞትያዋንታ ግድክኖዬ? <verse eid="JAS 2:6"/><verse number="7" style="v" sid="JAS 2:7"/>ህንተዉ እመቴዳ ሎኦ ሱን ቦርያዋንቱ ኡንቱንታ ግድክኖዬ?<verse eid="JAS 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8"/>ሽን ጾሳ ማጻፋን፥ “ነ ሾሩዋ ነ ሁጲያዳን ሲቃ” ጌተቲደ ጻፈቴዳ ካትያ ህግያ<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="fk" closed="false">ካትያ ህግያ፦ </char><char style="ft" closed="false">ኡባፐ አዋን ጎእያ ህግያ፤ ሀዋ ብለይ፥ ካትያፐ እመቴዳዋ ጉሳ። ካቲ ኦኔ ጎፐ ጾሳፐ እመቴዳ ህግያ።</char></note> ህንተ ፖሎፐ፥ ሎኦባ ኦታ።<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ዎጋ 19:18</ref></char></note> <verse eid="JAS 2:8"/><verse number="9" style="v" sid="JAS 2:9"/>ሽን ህንተ አሳ ዴሙዋ ጼሊደ ቦንቾፐ፥ ናጋራ ኦታ፤ ቃይ ህጊ ህንተ ቦላ፥ ህግያ መንዳዋንቱዳን ፕርዳና። <verse eid="JAS 2:9"/><verse number="10" style="v" sid="JAS 2:10"/>አያዉ ጎፐ፥ ኦንነ ህግያ ኡባ ናጊደ፥ እትኖ መንያዋ ግዶፐ፥ ሄ ኡራይ ህግያ ኡባ መን። <verse eid="JAS 2:10"/><verse number="11" style="v" sid="JAS 2:11"/>አያዉ ጎፐ፥ “ዎሹሞፓ” ጌዳዌ ቃይ “ዎፓ” ጌዳ፤ ሽን ኔን ዎሹማና ዮፐካ፥ ዎዳዋ ግዶፐ፥ ህግያ መንዳ።<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="EXO 20:13">ከሳ 20:13</ref>፣ <ref loc="EXO 20:14">14</ref>፤ <ref loc="DEU 5:17">ዛረ. 5:17</ref>፣ <ref loc="DEU 5:18">18</ref></char></note> <verse eid="JAS 2:11"/><verse number="12" style="v" sid="JAS 2:12"/>አሳ አይለተፐ ከስያ ህግያን፥ ፕርዳ አካና አሳቱዋዳን ሃሳይተነ ኡንቱንቱዋዳን ኦተ። <verse eid="JAS 2:12"/><verse number="13" style="v" sid="JAS 2:13"/>አያዉ ጎፐ፥ አሳ ማርቤና ኡራ ጾሳይ ማረናን ፕርዳና፤ ማሮተይ ፕርዳ ጾኔ።<verse eid="JAS 2:13"/></para>
  <para style="s1">አማኑዋነ ኦሱዋ</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14"/>ታናዳን ጾሳ ካልያዋንቶ፥ እት ኡራይ ባረዉ አማኑ ደኤ ጎፐ፥ ቃይ አ አማኑዋ አ ኦሱ ኤርሳና ዮፐ፥ አ አይ ጎአኔ? አ አማኑ አ አሻናዉ ዳንዳዪ? <verse eid="JAS 2:14"/><verse number="15" style="v" sid="JAS 2:15"/>እት እሻይ፥ ዎይ እት ምቻታ ካሎቶፐ፥ ቃይ ኡንቱንቶ ኡባ ጋላስ ምያባይ ዮፐ፥ <verse eid="JAS 2:15"/><verse number="16" style="v" sid="JAS 2:16"/>ህንተፐ እት ኡራይ ኡንቱንታ፥ “ሳሮ ቢተ። ታማ ሆእተ። ካሊደ ሚተ” ጊደ፥ ኡንቱንቶ ኮሽያዋ እማና ዮፐ፥ ኡንቱንታ አይ ጎአኔ? <verse eid="JAS 2:16"/><verse number="17" style="v" sid="JAS 2:17"/>ሄዋ ድራዉ፥ አማኑ ኦሱ ባይናን ባረካ ደኦፐ ሀይቄዳዋ።<verse eid="JAS 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18"/>ሽን እት ኡራይ፥ “ነዉ አማኑ ደኤ፤ ቃይ ታዉ ኦሱ ደኤ። ኔን ነ አማኑዋ ነ ኦሱዋፐ ሻካደ ታና በሳ፤ ታንካ ታ አማኑዋ ታ ኦሱዋን ኔና በሳና” ጋና። <verse eid="JAS 2:18"/><verse number="19" style="v" sid="JAS 2:19"/>ኔን እት ጾሳይ ደእያዋ አማናሳ፤ ሄዌ ሎአ። ጻላሄቱካ ቃይ አማኒኖ፤ ያሻን ኮኮሪኖ። <verse eid="JAS 2:19"/><verse number="20" style="v" sid="JAS 2:20"/>ኔን ኤያይ! አማኑ ኦሱዋፐ ሻከቲደ ጎኤናዋ<note caller="+" style="f"><char style="fr" closed="false">2:20 </char><char style="fk" closed="false">ጎኤናዋ፦ </char><char style="ft" closed="false">ሀዋ ጉሳይ ሀይቄዳዋ ጉሳ።</char></note> ኤራናዉ ኮያይ? <verse eid="JAS 2:20"/><verse number="21" style="v" sid="JAS 2:21"/>ኑ አቡ አብራሃሞ ባረ ናኣ ይሳቃ ያርሽያ ሳኣ ቦላ ዎዳ ዎደ፥ ባረ ኦሱዋን ጽልቤኔ?<note caller="-" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="GEN 22:1-14">ዶመ 22:1-14</ref></char></note> <verse eid="JAS 2:21"/><verse number="22" style="v" sid="JAS 2:22"/>አ አማኑነ አ ኦሱ እትፐ ኦዳዋነ አ አማኑ አ ኦሱዋን ፖለቴዳዋ በእኪ? <verse eid="JAS 2:22"/><verse number="23" style="v" sid="JAS 2:23"/>ጾሳ ማጻፋይ “አብራሃሞ ጾሳ አማኔዳ። ጾሳይካ ሄዋ አዉ ጽሎተን ፓይዴዳ” ጌዳዌ ፖለቴዳ፤ ቃይ ጾሳ ዳቦ ጌተቲደ እ ጼሰቴዳ።<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="GEN 15:6">ዶመ 15:6</ref>፤ <ref loc="2CH 20:7">2 ኦዱዋ 20:7</ref>፤ <ref loc="ISA 41:8">ኢሳ. 41:8</ref></char></note> <verse eid="JAS 2:23"/><verse number="24" style="v" sid="JAS 2:24"/>አሳይ አማኖ ጻላላና ግደናን፥ ኦሱዋን ጽልያዋ ህንተ በኢታ።<verse eid="JAS 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25"/>ሄዋዳንካ ቃይ ጫራታ ራኣባ ኪተቶዋንታ ሞካደ ሀራ ኦግያና ኡንቱንታ ሞይዜዳ ዎደ፥ ባረ ኦሱዋን ጽላበይኬ?<note caller="-" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="JOS 2:1-21">ኢያሳ 2:1-21</ref></char></note><verse eid="JAS 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26"/>አያዉ ጎፐ፥ ሸምፑ ሻከቴዳ ቦላይ ሀይቄዳዋ ግድያዋዳን፥ ሄዋዳንካ ቃይ ኦሱ ሻከቴዳ አማኑ ሀይቄዳዋ።<verse eid="JAS 2:26"/></para>
  <chapter eid="JAS 2"/>
  <chapter number="3" style="c" sid="JAS 3"/>
  <para style="s1">እንጻርሳ ናግያዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1"/>ታናዳን ጾሳ ካልያዋንቶ፥ ኑን ሀራቱዋፐ አያ ፕርዳ አካናዋ ህንተ ኤርያ ድራዉ፥ ህንተፐ ጮራቱ ታማርስያዋንታ ግዶፕተ። <verse eid="JAS 3:1"/><verse number="2" style="v" sid="JAS 3:2"/>ኑን ኡባይካ ዳሮባን ባሌቶ፤ እት ኡራይ ባረ ሃሳያን ሙለካ ባላና ዮፐ፥ እ ባረና ናጋናዉ ዳንዳይያ ባል ባይና አሳ። <verse eid="JAS 3:2"/><verse number="3" style="v" sid="JAS 3:3"/>ፓራቱ ኑዉ አዛዘታና ማላ፥ ብጻላ ባርሲደ፥ ኑን ኮይያሳ ኡባ ኡንቱንታ አፌቶ። <verse eid="JAS 3:3"/><verse number="4" style="v" sid="JAS 3:4"/>በእተ፥ ማርካባቱካ ቃይ ሄዋ ኬና ዎልቃማ ግዲደ፥ ጎቱዋ ጫርኩዋን ላገቶፐካ፥ ኡንቱንታ ላግያዌ ባረዋ ኮይያሳ ዛሪደ ላግያ ቄር ጉ ምን ላገቲደ ቢኖ። <verse eid="JAS 3:4"/><verse number="5" style="v" sid="JAS 3:5"/>ሄዋዳን እንጻርሳይ ቦላ ግዶን ጉ አሳተ ግዶፐካ፥ ዳሮ ዎልቃማባን ጬቀቴ።</para>
  <para style="p" vid="JAS 3:5">ጉ ታማይ ዋኒደ ዎልቃማ ዎራ ጉዲ! አኬክተ። <verse eid="JAS 3:5"/><verse number="6" style="v" sid="JAS 3:6"/>እንጻርሳይካ ታማ ማላ። እ ኑ አሳተ ግዶን ኢታባ ኡባ ኦና ዳንዳዬ፤ አሳተ ኡባ ቱንሴ። ቃይ ኑ ደኡዋ ዎካ ታማን ጉዴ፤ ጋናምያ ታማን እ ጉደታናዋ። <verse eid="JAS 3:6"/><verse number="7" style="v" sid="JAS 3:7"/>አያዉ ጎፐ፥ ዶአቱዋ፥ ካፋቱዋ ዛርያ፥ ትራን ጎሸትያ ሾሻቱ ዛርያነ አባን ደእያ መታቱዋ ዛርያ ኡባ አሳይ አድሴዳ፤ ቃይ ኡንቱንቱካ አዴድኖ። <verse eid="JAS 3:7"/><verse number="8" style="v" sid="JAS 3:8"/>ሽን ኦንነ እንጻርሳ አድሳናዉ ዳንዳይቤና፤ እንጻርሳይ ዎያ ማርዚ ኩሜዳ ጮኡ ጌና ኢታ መታ። <verse eid="JAS 3:8"/><verse number="9" style="v" sid="JAS 3:9"/>ኑን እንጻርሳን ኑ ጎዳነ አዉዋ ጋላቴቶ፤ ቃይ አንካ ጾሳ ማላቲደ መቴዳ አሳ ሸቄቶ።<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="GEN 1:26">ዶመ 1:26</ref></char></note> <verse eid="JAS 3:9"/><verse number="10" style="v" sid="JAS 3:10"/>እት ዶናፐ ጋላታይነ ሸቃይ ከሴ። ታናዳን ጾሳ ካልያዋንቶ፥ ሄዌ ሄዋዳን ሀናናዉ በሰና። <verse eid="JAS 3:10"/><verse number="11" style="v" sid="JAS 3:11"/>ፑልቱ እት ኦላፐ ማልእያ ሃነ ጫምያ ሃ ፑልታናዉ ዳንዳዪ? <verse eid="JAS 3:11"/><verse number="12" style="v" sid="JAS 3:12"/>ታናዳን ጾሳ ካልያዋንቶ፥ ባላስያ ግያ ምይ ዎጋራ አይፋናዉ ዳንዳዪ? ዎይ ዎይንያ ቱራይ ባላስያ ግያ ም አይፋናዉ ዳንዳዪ? ማጽነ ማጽነ ግያ ሃፐካ ማልኦ ሃይ ከሳና ዳንዳየና።<verse eid="JAS 3:12"/></para>
  <para style="s1">ሳሉዋ አዳ ኤራነ ሳኣ አዳ ኤራ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13"/>ህንተ ግዶን አዳ ኤራንቻይነ አኬካንቻይ ኦኔ? ባረ ሎኦ ደኡዋን ኦሰቴዳ ባረ ኦሱዋ አዳ ኤራተፐ ይያ አሽከተን በሶ። <verse eid="JAS 3:13"/><verse number="14" style="v" sid="JAS 3:14"/>ሽን ህንተ ዎዛናን ጫምያ ቃናቲነ ይርጊ ደኦፖ። ቃይ ቱማተ ቦላካ ዎርዶቶፕተነ ኦቶረቶፕተ። <verse eid="JAS 3:14"/><verse number="15" style="v" sid="JAS 3:15"/>ሄዋ ማላ አዳ ኤራተይ ሳሉዋፐ ዎያዋ ግደና፤ ሽን ሄዌ ሳኣባ፥ አሳዋ፥ ጻላሀቱዋ። <verse eid="JAS 3:15"/><verse number="16" style="v" sid="JAS 3:16"/>አያዉ ጎፐ፥ ቃናቲነ ይርጊ ደእያ ሳን ዋላሳይነ ኢታ ኦሶ ኡባይ ደኤ። <verse eid="JAS 3:16"/><verse number="17" style="v" sid="JAS 3:17"/>ሽን ቦላፐ ይያ አዳ ኤራተይ ኡባፐ ካሰ ጌሻ። ቃይ ሳሮተ ዶስያዋ፥ አሽከነ ኤኖ ግያዋ፤ ቃይ ማሮተይነ ሎኦ አይፊ ኩሜዳዋ። ስነ ሎኦ ማላትያ ኢታተይ ባይናዋ። <verse eid="JAS 3:17"/><verse number="18" style="v" sid="JAS 3:18"/>ጽሎተ አይፊ ሳሮተ ኦያዋንቱ ሳሮተን ዘሬዳ ዘረፐ ቤቴዳ።<verse eid="JAS 3:18"/></para>
  <chapter eid="JAS 3"/>
  <chapter number="4" style="c" sid="JAS 4"/>
  <para style="s1">ሀ አላምያ ኢታተ ዶሰናን አጋናዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1"/>ኦላይነ ዋላሳይ ህንተ ግዱዋ ሀቃፐ ዪ? ኡንቱንቱ ዬዳሳይ ህንተ ቦላ ግዶን ኦለትያ ህንተ ናሸታናዉ ዎልቃማ አሙዋ አሞትያዋፐ ግደኔ? <verse eid="JAS 4:1"/><verse number="2" style="v" sid="JAS 4:2"/>ህንተ አሞቲታ፤ ሽን ደምክታ፤ ዎታ። ሎይ ኮዪታ፤ ሽን ደማናዉ ዳንዳይክታ፤ ዋላቀቲታነ ኦለቲታ። ሽን ጾሳ ዎሰና ድራዉ፥ ህንተ ኮይያዋ ደምክታ። <verse eid="JAS 4:2"/><verse number="3" style="v" sid="JAS 4:3"/>ጾሳ ዎሲታ፥ ሽን ደምክታ፤ ጋሱካ ባላ ኦግያን ዎሲታ። ሄዋ ህንተና ናሸችያዋን ፔሻናዉ ኮይያ ድራሳ። <verse eid="JAS 4:3"/><verse number="4" style="v" sid="JAS 4:4"/>ስም ዎሹምያዋንቶ፥ ሀ አላምያና ዳቦትያዌ ጾሳዉ ሞርከ ግድያዋ ኤርክቴ? አያዉ ጎፐ፥ ሀ አላምያና ዳቦታናዉ ኮይያዌ ኦንነ ጾሳና ሞርከቴ። <verse eid="JAS 4:4"/><verse number="5" style="v" sid="JAS 4:5"/>ዎይ ጾሳ ማጻፋይ፥ “ጾሳይ ኑናን ዎዳ አያናይ ዎልቃማ አሙዋ ኑዉ አሞቴ” ግያዋ ህንተንቶ ጮ ግያዋ ማላቲ? <verse eid="JAS 4:5"/><verse number="6" style="v" sid="JAS 4:6"/>ሽን ጾሳይ አ ኬካተ አደ እሜ። ሄዋ ድራዉ፥ ጾሳ ማጻፋይ፥ “ጾሳይ ኦቶረትያዋንታ እጼ፤ ሽን ባረና ካዉሽያዋንቶ አ ኬካተ እሜ” ያጌ።<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PRO 3:34">ሌም. 3:34</ref></char></note><verse eid="JAS 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7"/>ስም፥ ህንተ ጾሳዉ ሞደትተ። ያቲደ ጻላህያና ኤቀትተ፤ እ ህንተፐ ባቃታና። <verse eid="JAS 4:7"/><verse number="8" style="v" sid="JAS 4:8"/>ጾሳኮ ሺቅተ፤ እካ ህንተኮ ሺቃና። ህንተኖ ናጋራንቻቶ፥ ህንተ ኩሽያ ሜጨትተ። ላኡ ቆፋይ ደእያዋንቶ፥ ህንተ ዎዛና ጌሽተ። <verse eid="JAS 4:8"/><verse number="9" style="v" sid="JAS 4:9"/>ቱጋትተ፤ ካዮትተነ ዬክተ። ህንተ ሚቻ ዬኮ ላምተ፤ ህንተ ናሸቻካ ካዮ ላምተ። <verse eid="JAS 4:9"/><verse number="10" style="v" sid="JAS 4:10"/>ጎዳ ስንን ህንተ ሁጲያ ቶችተ፤ ቃይ እ ህንተና ቁ ቁ ኦና።<verse eid="JAS 4:10"/></para>
  <para style="s1">አሳ ቦላ ፕርደናን አጋናዋ</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11"/>ታናዳን ጾሳ ካልያዋንቶ፥ እቱ እቱዋ ዝግሮፕተ። ባረ እሻ ዝግርያዌነ አ ቦላ ፕርድያዌ ህግያ ዝግሬነ ህግያ ቦላ ፕርዴ። ኔን ህግያ ቦላ ፕርዶፐ፥ ህግያ ቦላ ፕርድያዋ ግዳሳፐ አትን፥ ህገዉ አዛዘትያዋ ግዳካ። <verse eid="JAS 4:11"/><verse number="12" style="v" sid="JAS 4:12"/>ህግያ እምያዌነ ፕርድያዌ ጾሳ ጻላላ፤ እ አሻናዉነ ይሳናዉ ዳንዳዬ፤ ሽን ነ ሾሩዋ ቦላ ፕርድያዌ ኔን ኦኔ?<verse eid="JAS 4:12"/></para>
  <para style="s1">ጬቀተናዳን እመቴዳ ዞርያ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13"/>ህንተኖ፥ “ኑን ሀቼ ዎይ ዎንት ሄ ካታማ ባና፤ ሄዋን ላይ ኡታና፤ ዛልአናነ ቃይ ሚሻ ዎሳና” ግያዋንቶ፥ በእተ።<note caller="-" style="x"><char style="xo" closed="false">4:13-14 </char><char style="xt" closed="false"><ref loc="PRO 27:1">ሌም. 27:1</ref></char></note> <verse eid="JAS 4:13"/><verse number="14" style="v" sid="JAS 4:14"/>ዎንት ህንተ ደኡ አያ ሀናነንቶነ ኤርክታ፤ ጉ ዎደዉ ህንተ ቤቲደ፥ ጉየፐ ይያ ፔኑዋ ማላ። <verse eid="JAS 4:14"/><verse number="15" style="v" sid="JAS 4:15"/>ሄዋ አጊደ፥ “ጎዳይ ጎፐ፥ ኑን ደአና፤ ሀዋ ዎይ ሄዋ ኦና” ጋናዉ በሴ። <verse eid="JAS 4:15"/><verse number="16" style="v" sid="JAS 4:16"/>ሽን ህንተ ሀእ ህንተንቱ ቃተን ጬቀቲታ፤ ሄዋ ማላ ጬቁ ኡባይ ኢታ።<verse eid="JAS 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17"/>ሄዋ ድራዉ፥ ሎኦባ ኦናዉ ኤሪደ ኦና ኡራዉ ሄዌ ናጋራ።<verse eid="JAS 4:17"/></para>
  <chapter eid="JAS 4"/>
  <chapter number="5" style="c" sid="JAS 5"/>
  <para style="s1">ዱረ አሳስ እመቴዳ ምኖ ዞርያ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1"/>ሀእካ ህንተኖ ዱረ አሳቶ፥ ህንተ ቦላ ይያ ቱጋዉ “አየ! አየ!” ያጊደ ዬክተነ ዝላልተ። <verse eid="JAS 5:1"/><verse number="2" style="v" sid="JAS 5:2"/>ህንተ ዱረተይ ባይ ድጌዳ፤ ቃይ ህንተ አፍላካ ብልአይ ም ድጌዳ። <verse eid="JAS 5:2"/><verse number="3" style="v" sid="JAS 5:3"/>ህንተ ዎርቃይነ ህንተ ብራይ ሽእ ድጌዳ። ቃይ ሄ ሽአይ ህንተ ቦላ ማርካታና፤ ህንተ ቦላካ ታማዳን ማና። ህንተ ህንተ ሚሻ ስንዉ ዳጋይ ደኢታ። <verse eid="JAS 5:3"/><verse number="4" style="v" sid="JAS 5:4"/>አኬክተ፤ ህንተ ጋደን ካ ቆይጬዳ አሳቶ ጭግቤና ክራ ሚሻይ ዋሴ፤ ኡንቱንቱ ዋሱ ዎልቃማ ጎዳ ሀይን ስሰቴዳ።<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="DEU 24:14-15">ዛረ. 24:14-15</ref></char></note> <verse eid="JAS 5:4"/><verse number="5" style="v" sid="JAS 5:5"/>ህንተዉ እንጀትና፥ ሳኣን እሻሊደ ደኤድታ፤ ሹካ ጋላሳዉ ክያዋዳን፥ ህንተ ቦላ ኬድታ። <verse eid="JAS 5:5"/><verse number="6" style="v" sid="JAS 5:6"/>ጽሎ አሳ ቦላ ፕርዴድታ፤ ቃይ አ ዎድታ፤ እ ህንተናና ኤቀተና።<verse eid="JAS 5:6"/></para>
  <para style="s1">ጎዳ ላኤን ዩሳ ዳንዳያን ናግያዋ</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7"/>ሄዋ ድራዉ፥ ታናዳን ጾሳ ካልያዋንቶ፥ ጎዳይ ያና ጋካናዉ ገንጭተ፤ ቢታ ጎሽያዌ አድልያ እራይነ አሱራ እራይ ያና ጋካናዉ ገንጪደ፥ አልኦ ካ እ ዎት ናጊደ ጋ አክንቶ በእተ። <verse eid="JAS 5:7"/><verse number="8" style="v" sid="JAS 5:8"/>ህንተካ ቃይ ገንጭተ፤ ህንተ ዎዛና ምንስተ። አያዉ ጎፐ፥ ጎዳ ዩሳይ ማታቴዳ።<verse eid="JAS 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9"/>ታናዳን ጾሳ ካልያዋንቶ፥ ጾሳይ ህንተ ቦላ ፕርደና ማላ፥ እቱ እቱዋ ቦላ ዙዙሞፕተ። በእተ፥ ፕርድያዌ ፐንግያን ኤቄዳ። <verse eid="JAS 5:9"/><verse number="10" style="v" sid="JAS 5:10"/>ታናዳን ጾሳ ካልያዋንቶ፥ ዋይያስነ ገንጫዉ ሌምሱዋ ግዴዳዋንታ፥ ጎዳ ሱንን ሃሳዬዳ ናባቱዋ ሀሳይተ። <verse eid="JAS 5:10"/><verse number="11" style="v" sid="JAS 5:11"/>በእተ፥ ዳንዳዪደ ገንጬዳዋንታ ኑን አንጀቴዳዋንታ ጌቶ። ኢዮባ ገንጫ ህንተ ስሴድታ፤ ቃይ ጎዳይ አዉ ዉርሰን እሜዳዋካ ቤድታ። አያዉ ጎፐ፥ ጎዳይ ማሮታይነ ቃረታይ ኩሜዳዋ።<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="JOB 1:21-22">ኢዮባ 1:21-22</ref>፤ <ref loc="JOB 2:10">2:10</ref>፤ <ref loc="PSA 103:8">ማዝ. 103:8</ref></char></note><verse eid="JAS 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12"/>ሽን ኡባፐ ካሰ፥ ታናዳን ጾሳ ካልያዋንቶ፥ ሳሉዋን ግድና፥ ዎይ ሳኣን ግድና፥ ዎይ ሀራ ጫቁዋን ግድና፥ አያንካ ጫቆፕተ። ሽን ጾሳ ፕርዳን ህንተ ገለናዳን፥ ህንተ የዉ ኤ ግያዋ ግዶፐ፥ “ኤ” ጊተ፤ ግደና ግያዋ ግዶፐ፥ “ግደና” ጊተ።<verse eid="JAS 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13"/>ህንተ ግዶን ዋየትያ ኡራይ ኦንነ ደኦፐ፥ ጾሳ ዎሶ፤ ናሸትያ ኡራይ ኦንነ ደኦፐ፥ የጺደ ጋላቶ። <verse eid="JAS 5:13"/><verse number="14" style="v" sid="JAS 5:14"/>ህንተፐ ሳከትያ ኡራይ ኦንነ ደኦፐ፥ አማንያ አሳ ካለያ ጭማቱዋ ባረኮ ጼሶ፤ ኡንቱንቱ ጎዳ ሱንን ዛይትያ አ ኦኪደ፥ አዉ ጾሳ ዎስኖ። <verse eid="JAS 5:14"/><verse number="15" style="v" sid="JAS 5:15"/>አማኑዋን ጾሳ ዎሴዳ ዎሳይ ሀርጋንቻ ፓና፤ ጎዳይካ አ ሀርግያፐ ደንና፤ ቃይ ናጋራ እ ኦዳዋ ግዶፐካ ጎዳይ አዉ አቶ ጋና። <verse eid="JAS 5:15"/><verse number="16" style="v" sid="JAS 5:16"/>ሄዋ ድራዉ፥ ህንተ ፓጻና ማላ፥ ህንተ ናጋራ እቱ እቶ ፓጽተነ እቱ እቶ ጾሳ ዎስተ፤ ጽሎ አሳ ዎሳይ ዎልቃማ ኦሱዋ ኦ። <verse eid="JAS 5:16"/><verse number="17" style="v" sid="JAS 5:17"/>ኤላስ ኑ ማላ አሳ። እራይ ሳኣን ቡከናዳን፥ እ ምንሲደ፥ ጾሳ ዎስና ሄዙ ላይነ ኡሱፑን አገና ሳኣን እራይ ቡክቤና።<note caller="-" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 ካታ. 17:1</ref>፤ <ref loc="1KI 18:1">18:1</ref></char></note> <verse eid="JAS 5:17"/><verse number="18" style="v" sid="JAS 5:18"/>ላኤንዋ ጾሳ እ ዎስና፥ ሳሉዋፐ እራይ ቡኬዳ፤ ሳአይካ ባረ ካ ሞኬዳ።<note caller="-" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="1KI 18:42-45">1 ካታ. 18:42-45</ref></char></note><verse eid="JAS 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19"/>ታናዳን ጾሳ ካልያዋንቶ፥ ህንተፐ ኦንነ ቱሙዋፐ ዎራ ቦፐ፥ ቃይ እቱ አ ጉየ ሄ ቱሙዋኮ ዛሮፐ፥ <verse eid="JAS 5:19"/><verse number="20" style="v" sid="JAS 5:20"/>ናጋራንቻ አ ባላ ኦግያፐ ዛርያ ኦንነ አ ሸምፑዋ ሀይቁዋፐ አሻናዋነ ዳሮ ናጋራ ካማናዋ ኤሮ።<note caller="-" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="PRO 10:12">ሌም. 10:12</ref>፤ <ref loc="1PE 4:8">1 ጰጽ. 4:8</ref></char></note><verse eid="JAS 5:20"/></para>
  <chapter eid="JAS 5"/>
</usx>
