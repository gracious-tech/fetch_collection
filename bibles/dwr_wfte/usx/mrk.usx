<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Dawuro Full Bible Ethiopic Version</book>
  <para style="h">ማርቆሳ ምሽራቹዋ</para>
  <para style="toc1">ማርቆስ ጻፌዳ ምሽራቹዋ ቃላ</para>
  <para style="toc2">ማርቆሳ ምሽራቹዋ</para>
  <para style="toc3">ማር.</para>
  <para style="mt1">ማርቆስ ጻፌዳ</para>
  <para style="mt2">ምሽራቹዋ ቃላ</para>
  <para style="imt">ገሉዋ</para>
  <para style="ip">ማርቆስ ጻፌዳ ምሽራቹ ኮይሮ ዶሚድካ፥ “ሀዌ ጾሳ ናኣ የሱስ ክርስቶሳ ምሽራቹዋ ቃላዉ ዶመ” ያጌ። ሀ ምሽራቹዋ ቃላ ግዶን የሱስ ኦሱዋ አሳነ ማታይ ደእያ አሳ ግዲደ ሺቄዳ። የሱሳ ማታይ አ ትምርትያን፥ ጻላህያ ጭታ ቦላ አዉ ደእያ ዎልቃንነ አሳ ናጋራ አቶ ግያዋን በኤቴዳ። የሱስ፥ “ታን አሳ ናአይ ዬዳዌ፥ አሳ፥ ናጋራ አይለተፐ ላአ ከሳናዉ ታ ደኡዋ አደ እማናሳ” ያጊደ እ ባረ ሁጰዉ ሃሳዬዳ።</para>
  <para style="ip">ማርቆስ የሱሳ ታርክያ ሱረነ ዎልቃ ኩሜዳ ኦግያን ኦዴዳ። እ ጋናዉ ኮዮ ቆፋይካ የሱሳ ቃላነ ትምርትያ ግደናን እ ኦዳ ማላልስያ ኦሳቱዋ ቦላና። ጻማቅያ ዮሃንሳ ታርክያ፥ የሱሳ ጽንቃታነ ፓጭያ ቃንን ኤርስ ስሚደ፥ የሱሳ ትምርትያነ ፓዋባ አሲደ ኦዴዳ። ዎድያፐ ጉይያን የሱሳ ካልያዋንቱ አ ሎይ ኤር ቤዳዋ ኬና አናና ኤቀትያዋንቱ አ ሎይ እጼድኖ። ዉርሰ ሸምፓቱ የሱሳ ደኡዋን ዉርሰ ሳምንታ ግዶን ፖለቴዳ ኦሳቱዋ፤ ሄዋንቱካ አ ካቀባነ አ ደንዱዋባ ኦድያዋንታ።</para>
  <para style="ip">ማርቆሳ ምሽራቹዋ ዉርሰን ቅንፍያ ግዶን ደእያ 16:9-20 ፓይዳቱ ጌሻ ቃላ እት እት ብለ ጻላላን ደእያዋንታ።</para>
  <para style="iot">ሸምፓቱዋ ኡባቶ እመቴዳ ቃን ቆፋቱዋ</para>
  <para style="io1">ምሽራቹዋ ዶመ <char style="ior"><ref loc="MRK 1:1-13">1:1-13</ref></char></para>
  <para style="io1">የሱስ ኦሱዋ ጋሊላን ዶሜዳዋ <char style="ior"><ref loc="MRK 1:14-9:50">1:14—9:50</ref></char></para>
  <para style="io1">የሱስ የሩሳላመን ኦዋ <char style="ior"><ref loc="MRK 10:1-52">10:1-52</ref></char></para>
  <para style="io1">የሩሳላመንነ እዝ ዩሹዋን የሱሳ ዉርሰ ሳምንታ <char style="ior"><ref loc="MRK 11:1-15:47">11:1—15:47</ref></char></para>
  <para style="io1">ጎዳ የሱሳ ደንዱዋ <char style="ior"><ref loc="MRK 16:1-8">16:1-8</ref></char></para>
  <para style="io1">ሀይቁዋፐ ደንዴዳ ጎዳ ቆንጨነ ሳሉዋ ቡሳ <char style="ior"><ref loc="MRK 16:9-20">16:9-20</ref></char></para>
  <chapter number="1" style="c" sid="MRK 1"/>
  <para style="s1">ጻማቅያ ዮሃንሳ አዋዩዋ</para>
  <para style="r">(<ref loc="MAT 3:1-12">ማቶሳ 3:1-12</ref>፤ <ref loc="LUK 3:1-18">ሉቃሳ 3:1-18</ref>፤ <ref loc="JHN 1:19-28">ዮሃ. 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1"/>ጾሳ ናኣ<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fq" closed="false">ጾሳ ናኣ፦ </char><char style="ft" closed="false">በን ጻፈቴዳ እት እት ብለን ሀዌ ባዋ።</char></note> የሱስ ክርስቶሳ ዎንጋላ ምሽራቹዋ ዶመ።<verse eid="MRK 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 1:2"/>ናብያ እስያስ ጻፌዳ ማጻፋን ጾሳይ፥</para>
  <para style="q1" vid="MRK 1:2">“በአ፤ ታ ኪትያዋ ታን ኔፐ ስንዉ የዳና።</para>
  <para style="q2" vid="MRK 1:2">እ ነዉ ኦግያ ከሳናዋ።<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="MAL 3:1">ሚልክ. 3:1</ref></char></note><verse eid="MRK 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3"/>እት ብታኒ ቢታ ባዙዋን ባረ ኮሻ ቁ ኦደ፥</para>
  <para style="q2" vid="MRK 1:3">‘ጎዳ ኦግያ ጊግስተ።</para>
  <para style="q1" vid="MRK 1:3">እ ሀመታና ሎሱዋካ፥</para>
  <para style="q2" vid="MRK 1:3">አዉ ሱርስተ’ ጌዳዋዳን”</para>
  <para style="m" vid="MRK 1:3">ሀኔዳ።<verse eid="MRK 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4"/>ጻማቅያ ዮሃንስ አሳ ጻማቂድነ፥ “ጾሳይ ህንተ ናጋራ አቶ ጋና ማላ፥ ህንተንቱ ናጋራፐ ስሚደ ጻማቀትተ” ያግ ቃላ ኦዲደ ቢታ ባዙዋን ከስ ዎዳ። <verse eid="MRK 1:4"/><verse number="5" style="v" sid="MRK 1:5"/>ይሁዳ ጋድያን ደእያ አሳይ ኡባይነ የሩሳላመ ካታማ አሳይ ኡባይ ዮሃንሳኮ ዬድኖ። ባረንቱ ናጋራካ ፓጽና፥ ዮሃንስ ሄ አሳ ዮርዳኖሳ ሻፋን ጻማቄዳ።<verse eid="MRK 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6"/>ዮሃንስ ጋሉዋ እስክያፐ ዳደቴዳ ማዩዋ ማዪደ፥ ባረ ጼሳን ዳፉዋ ዳንጬዳ፤ ቃይ ቦልያነ ዎራ ኤሳ ሜዳ።<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 ካታ. 1:8</ref></char></note> <verse eid="MRK 1:6"/><verse number="7" style="v" sid="MRK 1:7"/>ዮሃንስ ቃላ ኦዲደ፥ “ታፐ ጉየና ዳሮ ምንያዌ ዬ፤ ሀራይ አቶ፥ አ ጫማካ ገድያፐ ከሳ ቶካናዉ ታን በስከ። <verse eid="MRK 1:7"/><verse number="8" style="v" sid="MRK 1:8"/>ታን ህንተንታ ሃን ጻማቃይ፤ ሽን እ ህንተንታ ጌሻ አያናን ጻማቃናዋ” ያጌዳ።<verse eid="MRK 1:8"/></para>
  <para style="s1">የሱስ ጻማቀቴዳዋነ ፓጨቴዳዋ</para>
  <para style="r">(<ref loc="MAT 3:13-17">ማቶሳ 3:13-17</ref>፤ <ref loc="MAT 4:1-11">4:1-11</ref>፤ <ref loc="LUK 3:21-22">ሉቃሳ 3:21-22</ref>፤ <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9"/>የሱስ ሄ ዎደ ጋሊላ ጋድያን ደእያ ናዝሬተ ካታማፐ ዪና፥ ዮሃንስ ዮርዳኖሳ ሻፋን አ ጻማቄዳ። <verse eid="MRK 1:9"/><verse number="10" style="v" sid="MRK 1:10"/>የሱስ ሃፐ ከሶሳና ሳሉ ዶየትሺናነ ጌሻ አያናይ ባረ ቦላ ሀራጵያዳን ዎሽን በኤዳ። <verse eid="MRK 1:10"/><verse number="11" style="v" sid="MRK 1:11"/>ቃይ ሳሉዋፐ፥ “ታን ሲቅያ ታ ናአይ ኔና፤ ታና ነባይ ናሸቼ” ያግያ ቃላይ ስሰቴዳ።<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="GEN 22:2">ዶመ 22:2</ref>፤ <ref loc="PSA 2:7">ማዝ. 2:7</ref>፤ <ref loc="ISA 42:1">ኢሳ. 42:1</ref>፤ <ref loc="MAT 3:17">ማቶሳ 3:17</ref>፤ <ref loc="MAT 12:18">12:18</ref>፤ <ref loc="MRK 9:7">ማር. 9:7</ref>፤ <ref loc="LUK 3:22">ሉቃሳ 3:22</ref></char></note><verse eid="MRK 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12"/>ኤለካ ጌሻ አያናይ አሳይ ባይና መላ ሳ አ የዴዳ። <verse eid="MRK 1:12"/><verse number="13" style="v" sid="MRK 1:13"/>የሱስ አሳይ ባይና ሳን ባረና ሴጻናይ ፓጭሽን፥ ኦይታሙ ጋላሳ ጋዳ፤ ዱኣናካ ደኤዳ፤ ኪታንቻቱካ ዪደ፥ አዉ ኦድኖ።<verse eid="MRK 1:13"/></para>
  <para style="s1">የሱስ ሞልያ ኦይቂያ ኦይዱ አሳቱዋ ጼሴዳ</para>
  <para style="r">(<ref loc="MAT 4:12-22">ማቶሳ 4:12-22</ref>፤ <ref loc="LUK 4:14-15">ሉቃሳ 4:14-15</ref>፤ <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14"/>ዮሃንስ ቃሸቶዋፐ ጉይያን፥ የሱስ ጾሳ ካዉተ ዎንጋላ ምሽራቹዋ ኦዲደ፥ ጋሊላ ጋድያ ቢደ፥ <verse eid="MRK 1:14"/><verse number="15" style="v" sid="MRK 1:15"/>“ዎዲ ጋኬዳ፤ ጾሳ ካዉተይካ ማታቴዳ። ህንተንቱ ናጋራፐ ስሚደ፥ ዎንጋላ ምሽራቹዋ አማንተ” ያጌዳ።<verse eid="MRK 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16"/>የሱስ ጋሊላ አባ ላንቂያና አደ፥ ሞልያ ኦይቂያዋንታ፥ ስሞናነ አ እሻ እንድራሳ፥ ባረንቱ ዳባ አባን የግያዋንታ በኤዳ። <verse eid="MRK 1:16"/><verse number="17" style="v" sid="MRK 1:17"/>ያቲደ ኡንቱንታ፥ “ታና ካልተ፤ ታን ህንተንታ ሞልያ ኦይቂያዋዳን አሳ ታኮ አህያ ኦግያ ታማርሳና” ያጌዳ። <verse eid="MRK 1:17"/><verse number="18" style="v" sid="MRK 1:18"/>ሄዋፐ ጉይያን ኡንቱንቱ ኤለካ ባረንቱ ዳባ አጊደ፥ የሱሳ ካሌድኖ።<verse eid="MRK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19"/>የሱስ ጉ ስንዉኮ ቢደ፥ ዛብድዮሳ ናና ላኡ እሻቱዋ፥ ያቆባነ ዮሃንሳ ዎንግርያ ግዶን ባረንቱ ዳባ ጊግስያዋንታ በኤዳ። <verse eid="MRK 1:19"/><verse number="20" style="v" sid="MRK 1:20"/>እ በኦሳንካ ኡንቱንታ ጼስና፥ ባረንቱ አዉዋ፥ ዛብድዮሳ፥ አ ኦሳንቻቱዋና ዎንግርያ ግዶን አጊደ፥ የሱሳ ካሊደ ቤድኖ።<verse eid="MRK 1:20"/></para>
  <para style="s1">ኢታ አያናይ ኦይቄዳ ብታኒ ፓጼዳ</para>
  <para style="r">(<ref loc="LUK 4:31-37">ሉቃሳ 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21"/>ኡንቱንቱ ቅፍርናሆማ ጌተትያ ካታማ ዪደ ገሌድኖ፤ የሱስ ሳምባታ ጋላሳይ ጋኮ ዎደ፥ አይሁዳ ዎሳ ጎለ ገሊደ፥ ታማርሱዋ ዶም አጌዳ። <verse eid="MRK 1:21"/><verse number="22" style="v" sid="MRK 1:22"/>ባረዉ ማታይ ደእያ አሳዳን፥ አሳ እ ታማርስያዋፐ አትን፥ ህግያ ታማርስያዋንቱዳን ታማርሰና ድራዉ፥ አሳይ አ ትምርትያን ማላለቴዳ።<verse eid="MRK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23"/>ሄ ዎደ ኢታ አያናይ ደእያ እት ብታኒ አይሁዳ ዎሳ ጎለ ገሎሳናካ ባረ ኮሻ ቁ ኦደ፥ <verse eid="MRK 1:23"/><verse number="24" style="v" sid="MRK 1:24"/>“ናዝሬትያ የሱሳ፥ ኔን ኑፐ አያ ኮያይ? ኑና ይሳናዉ ያድ? ኔን ኦነንቶ ኤራይ፤ ኔን ጾሳፐ ኪተቴዳ ጌሻ ግድኪ!” ያጌዳ።<verse eid="MRK 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25"/>የሱስ ሄ ኢታ አያና፥ “ሀይዛ፤ ብታንያፐ ከሳ” ያጊደ አዛዜዳ።<verse eid="MRK 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26"/>ኢታ አያናይ ብታንያ ቡጨሬ፥ ዳሪ ዋስሲደ፥ አፐ ከስ አጌዳ። <verse eid="MRK 1:26"/><verse number="27" style="v" sid="MRK 1:27"/>አሳይ ኡባይ ማላለቲደ፥ “ሀዌ አዬ? ሀ ብታኒ ባረ ማታን ሀራይ አቶ፥ ኢታ አያናቱዋካ አዛዜዳ፤ ኡንቱንቱካ ቃይ አዉ አዛዘቲኖ፤ ሀዌ አይበ ኦራ ትምርቴ?” ያጊደ፥ ባረ ግዶን እቱ እቱዋ ኦቼዳ።<verse eid="MRK 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28"/>ጋሊላ ጋድያን ደእያ ሄራይ ኡባይ ኤለካ የሱሳ ዋርያ ሲሴድኖ።<verse eid="MRK 1:28"/></para>
  <para style="s1">የሱስ ዳሮ ሀርጋንቻቱዋ ፓዳ</para>
  <para style="r">(<ref loc="MAT 8:14-17">ማቶሳ 8:14-17</ref>፤ <ref loc="LUK 4:38-41">ሉቃሳ 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29"/>የሱስ አይሁዳ ዎሳ ጎልያፐ ከሶሳን፥ ያቆባናነ ዮሃንሳና እትፐ ስሞናነ እንድራሳ ሶይ ብ አጌዳ። <verse eid="MRK 1:29"/><verse number="30" style="v" sid="MRK 1:30"/>ስሞና ቦሎታታ ቆጹዋ ሀርጋደ ግሴዳዉንባ እ ያ ጋኮሳናካ አዉ ኦድ አጌድኖ። <verse eid="MRK 1:30"/><verse number="31" style="v" sid="MRK 1:31"/>እ እዝኮ ሺቂደ፥ እዝ ኩሽያ ኦይቂደ፥ እዞ ደን ኤሴዳ፤ ቆጹ እዞ አግና፥ እዛ ኡንቱንቶ ኦዱ።<verse eid="MRK 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32"/>ሀርጌዳ አሳ ኡባነ ኢታ አያናቱ ኦይቄዳ አሳ ኡባ ኦማርስ አዋይ ዉሌዳዋፐ ጉይያን፥ አሳይ አኮ አሄድኖ። <verse eid="MRK 1:32"/><verse number="33" style="v" sid="MRK 1:33"/>ካታማን ደእያ አሳይ ኡባይ ሄ ካርያ ሺቄዳ። <verse eid="MRK 1:33"/><verse number="34" style="v" sid="MRK 1:34"/>የሱስ ዱማ ዱማ ሀርግያን ኦይቀቴዳ ጮራ አሳ ፓደ፥ ጮራ ጻላሀቱዋካ ከሴዳ። እ ክርስቶሳ ግድያዋ ኢታ አያናቱ ኤሬዳ ድራዉ፥ ኡንቱንታ ሃሳይሰናን ድጌዳ።<verse eid="MRK 1:34"/></para>
  <para style="s1">የሱስ ጋሊላን ታማርሴዳ</para>
  <para style="r">(<ref loc="LUK 4:42-44">ሉቃሳ 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35"/>የሱስ ጉራ ዎንቱማን ደንዲደ፥ ሶይፐ ከሲደ፥ አሳይ ባይናሳ ቢደ ያን ጾሳ ዎሴዳ። <verse eid="MRK 1:35"/><verse number="36" style="v" sid="MRK 1:36"/>ስሞንነ አናና ደእያዋንቱ አ ኮዪደ ቤድኖ። <verse eid="MRK 1:36"/><verse number="37" style="v" sid="MRK 1:37"/>ኡንቱንቱ አ ደሚደ፥ “አሳይ ኡባይ ኔና ኮዬ” ያጌድኖ።<verse eid="MRK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38"/>ሄዋፐ ጉየ የሱስ ቃይ ኡንቱንታ፥ “ሄዋ ሄራን ደእያ ሀራ ካታማቱዋ ቦይተ፤ ታን ሄዋን ቃላ ኦዳናዉ በሴ፤ አያዉ ጎፐ፥ ታን ዬዳዌ ሄዋሳ” ያጌዳ። <verse eid="MRK 1:38"/><verse number="39" style="v" sid="MRK 1:39"/>አይሁዳ ዎሳ ጎለቱዋን ቃላ ኦዲድነ ኢታ አያናቱዋ ከሲደ፥ ጋሊላ ጋድያ ኡባ ዩዬዳ።<verse eid="MRK 1:39"/></para>
  <para style="s1">የሱስ ኦሉ ኦይቄዳ ብታንያ ፓዳ</para>
  <para style="r">(<ref loc="MAT 8:1-4">ማቶሳ 8:1-4</ref>፤ <ref loc="LUK 5:12-17">ሉቃሳ 5:12-17</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40"/>ኦሉ ኦይቄዳ እት ብታኒ የሱሳኮ ዪደ፥ አ ስንን ጉልባቲደ፥ “ኔን ኮዮፐ፥ ታና ጌሻ ፓናዉ<note caller="+" style="f"><char style="fr" closed="false">1:40 </char><char style="fk" closed="false">ታና ጌሻ ፓ፦ </char><char style="ft" closed="false">ሀዋ ጉሳይ፥ ሀ ሀርጊ ቆፈቴዳዌ ላመታናዉ ዳንዳየና ኤረቴዳ ጋደ ዎጋነ ማራን፥ ሀራ አሳ ቆፋን እት አሳይ ጌሻ ግደና ጋና ማላ ኦድያዋ።</char></note> ዳንዳያ” ያጊደ ዎሴዳ።<verse eid="MRK 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41"/>የሱስ አዉ ቃረቴዳ፤ ባረ ኩሽያ የድ፥ አ ቦቺደ፥ “ታን ኮያይ፤ ጌያ፤ ፓጻ!” ያጌዳ። <verse eid="MRK 1:41"/><verse number="42" style="v" sid="MRK 1:42"/>ኤለካ ኦሉ ብታንያ የድ አግና፥ ብታኒ ጌይ ፓጽ አጌዳ። <verse eid="MRK 1:42"/><verse number="43" style="v" sid="MRK 1:43"/>የሱስ ዳሪ ሀንቀቲደ፥ ኤለካ አ ከስ የዴዳ። <verse eid="MRK 1:43"/><verse number="44" style="v" sid="MRK 1:44"/>እ ብታንያ፥ “ኔና ኤራ! ሀዋ ኦስነ ኦዶፓ፤ ሽን ባደ ነ ቦላ ቄሳ በሳ፤ ቃይ ኔን ሀእ ጌሻ ግዴዳዋ አሳ ኤርሳናዉ፥ ሙሴ አዛዜዳ ያርሹዋ ያርሻ” ያጌዳ።<verse eid="MRK 1:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45"/>ሽን ብታኒ ቢደ፥ የዉዋ ኡባ ሳን አሳ ኡባዉ ኦዱዋነ ላለ ዶሜዳ፤ ሄዋ ድራዉ፥ የሱስ ቆንጭያ ከሲደ፥ ካታማ ገላናዉ ዳንዳይቤና፤ ሽን አሳይ ባይናሳ ጋጻን ደኤዳ፤ ቃይ አሳይ ኡባ ሳፐ አኮ ዬድኖ።<verse eid="MRK 1:45"/></para>
  <chapter eid="MRK 1"/>
  <chapter number="2" style="c" sid="MRK 2"/>
  <para style="s1">የሱስ ቦላይ ስሌዳ ብታንያ ፓዳ</para>
  <para style="r">(<ref loc="MAT 9:1-8">ማቶሳ 9:1-8</ref>፤ <ref loc="LUK 5:17-26">ሉቃሳ 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1"/>አማሬዳ ጋላሳፐ ጉይያን፥ “የሱስ ቅፍርናሆማ ጉየ ስሚደ፥ ሶይን ደኤ” ግያ ሃሳያይ ስሰቴዳ። <verse eid="MRK 2:1"/><verse number="2" style="v" sid="MRK 2:2"/>ጎሊ አከናን እጽና፥ ሀራይ አቶ፥ ካሪካ ኡንአና ጋካናዉ ጮራ አሳይ ሺቄዳ፤ ሄዋንቶ የሱስ ቃላ ኦዴ። <verse eid="MRK 2:2"/><verse number="3" style="v" sid="MRK 2:3"/>ኦይዱ አሳቱ ቦላይ ስሌዳ እት ብታንያ ቶኪደ፥ አኮ አሄድኖ። <verse eid="MRK 2:3"/><verse number="4" style="v" sid="MRK 2:4"/>አሳይ ጮሬዳ ድራዉ፥ ብታንያ የሱሳኮ አፋናዉ ኡንቱንቶ ዳንዳየተናን እጽና፥ የሱስ ደእያ ባጋና ጎልያ ቃሪደ፥ ካራ ሉኬድኖ፤ ሄ ሉኬዳሳና ብታንያ እ ግሴዳ ሻንቻማና ዱገ ዎድኖ። <verse eid="MRK 2:4"/><verse number="5" style="v" sid="MRK 2:5"/>የሱስ ኡንቱንቱ አማኑዋ በኢደ፥ ሄ ቦላይ ስሌዳ ብታንያ፥ “ታ ናአዉ፥ ነ ናጋራይ አቶ ጌተቴዳ” ያጌዳ።<verse eid="MRK 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6"/>ህግያ ታማርስያዋንቱፐ ሄዋን ኡቴዳ እቱ እቱ ባረንቱ ዎዛናን፥ <verse eid="MRK 2:6"/><verse number="7" style="v" sid="MRK 2:7"/>“ላ ሀ ብታኒ ሀዋ ማላ ኢታባ ጾሳ ቦላ አያዉ ሃሳዪ? ጾሳ ጻላላፐ አትን፥ ሀራይ ኦኔ ናጋራ አቶ ጋናዉ ዳንዳይያዌ?” ያጊደ ቆፔድኖ።<verse eid="MRK 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8"/>ኡንቱንቱ ባረንቱ ዎዛናን ሄዋዳን ቆፖዋ የሱስ ኤለካ ባረ አያናን ኤሪደ፥ ኡንቱንታ “ህንተንቱ ህንተ ዎዛናን አያዉ ሄዋዳን ቆፒቴ? <verse eid="MRK 2:8"/><verse number="9" style="v" sid="MRK 2:9"/>ቦላይ ስሌዳ ብታንያ፥ ‘ነ ናጋራይ አቶ ጌተቴዳ’ ግያዌ ማቴዬ? ዎይ፥ ‘ደንዳ ኤቃደ ነ ሻንቻማ ቶካደ ሀመታ’ ግያዌ ማቴ? <verse eid="MRK 2:9"/><verse number="10" style="v" sid="MRK 2:10"/>ሽን ታን፥ አሳ ናአዉ፥ ሳኣ ቦላን ናጋራ አቶ ጋናዉ ማታይ ደእያዋ ታን ህንተንታ ኤርሳና” ያጊደ ሄ ቦላይ ስሌዳ ብታንያ፥ <verse eid="MRK 2:10"/><verse number="11" style="v" sid="MRK 2:11"/>“ኔና ጋይ፤ ደንዳ ኤቃ፤ ያታደ ነ ሻንቻማ ቶካደ ነ ሶይ ባ” ያጌዳ።<verse eid="MRK 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12"/>ብታኒ ኤለካ ደንድ ኤቂደ፥ ባረ ሻንቻማ ቶኪደ፥ አሳይ ኡባይ ጼልሽን ቢና አሳይ ኡባይ ማላለቲደ፥ “ኑን ሀዋ ማላባ ኡባካ በእ ኤሮኮ” ያጊደ ጾሳ ጋላቴድኖ።<verse eid="MRK 2:12"/></para>
  <para style="s1">የሱስ ሌዊያ ጼሴዳ</para>
  <para style="r">(<ref loc="MAT 9:9-13">ማቶሳ 9:9-13</ref>፤ <ref loc="LUK 5:27-32">ሉቃሳ 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13"/>የሱስ ጉጅካ ጋሊላ አባ ዶና ቤዳ፤ አሳይ ኡባይ አኮ ዬዳዋንታ ታማርሴዳ። <verse eid="MRK 2:13"/><verse number="14" style="v" sid="MRK 2:14"/>ሄዋና አደ፥ እልፕዮሳ ናኣ ሌዊያ፥ ግያዌ ቃራጻ ቃንጽያ ሳን ኡቴዳዋ ደሚደ፥ “ታና ካላ” ያጌዳ። ሄዋፐ ጉየ ሌዊ ደንድ ኤቂደ፥ አ ካሌዳ።<verse eid="MRK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15"/>የሱስ ቁማ ማናዉ ሌዊያ ሶይን ኡቴዳ ዎደ፥ ቃራጻ አክያ ጮራ አሳይነ ናጋራንቻቱ አናናነ አ ካልያዋንቱና እትፐ ኡቴድኖ። አ ካልያዋንቱ ግዶን ሄዋንቱ ማላ አሳቱ ዳሬድኖ። <verse eid="MRK 2:15"/><verse number="16" style="v" sid="MRK 2:16"/>ህግያ ታማርስያ እት እት ፓርሳዋቱ የሱስ ናጋራንቻቱዋናነ ቃራጻ አክያዋንቱና ቁማ ሚሽን በኢደ፥ “እ አያዉ ናጋራንቻቱዋናነ ቃራጻ አክያዋንቱና ቁማ ሚ?” ያጊደ፥ አ ካልያዋንታ ኦቼድኖ።<verse eid="MRK 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17"/>የሱስ ኡንቱንቱ ግያዋ ስሲደ፥ “ሀርጋንቻቱዋፐ አትን፥ ፓጻ አሳዉ አክሚ ኮሸና፤ ታን ናጋራንቻቱዋ ጼሳናዉ ዬዳዋፐ አትን፥ ጽላቱዋ ጼሳናዉ ያበይከ” ያጊደ ኡንቱንቶ ዛሬዳ።<verse eid="MRK 2:17"/></para>
  <para style="s1">ጾማባ ኤራናዉ ሺቄዳ ኦሻ</para>
  <para style="r">(<ref loc="MAT 9:14-17">ማቶሳ 9:14-17</ref>፤ <ref loc="LUK 5:33-39">ሉቃሳ 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18"/>ጻማቂያ ዮሃንሳ ካልያዋንቱነ ፓርሳዋቱ ጾሚኖ፤ አማሬዳ አሳቱ የሱሳኮ ዪደ፥ “ዮሃንሳ ካልያዋንቱነ ፓርሳዋቱዋ ካልያዋንቱ ጾሚኖ፤ ሽን ኔና ካልያዋንቱ አያዉ ጾምክኖ?” ያጌድኖ።<verse eid="MRK 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19"/>የሱስ ኡንቱንታ “ቡላቻ ዬዳ አሳቱ ማቻቶ አክያዌ ባረንቱና ደእሽን፥ ጾማናዉ ዳንዳዪኖ? ማቻቶ አክያዌ ኡንቱንቱና ደእሽን፥ ጾማናዉ ዳንዳይክኖ። <verse eid="MRK 2:19"/><verse number="20" style="v" sid="MRK 2:20"/>ሽን ማቻቶ አክያዋ ኡንቱንቱ ማታፐ አፋና ዎዲ ያናዋ፤ ኡንቱንቱ ሄ ዎደ ጾማናዋንታ።<verse eid="MRK 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21"/>“ኤጫ ማዩዋ ቦላ ኦራ ፍያ ዎ ስክያ አሳይ ባዋ፤ ኤጫ ዎ ስኮፐ፥ ኦራ ፊ ኤጫ ማዩዋ ፔሬ፤ ፔይካ ኮይሮዋፐ ዳራና። <verse eid="MRK 2:21"/><verse number="22" style="v" sid="MRK 2:22"/>ቃይ ሆኦ ዎይንያ ኤሳ ኤጫ ኦጎሩዋን ናእያ አሳይ ባዋ፤ ሽን ናኦፐ፥ ሄ ዎይንያ ኤሳይ ኦጎሩዋ ዳኬ፤ ባረዉካ ዎፈቴ፤ ኦጎሩካ ባዬ፤ ሽን ሆኦ ዎይንያ ኤሳ ኦራ ኦጎሩዋን ናኤቴ” ያጌዳ።<verse eid="MRK 2:22"/></para>
  <para style="s1">ሳምባታባ ኤራናዉ ሺቄዳ ኦሻ</para>
  <para style="r">(<ref loc="MAT 12:1-8">ማቶሳ 12:1-8</ref>፤ <ref loc="LUK 6:1-5">ሉቃሳ 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23"/>የሱስ እት ሳምባታ ጋላስ ትሻ ባንጋ ግዶና አሽን፥ አ ካልያዋንቱና አናና ቢደ፥ ባንጋ ትሻፐ ዱሳ ዶሜድኖ።<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="DEU 23:25">ዛረ. 23:25</ref></char></note> <verse eid="MRK 2:23"/><verse number="24" style="v" sid="MRK 2:24"/>ፓርሳዋቱ የሱሳ፥ “በአ፤ ኔና ካልያዋንቱ ሳምባታ ጋላስ ህገ ግደናባ አያዉ ኦኖ?” ያጌድኖ።<verse eid="MRK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25"/>የሱስ ኡንቱንታ፥ “ዳዊተ ኮሻቲደ፥ ምያባ ኮዬዳ ዎደ፥ ባረናና ደእያዋንቱና ኦዳዋ ኡባካ ናባብ በይክቴ?<note caller="-" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 ሳሜላ 21:1-6</ref></char></note> <verse eid="MRK 2:25"/><verse number="26" style="v" sid="MRK 2:26"/>አብያታር ቄሳቶ ኡባቶ ካፖ ግዴዳ ዎደ፥ ዳዊተ ጾሳ ጎልያ ገሊደ፥ ቄሳቱዋ ጻላላይ ማናፐ አትን፥ ኦንነ ማናዉ ህገ ግደናዋ ጎዳ ስንን ዎዳ ቁማ ሚደ፥ ባረናና ደእያዋንቶካ እሜዳ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="LEV 24:9">ዎጋ 24:9</ref></char></note><verse eid="MRK 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27"/>ቃይካ የሱስ ኡንቱንታ፥ “ሳምባታይ አሳዉ መቴዳዋፐ አትን፥ አሳይ ሳምባታዉ መትቤና። <verse eid="MRK 2:27"/><verse number="28" style="v" sid="MRK 2:28"/>ሄዋ ድራዉ፥ ታን፥ አሳ ናአይ፥ ሀራይ አቶ፥ ሳምባታዉካ ጎዳ” ያጌዳ።<verse eid="MRK 2:28"/></para>
  <chapter eid="MRK 2"/>
  <chapter number="3" style="c" sid="MRK 3"/>
  <para style="s1">ኩሺ ስሌዳ ብታንያ</para>
  <para style="r">(<ref loc="MAT 12:9-14">ማቶሳ 12:9-14</ref>፤ <ref loc="LUK 6:6-11">ሉቃሳ 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1"/>የሱስ አይሁዳ ዎሳ ጎልያ ሽረትካ ገሌዳ፤ ሄዋን ኩሺ ስሌዳ እት ብታኒ ደኤ። <verse eid="MRK 3:1"/><verse number="2" style="v" sid="MRK 3:2"/>እት እት አሳይ የሱሳ ሞታናዉ ኮዪደ፥ ኩሺ ስሌዳ ብታንያ ሳምባታን እ ፓፐ በአናዉ ናጌ። <verse eid="MRK 3:2"/><verse number="3" style="v" sid="MRK 3:3"/>የሱስ ሄ ኩሺ ስሌዳ ብታንያ፥ “ደንዳ ኤቃደ ስንዉ ሃያ” ያጌዳ። <verse eid="MRK 3:3"/><verse number="4" style="v" sid="MRK 3:4"/>ሄዋፐ ጉይያን አሳ፥ “ሳምባታን ሎኦባ ኦያዌ ዎጌየ ኢታባ ኦያዌ ዎጌ? አሳ ሸምፑዋ አሽያዌ ዎጌየ ዎያዌ ዎጌ?” ያጊደ ኦቼዳ።</para>
  <para style="p" vid="MRK 3:4">ሽን አሳይ ጮኡ ጌዳ። <verse eid="MRK 3:4"/><verse number="5" style="v" sid="MRK 3:5"/>የሱስ ሀንቀቲደ፥ ኡንቱንታ ዩሽ አ ጼሊደ፥ ኡንቱንቱ ኦድና ስሰናዋንታ ግድያ ድራዉ፥ ኡንቱንቶ ዳሪ ካዮቴዳ፤ ሄ ብታንያ፥ “ነ ኩሽያ ፕድ ኦ” ያጌዳ፤ ብታኒ ፕድ ኦና፥ አ ኩሺ ፓጽ አጌዳ። <verse eid="MRK 3:5"/><verse number="6" style="v" sid="MRK 3:6"/>ፓርሳዋቱ አይሁዳ ዎሳ ጎልያፐ ካረ ከሲደ፥ የሱሳ ዎት ዎነንቶ ሄሮድሳና ደእያዋንቱና ማቀቴድኖ።<verse eid="MRK 3:6"/></para>
  <para style="s1">አሳይ አባ ላንቂያን የሱሳኮ ሺቄድኖ</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7"/>የሱስ ባረና ካልያዋንቱና ጋሊላ አባ ቤዳ፤ ጋሊላፐ ጮራ አሳይ አ ካሌዳ። <verse eid="MRK 3:7"/><verse number="8" style="v" sid="MRK 3:8"/>ቃይካ ጮራ አሳይ ይሁዳፐ፥ የሩሳላመፐ፥ ኤዶምያሳፐ፥ ዮርዳኖሳ ሻፋፐ ሄፍን ባጋፐ፥ ጺሮሳ ካታማፐነ ሲዶና ካታማፐ የሱስ ኦዳዋ ስሲደ፥ አኮ ዬዳ። <verse eid="MRK 3:8"/><verse number="9" style="v" sid="MRK 3:9"/>የሱስ ጮራ አሳይ ባረና ሱግ ኡንኤና ማላ፥ ባረና ካልያዋንታ ዎንግርያ ባረዉ ጋምኤና ማላ አዛዜዳ። <verse eid="MRK 3:9"/><verse number="10" style="v" sid="MRK 3:10"/>ዳሮ አሳ እ ፓዳ ድራዉ፥ ሀርግያ አሳይ ኡባይ አ ቦቻናዉ ሱገረቴ። <verse eid="MRK 3:10"/><verse number="11" style="v" sid="MRK 3:11"/>ኢታ አያናይ ደእያ አሳቱካ አ በኤዳ ዎደ ኡባን አ ስንን ጉፋኒደ፥ ባረንቱ ቃላ ቁ ኦደ፥ “ኔን ጾሳ ናኣ ግድኪ!” ያጌድኖ።<verse eid="MRK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12"/>የሱስ ሄ ኢታ አያናቱ ባረባ አሳዉ ኦዲደ፥ ባረና ቆንጭያ ከሰና ማላ፥ ኡንቱንታ ምንሲደ አዛዜዳ።<verse eid="MRK 3:12"/></para>
  <para style="s1">የሱስ ባረ ኪትያዋንታ ዶሬዳ</para>
  <para style="r">(<ref loc="MAT 10:1-4">ማቶሳ 10:1-4</ref>፤ <ref loc="LUK 6:12-16">ሉቃሳ 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13"/>የሱስ ደርያ ቦላ ከሲደ፥ ባረ ኮዬዳ አሳቱዋ ባረኮ ጼሴዳ፤ ሄዋፐ ጉየ አኮ ቤድኖ። <verse eid="MRK 3:13"/><verse number="14-15" style="v" sid="MRK 3:14-15"/>ኡንቱንቱ ባረናና ደአና ማላነ ቃላ ኦዳናዉ ኡንቱንታ ኪታና ማላ፥ ኢታ አያናቱዋ አሳፐ ከሳናዉ ኡንቱንቶ ማታይ ደአና ማላ፥ ታማነ ላኡ አሳቱዋ ዶሬዳ።<verse eid="MRK 3:14-15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16"/>እ ዶሬዳ ታማነ ላአቱ ሀዋንታ: ጰጽሮሳ ያጊደ ሱንዳ ስሞና፥ <verse eid="MRK 3:16"/><verse number="17" style="v" sid="MRK 3:17"/>ቦኣነርጌሳ ያጊደ ሱንዳ ዛብድዮሳ ናና ያቆባነ ያቆባ እሻ ዮሃንሳ። “ቦኣነርጌሳ” ግያዌ “ዎልቃማ አሳቱዋ” ግያዋ። <verse eid="MRK 3:17"/><verse number="18" style="v" sid="MRK 3:18"/>እንድራሳነ ፕልጶሳ፥ ባርታላሞሳነ ማቶሳ፥ ቶማሳነ እልፕዮሳ ናኣ ያቆባ፥ ታዶሳነ ባረ ቢታዉ ሴለትያ ስሞና፥ <verse eid="MRK 3:18"/><verse number="19" style="v" sid="MRK 3:19"/>የሱሳ አ እሜዳ ይሁዳ አስቆሮታ።<note caller="-" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="MRK 14:10">14:10</ref></char></note><verse eid="MRK 3:19"/></para>
  <para style="s1">የሱሳነ ብኤል-ዘቡላ</para>
  <para style="r">(<ref loc="MAT 12:22-32">ማቶሳ 12:22-32</ref>፤ <ref loc="LUK 11:14-23">ሉቃሳ 11:14-23</ref>፤ <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20"/>የሱስ ሶይ ቤዳ፤ ላኤንዋካ ቃይ ጮራ አሳይ ሺቅና፥ እነ አ ካልያዋንቱና ሀራይ አቶ፥ ቁማ ማናዉካ ዳንዳይበይክኖ፤ <verse eid="MRK 3:20"/><verse number="21" style="v" sid="MRK 3:21"/>አሳይ አ፥ “ጎዬ” ግያ ድራዉ፥ አ ዳባቱ ሄዋ ስሲደ፥ አ አካናዉ ቤድኖ።<verse eid="MRK 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22"/>ህግያ ታማርስያ እት እት አሳቱ የሩሳላመፐ ዪደ፥ “የሱሳ ቦላ ብኤል-ዘቡል ደኤ” ያጌድኖ፤ ቃይ፥ “ጻላሀቱዋ ካፑ ባረዉ ዎልቃ እምና፥ ኢታ አያናቱዋ ከሴ” ያጊደ ሃሳዬድኖ።<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቶሳ 9:34</ref>፤ <ref loc="MAT 10:25">10:25</ref></char></note><verse eid="MRK 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23"/>የሱስ አሳ ባረኮ ጼሲደ፥ ሌምሱዋ ኦዲደ፥ “ሴጻናይ ሴጻና ዎት ከሳናዉ ዳንዳይ? <verse eid="MRK 3:23"/><verse number="24" style="v" sid="MRK 3:24"/>እት ካዉተይ ባረ ግዶን ሻከቶፐ፥ ሄ ካዉተይ ኤቃናዉ ዳንዳየና፤ <verse eid="MRK 3:24"/><verse number="25" style="v" sid="MRK 3:25"/>ቃይ እት ጎለ አሳይካ ባረ ግዶን ሻከቶፐ፥ ሄ ጎለ አሳይካ ኤቃናዉ ዳንዳየና። <verse eid="MRK 3:25"/><verse number="26" style="v" sid="MRK 3:26"/>ሴጻናይ ባረናና ዋላቀቲደ ሻከቶፐ፥ ባያናፐ አትን፥ ደአና ዳንዳየና።<verse eid="MRK 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27"/>“ሽን ዎልቃማ አሳ ጎለ ገሊደ ካሰቲደ አ ቃቼናን ደኢደ፥ አ ሚሻ ቦንቃናዉ ዳንዳይያ አሳይ ባዋ፤ ቃቼዳዋፐ ጉይያን፥ አ ጎልያ ቦንቃናዉ ዳንዳዬ።<verse eid="MRK 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28"/>“ታን ህንተንቶ ቱሙዋ ጋይ፤ ጾሳይ አሳ ናናዉ ናጋራ ኡባነ ኡንቱንቱ ቦርያ ቦርያ<note caller="+" style="f"><char style="fr" closed="false">3:28 </char><char style="fq" closed="false">ቦርያ ቦርያ፦ </char><char style="ft" closed="false">ጉሳይ ጾሳ ቦላን አሳይ ሃሳይያ ኢታ፥ ባላነ ጌላ ሃሳያ።</char></note> ኡባ አቶ ጋና፤ <verse eid="MRK 3:28"/><verse number="29" style="v" sid="MRK 3:29"/>ሽን ጌሻ አያና ቦላ ኢታ ቦርያ ሃሳይያ ኦስነ መናዉ ናጋራ ግዳናፐ አትን፥ ጾሳይ ኡባካ አቶ ጌና” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="LUK 12:10">ሉቃሳ 12:10</ref></char></note> <verse eid="MRK 3:29"/><verse number="30" style="v" sid="MRK 3:30"/>የሱስ ሄዋ ጌዳዌ፥ እት እት አሳቱ፥ “የሱሳ ቦላ ኢታ አያናይ ደኤ” ያጌዳ ድራሳ።<verse eid="MRK 3:30"/></para>
  <para style="s1">የሱሳ ዳዮነ እሻቱዋ</para>
  <para style="r">(<ref loc="MAT 12:46-50">ማቶሳ 12:46-50</ref>፤ <ref loc="LUK 8:19-21">ሉቃሳ 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31"/>የሱሳ ዳያነ አ እሻቱ ዪደ፥ ካረን ኤቂ አኮ አሳ ኪቲደ፥ አ ጼስሴድኖ። <verse eid="MRK 3:31"/><verse number="32" style="v" sid="MRK 3:32"/>ጮራ አሳይ አ ማታን ኡቴድኖ፤ ሄ ኪተቴዳዌ አ፥ “በአ፤ ነ ዳያነ ነ እሻቱ ካረን ኤቂደ፥ ኔናና ጋከታናዉ ኮዪኖ” ያጌዳ።<verse eid="MRK 3:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33"/>የሱስ ዛሪደ፥ “ታ ዳያ ኦኔ? ቃይ ታ እሻቱ ኦኔ?” ያጌዳ። <verse eid="MRK 3:33"/><verse number="34" style="v" sid="MRK 3:34"/>ባረ ማታን ኡቴዳ አሳ ዩሽ አ ጼሊደ፥ “በእተ፤ ታ ዳያነ ታ እሻቱ ሀዋንቱሽ። <verse eid="MRK 3:34"/><verse number="35" style="v" sid="MRK 3:35"/>ጾሳይ ኮይያዋ ኦያ ኡባይ ታ እሻ፥ ታ ምቻቶነ ታ ዳዮ” ያጌዳ።<verse eid="MRK 3:35"/></para>
  <chapter eid="MRK 3"/>
  <chapter number="4" style="c" sid="MRK 4"/>
  <para style="s1">ዘረ ዘርያዋ ሌምሱዋ</para>
  <para style="r">(<ref loc="MAT 13:1-9">ማቶሳ 13:1-9</ref>፤ <ref loc="LUK 8:4-8">ሉቃሳ 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1"/>የሱስ ሽረትካ ጋሊላ አባ ማታን ታማርሱዋ ዶሜዳ፤ ጮራ አሳይ ባረ ምይያን ዩይ አደ ሺቅ ኡትና፥ አባን ደእያ ዎንግርያ ግዶ ገሊደ፥ አን ኡቴድኖ፤ ቃይ ሄ አሳይ ኡባይ አባ ምይያን ደኤ።<note caller="-" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="LUK 5:1-3">ሉቃሳ 5:1-3</ref></char></note> <verse eid="MRK 4:1"/><verse number="2" style="v" sid="MRK 4:2"/>እ ኡንቱንታ ዳሮባ ሌምሱዋን ታማርሲደ፥<verse eid="MRK 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3"/>“ስስተ፤ እት ብታኒ ዘረ ዘራናዉ ከሴዳ። <verse eid="MRK 4:3"/><verse number="4" style="v" sid="MRK 4:4"/>እ ዘርሽን፥ እት እት ዘረይ ኦግያ ዶናን ዎዳ፤ ሄዋ ካፉ ዪደ ሜዳ። <verse eid="MRK 4:4"/><verse number="5" style="v" sid="MRK 4:5"/>እት እት ዘረይ አንጮ ቢታ ቦላ ዎዳ፤ ዳሮ ቢታይ ባይና ድራዉ፥ ሄ ዘረይ ኤለካ ሞኬዳ። <verse eid="MRK 4:5"/><verse number="6" style="v" sid="MRK 4:6"/>አዋይ ከሴዳ ዎደ ሹሌዳ፤ አዱሳ ጻጱዋ የድቤና ድራዉ፥ መል አጌዳ። <verse eid="MRK 4:6"/><verse number="7" style="v" sid="MRK 4:7"/>እት እት ዘረይ አጉን ግዶን ዎዳ፤ ሄዋን ሞኬዳዋ አጉንይ ድጪደ ጩልና፥ አይፈናን አቴዳ። <verse eid="MRK 4:7"/><verse number="8" style="v" sid="MRK 4:8"/>እት እት ዘረይ ቱኤ ቢታን ዘረቲደ ሞኬዳ፤ ድጪደ እቱ ሀታሙዋ፥ እቱ ኡሱፑን ታሙዋ አይፍና፥ እቱ ጼቱዋ አይፌዳ።” <verse eid="MRK 4:8"/><verse number="9" style="v" sid="MRK 4:9"/>ቃይካ የሱስ፥ “ስሳናዉ ሀይይ ደእያ ኡራይ ስሶ” ያጌዳ።<verse eid="MRK 4:9"/></para>
  <para style="s1">የሱስ ሌምሱዋን ኦዴዳ ጋሱዋ</para>
  <para style="r">(<ref loc="MAT 13:10-17">ማቶሳ 13:10-17</ref>፤ <ref loc="LUK 8:9-10">ሉቃሳ 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10"/>ታማነ ላኡ የሱሳ ካልያዋንቱነ እ ኦዴዳዋ ስሴዳ ሀራ አሳቱ እ ባረካ ደእሽን አኮ ሺቂደ፥ ሄ ሌምሱዋ ብለ አ ኦቼድኖ። <verse eid="MRK 4:10"/><verse number="11-12" style="v" sid="MRK 4:11-12"/>የሱስ ኡንቱንቶ፥ “ህንተንቶ ጾሳ ካዉተ ጹራ የዉዋ ኤራይ እመቴዳ፤ ሽን ሀራቱ ካዉተፐ ካረና ደእያዋንቱ፥ ጼላ ጼሊደ በኤና ማላ፥ ቃይ ስሳ ስሲድካ አኬከና ማላ፥ ኡንቱንቱ ሽረቲደ ጾሳኮ ስምና፥ እ ኡንቱንቱ ናጋራ አቶ ጌና ማላ፥ ኡንቱንቶ ኡባባይ ሌምሱዋን ኦደቴ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">4:11-12 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">ኢሳ. 6:9-10</ref></char></note><verse eid="MRK 4:11-12"/></para>
  <para style="s1">ዘርያዋ ሌምሱዋ ብለ</para>
  <para style="r">(<ref loc="MAT 13:18-23">ማቶሳ 13:18-23</ref>፤ <ref loc="LUK 8:11-15">ሉቃሳ 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13"/>የሱስ ኡንቱንታ፥ “ሀ ሌምሱዋ ኤርክቴ? ያትና፥ ሌምሱዋ ኡባ ዎት ኤራንቴ? <verse eid="MRK 4:13"/><verse number="14" style="v" sid="MRK 4:14"/>ዘርያዌ ጾሳ ቃላ ዘሬ። <verse eid="MRK 4:14"/><verse number="15" style="v" sid="MRK 4:15"/>ቃላይ ዘረትያ ኦግያ ዶናን ደእያዋንቱ ሀዋንታ፤ ኡንቱንቱ ቃላ ስስያ ዎደ፥ ሴጻናይ ኤለካ ዪደ፥ ኡንቱንቱ ዎዛናን ዘረቴዳ ቃላ አፍ ድጌዳ። <verse eid="MRK 4:15"/><verse number="16" style="v" sid="MRK 4:16"/>ሀዋዳንካ ቃይ አንጮትያ ቢታን ዘረቴዳዋንቱ ሀዋንታ፤ ኡንቱንቱ ቃላ ስሲደ፥ ኤለካ ናሸቻን አኪኖ። <verse eid="MRK 4:16"/><verse number="17" style="v" sid="MRK 4:17"/>ኡንቱንቱ ሀእዉ ደኢኖፐ አትን፥ ኡንቱንቶ ምኖ ጻጱ ባዋ፤ ጉየፐ ቃላ ጋሱዋን ዋዪ ዎይ የደርሱ ይያ ዎደ፥ ኡንቱንቱ ኤለካ በት አጊኖ። <verse eid="MRK 4:17"/><verse number="18" style="v" sid="MRK 4:18"/>ቃይ አጉን ግዶን ዘረቴዳዋንቱ ሀዋንታ፤ ኡንቱንቱ ቃላ ስስያዋንታ። <verse eid="MRK 4:18"/><verse number="19" style="v" sid="MRK 4:19"/>ሽን ሀ ሳኣ ደኦ ህርግያዌ ዱረተ ዶስያዌነ ሀራባ አሞትያዌ ኡንቱንቱ ዎዛናን ገሊደ፥ ቃላ ጩልና አይፈናን አት አጌዳ። <verse eid="MRK 4:19"/><verse number="20" style="v" sid="MRK 4:20"/>ሽን ቱኤ ቢታን ዘረቴዳዋንቱ ቃላ ስሲደ አክያዋንታ፤ እቱ ሀታሙዋ፥ እቱ ኡሱፑን ታሙዋ አይፍና፥ እቱ ጼቱዋ አይፌዳ” ያጌዳ።<verse eid="MRK 4:20"/></para>
  <para style="s1">ጾምፕያ ሌምሱዋ</para>
  <para style="r">(<ref loc="LUK 8:16-18">ሉቃሳ 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21"/>የሱስ ጉጂደ፥ “ጾምፕያ አሂደ፥ ግላፐ ዎይ አርሳፐ ጋርሳና ዎያ አሳይ ደኢ? ቃሳን ዎኔ? <verse eid="MRK 4:21"/><verse number="22" style="v" sid="MRK 4:22"/>አያዉ ጎፐ፥ ቆሴዳባይ ኡባይ ቆንጭያ ከሳናዋ፤ ቃይ ጌማን ዎዳባይ ኡባይ ቤተናን አተና። <verse eid="MRK 4:22"/><verse number="23" style="v" sid="MRK 4:23"/>ስሳናዉ ሀይይ ደእያ ኡራይ ደኦፐ ስሶ” ያጌዳ።<verse eid="MRK 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24"/>ቃይካ ኡንቱንታ፥ “ህንተንቱ ስስያዋ አኬኪደ ስስተ፤ ጾሳይ ህንተ ማኬዳ ቁንኣን ህንተንቶ ማካናዋ። እ ህንተንቶ ዳርሲደ እማና፤ <verse eid="MRK 4:24"/><verse number="25" style="v" sid="MRK 4:25"/>ደእያ ኡራዉ ጉጅ እማና፤ ባይናዋፐ ሀራይ አቶ፥ አዉ ደእያ ሄ ጉቶካ አክ ድጋና” ያጌዳ።<verse eid="MRK 4:25"/></para>
  <para style="s1">ድጭያ ዘረ ሌምሱዋ</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26"/>የሱስ ቃይካ፥ “ጾሳ ካዉተይ ጋደን ካ ዘርያ አሳ ማላ። <verse eid="MRK 4:26"/><verse number="27" style="v" sid="MRK 4:27"/>ሄ ብታኒ ቃማ ገምእሼ፤ ጉራ ደንዴ፤ እ ባረ ሁጰዉ ዋንንቶ ኤረናን፥ ሄ ዘረይ ሞኬነ ድጬ። <verse eid="MRK 4:27"/><verse number="28" style="v" sid="MRK 4:28"/>ቢታይ ካ ባረካ ሞኬነ አይፌ፤ ኮይሮ ጫርሻይ ጫሬ፤ ጉየፐ አይፋናዉ ኩኩሜ፤ ቃይ ዉርሰን ኩመን አይፍያ አይፌ። <verse eid="MRK 4:28"/><verse number="29" style="v" sid="MRK 4:29"/>ሽን ካይ ጋክያ ዎደ፥ ካ ሺሽያ ዎዲ ጋኬዳ ድራዉ፥ ብታኒ ኤለካ ባጫን ጫኩዋ ገል አጌዳ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">4:29 </char><char style="xt" closed="false"><ref loc="JOL 3:13">ኢዩ. 3:13</ref></char></note><verse eid="MRK 4:29"/></para>
  <para style="s1">ሳናፍጭያ ዘረ ሌምሱዋ</para>
  <para style="r">(<ref loc="MAT 13:31-34">ማቶሳ 13:31-34</ref>፤ <ref loc="LUK 13:18-19">ሉቃሳ 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30"/>የሱስ፥ “ኑን ጾሳ ካዉተ አያ ማላቴ ጋኔ? ዎይ አያና ሌምሳኔ? <verse eid="MRK 4:30"/><verse number="31" style="v" sid="MRK 4:31"/>ጾሳ ካዉተይ ሳናፍጭያ አይፋቶ ማላቴ። ሄ አይፋታ ዘርያ ዎደ፥ ሳኣን ደእያ ም አይፊያ ኡባፐካ ጉጻዉ፤ <verse eid="MRK 4:31"/><verse number="32" style="v" sid="MRK 4:32"/>ሄኖ ዘርና ሞካደ ሀራ አታክልትያ ኡባፐ ዳራዉ፤ ዳሮ ዳሻ ዳሻዉ። ካፉ እዝ ቃንካ ኩዋን ጎልያ ኬጻና ዳንዳዬ” ያጌዳ።<verse eid="MRK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33"/>የሱስ ሀዋ ማላ ዳሮ ሌምሱዋን አሳይ ስሳናዉ ዳንዳይያዋ ኬና፥ ባረ ቃላ ኦዴዳ። <verse eid="MRK 4:33"/><verse number="34" style="v" sid="MRK 4:34"/>አሳዉ ሌምሱ ባይናን ኦደና፤ ሽን የሱስ ባረና ካልያዋንቱ ጻላላና ደእያ ዎደ፥ ኡንቱንቶ ኡባባ ብሊደ ኦዴ።<verse eid="MRK 4:34"/></para>
  <para style="s1">የሱስ ቤታ ጮኡ ኦዳ</para>
  <para style="r">(<ref loc="MAT 8:23-27">ማቶሳ 8:23-27</ref>፤ <ref loc="LUK 8:22-25">ሉቃሳ 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35"/>ሄ ጋላስ ሳአይ ኦማርስና፥ የሱስ ባረና ካልያዋንታ “አባፐ ሄፍን ፕኖይተ” ያጌዳ። <verse eid="MRK 4:35"/><verse number="36" style="v" sid="MRK 4:36"/>አ ካልያዋንቱ አሳ አጊደ፥ የሱስ ካሰ ገል ኡቴዳ ዎንግርያን ገሊደ፥ የሱሳ ባረንቱና አፌድኖ፤ ሀራ ዎንግራቱካ ሄዋን ደኢኖ። <verse eid="MRK 4:36"/><verse number="37" style="v" sid="MRK 4:37"/>ዎልቃማ ጎቱ ደንድና፥ ቤታይ ዎንግርያ ሾጭና፥ ሃይ ኩማና ጋካናዉ ዎንግርያ ግዶ ገሌዳ። <verse eid="MRK 4:37"/><verse number="38" style="v" sid="MRK 4:38"/>ሄ ዎደ የሱስ ዎንግርያን ጉየ ባጋና ቦርኮ ቦርኮቲደ ገምእሼዳ። የሱሳ ካልያዋንቱ አ ደንደ፥ “ታማርስያዎ፥ ኑን ይያ ዎደ ጮኡ ጋደ ጼላይ?” ያጌድኖ።<verse eid="MRK 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39"/>እ ቤጎቲደ ጎቱዋ፥ “ጮኡ ጋ” ጊደ፥ አባካ፥ “ዎፑ ጋ” ጌዳ፤ ጎቱካ ጮኡ ጊና፥ ኡባባይካ ዎፑ ጌዳ። <verse eid="MRK 4:39"/><verse number="40" style="v" sid="MRK 4:40"/>የሱስ ባረና ካልያዋንታ “አያዉ ሀዋዳን ያዪቴ? ህንተንቱ ዋን አማንክቴ?” ያጌዳ።<verse eid="MRK 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41"/>ኡንቱንቱ ዳሮ ያዪደ ባረንቱ ግዶን፥ “ሀዌ ላ ሀራይ አቶ፥ ጎቱነ አባይ አዛዘትያዌ ኦኔ?” ያጌድኖ።<verse eid="MRK 4:41"/></para>
  <chapter eid="MRK 4"/>
  <chapter number="5" style="c" sid="MRK 5"/>
  <para style="s1">የሱስ ኢታ አያናይ ኦይቄዳ ብታንያ ፓዳ</para>
  <para style="r">(<ref loc="MAT 8:28-34">ማቶሳ 8:28-34</ref>፤ <ref loc="LUK 8:26-39">ሉቃሳ 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1"/>የሱስነ አ ካልያዋንቱ አባፐ ሄፍንዉ ፕኒደ፥ ገርገሰኖና ጌተትያ ጋድያ ጋኬድኖ። <verse eid="MRK 5:1"/><verse number="2" style="v" sid="MRK 5:2"/>አሳ ሞግያ ዱፉ ደኢያሳፐ ኢታ አያናይ ደእያ እት ብታኒ ከሲደ፥ የሱስ ዎንግርያፐ ከሴዳ ዎደ፥ የሱሳና ጋከቴዳ። <verse eid="MRK 5:2"/><verse number="3" style="v" sid="MRK 5:3"/>ብታኒ ሄ ዱፉ ደእያ ሳን አቅ ፔሺደ፥ ያን ደኤ፤ አ ኦንነ ሀራይ አቶ፥ ሳንላታን ቃቻናዉካ ዳንዳይቤና። <verse eid="MRK 5:3"/><verse number="4" style="v" sid="MRK 5:4"/>አያዉ ጎፐ፥ እ ዳሮ ዎደ ኡቁናንነ ሳንላታን ቃሸቲደ ደኤ፤ ሽን ሳንላታ ዱሰረዳ፤ ኡቁናካ መንሬዳ፤ አ ጾናናዉ ዳንዳዬዳዌ ኦንነ ባዋ። <verse eid="MRK 5:4"/><verse number="5" style="v" sid="MRK 5:5"/>እ ኡባ ዎደ ጋላስነ ቃማ፥ ሄ ዱፉ ደኢያሳንነ ደርያ ቦላ ዋሴ፤ ባረ ቦላካ ሹቻን ጋሬ።<verse eid="MRK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6"/>የሱሳ ሃኩዋን በኤዳ ዎደ፥ አኮ ዎጽ ዪደ አዉ ጎይኔዳ። <verse eid="MRK 5:6"/><verse number="7" style="v" sid="MRK 5:7"/>ሄ ብታኒ ባረ ኮሻ ቁ ኦደ፥ “ኡባፐ ቦላ ጾሳ ናአዉ፥ የሱሳ፥ ኔናነ ታና አዬ ጋ? ታና ሙረና ማላ፥ ታን ኔና ጾሳ ሱንን ዎሳይ” ያጌዳ። <verse eid="MRK 5:7"/><verse number="8" style="v" sid="MRK 5:8"/>እ ሄዋ አያዉ ጌዴ ጎፐ፥ የሱስ አ፥ “ላ ሀ ኢታ አያናዉ፥ ሀ ብታንያፐ ከሳ” ያጌዳዋሳ።<verse eid="MRK 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9"/>የሱስ አ፥ “ነ ሱንይ ኦኔ?” ያጊደ ኦቼዳ።</para>
  <para style="p" vid="MRK 5:9">እ፥ “ኑን ጮራ ግድያ ድራዉ፥ ታ ሱንይ ሌግዮና” ያጌዳ። <verse eid="MRK 5:9"/><verse number="10" style="v" sid="MRK 5:10"/>ኢታ አያናቱዋ ሄ ጋድያፐ ከስ የደና ማላ፥ የሱሳ ምንሲደ ዎሴዳ።<verse eid="MRK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11"/>ሄ ደርያ ቦላን ጮራ ጉዱን ዉዲ ሄመቴ፤ <verse eid="MRK 5:11"/><verse number="12" style="v" sid="MRK 5:12"/>ኢታ አያናቱ የሱሳ፥ “ኑና ህን ጉዱን ዉድያኮ የዳርኪ፤ ኡንቱንቱን ቢደ ገላና” ያጊደ ዎስና፥ <verse eid="MRK 5:12"/><verse number="13" style="v" sid="MRK 5:13"/>የሱስ፥ “ቢተ” ያጌዳ። ኢታ አያናቱ ብታንያፐ ከሲደ፥ ጉዱንቱዋን ገሌድኖ፤ ላኡ ሻአ ግድያ ጉዱን ዉዲ ካካ ሁጲያና ካጆቲደ፥ አባን ገሊደ፥ ምተት አጌዳ።<verse eid="MRK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14"/>ጉዱን ዉድያ ሄምያዋንቱ ባቃቲደ፥ ሀኔዳዋ ካታማንነ ካታማፐ ጋጻ ጋድያን ኦዴድኖ፤ ሄዋ በአናዉ አሳይ ዬዳ። <verse eid="MRK 5:14"/><verse number="15" style="v" sid="MRK 5:15"/>አሳይ የሱሳኮ ዪደ፥ ጮራ ኢታ አያናቱ በን ኦይቄዳ ብታኒ ባረ ዎዛናይ ስምና፥ ማዩዋ ማዪደ፥ ሄዋን ኡቴዳዋ በኢደ፥ ኡባይ ያዬዳ። <verse eid="MRK 5:15"/><verse number="16" style="v" sid="MRK 5:16"/>ሄዋ በኤዳ አሳቱ ኢታ አያናቱ ኦይቄዳ ብታኒ ሀኔዳዋነ ቃይ ጉዱን ዉድያባ ሄ አሳዉ ኦዴድኖ። <verse eid="MRK 5:16"/><verse number="17" style="v" sid="MRK 5:17"/>ሄዋ ድራዉ፥ አሳይ ባረንቱ ጋድያፐ የሱስ ባና ማላ፥ ዎሳ ዶሜዳ።<verse eid="MRK 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18"/>የሱስ ዎንግርያን ገልሽን፥ ኢታ አያናቱ ኦይቄዳ ብታኒ የሱሳና ደአና ማላ፥ የሱሳ ዎሴዳ። <verse eid="MRK 5:18"/><verse number="19" style="v" sid="MRK 5:19"/>ሽን የሱስ እጺደ አ፥ “ነ ሶይ ስማደ፥ ጎዳይ ነዉ አይ ማላ ዎልቃማባ ኦደንቶነ ቃይ እ ነዉ አይ ማላ ኬከንቶ ነ ሶይ አሳዉ ኦዳ” ያጌዳ። <verse eid="MRK 5:19"/><verse number="20" style="v" sid="MRK 5:20"/>ብታኒ ቢደ፥ ታሙ ካታማ<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="fq" closed="false">ታሙ ካታማ፦ </char><char style="ft" closed="false">ሀዋንቱ እት ጭታ ግዴዳ ካታማቱ ሳማርያፐነ ጋሊላ ጋድያ አዋይ ዶልያ ባጋና ደእያዋንታ ግዲደ፥ ሄዋንቱን ደእያ አሳቱዋ ኤሻይካ ግሪከ አሳቱዋ ደኡዋ ኦግያ ካልያዋ በሴ።</char></note> ግያ ሳን ዩዪደ፥ የሱስ ባረዉ አይ ማላ ዎልቃማባ ኦደንቶ፥ ኦዱዋ ዶሜዳ፤ እ ኦዴዳዋ ስሴዳ አሳይ ኡባይ ማላለቴዳ።<verse eid="MRK 5:20"/></para>
  <para style="s1">ያእሮሳ ናቶነ የሱሳ ማዩዋ ቦቼዳ ምሽራቶ</para>
  <para style="r">(<ref loc="MAT 9:18-26">ማቶሳ 9:18-26</ref>፤ <ref loc="LUK 8:40-56">ሉቃሳ 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21"/>የሱስ ስሚደ፥ ዎንግርያን ገሊደ፥ አባ ፕኔዳዋፐ ጉይያን፥ ጮራ አሳይ አባ ማታን አኮ ዩይ አደ ሺቄድኖ። <verse eid="MRK 5:21"/><verse number="22" style="v" sid="MRK 5:22"/>ያእሮሳ ግያዌ፥ አይሁዳ ዎሳ ጎልያ ካፓቱዋፐ እቱ፥ የሱሳ በኤዳ ዎደ አኮ ይ አ ገድያን ኩንዲደ፥ <verse eid="MRK 5:22"/><verse number="23" style="v" sid="MRK 5:23"/>“ታ ናታ ሀርጋደ ሀይቃናዉ፤ እዛ ፓጺደ ሎኦ ደአና ማላ፥ ያደ ነ ኩሽያ እዝ ቦላ ዎርኪ” ያጊደ የሱሳ ምንሲደ ዎሴዳ።<verse eid="MRK 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24"/>የሱስ ያእሮሳና ቤዳ፤ እ ቢሽን ጮራ አሳይ አ ካሊደ መቶድኖ።<verse eid="MRK 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25"/>ታማነ ላኡ ላይ ኡባ እዝ ቦላፐ ሱይ ጎግያ እት ምሽራታ ደአዉ። <verse eid="MRK 5:25"/><verse number="26" style="v" sid="MRK 5:26"/>ጮራ አክማቱ እዞ አክምሽንካ፥ እዛ ፓጻ ካኤታዱ፤ ባረ ሚሻ ኡባ ዉርስናካ እዝዉ ሃ ኢቴዳዋፐ አትን፥ አይነ እዞ ማድቤና። <verse eid="MRK 5:26"/><verse number="27" style="v" sid="MRK 5:27"/>ሄ ምሽራታ የሱሳባ ስሳደ፥ አሳ ግዶና የሱሳፐ ጉየና ያደ፥ አ ማዩዋ ቦቻዱ። <verse eid="MRK 5:27"/><verse number="28" style="v" sid="MRK 5:28"/>አያዉ ጎፐ እዛ፥ “ታን ሀራይ አቶ፥ አ ማዩዋ ቦቾፐካ ፓጻና” ያጋደ ቆፓዱ።<verse eid="MRK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29"/>ኢፐ ጎግያ ሱይ ኤለካ ኤቂ አጌዳ፤ እዛ ባረ ዋይያፐ ፓጼዳዋ ባረ ቦላን ኤራ አጋዱ። <verse eid="MRK 5:29"/><verse number="30" style="v" sid="MRK 5:30"/>የሱስ ባረፐ ዎልቃይ ከሴዳዋ ባረ ሁጰዉ ኤሪደ፥ ኤለካ ጮራ አሳ ግዶን ጉየ ስሚደ፥ “ታ ማዩዋ ቦቼዳዌ ኦኔ?” ያጌዳ።<verse eid="MRK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31"/>የሱሳ ካልያዋንቱ አ፥ “አሳይ ኔና ሱግያ ዎደ በኣደ፥ ‘ታና ኦኔ ቦቼዳዌ?’ ያጋይ?” ጌድኖ።<verse eid="MRK 5:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32"/>የሱስ ሄዋ ኦኔ ኦደንቶነ በአናዉ ዩሽ አደ ጼሌዳ፤ <verse eid="MRK 5:32"/><verse number="33" style="v" sid="MRK 5:33"/>ሽን ምሽራታ ባረዉ ሀኔዳዋ ኤራደ፥ ያሻ ኮኮራደ ያደ የሱሳ ስንን ጉፋናዱ፤ ቃይ ቱማተን ሀኔዳዋ ኡባ አዉ ኦዳዱ። <verse eid="MRK 5:33"/><verse number="34" style="v" sid="MRK 5:34"/>የሱስ እዞ፥ “ታ ናቴ፥ ኔና ነ አማኑ ፓዳ፤ ሳሩዋን ባ፤ ነ ዋይያፐነ ፓጻ” ያጌዳ።<verse eid="MRK 5:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35"/>የሱስ ብሮ ሄዋ ጊሽን፥ አይሁዳ ዎሳ ጎልያ ካፑዋ ሶይፐ ኪተቴዳ አሳቱ ዪደ፥ “ነ ናታ ሀይቃድጋዱ፤ ስም ታማርስያዋ አያዉ ዳቡርሳይ?” ያጌድኖ።<verse eid="MRK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36"/>ሽን የሱስ ኡንቱንቱ ግያዋ ስሲደ፥ አይሁዳ ዎሳ ጎልያ ካፑዋ፥ “አማኖ ጻላላ አማናፐ አትን፥ ያዮፓ” ያጌዳ። <verse eid="MRK 5:36"/><verse number="37" style="v" sid="MRK 5:37"/>የሱስ ጰጽሮሳፐ፥ ያቆባፐነ ያቆባ እሻ ዮሃንሳፐ ሀራይ ኦንነ ባረና ካለና ማላ ድጌዳ። <verse eid="MRK 5:37"/><verse number="38" style="v" sid="MRK 5:38"/>ኡንቱንቱ አይሁዳ ዎሳ ጎልያ ካፑዋ ሶይ ጋኬዳ ዎደ፥ የሱስ አሳይ ሎይ ዬክያዋነ ዝላልያዋ በኤዳ። <verse eid="MRK 5:38"/><verse number="39" style="v" sid="MRK 5:39"/>ገሊደ አሳ፥ “አያዉ ሎይ ዬኪቴ? ናታ ገምእሻዱፐ አትን፥ ሀይቃበይኩ” ያጌዳ።<verse eid="MRK 5:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40"/>ሄዋፐ ጉየ አሳይ አ ቦላ ሚጬዳ፤ ሽን አሳ ኡባ ካረ ከሲደ፥ ናት አዉዋነ አቶ ሄዋን ባረናና ደእያ አ ካልያዋንታነ አኪደ፥ ናታ ደኢያሳ ገሌዳ። <verse eid="MRK 5:40"/><verse number="41" style="v" sid="MRK 5:41"/>የሱስ ናት ኩሽያ ኦይቂደ፥ “ጻልታ፥ ቁሚ”<note caller="+" style="f"><char style="fr" closed="false">5:41 </char><char style="fq" closed="false">ጻልታ፥ ቁሚ፦ </char><char style="ft" closed="false">ሀ ቃላቱ አራማይከ ጌተትያ ቃላን የሱሳ ዎድያን ፓላስቲነ ጋደን ሃሳየትያዋ። ጻልታ ግያዌነ ቁም ግያዌ አማራዋ ቃላ ግደና። ሽን ግሪክያ ቃላ።</char></note> ያጌዳ፤ ሄዋ ብለይ፥ “ጉ ናቴ፥ ታን ኔና ደንዳ ጋይ” ግያዋ።<verse eid="MRK 5:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42"/>ናታ ኤለካ ደንዳ ኤቃደ ሀመታዱ፤ እዛ ታማነ ላኡ ላይ ናቶ፤ ሄዌ ሀንያዋን አሳይ ዳሮ ማላለቴዳ። <verse eid="MRK 5:42"/><verse number="43" style="v" sid="MRK 5:43"/>የሱስ ሄዋ ኡንቱንቱ ኦስነ ኦደና ማላ፥ ኡንቱንታ ምንስ አዛዚደ፥ “እዝዉ ምያባ እምተ” ያጌዳ።<verse eid="MRK 5:43"/></para>
  <chapter eid="MRK 5"/>
  <chapter number="6" style="c" sid="MRK 6"/>
  <para style="s1">የሱሳ ናዝሬተን አከናን እጼድኖ</para>
  <para style="r">(<ref loc="MAT 13:53-58">ማቶሳ 13:53-58</ref>፤ <ref loc="LUK 4:16-30">ሉቃሳ 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1"/>የሱስ ሄዋፐ ከሲደ፥ ባረ ጋድያ ናዝሬተ ካታማ ቤዳ፤ አ ካልያዋንቱካ አ ካሊደ ቤድኖ። <verse eid="MRK 6:1"/><verse number="2" style="v" sid="MRK 6:2"/>ሳምባታ ጋላስ አይሁዳ ዎሳ ጎልያን ታማርሱዋ ዶሜዳ፤ እ ታማርስያዋ ስሴዳ ጮራ አሳይ ማላለቲደ፥ “ሀዌ ሀ ኡባባ ሀቃፐ ደሜዴ? ሀ አዉ እመቴዳ አ ኤራተይ አዬ? ጾሳይ ኦያ ማላታ እ ዎት ኦ?<figure style="fig" alt="Man reading inside synagogue" file="LB00244B.TIF" size="col" ref="6:2">አይሁዳቱዋ ዎሳ ጎለን ናባብያ ብታንያ</figure> <verse eid="MRK 6:2"/><verse number="3" style="v" sid="MRK 6:3"/>ሀዌ አናጽያ<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="fk" closed="false">አናጽያ፦ </char><char style="ft" closed="false">ግሪከ ብለን ሹቻ ዎይ ኡርቃ መልሲደ መያ አሳ ጊደ ጎኤቴ።</char></note> ግደኔ? ማይራም ናኣ፥ ያቆባ እሻ፥ ዮሳ እሻ፥ ይሁዳ እሻ፥ ስሞና እሻ ግደኔ? አ ምቻቱ ኑናና ሀዋን ደእያዋንታ ግድክኖ?” ያጊደ፥ እ ግያዋ አከናን እጼድኖ።<verse eid="MRK 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4"/>የሱስ ሄ አሳዉ፥ “ናቢ ባረ ጋድያን፥ ባረ ዳባቱዋንነ ባረንቱ ሶይ አሳን ቦንቼተናዋፐ አትን፥ ኡባ ሳን ቦንቼቴ” ያጌዳ። <verse eid="MRK 6:4"/><verse number="5" style="v" sid="MRK 6:5"/>እ ሄዋን ባረ ኩሽያ አማሬዳ አሳቱዋ ቦላ ዎደ፥ ኡንቱንታ ፓዳዋፐ አትን፥ ጮራ ማላታ ኦናዉ አይነ ዳንዳይቤና። <verse eid="MRK 6:5"/><verse number="6" style="v" sid="MRK 6:6"/>አሳይ አማንቤና ድራዉ ማላለቴዳ።</para>
  <para style="s1" vid="MRK 6:6">የሱስ ታማነ ላኡ ባረና ካልያዋንቱ ታማርሳናዳን ኪቴዳ</para>
  <para style="r" vid="MRK 6:6">(<ref loc="MAT 10:5-15">ማቶሳ 10:5-15</ref>፤ <ref loc="LUK 9:1-6">ሉቃሳ 9:1-6</ref>)</para>
  <para style="p" vid="MRK 6:6">ሄዋፐ ጉይያን፥ የሱስ ሄዋ ሄራን ደእያ ቄር ካታማቱዋን ዩይ ዩዪደ፥ አሳ ታማርሴዳ። <verse eid="MRK 6:6"/><verse number="7" style="v" sid="MRK 6:7"/>የሱስ ታማነ ላኡ ባረና ካልያዋንታ ባረኮ ጼሲደ፥ ላኡዋ ላኡዋ ኪቴዳ፤ ቃይ ኡንቱንቶ ኢታ አያናቱዋ ከስያ ማታ እሜዳ። <verse eid="MRK 6:7"/><verse number="8" style="v" sid="MRK 6:8"/>ኡንቱንታ፥ “ኦግያ ጻምኣፐ አትን፥ ቁማ፥ ቃርጪትያ፥ ህንተዉ ሚሻ አያኔካ ኦይቆፕተ። <verse eid="MRK 6:8"/><verse number="9" style="v" sid="MRK 6:9"/>ህንተንቱ ገድያን ጫማካ ዎተ፤ ሽን ላኡ ማዩዋ ማዮፕተ” ያጌዳ። <verse eid="MRK 6:9"/><verse number="10" style="v" sid="MRK 6:10"/>ቃይካ ኡንቱንታ፥ “ህንተንታ አሳይ ሀቃን ሞኮፐነ፥ ሄዋፐ ከሳና ጋካናዉ፥ ሄ ጎልያን ኡት አግተ። <verse eid="MRK 6:10"/><verse number="11" style="v" sid="MRK 6:11"/>ህንተንታ አሳይ ሞከናሳ ዎይ ህንተ ኦድያባ ስሰናሳ ሀቃ ግዶፐካ፥ ሄ ጋድያን ደእያ አሳዉ ሄዌ ማርካ ግዳና ማላ፥ ሄዋፐ ከሲደ፥ ህንተ ገድያፐ ባና ሾጭተ”<note caller="+" style="f"><char style="fr" closed="false">6:11 </char><char style="fk" closed="false">ህንተ ገድያፐ ባና ሾጭተ፦ </char><char style="ft" closed="false">ሀዌ አሳይ እጼዳዋ በስያዋ።</char></note> ያጌዳ።<verse eid="MRK 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12"/>ታማነ ላኡ አ ካልያዋንቱ ቢደ፥ አሳይ ባረንቱ ናጋራፐ ስማናዳን፥ ቃላ ኦዴድኖ። <verse eid="MRK 6:12"/><verse number="13" style="v" sid="MRK 6:13"/>ኡንቱንቱ አሳፐ ዳሮ ኢታ አያናቱዋ ከሲደ፥ ሀርግያ አሳ ጮራ ዛይትያ ኦኪደ ፓድኖ።<note caller="-" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JAS 5:14">ያቆባ 5:14</ref></char></note><verse eid="MRK 6:13"/></para>
  <para style="s1">ጻማቅያ ዮሃንሳ ሀይቁዋ</para>
  <para style="r">(<ref loc="MAT 14:1-12">ማቶሳ 14:1-12</ref>፤ <ref loc="LUK 9:7-9">ሉቃሳ 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14"/>አሳይ የሱሳ ሱን ደንያ ድራዉ፥ ካትያ ሄሮድሰ ሄዋ ኡባ ስሴዳ፤ እት እት አሳይ፥ “ጻማቅያ ዮሃንስ ሀይቁዋፐ ደንዴዳ፤ ሄዎ አዉ ዎልቃማ ማላታ ኦያ ዎልቃይ ደኤ” ያጌዳ።<verse eid="MRK 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15"/>ሽን ሀራንቱ አ፥ “ሀዌ ኤላሳ” ያጌድኖ።</para>
  <para style="p" vid="MRK 6:15">ሀራንቱ ቃይ፥ “ሀዌ በን ዎደ ናባቱዋ ማላትያ ናብያ” ያጌድኖ።<verse eid="MRK 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16"/>ሽን ሄሮድሰ ሄዋ ስሴዳ ዎደ፥ “ሄዌ ታን ቆያ ሙጭሴዳ ጻማቅያ ዮሃንሳ። እ ሀይቁዋፐ ፓጼዳ” ያጌዳ።<verse eid="MRK 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17"/>አያዉ ጎፐ፥ ሄሮድሰ ባረ እሻ ፕልጶሳ ማቻቶ ሄሮድያዶ አክ ዎዳ፤ ሄሮድሰ እዝ ድራዉ፥ ባረ ሁጰዉ አሳ ኪቲደ፥ ዮሃንሳ ኦይደ፥ ቃሽስ ዎዳ። <verse eid="MRK 6:17"/><verse number="18" style="v" sid="MRK 6:18"/>አያዉ ጎፐ፥ ዮሃንስ ሄሮድሳ፥ “ኔን ነ እሻ ማቻቶ አካናዉ በሰና” ያግ ዎዳ።<verse eid="MRK 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19"/>ሄሮድያዳ ዮሃንሳዉ ኡሉዋን ሞርክያ ኦይቃደ አ ዎሳናዉ ኮያዱ፤ ሽን ዳንዳያበይኩ። <verse eid="MRK 6:19"/><verse number="20" style="v" sid="MRK 6:20"/>ዮሃንስ ጽሎ አሳነ ጌሻ አሳ ግዴዳዋ ሄሮድሰ ኤሬዳ ድራዉ፥ አዉ ያዪደ፥ ሎይ ናግ ዎዳ፤ ዮሃንስ ግያዋ ስሲደ፥ ባረ ዎዛናን ዳርስ መቶቲደካ አባ ናሸቻን ስሴዳ።<verse eid="MRK 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21"/>ሄሮድሰ ባረ የለቴዳ ጋላስ፥ ጋድያ አይስያዋንቶ፥ ሻላቃቶነ ጋሊላን ደእያ ዎልቃማ አሳዉ ሾብያ ጊግሴዳ ዎደ፥ ዉርሰን ሄሮድያዳ እንጀ ጋላሳ ደማዱ። <verse eid="MRK 6:21"/><verse number="22" style="v" sid="MRK 6:22"/>ሄሮድያድ ናታ እማ ሞክያሳ ገላ ዱራደ፥ ሄሮድሳነ አ እማቱዋ ናሸቻዱ፤ ሄዋፐ ጉየ ካቲ ናትዉ፥ “ኔና ሎኤዳዋ አያ ግዶፐነ ታና ኦቻ፤ ታን ነዉ እማና” ያጌዳ። <verse eid="MRK 6:22"/><verse number="23" style="v" sid="MRK 6:23"/>ቃይ እዝዉ ዳሪ ጫቂደ፥ “ኔን ኦቼዳዋ አያ ግዶፐካ፥ ታን ነዉ እማና፤ ሀራይ አቶ፥ ታ ካዉተፐ ባጋ ግዶፐካ፥ ታን ነዉ እማና” ያጌዳ።<verse eid="MRK 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24"/>ናታ ካረ ከሳደ ባረ ዳዮ፥ “አያ እማ ጎ?” ያጋደ ኦቻዱ።</para>
  <para style="p" vid="MRK 6:24">እ ዳያ፥ “ጻማቅያ ዮሃንሳ ሁጲያ እማ ጋ” ያጋዱ።<verse eid="MRK 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25"/>ናታ ኤለካ ካትያኮ ባደ አ፥ “ጻማቅያ ዮሃንሳ ሁጲያ ዎጪትያን ዎደ፥ ኔን ሀእ ታዉ እማናዳን ኮያይ” ያጋዱ።<verse eid="MRK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26"/>ሄዋፐ ጉየ ካቲ ዳሪ ቃረቴዳ፤ ሽን ባረ ጫቁዋ ድራዉነ ባረ እማቱዋ ድራዉ እዝዉ ጫቄዳ ጫቁዋ ኮላናዉ ኮይቤና። <verse eid="MRK 6:26"/><verse number="27" style="v" sid="MRK 6:27"/>ሄዋ ድራዉ፥ ኤለካ ናግያዋ ኪቲደ፥ ዮሃንሳ ሁጲያ አሀና ማላ አዛዜዳ፤ ናግያዌ ቃሾ ጎለ ቢደ፥ ዮሃንሳ ቆያ ሙጬዳ። <verse eid="MRK 6:27"/><verse number="28" style="v" sid="MRK 6:28"/>ሄ ሙጬዳዋ ዎጪትያን ዎ አሂደ፥ ናትዉ እሜዳ፤ ናታ ቃይ ባረ አትዉ እማዱ። <verse eid="MRK 6:28"/><verse number="29" style="v" sid="MRK 6:29"/>ዮሃንሳ ካልያዋንቱ ሄዋ ስሴዳ ዎደ ዪደ፥ አ አሃ አፊደ ሞጌድኖ።<verse eid="MRK 6:29"/></para>
  <para style="s1">የሱስ እቼሹ ሻአ አሳ ምዚደ ካልሴዳ ታርክያ</para>
  <para style="r">(<ref loc="MAT 14:13-21">ማቶሳ 14:13-21</ref>፤ <ref loc="LUK 9:10-17">ሉቃሳ 9:10-17</ref>፤ <ref loc="JHN 6:1-14">ዮሃ. 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30"/>የሱስ ኪቴዳዋንቱ ስሚደ፥ የሱሳና ጋከቲደ፥ ባረንቱ ኦዳባነ ባረንቱ ታማርሴዳባ ኡባ የሱሳዉ ኦዴድኖ። <verse eid="MRK 6:30"/><verse number="31" style="v" sid="MRK 6:31"/>ብያ አሳይነ ይያ አሳይ ዳርና፥ ሀራይ አቶ ቁማ ማናዉካ ኡንቱንታ ጋናን እጼዳ ድራዉ፥ የሱስ ኡንቱንታ፥ “ኑረካ ጉ ሸምፕ አካናዉ አሳይ ባይናሳ ቦይተ”<note caller="+" style="f"><char style="fr" closed="false">6:31 </char><char style="fk" closed="false">አሳይ ባይናሳ፦ </char><char style="ft" closed="false">ሀዌ ጋሊላ ጌተትያ ዎምባፐ ፑደሃ ዶላ ባጋና ደኤ። 6:45 ጼልተ።</char></note> ያጌዳ። <verse eid="MRK 6:31"/><verse number="32" style="v" sid="MRK 6:32"/>የሱስነ ኡንቱንቱ ባረንቱ ጻላላ ዎንግርያን ኡቲደ፥ አሳይ ባይናሳ ቤድኖ።<verse eid="MRK 6:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33"/>ኡንቱንቱ ቢሽን፥ ጮራ አሳይ ኡንቱንታ በኢደ ኤሬዳ፤ ካታማ ኡባፐ ገድያን ዎጺደ፥ ኡንቱንቱ ብያሳ ኡንቱንቱፐ ካሰቲደ ጋኬድኖ። <verse eid="MRK 6:33"/><verse number="34" style="v" sid="MRK 6:34"/>የሱስ ዎንግርያፐ ከሲደ፥ ጮራ አሳ በኤዳ፤ አሳይ ሄምያ አሳይ ባይና ዶርሳ ማላ ግዴዳ ድራዉ፥ ቃረቲደ አሳ ዳሮባ ታማርሱዋ ዶሜዳ።<note caller="-" style="x"><char style="xo" closed="false">6:34 </char><char style="xt" closed="false"><ref loc="NUM 27:17">ፓይ. 27:17</ref>፤ <ref loc="1KI 22:17">1 ካታ. 22:17</ref>፤ <ref loc="2CH 18:16">2 ኦዱዋ 18:16</ref>፤ <ref loc="EZK 34:5">ህዝ. 34:5</ref>፤ <ref loc="MAT 9:36">ማቶሳ 9:36</ref></char></note><verse eid="MRK 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35"/>ሳአይ ኦማርስያ ዎደ፥ የሱሳ ካልያዋንቱ አኮ ዪደ፥ “ሀዌ ሳአይ አሳይ ባይና ሳኣ፤ ሀእ ሳአይካ ቃም ድጌዳ፤ <verse eid="MRK 6:35"/><verse number="36" style="v" sid="MRK 6:36"/>አሳይ ሄራነ ቄር ካታማቱዋ ግዶ ቢደ፥ ባረንቶ ምያባ ሻማና ማላ፥ አሳ ሞይዛ” ያጌድኖ።<verse eid="MRK 6:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37"/>ሽን የሱስ ዛሪደ ኡንቱንታ፥ “አሳዉ ምያባ ህንተ እምተ” ያጌዳ።</para>
  <para style="p" vid="MRK 6:37">ሄዋፐ ጉየ ኡንቱንቱ፥ “ኑን ቢደ፥ ላኡ ጼቱ ብራ ሳንትምያ<note caller="+" style="f"><char style="fr" closed="false">6:37 </char><char style="fk" closed="false">ብራ ሳንትምያ፦ </char><char style="ft" closed="false">በን ዎድያን አሳ ጋድያን እት ጋላሳ ኡንያ ኦ ፔሼዳ አሳዉ እት ብራ ሳንትሚ እመቴ። ማት። 20:2 ጼልተ።</char></note> ቁማ ሻሚደ፥ አሳይ ማናዉ እማኔ?” ያጊደ አ ኦቼድኖ።<verse eid="MRK 6:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38"/>የሱስ ኡንቱንታ፥ “ህንተንቶ አፑን ዳቡ ደኢ? ቢደ በእተ” ያጌዳ።</para>
  <para style="p" vid="MRK 6:38">ኡንቱንቱ በኢደ፥ “እቼሹ ዳቡዋነ ላኡ ሞልያ” ያጌድኖ።<verse eid="MRK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39"/>የሱስ ባረና ካልያዋንታ አሳ ኡባ ጭታን ጭታን ሻክ ሻኪደ፥ ማታን ኡትሳና ማላ አዛዜዳ። <verse eid="MRK 6:39"/><verse number="40" style="v" sid="MRK 6:40"/>አሳይ ጼቱ ጼቱነ እሻታሙ እሻታሙ ጭታን ጭታን ኡቴድኖ። <verse eid="MRK 6:40"/><verse number="41" style="v" sid="MRK 6:41"/>የሱስ እቼሹ ዳቡዋነ ላኡ ሞልያ ኦይቂደ፥ ፑደ ሳሉዋ ጼሊደ፥ ጾሳ ጋላቴዳ፤ ዳቦቱዋ መንደ አሳዉ ግሻና ማላ፥ ባረና ካልያዋንቶ እሜዳ፤ ቃይ ላኡ ሞልያካ ኡንቱንቱ ኡባዉ ሻኬዳ። <verse eid="MRK 6:41"/><verse number="42" style="v" sid="MRK 6:42"/>አሳይ ኡባይ ሚደ ካሌድኖ። <verse eid="MRK 6:42"/><verse number="43" style="v" sid="MRK 6:43"/>ሄዋፐ ጉየ አቴዳ ዳቦቱዋ ዶካይነ ሞልያ ዶካይ ታማነ ላኡ ዛምቤልያ ኩሜዳዋ የሱሳ ካልያዋንቱ ደንድኖ። <verse eid="MRK 6:43"/><verse number="44" style="v" sid="MRK 6:44"/>ዳቡዋ ሜዳ አቱማ አሳይ እቼሹ ሻአ።<verse eid="MRK 6:44"/></para>
  <para style="s1">የሱስ አባ ቦላን ሀመቲደ ቤዳ</para>
  <para style="r">(<ref loc="MAT 14:22-33">ማቶሳ 14:22-33</ref>፤ <ref loc="JHN 6:15-21">ዮሃ. 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45"/>ኤለካ የሱስ ሄ ጮራ አሳ ሞይዚደ፥ ባረና ካልያዋንቱ ዎንግርያን ገሊደ፥ አባፐ ሄፍንን ደእያ ቤተሳይዳ ግያ ካታማ ባረፐ ስንቲደ ባናዳን አዛዜዳ። <verse eid="MRK 6:45"/><verse number="46" style="v" sid="MRK 6:46"/>ኡንቱንታ ሞይዜዳዋፐ ጉይያን፥ ጾሳ ዎሳናዉ ዞዝያ ከሴዳ።<verse eid="MRK 6:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47"/>ሳአይ ቃምያ ዎደ ዎንግሪ ዎምባ ግዱዋን ደእሽን፥ የሱስ ዎምባፐ ጋጻን ባረካ ደኤ። <verse eid="MRK 6:47"/><verse number="48" style="v" sid="MRK 6:48"/>ጫርኩ አ ካልያዋንቱኮ ጫርክያ ድራዉ፥ ባረና ካልያዋንታ ዎምባ ቤታይ መቶያዋ የሱስ በኢደ፥ ኩቱ ዋሳና ሀንያ ዎደ ዎምባ ቦላን ሀመቲደ፥ ኡንቱንቱኮ ዬዳ፤ ኡንቱንታ የግ አናዉ ኮዬዳ። <verse eid="MRK 6:48"/><verse number="49" style="v" sid="MRK 6:49"/>ሽን ዎምባ ቦላን እ ሀመትሽን፥ ኡንቱንቱ አ በኢደ፥ ባረንቶ ሞይትልያ ማላትና ዋሴድኖ። <verse eid="MRK 6:49"/><verse number="50" style="v" sid="MRK 6:50"/>አያዉ ጎፐ፥ ኡንቱንቱ ኡባይ አ በኢደ፥ ያሻ ኮኮሬድኖ፤ ሽን ኤለካ የሱስ ኡንቱንታ፥ “አይነ ባዋ፤ ታናተኔ ያዮፕተ” ያጌዳ። <verse eid="MRK 6:50"/><verse number="51" style="v" sid="MRK 6:51"/>የሱስ ኡንቱንቱና እትፐ ዎንግርያን ገልና፥ ጫርኩ ዎፑ ጌዳ፤ ኡንቱንቱ ዳሮ ማላለቴድኖ። <verse eid="MRK 6:51"/><verse number="52" style="v" sid="MRK 6:52"/>አያዉ ጎፐ፥ ኡንቱንቱ ዎዛናይ ጆሌዳ ድራዉ፥ ኡንቱንቱ ኡክባ አኬክበይክኖ።<verse eid="MRK 6:52"/></para>
  <para style="s1">የሱስ ገንሳሬጸን ሀርጋንቻቱዋ ፓዳ</para>
  <para style="r">(<ref loc="MAT 14:34-36">ማቶሳ 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53"/>ኡንቱንቱ አባ ፕኒደ፥ ገንሳሬጻ ግያ ቢታ ጋኬድኖ፤ ያን ዎንግርያ ጋጻ ሺሽ ቃቼድኖ። <verse eid="MRK 6:53"/><verse number="54" style="v" sid="MRK 6:54"/>ኡንቱንቱ ዎንግርያፐ ዎያዋን፥ አሳይ ኤለካ የሱሳ ኤርነ <verse eid="MRK 6:54"/><verse number="55" style="v" sid="MRK 6:55"/>ሄዋ ሄራን ደእያ ጋድያ ኡባን ዎጸረቲደ፥ ሀርጋንቻቱዋ ሻንቻማን ቶኪደ፥ “የሱስ ደኤ” ጊና ስሴዳሳ አሁዋ ዶሜዳ። <verse eid="MRK 6:55"/><verse number="56" style="v" sid="MRK 6:56"/>የሱስ ቤዳ ሳ ኡባን ቄር ካታማን ግድና፥ ዎልቃማ ካታማን ግድና፥ ሄራ ግዶን ግድናካ፥ ገያ ደንባን አሳይ ሀርጋንቻቱዋ አኮ አፌ። የሱስ ባረ ማዩዋ ማጫራ ግዶፐነ ሀርጋንቻቱዋ ቦሽሳና ማላ፥ አሳይ አ ዎሴዳ፤ ቦቼዳ ኡባይ ፓጼዳ።<verse eid="MRK 6:56"/></para>
  <chapter eid="MRK 6"/>
  <chapter number="7" style="c" sid="MRK 7"/>
  <para style="s1">የሱስ አሳ ዎጋፐ ኮሸናዋ ጳልቄዳ</para>
  <para style="r">(<ref loc="MAT 15:1-9">ማቶሳ 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1"/>ፓርሳዋቱነ የሩሳላመፐ ዪደ፥ ሙሴ ህግያ ታማርስያ አማሬዳ አሳቱ የሱሳኮ ሺቄድኖ። <verse eid="MRK 7:1"/><verse number="2" style="v" sid="MRK 7:2"/>የሱሳ ካልያዋንቱፐ እቱ እቱ ቱና ኩሽያን፥ ሄዋ ግያዌ ሜጨተናን ቁማ ምያዋንታ<note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="fk" closed="false">ሜጨተናን ቁማ ምያዋንታ፦ </char><char style="ft" closed="false">አይሁደ አሳቱዋ ዎጋን ሜጨተና ኩሽያን ቁማ ሙሳይ ቱናዳን ፓይደቴ። ሄዎ ቁማ ማናፐ ካሰና ኩሽያ ሜቻ ሎይ ምንሲኖ።</char></note> በኤድኖ።<verse eid="MRK 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3"/>አያዉ ጎፐ፥ ፓርሳዋቱነ አይሁዳ አሳይ ኡባይ ባረንቱ አዎቱዋ ዎጋ ናጊደ፥ ባረንቱ ኩሽያ ሎይ ሜጨተናን ሚክኖ። <verse eid="MRK 7:3"/><verse number="4" style="v" sid="MRK 7:4"/>ቃይ ገያፐ ዪደካ ሜጨተናን ደኢደ ሚክኖ። ቃይ ኡንቱንቱ ባረንቱ አዎቱዋፐ አኬዳ ሀራ ጮራ ዎጋይ ደኤ፤ ሄዌካ ዋንጫ፥ ከርያ፥ ብራታፐ መዳ ሚሻነ አርሳ ሜጭያ ዎጋ።<verse eid="MRK 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5"/>ፓርሳዋቱነ ሙሴ ህግያ ታማርስያዋንቱ የሱሳ፥ “ኔና ካልያዋንቱ አያዉ ኑ አዎቱዋ ዎጋ ካለናን እጺደ፥ ባረንቱ ኩሽያ ሜጨተናን ቁማ ሚኖ?” ያጊደ ኦቼድኖ።<verse eid="MRK 7:5"/></para>
  <para style="p">
    <verse number="6-7" style="v" sid="MRK 7:6-7"/>የሱስ ኡንቱንታ ሀዋዳን ያጌዳ፤ “እስያስ ትምቢትያ ኦዴዳ ዎደ፥ ህንተንቱባ፥ ሎአ ማላትያ ኢታቱባ ጻፌዳዋዳንካ፥</para>
  <para style="q1" vid="MRK 7:6-7">“ ‘ጾሳይ፥ “ሀዌ አሳይ ታና፥</para>
  <para style="q2" vid="MRK 7:6-7">ባረ ቦላ ዶናን ቦንቼ።</para>
  <para style="q1" vid="MRK 7:6-7">ሽን ኡንቱንቱ ዎዛናይ ታፐ ሃኩዋን ደኤ፤</para>
  <para style="q2" vid="MRK 7:6-7">አሳይ ታዉ መላ ጎይኔ።</para>
  <para style="q1" vid="MRK 7:6-7">አያዉ ጎፐ፥ አሳይ ኦዳ አዛዙዋ፥</para>
  <para style="q2" vid="MRK 7:6-7">ጾሳ ህግያ ማላትሲደ ታማርሴ” ጌዳ’</para>
  <para style="m" vid="MRK 7:6-7">ያጊደ ትምቢትያ ቱሙዋ ኦዴዳ።<note caller="-" style="x"><char style="xo" closed="false">7:6-7 </char><char style="xt" closed="false"><ref loc="ISA 29:13">ኢሳ. 29:13</ref></char></note><verse eid="MRK 7:6-7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8"/>“ጾሳ አዛዙዋ ህንተ አጊደ፥ አሳ ዎጋ ምንሲደ ናጊታ” ያጌዳ።<verse eid="MRK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9"/>ቃይካ የሱስ፥ “ህንተንቱ ህንተ ዎጋ ናጋናዉ ጾሳ አዛዙዋ አጊታ። <verse eid="MRK 7:9"/><verse number="10" style="v" sid="MRK 7:10"/>አያዉ ጎፐ ሙሴ፥ ‘ነ አባነ ነ ዳዮ ቦንቻ’ ቃይ፥ ‘ባረ አባነ ባረ አቶ ቦርያዌ ሀይቁዋን ሙረቶ’ ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ከሳ 20:12</ref>፤ <ref loc="EXO 21:17">21:17</ref>፤ <ref loc="LEV 20:9">ዎጋ 20:9</ref>፤ <ref loc="DEU 5:16">ዛረ. 5:16</ref></char></note> <verse eid="MRK 7:10"/><verse number="11" style="v" sid="MRK 7:11"/>ሽን እት ኡራዉ ባረ አዉዋ ዎይ ባረ አቶ ማድያባይ ደእሽን እ፥ ‘ሀዌ ቁርባንያ፤ ሀዋ ጉሳይ ጾሳባ ግያዋ’ ጎፐ፥ <verse eid="MRK 7:11"/><verse number="12" style="v" sid="MRK 7:12"/>እ ባረ አዉዋ ዎይ ባረ አቶ ዎደፐ ማዳናዋ አይነ ኮይክታ። <verse eid="MRK 7:12"/><verse number="13" style="v" sid="MRK 7:13"/>ሀ ሀኖታን ህንተ ህንተንቱ ዎጋ ናጋናዉ፥ ጾሳ ቃላ ኮሊደ፥ ሄዋ ማላ ዳሮባ ኦታ” ያጌዳ።<verse eid="MRK 7:13"/></para>
  <para style="s1">አሳ ቱንስያዋንታ</para>
  <para style="r">(<ref loc="MAT 15:10-20">ማቶሳ 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14"/>የሱስ ጮራ አሳ ቃይካ ባረኮ ጼሲደ፥ “ኡባይ ታን ግያዋ ስስተነ አኬክተ። <verse eid="MRK 7:14"/><verse number="15" style="v" sid="MRK 7:15"/>አሳፐ ከስያዌ አሳ ቱንስያዋፐ አትን፥ ካረፐ አሳ ግዶ ገሊደ፥ አሳ ቱንስያባይ አይነ ባዋ፤ <verse eid="MRK 7:15"/><verse number="16" style="v" sid="MRK 7:16"/>ስሳናዉ ሀይይ ደእያ ኡራይ ኦንነ ስሶ” ያጌዳ።<verse eid="MRK 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17"/>የሱስ ጮራ አሳ አጊደ ሶይ ገሌዳ ዎደ፥ አ ካልያዋንቱ ሄ ሌምሱዋባ አ ኦቼድኖ። <verse eid="MRK 7:17"/><verse number="18" style="v" sid="MRK 7:18"/>እ ኡንቱንታ፥ “ህንተንቶካ ቃይ ገልቤኔ? ካረፐ አሳ ዎዛናን ገልያባይ አይነ አሳ ቱንሳናዉ ዳንዳየናዋ አኬኪቴ? <verse eid="MRK 7:18"/><verse number="19" style="v" sid="MRK 7:19"/>አያዉ ጎፐ፥ ቁማይ አሳ ኡሉዋ ግዶ ገሊደ፥ ካረዉ ከስያዋፐ አትን፥ አሳ ዎዛና ግዶ ገለና” ያጌዳ። ሀዋዳንካ የሱስ ቁማ ኡባይ ቱና ግደናዋ ኤርሴዳ።<verse eid="MRK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20"/>ቃይካ የሱስ ሀዋዳን ያጌዳ፤ “አሳ ቱንስያባይ አሳ ዎዛና ግዶፐ ከስያባ። <verse eid="MRK 7:20"/><verse number="21" style="v" sid="MRK 7:21"/>አያዉ ጎፐ፥ አሳ ዎዛና ግዶፐ ከስያዌ ኢታ ቆፋ፤ ዎሹምያዋ፤ ዉእያዋ፤ ዎያዋ፤ ጫራተ፤ <verse eid="MRK 7:21"/><verse number="22" style="v" sid="MRK 7:22"/>ዮራተ፤ ኡዝያ ዎይ ባረና ዶስያዋ፤ ኢታተ ዎይ ጭምያዋ፤ ገንያ፤ ማጫዋ አሞትያዋ፤ ቃናትያዋ፤ ቦርያዋ ዎይ ዝግርያዋ፤ አዩዋ፤ ኤያተ። <verse eid="MRK 7:22"/><verse number="23" style="v" sid="MRK 7:23"/>ሀ ኢታባይ ኡባይ አሳ ዎዛና ግዶፐ ከሲደ፥ አሳ ቱንሴ” ያጌዳ።<verse eid="MRK 7:23"/></para>
  <para style="s1">እት ግሪከ ምሽራት አማኑዋ</para>
  <para style="r">(<ref loc="MAT 15:21-28">ማቶሳ 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24"/>የሱስ ሄዋፐ አጊደ፥ ጺሮሳነ ሲዶና ግያ ካታማቱዋ ማታን ደእያ ጋድያ ቢደ፥ እት ጎልያ ገሌዳ፤ ቃይ እ ያን ደእያዋ ኦንነ ኤራናዋ ኮይቤና፤ ሽን ቆሰቲደ ጋምአናዉ ዳንዳይቤና። <verse eid="MRK 7:24"/><verse number="25" style="v" sid="MRK 7:25"/>ሽን ባረ ጉ ናት ቦላ ኢታ አያናይ ደእያ እት ምሽራታ የሱሳባ ስሳደ፥ ኤለካ አኮ ያነ አ ገድያን ጉፋና አጋዱ። <verse eid="MRK 7:25"/><verse number="26" style="v" sid="MRK 7:26"/>ሄ ምሽራታ አይሁዳ አሳ ግዱኩ፤ አ የለቴዳዌካ ሶርያ ግያ ጋድያና፤ አ ባረ ናትፐ ጻላህያ ከሳና ማላ፥ የሱሳ ዎሳዱ።<verse eid="MRK 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27"/>ሽን የሱስ ዛሪደ፥ “ናናይ ካሰቲደ ቁማ ካልኖ፤ አያዉ ጎፐ፥ ናና ቁማ አኪደ፥ ካናቶ<note caller="+" style="f"><char style="fr" closed="false">7:27 </char><char style="fk" closed="false">ካናቶ፦ </char><char style="ft" closed="false">ሀ ቃላ እት እት አይሁደ አሳይ፥ አይሁደ ግደና አሳቶ ጎኤትያዋ።</char></note> ኦልያዌ ሎአ ግደና” ያጌዳ።<verse eid="MRK 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28"/>ምሽራታ ዛራደ፥ “ቱማካ ታ ጎዳዉ፥ ሀራይ አቶ ሳምፓ ምይያን ደእያ ካናቱካ ናናቱዋፐ አቴዳ ሱፓ ሚኖ” ያጋዱ።<verse eid="MRK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29"/>የሱስ ቃይ እዞ፥ “ሀ ኔን ሃሳዬዳ ቃላ ድራዉ፥ ጻላሂ ነ ናትፐ ከሴዳ፤ ስም ነ ሶይ ባ” ያጌዳ።<verse eid="MRK 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30"/>ምሽራታ ባረ ሶይ ብያ ዎደ፥ እዝ ናትፐ ጻላሂ ከስና፥ ሂጻን ግሴዳዉኖ ደማዱ።<verse eid="MRK 7:30"/></para>
  <para style="s1">የሱስ ቱለነ ዱደ ግዴዳ እት ብታንያ ፓዳ</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31"/>የሱስ ጺሮሳ ጋድያፐ ከሲደ፥ ሲዶናናነ ታሙ ካታማ ግያ ጋድያና ካንደ፥ ጋሊላ አባኮ ቤዳ። <verse eid="MRK 7:31"/><verse number="32" style="v" sid="MRK 7:32"/>አሳይ ቱለነ ዱደ ግዴዳ ብታንያ የሱሳኮ አሂደ፥ ባረ ኩሽያ አ ቦላን ዎና ማላ፥ የሱሳ ዎሴድኖ። <verse eid="MRK 7:32"/><verse number="33" style="v" sid="MRK 7:33"/>የሱስ ባረካ ሄ ብታንያ ጮራ አሳፐ ጋጻ ከሲደ፥ ባረ ብራያ አ ሀይን የዴዳ፤ ቃይ ጩቻ ጩቺደ፥ አ እንጻርሳ ቦቼዳ። <verse eid="MRK 7:33"/><verse number="34" style="v" sid="MRK 7:34"/>ሳሉዋ ፑደ ጼሊደ፥ ቶክ ሸምፒደ፥ “ኤፍታህ”<note caller="+" style="f"><char style="fr" closed="false">7:34 </char><char style="fqa" closed="false">ኤፍታህ፦ </char><char style="ft" closed="false">ሀ ቃላይ የሱስ ሀ አላምያን ደኢደ ታማርስያ ዎደ፥ ጎኤትያ አራማይከ ያገትያ ቃላን ሃሳዬዳዋ።</char></note> ያጌዳ፤ ሄዋ ግያዌ ዶየታ ግያዋ። <verse eid="MRK 7:34"/><verse number="35" style="v" sid="MRK 7:35"/>ብታንያ ሀይይ ኤለካ ዶየት አጌዳ፤ ቃይ አ ሃሳየና እንጻርሳይካ ብለት አጌዳ፤ ብታኒ አይነ ዋየተናን ሃሳዪ አጌዳ።<verse eid="MRK 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 7:36"/>የሱስ አሳዉ፥ “ሀዋ ኦስነ ኦዶፕተ” ያጊደ ኦዴዳ፤ ሽን እ ዳርስ ምንስ ኦድና፥ አሳይ ቃይ ኦዱዋ ያ ዳርሴዳ። <verse eid="MRK 7:36"/><verse number="37" style="v" sid="MRK 7:37"/>ሄዋ ስሴዳ አሳይ ኡባይ ዳሮ ማላለቲደ፥ “ኡባባካ እ ሎይ ኦ። ሀራይ አቶ ቱልያካ ስሴ፤ ቃይ ዱድያካ ሃሳይሴ” ያጌድኖ።<verse eid="MRK 7:37"/></para>
  <chapter eid="MRK 7"/>
  <chapter number="8" style="c" sid="MRK 8"/>
  <para style="s1">የሱስ ኦይዱ ሻአ አሳ ምዜዳ</para>
  <para style="r">(<ref loc="MAT 15:32-39">ማቶሳ 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1"/>ሄ ዎደ፥ ጮራ አሳይ ቃይ የሱሳኮ ሺቄዳ፤ አሳዉ ምያባይ ይና፥ የሱስ ባረና ካልያዋንታ ባረኮ ጼሲደ፥ <verse eid="MRK 8:1"/><verse number="2" style="v" sid="MRK 8:2"/>“ሀ ጮራ አሳይ ታናና ሄዙ ጋላሳይ ጋካናዉ ጋምኢደ፥ ምያባ አይነ ደምቤና ድራዉ፥ ታን ኡንቱንቶ ቃረታይ። <verse eid="MRK 8:2"/><verse number="3" style="v" sid="MRK 8:3"/>ታን ኡንቱንታ ኮሻና ሶይ የዶፐ፥ ቢደ ኦግያን ዳቡሪደ ኩንዳና፤ አያዉ ጎፐ፥ እቱ እቱ ሃኮ ሳፐ ዬዳ” ያጌዳ።<verse eid="MRK 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4"/>አ ካልያዋንቱ ዛሪደ፥ “ሀ አሳይ ባይና ሳን ሀ አሳ ኡባ ምዛናዉ ግድያ ቁማ ደማናዉ ዳንዳይያዌ ኦኔ?” ያጌድኖ።<verse eid="MRK 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5"/>የሱስ ኡንቱንታ፥ “ህንተንቶ አፑን ዳቡ ደኢ?” ያጊደ ኦቼዳ።</para>
  <para style="p" vid="MRK 8:5">ኡንቱንቱ፥ “ላፑ ዳቡ ደኤ” ያጌድኖ።<verse eid="MRK 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6"/>የሱስ አሳ፥ “ሳኣን ኡትተ” ያጊደ አዛዜዳ፤ ቃይ ላፑ ዳቡዋ አኪደ፥ ጾሳ ጋላቴዳ፤ ሄ ዳቡዋ መንደ፥ አሳዉ ግሻና ማላ፥ ባረና ካልያዋንቶ እሜዳ። የሱሳ ካልያዋንቱ ሄ ጮራ አሳዉ ግሼድኖ። <verse eid="MRK 8:6"/><verse number="7" style="v" sid="MRK 8:7"/>ኡንቱንቶ ቃይካ አማሬዳ ሱፓ ሞለቱ ደኢኖ፤ የሱስ ሄዋንቶካ ጾሳ ጋላቲደ፥ አሳዉ ግሻና ማላ፥ ባረና ካልያዋንታ አዛዜዳ። <verse eid="MRK 8:7"/><verse number="8" style="v" sid="MRK 8:8"/>አሳይ ኡባይ ሚደ ካልና አቴዳ ዶካይ ላፑ ዛምቤልያ ኩሜዳዋ አ ካልያዋንቱ ደንድኖ። <verse eid="MRK 8:8"/><verse number="9" style="v" sid="MRK 8:9"/>ቁማ ሜዳ አሳይ ኦይዱ ሻአ ግዳና፤ ሄዋፐ ጉይያን፥ የሱስ አሳ የዴዳ። <verse eid="MRK 8:9"/><verse number="10" style="v" sid="MRK 8:10"/>እ ቃይ ባረና ካልያዋንቱና ኤለካ ዎንግርያን ገሊደ፥ ዳልማኑታ<note caller="+" style="f"><char style="fr" closed="false">8:10 </char><char style="fq" closed="false">ዳልማኑታ፦ </char><char style="ft" closed="false">ሀዌ ኤረተና ሳኣ።</char></note> ግያ ጋድያ ቤዳ።<verse eid="MRK 8:10"/></para>
  <para style="s1">ፓርሳዋቱ ባረንቶ ማላታይ ኦሰታና ማላ ኦቼድኖ</para>
  <para style="r">(<ref loc="MAT 16:1-4">ማቶሳ 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11"/>ፓርሳዋቱ ዪደ፥ የሱሳና ፓሉማ ዶሜድኖ።</para>
  <para style="p" vid="MRK 8:11">የሱሳ ፓጫናዉ ኮዪደ፥ ሳሉዋፐ ማላታ ባረንታ በሳና ማላ ኦቼድኖ። <verse eid="MRK 8:11"/><verse number="12" style="v" sid="MRK 8:12"/>የሱስ ዳርስ ቶክ ሸምፒደ፥ “ሀ ዎድያ አሳይ አያዉ ማላታ ኮዪ? ታን ህንተንቶ ቱሙዋ ኦዳይ፤ ሀ ዎድያ አሳዉ ማላታይ ኡባካ እመተና” ያጌዳ። <verse eid="MRK 8:12"/><verse number="13" style="v" sid="MRK 8:13"/>ቃይ ኡንቱንታ ሄዋን አጊደ፥ ዛር ዎንግርያን ገሊደ፥ አባፐ ሄፍን ፕኔዳ።<verse eid="MRK 8:13"/></para>
  <para style="s1">ፓርሳዋቱዋ እርሹዋነ ሄሮድሳ እርሹዋ</para>
  <para style="r">(<ref loc="MAT 16:5-12">ማቶሳ 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14"/>የሱሳ ካልያዋንቱ ቁማ አፋናዋ ዶጌድኖ፤ ኡንቱንቶ ዎንግርያ ግዶን እት ኡክፐ ሀራይ ባዋ። <verse eid="MRK 8:14"/><verse number="15" style="v" sid="MRK 8:15"/>የሱስ ኡንቱንታ፥ “ህንተንታ ኤርተ፤ ፓርሳዋቱዋ እርሹዋፐነ ሄሮድሳ<note caller="+" style="f"><char style="fr" closed="false">8:15 </char><char style="fq" closed="false">ሄሮድሳ፦ </char><char style="ft" closed="false">ሀዌ ሄሮድሰ አንትጳሳ ጌተትያ ዎጋ ሄሮድሳ ጌተትያዋ ናኣ።</char></note> እርሹዋፐ ናገትተ” ያጊደ አዛዜዳ።<verse eid="MRK 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16"/>ኡንቱንቱ ባረንቱ ግዶን፥ “እ ሀዋ ግያዌ ኑዉ ቁማይ ባይና ድራሳ” ያጊደ ሃሳያ ዶሜድኖ።<verse eid="MRK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17"/>የሱስ ኡንቱንቱ ግያዋ ኤሪደ፥ “ህንተንቶ ዳቡ ባይናዋ አያዉ ሃሳዪቴ? ሀእ ጋካናዉ ህንተዉ ገለኔ? ዎይ አኬክክቴ? ህንተ ዎዛናይ ጆሌዴ? <verse eid="MRK 8:17"/><verse number="18" style="v" sid="MRK 8:18"/>ህንተንቶ አይፊ ደኤ፤ በእክቴ? ቃይ ሀይይ ደኤ፤ ስስክቴ? ህንተንቶ ሀሳየተኔ?<note caller="-" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="JER 5:21">ኤር. 5:21</ref>፤ <ref loc="EZK 12:2">ህዝ. 12:2</ref>፤ <ref loc="MRK 4:12">ማር. 4:12</ref></char></note> <verse eid="MRK 8:18"/><verse number="19" style="v" sid="MRK 8:19"/>ታን እቼሹ ዳቡዋ እቼሹ ሻአ አሳዉ መን እሜዳ ዎደ፥ አፑን ዛምቤልያ ኩሜዳ ዶካ ደንድቴ?” ያጌዳ።</para>
  <para style="p" vid="MRK 8:19">ኡንቱንቱ፥ “ታማነ ላኡ ዛምቤልያ ኩሜዳ ዶካ ደንዶ” ያጌድኖ።<verse eid="MRK 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20"/>“ታን ቃይካ ላፑ ዳቡዋ ኦይዱ ሻአ አሳዉ መንደ እሜዳ ዎደ፥ አፑን ዛምቤልያ ኩሜዳ ዶካ ደንድቴ?” ያጌዳ።</para>
  <para style="p" vid="MRK 8:20">ኡንቱንቱ፥ “ላፑ ዛምቤልያ ኩሜዳ ዶካ ደንዶ” ያጌድኖ።<verse eid="MRK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21"/>እ ቃይ፥ “ሀእካ አኬክበይክቴ?” ያጌዳ።<verse eid="MRK 8:21"/></para>
  <para style="s1">የሱስ ቤተሳይዳን እት ቆቃ ፓዳ</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22"/>የሱስነ አ ካልያዋንቱ ቤተሳይዳ ግያ ካታማ ቤድኖ፤ አሳቱ ቆቃ ብታንያ የሱሳኮ አሂደ፥ ሄ ብታንያ ቦቻና ማላ፥ አ ዎሴድኖ። <verse eid="MRK 8:22"/><verse number="23" style="v" sid="MRK 8:23"/>የሱስ ቆቃ ብታንያ ኩሽያ ኦይቂደ፥ ሄራፐ ጋጻ ከሴዳ፤ አ አይፍያን ጩቺደ፥ ባረ ኩሽያ አ ቦላ ዎደ፥ “ነዉ አየንቶ ቤቲ?” ያጊደ ኦቼዳ።<verse eid="MRK 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24"/>ብታኒ ቂደ፥ “ታን አሳ በአይ፤ ሽን አሳይ ሀመቲደ፥ ም ማላቴ” ያጌዳ።<verse eid="MRK 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25"/>ሄዋፐ ጉይያን፥ የሱስ ሽረቲደ ብታንያ አይፍያን ባረ ኩሽያ ዎዳ። አ አይፊ ፓጼዳ፤ ብታኒካ ሎይ ጼሌዳ፤ ቃይ ኡባባካ ጌሺደ በኤዳ። <verse eid="MRK 8:25"/><verse number="26" style="v" sid="MRK 8:26"/>የሱስ ብታንያ፥ “ሄራ ገሎፓ” ያግ አ ሶይ የዴዳ።<verse eid="MRK 8:26"/></para>
  <para style="s1">ጰጽሮሳ አማኑዋነ አ ማርካተ</para>
  <para style="r">(<ref loc="MAT 16:13-20">ማቶሳ 16:13-20</ref>፤ <ref loc="LUK 9:18-21">ሉቃሳ 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27"/>የሱስ ባረና ካልያዋንቱና ቂሳርያ ፕሊጶሳ ደእያ ቄር ሄራቱዋ ቤዳ፤ እ ቢሽን ኦግያን የሱስ፥ “ታና አሳይ ኦና ጊ?” ያጊደ ባረና ካልያዋንታ ኦቼዳ።<verse eid="MRK 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28"/>አ ካልያዋንቱ፥ “እት እት አሳይ ኔና፥ ‘ጻማቅያ ዮሃንሳ’ ጌ፤ ሀራንቱ፥ ‘ኤላሳ’ ጊኖ፤ ቃይ ሀራንቱ፥ ‘ናባቱዋፐ እቱዋ’ ጊኖ” ያጌድኖ።<verse eid="MRK 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29"/>የሱስ ኡንቱንታ፥ “ህንተሽ ታና ኦና ጊቴ?” ያጊደ ኦቼዳ።</para>
  <para style="p" vid="MRK 8:29">ጰጽሮስ፥ “ኔን ዶረቴዳ ክርስቶሳ” ያጊደ ዛሬዳ።<verse eid="MRK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30"/>የሱስ፥ “ታባ ኦስነ ኦዶፕተ” ያጊደ ኡንቱንታ አዛዜዳ።<verse eid="MRK 8:30"/></para>
  <para style="s1">የሱስ ባረና ጋካና መቱዋባነ ዋይያባ ኮይሩዋ ሃሳዬ</para>
  <para style="r">(<ref loc="MAT 16:21-28">ማቶሳ 16:21-28</ref>፤ <ref loc="LUK 9:22-27">ሉቃሳ 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31"/>የሱስ ባረና ካልያዋንታ፥ “ታን፥ አሳ ናአይ፥ ዳሪ ዋየታናዉ በሴ፤ ጭማቱ፥ ቄሳቱዋ ካፓቱነ ህግያ ታማርስያዋንቱ ታና እጻናዉ በሴ፤ ኡንቱንቱ ታና ዎናዉነ ታን ሄዘንያ ጋላሳፐ ጉይያን፥ ሀይቁዋፐ ደንዳናዉ በሴ” ያጊደ ታማርሱዋ ዶሜዳ። <verse eid="MRK 8:31"/><verse number="32" style="v" sid="MRK 8:32"/>ሄዋ እ ኡንቱንቶ ጌሺደ ኦዴዳ፤ ጰጽሮስ አ እት ባጋ ዛሪደ፥ ዞረታ ዶሜዳ።<verse eid="MRK 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33"/>ሽን የሱስ ጉየ ስሚደ፥ ባረና ካልያዋንታ ጼሊደ ጰጽሮሳ፥ “ሀ ሴጻናዉ፥ ክቻ ታ ማታፐ! ኔን አሳይ ቆፕያዋ ቆፓሳፐ አትን፥ ጾሳይ ቆፕያዋ ግደና” ያጌዳ።<verse eid="MRK 8:33"/></para>
  <para style="s1">የሱሳ ካሉሳይ ኦችያ ጋትያ</para>
  <para style="r">(<ref loc="MAT 10:38-39">ማቶሳ 10:38-39</ref>፤ <ref loc="MAT 16:24-28">16:24-28</ref>፤ <ref loc="LUK 9:23-27">ሉቃሳ 9:23-27</ref>፤ <ref loc="LUK 14:26-27">14:26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34"/>የሱስ ጮራ አሳነ ባረና ካልያዋንታ ባረኮ ጼሲደ፥ “ታና ካላና ኮይያ ኡራይ ደኦፐ፥ ባረና ካዶ፤ ያቲደ ባረ ማስቃልያ ቶኪደ፥ ታና ካሎ። <verse eid="MRK 8:34"/><verse number="35" style="v" sid="MRK 8:35"/>አያዉ ጎፐ፥ ባረ ሸምፑዋ<note caller="+" style="f"><char style="fr" closed="false">8:35 </char><char style="fk" closed="false">ሸምፑዋ፦ </char><char style="ft" closed="false">ግሪክያ ቃላን እዛዋ ዎይ አሳ ሸምፑዋ ጌተት ብለቴዳ።</char></note> አሻና ኮይያ ኡራይ ባይዛናዋ፤ ሽን ታ ድራዉነ ዎንጋላ ምሽራቹዋ ድራዉ ባረ ሸምፑዋ ባይዝያ ኡራይ አሻናዋ። <verse eid="MRK 8:35"/><verse number="36" style="v" sid="MRK 8:36"/>እት ኡራይ ሳኣን ደእያ ኡባባ ባረዉ ሺሺደ፥ ባረ ሸምፑዋ ባይዞፐ፥ አ አያ ማዳኔ? <verse eid="MRK 8:36"/><verse number="37" style="v" sid="MRK 8:37"/>እት ኡራይ ባረ ሸምፑዋ ዎዛናዉ አያ እማና ዳንዳይ? <verse eid="MRK 8:37"/><verse number="38" style="v" sid="MRK 8:38"/>ጾሳ አማነና ሀ ናጋራንቻ የለታ ዎድያን፥ እት ኡራይ ታናንነ ታ ቃላን ዬላቶፐ፥ ታንካ፥ አሳ ናአይ፥ ቃይ ታ አዉዋ ቦንቹዋን ጌሻ ኪታንቻቱዋና ይያ ዎደካ፥ አን ዬላታና” ያጌዳ።<verse eid="MRK 8:38"/></para>
  <chapter eid="MRK 8"/>
  <chapter number="9" style="c" sid="MRK 9"/>
  <para style="s1">የሱሳ ማላይ ላመቴዳዋ ኦድያ ታርክያ</para>
  <para style="r">(<ref loc="MAT 17:1-13">ማቶሳ 17:1-13</ref>፤ <ref loc="LUK 9:28-36">ሉቃሳ 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1"/>የሱስ ኡንቱንታ፥ “ታን ህንተንቶ ቱሙዋ ጋይ፤ አማሬዳ አሳቱ ጾሳ ካዉተይ ዎልቃና ይያዋ በኤናን ሀይቀናዋንቱ ሀዋን ደኢኖ” ያጌዳ።<verse eid="MRK 9:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2"/>የሱስ ኡሱፑን ጋላሳፐ ጉይያን፥ ባረናና ጰጽሮሳ፥ ያቆባነ ዮሃንሳ አኪደ፥ ኡንቱንቱ ጻላላ ዎልቃማ ደርያ ቦላ ከሴዳ፤ ኡንቱንቱ ስንን ላመቴዳ፤<note caller="-" style="x"><char style="xo" closed="false">9:2-7 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2 ጰጽ. 1:17-18</ref></char></note> <verse eid="MRK 9:2"/><verse number="3" style="v" sid="MRK 9:3"/>አ ማዩካ ጶሌዳ፤ ሳኣን ማዩዋ ሜጭያ ኦንነ ጌሻናዉ ዳንዳየናዋ ኬና ዳሪ ቦጼዳ። <verse eid="MRK 9:3"/><verse number="4" style="v" sid="MRK 9:4"/>ሄ ሄዙ የሱሳ ካልያዋንቱ፥ ኤላስነ ሙሴ የሱሳና ሃሳይያዋንታ በኤድኖ።<verse eid="MRK 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5"/>ጰጽሮስ የሱሳ፥ “ታማርስያዎ፥ ኑን ሀዋን ደእያዌ ኑዉ ሎአ፤ ኑን ሄዙ ዳሳቱዋ እቱዋ ነዉ፥ እቱዋ ሙሴዉ፥ ቃይ እቱዋ ኤላሳዉ ኬጻና” ያጌዳ። <verse eid="MRK 9:5"/><verse number="6" style="v" sid="MRK 9:6"/>እ ዋጋነንቶነ ኤርቤና፤ አያዉ ጎፐ፥ እካ የኮንቱካ ዳሪ ያዬድኖ።<verse eid="MRK 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7"/>ሄዋፐ ጉይያን፥ ሻሪ ዪደ ኡንቱንታ ካምና ሻርያፐ፥ “ሀዌ ታን ሲቅያ ታ ናኣ፤ እ ግያዋ ስስተ” ግያ ቃላይ ዬዳ። <verse eid="MRK 9:7"/><verse number="8" style="v" sid="MRK 9:8"/>ኤለካ ኡንቱንቱ ዩሽ አ ጼልያ ዎደ፥ የሱሳፐ አትን፥ ሀራ ኦናነ ባረንቱ ማታን በእበይክኖ።<verse eid="MRK 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9"/>ኡንቱንቱ ደርያፐ ዎሽን፥ የሱስ ኡንቱንታ፥ “ታን፥ አሳ ናአይ፥ ሀይቁዋፐ ደንዳና ጋካናዉ፥ ህንተ በኤዳባ ኦስነ ኦዶፕተ” ያጊደ አዛዜዳ።<verse eid="MRK 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10"/>እ አዛዜዳዋ ኡንቱንቱ፥ “ ‘ኤኖ’ ጊደ፥ ሀ ሀይቁዋፐ ደንድያዋ ግያዌ ዋግያዌ” ያጊደ፥ ባረንቱ ግዶን ሃሳየቴድኖ።<verse eid="MRK 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11"/>ኡንቱንቱ የሱሳ፥ “ህግያ ታማርስያዋንቱ አያዉ፥ ‘ኤላስ ካሰቲደ ያናዉ በሴ’ ጊኖ?” ያጊደ ኦቼድኖ።<verse eid="MRK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12"/>እ ዛሪደ ያጌዳ፤ “ቱማካ፥ ኤላስ ካሰት ዪደ፥ ኡባባ ጊግሴ፤ ያትና፥ አያዉ ጾሳ ማጻፋይ፥ ‘አሳ ናአይ ዳሪ ዋየታናነ እጸታና’ ያጊ? <verse eid="MRK 9:12"/><verse number="13" style="v" sid="MRK 9:13"/>ሽን ታን ህንተንቶ ኦዳይ፤ ኤላስ ዬዳ፤ ቃይ አባይ ጾሳ ማጻፋን ጻፈቴዳዋዳንካ፥ አሳይ አ ባረ ኮዬዳባ ኦዳ” ያጌዳ።<verse eid="MRK 9:13"/></para>
  <para style="s1">የሱስ ኢታ አያናይ ኦይቄዳ ናኣ ፓዳ</para>
  <para style="r">(<ref loc="MAT 17:14-21">ማቶሳ 17:14-21</ref>፤ <ref loc="LUK 9:37-43">ሉቃሳ 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14"/>የሱስ፥ ጰጽሮስ፥ ያቆብነ ዮሃንስ የኮ የሱሳ ካልያዋንቱኮ ስሚደ ይያ ዎደ፥ ጮራ አሳይ ሄ ካልያዋንቱ ዩሹዋን ኤቄዳዋነ ህግያ ታማርስያ አማሬዳ አሳቱ ኡንቱንቱና ፓሉመትያዋንታ በኤድኖ። <verse eid="MRK 9:14"/><verse number="15" style="v" sid="MRK 9:15"/>ሄ ጮራ አሳይ የሱሳ በኤዳ ዎደ ማላለት ዳጋሚደ፥ ኤለካ አኮ ዎጽ ዪደ፥ አ ሳሮቴዳ። <verse eid="MRK 9:15"/><verse number="16" style="v" sid="MRK 9:16"/>የሱስ ባረና ካልያዋንታ “ኡንቱንቱና አያ ፓሉመቲቴ?” ያጊደ ኦቼዳ።<verse eid="MRK 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17"/>ሄ ጮራ አሳ ግዶፐ እት ብታኒ ዛሪደ፥ “ታማርስያዎ፥ ታ ናኣ ቦላን ሃሳያ ድግያ ኢታ አያናይ ደእያ ድራዉ፥ አ ኔኮ አካደ ያድ። <verse eid="MRK 9:17"/><verse number="18" style="v" sid="MRK 9:18"/>ሀ ኢታ አያናይ አ ኦይቂያ ዎደ ኡባን፥ አ ኦሌ፤ አ ዶናናካ ሆሙ ፓሮቴ፤ ቃይ አቻ ጋርጭሴ፤ ቦላካ ዞልሴ። አፐ ሀ ኢታ አያና ከሳና ማላ፥ ኔና ካልያዋንቶ ኦዳድ፥ ሽን ከሳናዉ ዳንዳይበይክኖ” ያጌዳ።<verse eid="MRK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19"/>የሱስ ዛሪደ ኡንቱንታ፥ “አማነና ሀ ዎድያ አሳዉ! ታን ህንተንቱና አዉደ ጋካናዉ ደአኔ? ቃይ ህንተንቱባ አዉደ ጋካናዉ ዳንዳያኔ? ናኣ ታኮ ሃ አክ ዪተ” ያጌዳ። <verse eid="MRK 9:19"/><verse number="20" style="v" sid="MRK 9:20"/>ኡንቱንቱ ናኣ አኮ አሄድኖ፤ ሄ ኢታ አያናይ የሱሳ በኢዴ ኤለካ ናኣ ኮኮርሲ አጌዳ፤ ናአይ ሳኣን ኩንዲደ፥ ዶናና ሆሙ ጎፑ ጊሽን ጎንዶረቴዳ። <verse eid="MRK 9:20"/><verse number="21" style="v" sid="MRK 9:21"/>የሱስ ሄ ናኣ አዉዋ፥ “ሀዌ ነ ናኣ ኦይቆደፐ ዎይሳ ዎደ ግዳኔ?” ያጊደ ኦቼዳ።</para>
  <para style="p" vid="MRK 9:21">ናኣ አቡ፥ “እ ናአተን ደእያ ዎድያፐ ዶሜዳ። <verse eid="MRK 9:21"/><verse number="22" style="v" sid="MRK 9:22"/>አ ዎናዉ ዳሮ ዎደ ታማንነ ሃን ኦሌዳ፤ ሽን ኔን ዳንዳዮፐ፥ ኑዉ ቃረታደ ኑና ማዳርኪ” ያጌዳ።<verse eid="MRK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23"/>የሱስ አ፥ “ኔን ዳንዳዮፐ ጋይ? አማንያ አሳዉ ኡባባይ ዳንዳየቴ” ያጌዳ።<verse eid="MRK 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24"/>ኤለካ ናኣ አቡ ባረ ኮሻ ቁ ኦደ፥ “ታን አማናይ፤ ሽን ጉጃ አማናናዳን፥ ታና ማዳርኪ” ያጌዳ።<verse eid="MRK 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25"/>የሱስ አሳይ ዳር ዳር ብያዋ በኢደ፥ ኢታ አያና፥ “ናኣ ቱለነ ዱደ ኦዳ አያናዉ፥ ሀ ናኣፐ ከሳ ጋደ ኔና ታ አዛዛይ፤ ቃይ ዛረደ አን ገሎፓ” ያጌዳ።<verse eid="MRK 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26"/>ሄ ኢታ አያናይ ዋሲደ፥ ናኣ ዳርስ ኮኮርሲደ፥ አፐ ከሴዳ። ናአይ ሀይቄዳዋ ማላትና፥ ዳሮ አሳይ፥ “ናአይ ሀይቄዳ” ያጌዳ። <verse eid="MRK 9:26"/><verse number="27" style="v" sid="MRK 9:27"/>ሽን የሱስ ናኣ ኩሽያ ኦይቂደ ደንና፥ ናአይ ደንድ ኤቄዳ።<verse eid="MRK 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28"/>የሱስ ሶይ ገሌዳዋፐ ጉይያን፥ አ ካልያዋንቱ የሱሳ ዱማ፥ “ኑን ሄ ኢታ አያና ከሳናዉ አያዉ ዳንዳይበይኮ?” ያጊደ ኦቼድኖ።<verse eid="MRK 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29"/>የሱስ ዛሪደ፥ “ሄዋ ማላይ ዎሳፐነ ጾማፐ አትን፥ ሀራባን ከሳናዉ ዳንዳየና” ያጌዳ።<verse eid="MRK 9:29"/></para>
  <para style="s1">የሱስ ባረና ጋካና መቱዋባነ ሀይቁዋባ ላኤንዋ ኦዴዳ</para>
  <para style="r">(<ref loc="MAT 17:22-23">ማቶሳ 17:22-23</ref>፤ <ref loc="LUK 9:43-45">ሉቃሳ 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30"/>ኡንቱንቱ ሄዋፐ ደንዲደ፥ ጋሊላና አደ ቤድኖ፤ የሱስ ባረ ደኢያሳ ኦንነ ኤራና ማላ ኮይቤና። <verse eid="MRK 9:30"/><verse number="31" style="v" sid="MRK 9:31"/>አያዉ ጎፐ፥ እ ባረና ካልያዋንታ “ታና፥ አሳ ናኣ፥ አሳይ አሳዉ አደ እማናነ ዎና፤ ታን ቃይ ሄዙ ጋላሳፐ ጉይያን፥ ሀይቁዋፐ ደንዳና” ያጊደ ታማርሴ።<verse eid="MRK 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32"/>ሽን ኡንቱንቶ እ ግያዌ ገልቤና፤ ቃይ አ ኦቻናዉካ ያዬድኖ።<verse eid="MRK 9:32"/></para>
  <para style="s1">ኡባፐ አያዌ ኦኔ?</para>
  <para style="r">(<ref loc="MAT 18:1-5">ማቶሳ 18:1-5</ref>፤ <ref loc="LUK 9:46-48">ሉቃሳ 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33"/>ኡንቱንቱ ቅፍርናሆማ ግያ ካታማ ቤድኖ፤ ሶይ ገሌዳዋፐ ጉይያን፥ የሱስ ኡንቱንታ፥ “ኦግያን አያ ፓሉመቲቴ?” ያጊደ ኦቼዳ። <verse eid="MRK 9:33"/><verse number="34" style="v" sid="MRK 9:34"/>ሽን ኡንቱንቱ ቢደ ኦግያን፥ “ኑ ግዶን ኑ ኡባፐ አያዌ ኦኔ?” ያጊደ ፓሉመቴዳ ድራዉ፥ ጮኡ ጌድኖ። <verse eid="MRK 9:34"/><verse number="35" style="v" sid="MRK 9:35"/>የሱስ ኡቲደ፥ ታማነ ላኡ ባረና ካልያዋንታ ጼሲደ ኡንቱንታ፥ “ኦንነ ስንዉ አና ኮዮፐ፥ ኡባፐ ጉየ አደ፥ ሄ ኡባዉ ቆማ ግዳናዉ በሴ” ያጌዳ።<verse eid="MRK 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36"/>እት ጉ ናኣ ኦይቂደ፥ ኡንቱንቱ ግዶን ኤሴዳ፤ ሄ ጉ ናኣ እድሚደ ኡንቱንታ፥ <verse eid="MRK 9:36"/><verse number="37" style="v" sid="MRK 9:37"/>“ሀዋንቱ ማላ ጉ ናናፐ እቱዋ ታ ሱንን ሞክያ ኦንነ ታና ሞኬ፤ ቃይ ታና ሞክያ ኦንነ ታና ኪቴዳዋ ሞክያዋፐ አትን፥ ታ ጻላላ ሞከና” ያጌዳ።<verse eid="MRK 9:37"/></para>
  <para style="s1">የሱስ፥ “ኑባ ኤቀተና ኡራይ ኑ ባጋ” ያጌዳ</para>
  <para style="r">(<ref loc="LUK 9:49-50">ሉቃሳ 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38"/>ዮሃንስ አ፥ “ታማርስያዎ፥ እት አሳይ ነ ሱንን ኢታ አያናቱዋ ከስያዋ ኑን በኢደ፥ ኑ ባጋ ግደና ድራዉ፥ አ ድጌዶ” ያጌዳ።<verse eid="MRK 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39"/>ሽን የሱስ ያጌዳ፤ “ኦንነ ታ ሱንን ማላታ ኦደ፥ ኤለካ ታ ቦላ ኢታባ ሃሳያናዉ ዳንዳይያዌ ባይና ድራዉ ድጎፕተ፤ <verse eid="MRK 9:39"/><verse number="40" style="v" sid="MRK 9:40"/>አያዉ ጎፐ፥ ኑባ ኤቀተና ኡራይ ኑ ባጋ። <verse eid="MRK 9:40"/><verse number="41" style="v" sid="MRK 9:41"/>ታን ህንተንቶ ቱሙዋ ኦዳይ፤ ህንተ ታዋንታ ክርስቶሳዋንታ ግድያ ድራዉ፥ ኦንነ ህንተንቶ ታ ሱንን ቡልያ ሃ ኡሻናዉ እሞፐካ፥ ባረ ጋትያ አካናዋ።<verse eid="MRK 9:41"/></para>
  <para style="s1">ናጋራ ጋሱዋ</para>
  <para style="r">(<ref loc="MAT 18:6-9">ማቶሳ 18:6-9</ref>፤ <ref loc="LUK 17:1-2">ሉቃሳ 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42"/>“ታና አማንያ ሀ ጉቱዋፐ እቱዋ ባለያ ኦናነ፥ ጋጭያ ዎጋ ዎጻ አ ቆያን ቃቺደ፥ አባን አ ኦልያዌ አዉ ሎአ። <verse eid="MRK 9:42"/><verse number="43-44" style="v" sid="MRK 9:43-44"/>ነ ኩሺ ኔና ባለፐ፥ ቃንጻ ኦላ፤ ኔን ላኡ ኩሽያና<note caller="+" style="f"><char style="fr" closed="false">9:43-44 </char><char style="ft" closed="false">ሀራ ጌሻ ማጻፋ ብለቱ፥ ጉጹኒ ሙለ ሀይቀናሳነ ቃይ ሙለካ ቶኤና ጋናምያ ታማን፥ ያጌ። 9:45፣ 47 ጼልተ።</char></note> ቃይ ኡባካ ቶኤና ጋናምያ ታማን ገልያዋፐ፥ ዱጻ ኩሽያና ደኡዋ ገልያዌ ነዉ ሎአ። <verse eid="MRK 9:43-44"/><verse number="45-46" style="v" sid="MRK 9:45-46"/>ነ ገዲ ኔና ባለፐ፥ ቃንጻ ኦላ፤ ኔን ላኡ ገድያና ኡባካ ቶኤና ጋናምያ ታማን የገትያዋፐ፥ ዶማ ግዳደ ደኡዋ ገልያዌ ነዉ ሎአ። <verse eid="MRK 9:45-46"/><verse number="47-48" style="v" sid="MRK 9:47-48"/>ነ አይፊ ኔና ባለፐ፥ ዎጫ ኦላ፤ ኔን ላኡ አይፍያና ኡባካ ቶኤና ጋናምያ ታማን የገትያዋፐ፥ እት አይፍያና ጾሳ ካዉተ ገልያዌ ነዉ ሎአ።<verse eid="MRK 9:47-48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49"/>“ቁማን ማጽንያ የግያዋዳን፥ ታማይ አሳ ኡባ ቦላ የገታና። <verse eid="MRK 9:49"/><verse number="50" style="v" sid="MRK 9:50"/>ማጽኒ ሎአ፤ ሽን እ ማልአና ዮፐ፥ ዛሪደ አ ዎት ማልኤንቴ? ህንተንቱን ማጽኒ ደኦ፤<note caller="+" style="f"><char style="fr" closed="false">9:50 </char><char style="fq" closed="false">ህንተንቱን ማጽኒ ደኦ፦ </char><char style="ft" closed="false">ሀዋ ጉሳይ የሱሳን አማንያዋንቱ ባረንቱ አማኑዋፐ ደንዶ ጋሱዋን ኡንቱንቱ ቦላ መቱ ጋክንቶካ እቱ እቱዋና ሳሮተን ደአናዉ በሴ።</char></note> ያቲደ እቱ እቱዋና ሳሮተን ደእተ” ያጌዳ።<verse eid="MRK 9:50"/></para>
  <chapter eid="MRK 9"/>
  <chapter number="10" style="c" sid="MRK 10"/>
  <para style="s1">ማቻቶ የዳናዉ በሰና</para>
  <para style="r">(<ref loc="MAT 19:1-2">ማቶሳ 19:1-2</ref>፤ <ref loc="LUK 16:18">ሉቃሳ 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1"/>የሱስ ሄዋፐ ደንዲደ፥ ዮርዳኖሳ ሻፋፐ ሄፍን ባጋና ይሁዳ ጋድያ ቤዳ። ጮራ አሳይ ሽረቲደ አኮ ሺቅና፥ ካሰ እ ኦያዋዳንካ ሄ አሳ ታማርሱዋ ዶሜዳ።<verse eid="MRK 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2"/>እት እት ፓርሳዋቱ ፓጫናዉ የሱሳኮ ዪደ፥ “እት አሳይ ባረ ማቻቶ የዳናዉ ኑዉ ህጊ አዛዚ?” ያጊደ አ ኦቼድኖ።<verse eid="MRK 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3"/>እ ዛሪደ፥ “ሙሴ ህንተንታ ዋግ አዛዜዴ?” ያጌዳ።<verse eid="MRK 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4"/>ኡንቱንቱ፥ “ሙሴ፥ ‘እት አሳይ ባረ ማቻቶ ፓራማ እሚደ የዶ’ ጌዳ” ያጌድኖ።<note caller="-" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">ዛረ. 24:1-4</ref>፤ <ref loc="MAT 5:13">ማቶሳ 5:13</ref></char></note><verse eid="MRK 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5"/>የሱስ ዛሪደ ኡንቱንታ፥ “ህንተንቱ ኦድና ስሰናዋንታ ግድያ ድራዉ፥ ሙሴ ሀ አዛዙዋ ህንተንቶ ጻፌዳ። <verse eid="MRK 10:5"/><verse number="6" style="v" sid="MRK 10:6"/>ሽን ጾሳይ ኮይሮ መያ ዎደ፥ አቱማ አሳነ ማጫ አሳ ኦደ፥ ኡንቱንታ መዳ።<note caller="-" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="GEN 1:27">ዶመ 1:27</ref>፤ <ref loc="GEN 5:2">5:2</ref></char></note> <verse eid="MRK 10:6"/><verse number="7" style="v" sid="MRK 10:7"/>ሄዋ ድራዉ፥ እት አሳይ ባረ አባነ ባረ ዳዮ አጊደ፥ ባረ ማቻትና እቱዋ ግዴ፤ <verse eid="MRK 10:7"/><verse number="8" style="v" sid="MRK 10:8"/>ኡንቱንቱ ላአቱ እት አሾ ግዲኖ፤ ሄዋ ድራዉ፥ ኡንቱንቱ እት አሳ ግድያዋፐ አትን፥ ላኡ አሳ ግድክኖ።<note caller="-" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="GEN 2:24">ዶመ 2:24</ref></char></note> <verse eid="MRK 10:8"/><verse number="9" style="v" sid="MRK 10:9"/>ሄዋ ድራዉ፥ ጾሳይ እትፐ ጋዳዋ አሳይ ሻኮፖ” ያጌዳ።<verse eid="MRK 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10"/>ኡንቱንቱ ሶይ ስሜዳ ዎደ፥ የሱሳ ካልያዋንቱ ሀ የዉዋባ የሱሳ ዛር ኦቼድኖ። <verse eid="MRK 10:10"/><verse number="11" style="v" sid="MRK 10:11"/>የሱስ ኡንቱንታ፥ “ባረ ማቻቶ የዲደ፥ ሀራሮ አክያ ኡራይ ኦንነ እዝና ዎሹሜ። <verse eid="MRK 10:11"/><verse number="12" style="v" sid="MRK 10:12"/>ቃይ ማጫዉናካ ባረ አስናፐ ከሳደ ሀራ አስና ገሎፐ ዎሹማዉ” ያጌዳ።<verse eid="MRK 10:12"/></para>
  <para style="s1">የሱስ ጉ ናና አንጄዳ</para>
  <para style="r">(<ref loc="MAT 19:13-15">ማቶሳ 19:13-15</ref>፤ <ref loc="LUK 18:15-17">ሉቃሳ 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13"/>የሱስ ጉ ናና ቦቻና ማላ፥ እት እት አሳይ ናና አኮ አሄዳ፤ ሽን የሱሳ ካልያዋንቱ ሄ አሳ ሴሬድኖ። <verse eid="MRK 10:13"/><verse number="14" style="v" sid="MRK 10:14"/>የሱስ ሄዋ በኢደ፥ ባረና ካልያዋንታ ሀንቀቴዳ፤ ኡንቱንታ፥ “ጉ ናናይ ታኮ ይያዋንታ ድጎፕተ፤ አያዉ ጎፐ፥ ጾሳ ካዉተይ ሀዋንቱ ማላሳ። <verse eid="MRK 10:14"/><verse number="15" style="v" sid="MRK 10:15"/>ታን ህንተንቶ ቱሙዋ ጋይ፤ ጾሳ ካዉተ ጉ ናኣዳን አከና ኡራይ ኦንነ ሄ ካዉተ ኡባካ ገለና” ያጌዳ። <verse eid="MRK 10:15"/><verse number="16" style="v" sid="MRK 10:16"/>ጉ ናና እድሚደ፥ ባረ ኩሽያ ኡንቱንቱ ቦላ ሁጲያን ሁጲያን ዎደ፥ ኡንቱንታ አንጄዳ።<verse eid="MRK 10:16"/></para>
  <para style="s1">ሚሻ ሲቁሳይ አህያ መቱዋ</para>
  <para style="r">(<ref loc="MAT 19:16-30">ማቶሳ 19:16-30</ref>፤ <ref loc="LUK 18:18-30">ሉቃሳ 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17"/>የሱስ ባናዉ ከሴዳ ዎደ፥ እት ብታኒ ዎጺደ ይ አ ስንን ጉልባቲደ፥ “ሎኦ ታማርስያዎ፥ መና ደኡዋ ላታናዉ ታን አያ ኦ?” ያጊደ አ ኦቼዳ።<verse eid="MRK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18"/>የሱስ፥ “አያዉ ታና ሎኦ ጋይ? ጾሳ ጻላላፐ አትን፥ ሀራ ሎኡ ኦንነ ባዋ። <verse eid="MRK 10:18"/><verse number="19" style="v" sid="MRK 10:19"/>ጾሳ አዛዙዋ፥ ‘ዎፓ፤ ዎሹሞፓ፤ ዉኦፓ፤ ዎርዱዋ ማርካቶፓ፤ ጭሞፓ፤ ነ አባነ ነ ዳዮ ቦንቻ’ ያግያዋ ኤራሳ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">ከሳ 20:12-16</ref>፤ <ref loc="DEU 5:16-20">ዛረ. 5:16-20</ref></char></note><verse eid="MRK 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20"/>ብታኒ የሱሳ፥ “ታማርስያዎ፥ ታን ሄዋ ኡባ ናአተፐ ዶማደ ሀእ ጋካናዉካ ናጋይ” ያጌዳ።<verse eid="MRK 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21"/>የሱስ ብታንያ ዶሴዳ፤ አ ጫድ ጼሊደ፥ “ነዉ እትባይ ፓጬዳ፤ ባደ ነዉ ደእያባ ኡባ ዛልኣደ፥ ሄ ሚሻ ህዬሳዉ እማ፤ ኔን ሳሉዋን ዱረታና። ያቶዋፐ ጉይያን ያደ ታና ካላ” ያጌዳ። <verse eid="MRK 10:21"/><verse number="22" style="v" sid="MRK 10:22"/>ሽን ብታኒ ሄዋ ስሲደ፥ እ ዳሮ ዱረ ግድያ ድራዉ፥ ባረ ሶምእያ ምሲደ፥ ናሸተናን አጊደ ቤዳ።<verse eid="MRK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23"/>የሱስ ባረና ካልያዋንታ ዩሽ አ ጼሊደ፥ “ዳሮ ዱረ አሳይ ጾሳ ካዉተ ገላናዉ ዋን መታንዴሻ!” ያጌዳ።<verse eid="MRK 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24"/>አ ካልያዋንቱ አ ሃሳያ ስሲደ ማላለቴድኖ፤ ሽን የሱስ ቃይካ ኡንቱንታ፥ “ናቶ፥ ጾሳ ካዉተ ገላናዉ ዎት መታንዴሻ!<note caller="+" style="f"><char style="fr" closed="false">10:24 </char><char style="fk" closed="false">ዎት መታንዴሻ፦ </char><char style="ft" closed="false">ሀዋ እት እት ብለይ ባረዉ ደእያባን አማነትያ አሳ ያጌ።</char></note> <verse eid="MRK 10:24"/><verse number="25" style="v" sid="MRK 10:25"/>ዱረ አሳይ ጾሳ ካዉተ ገላናዋፐ፥ ጋሉ ማርፕያ ጾእያና አናዌ ማታቴ” ያጌዳ።<verse eid="MRK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26"/>የሱሳ ካልያዋንቱ ማላለቲደ፥ “ያትና፥ ኦኔ አታናዉ ዳንዳይያዌ?” ያጊደ እቱ እቱዋ ኦቼድኖ።<verse eid="MRK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27"/>የሱስ ኡንቱንታ ጫድ ጼሊደ፥ “ሀዌ ጾሳዉ ዳንዳየትያዋፐ አትን፥ አሳዉ ዳንዳየተና፤ አያዉ ጎፐ፥ ጾሳዉ ኡባባይካ ዳንዳየቴ” ያጌዳ።<verse eid="MRK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28"/>ጰጽሮስ የሱሳ፥ “በአ፤ ኑን ኑባ ኡባ አጊደ፥ ኔና ካሌዶ” ያጌዳ።<verse eid="MRK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29"/>የሱስ፥ “ታን ህንተንቶ ቱሙዋ ጋይ፤ ታ ድራዉነ ዎንጋላ ምሽራቹዋ ድራዉ፥ ጎልያ ዎይ እሻቱዋ ዎይ ምቻቱዋ፥ ዎይ አዉዋ ዎይ አቶ ዎይ ማቻቶ፥ ዎይ ናና ዎይ ጋድያ አጌዳ አሳይ ኦንነ፥ <verse eid="MRK 10:29"/><verse number="30" style="v" sid="MRK 10:30"/>ሀእ ሀ ዎድያን ጼቱ ዳኩዋፐ ዳርያ ጎለቱዋ፥ እሻቱዋ፥ ምቻቱዋ፥ አቶ፥ ናና፥ ጋድያ፥ ቃይ መቱዋካ አካናዋ። ስንፐ ያና ዎድያንካ መና ደኡዋ አካናዋ። <verse eid="MRK 10:30"/><verse number="31" style="v" sid="MRK 10:31"/>ሽን ጮራቱ ሀእ ስንን ደእያዋንቱ ጉየ አና፤ ቃይ ጮራቱ ሀእ ጉየን ደእያዋንቱ ስንዉ አና” ያጌዳ።<verse eid="MRK 10:31"/></para>
  <para style="s1">የሱስ ባረና ጋካና መቱዋባነ ሀይቁዋባ ሄዘንዋ ኦዴዳ</para>
  <para style="r">(<ref loc="MAT 20:17-19">ማቶሳ 20:17-19</ref>፤ <ref loc="LUK 18:31-34">ሉቃሳ 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32"/>ኡንቱንቱ የሩሳላመ ቢደ፥ ኦግያን ደኢኖ፤ የሱስ ባረና ካልያዋንቱፐ ስንና ሀመቴ። ኡንቱንቱ ማላለቴድኖ፤ አ ካልያዋንቱ ያዬድኖ። ዛሪደ ታማነ ላኡ ባረና ካልያዋንታ ጋጻ ከሲደ፥ ባረና ጋካናባ ዱማዪደ ኡንቱንቶ ሀዋዳን ያጊደ ኦዴዳ፤ <verse eid="MRK 10:32"/><verse number="33" style="v" sid="MRK 10:33"/>“በእተ፤ ኑን የሩሳላመ ሀእ ከሶይተ፤ ያን ታና፥ አሳ ናኣ፥ ቄሳቱዋ ካፓቶነ ሙሴ ህግያ ታማርስያዋንቶ አደ እማና። ኡንቱንቱ ታ ቦላን ሀይቁዋ ፕርዳ ፕርዳና፤ ቃይ አይሁዳ ግደና አሳዉካ ታና አደ እማና። <verse eid="MRK 10:33"/><verse number="34" style="v" sid="MRK 10:34"/>ሄ አይሁዳ ግደና አሳይ ታ ቦላ ቅሊጫናነ ጩቻና፤ ታና ልሱዋን ሾጫናነ ዎና፤ ታን ቃይ ሄዙ ጋላሳፐ ጉይያን፥ ሀይቁዋፐ ደንዳና።”<verse eid="MRK 10:34"/></para>
  <para style="s1">ያቆብነ ዮሃንስ ዎሴዳ ዎሳ</para>
  <para style="r">(<ref loc="MAT 20:20-28">ማቶሳ 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35"/>ዛብድዮሳ ናናይ ያቆብነ ዮሃንስ የሱሳኮ ዪደ፥ “ታማርስያዎ፥ ኑን ኔና ዎስያባ ኡባባ ኑዉ ኦርኪ” ያጌድኖ።<verse eid="MRK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36"/>የሱስ ኡንቱንታ፥ “ታን ህንተንቶ አያ ኦ?” ያጌዳ።<verse eid="MRK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37"/>ኡንቱንቱ አ፥ “ነ ቦንቾ ካዉተን ኔን ኡትያ ዎደ፥ ኑፐ እቱዋ ኔፐ ኡሸቻ ባጋና ቃይ እቱዋ ሀድርሳ ባጋና ኡትሳርኪ” ያጌድኖ።<verse eid="MRK 10:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38"/>ሽን የሱስ ኡንቱንታ፥ “ህንተንቱ አያ ዎሳናዉ በስንቶካ ኤርክታ፤ ታን ኡሻናዉ በስያ መቱዋ ጹኣ ኡሻናዉ ዳንዳዪቴ? ቃይ ታን ጻማቀታናዉ በስያ ጽንቃታ<note caller="+" style="f"><char style="fr" closed="false">10:38 </char><char style="fk" closed="false">ጽንቃታ፦ </char><char style="ft" closed="false">ሀዋ ጉሳይ የሱሳ ጋኬዳ መቱዋ ጹኣ ጉሳ።</char></note> ጻማቀታናዉ ዳንዳዪቴ?” ያጌዳ።<verse eid="MRK 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39"/>ሄዋፐ ጉየ ኡንቱንቱ ዛሪደ፥ “ኤ ዳንዳዬቶ” ያጌድኖ።</para>
  <para style="p" vid="MRK 10:39">የሱስ ቃይ፥ “ታን ኡሻናዉ በስያ መቱዋ ጹኣ ህንተ ኡሻና፤ ታን ጻማቀታናዉ በስያ ጽንቃታካ ህንተ ጻማቀታና። <verse eid="MRK 10:39"/><verse number="40" style="v" sid="MRK 10:40"/>ሽን ታፐ ኡሸቻ ባጋናነ ሀድርሳ ባጋና ኡታናዋንታ ዶርያዌ ታና ግድከ፤ ሽን ሄ ሳአይ ጾሳይ እማናዉ ጊግስ ዎዳዋንቱሳ” ያጌዳ።<verse eid="MRK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41"/>የኮ ታሙ የሱሳ ካልያዋንቱ ሄዋ ስሴዳ ዎደ፥ ያቆባነ ዮሃንሳ ሀንቀቴድኖ። <verse eid="MRK 10:41"/><verse number="42" style="v" sid="MRK 10:42"/>የሱስ ኡንቱንታ ኡባ ባረኮ ጼሲደ፥ ሀዋዳን ያጌዳ፤ “ ‘አይሁዳ ግደናዋንታ ሞድያዋንታ’ ጊደ ቆፕያዋንቱነ ሄዋንታ ካለያ አሳቱ ባረንቱ አሳ ሞድያዋ ኤሪታ። <verse eid="MRK 10:42"/><verse number="43" style="v" sid="MRK 10:43"/>ሽን ህንተ ግዶን ሄዋ ማላ ግደና፤ ህንተ ግዶን ዎጋታና ኮይያ ኦንነ ህንተንቶ ቆማ ግዳናዉ በሴ። <verse eid="MRK 10:43"/><verse number="44" style="v" sid="MRK 10:44"/>ቃይ ህንተ ግዶን ኡባፐ ቦላ ግዳና ኮይያ ኦንነ ህንተ ኡባዉ አይለ ግዳናዉ በሴ። <verse eid="MRK 10:44"/><verse number="45" style="v" sid="MRK 10:45"/>አያዉ ጎፐ፥ ሀራይ አቶ ታን፥ አሳ ናአይካ፥ አሳዉ ኦናዉነ ጮራቱዋ ዎዛናዉ ዬዳዋፐ አትን፥ አሳይ ታዉ ኦና ማላ ያበይከ” ያጌዳ።<verse eid="MRK 10:45"/></para>
  <para style="s1">የሱስ ቆቃ ባርጻሞሳ አይፍያ ፓዳ</para>
  <para style="r">(<ref loc="MAT 20:29-34">ማቶሳ 20:29-34</ref>፤ <ref loc="LUK 18:35-43">ሉቃሳ 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46"/>ኡንቱንቱ እያርኮ ግያ ካታማ ቤድኖ፤ የሱስ ባረና ካልያዋንቱናነ ጮራ አሳና እያርኮፐ ከስሽን፥ ጽሞሳ ናአይ ቆቃይ፥ ባርጻሞሳ ግያዌ፥ ኦግያ ዶናን ዎሲደ ኡቴዳ። <verse eid="MRK 10:46"/><verse number="47" style="v" sid="MRK 10:47"/>ባርጻሞስ ናዝሬትያ የሱሳ ግዴዳዋ ስሲደ፥ ባረ ኮሻ ቁ ኦደ፥ “ዳዊተ ናኣ<note caller="+" style="f"><char style="fr" closed="false">10:47 </char><char style="fq" closed="false">ዳዊተ ናኣ፦ </char><char style="ft" closed="false">አይሁደ አሳቱ ጾሳን ኦከቶዌ ዳዊተ ዘረፐ የለታናዋ ያጊደ ቆፕያ ድራዉ፥ ጾሳን ኦከቶዌ “ዳዊተ ናኣ” ያገት ጼሰቴ።</char></note> የሱሳ፥ ታና ማራርኪ!” ያጉሳ ዶሜዳ።<verse eid="MRK 10:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48"/>ጮራ አሳይ አ፥ “ሀይዛ!” ጊደ ሀንቀቴዳ።</para>
  <para style="p" vid="MRK 10:48">ሽን፥ እ ባረ ኮሻ ካሰዋፐካ ዳርስ ቁ ኦደ፥ “ዳዊተ ናአዉ፥ ታና ማራርኪ!” ያጌዳ።<verse eid="MRK 10:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49"/>የሱስ ኦግያን ኤቂደ፥ “አ ሃ ጼስተ” ያጌዳ።</para>
  <para style="p" vid="MRK 10:49">ኡንቱንቱ ቆቃ፥ “አይነ ባዋ፤ ደንዳ ኤቃ፤ ኔና ጼሴ” ያጊደ ጼሴድኖ። <verse eid="MRK 10:49"/><verse number="50" style="v" sid="MRK 10:50"/>ቆቃይ ባረ ማዩዋ ኦል አጊደ፥ ጉፕ ደንድ ኤቂደ፥ የሱሳኮ ቤዳ።<verse eid="MRK 10:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51"/>የሱስ አ፥ “ታን ነዉ አያ ኦናዉ ኮያይ?” ያጌዳ።</para>
  <para style="p" vid="MRK 10:51">ቆቃይ፥ “ታማርስያዎ፥ ታን ጼላናዋ ኮያይ” ያጌዳ።<verse eid="MRK 10:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52"/>የሱስ አ፥ “ባ፤ ነ አማኑ ኔና ፓዳ” ያጌዳ። ኤለካ አ አይፊ ጼል አግና፥ ኦግያን የሱሳ ካል አጌዳ።<verse eid="MRK 10:52"/></para>
  <chapter eid="MRK 10"/>
  <chapter number="11" style="c" sid="MRK 11"/>
  <para style="s1">የሱስ ዎልቃማ ቦንቹዋን የሩሳላመ ገሌዳ</para>
  <para style="r">(<ref loc="MAT 21:1-11">ማቶሳ 21:1-11</ref>፤ <ref loc="LUK 19:28-40">ሉቃሳ 19:28-40</ref>፤ <ref loc="JHN 12:12-19">ዮሃ. 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1"/>ኡንቱንቱ የሩሳላመ ማቲደ፥ ደብረ ዛይተ ደርያ ማታን ደእያ ቤተፋገነ ቢታንያ ጋኬድኖ፤ የሱስ ባረና ካልያዋንቱፐ ላኡዋ ስንዉ ኪቲደ፥ <verse eid="MRK 11:1"/><verse number="2" style="v" sid="MRK 11:2"/>“ህንተንቱፐ ስንን ደእያ ሄራ ቢተ፤ ያ ገሎሳና ኦንነ ኡባ ቶግቤና ቃሹዋን ደእያ ሀረ ማራ ህንተ ደማና፤ አ ብል ሃ አኪደ ዪተ። <verse eid="MRK 11:2"/><verse number="3" style="v" sid="MRK 11:3"/>ኦንነ ህንተንታ፥ ‘ሄዋ አያዉ ኦተ?’ ያጊደ ኦቾፐ፥ ‘ጎዳዉ<note caller="+" style="f"><char style="fr" closed="false">11:3 </char><char style="fq" closed="false">ጎዳ፦ </char><char style="ft" closed="false">ሀዋ ጉሳይ ሀርያ ጎዳ።</char></note> ሀዌ ኮሼ፤ ኤለካ ዛር ሃ የዳናዋ’ ያግተ” ያጌዳ።<verse eid="MRK 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4"/>ኡንቱንቱ ቢደ፥ ሀረ ማራ ፐንግያ ማታን ኦግያን ቃች ዎዳዋ ደሚደ ብሌድኖ። <verse eid="MRK 11:4"/><verse number="5" style="v" sid="MRK 11:5"/>ሄዋን ኤቄዳ እት እት አሳቱ ኡንቱንታ፥ “ሀረ ማራ ዎታናዉ ብሊቴ?” ያጌድኖ። <verse eid="MRK 11:5"/><verse number="6" style="v" sid="MRK 11:6"/>የሱሳ ካልያዋንቱ የሱስ ባረንታ አዛዜዳዋ ኦድና፥ አሳቱ የድ አጌድኖ። <verse eid="MRK 11:6"/><verse number="7" style="v" sid="MRK 11:7"/>ኡንቱንቱ ሀረ ማራ የሱሳኮ አሂደ፥ ባረንቱ ማዩዋ አ ዞክያን ዎድኖ፤ የሱስ ሄ ሀረ ማራ ቶጌዳ። <verse eid="MRK 11:7"/><verse number="8" style="v" sid="MRK 11:8"/>ጮራ አሳይ ባረንቱ ማዩዋ ኦግያን ሂጼዳ፤ ቃይ ሀራንቱ ም ሀይ ካር ካሪደ፥ ኦግያን ሂጼድኖ። <verse eid="MRK 11:8"/><verse number="9" style="v" sid="MRK 11:9"/>የሱሳፐ ስንና ሀመትያ አሳይነ አ ጌዱዋ ካልያ አሳይ ባረንቱ ኮሻ ቁ ኦደ፥</para>
  <para style="q1" vid="MRK 11:9">“ጾሳይ ጋላተቶ!</para>
  <para style="q2" vid="MRK 11:9">ጎዳ ሱንን ይያዌ አንጀቴዳዋ።<note caller="-" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">ማዝ. 118:25-26</ref></char></note><verse eid="MRK 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10"/>ጎዳ ሱንን ይያ ኑ አዉዋ</para>
  <para style="q2" vid="MRK 11:10">ዳዊተ ካዉተይ አንጀቴዳዋ።</para>
  <para style="q1" vid="MRK 11:10">ሳሉዋ ኡባፐ ቦላ ሳሉዋን</para>
  <para style="q2" vid="MRK 11:10">ደእያ ጾሳይ ጋላተቶ”</para>
  <para style="m" vid="MRK 11:10">ያጌድኖ።<verse eid="MRK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11"/>የሱስ የሩሳላመ ቢደ፥ ጌሻ ጎልያ ገሌዳ፤ ቃይ ኡባባ ዩይ ዩይ ጼሌዳዋፐ ጉይያን፥ ሳአይ ቃምያ ድራዉ፥ ታማነ ላኡ የሱሳ ካልያዋንቱና ቢታንያ ቤዳ።<verse eid="MRK 11:11"/></para>
  <para style="s1">የሱስ ሸቄዳ ባላስያ ምቶ</para>
  <para style="r">(<ref loc="MAT 21:18-19">ማቶሳ 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12"/>ዎንተ ጋላስ ኡንቱንቱ ቢታንያፐ ከሲደ ቢሽን፥ የሱስ ኮሻቴዳ። <verse eid="MRK 11:12"/><verse number="13" style="v" sid="MRK 11:13"/>ሃኩዋን እት ባላስያ ግያ ምቶ ሀይ ማያ ኡቴዳዉኖ በኢደ፥ ኦን ኤር እ ቦላ አይፊ ቤቶፐነ ጊደ፥ በአናዉ እዝኮ ቤዳ፤ ሽን እዝኮ እ ብያ ዎደ፥ ሀይ ጻላላፐ አትን፥ አይነ አይፍያ ደምቤና፤ አያዉ ጎፐ፥ ባላሲ አይፍያ ዎዲ ጋክቤና። <verse eid="MRK 11:13"/><verse number="14" style="v" sid="MRK 11:14"/>የሱስ ሄ ባላሳቶ፥ “ኔፐ ሽረቲደ መናዉ ኦንነ አይፍያ ሞፖ” ያጌዳ። የሱሳ ካልያዋንቱ እ ግያዋ ስሴድኖ።<verse eid="MRK 11:14"/></para>
  <para style="s1">የሱስ ጌሻ ጎልያን ዛልእያዋንታ ከሴዳ</para>
  <para style="r">(<ref loc="MAT 21:12-17">ማቶሳ 21:12-17</ref>፤ <ref loc="LUK 19:45-48">ሉቃሳ 19:45-48</ref>፤ <ref loc="JHN 2:13-22">ዮሃ. 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15"/>ኡንቱንቱ የሩሳላመ ቤድኖ፤ የሱስ ጌሻ ጎልያ ገሊደ፥ ሄዋን ዛልእያዋንታነ ሻምያዋንታ ካረ የደርሱዋ ዶሜዳ፤ ቃይ ሚሻ ላምያዋንቱ ጻራጴዛነ ዶጎሙዋ ዛልእያዋንቱ ኦይድያ አ የጊደ፥ <verse eid="MRK 11:15"/><verse number="16" style="v" sid="MRK 11:16"/>ኦንነ አየንቶ ቶኪደ፥ ጌሻ ጎልያ ግቢያ ግዶና አናዋ ድጌዳ። <verse eid="MRK 11:16"/><verse number="17" style="v" sid="MRK 11:17"/>የሱስ አሳ ሀዋዳን ያጊደ ታማርሴዳ: “ጾሳ ማጻፋን፥ ‘ታ ጎሊ አይሁዳ ግደና አሳይ ኡባይ ጾሳ ዎስያ ጎለ ጌተታና’ ያገቲደ ጻፌት ኡቴዳ፤ ሽን ህንተ አ ቦንቃንቻቱ ቆሰትያ ጎንጎሉዋ ከሴድታ።”<note caller="-" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="ISA 56:7">ኢሳ. 56:7</ref>፤ <ref loc="JER 7:11">ኤር. 7:11</ref></char></note><verse eid="MRK 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18"/>ቄሳቱዋ ካፓቱነ ሙሴ ህግያ ታማርስያዋንቱ ሄዋ ስሲደ፥ አ ዎና ኦግያ ኮሻ ዶሜድኖ፤ ሽን ጮራ አሳይ እ ታማርስያዋን ማላለትያ ድራዉ፥ አዉ ያዬድኖ።<verse eid="MRK 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19"/>ሳአይ ኦማርሴዳ ዎደ፥ የሱስነ አ ካልያዋንቱ ካታማፐ ጋጻ ከሴድኖ።<verse eid="MRK 11:19"/></para>
  <para style="s1">ባላስያ ግያ ምታ መላዱ</para>
  <para style="r">(<ref loc="MAT 21:20-22">ማቶሳ 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20"/>ኡንቱንቱ ዎንተ ጋላስ ጉራ ኦግያና አደ፥ ሄ ባላሳታ ጻጱዋና መላ ድጌዳዉኖ በኤድኖ። <verse eid="MRK 11:20"/><verse number="21" style="v" sid="MRK 11:21"/>ጰጽሮስ ሀሳዪደ፥ “ታማርስያዎ፥ በአ፤ ኔን ሸቄዳ ባላሳታ መላ ድጋዱ” ያጌዳ።<verse eid="MRK 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22"/>የሱስ ዛሪደ፥ ኡንቱንታ ሀዋዳን ያጌዳ፤ “ጾሳ አማንተ። <verse eid="MRK 11:22"/><verse number="23" style="v" sid="MRK 11:23"/>ታን ህንተንቶ ቱሙዋ ጋይ፤ ኦንነ ባረ ዎዛናን ስናን ባረ ጌዳባይ ሀናናዋ አማኒደ፥ ሀ ደርያ፥ ‘ደንዳደ አባን ኩንዳ’ ጎፐ ሀናና። <verse eid="MRK 11:23"/><verse number="24" style="v" sid="MRK 11:24"/>ሄዋ ድራዉ፥ ጾሳ ህንተ ዎስያባነ ኦችያባ ኡባ አክ ድጎዋዳን አማንተ፤ ህንተ አካና። <verse eid="MRK 11:24"/><verse number="25" style="v" sid="MRK 11:25"/>ጾሳ ዎሳናዉ ህንተ ኤቂያ ዎደ፥ ሳሉዋን ደእያ ህንተ አዉ ህንተ ናጋራ አቶ ጋና ማላ፥ ኦንነ ህንተንታ ናቄዳባይ ደኦፐ፥ አዉ አቶ ጊተ። <verse eid="MRK 11:25"/><verse number="26" style="v" sid="MRK 11:26"/>ሽን አሳ ናጋራ ህንተ አቶ ጋና ዮፐ፥ ሳሉዋን ደእያ ህንተ አዉካ ህንተ ናጋራ ህንተንቶ አቶ ጌና።”<verse eid="MRK 11:26"/></para>
  <para style="s1">የሱስ አያ ማታን ኦ ግያ ኦሻ</para>
  <para style="r">(<ref loc="MAT 21:23-27">ማቶሳ 21:23-27</ref>፤ <ref loc="LUK 20:1-8">ሉቃሳ 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27"/>ኡንቱንቱ ቃይካ የሩሳላመ ቤድኖ፤ የሱስ ጌሻ ጎልያን ሀመትሽን፥ ቄሳቱዋ ካፓቱ፥ ሙሴ ህግያ ታማርስያዋንቱነ ጭማቱ የሱሳኮ ዬድኖ። <verse eid="MRK 11:27"/><verse number="28" style="v" sid="MRK 11:28"/>አ፥ “ኔን ሀዋ ኦናዉ ነዉ አይ ማታይ ደኢ? ዎይ ነዉ ሀ ማታ እሜዳዌ ኦኔ?” ያጌድኖ።<verse eid="MRK 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29"/>የሱስ ዛሪደ ኡንቱንታ፥ “ታንካ ህንተንታ እትባ ኦቻና፤ ታዉ ኦድተ፤ ታን ቃይ ሀዋ አይ ማታን ኦይታንቶ፥ ህንተንቶ ኦዳና። <verse eid="MRK 11:29"/><verse number="30" style="v" sid="MRK 11:30"/>ዮሃንስ ጻማቅያ ማታ አኬዳዌ ጾሳፔየ ዎይ አሳፔ? ታዉ ኦድተ” ያጌዳ።<verse eid="MRK 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31"/>ኡንቱንቱ ባረንቱ ግዶን ፓሉማ ዶሚደ፥ “ኑን፥ ‘ጾሳፐ ዬዳ’ ያጎፐ፥ እ ኑና፥ ‘ያትና፥ ዮሃንስ ኦዴዳዋ አያዉ አማንበይክቴ?’ ያጋና። <verse eid="MRK 11:31"/><verse number="32" style="v" sid="MRK 11:32"/>ሽን፥ ‘አሳፐ ዬዳ ጋኔ?’ ” ያጌድኖ፤ ቃይ አሳይ ኡባይ ዮሃንስ ናብያ ግዴዳዋ ኤርያ ድራዉ፥ አሳዉ ያዬድኖ። <verse eid="MRK 11:32"/><verse number="33" style="v" sid="MRK 11:33"/>ሄዋ ድራዉ፥ ኡንቱንቱ የሱሳዉ፥ “ኑን ኤሮኮ” ያጊደ ዛሬድኖ።</para>
  <para style="p" vid="MRK 11:33">የሱስ፥ “ታንካ ሀዋ አይ ማታን ኦይታንቶ፥ ህንተንቶ ኦድከ” ያጌዳ።<verse eid="MRK 11:33"/></para>
  <chapter eid="MRK 11"/>
  <chapter number="12" style="c" sid="MRK 12"/>
  <para style="s1">ዎይንያ ቱራ ቶክያ ኦሳንቻቱዋ ሌምሱዋ</para>
  <para style="r">(<ref loc="MAT 21:33-46">ማቶሳ 21:33-46</ref>፤ <ref loc="LUK 20:9-19">ሉቃሳ 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1"/>የሱስ ኡንቱንቶ ኦዱዋ ሌምሱዋን ያጊደ ዶሜዳ፤ “እት ብታኒ ዎይንያ ግያ ቱራ ቶኪደ፥ ድርሳ ዩሽ አደ ድሬዳ፤ ቃይ ሄ ዎይንያ ጉምእያ ኦላካ ቦኬዳ፤ ሄዋ ናግያ አሳዉ ናግያሳ ኬጼዳ፤ ሄዋፐ ጉይያን፥ ኮ ኦያ አሳዉ እሚደ፥ ሀራ ጋደ ቤዳ።<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="ISA 5:1-2">ኢሳ. 5:1-2</ref></char></note> <verse eid="MRK 12:1"/><verse number="2" style="v" sid="MRK 12:2"/>ዎይንያ አይፍያ ማጽያ ዎዲ ጋክና፥ ባረና ጋክያዋ አኪደ ያና ማላ፥ እት ቆማ ባረ ኮዋቱዋኮ ኪቴዳ። <verse eid="MRK 12:2"/><verse number="3" style="v" sid="MRK 12:3"/>ኮ ኦያዋንቱ አ ቆማ ኦይቂ ዋደ፥ ኩሸ መላ የዴድኖ። <verse eid="MRK 12:3"/><verse number="4" style="v" sid="MRK 12:4"/>ላኤንዋ ሀራ ቆማ ኡንቱንቱኮ ኪቴዳ፤ ኡንቱንቱ ሄ ቆማ ሁጲያ ጳልቂደ ፖክስ የዴድኖ። <verse eid="MRK 12:4"/><verse number="5" style="v" sid="MRK 12:5"/>ዎይንያ ቱራ ጎዳይ ቃይካ ሀራ ቆማ ኪቴዳ፤ ሄ ቆማ ዎድኖ፤ ቃይ ሀራ ጮራቱዋካ ሄዋዳን ኦድኖ፤ እቱዋ እቱዋ ዋደ፥ ሀራቱዋ ዎድኖ።<verse eid="MRK 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6"/>“ዎይንያ ቱራ ጎዳዉ ኪታናዉ ኡባፐ ዉርሰን እ ዳሪ ሲቅያ አ ናኣ ጻላላይ አቴዳ፤ እ፥ ‘ኡንቱንቱ ታ ናኣ ቦንቼናን አግክኖ’ ጊደ፥ ባረ ናኣ ኡንቱንቱኮ ኪቴዳ።<verse eid="MRK 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7"/>“ሽን ኮ ኦያዋንቱ ባረንቱ ግዶን፥ ‘ላታናዌ ሀዋ፤ ቢደ አ ዎይተ፤ አዉ ደእያዌ ኑዋ ግዳና!’ ያጌድኖ። <verse eid="MRK 12:7"/><verse number="8" style="v" sid="MRK 12:8"/>ናኣ ኦይቂ ዎደ፥ አ አሃ ዎይንያ ቱራ ግዶፐ ጋጻ ከስ ኦሌድኖ።<verse eid="MRK 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9"/>“ስም ዎይንያ ቱራ ጎዳይ ዎታኔ? ዪደ ሄ ኮዋቱዋ ዎ ዉርሲደ፥ ዎይንያ ቱራ ኮ ኦያ ሀራ አሳዉ እማናዋ።<verse eid="MRK 12:9"/></para>
  <para style="q1">
    <verse number="10-11" style="v" sid="MRK 12:10-11"/>“ ‘ግምቢያዋንቱ ካ እጼዳ ሹቻይ</para>
  <para style="q2" vid="MRK 12:10-11">ጎዳ ጻጱዋ ምንስያ፥</para>
  <para style="q2" vid="MRK 12:10-11">ኡባፐ አያ ሹቻ ግዴዳ።</para>
  <para style="q2" vid="MRK 12:10-11">ሀዌ ጎዳይ ኦዳዋ፤</para>
  <para style="q2" vid="MRK 12:10-11">ቃይ ኑናካ ማላልስያዋ’</para>
  <para style="q2" vid="MRK 12:10-11">ያግያዋ ጾሳ ማጻፋፐ ናባብ በይክቴ?”</para>
  <para style="m" vid="MRK 12:10-11">ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">12:10-11 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">ማዝ. 118:22-23</ref></char></note><verse eid="MRK 12:10-11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12"/>ቄሳቱዋ ካፓቱ፥ ህግያ ታማርስያዋንቱነ ጭማቱ የሱስ ሄ ሌምሱዋ ባረንቱን ሌምሴዳዋ ኤሬዳ ድራዉ፥ አ ኦይቃናዉ ኮዬድኖ፤ ሽን አሳዉ ያዪደ፥ ባሽ ቤድኖ።<verse eid="MRK 12:12"/></para>
  <para style="s1">ጊራ ጊራኔ አጋኔ ግያ ኦሻ</para>
  <para style="r">(<ref loc="MAT 22:15-22">ማቶሳ 22:15-22</ref>፤ <ref loc="LUK 20:20-26">ሉቃሳ 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13"/>ቃይ አ ሃሳያፐ ባላ ደማና ማላ፥ ፓርሳዋቱዋፐነ ሄሮድሳ ባጋቱዋፐ<note caller="+" style="f"><char style="fr" closed="false">12:13 </char><char style="fq" closed="false">ሄሮድሳ ባጋቱዋ፦ </char><char style="ft" closed="false">ሀዋንታ ጉሳይ ሄ ዎደ ደእያ ካዉተ ፖሎትካ ባጋና ካሰ ዎጋ ሄሮድሳነ አ ናኣ ሄሮድ አንትጳሳ ባጋቱዋነ ኡንቱንታ ካልያ አሳቱዋ።</char></note> አማሬዳዋንቱ አኮ ኪትና ዪደ፥ <verse eid="MRK 12:13"/><verse number="14" style="v" sid="MRK 12:14"/>“ታማርስያዎ፥ ኔን ቱሙዋ ሃሳይያዋነ አሳፐ አሳ ሻከናዋ ኑን ኤሬቶ፤ አያዉ ጎፐ፥ ኔን አሳ ዱማያካ፤ ቃይ ጾሳ ኦግያ ቱማተን ታማርሳ። ኑን ሮማ ካትያ ቄሳረዉ ጊራ ጊርያዌ ዎጌየ ዎጋ ግደኔ? ጊራ ጊራኔዬ ድጋኔ?” ያጌድኖ።<verse eid="MRK 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15"/>ሽን ኡንቱንቱ ሎአ ማላትያ ኢታ አሳ ግዴዳዋ የሱስ ኤሪደ፥ “ታና አያዉ ፓጪቴ? እት ሳንትምያ ሃ ታኮ አህተ፤ ታን አነ በአና” ያጌዳ። <verse eid="MRK 12:15"/><verse number="16" style="v" sid="MRK 12:16"/>ኡንቱንቱ አዉ አሄድኖ፤ “ሀ ማላይነ ሱንይ ኦዌ?” ያጊደ ኡንቱንታ ኦቼዳ።</para>
  <para style="p" vid="MRK 12:16">ኡንቱንቱ፥ “ቄሳረዋ” ያጌድኖ።<verse eid="MRK 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17"/>የሱስ ዛሪደ ኡንቱንታ፥ “ያቶፐ፥ ቄሳረዋ ቄሳረዉ፥ ጾሳዋ ጾሳዉ እምተ” ያግና ኡንቱንቱ አባ ማላለቴድኖ።<verse eid="MRK 12:17"/></para>
  <para style="s1">ሀይቁዋፐ ደንዱዋ ኦሻ</para>
  <para style="r">(<ref loc="MAT 22:23-33">ማቶሳ 22:23-33</ref>፤ <ref loc="LUK 20:27-40">ሉቃሳ 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18"/>ሀይቄዳ አሳይ ደንደና ግያ ሳዱቃዋናቱዋፐ እት እት አሳቱ የሱሳኮ ዪደ፥ ሀዋዳን ያጊደ፥ አ ኦቼድኖ፤ <verse eid="MRK 12:18"/><verse number="19" style="v" sid="MRK 12:19"/>“ታማርስያዎ፥ ሙሴ ኑዉ ህግያ ጻፊደ፥ ‘ማቻቶ አኬዳ አሳይ ናኣ የለናን ሀይቆፐ፥ ሄ ሀይቄዳዋ እሻይ አ ማቻቶ ላቲደ፥ ባረ እሻዉ ናኣ የላናዉ በሴ’ ያግያዋ ጻፌዳ።<note caller="-" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="DEU 25:5">ዛረ. 25:5</ref></char></note> <verse eid="MRK 12:19"/><verse number="20" style="v" sid="MRK 12:20"/>እት ዎደ ላፑ እሻቱ ደእያዋንቱፐ ባይራይ ማቻቶ አኪደ፥ ናኣ የለናን ሀይቄዳ። <verse eid="MRK 12:20"/><verse number="21" style="v" sid="MRK 12:21"/>ላኤንያ እሻይ እዞ አኬዳ፤ እካ ናኣ የለናን ሀይቄዳ፤ ሄዘንያዌካ ሄዋዳን ሀኔዳ። <verse eid="MRK 12:21"/><verse number="22" style="v" sid="MRK 12:22"/>ላፑናቱካ እዞ አኪደ፥ ናኣ የለናን ሀይቄድኖ፤ ኡባፐ ጉይያን፥ ቃይ ሄ ምሽራታ ሀይቃዱ። <verse eid="MRK 12:22"/><verse number="23" style="v" sid="MRK 12:23"/>ያትና፥ ሀይቄዳ አሳይ ሀይቁዋፐ ደንድያ ዎደ፥ እዛ ኡንቱንቱፐ ሀቃዎ ማቼ ግዳኔ? አያዉ ጎፐ፥ ላፑናቱካ እዞ አኬድኖ”።<verse eid="MRK 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24"/>የሱስ ዛሪደ ኡንቱንታ፥ “ህንተንቱ ባለትያዌ፥ ጾሳ ማጻፋቱዋነ አ ዎልቃ ኤረና ድራሳ! <verse eid="MRK 12:24"/><verse number="25" style="v" sid="MRK 12:25"/>አያዉ ጎፐ፥ ሀይቄዳ አሳይ ሀይቁዋፐ ደንድያ ዎደ፥ ሳሉዋን ደእያ ኪታንቻቱዋ ማላ ግዳናፐ አትን፥ አቱማ አሳይነ አከና፤ ማጫ አሳይነ ገለና። <verse eid="MRK 12:25"/><verse number="26" style="v" sid="MRK 12:26"/>ሽን ሀይቄዳዋንቱ ደንዱዋባ ግዶፐ፥ ሙሴ ማጻፋን ጻፈቴዳ ጻራጋይ ምያ ቡራባ ኦድያ ሳኣን፥ ጾሳይ ሙሳ፥ ‘ታን አብራሃመ ጾሳ፥ ይሳቃ ጾሳ፥ ያቆባ ጾሳ’ ግድያዋ ኡባካ ናባብ በይክቴ?<note caller="-" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="EXO 3:6">ከሳ 3:6</ref></char></note> <verse eid="MRK 12:26"/><verse number="27" style="v" sid="MRK 12:27"/>እ ፓጻ ደእያዋንቱ ጾሳ ግድያዋፐ አትን፥ ሀይቄዳዋንቱ ጾሳ ግደና፤ ህንተ ዳርስ ባሌድታ” ያጌዳ።<verse eid="MRK 12:27"/></para>
  <para style="s1">ኡባፐ አያ አዛዙዋ</para>
  <para style="r">(<ref loc="MAT 22:34-40">ማቶሳ 22:34-40</ref>፤ <ref loc="LUK 10:25-28">ሉቃሳ 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28"/>ህግያ ታማርስያዋንቱፐ እቱ ኡንቱንቱ ፓሉመትያዋ ሺቂደ ስሴዳ፤ ቃይ የሱስ ኡንቱንቶ ሎኦ ዛሬዳዋ ስሲደ፥ “አዛዙዋ ኡባፐ አያ አዛዙ ሀቃዌ?” ያጊደ የሱሳ ኦቼዳ።<verse eid="MRK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29"/>የሱስ ዛሪደ፥ አ “አዛዙዋ ኡባፐ አያ አዛዙዋ፥ ‘እስራኤልያ አሳይ ስስተ፥ ጎዳይ ኑ ጾሳይ እት ጎዳ።<note caller="-" style="x"><char style="xo" closed="false">12:29 </char><char style="xt" closed="false"><ref loc="DEU 6:4-5">ዛረ. 6:4-5</ref></char></note> <verse eid="MRK 12:29"/><verse number="30" style="v" sid="MRK 12:30"/>ህንተንቱ ጎዳ ህንተ ጾሳ ህንተ ኩመን ዎዛናፐ፥ ህንተ ኩመን ሸምፑዋፐ፥ ህንተ ኩመን ቆፋፐ፥ ህንተ ኩመን ዎልቃፐ ሲቅተ’ ያጌ። <verse eid="MRK 12:30"/><verse number="31" style="v" sid="MRK 12:31"/>ቃይ አዛዙዋ ኡባፐ አያ ላኤን አዛዙ ሀዋ፤ ‘ኔን ነ ሾሩዋ ነ ሁጲያዳን ሲቃ’ ግያዋ፤ ሀዋንቱፐ አያ ሀራ አዛዙ ባዋ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">12:31 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ዎጋ 19:18</ref></char></note><verse eid="MRK 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32"/>ህግያ ታማርስያዌ የሱሳ ያጌዳ፤ “ታማርስያዎ፥ ቱሙዋ ጋዳ፤ ኔን ‘ጾሳይ እት ጾሳ ጻላላ። አፐ አትን፥ ሀራይ ባዋ’ ጌዳዌ ቱማ።<note caller="-" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="DEU 4:35">ዛረ. 4:35</ref></char></note> <verse eid="MRK 12:32"/><verse number="33" style="v" sid="MRK 12:33"/>ጾሳ ኩመን ዎዛናፐ፥ ኩመን ቆፋፐነ ኩመን ዎልቃፐ ዶስያዌነ ቃይ ባረ ሾሩዋካ ባረ ሁጲያዳን ሲቅያዌ፥ ጉድያ ያርሹዋፐነ ሀራ ያርሹዋ ኡባፐ አ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">12:33 </char><char style="xt" closed="false"><ref loc="HOS 6:6">ሆሰ 6:6</ref></char></note><verse eid="MRK 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34"/>የሱስ ህግያ ታማርስያዋ ዛሩ አ ኤራንቻ አሳ ዛሩዋ ግዴዳዋ በኢደ፥ “ኔን ጾሳ ካዉተፐ ሃካበይካ” ያጌዳ፤ ሄዋፐ ጉይያን፥ የሱሳ ሀራባ ኦቻናዉ ኦንነ ጻልቤና።<verse eid="MRK 12:34"/></para>
  <para style="s1">“የሱስ ኦ ናኤ” ያግያ ኦሻ</para>
  <para style="r">(<ref loc="MAT 22:41-46">ማቶሳ 22:41-46</ref>፤ <ref loc="LUK 20:41-46">ሉቃሳ 20:41-46</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35"/>የሱስ ጌሻ ጎልያን ታማርሲደ፥ “ህግያ ታማርስያዋንቱ ክርስቶሳ ዎት ዳዊተ ናኣ ጊኖ? <verse eid="MRK 12:35"/><verse number="36" style="v" sid="MRK 12:36"/>ዳዊተ ባረና ጌሻ አያናይ ሃሳይስና፥</para>
  <para style="q1" vid="MRK 12:36">“ ‘ጎዳይ ታ ጎዳ፥ “ታን ነ ሞርከቱዋ፥</para>
  <para style="q2" vid="MRK 12:36">ኔን የ ኤቂያባ ኦና ጋካናዉ፥</para>
  <para style="q2" vid="MRK 12:36">ሀዋን ታፐ ኡሸቻ ባጋና፥ ቦንቼታደ ኡታ” ጌዳ’</para>
  <para style="m" vid="MRK 12:36">ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ. 110:1</ref></char></note> <verse eid="MRK 12:36"/><verse number="37" style="v" sid="MRK 12:37"/>ዳዊተ ባረ ሁጰዉ ክርስቶሳ፥ ‘ጎዳ’ ጊደ ጼሶፐ፥ ያትና፥ ክርስቶስ ዋኒደ፥ ዳዊተ ናኣ ግዲ?” ያጌዳ።</para>
  <para style="p" vid="MRK 12:37">ጮራ አሳይ የሱስ ግያዋ ናሸቻን ስሴዳ።<verse eid="MRK 12:37"/></para>
  <para style="s1">የሱስ፥ “ሙሴ ህግያ ታማርስያዋንቱፐ ናገትተ” ያጌዳ</para>
  <para style="r">(<ref loc="MAT 23:1-36">ማቶሳ 23:1-36</ref>፤ <ref loc="LUK 20:45-47">ሉቃሳ 20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38"/>የሱስ ታማርሲደ፥ “ህግያ ታማርስያዋንቱፐ ናገትተ፤ ኡንቱንቱ አዱሳ ማዩዋ ማዪደ ዩይያዋነ ገያ ሄራንካ አሳይ ኡንቱንታ ቦንቺደ ሳሮትያዋ ዶሲኖ። <verse eid="MRK 12:38"/><verse number="39" style="v" sid="MRK 12:39"/>ኡንቱንቱ አይሁዳ ዎሳ ጎለቱዋን ዳሪ ሎእያ ኦይድያ ዶሲኖ፤ ቃይ አሳይ ባረንታ እማተን ሞክያሳንካ ቦንቾ ሳኣ ዶሲኖ። <verse eid="MRK 12:39"/><verse number="40" style="v" sid="MRK 12:40"/>ኡንቱንቱ አምኤቱ ጎልያ ቦንቂደ፥ ባረንቶ ሎአ ማላታናዉ ጾሳ ዎሳ አዱሲኖ፤ ኡንቱንቱ ኡባፐ አያ ሙራ አካናዋንታ” ያጌዳ።<verse eid="MRK 12:40"/></para>
  <para style="s1">አምአት ምጹዋታ</para>
  <para style="r">(<ref loc="LUK 21:1-4">ሉቃሳ 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41"/>የሱስ ጌሻ ጎልያን እሞታ የግያ ሳጽንያ ማታን ኡቲደ፥ አሳይ ባረ ሚሻ ሄ ሳጽንያን የግያዋ በኤዳ፤ ጮራ ዱረ አሳይ ዳሮ ሚሻ ሄ ሳጽንያን የጌድኖ። <verse eid="MRK 12:41"/><verse number="42" style="v" sid="MRK 12:42"/>እት ህዬሳ አምአታ ያደ፥ እት ሳንትምያን ላመትያ ላኡ ሰምበራቱዋ ሄ ሳጽንያን የጋዱ። <verse eid="MRK 12:42"/><verse number="43" style="v" sid="MRK 12:43"/>የሱስ ባረና ካልያዋንታ ጼሲደ፥ “ታን ህንተንቶ ቱሙዋ ጋይ፤ እሞታ ሳጽንያን የጌዳ አሳ ኡባፐ ሀ ህዬሳ አምአታ ዳርሳደ የጋዱ። <verse eid="MRK 12:43"/><verse number="44" style="v" sid="MRK 12:44"/>አያዉ ጎፐ፥ ሀራቱ ኡባይ ባረንቶ ፓላሄዳ ሚሻፐ የጌድኖ፤ ሽን እዛ ባረ ፓጫፐ፥ ባረዉ ደእያ ደኡዋ ሙለካ እማ አጋዱ” ያጌዳ።<verse eid="MRK 12:44"/></para>
  <chapter eid="MRK 12"/>
  <chapter number="13" style="c" sid="MRK 13"/>
  <para style="s1">የሱስ ጌሻ ጎሊ ኮለታናዋ ካሰቲደ ኦዴዳ</para>
  <para style="r">(<ref loc="MAT 24:1-2">ማቶሳ 24:1-2</ref>፤ <ref loc="LUK 21:5-6">ሉቃሳ 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1"/>የሱስ ጌሻ ጎልያፐ ከስሽን፥ አ ካልያዋንቱፐ እቱ አ፥ “ታማርስያዎ፥ ሀዌ አይበ ሎኦ ሹቻተንቶነ ቃይ አይበ ሎኦ ሹቻ ጎላቱዋ በአይ!” ያጌዳ።<verse eid="MRK 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2"/>የሱስ ዛሪደ፥ “ሀ ዎልቃማ ሹቻ ጎላቱዋ በአይ? ሀ ጎላቱዋን ደእያ እት ሹቻይነ አተናን ኡባይ ኮለታና” ያጌዳ።<verse eid="MRK 13:2"/></para>
  <para style="s1">ጎዳይ ያናፐ ካሰቲደ ጋካና የደርሱዋነ ዋይያ</para>
  <para style="r">(<ref loc="MAT 24:3-14">ማቶሳ 24:3-14</ref>፤ <ref loc="LUK 21:7-19">ሉቃሳ 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3"/>የሱስ ጌሻ ጎልያፐ ህን ባጋና ደብረ ዛይተ ደርያ ቦላን ኡቴዳ ዎደ፥ ጰጽሮስ፥ ያቆብ፥ ዮሃንስነ እንድራስ ባረንቱ ጻላላ አኮ ዪደ አ፥ <verse eid="MRK 13:3"/><verse number="4" style="v" sid="MRK 13:4"/>“ሄዌ አዉደ ሀናነንቶ፥ ኑዉ ኦዳርኪ፤ ቃይ ሄዌ ኡባይ ፖለታና ዎድያ ኤርስያ ማላቱ አያ ግዳኔ?” ያጊደ ኦቼድኖ።<verse eid="MRK 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5"/>የሱስ ቃይ ኡንቱንቶ ሀዋዳን ያጊደ፥ ኦዱዋ ዶሜዳ፤ ህንተንታ ኦንነ ባለና ማላ ናገትተ። <verse eid="MRK 13:5"/><verse number="6" style="v" sid="MRK 13:6"/>ጮራ አሳቱ ታ ሱንን፥ “ታን ክርስቶሳ” ያጊደ ያናዋ፤ ጮራ አሳ ባለና። <verse eid="MRK 13:6"/><verse number="7" style="v" sid="MRK 13:7"/>ማታን ደእያ ኦላ ኮሻነ ሃኩዋን ደእያ ኦላ ኦዱዋ ህንተ ስስያ ዎደ፥ ህርጎፕተ፤ ሄዋ ማላባይ ሀናናዉ በሴ፤ ሽን ዉርሰይ ብራ። <verse eid="MRK 13:7"/><verse number="8" style="v" sid="MRK 13:8"/>አያዉ ጎፐ፥ እት ጋደ አሳይ ሀራ ጋደ አሳና ኦለታና፤ ቃይ እት ካዉተይ ሀራ ካዉተና ኦለታና፤ ቢታ ቃይ ኡባ ሳን ደአና፤ ኮሻይካ ደአና፤ ሽን ሄዌ ኮይሮ የሉዋ ኦይ ማላ።<verse eid="MRK 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9"/>ሽን ህንተ ህንተንቱ ሁጰዉ ናገትተ፤ አያዉ ጎፐ፥ አሳይ ህንተንታ ኦይቂደ፥ ፕርዳ ጎለዉ አደ እማና፤ ቃይ ባረ አይሁዳ ዎሳ ጎለቱዋንካ ህንተንታ ልሱዋን ሾጫና፤ ጋድያ ሞድያዋንቱ ስንንነ ካታቱዋ ስንን ታ ድራዉ ህንተ ማርካታናዉ ኤቃና። <verse eid="MRK 13:9"/><verse number="10" style="v" sid="MRK 13:10"/>ምሽራቹዋ ቃላይ ኮይሮና አሳዉ ኡባዉ ኦደት ድጋናዉ በሴ። <verse eid="MRK 13:10"/><verse number="11" style="v" sid="MRK 13:11"/>ኡንቱንቱ ህንተንታ ፕርዳ ጎለ አህያ ዎደነ አደ እምያ ዎደ፥ ዎት ሃሳያንተንቶ ኮይሮና ህርጎፕተ፤ ሄ ሳትያን ጾሳይ ህንተንቶ እምያባ ሃሳይተ። አያዉ ጎፐ፥ ጌሻ አያናይ ሃሳያናፐ አትን፥ ሃሳይያዋንቱ ህንተንታ ግድክታ።<verse eid="MRK 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12"/>እሻይ ባረ እሻ፥ አዉ ባረ ናኣ ዎሳና፤ ቃይ ናናይ ባረንቱ አዎቱዋ ቦላንነ ባረንቱ አየቱዋ ቦላ ደንዲደ፥ ኡንቱንታ ዎሳና። <verse eid="MRK 13:12"/><verse number="13" style="v" sid="MRK 13:13"/>አሳይ ኡባይ ህንተንታ ታ ሱን ድራዉ እጻና፤ ሽን ዉርሰይ ጋካናዉ ገንጭያዌ አታና።<verse eid="MRK 13:13"/></para>
  <para style="s1">የሩሳላመ ጋካና ዎልቃማ ኢታ መቱዋ</para>
  <para style="r">(<ref loc="MAT 24:15-28">ማቶሳ 24:15-28</ref>፤ <ref loc="LUK 21:20-24">ሉቃሳ 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14"/>ሽን ናብያ ዳኔል ኦዴዳ ባሻ ቱናተይ ኤቃናዉ በሰናሳን ኤቂሽን ህንተ በእያ ዎደ፥ ሄዌ ዋግያዌንቶ፥ ናባብያዌ አኬኮ፤ ይሁዳ ጋድያን ሄ ዎደ ደእያዋንቱ ደርያኮ በትኖ።<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="DAN 9:27">ዳኔላ 9:27</ref>፤ <ref loc="DAN 11:31">11:31</ref>፤ <ref loc="DAN 12:11">12:11</ref></char></note> <verse eid="MRK 13:14"/><verse number="15" style="v" sid="MRK 13:15"/>ጎልያ ሁጲያን ደእያ ኡራይካ እትባ አካናዉ ዱገ ዎደ፥ ባረ ሶይ ገሎፖ። <verse eid="MRK 13:15"/><verse number="16" style="v" sid="MRK 13:16"/>ጋደን ደእያዌካ ባረ ማዩዋ አካናዉ ጉየ ስሞፖ። <verse eid="MRK 13:16"/><verse number="17" style="v" sid="MRK 13:17"/>ሄ ዎደ ሻሃራ ማጫዋንቶነ ንያ ማጫዋንቶ አዬሮ። <verse eid="MRK 13:17"/><verse number="18" style="v" sid="MRK 13:18"/>ሽን ሀዌ ኡባይ ሀንያ ዎዲ ባልጉዋ ግደና ማላ፥ ጾሳ ዎስተ፤ <verse eid="MRK 13:18"/><verse number="19" style="v" sid="MRK 13:19"/>አያዉ ጎፐ፥ ጾሳይ ሳኣ ኮይሮ መዳዋፐ ዶሚደ፥ ሀእ ጋካናዉ፥ ኡባካ ደእቤና መቱ፥ ቃይ ሀዋፐ ስንዉካ ኡባ ደኤና መቱ አሳ ቦላ ሄ ዎደ ደአና።<note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="DAN 12:1">ዳኔላ 12:1</ref>፤ <ref loc="REV 7:14">ሳፃ 7:14</ref></char></note> <verse eid="MRK 13:19"/><verse number="20" style="v" sid="MRK 13:20"/>ጎዳይ ሄ ጋላሳቱዋ ፓይዱዋ ጉያዌ ባዌንቶ፥ አሳ ግዴዳ ኦንነ አተና፤ ሽን እ ባረ ዶሬዳ አሳቱዋ ድራዉ፥ ሄ ጋላሳቱዋ ፓይዱዋ ጉዳ።<verse eid="MRK 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21"/>ሄ ዎደ ኦንነ ህንተንታ፥ “በእተ፤ ክርስቶስ ሀዋን ደኤ” ዎይ፥ “በእተ፤ ክርስቶስ፥ ሄዋን ደኤ” ያጎፐ፥ ሄዋ አማኖፕተ። <verse eid="MRK 13:21"/><verse number="22" style="v" sid="MRK 13:22"/>አያዉ ጎፐ፥ ዎርዳንቻ ክርስቶሳቱነ ዎርዶ ናባቱ ደንዲደ ባረንቶ ዳንዳየቶፐ፥ ሀራይ አቶ ጾሳይ ዶሬዳዋንታካ ባለናዉ ማላታነ ማላልስያባ በሳና። <verse eid="MRK 13:22"/><verse number="23" style="v" sid="MRK 13:23"/>ሽን ህንተ ናገትተ፤ ታን ህንተንቶ ኡባባ ካሰታደ ኦዳድ።<verse eid="MRK 13:23"/></para>
  <para style="s1">ክርስቶሳ ላኤን ዩሳ</para>
  <para style="r">(<ref loc="MAT 24:29-31">ማቶሳ 24:29-31</ref>፤ <ref loc="LUK 21:25-28">ሉቃሳ 21:25-28</ref>)</para>
  <para style="q1">
    <verse number="24" style="v" sid="MRK 13:24"/>ሽን ሄ ዎደ ሄ ዋይያፐ ጉይያን፥</para>
  <para style="q2" vid="MRK 13:24">አዋይ ማና፤</para>
  <para style="q2" vid="MRK 13:24">አገናይ ፖእያዋ አጋና፤<note caller="-" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="ISA 13:10">ኢሳ. 13:10</ref>፤ <ref loc="EZK 32:7">ህዝ. 32:7</ref>፤ <ref loc="JOL 2:10">ኢዩ. 2:10</ref>፣ <ref loc="JOL 2:31">31</ref>፤ <ref loc="JOL 3:15">3:15</ref>፤ <ref loc="REV 6:12">ሳፃ 6:12</ref></char></note><verse eid="MRK 13:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="MRK 13:25"/>ጾልንታቱ ሳሉዋፐ ኩንዳና።</para>
  <para style="q2" vid="MRK 13:25">ቃይ ሳሉዋን ደእያ ዎልቃቱካ ቃጸታና።<note caller="-" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="ISA 34:4">ኢሳ. 34:4</ref>፤ <ref loc="JOL 2:10">ኢዩ. 2:10</ref>፤ <ref loc="REV 6:13">ሳፃ 6:13</ref></char></note><verse eid="MRK 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 13:26"/>ሄ ዎደ ታን፥ አሳ ናአይ፥ ዎልቃማ ዎልቃናነ ቦንቹዋና ሻርያ ግዶና ዪሽን፥ ኡንቱንቱ በአና።<note caller="-" style="x"><char style="xo" closed="false">13:26 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳኔላ 7:13</ref>፤ <ref loc="REV 1:7">ሳፃ 1:7</ref></char></note> <verse eid="MRK 13:26"/><verse number="27" style="v" sid="MRK 13:27"/>ሄ ዎደ ታን ኪታንቻቱዋ ሳኣ ኦይዱ ባጋ ኪታና፤ ሳኣ ጋጻፐ ሳሉዋ ጋጻ ጋካናዉ፥ ጾሳይ ዶሬዳ አሳ ሺሻና።<verse eid="MRK 13:27"/></para>
  <para style="s1">ዎድያ ዉርሰይ ጋኬዳዋ ማላታ በስያ ባላስያ ምቶ</para>
  <para style="r">(<ref loc="MAT 24:32-35">ማቶሳ 24:32-35</ref>፤ <ref loc="LUK 21:29-33">ሉቃሳ 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28"/>ሌምሱዋ ባላሳቶ ግያ ምትፐ ታማርተ፤ ባላሳታ አጭያ ዎደነ እዝ ሀይይ ሀይትያ ዎደ፥ ቦኒ ማቴዳዋ ህንተ ኤሪታ። <verse eid="MRK 13:28"/><verse number="29" style="v" sid="MRK 13:29"/>ሀዋዳንካ ህንተ ሄ ኡባባይ ሀንያዋ በእያ ዎደ፥ እ<note caller="+" style="f"><char style="fr" closed="false">13:29 </char><char style="fq" closed="false">እ፦ </char><char style="ft" closed="false">የሱሳ ጉሳ።</char></note> ማታቲደ ፐንግያ ሺቄዳዋ<note caller="+" style="f"><char style="fr" closed="false">13:29 </char><char style="fq" closed="false">ማታቲደ ፐንግያ ሺቄዳዋ፦ </char><char style="ft" closed="false">ጉሳይ፥ የሱሳ ዩሳይ ማቴዳ ጉሳ።</char></note> ኤርተ። <verse eid="MRK 13:29"/><verse number="30" style="v" sid="MRK 13:30"/>ታን ህንተንቶ ቱሙዋ ኦዳይ፤ ሀ ኡባባይ ሀናና ጋካናዉ፥ ሀ ዎድያ የለታይ ሀይቂድገና። <verse eid="MRK 13:30"/><verse number="31" style="v" sid="MRK 13:31"/>ሳሉነ ሳአይ አና፤ ሽን ታ ቃላይ ኡባካ አና።<verse eid="MRK 13:31"/></para>
  <para style="s1">ዉርሰ ጋላሳነ ሳትያ ኦንነ ኤረና</para>
  <para style="r">(<ref loc="MAT 24:36-44">ማቶሳ 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32"/>ሽን ሄ ጋላሳነ ሄ ሳትያ አዉዋ ጻላላፐ አትን፥ ሀራይ አቶ ሳሉዋን ደእያ ኪታንቻቱዋ ግድና፥ ዎይ ታና ናኣ ግድናካ ኦንነ ኤርያባይ ባዋ። <verse eid="MRK 13:32"/><verse number="33" style="v" sid="MRK 13:33"/>ሄ ዎዲ አዉደ ግዳነንቶ፥ ህንተ ኤረና ድራዉ፥ ናገትተ፤ ምንተ፤ ጾሳ ዎስተ። <verse eid="MRK 13:33"/><verse number="34" style="v" sid="MRK 13:34"/>ታ ዩሳይ ባረ ጎልያ አጊደ፥ ኦግያ ብያ ብታንያ ማላ፤ ብታኒ ባረ ቆማቶ ሁጲያን ሁጲያን ኦሱዋ እሚደ፥ ኡንቱንታ ባረ ኦሶ ካፖ ኦዳ፤ ቃይ ካርያ ናግያዌካ ምንሲደ ናጋና ማላ አዛዜዳ።<verse eid="MRK 13:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35"/>ሄዋ ድራዉ፥ ምንተ፤ አያዉ ጎፐ፥ ጎልያዉ ኦማርሳ ግድና፥ ዎይ ቃማ ብላሄ ግድና፥ ዎይ ኩቱ ዋስያ ዎደ ግድና፥ ዎይ ጉራ ዎንቱማን ግድና አዉደ ያነንቶ፥ ህንተ ኤርክታ። <verse eid="MRK 13:35"/><verse number="36" style="v" sid="MRK 13:36"/>ህንተንቱ አኬከናን እ ዮፐ፥ ህንተንታ ገምእሼዳዋንታ ደመና ማላ ምንተ። <verse eid="MRK 13:36"/><verse number="37" style="v" sid="MRK 13:37"/>ታን ህንተንቶ ኦድያዋ አሳ ኡባዉ ኦዳይ፤ ምንተ።<verse eid="MRK 13:37"/></para>
  <chapter eid="MRK 13"/>
  <chapter number="14" style="c" sid="MRK 14"/>
  <para style="s1">ክርስቶሳ ቦላ ማቀቴድኖ</para>
  <para style="r">(<ref loc="MAT 26:1-5">ማቶሳ 26:1-5</ref>፤ <ref loc="LUK 22:1-2">ሉቃሳ 22:1-2</ref>፤ <ref loc="JHN 11:45-53">ዮሃ. 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1"/>ፓስጋ ባላ ግያዋ ቦንችያ ጋላሳይነ ጫልቤና ኡክ ሙሳ ቦንችያ ባላ ጋላሳይ ጋካናዉ ላኡ ጋላሳይ አቴዳ፤ ቄሳቱዋ ካፓቱነ ህግያ ታማርስያዋንቱ አሳይ ኤረናን የሱሳ ኦይቂደ ዎና ኦግያ ኮዪኖ።<note caller="-" style="x"><char style="xo" closed="false">14:1 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">ከሳ 12:1-27</ref></char></note> <verse eid="MRK 14:1"/><verse number="2" style="v" sid="MRK 14:2"/>“አሳይ ዋላሳ ከሰና ማላ፥ ፓስጋ ቦንችያ ጋላስ ሄዋ ኦኮ” ያጌድኖ።<verse eid="MRK 14:2"/></para>
  <para style="s1">የሱሳ ሽቱዋ ኦኬዳ ምሽራቶ</para>
  <para style="r">(<ref loc="MAT 26:6-13">ማቶሳ 26:6-13</ref>፤ <ref loc="JHN 12:1-8">ዮሃ. 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3"/>የሱስ ቢታንያ ጋድያን ኦሉዋ ሀርግያ ስሞና ሶይን ቁማ ማናዉ ኡቴዳ ዎደ፥ እት ምሽራታ አልባስጽሮሳ ባሬታ ኩሜዳ ናርዶሳ ግያ ዳሪ አልኦ ሽቱዋ<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="fk" closed="false">ዳሪ አልኦ ሽቱዋ፦ </char><char style="ft" closed="false">ጉሳይ ሎይ ሳዊያዋ ጉሳ።</char></note> አካደ ያዱ፤ ሄ አልባስጽሮሳ ባሬታ መንደ ሽቱዋ የሱሳ ሁጲያን ትጋዱ። <verse eid="MRK 14:3"/><verse number="4-5" style="v" sid="MRK 14:4-5"/>ሄዋን ደእያ አሳፐ እቱ እቱ ሀንቀቲደ፥ “ሀ ሽቱዋ ጮ አያዉ ባይዛይ? ሀ ሽቱዋ ሄዙ ጼቱ ብራ ሳንትምያን<note caller="+" style="f"><char style="fr" closed="false">14:4-5 </char><char style="fk" closed="false">ብራ ሳንትምያ፦ </char><char style="ft" closed="false">6:37 ጼልተ።</char></note> ዛልኢደ፥ ሚሻ ህዬሳዉ እማናዉ ዳንዳየቴ” ያጊደ ባረንቱ ግዶን ሃሳዪኖ፤ ያቲደ ሄ ምሽራቶ ዳርስ ሀንቀቴድኖ። <figure style="fig" alt="Alabaster jars" file="HK00142B.TIF" size="col" ref="14:3-5">አልባስሲሮሳ ባሬታ</figure><verse eid="MRK 14:4-5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6"/>ሽን የሱስ ሀዋዳን ያጌዳ፤ “ሀ ምሽራቶ አይነ ጎፕተ፤ እዞ አያዉ መቶቴ? እዛ ታዉ ሎኦባ ኦዱ። <verse eid="MRK 14:6"/><verse number="7" style="v" sid="MRK 14:7"/>ህዬሳቱ ኡባ ዎደ ህንተንቱና ደኢኖ፤ ህንተ ኮዬዳ ዎደ አዉደነ ኡንቱንታ ማዳናዉ ዳንዳዪታ፤ ሽን ታን ኡባ ዎደ ህንተንቱና ደእከ።<note caller="-" style="x"><char style="xo" closed="false">14:7 </char><char style="xt" closed="false"><ref loc="DEU 15:11">ዛረ. 15:11</ref></char></note> <verse eid="MRK 14:7"/><verse number="8" style="v" sid="MRK 14:8"/>እዛ ባረዉ ዳንዳየቴዳዋ ኦዱ፤ ቃይ ታ አሳተይ ሞገታናፐ ካሰታደ ሞጎ ጊግሳናዉ ሽቱዋ ኦካዱ። <verse eid="MRK 14:8"/><verse number="9" style="v" sid="MRK 14:9"/>ታን ህንተንቶ ቱሙዋ ኦዳይ፤ ሳኣ ኡባን ዎንጋላ ምሽራቹዋ ኦድያሳን ሀቃንኔካ፥ አሳይ እዞ ቆፓና ማላ፥ ሀ እዛ ኦዳዌ ኦደታና” ያጌዳ።<verse eid="MRK 14:9"/></para>
  <para style="s1">ይሁዳ አስቆሮቱ የሱሳ አደ እማናዉ ዞረታ ኤኖ ጌዳ</para>
  <para style="r">(<ref loc="MAT 26:14-16">ማቶሳ 26:14-16</ref>፤ <ref loc="LUK 22:3-6">ሉቃሳ 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10"/>ታማነ ላኡ የሱሳ ካልያዋንቱፐ እቱ ይሁዳ አስቆሮቱ<note caller="+" style="f"><char style="fr" closed="false">14:10 </char><char style="fq" closed="false">ይሁዳ አስቆሮቱ፦ </char><char style="ft" closed="false">3:19 ጼልተ።</char></note> ግያዌ፥ የሱሳ ቄሳቱዋ ካፓቶ አደ እማናዉ ኡንቱንቱኮ ቤዳ። <verse eid="MRK 14:10"/><verse number="11" style="v" sid="MRK 14:11"/>ኡንቱንቱ ሄዋ ስሴዳ ዎደ ናሸቲደ፥ “ኑን ነዉ ሚሻ እማና” ያጌድኖ፤ ይሁዳ አስቆሮቱ የሱሳ አደ እማናዉ እንጀትያ ዎድያ ዎቼ።<verse eid="MRK 14:11"/></para>
  <para style="s1">የሱስ ባረና ካልያዋንቱና ፓስጋ ቁማ ሜዳ</para>
  <para style="r">(<ref loc="MAT 26:17-25">ማቶሳ 26:17-25</ref>፤ <ref loc="LUK 22:7-14">ሉቃሳ 22:7-14</ref>፣ <ref loc="LUK 22:21-23">21-23</ref>፤ <ref loc="JHN 13:21-30">ዮሃ. 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12"/>ጫልቤና ኡክ ምያ ባላ ጋላሳ ቦንችያ ኮይሮ ጋላስ፥ ፓስጋ ቁማ ማናዉ ዶርሳ ሹክያ ዎደ፥ የሱሳ ካልያዋንቱ አ፥ “ፓስጋ ቦንችያ ጋላስ ኔን ማና ቁማ ኑን ሀቃ ቢደ ጊግሳኔ?” ያጊደ ኦቼድኖ።<verse eid="MRK 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13"/>የሱስ ባረና ካልያዋንቱፐ ላአቱዋ ሀዋዳን ያጊደ ኪቴዳ፤ “ካታማ ቢተ፤ ህንተ ቢሽን፥ ኦቱዋን ሃ ቶኬዳ እት ብታኒ ህንተንቱና ጋከታናዋ፤ አ ካልተ። <verse eid="MRK 14:13"/><verse number="14" style="v" sid="MRK 14:14"/>እ ቢደ ገልያ ጎልያዉዋ፥ ‘ታማርስያዌ ኔና፥ “ታን ታና ካልያዋንቱና ፓስጋ ቁማ ማናዉ ታ እማ ክፍሊ ሀቃኔ?” ያጌ’ ያግተ። <verse eid="MRK 14:14"/><verse number="15" style="v" sid="MRK 14:15"/>ጎልያዉ ህንተንታ ፖቅያ ቦላን ደእያ ጊግ ኡቴዳ አኮ ክፍልያ በሳና፤ ሄዋን ኑዉ ጊግስተ” ያጌዳ። <figure style="fig" alt="Two-story house with steps toroof" file="LB00235B.TIF" size="col" ref="14:15">ፖቂያ ጎሊያነ ክፍላቱዋኮ ከሲያ ደ</figure><verse eid="MRK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16"/>ሄ ላኡ የሱሳ ካልያዋንቱ ከሲደ፥ ካታማ ቤድኖ፤ የሱስ ባረንቶ ኦዴዳዋዳንካ ኡባባ ደሚደ፥ ፓስጋ ቁማ ጊግሴድኖ።<verse eid="MRK 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17"/>ሳአይ ኦማርስያ ዎደ የሱስ ታማነ ላኡ ባረና ካልያዋንቱና ያ ቤዳ። <verse eid="MRK 14:17"/><verse number="18" style="v" sid="MRK 14:18"/>ኡንቱንቱ ኡቲደ ሳምፓፐ ቁማ ሚሽን፥ የሱስ ኡንቱንታ፥ “ታን ህንተንቶ ቱሙዋ ኦዳይ፤ ህንተንቱፐ እቱ ታናና ምያዌ፥ ታና አደ እማናዋ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">14:18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">ማዝ. 41:9</ref></char></note><verse eid="MRK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19"/>አ ካልያዋንቱ ሎይ ስሰትና፥ ሁጲያን ሁጲያን አ፥ “ቱሙ ታኔሻ?” ግያዋ ዶሜድኖ።<verse eid="MRK 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20"/>የሱስ ዛሪደ፥ “እ ሀ ህንተንቱ ታማነ ላአቱዋፐ እቱዋ፤ እ ታናና እትፐ ቱሻናዉ ባረ ዳቡዋ ሻታን የድያዋ። <verse eid="MRK 14:20"/><verse number="21" style="v" sid="MRK 14:21"/>ታን፥ አሳ ናአይ፥ ጾሳ ማጻፋይ ሀይቃና ጌዳዋዳን ሀይቃና፤ ሽን ታና፥ አሳ ናኣ፥ አደ እምያ ኡራዉ አዬሮ፤ ሄ ኡራይ የለተናን አቴደንቶ፥ አዉ ሎአ ሽን” ያጌዳ።<verse eid="MRK 14:21"/></para>
  <para style="s1">ጎዳ ካዉዋ አክያ ዎጋ</para>
  <para style="r">(<ref loc="MAT 26:26-30">ማቶሳ 26:26-30</ref>፤ <ref loc="LUK 22:14-20">ሉቃሳ 22:14-20</ref>፤ <ref loc="1CO 11:23-25">1 ቆሮ. 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22"/>ኡንቱንቱ ሚሽን፥ የሱስ ዳቡዋ አኪደ፥ ጾሳ ጋላቴዳ፤ ሄ ዳቡዋ መንደ፥ ባረና ካልያዋንቶ እሚደ፥ “ሄይተ፤ ሀዌ ታ አሹዋ” ያጌዳ።<verse eid="MRK 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23"/>ጹኣ አኪደ፥ ጾሳ ጋላቲደ፥ ኡንቱንቶ እሜዳ፤ ኡባይ ሄ ጹኣፐ ኡሼድኖ። <verse eid="MRK 14:23"/><verse number="24" style="v" sid="MRK 14:24"/>የሱስ፥ “ሀዌ ኦራ ጫቁዋን<note caller="+" style="f"><char style="fr" closed="false">14:24 </char><char style="fq" closed="false">ኦራ ጫቁዋ፦ </char><char style="ft" closed="false">ጾሳይ ባረ አሳዉ የሱሳ ሀይቁዋ ባጋና ቃላ ገሌዳ ኦራ ቃላ ጫቁዋ። ሄዌኔካ አ ጋክያ ጹኣ፥ እ ባረ ሱ ጉሲደ አ እሜዳ አ ደኡዋ። ሄዌኔካ፥ ኑ ኤጫ አሳተይ ኡባይ ላመትና፥ ኦራጼዳ ጾሳ ህጊ ኑ ዎዛናን ጻፈቴዳዋ ኦዴ።</char></note> ጮራ አሳ ድራዉ ጉክያ ታ ሱ።<note caller="-" style="x"><char style="xo" closed="false">14:24 </char><char style="xt" closed="false"><ref loc="EXO 24:8">ከሳ 24:8</ref>፤ <ref loc="JER 31:31-34">ኤር. 31:31-34</ref></char></note> <verse eid="MRK 14:24"/><verse number="25" style="v" sid="MRK 14:25"/>ታን ህንተንቶ ቱሙዋ ኦዳይ፤ ታን ጾሳ ካዉተን ኦራ ዎይንያ ኤሳ ኡሻና ጋላሳይ ጋካናዉ፥ ላኤንዋ ሀ ዎይንያ ኤሳ ኡባካ ኡሽከ” ያጌዳ።<verse eid="MRK 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26"/>ማዝሙርያ የጼዳዋፐ ጉይያን፥ ደብረ ዛይተ ደርያ ቤድኖ።<verse eid="MRK 14:26"/></para>
  <para style="s1">ጰጽሮስ ካዳናዋ የሱስ ካሰቲደ ኦዴዳ</para>
  <para style="r">(<ref loc="MAT 26:31-35">ማቶሳ 26:31-35</ref>፤ <ref loc="LUK 22:31-34">ሉቃሳ 22:31-34</ref>፤ <ref loc="JHN 13:36-38">ዮሃ. 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27"/>የሱስ ባረና ካልያዋንቶ፥</para>
  <para style="q1" vid="MRK 14:27">“ህንተንቱ ኡባይ ታና የጊደ ዎጻንታ፤ አያዉ ጎፐ፥</para>
  <para style="q2" vid="MRK 14:27">ጾሳ ማጻፋይ፥ ‘ጾሳይ ዶርሳ ሄምያዋ ዎና፤</para>
  <para style="q2" vid="MRK 14:27">ሄዋፐ ጉይያን ዶርሳይ ኡባይ ላለታና ጌ’</para>
  <para style="m" vid="MRK 14:27">ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">ዛካ. 13:7</ref></char></note> <verse eid="MRK 14:27"/><verse number="28" style="v" sid="MRK 14:28"/>ሽን ታን ሀይቁዋፐ ደንዴዳዋፐ ጉይያን፥ ህንተንቱፐ ካሰታደ ጋሊላ ባና” ያጌዳ።<verse eid="MRK 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29"/>ጰጽሮስ ዛሪደ፥ “ኡንቱንቱ ኡባቱ ኔና የጊደ ቦፐካ፥ ታን ኔና ሙለካ የግከ” ያጌዳ።<verse eid="MRK 14:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30"/>የሱስ ጰጽሮሳ፥ “ታን ነዉ ቱሙዋ ኦዳይ፤ ሀቼ ቃማ ኩቱ ላኤንዋ ዋሳናፐ ካሰ፥ ኔን ታና ሄዙ ገደ ካዳናሳ” ያጌዳ።<verse eid="MRK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31"/>ሽን ጰጽሮስ ካሰዋፐካ ምንሲደ፥ “ታን ሀራይ አቶ፥ ኔናና እትፐ ሀይቂንቶካ፥ ኔና ሙለካ ካድከ” ያጌዳ። ቃይ ሀራቱ ኡባቱካ ሄዋዳን ጌድኖ።<verse eid="MRK 14:31"/></para>
  <para style="s1">የሱስ ጌተሰማንያን ዎሴዳ</para>
  <para style="r">(<ref loc="MAT 26:36-46">ማቶሳ 26:36-46</ref>፤ <ref loc="LUK 22:39-46">ሉቃሳ 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32"/>ጌተሰማነ ግያ ሳኣ ቤድኖ፤ የሱስ ባረና ካልያዋንታ “ታን ጾሳ ዎሳናዉ፥ ህንተንቱ ሀዋን ኡትሽተ” ያጌዳ።<verse eid="MRK 14:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 14:33"/>የሱስ ጰጽሮሳ፥ ያቆባነ ዮሃንሳ ባረናና አፌዳ፤ ዳሪ ካዮቴዳነ መቶቴዳ። <verse eid="MRK 14:33"/><verse number="34" style="v" sid="MRK 14:34"/>ቃይ ኡንቱንታ፥ “ታን ሀይቃና ጋካናዉካ ካዮታይ፤ ሀዋን ታክሽተ፤ ገምእሾፕተ” ያጌዳ።<verse eid="MRK 14:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35"/>ጉ ስንኮ ሺቂደ፥ ሳኣን ጉፋኒደ፥ ዳንዳየትያዋ ግዶፐ፥ ሄ ዎዲ ባረፐ አና ማላ፥ ጾሳ ዎሴዳ። <verse eid="MRK 14:35"/><verse number="36" style="v" sid="MRK 14:36"/>ቃይካ፥ “አባቦ፥<note caller="+" style="f"><char style="fr" closed="false">14:36 </char><char style="fq" closed="false">አባ፦ </char><char style="ft" closed="false">ጉሳይ ግሪከ ቃላንካ “አባ” ግድያ ዎደ፥ አራማይከ ቃላን “አባ” ግያዋ።</char></note> ታ አቦ፥ ኡባባይ ነዉ ዳንዳየቴ፤ ሀ ጹኣ ታፐ ድጋ፤ ሽን ነ ሸንያዳን ሀኖፐ አትን፥ ታ ሸንያዳን ሀኖፖ” ያጌዳ።<verse eid="MRK 14:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37"/>የሱስ ባረና ካልያዋንቱኮ ስም ዪደ፥ ገምእሼዳዋንታ ደሚደ ጰጽሮሳ፥ “ስሞና፥ ገምእሻዲ? ኔን እት ሳተንቶነ ናጋናዉ ዳንዳያበይኪ? <verse eid="MRK 14:37"/><verse number="38" style="v" sid="MRK 14:38"/>ፓጭያን ህንተ ገለና ማላ፥ ናገትተነ ጾሳ ዎስተ፤ አያናይ ጊግ ኡቴዳ፤ ሽን አሹ ዳቡራንቻ” ያጌዳ።<verse eid="MRK 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39"/>ቃይካ ቢደ ካሰዋዳንካ ጾሳ ዎሴዳ። <verse eid="MRK 14:39"/><verse number="40" style="v" sid="MRK 14:40"/>አ ካልያዋንቱኮ ጉየ ስሚደ እ ይያ ዎደ፥ ገምእሼዳዋንታ ደሜዳ፤ ኡንቱንቱ አይፍያ ገምእሹ ጎዝ ዎዳ ድራዉ፥ አዉ አያ ሃሳዪኖንቶካ ኤርበይክኖ።<verse eid="MRK 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41"/>ሄዘንዋ ኡንቱንቱኮ ዪደ፥ “ሀእ ጋካናዉካ ገምእሺቴነ ሸምፒቴ? ግዳና፤ ዎዲ ጋኬዳ፤ በእተ፥ ታና፥ አሳ ናኣ፥ ናጋራንቻ አሳቱዋ ኩሽያን አደ እምያ ዎዲ ጋኬዳ። <verse eid="MRK 14:41"/><verse number="42" style="v" sid="MRK 14:42"/>ደንድና ቦይተ፤ በእተ፥ ታና አደ እምያዌ ሀዌኩ ጋኬዳ” ያጌዳ።<verse eid="MRK 14:42"/></para>
  <para style="s1">የሱስ ባረ ሞርከቱዋ ኩሽያን ኦይቀቴዳ</para>
  <para style="r">(<ref loc="MAT 26:47-56">ማቶሳ 26:47-56</ref>፤ <ref loc="LUK 22:47-53">ሉቃሳ 22:47-53</ref>፤ <ref loc="JHN 18:3-12">ዮሃ. 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43"/>የሱስ ሄዋ ብሮ ሃሳይሽን፥ ታማነ ላኡ አ ካልያዋንቱፐ እቱ፥ ይሁዳ አስቆሮቱ፥ ኤለካ ጋክ ዎዳ፤ ቃይ ቄሳቱዋ ካፓቱ ህግያ ታማርስያዋንቱነ ጭማቱ ኪትና፥ ማሻነ ጻምኣ ኦይቄዳ ጮራ አሳይ አናና እትፐ ዬዳ። <verse eid="MRK 14:43"/><verse number="44" style="v" sid="MRK 14:44"/>የሱሳ አ እምያዌ ሄ ጮራ አሳዉ፥ “ታን የርያዌ አ፤ አ ኦይቂደ ሎይ ናጊደ፥ አፍተ” ያጊደ ማላ ኦድ ዎዳ።<verse eid="MRK 14:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45"/>ይሁዳ አስቆሮቱ ጋኮሳናካ የሱሳኮ ሺቂደ፥ “ታማርስያዎ” ያጊደ የሱሳ የር አኬዳ። <verse eid="MRK 14:45"/><verse number="46" style="v" sid="MRK 14:46"/>ሄ ጮራ አሳይ የሱሳ ምንስ ኦይቄዳ። <verse eid="MRK 14:46"/><verse number="47" style="v" sid="MRK 14:47"/>ሽን ማታን ኤቄዳዋንቱፐ እቱ ባረ ጩብያ ሾድነ ቄሳቱዋ ኡባቱዋ ካፑዋ ቆማ ሾጪደ፥ አ ሀይ ቃንጽ ኦሌዳ።<verse eid="MRK 14:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48"/>የሱስ ዛሪደ፥ ሄ ሺቄዳ ጮራ አሳ፥ “ታና ቦንቃንቻ ከሲደ፥ ቦንቃንቻ ኦይቂያዋዳን ኦይቃናዉ ጩብያነ ጻምኣ ኦይቂደ ዬድቴ? <verse eid="MRK 14:48"/><verse number="49" style="v" sid="MRK 14:49"/>ታን ጌሻ ጎልያን ታማርሳደ፥ ጋላሳን ጋላሳን ህንተንቱና ደእያ ዎደ ታና ኦይቂበይክታ፤ ሽን ጾሳ ማጻፋቱ ጌዳዌ ፖለታናዉ በሴ” ያጌዳ።<verse eid="MRK 14:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50"/>የሱሳ ካልያዋንቱ ኡባቱ አ የጊደ ብ አጌድኖ።<verse eid="MRK 14:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51"/>ናጻላ ጻላላ ማዬዳ እት ያላጋ ብታኒ የሱሳ ካልያዋ አሳይ ኦይቄዳ። <verse eid="MRK 14:51"/><verse number="52" style="v" sid="MRK 14:52"/>ሽን ሄ ብታኒ ናጻላ ኦሊደ፥ ካሎ ጺራ ዎጼዳ።<verse eid="MRK 14:52"/></para>
  <para style="s1">የሱሳ ፕርድያ ሻንጋቱዋኮ አፌድኖ</para>
  <para style="r">(<ref loc="MAT 26:57-68">ማቶሳ 26:57-68</ref>፤ <ref loc="LUK 22:54-55">ሉቃሳ 22:54-55</ref>፣ <ref loc="LUK 22:63-71">63-71</ref>፤ <ref loc="JHN 18:13-14">ዮሃ. 18:13-14</ref>፣ <ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53"/>አሳይ የሱሳ ቄሳቱዋ ኡባቱዋ ካፑዋ ሶይ፥ ቄሳቱዋ ካፓቱዋ ኡባቱ፥ ጭማቱነ ህግያ ታማርስያዋንቱ ሺቄዳሳ አፌድኖ። <verse eid="MRK 14:53"/><verse number="54" style="v" sid="MRK 14:54"/>ጰጽሮስ ቄሳቱዋ ኡባቱዋ ካፑዋ ድርሳ ግዱዋ ጋካናዉ ሃኩዋን አ ካሌዳ፤ ያን ናግያዋና ታማ ካሺደ፥ ኡት አጌዳ።<verse eid="MRK 14:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55"/>ቄሳቱዋ ካፓቱነ ሄዋን ሺቄዳ አሳይ ኡባይ የሱሳ ዎናዉ አ ቦላ ማርካ ኮዬድኖ፤ ሽን አይነ ደምበይክኖ። <verse eid="MRK 14:55"/><verse number="56" style="v" sid="MRK 14:56"/>አያዉ ጎፐ፥ ጮራ አሳቱ አ ቦላን ዎርዱዋ ማርካቴድኖ፤ ሽን ኡንቱንቱ ማርካተይ እት ማላ ግደና።<verse eid="MRK 14:56"/></para>
  <para style="p">
    <verse number="57-58" style="v" sid="MRK 14:57-58"/>እት እት አሳቱ ደንድ ኤቂደ የሱሳ ቦላ፥ “እ፥ ‘ታን አሳይ ኬጼዳ ሀ ጌሻ ጎልያ ኮላደ፥ አሳይ ኬጽቤና ሀራ ጌሻ ጎልያ ሄዙ ጋላሳ ግዶን ኬጻና’ ጊሽን፥ ኑን ስሴዶ” ያጊደ ዎርዱዋ ማርካቴድኖ። <verse eid="MRK 14:57-58"/><verse number="59" style="v" sid="MRK 14:59"/>ሽን ሀራይ አቶ ኡንቱንቱ ማርካተይ ሄዋን እት ማላ ግድቤና።<verse eid="MRK 14:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60"/>ቄሳቱዋ ኡባቱዋ ካፑ አሳ ኡባ ስንን ደንድ ኤቂደ የሱሳ፥ “ሀዋንቱ ኔና ሞትያ ሞቶ ነዉ ዛርያባይ ባዌ?” ያጊደ ኦቼዳ። <verse eid="MRK 14:60"/><verse number="61" style="v" sid="MRK 14:61"/>ሽን የሱስ ጮኡ ጊደ፥ አይነ ዛርቤና፤ ቄሳቱዋ ኡባቱዋ ካፑ አ፥ “አንጀቴዳ ጾሳ ናአይ ክርስቶስ ኔኔ?” ያጊደ ላኤንዋ ኦቼዳ።<verse eid="MRK 14:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62"/>የሱስ ዛሪደ፥ “ኤ፥ ታና፤ ህንተ ታና፥ አሳ ናኣ፥ ዎልቃማ ጾሳፐ ኡሸቻ ባጋና ኡትደእሽናነ ሳሉዋ ሻርያና ዪሽን በአና” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">14:62 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳኔላ 7:13</ref></char></note><verse eid="MRK 14:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63"/>ቄሳቱዋ ኡባቱዋ ካፑ ባረ ማዩዋ ፔ ኦሊደ፥ “ኑና ሀዋፐ ስንን አያዉ ሀራ ማርካ ኮሺ? <verse eid="MRK 14:63"/><verse number="64" style="v" sid="MRK 14:64"/>ህንተንቱ አ ቦርያ ስሴድታ፤ ህንተ ቆፋይ አዬ?” ያጌዳ፤ ኡንቱንቱ ኡባይ፥ “እ ሀይቃና በሴ” ያጊደ አ ቦላ ፕርዴድኖ።<note caller="-" style="x"><char style="xo" closed="false">14:64 </char><char style="xt" closed="false"><ref loc="LEV 24:16">ዎጋ 24:16</ref></char></note><verse eid="MRK 14:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65"/>ኡንቱንቱፐ እቱ እቱ አ ቦላ ጩሸ ዶሜድኖ፤ አ አይፍያ ካም ደቺደ፥ “ኔና ደቼዳዌ ኦኔ? አነ ትምቢትያ ኦዳ!” ያጌድኖ፤ ቃይ ናግያዋንቱካ አ ቅንጻልያ ባቂደ አፌድኖ።<verse eid="MRK 14:65"/></para>
  <para style="s1">ጰጽሮስ የሱሳ ካዴዳ</para>
  <para style="r">(<ref loc="MAT 26:69-75">ማቶሳ 26:69-75</ref>፤ <ref loc="LUK 22:56-62">ሉቃሳ 22:56-62</ref>፤ <ref loc="JHN 18:15-18">ዮሃ. 18:15-18</ref>፣ <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66"/>ጰጽሮስ ድርሳ ግዶን ህርክና ደእሽን፥ ቄሳቱዋ ኡባቱዋ ካፑዋ ማጫ ቆማቱዋፐ እትና ያዱ። <verse eid="MRK 14:66"/><verse number="67" style="v" sid="MRK 14:67"/>ጰጽሮስ ታማ ካሽያዋ በኣደ፥ ጫዳ ጼላደ፥ “ኔንካ ናዝሬትያ የሱሳና እትፐ ደኣ” ያጋዱ።<verse eid="MRK 14:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68"/>ሽን ጰጽሮስ፥ “ኔን ግያዌ አየንቶ ታን ኤርከ፤ ታዉ አኬከተና” ያጊደ ካዴዳ፤ ያቲደ ድርሳ ፐንግያኮ ከሴዳ፤ ኩቱካ ዋሴዳ።<note caller="+" style="f"><char style="fr" closed="false">14:68 </char><char style="fk" closed="false">ኩቱካ ዋሴዳ፦ </char><char style="ft" closed="false">ሀ ቃላይ በን ብለቴዳ እት እት ብለን ባዋ።</char></note><verse eid="MRK 14:68"/></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69"/>ሄ ቆማታ ጰጽሮሳ በኣደ፥ አ ማታን ኤቄዳ አሳቱዋ፥ “ሀ ብታኒካ ኡንቱንቱና ደኤ” ጋደ ጉጃደ ኦዱዋ ዶማዱ። <verse eid="MRK 14:69"/><verse number="70" style="v" sid="MRK 14:70"/>ሽን ጰጽሮስ ቃይካ ካዴዳ።</para>
  <para style="p" vid="MRK 14:70">ጉ ጋምእሽን፥ ማታን ኤቄዳ አሳቱ ላኤንዋ ጰጽሮሳ፥ “ኔን ቱማ ኡንቱንቱና እትፐ ደኣ፤ አያዉ ጎፐ፥ ኔን ጋሊላ ጋድያ አሳ” ያጌድኖ።<verse eid="MRK 14:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71"/>ሽን ጰጽሮስ፥ “ታን ሄዋ ህንተ ግያ ብታንያ ኤርከ!” ያጊደ ባረና ሸቃነ ጫቁዋ ዶሜዳ።<verse eid="MRK 14:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72"/>ኤለካ ኩቱ ላኤንዋ ዋስ አጌዳ፤ ጰጽሮስ ባረና የሱስ፥ “ኔን ኩቱ ላኤንዋ ዋሳናፐ ካሰ ሄዙ ገደ ታና ካዳናሳ” ጌዳዋ ሀሳዪደ፥ ዳሪ ዬኬዳ።<verse eid="MRK 14:72"/></para>
  <chapter eid="MRK 14"/>
  <chapter number="15" style="c" sid="MRK 15"/>
  <para style="s1">የሱሳ ጵላጾሳኮ አፌድኖ</para>
  <para style="r">(<ref loc="MAT 27:1-2">ማቶሳ 27:1-2</ref>፣ <ref loc="MAT 27:11-14">11-14</ref>፤ <ref loc="LUK 23:1-5">ሉቃሳ 23:1-5</ref>፤ <ref loc="JHN 18:28-38">ዮሃ. 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1"/>ዎንታ ጉራን ኤለካ ቄሳቱዋ ካፓቱ ጭማቱዋናኔ ሙሴ ህግያ ታማርስያዋንቱና ሄዋን ሺቄዳ አይሁዳ ሻንጋቱዋ ኡባና ማቀቲደ፥ የሱሳ ቃች አፊደ፥ ጵላጾሳዉ አደ እሜድኖ።<verse eid="MRK 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2"/>ጵላጾስ አ፥ “ኔን አይሁዳቱዋ ካቴ?” ያጊደ ኦቼዳ።</para>
  <para style="p" vid="MRK 15:2">የሱስ ዛሪደ አ፥ “ነ ግያዋዳና” ያጌዳ።<verse eid="MRK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3"/>ቄሳቱዋ ካፓቱ የሱሳ ዳሮባን ሞቴድኖ። <verse eid="MRK 15:3"/><verse number="4" style="v" sid="MRK 15:4"/>ጵላጾስ ሽረቲደ የሱሳ፥ “ነዉ ዛርያባይ ባዌ? ኡንቱንቱ ነ ቦላ ዎይሳ ሞቱዋ አህንቶ በእኪ?” ያጊደ ኦቼዳ።<verse eid="MRK 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5"/>ሽን የሱስ ሀራባ ዛረናን እጽና፥ ጵላጾስ ማላለቴዳ።<verse eid="MRK 15:5"/></para>
  <para style="s1">የሱሳ ቦላ ሀይቁዋ ፕርዴድኖ</para>
  <para style="r">(<ref loc="MAT 27:15-26">ማቶሳ 27:15-26</ref>፤ <ref loc="LUK 23:13-25">ሉቃሳ 23:13-25</ref>፤ <ref loc="JHN 18:39-40">ዮሃ. 18:39-40</ref>፤ <ref loc="JHN 19:1-16">19:1-16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6"/>ጵላጾሳዉ ፓስጋ ባላ ቦንችያ ጋላሳን አሳይ ኮይያ እት ኡራ ቃሹዋፐ ብልያ ዎጋይ ደኤ። <verse eid="MRK 15:6"/><verse number="7" style="v" sid="MRK 15:7"/>ሄ ዎደ እት ባርባና ግያ ብታኒ ዋላሳ ከሲደ ሸምፑዋ ዎዳ አሳቱዋና እትፐ ቃሾ ጎልያን ደኤ። <verse eid="MRK 15:7"/><verse number="8" style="v" sid="MRK 15:8"/>ሺቄዳ ጮራ አሳይ ጵላጾስ ካሰ ኤረቶዋዳንካ ባረንቶ ማሮታ ኦና ማላ፥ አ ኦቼድኖ። <verse eid="MRK 15:8"/><verse number="9" style="v" sid="MRK 15:9"/>ጵላጾስ አሳ ዛሪደ፥ “ታን ህንተንቶ አይሁዳቱዋ ካትያ ብልያዋ ኮዪቴ?” ያጊደ ኦቼዳ። <verse eid="MRK 15:9"/><verse number="10" style="v" sid="MRK 15:10"/>አያዉ ጎፐ፥ ቄሳቱዋ ካፓቱ የሱሳ ቃናቲደ አ እሜዳዋ ጵላጾስ ኤሬዳ።<verse eid="MRK 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11"/>ሽን ቄሳቱዋ ካፓቱ የሱሳ ኮታ ባርባና ብላናዳን፥ ሄ ሺቄዳ አሳይ ጵላጾሳ ዎሳና ማላ፥ አሳ ማቄድኖ። <verse eid="MRK 15:11"/><verse number="12" style="v" sid="MRK 15:12"/>ጵላጾስ ላኤንዋ ዛሪደ፥ “ያትና፥ ሀ አይሁዳ ካትያ ህንተንቱ ግያዋ ዎቶ?” ያጌዳ።<verse eid="MRK 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13"/>አሳይ ጵላጾሳዉ ዛር ዛር ባረንቱ ኮሻ ቁ ኦደ፥ “አ ካቃ” ያጌድኖ።<verse eid="MRK 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14"/>ጵላጾስ አሳ፥ “አያዉ? እ አይ ኢታባ ኦዴ?” ያጌዳ።</para>
  <para style="p" vid="MRK 15:14">ሽን አሳይ ካሰዋፐካ ባረ ኮሻ ቁ ኦደ፥ “አ ካቃ” ያጌድኖ።<verse eid="MRK 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15"/>ጵላጾስ አሳ ናሸቻናዉ ኮዪደ፥ ባርባና አሳዉ ብሌዳ፤ ያቲደ ልሱዋን የሱሳ ዎታዳራቱዋን ሾጭሲደ፥ ካቃና ማላ ኡንቱንቶ አ እሜዳ።<verse eid="MRK 15:15"/></para>
  <para style="s1">ዎታዳራቱ የሱሳ ቅሊጬድኖ</para>
  <para style="r">(<ref loc="MAT 27:27-31">ማቶሳ 27:27-31</ref>፤ <ref loc="JHN 19:2-3">ዮሃ. 19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16"/>ሄዋፐ ጉይያን፥ ዎታዳራቱ የሱሳ ጋድያ ሞድያዋ ግቢያ አፊደ፥ ሀራ ዎታዳራቱዋ ኡባ እትፐ ጼሴድኖ። <verse eid="MRK 15:16"/><verse number="17" style="v" sid="MRK 15:17"/>ቃይ ዞኦ ማዩዋ አ ማይዜድኖ፤ አጉን ካላቻ ጊግሲደ፥ አ ሁጲያን ዎድኖ። <verse eid="MRK 15:17"/><verse number="18" style="v" sid="MRK 15:18"/>ሄዋፐ ጉይያን አ፥ “አይሁዳቱዋ ካተዉ፥ ሳሮታይ ነዉ ግዶ” ያግ ሳሮቲደ፥ አ ቅሊጩዋ ዶሜድኖ። <verse eid="MRK 15:18"/><verse number="19" style="v" sid="MRK 15:19"/>የሱሳ ሁጲያ ማቃ ጻምኣን ሾጬድኖ፤ ቃይ አ ቦላን ጩቼድኖ፤ ጉልባቲደ አዉ ጎይኔድኖ። <verse eid="MRK 15:19"/><verse number="20" style="v" sid="MRK 15:20"/>አ ቦላ ቅሊጬዳዋፐ ጉይያን፥ ዞኦ ማዩዋ አፐ ቃር አኪደ፥ አ ማዩዋ አ ማይዜድኖ፤ ያቲደ ማስቃልያ ቦላን ምስማርያን ሺደ፥ አ ካቃናዉ አፌድኖ።<verse eid="MRK 15:20"/></para>
  <para style="s1">የሱሳ ካቄድኖ</para>
  <para style="r">(<ref loc="MAT 27:32-44">ማቶሳ 27:32-44</ref>፤ <ref loc="LUK 23:26-43">ሉቃሳ 23:26-43</ref>፤ <ref loc="JHN 19:17-27">ዮሃ. 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21"/>ኡንቱንቱ ቢደ፥ እስክንድራነ ሩፎሳ የሌዳ አዉዋ፥ እት ስሞና ግያ ቀሬና ጋድያ አሳይ፥ ጋጻፐ ካታማ ይያዋና ጋከቲደ፥ የሱሳ ማስቃልያ ዎልቃን ቶሴድኖ።<note caller="-" style="x"><char style="xo" closed="false">15:21 </char><char style="xt" closed="false"><ref loc="ROM 16:13">ሮመ 16:13</ref></char></note> <verse eid="MRK 15:21"/><verse number="22" style="v" sid="MRK 15:22"/>ያቲደ ጎልጎታ ጌተትያሳ የሱሳ አፌድኖ። “ጎልጎታ” ግያዌ “ሁጲያ ጎስያሳ”<note caller="+" style="f"><char style="fr" closed="false">15:22 </char><char style="fq" closed="false">“ሁጲያ ጎስያሳ” </char><char style="ft" closed="false">ጌተትያዌ፥ አሳ ሁጲያ ማላትያ ሹቻይ ሄዋን ደእያ ድራዉ፥ ሁጲያ ጎስያሳ ጌተቴዳ።</char></note> ግያዋ። <verse eid="MRK 15:22"/><verse number="23" style="v" sid="MRK 15:23"/>ካዋራ ግያ ሊ ዋላከቴዳ ዎይንያ ኤሳ የሱሳዉ ኡሻናዉ እሜድኖ፤ ሽን እ ኡሸናን እጼዳ። <verse eid="MRK 15:23"/><verse number="24" style="v" sid="MRK 15:24"/>ኡንቱንቱ አ ካቄድኖ፤ ቃይ ኦና ኦና ጋካነንቶ ኤራናዉ አ ማዩዋ ሻኪደ፥ ሳማ የጌድኖ።<note caller="-" style="x"><char style="xo" closed="false">15:24 </char><char style="xt" closed="false"><ref loc="PSA 22:18">ማዝ. 22:18</ref></char></note><verse eid="MRK 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 15:25"/>ኡንቱንቱ አ ካቂያ ዎደ፥ ዎንታፐ ሄዙ ሳተ። <verse eid="MRK 15:25"/><verse number="26" style="v" sid="MRK 15:26"/>“አይሁዳቱዋ ካትያ” ያግ አ ሞትያ ጻፉ ጻፌት ኡቴዳ። <verse eid="MRK 15:26"/><verse number="27" style="v" sid="MRK 15:27"/>የሱሳና ላኡ ካይሳቱዋ እቱዋ አፐ ኡሸቻ ባጋና፥ ቃይ እቱዋ አፐ ሀድርሳ ባጋና ማስቃልያ ቦላ ምስማርያን ሺደ ካቄድኖ። <verse eid="MRK 15:27"/><verse number="28" style="v" sid="MRK 15:28"/>ጾሳ ማጻፋይ፥ “ኢታባ ኦዳ አሳቱዋና እ ፓይደቴዳ” ያግያዌ ፖለቴዳ።<note caller="-" style="x"><char style="xo" closed="false">15:28 </char><char style="xt" closed="false"><ref loc="ISA 53:12">ኢሳ. 53:12</ref></char></note><verse eid="MRK 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29"/>ኦግያና አያ አሳይ የሱሳ ካደ፥ ባረንቱ ሁጲያ ቃደ ቦሬድኖ፤ “ስም፥ ጌሻ ጎልያ ኮላደ ሄዙ ጋላሳ ግዶን ኬጽያዎ፥<note caller="-" style="x"><char style="xo" closed="false">15:29 </char><char style="xt" closed="false"><ref loc="PSA 22:7">ማዝ. 22:7</ref>፤ <ref loc="PSA 109:25">109:25</ref>፤ <ref loc="MRK 14:58">ማር. 14:58</ref>፤ <ref loc="JHN 2:19">ዮሃ. 2:19</ref></char></note> <verse eid="MRK 15:29"/><verse number="30" style="v" sid="MRK 15:30"/>አነ ማስቃልያ ቦላፐ ዎደ፥ ነ ሁጲያ አሻ” ያጌድኖ።<verse eid="MRK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31"/>ሀዋዳንካ ቄሳቱዋ ካፓቱ ሙሴ ህግያ ታማርስያዋንቱና እትፐ የሱሳ ቦላ፥ “ሀራ አሳቱዋ አሼዳ፤ ሽን ባረና አሻናዉ ዳንዳየና፤ <verse eid="MRK 15:31"/><verse number="32" style="v" sid="MRK 15:32"/>ኑን በኢደ አማናና ማላ፥ ክርስቶስ እስራኤልያ ካቲ፥ አነ ማስቃልያ ቦላፐ ሀእ ዎ” ጊደ ቅሊጬድኖ። ቃይ ሀራይ አቶ፥ አናና ማስቃልያ ቦላ ምስማርያን ሸቲደ ካቀቴዳዋንቱካ አ ቦላ ቅሊጬድኖ።<verse eid="MRK 15:32"/></para>
  <para style="s1">የሱሳ ሀይቁዋባ</para>
  <para style="r">(<ref loc="MAT 27:45-56">ማቶሳ 27:45-56</ref>፤ <ref loc="LUK 23:44-49">ሉቃሳ 23:44-49</ref>፤ <ref loc="JHN 19:28-30">ዮሃ. 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33"/>ኡሱፑን ሳትያፐ ዶሚደ፥ ኡዱፑ ሳትያ ጋካናዉ፥ ጋድያ ኡባይ ሜዳ። <verse eid="MRK 15:33"/><verse number="34" style="v" sid="MRK 15:34"/>ኡዱፑ ሳትያን የሱስ ባረ ቃላ ቁ ኦደ፥ “ኤሎሄ፥ ኤሎሄ፥ ላማ ሳባቅታኒ?”<note caller="+" style="f"><char style="fr" closed="false">15:34 </char><char style="fqa" closed="false">ኤሎሄ፥ ኤሎሄ፥ ላማ ሳባቅታኒ፦ </char><char style="ft" closed="false">ሀ ቃላቱ የሱስ ሀ አላምያን አሹዋ ማዪደ ስመረትያ ዎደ ሃሳየትያ አራማይከ ጌተትያ ቃላን ሃሳየቶዋ።</char></note> ያጌዳ። ሄዋ ግያዌ፥ “ታ ጾሳዉ፥ ታ ጾሳዉ፥ ታና አያዉ አጋዲ?” ግያዋ።<note caller="-" style="x"><char style="xo" closed="false">15:34 </char><char style="xt" closed="false"><ref loc="PSA 22:1">ማዝ. 22:1</ref></char></note><verse eid="MRK 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35"/>ሄዋን ኤቄዳ አሳፐ እቱ እቱ ሄዋ ስሲደ፥ “በእተ፤ ኤላሳ ጼሴ” ያጌዳ። <verse eid="MRK 15:35"/><verse number="36" style="v" sid="MRK 15:36"/>ሄ አሳፐ እቱ ዎጽ ዪደ፥ ዛንዛ ማላትያዋን ጫላ ዎይንያ ኤሳ ኩንዳ፤ ሄዋ ማቃ ጋትማ ጼራን ዎደ፥ “ደእሽተ አነ፤ ኤላስ ማስቃልያፐ አ ዎናዉ ያነንቶነ አነ በኦይተ” ያጊደ የሱሳ ዶናኮ ኡሻናዉ ሺሼዳ።<note caller="-" style="x"><char style="xo" closed="false">15:36 </char><char style="xt" closed="false"><ref loc="PSA 69:21">ማዝ. 69:21</ref></char></note><verse eid="MRK 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37"/>የሱስ ቃላ ቁ ኦ ዋሲደ፥ ሀይቂ አጌዳ።<verse eid="MRK 15:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38"/>ጌሻ ጎልያን ቃሸቴዳ ጋርዱ ቆሞፐ ዱገ ጋካናዉ፥ ላኡ ከሲደ ፖሸት ዎዳ።<note caller="-" style="x"><char style="xo" closed="false">15:38 </char><char style="xt" closed="false"><ref loc="EXO 26:31-36">ከሳ 26:31-36</ref></char></note> <verse eid="MRK 15:38"/><verse number="39" style="v" sid="MRK 15:39"/>ማስቃልያፐ ስን ባጋና ሄዋን ኤቄዳ እት ጼቱዋ ካፑ፥ ሄዋ ኬና የሱስ ዋሲደ ሀይቄዳዋ በኤዳ ዎደ፥ “ሀ ብታኒ ቱሙ ጾሳ ናኣ” ያጌዳ።<verse eid="MRK 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40"/>ሄዋን ሃኩዋን ኤቂደ ጼልያ አማሬዳ ማጫዋንቱ ደኢኖ፤ ኡንቱንቱ ግዶን ማግዳላ ግያ ካታማፐ ዬዳ ማይራማ፥ ቴፋ ያቆባነ ዮሳ ዳያ ማይራማነ ሳሎማ ደኢኖ። <verse eid="MRK 15:40"/><verse number="41" style="v" sid="MRK 15:41"/>ሄ ማጫ አሳቱ የሱስ ጋሊላን ደእያ ዎደ፥ አ ካሌዳዋንታነ አ ማዴዳዋንታ፤ ቃይ የሱሳና እትፐ የሩሳላመ ቤዳ ሀራ ጮራ ማጫ አሳቱ ሄዋን ደኢኖ።<verse eid="MRK 15:41"/></para>
  <para style="s1">የሱሳ ሞጉዋባ</para>
  <para style="r">(<ref loc="MAT 27:57-61">ማቶሳ 27:57-61</ref>፤ <ref loc="LUK 23:50-56">ሉቃሳ 23:50-56</ref>፤ <ref loc="JHN 19:38-42">ዮሃ. 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42-43" style="v" sid="MRK 15:42-43"/>ሳአይ ኦማርሴዳ ዎደ፥ ሄዋን ሺቄዳ አሳን ቦንቼቴዳ እት ዮሴፎ ግያ ብታኒ፥ ጾሳ ካዉተይ ያናዋ ናግ ኡቴዳዌ፥ አርማትያሳ ግያ ካታማ አሳይ ዬዳ፤ ሄ ጋላሳይ ዎንተ ሳምባታዉ ጊገትያ ጋላሳ ግዴዳ ድራዉ፥ ዮሴፎ ጻሊደ ጵላጾሳኮ ቢደ፥ የሱሳ አሃ አካናዉ ዎሴዳ። <verse eid="MRK 15:42-43"/><verse number="44" style="v" sid="MRK 15:44"/>ጵላጾስ፥ የሱስ ኤለካ ሀይቂ ድጌዳዋ ስሴዳ ዎደ ማላለቴዳ፤ ጼቱዋ ካፑዋ ጼሲደ፥ “እ ሀይቆደፐ ጋምኤዴ?” ያጊደ ኦቼዳ። <verse eid="MRK 15:44"/><verse number="45" style="v" sid="MRK 15:45"/>ጵላጾስ የሱስ ሀይቄዳዋ ጼቱዋ ካፑዋፐ ስሲደ፥ አ አሃ ዮሴፎ አካናዳን ኦዳ። <verse eid="MRK 15:45"/><verse number="46" style="v" sid="MRK 15:46"/>ዮሴፎ ሞጉዋ ማዩዋ ሻሜዳ፤ የሱሳ አሃ ማስቃልያፐ ዎ ማዩዋን ጻጺደ፥ ሹቻ ዎጬዳ አሳ ሞግያ ጎንጎሉዋ ግዶን አ አሃ ዎዳ፤ ቃይ ሄ ጎንጎሉዋ ዶናን ዎልቃማ ሹቻ ጎንዶርሲደ ዎዳ። <verse eid="MRK 15:46"/><verse number="47" style="v" sid="MRK 15:47"/>ማግዳላ ካታማፐ ዬዳ ማይራማነ ዮሳ ዳያ ማይራማ የሱሳ አሃ ኡንቱንቱ ሀቃን ዎንቶ በኢኖ።<verse eid="MRK 15:47"/></para>
  <chapter eid="MRK 15"/>
  <chapter number="16" style="c" sid="MRK 16"/>
  <para style="s1">የሱስ ሀይቁዋፐ ደንዴዳ</para>
  <para style="r">(<ref loc="MAT 28:1-8">ማቶሳ 28:1-8</ref>፤ <ref loc="LUK 24:1-12">ሉቃሳ 24:1-12</ref>፤ <ref loc="JHN 20:1-10">ዮሃ. 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1"/>ሳምባታይ አዳዋፐ ጉይያን፥ ማግዳላ ካታማፐ ዬዳ ማይራማ፥ ያቆባ ዳያ ማይራማነ ሳሎማ ቢደ፥ የሱሳ አሃ ኦካናዉ ሽቱዋ ሻሜድኖ። <verse eid="MRK 16:1"/><verse number="2" style="v" sid="MRK 16:2"/>ዎጋ ጋላስ ዎንቱማ ዳሮ ጉራን ጻልቂ ከስሽን፥ ሄ ጎንጎሉዋ ቤድኖ። <verse eid="MRK 16:2"/><verse number="3" style="v" sid="MRK 16:3"/>ኡንቱንቱ ባረንቱ ግዶን እቱ እቱዋና፥ “ጎንጎሉዋ ዶናፐ ኑዉ ሹቻ ኦኔ ጎንዶርሲደ ድጋናዌሻ?” ያጊደ ሃሳዪኖ።<verse eid="MRK 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 16:4"/>ኡንቱንቱ ጼልያ ዎደ፥ ሄ ዳሮ ዎልቃማ ሹቻ ጎንዶርስድጌዳዋ በኤድኖ። <verse eid="MRK 16:4"/><verse number="5" style="v" sid="MRK 16:5"/>የሱስ ሞገቴዳ ጎንጎሉዋ ግዶ ገልያ ዎደ፥ እት ዎዳላ ብታኒ ቦ ማዩዋ ማዪደ፥ ኡሸቻ ባጋና ኡቴዳዋ በኢደ ዳጋሜድኖ።<verse eid="MRK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6"/>ሽን እ ኡንቱንታ፥ “ዳጋሞፕተ። ማስቃልያ ቦላ ካቀቴዳ ናዝሬትያ የሱሳ ህንተንቱ ኮይያዋ ኤራይ። እ ሀዋን ባዋ፤ ደንድ ድጌዳ። ኡንቱንቱ አ ዎዳሳ ሀዋ በእተ። <verse eid="MRK 16:6"/><verse number="7" style="v" sid="MRK 16:7"/>ሽን ቢደ የሱስ ባረና ካልያዋንቶነ ጰጽሮሳዉ፥ ‘የሱስ ህንተንቱፐ ካሰቲደ ጋሊላ ቤ፤ እ ህንተንቶ ኦዴዳዋዳንካ ህንተንቱ አ ያን በአና’ ያጊደ ሀዋ ኦድተ” ያጌዳ።<verse eid="MRK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8"/>ማጫ አሳቱ ያሻን ኮኮሪደ፥ የሱስ ሞገቴዳ ጎንጎሉዋፐ ከሲደ ባቃት አጌድኖ፤ ቃይ ኡንቱንቱ ያዬዳ ድራዉ፥ አሳዉ ሄዋ ኦስነ አይነ ኦድበይክኖ።</para>
  <para style="p" vid="MRK 16:8">ማጫ አሳቱ ቢደ፥ ባረንቶ ኦደቴዳባ ኡባ ጰጽሮሳዉነ አናና ደእያዋንቶ ቃንን ኦዴድኖ፤ ሄዋፐ ጉይያን፥ የሱስ ባረ ሁጰዉ ባረና ካልያዋንቱ ቦላ፥ መናዉ አሽያ ላመተና ጌሻ ምሽራቹዋ ቃላ፥ አዋይ ሞክያሳፐ ዉልያሳ ጋካናዉ ኪቴዳ።<verse eid="MRK 16:8"/></para>
  <para style="s1">የሱስ ማግዳላ ማይራምዉ ቤቴዳ</para>
  <para style="r">(<ref loc="MAT 28:9-10">ማቶሳ 28:9-10</ref>፤ <ref loc="JHN 20:11-18">ዮሃ. 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9"/>የሱስ ሀይቁዋፐ ደንዴዳዋፐ ጉይያን፥ ዎጋ ጋላስ ጉራ፥ ላፑ ኢታ አያናቱዋ ከሴዳ ማግዳላ ካታማፐ ዬዳ ማይራምዉ ካሰቲደ ቤቴዳ። <verse eid="MRK 16:9"/><verse number="10" style="v" sid="MRK 16:10"/>እዛ ባደ ካሰ አናና ደእያዋንቶ፥ ቃረቲድነ ዬኪደ ኡቴዳዋንቶ ኦዳዱ፤ <verse eid="MRK 16:10"/><verse number="11" style="v" sid="MRK 16:11"/>ሽን የሱስ ፓጻ ደእያዋነ እዝዉ ቤቴዳዋ ኡንቱንቱ ስሴዳ ዎደ፥ እዝ ኦዱዋ ቱማ ግበይክኖ።<verse eid="MRK 16:11"/></para>
  <para style="s1">የሱስ ላኡ ባረና ካልያዋንቶ ቤቴዳ</para>
  <para style="r">(<ref loc="LUK 24:13-35">ሉቃሳ 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12"/>ሄዋፐ ጉይያን፥ ኡንቱንቱፐ ላአቱ ካታማፐ ከሲደ ቢሽን፥ ኦግያን የሱስ ኮይሮዋፐ ዱማቲደ፥ ኡንቱንቶ ቤቴዳ። <verse eid="MRK 16:12"/><verse number="13" style="v" sid="MRK 16:13"/>ኡንቱንቱ ጉየ ስሚደ፥ ሀራቶ ኦዴድኖ፤ ሽን ሄዋንቱ ኡንቱንቱ ኦዱዋ ቱማ ግበይክኖ።<verse eid="MRK 16:13"/></para>
  <para style="s1">የሱስ ታማነ እት ባረና ካልያዋንቶ ቤቴዳ</para>
  <para style="r">(<ref loc="MAT 28:16-20">ማቶሳ 28:16-20</ref>፤ <ref loc="LUK 24:36-49">ሉቃሳ 24:36-49</ref>፤ <ref loc="JHN 20:19-23">ዮሃ. 20:19-23</ref>፤ <ref loc="ACT 1:6-8">ኪታ 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14"/>ጉየፐ ታማነ እት የሱሳ ካልያዋንቱ ቁማ ሚሽን፥ የሱስ ኡንቱንቶ ቤቴዳ። ኡንቱንቶ አማኑ ባይና ድራዉ፥ እ ኡንቱንታ ሴሬዳ፤ ቃይ ሀይቁዋፐ እ ደንዴዳዋ በኤዳዋንቱ ኡንቱንቶ ኦድና፥ ኡንቱንቱ አማነናን እጼዳ ድራዉነ ኦድና ስሰናዋንታ ግድያ ድራዉ፥ እ ኡንቱንታ ሴሬዳ።<verse eid="MRK 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15"/>እ ኡንቱንታ ሀዋዳን ያጌዳ፤ “አላምያ ኡባ ቢደ፥ አሳ ኡባዉ ዎንጋላ ምሽራቹዋ ቃላ ኦድተ። <verse eid="MRK 16:15"/><verse number="16" style="v" sid="MRK 16:16"/>አማኖዌነ ጻማቀቶዌ አታና፤ ሽን አማነናዋ ቦላ ጾሳይ ፕርዳና። <verse eid="MRK 16:16"/><verse number="17" style="v" sid="MRK 16:17"/>ታናን አማንያዋንቱ ሀ ማላታቱዋ ኦናዋንታ: ኡንቱንቱ ታ ሱንን ኢታ አያናቱዋ ከሳናዋንታ፤ ቃይ ኡንቱንቱ ዱማ ዱማ ኦራ ቃላን ሃሳያናዋንታ። <verse eid="MRK 16:17"/><verse number="18" style="v" sid="MRK 16:18"/>ኡንቱንቱ ሾሻ ኦይቆፐካ፥ ዎይ አያነ ዎያ ማርዝያ ኡሽንቶካ ኡንቱንታ ቆሄና። ቃይ ኡንቱንቱ ባረንቱ ኩሽያ ሀርጋንቻቱዋ ቦላ ዎና፤ ሄ ሀርጋንቻቱ ፓጻና” ያጌዳ።<verse eid="MRK 16:18"/></para>
  <para style="s1">የሱስ ሳሉዋ ፑደ ከሴዳ</para>
  <para style="r">(<ref loc="LUK 24:50-53">ሉቃሳ 24:50-53</ref>፤ <ref loc="ACT 1:9-11">ኪታ 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19"/>ጎዳ የሱስ ባረና ካልያዋንቱና ሃሳዬዳዋፐ ጉይያን፥ ጾሳይ አ ፑደ ሳሉዋ አፍና፥ ጾሳፐ ኡሸቻ ባጋና ኡቴዳ። <verse eid="MRK 16:19"/><verse number="20" style="v" sid="MRK 16:20"/>አ ካልያዋንቱ ቢደ፥ ኡባ ሳን ዎንጋላ ምሽራቹዋ ኦዴድኖ። ጎዳይካ ኡንቱንቱና እትፐ ኦ፤ ኡንቱንቱ ኦድያ ቃላይካ ቱማ ግዴዳዋ ኡንቱንቱ ኦያ ማላታቱዋን ኤርሴዳ።<note caller="+" style="f"><char style="fr" closed="false">16:20 </char><char style="ft" closed="false">እት እት በን ጌሻ ማጻፋቱዋን ሀ ፓይዳቱ ባዋ።</char></note><verse eid="MRK 16:20"/></para>
  <chapter eid="MRK 16"/>
</usx>
