<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Dawuro Full Bible Ethiopic Version</book>
  <para style="h">ፕልሞና</para>
  <para style="toc1">ጳዉሎስ ፕልሞናዉ ጻፌዳ ኪታ</para>
  <para style="toc2">ፕልሞና</para>
  <para style="toc3">ፕል.</para>
  <para style="mt2">ጳዉሎስ</para>
  <para style="mt1">ፕልሞናዉ</para>
  <para style="mt2">ጻፌዳ ኪታ</para>
  <para style="imt">ገሉዋ</para>
  <para style="ip">ፕልሞን ኤረቴዳ አማንያ አሳ፤ እ ቆላስያሳ ዎሳ ጎልያ አሳ ግደናን ዋዪ አጋና። ፕልሞናዉ አናስሞሳ ግያ አይሊ ደኤ። ሄ አይሊ ባረ ጎዳፐ በቲደ ቤዳ ዎደ፥ ቃሾ ጎለን ደእያ ጳዉሎሳና ጋከቴዳ። አናስሞስ ጳዉሎሳ ባጋና የሱሳ አማኔዳ። ጳዉሎስ ፕልሞናዉ ጻፌዳ ኪታይ ፕልሞን ጉየ ስም ቢደ ደእያ ባረ ቆማና ስገታናዳን፥ ሄዋ ሀሳይስያዋ። ሄዋ ቦላካ ሀእ አናስሞስ አማንያ አሳ ግዴዳ ድራዉ፥ ሀዋፐ ስንዉ አማንያ እሻዳን አ ሞክ አካናፐ አትን፥ ቆማዳን አ ጼለናዳን አዉ ኦዴ።</para>
  <para style="iot">ሸምፓቱዋ ኡባቶ እመቴዳ ቃን ቆፋቱዋ</para>
  <para style="io1">ገሉዋ <char style="ior"><ref loc="PHM 1:1-3">1-3</ref></char></para>
  <para style="io1">ፕልሞናዉ ጳዉሎሳ ጋላታ <char style="ior"><ref loc="PHM 1:4-7">4-7</ref></char></para>
  <para style="io1">ጳዉሎስ አናስሞሳ ድራዉ ሺሼዳ ምኖ ኦሻ <char style="ior"><ref loc="PHM 1:8-22">8-22</ref></char></para>
  <para style="io1">ዉርሰ ቁትያ <char style="ior"><ref loc="PHM 1:23-25">23-25</ref> </char></para>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1"/>ታን ጳዉሎስ፥ የሱስ ክርስቶሳ ድራዉ ቃሹዋን ደእያዌነ ኑ እሻ ጽሞቶስ፥ ኑናና ኦያ ኑን ሲቅያ ፕልሞናዉ፥ <verse eid="PHM 1:1"/><verse number="2" style="v" sid="PHM 1:2"/>ነ ጎለን ሺቅያ አማንያዋንቶ፥ ኑ ምቻት አፍብስነ ኑናና እትፐ ደእያ ክርስቶሳ ዎታዳራ አርክፖሳዉ ሀ ዳብዳቢያ ጻፌቶ።<note caller="-" style="x"><char style="xo" closed="false">2 </char><char style="xt" closed="false"><ref loc="COL 4:17">ቆል. 4:17</ref></char></note><verse eid="PHM 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3"/>ጾሳ ኑ አዉዋፐነ ኑ ጎዳ የሱስ ክርስቶሳፐ አ ኬካተይነ ሳሮተይ ህንተንቶ ግዶ።<verse eid="PHM 1:3"/></para>
  <para style="s1">ፕልሞና ሲቁዋነ አማኑዋ</para>
  <para style="p">
    <verse number="4-5" style="v" sid="PHM 1:4-5"/>ኔን ጾሳ አሳቱዋ ሲቅያዋነ ጎዳ የሱሳ አማንያዋ ታን ስስያ ድራዉ፥ ጾሳ ዎሳደ ኔና ሀሳይያ ዎደ ኡባን፥ ታ ጾሳ ጋላታይ። <verse eid="PHM 1:4-5"/><verse number="6" style="v" sid="PHM 1:6"/>ኔን ነ አማኑዋ ሀራቱዋና ሻክያዌ ኑዉ ክርስቶስ የሱሳ ባጋና ይያ ሎኦባ ኡባ ኤርሳና ማላ፥ ታን ጾሳ ዎሳይ። <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>አያዉ ጎፐ፥ ጾሳ አሳቱዋ ዎዛናይ ነ ኪታን ምኔዳ ድራዉ፥ ታ እሻዉ፥ ታን ነ ሲቁዋን ዳሮ ናሸቻነ መንዋ ደማድ።<verse eid="PHM 1:7"/></para>
  <para style="s1">አናስሞስ ፕልሞናኮ ስሜዳ ስሙዋ</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8"/>ሄዋ ድራዉ፥ ኔን ኦናዉ በስያዋ ኦና ማላ፥ ታን ኔና አዛዛናዉ ክርስቶሳ ባጋና ጻሎፐካ፥ <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>ታን ጳዉሎስ ጭሜዳዌ፥ ክርስቶስ የሱሳዉ ሀእካ ቃሹዋን ደእያዌ፥ ሲቁዋ ድራዉ፥ ኔና ዎሳይ። <verse eid="PHM 1:9"/><verse number="10" style="v" sid="PHM 1:10"/>ታን ቃሹዋን ደኣደ አዉ አዉዋ ግዴዳ ታ ናኣ አናስሞሳ<note caller="+" style="f"><char style="fr" closed="false">10 </char><char style="fq" closed="false">አናስሞሳ፦ </char><char style="ft" closed="false">ግያ ሱን ብለይ፥ ግሪክያ ቃላን ጎእያዋ ዎይ ማድያዋ ጉሳ።</char></note> ድራዉ፥ ኔና ዎሳይ።<note caller="-" style="x"><char style="xo" closed="false">10 </char><char style="xt" closed="false"><ref loc="COL 4:9">ቆል. 4:9</ref></char></note> <verse eid="PHM 1:10"/><verse number="11" style="v" sid="PHM 1:11"/>እ ካሰ ኔና ጎኤና፤ ሽን ሀእ ኔናካ ታናካ ቱሙ ጎኤ።<verse eid="PHM 1:11"/></para>
  <para style="p">
    <verse number="12-13" style="v" sid="PHM 1:12-13"/>ታን ዎዛናፐ ዶስያ አናስሞሳ ኔኮ የዶዌ ታ ዎዛና የዶዋ። ታን ዎንጋላ ድራዉ ቃሸታ ኡታ ደእሽን፥ ኔና ኮቺደ፥ ታና ማዳና ማላ፥ ታ ማታን አ አሻናዉ ኮያይ። <verse eid="PHM 1:12-13"/><verse number="14" style="v" sid="PHM 1:14"/>ሽን ኔን ነ ሸንያዳን ኦናዋ ኮያይፐ አትን፥ ኔናና ዞረተናን ዎልቃን አይነ ኦናዉ ኮይከ።<verse eid="PHM 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15"/>አናስሞስ ጉ ዎድያ ኔፐ ሻከቴዳዌ፥ ኦን ኤር ስሚደ፥ ኡባ ዎደካ ኔናና ደአናሰንቶነ። <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>ስም ሀዋፐ ስንዉ አናስሞስ አይልያ ግደና፤ ሽን አይልያፐ እ ሎይ አ፤ እ ታዉ አይ ኬና ሲቆ እሼ! ቃይ እ ነዉ አሳ ባጋናካ ጎዳ ባጋናካ አይ ኬና አዳ እሻ ግዳንዴሻ!<verse eid="PHM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17"/>ስም ኔን ታና ነ ላገ ግያዋ ግዶፐ፥ ታና ሞክያዋዳን፥ አ ሞካ። <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>እ ነዉ ባይዜዳባይ ዎይ አ ቦላ ነዉ አጩ ደኦፐ፥ ታፐ ጭጋ አካ። <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>ሄ አጩዋ ታን ጭጋና ጋደ፥ ታን ጳዉሎስ ታ ኩሽያን ጻፋይ። ኔን ታዉ ነ ሸምፑዋ አጮታ ኡቴዳዋ ታን ኔና ሀሳይሳናዉ ኮሸና።<verse eid="PHM 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PHM 1:20"/>ኤ፥ ታ እሻዉ፥ ጎዳ ባጋና ኔፐ ማዱዋ ደማናዉ ኮያይ። ክርስቶሳ ባጋና ታና መን። <verse eid="PHM 1:20"/><verse number="21" style="v" sid="PHM 1:21"/>ታን ጌዳዋፐ ዳሩዋ ኔን ኦናዋ ኤራደ፥ ቃይ ነ ታዉ አዛዘታናዋካ አማናደ፥ ሀዋ ነዉ ጻፋይ።<verse eid="PHM 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PHM 1:22"/>ቃይ ህንተንቱ ኤለካ ታዉ እማይ ሸምፕያ ጎልያ ጊግስተ። አያዉ ጎፐ፥ ጾሳይ ህንተንቱ ዎሳን ታና ህንተንቶ ጉየ ዛሪደ እማና ጋደ ቆፓይ።<verse eid="PHM 1:22"/></para>
  <para style="s1">ዉርሰ ሳሮታ</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23"/>ክርስቶስ የሱሳ ድራዉ፥ ታናና ቃሹዋን ደእያ ኤፓፍር ኔና ሳሮ ሳሮ ጌ። <verse eid="PHM 1:23"/><verse number="24" style="v" sid="PHM 1:24"/>ቃይ ታናና እትፐ ኦያ ማርቆስ፥ አርስጽሮኮስ፥ ዴማስነ ሉቃስ ኔና ሳሮ ሳሮ ጊኖ።<verse eid="PHM 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25"/>ጎዳ የሱስ ክርስቶሳ አ ኬካተይ ህንተንቱ አያናና ግዶ።<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
